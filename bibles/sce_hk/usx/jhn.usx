  <para style="rem">Copyright Information: For any non-Paratext use of this text, permission must be obtained from the copyright holder.</para>
  <para style="h">Yaheiya Chonjisan Gouxioxi</para>
  <para style="toc1">Yaheiya Chonjisan Gouxioxi</para>
  <para style="toc2">Yaheiya</para>
  <para style="toc3">Yah</para>
  <para style="mt">Yaheiya Chonjisan Gouxioxi</para>
  <chapter number="1" style="c" sid="JHN 1"/>
  <para style="s">Kielien Giezhi Urusan Ersa Mexiha Duyade Irezho</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1"/>Zui melieshida Kielien wine. Ene Kielien Hudaghala hhantu wo. Ene Kielienshi Huda wo. <verse eid="JHN 1:1"/><verse number="2" style="v" sid="JHN 1:2"/>Hhe zui melieshida Hudaghala hhantu wo. <verse eid="JHN 1:2"/><verse number="3" style="v" sid="JHN 1:3"/>Duya jiereshikulai man hhe zhayaghawo. Hhe uye zhayaghasei nieda uwo. <verse eid="JHN 1:3"/><verse number="4" style="v" sid="JHN 1:4"/>Hhei sudoro amin wine. Ene aminshi kunlai gon wo. <verse eid="JHN 1:4"/><verse number="5" style="v" sid="JHN 1:5"/>Gon kharanide zhouise kharani gonni gieru dane. <verse eid="JHN 1:5"/><verse number="6" style="v" sid="JHN 1:6"/><char style="pn">Yaheiya</char> giezhi nie kunyi Hudai hhense peizhi ireghawo. <verse eid="JHN 1:6"/><verse number="7" style="v" sid="JHN 1:7"/>Hhei peizhi ireghase hhe gonde ganzhen beizhi kunlai man xianxin gieghane giezho. <verse eid="JHN 1:7"/><verse number="8" style="v" sid="JHN 1:8"/>Ene kunshi gon pusho, gonde ganzhen beile irezho. <verse eid="JHN 1:8"/><verse number="9" style="v" sid="JHN 1:9"/>Kunlai giegheraghaku zhenzhenji hhe gon duyade irezho.<verse eid="JHN 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 1:10"/>Hhe duyade wo, hhei tungo giezhi duyai zhayaghawoma, duya hhei tani dane. <verse eid="JHN 1:10"/><verse number="11" style="v" sid="JHN 1:11"/>Hhe goya orondene irese goyai kunla hhei ese jienliewoma, <verse eid="JHN 1:11"/><verse number="12" style="v" sid="JHN 1:12"/>jien hhei jienliezhi niereini xianxin giesan kunlade Hudai kewosi danlaku qienli ogiwo. <verse eid="JHN 1:12"/><verse number="13" style="v" sid="JHN 1:13"/>Ene kesilashi kun jierese iresan pusho. Kunni duranghala jihua giedene olusanye pusho, Hudase iresan wo.<verse eid="JHN 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14"/>Ene Kielien kun gholudene mai dunda souzho. Matan hhei famani uzhese zhen Adani niekozi Kewonni famani wo. Hhei sudoro nenjien, zhendao olon wo.<verse eid="JHN 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15"/>
    <char style="pn">Yaheiya</char> hhende ganzhen beizhi fugiede kieliewo, "Eneshi hhe mase khuina irenema, mase hen wo. Hhe zui melieshidasejiu wine giezhi bi kieliezhi daosan hhe wo." <verse eid="JHN 1:15"/><verse number="16" style="v" sid="JHN 1:16"/>Matan man hhei fugie nenjien jierese nenjien olon jienliezho. <verse eid="JHN 1:16"/><verse number="17" style="v" sid="JHN 1:17"/>Guijinshi <char style="pn">Musa</char>se irezho. Nenjien, zhennishi <char style="pn">Ersa</char> Mexihase irezho. <verse eid="JHN 1:17"/><verse number="18" style="v" sid="JHN 1:18"/>Kiemada Hudai chujieghezhi ese daozhoma, Hudai zhughe jieredu niekozi kewon Hudai mejieghawo. Hhe benshenshi Huda wo.<verse eid="JHN 1:18"/></para>
  <para style="s">Yaheiyani Ganzhen</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mat 3:1-12</ref>; <ref loc="MRK 1:1-8">Mak 1:1-8</ref>; <ref loc="LUK 3:1-18">Luj 3:1-18</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19"/>
    <char style="png">Yelusalen</char>se <char style="png">Yutai</char> kunla buwa, <char style="png">Liwi</char> kunlai peizhi <char style="pn">Yaheiya</char>shi kien bikuni asaghale echise <char style="pn">Yaheiya</char> ingiezhi ganzhen beizho. <verse eid="JHN 1:19"/><verse number="20" style="v" sid="JHN 1:20"/>Hhe ghudan ese kieliezhi zhijie kieliewo, "Bishi Mexiha pusho." <verse eid="JHN 1:20"/><verse number="21" style="v" sid="JHN 1:21"/>Hhela pse asawo, "Qinse chishi kien wo? <char style="pn">Iliya</char> onu?" "Pusho." "Qinse chishi hhe nie xienzhi onu?" "Pusho." <verse eid="JHN 1:21"/><verse number="22" style="v" sid="JHN 1:22"/>Ingiese hhela kieliewo, "Chi daojishi kien wo? Bijien khareizhi echise peizhi ireghasan kunlade jiodai giene. Chi goyane nie kielie. Chishi kien wo?" <verse eid="JHN 1:22"/><verse number="23" style="v" sid="JHN 1:23"/>Hhe kieliewo, "Bishi <char style="pn">Isaiya</char> xienzhi kieliesan mutun</para>
  <para style="q1" vid="JHN 1:23">Ezhanni moni zhidagha</para>
  <para style="m" vid="JHN 1:23">giezhi hontande waradasan hhe shenqi wo."<verse eid="JHN 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24"/>Hhelashi Falisai kun peizhi ireghasan wo. <verse eid="JHN 1:24"/><verse number="25" style="v" sid="JHN 1:25"/>Ingiese asazho, "Chi Mexiha pusho, <char style="pn">Iliya</char> pusho, hhe nie xienzhiye pusho. Chi yangiezhi kunlade xili gieghazho?" <verse eid="JHN 1:25"/><verse number="26" style="v" sid="JHN 1:26"/><char style="pn">Yaheiya</char> kieliewo, "Bi usughala xili gieghazhoma, ta tani dasan daniezhan tai dunda beizho. <verse eid="JHN 1:26"/><verse number="27" style="v" sid="JHN 1:27"/>Hhe mase khuina irenema, bi hhende mahei deizi andaghaseye pei dane." <verse eid="JHN 1:27"/><verse number="28" style="v" sid="JHN 1:28"/>Ene shiqinlashi <char style="png">Yedanhe</char>ni hhemandedu <char style="png">Bodani</char>de fashen giesan wo, zhen <char style="pn">Yaheiya</char> xili gieghasan oron wo.<verse eid="JHN 1:28"/></para>
  <para style="s">Hudai Ghoni Ghughan</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29"/>Khuichuduni <char style="pn">Ersa</char> hhelai hhende iresei <char style="pn">Yaheiya</char> chanladene kieliewo, "Uzhe, duyai kunlai zuini widaghaku Hudai ghoni ghughan wo! <verse eid="JHN 1:29"/><verse number="30" style="v" sid="JHN 1:30"/>Eneshi hhe mase khuina irenema, mase hen wo. Hhe zui melieshidasejiu wine giezhi bi kieliezhi daosan hhe wo. <verse eid="JHN 1:30"/><verse number="31" style="v" sid="JHN 1:31"/>Bi melieshidase hheni tani dane. Bi ede usughala xili gieghase hhei <char style="png">Isilie</char> kunlade mejieghane giezho."<verse eid="JHN 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32"/>
    <char style="pn">Yaheiya</char> pse ganzhen beizhi kieliewo, "Bi melieshi chanlase Shenlin ghoghochen mutun asiman jierese bouzhezhi hhei jiere luiwo. <verse eid="JHN 1:32"/><verse number="33" style="v" sid="JHN 1:33"/>Bi melieshise hhei tani dane. Mii peizhi usughala xili gieghasan Huda made kieliewo, 'Shenlin kienyi jiere bouzhesei chi chanlase hhe Shenlinghala xili gieghane.' <verse eid="JHN 1:33"/><verse number="34" style="v" sid="JHN 1:34"/>Enei bi chanlawo. Eneshi Hudai kewon enbene giezhi bi ganzhen beine."<verse eid="JHN 1:34"/></para>
  <para style="s">Zui Melieshidaku Tujila</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35"/>Khuichuduni <char style="pn">Yaheiya</char> ghua tujilaghalane hhantu hhende beizho. <verse eid="JHN 1:35"/><verse number="36" style="v" sid="JHN 1:36"/><char style="pn">Yaheiya</char> <char style="pn">Ersa</char>i yosei chanladene kieliewo, "Uzhe, Hudai ghoni ghughan wo." <verse eid="JHN 1:36"/><verse number="37" style="v" sid="JHN 1:37"/>Ghua tujilani ene kielienyi sonosudene <char style="pn">Ersa</char>i daghawo. <verse eid="JHN 1:37"/><verse number="38" style="v" sid="JHN 1:38"/><char style="pn">Ersa</char> ochirasenu hhela daghasei chanladene asawo, "Ta yan kerene?" Hhela kieliewo, "Labi, chi khala souzho?" Labishi loushii isi wo. <verse eid="JHN 1:38"/><verse number="39" style="v" sid="JHN 1:39"/><char style="pn">Ersa</char> kieliewo, "Ta uzhele irendu." Hhela daghazhi echidene sousan oronyini uzhewo. Hhe xienzide chabudu xiawu 4 jien oluzho. Hhe udu hhela <char style="pn">Ersa</char>re hhantu souwo.<verse eid="JHN 1:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40"/>
    <char style="pn">Yaheiya</char>i kielienyi chenliedene <char style="pn">Ersa</char>i daghasan ghua kun dundadu nieshi <char style="pn">Ximun-Beduru</char>i jiuni <char style="pn">Andelie</char> wo. <verse eid="JHN 1:40"/><verse number="41" style="v" sid="JHN 1:41"/>Hhe xien <char style="pn">Ximun</char> gaine ereizhi oludene kieliewo, "Bijien Mexihai penjiwo!" Mexihai fanyi giese Jidu wo.<verse eid="JHN 1:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 1:42"/>Ingiedene hhe <char style="pn">Ximun</char>ni uduruzhi <char style="pn">Ersa</char>i shida echiwo. <char style="pn">Ersa</char> hhei uzhedene kieliewo, "Chishi <char style="pn">Yaheiya</char>i kewon <char style="pn">Ximun</char> wo. Ede chii <char style="pn">Jifa</char> giezhi urune." <char style="pn">Jifa</char>i fanyi giese <char style="pn">Beduru</char> wo.<note caller="+" style="f"><char style="fr">1:42</char> <char style="em">tashi</char> </note><verse eid="JHN 1:42"/></para>
  <para style="s">Feili Nadanyeghalai Ereizhi Tuji Danlaghazho</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43"/>Khuichuduni <char style="pn">Ersa</char> jiejin giezhi <char style="png">Jialili</char>de echine giezho. Ingiekude <char style="pn">Feili</char>i penjidene hhende kieliewo, "Chi mii dagha." <verse eid="JHN 1:43"/><verse number="44" style="v" sid="JHN 1:44"/><char style="pn">Feili</char>shi <char style="png">Bosaida</char> kun wo. <char style="pn">Andelie</char>, <char style="pn">Beduru</char> enelashi nie oronnughun wo.<verse eid="JHN 1:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 1:45"/>
    <char style="pn">Feili</char> <char style="pn">Nadanye</char>i ereizhi oludene kieliewo, "<char style="pn">Musa</char>i guijin jiere huaisan, xienzhila jilasan hhe kunyi bijien chanlawo. Hheshi <char style="png">Nasale</char> kun, <char style="pn">Yusufu</char>i kewon <char style="pn">Ersa</char> wo."<verse eid="JHN 1:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46"/>Ingie <char style="pn">Nadanye</char> kieliewo, "<char style="png">Nasale</char>se pse yama khizheneba." <char style="pn">Feili</char> kieliewo, "Chi iredene uzhe."<verse eid="JHN 1:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47"/>
    <char style="pn">Ersa</char> <char style="pn">Nadanye</char> shidani iresei chanladene kieliewo, "Uzhe, eneshi nie zhenzhenji <char style="png">Isilie</char> kun wo. Hhei zhughede yama huaini uwo."<verse eid="JHN 1:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48"/>
    <char style="pn">Nadanye</char> asawo, "Chi mii matugie taniwo?" <char style="pn">Ersa</char> kieliewo, "<char style="pn">Feili</char> chii da ese urukude chi uhuago mutun doura bikui bi chanlawo." <verse eid="JHN 1:48"/><verse number="49" style="v" sid="JHN 1:49"/><char style="pn">Nadanye</char> kieliewo, "Loushi, chishi Hudai Kewon, <char style="png">Isilie</char> kunni honshan wo."<verse eid="JHN 1:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50"/>
    <char style="pn">Ersa</char> kieliewo, "Bi chii uhuago mutun doura bikui chanlawo giezhi kieliese chi mii xianxin giewu? Chi enense da fugie shiqin uzhene." <verse eid="JHN 1:50"/><verse number="51" style="v" sid="JHN 1:51"/>Pse hhelade kieliewo, "Bi shuhuajia tande kielieye, asiman keizhi Hudai qienxienla Kunnikewonyi jiere bouzhi khikui ta chanlane."<verse eid="JHN 1:51"/></para>
  <chapter eid="JHN 1"/>
  <chapter number="2" style="c" sid="JHN 2"/>
  <para style="s">Jianade Usuni Jiu Bienjighazho</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1"/>Ghurudude <char style="png">Jialili</char>ni <char style="png">Jiana</char>de kunla ghurun ijiezho. <char style="pn">Ersa</char>i anani ye hhende wo. <verse eid="JHN 2:1"/><verse number="2" style="v" sid="JHN 2:2"/><char style="pn">Ersa</char>, tujilaini man hhantu xinlazhi echizho. <verse eid="JHN 2:2"/><verse number="3" style="v" sid="JHN 2:3"/>Jiuni ochizhi baraghawo. <char style="pn">Ersa</char>i anani <char style="pn">Ersa</char>de kieliewo, "Hhelade jiu widazho." <verse eid="JHN 2:3"/><verse number="4" style="v" sid="JHN 2:4"/><char style="pn">Ersa</char> kieliewo, "Ana, hhe made yan xiangan wo? Mii shihou da ese kuruzho." <verse eid="JHN 2:4"/><verse number="5" style="v" sid="JHN 2:5"/>Hhei anani hojilade kieliewo, "Hhe tai yan gieghase ta yan giendu."<verse eid="JHN 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6"/>Hhende usu zhonloku zhighon gan wine. Nie gande ghua ghuran tunzi usu zhonlone. Zhonmun libai giekude injiku usui hhende teizho. <verse eid="JHN 2:6"/><verse number="7" style="v" sid="JHN 2:7"/><char style="pn">Ersa</char> hojilade kieliewo, "Gande usui durugha." Ingiese hojila usui zhonlozhi gan kouzide khizheghawo. <verse eid="JHN 2:7"/><verse number="8" style="v" sid="JHN 2:8"/><char style="pn">Ersa</char> pse hojilade kieliewo, "Ede yuzhi xi gonjisan kunde khughozhi echigha." Ingiese hhela echighawo. <verse eid="JHN 2:8"/><verse number="9" style="v" sid="JHN 2:9"/>Xi gonjisan kun usu jiu bienjisei nie ochise ene jiu khalase iresei ulie mejiene. Zi usu yusan hojila mejiene. Xi gonjisan kun shini khughonyi uru ire kieliewo, <verse eid="JHN 2:9"/><verse number="10" style="v" sid="JHN 2:10"/>"Kunla gou jiuni melieshi ireghane. Zhochenla ochizhi sudosenu bixin jiuni ireghane. Chi matui gou jiuni feilieghazhi eli kuzho." <verse eid="JHN 2:10"/><verse number="11" style="v" sid="JHN 2:11"/>Eneshi <char style="pn">Ersa</char> xienjighasan tou 1 gie ghudureqi wo. <char style="png">Jialili</char>ni <char style="png">Jiana</char>de xienjighawo. Ene ghudureqighala kunlade famane mejieghawo. Ingiese tujilani hhei xianxin giewo.<verse eid="JHN 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12"/>Enense khuinashi <char style="pn">Ersa</char>, anani, jiulani, tujila man <char style="png">Jiabainun</char>de bouzhi echidene giedudu souwo.<verse eid="JHN 2:12"/></para>
  <para style="s">Mechini Ganjinraghazho</para>
  <para style="r">(<ref loc="MAT 21:12-13">Mat 21:12-13</ref>; <ref loc="MRK 11:15-17">Mak 11:15-17</ref>; <ref loc="LUK 19:45-46">Luj 19:45-46</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13"/>
    <char style="png">Yutai</char> kunni Jiulidaosan Jie ghujinlase <char style="pn">Ersa</char> <char style="png">Yelusalen</char>de echiwo. <verse eid="JHN 2:13"/><verse number="14" style="v" sid="JHN 2:14"/>Echise kunla mechide orodene meimei giesei chujieghewo. Kunla fughe, ghoni, ghoghochen huizho. Dazeghan kunla souzhi baer arunzhazho. <verse eid="JHN 2:14"/><verse number="15" style="v" sid="JHN 2:15"/>Ingiese <char style="pn">Ersa</char> jiesunyi mushigheidene fughe ghonilai mechise tou khighawo. Baer arunzhasan kunlai baerlani kie khizhegha, shirelani tungu unaghawo. <verse eid="JHN 2:15"/><verse number="16" style="v" sid="JHN 2:16"/>Pse ghoghochen huisan kunlade kieliewo, "Dunxilane man banji khirei! Adaimi giei meimei gieku oron bu gholugha!" <verse eid="JHN 2:16"/><verse number="17" style="v" sid="JHN 2:17"/>Ingiekude tujilani jinwun jiere huaisan kielienyi sumula irewo, "Bi Adane giede oluzhi zhughedemi khan siderazho." <verse eid="JHN 2:17"/><verse number="18" style="v" sid="JHN 2:18"/>Ingiese <char style="png">Yutai</char> kunla <char style="pn">Ersa</char>de kieliewo, "Chade ingiezhi gieku qienli winu? Chi bijiende yan ghudureqi xienjighane?" <verse eid="JHN 2:18"/><verse number="19" style="v" sid="JHN 2:19"/><char style="pn">Ersa</char> kieliewo, "Ta ene mechini chei. Bi ghurudude gie khizheghane." <verse eid="JHN 2:19"/><verse number="20" style="v" sid="JHN 2:20"/>Hhela kieliewo, "Ene mechishi 46 niende giezhi khireighasan wo. Chi ghurudude giezhi khizheghanu?" <verse eid="JHN 2:20"/><verse number="21" style="v" sid="JHN 2:21"/><char style="pn">Ersa</char> kieliesan mechishi goya beyene kieliezho. <verse eid="JHN 2:21"/><verse number="22" style="v" sid="JHN 2:22"/><char style="pn">Ersa</char> aminne oludene tujilani <char style="pn">Ersa</char>i ene nie aman kielienyi sumula irewo. Ingiese hhela jinwunyi xianxin giewo. <char style="pn">Ersa</char> kieliesan kielienlai ye xianxin giewo.<verse eid="JHN 2:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23"/>
    <char style="pn">Ersa</char> <char style="png">Yelusalen</char>de Jiulidaosan Jie daoghakude ghudureqi xienjighase olon kunla uzhedene <char style="pn">Ersa</char>i xianxin giewo. <verse eid="JHN 2:23"/><verse number="24" style="v" sid="JHN 2:24"/>Ingieliuzhe <char style="pn">Ersa</char> hhelai xianxin ese giezho. <char style="pn">Ersa</char> kunlai man mejiene. <verse eid="JHN 2:24"/><verse number="25" style="v" sid="JHN 2:25"/>Hhe kunni zhughede yan bikuni mejiene. Ingiese hhende kunshi matunie bikui kielieku biyo uwo.<verse eid="JHN 2:25"/></para>
  <chapter eid="JHN 2"/>
  <chapter number="3" style="c" sid="JHN 3"/>
  <para style="s">Ersa Nigedemu Ghuala</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1"/>Falisaini nie kunyi niereni <char style="pn">Nigedemu</char> giene. <char style="png">Yutai</char> kunlani nie lindao wo. <verse eid="JHN 3:1"/><verse number="2" style="v" sid="JHN 3:2"/>Ene kun xienidei <char style="pn">Ersa</char>i ochirale ire hhende kieliewo, "Labi, chi Hudai hhense iresan loushi bikui bijien mejiene. Huda chighala hhantu wise chi giesan ghudureqini kiemada gie dane." <verse eid="JHN 3:2"/><verse number="3" style="v" sid="JHN 3:3"/><char style="pn">Ersa</char> hhende kieliewo, "Bi chade shuhuajia kielieye, kunyi erchan<note caller="+" style="f"><char style="fr">3:3</char> <char style="em">jierese</char> </note> ulie oluse Hudai gojiai chanla dane." <verse eid="JHN 3:3"/><verse number="4" style="v" sid="JHN 3:4"/><char style="pn">Nigedemu</char> kieliewo, "Kun fugiedadene pse matugie olune? Anane kielide orosenu pse olunu?" <verse eid="JHN 3:4"/><verse number="5" style="v" sid="JHN 3:5"/><char style="pn">Ersa</char> kieliewo, "Bi chade shuhuajia kielieye, kunyi usu, Shenlinse ulie oluse Hudai gojiade oro dane. <verse eid="JHN 3:5"/><verse number="6" style="v" sid="JHN 3:6"/>Beyese olusanshi beye wo, ruhherse olusanshi ruhher wo. <verse eid="JHN 3:6"/><verse number="7" style="v" sid="JHN 3:7"/>Bi kieliese ta erchan olukuni wo giese ta bu ghudure. <verse eid="JHN 3:7"/><verse number="8" style="v" sid="JHN 3:8"/>Kei suibien feiliekui ta sonosu shidanema, khalase iresanyi, khala echikui ulie mejiene. Ruhherse olusan kun keighala niekielien wo."<verse eid="JHN 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9"/>
    <char style="pn">Nigedemu</char> asazho. "Matugie imutu shiqin wine?"<verse eid="JHN 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10"/>
    <char style="pn">Ersa</char> kieliewo, "Chishi <char style="png">Isilie</char>ni fugie loushi wo. Ene shiqinyi ulie mejienu? <verse eid="JHN 3:10"/><verse number="11" style="v" sid="JHN 3:11"/>Bi shuhuajia kielieye, bijien mejiesanne tande kieliezho, chujieghesanne ganzhen beizhoma, ta bijienyi kielienyi xianxin ulie giene. <verse eid="JHN 3:11"/><verse number="12" style="v" sid="JHN 3:12"/>Bi zemin jieredu shiqinyi kieliese ta xianxin ulie giene, asiman jieredu shiqinyi kieliese matugie xianxin giene? <verse eid="JHN 3:12"/><verse number="13" style="v" sid="JHN 3:13"/>Asiman jierese bouzhesan Kunnikewonse chugo kiemada asiman jiere khizhi ese daozho. <verse eid="JHN 3:13"/><verse number="14" style="v" sid="JHN 3:14"/><char style="pn">Musa</char> hontande mogheini qila qiighaku mutun Kunnikewonniye qingiezhi qila qiighane. <verse eid="JHN 3:14"/><verse number="15" style="v" sid="JHN 3:15"/>Ingiese jien hhei xianxin giesan kunlade chanqiku amin ogine giezho. <verse eid="JHN 3:15"/><verse number="16" style="v" sid="JHN 3:16"/>Huda duyani kunlade olon orezhi lien niekozi kewonneliuzhe ogiwo. Ingiese jien hhei xianxin giesan kunlai ulie widaghazhi chanqiku amin ogine giezho. <verse eid="JHN 3:16"/><verse number="17" style="v" sid="JHN 3:17"/>Hhe kewonne peizhi duyade ireghase zui jinjile ese irezho, kunlai jiuighale irezho. <verse eid="JHN 3:17"/><verse number="18" style="v" sid="JHN 3:18"/>Hhei xianxin giesan kunlade zui ulie jinjine. Xianxin ulie giesan kunlade zui ijin jinjiwo. Hhela Hudai niekozi kewonni xianxin ese giezho. <verse eid="JHN 3:18"/><verse number="19" style="v" sid="JHN 3:19"/>Hhela giesan doghunnishi gon duyade irese gonde xiqi uwo, kharanide xiqi wo. Hhelai zuini jiu ingiezhi soughawo. <verse eid="JHN 3:19"/><verse number="20" style="v" sid="JHN 3:20"/>Doghunni giesanla gonni henjine, gon shida ulie irene. Giesanlaini khizheghakuse ayizho. <verse eid="JHN 3:20"/><verse number="21" style="v" sid="JHN 3:21"/>Zhendaode giesan kunla gon shida irene. Hudai isighala giesan shiqinlai man mejieghane giezho."<verse eid="JHN 3:21"/></para>
  <para style="s">Yaheiya Ersani Kuaizho</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22"/>Enense khuinashi <char style="pn">Ersa</char> tujilarene <char style="png">Yudaya</char>ni oronde echidene nietan souzhi kunlai xili gieghazho. <verse eid="JHN 3:22"/><verse number="23" style="v" sid="JHN 3:23"/><char style="png">Salen</char>ni kouisan <char style="png">Ainen</char>de usu olonshi <char style="pn">Yaheiya</char>ye hhende xili gieghazho. Kunla hhende xili gieghakui jienliele irezho. <verse eid="JHN 3:23"/><verse number="24" style="v" sid="JHN 3:24"/>Hhe shihoude <char style="pn">Yaheiya</char>ni da bafanzide bareizhi ese echizho. <verse eid="JHN 3:24"/><verse number="25" style="v" sid="JHN 3:25"/><char style="pn">Yaheiya</char>i tujila nie <char style="png">Yutai</char> kunghala waghaku banfa jiere jianjindu qiiwo. <verse eid="JHN 3:25"/><verse number="26" style="v" sid="JHN 3:26"/>Hhela <char style="pn">Yaheiya</char> shida iredene kieliewo, "Loushi, melieshida <char style="png">Yedanhe</char> hhemiende chighala hhantulasan hhe kun ede kunlade xili gieghazho. Chi hhende ganzhen beizho. Kunla man hhei shida echizho." <verse eid="JHN 3:26"/><verse number="27" style="v" sid="JHN 3:27"/><char style="pn">Yaheiya</char> kieliewo, "Huda ulie ogise kun yama jienlie dane. <verse eid="JHN 3:27"/><verse number="28" style="v" sid="JHN 3:28"/>Bishi Mexiha pusho. Mii hhense melie peizhi ireghawo giezhi bi kieliezhi daosei ta mejiene. <verse eid="JHN 3:28"/><verse number="29" style="v" sid="JHN 3:29"/>Shini bierei agikushi shini khughon wo. Peikieni hhei kanzide beizhi shenqiini nie sonosuse hende bayasune. Biye qingiezhi hende bayasuzho. <verse eid="JHN 3:29"/><verse number="30" style="v" sid="JHN 3:30"/>Hhe hendakuni wo, bi bixindakuni wo."<verse eid="JHN 3:30"/></para>
  <para style="s">Asiman Jierese Iresan</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31"/>"Jierese iresan hhe yanseliuzhe fugie wo. Zemin jierese iresanshi zemin jieredu wo. Kieliesan kielienla yeshi zemin jieredu wo. Asiman jierese iresan hheshi yanseliuzhe fugie wo. <verse eid="JHN 3:31"/><verse number="32" style="v" sid="JHN 3:32"/>Hhe chujieghesanne, chenliesanne ganzhen beizhoma, hhei ganzhenyi kiema ulie jienliene. <verse eid="JHN 3:32"/><verse number="33" style="v" sid="JHN 3:33"/>Hhei ganzhenyi xianxin giesan kunla Hudashi zhenni enbene giezho. <verse eid="JHN 3:33"/><verse number="34" style="v" sid="JHN 3:34"/>Huda peizhi ireghasan hhe Hudai kielienyi kieliene. Huda hhende Shenlinni shuzi witui ogizho. <verse eid="JHN 3:34"/><verse number="35" style="v" sid="JHN 3:35"/>Adani kewondene orezhi man hhei khade jiuiwo. <verse eid="JHN 3:35"/><verse number="36" style="v" sid="JHN 3:36"/>Kewonyini xianxin giesan kunde chanqiku amin wine. Hhei ulie shunjichen kunde amin uwo. Hudai hokuku chan hhei jiere wo."<verse eid="JHN 3:36"/></para>
  <chapter eid="JHN 3"/>
  <chapter number="4" style="c" sid="JHN 4"/>
  <para style="s">Samaliyani Biereighala Kielien Kieliezho</para>
  <para style="p">
    <verse number="1-3" style="v" sid="JHN 4:1-3"/>Falisai kun chenliese <char style="pn">Ersa</char> <char style="pn">Yaheiya</char>se tuji olon ghurazhi xili gieghazho. Shiji jiere <char style="pn">Ersa</char> goyane xili ese gieghazho, tujilani gieghazho. <char style="pn">Ersa</char> ene shiqinlai mejiedene <char style="png">Yudaya</char>se likai gie <char style="png">Jialili</char>de khareine giezho.<verse eid="JHN 4:1-3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 4:4"/>Echikudeni <char style="png">Samaliya</char> moni daone. <verse eid="JHN 4:4"/><verse number="5" style="v" sid="JHN 4:5"/><char style="png">Samaliya</char>i nie chenshide kuruwo. Niereini <char style="png">Xijia</char> giene. Ene chenshishi <char style="pn">Yagebu</char> <char style="pn">Yusufu</char> kewondene ogisan oron konde wo. <verse eid="JHN 4:5"/><verse number="6" style="v" sid="JHN 4:6"/><char style="pn">Yagebu</char>ni jin hhende wo. <char style="pn">Ersa</char> yozhi hhechese jin konde souwo. Chabudu zhunwu xienzi wo. <verse eid="JHN 4:6"/><verse number="7" style="v" sid="JHN 4:7"/><char style="png">Samaliya</char>i nie bierei usu daile irese <char style="pn">Ersa</char> hhende kieliewo, "Made ususene gouji ogi." <verse eid="JHN 4:7"/><verse number="8" style="v" sid="JHN 4:8"/>Ene shihoude tujilani chenshise ijiuni agile echizho. <verse eid="JHN 4:8"/><verse number="9" style="v" sid="JHN 4:9"/><char style="png">Samaliya</char>i bierei kieliewo, "Chishi <char style="png">Yutai</char> kun wo. Matugie <char style="png">Samaliya</char>i nie biereise usu kerene?" Yenlai <char style="png">Yutai</char> kun <char style="png">Samaliya</char> kunghala laiwon ese giezho. <verse eid="JHN 4:9"/><verse number="10" style="v" sid="JHN 4:10"/><char style="pn">Ersa</char> kieliewo, "Chi Hudai nenjienni mejiese, pse chase usu keresanshi kien bikui mejiese chi hhei xiahua giene, hhe amitu usui chade ogine." <verse eid="JHN 4:10"/><verse number="11" style="v" sid="JHN 4:11"/>Bierei kieliewo, "Gujiu, chade usu daiku tunzida uwo. Jin imutu gun wo. Chi khalase amitu usu daine? <verse eid="JHN 4:11"/><verse number="12" style="v" sid="JHN 4:12"/>Bijienyi xienren <char style="pn">Yagebu</char> ene jinni bijiende jiewo. Hhe goyane, kesilani, asunla man enense ijiezho. Chi hhense da fugie onu?" <verse eid="JHN 4:12"/><verse number="13" style="v" sid="JHN 4:13"/><char style="pn">Ersa</char> kieliewo, "Ene usui usan kunla pse undasune. <verse eid="JHN 4:13"/><verse number="14" style="v" sid="JHN 4:14"/>Bi ogisan usui use chanqi ulie undasune. Bi ogisan usu hhei sudoro bula gholuzhi izhi usuruzhi khizhezhi hhende chanqiku amin ogine." <verse eid="JHN 4:14"/><verse number="15" style="v" sid="JHN 4:15"/>Bierei kieliewo, "Gujiu, made ene usui nie ogi. Ingiese bi ulie undasune. Bi pse enense usu daile ulie irene." <verse eid="JHN 4:15"/><verse number="16" style="v" sid="JHN 4:16"/><char style="pn">Ersa</char> kieliewo, "Chi echidene zhanguijine uruzhi ire." <verse eid="JHN 4:16"/><verse number="17" style="v" sid="JHN 4:17"/>Bierei kieliewo, "Made zhanguiji uwo." <char style="pn">Ersa</char> kieliewo, "Chade zhanguiji uwo giezhi kieliesan oluzho. <verse eid="JHN 4:17"/><verse number="18" style="v" sid="JHN 4:18"/>Melieshida chade tawun zhanguiji wine. Edekushi chii zhanguiji pusho. Chi kieliesan oluzho." <verse eid="JHN 4:18"/><verse number="19" style="v" sid="JHN 4:19"/>Bierei kieliewo, "Gujiu, bi uzhese chishi nie xienzhi wo. <verse eid="JHN 4:19"/><verse number="20" style="v" sid="JHN 4:20"/>Bijien <char style="png">Samaliya</char> kunyi xienrenla ene ulade beii giezhoma, ta <char style="png">Yutai</char> kunla kieliese <char style="png">Yelusalen</char>shi beiiku oron wo giezho." <verse eid="JHN 4:20"/><verse number="21" style="v" sid="JHN 4:21"/><char style="pn">Ersa</char> kieliewo, "Funi, mii xianxin gie. Shihou kuzhese Adai beiiku ene ulade uwo, <char style="png">Yelusalen</char>de ye uwo. <verse eid="JHN 4:21"/><verse number="22" style="v" sid="JHN 4:22"/>Ta <char style="png">Samaliya</char> kun kienyi beiisanne ulie mejiene. Bijien <char style="png">Yutai</char> kun kienyi beiisanne mejiene. Jiuikushi <char style="png">Yutai</char> kunni tungo giezhi irene. <verse eid="JHN 4:22"/><verse number="23" style="v" sid="JHN 4:23"/>Shihou kuzhese Adai shixinji beiisan kun zhughesene shixinji beiine. Shihou ede enbene. Ada ingiezhi goude beiisan kunyi ereine. <verse eid="JHN 4:23"/><verse number="24" style="v" sid="JHN 4:24"/>Hudashi ruhher wo. Hhei beiisan kun indan zhughesene shixinji beiikuni wo." <verse eid="JHN 4:24"/><verse number="25" style="v" sid="JHN 4:25"/>Bierei kieliewo, "Hhe Jidu giezhi urusan Mexihai irekui bi mejiene. Hhe irese bijiende man mejieghane." <verse eid="JHN 4:25"/><verse number="26" style="v" sid="JHN 4:26"/><char style="pn">Ersa</char> kieliewo, "Chimare kielien kieliesanshi enbene."<verse eid="JHN 4:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27"/>Ingiekude tujilani kharei ire <char style="pn">Ersa</char> nie biereire kielien kieliesei uzhedene ghanirazho. Chi yan kerene? Chi yangiezhi biereighala kielien kieliezho giezhi kiema asa dawo. <verse eid="JHN 4:27"/><verse number="28" style="v" sid="JHN 4:28"/>Hhe bierei usu tunzine jie, chenshide echisenu olon kunlade kieliewo, <verse eid="JHN 4:28"/><verse number="29" style="v" sid="JHN 4:29"/>"Ta uzhele irendu, nie kun bi giesan shiqinlai man kielie khizheghawo! Ene kunshi Mexiha enbeneba?" <verse eid="JHN 4:29"/><verse number="30" style="v" sid="JHN 4:30"/>Ingiese kunla aghinse khizhe <char style="pn">Ersa</char>i hhende echiwo.<verse eid="JHN 4:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31"/>Ingiekude tujilani kieliewo, "Loushi, ijie." <verse eid="JHN 4:31"/><verse number="32" style="v" sid="JHN 4:32"/><char style="pn">Ersa</char> kieliewo, "Made ta mejie daku ijiuni wine." <verse eid="JHN 4:32"/><verse number="33" style="v" sid="JHN 4:33"/>Ingiese tujilani nieniedene asazho, "Kunla ogizhi ijieghazhoba?" <verse eid="JHN 4:33"/><verse number="34" style="v" sid="JHN 4:34"/><char style="pn">Ersa</char> kieliewo, "Mii ijiunishi mii peizhi ireghasan hhei isini gieku wo. Hhei wilielai chengun olughane. <verse eid="JHN 4:34"/><verse number="35" style="v" sid="JHN 4:35"/>Ta kieliese pse jieran sarashi boudei ghuraku shihou olune giezho. Bi tande kielieye, ta qiorunne qila hhe ghazhade nie uzhe, ede ghuraku oluwo. <verse eid="JHN 4:35"/><verse number="36" style="v" sid="JHN 4:36"/>Ghurasan kun gunzi bareizhi chanqiku aminde ugu cunjizho. Ingiese tareisan kun ghurasan kunghala hhantu bayasune. <verse eid="JHN 4:36"/><verse number="37" style="v" sid="JHN 4:37"/>Kienni kieliedanma, 'Nie kun tareine, da nie kun ghurane.' Ene kielien oluzho. <verse eid="JHN 4:37"/><verse number="38" style="v" sid="JHN 4:38"/>Bi tai peizhi ghuraghale echise ta ese khishulasan ghazhade echighawo. Ta kunla khishulasei xianshou giezho."<verse eid="JHN 4:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39"/>Hhe bierei ganzhen beizhi, "Bi giesan shiqinlai hhe kun man kielie khizheghawo!" giezhi kieliese hhe chenshidedu olon <char style="png">Samaliya</char> kunla <char style="pn">Ersa</char>i xianxin giewo. <verse eid="JHN 4:39"/><verse number="40" style="v" sid="JHN 4:40"/><char style="png">Samaliya</char> kunla <char style="pn">Ersa</char>i ochirale irewo. Hhei xiahua giezhi hhelai hhende sou giese, <char style="pn">Ersa</char> ghuarudu souwo. <verse eid="JHN 4:40"/><verse number="41" style="v" sid="JHN 4:41"/><char style="pn">Ersa</char>i kielienyi chenliedene xianxin giesan kun pse olodowo. <verse eid="JHN 4:41"/><verse number="42" style="v" sid="JHN 4:42"/>Hhela biereide kieliewo, "Bijien ede xianxin giese chi kieliesan pusho. Bijien goyane hhei kielienyini chenliedene hheshi zhenzhenji duyani jiuichen enbekui mejiewo."<verse eid="JHN 4:42"/></para>
  <para style="s">Noyenni Kewonni Goudaghazho</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43"/>Ghuarudu daosenu <char style="pn">Ersa</char> hhe oronse likai gie <char style="png">Jialili</char>de echiwo. <verse eid="JHN 4:43"/><verse number="44" style="v" sid="JHN 4:44"/><char style="pn">Ersa</char> goyane kieliezhi daozho, "Xienzhini goya aghindene ulie zunjine."<verse eid="JHN 4:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 4:45"/>
    <char style="pn">Ersa</char> <char style="png">Jialili</char>de kuse hhe oronyi kunla jienliezho. Hhela <char style="png">Yelusalen</char>de jieqi daoghale echisande <char style="pn">Ersa</char> giesan shiqinlai man uzhewo. <verse eid="JHN 4:45"/><verse number="46" style="v" sid="JHN 4:46"/><char style="pn">Ersa</char> pse <char style="png">Jialili</char>ni <char style="png">Jiana</char>de khareizhi irewo. Yen melieshida usui jiu gholughasan hhe oronde wo. Hhende nie fugie noyen wine, kewonni <char style="png">Jiabainun</char>de giemerezho. <verse eid="JHN 4:46"/><verse number="47" style="v" sid="JHN 4:47"/><char style="pn">Ersa</char> <char style="png">Yudaya</char>se <char style="png">Jialili</char>de iresanyi hhe sonosudene ochirale ire, "Mii kewon duya ijiene giezho. Goudaghale yo!" giezhi xiahua giewo. <verse eid="JHN 4:47"/><verse number="48" style="v" sid="JHN 4:48"/><char style="pn">Ersa</char> kieliewo, "Ta ghudureqi, fugie shiqinlai ulie chanlatula xianxin ulie giene."<verse eid="JHN 4:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49"/>Noyen kieliewo, "Gujiu, kewonmi ese duya ijietula nie bouzhi yo."<verse eid="JHN 4:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50"/>
    <char style="pn">Ersa</char> kieliewo, "Chi kharei, kewonchii goudawo." Hhe kun <char style="pn">Ersa</char>i kielienyi xianxin giedene khareiwo. <verse eid="JHN 4:50"/><verse number="51" style="v" sid="JHN 4:51"/>Giedene boukudeni mo jiere hojilani hhei jienliele ire, "Kewonchii goudawo." giezhi kieliewo. <verse eid="JHN 4:51"/><verse number="52" style="v" sid="JHN 4:52"/>Ingiese hhe asawo, "Kewon yan shihoude goudawo?" Hojila kieliewo, "Uchughudu xiawu 1 jiende tuishao giezhi qiiwo." <verse eid="JHN 4:52"/><verse number="53" style="v" sid="JHN 4:53"/>Ingiese adani <char style="pn">Ersa</char> kewonchii goudawo giesan hhe shihoui mejiewo. Ingiese hhe nie giechilie man <char style="pn">Ersa</char>i xianxin giewo. <verse eid="JHN 4:53"/><verse number="54" style="v" sid="JHN 4:54"/>Eneshi <char style="pn">Ersa</char> <char style="png">Yudaya</char>se <char style="png">Jialili</char>de khareidene giesan ji 2 gie ghudureqi wo.<verse eid="JHN 4:54"/></para>
  <chapter eid="JHN 4"/>
  <chapter number="5" style="c" sid="JHN 5"/>
  <para style="s">38 Nien Olusan Gientui Goudaghazho</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1"/>Enense khuinashi <char style="png">Yutai</char> kunyi nie jieqi kuzhewo. <char style="pn">Ersa</char> <char style="png">Yelusalen</char>de khizhi echiwo. <verse eid="JHN 5:1"/><verse number="2" style="v" sid="JHN 5:2"/><char style="png">Yelusalen</char>yi <char style="png">Ghoni wijien</char> shida nie bula wine. <char style="png">Xibolai</char> kielienghala kieliese <char style="png">Bishida</char> giene. Bula zhouwide tawun zoulan wine. <verse eid="JHN 5:2"/><verse number="3" style="v" sid="JHN 5:3"/>Zoulande giemeresan kun olon kijiezho. Sugho, dogholon, beye fugusan kun olon wo. <verse eid="JHN 5:3"/><verse number="5" style="v" sid="JHN 5:5"/>Hhende nie kun giemerezhi 38 nien olune. <verse eid="JHN 5:5"/><verse number="6" style="v" sid="JHN 5:6"/><char style="pn">Ersa</char> hhe kijiesei chujieghewo. Oloncha giemeresei mejiesenu asawo, "Chi gienne goudaghaku duran winu?" <verse eid="JHN 5:6"/><verse number="7" style="v" sid="JHN 5:7"/>Giemeresan kun kieliewo, "Gujiu, usu gojiolukudei mii usude boughachen kun uwo. Bi goya boukudei kunla mase melieshida qianla boune." <verse eid="JHN 5:7"/><verse number="8" style="v" sid="JHN 5:8"/>Ingiese <char style="pn">Ersa</char> kieliewo, "Bosizhedene ruzine agidei echi." <verse eid="JHN 5:8"/><verse number="9" style="v" sid="JHN 5:9"/>Hhe kun deigo gouda ruzine agisenu yozhi echiwo.</para>
  <para style="p" vid="JHN 5:9">Hhe nie udushi hhamuraku udu wo. <verse eid="JHN 5:9"/><verse number="10" style="v" sid="JHN 5:10"/>Ingiese <char style="png">Yutai</char> kunla hhe goudasan kunde kieliewo, "Enedushi hhamuraku udu wo. Chi ruzii bareizhi yose ese oluzho." <verse eid="JHN 5:10"/><verse number="11" style="v" sid="JHN 5:11"/>Hhe kun kieliewo, "Mii goudaghasan kun ruzine bareizhi yo giezhi made kieliewo." <verse eid="JHN 5:11"/><verse number="12" style="v" sid="JHN 5:12"/>Hhela asazho, "Chade ruzine agidene yo giesanshi kien wine?" <verse eid="JHN 5:12"/><verse number="13" style="v" sid="JHN 5:13"/>Goudasan kun kien hhei goudaghasei ulie mejiene. Hhende kun olonshi <char style="pn">Ersa</char> niui widazho. <verse eid="JHN 5:13"/><verse number="14" style="v" sid="JHN 5:14"/>Khuinashi <char style="pn">Ersa</char> mechide hhe kunyi chujieghedene kieliewo, "Chi ede goudawoma, pse zui bu fanji. Pse enense yenzhunshine." <verse eid="JHN 5:14"/><verse number="15" style="v" sid="JHN 5:15"/>Hhe kun echidene <char style="png">Yutai</char> kunlade kieliewo, "Mii goudaghasanshi <char style="pn">Ersa</char> wo."<verse eid="JHN 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 5:16"/>Ingiese <char style="png">Yutai</char> kunla <char style="pn">Ersa</char> chan hhamuraku udude enezighan shiqinlai giese hhei heizhi qiiwo. <verse eid="JHN 5:16"/><verse number="17" style="v" sid="JHN 5:17"/><char style="pn">Ersa</char> hhelade kieliewo, "Adami izhi eli kutula wilie giezho, biye giezho." <verse eid="JHN 5:17"/><verse number="18" style="v" sid="JHN 5:18"/>Ingiese <char style="png">Yutai</char> kunla hhei alane giezhi hendawo. Hhe hhamuraku udui guijinyi ese zunjizho, da Hudashi goyai Ada wo giezho. Pse goyane Hudaghala pin wo giezho.<verse eid="JHN 5:18"/></para>
  <para style="s">Hudai Kewonni Qienli</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19"/>
    <char style="pn">Ersa</char> hhelade kieliewo, "Bi tande shuhuajia kielieye. Kewon goyane kouizhi yama gie dane. Zinie Ada giesanyi uzhedene giezho. Ada giesan wilielai Kewon ye giene. <verse eid="JHN 5:19"/><verse number="20" style="v" sid="JHN 5:20"/>Ada Kewondene orezhi goya giesanlane hhende man uzheghazho. Da enense fugie shiqinlai hhende uzheghane. Ingiese tai ghaniraghane. <verse eid="JHN 5:20"/><verse number="21" style="v" sid="JHN 5:21"/>Ada fugusan kunlai bosi ireghazhi amin ogiku mutun Kewonniye goya duranghalane kunlade amin ogine. <verse eid="JHN 5:21"/><verse number="22" style="v" sid="JHN 5:22"/>Ada yan kunyiliuzhe ulie panjinema, panjiku qienlini Kewondene jiuizhi ogiwo. <verse eid="JHN 5:22"/><verse number="23" style="v" sid="JHN 5:23"/>Ingiese kunla Adai zunjiku mutun Kewonne zunjighane giezho. Kewonni ulie zunjise hhei peizhi ireghasan Adainiye uye zunjizho. <verse eid="JHN 5:23"/><verse number="24" style="v" sid="JHN 5:24"/>Bi tande shuhuajia kielieye, kien mii kielienyi chenliezhi mii peizhi ireghasan hhei xianxin giese chanqiku amin wine. Zui ulie soughane, fugukuse amitude ijin ireghawo."<verse eid="JHN 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 5:25"/>"Bi tande shuhuajia kielieye, shihou kuzhese fugusan kunla Kunnikewonni shenqii sonosune. Sonosusan kunla aminne olune. Ede hhe shihou enbene. <verse eid="JHN 5:25"/><verse number="26" style="v" sid="JHN 5:26"/>Ada benshenshi aminni genzi wo. Kewonneye aminni genzi gholughawo. <verse eid="JHN 5:26"/><verse number="27" style="v" sid="JHN 5:27"/>Hheshi Kunnikewon wo. Ingiese Ada hhende kunlai panjiku qienlii ogiwo. <verse eid="JHN 5:27"/><verse number="28" style="v" sid="JHN 5:28"/>Ta ene shiqinde bu ghanira, shihou kuzhese mezai kunla man Kewonni shenqii sonosuse, <verse eid="JHN 5:28"/><verse number="29" style="v" sid="JHN 5:29"/>fuho giedene khizhene. Gouni giesanla chanqi amiturane, huaishi giesanlade zui jinjine."<verse eid="JHN 5:29"/></para>
  <para style="s">Ersade Ganzhen Beizho</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 5:30"/>"Bi goyane kouizhi yama gie dane. Bi matui sonosuse matui panjine. Bi panjisanshi gundanni wo. Bi panjise goya isighalane ese giezho. Mii peizhi ireghasan hhei isighala giezho."<verse eid="JHN 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31"/>"Bi goyadene ganzhen beise zoin ulie qiine. <verse eid="JHN 5:31"/><verse number="32" style="v" sid="JHN 5:32"/>Da niekozi made ganzhen beizho. Hhe beisanshi zhenni bikui bi mejiene. <verse eid="JHN 5:32"/><verse number="33" style="v" sid="JHN 5:33"/>Ta melieshidase <char style="pn">Yaheiya</char>i hhende kun peizhi echighase <char style="pn">Yaheiya</char> zhendaode ganzhen beizho. <verse eid="JHN 5:33"/><verse number="34" style="v" sid="JHN 5:34"/>Bi kunse ganzhen ulie kerenema, bi ene kielienyi kieliekushi tai jiuine giezho. <verse eid="JHN 5:34"/><verse number="35" style="v" sid="JHN 5:35"/><char style="pn">Yaheiya</char>shi siderazhi gon faisan zhula niekielien wo. Ta zhanshi jiere hhei gonde xiqi woma, <verse eid="JHN 5:35"/><verse number="36" style="v" sid="JHN 5:36"/>made <char style="pn">Yaheiya</char>se da fugie ganzhen wine. Hheshi Adami mii onchengie giesan wilie wo. Ede bi giesan wilie enbene. Ene wiliela Adami mii peizhi ireghasande ganzhen beizho. <verse eid="JHN 5:36"/><verse number="37" style="v" sid="JHN 5:37"/>Pse mii peizhi ireghasan Adami made ganzhen beizho. Ta hhei shenqiini chenliezhi uye daozho. Yanziini ye uzhezhi uye daozho. <verse eid="JHN 5:37"/><verse number="38" style="v" sid="JHN 5:38"/>Ada peizhi ireghasei ta xianxin ese giezho, ingiese hhei kielienyi ta zhughedene ese teizho."<verse eid="JHN 5:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 5:39"/>"Ta sumulase jinwunyi uzhezhi suruse hhe jierese chanqiku aminyi ereine giezhoma, jinwun zhen made ganzhen beizho. <verse eid="JHN 5:39"/><verse number="40" style="v" sid="JHN 5:40"/>Ingieliuzhe ta aminni mii enense ereile ulie irene."<verse eid="JHN 5:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41"/>"Kun mii kuaikui bi ulie jienliene. <verse eid="JHN 5:41"/><verse number="42" style="v" sid="JHN 5:42"/>Bi tai mejiene. Tande Hudade oreku zhughe uwo. <verse eid="JHN 5:42"/><verse number="43" style="v" sid="JHN 5:43"/>Bi Adane niereghala irese ta ulie jienliene. Kunla goya niereghalane irese ta jienliene. <verse eid="JHN 5:43"/><verse number="44" style="v" sid="JHN 5:44"/>Ta nieniene kuaikui jienlienduzhoma, niekozi Hudase iresan kuaikui ulie ereine. Ingiese ta mii matui xianxin giene? <verse eid="JHN 5:44"/><verse number="45" style="v" sid="JHN 5:45"/>Bi Adai melie tai zhane giezhi bu sumula. Tai zhakui da nie wine. Ta kouizhi xianxin giesan <char style="pn">Musa</char> tai zhane. <verse eid="JHN 5:45"/><verse number="46" style="v" sid="JHN 5:46"/>Ta <char style="pn">Musa</char>i xianxin giese miiye xianxin giekui wo. Hhe huaisanshi mii zhiizhi kieliezho. <verse eid="JHN 5:46"/><verse number="47" style="v" sid="JHN 5:47"/>Hhe huaisanyi ta xianxin ulie giese mii kielienyi matugie xianxin giene?"<verse eid="JHN 5:47"/></para>
  <chapter eid="JHN 5"/>
  <chapter number="6" style="c" sid="JHN 6"/>
  <para style="s">5000 Kunde Chudughazho</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mat 14:13-21</ref>; <ref loc="MRK 6:30-44">Mak 6:30-44</ref>; <ref loc="LUK 9:10-17">Luj 9:10-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1"/>Enense khuinashi <char style="pn">Ersa</char> <char style="png">Jialilihai</char>ni daowo. Hhei <char style="png">Qibiliyahai</char> giezhi ye uruzho. <verse eid="JHN 6:1"/><verse number="2" style="v" sid="JHN 6:2"/>Tebieji olon kunla hhe gientulai goudaghasan ghudureqii uzhedene hhei daghazho. <verse eid="JHN 6:2"/><verse number="3" style="v" sid="JHN 6:3"/><char style="pn">Ersa</char> ulade khirei tujilarene hhantu souwo. <verse eid="JHN 6:3"/><verse number="4" style="v" sid="JHN 6:4"/>Hhe shihoude <char style="png">Yutai</char> kunni Jiulidaosan Jie chadashizho. <verse eid="JHN 6:4"/><verse number="5" style="v" sid="JHN 6:5"/><char style="pn">Ersa</char> qiorunne qila uzhese tebieji olon kunla hhei melie iresei chanladene <char style="pn">Feili</char>de kieliewo, "Matan khalase imegheni ginan agizhi irezhi ene kunlade ijieghane?" <verse eid="JHN 6:5"/><verse number="6" style="v" sid="JHN 6:6"/>Hhe ingiezhi kieliese <char style="pn">Feili</char>i shiizho. Goyane matui giekui eqie mejiene. <verse eid="JHN 6:6"/><verse number="7" style="v" sid="JHN 6:7"/><char style="pn">Feili</char> kieliewo, "200 gie miengughala ginan agise nie kunde goujinie ijiezhiye ulie kurune." <verse eid="JHN 6:7"/><verse number="8" style="v" sid="JHN 6:8"/>Nie tujishi <char style="pn">Ximun-Beduru</char>i jiuni <char style="pn">Andelie</char> wo. <char style="pn">Ersa</char>de kieliewo, <verse eid="JHN 6:8"/><verse number="9" style="v" sid="JHN 6:9"/>"Enende nie ga kewon dunmaighala giesan tawun ginanji ghua zhaghasun bareizho. Imegheni kunlade yan gholune?" <verse eid="JHN 6:9"/><verse number="10" style="v" sid="JHN 6:10"/><char style="pn">Ersa</char> "Dajialai sougha." giezhi kieliewo. Hhe oronde osun henshi kunla souwo. Gon ere kun sanase chabudu 5000 wine. <verse eid="JHN 6:10"/><verse number="11" style="v" sid="JHN 6:11"/><char style="pn">Ersa</char> ginanyi barei Hudade mafan kieliedene sousan kunlade ghughazhi ogiwo. Zhaghasunyiye ingiezhi giedene kunlade ogiwo. Dajiala giedughonni ijiese giedughonni ogiwo. <verse eid="JHN 6:11"/><verse number="12" style="v" sid="JHN 6:12"/>Hhela ijie chuduse <char style="pn">Ersa</char> tujiladene kieliewo, "Feiliesei zaota bu giedene man shidolozhi agi." <verse eid="JHN 6:12"/><verse number="13" style="v" sid="JHN 6:13"/>Ingiese kunla ijiedene feiliesan tawun ginanni zhazhai shidolose 12 gie lanzi zhonlowo. <verse eid="JHN 6:13"/><verse number="14" style="v" sid="JHN 6:14"/><char style="pn">Ersa</char> giesan ghudureqini uzhedene kunla kieliezho, "Eneshi zhen duyade ireku hhe nie xienzhi enbene." <verse eid="JHN 6:14"/><verse number="15" style="v" sid="JHN 6:15"/>Kunla iredene <char style="pn">Ersa</char>i bareizhi biizhi honshan danlaghakui mejiedene <char style="pn">Ersa</char> niezheghanne pse ulade khireiwo.<verse eid="JHN 6:15"/></para>
  <para style="s">Ersa Usu Mienzi Jiere Yozho</para>
  <para style="r">(<ref loc="MAT 14:22-33">Mat 14:22-33</ref>; <ref loc="MRK 6:45-52">Mak 6:45-52</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16"/>Khara oluse tujilani haibienzide bouwo. <verse eid="JHN 6:16"/><verse number="17" style="v" sid="JHN 6:17"/>Chon jiere khireidene hai hhemienni <char style="png">Jiabainun</char>de yozhi qiiwo. Khara oluzhoma, <char style="pn">Ersa</char> hhelai hhende dou ese irezho. <verse eid="JHN 6:17"/><verse number="18" style="v" sid="JHN 6:18"/>Nie fugie kei feiliese hai jiere lan yebeiseye fugiedawo. <verse eid="JHN 6:18"/><verse number="19" style="v" sid="JHN 6:19"/>Tujila chonni huaizhi 10 jili yozho. Ingiekude hhela <char style="pn">Ersa</char> hai jiere yozhi chon shida iresei chujieghedene ayizho. <verse eid="JHN 6:19"/><verse number="20" style="v" sid="JHN 6:20"/>Ingiese <char style="pn">Ersa</char> kieliewo, "Bi wo, bu ayi." <verse eid="JHN 6:20"/><verse number="21" style="v" sid="JHN 6:21"/>Ingiese hhela hende bayasudene <char style="pn">Ersa</char>i jienliezhi chon jiere khise echiku orondene deigo kuruwo.<verse eid="JHN 6:21"/></para>
  <para style="s">Asimanse Iresan Ginan</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22"/>Khuichudu hai duimiende beisan kunla hhende zi niekozi chon bikui mejiene, pse chon uwo. <char style="pn">Ersa</char> tujilarene chon jiere hhantu uye khiseiye mejiene. Tujilani goyane echizho. <verse eid="JHN 6:22"/><verse number="23" style="v" sid="JHN 6:23"/>Pse giedun chon <char style="png">Qibiliya</char>se Ezhan mafan kieliedene kunlade ginan ijieghasan hhe oron shida irewo. <verse eid="JHN 6:23"/><verse number="24" style="v" sid="JHN 6:24"/>Kunla <char style="pn">Ersa</char>, tujilai chanla dase chon souzhi <char style="png">Jiabainun</char>de <char style="pn">Ersa</char>i ereile echiwo.<verse eid="JHN 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25"/>Hhela hai duimiense <char style="pn">Ersa</char>i ereizhi oludene kieliewo, "Loushi, chi yan xienzide enende irewo?" <verse eid="JHN 6:25"/><verse number="26" style="v" sid="JHN 6:26"/><char style="pn">Ersa</char> kieliewo, "Bi tande shuhuajia kielieye, ta mii ereile irese bi xienjighasan ghudureqide ese oluzho, ginanni ijiezhi chudusande oluzho. <verse eid="JHN 6:26"/><verse number="27" style="v" sid="JHN 6:27"/>Ta widaku ijiunide oluzhi wilie bu gie. Chanqiku amin wineku ijiunide oluzhi gie. Enei Kunnikewon tande ogine. Kunnikewonshi Huda Ada renjisan wo." <verse eid="JHN 6:27"/><verse number="28" style="v" sid="JHN 6:28"/>Ingiese hhela asawo, "Bijien yan wilie giese Hudai wilie sanane?" <verse eid="JHN 6:28"/><verse number="29" style="v" sid="JHN 6:29"/><char style="pn">Ersa</char> kieliewo, "Huda peizhi ireghasan hhei xianxin giese, hheshi Hudai wilie wo." <verse eid="JHN 6:29"/><verse number="30" style="v" sid="JHN 6:30"/>Hhela pse kieliewo, "Chi yan ghudureqi xienjighazhi bijienyi xianxin gieghane? Chi yan giene? <verse eid="JHN 6:30"/><verse number="31" style="v" sid="JHN 6:31"/>Jinwun jiere, 'Asiman jierese hhe hhelade ginanyi ogizho.' giezhi huaisan mutun mai xienrenla hontande mana ijiewoma." <verse eid="JHN 6:31"/><verse number="32" style="v" sid="JHN 6:32"/>Ingiese <char style="pn">Ersa</char> kieliewo, "Bi tande shuhuajia kielieye, asiman jierese tande ginanyi ogisanshi <char style="pn">Musa</char> pusho. Asiman jierese tande zhenzhenji ginan ogisanshi Adami wo. <verse eid="JHN 6:32"/><verse number="33" style="v" sid="JHN 6:33"/>Hudai ginanshi asiman jierese bouzhesan hhe nie wo. Hhe duyani kunlade amin ogine."<verse eid="JHN 6:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34"/>Ingiese hhela kieliewo, "Gujiu, chi imutu ginanyi bijiende chanqi ogi." <verse eid="JHN 6:34"/><verse number="35" style="v" sid="JHN 6:35"/><char style="pn">Ersa</char> kieliewo, "Bishi aminni ginan enbene. Mii enende iresan kunla ulie oliesune. Mii xianxin giese ibeizi ulie undasune. <verse eid="JHN 6:35"/><verse number="36" style="v" sid="JHN 6:36"/>Ingieliuzhe, bi kieliezhi daozhoma, ta mii chujiegheseye, xianxin ulie giene. <verse eid="JHN 6:36"/><verse number="37" style="v" sid="JHN 6:37"/>Adami made ogisan kunla mii enende irene. Mii enende iresanlai bi jiedui ulie danlane. <verse eid="JHN 6:37"/><verse number="38" style="v" sid="JHN 6:38"/>Bi asiman jierese bouzhese goya isighalane ulie giene. Mii peizhi ireghasan hhei isighala giene. <verse eid="JHN 6:38"/><verse number="39" style="v" sid="JHN 6:39"/>Mii peizhi ireghasan hhei isishi made ogisan kunlai bi nieda ulie widaghazhi duya barakudeni aminne olughane giezho. <verse eid="JHN 6:39"/><verse number="40" style="v" sid="JHN 6:40"/>Adaimi isishi Kewonyini uzhedene xianxin giesan kunlade man chanqiku aminyi ogine. Duya barakudeni bi hhelai aminne olughane."<verse eid="JHN 6:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41"/>
    <char style="png">Yutai</char> kunla <char style="pn">Ersa</char> orunshi asiman jierese bouzhesan ginan wo giese hhei kieliendu qiiwo. <verse eid="JHN 6:41"/><verse number="42" style="v" sid="JHN 6:42"/>Hhela kieliewo, "Eneshi <char style="pn">Yusufu</char>i kewon <char style="pn">Ersa</char> pushonu? Ana adaini matan tanine. Hhe matugie imutui kielien kieliene? Orunshi asiman jierese bouzhesan wo giezho?" <verse eid="JHN 6:42"/><verse number="43" style="v" sid="JHN 6:43"/><char style="pn">Ersa</char> kieliewo, "Ta qingiezhi bu kieliendu. <verse eid="JHN 6:43"/><verse number="44" style="v" sid="JHN 6:44"/>Mii peizhi ireghasan Adami ulie ireghase mii enende kiemada ire dane. Mii enende iresanlai duya barakudeni bi hhei aminne olughane. <verse eid="JHN 6:44"/><verse number="45" style="v" sid="JHN 6:45"/>Xienzhii shu jiere, 'Hhela man Hudase suruzho.' giezhi huaizho. Adase chenliezhi surusan kunla man mii enende irene. <verse eid="JHN 6:45"/><verse number="46" style="v" sid="JHN 6:46"/>Ene kielienshi kiema Adai chanlazhi daosan hhe isi pusho. Hudai hhense iresan hhense chugo kiemada Adai uzhezhi ese daozho. <verse eid="JHN 6:46"/><verse number="47" style="v" sid="JHN 6:47"/>Bi shuhuajia kielieye, xianxin giesan kunde chanqiku amin wine. <verse eid="JHN 6:47"/><verse number="48" style="v" sid="JHN 6:48"/>Bishi aminni ginan wo. <verse eid="JHN 6:48"/><verse number="49" style="v" sid="JHN 6:49"/>Tai xienren hontande manai ijieliuzhe fuguwo. <verse eid="JHN 6:49"/><verse number="50" style="v" sid="JHN 6:50"/>Eneshi asiman jierese bouzhesan ginan wo. Kun ijiese ulie fugune. <verse eid="JHN 6:50"/><verse number="51" style="v" sid="JHN 6:51"/>Bishi asiman jierese bouzhesan amin ogiku ginan wo. Kun ijiese chanqi amitu wo. Ene ginanshi mii migha wo, duyai kunlai aminde oluzhi ogizho."<verse eid="JHN 6:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52"/>
    <char style="png">Yutai</char> kunla nieniedene jianjinduzho, "Ene kun matugie mighane ogizhi ijieghane?" <verse eid="JHN 6:52"/><verse number="53" style="v" sid="JHN 6:53"/><char style="pn">Ersa</char> kieliewo, "Bi shuhuajia kielieye, ta Kunnikewonyi mighai ulie ijiezhi chusunyi ulie ochise tai sudoro amin uwo. <verse eid="JHN 6:53"/><verse number="54" style="v" sid="JHN 6:54"/>Mii mighai ijiezhi chusunyi ochisan kunde chanqiku amin wine. Duya barakudeni bi hhei aminne olughane. <verse eid="JHN 6:54"/><verse number="55" style="v" sid="JHN 6:55"/>Mighamishi zhenzhenji ijiuni wo, chusunmishi zhenzhenji ochikui wo. <verse eid="JHN 6:55"/><verse number="56" style="v" sid="JHN 6:56"/>Mighaimi ijiezhi chusunyimi ochisan kun mii sudoro beizho. Biye hhei sudoro beizho. <verse eid="JHN 6:56"/><verse number="57" style="v" sid="JHN 6:57"/>Mii peizhi ireghasan ulie fuguku Adai kouizhi bi amituku mutun mighaimi ijiesan kunla mii kouizhi amiturane. <verse eid="JHN 6:57"/><verse number="58" style="v" sid="JHN 6:58"/>Eneshi asiman jierese bouzhesan ginan wo. Enei ijiesan kun chanqi amitu wo. Tai xienrenghala buxian wo, manai ijieliuzhe fuguwo." <verse eid="JHN 6:58"/><verse number="59" style="v" sid="JHN 6:59"/>Enezighan kielienshi <char style="pn">Ersa</char> <char style="png">Jiabainun</char>ni huitande kunlade sughazhi kieliesan wo.<verse eid="JHN 6:59"/></para>
  <para style="s">Amitu Kielien</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60"/>Tujilani hhei kielienyi sonosudene kieliewo, "Ene kielien chijia wo. Kien dunjirene?" <verse eid="JHN 6:60"/><verse number="61" style="v" sid="JHN 6:61"/><char style="pn">Ersa</char> tujilani kieliendusei mejiedene hhelade kieliewo, "Ene kielien tai zhughei gojiolughawu? <verse eid="JHN 6:61"/><verse number="62" style="v" sid="JHN 6:62"/>Qingiese Kunnikewon yenlaiku orondene khikui chanlase ta matugie sumulane? <verse eid="JHN 6:62"/><verse number="63" style="v" sid="JHN 6:63"/>Kunde amin ogikushi Shenlin wo, beye yama oronde uwo. Bi tande kieliesan kielienshi ruhher wo, aminye enbene. <verse eid="JHN 6:63"/><verse number="64" style="v" sid="JHN 6:64"/>Ingieseye tai dunda mii xianxin ese giesan kun wine." <char style="pn">Ersa</char> kaishi giekude kien hhei ghudandukuni mejiene. <verse eid="JHN 6:64"/><verse number="65" style="v" sid="JHN 6:65"/><char style="pn">Ersa</char> pse kieliewo, "Ene yenyin jiere bi tande kieliezhi daozho. Ada ulie ireghase kiemada mii enende ire dane."<verse eid="JHN 6:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66"/>Enense khuinashi <char style="pn">Ersa</char>i daghasan olon kunla yolazhi pse hhei ese daghawo. <verse eid="JHN 6:66"/><verse number="67" style="v" sid="JHN 6:67"/>Ingiese <char style="pn">Ersa</char> 12 gie tujidene kieliewo, "Taye yolanu?" <verse eid="JHN 6:67"/><verse number="68" style="v" sid="JHN 6:68"/><char style="pn">Ximun-Beduru</char> kieliewo, "Ezhan, chade chanqiku amin ogiku kielien wine. Bijien pse kienyi daghane? <verse eid="JHN 6:68"/><verse number="69" style="v" sid="JHN 6:69"/>Bijien chishi Hudase iresan hhe zhiguitu bikui xianxin giezhi mejiezho." <verse eid="JHN 6:69"/><verse number="70" style="v" sid="JHN 6:70"/><char style="pn">Ersa</char> kieliewo, "Bi tai 12 giei sunghuwola? Tai dunda niekozishi Ibilisi wo." <verse eid="JHN 6:70"/><verse number="71" style="v" sid="JHN 6:71"/><char style="pn">Ersa</char>i ene kielienshi <char style="png">Jialie</char> kun <char style="pn">Ximun</char>yi kewon <char style="pn">Yuda</char>i kieliezho. Hheshi 12 gie tuji dundadu nie wo, khuinashi <char style="pn">Ersa</char>i ghudandune.<verse eid="JHN 6:71"/></para>
  <chapter eid="JHN 6"/>
  <chapter number="7" style="c" sid="JHN 7"/>
  <para style="s">Gaijiulani Ersai Xianxin Ese Giezho</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1"/>Enense khuinashi <char style="pn">Ersa</char> <char style="png">Jialili</char>de toreizho. Hhe <char style="png">Yudaya</char>de echiku duran uwo. <char style="png">Yutai</char> kunla hhei alane giezho. <verse eid="JHN 7:1"/><verse number="2" style="v" sid="JHN 7:2"/>Hhe shihoude <char style="png">Yutai</char> kunlani Zhanfan Jie kuzhele qiiwo. <verse eid="JHN 7:2"/><verse number="3" style="v" sid="JHN 7:3"/><char style="pn">Ersa</char>i gaijiula hhende kieliewo, "Chi enense likai giezhi <char style="png">Yudaya</char>de echi. Chi giesan wilielane tujiladene uzhegha. <verse eid="JHN 7:3"/><verse number="4" style="v" sid="JHN 7:4"/>Kun minshende khiku duran bise niuise ulie olune. Chi ene shiqinlai giene giese duyai kunlade man uzhegha." <verse eid="JHN 7:4"/><verse number="5" style="v" sid="JHN 7:5"/>Yenlai gaijiulaniye hhei xianxin ese giezho.<verse eid="JHN 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6"/>Ingiese <char style="pn">Ersa</char> kieliewo, "Ta giezhe echiliuzhe olune, mini shihou da uye kuzhezho. <verse eid="JHN 7:6"/><verse number="7" style="v" sid="JHN 7:7"/>Duyani kunla tai ulie henjine, mii henjine. Duyai kunla giesanlashi doghun wo giezhi bi kieliese mii henjine. <verse eid="JHN 7:7"/><verse number="8" style="v" sid="JHN 7:8"/>Ta jieqi daoghale echi. Bi ede da ulie echine. Mini shihou da uye kuzhezho." <verse eid="JHN 7:8"/><verse number="9" style="v" sid="JHN 7:9"/><char style="pn">Ersa</char> ene kielienyi kieliesenu <char style="png">Jialili</char>de souzho.<verse eid="JHN 7:9"/></para>
  <para style="s">Zhanfan Jiede Sughazho</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10"/>Hhei gaijiulani jieqi daoghale echikude <char style="pn">Ersa</char>ye echiwo. Minminji ese echizho, ghulazhi echizho. <verse eid="JHN 7:10"/><verse number="11" style="v" sid="JHN 7:11"/>Zhen jieqi daoghakudeni <char style="png">Yutai</char> kunla <char style="pn">Ersa</char>i ereizhi asazho, "Hhe khala wine?" <verse eid="JHN 7:11"/><verse number="12" style="v" sid="JHN 7:12"/>Hhe xienzide kunla man <char style="pn">Ersa</char>i kielienduzho. Ezighan kunla kieliese hheshi nie gou kun wo pse ezighan kunla kieliese hheshi nie pienzi wo giezho. <verse eid="JHN 7:12"/><verse number="13" style="v" sid="JHN 7:13"/>Ingieliuzhe <char style="png">Yutai</char> kunse ayizhi <char style="pn">Ersa</char>i minminji kiema kielie dane.<verse eid="JHN 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14"/>Jieqi daoghazhi zhen dundani echikude <char style="pn">Ersa</char> mechide khizhi echidene kunlade sughazhi qiiwo. <verse eid="JHN 7:14"/><verse number="15" style="v" sid="JHN 7:15"/><char style="png">Yutai</char> kunla chenliesenu ghanirazhi kieliewo, "Ene kun olon uye onshizho, matui imeghei mejiene?"<verse eid="JHN 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16"/>Ingiese <char style="pn">Ersa</char> kieliewo. "Bi sughasanshi minughun pusho. Mii peizhi ireghasan hhenughun wo. <verse eid="JHN 7:16"/><verse number="17" style="v" sid="JHN 7:17"/>Hudai isii zunjizhi giesan kunshi bi sughasanshi Hudanughun onu minughun bikuni mejiene. <verse eid="JHN 7:17"/><verse number="18" style="v" sid="JHN 7:18"/>Goya sumulasanne kieliechen kunshi goyane kuaichen kun wo. Peizhi ireghasan hheni kuaichen kunshi olusan kun wo, sudoroni yama gou wini uwo. <verse eid="JHN 7:18"/><verse number="19" style="v" sid="JHN 7:19"/><char style="pn">Musa</char> tande guijinni ogiwola? Kiema uye zunjizho. Ta yangiezhi mii alane giezho?"<verse eid="JHN 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20"/>Kunla kieliewo. "Chii jiere sheitan wine. Chii kien alane giezho?"<verse eid="JHN 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21"/>
    <char style="pn">Ersa</char> kieliewo, "Bi niekozi wilie giese ta man ghanirazho. <verse eid="JHN 7:21"/><verse number="22" style="v" sid="JHN 7:22"/><char style="pn">Musa</char> chonjisan hetoune gieku guijinni ta hhamuraku udude ye giezho. Shijishan eneshi <char style="pn">Musa</char>se kaishi giesan pusho, mai famatu xienrenlase kaishi giesan wo. <verse eid="JHN 7:22"/><verse number="23" style="v" sid="JHN 7:23"/>Ta <char style="pn">Musa</char>i guijinyi ulie fanjine giezhi hhamuraku udude hetoune giene. Bi hhamuraku udude nie kunyi hunshenyi man goudaghase ta yangiezhi made hokune? <verse eid="JHN 7:23"/><verse number="24" style="v" sid="JHN 7:24"/>Ta kunni kieliese mienzini bu uzhe, gundande gie."<verse eid="JHN 7:24"/></para>
  <para style="s">Ersashi Mexiha Onu</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25"/>
    <char style="png">Yelusalen</char>yi niezhan kunla kieliewo, "Eneshi hhela alane giesan kun pushonu? <verse eid="JHN 7:25"/><verse number="26" style="v" sid="JHN 7:26"/>Chi uzhe, hhe mindaminji jianjizho, hhela hhei yama ulie kieliene. Noyenla hheshi Mexiha bikui mejienu? <verse eid="JHN 7:26"/><verse number="27" style="v" sid="JHN 7:27"/>Ene kun khalase iresei matan mejiene. Mexiha irekude hhe khalase irekui kiema ulie mejiene."<verse eid="JHN 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28"/>Ingiekude <char style="pn">Ersa</char> mechide kunlade sughazhi fugiede kieliewo, "Ta mii tanine. Bi khalase ireseiye mejiene. Shijishan bi goyane ese irezho. Mii peizhi ireghasanshi zhoni wo, ta hhei tani dane. <verse eid="JHN 7:28"/><verse number="29" style="v" sid="JHN 7:29"/>Bi hhei tanine. Bishi hhense iresan wo. Hhe mii peizhi ireghazho." <verse eid="JHN 7:29"/><verse number="30" style="v" sid="JHN 7:30"/>Ingiese hhela <char style="pn">Ersa</char>i bareine giezho. Shihouni ese kuse kiema kha tei dazho. <verse eid="JHN 7:30"/><verse number="31" style="v" sid="JHN 7:31"/>Olon kunla hhei xianxin giedene kieliewo, "Mexiha irese ene kunse ghudureqi olon xienjigha shidanu?"<verse eid="JHN 7:31"/></para>
  <para style="s">Ersani Bareine Giezho</para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32"/>Falisai kunla chenliese kunla <char style="pn">Ersa</char>i kielienduzho. Ingiese fugie buwa, Falisai kunla mechini sagheisan kunlai peizhi <char style="pn">Ersa</char>i bareighale echiwo. <verse eid="JHN 7:32"/><verse number="33" style="v" sid="JHN 7:33"/>Ingiese <char style="pn">Ersa</char> kieliewo, "Bi tanrezhe hhantuku udu choghonshiwo. Bi ede mii peizhi ireghasan hhende echine. <verse eid="JHN 7:33"/><verse number="34" style="v" sid="JHN 7:34"/>Ta mii ereise ereizhi olu dane. Bi biku oronde ta ire dane." <verse eid="JHN 7:34"/><verse number="35" style="v" sid="JHN 7:35"/><char style="png">Yutai</char> kunla nieniedene asazhi kieliewo, "Ene kun khala echinu? Matan ereizhi olu dane giene? Hhe niman gojiade sousan maikun dunda echinu, pse <char style="png">Xila</char> kunlade surughale echinu? <verse eid="JHN 7:35"/><verse number="36" style="v" sid="JHN 7:36"/>Ta mii ereise ereizhi olu dane. Bi biku oronde ta ire dane giesan ene kielienshi yan isi wo?"<verse eid="JHN 7:36"/></para>
  <para style="s">Xianxin Giesan Kun Shenlinni Jienliene</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37"/>Jieqini zuihouku udu, zui zhunyoni udude <char style="pn">Ersa</char> beidene fugiede kieliewo, "Kun undasuse mii enende ule ire. <verse eid="JHN 7:37"/><verse number="38" style="v" sid="JHN 7:38"/>Mii xianxin giesan kunde jinwun jiere kieliesan mutun 'Sudoroseni amitu usu moron mutun holune.'" <verse eid="JHN 7:38"/><verse number="39" style="v" sid="JHN 7:39"/><char style="pn">Ersa</char>i ene kielienshi hhei xianxin giesan kunlade Shenlin ireghakui kieliezho. Hhe xienzide <char style="pn">Ersa</char>de kuaikui ese ogizho. Ingiese kunlade Shenlin da ese irezho.<verse eid="JHN 7:39"/></para>
  <para style="s">Ersani Yenyinghala Kunla Ghugha Keizho</para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40"/>Ene kielienyi chenliedene niezhan kunla kieliewo, "Eneshi zhen hhe xienzhi wo." <verse eid="JHN 7:40"/><verse number="41" style="v" sid="JHN 7:41"/>Pse niezhan kunla kieliewo, "Ene kunshi Mexiha wo." Pseshiku kunla kieliewo, "Mexiha matugie <char style="png">Jialili</char>se khizhene? <verse eid="JHN 7:41"/><verse number="42" style="v" sid="JHN 7:42"/>Mexihashi <char style="pn">Dawude</char>i houdeise hhei aghin <char style="png">Bolihen</char>se khizhene giezhi jinwun jiere ese kieliewu?" <verse eid="JHN 7:42"/><verse number="43" style="v" sid="JHN 7:43"/>Ingiese kunla <char style="pn">Ersa</char>i ene shiqinde ghugha keiwo. <verse eid="JHN 7:43"/><verse number="44" style="v" sid="JHN 7:44"/>Hhelai dundadu kunla <char style="pn">Ersa</char>i bareine giezhoma, kiema kha tei dazho.<verse eid="JHN 7:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45"/>Mechini sagheisan kunla khareizhi fugie buwa, Falisai kun shida irewo. Fugie buwa, Falisai kunla hhelade asawo, "Ta yale hhei bareizhi ese irewo?" <verse eid="JHN 7:45"/><verse number="46" style="v" sid="JHN 7:46"/>Mechini sagheisan kunla kieliewo, "Hhe kun mutun kielien kieliesan kun uwo!" <verse eid="JHN 7:46"/><verse number="47" style="v" sid="JHN 7:47"/>Falisai kunla kieliewo, "Taye dan jiere khireiwu? <verse eid="JHN 7:47"/><verse number="48" style="v" sid="JHN 7:48"/>Noyen, Falisai kun dunda hhei xianxin giesan kun nieda uwola? <verse eid="JHN 7:48"/><verse number="49" style="v" sid="JHN 7:49"/>Enezighan <char style="pn">Musa</char>i guijinni yama dunjire dasan kunlade gou widawo." <verse eid="JHN 7:49"/><verse number="50" style="v" sid="JHN 7:50"/>Hhela dundadu nie kunshi <char style="pn">Nigedemu</char> wo. Melieshidase <char style="pn">Ersa</char>i ochirale echizho. Hhelade kieliewo, <verse eid="JHN 7:50"/><verse number="51" style="v" sid="JHN 7:51"/>"Xien hhe goyane kieliesan kielienyi ulie chenliezhi hhe giesanlai chaizhi qinchu ulie olutula mai guijinghala matugie hhende zui jinjine?" <verse eid="JHN 7:51"/><verse number="52" style="v" sid="JHN 7:52"/>Hhela kieliewo, "Chiye <char style="png">Jialili</char> kun onu? Chi echidene nie chaima, <char style="png">Jialili</char>se xienzhi khizhenu ulie khizhene."<verse eid="JHN 7:52"/></para>
  <para style="s">Kunlare Kijiekude Bareisan Bierei</para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 7:53"/>Ingiedene kunla man gieladene khareiwo.<verse eid="JHN 7:53"/></para>
  <chapter eid="JHN 7"/>
  <chapter number="8" style="c" sid="JHN 8"/>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1"/>
    <char style="pn">Ersa</char> <char style="png">Ganlanshan</char>de echiwo. <verse eid="JHN 8:1"/><verse number="2" style="v" sid="JHN 8:2"/>Eqiemagha eqie mechide irewo. Olon kunla hhei shida irese hhe soudene sughazho. <verse eid="JHN 8:2"/><verse number="3" style="v" sid="JHN 8:3"/>Jinwun hanjia, Falisai kunla nie bierei zhen kunlare kijiekude barei ire kunlai dunda beigha <verse eid="JHN 8:3"/><verse number="4" style="v" sid="JHN 8:4"/><char style="pn">Ersa</char>de kieliewo, "Loushi, ene bierei zhen kunlare kijiekude barei irewo. <verse eid="JHN 8:4"/><verse number="5" style="v" sid="JHN 8:5"/><char style="pn">Musa</char>ni guijin jiere imutu biereii tashighala eghi ala giezhi fenfulazho. Chi kieliese matugiene?" <verse eid="JHN 8:5"/><verse number="6" style="v" sid="JHN 8:6"/>Hhela ene kielienyi kieliese <char style="pn">Ersa</char>i shiizho. <char style="pn">Ersa</char>de nie zui jinjidene zhane giezho. <char style="pn">Ersa</char> ghodeidene kha ghurunghalane zemin jiere urou huaizho. <verse eid="JHN 8:6"/><verse number="7" style="v" sid="JHN 8:7"/>Hhela ulie beidene izhi asazho. <char style="pn">Ersa</char> bosizhedene kieliewo, "Tai dunda kiende zui uwoshi xien tashii bareidene eghi." <verse eid="JHN 8:7"/><verse number="8" style="v" sid="JHN 8:8"/>Ingie pse ghodeidene zemin jiere urou huaizho. <verse eid="JHN 8:8"/><verse number="9" style="v" sid="JHN 8:9"/>Hhela ene kielienyi chenliedene xien nasun fugienise nienieji yolawo. Zuihoude <char style="pn">Ersa</char> hhe biereighala feiliewo. <verse eid="JHN 8:9"/><verse number="10" style="v" sid="JHN 8:10"/><char style="pn">Ersa</char> bosizhedene biereide kieliewo, "Funi, hhela khala echiwo? Chade kiema zui ese jinjiwu?" <verse eid="JHN 8:10"/><verse number="11" style="v" sid="JHN 8:11"/>Bierei kieliewo, "Gujiu, uye." <char style="pn">Ersa</char> kieliewo, "Biye chade zui ulie jinjine. Chi echidene pse zui bu fanji."<verse eid="JHN 8:11"/></para>
  <para style="s">Ersashi Duyani Gon Wo</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12"/>
    <char style="pn">Ersa</char> pse kunlade kieliewo, "Bishi duyani gon wo. Mii daghasan kunlade aminni gon wine, kharanide ulie yone."<verse eid="JHN 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13"/>Falisai kunla kieliewo, "Chi goyadene ganzhen beizho, chii ganzhen yama oronde uwo." <verse eid="JHN 8:13"/><verse number="14" style="v" sid="JHN 8:14"/><char style="pn">Ersa</char> kieliewo, "Bi goyane ganzhen beiliuzhe mii ganzhen oronde wine. Bi goyane khalase iresanne mejiene, khala echikuneye mejiene. Bi khalase iresanyi ta ulie mejiene, khala echikuiye ulie mejiene. <verse eid="JHN 8:14"/><verse number="15" style="v" sid="JHN 8:15"/>Ta kunni uzhedanghala panjinema, bi kiemai ulie panjine. <verse eid="JHN 8:15"/><verse number="16" style="v" sid="JHN 8:16"/>Bi kunyi panjiliuzhe mii panjiku oronde wine. Bi niezheghanne pusho. Mii peizhi ireghasan Adaghalane hhantu wo. <verse eid="JHN 8:16"/><verse number="17" style="v" sid="JHN 8:17"/>Tai guijin jiere, 'Ghua kun ganzhen beise zhenni wo.' giezhi huaizho. <verse eid="JHN 8:17"/><verse number="18" style="v" sid="JHN 8:18"/>Bi goyadene ganzhen beizho, pse mii peizhi ireghasan adamiye made ganzhen beizho." <verse eid="JHN 8:18"/><verse number="19" style="v" sid="JHN 8:19"/>Ingiese hhela asazho, "Adachii khala wo?" <char style="pn">Ersa</char> kieliewo, "Ta mii tani dane, adaimiye tani dane. Mii tanise adaimiye tanine." <verse eid="JHN 8:19"/><verse number="20" style="v" sid="JHN 8:20"/>Ene kielienshi <char style="pn">Ersa</char> mechini baer teiku kufan konde kunlade sughazhi kieliesan woma, hhei shihouni uye kuzhese kiemada hhei uye bareizho.<verse eid="JHN 8:20"/></para>
  <para style="s">Mexihai Xianxin Ulie Giese Zui Dunda Fugune</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21"/>
    <char style="pn">Ersa</char> hhelade kieliewo, "Bi echine. Ta mii ereinema, ta zui dunda fugune. Bi echiku oronde ta echi dane." <verse eid="JHN 8:21"/><verse number="22" style="v" sid="JHN 8:22"/>Ingiese <char style="png">Yutai</char> kunla kieliewo, "Hhe kieliese hhe echiku oronde matan echi dane giene. Hhe goyane fugune giezhou?" <verse eid="JHN 8:22"/><verse number="23" style="v" sid="JHN 8:23"/><char style="pn">Ersa</char> hhelade pse kieliewo, "Tashi zemin jierese iresan wo, bishi asiman jierese iresan wo. Tashi duyadedu wo, bishi duyadedu pusho. <verse eid="JHN 8:23"/><verse number="24" style="v" sid="JHN 8:24"/>Ingiese ta zui dundane fugune giezhi bi kieliewo. Ta bishi hhe enbekui xianxin ulie giese zui dundane fugune." <verse eid="JHN 8:24"/><verse number="25" style="v" sid="JHN 8:25"/>Ingiese hhela asazho, "Chishi kien wo?" <char style="pn">Ersa</char> kieliewo, "Bishi dei irekude tande kieliesan hhe nie wo. <verse eid="JHN 8:25"/><verse number="26" style="v" sid="JHN 8:26"/>Bi tande kieliekui olon wo, zui jinjikuiye olon wo. Ingieliuzhe mii peizhi ireghasanshi zhenni wo, ingiese bi hhense chenliesanlai duyai kunlade kieliene." <verse eid="JHN 8:26"/><verse number="27" style="v" sid="JHN 8:27"/><char style="pn">Ersa</char> Adane zhiizhi kieliesei hhela mejie dazho. <verse eid="JHN 8:27"/><verse number="28" style="v" sid="JHN 8:28"/>Ingiese <char style="pn">Ersa</char> kieliewo, "Ta Kunnikewonyi qila qiighakude bishi hhe enbekui mejiene. Bi goya isighalane uye giezho, Adami sughasan mutun kieliesei ta mejiene. <verse eid="JHN 8:28"/><verse number="29" style="v" sid="JHN 8:29"/>Mii peizhi ireghasan hhe mare hhantu wo. Hhe mii niezheghan ese jiezho. Bi chan hhei bayasughakui giezho." <verse eid="JHN 8:29"/><verse number="30" style="v" sid="JHN 8:30"/><char style="pn">Ersa</char> ene kielienyi kieliedene olon kunla hhei xianxin giewo.<verse eid="JHN 8:30"/></para>
  <para style="s">Kun Zhenni Mejiese Ziyushine</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31"/>Ingiese <char style="pn">Ersa</char> hhei xianxin giesan <char style="png">Yutai</char> kunlade kieliewo, "Ta mii kielienyi chan zunjizhi giese mii zhenzhenji tuji wo. <verse eid="JHN 8:31"/><verse number="32" style="v" sid="JHN 8:32"/>Ta zhendaoni mejiene, zhendao tai ziyushighane." <verse eid="JHN 8:32"/><verse number="33" style="v" sid="JHN 8:33"/>Hhela kieliewo, "Bijienshi <char style="pn">Iburaheimu</char>i houdei wo. Bijien kiemade hoji danlazhi ese daozho. Chi matui 'Bijienyi ziyushighane.' giezhi kieliene?" <verse eid="JHN 8:33"/><verse number="34" style="v" sid="JHN 8:34"/><char style="pn">Ersa</char> hhelade kieliewo, "Bi shuhuajia kielieye, zui fanjisan kunshi zuini hoji wo. <verse eid="JHN 8:34"/><verse number="35" style="v" sid="JHN 8:35"/>Hoji chanqi giede sou dane, kewon chanqi giede soune. <verse eid="JHN 8:35"/><verse number="36" style="v" sid="JHN 8:36"/>Ingiese Kewon tai ziyushighase ta zhenzhenji ziyushine. <verse eid="JHN 8:36"/><verse number="37" style="v" sid="JHN 8:37"/>Tashi <char style="pn">Iburaheimu</char>i houdei bikui bi mejiene. Mii kielien tai zhughede oro dase ta mii alane giezho. <verse eid="JHN 8:37"/><verse number="38" style="v" sid="JHN 8:38"/>Bi Adane hhense chujieghesei kieliezho. Ta adane hhense chenliesei giezho."<verse eid="JHN 8:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39"/>Hhela kieliewo, "Bijienyi adashi <char style="pn">Iburaheimu</char> wo."</para>
  <para style="p" vid="JHN 8:39">
    <char style="pn">Ersa</char> kieliewo, "Pusho, ta <char style="pn">Iburaheimu</char>i houdeishi taye <char style="pn">Iburaheimu</char> giesan wilie mutun giene. <verse eid="JHN 8:39"/><verse number="40" style="v" sid="JHN 8:40"/>Bi Hudai hhense chenliesan zhendaoi tande kieliese, ta mii alane giezho. Eneshi <char style="pn">Iburaheimu</char> gieku wilie pusho. <verse eid="JHN 8:40"/><verse number="41" style="v" sid="JHN 8:41"/>Ta giesan wilieshi zhen adatai giesan wilie wo." Ingiese hhela <char style="pn">Ersa</char>de kieliewo, "Bijienshi zagieda pusho. Bijiende niekozi ada wo, hheshi Huda wo." <verse eid="JHN 8:41"/><verse number="42" style="v" sid="JHN 8:42"/><char style="pn">Ersa</char> kieliewo, "Huda tai ada enbese ta made orene. Bishi Hudase tai enende iresan wo. Bi goyane iresan pusho, hhe mii peizhi ireghazho. <verse eid="JHN 8:42"/><verse number="43" style="v" sid="JHN 8:43"/>Bi kieliesanlai ta yangiezhi minbai olu dane? Bi sughakui ta jieshou ulie giene. <verse eid="JHN 8:43"/><verse number="44" style="v" sid="JHN 8:44"/>Tashi tai ada Ibilisise iresan wo. Adatai yan duralase ta yan giene. Hheshi dei qiisanse kun alachen wo. Ibeizi zhennide ulie beine. Zhughedeni zhenni uwo. Hheshi ghudanchi wo, ghudanchini touzi wo. Ingiese hhe ghudan kieliese hhei xinbin wo. <verse eid="JHN 8:44"/><verse number="45" style="v" sid="JHN 8:45"/>Ingiese bi zhendaoni kieliese ta mii xianxin ulie giene. <verse eid="JHN 8:45"/><verse number="46" style="v" sid="JHN 8:46"/>Tai dunda kien made zui jinjine? Bi tande zhendaoni kieliese, ta yale mii xianxin ulie giene? <verse eid="JHN 8:46"/><verse number="47" style="v" sid="JHN 8:47"/>Hudase khizhesan kunla Hudai kielienyi chenliene. Ta ulie chenliese Hudase khizhesei pusho."<verse eid="JHN 8:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48"/>
    <char style="png">Yutai</char> kunla kieliewo, "Bijien kieliese chishi <char style="png">Samaliya</char> kun wo, chii jiere sheitan wo giesan ene kielien ese oluzhou?" <verse eid="JHN 8:48"/><verse number="49" style="v" sid="JHN 8:49"/><char style="pn">Ersa</char> kieliewo, "Mii jiere sheitan uwo. Bi adane zunzhun giezho, ta mii zunzhun uye giezho. <verse eid="JHN 8:49"/><verse number="50" style="v" sid="JHN 8:50"/>Bi goyane kuaikui ulie sumulanema, da niezhan mii kuaine. Hheshijiu panjichen wo. <verse eid="JHN 8:50"/><verse number="51" style="v" sid="JHN 8:51"/>Bi shuhuajia kielieye, kien mii kielienyi chenliese hhe chanqi ulie fugune." <verse eid="JHN 8:51"/><verse number="52" style="v" sid="JHN 8:52"/>Ingiese <char style="png">Yutai</char> kunla kieliewo, "Ede bijien zhenzhen mejiewo! Chii jiere sheitan wine. <char style="pn">Iburaheimu</char> duya ijiewo, xienzhilaye duya ijiewo. Chi kieliese chii kielienyi chenliese chanqi ulie fugune giezho. <verse eid="JHN 8:52"/><verse number="53" style="v" sid="JHN 8:53"/>Qinse chi bijienyi xienren <char style="pn">Iburaheimu</char>se pse fugie onu? Hhe duya ijiewo, xienzhilaye duya ijiewo. Chi goyane yan kun wo giezho?" <verse eid="JHN 8:53"/><verse number="54" style="v" sid="JHN 8:54"/><char style="pn">Ersa</char> kieliewo, "Bi goyane kuaise hhe yama zoin uwo. Mii kuaisanshi Adami wo. Hheshijiu ta kieliesan mai huda wo giesan hhe wo. <verse eid="JHN 8:54"/><verse number="55" style="v" sid="JHN 8:55"/>Ta hhei tani dane, bi hhei tanine. Bi hhei tani dane giezhi kieliese ta mutun ghudanchi gholune. Ingiese bi hhei tanine, kielienyini ye chenliene. <verse eid="JHN 8:55"/><verse number="56" style="v" sid="JHN 8:56"/>Tai xienren <char style="pn">Iburaheimu</char> mii udui uzhene giezhi bayasuzhi sagheizho. Udui chanladene hende bayasuzho." <verse eid="JHN 8:56"/><verse number="57" style="v" sid="JHN 8:57"/><char style="png">Yutai</char> kunla kieliewo, "Chii nasun 50 da ulie olune, matugie <char style="pn">Iburaheimu</char>i uzhezhi daowo giezhi kieliene?" <verse eid="JHN 8:57"/><verse number="58" style="v" sid="JHN 8:58"/><char style="pn">Ersa</char> kieliewo, "Bi tande shuhuajia kielieye, <char style="pn">Iburaheimu</char>i ese olukudeni bi wine." <verse eid="JHN 8:58"/><verse number="59" style="v" sid="JHN 8:59"/>Ingiese hhela tashii bareisenu <char style="pn">Ersa</char>i eghine giezho. <char style="pn">Ersa</char> piidene mechise khizhi echiwo.<verse eid="JHN 8:59"/></para>
  <chapter eid="JHN 8"/>
  <chapter number="9" style="c" sid="JHN 9"/>
  <para style="s">Sughoni Goudaghazho</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1"/>
    <char style="pn">Ersa</char> mo yozhi daokudeni olusanse nie sughoi chanlawo. <verse eid="JHN 9:1"/><verse number="2" style="v" sid="JHN 9:2"/>Tujilani <char style="pn">Ersa</char>de asazho, "Loushi, ene kun goya zui fanjizhi sugho gholuwu, ada anani zui fanjizhi sugho gholuwo?" <verse eid="JHN 9:2"/><verse number="3" style="v" sid="JHN 9:3"/><char style="pn">Ersa</char> kieliewo, "Hhe zui fanjizhi gholusan pusho, ada anani zui fanjizhi gholusanye pusho. Eneshi hhei jierese Huda nenline kunlade mejieghane giezho. <verse eid="JHN 9:3"/><verse number="4" style="v" sid="JHN 9:4"/>Udu bikude matan mii peizhi ireghasan hhei wiliei giekuni wo. Khara oluse kiemada wilie gie dane. <verse eid="JHN 9:4"/><verse number="5" style="v" sid="JHN 9:5"/>Bi duyade bikude bishi duyani gon wo." <verse eid="JHN 9:5"/><verse number="6" style="v" sid="JHN 9:6"/><char style="pn">Ersa</char> ene kielienyi kieliesenu zemin jiere nunpuwo. Nunpusunghala shuwa zhuwadene sughoni nudun jiere moiwo. <verse eid="JHN 9:6"/><verse number="7" style="v" sid="JHN 9:7"/>Ingie hhende kieliewo, "Chi <char style="png">Xiloya louba</char>de echidene nie wagha." <char style="png">Xiloya</char>ni isishi peizhi ireghasan wo. Hhe echi nie wagha kharei irese chujieghewo. <verse eid="JHN 9:7"/><verse number="8" style="v" sid="JHN 9:8"/>Hhei giebeilane, hhe ghuisei chujieghesan kunla kieliewo, "Eneshi melieshida soudene ghuisan hhe kun pushonu?" <verse eid="JHN 9:8"/><verse number="9" style="v" sid="JHN 9:9"/>Ezighan kunla hhe enbene giezho. Psezighan kunla pusho, hhei xianli giezho. Hhe goyane bi enbene giezho.<verse eid="JHN 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10"/>Hhela asazho, "Chii nudun matui goudawo?" <verse eid="JHN 9:10"/><verse number="11" style="v" sid="JHN 9:11"/>Hhe kieliewo, "<char style="pn">Ersa</char> giechen nie kun shuwa giedene mii nudun jiere moi made kieliewo, 'Chi <char style="png">Xiloya louba</char>de echi nie wagha.' Bi echi nie waghase chujieghewo." <verse eid="JHN 9:11"/><verse number="12" style="v" sid="JHN 9:12"/>Hhela asawo, "Hhe kun khala wine?" Hhe kieliewo, "Bi ulie mejiene."<verse eid="JHN 9:12"/></para>
  <para style="s">Falisai Kun Goudasan Sughoi Chaizho</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13"/>Kunla melieshidaku sughoni udurusenu Falisai kunlai hhende echiwo. <verse eid="JHN 9:13"/><verse number="14" style="v" sid="JHN 9:14"/><char style="pn">Ersa</char> shuwa zhuwazhi nudunyi goudaghasan hhe niudushi hhamuraku udu wo. <verse eid="JHN 9:14"/><verse number="15" style="v" sid="JHN 9:15"/>Ingiese Falisai kunla hhe kunde asazho, "Chii nudun matui goudawo?" Hhe kieliewo, "Hhe shuwani mii nudun jiere moiwo. Bi nie waghase chujieghewo." <verse eid="JHN 9:15"/><verse number="16" style="v" sid="JHN 9:16"/>Falisai kun dunda niezhan kunla kieliewo, "Hheshi Hudase iresan kun pusho. Hhe hhamuraku uduiye uye zunjizho." Da niezhan kunla kieliewo, "Nie zui winetu kun imutu ghudureqi gie shidanu?" Ingie kunla ghugha keiwo. <verse eid="JHN 9:16"/><verse number="17" style="v" sid="JHN 9:17"/>Ingiese hhela pse sughode kieliewo, "Hhe chii nudunyi goudaghazho. Chi nie kielie, hheshi nie matunie kun wo?" Hhe kieliewo, "Hheshi nie xienzhi wo."<verse eid="JHN 9:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18"/>Ingiese <char style="png">Yutai</char> kunla hheshi melieshida sugho wo, ede goudasei xianxin ese giedene nudun goudasan kunyi ada anaini uruzhi ire asazho, <verse eid="JHN 9:18"/><verse number="19" style="v" sid="JHN 9:19"/>"Eneshi olusanse sugho wo giesan tai kewon enbenu pusho? Ede matui chujieghewo?" <verse eid="JHN 9:19"/><verse number="20" style="v" sid="JHN 9:20"/>Ada anani kieliewo, "Eneshi bijienyi kewon enbene. Hhe olusanse sugho bikui bijien mejiene. <verse eid="JHN 9:20"/><verse number="21" style="v" sid="JHN 9:21"/>Ede matui chujieghewoshi bijien ulie mejiene. Nudunyini kien goudaghawoshi bijienye ulie mejiene. Ta hhende asa, hhe ede fugiedazho. Goyane kielie shidane." <verse eid="JHN 9:21"/><verse number="22" style="v" sid="JHN 9:22"/>Ada anani ingiezhi kieliekushi <char style="png">Yutai</char> kunlase ayizho. <char style="png">Yutai</char> kunla jiejin giezhi kien <char style="pn">Ersa</char>shi Mexiha wo giezhi renjise huitanse tou khighane giezho. <verse eid="JHN 9:22"/><verse number="23" style="v" sid="JHN 9:23"/>Ingiese ada anani ta hhende asa, "Hhe ede fugiedazho." giezhi kieliewo.<verse eid="JHN 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24"/>Ingiese hhela hhe sughoi erchan uruzhi iredene asazho, "Chi indan Hudai kuaikui wo. Ene kunshi zuiren bikui bijien mejiene." <verse eid="JHN 9:24"/><verse number="25" style="v" sid="JHN 9:25"/>Ingiese hhe kun kieliewo, "Hhende zui winu uwokui bi ulie mejienema, melieshi bi sugho wo, ede chujieghekune mejiene."<verse eid="JHN 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26"/>Ingiese hhela asazho, "Hhe chade yan giewo? Hhe chii nudunyi matugie goudaghawo?"<verse eid="JHN 9:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27"/>Hhe kieliewo, "Bi munigie tande kieliewo, ta ulie chenliene. Ta yangiezhi pse chenliene giezho? Taye hhei tuji danlane giezhou?"<verse eid="JHN 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28"/>Hhela sugiezhi kieliewo, "Chishi hhei tuji wo, bijienshi <char style="pn">Musa</char>i tuji wo. <verse eid="JHN 9:28"/><verse number="29" style="v" sid="JHN 9:29"/>Huda <char style="pn">Musa</char>de kieliesanyi bijien mejiene. Hhe kun khalase iresanyi bijien ulie mejiene."<verse eid="JHN 9:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30"/>Hhe kun kieliewo, "Hhe mii nudunyi goudaghawo. Hhe khalase iresanyi ta ulie mejienu? Ta zhenzhen hunnerei wo. <verse eid="JHN 9:30"/><verse number="31" style="v" sid="JHN 9:31"/>Huda zuirenni kielienyi ulie chenliene. Zinie hhei zunjizhi kielienyini chenliesan kunnughunyi chenliene. Enei matan man mejiene. <verse eid="JHN 9:31"/><verse number="32" style="v" sid="JHN 9:32"/>Duyai zhayaghasanse sughoi nudunyi goudaghasei chenliezhi uye daozho. <verse eid="JHN 9:32"/><verse number="33" style="v" sid="JHN 9:33"/>Hhe kun Hudai hhense uye irezhoshi imutu wilie gie dane." <verse eid="JHN 9:33"/><verse number="34" style="v" sid="JHN 9:34"/>Hhela kieliewo, "Chii olusanse qienbu zui dunda wo, chi da bijiende sughanu!" Ingiedene hhei tou khighawo.<verse eid="JHN 9:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35"/>
    <char style="pn">Ersa</char> hhe kunyi tou khighasanyi chenliedene hhei ereizhi oluwo. <char style="pn">Ersa</char> hhende kieliewo, "Chi Kunnikewonni xianxin giezhou?" <verse eid="JHN 9:35"/><verse number="36" style="v" sid="JHN 9:36"/>Hhe kun kieliewo, "Gujiu, hheshi kien wine? Bi xianxin gieye." <verse eid="JHN 9:36"/><verse number="37" style="v" sid="JHN 9:37"/><char style="pn">Ersa</char> kieliewo, "Chi hhei chujieghezho. Chare kielien kieliesanshi enbene." <verse eid="JHN 9:37"/><verse number="38" style="v" sid="JHN 9:38"/>Hhe kieliewo, "Gujiu, bi xianxin giene!" Ingiesenu <char style="pn">Ersa</char>de xiutuliewo.<verse eid="JHN 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39"/>
    <char style="pn">Ersa</char> kieliewo, "Bi duyade panjile irewo. Chujieghe dachen kunlai chujiegheghane, chujieghechen kunlai sugho gholughane."<verse eid="JHN 9:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40"/>Hhei shida ene kielienyi chenliesan ezighan Falisai kunla kieliewo, "Qinse bijienye sugho onu?" <verse eid="JHN 9:40"/><verse number="41" style="v" sid="JHN 9:41"/><char style="pn">Ersa</char> hhelade kieliewo, "Tashi sughoshi tande zui uwo. Ta, 'Chujieghe shidane.' giezhi kieliese tande zui wine."<verse eid="JHN 9:41"/></para>
  <chapter eid="JHN 9"/>
  <chapter number="10" style="c" sid="JHN 10"/>
  <para style="s">Gou Ghoni Adulachen</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1"/>"Bi tande shuhuajia kielieye, kien ghoni khudonde orokude wijiense ulie orozhi pse khalamase orose hheshi ghughei, qiandao wo. <verse eid="JHN 10:1"/><verse number="2" style="v" sid="JHN 10:2"/>Wijiense orosan kunshi zhen ghoni adulachen kun wo. <verse eid="JHN 10:2"/><verse number="3" style="v" sid="JHN 10:3"/>Ghoni adulachen kun irese wijienyi sagheisan kun wijienyi niene, ghonilaye hhei shenqii tanine. Hhe ghonine nierese uruzhi khizheghane. <verse eid="JHN 10:3"/><verse number="4" style="v" sid="JHN 10:4"/>Man uruzhi khizhesenu goyane melie yone. Ghonila hhei shenqii tanise hhei daghane. <verse eid="JHN 10:4"/><verse number="5" style="v" sid="JHN 10:5"/>Ghonila tani daku kunyi ulie daghane. Hhei shenqii ulie mejiese holu widane." <verse eid="JHN 10:5"/><verse number="6" style="v" sid="JHN 10:6"/><char style="pn">Ersa</char> enezighan kielienyi hhelade bilazhi kieliezho. Hhela yan isi bikui dunjire dane.<verse eid="JHN 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7"/>Ingiese <char style="pn">Ersa</char> hhelade pse kieliewo, "Bi tande shuhuajia kielieye, bishi ghoni yoku wijien enbene. <verse eid="JHN 10:7"/><verse number="8" style="v" sid="JHN 10:8"/>Mase melie iresanshi man ghughei, qiandao wo. Ghonila hhelai ese chenliewo. <verse eid="JHN 10:8"/><verse number="9" style="v" sid="JHN 10:9"/>Bishi wijien wo. Mase tungo giezhi orosanlai jiui shidane, orozhi ire khizhi echise osun ijie shidane. <verse eid="JHN 10:9"/><verse number="10" style="v" sid="JHN 10:10"/>Ghughei irese ghulane, alane, qida olughane. Bi irese ghonilade amin ogine, da fugiede ogine. <verse eid="JHN 10:10"/><verse number="11" style="v" sid="JHN 10:11"/>Bishi nie gou ghoni adulachen kun wo. Gou ghoni adulachen kun ghonide oluzhi aminne sheine. <verse eid="JHN 10:11"/><verse number="12" style="v" sid="JHN 10:12"/>Guisan kunshi zhenzhenji ghoni adulachen pusho. Ghonishi hhenughun pusho. Zhanghei irekui chanlase ghonilai benda jie holu widane. Zhanghei ghonise nie bareise ghonila man sanda widane. <verse eid="JHN 10:12"/><verse number="13" style="v" sid="JHN 10:13"/>Guisan kun ghonilade zhughe ulie chilane. Ingiese holu widane. <verse eid="JHN 10:13"/><verse number="14" style="v" sid="JHN 10:14"/>Bishi gou ghoni adulachen wo. Bi ghonine tanine, mii ghonilaye mii tanine. <verse eid="JHN 10:14"/><verse number="15" style="v" sid="JHN 10:15"/>Eneshi Adami mini taniku, bi Adane tanikughala niekielien wo. Bi ghonidene oluzhi aminne sheine. <verse eid="JHN 10:15"/><verse number="16" style="v" sid="JHN 10:16"/>Made ene khudonde wiku ghoni da wine. Hhelaiye bi uduruzhi irene. Hhela mii shenqii sonosudene man hhantulazhi nie adulachen kun gonjine."<verse eid="JHN 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 10:17"/>"Bi aminne widaghadene pse agizhi irene. Ingiese Adami made orezho. <verse eid="JHN 10:17"/><verse number="18" style="v" sid="JHN 10:18"/>Mii aminyi kiema agizhi echi dane. Bi goyane ogisan wo. Bi aminne bendaku qienli wine. Pse agizhi ireku qienliye wine. Eneshi Adami made ogisan minlin wo."<verse eid="JHN 10:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19"/>
    <char style="png">Yutai</char> kunla ene kieliende pse ghugha keiwo. <verse eid="JHN 10:19"/><verse number="20" style="v" sid="JHN 10:20"/>Olon kunla kieliezho, "Hhei jiere sheitan khizho, hhe fenjiulizho. Ta dou kielienyini chenliezhou?" <verse eid="JHN 10:20"/><verse number="21" style="v" sid="JHN 10:21"/>Pse iban kunla kieliewo, "Hhei jiere sheitan khise imutu kielien kielie dane. Sheitan sughoi goudagha shidanu?"<verse eid="JHN 10:21"/></para>
  <para style="s">Yutai Kunla Ersai Fandui Giezho</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22"/>
    <char style="png">Yelusalen</char>de mechii giesan jieqi kuzhewo. Eneshi unchade wo. <verse eid="JHN 10:22"/><verse number="23" style="v" sid="JHN 10:23"/><char style="pn">Ersa</char> mechini <char style="pn">Sulumane</char> doudoughun yozho. <verse eid="JHN 10:23"/><verse number="24" style="v" sid="JHN 10:24"/><char style="png">Yutai</char> kunla hhei wiqidene kieliewo, "Chi bijienyi giedoghoncha inxin gieghane? Chi Mexiha enbese mindamin kielie." <verse eid="JHN 10:24"/><verse number="25" style="v" sid="JHN 10:25"/><char style="pn">Ersa</char> kieliewo, "Bi tande ijin kieliewoma, ta mii xianxin ulie giene. Bi adane niereghala giesan shiqinla made ganzhen beine. <verse eid="JHN 10:25"/><verse number="26" style="v" sid="JHN 10:26"/>Ta mii ghoni pusho, ingiese mii xianxin ulie giene. <verse eid="JHN 10:26"/><verse number="27" style="v" sid="JHN 10:27"/>Mii ghoni mii shenqii chenliene, bi hhelai tanine, hhela mii daghane. <verse eid="JHN 10:27"/><verse number="28" style="v" sid="JHN 10:28"/>Bi hhelade chanqiku amin ogine. Hhela ibeizi ulie widane, kiemada mii khase agizhi echi dane. <verse eid="JHN 10:28"/><verse number="29" style="v" sid="JHN 10:29"/>Hhelai made ogisan Adami yanseliuzhe fugie wo. Adaimi khase hhelai kiemada qianlazhi echi dane. <verse eid="JHN 10:29"/><verse number="30" style="v" sid="JHN 10:30"/>Bi Adaghalaneshi nie wo."<verse eid="JHN 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31"/>
    <char style="png">Yutai</char> kunla pse tashii bareidene <char style="pn">Ersa</char>i eghine giezho. <verse eid="JHN 10:31"/><verse number="32" style="v" sid="JHN 10:32"/><char style="pn">Ersa</char> hhelade kieliewo, "Bi Adane hhendedu gou wiliei giezhi tande uzheghazho. Ta alinie shiqinde mii eghine giezho?"<verse eid="JHN 10:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33"/>
    <char style="png">Yutai</char> kunla kieliewo, "Gouni giewo giezhi eghine giesan pusho. Chi kufurei fanjizho. Chishi nie kun wo, goyane Huda giezhi kieliene."<verse eid="JHN 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34"/>
    <char style="pn">Ersa</char> kieliewo, "Tai guijinshu jiere tashi huda wo giezhi bi kieliewo giezhi ese huaizhou? <verse eid="JHN 10:34"/><verse number="35" style="v" sid="JHN 10:35"/>Jinwun jieredu kielien nieda ulie widane. Hudai kielienyi jienliesan kunlade huda giezhi kieliewoma, <verse eid="JHN 10:35"/><verse number="36" style="v" sid="JHN 10:36"/>Adami mii zhiguishighadene duyade peizhi ireghase bi kieliezhi 'Bishi Hudai Kewon wo.' giese ta mii kufurei fanjiwo giezhi kielienu? <verse eid="JHN 10:36"/><verse number="37" style="v" sid="JHN 10:37"/>Bi Adane wiliei ulie giese ta mii xianxin bu gie. <verse eid="JHN 10:37"/><verse number="38" style="v" sid="JHN 10:38"/>Bi giese ta mii xianxin ulie gieliuzhe bi giesan shiqinlai xianxin gie. Ingiese Adami mii sudoro wo, bi Adane sudoro bikui ta qinchude mejiene." <verse eid="JHN 10:38"/><verse number="39" style="v" sid="JHN 10:39"/>Ingiese hhela <char style="pn">Ersa</char>i pse bareine giese <char style="pn">Ersa</char> hhelai khase anda yolasenu <verse eid="JHN 10:39"/><verse number="40" style="v" sid="JHN 10:40"/><char style="png">Yedanhe</char>ni pse daozhi <char style="pn">Yaheiya</char> melieshida kunlade xili gieghasan hhe oronde echizhi souwo. <verse eid="JHN 10:40"/><verse number="41" style="v" sid="JHN 10:41"/>Olon kunla hhei shida iredene kieliewo, "<char style="pn">Yaheiya</char> yama ghudureqi uye giezhoma, hhe ene kunyi zhiizhi kieliesanshi man zhenni wo." <verse eid="JHN 10:41"/><verse number="42" style="v" sid="JHN 10:42"/>Ingiedene hhende olon kunla <char style="pn">Ersa</char>i xianxin giewo.<verse eid="JHN 10:42"/></para>
  <chapter eid="JHN 10"/>
  <chapter number="11" style="c" sid="JHN 11"/>
  <para style="s">Lasaluni Fugusan</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1"/>Nie giemeresan kunyi nierei <char style="pn">Lasalu</char> giene. <char style="pn">Mereiyen</char>, <char style="pn">Mada</char> ghua eghechijiularene <char style="png">Bodani</char> aghinde souzho. <verse eid="JHN 11:1"/><verse number="2" style="v" sid="JHN 11:2"/>Ene <char style="pn">Mereiyen</char>shi Ezhanni jiere xianshui kiedene usunghalane konyini saisan hhe wo. Giemeresan <char style="pn">Lasalu</char>shi hhei jiu wo. <verse eid="JHN 11:2"/><verse number="3" style="v" sid="JHN 11:3"/>Ghua eghechijiuni kun peizhi <char style="pn">Ersa</char>de kielieghale echiwo, "Ezhan, chi oresan kun giemerezho."<verse eid="JHN 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4"/>
    <char style="pn">Ersa</char> chenliedene kieliewo, "Eneshi fuguku gien pusho. Hudai kuaiku shiqin wo. Ingiedene eneghala Hudai Kewonni kuaine." <verse eid="JHN 11:4"/><verse number="5" style="v" sid="JHN 11:5"/>Ingiese <char style="pn">Ersa</char> <char style="pn">Mada</char>, hhei eghechijiu, pse <char style="pn">Lasalu</char>de orezhoma, <verse eid="JHN 11:5"/><verse number="6" style="v" sid="JHN 11:6"/><char style="pn">Lasalu</char> giemeresanyi sonosudene sousan orondene pse ghuarudu souwo. <verse eid="JHN 11:6"/><verse number="7" style="v" sid="JHN 11:7"/>Ingie tujiladene kieliewo, "Matan pse <char style="png">Yudaya</char>de khareiye." <verse eid="JHN 11:7"/><verse number="8" style="v" sid="JHN 11:8"/>Tujilani kieliewo, "Loushi, ene ghuarudu <char style="png">Yutai</char> kunla chii tashighala eghine giezho. Chi da hhende echinu?" <verse eid="JHN 11:8"/><verse number="9" style="v" sid="JHN 11:9"/><char style="pn">Ersa</char> kieliewo, "Udu 12 gie xioshi pushonu? Kun ene duyani gonni chanlase udu mo yose ulie banjine. <verse eid="JHN 11:9"/><verse number="10" style="v" sid="JHN 11:10"/>Xieni yose hhe kunde gon uwoshi banjine." <verse eid="JHN 11:10"/><verse number="11" style="v" sid="JHN 11:11"/><char style="pn">Ersa</char> ene kielienyi kieliedene pse kieliewo, "Mai zhanlien <char style="pn">Lasalu</char> hhunturazho. Bi echidene uruzhi xiereighane."<verse eid="JHN 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12"/>Ingiese tujilani kieliewo, "Ezhan, hhe hhunturazhoshi goudane." <verse eid="JHN 11:12"/><verse number="13" style="v" sid="JHN 11:13"/><char style="pn">Ersa</char>i ene kielienshi hhe fugusei kieliezho. Hhela sumulase <char style="pn">Ersa</char>i ene kielienshi hhe kijie hhunturazho giezho.<verse eid="JHN 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 11:14"/>
    <char style="pn">Ersa</char> hhelade minminji kieliewo, "<char style="pn">Lasalu</char> duya ijiezho. <verse eid="JHN 11:14"/><verse number="15" style="v" sid="JHN 11:15"/>Bi hhende wise bi tande oluzhi bayasuzho. Ene jihui jiere ta mini xianxin giene. Ede matan hhende yoye."<verse eid="JHN 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16"/>Shongo giezhi urusan <char style="pn">Doma</char> psedu tujilade kieliewo, "Matanye yo, <char style="pn">Ersa</char>re hhantu duya ijieye."<verse eid="JHN 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17"/>
    <char style="pn">Ersa</char> kuzhedene <char style="pn">Lasalu</char>i mezade teizhi ijin jierudu olusanyi mejiewo. <verse eid="JHN 11:17"/><verse number="18" style="v" sid="JHN 11:18"/><char style="png">Bodani</char> <char style="png">Yelusalen</char>se gholo uwo, chabudu 6 li mo wo. <verse eid="JHN 11:18"/><verse number="19" style="v" sid="JHN 11:19"/>Olon <char style="png">Yutai</char> kunla <char style="pn">Mada</char>, <char style="pn">Mereiyen</char>yi uzhele irewo. Jiunini shiqinde sidaghazhi kieliele irewo. <verse eid="JHN 11:19"/><verse number="20" style="v" sid="JHN 11:20"/><char style="pn">Mada</char> <char style="pn">Ersa</char> iresei mejiedene jienliele echiwo. <char style="pn">Mereiyen</char> yen giedene souzho. <verse eid="JHN 11:20"/><verse number="21" style="v" sid="JHN 11:21"/><char style="pn">Mada</char> <char style="pn">Ersa</char>de kieliewo, "Ezhan, chi enende wineshi jiumi ulie duya ijienema, <verse eid="JHN 11:21"/><verse number="22" style="v" sid="JHN 11:22"/>edeliuzhe chi Hudase yan kerese Huda chade ogikui bi mejiene."<verse eid="JHN 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23"/>
    <char style="pn">Ersa</char> kieliewo, "Jiuchii aminne olune."<verse eid="JHN 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24"/>
    <char style="pn">Mada</char> kieliewo, "Duya barazhi kunla fuho giekude hheye aminne olukui bi mejiene."<verse eid="JHN 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25"/>
    <char style="pn">Ersa</char> kieliewo, "Bishi fuho wo, amin wo. Mini xianxin giesan kun fuguliuzhe aminne olune. <verse eid="JHN 11:25"/><verse number="26" style="v" sid="JHN 11:26"/>Kun amitu bikude mii xianxin giese chanqi ulie fugune. Chi eneni xianxin gienu?"<verse eid="JHN 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27"/>
    <char style="pn">Mada</char> kieliewo, "Ezhan, oluzho. Chishi Mexiha wo, duyade irene giesan Hudai Kewon enbekui bi xianxin giene." <verse eid="JHN 11:27"/><verse number="28" style="v" sid="JHN 11:28"/><char style="pn">Mada</char> ene kielienyi kieliedene khareizhi echi eghechijiu <char style="pn">Mereiyen</char>de konkonji kieliewo, "Loushi irewo. Chii uruzho." <verse eid="JHN 11:28"/><verse number="29" style="v" sid="JHN 11:29"/><char style="pn">Mereiyen</char> chenliedene jindazhi bosizhe <char style="pn">Ersa</char>i hhende echiwo.<verse eid="JHN 11:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 11:30"/>
    <char style="pn">Ersa</char> aghinde orozhi ese echidene <char style="pn">Mada</char> hhei jienliesan hhe oronde wo. <verse eid="JHN 11:30"/><verse number="31" style="v" sid="JHN 11:31"/>Hhezighan <char style="pn">Mereiyen</char>yi giede sidaghazhi kieliesan <char style="png">Yutai</char> kunla <char style="pn">Mereiyen</char> bosizhedene jindazhi ghadane echisei chanlasenu daghazhi echiwo. Hhela sumulase <char style="pn">Mereiyen</char> mezade wilale echine giezho. <verse eid="JHN 11:31"/><verse number="32" style="v" sid="JHN 11:32"/><char style="pn">Mereiyen</char> <char style="pn">Ersa</char>i hhende kuzhi ire hhei chanladene kon shidai papala kieliewo, "Ezhan, chi enende wineshi jiumi ulie duya ijiene."<verse eid="JHN 11:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33"/>
    <char style="pn">Ersa</char> hhe wilasei, pse hhei daghazhi iresan <char style="png">Yutai</char> kunla wilasei chanladene zhughedene zhoqi giezhi nango giezho. <verse eid="JHN 11:33"/><verse number="34" style="v" sid="JHN 11:34"/>Hhe asawo, "Ta hhei khala teiwo?" Hhela kieliewo, "Ezhan, uzhele ire." <verse eid="JHN 11:34"/><verse number="35" style="v" sid="JHN 11:35"/><char style="pn">Ersa</char> wilawo. <verse eid="JHN 11:35"/><verse number="36" style="v" sid="JHN 11:36"/>Ingiese <char style="png">Yutai</char> kunla kieliewo, "Ta uzhe, ene kun <char style="pn">Lasalu</char>de matugiezhi orezho." <verse eid="JHN 11:36"/><verse number="37" style="v" sid="JHN 11:37"/>Niezhan kunla kieliewo, "Hhe sughoni nudunyi goudaghawoma, ene kunyi matugie ese goudaghazhi fugughawo?"<verse eid="JHN 11:37"/></para>
  <para style="s">Lasaluni Aminne Olughazho</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38"/>
    <char style="pn">Ersa</char> pse sudorone zhoqi giezhi meza konde irewo. Hhe mezashi nie alima wo. Niekozi tashighala kouzii duighazho. <verse eid="JHN 11:38"/><verse number="39" style="v" sid="JHN 11:39"/><char style="pn">Ersa</char> kieliewo, "Tashii daogha." Ingiese duya ijiesan kunyi ajieni <char style="pn">Mada</char> hhende kieliewo, "Ezhan, hhe duya ijiezhi jierudu olune. Ede fumugheishizho."<verse eid="JHN 11:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40"/>
    <char style="pn">Ersa</char> kieliewo, "Chi xianxin giese Hudai famai chanlakuni bi chade kieliezhi ese daowu?" <verse eid="JHN 11:40"/><verse number="41" style="v" sid="JHN 11:41"/>Ingiese hhela tashii daoghawo. <char style="pn">Ersa</char> qiorunne qila asimanni uzhedene kieliewo, "Ada, chii mafan gieghawo. Chi minughunyi chenliewo. <verse eid="JHN 11:41"/><verse number="42" style="v" sid="JHN 11:42"/>Chi chan minughunyi chenliekui bi mejiene. Bi ene kielienyi kieliese zhouwini beisan kunlade oluzho. Chi mii peizhi ireghasanyi hhelade xianxin gieghane giezho." <verse eid="JHN 11:42"/><verse number="43" style="v" sid="JHN 11:43"/>Ene kielienyi kieliedene fugiede waradawo, "<char style="pn">Lasalu</char>, khizhe!" <verse eid="JHN 11:43"/><verse number="44" style="v" sid="JHN 11:44"/>Ingiese fugusan kun khizhewo. Khakonyini bosighala horozho, ungienyini ye shoujinghala bouizho. <char style="pn">Ersa</char> hhelade kieliewo, "Hhei andaghadene yogha."<verse eid="JHN 11:44"/></para>
  <para style="s">Ersani Alakuni Shanlian Giezho</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mat 26:1-5</ref>; <ref loc="MRK 14:1-2">Mak 14:1-2</ref>; <ref loc="LUK 22:1-2">Luj 22:1-2</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45"/>Ingiese <char style="pn">Mereiyen</char>yi hhende iresan olon <char style="png">Yutai</char> kunla <char style="pn">Ersa</char> giesan shiqinyi uzhedene hhei xianxin giewoma, <verse eid="JHN 11:45"/><verse number="46" style="v" sid="JHN 11:46"/>hhelai dunda niezhan kunla Falisai kunyi shida echidene <char style="pn">Ersa</char> giesan shiqinyi kieliewo. <verse eid="JHN 11:46"/><verse number="47" style="v" sid="JHN 11:47"/>Fugie buwa, Falisai kunla goyane zui fugie fayenni kunlai hhantulagha kieliewo, "Ene kun ghudureqi olon xienjighazho. Matan matugiene? <verse eid="JHN 11:47"/><verse number="48" style="v" sid="JHN 11:48"/>Enei izhi ingiezhi gieghase kunla man hhei xianxin giene. Pse <char style="png">Loma</char> kunla irese mai mechii, mai minzui widaghane."<verse eid="JHN 11:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49"/>Hhelai dunda nie kunyi nierei <char style="pn">Gaiyafa</char> giene. Hhe niehonde zui fugie buwa danlazho. Hhelade kieliewo, "Ta yama ulie mejiene! <verse eid="JHN 11:49"/><verse number="50" style="v" sid="JHN 11:50"/>Hhe niezheghanne bexinlade oluzhi fuguse nie gojia man widakuse gou wo. Ene tande haochu bikui ta ulie mejienu?"<verse eid="JHN 11:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 11:51"/>Ene kielienshi goyane kieliesan pusho. Ene honku zui fugie buwa danlase <char style="pn">Ersa</char> <char style="png">Yutai</char> kunlade oluzhi fugukuni melie kieliezho. <verse eid="JHN 11:51"/><verse number="52" style="v" sid="JHN 11:52"/>Zinie <char style="png">Yutai</char> kunlade pusho, gochude sousan Hudai kesilai hhantulaghazhi nie gholughane giezhi fugukui kieliezho.<verse eid="JHN 11:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 11:53"/>Hhe uduse hhela shanlian giezhi <char style="pn">Ersa</char>i alane giezho. <verse eid="JHN 11:53"/><verse number="54" style="v" sid="JHN 11:54"/>Ingiese <char style="pn">Ersa</char> pse <char style="png">Yutai</char> kun dunda mindaminji uye ochirazho. Hhense likai giedene hontan shida <char style="png">Ifalien</char> giezhi nie oronde echisenu tujighalane hhantu souwo.<verse eid="JHN 11:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55"/>
    <char style="png">Yutai</char> kunni Jiulidaosan Jie kuzhene giezho. Olon kunla xianlase <char style="png">Yelusalen</char>de eqie khizhi iresenu goyalane waghane giezho. <verse eid="JHN 11:55"/><verse number="56" style="v" sid="JHN 11:56"/>Hhela <char style="pn">Ersa</char>i ereizhi mechide beisenu nieniedene kieliewo, "Ta uzhese matugiezho? Hhe jieqi daoghale ulie ireneba." <verse eid="JHN 11:56"/><verse number="57" style="v" sid="JHN 11:57"/>Hhe shihoude fugie buwa, Falisai kunla eqie fenfula goudaghazho. "Kien <char style="pn">Ersa</char> khala bikui mejiese mejiegha. Hhei bareine."<verse eid="JHN 11:57"/></para>
  <chapter eid="JHN 11"/>
  <chapter number="12" style="c" sid="JHN 12"/>
  <para style="s">Mereiyen Ersade Xianshui Kiezho</para>
  <para style="r">(<ref loc="MAT 26:6-13">Mat 26:6-13</ref>; <ref loc="MRK 14:3-9">Mak 14:3-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1"/>Jiulidaosan Jieni melieshi zhighudude <char style="pn">Ersa</char> <char style="png">Bodani</char>de kuzhi irewo. Hheshi <char style="pn">Ersa</char> <char style="pn">Lasalu</char>i aminne olughasan oron wo. <verse eid="JHN 12:1"/><verse number="2" style="v" sid="JHN 12:2"/>Kunla <char style="pn">Ersa</char>de oluzhi heifan zhunbei giezho. <char style="pn">Mada</char> ushilazho. <char style="pn">Lasalu</char> <char style="pn">Ersa</char>ghala kunlare hhantu souzho. <verse eid="JHN 12:2"/><verse number="3" style="v" sid="JHN 12:3"/><char style="pn">Mereiyen</char> 1 jin zhen nadaghala giesan guizhuntu xianshuini agizhedene <char style="pn">Ersa</char>i kon jiere kiesenu usunghalane saiwo. Giedera xianshui widao penjizho.<verse eid="JHN 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 12:4"/>
    <char style="pn">Ersa</char>i ghudandune giesan tuji <char style="png">Jialie</char> kun <char style="pn">Yuda</char> kieliewo, <verse eid="JHN 12:4"/><verse number="5" style="v" sid="JHN 12:5"/>"Ene xianshuini 300 gie miengu huidene nanxin kunlade oginema!" <verse eid="JHN 12:5"/><verse number="6" style="v" sid="JHN 12:6"/>Hhe ene kielienyi kieliekushi nanxin kunlade sumulasan pusho. Goyaneshi nie ghughei wo. Baer qibaoni hhe bareizho. Hhense baerni chan agizho.<verse eid="JHN 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7"/>Ingiese <char style="pn">Ersa</char> kieliewo, "Bu danla, hhe ene xianshuii mii bulaku udude zhunbei giezho. <verse eid="JHN 12:7"/><verse number="8" style="v" sid="JHN 12:8"/>Nanxin kunla tanre chan hhantu woma, bi tanre chan hhantu uwo."<verse eid="JHN 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9"/>Olon <char style="png">Yutai</char> kunla <char style="pn">Ersa</char> hhende bikui mejiedene uzhele irewo. Zinie <char style="pn">Ersa</char>i uzhekui pusho. Fuguzhi aminne olusan <char style="pn">Lasalu</char>iye uzhene giezho. <verse eid="JHN 12:9"/><verse number="10" style="v" sid="JHN 12:10"/>Ingiese fugie buwala <char style="pn">Lasalu</char>iye alane giezhi shanlian giezho. <verse eid="JHN 12:10"/><verse number="11" style="v" sid="JHN 12:11"/>Ingiekushi <char style="pn">Lasalu</char>i ene shiqin jiere olon <char style="png">Yutai</char> kunla hhelai bendadene <char style="pn">Ersa</char>i xianxin giezho.<verse eid="JHN 12:11"/></para>
  <para style="s">Honshan Mutun Yelusalende Orozho</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mat 21:1-11</ref>; <ref loc="MRK 11:1-11">Mak 11:1-11</ref>; <ref loc="LUK 19:28-40">Luj 19:28-40</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12"/>Khuichudu olon kunla jieqi daoghale iredene <char style="pn">Ersa</char> <char style="png">Yelusalen</char>de irekui mejiewo. <verse eid="JHN 12:12"/><verse number="13" style="v" sid="JHN 12:13"/>Ingie zunshu mutun chalalai bareidene hhei jienliele echi fugiede waradazhi kieliewo,</para>
  <para style="q1" vid="JHN 12:13">"Hesanna!<note caller="+" style="f"><char style="fr">12:13</char> <char style="em">Bijienyi jiui!</char> </note></para>
  <para style="q1" vid="JHN 12:13">Ezhanni niereghala iresan <char style="png">Isilie</char>ni honshande doulandu!"<verse eid="JHN 12:13"/></para>
  <para style="b"/>
  <para style="m">
    <verse number="14" style="v" sid="JHN 12:14"/>
    <char style="pn">Ersa</char> nie ga enzheghei ereizhi olu unuwo. Jinwun jiere jilasan mutun,<verse eid="JHN 12:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15"/>"<char style="png">Xiwun</char>ni kunla bu ayi.</para>
  <para style="q2" vid="JHN 12:15">Uzhe, tai honshan</para>
  <para style="q2" vid="JHN 12:15">ga enzheghe unuzhi irewo."<verse eid="JHN 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16"/>Hhe xienzide tujilani ene shiqinyi minbai olu dazho. <char style="pn">Ersa</char> kuaikui jienliedene hhela ene kielienshi <char style="pn">Ersa</char>i zhiizhi kieliesei, pse kunla hhende qingiezhi giesei sumula irewo.<verse eid="JHN 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17"/>
    <char style="pn">Ersa</char> <char style="pn">Lasalu</char>i mezase waradazhi khizhedene aminne olughakude shidani beisan kunla hhe giesan shiqinyi kunlade izhi kieliezho. <verse eid="JHN 12:17"/><verse number="18" style="v" sid="JHN 12:18"/>Ingiese olon kunla <char style="pn">Ersa</char> xienjighasan ghudureqii mejiedene hhei jienliele echiwo. <verse eid="JHN 12:18"/><verse number="19" style="v" sid="JHN 12:19"/>Ingiese Falisai kunla nieniedene kieliewo, "Matande yama banfa widawo. Duyai kunla man hhei dagha echiwo."<verse eid="JHN 12:19"/></para>
  <para style="s">Duya Ijiekune Kieliezho</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20"/>Jieqide libai giele iresan kun dunda giedun <char style="png">Xila</char> kun wo. <verse eid="JHN 12:20"/><verse number="21" style="v" sid="JHN 12:21"/>Hhela <char style="png">Jialili</char>ni <char style="png">Bosaida</char> kunni <char style="pn">Feili</char>ni ochiradene xiahua giezhi kieliewo, "Gujiu, bijien <char style="pn">Ersa</char>i ochirale irewo." <verse eid="JHN 12:21"/><verse number="22" style="v" sid="JHN 12:22"/><char style="pn">Feili</char> echidene <char style="pn">Andelie</char>de kieliewo. <char style="pn">Andelie</char> <char style="pn">Feili</char> ghuala hhantu <char style="pn">Ersa</char>de echi kieliewo. <verse eid="JHN 12:22"/><verse number="23" style="v" sid="JHN 12:23"/>Ingie <char style="pn">Ersa</char> kieliewo, "Kunnikewonni kuaiku shihou kuzhewo. <verse eid="JHN 12:23"/><verse number="24" style="v" sid="JHN 12:24"/>Bi tande shuhuajia kielieye, niekozi boudei fure ghazha jiere luidene ulie fuguse dou niekozi fure wo. Fuguse olon boudei osizhi khizhene. <verse eid="JHN 12:24"/><verse number="25" style="v" sid="JHN 12:25"/>Goya amindene oresan kun aminne widaghane. Ene duyade aminne henjisan kun aminne chanqi bouine. <verse eid="JHN 12:25"/><verse number="26" style="v" sid="JHN 12:26"/>Mii ushilasan kun indan mii daghakuni wo. Bi khalashi mii ushilasan kun ye khala wo. Mii ushilasan kunyi Adami danren giene. <verse eid="JHN 12:26"/><verse number="27" style="v" sid="JHN 12:27"/>Ede mii zhughede nango giezho. Bi yan kieliese gou wo? 'Ada, mii ene shiqinse daogha.' giezhi kielienu? Ulie, bi zhen ene shiqinde irezho. <verse eid="JHN 12:27"/><verse number="28" style="v" sid="JHN 12:28"/>Ada, chi nierene famashigha!" Hhe xienzide asiman jierese shenqi irezhi kieliewo, "Bi ijin nierene famashighawo, pse famashighane." <verse eid="JHN 12:28"/><verse number="29" style="v" sid="JHN 12:29"/>Shida beisan kunla sonosusenu kieliewo, "Olien tunguliezho." Psedu kunla kieliewo, "Qienxien hhende kielien kieliezho." <verse eid="JHN 12:29"/><verse number="30" style="v" sid="JHN 12:30"/><char style="pn">Ersa</char> kieliewo, "Ene shenqishi made oluzhi iresan pusho. Tande oluzhi iresan wo. <verse eid="JHN 12:30"/><verse number="31" style="v" sid="JHN 12:31"/>Ede duyani panjiku shihou kuzhewo. Ene duyani touzii tou khighane, jiushi Ibilisi wo. <verse eid="JHN 12:31"/><verse number="32" style="v" sid="JHN 12:32"/>Mii zemin jierese qila qiighakude bi kunlai man xiidene shidane irene." <verse eid="JHN 12:32"/><verse number="33" style="v" sid="JHN 12:33"/><char style="pn">Ersa</char>i ene kielienshi goyane matugie fugukui zhiizhi kieliezho.<verse eid="JHN 12:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34"/>Ingiese kunla kieliewo, "Bijien chenliese jinwunde kieliesanshi Mexiha ibeizi amitu wo giezho. Chi matugie 'Kunnikewonni qila qiighane.' giezhi kieliene? Chi kieliesan Kunnikewonshi kien wo?"<verse eid="JHN 12:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35"/>
    <char style="pn">Ersa</char> kieliewo, "Gon tai dunda oloncha widazho. Gon bikude ta gon dunda yodu. Pse kharani kuzhese tai khane. Kharanide yochen kun khala echikune ulie mejiene. <verse eid="JHN 12:35"/><verse number="36" style="v" sid="JHN 12:36"/>Gon bikude ta gonni xianxin giezhi gonni kewosi danla." <char style="pn">Ersa</char> ene kielienyi kielie baragha likai giedene hhelase pii widawo.<verse eid="JHN 12:36"/></para>
  <para style="s">Xianxin Ese Giesan Kunla</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37"/>Hhelai melie <char style="pn">Ersa</char> ghudureqi olon xienjighazhoma, hhela hhei xianxin ulie giene. <verse eid="JHN 12:37"/><verse number="38" style="v" sid="JHN 12:38"/>Ingiese <char style="pn">Isaiya</char> xienzhi kieliesan kielien mutun gholuwo,</para>
  <para style="q1" vid="JHN 12:38">"Ezhan, bijienyi chonjisanyi kien xianxin giewo?</para>
  <para style="q2" vid="JHN 12:38">Chii nenlii kiende xienjighane?"<verse eid="JHN 12:38"/></para>
  <para style="m">
    <verse number="39" style="v" sid="JHN 12:39"/>Hhela xianxin ulie giekushi <char style="pn">Isaiya</char> pse kieliezho,<verse eid="JHN 12:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40"/>"Ezhan hhelai nudunyini sugho gholughazhi</para>
  <para style="q2" vid="JHN 12:40">zhugheini khiduzheghakushi</para>
  <para style="q1" vid="JHN 12:40">Hhela nudundene chanlazhi</para>
  <para style="q2" vid="JHN 12:40">zhughedene minbai olusenu kharei daorese</para>
  <para style="q1" vid="JHN 12:40">Bi hhelai goudaghakuse ayizho."<verse eid="JHN 12:40"/></para>
  <para style="m">
    <verse number="41" style="v" sid="JHN 12:41"/>
    <char style="pn">Isaiya</char> <char style="pn">Ersa</char>i famani chanladene hhei zhiizhi ene kielienyi kieliesan wo. <verse eid="JHN 12:41"/><verse number="42" style="v" sid="JHN 12:42"/>Ingieliuzhe <char style="png">Yutai</char> kunni noyen dundaye hhei xianxin giesan kun olon wo, Falisai kunla huitanse tou khighakuse ayizhi chenren gie dazho. <verse eid="JHN 12:42"/><verse number="43" style="v" sid="JHN 12:43"/>Hhela kunni kuaikui Hudai kuaikuse xiqi wo.<verse eid="JHN 12:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44"/>
    <char style="pn">Ersa</char> fugiede kieliewo, "Kunla mii xianxin giese zinie mii xianxin giesan pusho, mii peizhi ireghasan hhei xianxin giezho. <verse eid="JHN 12:44"/><verse number="45" style="v" sid="JHN 12:45"/>Kunla mii chujieghese mii peizhi ireghasanyi chujieghezho. <verse eid="JHN 12:45"/><verse number="46" style="v" sid="JHN 12:46"/>Bi duyade irese duyani gon wo. Mii xianxin giesan kunlai bi kharanide ulie soughane. <verse eid="JHN 12:46"/><verse number="47" style="v" sid="JHN 12:47"/>Mii kielienyi sonosudene ulie giechen kunyi bi ulie panjine. Bi duyade irese duyai panjile ese irezho, jiuile irezho. <verse eid="JHN 12:47"/><verse number="48" style="v" sid="JHN 12:48"/>Mii ulie kerechen, kielienyimi ulie jienliechen kunni panjiku wine. Bi kieliesan kielien duya barakude hhei panjine. <verse eid="JHN 12:48"/><verse number="49" style="v" sid="JHN 12:49"/>Bi kieliesanshi goyane sumulazhi kieliesan pusho. Mii peizhi ireghasan Adami made minlin ogizhi mii yan kielieghase bi yan kieliezho. <verse eid="JHN 12:49"/><verse number="50" style="v" sid="JHN 12:50"/>Adaimi minlinshi chanqiku amin bikui bi mejiene. Ingiese bi zinie Adami made kielieghakuni kieliene."<verse eid="JHN 12:50"/></para>
  <chapter eid="JHN 12"/>
  <chapter number="13" style="c" sid="JHN 13"/>
  <para style="s">Tujiladene Kon Waghazho</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1"/>Jiulidaosan Jieni melieshida <char style="pn">Ersa</char> duyase likai giezhi Adane hhende echiku shihou kurukui mejiewo. Hhe ene duyani goya kunladene orezhi zuihou kurutula izhi orezho. <verse eid="JHN 13:1"/><verse number="2" style="v" sid="JHN 13:2"/>Heifan ijiekude Ibilisi <char style="png">Jialie</char> kun <char style="pn">Ximun</char>yi kewon <char style="pn">Yuda</char>i zhughede <char style="pn">Ersa</char>i ghudandukui melieshise gie goudaghazho. <verse eid="JHN 13:2"/><verse number="3" style="v" sid="JHN 13:3"/><char style="pn">Ersa</char> Adani duyani qienlii hhei khade jiuisanyi, goyaneshi Hudai hhense iresanyi, pse Hudai hhende echikui mejiene. <verse eid="JHN 13:3"/><verse number="4" style="v" sid="JHN 13:4"/>Ingie <char style="pn">Ersa</char> shire konse bosi ire jienne tei, kanzidene nie shoujinyi banla, <verse eid="JHN 13:4"/><verse number="5" style="v" sid="JHN 13:5"/>nie nienpen usui kiezhi ire, tujilane konyi waghasenu kanzidene banlasan shoujinghala caizhi ghoghawo. <verse eid="JHN 13:5"/><verse number="6" style="v" sid="JHN 13:6"/>Waghazhi <char style="pn">Ximun-Beduru</char>de kuzhese <char style="pn">Beduru</char> <char style="pn">Ersa</char>de kieliewo, "Ezhan, chi mini konni waghanu?" <verse eid="JHN 13:6"/><verse number="7" style="v" sid="JHN 13:7"/><char style="pn">Ersa</char> kieliewo, "Bi giesanyi ede chi ulie mejienema, khuinashi mejiene." <verse eid="JHN 13:7"/><verse number="8" style="v" sid="JHN 13:8"/><char style="pn">Beduru</char> kieliewo, "Chi mini konni jiedui waghazhi ulie olune." <char style="pn">Ersa</char> kieliewo, "Bi chii ulie waghase bi jienliesan guzide chi bei dane." <verse eid="JHN 13:8"/><verse number="9" style="v" sid="JHN 13:9"/><char style="pn">Ximun-Beduru</char> kieliewo, "Ezhan, qinse gon konyimi bu wagha. Kha, qiorunyimi man wagha." <verse eid="JHN 13:9"/><verse number="10" style="v" sid="JHN 13:10"/><char style="pn">Ersa</char> kieliewo, "Xizao giezhi daosan kun zinie konne waghase hunshenni man ganjin wo. Tashi ganjinni woma, manshi ganjinni pusho." <verse eid="JHN 13:10"/><verse number="11" style="v" sid="JHN 13:11"/><char style="pn">Ersa</char> kien hhei ghudandukui melieshise mejiene. Ingiese "Tashi man ganjinni pusho." giezhi kieliewo. <verse eid="JHN 13:11"/><verse number="12" style="v" sid="JHN 13:12"/><char style="pn">Ersa</char> hhelai konni waghazhi balu, jienne musidene pse souwo. Ingie hhelade kieliewo, "Bi tande giesanyi ta dunjirewoye? <verse eid="JHN 13:12"/><verse number="13" style="v" sid="JHN 13:13"/>Ta mini loushi, ezhan giezhi uruzho. Ta urusan oluzho. Bi enbene. <verse eid="JHN 13:13"/><verse number="14" style="v" sid="JHN 13:14"/>Bishi tai ezhan, loushi woma, tai konni waghawo. Taye nieniene konyi wagha. <verse eid="JHN 13:14"/><verse number="15" style="v" sid="JHN 13:15"/>Bi tande nie yanzi uzheghawo. Ta ye zhao bi tande giesan mutun giendu. <verse eid="JHN 13:15"/><verse number="16" style="v" sid="JHN 13:16"/>Bi tande shuhuajia kielieye, hoji ezhanse fugie uwo. Peizhi ireghasan kun peisan kunse fugie uwo. <verse eid="JHN 13:16"/><verse number="17" style="v" sid="JHN 13:17"/>Enei ta mejienema, ta ingiezhi giese tande fuqi wine. <verse eid="JHN 13:17"/><verse number="18" style="v" sid="JHN 13:18"/>Mini ene kielienshi ta manlai zhiizhi kieliesan pusho. Bi goyane kienyi sunghusei mejiene. Ingieliuzhe jinwun jieredu kielien bixi gholune, 'Mare hhantu ginan ijiesan kun konghalane mii qiuine.' <verse eid="JHN 13:18"/><verse number="19" style="v" sid="JHN 13:19"/>Ede shiqin da uye chenjikude bi tande xien kieliekushi shihou kuruse bishi hhe enbekui tai xianxin gieghane giezho. <verse eid="JHN 13:19"/><verse number="20" style="v" sid="JHN 13:20"/>Bi tande shuhuajia kielieye, kun bi peisan kunlai jienliese mii jienliezho. Mii jienliese mii peizhi ireghasan hhei jienliezho."<verse eid="JHN 13:20"/></para>
  <para style="s">Ersani Ghudandukuni Kieliezho</para>
  <para style="r">(<ref loc="MAT 26:20-25">Mat 26:20-25</ref>; <ref loc="MRK 14:17-21">Mak 14:17-21</ref>; <ref loc="LUK 22:21-23">Luj 22:21-23</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21"/>
    <char style="pn">Ersa</char> ene kielienyi kieliesenu zhughedene nango giezhi minminji kieliewo, "Bi tande shuhuajia kielieye, tai dunda nie kun mii ghudandune." <verse eid="JHN 13:21"/><verse number="22" style="v" sid="JHN 13:22"/>Tujilani nieniene uzhezhi hhe kienyi kieliesei mejie dazho. <verse eid="JHN 13:22"/><verse number="23" style="v" sid="JHN 13:23"/>Tujilani dunda niekozishi <char style="pn">Ersa</char> oresan wo. Hhe <char style="pn">Ersa</char>i kanzide souzho. <verse eid="JHN 13:23"/><verse number="24" style="v" sid="JHN 13:24"/><char style="pn">Ximun-Beduru</char> hhe nie tujide qiorun jienjizhi, "Ezhan kienyi kieliezho?" giezhi asaghawo. <verse eid="JHN 13:24"/><verse number="25" style="v" sid="JHN 13:25"/>Hhe nie tuji <char style="pn">Ersa</char>i kanzii shighadene asazho, "Ezhan, kien wine?" <verse eid="JHN 13:25"/><verse number="26" style="v" sid="JHN 13:26"/><char style="pn">Ersa</char> kieliewo, "Bi goujinie ginanyi zhanjizhi kiende ogise hhe enbene." Ingiedene <char style="pn">Ersa</char> goujinie ginanyi zhanjisenu <char style="png">Jialie</char> kun <char style="pn">Ximun</char>ni kewon <char style="pn">Yuda</char>de ogiwo. <verse eid="JHN 13:26"/><verse number="27" style="v" sid="JHN 13:27"/>Hhe jienliese Ibilisi hhei sudoro orowo. Ingiese <char style="pn">Ersa</char> hhende kieliewo, "Chi giekune ghujighan gie." <verse eid="JHN 13:27"/><verse number="28" style="v" sid="JHN 13:28"/>Shire konde hhantu sousan kunla hhende kieliesan ene kielienyi kiemada dunjire dawo. <verse eid="JHN 13:28"/><verse number="29" style="v" sid="JHN 13:29"/>Kunla sumulase <char style="pn">Yuda</char> baerni bareizho, <char style="pn">Ersa</char> hhende kieliesanshi hhe matande jieqi daoghaku dunxi agile echi giezho. Pse jiahui kunlade yama khugho giezho. <verse eid="JHN 13:29"/><verse number="30" style="v" sid="JHN 13:30"/><char style="pn">Yuda</char> hhe ginanyi jienliedene deigo ghadane khizhi echiwo. Hhe xienzishi xieni wo.<verse eid="JHN 13:30"/></para>
  <para style="s">Shini Minlin</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31"/>
    <char style="pn">Yuda</char> khizhi echisenu <char style="pn">Ersa</char> kieliewo, "Ede Kunnikewonni kuaiku kuzhewo. Kunnikewonni tungo giezhi Hudaiye kuaiwo. <verse eid="JHN 13:31"/><verse number="32" style="v" sid="JHN 13:32"/>Huda Kunnikewonni tungo giezhi goyane kuaikui jienliese hheye goyai tungo giezhi Kunnikewonni kuaine. Ede kuaiku ghujinlazho. <verse eid="JHN 13:32"/><verse number="33" style="v" sid="JHN 13:33"/>Kesila, bi tanre hhantu biku shihou oloncha widazho. Khuinashi ta mii ereinema, bi echiku oronde ta echi dane. Ene kielienyi bi melieshi <char style="png">Yutai</char> kunlade kieliezhi daozho. Ede tandeye ingiezhi kielieye. <verse eid="JHN 13:33"/><verse number="34" style="v" sid="JHN 13:34"/>Bi tande nie shini minlin ogiye, ta nieniedene orendu. Bi tande oresan mutun taye qingiezhi nieniedene orendu. <verse eid="JHN 13:34"/><verse number="35" style="v" sid="JHN 13:35"/>Ta nieniedene orese tashi mini tuji bikui kunla mejiene."<verse eid="JHN 13:35"/></para>
  <para style="s">Ersai Ulie Tanikui Kieliezho</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mat 26:31-35</ref>; <ref loc="MRK 14:27-31">Mak 14:27-31</ref>; <ref loc="LUK 22:31-34">Luj 22:31-34</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36"/>
    <char style="pn">Ximun-Beduru</char> <char style="pn">Ersa</char>de asawo, "Ezhan, chi khala echine?" <char style="pn">Ersa</char> kieliewo, "Bi echiku oronde chi ede echi dane. Khuinashi chi mii daghazhi echine." <verse eid="JHN 13:36"/><verse number="37" style="v" sid="JHN 13:37"/><char style="pn">Beduru</char> kieliewo, "Ezhan, bi ede yale echizhi ulie olune? Bi chade aminne sheine." <verse eid="JHN 13:37"/><verse number="38" style="v" sid="JHN 13:38"/><char style="pn">Ersa</char> kieliewo, "Chi made aminne sheinu? Bi chade shuhuajia kielieye, tigha kheilatula chi mii 3 hui ulie renjine."<verse eid="JHN 13:38"/></para>
  <chapter eid="JHN 13"/>
  <chapter number="14" style="c" sid="JHN 14"/>
  <para style="s">Adai Hhende Echiku Zinie Mo</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1"/>"Ta zhughedene nango bu gie. Ta Hudai xianxin gie, miiye xianxin gie. <verse eid="JHN 14:1"/><verse number="2" style="v" sid="JHN 14:2"/>Adaimi giede souku oron olon wo. Uwoshi bi tande eqie kieliene. Bi echise tande oron zhunbei giele echine. <verse eid="JHN 14:2"/><verse number="3" style="v" sid="JHN 14:3"/>Bi echi tande oron zhunbei giedene pse ire tai hhende jienlie echine. Ingiese bi khalashi taye khala wo. <verse eid="JHN 14:3"/><verse number="4" style="v" sid="JHN 14:4"/>Bi echiku hhe moni ta mejiene."<verse eid="JHN 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5"/>
    <char style="pn">Doma</char> <char style="pn">Ersa</char>de kieliewo, "Ezhan, chi khala echikui bijien ulie mejiene. Hhe moni bijien matui mejiene?" <verse eid="JHN 14:5"/><verse number="6" style="v" sid="JHN 14:6"/><char style="pn">Ersa</char> kieliewo, "Bishijiu mo wo, zhendao wo, amin wo. Mase tungo ulie giese kiemada Adai hhende echi dane. <verse eid="JHN 14:6"/><verse number="7" style="v" sid="JHN 14:7"/>Ta mii tanise Adaimiye taniwo. Enedu khuinashi ta hhei taniwo, ye chujieghewo." <verse eid="JHN 14:7"/><verse number="8" style="v" sid="JHN 14:8"/><char style="pn">Feili</char> <char style="pn">Ersa</char>de kieliewo, "Ezhan, bijiende Adai nie uzheghama, bijiende kuruwo." <verse eid="JHN 14:8"/><verse number="9" style="v" sid="JHN 14:9"/><char style="pn">Ersa</char> kieliewo, "<char style="pn">Feili</char>, bi tanre hhantu imeghenicha oluzho. Chi da mii tani dazhou? Kun mii chujieghese Adaimi chujieghezho. Chi matugie 'Adai bijiende uzhegha.' giezhi kieliene? <verse eid="JHN 14:9"/><verse number="10" style="v" sid="JHN 14:10"/>Bi Adai sudoro wo, Ada mii sudoro bikui chi xianxin ulie gienu? Bi tande kieliesan kielienshi bi goyane kieliesan pusho. Mii sudoro sousan Adami goya wiliene giezho. <verse eid="JHN 14:10"/><verse number="11" style="v" sid="JHN 14:11"/>Bi Adai sudoro wo, Ada mini sudoro wo giesan ene kielienyi ta xianxin gie. Xianxin gie dase bi giesan wilielani uzhedene xianxin gie. <verse eid="JHN 14:11"/><verse number="12" style="v" sid="JHN 14:12"/>Bi tande shuhuajia kielieye, ede bi Adai hhende echine. Ingiese mii xianxin giesan kunla bi giesan wilielaiye gie shidane. Da enense fugie wiliei giene. <verse eid="JHN 14:12"/><verse number="13" style="v" sid="JHN 14:13"/>Ta mini niereghala yan xiahua giese bi tande yan gholughane. Ingiese Ada Kewonne jierese kuaikui jienliene. <verse eid="JHN 14:13"/><verse number="14" style="v" sid="JHN 14:14"/>Ta mini niereghala mase yan xiahua giese bi yan gholughane."<verse eid="JHN 14:14"/></para>
  <para style="s">Shenlinni Ireghane</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15"/>"Ta made orese mini minlinni zunji. <verse eid="JHN 14:15"/><verse number="16" style="v" sid="JHN 14:16"/>Bi Adasene xiahua giezhi tande da nie banjichen ireghaye. Hhe tanre chan hhantula gie. <verse eid="JHN 14:16"/><verse number="17" style="v" sid="JHN 14:17"/>Eneshi zhendaoni ruhher wo. Duyani kunla hhei chujieghe dane, taniye dane. Ingiese hhei jienlie dane. Ta hhei tani shidane. Hhe tanre hhantu souzho, tai sudoro wine. <verse eid="JHN 14:17"/><verse number="18" style="v" sid="JHN 14:18"/>Bi tai oliechen mutun bendazhi ulie jiene. Bi da tai shida irene. <verse eid="JHN 14:18"/><verse number="19" style="v" sid="JHN 14:19"/>Pse goujicha beise duyani kunla mini chujieghe danema, ta mini chujieghene. Bi amitu wo, taye amitu wo. <verse eid="JHN 14:19"/><verse number="20" style="v" sid="JHN 14:20"/>Hhe niudu kuse bi Adai sudoro wo, ta mii sudoro wo, biye tai sudoro bikui ta mejiene. <verse eid="JHN 14:20"/><verse number="21" style="v" sid="JHN 14:21"/>Kien mini minlinyi jienliezhi zunjise made orezho. Made orese Adamiye hhende orene. Biye hhende orezhi goyane xienjighane." <verse eid="JHN 14:21"/><verse number="22" style="v" sid="JHN 14:22"/><char style="pn">Yuda</char> <char style="pn">Ersa</char>de asazho (Ene <char style="pn">Yuda</char>shi <char style="png">Jialie</char> kun <char style="pn">Yuda</char> pusho), "Ezhan, chi bijiende xienjighane, duyani kunlade yale ulie xienjighane?" <verse eid="JHN 14:22"/><verse number="23" style="v" sid="JHN 14:23"/><char style="pn">Ersa</char> kieliewo, "Kun made orese mini kielienyi zunjine. Adamiye hhende orene. Bi Adaghalane hhei hhende echidene hhantu soune. <verse eid="JHN 14:23"/><verse number="24" style="v" sid="JHN 14:24"/>Made ulie orechen kun mini kielienyi ulie zunjine. Ta sonosusan kielienshi minughun pusho, mini peizhi ireghasan Adaimi kielien wo."<verse eid="JHN 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25"/>"Ene kielienlai bi tanre hhantu bikude tande kieliewo. <verse eid="JHN 14:25"/><verse number="26" style="v" sid="JHN 14:26"/>Banjichen giezhi urusan Shenlin irese shiqinlai man tande surughane, bi tande kieliesan kielienlai man sumula ireghane. Hheshi Ada mini niereghala peizhi ireghasan wo. <verse eid="JHN 14:26"/><verse number="27" style="v" sid="JHN 14:27"/>Bi tande pinnan ogiye. Goya pinnanne tande ogiye. Bi ogisan pinnanshi duyani kunla ogisan pinnanyi buxian wo. Ta zhughedene munan bu gie, ye bu ayi. <verse eid="JHN 14:27"/><verse number="28" style="v" sid="JHN 14:28"/>Bi yolane, pse tai enende irene giesan ene kielienyi ta chenliezhi daozho. Ta made orese bi Adai hhende echise ta bayasune. Ada mase fugie wo. <verse eid="JHN 14:28"/><verse number="29" style="v" sid="JHN 14:29"/>Ede shiqinla da uye gholukude bi xien tande kieliewo. Ingiezhi giese shiqin gholukudeni tai xianxin gieghane giezho."<verse eid="JHN 14:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 14:30"/>"Ene duyani touzi ede irewo. Ingiese bi tanre kielien kielieku shihou oloncha widazho. Hhe mini yama gie danema, <verse eid="JHN 14:30"/><verse number="31" style="v" sid="JHN 14:31"/>ingieliuzhe bi Adadene oresei, pse Adami made matugiezhi fenfulase bi qingiezhi giesei duyani kunlade mejieghane. Bosizhe! Matan yoye."<verse eid="JHN 14:31"/></para>
  <chapter eid="JHN 14"/>
  <chapter number="15" style="c" sid="JHN 15"/>
  <para style="s">Zhen Putou Mutun</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1"/>"Bishi zhen putou mutun wo. Adamishi zeilasan kun wo. <verse eid="JHN 15:1"/><verse number="2" style="v" sid="JHN 15:2"/>Hhe mii jiere alima ulie sousan chalai man ghigha widaghane. Alima souku chalai ulou giezhi goudaghase hhei jiere alima pse olon soughane. <verse eid="JHN 15:2"/><verse number="3" style="v" sid="JHN 15:3"/>Ta bi jianjisan kielienghala ijin ganjinshiwo. <verse eid="JHN 15:3"/><verse number="4" style="v" sid="JHN 15:4"/>Ta mii sudoro bei. Biye tai sudoro beine. Chala mutun jiere uwoshi goyane alima sou dane. Ta mii sudoro ulie beiseye niekielien wo. <verse eid="JHN 15:4"/><verse number="5" style="v" sid="JHN 15:5"/>Bishi putou mutun wo. Tashi chala wo. Kien mii sudoro beizhi bi hhei sudoro beise hhe alima olon soune. Mase likai giese ta yama gie dane. <verse eid="JHN 15:5"/><verse number="6" style="v" sid="JHN 15:6"/>Kun mini sudoro ulie beise bendadene ghosan chala niekielien wo. Kunla hhei qianguzhi echise khande tulie widaghane. <verse eid="JHN 15:6"/><verse number="7" style="v" sid="JHN 15:7"/>Ta mini sudoro beizhi mini kielien tai sudoro beise ta yan xiahua giezhi kerese tande man gholughane. <verse eid="JHN 15:7"/><verse number="8" style="v" sid="JHN 15:8"/>Ta alima olon souzhi mini tuji gholuse Adademi kuaiku irene. <verse eid="JHN 15:8"/><verse number="9" style="v" sid="JHN 15:9"/>Adami made oreku mutun biye tande orezho. Ta mini oreku sudoro bei. <verse eid="JHN 15:9"/><verse number="10" style="v" sid="JHN 15:10"/>Ta mii minlinyi zunjise mii oreku sudoro beizho. Eneshi bi Adane minlinyi zunjizhi hhei oreku sudoro beikughala niekielien wo."<verse eid="JHN 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 15:11"/>"Bi enezighan kielienyi tande kieliese mii bayasukughala tai bayasughane. Tai fugiede bayasughane. <verse eid="JHN 15:11"/><verse number="12" style="v" sid="JHN 15:12"/>Bi tande oreku mutun ta nieniedene orendu. Eneshi mini minlin wo. <verse eid="JHN 15:12"/><verse number="13" style="v" sid="JHN 15:13"/>Kun zhanliendene aminne sheise, ene orekuse fugieni uwo. <verse eid="JHN 15:13"/><verse number="14" style="v" sid="JHN 15:14"/>Bi fenfulasan minlinyi ta zunjise tashi mini zhanlien wo. <verse eid="JHN 15:14"/><verse number="15" style="v" sid="JHN 15:15"/>Bi tai pse hoji giezhi ulie urune. Ezhanyi wiliei hojila ulie mejiene. Bi tai zhanlien danlaghazho. Bi Adane hhense chenliezhi iresanlai tande man mejieghawo. <verse eid="JHN 15:15"/><verse number="16" style="v" sid="JHN 15:16"/>Ta mini sunghusan pusho, bi tai sunghusan wo. Bi tai peizhi chanqiku alimai soughale echiwo. Ingiese ta mini niereghala yan xiahua giese Adami tande ogine. <verse eid="JHN 15:16"/><verse number="17" style="v" sid="JHN 15:17"/>Ta nieniedene orendu. Eneshi mini minlin wo."<verse eid="JHN 15:17"/></para>
  <para style="s">Duyani Kunla Tani Henjine</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18"/>"Duyai kunla tai henjise ta mejiendu. Mii tanse melieshi henjizho. <verse eid="JHN 15:18"/><verse number="19" style="v" sid="JHN 15:19"/>Ta duyaghunshi duyani kunla tande orenema, ta duyaghun pusho. Bi tai duyase sunghuwo. Ingiese duya tai henjine. <verse eid="JHN 15:19"/><verse number="20" style="v" sid="JHN 15:20"/>Hoji ezhanse fugie uwo giezhi bi tande kieliesan ene kielienyi jila. Hhela mini heise taiye heine. Hhela mii kielienyi zunjizhi giese tai kielienyiye zunjizhi giene. <verse eid="JHN 15:20"/><verse number="21" style="v" sid="JHN 15:21"/>Hhela mini yenyinghala tande ingiezhi giezho. Hhela mini peizhi ireghasan Hhei tani dazho. <verse eid="JHN 15:21"/><verse number="22" style="v" sid="JHN 15:22"/>Bi irezhi hhelade uye kieliezhoshi hhelade zui uwo. Ede hhelade zui uwo giezhi kielie dane. <verse eid="JHN 15:22"/><verse number="23" style="v" sid="JHN 15:23"/>Mini henjise Adaimiye henjizho. <verse eid="JHN 15:23"/><verse number="24" style="v" sid="JHN 15:24"/>Bi hhelai dunda kiema gie dasei ese giezhoshi hhelade zui uwoma, ede hhela bi adamighalai chanladene henjizho. <verse eid="JHN 15:24"/><verse number="25" style="v" sid="JHN 15:25"/>Ene hhelai jinwun jiere huaisan kielien mutun gholuwo, 'Hhela mii uyenwuguji henjizho.'"<verse eid="JHN 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26"/>"Bi Adane hhense banjichenyi peizhi ireghane. Hheshi Adai hhense iresan zhendaoni ruhher wo. Hhe irese made ganzhen beine. <verse eid="JHN 15:26"/><verse number="27" style="v" sid="JHN 15:27"/>Taye made ganzhen beine. Ta kaishi giesanse izhi bighala hhantu wo."<verse eid="JHN 15:27"/></para>
  <chapter eid="JHN 15"/>
  <chapter number="16" style="c" sid="JHN 16"/>
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1"/>"Bi tande enezighan shiqinyi kieliese tai zhughei ulie gojiolughane giezho. <verse eid="JHN 16:1"/><verse number="2" style="v" sid="JHN 16:2"/>Kunla tai huitanse tou khighane. Shihou kuzhese tai alachen kunla ingiezhi giese Hudai shunjizho giezhi sumulane. <verse eid="JHN 16:2"/><verse number="3" style="v" sid="JHN 16:3"/>Hhela ingiezhi giekushi Adai tani dane, miiye tani dane. <verse eid="JHN 16:3"/><verse number="4" style="v" sid="JHN 16:4"/>Bi enezighan shiqinyi tande kieliekushi shihou kuzhese bi tande kieliezhi daosanyi sumulazhi ireghane giezho. Melieshi bi tanre hhantushi ene shiqinyi tande ese kieliezho."<verse eid="JHN 16:4"/></para>
  <para style="s">Shenlinni Wilie</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 16:5"/>"Ede bi mini peizhi ireghasan Adai hhende echinema, tai dunda chi khala echine giezhi made asachen kun nieda uwo. <verse eid="JHN 16:5"/><verse number="6" style="v" sid="JHN 16:6"/>Kharei bi enezighan shiqinyi tande kieliese ta zhughedene hende nango giezho. <verse eid="JHN 16:6"/><verse number="7" style="v" sid="JHN 16:7"/>Bi tande shuhua kielieye, bi echise tande kharei gou wo. Bi ulie echise banjichen tai enende ulie irene. Bi echise hhei tande peizhi ireghane. <verse eid="JHN 16:7"/><verse number="8" style="v" sid="JHN 16:8"/>Hhe irese zui fanmiende, gundanni fanmiende, panjiku fanmiende duyani codasei kheilane. <verse eid="JHN 16:8"/><verse number="9" style="v" sid="JHN 16:9"/>Zuini fanmiende kieliekushi hhela mini xianxin ese giewo. <verse eid="JHN 16:9"/><verse number="10" style="v" sid="JHN 16:10"/>Gundanni fanmiende kieliekushi bi Adai hhende echise ta mini chanla dane. <verse eid="JHN 16:10"/><verse number="11" style="v" sid="JHN 16:11"/>Panjikuni fanmiende kieliekushi ene duyani touzini ijin panjiwo."<verse eid="JHN 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12"/>"Bi tande kielieku shiqin da olon woma, ta ede jienlie dane. <verse eid="JHN 16:12"/><verse number="13" style="v" sid="JHN 16:13"/>Zhendaoni ruhher irese tai uduruzhi soyuji zhendaode echighane. Hhe kieliesanshi goyane sumulasan pusho. Hhe chenliesanlane tande kieliene. Khuinashiku shiqinlaiye tande mejieghane. <verse eid="JHN 16:13"/><verse number="14" style="v" sid="JHN 16:14"/>Hhe mase chenliesanlane man tande kieliezhi ogine. Ingiese made kuaiku irene. <verse eid="JHN 16:14"/><verse number="15" style="v" sid="JHN 16:15"/>Adaghunshi man minughun wo. Ingiese hhe mase chenliesanlane man tande kieliezhi ogine giezhi bi kieliewo."<verse eid="JHN 16:15"/></para>
  <para style="s">Nango Bayasukui Gholune</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16"/>"Goujicha beise ta mini chujieghe dane. Pse goujicha beise ta mini chujieghene." <verse eid="JHN 16:16"/><verse number="17" style="v" sid="JHN 16:17"/>Ingiese giedun tujila nieniedene kieliezho, "Hhe matande yan kieliezho? 'Goujicha beise matan hhei chujieghe dane. Pse goujicha beise matan hhei chujieghene.' Da bi Adai hhende echine giesan eneshi yan isi wo?" <verse eid="JHN 16:17"/><verse number="18" style="v" sid="JHN 16:18"/>Pse kieliezho, "Hhe kieliesan goujichashi yan isi wo? Matan hhe kieliesan kielienyi dunjire dawo." <verse eid="JHN 16:18"/><verse number="19" style="v" sid="JHN 16:19"/><char style="pn">Ersa</char> hhela asane giesei mejiedene kieliewo, "Bi kieliesan goujicha beise ta mini pse chujieghe dane, pse goujicha beise ta mini chujieghene giesan ene kielienghala ta nieniedene asaduzhou? <verse eid="JHN 16:19"/><verse number="20" style="v" sid="JHN 16:20"/>Bi tande shuhuajia kielieye, ta nango giezhi hende wilane, duyani kunla bayasune. Ta nango gienema, tai nango bayasukui gholune. <verse eid="JHN 16:20"/><verse number="21" style="v" sid="JHN 16:21"/>Biereila oluku shihou kuzhese munan giene. Hhe kewosini oluse otusanlai mata widaghane. Hhe duyade nie kewosi oluse hende bayasune. <verse eid="JHN 16:21"/><verse number="22" style="v" sid="JHN 16:22"/>Ta ede munan giezhoma, bi tai pse chujieghene. Qingiese ta bayasune. Ene bayasukui kiemada agizhi echi dane. <verse eid="JHN 16:22"/><verse number="23" style="v" sid="JHN 16:23"/>Hhe niudu kuse ta made yama ulie asane. Bi tande shuhuajia kielieye, ta mini niereghala yan xiahua giese Adami tande ogine. <verse eid="JHN 16:23"/><verse number="24" style="v" sid="JHN 16:24"/>Eli kutula ta mini niereghala yama xiahua uye giewo. Ta xiahua gie, tande ogine. Ta hende bayasune."<verse eid="JHN 16:24"/></para>
  <para style="s">Ersa Duyase Injiwo</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25"/>"Ene kielienlai bi tande bilazhi kieliewo. Shihou kuzhese bi pse tande bilazhi ulie kieliene. Adai shiqinyi tande mindaminji kieliezhi ogine. <verse eid="JHN 16:25"/><verse number="26" style="v" sid="JHN 16:26"/>Hhe niudude ta mini niereghala xiahua giene. Eneshi bi tande oluzhi Adade xiahua gieku isi pusho. <verse eid="JHN 16:26"/><verse number="27" style="v" sid="JHN 16:27"/>Ta made orezho, pse bishi Adai hhense ireseiye xianxin giezho. Ingiese Ada goyane tande orezho. <verse eid="JHN 16:27"/><verse number="28" style="v" sid="JHN 16:28"/>Bi Adai hhense khizhezhi duyade irewo. Pse duyase likai giezhi Adai hhende echine." <verse eid="JHN 16:28"/><verse number="29" style="v" sid="JHN 16:29"/>Tujila kieliewo, "Ede chi mindaminji kieliezho, bilazhi uye kieliezho. <verse eid="JHN 16:29"/><verse number="30" style="v" sid="JHN 16:30"/>Chi yanniliuzhe mejiekui bijien ede mejiene. Kunla chade asaku biyoye uwo. Eneghala bijien chishi Hudai hhense iresei xianxin giezho." <verse eid="JHN 16:30"/><verse number="31" style="v" sid="JHN 16:31"/><char style="pn">Ersa</char> kieliewo, "Ta ede xianxin giezhou? <verse eid="JHN 16:31"/><verse number="32" style="v" sid="JHN 16:32"/>Uzhe, ta sandazhi goya oronladene echiku shihou kuzhene, shijishan ede kuzhewo. Ta mini niezheghan benda jiene. Bi niezheghanne pusho, Adaghalane hhantu wo. <verse eid="JHN 16:32"/><verse number="33" style="v" sid="JHN 16:33"/>Bi ene kielienyi kieliekushi ta mii tungo giezhi pinnanyi jienlieghane giezho. Ta duyade shouku gienema, zhughene khidunde gie! Bi duyani injiwo!"<verse eid="JHN 16:33"/></para>
  <chapter eid="JHN 16"/>
  <chapter number="17" style="c" sid="JHN 17"/>
  <para style="s">Ersa Tujiladene Onxian Giezho</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1"/>
    <char style="pn">Ersa</char> ene kielienyi kieliedene qiorunne qila asiman jiere uzhe kieliewo, "Ada, shihou kuruwo. Chi Kewone kuai, ingiese Kewonye chii kuaine. <verse eid="JHN 17:1"/><verse number="2" style="v" sid="JHN 17:2"/>Chi Kewondene ogisan kunlade chanqiku aminni ogine giezhi soyuji kunlai man gonjiku qienlii hhende ogizho. <verse eid="JHN 17:2"/><verse number="3" style="v" sid="JHN 17:3"/>Niekozi zhen Hudai tanizhi hhe peizhi ireghasan <char style="pn">Ersa</char> Mexihani tanise chanqiku amin enbene. <verse eid="JHN 17:3"/><verse number="4" style="v" sid="JHN 17:4"/>Chi made fenfulasan wiliei bi onchen giezhi ene zemin jierese chade kuaikui ireghawo. <verse eid="JHN 17:4"/><verse number="5" style="v" sid="JHN 17:5"/>Ada, ede chii melie made famani ogi. Duyase melie matan hhantu xianshou giesan famani made ogi."<verse eid="JHN 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6"/>"Chi duya jierese made ogisan kunlade bi chii nierei mejieghawo. Hhela benshenshi chinughun wo. Chi hhelai made ogiwo. Hhelaye chini kielienyi zunjiwo. <verse eid="JHN 17:6"/><verse number="7" style="v" sid="JHN 17:7"/>Ede hhela chi made ogisanshi man chii hhense iresanyi mejiewo. <verse eid="JHN 17:7"/><verse number="8" style="v" sid="JHN 17:8"/>Chi made ogisan kielienyi bi hhelade ogise hhela jienliewo. Hhela bishi chii hhense iresanyi mejiewo. Chi mini peizhi ireghasanyiye xianxin giewo."<verse eid="JHN 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 17:9"/>"Bi hhelade oluzhi onxian giezho. Duyani kunlade oluzhi onxian ese giezho. Hhelashi chinughun wo. Ingiese chi made ogisan kunlade bi onxian giezho. <verse eid="JHN 17:9"/><verse number="10" style="v" sid="JHN 17:10"/>Minughunshi man chinughun wo. Chinughunshi minughun wo. Hhelai jierese made kuaikui irezho. <verse eid="JHN 17:10"/><verse number="11" style="v" sid="JHN 17:11"/>Enense khuinashi bi duyade uwo. Hhela duyade wine. Bi chii hhende echine. Zhiguitu Ada, chi made ogisan niereghalane hhelai baohu giezhi matan mutun hhelai niekozi gholugha. <verse eid="JHN 17:11"/><verse number="12" style="v" sid="JHN 17:12"/>Bi hhelare hhantu bikude chi made ogisan niereghalane bi hhelai baohu giezhi ezheliezho. Chugo hhe widaku kunse andase pse nieda ulie widane. Ene jinwun jieredu kielien mutun gholuwo."<verse eid="JHN 17:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 17:13"/>"Ede bi chii hhende echine. Bi duyade bikudeni mii bayasukughala hhelai bayasughane giezhi enezighan kielienlai kieliewo. <verse eid="JHN 17:13"/><verse number="14" style="v" sid="JHN 17:14"/>Bi chii kielienyi hhelade ogidene duya hhelai henjiwo. Ene yenyinshi bi duyanughun pusho mutun hhelashiye duyanughun pusho. <verse eid="JHN 17:14"/><verse number="15" style="v" sid="JHN 17:15"/>Hhelai, 'Duyase khizhegha!' giezhi bi chii xiahua ulie giene, 'Hhe doghunnise baohu!' gie giezhi xiahua giene. <verse eid="JHN 17:15"/><verse number="16" style="v" sid="JHN 17:16"/>Bi duyanughun pusho mutun hhelaye duyanughun pusho. <verse eid="JHN 17:16"/><verse number="17" style="v" sid="JHN 17:17"/>Zhendaoghala zuise hhelai zhiguishigha. Chii kielienshijiu zhendao wo. <verse eid="JHN 17:17"/><verse number="18" style="v" sid="JHN 17:18"/>Chi mii duyade peizhi ireghasan mutun bi hhelaiye qingiezhi duyade peizhi echighane. <verse eid="JHN 17:18"/><verse number="19" style="v" sid="JHN 17:19"/>Bi hhelade oluzhi goyane zhiguishighawo. Ingiese hhelaiye zhendaoi tungo giezhi zhiguishighane."<verse eid="JHN 17:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20"/>"Bi zinie enelade oluzhi onxian gieku pusho. Hhelai kielienyi chenliedene mii xianxin giesan kunladeye onxian giezho. <verse eid="JHN 17:20"/><verse number="21" style="v" sid="JHN 17:21"/>Bi onxian giese Ada mii sudoro wo, bi chii sudoro biku mutun, hhelaye matanyi sudoro nie gholu gie. Ingiese duyai kunlai chi mii peizhi ireghasanyi xianxin giegha."<verse eid="JHN 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 17:22"/>"Chi made ogisan famani bi hhelade ogiwo. Ingiese hhelai matan mutun nie gholughane. <verse eid="JHN 17:22"/><verse number="23" style="v" sid="JHN 17:23"/>Bi hhelai sudoro wo, Chi mii sudoro wo, hhelai man nie gholughane. Ingiese duyai kunlai chi mii peizhi ireghasanyi, pse chi made oresan mutun hhelade oresanyi mejieghane. <verse eid="JHN 17:23"/><verse number="24" style="v" sid="JHN 17:24"/>Ada, chi made ogisan hhela bi khalashi khala bizhi mii famani hhelade uzhegha. Ene mienzishi duyai zhayaghaku melie chi made orezhi ogisan wo."<verse eid="JHN 17:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 17:25"/>"Gundantu Ada, duyai kunla chii tani dane. Bi chii tanine. Enezighan tujila chi mii peizhi ireghasanyi mejiene. <verse eid="JHN 17:25"/><verse number="26" style="v" sid="JHN 17:26"/>Bi hhelade chii mejieghawo, izhi mejieghane. Ingiese chi made oresan hhelai sudoro wo, biye hhelai sudoro wo."<verse eid="JHN 17:26"/></para>
  <chapter eid="JHN 17"/>
  <chapter number="18" style="c" sid="JHN 18"/>
  <para style="s">Ersani Bareizho</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mat 26:47-56</ref>; <ref loc="MRK 14:43-50">Mak 14:43-50</ref>; <ref loc="LUK 22:47-53">Luj 22:47-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1"/>
    <char style="pn">Ersa</char> enezighan kielienyi kieliedene tujilarene hhantu khizhi echiwo. Hhela <char style="png">Jilun</char> ghonni daodene nie yenzide orowo. <verse eid="JHN 18:1"/><verse number="2" style="v" sid="JHN 18:2"/><char style="pn">Ersa</char> tujilarene chan hhe nie oronde hhantulazho. <char style="pn">Ersa</char>i ghudandusan <char style="pn">Yuda</char>ye hhe oronyi mejiene. <verse eid="JHN 18:2"/><verse number="3" style="v" sid="JHN 18:3"/><char style="pn">Yuda</char> idaban <char style="png">Loma</char> buduilai uduruzhi hhende irewo. Fugie buwa, Falisai kunla peisan mechini sagheisan kunlaye hhantu irezho. Hhela denlun, hoba, uqilai bareizho. <verse eid="JHN 18:3"/><verse number="4" style="v" sid="JHN 18:4"/><char style="pn">Ersa</char> goyadene yan wilie kuzhekui man mejiene. Ingie khizhedene hhelade kieliewo, "Ta kienyi ereizho?" <verse eid="JHN 18:4"/><verse number="5" style="v" sid="JHN 18:5"/>Hhela kieliewo, "<char style="png">Nasale</char> kun <char style="pn">Ersa</char>i ereizho." <char style="pn">Ersa</char> kieliewo, "Bi enbene." <char style="pn">Ersa</char>i ghudandusan <char style="pn">Yuda</char>ye hhelare hhantu beizho. <verse eid="JHN 18:5"/><verse number="6" style="v" sid="JHN 18:6"/><char style="pn">Ersa</char> "Bi enbene." giezhi kieliekude hhela khuina tuidene zemin jiere unawo. <verse eid="JHN 18:6"/><verse number="7" style="v" sid="JHN 18:7"/><char style="pn">Ersa</char> pse hhelade asawo, "Ta kienyi ereizho?" Hhela kieliewo, "<char style="png">Nasale</char> kun <char style="pn">Ersa</char>i ereizho." <verse eid="JHN 18:7"/><verse number="8" style="v" sid="JHN 18:8"/><char style="pn">Ersa</char> kieliewo, "Bi enbene giezhi tande kieliewo. Ta mini ereizhoshi enelai yolagha." <verse eid="JHN 18:8"/><verse number="9" style="v" sid="JHN 18:9"/>Eneshi chi made ogisan kunlai bi nieda ese widaghawo giesan <char style="pn">Ersa</char> melieshi kieliesan kielien mutun gholuwo.<verse eid="JHN 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10"/>Ingiekude <char style="pn">Ximun-Beduru</char> nie khudogho bareizho. Lai khizhe zui fugie buwai hojii borun chighinyi chizhi agiwo. Hhe hojini nierei <char style="pn">Malegu</char> giene. <verse eid="JHN 18:10"/><verse number="11" style="v" sid="JHN 18:11"/><char style="pn">Ersa</char> <char style="pn">Beduru</char>de kieliewo, "Khudoghone xiuzide orogha. Adami made ogisan ene kuni bi ulie shouise olunu?"<verse eid="JHN 18:11"/></para>
  <para style="s">Ersani Bareizhi Yanasini Melie Echizho</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12"/>Ingiese budui, qienfuzhan, <char style="png">Yutai</char> kunni mechini sagheisan kunla <char style="pn">Ersa</char>i barei banladene <verse eid="JHN 18:12"/><verse number="13" style="v" sid="JHN 18:13"/><char style="pn">Yanasi</char>i melie xien lai echighawo. <char style="pn">Yanasi</char>shi hhe niehonyi zui fugie buwa danlasan <char style="pn">Gaiyafa</char>ni ghadun wo. <verse eid="JHN 18:13"/><verse number="14" style="v" sid="JHN 18:14"/>Ene <char style="pn">Gaiyafa</char>shi melieshi <char style="png">Yutai</char> kunlade ijien qilazhi "Nie kun bexinlade oluzhi fuguse haochu wine." giezhi kieliesan hhe kun wo.<verse eid="JHN 18:14"/></para>
  <para style="s">Beduru Ersani Ese Renjizho</para>
  <para style="r">(<ref loc="MAT 26:69-70">Mat 26:69-70</ref>; <ref loc="MRK 14:66-68">Mak 14:66-68</ref>; <ref loc="LUK 22:55-57">Luj 22:55-57</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15"/>
    <char style="pn">Ximun-Beduru</char> da nie tujighala <char style="pn">Ersa</char>i daghazho. Hhe tuji zui fugie buwai tanine. Ingiese daghazhi zui fugie buwai ghoronde orowo. <verse eid="JHN 18:15"/><verse number="16" style="v" sid="JHN 18:16"/><char style="pn">Beduru</char> damen ghadane beizho. Zui fugie buwai taniku hhe tuji khizhe damen sagheisan oqinde nie kieliese <char style="pn">Beduru</char>i oroghawo. <verse eid="JHN 18:16"/><verse number="17" style="v" sid="JHN 18:17"/>Wijien sagheisan hoji oqin <char style="pn">Beduru</char>de kieliewo, "Chiye hhei tuji pushonu?" <char style="pn">Beduru</char> kieliewo, "Pusho."<verse eid="JHN 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18"/>Hhe xienzide qienqi kuiqienshi hoji, mechini sagheisan kunla hhantu khan teidene beizhi kouizho. <char style="pn">Beduru</char>ye hhelare hhantu beidene kouizho.<verse eid="JHN 18:18"/></para>
  <para style="s">Zui Fugie Buwa Ersani Shenwun Giezho</para>
  <para style="r">(<ref loc="MAT 26:59-66">Mat 26:59-66</ref>; <ref loc="MRK 14:55-64">Mak 14:55-64</ref>; <ref loc="LUK 22:66-71">Luj 22:66-71</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19"/>Ingiese zui fugie buwa <char style="pn">Ersa</char>de tujilaini, sughasanlaini shenwun giezho. <verse eid="JHN 18:19"/><verse number="20" style="v" sid="JHN 18:20"/><char style="pn">Ersa</char> kieliewo, "Bi kunlade mindaminji kieliezho. Bi chan huitande, mechide kunlade surughazho. Bi ghulazhi yama ese kieliezho. <verse eid="JHN 18:20"/><verse number="21" style="v" sid="JHN 18:21"/>Chi made yangiezhi asane? Asase chenliesan kunlade asale echi. Bi yan kieliesanyi hhela man mejiene." <verse eid="JHN 18:21"/><verse number="22" style="v" sid="JHN 18:22"/><char style="pn">Ersa</char> ene kielienyi kieliese shidani beisan nie mechini sagheisan kun khaghalane <char style="pn">Ersa</char>i eghizhi kieliewo, "Chi zui fugie buwade imutu kielien kielienu?" <verse eid="JHN 18:22"/><verse number="23" style="v" sid="JHN 18:23"/><char style="pn">Ersa</char> kieliewo, "Bi kieliesan ese oluse chi kieliezhi mejiegha. Bi kieliesan oluzhoshi chi mini yangiezhi eghizho?" <verse eid="JHN 18:23"/><verse number="24" style="v" sid="JHN 18:24"/>Ingiese <char style="pn">Yanasi</char> <char style="pn">Ersa</char>i banlaghadene zui fugie buwa <char style="pn">Gaiyafa</char>i hhende echighawo.<verse eid="JHN 18:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25"/>
    <char style="pn">Ximun-Beduru</char> zhen beizhi khan xiekude nie kun hhende kieliewo, "Chiye hhei tuji pushonu?" <char style="pn">Beduru</char> bi pusho giezhi ese renjiwo. <verse eid="JHN 18:25"/><verse number="26" style="v" sid="JHN 18:26"/>Da nie zui fugie buwai hojishi <char style="pn">Beduru</char> chighinyini chizhi bouzheghasan hhei qingu wo. Hhe kieliewo, "Bi chii <char style="pn">Ersa</char>re hhantu yenzide bisei ese chanlawu?" <verse eid="JHN 18:26"/><verse number="27" style="v" sid="JHN 18:27"/><char style="pn">Beduru</char> pse ese renjiwo. Deigo tigha kheilawo.<verse eid="JHN 18:27"/></para>
  <para style="s">Bilado Ersani Panjizho</para>
  <para style="r">(<ref loc="MAT 27:1-2">Mat 27:1-2</ref>, <ref loc="MAT 27:11-14">11-14</ref>; <ref loc="MRK 15:1-5">Mak 15:1-5</ref>; <ref loc="LUK 23:1-5">Luj 23:1-5</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28"/>Eqiemagha eqie <char style="pn">Ersa</char>i <char style="pn">Gaiyafa</char>i hhense <char style="png">Loma</char> kunyi shenzhanfude echighawo. Hhela goyane shenzhanfude ese orowo. Orose zannantukuse ayizho. Jiulidaosan Jieni xini ijie dane. <verse eid="JHN 18:28"/><verse number="29" style="v" sid="JHN 18:29"/><char style="pn">Bilado</char> khizhedene hhelade kieliewo, "Ta ene kunyi yan shiqinde zhazho?" <verse eid="JHN 18:29"/><verse number="30" style="v" sid="JHN 18:30"/>Hhela kieliewo, "Ene kun zui ulie fanjise bijien chade ulie ireghane." <verse eid="JHN 18:30"/><verse number="31" style="v" sid="JHN 18:31"/><char style="pn">Bilado</char> kieliewo, "Ta hhei uduru echi. Zhao goyane guijinghala panji." <char style="png">Yutai</char> kunla kieliewo, "Bijiende kun alaku qienli uwo." <verse eid="JHN 18:31"/><verse number="32" style="v" sid="JHN 18:32"/>Eneshi <char style="pn">Ersa</char> melieshida goyane matui fugukune kieliesan kielien mutun gholuwo.<verse eid="JHN 18:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33"/>
    <char style="pn">Bilado</char> pse shenzhanfude orodene <char style="pn">Ersa</char>i uru ire hhende asawo, "Chishi <char style="png">Yutai</char> kunni honshan onu?" <verse eid="JHN 18:33"/><verse number="34" style="v" sid="JHN 18:34"/><char style="pn">Ersa</char> kieliewo, "Ene kielienshi chi goyane kieliesan onu, kunla mii kieliesan wo?" <verse eid="JHN 18:34"/><verse number="35" style="v" sid="JHN 18:35"/><char style="pn">Bilado</char> kieliewo, "Chi sumulase bishi <char style="png">Yutai</char> kun wo giezhou? Tai gojiai kunla, fugie buwala chii made jiuizhi ogizho. Chi yan giewo?" <verse eid="JHN 18:35"/><verse number="36" style="v" sid="JHN 18:36"/><char style="pn">Ersa</char> kieliewo, "Mini gojiashi ene duyaghun pusho. Mini gojia ene duyaghunshi mini hojila made oluzhi zhan eghizhi mii <char style="png">Yutai</char> kunlade jiuizhi ulie ogine. Mini gojiashi ene duyaghun pusho." <verse eid="JHN 18:36"/><verse number="37" style="v" sid="JHN 18:37"/><char style="pn">Bilado</char> hhende kieliewo, "Ingiese chishi honshan onu?"</para>
  <para style="p" vid="JHN 18:37">
    <char style="pn">Ersa</char> kieliewo, "Bishi honshan wo giezhi chi kieliezho. Mii oluzhi duyade iresanshi zhendaode ganzhen beine giezho. Zhendaode beisan kunla mini kielienyi chenliene." <verse eid="JHN 18:37"/><verse number="38" style="v" sid="JHN 18:38"/><char style="pn">Bilado</char> kieliewo, "Zhendaoshi yan wo?" Ene kielienyi kieliedene pse khizhesenu <char style="png">Yutai</char> kunlai hhende echi kieliewo, "Bi hhei zuini chaizhi khizhe dawo. <verse eid="JHN 18:38"/><verse number="39" style="v" sid="JHN 18:39"/>Tai nie xigonshi Jiulidaosan Jiede bi nie kun andaghane. Tande <char style="png">Yutai</char> kunni honshanyi tei giezhou?" <verse eid="JHN 18:39"/><verse number="40" style="v" sid="JHN 18:40"/>Ingiese hhela pse waradazhi kieliewo, "Bijien ene kunyi ulie kerene! <char style="pn">Balaba</char>i kerene!" <char style="pn">Balaba</char>shi nie panlon giesan kun wo.<verse eid="JHN 18:40"/></para>
  <chapter eid="JHN 18"/>
  <chapter number="19" style="c" sid="JHN 19"/>
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1"/>Ingiedene <char style="pn">Bilado</char> mabienzighala <char style="pn">Ersa</char>i eghighawo. <verse eid="JHN 19:1"/><verse number="2" style="v" sid="JHN 19:2"/>Buduila eghesunyi maghala onjidene qiorun jierei zhoghazhi zishei fudu jienyi musighawo. <verse eid="JHN 19:2"/><verse number="3" style="v" sid="JHN 19:3"/>Ingie shidani echi kieliewo, "<char style="png">Yutai</char> kunni honshan, onsui!" Ingiedene khaghalane eghizho. <verse eid="JHN 19:3"/><verse number="4" style="v" sid="JHN 19:4"/><char style="pn">Bilado</char> pse khizhedene bexinlade kieliewo, "Uzhe, bi hhei uduruzhi tai melie khizheghaye. Bi hhense yama zui chaizhi khizhe dasei ta mejiendu." <verse eid="JHN 19:4"/><verse number="5" style="v" sid="JHN 19:5"/>Ingiese <char style="pn">Ersa</char> khizhewo. Eghesun maghala zhozho. Zishei fudu jien musizho. <char style="pn">Bilado</char> hhelade kieliewo, "Uzhe, ene kun wo." <verse eid="JHN 19:5"/><verse number="6" style="v" sid="JHN 19:6"/>Fugie buwa, mechini sagheisan kunla hhei chanlasenu waradazhi kieliewo, "Hhei shizijia jiere ghada! Shizijia jiere ghada!" Ingiese <char style="pn">Bilado</char> kieliewo, "Ta goyalane hhei shizijia jiere ghadale echi. Bi hhei zuiini chaizhi khizhe dawo."<verse eid="JHN 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7"/>Ingiese <char style="png">Yutai</char> kunla kieliewo, "Bijiende guijin wine. Zhao guijin mutunshi hhe fugukuni wo. Hhe goyane Hudai kewon wo giezho." <verse eid="JHN 19:7"/><verse number="8" style="v" sid="JHN 19:8"/><char style="pn">Bilado</char> ene kielienyi sonosudene genjia ayizho. <verse eid="JHN 19:8"/><verse number="9" style="v" sid="JHN 19:9"/>Ingie shenzhanfude orosenu <char style="pn">Ersa</char>de asawo, "Chishi khalase iresan wo?" <char style="pn">Ersa</char> yama huida ese giewo. <verse eid="JHN 19:9"/><verse number="10" style="v" sid="JHN 19:10"/><char style="pn">Bilado</char> kieliewo, "Chi made kielien ulie kielienu? Made chii andaghaku, shizijia jiere ghadaku qienli bikui chi ulie mejienu?"<verse eid="JHN 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11"/>
    <char style="pn">Ersa</char> kieliewo, "Asiman jierese chade qienli ese ogizhoshi chi mii yama gie dane. Ingiese mii chade jiuisan hhe kunde zui pse gundu wo."<verse eid="JHN 19:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12"/>Enense khuinashi <char style="pn">Bilado</char> <char style="pn">Ersa</char>i andaghane giezho. <char style="png">Yutai</char> kunla waradazhi kieliewo, "Chi ene kunyi andaghase <char style="pn">Kaisa</char> honshanni goude ese zunjizho. Kien goyane honshan giezhi kieliese <char style="pn">Kaisa</char> honshanyi ghudanduwo giezho."<verse eid="JHN 19:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13"/>
    <char style="pn">Bilado</char> ene kielienyi sonosudene <char style="pn">Ersa</char>i laizhi khizhesenu shenpantai jiere souwo. Sousan hhe oronyi Puisan Tashi giene. <char style="png">Xibolai</char> kielienghala <char style="png">Jiabada</char> giene. <verse eid="JHN 19:13"/><verse number="14" style="v" sid="JHN 19:14"/>Hhe niudushi Jiulidaosan Jieni zhunbei giesan uduni udukun xienzi wo. <char style="pn">Bilado</char> <char style="png">Yutai</char> kunlade kieliewo. "Uzhe, eneshi tai honshan wo." <verse eid="JHN 19:14"/><verse number="15" style="v" sid="JHN 19:15"/>Hhela waradazhi kieliewo, "Hhei widagha! Hhei widagha! Shizijia jiere ghada!"</para>
  <para style="p" vid="JHN 19:15">
    <char style="pn">Bilado</char> kieliewo, "Bi tai honshanyi shizijia jiere ghadase olunu?"</para>
  <para style="p" vid="JHN 19:15">Fugie buwala kieliewo, "<char style="pn">Kaisa</char> honshanse andase bijiende honshan uwo." <verse eid="JHN 19:15"/><verse number="16" style="v" sid="JHN 19:16"/>Ingiese <char style="pn">Bilado</char> <char style="pn">Ersa</char>i hhelade jiuizhi shizijia jiere ghada giewo. Hhela <char style="pn">Ersa</char>i laidene echiwo.<verse eid="JHN 19:16"/></para>
  <para style="s">Ersani Shizijia Jiere Ghadazho</para>
  <para style="r">(<ref loc="MAT 27:32-44">Mat 27:32-44</ref>; <ref loc="MRK 15:21-32">Mak 15:21-32</ref>; <ref loc="LUK 23:26-43">Luj 23:26-43</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 19:17"/>
    <char style="pn">Ersa</char> goyane shizijiai beiliezhi khizhedene qiorun yasun oron giezhi urusan nie oronde echiwo. <char style="png">Xibolai</char> kielienghala kieliese <char style="png">Gegeta</char> giene. <verse eid="JHN 19:17"/><verse number="18" style="v" sid="JHN 19:18"/>Hhende <char style="pn">Ersa</char>i shizijia jiere ghadawo. Da ghua kunyi niemiendei nie ghadawo. <char style="pn">Ersa</char> dunda wo. <verse eid="JHN 19:18"/><verse number="19" style="v" sid="JHN 19:19"/><char style="pn">Bilado</char> nie peizi huaidene shizijia jiere guaighawo. Huaisanshi <char style="png">Nasale</char> kun <char style="pn">Ersa</char> <char style="png">Yutai</char> kunni honshan giezho. <verse eid="JHN 19:19"/><verse number="20" style="v" sid="JHN 19:20"/><char style="pn">Ersa</char>i ghadasan oron chenshise gholo uwo. Peizi jiere huaisanshi <char style="png">Xibolai</char>, <char style="png">Loma</char>, <char style="png">Xila</char>ni uroughala huaizho. Ingiese olon <char style="png">Yutai</char> kunla peizi jiere huaisei onshizho. <verse eid="JHN 19:20"/><verse number="21" style="v" sid="JHN 19:21"/><char style="png">Yutai</char> kunni fugie buwala <char style="pn">Bilado</char>de kieliewo, "'<char style="png">Yutai</char> kunni honshan' giezhi bu huai. Huaise, 'Ene kun goya bishi <char style="png">Yutai</char> kunni honshan wo giezho.' giezhi huai." <verse eid="JHN 19:21"/><verse number="22" style="v" sid="JHN 19:22"/>Ingiese <char style="pn">Bilado</char> kieliewo, "Bi huaikune huai baraghawo."<verse eid="JHN 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23"/>Buduila <char style="pn">Ersa</char>i shizijia jiere ghadasenu jienyini agi bouzhe jieran gholughadene nie kunde nie ghughawo. Pse sudorodu jienyini agise hhe jiendeni hudusan oron uwo. Jiere dourashi hulun giesan wo. <verse eid="JHN 19:23"/><verse number="24" style="v" sid="JHN 19:24"/>Hhela nieniedene kieliewo, "Matan sidazhi bu keighaye. Kiende irekui matan fendan qianguye." Ingiedene jinwun jieredu kielien mutun gholuwo,</para>
  <para style="q1" vid="JHN 19:24">"Hhela mini jienni ghughane.</para>
  <para style="q2" vid="JHN 19:24">Mii sudorodu jienni fendan qiangune."</para>
  <para style="m" vid="JHN 19:24">Buduila zhenzhenji ingiezhi giewo. <verse eid="JHN 19:24"/><verse number="25" style="v" sid="JHN 19:25"/><char style="pn">Ersa</char>i shizijia shida beisan kun dunda <char style="pn">Ersa</char>i anani, inianni, <char style="pn">Geloba</char>ni bierei <char style="pn">Mereiyen</char>, <char style="png">Modala</char>ni <char style="pn">Mereiyen</char> wine.<verse eid="JHN 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 19:26"/>
    <char style="pn">Ersa</char> anani, oresan tujini kanzide beisanyi chanladene anadene kieliewo, "Ana, eneshi chii kewon wo." <verse eid="JHN 19:26"/><verse number="27" style="v" sid="JHN 19:27"/>Pse hhe tujidene kieliewo, "Uzhe, eneshi chii ana wo!" Enense khuinashi hhe tuji anaini jienliezhi giedene echiwo.<verse eid="JHN 19:27"/></para>
  <para style="s">Ersa Duya Ijiezho</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mat 27:45-56</ref>; <ref loc="MRK 15:33-41">Mak 15:33-41</ref>; <ref loc="LUK 23:44-49">Luj 23:44-49</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28"/>Enense khuinashi <char style="pn">Ersa</char> shiqinlane gie baraghasanyi mejiedene jinwun jieredu kielienyi gholughane giezhi kieliewo, "Bi undasuzho." <verse eid="JHN 19:28"/><verse number="29" style="v" sid="JHN 19:29"/>Cui zhonlozhi durughasan tantanyi hhende jiezho. Hhela haimienni cude zhanjidene osun gangan jiere banla, amandeni echighawo. <verse eid="JHN 19:29"/><verse number="30" style="v" sid="JHN 19:30"/>Ingiese <char style="pn">Ersa</char> cui ochidene kieliewo, "Chenjiwo!" Ingiedene qiorunne ghodeise ho sirawo.<verse eid="JHN 19:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31"/>Ene udushi <char style="png">Yutai</char> kunla hhamuraku udude zhunbei gieku udu wo. Pse ene faku hhamuraku udushi nie fugie udu wo. Ingiese <char style="png">Yutai</char> kunla <char style="pn">Bilado</char>i xiahua giezhi hhelai shigharai<note caller="+" style="f"><char style="fr">19:31</char> <char style="ft" closed="false">Hhelai ghujighan fugughane giezhi shigharai ghuraghawo. </char></note> eghizhi ghuraghadene agi widagha giezho. Hhamuraku udude fugusan kunyi shizijia jiere jiese gou uwo giezho. <verse eid="JHN 19:31"/><verse number="32" style="v" sid="JHN 19:32"/>Ingiese buduila iredene <char style="pn">Ersa</char>re hhantu ghadasan hhe ghua kunyi shigharai eghizhi ghuraghawo. <verse eid="JHN 19:32"/><verse number="33" style="v" sid="JHN 19:33"/>Ingie <char style="pn">Ersa</char>i shida ire nie uzhese hhe duya ijiezho. Hhei shigharaini eghizhi uye ghuraghawo. <verse eid="JHN 19:33"/><verse number="34" style="v" sid="JHN 19:34"/>Ingiese niekozi budui zhidaghala leibadeni nie chujise chusun, usu usuru khizhewo. <verse eid="JHN 19:34"/><verse number="35" style="v" sid="JHN 19:35"/>Ene shiqinyi qinsi uzhesan kun ganzhen beizhi tai xianxin gieghane giezho. Hhe beisan ganzhenshi zhenni wo. Goyane kieliesanshi zhenni bikui mejiene. <verse eid="JHN 19:35"/><verse number="36" style="v" sid="JHN 19:36"/>Ene shiqinla fashen giekushi jinwun jieredu kielienyi gholughane giezho, "Hhei yasun nieda ulie ghurane." <verse eid="JHN 19:36"/><verse number="37" style="v" sid="JHN 19:37"/>Dou nie jinwun jiere kieliezho, "Hhela goya chujisan kunne uzhene."<verse eid="JHN 19:37"/></para>
  <para style="s">Ersai Bulazho</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mat 27:57-61</ref>; <ref loc="MRK 15:42-47">Mak 15:42-47</ref>; <ref loc="LUK 23:50-56">Luj 23:50-56</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38"/>Enense khuinashi <char style="pn">Ersa</char>ni nie tuji <char style="png">Yalimatai</char> kun <char style="pn">Yusufu</char> giene. Hhe <char style="png">Yutai</char> kunlase ayise ghulazhi tuji danlazho. Hhe <char style="pn">Bilado</char>i xiahua giezhi <char style="pn">Ersa</char>i beyei kerezho. <char style="pn">Bilado</char> tunyi oluse <char style="pn">Ersa</char>i beyeni agi echiwo. <verse eid="JHN 19:38"/><verse number="39" style="v" sid="JHN 19:39"/>Melieshi xienidei <char style="pn">Ersa</char>i ochirale iresan <char style="pn">Nigedemu</char>ye huighasan guizhuntu caoye, luhuini 65 jin bareizhi irewo. <verse eid="JHN 19:39"/><verse number="40" style="v" sid="JHN 19:40"/>Hhela zhao <char style="png">Yutai</char> kunni bulaku xigonghala <char style="pn">Ersa</char>i beyeni bosi xianshuighala boui goudaghawo. <verse eid="JHN 19:40"/><verse number="41" style="v" sid="JHN 19:41"/><char style="pn">Ersa</char>i shizijia jiere ghadasan oronde nie yenzi wine. Yenzide nie shini alimatu meza wine. Kun teizhi uye daozho. <verse eid="JHN 19:41"/><verse number="42" style="v" sid="JHN 19:42"/>Hhe niudushi <char style="png">Yutai</char> kunlai zhunbei gieku udu wo. Pse hhe meza chadashi hhela <char style="pn">Ersa</char>i hhende bulawo.<verse eid="JHN 19:42"/></para>
  <chapter eid="JHN 19"/>
  <chapter number="20" style="c" sid="JHN 20"/>
  <para style="s">Ersa Aminne Oluzho</para>
  <para style="r">(<ref loc="MAT 28:1-8">Mat 28:1-8</ref>; <ref loc="MRK 16:1-8">Mak 16:1-8</ref>; <ref loc="LUK 24:1-12">Luj 24:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1"/>Xinqini eqiemagha udu da khara bikude <char style="png">Modala</char>ni <char style="pn">Mereiyen</char> mezade irewo. Nie uzhese tashi meza kouzise noi daozho. <verse eid="JHN 20:1"/><verse number="2" style="v" sid="JHN 20:2"/>Ingie holuzhi echidene <char style="pn">Ximun-Beduru</char>, <char style="pn">Ersa</char> oresan tujide kieliewo, "Kunla mezase Ezhanni agi echizho. Khala jiesanyi ulie mejiene." <verse eid="JHN 20:2"/><verse number="3" style="v" sid="JHN 20:3"/>Ingiese <char style="pn">Beduru</char> hhe tujighala khizhe mezai hhende echiwo. <verse eid="JHN 20:3"/><verse number="4" style="v" sid="JHN 20:4"/>Hhe ghuala hhantu holuzho. Hhe tuji <char style="pn">Beduru</char>se holuzhi ghujinshi xien mezade kuruwo. <verse eid="JHN 20:4"/><verse number="5" style="v" sid="JHN 20:5"/>Ghodeidene sudoro nie uzhese bosii hhende jiesanyi chanlawoma, orozhi ese echiwo. <verse eid="JHN 20:5"/><verse number="6" style="v" sid="JHN 20:6"/>Ingie <char style="pn">Ximun-Beduru</char> khuinasei kuzhi ire mezade orowo. Bosini hhende jiesanyi chanlawo. <verse eid="JHN 20:6"/><verse number="7" style="v" sid="JHN 20:7"/>Pse <char style="pn">Ersa</char>i qiorunni huisan toujin bosighala hhantu ese jiezhi niemiende horo jiesei chanlawo. <verse eid="JHN 20:7"/><verse number="8" style="v" sid="JHN 20:8"/>Ingiedene melieshi kuzhi iresan hhe tujiye mezade orozhi echi uzhedene xianxin giewo. <verse eid="JHN 20:8"/><verse number="9" style="v" sid="JHN 20:9"/>Hhela <char style="pn">Ersa</char> fugusan kun dundase aminne olune giesan jinwun jieredu ene kielienyini dunjire dazho. <verse eid="JHN 20:9"/><verse number="10" style="v" sid="JHN 20:10"/>Ingiedene ghua tujila sousan orondene echiwo.<verse eid="JHN 20:10"/></para>
  <para style="s">Modalani Mereiyende Chujiegheghazho</para>
  <para style="r">(<ref loc="MAT 28:9-10">Mat 28:9-10</ref>; <ref loc="MRK 16:9-11">Mak 16:9-11</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11"/>
    <char style="pn">Mereiyen</char> meza ghadane beizhi wilazho. Wilakudeni ghodei mezade nie uzhese <verse eid="JHN 20:11"/><verse number="12" style="v" sid="JHN 20:12"/>ghua chighan jien musisan qienxienyi chanlawo. <char style="pn">Ersa</char>i teisan oronde souzho. Nie qiorun konde wo, nie kon konde wo. <verse eid="JHN 20:12"/><verse number="13" style="v" sid="JHN 20:13"/>Hhela <char style="pn">Mereiyen</char>de asawo, "Funi, chi yangiezhi wilazho?" Hhe kieliewo, "Kunla mii Ezhanyi agi echizho, khala jiesei ulie mejiene." <verse eid="JHN 20:13"/><verse number="14" style="v" sid="JHN 20:14"/>Ene kielienyi kieliesenu ochira daozhese <char style="pn">Ersa</char> hhende beisei chanlawoma, <char style="pn">Ersa</char> bikui ulie mejiene. <verse eid="JHN 20:14"/><verse number="15" style="v" sid="JHN 20:15"/><char style="pn">Ersa</char> hhende kieliewo, "Funi, chi yangiezhi wilazho? Kienyi ereizho?" <char style="pn">Mereiyen</char> <char style="pn">Ersa</char>i yenzi sagheisan kun wo giezhi asawo, "Gujiu, chi hhei noighazhi khala jiezhoshi made kielie. Bi agile echiye." <verse eid="JHN 20:15"/><verse number="16" style="v" sid="JHN 20:16"/><char style="pn">Ersa</char> kieliewo, "<char style="pn">Mereiyen</char>!" <char style="pn">Mereiyen</char> ochiradene <char style="png">Xibolai</char> kielienghala hhende kieliewo, "Laboni!" Labonii isishi 'loushi' wo. <verse eid="JHN 20:16"/><verse number="17" style="v" sid="JHN 20:17"/><char style="pn">Ersa</char> kieliewo, "Chi mii bu barei. Bi da adane hhende ese khireizho. Chi echidene mii gaijiulade bi adane hhende khireine giezhi kielie. Hheshi tai adaye enbene, mii Huda wo, tai Hudaye enbene." <verse eid="JHN 20:17"/><verse number="18" style="v" sid="JHN 20:18"/><char style="png">Modala</char>ni <char style="pn">Mereiyen</char> echidene tujilade kieliewo, "Bi Ezhanyi chujieghewo!" Pse Ezhan hhende kieliesan kielienlai hhelade kieliewo.<verse eid="JHN 20:18"/></para>
  <para style="s">Tujiladene Chujiegheghazho</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mat 28:16-20</ref>; <ref loc="MRK 16:14-18">Mak 16:14-18</ref>; <ref loc="LUK 24:36-49">Luj 24:36-49</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19"/>Xinqini yen hhe uduni xienidei tujila hhantulasan oronde <char style="png">Yutai</char> kunlase ayise wijienlane khazho. <char style="pn">Ersa</char> hhelai dunda ire beizhi kieliewo, "Ta pinnan onu?" <verse eid="JHN 20:19"/><verse number="20" style="v" sid="JHN 20:20"/>Ene kielienyi kieliesenu hhelade kha, leibane uzheghawo. Tujila Ezhanyi chanladene bayasuzho. <verse eid="JHN 20:20"/><verse number="21" style="v" sid="JHN 20:21"/>Ingie <char style="pn">Ersa</char> pse hhelade kieliewo, "Ta pinnan onu? Adami mii peisan mutun biye tai peine." <verse eid="JHN 20:21"/><verse number="22" style="v" sid="JHN 20:22"/>Ene kielienyi kieliedene hhelade nie feiliesenu kieliewo, "Ta Shenlinyi jienliendu. <verse eid="JHN 20:22"/><verse number="23" style="v" sid="JHN 20:23"/>Ta kienyi zuini mienliese kienyi zui widane, kienyi zuini ulie mienliese kienyi zui ulie widane."<verse eid="JHN 20:23"/></para>
  <para style="s">Domade Chujiegheghazho</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24"/>12 gie tuji dundadu Shongo giezhi urusan <char style="pn">Doma</char> <char style="pn">Ersa</char> irekudeni hhelare hhantu uwo. <verse eid="JHN 20:24"/><verse number="25" style="v" sid="JHN 20:25"/>Psedu tujila hhende kieliewo, "Bijien Ezhanyi chujieghewo!" <char style="pn">Doma</char> kieliewo, "Bi hhei kha jieredu ghadasan oronyini, leibade chujisan oronyini ulie uzhetula xianxin ulie giene."<verse eid="JHN 20:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26"/>Neimudu daodene hhei tujilani pse giedera hhantulazho. <char style="pn">Doma</char>ye hhelare hhantu wo. Wijienlai man khazhoma, <char style="pn">Ersa</char> iredene hhelai dunda beizhi kieliewo, "Ta pinnan onu?" <verse eid="JHN 20:26"/><verse number="27" style="v" sid="JHN 20:27"/>Ingie <char style="pn">Doma</char>de kieliewo, "Khaghurunne enende teizhi mii khai uzhe. Khane khizheghazhi mii leibai moizhi uzhe. Inxin bu gie, xianxin gie." <verse eid="JHN 20:27"/><verse number="28" style="v" sid="JHN 20:28"/><char style="pn">Doma</char> kieliewo, "Mii Ezhan, mii Huda!" <verse eid="JHN 20:28"/><verse number="29" style="v" sid="JHN 20:29"/><char style="pn">Ersa</char> kieliewo, "Chi mii uzhedene xianxin gienu? Ese uzhedene xianxin giesan kunlade fuqi wine."<verse eid="JHN 20:29"/></para>
  <para style="s">Ene Shuni Muji</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30"/>
    <char style="pn">Ersa</char> tujilai melie ene shu jiere uye jilasan ghudureqi da olon xienjighawoma, <verse eid="JHN 20:30"/><verse number="31" style="v" sid="JHN 20:31"/>enende jilasanlashi <char style="pn">Ersa</char>shi Hudai Kewon Mexiha bikui tai xianxin gieghane giezhi pse xianxin giedene hhei niereghala tande amin ireghane giezhi huaizho.<verse eid="JHN 20:31"/></para>
  <chapter eid="JHN 20"/>
  <chapter number="21" style="c" sid="JHN 21"/>
  <para style="s">Dolon Tujiladene Chujiegheghazho</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1"/>Ene shiqinse khuinashi <char style="pn">Ersa</char> <char style="png">Qibiliyahai</char> bienzide tujiladene pse chujiegheghawo. Hhe matugie chujiegheghasei doura huaizho. <verse eid="JHN 21:1"/><verse number="2" style="v" sid="JHN 21:2"/><char style="pn">Ximun-Beduru</char>, Shongo giezhi urusan <char style="pn">Doma</char>, <char style="png">Jialili</char>ni <char style="png">Jiana</char> kun <char style="pn">Nadanye</char>, <char style="pn">Xibitai</char>ni kewonla, pse ghua tuji enela man hhantu wo. <verse eid="JHN 21:2"/><verse number="3" style="v" sid="JHN 21:3"/><char style="pn">Ximun-Beduru</char> hhelade kieliewo, "Bi zhaghasun bareile echine." Hhela kieliewo. "Bijienye chare hhantu yoye." Hhela khizhi echisenu chon jiere khiwo. Hhe xii hhela yama barei dazho. <verse eid="JHN 21:3"/><verse number="4" style="v" sid="JHN 21:4"/>Ogheine giekude <char style="pn">Ersa</char> haibienzide beizho. Tujila hheshi <char style="pn">Ersa</char> bikui ulie mejiene. <verse eid="JHN 21:4"/><verse number="5" style="v" sid="JHN 21:5"/><char style="pn">Ersa</char> hhelade kieliewo, "Zhanlienla, ta zhaghasun bareiwoye?" Hhela kieliewo, "Uye." <verse eid="JHN 21:5"/><verse number="6" style="v" sid="JHN 21:6"/><char style="pn">Ersa</char> kieliewo, "Ta onni chonni borun miende teima, zhaghasun barei shidane." Ingiese hhela onni chonyi borun miende teiwo. Zhaghasun texien olon, laizhi khizhe dazho. <verse eid="JHN 21:6"/><verse number="7" style="v" sid="JHN 21:7"/><char style="pn">Ersa</char> oresan hhe nie tuji <char style="pn">Beduru</char>de kieliewo, "Hheshi Ezhan wo!" Hhe shihoude <char style="pn">Beduru</char> jien ese musizho. Ezhan wo giezhi nie sonosuse jienne pixilie hude jiuli bouwo. <verse eid="JHN 21:7"/><verse number="8" style="v" sid="JHN 21:8"/>Psedu tujila haibienzise gholo uwo, chabudu 100 mi wine. Chon jiere soudene nie on zhaghasunyi laizhi daozhewo. <verse eid="JHN 21:8"/><verse number="9" style="v" sid="JHN 21:9"/>Hhela bienzide khisenu nie duizi mutan khan chujieghewo. Khan jiere zhaghasun teizho, ginanye wine. <verse eid="JHN 21:9"/><verse number="10" style="v" sid="JHN 21:10"/><char style="pn">Ersa</char> hhelade kieliewo, "Ta jian bareisan zhaghasunsene giedun agi daozhe." <verse eid="JHN 21:10"/><verse number="11" style="v" sid="JHN 21:11"/><char style="pn">Ximun-Beduru</char> chon shida echidene onni laizhi bienzide khizheghawo. Onde fugie zhaghasun duruzho, 153 gie wine. Ingieliuzhe on ese tanturazho. <verse eid="JHN 21:11"/><verse number="12" style="v" sid="JHN 21:12"/><char style="pn">Ersa</char> kieliewo, "Ta yushe ijiele irendu." Tujila hheshi Ezhan bikui mejiedene chishi kien wo giezhi kiema asa dazho. <verse eid="JHN 21:12"/><verse number="13" style="v" sid="JHN 21:13"/><char style="pn">Ersa</char> ginanyi bareizhi hhelade ogiwo. Zhaghasunyiye ingiezhi hhelade ogiwo. <verse eid="JHN 21:13"/><verse number="14" style="v" sid="JHN 21:14"/>Eneshi <char style="pn">Ersa</char> fugusan kun dundase aminne olusenu tujiladene 3 hui chujiegheghasan wo.<verse eid="JHN 21:14"/></para>
  <para style="s">Bedurude Asazho</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15"/>Hhela yushe ijiedene <char style="pn">Ersa</char> <char style="pn">Ximun-Beduru</char>de asawo, "<char style="pn">Yaheiya</char>ni kewon <char style="pn">Ximun</char>, chi made oresan enelase hen onu?" <char style="pn">Beduru</char> kieliewo, "Ezhan, bi chade oresei chi mejiene." <char style="pn">Ersa</char> kieliewo, "Chi mii ga ghonilai chezhe." <verse eid="JHN 21:15"/><verse number="16" style="v" sid="JHN 21:16"/><char style="pn">Ersa</char> 2 hui hhende asawo, "<char style="pn">Yaheiya</char>ni kewon <char style="pn">Ximun</char>, chi made orezhoye?" <char style="pn">Beduru</char> kieliewo, "Ezhan, bi chade oresei chi mejiene." <char style="pn">Ersa</char> kieliewo, "Chi mii ghonilai adula." <verse eid="JHN 21:16"/><verse number="17" style="v" sid="JHN 21:17"/><char style="pn">Ersa</char> hhende 3 hui asawo, "<char style="pn">Yaheiya</char>ni kewon <char style="pn">Ximun</char>, chi made orezhoye?" <char style="pn">Ersa</char> <char style="pn">Beduru</char>de 3 hui orezhoye giezhi asase <char style="pn">Beduru</char> nango giezhi <char style="pn">Ersa</char>de kieliewo, "Ezhan, chi yanniliuzhe mejiene. Bi chade oresei chi mejiene." <char style="pn">Ersa</char> kieliewo, "Chi mii ghonilai chezhe. <verse eid="JHN 21:17"/><verse number="18" style="v" sid="JHN 21:18"/>Bi chade shuhuajia kielieye, chi nasuchighan bikude yodaine banlazhi khalabi khala echinema, oqioluse kunla chii khai banlazhi chi duran wiku oronde deila echine." <verse eid="JHN 21:18"/><verse number="19" style="v" sid="JHN 21:19"/><char style="pn">Ersa</char> ene kielienyi kieliekushi <char style="pn">Beduru</char> matugie fuguzhi Hudai kuaikui kieliezho. Ene kielienyi kieliesenu hhende kieliewo, "Chi mii dagha."<verse eid="JHN 21:19"/></para>
  <para style="s">Ersa Oresan Tujighalane</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20"/>
    <char style="pn">Beduru</char> ochira daozhese <char style="pn">Ersa</char> oresan hhe tuji daghasei chujieghewo. Ene tujishi heifan ijiekude <char style="pn">Ersa</char>i kanzii shighazhi, "Ezhan, chii ghudandukushi kien wo?" giezhi asasan hhe wo. <verse eid="JHN 21:20"/><verse number="21" style="v" sid="JHN 21:21"/><char style="pn">Beduru</char> hhei chujieghedene <char style="pn">Ersa</char>de asawo, "Ezhan, ene kun jianlai matui gholune?" <verse eid="JHN 21:21"/><verse number="22" style="v" sid="JHN 21:22"/><char style="pn">Ersa</char> hhende kieliewo, "Bi hhei ulie fugughazhi bi pse ireku shihou oluliuzhe chare yan xiangan wo? Chi mini dagha." <verse eid="JHN 21:22"/><verse number="23" style="v" sid="JHN 21:23"/>Ene kielien gaijiulai chighinde echizhi "Hhe tuji ulie fugune." giezhi kieliezho. Shijishan <char style="pn">Ersa</char> "Hhe ulie fugune." giezhi ese kieliezho. "Bi hhei ulie fugughazhi bi pse ireku shihou oluliuzhe chare yan xiangan wo." giezhi kieliezho.<verse eid="JHN 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24"/>Ene kunshi ene shiqinlade ganzhen beizhi jilasan hhe tuji wo. Hhe beisan ganzhenshi zhenni bikui bijien mejiene. <verse eid="JHN 21:24"/><verse number="25" style="v" sid="JHN 21:25"/><char style="pn">Ersa</char> giesan shiqinla da olon hen wo. Bi sumulase nienieji jilane giese huaisan shu olonde, duyadeliuzhe teizhi pudagha dane.<verse eid="JHN 21:25"/></para>
  <chapter eid="JHN 21"/>
</usx>
