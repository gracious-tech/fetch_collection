  <para style="rem">Copyright Information: For any non-Paratext use of this text, permission must be obtained from the copyright holder.</para>
  <para style="h">Lujia Chonjisan Gouxioxi</para>
  <para style="toc1">Lujia Chonjisan Gouxioxi</para>
  <para style="toc2">Lujia</para>
  <para style="toc3">Luj</para>
  <para style="mt">Lujia Chonjisan Gouxioxi</para>
  <chapter number="1" style="c" sid="LUK 1"/>
  <para style="s">Shuni Melieduku Kielien</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1"/>
    <char style="pn">Qiafeilo</char> noyen!</para>
  <para style="p" vid="LUK 1:1">Olon kun bijienni dunda fashen giesan shiqinyi huaizho. <verse eid="LUK 1:1"/><verse number="2" style="v" sid="LUK 1:2"/>Huaisanlashi Hudai kieliende wilie giechen kunla zui melieshidase nudundene qinsi uzhedene bijiende chonjisan mutun wo. <verse eid="LUK 1:2"/><verse number="3" style="v" sid="LUK 1:3"/>Ene shiqinlani bi melieshida xianxide chaizhi daowo. Ingiese biye chade nienieji huaizhi <verse eid="LUK 1:3"/><verse number="4" style="v" sid="LUK 1:4"/>chi surusanlai man zhenni bikui mejieghane giezho.<verse eid="LUK 1:4"/></para>
  <para style="s">Xili Gieghasan Yaheiyai Olukui Melie Kieliezho</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5"/>
    <char style="pn">Hherode</char> <char style="png">Yudaya</char>ni honshan danlakude nie buwa wo, niereini <char style="pn">Sajialiya</char> giene. <char style="pn">Yabiya</char>ni duide wo. Hheni biereishi <char style="pn">Hharune</char>ni houdei wo, niereini <char style="pn">Ilishabai</char> giene. <verse eid="LUK 1:5"/><verse number="6" style="v" sid="LUK 1:6"/>Hhe ghualashi Hudai melie gou kun wo. Hudai minlin, guijinni zunjizhi man giezho, yama kieliekui uwo. <verse eid="LUK 1:6"/><verse number="7" style="v" sid="LUK 1:7"/>Hhelade zinie kewosi uwo. <char style="pn">Ilishabai</char> kewosi olu dane, ede hhe ghuala oqioluwo.<verse eid="LUK 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8"/>Niefade <char style="pn">Sajialiya</char>ni nie duide buwani wilie gieku linjizhi kuzhese hhe Hudai melie wilie giekude <verse eid="LUK 1:8"/><verse number="9" style="v" sid="LUK 1:9"/>buwani xigonghala gangan chouidene Ezhanni giede oro xian jienjiwo. <verse eid="LUK 1:9"/><verse number="10" style="v" sid="LUK 1:10"/>Xian jienjikude bexinla man ghadane onxian giezho.<verse eid="LUK 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 1:11"/>Menzhali Ezhanni qienxien xianlu shireni borun miende beizhi <char style="pn">Sajialiya</char>de chanlaghawo. <verse eid="LUK 1:11"/><verse number="12" style="v" sid="LUK 1:12"/><char style="pn">Sajialiya</char> chanladene jinda hende ayizho. <verse eid="LUK 1:12"/><verse number="13" style="v" sid="LUK 1:13"/>Qienxien hhende kieliewo, "<char style="pn">Sajialiya</char>, bu ayi! Chini onxianni Huda chenliewo. Chini bierei <char style="pn">Ilishabai</char> chade nie kewon olune. Chi hhende <char style="pn">Yaheiya</char> giezhi niere ogi. <verse eid="LUK 1:13"/><verse number="14" style="v" sid="LUK 1:14"/>Chi hende bayasune. Hhei oluse olon kunlaye bayasune. <verse eid="LUK 1:14"/><verse number="15" style="v" sid="LUK 1:15"/>Hhe Ezhanni melie fugie kun gholune. Putoujiu, yama jiu ulie ochine, anane kielise Shenlinghala duruzho. <verse eid="LUK 1:15"/><verse number="16" style="v" sid="LUK 1:16"/>Hhe olon <char style="png">Isilie</char> kunlai Ezhan Hudai miende khareizhi ireghane. <verse eid="LUK 1:16"/><verse number="17" style="v" sid="LUK 1:17"/>Hhe irese xienzhi <char style="pn">Iliya</char>ni jinshen, nenli winezhi Ezhanni melie zhunbei giene. Adalai kesilarene goudaghane, kielien ulie chenliechen kunlai gouni sumulakude khareighane. Ingiezhi kunlai Ezhanni melie zhunbei gieghane." <verse eid="LUK 1:17"/><verse number="18" style="v" sid="LUK 1:18"/><char style="pn">Sajialiya</char> qienxiende kieliewo, "Bi pin yanzhe eneni mejiene? Bi oqioluwo, biereimiye oqioluwo." <verse eid="LUK 1:18"/><verse number="19" style="v" sid="LUK 1:19"/>Qienxien kieliewo, "Bishi Hudai melie beisan <char style="pn">Zhebereiye</char> wo. Mini peizhi chade ene gouxioxini kielieghale irewo. <verse eid="LUK 1:19"/><verse number="20" style="v" sid="LUK 1:20"/>Uzhe, hhe shihou kuzhese mini kieliende kurunema, ene shiqin kuzhetula chi yaba gholune. Chi mini kielienni xianxin ese giewo."<verse eid="LUK 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21"/>Ingiekude <char style="pn">Sajialiya</char> Ezhanni giese dou ese khizhese sagheisan kunla ghudurezho. <verse eid="LUK 1:21"/><verse number="22" style="v" sid="LUK 1:22"/><char style="pn">Sajialiya</char> khizhese hhelade kielien kielie dane, yaba gholudene khaghalane kieliese hhela hhe Ezhanni giede yama chanlawo giezho.<verse eid="LUK 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 1:23"/>Hhe wilie giezhi ududei kuruse giedene echiwo. <verse eid="LUK 1:23"/><verse number="24" style="v" sid="LUK 1:24"/>Enense khuinashi hheni bierei <char style="pn">Ilishabai</char> kewosi laidene tawun sara kiemade ese chujiegheghazho. <verse eid="LUK 1:24"/><verse number="25" style="v" sid="LUK 1:25"/>Hhe kieliewo, "Ezhanni nenjien fugie no wo. Mini zhaogu giekude ingiezhi giedene kunlai dundase mini shizhekuni widaghawo."<verse eid="LUK 1:25"/></para>
  <para style="s">Ersani Olukuni Kieliezho</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26"/>
    <char style="pn">Ilishabai</char> zhighon sara laikude Huda <char style="pn">Zhebereiye</char> qienxienni peizhi <char style="png">Jialili</char>ni <char style="png">Nasale</char> giesan chenshii nie oqinde echighawo. <verse eid="LUK 1:26"/><verse number="27" style="v" sid="LUK 1:27"/>Hhe oqinni niereini <char style="pn">Mereiyen</char> giene, <char style="pn">Dawude</char> honshanni houdei <char style="pn">Yusufu</char>de boluzho. <verse eid="LUK 1:27"/><verse number="28" style="v" sid="LUK 1:28"/>Qienxien orodene hhende kieliewo, "Chi gou onu? Hudai nenjien chade fugie no wo. Huda chighala hhantu wo." <verse eid="LUK 1:28"/><verse number="29" style="v" sid="LUK 1:29"/><char style="pn">Mereiyen</char> chenliedene jindazhi eneshi yan isi wo giezhi sumulazho. <verse eid="LUK 1:29"/><verse number="30" style="v" sid="LUK 1:30"/>Qienxien <char style="pn">Mereiyen</char>de kieliewo, "Bu ayi! Huda chade nenjien ogiwo. <verse eid="LUK 1:30"/><verse number="31" style="v" sid="LUK 1:31"/>Uzhe, chi laizhi nie kewon olune. Hhende <char style="pn">Ersa</char> giezhi niere ogi. <verse eid="LUK 1:31"/><verse number="32" style="v" sid="LUK 1:32"/>Hhe fugie kun gholuzhi kunla jianlai hhei Zui Undu Ezhanni Kewon giezhi urune. Ezhan Huda hhende xienren <char style="pn">Dawude</char>ni wizini ogine. <verse eid="LUK 1:32"/><verse number="33" style="v" sid="LUK 1:33"/>Hhe <char style="pn">Yagebu</char>ni giede chan honshan danlane. Hhe chanqi gonjizhi qienli ulie widane." <verse eid="LUK 1:33"/><verse number="34" style="v" sid="LUK 1:34"/><char style="pn">Mereiyen</char> qienxiende kieliewo, "Mii dou ese dafalazho. Matugie imutu shiqin wine?" <verse eid="LUK 1:34"/><verse number="35" style="v" sid="LUK 1:35"/>Qienxien kieliewo, "Shenlin chini jiere irene. Zui Undu Hudai nenli chii jiere irezhi huine. Ingiese oluku zhiguitu kewonni Hudai Kewon giezhi urune. <verse eid="LUK 1:35"/><verse number="36" style="v" sid="LUK 1:36"/>Uzhe, chii qingu <char style="pn">Ilishabai</char> oqioludene nie kewon laiwo. Kunla kieliese hheshi nie ulie oluchen kun wo giezho, ede laizhi zhighon sara oluwo. <verse eid="LUK 1:36"/><verse number="37" style="v" sid="LUK 1:37"/>Hudade nengou wituni uwo."<verse eid="LUK 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 1:38"/>Ingiese <char style="pn">Mereiyen</char> kieliewo, "Bishi Ezhanni hoji wo. Chi kieliesan mutun made gholu gie." Ingiedene qienxien likai giewo.<verse eid="LUK 1:38"/></para>
  <para style="s">Mereiyen Ilishabaii Uzhele Echizho</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39"/>Oloncha ese oluse <char style="pn">Mereiyen</char> zhunbei gie jindazhi ulatu <char style="png">Yuda</char> oronni chenshide echiwo. <verse eid="LUK 1:39"/><verse number="40" style="v" sid="LUK 1:40"/><char style="pn">Sajialiya</char>ni giede orodene <char style="pn">Ilishabai</char>de salan giewo. <verse eid="LUK 1:40"/><verse number="41" style="v" sid="LUK 1:41"/><char style="pn">Ilishabai</char> <char style="pn">Mereiyen</char>ni salanni jienliekude kieliini kewosi jiulizho. Ingie <char style="pn">Ilishabai</char> Shenlinghala durudene <verse eid="LUK 1:41"/><verse number="42" style="v" sid="LUK 1:42"/>fugiede doulazhi kieliewo, "Biereila dunda chade fuqi zui fugie wo. Chi oluku kewondeye fuqi fugie wo. <verse eid="LUK 1:42"/><verse number="43" style="v" sid="LUK 1:43"/>Mii Ezhanni ana enende irese matui olune? <verse eid="LUK 1:43"/><verse number="44" style="v" sid="LUK 1:44"/>Uzhe, chii shenqini chenliekude mii kielini kewosi bayasuzhi jiulizho. <verse eid="LUK 1:44"/><verse number="45" style="v" sid="LUK 1:45"/>Ezhan kieliesan shiqin chenjikui xianxin giesan chade fuqi wine."<verse eid="LUK 1:45"/></para>
  <para style="s">Mereiyen Ezhanni Doulazho</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 1:46"/>
    <char style="pn">Mereiyen</char> kieliewo.</para>
  <para style="b" vid="LUK 1:46"/>
  <para style="q1" vid="LUK 1:46">"Zhughemi Ezhan fugie wo giezho.<verse eid="LUK 1:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="LUK 1:47"/>Ruhhermi mii jiuichen Hudade oluzhi bayasuzho.<verse eid="LUK 1:47"/></para>
  <para style="q2">
    <verse number="48" style="v" sid="LUK 1:48"/>Hhe imutu meila hojii zhaogu giewo.</para>
  <para style="q2" vid="LUK 1:48">Uzhe, enedu khuinase soyuji kunla made fuqi wine giezhi kieliene.<verse eid="LUK 1:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="LUK 1:49"/>Nenlitu Huda made fugie shiqin giewo,</para>
  <para style="q2" vid="LUK 1:49">hhei niere zhigui wo.<verse eid="LUK 1:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="LUK 1:50"/>Hhei zunjisan kunlade zuzubeibeide ubali xiine.<verse eid="LUK 1:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="LUK 1:51"/>Hhe beghelieghalane lilianni uzheghawo.</para>
  <para style="q2" vid="LUK 1:51">Sudorone hu sumulazhi goyane fugiede huichen kunlai sanda widaghawo.<verse eid="LUK 1:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="LUK 1:52"/>Qienli bitu kunlai boghonidaghawo.</para>
  <para style="q2" vid="LUK 1:52">Qienli witu kunlai undudaghawo.<verse eid="LUK 1:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="LUK 1:53"/>Oliesuchen kunlade gouni ogizhi chudughawo.</para>
  <para style="q2" vid="LUK 1:53">Bayan kunlai khosun kha echighawo.<verse eid="LUK 1:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="LUK 1:54"/>Hhe <char style="png">Isilie</char> hojidene banman giewo.<verse eid="LUK 1:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="LUK 1:55"/>Yenjisan kielien mutun</para>
  <para style="q2" vid="LUK 1:55">
    <char style="pn">Iburaheimu</char>ji houdeiladeni chanqi ubali xiikui ese matazho."<verse eid="LUK 1:55"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56"/>
    <char style="pn">Mereiyen</char> <char style="pn">Ilishabai</char>ghala hhantu chabudu ghuran sara soudene giedene echiwo.<verse eid="LUK 1:56"/></para>
  <para style="s">Xili Gieghasan Yaheiyani Oluzho</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57"/>
    <char style="pn">Ilishabai</char> oluku shihouni kurudene nie kewon oluwo. <verse eid="LUK 1:57"/><verse number="58" style="v" sid="LUK 1:58"/>Giebeilane, jiawulani Ezhan <char style="pn">Ilishabai</char>de fugie nenjien ogisei mejiedene hhantu man bayasuzho. <verse eid="LUK 1:58"/><verse number="59" style="v" sid="LUK 1:59"/>Neimudu kurudene kunla kewonni hetoune giele irewo. Adaini niere mutun hhende <char style="pn">Sajialiya</char> giezhi niere ogine giezho. <verse eid="LUK 1:59"/><verse number="60" style="v" sid="LUK 1:60"/>Ingiese anani kieliewo, "Ulie olune, hhei niereni <char style="pn">Yaheiya</char> gie." <verse eid="LUK 1:60"/><verse number="61" style="v" sid="LUK 1:61"/>Kunla hhende kieliewo, "Chii jiawude imutu niere uwo." <verse eid="LUK 1:61"/><verse number="62" style="v" sid="LUK 1:62"/>Ingie adadei khaghala uzheghazhi, "Kewosii niereini yan giene?" giezhi asawo. <verse eid="LUK 1:62"/><verse number="63" style="v" sid="LUK 1:63"/>Adani nie banba keredene, "Hhei nierei <char style="pn">Yaheiya</char> giene." giezhi huaiwo. Ingiese kunla man ghanirawo. <verse eid="LUK 1:63"/><verse number="64" style="v" sid="LUK 1:64"/>Hhe xienzide <char style="pn">Sajialiya</char>ni amanni keidene kielienni goudasenu Hudade doulazho.<verse eid="LUK 1:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="LUK 1:65"/>Zhouwide sousan kunla man ayizho. Ene shiqinni ulatu <char style="png">Yudaya</char> oronde man chonji kurughawo. <verse eid="LUK 1:65"/><verse number="66" style="v" sid="LUK 1:66"/>Ene shiqinyi chenliesan kunla man zhughedene sumulazhi ene kewon jianlai matui gholuse giezho. Ingiekushi Ezhanni nenli hheghala hhantu wo.<verse eid="LUK 1:66"/></para>
  <para style="s">Sajialiya Hudani Kielienni Kieliezho</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67"/>Hhei ada <char style="pn">Sajialiya</char>de Shenlin durudene Hudai kielienyi deilazhi kieliewo.<verse eid="LUK 1:67"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="68" style="v" sid="LUK 1:68"/>"Ezhan <char style="png">Isilie</char>ni Hudade doulakuni wo.</para>
  <para style="q2" vid="LUK 1:68">Hhe bexinlane zhaogu giezhi shuiwo.<verse eid="LUK 1:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="LUK 1:69"/>Matande oluzhi goya hoji <char style="pn">Dawude</char>ni</para>
  <para style="q2" vid="LUK 1:69">houdeise fugie nenlitu jiuichen khizheghawo.<verse eid="LUK 1:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="LUK 1:70"/>Eneshi melieshida Huda zhiguitu xienzhilai tungo giezhi kieliesanghala niekielien wo,<verse eid="LUK 1:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="LUK 1:71"/>'Huda bijienyi henjisan kunlai,</para>
  <para style="q2" vid="LUK 1:71">duitoulani khase jiuiwo.<verse eid="LUK 1:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="LUK 1:72"/>Matanni xienrenlade ubali xiizhi</para>
  <para style="q2" vid="LUK 1:72">yenjisan zhiguitu kielienne uye matazho.<verse eid="LUK 1:72"/></para>
  <para style="q1">
    <verse number="73" style="v" sid="LUK 1:73"/>Eneshi hhe matanyi xienren <char style="pn">Iburaheimu</char>de yenjisan wo.<verse eid="LUK 1:73"/></para>
  <para style="q1">
    <verse number="74-75" style="v" sid="LUK 1:74-75"/>Mai duitoulai khase jiuisenu Hudai melie beighadene</para>
  <para style="q2" vid="LUK 1:74-75">ulie ayizhi zhigui, gundande ibeizi shunjighane.<verse eid="LUK 1:74-75"/></para>
  <para style="q1">
    <verse number="76" style="v" sid="LUK 1:76"/>Kewon, chii Zui Undu Hudai xienzhi giezhi urune.</para>
  <para style="q2" vid="LUK 1:76">Chi Ezhanni melie yozhi moni zhunbei giene,<verse eid="LUK 1:76"/></para>
  <para style="q1">
    <verse number="77" style="v" sid="LUK 1:77"/>Ezhanni bexinlai zuini mienliezhi</para>
  <para style="q2" vid="LUK 1:77">jiuiku nenjienni mejieghane.<verse eid="LUK 1:77"/></para>
  <para style="q1">
    <verse number="78" style="v" sid="LUK 1:78"/>Matai Huda ubali xiizhi zhugheni zholien wo.</para>
  <para style="q2" vid="LUK 1:78">Hhe eqiemaghaku naranyi asiman jierese matai jiere ireghazhi<verse eid="LUK 1:78"/></para>
  <para style="q1">
    <verse number="79" style="v" sid="LUK 1:79"/>Khara oron, fuguku xiojiededu sousan kunlai giegheraghadene</para>
  <para style="q2" vid="LUK 1:79">uduruzhi pinnan mode yoghane.'"<verse eid="LUK 1:79"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="80" style="v" sid="LUK 1:80"/>Hhe kewonyi beye fugiedazhi zhanjin wo. <char style="png">Isilie</char>ni kunlai melie khizhezhi wilie gietula hontande souzho.<verse eid="LUK 1:80"/></para>
  <chapter eid="LUK 1"/>
  <chapter number="2" style="c" sid="LUK 2"/>
  <para style="s">Ersani Oluzho</para>
  <para style="r">(<ref loc="MAT 1:18-25">Mat 1:18-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1"/>Hhe shihoude <char style="pn">Kaisa</char> Honshan <char style="pn">Aogusidu</char> minlin xiaizhi qienxiani kunlai man hukou banji giezho. <verse eid="LUK 2:1"/><verse number="2" style="v" sid="LUK 2:2"/>Eneshi <char style="pn">Jiliniu</char> <char style="png">Xiliya</char>ni oronde shenzhan danlaku shihoude tou 1 hui hukou banjighasan wo. <verse eid="LUK 2:2"/><verse number="3" style="v" sid="LUK 2:3"/>Ingie kunla man goya loujiadene hukou banjile echiwo. <verse eid="LUK 2:3"/><verse number="4" style="v" sid="LUK 2:4"/><char style="pn">Yusufu</char>shi <char style="pn">Dawude</char> honshanni houdei wo, ingiese hheye <char style="png">Jialili</char>ni <char style="png">Nasale</char> chenshise <char style="png">Bolihen</char> giesan <char style="png">Yudaya</char> orondedu <char style="png">Dawude Chenshi</char>de khizhi echiwo. <verse eid="LUK 2:4"/><verse number="5" style="v" sid="LUK 2:5"/>Hhende bolusan <char style="pn">Mereiyen</char> ghuala hhantu hukou banjile echiwo. Hhe xienzide <char style="pn">Mereiyen</char> kewosi laizho. <verse eid="LUK 2:5"/><verse number="6" style="v" sid="LUK 2:6"/>Hhela hhende bikude <char style="pn">Mereiyen</char> oluku shihou kuzhewo. <verse eid="LUK 2:6"/><verse number="7" style="v" sid="LUK 2:7"/>Toushude nie kewon oluwo. Lishede oron widadene popude boui onghochode kijieghawo.<verse eid="LUK 2:7"/></para>
  <para style="s">Qienxienla Ghoni Adulasan Kunlade Gouxioxini Kieliezho</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8"/>Hhe oronde xieni ghoni adulasan kunla ghadane ghonilai sagheizho. <verse eid="LUK 2:8"/><verse number="9" style="v" sid="LUK 2:9"/>Ezhanyi qienxien hhelade xienjighazhi Ezhanni gon simiense zhouise ghoni adulachen kunla hende ayizho. <verse eid="LUK 2:9"/><verse number="10" style="v" sid="LUK 2:10"/>Qienxien kieliewo, "Bu ayi! Uzhe, bi soyuji kunlade olusan hende bayasuku gouxioxini tande boulaye. <verse eid="LUK 2:10"/><verse number="11" style="v" sid="LUK 2:11"/>Enedu <char style="png">Dawude Chenshi</char>de tande nie Jiuichen oluwo, hheshi Ezhan Mexiha wo. <verse eid="LUK 2:11"/><verse number="12" style="v" sid="LUK 2:12"/>Ta nie yeliwai chanlane. Popude bouidene onghochode kijieghazho. Eneshi jihao wo."<verse eid="LUK 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 2:13"/>Menzhali asiman jieredu idaban budui hhe qienxienghala hhantu Hudade doulazho,<verse eid="LUK 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LUK 2:14"/>"Asiman jiere Hudai kuai.</para>
  <para style="q2" vid="LUK 2:14">Zemin jiere Huda xiqi bisan kunlade pinnan wo!"<verse eid="LUK 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 2:15"/>Ingie qienxienla likai giedene asiman jiere khireiwo. Ghoni adulachen kunla nieniedene "matan <char style="png">Bolihen</char>de yoye. Huda matande kieliesan shiqin matui gholukuni nie uzheye" giezho.<verse eid="LUK 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 2:16"/>Hhela jindazhi echidene <char style="pn">Mereiyen</char>, <char style="pn">Yusufu</char>, pse nie onghochode kijieghasan yeliwai chanlawo. <verse eid="LUK 2:16"/><verse number="17" style="v" sid="LUK 2:17"/>Hhela uzhedene qienxien ene kewonde kieliesan shiqinni kunlade man kieliewo. <verse eid="LUK 2:17"/><verse number="18" style="v" sid="LUK 2:18"/>Ghoni adulachen kunla kieliesan shiqinyi kunla chenliedene ghudure wo giezhoma, <verse eid="LUK 2:18"/><verse number="19" style="v" sid="LUK 2:19"/><char style="pn">Mereiyen</char> ene shiqinyi man zhughedene jilazhi izhi sumulazho. <verse eid="LUK 2:19"/><verse number="20" style="v" sid="LUK 2:20"/>Ghoni adulachen kunla khareizhi echikude Hudade kuaizhi doulazho. Hhela uzhesan, chenliesanla qienxien kieliesanghala niekielien wo.<verse eid="LUK 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21"/>Neimudu kuru ga kewonni hetoune giedene niereini <char style="pn">Ersa</char> giewo. Eneshi kewosii laiku melie qienxien ogisan niere wo.<verse eid="LUK 2:21"/></para>
  <para style="s">Ersani Mechide Uzheghazho</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 2:22"/>
    <char style="pn">Musa</char>ni shu jiere kieliesan waghaku udu kurudene <char style="pn">Mereiyen</char> <char style="pn">Yusufu</char>ghala <char style="png">Yelusalen</char> chenshide kewonne Hudade khughozhi echighawo. <verse eid="LUK 2:22"/><verse number="23" style="v" sid="LUK 2:23"/>Ezhanni guijinshu jiere huaizho, "Laoda kewonlani man zhiguishighazhi Hudade ogi." <verse eid="LUK 2:23"/><verse number="24" style="v" sid="LUK 2:24"/>Pse Ezhanni guijinshu jiere huaizhi ghua yegu onu, ghua ga ghoghochen ogi giezho. Hhela ingiezhi giewo.<verse eid="LUK 2:24"/></para>
  <para style="s">Ximien Kieliesan</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 2:25"/>
    <char style="png">Yelusalen</char>de nie kunni niereini <char style="pn">Ximien</char> giene. Hheshi nie gou kun wo, jiomun jiereye chighara wo, chanqi <char style="png">Isilie</char> kunni jiuise giezhi panjizho. Hhende Shenlin duruzho. <verse eid="LUK 2:25"/><verse number="26" style="v" sid="LUK 2:26"/>Duya ijieku melieshida kenjin Ezhan kieliesan Mexihani uzhene giezhi Shenlin mejieghawo. <verse eid="LUK 2:26"/><verse number="27" style="v" sid="LUK 2:27"/>Shenlin hhei uduruzhi mechide ireghawo. <char style="pn">Ersa</char>i ana adani zhao guijinni yoqiu mutun shiqin banjile irekude <verse eid="LUK 2:27"/><verse number="28" style="v" sid="LUK 2:28"/><char style="pn">Ximien</char> kewonni qiorudene Hudai nierei fugiedaghazhi doulawo,<verse eid="LUK 2:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="LUK 2:29"/>"Ezhan, chi yenjisan kielien mutun</para>
  <para style="q2" vid="LUK 2:29">ede hojii duyase pinnan andaghazho.<verse eid="LUK 2:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="LUK 2:30"/>Chi jiuikuni bi qinsi uzhewo.<verse eid="LUK 2:30"/></para>
  <para style="q2">
    <verse number="31" style="v" sid="LUK 2:31"/>Eneshi chi olon minzulade zhunbei giesan wo.<verse eid="LUK 2:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 2:32"/>Niman kunlade Hudai mejieghaku gon wo.</para>
  <para style="q2" vid="LUK 2:32">Goya bexin <char style="png">Isilie</char> kunni minshen wo."<verse eid="LUK 2:32"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="33" style="v" sid="LUK 2:33"/>Ada anani hhe kewonde kieliesei chenliedene ghanirawo. <verse eid="LUK 2:33"/><verse number="34" style="v" sid="LUK 2:34"/><char style="pn">Ximien</char> hhelade oluzhi onxian giedene kewonni ana <char style="pn">Mereiyen</char>de kieliewo, "<char style="png">Isilie</char> kunlai dunda ezighan kunla ene kewonni bayasuzhi jienliene, ezighan kunla fandui giene. Kunla hhei sugienduzhi duitou gholune. <verse eid="LUK 2:34"/><verse number="35" style="v" sid="LUK 2:35"/>Kunla zhughedene yan sumulakuni hhe man mejieghane. Chii zhugheye khudoghoghala chujiku mutun gholune."<verse eid="LUK 2:35"/></para>
  <para style="s">Yana Kieliesan</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 2:36"/>Pse hhende nie bierei xienzhi wine. Niereini <char style="pn">Yana</char> giene, <char style="pn">Yashe</char>ni jiawuni <char style="pn">Faneili</char>ni oqin wo, hende oqioluwo. Dafalasenu 7 nien soudene <verse eid="LUK 2:36"/><verse number="37" style="v" sid="LUK 2:37"/>guafu feiliezhi 84 nien niezheghan souzho<note caller="+" style="f"><char style="fr">2:37</char> <char style="em">Hhe ijin 84 oluwo.</char> </note>. Hhe mechise likai ulie giedene xieni udu orozo bareizhi onxian giedene Hudai shunjizho. <verse eid="LUK 2:37"/><verse number="38" style="v" sid="LUK 2:38"/>Hhela jian kielien kielieku shihoude <char style="pn">Yana</char> hhelani yo penjidene Hudade mafan giezhi <char style="png">Yelusalen</char>yi jiuise giezhi sagheichen kunlade <char style="pn">Ersa</char>ni shiqinyi kieliewo.<verse eid="LUK 2:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 2:39"/>
    <char style="pn">Yusufu</char> <char style="pn">Mereiyen</char> ghuala zhao Hudai shu jiereshiku mutun shiqinni man banjizhi baraghadene khareizhi <char style="png">Jialili</char>ni <char style="png">Nasale</char> chenshidene echiwo. <verse eid="LUK 2:39"/><verse number="40" style="v" sid="LUK 2:40"/><char style="pn">Ersa</char>ni beye fugiedazhi hendazhi agheli olodozho. Hudai nenjien hhei jiere wo.<verse eid="LUK 2:40"/></para>
  <para style="s">Ersa Mechide Wo</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41"/>Niehonnie Jiulidaosan Jie kuzhese ada anani <char style="png">Yelusalen</char>de khizhi echizho. <verse eid="LUK 2:41"/><verse number="42" style="v" sid="LUK 2:42"/><char style="pn">Ersa</char> 12 olukude hhela zhao hhe xigonghala jieqi daoghale echiwo. <verse eid="LUK 2:42"/><verse number="43" style="v" sid="LUK 2:43"/>Jieqi baludene giedene khareikude <char style="pn">Ersa</char> <char style="png">Yelusalen</char>de feiliewo. Ana adani ulie mejiene. <verse eid="LUK 2:43"/><verse number="44" style="v" sid="LUK 2:44"/>Hhela sumulase hhantu yozho. Niudu yodene widasei mejie, qingu zhelienladene asazhi ereizho. <verse eid="LUK 2:44"/><verse number="45" style="v" sid="LUK 2:45"/>Ereizhi olu dadene khareizhi <char style="png">Yelusalen</char>de ereile echiwo. <verse eid="LUK 2:45"/><verse number="46" style="v" sid="LUK 2:46"/>Ghurudude Ezhanni giese ereizhi oluwo. <char style="pn">Ersa</char> loushilai dunda souzhi niemiende chenliezho, niemiende asazho. <verse eid="LUK 2:46"/><verse number="47" style="v" sid="LUK 2:47"/>Jien hhenughunyi chenliesanla man hhe cunmin wo, huida giesan gou wo giezhi ghanirazho.<verse eid="LUK 2:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 2:48"/>Ada anani hhei chanladene uzhe beizho. Anani <char style="pn">Ersa</char>de kieliewo, "Mini kewon, chi ingiezhi bijienni ereighazhi yangiene? Uzhe, bi adachinighala izhigie zhughe chilazhi ereizho." <verse eid="LUK 2:48"/><verse number="49" style="v" sid="LUK 2:49"/><char style="pn">Ersa</char> kieliewo, "Mini ereizhi yangiene? Bi indan Adane giede bikuni ta mejie danu?" <verse eid="LUK 2:49"/><verse number="50" style="v" sid="LUK 2:50"/>Hhela kielienyini dunjire dazho.<verse eid="LUK 2:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 2:51"/>Ingie <char style="pn">Ersa</char> hhantu <char style="png">Nasale</char>de khareidene ada anane kielienyi chenliezhi giezho. Anani ene shiqinyi zhughedene goude jilazho. <verse eid="LUK 2:51"/><verse number="52" style="v" sid="LUK 2:52"/><char style="pn">Ersa</char>ni beye yebeiseye fugiedazhi agheli olodozho. Huda kunla man <char style="pn">Ersa</char>de bayasuzho.<verse eid="LUK 2:52"/></para>
  <chapter eid="LUK 2"/>
  <chapter number="3" style="c" sid="LUK 3"/>
  <para style="s">Xili Gieghasan Yaheiya Moni Zhunbei Giezho</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mat 3:1-12</ref>; <ref loc="MRK 1:1-8">Mak 1:1-8</ref>; <ref loc="JHN 1:19-28">Yah 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1"/>
    <char style="pn">Qibiliu</char> fugie honshan danlazhi 15 nien olukude <char style="pn">Benjiu-Bilado</char> <char style="png">Yudaya</char>de shenzhan danlazho. <char style="pn">Hherode</char> <char style="png">Jialili</char>de on danlazho, jiuni <char style="pn">Feili</char> <char style="png">Ituliya</char>ji <char style="png">Telakeni</char>de on danlazho, <char style="pn">Lisanie</char> <char style="png">Yabilini</char>de on danlazho. <verse eid="LUK 3:1"/><verse number="2" style="v" sid="LUK 3:2"/><char style="pn">Yanasi</char>, <char style="pn">Gaiyafa</char>ghala zui fugie buwa danlazho. Hhe shihoude Hudai kielien <char style="pn">Sajialiya</char>ni kewon <char style="pn">Yaheiya</char>de bouzhewo. <char style="pn">Yaheiya</char> hontande souzho. <verse eid="LUK 3:2"/><verse number="3" style="v" sid="LUK 3:3"/>Hhe <char style="png">Yedanhe</char>ni hhemien enemiende yozhi kunlade xili gieghazhi, "Ta geizhen giendu, Huda tai zuini rouliene." giezhi chonjizhi kieliezho. <verse eid="LUK 3:3"/><verse number="4" style="v" sid="LUK 3:4"/><char style="pn">Isaiya</char> xienzhini shu jiere huaizho,</para>
  <para style="q1" vid="LUK 3:4">"Hontande nie kun waradazho,</para>
  <para style="q1" vid="LUK 3:4">'Ezhanni moni zhunbei gie!</para>
  <para style="q2" vid="LUK 3:4">Hhei moni zhidagha!<verse eid="LUK 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LUK 3:5"/>Ghonni man jienjizhi pindaghane.</para>
  <para style="q2" vid="LUK 3:5">Fugie ula ga ulalani man pindaghane.</para>
  <para style="q1" vid="LUK 3:5">Onjisan molani zhidaghazhi goudaghane.</para>
  <para style="q2" vid="LUK 3:5">Oko danlanlani pienjizhi goudaghane.<verse eid="LUK 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LUK 3:6"/>Ingiese kunla man Hudai jiuikuni uzhene.'"<verse eid="LUK 3:6"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7"/>
    <char style="pn">Yaheiya</char> xili jienliele iresan kunlade kieliewo, "Du mogheini zhunzhughala, kien tande jianlai ireku Hudai hokukuse anda shidane giezhi kieliewo? <verse eid="LUK 3:7"/><verse number="8" style="v" sid="LUK 3:8"/>Ta geizhen giesanne giekughala zhenmin gie. <char style="pn">Iburaheimu</char>shi bijienyi xienren wo giezhi ta zhughedene bu sumula. Bi tande kielieye, Huda ene tashilani <char style="pn">Iburaheimu</char>ni houdei gholugha shidane. <verse eid="LUK 3:8"/><verse number="9" style="v" sid="LUK 3:9"/>Ede sugiei mutun genzide teiwo. Gou alima ulie souku mutunlani man chizhidene khande teine."<verse eid="LUK 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 3:10"/>Kunla asawo, "Qingiese bijien matugiene?" <verse eid="LUK 3:10"/><verse number="11" style="v" sid="LUK 3:11"/><char style="pn">Yaheiya</char> kieliewo, "Ghua jien bisan kunla jien witu kunlade ogi. Ijiewuni bisan kunla ye qingiezhi gie." <verse eid="LUK 3:11"/><verse number="12" style="v" sid="LUK 3:12"/>Shui shanjisan kunlaye xili giele iredene asawo, "Loushi, bijien matugiese gouwo?" <verse eid="LUK 3:12"/><verse number="13" style="v" sid="LUK 3:13"/><char style="pn">Yaheiya</char> kieliewo, "Zhao hhe shuzighala kere, hhense olon bu kere." <verse eid="LUK 3:13"/><verse number="14" style="v" sid="LUK 3:14"/>Pse niezhan buduilaye asawo, "Bijien matugiese gou wo?" <char style="pn">Yaheiya</char> kieliewo, "Kunlani ayighazhi baer bu kere. Kunlai hu bu zha. Tande ogisan gunzi kuzho gie."<verse eid="LUK 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15"/>Hhe shihoude kunla man Mexihani panjizho. Ingiese kunla zhughedene sumulazhi <char style="pn">Yaheiya</char>shi Mexiha wo giezho. <verse eid="LUK 3:15"/><verse number="16" style="v" sid="LUK 3:16"/><char style="pn">Yaheiya</char> hhelade kieliewo, "Bi usughala tai xili gieghazhoma, mase khuina irechen kun mase nenli fugie wo. Bi hhende mahei deizi andaghaseye pei dane. Hhe Shenlin, khanghala tai xili gieghane. <verse eid="LUK 3:16"/><verse number="17" style="v" sid="LUK 3:17"/>Hhe khadene baqi bareizhi tughonni boudeii baqiliezhi agidene cankude zhonlone. Arasunlai ulie xinieku khande teine." <verse eid="LUK 3:17"/><verse number="18" style="v" sid="LUK 3:18"/><char style="pn">Yaheiya</char> pse olon kielienghala kunlade gouxioxini jianjizhi kieliewo.<verse eid="LUK 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 3:19"/>Melieshida <char style="pn">Hherode</char> on jiune bierei <char style="pn">Xiloji</char>ni agiwo. Hhe melieshidase huaishi olon giewo. <char style="pn">Yaheiya</char> hheni kheilasenu <verse eid="LUK 3:19"/><verse number="20" style="v" sid="LUK 3:20"/>pse nie huaishi giezhi <char style="pn">Yaheiya</char>ni bafanzide khawo.<verse eid="LUK 3:20"/></para>
  <para style="s">Ersa Xilini Jienliezho</para>
  <para style="r">(<ref loc="MAT 3:13-17">Mat 3:13-17</ref>; <ref loc="MRK 1:9-11">Mak 1:9-11</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21"/>
    <char style="pn">Yaheiya</char> kunlai xili gieghakude <char style="pn">Ersa</char>iye hhantu gieghawo. <char style="pn">Ersa</char> onxian giekude asiman keidene <verse eid="LUK 3:21"/><verse number="22" style="v" sid="LUK 3:22"/>Shenlin hhei jiere bouzhewo. Yanzini ghoghochenyi xianli. Ingiedene asiman jierese shenqi irezhi kieliewo, "Chishi bi oresan kewon wo. Bi chade xiqi wo."<verse eid="LUK 3:22"/></para>
  <para style="s">Ersani Xienrenla</para>
  <para style="r">(<ref loc="MRK 1:1-17">Mak 1:1-17</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23"/>
    <char style="pn">Ersa</char> chonji keise chabudu 30 olune.</para>
  <para style="b" vid="LUK 3:23"/>
  <para style="li" vid="LUK 3:23">Kunla uzhese <char style="pn">Ersa</char>shi <char style="pn">Yusufu</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:23">
    <char style="pn">Yusufu</char>shi <char style="pn">Xili</char>ni kewon wo.<verse eid="LUK 3:23"/></para>
  <para style="li">
    <verse number="24" style="v" sid="LUK 3:24"/>
    <char style="pn">Xili</char>shi <char style="pn">Mata</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:24">
    <char style="pn">Mata</char>shi <char style="pn">Liwi</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:24">
    <char style="pn">Liwi</char>shi <char style="pn">Maiji</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:24">
    <char style="pn">Maiji</char>shi <char style="pn">Yanai</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:24">
    <char style="pn">Yanai</char>shi <char style="pn">Yusufu</char>ni kewon wo.<verse eid="LUK 3:24"/></para>
  <para style="li">
    <verse number="25" style="v" sid="LUK 3:25"/>
    <char style="pn">Yusufu</char>shi <char style="pn">Mataqiya</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:25">
    <char style="pn">Mataqiya</char>shi <char style="pn">Yamosi</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:25">
    <char style="pn">Yamosi</char>shi <char style="pn">Nahun</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:25">
    <char style="pn">Nahun</char>shi <char style="pn">Isili</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:25">
    <char style="pn">Isili</char>shi <char style="pn">Nagai</char>ni kewon wo.<verse eid="LUK 3:25"/></para>
  <para style="li">
    <verse number="26" style="v" sid="LUK 3:26"/>
    <char style="pn">Nagai</char>shi <char style="pn">Maya</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:26">
    <char style="pn">Maya</char>shi <char style="pn">Mataqiya</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:26">
    <char style="pn">Mataqiya</char>shi <char style="pn">Ximei</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:26">
    <char style="pn">Ximei</char>shi <char style="pn">Yeseke</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:26">
    <char style="pn">Yeseke</char>shi <char style="pn">Yeda</char>ni kewon wo.<verse eid="LUK 3:26"/></para>
  <para style="li">
    <verse number="27" style="v" sid="LUK 3:27"/>
    <char style="pn">Yeda</char>shi <char style="pn">Yehanan</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:27">
    <char style="pn">Yehanan</char>shi <char style="pn">Lisa</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:27">
    <char style="pn">Lisa</char>shi <char style="pn">Solobabo</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:27">
    <char style="pn">Solobabo</char>shi <char style="pn">Salaqie</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:27">
    <char style="pn">Salaqie</char>shi <char style="pn">Nili</char>ni kewon wo.<verse eid="LUK 3:27"/></para>
  <para style="li">
    <verse number="28" style="v" sid="LUK 3:28"/>
    <char style="pn">Nili</char>shi <char style="pn">Maiji</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:28">
    <char style="pn">Maiji</char>shi <char style="pn">Yaji</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:28">
    <char style="pn">Yaji</char>shi <char style="pn">Gesan</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:28">
    <char style="pn">Gesan</char>shi <char style="pn">Imodan</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:28">
    <char style="pn">Imodan</char>shi <char style="pn">Er</char>ni kewon wo.<verse eid="LUK 3:28"/></para>
  <para style="li">
    <verse number="29" style="v" sid="LUK 3:29"/>
    <char style="pn">Er</char>shi <char style="pn">Yeshuya</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:29">
    <char style="pn">Yeshuya</char>shi <char style="pn">Iliixie</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:29">
    <char style="pn">Iliixie</char>shi <char style="pn">Yelin</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:29">
    <char style="pn">Yelin</char>shi <char style="pn">Mata</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:29">
    <char style="pn">Mata</char>shi <char style="pn">Liwi</char>ni kewon wo.<verse eid="LUK 3:29"/></para>
  <para style="li">
    <verse number="30" style="v" sid="LUK 3:30"/>
    <char style="pn">Liwi</char>shi <char style="pn">Ximien</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:30">
    <char style="pn">Ximien</char>shi <char style="pn">Yuda</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:30">
    <char style="pn">Yuda</char>shi <char style="pn">Yusufu</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:30">
    <char style="pn">Yusufu</char>shi <char style="pn">Yenan</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:30">
    <char style="pn">Yenan</char>shi <char style="pn">Iliyajin</char>ni kewon wo.<verse eid="LUK 3:30"/></para>
  <para style="li">
    <verse number="31" style="v" sid="LUK 3:31"/>
    <char style="pn">Iliyajin</char>shi <char style="pn">Miliya</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:31">
    <char style="pn">Miliya</char>shi <char style="pn">Mainan</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:31">
    <char style="pn">Mainan</char>shi <char style="pn">Madata</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:31">
    <char style="pn">Madata</char>shi <char style="pn">Nadan</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:31">
    <char style="pn">Nadan</char>shi <char style="pn">Dawude</char>ni kewon wo.<verse eid="LUK 3:31"/></para>
  <para style="li">
    <verse number="32" style="v" sid="LUK 3:32"/>
    <char style="pn">Dawude</char>shi <char style="pn">Yexi</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:32">
    <char style="pn">Yexi</char>shi <char style="pn">Ebeide</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:32">
    <char style="pn">Ebeide</char>shi <char style="pn">Boasi</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:32">
    <char style="pn">Boasi</char>shi <char style="pn">Samen</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:32">
    <char style="pn">Samen</char>shi <char style="pn">Nashun</char>ni kewon wo.<verse eid="LUK 3:32"/></para>
  <para style="li">
    <verse number="33" style="v" sid="LUK 3:33"/>
    <char style="pn">Nashun</char>shi <char style="pn">Yaminada</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:33">
    <char style="pn">Yaminada</char>shi <char style="pn">Yamin</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:33">
    <char style="pn">Yamin</char>shi <char style="pn">Yani</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:33">
    <char style="pn">Yani</char>shi <char style="pn">Xisilun</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:33">
    <char style="pn">Xisilun</char>shi <char style="pn">Falesi</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:33">
    <char style="pn">Falesi</char>shi <char style="pn">Yuda</char>ni kewon wo.<verse eid="LUK 3:33"/></para>
  <para style="li">
    <verse number="34" style="v" sid="LUK 3:34"/>
    <char style="pn">Yuda</char>shi <char style="pn">Yagebu</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:34">
    <char style="pn">Yagebu</char>shi <char style="pn">Isaghei</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:34">
    <char style="pn">Isaghei</char>shi <char style="pn">Iburaheimu</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:34">
    <char style="pn">Iburaheimu</char>shi <char style="pn">Tala</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:34">
    <char style="pn">Tala</char>shi <char style="pn">Nahe</char>ni kewon wo.<verse eid="LUK 3:34"/></para>
  <para style="li">
    <verse number="35" style="v" sid="LUK 3:35"/>
    <char style="pn">Nahe</char>shi <char style="pn">Xilu</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:35">
    <char style="pn">Xilu</char>shi <char style="pn">Lawu</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:35">
    <char style="pn">Lawu</char>shi <char style="pn">Fale</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:35">
    <char style="pn">Fale</char>shi <char style="pn">Ibo</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:35">
    <char style="pn">Ibo</char>shi <char style="pn">Shala</char>ni kewon wo.<verse eid="LUK 3:35"/></para>
  <para style="li">
    <verse number="36" style="v" sid="LUK 3:36"/>
    <char style="pn">Shala</char>shi <char style="pn">Gainan</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:36">
    <char style="pn">Gainan</char>shi <char style="pn">Yafasa</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:36">
    <char style="pn">Yafasa</char>shi <char style="pn">Shemu</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:36">
    <char style="pn">Shemu</char>shi <char style="pn">Nuhha</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:36">
    <char style="pn">Nuhha</char>shi <char style="pn">Lamai</char>ni kewon wo.<verse eid="LUK 3:36"/></para>
  <para style="li">
    <verse number="37" style="v" sid="LUK 3:37"/>
    <char style="pn">Lamai</char>shi <char style="pn">Matusala</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:37">
    <char style="pn">Matusala</char>shi <char style="pn">Idileisi</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:37">
    <char style="pn">Idileisi</char>shi <char style="pn">Yare</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:37">
    <char style="pn">Yare</char>shi <char style="pn">Malelie</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:37">
    <char style="pn">Malelie</char>shi <char style="pn">Gainan</char>ni kewon wo.<verse eid="LUK 3:37"/></para>
  <para style="li">
    <verse number="38" style="v" sid="LUK 3:38"/>
    <char style="pn">Gainan</char>shi <char style="pn">Inoshi</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:38">
    <char style="pn">Inoshi</char>shi <char style="pn">Saite</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:38">
    <char style="pn">Saite</char>shi <char style="pn">Adan</char>ni kewon wo.</para>
  <para style="li" vid="LUK 3:38">
    <char style="pn">Adan</char>shi Hudai kewon wo.<verse eid="LUK 3:38"/></para>
  <chapter eid="LUK 3"/>
  <chapter number="4" style="c" sid="LUK 4"/>
  <para style="s">Ersai Shiizho</para>
  <para style="r">(<ref loc="MAT 4:1-11">Mat 4:1-11</ref>; <ref loc="MRK 1:12-13">Mak 1:12-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1"/>
    <char style="pn">Ersa</char> Shenlinghala durudene <char style="png">Yedanhe</char>se irewo. Shenlin hhei uduruzhi hontande echidene <verse eid="LUK 4:1"/><verse number="2" style="v" sid="LUK 4:2"/>Ibilisi 40 qien shiizho. Hhe udulade <char style="pn">Ersa</char> yama ese ijiezhi udu kuruse oliesuzho. <verse eid="LUK 4:2"/><verse number="3" style="v" sid="LUK 4:3"/>Ibilisi kieliewo, "Chi Hudai Kewon enbese ene tashii fenfulazhi ginan gholugha." <verse eid="LUK 4:3"/><verse number="4" style="v" sid="LUK 4:4"/><char style="pn">Ersa</char> hhende kieliewo, "Jinwun jiere huaizho, 'Kun amitushi zinie ginande ulie kouine.'"<verse eid="LUK 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 4:5"/>Ibilisi hhei uduruzhi khireidene nie shanjien giekude duyani soyuji gojialani man uzheghawo. <verse eid="LUK 4:5"/><verse number="6" style="v" sid="LUK 4:6"/>Hhende kieliewo, "Ene gojialani qienli, zui gounilai man chade ogiye. Eneshi minughun wo. Bi kiende ogiku duranshi kiende ogine. <verse eid="LUK 4:6"/><verse number="7" style="v" sid="LUK 4:7"/>Chi mii beiise enela man chinughun gholune." <verse eid="LUK 4:7"/><verse number="8" style="v" sid="LUK 4:8"/><char style="pn">Ersa</char> hhende kieliewo, "Jinwun jiere huaizho, 'Zinie Ezhan Hudane beiizhi hhei shunji.'"<verse eid="LUK 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 4:9"/>Ingiedene Ibilisi <char style="pn">Ersa</char>i uduruzhi <char style="png">Yelusalen</char>de echi mechii zui undu oronde beigha kieliewo, "Chi Hudai kewon enbese enense jiuli bou. <verse eid="LUK 4:9"/><verse number="10" style="v" sid="LUK 4:10"/>Jinwun jiere,</para>
  <para style="q1" vid="LUK 4:10">'Hhe chade oluzhi qienxienladene fenfulazhi chii baohu giene.<verse eid="LUK 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LUK 4:11"/>Khaghalani chii feizhi konnichii</para>
  <para style="q2" vid="LUK 4:11">tashi jiere ulie mughughane.'</para>
  <para style="m" vid="LUK 4:11">giezhi huaizho." <verse eid="LUK 4:11"/><verse number="12" style="v" sid="LUK 4:12"/><char style="pn">Ersa</char> hhende kieliewo, "Ezhan Hudane bu shii giezhi jinwun jiere kieliezho."<verse eid="LUK 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 4:13"/>Ibilisi ingiezhi shiidene pse gou jihui iretula <char style="pn">Ersa</char>se likai giewo.<verse eid="LUK 4:13"/></para>
  <para style="s">Jialilise Chonji Qiizho</para>
  <para style="r">(<ref loc="MAT 4:12-17">Mat 4:12-17</ref>; <ref loc="MRK 1:14-15">Mak 1:14-15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14"/>Ingiedene <char style="pn">Ersa</char>de Shenlinni nenli duruzhi <char style="png">Jialili</char>de khareizhi irewo. Minshenyini kunla man zhouwide kieliezho. <verse eid="LUK 4:14"/><verse number="15" style="v" sid="LUK 4:15"/><char style="pn">Ersa</char> hhelai huitanlade sughazhi qiise kunla hhe surughasan gou wo giezho.<verse eid="LUK 4:15"/></para>
  <para style="s">Nasale Kunla Ersai Fandui Giezho</para>
  <para style="r">(<ref loc="MAT 13:53-58">Mat 13:53-58</ref>; <ref loc="MRK 6:1-6">Mak 6:1-6</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16"/>
    <char style="pn">Ersa</char> goya fugiedasan <char style="png">Nasale</char>de irewo. Hhamuraku udude chanqiku guijinghala huitande orowo. Jinwun onshine giezhi beise <verse eid="LUK 4:16"/><verse number="17" style="v" sid="LUK 4:17"/>kunla <char style="pn">Isaiya</char> xienzhini shuni hhende ogiwo. Hhe keighadene ereizhi idon onshiwo,<verse eid="LUK 4:17"/></para>
  <para style="q1">
    <verse number="18-19" style="v" sid="LUK 4:18-19"/>"Ezhanni Ruhher mini jiere wine.</para>
  <para style="q2" vid="LUK 4:18-19">Mii sunghuzhi jiahui kunlade gouxioxini chonjighawo.</para>
  <para style="q1" vid="LUK 4:18-19">Hhe mini peizhi kunlade man kielieghawo.</para>
  <para style="q2" vid="LUK 4:18-19">Bareisan kunlai andaghane.</para>
  <para style="q2" vid="LUK 4:18-19">Nudun sugho olusan kunlai goudaghane.</para>
  <para style="q2" vid="LUK 4:18-19">Qifulasan kunlai pse ulie qifulaghane.</para>
  <para style="q1" vid="LUK 4:18-19">Huda jiuiku shihou kuzhewo."<verse eid="LUK 4:18-19"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="20" style="v" sid="LUK 4:20"/>
    <char style="pn">Ersa</char> jinwunni horo agi gonjisan kunde ogidene souwo. Huitanni kunla man hhei xianxide uzhezho. <verse eid="LUK 4:20"/><verse number="21" style="v" sid="LUK 4:21"/><char style="pn">Ersa</char> hhelade kieliewo, "Enedu ene jinwun tani dunda chenjiwo".<verse eid="LUK 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 4:22"/>Kunla man kieliezhi ene kun oluzho giezho. Jianjisan kielienyini chenliedene kunla man ghudurezhi eneshi <char style="pn">Yusufu</char>ni kewon pushonu giezho.<verse eid="LUK 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 4:23"/>
    <char style="pn">Ersa</char> hhelade kieliewo, "Ta kenjin 'Daifu, chi goyane goudagha.' giesan kienni kielienghala made kieliezhi 'Bijien chenliese <char style="png">Jiabainun</char>de chi giesan fugie shiqinyi goya aghindeneye gie.' giezhi kieliene." <verse eid="LUK 4:23"/><verse number="24" style="v" sid="LUK 4:24"/><char style="pn">Ersa</char> pse kieliewo, "Bi tande shuhua kielieye, xienzhini goya aghindene jienliechen kun uwo. <verse eid="LUK 4:24"/><verse number="25" style="v" sid="LUK 4:25"/>Bi tande shuhua kielieye, <char style="pn">Iliya</char> xienzhini shihoude 3 nienban ghura ese bouzhi honnien gholukude <char style="png">Isilie</char>de guafu olon woma, <verse eid="LUK 4:25"/><verse number="26" style="v" sid="LUK 4:26"/><char style="pn">Iliya</char>i khalama ese echighadene <char style="png">Xidun</char> oronni <char style="png">Salefa</char>ni guafude peizhi echighawo. <verse eid="LUK 4:26"/><verse number="27" style="v" sid="LUK 4:27"/>Pse <char style="pn">Ilisha</char> xienzhini shihoude <char style="png">Isilie</char>de pifugientu olon woma, zinie <char style="png">Xiliya</char>ni <char style="pn">Naiman</char>ni goudaghawo."<verse eid="LUK 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 4:28"/>Huitanni kunla chenliedene hende hokuzho. <verse eid="LUK 4:28"/><verse number="29" style="v" sid="LUK 4:29"/>Ingie kunla man bosi iredene <char style="pn">Ersa</char>ni laizhi chenmen ghadane khireighawo. Hhe chenshi ula jiere wo. Hhela <char style="pn">Ersa</char>ni laizhi eghei ghizhade echidene tunguzhi boughane giese, <verse eid="LUK 4:29"/><verse number="30" style="v" sid="LUK 4:30"/><char style="pn">Ersa</char> kharei hhelani dundaghun yo dao wo.<verse eid="LUK 4:30"/></para>
  <para style="s">Zannan Ruhherni Tou Khighazho</para>
  <para style="r">(<ref loc="MRK 1:21-28">Mak 1:21-28</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31"/>Ingiedene <char style="pn">Ersa</char> <char style="png">Jialili</char>ni nie chenshi <char style="png">Jiabainun</char>de bouzhi echiwo. Hhamuraku udude kunlade sughazhi kieliezho. <verse eid="LUK 4:31"/><verse number="32" style="v" sid="LUK 4:32"/>Chenliesan kunla hhe sughasande ghanirazho, hhe kieliesande qienli wine. <verse eid="LUK 4:32"/><verse number="33" style="v" sid="LUK 4:33"/>Hhe huitande nie kunni sheitan heizho. Fugiede waradazhi kieliewo, <verse eid="LUK 4:33"/><verse number="34" style="v" sid="LUK 4:34"/>"Ei! <char style="png">Nasale</char> kun <char style="pn">Ersa</char>, chi bijienyi jiohoro bu gie. Chi bijienyi widaghale irewu? Chishi kien bikui bi mejiene. Chishi Hudase iresan hhe zhiguitu wo." <verse eid="LUK 4:34"/><verse number="35" style="v" sid="LUK 4:35"/><char style="pn">Ersa</char> hhei sugiezhi kieliewo, "Amanne menji. Ene kunni jierese khizhe!" Sheitan hhe kunni kunlai melie benda kijieghadene jieresei khizhewo. Hhe kunyi yama ese shanjiwo. <verse eid="LUK 4:35"/><verse number="36" style="v" sid="LUK 4:36"/>Kunla man ghanirazhi nieniedene kielienduzho, "Ene daoli zhengiejia gou wo. Hhende qienli wine, nenliye wine. Hhe zannan ruhherde minlin xiaise khizhene." <verse eid="LUK 4:36"/><verse number="37" style="v" sid="LUK 4:37"/>Ingie <char style="pn">Ersa</char>ni xioxii hhe oronde man chonji kurughawo.<verse eid="LUK 4:37"/></para>
  <para style="s">Olon Kunlani Goudaghazho</para>
  <para style="r">(<ref loc="MAT 8:14-17">Mat 8:14-17</ref>; <ref loc="MRK 1:29-34">Mak 1:29-34</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38"/>
    <char style="pn">Ersa</char> huitanse khizhedene <char style="pn">Ximun</char>ni giede echise ghadunmekieni fashao giezhi jindaghazho. Kunla hheni goudagha giezhi <char style="pn">Ersa</char>ni xiahua giezho. <verse eid="LUK 4:38"/><verse number="39" style="v" sid="LUK 4:39"/><char style="pn">Ersa</char> hheni shida beizhi gienyini sugiezhi nie kieliese fashao giesan daowo. Hhe deigo bosizhe hhelai ushila qiiwo.<verse eid="LUK 4:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40"/>Naran pudakude kunla yanyanji giemeresan kunlai man <char style="pn">Ersa</char>i shida uduru irewo. <char style="pn">Ersa</char> nienieji khaghalane maqise hhela man goudawo. <verse eid="LUK 4:40"/><verse number="41" style="v" sid="LUK 4:41"/>Pse sheitanla olon kunlai jierese khizhedene fugiede waradazhi kieliewo, "Chishi Hudai Kewon wo!" <char style="pn">Ersa</char> hhelai sugiezhi kielien ese kielieghazho, sheitanla hheshi Mexiha bikui mejiene.<verse eid="LUK 4:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42"/>Ogheikude <char style="pn">Ersa</char> khizhedene hontande echiwo. Kunla <char style="pn">Ersa</char>ni izhi ereizho. Ereizhi oludene hhei ulie echighane giezho. <verse eid="LUK 4:42"/><verse number="43" style="v" sid="LUK 4:43"/><char style="pn">Ersa</char> hhelade kieliewo, "Bi psedu oronlade echizhi Hudai gojiani gouxioxini chonjine. Mii ene shiqinde peizhi ireghawo." <verse eid="LUK 4:43"/><verse number="44" style="v" sid="LUK 4:44"/>Ingiedene <char style="pn">Ersa</char> <char style="png">Yudaya</char>ni huitanlade echizhi daoli chonjizho.<verse eid="LUK 4:44"/></para>
  <chapter eid="LUK 4"/>
  <chapter number="5" style="c" sid="LUK 5"/>
  <para style="s">Tujilani Uruzho</para>
  <para style="r">(<ref loc="MAT 4:18-22">Mat 4:18-22</ref>; <ref loc="MRK 1:16-20">Mak 1:16-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1"/>Niudude <char style="pn">Ersa</char> <char style="png">Genisale</char>ni hu ghizhade beizho. Olon kun jigheidazhi Hudai kielienni chenliene giezho. <verse eid="LUK 5:1"/><verse number="2" style="v" sid="LUK 5:2"/><char style="pn">Ersa</char> uzhese hu ghizhade ghua chon beizho. Zhaghasun bareisan kunla chon jiere uwo, on waghazhi souzho. <verse eid="LUK 5:2"/><verse number="3" style="v" sid="LUK 5:3"/><char style="pn">Ersa</char> <char style="pn">Ximun</char>yi chon jiere khireidene <char style="pn">Ximun</char>de kieliewo, "Chonne bienzise usu dunda daogha." Ingie chon jiere soudene olon kunlade sughawo. <verse eid="LUK 5:3"/><verse number="4" style="v" sid="LUK 5:4"/>Jianji baludene <char style="pn">Ximun</char>de kieliewo, "Chi chonne keizhi usui gun oronde echi on xiaizhi zhaghasun barei." <verse eid="LUK 5:4"/><verse number="5" style="v" sid="LUK 5:5"/><char style="pn">Ximun</char> kieliewo, "Bijien nie xii bareise yama barei dawoma, chii kielien mutun bi onni xiaiye." <verse eid="LUK 5:5"/><verse number="6" style="v" sid="LUK 5:6"/>Ingie onni xiaidene zhaghasun texien olon bareizhi onni bii gha olughakui xianli. <verse eid="LUK 5:6"/><verse number="7" style="v" sid="LUK 5:7"/>Hhela kha rouizhi psedu chon jieredu kunlai banman giele ire giezho. Hhela iredene ghua chon jiere zhaghasunyi durughase chon pudane giezho. <verse eid="LUK 5:7"/><verse number="8" style="v" sid="LUK 5:8"/><char style="pn">Ximun-Beduru</char> ene shiqinni uzhedene <char style="pn">Ersa</char>ni melie papalazhi kieliewo, "Ezhan, chi mase likai gie, bishi zuiren wo!" <verse eid="LUK 5:8"/><verse number="9" style="v" sid="LUK 5:9"/><char style="pn">Ximun</char> hhantuku kunla zhaghasun texien olon bareise uzhe beizho. <verse eid="LUK 5:9"/><verse number="10" style="v" sid="LUK 5:10"/><char style="pn">Xibitai</char>ni kewon <char style="pn">Yagebu</char>, <char style="pn">Yaheiya</char>shi <char style="pn">Ximun</char>yi nokie wo. Hhelaye uzhe beizho. Ingie <char style="pn">Ersa</char> <char style="pn">Ximun</char>de kieliewo, "Bu ayi. Enedu khuinase chi kun louine." <verse eid="LUK 5:10"/><verse number="11" style="v" sid="LUK 5:11"/>Hhela chonlai haibienzide khizhegha soyujilane man jiedene hhei daghawo.<verse eid="LUK 5:11"/></para>
  <para style="s">Pifugientuni Goudaghazho</para>
  <para style="r">(<ref loc="MAT 8:1-4">Mat 8:1-4</ref>; <ref loc="MRK 1:40-45">Mak 1:40-45</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12"/>Niefade <char style="pn">Ersa</char> chenshide bikude hhende nie hunshendeni pifugientu kun wine. Hhe <char style="pn">Ersa</char>i chanlasenu papaladene xiahua giewo, "Ezhan, chi duran bise mini ganjinragha shidane." <verse eid="LUK 5:12"/><verse number="13" style="v" sid="LUK 5:13"/><char style="pn">Ersa</char> khane zhighazhi hhei maqizhi kieliewo, "Bi duran wine. Chi ganjinra." Ene kielienni dei kieliese pifugienni goudawo. <verse eid="LUK 5:13"/><verse number="14" style="v" sid="LUK 5:14"/><char style="pn">Ersa</char> hhende fenfulazhi kieliewo, "Chi kiemade bu kieliedene echizhi beyene buwade uzhegha. <char style="pn">Musa</char>i shu jiere fenfulasan mutun beyechii ganjinrasande oluzhi Hudade mure ogizhi kunlade ganzhen bei." <verse eid="LUK 5:14"/><verse number="15" style="v" sid="LUK 5:15"/>Ingieliuzhe <char style="pn">Ersa</char>ni minshen yebeiseye fugiedazho. Olon kunla <char style="pn">Ersa</char>ni kielienni chenliezhi gienne goudaghale irezhoma, <verse eid="LUK 5:15"/><verse number="16" style="v" sid="LUK 5:16"/><char style="pn">Ersa</char> tuidene hontande onxian giele echizho.<verse eid="LUK 5:16"/></para>
  <para style="s">Tanhon Gientuni Goudaghazho</para>
  <para style="r">(<ref loc="MAT 9:1-8">Mat 9:1-8</ref>; <ref loc="MRK 2:1-12">Mak 2:1-12</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17"/>Niudude <char style="pn">Ersa</char> kunlade surughakude Falisai kun, jinwun loushila kanzideni souzho. Enela <char style="png">Jialili</char>, <char style="png">Yudaya</char>ni go aghin, <char style="png">Yelusalen</char>se irezho. Hudai nenli <char style="pn">Ersa</char>ghala hhantu bizhi kunlai gienni goudaghazho. <verse eid="LUK 5:17"/><verse number="18" style="v" sid="LUK 5:18"/>Kunla ruzide nie tanhon giesan gientui qienliezhi <char style="pn">Ersa</char>i shida echine giese <verse eid="LUK 5:18"/><verse number="19" style="v" sid="LUK 5:19"/>kun olonshi echi dazho. Ingiesenu gie jiere khirei wani agidene ruzide bareizhi <char style="pn">Ersa</char>i melie boughawo. <verse eid="LUK 5:19"/><verse number="20" style="v" sid="LUK 5:20"/><char style="pn">Ersa</char> hhelai xianxin giekui uzhedene kieliewo, "Zhanlien, chii zuini mienliewo." <verse eid="LUK 5:20"/><verse number="21" style="v" sid="LUK 5:21"/>Ingiese jinwun hanjia, Falisai kunla kieliendu qiiwo, "Imutu kufurei fanjichen kunshi kien wine? Hudase chugo zuini kien mienliene?" <verse eid="LUK 5:21"/><verse number="22" style="v" sid="LUK 5:22"/><char style="pn">Ersa</char> hhela sumulasanni mejiedene kieliewo, "Ta yangiezhi zhughedene imutui sumulane? <verse eid="LUK 5:22"/><verse number="23" style="v" sid="LUK 5:23"/>Chii zuini mienliewo giese sunfan onu, bosizhe yo giese sunfan wo? <verse eid="LUK 5:23"/><verse number="24" style="v" sid="LUK 5:24"/>Ingieseye Kunnikewon duyade zuini mienlieku qienli bikui tande mejieghane giezho." Ingiedene tanhon giesan gientude kieliewo, "Bi chade kielieye, bosizhedene ruzine agi giedene echi."<verse eid="LUK 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 5:25"/>Hhe kun kunlai melie deigo bosi ruzine agisenu Hudai kuaizhi giedene echiwo. <verse eid="LUK 5:25"/><verse number="26" style="v" sid="LUK 5:26"/>Kunla man ghanira beizho. Zhughesene ayizhi Hudai kuaizhi kieliezho, "Enedu bijien nie fugie shiqin uzhewo!"<verse eid="LUK 5:26"/></para>
  <para style="s">Liwini Uruzho</para>
  <para style="r">(<ref loc="MAT 9:9-13">Mat 9:9-13</ref>; <ref loc="MRK 2:13-17">Mak 2:13-17</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27"/>Enese khuinashi <char style="pn">Ersa</char> khireidene shui shanjisan <char style="pn">Liwi</char> giesan nie kun shui shanjisan oronde sousei chanlawo. <char style="pn">Ersa</char> hhende kieliewo, "Chi mii dagha." <verse eid="LUK 5:27"/><verse number="28" style="v" sid="LUK 5:28"/>Ingie hhe man benda jie bosizhedene <char style="pn">Ersa</char>i daghawo.<verse eid="LUK 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 5:29"/>
    <char style="pn">Liwi</char> <char style="pn">Ersa</char>de oluzhi giedene fugiede xi beilawo. Shui shanjisan tebieji olon kunla psedu kunlare hhantu xi souzho. <verse eid="LUK 5:29"/><verse number="30" style="v" sid="LUK 5:30"/>Falisai kun, hhelai jinwun hanjiala <char style="pn">Ersa</char>ni tujilani sugiezhi kieliezho, "Ta yale shui shanjisan kun, zuirenlare hhantu ijiezhi ochine?" <verse eid="LUK 5:30"/><verse number="31" style="v" sid="LUK 5:31"/><char style="pn">Ersa</char> kieliewo, "Gien witu kunla deifu ulie kerene. Gientula deifu kerene. <verse eid="LUK 5:31"/><verse number="32" style="v" sid="LUK 5:32"/>Bi irese gou kunlai ereile ese irezho, zuirenlani geizhen gieghale irezho."<verse eid="LUK 5:32"/></para>
  <para style="s">Orozo Bareiku</para>
  <para style="r">(<ref loc="MAT 9:14-17">Mat 9:14-17</ref>; <ref loc="MRK 2:18-22">Mak 2:18-22</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33"/>Hhela kieliewo, "<char style="pn">Yaheiya</char>ni tujila chan orozo bareizhi onxian giezho. Falisai kunni tujilaye ingiezhi giezho. Zinie chii tujila jin ochizhi ijiezho." <verse eid="LUK 5:33"/><verse number="34" style="v" sid="LUK 5:34"/><char style="pn">Ersa</char> hhelade kieliewo, "Ghurunde iresan zhochenla shini khughon bikude matugie orozo bareine? <verse eid="LUK 5:34"/><verse number="35" style="v" sid="LUK 5:35"/>Shini khughonni kunla lai echiku udu kuzhene. Hhe udude hhela orozo bareine."<verse eid="LUK 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 5:36"/>
    <char style="pn">Ersa</char> pse bilazhi hhelade kieliewo, "Shini jienne ghighazhi khuichen jien jiere huduchen kun uwo. Qingiese shini jien tanturawo. Pse ghigha bouzhesan hhe nie shidu khuichenni jiere ulie talane. <verse eid="LUK 5:36"/><verse number="37" style="v" sid="LUK 5:37"/>Shini jiuni khuichen tulunde zhonlochen kun uwo. Qingie zhonlose shini jiu tulunni ghalughazhi jiu usuru khizhese tulunye qida olune. <verse eid="LUK 5:37"/><verse number="38" style="v" sid="LUK 5:38"/>Shini jiuni shini tulunde zhonlone. <verse eid="LUK 5:38"/><verse number="39" style="v" sid="LUK 5:39"/>Kunla khuichen jiu ochidene shini jiu ochiku duran uwo. Hhela kieliese khuichenni gou wo giene."<verse eid="LUK 5:39"/></para>
  <chapter eid="LUK 5"/>
  <chapter number="6" style="c" sid="LUK 6"/>
  <para style="s">Hhamuraku Udude Boudei Qiorun Sidazho</para>
  <para style="r">(<ref loc="MAT 12:1-8">Mat 12:1-8</ref>; <ref loc="MRK 2:23-28">Mak 2:23-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1"/>Nie hhamuraku udude <char style="pn">Ersa</char> boudei ghazhaghun yozhi daokude tujilani boudei qiorunni sidadene huluzhi ijiezho. <verse eid="LUK 6:1"/><verse number="2" style="v" sid="LUK 6:2"/>Niezhan Falisai kunla kieliewo, "Ta yangiezhi hhamuraku udude ulie giekui giene?" <verse eid="LUK 6:2"/><verse number="3" style="v" sid="LUK 6:3"/><char style="pn">Ersa</char> hhelade kieliewo, "<char style="pn">Dawude</char> hhantuku kunlarene oliesukude giesan shiqinyi ta onshizhi ese daowu? <verse eid="LUK 6:3"/><verse number="4" style="v" sid="LUK 6:4"/>Hhe Hudai giede orodene Hudade ogiku ginanyi bareidene ijiewo. Pse hhantuku kunladene ogiwo. Ene ginanyi buwase andase kiema ijiezhi ulie olune." <verse eid="LUK 6:4"/><verse number="5" style="v" sid="LUK 6:5"/><char style="pn">Ersa</char> pse hhelade kieliewo, "Kunnikewonshi hhamuraku uduni Ezhan wo."<verse eid="LUK 6:5"/></para>
  <para style="s">Ghosan Khanni Goudaghazho</para>
  <para style="r">(<ref loc="MAT 12:9-14">Mat 12:9-14</ref>; <ref loc="MRK 3:1-6">Mak 3:1-6</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6"/>Pse nie hhamuraku udude <char style="pn">Ersa</char> huitande orodene kunlade sughazho. Hhende nie borun khani ghosan kun wine. <verse eid="LUK 6:6"/><verse number="7" style="v" sid="LUK 6:7"/>Jinwun hanjia, Falisai kunla <char style="pn">Ersa</char> hhamuraku udude goudaghase zhaku zhenji ereine giezhi ghulazhi uzhezho. <verse eid="LUK 6:7"/><verse number="8" style="v" sid="LUK 6:8"/><char style="pn">Ersa</char> hhela sumulasei mejiedene khani ghosan kunde kieliewo, "Bosizhedene dunda bei." Ingie hhe kun bosizhedene beiwo. <verse eid="LUK 6:8"/><verse number="9" style="v" sid="LUK 6:9"/><char style="pn">Ersa</char> hhelade kieliewo, "Bi tande asaye, hhamuraku udude gouni giese gou onu huaini giese gou wo? Aminni jiuinu, heine? Alinie oluzho?" <verse eid="LUK 6:9"/><verse number="10" style="v" sid="LUK 6:10"/>Ingie zhouwini kunlai uzhedene hhe kunde khane khizhegha giese khizheghase khani goudawo. <verse eid="LUK 6:10"/><verse number="11" style="v" sid="LUK 6:11"/>Ingiese hhela hende hokudene <char style="pn">Ersa</char>i matugiene giezhi shanlian giezho.<verse eid="LUK 6:11"/></para>
  <para style="s">Ersa 12 Gie Shitu Sunghuwo</para>
  <para style="r">(<ref loc="MAT 10:1-4">Mat 10:1-4</ref>; <ref loc="MRK 3:13-19">Mak 3:13-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12"/>Hhe xienzide <char style="pn">Ersa</char> ulade khireidene nie xii Hudase onxian giewo. <verse eid="LUK 6:12"/><verse number="13" style="v" sid="LUK 6:13"/>Ogheikude tujilane uru iredene hhelai dundase 12 gie kun sunghudene shitu danlaghawo. <verse eid="LUK 6:13"/><verse number="14" style="v" sid="LUK 6:14"/>Hhelai niereshi <char style="pn">Ximun</char> (<char style="pn">Ersa</char> <char style="pn">Ximun</char>de niere ogise <char style="pn">Beduru</char> giene), hhei jiu <char style="pn">Andelie</char>, <char style="pn">Yagebu,</char> <char style="pn">Yaheiya</char>, <char style="pn">Feili</char>, <char style="pn">Badolomai</char>, <verse eid="LUK 6:14"/><verse number="15" style="v" sid="LUK 6:15"/><char style="pn">Matai</char>, <char style="pn">Doma</char>, <char style="pn">Yalefei</char>ni kewon <char style="pn">Yagebu</char>, Rexinpai giezhi urusan <char style="pn">Ximun</char>, <verse eid="LUK 6:15"/><verse number="16" style="v" sid="LUK 6:16"/><char style="pn">Yagebu</char>ni kewon <char style="pn">Yuda</char>, pse <char style="pn">Ersa</char>i ghudandusan <char style="png">Jialie</char> kun <char style="pn">Yuda</char> wo.<verse eid="LUK 6:16"/></para>
  <para style="s">Olon Kun Ersani Daghazho</para>
  <para style="r">(<ref loc="MAT 4:23-25">Mat 4:23-25</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 6:17"/>
    <char style="pn">Ersa</char> hhelare hhantu boudene pin oronde beiwo. Olon tujilaye hhantu wo. Pse tebieji olon bexinla <char style="png">Yudaya</char>, <char style="png">Yelusalen</char>, haibienzini <char style="png">Tuilo</char>, <char style="png">Xidun</char>se man irezho. <verse eid="LUK 6:17"/><verse number="18" style="v" sid="LUK 6:18"/>Hhela <char style="pn">Ersa</char> jianjisan kielienni chenliezhi gientulai goudaghase giezho. Sudoro zannan ruhher orosan kunlai goudaghawo. <verse eid="LUK 6:18"/><verse number="19" style="v" sid="LUK 6:19"/>Kunla man <char style="pn">Ersa</char>i maqine giezho. Hhei nenli khizhese gientulai man goudaghane.<verse eid="LUK 6:19"/></para>
  <para style="s">Fuqi Gou Widakughala</para>
  <para style="r">(<ref loc="MAT 5:1-12">Mat 5:1-12</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20"/>
    <char style="pn">Ersa</char> qiorunne qila tujilane uzhedene kieliewo,</para>
  <para style="q1" vid="LUK 6:20">"Jiahui kunlade fuqi wine,</para>
  <para style="q2" vid="LUK 6:20">Hudai gojiashi tanughun wo.<verse eid="LUK 6:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LUK 6:21"/>Ede oliesusan kunlade fuqi wine,</para>
  <para style="q2" vid="LUK 6:21">ta chudune.</para>
  <para style="q1" vid="LUK 6:21">Ede wilasan kunlade fuqi wine,</para>
  <para style="q2" vid="LUK 6:21">ta bayasune.<verse eid="LUK 6:21"/></para>
  <para style="b"/>
  <para style="m">
    <verse number="22" style="v" sid="LUK 6:22"/>Mii yenyinghala kunla tai henjizhi fandui giene, shizheghazhi doghun kun danlaghadene minshenyi bixindaghase tande fuqi wine. <verse eid="LUK 6:22"/><verse number="23" style="v" sid="LUK 6:23"/>Hhe shihoude ta bayasuzhi jiulindu, asiman jiere tande ogiku jianli fugie wo. Tani xienrenlaye xienzhilani ingiezhi fandui giezho.<verse eid="LUK 6:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="LUK 6:24"/>Ta bayan kunlade gou widawo,</para>
  <para style="q2" vid="LUK 6:24">ta xianshou gie kuruwo.<verse eid="LUK 6:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="LUK 6:25"/>Ede chudusan kunlade gou widawo,</para>
  <para style="q2" vid="LUK 6:25">ihou ta oliesune.</para>
  <para style="q1" vid="LUK 6:25">Ede bayasusan kunlade gou widawo,</para>
  <para style="q2" vid="LUK 6:25">ihou ta houhui giezhi wilane.<verse eid="LUK 6:25"/></para>
  <para style="b"/>
  <para style="m">
    <verse number="26" style="v" sid="LUK 6:26"/>Kunla man tai kuaiku shihoude tande gou widawo, hhelai xienrenlaye jia xienzhilai ingiezhi kuaizhi daozho."<verse eid="LUK 6:26"/></para>
  <para style="s">Duitoudene Orendu</para>
  <para style="r">(<ref loc="MAT 5:38-48">Mat 5:38-48</ref>; <ref loc="MAT 7:12">7:12</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27"/>"Ingieliuzhe kielienyimi chenliesan kunlade bi kielieye. Duitoudene ore, tani henjisan kunlade goude gie. <verse eid="LUK 6:27"/><verse number="28" style="v" sid="LUK 6:28"/>Tani sugiesan kunlade gouni kielie. Tai peichilasan kunlade oluzhi onxian gie. <verse eid="LUK 6:28"/><verse number="29" style="v" sid="LUK 6:29"/>Kunla niemien khizhaichii eghise pse niemienne eghigha. Kunla chii mienzii jienni agi echise lizii jienneye ogi. <verse eid="LUK 6:29"/><verse number="30" style="v" sid="LUK 6:30"/>Kunla xiahua giezhi kerese ogi. Tani dunxilani agi echise kerezhi bu ire. <verse eid="LUK 6:30"/><verse number="31" style="v" sid="LUK 6:31"/>Ta kunlai goyadene matugie gieghaku duranshi taye kunlade qingiezhi gie."<verse eid="LUK 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 6:32"/>"Ta zinie tande oresan kunlade orese yan gou wo? Zuirenlaye goya oresan kunladene orene. <verse eid="LUK 6:32"/><verse number="33" style="v" sid="LUK 6:33"/>Ta zinie tande goude giesan kunlade goude giese kunlase yan gou wo? Zuirenlaye ingiezhi giene. <verse eid="LUK 6:33"/><verse number="34" style="v" sid="LUK 6:34"/>Ta baer asughuzhi ogikude goyane ogine giesan hhe kunlade ogise kunlase yan gou wo? Zuirenlaye zuirenlade asughuzhi ogidene yen khareizhi kerene."<verse eid="LUK 6:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 6:35"/>"Ta duitoudene ore. Hhelade goude gie. Baer asughuzhi ogise khareizhi ogi dakuse bu ayi. Qingiezhi giese tande jianli olon wo, Zui Undu Hudai kewosi gholune. Huda nenjienni matasan kun, doghun kunlade man goude giene. <verse eid="LUK 6:35"/><verse number="36" style="v" sid="LUK 6:36"/>Adatai ubali xiiku mutun taye qingiezhi ubali xii."<verse eid="LUK 6:36"/></para>
  <para style="s">Kunlai Bu Kielie</para>
  <para style="r">(<ref loc="MAT 7:1-5">Mat 7:1-5</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 6:37"/>"Kunlai bu kielie, taiye ulie kieliene. Kunlade zui bu jinji, tandeye zui ulie jinjine. Kunlani roulie, taiye rouliene. <verse eid="LUK 6:37"/><verse number="38" style="v" sid="LUK 6:38"/>Kunlade ogi, ingiese tande khareizhi ogine. Tande ogise gashende sidaghazhi daruzhi moighazhi olon ogine. Ta kunlade yanghala nanjizhi ogise tandeye yanghala nanjizhi ogine."<verse eid="LUK 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 6:39"/>
    <char style="pn">Ersa</char> pse hhelade bilazhi kieliewo, "Sugho sughone uduru shidanu? Qingiese ghuala nokiende anda ulie bounu? <verse eid="LUK 6:39"/><verse number="40" style="v" sid="LUK 6:40"/>Xieshen loushise fugie uwo. Xieshenla man suru baraghase loushighala jian pindane. <verse eid="LUK 6:40"/><verse number="41" style="v" sid="LUK 6:41"/>Chi yangiezhi gaijiune nudundedu osun zhazhai chanlane, goya nudundedu lianni chanla dane? <verse eid="LUK 6:41"/><verse number="42" style="v" sid="LUK 6:42"/>Chi goya nudundedu lianni chanla dadene matui 'Gaijiu, bi chini nudundedu osun zhazhai agiye.' giezhi kieliene? Chi ene jiazhon giesan kun, xien goya nudundedu lianni agidene uzhezhi qinchu olusenu gaijiune nudundedu osun zhazhai agi."<verse eid="LUK 6:42"/></para>
  <para style="s">Mutun Alimani Bilazho</para>
  <para style="r">(<ref loc="MAT 7:16-20">Mat 7:16-20</ref>; <ref loc="MAT 12:33-35">12:33-35</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43"/>"Gou mutun jiere langan alima ulie soune. Langan mutun jiere gou alima ulie soune. <verse eid="LUK 6:43"/><verse number="44" style="v" sid="LUK 6:44"/>Alimani uzhese mutunni tanine. Eghesunse uhuago zhei dane, osunse putouiye zhei dane. <verse eid="LUK 6:44"/><verse number="45" style="v" sid="LUK 6:45"/>Gou kunlai zhughede gounishi yen gouni khizheghane. Doghun kunlai zhughede doghunnishi yen doghunni khizheghane. Zhughede durusei amande kielie khizheghane."<verse eid="LUK 6:45"/></para>
  <para style="s">Ghua Gie</para>
  <para style="r">(<ref loc="MAT 7:24-27">Mat 7:24-27</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46"/>"Ta mini yangiezhi, 'Ezhan, Ezhan!' giezhi waradadene mii kielien mutun ulie giene? <verse eid="LUK 6:46"/><verse number="47" style="v" sid="LUK 6:47"/>Mini enende iredene mii kielienyi chenliedene giesan kun yanni xianli bikui bi tande kielieye. <verse eid="LUK 6:47"/><verse number="48" style="v" sid="LUK 6:48"/>Hhe hoxian nie goude gie beighasan kunyi xianli. Zeminni waizhi gundaghadene jigunni fugie tashi jiere giezho. Fugie usu irezhi gieni chunjiliuzhe ulie gojiolune. <verse eid="LUK 6:48"/><verse number="49" style="v" sid="LUK 6:49"/>Mii kielienyi chenliedene ulie giesan kunshi hoxian jichu ulie waidene gie beighasan kunyi xianli. Usu nie chunjise gie tairewo, pse tairesan fugie wo."<verse eid="LUK 6:49"/></para>
  <chapter eid="LUK 6"/>
  <chapter number="7" style="c" sid="LUK 7"/>
  <para style="s">Baifuzhanni Hojini Goudaghazho</para>
  <para style="r">(<ref loc="MAT 8:5-13">Mat 8:5-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1"/>
    <char style="pn">Ersa</char> ene kielienyi kieliedene <char style="png">Jiabainun</char>de echiwo. <verse eid="LUK 7:1"/><verse number="2" style="v" sid="LUK 7:2"/>Hhende nie baifuzhan zhunshi giesan hojini giemere fugune giezho. <verse eid="LUK 7:2"/><verse number="3" style="v" sid="LUK 7:3"/>Baifuzhan <char style="pn">Ersa</char>i shiqinyi sonosudene hojine goudaghane giezhi <char style="png">Yutai</char> kunni zhanlaolai peizhi <char style="pn">Ersa</char>i xinlaghale echiwo. <verse eid="LUK 7:3"/><verse number="4" style="v" sid="LUK 7:4"/>Hhela <char style="pn">Ersa</char>i shida echidene hende xiahua giezhi kieliezho, "Ene kunde banman giekui enbene. <verse eid="LUK 7:4"/><verse number="5" style="v" sid="LUK 7:5"/>Hhe mai kunlade orezho. Huitanye giezhi ogizho." <verse eid="LUK 7:5"/><verse number="6" style="v" sid="LUK 7:6"/><char style="pn">Ersa</char> hhelare hhantu echiwo. Gie shidai kuzhese baifuzhan zhanlienlane peizhi <char style="pn">Ersa</char>de kielieghale echiwo. "Bijienyi ezhan kieliewo, 'Ezhan, Chi pofan bu gie. Chi mii giede irese bi pei dane. <verse eid="LUK 7:6"/><verse number="7" style="v" sid="LUK 7:7"/>Bi chii jienlieseye pei dane. Chii nie aman kielienshi hojimi goudane. <verse eid="LUK 7:7"/><verse number="8" style="v" sid="LUK 7:8"/>Biye kunlai kha doura wo, buduila mii kha doura wo. Bi buduidene echi giese echine, ire giese irene, enei gie giese hhe giene.'"<verse eid="LUK 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 7:9"/>
    <char style="pn">Ersa</char> enei chenliedene ghanirazhi ochira daghasan olon kunlade kieliewo, "Bi intu xianxin giekui <char style="png">Isilie</char>de uzhezhi uye daozho." <verse eid="LUK 7:9"/><verse number="10" style="v" sid="LUK 7:10"/>Hhe peizhi ireghasan kun kharei echise hojini ijin goudawo.<verse eid="LUK 7:10"/></para>
  <para style="s">Guafuni Kewonni Aminne Olughazho</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11"/>Oloncha ese oludene <char style="pn">Ersa</char> <char style="png">Nain</char> giezhi nie aghinde echiwo. Hhei tuji, tebieji olon kunla man hhantu echiwo. <verse eid="LUK 7:11"/><verse number="12" style="v" sid="LUK 7:12"/>Aghin shida kuzhekude kunla nie fugusan kunni qienlie khizhewo. Guafude niekozi kewonshi fugu widawo. Chenshini tebieji olon kunlaye hhere hhantu wo. <verse eid="LUK 7:12"/><verse number="13" style="v" sid="LUK 7:13"/>Ezhan guafui uzhedene ubali xiizhi bu wila giewo. <verse eid="LUK 7:13"/><verse number="14" style="v" sid="LUK 7:14"/>Ingiedene melieshila danjiani nie maqise qienliesan kunla beiwo. <char style="pn">Ersa</char> kieliewo, "Nasuchighan kun, bi kielieye, chi bosizhe!" <verse eid="LUK 7:14"/><verse number="15" style="v" sid="LUK 7:15"/>Fugusan kun bosizhe kielien kielie qiiwo. Ingie <char style="pn">Ersa</char> anadei jiuizhi ogiwo.<verse eid="LUK 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 7:16"/>Kunla man ayizhi uzhe beidene Hudai kuaizhi kieliezho, "Fugie xienzhi mai shida irewo!" Pse kieliezho, "Huda goya bexinladene banman giezho!" <verse eid="LUK 7:16"/><verse number="17" style="v" sid="LUK 7:17"/><char style="pn">Ersa</char>i shiqinyi <char style="png">Yudaya</char>, pse zhouwini go oronlade man kielie kurughawo.<verse eid="LUK 7:17"/></para>
  <para style="s">Yaheiyani Tujila Ersade Asazho</para>
  <para style="r">(<ref loc="MAT 11:2-19">Mat 11:2-19</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18"/>
    <char style="pn">Yaheiya</char>ni tujila ene shiqinni <char style="pn">Yaheiya</char>de kieliewo. <char style="pn">Yaheiya</char> ghua tujine urudene kieliewo, <verse eid="LUK 7:18"/><verse number="19" style="v" sid="LUK 7:19"/>"Ta Ezhande echidei asa, 'Jianlai irene giesanshi chi onu, pse nie saghei?'"<verse eid="LUK 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 7:20"/>Ghua tujini <char style="pn">Ersa</char>de ire asawo, "Xili gieghasan <char style="pn">Yaheiya</char> bijienni asaghale irewo, 'Jianlai irene giesanshi chi onu, pse nie saghei?'" <verse eid="LUK 7:20"/><verse number="21" style="v" sid="LUK 7:21"/>Zhen ingiekude <char style="pn">Ersa</char> olon gientu, giemeresan kun, sheitan heisan kunlai goudaghawo, sugholaiye chanlaghawo. <verse eid="LUK 7:21"/><verse number="22" style="v" sid="LUK 7:22"/><char style="pn">Ersa</char> kieliewo, "Ta echidene chanlasanyi, sonosusanyi <char style="pn">Yaheiya</char>de kielie. Sugho chanlasanyi, dogholon yosanyi, pifugientui goudaghasanyi, dulei sonosusanyi, fugusan kun aminne olusanyi, pse nanxin kunlade gouxioxi chonjikui kielie." <verse eid="LUK 7:22"/><verse number="23" style="v" sid="LUK 7:23"/>Mii inxin ulie giechen kunde fuqi wine.<verse eid="LUK 7:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24"/>
    <char style="pn">Yaheiya</char> peizhi ireghasan kunla kharei echise <char style="pn">Ersa</char> kunlade <char style="pn">Yaheiya</char>i kieliezho, "Ta hontande yan kunyi uzhele echiwo? Kei feiliese gojiolusan ghulusun mutun zholien kunyi uzhele echiwu? Pusho. <verse eid="LUK 7:24"/><verse number="25" style="v" sid="LUK 7:25"/>Ta yan kunyi uzhele echiwo? Seighan jien musisan kun uzhele echiwu? Uzhe, huahua, gouni musisan kunla hongunde wo. <verse eid="LUK 7:25"/><verse number="26" style="v" sid="LUK 7:26"/>Ta jiujin yan kunyi uzhele echiwo? Xienzhii uzhele echiwu? Enbene. Bi tande kielieye, hhe xienzhise da fugie wo. <verse eid="LUK 7:26"/><verse number="27" style="v" sid="LUK 7:27"/>Jinwun jiere,</para>
  <para style="q1" vid="LUK 7:27">'Uzhe, bi qinsi kunne chii melie peizhi</para>
  <para style="q2" vid="LUK 7:27">chii moni zhunbei gieghane.'</para>
  <para style="m" vid="LUK 7:27">giezhi huaisanshi ene kun wo. <verse eid="LUK 7:27"/><verse number="28" style="v" sid="LUK 7:28"/>Bi tande kielieye, biereila olusan kun dunda <char style="pn">Yaheiya</char>se fugieni nieda uwoma, Hudai gojiade zui meila kun hhense fugie wo."<verse eid="LUK 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 7:29"/>Bexinla, shui shanjisan kunla ene kielienyi chenliedene Hudai daoli oluzho giezho. Hhela ijin <char style="pn">Yaheiya</char>se xili jienliewo. <verse eid="LUK 7:29"/><verse number="30" style="v" sid="LUK 7:30"/>Ingiese Falisai kun, jinwun loushila <char style="pn">Yaheiya</char>se xili ese giezhi Huda hhelade ogisan jihuai ese jienliewo.<verse eid="LUK 7:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31"/>"Bi ene idai kunlai yanghala bilane? Hhela yanni xianli? <verse eid="LUK 7:31"/><verse number="32" style="v" sid="LUK 7:32"/>Hoxian geidoude souzhi nadusan kesilai xianli. Hhela nieniedene waradazhi kieliene,</para>
  <para style="q1" vid="LUK 7:32">'Bijien tande bierei agiku xiu feiliese ta ulie jiuline.</para>
  <para style="q2" vid="LUK 7:32">Kun fuguwo giezhi wilase ta ulie wilane.'<verse eid="LUK 7:32"/></para>
  <para style="m">
    <verse number="33" style="v" sid="LUK 7:33"/>Xili gieghasan <char style="pn">Yaheiya</char> iredene ijiuni ulie ijiezhi, jiu ulie ochise ta hhei jiere sheitan wine giezhi kieliene. <verse eid="LUK 7:33"/><verse number="34" style="v" sid="LUK 7:34"/>Kunnikewon iredene ijiezhi ochise ene kun jin ijiezhi ochikure wo. Shui shanjisan kun, zuirenlani zhanlien wo giezhi ta kielienema, <verse eid="LUK 7:34"/><verse number="35" style="v" sid="LUK 7:35"/>agheli bisan kunla aghelishi gouni bikui mejiene."<verse eid="LUK 7:35"/></para>
  <para style="s">Nie Zuitu Bierei Ersade Xianshui Fureizho</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36"/>Nie Falisai kun <char style="pn">Ersa</char>ni xinlazhi giedene budan ijieghane giezho. <char style="pn">Ersa</char> giedeni echidene shire konde souzho. <verse eid="LUK 7:36"/><verse number="37" style="v" sid="LUK 7:37"/>Hhe chenshide nie biereishi zuiren wo. <char style="pn">Ersa</char> Falisai kunni giede ijiele echikui mejiedene ishighala giesan huapinde xianshuini agizhi irewo. <verse eid="LUK 7:37"/><verse number="38" style="v" sid="LUK 7:38"/><char style="pn">Ersa</char>i khuina iredene kon shidai beizhi wilazho. Nunpusun kon jiereni jienliezhi bouse usunghalane saizho. Kon jiereni izhigie orezhi xianshui fureizho.<verse eid="LUK 7:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 7:39"/>
    <char style="pn">Ersa</char>i xinlasan Falisai kun ene shiqinni chanladene zhughedene sumulawo, "Ene kunshi xienzhi enbese eneni kien moisei mejiene, eneshi zuiren bikuiye mejiene."<verse eid="LUK 7:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 7:40"/>Ingiese <char style="pn">Ersa</char> kieliewo, "<char style="pn">Ximun</char>, bi chade kielieye." <char style="pn">Ximun</char> kieliewo, "Loushi, chi kielie." <verse eid="LUK 7:40"/><verse number="41" style="v" sid="LUK 7:41"/>"Nie kunde ghua kun baer chaine. Nie kun 500 gie miengu chaine. Dou nie kun 50 gie miengu chaine. <verse eid="LUK 7:41"/><verse number="42" style="v" sid="LUK 7:42"/>Baer wizhi honji dazho. Ghualai baerni mienliewo. Ene ghualase alinie hhe kunde olon orene?"<verse eid="LUK 7:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 7:43"/>
    <char style="pn">Ximun</char> kieliewo, "Bi sumulase baer olon chaisan hhe kun olon orene." <char style="pn">Ersa</char> kieliewo, "Chi sumulasan oluzho." <verse eid="LUK 7:43"/><verse number="44" style="v" sid="LUK 7:44"/>Ingiedene bierei miende ochiradene <char style="pn">Ximun</char>de kieliewo, "Chi ene nie biereii uzhe. Bi chii giede orozhese mini konni waghaku usu da ese ogiwo. Ene bierei nunpusunghalane waghazhi usunghalane saizho. <verse eid="LUK 7:44"/><verse number="45" style="v" sid="LUK 7:45"/>Chi made orezhi salan ese giewo, ene bierei bi orozhesanse izhigie mii konde orezho. <verse eid="LUK 7:45"/><verse number="46" style="v" sid="LUK 7:46"/>Chi mii qiorun jiere tosun ese fureizho, ene bierei mii kon jiere gou xianshui fureizho. <verse eid="LUK 7:46"/><verse number="47" style="v" sid="LUK 7:47"/>Bi chade kielieye, hhei giedughon zuini mienliewo. Ene bierei made olon oresei uzhese hheni zuini olon mienliesei mejiene. Choghon mienliesan kun choghon orene."<verse eid="LUK 7:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 7:48"/>Ingie biereide kieliewo, "Chii zuini mienliewo." <verse eid="LUK 7:48"/><verse number="49" style="v" sid="LUK 7:49"/>Hhantu sousan kunla zhughedene sumulazho, "Eneshi yan kun wo? Kunlai zuini mienliene." <verse eid="LUK 7:49"/><verse number="50" style="v" sid="LUK 7:50"/><char style="pn">Ersa</char> biereide kieliewo, "Chii xianxin gieku chii jiuiwo. Pinnan giedene echi."<verse eid="LUK 7:50"/></para>
  <chapter eid="LUK 7"/>
  <chapter number="8" style="c" sid="LUK 8"/>
  <para style="s">Xianxin Giesan Biereila</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1"/>Oloncha ese oludene <char style="pn">Ersa</char> zhouwini chenshi, aghinlade toreizhi Hudai gojiai gouxioxini chonjizho. 12 gie tujiniye hhantu wo. <verse eid="LUK 8:1"/><verse number="2" style="v" sid="LUK 8:2"/>Giedun biereilaye hhantu wo. Enelashi melieshida sheitan heizhi giemeredene goudaghasan wo. Hhelai dunda <char style="png">Modala</char>ni <char style="pn">Mereiyen</char> wine. Hhei jierese dolon sheitan touzhi khizheghawo. <verse eid="LUK 8:2"/><verse number="3" style="v" sid="LUK 8:3"/><char style="pn">Hherode</char>ni gonjia <char style="pn">Kusa</char>ni bierei <char style="pn">Yeyana</char>ye wine. <char style="pn">Susana</char>, psedu biereilaye wine. Hhela goyane baerghala <char style="pn">Ersa</char>tande banman giezho.<verse eid="LUK 8:3"/></para>
  <para style="s">Fure Shizhikuni Bilasan</para>
  <para style="r">(<ref loc="MAT 13:1-9">Mat 13:1-9</ref>; <ref loc="MRK 4:1-9">Mak 4:1-9</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4"/>Olon kunla go chenshise <char style="pn">Ersa</char>i shida irekude <char style="pn">Ersa</char> hhelade bilazhi kieliewo, <verse eid="LUK 8:4"/><verse number="5" style="v" sid="LUK 8:5"/>"Nie kun shizhile echiwo. Shizhikudeni niezhanla mo jiere luise kunla taizhi asiman jieredu bunzhula ijie agiwo. <verse eid="LUK 8:5"/><verse number="6" style="v" sid="LUK 8:6"/>Niezhanla tashitu oronde luise osiwoma, usu uwoshi ghowo. <verse eid="LUK 8:6"/><verse number="7" style="v" sid="LUK 8:7"/>Pse niezhanla eghesun dunda luise eghesunre hhantu osise hhei jigheidawo. <verse eid="LUK 8:7"/><verse number="8" style="v" sid="LUK 8:8"/>Da niezhanla gou ghazhade luise osizhi 100 pei zhonjia souwo." <char style="pn">Ersa</char> enezighan kielienyi kieliedene fugiede kieliewo, "Chighin bitu kunla chenliendu!"<verse eid="LUK 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9"/>Ingiedene tujilani ene bilazhi kieliesanshi yan isi wo giezhi <char style="pn">Ersa</char>de asazho. <verse eid="LUK 8:9"/><verse number="10" style="v" sid="LUK 8:10"/><char style="pn">Ersa</char> kieliewo, "Hudai gojiai mimii tande mejieghawoma, psedu kunlade bilazhi kieliekushi,</para>
  <para style="q1" vid="LUK 8:10">'Hhela uzhese minbai olu dane,</para>
  <para style="q2" vid="LUK 8:10">chenliese dunjire dane.'"<verse eid="LUK 8:10"/></para>
  <para style="s">Bilasanni Mejieghazho</para>
  <para style="r">(<ref loc="MAT 13:18-23">Mat 13:18-23</ref>; <ref loc="MRK 4:13-20">Mak 4:13-20</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11"/>"Eneshi bilasei isi wo. Fureshi Hudai kielien wo. <verse eid="LUK 8:11"/><verse number="12" style="v" sid="LUK 8:12"/>Mo jiereghunshi kun Hudai kielienyi chenliedene Ibilisi ire zhugheseni kielienyi agi echise xianxin gie dazhi jiui dawo. <verse eid="LUK 8:12"/><verse number="13" style="v" sid="LUK 8:13"/>Tashi jiereghunshi kun kielienyi chenliedene bayasuzhi jienliewoma, zhughedeni genzi wise nietan xianxin giedene nie shiise tuiwo. <verse eid="LUK 8:13"/><verse number="14" style="v" sid="LUK 8:14"/>Eghesun dunda luisanshi kun kielienyi chenliedene duyade munan gieku, bayazheku, xianfugiekughala jigheidazhi yama sou dazho. <verse eid="LUK 8:14"/><verse number="15" style="v" sid="LUK 8:15"/>Gou ghazhaghunshi kun kielienyi chenliedene gou lianxintu zhughedene teizhi izhigie rennai giedene zhonjia souwo."<verse eid="LUK 8:15"/></para>
  <para style="s">Zhulani Bilasan Kielien</para>
  <para style="r">(<ref loc="MRK 4:21-25">Mak 4:21-25</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16"/>"Zhulai jienjidene huapinghala khaghachen kun uwo, chonban douraye ulie teine. Zhula teiku teizi jiere jiene. Ingiese kunla orozhese chujieghene. <verse eid="LUK 8:16"/><verse number="17" style="v" sid="LUK 8:17"/>Niuighasanlai ulie khizheghakui uwo. Ghulazhi giesan shiqinlai ulie khizheghazhi ulie mejieghakui uwo. <verse eid="LUK 8:17"/><verse number="18" style="v" sid="LUK 8:18"/>Ingiese ta xioxin giezhi goude chenliendu, bichen kunde pse olon ogine. Wichen kunse goyane wine giesanlainiye agi echine."<verse eid="LUK 8:18"/></para>
  <para style="s">Zhenzhenji Jiawu</para>
  <para style="r">(<ref loc="MAT 12:46-50">Mat 12:46-50</ref>; <ref loc="MRK 3:31-35">Mak 3:31-35</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19"/>
    <char style="pn">Ersa</char>i anani, gaijiulani uzhele irewo. Kun olonshi shidani echi dazho. <verse eid="LUK 8:19"/><verse number="20" style="v" sid="LUK 8:20"/>Kunla <char style="pn">Ersa</char>de kieliewo, "Anachii, gaijiulachii ghadane sagheizhi chii ochirane giezho." <verse eid="LUK 8:20"/><verse number="21" style="v" sid="LUK 8:21"/><char style="pn">Ersa</char> hhelade kieliewo, "Hudai kielienyi chenliedene giesan kunlashi mii ana, gaijiula wo."<verse eid="LUK 8:21"/></para>
  <para style="s">Ersa Honfen Keini Beighaku</para>
  <para style="r">(<ref loc="MAT 8:23-27">Mat 8:23-27</ref>; <ref loc="MRK 4:35-41">Mak 4:35-41</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22"/>Niudude <char style="pn">Ersa</char> tujilarene hhantu chon jiere khireidene hhelade kieliewo, "Matan hu duimiende daoye." Ingie hhela chonni kei yo qiiwo. <verse eid="LUK 8:22"/><verse number="23" style="v" sid="LUK 8:23"/>Zhen yokude <char style="pn">Ersa</char> kijie hhunturazho. Hu jiere menzhali honfen kei bosiwo. Chonde usu oro wixiennudazho. <verse eid="LUK 8:23"/><verse number="24" style="v" sid="LUK 8:24"/>Tujilani echizhi <char style="pn">Ersa</char>i uru xiereigha kieliewo, "Ezhan, a Ezhan! Bijienyi amin widane giezho!" <char style="pn">Ersa</char> xiereidene kei, fugie lanni nie sugiese deigo beiwo. Hu nanranghane gholuwo. <verse eid="LUK 8:24"/><verse number="25" style="v" sid="LUK 8:25"/><char style="pn">Ersa</char> hhelade kieliewo, "Tai xianxin gieku khala wine?" Hhela ayi ghaniradene nieniedene kieliezho, "Eneshi yan kun wo? Kei, usudeye minlin xiaise kielienyini chenliene."<verse eid="LUK 8:25"/></para>
  <para style="s">Sheitan Heisan Kunyi Goudaghazho</para>
  <para style="r">(<ref loc="MAT 8:28-34">Mat 8:28-34</ref>; <ref loc="MRK 5:1-20">Mak 5:1-20</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26"/>Hhela <char style="png">Jialili</char> duimienni <char style="png">Gelasen</char> kunyi oronde kuzhewo. <verse eid="LUK 8:26"/><verse number="27" style="v" sid="LUK 8:27"/>Usu bienzide khireise nie chenshide sheitan heisan kun <char style="pn">Ersa</char>i shida irewo. Ene kun oloncha jien ese musizhi giedene ese souzhi chan meza sudoro souzho. <verse eid="LUK 8:27"/><verse number="28" style="v" sid="LUK 8:28"/>Hhe <char style="pn">Ersa</char>i chanladene papalazhi fugiede kieliewo, "Zui Undu Hudai kewon <char style="pn">Ersa</char>, chi mii jiohoro bu gie. Bi chii xiahua gieye, mii bu zayala!" <verse eid="LUK 8:28"/><verse number="29" style="v" sid="LUK 8:29"/>Melieshida <char style="pn">Ersa</char> minlin xiaizhi zannan ruhheryi hhe kunyi jierese khizhe giezho. Zannan ruhher hhei niefanie bareizho. Khakonyini qieshen jielioghala soziladene sagheiliuzhe sheitanyi lilianghala denji siraghasenu hontande holu echine. <verse eid="LUK 8:29"/><verse number="30" style="v" sid="LUK 8:30"/>Ingiese <char style="pn">Ersa</char> hhende asawo, "Chii nierei yan giene?" Hhe kieliewo, "<char style="pn">Olon</char> giene." Sudoroi orosan sheitan olon wo. <verse eid="LUK 8:30"/><verse number="31" style="v" sid="LUK 8:31"/>Sheitanla <char style="pn">Ersa</char>de, "Bijienyi ibeizi khizhe daku kenzide bu echigha!" giezhi xiahua giezho. <verse eid="LUK 8:31"/><verse number="32" style="v" sid="LUK 8:32"/>Hhe popo jiere idaban khighei ijiezhi souzho. Sheitanla <char style="pn">Ersa</char>de, "Bijienyi hhe khigheila jiere khigha!" giezhi xiahua giezho. <char style="pn">Ersa</char> dain giese <verse eid="LUK 8:32"/><verse number="33" style="v" sid="LUK 8:33"/>sheitanla hhe kunyi jierese khizhedene khigheilai jiere khiwo. Khigheila egheide chunji bou, hude yenji alawo.<verse eid="LUK 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 8:34"/>Khighei adulasan kunla ene shiqin fashen giesei chujieghedene holuzhi chenshi, aghinlade kieliele echiwo. <verse eid="LUK 8:34"/><verse number="35" style="v" sid="LUK 8:35"/>Kunla yan shiqin wo giezhi uzhele irewo. <char style="pn">Ersa</char>i shida ire uzhese sheitan likai giesan kun goudazhi jienne musizhi <char style="pn">Ersa</char>i kon shida souzho. Ingiese hhela ayizho. <verse eid="LUK 8:35"/><verse number="36" style="v" sid="LUK 8:36"/>Shiqinyi chanlasan kunla sheitan heisan kunni matui goudaghasei kunlade kieliezho. <verse eid="LUK 8:36"/><verse number="37" style="v" sid="LUK 8:37"/><char style="png">Gelasen</char> zhouwini kunla man hende ayidene <char style="pn">Ersa</char>i xiahua giezhi chi bijiense likai gieba giezho. Ingiese <char style="pn">Ersa</char> chon jiere khireidene khareiwo. <verse eid="LUK 8:37"/><verse number="38" style="v" sid="LUK 8:38"/>Sheitan heisan kun <char style="pn">Ersa</char>i xiahua giezhi hhantulaye giese <char style="pn">Ersa</char> hhei khareighazhi <verse eid="LUK 8:38"/><verse number="39" style="v" sid="LUK 8:39"/>chi giedene echidene Huda chade giesan fugie shiqinni kunlade man kielie giewo. Hhe echidene chenshini kunlade <char style="pn">Ersa</char> giesan fugie shiqinyi chonjizho.<verse eid="LUK 8:39"/></para>
  <para style="s">Xianxin Giesan Kunlani Goudaghazho</para>
  <para style="r">(<ref loc="MAT 9:18-26">Mat 9:18-26</ref>; <ref loc="MRK 5:21-43">Mak 5:21-43</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40"/>
    <char style="pn">Ersa</char> khareizhi irese hhei sagheichen kunla man hhei jienliezho. <verse eid="LUK 8:40"/><verse number="41" style="v" sid="LUK 8:41"/>Zhen ingiekude <char style="pn">Yalu</char> giezhi nie kun irewo. Hheshi huitan gonjisan kun wo. <char style="pn">Ersa</char>i kon konde papalazhi xiahua giezhi giedene uruzho. <verse eid="LUK 8:41"/><verse number="42" style="v" sid="LUK 8:42"/>Hhe kunde 12 olusan zinie oqin wo, duya ijiene giezho.</para>
  <para style="p" vid="LUK 8:42">
    <char style="pn">Ersa</char> echikudeni olon kun jigheidazho. <verse eid="LUK 8:42"/><verse number="43" style="v" sid="LUK 8:43"/>Nie biereii chusun usurusan gien 12 nien oluzho. Deifulade uzheghazhi baerlane man huai widaghazhoma, gouda dazho. <verse eid="LUK 8:43"/><verse number="44" style="v" sid="LUK 8:44"/>Hhe <char style="pn">Ersa</char>i khuina iredene jien ghizhaseni nie maqise chusun usuruku deigo beiwo.<verse eid="LUK 8:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 8:45"/>
    <char style="pn">Ersa</char> kieliewo, "Mii kien maqiwo?" Kunla man chenren ese giese <char style="pn">Beduru</char> kieliewo, "Ezhan, kun olonshi chii jigheidazhi mughuwoba." <verse eid="LUK 8:45"/><verse number="46" style="v" sid="LUK 8:46"/><char style="pn">Ersa</char> kieliewo, "Kun mii maqiwo. Mii jierese nenli khisei bi mejiewo."<verse eid="LUK 8:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 8:47"/>Ene bierei ulie mejieghaku banfa widawo. Ingie ayi pugharazhi <char style="pn">Ersa</char>i melie ire papalawo. Hhe yangiezhi maqisei, matugie deigo goudasei kunlade kieliewo. <verse eid="LUK 8:47"/><verse number="48" style="v" sid="LUK 8:48"/><char style="pn">Ersa</char> hhende kieliewo, "Funi, chii xianxin gieku chii jiuiwo. Pinnande echi."<verse eid="LUK 8:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 8:49"/>
    <char style="pn">Ersa</char> zhen kieliekude huitan gonjisan kunni giese nie kun kieliele irewo, "Oqinchii duya ijiewo. Loushii mafan bu giegha."<verse eid="LUK 8:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 8:50"/>
    <char style="pn">Ersa</char> chenliedene <char style="pn">Yalu</char>de kieliewo, "Bu ayi, zi xianxin giese oqinchii goudane." <verse eid="LUK 8:50"/><verse number="51" style="v" sid="LUK 8:51"/><char style="pn">Ersa</char> hhe giede kurudene <char style="pn">Beduru</char>, <char style="pn">Yaheiya</char>, <char style="pn">Yagebu</char>, oqinni ada anaseni chugo gie doura kiemai ese oroghawo. <verse eid="LUK 8:51"/><verse number="52" style="v" sid="LUK 8:52"/>Kunla man ene oqinde orezhi echanne chuidazhi wilazho. <char style="pn">Ersa</char> kieliewo, "Bu wila, hhe ese duya ijiezho, hhunturazho." <verse eid="LUK 8:52"/><verse number="53" style="v" sid="LUK 8:53"/>Hhela oqin fugusei mejiene. Ingiese <char style="pn">Ersa</char>i uzhezhi xiniezho. <verse eid="LUK 8:53"/><verse number="54" style="v" sid="LUK 8:54"/><char style="pn">Ersa</char> khaseni bareidene fugiede kieliewo, "Oqin, bosizhe!" <verse eid="LUK 8:54"/><verse number="55" style="v" sid="LUK 8:55"/>Hhei ruhherni kharei iredene deigo bosi irewo. <char style="pn">Ersa</char> minlin xiaizhi oqinde ijiekuni ogi giezho. <verse eid="LUK 8:55"/><verse number="56" style="v" sid="LUK 8:56"/>Ada anani hende ghanirazho. <char style="pn">Ersa</char> fenfulazhi ene shiqinyi kiemade bu kielie giezho.<verse eid="LUK 8:56"/></para>
  <chapter eid="LUK 8"/>
  <chapter number="9" style="c" sid="LUK 9"/>
  <para style="s">12 Gie Shitune Peizhi Echighazho</para>
  <para style="r">(<ref loc="MAT 10:5-15">Mat 10:5-15</ref>; <ref loc="MRK 6:7-13">Mak 6:7-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1"/>
    <char style="pn">Ersa</char> 12 gie tujini uruzhi hhantulaghadene hhelade soyuji sheitan hanshilieku, gien goudaghaku nenli, qienli ogiwo. <verse eid="LUK 9:1"/><verse number="2" style="v" sid="LUK 9:2"/>Hhelai peizhi echighadene Hudai gojiai chonjizhi gientulai goudagha giezho. <verse eid="LUK 9:2"/><verse number="3" style="v" sid="LUK 9:3"/>Hhelade kieliewo, "Mo yose zhugun, kuabao, ijiuni, baerlai bu barei. Pse jien ghua bu barei. <verse eid="LUK 9:3"/><verse number="4" style="v" sid="LUK 9:4"/>Ta alinie giede orose hhe oronse likai gietula hhe giede sou. <verse eid="LUK 9:4"/><verse number="5" style="v" sid="LUK 9:5"/>Alinie chenshide tai ulie jienliese hhense likai giekude kon jieredu turane kui boughazhi fandui giezhi zhenmin gie."<verse eid="LUK 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 9:6"/>Ingie tujila go chenshi, aghinlade echizhi Hudai kielienyi chonjizhi gien goudaghazho.<verse eid="LUK 9:6"/></para>
  <para style="s">Hherode Honshan Munan Giesan</para>
  <para style="r">(<ref loc="MAT 14:1-12">Mat 14:1-12</ref>; <ref loc="MRK 6:14-29">Mak 6:14-29</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 9:7"/>Ingiekude <char style="pn">Hherode</char> honshan fashen giesan shiqinlai man sonosudene matui imutunyi shiqin wo giezho. Kunla kieliese fugusan <char style="pn">Yaheiya</char> aminne oluwo giezho. <verse eid="LUK 9:7"/><verse number="8" style="v" sid="LUK 9:8"/>Niezhan kunla kieliese <char style="pn">Iliya</char> chuxien giewo giezho. Pseshiku kunla kieliese nie melieshiku xienzhi aminne oluwo giezho. <verse eid="LUK 9:8"/><verse number="9" style="v" sid="LUK 9:9"/><char style="pn">Hherode</char> <char style="pn">"Yaheiya</char>ni qiorunyi bi pienjiwo. Bi sonosusan ene kun daojishi kien wine" giezhi kieliewo. Ingie banfa xianjizhi nie uzhele echine giezho.<verse eid="LUK 9:9"/></para>
  <para style="s">Ersa 5000 Kun Chudughazho</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mat 14:13-21</ref>; <ref loc="MRK 6:30-44">Mak 6:30-44</ref>; <ref loc="JHN 6:1-13">Yah 6:1-13</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10"/>Shitula kharei iredene giesan shiqinlai man <char style="pn">Ersa</char>de kieliewo. <char style="pn">Ersa</char> hhelai konkonji uduru <char style="png">Bosaida</char> chenshide echiwo. <verse eid="LUK 9:10"/><verse number="11" style="v" sid="LUK 9:11"/>Kunla mejiedene hhei daghazho. <char style="pn">Ersa</char> hhelai jienliedene Hudai gojiai jianjizhi gientulai goudaghazho.<verse eid="LUK 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 9:12"/>Naran pudakude 12 gie shitu <char style="pn">Ersa</char>i melie ire kieliewo, "Kunlai sandaghazhi hhela aghinlade ijiezhi kijieku oronne ereile echigieba, eneshi hontan wo." <verse eid="LUK 9:12"/><verse number="13" style="v" sid="LUK 9:13"/><char style="pn">Ersa</char> kieliewo, "Ta hhelade ogizhi ijiegha." Hhela kieliewo, "Matande zinie tawun ginanji ghua zhaghasun wo. Imeghei kunlade pse agile echinu?" <verse eid="LUK 9:13"/><verse number="14" style="v" sid="LUK 9:14"/>Hhende chabudu 5000 ere kun wo. <char style="pn">Ersa</char> kieliewo, "Ta hhelai chabudu 50 gie 50 gieji nie tozi nie tozi sougha." <verse eid="LUK 9:14"/><verse number="15" style="v" sid="LUK 9:15"/>Tujila <char style="pn">Ersa</char> kieliesan mutun kunlai man soughawo. <verse eid="LUK 9:15"/><verse number="16" style="v" sid="LUK 9:16"/><char style="pn">Ersa</char> tawun ginan, ghua zhaghasunyi barei asimanyi uzhe, Hudade mafan kieliedene ghulu keigha, tujilade ogise tujila kunlai melie teiwo. <verse eid="LUK 9:16"/><verse number="17" style="v" sid="LUK 9:17"/>Dajiala man ijie chududene feiliesan zhazhai hhantulaghase 12 gie lanzi zhonlowo.<verse eid="LUK 9:17"/></para>
  <para style="s">Ersashi Mexiha Enbene</para>
  <para style="r">(<ref loc="MAT 16:13-19">Mat 16:13-19</ref>; <ref loc="MRK 8:27-29">Mak 8:27-29</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18"/>Niudude <char style="pn">Ersa</char> niezheghanne onxian giekude tujilaniye hhantu wo. <char style="pn">Ersa</char> hhelade asawo, "Kunla kieliese bishi kien wo giezho?" <verse eid="LUK 9:18"/><verse number="19" style="v" sid="LUK 9:19"/>Hhela kieliewo, "Kunla kieliese xili gieghasan <char style="pn">Yaheiya</char> wo giezho. Niezhan kunla kieliese <char style="pn">Iliya</char> wo giezho. Pse niezhan kunla kieliese eqighanku nie xienzhi aminne oluwo giezho." <verse eid="LUK 9:19"/><verse number="20" style="v" sid="LUK 9:20"/><char style="pn">Ersa</char> hhelade kieliewo, "Ta kieliese bishi kien wo?" <char style="pn">Beduru</char> kieliewo, "Chishi Mexiha wo." <verse eid="LUK 9:20"/><verse number="21" style="v" sid="LUK 9:21"/><char style="pn">Ersa</char> ene shiqinyi kiemade bu kielie giezhi hhelade hende fenfulawo, <verse eid="LUK 9:21"/><verse number="22" style="v" sid="LUK 9:22"/>"Kunnikewon matugieseda hende shouku giezhi zhanlao, fugie buwa, jinwun hanjiala mii fandui giezhi alane. Ghurudude aminne olune."<verse eid="LUK 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 9:23"/>
    <char style="pn">Ersa</char> kunlade kieliewo, "Kien mii daghane giese goyane sheidene niudunie shizijiane beiliezhi mii daghakuni wo. <verse eid="LUK 9:23"/><verse number="24" style="v" sid="LUK 9:24"/>Kien aminne jiuine giese aminne widaghane. Made oluzhi aminne widaghase hhe kun aminne jiuine. <verse eid="LUK 9:24"/><verse number="25" style="v" sid="LUK 9:25"/>Kun duyani man zhenjidene goyane peizhi widaghase yande gou wo? <verse eid="LUK 9:25"/><verse number="26" style="v" sid="LUK 9:26"/>Kien mase pse kieliensemi jiuren giese Kunnikewon goyane famade, pse Ada, zhiguitu qienxienlai famade irekude hhenseye jiuren giene. <verse eid="LUK 9:26"/><verse number="27" style="v" sid="LUK 9:27"/>Bi tande shuhua kielieye, enende beisan kun dunda niezhanla Hudai gojiani ulie chanlatula ulie fugune."<verse eid="LUK 9:27"/></para>
  <para style="s">Ula Jiere Ersani Yanzi Bienjizho</para>
  <para style="r">(<ref loc="MAT 17:1-8">Mat 17:1-8</ref>; <ref loc="MRK 9:2-8">Mak 9:2-8</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28"/>Ene kielienyi kieliezhi chabudu neimudu oludene <char style="pn">Ersa</char> <char style="pn">Beduru</char>, <char style="pn">Yaheiya</char>, <char style="pn">Yagebu</char>i udurudene ulade onxian giele khireiwo. <verse eid="LUK 9:28"/><verse number="29" style="v" sid="LUK 9:29"/>Onxian giekude ungieni bienjidene jiensei chighan gon faizho. <verse eid="LUK 9:29"/><verse number="30" style="v" sid="LUK 9:30"/>Menzhali <char style="pn">Musa</char>, <char style="pn">Iliya</char> ghuala <char style="pn">Ersa</char>re kielien kieliezho. <verse eid="LUK 9:30"/><verse number="31" style="v" sid="LUK 9:31"/>Hhela fama dunda khizhedene <char style="pn">Ersa</char> <char style="png">Yelusalen</char>de fuguzhi Hudai jihua chenjikui shanlian giezho. <verse eid="LUK 9:31"/><verse number="32" style="v" sid="LUK 9:32"/><char style="pn">Beduru</char>, <char style="pn">Beduru</char>i nokielani hende nokuru hhunturazho. Hhela xiereisenu <char style="pn">Ersa</char>i gonqii chanlawo. Hherezhe ghua kun hhantu beizho. <verse eid="LUK 9:32"/><verse number="33" style="v" sid="LUK 9:33"/>Hhela likai giekude <char style="pn">Beduru</char> <char style="pn">Ersa</char>de kieliewo, "Ezhan, matan enende gou wo. Enende ghuran zhanfan daiye. Niei chade, niei <char style="pn">Musa</char>de, niei <char style="pn">Iliya</char>de." Hhe yan kieliesanne ulie mejiene. <verse eid="LUK 9:33"/><verse number="34" style="v" sid="LUK 9:34"/>Hhe kieliekude niegieda olien khase hhela ayizho. <verse eid="LUK 9:34"/><verse number="35" style="v" sid="LUK 9:35"/>Ingiekude olien dundase nie shenqi ire kieliewo, "Eneshi bi sunghusan mii kewon wo. Ta hhei kielienyi chenlie!" <verse eid="LUK 9:35"/><verse number="36" style="v" sid="LUK 9:36"/>Shenqi daose <char style="pn">Ersa</char> niezheghan feiliezho. Hhe uduse khuinashi tujila chanlasan shiqinyi kiemade ese kieliewo.<verse eid="LUK 9:36"/></para>
  <para style="s">Sheitan Heisan Kewonni Goudaghazho</para>
  <para style="r">(<ref loc="MAT 17:14-18">Mat 17:14-18</ref>; <ref loc="MRK 9:14-27">Mak 9:14-27</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37"/>Khuichudu ulase bouzhekude olon kunla <char style="pn">Ersa</char>i ochirale irewo. <verse eid="LUK 9:37"/><verse number="38" style="v" sid="LUK 9:38"/>Kunlai dundase nie kun waradazhi kieliewo, "Loushi, chini nie xiahua gieye. Kewonyimi nie uzhezhi ogi. Made zi niekozi kewosi wo. <verse eid="LUK 9:38"/><verse number="39" style="v" sid="LUK 9:39"/>Sheitan hhei barei agise menzhali onghonoghane. Nie tigharaghase amansei momozi khizhene. Shan dailaghazhi deigo likai ulie giene. <verse eid="LUK 9:39"/><verse number="40" style="v" sid="LUK 9:40"/>Bi tujilaichii xiahua giezhi nie tou khigha giese hhela khigha dawo."<verse eid="LUK 9:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 9:41"/>
    <char style="pn">Ersa</char> kieliewo, "Ai, ta ene xianxin gieku witu, xiemecha yochen kunla. Bi tanse rennai giezhi giedoghoncha beine? Chi kewonne uduru enende ire." <verse eid="LUK 9:41"/><verse number="42" style="v" sid="LUK 9:42"/>Hhe irekude sheitan qila benda hende tigharaghawo. <char style="pn">Ersa</char> zannan ruhheryi nie sugie kewonni goudagha adadei jiuizhi ogiwo. <verse eid="LUK 9:42"/><verse number="43" style="v" sid="LUK 9:43"/>Hudai fugie nenlii uzhedene kunla man ghanira beizho.</para>
  <para style="s" vid="LUK 9:43">Ersa Duya Ijiekune ji 2 Hui Kieliezho</para>
  <para style="r" vid="LUK 9:43">(<ref loc="MAT 17:22-23">Mat 17:22-23</ref>; <ref loc="MRK 9:30-32">Mak 9:30-32</ref>)</para>
  <para style="p" vid="LUK 9:43">
    <char style="pn">Ersa</char> giesan shiqinyi kunla uzhedene ghanirakude <char style="pn">Ersa</char> tujiladene kieliewo, <verse eid="LUK 9:43"/><verse number="44" style="v" sid="LUK 9:44"/>"Ta ene kielienyi goude chenliezhi jila, Kunnikewonyi kunlai khade jiuine." <verse eid="LUK 9:44"/><verse number="45" style="v" sid="LUK 9:45"/>Hhela ene kielienyi dunjire dazho. Isiini hhelade niuighazhi ese mejieghazho. Hhela ayizhi asaye dazho.<verse eid="LUK 9:45"/></para>
  <para style="s">Hudani Gojiade Zui Fugieni</para>
  <para style="r">(<ref loc="MAT 18:1-5">Mat 18:1-5</ref>; <ref loc="MRK 9:33-37">Mak 9:33-37</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46"/>Hhelai dunda kien zui fugie wo giezhi nienieji zhenjindu qiiwo. <verse eid="LUK 9:46"/><verse number="47" style="v" sid="LUK 9:47"/><char style="pn">Ersa</char> hhelai zhughede yan sumulasanyi mejiedene nie kewosii uduru ire kanzidene beigha <verse eid="LUK 9:47"/><verse number="48" style="v" sid="LUK 9:48"/>hhelade kieliewo, "Kien mii niereghala ene kewosii jienliese mii jienliezho. Mii jienliese mii peisan Hudai jienliezho. Tai dunda kien zui meilashi hhe zui fugie wo."<verse eid="LUK 9:48"/></para>
  <para style="s">Ersani Niereghala Sheitan Touchen Kun</para>
  <para style="r">(<ref loc="MRK 9:38-40">Mak 9:38-40</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49"/>
    <char style="pn">Yaheiya</char> kieliewo, "Ezhan, bijien nie kunyi uzhese chii niereghala sheitan touzho. Bijien danlazhi ese toughawo. Hhe bijienre hhantu chii ese daghazho." <verse eid="LUK 9:49"/><verse number="50" style="v" sid="LUK 9:50"/><char style="pn">Ersa</char> kieliewo, "Bu danla. Tai fandui ulie giese tande oluzhi giezho."<verse eid="LUK 9:50"/></para>
  <para style="s">Samaliya Kunla Ersani Fandui Giezho</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51"/>
    <char style="pn">Ersa</char> asiman jiere khireiku ghujinlase jiejin giezhi <char style="png">Yelusalen</char>de ijinyo echine giezho. <verse eid="LUK 9:51"/><verse number="52" style="v" sid="LUK 9:52"/>Ingie giedun kunyi dafaladene <char style="png">Samaliya</char> aghinde <char style="pn">Ersa</char> irekuni zhunbei gieghale echiwoma, <verse eid="LUK 9:52"/><verse number="53" style="v" sid="LUK 9:53"/><char style="png">Yelusalen</char>de echikui mejiedene hhela <char style="pn">Ersa</char>i ese jienliewo. <verse eid="LUK 9:53"/><verse number="54" style="v" sid="LUK 9:54"/><char style="pn">Ersa</char>i tuji <char style="pn">Yagebu</char>, <char style="pn">Yaheiya</char> ene shiqinyi uzhedene kieliewo, "Ezhan, chi bijienyi fenfulaghazhi asiman jierese khan bouzheghadene enelai sidera widaghase olunulie?" <verse eid="LUK 9:54"/><verse number="55" style="v" sid="LUK 9:55"/><char style="pn">Ersa</char> ochira hhelai sugiewo. <verse eid="LUK 9:55"/><verse number="56" style="v" sid="LUK 9:56"/>Ingiedene hhela pse nie aghinde echiwo.<verse eid="LUK 9:56"/></para>
  <para style="s">Ersani Daghaku Daijia</para>
  <para style="r">(<ref loc="MAT 8:19-22">Mat 8:19-22</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57"/>Hhela mo yokude nie kun <char style="pn">Ersa</char>de kieliewo, "Chi khala echise bi chii daghane." <verse eid="LUK 9:57"/><verse number="58" style="v" sid="LUK 9:58"/><char style="pn">Ersa</char> kieliewo, "Funieghede dun wine, asiman jieredu bunzhude ho wine, Kunnikewonde nie zhentou teiku oronda uwo."<verse eid="LUK 9:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 9:59"/>
    <char style="pn">Ersa</char> pse nie kunde "Chi mii dagha." giezhi kieliese hhe kun "Ezhan, bi xien adane bulale echiye." giezhi kieliewo. <verse eid="LUK 9:59"/><verse number="60" style="v" sid="LUK 9:60"/><char style="pn">Ersa</char> kieliewo, "Fugusan kun fugusan kunlane bulale echi gie, chi Hudai gojiai chonjile echi."<verse eid="LUK 9:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 9:61"/>Da nie kun kieliewo, "Ezhan, bi chini daghanema, xien echidene giededu kunladene nie kieliedei ireye." <verse eid="LUK 9:61"/><verse number="62" style="v" sid="LUK 9:62"/><char style="pn">Ersa</char> kieliewo, "Anzhasunyi bareidene khuinane uzhesan kun Hudai gojiai pei dane."<verse eid="LUK 9:62"/></para>
  <chapter eid="LUK 9"/>
  <chapter number="10" style="c" sid="LUK 10"/>
  <para style="s">Daghasan Kunlane Peizhi Echighazho</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1"/>Ene shiqinse khuinashi Ezhan pse 72 gie kun sunghudene goyane echiku go chenshi go oronlade ghuaghuaji melie peizhi echighawo. <verse eid="LUK 10:1"/><verse number="2" style="v" sid="LUK 10:2"/>Hhelade kieliewo, "Zhonjia olon wo, wiliechi choghon wo. Ta zhonjiani ezhanyi xiahua giezhi wiliechilai peidene zhonjiane ghuragha gie. <verse eid="LUK 10:2"/><verse number="3" style="v" sid="LUK 10:3"/>Ta echindu. Bi tai peizhi echighase ghoni ghughanlai zhanghei dunda echighasan niekielien wo. <verse eid="LUK 10:3"/><verse number="4" style="v" sid="LUK 10:4"/>Qienbao, kuabao, maheine bu barei. Mo jiere kunlai chujieghese kielien bu asa. <verse eid="LUK 10:4"/><verse number="5" style="v" sid="LUK 10:5"/>Alinie giede orose ta man pinnan onu giezhi xien asa. <verse eid="LUK 10:5"/><verse number="6" style="v" sid="LUK 10:6"/>Kunla tai jienliese hhelade pinnan irene, ulie jienliese pinnan tai jiere irene. <verse eid="LUK 10:6"/><verse number="7" style="v" sid="LUK 10:7"/>Ta alinie giede souse izhigie nie giede sou. Kunla yan ochizhi ijiekuni ogise yan kere. Eneshi wilie giechen kunde ogikuni enbene. <verse eid="LUK 10:7"/><verse number="8" style="v" sid="LUK 10:8"/>Alinie chenshide tai jienliezhi yan beilase yan ijie. <verse eid="LUK 10:8"/><verse number="9" style="v" sid="LUK 10:9"/>Hhendedu gientulani goudaghazhi 'Hudai gojia chadashiwo.' giezhi kielie. <verse eid="LUK 10:9"/><verse number="10" style="v" sid="LUK 10:10"/>Alinie chenshide tai ulie jienliese geidoude echidene kielie, <verse eid="LUK 10:10"/><verse number="11" style="v" sid="LUK 10:11"/>"Tai aghinni turailiuzhe kon jieresene kui boughazhi fandui giene. Ingieliuzhe Hudai gojia chadashisei ta mejiendu." giezhi. <verse eid="LUK 10:11"/><verse number="12" style="v" sid="LUK 10:12"/>Bi tande kielieye, panjiku udude hhe chenshi shouiku zeinan <char style="png">Sodoma</char>se da fugie wo. <verse eid="LUK 10:12"/><verse number="13" style="v" sid="LUK 10:13"/><char style="png">Gelaxin</char>, <char style="png">Bosaida</char>, tande gou widawo. Tai dunda giesan nenlitu shiqinni <char style="png">Tuilo</char>, <char style="png">Xidun</char>de giewoshi hhela eqighanse madei zhodene jierene funiesun teizhi zemin jiere soudene geizhen giewo. <verse eid="LUK 10:13"/><verse number="14" style="v" sid="LUK 10:14"/>Panjiku shihoude ta shouiku zeinan <char style="png">Tuilo</char>, <char style="png">Xidun</char>se da fugie wo. <verse eid="LUK 10:14"/><verse number="15" style="v" sid="LUK 10:15"/><char style="png">Jiabainun</char>,</para>
  <para style="q1" vid="LUK 10:15">Chii undudaghazhi asiman jiere khireighanu?</para>
  <para style="q2" vid="LUK 10:15">Chii dozoheide anda boughane!"<verse eid="LUK 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 10:16"/>"Kun tai kielienyi chenliese mini kielienyi chenliezho. Tai kielienyi ulie chenliese mini kielienyi ese chenliezho. Mii ulie jienliese mii peisan Hudai ese jienliezho."<verse eid="LUK 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17"/>Hhe 72 gie kun bayasuzhi kharei ire kieliewo, "Ezhan! Chii niereghala giese sheitanlaye bijienyi feiwo."<verse eid="LUK 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 10:18"/>
    <char style="pn">Ersa</char> hhelade kieliewo, "Bi chujieghese Ibilisi asiman jierese shanjien mutun anda bou irewo. <verse eid="LUK 10:18"/><verse number="19" style="v" sid="LUK 10:19"/>Bi tande moghei, xiezilai taizhi duitoulai soyuji lilianse injizhi daoku qienli ogiwo. Yanliuzhe tai hei dane. <verse eid="LUK 10:19"/><verse number="20" style="v" sid="LUK 10:20"/>Ingieliuzhe sheitanla tai feiwo giese bu bayasudene nierelaitai asiman jiere jilasande bayasundu."<verse eid="LUK 10:20"/></para>
  <para style="s">Hudade Bayasuzhi Kieliewo</para>
  <para style="r">(<ref loc="MAT 11:25-27">Mat 11:25-27</ref>; <ref loc="MAT 13:16-17">13:16-17</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21"/>Ene shihoude <char style="pn">Ersa</char>de Shenlin durudene bayasuzhi kieliewo, "Asiman zeminni Ezhan, Ada, chii mafan gieghawo. Chi ene shiqinlani agheli, erlintu kunlade niuighazhi ga kewosi mutun kunlade mejieghawo. Ada, enbene, eneshi chi duranghalane giesan wo. <verse eid="LUK 10:21"/><verse number="22" style="v" sid="LUK 10:22"/>Soyujilashi man Adami made ogisanwo. Adase chugo kewonni kiema ulie mejiene. Kewon, pse kewon yenyi mejieghasan kunse chugo Adani kiema ulie mejiene."<verse eid="LUK 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 10:23"/>
    <char style="pn">Ersa</char> kharei ochira tujiladene danlin kieliewo, "Ta ede uzhesei uzhese tande fuqi wine. <verse eid="LUK 10:23"/><verse number="24" style="v" sid="LUK 10:24"/>Bi tande kielieye, olon xienzhi, honshanla ta uzhesei uzhene giezhoma, uzhe dazho. Ta chenliesei chenliene giezhoma, chenlie dazho."<verse eid="LUK 10:24"/></para>
  <para style="s">Samaliyai Gou Kun</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25"/>Nie jinwun loushi bosizhe <char style="pn">Ersa</char>i shiizhi asazho, "Loushi, bi matui giese chanqiku aminni jienliene?" <verse eid="LUK 10:25"/><verse number="26" style="v" sid="LUK 10:26"/><char style="pn">Ersa</char> kieliewo, "Guijin jiere yan huaizho? Chi yan onshiwo?" <verse eid="LUK 10:26"/><verse number="27" style="v" sid="LUK 10:27"/>Hhe kieliewo, "Chi qienbuji zhughe, qienbuji jinshen, qienbuji lilian, qienbuji sumulakughalane Ezhan Hudadene ore. Pse goyadene mutun giebeidene ore." <verse eid="LUK 10:27"/><verse number="28" style="v" sid="LUK 10:28"/><char style="pn">Ersa</char> kieliewo, "Chi kieliesan oluzho. Chi qingiezhi giese amiturane." <verse eid="LUK 10:28"/><verse number="29" style="v" sid="LUK 10:29"/>Hhe kun goyane olusei mejieghane giezhi <char style="pn">Ersa</char>de asawo, "Kienshi mini giebei wo?"<verse eid="LUK 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 10:30"/>
    <char style="pn">Ersa</char> kieliewo, "Nie kun <char style="png">Yelusalen</char>se <char style="png">Yelige</char>de boukude qiandaolani khade orowo. Eghizhi fugughakude kudene jienlaini agi echi benda jiewo. <verse eid="LUK 10:30"/><verse number="31" style="v" sid="LUK 10:31"/>Ingie nie buwa hhe mose bou, hhei chujieghedene mo bienzighun yo daowo. <verse eid="LUK 10:31"/><verse number="32" style="v" sid="LUK 10:32"/>Pse nie <char style="png">Liwi</char> kun hhende ire chujieghedene ye mo bienzighun yo daowo. <verse eid="LUK 10:32"/><verse number="33" style="v" sid="LUK 10:33"/>Ingie nie <char style="png">Samaliya</char> kun mo yokude hhende ire, ubali xiizhi <verse eid="LUK 10:33"/><verse number="34" style="v" sid="LUK 10:34"/>shidani echi shankouni tosun, jiughala waghazhi bouizhi goudaghadene enzheghe jiere achi lishede echi zhaogu giewo. <verse eid="LUK 10:34"/><verse number="35" style="v" sid="LUK 10:35"/>Khuichudu ghua miengui lisheni ezhande ogizhi kieliewo, 'Chi enei uzhezhi zhaogu nie gie. Baer ulie kuruse bi pse irese ogiye.'" <verse eid="LUK 10:35"/><verse number="36" style="v" sid="LUK 10:36"/><char style="pn">Ersa</char> kieliewo, "Chi sumula, ene ghurulie dundase alinieshi qiandaolai khade orosan kunni giebei wo?" <verse eid="LUK 10:36"/><verse number="37" style="v" sid="LUK 10:37"/>Jinwun loushi kieliewo, "Hhe ubali xiisan kun wo." <char style="pn">Ersa</char> kieliewo, "Chi ye echidene qingiezhi gie."<verse eid="LUK 10:37"/></para>
  <para style="s">Mada Mereiyenghalani Giede</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38"/>
    <char style="pn">Ersa</char> tujilaghalane <char style="png">Yelusalen</char>ni mo jiere echikude nie aghinde orowo. Hhende nie biereini niereni <char style="pn">Mada</char> giene. <char style="pn">Ersa</char>i jienliezhi giedene echiwo. <verse eid="LUK 10:38"/><verse number="39" style="v" sid="LUK 10:39"/>Giedeni nie oqinjiu wine. Niereini <char style="pn">Mereiyen</char> giene. <char style="pn">Ersa</char>i kon shida souzhi goude kielienyini chenliezho. <verse eid="LUK 10:39"/><verse number="40" style="v" sid="LUK 10:40"/><char style="pn">Mada</char> zhochen ushilazhi hende munan gie <char style="pn">Ersa</char>de ire kieliewo, "Ezhan, chi ene oqinjiuimi ulie gonjinu? Enende souzhi jin mini wilie gieghazho. Ede chi kieliezhi made banman giegha!"<verse eid="LUK 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 10:41"/>Ezhan kieliewo, "<char style="pn">Mada</char>ya, chi olon wilie giene giezhi munan giezhoma, <verse eid="LUK 10:41"/><verse number="42" style="v" sid="LUK 10:42"/>zhunyonishi nie wo. <char style="pn">Mereiyen</char> gounii sunghuwo, kiema agizhi echi dane."<verse eid="LUK 10:42"/></para>
  <chapter eid="LUK 10"/>
  <chapter number="11" style="c" sid="LUK 11"/>
  <para style="s">Onxian Giekuni Surughazho</para>
  <para style="r">(<ref loc="MAT 6:9-15">Mat 6:9-15</ref>; <ref loc="MAT 7:7-11">7:7-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1"/>Niudude <char style="pn">Ersa</char> nie oronde onxian giezho. Onxian giezhi baludene nie tuji <char style="pn">Ersa</char>de kieliewo, "Ezhan, <char style="pn">Yaheiya</char> tujiladene sughasan mutun chiye bijiende onxian giekui surugha." <verse eid="LUK 11:1"/><verse number="2" style="v" sid="LUK 11:2"/><char style="pn">Ersa</char> hhelade kieliewo, "Ta onxian giekude ingiezhi kielie,</para>
  <para style="q1" vid="LUK 11:2">'Ada, chi nierene zhiguishigha.</para>
  <para style="q2" vid="LUK 11:2">Chii gojiai iregha.<verse eid="LUK 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LUK 11:3"/>Niudunieku ijiuni niudunie bijiende ogi.<verse eid="LUK 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LUK 11:4"/>Bijienni zuini mienlie.</para>
  <para style="q2" vid="LUK 11:4">Bijiende zui fanjisan kunlai bijienye mienliewo.</para>
  <para style="q1" vid="LUK 11:4">Bijienyi shiikude bu echigha.'"<verse eid="LUK 11:4"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="5" style="v" sid="LUK 11:5"/>
    <char style="pn">Ersa</char> hhelade kieliewo, "Tai dunda kien nie kun banyedei zhanlienne giede echi zhanlien, made ginansene ghuran ghuizhi ogi. <verse eid="LUK 11:5"/><verse number="6" style="v" sid="LUK 11:6"/>Bijienni giede nie zhochen irewoma, ijiuni widawo giese <verse eid="LUK 11:6"/><verse number="7" style="v" sid="LUK 11:7"/>hhe gie sudorose mii bu pofansagha. Wijienlani man khazhi kewosilare hhantu kijiezho. Bosizhi chade ogiku chijia wo giene. <verse eid="LUK 11:7"/><verse number="8" style="v" sid="LUK 11:8"/>Bi tande kielieye, ene kun zhanlien wo giezhi ulie oginema, ninkounin keresei uzhese bosizhedene ogine."<verse eid="LUK 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 11:9"/>"Tande bi kielieye, ta xiahua gie, tande ogine. Erei, ereizhi olune. Wijienni eghi, tande niene. <verse eid="LUK 11:9"/><verse number="10" style="v" sid="LUK 11:10"/>Xiahua giechen kunlade ogine. Ereichen kunla ereizhi olune. Wijienni eghichen kunlade niene. <verse eid="LUK 11:10"/><verse number="11" style="v" sid="LUK 11:11"/>Tai dunda ada danlachen kien kewon zhaghasun kerese moghei ogine? <verse eid="LUK 11:11"/><verse number="12" style="v" sid="LUK 11:12"/>Endeghei kerese xiezi ogichen kun uwola? <verse eid="LUK 11:12"/><verse number="13" style="v" sid="LUK 11:13"/>Ta gou wiliuzhe kesiladene gouni ogikuni mejiene, asiman jieredu Ada xiahua giechen kunlade Shenlinni genjia ulie oginu?"<verse eid="LUK 11:13"/></para>
  <para style="s">Hudai Lilianghala Ibilisini Tou Khighazho</para>
  <para style="r">(<ref loc="MAT 12:22-30">Mat 12:22-30</ref>; <ref loc="MRK 3:20-27">Mak 3:20-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14"/>
    <char style="pn">Ersa</char> nie kunyi sudorose yaba sheitanni tou khighawo. Ingie hhe yaba kielien kielie qiise kunla man ghanirazho. <verse eid="LUK 11:14"/><verse number="15" style="v" sid="LUK 11:15"/>Ingie niezhan kunla kieliezhi hhe sheitanni touzi <char style="pn">Biexibu</char>i kouizhi sheitan touzho giewo. <verse eid="LUK 11:15"/><verse number="16" style="v" sid="LUK 11:16"/>Pse niezhan kunla hhei shiizhi asiman jierese iresan ghudureqi xienjigha giezho. <verse eid="LUK 11:16"/><verse number="17" style="v" sid="LUK 11:17"/><char style="pn">Ersa</char> hhela yan sumulasei mejiedene kieliewo, "Alinie gojia goyalane eghinduse hontan gholune. Alinie giei kunla goyalane eghinduse bixindane. <verse eid="LUK 11:17"/><verse number="18" style="v" sid="LUK 11:18"/>Ta kieliese bi <char style="pn">Biexibu</char>i kouizhi sheitan touzho, Ibilisi goyalane eghinduse hhei gojia matugie beine? <verse eid="LUK 11:18"/><verse number="19" style="v" sid="LUK 11:19"/>Bi <char style="pn">Biexibu</char>i kouizhi sheitan touse tai tujila kienyi kouizhi sheitan touzho? Ingiese tai tujila zhenmin giese tanughun codazho. <verse eid="LUK 11:19"/><verse number="20" style="v" sid="LUK 11:20"/>Bi Hudai nenlighala sheitan touse Hudai gojia tande irezho. <verse eid="LUK 11:20"/><verse number="21" style="v" sid="LUK 11:21"/>Nie uqine qiendaghasan kun giene sagheise dunxila man pinnan wo. <verse eid="LUK 11:21"/><verse number="22" style="v" sid="LUK 11:22"/>Hhense lilian pse fugietu kun ire, hhei eghizhi kouisan uqilaini agi echi, dunxilani man ghughawo. <verse eid="LUK 11:22"/><verse number="23" style="v" sid="LUK 11:23"/>Mii miende ulie beise mii duitou wo. Mare ulie hhantulachen kunshi sandachen kun wo."<verse eid="LUK 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 11:24"/>"Nie zannan ruhher kunni jierese likai giedene usu witu oronde izhigie yozhi hhamuraku oron ereizho. Ereizhi olu dadene kieliewo, 'Bi yen khizhesan hhe giedene echine.' <verse eid="LUK 11:24"/><verse number="25" style="v" sid="LUK 11:25"/>Khareizhi echi nie uzhese shuzhi goudagha jiezho. <verse eid="LUK 11:25"/><verse number="26" style="v" sid="LUK 11:26"/>Ingie khizhi echi dolon doghun ruhheryi uduruzhi ire souwo. Ingiese hhe kunni qinkon melieshidakude pse ese kuruwo."<verse eid="LUK 11:26"/></para>
  <para style="s">Zhenzhenji Fuqi</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27"/>
    <char style="pn">Ersa</char> zhen kieliekude kunlai dundase nie bierei fugiede waradazhi kieliewo, "Chini laizhi gogoghazhi fugiedaghasan kunde fuqi wine!" <verse eid="LUK 11:27"/><verse number="28" style="v" sid="LUK 11:28"/><char style="pn">Ersa</char> kieliewo, "Hudai kielienni zunjizhi giesan kunde zhenzhen fuqi wine."<verse eid="LUK 11:28"/></para>
  <para style="s">Yunusini Ghudureqi</para>
  <para style="r">(<ref loc="MAT 12:38-42">Mat 12:38-42</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29"/>Kun olodokude <char style="pn">Ersa</char> pse kieliewo, "Ene idai kunla yale intu doghun wo. Ghudureqi kerezhoma, <char style="pn">Yunusi</char>i ghudureqise chugo xienjighaku ghudureqi uwo. <verse eid="LUK 11:29"/><verse number="30" style="v" sid="LUK 11:30"/><char style="pn">Yunusi</char> <char style="png">Niniwi</char> kunlade oluzhi ghudureqi gholusan mutun Kunnikewonye ene idaini kunlade ghudureqi gholune. <verse eid="LUK 11:30"/><verse number="31" style="v" sid="LUK 11:31"/>Panjiku udude nanfanni bierei honshan bosizhedene ene idaini kunlade zui jinjine. Hhe gholose <char style="pn">Sulumane</char>ni aghelini chenliele irewo. Uzhe, enende <char style="pn">Sulumane</char>se pse fugieni wine. <verse eid="LUK 11:31"/><verse number="32" style="v" sid="LUK 11:32"/>Panjiku udude <char style="png">Niniwi</char> kunla bosizhezhi ene idai kunlai zuini jinjine. <char style="png">Niniwi</char> kunla <char style="pn">Yunusi</char> chonjisei chenliedene geizhen giewo. Uzhe, <char style="pn">Yunusi</char>se pse fugieni enende wo!"<verse eid="LUK 11:32"/></para>
  <para style="s">Beyeni Zhula</para>
  <para style="r">(<ref loc="MAT 5:15">Mat 5:15</ref>; <ref loc="MAT 6:22-23">6:22-23</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33"/>"Zhulai jienjidene jiude niuighachen kun uwo. Ighaghala komorochen kunye uwo. Zhula teiku teizi jiere teise kunla orozhese chujieghene. <verse eid="LUK 11:33"/><verse number="34" style="v" sid="LUK 11:34"/>Nudunchiishi beyeni zhula wo. Nudunchii goushi beyechii man gieghan wo. Nudunchii gou wise beyechii man khara wo. <verse eid="LUK 11:34"/><verse number="35" style="v" sid="LUK 11:35"/>Goyane xianxide uzhe, pse sudorodu gonchii kharalane. <verse eid="LUK 11:35"/><verse number="36" style="v" sid="LUK 11:36"/>Chii jiere kharani goujighanida wi man gieghanshi zhula chini zhouisan mutun gieghan wo."<verse eid="LUK 11:36"/></para>
  <para style="s">Jinwun Loushilani Sugiezho</para>
  <para style="r">(<ref loc="MAT 23:1-36">Mat 23:1-36</ref>; <ref loc="MRK 12:38-40">Mak 12:38-40</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37"/>
    <char style="pn">Ersa</char> kielien kieliekude nie Falisai kun <char style="pn">Ersa</char>i xinlawo. Ingie <char style="pn">Ersa</char> echidene xi jiere souwo. <verse eid="LUK 11:37"/><verse number="38" style="v" sid="LUK 11:38"/><char style="pn">Ersa</char> khane ese wagha ijiese hhe Falisai kun ghudure wo giezho. <verse eid="LUK 11:38"/><verse number="39" style="v" sid="LUK 11:39"/>Ezhan hhende kieliewo, "Ta Falisai kun beizi, jiezi mienzii wagha arughazhoma, tai sudoro jin qianlaku okhoni duruzho. <verse eid="LUK 11:39"/><verse number="40" style="v" sid="LUK 11:40"/>Ta yama mejie dachen kunla, tani ghadanedui zhayaghasan Huda tani sudorodui ese zhayaghawu? <verse eid="LUK 11:40"/><verse number="41" style="v" sid="LUK 11:41"/>Ta sudorodedu dunxilane jiahui kunlade ogi. Qingiese tande man ganjin wo."<verse eid="LUK 11:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 11:42"/>"Ingiezhoma, ta ene Falisai kunlade gou widawo! Ta bohe, huajio, yanyanji cailasene Hudade ushirei ogizhoma, gundande gieku, Hudade orekuni zhunshi ulie giene. Enelai ta indan giekui wo, psedulaiye ulie giekui pusho."<verse eid="LUK 11:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 11:43"/>"Ta ene Falisai kunlade gou widawo! Ta huitanni undu wizide soukude xiqi wo. Geidoude kunla tande kielien asakude xiqi wo. <verse eid="LUK 11:43"/><verse number="44" style="v" sid="LUK 11:44"/>Tande gou widawo! Ta hao witu meza niekielien wo. Kunla mejie dazhi taine."<verse eid="LUK 11:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45"/>Nie jinwun loushi <char style="pn">Ersa</char>de kieliewo, "Loushi, chi ingiezhi kieliese bijienyiye jiuren gieghazho." <verse eid="LUK 11:45"/><verse number="46" style="v" sid="LUK 11:46"/><char style="pn">Ersa</char> kieliewo, "Ta jinwun loushiladeye gou widawo! Ta kunlai jiere bazilie daku qimutu gundu danzii beilieghadene goya kha ghurunghalane goujida banman ulie giene. <verse eid="LUK 11:46"/><verse number="47" style="v" sid="LUK 11:47"/>Tande gou widawo! Tai xienrenla alasan xienzhilade ta meza giezho. <verse eid="LUK 11:47"/><verse number="48" style="v" sid="LUK 11:48"/>Ingiese hhela giesei ta ganzhen beizhi zanchen giezho. Hhela alawo, ta meza giezho. <verse eid="LUK 11:48"/><verse number="49" style="v" sid="LUK 11:49"/>Hudade agheli olonshi ingiezhi kieliewo, 'Bi xienzhi, peisan kunlai hhelade echighane. Hhela niezhanlai heine, niezhanlai alane.'"<verse eid="LUK 11:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 11:50"/>"Ingiese duyai zhayaghasanse alasan soyuji xienzhilai chusunni guini man ene idai kunlai jiere teine. <verse eid="LUK 11:50"/><verse number="51" style="v" sid="LUK 11:51"/>Jiushi <char style="pn">Hhabi</char>ni alasanse qiizhi izhi sidagha gieku teiziji dajien dunda <char style="pn">Sajialiya</char>i alasan zuini guini man ene idai kunlai jiere teine. Enbene, bi tande kielieye, ene guini ene idai kunlai jiere teine. <verse eid="LUK 11:51"/><verse number="52" style="v" sid="LUK 11:52"/>Ta jinwun loushilade gou widawo! Ta Hudai taniku yeshii agizhi echidene goyalane ese orowo, orone giechen kunlaiye ese oroghawo."<verse eid="LUK 11:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 11:53"/>
    <char style="pn">Ersa</char> enense ghadane khireise jinwun hanjia, Falisai kunla <char style="pn">Ersa</char>i hende fandui giedene unqi olon asazhi <verse eid="LUK 11:53"/><verse number="54" style="v" sid="LUK 11:54"/>kieliensei babin ereine giezho.<verse eid="LUK 11:54"/></para>
  <chapter eid="LUK 11"/>
  <chapter number="12" style="c" sid="LUK 12"/>
  <para style="s">Jiazhon Giesan Kun</para>
  <para style="r">(<ref loc="MAT 10:26-27">Mat 10:26-27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1"/>Ingiekude jiqien jiwon kun hhantulazhi nieniene taikui xianli. <char style="pn">Ersa</char> xien tujiladene kieliewo, "Ta Falisai kunni kunieghei xioxin gie. Hhelashi jiazhon giesan kun wo. <verse eid="LUK 12:1"/><verse number="2" style="v" sid="LUK 12:2"/>Jizide giesan shiqinlai ulie khizheghakui uwo. Niuighasanlai ulie mejieghakui uwo. <verse eid="LUK 12:2"/><verse number="3" style="v" sid="LUK 12:3"/>Ta beichazide kieliesan kielienlai kunla ghadane mindamin chenliene. Ta giedera chighinde kieliesei kunla gie jiere fugiede kieliene."<verse eid="LUK 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4"/>"Mini zhanlienla, bi tande kielieye, beyeni aladene pse yama gie dachen hhelase bu ayi. <verse eid="LUK 12:4"/><verse number="5" style="v" sid="LUK 12:5"/>Bi tande kiense ayikui mejieghaye, beyeni aladene dozoheide echighaku qienli bichen hhense ayi."<verse eid="LUK 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 12:6"/>"Tawun bunzhui 2 mao baer huinela? Ingieliuzhe Huda hhelai nieda ulie matane. <verse eid="LUK 12:6"/><verse number="7" style="v" sid="LUK 12:7"/>Tai qiorun jieredu usunniliuzhe toulazhi agizho. Ta bu ayi, ta olon bunzhulase zhunyo wo."<verse eid="LUK 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8"/>"Bi pse tande kielieye, kien kunlai melie mini renjise Kunnikewonye Hudai qienxien melie hhei renjine. <verse eid="LUK 12:8"/><verse number="9" style="v" sid="LUK 12:9"/>Kien kunlai melie mini ulie renjise bi Hudai qienxien melie hhei ulie renjine. <verse eid="LUK 12:9"/><verse number="10" style="v" sid="LUK 12:10"/>Kunnikewonni fandui giezhi kieliese roulienema, Shenlinni hu kieliese ulie rouliene. <verse eid="LUK 12:10"/><verse number="11" style="v" sid="LUK 12:11"/>Kunla tai laizhi huitan, noyen, qienli bareichen kun shida echise ta matugie huida giekui, yan kieliekui munan bu gie. <verse eid="LUK 12:11"/><verse number="12" style="v" sid="LUK 12:12"/>Hhe shihou kuse ta yan kieliekuni Shenlin mejieghane."<verse eid="LUK 12:12"/></para>
  <para style="s">Bayan Guazini Sumulasan</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13"/>Ingiedene olon kunla dundase nie kun <char style="pn">Ersa</char>de kieliewo, "Loushi, chi gaidemi kieliezhi jiachanyi made ghughazhi ogi gie." <verse eid="LUK 12:13"/><verse number="14" style="v" sid="LUK 12:14"/><char style="pn">Ersa</char> kieliewo, "Chi ene kun, mini tande kien noyen danlaghazhi gieni ghughaghane?" <verse eid="LUK 12:14"/><verse number="15" style="v" sid="LUK 12:15"/>Ingie pse kieliewo, "Ta xioxin giezhi yanyanji tanxin giekulase gholodo. Kunni amin olon baerghala gonxi uwo."<verse eid="LUK 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 12:16"/>Pse bilazhi kieliewo, "Nie bayan kunyi ghazhadeni osisan zhonjia gansan no wo. <verse eid="LUK 12:16"/><verse number="17" style="v" sid="LUK 12:17"/>Hhe sumulawo, 'Bi ene zhonjiani khala teine? Teiku oron uwo.' <verse eid="LUK 12:17"/><verse number="18" style="v" sid="LUK 12:18"/>Pse bi ene cankune cheidene pse fugiede nie gie, taran dunxilane teiye giezho. <verse eid="LUK 12:18"/><verse number="19" style="v" sid="LUK 12:19"/>Ingie goyadene made ijin sunjisan olon no wo. Jinien ijieliuzhe bara dane. Ede suibien ijiezhi ochizhi udu daose olune giezho. <verse eid="LUK 12:19"/><verse number="20" style="v" sid="LUK 12:20"/>Ingiese Huda hhende kieliewo, 'Chi ene ulie mejiechen kun! Ene xii chi fugu widase dunxilachii kiende feiliene?'"<verse eid="LUK 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 12:21"/>
    <char style="pn">Ersa</char> kieliewo. "Jin goyadene boubeini sunjizhi Hudai miende bayan wichen kunshi man intui wo."<verse eid="LUK 12:21"/></para>
  <para style="s">Munan Bu Gie</para>
  <para style="r">(<ref loc="MAT 6:19-21">Mat 6:19-21</ref>, <ref loc="MAT 6:25-34">25-34</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22"/>
    <char style="pn">Ersa</char> tujiladene kieliewo, "Ingiese bi tande kielieye, ta amindene oluzhi yan ijiene, musine giezhi munan bu gie. <verse eid="LUK 12:22"/><verse number="23" style="v" sid="LUK 12:23"/>Amin ijiekuse zhunyo wo, beye musikuse zhunyo wo. <verse eid="LUK 12:23"/><verse number="24" style="v" sid="LUK 12:24"/>Ta louwalani uzhe, hhela yama ese tareizho, ese ghurazho, ghuraku canku ye uwoma, Huda qiezhezho. Ta bunzhulase zhunyo uwonu? <verse eid="LUK 12:24"/><verse number="25" style="v" sid="LUK 12:25"/>Tani dunda kien zhughe chilakughala aminne niecha fududagha shidane? <verse eid="LUK 12:25"/><verse number="26" style="v" sid="LUK 12:26"/>Ta intughani ga shiqinyi gie dane, pseshiku shiqinde munan giezhi yangiene? <verse eid="LUK 12:26"/><verse number="27" style="v" sid="LUK 12:27"/>Ta baihe chizhe matugie osisei nie uzhe, hhela ulie khishilane, bosiye ulie giene. Bi tande kielieye, <char style="pn">Sulumane</char> honshan zui henni xienzide musisanla ene nie chizhede ulie kurune. <verse eid="LUK 12:27"/><verse number="28" style="v" sid="LUK 12:28"/>Ta goude xianxin ulie giechen kunla, banche jieredu osun enedu wine, maghashijie luzide teiliuzhe Huda dou ingiezhi dabalaghazho. Tai qingie ulie gienu? <verse eid="LUK 12:28"/><verse number="29" style="v" sid="LUK 12:29"/>Ta ijiezhi ochikude xiahua bu giezhi munan bu gie, <verse eid="LUK 12:29"/><verse number="30" style="v" sid="LUK 12:30"/>enelashi man duyani kunla xiahua giekuni wo. Tande enezighan chaisanlai Adatai mejiene. <verse eid="LUK 12:30"/><verse number="31" style="v" sid="LUK 12:31"/>Ta Hudai gojiai xiahua gie, ingiese enelai man tande ogine."<verse eid="LUK 12:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 12:32"/>"Ta kun choghontu kunla, bu ayi. Tai Ada bayasuzhi asiman gojiani tande ogine. <verse eid="LUK 12:32"/><verse number="33" style="v" sid="LUK 12:33"/>Ta giededu dunxilane huizhi nanxin kunlade ghughazhi ogi. Goyadene oluzhi ulie qida oluku qienbaoni zhunbei giedene boubeini asiman jiere sunji. Hhende boubeila ulie widane, ghughei ghula dane, ghughei ijie dane. <verse eid="LUK 12:33"/><verse number="34" style="v" sid="LUK 12:34"/>Tai boubei khalashi zhughetaiye khala wo."<verse eid="LUK 12:34"/></para>
  <para style="s">Ezhan Irekui Zhunbei Gie</para>
  <para style="r">(<ref loc="MAT 24:45-51">Mat 24:45-51</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35"/>"Ta pixiene pixiliezhi zhulane jienjidene goude zhunbei gie. <verse eid="LUK 12:35"/><verse number="36" style="v" sid="LUK 12:36"/>Eneshi nie ezhan ghurunse irekuni sagheisan hojila niekielien wo. Ezhan iredene wijienyi eghikure hhantu niewo. <verse eid="LUK 12:36"/><verse number="37" style="v" sid="LUK 12:37"/>Ezhan irekude zeixin giesan hojilade fuqi wine. Bi tande shuhua kielieye, Ezhan goya wilie gieku jienne musidene hojilani shire jiere soughazhi ushilane. <verse eid="LUK 12:37"/><verse number="38" style="v" sid="LUK 12:38"/>Hhe banyede iremu, giegherekude irekude hojila ingiezhi giesei uzhese hhe hojilade fuqi wine. <verse eid="LUK 12:38"/><verse number="39" style="v" sid="LUK 12:39"/>Ta enei mejie, giei ezhan ghughei yan xienzide irekui mejiese giedene ulie oroghane. <verse eid="LUK 12:39"/><verse number="40" style="v" sid="LUK 12:40"/>Taye goude zhunbei giendu, ta mejie dakude Kunnikewon irene."<verse eid="LUK 12:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41"/>
    <char style="pn">Beduru</char> kieliewo, "Ezhan, ene bilasan kielienni bijiende kieliewu, dajialade kieliewo?"<verse eid="LUK 12:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 12:42"/>Ezhan kieliewo, "Qinse kienshi kekaotu jienzha giechen gonjia wo? Zhanguijini hhende giededu hojilai, ijiekulani man gonjighasan pushonu? <verse eid="LUK 12:42"/><verse number="43" style="v" sid="LUK 12:43"/>Zhanguiji irekude hoji ingiezhi giesei chanlase hhe hojide fuqi wine. <verse eid="LUK 12:43"/><verse number="44" style="v" sid="LUK 12:44"/>Bi tande shuhua kielieye, zhanguiji hhende caichanlane man gonjighane. <verse eid="LUK 12:44"/><verse number="45" style="v" sid="LUK 12:45"/>Hhe hoji zhughedene sumulazhi mini zhanguiji deigo ulie irene gie, kewon, oqin hojilai eghizhi ijiezhi jiu ochizhi sudose <verse eid="LUK 12:45"/><verse number="46" style="v" sid="LUK 12:46"/>hhe sumula daku udu, mejie daku shihoude zhanguijini iredene hhei sidasunyi qiuizhi kielien ese chenliesan kunlare hhantu faine. <verse eid="LUK 12:46"/><verse number="47" style="v" sid="LUK 12:47"/>Ene hoji ezhanni isini mejiewoma, zhunbei ese giewo. Zhanguijini kielien mutun ye ese giewo. Ingiese hheni gundude faikuni wo. <verse eid="LUK 12:47"/><verse number="48" style="v" sid="LUK 12:48"/>Zinie zhanguijini isini mejie dazhi gou ese giesan kunlai gongiende faine. Olon ogisan kunlase olon kerene, choghon ogisan kunlase choghon kerene."<verse eid="LUK 12:48"/></para>
  <para style="s">Ersa Danxinraghane</para>
  <para style="r">(<ref loc="MAT 10:34-36">Mat 10:34-36</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49"/>"Bi zemin jiere khan teile irewo. Bi sumulase khan ghujighan sidera qiisejiu. <verse eid="LUK 12:49"/><verse number="50" style="v" sid="LUK 12:50"/>Made da nie chijia xili giekuni wine. Hhei onchen gietula made yali fugie no wo. <verse eid="LUK 12:50"/><verse number="51" style="v" sid="LUK 12:51"/>Ta sumulase bi zemin jiere pinnan deilazhi irewo giezhou? Uye, bi tande kielieye, bi tani fandui gieghale irewo. <verse eid="LUK 12:51"/><verse number="52" style="v" sid="LUK 12:52"/>Enedu khuinase nie giede tawun kun bise ghuran kun ghua kunghala fandui giene, ghua kun ghuran kunghala fandui giene. <verse eid="LUK 12:52"/><verse number="53" style="v" sid="LUK 12:53"/>Ada kewonghalane fandui giene, kewon adaghalane fandui giene, ana oqinghalane fandui giene, oqin anaghalane fandui giene, ghadunmekie konbiereighalane fandui giene, konbierei ghadunmekieghalane fandui giene."<verse eid="LUK 12:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54"/>
    <char style="pn">Ersa</char> pse olon kunlade kieliewo, "Ta xibangiede olien nie chanlase 'Ghura boune.' giezhi kieliene. Kieliese boune. <verse eid="LUK 12:54"/><verse number="55" style="v" sid="LUK 12:55"/>Nanbangiese kei bosise, 'Khalundane.' giezhi kieliese khalundane. <verse eid="LUK 12:55"/><verse number="56" style="v" sid="LUK 12:56"/>Ta ene jiazhon giesan kun, ta qienqi bienjikuni mejiene, ene shihouni fenji dane?"<verse eid="LUK 12:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57"/>"Ta yale alinie olusei fenji dane? <verse eid="LUK 12:57"/><verse number="58" style="v" sid="LUK 12:58"/>Chi noyenyi shida echikude mo jiere duitoughalane gouda. Pse hhe chii panjiku noyen shida lai echise panjiku noyen gunnande jiuise gunnan chii bafanzide khane. <verse eid="LUK 12:58"/><verse number="59" style="v" sid="LUK 12:59"/>Bi chade kielieye, chi 1 fen baerniliuzhe honjizhi ulie qindaghase bafanzise khizhe dane."<verse eid="LUK 12:59"/></para>
  <chapter eid="LUK 12"/>
  <chapter number="13" style="c" sid="LUK 13"/>
  <para style="s">Geikuni Wo</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1"/>Ene shihoude danchan kunla <char style="pn">Bilado</char> <char style="png">Jialili</char> kunlai alasan chusunni hhelai sidagha giesan dunxi dunda huighasan shiqinni <char style="pn">Ersa</char>de kieliewo. <verse eid="LUK 13:1"/><verse number="2" style="v" sid="LUK 13:2"/><char style="pn">Ersa</char> asawo, "Ta sumulase ene <char style="png">Jialili</char> kun psedu <char style="png">Jialili</char> kunlase fanjisan zui fugieshi alawu? <verse eid="LUK 13:2"/><verse number="3" style="v" sid="LUK 13:3"/>Uye. Bi tande kielieye, ta geizhen ulie giese hhela mutun fugune. <verse eid="LUK 13:3"/><verse number="4" style="v" sid="LUK 13:4"/>Pse hhe <char style="png">Xiloya</char> orondeni lou tairedene 18 gie kunyi daru alawo. Ta sumulase ene kunla <char style="png">Yelusalen</char> kunlase fanjisan zui fugie onu? <verse eid="LUK 13:4"/><verse number="5" style="v" sid="LUK 13:5"/>Uwo. Bi tande kielieye, ta geizhen ulie giese hhela mutun fugune."<verse eid="LUK 13:5"/></para>
  <para style="s">Alima Ese Sousan Uhuago Mutun</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6"/>Ingiedene <char style="pn">Ersa</char> pse bilazhi kieliewo, "Nie kun putou yenzide nie uhuago mutun zeilawo. Hhe mutunsene alima ereile irese nieda ereizhi olu dawo. <verse eid="LUK 13:6"/><verse number="7" style="v" sid="LUK 13:7"/>Ezhanni yenzi sagheisan kunde kieliewo, 'Uzhe, bi ene 3 niende uhuago mutun jierese alima nieda chujieghe dawo. Eneni chizhi daogha, belien oron ezheliezho.' <verse eid="LUK 13:7"/><verse number="8" style="v" sid="LUK 13:8"/>Yenzi sagheisan kun kieliewo, 'Ezhan, ene hon nie liui. Bi ene zhouwi turani waikude hhagha teiye. <verse eid="LUK 13:8"/><verse number="9" style="v" sid="LUK 13:9"/>Khuinashi alima souse sougie, ulie souse chizhi widaghaye.'"<verse eid="LUK 13:9"/></para>
  <para style="s">Hhamuraku Udude Gienni Goudaghazho</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10"/>Hhamuraku udude <char style="pn">Ersa</char> huitande kunlade sughazho. <verse eid="LUK 13:10"/><verse number="11" style="v" sid="LUK 13:11"/>Hhende sheitan heizhi 18 nien nurunne zhidagha dasan nie bierei wine. <verse eid="LUK 13:11"/><verse number="12" style="v" sid="LUK 13:12"/><char style="pn">Ersa</char> chanla uruzhi ire kieliewo, "Funi, ede chi giensene andawo." <verse eid="LUK 13:12"/><verse number="13" style="v" sid="LUK 13:13"/>Ingie hheni jiere ghua khane teise deigo goudazhi bierei Hudai kuaizho. <verse eid="LUK 13:13"/><verse number="14" style="v" sid="LUK 13:14"/>Huitan gonjisan kun <char style="pn">Ersa</char> hhamuraku udude gien goudaghase hokuzhi kunlade kieliewo, "Hhe tawun zhighudu winema, yangiezhi hhamuraku udude goudaghane?"<verse eid="LUK 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 13:15"/>Ezhan kieliewo, "Ta ene jiazhon giesan kun, ta hhamuraku udude fughe, enzheghelane khudonse khizheghazhi ulie sulanu? <verse eid="LUK 13:15"/><verse number="16" style="v" sid="LUK 13:16"/>Ene biereishi <char style="pn">Iburaheimu</char>ni houdei wo, hhei 18 nien Ibilisi heizhi giedalaghazho, hhamuraku udude andaghase ulie olunu?"<verse eid="LUK 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 13:17"/>Ingiesenu fandui giesan kunla nanchan duruzho. <char style="pn">Ersa</char> giesan famatu shiqinlai uzhedene kunla man bayasuzho.<verse eid="LUK 13:17"/></para>
  <para style="s">Caizi Fureni Bilazho</para>
  <para style="r">(<ref loc="MAT 13:31-33">Mat 13:31-33</ref>; <ref loc="MRK 4:30-32">Mak 4:30-32</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18"/>
    <char style="pn">Ersa</char> pse kieliezho, "Hudai gojia yanni xianli? Yanghala bilane? <verse eid="LUK 13:18"/><verse number="19" style="v" sid="LUK 13:19"/>Hoxian nie caizi furei xianli. Kun agizhi echi yenzidene tareise fugiedazhi mutun gholuse chala jiere bunzhula holiene."<verse eid="LUK 13:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20"/>
    <char style="pn">Ersa</char> pse kieliewo, "Hudai gojiai yanghala bilane? <verse eid="LUK 13:20"/><verse number="21" style="v" sid="LUK 13:21"/>Hoxian kunieghei xianli. Nie bierei agizhi echidene nie deizi ghurunde teizhi man faighazho."<verse eid="LUK 13:21"/></para>
  <para style="s">Witan Wijiense Oro</para>
  <para style="r">(<ref loc="MAT 7:13-14">Mat 7:13-14</ref>, <ref loc="MAT 7:21-23">21-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22"/>
    <char style="pn">Ersa</char> <char style="png">Yelusalen</char>ni mo jiere echikude kunlai chenshi aghinlade sughazho. <verse eid="LUK 13:22"/><verse number="23" style="v" sid="LUK 13:23"/>Nie kun asazho, "Ezhan, jiuisan kun choghon woba?" <char style="pn">Ersa</char> kunlade kieliewo, <verse eid="LUK 13:23"/><verse number="24" style="v" sid="LUK 13:24"/>"Witan wijiense orokuni xiacha gie. Bi tande kielieye, orone giechen kun olon wo, oro dane. <verse eid="LUK 13:24"/><verse number="25" style="v" sid="LUK 13:25"/>Giei ezhan wijienni khase ta ghadanese wijienni eghizhi 'Ezhan, bijiende wijienni nieya.' giese hhe 'Bi tai tani dane. Ta khalase iresei bi ulie mejiene.' giezhi kieliene. <verse eid="LUK 13:25"/><verse number="26" style="v" sid="LUK 13:26"/>Hhe shihoude ta kieliene, 'Hhe xienzide matan hhantu ochizhi ijienduzho. Pse chi bijienyi geidoude sughazho.' <verse eid="LUK 13:26"/><verse number="27" style="v" sid="LUK 13:27"/>Ingiese hhe kieliene, 'Bi tande kielieye, ta khalase iresei bi ulie mejiene. Ta ene huaishi giesan kunla, mase likai gie.'"<verse eid="LUK 13:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 13:28"/>"Ta Hudai gojiade <char style="pn">Iburaheimu</char>, <char style="pn">Isaghei</char>, <char style="pn">Yagebu</char>, pse hhe xienzhilani man chanlaku shihoude tani toudene ghadane khighase ta shidunne zhouzhi wilane. <verse eid="LUK 13:28"/><verse number="29" style="v" sid="LUK 13:29"/>Dunnanxibeise kunla irezhi Hudai gojiade xi soune. <verse eid="LUK 13:29"/><verse number="30" style="v" sid="LUK 13:30"/>Chenlie, khuinashikula melieshilane, melieshikula khuinashilane."<verse eid="LUK 13:30"/></para>
  <para style="s">Yelusalen Chenshide Oluzhi Wilazho</para>
  <para style="r">(<ref loc="MAT 23:37-39">Mat 23:37-39</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31"/>Zhen ingiekude giedun Falisai kun ire <char style="pn">Ersa</char>de kieliewo, "Chi enense likai gie, <char style="pn">Hherode</char> chini alane giezho." <verse eid="LUK 13:31"/><verse number="32" style="v" sid="LUK 13:32"/>"Ta echidene hhe funieghede kielie, 'Enedu maghashijie bi sheitanlani touzhi gien goudaghane, chinaer mini shiqin barawo.' <verse eid="LUK 13:32"/><verse number="33" style="v" sid="LUK 13:33"/>Enedu, maghashi, chinaer bi bixi mone yone, Hudai xienzhini <char style="png">Yelusalen</char>se chugo ala dane. <verse eid="LUK 13:33"/><verse number="34" style="v" sid="LUK 13:34"/><char style="png">Yelusalen</char>, <char style="png">Yelusalen</char>, peizhi ireghasan xienzhilai tashidazhi alasan chenshiya. Bi chii kesilani gieduifa muji tigha zhunzhughalane siban doura hhantulaghaku mutun hhantulaghane giese ta duran uwo. <verse eid="LUK 13:34"/><verse number="35" style="v" sid="LUK 13:35"/>Uzhe, chii gie hontan gholuzhi chade feiliene. Bi chade kielieye, chi 'Ezhanni niereghala iresan kunni doulandu.' giezhi kielietula mii pse chanla dane."<verse eid="LUK 13:35"/></para>
  <chapter eid="LUK 13"/>
  <chapter number="14" style="c" sid="LUK 14"/>
  <para style="s">Hhamuraku Udude Gienni Goudaghazho</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1"/>Hhamuraku udude <char style="pn">Ersa</char> nie Falisai kunni lindaoni giede ijiele echikude kunla ghulazhi uzhezho. <verse eid="LUK 14:1"/><verse number="2" style="v" sid="LUK 14:2"/>Zhen hheni melie shighara beghelieni khaitusan kun wine. <verse eid="LUK 14:2"/><verse number="3" style="v" sid="LUK 14:3"/><char style="pn">Ersa</char> jinwun loushi, Falisai kunlade asazho, "Hhamuraku udude gien uzhese olunu ulie olune?" <verse eid="LUK 14:3"/><verse number="4" style="v" sid="LUK 14:4"/>Hhelade shenqi uwo. <char style="pn">Ersa</char> hhei jiere khane tei, uzhe goudaghadene echighawo. <verse eid="LUK 14:4"/><verse number="5" style="v" sid="LUK 14:5"/>Ingie hhelade kieliewo, "Tai dunda hhamuraku udude enzheghe, fughe nokiende anda bouse laizhi ulie khizhenu?" <verse eid="LUK 14:5"/><verse number="6" style="v" sid="LUK 14:6"/>Hhela ene kieliende yama kielie dawo.<verse eid="LUK 14:6"/></para>
  <para style="s">Goyane Meilade Uzhechen Kun</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7"/>Xinlazhi iresan zhochenla goyalane shanxide echi souwo. <char style="pn">Ersa</char> hhelai chanla bilazhi kieliewo, <verse eid="LUK 14:7"/><verse number="8" style="v" sid="LUK 14:8"/>"Ta ghurunde echise shanxide bu sou, tanse fugie zhochen bise tani daoghane. <verse eid="LUK 14:8"/><verse number="9" style="v" sid="LUK 14:9"/>Giei kun iredene kieliese chi ene oronyi zhochende nie ranji giese chi shizhezhi daone. <verse eid="LUK 14:9"/><verse number="10" style="v" sid="LUK 14:10"/>Xinlazhi irekude ta zui bixinni oronde souse xinlasan kun chini uruzhi kieliene, 'Zhanlien, chi ene shanxide sou.' Ingiese kunla uzhese giedughon gou wo. <verse eid="LUK 14:10"/><verse number="11" style="v" sid="LUK 14:11"/>Kien goyane undudaghase boghonidaghane. Goyane boghonidaghase undudaghane."<verse eid="LUK 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 14:12"/>
    <char style="pn">Ersa</char> xinlasan kunde kieliewo, "Chi udukun, heifande zhanlienlane, gaijiulane, qingulane, giebei bayankunlai bu xinla, pse hhelaye chii xinlane. <verse eid="LUK 14:12"/><verse number="13" style="v" sid="LUK 14:13"/>Chi ghurun ijiekude nanxin kunla, canfei, dogholon, sugho, enelani xinla, ingiese chade fuqi wine. <verse eid="LUK 14:13"/><verse number="14" style="v" sid="LUK 14:14"/>Hhela chini khareizhi xinla danema, gou kunla fuho giekude Huda chade gouni ogine."<verse eid="LUK 14:14"/></para>
  <para style="s">Ghurunde Xinlaku</para>
  <para style="r">(<ref loc="MAT 22:1-10">Mat 22:1-10</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15"/>Hhantu sousan kun dunda nie kun enei chenliedene <char style="pn">Ersa</char>de kieliewo, "Hudai gojiade xi ijiesan kunde fuqi wine." <verse eid="LUK 14:15"/><verse number="16" style="v" sid="LUK 14:16"/><char style="pn">Ersa</char> hhende kieliewo, "Nie kun fugiede xi beilazhi zhochen olon xinlawo. <verse eid="LUK 14:16"/><verse number="17" style="v" sid="LUK 14:17"/>Xi souku shihoude hojine peizhi xinlasan kunlai urughale echiwo, 'Irendu, man zhunbei gie goudaghawo.' <verse eid="LUK 14:17"/><verse number="18" style="v" sid="LUK 14:18"/>Kunla nienieji man tui qiiwo. Tou 1 gie kun kieliewo, 'Bi nie ghazha agizho. Uzhele echine. Ire dane. Bu hoku.' <verse eid="LUK 14:18"/><verse number="19" style="v" sid="LUK 14:19"/>Da nie kun kieliewo, 'Bi 5 dui fughe agiwo. Shiile echine. Bu hoku.' <verse eid="LUK 14:19"/><verse number="20" style="v" sid="LUK 14:20"/>Pse nie kun kieliewo, 'Bi bierei agiwo, ingiese echi dane.'"<verse eid="LUK 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 14:21"/>"Hhe hoji kharei iredene ezhandene ene shiqinni man kieliewo. Ezhan hokuzhi hojidene kieliewo, 'Ghujighan echidene chenshini fugie geidou, ga geidoudedu nanxin kun, canfei, sugho, dogholonlai urude ire.' <verse eid="LUK 14:21"/><verse number="22" style="v" sid="LUK 14:22"/>Hoji ezhandene kieliewo, 'Chi kieliesanlai man banji goudaghawo, da kun oron wine.' <verse eid="LUK 14:22"/><verse number="23" style="v" sid="LUK 14:23"/>Hojidene kieliewo, 'Chi echidene dalu mo jieredu, ga mo jierededu kunlai ninkounin uruzhi iredene mini oronni souzhi durugha.' <verse eid="LUK 14:23"/><verse number="24" style="v" sid="LUK 14:24"/>Bi tande kielieye. Touchan xinlasan dunda mini ghurunse ijiechen kun nieda uwo."<verse eid="LUK 14:24"/></para>
  <para style="s">Daghasan Kun Daijia Feine</para>
  <para style="r">(<ref loc="MAT 10:37-38">Mat 10:37-38</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25"/>Tebieji olon kun <char style="pn">Ersa</char>re hhantu yozho. Hhe ochiradene hhelade kieliewo, <verse eid="LUK 14:25"/><verse number="26" style="v" sid="LUK 14:26"/>"Kun mini enende irese goyane ada, ana, bierei, kesila, eghechijiu, gaijiulasene, pse goya aminsene made olon ulie orese mini tuji danla dane. <verse eid="LUK 14:26"/><verse number="27" style="v" sid="LUK 14:27"/>Kien goya shizijiane beiliezhi mii ulie daghase mini tuji danla dane."<verse eid="LUK 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 14:28"/>"Ta kien lou giekude giezhi gholughanu gholugha dane giezhi baerni ulie sananu? <verse eid="LUK 14:28"/><verse number="29" style="v" sid="LUK 14:29"/>Kunpa ta jichune jiedene pse giedase kunla uzhezhi xiniene, <verse eid="LUK 14:29"/><verse number="30" style="v" sid="LUK 14:30"/>'Ene nie kun loune giedene giezhi khigha dawo.'"<verse eid="LUK 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 14:31"/>"Pse nie honshan hhe nie gojiani honshanghala eghindune giese xien soudene kun giedughon bikuni ulie sananu? Bi 10000 kunghala kunlai 20000 kunni eghi shidanu? <verse eid="LUK 14:31"/><verse number="32" style="v" sid="LUK 14:32"/>Eghi dase hhela gholo bikude kun nie peisenu matugiezhi heqishighakui shanlian giene. <verse eid="LUK 14:32"/><verse number="33" style="v" sid="LUK 14:33"/>Kienliuzhe shihenine ulie jiese mini tuji danla dane."<verse eid="LUK 14:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34"/>"Dansunshi gouni wo. Widaoni widase pse matugie koudaghane? <verse eid="LUK 14:34"/><verse number="35" style="v" sid="LUK 14:35"/>Widao widasan dansunni ghazha, hhaghade teise yama zoin uwo. Zinie ghadane bendane. Chighin bitu kunla chenliendu!"<verse eid="LUK 14:35"/></para>
  <chapter eid="LUK 14"/>
  <chapter number="15" style="c" sid="LUK 15"/>
  <para style="s">Moni Widaghasan Ghoni</para>
  <para style="r">(<ref loc="MAT 18:12-14">Mat 18:12-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1"/>Shui shanjisan kun, zuirenla <char style="pn">Ersa</char>ni shida echizhi jianjisanyi chenliene giezho. <verse eid="LUK 15:1"/><verse number="2" style="v" sid="LUK 15:2"/>Falisai kun, jinwun hanjiala nieniedene <char style="pn">Ersa</char>ni sugienduzhi ene kun zuirenlare hhantu souzhi ijiezho giezho.<verse eid="LUK 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 15:3"/>Ingiese <char style="pn">Ersa</char> hhelade bilazhi kieliewo. <verse eid="LUK 15:3"/><verse number="4" style="v" sid="LUK 15:4"/>"Tai dunda kien 100 gie ghoni dunda nie ghoni yo widase 99 gie ghonine banchede jiedene widasan ghonii ereizhi ulie olunu? <verse eid="LUK 15:4"/><verse number="5" style="v" sid="LUK 15:5"/>Ereizhi oludene bayasuzhi dalou jierene danladene giedene echiwo. <verse eid="LUK 15:5"/><verse number="6" style="v" sid="LUK 15:6"/>Zhanlien, giebeiladene widasan ghoni ereizhi oluwo. Matan hhantu hunnerei daghaye giezho. <verse eid="LUK 15:6"/><verse number="7" style="v" sid="LUK 15:7"/>Bi tande kielieye, nie zuiren geizhen giese asiman jiereye hhende oluzhi bayasune. Hhe geizhen gieku biyo wichen 99 gie gou kunlase pse olon bayasune."<verse eid="LUK 15:7"/></para>
  <para style="s">Widaghasan Nie Miengu</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8"/>"Pse nie bierei hharan miengusene nieni wida khighase zhulane jienjidene gieni xianxide shuzhi ereizhi ulie olunu? <verse eid="LUK 15:8"/><verse number="9" style="v" sid="LUK 15:9"/>Ereizhi oluse zhanlienlane giebeilane uruzhi matan hhantu nie hunnerei daghaye giene. <verse eid="LUK 15:9"/><verse number="10" style="v" sid="LUK 15:10"/>Bi tande kielieye, nie zuiren geizhen giese Hudai qienxienla hhende oluzhi ingiezhi bayasune."<verse eid="LUK 15:10"/></para>
  <para style="s">Adani Oreku</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11"/>
    <char style="pn">Ersa</char> pse kieliewo, "Nie kunde ghua kewon wo. <verse eid="LUK 15:11"/><verse number="12" style="v" sid="LUK 15:12"/>Ga kewonni adadene kieliewo, 'Ada, chi jiachanse made kuruku nexianni ghughazhi ogi.' Ingiese adani goya jiachanne ghualade ghugha ogiwo."<verse eid="LUK 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 15:13"/>"Giedudu beidene ga kewonni dunxilane agidene niman gojiade echiwo. Ingiedene dunxi baerlane man hu zharu widaghawo. <verse eid="LUK 15:13"/><verse number="14" style="v" sid="LUK 15:14"/>Man huai widaghasenu hhe oronde honnien penjise nanxinshizhi oliesuzho. <verse eid="LUK 15:14"/><verse number="15" style="v" sid="LUK 15:15"/>Ingie hhe oronni nie kunde kouizhi ghazhade khighei qiezheghazho. <verse eid="LUK 15:15"/><verse number="16" style="v" sid="LUK 15:16"/>Hende oliesuse khighei ijieku noshui ijiene gieliuzhe kiema ulie ogine."<verse eid="LUK 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 15:17"/>"Hhe minbairedene kieliewo, 'Adaimi kha doura qimegheni wiliechi wo. Hhelade ijieku taranye olon no wo. Bi enende oliesuzhi fugune. <verse eid="LUK 15:17"/><verse number="18" style="v" sid="LUK 15:18"/>Bosidene adane hhende echine. Ingie "Ada, bi Hudai melie, chii melie giesan ese oluzho. <verse eid="LUK 15:18"/><verse number="19" style="v" sid="LUK 15:19"/>Enedu khuinase bi chade kewon danla dane. Mini nie wiliechi danlagha." giezhi kielieye.'"<verse eid="LUK 15:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 15:20"/>"Ingiedene bosizhe adane hhende echiwo. Adani gholose chanladene zhugheni zholierese holu echi qioru agi orewo. <verse eid="LUK 15:20"/><verse number="21" style="v" sid="LUK 15:21"/>Kewonni adadene kieliewo, 'Ada, bi Hudai melie, chii melie giesan ese oluzho. Enedu khuinase bi chade kewon danla dane.'"<verse eid="LUK 15:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 15:22"/>"Adani hojidene kieliewo, 'Ghujighan gou jienni agizhe musigha. Kha jiereni geizhi zhogha. Mahei musigha. <verse eid="LUK 15:22"/><verse number="23" style="v" sid="LUK 15:23"/>Hhe taghun fughe tughuchai lai khizhe zharu. Matan ochizhi ijiezhi hunnerei daghaye. <verse eid="LUK 15:23"/><verse number="24" style="v" sid="LUK 15:24"/>Mini fugusan kewon aminne oluwo, widasan kewon kharei irewo!' Ingiese hhela hunnerei daghazho."<verse eid="LUK 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 15:25"/>"Ingiekude fugie kewonni ghazha jierese gie shida irekude doulazhi jiulisan shenqilai sonosuwo. <verse eid="LUK 15:25"/><verse number="26" style="v" sid="LUK 15:26"/>Ingie nie hojii uru ire, 'Yan shiqin wo?' giezhi asawo. <verse eid="LUK 15:26"/><verse number="27" style="v" sid="LUK 15:27"/>Hoji kieliewo, 'Jiuchii giede irewo. Hhe pinnan khareizhi irese adachii bayasuzhi taghun fughe tughuchai zharughawo.'"<verse eid="LUK 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 15:28"/>"Fugie kewonni hokuzhi ese orose adani khizhe kewondene sughazhi kieliezho. <verse eid="LUK 15:28"/><verse number="29" style="v" sid="LUK 15:29"/>Hhe adadene kieliezho, 'Bi hoji mutun chini imegheicha ushilazhi kielienyichii ese chenliezhi ese daowo. Chi made ga iman ese ogizhi zhanlienlare hunnerei ese daghaghawo. <verse eid="LUK 15:29"/><verse number="30" style="v" sid="LUK 15:30"/>Chii ene kewon biozilare hhantu jiachanchii ijie widaghadene irese hhende taghun tughuchai zharune!'"<verse eid="LUK 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 15:31"/>"Adani kieliewo, 'Kewon, chi mare hhantu chan souzho. Minughunshi man chinughun wo. <verse eid="LUK 15:31"/><verse number="32" style="v" sid="LUK 15:32"/>Jiuchini fugudene aminne oluwo, widadene khareizhi irewo. Matan indan bayasuzhi hunnerei daghakuni wo.'"<verse eid="LUK 15:32"/></para>
  <chapter eid="LUK 15"/>
  <chapter number="16" style="c" sid="LUK 16"/>
  <para style="s">Gou Witu Gonjia</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1"/>
    <char style="pn">Ersa</char> tujiladene kieliewo, "Nie bayan kunni gonjiai kunla baerni hu huaizho giezhi zhazho. <verse eid="LUK 16:1"/><verse number="2" style="v" sid="LUK 16:2"/>Ezhanni hhei uruzhi iredene kieliewo, 'Mii chighinde iresanshi yan shiqin wo? Chi zhanlai made nie jiui. Chii gonjia pse ulie danlaghane.'"<verse eid="LUK 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 16:3"/>"Hhe gonjia zhughedene kieliezho, 'Mii gonjia ulie danlaghase bi jianlai yan giene? Ghazha waise lilian uwo, ghuile echise shizhene. <verse eid="LUK 16:3"/><verse number="4" style="v" sid="LUK 16:4"/>Bi matui giekui mejiewo. Ingiezhi giese bi gonjia danla dakude kunla mini jienliene.'"<verse eid="LUK 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 16:5"/>"Ingiedene hhe ezhande baer chaisan kunlai nienieji uru irewo. Touchankude asawo, 'Chi ezhandemi giedughon chaine?' <verse eid="LUK 16:5"/><verse number="6" style="v" sid="LUK 16:6"/>'100 gie tunzi tosun chaine.' 'Chi zhanne agizhedene ghujighan souzhi 50 gie tunzi huai.' <verse eid="LUK 16:6"/><verse number="7" style="v" sid="LUK 16:7"/>Da nie kunde asazho, 'Chi giedughon chaine?' '100 gie deizi boudei chaine.' 'Chi zhanne agizhedene 80 gie deizi huai.' <verse eid="LUK 16:7"/><verse number="8" style="v" sid="LUK 16:8"/>Ezhanni gou witu gonjiai jienzhaini kuaiwo. Ene duyani kunla goyadene shiqin banjise gonni kunlase jienzha wo."<verse eid="LUK 16:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 16:9"/>"Bi tande kielieye, duyai baerghala goyadene oluzhi zhanlien tani. Ingiese baer widakude qientande tai jienliene. <verse eid="LUK 16:9"/><verse number="10" style="v" sid="LUK 16:10"/>Ta ga shiqinde zhunshi ulie giese fugie shiqindeye zhunshi ulie giene. Ga shiqinde undan wise fugie shiqindeye undan uwo. <verse eid="LUK 16:10"/><verse number="11" style="v" sid="LUK 16:11"/>Ta duyani baerni zhunshi ulie giese tande kien asiman jieredu zhen baerni gonjighane? <verse eid="LUK 16:11"/><verse number="12" style="v" sid="LUK 16:12"/>Ta kunlai dunxilai zhunshi ulie giese tande kien dunxilane ogine?"<verse eid="LUK 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 16:13"/>"Alinie hojiliuzhe ghua ezhanni shunji dane. Ene niede henjise hhe niede orene. Ene niede gundushi hhe niede gongien wo. Ta Huda baer ghualai hhantu shunji dane."<verse eid="LUK 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14"/>Falisai kun jin baerrezhe, ene kielienyi sonosudene uzhezhi xiniezho. <verse eid="LUK 16:14"/><verse number="15" style="v" sid="LUK 16:15"/><char style="pn">Ersa</char> hhelade kieliewo, "Ta kunyi melie gou kun danlazho. Tai zhughede yan sumulasanyi Huda mejiene. Kunlai melie kuaisanshi Hudai melie henjikuni wo. <verse eid="LUK 16:15"/><verse number="16" style="v" sid="LUK 16:16"/><char style="pn">Musa</char>ni guijin, xienzhishu <char style="pn">Yaheiya</char>se jieshu oluwo. Enense khuinashi Hudai gojiai gouxioxii chonji keiwo, kunla man xiacha giezhi hhende orone giezho. <verse eid="LUK 16:16"/><verse number="17" style="v" sid="LUK 16:17"/>Ingieliuzhe asiman zemin widaliuzhe guijin jieredu nie jienjienda ulie widane. <verse eid="LUK 16:17"/><verse number="18" style="v" sid="LUK 16:18"/>Kien biereighalane lihun giedene pse agise piofen giezho. Lihun giesan biereini agisan kunye piofen giezho."<verse eid="LUK 16:18"/></para>
  <para style="s">Nie Bayan Kun Lasalughala</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19"/>"Nie bayan kun zishei gou jien musizhi niudunie gofende xianfu giezho. <verse eid="LUK 16:19"/><verse number="20" style="v" sid="LUK 16:20"/>Nie <char style="pn">Lasalu</char> giesan ghuichenyi hunshende man yara wo. Chan bayan kunyi wijien konde soughazho. <verse eid="LUK 16:20"/><verse number="21" style="v" sid="LUK 16:21"/>Sumulase bayan kunyi shire jierese ijiezhi feiliesan ginan zhazha anda bou irese ijiezhi chudune giezho. Lien noghei irezhi yaraini doluzho. <verse eid="LUK 16:21"/><verse number="22" style="v" sid="LUK 16:22"/>Khuinashi ghuichen duya ijiewo. Qienxienla qienliedene <char style="pn">Iburaheimu</char>i shida echighawo. Hhe bayan kun ye duya ijiedene bulawo."<verse eid="LUK 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 16:23"/>"Bayan kun dozoheide lolien giezho. Qiorunne qila gholose marazhi <char style="pn">Iburaheimu</char>i chanlawo. <char style="pn">Lasalu</char> hhei shida wo. <verse eid="LUK 16:23"/><verse number="24" style="v" sid="LUK 16:24"/>Waradazhi kieliewo, '<char style="pn">Iburaheimu</char> mii xienren, made ubali nie xii! <char style="pn">Lasalu</char>i dafalazhi kha ghurundene usu nie zhanjidene kielienyimi nie liandagha gie. Bi khan dunda siderazhi tendun shouizho!'"<verse eid="LUK 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 16:25"/>"<char style="pn">Iburaheimu</char> kieliewo, 'Kewon, chi melieshida xianfu giesanne nie sumula. <char style="pn">Lasalu</char> lolien giezho. Ede <char style="pn">Lasalu</char>de futanshiwo, chi lolien giene. <verse eid="LUK 16:25"/><verse number="26" style="v" sid="LUK 16:26"/>Pse nieshi matanyi dunda ghon geizho. Bi chii hhende daorene giese daore dane. Chi mii enende daorene gieliuzheye daore dane.'"<verse eid="LUK 16:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 16:27"/>"Bayan kun kieliewo, 'Mii xienren, qinse bi chii xiahua gieye. <char style="pn">Lasalu</char>i mii giede peizhi echigha. <verse eid="LUK 16:27"/><verse number="28" style="v" sid="LUK 16:28"/>Made tawun gaijiu wo. Hhe echidene nie jingao gie gie. Pse hhela ene oronde lolien giele irene.'"<verse eid="LUK 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 16:29"/>"<char style="pn">Iburaheimu</char> kieliewo, 'Hhelade <char style="pn">Musa</char>i shu, xienzhilai shu wine. Chenlie gie.' <verse eid="LUK 16:29"/><verse number="30" style="v" sid="LUK 16:30"/>Hhe kieliewo, 'Ulie olune, mii xienren <char style="pn">Iburaheimu</char>, fugusan kun aminne oludene echise hhela geizhen giene.' <verse eid="LUK 16:30"/><verse number="31" style="v" sid="LUK 16:31"/><char style="pn">Iburaheimu</char> kieliewo, '<char style="pn">Musa</char>i shu, xienzhilai shui ulie chenliese fugusan kun aminne oluseye ulie chenliene.'"<verse eid="LUK 16:31"/></para>
  <chapter eid="LUK 16"/>
  <chapter number="17" style="c" sid="LUK 17"/>
  <para style="s">Zui Roulieku Xianxin Giekuni Surughazho</para>
  <para style="r">(<ref loc="MAT 18:6-7">Mat 18:6-7</ref>, <ref loc="MAT 18:21-22">21-22</ref>; <ref loc="MRK 9:42">Mak 9:42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1"/>
    <char style="pn">Ersa</char> tujiladene kieliewo, "Zui fanjiku shiqin chan winema, kunlai zui fanjighasan hhe kunde gou widawo! <verse eid="LUK 17:1"/><verse number="2" style="v" sid="LUK 17:2"/>Enezighan ga kun dundadu niei zui fanjighase ghuzhundeni qiemanshai banladene haide boughase da gou wo. <verse eid="LUK 17:2"/><verse number="3" style="v" sid="LUK 17:3"/>Ta xioxin giendu, gaijiutai chii hokughase kheila. Hhe geizhen giese roulie. <verse eid="LUK 17:3"/><verse number="4" style="v" sid="LUK 17:4"/>Nie kun niudude doleifa zui fanjidene doleifa khareizhi 'Bi ese oluzho.' giezhi kieliese roulie."<verse eid="LUK 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5"/>Shitula Ezhande kieliewo, "Bijiende xianxin giekui olodogha." <verse eid="LUK 17:5"/><verse number="6" style="v" sid="LUK 17:6"/>Ezhan kieliewo, "Tande caizi fure chigei xianxin gieku bise ta ene sunshu mutunde chi genzilada khizhe haide echi osi gieseye kielienyichii chenliene."<verse eid="LUK 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 17:7"/>"Tai dunda kienyi hoji ghazha qighalazhi irenu, ghoni adulazhi irese 'Chi ghujighan soudene ijie.' giezhi kielienu? <verse eid="LUK 17:7"/><verse number="8" style="v" sid="LUK 17:8"/>Kenjin ulie kieliene. Khareidene 'Chi made budan giezhi mii ushilazhi ijieghadene chi ochizhi ijie.' giezhi kieliene. <verse eid="LUK 17:8"/><verse number="9" style="v" sid="LUK 17:9"/>Hoji ezhan kieliesan mutun giese ezhan mafan giezho giezhi kielienu? Ulie kieliene. <verse eid="LUK 17:9"/><verse number="10" style="v" sid="LUK 17:10"/>Taye niekielien wo. Ta ezhan kieliesan mutun giezhi baraghadene ingiezhi kieliene, 'Bijienshi yama gie daku hoji wo. Eneshi bijien indan giekuni wo.'"<verse eid="LUK 17:10"/></para>
  <para style="s">Hharan Pifugientuni Goudaghazho</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11"/>
    <char style="pn">Ersa</char> <char style="png">Yelusalen</char>de echikude <char style="png">Samaliya</char>, <char style="png">Jialili</char>ni dundadu oronde echizho. <verse eid="LUK 17:11"/><verse number="12" style="v" sid="LUK 17:12"/>Nie aghinde orone giese hharan pifugientu gholode ire beidene <verse eid="LUK 17:12"/><verse number="13" style="v" sid="LUK 17:13"/>fugiede waradazho, "Ezhan <char style="pn">Ersa</char> bijiende ubali nie xii!"<verse eid="LUK 17:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 17:14"/>
    <char style="pn">Ersa</char> chanladene kieliewo, "Ta buwalade goya beyene uzheghale echi." Hhela echikude ijin goudawo. <verse eid="LUK 17:14"/><verse number="15" style="v" sid="LUK 17:15"/>Hhelai dundase nie kun goyane goudasanyi mejiedene kharei ire Hudai fugiede kuaizho. <verse eid="LUK 17:15"/><verse number="16" style="v" sid="LUK 17:16"/><char style="pn">Ersa</char>i kon konde xiutulie papaladene mafan kieliewo. Eneshi <char style="png">Samaliya</char> kun wo. <verse eid="LUK 17:16"/><verse number="17" style="v" sid="LUK 17:17"/><char style="pn">Ersa</char> kieliewo, "Ta goudasanshi hharolie wola? Da yesun kun khala wo? <verse eid="LUK 17:17"/><verse number="18" style="v" sid="LUK 17:18"/>Ene niman kunse chugo pse nieda Hudai kuaile ese irewu?" <verse eid="LUK 17:18"/><verse number="19" style="v" sid="LUK 17:19"/>Ingie hhe kunde kieliewo, "Chi bosizhedene echi. Chii xianxin gieku chii jiuiwo."<verse eid="LUK 17:19"/></para>
  <para style="s">Hudani Gojia Ireku</para>
  <para style="r">(<ref loc="MAT 24:23-28">Mat 24:23-28</ref>, <ref loc="MAT 24:37-41">37-41</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20"/>Niudude Falisai kunla <char style="pn">Ersa</char>de asazho, "Hudai gojia yan shihoude irene?" <char style="pn">Ersa</char> kieliewo, "Hudai gojia irese chanlakui pusho. <verse eid="LUK 17:20"/><verse number="21" style="v" sid="LUK 17:21"/>Kunla uzhe, Hudai gojia enende wo, hhende wo giezhi ulie kieliene. Hudai gojia tani dunda<note caller="+" style="f"><char style="fr">17:21</char> <char style="em">tani sudoro</char> </note> wo."<verse eid="LUK 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22"/>Pse tujiladene kieliewo, "Ta Kunnikewonni niudui uzhene gieku shihou kuzhenema, uzhe dane. <verse eid="LUK 17:22"/><verse number="23" style="v" sid="LUK 17:23"/>Kunla 'Uzhe, kunnikewon enende wo.' 'Uzhe, hhende wo.' giezhi kieliese ta bu echi. Hhelai bu dagha. <verse eid="LUK 17:23"/><verse number="24" style="v" sid="LUK 17:24"/>Shanjien asiman enemiense khizhezhi hhemiende zhouiku mutun Kunnikewonni ududeye ingiene. <verse eid="LUK 17:24"/><verse number="25" style="v" sid="LUK 17:25"/>Kunnikewon irese ijinyo xien shouku giezhi ene idai kunla hhei fandui giene."<verse eid="LUK 17:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 17:26"/>"<char style="pn">Nuhha</char>ni xienzide matugiezhoshi Kunnikewonyi xienzideye qingiene. <verse eid="LUK 17:26"/><verse number="27" style="v" sid="LUK 17:27"/>Hhe shihoudedu kunla ijiezho, ochizho, bierei agizho, dafalazhi izhi <char style="pn">Nuhha</char> chon sudoro oroku hhe udude hunshui iredene man yenji alawo."<verse eid="LUK 17:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 17:28"/>"Kunnikewonni udu <char style="pn">Lutei</char>i hhe shihoudedu niekielien wo. Hhe kunla ijiezho, ochizho, agizho, huizho, ghazha tareizho, gie giezho. <verse eid="LUK 17:28"/><verse number="29" style="v" sid="LUK 17:29"/><char style="pn">Lutei</char> <char style="png">Sodoma</char>se yolaku hhe niudude khan funi asiman jierese bouredene man sidera widawo."<verse eid="LUK 17:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 17:30"/>"Kunnikewon xienjiku ududeye ingiene. <verse eid="LUK 17:30"/><verse number="31" style="v" sid="LUK 17:31"/>Hhe udude gie jieredu kunla giederase dunxilai agile bu bouzhe. Ghazha jieredulaye giedene khareizhi bu echi. <verse eid="LUK 17:31"/><verse number="32" style="v" sid="LUK 17:32"/>Ta <char style="pn">Lutei</char>i bierei matui gholusanni nie sumula. <verse eid="LUK 17:32"/><verse number="33" style="v" sid="LUK 17:33"/>Kien aminne baohu giene giese aminne widaghane. Aminne widaghase jiuine. <verse eid="LUK 17:33"/><verse number="34" style="v" sid="LUK 17:34"/>Bi tande kielieye, hhe nie xii ghuala nie chon jiere kijiese niei uduru echine, niei jiene. <verse eid="LUK 17:34"/><verse number="35" style="v" sid="LUK 17:35"/>Ghua bierei qieman sidase niei uduru echine, niei jiene."<verse eid="LUK 17:35"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 17:37"/>Hhela asawo, "Ezhan, imutu shiqin khala fashen giene?"</para>
  <para style="p" vid="LUK 17:37">
    <char style="pn">Ersa</char> hhelade kieliewo, "Fugusan dunxi khalashi inye khala wo."<verse eid="LUK 17:37"/></para>
  <chapter eid="LUK 17"/>
  <chapter number="18" style="c" sid="LUK 18"/>
  <para style="s">Guafu Noyenghala</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1"/>
    <char style="pn">Ersa</char> tujiladene izhi ulie beidene onxian giezhi zhughe ulie widakui bilazhi kieliewo. <verse eid="LUK 18:1"/><verse number="2" style="v" sid="LUK 18:2"/>"Nie chenshide nie noyen Hudase ulie ayine, kunlaiye ulie zunjine. <verse eid="LUK 18:2"/><verse number="3" style="v" sid="LUK 18:3"/>Hhe chenshide nie guafu wo. Ibeizi noyenyi hhende echizhi kieliezho, 'Made nie duitou wo. Chi made gundande chuli gie.' <verse eid="LUK 18:3"/><verse number="4" style="v" sid="LUK 18:4"/>Ene noyen izhi ese gonjizho. Oloncha oludene sudorone sumulazho, 'Bi Hudase ulie ayine, bexinlaiye ulie zunjinema, <verse eid="LUK 18:4"/><verse number="5" style="v" sid="LUK 18:5"/>ene bierei ibeizi mii souine. Enei bi goudaghaye pse mini jindaghazhi alane.'"<verse eid="LUK 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 18:6"/>Ezhan kieliewo, "Ene gou witu noyen kieliesanyi ta chenlie. <verse eid="LUK 18:6"/><verse number="7" style="v" sid="LUK 18:7"/>Huda sunghuzhi irezhi xieni udu hhei waradasan kunlade Huda gundanni ulie ogidene udazhi banman gienu? <verse eid="LUK 18:7"/><verse number="8" style="v" sid="LUK 18:8"/>Bi tande kielieye, Huda hhelade ghujighan gundanni ogine. Ingieliuzhe Kunnikewon irekude duyade goude xianxin giechen kun giedun ereizhi olune?"<verse eid="LUK 18:8"/></para>
  <para style="s">Falisai Kun, Shui Shanjisan Kunni Onxian</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9"/>Goyaneshi gou kun wo giezhi kunlai meilade uzhesan kunlade <char style="pn">Ersa</char> bilazhi kieliewo. <verse eid="LUK 18:9"/><verse number="10" style="v" sid="LUK 18:10"/>"Nie Falisai kun shui shanjisan kunghala huitande onxian giele echiwo. <verse eid="LUK 18:10"/><verse number="11" style="v" sid="LUK 18:11"/>Falisai kun niezheghan beidene onxian giezho, 'Huda, bi chade mafan kielieye. Bi kunlai buxian wo. Ese qianlazho, gou wini ese giezho, piofen ese giezho. Ene shui shanjisan kunyiye genben buxian wo. <verse eid="LUK 18:11"/><verse number="12" style="v" sid="LUK 18:12"/>Bi nie xinqide lianhui orozo bareizho. Shourusene 10 fenzhi 1 ni chade ogizho.' <verse eid="LUK 18:12"/><verse number="13" style="v" sid="LUK 18:13"/>Shui shanjisan kun gholode beidene asimanyi ayizhi uzhe da echanne chuidazhi kieliezho, 'Huda, bishi zuiren wo. Made ubali nie xii!' <verse eid="LUK 18:13"/><verse number="14" style="v" sid="LUK 18:14"/>Bi tande kielieye, giedene echikude Huda gounide sanasanshi hhe kun pusho, ene kun wo. Kien goyane undudaghase boghonidaghane. Goyane boghonidaghase undudaghane."<verse eid="LUK 18:14"/></para>
  <para style="s">Kesilai Jienliezho</para>
  <para style="r">(<ref loc="MAT 19:13-15">Mat 19:13-15</ref>; <ref loc="MRK 10:13-16">Mak 10:13-16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15"/>Kunla jiujiulane qioruzhi <char style="pn">Ersa</char>i melie ire maqighane giezho. Tujila chanladene hhelai sugiezho. <verse eid="LUK 18:15"/><verse number="16" style="v" sid="LUK 18:16"/><char style="pn">Ersa</char> hhelai uruzhi ire tujilade kieliewo, "Kesilai bu dui, mii shida ire gie. Hudai gojiashi imutu kunlanughun wo. <verse eid="LUK 18:16"/><verse number="17" style="v" sid="LUK 18:17"/>Bi tande shuhua kielieye, kien kewosi mutun Hudai gojiai ulie jienliese hhende oro dane."<verse eid="LUK 18:17"/></para>
  <para style="s">Nie Bayan Noyen</para>
  <para style="r">(<ref loc="MAT 19:16-30">Mat 19:16-30</ref>; <ref loc="MRK 10:17-31">Mak 10:17-31</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18"/>Nie noyen <char style="pn">Ersa</char>de asawo, "Gou loushi, bi matui giese chanqiku aminni jienliene?" <verse eid="LUK 18:18"/><verse number="19" style="v" sid="LUK 18:19"/><char style="pn">Ersa</char> hhende kieliewo, "Chi mii yangiezhi gou wo giezho? Hudase chugo gouni uwo. <verse eid="LUK 18:19"/><verse number="20" style="v" sid="LUK 18:20"/>Minlinyi chi mejiene, Piofen bu gie, kun bu ala, bu ghula, jia ganzhen bu bei, ada anane zunji giezho." <verse eid="LUK 18:20"/><verse number="21" style="v" sid="LUK 18:21"/>Hhe kieliewo, "Enelai bi ga xienzise man zunjizho." <verse eid="LUK 18:21"/><verse number="22" style="v" sid="LUK 18:22"/><char style="pn">Ersa</char> chenliedene kieliewo, "Chade da nie chaizho. Chi bisanlane man huizhi nanxin kunlade ogi. Ingiese chii boubei asiman jiere wo. Ingiedene irezhi mii dagha." <verse eid="LUK 18:22"/><verse number="23" style="v" sid="LUK 18:23"/>Hheshi nie fugie bayan kun wo. Ene kielienyi chenliedene hende yuchourazho.<verse eid="LUK 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 18:24"/>
    <char style="pn">Ersa</char> hhei uzhedene kieliewo, "Baertu kun Hudai gojiade oroku chijia no wo. <verse eid="LUK 18:24"/><verse number="25" style="v" sid="LUK 18:25"/>Loto zhun boghose daoku bayan kun Hudai gojiade orokuse da sunfan wo."<verse eid="LUK 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 18:26"/>Chenliesan kunla kieliewo, "Ingiese kienyi jiui shidane?" <verse eid="LUK 18:26"/><verse number="27" style="v" sid="LUK 18:27"/><char style="pn">Ersa</char> kieliewo, "Kun gie dakui Huda giene." <verse eid="LUK 18:27"/><verse number="28" style="v" sid="LUK 18:28"/><char style="pn">Beduru</char> kieliewo, "Uzhe, bijien goyanughunne bendadene chii daghazho." <verse eid="LUK 18:28"/><verse number="29" style="v" sid="LUK 18:29"/><char style="pn">Ersa</char> kieliewo, "Bi tande shuhua kielieye, kun Hudai gojiade oluzhi gie, bierei, gaijiu, ada, ana, kesilane bendase <verse eid="LUK 18:29"/><verse number="30" style="v" sid="LUK 18:30"/>ene duyade pse olon ogine, houshide chanqiku amin ogine."<verse eid="LUK 18:30"/></para>
  <para style="s">Ersa Shouku Giezhi Aminne Olukuni ji 3 Hui Kieliezho</para>
  <para style="r">(<ref loc="MAT 20:17-19">Mat 20:17-19</ref>; <ref loc="MRK 10:32-34">Mak 10:32-34</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31"/>
    <char style="pn">Ersa</char> 12 gie tujii uruzhi ire hhelade kieliewo, "Uzhe, matan <char style="png">Yelusalen</char>de khireine. Xienzhila Jinwun jiere huaisan mutun Kunnikewonyi shiqinyi man gholughane. <verse eid="LUK 18:31"/><verse number="32" style="v" sid="LUK 18:32"/>Hhela hhei niman kunlade jiuise kunla xilun, shizheghane, ungie jiere nunpune. <verse eid="LUK 18:32"/><verse number="33" style="v" sid="LUK 18:33"/>Mabienzighala eghine, da alane. Ingie ghurudude aminne olune."<verse eid="LUK 18:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 18:34"/>Ene shiqinyi tujila dunjire dawo. Isii niuighazho, hhela hhe kieliesan isii mejie dawo.<verse eid="LUK 18:34"/></para>
  <para style="s">Sughoni Goudaghazho</para>
  <para style="r">(<ref loc="MAT 20:29-34">Mat 20:29-34</ref>; <ref loc="MRK 10:46-52">Mak 10:46-52</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35"/>
    <char style="pn">Ersa</char> <char style="png">Yelige</char>de chadashikude nie sugho mo bienzide soudene ghuizho. <verse eid="LUK 18:35"/><verse number="36" style="v" sid="LUK 18:36"/>Olon kun yozhi daokude sugho sonosudene, "Yan shiqin wo?" giezhi asazho. <verse eid="LUK 18:36"/><verse number="37" style="v" sid="LUK 18:37"/>Hhela sughode kieliewo, "<char style="png">Nasale</char> kun <char style="pn">Ersa</char> yozhi daowo." <verse eid="LUK 18:37"/><verse number="38" style="v" sid="LUK 18:38"/>Deigo waradawo, "<char style="pn">Dawude</char>ni houdei <char style="pn">Ersa</char>, made ubali nie xii!" <verse eid="LUK 18:38"/><verse number="39" style="v" sid="LUK 18:39"/>Melie yosan kunla shenqi bu khizhe giezhi jiebalase hhe genjia fugiede waradazhi kieliezho, "<char style="pn">Dawude</char>ni houdei, made ubali nie xii!"<verse eid="LUK 18:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 18:40"/>
    <char style="pn">Ersa</char> beidene hhei urudei ire giezhi kieliewo. Hhe dao irese hhende asawo, <verse eid="LUK 18:40"/><verse number="41" style="v" sid="LUK 18:41"/>"Bi chade yan giene?" Hhe kieliewo, "Ezhan, bi chanlaku duran wo!" <verse eid="LUK 18:41"/><verse number="42" style="v" sid="LUK 18:42"/><char style="pn">Ersa</char> kieliewo, "Chi chanla. Chii xianxin gieku chii jiuiwo." <verse eid="LUK 18:42"/><verse number="43" style="v" sid="LUK 18:43"/>Sugho deigo chanladene Hudai kuaizhi <char style="pn">Ersa</char>i daghawo. Kunla enei uzhedene Hudade doulazho.<verse eid="LUK 18:43"/></para>
  <chapter eid="LUK 18"/>
  <chapter number="19" style="c" sid="LUK 19"/>
  <para style="s">Ersa Sagai Ghuala</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1"/>
    <char style="pn">Ersa</char> <char style="png">Yelige</char>de orodene yozhi daokude <verse eid="LUK 19:1"/><verse number="2" style="v" sid="LUK 19:2"/>nie kunyi niereini <char style="pn">Sagai</char> giene. Shui shanjisan kun dunda qienli fugie wo, bayan no wo. <verse eid="LUK 19:2"/><verse number="3" style="v" sid="LUK 19:3"/>Hhe <char style="pn">Ersa</char>shi matunie kun bikui uzhene giezhoma, kun olon, beyeni gajishi uzhe dazho. <verse eid="LUK 19:3"/><verse number="4" style="v" sid="LUK 19:4"/>Ingie holu melieshidadene nie mutun jiere khirei <char style="pn">Ersa</char>i uzhene giezho. <char style="pn">Ersa</char> hhense yozhi daone.<verse eid="LUK 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 19:5"/>
    <char style="pn">Ersa</char> mutun konde echidene qiorunne qila kieliewo, "<char style="pn">Sagai</char>, ghujighan bouzhe. Enedu bi chii giede ijinyo soune."<verse eid="LUK 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 19:6"/>Hhe jindazhi bouzhedene hende bayasuzhi <char style="pn">Ersa</char>i jienliewo. <verse eid="LUK 19:6"/><verse number="7" style="v" sid="LUK 19:7"/>Uzhesan kunla ene matugie zuirenyi giede souwo giezhi nieniedene kieliezho.<verse eid="LUK 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 19:8"/>
    <char style="pn">Sagai</char> beidene Ezhande kieliewo, "Bi giei jiachansene olienyi nanxin kunlade ogiye. Pse bi kienyi piendazhoshi 1 peide 4 pei honjiye."<verse eid="LUK 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 19:9"/>
    <char style="pn">Ersa</char> kieliewo, "Enedu jiuiku nenjien ene nie giede kuzhewo. Ene kunshiye <char style="pn">Iburaheimu</char>ni houdei wo. <verse eid="LUK 19:9"/><verse number="10" style="v" sid="LUK 19:10"/>Kunnikewon widasan kunlai ereizhi jiuile irewo."<verse eid="LUK 19:10"/></para>
  <para style="s">Hharan Hojini Bilazho</para>
  <para style="r">(<ref loc="MAT 25:14-30">Mat 25:14-30</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11"/>Kunla zhen chenliekude <char style="pn">Ersa</char> <char style="png">Yelusalen</char>se chadashiwo. Kunla sumulazhi Hudai gojia ede kuzhewo giezho. Ingie <char style="pn">Ersa</char> nie bilazhi kieliewo. <verse eid="LUK 19:11"/><verse number="12" style="v" sid="LUK 19:12"/>"Nie fugie noyen gholose nie gojiani honshan danlaku qienli keredene irene giezho. <verse eid="LUK 19:12"/><verse number="13" style="v" sid="LUK 19:13"/>Echikude hharan hojii uru ire hhelade hharan antan ogidene kieliewo, 'Bi iretula ta meimei giendu.' <verse eid="LUK 19:13"/><verse number="14" style="v" sid="LUK 19:14"/>Hhei gojiani kunla ene noyenyi henjizhi daibioni khuina dafalazhi echigha 'Ene kunyi matande honshan danlaghaku duran uwo.' giezhi kieliewo."<verse eid="LUK 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 19:15"/>"Hhe noyen qienli kerezhi iredene baer ogisan hojilai uruzhi ire baer giedughon zhenjisei mejiene giezho. <verse eid="LUK 19:15"/><verse number="16" style="v" sid="LUK 19:16"/>Ji 1 gie hojini kieliewo, 'Ezhan, bi nie antan jierese 10 pei zhenjiwo.' <verse eid="LUK 19:16"/><verse number="17" style="v" sid="LUK 19:17"/>Noyen hhende kieliewo, 'Giesan gou wo. Chishi gou hoji wo. Chi ga shiqinde shixinji giezho, ingiese bi chade hharan chenshi gonjighaye.'"<verse eid="LUK 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 19:18"/>"Da nie hojini kieliewo, 'Ezhan, bi nie antan jierese 5 pei zhenjiwo.' <verse eid="LUK 19:18"/><verse number="19" style="v" sid="LUK 19:19"/>Noyen ene niedeye kieliewo, 'Bi chade tawun chenshi gonjighaye.'"<verse eid="LUK 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 19:20"/>"Pse nie hojini kieliewo, 'Ezhan, uzhe. Bi chii ene nie antanyi shoujinde boui ghurazho. <verse eid="LUK 19:20"/><verse number="21" style="v" sid="LUK 19:21"/>Chi lihaishi bi chase ayizho. Chi ese jiesan oronse agine, ese tareisan oronse ghurane.'"<verse eid="LUK 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 19:22"/>"Noyen hhende kieliewo, 'Chi ene doghun hoji! Bi chii kielienghala chii kheilane. Bi ese jiesan oronse agizhi ese tareisan oronse ghurachen lihaitu kun bikui chi mejienu? <verse eid="LUK 19:22"/><verse number="23" style="v" sid="LUK 19:23"/>Qinse mini baerni yale inhande ese teiwo? Bi irekude benqien lixiji agi khizhene.' <verse eid="LUK 19:23"/><verse number="24" style="v" sid="LUK 19:24"/>Ingie hhe shida beisan kunlade kieliewo, 'Ene kunse nie antanni agi echidene hharan antantu kunde ogi.'"<verse eid="LUK 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 19:25"/>"Ingie kunla hhende kieliewo, 'Ezhan, hhende hharan antan wine.' <verse eid="LUK 19:25"/><verse number="26" style="v" sid="LUK 19:26"/>Noyen kieliewo. 'Bi tande kielieye, bichen kunde pse olon ogine. Wichen kunse bisanlainiye agi echine. <verse eid="LUK 19:26"/><verse number="27" style="v" sid="LUK 19:27"/>Mini honshan ulie danlaghachen hhe duitoulai mini melie lai iredene ala.'"<verse eid="LUK 19:27"/></para>
  <para style="s">Honshan Mutun Yelusalende Orozho</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mat 21:1-11</ref>; <ref loc="MRK 11:1-11">Mak 11:1-11</ref>; <ref loc="JHN 12:12-19">Yah 12:12-19</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28"/>
    <char style="pn">Ersa</char> enei kielie baludene melie yozhi <char style="png">Yelusalen</char>de khireine giezho. <verse eid="LUK 19:28"/><verse number="29" style="v" sid="LUK 19:29"/><char style="png">Ganlanshan</char> giezhi urusan ula shida <char style="png">Bofaqi</char>, <char style="png">Bodani</char>de kuzhekude <char style="pn">Ersa</char> ghua tujine peizhi <verse eid="LUK 19:29"/><verse number="30" style="v" sid="LUK 19:30"/>kieliewo, "Ta duimienni aghinde echi. Orose nie huiyasan ga enzheghei chanlane. Kieme unuzhi ese daozho. Ta andaghadene lai ire. <verse eid="LUK 19:30"/><verse number="31" style="v" sid="LUK 19:31"/>Kunla tande 'Yangiezhi andaghane?' giezhi asase 'Ezhan injine.' giezhi kielie."<verse eid="LUK 19:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 19:32"/>Peisan kunla echidene <char style="pn">Ersa</char> kieliesan mutun chanlawo. <verse eid="LUK 19:32"/><verse number="33" style="v" sid="LUK 19:33"/>Hhela andaghakude ezhanni chanladene asazho, "Ta ga enzheghei andaghazhi yangiene?"<verse eid="LUK 19:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 19:34"/>Hhela "Ezhan injine." giezhi kieliewo. <verse eid="LUK 19:34"/><verse number="35" style="v" sid="LUK 19:35"/>Hhela <char style="pn">Ersa</char>i shida lai ire goya jienlane ga enzheghe jiere daidene <char style="pn">Ersa</char>i unughawo.<verse eid="LUK 19:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 19:36"/>
    <char style="pn">Ersa</char> yokude kunla man jienlane mo jiere peiwo. <verse eid="LUK 19:36"/><verse number="37" style="v" sid="LUK 19:37"/>Zhen <char style="png">Ganlanshan</char>se boukude <char style="pn">Ersa</char> giesan fugie shiqinyi uzhesan kunla man bayasuzhi fugiede Hudade doulazho,<verse eid="LUK 19:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="LUK 19:38"/>"Ezhanyi niereghala iresan honshande doulandu!</para>
  <para style="q1" vid="LUK 19:38">Asiman jiere pinnan wo,</para>
  <para style="q2" vid="LUK 19:38">Zui Undudedu Hudai kuai!"<verse eid="LUK 19:38"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="39" style="v" sid="LUK 19:39"/>Giedun Falisai kunla <char style="pn">Ersa</char>de kieliewo, "Loushi, chi tujilane bu onghonogha." <verse eid="LUK 19:39"/><verse number="40" style="v" sid="LUK 19:40"/><char style="pn">Ersa</char> kieliewo, "Bi tande kielieye, enela amanne menjise tashila onghono qiine."<verse eid="LUK 19:40"/></para>
  <para style="s">Yelusalende Oluzhi Wilazho</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 19:41"/>
    <char style="pn">Ersa</char> <char style="png">Yelusalen</char>de kuzhi echikude hhe chenshide oluzhi wilazhi kieliewo, <verse eid="LUK 19:41"/><verse number="42" style="v" sid="LUK 19:42"/>"Bi sumulase enedu chi pinnan olukuni mejiese gou woma, ede chi mejie dane, mejiekui niuighazho. <verse eid="LUK 19:42"/><verse number="43" style="v" sid="LUK 19:43"/>Shihou kuzhese chii duitoula danghaghala luizhi zhouwise wiqidene chii witanlaghane. <verse eid="LUK 19:43"/><verse number="44" style="v" sid="LUK 19:44"/>Hhela irese chii, kesilachii man widaghane. Nie luisan tashiniliuzhe ulie jiene. Huda irezhi jiuiku shihouni ta uye renjiwo."<verse eid="LUK 19:44"/></para>
  <para style="s">Meimei Kunlani Mechise Touzho</para>
  <para style="r">(<ref loc="MAT 21:12-17">Mat 21:12-17</ref>; <ref loc="MRK 11:15-19">Mak 11:15-19</ref>; <ref loc="JHN 2:13-22">Yah 2:13-22</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45"/>
    <char style="pn">Ersa</char> mechide orodene meimei giesan kunlai man tou khighadene kieliewo,<verse eid="LUK 19:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="LUK 19:46"/>"Mii gie onxian gieku gie gholune</para>
  <para style="m" vid="LUK 19:46">giezhi jinwun jiere huaizho.</para>
  <para style="q1" vid="LUK 19:46">Ta ghughei ho gholughazho."<verse eid="LUK 19:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 19:47"/>
    <char style="pn">Ersa</char> niudunie mechide kunlade sughazho. Fugie buwa, jinwun hanjia, bexinlai lindaola hhei alane giezhi banfa xianjizhoma, <verse eid="LUK 19:47"/><verse number="48" style="v" sid="LUK 19:48"/>bexinla man hhei kieliei goude chenliese hhela yama gie dazho.<verse eid="LUK 19:48"/></para>
  <chapter eid="LUK 19"/>
  <chapter number="20" style="c" sid="LUK 20"/>
  <para style="s">Ersani Qienlini Asazho</para>
  <para style="r">(<ref loc="MAT 21:23-27">Mat 21:23-27</ref>; <ref loc="MRK 11:27-33">Mak 11:27-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1"/>Niudude <char style="pn">Ersa</char> mechide kunlade sughazhi Hudai gouxioxini jianjikude fugie buwa, jinwun hanjiala zhanlaolare hhantu ire <verse eid="LUK 20:1"/><verse number="2" style="v" sid="LUK 20:2"/><char style="pn">Ersa</char>de kieliewo, "Chi yan qienlighala ene shiqinlai giesei bijiende kielie. Chade ene qienlii ogisanshi kien wo?" <verse eid="LUK 20:2"/><verse number="3" style="v" sid="LUK 20:3"/><char style="pn">Ersa</char> kieliewo, "Biye tande nie unqi asaye. Ta made kielie, <verse eid="LUK 20:3"/><verse number="4" style="v" sid="LUK 20:4"/><char style="pn">Yaheiya</char>i xili gieghaku qienli asimanse onu, kunlase wo?" <verse eid="LUK 20:4"/><verse number="5" style="v" sid="LUK 20:5"/>Hhela goyalane shanlian giezhi kieliewo, "Matan 'Asimanse wo.' giese 'Ta yale hhei xianxin ulie giene.' giezhi hhe kieliene. <verse eid="LUK 20:5"/><verse number="6" style="v" sid="LUK 20:6"/>Kunlase wo giese bexinla man matai tashighala eghi alane, hhela <char style="pn">Yaheiya</char>shi xienzhi wo giezhi xianxin giezho." <verse eid="LUK 20:6"/><verse number="7" style="v" sid="LUK 20:7"/>Ingie khalase iresei ulie mejiene giezhi hhela kieliewo. <verse eid="LUK 20:7"/><verse number="8" style="v" sid="LUK 20:8"/><char style="pn">Ersa</char> hhelade kieliewo, "Biye tande yan qienlighala ene shiqinlai giesei ulie kieliene."<verse eid="LUK 20:8"/></para>
  <para style="s">Doghun Wiliechi</para>
  <para style="r">(<ref loc="MAT 21:33-46">Mat 21:33-46</ref>; <ref loc="MRK 12:1-12">Mak 12:1-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9"/>
    <char style="pn">Ersa</char> ene kielienyi bexinlade bilazhi kielie qiiwo. "Nie kun nie yenzi putou zeiladene kunlade bouizhi ogi, gholode echi oloncha souwo. <verse eid="LUK 20:9"/><verse number="10" style="v" sid="LUK 20:10"/>Shihou kuzhese nie hojine peizhi nexianne ghuraghale echiwo. Bouisan kunla hhei idun eghidene khosun khareighawo. <verse eid="LUK 20:10"/><verse number="11" style="v" sid="LUK 20:11"/>Da nie hojine pse ghuraghale echiwo. Eghizhi shizheghadene khosun echighawo. <verse eid="LUK 20:11"/><verse number="12" style="v" sid="LUK 20:12"/>Pse nie hojine echighawo. Eghizhi shan dailaghadene tungu khizheghawo. <verse eid="LUK 20:12"/><verse number="13" style="v" sid="LUK 20:13"/>Putou yenzii ezhan kieliezho, 'Bi matugiene? Bi oresan kewonne echighayema, hhela zunjineba.' <verse eid="LUK 20:13"/><verse number="14" style="v" sid="LUK 20:14"/>Bouisan kunla hhei chanladene nieniene shanlian giezhi kieliewo, 'Eneshi jiachanni jienliechen wo. Matan enei alayema, jiachanni manughun gholune!' <verse eid="LUK 20:14"/><verse number="15" style="v" sid="LUK 20:15"/>Ingie putou yenzise tungu khigha alawo. Ta sumulase putou yenzii ezhan ene kunlai matugiene? <verse eid="LUK 20:15"/><verse number="16" style="v" sid="LUK 20:16"/>Ezhan iredene bouisan kunlai man alazhi psedu kunlade bouizhi ogine." Chenliesan kunla kieliewo, "Imutu shiqin jiedui uwo!"<verse eid="LUK 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 20:17"/>
    <char style="pn">Ersa</char> hhelai uzhedene kieliewo, "Qingiese ene idon jinwunshi yan isi wo?</para>
  <para style="q1" vid="LUK 20:17">'Gie giesan kunla bendasan tashi</para>
  <para style="q2" vid="LUK 20:17">giei zhunyo tashi gholuwo.'<verse eid="LUK 20:17"/></para>
  <para style="m">
    <verse number="18" style="v" sid="LUK 20:18"/>Jien hhe tashi jiere anda bousan kunla zhazhazi gholune. Ene tashi kienyi jiere anda bouse zai miendaghane." <verse eid="LUK 20:18"/><verse number="19" style="v" sid="LUK 20:19"/>Jinwun hanjia, fugie buwala <char style="pn">Ersa</char> hhelai bilazhi kieliesei uzhe khizhedene deigo bareine giezhoma, bexinlase ayizho.<verse eid="LUK 20:19"/></para>
  <para style="s">Shui Jiuiku</para>
  <para style="r">(<ref loc="MAT 22:15-22">Mat 22:15-22</ref>; <ref loc="MRK 12:13-17">Mak 12:13-17</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 20:20"/>Hhela kunlai jizide jiazhon gieghazhi <char style="pn">Ersa</char>ni uzheghale echiwo. Hhe kielie codaghase shenzhande zhazhi bareighane giezho. <verse eid="LUK 20:20"/><verse number="21" style="v" sid="LUK 20:21"/>Jiazhon giesan kunla <char style="pn">Ersa</char>de asazho, "Loushi, chi kieliesan, jianjisan man oluzho. Enei bijien mejiezho. Chi kunni niekielien uzhezhi Hudai daolini shixinde sughazho. <verse eid="LUK 20:21"/><verse number="22" style="v" sid="LUK 20:22"/>Matan <char style="pn">Kaisa</char> honshande shui jiuise oluzhou ese oluzho?" <verse eid="LUK 20:22"/><verse number="23" style="v" sid="LUK 20:23"/><char style="pn">Ersa</char> piendasanyini mejiedene hhelade kieliewo, <verse eid="LUK 20:23"/><verse number="24" style="v" sid="LUK 20:24"/>"Made miengui nie uzhegha. Ene qiorun, haoshi kiennughun wo?" Hhela kieliewo, "<char style="pn">Kaisa</char>nughun wo." <verse eid="LUK 20:24"/><verse number="25" style="v" sid="LUK 20:25"/>"Qinse <char style="pn">Kaisa</char>nughunshi <char style="pn">Kaisa</char>de ogi, Hudanughunshi Hudade ogi." <verse eid="LUK 20:25"/><verse number="26" style="v" sid="LUK 20:26"/>Hhela kunlai melie <char style="pn">Ersa</char> kieliesande yama codasei erei dazho. <char style="pn">Ersa</char> huida giesande ghaniradene amanlane menjiwo.<verse eid="LUK 20:26"/></para>
  <para style="s">Aminne Oluku</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27"/>Fuho gieku shiqin uwo giesan niezhan Sadugai kunla <char style="pn">Ersa</char>i shida ire asawo, <verse eid="LUK 20:27"/><verse number="28" style="v" sid="LUK 20:28"/>"Loushi, <char style="pn">Musa</char> guijin jiere huaizho, nie kun bierei agidene kewosi wi duya ijiese jiuni zhoui gaidene houdei liuikuni wo giezho. <verse eid="LUK 20:28"/><verse number="29" style="v" sid="LUK 20:29"/>Ingiese gaijiu dololie laoda bierei agidene kewosi wi duya ijiewo. <verse eid="LUK 20:29"/><verse number="30" style="v" sid="LUK 20:30"/>Laoer, laosan man hhei zhouiwo. <verse eid="LUK 20:30"/><verse number="31" style="v" sid="LUK 20:31"/>Dololie man zhouidene kewosi wi duya ijiewo. <verse eid="LUK 20:31"/><verse number="32" style="v" sid="LUK 20:32"/>Zuihoude biereiye duya ijiewo. <verse eid="LUK 20:32"/><verse number="33" style="v" sid="LUK 20:33"/>Ingiese fuho giekude hheshi kienyi bierei wo? Gaijiu dololie man hhei agiwo."<verse eid="LUK 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 20:34"/>
    <char style="pn">Ersa</char> hhelade kieliewo, "Ene duyani kunla agizhi dafalane. <verse eid="LUK 20:34"/><verse number="35" style="v" sid="LUK 20:35"/>Duya ijiesan kun dundase aminne oluzhi houshide zige bichen kunla ulie agizhi ulie dafalane. <verse eid="LUK 20:35"/><verse number="36" style="v" sid="LUK 20:36"/>Hhela pse ulie duya ijiene, qienxien niekielien wo. Hhelashi fuho giechen wo, Hudai kesila wo. <verse eid="LUK 20:36"/><verse number="37" style="v" sid="LUK 20:37"/>Duya ijiesan kun aminne olukui <char style="pn">Musa</char>ye eghesun khan sideraku jinwun jiere zhenmin giezho. <char style="pn">Musa</char> Ezhanni urukude <char style="pn">Iburaheimu</char>ni Huda, <char style="pn">Isaghei</char>ni Huda, <char style="pn">Yagebu</char>ni Huda giezho. <verse eid="LUK 20:37"/><verse number="38" style="v" sid="LUK 20:38"/>Ingiese Hudashi duya ijiesan kunyi Huda pusho, amitu kunyi Huda wo. Huda uzhese kunla man amitu wo."<verse eid="LUK 20:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 20:39"/>Giedun jinwun hanjia kieliewo, "Loushi, chi kieliesan oluzho." <verse eid="LUK 20:39"/><verse number="40" style="v" sid="LUK 20:40"/>Hhela ayizhi pse hhende yama asa dazho.<verse eid="LUK 20:40"/></para>
  <para style="s">Mexihashi Dawudeni Houdei Onu</para>
  <para style="r">(<ref loc="MAT 22:41-46">Mat 22:41-46</ref>; <ref loc="MRK 12:35-37">Mak 12:35-37</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41"/>
    <char style="pn">Ersa</char> hhelade kieliewo, "Kunla matugie Mexihashi <char style="pn">Dawude</char>ni houdei wo giezho? <verse eid="LUK 20:41"/><verse number="42-43" style="v" sid="LUK 20:42-43"/><char style="pn">Dawude</char> goyane <char style="bk">Zeburei</char> jiere kieliezho,</para>
  <para style="q1" vid="LUK 20:42-43">'Ezhan mii Ezhande kieliewo,</para>
  <para style="q2" vid="LUK 20:42-43">"Bi duitoulaichii kon dourachii teitula</para>
  <para style="q3" vid="LUK 20:42-43">chi mini borun miende sou."'<verse eid="LUK 20:42-43"/></para>
  <para style="m">
    <verse number="44" style="v" sid="LUK 20:44"/>Qingiese <char style="pn">Dawude</char> Mexihai Ezhan giezhi uruse Mexiha matugie <char style="pn">Dawude</char>ni houdei wo?"<verse eid="LUK 20:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45"/>Bexinla chenliekude <char style="pn">Ersa</char> tujiladene kieliewo, <verse eid="LUK 20:45"/><verse number="46" style="v" sid="LUK 20:46"/>"Ta jinwun hanjialai fangula. Hhela fudu jienni musidene geidoude toreizhi kunla hhelade kielien asakude xiqi wo. Huitanni undu wizi, xini shanxide soukude xiqi wo. <verse eid="LUK 20:46"/><verse number="47" style="v" sid="LUK 20:47"/>Hhela guafui gieni chigheine. Jiazhon giezhi oloncha onxian giene. Enezighan kunlai pse gundude faine."<verse eid="LUK 20:47"/></para>
  <chapter eid="LUK 20"/>
  <chapter number="21" style="c" sid="LUK 21"/>
  <para style="s">Guafu Baer Teiku</para>
  <para style="r">(<ref loc="MRK 12:41-44">Mak 12:41-44</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1"/>
    <char style="pn">Ersa</char> qiorunne qila bayan kunla mechii baer teiku xianzide baer teikuni uzhezho. <verse eid="LUK 21:1"/><verse number="2" style="v" sid="LUK 21:2"/>Pse nie nanxin guafu hhende ghua fenfenzi baer teisei uzhewo. <verse eid="LUK 21:2"/><verse number="3" style="v" sid="LUK 21:3"/><char style="pn">Ersa</char> kieliewo, "Bi tande shuhua kielieye, ene nanxin guafu soyuji kunlase olon teiwo. <verse eid="LUK 21:3"/><verse number="4" style="v" sid="LUK 21:4"/>Kunla olonsene teiwo. Guafude yama uwoma, udu daoku baerlane man teiwo."<verse eid="LUK 21:4"/></para>
  <para style="s">Mechini Cheikuni Melie Kieliezho</para>
  <para style="r">(<ref loc="MAT 24:1-2">Mat 24:1-2</ref>; <ref loc="MRK 13:1-2">Mak 13:1-2</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5"/>Niezhan kunla mechini seighan tashi, Hudade ogisan mureghala zhonhon giesei kielienduzho. Ingiese <char style="pn">Ersa</char> kieliewo. <verse eid="LUK 21:5"/><verse number="6" style="v" sid="LUK 21:6"/>"Ta chanlasan enelai hhe shihou kuzhese cheizhi tashi jiere tashi nieda ulie jiene."<verse eid="LUK 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 21:7"/>Hhela <char style="pn">Ersa</char>de asazho, "Loushi, yan xienzide ene shiqinla fashen giene? Enela fashen giekude yan zunji wine?" <verse eid="LUK 21:7"/><verse number="8" style="v" sid="LUK 21:8"/>Hhe kieliezho, "Ta xioxin giezhi kunlai bu piendagha. Olon kunla mii niereghala iredene bishi hhe enbene, ede shihou kuzhewo giese ta bu dagha. <verse eid="LUK 21:8"/><verse number="9" style="v" sid="LUK 21:9"/>Ta eghinduzhi londasan xioxini sonosuse bu ayi. Ene shiqin xien fashen gienema, duya baraku deigo ulie kuzhene." <verse eid="LUK 21:9"/><verse number="10" style="v" sid="LUK 21:10"/>Pse hhelade kieliewo, "Minzu minzula eghindune, gojia gojiala eghindune. <verse eid="LUK 21:10"/><verse number="11" style="v" sid="LUK 21:11"/>Zemin fugiede gojiolune, gochude oliesuku inzhanku gien wine, asiman jierese fugie ghudureqi irezhi ayighane."<verse eid="LUK 21:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 21:12"/>"Ene shiqin iretula kunla tai heizhi bareidene huitan, bafanzide jiuine. Mii yenyinghala tai honshan, shenzhanlai melie lai echine. <verse eid="LUK 21:12"/><verse number="13" style="v" sid="LUK 21:13"/>Hheshi made ganzhen beiku jihui wo. <verse eid="LUK 21:13"/><verse number="14" style="v" sid="LUK 21:14"/>Panjichen kunde matugie huida giekui melieshi zhunbei bu gie. <verse eid="LUK 21:14"/><verse number="15" style="v" sid="LUK 21:15"/>Bi tande duitoulatai tai kieliezhi dao daku kielien, agheli ogine. <verse eid="LUK 21:15"/><verse number="16" style="v" sid="LUK 21:16"/>Lien ada, ana, gaijiu, qingu, zhanlienlaye tai ghudanduzhi niezhanlani alane. <verse eid="LUK 21:16"/><verse number="17" style="v" sid="LUK 21:17"/>Mii yenyinghala kunla man tai henjine. <verse eid="LUK 21:17"/><verse number="18" style="v" sid="LUK 21:18"/>Ingieliuzhe tai niekozi usunye ulie widane. <verse eid="LUK 21:18"/><verse number="19" style="v" sid="LUK 21:19"/>Ta izhigie rennai giese goyane jiuine."<verse eid="LUK 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20"/>"Budui iredene <char style="png">Yelusalen</char>yi wiqikui ta chanlase hhe widaghaku udu ghujinlasei mejiene. <verse eid="LUK 21:20"/><verse number="21" style="v" sid="LUK 21:21"/>Ingiekude <char style="png">Yudaya</char>de sousan kunla, ulade piile echi. Chenshini kunla ghadane khirei. Xianni kunla chenshide bu oro. <verse eid="LUK 21:21"/><verse number="22" style="v" sid="LUK 21:22"/>Enezighan udushi faiku udu wo. Jinwun jiere huaisan kielienyi gholughane. <verse eid="LUK 21:22"/><verse number="23" style="v" sid="LUK 21:23"/>Hhe udude kewosi laisan, gogoghasanlade gou widawo! Zemin jiere zeinan wo, Hudai hokuku ene bexinlai jiere irezho. <verse eid="LUK 21:23"/><verse number="24" style="v" sid="LUK 21:24"/>Hhela khudogho doura fugune, pse bareidene go gojiade lai echine. Niman kunni udu kurutula niman kun iredene <char style="png">Yelusalen</char>ni tai pindaghane."<verse eid="LUK 21:24"/></para>
  <para style="s">Kunnikewon Ireku</para>
  <para style="r">(<ref loc="MAT 24:29-31">Mat 24:29-31</ref>; <ref loc="MRK 13:24-27">Mak 13:24-27</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25"/>"Hhe shihou kuzhese naran, sara, hodunla bienjizhi zunji uzheghane. Haide lan jiulizhi onghonose zemin jieredu gojiala man jindazhi matugiekui mejie dazho. <verse eid="LUK 21:25"/><verse number="26" style="v" sid="LUK 21:26"/>Asimanyi lilianla gojioluse duya matui gholune gie kunla ayidene injirene. <verse eid="LUK 21:26"/><verse number="27" style="v" sid="LUK 21:27"/>Ingiekude Kunnikewon nenli, famanude olien jierese irekui kunla chanlane. <verse eid="LUK 21:27"/><verse number="28" style="v" sid="LUK 21:28"/>Ene shiqin kaishi giese bosizhedene qiorunne qila. Tai shuiku udu chadashiwo."<verse eid="LUK 21:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29"/>
    <char style="pn">Ersa</char> hhelade bilazhi kieliewo, "Ta uhuago mutun, psedu mutunlai uzhe. <verse eid="LUK 21:29"/><verse number="30" style="v" sid="LUK 21:30"/>Mutun lachen keikui ta uzhese khaluncha orokui mejiene. <verse eid="LUK 21:30"/><verse number="31" style="v" sid="LUK 21:31"/>Taye niekielien wo. Ta ene shiqinla fashen giesei chanlase Hudai gojia chadashisei mejiene. <verse eid="LUK 21:31"/><verse number="32" style="v" sid="LUK 21:32"/>Bi tande shuhua kielieye, ene idaini kunla fugutula ene shiqinla man gholune. <verse eid="LUK 21:32"/><verse number="33" style="v" sid="LUK 21:33"/>Asiman zemin widaliuzhe mii kielien kenjin ulie widane."<verse eid="LUK 21:33"/></para>
  <para style="s">Chan Jinxin Giendu</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34"/>"Ta jinxin giendu. Pse ta hunnerei daghazhi ochizhi ijiekude, duyani shiqinghala munan giezhi zhugheitai kunzhi giekude hhe udu irene. Hhe shihou irese onghala zhaghasun bareiku niekielien wo, mejie dakude irene. <verse eid="LUK 21:34"/><verse number="35" style="v" sid="LUK 21:35"/>Hhe udu irekude zemin jiereshiku kunlade man irene. <verse eid="LUK 21:35"/><verse number="36" style="v" sid="LUK 21:36"/>Ta chan onxian giezhi jinxin giendu. Qingiese ene shiqin irekude holuzhi andadene Kunnikewonni melie bei shidane."<verse eid="LUK 21:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 21:37"/>
    <char style="pn">Ersa</char> niudunie mechide kunlade surughazho. Niexiinie <char style="png">Ganlanshan</char>de echizhi souzho. <verse eid="LUK 21:37"/><verse number="38" style="v" sid="LUK 21:38"/>Bexinla man eqiemagha eqie mechide <char style="pn">Ersa</char> jianjisei chenliele irezho.<verse eid="LUK 21:38"/></para>
  <chapter eid="LUK 21"/>
  <chapter number="22" style="c" sid="LUK 22"/>
  <para style="s">Ersai Alane Giezhi Shanlian Giezho</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mat 26:1-5</ref>, <ref loc="MAT 26:14-16">14-16</ref>; <ref loc="MRK 14:1-2">Mak 14:1-2</ref>, <ref loc="MRK 14:10-11">10-11</ref>; <ref loc="JHN 11:45-53">Yah 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1"/>Jiulidaosan Jie giezhi urusan Tanmien Jie kuzhewo. <verse eid="LUK 22:1"/><verse number="2" style="v" sid="LUK 22:2"/>Fugie buwa, jinwun hanjiala bexinlase ayise yan banfaghala <char style="pn">Ersa</char>i alase gou wo giezhi sumulazho.<verse eid="LUK 22:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 22:3"/>Ingiekude <char style="png">Jialie</char> kun <char style="pn">Yuda</char>ni sudoro Ibilisi orowo. Hheshi 12 gie tuji dundadu nie wo. <verse eid="LUK 22:3"/><verse number="4" style="v" sid="LUK 22:4"/><char style="pn">Yuda</char> fugie buwa, mechi sagheisan kunlare <char style="pn">Ersa</char>i matugie ghudandukui shanlian giele echiwo. <verse eid="LUK 22:4"/><verse number="5" style="v" sid="LUK 22:5"/>Hhela bayasuzhi <char style="pn">Yuda</char>de baer ogikui dain giewo. <verse eid="LUK 22:5"/><verse number="6" style="v" sid="LUK 22:6"/><char style="pn">Yuda</char> tunyi oludene bexinla wikude <char style="pn">Ersa</char>i ghudanduku jihui ereizho.<verse eid="LUK 22:6"/></para>
  <para style="s">Jiulidaosan Jie Zhunbei Giezho</para>
  <para style="r">(<ref loc="MAT 26:17-25">Mat 26:17-25</ref>; <ref loc="MRK 14:12-21">Mak 14:12-21</ref>; <ref loc="JHN 13:21-30">Yah 13:21-30</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7"/>Tanmien Jie kuzhezhi Jiulidaosan Jieni ghoni zharuku udude <verse eid="LUK 22:7"/><verse number="8" style="v" sid="LUK 22:8"/><char style="pn">Ersa</char> <char style="pn">Beduru</char> <char style="pn">Yaheiya</char> ghualani peizhi kieliewo, "Ta matande Jiulidaosan Jieni ijiuni zhunbei giele echi. Matan ijienduye." <verse eid="LUK 22:8"/><verse number="9" style="v" sid="LUK 22:9"/>Hhela asawo, "Bijien khala zhunbei giene?" <verse eid="LUK 22:9"/><verse number="10" style="v" sid="LUK 22:10"/><char style="pn">Ersa</char> kieliewo, "Ta chenshide orokude nie tunzi usu qilasan kunyi penjine. Ta hhei daghazhi hhe orosan gie doura orodene <verse eid="LUK 22:10"/><verse number="11" style="v" sid="LUK 22:11"/>giei zhanguijide kielie, 'Loushi chade asazho, "Bi tujilarene Jiulidaosan Jieni daoghaku gie khala wo?"' <verse eid="LUK 22:11"/><verse number="12" style="v" sid="LUK 22:12"/>Hhe tande lou jiere man qiendaghasan nie fugie gieni uzheghane. Ta hhende zhunbei gie." <verse eid="LUK 22:12"/><verse number="13" style="v" sid="LUK 22:13"/>Hhela echidene chanlasan <char style="pn">Ersa</char> kieliesanghala niekielien wo. Ingie hhela hhende Jiulidaosan Jieni zhunbei giewo.<verse eid="LUK 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 22:14"/>Shihou kuzhese <char style="pn">Ersa</char> shitularene hhantu xi souwo. <verse eid="LUK 22:14"/><verse number="15" style="v" sid="LUK 22:15"/><char style="pn">Ersa</char> hhelade kieliewo, "Bi shouku gieku melie tanre hhantu Jiulidaosan Jieni ijieku hende duran wine. <verse eid="LUK 22:15"/><verse number="16" style="v" sid="LUK 22:16"/>Bi tande kielieye. Jiulidaosan Jie Hudai gojiade chengun olutula bi pse hhei ulie ijiene." <verse eid="LUK 22:16"/><verse number="17" style="v" sid="LUK 22:17"/><char style="pn">Ersa</char> beizii agi daore Hudade mafan kieliedene hhelade kieliewo, "Ta enei man ghughazhi ochindu. <verse eid="LUK 22:17"/><verse number="18" style="v" sid="LUK 22:18"/>Bi tande kielieye, enedu khuinase bi pse putoujiuni ulie ochizhi Hudai gojia ireku shihou kune." <verse eid="LUK 22:18"/><verse number="19" style="v" sid="LUK 22:19"/>Ingie ginanyi barei mafan kieliedene ghulu hhelade ogi kieliewo, "Eneshi tande oluzhi ogisan mii beye wo. Ta mii jilazhi enei gie." <verse eid="LUK 22:19"/><verse number="20" style="v" sid="LUK 22:20"/>Ijie baludene qingiezhi beizii barei kieliewo, "Ene beizishi mii chusunghala shini yenjisan kielien wo. Tande oluzhi usurusan wo. <verse eid="LUK 22:20"/><verse number="21" style="v" sid="LUK 22:21"/>Ingieliuzhe, uzhe, mini ghudandune giesan kun mii shida souzhi mare hhantu ijiezho. <verse eid="LUK 22:21"/><verse number="22" style="v" sid="LUK 22:22"/>Huda jiejin giesan mutun Kunnikewon duya ijienema, hhei ghudandusan kunde gou widawo!" <verse eid="LUK 22:22"/><verse number="23" style="v" sid="LUK 22:23"/>Hhela nieniedene asazho, "Imutu shiqini kien giene?"<verse eid="LUK 22:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24"/>Hhelai dunda kien zui fugie wo giezhiye nienieji zhenjinduzho. <verse eid="LUK 22:24"/><verse number="25" style="v" sid="LUK 22:25"/><char style="pn">Ersa</char> hhelade kieliewo, "Niman kunlai dunda honshan noyenla qienli bareizhi kunlai gonjiliuzhe hhelai gouni ogisan kun giezhi uruzho. <verse eid="LUK 22:25"/><verse number="26" style="v" sid="LUK 22:26"/>Ta niekielien pusho, tai dunda zui fugieni zui meilashi, lindao danlane giesan kun ushilachen kun mutun gie. <verse eid="LUK 22:26"/><verse number="27" style="v" sid="LUK 22:27"/>Kien fugie wo? Xi sousan kun fugie onu ushilachen kun fugie wo? Xi sousan kun fugie woba. Ingieliuzhe bishi tai dunda ushilachen kun wo. <verse eid="LUK 22:27"/><verse number="28" style="v" sid="LUK 22:28"/>Kunla mini fandui giezhi alane giese ta izhi mare hhantu wo. <verse eid="LUK 22:28"/><verse number="29" style="v" sid="LUK 22:29"/>Huda made gonjiku qienlini ogiku mutun bi ye tande qienlini ogiye. <verse eid="LUK 22:29"/><verse number="30" style="v" sid="LUK 22:30"/>Ta marezhe hhantu mini gojiade ijiezhi ochine. Ta baozo jiere souzhi <char style="png">Isilie</char>ni 12 gie paini gonjine."<verse eid="LUK 22:30"/></para>
  <para style="s">Beduru Ulie Tanikuni Melie Kieliezho</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mat 26:31-35</ref>; <ref loc="MRK 14:27-31">Mak 14:27-31</ref>; <ref loc="JHN 13:36-38">Yah 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31"/>"<char style="pn">Ximun</char>, <char style="pn">Ximun</char>! Ibilisi tai boudei shierlaku mutun shierlane giezhi Hudade xiahua giewo. <verse eid="LUK 22:31"/><verse number="32" style="v" sid="LUK 22:32"/>Ingiese bi chade oluzhi chii xianxin gieku bu fura giezhi onxian giewo. Chi geizhen giedene gaijiulane khiduzhegha." <verse eid="LUK 22:32"/><verse number="33" style="v" sid="LUK 22:33"/><char style="pn">Beduru</char> kieliewo, "Ezhan, bi chimare hhantu bafanzide orozhi fuguseye zhunbei gie goudazho!" <verse eid="LUK 22:33"/><verse number="34" style="v" sid="LUK 22:34"/><char style="pn">Ersa</char> kieliewo, "<char style="pn">Beduru</char>, bi chade kielieye, enedu tigha kheilatula chi mii 3 hui ulie renjine."<verse eid="LUK 22:34"/></para>
  <para style="s">Baer Qibao Khudogho Barei</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 22:35"/>Ingie pse kieliewo, "Bi tai echighakude baer, qibao, maheiye uwo. Tande yama chaizhoye?"</para>
  <para style="p" vid="LUK 22:35">Hhela kieliewo, "Uye."<verse eid="LUK 22:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 22:36"/>
    <char style="pn">Ersa</char> kieliewo, "Ede baer, qibao bichenla barei, khudogho wise jienne huizhi agi. <verse eid="LUK 22:36"/><verse number="37" style="v" sid="LUK 22:37"/>Bi tande kielieye hhei zuirende sanawo giezhi jinwun jiere mii zhiizhi kieliesanla kenjin gholune. Enbene, mii zhiizhi kieliesan ene zhen gholuzho." <verse eid="LUK 22:37"/><verse number="38" style="v" sid="LUK 22:38"/>Hhela kieliewo, "Ezhan, enende ghua khudogho wo."</para>
  <para style="p" vid="LUK 22:38">Ersa kieliewo, "Kuruwo."<verse eid="LUK 22:38"/></para>
  <para style="s">Ganlanshande Onxian Gieku</para>
  <para style="r">(<ref loc="MAT 26:36-46">Mat 26:36-46</ref>; <ref loc="MRK 14:32-42">Mak 14:32-42</ref>)</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39"/>
    <char style="pn">Ersa</char> eqighanku mutun <char style="png">Ganlanshan</char>de echise tujilaniye daghazho. <verse eid="LUK 22:39"/><verse number="40" style="v" sid="LUK 22:40"/>Hhe oronde kurudene hhelade kieliewo, "Ta onxian gie, pse miine." <verse eid="LUK 22:40"/><verse number="41" style="v" sid="LUK 22:41"/>Ingiedene nie tashi bendasan qimutu gholo echidene xiutuliezhi onxian giezho, <verse eid="LUK 22:41"/><verse number="42" style="v" sid="LUK 22:42"/>"Ada, chi duran bise ene shouku giekui made bu iregha! Ingieliuzhe mii duranghala bu gie, chii duranghala gie." <verse eid="LUK 22:42"/><verse number="43" style="v" sid="LUK 22:43"/>Ingiekude nie qienxien asiman jierese iredene hhende nenli ogiwo. <verse eid="LUK 22:43"/><verse number="44" style="v" sid="LUK 22:44"/><char style="pn">Ersa</char>i zhughe otuzhi pse hende onxian giezho. Koniesun chusun mutun zemin jiere luizho. <verse eid="LUK 22:44"/><verse number="45" style="v" sid="LUK 22:45"/>Onxian gie balu bosizhedene tujilai hhende echiwo. Hhela hende munan giedene hhunturazho. <verse eid="LUK 22:45"/><verse number="46" style="v" sid="LUK 22:46"/><char style="pn">Ersa</char> hhelade kieliewo, "Ta yangiezhi hhunturazho? Bosizhedene onxian gie, pse miine."<verse eid="LUK 22:46"/></para>
  <para style="s">Ersani Bareizho</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mat 26:47-56</ref>; <ref loc="MRK 14:43-50">Mak 14:43-50</ref>; <ref loc="JHN 18:3-11">Yah 18:3-11</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47"/>Zhen kieliekude 12 gie tuji dundadu <char style="pn">Yuda</char> giesan nie kun iban kunni uduru irewo. <char style="pn">Ersa</char>i shida irezhi orene giezho. <verse eid="LUK 22:47"/><verse number="48" style="v" sid="LUK 22:48"/><char style="pn">Ersa</char> hhende kieliewo, "<char style="pn">Yuda</char>, chi Kunnikewonni orekughala ghudandunu?" <verse eid="LUK 22:48"/><verse number="49" style="v" sid="LUK 22:49"/>Zhouwini tujila ene shiqinyi uzhedene kieliewo, "Ezhan, bijien khudoghoghala chizhise olunulie?" <verse eid="LUK 22:49"/><verse number="50" style="v" sid="LUK 22:50"/>Hhelai dundase nie kun zui fugie buwai hojii borun chighinyi chizhi agiwo. <verse eid="LUK 22:50"/><verse number="51" style="v" sid="LUK 22:51"/><char style="pn">Ersa</char> kieliewo, "Bu eghi!" Ingie hhe kunni chighinyi moi goudaghawo. <verse eid="LUK 22:51"/><verse number="52" style="v" sid="LUK 22:52"/>Ingie hhei bareile iresan fugie buwa, mechii sagheisan kun, zhanlaolade kieliewo, "Ta khudogho, banbanlai bareidene mii qiandao mutun bareile irewu? <verse eid="LUK 22:52"/><verse number="53" style="v" sid="LUK 22:53"/>Niudunie bi mechide tanre hhantu wo, ulie bareine. Ede tai shihou wo, kharani qienlii bareizho."<verse eid="LUK 22:53"/></para>
  <para style="s">Beduru Ersai Ese Renjizho</para>
  <para style="r">(<ref loc="MAT 26:57-58">Mat 26:57-58</ref>, <ref loc="MAT 26:69-75">69-75</ref>; <ref loc="MRK 14:53-54">Mak 14:53-54</ref>, <ref loc="MRK 14:66-72">66-72</ref>; <ref loc="JHN 18:12-18">Yah 18:12-18</ref>, <ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54"/>Hhela <char style="pn">Ersa</char>i bareidene zui fugie buwai giede lai echiwo. <char style="pn">Beduru</char> gholose daghazho. <verse eid="LUK 22:54"/><verse number="55" style="v" sid="LUK 22:55"/>Kunla ghoronde khan teidene izhonde hhantu souse <char style="pn">Beduru</char>ye hhantu wo. <verse eid="LUK 22:55"/><verse number="56" style="v" sid="LUK 22:56"/>Nie hoji oqin khanni gonse <char style="pn">Beduru</char>ni xianxide uzhe tanidene kieliewo, "Ene kunye <char style="pn">Ersa</char>re hhantuku wo." <verse eid="LUK 22:56"/><verse number="57" style="v" sid="LUK 22:57"/><char style="pn">Beduru</char> ese renjizhi kieliewo, "Funi, bi hheni tani dane." <verse eid="LUK 22:57"/><verse number="58" style="v" sid="LUK 22:58"/>Goujicha beidene nie kun <char style="pn">Beduru</char>i chanla kieliewo, "Chishiye hhelare hhantuku kun wo." <char style="pn">Beduru</char> kieliewo, "Gujiu, bi pusho." <verse eid="LUK 22:58"/><verse number="59" style="v" sid="LUK 22:59"/>Chabudu nie xioshi daodene pse nie kun kieliewo, "Ene kenjinshi hhelare hhantuku kun enbene. Hhe yeshi <char style="png">Jialili</char> kun wo." <verse eid="LUK 22:59"/><verse number="60" style="v" sid="LUK 22:60"/><char style="pn">Beduru</char> kieliewo, "Gujiu, chi yan kieliekui bi ulie mejiene!" Zhen kieliekude tigha kheilawo. <verse eid="LUK 22:60"/><verse number="61" style="v" sid="LUK 22:61"/>Ingie Ezhan ochira <char style="pn">Beduru</char>ni uzhewo. <char style="pn">Beduru</char> Ezhan kieliesan enedu tigha kheilatula chi mii 3 hui ulie renjine giesei sumula ire <verse eid="LUK 22:61"/><verse number="62" style="v" sid="LUK 22:62"/>khizhi echidene nango giezhi hende wilawo.<verse eid="LUK 22:62"/></para>
  <para style="s">Ersani Xilun Giezho</para>
  <para style="r">(<ref loc="MAT 26:67-68">Mat 26:67-68</ref>; <ref loc="MRK 14:65">Mak 14:65</ref>)</para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63"/>
    <char style="pn">Ersa</char>i uzhesan kunla xilun giezhi eghizho. <verse eid="LUK 22:63"/><verse number="64" style="v" sid="LUK 22:64"/>Nudunyini huighadene asazho, "Chii kien eghisei kielie?" <verse eid="LUK 22:64"/><verse number="65" style="v" sid="LUK 22:65"/>Hhela pse olon zannan kielienghala hhei sugiezhi shizheghazho.<verse eid="LUK 22:65"/></para>
  <para style="s">Ersani Zui Fugie Fayende Echighazho</para>
  <para style="r">(<ref loc="MAT 26:59-66">Mat 26:59-66</ref>; <ref loc="MRK 14:55-64">Mak 14:55-64</ref>; <ref loc="JHN 18:19-24">Yah 18:19-24</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66"/>Ogheise bexinlani zhanlao, fugie buwa, jinwun hanjiala man hhantulazho. Hhela <char style="pn">Ersa</char>i laidene zui fugie fayende echi <verse eid="LUK 22:66"/><verse number="67" style="v" sid="LUK 22:67"/>kieliewo, "Chishi Mexiha enbese bijiende kielie." <char style="pn">Ersa</char> kieliewo, "Bi tande kieliese taye xianxin ulie giene. <verse eid="LUK 22:67"/><verse number="68" style="v" sid="LUK 22:68"/>Bi tande asase taye ulie kieliene. <verse eid="LUK 22:68"/><verse number="69" style="v" sid="LUK 22:69"/>Enedu khuinashi Kunnikewon Nenlitu Hudai borun miende soune." <verse eid="LUK 22:69"/><verse number="70" style="v" sid="LUK 22:70"/>Ingiese hhela man kieliewo, "Qinse chishi Hudai kewon enbenu?" <char style="pn">Ersa</char> hhelade kieliewo, "Bi enbene giezhi ta kieliezho." <verse eid="LUK 22:70"/><verse number="71" style="v" sid="LUK 22:71"/>Ingie hhela kieliewo, "Pse yan ganzhen kerene? Hhe goyane kieliesei matan qinsi chenliewo!"<verse eid="LUK 22:71"/></para>
  <chapter eid="LUK 22"/>
  <chapter number="23" style="c" sid="LUK 23"/>
  <para style="s">Ersani Biladode Jiuizho</para>
  <para style="r">(<ref loc="MAT 27:1-2">Mat 27:1-2</ref>, <ref loc="MAT 27:11-14">11-14</ref>; <ref loc="MRK 15:1-5">Mak 15:1-5</ref>; <ref loc="JHN 18:28-38">Yah 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1"/>Kunla man hhantu <char style="pn">Ersa</char>i <char style="pn">Bilado</char>i melie echighawo. <verse eid="LUK 23:1"/><verse number="2" style="v" sid="LUK 23:2"/>Hhela <char style="pn">Ersa</char>i zhazhi qiiwo, "Ene kun bexinlani shanjizhi <char style="png">Loma</char>ni honshan <char style="pn">Kaisa</char>de shui bu jiui giezho. Pse goyane Mexihai wo, honshan wo giezho." <verse eid="LUK 23:2"/><verse number="3" style="v" sid="LUK 23:3"/><char style="pn">Bilado</char> <char style="pn">Ersa</char>de asawo, "Chishi <char style="png">Yutai</char> kunni honshan onu?" <char style="pn">Ersa</char> kieliewo, "Chi kieliezho." <verse eid="LUK 23:3"/><verse number="4" style="v" sid="LUK 23:4"/><char style="pn">Bilado</char> fugie buwa, kunlade kieliewo, "Bi ene kunse yama zui chaizhi khizhe dawo." <verse eid="LUK 23:4"/><verse number="5" style="v" sid="LUK 23:5"/>Ingieliuzhe hhela pse zhazhi hendawo, "Ene kun bexinlade sughazhi shanjizhi <char style="png">Yudaya</char>ni gochude echizho. <char style="png">Jialili</char>se enende irewo." <verse eid="LUK 23:5"/><verse number="6" style="v" sid="LUK 23:6"/><char style="pn">Bilado</char> chenliedene asawo, "Eneshi <char style="png">Jialili</char> kun onu?" <verse eid="LUK 23:6"/><verse number="7" style="v" sid="LUK 23:7"/><char style="png">Jialili</char>ni <char style="pn">Hherode</char> gonjisei <char style="pn">Bilado</char> mejiedene <char style="pn">Ersa</char>i <char style="pn">Hherode</char>i hhende khughoghawo. Hhe shihoude <char style="pn">Hherode</char> zhen <char style="png">Yelusalen</char>de wo.<verse eid="LUK 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 23:8"/>
    <char style="pn">Hherode</char> <char style="pn">Ersa</char>i chanladene hende bayasuzho. Hhe giesan shiqinni chighindei irese melieshise nie ochirane giezho. Ghudureqi xienjighase uzhene giezho. <verse eid="LUK 23:8"/><verse number="9" style="v" sid="LUK 23:9"/>Ingie <char style="pn">Hherode</char> <char style="pn">Ersa</char>de olon asawoma <char style="pn">Ersa</char> yama ese kieliewo. <verse eid="LUK 23:9"/><verse number="10" style="v" sid="LUK 23:10"/>Fugie buwa, jinwun hanjiala beidene hende zhazho. <verse eid="LUK 23:10"/><verse number="11" style="v" sid="LUK 23:11"/><char style="pn">Hherode</char> buduighalane <char style="pn">Ersa</char>i uzhezhi xiniezhi xilun giedene seighan fudu jienyi musigha, <char style="pn">Bilado</char>i hhende echighawo. <verse eid="LUK 23:11"/><verse number="12" style="v" sid="LUK 23:12"/>Melieshida <char style="pn">Hherode</char> <char style="pn">Bilado</char>ghala duitou wo. Hhe niudude zhanlien gholuwo.<verse eid="LUK 23:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13"/>
    <char style="pn">Bilado</char> fugie buwa, lindao, bexinlani uruzhi hhantulaghadene <verse eid="LUK 23:13"/><verse number="14" style="v" sid="LUK 23:14"/>hhelade kieliewo, "Ta ene kunyi mii enende ireghase ene kun bexinlai shanjizho giezho. Uzhe, bi tai melie ene kunyi xianxide shenwun giewoma, ene kunde ta zhasan qimutu zui uwo. <verse eid="LUK 23:14"/><verse number="15" style="v" sid="LUK 23:15"/><char style="pn">Hherode</char>ye yama zuini ereizhi olu dadene enende kharei ireghawo. Ene kunde fugughaku zui uwo. <verse eid="LUK 23:15"/><verse number="16" style="v" sid="LUK 23:16"/>Enei ingieye, nie faidene andaghaye." <verse eid="LUK 23:16"/><verse number="18" style="v" sid="LUK 23:18"/>Kunla man waradazhi kieliewo, "Ene kunni ala! <char style="pn">Balaba</char>i andagha!" <verse eid="LUK 23:18"/><verse number="19" style="v" sid="LUK 23:19"/><char style="pn">Balaba</char>shi hhe chenshide panlon giezhi kun aladene bafanzide khasan wo. <verse eid="LUK 23:19"/><verse number="20" style="v" sid="LUK 23:20"/><char style="pn">Bilado</char> <char style="pn">Ersa</char>i andaghaku duran wine, hhelade qingiezhi kieliezho. <verse eid="LUK 23:20"/><verse number="21" style="v" sid="LUK 23:21"/>Ingiese kunla, <char style="pn">"Ersa</char>i shizijia jiere ghada! Shizijia jiere ghada!" giezhi waradazhi ulie olune.<verse eid="LUK 23:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 23:22"/>
    <char style="pn">Bilado</char> 3 hui hhelade kieliewo, "Yangiezhi? Ene kun yan doghun shiqin giezho? Bi ene kunde yama fuguku zui jinji dane. Nie faidene andaghaye." <verse eid="LUK 23:22"/><verse number="23" style="v" sid="LUK 23:23"/>Kunla fugiede waradazhi izhigie kieliezho, "Shizijia jiere ghada!" Hhelai shenqi injiwo. <verse eid="LUK 23:23"/><verse number="24" style="v" sid="LUK 23:24"/>Ingie <char style="pn">Bilado</char> hhela kieliesan mutun panjiwo. <verse eid="LUK 23:24"/><verse number="25" style="v" sid="LUK 23:25"/>Kunla keresan mutun panlon giezhi lon kun alasan hhe kunyi bafanzise khizheghawo. Ingiedene <char style="pn">Ersa</char>i hhelai durande teiwo.<verse eid="LUK 23:25"/></para>
  <para style="s">Ersani Ghadazho</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26"/>
    <char style="pn">Ersa</char>i lai echikude nie xianse iresan <char style="png">Gulinai</char> kun <char style="pn">Ximun</char> wo. Shizijiani hhende beilieghadene <char style="pn">Ersa</char>i daghaghazho. <verse eid="LUK 23:26"/><verse number="27" style="v" sid="LUK 23:27"/>Olon kun <char style="pn">Ersa</char>i daghazho. Hhelai dunda niezhan biereila <char style="pn">Ersa</char>de zhughe otuzhi wilazho. <verse eid="LUK 23:27"/><verse number="28" style="v" sid="LUK 23:28"/><char style="pn">Ersa</char> ochiradene hhelade kieliewo, "<char style="png">Yelusalen</char>ni funila, ta made oluzhi bu wila, goyadene, kesiladene oluzhi wila. <verse eid="LUK 23:28"/><verse number="29" style="v" sid="LUK 23:29"/>Hhe shihou ijin irene, irese kunla kieliene, 'Kewosi uye olusan, uye laisan, uye gogoghasan biereilade fuqi wine!'<verse eid="LUK 23:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="LUK 23:30"/>Hhe shihoude kunla fugie ulade kieliezhi</para>
  <para style="q2" vid="LUK 23:30">bijienni jiere una!</para>
  <para style="q1" vid="LUK 23:30">Ga ulade kieliezhi</para>
  <para style="q2" vid="LUK 23:30">bijienni kha giene.<verse eid="LUK 23:30"/></para>
  <para style="m">
    <verse number="31" style="v" sid="LUK 23:31"/>Hhela noghon mutunde ingiezhi giese ghosan mutunde matugie giene?"<verse eid="LUK 23:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 23:32"/>Da ghua fanrenlai <char style="pn">Ersa</char>re hhantu alane giezho. <verse eid="LUK 23:32"/><verse number="33" style="v" sid="LUK 23:33"/>Hhela qiorun yasun oron giesan oronde kudene <char style="pn">Ersa</char>i shizijia jiere ghadawo. Ghua fanrenniye <char style="pn">Ersa</char>i lianmiende ghadawo. <verse eid="LUK 23:33"/><verse number="34" style="v" sid="LUK 23:34"/><char style="pn">Ersa</char> kieliewo, "Adaya, hhelai mienlie. Hhela yan giesanne ulie mejiene." Buduila fendan qianguzhi <char style="pn">Ersa</char>i jienni ghughazho. <verse eid="LUK 23:34"/><verse number="35" style="v" sid="LUK 23:35"/>Bexinla beidene uzhezho. Noyenlaye uzhezhi xiniezhi kieliezho, "Hhe kunlai jiuiwo, goyashi Huda sunghusan Hudai Mexiha enbese goyane jiui gie." <verse eid="LUK 23:35"/><verse number="36" style="v" sid="LUK 23:36"/>Buduila <char style="pn">Ersa</char>i shida khirei cu ogidene xilun giezhi <verse eid="LUK 23:36"/><verse number="37" style="v" sid="LUK 23:37"/>chi <char style="png">Yutai</char> kunni honshan enbese goyane jiuisha giezho. <verse eid="LUK 23:37"/><verse number="38" style="v" sid="LUK 23:38"/><char style="pn">Ersa</char>i qiorun qinde nie peizii gie eneshi <char style="png">Yutai</char> kunni honshan wo giezho.<verse eid="LUK 23:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 23:39"/>Hhantu ghadasan nie fanren <char style="pn">Ersa</char>i sugiezhi kieliewo, "Chishi Mexiha pushonu? Goyane jiuidene bijienyiye jiuisha!" <verse eid="LUK 23:39"/><verse number="40" style="v" sid="LUK 23:40"/>Da nie fanren hhei sugiezhi kieliewo, "Chii xianxianji fugughaku zui panjidene Hudase da ulie ayinu? <verse eid="LUK 23:40"/><verse number="41" style="v" sid="LUK 23:41"/>Matan giesan wilie mutunshi ghadase oluzho, ene kun nie huaishi ese giezho." <verse eid="LUK 23:41"/><verse number="42" style="v" sid="LUK 23:42"/>Ingie kieliewo, "<char style="pn">Ersa</char>, chi goya gojiadene qienli bareikude mini jila." <verse eid="LUK 23:42"/><verse number="43" style="v" sid="LUK 23:43"/><char style="pn">Ersa</char> kieliewo, "Bi chade shuhua kielieye, enedu matan ghuala qientande hhantulane."<verse eid="LUK 23:43"/></para>
  <para style="s">Ersa Duya Ijiezho</para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 23:44"/>Chabudu zhunwuse xiawu 3 jien olutula zemin man kharalazho. <verse eid="LUK 23:44"/><verse number="45" style="v" sid="LUK 23:45"/>Naran nudun kharalawo. Dajienni sudorodu menlienzi dundase kei echidene ghua gholuwo. <verse eid="LUK 23:45"/><verse number="46" style="v" sid="LUK 23:46"/><char style="pn">Ersa</char> fugiede waradazhi kieliewo, "Ada, bi chade ruhherne jiuiye!" Ene kielienyi kieliedene ho sirawo. <verse eid="LUK 23:46"/><verse number="47" style="v" sid="LUK 23:47"/>Baifuzhan ene shiqinni chanladene Hudai kuaizhi kieliewo, "Eneshi zhenzhen gou kun enbene!" <verse eid="LUK 23:47"/><verse number="48" style="v" sid="LUK 23:48"/>Fashen giesan shiqinni uzhesan kunla man echanne chuidazhi khareiwo. <verse eid="LUK 23:48"/><verse number="49" style="v" sid="LUK 23:49"/>Niezhan <char style="pn">Ersa</char>i tanisan kunla, <char style="png">Jialili</char>se daghazhi iresan biereila gholode beidene uzhezho.<verse eid="LUK 23:49"/></para>
  <para style="s">Ersani Bulazho</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 23:50"/>Fugie fayenni nie noyenyi nierei <char style="pn">Yusufu</char> giene. Hheshi nie gou kun wo, gundan kun wo. <verse eid="LUK 23:50"/><verse number="51" style="v" sid="LUK 23:51"/>Fayende kunla hui keizhi <char style="pn">Ersa</char>i widaghane giese ene kun tunyi ese oluwo. Hheshi <char style="png">Yudaya</char>ni <char style="png">Yalimatai</char> chenshini kun wo, izhi Hudai gojia irekui sagheizho. <verse eid="LUK 23:51"/><verse number="52" style="v" sid="LUK 23:52"/><char style="pn">Bilado</char>i hhende echidene <char style="pn">Ersa</char>i beyeni xiahua giezhi kerewo. <verse eid="LUK 23:52"/><verse number="53" style="v" sid="LUK 23:53"/>Agi bouzhe boside boui tashide waisan fugie mezade teiwo. Hhe mezade kun nieda teizhi ese daozho. <verse eid="LUK 23:53"/><verse number="54" style="v" sid="LUK 23:54"/>Enedushi zhunbei gieku udu wo. Hhamuraku udu ede kuzhene. <verse eid="LUK 23:54"/><verse number="55" style="v" sid="LUK 23:55"/><char style="png">Jialili</char>se <char style="pn">Ersa</char>i daghazhi iresan biereila khuina daghadene mezade <char style="pn">Ersa</char>i beyeni matui teisei uzhewo. <verse eid="LUK 23:55"/><verse number="56" style="v" sid="LUK 23:56"/>Ingie hhela khareizhi echidene xianlio, xianshui zhunbei giezho. Hhamuraku udu oluwo. Hhela jiomunni minlinni zunjizhi hhe niudude hhamurawo.<verse eid="LUK 23:56"/></para>
  <chapter eid="LUK 23"/>
  <chapter number="24" style="c" sid="LUK 24"/>
  <para style="s">Ersa Aminne Oluwo</para>
  <para style="r">(<ref loc="MAT 28:1-10">Mat 28:1-10</ref>; <ref loc="MRK 16:1-8">Mak 16:1-8</ref>; <ref loc="JHN 20:1-10">Yah 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1"/>Xinqini ogheikude giedun biereila zhunbei giesan xianlioni bareidene mezade irewo. <verse eid="LUK 24:1"/><verse number="2" style="v" sid="LUK 24:2"/>Hhela uzhese mezai duighasan tashi ghoghorei daozho. <verse eid="LUK 24:2"/><verse number="3" style="v" sid="LUK 24:3"/>Oro echi uzhese Ezhan <char style="pn">Ersa</char>i beye wida khizho. <verse eid="LUK 24:3"/><verse number="4" style="v" sid="LUK 24:4"/>Hhela zhen jindakude menzhali ghua kun shidani beizho, jienseni gon faine. <verse eid="LUK 24:4"/><verse number="5" style="v" sid="LUK 24:5"/>Niende ayidene melie papalazho. Hhe ghua kun biereilade kieliezho, "Ta yangiezhi fugusan kun dundase amitu kun ereine? <verse eid="LUK 24:5"/><verse number="6" style="v" sid="LUK 24:6"/>Hhe enende uwo, aminne oluwo. Hhe <char style="png">Jialili</char>de kieliesan kielienyi ta jila danu? <verse eid="LUK 24:6"/><verse number="7" style="v" sid="LUK 24:7"/>Hhe kieliezhi Kunnikewonyi matugieseda zuirende jiuizhi ogidene shizijia jiere ghadane. Ghurudu udude aminne olune giewo." <verse eid="LUK 24:7"/><verse number="8" style="v" sid="LUK 24:8"/>Hhe biereila <char style="pn">Ersa</char> kieliesanyi sumula irewo. <verse eid="LUK 24:8"/><verse number="9" style="v" sid="LUK 24:9"/>Hhela mezase khareizhi echidene ene shiqinlai 11 gie tujilade pseshiku kunlade man kieliezho. <verse eid="LUK 24:9"/><verse number="10" style="v" sid="LUK 24:10"/>Ene shiqinyi shitulade kieliesan biereilashi <char style="png">Modala</char>ni <char style="pn">Mereiyen</char>, <char style="pn">Yeyana</char>, <char style="pn">Yagebu</char>ni anani <char style="pn">Mereiyen</char>ji pse giedun biereila wo. <verse eid="LUK 24:10"/><verse number="11" style="v" sid="LUK 24:11"/>Shitula ene kielienyi xianxin ese giezho. Hu kieliezho giezho. <verse eid="LUK 24:11"/><verse number="12" style="v" sid="LUK 24:12"/>Ingieliuzhe <char style="pn">Beduru</char> bosi ire mezade holuzhi echidene ghodei nie uzhese nie bosi wo, pse yama uwo. Khareikude matui imutui gholuwo giezhi sumulazho.<verse eid="LUK 24:12"/></para>
  <para style="s">Imawusini Mo Jiere</para>
  <para style="r">(<ref loc="MRK 16:12-13">Mak 16:12-13</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13"/>Hhe niudude <char style="pn">Ersa</char>i daghasan ghua tujilani <char style="png">Imawusi</char> giesan aghinde echine giezho, <char style="png">Yelusalen</char>se 22 li mo wo. <verse eid="LUK 24:13"/><verse number="14" style="v" sid="LUK 24:14"/>Hhela mo jiere yokude fashen giesan shiqinlai kielienduzho. <verse eid="LUK 24:14"/><verse number="15" style="v" sid="LUK 24:15"/>Zhen kieliendukude <char style="pn">Ersa</char> qinsi shidani kuzhezhi hhelare hhantu yozhoma, <verse eid="LUK 24:15"/><verse number="16" style="v" sid="LUK 24:16"/>hhelai nudun madadene kien bikuni tani dazho. <verse eid="LUK 24:16"/><verse number="17" style="v" sid="LUK 24:17"/><char style="pn">Ersa</char> hhelade asazho, "Ta yon yon yan kielienduzhou?" Hhela beidene nango giezhi uxinne boughazho. <verse eid="LUK 24:17"/><verse number="18" style="v" sid="LUK 24:18"/>Nie kunni niereini <char style="pn">Geliuba</char> giene. <char style="pn">Ersa</char>de kieliewo, "Chi <char style="png">Yelusalen</char>de toreizhi ene giedudu fashen giesan shiqinlai chi niezheghanne ulie mejienu?"<verse eid="LUK 24:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 24:19"/>
    <char style="pn">Ersa</char> asawo, "Yan shiqin wo?" Hhela kieliewo, "<char style="png">Nasale</char>ni <char style="pn">Ersa</char>i shiqin wo. Hheshi nie xienzhi wo. Hudai melie bexinlai melie kielien kieliekude, giekude nenli wine. <verse eid="LUK 24:19"/><verse number="20" style="v" sid="LUK 24:20"/>Mai fugie buwa, noyenla hhei jiuidene fugughaku zui panjisenu shizijia jiere ghadawo. <verse eid="LUK 24:20"/><verse number="21" style="v" sid="LUK 24:21"/>Bijien panjise hheshi <char style="png">Isilie</char>ni jiuile iresan enbene giezho. Ene shiqin fashen giezhi ghurudu oluwo. <verse eid="LUK 24:21"/><verse number="22" style="v" sid="LUK 24:22"/>Ingiedene bijienyi dundase giedun bierei bijienyi ghaniraghawo. Hhela eqiemagha eqie meza konde echise <verse eid="LUK 24:22"/><verse number="23" style="v" sid="LUK 24:23"/><char style="pn">Ersa</char>i beye wida khizho. Ingie kharei iredene bijiende kieliese qienxienlai chanlawo giezho. Qienxienla kieliese hhe aminne oluwo giene. <verse eid="LUK 24:23"/><verse number="24" style="v" sid="LUK 24:24"/>Ingie bijien giedun kun dagha mezadei uzhele echise biereila kieliesan mutun wo. <char style="pn">Ersa</char>i chanla dawo." <verse eid="LUK 24:24"/><verse number="25" style="v" sid="LUK 24:25"/><char style="pn">Ersa</char> hhelade kieliewo, "Ta ene yama ulie mejiesan kunla, ta xienzhila kieliesan kielienyi gou xianxin ese giezho. <verse eid="LUK 24:25"/><verse number="26" style="v" sid="LUK 24:26"/>Mexiha Hudaghala hhantu undu wizide soutula ingiezhi shouku giedene goyane famashighaku pushonu?" <verse eid="LUK 24:26"/><verse number="27" style="v" sid="LUK 24:27"/>Ingiedene <char style="pn">Musa</char>, xienzhilani shu kaishi giezhi jinwun jiere goya fanmiende huaisan kielienni hhelade kieliezhi man minbai olughawo.<verse eid="LUK 24:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28"/>Hhela echiku hhe aghinde kuzhese <char style="pn">Ersa</char> melie yosanyi xianli. <verse eid="LUK 24:28"/><verse number="29" style="v" sid="LUK 24:29"/>Hhela ninkounin <char style="pn">Ersa</char>i feilieghazhi kieliewo, "Ede nanran pudawo, khara oluwo. Matan enende hhantu souye." Ingiese <char style="pn">Ersa</char> hhelare hhantu echi souwo. <verse eid="LUK 24:29"/><verse number="30" style="v" sid="LUK 24:30"/>Ijiekude <char style="pn">Ersa</char> ginanyi barei Hudade mafan kieliedene ghulu hhelade ogiwo. <verse eid="LUK 24:30"/><verse number="31" style="v" sid="LUK 24:31"/>Ingiekude hhelai nudun gieghere <char style="pn">Ersa</char>i tanise <char style="pn">Ersa</char> menzhali hhelai meliese wida khiwo. <verse eid="LUK 24:31"/><verse number="32" style="v" sid="LUK 24:32"/>Hhela kieliewo, "Mo jiere hhe matande jinwun jianjikude matanyi zhughe khalundazhola?" <verse eid="LUK 24:32"/><verse number="33" style="v" sid="LUK 24:33"/>Ingie deigo bosizhe <char style="png">Yelusalen</char>de echidene 11 gie tuji, psedu kunla hhantulakui chanlawo. <verse eid="LUK 24:33"/><verse number="34" style="v" sid="LUK 24:34"/>Kunla kieliezho, "Ezhan shuhuane aminne oludene <char style="pn">Ximun</char>de chujiegheghazho." <verse eid="LUK 24:34"/><verse number="35" style="v" sid="LUK 24:35"/>Hhe ghuala mo jiere <char style="pn">Ersa</char>i penjisan shiqinyi, pse ginan ghuluzhi ogikude matugie tanisanyi hhelade man kieliewo.<verse eid="LUK 24:35"/></para>
  <para style="s">Ersa Daghasan Kunlade Chujiegheghazho</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mat 28:16-20</ref>; <ref loc="MRK 16:14-18">Mak 16:14-18</ref>; <ref loc="JHN 20:19-23">Yah 20:19-23</ref>; <ref loc="ACT 1:6-8">Tuj 1:6-8</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36"/>Zhen ene kielienyi kieliekude <char style="pn">Ersa</char> qinsi hhelai dunda ire beizhi kieliewo, "Ta pinnan onu?" <verse eid="LUK 24:36"/><verse number="37" style="v" sid="LUK 24:37"/>Hhela hende ayizhi sumulase ruhher chanlawo giezho. <verse eid="LUK 24:37"/><verse number="38" style="v" sid="LUK 24:38"/><char style="pn">Ersa</char> hhelade kieliewo, "Ta yale ingiezhi jindazhi xianxin ulie giene? <verse eid="LUK 24:38"/><verse number="39" style="v" sid="LUK 24:39"/>Ta kon khaimini nie moizhi uzhema, bi enbekui mejiene. Ruhherde yasun migha uwo. Ta uzhe, made wine." <verse eid="LUK 24:39"/><verse number="40" style="v" sid="LUK 24:40"/>Ene kielienyi kieliedene kha, konne hhelade uzheghawo. <verse eid="LUK 24:40"/><verse number="41" style="v" sid="LUK 24:41"/>Hhela bayasuzhoma, xianxin gie dazhi ghudurezho. <char style="pn">Ersa</char> kieliewo, "Tai enende yama ijiekui winu uwo?" <verse eid="LUK 24:41"/><verse number="42" style="v" sid="LUK 24:42"/>Ingie hhela shirasan zhaghasunse gouji ogiwo. <verse eid="LUK 24:42"/><verse number="43" style="v" sid="LUK 24:43"/>Hhe jienliedei hhelai melie ijie agiwo.<verse eid="LUK 24:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 24:44"/>
    <char style="pn">Ersa</char> hhelade kieliewo, "Eneshi bi melieshida tanre hhantu bikude kieliesan wo. <char style="pn">Musa</char>ni guijinshu, xienzhishu, zeburei jiere mii zhiizhi huaisanlai man ijinyo gholughakuni wo." <verse eid="LUK 24:44"/><verse number="45" style="v" sid="LUK 24:45"/>Ingiedene <char style="pn">Ersa</char> hhelai sumuladanyi minbai olughazhi jinwunni dunjireghadene <verse eid="LUK 24:45"/><verse number="46" style="v" sid="LUK 24:46"/>hhelade kieliewo, "Jinwun jiere ingiezhi huaizho, Mexiha irese ijinyo shouku giezhi duya ijiedene ghurudushi aminne olune. <verse eid="LUK 24:46"/><verse number="47" style="v" sid="LUK 24:47"/>Pse hhei niereghala geizhen giese roulieku gouxioxini <char style="png">Yelusalen</char>se soyuji minzulade chonji keine. <verse eid="LUK 24:47"/><verse number="48" style="v" sid="LUK 24:48"/>Ta ene shiqinde ganzhen bei. <verse eid="LUK 24:48"/><verse number="49" style="v" sid="LUK 24:49"/>Adami dain giesan hhei bi tai jiere peizhi ireghane. Asiman jierese Hudai nenli tande olon iretula ta ene chenshide saghei."<verse eid="LUK 24:49"/></para>
  <para style="s">Asiman Jiere Khireizho</para>
  <para style="r">(<ref loc="MRK 16:19-20">Mak 16:19-20</ref>; <ref loc="ACT 1:9-11">Tuj 1:9-11</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50"/>
    <char style="pn">Ersa</char> hhelai uduruzhi <char style="png">Bodani</char>de echidene khane zhadeighazhi hhelade oluzhi onxian giewo. <verse eid="LUK 24:50"/><verse number="51" style="v" sid="LUK 24:51"/>Zhen onxian giekude hhelase likai gie asiman jiere khireiwo. <verse eid="LUK 24:51"/><verse number="52" style="v" sid="LUK 24:52"/>Hhela <char style="pn">Ersa</char>i beiidene hende bayasuzhi <char style="png">Yelusalen</char>de khareiwo. <verse eid="LUK 24:52"/><verse number="53" style="v" sid="LUK 24:53"/>Hhela Hudade doulazhi chan mechide wo.<verse eid="LUK 24:53"/></para>
  <chapter eid="LUK 24"/>
</usx>
