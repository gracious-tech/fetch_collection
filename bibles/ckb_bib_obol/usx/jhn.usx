<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- Biblica® Open Sorani Kurdish Book of Life</book>
  <para style="rem">‪Copyright © 1998 by Biblica, Inc.</para>
  <para style="h">یۆحەنا</para>
  <para style="toc1">مزگێنی به‌پێی نووسینی یۆحه‌ننا</para>
  <para style="toc2">یۆحەنا</para>
  <para style="toc3">یۆحەنا</para>
  <para style="mt1">مزگێنی به‌پێی نووسینی یۆحه‌ننا</para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s1">ووشه‌ی خودا</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1" />‏له‌سه‌ره‌تاوه‌ ووشه‌كه‌* بوو، ووشه‌كه‌ لای خودا بوو، ووشه‌كه‌ش خۆی خودا بوو. <verse eid="JHN 1:1" /><verse number="2" style="v" sid="JHN 1:2" />ئه‌و هه‌ر له‌سه‌ره‌تاوه‌ لای خودا بوو. <verse eid="JHN 1:2" /><verse number="3" style="v" sid="JHN 1:3" />به‌و هه‌موو شتێ‌ دروست‎بووه‌، بێ‌‏ئه‌و هیچ شتێك دروست نه‌بووه‌ له‌مانه‌ی كه‌ دروست بوون. <verse eid="JHN 1:3" /><verse number="4" style="v" sid="JHN 1:4" />ژیان له‌‏ئه‌وا بوو، ئه‌و ژیانه‌ش ڕووناكی مرۆڤ بوو‏، <verse eid="JHN 1:4" /><verse number="5" style="v" sid="JHN 1:5" />ڕووناكیش تاریكی ڕووناك ده‌كاته‌وه‌و تاریكی ناتوانێ‌ ڕووناكی ببه‌زێنێ‌.<verse eid="JHN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6" />مرۆڤێك هات كه‌ خودا ناردبووی، ناوی یه‌حیا بوو، <verse eid="JHN 1:6" /><verse number="7" style="v" sid="JHN 1:7" />ئه‌و هات شایه‌تی بۆ ڕووناكی بدات، تاوه‌كو هه‌مووان به‌هۆی ئه‌وه‌وه‌ باوه‌ڕبهێنن. <verse eid="JHN 1:7" /><verse number="8" style="v" sid="JHN 1:8" />یه‌حیا خۆی ڕووناكییه‌كه‌ نه‌بوو، به‌ڵكو شایه‌تی ڕووناكییه‌كه‌ بوو. <verse eid="JHN 1:8" /><verse number="9" style="v" sid="JHN 1:9" />ئه‌و ڕووناكیه‌ ڕاسته‌ی هه‌موو خه‌ڵكی ڕووناك ده‌كاته‌وه‌ هاته‌ جیهان، <verse eid="JHN 1:9" /><verse number="10" style="v" sid="JHN 1:10" />ئه‌و له‌جیهاندا بوو، به‌ویش جیهان‏ دروست بوو، كه‌چی جیهان نه‌یناسی. <verse eid="JHN 1:10" /><verse number="11" style="v" sid="JHN 1:11" />ئه‌و بۆ لای گه‌له‌كه‌ی هات‏، كه‌چی ئه‌وان پێشوازیان لێ‌نه‌كرد. <verse eid="JHN 1:11" /><verse number="12" style="v" sid="JHN 1:12" />به‌ڵام هه‌موو ئه‌وانه‌ی پێشوازیان لێ‌كرد، ئه‌وانه‌ی باوه‌ڕیان به‌ناوی هێنا، ده‌سه‌ڵاتی پێدان ببن به‌ڕۆڵه‌ی خودا*، <verse eid="JHN 1:12" /><verse number="13" style="v" sid="JHN 1:13" />ئه‌وانه‌ی نه‌به‌خوێن، نه‌به‌ویستی له‌ش، نه‌به‌ویستی پیاو، به‌ڵكو له‌خوداوه‌ بوون.<verse eid="JHN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14" />ئینجا ووشه‌كه‌ بوو به‌‏له‌ش‏و له‌‏ناوماندا نیشته‌جێ‌بوو، ئێمه‌ شكۆی ئه‌ومان بینی، شكۆی تاقانه‌ی باوك، ئه‌وه‌ی پڕ‏بوو له‌‏به‌ره‌كه‌ت‏و ڕاستی. <verse eid="JHN 1:14" /><verse number="15" style="v" sid="JHN 1:15" />یه‌حیا شایه‌تی بۆده‌داو هاواری ده‌كرد: (ئه‌مه‌ ئه‌وه‌یه‌ كه‌ باسم كردو ووتم: ئه‌وه‌ی له‌دوای من دێت له‌‏پێش من بوونی هه‌یه‌، چونكه‌ ئه‌و بووه‌ پێش ئه‌وه‌ی من ببم.) <verse eid="JHN 1:15" /><verse number="16" style="v" sid="JHN 1:16" />هه‌موومان له‌‏پڕی ئه‌و به‌ره‌كه‌ت* له‌دوای به‌ره‌كه‌تمان وه‌رگرت، <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />چونكه‌ شه‌ریعه‌ت به‌هۆی موساوه‌ درا، به‌ڵام به‌ره‌كه‌ت‏و ڕاستی به‌هۆی عیسای مه‌سیحه‌وه‌ هاتن. <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />هه‌رگیز كه‌س خودای نه‌بینیوه‌، به‌ڵام تاقانه‌ی خودا، ئه‌وه‌ی له‌باوه‌شی باوكدایه‌، ئه‌و خودای بۆ ئێمه‌ ده‌رخست.<verse eid="JHN 1:18" /></para>
  <para style="s1">شایه‌تیدانی حه‌زره‌تی یه‌حیا‏</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />ئه‌مه‌ش شایه‌تییه‌كه‌ی یه‌حیایه‌، كاتێ‌ جووله‌كه‌كانی قودس هه‌ندێ‌ كاهین‏و لاوییان نارد پرسیاری لـێ‌بكه‌ن: (تۆ كێیت؟‏) <verse eid="JHN 1:19" /><verse number="20" style="v" sid="JHN 1:20" />ئه‌و به‌ بێ‌ دوودڵی دانی پیاناو ووتی: (من مه‌سیح نیم.) <verse eid="JHN 1:20" /><verse number="21" style="v" sid="JHN 1:21" />ئینجا لێیان پرسی: (ئه‌ی تۆ كێیت؟ ئه‌لیاسی؟) ووتی: (نه‌خێر! ئه‌و نیم.) ووتیان: (ئایا پێغه‌مبه‌ره‌كه‌ی<note caller="+" style="f"><char style="fr" closed="false">1‏:21 </char><char style="ft" closed="false">پێغه‌مبه‌ره‌كه‌ی: مه‌به‌ستی له‌و پێغه‌مبه‌ره‌یه‌ كه‌ موسا باسی ده‌كات. بڕوانه‌ یۆحه‌</char><char style="xt"><ref loc="JHN 1:45">یۆحەنا 1‏:45</ref></char> </note>؟) ووتی: (نه‌خێر.) <verse eid="JHN 1:21" /><verse number="22" style="v" sid="JHN 1:22" />له‌كۆتاییدا ووتیان: (باشه‌ تۆ كێیت، تا وه‌ڵامه‌كه‌ بده‌ینه‌وه‌ به‌و كه‌سانه‌ی ئێمه‌یان ناردووه‌؟ چی ده‌ڵێیت ده‌رباره‌ی خۆت؟) <verse eid="JHN 1:22" /><verse number="23" style="v" sid="JHN 1:23" />ئه‌ویش ووتی: )من [[‏ده‌نگێكم له‌‏ده‌شت‏و‏ده‌ر هاوار ده‌كه‌م: ڕێگای خوداوه‌ند ڕێك‏و ئاماده‌كه‌ن]]، هه‌روه‌ك چۆن ئه‌شعیای پێغه‌مبه‌ر ووتویه‌تی.( <verse eid="JHN 1:23" /><verse number="24" style="v" sid="JHN 1:24" />ئه‌وانه‌ی له‌‏لایه‌ن فه‌ریسیه‌كانه‌وه‌ نێررابوون، <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />دیسان پرسییان: (باشه‌ گه‌ر تۆ مه‌سیح نیت‏و ئه‌لیاس نیت‏و پێغه‌مبه‌ره‌كه‌ نیت‏، ئیتر بۆچی خه‌ڵكی له‌ئاوهه‌ڵده‌كێشیت؟) <verse eid="JHN 1:25" /><verse number="26" style="v" sid="JHN 1:26" />وه‌ڵامی دایه‌وه‌: (من خه‌ڵكی له‌ئاوهه‌ڵده‌كێشم‏، به‌ڵام له‌‏نێوانتاندا یه‌كێك هه‌یه‌ كه‌ نایناسن، <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />ئه‌و دوای من دێت، من شایانی ئه‌وه‌ نیم قه‌یتانی پێڵاوه‌كانی بۆ بكه‌مه‌وه‌.)<verse eid="JHN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28" />ئه‌مه‌ش ‏له‌‏دێی به‌یت‏عه‌نیا ڕوویدا، له‌وبه‌ری ڕووباری ئوردونه‌وه‌، له‌و شوێنه‌ی یه‌حیا خه‌ڵكی له‌ئاوهه‌ڵده‌كێشا.<verse eid="JHN 1:28" /></para>
  <para style="s1">به‌رخی قوربانی خودا</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />ڕۆژێ‌ دوای ئه‌وه‌ یه‌حیا عیسای بینی وا به‌ره‌و ڕووی دێت، ووتی: (ئا ئه‌وه‌تا به‌رخی خودا[]، ئه‌و قوربانییه‌ی گوناهی جیهان هه‌ڵ‎ده‌گرێت. <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />ئه‌مه‌ ئه‌و كه‌سه‌یه‌ كه‌ ده‌رباره‌ی ووتم، ئه‌وه‌ی له‌دوای من دێت له‌‏پێش من بوونی هه‌یه‌، چونكه‌ ئه‌و هه‌بووه‌ پێش بوونی من. <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />‏منیش نه‌م‎ده‌ناسی، به‌ڵام هاتووم بۆ له‌ئاوهه‌ڵكێشان تا ئه‌و بۆ ئیسرائیل ده‌ركه‌وێ‌.) <verse eid="JHN 1:31" /><verse number="32" style="v" sid="JHN 1:32" />ئینجا یه‌حیا شایه‌تیداو ووتی: (‏ڕۆحی پیرۆزم* له‌شێوه‌ی كۆترێك بینی له‌‏ئاسمانه‌وه‌ هاته‌خواره‌وه‌و له‌سه‌ر عیسا نیشته‌وه‌. <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />من نه‌م‎ده‌ناسی، به‌ڵام ئه‌وه‌ی منی ناردووه‌ خه‌ڵك له‌ئاوهه‌ڵكێشم، ئه‌و پێیووتم: ئه‌وه‌ی ده‌یبینیت ڕۆح دێته‌خواره‌وه‌و له‌سه‌ری جێگیر ده‌بێ‌، ئه‌و خه‌ڵكی به‌ڕۆحی پیرۆز هه‌ڵده‌كێشێ‌. <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />له‌به‌رئه‌وه‌ی ئه‌مه‌م دیووه‌، شایه‌تی ده‌ده‌م ئه‌و ڕۆڵه‌ی خودایه‌.(<verse eid="JHN 1:34" /></para>
  <para style="s1">قوتابیه‌ یه‌كه‌مینه‌كان</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />بۆ به‌یانی یه‌حیا له‌گه‌ڵ دوو قوتابی خۆی دیسان هه‌ر له‌وێ‌ ڕاوه‌ستا بوو، <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />كه‌ عیسا به‌وێدا ڕۆیشت سه‌یریكردو ووتی: (ئا ئه‌وه‌تا به‌رخی خودا<note caller="+" style="f"><char style="fr" closed="false">1‏:36 </char><char style="ft" closed="false">به‌رخی خودا: بڕوانه‌ ووشه‌ی كه‌فاره‌ت له‌ ڕوونكردنه‌وه‌ی زاراوه‌كان. </char></note>.) <verse eid="JHN 1:36" /><verse number="37" style="v" sid="JHN 1:37" />‏كاتێ‌ دوو قوتابیه‌كه‌ گوێیان له‌مه‌ بوو، دوای عیسا كه‌وتن. <verse eid="JHN 1:37" /><verse number="38" style="v" sid="JHN 1:38" />عیسا ئاوڕیدایه‌وه‌و سه‌یریكرد ئه‌وان به‌‏دوایه‌وه‌ن، لێیپرسین: (چیتان ده‌وێت؟) ووتیان: (ڕابی، (واته‌ مامۆستا) له‌كوێ‌ ده‌ژیت؟) <verse eid="JHN 1:38" /><verse number="39" style="v" sid="JHN 1:39" />وه‌ڵامی دانه‌وه‌و ووتی: (وه‌رن، ببینن.) ئینجا له‌گه‌ڵی ڕۆیشتن‏و ئه‌و شوێنه‌یان بینی كه‌ تیایدا ده‌ژیا‏، كات نزیكه‌ی چواری پاش نیوه‌ڕۆ بوو، ئه‌و ڕۆژه‌ له‌گه‌ڵی مانه‌وه‌. <verse eid="JHN 1:39" /><verse number="40" style="v" sid="JHN 1:40" />ئه‌نده‌راوس كه‌ برای شه‌معون په‌ترۆس بوو، یه‌كێ‌ بوو له‌و دووانه‌ی دوای عیسا كه‌وتن، دوای ئه‌وه‌ی گوێیان له‌قسه‌ی یه‌حیا بوو. <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />هه‌ر كه‌ ئه‌نده‌راوس شه‌معونی برای دۆزییه‌وه‌، پێی ووت: (مه‌سیحمان دۆزیه‌وه‌) واته‌ ده‌ست‏نیشانكراو. <verse eid="JHN 1:41" /><verse number="42" style="v" sid="JHN 1:42" />ئینجا بردی بۆ لای عیسا، عیسا به‌‏ووردی تێیڕوانی و ووتی: (تۆ شه‌معونی كوڕی یۆنای، به‌ڵام من بانگت ده‌كه‌م كێفا<note caller="+" style="f"><char style="fr" closed="false">1‏:42 </char><char style="ft" closed="false">كێفا : ووشه‌یه‌كی ئارامیه‌ به‌واتای تاشه‌به‌رد، به‌ یۆنانیش پێی ده‌ووترێ‌ په‌ترۆس.</char></note>، واته‌ په‌ترۆس.)<verse eid="JHN 1:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />بۆ به‌یانی عیسا بڕیاریدا بڕوات بۆ ناوچه‌ی جه‌لیل، كاتێ‌ فیلیپۆسی دۆزیه‌وه‌، پێی ووت: (دوام كه‌وه‌!) <verse eid="JHN 1:43" /><verse number="44" style="v" sid="JHN 1:44" />فیلیپۆس وه‌ك ئه‌نده‌راوس‏و په‌ترۆس خه‌ڵكی شاری به‌یت سه‌یدا بوو. <verse eid="JHN 1:44" /><verse number="45" style="v" sid="JHN 1:45" />ئینجا فیلیپۆس نه‌سه‌نائیلی دۆزیه‌وه‌ پێی ووت: (‏ئه‌وه‌ی موسا له‌‏ته‌وراتدا له‌سه‌ری نووسیوه‌و پێغه‌مبه‌رانیش له‌په‌رتووكه‌كانیان، دۆزیمانه‌وه‌. ئه‌و كه‌سه‌ عیسای كوڕی یوسفی خه‌ڵكی ناسیره‌یه‌.) <verse eid="JHN 1:45" /><verse number="46" style="v" sid="JHN 1:46" />نه‌سه‌نائیل ووتی: (ئایا له‌‏شاری ناسیره‌ شتی چاك هه‌ڵ‎ده‌كه‌وێ‌؟) فیلیپۆس پێی ووت: (وه‌ره‌ سه‌یركه‌!)<verse eid="JHN 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47" />كه‌ عیسا نه‌سه‌نائیلی بینی وا به‌ره‌و ڕووی دێت، ووتی: (بێ‌گومان ئه‌مه‌ ئیسرائیلییه‌كی بێ‌غه‌لوغه‌شه‌!) <verse eid="JHN 1:47" /><verse number="48" style="v" sid="JHN 1:48" />نه‌سه‌نائیل له‌عیسای پرسی: (له‌‏كوێ‌ ده‌م‎ناسیت؟) عیسا له‌‏وه‌ڵامدا ووتی: (‏كاتێ‌ له‌ژێر دارهه‌نجیره‌كه‌ بوویت تۆم بینی، پێش‎ ئه‌وه‌ی فیلیپۆس بانگت‎بكات.) <verse eid="JHN 1:48" /><verse number="49" style="v" sid="JHN 1:49" />ئینجا نه‌سه‌نائیل هاواری كردو ووتی: (ئه‌ی مامۆستا، تۆ ڕۆڵه‌ی خودایت! تۆ پادشای ئیسرائیلیت!) <verse eid="JHN 1:49" /><verse number="50" style="v" sid="JHN 1:50" />عیسا پێی ووت: (ئایا باوه‌ڕت هێنا چونكه‌ پێم ووتیت تۆم له‌ژێر دارهه‌نجیره‌كه‌ بینی؟ بزانه‌ كاری له‌مه‌ش مه‌زنتر ده‌بینیت!) <verse eid="JHN 1:50" /><verse number="51" style="v" sid="JHN 1:51" />دیسان ووتی: (ڕاستی ڕاستیتان پێ‌ده‌ڵێم، ئێوه‌ ئاسمان به‌كراوه‌یی ده‌بینن‏و فریشته‌ی خودا ده‌بینن له‌به‌رزبوونه‌وه‌و هاتنه‌خواره‌وه‌یان له‌سه‌ر ڕۆڵه‌ی مرۆڤ.)<verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s1">شایی له‌قانا</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />له‌‏ڕۆژی سێهه‌مدا له‌‏دێی قانا له‌‏ناوچه‌ی جه‌لیل شاییه‌ك هه‌بوو، دایكی عیساش ئاماده‌ی ئه‌و شاییه‌ بوو، <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />هه‌روه‌ها عیساو قوتابیه‌كانیشی بانگ‎كرابوون بۆ ئه‌م شاییه‌. <verse eid="JHN 2:2" /><verse number="3" style="v" sid="JHN 2:3" />كاتێ‌ شه‌راب ته‌واو بوو، دایكی چووه‌ لای عیساو پێی ووت: (هیچ شه‌رابیان نه‌ماوه‌!) <verse eid="JHN 2:3" /><verse number="4" style="v" sid="JHN 2:4" />ئه‌ویش پێی ووت: (ئه‌مه‌ په‌یوه‌ندی به‌منه‌وه‌ هه‌یه‌ یان به‌تۆ؟ هێشتا كاتی من نه‌هاتووه‌!) <verse eid="JHN 2:4" /><verse number="5" style="v" sid="JHN 2:5" />دوایی دایكی عیسا به‌‏ئیشكه‌ره‌كانی ووت: (‏ئه‌وه‌ی ئه‌و فه‌رمانتان پێ‌ده‌دات بیكه‌ن.) <verse eid="JHN 2:5" /><verse number="6" style="v" sid="JHN 2:6" />له‌وێدا شه‌ش كوپه‌ی به‌ردین هه‌بوو، جووله‌كه‌كان ئاوه‌كه‌یان به‌كارده‌هێنا بۆ پاك‏كردنه‌وه‌ به‌پێی خووڕه‌وشتی خۆیان، كوپه‌كان هه‌ریه‌كه‌ی هه‌شتا تا سه‌دو بیست لیتریان ده‌گرت. <verse eid="JHN 2:6" /><verse number="7" style="v" sid="JHN 2:7" />جا عیسا به‌ئیشكه‌ره‌كانی ووت: (كوپه‌كان پڕكه‌ن له‌ئاو.) ئه‌وانیش كوپه‌كانیان تا سه‌ر پڕكرد. <verse eid="JHN 2:7" /><verse number="8" style="v" sid="JHN 2:8" />ئه‌وسا پێی ووتن: (‏ئێستا لێیده‌ركه‌ن‏و بیبه‌ن بۆ سه‌رپه‌رشتیكه‌ری شاییه‌كه‌!) ئه‌وانیش وایان كرد. <verse eid="JHN 2:8" /><verse number="9" style="v" sid="JHN 2:9" />كاتێ‌ سه‌رپه‌رشتیكه‌ر تامی ئه‌و ئاوه‌ی كرد كه‌ گۆڕابوو بۆ شه‌راب، به‌ڵام سه‌رچاوه‌كه‌ی نه‌ده‌زانی، ئه‌وه‌ی ئیشكه‌ره‌كان ده‌یانزانی چۆنه‌ و چیه‌، ئه‌وسا زاوای بانگ‎كردو <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />پێی ووت: (خه‌ڵكی له‌پێشه‌وه‌ شه‌رابه‌ چاكه‌كه‌ داده‌نێن‏و دوای كه‌مێك خواردنه‌وه‌، شه‌رابی تر ده‌هێنن كه‌ ئه‌وه‌نده‌ باش نه‌بێ‌ وه‌كو ئه‌وه‌ی یه‌كه‌م. به‌ڵام تۆ شه‌رابه‌ باشه‌كه‌ت هێشتۆته‌وه‌ بۆ ئێستا!)<verse eid="JHN 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11" />ئه‌مه‌ یه‌كه‌مین نیشانه‌ی سه‌رسوڕهێنه‌ر بوو كه‌ عیسا له‌‏دێی قانای ناوچه‌ی جه‌لیل كردی، ئه‌وه‌ی تیایدا شكۆمه‌ندی خۆی ده‌رخست‏و قوتابیه‌كانی باوه‌ڕیان پێ‌هێنا. <verse eid="JHN 2:11" /><verse number="12" style="v" sid="JHN 2:12" />دوای ئه‌مه‌ عیساو دایكی‏و براكانی‏و قوتابیه‌كانی چوون بۆ شاری كه‌فه‌رناحوم، چه‌ند ڕۆژێك له‌وێ‌ مانه‌وه‌.<verse eid="JHN 2:12" /></para>
  <para style="s1">پاكسازی په‌رستگا</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />كاتێ‌ جه‌ژنی تێپه‌ڕبوونی جووله‌كه‌ نزیك بووه‌وه‌، عیسا چوو بۆ قودس، <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />له‌په‌رستگادا‏* ئه‌وانه‌ی بینی كه‌ مانگاو مه‌ڕو كۆتریان ده‌فرۆشت، هه‌روه‌ها پاره‌گۆڕه‌وه‌كان له‌به‌رده‌م مێزه‌كانیان دانیشتبوون، <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />عیسا له‌گوریس قامچیه‌كی دروست‎كردو ئه‌وانه‌ی له‌‏په‌رستگادا بوون به‌‏خۆیان‏و مه‌ڕو مانگاوه‌ هه‌موویانی ده‌ركرد. پاره‌ی پاره‌گۆڕه‌وه‌كانی په‌رشوبڵاوكرده‌وه‌و مێزه‌كانیانی سه‌ره‌وژێر كرد، <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />ئینجا به‌‏كۆتر فرۆشه‌كانی ووت: (ئه‌م شتانه‌ لێره‌ ببه‌نه‌ ده‌ره‌وه‌! چۆن ده‌وێرن ماڵی باوكم بكه‌نه‌ بازاڕ؟) <verse eid="JHN 2:16" /><verse number="17" style="v" sid="JHN 2:17" />لێره‌دا قوتابیه‌كان ئه‌و ئایه‌ته‌یان بیركه‌وته‌وه‌ كه‌ له‌كتێبی پیرۆزدا نووسراوه‌: [[دڵگه‌رمی بۆ ماڵه‌كه‌ت ده‌مسوتێنێ‌]].<verse eid="JHN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18" />ده‌سه‌ڵاتدارانی جووله‌كه‌ به‌رهه‌ڵستی عیسایان كردو ووتیان: (نیشانه‌یه‌كمان بۆ بهێنه‌وه‌ ده‌ست‎نیشانی ده‌سه‌ڵاتت بكات بۆ ئه‌و كاره‌ی كردت!) <verse eid="JHN 2:18" /><verse number="19" style="v" sid="JHN 2:19" />جا عیسا له‌‏وه‌ڵامدا ووتی: (ئه‌م په‌رستگایه‌ بڕوخێنن، له‌‏سێ‌ ڕۆژدا دروستی ده‌كه‌مه‌وه‌.) <verse eid="JHN 2:19" /><verse number="20" style="v" sid="JHN 2:20" />ئه‌وسا جووله‌كه‌كان پێیان ووت: (ئه‌م په‌رستگایه‌ به‌چل و شه‌ش ساڵ‎ دروست‎كراوه‌، تۆ به‌‏سێ‌ ڕۆژ دروستیده‌كه‌یته‌وه‌؟) <verse eid="JHN 2:20" /><verse number="21" style="v" sid="JHN 2:21" />به‌ڵام ئه‌و په‌رستگایه‌ی ئه‌و ده‌رباره‌ی قسه‌ی ده‌كرد، له‌شی خۆی بوو. <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />كاتێ‌ عیسا له‌ناو مردووان هه‌ستایه‌وه‌، ئه‌وسا قوتابیه‌كانی ئه‌م قسه‌یه‌ی عیسایان بیر‏كه‌وته‌وه‌، ئینجا باوه‌ڕیان هێنا به‌كتێب‏*و به‌و ووتانه‌ی عیسا ووتبووی.<verse eid="JHN 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />كاتێ‌ عیسا له‌‏جه‌ژنی تێپه‌ڕبووندا له‌‏قودس بوو، ‏خه‌ڵكێكی زۆر ئه‌و نیشانه‌ سه‌ر‏سوڕهێنه‌رانه‌یان بینی كه‌ كردیو باوه‌ڕیان به‌ناوی ئه‌و هێنا. <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />به‌ڵام عیسا متمانه‌ی پێ‌ نه‌كردن‏، چونكه‌ هه‌موو خه‌ڵكی ده‌ناسی. <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />ئه‌و پێویستی به‌كه‌س نه‌بوو شایه‌تی بۆ بدا ده‌رباره‌ی مرۆڤ، چونكه‌ ناوه‌ڕۆكی مرۆڤی ده‌ناسی.<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s1">له‌دایك ‏بوون ‏له‌‏رۆح</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />پیاوێك هه‌بوو له‌‏فه‌ریسیه‌كان ناوی نیقۆدیمۆس بوو، ئه‌ندام بوو له‌‏ئه‌نجوومه‌نی جووله‌كه‌كان. <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />به‌شه‌و بۆ لای عیسا هات‏و پێی ووت: (مامۆستا، ئێمه‌ ده‌زانین تۆ مامۆستایه‌كی له‌‏لای خوداوه‌ هاتوویت، چونكه‌ ئه‌و نیشانه‌ سه‌رسوڕهێنه‌رانه‌ی تۆ ده‌یكه‌یت، كه‌س ناتوانێ‌ بیكات گه‌ر خودای له‌گه‌ڵدا نه‌بێت.) <verse eid="JHN 3:2" /><verse number="3" style="v" sid="JHN 3:3" />ئینجا عیسا پێی ووت: (ڕاستی ڕاستیت پێ‌ ده‌ڵێم، كه‌س ناتوانێت پادشاهێتی خودا ببینێت گه‌ر له‌ئاسمانه‌وه‌ له‌دایك نه‌بێت.) <verse eid="JHN 3:3" /><verse number="4" style="v" sid="JHN 3:4" />نیقۆدیمۆس لێیپرسی: (مرۆڤ چۆن ده‌توانێت به‌پیری له‌دایك ببێته‌وه‌؟ خۆ جارێكیكه‌ ناچێته‌وه‌ سكی دایكی‏و سه‌رله‌نوێ‌ له‌دایك بێته‌وه‌!) <verse eid="JHN 3:4" /><verse number="5" style="v" sid="JHN 3:5" />عیسا وه‌ڵامی دایه‌وه‌و ووتی: (ڕاستی ڕاستیت پێ‌ ده‌ڵێم، كه‌س ناتوانێ‌ بچێته‌ ناو پادشاهێتی خودا گه‌ر له‌ئاو و له‌‏ڕۆح له‌دایك‏‎‏نه‌بێته‌وه‌. <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />‏چونكه‌ ئه‌وه‌ی له‌ له‌شه‌وه‌ له‌دایك ده‌بێ‌ له‌شه‌، ئه‌وه‌ش كه‌ له‌ ڕۆحه‌وه‌ له‌دایك ده‌بێت ڕۆحه‌‏، <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" />كه‌واته‌ سه‌رت سوڕنه‌مێنێ‌ كه‌ ده‌ڵێم: پێویسته‌ له‌ئاسمانه‌وه‌ له‌دایك‎ ببنه‌وه‌. <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" />شنه‌با بۆ هه‌ر شوێنێ‌ كه‌ ئاره‌زووی لـێ‌بێت هه‌ڵ‏ده‌كات‏و گوێمان له‌ ده‌نگه‌كه‌ی ده‌بێت، به‌ڵام نازانرێ‌ له‌كوێوه‌ دێت‏و بۆكوێ‌ ده‌ڕوات. هه‌ر به‌م شێوه‌یه‌شه‌ هه‌موو ئه‌وانه‌ی له‌ ڕۆحه‌وه‌ له‌دایك ده‌بن.)<verse eid="JHN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9" />دیسان نیقۆدیموس پرسیاریكرده‌وه‌: (چۆن ئه‌مه‌ ڕووده‌دات؟) <verse eid="JHN 3:9" /><verse number="10" style="v" sid="JHN 3:10" />عیسا وه‌ڵامی دایه‌وه‌: (تۆ مامۆستایه‌كی ئیسرائیلی‏و ئه‌مه‌ نازانی! <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" />‏ڕاستی ڕاستیت ‎پێ‌ده‌ڵێم: ئێمه‌ ئه‌وه‌ ده‌ڵێین كه‌ ده‌یزانین‏و شایه‌تی بۆ ئه‌وه‌ ده‌ده‌ین كه‌ ده‌یبینین، له‌گه‌ڵ ئه‌وه‌شدا ئێوه‌ شایه‌تیه‌كه‌مان قبوڵ ناكه‌ن. <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />‏باسی شته‌ زه‌مینیه‌كانتان بۆ ده‌كه‌م، باوه‌ڕناكه‌ن، ئیتر چۆن باوه‌ڕ ده‌كه‌ن ئه‌گه‌ر باسی شتی ئاسمانیتان بۆ بكه‌م؟ <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" />هیچ كه‌سێ‌ نه‌چۆته‌ ئاسمان جگه‌ له‌وه‌ی له‌‏ئاسمان هاتۆته‌ خواره‌وه‌، ئه‌ویش ڕۆڵه‌ی مرۆڤه‌. <verse eid="JHN 3:13" /><verse number="14" style="v" sid="JHN 3:14" />جا چۆن موسا ماره‌كه‌ی له‌‏بیاباندا* به‌داره‌وه‌ هه‌ڵواسی، به‌هه‌مان شێوه‌ ڕۆڵه‌ی مرۆڤیش ده‌بێ‌ هه‌ڵواسرێ‌، <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />تاوه‌كو هه‌ركه‌سێك باوه‌ڕی پێ‌بێنێ‌ ژیانی هه‌تاهه‌تایی ده‌سكه‌وێ‌.)</para>
  <para style="s1" vid="JHN 3:15">خۆشه‌ویستی خودا بۆ جیهان</para>
  <para style="p" vid="JHN 3:15">‏ <verse eid="JHN 3:15" /><verse number="16" style="v" sid="JHN 3:16" />(چونكه‌ خودا به‌م جۆره‌ جیهانی خۆشه‌ویست ته‌نانه‌ت تاقه‌ ڕۆڵه‌ی خۆی پێشكه‌ش كرد، هه‌تا ‏هه‌موو ئه‌وانه‌ی باوه‌ڕی پێ‌ده‌كه‌ن له‌ناو نه‌چن، به‌ڵكو ژیانی هه‌تاهه‌تایی به‌ده‌ست بهێنن. <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" />چونكه‌ خودا ڕۆڵه‌ی نه‌نارد بۆ تاوانباركردنی جیهان، به‌ڵكو ناردی تا جیهان ڕزگار بێت به‌هۆی ئه‌وه‌وه‌. <verse eid="JHN 3:17" /><verse number="18" style="v" sid="JHN 3:18" />ئه‌وه‌ی باوه‌ڕی پێ‌ده‌هێنێ‌ تاوانبار ناكرێ‌، به‌ڵام ئه‌وه‌ی باوه‌ڕی پێ‌ناهێنێ‌ تاوانباركراوه‌، چونكه‌ باوه‌ڕی به‌ناوی تاقه‌ ڕۆڵه‌ی خودا نه‌هێناوه‌. <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" />ئه‌مه‌ش حوكمه‌كه‌یه‌: ڕووناكی هات بۆ جیهان، به‌ڵام خه‌ڵكه‌كه‌ حه‌زیان له‌تاریكی كرد له‌جیاتی ڕووناكی، چونكه‌ كرده‌وه‌یان خراپ بوو. <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" />هه‌ر كه‌سێك خراپه‌ بكات ڕقی له‌‏ڕووناكیه‌، نایه‌ته‌ لای ڕووناكی نه‌وه‌ك كرده‌وه‌كانی ئاشكرا ببێ‌. <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" />به‌ڵام ئه‌وه‌ی به‌ڕێگای ڕاستیدا ده‌ڕوات، بۆ لای ڕووناكی دێت تاكو كرده‌وه‌كانی ده‌ركه‌وێت كه‌ به‌هۆی خوداوه‌ كراوه‌.(<verse eid="JHN 3:21" /></para>
  <para style="s1">عیساو شایه‌تی یه‌حیا</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />دوای ئه‌وه‌ عیساو قوتابیه‌كانی ڕۆیشتن بۆ شاره‌كانی یه‌هودیه‌، له‌وێ‌ له‌گه‌ڵیان مایه‌وه‌، ده‌ستیكرد به‌خه‌ڵك له‌ ئاوهه‌ڵكێشان. <verse eid="JHN 3:22" /><verse number="23" style="v" sid="JHN 3:23" />هه‌روه‌ها یه‌حیا له‌كانی نون له‌نزیك شاری سالیم خه‌ڵكی له‌ ئاوهه‌ڵده‌كێشا، چونكه‌ ئاوی ئه‌وێ‌ زۆر بوو خه‌ڵكه‌كه‌ ده‌هاتن‏و له‌وێ‌ له‌ئاوهه‌ڵده‌كێشران. <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" />هێشتا یه‌حیا نه‌خرابووه‌ به‌ندیخانه‌وه‌. <verse eid="JHN 3:24" /><verse number="25" style="v" sid="JHN 3:25" />له‌وێدا گفتوگۆیه‌كی گه‌رم كه‌وته‌ نێوان قوتابیه‌كانی یه‌حیا له‌گه‌ڵ ‏جووله‌كه‌یه‌ك ده‌رباره‌ی پاك‎كردنه‌وه‌. <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />جا چوون بۆ لای یه‌حیاو پێیان ووت: (مامۆستا، ئه‌و پیاوه‌ی بینیمان له‌گه‌ڵت له‌‏پشتی ڕووباری ئوردونه‌وه‌، ئه‌وه‌ی شایه‌تیت بۆدا، ئێستا ئه‌ویش خه‌ڵك له‌ئاوهه‌ڵده‌كێشێ‌‏و هه‌موو خه‌ڵكه‌كه‌ ده‌ڕۆن بۆ لای ئه‌و!)<verse eid="JHN 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27" />یه‌حیاش وه‌ڵامی دایه‌وه‌: (پیاو ده‌توانێ‌ ته‌نها ئه‌وه‌ وه‌رگرێ‌ كه‌ له‌ئاسمانه‌وه‌ پێی دراوه‌! <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" />ئێوه‌ خۆتان شایه‌تن كاتێ‌ ووتم: من مه‌سیح نیم، من پێش ئه‌و نێرراوم. <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />بووك بۆ زاوایه‌! به‌ڵام هاورێی زاوا ئه‌وه‌ی له‌چاوه‌ڕوانیدایه‌ كاتێ‌ گوێی له‌ده‌نگی زاوا ده‌بێ‌، دڵشاد ده‌بێ‌. جا ئه‌وه‌تا ئه‌م خۆشیه‌م هاته‌دی. <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />ده‌بێت ئه‌و زیاد‏بكات و منیش كه‌م.)<verse eid="JHN 3:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />ئه‌وه‌ی له‌سه‌ره‌وه‌ هاتووه‌ له‌سه‌رووی هه‌مووانه‌. به‌ڵام ئه‌وه‌ی له‌ زه‌ویه‌ ئه‌و زه‌مینیه‌و هه‌ر له‌باره‌ی كاروباری زه‌مینی ده‌دوێ‌. جا ئه‌وه‌ی له‌ئاسمانه‌وه‌ هاتووه‌ له‌سه‌رووی هه‌مووانه‌، <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />ئه‌و شایه‌تی ئه‌وه‌ ده‌دات كه‌ بینیویه‌تیو بیستوویه‌تی، به‌ڵام كه‌س شایه‌تیه‌كه‌ی وه‌رناگرێ‌! <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />ئه‌وه‌ی شایه‌تیه‌كه‌ی وه‌رده‌گرێ‌، ده‌یسه‌لمێنێ‌ كه‌وا خودا ڕاسته‌، <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />چونكه‌ ئه‌وه‌ی خودا ناردوویه‌تی به‌‏ووشه‌ی خودا ده‌دوێ‌، له‌به‌رئه‌وه‌ی خودا به‌پێوانه‌ ڕۆح نادات. <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" />باوك ڕۆڵه‌ی خۆی خۆش‎ده‌وێ، هه‌موو شتێكی خستوته‌ ژێر ده‌ستی. <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />ئه‌وه‌ی باوه‌ڕ به‌‏ڕۆڵه‌كه‌ بهێنێ‌، ژیانی هه‌تاهه‌تایی هه‌یه‌. ئه‌وه‌ش كه‌ گوێڕایه‌ڵی ڕۆڵه‌كه‌ نابێ‌ ژیان نابینێت، به‌ڵكو تووڕه‌یی خودای به‌سه‌ردا ده‌چه‌سپێ‌.<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s1">ژنێكی سامری</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />فه‌ریسیه‌كان بیستیان كه‌ عیسا قوتابی زۆری هه‌یه‌و ‏له‌یه‌حیا زیاتر خه‌ڵكی له‌ئاوهه‌ڵده‌كێشێ‌، <verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />هه‌رچه‌نده‌ خۆی خه‌ڵكی له‌ئاوهه‌ڵنه‌ده‌كێشا به‌ڵكو قوتابیه‌كانی. <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />كاتێ‌ عیسا به‌مه‌ی زانی ناوچه‌ی یه‌هودیه‌ی به‌جێ‌‏هێشت‏و گه‌ڕایه‌وه‌ بۆ ناوچه‌ی جه‌لیل. <verse eid="JHN 4:3" /><verse number="4" style="v" sid="JHN 4:4" />‏ده‌بووایه‌ ‏به‌‏ناوچه‌ی سامیره‌دا* بڕۆشتایه‌، <verse eid="JHN 4:4" /><verse number="5" style="v" sid="JHN 4:5" />له‌وێ‌ گه‌یشته‌ شارێكی سامری پێیده‌وترا سوخار، نزیك بوو له‌و پارچه‌ زه‌وییه‌ی یاقوب به‌‏یوسفی كوڕی دابوو، <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />‏بیری یاقوبیش له‌وێ‌بوو. جا چونكه‌ عیسا ماندووی گه‌شته‌كه‌ بوو، كاتیش نزیكه‌ی دوانزه‌ی نیوه‌ڕۆ بوو، له‌سه‌ر قه‌راغی بیره‌كه‌ دانیشت. <verse eid="JHN 4:6" /><verse number="7" style="v" sid="JHN 4:7" />ژنێكی سامری هاته‌ سه‌ر بیره‌كه‌ بۆ ئه‌وه‌ی ئاو به‌رێ‌، عیسا پێی ووت: (هه‌ندێ‌ ئاوم بده‌رێ‌!) <verse eid="JHN 4:7" /><verse number="8" style="v" sid="JHN 4:8" />قوتابیه‌كانی چوو بوونه‌ ناو شار تا خواردن بكڕن. <verse eid="JHN 4:8" /><verse number="9" style="v" sid="JHN 4:9" />ئینجا ژنه‌ سامرییه‌كه‌ پێی ووت: (تۆ جووله‌كه‌یت‏و منیش سامری، چۆن داوای ئاوم لـێ‌ده‌كه‌یت؟) چونكه‌ جووله‌كه‌كان تێكه‌ڵی سامرییه‌كان نه‌ده‌بوون. <verse eid="JHN 4:9" /><verse number="10" style="v" sid="JHN 4:10" />عیساش به‌ژنه‌كه‌ی ووت: (ئه‌گه‌ر تۆ به‌خشینی خودا بزانیت‏و ئه‌وه‌ی پێت ده‌ڵێ‌ ئاوم بده‌رێ‌ بزانی كێیه‌، ئه‌وسا تۆ داوات لـێ‌ده‌كردو ئه‌ویش ئاوی ژیانی پێت‏ده‌دا‏!) <verse eid="JHN 4:10" /><verse number="11" style="v" sid="JHN 4:11" />ژنه‌كه‌ پێی ووت: (به‌ڵام گه‌وره‌م، تۆ هیچت پێ‌ نییه‌ بۆ ده‌رهێنانی ئاو و بیره‌كه‌ش قووڵه‌. ئیتر ئاوی ژیانت له‌كوێ‌ بوو؟ <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />ئایا تۆ له‌‏یاقوبی باوكمان گه‌وره‌تری كه‌ ئه‌م بیره‌ی بۆ به‌جێ‌هێشتووین، ئه‌وه‌ی خۆیو منداڵ‏و ئاژه‌ڵی لێیان خواردۆته‌وه‌؟) <verse eid="JHN 4:12" /><verse number="13" style="v" sid="JHN 4:13" />عیساش پێی ووت: (هه‌ر كه‌سێ‌ له‌م ئاوه‌ بخواته‌وه‌ دیسان تینووی ده‌بێته‌وه‌. <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />‏به‌ڵام ئه‌وه‌ی له‌و ئاوه‌ بخواته‌وه‌ كه‌ من ده‌یده‌مێ‌، هه‌رگیز تینووی نابێ‌، به‌ڵكو ئه‌و ئاوه‌ی من ده‌یده‌مێ‌ ده‌بێ‌ به‌كانییه‌ك، له‌ناخیدا هه‌ڵده‌قوڵی‏و ژیانی هه‌تاهه‌تایی پێ‌ده‌به‌خشێ‌.)</para>
  <para style="p" vid="JHN 4:14">‏ <verse eid="JHN 4:14" /><verse number="15" style="v" sid="JHN 4:15" />ئه‌وسا ژنه‌كه‌ پێی ووت: (گه‌وره‌م، ئه‌و ئاوه‌م بده‌رێ‌ تا‏تینووم نه‌بێ‌و جارێكیكه‌ نه‌گه‌ڕێمه‌وه‌ بۆ ئێره‌ ئاو به‌رم!) <verse eid="JHN 4:15" /><verse number="16" style="v" sid="JHN 4:16" />عیساش پێی ووت: (بڕۆ، مێرده‌كه‌ت بانگ‎بكه‌‏و بگه‌ڕێوه‌ بۆ ئێره‌.) <verse eid="JHN 4:16" /><verse number="17" style="v" sid="JHN 4:17" />ئه‌ویش وه‌ڵامی دایه‌وه‌: (مێردم نییه‌!) عیساش ووتی: (ڕاست ده‌كه‌ی كه‌ ده‌ڵێیت مێردم نییه‌. <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" />له‌ڕاستیدا تۆ پێنج مێردت هه‌بوو، ئه‌وه‌ی ئێستاش له‌گه‌ڵی ده‌ژی مێردت نییه‌. ئه‌مه‌شت به‌ڕاستی ووت!) <verse eid="JHN 4:18" /><verse number="19" style="v" sid="JHN 4:19" />ئینجا ژنه‌كه‌ پێی ووت: (گه‌وره‌م، من وای ده‌بینم تۆ پێغه‌مبه‌ری. <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />باوباپیرانمان خودایان له‌م شاخه‌دا په‌رستووه‌، به‌ڵام ئێوه‌ی جووله‌كه‌ ده‌ڵێن ده‌بێ‌ ته‌نها قودس مه‌ڵبه‌ندی خوداپه‌رستی بێ‌.) <verse eid="JHN 4:20" /><verse number="21" style="v" sid="JHN 4:21" />عیسا وه‌ڵامی دایه‌وه‌: (باوه‌ڕم پێ‌بكه‌ ئه‌ی ئافره‌ت، كاتێ‌ دێ‌ كه‌وا ئێوه‌ باوك نه‌له‌سه‌ر ئه‌م شاخه‌و نه‌له‌قودس ده‌په‌رستن. <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" />ئێوه‌ی سامری نازانن كێ‌ ده‌په‌رستن، به‌ڵام ئێمه‌ ده‌زانین كێ‌ ده‌په‌رستین چونكه‌ ڕزگاری له‌ جووله‌كه‌وه‌یه‌. <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />جا ئه‌و كاته‌ دێت كه‌وا ئێستایه‌، كاتێ‌ خواپه‌رسته‌ ڕاسته‌كان باوك به‌‏ڕۆح‏و به‌ڕاستی ده‌په‌رستن، چونكه‌ خودا ئه‌و جۆره‌ خواپه‌رستانه‌ی ده‌وێ‌. <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />خودا ڕۆحه‌، ئیتر له‌به‌رئه‌وه‌ ده‌بێ‌ ئه‌وانه‌ی ده‌یپه‌رستن به‌‏ڕۆح‏و به‌ڕاستی بیپه‌رستن.) <verse eid="JHN 4:24" /><verse number="25" style="v" sid="JHN 4:25" />ژنه‌كه‌ پێی ووت: (من ده‌زانم مه‌سیح (واته‌ ده‌ست‏نیشانكراو) دێت، هه‌ر كاتێ‌ ئه‌و هات هه‌موو شتێكمان بۆ ڕوون‏ده‌كاته‌وه‌.) <verse eid="JHN 4:25" /><verse number="26" style="v" sid="JHN 4:26" />عیسا وه‌ڵامی دایه‌وه‌: (من ئه‌وم، ئه‌وه‌ی قسه‌ت له‌گه‌ڵ ده‌كات!).</para>
  <para style="p" vid="JHN 4:26">‏ <verse eid="JHN 4:26" /><verse number="27" style="v" sid="JHN 4:27" />له‌وكاته‌دا قوتابیه‌كان گه‌یشتن، سه‌ریان‏سوڕما كاتێ‌ بینییان قسه‌ له‌گه‌ڵ ئه‌و ژنه‌ ده‌كات. له‌گه‌ڵ ئه‌وه‌ش كه‌سیان پێیان نه‌ووت: (چیت لێی ده‌وێ‌؟ یاخود بۆچی گفتوگۆی له‌گه‌ڵ ده‌كه‌یت؟ ( <verse eid="JHN 4:27" /><verse number="28" style="v" sid="JHN 4:28" />ئینجا ژنه‌كه‌ گۆزه‌كه‌ی به‌جێ‌هێشت‏و گه‌ڕایه‌وه‌ ناو شار، به‌خه‌ڵكه‌كه‌ی ووت: <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />(وه‌رن، ئه‌و پیاوه‌ ببینن هه‌ر چیه‌كم‏كردووه‌ پێیووتم! ڕه‌نگه‌ ئه‌و مه‌سیح بێ‌؟) <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />ئیتر دانیشتوانی سوخار هاتنه‌ده‌ره‌وه‌‏و به‌ره‌و لای چوون.</para>
  <para style="p" vid="JHN 4:30">‏ <verse eid="JHN 4:30" /><verse number="31" style="v" sid="JHN 4:31" />له‌وكاته‌دا قوتابیه‌كانی زۆریان لێ‌ده‌كردو پێیان ده‌ووت: (مامۆستا، شتێ‌ بخۆ.) <verse eid="JHN 4:31" /><verse number="32" style="v" sid="JHN 4:32" />به‌ڵام ئه‌و وه‌ڵامی دانه‌وه‌: (من خواردنێكم هه‌یه‌ ده‌یخۆم كه‌ ئێوه‌ نایزانن.) <verse eid="JHN 4:32" /><verse number="33" style="v" sid="JHN 4:33" />قوتابیه‌كانی له‌‏نێوان خۆیاندا ده‌ستیان‎كرد به‌پرسیاركردن: (ئایا كه‌س خواردنی بۆ هێناوه‌؟) <verse eid="JHN 4:33" /><verse number="34" style="v" sid="JHN 4:34" />عیساش پێی ووتن: (خواردنی من ئه‌وه‌یه‌ ‏خواستی ئه‌وه‌ به‌ئه‌نجام بگه‌ێنم كه‌ ناردوومیو كاروباره‌كانی جێ‌ به‌جێ‌ بكه‌م. <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" />ئه‌ی خۆتان ناڵێن: (پاش چوار مانگ كاتی دروێنه‌ دێ‌!‏) به‌ڵام من پێتان ده‌ڵێم: چاوتان بكه‌نه‌وه‌و سه‌یری كێڵگه‌كان بكه‌ن، ئه‌وه‌تا پێ‌گه‌یشتوون‏و كاتی دروێنه‌یان هاتووه‌. <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" />دروێنه‌كه‌ریش كرێی خۆی وه‌رده‌گرێ‌، به‌رووبووم كۆ‏ده‌كاته‌وه‌ بۆ ژیانی هه‌تاهه‌تایی، ئه‌وسا چێنه‌رو دروێنه‌كه‌ر به‌یه‌كه‌وه‌ دڵشاد ده‌بن، <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" />‏ئینجا ئه‌و ووته‌یه‌ ڕاسته‌ كه‌ ده‌ڵێ‌: (یه‌كێ‌ ده‌چێنێ‌و ئه‌ویكه‌ش دروێنه‌ ده‌كات.) <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" />من ئێوه‌م ناردووه‌ بۆ دروێنه‌یه‌ك كه‌ پێوه‌ی ماندوو نه‌بوون، كه‌سانیتر پێوه‌ی ماندوو‏بوون‏و ئێوه‌ به‌ری ماندووبوونه‌كه‌یان ده‌خۆن.)</para>
  <para style="p" vid="JHN 4:38">‏ <verse eid="JHN 4:38" /><verse number="39" style="v" sid="JHN 4:39" />ژماره‌یه‌كی زۆر له‌ سامریه‌كانی دانیشتووی ئه‌و شاره‌ باوه‌ڕیان به‌‏عیسا هێنا به‌هۆی قسه‌ی ئه‌و ژنه‌وه‌ كه‌ ووتی: (هه‌رچیه‌كم كردبوو هه‌مووی پێ‌ووتم.) <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />كاتێ‌ سامریه‌كان هاتن بۆ لای، داوایان لـێ‌كرد لایان بمێنێته‌وه‌، ئه‌ویش له‌وێ‌ دوو ڕۆژ مایه‌وه‌، <verse eid="JHN 4:40" /><verse number="41" style="v" sid="JHN 4:41" />به‌هۆی ووشه‌كانیه‌وه‌ ژماره‌ی ئه‌وانه‌ی باوه‌ڕیان پێ‌هێنا زۆر زیادی كرد، <verse eid="JHN 4:41" /><verse number="42" style="v" sid="JHN 4:42" />ئه‌وسا خه‌ڵكه‌كه‌ به‌‏ژنه‌كه‌یان ووت: (له‌‏ئێستا به‌دواوه‌ ئیتر ئێمه‌ ‏به‌هۆی قسه‌ی تۆوه‌ باوه‌ڕ ناكه‌ین، به‌ڵكو باوه‌ڕ ده‌كه‌ین چونكه‌ خۆمان گوێمان‎ لێیبوو، زانیمان‏و بۆمان ده‌ركه‌وت، ئه‌و پیاوه‌ به‌ڕاستی ڕزگاركه‌ری جیهانه‌!)<verse eid="JHN 4:42" /></para>
  <para style="s1">چاكردنه‌وه‌ به‌ووشه‌</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />پاش دوو ڕۆژ ئه‌وێی به‌جێ‌هێشت‏و ڕۆیشته‌ جه‌لیل، <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" />چونكه‌ عیسا خۆی ووتبوی: (پێغه‌مبه‌ر ‏له‌‏ووڵاتی خۆیدا ڕێزی لێ‌ناگیرێ‌!) <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" />كاتێ‌ عیسا گه‌یشته‌ ناوچه‌ی جه‌لیل دانیشتوانی پێشوازیان لـێ‌كرد، هه‌رچیه‌كی كردبوو له‌‏قودس له‌‏جه‌ژنی تێپه‌ڕبوون بینیبوویان، چونكه‌ ئه‌وانیش له‌وێ‌ بوون.<verse eid="JHN 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46" />‏جارێكیكه‌ سه‌ردانی شاری قانای ‏ناوچه‌ی جه‌لیلیكرد، ئه‌و شوێنه‌ی تیایدا ئاوی كرد به‌‏شه‌راب، له‌‏شاری كه‌فه‌رناحوم پیاوێك له‌‏ده‌ست‏وپێوه‌ندی پادشا، كوڕێكی نه‌خۆشی هه‌بوو. <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />كاتێ‌ پیاوه‌كه‌ بیستی عیسا ناوچه‌ی یه‌هودیه‌ی به‌جێ‌‏هێشتووه‌و هاتووه‌ بۆ ناوچه‌ی جه‌لیل، هاته‌ لایو لێی پاڕایه‌وه‌ له‌گه‌ڵی بچێت بۆ ئه‌وه‌ی كوڕه‌كه‌ی كه‌ له‌سه‌ره‌مه‌رگدا بوو چاك ‎بكاته‌وه‌. <verse eid="JHN 4:47" /><verse number="48" style="v" sid="JHN 4:48" />ئینجا عیسا ووتی: (باوه‌ڕ ناكه‌ن هه‌تا ئایه‌ت‏و نیشانه‌ی سه‌رسوڕهێنه‌ر نه‌بینن!) <verse eid="JHN 4:48" /><verse number="49" style="v" sid="JHN 4:49" />لێره‌دا پیاوه‌كه‌ ‏ووتی: (گه‌وره‌م، وه‌ره‌ له‌گه‌ڵم پێش ئه‌وه‌ی كوڕه‌كه‌م بمرێ‌!) <verse eid="JHN 4:49" /><verse number="50" style="v" sid="JHN 4:50" />عیسا له‌‏وه‌ڵامدا ووتی: (بڕۆ! كوڕه‌كه‌ت زیندووه‌!) پیاوه‌كه‌ باوه‌ڕی به‌ووشه‌كانی كردو ئه‌وێی به‌جێ‌هێشت. <verse eid="JHN 4:50" /><verse number="51" style="v" sid="JHN 4:51" />كاتێ‌ پیاوه‌‏كه‌ به‌ڕێگاوه‌ بوو هه‌ندێ‌ له‌كۆیله‌كانی تووش بوو، مژده‌یان دایه‌ كه‌ كوڕه‌كه‌ی زیندووه‌، <verse eid="JHN 4:51" /><verse number="52" style="v" sid="JHN 4:52" />ئه‌ویش لێیپرسین له‌‏چ كاتێكدا چاك بووه‌وه‌، له‌وه‌ڵامدا ووتیان: (دوێنێ‌ له‌ كاژێری یه‌كی دوای نیوه‌ڕۆ تایه‌كه‌ به‌ریدا.( <verse eid="JHN 4:52" /><verse number="53" style="v" sid="JHN 4:53" />به‌مه‌ باوكه‌كه‌ زانی ئه‌و كاژێره‌ ئه‌و‏كاته‌ بوو كه‌ عیسا پێی ووت كوڕه‌كه‌ت زیندووه‌. ‏ئه‌وسا خۆیو خاوخێزانی هه‌موو باوه‌ڕیان هێنا. <verse eid="JHN 4:53" /><verse number="54" style="v" sid="JHN 4:54" />ئه‌م نیشانه‌ سه‌رسوڕهێنه‌ره‌ نیشانه‌ی دووه‌م بوو عیسا كردی دوای ئه‌وه‌ی ناوچه‌ی یه‌هودیه‌ی به‌جێ‌هێشت‏و به‌ره‌و ناوچه‌ی جه‌لیل ڕۆیشت.<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s1">چا‎كردنه‌وه‌ له‌رۆژی شه‌ممه‌</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />دوای ئه‌وه‌ له‌كاتی جه‌ژنێكی جووله‌كه‌ عیسا چوو بۆ قودس‏، <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />له‌نزیك ده‌روازه‌ی مه‌ڕ حه‌وزێك هه‌بوو به‌عیبری پێیان ده‌ووت به‌یتی حه‌سدا، له‌ده‌ورو پشتی پێنج هۆڵی لـێ‌بوو. <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />له‌وێدا ژماره‌یه‌كی زۆر نه‌خۆش كه‌وتبوون له‌‏كوێرو شه‌ل‏و گۆج‏، [چاوه‌ڕێیان ده‌كرد ئاوی حه‌وزه‌كه‌ بشڵه‌قێ‌، <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />چونكه‌ فریشته‌یه‌ك جار جاره‌ ده‌هات بۆ حه‌وزه‌كه‌و ئاوه‌كه‌ی ده‌شڵه‌قاند، جا ئه‌وه‌ی یه‌كه‌م كه‌س بچووبایه‌ ناو حه‌وزه‌كه‌، چاك ده‌بووه‌وه‌ جۆری نه‌خۆشیه‌كه‌ی هه‌رچیه‌ك بووایه‌.] <verse eid="JHN 5:4" /><verse number="5" style="v" sid="JHN 5:5" />كابرایه‌ك له‌وێ‌ بوو ماوه‌ی سیوهه‌شت ساڵ بوو نه‌خۆش بوو. <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />كاتێ‌ عیسا كابرای بینی له‌وێدا پاڵ‎كه‌وتووه‌، زانی ماوه‌یه‌كی دوورو درێژی به‌م جۆره‌ به‌سه‌ربردووه‌، لێیپرسی: (ده‌ته‌وێ‌ چاك‎ببیته‌وه‌؟) <verse eid="JHN 5:6" /><verse number="7" style="v" sid="JHN 5:7" />كابرای نه‌خۆش وه‌ڵامی دایه‌وه‌: (گه‌وره‌م، كه‌سم نییه‌ یارمه‌تیم‏بدات‏و بمخاته‌ ناو حه‌وزه‌كه‌ كاتێ‌ ئاوه‌كه‌ ده‌شڵه‌قێ‌. كاتێ‌ هه‌وڵده‌ده‌م بچمه‌ ناویه‌وه‌ یه‌كێكیتر پێشم ده‌كه‌وێ‌و ده‌چێته‌ ناو ئاوه‌كه‌.) <verse eid="JHN 5:7" /><verse number="8" style="v" sid="JHN 5:8" />ئه‌وسا عیسا پێی ووت: (هه‌سته‌! نوینه‌كه‌ت هه‌ڵگره‌‏و بڕۆ!) <verse eid="JHN 5:8" /><verse number="9" style="v" sid="JHN 5:9" />ده‌ست‏به‌جێ‌ كابرا چاك بووه‌وه‌و نوێنه‌كه‌ی هه‌ڵگرت‏و ڕۆیشت. ئه‌و ڕۆژه‌ش شه‌ممه‌‏بوو.<verse eid="JHN 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 5:10" />بۆیه‌ ده‌سه‌ڵاتدارانی جووله‌كه‌ به‌‏كابرای چاك‎بوویان ووت: (ئه‌مڕۆ شه‌ممه‌یه‌. ناشێ‌ نوینه‌كه‌ت هه‌ڵگری!) <verse eid="JHN 5:10" /><verse number="11" style="v" sid="JHN 5:11" />كابراش وه‌ڵامی دانه‌وه‌: (ئه‌وه‌ی چاكی كردمه‌وه‌ پێیووتم: (نوێنه‌كه‌ت هه‌ڵگره‌و بڕۆ!)) <verse eid="JHN 5:11" /><verse number="12" style="v" sid="JHN 5:12" />ئه‌وانیش لێیان پرسی: (كێ‌ پێی ووتی: نوینه‌كه‌ت هه‌ڵگره‌و بڕۆ؟) <verse eid="JHN 5:12" /><verse number="13" style="v" sid="JHN 5:13" />به‌ڵام كابرای كه‌ چاك‎بووه‌وه‌ نه‌یده‌زانی ئه‌و كێیه‌، چونكه‌ عیسا بێ‌ئه‌وه‌ی هه‌ستی پێ‌بكرێ‌ خۆی كێشایه‌وه‌ له‌و شوێنه‌ی خه‌ڵكه‌كه‌ی لـێ‌بوو. <verse eid="JHN 5:13" /><verse number="14" style="v" sid="JHN 5:14" />دوایئه‌وه‌ عیسا كابرای له‌په‌رستگادا بینی پێی ووت: (ئا ئه‌وه‌‏تا چاك‎بوویته‌وه‌. جارێكیكه‌ مه‌گه‌رێره‌وه‌ بۆ گوناه‌ تاوه‌كو شتی خراپترت به‌سه‌ر نه‌یه‌ت!) <verse eid="JHN 5:14" /><verse number="15" style="v" sid="JHN 5:15" />ئینجا كابرا ڕۆیشت‏و به‌جووله‌كه‌كانی ووت كه‌ عیسا چاكی كردۆته‌وه‌. <verse eid="JHN 5:15" /><verse number="16" style="v" sid="JHN 5:16" />ئیتر جووله‌كه‌كان ده‌ستیان‏كرد به‌‏چه‌وساندنه‌وه‌ی عیسا، چونكه‌ ئه‌و كارانه‌ی له‌‏ڕۆژی شه‌ممه‌دا ده‌كرد.<verse eid="JHN 5:16" /></para>
  <para style="s1">‏باوك‏و ڕۆڵه‌</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 5:17" />به‌ڵام عیسا پێی ووتن: (تاوه‌كو ئێستاش باوكم هه‌ر كارده‌كات، منیش هه‌روه‌ها كارده‌كه‌م!) <verse eid="JHN 5:17" /><verse number="18" style="v" sid="JHN 5:18" />جا له‌به‌رئه‌وه‌ هه‌وڵدانی جووله‌كه‌كان په‌ره‌یسه‌ند بۆ كوشتنی، ته‌نها له‌به‌رئه‌وه‌ نا كه‌ به‌رپێچی ڕۆژی شه‌ممه‌ی كرد بوو، به‌ڵكو له‌به‌رئه‌وه‌ی ووتی خودا باوكیه‌تی، به‌مه‌ش خۆی یه‌كسان ده‌كرد له‌گه‌ڵ خودا. <verse eid="JHN 5:18" /><verse number="19" style="v" sid="JHN 5:19" />عیسا پێی ووتن: (ڕاستی ڕاستیتان پێ‌ده‌ڵێم: ڕۆڵه‌ ناتوانێ‌ به‌ته‌نها له‌خۆیه‌وه‌ هیچ بكات، به‌ڵكو ده‌بینێ‌ باوكی چی ده‌كات ئه‌ویش ئه‌وه‌ ده‌كات. هه‌موو شتێ‌ كه‌ باوك ده‌یكات، ڕۆڵه‌ش هه‌مان شت ده‌كات. <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />چونكه‌ باوك ڕۆڵه‌ی خۆی خۆش‎ده‌وێ‌، هه‌رچیه‌ك ده‌كات نیشانیده‌دات، هه‌روه‌ها له‌م كاره‌ش گه‌وره‌تری نیشان‎ده‌دات، ئه‌وسا سه‌رسام ده‌بن. <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />هه‌روه‌ك چۆن باوك مردووان هه‌ڵده‌سێنێته‌وه‌و زیندوویان ده‌كاته‌وه‌، هه‌روه‌ها ڕۆڵه‌ش هه‌ركه‌سێكی بوێ‌ زیندووی ده‌كاته‌وه‌. <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />باوك حوكم به‌سه‌ر كه‌س نادات، به‌ڵكو هه‌موو ده‌سه‌ڵاتی حوكمدانی داوه‌ به‌ ڕۆڵه‌، <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />جا با هه‌موو ڕێزی ڕۆڵه‌ بگرن هه‌روه‌ك چۆن ڕێزی باوك ده‌گرن. هه‌ر كه‌سێكیش ڕێزی ڕۆڵه‌ نه‌گرێ‌ ڕێزی ئه‌و باوكه‌ ناگرێ‌ كه‌ ناردوویه‌تی.<verse eid="JHN 5:23" /></para>
  <para style="s1">له‌‏مردنه‌وه‌ به‌ره‌و ژیان</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24" />ڕاستی ڕاستیتان پێ‌ده‌ڵێم: ئه‌وه‌ی گوێ‌ له‌ووشه‌كه‌م بگرێ‌‏و باوه‌ڕبهێنێ‌ به‌وه‌ی ناردوومی ژیانی هه‌تاهه‌تایی ده‌بێ‌، له‌ڕۆژی دواییدا حوكم نادرێ‌ به‌سه‌ری، چونكه‌ ئه‌و له‌ مردنه‌وه‌ په‌ڕیوه‌ته‌وه‌ بۆ ژیان‏. <verse eid="JHN 5:24" /><verse number="25" style="v" sid="JHN 5:25" />ڕاستی ڕاستیتان پێ‌ده‌ڵێم: ئه‌و كاته‌ دێ‌‏و ئه‌وه‌تا ئێستا هاتووه‌، كه‌وا مردووان گوێیان له‌ ده‌نگی ڕۆڵه‌ی خودا ده‌بێ‌، ئینجا ئه‌وانه‌ی گوێیان لێی‏ده‌بێ‌ زیندووده‌بنه‌وه‌. <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />چونكه‌ هه‌روه‌ك باوك سه‌رچاوه‌ی ژیانه‌، به‌م جۆره‌ش به‌‏ڕۆڵه‌ی داوه‌ سه‌رچاوه‌ی ژیان بێ‌، <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />ده‌سه‌ڵاتی حوكم به‌سه‌ردانی داوه‌تێ‌ چونكه‌ ئه‌و ڕۆڵه‌ی مرۆڤه‌. <verse eid="JHN 5:27" /><verse number="28" style="v" sid="JHN 5:28" />سه‌رتان له‌مه‌ سوڕنه‌مێنێ‌: كاتێك دێ‌ هه‌موو ئه‌وانه‌ی له‌ناو گۆڕدان گوێیان له‌ده‌نگی ده‌بێ‌و <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" />‏دێنه‌ ده‌ره‌وه‌، جا ئه‌وانه‌ی كرداری چاكیان كردووه‌ به‌ره‌و هه‌ستانه‌وه‌ی ژیان ده‌ڕۆن، به‌ڵام ئه‌وانه‌ی كرداری خراپیان كردووه‌ به‌ره‌و هه‌ستانه‌وه‌ی حوكم به‌سه‌ردان.</para>
  <para style="p" vid="JHN 5:29">‏ <verse eid="JHN 5:29" /><verse number="30" style="v" sid="JHN 5:30" />من ناتوانم له‌‏خۆمه‌وه‌ هیچ بكه‌م، به‌ڵكو حوكم‏ده‌ده‌م به‌پێی ئه‌وه‌ی گوێم لـێ‌ده‌بێ‌، حوكم به‌سه‌ر‏دانه‌كه‌شم دادپه‌روه‌رانه‌یه‌، له‌به‌ر ئه‌وه‌ی هه‌وڵ ناده‌م خواستی خۆم بهێنمه‌دی، به‌ڵكو خواستی ئه‌وه‌ی كه‌ ناردوومی.<verse eid="JHN 5:30" /></para>
  <para style="s1">‏شایه‌تی‏ باوك بۆ ڕۆڵه‌ی خۆی</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31" />ئه‌گه‌ر خۆم شایه‌تی بۆخۆم بده‌م شایه‌تیه‌كه‌م ڕاست نییه‌، <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />به‌ڵام یه‌كێكیكه‌ شایه‌تیم بۆ ده‌دات، منیش ده‌زانم ئه‌و شایه‌تیه‌ی بۆ منی ده‌دات ڕاسته‌. <verse eid="JHN 5:32" /><verse number="33" style="v" sid="JHN 5:33" />ئێوه‌ نێرراوتان نارده‌ لای یه‌حیا ئه‌ویش شایه‌تی بۆ ڕاستیدا. <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />من ئه‌مه‌ ده‌ڵێم له‌به‌رئه‌وه‌ نییه‌ من پشت به‌شایه‌تی مرۆڤ ده‌به‌ستم، به‌ڵكو له‌‏پێناو ڕزگار‏بوونتانه‌. <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />یه‌حیا چرایه‌كی ڕووناكی هه‌ڵكراو بوو، حه‌زتان ده‌كرد ماوه‌یه‌ك چێژ له‌‏ڕووناكیه‌كه‌ی وه‌رگرن. <verse eid="JHN 5:35" /><verse number="36" style="v" sid="JHN 5:36" />به‌ڵام من شایه‌تیه‌كی مه‌زنترم هه‌یه‌ له‌وه‌ی یه‌حیا، ئه‌ویش شایه‌تی ئه‌و كارانه‌یه‌ كه‌ باوكم داوای لـێ‌كردووم ته‌واوی بكه‌م. جا ئه‌وه‌ی ده‌یكه‌م به‌‏ئاشكرا شایه‌تی بۆ من ده‌دا كه‌ باوك منی ناردووه‌، <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" />ئه‌و باوكه‌ی منی ناردووه‌ خۆشی شایه‌تی بۆ من ده‌دا.</para>
  <para style="p" vid="JHN 5:37">‏ئه‌وه‌ی ئێوه‌ هه‌رگیز ده‌نگیتان نه‌بیستووه‌، هه‌روه‌ها ڕواڵه‌تیتان نه‌بینیووه‌. <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />ئه‌وه‌ی ووشه‌كه‌ی له‌‏دڵتاندا نیشته‌جێ‌ نه‌بوو، چونكه‌ ئه‌وه‌تا ئێوه‌ باوه‌ڕناكه‌ن به‌وه‌ی ناردوویه‌تی. <verse eid="JHN 5:38" /><verse number="39" style="v" sid="JHN 5:39" />ئێوه‌ كتێب ده‌پشكنن چونكه‌ له‌و باوه‌ڕه‌دان به‌ره‌و ژیانی هه‌تاهه‌تاییتان ده‌بات. ئه‌و په‌رتووكانه‌ش شایه‌تیم بۆ ده‌ده‌ن. <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />به‌ڵام ئێوه‌ ناتانه‌وێ‌ بێن بۆ لای من تاكو ژیانتان هه‌بێ‌. <verse eid="JHN 5:40" /><verse number="41" style="v" sid="JHN 5:41" />من شكۆمه‌ندی له‌خه‌ڵك وه‌رناگرم. <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />به‌ڵام من ده‌تان‎ناسم، هه‌روه‌ها ده‌زانم خۆشه‌ویستی خودا له‌ ناوه‌رۆكتاندا نییه‌. <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />جا ئه‌وه‌تا من به‌ناوی باوكمه‌وه‌ هاتووم پێم ڕازی نین، به‌ڵام پێشوازی له‌وه‌ ده‌كه‌ن كه‌ به‌ناوی خۆیه‌وه‌ دێت. <verse eid="JHN 5:43" /><verse number="44" style="v" sid="JHN 5:44" />ئه‌گه‌ر ئێوه‌ شكۆمه‌ندی له‌‏یه‌كتری وه‌ربگرن‏و ئه‌و شكۆمه‌ندیه‌ی له‌تاكه‌ خوداوه‌یه‌ داوانه‌كه‌ن، ئیتر چۆن ده‌توانن باوه‌ڕبهێنن؟ <verse eid="JHN 5:44" /><verse number="45" style="v" sid="JHN 5:45" />له‌و باوه‌ڕه‌دا مه‌بن من شكاتتان لـێ‌بكه‌م لای باوك، له‌وێ‌ یه‌كێكیكه‌ هه‌یه‌ شكاتتان لـێ‌بكات، ئه‌ویش موسایه‌ كه‌ هیواتان پێیه‌تی‏. <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />ئه‌گه‌ر باوه‌ڕتان به‌‏موسا بكردایه‌، ئه‌وسا باوه‌ڕتان به‌‏منیش ده‌كرد، چونكه‌ ئه‌و له‌باره‌ی منه‌وه‌ نووسیویه‌تی. <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />كه‌واته‌ گه‌ر ئێوه‌ باوه‌ڕنه‌كه‌ن به‌وه‌ی موسا نووسیویه‌تی، ئیتر چۆن باوه‌ڕ به‌ قسه‌كانی من ده‌كه‌ن؟(<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s1">تێركردنی‏ پێنج ‏هه‌زار ‏كه‌س‏</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />دوای ئه‌مه‌ عیسا په‌ڕییه‌وه‌ ئه‌وبه‌ری ده‌ریاچه‌ی جه‌لیل كه‌ ده‌ریاچه‌ی ته‌به‌رییه‌، <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />ئینجا ژماره‌یه‌كی زۆر خه‌ڵكی دوای‏كه‌وتن‏، چونكه‌ نیشانه‌ی سه‌رسوڕهێنه‌ری چاك‎بوونه‌وه‌ی نه‌خۆشیان لـێ‌بینی. <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />‏عیساو قوتابیه‌كانیشی چوونه‌ سه‌ر شاخێك‏و له‌وێ‌ دانیشتن. <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />هه‌روه‌ها جه‌ژنی تێپه‌ڕبوونی جووله‌كه‌كانیش نزیك بوو. <verse eid="JHN 6:4" /><verse number="5" style="v" sid="JHN 6:5" />كاتێ‌ عیسا سه‌یری كردو بینی ژماره‌یه‌كی زۆر به‌ره‌و ڕووی دێن، به‌ فیلیپۆسی ووت: (له‌كوێ‌ نان بكڕین تا نانی ئه‌م هه‌مووه‌ بده‌ین؟‏) <verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />ئه‌مه‌ی ووت بۆئه‌وه‌ی تاقیكاته‌وه‌، چونكه‌ عیسا خۆی ده‌یزانی چی ده‌كات. <verse eid="JHN 6:6" /><verse number="7" style="v" sid="JHN 6:7" />فیلیپۆس وه‌ڵامی دایه‌وه‌: (گه‌ر ته‌نانه‌ت بایی دووسه‌د دیناریش‏* نان بكڕین، به‌شی ئه‌وه‌ ناكات هه‌ریه‌كه‌یان پارچه‌یه‌كی بچووكی به‌ركه‌وێ‌!) <verse eid="JHN 6:7" /><verse number="8" style="v" sid="JHN 6:8" />ئینجا ئه‌نده‌راوس، برای شه‌معون په‌ترۆس، كه‌ یه‌كێك بوو له‌ قوتابیه‌كانی پێی ووت: <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />(لێره‌ كوڕێك هه‌یه‌ پێنج نانی جۆو دوو ماسی پێیه‌. به‌ڵام ئه‌مه‌ چیه‌ بۆ ئه‌م كۆمه‌ڵه‌ گه‌وره‌یه‌؟) <verse eid="JHN 6:9" /><verse number="10" style="v" sid="JHN 6:10" />عیسا ووتی: (دایان‎بنیشێنن!) پیاوه‌كان كه‌ ژماره‌یان پێنج هه‌زار كه‌سێك ده‌بوو له‌وێدا سه‌وزه‌ گیایه‌كی زۆری لـێ‌بوو له‌سه‌ری دانیشتن. <verse eid="JHN 6:10" /><verse number="11" style="v" sid="JHN 6:11" />عیسا نانه‌كانی هه‌ڵگرت‏و سوپاسی خودای كرد، ئینجا ئه‌وه‌نده‌ی پێویستیان پێ‌بوو دابه‌شیكرد به‌سه‌ر دانیشتوان، هه‌مان شتیشی له‌ دوو ماسیه‌كه‌ كرد. <verse eid="JHN 6:11" /><verse number="12" style="v" sid="JHN 6:12" />كاتێ‌ تێربوون، به‌ قوتابیه‌كانی ووت: (ئه‌و له‌ته‌ نانانه‌ی ماوه‌ته‌وه‌ كۆیكه‌نه‌وه‌ تاكو هیچ شتێك به‌فیڕۆ نه‌ڕوات!) <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />ئه‌وانیش كۆیان‎كرده‌وه‌، ئینجا له‌پێنج نانه‌ جۆیه‌كه‌ دوانزه‌ سه‌به‌ته‌ له‌ته‌ نانی پاشماوه‌یان كۆكرده‌وه‌ له‌ نانخۆران. <verse eid="JHN 6:13" /><verse number="14" style="v" sid="JHN 6:14" />كاتێ‌ خه‌ڵكه‌كه‌ ئه‌و نیشانه‌ سه‌رسوڕهێنه‌ره‌یان بینی كه‌ عیسا كردی ووتیان: (به‌ڕاستی، ئه‌مه‌ ئه‌و پێغه‌مبه‌ره‌یه‌ بۆ جیهان هاتووه‌.) <verse eid="JHN 6:14" /><verse number="15" style="v" sid="JHN 6:15" />عیسا كه‌ زانی ئه‌وان خه‌ریكن بیڕفێنن‏و بیكه‌ن به‌ پادشا، به‌ته‌نها گه‌ڕایه‌وه‌ بۆسه‌ر شاخ.<verse eid="JHN 6:15" /></para>
  <para style="s1">عیسا به‌سه‌ر ئاودا ده‌ڕوات</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />كاتێ‌ ئێواره‌ داهات قوتابیه‌كانی هاتنه‌خواره‌وه‌ بۆ ده‌ریاچه‌كه‌، <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />سواری به‌له‌مێك بوون‏و به‌ره‌‏و شاری كه‌فه‌رناحوم كه‌ كه‌وتبووه‌ به‌ری ئه‌وبه‌ری ده‌ریاچه‌كه‌وه‌ كه‌وتنه‌ ڕێ‌. تاریكی داهات به‌ڵام عیسا هێشتا نه‌گه‌یشتبووه‌ لایان. <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />ئینجا ڕه‌شه‌بایه‌كی به‌هێز هه‌ڵیكرد، ئاوی ده‌ریاچه‌‏كه‌ی شڵه‌قاند. <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />دوای ئه‌وه‌ی قوتابیه‌كان نزیكه‌ی پێنج تا شه‌ش كیلۆمه‌تر سه‌وڵیان لـێ‌دا، عیسایان بینی نزیك‎ ده‌بێته‌وه‌ له‌‏به‌له‌مه‌كه‌یان‏و به‌سه‌ر ئاوی ده‌ریاچه‌كه‌دا ده‌ڕوا. ترسیان لێ‌نیشت. <verse eid="JHN 6:19" /><verse number="20" style="v" sid="JHN 6:20" />پێی ووتن‏: (منم، مه‌ترسن!) <verse eid="JHN 6:20" /><verse number="21" style="v" sid="JHN 6:21" />هه‌ر ئه‌وه‌نده‌ی داوایان لێ‌كرد سواری به‌له‌مه‌كه‌‏بێ‌، یه‌كسه‌ر به‌له‌مه‌كه‌ گه‌یشته‌ شوێنی مه‌به‌ست.<verse eid="JHN 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />بۆ به‌یانی، ئه‌و خه‌ڵكه‌ی له‌سه‌ر كه‌ناری ئه‌وبه‌ری ده‌ریاچه‌كه‌ مابوونه‌وه‌ ته‌نها یه‌ك به‌له‌میان بینی، به‌بیریشیان هاته‌وه‌ عیسا له‌گه‌ڵ قوتابیه‌كانی سواری به‌له‌مه‌كه‌ نه‌ببوو، به‌ڵكو قوتابیه‌كانی به‌ته‌نها سوارببوون. <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />ئیتر چه‌ند به‌له‌مێكیكه‌ له‌شاری ته‌به‌ریه‌وه‌ هاتن، له‌نزیك ئه‌و شوێنه‌ له‌نگه‌ریان گرت كه‌ ئه‌و نانه‌یان تیادا خواردبوو پاش ئه‌وه‌ی خوداوه‌ند سوپاسی خودای له‌سه‌ركردبوو‏. <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />كاتێ‌ خه‌ڵكه‌كه‌ عیساو قوتابیه‌كانیان له‌وێ‌ نه‌بینی، سواری ئه‌و به‌له‌مانه‌ بوون‏و چوون بۆ كه‌فه‌رناحوم تا به‌‏شوێن عیسا بگه‌ڕێن‏.</para>
  <para style="s1" vid="JHN 6:24">من نانی ژیانم</para>
  <para style="p" vid="JHN 6:24">‏ <verse eid="JHN 6:24" /><verse number="25" style="v" sid="JHN 6:25" />جا كاتێ‌ له‌به‌ری ئه‌وبه‌ری ده‌ریاچه‌كه‌وه‌ دۆزییانه‌وه‌، پێیان ووت: (مامۆستا، كه‌ی گه‌یشتیته‌ ئێره‌؟) <verse eid="JHN 6:25" /><verse number="26" style="v" sid="JHN 6:26" />عیساش له‌وه‌ڵامدا ووتی: (ڕاستی ڕاستیتان پێ‌ده‌ڵێم: ئێوه‌ به‌دوامدا ده‌گه‌رێن له‌به‌رئه‌وه‌نا كه‌ نیشانه‌ی سه‌رسوڕهێنه‌رتان بینی، به‌ڵكو له‌به‌رئه‌وه‌ی له‌‏نانه‌كه‌تان خوارد‏و تێر‏بوون. <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />له‌پێناوی خۆراكی له‌ناوچوو ئیش مه‌كه‌ن‏، به‌ڵكو له‌پێناو ئه‌و خۆراكه‌ی ده‌مێنێته‌وه‌ بۆ ژیانی هه‌تاهه‌تایی، ئه‌وه‌ی ڕۆڵه‌ی مرۆڤ ده‌تان‎داتێ‌، چونكه‌ ڕۆڵه‌ مۆری خودای باوكی پێوه‌یه‌.) <verse eid="JHN 6:27" /><verse number="28" style="v" sid="JHN 6:28" />لێره‌ پێیان ووت: (ده‌بێ‌ ئێمه‌ چی بكه‌ین، تاكو كاره‌كانی خودا بكه‌ین؟) <verse eid="JHN 6:28" /><verse number="29" style="v" sid="JHN 6:29" />ئه‌ویش وه‌ڵامی دانه‌وه‌: (ئه‌مه‌یه‌ كاری خودا: باوه‌ڕبهێنن به‌وه‌ی ناردوویه‌تی‏.) <verse eid="JHN 6:29" /><verse number="30" style="v" sid="JHN 6:30" />ئه‌وسا پێیان ووت: (چ نیشانه‌یه‌كی سه‌رسوڕهێنه‌ر ده‌كه‌یت تا بیبینین‏و باوه‌ڕت پێ‌بكه‌ین؟ ده‌توانی چیبكه‌یت؟ <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />باوباپیرانمان مه‌نیان* خواردووه‌ له‌‏بیاباندا هه‌روه‌ك نووسراوه‌: [[‏ئه‌و له‌ ئاسمانه‌وه‌ نانی دانێ‌ تا بیخۆن]]!)<verse eid="JHN 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32" />عیسا پێیووتن: (ڕاستی ڕاستیتان پێ‌ده‌ڵێم: موسا نه‌بوو له‌‏ئاسمانه‌وه‌ نانی دانێ‌، به‌ڵكو باوكمه‌ نانی ڕاستیتان ده‌داتێ‌ له‌‏ئاسمانه‌وه‌. <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />چونكه‌ نانی خودا ئه‌وه‌یه‌ كه‌ له‌‏ئاسمانه‌وه‌ دابه‌زیوه‌و ژیان به‌جیهان ده‌به‌خشێ‌.) <verse eid="JHN 6:33" /><verse number="34" style="v" sid="JHN 6:34" />پێیان ووت: (گه‌وره‌، هه‌موو كاتێ‌ ئه‌و نانه‌مان بده‌رێ‌.) <verse eid="JHN 6:34" /><verse number="35" style="v" sid="JHN 6:35" />عیسا وه‌ڵامی دانه‌وه‌: (من نانی ژیانم، ئه‌وه‌ی بێته‌ لام برسی نابێت، ئه‌وه‌ش باوه‌ڕم پێ‌بهێنێ‌ هه‌رگیز تینووی نابێ‌. <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" />به‌ڵام هه‌روه‌كو پێم‎ووتن ئێوه‌ منتان بینی كه‌چی باوه‌ڕناكه‌ن، <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />جا هه‌ركه‌سێك باوكم پێم‎ده‌به‌خشێ‌ بۆ لای من دێت، هه‌ركه‌سێكیش بێته‌ لای من، هه‌رگیز ده‌ری ناكه‌مه‌ ده‌ره‌وه‌. <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />چونكه‌ من له‌‏ئاسمانه‌وه‌ دابه‌زیوم، بۆ ئه‌وه‌ نا خواستی خۆم بهێنمه‌دی، به‌ڵكو بۆئه‌وه‌ی خواستی ئه‌وه‌ بهێنمه‌دی كه‌ ناردوومی. <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />ئه‌مه‌ش خواستی ئه‌وه‌یه‌ كه‌ منی ناردووه‌: كه‌س نییه‌ له‌وانه‌ی داویه‌تیه‌ من له‌ناوبچێ‌، به‌ڵكو له‌ڕۆژی دواییدا زیندووی ده‌كه‌مه‌وه‌. <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />چونكه‌ خواستی باوكم ئه‌مه‌یه‌: هه‌ر كه‌سێ‌ ڕۆڵه‌ ببینێ‌و باوه‌ڕی پیبهێنێ‌، ژیانی هه‌تاهه‌تایی ده‌بێ‌، له‌ڕۆژی دواییشدا زیندووی ده‌كه‌مه‌وه‌.)‏<verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />جووله‌كه‌كان ده‌ستیان‎كرد به‌ ناڕه‌زایی ده‌ربڕین به‌رامبه‌ر به‌‏عیسا چونكه‌ ده‌یووت: (من ئه‌و نانه‌م له‌‏ئاسمانه‌وه‌ هاتۆته‌ خواره‌وه‌.) <verse eid="JHN 6:41" /><verse number="42" style="v" sid="JHN 6:42" />ووتیان: (ئه‌مه‌ عیسای كوڕی یوسف نییه‌ كه‌ ئێمه‌ دایك‏و باوكی ده‌ناسین؟ ئێستا چۆن ده‌ڵێ‌ من له‌ ئاسمانه‌وه‌ هاتوومه‌ته‌ خواره‌وه‌؟)<verse eid="JHN 6:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43" />عیساش وه‌ڵامی دانه‌وه‌: (له‌ناو خۆتاندا بۆڵه‌‏بۆڵ مه‌كه‌ن! <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />هیچ كه‌سێ‌ ناتوانێ‌ بێته‌ لای من گه‌ر باوك ئه‌وه‌ی منی ناردووه‌ ڕاینه‌كێشێ‌، منیش له‌ڕۆژی دواییدا زیندووی ده‌كه‌مه‌وه‌. <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />له‌‏په‌رتووكی پێغه‌مبه‌راندا نووسراوه‌: [[هه‌موو له‌خوداوه‌ فێرده‌بن]]، ئیتر هه‌ركه‌سێ‌ گوێ‌ له‌باوك بگرێ‌و لێوه‌ی فێرببێ‌ بۆ لای من دێت‏. <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" />ئه‌مه‌ش مانای ئه‌وه‌ نییه‌ یه‌كێك هه‌بێ‌ باوكی بینیبێ‌ ته‌نها ئه‌وه‌ی كه‌ له‌خوداوه‌یه‌ ئه‌و باوكی بینیوه‌.<verse eid="JHN 6:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 6:47" />(ڕاستی ڕاستیتان پێ‌ده‌ڵێم: ئه‌وه‌ی باوه‌ڕ بهێنێ‌ ژیانی هه‌تاهه‌تایی هه‌یه‌. <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />من نانی ژیانم. <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />باوباپیرانتان ‏له‌‏بیاباندا مه‌نیان خوارد له‌گه‌ڵ ئه‌وه‌ش مردن، <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />به‌ڵام ئه‌وه‌تا ئه‌و نانه‌ی له‌ئاسمان هاتۆته‌ خواره‌وه‌، ئه‌وه‌ی هه‌ر مرۆڤێ‌ لێی بخوات نامرێ‌. <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />من ئه‌و نانه‌ زیندووه‌م له‌‏ئاسمانه‌وه‌ هاتۆته‌ خواره‌وه‌. ئه‌وه‌ی له‌م نانه‌ بخوا تاهه‌تایه‌ ده‌ژی. ئه‌و نانه‌ش كه‌ من ده‌یده‌م ‏ئه‌وه‌ له‌شمه‌، ده‌یبه‌خشم له‌پێناوی ژیانی جیهاندا.( <verse eid="JHN 6:51" /><verse number="52" style="v" sid="JHN 6:52" />ئه‌م قسانه‌ بووه‌ هۆی ده‌مه‌قاڵه‌یه‌كی توندو ڕه‌ق له‌نێوان جووله‌كه‌كاندا، ئینجا پرسیاریان‎كرد: (چۆن ئه‌مه‌ ده‌توانێ‌ له‌شی خۆیمان بداتێ‌ تا بیخۆین؟) <verse eid="JHN 6:52" /><verse number="53" style="v" sid="JHN 6:53" />عیسا وه‌ڵامی دانه‌وه‌: (ڕاستی ڕاستیتان پێ‌ده‌ڵێم: ئه‌گه‌ر له‌ له‌شی ڕۆڵه‌ی مرۆڤ نه‌خۆن‏و له‌‏خوێنی نه‌خۆنه‌وه‌، ژیان له‌ ئێوه‌دا نییه‌. <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" />به‌ڵام ئه‌وه‌ی له‌شم بخوات‏و خوێنم بخواته‌وه‌، ژیانی هه‌تاهه‌تایی ده‌بێ‌، هه‌روه‌ها له‌ ڕۆژی دواییدا زیندووی ده‌كه‌مه‌وه‌، <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />چونكه‌ له‌شم خۆراكی ڕاسته‌قینه‌یه‌و خوێنیشم خواردنه‌وه‌ی ڕاسته‌قینه‌یه‌. <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />دیسان هه‌ر كه‌سێ‌ له‌ له‌شم بخوات و له‌‏خوێنم بخواته‌وه‌ له‌ مندا جێگیرده‌بێ‌و منیش له‌ئه‌ودا. <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />چۆن باوكی زیندووم منی ناردووه‌و من زیندووم به‌و باوكه‌‏، هه‌مان‎شت به‌هۆی منه‌وه‌ ئه‌وه‌ی له‌ له‌شم ده‌خوات زیندووده‌بێ‌. <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />جا ئه‌مه‌ ئه‌و نانه‌یه‌ له‌ئاسمان هاته‌خواره‌وه‌، ئه‌مه‌ش وه‌كو ئه‌و مه‌نه‌ نییه‌ كه‌ باوباپیرانتان خواردیان‏و مردن. ئه‌وه‌ی له‌م نانه‌ بخوات تاهه‌تایه‌ ده‌ژی.(<verse eid="JHN 6:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 6:59" />عیسا ئه‌مانه‌ی هه‌موو له‌كه‌نیشتدا ووت، كاتێ‌ له‌‏شاری كه‌فه‌رناحوم خه‌ڵكه‌كه‌ی فێرده‌كرد.<verse eid="JHN 6:59" /></para>
  <para style="s1">قوتابیه‌كان گومان ده‌كه‌ن</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />زۆر له‌‏قوتابیه‌كانی كه‌ گوێیان له‌مه‌ بوو ووتیان: (ئه‌م قسانه‌ چه‌ند گرانه‌! كێ‌ ده‌توانێ‌ گوێی لـێ‌بگرێ‌؟) <verse eid="JHN 6:60" /><verse number="61" style="v" sid="JHN 6:61" />عیسا هه‌ستیكرد قوتابیه‌كانی به‌هۆی ئه‌مه‌‏وه‌ بۆڵه‌بۆڵ ده‌كه‌ن، ئه‌وسا لێیپرسین: (ئایا ئه‌مه‌ ده‌تان‎خاته‌ گومانه‌وه‌؟ <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />ئه‌ی ئه‌گه‌ر ببینن ڕۆڵه‌ی مرۆڤ به‌رزبكرێته‌وه‌ بۆ ئه‌و شوێنه‌ی له‌پێشا لێیبوو؟ <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />ڕۆح ژیان ده‌دات، به‌ڵام له‌ش به‌كه‌ڵكی هیچ نایه‌ت. ئه‌و ووشانه‌ی كه‌ پێم‎ووتن ئه‌وانه‌ ڕۆح‏و ژیانن. <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />به‌ڵام هه‌ندێكتان باوه‌ڕناكه‌ن!) عیسا له‌سه‌ره‌تاوه‌ ده‌یزانی‏كێن ئه‌وانه‌ی باوه‌ڕی پێ‌ناكه‌ن، هه‌روه‌ها كێیه‌ ئه‌وه‌ی ده‌یدا به‌ده‌سته‌وه‌. <verse eid="JHN 6:64" /><verse number="65" style="v" sid="JHN 6:65" />ئینجا ووتی: (له‌به‌رئه‌وه‌ پێم ووتن كه‌س ناتوانێ‌ بێ‌ بۆ لای من، گه‌ر باوك ئه‌مه‌ی پێ‌نه‌به‌خشێ‌.(<verse eid="JHN 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66" />له‌وكاته‌دا زۆر له‌ قوتابیه‌كانی به‌جێیان‎ هێشت‏و ئیتر دوای نه‌كه‌وتن. <verse eid="JHN 6:66" /><verse number="67" style="v" sid="JHN 6:67" />ئه‌وسا عیسا به‌‏دوانزه‌ قوتابیه‌كه‌ی ووت: (ئێوه‌ش ده‌تانه‌وێ‌ وه‌ك ئه‌وان بڕۆن؟) <verse eid="JHN 6:67" /><verse number="68" style="v" sid="JHN 6:68" />‏شه‌معون په‌ترۆس وه‌ڵامی دایه‌وه‌: (‏گه‌وره‌م، بۆ لای كێ‌ بڕۆین؟ ووشه‌كانی ژیانی هه‌تاهه‌تایی لای تۆیه‌. <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />ئێمه‌ باوه‌ڕمان هێناوه‌و زانیومانه‌ تۆ پاك‏وپیرۆزی خودای!) <verse eid="JHN 6:69" /><verse number="70" style="v" sid="JHN 6:70" />ئینجا عیسا ووتی: (ئایا من ئێوه‌ی دوانزه‌م هه‌ڵنه‌بژاردووه‌؟ له‌گه‌ڵ ئه‌وه‌شدا یه‌كێ‌ له‌ناوتاندا شه‌یتانه‌!) <verse eid="JHN 6:70" /><verse number="71" style="v" sid="JHN 6:71" />لێره‌دا مه‌به‌ستی له‌یه‌هوزای كوڕی شه‌معونی ئه‌سخه‌ریوتی بوو، ئه‌وه‌ی لــه‌دواییدا ناپاكـی له‌گه‌ڵ كرد، هه‌رچه‌نده‌ یه‌كێ‌ بوو له‌‏دوانزه‌ قوتابیه‌كه‌ی.<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s1">ڕقی جیهان بۆ عیسا</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />دوای ئه‌وه‌ی عیسا ده‌ستیكرد به‌گه‌ڕان به‌ناوچه‌ی جه‌لیلدا، نه‌یویست به‌ناوچه‌ی یه‌هودیه‌دا بگه‌ڕێ‌، چونكه‌ ده‌سه‌ڵاتدارانی جووله‌كه‌ هه‌وڵی كوشتنیان ده‌دا. <verse eid="JHN 7:1" /><verse number="2" style="v" sid="JHN 7:2" />كاتێ‌ جه‌ژنی كه‌پره‌شینه‌ی* جووله‌كه‌كان نزیك بووه‌وه‌، <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />براكانی پێیان‎ووت: (ئه‌م ناوچه‌یه‌ به‌جێ‌بهێڵه‌و بڕۆ بۆ ناوچه‌ی یه‌هودیه‌ تاكو قوتابیه‌كانت كرداره‌كانت ببینن، <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />هیچ كه‌سێ‌ به‌نهێنی ئیش ناكات گه‌ر بیه‌وێ‌ ناوبانگ ده‌ركات. تۆ كه‌ ئه‌م شتانه‌ ده‌كه‌یت خۆت ده‌رخه‌ بۆ خه‌ڵكی.) <verse eid="JHN 7:4" /><verse number="5" style="v" sid="JHN 7:5" />هه‌رچه‌نده‌ براكانیشی خۆیان باوه‌ڕیان پێ‌نه‌ده‌كرد. <verse eid="JHN 7:5" /><verse number="6" style="v" sid="JHN 7:6" />عیسا له‌وه‌ڵامدا ووتی: (جارێ‌ كاتم نه‌هاتووه‌، به‌ڵام كاتی ئێوه‌ هه‌رده‌م گونجاوه‌. <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />جیهان ناتوانێ‌ ڕقی لێتان بێت، به‌ڵام ڕقی له‌‏من ده‌بێته‌وه‌، چونكه‌ من شایه‌تم به‌سه‌ریه‌وه‌ كه‌ كرده‌وه‌كانی خراپه‌. <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />ئێوه‌ خۆتان بۆ جه‌ژن بڕۆن بۆ ئه‌وێ‌، من نایه‌م بۆ ئه‌م جه‌ژنه‌. چونكه‌ هێشتا كاتی من نه‌هاتووه‌.) <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />عیسا ئه‌مه‌ی پێ‌ووتن‏و له‌ ناوچه‌ی جه‌لیل مایه‌وه‌.<verse eid="JHN 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />دوای ئه‌وه‌ی براكانی ڕۆیشتن بۆ جه‌ژنه‌كه‌، ئه‌ویش ڕۆیشت بۆ ئه‌وێ‌، به‌ڵام به‌نهێنی نه‌ك به‌‏ئاشكرا‏. <verse eid="JHN 7:10" /><verse number="11" style="v" sid="JHN 7:11" />ده‌سه‌ڵاتدارانی جووله‌كه‌ له‌‏جه‌ژنه‌كه‌دا به‌دوایدا ده‌گه‌ڕان‏و ده‌یان‏پرسی: (ئه‌و له‌‏كوێیه‌؟) <verse eid="JHN 7:11" /><verse number="12" style="v" sid="JHN 7:12" />ده‌رباره‌ی ئه‌و له‌ نێوان خه‌ڵكه‌كه‌دا چرپه‌چرپێكی زۆر هه‌بوو، هه‌ندێكیان ده‌یان‎ووت: ( پیاوێكی چاكه‌.) به‌ڵام هه‌ندێكیكه‌یان ده‌یان‎ووت: (نه‌خێر به‌ڵكو گه‌ل گومڕا ده‌كات.) <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />جا له‌‏ترسی ده‌سه‌ڵاتدارانی جووله‌كه‌ كه‌س به‌ئاشكرا باسی نه‌ده‌كرد‏.<verse eid="JHN 7:13" /></para>
  <para style="s1">بیروڕای جیاواز ده‌رباره‌ی عیسا</para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />كاتێ‌ نیوه‌ی جه‌ژن تێپه‌ڕی، عیسا چوو بۆ په‌رستگاو ده‌ستیكرد به‌ فێركردنی خه‌ڵكه‌كه‌. <verse eid="JHN 7:14" /><verse number="15" style="v" sid="JHN 7:15" />جووله‌كه‌كان سه‌رسام بوون‏و پرسییان: (چۆن له‌كتێب ده‌زانێت به‌بێ‌ ئه‌وه‌ی خوێندبێتی؟) <verse eid="JHN 7:15" /><verse number="16" style="v" sid="JHN 7:16" />عیسا له‌‏وه‌ڵامدا ووتی: (فێركردنه‌كانم هی خۆم نییه‌، به‌ڵكو هی ئه‌وه‌یه‌ كه‌ ناردوومی. <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />جا هه‌ر كه‌سێ‌ بیه‌وێ‌ به‌خواستی خودا كار بكات ده‌زانێ‌ ئاخۆ فێركردنه‌كانم له‌لایه‌ن خوداوه‌یه‌ یاخود له‌‏خۆمه‌وه‌ قسه‌ ده‌كه‌م. <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />ئه‌وه‌ی له‌‏خۆیه‌وه‌ قسه‌ بكات، داوای شكۆ‏مه‌ندی بۆ خۆی ده‌كات، به‌ڵام ئه‌وه‌ی داوای شكۆمه‌ندی بۆ ئه‌وه‌ بكات كه‌ ناردوویه‌تی، ئه‌و‏كه‌سه‌ ڕاسته‌و درۆی تیادانییه‌. <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" />ئایا موسا شه‌ریعه‌تی نه‌داونه‌تێ‌؟ به‌ڵام كه‌ستان له‌سه‌ری ناڕۆن! بۆچی هه‌وڵی كوشتنم ده‌ده‌ن؟) <verse eid="JHN 7:19" /><verse number="20" style="v" sid="JHN 7:20" />خه‌ڵكه‌كه‌ وه‌ڵامیان دایه‌وه‌: (رۆحی پیست تیادایه‌! كێ‌ ده‌یه‌وێ‌ بتكوژێ‌؟) <verse eid="JHN 7:20" /><verse number="21" style="v" sid="JHN 7:21" />عیسا پێی ووتن: (ته‌نها كارێكم كرد هه‌مووتان سه‌رتان‎سوڕما. <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />جا چونكه‌ موسا ڕای‏سپاردوون خه‌ته‌نه‌ بكه‌ن‏، هه‌رچه‌نده‌ ئه‌مه‌ش ناگه‌ڕێته‌وه‌ بۆ موسا به‌ڵكو بۆ باووباپیران، ته‌نانه‌ت له‌ڕۆژی شه‌ممه‌شدا بێت مرۆڤ خه‌ته‌نه‌ ده‌كه‌ن‏. <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" />گه‌ر هاتوو ئێوه‌ مرۆڤێكتان خه‌ته‌نه‌كرد له‌رۆژی شه‌ممه‌دا هه‌تا به‌رپێچی شه‌ریعه‌تی موسا نه‌كه‌ن، ئایا ده‌بێ‌ له‌من تووڕه‌بن چونكه‌ مرۆڤێكم به‌ ته‌واوی له‌‏رۆژی شه‌ممه‌دا چاك‎كردۆته‌وه‌؟ <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />به‌سه‌رزاری حوكم مه‌ده‌ن، به‌ڵكو حوكمێكی دادپه‌روه‌رانه‌ بده‌ن.) <verse eid="JHN 7:24" /><verse number="25" style="v" sid="JHN 7:25" />له‌وكاته‌دا هه‌ندێ‌ له‌‏دانیشتوانی شاری قودس ووتیان: (ئایا ئه‌مه‌ ئه‌وه‌ نییه‌ كه‌ ده‌یانه‌وێ‌ بیكوژن؟ <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />ئا ئه‌وه‌تا به‌‏ئاشكرا قسه‌ ده‌كات‏و كه‌سیش هیچی پێ‌ناڵێ‌. ئایا سه‌رۆكه‌كانمان دڵنیا بوونه‌ كه‌ ئه‌و به‌ڕاستی مه‌سیحه‌؟ <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />كاتێ‌ مه‌سیح دێ‌ كه‌س نازانێ‌ له‌كوێوه‌ هاتووه‌، به‌ڵام ‏ئێمه‌ ڕه‌گه‌زو بنه‌چه‌ی ئه‌مه‌ ده‌ناسین!) <verse eid="JHN 7:27" /><verse number="28" style="v" sid="JHN 7:28" />بۆیه‌ كاتێ‌ عیسا له‌‏په‌رستگادا خه‌ڵكی فێرده‌كرد، ده‌نگی به‌رزكرده‌وه‌و ووتی: (ئایا به‌ڕاستی ئێوه‌ من ده‌ناسن‏و ده‌زانن له‌كوێوه‌ هاتووم؟ من له‌‏خۆمه‌وه‌ نه‌هاتووم، جا ئه‌وه‌ی منی ناردووه‌ ئه‌و ڕاسته‌و ئێوه‌ نایناسن. <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />‏به‌ڵام من ئه‌و ده‌ناسم چونكه‌ من له‌وم‏و ئه‌ویش منی ناردووه‌.) <verse eid="JHN 7:29" /><verse number="30" style="v" sid="JHN 7:30" />ئه‌وسا جووله‌كه‌كان هه‌وڵی گرتنیان‎دا، به‌ڵام كه‌س ده‌ستی بۆ درێژ نه‌كرد، چونكه‌ هێشتا كاتی نه‌هاتبوو. <verse eid="JHN 7:30" /><verse number="31" style="v" sid="JHN 7:31" />لێره‌ ژماره‌یه‌كی زۆر له‌‏خه‌ڵكی باوه‌ڕیان پێ‌هێناو ووتیان: (كاتێ‌ مه‌سیح بێت، ئایا نیشانه‌ی سه‌رسوڕهێنه‌ری زیاتر ده‌كات له‌وه‌ی ئه‌م پیاوه‌ كردوویه‌تی؟)</para>
  <para style="p" vid="JHN 7:31">‏ <verse eid="JHN 7:31" /><verse number="32" style="v" sid="JHN 7:32" />فه‌ریسیه‌كان گوێیان لـێ‌بوو خه‌ڵكه‌كه‌ ده‌رباره‌ی عیسا چرپه‌چرپ ده‌كه‌ن له‌گه‌ڵ یه‌كتری، ئه‌وسا ئه‌وان‏و سه‌رۆك كاهینه‌كان چه‌ند پاسه‌وانێكیان نارد تابیگرن. <verse eid="JHN 7:32" /><verse number="33" style="v" sid="JHN 7:33" />عیسا ووتی: (من ته‌نها بۆ ماوه‌یه‌كی كه‌م له‌گه‌ڵتاندام، ئینجا ده‌گه‌رێمه‌وه‌ بۆ لای ئه‌وه‌ی ناردوومی. <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />ئه‌وكاته‌ به‌دوامدا ده‌گه‌ڕێن‏و نامدۆزنه‌وه‌، هه‌روه‌ها ناتوانن بێن بۆ ئه‌و شوێنه‌ی منی لێده‌بم.) <verse eid="JHN 7:34" /><verse number="35" style="v" sid="JHN 7:35" />ئیتر جووله‌كه‌كان له‌نێوان خۆیاندا پرسیاریان كرد: (نیازی كوێی هه‌یه‌ بۆی بڕوات‏و ئێمه‌ نایدۆزینه‌وه‌؟ ئایا بۆ ئه‌و شاره‌ یۆنانیانه‌ ده‌ڕوات كه‌ جووله‌كه‌كان تیایدا په‌رشوبڵاو بوونه‌ته‌وه‌، تاوه‌كو یۆنانیه‌كان فێربكات؟ <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />مه‌به‌ستی چیه‌ له‌وه‌ی كه‌ ده‌ڵێ‌: (ده‌گه‌ڕێن به‌دوام به‌ڵام نامدۆزنه‌وه‌، هه‌روه‌ها ناتوانن بێن بۆ ئه‌و شوێنه‌ی منی لێده‌بم؟)(<verse eid="JHN 7:36" /></para>
  <para style="s1">ڕووباری زیندوو</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />له‌دوا ڕۆژی جه‌ژندا‏، كه‌ گرنگترین ڕۆژی بوو، عیسا ڕاوه‌ستاو به‌‏ده‌نگی به‌رز ووتی: (گه‌ر یه‌كێ‌ تینووی بوو بابێته‌ لای من‏و بخواته‌وه‌. <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />ئه‌وه‌ی باوه‌ڕم پێ‌بهێنێ‌، له‌‏ناوه‌رۆكیدا ڕووباری ئاوی ژیان هه‌ڵده‌قوڵێ‌.) <verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />لێره‌ عیسا مه‌به‌ستی له‌رۆحی پیرۆز‏بوو، كه‌ ده‌درێ‌ به‌وانه‌ی باوه‌ڕی پێ‌ده‌هێنن، جا ئه‌و ڕۆحه‌ جارێ‌ نه‌درابوو چونكه‌ هێشتا عیسا شكۆدار نه‌ببوو.<verse eid="JHN 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />كاتێ‌ ئاماده‌بووان گوێیان له‌م ووشانه‌ بوو، هه‌ندێكیان ووتیان: (ئه‌مه‌ به‌راستی پێغه‌مبه‌ره‌كه‌یه‌!) <verse eid="JHN 7:40" /><verse number="41" style="v" sid="JHN 7:41" />هه‌روه‌ها هه‌ندێكیكه‌یان ووتیان: (ئه‌مه‌ مه‌سیحه‌.) به‌ڵام چه‌ند كه‌سێكیكه‌ ووتیان: (ئایا مه‌سیح له‌ناوچه‌ی جه‌لیله‌وه‌ ده‌رده‌كه‌وێ‌؟ <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />ئایا له‌كتێبدا باس نه‌كراوه‌ مه‌سیح له‌‏نه‌وه‌ی داود په‌یدا ده‌بێ‌‏، له‌‏دێی به‌یت‏له‌حم كه‌ داودی لـێ‌بووه‌؟) <verse eid="JHN 7:42" /><verse number="43" style="v" sid="JHN 7:43" />جا به‌هۆی ئه‌وه‌وه‌ دووبه‌ره‌كی له‌بیروڕا له‌نێوان خه‌ڵكه‌كه‌دا دروست بوو. <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />هه‌ندێكیان ویستیان بیگرن، به‌ڵام كه‌سیان ده‌ستیان بۆ نه‌برد. <verse eid="JHN 7:44" /><verse number="45" style="v" sid="JHN 7:45" />ئه‌وسا پاسه‌وانه‌كان گه‌ڕانه‌وه‌ لای فه‌ریسیه‌كان‏و سه‌رۆك كاهینه‌كان، ئه‌وانیش لێیان پرسین: (بۆچی نه‌تان هێنا؟) <verse eid="JHN 7:45" /><verse number="46" style="v" sid="JHN 7:46" />له‌‏وه‌ڵامدا ووتیان: (هه‌رگیز كه‌س وه‌ك ئه‌و قسه‌ی نه‌كردووه‌!) <verse eid="JHN 7:46" /><verse number="47" style="v" sid="JHN 7:47" />ئه‌وانیش پێیان ووتن: (ئایا ئێوه‌ش گومڕا بوون؟ <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />ئایا بینیوتانه‌ یه‌كێ‌ له‌‏سه‌رۆكه‌كان یاخود فه‌ریسیه‌كان باوه‌ڕی پێ‌بهێنن‏؟ <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />نه‌خێر! ته‌نها ئه‌و خه‌ڵكه‌ نه‌فره‌ت لێ‌كراوه‌ی له‌‏شه‌ریعه‌ت نازانن.) <verse eid="JHN 7:49" /><verse number="50" style="v" sid="JHN 7:50" />به‌ڵام یه‌كێ‌ له‌وان كه‌ ناوی نیقۆدیموس بوو، ئه‌وه‌ی به‌شه‌و بۆ لای عیسا هاتبوو، پێی ووتن: <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />‏(ئایا شه‌ریعه‌تی ئێمه‌ ڕێگا ده‌دات حـوكـم‎ بدرێ‌ به‌سه‌ر یه‌كێكدا بێ‌ئه‌وه‌ی یه‌كه‌مجار گوێ‌ له‌و كه‌سه‌ بگیرێ‌ تا بزانرێ‌ چیكردووه‌؟) <verse eid="JHN 7:51" /><verse number="52" style="v" sid="JHN 7:52" />ئه‌وانیش وه‌ڵامیان دایه‌وه‌: (ئایا تۆش له‌‏دانیشتوانی جه‌لیلی؟ كتێب بخوێنه‌وه‌ ئه‌وسا ده‌زانی هه‌رگیز له‌‏جه‌لیل پێغه‌مبه‌ر ده‌رناكه‌وێ‌!) [‏ <verse eid="JHN 7:52" /><verse number="53" style="v" sid="JHN 7:53" />ئیتر هه‌ر یه‌كه‌ ڕۆیشته‌وه‌ بۆ ماڵی خۆی.<verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="s1">ئافره‌تێكی داوێن‏پیس</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1" />به‌ڵام عیسا بۆ شاخی زه‌یتون ڕۆیشت. <verse eid="JHN 8:1" /><verse number="2" style="v" sid="JHN 8:2" />له‌به‌ره‌به‌یان گه‌ڕایه‌وه‌ بۆ په‌رستگا، خه‌ڵكێكی زۆر لێی كۆبوونه‌وه‌، ئه‌ویش دانیشت‏و ده‌ستیكرد به‌‏فێركردنیان. <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />مامۆستایانی شه‌ریعه‌ت‏و فه‌ریسیه‌كان ژنێكی داوێن پیسیان هێنایه‌ لایو له‌ناوه‌راست ڕایان‎گرت، <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />پێیان ووت: (مامۆستا ئه‌م ژنه‌ له‌كاتی داوێن‎پیسیدا گیراوه‌. <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />موسا له‌‏شه‌ریعه‌تدا ڕایسپاردوین ئه‌وانه‌ی وه‌ك ئه‌م ژنه‌ وان ده‌بێ‌ به‌ردباران بكرێن، تۆ چی ده‌ڵێی؟) <verse eid="JHN 8:5" /><verse number="6" style="v" sid="JHN 8:6" />ئه‌مه‌یان لـێ‌پرسی تا تاقی بكه‌نه‌وه‌و هۆیه‌ك بدۆزنه‌وه‌ بۆ ‏تاوانباركردن‏و دادگاییكردنی. به‌ڵام عیسا سه‌ری داگرت‏و ‏به‌په‌نجه‌ ده‌ستیكرد به‌نووسین له‌سه‌ر زه‌وی. <verse eid="JHN 8:6" /><verse number="7" style="v" sid="JHN 8:7" />كاتێ‌ ئه‌وان هه‌ر سوور بوون له‌سه‌ر پرسیاره‌كه‌یان، عیسا سه‌ریهه‌ڵبڕیو پێی ووتن: (كامتان بێ‌گوناهه‌ با یه‌كه‌م به‌ردی لێ‌بدات!) <verse eid="JHN 8:7" /><verse number="8" style="v" sid="JHN 8:8" />دیسان سه‌ری داگرته‌وه‌و ده‌ستیكرد به‌نووسین له‌سه‌ر زه‌وی. <verse eid="JHN 8:8" /><verse number="9" style="v" sid="JHN 8:9" />كه‌ گوێیان له‌م قسه‌یه‌ بوو، له‌ پیره‌كانیانه‌وه‌ هه‌موو یه‌ك له‌دوای یه‌ك خۆیان كێشایه‌وه‌. ئه‌وسا عیسا به‌ته‌نها مایه‌وه‌، ژنه‌كه‌ش له‌‏شوێنی خۆی وه‌ستابوو. <verse eid="JHN 8:9" /><verse number="10" style="v" sid="JHN 8:10" />ئینجا عیسا سه‌ری به‌رزكرده‌وه‌، له‌ژنه‌كه‌ زیاتر كه‌سیتری نه‌بینی‏، پێی ووت: (ئه‌ی ئافره‌ت ئه‌وان له‌ كوێن؟ كه‌سیان تاوانباری نه‌كردی؟) <verse eid="JHN 8:10" /><verse number="11" style="v" sid="JHN 8:11" />ئه‌ویش وه‌ڵامی دایه‌وه‌: (نه‌خێر گه‌وره‌م.) عیساش پێی ووت: (منیش تاوانبارت ناكه‌م، بڕۆ جارێكیكه‌ گوناه‌ مه‌كه‌!)]<verse eid="JHN 8:11" /></para>
  <para style="s1">من ڕووناكی جیهانم</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />جارێكیكه‌ عیسا گفتوگۆی له‌گه‌ڵدا كردن‏و ووتی: (من ڕووناكی جیهانم. ئه‌وه‌ی دوام‎بكه‌وێ‌ به‌‏تاریكیدا ناڕوات، به‌ڵكو ڕووناكی ژیانی ده‌بێ‌.) <verse eid="JHN 8:12" /><verse number="13" style="v" sid="JHN 8:13" />فه‌ریسیه‌كان به‌ربه‌ره‌كانیان كردو ووتیان: (تۆ ئێستا شایه‌تی بۆ خۆت ده‌ده‌یت، به‌ڵام شایه‌تیه‌كه‌ت ڕاست نییه‌.) <verse eid="JHN 8:13" /><verse number="14" style="v" sid="JHN 8:14" />ئه‌ویش وه‌ڵامیدایه‌وه‌: (له‌گه‌ڵ ئه‌وه‌ی من شایه‌تی بۆ خۆم ده‌ده‌م، شایه‌تیه‌كه‌م ڕاسته‌، چونكه‌ ده‌زانم له‌‏كوێوه‌ هاتووم‏و بۆ كوێ‌ ده‌ڕۆم، به‌ڵام ئێوه‌ نازانن له‌كوێوه‌ هاتووم‏و بۆ كوێ‌ ده‌ڕۆم. <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />جا ئێوه‌ به‌پێی له‌ش حوكم‎ده‌ده‌ن به‌سه‌رم، به‌ڵام من حوكم به‌سه‌ر كه‌س ناده‌م، <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />له‌گه‌ڵ ئه‌وه‌شدا گه‌ر حوكم بده‌م حوكمه‌‎كانم دادپه‌روه‌رانه‌یه‌، چونكه‌ من به‌ته‌نها حوكم ناده‌م، به‌ڵكو من‏و ئه‌و باوكه‌ی ناردوومی. <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />له‌شه‌ریعه‌ته‌كه‌تان نووسراوه‌ شایه‌تی دوو پیاو ڕاسته‌. <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />من ئه‌وه‌م شایه‌تی بۆخۆم ده‌ده‌م، هه‌روه‌ها ئه‌و باوكه‌ی ناردوومی شایه‌تیم بۆ ده‌دات.) <verse eid="JHN 8:18" /><verse number="19" style="v" sid="JHN 8:19" />ئه‌وسا لێیان‎پرسی: (باوكت له‌‏كوێیه‌؟) له‌وه‌ڵامدا ووتی: (ئێوه‌ من ناناسن، باوكیشم ناناسن. گه‌ر منتان بناسیبایه‌ باوكمیشتان ده‌ناسی.) <verse eid="JHN 8:19" /><verse number="20" style="v" sid="JHN 8:20" />عیسا ئه‌م قسانه‌ی له‌لای سندوقی به‌خشینی په‌رستگادا كرد كاتێ‌ خه‌ڵكی فێر ده‌كرد، به‌ڵام هیچ كه‌سێ‌ نه‌یگرت، چونكه‌ هێشتا كاتی نه‌هاتبوو.<verse eid="JHN 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />ئینجا عیسا پێی ووتن: (من ده‌ڕۆم‏و ئێوه‌ به‌دوامدا ده‌گه‌ڕێن‏، به‌ڵام ناتوانن بێن بۆ ئه‌و شوێنه‌ی منی لێده‌بم، به‌ڵكو به‌‏گوناهه‌كانتانه‌وه‌ ده‌مرن.) <verse eid="JHN 8:21" /><verse number="22" style="v" sid="JHN 8:22" />ده‌سه‌ڵاتدارانی جووله‌كه‌ ده‌ستیان‎كرد به‌پرسیاركردن: (ئایا مه‌به‌ستی له‌م قسه‌یه‌ چیه‌ ناتوانن بێن بۆ ئه‌و شوێنه‌ی منی لێده‌بم؟ ئایا خۆی ده‌كوژێ‌؟) <verse eid="JHN 8:22" /><verse number="23" style="v" sid="JHN 8:23" />وه‌ڵامی عیسا ئه‌وه‌‏بوو: (ئێوه‌ له‌‏خواره‌وه‌ن‏، به‌ڵام من له‌‏سه‌ره‌وه‌م، ئێوه‌ سه‌ر به‌م جیهانه‌ن، به‌ڵام من سه‌ر به‌م جیهانه‌ نیم. <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />جا له‌به‌رئه‌وه‌ بوو پێم‎ووتن: به‌‏گوناهه‌كانتانه‌وه‌ ده‌مرن، چونكه‌ ئه‌گه‌ر باوه‌ڕ نه‌هێنن من ئه‌وم، به‌گوناهه‌كانتانه‌وه‌ ده‌مرن.) <verse eid="JHN 8:24" /><verse number="25" style="v" sid="JHN 8:25" />‏لێیان‎پرسی: (تۆ كێیت؟) عیسا له‌‏وه‌ڵامدا ووتی: (من هه‌ر ئه‌و كه‌سه‌م له‌سه‌ره‌تاوه‌ پێم‎ووتون! <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />زۆر شتم هه‌یه‌ بیڵێم‏و حوكمی پێ‌بده‌م به‌سه‌رتان. به‌ڵام ئه‌وه‌ی منی ناردووه‌، ئه‌و خۆی ڕاستییه‌، ئه‌وه‌ی به‌‏جیهانیشی ده‌ڵێم ئه‌وه‌یه‌ كه‌ له‌وم بیستووه‌.) <verse eid="JHN 8:26" /><verse number="27" style="v" sid="JHN 8:27" />جا ئه‌وان تێ‌نه‌گه‌یشتن عیسا له‌م قسه‌یه‌ مه‌به‌ستی له‌باوكی بوو. <verse eid="JHN 8:27" /><verse number="28" style="v" sid="JHN 8:28" />له‌به‌رئه‌وه‌ عیسا پێی ووتن: (كاتێ‌ ڕۆڵه‌ی مرۆڤ هه‌ڵده‌واسن ده‌زانن من ئه‌وم، هه‌روه‌ها من له‌‏خۆمه‌وه‌ هیچ ناكه‌م، به‌ڵكو ئه‌و قسانه‌ ده‌ڵێم كه‌ باوكم فێری كردووم. <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />ئه‌وه‌ی ناردوومی له‌گه‌ڵمدایه‌، به‌ته‌نها به‌جێی نه‌هێشتووم، چونكه‌‏ هه‌میشه‌ به‌پێی ڕه‌زامه‌ندی ئه‌و كارده‌كه‌م.(<verse eid="JHN 8:29" /></para>
  <para style="s1">ڕاستی ئازادتان ده‌كات</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 8:30" />كاتێ‌ عیسا ئه‌م قسانه‌ی ده‌كرد، ژماره‌یه‌كی زۆر خه‌ڵك باوه‌ڕیان پێ‌هێنا. <verse eid="JHN 8:30" /><verse number="31" style="v" sid="JHN 8:31" />ئه‌وسا عیسا به‌و جووله‌كانه‌ی باوه‌ڕیان پێیهێنابوو ووتی: (گه‌ر له‌سه‌ر ووشه‌كانم جێگیربن، به‌ڕاستی ده‌بنه‌ قوتابی من‏و <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" />ڕاستی ده‌ناسن‏و ڕاستیش ئازادتان ده‌كات.) <verse eid="JHN 8:32" /><verse number="33" style="v" sid="JHN 8:33" />‏جووله‌كه‌كان له‌وه‌ڵامدا ووتیان: (ئێمه‌ نه‌وه‌ی ئیبراهیمین، هه‌رگیز كۆیله‌ی كه‌س نه‌بووین! ئیتر چۆن پێمان ده‌ڵێی: ئێوه‌ ئازاد ده‌بن؟) <verse eid="JHN 8:33" /><verse number="34" style="v" sid="JHN 8:34" />‏عیساش وه‌ڵامی دانه‌وه‌: (ڕاستی ڕاستیتان پێ‌ده‌ڵێم: هه‌ركه‌سێ‌ گوناه‌ بكات ده‌بێت به‌‏كۆیله‌ی گوناه‌. <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" />كۆیله‌ له‌‏ماڵی گه‌وره‌كه‌یدا تاسه‌ر نامێنێته‌وه‌، به‌ڵام ڕۆڵه‌ تاسه‌ر تیایدا ده‌ژی. <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />جا گه‌ر ڕۆڵه‌ ئازادی‏كردن، ئه‌وا به‌ڕاستی ئازاد ده‌بن. <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" />من ده‌زانم ئێوه‌ له‌نه‌وه‌ی ئیبراهیمن. به‌ڵام ئێوه‌ هه‌وڵی كوشتنم ده‌ده‌ن، چونكه‌ ووته‌كانم ‏له‌دڵتان جێگه‌ی نابێته‌وه‌. <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />من چیم له‌لای باوك بینیوه‌ ده‌یڵێم، به‌ڵام ئێوه‌ چیتان له‌باوكتانه‌وه‌ بیستووه‌ كاری پێ‌ده‌كه‌ن.)</para>
  <para style="p" vid="JHN 8:38">‏ <verse eid="JHN 8:38" /><verse number="39" style="v" sid="JHN 8:39" />ئه‌وان به‌ربه‌ره‌كانیان كردو ووتیان: (ئیبراهیم باوكمانه‌!) عیساش ووتی: (گه‌ر ڕۆڵه‌ی ئیبراهیم بوونایه‌، كرداره‌كانی ئیبراهیمتان ده‌كرد. <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" />به‌ڵام چونكه‌ من ئه‌و كه‌سه‌م ئه‌و ڕاستییه‌ی له‌خوداوه‌ بیستبووم پێم ووتن، ئێوه‌ هه‌وڵی كوشتنم ده‌ده‌ن، ئه‌مه‌ش ئیبراهیم نه‌یكردووه‌. <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />ئێوه‌ كرداری باوكتان ده‌كه‌ن!) ئه‌وانیش پێیان ووت: (ئێمه‌ به‌زۆڵی له‌دایك نه‌بووین! یه‌ك باوكمان هه‌یه‌ ئه‌ویش خودایه‌.) <verse eid="JHN 8:41" /><verse number="42" style="v" sid="JHN 8:42" />عیساش ووتی: (گه‌ر خودا باوكتان بووایه‌، منتان خۆش ده‌ویست، چونكه‌ من له‌ خوداوه‌ ده‌رچووم‏و هاتووم. له‌ خۆمه‌وه‌ نه‌هاتووم، به‌ڵكو ئه‌و ناردوومی. <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" />بۆچی له‌ووته‌كانم تێ‌ناگه‌ن؟ چونكه‌ توانای گوێ‌گرتنی ووشه‌كانی منتان نییه‌! <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" />ئێوه‌ ڕۆڵه‌ی شه‌یتانی باوكتانن، ده‌تانه‌وێ‌ ئاره‌زووه‌كانی باوكتان جێ‌به‌جێ‌ بكه‌ن. ئه‌و هه‌ر له‌سه‌ره‌تاوه‌ خه‌ڵك كوژ بووه‌، نه‌یتوانی له‌ناو ڕاستیدا بچه‌سپێ‌، چونكه‌ ڕاستی له‌ودا نییه‌! كاتێكیش درۆ ده‌كات، ئه‌وه‌ ده‌رده‌خات كه‌تیایه‌تی، چونكه‌ خۆی درۆزنه‌و باوكی درۆیه‌! <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />به‌ڵام چونكه‌ من ڕاستیتان پێ‌ده‌ڵێم باوه‌ڕم پێ‌ناكه‌ن. <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" />كامتان ده‌توانن گوناهێكم لێ‌بدۆزنه‌وه‌؟ جا مادام ڕاستی ده‌ڵێم، بۆچی باوه‌رم پێ‌ناكه‌ن؟ <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" />ئه‌وه‌ی له‌خوداوه‌ بێت، گوێ‌ له‌ووشه‌ی خودا ده‌گرێ‌. به‌ڵام ئێوه‌ ووشه‌ی خوداتان ناوێ‌ چونكه‌ له‌خودا نین!)<verse eid="JHN 8:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />ئه‌وسا جووله‌كه‌كان ووتیان: (ئایا ئێمه‌ قسه‌كانمان ڕاست نییه‌ كه‌ ده‌ڵێین تۆ سامری، هه‌روه‌ها ڕۆحی پیست تیایه‌؟)<verse eid="JHN 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49" />ئه‌ویش وه‌ڵامی دانه‌وه‌: (ڕۆحی پیسم تیادانییه‌، به‌ڵام ڕێزی باوكم ده‌گرم‏و ئێوه‌ش به‌سووكی سه‌یرم ده‌كه‌ن. <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />من داوای شكۆمه‌ندی بۆ خۆم ناكه‌م، به‌ڵام یه‌كێ‌ هه‌یه‌ بۆم داوا ده‌كات‏و حوكم ده‌دا. <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" />ڕاستی ڕاستیتان پێ‌ده‌ڵێم: ئه‌وه‌ی گوێ‌ڕایه‌ڵی ووته‌كانم بێ‌ هه‌رگیز مردن نابینێ‌.)<verse eid="JHN 8:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52" />ئه‌وسا جووله‌كه‌كان ووتیان: (ئێستا بۆمان ده‌ركه‌وت كه‌ ڕۆحی پیست تیایه‌. ئیبراهیم‏و پێغه‌مبه‌ران مردن، كه‌چی تۆ ده‌ڵێیت ئه‌وه‌ی گوێ‌ڕایه‌ڵی ووته‌كانم بێت هه‌رگیز تامی مردن ناكات. <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />ئایا تۆ گه‌وره‌تری له‌ئیبراهیمی باوكمان كه‌ مرد؟ ته‌نانه‌ت پێغه‌مبه‌رانی خوداش مردن، كه‌واته‌ خۆت به‌چی داده‌نێی؟)<verse eid="JHN 8:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54" />عیساش له‌وه‌ڵامدا ووتی: (گه‌ر من خۆم شكۆدار بكه‌م، ئه‌وا شكۆمه‌ندیه‌كه‌م هیچ نییه‌. به‌ڵام باوكمه‌ كه‌وا شكۆدارم ده‌كات ئه‌وه‌ی ئێوه‌ ده‌ڵێن خودامانه‌، <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />له‌گه‌ڵ ئه‌وه‌شدا نایناسن. به‌ڵام من ده‌یناسم. جا گه‌ر پێتان بڵێم من ئه‌و ناناسم، منیش ئه‌وكاته‌ وه‌ك ئێوه‌ درۆزنم. به‌ڵام من ئه‌و ده‌ناسم‏و به‌ووته‌كانی ڕه‌فتار ده‌كه‌م. <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />ئیبراهیمی باوكتان دڵشادبوو به‌وه‌ی ڕۆژی من ببینێ‌، جا ئه‌و ڕۆژه‌ی بینیو پێی دڵخۆش بوو.) <verse eid="JHN 8:56" /><verse number="57" style="v" sid="JHN 8:57" />جووله‌كه‌كان پێیان ووت: (تۆ جارێ‌ ته‌مه‌نت هێشتا نه‌بووه‌ به‌په‌نجا ساڵ ئیتر چۆن ئیبراهیمت بینیوه‌؟) <verse eid="JHN 8:57" /><verse number="58" style="v" sid="JHN 8:58" />عیساش له‌وه‌ڵامدا ووتی: (ڕاستی ڕاستیتان پێ‌ده‌ڵێم، پێش ئه‌وه‌ی ئیبراهیم له‌دایك بێ‌ من هه‌م.) <verse eid="JHN 8:58" /><verse number="59" style="v" sid="JHN 8:59" />ئه‌وسا به‌ردیان هه‌ڵگرت تابه‌ردبارانی بكه‌ن، به‌ڵام عیسا خۆی شارده‌وه‌و له‌په‌رستگاكه‌ چووه‌ ده‌ره‌وه‌.<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s1">چاكردنه‌وه‌ی ‏كوێرێكی ‏زگماك‏</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />كاتێ‌ عیسا به‌رێگادا ده‌رۆیشت، پیاوێكی به‌زگماك كوێری بینی، <verse eid="JHN 9:1" /><verse number="2" style="v" sid="JHN 9:2" />‏قوتابیه‌كانی لێیان‎پرسی: (مامۆستا، كێ‌ گوناهی كردووه‌؟ ئه‌م پیاوه‌، یاخود دایك‏و باوكی، تا به‌كوێری له‌دایك ببێ‌؟) <verse eid="JHN 9:2" /><verse number="3" style="v" sid="JHN 9:3" />عیسا له‌‏وه‌ڵامدا ووتی: (نه‌گوناهی ئه‌م پیاوه‌یه‌و نه‌‏دایك‏و باوكی، به‌ڵام بۆیه‌ وای لـێ‌هاتووه‌ تا به‌هۆی ئه‌وه‌وه‌ كاره‌كانی خودا ده‌ركه‌وێ‌. <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />هه‌تا كاته‌كه‌ ڕۆژه‌ له‌سه‌رمه‌ كاری ئه‌و بكه‌م كه‌ ناردوومی. دوایی شه‌و دێت‏و كه‌س ناتوانێ‌ كاری تیا بكات. <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" />جا ئه‌وه‌نده‌ی له‌‏جیهاندام، من ڕووناكی جیهانم.(<verse eid="JHN 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6" />ئه‌مه‌ی ووت‏و تفی‏كرده‌ سه‌ر زه‌وی، به‌تفه‌كه‌ قوڕی دروست‎كرد، ئینجا خستیه‌ سه‌ر هه‌ردوو چاوی كوێره‌كه‌، <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" />پێی ووت: (بڕۆ خۆت بشۆ له‌گۆمی سیلوام (واتای نێرراوه‌).) ئه‌ویش ڕۆیشت‏و خۆی شوشت‏و به‌چاوكراوه‌یی هاته‌وه‌.<verse eid="JHN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8" />ئینجا دراوسێكانیو ئه‌وانه‌ی له‌پێشا بینیبوویان سواڵ ده‌كات پرسییان: (‏ئه‌مه‌ ئه‌وه‌ نییه‌ داده‌نیشت سواڵی ده‌كرد؟) <verse eid="JHN 9:8" /><verse number="9" style="v" sid="JHN 9:9" />هه‌ندێكیان ووتیان: (خۆیه‌تی.) هه‌ندێكی كه‌یان: (‏نه‌خێر، به‌ڵام له‌و ده‌كات.) ئه‌وسا خۆی وه‌ڵامی دایه‌وه‌و ووتی: (به‌ڵێ‌ من ئه‌وم.) <verse eid="JHN 9:9" /><verse number="10" style="v" sid="JHN 9:10" />ئینجا پێیان‎ووت: (ئه‌ی چۆن چاوت چاك بووه‌وه‌؟) <verse eid="JHN 9:10" /><verse number="11" style="v" sid="JHN 9:11" />له‌وه‌ڵامدا ووتی: (ئه‌و پیاوه‌ی ناوی عیسایه‌ قوڕی دروست‎كردو چاومی پێ‌سواخدا، پێیووتم: بڕۆ بۆ گۆمی سیلوام خۆتی تیادا بشۆ. منیش ڕۆیشتم‏و خۆم تیا شوشت‏و چاوم چاك‎بووه‌وه‌!) <verse eid="JHN 9:11" /><verse number="12" style="v" sid="JHN 9:12" />هه‌روه‌ها لێیان ‎پرسی: (ئێستا ئه‌و له‌‏كوێیه‌؟) ئه‌ویش ووتی: (نازانم.)<verse eid="JHN 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />پیاوه‌ كوێره‌كه‌یان برده‌ لای فه‌ریسیه‌كان. <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />ئه‌و ڕۆژه‌ش كه‌ عیسا قوڕه‌كه‌ی دروست‎كردو چاوی كوێره‌كه‌ی تیا چاك‎كرده‌وه‌ ڕۆژی شه‌ممه‌ بوو. <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />دیسان فه‌ریسیه‌كانیش لێیان‎ پرسی چۆن چاوی چاك‎بووه‌وه‌. ئه‌ویش له‌وه‌ڵامدا ووتی: (قوڕی خسته‌ سه‌ر چاوم، خۆم شوشت‏و ئه‌وه‌تا ئێستا ده‌بینم!) <verse eid="JHN 9:15" /><verse number="16" style="v" sid="JHN 9:16" />به‌ڵام هه‌ندێ‌ له‌فه‌ریسیه‌كان ووتیان: (ناشێ‌ ئه‌م پیاوه‌ له‌‏خوداوه‌ بێت، چونكه‌ به‌رپێچی یاسای شه‌ممه‌ ده‌كات.) به‌ڵام هه‌ندێكیان پرسییان: (چۆن پیاوێكی گوناهبار ده‌توانێ‌ نیشانه‌ی سه‌رسوڕهێنه‌ر بنوێنێ‌؟) ئیتر دووبه‌ره‌كی كه‌وته‌ نێوانیانه‌وه‌. <verse eid="JHN 9:16" /><verse number="17" style="v" sid="JHN 9:17" />دیسان له‌كوێره‌كه‌یان پرسی: (تۆ ڕات ‎چییه‌ به‌رامبه‌ر ئه‌و چونكه‌ چاوی تۆی چاك‎كرده‌وه‌؟) ئه‌ویش وه‌ڵامی دانه‌وه‌: (ئه‌و پێغه‌مبه‌ره‌! ( <verse eid="JHN 9:17" /><verse number="18" style="v" sid="JHN 9:18" />ده‌سه‌ڵاتدارانی جووله‌كه‌ باوه‌ڕیان نه‌كرد كه‌ ئه‌و پیاوه‌ كوێر بووه‌‏و ئێستا ده‌بینێ‌، ئیتر دایك‏و باوكیان بانگ‎كرد. <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />لێیان پرسین: (ئایا ئه‌م كوڕه‌تان به‌كوێری له‌دایك بووه‌ وه‌ك ده‌ڵێن؟ جا چۆن ئێستا ده‌بینێ‌؟) <verse eid="JHN 9:19" /><verse number="20" style="v" sid="JHN 9:20" />دایك‏و باوكه‌كه‌ وه‌ڵامیان دایه‌وه‌: (ئێمه‌ ده‌زانین ئه‌مه‌ كوڕمانه‌ و به‌‏كوێری له‌دایك بووه‌. <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />به‌ڵام نازانین ئێستا چۆن ده‌بینێ‌، هه‌روه‌ها كێ‌ چاوی چاك‎كردۆته‌وه‌؟ ئه‌و خۆی گه‌وره‌یه‌و ده‌توانێ‌ وه‌ڵامتان بداته‌وه‌ لێیبپرسن!) <verse eid="JHN 9:21" /><verse number="22" style="v" sid="JHN 9:22" />دایك‏و باوكی كوڕه‌ له‌ترسی ده‌سه‌ڵاتدارانی جووله‌كه‌ ئه‌مه‌یان ووت، چونكه‌ ‏بڕیاری ئه‌وه‌یان دابوو هه‌ركه‌سێ‌ دانبنێ‌ به‌وه‌ی عیسا مه‌سیحه‌ له‌كه‌نیشت ده‌ریبكه‌ن. <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />ئیتر له‌به‌رئه‌وه‌ بوو ووتیان: (ئه‌و گه‌وره‌یه‌ پرسیار له‌خۆی بكه‌ن.)<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />دیسان فه‌ریسیه‌كان ئه‌و پیاوه‌ی كوێر بوو بانگیان كردو پێیان‎ووت: (ستایشی خودا بكه‌! ئێمه‌ ده‌زانین ئه‌و پیاوه‌ گوناهباره‌.) <verse eid="JHN 9:24" /><verse number="25" style="v" sid="JHN 9:25" />كابراش وه‌ڵامی دانه‌وه‌: (گه‌ر ئه‌و گوناهباره‌، نازانم! به‌ڵام یه‌ك شت ده‌زانم: من كوێر بووم و ئێستا ده‌بینم!) <verse eid="JHN 9:25" /><verse number="26" style="v" sid="JHN 9:26" />دیسان لێیان پرسیه‌وه‌: (چی لـێ‌كردیت؟ چۆن چاوی چاك‎كردیته‌وه‌؟) <verse eid="JHN 9:26" /><verse number="27" style="v" sid="JHN 9:27" />ئه‌ویش وه‌ڵامی دانه‌وه‌: (من پێم ووتن ئێوه‌ گوێتان لـێ‌نه‌گرتم، ئیتر بۆچی جارێكیكه‌ ده‌تانه‌وێ‌ بیبیستن؟ ئایا ئێوه‌ش ده‌تانه‌وێ‌ ببن به‌‏قوتابی ئه‌و؟) <verse eid="JHN 9:27" /><verse number="28" style="v" sid="JHN 9:28" />ئه‌وسا فه‌ریسیه‌كان جنێویان به‌كابرا داو پێیان ووت: (تۆ قوتابی ئه‌ویت! به‌ڵام ئێمه‌ قوتابی موساین. <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />ئێمه‌ ده‌زانین خودا قسه‌ی له‌گه‌ڵ موسا كردووه‌، به‌ڵام ئه‌مه‌ نازانین له‌ كوێوه‌ هاتووه‌!) <verse eid="JHN 9:29" /><verse number="30" style="v" sid="JHN 9:30" />كابراش وه‌ڵامی دانه‌وه‌: (‏ئه‌مه‌ شتێكی سه‌یره‌! ئه‌و چاوی چاك‎كردومه‌ته‌وه‌، كه‌چی ئێوه‌ ده‌ڵێن ئێمه‌ نازانین ئه‌و وه‌چه‌و بنه‌چه‌ی كێیه‌! <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />ئێمه‌ ده‌زانین خودا وه‌ڵامی گوناهباران ناداته‌وه‌، به‌ڵام گوێ‌ له‌وانه‌ ده‌گرێ‌ كه‌ لێیده‌ترسن‏و به‌خواستی ئه‌و ده‌كه‌ن. <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />تا ئێستا پشتاوپشت نه‌بیستراوه‌ یه‌كێك چاوی مرۆڤێكی به‌زگماك كوێری چاك‎كردبێته‌وه‌! <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />گه‌ر ئه‌و له‌‏خودا نه‌بووایه‌، نه‌یده‌توانی هیچ بكات.) <verse eid="JHN 9:33" /><verse number="34" style="v" sid="JHN 9:34" />ئه‌وسا هاواریان كرد به‌سه‌ری: (تۆ خۆت هه‌موو گیانت به‌گوناه‌ له‌دایك بووه‌و ئێمه‌ فێرده‌كه‌یت؟) ئینجا ده‌ریان‎كرده‌ ده‌ره‌وه‌ی كه‌نیشته‌كه‌.<verse eid="JHN 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />كاتێ‌ عیسا زانی كابرا ده‌ركراوه‌ته‌ ده‌ره‌وه‌، چوو بۆ لای و لێیپرسی: (ئایا باوه‌ڕ به‌ڕۆڵه‌ی مرۆڤ ده‌كه‌یت؟) <verse eid="JHN 9:35" /><verse number="36" style="v" sid="JHN 9:36" />كابرا له‌‏وه‌ڵامدا ووتی: (گه‌وره‌م، ئه‌و كێیه‌ تا باوه‌ڕی پێ‌بهێنم؟) <verse eid="JHN 9:36" /><verse number="37" style="v" sid="JHN 9:37" />لێره‌ عیسا پێی ووت: (ئه‌وه‌ی كه‌ بینیت، هه‌روه‌ها ئه‌وه‌ی له‌گه‌ڵت ده‌دوێ‌، ئه‌وه‌ خۆیه‌تی!) <verse eid="JHN 9:37" /><verse number="38" style="v" sid="JHN 9:38" />كابرا ووتی: (گه‌وره‌م من باوه‌ڕ ده‌كه‌م!) ئه‌وسا كڕنووشی بۆ برد.<verse eid="JHN 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39" />عیسا ووتی: (هاتووم بۆ ئه‌م جیهانه‌ بۆ حوكمدان، تا كوێر ببینێ‌‏و چاوساغ كوێر‏بێ‌!) <verse eid="JHN 9:39" /><verse number="40" style="v" sid="JHN 9:40" />هه‌ندێ‌ له‌فه‌ریسیه‌كان كه‌ له‌گه‌ڵیدا بوون گوێیان له‌مه‌‏بوو لێیان‎پرسی: (ئایا ئێمه‌ش كوێرین؟) <verse eid="JHN 9:40" /><verse number="41" style="v" sid="JHN 9:41" />‏عیساش وه‌ڵامی دانه‌وه‌: (گه‌ر ئێوه‌ به‌ڕاستی كوێر بوونایه‌، گوناهتان له‌سه‌ر نه‌ده‌بوو. به‌ڵام ئێوه‌ ئێستا ده‌ڵێن‏: ده‌بینین، جا له‌به‌رئه‌وه‌ گوناهه‌كه‌تان ده‌مێنێته‌وه‌.<verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s1">من شوانێكی دڵسۆزم</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />(ڕاستی ڕاستیتان پێ‌ده‌ڵێم: ئه‌وه‌ی له‌ده‌رگای پشتیری مێگه‌لێكه‌وه‌ ناچێته‌ ژووره‌وه‌، به‌ڵكو به‌ڕێگایه‌كیكه‌دا بۆی سه‌ربكه‌وێ‌‏، ئه‌وه‌ دزو جه‌رده‌یه‌. <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" />به‌ڵام ئه‌وه‌ی له‌‏ده‌رگاوه‌ بچێته‌ ژووره‌وه‌، ئه‌وه‌ شوانی مێگه‌له‌كه‌یه‌، <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" />ده‌رگاوانیش ده‌رگاكه‌ی بۆ ده‌كاته‌وه‌، مێگه‌له‌كه‌ش گوێ‌ له‌ده‌نگی ده‌گرن، بانگی مێگه‌له‌ تایبه‌تیه‌كه‌ی خۆی ده‌كات هه‌ر یه‌كه‌ به‌ناوی خۆیه‌وه‌، ئه‌وسا ده‌یانباته‌ ده‌ره‌وه‌. <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />كاتێ‌ هه‌موویانی هێنایه‌ ده‌ره‌وه‌، له‌‏پێشیانه‌وه‌ ده‌ڕوات‏و ئه‌وانیش دوای ده‌كه‌ون، چونكه‌ ده‌نگی ده‌ناسن. <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />ئه‌وان شوێنی یه‌كێكی نامۆ ناكه‌ون، به‌ڵكو لێی ڕاده‌كه‌ن‏، چونكه‌ ده‌نگی نامۆ ناناسن. <verse eid="JHN 10:5" /><verse number="6" style="v" sid="JHN 10:6" />عیسا ئه‌م نموونه‌یه‌ی بۆ هێنانه‌وه‌، به‌ڵام ئه‌وان له‌‏مه‌به‌ستی قسه‌كه‌ی تێ‌نه‌گه‌یشتن.<verse eid="JHN 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />جا له‌به‌رئه‌وه‌ دیسان ووتی: (ڕاستی ڕاستیتان پێ‌ده‌ڵێم: من ده‌رگای مێگه‌له‌كه‌م. <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />هه‌موو ئه‌وانه‌ی پێش من هاتوون دزو جه‌رده‌ بوون، به‌ڵام مێگه‌ڵه‌كه‌ گوێیان لێ‌نه‌گرتن‏. <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />من ئه‌و ده‌رگایه‌م، ئه‌وه‌ی لێم بێته‌ ژووره‌وه‌ ڕزگاری ده‌بێت، ئه‌وسا دێته‌ژووره‌وه‌و ده‌چێته‌ده‌ره‌وه‌و له‌وه‌ڕگا ده‌دۆزێته‌وه‌. <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />دز نایه‌ت‏، ته‌نها بۆ دزین‏و سه‌ربڕین‏و له‌ناوبردن نه‌بێت. به‌ڵام من هاتووم هه‌تا ئه‌وان ژیانیان هه‌بێ‌، ژیانێكی تێروته‌سه‌ل. <verse eid="JHN 10:10" /><verse number="11" style="v" sid="JHN 10:11" />من شوانێكی دڵسۆزم، شوانی دڵسۆزیش ژیانی خۆی ده‌كاته‌ قوربانی له‌پێناوی مێگه‌له‌كه‌ی. <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />به‌كرێگیراو وه‌ك شوان‎ نییه‌، چونكه‌ مێگه‌له‌كه‌ هی خۆی نییه‌. كاتێ‌ ده‌بینێ‌ گورگ دێ‌، مێگه‌له‌كه‌ به‌جێ‌ده‌هێڵێ‌ هه‌تا خۆی ڕزگاركات، ئه‌وسا گورگه‌كه‌ مێگه‌له‌كه‌ ده‌ڕفێنێ‌‏و په‌رشو بڵاویان ده‌كاته‌وه‌. <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />كابرا هه‌ڵدێ‌، چونكه‌ به‌كرێ‌ گیراوه‌ گوێ‌نادات به‌مێگه‌له‌كه‌! <verse eid="JHN 10:13" /><verse number="14" style="v" sid="JHN 10:14" />به‌ڵام من شوانێكی دڵسۆزم، مێگه‌له‌كه‌م ده‌ناسم، ئه‌وانیش من ده‌ناسن، <verse eid="JHN 10:14" /><verse number="15" style="v" sid="JHN 10:15" />هه‌روه‌ك چۆن باوك من ده‌ناسێ‌، منیش ئه‌و ده‌ناسم. جا من ژیانم ده‌كه‌م به‌قوربانی له‌پێناوی مێگه‌له‌كه‌مدا. <verse eid="JHN 10:15" /><verse number="16" style="v" sid="JHN 10:16" />هه‌روه‌ها مه‌ڕیترم هه‌یه‌ سه‌ر به‌م پشتیره‌ نین، ده‌بێ‌ ئه‌وانیش كۆبكه‌مه‌وه‌ لای خۆم، ئه‌وانیش گوێ‌ له‌‏ده‌نگم ده‌گرن، ‏ئه‌وسا یه‌ك مێگه‌ل‏و یه‌ك شوان ده‌بێ‌.<verse eid="JHN 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 10:17" />باوك منی خۆش‎ده‌وێ‌‏، چونكه‌ ژیانم ده‌كه‌م به‌قوربانی تا جارێكیكه‌ وه‌ری گرمه‌وه‌. <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />كه‌س له‌‏منی ناسێنێ‌، به‌ڵكو من به‌‏ئاره‌زووی خۆم پێشكه‌شی ده‌كه‌م. من ده‌سه‌ڵاتی پێشكه‌شكردن‏و ده‌سه‌ڵاتی بردنه‌وه‌یم هه‌یه‌. ئه‌مه‌ ڕاسپارده‌یه‌كه‌ له‌باوكمه‌وه‌ وه‌رم‎گرتووه‌.) <verse eid="JHN 10:18" /><verse number="19" style="v" sid="JHN 10:19" />به‌هۆی ئه‌م قسانه‌ دووبه‌ره‌كی له‌نێو جووله‌كه‌كان په‌یدابوو. <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />زۆربه‌یان ووتیان: (ڕۆحی پیسی تیادایه‌و وڕێنه‌ ده‌كات. ئیتر بۆچی گوێی لـێ‌بگرین؟) <verse eid="JHN 10:20" /><verse number="21" style="v" sid="JHN 10:21" />هه‌ندێكی كه‌یان ووتیان: (ئه‌مه‌ قسه‌ی یه‌كێك نییه‌ كه‌ ڕۆحی پیسی تیادابێ‌. ئایا ڕۆحی پیس ده‌توانێ‌ چاوی كوێران چاك‎بكاته‌وه‌؟(<verse eid="JHN 10:21" /></para>
  <para style="s1">‏من‏و باوك یه‌كین</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />له‌كاتی ئاهه‌نگ گێران به‌بۆنه‌ی تازه‌كردنه‌وه‌ی په‌رستگا له‌زستاندا، <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />عیسا له‌په‌رستگا به‌ناو هۆڵی سلێماندا ده‌ڕۆیشت. <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />‏جووله‌كه‌كان لێیكۆبوونه‌وه‌و پێیان ووت: (تا كه‌ی به‌سه‌رسوڕماوی ده‌مان‎هێڵیته‌وه‌ ده‌رباره‌ی خۆت؟ گه‌ر تۆ به‌ڕاستی مه‌سیحیت، به‌ئاشكرا پێمان‎بڵێ‌.) <verse eid="JHN 10:24" /><verse number="25" style="v" sid="JHN 10:25" />عیسا وه‌ڵامی دانه‌وه‌: (من پێم‎ووتن، به‌ڵام ئێوه‌ باوه‌ڕم پێ‌ناكه‌ن. جا هه‌موو ئه‌و كارانه‌ی به‌ناوی باوكمه‌وه‌ ده‌یكه‌م، شایه‌تی بۆمن ده‌ده‌ن. <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />به‌ڵام ئێوه‌ باوه‌ڕناكه‌ن چونكه‌ مه‌ڕی من نین. <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />مه‌ڕه‌كانم گوێ‌ له‌‏ده‌نگم ده‌گرن، منیش ده‌یان‎ناسم‏و ئه‌وانیش دوام ‎ده‌كه‌ون، <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />ژیانی هه‌تاهه‌تاییان ده‌ده‌مێ‌‏و هه‌رگیز له‌ناوناچن، هیچ كه‌سیش له‌‏ده‌ستم نایانڕفێنێ‌. <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" />ئه‌و باوكه‌ی به‌منی داوه‌ له‌‏هه‌موو كه‌س گه‌وره‌تره‌، كه‌س ناتوانێ‌ هیچ شتێ‌ له‌ده‌ستی باوك بسه‌نێ‌. <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" />من‏و باوك یه‌كین!)<verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />جارێكیكه‌ جووله‌كه‌كان به‌ردیان هه‌ڵگرت، تا به‌ردبارانی بكه‌ن. <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />‏عیسا پێی ووتن: (زۆر كاری چاكم له‌لایه‌ن باوكمه‌وه‌ نیشان‎دان، ئیتر به‌هۆی كامیانه‌وه‌ به‌ردبارانم ده‌كه‌ن؟) <verse eid="JHN 10:32" /><verse number="33" style="v" sid="JHN 10:33" />ئه‌وانیش وه‌ڵامیان دایه‌وه‌: (به‌رد‏بارانت ناكه‌ین به‌هۆی كرداری چاك، به‌ڵكو به‌هۆی كفره‌كانته‌وه‌: چونكه‌ خۆت ده‌كه‌یت به‌ خودا، هه‌رچه‌نده‌ تۆ مرۆڤی!) <verse eid="JHN 10:33" /><verse number="34" style="v" sid="JHN 10:34" />‏عیسا پێی ووتن: (ئایا له‌شه‌ریعه‌ته‌كه‌تان نه‌نووسراوه‌: [[من پێم ووتون ئێوه‌ خـوداوه‌نده‌كانن؟]] <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" />ئه‌گه‌ر شه‌ریعه‌تی موســا ئه‌وانه‌ی ووشه‌ی خودایان بۆ هـاتۆته‌خواره‌وه‌، ناویان بنێت خوداوه‌ندان (هه‌رچه‌نده‌ ناتوانرێ‌ كتێبیش به‌درۆ بخرێته‌وه‌) <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />ئیتر چۆن ده‌ڵێن به‌وه‌ی كه‌ باوك پیرۆزی كردووه‌و ناردوویه‌تی بۆ هـه‌مــوو جیهان: تۆ كفر ده‌كــه‌یت، چــونكــه‌ ووتومه‌: من ڕۆڵه‌ی خودام؟ <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" />گـه‌ر بێتو من كرداره‌كانی باوكم نه‌كه‌م، باوه‌ڕم پێ‌مه‌كه‌ن. <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />به‌ڵام گه‌ر ئه‌وه‌م كرد، ئه‌گه‌رچی باوه‌ڕیش به‌من ناكــه‌ن، باوه‌ڕ به‌و كــردارانه‌ بكه‌ن، تابزانن‏و تێبگه‌ن باوك له‌مندایه‌و منیش له‌ئه‌ودام. (<verse eid="JHN 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 10:39" />جارێكیكه‌ ویستیان بیگرن، به‌ڵام خۆی ده‌ربازكرد له‌ده‌ستیان، <verse eid="JHN 10:39" /><verse number="40" style="v" sid="JHN 10:40" />‏ئینجا عیسا چووه‌وه‌ ‏ئه‌وبه‌ری ڕووباری ئوردون و له‌وێ‌ مایه‌وه‌، ئه‌و شوێنه‌ی كه‌ یه‌حیا جاران خه‌ڵكی تیایدا له‌ئاوهه‌ڵده‌كێشا. <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />ژماره‌یه‌كی زۆر خه‌ڵك هاتنه‌ لای‏و ووتیان: (یه‌حیا نیشانه‌ی سه‌رسوڕهێنه‌ری نه‌كرد، به‌ڵام هه‌موو ئه‌وه‌ی ده‌رباره‌ی ئه‌م پیاوه‌ ووتبووی ڕاستبوو!) <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />هه‌ر له‌وێ‌ ژماره‌یه‌كی زۆر باوه‌ڕیان پێ‌هێنا.<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s1">مردنی له‌عازر</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />مرۆڤێك ناوی له‌عازر بوو نه‌خۆش بوو، خه‌ڵكی به‌یت‏عه‌نیا بوو‏، ئه‌و لادێیه‌ی له‌گه‌ڵ مریه‌م‏و مه‌رسای خوشكی تیایدا ده‌ژیان. <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" />ئه‌م مریه‌مه‌ ئه‌وه‌ بوو كه‌ خوداوه‌ندی به‌‏بۆن چه‌وركردو به‌قژی پێیه‌كانی سڕیه‌وه‌، له‌عازری نه‌خۆشیش برای ئه‌م بوو. <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />هه‌ردوو خوشكه‌كه‌ ناردیان به‌دوای عیسادا تا پێی بڵێن: (گه‌وره‌م، ئه‌وه‌ی خۆشت‎ده‌وێ‌ نه‌خۆشه‌.) <verse eid="JHN 11:3" /><verse number="4" style="v" sid="JHN 11:4" />كاتێ‌ عیسا ئه‌مه‌ی بیست ووتی: (ئه‌م نه‌خۆشیه‌ به‌‏مردن كۆتایی نایه‌ت، به‌ڵكو ده‌بێته‌ هۆی شكۆداری خودا‏، ئه‌وسا به‌هۆی ئه‌مه‌وه‌ ڕۆڵه‌ی خودا شكۆدار ده‌بێ‌.)</para>
  <para style="p" vid="JHN 11:4">‏ <verse eid="JHN 11:4" /><verse number="5" style="v" sid="JHN 11:5" />له‌گه‌ڵ ئه‌وه‌ی عیسا مه‌رساو خوشكه‌كه‌ی و له‌عازری خۆش ده‌ویست، <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />له‌و شوێنه‌ی كه‌لێی بوو دوو ڕۆژ مایه‌وه‌ هه‌رچه‌نده‌ به‌نه‌خۆشیه‌كه‌ی له‌عازریشی زانیبوو. <verse eid="JHN 11:6" /><verse number="7" style="v" sid="JHN 11:7" />دوای ئه‌وه‌ عیسا به‌ قوتابیه‌كانی ووت: (با بگه‌ڕێینه‌وه‌ بۆ ناوچه‌ی یه‌هودیه‌!) <verse eid="JHN 11:7" /><verse number="8" style="v" sid="JHN 11:8" />قوتابیه‌كان پێیان‎ووت: (مامۆستا، ئایا ده‌گه‌ڕێیته‌وه‌ بۆ ناوچه‌ی یه‌هودیه‌، باشه‌ ماوه‌یه‌ك له‌مه‌وبه‌ر جووله‌كه‌كان نه‌یانویست به‌ردبارانت بكه‌ن؟) <verse eid="JHN 11:8" /><verse number="9" style="v" sid="JHN 11:9" />عیسا له‌ وه‌ڵامدا ووتی: (ئایا ڕۆژ دوانزه‌ سه‌عات نییه‌؟ ئه‌وه‌ی به‌‏رۆژ بڕوات ساتمه‌ ناكات، چونكه‌ ڕووناكی ئه‌م جیهانه‌ ده‌بینێ‌. <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />به‌ڵام ئه‌وه‌ی به‌‏شه‌و بڕوات ساتمه‌ ده‌كات، چونكه‌ ڕووناكی تیادانییه‌.) <verse eid="JHN 11:10" /><verse number="11" style="v" sid="JHN 11:11" />ئینجا عیسا ووتی: (له‌عازری خۆشه‌ویستمان خه‌وتووه‌، به‌ڵام من ده‌ڕۆم خه‌به‌ری ده‌كه‌مه‌وه‌.) <verse eid="JHN 11:11" /><verse number="12" style="v" sid="JHN 11:12" />‏قوتابیه‌كان ووتیان:‏ (گه‌وره‌م، گه‌ر ئه‌و نووستوه‌، ئه‌وسا به‌‏ساغی خه‌به‌ری ده‌بێته‌وه‌.)‏ <verse eid="JHN 11:12" /><verse number="13" style="v" sid="JHN 11:13" />قوتابیه‌كانی وایانزانی مه‌به‌ستی له‌‏نووستنی ئاساییه‌، به‌ڵام عیسا مه‌به‌ستی له‌مردنی له‌عازر بوو. <verse eid="JHN 11:13" /><verse number="14" style="v" sid="JHN 11:14" />ئه‌و كاته‌ عیسا به‌ئاشكرا پێ‌ووتن: (له‌عازر مردووه‌. <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />به‌ڵام له‌به‌ر ئێوه‌ من دڵشادم كه‌ له‌وێ‌ نه‌بووم، تا باوه‌ڕ بهێنن. با‏برۆین بۆ لای!) <verse eid="JHN 11:15" /><verse number="16" style="v" sid="JHN 11:16" />ئینجا تۆما كه‌ به‌ دووانه‌ ناسرابوو لای قوتابیه‌كانیكه‌ ووتی: (با ئێمه‌ش بڕۆین له‌گه‌ڵی تا له‌گه‌ڵ ئه‌ودا بمرین!)‏<verse eid="JHN 11:16" /></para>
  <para style="s1">من زیندو‏وبوونه‌وه‌و ژیانم</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />كاتێ‌ عیسا گه‌یشت، له‌عازر چوار ڕۆژ بوو نێژرابوو. <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />به‌یت‏عه‌نیاش ته‌نها نزیكه‌ی دوو میل له‌ قودسه‌وه‌ دوور‏بوو. <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />ژماره‌یه‌كی زۆر له‌‏جووله‌كه‌ هاتبوونه‌ لای مه‌رساو مریه‌م تا سه‌ره‌خۆشی براكه‌یان لـێ‌بكه‌ن. <verse eid="JHN 11:19" /><verse number="20" style="v" sid="JHN 11:20" />كاتێ‌ مه‌رسا زانی عیسا هاتووه‌، هاته‌ده‌ره‌وه‌ بۆ چاوپێكه‌وتنی، مریه‌میش له‌‏ماڵه‌وه‌ دانیشتبوو. <verse eid="JHN 11:20" /><verse number="21" style="v" sid="JHN 11:21" />ئینجا مه‌رسا به‌‏عیسای ووت: (گه‌وره‌م، گه‌ر لێره‌ بوویتایه‌، براكه‌م نه‌ده‌مرد. <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />به‌ڵام ده‌زانم ته‌نانه‌ت ئێستاش هه‌رچی له‌خودا داوا بكه‌یت ده‌تداتێ‌.) <verse eid="JHN 11:22" /><verse number="23" style="v" sid="JHN 11:23" />عیسا له‌وه‌ڵامدا ووتی: (براكه‌ت زیندووده‌بێته‌وه‌.) <verse eid="JHN 11:23" /><verse number="24" style="v" sid="JHN 11:24" />مه‌رسا ووتی: (‏ده‌زانم هه‌ڵده‌ستێته‌وه‌ له‌هه‌ستانه‌وه‌ی مردووان له‌ڕۆژی دواییدا!) <verse eid="JHN 11:24" /><verse number="25" style="v" sid="JHN 11:25" />‏عیسا له‌‏وه‌ڵامدا ووتی: (من زیندووبوونه‌وه‌و ژیانم. هه‌ر كه‌سێ‌ باوه‌ڕم پێ‌بهێنێ‌، ئه‌گه‌ر مردیش زیندووده‌بێته‌وه‌. <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />هه‌روه‌ها هه‌ر كه‌سێ‌ زیندوو بێ‌ و باوه‌ڕم پێ‌بهێنێ‌ هه‌رگیز نامرێ‌. ئایا باوه‌ڕ به‌مه‌ ده‌كه‌یت؟) <verse eid="JHN 11:26" /><verse number="27" style="v" sid="JHN 11:27" />ئه‌ویش وه‌ڵامی دایه‌وه‌: (به‌ڵێ‌ گه‌وره‌م. من باوه‌ڕ ده‌كه‌م تۆ مه‌سیحی ڕۆڵه‌ی خودای هاتووی بۆ جیهان!)‏<verse eid="JHN 11:27" /></para>
  <para style="s1">گریانی عیسا‏</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28" />دوای ئه‌وه‌ی ئه‌مه‌ی ووت، چوو مریه‌می خوشكی بانگ‎بكات، به‌دزیه‌وه‌ پێی ووت: (مامۆستا لێره‌یه‌، بانگت‎ده‌كا!) <verse eid="JHN 11:28" /><verse number="29" style="v" sid="JHN 11:29" />مریه‌م كه‌ ئه‌مه‌ی بیست خێرا هه‌ستاو هاته‌ لای. <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />عیسا جارێ‌ نه‌گه‌یشتبووه‌ دێیه‌كه‌، به‌ڵكو هێشتا له‌وشوێنه‌ بوو كه‌ تیایا چاوی به‌‏مه‌رسا كه‌وتبوو. <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />جووله‌كه‌كانیش، ئه‌وانه‌ی له‌‏ماڵه‌وه‌ له‌گه‌ڵیدا بوون‏و بۆ دڵنه‌وایی هاتبوون، كه‌ بینییان ئاوا هه‌ستایه‌ سه‌رپێ‌‏و خێرا چووه‌ ده‌ره‌وه‌، شوێنی كه‌وتن، چونكه‌ وایانزانی ده‌ڕوات تا له‌سه‌ر گۆڕه‌كه‌ بگری. <verse eid="JHN 11:31" /><verse number="32" style="v" sid="JHN 11:32" />كاتێ‌ مریه‌م عیسای بینیو گه‌یشته‌ ئه‌و شوێنه‌ی ئه‌وی لـێ‌بوو، كه‌وت به‌سه‌ر پێیداو ووتی: (گه‌وره‌م، گه‌ر لێره‌ بوویتایه‌، براكه‌م نه‌ده‌مرد!) <verse eid="JHN 11:32" /><verse number="33" style="v" sid="JHN 11:33" />عیسا كه‌ مریه‌م‏و ئه‌و جووله‌كانه‌ی بینی له‌گه‌ڵی هاتبوون ده‌گرین، دڵی پڕ بوو له‌په‌ژاره‌یه‌كی زۆر، <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />ئینجا پرسی: (له‌كوێ‌ ناشتوتانه‌؟) ئه‌وانیش وه‌ڵامیان دایه‌وه‌: (گه‌وره‌م، وه‌ره‌ سه‌یركه‌!) <verse eid="JHN 11:34" /><verse number="35" style="v" sid="JHN 11:35" />عیسا گریا. <verse eid="JHN 11:35" /><verse number="36" style="v" sid="JHN 11:36" />لـه‌م‎كاته‌دا جووله‌كه‌كان به‌‏یه‌كتریان ووت: (سه‌یركه‌ چه‌ندی خۆش‎ده‌ویست!) <verse eid="JHN 11:36" /><verse number="37" style="v" sid="JHN 11:37" />هــه‌ندێكیان پرسـیاریان‎ كرد: (ئایا نه‌یده‌توانی ئه‌مه‌ی كه‌ چاوی كوێرانی چاك كرده‌وه‌، نه‌یهێشتایه‌ له‌عازر بمرێ‌؟(<verse eid="JHN 11:37" /></para>
  <para style="s1">زیندووبوونه‌وه‌ی له‌عازر</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />جارێكیكه‌ عیسا دڵی پڕبوو له‌ په‌ژاره‌. ئینجا له‌گۆڕه‌كه‌ نزیك كه‌وته‌وه‌ كه‌ ئه‌شكه‌وتێك بوو ده‌رگاكه‌ی به‌ردێكی گه‌وره‌ی له‌سه‌ر بوو. <verse eid="JHN 11:38" /><verse number="39" style="v" sid="JHN 11:39" />عیسا ووتی: (‏به‌رده‌كه‌ لابه‌ن!) مه‌رسا ووتی: (گه‌وره‌م ئه‌مه‌ ڕۆژی چواره‌مینێتی، بۆنی كردووه‌.) <verse eid="JHN 11:39" /><verse number="40" style="v" sid="JHN 11:40" />جا عیسا پێی ووت: (پێم نه‌ووتی گه‌ر باوه‌ڕت هه‌بێ‌ شكۆمه‌ندی خودا ده‌بینی؟) <verse eid="JHN 11:40" /><verse number="41" style="v" sid="JHN 11:41" />ئه‌وسا به‌رده‌كه‌یان لابردو عیسا سه‌یری ئاسمانی كردو ووتی: (ئه‌ی باوك، سوپاست ده‌كه‌م چونكه‌ گوێت لێ‌گرتم، <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" />من زانیومه‌ كه‌ تۆ هه‌میشه‌ گوێم لێ‌ده‌گری. به‌ڵام من ئه‌مه‌م ووت له‌به‌ر ئه‌و خه‌ڵكه‌ی له‌ ده‌وروپشتم ڕاوه‌ستاون تا باوه‌ڕ بهێنن تۆ منت ناردووه‌.) <verse eid="JHN 11:42" /><verse number="43" style="v" sid="JHN 11:43" />كاتێ‌ ئه‌مه‌ی ووت به‌ده‌نگێكی به‌رز بانگی كرد: (له‌عازر وه‌ره‌ ده‌ره‌وه‌!) <verse eid="JHN 11:43" /><verse number="44" style="v" sid="JHN 11:44" />ئه‌وسا مردووه‌كه‌ هاته‌ده‌ره‌وه‌، به‌كفن ده‌ست‏و قاچی به‌سترابوو، سه‌ریشی به‌قوماشێك پێچرابوو. لێره‌ عیسا به‌وانه‌ی ده‌وروپشتی ووت: (بیكه‌نه‌وه‌ با بڕوات. (<verse eid="JHN 11:44" /></para>
  <para style="s1">پلانێك ‏بۆ كوشتنی عیسا</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />ژماره‌یه‌كی زۆر له‌‏جووله‌كه‌كان له‌وانه‌ی كه‌ هاتبوون بۆ دڵنه‌وایی مریه‌م، كاتێ‌ ئه‌مه‌یان بینی باوه‌ڕیان هێنا به‌‏عیسا. <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />به‌ڵام هه‌ندێ‌ له‌وان چوونه‌ لای فه‌ریسیه‌كان تا هه‌واڵی ئه‌وه‌ بده‌ن كه‌ عیسا كردوویه‌تی. <verse eid="JHN 11:46" /><verse number="47" style="v" sid="JHN 11:47" />ئینجا سه‌رۆك كاهینه‌كان‏و فه‌ریسیه‌كان ئه‌نجومه‌نی باڵایان كۆكرده‌وه‌و ووتیان: (چی بكه‌ین؟ ئه‌م كابرایه‌ نیشانه‌ی سه‌رسوڕهێنه‌ری زۆر ده‌كات. <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />گه‌ر به‌م شێوه‌یه‌ وازی لـێ‌بهێنین هه‌موو خه‌ڵكه‌كه‌ باوه‌ڕی پێ‌ده‌هێنن، ئیتر ڕۆمانیه‌كان دێن‏و په‌رستگاكه‌مان له‌ناو ده‌به‌ن‏و میلله‌ته‌كه‌مان ڕاپێچ ده‌كه‌ن!) <verse eid="JHN 11:48" /><verse number="49" style="v" sid="JHN 11:49" />یه‌كێ‌ له‌وان كه‌‏ناوی قه‌یافا بوو ئه‌و ساڵه‌ سه‌رۆك كاهین بوو ووتی: (ئێوه‌ هیچ نازانن! <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />ئێوه‌ تێ‌ناگه‌ن باشتروایه‌ پیاوێك بمرێ‌ و ببێ‌ به‌‏قوربانی گه‌ل، له‌جیاتی ئه‌وه‌ی میلله‌ته‌كه‌ هه‌مووی له‌ناوبچێ‌.) <verse eid="JHN 11:50" /><verse number="51" style="v" sid="JHN 11:51" />قه‌یافا له‌خۆیه‌وه‌ ئه‌م قسه‌یه‌ی نه‌كرد، به‌ڵام چونكه‌ له‌و ساڵه‌دا كاهینی به‌رز بوو، پێشبینیكردبوو‏* كه‌ عیسا له‌‏پێناوی گه‌لدا ده‌مرێ‌، <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />ئه‌مه‌ش ته‌نها له‌پێناوی گه‌ل نا، به‌ڵكو هه‌روه‌ها له‌پێناوی كۆكردنه‌وه‌ی ڕۆڵه‌كانی خودا كه‌ په‌رشوبڵاوبوونه‌ته‌وه‌ تا بیانكات به‌یه‌ك. <verse eid="JHN 11:52" /><verse number="53" style="v" sid="JHN 11:53" />له‌و ڕۆژه‌وه‌ ئیتر جووله‌كه‌كان بڕیاریان‎دا عیسا بكوژن. <verse eid="JHN 11:53" /><verse number="54" style="v" sid="JHN 11:54" />ئیتر ئه‌ویش به‌‏ئاشكرا به‌ناویاندا نه‌ده‌رۆیشت، به‌ڵكو چوو بۆ شارێك ناوی ئه‌فرایم بوو، كه‌وتۆته‌ شوێنێكی نزیك بیابان، له‌وێ‌ له‌گه‌ڵ قوتابیه‌كانی مایه‌وه‌. <verse eid="JHN 11:54" /><verse number="55" style="v" sid="JHN 11:55" />له‌و كاته‌دا جه‌ژنی تێپه‌ڕبوونی جووله‌كه‌ نزیك بووبوه‌وه‌، خه‌ڵكێكی زۆر له‌لادێكانه‌وه‌ هاتبوون بۆ قودس تاكو هه‌ستن به‌‏مه‌راسیمی خۆپاك‎كردنه‌وه‌ی پێش جه‌ژن. <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />ئه‌وان به‌دوای عیسادا ده‌گه‌ڕان، كاتێ‌ له‌‏په‌رستگادا كۆبوونه‌وه‌ پرسییان: (ڕاتان چیه‌؟ ئایا نایه‌ت بۆ جه‌ژن؟) <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />سه‌رۆك كاهینه‌كان‏و فه‌ریسیه‌كان فه‌رمانیان ده‌ركردبوو كه‌وا هه‌ركه‌سێك عیسا ببینێ‌ ده‌بێ‌ خه‌به‌ری لـێ‌بدات تا بیگرن.<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s1">چه‌وركردنی عیسا بۆ مردن</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />شه‌ش ڕۆژ پێش جه‌ژنی تێپه‌ڕبوون عیسا هات بۆ دێی به‌یت‏عه‌نیا، ئه‌وه‌ی عیسا له‌عازری تیا زیندووكرده‌وه‌ له‌نێو مردوواندا. <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />له‌عازر داوه‌تی نانخواردنی ئێواره‌ی سازكرد بۆ عیسا، مه‌رسای خوشكی ده‌ستیكرد به‌‏خزمه‌تكردن، له‌عازر خۆی یه‌كێ‌ بوو له‌وانه‌ی له‌سه‌ر خوان له‌گه‌ڵ عیسادا دانیشتبوو. <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" />مریه‌میش سێیه‌كی لیترێك بۆنی ناردینی گرانبه‌های بێ‌غه‌شی هێناو هه‌ردوو قاچی عیسای پێ‌ چه‌وركرد، ئینجا به‌‏قژی هه‌ردوو قاچی سڕیه‌وه‌، ئیتر ماڵه‌كه‌ هه‌مووی پڕبوو له‌بۆنی خۆش. <verse eid="JHN 12:3" /><verse number="4" style="v" sid="JHN 12:4" />یه‌كێ‌ له‌‏قوتابیه‌كانی كه‌ یه‌هوزای ئه‌سخه‌ریوتی بوو، ئه‌وه‌ی له‌‏دواییدا ناپاكی له‌گه‌ڵدا ده‌كات ووتی: (‏ <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />بۆچی ئه‌م بۆنه‌ به‌‏سێ‌ سه‌د دینار‏* نه‌فرۆشراو دابه‌ش‏نه‌كرا به‌سه‌ر هه‌ژاراندا؟) <verse eid="JHN 12:5" /><verse number="6" style="v" sid="JHN 12:6" />ئه‌ویش ئه‌مه‌ی نه‌ووت چونكه‌ به‌زه‌یی به‌‏هه‌ژاراندا ده‌هاته‌وه‌، به‌ڵكو ‏له‌به‌رئه‌وه‌ی دز بوو، ئه‌و دانرا بوو به‌سه‌ر پاره‌ی سندوق به‌ڵام هه‌رچیه‌كی تیا دابنرایه‌ ده‌یدزی. <verse eid="JHN 12:6" /><verse number="7" style="v" sid="JHN 12:7" />عیساش وه‌ڵامی دایه‌وه‌: (وازی لـێ‌بهێنه‌! ئه‌و ئه‌م بۆنه‌ی هه‌ڵگرتبوو بۆ ڕۆژی ناشتنم، <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />چونكه‌ هه‌ژاران هه‌موو كاتێ‌ لاتانن، به‌ڵام من هه‌موو كاتێ‌ لاتان نیم.) <verse eid="JHN 12:8" /><verse number="9" style="v" sid="JHN 12:9" />كاتێ‌ ژماره‌یه‌كی زۆر له‌‏جووله‌كه‌كان زانییان عیسا له‌وێیه‌، هاتن ته‌نها بۆ ئه‌وه‌نا كه‌ عیسا ببینن، به‌ڵكو بۆ ئه‌وه‌ش له‌عازر ببینن كه‌ له‌‏نێو مردوواندا زیندووی كردبووه‌وه‌. <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />ئه‌وسا سه‌رۆك كاهینه‌كان بڕیاریان‎دا له‌عازریش بكوژن، <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />چونكه‌ ژماره‌یه‌كی زۆر له‌ جووله‌كه‌كان به‌هۆی ئه‌وه‌وه‌ ده‌هاتن‏و باوه‌ڕیان به‌عیسا ده‌‏هێنا‏.<verse eid="JHN 12:11" /></para>
  <para style="s1">چوونه‌ ناو قودس وه‌ك پادشا</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />ڕۆژێ‌ دوایی، ژماره‌یه‌كی زۆر له‌ خه‌ڵكی كه‌ هاتبوون بۆ جه‌ژن، بیستیان عیسا هاتووه‌ بۆ قودس. <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />لقه‌ دار خورمایان برد له‌گه‌ڵ خۆیان‏و هاتنه‌ده‌ره‌وه‌ بۆ پێشوازیكردنیو هاواریان‏كرد: (هۆسانا! پیرۆزه‌ ئه‌وه‌ی به‌ناوی خوداوه‌نده‌وه‌ دێت! ئه‌و پادشای ئیسرائیله‌!) <verse eid="JHN 12:13" /><verse number="14" style="v" sid="JHN 12:14" />عیسا جاشكێكی بینی‏، سواری بوو، وه‌ك له‌كتێبی پیرۆزدا نووسراوه‌: <verse eid="JHN 12:14" /><verse number="15" style="v" sid="JHN 12:15" />[[مه‌ترسه‌ ئه‌ی كچی شاری داود، پادشاكه‌ت دێته‌ لات به‌ سواری جاش ماكه‌رێك.]] <verse eid="JHN 12:15" /><verse number="16" style="v" sid="JHN 12:16" />قوتابیه‌كانی عیسا یه‌كه‌مجار ئه‌مانه‌ تێنه‌گه‌یشتن. به‌ڵام پاش ئه‌وه‌ی عیسا شكۆداركرا، بیریان كه‌وته‌وه‌ كه‌ له‌كتێبی پیرۆزدا ئه‌مه‌ ده‌رباره‌ی نووسراوه‌، ئه‌وانیش ئه‌مه‌یان‏كرد بوو بۆ ئه‌و.<verse eid="JHN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17" />ئه‌و خه‌ڵكه‌ی كه‌ له‌گه‌ڵیدا بوون كاتێ‌ له‌عازری بانگكرد له‌‏گۆڕداو زیندووی كرده‌وه‌ له‌نێو مردووان، شایه‌تی ئه‌مه‌یان بۆ ده‌دا. <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />جا له‌به‌رئه‌وه‌ خه‌ڵكه‌كه‌ هاتنه‌ده‌ره‌وه‌ بۆ پێشوازی، چونكه‌ بیستبوویان كه‌ ئه‌و نیشانه‌‏ سه‌رسوڕهێنه‌ره‌ی كردووه‌. <verse eid="JHN 12:18" /><verse number="19" style="v" sid="JHN 12:19" />‏فه‌ریسیه‌كان به‌‏یه‌كتریان ووت: (‏ده‌بینن بێ‌‏سووده‌؟ ئا ئه‌وه‌تا هه‌موو جیهان شوێنی كه‌وتووه‌!)<verse eid="JHN 12:19" /></para>
  <para style="s1">مردن ده‌رگایه‌ بۆ ژیان</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />هه‌ندێ‌ یۆنانی له‌گه‌ڵ ئه‌و خه‌ڵكه‌بوون كه‌ له‌جه‌ژندا هاتبوون بۆ خوداپه‌رستی، <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />ئه‌وسا چوونه‌ لای فیلیپۆس كه‌ خه‌ڵكی شاری سه‌یدای ناوچه‌ی جه‌لیل بوو، پێیان ووت: (گه‌وره‌م، ده‌مانه‌وێ‌ عیسا ببینین.) <verse eid="JHN 12:21" /><verse number="22" style="v" sid="JHN 12:22" />فیلیپۆس ڕۆیشت‏و ئه‌مه‌ی به‌ ئه‌نده‌راوس ووت، ئینجا به‌یه‌كه‌وه‌ ڕۆیشتن هه‌واڵیان‎دا به‌ عیسا.<verse eid="JHN 12:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 12:23" />جا عیسا پێی ووتن: (ئه‌وه‌تا كاتی شكۆداركردنی ڕۆڵه‌ی مرۆڤ نزیك بووه‌ته‌وه‌. <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />ڕاستی ڕاستیتان پێ‌ده‌ڵێم: ده‌نكه‌ گه‌نم هه‌روه‌ك خۆی ده‌مێنێته‌وه‌، گه‌ر نه‌كه‌وێته‌ ناو زه‌وی‏و نه‌مرێ‌‏، به‌ڵام كه‌ مرد ئه‌وكاته‌ ده‌نكی زۆری لـێ‌به‌به‌ردێ‌. <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" />ئه‌وه‌ی ژیانی خۆی خۆش بوێ‌، ده‌یدۆڕێنێ‌. ئه‌وه‌ش كه‌ ڕقی له‌‏ژیانی خۆی ده‌بێته‌وه‌ له‌م جیهانه‌دا، ده‌یهێڵێته‌وه‌ بۆ ژیانی هه‌تاهه‌تایی. <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" />ئه‌وه‌ی ده‌یه‌وێ‌ خزمه‌تم بكات با شوێنم بكه‌وێ‌. جا من له‌هه‌ر شوێنێكدابم، خزمه‌تكاریشم له‌وێیه‌. هه‌روه‌ها هه‌ر‏كه‌سێ‌ خزمه‌تم بكات باوكم ڕێزی لـێ‌ده‌گرێ‌.<verse eid="JHN 12:26" /></para>
  <para style="s1">عیسا باسی مردنی خۆی ده‌كات</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27" />(‏ئێستا دڵم ته‌نگه‌، چی بڵێم؟ ئه‌ی باوك‏، ڕزگارم ‎بكه‌ له‌و‏كاته‌ سه‌خته‌ی چاوه‌ڕێم ده‌كات؟ نه‌خێر! له‌پێناوی ڕوودانی ئه‌م كاته‌ هاتووم. <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />جا ئه‌ی باوك، ناوی خۆت شكۆداركه‌!) له‌وكاته‌دا ده‌نگێ‌ له‌‏ئاسمانه‌وه‌ وه‌ڵامی دایه‌وه‌: (شكۆدارم كردووه‌و شكۆداریشی ده‌كه‌مه‌وه‌.) <verse eid="JHN 12:28" /><verse number="29" style="v" sid="JHN 12:29" />هه‌ندێ‌ له‌وانه‌ی له‌وێ‌ ئاماده‌بوون كاتێ‌ گوێیان له‌‏ده‌نگه‌كه‌ بوو ووتیان: (ئه‌مه‌ ده‌نگی هه‌وره‌!) به‌ڵام هه‌ندێكی كه‌یان ووتیان: (فریشته‌ بوو قسه‌ی له‌گه‌ڵ كرد.) <verse eid="JHN 12:29" /><verse number="30" style="v" sid="JHN 12:30" />عیسا له‌وه‌ڵامدا ووتی: (ئه‌م ده‌نگه‌ له‌‏پێناوی من نه‌بوو، به‌ڵكو له‌‏پێناوی ئێوه‌ بوو. <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />ئێستا كاتی حوكم‎دانه‌ به‌سه‌ر ئه‌م جیهانه‌! ئێستا سه‌رۆكی ئه‌م جیهانه‌ ده‌كرێته‌ ده‌ره‌وه‌! <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />كاتێ‌ من له‌سه‌ر زه‌وی به‌رزده‌كرێمه‌وه‌، هه‌مووان بانگ‎ده‌كه‌م بۆ لای خۆم.) <verse eid="JHN 12:32" /><verse number="33" style="v" sid="JHN 12:33" />عیسا ئه‌مه‌ی ووت تا ده‌ست‏نیشانیكات به‌چ شێوه‌یه‌ك ده‌مرێ‌. <verse eid="JHN 12:33" /><verse number="34" style="v" sid="JHN 12:34" />‏خه‌ڵكه‌كه‌ پێیان‎ووت: (ئێمه‌ له‌‏شه‌ریعه‌تدا بیستوومانه‌ مه‌سیح تاهه‌تایه‌ به‌‏زیندوویه‌تی ده‌مێنێته‌وه‌، ئیتر چۆن تۆ ده‌ڵێی ڕۆڵه‌ی مرۆڤ ده‌بێ‌ به‌رزبكرێته‌وه‌؟ ئه‌م ڕۆڵه‌ی مرۆڤه‌ كێیه‌؟) <verse eid="JHN 12:34" /><verse number="35" style="v" sid="JHN 12:35" />عیسا پێی ووتن: (ڕووناكی كاتێكی كورت له‌گه‌ڵتان ده‌مێنێته‌وه‌. جـا به‌رده‌وام‎بن له‌ڕۆیشتن تا دونیا ڕووناكه‌‏و تاریكیتان به‌سـه‌ردا نه‌هـاتووه‌، چـونكه‌ ئه‌وه‌ی به‌‏تاریكـیدا ده‌ڕوات نازانێ‌ بۆ كــوێ‌ ده‌ڕوات. <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" />باوه‌ڕبهێنن به‌‏ڕووناكـی هه‌تا ڕووناكـیتان لـه‌گـه‌ڵدایه‌، ئه‌وكــاته‌ ده‌بنه‌ ڕۆڵه‌ی ڕووناكی.) دوای ئه‌وه‌ی عیسـا ئه‌مــه‌ی ووت، ڕۆیشت‏و خۆی لێیان شــارده‌وه‌‏. <verse eid="JHN 12:36" /><verse number="37" style="v" sid="JHN 12:37" />‏لــه‌گـه‌ڵ ئه‌وه‌ی كه‌ زۆر نیشانه‌ی سه‌رسورهێنه‌ری له‌به‌رده‌میان‏كرد، باوه‌ڕیان پێ‌نه‌هێنا، <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />تا ووته‌ی ئه‌شعیای پێغه‌مبه‌ر بێته‌دی: [[ئه‌ی خـوداوه‌ند كـێ‌ باوه‌ڕی هێنا به‌ ووته‌كانمان؟ ده‌ستی خوداوه‌ند بۆ كێ‌ ده‌ركه‌وت؟]] <verse eid="JHN 12:38" /><verse number="39" style="v" sid="JHN 12:39" />ئه‌وان نه‌یانتوانی باوه‌ڕبهێنن، چونكه‌ ئه‌شعیا دیسان ووتبووی: <verse eid="JHN 12:39" /><verse number="40" style="v" sid="JHN 12:40" />[[چاویانی كوێرو دڵیانی ڕه‌ق‏كردووه‌، تاكو به‌چاویان نه‌بینن‏و به‌دڵیان هه‌ست نه‌كه‌ن، ئه‌وسا بگه‌رێنه‌وه‌و چاكیان بكه‌مه‌وه‌.]] <verse eid="JHN 12:40" /><verse number="41" style="v" sid="JHN 12:41" />ئه‌شعیا ئه‌مـه‌ی ووت بوو، چـونكه‌ شـكۆی ئه‌وی بینی بوو و باسیكـرد بوو. <verse eid="JHN 12:41" /><verse number="42" style="v" sid="JHN 12:42" />لـه‌گـه‌ڵ ئه‌وه‌شدا ژماره‌یه‌كی زۆر لــه‌‏سه‌رۆكه‌كان باوه‌ڕیان به‌ عیسا كـرد، بێ‌ئــه‌وه‌ی باوه‌ڕه‌كـه‌یان ده‌ربخه‌ن، له‌‏ترسی ئه‌وه‌ی فه‌رمانی ده‌ركـردنیان له‌كه‌نیشتدا به‌سه‌ر بدرێ‌، <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />چونكـه‌ ئه‌وان زیاتر حـه‌زیان لـه‌شـكۆی خـه‌ڵكـی بوو نه‌ك شـكۆی خـودا.<verse eid="JHN 12:43" /></para>
  <para style="s1">ڕووناكی باوه‌ڕ</para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />ئینجا عیسا به‌ده‌نگێكی به‌رز ووتی: (ئه‌وه‌ی باوه‌ڕم پێ‌بهێنێ‌، ‏باوه‌ڕ به‌‏من ناهێنێ‌ به‌ڵكو به‌وه‌ی كه‌ ناردوومی، <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />ئه‌وه‌ش منی بینیوه‌، ئه‌وه‌ی بینیوه‌ كه‌ ناردوومی. <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />من وه‌ك ڕووناكی هاتومه‌ته‌ جیهان، تائه‌وه‌ی باوه‌ڕم پێ‌بهێنێ‌ له‌ تاریكیدا نه‌مێنێته‌وه‌. <verse eid="JHN 12:46" /><verse number="47" style="v" sid="JHN 12:47" />گه‌ر یه‌كێ‌ گوێی له‌‏ووته‌كانم بوو و كاری پێ‌نه‌كرد، من حوكم ناده‌م به‌سه‌ری، چونكه‌ من نه‌هاتووم تا حوكم به‌سه‌ر جیهاندا بده‌م‏، به‌ڵكو هاتووم بۆ ڕزگاری جیهان. <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />ئه‌وه‌ی دانم‎پیانه‌نێ‌‏و به‌‏ووته‌كانم ڕازی نه‌بێ‌، هه‌یه‌ كه‌وا حوكم‎بدا به‌سه‌ری، ئه‌و ووشه‌یه‌ی كه‌ ووتم ئه‌و حوكم ده‌دات به‌سه‌ری له‌‏ڕۆژی دواییدا، <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />چونكه‌ من هیچ شتێكم له‌‏خۆمه‌وه‌ نه‌وتووه‌، به‌ڵكو ئه‌و باوكه‌ی ناردوومی چی ڕاسپاردووم ئه‌وه‌ ده‌ڵێم. <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />هه‌روه‌ها من ده‌زانم ڕاسپارده‌ی ئه‌و ژیانی هه‌تاهه‌تاییه‌، جا هه‌ر ووته‌یه‌ك من ده‌یڵێم، به‌و شــێوه‌یه‌ ده‌یڵێم كه‌ باوكم پێی ووتووم.(<verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s1">عیسا قاچی قوتابیه‌كانی ده‌شوات</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />پێش جه‌ژنی تێپه‌ڕبوون، عیسا ده‌یزانی كاتی هاتووه‌ ئه‌م جیهانه‌ به‌جێ‌بهێڵێ‌و بڕواته‌ لای باوك، ئه‌و چۆن ئه‌وانه‌ی سه‌ر به‌ئه‌و بوون له‌ جیهاندا خۆشیده‌ویستن، ئێستاش به‌وپه‌ڕی خۆشه‌ویستییه‌وه‌ خۆشیده‌وێن. <verse eid="JHN 13:1" /><verse number="2" style="v" sid="JHN 13:2" />كاتی نانخواردنی ئێواره‌، شه‌یتان خستیه‌ دڵی یه‌هوزای كوڕی شه‌معونی ئه‌سخه‌ریوتی كه‌وا ناپاكی له‌گه‌ڵ عیسادا بكات، <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />به‌ڵام عیسا ده‌یزانی باوك هه‌موو شتێكی خستۆته‌ ژێرده‌ستی، هه‌روه‌ها ئه‌و له‌‏خوداوه‌ هاتووه‌‏و بۆ خوداش ده‌گه‌ڕێته‌وه‌، <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />‏بۆیه‌ له‌سه‌ر خوان هه‌ستا، كه‌واكه‌ی داكه‌ندو خاولـییه‌كی هه‌ڵگرت‏و به‌ستی به‌ناو قه‌دیه‌وه‌، <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />ئینجا ئاوی كرده‌ له‌گه‌نێكه‌وه‌ بۆ شوشتن، ده‌ستیكرد به‌‏شوشتنی قاچی قوتابیه‌كانی‏و به‌و خاولـییه‌ی به‌ناو قه‌دیه‌وه‌ به‌ستبووی بۆی سڕینه‌وه‌. <verse eid="JHN 13:5" /><verse number="6" style="v" sid="JHN 13:6" />كاتێ‌ گه‌یشته‌ سه‌ر شه‌معون په‌ترۆس، شه‌معون پێی ووت: (گه‌وره‌م، تۆ قاچی من ده‌شۆیت؟) <verse eid="JHN 13:6" /><verse number="7" style="v" sid="JHN 13:7" />عیسا له‌وه‌ڵامدا ووتی: (تۆ ئێستا ئه‌مه‌ی ده‌یكه‌م تێیناگه‌ی، به‌ڵام دوایی تێیده‌گه‌یت.) <verse eid="JHN 13:7" /><verse number="8" style="v" sid="JHN 13:8" />په‌ترۆس پێی ووت: (نه‌خێر، هه‌رگیز قاچم ناشۆیت!) عیساش وه‌ڵامی دایه‌وه‌: (ئه‌گه‌ر نه‌ت‎شۆم، له‌گه‌ڵ من به‌شت نابێ‌!) <verse eid="JHN 13:8" /><verse number="9" style="v" sid="JHN 13:9" />جا شه‌معون په‌ترۆس پێی ووت: (گه‌وره‌م، ته‌نها قاچم نا، به‌ڵكو ده‌ست‏و سه‌ریشم!) <verse eid="JHN 13:9" /><verse number="10" style="v" sid="JHN 13:10" />‏عیسا ووتی: (ئه‌وه‌ی خۆی شوشتبێ‌، به‌ته‌واوی بێگه‌رده‌ هیچیتری پێویست نییه‌، ته‌نها قاچی بشۆرێ‌، ‏ئێوه‌ بێگه‌ردن، به‌ڵام هه‌مووتان نا.) <verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />چونكه‌ عیسا ده‌یزانی كێ‌ له‌‏دواییدا ناپاكی له‌گه‌ڵدا ده‌كات، بۆیه‌ ووتی: (هه‌مووتان بێگه‌رد نین.(<verse eid="JHN 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12" />دوای ئه‌وه‌ی عیسا ته‌واو بوو له‌‏شوشتنی قاچیان، كه‌واكه‌ی هه‌ڵگرت، سه‌رله‌نوێ‌ له‌سه‌ر خوان دانیشت‏و لێیپرسین: (ئایا تێ‌گه‌یشتن له‌وه‌ی بۆم كردن؟ <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />ئێوه‌ پێم‎ده‌ڵێن مامۆستاو گه‌وره‌، جا ڕاست‎ده‌كه‌ن من وام. <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />گه‌ر من گه‌وره‌و مامۆستاتان بم، قاچم شوشتن، ئیتر ئێوه‌ش له‌سه‌رتانه‌ قاچی یه‌كتری بشۆن. <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />من نموونه‌یه‌كم پێدان هه‌تا ئه‌وه‌ی من بۆتانم كرد ئێوه‌ش بیكه‌ن. <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" />ڕاستی ڕاستیتان پێ‌ده‌ڵێم: كۆیله‌ گه‌وره‌تر نییه‌ له‌ گه‌وره‌كه‌ی، نێرراو گه‌وره‌تر نییه‌ له‌وه‌ی ناردوویه‌تی. <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />گه‌ر هاتوو ئێوه‌ ئه‌مه‌تان زانی، خۆزگه‌تان پێ‌ده‌خوازری گه‌ر كارتان پێ‌كرد. <verse eid="JHN 13:17" /><verse number="18" style="v" sid="JHN 13:18" />ئه‌مه‌ به‌هه‌مووتان ناڵێم، چونكه‌ ئه‌وانه‌ی هه‌ڵمبژاردون ده‌یانناسم، به‌ڵام ئه‌وه‌ی له‌كتێب‏دایه‌ ده‌بێ‌ بێته‌دی كه‌ ده‌ڵێ‌: [[‏ئه‌وه‌ی نانم له‌گه‌ڵ ده‌خوات، ناپاكیم له‌گه‌ڵ ده‌كات!‏]] <verse eid="JHN 13:18" /><verse number="19" style="v" sid="JHN 13:19" />ئه‌وه‌ی ڕووده‌دات من پێش ڕوودانی پێتان‎ ده‌ڵێم، تاكو كاتێ‌ ڕوویدا باوه‌ڕبهێنن من ئه‌وم. <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" />ڕاستی ڕاستیتان پێ‌ده‌ڵێم: هه‌ر كه‌سێ‌ ئه‌و كه‌سه‌ی بوێت كه‌ من بۆی ده‌نێرم، ئه‌وه‌ منی ده‌وێت، ئه‌وه‌ش منی بوێت، ئه‌وه‌ی ده‌وێت كه‌ ناردوومی.(<verse eid="JHN 13:20" /></para>
  <para style="s1">ناپاكی یه‌هوزا</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />كاتێ‌ عیسا ئه‌مانه‌ی ووت، له‌ڕۆحدا دڵته‌نگ بوو و به‌ئاشكرا ووتی: (ڕاستی ڕاستیتان پێ‌ده‌ڵێم: یه‌كێ‌ له‌‏ئێوه‌ ده‌م‎دات به‌ده‌سته‌وه‌!) <verse eid="JHN 13:21" /><verse number="22" style="v" sid="JHN 13:22" />قوتابیه‌كانی به‌سه‌رسامیه‌وه‌ سه‌یری یه‌كتریان كردو نه‌یان‎ده‌زانی مه‌به‌ستی له‌‏كێیه‌. <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />یه‌كێ‌ له‌قوتابیه‌كان كه‌ عیسا خۆشیده‌ویست له‌ته‌نیشتی پاڵی دابووه‌وه‌، <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />شه‌معون په‌ترۆس ئیشاره‌تی بۆی كرد تا پرسیار له‌‏عیسا بكات ‏مه‌به‌ستی له‌كێیه‌. <verse eid="JHN 13:24" /><verse number="25" style="v" sid="JHN 13:25" />ئه‌ویش شانیدایه‌ سه‌ر سینگی عیساو لێیپرسی: (گه‌وره‌م ئه‌و كه‌سه‌ كێیه‌‏؟) <verse eid="JHN 13:25" /><verse number="26" style="v" sid="JHN 13:26" />عیسا له‌وه‌ڵامدا ووتی: (ئه‌و كه‌سه‌یه‌ پارووه‌ نانه‌كه‌ ده‌خه‌مه‌ ناو قاپه‌كه‌و ده‌یده‌مێ‌.) ئینجا پارووه‌كه‌ی كرده‌ ناو قاپه‌كه‌و دای به‌ یه‌هوزای كوڕی شه‌معونی ئه‌سخه‌ریوتی. <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />پاش پارووه‌كه‌، شه‌یتان چووه‌ ناویه‌وه‌. ئینجا عیسا پێی ووت: (خێرا بیكه‌ ئه‌وه‌ی ده‌ته‌وێ‌ بیكه‌یت!) <verse eid="JHN 13:27" /><verse number="28" style="v" sid="JHN 13:28" />هیچ كه‌سێ‌ له‌وانه‌ی له‌سه‌ر خوانه‌كه‌ له‌گه‌ڵیدا بوون، تێ‌نه‌گه‌یشتن بۆچی ئه‌مه‌ی پێ‌ووت، <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />به‌ڵكو هه‌ندێكیان له‌و باوه‌ڕه‌دا بوون كه‌وا فه‌رمانی پێ‌ده‌دا چییان پێویسته‌ له‌جه‌ژنا بۆیان بكڕێ‌، یاخود هه‌ندێ‌ پاره‌ بدات به‌‏هه‌ژاران، چونكه‌ سه‌رپه‌رشتیاری سندوق بوو. <verse eid="JHN 13:29" /><verse number="30" style="v" sid="JHN 13:30" />دوای ئه‌وه‌ی یه‌هوزا پارووه‌كه‌ی خوارد، چووه‌ ده‌ره‌وه‌، كات شه‌وبوو.<verse eid="JHN 13:30" /></para>
  <para style="s1">ڕاسپارده‌ی تازه‌</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />كاتێ‌ یه‌هوزا چووه‌ ده‌ره‌وه‌، عیسا ووتی: (ئێستا ڕۆڵه‌ی مرۆڤ شكۆداره‌و خودا تیایدا شكۆداركرا. <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" />جا ئه‌گه‌ر خودا له‌ودا شكۆداره‌، به‌هه‌مان شێوه‌ خودا ده‌یه‌وێ‌ ئه‌ویش شكۆدار بكات له‌خۆیدا‏و هه‌ر ئێستا شكۆداری ده‌كات. <verse eid="JHN 13:32" /><verse number="33" style="v" sid="JHN 13:33" />منداڵه‌كانم، ماوه‌یه‌كی كورت له‌گه‌ڵتان ده‌مێنمه‌وه‌، ئه‌وسا داوام ده‌كه‌ن، به‌ڵام ئه‌وه‌ی پێشتر به‌جووله‌كه‌كانم ووت ئێستا به‌ ئێوه‌شی ده‌ڵێم‏: ئێوه‌ ناتوانن بێن بۆ ئه‌و شوێنه‌ی من بۆی ده‌ڕۆم. <verse eid="JHN 13:33" /><verse number="34" style="v" sid="JHN 13:34" />من ڕاسپارده‌یه‌كی تازه‌تان پێ‌‏ڕاده‌سپێرم: یه‌كتریتان ‎خۆش بوێ‌. هه‌روه‌ك چۆن من خۆشم‏ویستن، ئاوا یه‌كترتان خۆش‎بوێ‌. <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />به‌مه‌ هه‌موو خه‌ڵكی ده‌زانن كه‌ قوتابی منن، گه‌ر ئێوه‌ یه‌كتریتان خۆش‏ویست.(<verse eid="JHN 13:35" /></para>
  <para style="s1">پێشبینیكردنی ‏لاوازی په‌ترۆس‏</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />ئینجا شه‌معون په‌ترۆس لێیپرسی: (گه‌وره‌م، بۆ كوێ‌ ده‌ڕۆیت؟) عیساش وه‌ڵامی دایه‌وه‌: (ئه‌و جێیه‌ی بۆی ده‌ڕۆم، ئێستا ناتوانی دوام بكـه‌وی، بـه‌ڵام دوایی دوام ده‌كه‌وی.) <verse eid="JHN 13:36" /><verse number="37" style="v" sid="JHN 13:37" />دیسان په‌ترۆس پرسـیاری لـێ‌كرده‌وه‌: (گه‌وره‌م، بۆچی ئێستا ناتوانم دوات‎كه‌وم؟ من ژیانم له‌پێناوی تۆ داده‌نێم!) <verse eid="JHN 13:37" /><verse number="38" style="v" sid="JHN 13:38" />عیسا وه‌ڵامی دایه‌وه‌: (ئایا ژیانت لـه‌پێناوی من به‌خت ده‌كه‌یت؟ ڕاستی ڕاسـتیت پێ‌ده‌ڵێم: پێـش ئه‌وه‌ی كـه‌ڵه‌شـێر بخوێنێ‌‏، تۆ سێ‌جــار نـكۆڵیم لێ‌ده‌كـه‌ی!)<verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s1">دڵته‌نگ مه‌بن</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />(دڵته‌نگ مه‌بن. ئێوه‌ باوه‌ڕتان به‌‏خودا هه‌یه‌، كه‌واته‌ باوه‌ڕیش به‌من بكه‌ن. <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />ماڵی باوكم ژووری زۆری لێیه‌، گه‌ر وا‏نه‌بووایه‌ ئه‌وسا پێم‎ ده‌ووتن، من ده‌ڕۆم بۆ ئه‌وێ‌ تا شوێنتان بۆ ئاماده‌بكه‌م. <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />دوای ئه‌وه‌ی ڕۆیشتم‏و شوێنم بۆ ئاماده‌كردن، ده‌گه‌ڕێمه‌وه‌ لاتان‏و له‌گه‌ڵ خۆم ده‌تانبه‌م، تاكو ئێوه‌ش له‌و شوێنه‌ بن كه‌ منی لێده‌بم. <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />ئێوه‌ ڕێگای ئه‌و شوێنه‌ پێ‌ده‌زانن كه‌ من بۆی ده‌چم.)<verse eid="JHN 14:4" /></para>
  <para style="s1">من ڕێگاو ڕاستیو ژیانم</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5" />ئینجا تۆما ووتی: (گه‌وره‌م، نازانین تۆ بۆكوێ‌ ده‌ڕۆی، ئیتر چۆن ڕێگه‌كه‌ بزانین؟) <verse eid="JHN 14:5" /><verse number="6" style="v" sid="JHN 14:6" />عیسا وه‌ڵامی دایه‌وه‌: (من ڕێگاو ڕاستی‏و ژیانم. كه‌س نایه‌ت بۆ لای باوك به‌هۆی منه‌وه‌ نه‌بێ‌. <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />گه‌ر ئێوه‌ من بناسن، ئه‌وا باوكیشم ده‌ناسن، له‌ئێستا به‌دواوه‌ ده‌یناسن‏و بینیوتانه‌.) <verse eid="JHN 14:7" /><verse number="8" style="v" sid="JHN 14:8" />لێره‌ فیلیپۆس پێی ووت: (گه‌وره‌م، باوكمان نیشان‎ بده‌ ئیتر به‌سمانه‌!)</para>
  <para style="p" vid="JHN 14:8">‏ <verse eid="JHN 14:8" /><verse number="9" style="v" sid="JHN 14:9" />عیسا وه‌ڵامی دایه‌وه‌: (ماوه‌یه‌كی دوورو درێژه‌ من له‌گه‌ڵتانم هێشتا هه‌ر نه‌تناسیوم ئه‌ی فیلیپۆس؟ ئه‌وه‌ی منی بینیوه‌ باوكی بینیوه‌، ئیتر چۆن ده‌ڵێی باوكمان نیشان‎بده‌؟ <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />ئایا باوه‌ڕ ناهێنی من له‌باوكدام، باوكیش له‌‏مندایه‌؟ ئه‌و قسانه‌ی كه‌ ده‌یڵێم له‌خۆمه‌وه‌ نایڵێم، به‌ڵكو ئه‌و باوكه‌ی له‌مندا نیشته‌جێ‌ بووه‌، ئه‌و كاره‌كانی خۆی ده‌كات. <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />باوه‌ڕم پێ‌بكه‌ن من له‌باوكدام‏و باوكیش له‌‏مندایه‌، ئه‌گه‌ر نا باوه‌ڕم پێ‌بكه‌ن به‌هۆی كاره‌كان خۆیانه‌وه‌. <verse eid="JHN 14:11" /><verse number="12" style="v" sid="JHN 14:12" />ڕاستی ڕاستیتان پێ‌ده‌ڵێم: ئه‌وه‌ی باوه‌ڕ به‌من بكات ئه‌و كارانه‌ ده‌كات كه‌ من ده‌یكه‌م، به‌ڵكو له‌وانه‌ش مه‌زنتر ده‌كات، چونكه‌ من بۆ لای باوك ده‌ڕۆم‏. <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />هه‌رچیه‌ك به‌ناوی منه‌وه‌ داوابكه‌ن بۆتانی ده‌كه‌م، هه‌تا باوك له‌ڕۆڵه‌دا شكۆداربێ‌. <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />گه‌ر شتێكتان به‌ناوی من داواكرد، من بۆتانی ده‌كه‌م.)<verse eid="JHN 14:14" /></para>
  <para style="s1">به‌ڵێنی هاتنی ڕۆحی پیرۆز</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />(گه‌ر ئێوه‌ منتان خۆش بوێ‌ به‌ڕاسپارده‌كانم كارده‌كه‌ن‏. <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />ئه‌وسا له‌‏باوكم داواده‌كه‌م یارمه‌تیده‌رێكی* دیكه‌تان بداتێ‌و تاهه‌تایه‌ له‌گه‌ڵتان بمێنێته‌وه‌، <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />ئه‌وه‌ش ڕۆحی ڕاستییه‌، كه‌وا جیهان ناتوانێ‌ وه‌ریگرێ‌ چونكه‌ نایبینێت‏و نایناسێت، به‌ڵام ئێوه‌ ده‌یناسن چونكه‌ له‌گه‌ڵتان ده‌مێنێته‌وه‌و له‌ناوتان ده‌بێت. <verse eid="JHN 14:17" /><verse number="18" style="v" sid="JHN 14:18" />به‌‏هه‌تیوی به‌جێتان ناهێڵیم، به‌ڵكو ده‌گه‌ڕێمه‌وه‌ لاتان. <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />پاش ماوه‌یه‌كی كه‌م جیهان نام‎بینێت، به‌ڵام ئێوه‌ ده‌م‎بینن. جا‏چونكه‌ من زیندووم، ئێوه‌ش هه‌روه‌ها زیندووده‌بنه‌وه‌. <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />له‌و ڕۆژه‌‏دا ده‌زانن باوك له‌‏مندایه‌، ئێوه‌ش له‌مندان، منیش له‌ ئێوه‌دام. <verse eid="JHN 14:20" /><verse number="21" style="v" sid="JHN 14:21" />ئه‌وه‌ی ڕاسپارده‌كانی منی لایه‌و كاریپێ‌ ده‌كات، ئه‌وه‌ منی خۆش‎ده‌وێت. ئه‌وه‌ی منی خۆش‏بوێ‌، باوكم خۆشی‎ده‌وێ‌، منیش خۆشم‏ده‌وێ‌و خۆمی پێ‌نیشان ده‌ده‌م.)<verse eid="JHN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22" />ئینجا یه‌هوزا‏یه‌كیتر كه‌ یه‌هوزای ئه‌سخه‌ریوتی نه‌بوو، پرسیاری لـێ‌كرد‏: (گه‌وره‌م، بۆچی ده‌ته‌وێ‌ خۆت بۆ ئێمه‌ ده‌رخه‌یت به‌ڵام بۆ جیهان نا؟) <verse eid="JHN 14:22" /><verse number="23" style="v" sid="JHN 14:23" />عیسا وه‌ڵامی دایه‌وه‌: (ئه‌وه‌ی منی خۆش بووێت كار به‌‏ووته‌كانم ده‌كات، باوكیشم خۆشی ده‌وێت، ئێمه‌ بۆ لای ئه‌و دێین‏و لای ئه‌و نیشته‌جێ‌ ده‌بین. <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />ئه‌وه‌ش منی خۆش ناوێ‌ كارناكات به‌ ووته‌كانم. ئه‌م ووشانه‌ی گوێتان لـێ‌ده‌بێ‌ هی من نییه‌، به‌ڵكو هی ئه‌و باوكه‌یه‌ كه‌ ناردوومی. <verse eid="JHN 14:24" /><verse number="25" style="v" sid="JHN 14:25" />من ئه‌م شتانه‌م پێ‌‎ووتن له‌كاتێكدا هێشتا لاتانم. <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />به‌ڵام ڕۆحی پیرۆز، ئه‌و یارمه‌تیده‌ره‌ی باوك به‌ناوی من ده‌ینێرێ‌، هه‌موو شتێكتان فێر ده‌كات، هه‌روه‌ها هه‌موو ئه‌و شتانه‌ی پێم‎ ووتوون بیرتان ده‌خاته‌وه‌.<verse eid="JHN 14:26" /></para>
  <para style="s1">ئاشتی عیسا</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 14:27" />(ئاشتیتان بۆ به‌جێ‌ده‌هێڵم. ئاشتی خۆمتان ده‌ده‌مێ‌. به‌ڵام به‌و شێوه‌یه‌ نا كه‌ جیهان ده‌تان‎داتێ‌. دڵته‌نگ مه‌بن، هه‌روه‌ها مه‌ترسن. <verse eid="JHN 14:27" /><verse number="28" style="v" sid="JHN 14:28" />گوێتان لـێ‌بوو من پێم‎ووتن: من لاتان ده‌ڕۆم‏و دواتر ده‌گه‌ڕێمه‌وه‌ لاتان. گه‌ر ئێوه‌ منتان خۆش بوێ‌، دڵشاد ده‌بن چونكه‌ من ده‌ڕۆم بۆلای باوك، له‌به‌رئه‌وه‌ی باوك له‌‏من مه‌زنتره‌. <verse eid="JHN 14:28" /><verse number="29" style="v" sid="JHN 14:29" />ئه‌وه‌تا ئێستا هه‌واڵی ئه‌وه‌م پێ‌دان پێش ڕوودانی، بۆ ئه‌وه‌ی هه‌ركاتێ‌ ڕوویدا باوه‌ڕبهێنن. <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" />ئیتر له‌مه‌ولا زۆر قسه‌تان له‌گه‌ڵ ناكه‌م، چونكه‌ گه‌وره‌ی ئه‌م جیهانه‌ وا دێت‏و هیچ ده‌سه‌ڵاتێكی به‌سه‌ر من نییه‌. <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />به‌ڵام ده‌بێ‌ جیهان بزانێ‌ من باوكم خۆش ده‌وێ‌، هه‌روه‌ها باوك چۆن ڕای‏سپاردم وا ڕه‌فتار ده‌كه‌م. هه‌ستن! با لێره‌ بڕۆین!)<verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s1">من مێوی ڕاسته‌قینه‌م</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />(من مێوی ڕاسته‌قینه‌م، باوكیشم ڕه‌زه‌وانه‌. <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />هه‌ر لقێ‌ له‌ مندا به‌رنه‌گرێ‌ ئه‌و ده‌یبڕێته‌وه‌. هه‌ر لقێ‌ كه‌ به‌رده‌دات ئه‌و پاكیده‌كاته‌وه‌ تا به‌رهه‌می زیاتر بدات. <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />ئێوه‌ ئێستا بێگه‌ردن به‌هۆی ئه‌و ووتانه‌ی له‌گه‌ڵتان پێیدوام. <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />جا له‌‏مندا بچه‌سپێن‏و منیش له‌‏ئێوه‌دا. چۆن لق له‌‏خۆیه‌وه‌ ناتوانێ‌ به‌رهه‌م بێنێ‌، گه‌ر به‌‏مێوه‌كه‌وه‌ نه‌چه‌سپێ‌، ئێوه‌ش ناتوانن گه‌ر له‌مندا نه‌چه‌سپێن. <verse eid="JHN 15:4" /><verse number="5" style="v" sid="JHN 15:5" />من مێوم‏و ئێوه‌ش لقه‌كان. كێ‌ له‌‏مندا بچه‌سپێت‏و منیش له‌و، ئه‌و به‌رهه‌می زۆر ده‌هێنێت. چونكه‌ بێ‌ من ئێوه‌ ناتوانن هیچ شتێ‌ بكه‌ن. <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />هه‌ر كه‌سێ‌ له‌‏مندا نه‌چه‌سپێ‌ فڕێ‌ ده‌درێته‌ ده‌ره‌وه‌ وه‌ك لقێك‏و ووشك ده‌بێ‌، ئینجا لقه‌ ووشكه‌كان كۆده‌كرێنه‌وه‌و فڕێ‌ ده‌درێنه‌ ناو ئاگرو ده‌سووتێن. <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />به‌ڵام، گه‌ر له‌‏مندا بچه‌سپێن، هه‌روه‌ها ووته‌كانم له‌ناوتاندا چه‌سپا، ئه‌وه‌ی ده‌تانه‌وێ‌ داوایبكه‌ن بۆتان ده‌بێ‌. <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" />به‌مه‌ باوكم شكۆدار ده‌بێ‌ گه‌ر بـه‌رهـه‌می زۆر بهێنن، به‌م شێوه‌یه‌ ئێوه‌ قوتابی منن. <verse eid="JHN 15:8" /><verse number="9" style="v" sid="JHN 15:9" />هه‌روه‌ك چۆن باوك منی خۆشویست، منیش ئێوه‌م خۆشویست، كه‌واته‌ له‌ناو خوشه‌ویستیه‌كه‌مدا بچه‌سپێن! <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />گه‌ر به‌ ڕاسپارده‌كانی منتان‎كرد، له‌‏خۆشه‌ویستیمدا ده‌چه‌سپێن، هه‌روه‌ك چۆن من به‌‏راسپارده‌كانی باوكم كردو له‌ناو خۆشه‌ویستیه‌كه‌یدا چه‌سپاوم! <verse eid="JHN 15:10" /><verse number="11" style="v" sid="JHN 15:11" />ئه‌م شتانه‌م پێ‌ووتن تا خۆشی من تیاتان بچه‌سپێ‌و خۆشیتان به‌ ته‌واوی بێت. <verse eid="JHN 15:11" /><verse number="12" style="v" sid="JHN 15:12" />ڕاسپارده‌ی من بۆ ئێوه‌ ئه‌مه‌یه‌: یه‌كتریتان خۆش بوێ‌ هه‌روه‌ك چۆن من خۆشم‎ویستن. <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" />كه‌س خۆشه‌ویستی له‌مه‌ مه‌زنتری نییه‌: كه‌ ژیانی خۆی بكات به‌قوربانی له‌‏جیاتی دۆسته‌كانی. <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" />ئێوه‌ دۆستی منن گه‌ر ڕه‌فتار بكه‌ن به‌وه‌ی ڕام‎سپاردوون. <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />ئیتر به‌كۆیله‌ ناوتان نابه‌م، چونكه‌ كۆیله‌ نازانێ‌ گه‌وره‌كه‌ی چی ده‌كات. به‌ڵام من ناوی خۆشه‌ویستم لـێنان چونكـه‌ هــه‌رچیه‌كـم لـه‌ باوكـم بیستبوو پێم ڕاگه‌یاندن. <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" />ئێوه‌ منتان هه‌ڵنه‌بژاردووه‌، به‌ڵكو من ئێوه‌م هه‌ڵبژاردووه‌، دیاریم‏كردون تا بڕۆن به‌رهه‌م بهێنن‏و به‌رهه‌مه‌كه‌تان به‌رده‌وام بێت، ئه‌وسا ‏هه‌رچیه‌ك به‌ناوی من له‌باوك داوابكه‌ن ده‌تانداتێ‌. <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />كه‌واته‌ ئه‌م ڕاسپارده‌یه‌تان پێ‌ده‌ده‌م: یه‌كتریتان خۆش‎بوێ‌.<verse eid="JHN 15:17" /></para>
  <para style="s1">‏ڕقبوونه‌وه‌‏ له‌‏عیساو قوتابیه‌كانی</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />(گه‌ر جیهان ڕقی لێتان بووه‌وه‌، ئه‌وه‌ بزانن پێش ئێوه‌ ڕقی له‌‏من بووه‌. <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />گه‌ر ئێوه‌ سه‌ر به‌‏جیهان بن، جیهان ئه‌وانه‌ی سه‌ربه‌خۆیه‌تی خۆشیده‌وێن، به‌ڵام چونكه‌ ئێوه‌ سه‌ر به‌‏جیهان نین، به‌ڵكو من له‌ناوه‌ڕاستی جیهان هه‌ڵم‎بژاردوون‏، له‌به‌رئه‌وه‌ جیهان ڕقی لێتانه‌. <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" />ئه‌و قسه‌یه‌تان بیربێته‌وه‌ كه‌ پێم‎ووتن: كۆیله‌ مه‌زنتر نییه‌ له‌ گه‌وره‌كه‌ی. گه‌ر ئه‌وانه‌ی سه‌ر به‌ جیهانن منیان چه‌وساندبێته‌وه‌، ئه‌وا ئێوه‌ش ده‌چه‌وسێننه‌وه‌، گه‌رهاتوو كاریان به‌‏ووشه‌كانم ‎كرد، ئه‌وا كار به‌‏ووشه‌كانی ئێوه‌ش ده‌كه‌ن. <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />به‌ڵام ئه‌مه‌تان هه‌موو پێ‌ده‌كه‌ن له‌پێناوی ناوی من، چونكه‌ ‏ئه‌وه‌ی منی ناردووه‌ ئه‌وان نایناسن. <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" />من گه‌ر نه‌هاتبوومایه‌و قسه‌م له‌گه‌ڵ نه‌كردبوونایه‌، ئه‌وا گوناهیان نه‌ ده‌بوو، به‌ڵام ئێستا هیچ بیانویه‌كیان نییه‌ بۆ گوناهه‌كانیان. <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" />ئه‌وه‌ی ڕقی له‌‏من بێت، ڕقی له‌‏باوكیشمه‌. <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />گه‌ر له‌‏نێوانیان ئه‌و كارانه‌م نه‌كردایه‌ كه‌ كه‌سی‏تر نه‌یكردووه‌، ئه‌وسا گوناهیان نه‌ ده‌بوو. به‌ڵام ئه‌وان ڕقیان له‌من‏و له‌ باوكم بووه‌وه‌، هه‌رچه‌نده‌ ئه‌و كارانه‌یان بینی. <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />ئه‌مه‌ش ڕوویدا تا ئه‌و ووته‌یه‌ بێته‌دی كه‌ له‌ شه‌ریعه‌ته‌كه‌یاندا نووسراوه‌: [[به‌بێ‌ هۆ ڕقیان لێم بووه‌وه‌!]] <verse eid="JHN 15:25" /><verse number="26" style="v" sid="JHN 15:26" />جا كاتێ‌ یارمه‌تیده‌ر دێ‌، ئه‌وه‌ی من له‌لایه‌ن باوكه‌وه‌ بۆتانی ده‌نێرم، ئه‌و ڕۆحه‌ ڕاستییه‌ی كه‌ له‌‏باوكه‌وه‌ هه‌ڵده‌قوڵێ‌، ئه‌و شایه‌تیم بۆ ده‌دات. <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />ئێوه‌ش هه‌روه‌ها شایه‌تیم بۆ ده‌ده‌ن، چونكه‌ له‌ سه‌ره‌تاوه‌ ئێوه‌ له‌گه‌ڵ من بوون.<verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="s1">كاری ڕۆحی پیرۆز</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1" />(من ئه‌مه‌م پێی ووتن، تا نه‌كه‌ونه‌ هه‌ڵه‌وه‌. <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />له‌كه‌نیشته‌كان ده‌رده‌كرێن، به‌ڵكو كاتێ‌ دێت ئه‌وه‌ی ده‌تان‎كوژێ‌ وابیرده‌كاته‌وه‌ خزمه‌تی خودای كردووه‌. <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />ئه‌وان ئه‌مه‌تان پێ‌ده‌كه‌ن چونكه‌ نه‌باوك ده‌ناسن نه‌من. <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />جا ئه‌مه‌م پێ‌ووتن تا كاتی ڕوودانی هات، بیرتان بكه‌وێته‌وه‌ كه‌ ئه‌مه‌م له‌‏پێشا پێ‌ ووتوون. له‌سه‌ره‌تادا ئه‌مه‌م پێ‌ نه‌ووتن، چونكه‌ له‌گه‌ڵتان بووم.<verse eid="JHN 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 16:5" />(ئێستا من ده‌گه‌ڕێمه‌وه‌ بۆ لای ئه‌وه‌ی ناردوومی، له‌گه‌ڵ ئه‌وه‌شدا كه‌ستان نه‌ی پرسی: بۆ كوێ‌ ده‌چی؟ <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />چونكه‌ ئه‌مه‌م پێ‌ووتن‏، دڵگرانی دایگر‏تن. <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />به‌ڵام من ڕاستیتان پێ‌ده‌ڵێم: باشتر وایه‌ بۆتان كه‌ بڕۆم، چونكه‌ ئه‌گه‌ر من نـه‌ڕۆم، یــارمــه‌تیــده‌رتـان بۆ نایه‌ت. به‌ڵام گه‌ر بڕۆم بۆتانی ده‌نێرم. <verse eid="JHN 16:7" /><verse number="8" style="v" sid="JHN 16:8" />كاتێ‌ ئه‌و دێ‌، جیهان سه‌رزه‌نشت ده‌كات له‌سه‌ر گوناه‌و ڕاست‏ودروستیو حوكمدان، <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />له‌سه‌ر گوناه‌ له‌به‌رئه‌وه‌ی باوه‌ڕم پێ‌ناهێنن.‏ <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />له‌سه‌ر ڕاست‏ودروستی له‌به‌رئه‌وه‌ی من ده‌چمه‌ لای باوك‏و ئیتر نامبینن. <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />له‌سه‌ر حوكمدانیش له‌به‌رئه‌وه‌ی سه‌رۆكی ئه‌م جیهانه‌ حوكمی به‌سه‌ر دراوه‌.<verse eid="JHN 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12" />(هێشتا شتی زۆرم هه‌یه‌ پێتانی بڵێم، ئێستا ناتوانن به‌رگه‌ی بگرن. <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" />به‌ڵام كاتێ‌ ڕۆحی ڕاستی بۆ لاتان دێ‌، به‌ره‌و هه‌موو ڕاستیه‌كتان ده‌بات، چونكه‌ له‌‏خۆیه‌وه‌ هیچ ناڵێ‌، به‌ڵكو ئه‌وه‌ی گوێی لێ‌ده‌بێ‌ پێتانی ڕاده‌گه‌ێنێ‌، ئه‌وه‌ی له‌ دواییدا ڕووده‌دات پێتانی ده‌ڵێ‌. <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />ئه‌و شكۆدارم ده‌كات چونكه‌ هه‌موو ئه‌وه‌ی بۆتانی باس‎ده‌كات له‌منه‌وه‌ ده‌رچووه‌. <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />هه‌موو ئه‌وه‌ی كه‌ هی باوكه‌، هه‌روه‌ها هی منه‌. له‌به‌رئه‌وه‌ بوو پێم‎ووتن ئه‌وه‌ی بۆتانی باس ده‌كات له‌منه‌وه‌ ده‌رچووه‌. <verse eid="JHN 16:15" /><verse number="16" style="v" sid="JHN 16:16" />پاش ماوه‌یه‌كی كه‌م نام‎بینن، به‌ڵام دوای ئه‌وه‌ به‌ ماوه‌یه‌كی كه‌م ده‌م‎بینن، چونكه‌ ده‌گه‌رێمه‌وه‌ لای باوك.)<verse eid="JHN 16:16" /></para>
  <para style="s1">خۆشی دوای ناخۆشی</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17" />هه‌ندێ‌ له‌‏قوتابیه‌كان پرسیاریان كرد: (مه‌به‌ستی چییه‌ له‌م قسه‌یه‌: پاش ماوه‌یه‌كی كه‌م نامبینن، دوای ئه‌وه‌ به‌ ماوه‌یه‌كی كه‌م ده‌مبینن، هه‌روه‌ها: چونكه‌ ده‌گه‌ڕێمه‌وه‌ لای باوك؟) <verse eid="JHN 16:17" /><verse number="18" style="v" sid="JHN 16:18" />دیسان ووتیان: (ئه‌م كه‌مه‌ چییه‌ باسی ده‌كات؟ تێناگه‌ین له‌وه‌ی ده‌یڵێ‌!) <verse eid="JHN 16:18" /><verse number="19" style="v" sid="JHN 16:19" />عیسا زانی كه‌وا حه‌زده‌كه‌ن پرسیاری لـێ‌بكه‌ن، ئینجا پێی ووتن: (پرسیار له‌ واتای قسه‌كه‌م ده‌كه‌ن: پاش ماوه‌یه‌كی كه‌م نام‎بینن، دوای ئه‌وه‌ به‌ ماوه‌یه‌كی كه‌م ده‌م‎بینن.<verse eid="JHN 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 16:20" />(ڕاستی ڕاستیتان پێ‌ده‌ڵێم: ئێوه‌ ده‌گرین‏و شیوه‌ن ده‌كه‌ن، به‌ڵام جیهان دڵشاد ده‌بێ‌، ئێوه‌ دڵته‌نگ ده‌بن، به‌ڵام دڵته‌نگیه‌كه‌تان ده‌بێ‌ به‌ خۆشی. <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />ژن دڵته‌نگ ده‌بێ‌ كاتێ‌ كه‌ منداڵ‏بوونی نزیك بووه‌وه‌. به‌ڵام كاتێ‌ منداڵه‌كه‌ی بوو، ئیتر بیر له‌‏ماندووبوونی ناكاته‌وه‌، له‌خۆشی ئه‌وه‌ی مرۆڤێك له‌دایك‎بوو بۆ ئه‌م جیهانه‌. <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />ئێوه‌ش ئاوها، ئێستا دڵته‌نگ ده‌بن، به‌ڵام كاتێ‌ دێمه‌وه‌ بۆلاتان، دڵتان خۆش ده‌بێ‌، ئیتر كه‌س ئه‌و خۆشیه‌تان لـێ‌ناسێنێته‌وه‌. <verse eid="JHN 16:22" /><verse number="23" style="v" sid="JHN 16:23" />له‌و ڕۆژه‌دا پرسیاری هیچم لـێ‌ناكه‌ن. ڕاستی ڕاستیتان پێ‌ ده‌ڵێم: هه‌ر شتێك به‌ناوی منه‌وه‌ له‌باوك داوا بكه‌ن ده‌تانداتێ‌. <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />هه‌تا ئێستا به‌ناوی منه‌وه‌ هیچتان داوا نه‌كردووه‌. داوابكه‌ن وه‌ریده‌گرن، تا خۆشیه‌كه‌تان به‌ ته‌واوی بێت.<verse eid="JHN 16:24" /></para>
  <para style="s1">من به‌سه‌ر جیهاندا زاڵبووم</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />(ده‌رباره‌ی ئه‌م شتانه‌ له‌‏قسه‌كانمدا نموونه‌م بۆ هێنانه‌وه‌، به‌ڵام كاتێ‌ دێ‌، باسی باوكتان بۆ بكه‌م به‌‏ئاشكرا و بێ‌ نموونه‌. <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />له‌و ڕۆژه‌دا به‌ناوی منه‌وه‌ داوا له‌باوك ده‌كه‌ن. ئیتر پێتان ناڵێم من داواتان بۆ ده‌كه‌م لای باوك. <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />چونكه‌ باوك خۆی خۆشی ده‌وێن، له‌به‌رئه‌وه‌ی ئێوه‌ منتان خۆشویست، هه‌روه‌ها باوه‌ڕتان به‌وه‌ هێنا كه‌ من له‌ خوداوه‌ ده‌رچووم. <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />له‌باوكه‌وه‌ ده‌رچووم‏و هاتووم بۆ جیهان، ئێستا جیهان به‌جێ‌ده‌هێڵم‏و ده‌گه‌ڕێمه‌وه‌ لای باوك.(<verse eid="JHN 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29" />لێره‌ قوتابیه‌كانی پێیان‎ووت: (‏ئێستا به‌‏ئاشكرا گفتوگۆمان له‌گه‌ڵ ده‌كه‌یت بێ‌ نموونه‌. <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />ئێستا ده‌زانین تۆ هه‌موو شتێك ده‌زانی، پێویست به‌وه‌ ناكات كه‌س پرسیارت لـێ‌بكات. له‌به‌رئه‌وه‌ باوه‌ڕده‌هێنین تۆ له‌ خوداوه‌ ده‌رچووی.) <verse eid="JHN 16:30" /><verse number="31" style="v" sid="JHN 16:31" />عیسا له‌وه‌ڵامدا ووتی: (ئایا ئێستا باوه‌ڕده‌هێنن؟ <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />كاتێ‌ دێ‌‏، ئه‌وه‌تا هاتووه‌‏، تیایدا له‌‏یه‌كتری جیاده‌بنه‌وه‌ هه‌ر یه‌كه‌ بۆ ماڵی خۆی، ئینجا به‌ته‌نها به‌جێم‎ده‌هێڵن. به‌ڵام من به‌ته‌نها نیم، چونكه‌ باوك له‌گه‌ڵمدایه‌. <verse eid="JHN 16:32" /><verse number="33" style="v" sid="JHN 16:33" />ئه‌مانه‌م هه‌موو پێ‌ووتن تاكو له‌مندا ئاشتیتان هه‌‏بێ‌. ئێوه‌ له‌جیهاندا ته‌نگانه‌ ده‌چێژن. به‌ڵام ووره‌تان به‌رزبێ‌، من به‌سه‌ر جیهاندا زاڵ‎بووم‏!)<verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s1">نوێژی عیسا بۆ باوه‌ڕداران</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />كاتێ‌ ئه‌م قسانه‌یكرد، ڕوانیه‌ ئاسمان‏و ووتی: (ئه‌ی باوك، كاتی ئه‌وه‌ هاتووه‌! ڕۆڵه‌كه‌ت شكۆدار بكه‌ی، تاكو ڕۆڵه‌كه‌شت تۆ شكۆدار بكات، <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />ئه‌وه‌ی تۆ ده‌سه‌ڵاتت داوه‌تێ‌ به‌سه‌ر هه‌موو مرۆڤدا، هه‌تا ئه‌و ژیانی هه‌تاهه‌تایی بدات به‌ هه‌موو ئه‌وانه‌ی تۆ به‌وت داوه‌. <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />ژیانی هه‌تاهه‌تایش ئه‌وه‌یه‌ كه‌ تۆ بناسن، ته‌نها خودای ڕاسته‌قینه‌، هه‌روه‌ها عیسای مه‌سیح كه‌ ناردووته‌. <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />من له‌سه‌ر زه‌وی شكۆدارم كردی به‌ته‌واوكردنی ئه‌و كاره‌ی دابووت پێم‏. <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />ئه‌ی باوك ئێستا شكۆدارم‎كه‌ له‌لای خۆت، به‌و شكۆمه‌ندییه‌ی لای تۆ هه‌م‏بوو پێش دروستكردنی جیهان.</para>
  <para style="p" vid="JHN 17:5">‏ <verse eid="JHN 17:5" /><verse number="6" style="v" sid="JHN 17:6" />(ناوی تۆم ده‌رخست بۆ ئه‌وانه‌ی له‌‏جیهاندا به‌منت‎دان، ئه‌وانه‌ هی تۆ بوون، تۆ به‌منت‏دان. ئه‌وانیش گوێڕایه‌ڵی ووته‌كانت بوون، <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />ئێستا ده‌زانن هه‌رچیه‌كت به‌‏من داوه‌ له‌‏تۆوه‌یه‌، <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />چونكه‌ من ئه‌و ووشانه‌م دانێ‌ كه‌ تۆ پێت دابووم، ئه‌وانیش وه‌ریان‎گرت، هه‌روه‌ها به‌ڕاستی زانییان من له‌‏تۆوه‌ هاتووم‏و باوه‌ڕیان هێنا كه‌ تۆ منت ناردووه‌. <verse eid="JHN 17:8" /><verse number="9" style="v" sid="JHN 17:9" />له‌پێناوی ئه‌وانه‌دا نوێژت بۆ ده‌كه‌م. ئێستا له‌پێناوی جیهاندا نوێژ ناكه‌م، به‌ڵكو له‌ پێناوی ئه‌وانه‌ی به‌منت‏داون، چونكه‌ ئه‌وانه‌ هی تۆن. <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />هه‌رچیه‌ك هی منه‌، هی تۆیه‌، هه‌رچیه‌كیش هی تۆیه‌، هی منه‌، من له‌‏ئه‌واندا شكۆدار بووم. <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />ئه‌مان له‌‏جیهان ده‌مێننه‌وه‌، به‌ڵام من تیایدا نامێنمه‌وه‌، چونكه‌ من ده‌گه‌ڕێمه‌وه‌ لای تۆ. ئه‌ی باوكی پاك‎وپیرۆز ئه‌وانه‌ی داوته‌ به‌‏من به‌هێزی ناوی خۆت بیان‎پارێزه‌، هه‌تا ببن به‌ یه‌ك وه‌ك ئێمه‌ یه‌كین. <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" />كاتێ‌ له‌گه‌ڵیاندا بووم ده‌م‎پاراستن به‌ناوی تۆوه‌. ئه‌وانه‌ی به‌منت‏دابوون ئاگاداریم كردن، كه‌سیان له‌ناونه‌چوون جگه‌ له‌ ڕۆڵه‌ی له‌ناوچوو نه‌بێ‌، تاكو ئه‌وه‌ی له‌كتێبی پیرۆزدا نووسراوه‌ بێته‌دی. <verse eid="JHN 17:12" /><verse number="13" style="v" sid="JHN 17:13" />به‌ڵام ئێستا من ده‌گه‌ڕێمه‌وه‌ لای تۆ، من باسی ئه‌مه‌ ده‌كه‌م‏، جارێ‌ هێشتا له‌ جیهاندام، تا دڵشادی من تیایاندا به‌ته‌واوی بێت. <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />من ووشه‌ی تۆم به‌واندا، به‌ڵام جیهان ڕقی لێیان بووه‌وه‌، چونكه‌ ئه‌وان سه‌ر به‌ جیهان نه‌بوون، هه‌روه‌ك چۆن من سه‌ر به‌ جیهان نیم. <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" />من داوای ئه‌وه‌ ناكه‌م تۆ ئه‌وان له‌‏جیهان بسێنیته‌وه‌، به‌ڵكو له‌شه‌یتان بیان‎پارێزه‌. <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />ئه‌وان سه‌ر به‌ جیهان نین هه‌روه‌ك چۆن من سه‌ر به‌ جیهان نیم. <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" />له‌‏ڕاستیدا پیرۆزیان‎بكه‌، چونكه‌ ووشه‌ی تۆ ڕاستییه‌. <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />هه‌روه‌ك چۆن منت نارد بۆ جیهان، منیش ده‌یاننێرم بۆ جیهان. <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />جا له‌‏پێناوی ئه‌واندا من خۆم پیرۆز ده‌كه‌م، هه‌تا ئه‌وانیش له‌ڕاستی پیرۆزبن.<verse eid="JHN 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20" />ته‌نها له‌پێناوی ئه‌مان نوێژ ناكه‌م، به‌ڵكو له‌پێناوی ئه‌وانه‌ش كه‌ باوه‌ڕم پێ‌ده‌كه‌ن به‌هۆی قسه‌ی ئه‌مانه‌وه‌، <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" />تا هه‌موو یه‌ك بن، هه‌روه‌ك تۆ چۆن له‌‏مندای ئه‌ی باوك منیش له‌تۆدام، تا ئه‌وانیش له‌‏ئێمه‌دا بن، تاكو جیهان باوه‌ڕبهێنێ‌ كه‌ تۆ منت ناردووه‌. <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />من ئه‌و شكۆمه‌ندیه‌م داونه‌تێ‌ تۆ داوته‌ به‌من، تا ببن به‌یه‌ك هه‌روه‌ك چۆن ئێمه‌ یه‌كین. <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />من له‌‏ئه‌واندام‏و تۆ له‌‏مندای، تا ته‌واوبن‏و ببن به‌ یه‌ك، هه‌تا جیهان بزانێ‌ تۆ منت ناردووه‌، هه‌روه‌ها ئه‌وانت خۆشویستووه‌ وه‌ك چۆن منت خۆشویست.<verse eid="JHN 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 17:24" />(ئه‌ی باوك، ده‌مه‌وێ‌ ئه‌وانه‌ی كه‌ داوته‌ به‌ من ‏له‌هه‌ر شوێنێكدا‏بم له‌گه‌ڵم‏بن، تا ئه‌و ‏شكۆمه‌ندیه‌م ببینن كه‌ داوته‌ به‌‏من، چونكه‌ تۆ منت خۆشویستووه‌ پێش دروست‎بوونی جیهان. <verse eid="JHN 17:24" /><verse number="25" style="v" sid="JHN 17:25" />ئه‌ی باوكی ڕاست‏ودروست، جیهان ناتناسێ‌، به‌ڵام من تۆ ده‌ناسم، ئه‌وانیش ده‌زانن كه‌ تۆ منت ناردووه‌، <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />من ناوی تۆم به‌وان ناساند، هه‌روه‌ها پێیان ده‌ناسێنم، تاكو ئه‌و خۆشه‌ویستیه‌یان تیادابێ‌ كه‌ تۆ منت پێ‌ خۆشویست، هه‌تا من خۆم له‌واندا بم.(<verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s1">گرتنی عیسا</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />دوای ئه‌وه‌ی عیسا له‌م ووتانه‌ی بووه‌وه‌، له‌گه‌ڵ قوتابیه‌كانی كه‌وتنه‌ ڕێ‌و دۆڵی قه‌درونیان بڕی. له‌وێدا باخچه‌یه‌ك هه‌بوو خۆیو قوتابیه‌كانی چوون بۆ ئه‌وێ‌. <verse eid="JHN 18:1" /><verse number="2" style="v" sid="JHN 18:2" />به‌ڵام ئه‌و یه‌هوزایه‌ی ناپاكی له‌گه‌ڵ كرد، ئه‌و شوێنه‌ی ده‌زانی، چونكه‌ عیسا زۆر جار له‌گه‌ڵ قوتابیه‌كانی تیا‏دا كۆده‌بووه‌وه‌. <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />ئینجا یه‌هوزا به‌ره‌و ئه‌وێ‌ چوو، تیپێك سه‌رباز‏و پاسه‌وانانی په‌رستگای له‌گه‌ڵ خۆی برد، ئه‌وانه‌ی ‏سه‌رۆك كاهینه‌كان‏و فه‌ریسیه‌كان ناردبوویانن، چراو مه‌شخه‌ڵ‏و چه‌كیان هه‌ڵگرتبوو. <verse eid="JHN 18:3" /><verse number="4" style="v" sid="JHN 18:4" />عیسا ده‌یزانی چی به‌سه‌ر دێ‌، به‌ره‌و ڕوویان چوو‏، ووتی: (كێتان ده‌وێ‌؟) <verse eid="JHN 18:4" /><verse number="5" style="v" sid="JHN 18:5" />وه‌ڵامیان دایه‌وه‌: (عیسای ناسری). ئه‌ویش پێی ووتن: (من ئه‌وم). ئه‌و یه‌هوزایه‌ی كه‌ ناپاكی له‌گه‌ڵ كرد له‌گه‌ڵیان وه‌ستا بوو. <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />كاتێ‌ پێی ووتن: (من ئه‌وم) گه‌ڕانه‌وه‌ دواوه‌و كه‌وتن به‌ زه‌ویدا! <verse eid="JHN 18:6" /><verse number="7" style="v" sid="JHN 18:7" />عیسا جارێكیكه‌ لێیپرسینه‌وه‌: (كێتان ده‌وێ‌؟) ئه‌وانیش له‌‏وه‌ڵامدا ووتیان: (عیسای ناسری.) <verse eid="JHN 18:7" /><verse number="8" style="v" sid="JHN 18:8" />ئه‌ویش ووتی: (پێم ووتن: من ئه‌وم، گه‌ر ئێوه‌ به‌دوای مندا ده‌گه‌ڕێن، با ئه‌وانه‌یكه‌ بڕۆن.) <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />ئه‌مه‌ش بۆ هاتنه‌دی ئه‌و قسه‌یه‌ بوو كه‌ ووتی: (ئه‌وانه‌ی به‌منت‏دابوون كه‌سیان له‌ناونه‌چوو!) <verse eid="JHN 18:9" /><verse number="10" style="v" sid="JHN 18:10" />شه‌معون په‌ترۆس شمشێرێكی پێ‌بوو ده‌ری هێنا‏و له‌‏كۆیله‌ی سه‌رۆك كاهینه‌كانی‏داو گوێچكه‌ی ڕاستی پێ‌بڕی. ئه‌و كۆیله‌یه‌ش ناوی مه‌لخه‌س بوو. <verse eid="JHN 18:10" /><verse number="11" style="v" sid="JHN 18:11" />‏عیسا به‌ په‌ترۆسی ووت: (شمشێره‌كه‌ت بگه‌ڕێنه‌وه‌ كێلانه‌كه‌ی! ئایا ئه‌و جامه‌ی باوكم داویه‌تی پێم نه‌یخۆمه‌وه‌؟(<verse eid="JHN 18:11" /></para>
  <para style="s1">له‌به‌رده‌م سه‌رۆكی كاهینه‌كان</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />ئیتر تیپه‌ سه‌ربازه‌كه‌و سه‌رتیپه‌كه‌یان‏و پاسه‌وانه‌كانی جووله‌كه‌ عیسایان گرت‏و به‌ستیانه‌وه‌. <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />یه‌كه‌مجار بردیان بۆ لای حـه‌نانی خـه‌زوری قه‌یافا كه‌ سه‌رۆك كاهین بوو لـه‌و ساڵه‌دا. <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" />قه‌یافاش ئه‌و پیاوه‌ بوو كه‌ ڕاوێژی بۆ جووله‌كه‌كان كردبوو، باشتر وایه‌ پیاوێك بمرێ‌ له‌‏جیاتی هه‌موو گه‌ل.<verse eid="JHN 18:14" /></para>
  <para style="s1">په‌ترۆس نكۆڵی له‌عیسا ده‌كات</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />شه‌معون په‌ترۆس له‌گه‌ڵ قوتابیه‌كه‌ی تر كه‌ سه‌رۆكی كاهینه‌كان ده‌یناسی شوێنی عیسا كه‌وت. ئه‌و قوتابیه‌ له‌گه‌ڵ عیسا چووه‌ كۆشكی سه‌رۆك كاهین. <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />به‌ڵام په‌ترۆس له‌‏ده‌ره‌وه‌ له‌لای ده‌رگاكه‌ ڕاوه‌ستا. ئینجا قوتابیه‌كه‌ی تر كه‌ سه‌رۆك كاهینه‌كان ده‌یناسی هاته‌ده‌ره‌وه‌و قسه‌ی له‌گه‌ڵ كچه‌ ده‌رگاوانه‌كه‌دا كردو په‌ترۆسی هێنایه‌ ژووره‌وه‌. <verse eid="JHN 18:16" /><verse number="17" style="v" sid="JHN 18:17" />كچه‌ ده‌رگاوانه‌كه‌ له‌ په‌ترۆسی پرسی: (ئایا تۆ یه‌كێك له‌‏قوتابیه‌كانی ئه‌م كابرایه‌ نیت؟) ئه‌ویش وه‌ڵامی دایه‌وه‌: (نه‌خێر، له‌وان نیم.) <verse eid="JHN 18:17" /><verse number="18" style="v" sid="JHN 18:18" />ئاووهه‌وا سارد بوو، خزمه‌تكاران‏و پاسه‌وانان ئاگریان كردبووه‌وه‌و له‌‏ده‌وری وه‌ستابوون خۆیان گه‌رم ده‌كرده‌وه‌، په‌ترۆسیش له‌گه‌ڵیان وه‌ستابوو خۆی گه‌رم ده‌كرده‌وه‌.<verse eid="JHN 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />سه‌رۆكی كاهینه‌كان پرسیاری له‌‏عیسا كرد ده‌رباره‌ی قوتابیه‌كانی‏و فێركردنه‌كه‌ی. <verse eid="JHN 18:19" /><verse number="20" style="v" sid="JHN 18:20" />عیساش وه‌ڵامی دایه‌وه‌: (به‌ ئاشكرا قسه‌م بۆ جیهان كرد، له‌كه‌نیشت‏و په‌رستگادا له‌و شوێنه‌ی هه‌موو جووله‌كه‌كان لێی‏كۆده‌بوونه‌وه‌، هه‌موو كاتێ‌ خه‌ڵكم فێرده‌كرد، هیچ شتێكم به‌‏نهێنی نه‌وتووه‌. <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />بۆچی پرسیار له‌ من ده‌كه‌یت؟ پرسیار له‌وانه‌ بكه‌ كه‌ گوێیان له‌‏قسه‌كانم بووه‌، ئه‌وان ده‌زانن چیم ووتوه‌!) <verse eid="JHN 18:21" /><verse number="22" style="v" sid="JHN 18:22" />كاتێ‌ عیسا ئه‌مه‌ی ووت یه‌كێك له‌‏خزمه‌تكاره‌كان زلله‌یه‌كی لـێ‌داو پیێ‌ووت: (ئاوها وه‌ڵامی سه‌رۆكی كاهینان ده‌ده‌یته‌وه‌؟) <verse eid="JHN 18:22" /><verse number="23" style="v" sid="JHN 18:23" />عیسا وه‌ڵامی دایه‌وه‌: (گه‌ر قسه‌ی خراپم كردووه‌ بڵێ‌ چیم ووتووه‌، گه‌ر ڕاستیشم ووتووه‌، ئیتر بۆچی لێم ده‌ده‌یت؟) <verse eid="JHN 18:23" /><verse number="24" style="v" sid="JHN 18:24" />ئه‌وسا حه‌نان به‌ده‌ستی به‌ستراوه‌وه‌ ناردی بۆ لای قه‌یافای سه‌رۆك كاهین. <verse eid="JHN 18:24" /><verse number="25" style="v" sid="JHN 18:25" />هێشتا شه‌معون په‌ترۆس له‌وێ‌ ڕاوه‌ستابوو خۆی گه‌رم ده‌كرده‌وه‌، لێیان پرسی: (ئایا تۆش له‌ قوتابیه‌كانی ئه‌و نیت؟) ئه‌ویش نكۆڵی لێ‌كردو ووتی: (نه‌خێر، له‌وان نیم.) <verse eid="JHN 18:25" /><verse number="26" style="v" sid="JHN 18:26" />یه‌كێك له‌‏خزمه‌تكارانی سه‌رۆكی كاهینان زاوای ئه‌و خزمه‌تكاره‌ بوو كه‌ په‌ترۆس گوێی لـێ‌كرده‌وه‌، ووتی: (ئه‌ی له‌باغچه‌كه‌دا تۆم له‌گه‌ڵ ئه‌و نه‌بینی؟) <verse eid="JHN 18:26" /><verse number="27" style="v" sid="JHN 18:27" />دیسان په‌ترۆس نكۆڵی لێ‌كرد، ئینجا یه‌كسه‌ر كه‌ڵه‌شێر خوێندی!<verse eid="JHN 18:27" /></para>
  <para style="s1">عیسا ده‌درێته‌ ده‌ست پیلاتۆس</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />ئیتر به‌یانی زوو عیسایان له‌‏ماڵی قه‌یافاوه‌ برد بۆ كۆشكی فه‌رمانڕه‌وایی ڕۆمه‌كان‏و ئه‌وان نه‌چوونه‌ ئه‌و كوشكه‌ نه‌وه‌ك پیس ببن‏و به‌هۆی ئه‌وه‌وه‌ نه‌توانن به‌شداری بكه‌ن له‌‏خواردنی جه‌ژنی تێپه‌ڕبوون. <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />ئه‌وسا پیلاتۆس هاته‌ ده‌ره‌وه‌ بۆ لایان‎و لێیپرسین: (به‌چی ئه‌م پیاوه‌ تاوانبار ده‌كه‌ن؟) <verse eid="JHN 18:29" /><verse number="30" style="v" sid="JHN 18:30" />وه‌ڵامیان دایه‌وه‌: (گه‌ر تاوانبار نه‌بووایه‌، نه‌مان‎ده‌دا به‌ده‌سته‌وه‌.) <verse eid="JHN 18:30" /><verse number="31" style="v" sid="JHN 18:31" />پیلاتۆس ووتی: (ئێوه‌ بیبه‌ن، به‌پێی شه‌ریعه‌تی خۆتان حوكمی به‌سه‌ردا بده‌ن.) ئه‌وانیش وه‌ڵامیان دایه‌وه‌: (مافی ئه‌وه‌مان نییه‌ كه‌س بكوژین.) <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" />ئه‌مه‌ش ڕوویدا تاكو ئه‌وه‌ی عیسا ووتبووی له‌باره‌ی شێوه‌ی مردنه‌كه‌ی بێته‌دی‏. <verse eid="JHN 18:32" /><verse number="33" style="v" sid="JHN 18:33" />ئینجا پیلاتۆس چووه‌ ناو كۆشكه‌كه‌ی‏و بانگی عیسا‏ی كردو لێیپرسی: (تۆ پادشای جووله‌كه‌ی؟) <verse eid="JHN 18:33" /><verse number="34" style="v" sid="JHN 18:34" />عیسا له‌ وه‌ڵامدا ووتی: (ئایا تۆ له‌‏خۆته‌وه‌ ئه‌مه‌م پێ‌ده‌ڵێی، یاخود خه‌ڵكیكه‌ ده‌رباره‌ی من ئه‌مه‌یان پێ‌ ووتوی؟) <verse eid="JHN 18:34" /><verse number="35" style="v" sid="JHN 18:35" />ئه‌وسا پیلاتۆس لێیپرسی: (ئایا من جووله‌كه‌م؟ گه‌له‌كه‌ت‏و سه‌رۆك كاهینه‌كان تۆیان داوه‌ته‌ ده‌ستی من. چیت كردووه‌؟) <verse eid="JHN 18:35" /><verse number="36" style="v" sid="JHN 18:36" />عیساش له‌وه‌ڵامدا ووتی: (پادشاهێتی من سه‌ر به‌م جیهانه‌ نییه‌. گه‌ر پادشاهێتی من سه‌ر به‌م جیهانه‌ بووایه‌، ئه‌وسا خزمه‌تكاره‌كانم ده‌جه‌نگان تا نه‌درێمه‌ ده‌ست ده‌سه‌ڵاتدارانی جووله‌كه‌‏. به‌ڵام پادشاهێتی من هی ئێره‌ نییه‌.) <verse eid="JHN 18:36" /><verse number="37" style="v" sid="JHN 18:37" />جا پیلاتۆس لێیپرسی: (كه‌واته‌ تۆ پادشای؟) ئه‌ویش وه‌ڵامی دایه‌وه‌: (خۆت ووتت من پادشام. له‌به‌ر ئه‌مه‌ش له‌دایك بووم‎و هاتووم بۆ جیهان، تا‏شایه‌تی ‏بۆ ڕاستی بده‌م، هه‌ر كه‌سێ‌ له‌ڕاستی بێ‌ گوێ‌ له‌ ده‌نگم ده‌گرێ‌.) <verse eid="JHN 18:37" /><verse number="38" style="v" sid="JHN 18:38" />پیلاتۆس پێی ووت: (ڕاستی چییه‌؟) دوای ئه‌وه‌ی ئه‌مه‌ی ووت دیسان چووه‌ ده‌ره‌وه‌ بۆ لای جووله‌كه‌كان‏و ووتی: (من هیچ خراپه‌یه‌كی تیادا نادۆزمه‌وه‌! <verse eid="JHN 18:38" /><verse number="39" style="v" sid="JHN 18:39" />ئێوه‌ له‌سه‌ر ئه‌وه‌ ڕاهاتوون له‌‏جه‌ژنی تێپه‌ڕبووندا گیراوێكتان بۆ ئازاد بكه‌م. ئایا ده‌تانه‌وێ‌ پادشای جووله‌كه‌تان بۆ ئازاد بكه‌م؟) <verse eid="JHN 18:39" /><verse number="40" style="v" sid="JHN 18:40" />هه‌موو هاواریان كردو ووتیان: (ئه‌مه‌ ئازاد مه‌كه‌! به‌ڵكو باراباس!) هه‌رچه‌نده‌ باراباس دزیش بوو.<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="s1">فه‌رمانی كوشتنی عیسا</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />ئیتر پیلاتۆس فه‌رمانیدا عیسا ببرێت و به‌‏قامچی لێیبدرێت. <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />سه‌ربازه‌كان تاجێكیان له‌‏دڕك چنیو خستیانه‌ سه‌ر سه‌ری، جلێكی ئه‌رخه‌وانییان له‌به‌ركرد. <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />لێی ده‌چوونه‌ پێشه‌وه‌‏و پێیان ده‌‏ووت: (سڵاو! ئه‌ی پادشای جووله‌كه‌!)، زلله‌یان لـێ‌ده‌دا. <verse eid="JHN 19:3" /><verse number="4" style="v" sid="JHN 19:4" />جارێكیكه‌ پیلاتۆس هاته‌ده‌ره‌وه‌ بۆ لای خه‌ڵكه‌كه‌‏و پێی ووتن: (من ده‌ی هێنمه‌ ده‌ره‌وه‌ بۆلاتان تا بزانن من هیچ گوناهێكی تیادا نابینم!) <verse eid="JHN 19:4" /><verse number="5" style="v" sid="JHN 19:5" />عیسا به‌تاجی دڕكاوی‏و جلی ئه‌رخه‌وانییه‌وه‌ هاته‌ده‌ره‌وه‌‏، ئینجا پیلاتۆس به‌وانی ووت: (‏ئه‌وه‌تا پیاوه‌كه‌!) <verse eid="JHN 19:5" /><verse number="6" style="v" sid="JHN 19:6" />كاتێ‌ سه‌رۆك كاهینه‌كان‏و پاسه‌وانه‌كان بینیان‏، هاواریان كرد: (له‌‏خاچی بده‌! له‌‏خاچی بده‌!) ئه‌وسا پیلاتۆس پێیووتن: (ئێوه‌ بیبه‌ن‏و له‌خاچی بده‌ن، من هیچ گوناهێكی تیادا نابینم!) <verse eid="JHN 19:6" /><verse number="7" style="v" sid="JHN 19:7" />جووله‌كه‌كان وه‌ڵامیان‎دایه‌وه‌: (شه‌ریعه‌تمان هه‌یه‌. به‌پێی شه‌ریعه‌تی ئێمه‌ ده‌بێ‌ بمرێ‌، چونكه‌ خۆی كردووه‌ به‌ ڕۆڵه‌ی خودا.)<verse eid="JHN 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8" />كاتێ‌ پیلاتۆس گوێی له‌م قسه‌یه‌ بوو زیاتر ترسا، <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />چووه‌ ناو كۆشكه‌كه‌یو له‌عیسای پرسی: (تۆ خه‌ڵكی كوێی؟) به‌ڵام عیسا هیچ وه‌ڵامێكی نه‌دایه‌وه‌. <verse eid="JHN 19:9" /><verse number="10" style="v" sid="JHN 19:10" />پیلاتۆس پێیووت: (بۆ قسه‌م له‌گه‌ڵ ناكه‌یت؟ ئایا نازانی من ده‌سه‌ڵاتی ئه‌وه‌م هه‌یه‌ ئازادت بكه‌م‎ یان له‌‏خاچت بده‌م؟) <verse eid="JHN 19:10" /><verse number="11" style="v" sid="JHN 19:11" />عیسا وه‌ڵامیدایه‌وه‌: (تۆ هیچ ده‌سـه‌ڵاتێكت به‌سه‌ر منه‌وه‌ نییه‌، گـه‌ر لـه‌ ســه‌ره‌وه‌ به‌تۆیان نه‌دابێ‌. جـا لـه‌به‌رئه‌وه‌، ئـه‌وه‌ی مـنی داوه‌ته‌ ده‌ست تۆ گـوناهێكـی گـه‌وره‌تری هه‌یه‌‏.)<verse eid="JHN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12" />ئیتر له‌به‌رئه‌مه‌ پیلاتۆس هه‌وڵی ئازادكردنی عیسایدا، به‌ڵام جووله‌كه‌كان هاواریان‎كرد: (گه‌ر ئه‌مه‌ت ئازادكرد، ئیتر هاوڕێی قه‌یسه‌ر نیت. ‏هه‌ر كه‌سێك خۆی بكات به‌‏پادشا، دوژمنایه‌تی له‌گه‌ڵ قه‌یسه‌ر ده‌كات.) <verse eid="JHN 19:12" /><verse number="13" style="v" sid="JHN 19:13" />كاتێ‌ پیلاتۆس گوێی له‌م قسانه‌ بوو، ‏عیسای برده‌ ده‌ره‌وه‌، ئه‌وسا له‌سه‌ر كورسی فه‌رمانڕه‌وایی دانیشت، له‌‏شوێنێك پێیده‌ووترێ‌ به‌ردڕێژكراو به‌‏زمانی عیبریش گه‌باسا. <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />كاته‌كه‌ش نزیكه‌ی دوانزه‌ی نیوه‌ڕۆ بوو‏، له‌و ڕۆژه‌دا [[[ڕۆژی هه‌ینی]]] خۆ ئاماده‌ده‌كرا بۆ جه‌ژنی تێپه‌ڕبوون. ئینجا پیلاتۆس به‌‏جووله‌كه‌كانی ووت: (ئا ئه‌وه‌تا پادشاكه‌تان!) <verse eid="JHN 19:14" /><verse number="15" style="v" sid="JHN 19:15" />ئه‌وانیش هاواریان‎كرد: (بیبه‌! بیبه‌! له‌خاچی بده‌!) پیلاتۆس لێیپرسـین: (ئایا پادشاكـه‌تان له‌خاچ بده‌م؟) ئه‌وسا سه‌رۆك كاهینه‌كان وه‌ڵامیان دایه‌وه‌: (هیچ پادشایه‌كمان نییه‌ جگه‌ له‌ قه‌یسه‌ر.) <verse eid="JHN 19:15" /><verse number="16" style="v" sid="JHN 19:16" />ئیتر پیلاتۆس دایه‌ ده‌ستیان تا له‌‏خاچ بدرێ‌.</para>
  <para style="s1" vid="JHN 19:16">له‌ خاچدان</para>
  <para style="p" vid="JHN 19:16">ئه‌وانیش عیسایان بردو ڕۆیشتن. <verse eid="JHN 19:16" /><verse number="17" style="v" sid="JHN 19:17" />عیساش هاته‌ده‌ره‌وه‌و خاچه‌كه‌ی هه‌ڵگرت به‌ره‌و ئه‌و شوێنه‌ ڕۆیشت كه‌ ناسرا‏بوو به‌‏شوێنی كاسه‌ی سه‌ر به‌زمانی عیبری پێیده‌وترێ‌ (گولگۆسه‌)، <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />له‌وێ‌ له‌گه‌ڵ دوو پیاو له‌خاچیاندا، هه‌ر یه‌كه‌ له‌ لایه‌كیه‌وه‌، عیساش له‌ ناوه‌ڕاست. <verse eid="JHN 19:18" /><verse number="19" style="v" sid="JHN 19:19" />پیلاتۆس له‌سه‌ر خاچه‌كه‌ دروشمێكی هه‌ڵواسی بوو له‌سه‌ری نووسرا بوو: (عیسای ناسیری پادشای جووله‌كه‌.) <verse eid="JHN 19:19" /><verse number="20" style="v" sid="JHN 19:20" />جووله‌كه‌یه‌كی زۆر دروشمه‌كه‌یان خوێنده‌وه‌، چونكه‌ ئه‌و شوێنه‌ی عیسای تیا‏دا له‌‏خاچدرابوو له‌‏شار نزیك بوو‏. دروشمه‌كه‌ش به‌زمانی عیبریو لاتینیو یۆنانی نووسرا بوو. <verse eid="JHN 19:20" /><verse number="21" style="v" sid="JHN 19:21" />سه‌رۆك كاهینه‌كانی جووله‌كه‌ به‌‏پیلاتۆسیان ووت: (مه‌نووسه‌: (پادشای جووله‌كه‌)، به‌ڵكو بنووسه‌‏: (ئه‌م پیاوه‌ خۆی ده‌یووت: من پادشای جووله‌كه‌م.))</para>
  <para style="p" vid="JHN 19:21">‏ <verse eid="JHN 19:21" /><verse number="22" style="v" sid="JHN 19:22" />پیلاتۆس وه‌ڵامیدایه‌وه‌: (ئه‌وه‌ی نووسیومه‌، نووسیومه‌!)<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />كاتێ‌ سه‌ربازه‌كان عیسایان له‌‏خاچدا، جله‌كانیان بردو كردیان به‌چوار به‌شه‌وه‌، هه‌ر سه‌ربازو به‌شێكی برد. هه‌روه‌ها كراسه‌كه‌شیان برد، كه‌ سه‌رتاپا به‌بێ‌ دروون له‌یه‌ك پارچه‌ چنرابوو. <verse eid="JHN 19:23" /><verse number="24" style="v" sid="JHN 19:24" />‏ئینجا سه‌ربازه‌كان به‌یه‌كتریان ووت: (پێویست ناكات بیدڕێنین، به‌ڵكو شێروخه‌تی له‌سه‌ر ده‌كه‌ین بزانین به‌ركێ‌ ده‌كه‌وێ‌.)</para>
  <para style="p" vid="JHN 19:24">ئه‌مه‌ش ڕوویدا تا ئه‌وه‌ی له‌‏كتێبی پیرۆزدا نووسراوه‌ بێته‌دی: [[جله‌كانمیان له‌‏نێوان خۆیان به‌ش‎كرد‏و شێروخه‌تیان له‌سه‌ر كراسه‌كه‌م كرد.]] ئه‌مه‌ش ئه‌وه‌ بوو كه‌ سه‌ربازه‌كان كردیان.<verse eid="JHN 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25" />له‌وێ‌ له‌لای خاچه‌كه‌ی عیسا، دایكی له‌گه‌ڵ مریه‌می ژنی كلۆپا كه‌ پووری بوو، هه‌روه‌ها مریه‌می مه‌جده‌لی وه‌ستابوون. <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />كاتێ‌ عیسا دایكی بینی، به‌ ته‌نیشت ئه‌و قوتابیه‌وه‌ وه‌ستاوه‌ كه‌ خۆشیده‌ویست، به‌دایكیووت: (ئه‌ی ئافره‌ت، ئه‌مه‌ كوڕته‌!) <verse eid="JHN 19:26" /><verse number="27" style="v" sid="JHN 19:27" />ئینجا به‌‏قوتابیه‌كه‌ی ووت: (ئه‌مه‌ دایكته‌.) له‌و‏كاته‌وه‌ قوتابیه‌كه‌ بردیه‌ ماڵی خۆی.<verse eid="JHN 19:27" /></para>
  <para style="s1">مردنی عیسا</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />دوای ئه‌وه‌ی عیسا بینی هه‌موو شتێ‌ ته‌واو بوو، ووتی: (‏تینوومه‌.) تا ئه‌وه‌ی له‌‏كتێبی پیرۆز باس‎كراوه‌ بێته‌دی. <verse eid="JHN 19:28" /><verse number="29" style="v" sid="JHN 19:29" />له‌وێ‌ قاپێكی پڕ له‌سركه‌ هه‌بوو، ئیسفه‌نجێكیان كرد به‌‏سركه‌كه‌و به‌‏قامیشێك به‌رزیان‏كرده‌وه‌ بۆ ده‌می. <verse eid="JHN 19:29" /><verse number="30" style="v" sid="JHN 19:30" />كاتێ‌ عیسا ده‌می له‌سركه‌كه‌دا، ووتی: (ته‌واو‏بوو!) ئینجا سه‌ری دانه‌واندو گیانی سپارد.<verse eid="JHN 19:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />جا چونكه‌ ئه‌و ڕۆژه‌ ڕۆژی خۆئاماده‌كردن بوو بۆ جه‌ژنی تێپه‌ڕبوون، ڕۆژی پاشتریش شه‌ممه‌یه‌كی مه‌زن بوو، هه‌روه‌ها تا لاشه‌كان به‌ هه‌ڵواسراوه‌یی له‌سه‌ر خاچه‌كان نه‌مێننه‌وه‌، جووله‌كه‌كان داوایان له‌‏پیلاتۆس كرد قاچی له‌‏خاچدراوه‌كان بشكێنرێ‌و لاشه‌كانیان هه‌ڵگیرێ‌. <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />ئینجا سه‌ربازه‌كان هاتن‏و هه‌ردوو قاچی ئه‌و دوو پیاوه‌یان شكاند كه‌ له‌گه‌ڵ عیسا له‌‏خاچدرابوون‏. <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />به‌ڵام كاتێ‌ گه‌یشتنه‌ سه‌ر عیسا‏، سه‌یریان‎كرد مردووه‌، ئیتر قاچیان نه‌شكاند. <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />ئینجا یه‌كێك له‌‏سه‌ربازه‌كان ڕمێكی كرد به‌لاته‌نیشتی، یه‌كسه‌ر خوێن‏و ئاوی لـێ‌ هاته‌ده‌ره‌وه‌. <verse eid="JHN 19:34" /><verse number="35" style="v" sid="JHN 19:35" />جا ئه‌وه‌ی ئه‌مه‌ی بینی خۆی شایه‌تی ده‌دا، شایه‌تیه‌كه‌شی ڕاسته‌، خۆی به‌‏ته‌واوی ده‌زانێ‌ كه‌ ڕاستی ده‌ڵێ‌، هه‌تا ئێوه‌ش باوه‌ڕبهێنن. <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />ئه‌مه‌ش ڕوویدا تا ئه‌وه‌ی له‌‏كتێب باسكراوه‌ بێته‌دی: [[ئێسقانێكی لـێ‌ناشكێ‌!]] <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" />هه‌روه‌ها له‌‏شوێنێكیتر له‌كتێب باسكراوه‌: [[سه‌یری ئه‌وه‌ ده‌كه‌ن كه‌ ڕمیان لـێ‌داوه‌.]]<verse eid="JHN 19:37" /></para>
  <para style="s1">ناشتنی عیسا</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />پاش ئه‌وه‌ یوسف ناوێك كه‌ خه‌ڵكی ڕامه‌ بوو داوای له‌پیلاتۆس كرد تا ڕێیبدات لاشه‌كه‌ی عیسا به‌رێ‌، ئه‌م یوسفه‌ش قوتابی عیسا بوو‏، به‌ڵام به‌ نهێنی چونكه‌ له‌ ده‌سه‌ڵاتدارانی جووله‌كه‌ ده‌ترسا، ئیتر پیلاتۆس ڕێیدا. ئینجا یوسف هات‏و لاشه‌كه‌ی عیسای هه‌ڵگرت. <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" />هه‌روه‌ها نیقۆدیمۆسیش هات ئه‌وه‌ی كه‌ له‌ پێشا به‌شه‌و هاتبوو بۆ لای عیسا‏. له‌گه‌ڵ خۆی نزیكه‌ی سی لیتر بۆنی مۆڕی تێكه‌ڵاو به‌ عودی هێنا. <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />لاشه‌كه‌ی عیسایان هێناو له‌گه‌ڵ بۆن به‌‏كفن پێچایانه‌وه‌، به‌و شێوه‌یه‌ی نه‌ریتی جووله‌كه‌ بوو له‌ ناشتن. <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />له‌و شوێنه‌ی عیسای تیا‏دا له‌ خاچدرا باخچه‌یه‌كی لـێ‌بوو، له‌ باخچه‌كه‌شدا گۆڕێكی تازه‌ی لـێ‌بوو، له‌وه‌و پێش كه‌سی تیادا نه‌نێژرا بوو. <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />هه‌ردووكیان عیسایان له‌و گۆڕه‌دا ناشت چونكه‌ نزیك بوو، هه‌روه‌ها له‌به‌ر ئه‌وه‌ی ئه‌و ڕۆژه‌ ڕۆژی خۆئاماده‌كردن بوو له‌لای جووله‌كه‌كان.<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s1">زیندووبوونه‌وه‌</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />‏به‌ره‌به‌یانی ڕۆژی یه‌كشه‌ممه‌، مریه‌می مه‌جده‌لی چووه‌ سه‌ر گۆڕه‌كه‌ی عیسا، هێشتا تاریك بوو، سه‌یری كرد به‌رده‌كه‌ له‌سه‌ر ده‌رگای گۆڕه‌كه‌ لابراوه‌. <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />ئه‌ویش به‌ڕاكردن هات بۆ لای شه‌معون په‌ترۆس‏و قوتابیه‌كه‌ی تر كه‌ عیسا خۆشیده‌ویست پێیووتن: (گه‌وره‌یان له‌گۆڕه‌كه‌ بردووه‌، نازانین له‌كوێ‌ دایان ناوه‌!) <verse eid="JHN 20:2" /><verse number="3" style="v" sid="JHN 20:3" />ئینجا په‌ترۆس‏و قوتابیه‌كه‌یكه‌ ڕۆیشتن به‌ره‌و گۆڕه‌كه‌. <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />هه‌ردووكیان به‌یه‌كه‌وه‌ ڕایان‎ده‌كرد، به‌ڵام قوتابیه‌كه‌یتر پێش په‌ترۆس كه‌وت‏و پێش ئه‌و گه‌یشته‌ سه‌ر گۆڕه‌كه‌، <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />دانه‌ویه‌وه‌ سه‌یریكرد كفنه‌كه‌ له‌وێ‌ كه‌وتووه‌، به‌ڵام نه‌چووه‌ ژووره‌وه‌. <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />ئینجا دوای ئه‌و شه‌معون په‌ترۆس گه‌یشته‌ سه‌ر گۆڕه‌كه‌‏و چووه‌ ژووره‌وه‌، ئه‌ویش بینی كفنه‌كه‌ له‌وێ‌ كه‌وتووه‌. <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />ئه‌و ده‌سته‌سڕه‌ی به‌سه‌ری عیساوه‌ بوو بینی به‌ته‌نها پێچراوه‌ته‌وه‌ به‌جیا له‌‏شوێنی كفنه‌كه‌. <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />له‌و‏كاته‌دا قوتابیه‌كه‌یكه‌ش هاته‌ ژووره‌وه‌، ئه‌وه‌ی یه‌كه‌مجار گه‌یشته‌ سه‌ر گۆڕه‌كه‌، ئه‌مه‌ی بینی‏و باوه‌ڕی هێنا. <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />چونكه‌ قوتابیه‌كان تا ئه‌و‏كاته‌ش تێنه‌گه‌یشتبوون ئه‌وه‌ی كتێبی پیرۆز باسی ده‌كات، ئه‌و ده‌بێ‌ له‌‏نێوان مردوواندا هه‌ستێته‌وه‌. <verse eid="JHN 20:9" /><verse number="10" style="v" sid="JHN 20:10" />ئیتر دوو قوتابیه‌كه‌ گه‌ڕانه‌وه‌ بۆ شوێنی خۆیان.<verse eid="JHN 20:10" /></para>
  <para style="s1">عیسا ‏بۆ مریه‌م ده‌رده‌كه‌وێ‌</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11" />به‌ڵام مریه‌م هه‌ر له‌ ده‌ره‌وه‌ وه‌ستاو له‌سه‌ر‏گۆڕه‌كه‌ ده‌گریا. كاتێ‌ كه‌ ده‌گریا دانه‌ویه‌وه‌ بۆ گۆڕه‌كه‌، <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />سه‌یری كرد دوو فریشته‌ به‌‏جلی سپیه‌وه‌، دانیشتوون له‌و شوێنه‌ی ته‌رمه‌كه‌ی عیسای لـێ‌دانرابوو، یه‌كێك له‌لای سه‌ریه‌وه‌ ئه‌ویكه‌ له‌لای قاچیه‌وه‌. <verse eid="JHN 20:12" /><verse number="13" style="v" sid="JHN 20:13" />لێیان‎پرسی: (خوشكه‌، بۆ ده‌گری؟) له‌وه‌ڵامدا ووتی: (گه‌وره‌میان بردووه‌، نازانم له‌كوێ‌ دایان‎ناوه‌.) <verse eid="JHN 20:13" /><verse number="14" style="v" sid="JHN 20:14" />ئه‌مه‌ی ووت‏و ئاوڕیدایه‌وه‌و سه‌یریكرد عیسا وه‌ستاوه‌، به‌ڵام مریه‌م نه‌یزانی ئه‌و عیسایه‌. <verse eid="JHN 20:14" /><verse number="15" style="v" sid="JHN 20:15" />عیسا لێیپرسی: (خوشكه‌، بۆچی ده‌گری؟ به‌دوای كێدا ده‌گه‌ڕێی؟) مریه‌میش وایزانی باخه‌وانه‌كه‌یه‌، پێیووت: (گه‌وره‌‏م گه‌ر تۆ بردووته‌ پێم بڵێ‌ له‌كوێ‌ داتناوه‌ تا بیبه‌مه‌وه‌.(<verse eid="JHN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16" />ئینجا عیسا بانگیكرد: (مریه‌م!) ئه‌ویش ئاوڕیدایه‌وه‌و به‌ زوبانی عیبری هاواری كرد: (ڕه‌بونی)، به‌واتای مامۆستا. <verse eid="JHN 20:16" /><verse number="17" style="v" sid="JHN 20:17" />عیساش پێیووت: (مه‌م‎گره‌! هێشتا نه‌ڕۆیشتووم بۆ لای باوك، به‌ڵام بڕۆ بۆ لای براكانم‏و پێیان بڵێ‌: من ده‌چم بۆ لای باوكم‏و باوكتان، خودام‏و خوداتان!) <verse eid="JHN 20:17" /><verse number="18" style="v" sid="JHN 20:18" />ئینجا مریه‌می مه‌جده‌لی گه‌ڕایه‌وه‌و هه‌واڵیدا به‌‏قوتابیه‌كان‏و پێیووتن: (من گه‌وره‌م بینی!) هه‌روه‌ها ئه‌وه‌ی پێ‌ ووتن كه‌ پێی ووتبوو.<verse eid="JHN 20:18" /></para>
  <para style="s1">ده‌ركه‌وتنی مه‌سیح بۆ قوتابیه‌كان</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />له‌ئێواره‌ی ئه‌و یه‌كشه‌ممه‌یه‌، كاتێ‌ قوتابیه‌كان له‌‏ترسی ده‌سه‌ڵاتدارانی جووله‌كه‌ به‌یه‌كه‌وه‌ بوون‏و ده‌رگاكانیان له‌سه‌ر خۆیان داخستبوو، عیسا هات له‌ناوه‌ڕاستیان وه‌ستاو ووتی: (ئاشتی بۆ ئێوه‌!) <verse eid="JHN 20:19" /><verse number="20" style="v" sid="JHN 20:20" />كاتێ‌ ئه‌مه‌ی ووت، ده‌ستی‏و لاته‌نیشتی نیشاندان، قوتابیه‌كان كاتێ‌ خوداوه‌ندیان بینی دڵشاد بوون‏. <verse eid="JHN 20:20" /><verse number="21" style="v" sid="JHN 20:21" />ئینجا عیسا پێیووتن: (ئاشتی بۆ ئێوه‌! چۆن باوك منی ناردووه‌، منیش ئاوا ئێوه‌ ده‌نێرم.) <verse eid="JHN 20:21" /><verse number="22" style="v" sid="JHN 20:22" />ئه‌مه‌ی ووت‏و فووی لـێ‌كردن‏و پێی ووتن: (‏ڕۆحی پیرۆز وه‌رگرن. <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" />ئه‌وه‌ی گوناهی ببه‌خشن، به‌خشراوه‌، ئه‌وه‌ی گوناهی نه‌به‌خشن، ئه‌وا نه‌به‌خشراوه‌!)<verse eid="JHN 20:23" /></para>
  <para style="s1">‏ده‌ركه‌وتنی مه‌سیح بۆ تۆما</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />به‌ڵام تۆما، یه‌كێك له‌‏دوانزه‌‏كه‌، كه‌ ناسرا‏بوو به‌‏دووانه‌، له‌گه‌ڵ قوتابیه‌كان نه‌بوو كاتێ‌ عیسا بۆ لایان هات‏. <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />قوتابیه‌كانیتر پێیان ووت: (ئێمه‌ گه‌وره‌مان بینی!) ئه‌ویش له‌‏وه‌ڵامدا ووتی: (گه‌ر نیشانه‌ی بزماره‌كان به‌ده‌ستیه‌وه‌ نه‌بینم، په‌نجه‌ نه‌خه‌مه‌ شوێنی بزماره‌كانه‌وه‌، ده‌ست نه‌ده‌م له‌لاته‌نیشتی باوه‌ڕناكه‌م!)<verse eid="JHN 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26" />دوای هه‌شت ڕۆژ، كاتێ‌ قوتابیه‌كانی دووباره‌ له‌‏ماڵه‌وه‌ بوون تۆماشیان له‌گه‌ڵ بوو، عیسا هات بۆ لایان‏و ده‌رگاكانیش داخرابوون، له‌ ناوه‌ڕاستیان وه‌ستاو ووتی: (ئاشتی بۆ ئێوه‌!) <verse eid="JHN 20:26" /><verse number="27" style="v" sid="JHN 20:27" />ئینجا به‌ تۆمای ووت: (په‌نجه‌ت بێنه‌ بۆ ئێره‌، سه‌یری ده‌ستم‎بكه‌، ده‌ستت بێنه‌و بیده‌ له‌لاته‌نیشتم. بێ‌باوه‌ڕ مه‌به‌ به‌ڵكو باوه‌ڕداربه‌!) <verse eid="JHN 20:27" /><verse number="28" style="v" sid="JHN 20:28" />ئه‌وسا تۆما هاواری كرد: (ئه‌ی خوداوه‌ندو خودام!) <verse eid="JHN 20:28" /><verse number="29" style="v" sid="JHN 20:29" />عیسا پێیووت: (ئایا له‌به‌رئه‌وه‌ی منت بینی باوه‌ڕت كرد؟ خۆزگه‌ده‌خوازرێ‌ به‌وانه‌ی باوه‌ڕده‌كه‌ن بێ‌ئه‌وه‌ی ببینن!)<verse eid="JHN 20:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />عیسا له‌به‌رده‌م قوتابیه‌كانی زۆر نیشانه‌ی سه‌رسوڕهێنه‌ری تریكرد كه‌ له‌م په‌رتووكه‌دا نه‌نووسراوه‌. <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />به‌ڵام ئه‌م نیشانانه‌ نووسراون تا باوه‌ڕبكه‌ن كه‌ عیسا مه‌سیحه‌، ڕۆڵه‌ی خودایه‌، هه‌تا ئێوه‌ به‌هۆی باوه‌ڕهێنانه‌وه‌ ژیان به‌ده‌ستبهێنن به‌ناوی ئه‌وه‌وه‌.<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s1">ده‌ركه‌وتنی عیسا له‌سه‌ر ده‌ریاچه‌</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />دوای ئه‌مه‌ عیسا جارێكیكه‌ به‌م شێوه‌یه‌ خۆی ده‌رخست بۆ قوتابیه‌كان له‌سه‌ر كه‌ناری ده‌ریاچه‌ی ته‌به‌ریه‌: <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />شه‌معون په‌ترۆس‏و تۆما كه‌ به‌ دووانه‌ ناسراوه‌، له‌گه‌ڵ نه‌سانائیل كه‌ خه‌ڵكی قانای ناوچه‌ی جه‌لیل بوو، هه‌روه‌ها دوو كوڕه‌كه‌ی زه‌بدیو دوو قوتابیكه‌ كۆببوونه‌وه‌. <verse eid="JHN 21:2" /><verse number="3" style="v" sid="JHN 21:3" />شه‌معون په‌ترۆس پێیووتن: (من ده‌ڕۆم بۆ ڕاو!) ئه‌وانیش ووتیان: (ئێمه‌ش له‌گه‌ڵت دێین‏.) ئینجا ڕۆیشتن‏و سواری به‌له‌م بوون، به‌ڵام له‌و شه‌وه‌دا هیچیان نه‌گرت.</para>
  <para style="p" vid="JHN 21:3">‏ <verse eid="JHN 21:3" /><verse number="4" style="v" sid="JHN 21:4" />كاتی به‌ره‌به‌یان، عیسا له‌سه‌ر ده‌ریاچه‌كه‌ وه‌ستا، به‌ڵام قوتابیه‌كان نه‌یانزانی ئه‌و عیسایه‌. <verse eid="JHN 21:4" /><verse number="5" style="v" sid="JHN 21:5" />عیسا لێیپرسین: (ها كوڕینه‌ ماسیتان پێ‌نییه‌؟) ئه‌وانیش وه‌ڵامیان دایه‌وه‌: (نه‌خێر!) <verse eid="JHN 21:5" /><verse number="6" style="v" sid="JHN 21:6" />ئه‌ویش پێیووتن: (تۆڕه‌كانتان هه‌ڵده‌ن بۆ لای ڕاستی به‌له‌مه‌كه‌، ئه‌وسا ماسی ده‌گرن!) ئه‌وانیش هه‌ڵیاندا ئیتر نه‌یان‎توانی ڕایكێشن له‌به‌ر زۆری ئه‌و ماسییانه‌ی تیایدا بوو!</para>
  <para style="p" vid="JHN 21:6">‏ <verse eid="JHN 21:6" /><verse number="7" style="v" sid="JHN 21:7" />ئه‌و قوتابیه‌ی عیسا خۆشیده‌ویست به‌ په‌ترۆسی ووت: (ئه‌وه‌ خوداوه‌نده‌!) كاتێ‌ په‌ترۆس ئه‌مه‌ی بیست، ‏خۆی داپۆشی به‌ جله‌كانی چونكه‌ ڕووت بوو و خۆی هه‌ڵدایه‌ ناو ئاوه‌كه‌. <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />قوتابیه‌كانیتر به‌به‌له‌مه‌كه‌ هاتن‏و تۆڕه‌ پڕ له‌ماسیه‌كه‌یان ڕاده‌كێشا، چونكه‌ ئه‌وه‌نده‌ دوور نه‌بوون له‌‏كه‌ناری ده‌ریاچه‌كه‌ ته‌نها دووسه‌د باڵ نه‌بێ‌‏. <verse eid="JHN 21:8" /><verse number="9" style="v" sid="JHN 21:9" />كاتێ‌ قوتابیه‌كان گه‌یشتنه‌ كه‌ناری ده‌ریاچه‌كه‌، بینییان وا نان دانراوه‌، خه‌ڵوز ئاماده‌كراوه‌و ماسی خراوه‌ته‌ سه‌ر‏. <verse eid="JHN 21:9" /><verse number="10" style="v" sid="JHN 21:10" />عیسا پێیووتن: (هه‌ندێ‌ له‌و ماسییانه‌ بهێنن كه‌ ئێستا ڕاوتان‎كرد!) <verse eid="JHN 21:10" /><verse number="11" style="v" sid="JHN 21:11" />جا شه‌معون په‌ترۆس چووه‌ ناو به‌له‌مه‌كه‌و تۆڕه‌كه‌ی ڕاكێشایه‌ سه‌ر ووشكانی، ‏سه‌دو په‌نجاو سێ‌ ماسی گه‌وره‌ی تیادا بوو، له‌گه‌ڵ ئه‌م ژماره‌ زۆره‌شدا تۆڕه‌كه‌ نه‌دڕا بوو. <verse eid="JHN 21:11" /><verse number="12" style="v" sid="JHN 21:12" />عیسا به‌ قوتابیه‌كانی ووت: (وه‌رن بخۆن.) ئیتر كه‌س له‌ قوتابیه‌كان نه‌یوێرا پرسیاری لـێ‌بكات: (تۆ كێیت؟) چونكه‌ ده‌یانزانی ئه‌و خوداوه‌نده‌. <verse eid="JHN 21:12" /><verse number="13" style="v" sid="JHN 21:13" />عیسا هاته‌ پێشه‌وه‌ نانه‌كه‌ی هه‌ڵگرت‏و دایپێیان، ماسیه‌كه‌ش به‌هه‌مان شێوه‌‏. <verse eid="JHN 21:13" /><verse number="14" style="v" sid="JHN 21:14" />ئه‌مه‌ جاری سێهه‌م بوو عیسا خۆی ده‌رخات بۆ قوتابیه‌كانی پاش ئه‌وه‌ی له‌نێو مردوواندا هه‌ستایه‌وه‌.</para>
  <para style="s1" vid="JHN 21:14">عیسا له‌گه‌ڵ په‌ترۆس ده‌دوێ</para>
  <para style="p" vid="JHN 21:14">‌ <verse eid="JHN 21:14" /><verse number="15" style="v" sid="JHN 21:15" />دوای ئه‌وه‌ی نانیان خوارد عیسا پرسیاری له‌‏شه‌معون په‌ترۆس‎كردو ووتی: (شه‌معونی كوڕی یۆنا، ئایا تۆ منت زیاتر خۆش ده‌وێ‌ یان ئه‌وانیكه‌ منیان زیاتر خۆش ده‌وێ‌؟) ئه‌ویش وه‌ڵامیدایه‌وه‌: (به‌ڵێ‌ خوداوه‌ند، تۆ ده‌زانی من خۆشم ده‌وێیت!) جا عیسا پێیووت: (به‌رخه‌كانم بله‌وه‌ڕێنه‌.) <verse eid="JHN 21:15" /><verse number="16" style="v" sid="JHN 21:16" />جارێكیكه‌ لێیپرسییه‌وه‌: (شه‌معونی كوڕی یۆنا، منت خۆش ده‌وێ‌؟) وه‌ڵامیدایه‌وه‌: (به‌ڵێ‌ خوداوه‌ند، تۆ ده‌زانی من خۆشم ده‌وێیت!) ئه‌ویش پێیووت: (شوانی مه‌ڕه‌كانم بكه‌.) <verse eid="JHN 21:16" /><verse number="17" style="v" sid="JHN 21:17" />بۆ جاری سێهه‌م لێیپرسیه‌وه‌: (ئه‌ی شه‌معونی كوڕی یۆنا، ئایا منت خۆش‎ده‌وێ‌؟) ئیتر پـه‌ترۆس دڵگران بوو چونكه‌ عیسـا بۆ جاری سێهه‌م لێیپرسی: (ئایا منت خۆش ده‌وێ‌) په‌ترۆس پێیووت: (ئه‌ی خوداوه‌ند، تۆ هـه‌موو شتێ‌ ده‌زانی. تـۆ ده‌زانـی من خۆشم‎ده‌وێیت!‏) دیسان عیسا پێیووت: (‏مه‌ڕه‌كانم بله‌وه‌ڕێنه‌. <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" />ڕاستی ڕاستیت پێ‌ده‌ڵێم كاتێ‌ كه‌ گه‌نج بووی پشتووێنه‌كه‌ت به‌ناو قه‌دته‌وه‌ ده‌به‌ست‏و بۆ هه‌ر‏شوێنێك ده‌تویست ده‌ڕۆیشتی. به‌ڵام كاتێ‌ پیر ده‌بیت ده‌ستت درێژده‌كه‌یت، یه‌كێكیكه‌ پشتوێنه‌كه‌ت بۆ ده‌به‌ستێت‏و ده‌تبات بۆ شوێنێك كه‌ ناته‌وێ‌!) <verse eid="JHN 21:18" /><verse number="19" style="v" sid="JHN 21:19" />عیسا ئه‌مه‌ی ووت وه‌ك ئاماژه‌كردنێك بۆ ئه‌و مردنه‌ی په‌ترۆس كه‌ خودا شكۆدار ده‌كات. دوای ئه‌مه‌، پێیووت: (دوام‎كه‌وه‌.)</para>
  <para style="p" vid="JHN 21:19">‏ <verse eid="JHN 21:19" /><verse number="20" style="v" sid="JHN 21:20" />په‌ترۆس ئاوڕیدایه‌وه‌ بۆ دواوه‌، ئه‌و قوتابیه‌ی بینی كه‌ عیسا خۆشیده‌ویست شوێنیان كه‌وتووه‌، ئه‌ویش ئه‌و قوتابیه‌ بوو كه‌ شانی به‌سینگی عیسا دابوو له‌كاتی نان‏خواردنه‌كه‌و پێیووت: (گه‌وره‌م، كێیه‌ ئه‌وه‌ی ناپاكیت له‌گه‌ڵ ده‌كات؟) <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />كاتێ‌ په‌ترۆس قوتابیه‌كه‌ی بینی له‌‏عیسای پرسی: (ئه‌ی خوداوه‌ند ئه‌ی ئه‌مه‌ چی لـێ‌دێ‌؟)</para>
  <para style="p" vid="JHN 21:21">‏ <verse eid="JHN 21:21" /><verse number="22" style="v" sid="JHN 21:22" />عیسا له‌ وه‌ڵامدا ووتی: (گه‌ر بمه‌وێ‌ ده‌مێنێته‌وه‌ هه‌تا ده‌گه‌ڕێمه‌وه‌، به‌ تۆ چی؟ تۆ دوام‎كه‌وه‌!) <verse eid="JHN 21:22" /><verse number="23" style="v" sid="JHN 21:23" />ئیتر هه‌واڵ له‌نێوان برا باوه‌ڕداره‌كان بڵاوبووه‌وه‌ كه‌ ئه‌و قوتابیه‌ نامرێ‌. به‌ڵام عیسـا ئه‌مـه‌ی به‌ په‌ترۆس نه‌ووت: (كـه‌ ئه‌و نامرێ‌!) به‌ڵكـو ووتی: (گــه‌ر بمـه‌وێ‌ ده‌مێنێته‌وه‌ هه‌تا ده‌گــه‌ڕێمه‌وه‌، به‌ تۆ چی؟)‏<verse eid="JHN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24" />ئه‌و قوتابییه‌ ئه‌مه‌یه‌ كه‌ ئه‌م شتانه‌ی لێره‌دا نووسیوه‌، خۆیشی شایه‌تی بۆ ئه‌م شتانه‌ ده‌دات. ئێمه‌ش ده‌زانین شایه‌تیه‌كه‌ی ڕاسته‌. <verse eid="JHN 21:24" /><verse number="25" style="v" sid="JHN 21:25" />زۆر شتی تر هه‌یه‌‏ عیسا كردوویه‌تی، له‌و باوه‌ڕه‌دام گه‌ر یه‌ك له‌دوای یه‌ك بنووسرایه‌، هه‌موو جیهان جێگای ئه‌و په‌رتووكانه‌ی تیانه‌ده‌بووه‌وه‌!<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>