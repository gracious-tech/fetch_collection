<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2CO" style="id">- Biblica® Open Sorani Kurdish Book of Life</book>
  <para style="rem">‪Copyright © 1998 by Biblica, Inc.</para>
  <para style="h">دووەم کۆرنسۆس</para>
  <para style="toc1">دووه‌م نامه‌ی پۆڵس بۆ باوه‌ڕدارانی كۆرنسۆس</para>
  <para style="toc2">دووەم کۆرنسۆس</para>
  <para style="toc3">دووەم کۆرنسۆس</para>
  <para style="mt1">دووه‌م نامه‌ی پۆڵس بۆ باوه‌ڕدارانی كۆرنسۆس</para>
  <chapter number="1" style="c" sid="2CO 1" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 1:1" />له‌ پۆڵسه‌وه‌، نێرراوی عیسای مه‌سیح له‌سه‌ر خواستی خودا، هه‌روه‌ها له‌ تیمۆساوسی براوه‌، بۆ كۆمه‌ڵه‌ی خودا له‌ كۆرنسۆس، هه‌روه‌ها بۆ هه‌موو برا پیرۆزه‌كان له‌ گشت ناوچه‌ی ئه‌خائیه‌. <verse eid="2CO 1:1" /><verse number="2" style="v" sid="2CO 1:2" />با به‌ره‌كه‌ت‏و ئاشتی خودای باوكمان‏و عیسای مه‌سیحی خوداوه‌ند بۆ ئێوه‌ بێ.<verse eid="2CO 1:2" /></para>
  <para style="s1">خودای دڵنه‌واییكه‌ر</para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 1:3" />پیرۆزه‌ خودا، باوكی عیسای مه‌سیحی خوداوه‌ند، باوكی پڕ له‌ به‌زه‌یی‏و خودای هه‌موو دڵنه‌واییه‌ك، <verse eid="2CO 1:3" /><verse number="4" style="v" sid="2CO 1:4" />هه‌ر ئه‌وه‌ له‌ هه‌موو ناخۆشییه‌كدا دڵنه‌واییمان ده‌كات، تاكو بتوانین به‌و دڵنه‌واییه‌ی له‌ خوداوه‌ وه‌رمانگرتووه‌، دڵنه‌وایی خه‌ڵكی تر بكه‌ین</para>
  <para style="p" vid="2CO 1:4">له‌‏هه‌موو ناخۆشیه‌ك. <verse eid="2CO 1:4" /><verse number="5" style="v" sid="2CO 1:5" />جا چۆن به‌شداری زۆرمان كردووه‌ له‌ ئازاری مه‌سیح، به‌هه‌مان شێوه‌ به‌هۆی مه‌سیحه‌وه‌ زۆر دڵنه‌وایی ده‌كرێین. <verse eid="2CO 1:5" /><verse number="6" style="v" sid="2CO 1:6" />گه‌ر ئێمه‌ له‌ناخۆشی بین، ئه‌وه‌ له‌پێناوی دڵنه‌وایی‏و ڕزگاری ئێوه‌یه‌، گه‌ر دڵنه‌وایی كرابین، ئه‌وه‌ش له‌پێناوی دڵنه‌وایی ئێوه‌یه‌، ئه‌وه‌ی واتان لـێ‌ده‌كات خۆتان ‎ڕاگرن به‌رامبه‌ر هه‌مان ئازار كه‌ ئێمه‌ش ده‌یچێژین. <verse eid="2CO 1:6" /><verse number="7" style="v" sid="2CO 1:7" />ئیتر هیوامان به‌ئێوه‌ چه‌سپاوه‌، چونكه‌ ده‌زانین چۆن له‌ئازار به‌شداریمان ده‌كه‌ن‏، له‌دڵنه‌واییش به‌شداریمان ده‌كه‌ن.<verse eid="2CO 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 1:8" />ئه‌ی برایان، نامانه‌وێ‌ لاتان شاراوه‌ بێ‌ ئه‌و ناخۆشیانه‌ی به‌سه‌رمان هات له‌ناوچه‌ی ئاسیا، ته‌نانه‌ت ئه‌وه‌نده‌ قورس بوو به‌ شێوه‌یه‌ك له‌سه‌رووی توانامان بوو، هه‌تا هیوای ژیانمان بڕا، <verse eid="2CO 1:8" /><verse number="9" style="v" sid="2CO 1:9" />به‌ڵكو هه‌ستمان ده‌كرد حوكمی مردن به‌سه‌رمان دراوه‌‏، تا پشت نه‌به‌ستین به‌ خۆمــان، به‌ڵكـو به‌و خـودایه‌ی مردووان هه‌ڵده‌ستێنێته‌وه‌. <verse eid="2CO 1:9" /><verse number="10" style="v" sid="2CO 1:10" />ئه‌و بوو له‌و مـردنه‌ ڕزگاری كردین‏و ڕزگارمان ده‌كات، هیوامان له‌ئه‌ودایه‌ كه‌ هێشتا هه‌ر ڕزگارمان ده‌كات. <verse eid="2CO 1:10" /><verse number="11" style="v" sid="2CO 1:11" />هه‌روه‌ها ئێوه‌ش پێویسته‌ به‌نوێژه‌كانتان یارمه‌تی پێشكه‌ش بكه‌ن، تا خه‌ڵكێكی زۆر سوپاسی خودا بكه‌ن له‌پێناوی ئێمه‌ له‌سه‌ر ئه‌و پیرۆزیه‌ی پێمان دراوه‌ به‌هۆی نوێژی خه‌ڵكێكی زۆر.<verse eid="2CO 1:11" /></para>
  <para style="s1">پۆڵس پلانه‌كه‌ی ده‌گۆڕێ‌</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 1:12" />چونكه‌ ئه‌مه‌یه‌ شانازی ئێمه‌، ویژدانمان شایه‌تمانه‌ له‌هه‌ڵسوكه‌وتمان له‌جیهان، به‌تایبه‌تی سه‌باره‌ت به‌ ئێوه‌ به‌بێ‌ دووڕووییو به‌دڵسۆزی خودا، ئه‌مه‌ش به‌دانایی مرۆڤانه‌ نییه‌ به‌ڵكو به‌به‌ره‌كه‌تی خودایه‌. <verse eid="2CO 1:12" /><verse number="13" style="v" sid="2CO 1:13" />ئێمه‌ شتێكتان بۆ ده‌نووسین بتوانن بیخوێننه‌وه‌و لێی تێبگه‌ن. هیوادارم به‌ته‌واوی تێبگه‌ن، ‏ <verse eid="2CO 1:13" /><verse number="14" style="v" sid="2CO 1:14" />ئه‌وه‌ی ئێستا هه‌ندێكی لێ تێده‌گه‌ن. ئه‌وه‌ش ئه‌مه‌یه‌، بزانن ئێمه‌ هۆی شانازی ئێوه‌ین، هه‌روه‌ها ئێوه‌ش هی ئێمه‌ له‌ڕۆژی عیسای خوداوه‌ند.<verse eid="2CO 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 1:15" />‏له‌به‌ر ئه‌وه‌ی بێ‌گومان‏بووم له‌م شته‌، وویستم یه‌كه‌م جار بێم بۆ لای ئێوه‌ تا دووجار سوود ببینن، <verse eid="2CO 1:15" /><verse number="16" style="v" sid="2CO 1:16" />ئه‌وه‌ش ئه‌وه‌یه‌ كاتێ‌ ده‌ڕۆم بۆ مه‌كدۆنیا دیده‌نیتان ده‌كه‌م ئینجا كه‌ له‌وسه‌ر گه‌ڕامه‌وه‌ سه‌رتان لـێ‌ده‌ده‌مه‌وه‌، دوای ئه‌وه‌ی ڕێگای سه‌فه‌رم بۆ ئاسان بكه‌ن بۆ ناوچه‌ی یه‌هودیه‌. <verse eid="2CO 1:16" /><verse number="17" style="v" sid="2CO 1:17" />ئایا من دوو دڵم كاتێ‌ ویستم ئه‌وه‌ بكه‌م؟ ئایا من پلانه‌كانم وه‌ك مرۆڤێكی ئه‌م جیهانه‌ داناوه‌، كه‌ ئاماده‌یه‌ له‌یه‌ك كات بڵێ‌ نه‌خێرو به‌ڵێ‌؟ <verse eid="2CO 1:17" /><verse number="18" style="v" sid="2CO 1:18" />وه‌ك چۆن خودا سه‌رڕاسته‌، ووشه‌كانی ئێمه‌ش بۆ ئێوه‌ (به‌ڵێ‌)و (نه‌خێر) نییه‌، <verse eid="2CO 1:18" /><verse number="19" style="v" sid="2CO 1:19" />هه‌روه‌ها عیسای مه‌سیحی ڕۆڵه‌ی خودا، ئه‌وه‌ی من‏و سیلوانس‏و تیمۆساوس مزگێنی ئه‌ومان پێتان‏دا، له‌یه‌ك كات (به‌ڵێ‏)و (‏نه‌خێر)ی نه‌وتووه‌. به‌ڵام له‌ئه‌ودا به‌رده‌وام هه‌ر (به‌ڵێ‌) بووه‌، <verse eid="2CO 1:19" /><verse number="20" style="v" sid="2CO 1:20" />چونكه‌ هه‌موو به‌ڵێنه‌كانی خودا له‌ئه‌ودا (به‌ڵێی) خۆی دۆزیه‌وه‌. بۆیه‌ ئێمه‌ به‌هۆی ئه‌وه‌وه‌ ده‌ڵێین (‏ئامین)، بۆ شكۆمه‌ندی خودا. <verse eid="2CO 1:20" /><verse number="21" style="v" sid="2CO 1:21" />ئه‌وه‌ خودایه‌ ئێمه‌و ئێوه‌ی له‌مه‌سیحدا چه‌سپاندووه‌، هه‌روه‌ها ده‌ستنیشانی كردووین. <verse eid="2CO 1:21" /><verse number="22" style="v" sid="2CO 1:22" />هه‌ر ئه‌ویشه‌ مۆری خۆی لـێ‌داوین‏و ڕۆحی پیرۆزی پێمان به‌خشیوه‌ وه‌ك پێشه‌كی.<verse eid="2CO 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2CO 1:23" />خودا ئاگای لێیه‌ بۆچی نه‌هاتم بۆ كۆرنسۆس، چونكه‌ به‌زه‌ییم پێتان ده‌هاته‌وه‌. <verse eid="2CO 1:23" /><verse number="24" style="v" sid="2CO 1:24" />ئێمه‌ نامانه‌وێ‌ ده‌ست به‌سه‌ر باوه‌ڕتان بگرین، به‌ڵكو ئێمه‌ له‌گه‌ڵتان كار ده‌كه‌ین بۆ خۆشیتان، چونكه‌ ئێوه‌ به‌باوه‌ڕ چه‌سپاون.<verse eid="2CO 1:24" /></para>
  <chapter eid="2CO 1" />
  <chapter number="2" style="c" sid="2CO 2" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 2:1" />له‌به‌رئه‌وه‌ بڕیارم‎دا نه‌یه‌م بۆ لاتان، تاكو سه‌ردانه‌كه‌م به‌ غه‌مباریه‌وه‌ نه‌بێ. <verse eid="2CO 2:1" /><verse number="2" style="v" sid="2CO 2:2" />چونكه‌ گه‌ر من دڵته‌نگم كردن‏، ئیتر كێ‌ دڵشادم ده‌كات جگه‌ له‌ئێوه‌ كه‌ دڵته‌نگم كردوون؟ <verse eid="2CO 2:2" /><verse number="3" style="v" sid="2CO 2:3" />بۆیه‌ نامه‌ی پێشوم بۆ نووسین، تا كاتێ‌ هاتم دڵگران نه‌بم به‌وانه‌ی پێویسته‌ ببنه‌ سه‌رچاوه‌ی خۆشیم. ‏باوه‌ڕم به‌ هه‌مووتان هه‌یه‌، كه‌وا خۆشی من خۆشی هه‌مووتانه‌. <verse eid="2CO 2:3" /><verse number="4" style="v" sid="2CO 2:4" />كاتێ‌ نامه‌ی یه‌كه‌مم بۆ ناردن زۆر غه‌مبارو دڵته‌نگ بووم‏و فرمێسك به‌چاومدا ده‌هاته‌خواره‌وه‌، مه‌به‌ستم ئه‌وه‌ نه‌بوو دڵته‌نگتان بكه‌م به‌ڵكو تا بزانن من چه‌ند ئێوه‌م خۆش‎ده‌وێ‌.<verse eid="2CO 2:4" /></para>
  <para style="s1">لـێ‌خۆش‏بوون له‌ گوناهبار</para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 2:5" />گه‌ر هاتوو یه‌كێكتان بووه‌ هۆی دڵته‌نگیتان، ئه‌مه‌ ته‌نها من دڵته‌نگ ناكات، به‌ڵكو تا ڕاده‌یه‌ك هه‌مووتان، گه‌ر زۆرم نه‌ووتبێ. <verse eid="2CO 2:5" /><verse number="6" style="v" sid="2CO 2:6" />ئێستا ئیتر به‌سه‌ ئه‌و سزایه‌ی له‌لایه‌ن زۆربه‌تانه‌وه‌ دراوه‌ به‌سه‌ر ئه‌و كابرایه‌، <verse eid="2CO 2:6" /><verse number="7" style="v" sid="2CO 2:7" />به‌ پێچه‌وانه‌ی ئه‌وه‌ باشتره‌ بۆتان لێیخۆش‎بن‏و دڵنه‌وایی بكه‌ن، ئه‌گینا خه‌فه‌ت گیانی تێك‎ده‌شكێنێ‌. <verse eid="2CO 2:7" /><verse number="8" style="v" sid="2CO 2:8" />له‌به‌رئه‌وه‌ ڕاتان‎ده‌سپێرم خۆشه‌ویستی خۆتانی بۆ ده‌ربڕن. <verse eid="2CO 2:8" /><verse number="9" style="v" sid="2CO 2:9" />من ئه‌مه‌م بۆ نووسیون هه‌تا تاقیتان ‎بكه‌مه‌وه‌‏و ببینم ئایا بۆ هه‌موو شتێك ملكه‌چن. <verse eid="2CO 2:9" /><verse number="10" style="v" sid="2CO 2:10" />گه‌ر هاتوو له‌یه‌كێك خۆش بوون، ئه‌وسا منیش لێیخۆش ده‌بم. جا له‌به‌ر ئێوه‌ له‌به‌رده‌م مه‌سیح له‌و كه‌سه‌ یاخود له‌و شته‌ خۆش ده‌بم. <verse eid="2CO 2:10" /><verse number="11" style="v" sid="2CO 2:11" />تا شه‌یتان ده‌ست به‌سه‌رماندا نه‌گرێت، چونكه‌ ئێمه‌ له‌مه‌به‌سته‌كانی شه‌یتان بێ‎ئاگا نین.<verse eid="2CO 2:11" /></para>
  <para style="s1">سه‌ركه‌وتن به‌هۆی عیسا</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 2:12" />كاتێ‌ گه‌یشتمه‌ شاری ترواس تا مزگێنی مه‌سیح بده‌م، ئه‌وسا ده‌رگای كاركردنی خوداوه‌ندم بۆ كرایه‌وه‌. <verse eid="2CO 2:12" /><verse number="13" style="v" sid="2CO 2:13" />به‌ڵام زۆر ناڕه‌حه‌ت بووم‏، چونكه‌ تیتۆسی برام نه‌دۆزیه‌وه‌، ئیتر ماڵئاواییم له‌‏‎باوه‌ڕداران كردو ڕۆیشتم بۆ ناوچه‌ی مه‌كدۆنیا.<verse eid="2CO 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 2:14" />‏به‌ڵام سوپاس بۆ خوا، ئه‌وه‌ی هه‌موو كاتێ‌ به‌ره‌و سه‌ركه‌وتنمان ده‌بات، هه‌روه‌ها به‌هۆی ئێمه‌ له‌هه‌موو شوێنێك زانیاری مه‌سیح بڵاوده‌كاته‌وه‌ وه‌ك بۆنێكی خۆش. <verse eid="2CO 2:14" /><verse number="15" style="v" sid="2CO 2:15" />ئێمه‌ لای خودا بۆنی خۆشی مه‌سیحین له‌نێوان ئه‌وانه‌ی ڕزگاریان ده‌بێ‌‏و له‌نێوان ئه‌وانه‌ی له‌ناوده‌چن. <verse eid="2CO 2:15" /><verse number="16" style="v" sid="2CO 2:16" />بۆ ئه‌وانه‌ بۆنی مردنه‌ بۆ مردن، بۆ ئه‌وانی تر بۆنی ژیانه‌ بۆ ژیان، ئایا كێ‌ به‌توانایه‌ بۆ ئه‌م كاره‌؟ <verse eid="2CO 2:16" /><verse number="17" style="v" sid="2CO 2:17" />ئێمه‌ وه‌ك زۆربه‌ی خه‌ڵك بازرگانی ناكه‌ین به‌ ووشه‌ی خودا، به‌ڵكو به‌ دڵسۆزی له‌به‌رده‌م خوداو له‌لایه‌ن خوداوه‌ باسی عیسای مه‌سیح ده‌كه‌ین.<verse eid="2CO 2:17" /></para>
  <chapter eid="2CO 2" />
  <chapter number="3" style="c" sid="2CO 3" />
  <para style="s1">خزمه‌تكاری په‌یمانی نوێ‌</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 3:1" />ئایا ئێمه‌ دووباره‌ ده‌ست به‌ ستایش‎كردنی خۆمان ده‌كه‌ین؟ یان پێویسته‌ وه‌ك هه‌ندێ‌ كه‌س ده‌یكه‌ن، ڕاسپارده‌ نامه‌تان نیشان بده‌ین‏، یان ئێوه‌ شتێكی وا به‌ ئێمه‌ بده‌ن؟ <verse eid="2CO 3:1" /><verse number="2" style="v" sid="2CO 3:2" />ئێوه‌ نامه‌ی ئێمه‌ن كه‌ له‌‏دڵمان نووسراوه‌، له‌لایه‌ن هه‌موو خه‌ڵك ده‌توانرێ‌ بخوێنرێته‌وه‌و بناسرێ‌. <verse eid="2CO 3:2" /><verse number="3" style="v" sid="2CO 3:3" />به‌ڵێ‌ ده‌ركه‌وت ئێوه‌ نامه‌ی مه‌سیحن، ئه‌وه‌ی ئێمه‌ له‌سه‌ر داواكاری ئه‌و نووسیومانه‌، ئه‌مه‌ش به‌ مه‌ره‌كه‌ب نه‌نووسراوه‌ به‌ڵكو به‌ ڕۆحی زیندووی خودا، هه‌روه‌ها له‌سه‌ر ته‌خته‌ی به‌ردین ‏نه‌نووسراوه‌‏، به‌ڵكو له‌سه‌ر ته‌خته‌ی دڵی مرۆڤ.<verse eid="2CO 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 3:4" />ئێمه‌ متمانه‌یه‌كی له‌م جۆره‌مان هه‌یه‌ به‌هۆی مه‌سیح سه‌باره‌ت به‌خودا. <verse eid="2CO 3:4" /><verse number="5" style="v" sid="2CO 3:5" />ئه‌وه‌ش نه‌ك بڵێین به‌تواناین تا بڵێین ئێمه‌ شتێكمان هه‌یه‌، توانای ئێمه‌ له‌خوداوه‌یه‌. <verse eid="2CO 3:5" /><verse number="6" style="v" sid="2CO 3:6" />ئه‌وه‌ی ئه‌و توانایه‌یدا به‌ئێمه‌ تا ببین به‌خزمه‌تكاری په‌یمانی نوێ‌. په‌یمانی ڕۆح نه‌ك نووسراوی كۆن، چونكه‌ نووسراوی كۆن ده‌كوژێ‌، به‌ڵام ڕۆح ژیان ده‌به‌خشێ‌.<verse eid="2CO 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 3:7" />گه‌ر بێتو ئه‌و خزمه‌ته‌ی ده‌بێته‌ هۆی مردن كه‌ له‌سه‌ر به‌رد هه‌ڵكه‌نرا بوو [[[شه‌ریعه‌ت]]] به‌مه‌زنی هاتبێ‌، به‌ شێوه‌یه‌ك نه‌وه‌ی ئیسرائیل نه‌یانتوانی به‌ته‌واوی سه‌یری ڕووی موسا بكه‌ن، به‌هۆی دره‌وشانه‌وه‌ی ده‌موچاوی، كه‌ فه‌وتاوه‌، <verse eid="2CO 3:7" /><verse number="8" style="v" sid="2CO 3:8" />ئاخۆ ده‌بێ‌ چه‌ند به‌شكۆو مه‌زنتر بێ‌ خزمه‌تی ڕۆحی پیرۆز؟ <verse eid="2CO 3:8" /><verse number="9" style="v" sid="2CO 3:9" />گه‌ر بێتو ئه‌و خزمه‌ته‌ی ده‌بێته‌ هۆی تاوانباركردن شكۆمه‌ندبێ، ئیتر ده‌بێ‌ خزمه‌تی بێ‌تاوان كردن چه‌ند شكۆدارتر بێ‌؟ <verse eid="2CO 3:9" /><verse number="10" style="v" sid="2CO 3:10" />له‌م حاڵه‌ته‌ ئه‌وه‌ی شكۆمه‌ندی هه‌بوو شكۆدار نه‌ماوه‌ ئێستا له‌به‌راورد كردنی له‌گه‌ڵ شكۆمه‌ندی ڕاده‌به‌ده‌ر. <verse eid="2CO 3:10" /><verse number="11" style="v" sid="2CO 3:11" />چونكه‌ گه‌ر ئه‌وه‌ی له‌ناوچوو بوو شكۆدار بوو، باشه‌ ئه‌وه‌ی نه‌مره‌ ده‌بێ‌ چ شكۆمه‌ندییه‌كی هه‌بێ‌!<verse eid="2CO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 3:12" />چونكه‌ ئێمه‌ ئه‌م هیوایه‌مان هه‌یه‌، ئێمه‌ چاونه‌ترسین. <verse eid="2CO 3:12" /><verse number="13" style="v" sid="2CO 3:13" />‏ئێمه‌ وه‌ك موسا نین، ئه‌وه‌ی پێچه‌ی له‌سه‌ر ده‌م‏و چاوی دانا، هه‌تا ئیسرائیلیه‌كان كۆتایی شكۆی فه‌وتاو نه‌بینن‏. <verse eid="2CO 3:13" /><verse number="14" style="v" sid="2CO 3:14" />‏به‌ڵكو مێشكیان تاریك بووه‌، چونكه‌ تا ئه‌مڕۆش، كاتی په‌یمانی كۆن ده‌خوێننه‌وه‌، هه‌مان پێچه‌ هه‌ر ماوه‌، چونكه‌ ته‌نها به‌مه‌سیح لاده‌چێ‌، <verse eid="2CO 3:14" /><verse number="15" style="v" sid="2CO 3:15" />به‌ڵێ‌، تا ئه‌مڕۆ هێشتا مێشكیان داخراوه‌، كاتێ‌ شه‌ریعه‌تی موسا ده‌خوێنرێته‌وه‌ بۆیان. <verse eid="2CO 3:15" /><verse number="16" style="v" sid="2CO 3:16" />به‌ڵام گه‌ر مرۆڤ ڕوو‏بكاته‌ خوداوه‌ند، ئه‌وسا ئه‌و پێچه‌یه‌ لاده‌چێ‌. <verse eid="2CO 3:16" /><verse number="17" style="v" sid="2CO 3:17" />ئێستا خوداوه‌ند ڕۆحه‌، جا ڕۆحی خوداوه‌ند له‌هه‌ركوێ‌ بێت، ئازادی له‌وێیه‌. <verse eid="2CO 3:17" /><verse number="18" style="v" sid="2CO 3:18" />ئێمه‌ هه‌موومان به‌ڕوویه‌كی كراوه‌ ته‌ماشای شكۆمه‌ندی خوداوه‌ند ده‌كه‌ین، هه‌روه‌ك له‌ئاوێنه‌دا، ده‌گۆڕێین بۆ وێنه‌ی ئه‌و، له‌پله‌یه‌كی شكۆمه‌ندی بۆ پله‌یه‌كی تر، ئه‌وه‌ش له‌خوداوه‌نده‌وه‌ دێت كه‌ ڕۆحه‌.<verse eid="2CO 3:18" /></para>
  <chapter eid="2CO 3" />
  <chapter number="4" style="c" sid="2CO 4" />
  <para style="s1">د‏ ڵسۆزی له‌ خزمه‌تكردن</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 4:1" />له‌به‌رئه‌وه‌ی خودا به‌ به‌زه‌یی خۆی ئه‌م خزمه‌ته‌ی داوه‌ به‌ ئێمه‌، ئیتر نابێ‌ ووره‌ به‌ربده‌ین. <verse eid="2CO 4:1" /><verse number="2" style="v" sid="2CO 4:2" />چونكه‌ هه‌موو هه‌ڵسوكه‌وتێكی ناشرین‏و ته‌ڵه‌كه‌بازی ڕه‌ت ده‌كه‌ینه‌وه‌، فێڵ ‎ناكه‌ین‏و ووشه‌ی خودا ناگۆڕین، به‌ڵكو به‌ ده‌رخستنی ڕاستی ڕاستگۆیی خۆمان ده‌سه‌لمێنین بۆ ویژدانی هه‌موو خه‌ڵك له‌به‌رده‌م خودا. <verse eid="2CO 4:2" /><verse number="3" style="v" sid="2CO 4:3" />به‌ڵام گه‌ر مزگێنیه‌كه‌مان شاراوه‌ بێ‌، ته‌نها لای ئه‌وانه‌ شاراوه‌یه‌ كه‌ له‌ناوده‌چن، <verse eid="2CO 4:3" /><verse number="4" style="v" sid="2CO 4:4" />خوداوه‌ندی ئه‌م جیهانه‌ [شه‌یتان] ئه‌و بێ‌باوه‌ڕانه‌ی وا كوێر كردووه‌، نه‌توانن ڕووناكی مزگێنی ‏شكۆمه‌ندی مه‌سیح ببینن، ئه‌وه‌ی وێنه‌ی خودایه‌. <verse eid="2CO 4:4" /><verse number="5" style="v" sid="2CO 4:5" />‏ئێمه‌ مزگێنی بۆ خۆمان ناده‌ین، به‌ڵكو مزگێنی عیسای مه‌سیح ده‌ده‌ین كه‌ خوداوه‌نده‌، ئێمه‌ش خزمه‌تكاری ئێوه‌ین له‌پێناوی عیسا. <verse eid="2CO 4:5" /><verse number="6" style="v" sid="2CO 4:6" />چونكه‌ خودا بوو ووتی: [[با له‌‏تاریكی ڕووناكی هه‌ڵبێت]]، هه‌ر ئه‌و بوو دڵمانی ڕووناك كرده‌وه‌، بۆ ڕووناك‎كردنه‌وه‌ی زانیاری شكۆمه‌ندی خودا له‌ڕووی مه‌سیح.<verse eid="2CO 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 4:7" />به‌ڵام ئه‌م گه‌نجینه‌یه‌ی ئێمه‌ هه‌مانه‌ له‌ناو گۆزه‌ی گڵه‌، تا ئه‌و هێزه‌ له‌ ڕاده‌به‌ده‌ره‌ ده‌ركه‌وێ، كه‌ له‌خوداوه‌یه‌ نه‌ك له‌خۆمان. <verse eid="2CO 4:7" /><verse number="8" style="v" sid="2CO 4:8" />ناخۆشی ته‌نگمان پێ‌ هه‌ڵده‌چنێ‌ له‌ هه‌موو لایه‌كه‌وه‌، به‌ڵام ووره‌ به‌رناده‌ین. سه‌رمان لێ‎ده‌شێوێ‌، به‌ڵام بی هیوا نابین. <verse eid="2CO 4:8" /><verse number="9" style="v" sid="2CO 4:9" />‏ده‌‎چه‌وسێینه‌وه‌، به‌ڵام خودا وازمان لـێ‌ناهێنێ‌، به‌ زه‌ویماندا ده‌ده‌ن، به‌ڵام له‌ناوناچین. <verse eid="2CO 4:9" /><verse number="10" style="v" sid="2CO 4:10" />هه‌موو كاتێ‌ له‌ له‌شماندا ئازاری مردنی عیسا هه‌ڵده‌گرین، تا ژیانیشی له‌ له‌شمان ده‌ركه‌وێ‌. <verse eid="2CO 4:10" /><verse number="11" style="v" sid="2CO 4:11" />هه‌رچه‌نده‌ ئێمه‌ جارێ‌ زیندووین، له‌گه‌ڵ ئه‌وه‌شدا هه‌میشه‌ ده‌درێینه‌ ده‌ست مردن له‌پێناوی عیسا، تا له‌ له‌شی فه‌وتاومان ژیانی عیسا ده‌ركه‌وێ‌. <verse eid="2CO 4:11" /><verse number="12" style="v" sid="2CO 4:12" />ئیتر به‌م شێوه‌یه‌، مردن له‌ئێمه‌ كار ده‌كات، به‌ڵام ژیان له‌ئێوه‌دا كار ده‌كات.<verse eid="2CO 4:12" /></para>
  <para style="s1">چاونه‌ترسی له‌ خزمه‌تكردن</para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 4:13" />چونكه‌ ئێمه‌ هه‌مان ڕۆحی باوه‌ڕمان هه‌یه‌، بۆیه‌ وه‌كو ئه‌وه‌ی نووسیویه‌تی: [[باوه‌ڕم كرد بۆیه‌ قسه‌م كرد.]] ئێمه‌ش باوه‌ڕمان هه‌یه‌ بۆیه‌ قسه‌ ده‌كه‌ین. <verse eid="2CO 4:13" /><verse number="14" style="v" sid="2CO 4:14" />ئێمه‌ ده‌زانین ئه‌وه‌ی عیسای خوداوه‌ندی له‌نێو مردووان هه‌ستانده‌وه‌، له‌گه‌ڵ عیسا ئێمه‌ش هه‌ڵده‌سێنێته‌وه‌، ئه‌وسا ئێمه‌ له‌گه‌ڵ ئێوه‌ به‌یه‌كه‌وه‌ بۆ به‌رده‌می خۆی ده‌بات. <verse eid="2CO 4:14" /><verse number="15" style="v" sid="2CO 4:15" />ئه‌م شتانه‌ هه‌مووی ده‌چێژین له‌پێناوی ئێوه‌دا، تا به‌ره‌كه‌تی خودا زۆر بێت بۆ خه‌ڵكێكی زیاتر، تاببێته‌ مایه‌ی به‌رزكردنه‌وه‌ی سوپاسی زیاتر بۆ شكۆمه‌ندی خودا.</para>
  <para style="p" vid="2CO 4:15">‏ <verse eid="2CO 4:15" /><verse number="16" style="v" sid="2CO 4:16" />له‌به‌رئه‌وه‌ ووره‌ به‌رناده‌ین، گه‌ر به‌ ڕواڵه‌تیش له‌ناوبچین، ئه‌وا ناوه‌ڕۆك‏و ده‌روونمان ڕۆژ به‌‏رۆژ تازه‌تر ده‌بێته‌وه‌. <verse eid="2CO 4:16" /><verse number="17" style="v" sid="2CO 4:17" />ئه‌و ئازاره‌ سووك‏و كه‌م خایه‌نه‌مان شكۆمه‌ندیه‌كی گرانی هه‌تاهه‌تایی لی دێته‌كایه‌وه‌ بۆمان، <verse eid="2CO 4:17" /><verse number="18" style="v" sid="2CO 4:18" />چونكه‌ ئێمه‌ ته‌ماشای شته‌ بینراوه‌كان ناكه‌ین، به‌ڵكو ته‌ماشای شته‌ نه‌بینراوه‌كان ده‌كه‌ین، چونكه‌ شته‌ بینراوه‌كان كاتین‏، به‌ڵام شته‌ نه‌بینراوه‌كان هه‌میشه‌یین.<verse eid="2CO 4:18" /></para>
  <chapter eid="2CO 4" />
  <chapter number="5" style="c" sid="2CO 5" />
  <para style="s1">ما‎‏ڵی هه‌تاهه‌تای</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 5:1" />ئێمه‌ ئه‌وه‌ ده‌زانین، كه‌ی چادری زه‌وییمان ڕووخا ئه‌وه‌ی تیایدا ده‌ژین، له‌لایه‌ن خوداوه‌ ماڵی هه‌تاهه‌تایمان ده‌درێتێ‌ له‌ئاسمان، كه‌ به‌‏ده‌ست دروست نه‌كراوه‌. <verse eid="2CO 5:1" /><verse number="2" style="v" sid="2CO 5:2" />چه‌ند به‌‏تاسه‌وه‌ ئاره‌زووی ئه‌وه‌ ده‌كه‌ین، ماڵی ئاسمانیمان بكرێته‌ به‌ر، <verse eid="2CO 5:2" /><verse number="3" style="v" sid="2CO 5:3" />چونكه‌ هه‌ر كاتێ‌ له‌به‌رمان‎كرد ڕووت نابین. <verse eid="2CO 5:3" /><verse number="4" style="v" sid="2CO 5:4" />ئه‌وه‌نده‌ی له‌م چادره‌داین، ده‌ناڵێنین له‌ژێر بارگرانی، نامانه‌وێ‌ ئه‌و خانووه‌ دابكه‌نین، به‌ڵكو ئه‌وه‌ی تریش له‌سه‌ری له‌به‌ر بكه‌ین، تاكو ژیانی تازه‌ هه‌رچی فه‌وتاوه‌ تیامان هه‌ڵیلووشێ‌. <verse eid="2CO 5:4" /><verse number="5" style="v" sid="2CO 5:5" />به‌ڵام خودا خۆیه‌تی ئێمه‌ی بۆ ئه‌م مه‌به‌سته‌ ئاماده‌ كردووه‌، جا بۆ ئه‌م شتانه‌ هه‌مووی، ڕۆحی پیرۆزی وه‌ك پێشه‌كی پێمان داوه‌. <verse eid="2CO 5:5" /><verse number="6" style="v" sid="2CO 5:6" />‏ئێمه‌ هه‌موو كاتێ‌ بڕوامان هه‌یه‌و ده‌زانین كه‌ ئێمه‌ كاتێ‌ له‌له‌شدا نیشته‌جێین له‌خوداوه‌ند دوورین. <verse eid="2CO 5:6" /><verse number="7" style="v" sid="2CO 5:7" />چونكه‌ ئێمه‌ به‌باوه‌ڕ ده‌ڕۆین نه‌ك به‌ بینراو. <verse eid="2CO 5:7" /><verse number="8" style="v" sid="2CO 5:8" />كه‌واته‌ ئێمه‌ دڵنیاین، به‌لامانه‌وه‌ باشتره‌ واز له‌م له‌شه‌ بهێنین‏و لای خوداوه‌ند نیشته‌جێ‌ بین. <verse eid="2CO 5:8" /><verse number="9" style="v" sid="2CO 5:9" />‏ئیتر وه‌ك یه‌ك وایه‌ لای ئێمه‌، گه‌ر لای خوداوه‌ند بین یاخود له‌سه‌ر ئه‌م زه‌ویه‌ بژین، ئامانجمان ڕازیكردنیه‌تی. <verse eid="2CO 5:9" /><verse number="10" style="v" sid="2CO 5:10" />چونكه‌ ده‌بێ‌ هه‌موومان له‌به‌رده‌م دادگای مه‌سیح ڕاوه‌ستین، تاكو هه‌ر یه‌ك له‌ ئێمه‌ پاداشتی خۆی وه‌رگرێ‌ به‌گوێره‌ی ئه‌و كارانه‌ی كردوویه‌تی كاتێ‌ به‌له‌ش ژیاوه‌، ئیتر باش بووبێ‌ یاخود خراپ.<verse eid="2CO 5:10" /></para>
  <para style="s1">خزمه‌تی ئاشت‎بوونه‌وه‌</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 5:11" />چونكه‌ ترسی خوداوه‌ند له‌ دڵمانه‌، ئێمه‌ هه‌وڵ ده‌ده‌ین باوه‌ڕ به‌ خه‌ڵكی بهێنین. به‌ڵام خودا به‌ته‌واوی ده‌مان‎ناسێ‌، هیوادارین ئێوه‌ش به‌ ویژدانتان به‌ ته‌واوی ئێمه‌ بناسن. <verse eid="2CO 5:11" /><verse number="12" style="v" sid="2CO 5:12" />‏ئێمه‌ نامانه‌وێ‌ ستایشی خۆمان بكه‌ین، به‌ڵكو ده‌مانه‌وێ‌ پێتان بڵێین به‌چییه‌وه‌ شانازیمان پێ‌بكه‌ن، ئه‌وسا ده‌توانن وه‌ڵامی ئه‌وانه‌ بده‌نه‌وه‌ كه‌وا شانازی به‌ ڕواڵه‌تی مرۆڤ ده‌كه‌ن نه‌ك به‌وه‌ی له‌ دڵیایه‌تی. <verse eid="2CO 5:12" /><verse number="13" style="v" sid="2CO 5:13" />گه‌ر مێشكمان تێكچوو بێ‌ ئه‌وه‌ بۆ خودایه‌، گه‌ر هۆشمه‌ندیش بین ئه‌وه‌ له‌به‌ر ئێوه‌یه‌. <verse eid="2CO 5:13" /><verse number="14" style="v" sid="2CO 5:14" />چونكه‌ خۆشه‌ویستی مه‌سیح ده‌ستی به‌سه‌ر ئێمه‌ گرتووه‌، له‌به‌ر ئه‌وه‌ی زانیمان یه‌كێك له‌جیاتی هه‌موو خه‌ڵك مرد، ئیتر هه‌موو خه‌ڵك مردن. <verse eid="2CO 5:14" /><verse number="15" style="v" sid="2CO 5:15" />ئه‌و له‌پێناوی هه‌مووان مرد هه‌تا زیندووان ئیتر بۆ خۆیان نه‌ژین، به‌ڵكو بۆ ئه‌وه‌ی له‌پێناویان مردو هه‌ستایه‌وه‌. <verse eid="2CO 5:15" /><verse number="16" style="v" sid="2CO 5:16" />له‌مه‌ولا به‌پێی ڕواڵه‌ت ته‌ماشای كه‌س ناكه‌ین، گه‌ر بێتو جاران به‌پێی له‌ش ته‌ماشای مه‌سیحمان كردبێ‌، ئیتر له‌‏ئێستاوه‌ به‌م شێوه‌یه‌ نایناسین. <verse eid="2CO 5:16" /><verse number="17" style="v" sid="2CO 5:17" />گه‌ر یه‌كێك سه‌ر به‌ مه‌سیح بێ‌، ئه‌وا ده‌بێته‌ بوونه‌وه‌رێكی تازه‌، شته‌ كۆنه‌كان نه‌مان‏و به‌سه‌رچوون، ئه‌وه‌تا هه‌موو شت نوێ‌ بووه‌ته‌وه‌. <verse eid="2CO 5:17" /><verse number="18" style="v" sid="2CO 5:18" />ئه‌مه‌ش هه‌مووی له‌خوداوه‌یه‌ كه‌ ئاشتیكردینه‌وه‌ له‌گه‌ڵ خۆی به‌هوێ‌ مه‌سیح، ئینجا‏ خزمه‌ت كردنی ئه‌م ئاشتبوونه‌وه‌یه‌ی به‌ ئێمه‌ سپارد. <verse eid="2CO 5:18" /><verse number="19" style="v" sid="2CO 5:19" />واته‌ خودا جیهانی ئاشت‎كرده‌وه‌ له‌گه‌ڵ خۆی له‌‏مه‌سیحدا، ئیتر له‌سه‌ر گوناه‌ لێیان ناپرسێته‌وه‌و ووشه‌ی ئاشت‎بوونه‌وه‌ی به‌ ئێمه‌ سپاردووه‌. <verse eid="2CO 5:19" /><verse number="20" style="v" sid="2CO 5:20" />كه‌واته‌ ئێمه‌ باڵیۆزی مه‌سیحین، خودا به‌هۆی ئێمه‌ ووتار ده‌دات، له‌به‌ر ئه‌وه‌ له‌جیاتی مه‌سیح داواتان لـێ‌ده‌كه‌ین له‌گه‌ڵ خودا ئاشت‎بنه‌وه‌‏. <verse eid="2CO 5:20" /><verse number="21" style="v" sid="2CO 5:21" />له‌پێناوی ئێمه‌ ئه‌وی كرد به‌گوناه‌ هه‌رچه‌نده‌ گوناهی نه‌ده‌ناسی، تـا له‌ئه‌ودا به‌شداری ڕاست‏ودروستی خودا بكه‌ین.<verse eid="2CO 5:21" /></para>
  <chapter eid="2CO 5" />
  <chapter number="6" style="c" sid="2CO 6" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 6:1" />وه‌ك ئیشكه‌رێك له‌گه‌ڵ خودا داواتان لـێ‌ده‌كه‌ین، به‌ره‌كه‌تی خودا بێ‌ سوود وه‌رمه‌گرن. <verse eid="2CO 6:1" /><verse number="2" style="v" sid="2CO 6:2" />چونكه‌ خودا ده‌ڵێ‌: [[ئه‌و كاته‌ی جێی ڕه‌زامه‌ندیم بوویت، گوێم بۆ گرتویت، له‌ ڕۆژی ڕزگاری یارمه‌تیم ‎دایت.]] جا سه‌یركه‌ ئه‌وه‌تا ئێستایه‌ كاتی ڕه‌زامه‌ندی‏و ئێستایه‌ ڕۆژی ڕزگاری. <verse eid="2CO 6:2" /><verse number="3" style="v" sid="2CO 6:3" />نامانه‌وێ‌ له‌‏هیچ شتێك ببین به‌ كۆسپ له‌ڕێگای كه‌س، بۆ ئه‌وه‌ی ڕه‌خنه‌ له‌‏خزمه‌تمان نه‌گیرێ‌، <verse eid="2CO 6:3" /><verse number="4" style="v" sid="2CO 6:4" />به‌ڵكو وه‌ك خزمه‌تكاری خودا له‌‏هه‌موو شتێك خۆمان ده‌رده‌خه‌ین: به‌ ئارام‏گرتنی مه‌زنمان له‌كاتی ته‌نگانه‌و ناخۆشی‏و لێقه‌ومان، <verse eid="2CO 6:4" /><verse number="5" style="v" sid="2CO 6:5" />‏لـێدان‏و گرتن‎و شڵه‌ژان، ماندوویی‏و شه‌ونوخونی‏و برسێتیدا، <verse eid="2CO 6:5" /><verse number="6" style="v" sid="2CO 6:6" />‏به‌پاكی‎و زانیاریو دان‎به‌خۆگرتن‎و زمان شیرینی، هه‌روه‌ها به‌‏ڕۆحی پیرۆزو خۆشه‌ویستی پاك، <verse eid="2CO 6:6" /><verse number="7" style="v" sid="2CO 6:7" />به‌قسه‌ی ڕاست‏و هێزی خوداو چه‌كه‌كانی ڕاست‏ودروستی بۆ ده‌ستی ڕاست‏و چه‌پ، <verse eid="2CO 6:7" /><verse number="8" style="v" sid="2CO 6:8" />‏له‌ستایش كردنمان‏و سووكایه‌تی پی كردنمان، ناوبانگی باش‏و ناوبانگی خراپ، هه‌ڵخه‌ڵه‌تێنه‌ر له‌كاتێك ڕاستگۆین، ‏ <verse eid="2CO 6:8" /><verse number="9" style="v" sid="2CO 6:9" />‏نه‌ناسراو له‌كاتێك باش ناسراوین، مردوو له‌كاتێك زیندووین، سزادراو له‌كاتێك نه‌كوژراوین، <verse eid="2CO 6:9" /><verse number="10" style="v" sid="2CO 6:10" />‏غه‌مبار له‌كاتێك هه‌رده‌م دڵشادین، هه‌ژار له‌كاتێك زۆر كه‌س ده‌وڵه‌مه‌ند ده‌كه‌ین. وه‌ك یه‌كێك هیچی نه‌بێ‌، هه‌رچه‌نده‌ هه‌موو شتێكمان هه‌یه‌.‏ <verse eid="2CO 6:10" /><verse number="11" style="v" sid="2CO 6:11" />ئه‌ی دانیشتوانی كۆرنسۆس، ده‌ممان كراوه‌یه‌و دڵمان فراوانه‌. <verse eid="2CO 6:11" /><verse number="12" style="v" sid="2CO 6:12" />بێ‌گومان ئێوه‌ شوێنی خۆتان گرتووه‌ له‌‏دڵمان، هه‌رچه‌نده‌ ئێوه‌ ئه‌وه‌نده‌ شوێنتان نییه‌ بۆمان. <verse eid="2CO 6:12" /><verse number="13" style="v" sid="2CO 6:13" />وه‌ك منداڵی خۆم له‌گه‌ڵتان ده‌دوێم، ‏كه‌واته‌ ئێوه‌ش دڵتان بكه‌نه‌وه‌ بۆمان.<verse eid="2CO 6:13" /></para>
  <para style="s1">په‌رستگای خودای زیندوو</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 6:14" />له‌گه‌ڵ بێ‌باوه‌ڕان تێكه‌ڵاو مه‌بن، چونكه‌ ڕاست‎ودروستیو خراپه‌ چ په‌یوه‌ندییه‌كیان به‌‏یه‌كه‌وه‌ هه‌یه‌؟ هه‌روه‌ها ڕووناكی چ هاوبه‌شییه‌كی له‌گه‌ڵ تاریكی هه‌یه‌؟ <verse eid="2CO 6:14" /><verse number="15" style="v" sid="2CO 6:15" />یان چ ته‌باییه‌ك له‌نێوان مه‌سیح‏و به‌لیعال [[[شه‌یتان]]] هه‌یه‌؟ یان چ شتێك هه‌یه‌ باوه‌ڕدارێك به‌ بێ‌باوه‌ڕێكه‌وه‌ ببه‌ستێته‌وه‌؟ <verse eid="2CO 6:15" /><verse number="16" style="v" sid="2CO 6:16" />هه‌روه‌ها په‌رستگای خودا چ ڕێككه‌وتنێكی له‌گه‌ڵ بته‌كان هه‌یه‌؟ ئێمه‌ په‌رستگای زیندووی خوداین، به‌پێی ئه‌وه‌ی خودا ووتویه‌تی: [[له‌نێوانیان نیشته‌جێ‌ ده‌بم‏و له‌گه‌ڵیان ده‌ڕۆم، ‏ده‌مه‌وێ‌ ببم به‌ خودایان‏و ئه‌وانیش ببن به‌ گه‌لـم‏]]، <verse eid="2CO 6:16" /><verse number="17" style="v" sid="2CO 6:17" />[[له‌به‌رئه‌وه‌ له‌ناویان بڕۆنه‌ ده‌ره‌وه‌و به‌جێیان بهێڵن، چی گڵاوه‌ ده‌ستی بۆ مه‌به‌ن، خوداوه‌ند ده‌ڵێ، ئینجا به‌خێرهاتنتان ده‌كه‌م]]‏و <verse eid="2CO 6:17" /><verse number="18" style="v" sid="2CO 6:18" />‏[[ده‌بم به‌ باوكتان، ئه‌وسا ئێوه‌ش ده‌بن به‌ كوڕو كچم، ئه‌مه‌ ‏خوداوه‌ندی توانادار ده‌یڵێ‌.]]<verse eid="2CO 6:18" /></para>
  <chapter eid="2CO 6" />
  <chapter number="7" style="c" sid="2CO 7" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 7:1" />ئه‌ی خۆشه‌ویستان، له‌به‌رئه‌وه‌ی ئێمه‌ ئه‌م به‌ڵێنه‌مان هه‌یه‌، باخۆمان پاك بكه‌ینه‌وه‌ له‌هه‌موو گڵاویه‌كی له‌ش‏و ڕۆح، له‌ترسی خودا با پاك‎وپیرۆزی ته‌واو به‌ده‌ست بهێنین.<verse eid="2CO 7:1" /></para>
  <para style="s1">تۆبه‌كردن به‌هۆی غه‌مباری</para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 7:2" />دڵتان بكه‌نه‌وه‌ بۆمان. هه‌ڵه‌مان له‌گه‌ڵ كه‌ستان نه‌كردووه‌، ڕه‌وشتی كه‌سمان تێك نه‌داوه‌ له‌‏ئێوه‌، هه‌روه‌ها كه‌سمان له‌ئێوه‌ نه‌خڵه‌تاندووه‌. <verse eid="2CO 7:2" /><verse number="3" style="v" sid="2CO 7:3" />ئیتر ئه‌مه‌ ناڵێم تا گله‌ییتان لـێ‌بكه‌م، چونكه‌ له‌‏پێشا پێم ووتون ئێوه‌ له‌دڵمان‏دان به‌ شێوه‌یه‌ك ئاماده‌ین له‌گه‌ڵتان بمرین‏و بژین. <verse eid="2CO 7:3" /><verse number="4" style="v" sid="2CO 7:4" />من زۆر پشتتان پێ‌ده‌به‌ستم‏و زۆر شانازیتان پێوه‌ ده‌كه‌م، له‌گه‌ڵ ئه‌و هه‌موو ته‌نگانه‌و ناخۆشیانه‌دا دڵم پڕه‌ له‌‏دڵنه‌وایی‏و خۆشییه‌ك به‌ ده‌م باسی ناكرێ‌.<verse eid="2CO 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 7:5" />ڕاسته‌، له‌وكاته‌ی گه‌یشتووینه‌ مه‌كدۆنیا له‌شمان هیچ نه‌حه‌ساوه‌ته‌وه‌، به‌ڵكو له‌‏هه‌موو لایه‌ك ته‌نگوچه‌ڵه‌مه‌ ڕووی لـێناوین، ئه‌مه‌ش ئه‌و ناكۆكیه‌ی ده‌وروبه‌رمان بوو، ترسی له‌دڵمان زیادكرد. <verse eid="2CO 7:5" /><verse number="6" style="v" sid="2CO 7:6" />به‌ڵام ئه‌و خودایه‌ی دڵنه‌واییكه‌ری ئه‌وانه‌یه‌ كه‌ ووره‌یان به‌رداوه‌، دڵنه‌وایی ئێمه‌ی‏كرد به‌ هاتنی تیتۆس بۆ لامان، <verse eid="2CO 7:6" /><verse number="7" style="v" sid="2CO 7:7" />ئه‌مه‌ش نه‌ك ته‌نها له‌به‌رئه‌وه‌ی تیتۆس بۆ لامان هاتووه‌، به‌ڵكو له‌وه‌ زیاتر دڵمان به‌وه‌ خۆش‎بوو تیتۆس چه‌ند دڵنه‌وایی كراوه‌ له‌لایه‌ن ئێوه‌. ئه‌وسا بۆی گێڕامه‌وه‌ سه‌باره‌ت به‌په‌رۆشیو غه‌مباری ئێوه‌، هه‌روه‌ها دڵگه‌رمیتان بۆ من، لێره‌ ناتوانم ده‌ریبڕم چه‌ند به‌وه‌ دڵشادبووم.<verse eid="2CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 7:8" />هه‌رچه‌نده‌ دڵته‌نگم كردوون به‌و نامه‌یه‌ی بۆم ناردن، له‌گه‌ڵ ئه‌وه‌شدا من ئێستا لێی په‌شیمان نیم، ڕاسته‌ من په‌شیمان بوومه‌وه‌، كاتێ‌ زانیم نامه‌كه‌م بۆ ماوه‌یه‌ك دڵگرانی كردوون، <verse eid="2CO 7:8" /><verse number="9" style="v" sid="2CO 7:9" />به‌ڵام ئێستا دڵشادم، ئه‌و نامه‌یه‌م نووسیووه‌، ئه‌مه‌ش له‌به‌رئه‌وه‌ نییه‌ كه‌وا غه‌مبارم كردوون، به‌ڵكو له‌به‌ر ئه‌وه‌ی غه‌مباریتان بووه‌ هۆی تۆبه‌كردنتان، ‏ئه‌مه‌ش غه‌مێك بوو له‌لایه‌ن خوداوه‌ بوو، تا ئیتر به‌هۆی ئێمه‌وه‌ ئازار نه‌چێژن. <verse eid="2CO 7:9" /><verse number="10" style="v" sid="2CO 7:10" />چونكه‌ ئه‌و غه‌مباریه‌ی له‌‏خوداوه‌یه‌، ده‌بێته‌ هۆی تۆبه‌كردن، ئه‌مه‌ش ڕزگاری تیادایه‌و په‌شیمان‎بوونه‌وه‌ له‌سه‌ری پێویست ناكات، به‌ڵام ئه‌و غه‌مباریه‌ی له‌ جیهانه‌وه‌یه‌ ده‌بێته‌ هۆی مردنمان. <verse eid="2CO 7:10" /><verse number="11" style="v" sid="2CO 7:11" />كه‌واته‌ سه‌یركه‌ن ئه‌و غه‌مباریه‌ی له‌خوداوه‌ هات، چی له‌ئێوه‌ دروست‏كردووه‌، چ په‌رۆشییه‌ك، چ چـالاكـییه‌ك بۆ پاكانه‌كردن له‌خۆتان، چ تـووڕه‌ییـه‌ك، چ تـرسێك، چ ئاره‌زوویه‌كی به‌هێز، چ دڵگه‌رمییه‌ك، چ حه‌زێك بۆ دادپه‌روه‌ری! به‌مانه‌ ئێوه‌ ده‌رتان‎خست له‌و شتانه‌ هه‌مووی بێ‌تاوانن كه‌ ڕوویداوه‌. <verse eid="2CO 7:11" /><verse number="12" style="v" sid="2CO 7:12" />كه‌واته‌ ئه‌م شتانه‌م بۆ نه‌نووسیون له‌پێناوی تاوانبار یاخود تاوان ‎لـێكراو، به‌ڵكو تا ده‌ركه‌وێ‌ له‌به‌رده‌م خودا چ دڵگه‌رمییه‌كتان هه‌یه‌ سه‌باره‌ت به‌ئێمه‌، <verse eid="2CO 7:12" /><verse number="13" style="v" sid="2CO 7:13" />ئه‌مه‌ش بووه‌ هۆی دڵنه‌واییمان.</para>
  <para style="p" vid="2CO 7:13">‏له‌مه‌ش زیاتر دڵخۆش بووین به‌ دڵخۆشی تیتۆس‏، كه‌ چۆن به‌هۆی هه‌مووتان حه‌ساوه‌ته‌وه‌. <verse eid="2CO 7:13" /><verse number="14" style="v" sid="2CO 7:14" />گه‌ر من شانازیم به‌ئێوه‌ كردبێ‌ ئه‌وه‌ پێم شه‌رم نییه‌، هه‌روه‌ك ڕاستی هه‌موو شتێكم بۆ باسكردن، هه‌روه‌ها تیتۆسیش ڕاستی شانازی ئێمه‌ی بۆ ده‌ركه‌وت. <verse eid="2CO 7:14" /><verse number="15" style="v" sid="2CO 7:15" />ئه‌و ئێستا له‌دڵه‌وه‌ زیاتر له‌ جاران ئێوه‌ی خۆش‎ده‌وێ‌، كاتێ‌ ئه‌وه‌ی ده‌كه‌وێته‌وه‌ یاد چۆن ئێوه‌ به‌گوێڕایه‌ڵی‏و ڕێزو ترسه‌وه‌ پێشوازیتان لـێكرد. <verse eid="2CO 7:15" /><verse number="16" style="v" sid="2CO 7:16" />من دڵشادم به‌وه‌ی ده‌توانم له‌‏هه‌موو شتێك به‌ته‌واوی پشتتان پێ‌ببه‌ستم.<verse eid="2CO 7:16" /></para>
  <chapter eid="2CO 7" />
  <chapter number="8" style="c" sid="2CO 8" />
  <para style="s1">به‌خشین به‌دڵفراوانی</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 8:1" />‏ده‌مه‌وێ‌، ئه‌ی برایان، ئێوه‌ش بزانن سه‌باره‌ت به‌و به‌ره‌كه‌ته‌ی خودا كه‌ ده‌ركه‌وتووه‌ بۆ كۆمه‌ڵه‌ باوه‌ڕداره‌كانی مه‌كدۆنیا. <verse eid="2CO 8:1" /><verse number="2" style="v" sid="2CO 8:2" />چونكه‌ له‌تاقیكردنه‌وه‌ی ته‌نگانه‌ی توند خۆشیان لێده‌ڕژاوه‌، هه‌روه‌ها له‌نه‌بوونیه‌كی سه‌خت ده‌وڵه‌مه‌ندیه‌كی به‌دڵفراوانیان لێده‌ڕژا. <verse eid="2CO 8:2" /><verse number="3" style="v" sid="2CO 8:3" />من شایه‌تی ئه‌وه‌ ده‌ده‌م له‌‏خۆیانه‌وه‌ به‌پێی توانای خۆیان به‌ڵكو زیاتر له‌‏توانای خۆیان پاره‌یان داوه‌. <verse eid="2CO 8:3" /><verse number="4" style="v" sid="2CO 8:4" />زۆر به‌گه‌رمی داوایان لـێكردین به‌شداریان په‌سه‌ند بكه‌ین بۆ یارمه‌تیدانی خوشك‏و برا پیرۆزه‌كان. <verse eid="2CO 8:4" /><verse number="5" style="v" sid="2CO 8:5" />به‌مه‌ ئه‌وان زیاتریان كرد له‌وه‌ی چاوه‌ڕێمان ده‌كرد، چونكه‌ یه‌كه‌مجار خۆیان دایه‌ده‌ست خوداوه‌ند ئینجا ئێمه‌ به‌گوێره‌ی خواستی خودا. <verse eid="2CO 8:5" /><verse number="6" style="v" sid="2CO 8:6" />ئیتر داوامان له‌‏تیتۆس كرد ئه‌م به‌ره‌كه‌ته‌ی ده‌ستی پێكردوه‌ لاتان ته‌واوی بكات. <verse eid="2CO 8:6" /><verse number="7" style="v" sid="2CO 8:7" />هه‌روه‌ك ئێستا له‌هه‌موو شتێك زیادتان كردووه‌، له‌باوه‌ڕ، له‌قسه‌كردن، له‌زانین، له‌چالاكی، له‌خۆشه‌ویستیان بۆ ئێمه‌، هه‌وڵ بده‌ن له‌م به‌ره‌كه‌ته‌ش زیاد بكه‌ن.<verse eid="2CO 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 8:8" />‏من نامه‌وێ‌ فه‌رمان ‎به‌سه‌رتان بده‌م، به‌ڵكو تا ڕاستی خۆشه‌ویستیتان ده‌ركه‌وێ‌، ده‌مه‌وێ‌ تاقیتان ‎بكه‌مه‌وه‌ له‌چاو خه‌ڵكیكه‌دا. <verse eid="2CO 8:8" /><verse number="9" style="v" sid="2CO 8:9" />چونكه‌ ده‌زانن به‌ره‌كه‌تی عیسای مه‌سیحی خوداوه‌ند چییه‌، هه‌رچه‌نده‌ ئه‌و ده‌وڵه‌مه‌ند بوو به‌ڵام له‌پێناوی ئێوه‌دا بووه‌ هه‌ژار، هه‌تا ئێوه‌ به‌ هه‌ژاری ئه‌و ده‌وڵه‌مه‌ند بن.<verse eid="2CO 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 8:10" />ئه‌مه‌ ڕای منه‌ له‌و باره‌یه‌وه‌، ئه‌وه‌ش بۆ به‌رژه‌وه‌ندی ئێوه‌یه‌: ئه‌وه‌ی ساڵی ڕابردوو ده‌ستتان پێكرد، ته‌نها به‌كرده‌وه‌ نا به‌ڵكو به‌ خواست. <verse eid="2CO 8:10" /><verse number="11" style="v" sid="2CO 8:11" />‏ئێستا ئه‌م كاره‌ ته‌واو بكه‌ن، به‌و په‌رۆشییه‌ی ده‌ستتان پێ‌كردووه‌، ئه‌وه‌نده‌ بده‌ن له‌ تواناتان‏دایه‌. <verse eid="2CO 8:11" /><verse number="12" style="v" sid="2CO 8:12" />گه‌ر به‌ڕاستی ئاماده‌ییتان هه‌بێ‌، ئه‌وا خودا پێی ڕازی ده‌بێ‌ به‌گوێره‌ی ئه‌وه‌ی هه‌تانه‌ نه‌ك ئه‌وه‌ی نیتانه‌.</para>
  <para style="p" vid="2CO 8:12">‏ <verse eid="2CO 8:12" /><verse number="13" style="v" sid="2CO 8:13" />مه‌به‌ستم ئه‌وه‌ نییه‌ خه‌ڵكی تر ده‌بێ‌ بحه‌سێنه‌وه‌و بارگرانی بۆ ئێوه‌ بێ‌. <verse eid="2CO 8:13" /><verse number="14" style="v" sid="2CO 8:14" />به‌ڵام مه‌به‌ستم له‌ یه‌كسانی ئه‌وه‌یه‌: له‌ داهاتوودا با پڕی ئێوه‌ كه‌م‏وكوڕی ئه‌وان پڕ بكاته‌وه‌و پڕی ئه‌وانیش كه‌م‏وكوڕی ئێوه‌ پڕ بكاته‌وه‌، تاكو یه‌كسان ببێ‌. <verse eid="2CO 8:14" /><verse number="15" style="v" sid="2CO 8:15" />له‌م باره‌یه‌وه‌ كتێبی پیرۆز ده‌ڵێ‌: [[ئه‌وه‌ی زۆری كۆكردۆته‌وه‌‏ زۆر زۆری نییه‌، هه‌روه‌ها ئه‌وه‌ی كه‌می كۆكردۆته‌وه‌ زۆر كه‌می نییه‌.]]<verse eid="2CO 8:15" /></para>
  <para style="s1">ناردنی تیتۆس بۆ كورنسۆس</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 8:16" />من له‌ دڵه‌وه‌ سوپاسی خودا ده‌كه‌م، كه‌وا تیتۆس زۆر به‌په‌رۆشه‌وه‌یه‌ بۆ ئێوه‌و بایه‌ختان پێ‌ده‌دات. <verse eid="2CO 8:16" /><verse number="17" style="v" sid="2CO 8:17" />ئه‌و پێشوازی له‌ داواكاریه‌كه‌ی ئێمه‌ كردو له‌مه‌ش زیاتر یه‌كسه‌ر ئاماده‌بوو بۆ لاتان بێت بێ‌ئه‌وه‌ی من داوای لـێ‌بكه‌م. <verse eid="2CO 8:17" /><verse number="18" style="v" sid="2CO 8:18" />‏له‌گه‌ڵ ئه‌و برایه‌كمان نارد كه‌ ناوبانگی ده‌ركردووه‌ به‌ مزگێنیدانی له‌لای هه‌موو كۆمه‌ڵه‌ باوه‌ڕداره‌كان. <verse eid="2CO 8:18" /><verse number="19" style="v" sid="2CO 8:19" />ته‌نها هه‌ر ئه‌مه‌ نا به‌ڵكو ئه‌و برایه‌ له‌كۆمه‌ڵه‌كانه‌وه‌ هه‌ڵبژێراوه‌ له‌گه‌ڵمان گه‌شت بكات بۆ ئه‌و خزمه‌ته‌ به‌ره‌كه‌تداره‌ی هه‌ڵمان گرتووه‌، بۆ شكۆمه‌ندی خوداوه‌ندو پێشاندانی خواسته‌ باشه‌كه‌مان. <verse eid="2CO 8:19" /><verse number="20" style="v" sid="2CO 8:20" />ئێمه‌ بایه‌خ به‌وه‌ ‎ده‌ده‌ین‏، كه‌س سه‌رزه‌نشتمان نه‌كات له‌سه‌ر شێوه‌ی دابه‌ش‎كردنی ئه‌و به‌خشینه‌ زۆره‌. <verse eid="2CO 8:20" /><verse number="21" style="v" sid="2CO 8:21" />چونكه‌ مه‌به‌ستمان چاكه‌یه‌، نه‌ك ته‌نها له‌به‌رچاوی خوداوه‌ند، به‌ڵكو له‌به‌رچاوی خه‌ڵكیش. <verse eid="2CO 8:21" /><verse number="22" style="v" sid="2CO 8:22" />له‌گه‌ڵ ئه‌و دووانه‌ برایه‌كیترمان نارد، ئه‌ویش زۆر جار تاقیمان‎كردۆته‌وه‌ سه‌یرمان‎كرد ‏له‌ زۆر شت چالاكه‌، ئه‌و ئێستا چالاكتر بووه‌ چونكه‌ زۆر پشتتان پێ‌ده‌به‌ستێ‌. <verse eid="2CO 8:22" /><verse number="23" style="v" sid="2CO 8:23" />تیتۆس هاوڕێ‏و ئیشكه‌ره‌ له‌گه‌ڵم له‌پێناوی به‌رژه‌وه‌ندی ئێوه‌، به‌ڵام ئه‌و دوو برایه‌ی له‌گه‌ڵیان، نێرراوانی كۆمه‌ڵه‌كانن، شكۆمه‌ندی مه‌سیحن. <verse eid="2CO 8:23" /><verse number="24" style="v" sid="2CO 8:24" />كه‌واته‌ له‌به‌رده‌م كۆمه‌ڵه‌كان خۆشه‌ویستی خۆتانیان بۆ ده‌رخه‌ن، تا ڕاستی شانازیمان به‌ئێوه‌ بۆ ئه‌وان ده‌ركه‌وێ‌‏.<verse eid="2CO 8:24" /></para>
  <chapter eid="2CO 8" />
  <chapter number="9" style="c" sid="2CO 9" />
  <para style="s1">به‌خشین به‌‏دڵشادیه‌وه‌‏</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 9:1" />‏من به‌پێویستی نازانم له‌باره‌ی یارمه‌تیدانی خوشك‏و برا پیرۆزه‌كان بۆتان بنووسم، <verse eid="2CO 9:1" /><verse number="2" style="v" sid="2CO 9:2" />چونكه‌ ئاماده‌ییتان ده‌زانم‏و شانازیم پێوه‌ كردووه‌ لای مه‌كدۆنیه‌كان‏و پێم ووتن، ناوچه‌ی ئه‌خائیه‌ له‌ ساڵی ڕابوردووه‌وه‌ ئاماده‌ن، ئه‌م دڵگه‌رمیه‌ی ئێوه‌ بووه‌ هۆی هاندانی زۆربه‌یان. <verse eid="2CO 9:2" /><verse number="3" style="v" sid="2CO 9:3" />من ئه‌و برایانه‌م نارده‌ لاتان، تا وا ده‌رنه‌كه‌وێ‌ شانازیمان له‌و باره‌یه‌وه‌ هه‌روا به‌خۆڕایی بوو بێت، به‌ڵكو ده‌مه‌وێ‌ به‌ته‌واوی ئاماده‌‎بن به‌و شێوه‌یه‌ی باسم‎كردووه‌. <verse eid="2CO 9:3" /><verse number="4" style="v" sid="2CO 9:4" />تا شه‌رمه‌زار نه‌بین به‌رامبه‌ر ئه‌و باوه‌ڕه‌ زۆره‌ی هه‌مانه‌ پێتان، كاتێ‌ هه‌ندێ‌ له‌‏مه‌كدۆنیه‌كان هاتن له‌گه‌ڵمان بۆ لاتان‏و بینیان ئێوه‌ ئاماده‌ نین. <verse eid="2CO 9:4" /><verse number="5" style="v" sid="2CO 9:5" />له‌به‌رئه‌وه‌ به‌پێویستم زانی داوا له‌و برایانه‌ بكه‌م كه‌ پێش من بۆ لاتان دێن، سه‌رپه‌رشتی كۆكردنه‌وه‌ی ئه‌و به‌خشینه‌ بكه‌ن كه‌ به‌ڵێنتان داوه‌ بیده‌ن، تاكو ئاماده‌بێ‌، هیوادارم ئه‌مه‌ش ده‌ربڕینێك بێ‌ له‌ده‌ست‎و دڵفراوانیتان نه‌ك وه‌ك سه‌رانه‌.<verse eid="2CO 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 9:6" />له‌ڕاستیدا ئه‌وه‌ی كه‌م بچێنێ‌، كه‌م دروێنه‌ ده‌كات، هه‌روه‌ها ئه‌وه‌ی زۆر بچێنێ‌، زۆر دروێنه‌ ده‌كات. <verse eid="2CO 9:6" /><verse number="7" style="v" sid="2CO 9:7" />با هه‌ر یه‌كه‌تان ئه‌وه‌نده‌ی خۆی ده‌یه‌وێ‌ بیدا، ئه‌مه‌ش با به‌ ئاره‌زووی خۆی بێ‌ نه‌ك به‌ ناچاری، چونكه‌ ئه‌وه‌ی به‌دڵخۆشیه‌وه‌ ده‌به‌خشی خودا خۆشیده‌وێ‌. <verse eid="2CO 9:7" /><verse number="8" style="v" sid="2CO 9:8" />خوداش ده‌توانێ‌ هه‌موو به‌ره‌كه‌تتان پێ‌ ببه‌خشێ‌ تا پڕی، بۆ ئه‌وه‌ی هه‌موو كاتێك‏و له‌هه‌موو شتێك بــه‌گوێره‌ی پێویستتان هه‌بێ‌ هه‌روه‌ها تـا پێتان ببـه‌خشــێ‌ بـه‌پڕییه‌وه‌ بۆ هه‌موو كردارێكی باش. <verse eid="2CO 9:8" /><verse number="9" style="v" sid="2CO 9:9" />هه‌روه‌ك له‌‏زه‌بوور نووسراوه‌: [[به‌ده‌ست‏و دڵفراوانیه‌وه‌ یارمه‌تی هه‌ژارانیدا، ڕاست‏ودروستیه‌كه‌ی تاهه‌تایه‌ ده‌مێنێته‌وه‌.]] <verse eid="2CO 9:9" /><verse number="10" style="v" sid="2CO 9:10" />جا ئه‌و خودایه‌ی تۆو ده‌دات به‌ جوتیارو نان ده‌به‌خشێ‌ بۆ خۆراك، ‏تۆو به‌ ئێوه‌ش ده‌دات‏و دروێنه‌ی ڕاست‎ودروستیتان زیاد ده‌كات. <verse eid="2CO 9:10" /><verse number="11" style="v" sid="2CO 9:11" />‏له‌‏هه‌موو شتێك ده‌وڵه‌مه‌ند ده‌بن، تا هه‌موو كاتێ‌ دڵفراوانبن، به‌مه‌ش ده‌بینه‌ هۆی ئه‌وه‌ی خه‌ڵكێكی زۆر سوپاسی خودا بكه‌ن. <verse eid="2CO 9:11" /><verse number="12" style="v" sid="2CO 9:12" />هه‌ستانتان به‌م خزمه‌ته‌ پیرۆزه‌ ته‌نها پێویستیه‌كانی برا پیرۆزه‌كان جێ‌به‌جێ‌ ناكات، به‌ڵكو ده‌بێته‌ هۆی ئه‌وه‌ی خه‌ڵكێكی زۆر سوپاسی خودا ‎بكه‌ن. <verse eid="2CO 9:12" /><verse number="13" style="v" sid="2CO 9:13" />به‌تاقیكردنه‌وه‌ی خزمه‌ته‌كه‌تان، ده‌بنه‌ مایه‌ی ستایش‏كردنی خودا به‌هۆی ملكه‌چیتان له‌دان‏پیانان به‌مزگێنی مه‌سیح، هه‌روه‌ها دڵفراوانیتان له‌به‌شداریكردن له‌گه‌ڵ ئه‌وان‏و له‌گه‌ڵ هه‌مووان. <verse eid="2CO 9:13" /><verse number="14" style="v" sid="2CO 9:14" />ئه‌وان نوێژتان بۆ ده‌كه‌ن‏و به‌په‌رۆشن بۆ بینینتان، چونكه‌ به‌ره‌كه‌تی خودا كه‌ له‌سه‌رووی بیری مرۆڤه‌ له‌ ئێوه‌دا ده‌ركه‌وت. <verse eid="2CO 9:14" /><verse number="15" style="v" sid="2CO 9:15" />سوپاس بۆ خودا به‌رامبه‌ر ئه‌و به‌خشینه‌ی كه‌ به‌ده‌م باسی ناكرێ‌.<verse eid="2CO 9:15" /></para>
  <chapter eid="2CO 9" />
  <chapter number="10" style="c" sid="2CO 10" />
  <para style="s1">به‌رگری پۆڵس له‌خزمه‌ته‌كه‌ی</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 10:1" />من پۆڵسم، به‌ڕۆح سووكیو نیانی مه‌سیح داواتان لێ‏ده‌كه‌م، من ساكارم كاتێ‌ ڕووبه‌ڕووم له‌گه‌ڵ ئێوه‌، به‌ڵام زۆر چــاونه‌ترسم سه‌باره‌ت به‌ ئێوه‌ كاتێ‌ لێتان دوورم. <verse eid="2CO 10:1" /><verse number="2" style="v" sid="2CO 10:2" />ناچارم مه‌كه‌ن به‌ڕاستی ڕه‌ق‎بم له‌گه‌ڵتان كاتێ‌ دێم بۆ لاتان، به‌تایبه‌تی لــه‌گه‌ڵ ئه‌وانه‌ی وا بیرده‌كه‌نه‌وه‌ به‌پێی خواستی له‌ش هه‌ڵسوكه‌وت ده‌كه‌م. <verse eid="2CO 10:2" /><verse number="3" style="v" sid="2CO 10:3" />ڕاسته‌ ئێمه‌ مـرۆڤین‏و له‌م جیهانه‌دا ده‌ژین به‌ڵام ئێمه‌ وه‌ك خـه‌ڵكی ئه‌م جیهانه‌ شه‌ڕ ناكه‌ین. <verse eid="2CO 10:3" /><verse number="4" style="v" sid="2CO 10:4" />چونكه‌ ئه‌و چه‌كه‌ی شه‌ڕی پێ‌ ده‌كه‌ین جـیهانی نییه‌، به‌ڵكو چه‌كی خودایه‌، توانای له‌ناوبردنی هه‌موو قه‌ڵایه‌كی پته‌وی هه‌یه‌. <verse eid="2CO 10:4" /><verse number="5" style="v" sid="2CO 10:5" />‏هه‌موو شه‌ڕه‌قسه‌یه‌ك‏و هه‌موو شتێك له‌ناوده‌بین كه‌ خۆی ده‌رده‌خات بۆ به‌رهه‌ڵستی زانیاری خودا، هه‌روه‌ها هه‌موو بیرێكی مرۆڤانه‌ به‌دیـل ده‌گـرین بۆ ملكه‌چی مه‌سیح. <verse eid="2CO 10:5" /><verse number="6" style="v" sid="2CO 10:6" />ئاماده‌ین سزای هـه‌مـوو كارێكی یاخی‏بووانه‌ بده‌ین‏، گه‌ر ئێوه‌ به‌ته‌واوی گوێڕایه‌ڵی خودا ‎بن.<verse eid="2CO 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 10:7" />ڕاستییه‌ك هه‌یه‌ پێویسته‌ چاوی لێ‌نه‌پۆشرێ‌و ڕووبه‌ڕووی بنه‌وه‌. كاتێ‌ یه‌كێك له‌و باوه‌ڕه‌دابێ‌ سه‌ر به‌مه‌سیحه‌، با بێته‌وه‌ یادی ئه‌و چه‌ند سه‌ر به‌‏مه‌سیحه‌، ئێمه‌ش هه‌روه‌ها. <verse eid="2CO 10:7" /><verse number="8" style="v" sid="2CO 10:8" />من شه‌رم ناكه‌م، گه‌ر بێتو تۆزێ‌ زیاتر له‌وه‌ی پێویسته‌ شانازیم به‌و ده‌سه‌ڵاته‌ كردبێ‌ كه‌ خودا داویه‌تی پێمان، ئه‌مه‌ش بۆ بنیادنانتانه‌ نه‌ك بۆ ڕووخاندنتان. <verse eid="2CO 10:8" /><verse number="9" style="v" sid="2CO 10:9" />نامه‌وێ‌ وا ده‌ركه‌وم كه‌ هه‌وڵ ده‌ده‌م به‌ نامه‌كانم بتان‎ترسێنم. <verse eid="2CO 10:9" /><verse number="10" style="v" sid="2CO 10:10" />چونكه‌ هه‌ندێك ده‌ڵێن: (نامه‌‏كانی توندو‏تیژو به‌هێزه‌، به‌ڵام ئاماده‌بوونی خۆی كاریگه‌ر نییه‌و قسه‌كانی به‌تاڵه‌.) <verse eid="2CO 10:10" /><verse number="11" style="v" sid="2CO 10:11" />با ئه‌و كه‌سه‌ی ئه‌مه‌ ده‌ڵێ‌ بزانێ‌، ئه‌و شتانه‌ی له‌‏نامه‌كانم ده‌ینووسم‏و له‌وێ‌ نیم، هه‌مان شت ده‌كه‌م كاتێ‌ خۆم هاتم بۆ ئه‌وێ‌.<verse eid="2CO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 10:12" />ئێمه‌ ناوێرین خۆمان له‌گه‌ڵ ئه‌وانه‌ به‌راورد بكه‌ین یاخود خۆمان بخه‌ینه‌ ڕیزی ئه‌وانه‌ی شانازی به‌خۆیان ده‌كه‌ن‏. كاتێ‌ خۆیان به‌ خۆیان به‌راورد ده‌كه‌ن‏و ده‌پێون، ئیتر هیچ تێناگه‌ن! <verse eid="2CO 10:12" /><verse number="13" style="v" sid="2CO 10:13" />به‌ڵام ئێمه‌ زیاد له‌ئاستی پێویست شانازی به‌خۆمان ناكه‌ین. به‌ڵكو به‌و شێوه‌یه‌ی بگونجێ‌ له‌گه‌ڵ ئه‌و سنووره‌ی خودا بۆی داناوین تا ئه‌و ئاسته‌ی بتوانین بگه‌ینه‌ لاتان. <verse eid="2CO 10:13" /><verse number="14" style="v" sid="2CO 10:14" />ئێمه‌ سنووری خۆمان نابڕین‏و واش داینانێین پێتان نه‌گه‌یشتووین، چونكه‌ ئێمه‌ یه‌كه‌م كه‌س بووین هاتین‏و مزگێنی مه‌سیحمان پێ‌ڕاگه‌یاندن. <verse eid="2CO 10:14" /><verse number="15" style="v" sid="2CO 10:15" />شانازی ناكه‌ین زیاتر له‌‏پێویست به‌ ماندووبوونی خه‌ڵكی، به‌ڵكو هیوادارین باوه‌ڕتان به‌هیز بێ‌و ماوه‌ی كاركردنمان له‌نێوانتان فراوان بێ‌، <verse eid="2CO 10:15" /><verse number="16" style="v" sid="2CO 10:16" />تا مزگێنی بۆ دوورتر له‌ووڵاتانی ئێوه‌ ببه‌ین، نابێ‌ شانازی بكه‌ین به‌و كاره‌ی یه‌كێكی‏تر كردوویه‌تی. <verse eid="2CO 10:16" /><verse number="17" style="v" sid="2CO 10:17" />[[ئه‌وه‌ی ده‌یه‌وێ‌ شانازی بكات، با شانازی به‌‏خوداوه‌ند بكات.]] <verse eid="2CO 10:17" /><verse number="18" style="v" sid="2CO 10:18" />چونكه‌ ئه‌وه‌ی خوداوه‌ند ستایشی بكات په‌سه‌ند كراوه‌‏، نه‌ك ئه‌وه‌ی ستایشی خۆی بكات.<verse eid="2CO 10:18" /></para>
  <chapter eid="2CO 10" />
  <chapter number="11" style="c" sid="2CO 11" />
  <para style="s1">پۆڵس‏و نێرراوه‌ درۆزنه‌كان</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 11:1" />هیوادارم له‌ئاستی هه‌ندێ‌ گێلایه‌تی من ئارام بگرن، هه‌رچه‌نده‌ به‌ڕاستی ئارام ده‌گرن. <verse eid="2CO 11:1" /><verse number="2" style="v" sid="2CO 11:2" />من دڵگه‌رمیه‌كی خودایی دایگرتووم سه‌باره‌ت به‌ ئێوه‌، چونكه‌ نیشانم كردوون بۆ مرۆڤێك كه‌ مه‌سیحه‌و ده‌مه‌وێ‌ پێشكه‌شی ئه‌وتان بكه‌م وه‌ك كچێكی بێگه‌رد كه‌ ته‌نها هی مێرده‌كه‌یه‌تی. <verse eid="2CO 11:2" /><verse number="3" style="v" sid="2CO 11:3" />به‌ڵام ده‌ترسم ئه‌مه‌م بۆ نه‌كرێ‌، هه‌روه‌ك چۆن ماره‌كه‌ توانی حه‌وا له‌ به‌هه‌شت به‌ فێڵ هـه‌ڵخه‌ڵه‌تێنێ‌، هه‌رواش ده‌توانرێ‌ ئێوه‌ له‌ دڵسۆزی‏و پاكی مه‌سیح دووربخرێنه‌وه‌و چه‌واشه‌ بكرێن. <verse eid="2CO 11:3" /><verse number="4" style="v" sid="2CO 11:4" />‏چونكه‌ گه‌ر هه‌ندێ‌ كه‌س هاتنه‌ لاتان‏و عیسایه‌كی تریان ڕاگه‌یاند جگه‌ لــه‌و‏ه‌ی پێمان ڕاگه‌یاندن، یاخود ڕۆحێك وه‌رگرن جگه‌ له‌و ڕۆحه‌ی وه‌رتان‏گــرتووه‌، یان مـزگێنییه‌كی‏تر قبوڵ بكه‌ن جگه‌ له‌وه‌ی قبوڵتان‏كرد، ئه‌وا خۆتانی ده‌ده‌نه‌ ده‌ست به‌وپه‌ڕی ئاماده‌ییه‌وه‌. <verse eid="2CO 11:4" /><verse number="5" style="v" sid="2CO 11:5" />له‌و باوه‌ڕه‌دام من نرخم كه‌متر نییه‌ له‌و نێرراوه‌ ناودارانه‌. <verse eid="2CO 11:5" /><verse number="6" style="v" sid="2CO 11:6" />له‌وانه‌یه‌ لـه‌قـسه‌كـردن ئه‌وه‌نده‌ زمـان‏پاراو نه‌بم، به‌ڵام زانیاریم هــه‌یه‌، له‌ هه‌موو شتێكیش ئه‌وه‌مان بۆتان ڕوونكرده‌وه‌.<verse eid="2CO 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 11:7" />ئایا من گوناهم كردووه‌ كاتێ‌ به‌خۆڕایی ‏مزگێنی خودام بۆ داون‏و خۆم نزم‎كــرده‌وه‌ هــه‌تا ئێوه‌ به‌رزبنه‌وه‌؟ <verse eid="2CO 11:7" /><verse number="8" style="v" sid="2CO 11:8" />من دزیم له‌ كۆمه‌ڵه‌ باوه‌ڕداره‌كانی تر ده‌كرد، كاتێ‌ پاره‌م لێ‌وه‌رگرتن له‌جیاتی ئه‌و خزمه‌ته‌ی بۆ ئێوه‌ی ده‌كه‌م، <verse eid="2CO 11:8" /><verse number="9" style="v" sid="2CO 11:9" />هیچ قورساییه‌كم نه‌خستبووه‌ سه‌ر شانتان‏، له‌كاتی پێویستیم كه‌ له‌ناوتان بووم، چونكه‌ ئه‌و برایانه‌ی له‌‏مه‌كدۆنیاوه‌ هاتبوون پێویستیه‌كانمیان جێ‌به‌جێ‌كرد. به‌م شێوه‌یه‌ سوور بووم له‌سه‌ر ئه‌وه‌ی خۆم بپارێزم له‌وه‌ی قورسایی بخه‌مه‌ سه‌ر شانتان‏و سووریش ده‌بم. <verse eid="2CO 11:9" /><verse number="10" style="v" sid="2CO 11:10" />‏وه‌ك ڕاستی مه‌سیح له‌من دایه‌، هیچ كه‌سێ‌ ناتوانێ‌ له‌ناوچه‌ی ئه‌خائیه‌ ئه‌م شانازیه‌م لـێ‌ بسێنێته‌وه‌. <verse eid="2CO 11:10" /><verse number="11" style="v" sid="2CO 11:11" />به‌ڵام بۆچی‏؟ ئایا چونكه‌ من ئێوه‌م خۆش‎ناوێ‌؟ خودا ده‌زانێ‌ من چه‌ند ئێوه‌م خۆش‎ده‌وێ‌!<verse eid="2CO 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 11:12" />لــه‌گــه‌ڵ ئه‌مــانه‌ش ئه‌وه‌ی ده‌یكـه‌م له‌سه‌ری به‌رده‌وام ده‌بم، هه‌تا بیانوی ئه‌وانه‌ ببڕم كه‌ ده‌یانه‌وێ‌ وا‏ی ده‌ربخه‌ن ئه‌وانیش وه‌كــو ئێمه‌ن سه‌باره‌ت به‌وه‌ی شانازی پێوه‌ ده‌كه‌ن. <verse eid="2CO 11:12" /><verse number="13" style="v" sid="2CO 11:13" />ئه‌وانه‌ نێرراوی درۆزن‎و ئیشكه‌ری فێڵبازن خۆیان لــه‌‏شێوه‌ی نێرراوی مه‌سیح ده‌رده‌خه‌ن. <verse eid="2CO 11:13" /><verse number="14" style="v" sid="2CO 11:14" />جێی سه‌رسوڕمان نییه‌، چونكه‌ شه‌یتان خۆی له‌شێوه‌ی فریشته‌ ده‌رده‌خات. <verse eid="2CO 11:14" /><verse number="15" style="v" sid="2CO 11:15" />كه‌واته‌ شتێكی سه‌یر نییه‌ گه‌ر خزمه‌تكارانی له‌شێوه‌ی خزمه‌تكاری ڕاست‏ودروستی خۆیان ده‌رخه‌ن. دواڕۆژی ئه‌وانه‌ به‌پێی كرداریانه‌.<verse eid="2CO 11:15" /></para>
  <para style="s1">ئازاری پۆڵس له‌خزمه‌تی مه‌سیح</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 11:16" />من جارێكی‏تر دووباره‌ی ده‌كه‌مه‌وه‌، كه‌س من به‌‏نه‌زان دانه‌نێ‌، به‌ڵام گه‌ر بێتو من وا دابنێن، ئه‌وا وه‌ك نه‌زانێك قبوڵم بكه‌ن، تاكو منیش تۆزێ‌ شانازی به‌خۆم بكه‌م. <verse eid="2CO 11:16" /><verse number="17" style="v" sid="2CO 11:17" />ئه‌وه‌ی ئێستا ده‌یڵێم به‌گوێره‌ی خوداوه‌ند نییه‌، به‌ڵكو وه‌ك نه‌زانێك ده‌یڵێم كه‌ به‌باوه‌ڕ شانازی به‌خۆی ده‌كات، <verse eid="2CO 11:17" /><verse number="18" style="v" sid="2CO 11:18" />چۆن زۆر له‌خه‌ڵكی ده‌یانه‌وێ‌ شانازی به‌شتی ئه‌م جیهانه‌ بكه‌ن، منیش ده‌مه‌وێ‌ جارێك ئه‌و شانازیه‌ به‌‏خۆم بكه‌م. <verse eid="2CO 11:18" /><verse number="19" style="v" sid="2CO 11:19" />جا ئێوه‌ به‌دڵشادیه‌وه‌ له‌نه‌زانان قبوڵ ده‌كه‌ن، چونكه‌ خۆتان ئه‌وه‌نده‌ تێگه‌یشتوون! <verse eid="2CO 11:19" /><verse number="20" style="v" sid="2CO 11:20" />چونكه‌ قبوڵ ده‌كه‌ن له‌وانه‌ی ده‌تان‏كه‌ن به‌كۆیله‌ یان نێچیر، یاخود خۆیان به‌گه‌وره‌ داده‌نێن به‌سه‌رتان‏، تاڵانتان ده‌كه‌ن، له‌ده‌م‏و چاوتان ده‌ده‌ن. <verse eid="2CO 11:20" /><verse number="21" style="v" sid="2CO 11:21" />من ئێستا شه‌رمه‌زارم‏، پێویسته‌ بڵێم ئێمه‌ چه‌ند لاواز بووین سه‌باره‌ت به‌م شتانه‌!</para>
  <para style="p" vid="2CO 11:21">به‌ڵام له‌به‌رئه‌وه‌ی من وه‌ك نه‌زانێك ده‌دوێم، هه‌رچیه‌ك ئه‌وان ده‌توانن به‌چاونه‌ترسیه‌وه‌ شانازی پێوه‌ بكه‌ن منیش هه‌روه‌ها ده‌توانم. <verse eid="2CO 11:21" /><verse number="22" style="v" sid="2CO 11:22" />گه‌ر بێتو ئه‌وان عیبرانی بن؟ منیش هه‌روه‌ها. یان ئیسرائیلی؟ منیش هه‌روه‌ها. یاخود له‌نه‌وه‌ی ئیبراهیم؟ منیش هه‌روه‌ها. <verse eid="2CO 11:22" /><verse number="23" style="v" sid="2CO 11:23" />‏یان خزمه‌تكاری مه‌سیح؟ من له‌وان زیاتر (وه‌ك شێتێك قسه‌ده‌كه‌م.) زۆر زیاتر ماندووبووم، به‌ندیخانه‌م زیاتر چێشتووه‌، زۆر زیاتر داركاری كراوم، چه‌ندین جار مردنم به‌چاو بینیوه‌. <verse eid="2CO 11:23" /><verse number="24" style="v" sid="2CO 11:24" />جووله‌كه‌كان به‌قامچی پێنج جار سیو نۆ قامچیان لـێداوم، <verse eid="2CO 11:24" /><verse number="25" style="v" sid="2CO 11:25" />هه‌روه‌ها سێ‌ جار داركاریكراوم، جارێك خه‌ڵك به‌ردبارنیان كردووم، سێ‌ جار له‌‏كه‌شتیدا بووم‏و‏ شكاوه‌، جارێكیان شه‌و و ڕۆژێكی ته‌واو له‌ناو ئاوی ده‌ریا ماومه‌وه‌. <verse eid="2CO 11:25" /><verse number="26" style="v" sid="2CO 11:26" />به‌هوێ‌ گه‌شتی زۆرم هه‌میشه‌ كه‌وتوومه‌ مه‌ترسی ڕووبارو مه‌ترسی دزو جه‌رده‌، هه‌روه‌ها مه‌ترسی گه‌له‌كه‌م‏و مه‌ترسی میلله‌تان، مه‌ترسی له‌شاره‌كان‏و مه‌ترسی له‌ده‌شت‏و مه‌ترسی له‌‏ده‌ریا‏و مه‌ترسی برایانی درۆزن. <verse eid="2CO 11:26" /><verse number="27" style="v" sid="2CO 11:27" />زۆر تووشی زه‌حه‌مه‌تی‏و ماندوویی‏و شه‌ونخونی زۆر‏، برسێتی‎و تینوێتی‏و ڕۆژوگرتنی زۆر، سه‌رماو ڕووتی بووم. <verse eid="2CO 11:27" /><verse number="28" style="v" sid="2CO 11:28" />ئه‌مانه‌ش هه‌موو له‌لایه‌ك، ڕۆژ له‌‏دوای ڕۆژ ده‌بێ‌ زیاتر خه‌می هه‌موو كۆمه‌ڵه‌ باوه‌ڕداره‌كان بخۆم. <verse eid="2CO 11:28" /><verse number="29" style="v" sid="2CO 11:29" />جا كێ‌ هه‌یه‌ لاواز بێ‏و من له‌گه‌ڵی لاواز نه‌بم؟ یاخود كێ‌ هه‌یه‌ بكه‌وێته‌ گوناه‌و من له‌خه‌فه‌تا بۆی نه‌سووتێم؟<verse eid="2CO 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2CO 11:30" />گه‌ر بێتو شانازی به‌‏خۆم بكه‌م‏، ئه‌وا شانازی به‌ده‌رخستنی لاوازیم ده‌كه‌م‏. <verse eid="2CO 11:30" /><verse number="31" style="v" sid="2CO 11:31" />خودای باوكی عیسای خوداوه‌ندمان ده‌زانێ‌ درۆ ناكه‌م ئه‌وه‌ی تاهه‌تایه‌ پیرۆزه‌، <verse eid="2CO 11:31" /><verse number="32" style="v" sid="2CO 11:32" />ئه‌و پارێزگاره‌ی له‌لایه‌ن هارتسی پادشاوه‌ بۆ شاری دیمه‌شق دانرابوو‏، چاودێرییه‌كی زۆری خستبووه‌ سه‌ر شاری دیمه‌شق بۆ گرتنم، <verse eid="2CO 11:32" /><verse number="33" style="v" sid="2CO 11:33" />به‌ڵام منیان ‎خسته‌ ناو سه‌به‌ته‌و له‌په‌نجه‌ره‌ی شووره‌ی چوار ده‌وری شاره‌كه‌ منیان شۆڕكرده‌ خواره‌وه‌، ئیتر به‌و شێوه‌یه‌ ڕزگارم بوو له‌ده‌ستی.<verse eid="2CO 11:33" /></para>
  <chapter eid="2CO 11" />
  <chapter number="12" style="c" sid="2CO 12" />
  <para style="s1">بینینی پۆڵس‏و دڕكی له‌ش</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 12:1" />پێویسته‌ شانازی بكه‌م، هه‌رچه‌نده‌ هیچ سوودی نییه‌، به‌رده‌وام ده‌بم له‌سه‌ر بینین‏و ئه‌و شتانه‌ی خوداوه‌ند بۆم ئاشكرا ده‌كات. <verse eid="2CO 12:1" /><verse number="2" style="v" sid="2CO 12:2" />من پیاوێك ده‌ناسم له‌مه‌سیحدا بوو، پێش چوارده‌ ساڵ فڕاندیان بۆ سێهه‌م ته‌به‌قه‌ی ئاسمان. ئایا به‌ له‌شه‌وه‌ بوو یاخود بێ‌ له‌ش؟ نازانم! ‏خودا ده‌زانێ‌. <verse eid="2CO 12:2" /><verse number="3" style="v" sid="2CO 12:3" />هه‌روه‌ها ده‌زانم ئه‌و پیاوه‌ بۆ به‌هه‌شــت فــڕێندرا، به‌له‌شه‌وه‌ بوو یاخــود بێ‌ لــه‌ش؟ نازانم! خـودا ده‌زانێ‌. <verse eid="2CO 12:3" /><verse number="4" style="v" sid="2CO 12:4" />‏له‌وێ‌ گوێی له‌ قسه‌یه‌ك بوو مرۆڤ نابی بیڵێ‌و ناتوانێ‌ باسی بكات. <verse eid="2CO 12:4" /><verse number="5" style="v" sid="2CO 12:5" />ســـه‌باره‌ت به‌و پیـاوه‌ شــانازی ده‌كه‌م، به‌ڵام سه‌باره‌ت به‌خۆم شانازی ناكه‌م، ته‌نها به‌ لاوازیه‌كانم شانازی ده‌كه‌م. <verse eid="2CO 12:5" /><verse number="6" style="v" sid="2CO 12:6" />گه‌ر بێتو بمه‌وێ‌ شانازی به‌ خۆمه‌وه‌ بكه‌م، بێ‌ مێشكی نییه‌، چونكه‌ من ڕاستی ده‌ڵێم، به‌ڵام من ده‌ترسم له‌وه‌ی یه‌كێك وا له‌ من بگات زیاتر له‌وه‌ی ده‌یبینن‏و لێم ‎ده‌بیستن. <verse eid="2CO 12:6" /><verse number="7" style="v" sid="2CO 12:7" />تا لووت‎به‌رز نه‌بم به‌و شته‌ گــه‌ورانه‌ی خودا بۆی ئاشكرا كردووم، دڕكێكم لێدرا له‌له‌شم، وه‌ك له‌نێرراوی شه‌یتان بێت، تا ئازارم بداو خۆم هه‌ڵنه‌كێشم. <verse eid="2CO 12:7" /><verse number="8" style="v" sid="2CO 12:8" />بۆ ئه‌م مه‌به‌سته‌ سێ‌ جار له‌خودا پاڕامــه‌وه‌ ئه‌وه‌م لــه‌‏كۆڵ بكـاته‌وه‌، <verse eid="2CO 12:8" /><verse number="9" style="v" sid="2CO 12:9" />به‌ڵام خــودا پێی ووتم: (به‌ره‌كـه‌تی منت به‌سه‌، چونكــه‌ توانای من له‌لاوازی ته‌واو ده‌بێ‌.) له‌به‌ر ئه‌وه‌ به‌دڵشادیه‌وه‌ شانازی به‌ لاوازی خۆم ده‌كه‌م، هــه‌تا توانای مــه‌سیح بێته‌ سه‌رم، <verse eid="2CO 12:9" /><verse number="10" style="v" sid="2CO 12:10" />جا له‌پێناوی مـه‌سیح، ڕازی ده‌بم به‌رگه‌ی لاوازیو سووكایه‌تی‏و ناخۆشیو چــه‌وسانه‌وه‌و ماڵوێرانی بگــرم، چــونكه‌ هــه‌ر كاتێ‌ لاوازبم به‌هێز ده‌بم.<verse eid="2CO 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 12:11" />ناچارتان ‎كردم وه‌ك شێتم لـێ‌ بێت! چونكه‌ كه‌متر نیم له‌‏نێرراوه‌ ناوداره‌كان، هــه‌رچه‌نده‌ هیچ نیم، له‌گه‌ڵ ئه‌وه‌شدا پێویست بوو له‌سه‌رتان ستایشم بكه‌ن. <verse eid="2CO 12:11" /><verse number="12" style="v" sid="2CO 12:12" />ئه‌و نیشانانه‌ی نێرراو ده‌رده‌خات، به‌وپه‌ڕی ئارام‏گرتنه‌وه‌ له‌نێوانتان ئه‌نجامــم داوه‌، به‌هۆی نیشانه‌و كاری سه‌رسوڕهێنه‌رو كرداره‌وه‌. <verse eid="2CO 12:12" /><verse number="13" style="v" sid="2CO 12:13" />ئایا ئێوه‌م به‌كه‌متر زانیوه‌ له‌كۆمه‌ڵه‌ باوه‌ڕداره‌كانی تر، جگه‌ له‌وه‌ش بارگرانیم نه‌بووه‌ بۆ ئێوه‌؟ گه‌ر وایه‌ له‌م هه‌ڵه‌یه‌م ببورن!<verse eid="2CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 12:14" />ئێستا ئاماده‌م بۆ سێهه‌م جار بۆ لاتان بێم، هه‌روه‌ها نابمه‌ بارگرانی به‌ســه‌رتان، چونكـه‌ خــۆتانم ده‌وێ‌ نه‌ك پاره‌تان. لـه‌به‌رئه‌وه‌ی ‏ڕۆڵه‌ پاره‌ بۆ دایك‏و باوك كــۆناكـه‌نه‌وه‌، به‌ڵكو له‌سه‌ر دایك‏و باوكــه‌ بۆ ڕۆڵه‌كانیان ئه‌وه‌ بكه‌ن. <verse eid="2CO 12:14" /><verse number="15" style="v" sid="2CO 12:15" />به‌ دڵشادیه‌وه‌ پاره‌و هه‌رچیه‌كم هه‌یه‌ خه‌رجـی ده‌كه‌م له‌پێناوی ئێوه‌. ‏گه‌ر ئێوه‌م زۆرتر خۆشه‌ویست، ئایا كه‌متر منتان خۆش ده‌وێ؟ <verse eid="2CO 12:15" /><verse number="16" style="v" sid="2CO 12:16" />به‌ڵام با وابێ‌ من بارگرانیم نه‌بووه‌ بۆ ئێوه‌. ئێوه‌ ده‌ڵێن: من كابرایه‌كی فێڵبازم‏و به‌ فێڵ ده‌ستم به‌سه‌رتان‏دا گرتووه‌. <verse eid="2CO 12:16" /><verse number="17" style="v" sid="2CO 12:17" />ئایا به‌هۆی ئه‌وانه‌ی ناردوومه‌ بۆ لاتان فێڵم لێ‌ كردوون؟ <verse eid="2CO 12:17" /><verse number="18" style="v" sid="2CO 12:18" />كاتێ‌ له‌سه‌ر داواكاری من تیتۆس له‌گه‌ڵ یه‌كێك له‌‏برایان هات بۆ لاتان، ئایا تیتۆس فێڵی لێكردوون؟ ئایا ئێمه‌ به‌ هه‌مان ڕۆح كار ناكه‌ین، به‌هه‌مان ڕێگادا ناڕۆین؟<verse eid="2CO 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2CO 12:19" />ئایا ئێوه‌ له‌و باوه‌ڕه‌دان، ئێمه‌ ئه‌م هه‌موو شته‌ی ده‌یڵێین بۆ به‌رگریكردنه‌ له‌ خۆمان؟ به‌ڵام ئه‌ی خۆشه‌ویستان ئێمه‌ له‌به‌رده‌م خودا له‌مه‌سیحدا ده‌دوێن‏و هه‌مووی بۆ بنیادنانتانه‌. <verse eid="2CO 12:19" /><verse number="20" style="v" sid="2CO 12:20" />من ده‌ترسم كاتێ‌ بێم بۆ لاتان، به‌ شێوه‌یه‌ك بتانبینم كه‌ نامه‌وێ‌، ئێوه‌ش به‌ شێوه‌یه‌ك من ببینن ‎كه‌ نه‌تانه‌وێ‌. به‌واتای له‌ نێوانتان ناكۆكی، چاوپیسی، توڕه‌یی، خۆویستی، بوختان، قسه‌ هێنان‏و بردن، له‌خۆبایی، به‌ڕه‌ڵڵایی هه‌بێ. <verse eid="2CO 12:20" /><verse number="21" style="v" sid="2CO 12:21" />من ده‌ترسم كاتێ‌ بێم بۆ لاتان خودا نزمم بكات له‌نێوانتان، به‌وه‌ی زۆر خه‌فه‌ت بخۆم بۆ ئه‌و كه‌سانه‌ی له‌پێشا گوناه‌و هه‌ڵه‌یان ‎كردووه‌، كه‌چی تۆبه‌یان نه‌كردووه‌ له‌وه‌ی كردوویانه‌ له‌ گڵاویو داوێن پیسی‏و به‌دڕه‌وشتی.<verse eid="2CO 12:21" /></para>
  <chapter eid="2CO 12" />
  <chapter number="13" style="c" sid="2CO 13" />
  <para style="s1">خۆتان تاقیبكه‌نه‌وه‌‏</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 13:1" />ئه‌مه‌ سێهه‌م جاره‌ دێم بۆ لاتان، [[‏هه‌ر مــه‌سه‌له‌یه‌ك پێویـسته‌ به‌شایه‌تی دووان یان سـیان بچه‌ســپێ‌.]] <verse eid="2CO 13:1" /><verse number="2" style="v" sid="2CO 13:2" />جاری پێشوو كـه‌ لاتان بووم ئێوه‌م ئاگـاداركـرده‌وه‌، ئێستاش جارێكی‏تر له‌م نامه‌یه‌ ئه‌وانه‌ی جـاران گــوناهیان كردووه‌ له‌گه‌ڵ هــه‌مــوو ئه‌وانی‏تر ئاگاداریان ده‌كــه‌مـه‌وه‌‏و پێیان ڕاده‌گه‌یه‌نم گه‌ر هــاتوو جــارێكی‏تر ‏بۆ لاتان بێم به‌زه‌ییم به‌ كـه‌س نایه‌ته‌وه‌، <verse eid="2CO 13:2" /><verse number="3" style="v" sid="2CO 13:3" />چــونكــه‌ ئێوه‌ داوای به‌ڵگه‌ له‌‏من ده‌كه‌ن كه‌وا عیسا به‌هۆی مــن ده‌دوێ‌ لــه‌گه‌ڵتان. ئه‌و سه‌باره‌ت به‌ ئێوه‌ لاواز نییه‌، به‌ڵكــو به‌توانــایه‌ لــه‌ناوتان. <verse eid="2CO 13:3" /><verse number="4" style="v" sid="2CO 13:4" />ڕاسته‌ عیسا له‌لاوازی له‌خاچدرا، به‌ڵام ئێستا زیندووه‌ به‌هۆی توانای خوداوه‌، چونكه‌ ئێمه‌ لاوازین لــه‌ئه‌ودا، به‌ڵام لــه‌لایه‌ن ئێو ئێمه‌ پێویسته‌ لــه‌ئه‌ودا بژین به‌هێزو توانای خودا. <verse eid="2CO 13:4" /><verse number="5" style="v" sid="2CO 13:5" />جــا خــۆتان تاقــیبكه‌نه‌وه‌و سه‌یری خۆتان بكه‌ن بزانن به‌ باوه‌ڕ ده‌ژیـن! له‌خــۆتان بكــۆڵنه‌وه‌، ئایا نازانن عیسای مــه‌سیح لـه‌ناوتان‏دایه‌؟ گــه‌ر ئه‌مه‌ نه‌زانن ئه‌وا ئێوه‌ سه‌رنه‌كـه‌وتوون لــه‌تاقیكردنه‌وه‌. <verse eid="2CO 13:5" /><verse number="6" style="v" sid="2CO 13:6" />به‌ڵام هــیوادارم، بزانن ئێمه‌ له‌و تاقـــیكـردنه‌وه‌یه‌ ده‌رچـووین. <verse eid="2CO 13:6" /><verse number="7" style="v" sid="2CO 13:7" />ئێمه‌ نوێژ ده‌كـــه‌ین بۆ خودا تا یارمــه‌تیتان بدات‏و هــه‌ڵه‌ نه‌كـه‌ن، ئه‌مه‌ش لــه‌به‌رئه‌وه‌ نییه‌ تا ده‌ركــه‌وێ‌ ئێمه‌ مرۆڤی چاكین، به‌ڵكو ته‌نهــا بۆ ئـه‌وه‌یه‌ ئێوه‌ چی چاك‏و ڕاسـته‌ بیـكه‌ن، هــه‌رچـه‌نده‌ خه‌ڵكی به‌ ســه‌رنه‌كـه‌وتوومان دابنێن. <verse eid="2CO 13:7" /><verse number="8" style="v" sid="2CO 13:8" />چونكه‌ ناتوانین هــیچ شــتێ‌ بكه‌ین دژی ڕاستی، به‌ڵكو ده‌مـانه‌وێ‌ خزمه‌تی بكـه‌ین. <verse eid="2CO 13:8" /><verse number="9" style="v" sid="2CO 13:9" />ئه‌وسـا چـه‌ند دڵشاد ده‌بین گــه‌ر لـه‌ بێ‌ هــێزی ئێمـه‌ ئێوه‌ به‌هێز بن، نـوێژی ئێمــه‌ش بۆ تـه‌واوی ئـێوه‌یـه‌. <verse eid="2CO 13:9" /><verse number="10" style="v" sid="2CO 13:10" />وا پێــش ئــه‌وه‌ی بۆ لاتان بێم هــه‌مــوو شتێكم بۆ نووسین، هه‌تا كــاتێ‌ هــاتم بۆ لاتان ناچار نه‌بم به‌ ڕه‌قی له‌گه‌ڵتان بجوڵێمه‌وه‌، چـونكه‌ خــوداوه‌ند ده‌ســه‌ڵاتی داوه‌ پێم تا بنیادتان بكـــه‌م نه‌ك هــه‌ڵــتان‏بوه‌شێنم.<verse eid="2CO 13:10" /></para>
  <para style="s1">هاندان‏و سڵاوی كۆتایی</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 13:11" />لـه‌كـۆتاییدا ئه‌ی برایان، خواحافیز، بۆ ته‌واوی هه‌وڵ‏بده‌ن، ئاگاتان لـه‌داواكاریه‌كانم بێ‌، ڕێك بكه‌ون، له‌گه‌ڵ یه‌كتری به‌‏ئاشتی بژین، ئه‌وسا خودای ئاشتی‏و خۆشه‌ویستی لـه‌گــه‌ڵتان ده‌بێ‌. <verse eid="2CO 13:11" /><verse number="12" style="v" sid="2CO 13:12" />به‌مــاچی پیرۆز سڵاو له‌یه‌كتری بكه‌ن. <verse eid="2CO 13:12" /><verse number="13" style="v" sid="2CO 13:13" />هه‌موو خوشــك‏و برا پیرۆزه‌كــانی ئێره‌ سڵاوتان لـێ‌ ده‌كه‌ن.<verse eid="2CO 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 13:14" />بابه‌ره‌كه‌تی عیسای مه‌سیحی خوداوه‌ندمان‏و خۆشه‌ویستی خوداو به‌شــداری ڕۆحی پیرۆز له‌گه‌ڵ هه‌مــووتان بێ‌.<verse eid="2CO 13:14" /></para>
  <chapter eid="2CO 13" />
</usx>