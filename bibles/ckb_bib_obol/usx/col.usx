<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="COL" style="id">- Biblica® Open Sorani Kurdish Book of Life</book>
  <para style="rem">‪Copyright © 1998 by Biblica, Inc.</para>
  <para style="h">کۆلۆسی</para>
  <para style="toc1">نامه‌ی پۆڵس بۆ باوه‌ڕدارانی كۆلۆسی</para>
  <para style="toc2">کۆلۆسی</para>
  <para style="toc3">کۆلۆسی</para>
  <para style="mt1">نامه‌ی پۆڵس بۆ باوه‌ڕدارانی كۆلۆسی</para>
  <chapter number="1" style="c" sid="COL 1" />
  <para style="p">
    <verse number="1" style="v" sid="COL 1:1" />له‌پۆڵس نێرراوی عیسای مه‌سیح له‌سه‌ر خواستی خودا، هه‌روه‌ها له‌‏تیمۆساوسی برامانه‌وه‌، <verse eid="COL 1:1" /><verse number="2" style="v" sid="COL 1:2" />بۆ خوشك‏و برایانی پیرۆزو سه‌رڕاست له‌‏شاری كۆلۆسی، با به‌ره‌كه‌ت‏و ئاشتی خودای باوكتان له‌گه‌ڵ بێ‌.<verse eid="COL 1:2" /></para>
  <para style="s1">سوپاس‏و نوێژكردن</para>
  <para style="p">
    <verse number="3" style="v" sid="COL 1:3" />ئێمه‌ هه‌ر كاتێك نوێژ ده‌كه‌ین بۆتان، هه‌میشه‌ سوپاسی خودای باوكی عیسای مه‌سیحی خوداوه‌ندمان ده‌كه‌ین، <verse eid="COL 1:3" /><verse number="4" style="v" sid="COL 1:4" />چونكه‌ هه‌واڵی باوه‌ڕتان به‌ عیسای مه‌سیح پێمان گه‌یشت له‌گه‌ڵ ئه‌و خۆشه‌ویستیه‌ی هه‌تانه‌ به‌رامبه‌ر هه‌موو خوشك‏و برایانی پیرۆز، <verse eid="COL 1:4" /><verse number="5" style="v" sid="COL 1:5" />له‌پێناوی ئه‌و هیوایه‌ی خودا ئاماده‌یكردووه‌ بۆتان له‌‏ئاسمان، ئه‌و هیوایه‌ی له‌پێشا له‌ووشه‌ی ڕاستیتان بیست، واته‌ مزگێنی. <verse eid="COL 1:5" /><verse number="6" style="v" sid="COL 1:6" />ئه‌و مزگێنییه‌ی به‌رهه‌م ده‌هێنێت‏و بڵاوده‌بێته‌وه‌ له‌هه‌موو جیهان، هه‌روه‌ك چۆن به‌رهه‌می هێناو بڵاوبووه‌وه‌ له‌‏نێواتان له‌و ڕۆژه‌ی به‌ڕاستی به‌ره‌كه‌تی خوداتان بیستووه‌‏و ناسیووتانه‌. <verse eid="COL 1:6" /><verse number="7" style="v" sid="COL 1:7" />هه‌روه‌ك له‌ئه‌پفراسی به‌نده‌ی هاوڕێی خۆشه‌ویست فێربوون، ئه‌و خزمه‌تكارێكی سه‌رڕاستی مه‌سیحه‌ له‌پێناوی ئێمه‌. <verse eid="COL 1:7" /><verse number="8" style="v" sid="COL 1:8" />هه‌ر ئه‌ویش بوو بۆی باس‏كردین سه‌باره‌ت به‌و خۆشه‌ویستیه‌ی ڕۆح پێی به‌خشیون. <verse eid="COL 1:8" /><verse number="9" style="v" sid="COL 1:9" />له‌به‌ر ئه‌وه‌ له‌و ڕۆژه‌وه‌ی ئه‌مه‌مان بیستووه‌، بێ‌ڕاوه‌ستان نوێژتان بۆ ده‌كه‌ین، داوا له‌خودا ده‌كه‌ین داناییو تێگه‌یشتنی ڕۆحیتان بداتێ‌، تا خواستی ئه‌و به‌ته‌واوی بزانن. <verse eid="COL 1:9" /><verse number="10" style="v" sid="COL 1:10" />هه‌تا به‌شێوه‌یه‌ك هه‌ڵسوكه‌وت بكه‌ن له‌ژیان شایانی خوداوه‌ند بێت‏و به‌ته‌واوی جێگای ڕه‌زامه‌ندی ئه‌و بێت، بۆ ئه‌وه‌ی به‌رهه‌م‎بهێنن له‌‏هه‌موو كارێكی چاك‏و پێ‌بگه‌ن له‌ناسینی خودا، <verse eid="COL 1:10" /><verse number="11" style="v" sid="COL 1:11" />هه‌روه‌ها بۆ ئه‌وه‌ی به‌هێزتان بكات به‌هه‌موو هێزێك به‌گوێره‌ی توانای شكۆداری خۆی، تا خۆتان ڕاگرن له‌ئاست هه‌موو شتێك‏و ئارام بگرن‏، به‌‏خۆشیه‌وه‌ <verse eid="COL 1:11" /><verse number="12" style="v" sid="COL 1:12" />‏سوپاسی باوك بكه‌ن، ئه‌وه‌ی ئێوه‌ی ئاماده‌‏كردووه‌ بۆ به‌شداریكردنی میراتی خوشك‏و برایانی پیرۆز له‌ڕووناكی. <verse eid="COL 1:12" /><verse number="13" style="v" sid="COL 1:13" />هه‌ر ئه‌وه‌ ئێمه‌ی ڕزگاركردووه‌ له‌‏ده‌سه‌ڵاتی تاریكی‏و ئێمه‌ی گواسته‌وه‌ بۆ پادشاهێتی ڕۆڵه‌ی خۆشه‌ویستی. <verse eid="COL 1:13" /><verse number="14" style="v" sid="COL 1:14" />ئه‌وه‌ی به‌خوێنی خۆی ئێمه‌ی كڕیه‌وه‌ له‌كۆیله‌یه‌تی گوناه‌، ئه‌ویش به‌ لـێخۆش‎بوونی ‏گوناه‌.<verse eid="COL 1:14" /></para>
  <para style="s1">عیسا وێنه‌ی خودای نه‌بینراوه‌</para>
  <para style="p">
    <verse number="15" style="v" sid="COL 1:15" />عیسا وێنه‌ی خودای نه‌بینراوه‌، نۆبه‌ره‌ی هه‌موو بوونه‌وه‌رانه‌. <verse eid="COL 1:15" /><verse number="16" style="v" sid="COL 1:16" />هه‌ر به‌ویش هه‌موو شتێك دروست بووه‌‏، ئه‌وه‌ی له‌‏ئاسمان‏و له‌سه‌ر زه‌وییه‌، ئه‌وه‌ی ده‌بینرێ‌و نابینرێ‌، خاوه‌ن ته‌خت‏و تاج یان سه‌رۆك‏و ده‌سه‌ڵاتدار، خودا هه‌مووی به‌‏عیساو بۆ عیسا دروست‎كرد. <verse eid="COL 1:16" /><verse number="17" style="v" sid="COL 1:17" />ئه‌و پێش هه‌موو شتێك بووه‌و هه‌ر له‌ئه‌ویشدا هه‌موو شتێك ده‌بێت. <verse eid="COL 1:17" /><verse number="18" style="v" sid="COL 1:18" />ئه‌و سه‌ری له‌شه‌، واته‌ سه‌ری كۆمه‌ڵه‌ی باوه‌ڕداران، سه‌ره‌تاو نۆبه‌ره‌ی زیندووبوونه‌وه‌ی دوای مردنه‌، تا له‌‏سه‌رووی هه‌موو شتێك بێت. <verse eid="COL 1:18" /><verse number="19" style="v" sid="COL 1:19" />چونكه‌ خودا حه‌زی كرد به‌هه‌موو پڕی خۆی له‌ئه‌ودا به‌رجه‌سته‌ بێ. <verse eid="COL 1:19" /><verse number="20" style="v" sid="COL 1:20" />تا به‌هۆی ئه‌و ئاشت‏بێته‌وه‌ له‌گه‌ڵ هه‌موو ئه‌وانه‌ی له‌سه‌ر زه‌ویو له‌‏ئاسماندایه‌، به‌ خوێن‎ڕشتنی ئه‌ویش له‌سه‌ر خاچ ئاشتی هاته‌دی.<verse eid="COL 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 1:21" />ئێوه‌ جاران به‌هۆی كرداری خراپتان نامۆ و دوژمن بوون له‌بیركردنه‌وه‌، <verse eid="COL 1:21" /><verse number="22" style="v" sid="COL 1:22" />به‌ڵام ئێستا ‏ئاشتیكردنه‌وه‌ ‏به‌مردنی، به‌له‌شی مرۆڤانه‌ی خۆی، تا ئێوه‌ به‌ پاك‎وپیرۆزی‏و بێ‌ كه‌م‏و‏كوڕی‏و بێ‌گله‌یی بێنه‌ به‌رده‌می. <verse eid="COL 1:22" /><verse number="23" style="v" sid="COL 1:23" />به‌مه‌رجێك به‌رده‌وام‏بن له‌سه‌ر باوه‌ڕتان، باوه‌ڕێكی چه‌سپاو و ڕه‌گ داكوتراوتان هه‌بێ‌، لانه‌ده‌ن له‌هیوای ئه‌و مزگێنییه‌ی بیستتان‏و هه‌موو بوونه‌وه‌رانی ژێر ئاسمان پێی ڕاگه‌یه‌نرا، خۆشم‏بووم به‌خزمه‌تكار بۆی.<verse eid="COL 1:23" /></para>
  <para style="s1">تێكۆشانی پۆڵس بۆ باوه‌ڕداران</para>
  <para style="p">
    <verse number="24" style="v" sid="COL 1:24" />من ئێستا دڵشادم به‌و ئازاره‌ی له‌پێناوتان ده‌یچێژم‏، چونكه‌ له‌له‌شی خۆمدا كه‌م‏وكوڕی ته‌نگانه‌ی مه‌سیح ته‌واو ده‌كه‌م، له‌پێناوی له‌شی ئه‌و كه‌ كۆمه‌ڵه‌ی باوه‌ڕدارانه‌، <verse eid="COL 1:24" /><verse number="25" style="v" sid="COL 1:25" />ئه‌وه‌ی من بووم به‌ خزمه‌تكار بۆی، له‌سه‌ر خواستی خودا به‌من دراوه‌ له‌پێناوتان، تا ووشه‌ی خوداتان به‌ ته‌واوی پێ‌بناسێنم، <verse eid="COL 1:25" /><verse number="26" style="v" sid="COL 1:26" />ئه‌م نهێنیه‌ش لای نه‌وه‌كانی ڕابردوو شاراوه‌ بوو، به‌ڵام ئێستا خودا ده‌ریخست بۆ خوشك‏و برا پیرۆزه‌كان. <verse eid="COL 1:26" /><verse number="27" style="v" sid="COL 1:27" />ئه‌وانه‌ی خودا خۆی ویستی ده‌وڵه‌مه‌ندی شكۆداری ئه‌م نهینییه‌ بۆ هه‌موو میلله‌تان ده‌ربخات، ئه‌وه‌یه‌ مه‌سیح له‌ناوتاندایه‌، هیوای شكۆمه‌ندییه‌.</para>
  <para style="p" vid="COL 1:27">‏ <verse eid="COL 1:27" /><verse number="28" style="v" sid="COL 1:28" />ئه‌وه‌ی بانگه‌وازی پێ‌ده‌ده‌ین، هه‌موو مرۆڤێكی پێ‌ ئاگادار ده‌كه‌ینه‌وه‌، هه‌روه‌ها هه‌موو مرۆڤێكی پێ‌ فێر ده‌كه‌ین به‌‏هه‌موو ژیرییه‌وه‌، تاهه‌موو مرۆڤێك له‌مه‌سیحدا به‌ته‌واوی ئاماده‌ بكه‌ین.<verse eid="COL 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="COL 1:29" />له‌پێناوی ئه‌مه‌ منیش ماندوو ده‌بم‏و تێده‌كۆشم به‌هه‌موو توانایه‌ك، ئه‌وه‌ی به‌هێز له‌مندا كار ده‌كات.<verse eid="COL 1:29" /></para>
  <chapter eid="COL 1" />
  <chapter number="2" style="c" sid="COL 2" />
  <para style="p">
    <verse number="1" style="v" sid="COL 2:1" />ده‌مه‌وێ‌ بزانن من چه‌ند تێده‌كۆشم له‌پێناوتان‏و له‌‏پێناوی ئه‌وانه‌ی له‌‏شاری لاودكیه‌ن‏، هه‌روه‌ها ئه‌وانه‌ی منیان ڕووبه‌ڕوو نه‌بینیوه‌، <verse eid="COL 2:1" /><verse number="2" style="v" sid="COL 2:2" />تاوه‌كو ووره‌یان به‌رزبێته‌وه‌، یه‌ك‎بگرن به‌ خۆشه‌ویستیو داناییو تێگه‌یشتنی ته‌واویان هه‌بێت بۆ ناسینی نهێنی خودا كه‌ مه‌سیحه‌، <verse eid="COL 2:2" /><verse number="3" style="v" sid="COL 2:3" />ئه‌وه‌ی هه‌موو گه‌نجینه‌ی داناییو زانستی تیادا شارراوه‌ته‌وه‌.<verse eid="COL 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="COL 2:4" />ئه‌مه‌تان پێ‌ده‌ڵێم تا كه‌س به‌ قسه‌ی دره‌وشاوه‌ هه‌ڵتان نه‌خه‌ڵه‌تێنێ‌. <verse eid="COL 2:4" /><verse number="5" style="v" sid="COL 2:5" />هه‌رچه‌نده‌ به‌ له‌ش له‌ناوتان نیم، به‌ڵام به‌ ڕۆح له‌گه‌ڵتانم، دڵشاد ده‌بم كاتێ‌ باوه‌ڕی چه‌سپاو و ته‌واوتان به‌‏عیسای مه‌سیح ببینم.<verse eid="COL 2:5" /></para>
  <para style="s1">تێرو پڕی مه‌سیح</para>
  <para style="p">
    <verse number="6" style="v" sid="COL 2:6" />جا چۆن عیسای مه‌سیحتان قه‌بووڵ كرد وه‌ك خوداوه‌ندی خۆتان، له‌ئه‌ویش بژین، <verse eid="COL 2:6" /><verse number="7" style="v" sid="COL 2:7" />با ڕه‌گتان له‌‏ئه‌و پنج داكوتێ‌، باوه‌ڕتان به‌هێزو چه‌سپاو بێت به‌و شێوه‌یه‌ی فێربوون، هه‌میشه‌ ده‌م به‌‏سوپاس‏بن.<verse eid="COL 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 2:8" />ئاگاداربن كه‌س نه‌تانخاته‌ داوی فه‌لسه‌فـه‌و چه‌واشه‌ی به‌ خۆڕایی، ئه‌وه‌ی له‌سه‌ر خووڕه‌وشتی خه‌ڵكی‏و یاسای سه‌ره‌كی ئه‌م گه‌ردوونه‌ وه‌ستاوه‌ نه‌ك له‌سه‌ر مه‌سیح. <verse eid="COL 2:8" /><verse number="9" style="v" sid="COL 2:9" />چونكه‌ خودا به‌ هه‌موو پڕی خۆی له‌ له‌شی مه‌سیح نیشته‌جێ‌ بووه‌، <verse eid="COL 2:9" /><verse number="10" style="v" sid="COL 2:10" />ئێوه‌ش به‌ ئه‌و پڕ ده‌بن له‌ژیان، ئه‌وه‌ی سه‌ری هه‌موو پێشه‌واو حوكمڕانێكه‌. <verse eid="COL 2:10" /><verse number="11" style="v" sid="COL 2:11" />له‌عیساوه‌ خه‌ته‌نه‌یه‌ك كراون به‌ده‌ست نه‌كراوه‌، به‌ڵكو به‌داماڵینی سروشتی گوناهبار به‌ خه‌ته‌نه‌كردنی مه‌سیح. <verse eid="COL 2:11" /><verse number="12" style="v" sid="COL 2:12" />كاتێ‌ ‏له‌ئاوهه‌ڵكێشران به‌ناوی عیسا، ئه‌وا له‌گه‌ڵ ئه‌و نێژران‏و له‌گه‌ڵی زیندووبوونه‌وه‌، چونكه‌ باوه‌ڕتان به‌‏كرداری خودا كرد كه‌ له‌ناو مردووان زیندووی كرده‌وه‌.</para>
  <para style="p" vid="COL 2:12">‏ <verse eid="COL 2:12" /><verse number="13" style="v" sid="COL 2:13" />ئێوه‌ به‌هۆی گوناه‌و به‌هۆی خه‌ته‌نه‌ نه‌كردنی له‌شی گوناهبارتان مردبوون، به‌ڵام خودا له‌گه‌ڵ عیسا زیندوویكردنه‌وه‌و له‌‏هه‌موو گوناهتان خۆش بوو. <verse eid="COL 2:13" /><verse number="14" style="v" sid="COL 2:14" />‏ئه‌و شكاتنامه‌یه‌ی له‌سـه‌رمــان نــووسرابوو، ئــه‌وه‌ی دژی ئێمه‌ بوو، عیسا سڕییه‌وه‌و به‌‏خاچه‌وه‌ بزماركوتی كرد. <verse eid="COL 2:14" /><verse number="15" style="v" sid="COL 2:15" />‏سه‌رۆك‏و حوكمڕانه‌كانی چه‌ك‏كردو كردنی به‌په‌ند، له‌خۆپیشاندانه‌ سه‌ركه‌وتووه‌كه‌ی وه‌ك دیل ‏ڕاپێچی‏كردن.<verse eid="COL 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 2:16" />با‏كه‌س حوكمی خواردن‏و خواردنه‌وه‌و جۆری هه‌ڵسوكه‌وتی جه‌ژن‏و سه‌ری مانگان‏و شه‌ممانتان به‌سه‌ر نه‌دات. <verse eid="COL 2:16" /><verse number="17" style="v" sid="COL 2:17" />ئه‌مانه‌ هه‌مووی سێبه‌ری داهاتوون، به‌ڵام ڕاستیه‌كه‌ی ته‌نها لای مه‌سیحه‌. <verse eid="COL 2:17" /><verse number="18" style="v" sid="COL 2:18" />باكه‌س مافتان لێ‌داگیر نه‌كات به‌وه‌ی داوای ساكاریو په‌رستنی فریشته‌كانتان لێ‌بكات، به‌و بینینانه‌ی خۆی ده‌یبینێ‌، خۆی به‌ زل ده‌زانێ‌ به‌خه‌یاڵه‌ مرۆڤانیه‌ پووچه‌كانی. <verse eid="COL 2:18" /><verse number="19" style="v" sid="COL 2:19" />بێ‌ئه‌وه‌ی بایه‌خ بدات به‌ سه‌ر‏، ئه‌وه‌ی هه‌موو له‌ش خواردنی لـێ‌وه‌رده‌گرێ‌‏و ده‌یبه‌ستێت به‌ هه‌موو جومگه‌و پارچه‌كانی له‌شه‌وه‌، تا نه‌شونما بكات به‌و شێوه‌یه‌ی خودا ده‌یه‌وێ‌.<verse eid="COL 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="COL 2:20" />گه‌ر ئێوه‌ مردوون له‌گه‌ڵ مه‌سیح سه‌باره‌ت به‌یاسا سه‌ره‌كیه‌كانی ئه‌م جیهانه‌، كه‌واته‌ بۆچی وا ده‌ژین هه‌روه‌ك سه‌ربه‌م جیهانه‌ بن؟ بۆچی ملكه‌چ ده‌كه‌ن بۆ ئه‌م ڕاسپاردانه‌: <verse eid="COL 2:20" /><verse number="21" style="v" sid="COL 2:21" />(مه‌یگره‌! تامی مه‌كه‌! ده‌ستی لێ‏مه‌ده‌!)؟ <verse eid="COL 2:21" /><verse number="22" style="v" sid="COL 2:22" />ئه‌م ڕاسپاردانه‌ هه‌موویان شتێكن به‌ به‌كارهێنان له‌ناوده‌چن، چونكه‌ به‌گوێره‌ی فێركردنه‌كان‏و ڕاسپارده‌كانی مرۆڤن. <verse eid="COL 2:22" /><verse number="23" style="v" sid="COL 2:23" />به‌‏ڕواڵه‌ت دانایی ده‌رده‌خات، چونكه‌ په‌رستنێكی تایبه‌تی‏و ملكه‌چیو توندوتیژی تیادایه‌ سه‌باره‌ت به‌له‌ش. به‌ڵام نرخێكی وای نییه‌ له‌‏دامركاندنی ئاره‌زوو و داواكاری له‌ش.<verse eid="COL 2:23" /></para>
  <chapter eid="COL 2" />
  <chapter number="3" style="c" sid="COL 3" />
  <para style="s1">باوه‌ڕدارو مه‌سیح</para>
  <para style="p">
    <verse number="1" style="v" sid="COL 3:1" />گه‌ر ئێوه‌ له‌گه‌ڵ مه‌سیح هه‌ستاونه‌ته‌وه‌، هه‌وڵ‎بده‌ن بۆ كاروباری ئاسمانی، ‏مه‌سیح له‌وێ‌ له‌‏لای ده‌سته‌ ڕاستی خودا دانیشتووه‌. <verse eid="COL 3:1" /><verse number="2" style="v" sid="COL 3:2" />بایه‌خ به‌كاروباری ئاسمانی بده‌ن، نه‌ك به‌كاروباری سه‌ر زه‌وی، <verse eid="COL 3:2" /><verse number="3" style="v" sid="COL 3:3" />چونكه‌ ئێوه‌ مردن، هه‌روه‌ها ژیانتان شارراوه‌ته‌وه‌ له‌گه‌ڵ مه‌سیح لای خودا. <verse eid="COL 3:3" /><verse number="4" style="v" sid="COL 3:4" />كاتێ‌ عیسا ئه‌وه‌ی ژیانتانه‌ ده‌ركه‌وت، ئه‌وسا ئێوه‌ش به‌شكۆمه‌ندی له‌گه‌ڵی ده‌رده‌كه‌ون.<verse eid="COL 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="COL 3:5" />كه‌واته‌ ده‌بێ‌ هه‌رچی شتی ئه‌م جیهانه‌ هه‌یه‌ تیاتان بیمرێنن وه‌ك: داوێن‎پیسی، گڵاوی، ئاره‌زووی خراپ، خواستی به‌د، چاوبرسێتی، ئه‌مانه‌ جۆرێكن له‌ بت ‎په‌رستی، <verse eid="COL 3:5" /><verse number="6" style="v" sid="COL 3:6" />چونكه‌ به‌هۆی ئه‌و شتانه‌وه‌ تووڕه‌یی خودا دێته‌خواره‌وه‌. <verse eid="COL 3:6" /><verse number="7" style="v" sid="COL 3:7" />هه‌روه‌ها ئێوه‌ش جاران وا ده‌ژیان. <verse eid="COL 3:7" /><verse number="8" style="v" sid="COL 3:8" />به‌ڵام ئێستا هه‌موو ئه‌وانه‌ فڕێ‌بده‌ن: تووڕه‌یی، ڕق‏وكینه‌، بوختان، قسه‌ی ناشیرین، <verse eid="COL 3:8" /><verse number="9" style="v" sid="COL 3:9" />درۆ مه‌كه‌ن له‌گه‌ڵ یه‌كتری، چونكه‌ مرۆڤه‌ كۆنه‌كه‌و هه‌موو كرداره‌كانیتان داكه‌ندوه‌و <verse eid="COL 3:9" /><verse number="10" style="v" sid="COL 3:10" />مرۆڤێكی نوێتان له‌به‌ركردوه‌، ئه‌وه‌ی له‌نوێ‌بوونه‌وه‌یه‌ له‌ناسین به‌پێی وێنه‌ی دروستكه‌ری. <verse eid="COL 3:10" /><verse number="11" style="v" sid="COL 3:11" />جووله‌كه‌و یۆنانی، خه‌ته‌نه‌كراو و خه‌ته‌نه‌‏نه‌كراو، به‌ربه‌ری‏و سكیسی، كۆیله‌‏و ئازاد نییه‌، به‌ڵكو مه‌سیح خۆی هه‌موو شتێكه‌و له‌هه‌موو شتێك‏دایه‌.<verse eid="COL 3:11" /></para>
  <para style="s1">باوه‌ڕدارو كۆمه‌ڵه‌</para>
  <para style="p">
    <verse number="12" style="v" sid="COL 3:12" />‏ئێوه‌ی پیرۆزكراو، خۆشه‌ویست، هه‌ڵبژێرراو له‌لایه‌ن خودا :‏به‌زه‌یی، زمان‎شیرینی، ڕۆح سووكی، ساكاری، ئارام گرتن له‌به‌ر بكه‌ن. <verse eid="COL 3:12" /><verse number="13" style="v" sid="COL 3:13" />له‌یه‌كتری قه‌بووڵ بكه‌ن، له‌ یه‌كتر خۆش‎بن، گه‌ر یه‌كێكتان شكاتی دژی ئه‌ویكه‌ هه‌بوو، ده‌بێ‌ لیێ‌ خۆش‎بێت هه‌روه‌ك مه‌سیح لێتان خۆش بووه‌. <verse eid="COL 3:13" /><verse number="14" style="v" sid="COL 3:14" />به‌ڵام له‌سه‌رووی ئه‌مانه‌ هه‌موو به‌رگی خۆشه‌ویستی له‌به‌ر بكه‌ن‏، چونكه‌ هه‌موو شتێك به‌ته‌واوی به‌یه‌كه‌وه‌ ده‌به‌ستێت.</para>
  <para style="p" vid="COL 3:14">‏ <verse eid="COL 3:14" /><verse number="15" style="v" sid="COL 3:15" />با ئاشتی مه‌سیح ده‌ست‎بگرێ‌ به‌سه‌ر دڵتان، ئه‌وه‌ی ئێوه‌ی بۆ بانگ‎كراوه‌ تا ببن به‌ یه‌ك له‌ش، هه‌روه‌ها ده‌م به‌سوپاس‏بن.</para>
  <para style="p" vid="COL 3:15">‏ <verse eid="COL 3:15" /><verse number="16" style="v" sid="COL 3:16" />با ووشه‌ی مه‌سیح به‌ده‌وڵه‌مه‌ندی له‌‏دڵتان جێگیر بێت، یه‌كتری فێر بكه‌ن‏و ڕێ‌نیشانی یه‌كتری بده‌ن به‌ هه‌موو داناییه‌وه‌، زه‌بوورو سروودو گۆرانی ڕۆحی بڵێن، به‌ناخی دڵ سوپاسی خودا بكه‌ن. <verse eid="COL 3:16" /><verse number="17" style="v" sid="COL 3:17" />هه‌ر شتێك ده‌ڵێن‏و ده‌یكه‌ن با به‌‏ناوی عیسای خوداوه‌ند بێت، به‌‏ئه‌و سوپاسی خودای باوك بكه‌ن.<verse eid="COL 3:17" /></para>
  <para style="s1">باوه‌ڕدارو خێزان</para>
  <para style="p">
    <verse number="18" style="v" sid="COL 3:18" />ئه‌ی ئافره‌تان ملكه‌چ بكه‌ن بۆ مێرده‌كانتان، به‌‏شێوه‌یه‌ك لێوه‌شاوه‌ بێت له‌‏خوداوه‌ند.</para>
  <para style="p" vid="COL 3:18">‏ <verse eid="COL 3:18" /><verse number="19" style="v" sid="COL 3:19" />ئه‌ی پیاوان، ژنه‌كانتان خۆش‏بوێ‌، له‌گه‌ڵیان ڕه‌ق‏مه‌بن. ‏ <verse eid="COL 3:19" /><verse number="20" style="v" sid="COL 3:20" />ئه‌ی منداڵان، گوێڕایه‌ڵی دایك‏و بــاوكـتان بن له‌‏هه‌موو شتێك، چونكه‌ ئه‌مه‌ مایه‌ی ڕه‌زامه‌ندی خوداوه‌نده‌.<verse eid="COL 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 3:21" />ئه‌ی باوكان، منداڵه‌كانتان تووڕه‌ مه‌كه‌ن، تا ترسنۆك‏و سه‌رنه‌كه‌وتوو ده‌رنه‌چن.<verse eid="COL 3:21" /></para>
  <para style="s1">باوه‌ڕدار له‌ كاركردن</para>
  <para style="p">
    <verse number="22" style="v" sid="COL 3:22" />ئه‌ی كۆیله‌كان، له‌‏هه‌موو شتێك ملكه‌چی گه‌وره‌كانتان بن له‌م جیهانه‌، به‌دڵسۆزی كار مه‌كه‌ن ته‌نها كاتێ‌ چاویان لێتانه‌ هه‌روه‌ك بتانه‌وێ‌ خه‌ڵكی ڕازی بكه‌ن، به‌ڵكو به‌ دڵسۆزیو به‌ترسی خوداوه‌ند بیكه‌ن. <verse eid="COL 3:22" /><verse number="23" style="v" sid="COL 3:23" />هه‌ر چییه‌ك ده‌كه‌ن، به‌‏هه‌موو دڵ بیكه‌ن، هه‌روه‌ك بۆ خوداوه‌ندی بكه‌ن نه‌ك بۆ خه‌ڵكی. <verse eid="COL 3:23" /><verse number="24" style="v" sid="COL 3:24" />بزانن له‌خوداوه‌نده‌وه‌ میرات به‌پاداشت وه‌رده‌گرن، چونكه‌ ئێوه‌ خزمه‌تی مه‌سیحی خوداوه‌ند ده‌كه‌ن. <verse eid="COL 3:24" /><verse number="25" style="v" sid="COL 3:25" />به‌ڵام ئه‌وه‌ی كاری خراپ بكات سزای خراپه‌ی خۆی وه‌رده‌گرێ‌، گرنگ نییه‌ بــه‌لای خودا ئه‌و كه‌سه‌ كێ‌ بێت.<verse eid="COL 3:25" /></para>
  <chapter eid="COL 3" />
  <chapter number="4" style="c" sid="COL 4" />
  <para style="p">
    <verse number="1" style="v" sid="COL 4:1" />ئه‌ی گه‌وره‌كان، به‌دادپه‌روه‌ریو یه‌كسانی هه‌ڵسوكه‌وت بكه‌ن له‌گه‌ڵ كۆیله‌كانتان، بزانن ئێوه‌ش گه‌وره‌یه‌كتان هه‌یه‌ له‌ ئاسمان.<verse eid="COL 4:1" /></para>
  <para style="s1">هاندان بۆ نوێژكردن</para>
  <para style="p">
    <verse number="2" style="v" sid="COL 4:2" />به‌رده‌وام بن له‌سه‌ر نوێژكردن، ئاگاداربن له‌كاتی نوێژ سوپاس بكه‌ن، <verse eid="COL 4:2" /><verse number="3" style="v" sid="COL 4:3" />‏له‌هه‌مان ‎كات بۆ ئێمه‌ش نوێژ بكه‌ن، بۆ ئه‌وه‌ی خودا ده‌رگای قسه‌كردنمان بۆ بكاته‌وه‌و نهێنی مه‌سیح ڕابگه‌ێنین، ئه‌وه‌ی من له‌پێناویدا به‌ندكراوم. <verse eid="COL 4:3" /><verse number="4" style="v" sid="COL 4:4" />تا ئاشكرای بكه‌م لای خه‌ڵكی به‌و شێوه‌یه‌ی پێویسته‌ له‌سه‌رم بدوێم. <verse eid="COL 4:4" /><verse number="5" style="v" sid="COL 4:5" />به‌ژیرانه‌ هه‌ڵسوكه‌وت بكه‌ن له‌گه‌ڵ ئه‌وانه‌ی باوه‌ڕدار نین، هه‌موو هه‌لێك بقۆزنه‌وه‌. <verse eid="COL 4:5" /><verse number="6" style="v" sid="COL 4:6" />با‏هه‌میشه‌ قسه‌تان به‌ره‌كه‌تدار بێت، به‌خوێ‌ سوێر كرابێ‌، ئه‌وسا ده‌زانن چۆن وه‌ڵامی خه‌ڵكی ده‌ده‌نه‌وه‌.<verse eid="COL 4:6" /></para>
  <para style="s1">سڵاوی كۆتایی</para>
  <para style="p">
    <verse number="7" style="v" sid="COL 4:7" />تیخیكۆس هه‌موو هه‌واڵێكی منتان ده‌داتێ‌، برای خۆشه‌ویست‏و خزمه‌تكاری سه‌رڕاست‏و كۆیله‌ی هاوڕێم له‌‏خوداوه‌ند. <verse eid="COL 4:7" /><verse number="8" style="v" sid="COL 4:8" />به‌تایبه‌تی ئه‌وم نارد‏ه‌ لاتان بۆ ئه‌م مه‌به‌سته‌ تا هه‌واڵی ئێمه‌تان پێ‌ بگه‌ینێت‏و ووره‌تان به‌رز بكاته‌وه‌، <verse eid="COL 4:8" /><verse number="9" style="v" sid="COL 4:9" />له‌گه‌ڵ ئۆنسیمۆس برای خۆشه‌ویست‏و سه‌رڕاست، خه‌ڵكی لای خۆتانه‌، هه‌ردووكیان هه‌واڵی هه‌موو شتێكتان ده‌ده‌نێ‌ كه‌ لێره‌ ڕوویداوه‌. ‏ <verse eid="COL 4:9" /><verse number="10" style="v" sid="COL 4:10" />ئه‌رسته‌رخۆس هاورێی به‌ندیخانه‌م سڵاوتان لـێ‌ده‌كات، له‌گه‌ڵ مه‌رقۆسی ئامۆزای به‌رنابا، ئه‌وه‌ی ڕامسپاردن به‌گه‌رمی پێشوازی لـێ‌بكه‌ن كاتێ‌ هات بۆ لاتان، <verse eid="COL 4:10" /><verse number="11" style="v" sid="COL 4:11" />هه‌روه‌ها یه‌سوع كه‌ به‌یستۆس ناوده‌برێ‌. ته‌نها ئه‌مانه‌ جووله‌كه‌ن لـه‌نێوان ئه‌و یارمه‌تیده‌ره‌ ئیشكه‌رانه‌م بۆ پادشاهێتی خودا، ئه‌وان بوونه‌ هۆی دڵخۆشییه‌كی زۆر بۆم. <verse eid="COL 4:11" /><verse number="12" style="v" sid="COL 4:12" />ئه‌په‌فراسی به‌نده‌ی عیسای مه‌سیح، خه‌ڵكی لای خۆتانه‌ سڵاوتان لـێ‌ده‌كات، هه‌موو كاتێ‌ لای خودا لـه‌پێناوتان تێده‌كۆشێ‌ له‌نوێژ تا‏باوه‌ڕتان چه‌سپاو بێت‏و پێگه‌یشتوو بن‏و هه‌موو كاتێ‌ پڕ بن له‌هه‌موو خواستی خودا. <verse eid="COL 4:12" /><verse number="13" style="v" sid="COL 4:13" />من شایه‌تی بۆ ده‌ده‌م ئه‌و زۆر ماندوو ده‌بێت له‌و كارانه‌ی ده‌یكات له‌پێناوی ئێوه‌و ئه‌وانه‌ی له‌‏لاودكیه‌و هیراپۆلیسن. <verse eid="COL 4:13" /><verse number="14" style="v" sid="COL 4:14" />هه‌روه‌ها لۆقای پزیشكی خۆشه‌ویست‏و دیماس سڵاوتان لـێ‌ ده‌كه‌ن. <verse eid="COL 4:14" /><verse number="15" style="v" sid="COL 4:15" />سڵاو له‌خوشك‏و برایان بكه‌ن له‌‏لاودكیه‌و له‌‏خوشكه‌ نه‌مفاس‏و ئه‌و كۆمه‌ڵه‌ باوه‌ڕداره‌ی كۆده‌بنه‌وه‌ له‌‏ماڵه‌كه‌ی.</para>
  <para style="p" vid="COL 4:15">‏ <verse eid="COL 4:15" /><verse number="16" style="v" sid="COL 4:16" />‏دوای ئه‌وه‌ی ئه‌م نامه‌یه‌تان بۆ خوێنرایه‌وه‌، بینێرن بۆ كۆمه‌ڵه‌ باوه‌ڕدارانی لاودكیه‌ تا ئه‌وانیش بیخوێننه‌وه‌، ئینجا ئێوه‌ش ئه‌و نامه‌یه‌ی لایانه‌ لێیان وه‌رگرن‏و بیخوێننه‌وه‌.<verse eid="COL 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="COL 4:17" />به‌ ئه‌رخیپۆس بڵێن: (ئه‌و خزمه‌ته‌ی خوداوه‌ند داویه‌تی پێی با به‌‏ته‌واوی بیهێنیته‌دی.)<verse eid="COL 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="COL 4:18" />من پۆڵسم، سڵاوی منتان لـێ‌بێت، به‌‏خه‌تی خۆم بۆتان ده‌نووسم. یادی كۆت‏و زنجیره‌كانم بكه‌ن. با به‌ره‌كه‌تی خوداتان له‌گه‌ڵ بێت.<verse eid="COL 4:18" /></para>
  <chapter eid="COL 4" />
</usx>