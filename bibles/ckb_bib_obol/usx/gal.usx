<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GAL" style="id">- Biblica® Open Sorani Kurdish Book of Life</book>
  <para style="rem">‪Copyright © 1998 by Biblica, Inc.</para>
  <para style="h">گەلاتیا</para>
  <para style="toc1">نامه‌ی پۆڵس بۆ باوه‌ڕدارانی غه‌ڵاتیه‌</para>
  <para style="toc2">گەلاتیا</para>
  <para style="toc3">گەلاتیا</para>
  <para style="mt1">نامه‌ی پۆڵس بۆ باوه‌ڕدارانی غه‌ڵاتیه‌</para>
  <chapter number="1" style="c" sid="GAL 1" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1" />له‌پۆڵسه‌وه‌، ئه‌وه‌ی نه‌له‌لایه‌ن خه‌ڵكه‌‏و نه‌ به‌هۆی خه‌ڵك نێرراوه‌، به‌ڵكو له‌لایه‌ن عیسای مه‌سیح‏و خودای باوك ئه‌وه‌ی مه‌سیحی له‌نێو مردووان زیندوو‏كرده‌وه‌. <verse eid="GAL 1:1" /><verse number="2" style="v" sid="GAL 1:2" />هه‌روه‌ها له‌‏هه‌موو ئه‌و خوشك‏و برایانه‌ی لێره‌ له‌گه‌ڵم‏دان. بۆ ئه‌و كۆمه‌ڵه‌ باوه‌ڕدارانه‌ی له‌ناوچه‌ی غه‌ڵاتیه‌ن. <verse eid="GAL 1:2" /><verse number="3" style="v" sid="GAL 1:3" />با ئاشتیو به‌ره‌كه‌تی خودای باوك‏و عیسای مه‌سیحی خوداوه‌ندتان له‌گه‌ڵ بێ‌، <verse eid="GAL 1:3" /><verse number="4" style="v" sid="GAL 1:4" />ئه‌وه‌ی خۆی كرد به‌ قوربانی له‌پێناوی گوناهه‌كانمان، تا ڕزگارمان بكات له‌م جیهانه‌ خراپه‌ی ئێستا، به‌پێی خواستی خودای باوكمان. <verse eid="GAL 1:4" /><verse number="5" style="v" sid="GAL 1:5" />بۆ ئه‌وه‌ شكۆمه‌ندی تاهه‌تایه‌. ئامین.<verse eid="GAL 1:5" /></para>
  <para style="s1">مزگێنییه‌كی دیكه‌ نییه‌</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6" />من سه‌رم سوڕماوه‌. چۆن وا به‌خێرایی واز له‌و كه‌سه‌ ده‌هێنن كه‌ به‌به‌ره‌كه‌تی مه‌سیح بانگی كردوون، شوێنی مزگێنییه‌كی دیكه‌ ده‌كه‌ون؟ <verse eid="GAL 1:6" /><verse number="7" style="v" sid="GAL 1:7" />‏مه‌به‌ستم ئه‌وه‌ نییه‌ مزگێنیه‌كی دیكه‌ هه‌بێ‌، به‌ڵكو هه‌ندێك له‌ناوتان ده‌یانه‌وێ‌ سه‌رتان لـێ‌بشێوێنن‏و مزگێنی مه‌سیح تێك‏بده‌ن. <verse eid="GAL 1:7" /><verse number="8" style="v" sid="GAL 1:8" />به‌ڵام ته‌نانه‌ت گه‌ر ئێمه‌ مزگێنیه‌‏كمان پێدان، یاخود فریشته‌ی ئاسمان مزگێنییه‌كی پێدان، جگه‌ له‌وه‌ی له‌‏ئێمه‌وه‌ پێتان دراوه‌، با نه‌فره‌تی لـێ‌ بێت. <verse eid="GAL 1:8" /><verse number="9" style="v" sid="GAL 1:9" />هه‌روه‌ك پێشتر پێمان ووتون ئێستاش پێتان ده‌ڵێمه‌وه‌، گه‌ر یه‌كێك مزگێنییه‌كی پێ‌دان جگه‌ له‌وه‌ی له‌ ئێمه‌وه‌ پێتان دراوه‌، با نه‌فره‌تی لـێ‌بێ‌. ‏ <verse eid="GAL 1:9" /><verse number="10" style="v" sid="GAL 1:10" />ئایا ئێستا هه‌وڵ ‎ده‌ده‌م بۆ به‌ده‌ست‏هێنانی ڕه‌زامه‌ندی خه‌ڵكی یاخود ڕه‌زامه‌‏ندی خودا؟ یان داوای ئه‌وه‌ ده‌كه‌م خه‌ڵكی ڕازی بكه‌م؟ گه‌ر تا ئێستا خه‌ریكی ڕازیكردنی خه‌ڵكی بوومایه‌ نه‌ده‌بوومه‌ به‌نده‌ی مه‌سیح.<verse eid="GAL 1:10" /></para>
  <para style="s1">چۆن پۆڵس بوو به‌ نێرراو؟</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11" />برایان باش بزانن ئه‌و مزگێنییه‌ی ڕام‏گه‌یاندووه‌، مزگێنییه‌ك نییه‌ له‌مرۆڤ بێ‌، <verse eid="GAL 1:11" /><verse number="12" style="v" sid="GAL 1:12" />له‌‏كه‌سیشم وه‌رنه‌گرتوه‌، كه‌سیش فێری نه‌كردووم، به‌ڵكو به‌ڕاگه‌یاندنی عیسای مه‌سیح بۆم هاتووه‌.</para>
  <para style="p" vid="GAL 1:12">‏ <verse eid="GAL 1:12" /><verse number="13" style="v" sid="GAL 1:13" />چونكه‌ ‏ده‌زانن، چۆن جاران وه‌ك جووله‌كه‌یه‌ك ژیاوم، چۆن كۆمه‌ڵه‌ باوه‌ڕداره‌كانی خودام دڕندانه‌ چه‌وساندۆته‌وه‌و هه‌وڵم‏داوه‌ له‌ناویان ببه‌م، <verse eid="GAL 1:13" /><verse number="14" style="v" sid="GAL 1:14" />هه‌روه‌ها چۆن له‌باره‌ی جێ‌به‌جێ‌كردنی كاروباری ئایینی جووله‌كه‌ باشتر بووم له‌زۆربه‌ی هاوڕێیه‌كانم، هه‌روه‌ها زۆر دڵگه‌رمتر بووم له‌وان بۆ داب‏ونه‌ریتی باوباپیرانمان. <verse eid="GAL 1:14" /><verse number="15" style="v" sid="GAL 1:15" />به‌ڵام خودا به‌ به‌ره‌كه‌تی خۆی پێش له‌دایك‎بوونم هه‌ڵیبژاردم‏و بانگی كردم‏، <verse eid="GAL 1:15" /><verse number="16" style="v" sid="GAL 1:16" />خۆشحاڵ بووم ڕۆڵه‌كه‌ی بۆ من ڕابگه‌ینێ‌، هه‌تا منیش مزگێنی پێ‌بده‌م له‌ناو میلله‌تان، ئه‌و كاته‌ ڕاوێژم له‌گه‌ڵ هیچ كه‌س نه‌كرد. <verse eid="GAL 1:16" /><verse number="17" style="v" sid="GAL 1:17" />نه‌چووم بۆ قودس بۆ لای ئه‌وانه‌ی پێش من نێرراو بوون، به‌ڵكو یه‌كسه‌ر ڕۆیشتم بۆ عه‌ره‌بستان، له‌وێشه‌وه‌ گه‌ڕامه‌وه‌ بۆ دیمه‌شق.</para>
  <para style="p" vid="GAL 1:17">‏ <verse eid="GAL 1:17" /><verse number="18" style="v" sid="GAL 1:18" />ئینجا دوای سێ‌ ساڵ ڕۆیشتم بۆ قودس، تاكو په‌ترۆس ببینم، پانزه‌ ڕۆژ لای ئه‌و مامه‌وه‌. <verse eid="GAL 1:18" /><verse number="19" style="v" sid="GAL 1:19" />به‌ڵام له‌وێ‌ هیچ نێرراوێكی ترم نه‌دی جگه‌ له‌‏یاقوبی برای خوداوه‌ند نه‌بێ‌. <verse eid="GAL 1:19" /><verse number="20" style="v" sid="GAL 1:20" />ئه‌وه‌ی بۆتانی ده‌نووسم، خودا ده‌زانێ‌ درۆ نییه‌. <verse eid="GAL 1:20" /><verse number="21" style="v" sid="GAL 1:21" />دوایی بۆ هه‌رێمه‌كانی سوریاو كیلیكیه‌ چووم. <verse eid="GAL 1:21" /><verse number="22" style="v" sid="GAL 1:22" />به‌ڵام هێشتا كۆمه‌ڵه‌ باوه‌ڕداره‌كانی ناوچه‌ی یه‌هودیه‌ كه‌ له‌مه‌سیحن منیان نه‌ده‌ناسی. <verse eid="GAL 1:22" /><verse number="23" style="v" sid="GAL 1:23" />ته‌نها بیستبوویان: (ئه‌و پیاوه‌ی جاران ئێمه‌ی ده‌چه‌وسانده‌وه‌، ئێستا خۆی مزگێنی ئه‌و باوه‌ڕه‌ ده‌دات، كه‌ جاران هه‌ولـێ‌ له‌ناوبردنی ‏ده‌دا.) <verse eid="GAL 1:23" /><verse number="24" style="v" sid="GAL 1:24" />ئیتر ئه‌وان ستایشی خودایان كرد به‌هۆی منه‌وه‌.<verse eid="GAL 1:24" /></para>
  <chapter eid="GAL 1" />
  <chapter number="2" style="c" sid="GAL 2" />
  <para style="s1">ڕازی‏بوون به‌ خزمه‌تی پۆڵس</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1" />دوای چوارده‌ ساڵ جارێكی دیكه‌ له‌گه‌ڵ به‌رنابا ڕۆیشتم بۆ قودس، تیتۆسیشم له‌گه‌ڵ خۆم برد. <verse eid="GAL 2:1" /><verse number="2" style="v" sid="GAL 2:2" />چوونم بۆ ئه‌وێ‌ به‌ڕاگه‌یاندن بوو، ئه‌و مزگێنییه‌ی ده‌یده‌م به‌میلله‌تان له‌پێشا ته‌نها خستمه‌ به‌رده‌م گه‌وره‌ پیاوان له‌وێ‌، تا هه‌وڵدانی ڕابوردوو و ئێستام به‌ فیڕۆ نه‌ڕوات. <verse eid="GAL 2:2" /><verse number="3" style="v" sid="GAL 2:3" />به‌ڵام ته‌نانه‌ت تیتۆسی هاورێی گه‌شتیشم كه‌ یۆنانی بوو، ناچارنه‌كرا خۆی خه‌ته‌نه‌ بكات. <verse eid="GAL 2:3" /><verse number="4" style="v" sid="GAL 2:4" />جا ئه‌م مه‌سه‌له‌یه‌ ته‌شه‌نه‌ی كرد، به‌هۆی هه‌ندێ‌ برایانی درۆزن كه‌ به‌نهێنی هاتبوونه‌ ناومان، ‏تاكو سه‌ربه‌ستی عیسای مه‌سیحمان لـێ‌‏بسێننه‌وه‌و بمان‎گه‌ڕێننه‌وه‌ بۆ كۆیلایه‌تی. <verse eid="GAL 2:4" /><verse number="5" style="v" sid="GAL 2:5" />به‌ڵام‏ ته‌نانه‌ت بۆ چاوتروكانێك ملكه‌چیان نه‌بووین‏و خۆمان نه‌دا به‌ده‌ستیان، هه‌تا پارێزگاری ڕاستی مزگێنیتان بۆ بكه‌ین‏.<verse eid="GAL 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6" />ئه‌وانه‌ی به‌گه‌وره‌ پیاوان داده‌نران [لـێپرسراوان]، به‌لای من هیچ گرنگ نه‌بوون، چونكه‌ خودا ته‌ماشای ڕوواڵه‌تی مرۆڤ ناكات. من ده‌ڵێم، ئه‌وانه‌ هیچ شتێكی تازه‌یان نه‌بوو بۆ من. <verse eid="GAL 2:6" /><verse number="7" style="v" sid="GAL 2:7" />به‌ڵكو به‌پێچه‌وانه‌، بۆیان ئاشكرا بوو، خودا كاری بڵاوكردنه‌وه‌ی مزگێنی به‌ من داوه‌ له‌نێوان ئه‌وانه‌ی جووله‌كه‌ نین، هه‌روه‌ك چۆن هه‌مان كاری به‌‏په‌ترۆس داوه‌ له‌نێوان ئه‌وانه‌ی جووله‌كه‌ن. <verse eid="GAL 2:7" /><verse number="8" style="v" sid="GAL 2:8" />چونكه‌ ئه‌وه‌ی كاری كردووه‌ له‌خزمه‌تی په‌ترۆس بۆ جووله‌كه‌كان، كاری له‌خزمه‌تی منیش كردووه‌ بۆ ناجووله‌كه‌كان. <verse eid="GAL 2:8" /><verse number="9" style="v" sid="GAL 2:9" />دوای ئه‌وه‌ی یاقوب‏و په‌ترۆس‏و یۆحه‌ننا كه‌ به‌ كۆڵه‌كه‌ دانرا‏بوون زانییان خودا ئه‌م به‌ره‌كه‌ته‌ی به‌ من داوه‌. ئه‌وسا ئه‌وان ده‌ستی برایانه‌یان خسته‌ ناو ده‌ستی من‏و به‌رنابا، له‌سه‌ر ئه‌وه‌ ڕێككه‌وتین ئه‌وان بۆ لای جووله‌كه‌كان بچن، ئێمه‌ش بۆ لای ناجووله‌كه‌كان. <verse eid="GAL 2:9" /><verse number="10" style="v" sid="GAL 2:10" />ته‌نها ‏داوای ئه‌وه‌یان لـێ‌كردین، هه‌ژاران له‌یاد نه‌كه‌ین، ئه‌مه‌ش شتێكه‌ هه‌میشه‌ بایه‌خم پێداوه‌.<verse eid="GAL 2:10" /></para>
  <para style="s1">سه‌رزه‌نشت‏كردنی په‌ترۆس‏</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11" />كاتێ‌ په‌ترۆس بۆ شاری ئه‌نتاكیا هات، ڕوو به‌ڕوو به‌ربه‌ره‌كانیم كرد، چونكه‌ شایانی گله‌یی لـێ‌كردن بوو. <verse eid="GAL 2:11" /><verse number="12" style="v" sid="GAL 2:12" />پێش ئه‌وه‌ی هه‌ندێ‌ كه‌س له‌لای یاقوبه‌وه‌ بێن، په‌ترۆس به‌بێ‌‎ترس نانی ده‌خوارد له‌گه‌ڵ ناجووله‌كه‌‏كان، به‌ڵام كاتێ‌ ئه‌وان هاتن، خۆی كێشایه‌ دواوه‌ له‌ترسی خه‌ته‌نه‌كراوان. <verse eid="GAL 2:12" /><verse number="13" style="v" sid="GAL 2:13" />له‌وێدا باوه‌ڕداره‌ جووله‌كه‌كانی دیكه‌ش له‌گه‌ڵ په‌ترۆس ده‌ستیان كرد به‌ دووڕوویی، ته‌نانه‌ت به‌رناباشیان والـێ‌كرد بچێته‌ ڕیزیان به‌هۆی دووڕووییان.</para>
  <para style="p" vid="GAL 2:13">‏ <verse eid="GAL 2:13" /><verse number="14" style="v" sid="GAL 2:14" />كاتێ‌ ئه‌مانه‌م بینی له‌‏ڕێگای ڕاستی مزگێنی ناڕۆن، له‌به‌ر چاوی هه‌موو ئه‌وانه‌ی له‌وێدا بوون به‌ په‌ترۆسم ووت: (گه‌ر تۆ كه‌ جووله‌كه‌ی، وه‌ك ناجووله‌كه‌ ده‌ژی نه‌ك وه‌ك جووله‌كه‌. ئیتر چۆن ئه‌و ناجووله‌كانه‌ ناچار ده‌كه‌یت وه‌ك جووله‌كه‌ بژین؟)<verse eid="GAL 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15" />هه‌رچه‌نده‌ ئێمه‌ به‌ جووله‌كه‌یی له‌دایك بووین‏و له‌میلله‌تانی گوناهبار نین، <verse eid="GAL 2:15" /><verse number="16" style="v" sid="GAL 2:16" />له‌گه‌ڵ ئه‌وه‌شدا ئێمه‌ ده‌زانین مرۆڤ بێتاوان نابێ‌ به‌كاركردن به‌شه‌ریعه‌ت، به‌ڵكو به‌باوه‌ڕ به‌عیسای مه‌سیح، جا ئێمه‌ش باوه‌ڕمان هێنا به‌عیسای مه‌سیح تاكو بێتاوان بین به‌ باوه‌ڕمان به‌ مه‌سیح، ئه‌مه‌ش نه‌ك به‌كاركردن به‌شه‌ریعه‌ت، چونكه‌ كاركردن به‌شه‌ریعه‌ت هیچ كه‌سێ‌ بێتاوان ناكات.<verse eid="GAL 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 2:17" />به‌ڵام گه‌ر ئێمه‌ له‌هه‌وڵدانمان بۆ بێتاوان بوون له‌مه‌سیح، خۆمان دۆزیه‌وه‌ گوناهبارین، ئیتر ئایا مه‌سیح خزمه‌تكاری گوناهه‌؟ بێ‌گومان نه‌خێر! <verse eid="GAL 2:17" /><verse number="18" style="v" sid="GAL 2:18" />به‌ڵام گه‌ر شتێك بنیادبنێمه‌وه‌ كه‌ له‌پێشا تێكمدابێ‌، ئه‌وا ده‌یسه‌لمێنم سه‌رپێچی شه‌ریعه‌تم كردووه‌. <verse eid="GAL 2:18" /><verse number="19" style="v" sid="GAL 2:19" />چونكه‌ به‌هۆی شه‌ریعه‌ت مردم بۆ شه‌ریعه‌ت، هه‌تا بۆ خودا بژیم. <verse eid="GAL 2:19" /><verse number="20" style="v" sid="GAL 2:20" />من له‌گه‌ڵ مه‌سیح له‌خاچدراوم، ئیتر من نیم ئه‌وه‌ی ده‌ژی، به‌ڵكو مه‌سیحه‌ له‌من ده‌ژی، هه‌روه‌ها ئه‌و ژیانه‌ی ئێستا به‌له‌ش ده‌ژیم ئه‌وه‌ به‌باوه‌ڕه‌ به‌ڕۆڵه‌ی خودا، ئه‌وه‌ی منی خۆشویست‏و خۆی كرد به‌‏قوربانی بۆ من. <verse eid="GAL 2:20" /><verse number="21" style="v" sid="GAL 2:21" />من به‌ره‌كه‌تی خودا پووچ ناكه‌مه‌وه‌، چونكه‌ گه‌ر بێتاوانی به‌ شه‌ریعه‌ت بووایه‌، ئیتر مردنی مه‌سیح بێ‌سوود ده‌بوو.<verse eid="GAL 2:21" /></para>
  <chapter eid="GAL 2" />
  <chapter number="3" style="c" sid="GAL 3" />
  <para style="s1">باوه‌ڕ یاخود شه‌ریعه‌ت؟</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1" />ئه‌ی دانیشتوانی بێ‌مێشكی غه‌ڵاتیه‌‏! كێ‌ جادووی لـێ‌كردوون؟ ئایا له‌پێش چاوتان وێنه‌ی عیسای مه‌سیح به‌ له‌خاچدراوی به‌ڕوونی نه‌كێشراوه‌؟ <verse eid="GAL 3:1" /><verse number="2" style="v" sid="GAL 3:2" />ته‌نها وه‌ڵامی ئه‌م پرسیاره‌م بده‌نه‌وه‌: ئایا ڕۆحی پیرۆزتان به‌هۆی كاركردن به‌شه‌ریعه‌ت وه‌رگرت، یاخود به‌هۆی باوه‌ڕتان به‌وه‌ی بیستتان؟ <verse eid="GAL 3:2" /><verse number="3" style="v" sid="GAL 3:3" />باشه‌ چۆن ده‌بێت ئه‌وه‌نده‌ بێ‌مێشك بن؟ ئه‌وه‌ی به‌ڕۆح ده‌ستتان پێ‌كرد، ئایا ئێستا به‌له‌ش كۆتایی پێ‌ده‌هێنن؟ <verse eid="GAL 3:3" /><verse number="4" style="v" sid="GAL 3:4" />‏ئایا ئازاركێشانتان بێ‌ سوود بوو؟ گه‌ر به‌ڕاستی بێ‌سوود بوو. <verse eid="GAL 3:4" /><verse number="5" style="v" sid="GAL 3:5" />ئایا ئه‌وه‌ی ڕۆحتان پێ‌ ده‌به‌خشێ‌و كاری سه‌رسوڕهێنه‌رتان لاده‌كات، ئه‌مه‌ به‌هۆی كاركردن به‌شه‌ریعه‌ته‌، یاخود به‌هۆی باوه‌ڕتان به‌وه‌ی بیستتان؟<verse eid="GAL 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6" />وه‌ك چۆن ئیبراهیم [[‏باوه‌ڕی به‌‏خودا هێنا، ئه‌مه‌ش به‌ ڕاست‎ودروستی بۆی دانرا.]] <verse eid="GAL 3:6" /><verse number="7" style="v" sid="GAL 3:7" />جا بزانن ئه‌وانه‌ی له‌سه‌ر ڕێگای باوه‌ڕ ده‌ڕۆن نه‌وه‌ی ئیبراهیمن. <verse eid="GAL 3:7" /><verse number="8" style="v" sid="GAL 3:8" />كتێبی پیرۆزیش پێشبینی ده‌كات، گه‌لان بێتاوان ده‌بن به‌هۆی باوه‌ڕ. خودا مزگێنی به‌ ئیبراهیم‏داو ووتی: [[‏به‌هۆی تۆوه‌ هه‌موو گه‌لان پیرۆز ده‌بن.]] <verse eid="GAL 3:8" /><verse number="9" style="v" sid="GAL 3:9" />كه‌واته‌ ئه‌وانه‌ی باوه‌ڕدارن پیرۆزبوون له‌گه‌ڵ ئیبراهیمی باوه‌ڕدار. ‏ <verse eid="GAL 3:9" /><verse number="10" style="v" sid="GAL 3:10" />هه‌موو ئه‌وانه‌ی پشت به‌كرداری شه‌ریعه‌ت ده‌به‌ستن، له‌ژێر نه‌فره‌ت دان، چونكه‌ له‌كتێبی پیرۆز نووسراوه‌: [[نه‌فره‌ت لێ‌كراوه‌ ئه‌وه‌ی له‌سه‌ر هه‌موو نووسراوه‌كانی شه‌ریعه‌ت ناچه‌سپێت‎و په‌یڕه‌ویان ناكات.]] <verse eid="GAL 3:10" /><verse number="11" style="v" sid="GAL 3:11" />ئه‌وه‌ش ئاشكرایه‌ كه‌س به‌شه‌ریعه‌ت له‌به‌رامبه‌ر خودا بێتاوان نابێت، چونكه‌ كتێبی پیرۆز ده‌ڵێ‌: [[ئه‌وه‌ی به‌ باوه‌ڕ بێ‌تاوان ده‌بێ‌، ده‌ژی.]] <verse eid="GAL 3:11" /><verse number="12" style="v" sid="GAL 3:12" />به‌ڵام شه‌ریعه‌ت پشت‎نابه‌ستێ‌ به‌ باوه‌ڕ، چونكه‌ كتێبی پیرۆز ده‌‏ڵێت: [[ئه‌وه‌ی كار به‌ڕاسپارده‌كانی شه‌ریعه‌ت بكات، به‌شه‌ریعه‌ت ده‌ژی.]] <verse eid="GAL 3:12" /><verse number="13" style="v" sid="GAL 3:13" />مه‌سیح ئێمه‌ی به‌خوێن كڕییه‌وه‌ له‌‏نه‌فره‌تی شه‌ریعه‌ت به‌وه‌ی بوو به‌نه‌فره‌ت لێكراو له‌پێناوی ئێمه‌، چونكه‌ نووسراوه‌: [[‏نه‌فره‌ت لـێكراوه‌ ئه‌وه‌ی له‌سه‌ر دار هه‌ڵبواسرێ‌]]. <verse eid="GAL 3:13" /><verse number="14" style="v" sid="GAL 3:14" />ئێمه‌ی به‌خوێن كڕیه‌وه‌ بۆ ئه‌وه‌ی پیرۆزی ئیبراهیم به‌هۆی عیسای مه‌سیح به‌میلله‌تانیش ببه‌خشرێ‌و به‌ڵێنی ڕۆح وه‌رگرین ئه‌وه‌ی به‌باوه‌ڕه‌.<verse eid="GAL 3:14" /></para>
  <para style="s1">په‌یمان‏و شه‌ریعه‌ت</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15" />ئه‌ی برایان، با نموونه‌یه‌كی مرۆڤانه‌تان بۆ بهێنمه‌وه‌، شتێكی ئاشكرایه‌ گه‌ر یه‌كێك په‌یمانێكی مۆركراوی پێ‌ بێ‌، یه‌كێكی تر ناتوانێ‌ به‌تاڵی بكاته‌وه‌ یاخود شتێكی بخاته‌ سه‌ر.<verse eid="GAL 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 3:16" />‏كاتێ‌ خودا به‌ڵێنیدا به‌ ئیبراهیم‏و نه‌وه‌كه‌ی، مه‌به‌ست له‌ ووشه‌ی نه‌وه‌كه‌ی ته‌نها مه‌سیحه‌ كه‌ شێوه‌ی تاكی هه‌یه‌، چونكه‌ نه‌یووتوه‌ نه‌وه‌كانی تا شێوه‌ی كۆمه‌ڵ وه‌رگرێ‌. <verse eid="GAL 3:16" /><verse number="17" style="v" sid="GAL 3:17" />‏مه‌به‌ستم ئه‌وه‌یه‌: ئه‌و شه‌ریعه‌ته‌ی دوای چوار‏سه‌دو سی ساڵ هات، پاش په‌یمانی خودا له‌گه‌ڵ ئیبراهیم، په‌یمانی چه‌سپاوی پێشووی خودا به‌تاڵ ناكاته‌وه‌، تاكو به‌ڵێنه‌كه‌ بشكێنێ‌. <verse eid="GAL 3:17" /><verse number="18" style="v" sid="GAL 3:18" />گه‌ر میراتی خودا به‌ شه‌ریعه‌ت بێ‌، ئیتر په‌یوه‌ندی به‌ به‌ڵێن نییه‌. به‌ڵام خودا به‌ به‌ره‌كه‌تی خۆی به‌ڵێنی به‌ ئیبراهیم‏داو كردی به‌ میراتگر.<verse eid="GAL 3:18" /></para>
  <para style="s1">مه‌به‌ستی شه‌ریعه‌ت</para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19" />كـه‌واته‌ شه‌ریعه‌ت بۆ چییه‌؟ خودا دایناوه‌ به‌هۆی پێشێلكاریه‌كان، كاریشی پێ‌كرا تا ئه‌و كاته‌ی نـه‌وه‌كــه‌ی ئیبراهیم هات، ئه‌وه‌ی خــودا بـه‌ڵێنـی پێــدابوو. ئه‌م شه‌ریعه‌ته‌ش له‌‏فریشته‌كانه‌وه‌ به‌هۆی په‌یوه‌ندیڕێكخه‌رێك بۆ ئێمه‌ هێنرا. <verse eid="GAL 3:19" /><verse number="20" style="v" sid="GAL 3:20" />هه‌ر چۆنێك بێ‌ په‌یوه‌ندیڕێكخه‌ر ته‌نها نوێنه‌ری یه‌ك لایه‌ن نییه‌، به‌ڵام خودا یه‌كه‌.<verse eid="GAL 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21" />ئایا ئه‌مه‌ ئه‌وه‌ ده‌گه‌یه‌نێ‌ شه‌ریعه‌ت دژی به‌ڵێنه‌كانی خودایه‌؟ نه‌خێر بێ‌گومان، چونكه‌ گه‌ر ئه‌و شه‌ریعه‌ته‌ی دراوه‌ به‌ مرۆڤ بیتوانیایه‌ ژیان ببه‌خشێ‌، ئه‌وا به‌ڕاستی بێتاوانی ‏به‌‏شه‌ریعه‌ت ده‌بوو. <verse eid="GAL 3:21" /><verse number="22" style="v" sid="GAL 3:22" />به‌ڵام كتێبی پیرۆز هه‌موو شتێكی كردۆته‌ دیلی گوناه‌، تا ئه‌و به‌ڵێنه‌ی به‌هۆی باوه‌ڕ دراوه‌ له‌عیسای مه‌سیح، بدرێ‌ به‌وانه‌ی باوه‌ڕ ده‌هێنن.<verse eid="GAL 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23" />پێش ئه‌وه‌ی باوه‌ڕمان بۆ بێت، له‌لایه‌ن شه‌ریعه‌ته‌وه‌ به‌ند‏كرا بووین، به‌به‌ستراوی مابووینه‌وه‌ تا ڕاگه‌یاندنی باوه‌ڕ. <verse eid="GAL 3:23" /><verse number="24" style="v" sid="GAL 3:24" />كه‌واته‌، تا هاتنی مه‌سیح شه‌ریعه‌ت ته‌مێكه‌رمان بوو، تاكو به‌باوه‌ڕ بێ‌تاوان بین، <verse eid="GAL 3:24" /><verse number="25" style="v" sid="GAL 3:25" />به‌ڵام ئێستا باوه‌ڕ هاتووه‌، ئێمه‌ ئیتر له‌ژێر سایه‌ی ته‌مێكه‌ر نین.<verse eid="GAL 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26" />چونكه‌ ئێوه‌ به‌هۆی باوه‌ڕ له‌‏عیسای مه‌سیحدا هه‌موو ڕۆڵه‌ی خودان. <verse eid="GAL 3:26" /><verse number="27" style="v" sid="GAL 3:27" />ئیتر مه‌سیحتان له‌به‌ركردووه‌، چونكه‌ به‌ناوی ئه‌وه‌وه‌ له‌ئاوهه‌ڵكێشراون. <verse eid="GAL 3:27" /><verse number="28" style="v" sid="GAL 3:28" />ئێستا جیاوازی نییه‌، گه‌ر جووله‌كه‌ یاخود یۆنانی، كۆیله‌ یاخود ئازاد، ژن یاخود پیاو‏بن، چونكه‌ هه‌مووتان یه‌كن له‌عیسای مه‌سیح. <verse eid="GAL 3:28" /><verse number="29" style="v" sid="GAL 3:29" />جا گه‌ر ئێوه‌ سه‌ر به‌ مه‌سیح بن، ئه‌وا له‌نه‌وه‌ی ئیبراهیمن‏، میراتگرن به‌پێی به‌ڵێنه‌كه‌.<verse eid="GAL 3:29" /></para>
  <chapter eid="GAL 3" />
  <chapter number="4" style="c" sid="GAL 4" />
  <para style="s1">كۆیله‌ نا، به‌ڵكو ڕۆڵه‌ی خودا</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1" />با پێتان بڵێم: گه‌ر میراتگر منداڵ بێت‎، له‌نێوان ئه‌و میراتگره‌و كۆیله‌یه‌ك هیچ ‏جیاوازی نییه‌، هه‌رچه‌نده‌ میراته‌كه‌ هه‌مووی هی ئه‌وه‌، <verse eid="GAL 4:1" /><verse number="2" style="v" sid="GAL 4:2" />چونكه‌ ده‌بێ‌ له‌ژێر ده‌سه‌ڵاتی سه‌رپه‌رشتیكارو بریكار بمێنێته‌وه‌، تاكو ئه‌و ماوه‌یه‌ ته‌واو ده‌بێ‌ كه‌ باوكی دایناوه‌. <verse eid="GAL 4:2" /><verse number="3" style="v" sid="GAL 4:3" />ئێمه‌ش به‌هه‌مان شێوه‌، كاتێ‌ منداڵ بووین كۆیله‌ی ده‌ستی هێزه‌كانی جیهان بووین، <verse eid="GAL 4:3" /><verse number="4" style="v" sid="GAL 4:4" />به‌ڵام كاتێ‌ ته‌واو بوونی زه‌مانه‌ هات، خودا ڕۆڵه‌ی خۆی [مه‌سیح] نارد بۆ لامان، له‌ ژنێك له‌دایك بوو، له‌ژێر سایه‌ی شه‌ریعه‌ت له‌دایك بوو، <verse eid="GAL 4:4" /><verse number="5" style="v" sid="GAL 4:5" />بۆ ئه‌وه‌ی ئه‌وانه‌ی له‌ژێر سایه‌ی شه‌ریعه‌تن به‌خوێن بیان كڕێته‌وه‌، تاكو خودا ئێمه‌ وه‌كو ڕۆڵه‌ی خۆی قبوڵ بكات. <verse eid="GAL 4:5" /><verse number="6" style="v" sid="GAL 4:6" />چونكه‌ ئێوه‌ ڕۆڵه‌ن، خودا ڕۆحی ڕۆڵه‌كه‌ی خۆی خسته‌ ناو دڵمانه‌وه‌، هاوار ده‌كه‌ین: (بابه‌! باوك!) <verse eid="GAL 4:6" /><verse number="7" style="v" sid="GAL 4:7" />كه‌واته‌ ئیتر ئێوه‌ كۆیله‌ نین، به‌ڵكو ڕۆڵه‌ن‏، هه‌روه‌ها چونكه‌ ئێوه‌ ڕۆڵه‌ن خودا ئێوه‌ی كرد به‌ میراتگر‏.‏</para>
  <para style="s1" vid="GAL 4:7">ئامۆژگاری پۆڵس بۆ غه‌ڵاتیه‌كان</para>
  <para style="p" vid="GAL 4:7">‏ <verse eid="GAL 4:7" /><verse number="8" style="v" sid="GAL 4:8" />ئه‌و كاته‌ی ئێوه‌ خوداتان نه‌ده‌ناسی، كۆیله‌ی ئه‌وانه‌ بوون كه‌ به‌سروشت خودا نین، <verse eid="GAL 4:8" /><verse number="9" style="v" sid="GAL 4:9" />به‌ڵام دوای ئه‌وه‌ی خوداتان ناسی، یاخود باشتره‌ بڵێن دوای ئه‌وه‌ی خودا ئێوه‌ی ناسی، چۆن ده‌بێ‌ جارێكی دیكه‌ بگه‌ڕێنه‌وه‌ لای لاوازیو هه‌ژاری ئه‌م جیهانه‌، بتانه‌وێ‌ ببنه‌‏وه‌ كۆیله‌ی ئه‌وانه‌ سه‌ر له‌نوێ‌؟ <verse eid="GAL 4:9" /><verse number="10" style="v" sid="GAL 4:10" />ئێوه‌ بایه‌خ ده‌ده‌ن به‌ ڕۆژو مانگ‏و ساڵ‏و وه‌رزی تایبه‌تی! <verse eid="GAL 4:10" /><verse number="11" style="v" sid="GAL 4:11" />له‌وه‌ ده‌ترسم به‌خۆڕایی ماندوو بووبم له‌پێناوتان.</para>
  <para style="p" vid="GAL 4:11">‏ <verse eid="GAL 4:11" /><verse number="12" style="v" sid="GAL 4:12" />ئه‌ی برایان داواتان لـێ‌ده‌كه‌م، خۆتان وه‌ك من لێ‏بكه‌ن، چۆن من خۆم وه‌كو ئێوه‌ لێ‏كردووه‌. ئێوه‌ هیچ هه‌ڵه‌تان نه‌كردووه‌ سه‌باره‌ت به‌ من، <verse eid="GAL 4:12" /><verse number="13" style="v" sid="GAL 4:13" />هه‌رچه‌نده‌ ده‌تانزانی من نه‌خۆش بووم كاتێ‌ یه‌كه‌مجار مزگێنیم پێ‌دان، <verse eid="GAL 4:13" /><verse number="14" style="v" sid="GAL 4:14" />نه‌خۆشیه‌كه‌م شتێكی ئاسان نه‌بوو بۆتان، له‌گه‌ڵ ئه‌وه‌شدا لێم بێزار نه‌بوون‏و خۆتان دوور نه‌خسته‌وه‌ لێم‎و هیچ خراپه‌یه‌كتان له‌گه‌ڵ نه‌كردم، به‌ڵكو پێشوازیتان لـێ‌كردم وه‌ك فریشته‌ی خودا، ‏وه‌ك عیسای مه‌سیح. <verse eid="GAL 4:14" /><verse number="15" style="v" sid="GAL 4:15" />ئه‌و خۆشیه‌تان چی لـێ‌هات؟ من شایه‌تیتان بۆ ده‌ده‌م گه‌ر بتان‏توانییایه‌، چاوی خۆتان ده‌رده‌هێناو ده‌تان‎دا پێم. <verse eid="GAL 4:15" /><verse number="16" style="v" sid="GAL 4:16" />ئایا ئێستا بووم به‌ دوژمنتان چونكه‌ ڕاستیتان پێ‌ده‌ڵێم؟<verse eid="GAL 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17" />هه‌ندێك خۆیان به‌دڵگه‌رم ده‌رده‌خه‌ن بۆ ئێوه‌، به‌ڵام نه‌ك به‌ نیازی باش، به‌ڵكو تا له‌ئێمه‌تان دووربخه‌نه‌وه‌و دڵگه‌رم بن بۆ ئه‌وان. <verse eid="GAL 4:17" /><verse number="18" style="v" sid="GAL 4:18" />ده‌رخستنی بایه‌خ پێ‌دان شتێكی جوانه‌، گه‌ر هه‌موو كاتێ‌ به‌مه‌به‌ستێكی پاك بێت، نه‌ك ته‌نها ئه‌و كاته‌ی من له‌گه‌ڵتاندام. <verse eid="GAL 4:18" /><verse number="19" style="v" sid="GAL 4:19" />منداڵه‌كانم، ئه‌ی ئه‌وانه‌ی ده‌بێ‌ له‌پێناوتان جارێكی دیكه‌ ئازار بچێژم، هه‌تا وێنه‌ی مه‌سیح له‌ژیانتان ده‌ركه‌وێ‌، <verse eid="GAL 4:19" /><verse number="20" style="v" sid="GAL 4:20" />چه‌ند حه‌زم ده‌كرد ئێستا له‌ناوتانا‏بم، تا به‌‏شێوه‌یه‌كی دیكه‌ له‌گه‌ڵتان بدوێم، چونكه‌ سه‌رم سوڕماوه‌ لێتان.<verse eid="GAL 4:20" /></para>
  <para style="s1">نموونه‌ی هاجه‌رو سارا</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21" />پێم بڵێن ئه‌ی ئه‌وانه‌ی حه‌ز ده‌كه‌ن له‌ژێر سایه‌ی شه‌ریعه‌ت بن، ئایا ئه‌وه‌ی له‌‏شه‌ریعه‌ت باسكراوه‌ نه‌تان‏بیستووه‌؟ <verse eid="GAL 4:21" /><verse number="22" style="v" sid="GAL 4:22" />چونكه‌ له‌‏كتێبی پیرۆز نووسراوه‌، ئیبراهیم دوو كوڕی هه‌بووه‌، یه‌كێكیان له‌‏هاجه‌ری كۆیله‌ بوو، ئه‌وی دیكه‌یان له‌‏سارای ژنی كه‌ ئازاد بوو. <verse eid="GAL 4:22" /><verse number="23" style="v" sid="GAL 4:23" />ئیبراهیم كوڕێكی له‌كۆیله‌كه‌ بوو به‌ پێی خواستی له‌ش، به‌ڵام له‌سارای ژنی كوڕێكی بوو به‌هۆی به‌ڵێن.</para>
  <para style="p" vid="GAL 4:23">‏ <verse eid="GAL 4:23" /><verse number="24" style="v" sid="GAL 4:24" />ئه‌م ڕاستیه‌ مانایه‌كی ڕه‌مزی هه‌یه‌. ئه‌و دوو ژنه‌ نموونه‌ی دوو په‌یمانن: یه‌كه‌م په‌یمان له‌ شاخی سینایه‌، منداڵی لێ‌ده‌بێت بۆ كۆیلایه‌تی ئه‌وه‌ش هاجه‌ره‌، <verse eid="GAL 4:24" /><verse number="25" style="v" sid="GAL 4:25" />هاجه‌ر به‌ شاخی سینا ده‌وترێ‌‏، له‌عه‌ره‌بستان ڕه‌مزێكه‌ بۆ قودسی ئێستا، ئه‌و له‌گه‌ڵ منداڵه‌كانی كۆیله‌ن. <verse eid="GAL 4:25" /><verse number="26" style="v" sid="GAL 4:26" />به‌ڵام قودسی ئاسمانی كه‌ دایكی هه‌موومانه‌ ئازاده‌، <verse eid="GAL 4:26" /><verse number="27" style="v" sid="GAL 4:27" />چونكه‌ له‌‏كتێبی پیرۆز نووسراوه‌:</para>
  <para style="p" vid="GAL 4:27">[[دڵشادبه‌ ئه‌ی نه‌زۆك،</para>
  <para style="p" vid="GAL 4:27">ئه‌ی ئه‌وه‌ی منداڵت نییه‌،</para>
  <para style="p" vid="GAL 4:27">‏به‌ده‌نگی به‌رز ستایشی خودا بكه‌،</para>
  <para style="p" vid="GAL 4:27">‏ئه‌ی ئه‌وه‌ی ژانی منداڵ‎بوون نازانی،</para>
  <para style="p" vid="GAL 4:27">چونكه‌ تۆ ئه‌ی ئه‌وه‌ی به‌ته‌نهای،</para>
  <para style="p" vid="GAL 4:27">‏ژماره‌ی منداڵه‌كانت زیاتره‌ له‌وه‌ی مێرده‌كه‌ی له‌گه‌ڵیه‌تی.]]<verse eid="GAL 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28" />به‌ڵام ئێوه‌ ئه‌ی برایان، ڕۆڵه‌ی به‌ڵێنن وه‌ك ئیسحاق. <verse eid="GAL 4:28" /><verse number="29" style="v" sid="GAL 4:29" />جا چۆن له‌سه‌رده‌می ڕابووردوو ئه‌وانه‌ی به‌پێی له‌ش له‌دایك بوون، ئه‌وانه‌یان ده‌چه‌وسانده‌وه‌ كه‌ به‌پێی ڕۆح له‌دایك بوون، ئێستاش هه‌مان‎شت ڕوو ده‌دات. <verse eid="GAL 4:29" /><verse number="30" style="v" sid="GAL 4:30" />‏كتێبی پیرۆز له‌م باره‌یه‌وه‌ ده‌ڵێ‌ چی؟ ده‌ڵێ‌: [[كۆیله‌كه‌ له‌گه‌ڵ كوڕه‌كه‌ی بكه‌ده‌ره‌وه‌، تا كوڕی كۆیله‌كه‌ میراتگر نه‌بێ‌ له‌گه‌ڵ كوڕی ئازاده‌كه‌.]] <verse eid="GAL 4:30" /><verse number="31" style="v" sid="GAL 4:31" />كه‌واته‌ ئه‌ی برایان ئێمه‌ ڕۆڵه‌ی كۆیله‌كه‌ نین، به‌ڵكو ڕۆڵه‌ی ئازاده‌كه‌ین.<verse eid="GAL 4:31" /></para>
  <chapter eid="GAL 4" />
  <chapter number="5" style="c" sid="GAL 5" />
  <para style="s1">ئازادی له‌ مه‌سیح‏</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1" />چونكه‌ مه‌سیح ئازادیكردین تا به‌ ئازادی بژین. بۆیه‌ خۆتان ڕاگرن‏و جارێكی دیكه‌ ملكه‌چی نیری كۆیله‌یی مه‌بن.<verse eid="GAL 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2" />‏ئاگاداربن، من پۆڵسم پێتان ده‌ڵێم: به‌‏خه‌ته‌نه‌كردنتان مه‌سیح هیچ سوودێكی نابێ‌ بۆتان. <verse eid="GAL 5:2" /><verse number="3" style="v" sid="GAL 5:3" />جارێكی كه‌ش ڕوونی ده‌كه‌مه‌وه‌، ئه‌وه‌ی خه‌ته‌نه‌ ده‌كات، ده‌بێ‌ له‌سه‌ر هه‌موو خاڵه‌كانی شه‌ریعه‌ت بڕوات. <verse eid="GAL 5:3" /><verse number="4" style="v" sid="GAL 5:4" />ئه‌ی ئه‌وه‌ی ده‌ته‌وێ‌ به‌هۆی شه‌ریعه‌ت بێ‌تاوان بێت، تۆ له‌‏مه‌سیح جیابوویته‌وه‌‏و سه‌باره‌ت به‌ به‌ره‌كه‌تی خودا كه‌وتیت. <verse eid="GAL 5:4" /><verse number="5" style="v" sid="GAL 5:5" />چونكه‌ به‌هۆی ڕۆح كه‌ له‌باوه‌ڕه‌وه‌یه‌ چاوه‌ڕوانی هیوای ڕاست‏ودروستیین، <verse eid="GAL 5:5" /><verse number="6" style="v" sid="GAL 5:6" />چونكه‌ له‌عیسای مه‌سیح خه‌ته‌نه‌كراو و خه‌ته‌نه‌ نه‌كراو سوودیان نییه‌، ته‌نها باوه‌ڕ نه‌بێ‌ كه‌ به‌هۆی خۆشه‌ویستی كار ده‌كات.</para>
  <para style="p" vid="GAL 5:6">‏ <verse eid="GAL 5:6" /><verse number="7" style="v" sid="GAL 5:7" />ئێوه‌ له‌پێشا زۆر باش ڕاتان ده‌كرد، كێ‌ ڕێی پێ‌گرتن تا ملكه‌چی ڕاستی نه‌بن؟ <verse eid="GAL 5:7" /><verse number="8" style="v" sid="GAL 5:8" />ئه‌و هاندانه‌ له‌لایه‌ن خوداوه‌ نییه‌ كه‌بانگی ئێوه‌ی كردووه‌. <verse eid="GAL 5:8" /><verse number="9" style="v" sid="GAL 5:9" />سه‌یركه‌ن هه‌ویرترشێكی بچووكه‌، هه‌موو هه‌ویره‌كه‌ هه‌ڵ‎ده‌هێنێ‌. <verse eid="GAL 5:9" /><verse number="10" style="v" sid="GAL 5:10" />به‌ڵام باوه‌ڕم هه‌یه‌ له‌خوداوه‌ند، كه‌وا ئێوه‌ بیروڕایه‌كی تر وه‌رناگرن. جا ئه‌وه‌ی بیه‌وێ‌ له‌ناوتان ببێته‌ كۆسپ، هه‌ر كه‌سێك بێ‌ سزای خۆی وه‌رده‌گرێ‌. <verse eid="GAL 5:10" /><verse number="11" style="v" sid="GAL 5:11" />به‌ڵام ئه‌ی برایان، گه‌ر من خه‌ته‌نه‌كردن ڕاده‌گه‌ێنم، ئیتر بۆچی جووله‌كه‌كان تا ئێستا ده‌مچه‌وسێننه‌وه‌؟ كه‌واته‌ كۆسپی خاچ لادراوه‌. <verse eid="GAL 5:11" /><verse number="12" style="v" sid="GAL 5:12" />ئه‌و كه‌سانه‌ی ڕێگای باوه‌ڕتان لـێ‌تێك ده‌ده‌ن، با ببڕێنه‌وه‌.<verse eid="GAL 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13" />برایان‏، ئێوه‌ بانگ كران بۆ ئازادی، به‌ڵام ئازادی مه‌كه‌ن به‌ هه‌ل بۆ ڕازی‏كردنی له‌ش، له‌‏جیاتی ئه‌وه‌ به‌ خۆشه‌ویستی خزمه‌تی یه‌كتری بكه‌ن. <verse eid="GAL 5:13" /><verse number="14" style="v" sid="GAL 5:14" />چونكه‌ شه‌ریعه‌ت هه‌مووی له‌یه‌ك ڕاسپارده‌دا ته‌واو ده‌بێ‌: [[ئه‌وه‌ی لێت نزیكه‌ وه‌ك خۆت خۆشت بوێ‌‏]] <verse eid="GAL 5:14" /><verse number="15" style="v" sid="GAL 5:15" />ئه‌گه‌ر ئێوه‌ له‌‏ڕابوردوو په‌لاماری یه‌كترتان ده‌داو ڕاوی یه‌كترتان ده‌كرد، ئێستا ئاگاداربن یه‌كتری له‌‏ناونه‌به‌ن.<verse eid="GAL 5:15" /></para>
  <para style="s1">ژیان له‌ڕۆحی پیرۆز</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16" />‏مه‌به‌ستم ئه‌وه‌یه‌ پێتان بڵێم: با ژیانتان به‌ڕۆحی پیرۆز به‌ڕیۆه‌ بچێ‌‏، هه‌روه‌ها ئاره‌زووه‌كانی له‌ش تێر مه‌كه‌ن. <verse eid="GAL 5:16" /><verse number="17" style="v" sid="GAL 5:17" />چونكه‌ خواستی له‌ش دژی ڕۆحه‌، هه‌ر‏وه‌ها خواستی ڕۆح دژی له‌شه‌. هه‌ریه‌كه‌یان به‌ربه‌ره‌كانی ئه‌ویتر ده‌كات‏، تا ئه‌وه‌ نه‌كه‌ن كه‌ ده‌تانه‌وێ‌. <verse eid="GAL 5:17" /><verse number="18" style="v" sid="GAL 5:18" />به‌ڵام گه‌ر ئێوه‌ ڕۆح به‌ڕێوه‌تان ببات، ئه‌وا‏ له‌ژێر سایه‌ی شه‌ریعه‌ت نین.<verse eid="GAL 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19" />كرداره‌كانی له‌ش دیارن: داوێن‎پیسی، گڵاوی، به‌دڕه‌وشتی، <verse eid="GAL 5:19" /><verse number="20" style="v" sid="GAL 5:20" />بت‎په‌رستی، جادوگه‌ری، دوژمنایه‌تی، شه‌ڕنانه‌وه‌، دڵگه‌رمی بۆ خراپه‌، تووڕه‌بوون، خۆپه‌رستی، دووبه‌ره‌كی، ناكۆكی، <verse eid="GAL 5:20" /><verse number="21" style="v" sid="GAL 5:21" />چاوپیسی، سه‌رخۆشی، ڕابواردن، هتد‏... ئێستا ئاگادارتان ده‌كه‌مه‌وه‌، هه‌روه‌ك چۆن له‌پێشا ئاگادارم كردوون، ئه‌وانه‌ی ئه‌و كارانه‌ ده‌كه‌ن میراتگری پادشاهێتی خودا نین. <verse eid="GAL 5:21" /><verse number="22" style="v" sid="GAL 5:22" />به‌ڵام به‌رووبوومی ڕۆح بریتییه‌ له‌: خۆشه‌ویستیو خۆشی‏و ئاشتی، ئارام‏گرتن، ڕۆح سووكیو چاكه‌، باوه‌ڕ، <verse eid="GAL 5:22" /><verse number="23" style="v" sid="GAL 5:23" />نیانی‏و خۆڕاگرتن. هیچ شه‌ریعه‌تێكیش نییه‌ دژی ئه‌م شتانه‌ بێ‌. <verse eid="GAL 5:23" /><verse number="24" style="v" sid="GAL 5:24" />‏ئه‌وانه‌ی سه‌ر به‌ عیسای مه‌سیحن، خواست‏و ئاره‌زووه‌كانی له‌شیان له‌خاچداوه‌. <verse eid="GAL 5:24" /><verse number="25" style="v" sid="GAL 5:25" />گه‌ر ئێمه‌ به‌پێی ڕۆحی پیرۆز بژین، له‌سه‌رمانه‌ به‌ڕێگای ڕۆحی پیرۆز بڕۆین. <verse eid="GAL 5:25" /><verse number="26" style="v" sid="GAL 5:26" />با له‌خۆبایی نه‌بین، ڕق‏وكینه‌مان نه‌بێ‌ له‌گه‌ڵ یه‌كتری، چاوپیس نه‌بین له‌گه‌ڵ یه‌كتری.<verse eid="GAL 5:26" /></para>
  <chapter eid="GAL 5" />
  <chapter number="6" style="c" sid="GAL 6" />
  <para style="s1">باری یه‌كتری هه‌ڵگرن</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1" />ئه‌ی برایان، گه‌ر یه‌كێكتان كه‌وته‌ هه‌ڵه‌وه‌، با ئێوه‌ی ڕۆحی، ڕاستی بكه‌نه‌وه‌ به‌ شێوه‌یه‌كی نه‌رم. تۆش ئاگاداری خۆت به‌، نه‌وه‌ك بكه‌ویته‌ تاقی‏كردنه‌وه‌. <verse eid="GAL 6:1" /><verse number="2" style="v" sid="GAL 6:2" />باری یه‌كتری هه‌ڵگرن، به‌م شێوه‌یه‌ شه‌ریعه‌تی مه‌سیح ته‌واو ده‌كه‌ن. <verse eid="GAL 6:2" /><verse number="3" style="v" sid="GAL 6:3" />ئه‌گه‌ر یه‌كێك واسه‌یری خۆی كرد شتێكی گرنگه‌، به‌ڵام له‌ ڕاستیدا هیچ نه‌بێ‌، ئه‌وا ئه‌و كه‌سه‌ خۆی ده‌خڵه‌تێنێ‌. <verse eid="GAL 6:3" /><verse number="4" style="v" sid="GAL 6:4" />باهه‌ر یه‌كه‌ كرداره‌كانی تاقیبكاته‌وه‌، ئینجا با شانازیكردنی ته‌نها به‌خۆی بێ‌ نه‌ك به‌نزیكه‌كه‌ی، <verse eid="GAL 6:4" /><verse number="5" style="v" sid="GAL 6:5" />چونكه‌ هه‌ر كه‌س باری خۆی هه‌ڵده‌گرێ‌.<verse eid="GAL 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6" />ئه‌وه‌ی ووشه‌ی خودای فێرده‌كرێ‌، له‌سه‌ر‏یه‌تی فێركه‌ره‌كه‌ی به‌شدار بكات له‌هه‌موو شتێكی باش كه‌ هه‌یه‌تی.<verse eid="GAL 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 6:7" />خۆتان هه‌ڵمه‌خه‌ڵه‌تێنن، خودا فێڵی لـێ‌ ناكرێت، چونكه‌ ئه‌وه‌ی ڕواندووتانه‌، هه‌مان شت دروێنه‌ ده‌كه‌ن. <verse eid="GAL 6:7" /><verse number="8" style="v" sid="GAL 6:8" />چونكه‌ ئه‌وه‌ی بۆ له‌شی خۆی بڕوێنێ‌ له‌ له‌شیدا گڵاوی دروێنه‌ ده‌كات، به‌ڵام ئه‌وه‌ی بۆ ڕۆح بڕوێنێ‌ له‌ڕۆحه‌وه‌ ژیانی هه‌تاهه‌تایی دروێنه‌ ده‌كات. <verse eid="GAL 6:8" /><verse number="9" style="v" sid="GAL 6:9" />كه‌واته‌ با له‌‏كاری چاكه‌ نه‌كه‌وین، چونكه‌ گه‌ر ووره‌ به‌رنه‌ده‌ین له‌كاتی خۆی دروێنه‌ی زۆر ده‌كه‌ین. <verse eid="GAL 6:9" /><verse number="10" style="v" sid="GAL 6:10" />جا تا ده‌رفه‌تمان هه‌یه‌، با چاكه‌ له‌گه‌ڵ هه‌موو كه‌سێك بكه‌ین، به‌‏تایبه‌تی له‌گه‌ڵ خوشك‏و برایانی باوه‌رداڕ.<verse eid="GAL 6:10" /></para>
  <para style="s1">بوونه‌وه‌رێكی نوێ‌</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11" />سه‌یركه‌ن، ئه‌و پیته‌ گه‌ورانه‌ی ئێستا ده‌یخوێننه‌وه‌، من به‌ده‌ستی خۆم نووسیومه‌.</para>
  <para style="p" vid="GAL 6:11">‏ <verse eid="GAL 6:11" /><verse number="12" style="v" sid="GAL 6:12" />ئه‌وانه‌ی ده‌یانه‌وێ‌ به‌ڕواڵه‌ت خۆیان به‌‏چاك نیشان بده‌ن، هه‌وڵ ده‌ده‌ن ناچارتان بكه‌ن خۆتان خه‌ته‌نه‌ بكه‌ن، ‏تاوه‌كو تووشی چه‌وسانه‌وه‌ نه‌بن به‌هۆی خاچی مه‌سیحه‌وه‌. <verse eid="GAL 6:12" /><verse number="13" style="v" sid="GAL 6:13" />چونكه‌ ئه‌و خه‌ته‌نه‌كراوانه‌ خۆیان به‌پێی شه‌ریعه‌ت هه‌ڵسوكه‌وت ناكه‌ن، به‌ڵكو ده‌یانه‌وێ‌ ئێوه‌ خه‌ته‌نه‌بكرێن، هه‌تا شكۆمه‌ندیان ده‌سكه‌وێ‌ به‌ له‌شی ئێوه‌. <verse eid="GAL 6:13" /><verse number="14" style="v" sid="GAL 6:14" />به‌ڵام هیچ شكۆمه‌ندیه‌كم ناوێت گه‌ر له‌‏خاچی عیسای مه‌سیحی خوداوه‌ندمان نه‌بێ‌، كه‌ به‌هۆی ئه‌وه‌وه‌ جیهان سه‌باره‌ت به‌ من له‌خاچدراوه‌، هه‌روه‌ها منیش سه‌باره‌ت به‌ جیهان له‌خاچدراوم. <verse eid="GAL 6:14" /><verse number="15" style="v" sid="GAL 6:15" />گرنگ نییه‌ مرۆڤ خه‌ته‌نه‌كرا بێت یاخود خه‌ته‌نه‌ نه‌كرا بێ‌، به‌ڵكو بووبێ‌ به‌ بوونه‌وه‌رێكی نوێ‌. <verse eid="GAL 6:15" /><verse number="16" style="v" sid="GAL 6:16" />با ئاشتیو به‌زه‌یی بۆ هه‌موو ئه‌وانه‌ بێ‌ كه‌ دوای ئه‌م یاسایه‌ كه‌وتوون، هه‌روه‌ها بۆ هه‌موو ئیسرائیلی خودا.<verse eid="GAL 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17" />‏ئیتر له‌مه‌ولا گیروگرفتی ترم بۆ مه‌هێننه‌كایه‌وه‌، چونكه‌ له‌له‌شمدا هێماكانی عیسام هه‌ڵگرتووه‌.</para>
  <para style="p" vid="GAL 6:17">‏ <verse eid="GAL 6:17" /><verse number="18" style="v" sid="GAL 6:18" />خوشك‏و برایان‏، ئیتر با‏به‌ره‌كه‌تی عیسای مه‌سیحی خوداوه‌ندمان له‌گه‌ڵ ڕۆحتان بێت. ئامین.<verse eid="GAL 6:18" /></para>
  <chapter eid="GAL 6" />
</usx>