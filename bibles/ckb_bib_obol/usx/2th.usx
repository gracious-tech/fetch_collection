<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TH" style="id">- Biblica® Open Sorani Kurdish Book of Life</book>
  <para style="rem">‪Copyright © 1998 by Biblica, Inc.</para>
  <para style="h">دووەم سالۆنیکی</para>
  <para style="toc1">دووهه‌م نامه‌ی پۆڵس بۆ باوه‌ڕدارانی ته‌سالۆنیكی</para>
  <para style="toc2">دووەم سالۆنیکی</para>
  <para style="toc3">دووەم سالۆنیکی</para>
  <para style="mt1">دووهه‌م نامه‌ی پۆڵس بۆ باوه‌ڕدارانی ته‌سالۆنیكی</para>
  <chapter number="1" style="c" sid="2TH 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1" />له‌ پۆڵس‏و سیلوانس‏و تیمۆساوسه‌وه‌ بۆ كۆمه‌ڵه‌ی باوه‌ڕدارانی ته‌سالۆنیكی له‌خودای باوك‏و عیسای مه‌سیحی خوداوه‌ندمان. <verse eid="2TH 1:1" /><verse number="2" style="v" sid="2TH 1:2" />با به‌ره‌كه‌ت‎و ئاشتی خودای باوك‏و عیسای مه‌سیحی خوداوه‌ند له‌گه‌ڵتان بێ.<verse eid="2TH 1:2" /></para>
  <para style="s1">سوپاس‏و نوێژكردن</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3" />ئه‌ی برایان پێویسته‌ هه‌موو كاتێ‌ له‌پێناوی ئێوه‌دا سوپاسی خودا بكه‌ین، هـه‌روه‌ك پێویسته‌، چونكه‌ باوه‌ڕتان زۆر له‌په‌ره‌سه‌ندن‏دایه‌، هه‌روه‌ها خۆشه‌ویستیتان له‌گه‌ڵ یه‌كــتری له‌زیاد بوون دایه‌، <verse eid="2TH 1:3" /><verse number="4" style="v" sid="2TH 1:4" />ته‌نانه‌ت ئێمه‌ خۆشمان، له‌ كۆمه‌ڵه‌كــانی خـودا شانازی ده‌كه‌ین به‌باوه‌ڕو به‌‏خۆراگرتنتان به‌رامبه‌ر به‌و چه‌وسانه‌وه‌و ناخــۆشیانه‌ی به‌رگــه‌ی ده‌گـرن.<verse eid="2TH 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 1:5" />ئه‌مه‌ نیشانه‌یه‌ بۆ حوكمی دادپه‌روه‌رانه‌ی خودا، كه‌ ئێوه‌ شیاوی پادشاهێتی ئه‌ون. ئه‌وه‌ی له‌پێناویدا تووشی ئازاردان بوون. <verse eid="2TH 1:5" /><verse number="6" style="v" sid="2TH 1:6" />لای خودا شتێكی دادپه‌روه‌رانه‌یه‌، ئازاری ئه‌وانه‌ بدات كه‌ ئازارتان ده‌ده‌ن، <verse eid="2TH 1:6" /><verse number="7" style="v" sid="2TH 1:7" />له‌گه‌ڵ ئێمه‌ حه‌سانه‌وه‌ به‌ئێوه‌ش ببه‌خشی كه‌ ئێستا له‌‏ناخۆشیدان‏، كاتێ‌ عیسای خوداوه‌ند له‌ئاسمان ئاشكرا ده‌كرێ‌ له‌گه‌ڵ فریشته‌ به‌تواناكانی له‌‏ئاگرێكی گڕدار، <verse eid="2TH 1:7" /><verse number="8" style="v" sid="2TH 1:8" />سزای تۆڵه‌ ده‌دات به‌سه‌ر هه‌موو ئه‌وانه‌ی خودا ناناسن‎و گوێڕایه‌ڵی مزگێنی عیسای خوداوه‌ند نابن، <verse eid="2TH 1:8" /><verse number="9" style="v" sid="2TH 1:9" />سزای ئه‌وانه‌ له‌ناوچوونی هه‌تاهه‌تاییه‌، ده‌ركردنیانه‌ له‌به‌ر ڕووی خوداوه‌ندو بێ‌به‌ش بوونه‌ له‌‏شكۆو توانای ئه‌و. <verse eid="2TH 1:9" /><verse number="10" style="v" sid="2TH 1:10" />كاتێ‌ عیسا ده‌گه‌ڕێته‌وه‌، له‌و ڕۆژه‌دا ستایشی ده‌كرێ‌ له‌لایه‌ن خوشك‏و برا پیرۆزه‌كانی، ده‌بێته‌ مایه‌ی سه‌رسوڕمان له‌لای ئه‌وانه‌ی باوه‌ڕیان هێناوه‌، چونكه‌ شایه‌تیمان لای ئێوه‌ باوه‌ڕپێكراو ده‌بێت. <verse eid="2TH 1:10" /><verse number="11" style="v" sid="2TH 1:11" />بۆیه‌ هه‌مـوو كــاتێك نوێژتان بــۆ ده‌كـه‌ین‏و داوا له‌‏خــودا ده‌كه‌ین تا شـایسته‌ بن بۆ بانگـه‌وازه‌كه‌ی‏و چی ئاره‌زووی چاك‏و كـردارێكتان هــه‌یــه‌ كــه‌ له‌بــاوه‌ڕ سه‌رچاوه‌ ده‌گرێ‌ بـه‌تـواناوه‌ جێ‌به‌جێی بكات. <verse eid="2TH 1:11" /><verse number="12" style="v" sid="2TH 1:12" />تا ناوی عیسای خــوداوه‌ند له‌ناوتان شكۆدار بێت‏و ئێوه‌ش شكۆداربن له‌ئه‌و به‌گوێره‌ی به‌ره‌كـه‌تی خودامان‏و عیسای مه‌سیحی خوداوه‌ند.<verse eid="2TH 1:12" /></para>
  <para style="s1">ڕۆڵه‌ی یاخیبوو<note caller="+" style="f"><char style="fr" closed="false">2‏:0 </char><char style="ft" closed="false">ڕۆڵه‌ی یاخیبوون: سه‌رۆكی هێزه‌كانی خراپه‌یه‌ له‌ كۆتایی زه‌مانه‌. </char></note></para>
  <chapter eid="2TH 1" />
  <chapter number="2" style="c" sid="2TH 2" />
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1" />له‌باره‌ی هاتنه‌وه‌ی عیسای مه‌سیحی خوداوه‌ندمان‏و بوونمان به‌یه‌ك له‌گه‌ڵ ئه‌و، شتێك هه‌یه‌ برایانی خۆشه‌ویست داواتان لـێ‌ ده‌كه‌ین، <verse eid="2TH 2:1" /><verse number="2" style="v" sid="2TH 2:2" />خێرا بیرتان مه‌گۆڕن‏و مه‌ترسن به‌هۆی ڕۆحێك یان بیستنی قسه‌یه‌ك یان په‌یامێك خرابێته‌ پاڵ ئێمه‌‏، وا ده‌ریخات گوایه‌ ڕۆژی خوداوه‌ند هاتووه‌. <verse eid="2TH 2:2" /><verse number="3" style="v" sid="2TH 2:3" />به‌هیچ شێوه‌یه‌ك ڕێگا مه‌ده‌ن به‌كه‌س هه‌ڵتانخه‌ڵه‌تێنێ‌، چـونكه‌ پێش ئه‌وه‌ی ئه‌و ڕۆژه‌ بێت، ده‌بێ‌ له‌پێشا گومڕایی بڵاوبێته‌وه‌و ڕۆڵه‌ی یاخیبوون<note caller="+" style="f"><char style="fr" closed="false">2‏:3 </char><char style="ft" closed="false">ڕۆڵه‌ی یاخیبوون: سه‌رۆكی هێزه‌كانی خراپه‌یه‌ له‌ كۆتایی زه‌مانه‌. </char></note> ده‌ربكه‌وێ‌ كه‌ چاره‌نووسی له‌ناوچوونه‌. <verse eid="2TH 2:3" /><verse number="4" style="v" sid="2TH 2:4" />ئه‌وه‌ی به‌رهه‌ڵستی ده‌كات‏و خۆی به‌رزده‌كاته‌وه‌ به‌ســه‌ر ئه‌وه‌ی هـه‌مـوو خه‌ڵكی پێی ده‌ڵێن خودا یاخـود په‌رستن‏و گوێڕایه‌ڵی خودا. ته‌نانه‌ت له‌ په‌رستگای خودا داده‌نیشێت‏و هه‌وڵ ده‌دات بیسه‌لمێنێ‌ كه‌وا ئه‌و خودایه‌. <verse eid="2TH 2:4" /><verse number="5" style="v" sid="2TH 2:5" />لـه‌یادتان نییه‌ من ئه‌و شتانه‌م پێ‌ ووتن كــاتێ‌ لاتان بووم؟ <verse eid="2TH 2:5" /><verse number="6" style="v" sid="2TH 2:6" />ئێوه‌ ده‌زانن چی ناهێڵێ‌ ئه‌و ڕۆڵه‌ یاخــیبووه‌ ئێستا ده‌ربكـه‌وێ‌، هه‌تا له‌و كاته‌ی بۆی دیاریكـراوه‌ ده‌ربكـه‌وێ‌. <verse eid="2TH 2:6" /><verse number="7" style="v" sid="2TH 2:7" />نهێنی ئه‌و یاخـی‏بوونه‌ ئێستا له‌كاردایه‌، ته‌نها ئه‌وه‌نده‌ی به‌سه‌ ئه‌و به‌ربه‌سته‌ لاچێت، <verse eid="2TH 2:7" /><verse number="8" style="v" sid="2TH 2:8" />ئه‌وسا ڕۆڵه‌ی یاخیبوون به‌ ئاشكرا ده‌رده‌كه‌وێ‌، ئیتر خــوداوه‌نــد بــه‌‏هـه‌نــاســه‌یه‌كی ده‌مـی خــۆی لــه‌نــاوی ده‌بـــات‏و به‌ ده‌ركه‌وتنی شكۆی هاتنه‌وه‌ی كۆتایی پێ‌ ده‌هێنێت. <verse eid="2TH 2:8" /><verse number="9" style="v" sid="2TH 2:9" />ده‌ركه‌وتنی ئه‌و یاخیبووه‌ به‌هۆی چالاكی شه‌یتان ده‌بێت، هه‌موو هێزو نیشانه‌و كاری سه‌رسوڕهێنه‌ری درۆ و دروست‎كراوی له‌گه‌ڵ ده‌بێت، <verse eid="2TH 2:9" /><verse number="10" style="v" sid="2TH 2:10" />هه‌موو جۆره‌ فێڵێك به‌كار ده‌هێنێت تا له‌ناوچووان بخه‌ڵه‌تێنێت، چونكه‌ ئه‌وان خوشه‌ویستی ڕاستیان ڕه‌تكرده‌وه‌، ئه‌وه‌ی ڕزگاری ئه‌وانی تیادایه‌. <verse eid="2TH 2:10" /><verse number="11" style="v" sid="2TH 2:11" />له‌به‌رئه‌وه‌ خودا چه‌واشه‌ی گه‌وره‌یان بۆ ده‌نێرێت، تا باوه‌ڕ به‌ درۆ بكه‌ن، <verse eid="2TH 2:11" /><verse number="12" style="v" sid="2TH 2:12" />به‌مه‌ش تاوانبار ده‌كرێن ئه‌وانه‌ی باوه‌ڕ به‌راستی ناكه‌ن‏، به‌ڵكو حه‌ز له‌خراپه‌ ده‌كه‌ن.<verse eid="2TH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13" />به‌ڵام ئێمه‌ ئه‌ی برایانی خۆشه‌ویستی خوداوه‌ند، هه‌موو كاتێ‌ ده‌بێ‌ سوپاسی خودا بكه‌ین له‌‏پێناوتان، چونكه‌ خودا له‌سه‌ره‌تاوه‌ ئێوه‌ی هه‌ڵبژاردووه‌، تا ڕزگارتان بكات به‌ پاك‎و پیرۆزكـردنی ڕۆح‎و باوه‌ڕكردنی ڕاستی. <verse eid="2TH 2:13" /><verse number="14" style="v" sid="2TH 2:14" />بۆ ئه‌مه‌ خودا بانگی كردوون به‌هۆی مــزگێنیمان، تاكو به‌شتان هه‌بێ‌ له‌شكۆمه‌ندی عیسای مه‌سیحی خوداوه‌ندمان. <verse eid="2TH 2:14" /><verse number="15" style="v" sid="2TH 2:15" />كه‌واته‌ ئه‌ی برایان چه‌سپاوبن له‌‏باوه‌ڕ، له‌سه‌ر ئه‌و فێركردنانه‌ بڕۆن كه‌ له‌‏ئێمه‌ وه‌رتان‏گرتووه‌، گه‌ر پێمان ووتبن یان بۆمان نووسی بن.<verse eid="2TH 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 2:16" />باعیسای مه‌سیحی خــوداوه‌ندمان خۆی له‌گه‌ڵ خودای باوكمان، ئه‌وه‌ی خۆشیویستین‏و دڵنه‌وایی‏و هیوای هه‌تاهه‌تایی به‌ به‌ره‌كه‌ت پێ‌ به‌خشین، <verse eid="2TH 2:16" /><verse number="17" style="v" sid="2TH 2:17" />ووره‌تان به‌رز بكاته‌وه‌و به‌هێزتان بكات له‌‏هه‌موو قسه‌‏و كردارێكی چاك.<verse eid="2TH 2:17" /></para>
  <chapter eid="2TH 2" />
  <chapter number="3" style="c" sid="2TH 3" />
  <para style="s1">داوای نوێژكردن</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1" />له‌كۆتاییدا ئه‌ی برایان، نوێژمان بۆ بكه‌ن، لێره‌ش ووشه‌ی خوداوه‌ند ڕێچكه‌ی خۆی وه‌رگرێ‌و شكۆدار بێت وه‌ك لای ئێوه‌. <verse eid="2TH 3:1" /><verse number="2" style="v" sid="2TH 3:2" />هه‌روه‌ها بمانپارێزێت له‌‏مرۆڤی به‌دو خراپ، چونكه‌ باوه‌ڕهێنان به‌شی هه‌موو كه‌س نییه‌. <verse eid="2TH 3:2" /><verse number="3" style="v" sid="2TH 3:3" />به‌ڵام خودا‏وه‌ند پشتی پێ‌ ده‌به‌سترێ‌، به‌هێزتان ده‌كات‏و ده‌تانپارێزێ‌ له‌‏خراپه‌. <verse eid="2TH 3:3" /><verse number="4" style="v" sid="2TH 3:4" />به‌هۆی خوداوه‌ند باوه‌ڕمان پێتان هه‌یه‌ ئه‌وه‌ی ڕامانسپاردوون كارتان پێ‌كــردووه‌و كـاری پێ‌ده‌كه‌ن. <verse eid="2TH 3:4" /><verse number="5" style="v" sid="2TH 3:5" />با خوداوه‌ند خـۆشـه‌ویستی خـوداو ئارام‏گـرتنی مه‌سیحتان‏ بخاته‌ دڵ.<verse eid="2TH 3:5" /></para>
  <para style="s1">ئاگاداری بۆ ته‌مبه‌ڵه‌كان</para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6" />ئه‌ی برایان به‌ناوی ‏عیسای مه‌سیحی خــوداوه‌ندمــان فه‌رمانتان پێ‌ ده‌ده‌ین، دووربكـه‌ونه‌وه‌ له‌و خوشك‏و برایانه‌ی به‌‏ته‌مبه‌ڵی ده‌ژین، به‌پێچه‌وانه‌ی ئه‌و فێركردنانه‌ی له‌ئێمه‌ وه‌ریان‏گـرتووه‌. <verse eid="2TH 3:6" /><verse number="7" style="v" sid="2TH 3:7" />ئێوه‌ باش ده‌زانن چۆن ده‌بێ‌ ئێمه‌ بكه‌ن به‌نموونه‌ بۆ خۆتان، چونكه‌ ئێمه‌ ته‌مبه‌ڵ نه‌بووین كاتێ‌ له‌ناوتان بووین، <verse eid="2TH 3:7" /><verse number="8" style="v" sid="2TH 3:8" />هیچ نانێكمان به‌خۆڕایی لای كه‌س نه‌خواردووه‌، به‌ڵكو شه‌و و ڕۆژ ڕه‌نجمان‏داوه‌و ماندووبووین تا نه‌بین به‌قورسایی به‌سه‌ر كه‌ستان. <verse eid="2TH 3:8" /><verse number="9" style="v" sid="2TH 3:9" />ئه‌مه‌ش ئه‌وه‌ ناگه‌یه‌نێ‌‏ مافی ئه‌وه‌مان نییه‌، به‌ڵكو بۆ ئه‌وه‌ی خۆمان بكه‌ین به‌نموونه‌ بۆتان تا له‌سه‌ر ڕێگای ئێمه‌ بڕۆن. <verse eid="2TH 3:9" /><verse number="10" style="v" sid="2TH 3:10" />كاتێ‌ له‌ناوتان بووین ئه‌م ڕاسپارده‌یه‌مان پێتان‏داوه‌: (ئه‌وه‌ی كار نه‌كات ناخوات.)<verse eid="2TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 3:11" />چونكه‌ بیستوومانه‌ هه‌ندێك له‌ناوتان به‌ته‌مبه‌ڵی ده‌ژین‏و هیچ كارێك ناكه‌ن، ده‌ست له‌كاروباری خه‌ڵكی وه‌رده‌ده‌ن. <verse eid="2TH 3:11" /><verse number="12" style="v" sid="2TH 3:12" />ئه‌وانه‌ به‌ناوی عیسای مه‌سیحی خوداوه‌ند فه‌رمانیان پێ‌ ده‌ده‌ین‏و ئاگاداریان ده‌كه‌ینه‌وه‌، به‌بێ‌ده‌نگی كار بكه‌ن‏و نانی خۆیان په‌یدا بكه‌ن. <verse eid="2TH 3:12" /><verse number="13" style="v" sid="2TH 3:13" />جا ئه‌ی برایان ماندوو مه‌بن له‌كاری چاكه‌.</para>
  <para style="p" vid="2TH 3:13">‏ <verse eid="2TH 3:13" /><verse number="14" style="v" sid="2TH 3:14" />گه‌ر یه‌كێك له‌ناوتان گوێڕایه‌ڵ نه‌بوو بۆ ئه‌و ووشانه‌ی له‌م نامه‌یه‌ دایه‌، ئاگاداری بن‏و په‌یوه‌ندی له‌گه‌ڵ مه‌به‌ستن تا شه‌رمه‌زار بێت. <verse eid="2TH 3:14" /><verse number="15" style="v" sid="2TH 3:15" />به‌ڵام وه‌ك دوژمن سه‌یری مه‌كه‌ن، به‌ڵكو ڕێی نیشان‎بده‌ن‏و ئاگاداری بكه‌نه‌وه‌ وه‌ك برایه‌ك.<verse eid="2TH 3:15" /></para>
  <para style="s1">سڵاوی كۆتایی</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16" />ئێستا داوا له‌‏خوداوه‌ندی ئاشتی ده‌كه‌م له‌هه‌موو كات‏و بارودۆخێك ئاشتی خۆی ببه‌خشێ‌ پێتان‏. خوداوه‌ند له‌گه‌ڵ هه‌مووتان بێت.<verse eid="2TH 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2TH 3:17" />من پۆڵسم ئه‌م سڵاوانه‌ به‌خه‌تی خۆم ده‌نووسم، ئه‌مه‌ش نیشانه‌یه‌كی دیاره‌، له‌‏هه‌موو نامه‌یه‌كی من ده‌ریده‌خات نووسینی منه‌. <verse eid="2TH 3:17" /><verse number="18" style="v" sid="2TH 3:18" />به‌ره‌كه‌تی عیسای مه‌سیحی خوداوه‌ندمان له‌گه‌ڵ هه‌مووتان بێت.<verse eid="2TH 3:18" /></para>
  <chapter eid="2TH 3" />
</usx>