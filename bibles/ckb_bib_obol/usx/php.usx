<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHP" style="id">- Biblica® Open Sorani Kurdish Book of Life</book>
  <para style="rem">‪Copyright © 1998 by Biblica, Inc.</para>
  <para style="h">فیلیپی</para>
  <para style="toc1">نامەی پۆڵس بۆ باوەڕدارانی فیلیپی</para>
  <para style="toc2">فیلیپی</para>
  <para style="toc3">فیلیپی</para>
  <para style="mt1">نامه‌ی پۆڵس بۆ باوه‌ڕدارانی فیلیپی</para>
  <chapter number="1" style="c" sid="PHP 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1" />له‌پۆڵس‏و تیمۆساوسی كۆیله‌كانی عیسای مه‌سیح، بۆ هه‌موو خوشك‏و برایانی پیرۆز له‌‏عیسای مه‌سیح له‌شاری فیلیپی، هه‌روه‌ها بۆ چاودێران‏و خزمه‌تكارانیش‏. <verse eid="PHP 1:1" /><verse number="2" style="v" sid="PHP 1:2" />با به‌ره‌كه‌ت‏و ئاشتی ‏خودای باوكمان‏و عیسای مه‌سیحی خوداوه‌ندتان له‌گه‌ڵ بێ‌.<verse eid="PHP 1:2" /></para>
  <para style="s1">سوپاسی خوداو پاڕانه‌وه‌</para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3" />سوپاسی خودا ده‌كه‌م هه‌ركاتێك یادتان بكه‌م، <verse eid="PHP 1:3" /><verse number="4" style="v" sid="PHP 1:4" />هه‌موو كاتێك به‌خۆشیه‌وه‌ بۆ هه‌مووتان ده‌پارێمه‌وه‌ لای خودا، <verse eid="PHP 1:4" /><verse number="5" style="v" sid="PHP 1:5" />چونكه‌ ئێوه‌ له‌‏یه‌كه‌م ڕۆژه‌وه‌ تا ئێستا به‌شداریتان كردووه‌ له‌‏مزگێنی. <verse eid="PHP 1:5" /><verse number="6" style="v" sid="PHP 1:6" />هه‌روه‌ها دڵنیام ئه‌و ئیشه‌ چاكه‌ی خودا له‌ئێوه‌ ده‌ستی پێ‌كردووه‌، به‌رده‌وام ده‌بێت له‌ته‌واو‏كردنی هه‌تا ڕۆژی عیسای مه‌سیح.<verse eid="PHP 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PHP 1:7" />ئه‌وه‌ش مافی خۆمه‌ گه‌ر واهه‌ست بكه‌م سه‌باره‌ت به‌ هه‌مووتان، چونكه‌ ئێوه‌م له‌دڵی خۆم پاراستووه‌، هه‌مووتان له‌‏گه‌‏ڵم به‌شداری ده‌كه‌ن له‌به‌ره‌كه‌ت، گه‌ر ئێستا بێت به‌م كۆت‏و زنجیره‌ له‌به‌ندیخانه‌دا، یاخود كاتێك به‌رگری له‌‏مزگێنی ده‌كه‌م‏و ده‌یچه‌سپێنم. <verse eid="PHP 1:7" /><verse number="8" style="v" sid="PHP 1:8" />خودا ده‌زانێت تا چ ڕاده‌یه‌ك دڵم ئاره‌زووی هه‌مووتان ده‌كات به‌هه‌ست‏و سۆزی عیسای مه‌سیح.<verse eid="PHP 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PHP 1:9" />له‌خودا ده‌پاڕێمه‌وه‌ خۆشه‌ویستیتان زیاترو زیاتر بكات بۆ زانین‏و تێگه‌یشتنی ته‌واو، <verse eid="PHP 1:9" /><verse number="10" style="v" sid="PHP 1:10" />تا ئه‌وه‌ی باشه‌ هه‌ڵیبژێرن، هه‌روه‌ها پاك‏و بێ‌ كه‌م‏وكووڕی بن بۆ ڕۆژی مه‌سیح. <verse eid="PHP 1:10" /><verse number="11" style="v" sid="PHP 1:11" />ژیانتان پڕبێت له‌‏به‌رووبوومی ڕاست‎ودروستی، ئه‌وه‌ی عیسای مه‌سیح ده‌یهێنێته‌ به‌رهه‌م، بۆ شكۆو ستایشی خودا.<verse eid="PHP 1:11" /></para>
  <para style="s1">له‌لای من، ژیان مه‌سیحه‌</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12" />ئه‌ی برایان، ئێستا ده‌مه‌وێ‌ بزانن ئه‌وه‌ی به‌سه‌رم هات به‌ڕاستی مزگێنی به‌ره‌و پێش برد، <verse eid="PHP 1:12" /><verse number="13" style="v" sid="PHP 1:13" />ته‌نانه‌ت هه‌موو پاسه‌وانانی ئیمپراتۆرو هه‌موو خه‌ڵكی ئێره‌، ده‌زانن من له‌پێناوی مه‌سیحدا به‌ندكراوم، <verse eid="PHP 1:13" /><verse number="14" style="v" sid="PHP 1:14" />هه‌روه‌ها به‌ندكردن‏و كۆت‏و زنجیری من وایكرد زۆربه‌ی خوشك‏و برایان پشت به‌خوداوه‌ند ببه‌ستن‏و زۆر زیاتر به‌ چاونه‌ترسی سه‌باره‌ت به‌ووشه‌ی خودا بدوێن.<verse eid="PHP 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 1:15" />بێ‌گومان هه‌ندێكیان مزگێنی مه‌سیح ده‌ده‌ن ته‌نها له‌به‌ر ناحه‌زیو ڕقه‌به‌رایه‌تی، به‌ڵام هه‌ندێكیتریان به‌خواستێكی باش مزگێنی ده‌ده‌ن. <verse eid="PHP 1:15" /><verse number="16" style="v" sid="PHP 1:16" />هه‌روه‌ها ئه‌وانه‌ی خۆشه‌ویستی پاڵیان پێوه‌ ده‌نێت مه‌سیح ڕابگه‌ێنن، ده‌زانن من خراومه‌ته‌ به‌ندیخانه‌وه‌ به‌هۆی به‌رگریم له‌مزگێنی. <verse eid="PHP 1:16" /><verse number="17" style="v" sid="PHP 1:17" />ئه‌وانه‌ی ناحه‌زی پاڵیان پێوه‌ ده‌نێت باسی عیسا بكه‌ن، به‌بێ‌ دڵسۆزی ده‌یكه‌ن، چونكه‌ له‌و باوه‌ڕه‌دان به‌مه‌ ناخۆشییه‌كی تر ده‌خه‌نه‌ پاڵ ئه‌م كۆت‏و زنجیره‌. <verse eid="PHP 1:17" /><verse number="18" style="v" sid="PHP 1:18" />ئیتر چی؟ گرنگ ئه‌وه‌یه‌ باسی مزگێنی مه‌سیح ده‌كرێ‌ ئیتر به‌ هه‌ر شێوه‌یه‌ك بێت بۆ خۆ‏ده‌رخستن بێت یاخود به‌ دڵسۆزی بێت، به‌مه‌ش من دڵشادم. به‌ڵێ‌ پێویسته‌ من دڵشاد بم، <verse eid="PHP 1:18" /><verse number="19" style="v" sid="PHP 1:19" />چونكه‌ من ده‌زانم به‌هۆی نوێژه‌كانتان‏و به‌‏یارمه‌تی ڕۆحی عیسای مه‌سیح ئه‌وه‌ی به‌سه‌رم هات ده‌بێته‌ هۆی ڕزگار بوونم. <verse eid="PHP 1:19" /><verse number="20" style="v" sid="PHP 1:20" />په‌رۆشی چاوه‌ڕوانم‏و ئومێدم ئه‌وه‌یه‌، شه‌رمه‌زار نه‌بم، به‌ڵكو به‌ووره‌یه‌كی به‌رزه‌وه‌ ئێستا وه‌ك هه‌موو كاتێك مه‌سیح له‌له‌شمدا ڕێزداربێ‌، گه‌ر ئه‌مه‌ به‌ مردوویی بێت یاخود زیندوویی. <verse eid="PHP 1:20" /><verse number="21" style="v" sid="PHP 1:21" />چونكه‌ له‌لای من، ژیان مه‌سیحه‌، ‏مردنیش قازانجه‌. <verse eid="PHP 1:21" /><verse number="22" style="v" sid="PHP 1:22" />به‌ڵام گه‌ر ژیان له‌له‌ش بێ‌، مانای ئه‌وه‌یه‌ به‌رووبوومی كرداره‌كانه‌ بۆ من، له‌گه‌ڵ ئه‌وه‌شدا نازانم كامیان هه‌ڵبژێرم! <verse eid="PHP 1:22" /><verse number="23" style="v" sid="PHP 1:23" />چونكه‌ سه‌رسام ماوم له‌ نێوان ئه‌م دوو بڕیاره‌دا، حه‌ز ده‌كه‌م ئه‌م ژیانه‌ به‌جێ‌ بهێڵم تا بچمه‌ لای مه‌سیح، ئه‌مه‌ش باشتره‌، <verse eid="PHP 1:23" /><verse number="24" style="v" sid="PHP 1:24" />به‌ڵام‏ مانه‌وه‌م له‌ له‌ش پێویستتره‌ بۆتان، <verse eid="PHP 1:24" /><verse number="25" style="v" sid="PHP 1:25" />دڵنیام له‌مه‌ بۆیه‌ ده‌زانم ده‌بێ‌ له‌‏ناوتان بمێنمه‌وه‌و له‌گه‌ڵ هه‌مووتان به‌رده‌وام بم، له‌‏پێناوی دڵخۆشی‏و پێشكه‌وتنتان له‌‏باوه‌ڕ، <verse eid="PHP 1:25" /><verse number="26" style="v" sid="PHP 1:26" />تا جارێكی تر هاتم بۆ لاتان، به‌هۆی من شانازیتان زیاد بكات به‌عیسای مه‌سیح. <verse eid="PHP 1:26" /><verse number="27" style="v" sid="PHP 1:27" />ئه‌وه‌ی گرنگه‌ ئه‌وه‌یه‌ ئێوه‌ به‌ شێوه‌یه‌ك بژین شایسته‌ی مزگێنی مه‌سیح بێ‌، تا كاتێ‌ هاتم‏و ئێوه‌م بینی یاخود له‌ناوتان نه‌بووم، هه‌واڵتان ببیستم‏و بزانم ئێوه‌ له‌یه‌ك ڕۆح چه‌سپاون‏و به‌یه‌ك مێشك تێ‌ده‌كۆشن له‌پێناوی باوه‌ڕی مزگێنی، <verse eid="PHP 1:27" /><verse number="28" style="v" sid="PHP 1:28" />بێ‌ ئه‌وه‌ی بترسن له‌وانه‌ی به‌ربه‌ره‌كانیتان ده‌كه‌ن. چونكه‌ ئه‌وه‌ نیشانه‌ی له‌‏ناوچوونه‌ بۆیان‏و ڕزگاریه‌ بۆ ئیۆه‌، ئه‌مه‌ش له‌‏خوداوه‌یه‌. <verse eid="PHP 1:28" /><verse number="29" style="v" sid="PHP 1:29" />خودا له‌به‌ر مه‌سیح ته‌نها باوه‌ڕهێنان به‌ ئه‌وی پێ‌نه‌به‌خشیون، به‌ڵكو چه‌شتنی ئازاریش له‌پێناوی ئه‌و. <verse eid="PHP 1:29" /><verse number="30" style="v" sid="PHP 1:30" />جا كۆشش بكه‌ن بۆ هه‌مان ململانێ‌ كه‌ له‌پێشا بینیووتانه‌، ئه‌وه‌ی ئێستاش ده‌یبیستن له‌من.<verse eid="PHP 1:30" /></para>
  <chapter eid="PHP 1" />
  <chapter number="2" style="c" sid="PHP 2" />
  <para style="s1">نموونه‌ی ڕۆح سووكی عیسا</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1" />گه‌ر هاندانێك هه‌بێت له‌‏مه‌سیحدا، یاخود بزوێنه‌رێك هه‌بێ‌ له‌خۆشه‌ویستی، یابه‌شداری كردنێك هه‌بێ‌ له‌ڕۆح، یاهه‌ست‏و سۆزو خۆشه‌ویستی، <verse eid="PHP 2:1" /><verse number="2" style="v" sid="PHP 2:2" />كه‌واته‌ خۆشیه‌كه‌م ته‌واوكه‌ن به‌وه‌ی یه‌ك بیروڕاو خۆشه‌ویستیتان هه‌بێ‌، یه‌ك دڵ‏و یه‌ك مه‌به‌ستتان هه‌بێ‌. <verse eid="PHP 2:2" /><verse number="3" style="v" sid="PHP 2:3" />هیچ شتێك به‌ مه‌به‌ستی خۆپه‌رستیو خۆهه‌ڵكێشان مه‌كه‌ن، به‌ڵكو ڕۆح سووك بن به‌ شێوه‌یه‌ك خه‌ڵكی كه‌ به‌ باشتر بزانن له‌‏خۆتان. <verse eid="PHP 2:3" /><verse number="4" style="v" sid="PHP 2:4" />ته‌نها بایه‌خ به‌ به‌رژه‌وه‌ندی تایبه‌تی خۆتان مه‌ده‌ن‏، به‌ڵكو بایه‌خ به‌ به‌رژه‌وه‌ندی خه‌ڵكی تریش بده‌ن‏.</para>
  <para style="p" vid="PHP 2:4">‏ <verse eid="PHP 2:4" /><verse number="5" style="v" sid="PHP 2:5" />ئه‌م بیروڕایه‌تان تیادا بێ، ئه‌وه‌ی له‌ عیسای مه‌سیح دایه‌:<verse eid="PHP 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PHP 2:6" />ئه‌و‏ه‌ی له‌شێوه‌ی خودا ‏بوو،</para>
  <para style="q1" vid="PHP 2:6">نه‌یویست یه‌كسانیه‌كه‌ی له‌گه‌ڵ خودا‏</para>
  <para style="q1" vid="PHP 2:6">بكات به‌‏ده‌سكه‌وتێك بۆ خۆی،</para>
  <para style="q1" vid="PHP 2:6">‏ <verse eid="PHP 2:6" /><verse number="7" style="v" sid="PHP 2:7" />به‌ڵكو خۆی كرده‌ هیچ‏و</para>
  <para style="q1" vid="PHP 2:7">شێوه‌ی كۆیله‌ی وه‌رگرت‏،</para>
  <para style="q1" vid="PHP 2:7">وه‌كو مرۆڤی لێهات،</para>
  <para style="q1" vid="PHP 2:7">‏ <verse eid="PHP 2:7" /><verse number="8" style="v" sid="PHP 2:8" />هه‌روه‌ها له‌گه‌ڵ ئه‌وه‌ی ئه‌و له‌شێوه‌ی</para>
  <para style="q1" vid="PHP 2:8">مرۆڤ بینرا،</para>
  <para style="q1" vid="PHP 2:8">خۆی نزم كرده‌وه‌و</para>
  <para style="q1" vid="PHP 2:8">ملكه‌چ بوو تا مردن،</para>
  <para style="q1" vid="PHP 2:8">مردن له‌سه‌ر خاچ.</para>
  <para style="q1" vid="PHP 2:8">‏ <verse eid="PHP 2:8" /><verse number="9" style="v" sid="PHP 2:9" />بۆیه‌ خودا به‌رزیكرده‌وه‌و</para>
  <para style="q1" vid="PHP 2:9">ناوێكی دایه‌ كه‌ له‌سه‌رووی هه‌موو</para>
  <para style="q1" vid="PHP 2:9">ناوێكه‌،<verse eid="PHP 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PHP 2:10" />تاكو بۆ ناوی ئه‌و هه‌مووان چۆك‎</para>
  <para style="q1" vid="PHP 2:10">دابده‌ن،</para>
  <para style="q1" vid="PHP 2:10">له‌ ئاسمان‏و سه‌ر زه‌وی‏و ژێر زه‌ویش،</para>
  <para style="q1" vid="PHP 2:10">‏ <verse eid="PHP 2:10" /><verse number="11" style="v" sid="PHP 2:11" />هه‌روه‌ها تا هه‌موو زمانێك دان بنێت</para>
  <para style="q1" vid="PHP 2:11">كه‌ عیسای مه‌سیح خوداوه‌نده‌،</para>
  <para style="q1" vid="PHP 2:11">بۆ شكۆمه‌ندی خودای باوك.<verse eid="PHP 2:11" /></para>
  <para style="s1">ڕۆڵه‌كانی خودا بێ‌‏كه‌م‏وكوڕین‏</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12" />جا ئه‌ی خۆشه‌ویستانم، چۆن گشت كات گوێڕایه‌ڵ بوون هه‌ر وابن، نه‌ك هه‌ر ئه‌م كاته‌ی لێره‌م، به‌ڵكو زیاتریش دوای من، ‏بۆ ڕزگاربوونتان به‌‏ترس‏و له‌رزه‌وه‌ كار بكه‌ن، <verse eid="PHP 2:12" /><verse number="13" style="v" sid="PHP 2:13" />چونكه‌ خودا خۆی له‌ئێوه‌ كار ده‌كات تا ئاره‌زووی كاركردنتان پێ‌ببه‌خشێ‌ بۆ ڕه‌زامه‌ندی خۆی.</para>
  <para style="p" vid="PHP 2:13">‏ <verse eid="PHP 2:13" /><verse number="14" style="v" sid="PHP 2:14" />هه‌موو شتێك بكه‌ن بێ‌ بۆڵه‌بۆڵ‏و شه‌ڕه‌قسه‌، <verse eid="PHP 2:14" /><verse number="15" style="v" sid="PHP 2:15" />تا بێ‌كه‌م‏وكوڕیو پاك‏بن، ڕۆڵه‌كانی خودا بێ‌ له‌كه‌ن له‌ناو نه‌وه‌یه‌كی خراپ‏و چه‌وت‏و خواردا، ئێوه‌ له‌نێوان ئه‌واندا وه‌ك ڕووناكی جیهان ده‌دره‌وشێنه‌وه‌. <verse eid="PHP 2:15" /><verse number="16" style="v" sid="PHP 2:16" />ده‌ست به‌‏ووشه‌ی ژیانه‌وه‌ ‎بگرن، تا له‌ڕۆژی مه‌سیح شانازی بكه‌م به‌وه‌ی به‌‏خۆڕایی تێ‏نه‌كۆشاوم‎و بێ‌سوود ماندوونه‌بووم. <verse eid="PHP 2:16" /><verse number="17" style="v" sid="PHP 2:17" />گه‌ر بمرم‏و خوێنم به‌سه‌ر قوربانی باوه‌ڕتان بڕژێ‌، ئه‌وا له‌گه‌ڵتان دڵشادو دڵخۆشم‏. <verse eid="PHP 2:17" /><verse number="18" style="v" sid="PHP 2:18" />كه‌واته‌ ئیۆه‌ش پێویسته‌ له‌گه‌ڵم دڵشادو دڵخۆش بن.<verse eid="PHP 2:18" /></para>
  <para style="s1">تیمۆساوس‏و ئه‌پفرۆدیتۆس</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19" />هیوادارم له‌عیسای خوداوه‌ند بتوانم به‌م زووانه‌ تیمۆساوس بنێرم بۆ لاتان، تا هه‌واڵتان بزانم‏و پێی دڵخۆش بم. <verse eid="PHP 2:19" /><verse number="20" style="v" sid="PHP 2:20" />جگه‌ له‌و كه‌سیترم نییه‌ وا به‌‏دڵسۆزی بایه‌ختان پێ‌بدات، <verse eid="PHP 2:20" /><verse number="21" style="v" sid="PHP 2:21" />چونكه‌ هه‌موو ئه‌وانیتر به‌دوای كاروباری تایبه‌تی خۆیان ده‌گه‌ڕێن، نه‌ك هی عیسای مه‌سیح. <verse eid="PHP 2:21" /><verse number="22" style="v" sid="PHP 2:22" />ئێوه‌ له‌‏شاره‌زایی تیمۆساوس ئاگادارن، وه‌ك كوڕێك له‌گه‌ڵ باوكی له‌گه‌ڵم كاری‏كردووه‌ له‌مزگێنی. <verse eid="PHP 2:22" /><verse number="23" style="v" sid="PHP 2:23" />ئه‌و ده‌نێرم بۆ لاتان، هه‌ر كاتێك لێره‌ چاره‌نووسم ده‌ربكه‌وێ‌. <verse eid="PHP 2:23" /><verse number="24" style="v" sid="PHP 2:24" />دڵنیام له‌‏خوداوه‌ند كه‌ خۆشم به‌م نزیكانه‌ دێم بۆ لاتان.</para>
  <para style="p" vid="PHP 2:24">‏ <verse eid="PHP 2:24" /><verse number="25" style="v" sid="PHP 2:25" />به‌ڵام به‌پێویستم زانی له‌پێشا ئه‌پفـرۆدیتۆس بنێرمــه‌وه‌ بۆ لاتان، كه‌ برامه‌و له‌گه‌ڵم ئیشكه‌رو ســه‌ربازه‌، ئـه‌وه‌ی نێرراوی ئێوه‌یه‌ بۆ جێ‌به‌جێ‌ كردنی پێویستیه‌كانم. <verse eid="PHP 2:25" /><verse number="26" style="v" sid="PHP 2:26" />ئه‌و بیری هه‌مووتان ده‌كات‏و دڵته‌نگه‌ چونكه‌ هه‌واڵی نه‌ساغی ئه‌وتان بیستووه‌. <verse eid="PHP 2:26" /><verse number="27" style="v" sid="PHP 2:27" />به‌راستی زۆر نه‌ساغ بوو، هـه‌تا خه‌ریك بوو بمرێت، به‌ڵام خـودا به‌زه‌یی پیاهاته‌وه‌، هه‌روه‌ها به‌ منیش، تا خه‌فه‌ت به‌دوای خه‌فـه‌تم به‌سه‌رنه‌یه‌ت. <verse eid="PHP 2:27" /><verse number="28" style="v" sid="PHP 2:28" />به‌مـه‌ش وای لـێكردم خێرا بینێرمه‌وه‌ بۆ لاتان، بۆ ئه‌وه‌ی دڵشادبن كاتێك بینیتان، منیش خه‌فه‌تم كه‌م‎بێته‌وه‌. <verse eid="PHP 2:28" /><verse number="29" style="v" sid="PHP 2:29" />كه‌واته‌ به‌دڵشادیه‌وه‌ له‌خوداوه‌ند پێشوازی لـێ‌بكه‌ن، هه‌روه‌ها ئه‌وانه‌ی وه‌ك ئه‌و‏ن ڕێزیان لێ‌بگرن‏. <verse eid="PHP 2:29" /><verse number="30" style="v" sid="PHP 2:30" />چونكه‌ له‌پێناوی ئیشی مه‌سیح ژیانی خۆی خسته‌ مه‌ترسیه‌وه‌و خه‌ریك بوو بمرێت، تا ئه‌و خزمه‌ته‌ ته‌واو بكات ئه‌وه‌ی ئێوه‌ بۆ من ده‌یكه‌ن.<verse eid="PHP 2:30" /></para>
  <chapter eid="PHP 2" />
  <chapter number="3" style="c" sid="PHP 3" />
  <para style="s1">بێ‌تاوان بوون به‌هۆی باوه‌ڕ</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1" />له‌ كۆتاییدا، ئه‌ی برایان، دڵشادبن به‌‏خوداوه‌ند، لای من نووسینه‌وه‌ی ئه‌م شتانه‌ كارێكی گران نییه‌ چونكه‌ دڵنیایی ئیۆه‌ی تیایه‌.</para>
  <para style="p" vid="PHP 3:1">‏ <verse eid="PHP 3:1" /><verse number="2" style="v" sid="PHP 3:2" />چاوببڕنه‌ سه‌گه‌كان، چاوببڕنه‌ به‌دكاران، چاوببڕنه‌ ئه‌وانه‌ی له‌ش ده‌بڕنه‌وه‌. <verse eid="PHP 3:2" /><verse number="3" style="v" sid="PHP 3:3" />ئێمه‌ین خه‌ته‌نه‌كراوی ڕاسته‌قینه‌، چونكه‌ خودا به‌ڕۆح ده‌په‌رستین‏و شكۆمه‌ندیمان له‌‏عیسای مه‌سیحه‌وه‌یه‌، پشت به‌له‌ش ‎نابه‌ستین، <verse eid="PHP 3:3" /><verse number="4" style="v" sid="PHP 3:4" />هه‌رچه‌نده‌ من هۆم هه‌یه‌ تا پشت به‌ له‌ش ببه‌ستم.</para>
  <para style="p" vid="PHP 3:4">گه‌ر یه‌كێك له‌و باوه‌ڕه‌ بێت هۆی هه‌یه‌ پشت به‌ له‌ش ‎ببه‌ستێ‌، یه‌كه‌مجار مافـی منه‌ ئه‌وه‌ بكه‌م: <verse eid="PHP 3:4" /><verse number="5" style="v" sid="PHP 3:5" />‏كاتێك ته‌مه‌نم هه‌شت ڕۆژ بووه‌ خه‌ته‌نه‌كراوم، به‌ نه‌وه‌ ئیسرائیلی بووم، له‌‏تیره‌ی بینیامین، عیبرانی‏* كوڕی عیبرانی. هه‌روه‌ها به‌پێی شه‌ریعه‌ت فه‌ریسی بووم، <verse eid="PHP 3:5" /><verse number="6" style="v" sid="PHP 3:6" />‏له‌باره‌ی دڵگه‌رمی چه‌وسێنه‌ری كۆمه‌ڵه‌ی باوه‌ڕداران بووم، له‌ڕاست‏ودروستی به‌پێی شه‌ریعه‌ت بێ‌‏كه‌م‏و‏كوڕی بووم.<verse eid="PHP 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PHP 3:7" />به‌ڵام ئه‌م شتانه‌ی من به‌ قازانجم داده‌نا، ئێستا له‌لای من زیانه‌ له‌پێناوی مه‌سیح. <verse eid="PHP 3:7" /><verse number="8" style="v" sid="PHP 3:8" />به‌ڵكو له‌مه‌ش زیاتر، ئه‌و شتانه‌ هه‌مووی زیانه‌ لای من گه‌ر به‌راورد بكرێت له‌گه‌ڵ مه‌زنی بێ‌سنووری ناسینی عیسای مه‌سیحی خوداوه‌ندم، ئه‌وه‌ی له‌پێناویدا هه‌موو شتێكم له‌‏كیس‎چوو، جا ‏ئه‌م شتانه‌ هه‌مووی به‌ زبڵ داده‌نێم، بۆ ئه‌وه‌ی مه‌سیح به‌ده‌ست بهێنم‏و <verse eid="PHP 3:8" /><verse number="9" style="v" sid="PHP 3:9" />خۆم له‌مه‌سیح بدۆزمه‌وه‌و ڕاست‏ودروست بم، نه‌ك به‌شه‌ریعه‌ت، به‌ڵكو به‌هۆی باوه‌ڕ به‌عیسای مه‌سیح، چونكه‌ بێ‌تاوان بوون لای خودا پشت به‌باوه‌ڕ ده‌به‌ستێت. <verse eid="PHP 3:9" /><verse number="10" style="v" sid="PHP 3:10" />ئه‌وه‌ی مه‌به‌ستی منه‌ ناسینی مه‌سیح‏و هێزی هه‌ستانه‌وه‌یه‌تی، هه‌روه‌ها به‌شداری بكه‌م له‌ئازاری، وه‌ك ئه‌و بم له‌‏مردنی، <verse eid="PHP 3:10" /><verse number="11" style="v" sid="PHP 3:11" />تاكو گه‌ر ببێ‌ بگه‌م به‌ئاستی هه‌ستانه‌وه‌ی له‌نێو مردووان.<verse eid="PHP 3:11" /></para>
  <para style="s1">كۆشش‏كردن به‌دوای ئامانج</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12" />من ناڵێم ئه‌م شتانه‌م هه‌موو به‌ده‌ست‎هێناوه‌ یاخود گه‌یشتوومه‌ ته‌واوی، به‌ڵكو هه‌ر چییه‌كم له‌توانا هه‌یه‌ ده‌یكه‌م تا بیكه‌م به‌هی خۆم، ئه‌وه‌ی مه‌سیح له‌پێناویدا منی كردووه‌ به‌هی خۆی. <verse eid="PHP 3:12" /><verse number="13" style="v" sid="PHP 3:13" />ئه‌ی برایان، جارێ‌ وایدانانێم گه‌یشتوومه‌ ئامانج، به‌ڵام ته‌نها یه‌ك شت ده‌كه‌م، ئه‌ویش ئه‌وه‌یه‌، ئه‌وه‌ی به‌سه‌رچووه‌ له‌یادی ده‌كه‌م، ده‌ڕۆم به‌ره‌و ئه‌وه‌ی له‌پێشمه‌. <verse eid="PHP 3:13" /><verse number="14" style="v" sid="PHP 3:14" />من به‌ره‌و ئامانج هه‌وڵ ده‌ده‌م، به‌ره‌و پاداشتی بانگه‌وازی به‌رزی خودا كه‌ له‌عیسای مه‌سیحه‌.</para>
  <para style="p" vid="PHP 3:14">‏ <verse eid="PHP 3:14" /><verse number="15" style="v" sid="PHP 3:15" />با وا بیربكه‌ینه‌وه‌ ئێمه‌ پێگه‌یشتووین، گه‌ر ئێوه‌ش له‌‏خاڵێك یان له‌‏بیرورایه‌ك هه‌مان بیرورای منتان نه‌بوو، ئه‌وا خودا بۆتان ئاشكرا ده‌كات. <verse eid="PHP 3:15" /><verse number="16" style="v" sid="PHP 3:16" />جا ئه‌وه‌ی پێیگه‌یشتووین با به‌دڵسۆزی ده‌ستی پێوه‌ بگرین.<verse eid="PHP 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 3:17" />ئه‌ی برایان به‌یه‌كه‌وه‌ لاسایی من بكه‌نه‌وه‌و ته‌ماشای ئه‌وانه‌ بكه‌ن كه‌ وه‌ك نموونه‌ی من ده‌ژین. <verse eid="PHP 3:17" /><verse number="18" style="v" sid="PHP 3:18" />زۆر پێم‎ووتون، ئێستاش به‌گریانه‌وه‌ پێتان ده‌ڵێم، زۆر كه‌س هه‌ن ژیانیان به‌‏شێوه‌یه‌كه‌ وه‌ك دوژمن وایه‌ بۆ خاچی مه‌سیح. <verse eid="PHP 3:18" /><verse number="19" style="v" sid="PHP 3:19" />ئه‌وانه‌ پاشه‌ڕۆژیان له‌ناوچوونه‌، چونكه‌ سكیان ده‌په‌رستن‏و شكۆمه‌ندیان جێی شه‌رمه‌زارییه‌، هه‌موو بیرو هۆشیان له‌سه‌ر شتی جیهانیه‌. <verse eid="PHP 3:19" /><verse number="20" style="v" sid="PHP 3:20" />به‌ڵام ئێمه‌ ووڵاتمان له‌ئاسمانه‌، ‏له‌وێ‌ به‌ئاره‌زووه‌وه‌ چاوه‌ڕێی هاتنه‌وه‌ی ڕزگاركه‌ر، عیسای مه‌سیحی خوداوه‌ندی تیادا ده‌كه‌ین، <verse eid="PHP 3:20" /><verse number="21" style="v" sid="PHP 3:21" />ئینجا ئه‌و له‌شی بێ‌نرخمان ده‌گۆڕێت بۆ شێوه‌ی له‌شی شكۆداری خۆی، به‌هێزی خۆی كه‌ توانای هه‌یه‌ زاڵ‏بێت به‌سه‌ر هه‌موو شتێك.<verse eid="PHP 3:21" /></para>
  <chapter eid="PHP 3" />
  <chapter number="4" style="c" sid="PHP 4" />
  <para style="s1">دڵشادبن به‌خوداوه‌ند</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1" />له‌به‌رئه‌وه‌ برایانی خۆشه‌ویست، ئه‌ی ئه‌وانه‌ی زۆر بیرتان ده‌كه‌م‏، ئێوه‌ خۆشیو تاجی سه‌ری منن، با باوه‌ڕتان چه‌سپاو بێت به‌خوداوه‌ند.</para>
  <para style="p" vid="PHP 4:1">‏ <verse eid="PHP 4:1" /><verse number="2" style="v" sid="PHP 4:2" />‏له‌خوشكان ئه‌فودیه‌و سینتخی ده‌پاڕێمه‌وه‌، له‌گه‌ڵ یه‌كتری ڕێك‏بكه‌ون له‌خوداوه‌ند. <verse eid="PHP 4:2" /><verse number="3" style="v" sid="PHP 4:3" />تۆش ئه‌ی هاوڕێی دڵسۆزم، داوات لـێ‌ده‌كه‌م یارمه‌تی ئه‌و دوو ئافره‌ته‌ بده‌یت‏، چونكه‌ هه‌ر دووكیان له‌گه‌ڵم له‌‏مزگێنی تێكۆشاون‏، ئه‌وان له‌گه‌ڵ ئه‌كلیمندوس‏و ئه‌وانه‌ی له‌گه‌ڵم ئیش ده‌كه‌ن ناویان له‌په‌رتووكی ژیان نووسراوه‌.<verse eid="PHP 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PHP 4:4" />هه‌میشه‌ دڵشادبن به‌خوداوه‌ند، جارێكیتر پێتان ده‌ڵێم، دڵشادبن. <verse eid="PHP 4:4" /><verse number="5" style="v" sid="PHP 4:5" />با ڕووخۆشیتان دیار بێت لای هه‌موو خه‌ڵك. هاتنه‌وه‌ی خوداوه‌ند نزیكه‌. <verse eid="PHP 4:5" /><verse number="6" style="v" sid="PHP 4:6" />ده‌رباره‌ی هیچ شتێك دڵه‌ڕاوكێ‌ نه‌تانگرێ، به‌ڵكو له‌هه‌موو شتێك داواكاریه‌كانتان پێشكه‌شی خودا بكه‌ن به‌ نوێژو پاڕانه‌وه‌و سوپاس. <verse eid="PHP 4:6" /><verse number="7" style="v" sid="PHP 4:7" />ئاشتی خودا، ئه‌وه‌ی به‌رزتره‌ له‌‏سنووری بیری مرۆڤ، دڵ‎و بیرتان ده‌پارێزێت له‌عیسای مه‌سیح. <verse eid="PHP 4:7" /><verse number="8" style="v" sid="PHP 4:8" />ئه‌ی برایان له‌‏كۆتاییدا پێتان ده‌ڵێم: ئه‌و شتانه‌ی ڕاست‏و ڕێزداره‌، دادپه‌روه‌رو پاكه‌، مایه‌ی خۆشه‌ویستیه‌و په‌سه‌ندكراو‏ه‌، ناوبانگی به‌ چاكه‌ ده‌ركردووه‌، ڕه‌وشــت به‌رزو شایانی ستایشه‌، بیری لێ‏بكه‌نه‌وه‌. <verse eid="PHP 4:8" /><verse number="9" style="v" sid="PHP 4:9" />به‌شێوه‌یه‌ك هه‌ڵس‏وكه‌وت بكه‌ن هه‌روه‌ك له‌من فێربوون‏و وه‌رتانگرت‏و بیستتان‏و بینیتان، ئینجا خودای ئاشتی له‌گه‌ڵتان ده‌بێت.<verse eid="PHP 4:9" /></para>
  <para style="s1">سوپاس بۆ به‌خشینتان</para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10" />من زۆر دڵشادم به‌خوداوه‌ند، كه‌وا ئێستا ئێوه‌ دوای ماوه‌یه‌كی دوورو درێژ سه‌رله‌نوێ‌ بایه‌خم پێ‌ده‌ده‌ن، به‌ڵێ‌ له‌ ڕابوردووشدا ئێوه‌ ئه‌م بایه‌خ پێ‌دانه‌تان هه‌ر هه‌بووه‌، به‌ڵام ئه‌و هه‌له‌تان بۆ ڕێك‎نه‌كه‌وتووه‌. <verse eid="PHP 4:10" /><verse number="11" style="v" sid="PHP 4:11" />من ئه‌مه‌ ناڵێم تا ده‌ریخه‌م لـێ‌قه‌وماوم، چونكه‌ فێربووم به‌ هه‌موو بارودۆخێكی ژیانم ڕازی بم. <verse eid="PHP 4:11" /><verse number="12" style="v" sid="PHP 4:12" />من ده‌زانم چۆن له‌ هه‌بوونیو نه‌بوونیدا بژیم، هه‌موو بارودۆخێكم تاقی كردۆته‌وه‌، له‌تێریو برسێتیدا، <verse eid="PHP 4:12" /><verse number="13" style="v" sid="PHP 4:13" />توانام هه‌یه‌ هه‌موو شتێك به‌هۆی مه‌سیح بكه‌م، ئه‌وه‌ی به‌هێزم ده‌كات.</para>
  <para style="p" vid="PHP 4:13">‏ <verse eid="PHP 4:13" /><verse number="14" style="v" sid="PHP 4:14" />له‌گه‌ڵ ئه‌وه‌شدا كارێكی چاكتان كردووه‌ كه‌ به‌شداری ته‌نگانه‌م ده‌كه‌ن. <verse eid="PHP 4:14" /><verse number="15" style="v" sid="PHP 4:15" />ئه‌ی باوه‌ڕدارانی فیلیپی ئێــوه‌ش ده‌زانــن، له‌‏ســه‌ره‌تای كارم كــه‌ بــڵاوكردنـه‌وه‌ی مزگێنی بوو، له‌و كاته‌ی له‌‏ناوچه‌ی مه‌كدۆنیاوه‌ ده‌رچووم، هیچ كۆمه‌ڵێكی باوه‌ڕدار بـه‌شداری جــێ‌بــه‌جــێ‌‏كــردنــی پێویستیه‌كانی نه‌كردووم جگه‌ له‌‏ئێوه‌. <verse eid="PHP 4:15" /><verse number="16" style="v" sid="PHP 4:16" />ته‌نانه‌ت كاتێك له‌‏شاری ته‌سالۆنیكی بووم، ئه‌وه‌ی پێویستم پێی بوو چه‌ند جارێك بۆتان ناردم. <verse eid="PHP 4:16" /><verse number="17" style="v" sid="PHP 4:17" />مه‌به‌ستی من‏ داواكردنی به‌خشین نییه‌ جارێكیتر، به‌ڵكو داواكردنی به‌رووبوومی زیاتره‌ بۆ تۆماركردن له‌لای خودا. <verse eid="PHP 4:17" /><verse number="18" style="v" sid="PHP 4:18" />هه‌موو ئه‌و شتانه‌ی ئه‌پفرۆدیتۆس لای ئێوه‌ بۆی هێنام پێم‎گه‌یشت، ئێستا هــه‌رچیه‌كـم پێویسته‌ هه‌مه‌، به‌ڵكو له‌مه‌ش زیاتر، دیارییه‌كانی ئێوه‌ قوربانییه‌ دڵی خودا خـۆش ده‌كــات‏و لای ئه‌و بۆنخۆش‏و په‌سه‌ندكراون. <verse eid="PHP 4:18" /><verse number="19" style="v" sid="PHP 4:19" />خودا له‌ سامانی بێ‌ئه‌ندازه‌ی خۆی، به‌‏هۆی شكۆمه‌ندی عیسای مه‌سیح هه‌موو پێویستیه‌كانتان دابین ده‌كات. ‏ <verse eid="PHP 4:19" /><verse number="20" style="v" sid="PHP 4:20" />شكۆ و ‏مه‌زنی ‏بۆ‏ خودای ‏باوكمانه‌ ‏تاهه‌تایه‌. ‏ئامین.<verse eid="PHP 4:20" /></para>
  <para style="s1">سڵاوی كۆتایی</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21" />سڵاو بكه‌ن له‌هه‌موو خوشك‏و برایانی پیرۆز له‌عیسای مه‌سیح. هه‌موو ئه‌و برایانه‌ی له‌گه‌ڵمدان سڵاوتان لێ‌ده‌كه‌ن. <verse eid="PHP 4:21" /><verse number="22" style="v" sid="PHP 4:22" />ئه‌و خوشك‏و برا پیرۆزانه‌ی لێره‌ن سڵاوتان لـێ‌ده‌كه‌ن، به‌تایبه‌تی ئه‌وانه‌ی ده‌ست‏و پێوه‌ندی قه‌یسه‌رن.</para>
  <para style="p" vid="PHP 4:22">‏ <verse eid="PHP 4:22" /><verse number="23" style="v" sid="PHP 4:23" />با‏به‌ره‌كه‌تی عیسای مه‌سیحی خوداوه‌ند له‌گه‌ڵ ڕۆحتان بێت.<verse eid="PHP 4:23" /></para>
  <chapter eid="PHP 4" />
</usx>