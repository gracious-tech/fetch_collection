<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- Biblica® Open Sorani Kurdish Book of Life</book>
  <para style="rem">‪Copyright © 1998 by Biblica, Inc.</para>
  <para style="h">دووەم تیمۆساوس</para>
  <para style="toc1">دووه‌م نامه‌ی پۆڵس بۆ تیمۆساوس</para>
  <para style="toc2">دووەم تیمۆساوس</para>
  <para style="toc3">دووەم تیمۆساوس</para>
  <para style="mt1">دووه‌م نامه‌ی پۆڵس بۆ تیمۆساوس</para>
  <chapter number="1" style="c" sid="2TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1" />له‌پۆڵسه‌وه‌ ئه‌وه‌ی له‌سه‌ر خواستی خودا نێرراوی عیسای مه‌سیحه‌ له‌‏پێناوی به‌ڵێنی ژیان كه‌ له‌عیسای مه‌سیح دایه‌، <verse eid="2TI 1:1" /><verse number="2" style="v" sid="2TI 1:2" />بۆ كوڕی خۆشه‌ویستم تیمۆساوس، با به‌ره‌كه‌ت‏و به‌زه‌یی‏و ئاشتی خودای باوك‏و عیسای مه‌سیحی خوداوه‌ندمان له‌گه‌ڵت بێ.<verse eid="2TI 1:2" /></para>
  <para style="s1">‏هاندان بۆ ئازار چه‌شتن</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3" />سوپاسی خودا ده‌كه‌م ئه‌وه‌ی به‌‏ویژدانێكی پاك ده‌یپه‌رستم هه‌روه‌ك باپیرانم په‌رستوویانه‌، كاتێ‌ به‌ شه‌و و ڕۆژ له‌‏نوێژه‌كانم یادت ‎ده‌كه‌م‏، <verse eid="2TI 1:3" /><verse number="4" style="v" sid="2TI 1:4" />كاتێ‌ یادی فرمێسكه‌كانت ده‌كه‌مه‌وه‌ زیاتر ئاره‌زووی بینینت ده‌كه‌م تا دڵخۆش‎بم. <verse eid="2TI 1:4" /><verse number="5" style="v" sid="2TI 1:5" />هه‌روه‌ها یادی باوه‌ڕی ڕاستت ده‌كه‌م، ئه‌وه‌ی یه‌كه‌مجار له‌‏دڵی لوئیسی دایه‌گه‌وره‌ت‏و ئه‌فنیكی دایكت بوو، من دڵنیام له‌‏دڵی تۆشدایه‌. <verse eid="2TI 1:5" /><verse number="6" style="v" sid="2TI 1:6" />له‌به‌رئه‌وه‌ ئه‌و به‌هره‌یه‌ی خودا كه‌ تیاتدایه‌ به‌بیرت ده‌هێنمه‌وه‌ هه‌ڵیگیرسێنی، ئه‌وه‌ی وه‌رتگرت كاتێ‌ ده‌ستم خسته‌ سه‌رت. <verse eid="2TI 1:6" /><verse number="7" style="v" sid="2TI 1:7" />چونكه‌ خودا ڕۆحی ترسی به‌ئێمه‌ نه‌داوه‌، به‌ڵكو ڕۆحی هێزو خوشه‌ویستیو خۆڕاگری.<verse eid="2TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 1:8" />بۆیه‌ شه‌رمت به‌وه‌ نه‌بێ‌ شایه‌تی بۆ خوداوه‌ندمان بده‌یت، هه‌روه‌ها شه‌رمت به‌من نه‌بێ‌ كه‌ ئێستا له‌پێناوی ئه‌ودا به‌ندكراوم، به‌ڵكو به‌شداری ئازار بكه‌ بۆ مزگێنی، له‌وه‌ش پشت به‌هێزی خودا ببه‌سته‌. <verse eid="2TI 1:8" /><verse number="9" style="v" sid="2TI 1:9" />ئه‌وه‌ی ڕزگاری كردین‏و بانگی كردین به‌بانگه‌وازێكی پیرۆز، ئه‌مه‌ش به‌هۆی كردارمان نه‌بوو، به‌ڵكو ئه‌وه‌ خواست‏و به‌ره‌كه‌تی خودایه‌ بۆ ئێمه‌ كه‌ له‌سه‌ره‌تاوه‌ به‌هۆی عیسای مه‌سیحه‌وه‌ داویه‌تی پێمان، <verse eid="2TI 1:9" /><verse number="10" style="v" sid="2TI 1:10" />ئێستا ئاشكرا بوو به‌ده‌ركه‌وتنی عیسای مه‌سیحی ڕزگاركه‌رمان، ئه‌وه‌ی مردنی له‌ناوبردو ڕووناكی خسته‌ سه‌ر ژیان‏و نه‌مری به‌هۆی مزگێنیه‌وه‌، <verse eid="2TI 1:10" /><verse number="11" style="v" sid="2TI 1:11" />ئه‌و مزگێنییه‌ی من بۆی بووم به‌ ووتارده‌رو نێرراو و مامۆستا. <verse eid="2TI 1:11" /><verse number="12" style="v" sid="2TI 1:12" />له‌پێناوی ئه‌وه‌ ئێستا ئه‌م ئازارانه‌ ده‌چێژم، به‌ڵام شه‌رمی پێوه‌ ناكه‌م، چونكه‌ ده‌زانم باوه‌ڕم به‌كێ‌ هه‌یه‌، دڵنیام خودا ده‌توانێ‌ پارێزگاری ئه‌و شته‌م بۆ بكات كه‌وا بۆی داناوم تا ئه‌و ڕۆژه‌.‏<verse eid="2TI 1:12" /></para>
  <para style="s1">ئه‌وه‌ی لات دانراوه‌ بیپارێزه‌</para>
  <para style="p">
    <verse number="13" style="v" sid="2TI 1:13" />ده‌ست به‌و ووشه‌ ڕاستانه‌ بگره‌ كه‌ له‌منه‌وه‌ بیستووته‌، به‌و باوه‌ڕو خۆشه‌ویستیه‌ی له‌عیسای مه‌سیح دایه‌. <verse eid="2TI 1:13" /><verse number="14" style="v" sid="2TI 1:14" />ئه‌و شته‌ چاكه‌ی لای تۆ دانراوه‌، پارێزگاری بكه‌ به‌ڕۆحی پیرۆز كه‌ له‌ئێمه‌ دایه‌.<verse eid="2TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15" />تۆ ده‌زانی هه‌موو ئه‌وانه‌ی له‌‏ناوچه‌ی ئاسیان وازیان لـێ‌ هێنام، له‌وانه‌ فیجلۆس‏و هرمۆجینیس.</para>
  <para style="p" vid="2TI 1:15">‏ <verse eid="2TI 1:15" /><verse number="16" style="v" sid="2TI 1:16" />خودا به‌زه‌یی به‌‏خێزانی ئونیسیفورس بێته‌وه‌‏، چــونكه‌ زۆر‏جار ووره‌ی به‌رزكردومه‌‏وه‌و یارمه‌تی‏داوم، شه‌رمی نه‌كردووه‌ به‌ كۆت‏و زنجیرم. <verse eid="2TI 1:16" /><verse number="17" style="v" sid="2TI 1:17" />به‌ڵكو كاتێ‌ هات بۆ ڕۆما زۆر به‌دوامدا گه‌ڕا تا منی دۆزیه‌وه‌. <verse eid="2TI 1:17" /><verse number="18" style="v" sid="2TI 1:18" />داواكارم له‌‏ڕۆژی لـێپرسینه‌وه‌ خوداوه‌ند به‌زه‌یی پیابێته‌وه‌، تۆ باش ده‌زانیت كاتێ‌ له‌ئه‌فه‌سۆس بووم ئه‌و چه‌ند خزمه‌تی كردم.<verse eid="2TI 1:18" /></para>
  <chapter eid="2TI 1" />
  <chapter number="2" style="c" sid="2TI 2" />
  <para style="s1">به‌شداری ئازار بكه‌</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1" />تۆ ئه‌ی كوڕی خۆم، به‌هێزبه‌ به‌و به‌ره‌كه‌ته‌ی له‌‏عیسای مه‌سیح‏دایه‌. <verse eid="2TI 2:1" /><verse number="2" style="v" sid="2TI 2:2" />هه‌روه‌ها ئه‌وه‌ی له‌منه‌وه‌ بیستووته‌ له‌به‌رده‌م چه‌نده‌ها شایه‌ت، بیده‌ به‌و كه‌سانه‌ی پشتیان پێ‌ده‌به‌سترێ‌و توانای ئه‌وه‌یان هه‌یه‌ خه‌ڵكیتر فێر بكه‌ن. <verse eid="2TI 2:2" /><verse number="3" style="v" sid="2TI 2:3" />به‌شداری ئازار بكه‌ وه‌ك سه‌ربازێكی چاك بۆ عیسای مه‌سیح. <verse eid="2TI 2:3" /><verse number="4" style="v" sid="2TI 2:4" />سه‌ربازێك بیه‌وێ‌ سه‌رۆكه‌كه‌ی ڕازی بكات، خۆی خه‌ریك ناكات به‌كاروباری ژیانی ڕۆژانه‌. <verse eid="2TI 2:4" /><verse number="5" style="v" sid="2TI 2:5" />یاریزان هه‌رگیز پاداشتی سه‌ركه‌وتن وه‌رناگرێ‌ گه‌ر پێشبڕكێ‌ به‌گوێره‌ی یاسای یاریه‌كه‌ نه‌بێت. <verse eid="2TI 2:5" /><verse number="6" style="v" sid="2TI 2:6" />هه‌روه‌ها ئه‌و جوتیاره‌ی ماندوو ده‌بێت ده‌بێ‌ یه‌كه‌م كه‌س بێت به‌شی خۆی وه‌رگرێ‌ له‌ به‌روبووم‏دا. <verse eid="2TI 2:6" /><verse number="7" style="v" sid="2TI 2:7" />بیركه‌وه‌ له‌وه‌ی ده‌یڵێم، خوداوه‌ند یارمه‌تیت ده‌دات له‌‏هه‌موو شتێك تێبگه‌یت.</para>
  <para style="p" vid="2TI 2:7">‏ <verse eid="2TI 2:7" /><verse number="8" style="v" sid="2TI 2:8" />یادی عیسای مه‌سیح بكه‌، ئه‌وه‌ی له‌نێو مردووان هه‌ستایه‌وه‌، له‌‏نه‌وه‌ی داود بوو به‌گوێره‌ی مزگێنی من، <verse eid="2TI 2:8" /><verse number="9" style="v" sid="2TI 2:9" />ئه‌وه‌ی له‌پێناوی‏دا ئازار ده‌چێژم‏و كۆت‎كراوم وه‌ك تاوانبارێك، به‌ڵام ووشه‌ی خودا به‌‏زنجیر نابه‌سترێته‌وه‌. <verse eid="2TI 2:9" /><verse number="10" style="v" sid="2TI 2:10" />له‌به‌رئه‌وه‌ به‌رگه‌ی هه‌موو شتێك ده‌گرم، له‌پێناوی ئه‌وانه‌ی خودا هه‌ڵیبژاردن، تا ئه‌وانیش ڕزگاری‏و شكۆمه‌ندی هه‌تاهه‌تایی به‌ده‌ست‎بهێنن كه‌ به‌هۆی عیسای مه‌سیحه‌.<verse eid="2TI 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 2:11" />ئه‌مه‌ به‌دڵنیایی ڕاسته‌:</para>
  <para style="p" vid="2TI 2:11">‏(گه‌ر له‌گه‌ڵ مه‌سیح بمرین،</para>
  <para style="p" vid="2TI 2:11">له‌گه‌ڵ ئه‌و ده‌ژین،</para>
  <para style="p" vid="2TI 2:11">‏ <verse eid="2TI 2:11" /><verse number="12" style="v" sid="2TI 2:12" />گه‌ر له‌پێناویدا دان‏بگرین،</para>
  <para style="p" vid="2TI 2:12">له‌گه‌ڵی فه‌رمانڕه‌وایی ده‌كه‌ین،</para>
  <para style="p" vid="2TI 2:12">گه‌ر ئێمه‌ نكۆڵی لێ‌بكه‌ین،</para>
  <para style="p" vid="2TI 2:12">ئه‌ویش نكۆڵیمان لێ‌ده‌كات،</para>
  <para style="p" vid="2TI 2:12">‏ <verse eid="2TI 2:12" /><verse number="13" style="v" sid="2TI 2:13" />گه‌ر ئێمه‌ دڵسۆز نه‌بین،</para>
  <para style="p" vid="2TI 2:13">ئه‌و به‌دڵسۆزی ده‌مێنێته‌وه‌،</para>
  <para style="p" vid="2TI 2:13">چونكه‌ ناتوانێ‌ نكۆڵی له‌خۆی ‎بكات.)<verse eid="2TI 2:13" /></para>
  <para style="s1">ئیشكه‌ری ووشه‌ی ڕاست</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14" />ئه‌م شتانه‌یان بیربخه‌وه‌و له‌شه‌ڕه‌‏قسه‌ ئاگاداریان بكه‌وه‌ له‌به‌رده‌م خودا، چونكه‌ ئه‌مه‌ هیچ ‏سوودێكی نییه‌ جگه‌ له‌سه‌ر لـێ‌تێكدانی ئه‌وانه‌ نه‌بێت كه‌ گوێی بۆ ده‌گرن. <verse eid="2TI 2:14" /><verse number="15" style="v" sid="2TI 2:15" />هه‌وڵ‎بده‌ ڕه‌زامه‌ندی خودا به‌ده‌ست‎بهێنیت، ببیت به‌‏ئیشكه‌رێك كه‌وا شتێك ناكات جێی شه‌رم بێت‎و ووشه‌ی ڕاستی به‌‏راستی ڕوون بكه‌یته‌وه‌. <verse eid="2TI 2:15" /><verse number="16" style="v" sid="2TI 2:16" />خۆت دووربخه‌وه‌ له‌‏قسه‌ی هیچ‏و پووچی هه‌ندێ‌ كه‌س، ئه‌وه‌ی زیاتر خه‌ڵكی له‌خودا دوورده‌خاته‌وه‌، <verse eid="2TI 2:16" /><verse number="17" style="v" sid="2TI 2:17" />ئه‌وانه‌ ووشه‌كانیان ده‌وروبه‌ره‌ی ده‌خوات وه‌ك نه‌خۆشیه‌كی كوشنده‌، مه‌به‌ستم له‌‏هیمینایۆس‏و فیلیتۆسه‌، <verse eid="2TI 2:17" /><verse number="18" style="v" sid="2TI 2:18" />ئه‌وانه‌ له‌ڕێگای ڕاست ده‌رچوون‏و ده‌ڵێن هه‌ستانه‌وه‌ ڕوویداوه‌، به‌م شێوه‌یه‌ باوه‌ڕی هه‌ندێ‌ كه‌سیان تێكداوه‌. <verse eid="2TI 2:18" /><verse number="19" style="v" sid="2TI 2:19" />به‌ڵام ئه‌و بناغه‌ به‌هێزه‌ی خودا دایناوه‌ به‌پته‌وی ده‌مێنێته‌وه‌، ئه‌م مۆره‌ی له‌سه‌ره‌: [[خوداوه‌ند ئه‌وانه‌ی هی خۆیه‌تی ده‌یانناسێت.]] و (ئه‌وه‌ی ناوی خوداوه‌ند بهێنێت‏، ده‌بێ‌ له‌ گوناه‌ دووربكه‌وێته‌وه‌.)</para>
  <para style="p" vid="2TI 2:19">‏ <verse eid="2TI 2:19" /><verse number="20" style="v" sid="2TI 2:20" />له‌‏ماڵێكی گه‌وره‌دا هه‌ر جامی زێڕو زیوی تێدا نییه‌، به‌ڵكو جامی ته‌خته‌و له‌قوڕ دروست كراویش، هه‌ندێكیان بۆ ڕێزلێنانن ئه‌وانی تر بۆ كاروباری ئاسایین. <verse eid="2TI 2:20" /><verse number="21" style="v" sid="2TI 2:21" />جا ئه‌گه‌ر یه‌كێك خۆی پاك‎كرده‌وه‌ له‌‏هه‌موو ئه‌و خراپانه‌ی، ئه‌وا ده‌بێت به‌جامێك بۆ ڕێزلێنان‏، پیرۆزو سوودبه‌خشه‌ بۆ خاوه‌نه‌كه‌ی، ئاماده‌یه‌ بۆ هه‌موو كارێكی چاك.<verse eid="2TI 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 2:22" />له‌‏ئاره‌زووه‌كانی گه‌نجێتی دووربكه‌وه‌، به‌دوای ڕاست‎ودروستیو باوه‌ڕو خۆشه‌ویستی‏و ئاشتی بگه‌ڕێ‌ له‌گه‌ڵ ئه‌وانه‌ی به‌دڵێكی پاك خوداوه‌ند بانگ‎ده‌كه‌ن. <verse eid="2TI 2:22" /><verse number="23" style="v" sid="2TI 2:23" />له‌گفتوگۆی هیچ‎و پووچ دووربكه‌ونه‌وه‌، تۆ ده‌زانی ئه‌وه‌ ده‌بێته‌ هۆی شه‌ڕو ناكۆكی. <verse eid="2TI 2:23" /><verse number="24" style="v" sid="2TI 2:24" />به‌نده‌ی خوداوه‌ند نابێ‌ شه‌ڕفرۆش بێت، به‌ڵكو ده‌بێ‌ به‌به‌زه‌یی‏و زمان شیرین بێت له‌گه‌ڵ هه‌مووان، توانای فێركردنی هه‌بێ‌، له‌كاتی ته‌نگانه‌ دان به‌خۆیبگرێ‌. <verse eid="2TI 2:24" /><verse number="25" style="v" sid="2TI 2:25" />ئه‌وانه‌ی به‌ربه‌ره‌كانی ده‌كه‌ن به‌‏نه‌رم‏و نیانی ڕاستیان بكاته‌وه‌، له‌وانه‌یه‌ خودا به‌ره‌و تۆبه‌كردن‏و ناسینی ڕاستیان ببات، <verse eid="2TI 2:25" /><verse number="26" style="v" sid="2TI 2:26" />تا هۆشیان‎بێته‌وه‌ به‌خۆیان‏و له‌داوی شه‌یتان ڕابكه‌ن، ئه‌وه‌ی به‌ندیكردوون تا خواستی ئه‌و جێ‌به‌جێ‌ بكه‌ن.<verse eid="2TI 2:26" /></para>
  <chapter eid="2TI 2" />
  <chapter number="3" style="c" sid="2TI 3" />
  <para style="s1">نیشانه‌كانی ڕۆژانی دوایی</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1" />شتێكیتر هه‌یه‌ بیزانه‌، كاتێكی ناخۆش‏و خراپ دێت ‏له‌ڕۆژانی دواییدا، <verse eid="2TI 3:1" /><verse number="2" style="v" sid="2TI 3:2" />خه‌ڵكی خۆیان خۆش‏ده‌وێ‌، پاره‌یان خۆش‏ده‌وێ‌، لووت‎به‌رز ده‌بن، شانازی به‌خۆیان ده‌كه‌ن، جنێوده‌ده‌ن، گوێڕایه‌ڵی دایك‏و باوك نابن، هیچیان له‌به‌رچاو نابێت، گڵاون، <verse eid="2TI 3:2" /><verse number="3" style="v" sid="2TI 3:3" />بێ‌به‌زه‌یی ده‌بن، له‌یه‌كتر خۆش‏نابن، قسه‌ دروست ده‌كه‌ن، به‌ڕه‌ڵلا ده‌بن، دڕنده‌ن، حه‌ز له‌‏چاكه‌ ناكه‌ن، <verse eid="2TI 3:3" /><verse number="4" style="v" sid="2TI 3:4" />ئه‌وانه‌ ناپاكن، سه‌ره‌ڕۆن، لووت‏به‌رزی كوێری‏كردوون، ڕابواردنیان به‌لاوه‌ باشتره‌ له‌‏خۆشه‌ویستی خودا، <verse eid="2TI 3:4" /><verse number="5" style="v" sid="2TI 3:5" />به‌ڕواڵه‌ت له‌خواترس دیارن، به‌ڵام هێزو ناوه‌ڕۆكی خواترسی ڕه‌ت‏ده‌كه‌نه‌وه‌، جا له‌و كه‌سانه‌ دوور بكه‌ونه‌وه‌.<verse eid="2TI 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 3:6" />ته‌نانه‌ت هه‌ندێك له‌وانه‌ ده‌گه‌ڕێن به‌ماڵاندا، هه‌وڵ‎ده‌ده‌ن ئه‌و ژنه‌ لاوازو گوناهبارانه‌ بخه‌ڵه‌تێنن كه‌ شوێنی هه‌موو جۆره‌ ئاره‌زوویه‌كی خراپ كه‌وتوون‏و <verse eid="2TI 3:6" /><verse number="7" style="v" sid="2TI 3:7" />هه‌میشه‌ گوێ‌ بۆ فێركردن ده‌گرن، به‌ڵام هه‌رگیز ناتوانن به‌ته‌واوی ڕێگای ڕاستی بناسن! <verse eid="2TI 3:7" /><verse number="8" style="v" sid="2TI 3:8" />هه‌روه‌ك یه‌نیس‏و یه‌مبریسی [جادوگه‌ران] به‌ربه‌ره‌كانی موسایان‎كرد، هه‌روه‌ها ئه‌وانه‌ش به‌ربه‌ره‌كانی ڕاستی ده‌كه‌ن، ئه‌و كه‌سانه‌ مێشكیان تێكچووه‌و له‌لایه‌ن باوه‌ڕه‌وه‌ ڕه‌تكراونه‌ته‌وه‌. <verse eid="2TI 3:8" /><verse number="9" style="v" sid="2TI 3:9" />جا ئه‌وانه‌ زیاتر پێش ناكه‌ون، چونكه‌ بێ‌مێشكییان بۆ هه‌موو كه‌سێك ده‌رده‌كه‌وێ‌، هه‌روه‌ك بێ‌مێشكی یه‌نیس‏و یه‌مبریس ده‌ركه‌وت.<verse eid="2TI 3:9" /></para>
  <para style="s1">له‌سه‌ر باوه‌ڕت بمێنه‌وه‌</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10" />به‌ڵام تۆ، هـه‌مـوو شتێك ده‌زانی ده‌رباره‌ی: فێركردنم، هه‌ڵسوكه‌وتم، ئامانجم له‌ژیان، باوه‌ڕم، دان ‎به‌خۆگرتنم، خۆشه‌ویستیم، چه‌سپاویم، <verse eid="2TI 3:10" /><verse number="11" style="v" sid="2TI 3:11" />‏چه‌وسانه‌وه‌م‏و ئازارم‏، هه‌روه‌ها ئه‌و شتانه‌ی له‌شاری ئه‌نتاكیاو ئیقونیه‌و له‌سته‌ره‌ به‌سه‌رم هات، ئه‌و چه‌وسانه‌وه‌ی به‌رگه‌یم گرت، به‌ڵام خوداوه‌ند له‌ هه‌موویان ڕزگاری كردم. <verse eid="2TI 3:11" /><verse number="12" style="v" sid="2TI 3:12" />‏هه‌موو ئه‌وانه‌ی ده‌یانه‌وێ‌ به‌ له‌خواترسی بژین له‌‏عیسای مه‌سیح، ده‌چه‌وسێنه‌وه‌. <verse eid="2TI 3:12" /><verse number="13" style="v" sid="2TI 3:13" />به‌ڵام خراپه‌كارو فێڵبازه‌كان به‌ره‌و خراپتر ده‌ڕۆن، خه‌ڵكی دیكه‌ هه‌ڵده‌خه‌ڵه‌تێنن‏و كه‌سانی دیكه‌ش ئه‌وان هه‌ڵده‌خه‌ڵه‌تێنن! <verse eid="2TI 3:13" /><verse number="14" style="v" sid="2TI 3:14" />به‌ڵام تۆ‏، به‌رده‌وام‏به‌ له‌سه‌ر ئه‌وه‌ی فێریبوویت‎و بێ‌ گومان بووی‎و زانیت له‌سه‌رده‌ستی كێ‌ فێربوویت. <verse eid="2TI 3:14" /><verse number="15" style="v" sid="2TI 3:15" />تۆ له‌‏منداڵیه‌وه‌ كتێبی پیرۆز ده‌ناسیت، ئه‌وه‌ی داناییت ده‌داتێ‌ بۆ ڕزگاری به‌هۆی باوه‌ڕ به‌‏عیسای مه‌سیح. <verse eid="2TI 3:15" /><verse number="16" style="v" sid="2TI 3:16" />هه‌موو كتێبی پیرۆز به‌وه‌حی له‌‏خودا هاتووه‌و سوودبه‌خشه‌ بۆ فێركردن‏و سه‌رزه‌نشت‏و ڕاسته‌ڕێ‌كردن، هه‌روه‌ها بۆ ته‌مێكردن بۆ ڕاست‏ودروستی، <verse eid="2TI 3:16" /><verse number="17" style="v" sid="2TI 3:17" />تاوه‌كو ‏مرۆڤی خودا ئاماده‌بێت بۆ هه‌موو كردارێكی باش.<verse eid="2TI 3:17" /></para>
  <chapter eid="2TI 3" />
  <chapter number="4" style="c" sid="2TI 4" />
  <para style="s1">ووشه‌ی خودا ڕابگه‌ێنه‌</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1" />‏له‌به‌رده‌م خوداو عیسای مه‌سیحی خوداوه‌ند، ئه‌وه‌ی حوكم به‌سه‌ر زیندووان‏و مردووان ده‌دات، له‌‏كاتی گه‌ڕانه‌وه‌ی پادشاهێتیه‌كه‌ی، داوات لـێ‌ده‌كه‌م: <verse eid="2TI 4:1" /><verse number="2" style="v" sid="2TI 4:2" />‏ووشه‌ی خودا ڕابگه‌ێنه‌، خۆتی بۆ ته‌رخان بكه‌ له‌‏كاتی باش‏و خراپ، خه‌ڵكی ڕاسته‌ڕێ‌ بكه‌، سه‌رزه‌نشت بكه‌، ووره‌یان به‌‏رزبكه‌وه‌ به‌ئارام‏گرتن‏و فێركردن. <verse eid="2TI 4:2" /><verse number="3" style="v" sid="2TI 4:3" />چونكه‌ كاتێك دێت خه‌ڵكی نایانه‌وێ‌ هیچ ده‌رباره‌ی فێركردنی ڕاست بزانن، به‌ڵكو به‌پێی ئاره‌زووی تایبه‌تی خۆیان مامۆستایه‌ك هه‌ڵده‌بژێرن كه‌وا به‌شێوه‌یه‌ك له‌گه‌ڵیان بدوێ‌ ئه‌وان حه‌ز بكه‌ن گوێی لـێ‌ بگرن. <verse eid="2TI 4:3" /><verse number="4" style="v" sid="2TI 4:4" />ئه‌وانه‌ نایانه‌وێ‌ ڕاستی ببیستن، چه‌واشه‌ ده‌بن به‌ئه‌فسانه‌و شتی هیچ‏و پووچ. <verse eid="2TI 4:4" /><verse number="5" style="v" sid="2TI 4:5" />به‌ڵام تۆ، له‌ هه‌موو شتێك ووریابه‌‏، له‌‏ئازاردا دان‏بگره‌‏، به‌كاری مزگێنی‏ده‌ر هه‌سته‌، ‏به‌كاری خۆت هه‌سته‌ به‌ته‌واوی. <verse eid="2TI 4:5" /><verse number="6" style="v" sid="2TI 4:6" />له‌باره‌ی من، كاتی ئه‌وه‌ هاتووه‌ ژیانم بكه‌م به‌ قوربانی‏، كاتی كۆچ‎كردنم نزیك‏بووه‌ته‌وه‌. <verse eid="2TI 4:6" /><verse number="7" style="v" sid="2TI 4:7" />تێكۆشانیكی باش تێكۆشاوم، قوناغی خۆم بڕیوه‌، پارێزگاری باوه‌ڕم كردووه‌. <verse eid="2TI 4:7" /><verse number="8" style="v" sid="2TI 4:8" />ئێستا تاجی ڕاست‎ودروستی چاوه‌ڕێم ده‌كات، ئه‌وه‌ی خوداوه‌ند كه‌ دادوه‌ری ڕاست‎ودروسته‌ له‌و ڕۆژه‌ ده‌مداتێ‌، ئه‌مه‌ش ته‌نها بۆ من نییه‌، به‌ڵكو بۆ هه‌موو ئه‌وانه‌یه‌ كه‌ به‌دڵ ئاره‌زووی هاتنه‌وه‌ی ده‌كه‌ن.<verse eid="2TI 4:8" /></para>
  <para style="s1">دوا ڕاسپارده‌</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9" />هه‌وڵ بده‌ به‌خێرایی بۆ لام بێیت، <verse eid="2TI 4:9" /><verse number="10" style="v" sid="2TI 4:10" />چونكه‌ دیماس له‌به‌ر خۆشه‌ویستی ئه‌م جیهانه‌ منی به‌جێ‌هێشت‏و بۆ شاری ته‌سالۆنیكی ڕۆیشت، كریسكیسیش بۆ ناوچه‌ی غه‌ڵاتیه‌ ڕۆیشت‎و تیتۆسیش بۆ دلماتیه‌. <verse eid="2TI 4:10" /><verse number="11" style="v" sid="2TI 4:11" />‏له‌ لۆقا زیاتر كه‌سی ترم لا نییه‌. بڕۆ بۆ لای مه‌رقۆس‏و له‌گه‌ڵ خۆت بیهێنه‌‏، چونكه‌ زۆر سوودی لـێ‌وه‌رده‌گرم له‌خزمه‌تكردن. <verse eid="2TI 4:11" /><verse number="12" style="v" sid="2TI 4:12" />تیخیكۆسم ناردووه‌ بۆ ئه‌فه‌سۆس. <verse eid="2TI 4:12" /><verse number="13" style="v" sid="2TI 4:13" />كاتێ‌ هاتی له‌گه‌ڵ خۆت عه‌باكه‌م بۆ بهێنه‌، ئه‌وه‌ی له‌‏شاری ترواس لای كارپۆس به‌جێم هێشتووه‌، هه‌روه‌ها په‌رتووكه‌كانم به‌تایبه‌تی ئه‌و ده‌ستخه‌تانه‌ی له‌سه‌ر چه‌رم نووسراون.</para>
  <para style="p" vid="2TI 4:13">‏ <verse eid="2TI 4:13" /><verse number="14" style="v" sid="2TI 4:14" />ئه‌سكه‌نده‌ری مسگه‌ر زۆر خراپه‌ی به‌رامبه‌ر كردم، خوداوه‌ند تۆڵه‌ی لـێ‌ده‌كاته‌وه‌ له‌سه‌ر ئه‌و كارانه‌ی. <verse eid="2TI 4:14" /><verse number="15" style="v" sid="2TI 4:15" />تۆش خۆت لێی بپارێزه‌‏، چونكه‌ زۆر به‌توندی به‌رهه‌ڵستی قسه‌كانمانی كرد.</para>
  <para style="p" vid="2TI 4:15">‏ <verse eid="2TI 4:15" /><verse number="16" style="v" sid="2TI 4:16" />كاتێ‌ یه‌كه‌مجار به‌رگریم له‌‏خۆم ‎كرد كه‌س له‌گه‌ڵم نه‌هات، به‌ڵكو هه‌موویان به‌جێیان‎هێشتم، خودا له‌سه‌ر ئه‌مه‌ بیان‎به‌خشێت. <verse eid="2TI 4:16" /><verse number="17" style="v" sid="2TI 4:17" />به‌ڵام خوداوه‌ند له‌گه‌ڵم بوو به‌هێزی كردم، به‌مه‌ش توانیم مزگێنی ڕابگه‌ێنم تا هه‌موو گه‌لان ببیستن، ئه‌وه‌ بوو ڕزگاری كردم له‌ ده‌می شێر، <verse eid="2TI 4:17" /><verse number="18" style="v" sid="2TI 4:18" />هه‌ر خوداوه‌ندیش ڕزگارم ده‌كات له‌ هه‌موو خراپه‌یه‌ك‏و ده‌مپارێزێت بۆ پادشاهێتی ئاسمانی خۆی. بۆ ئه‌وه‌ شكۆمه‌ندی تاهه‌تایه‌! ئامین.<verse eid="2TI 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19" />سڵاو له‌ پریسكلاو ئه‌كیلاو خێزانی ئۆنیسیفورس بكه‌. <verse eid="2TI 4:19" /><verse number="20" style="v" sid="2TI 4:20" />ئه‌راستۆس له‌‏كۆرنسۆس مایه‌وه‌، به‌ڵام تروفیمۆس به‌‏نه‌خۆشی له‌‏شاری میلیتس به‌جێم‎هێشت. <verse eid="2TI 4:20" /><verse number="21" style="v" sid="2TI 4:21" />خێرابه‌ له‌‏هاتن پێش ‎ئه‌وه‌ی زستان ‎بێت. ئوپولۆس‏و پودیس‏و لینۆس‏و كلودیاو هه‌موو خوشك‏و برایانی ئێره‌ سڵاوت لـێ‌ده‌كه‌ن.<verse eid="2TI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22" />‏خوداوه‌ند له‌گه‌ڵ ڕۆحت بێت‏و به‌ره‌كه‌ت له‌گه‌ڵ هه‌مووتان بێت. ئامین.<verse eid="2TI 4:22" /></para>
  <chapter eid="2TI 4" />
</usx>