<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Biblica® Open Sorani Kurdish Book of Life</book>
  <para style="rem">‪Copyright © 1998 by Biblica, Inc.</para>
  <para style="h">فلیمۆن</para>
  <para style="toc1">نامه‌ی پۆڵس بۆ فلیمۆن</para>
  <para style="toc2">فلیمۆن</para>
  <para style="toc3">فلیمۆن</para>
  <para style="mt1">نامه‌ی پۆڵس بۆ فلیمۆن</para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1" />له‌ پۆڵسی به‌ندكراو له‌پێناوی عیسای مه‌سیح، هه‌ر‏وه‌ها له‌‏تیمۆساوسی براوه‌، بۆ فلیمۆنی هاوكاری خۆشه‌ویست‏، <verse eid="PHM 1:1" /><verse number="2" style="v" sid="PHM 1:2" />هه‌روه‌ها بۆ خوشكه‌ ئه‌پفییه‌ی خۆشه‌ویست‏و ئه‌رخیپۆسی هاوڕێمان له‌‏تێكۆشان‏و بۆ ئه‌و كۆمه‌ڵه‌ باوه‌ڕداره‌ی له‌‏ماڵه‌كه‌ت دایه‌. <verse eid="PHM 1:2" /><verse number="3" style="v" sid="PHM 1:3" />با به‌ره‌كه‌ت‎و ئاشتی خودای باوكمان‏و عیسای مه‌سیحی خوداوه‌ند بۆ ئێوه‌ بێ.<verse eid="PHM 1:3" /></para>
  <para style="s1">خۆشه‌ویستی‏و باوه‌ڕی فلیمۆن</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />هه‌ر كاتێ‌ یادت بكه‌م له‌نۆیژه‌كانم سوپاسی خودا ده‌كه‌م، <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />چونكه‌ هه‌واڵی باوه‌ڕو خۆشه‌ویستی تۆم بیستووه‌ به‌رامبه‌ر به‌ عیسای مه‌سیح‏و هه‌موو برایانی پیرۆز، <verse eid="PHM 1:5" /><verse number="6" style="v" sid="PHM 1:6" />داواكارم له‌خودا ئه‌و باوه‌ڕه‌ به‌هێز بكات كه‌ به‌یه‌كه‌وه‌ ده‌مانبه‌ستێته‌وه‌ له‌‏ناسینی هه‌موو ئه‌و چاكانه‌ی هه‌مانه‌ به‌هۆی مه‌سیحه‌وه‌. <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />ئه‌ی برا چه‌ند دڵشادو ووره‌ به‌رزم به‌ خۆشه‌ویستی تۆ، چونكه‌ دڵی برایانی پیرۆزت گه‌شانده‌وه‌.<verse eid="PHM 1:7" /></para>
  <para style="s1">داواكاری پۆڵس</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />هه‌رچه‌نده‌ مافی ئه‌وه‌م هه‌یه‌ به‌هۆی مه‌سیح، فه‌رمانت بۆ ده‌ربكه‌م سه‌باره‌ت به‌و كاره‌ی پێویسته‌ بیكه‌یت، <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />به‌ڵام له‌به‌ر ئه‌و خۆشه‌ویستیه‌ی هه‌مانه‌ داوات لـێ‌ده‌كه‌م، وه‌ك نوێنه‌رێك كه‌ ئێستا به‌ندكراوه‌ له‌پێناوی عیسای مه‌سیح، <verse eid="PHM 1:9" /><verse number="10" style="v" sid="PHM 1:10" />سه‌باره‌ت به‌ ئۆنسیمۆسی كوڕم، ئه‌وه‌ی له‌‏به‌ندیخانه‌ به‌هۆی من باوه‌ڕی هێنا، <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />ئه‌وه‌ی جاران بێ‌ كه‌ڵك بوو بۆ تۆ، به‌ڵام ئێستا كه‌ڵكی بۆ من‏و بۆ تۆ هه‌یه‌.</para>
  <para style="p" vid="PHM 1:11">‏ <verse eid="PHM 1:11" /><verse number="12" style="v" sid="PHM 1:12" />ئه‌و ده‌نێرمه‌وه‌ بۆ لات، وه‌ریبگره‌ وه‌ك پارچه‌یه‌ك له‌‏جگه‌رم. <verse eid="PHM 1:12" /><verse number="13" style="v" sid="PHM 1:13" />حه‌زم ده‌كرد لێره‌ لای خۆم بیهێڵمه‌وه‌، تا خزمه‌تی منی به‌ندكراو له‌پێناوی مزگێنی بكات له‌‏جیاتی تۆ. <verse eid="PHM 1:13" /><verse number="14" style="v" sid="PHM 1:14" />به‌ڵام نه‌مویست هیچ شتێك بێ‌ ڕه‌زامه‌ندی تۆ بكه‌م، تاوه‌كو ئه‌م كاره‌ چاكه‌ به‌خواستی خۆت بێت نه‌ك به‌ناچاری. <verse eid="PHM 1:14" /><verse number="15" style="v" sid="PHM 1:15" />له‌به‌رئه‌مه‌ ئۆنسیمۆس بۆ ماوه‌یه‌ك لێت دووركه‌وته‌وه‌، تاوه‌كو بۆ هه‌تاهه‌تایه‌ بگه‌ڕێته‌وه‌ لات، <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />جا له‌ئه‌مڕۆ به‌دواوه‌ كۆیله‌ نییه‌، به‌ڵكو باشتر له‌كۆیله‌، برایه‌كی خۆشه‌ویسته‌ له‌‏مه‌سیح. برایه‌كی خۆشه‌ویسته‌ بۆ من ئاخۆ چه‌ند زیاتر بێت بۆ تۆ؟ كه‌ له‌له‌ش‏و خوداوه‌ند هاوبه‌شن.<verse eid="PHM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17" />گه‌ر تۆ من به‌هاوبه‌شی خۆت داده‌نێیت، پێشوازی لـێ‌بكه‌ وه‌ك پێشوازی له‌من بكه‌یت. <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />گه‌ر له‌ شتێك خراپه‌ی به‌رامبه‌ر كردووی یاخود قه‌رزێكت به‌سه‌ریه‌وه‌ هه‌یه‌، له‌سه‌ر منی بنووسه‌. <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />من پۆڵسم به‌‏خه‌تی ده‌ستی خۆم ده‌ینووسم كه‌وا ده‌یده‌مه‌وه‌، نامه‌وێ‌ پێت بڵێم تۆ خۆشت قه‌رزاری منی. <verse eid="PHM 1:19" /><verse number="20" style="v" sid="PHM 1:20" />جا براگیان ئه‌م چاكه‌یه‌م له‌گه‌ڵ بكه‌ له‌پێناوی خوداوه‌ند، دڵخۆشم بكه‌ له‌‏مه‌سیح. <verse eid="PHM 1:20" /><verse number="21" style="v" sid="PHM 1:21" />له‌كاتێ‌ ئه‌م نامه‌یه‌ ده‌نووسم بۆت، باوه‌ڕم پێت هه‌یه‌ داواكاریه‌كه‌م جێ‌به‌جێ‌ ده‌كه‌یت، به‌ڵكو دڵنیام زیاتر ده‌كه‌یت له‌وه‌ی داوات لـێ‌ده‌كه‌م.<verse eid="PHM 1:21" /></para>
  <para style="s1">سڵاوی كۆتایی</para>
  <para style="p">
    <verse number="22" style="v" sid="PHM 1:22" />بێجگه‌ له‌مه‌ش، شوێنی مانه‌وه‌م بۆ ئاماده‌ بكه‌، چونكه‌ هیوادارم خودا نوێژه‌كانتان قبوڵ بكات‏و بمگه‌ڕێنێته‌وه‌ لاتان.<verse eid="PHM 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />ئه‌په‌فراس كه‌ له‌گه‌ڵم به‌ندكراوه‌ له‌‏پێناوی عیسای مه‌سیح سڵاوت لـێ‌ده‌كات، <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" />هه‌روه‌ها مه‌رقۆس‏و ئه‌رسته‌رخۆس‎و دیماس‏و لۆقای ئیشكه‌ران له‌گه‌ڵم سڵاوت لـێ‌‏ده‌كه‌ن.<verse eid="PHM 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25" />به‌ره‌كه‌تی عیسای مه‌سیحی خوداوه‌ندمان له‌گه‌ڵ ڕۆحتان بێت. ئامین.<verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>