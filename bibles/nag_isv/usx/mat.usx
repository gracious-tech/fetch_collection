<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Indian Revised Version (IRV) Nagamese</book>
  <para style="ide">UTF-8</para>
  <para style="h">Matthew</para>
  <para style="toc1">Matthew He Likha Bhal Khobor</para>
  <para style="toc2">Matthew</para>
  <para style="toc3">Mat</para>
  <para style="mt">Matthew</para>
  <chapter number="1" style="c" sid="MAT 1"/>
  <para style="s">Jisu Khrista Laga Purbo Khandan</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1"/>Abraham laga chokra<note caller="+" style="f"><char style="fr" closed="false">1.1 </char><char style="fq" closed="false">Chokra </char><char style="ft" closed="false">Purbons</char></note>, David laga chokra, Jisu Khrista laga purbo khandan laga likhi kene rakha kitab. <verse eid="MAT 1:1"/><verse number="2" style="v" sid="MAT 1:2"/>Abraham, Isaac laga baba hoise, aru Isaac, Jacob laga baba hoise, aru Jacob, Judah aru tai laga bhai-kokai khan laga baba hoise. <verse eid="MAT 1:2"/><verse number="3" style="v" sid="MAT 1:3"/>Judah pora Perez laga baba, aru Zerah pora Tamar laga baba, Perez pora Hezron laga baba hoise, aru Hezron, Ram laga baba hoise. <verse eid="MAT 1:3"/><verse number="4" style="v" sid="MAT 1:4"/>Ram, Amminadab laga baba hoise, aru Amminadab, Nahshon laga baba hoise, aru Nahshon, Salmon laga baba hoise. <verse eid="MAT 1:4"/><verse number="5" style="v" sid="MAT 1:5"/>Salmon, Boaz laga baba hoise, etu to Rahab logot pora hoise, aru Boaz, Obed laga baba Ruth logot pora hoise, aru Obed, Jesse laga baba hoise. <verse eid="MAT 1:5"/><verse number="6" style="v" sid="MAT 1:6"/>Jesse, Raja David laga baba hoise, aru David, Solomon laga baba, Uriah laga maiki logot pora hoise. <verse eid="MAT 1:6"/><verse number="7" style="v" sid="MAT 1:7"/>Solomon pora Rehoboam laga baba hoise, aru Rehoboam pora Abijah laga baba hoise, aru Abijah pora Asa laga baba hoise. <verse eid="MAT 1:7"/><verse number="8" style="v" sid="MAT 1:8"/>Asa pora Jehoshaphat laga baba hoise, aru Jehoshaphat pora Joram laga baba hoise, aru Joram pora Uzziah laga baba hoise. <verse eid="MAT 1:8"/><verse number="9" style="v" sid="MAT 1:9"/>Uzziah pora Jotham laga baba hoise, aru Jotham pora Ahaz laga baba hoise, aru Ahaz pora Hezekiah laga baba hoise. <verse eid="MAT 1:9"/><verse number="10" style="v" sid="MAT 1:10"/>Hezekiah pora Manasseh laga baba hoise, aru Manasseh pora Amon laga baba hoise, aru Amon pora Josiah laga baba hoise. <verse eid="MAT 1:10"/><verse number="11" style="v" sid="MAT 1:11"/>Josiah pora Jechoniah aru tai laga bhai-kokai khan laga baba hoise jitia taikhan ke Babylon desh te dhurikene loi jaise.<verse eid="MAT 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12"/>Babylon te loija pichete, Jechoniah pora Shealtiel laga baba hoise, aru Shealtiel pora Zerubbabel laga baba hoise. <verse eid="MAT 1:12"/><verse number="13" style="v" sid="MAT 1:13"/>Zerubbabel pora Abiud laga baba hoise, aru Eliakim pora Azor laga baba hoise. <verse eid="MAT 1:13"/><verse number="14" style="v" sid="MAT 1:14"/>Azor pora Zadok laga baba hoise, aru Zadok pora Achim laga baba hoise, aru Achim pora Eliud laga baba hoise. <verse eid="MAT 1:14"/><verse number="15" style="v" sid="MAT 1:15"/>Eliud pora Eleazar laga baba hoise, aru Eleazar pora Matthan laga baba hoise, aru Matthan pora Jacob laga baba hoise. <verse eid="MAT 1:15"/><verse number="16" style="v" sid="MAT 1:16"/>Jacob pora Joseph laga baba hoise, jun laga maiki Mary asele, jun pora Jisu ke jonom dise, aru Khrista koi kene matise. <verse eid="MAT 1:16"/><verse number="17" style="v" sid="MAT 1:17"/>Etu karone, sob khandan Abraham pora loi kene David tak choudah khandan thakise, aru David pora loi kene jun khan ke Babylon te loi jaise aru Jisu Khrista laga jonom etu tak choudah khandan thakise.<verse eid="MAT 1:17"/></para>
  <para style="s">Jisu Khrista Jonom Huwa</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18"/>Jisu Khrista laga jonom eneka pora hoise. Tai laga ama, Mary Joseph ke shadi kori bole kotha milai loise, kintu tai duijon shadi nohua age te, Pobitro Atma dwara bacha pet te bukhi ja jani jaise. <verse eid="MAT 1:18"/><verse number="19" style="v" sid="MAT 1:19"/>Kintu Joseph, tai laga mota, ekjon dharmik manu asele aru sob manu age te taike bodnam nadibo nimite, tai lukaikene taike chari bole bhabona kori loise. <verse eid="MAT 1:19"/><verse number="20" style="v" sid="MAT 1:20"/>Jitia tai eitu khan bhabi thakise, Probhu laga ekjon sorgodoth tai laga sapna te ahise, aru eneka koise, “Joseph, David laga chokra, Mary ke tumi laga maiki kori bole bhoi na koribi, kele koile juntu ekjon bacha tai laga pet te bukhikena ase etu Pobitro Atma pora ase. <verse eid="MAT 1:20"/><verse number="21" style="v" sid="MAT 1:21"/>Tai ekjon chokra bacha ke jonom dibo, aru tumi tai laga naam Jisu rakhibo, kelemane Tai he Tai laga manu khan ke taikhan laga paap pora bachai lobo.” <verse eid="MAT 1:21"/><verse number="22" style="v" sid="MAT 1:22"/>Isor pora bhabobadi khan dwara kowa kotha khan pura hobole karone eitu khan sob tineka he hoi jaise. Eneka likha ase,<verse eid="MAT 1:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="MAT 1:23"/>“Huni bhi, ekjon kumari maiki pora tai laga pet te bacha bukhi bo aru ekjon chokra ke jonom dibo, aru taikhan Tai laga naam Immanuel” rakhibo- etu motlob ase, “Isor amikhan logote ase.<note caller="+" style="f"><char style="fr" closed="false">1.23 </char><char style="fq" closed="false">Isor amikhan logote ase </char><char style="ft" closed="false">Isa. 7:14</char></note>”<verse eid="MAT 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24"/>Etu pichete Joseph ghumai thaka pora uthijaise aru ki kotha Isor laga sorgodoth pora hukum dise tai etu manise aru Mary ke tai laga maiki bonai loise. <verse eid="MAT 1:24"/><verse number="25" style="v" sid="MAT 1:25"/>Kintu tai laga maiki pora bacha jonom nohua tak, tai laga usorte janai aru tai bacha laga naam Jisu matise.<verse eid="MAT 1:25"/></para>
  <chapter eid="MAT 1"/>
  <chapter number="2" style="c" sid="MAT 2"/>
  <para style="s">Gyaani Manu Khan Aha</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1"/>Jitia Herod raja thakise, etu somoite Judea desh laga Bethlehem town te Jisu jonom hoise. Aru gyaan thaka manu khan purab phale thaka desh pora jonom laga kotha huni kene Jerusalem te ahise, <verse eid="MAT 2:1"/><verse number="2" style="v" sid="MAT 2:2"/>aru eneka hudise, “Yehudi khan laga Raja hobole jonom huwa to kot te ase? Kilekoile amikhan Tai laga tara purab te dikhise, aru amikhan Taike aradhana kori bole ahise.” <verse eid="MAT 2:2"/><verse number="3" style="v" sid="MAT 2:3"/>Kintu jitia Herod raja etu hunise, tai aru tai logote Jerusalem te thaka khan sob laga mon chinta hoise. <verse eid="MAT 2:3"/><verse number="4" style="v" sid="MAT 2:4"/>Etu pichete Herod raja pora mukhyo purohit aru niyom likha manu khan ke eke logote mati kene hudise, “Khrista to kun jagate jonom hobo?” <verse eid="MAT 2:4"/><verse number="5" style="v" sid="MAT 2:5"/>Taikhan taike koise, “Judea laga Bethlehem te, kele koile etu he bhabobadi khan pora Isor kotha te likhise,<verse eid="MAT 2:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="MAT 2:6"/>‘Kintu tumi Bethlehem, Judah<note caller="+" style="f"><char style="fr" closed="false">2.6 </char><char style="fq" closed="false">Judah </char><char style="ft" closed="false">Mic. 5:2</char></note> desh te thaka,</para>
  <para style="q" vid="MAT 2:6">Apnikhan Judah desh laga cholawta khan pora komti nohoi,</para>
  <para style="q" vid="MAT 2:6">Kilekoile apnikhan majot pora ekjon raja ulabo,</para>
  <para style="q" vid="MAT 2:6">Jun Ami laga Israel manu khan ke Rokhiya kori cholai loijabo.’”<verse eid="MAT 2:6"/></para>
  <para style="m">
    <verse number="7" style="v" sid="MAT 2:7"/>Etu pichete, Herod pora lukaikene gyaani manu khan ke kotha korise aru tara ki homoi te ulaise etu bhal pora jani loise. <verse eid="MAT 2:7"/><verse number="8" style="v" sid="MAT 2:8"/>Etu pichete tai gyaani manu khan ke Bethlehem te eneka koi kene pathaise, “Jabi aru bhal pora etu bacha ke bisari bhi. Kitia apnikhan taike pabo, amike kobi, kele koile Moi bhi ta te jai kene Taike aradhana koribo.” <verse eid="MAT 2:8"/><verse number="9" style="v" sid="MAT 2:9"/>Raja laga kotha khan huna pichete, taikhan jai jaise, aru sabi, taikhan juntu tara purab te dikhise etu eke tara aru dikhise aru taikhan etu tara laga piche jaise. Etu tara taikhan age-age jai kene bacha thaka jaga uporte rukhi jaise. <verse eid="MAT 2:9"/><verse number="10" style="v" sid="MAT 2:10"/>Jitia taikhan tara ke dikhise, taikhan bisi khushi hoi kene rukhibo. <verse eid="MAT 2:10"/><verse number="11" style="v" sid="MAT 2:11"/>Titia taikhan ghor bhitor te ghusi se chutu bacha ke Tai laga ama Mary pora dhuri thaka dikhise. Taikhan athukari kene Taike aradhana korise. Taikhan khushi pora taikhan laga khajana khan khuli kene suna, aru dhona, aru bhal gundh laga tel khan daan korise. <verse eid="MAT 2:11"/><verse number="12" style="v" sid="MAT 2:12"/>Kintu Isor pora taikhan laga sapna te Herod logote wapas najabi koi kene hoshiar kori dise, etu nimite dusra rasta pora taikhan nijor desh te wapas jai jaise.<verse eid="MAT 2:12"/></para>
  <para style="s">Egypt te polai Juwa</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13"/>Kintu taikhan jai ja-a pichete, Isor laga sorgodoth sapna te ahikena Joseph ke koise, “Uthibi, bacha aru ama ke loi kene Egypt te polai jabi aru ami nokuwa tak ta te thakibi, kele koile Herod Raja pora etu bacha ke mora bole bisari bole ase.” <verse eid="MAT 2:13"/><verse number="14" style="v" sid="MAT 2:14"/>Titia utu rati te, Joseph uthikena bacha aru ama ke loi kene Egypt desh te polai jaise. <verse eid="MAT 2:14"/><verse number="15" style="v" sid="MAT 2:15"/>Tai Herod namora tak ta te he thakise. Juntu kotha Isor laga bhabobadi pora koi disele, etu pura hoi jaise, “Egypt pora Ami laga chokra ke mati loise<note caller="+" style="f"><char style="fr" closed="false">2.15 </char><char style="fq" closed="false">Egypt pora Ami laga chokra ke mati loise </char><char style="ft" closed="false">Hos.11:1</char></note>.”<verse eid="MAT 2:15"/></para>
  <para style="s">Herod Pora Bacha Khan Morai Diya</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16"/>Jitia Herod gyaani manu khan pora taike thogaise koi kene janise, tai bisi khong uthise. Etu nimite tai laga sipahi khan ke pathaikena jiman dui saal pora niche mota bacha Bethlehem te ase, sobke morai dibole hukum dise. Kilekoile utu somoite Jisu jonom koi kene dui saal ase koi kene Herod khobor paikena thakise. <verse eid="MAT 2:16"/><verse number="17" style="v" sid="MAT 2:17"/>Bhabobadi Jeremiah pora ki kotha koi dise eitu khan sob pura hoi jaise, juntu eneka likha asele,<verse eid="MAT 2:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="MAT 2:18"/>“Ramah town te ekta awaj hunise,</para>
  <para style="q" vid="MAT 2:18">Bisi mon dukh koi kene kandi thakise,</para>
  <para style="q" vid="MAT 2:18">Rachel tai laga bacha nimite kandi thakise,</para>
  <para style="q" vid="MAT 2:18">Aru kunke bhi tai laga mon shanti koribo diya nai kele koile taikhan nathaka hoi jaise.<note caller="+" style="f"><char style="fr" closed="false">2.18 </char><char style="fq" closed="false">Ramah town te ekta awaj hunise, Bisi mon dukh koi kene kandi thakise, Rachel tai laga bacha nimite kandi thakise, Aru kunke bhi tai laga mon shanti koribo diya nai kele koile taikhan nathaka hoi jaise. </char><char style="ft" closed="false">Jer.31:15</char></note>”<verse eid="MAT 2:18"/></para>
  <para style="s">Nazareth Te Ghurai Aha</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19"/>Aru jitia raja Herod mori jaise, sabi, Isor laga ekjon sorgodoth, Joseph to Egypt te thaka somoite tai laga sapna te ahise, <verse eid="MAT 2:19"/><verse number="20" style="v" sid="MAT 2:20"/>aru eneka koise, “Uthikena bacha aru tai laga ama ke loi kene Israel desh te jabi, kele koile jun manu bacha ke mora bole thakise taikhan morise.” <verse eid="MAT 2:20"/><verse number="21" style="v" sid="MAT 2:21"/>Etu pichete Joseph uthikena, bacha aru ama ke loi jaise, aru Israel laga desh te jaise. <verse eid="MAT 2:21"/><verse number="22" style="v" sid="MAT 2:22"/>Kintu jitia tai hunise Herod laga chokra Archelaus he Judea laga raja ase, titia, tai ta te jabole bhoi hoi jaise. Hoilebi Isor pora tai laga sapna te hoshiar kori dise, aru etu jaga chari kene, tai Galilee jagate jaise. <verse eid="MAT 2:22"/><verse number="23" style="v" sid="MAT 2:23"/>Aru Nazareth laga sheher te jaise aru ta te thaki jaise. Eneka pora, juntu bhabobadi khan pora Isor laga kotha koi dise etu pura hoi jaise, juntu asele, Taike Nazareth laga manu koi kene matibo.<verse eid="MAT 2:23"/></para>
  <chapter eid="MAT 2"/>
  <chapter number="3" style="c" sid="MAT 3"/>
  <para style="s">Baptizma Diya John Pora Rasta Taiyar Kora</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1"/>Etu somoite Baptizma diya John ahise aru Isor laga kotha prochar kori kene Judea laga sunsan jagate ahise, <verse eid="MAT 3:1"/><verse number="2" style="v" sid="MAT 3:2"/>aru eneka koise, “Mon ghura bhi, kele koile sorgo laga rajyo to usorte ahi jaise.” <verse eid="MAT 3:2"/><verse number="3" style="v" sid="MAT 3:3"/>Kilekoile bhabobadi Isaiah pora tai laga he kotha koi diya eneka likha ase,</para>
  <para style="q" vid="MAT 3:3">“Ekjon kunba sunsan jaga pora hala kori ase,</para>
  <para style="q" vid="MAT 3:3">‘Isor laga rasta taiyar koribi,</para>
  <para style="q" vid="MAT 3:3">Tai laga rasta sidha koribi.”<verse eid="MAT 3:3"/></para>
  <para style="m">
    <verse number="4" style="v" sid="MAT 3:4"/>Etiya, John to uth janwar laga chuli pora bona kapra lagai aru komor te chamra laga peti pora bandhe. Aru tai pango aru jongol laga mou pani he khai. <verse eid="MAT 3:4"/><verse number="5" style="v" sid="MAT 3:5"/>Titia Jerusalem sheher, aru pura Judea desh, aru Jordan Nodi laga sob jaga pora manu khan taike lok kori bole ahe. <verse eid="MAT 3:5"/><verse number="6" style="v" sid="MAT 3:6"/>Taikhan laga paap shikar kora pichete, John pora Jordan Nodi te taikhan ke baptizma di thakise. <verse eid="MAT 3:6"/><verse number="7" style="v" sid="MAT 3:7"/>Kintu tai logot bisi Pharisee aru Sadducee khan baptizma lobole ahi thaka dikhise, aru tai taikhan ke koise, “Tumikhan saph laga bacha khan, kun koise tumikhan Isor laga khong pora polabo karone? <verse eid="MAT 3:7"/><verse number="8" style="v" sid="MAT 3:8"/>Etu nimite, mon ghura laga bijon apnikhan laga kaam pora dikhai dibi. <verse eid="MAT 3:8"/><verse number="9" style="v" sid="MAT 3:9"/>Apnikhan laga monte ‘Amikhan laga purbojo Abraham ase’ eneka nabhabi bhi. Moi tumikhan ke koi ase Isor to etu pathor khan loi kene Abraham laga khandan bonabo pare. <verse eid="MAT 3:9"/><verse number="10" style="v" sid="MAT 3:10"/>Kintu sob ghas khan kati bole kuthar to age pora taiyar hoi kene ase. Juntu ghas bhal phol nadhure etu ghas ke katikena jui te phelai dibo. <verse eid="MAT 3:10"/><verse number="11" style="v" sid="MAT 3:11"/>Moi to tumikhan ke pani pora he baptizma dibo. Kintu Jun ami laga pichete ahi ase, Tai to ami pora bisi hokti thaka ase, Tai laga chapal moi dhori bole layak nai. Tai tumikhan ke Pobitro Atma aru jui pora baptizma dibo. <verse eid="MAT 3:11"/><verse number="12" style="v" sid="MAT 3:12"/>Tai dhaan kati bole dao loi kene ahi ase, sob dhaan ke dhaan ghor te joma kori kene ghas khan ke kitia bhi khotom nohobole jui te phelai dibo.<note caller="+" style="f"><char style="fr" closed="false">3.12 </char><char style="ft" closed="false">Mark 1:9-11; Luke 3:21,22; John 1:31-34.</char></note>”<verse eid="MAT 3:12"/></para>
  <para style="s">Jisu Baptizma Luwa</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13"/>Etu pichete Jisu Galilee jaga pora ulaikena baptizma lobole Jordan Nodi te John logot ahise. <verse eid="MAT 3:13"/><verse number="14" style="v" sid="MAT 3:14"/>Hoilebi John to Jisu ke rukhabole bisi kosis korise, aru eneka koise, “Ami he Apuni laga hath pora baptizma lobo lage, hoilebi Apuni he moi logote ahise?” <verse eid="MAT 3:14"/><verse number="15" style="v" sid="MAT 3:15"/>Kintu Jisu taike eneka koise, “Etiya karone to eneka koridi bhi, kele koile Amikhan bhi dharmikta kaam sob pura korile he thik ase.” Etu pichete John pora kotha mani loise. <verse eid="MAT 3:15"/><verse number="16" style="v" sid="MAT 3:16"/>Jitia Jisu baptizma loi kene pani pora ulaise, sorgo pora ekta pohor ahise aru Isor laga Atma kopu chiriya nisena hoi kene Tai uporte rukhi jaise. <verse eid="MAT 3:16"/><verse number="17" style="v" sid="MAT 3:17"/>Etu pichete, sabi, ekta awaj sorgo pora koise, “Etu Ami laga bisi morom thaka Putro ase. Ami Tai uporte bisi khushi ase.”<verse eid="MAT 3:17"/></para>
  <chapter eid="MAT 3"/>
  <chapter number="4" style="c" sid="MAT 4"/>
  <para style="s">Jisu Ke Porikha Kora</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1"/>Etu pichete Jisu ke Atma pora ekta sunsan jagate loi jaise juntu jagate saitan pora taike porikha koribo. <verse eid="MAT 4:1"/><verse number="2" style="v" sid="MAT 4:2"/>Aru chalis din aru chalis rati Jisu upwas korise, etu karone Tai bhuk lagi jaise. <verse eid="MAT 4:2"/><verse number="3" style="v" sid="MAT 4:3"/>Titia porikha kora jon<note caller="+" style="f"><char style="fr" closed="false">4.3 </char><char style="ft" closed="false">Saitan</char></note> ahikena Taike eneka koise, “Apuni Isor laga Putro ase koile, etu pathor khan ke roti hobole kobi.” <verse eid="MAT 4:3"/><verse number="4" style="v" sid="MAT 4:4"/>Kintu Jisu taike jowab dikena koise, “Isor kotha te eneka likhi kene ase, ‘Manu to khali bhaat khaikena jinda nathake, kintu Isor laga mukh pora ula kotha te he jinda thakibo.’” <verse eid="MAT 4:4"/><verse number="5" style="v" sid="MAT 4:5"/>Etu pichete saitan pora Jisu ke pobitro sheher te loi jaise aru mondoli laga sob pora uporte khara koribo dise, <verse eid="MAT 4:5"/><verse number="6" style="v" sid="MAT 4:6"/>aru Taike koise, “Apuni Isor laga Putro ase koile, yate pora nijorke nichete phelai dibi, kele koile Isor laga kotha te eneka likha ase,</para>
  <para style="q" vid="MAT 4:6">‘Tai pora Tai laga duth khan ke hukum dikene Apuni ke bachai lobo,’</para>
  <para style="m" vid="MAT 4:6">Aru,</para>
  <para style="q" vid="MAT 4:6">‘Taikhan laga hath pora Apuni ke dhuri lobo,</para>
  <para style="q" vid="MAT 4:6">Aru Apuni laga theng ke pathor pora bhi jokhom nahobo.’”<verse eid="MAT 4:6"/></para>
  <para style="m">
    <verse number="7" style="v" sid="MAT 4:7"/>Jisu taike eneka koise, “Aru Isor kotha te etu bhi likhi kene ase, ‘Apuni laga Probhu Isor ke porikha na koribi.’” <verse eid="MAT 4:7"/><verse number="8" style="v" sid="MAT 4:8"/>Aru, saitan pora Jisu ke untcha pahar te loi jaise aru Taike prithibi laga rajyokhan laga dangor mohima thaka dikhai dise. <verse eid="MAT 4:8"/><verse number="9" style="v" sid="MAT 4:9"/>Saitan pora Taike koise, “Apuni moike athukari kene aradhana korile, eitu khan sob ami Apnike di dibo.” <verse eid="MAT 4:9"/><verse number="10" style="v" sid="MAT 4:10"/>Titia Jisu pora taike koise, “Yate pora jai jabi, Saitan! Kilekoile Shastro te eneka likhi kene ase,</para>
  <para style="q" vid="MAT 4:10">‘Tumikhan khali Probhu, tumi laga Isor ke he aradhana koribi, aru khali Taike he sewa koribi.’”<verse eid="MAT 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11"/>Titia saitan Taike chari kene jai jaise, aru sabi, sorgodoth khan ahi kene Taike modot korise.<verse eid="MAT 4:11"/></para>
  <para style="s">Jisu Porisorja Shuru Kora</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12"/>Jitia John ke dhurise koi kene Jisu khobor paise, Tai Galilee jagate wapas jai jaise. <verse eid="MAT 4:12"/><verse number="13" style="v" sid="MAT 4:13"/>Tai Nazareth sheher chari kene Galilee Samundar laga usorte thaka, Capernaum town te jaise, etu jaga to Zebulun aru Naphtali laga majot te ase. <verse eid="MAT 4:13"/><verse number="14" style="v" sid="MAT 4:14"/>Isaiah bhabobadi dwara Isor kotha pora kowa pura hobole karone eitu khan sob eneka hoise,<verse eid="MAT 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15"/>“Zebulun laga mati aru Naphtali laga mati,</para>
  <para style="q1" vid="MAT 4:15">Sagar phale, Jordan paar kori kene,</para>
  <para style="q1" vid="MAT 4:15">Porjati khan laga Galilee!<verse eid="MAT 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16"/>Utu manu khan jun andhera te bohi thake taikhan dangor ekta ujala dikhise,</para>
  <para style="q1" vid="MAT 4:16">Aru jun khan mora laga chaya aru jagate bohi thake,</para>
  <para style="q1" vid="MAT 4:16">Taikhan uporte ekta pohor dikhai dise.”<verse eid="MAT 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17"/>Utu somoi pora he Jisu prochar kori bole shuru hoise aru koise, “Mon ghura bhi, kele koile sorgo laga rajyo to usor hoise<note caller="+" style="f"><char style="fr" closed="false">4.17 </char><char style="fq" closed="false">Mon ghura bhi, kele koile sorgo laga rajyo to usor hoise </char><char style="ft" closed="false">Mark 1:16-20; Luke 5:1-11; John 1:35-42.</char></note>.”<verse eid="MAT 4:17"/></para>
  <para style="s">Jisu Pora Prothom Chela khan ke Mata</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18"/>Jitia Tai Galilee Nodi phale berai thakisele, Tai Simon junke Peter koi, aru tai laga bhai Andrew khan ke maas dhora jaal loi kene samundar te phelai thaka dikhise, kele koile taikhan maas dhora manu thakise. <verse eid="MAT 4:18"/><verse number="19" style="v" sid="MAT 4:19"/>Jisu taikhan ke koise, “Ahibi, Ami laga piche koribi, aru Moi tumikhan ke manu dhori bole bonai dibo.” <verse eid="MAT 4:19"/><verse number="20" style="v" sid="MAT 4:20"/>Loge-loge taikhan laga maas dhura jaal khan phelai dise aru Jisu laga piche kori bole shuru hoise. <verse eid="MAT 4:20"/><verse number="21" style="v" sid="MAT 4:21"/>Jitia Jisu ta te pora jai thakise, tai duijon bhai ke dikhise, James, Zebedee laga chokra, aru tai laga bhai John Tai ekta naw te taikhan laga baba Zebedee logote maas dhura jaal khan milai thakise. Jisu taikhan ke matise, <verse eid="MAT 4:21"/><verse number="22" style="v" sid="MAT 4:22"/>Aru etu loge-loge taikhan laga naw aru baba ke chari kene Jisu laga piche korise<note caller="+" style="f"><char style="fr" closed="false">4.22 </char><char style="ft" closed="false">Luke 6: 17-19. </char></note>.<verse eid="MAT 4:22"/></para>
  <para style="s">Jisu Pora Bisi Manu Majot Te Kaam Kora</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23"/>Titia Jisu Galilee laga sob jagate berai jaise, synagogue khan te sikhaise, aru rajyo laga susamachar prochar korise, aru sob kisim laga ghao bemar aru bemar manu khan ke changai korise. <verse eid="MAT 4:23"/><verse number="24" style="v" sid="MAT 4:24"/>Tai laga khobor sob Syria jagate punchi jaise, aru manu khan Jisu usorte kisim-kisim bemar pora dukh pai thaka khan, gaw bhitor te bhoot huma khan, murgi-bemar thaka khan, aru jothor bemar thaka khan sobke loi kene anise. Aru taikhan ke Jisu pora changai kori dise. <verse eid="MAT 4:24"/><verse number="25" style="v" sid="MAT 4:25"/>Aru Galilee, Decapolis<note caller="+" style="f"><char style="fr" closed="false">4.25 </char><char style="ft" closed="false">Etu motlob to dosta sheher</char></note>, Jerusalem, Judea, aru Jordan pora bhi dur thaka sob jaga pora manu khan Jisu logot ahise.<verse eid="MAT 4:25"/></para>
  <chapter eid="MAT 4"/>
  <chapter number="5" style="c" sid="MAT 5"/>
  <para style="s">Pahar Pora Sikhsa Diya</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1"/>Bhir bisi dangor hoija pora, Jisu to ekta tilla uporte uthijaise. Tai ta te boha pichete, tai laga chela khan bhi Tai usorte ahise.<verse eid="MAT 5:1"/></para>
  <para style="s">Sorgo Anondo Kotha</para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 5:2"/>Aru Jisu pora Tai laga chela khan ke eneka koi kene sikhaise,<verse eid="MAT 5:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="MAT 5:3"/>“Atma te dukhia thaka khan dhonyo ase,</para>
  <para style="q2" vid="MAT 5:3">Kilekoile sorgo laga rajyo taikhan nimite ase.<verse eid="MAT 5:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="MAT 5:4"/>Dukh koi kene thaka khan, taikhan dhonyo ase,</para>
  <para style="q2" vid="MAT 5:4">Kilekoile taikhan laga mon aram kori dibo.<verse eid="MAT 5:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="MAT 5:5"/>Nomro hoi kene thaka khan dhonyo ase,</para>
  <para style="q2" vid="MAT 5:5">Taikhan prithibi laga adhikari hobo<note caller="+" style="f"><char style="fr" closed="false">5.5 </char><char style="ft" closed="false">Ps. 37:11</char></note>.<verse eid="MAT 5:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="MAT 5:6"/>Dharmikta nimite bhuk aru pyaas thaka khan dhonyo ase,</para>
  <para style="q2" vid="MAT 5:6">Taikhan ke bhorta kori dibo.<verse eid="MAT 5:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="MAT 5:7"/>Dayalu thaka manu khan dhonyo ase,</para>
  <para style="q2" vid="MAT 5:7">Taikhan daya pabo.<verse eid="MAT 5:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="MAT 5:8"/>Mon sapha thaka khan dhonyo ase,</para>
  <para style="q2" vid="MAT 5:8">Taikhan Isor ke dikhibo.<verse eid="MAT 5:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="MAT 5:9"/>Shanti nimite kaam kora khan dhonyo ase,</para>
  <para style="q2" vid="MAT 5:9">Taikhan ke Isor laga bacha khan koi kene matibo.<verse eid="MAT 5:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="MAT 5:10"/>Dharmikta nimite dukh pai thaka khan dhonyo,</para>
  <para style="q2" vid="MAT 5:10">Sorgo laga desh to taikhan nimite ase.<verse eid="MAT 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11"/>Tumikhan dhonyo ase jitia Ami laga naam nimite manu khan pora tumikhan ke gali dibo, dukh digdar dibo aru misa misi bodnam dibo. <verse eid="MAT 5:11"/><verse number="12" style="v" sid="MAT 5:12"/>Monte bisi khushi hobi kele koile sorgote tumikhan nimite bisi dangor inam rakhi kene ase. Jun bhabobadi khan tumi laga age te ahisele, taikhan ke bhi eneka dukh digdar dise.<verse eid="MAT 5:12"/></para>
  <para style="s">Nimok Aru Puhor</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13"/>Tumikhan etu prithibi laga nimok nisena ase. Kintu nimok laga swadh haraise koile, kineka tai laga swadh to arubi anibo? Etu to eku kaam laga nohoi jai, kintu etu ke phelai dibo aru manu khan pora chipai dibo. <verse eid="MAT 5:13"/><verse number="14" style="v" sid="MAT 5:14"/>Tumikhan etu prithibi laga puhor ase. Ekta sheher ke pahar uporte bonaile lukabo napare. <verse eid="MAT 5:14"/><verse number="15" style="v" sid="MAT 5:15"/>Nohoile bhi manu khan tai laga saaki julai kene kiba ekta dabba pora bondh kori kene narakhe, kintu etu saaki ke khamba te rakhikena pura ghor ke ujala kori bole diye. <verse eid="MAT 5:15"/><verse number="16" style="v" sid="MAT 5:16"/>Tumi laga pohor ke eneka ujala kori dibi manu khan age te, titia taikhan tumi laga bhal kaam khan sob dikhi jabo aru tumi laga Baba Isor jun sorgote ase, Taike mohima dibo.<verse eid="MAT 5:16"/></para>
  <para style="s">Kanun Purah Kori dibole Khrista Ahise</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17"/>Moi Isor laga niyom aru bhabobadi khan ke khotom kori dibo nimite ahise eneka nabhabi bi. Moi khotom kori dibole aha nohoi, kintu eitu khan sob pura kori dibo nimite ahise.<note caller="+" style="f"><char style="fr" closed="false">5.17 </char><char style="ft" closed="false">Rom. 10:4</char></note> <verse eid="MAT 5:17"/><verse number="18" style="v" sid="MAT 5:18"/>Kilekoile moi hosa pora tumikhan ke koi ase jitia tak prithibi aru akas khan khotom nohoi, ekta dagi nohoile ekta chutu kotha bhi naharabo, jitia tak etu kotha khan sob pura nohoi. <verse eid="MAT 5:18"/><verse number="19" style="v" sid="MAT 5:19"/>Etu nimite, kun pora etu niyom aru hukum khan bhangabo aru dusra khan ke bhi eneka kori bole sikhabo, taikhan laga naam bhi sorgo laga rajyo pora hatai dibo. Kintu kun pora etu hukum aru niyom sob rakhe, taike sorgo laga rajyote mohan matibo. <verse eid="MAT 5:19"/><verse number="20" style="v" sid="MAT 5:20"/>Etu nimite Moi tumikhan ke koi ase, tumikhan laga dharmikta to niyom likha khan aru pharisee khan pora bhi bhal hobo lage, eneka nohoile tumikhan sorgo laga rajyote ahibo na paribo.<verse eid="MAT 5:20"/></para>
  <para style="s">Khong</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21"/>Tumikhan hunise utu purana somoite eneka koi dise, ‘Morai diya kaam na koribi,’ aru, ‘Jun pora manu ke morai taikhan Isor laga bisar te ahibo.’<note caller="+" style="f"><char style="fr" closed="false">5.21 </char><char style="ft" closed="false">Exo. 20:13</char></note> <verse eid="MAT 5:21"/><verse number="22" style="v" sid="MAT 5:22"/>Kintu Moi tumikhan ke koi ase, sob manu jun khan tai nijor bhai ke gusa kore, tai logot Isor laga bisar ahibo, aru nijor bhai ke eneka kowa khan to sabha age te bisi digdar hobo, ‘Tumi kaam nathaka manu!’ Aru tai norok laga jui te juli bo jodi ekjon pora tai bhai ke eneka koi, ‘Tumi murkho manu!’ <verse eid="MAT 5:22"/><verse number="23" style="v" sid="MAT 5:23"/>Etu karone, jitia tumi Isor laga age te daan dibole ane, aru bhai ke kiba biya korise koi kene monte ahise koile, <verse eid="MAT 5:23"/><verse number="24" style="v" sid="MAT 5:24"/>tumi laga dhun khan bedi usorte chari dibi. Aru poila jai kene tumi laga bhai logote mon milai lobi, etu pichete ahikena Isor ke daan dibi. <verse eid="MAT 5:24"/><verse number="25" style="v" sid="MAT 5:25"/>Kunba tumike bisar ghor te loijabo koi ase koile, naja-a age te tai logote kotha milai lobi, kele koile ekbar bisar ghor te jaise koile tai pora tumike ukil laga hathte di dibo, aru ukil pora tumike sipahi khan logote di dibo aru sipahi khan pora tumike bondhi ghor te rakhidibo. <verse eid="MAT 5:25"/><verse number="26" style="v" sid="MAT 5:26"/>Hosa pora Ami tumikhan ke koidi ase, tumi bondhi ghor pora bahar naulabo jitia tak tumi laga dhar sob tirai nadibo.<verse eid="MAT 5:26"/></para>
  <para style="s">Bebichar</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27"/>Tumikhan eneka kowa hunise, ‘Bebichari na koribi<note caller="+" style="f"><char style="fr" closed="false">5.27 </char><char style="fq" closed="false">Bebichari na koribi </char><char style="ft" closed="false">Deu.5:18; Exo. 20:14.</char></note>.’ <verse eid="MAT 5:27"/><verse number="28" style="v" sid="MAT 5:28"/>Kintu Moi tumikhan ke koidi ase, jun manu ekjon mahila ke biya kaam kori bole bhabi loi, tai mon bhitor te bebichar kori loise. <verse eid="MAT 5:28"/><verse number="29" style="v" sid="MAT 5:29"/>Jitia ekta suku pora tumike biya kaam koribo di ase, utu suku ke ulaikene dhur te phelai dibi. Kilekoile gaw te ekta biya saman nimite pura gaw norokte ja pora to, ekta suku nathaki kene jinda thaka he bhal hobo. <verse eid="MAT 5:29"/><verse number="30" style="v" sid="MAT 5:30"/>Tumi laga ekta hath pora paap kaam kori ase koile, etu ke kati kene phelai dibi. Kilekoile pura gaw norokte ja pora, ekta hath nathaki kene jinda thakile he bhal ase.<verse eid="MAT 5:30"/></para>
  <para style="s">Chara-Chari Kora</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31"/>Eneka bhi koi kene ase, ‘Jun mota tai laga maiki ke chari bole mon ase, tai pora chari diya laga chithi likhi kene tai laga maiki ke dibole lage.’<note caller="+" style="f"><char style="fr" closed="false">5.31 </char><char style="ft" closed="false">Due.24:1-14.</char></note> <verse eid="MAT 5:31"/><verse number="32" style="v" sid="MAT 5:32"/>Kintu Moi tumikhan ke etu koidi ase, jun mota dusra maiki logote bebichar kori bole tai laga maiki ke chari diye, taike bebichari maiki bonai di ase. Aru jun manu pora etu chari diye maiki ke shadi koribo, tai bhi bebichar kori loise.<verse eid="MAT 5:32"/></para>
  <para style="s">Kosom Kha-a</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33"/>Aru, tumikhan poila jamana te huni kene thakibo, ‘Misa kotha nimite kosom nakhabi, kintu ji kosom Probhu logote korise etu purah koribi.’<note caller="+" style="f"><char style="fr" closed="false">5.33 </char><char style="fq" closed="false">Misa kotha nimite kosom nakhabi, kintu ji kosom Probhu logote korise etu purah koribi </char><char style="ft" closed="false">Due. 23:21.</char></note> <verse eid="MAT 5:33"/><verse number="34" style="v" sid="MAT 5:34"/>Kintu Moi tumikhan ke koi ase, tumi laga kosom nimite, sorgote thaka laga naam nalobi, kele koile etu Isor laga singhason ase;<note caller="+" style="f"><char style="fr" closed="false">5.34 </char><char style="ft" closed="false">Isa.66:1.</char></note> <verse eid="MAT 5:34"/><verse number="35" style="v" sid="MAT 5:35"/>prithibi laga naam nalobi, kele koile etu Isor laga theng rakha jaga ase; Jerusalem laga naam nalobi, kele koile etu mohan Raja laga desh ase.<note caller="+" style="f"><char style="fr" closed="false">5.35 </char><char style="ft" closed="false">Isa.66:1.</char></note> <verse eid="MAT 5:35"/><verse number="36" style="v" sid="MAT 5:36"/>Aru nijor laga naam loi kene kosom nakhabi, kele koile tumi nijor laga chuli ke boga nohoile kala kori bole hokti nai. <verse eid="MAT 5:36"/><verse number="37" style="v" sid="MAT 5:37"/>Kintu tumi laga kotha ‘Hoi to, hoi' kobi, aru ‘Nohoi to Nohoi’ kobi. Kintu etu pora aru bisi kotha kora khan to sob biya khan pora ase.<verse eid="MAT 5:37"/></para>
  <para style="s">Biya Ghurai Diya</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38"/>Tumikhan hunise eneka koi kene ase, ‘Suku laga bodli suku, aru daat laga bodli daat.’<note caller="+" style="f"><char style="fr" closed="false">5.38 </char><char style="fq" closed="false">Suku laga bodli suku, aru daat laga bodli daat </char><char style="ft" closed="false">Due. 19:21.</char></note> <verse eid="MAT 5:38"/><verse number="39" style="v" sid="MAT 5:39"/>Kintu Moi koi ase, tumike kunba golti kora manu ke badla lobole na koribi. Hoilebi, jun manu tumike mukh laga ekta phale thapor mare, tumi laga dusra phale bhi mari bole dibi. <verse eid="MAT 5:39"/><verse number="40" style="v" sid="MAT 5:40"/>Kunba manu bisar ghor te jabole itcha hoi aru tumi laga kapra pindhi loi, taike apuni laga chador bhi di dibi. <verse eid="MAT 5:40"/><verse number="41" style="v" sid="MAT 5:41"/>Kunba manu khan pora tumike ek kilometer jabole koile, tumi tai logote dui kilometer jabi.<note caller="+" style="f"><char style="fr" closed="false">5.41 </char><char style="ft" closed="false">Ek kilometer dur tak Rome laga ekjon sipahi pora ekjon Yehudi ke bostu-saman bukhibole hukum dibo pari thakisele. </char></note> <verse eid="MAT 5:41"/><verse number="42" style="v" sid="MAT 5:42"/>Jun manu tumike kiba mangile taike di dibi, aru jun manu tumike kiba dhar lobole mange, taike mana na koribi.<verse eid="MAT 5:42"/></para>
  <para style="s">Dushman Ke Morom Kora</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43"/>Tumikhan hunise eneka koi kene, ‘Tumi laga ghor usorte thaka manu ke morom koribi aru tumi laga dushman ke ghin koribi.’<note caller="+" style="f"><char style="fr" closed="false">5.43 </char><char style="fq" closed="false">Tumi laga ghor usorte thaka manu ke morom koribi aru tumi laga dushman ke ghin koribi. </char><char style="ft" closed="false">Lev.19:18.</char></note> <verse eid="MAT 5:43"/><verse number="44" style="v" sid="MAT 5:44"/>Kintu Moi tumikhan ke koi ase, tumi laga dushman ke morom koribi, aru jun khan tumike dukh-digdar<note caller="+" style="f"><char style="fr" closed="false">5.44 </char><char style="ft" closed="false">Kunba kitab khan te ‘persecute’ nohoi kene ‘curse’, shrap likha ase.</char></note> di ase, taikhan nimite prathana koribi,<note caller="+" style="f"><char style="fr" closed="false">5.44 </char><char style="ft" closed="false">Rom. 12:14.</char></note> <verse eid="MAT 5:44"/><verse number="45" style="v" sid="MAT 5:45"/>eneka korile tumikhan sorgote thaka Baba laga bacha khan hobo. Kilekoile Tai laga suryo to biya manu aru bhal manu ke bhi diye, aru borkhon pani to biya manu aru bhal khan ke bhi diye. <verse eid="MAT 5:45"/><verse number="46" style="v" sid="MAT 5:46"/>Jitia tumikhan khali morom kora khan ke morom kore, etu to ki labh pabo? Kilekoile poisa utha manu khan bhi eneka kore nohoi? <verse eid="MAT 5:46"/><verse number="47" style="v" sid="MAT 5:47"/>Tumikhan khali tumi laga bhai khan he mane koile, etu kori kene tumi ki dangor kaam korise? Isor ke najana khan bhi dusra khan ke eneka kore nohoi? <verse eid="MAT 5:47"/><verse number="48" style="v" sid="MAT 5:48"/>Etu nimite, tumikhan ekdom thik hobo lage, jineka tumikhan laga sorgo Baba Isor thik ase.<note caller="+" style="f"><char style="fr" closed="false">5.48 </char><char style="ft" closed="false">Lev. 19:2.</char></note><verse eid="MAT 5:48"/></para>
  <chapter eid="MAT 5"/>
  <chapter number="6" style="c" sid="MAT 6"/>
  <para style="s">Dukhiya Ke Daan Diya</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1"/>Etiya bhal pora bujhi lobi, tumikhan manu ke dikha bole nimite bhal kaam na koribi, nohoile sorgote thaka Baba Isor pora tumikhan ke eku inam nadibo. <verse eid="MAT 6:1"/><verse number="2" style="v" sid="MAT 6:2"/>Jitia tumikhan kunba ke modot di ase koile, sob manu ke hunai kene hala na koribi, kele koile Pharisee khan bhi manu khan ke dikha bole nimite mondoli khan te aru rasta khan te hala kore. Hosa pora Moi koidi ase, taikhan laga inam taikhan paikena ase. <verse eid="MAT 6:2"/><verse number="3" style="v" sid="MAT 6:3"/>Kintu tumikhan jitia daan diye, tumi laga dyna hath ki kori ase tumi laga baya hath ke janibole nadibi, <verse eid="MAT 6:3"/><verse number="4" style="v" sid="MAT 6:4"/>titia tumi daan diya to kun bhi najanibo. Kintu tumi laga Baba jun sob sai ase tumike lukai kene inam dibo.<verse eid="MAT 6:4"/></para>
  <para style="s">Probhu Laga Prathana</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5"/>Jitia tumikhan prathana kore, kopoti khan kora nisena nahobi, kele koile taikhan mondoli khan te aru rasta kinar khan te dikha bole karone prathana kore. Hosa pora Moi koidi ase, taikhan laga inam to taikhan pabo. <verse eid="MAT 6:5"/><verse number="6" style="v" sid="MAT 6:6"/>Kintu, jitia tumikhan prathana kore, ghor bhitor dorja bondh koribi aru lukai kene tumi laga Baba ke prathana koribi. Titia tumi laga Baba jun tumike sai ase, Tai tumike inam dibo. <verse eid="MAT 6:6"/><verse number="7" style="v" sid="MAT 6:7"/>Jitia tumikhan prathana kore, Porjati khan nisena bisi kotha nakobi, kele koile taikhan bhabe eneka koile taikhan laga kotha huni lobo. <verse eid="MAT 6:7"/><verse number="8" style="v" sid="MAT 6:8"/>Taikhan nisena na koribi, kele koile tumi laga Baba tumi ki mangi bole ase etu age pora jani ase. <verse eid="MAT 6:8"/><verse number="9" style="v" sid="MAT 6:9"/>Etu nimite, eneka prathana koribi:</para>
  <para style="q" vid="MAT 6:9">‘Amikhan laga Baba jun sorgote ase,</para>
  <para style="q2" vid="MAT 6:9">Apuni laga naam pobitro hoi kene untcha hobi<note caller="+" style="f"><char style="fr" closed="false">6.9 </char><char style="fq" closed="false">Apuni laga naam pobitro hoi kene untcha hobi </char><char style="ft" closed="false">Luke 11:2.</char></note>.<verse eid="MAT 6:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="MAT 6:10"/>Apuni laga sorgo ahibole dibi.</para>
  <para style="q2" vid="MAT 6:10">Apuni laga itcha hobole dibi, etu prithibi te jineka sorgote ase.<verse eid="MAT 6:10"/></para>
  <para style="q2">
    <verse number="11" style="v" sid="MAT 6:11"/>Amikhan ke hodai din laga kha luwa dibi.<verse eid="MAT 6:11"/></para>
  <para style="q2">
    <verse number="12" style="v" sid="MAT 6:12"/>Amikhan laga dhar khan maph kori dibi,</para>
  <para style="q2" vid="MAT 6:12">Jineka ami pora amikhan laga dhar thaka khan ke maph kori dise.<verse eid="MAT 6:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="MAT 6:13"/>Amikhan ke porikha te giri bo nadibi, kintu biya jon pora amikhan ke bachai lobi.’<verse eid="MAT 6:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 6:14"/>Kilekoile jitia tumikhan pora dusra manu khan laga golti khan maph kore, tumi laga sorgote thaka Baba bhi tumikhan ke maph kori dibo. <verse eid="MAT 6:14"/><verse number="15" style="v" sid="MAT 6:15"/>Kintu jitia tumikhan dusra manu khan ke maph nakore, tumi laga sorgote thaka Baba bhi tumikhan laga golti maph nakoribo.<verse eid="MAT 6:15"/></para>
  <para style="s">Upwas Aru Prathana</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16"/>Jitia tumikhan upwas rakhe, kopoti khan kora nisena mon dukh laga chehera nadikhabi, kele koile taikhan to manu khan ke dikhabo nimite taikhan laga chehera biya kori kene dikhai, aru taikhan nijor laga inam pai loise. <verse eid="MAT 6:16"/><verse number="17" style="v" sid="MAT 6:17"/>Kintu, jitia tumi upwas rakhe, tumi nijor laga matha te tel hali lobi aru chehera ke dholai lobi, <verse eid="MAT 6:17"/><verse number="18" style="v" sid="MAT 6:18"/>titia manu khan tumike saikene najanibo tumi upwas kori ase, kintu khali tumi laga Baba he janibo; aru tumi laga Baba jun sob sai ase, Tai he tumike inam dibo.<verse eid="MAT 6:18"/></para>
  <para style="s">Sorgote Sompoti Joma Koribi</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19"/>Nijor nimite eku dhun joma na koribi, juntu jagate tumi laga sob dhun puka aru kira pora khotom kori dibo, aru jun jagate chor khan bhangai kene chor kori lobo. <verse eid="MAT 6:19"/><verse number="20" style="v" sid="MAT 6:20"/>Hoilebi, nijor laga sob dhun sorgote joma koribi, juntu jagate napuchibo aru pukakhan pora khotom nakoribo, aru chor khan bhanga bole na paribo. <verse eid="MAT 6:20"/><verse number="21" style="v" sid="MAT 6:21"/>Kilekoile jun jagate tumi laga dhun ase, ta te tumi laga mon bhi thakibo. <verse eid="MAT 6:21"/><verse number="22" style="v" sid="MAT 6:22"/>Suku to tumi laga gaw te saaki nisena ase. Etu nimite, jitia tumi laga suku to thik thakibo, tumi laga gaw purah te puhor thakibo. <verse eid="MAT 6:22"/><verse number="23" style="v" sid="MAT 6:23"/>Kintu jitia tumi laga suku te letera thakibo, tumi laga pura gaw bhi letera thakibo. Etu nimite, juntu pohor tumi bhitor te ase, etu to andhera ase koile, utu andhar to kiman bhi dangor ase! <verse eid="MAT 6:23"/><verse number="24" style="v" sid="MAT 6:24"/>Kun manu bhi duita malik ke sewa koribo na paribo, kele koile tai ekjon malik ke morom koribo aru ke ghin koribo, nohoile ekjon ke mon dibo aru dusra ke mon nadibo. Tumi Isor aru dhun ke sewa koribo na paribo.<verse eid="MAT 6:24"/></para>
  <para style="s">Chinta Na koribi</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25"/>Etu karone, Moi koi ase, nijor laga jibon nimite chinta na koribi, ki khabo nohoile- nohoile tumi laga gaw nimite, nohoile ki kapra pindhibo. Kha luwa pora bhi jibon to dangor nohoi naki, aru kapra pora bhi tumi laga gaw he dangor nohoi naki? <verse eid="MAT 6:25"/><verse number="26" style="v" sid="MAT 6:26"/>Akas uporte chiriya khan ke sabi. Taikhan kheti bhi nakore, aru kheti bhi nakate, nohoile taikhan laga ghor te joma nakore, kintu tumi laga sorgote thaka Baba pora taikhan ke sob khilai. Tumikhan etu chiriya khan pora bhi bisi dangor ase nohoi? <verse eid="MAT 6:26"/><verse number="27" style="v" sid="MAT 6:27"/>Kintu tumikhan jun bisi chinta kore, etu pora tumikhan laga jibon ke lamba koribo pare naki? <verse eid="MAT 6:27"/><verse number="28" style="v" sid="MAT 6:28"/>Tumikhan kele kapra nimite iman chinta kori ase? Kheti te phul thaka khan laga bhabi sabi, taikhan kineka phule. Taikhan eku kaam nakore, aru kapra bhi nabonai. <verse eid="MAT 6:28"/><verse number="29" style="v" sid="MAT 6:29"/>Titia bhi Ami koi ase, Solomon ekjon dangor raja hoi kene bhi, taike eitu khan nisena kapra lagai diya nai. <verse eid="MAT 6:29"/><verse number="30" style="v" sid="MAT 6:30"/>Kintu jodi Isor pora kapra pindhai dibole pare, etu kheti te thaka phul khan jun aji ase aru kali kati kene chulah te julai diye, titia hoile Tai tumikhan ke bhi bisi kapra pindhai dibo na paribo naki, tumi komti biswas thaka manu khan? <verse eid="MAT 6:30"/><verse number="31" style="v" sid="MAT 6:31"/>Etu nimite, bisi chinta kori kene eneka nakobi, ‘Amikhan ki khabo?’ Nohoile, ‘Amikhan ki pindhibo?’ <verse eid="MAT 6:31"/><verse number="32" style="v" sid="MAT 6:32"/>Kilekoile Isor najana khan pora eitu khan he bisare, aru sorgote thaka Baba Isor pora tumikhan ki lage, Tai sob jani ase. <verse eid="MAT 6:32"/><verse number="33" style="v" sid="MAT 6:33"/>Kintu poila Tai laga sorgo rajyo aru dharmikta bisaribi aru eitu khan sob saman tumikhan ke Tai pora dibo.<note caller="+" style="f"><char style="fr" closed="false">6.33 </char><char style="ft" closed="false">Luke 12:31.</char></note> <verse eid="MAT 6:33"/><verse number="34" style="v" sid="MAT 6:34"/>Etu karone, kali nimite chinta na koribi, kele koile kali to tai nijor he chinta koribo. Hodai dinte tai nijor laga biya din thake.<verse eid="MAT 6:34"/></para>
  <chapter eid="MAT 6"/>
  <chapter number="7" style="c" sid="MAT 7"/>
  <para style="s">Dusra Ke Bisar Kora</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1"/>Dusra ke bisar na koribi, tinehoile tumike bhi bisar nakoribo. <verse eid="MAT 7:1"/><verse number="2" style="v" sid="MAT 7:2"/>Ki kotha pora tumi bisar kore, tumike bhi etu pora bisar koribo, aru ki loi kene tumi hisab-kitab kore, tineka he tumike bhi hisab-kitab hobo. <verse eid="MAT 7:2"/><verse number="3" style="v" sid="MAT 7:3"/>Kintu kele tumi laga bhai laga suku te sukha pata chutu thaka to sai ase, hoilebi tumi nijor laga suku te dangor khuri thaka to nadikhe? <verse eid="MAT 7:3"/><verse number="4" style="v" sid="MAT 7:4"/>Nohoile kineka tumi laga bhai ke koi, ‘Amike tumi laga suku te sukha pata chutu thaka to sapha koribo dibi,’ jitia apuni nijor laga suku te ekta dangor khuri thaki kene? <verse eid="MAT 7:4"/><verse number="5" style="v" sid="MAT 7:5"/>Tumi kopoti khan! Poila nijor laga suku te dangor khuri thaka to sapha kori lobi, aru etu pichete tumikhan bhal pora dikhi kene bhai laga suku te sukha pata chutu thaka to sapha kori bole paribo. <verse eid="MAT 7:5"/><verse number="6" style="v" sid="MAT 7:6"/>Juntu pobitro ase eitu khan kutta khan ke nadibi, aru tumi laga heera moti loi kene jongol gahori khan ke nadibi. Kilekoile taikhan laga theng pora chipai dibo, aru ghurikena tumikhan laga gaw ke kamuri kene tukra kori dibo.<verse eid="MAT 7:6"/></para>
  <para style="s">Mangibi Aru etu Pabo</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7"/>Mangi bhi, aru tumikhan ke dibo. Bisaribi, aru tumikhan pai jabo. Dorjate maribi, aru tumikhan nimite khuli dibo. <verse eid="MAT 7:7"/><verse number="8" style="v" sid="MAT 7:8"/>Kilekoile jun mange, taikhan pai; aru jun bisare, taikhan pai; aru jun dorjate mare, taikhan nimite khuli diye. <verse eid="MAT 7:8"/><verse number="9" style="v" sid="MAT 7:9"/>Nohoile bhi kunba manu ase naki tumikhan majote, jun laga bacha pora khabole roti mangile, tai laga baba pora pathor diye naki? <verse eid="MAT 7:9"/><verse number="10" style="v" sid="MAT 7:10"/>Nohoile bacha pora maas khabole mangile, tai laga baba pora saph dibo naki? <verse eid="MAT 7:10"/><verse number="11" style="v" sid="MAT 7:11"/>Etu nimite, tumikhan kiman biya hoilebi nijor bacha ke bhal saman khan diye, tinehoile tumi laga Baba kun sorgote ase, Tai aru bisi bhal saman tumikhan manga to nadibo naki<note caller="+" style="f"><char style="fr" closed="false">7.11 </char><char style="ft" closed="false">Eze. 22:27</char></note>?<verse eid="MAT 7:11"/></para>
  <para style="s">Suna Daam Laga Niom</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12"/>Etu nimite, sob te, dusra manu khan pora tumi ki lage, thik eneka tumi bhi dusra khan ke koribi, kele koile etu to niyom pora aru bhabobadi khan pora koi diya ase.<verse eid="MAT 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13"/>Ekdom huru rasta pora ghusi bhi. Kelemane juntu dorja bisi dangor hoi, etu to khotom kori diya rasta te loijai, aru bisi manu etu rasta te jabole kore. <verse eid="MAT 7:13"/><verse number="14" style="v" sid="MAT 7:14"/>Kilekoile jibon laga rasta to bisi huru ase aru dorja ekdom chutu ase. Etu nimite khali kunba khan he etu rasta pai.<verse eid="MAT 7:14"/></para>
  <para style="s">Gash Aru etu Laga Phol</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15"/>Misa bhabobadi khan pora hoshiar thakibi, jun khan mer nisena kapra pindhi kene dikhai, kintu bhitor te taikhan ekdom bhuk lagi thaka rong kutta janwar khan ase. <verse eid="MAT 7:15"/><verse number="16" style="v" sid="MAT 7:16"/>Taikhan laga kaam laga phol pora tumikhan jani jabo. Dusra manu kata ghas pora angur ke joma nakore, aru nohoile kata ghas pora dimoru khan ulai naki? <verse eid="MAT 7:16"/><verse number="17" style="v" sid="MAT 7:17"/>Etu nisena, sob bhal ghas khan bhal phol dhure, kintu biya ghas khan biya phol dhure. <verse eid="MAT 7:17"/><verse number="18" style="v" sid="MAT 7:18"/>Ekta bhal ghas pora biya phol dhoribo napare, nohoi lebi ekta biya ghas pora bhal phol dhoribo napare. <verse eid="MAT 7:18"/><verse number="19" style="v" sid="MAT 7:19"/>Juntu ghas bhal phol nadhure etu ghas ke katikena jui te phelai dibo lage. <verse eid="MAT 7:19"/><verse number="20" style="v" sid="MAT 7:20"/>Etu pichete, tumikhan tai laga phol pora jani jabo.<verse eid="MAT 7:20"/></para>
  <para style="s">Moi Tumikhan Ke Najane</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21"/>Sob manu jun Moike ‘Probhu, Probhu’ koi kene mate, taikhan sorgo desh te huma bole nohoi, kintu jun manu sorgote thaka Baba Isor laga itcha kore, taikhan he huma bole paribo. <verse eid="MAT 7:21"/><verse number="22" style="v" sid="MAT 7:22"/>Bisi manu khan utu dinte kobo, ‘Probhu, Probhu, amikhan Apuni laga naam te bhabobani kora nai naki, aru Apuni laga naam te biya atma khan ke khedai diya nai naki, aru Apuni laga naam te asurit kaam khan kora nai naki? <verse eid="MAT 7:22"/><verse number="23" style="v" sid="MAT 7:23"/>Titia Ami Khuli Kena taikhan ke koi dibo, ‘Moi tumikhan ke kitia bhi jana nai! Moi laga usor pora jai jabi, tumikhan biya laga niyom kora khan!’<verse eid="MAT 7:23"/></para>
  <para style="s">Pathor Uporte Tumikhan Ghor Bonabi</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24"/>Etu nimite, sob manu jun Ami laga kotha khan hune aru eitu khan sob mane, taikhan ekjon gyaani manu nisena ase jun pathor uporte ghor bonaise. <verse eid="MAT 7:24"/><verse number="25" style="v" sid="MAT 7:25"/>Bisi dangor hawa aru pani ahikena, aru purah pani pora bhorta kori loise, hoilebi etu ghor ke gira bole para nai, kele koile etu ghor to pathor uporte bonaise. <verse eid="MAT 7:25"/><verse number="26" style="v" sid="MAT 7:26"/>Kintu kun manu Ami laga kotha hune aru namane taikhan murkho manu ase jun balu laga uporte ghor bonai. <verse eid="MAT 7:26"/><verse number="27" style="v" sid="MAT 7:27"/>Dangor borkhon ahise, aru ban pani pora bhorta hoi jaise, aru hawa pora etu ghor ke hilai kene girai dise, aru pura ghor ke khotom kori diye.”<verse eid="MAT 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28"/>Etu pichete jitia Jisu etu kotha khan koi kene khotom korise, Tai pora sikhai diya kotha huni kene sob manu asurit hoi jaise. <verse eid="MAT 7:28"/><verse number="29" style="v" sid="MAT 7:29"/>Kilekoile Tai sikhai diya to niyom likha khan pora sikha nisena nohoi, kintu ekjon adhikar thaka manu nisena koi thakise.<verse eid="MAT 7:29"/></para>
  <chapter eid="MAT 7"/>
  <chapter number="8" style="c" sid="MAT 8"/>
  <para style="s">Jisu Pora Kusto-rugi Ekjon Ke Sapha Kora</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1"/>Jitia Jisu pahar pora namikene ahise se, dangor manu laga bhir pora Tai laga piche korise. <verse eid="MAT 8:1"/><verse number="2" style="v" sid="MAT 8:2"/>Aru sabi, ekjon korhi bemar thaka manu Jisu laga usorte ahise aru Tai age te matha jhukikena eneka koise, “Probhu, Apuni itcha ase koile, Apuni moike sapha kori bole paribo<note caller="+" style="f"><char style="fr" closed="false">8.2 </char><char style="ft" closed="false">Probhu, Apuni itcha ase koile, Apuni moike sapha kori bole paribo.</char></note>.” <verse eid="MAT 8:2"/><verse number="3" style="v" sid="MAT 8:3"/>Jisu tai usorte jai kene taike chuikena koise, “Moi laga itcha ase. Sapha hobi.” Aru etu loge-loge tai laga bemar sapha hoi jaise. <verse eid="MAT 8:3"/><verse number="4" style="v" sid="MAT 8:4"/>Etu pichete Jisu taike koise, “Sabi, etu kunke bhi nakobi. Kintu jabi aru tumi laga purohit khan ke dikhai dibi aru Moses pora hukum diya kori lobi, titia etu dusra khan nimite tumi laga gawahi hobo<note caller="+" style="f"><char style="fr" closed="false">8.4 </char><char style="fq" closed="false">Tumi laga gawahi hobo. </char><char style="ft" closed="false">Lev. 14:2-32.</char></note>.”<verse eid="MAT 8:4"/></para>
  <para style="s">Henapoti Ekjon Laga Biswas</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5"/>Jitia Jisu Capernaum jagate ahi loise, ekjon Rome laga henapoti<note caller="+" style="f"><char style="fr" closed="false">8.5 </char><char style="ft" closed="false">Rome laga henapoti ekjon ke tai laga adhikar nichete eksoh sipahi thake.</char></note> Tai usorte ahise aru koise, <verse eid="MAT 8:5"/><verse number="6" style="v" sid="MAT 8:6"/>“Probhu, ami laga kaam kora nokor jothor bemar koi kene ghumai ase aru tai bisi dukh te ase.” <verse eid="MAT 8:6"/><verse number="7" style="v" sid="MAT 8:7"/>Jisu taike koise, “Moi ahibo aru taike bhal kori dibo.” <verse eid="MAT 8:7"/><verse number="8" style="v" sid="MAT 8:8"/>Kintu henapoti pora taike eneka jowab dise, “Probhu, Apnike ami laga ghor te mati bole sorom ase, kintu khali Apuni laga kotha koi dibi aru ami laga nokor to bhal hoi jabo. <verse eid="MAT 8:8"/><verse number="9" style="v" sid="MAT 8:9"/>Kilekoile ami bhi ekjon adhikari thaka manu ase, aru ami nichete sipahi khan ase. Ami taikhan ke eneka hukum diye, ‘Jabi’, aru tai jai, aru dusra ekjon ke, ‘Ahibi,’ aru tai ahe, aru nokor ke, ‘Eneka koribi,’ aru tai kore.” <verse eid="MAT 8:9"/><verse number="10" style="v" sid="MAT 8:10"/>Kintu jitia Jisu etu hunise, Tai asurit hoi jaise aru Tai laga piche aha manu khan ke koi, “Hosa pora Moi tumikhan ke koi ase, Moi kitia bhi etu nisena iman dangor biswas thaka manu purah Israel desh te dikha nai. <verse eid="MAT 8:10"/><verse number="11" style="v" sid="MAT 8:11"/>Kintu Moi tumikhan ke koi ase, purab aru paschim desh khan pora bisi manu ahibo, aru taikhan aram kori kene Abraham, Isaac, aru Jacob, usorte sorgo laga rajyote bohibo. <verse eid="MAT 8:11"/><verse number="12" style="v" sid="MAT 8:12"/>Kintu rajyo laga bacha khan ke andhera jagate phelai dibo, juntu jagate khali daat kamurikena kanda he thakibo.” <verse eid="MAT 8:12"/><verse number="13" style="v" sid="MAT 8:13"/>Titia Jisu etu henapoti ke koise,“Jabi! Jineka tumi biswas korise, etu nisena he hobo dibi.” Aru thik utu homoi te tai laga nokor bhal hoi jaise.<verse eid="MAT 8:13"/></para>
  <para style="s">Jisu Pora Bisi Manu Ke Changai Kori Diya</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14"/>Jitia Jisu pora Peter laga ghor te ahise, Peter laga maiki laga ama bukhar pora bemar hoi kene ghumai thaka dikhise. <verse eid="MAT 8:14"/><verse number="15" style="v" sid="MAT 8:15"/>Jisu pora tai laga hath choise aru titia bemar taike chari kene jaise. Etu pichete tai uthikena Jisu ke kha luwa sewa kori bole shuru hoijai. <verse eid="MAT 8:15"/><verse number="16" style="v" sid="MAT 8:16"/>Jitia saam hoi thakise, manu khan Jisu usorte biya atma humai kene thaka manu khan ke loi kene anise. Tai laga kotha pora sob biya atma khan ke khedai dise aru sob bemar thaka manu khan ke changai kori dise. <verse eid="MAT 8:16"/><verse number="17" style="v" sid="MAT 8:17"/>Etu nisena juntu kotha khan bhabobadi Isaiah koi dise, eitu khan sob purah hoi jaise, “Tai nijor he amikhan laga sob bemar khan loi loise aru amikhan laga sob ghao khan nijor bukhi loise<note caller="+" style="f"><char style="fr" closed="false">8.17 </char><char style="fq" closed="false">Tai nijor he amikhan laga sob bemar khan loi loise aru amikhan laga sob ghao khan nijor bukhi loise. </char><char style="ft" closed="false">Isa. 53:4</char></note>.”<verse eid="MAT 8:17"/></para>
  <para style="s">Jisu Laga Piche Jabo Laga Daam</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18"/>Jitia Jisu pora Tai usorte dangor bhir joma hoi kene dikhise, Tai dusra khan ke Galilee laga Samundar laga dusra phale jai jabi koi kene hukum dise. <verse eid="MAT 8:18"/><verse number="19" style="v" sid="MAT 8:19"/>Etu pichete niyom likha manu Tai logote ahise aru koise, “Shika manu, Apuni kot jai ami bhi Apuni pichete jabo.” <verse eid="MAT 8:19"/><verse number="20" style="v" sid="MAT 8:20"/>Jisu taike koise, “Shial khan chenda bhitor te thake, chiriya khan pata pora bona ghor te thake, kintu Manu laga Putro nimite thaki bole jaga nai.” <verse eid="MAT 8:20"/><verse number="21" style="v" sid="MAT 8:21"/>Jisu laga ekjon chela pora taike koise, “Probhu, moike poila ekbar ghor te jai kene ami laga baba ke kobor dikena ahibole dibi.” <verse eid="MAT 8:21"/><verse number="22" style="v" sid="MAT 8:22"/>Kintu Jisu taike koise, “Moi laga piche koribi, aru mora manu khan ke taikhan nijorke kobor dibole dibi.”<verse eid="MAT 8:22"/></para>
  <para style="s">Jisu Pora Tufan Rukhai Diya</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23"/>Jitia Jisu naw bhitor te bohi loise, tai laga chela khan sob Tai piche korise. <verse eid="MAT 8:23"/><verse number="24" style="v" sid="MAT 8:24"/>Aru sabi, ekta dangor andhi nodi pora uthibole shuru hoise, aru purah naw to hawa aru pani pora hiliai thakise. Kintu Jisu to ghumai thakise. <verse eid="MAT 8:24"/><verse number="25" style="v" sid="MAT 8:25"/>Titia chela khan Tai usorte ahise aru eneka koi kene uthai dise, “Probhu, amikhan ke bacha bhi; amikhan mori bole ase!” <verse eid="MAT 8:25"/><verse number="26" style="v" sid="MAT 8:26"/>Jisu taikhan ke koise, “Tumikhan biswas komti thaka khan kele bhoi khai ase? Etu pichete Tai uthikena nodi aru hawa pani ke hukum dise. Titia sob chup-chap hoi jaise. <verse eid="MAT 8:26"/><verse number="27" style="v" sid="MAT 8:27"/>Kintu sob manu asurit koi kene koise, “Etu ki kisim laga manu ase, hawa aru pani tak Tai laga kotha mane?”<verse eid="MAT 8:27"/></para>
  <para style="s">Biya Atma Pora Dhori Thaka Duijon ke Jisu Pora Changai Kora</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28"/>Jitia Jisu samundar paar kori kene Gadarene laga desh te punchise, duijon manu jun logote biya atma ghusikena thakise, Jisu ke lok korise. Taikhan koboristan pora ulaikena ahise aru bisi khechera huwa pora manu khan etu rasta pora nabira hoise. <verse eid="MAT 8:28"/><verse number="29" style="v" sid="MAT 8:29"/>Sabi, taikhan hala kori kene koise, “Amikhan Apuni ke ki kori dibo, Isor laga Putro? Apuni homoi napuncha age te aha laga motlob to amikhan ke bisi dukh dibole ase naki?<note caller="+" style="f"><char style="fr" closed="false">8.29 </char><char style="fq" closed="false">Amikhan Apuni ke ki kori dibo, Isor laga Putro? Apuni homoi napuncha age te aha laga motlob to amikhan ke bisi dukh dibole ase naki. </char><char style="ft" closed="false">Luke 4:34</char></note>” <verse eid="MAT 8:29"/><verse number="30" style="v" sid="MAT 8:30"/>Utu somoite dur nohoi kene kunba gahori dana khai thakisele. <verse eid="MAT 8:30"/><verse number="31" style="v" sid="MAT 8:31"/>Aru biya atma khan Jisu ke anurodh kori kene koise, “Apuni amikhan ke khedai dibole ase koile, amikhan ke gahori khan laga gaw te ghusi bo dibi.” <verse eid="MAT 8:31"/><verse number="32" style="v" sid="MAT 8:32"/>Titia Jisu taikhan ke koise, “Jabi!” Etu hukum diya pichete sob biya atma khan ulaise aru gahori laga gaw bhitor te ghusi jaise; aru sabi, etu sob gahori pahar upor pora polaikena nodi te girikena panite dubi mori jaise. <verse eid="MAT 8:32"/><verse number="33" style="v" sid="MAT 8:33"/>Kintu juntu gahori saithaka manu khan sheher te polaikena sob manu khan ke khobor dise. <verse eid="MAT 8:33"/><verse number="34" style="v" sid="MAT 8:34"/>Sabi, pura sheher laga manu khan Jisu ke lok kori bole ulai ahise. Jitia taikhan Jisu ke dikhise, taikhan Jisu ke anurodh korise aru etu jaga pora jai jabole koise.<verse eid="MAT 8:34"/></para>
  <chapter eid="MAT 8"/>
  <chapter number="9" style="c" sid="MAT 9"/>
  <para style="s">Jisu Pora Jothor-Rugi Ekjon Ke Bhal Kora</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1"/>Titia Jisu naw te uthi loise aru nodi paar korise, aru tai nijor laga town, Capernaum te ahi jaise. <verse eid="MAT 9:1"/><verse number="2" style="v" sid="MAT 9:2"/>Sabi, manu khan ekjon jothor bemar thaka manu ke chatai te ghumai thaka ke loi anise. Jitia Jisu taikhan laga biswas dikhise, tai jothor bemar manu ke koise, “Putro, mon dangor koribi. Tumi laga paap sob maph kori dise.” <verse eid="MAT 9:2"/><verse number="3" style="v" sid="MAT 9:3"/>Titia sabi, niyom likha manu khan taikhan majote koise, “Etu manu Isor laga biya kotha koi ase.” <verse eid="MAT 9:3"/><verse number="4" style="v" sid="MAT 9:4"/>Kintu Jisu taikhan laga bhabona janikena koise, “Tumikhan ki hisab te mon bhitor te biya kotha bhabona kori ase? <verse eid="MAT 9:4"/><verse number="5" style="v" sid="MAT 9:5"/>Kilekoile, kuntu he asan ase, ‘Tumikhan laga paapkhan sob maph kori dise,’ na, ‘Uthibi aru berabi’ etu thik ase? <verse eid="MAT 9:5"/><verse number="6" style="v" sid="MAT 9:6"/>Kintu tumikhan ke jonai dibole, Manu laga Putro ke etu prithibi te adhikar dikena ase manu laga paapkhan maph kori bole, ...” Etu pichete Tai etu manu ke koise, “Uthibi, tumi laga chatai lobi, aru nijor laga ghor te jabi.” <verse eid="MAT 9:6"/><verse number="7" style="v" sid="MAT 9:7"/>Titia etu manu uthise aru nijor ghor te jai jaise. <verse eid="MAT 9:7"/><verse number="8" style="v" sid="MAT 9:8"/>Jitia manu khan etu dikhise, taikhan asurit hoise aru Isor ke mohima dise, jun he manu khan ke eneka adhikar dise koi kene.<verse eid="MAT 9:8"/></para>
  <para style="s">Jisu Pora Matthew Ke Mata</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9"/>Jitia Jisu etu jaga paar hoi kene jai thakise, tai Matthew koi kene ekjon manu ke dikhise, jun poisa utha laga jagate kaam kori thakise. Tai pora taike koise, “Ami laga piche koribi.” Aru tai uthise aru Jisu laga piche korise.<verse eid="MAT 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10"/>Aru eneka hoise, jitia Jisu Matthew laga ghor te bohi kene bhat khabole hoise, sabi, bisi poisa utha manu khan<note caller="+" style="f"><char style="fr" closed="false">9.10 </char><char style="ft" closed="false">Poisa utha manu khan ke paapi khan eneka koi thakisele, kelemane taikhan to Isor najana manu khan logote bhi kaam kori thaka nimite.</char></note> aru dusra paapi manu khan bhi ahise aru Jisu aru tai laga chela khan sob eke logote khaise. <verse eid="MAT 9:10"/><verse number="11" style="v" sid="MAT 9:11"/>Jitia kunba Pharisee khan etu dikhise, taikhan Jisu laga chela khan ke hudise, “Kile apnikhan laga malik to poisa utha aru dusra paapi manu khan logote milikena khai ase?” <verse eid="MAT 9:11"/><verse number="12" style="v" sid="MAT 9:12"/>Jitia Jisu etu hunise, Tai koise, “Jun laga gaw sob thik ase, taike bemar bhal kora manu nalage, khali jun khan bemar ase taikhan ke lage. <verse eid="MAT 9:12"/><verse number="13" style="v" sid="MAT 9:13"/>Kintu tumikhan jabi aru sikhibi Isor laga kotha te etu laga motlob ki ase: ‘Ami to tumikhan boli diya to nalage, hoilebi daya kora to Moi laga itcha ase.’ Kilekoile Ami dhormik khan ke mati bole aha nohoi, kintu paapi manu khan karone ahise<note caller="+" style="f"><char style="fr" closed="false">9.13 </char><char style="fq" closed="false">Kilekoile Ami dhormik khan ke mati bole aha nohoi, kintu paapi manu khan karone ahise. </char><char style="ft" closed="false">Hos. 6:6</char></note>.’”<verse eid="MAT 9:13"/></para>
  <para style="s">Upwas Aru Prathana Koribo Karone Huda</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14"/>Aru ek din, John laga chela khan Tai logote ahikena koise, “Kile Pharisee aru amikhan upwas kore, kintu Apuni laga chela khan to nakore?” <verse eid="MAT 9:14"/><verse number="15" style="v" sid="MAT 9:15"/>Jisu taikhan ke jawan dise, “Shadi te aha khan mon dukh hoi kene shadi kora jon logote thake naki? Kintu utu din ahibo jitia shadi kora jonke taikhan pora loijabo, aru etu pichete taikhan upwas lobo. <verse eid="MAT 9:15"/><verse number="16" style="v" sid="MAT 9:16"/>Kun manu bhi ekta notun kapra ke purana kapra logote silai kene nalagai, kele koile etu kapra laga silakhan sob ulai jabo, aru bisi biya pora phati jabo. <verse eid="MAT 9:16"/><verse number="17" style="v" sid="MAT 9:17"/>Nohoi lebi manu khan purana angur ros ke notun chamra laga jola te nadhale. Nohoile, chamra jola to phati jabo, aru angur ros to pura giri jabo aru chamra jola pura biya hoi jabo. Hoilebi, taikhan notun chamra jola te notun angur ros hale, eneka hoile duita bhi bhal thakibo.”<verse eid="MAT 9:17"/></para>
  <para style="s">Swali Ekjon Ke Jinda Uthai diya aru Mahila Ekjon ke Changai Kora</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18"/>Jitia Tai eitu khan taikhan ke koi thakise, sabi, ekjon sahab ahise aru Jisu age te matha jhukise. Tai koise, “Moi laga chukri etiya mori jaise, kintu Apuni ahibi aru tai uporte Apuni laga hath lagai dibi, aru tai jinda hoi jabo.” <verse eid="MAT 9:18"/><verse number="19" style="v" sid="MAT 9:19"/>Etu pichete Jisu uthise aru tai logote jaise, aru Tai laga chela khan bhi piche ahise. <verse eid="MAT 9:19"/><verse number="20" style="v" sid="MAT 9:20"/>Sabi, ekjon mahila jun baroh saal pora khun jai thaka bemar pora dukh pai thakise, tai Jisu laga piche ahikena Tai laga kapra kinar te chuise. <verse eid="MAT 9:20"/><verse number="21" style="v" sid="MAT 9:21"/>Kilekoile etu mahila pora tai nijorke koise, “Khali Tai laga kapra chuile, ami bhal hoi jabo.” <verse eid="MAT 9:21"/><verse number="22" style="v" sid="MAT 9:22"/>Kintu Jisu piche ghurise aru taike saikene koise, “Chukri, mon dangor kori lobi; apuni laga biswas pora bhal hoise.” Aru utu homoi te etu mahila ke changai paise. <verse eid="MAT 9:22"/><verse number="23" style="v" sid="MAT 9:23"/>Titia Jisu utu daruga laga ghor te punchise, aru Tai pora basuri baja manu khan<note caller="+" style="f"><char style="fr" closed="false">9.23 </char><char style="ft" closed="false">Yehudi niyom hisab te manu mora ghor te, bisi gorib manu khan bhi komsekom duijon basuri baja manu aru ekjon kandibole maiki thaki bole lage eneka thakisele. </char></note> aru dangor bhir joma hoi kene hala kori thaka dikhise. <verse eid="MAT 9:23"/><verse number="24" style="v" sid="MAT 9:24"/>Tai koise, “Jai jabi, kele koile etu chukri mora nai, kintu tai ghumai ase.” Kintu etu manu khan Jisu ke hasi di thakise. <verse eid="MAT 9:24"/><verse number="25" style="v" sid="MAT 9:25"/>Jitia joma koi kene thaka manu khan sobke bahar te pathai dise, Tai ghor bhitor te ghusi se aru etu chukri ke hath pora dhurise, aru etu chukri uthijaise. <verse eid="MAT 9:25"/><verse number="26" style="v" sid="MAT 9:26"/>Aru etu laga khobor utu desh sob te punchi jaise.<verse eid="MAT 9:26"/></para>
  <para style="s">Jisu Pora Andha Duijon Ke Bhal Kora</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27"/>Jisu jitia berai jai thakise, duijon andha manu tai piche korise. Taikhan hala kori kene koise, “Amikhan ke daya koribi, David laga Putro!” <verse eid="MAT 9:27"/><verse number="28" style="v" sid="MAT 9:28"/>Jitia Jisu ghor te punchise, andha khan tai usorte ahise. Jisu taikhan ke koise, “Tumikhan biswas kore na nai ami etu koribo pare koi kene?” Taikhan koise, “Hoi, Probhu.” <verse eid="MAT 9:28"/><verse number="29" style="v" sid="MAT 9:29"/>Aru Jisu taikhan laga suku chuise, aru koise, “Tumikhan laga biswas hisab te hoi jabi,” <verse eid="MAT 9:29"/><verse number="30" style="v" sid="MAT 9:30"/>aru taikhan laga suku khuli jaise. Jisu pora taikhan ke kara pora hukum dikene eneka koise, “Sabi etu kotha khan kunke bhi janibo nadibi.” <verse eid="MAT 9:30"/><verse number="31" style="v" sid="MAT 9:31"/>Kintu etu duijon manu bahar te ulai jaise aru sob desh te etu laga khobor koi dise.<verse eid="MAT 9:31"/></para>
  <para style="s">Jisu He Gunga Ke Bhal Kora</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32"/>Tai duijon jai thaka somoite, sabi, ekjon bhoot atma ghumai kene ghunga thaka manu ke Jisu usorte anise. <verse eid="MAT 9:32"/><verse number="33" style="v" sid="MAT 9:33"/>Jitia bhoot atma ke khedai dise, tai kotha kori bole parise. Sob manu dikhi kene asurit hoise, aru koise, “Eneka asurit kaam to kitia bhi Israel desh te dikha nai!” <verse eid="MAT 9:33"/><verse number="34" style="v" sid="MAT 9:34"/>Kintu Pharisee khan eneka koise, “Bhoot atma laga cholawta huwa nimite, tai bhoot atma ke kheda bole pari ase.”<verse eid="MAT 9:34"/></para>
  <para style="s">Dhan Bisi Pakki kene Ase, Kintu Kati bole Manu Komti</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35"/>Jisu sob sheher khan aru bosti khan te berai kene jaise. Tai mondoli khan te jai kene rajyo laga susamachar khan sikhai thakise aru sob biya bemar khan ke bhal korise. <verse eid="MAT 9:35"/><verse number="36" style="v" sid="MAT 9:36"/>Jitia Tai manu joma koi kene thaka dikhise, Tai bisi morom lagise, kele koile taikhan bisi dukh aru chinta hoi kene thakise, jineka mer khan laga ekjon rokhiya nathaka nisena<note caller="+" style="f"><char style="fr" closed="false">9.36 </char><char style="fq" closed="false">Mer khan laga ekjon rokhiya nathaka nisena </char><char style="ft" closed="false">1 Kin. 22:17</char></note>. <verse eid="MAT 9:36"/><verse number="37" style="v" sid="MAT 9:37"/>Etu pichete Jisu taikhan laga chela khan ke koise, “Dhan bisi pakki kene ase, kintu kati bole manu komti ase. <verse eid="MAT 9:37"/><verse number="38" style="v" sid="MAT 9:38"/>Etu nimite, joldi Probhu ke prathana kori bhi, titia Tai kaam kori bole manu khan ke pathai dibo.”<verse eid="MAT 9:38"/></para>
  <chapter eid="MAT 9"/>
  <chapter number="10" style="c" sid="MAT 10"/>
  <para style="s">Baroh jon Apostle</para>
  <para style="lh">
    <verse number="1" style="v" sid="MAT 10:1"/>Jisu tai laga baroh ta chela khan sobke matise aru taikhan ke atma khan kheda bole aru sob bemar khan bhal kori bole adhikar dise. <verse eid="MAT 10:1"/><verse number="2" style="v" sid="MAT 10:2"/>Etiya etu baroh ta chela khan laga naam khan eneka thakise. Poila, Simon -junke Peter koi kene mate-, aru tai laga bhai Andrew; James, Zebedee laga chokra, aru tai laga bhai John; <verse eid="MAT 10:2"/><verse number="3" style="v" sid="MAT 10:3"/>Philip, aru Bartholomew; Thomas, aru Matthew ekjon poisa utha manu; James, Alphaeus laga chokra, aru Thaddaeus; <verse eid="MAT 10:3"/><verse number="4" style="v" sid="MAT 10:4"/>Simon ekjon Zealot, aru Judas Iscariot, jun Jisu ke thogabo.<verse eid="MAT 10:4"/></para>
  <para style="s">Jisu Pora Baroh jon Apostle Ke Pathai Diya</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5"/>Aru baroh ta jon chela khan ke Jisu pora pathai dise. Tai bujhai kene koise, “Porjati manu khan laga rasta te najabi, aru Samaria nogor bhitor te naghusi bhi<note caller="+" style="f"><char style="fr" closed="false">10.5 </char><char style="fq" closed="false">Samaria nogor bhitor te naghusi bhi </char><char style="ft" closed="false">Jer. 50:6</char></note>. <verse eid="MAT 10:5"/><verse number="6" style="v" sid="MAT 10:6"/>Kintu harai ja-a mer khan jun ase Israel laga ghor, taikhan logot jabi; <verse eid="MAT 10:6"/><verse number="7" style="v" sid="MAT 10:7"/>aru jitia tumikhan jai, prochar kori kene kobi, ‘Sorgo laga rajyo usor ahi ase.’ <verse eid="MAT 10:7"/><verse number="8" style="v" sid="MAT 10:8"/>Bemar khan ke bhal koribi, mora khan ke uthai dibi, kusto bemar thaka khan ke sapha kori dibi, aru biya atma khan ke khedai dibi. Eku daam naterai kene paise, eku daam noloikena dibi. <verse eid="MAT 10:8"/><verse number="9" style="v" sid="MAT 10:9"/>Suna, chandi, nohoile pitol khan eku nabukhibi. <verse eid="MAT 10:9"/><verse number="10" style="v" sid="MAT 10:10"/>Eku jola nadhuribi jai thaka somoite, nohoile duita kapra, nohoile chapal, nohoile lathi nadhuribi, kele koile kaam kora khan ke hajira pabo lage. <verse eid="MAT 10:10"/><verse number="11" style="v" sid="MAT 10:11"/>Kuntu sheher nohoile bhi bosti te tumikhan jai, utu jagate ekjon bhal manu ke bisaribi, aru jitia tak tumi chari kene najai, tai laga ghor te he thakibi. <verse eid="MAT 10:11"/><verse number="12" style="v" sid="MAT 10:12"/>Jitia tumi tai laga ghor te ghuse, taike salam koribi. <verse eid="MAT 10:12"/><verse number="13" style="v" sid="MAT 10:13"/>Aru etu ghor to thik hoile, tumikhan laga shanti ta te thakibo dibi. Kintu jodi ghor to thik nohoi, tinehoile shanti to wapas tumikhan laga hobo. <verse eid="MAT 10:13"/><verse number="14" style="v" sid="MAT 10:14"/>Judi utu ghor te tumikhan ke ghusibole nadiye, aru utu sheher manu khan pora tumikhan laga kotha nahune, tinehoile etu jaga chari bhi aru tumi laga theng te dhula khan jharikena jai jabi. <verse eid="MAT 10:14"/><verse number="15" style="v" sid="MAT 10:15"/>Hosa pora Moi koi ase, jitia Isor laga bisar kora din ahibo, etu dinte etu sheher to Sodom aru Gomorrah town khan pora bhi bisi lobole napara laga saja pabo<note caller="+" style="f"><char style="fr" closed="false">10.15 </char><char style="ft" closed="false">Gen. 19.</char></note>.<verse eid="MAT 10:15"/></para>
  <para style="s">Tarona Kora Ahibo</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16"/>Sabi, Ami tumikhan ke ekta mer nisena rong kutta janwar khan majote pathai ase, etu nimite saph nisena gyaani thakibi aru kabotar nisena norom thakibi. <verse eid="MAT 10:16"/><verse number="17" style="v" sid="MAT 10:17"/>Eneka manu khan pora hoshiar koi kene thakibi! Kilekoile taikhan tumikhan ke sabhakhan te loijabo, aru taikhan laga mondoli bhitor te tumikhan ke marikena sajai dibo. <verse eid="MAT 10:17"/><verse number="18" style="v" sid="MAT 10:18"/>Etu pichete Ami nimite tumikhan ke Governor aru raja khan laga age te anibo, dusra khan aru Porjati khan ke ekta gawahi nisena dikhai dibole. <verse eid="MAT 10:18"/><verse number="19" style="v" sid="MAT 10:19"/>Jitia taikhan tumikhan ke taikhan hathte di dibo, titia tumikhan ki kobo lage etu karone chinta na koribi, kele koile thik somoite ji kobo lage etu sob tumikhan ke koi dibo. <verse eid="MAT 10:19"/><verse number="20" style="v" sid="MAT 10:20"/>Kilekoile tumikhan pora nakobo, kintu Baba laga Atma pora he tumikhan nimite koi dibo. <verse eid="MAT 10:20"/><verse number="21" style="v" sid="MAT 10:21"/>Bhai pora he kokai ke phasai dibo, aru baba pora nijor bacha ke. Bacha khan ama baba khan logote jhagara koribo aru taikhan ke morai dibole koribo. <verse eid="MAT 10:21"/><verse number="22" style="v" sid="MAT 10:22"/>Moi laga naam nimite tumikhan ke sob pora ghin koribo. Kintu jun khan dukh digdar puwa homoi sob khotom nohua tak dhorjo kori kene thakibo pare, taikhan he bachibo. <verse eid="MAT 10:22"/><verse number="23" style="v" sid="MAT 10:23"/>Jitia taikhan pora etu sheher te tumikhan ke biya pora digdar dibo, dusra jagate polai jabi, kele koile Ami hosa pora tumikhan ke koi ase, Manu laga Putro naha age te tumikhan Israel laga sob sheher khan te jai kene khotom kori bole na paribo.<verse eid="MAT 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24"/>Ekjon chela tai laga guru pora dangor nohoi, nohoi lebi ekjon nokor malik pora dangor nohoi. <verse eid="MAT 10:24"/><verse number="25" style="v" sid="MAT 10:25"/>Ekjon chela tai laga guru nisena hoile etu he thik ase, aru ekjon nokor tai laga malik nisena hoile he thik ase. Judi taikhan etu ghor malik ke Beelzebul<note caller="+" style="f"><char style="fr" closed="false">10.25 </char><char style="ft" closed="false">Saitan</char></note> koi kene mate koile, kiman bhi biya pora tai laga ghor manu khan ke matibo!<verse eid="MAT 10:25"/></para>
  <para style="s">Bhoi Na koribi</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26"/>Etu karone taikhan ke bhoi nakhabi, kele koile lukaikene thaka eku nai juntu ke janai nadibo, aru juntu janai dibole pare, etu ke lukai kene rakhibo na paribo. <verse eid="MAT 10:26"/><verse number="27" style="v" sid="MAT 10:27"/>Ji kotha Ami pora tumikhan ke andhera te koi ase, tumikhan pora dinte koi dibi, aru ji kotha tumikhan norom pora kan te huni pai ase, ghor laga sobse untcha jagate uthikena jor pora sobke hunai dibi. <verse eid="MAT 10:27"/><verse number="28" style="v" sid="MAT 10:28"/>Jun khan manu ke morai diye eitu khan ke bhoi na koribi kele koile taikhan tumikhan laga jibon ke morai dibole napare. Hoilebi, Isor ke bhoi koribi Jun he tumikhan laga gaw aru jibon ke bhi khotom kori dibole pare. <verse eid="MAT 10:28"/><verse number="29" style="v" sid="MAT 10:29"/>Ekta chutu chandi pora duita ghor chiriya ke kini bole napare naki? Titia bhi tumikhan laga Baba pora najanikena ekta chiriya bhi matite giribole nadiye. <verse eid="MAT 10:29"/><verse number="30" style="v" sid="MAT 10:30"/>Kintu tumikhan laga matha te chuli thaka khan sob ginti kori kene ase. <verse eid="MAT 10:30"/><verse number="31" style="v" sid="MAT 10:31"/>Etu karone bhoi na koribi. Tumikhan ke ghor laga chiriya pora bhi bisi morom kore. <verse eid="MAT 10:31"/><verse number="32" style="v" sid="MAT 10:32"/>Etu karone jun manu sob manu khan laga age te Moi laga naam shikar koribo, Ami bhi tai laga naam sorgote thaka Ami laga Baba age te shikar dibo. <verse eid="MAT 10:32"/><verse number="33" style="v" sid="MAT 10:33"/>Kintu jun manu pora sob manu laga age te Ami laga naam noloi, Ami bhi tai laga naam sorgote thaka Ami laga Baba age te nolobo.<verse eid="MAT 10:33"/></para>
  <para style="s">Shanti Nohoi, Kintu Talwar</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34"/>Ami etu prithibi te shanti dibole aha nohoi. Ami shanti loi kene aha nai, kintu talwar loi kene ahise. <verse eid="MAT 10:34"/><verse number="35" style="v" sid="MAT 10:35"/>Kilekoile Ami aha to chokra ke tai laga baba pora alag kori dibole, aru ekjon chukri ke tai laga ama pora alag kori dibole, aru ekjon buari ke tai laga sasuma pora alag kori dibole ahise. <verse eid="MAT 10:35"/><verse number="36" style="v" sid="MAT 10:36"/>Ekjon mota laga dushman khan nijor ghor manu khan he hobo. <verse eid="MAT 10:36"/><verse number="37" style="v" sid="MAT 10:37"/>Jun manu tai nijor baba aru ama ke Ami pora bisi morom kore tai Ami laga chela hobo na paribo; aru jun tai njior chokra nohoi lebi chukri ke Ami pora bhi bisi morom kore, tai Ami laga chela hobo na paribo. <verse eid="MAT 10:37"/><verse number="38" style="v" sid="MAT 10:38"/>Jun manu tai laga nijor Cross to uthaikene moi laga piche nahe, tai Ami laga chela hobo na paribo. <verse eid="MAT 10:38"/><verse number="39" style="v" sid="MAT 10:39"/>Jun manu tai nijor jibon to bacha bole itcha kore tai harai jabo. Kintu jun manu Moi nimite tai laga jibon diye, tai to aru wapas pabo.<verse eid="MAT 10:39"/></para>
  <para style="s">Inam</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40"/>Jun manu tumike grohon kore, tai Moike bhi grohon kore, aru jun tumike grohon kore, Isor, jun pora Amike pathaise, Taike bhi grohon kore. <verse eid="MAT 10:40"/><verse number="41" style="v" sid="MAT 10:41"/>Jun manu ekjon bhabobadi khan ke grohon kore, tai bhabobadi laga inam pabo, aru jun manu dhormik manu ke grohon kore, tai dhormik manu laga inam pabo. <verse eid="MAT 10:41"/><verse number="42" style="v" sid="MAT 10:42"/>Jun khan etu chutu dukhiya ekjon ke Ami laga chela ase koi kene ek kup thanda pani khilai dibo, hosa pora Ami koi ase, tai to hosa pora bhi tai laga inam to naharabo.”<verse eid="MAT 10:42"/></para>
  <chapter eid="MAT 10"/>
  <chapter number="11" style="c" sid="MAT 11"/>
  <para style="s">Baptizma Diya John Laga Khobor Diya Manu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1"/>Eneka hoise jitia Jisu tai laga baroh jon chela khan ke niyom khan bujhai diya pichete, tai ta te pora ulaikena taikhan laga sheher te jai kene prochar kori bole aru sikhai dibole jai jaise. <verse eid="MAT 11:1"/><verse number="2" style="v" sid="MAT 11:2"/>Etu homoi te John bondhi ghor te thakise, tai Khrista laga kotha huni paise, aru tai tai laga chela khan ke ekta jankari dibole pathaise <verse eid="MAT 11:2"/><verse number="3" style="v" sid="MAT 11:3"/>aru Taike hudise, “Apuni ahibole thaka Jon<note caller="+" style="f"><char style="fr" closed="false">11.3 </char><char style="ft" closed="false">Ahibole thaka Masiha. </char></note> ase naki, na amikhan dusra ke bisaribo?” <verse eid="MAT 11:3"/><verse number="4" style="v" sid="MAT 11:4"/>Jisu pora jowab dikene koise, “Jabi aru John ke koi dibi tumikhan ki hunise aru dikhise. <verse eid="MAT 11:4"/><verse number="5" style="v" sid="MAT 11:5"/>Andha manu khan dikhibole paise, lengera khan bera bole parise, kusto bemar thaka khan sapha hoi jaise, behera khan huni bole paise, morija khan jinda hoise, aru gorib manu khan susamachar huni loise. <verse eid="MAT 11:5"/><verse number="6" style="v" sid="MAT 11:6"/>Jun manu Amike dikhikena biya panai tai to asis paise.”<verse eid="MAT 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7"/>Jitia taikhan jaise, Jisu pora bhir ke John laga kotha kori bole shuru hoise, “Tumikhan balu laga jagate ki sabole jaise- panite ulai thaka ghas ke hawa pora hilai diya to? <verse eid="MAT 11:7"/><verse number="8" style="v" sid="MAT 11:8"/>Aru tumikhan ta te ki sabole jaise- ekjon manu norom kapra lagai kene thaka ke? Hosa bhi, jun khan norom kapra lagai, taikhan to raja khan laga ghor te he thake. <verse eid="MAT 11:8"/><verse number="9" style="v" sid="MAT 11:9"/>Aru tumikhan ki sabole ta te jaise- ekjon bhabobadi? Hoi, Ami tumikhan ke koi ase, tai ekjon bhabobadi pora bhi bisi ase. <verse eid="MAT 11:9"/><verse number="10" style="v" sid="MAT 11:10"/>Etu tai ase, jun karone eneka Isor kotha te likhi kene ase,</para>
  <para style="q" vid="MAT 11:10">‘Sabi, Ami pora tumikhan laga chehera age te Ami laga khobor diya manu pathai ase, jun pora tumikhan nimite rasta taiyar koribo.’<note caller="+" style="f"><char style="fr" closed="false">11.10 </char><char style="ft" closed="false">Mal. 3:1</char></note><verse eid="MAT 11:10"/></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11"/>Ami hosa pora tumikhan ke koi ase, tumikhan majote Baptizma diya John nisena kun ama pora bhi jonom diya nai. Hoilebi sorgo laga rajyote thaka sob pora kaam nathaka manu bhi tai pora bisi dangor ase. <verse eid="MAT 11:11"/><verse number="12" style="v" sid="MAT 11:12"/>Baptizma diya John laga din pora loi kene etiya tak, sorgo laga rajyo to mara-mari khan pora dukh paise, aru jhagara pora joborjosti kori kene chingi loise. <verse eid="MAT 11:12"/><verse number="13" style="v" sid="MAT 11:13"/>Kilekoile John naha age te sob bhabobadi khan aru niyom khan laga bhabobani hoi thakise; <verse eid="MAT 11:13"/><verse number="14" style="v" sid="MAT 11:14"/>aru jodi tumikhan lobole itcha ase koile, tai to Elijah ase jun ahibole thakise<note caller="+" style="f"><char style="fr" closed="false">11.14 </char><char style="ft" closed="false">Mal. 4:5</char></note>. <verse eid="MAT 11:14"/><verse number="15" style="v" sid="MAT 11:15"/>Jun laga kan khan ase, taikhan ke huni bole dibi. <verse eid="MAT 11:15"/><verse number="16" style="v" sid="MAT 11:16"/>Ki logote etu yug laga manu khan ke tulona koribo? Bacha khan bajar te bohi kene thaka nisena, jun ekjon pora ekjon ke mati thake <verse eid="MAT 11:16"/><verse number="17" style="v" sid="MAT 11:17"/>aru koi, ‘Amikhan pora apnikhan karone shadi laga basuri bajaise, aru apnikhan nacha nai. Amikhan mon dukh hoise aru apnikhan mon dukh laga suku pani bhi ula nai.’ <verse eid="MAT 11:17"/><verse number="18" style="v" sid="MAT 11:18"/>Kilekoile John to pani aru kha luwa khaikena aha nohoi, aru taikhan koise, ‘Tai logot te bhoot ase.’ <verse eid="MAT 11:18"/><verse number="19" style="v" sid="MAT 11:19"/>Manu laga Putro to pani aru kha luwa kori kene ahise aru taikhan koise, ‘Sabi, tai to bisi khai aru ekjon sharabi ase, poisa utha aru paapi manu khan laga sathi ase!’ Kintu gyaan to tai laga bacha pora he dikhai dibo.”<verse eid="MAT 11:19"/></para>
  <para style="s">Mon Naghura Sheher Khan Nimite Mon Dukh Ase.</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20"/>Pichete Jisu jun to jagate tai laga asurit kaam khan dikhai dise, etu sheher khan laga manu khan ke gali dibole shuru korise, kele koile taikhan mon ghuraikena thaka nai. <verse eid="MAT 11:20"/><verse number="21" style="v" sid="MAT 11:21"/>“Chorazin, tumike hai ase! Bethsaida, tumike hai ase! Juntu kaam tumikhan nimite korise, eneka kaam Tyre aru Sidon nimite korise koile, taikhan poila pora bosta laga kapra aru jui laga koila lagai kene mon ghuri lobole thakise. <verse eid="MAT 11:21"/><verse number="22" style="v" sid="MAT 11:22"/>Kintu Moi tumikhan ke koi ase, Isor pora bisar kora dinte tumikhan pora bhi Tyre aru Sidon nimite he bisi aram hobo. <verse eid="MAT 11:22"/><verse number="23" style="v" sid="MAT 11:23"/>Tumi, Capernaum, tumikhan ke sorgo uporte uthibole nadibo, na uthibo dibo? Tumikhan ke Hades te namai dibo. Kilekoile tumikhan ke koi diya nisena jodi Sodom<note caller="+" style="f"><char style="fr" closed="false">11.23 </char><char style="ft" closed="false">Sodom to bisi paapi sheher ekta thakisele aru Isor pora etu ke khotom kori dise, Gen. 19: 24-29.</char></note> te bhi asurit aru dangor kaam korise koile, taikhan aji bachikena thakibo thakise. <verse eid="MAT 11:23"/><verse number="24" style="v" sid="MAT 11:24"/>Kintu Moi tumikhan ke koi ase, bisar laga dinte tumikhan pora bhi Sodom nimite he aram hobo.”<verse eid="MAT 11:24"/></para>
  <para style="s">Moi Logot Ahibi, Aru Moi Aram Dibo</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25"/>Etu somoite Jisu pora jowab dise aru koise, “Ami Apuni ke mohima di ase, Baba, Sorgo aru prithibi laga Probhu, kele koile Apuni eitu khan gyaani aru buja manu khan pora lukaikene rakhise, aru chutu bacha khan ke dikhai dise. <verse eid="MAT 11:25"/><verse number="26" style="v" sid="MAT 11:26"/>Hoi, Baba, kele koile etu to Apuni laga suku age te thik ase. <verse eid="MAT 11:26"/><verse number="27" style="v" sid="MAT 11:27"/>Sob kaam khan moi laga bharosa te Baba pora rakhidise; aru kun bhi Putro ke najane khali Baba he nohoile, aru kun bhi Baba ke najane khali Putro he nohoile, aru utu manu junke Putro pora basikena dikhai dibo. <verse eid="MAT 11:27"/><verse number="28" style="v" sid="MAT 11:28"/>Ami usorte ahibi, jun manu etu prithibi laga dukh chinta bukhi bo napari kene dabi kene ase, aru Moi tumikhan ke aram dibo. <verse eid="MAT 11:28"/><verse number="29" style="v" sid="MAT 11:29"/>Ami laga kotha khan lobi aru Ami pora sikhibi, kele koile Ami laga mon to nomro aru shanti ase, aru tumi laga jibon nimite aram pabo. <verse eid="MAT 11:29"/><verse number="30" style="v" sid="MAT 11:30"/>Kilekoile Ami laga kotha khan aram ase aru ami laga boja bisi halka ase.”<verse eid="MAT 11:30"/></para>
  <chapter eid="MAT 11"/>
  <chapter number="12" style="c" sid="MAT 12"/>
  <para style="s">Jisu He Bisram Din Laga Probhu Ase</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1"/>Utu somoite, ek Bisram dinte, Jisu dhaan kheti paar hoi kene jai thakise. Tai laga chela khan bhuk lagi thaka pora dhaan laga guti ulaikena khabole shuru korise. <verse eid="MAT 12:1"/><verse number="2" style="v" sid="MAT 12:2"/>Jitia Pharisee khan etu dikhise, taikhan Jisu ke koise, “Sabi, Apuni laga chela khan Bisram nimite niyom te nathaka kaam kori ase.” <verse eid="MAT 12:2"/><verse number="3" style="v" sid="MAT 12:3"/>Kintu Jisu taikhan ke koise, “Tumikhan kitia bhi Isor kotha te purah nai David pora ki korise, jitia tai aru tai logot thaka manu khan bhuk lagise?<note caller="+" style="f"><char style="fr" closed="false">12.3 </char><char style="ft" closed="false">1 Sam.21:1-6</char></note> <verse eid="MAT 12:3"/><verse number="4" style="v" sid="MAT 12:4"/>Tai Isor laga ghor te jaise aru Isor nimite rakhikena thaka roti khaise, juntu tai nimite nohoile tai logote thaka manu khan nimite khabole niyom te nai, kele koile khali purohit khan he ta te pora khabo pare. <verse eid="MAT 12:4"/><verse number="5" style="v" sid="MAT 12:5"/>Nohoile tumikhan Moses laga niyom te purah nai naki Bisram laga dinte mondoli te thaka purohit khan Bisram din laga niyom bhangai kintu taikhan ke etu golti ase koi kene nadhure?<note caller="+" style="f"><char style="fr" closed="false">12.5 </char><char style="ft" closed="false">Num. 38:9-10; Jos. 7:22-23</char></note> <verse eid="MAT 12:5"/><verse number="6" style="v" sid="MAT 12:6"/>Kintu Moi tumikhan ke koi ase, mondoli<note caller="+" style="f"><char style="fr" closed="false">12.6 </char><char style="ft" closed="false">Isor ke aradhana kora ghor.</char></note> pora bhi dangor jon to yate ase. <verse eid="MAT 12:6"/><verse number="7" style="v" sid="MAT 12:7"/>Jodi tumikhan etu laga motlob janikena thaki ase, ‘Moi daya kora he itcha ase aru bolidan diya nohoi,’ koile tumikhan golti nathaka khan ke golti ase koi kene namatibo<note caller="+" style="f"><char style="fr" closed="false">12.7 </char><char style="ft" closed="false">Hos. 6:6</char></note>. <verse eid="MAT 12:7"/><verse number="8" style="v" sid="MAT 12:8"/>Kilekoile Manu laga Putro he Bisram Din laga Probhu ase.”<verse eid="MAT 12:8"/></para>
  <para style="s">Hath Sukhikena Thaka Manu</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9"/>Etu pichete Jisu ta te pora ulaise aru taikhan laga mondoli te ghusi se. <verse eid="MAT 12:9"/><verse number="10" style="v" sid="MAT 12:10"/>Sabi, ta te ekjon manu thakise jun laga hath sukhikena thakise. Pharisee khan pora Jisu ke eneka koi kene hudise, “Bisram dinte bemar bhal kori diya to niyom ase naki?” Taikhan Jisu ke golti dibole nimite hudise. <verse eid="MAT 12:10"/><verse number="11" style="v" sid="MAT 12:11"/>Jisu taikhan ke koise, “Kun manu tumikhan majote ase, jun logote khali ekta mer he ase, aru jitia utu mer to Bisram dinte ekdom niche chenda te giri jai koile, tai utu mer ke nauthabo naki? <verse eid="MAT 12:11"/><verse number="12" style="v" sid="MAT 12:12"/>Tinehoile mer pora bhi manu khan kiman bhi kimti ase! Etu nimite Bisram dinte bhal kaam kora thik niyom ase.” <verse eid="MAT 12:12"/><verse number="13" style="v" sid="MAT 12:13"/>Etu pichete Jisu utu manu ke koise, “Tumi laga hath ke sida koribi.” Jitia tai hath sida korise, aru jineka dusra hath nisena, etu hath bhi bhal hoi jaise. <verse eid="MAT 12:13"/><verse number="14" style="v" sid="MAT 12:14"/>Kintu Pharisee khan ta te pora ulai jaise aru jai kene taikhan kineka kori kene Jisu ke morai dibo etu kotha khan kori thakise.<verse eid="MAT 12:14"/></para>
  <para style="s">Isor Laga Basi Luwa Sewak</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15"/>Jitia Jisu eitu khan janibole paise, Tai ta te pora ulai jaise. Bisi manu Tai piche korise, aru Tai sobke bhal kori dise. <verse eid="MAT 12:15"/><verse number="16" style="v" sid="MAT 12:16"/>Aru manu khan ke Tai janai dibole hoshiar kori dise, <verse eid="MAT 12:16"/><verse number="17" style="v" sid="MAT 12:17"/>titia Isor pora bhabobadi Isaiah dwara kowa kotha khan pura hobole karone eitu khan sob tineka he hoi jaise,<verse eid="MAT 12:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="MAT 12:18"/>“Sabi, etu Ami laga noukar ase junke Ami basi loise;</para>
  <para style="q" vid="MAT 12:18">Ami laga morom thaka ekjon, junke Moi laga jibon pora khushi ase.</para>
  <para style="q" vid="MAT 12:18">Moi Tai uporte Moi laga Atma rakhidibo,</para>
  <para style="q" vid="MAT 12:18">Aru Tai pora Porjati khan ke ajad kori dibo.<verse eid="MAT 12:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="MAT 12:19"/>Tai biya napabo nohoile bhi jor pora nakandibo;</para>
  <para style="q" vid="MAT 12:19">Nohoile bhi kun bhi rasta khan te Tai laga awaj nahunibo.<verse eid="MAT 12:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="MAT 12:20"/>Tai ekta tera koi kene thaka pani-ghas bhi bhangai nadibo;</para>
  <para style="q" vid="MAT 12:20">Tai khotom hobole thaka jui ke bhi bhutibole nadibo,</para>
  <para style="q" vid="MAT 12:20">Jitia tak Tai bisar ke age loi kene jiti noloi, <verse eid="MAT 12:20"/><verse number="21" style="v" sid="MAT 12:21"/>aru Tai laga naam uporte he Porjati khan asha thakibo.”<verse eid="MAT 12:21"/></para>
  <para style="s">Pobitro Atma Uporte Biya Kotha Kowa</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22"/>Etu pichete kunba ekjon andha aru gunga, bhoot pora bandi kene thaka, Jisu usorte loi anise. Jisu pora taike changai kori dise, aru tai kotha kori bole aru sabole pari jaise. <verse eid="MAT 12:22"/><verse number="23" style="v" sid="MAT 12:23"/>Sob manu khan dikhikena asurit hoise aru koise, “Etu manu to David laga Putro ase nohoi?” <verse eid="MAT 12:23"/><verse number="24" style="v" sid="MAT 12:24"/>Kintu jitia Pharisee khan asurit kaam to huni bole paise, taikhan koise, “Etu manu to Saitan laga raja, Beelzebul laga takot pora kaam kori ase, nohoile bhoot khan khedai dibo na paribo.” <verse eid="MAT 12:24"/><verse number="25" style="v" sid="MAT 12:25"/>Kintu Jisu taikhan laga bhabona jani thakise aru taikhan ke koise, “Juntu rajyo taikhan nijor majote apatti thake, etu rajyo to bhangi jai, aru juntu sheher nohoile bhi ghor to nijor majote apatti thake, etu bhangi jai. <verse eid="MAT 12:25"/><verse number="26" style="v" sid="MAT 12:26"/>Etu nimite jodi Saitan pora Saitan ke khedai dile, tai nijor bhirodh te bhag koi kene ase. Kineka kori kene tai laga rajyo to khara koribo? <verse eid="MAT 12:26"/><verse number="27" style="v" sid="MAT 12:27"/>Aru jodi Moi Beelzebul laga hokti loi kene bhoot khan ke khedai, tinehoile ki hokti pora tumikhan laga bacha khan bhoot khan ke khedai? Etu karone, taikhan pora tumikhan ke bisar koribo. <verse eid="MAT 12:27"/><verse number="28" style="v" sid="MAT 12:28"/>Kintu jodi Ami Isor laga Atma pora bhoot khan ke khedai diye, tinehoile Isor laga rajyo tumikhan uporte ahikena ase. <verse eid="MAT 12:28"/><verse number="29" style="v" sid="MAT 12:29"/>Nohoile kineka ekta takot thaka manu ke age nabandi kene utu ghor te ghusi kene saman khan chor koribo paribo? Poila takot manu ke bandibo lagibo etu pichete he tai laga saman khan chor koribo paribo. <verse eid="MAT 12:29"/><verse number="30" style="v" sid="MAT 12:30"/>Jun Ami logote nohoi tai Amike apatti kore, aru jun Ami logote joma nakore taikhan sob ephale-uphale hoi jabo. <verse eid="MAT 12:30"/><verse number="31" style="v" sid="MAT 12:31"/>Etu karone Moi tumikhan ke koi ase, sob paap aru hinsa kotha kora khan maph kori dibo, kintu jun manu Atma ke hinsa kore taike maph nadibo. <verse eid="MAT 12:31"/><verse number="32" style="v" sid="MAT 12:32"/>Jun manu pora Manu laga Putro ke apatti koribo tai maph pabo. Kintu jun manu Pobitro Atma ke apatti koribo, tai kitia bhi maph napabo, etu yug te bhi, aru ahibole thaka yug te bhi.<verse eid="MAT 12:32"/></para>
  <para style="s">Phol Pora Gash Jani Loi</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33"/>Ekta bhal ghas to bhal phol dhuri bo, nohoile biya ghas pora to biya phol he dhuri bo, kele koile phol pora he ghas ke janibole pare. <verse eid="MAT 12:33"/><verse number="34" style="v" sid="MAT 12:34"/>Saph laga bacha khan, tumikhan biya hoi kene, kineka bhal kotha koi? Kilekoile mon bhitor te ki ase, mukh pora etu he koi. <verse eid="MAT 12:34"/><verse number="35" style="v" sid="MAT 12:35"/>Bhal manu laga monte bhal saman khan joma kora nimite bhal khan he ulai, aru biya manu laga monte biya saman khan joma kora nimite biya khan he ulai. <verse eid="MAT 12:35"/><verse number="36" style="v" sid="MAT 12:36"/>Moi apnikhan ke koi ase jun manu misa-misi kotha kobo, taikhan bisar dinte etu laga hisab-kitab dibo lagibo. <verse eid="MAT 12:36"/><verse number="37" style="v" sid="MAT 12:37"/>Tumikhan laga kotha para he tumi laga bisar hobo, aru tumi laga kotha pora he tumi bodnam hobo.”<verse eid="MAT 12:37"/></para>
  <para style="s">Jonah Laga Chihna</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38"/>Etu pichete kunba Pharisee aru niyom likha khan Jisu ke eneka koise, “Shika manu, Apuni pora ekta chihna amikhan sabole itcha ase.” <verse eid="MAT 12:38"/><verse number="39" style="v" sid="MAT 12:39"/>Kintu Jisu taikhan ke jowab dise aru koise, “Ekta biya aru biswas nathaka jamana laga manu khan he chihna sabole bisare. Kintu eku bhi chihna dikhai nadibo khali bhabobadi Jonah laga chihna he sabo dibo.” <verse eid="MAT 12:39"/><verse number="40" style="v" sid="MAT 12:40"/>Kilekoile Jonah to tin din aru tin rati ekta dangor maas laga pet bhitor te thakise, etu nisena Manu laga Putro bhi tin din aru tin rati prithibi laga bhitor te thakibo. <verse eid="MAT 12:40"/><verse number="41" style="v" sid="MAT 12:41"/>Nineveh sheher te thaka manu khan bisar dinte etu jamana laga manu khan logote khara koribo aru bodnam dibo. Kilekoile taikhan to Jonah laga kotha huni kene mon ghuraise, aru sabi, ekjon Jonah pora bhi bisi dangor yate khara ase<note caller="+" style="f"><char style="fr" closed="false">12.41 </char><char style="ft" closed="false">John 3:5</char></note>. <verse eid="MAT 12:41"/><verse number="42" style="v" sid="MAT 12:42"/>Sheba laga Rani bisar dinte etu jamana laga manu khan logote uthi kene bodnam dibo. Tai prithibi laga sob pora dur jaga pora ahikena Solomon laga gyaani kotha huni bole ahise, aru sabi, ekjon Solomon pora bhi dangor yate khara ase<note caller="+" style="f"><char style="fr" closed="false">12.42 </char><char style="ft" closed="false">I Kin. 10:1-13; 2 Chr. 9:1-12</char></note>.<verse eid="MAT 12:42"/></para>
  <para style="s">Biya Atma Ghurai Aha</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43"/>Jitia ekta letera atma manu laga gaw pora bahar ulai jai, tai pani nathaka jaga pora paar kore aru aram kori bole bisare, kintu jaga napai. <verse eid="MAT 12:43"/><verse number="44" style="v" sid="MAT 12:44"/>Etu pichete tai koi, ‘Juntu jaga pora moi ulaikene ahise etu ghor te wapas jabo.’ Jitia tai ghuri ahe, tai ghor to khali aru sob sapha paise aru ghor te sob thik tak rakhi kene thaka dikhise. <verse eid="MAT 12:44"/><verse number="45" style="v" sid="MAT 12:45"/>Titia tai ta te pora ulaikene tai pora bhi bisi biya sat-ta atma khan ke loi kene ahise aru eke logote thaki jaise. Titia etu manu laga halat to poila pora bhi aru bisi biya hoijai. Thik etu nisena etu jamana laga manu khan ke bhi eneka hobo.<verse eid="MAT 12:45"/></para>
  <para style="s">Jisu Laga Ama Aru Bhai Khan</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46"/>Jitia Jisu bhir khan ke kotha koi thakise, sabi, Tai laga ama aru bhai khan bahar te khara kori Jisu ke lok kori bole bisari thakise. <verse eid="MAT 12:46"/><verse number="47" style="v" sid="MAT 12:47"/>Ekjon Taike koise, “Sabi, Apuni laga ama aru bhai khan bahar te khara ase, Apuni ke kotha kori bole bisari ase.” <verse eid="MAT 12:47"/><verse number="48" style="v" sid="MAT 12:48"/>Kintu jun manu taike khobor disele Jisu taike koise, “Kun Moi laga ama ase aru kun Moi laga bhai khan ase?” <verse eid="MAT 12:48"/><verse number="49" style="v" sid="MAT 12:49"/>Titia chela khan phale Tai laga anguli ishara kori kene Jisu koise, “Sabi, eitu khan Ami laga ama aru bhai khan ase! <verse eid="MAT 12:49"/><verse number="50" style="v" sid="MAT 12:50"/>Kilekoile jun manu Moi laga sorgote thaka Baba laga itcha kore, etu he Moi laga bhai, aru Moi laga bhoini, aru Moi laga ama ase.”<verse eid="MAT 12:50"/></para>
  <chapter eid="MAT 12"/>
  <chapter number="13" style="c" sid="MAT 13"/>
  <para style="s">Bijon Laga Dristanto</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1"/>Utu dinte Jisu ghor pora ulaikena nodi kinar te bohi thakise. <verse eid="MAT 13:1"/><verse number="2" style="v" sid="MAT 13:2"/>Dangor bhir joma hoi kene Tai usorte bohi jaise, etu nimite Tai naw uporte uthise, aru sob manu nodi kinar te khara korise. <verse eid="MAT 13:2"/><verse number="3" style="v" sid="MAT 13:3"/>Etu pichete Jisu taikhan ke dristanto khan bisi koise. Tai koise, “Sabi, ekjon kheti kora manu dhaan bijon hali bole jaise. <verse eid="MAT 13:3"/><verse number="4" style="v" sid="MAT 13:4"/>Jitia tai kheti te bijon phelai thakise, kunba bijon rasta kinar te girise, aru chiriya khan ahikena sob khai dise. <verse eid="MAT 13:4"/><verse number="5" style="v" sid="MAT 13:5"/>Kunba bijon to bisi pathor thaka jagate girise, aru joldi uthijaise, kele koile mati olop thakise. <verse eid="MAT 13:5"/><verse number="6" style="v" sid="MAT 13:6"/>Kintu jitia gham ulaise, etu ulai thaka ghas ke julai dise, kele koile etu ghas laga shikor thaka nai, etu karone sob sukhi jaise. <verse eid="MAT 13:6"/><verse number="7" style="v" sid="MAT 13:7"/>Kunba bijon khan kata ghas majot te girise. Aru etu ghas to olop dangor hoise, hoilebi kata ghas pora morai dise. <verse eid="MAT 13:7"/><verse number="8" style="v" sid="MAT 13:8"/>Kunba bijon khan bhal matite girise aru bhal ghas hoi kene bhal guti dhurise, kunba eksoh guti, kunba te saathi guti aru kunba te trista guti dhurise. <verse eid="MAT 13:8"/><verse number="9" style="v" sid="MAT 13:9"/>Jun manu laga kaan ase, taikhan ke huni bole dibi.”<verse eid="MAT 13:9"/></para>
  <para style="s">Dristanto Laga Motlob Huda</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10"/>Titia Jisu laga chela khan Tai usorte ahise aru hudise, “Apuni kele bhir khan ke dristanto pora kotha koi ase?” <verse eid="MAT 13:10"/><verse number="11" style="v" sid="MAT 13:11"/>Jisu taikhan ke koise, “Tumikhan ke sorgo rajyo laga bujhi bo napara kotha khan bujhi bole gyaan dikena ase, kintu taikhan ke diya nai. <verse eid="MAT 13:11"/><verse number="12" style="v" sid="MAT 13:12"/>Kilekoile jun manu logot olop ase, taike aru bhi dibo, aru tai logote bhorta thakibo. Kintu jun manu logote nai, tai logote ki ase etu bhi loi lobo. <verse eid="MAT 13:12"/><verse number="13" style="v" sid="MAT 13:13"/>Etu karone Moi taikhan ke dristanto pora kotha kore: Taikhan dikhi ase, kintu taikhan sabole napare; aru taikhan huni ase, kintu taikhan huni kene bhi bujhi bo napare. <verse eid="MAT 13:13"/><verse number="14" style="v" sid="MAT 13:14"/>Taikhan nimite to Isaiah laga bhabobani to purah hoise, juntu eneka koi ase,</para>
  <para style="q" vid="MAT 13:14">‘Tumikhan hosa pora bhi hunibo, kintu janibole na paribo;</para>
  <para style="q" vid="MAT 13:14">Tumikhan hosa pora bhi dikhibo, kintu bujhi bole na paribo<note caller="+" style="f"><char style="fr" closed="false">13.14 </char><char style="ft" closed="false">Isa. 6: 9-10.</char></note>.<verse eid="MAT 13:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="MAT 13:15"/>Kilekoile etu manu khan laga mon to khali hoise,</para>
  <para style="q" vid="MAT 13:15">Aru taikhan huni bole tan kori loise,</para>
  <para style="q" vid="MAT 13:15">Aru taikhan laga suku bondh kori loise,</para>
  <para style="q" vid="MAT 13:15">Eneka korile taikhan suku pora nasabo nimite,</para>
  <para style="q" vid="MAT 13:15">Nohoile taikhan kaan pora nahunibo nimite,</para>
  <para style="q" vid="MAT 13:15">Nohoile taikhan laga mon pora nabujibo nimite,</para>
  <para style="q" vid="MAT 13:15">Kilekoile eneka kori kene taikhan aru bhi mon naghurabo nimite,</para>
  <para style="q" vid="MAT 13:15">Aru Moi taikhan ke bhal kori nadibo nimite.’<verse eid="MAT 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16"/>Kintu asis te ase tumikhan laga suku, kele koile taikhan dikhi ase; aru tumikhan laga kaan, kele koile taikhan huni ase. <verse eid="MAT 13:16"/><verse number="17" style="v" sid="MAT 13:17"/>Moi hosa pora koi ase tumikhan ke bisi bhabobadi aru pobitro manu khan to tumikhan ki dikhi ase, eitu khan sabole mon thakise, hoilebi taikhan dikhibole panai. Tumikhan ki kotha huni ase, taikhan bhi huni bole mon thakise, kintu taikhan huni bole panai.<verse eid="MAT 13:17"/></para>
  <para style="s">Bijon Laga Motlob Bujhai Diya</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18"/>Etu nimite kheti kora manu bijon phela laga dristanto etu laga ki motlob ase huni bhi aru bujhibi. <verse eid="MAT 13:18"/><verse number="19" style="v" sid="MAT 13:19"/>Jitia kunba manu rajyo laga kotha hune kintu bujhi bole napare, tinehoile biya Jon<note caller="+" style="f"><char style="fr" closed="false">13.19 </char><char style="ft" closed="false">Biya Jon to Mark 4:15.</char></note> ahe aru ki tai laga monte bijon hali kene ase etu chingi kene loijai. Etu bijon to rasta kinar te phelai diya bijon ase. <verse eid="MAT 13:19"/><verse number="20" style="v" sid="MAT 13:20"/>Juntu bijon pathor uporte phelaise, etu to eneka manu ase jun kotha huni loi aru loge-loge khushi pora grohon kore, <verse eid="MAT 13:20"/><verse number="21" style="v" sid="MAT 13:21"/>kintu kotha khan tai laga mon bhitor te najai, etu nimite khali olop somoi nimite he rakhe. Jitia etu kotha nimite biya aru dukh-digdar pa-a somoi ahe, tai ekbar te he giri jai. <verse eid="MAT 13:21"/><verse number="22" style="v" sid="MAT 13:22"/>Juntu bijon kata ghas khan majote phelaise, etu to eneka manu ase jun kotha to hune, hoilebi etu jamana laga kaam aru dhun sompoti ke mon diya nimite kotha ke dabai kene rakhe, aru etu kotha pora bhal guti nadhure. <verse eid="MAT 13:22"/><verse number="23" style="v" sid="MAT 13:23"/>Juntu bijon bhal matite phelaise, etu to eneka manu ase jun kotha to hune aru bujhi loi. Tai dangor koi kene bhal guti dhure, kunba te eksoh guti dhore, kunba te sathi aru kunba te trista.”<verse eid="MAT 13:23"/></para>
  <para style="s">Aru Bijon Dusra Laga Dristanto</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24"/>Jisu taikhan ke dusra dristanto koise. Tai koise, “Sorgo laga rajyo to ekjon manu nisena ase jun tai laga kheti te bhal bijon phelai. <verse eid="MAT 13:24"/><verse number="25" style="v" sid="MAT 13:25"/>Kintu jitia manu khan ghumai jai, tai laga dushman khan ahikena gehu laga kheti te biya ghas laga bijon khan phelai aru jai-jai. <verse eid="MAT 13:25"/><verse number="26" style="v" sid="MAT 13:26"/>Jitia kheti te gehu khan dangor koi kene guti ulabole shuru hoise, titia biya ghas khan bhi dangor hoijai. <verse eid="MAT 13:26"/><verse number="27" style="v" sid="MAT 13:27"/>Etu mati malik laga nokorkhan ahi kene taike koi, ‘Sahab, apuni to bhal bijon kheti te lagase nohoi? Nohoile kineka kori kene etu biya ghas khan ulaise?’ <verse eid="MAT 13:27"/><verse number="28" style="v" sid="MAT 13:28"/>Etu pichete tai pora taikhan ke koise, ‘Dushman pora eneka kore.’ Nokorkhan taike koise, ‘To apuni itcha ase koile amikhan jai kene jongol khan sapha kori dibo?’ <verse eid="MAT 13:28"/><verse number="29" style="v" sid="MAT 13:29"/>Mati malik pora taikhan ke koi, ‘Nai. Kilekoile jitia tumikhan biya ghas khan tanibo, tai logote gehu laga ghas bhi tani kene ulai dibo pare. <verse eid="MAT 13:29"/><verse number="30" style="v" sid="MAT 13:30"/>Etu nimite duijon ke bhi eke logote dangor koribo dibi, kheti kata somoi naha tak. Jitia kheti kata somoi hobo titia moi kata manu khan ke kobo, “Poila biya ghas khan tani kene ulai lobi aru eke logote bandhi kene rakhibi julai dibo nimite, kintu gehu khan ke dhaan ghor te joma kori rakhibi.’”<verse eid="MAT 13:30"/></para>
  <para style="s">Sorso Bijon Aru Khomir</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31"/>Etu pichete Jisu aru ekta dristanto taikhan ke koise. Tai koise, “Sorgo laga rajyo to ekta sorso laga bijon nisena ase jineka ekta manu pora loi kene kheti te phelai de. <verse eid="MAT 13:31"/><verse number="32" style="v" sid="MAT 13:32"/>Etu bijon to hosa pora bhi sobse huru ase sob bijon majote. Kintu jitia tai dangor hoi, bagan laga ghas khan pora bhi tai he dangor hoijai. Tai ekta dangor ghas hoijai, aru akas laga chiriya khan ahe aru etu ghas laga daal khan te ghor bonaikena thake.” <verse eid="MAT 13:32"/><verse number="33" style="v" sid="MAT 13:33"/>Jisu taikhan ke aru alag dristanto koise. “Sorgo laga rajyo to khomir nisena ase, jineka ekta maiki pora etu khomir ke loi kene tin bhag atta te milai diye jitia tak etu atta to phuli najai.”<verse eid="MAT 13:33"/></para>
  <para style="s">Aru Dristanto Pora Kotha Kora</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34"/>Eitu khan sob kotha Jisu pora manu khan ke dristanto pora he koi dise; aru Tai ekta kotha bhi dristanto nacholai kene kowa nai. <verse eid="MAT 13:34"/><verse number="35" style="v" sid="MAT 13:35"/>Eitu khan sob age te bhabobadi pora koi diya kotha khan sob purah hobole nimite, Tai koi dise,</para>
  <para style="q" vid="MAT 13:35">“Dristanto khan pora he Moi mukh khuli bo.</para>
  <para style="q" vid="MAT 13:35">Ki kotha etu prithibi laga bhetimul te lukaikene ase eitu khan sob Moi koi dibo.<note caller="+" style="f"><char style="fr" closed="false">13.35 </char><char style="ft" closed="false">Psa. 78:2.</char></note>”<verse eid="MAT 13:35"/></para>
  <para style="s">Dusra Bijon Dristanto Laga Motlob Bujhai Diya</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36"/>Etu pichete Jisu manu khan ke chari kene ghor te jaise. Tai laga chela khan Tai logote ahikena, eneka koise, “Amikhan ke kheti te biya ghas laga dristanto to bujhai dibi.” <verse eid="MAT 13:36"/><verse number="37" style="v" sid="MAT 13:37"/>Jisu taikhan ke koise, “Jun bhal bijon to phelai, tai to Manu laga Putro ase. <verse eid="MAT 13:37"/><verse number="38" style="v" sid="MAT 13:38"/>Prithibi to kheti ase; aru bhal bijon khan to rajyo lage bacha khan ase. Biya ghas to biya jon laga bacha khan ase, <verse eid="MAT 13:38"/><verse number="39" style="v" sid="MAT 13:39"/>aru jun dushman pora biya hissi se eitu khan saitan ase. Kheti kata somoi to yug khotom huwa somoi ase, aru kheti kata manu khan to sorgodoth khan ase. <verse eid="MAT 13:39"/><verse number="40" style="v" sid="MAT 13:40"/>Etu karone, jineka biya ghas khan ke joma kori kene jui te julai dise, yug ses huwa dinte bhi eneka hobo. <verse eid="MAT 13:40"/><verse number="41" style="v" sid="MAT 13:41"/>Manu laga Putro pora Tai laga sorgodoth khan ke pathabo, aru taikhan pora Tai laga rajyo pora paap aru biya kaam kora khan ke joma kori kene bahar te ulai dibo. <verse eid="MAT 13:41"/><verse number="42" style="v" sid="MAT 13:42"/>Taikhan pora eitu khan sobke jui laga chulah te phelai dibo, juntu jagate kandi thaka aru daat kamuri thaka he hobo. <verse eid="MAT 13:42"/><verse number="43" style="v" sid="MAT 13:43"/>Etu pichete dharmik manu khan Baba laga rajyote suryo nisena ujala hobo. Jun laga kan ase, tai hunibo dibi.<verse eid="MAT 13:43"/></para>
  <para style="s">Lukai Rakha Sompoti Laga Dristanto</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44"/>Sorgo laga rajyo to ekta kheti te khajana lukaikene thaka nisena ase, jitia ekjon manu pora etu pai, tai etu ke aru bhi lukai diye. Kilekoile tai mon khushi hoijai, aru tai laga dhun sompoti sob bikiri kori kene etu kheti kini loi.<verse eid="MAT 13:44"/></para>
  <para style="s">Bisi Kimti Moti Laga Dristanto</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45"/>Aru, sorgo laga rajyo to ekjon vyapari manu kimti laga moti khan bisari thaka nisena ase. <verse eid="MAT 13:45"/><verse number="46" style="v" sid="MAT 13:46"/>Jitia tai bisi kimti thaka ekta moti pai, tai laga sob dhun sompoti bikiri kori kene etu kini loi.<verse eid="MAT 13:46"/></para>
  <para style="s">Jal Laga Dristanto</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47"/>Aru bhi, sorgo laga rajyo to samundar te jaal phela nisena ase, aru sob kisim laga maas dhura nisena ase. <verse eid="MAT 13:47"/><verse number="48" style="v" sid="MAT 13:48"/>Jitia jal to maas pora bhorta hoi jaise, taikhan etu loi kene samundar kinar te rakhe. Etu pichete taikhan bhal maas basi kene boxsa te joma kore, aru kaam nathaka maas khan sob phelai diye. <verse eid="MAT 13:48"/><verse number="49" style="v" sid="MAT 13:49"/>Thik eneka, etu yug ses huwa dinte bhi eneka hobo. Sorgodoth khan ahibo aru biya manu khan ke dhormik khan pora alag kori dibo. <verse eid="MAT 13:49"/><verse number="50" style="v" sid="MAT 13:50"/>Taikhan ke jui laga chulah te julai dibo, juntu jagate khali kandi thaka aru daat kamuri thaka he hobo.<verse eid="MAT 13:50"/></para>
  <para style="s">Notun Aru Purana Sampoti</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51"/>Apnikhan eitu khan sob bujise na nai?” Jisu laga chela khan Taike koise, “Hoi.” <verse eid="MAT 13:51"/><verse number="52" style="v" sid="MAT 13:52"/>Etu pichete Jisu taikhan ke koise, “Etu karone sob niyom likha manu khan jun sorgo rajyo laga chela hoi jaise, eitu khan utu manu ase jun ekta ghor laga malik nisena ase.”<verse eid="MAT 13:52"/></para>
  <para style="s">Nazareth Te Jisu Ke Birodh Kora</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53"/>Etu pichete jitia Jisu etu dristanto khan koi kene khotom hoise, Tai ta te pora ulai jaise.<verse eid="MAT 13:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 13:54"/>Aru Tai nijor town Nazareth te jaise aru mondoli te manu khan ke sikhai thakise. Jisu laga kotha huni kene taikhan asurit hoi jaise aru taikhan majote koi thakise, “Kot pora etu manu iman asurit gyaan aru hokti paise? <verse eid="MAT 13:54"/><verse number="55" style="v" sid="MAT 13:55"/>Etu manu to ekjon barhoi laga chokra nohoi? Tai laga ama to Mary nohoi? Tai laga bhai khan James, Joseph, Simon aru Judas khan nohoi? <verse eid="MAT 13:55"/><verse number="56" style="v" sid="MAT 13:56"/>Tai laga bhoini khan to amikhan logote ase nohoi? To kineka kori kene Tai eitu khan jani paise?” <verse eid="MAT 13:56"/><verse number="57" style="v" sid="MAT 13:57"/>Taikhan Jisu ke biya paise. Kintu Jisu taikhan ke koise, “Ekjon bhabobadi ke tai nijor desh aru tai nijor parivar pora bhi sonman nakore.” <verse eid="MAT 13:57"/><verse number="58" style="v" sid="MAT 13:58"/>Tai asurit kaam khan bisi kora nai kele koile taikhan laga biswas nathaka nimite.<verse eid="MAT 13:58"/></para>
  <chapter eid="MAT 13"/>
  <chapter number="14" style="c" sid="MAT 14"/>
  <para style="s">Baptizma Diya John Mora</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1"/>Utu din khan te, raja Herod Jisu laga khobor huni bole paise. <verse eid="MAT 14:1"/><verse number="2" style="v" sid="MAT 14:2"/>Tai laga daruga khan ke koise, “Etu Baptizma diya John ase; tai mora pora jinda hoise. Etu karone etu hokti khan tai logote kaam kori ase.” <verse eid="MAT 14:2"/><verse number="3" style="v" sid="MAT 14:3"/>Kilekoile Herod to John ke dhurikena thakise, taike bandi se aru bondhi ghor te Herodias, tai laga bhai Philip laga maiki pora kowa nimite rakhise. <verse eid="MAT 14:3"/><verse number="4" style="v" sid="MAT 14:4"/>Kilekoile John pora taike koise, “Apuni etu maiki ke lobole niyom hisab te nai.” <verse eid="MAT 14:4"/><verse number="5" style="v" sid="MAT 14:5"/>Herod to John ke morai dibole mon thakise, kintu tai manu khan ke bhoi lagi thakise, kele koile manu khan pora John to ekjon bhabobadi ase koi kene mani thakise. <verse eid="MAT 14:5"/><verse number="6" style="v" sid="MAT 14:6"/>Kintu jitia Herod raja laga jonom din ahisele, Herodias laga chukri sob manu majote nach kori kene Herod raja ke khushi kori dise. <verse eid="MAT 14:6"/><verse number="7" style="v" sid="MAT 14:7"/>Etu dikhi kene, Herod raja kosom khaise tai ki mangibo etu sob taike dibo. <verse eid="MAT 14:7"/><verse number="8" style="v" sid="MAT 14:8"/>Herodias pora tai laga chukri ke age pora ki mangibo etu sob sikhai dise, etu chukri Herod ke koise, “Moike ekta thali te Baptizma diya John laga matha dibi.” <verse eid="MAT 14:8"/><verse number="9" style="v" sid="MAT 14:9"/>Herod etu huni kene bisi mon dukh hoise, kintu tai sob manu age te kosom kha nimite, tai ki mangise etu taike di dibole hukum di dise. <verse eid="MAT 14:9"/><verse number="10" style="v" sid="MAT 14:10"/>Herod pora manu ke pathaise aru John laga matha kati dise. <verse eid="MAT 14:10"/><verse number="11" style="v" sid="MAT 14:11"/>Aru John laga matha thali te rakhi kene etu chukri ke dise kun jai kene tai laga ama ke dise. <verse eid="MAT 14:11"/><verse number="12" style="v" sid="MAT 14:12"/>Etu pichete John laga chela khan ahi kene tai laga gaw loi jaise aru mati bhitor te hali dise. Aru taikhan jai kene ki hoise etu sob Jisu ke koi dise.<verse eid="MAT 14:12"/></para>
  <para style="s">Jisu Pora Pans Hajar Ke Kha Luwa Diya</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13"/>Jitia Jisu etu khobor hunise, tai utu jaga pora ulaikena naw te kunbi nathaka jagate Tai ekla jai jaise. Jitia manu khan etu huni paise, taikhan laga sheher chari kene theng pora Jisu laga piche kori jaise. <verse eid="MAT 14:13"/><verse number="14" style="v" sid="MAT 14:14"/>Aru Jisu manu laga dangor bhir thaka dikhise. Taikhan ke bisi morom lagise aru bemar khan ke bhal korise. <verse eid="MAT 14:14"/><verse number="15" style="v" sid="MAT 14:15"/>Jitia saam hobole shuru hoise, Tai laga chela khan Taike koi, “Etu jagate kunbi nathake aru eku bhi napai, aru ene bhi deri hoise. Manu khan ke jabole dibi, titia taikhan nijor bosti te jai kene kha luwa khabole kini lobo.” <verse eid="MAT 14:15"/><verse number="16" style="v" sid="MAT 14:16"/>Kintu Jisu taikhan ke koise, “Taikhan najaile bhi hobo. Taikhan ke kiba khabole dibi.” <verse eid="MAT 14:16"/><verse number="17" style="v" sid="MAT 14:17"/>Tai laga chela khan Taike koise, “Amikhan logote eku bhi nai, khali pansta roti aru duita maas he ase.” <verse eid="MAT 14:17"/><verse number="18" style="v" sid="MAT 14:18"/>Jisu koise, “Eitu khan loi kene anibi.” <verse eid="MAT 14:18"/><verse number="19" style="v" sid="MAT 14:19"/>Etu pichete Jisu manu khan ke olop ghas thaka jagate bohi bole koise. Tai etu pansta roti aru duita maas loise, aru sorgo phale saikene, asirbad dise aru etu roti bhangai kene Tai laga chela khan ke dise, aru taikhan pora sob manu khan ke bhag kori dise. <verse eid="MAT 14:19"/><verse number="20" style="v" sid="MAT 14:20"/>Aru sob pet bhorta khaise. Pichete chela khan jai kene bachi kene thaka roti baroh ta tukri te joma korise. <verse eid="MAT 14:20"/><verse number="21" style="v" sid="MAT 14:21"/>Ta te 5,000 manu nisena mota manu khan khaise, bacha aru maiki khan ke chari kene.<verse eid="MAT 14:21"/></para>
  <para style="s">Jisu Pani Uporte Bera</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22"/>Aru etu huwa loge-loge, Tai laga chela khan ke naw bhitor te bohibo dise aru taikhan ke nodi laga dusra phale pathai dise. Aru Jisu to taikhan logot najai kene manu khan ke nijor ghor te jai jabole koise. <verse eid="MAT 14:22"/><verse number="23" style="v" sid="MAT 14:23"/>Jitia Tai sob manu khan ke pathai dise, Tai ekla pahar uporte jaise aru prathana korise. Tai saam tak etu jagate ekla thakise. <verse eid="MAT 14:23"/><verse number="24" style="v" sid="MAT 14:24"/>Kintu utu somoite hawa bisi mara nimite naw to nodi laga majote punchi jaise, kele koile etu hawa to ulta phale mari thakise. <verse eid="MAT 14:24"/><verse number="25" style="v" sid="MAT 14:25"/>Ekdum phojurte Jisu nodi uporte berai kene taikhan logote ahise. <verse eid="MAT 14:25"/><verse number="26" style="v" sid="MAT 14:26"/>Kitia Tai laga chela khan Taike pani uporte bera dikhise, taikhan bisi bhoi khai kene koise, “Etu ekjon bhoot ase,” aru bisi bhoi pora hala korise. <verse eid="MAT 14:26"/><verse number="27" style="v" sid="MAT 14:27"/>Kintu Jisu taikhan ke koise, “Mon dangor koribi, etu Moi ase! Bhoi na koribi.” <verse eid="MAT 14:27"/><verse number="28" style="v" sid="MAT 14:28"/>Peter pora Jisu ke jowab dise aru koise, “Probhu, jodi etu Apuni ase, titia amike pani upor pora Apuni logot ahibole hukum dibi.” <verse eid="MAT 14:28"/><verse number="29" style="v" sid="MAT 14:29"/>Jisu koise, “Ahibi.” Titia Peter naw pora uthise aru Jisu usorte pani uporte berai kene jaise. <verse eid="MAT 14:29"/><verse number="30" style="v" sid="MAT 14:30"/>Kintu jitia Peter pora dangor hawa mara dikhise, tai bhoi khai jaise. Jitia tai dubi bole shuru hoise, tai hala kori kene koise, “Probhu, amike bacha bhi!” <verse eid="MAT 14:30"/><verse number="31" style="v" sid="MAT 14:31"/>Loge-loge te Jisu Tai laga hath sida korise, aru Peter ke dhuri loise, aru taike koise, “Tumi komti biswas manu, tumi kele chinta korise?” <verse eid="MAT 14:31"/><verse number="32" style="v" sid="MAT 14:32"/>Etu pichete Jisu aru Peter naw bhitor te jaise, aru hawa mara to rukhi jaise. <verse eid="MAT 14:32"/><verse number="33" style="v" sid="MAT 14:33"/>Etu pichete naw bhitor te chela khan Jisu ke aradhana korise, eneka koi kene, “Hosa pora bhi Apuni to Isor laga Putro ase.”<verse eid="MAT 14:33"/></para>
  <para style="s">Jisu Pora Gennesaret Te Bemar Manu Changai Kora</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34"/>Jitia taikhan nodi paar kori loise, taikhan Gennesaret town koi kene ekta jagate ahise. <verse eid="MAT 14:34"/><verse number="35" style="v" sid="MAT 14:35"/>Jitia ta te laga manu khan Jisu ke chini loise, taikhan usorte thaka sob manu khan ke khobor kori dise, aru sob bemar manu khan ke Jisu logot loi anise. <verse eid="MAT 14:35"/><verse number="36" style="v" sid="MAT 14:36"/>Taikhan Jisu laga kapra chubo nimite bhik mangi kene Taike hudise, aru jiman manu Taike chuise, taikhan sob bhal hoi jaise.<verse eid="MAT 14:36"/></para>
  <chapter eid="MAT 14"/>
  <chapter number="15" style="c" sid="MAT 15"/>
  <para style="s">Purana Niom Aru Hukum</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1"/>Etu pichete Pharisee aru niyom likha manu khan Jerusalem pora Jisu usorte ahise. Taikhan koise, <verse eid="MAT 15:1"/><verse number="2" style="v" sid="MAT 15:2"/>“Kile Apuni laga chela khan bura khan banai diya niyom khan bhangai thake? Kile taikhan hath nadholai kene roti khai.” <verse eid="MAT 15:2"/><verse number="3" style="v" sid="MAT 15:3"/>Jisu taikhan ke jowab dikene koise, “Tinehoile kele tumikhan bhi nijor laga niyom nimite Isor laga niyom khan bhangai? <verse eid="MAT 15:3"/><verse number="4" style="v" sid="MAT 15:4"/>Kilekoile Isor pora hukum dise, eneka koise, ‘Nijor laga baba aru ama ke sonman dibi,’ aru ‘Jun tai nijor baba aru ama laga biya kotha koi, tai hosa pora bhi moribo.’ <verse eid="MAT 15:4"/><verse number="5" style="v" sid="MAT 15:5"/>Kintu tumikhan koi, ‘Jun khan nijor baba nohoile bhi ama ke koi, “Ki modot apnikhan moi pora pabole ase eitu khan etiya pora Isor ke daan dibo,’” <verse eid="MAT 15:5"/><verse number="6" style="v" sid="MAT 15:6"/>utu manu to tai laga baba ke sonman nadile bhi hobo. Eneka kori kene tumikhan Isor laga kotha ke hisab nathaka kori dise, tumikhan laga niyom manibo nimite. <verse eid="MAT 15:6"/><verse number="7" style="v" sid="MAT 15:7"/>Dhungi khan! Isaiah pora thik koise, jitia tumikhan nimite tai bhabobani korise<note caller="+" style="f"><char style="fr" closed="false">15.7 </char><char style="ft" closed="false">Isa. 29:13.</char></note>,<verse eid="MAT 15:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="MAT 15:8"/>‘Etu manu khan Moike mukh pora he sonman kore,</para>
  <para style="q" vid="MAT 15:8">Kintu taikhan laga mon to Moi pora bisi dur te ase.<verse eid="MAT 15:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="MAT 15:9"/>Taikhan Moike aradhana kora to misa-misi ase,</para>
  <para style="q" vid="MAT 15:9">Kile mane manu pora bana niyom khan taikhan nijor laga niyom nisena sikhai thake.’”<verse eid="MAT 15:9"/></para>
  <para style="s">Ki Pora Manu Ekjon Letera Kore</para>
  <para style="m">
    <verse number="10" style="v" sid="MAT 15:10"/>Etu pichete Jisu pora joma hoi kene thaka manu khan ke mati kene koise, “Huni bhi aru bujhi bhi- <verse eid="MAT 15:10"/><verse number="11" style="v" sid="MAT 15:11"/>Ki saman manu laga mukh te ghuse etu pora manu ke letera nakore. Kintu, ki to mukh pora bahar te ulai, etu pora he manu ke letera kori diye.” <verse eid="MAT 15:11"/><verse number="12" style="v" sid="MAT 15:12"/>Etu pichete chela khan ahi kene Jisu ke koise, “Apuni jane na nai etu Pharisee khan jitia Apuni laga kotha hunise, taikhan khushi panai koi kene?” <verse eid="MAT 15:12"/><verse number="13" style="v" sid="MAT 15:13"/>Jisu pora taikhan ke koise, “Sob ghas juntu sorgote thaka Ami laga Baba pora rupa nai, eitu khan sobke mati bhitor pora tani kene phelai dibo.” <verse eid="MAT 15:13"/><verse number="14" style="v" sid="MAT 15:14"/>Taikhan ke ekla chari bhi, taikhan nijor andha koi kene andha manu ke rasta dikhai ase. Jitia ekta andha manu pora dusra andha manu ke rasta dikhai, tai duijon bhi nala te giri bo.” <verse eid="MAT 15:14"/><verse number="15" style="v" sid="MAT 15:15"/>Peter jowab dikene Jisu ke koise, “Etu dristanto laga motlob to bujhai dibi.” <verse eid="MAT 15:15"/><verse number="16" style="v" sid="MAT 15:16"/>Jisu koise, “Tumi etiya tak nabuji kene ase? <verse eid="MAT 15:16"/><verse number="17" style="v" sid="MAT 15:17"/>Tumi najane, ki jinis mukh bhitor pora ghusi kene pet te jai, etu he pichete latrine kori kene bahar ulai koi kene? <verse eid="MAT 15:17"/><verse number="18" style="v" sid="MAT 15:18"/>Kintu ji kotha khan mukh pora ulai eitu khan mon pora ulai. Eitu khan pora he manu ke letera kore. <verse eid="MAT 15:18"/><verse number="19" style="v" sid="MAT 15:19"/>Kilekoile mon pora he biya bhabona, manu morai diya, bebichari, chor kora, misa gawahi, aru hinsa kora eitu khan ulai. <verse eid="MAT 15:19"/><verse number="20" style="v" sid="MAT 15:20"/>Eitu khan pora he manu khan ke letera kore. Kintu hath nadholai kene kha pora manu ke letera nakore.”<verse eid="MAT 15:20"/></para>
  <para style="s">Canaan Laga Mahila Ekjon Laga Biswas</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21"/>Etu pichete Jisu ta te pora ulai jaise, aru Tyre aru Sidon sheher phale jaise. <verse eid="MAT 15:21"/><verse number="22" style="v" sid="MAT 15:22"/>Sabi, ta te ekjon Canaan laga mahila utu jaga pora ulaikene ahise. Tai hala kori kene koise, “Moi uporte daya koribi, Probhu, David laga Putro! Moi laga chukri gaw bhitor te bisi biya bhoot pora bandhi kene ase.” <verse eid="MAT 15:22"/><verse number="23" style="v" sid="MAT 15:23"/>Kintu Jisu taike ekta jowab bhi diya nai. Tai laga chela khan ahi kene Taike anurodh koise, “Etu mahila ke khedai dibi, kele koile tai amikhan phale hala kori ase.” <verse eid="MAT 15:23"/><verse number="24" style="v" sid="MAT 15:24"/>Kintu Jisu jowab dikene koise, “Kunba nimite moike patha nohoi, kintu Israel laga ghor laga harai ja mer khan nimite ase.” <verse eid="MAT 15:24"/><verse number="25" style="v" sid="MAT 15:25"/>Kintu etu mahila ahise aru athukari kene Tai age te matha niche kori kene koise, “Probhu, amike modot koribi.” <verse eid="MAT 15:25"/><verse number="26" style="v" sid="MAT 15:26"/>Tai jowab dikene koise, “Bacha khan laga roti loi kene kutta khan ke phelai kene diya to thik nohoi.” <verse eid="MAT 15:26"/><verse number="27" style="v" sid="MAT 15:27"/>Tai koise, “Hoi, Probhu, kintu kutta bacha khan bhi tai malik laga thali pora tukra gira khan khai.” <verse eid="MAT 15:27"/><verse number="28" style="v" sid="MAT 15:28"/>Etu pichete Jisu etu mahila ke koise, “Maiki, tumi laga biswas to bisi dangor ase; tumi laga ki khushi ase thik eneka he hobo dibi.” Aru tai laga chukri utu somoite bhal hoi jaise.<verse eid="MAT 15:28"/></para>
  <para style="s">Jisu Pora Bemar Manu khan Ke Changai Kora</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29"/>Jisu utu jaga ke chari kene Galilee Nodi usorte jaise. Etu pichete Tai pahar uporte jaise aru ta te bohise. <verse eid="MAT 15:29"/><verse number="30" style="v" sid="MAT 15:30"/>Bisi manu joma koi kene Tai usorte ahise. Taikhan logote lengra, andha, juthor rugi bemar thaka, aru gunga khan, aru kisim bemar thaka manu khan ke loi kene ahise. Taikhan Jisu laga theng usorte anise aru Jisu pora taikhan ke bhal kori dise. <verse eid="MAT 15:30"/><verse number="31" style="v" sid="MAT 15:31"/>Titia manu khan sob asurit hoise jitia taikhan kotha koribo napara khan kotha korise, lengera khan beraise, aru andha khan dikhi bole paise. Taikhan sob Israel laga Isor ke mohima dise.<verse eid="MAT 15:31"/></para>
  <para style="s">Jisu Pora Char Hajar Ke Kha Luwa Diya</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32"/>Tai laga chela khan ke mati kene Jisu koise, “Etu manu khan nimite moi laga monte morom ase, kele koile taikhan tin din pora moi logote thakise aru taikhan ke khila bole eku bhi nai. Moi taikhan ke nakhilai kene pathai dibole mon nai, nohoile matha ghuri kene giri jabo pare.” <verse eid="MAT 15:32"/><verse number="33" style="v" sid="MAT 15:33"/>Tai laga chela khan Taike koise, “Etu nisena khali jagate kote pora amikhan iman bisi roti bisari kene manu khan ke khila bo?” <verse eid="MAT 15:33"/><verse number="34" style="v" sid="MAT 15:34"/>Jisu taikhan ke koise, “Tumikhan logote kiman roti ase?” Taikhan koise, “Sat-ta, aru chutu maas khan olop ase.” <verse eid="MAT 15:34"/><verse number="35" style="v" sid="MAT 15:35"/>Etu pichete Jisu manu khan ke matite bohibi koise. <verse eid="MAT 15:35"/><verse number="36" style="v" sid="MAT 15:36"/>Tai sat-ta roti aru maas ke loise, aru dhanyavad diya pichete, roti bhangai kene chela khan ke dise. Aru chela khan pora manu khan ke bhag kori dise. <verse eid="MAT 15:36"/><verse number="37" style="v" sid="MAT 15:37"/>Sob khaise aru pet bhorta hoise. Aru taikhan bacha roti sob joma korise aru sat-ta tukri bhorta hoise. <verse eid="MAT 15:37"/><verse number="38" style="v" sid="MAT 15:38"/>Sob milaikena char hajar mota khan thakise, maiki aru bacha khan ke chari kene. <verse eid="MAT 15:38"/><verse number="39" style="v" sid="MAT 15:39"/>Etu pichete sobke nijor ghor te pathai dise aru Jisu ekta naw te uthi kene Magadan te jaise.<verse eid="MAT 15:39"/></para>
  <chapter eid="MAT 15"/>
  <chapter number="16" style="c" sid="MAT 16"/>
  <para style="s">Pharisee Aru Sadducee Khan Pora Chihna Mangise</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1"/>Etu pichete, kunba Pharisee aru Sadducee khan ahi kene Jisu ke porikha koribo nimite Taike akas pora kiba ekta asurit kaam kori kene taikhan ke dikhai dibi koise. <verse eid="MAT 16:1"/><verse number="2" style="v" sid="MAT 16:2"/>Kintu Jisu taikhan ke jowab dise, aru koise, “Jitia saam hoi, tumikhan koi, din to bhal hobo, kele koile akas to lal ase. <verse eid="MAT 16:2"/><verse number="3" style="v" sid="MAT 16:3"/>Aru phojurte, aji din biya hobole ase, kele koile akas to lal ase aru niche hoi ase. Tumikhan akas te saikene din kobo pare, kintu tumikhan bhal biya din laga somoi saikene kobo napare? <verse eid="MAT 16:3"/><verse number="4" style="v" sid="MAT 16:4"/>“Biya aru biswas nathaka yug laga manu khan he chihna khan sabole bisare, kintu chihna khan dikhai nadibo khali Jonah laga chihna he pabo.” Etu pichete Jisu ta te pora ulai jai.<verse eid="MAT 16:4"/></para>
  <para style="s">Pharisee Aru Sadducee Laga Khomir</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5"/>Jitia chela khan nodi paar kori kene dusra phale punchi jaise, taikhan roti lobole pahorise. <verse eid="MAT 16:5"/><verse number="6" style="v" sid="MAT 16:6"/>Jisu taikhan ke koise, “Sai thakibi aru Pharisee aru Sadducee khan laga khomir pora hoshiar hoi jabi.” <verse eid="MAT 16:6"/><verse number="7" style="v" sid="MAT 16:7"/>Titia chela khan nijor majote kotha kori thakise, eneka koi kene, “Etu eneka hoise kele koile amikhan roti lobole pahorise.” <verse eid="MAT 16:7"/><verse number="8" style="v" sid="MAT 16:8"/>Jisu taikhan laga bhabona jani thakise aru koise, “Tumi biswas komti thaka khan, kele tumikhan nijor majote roti pahora nimite ase koi kene kotha kori ase? <verse eid="MAT 16:8"/><verse number="9" style="v" sid="MAT 16:9"/>Tumikhan etiya bhi buja nai nohoile bhi yaad nai kineka Moi pansta roti 5,000 manu nimite dise, aru kiman ta tukri bachi kene joma korise? <verse eid="MAT 16:9"/><verse number="10" style="v" sid="MAT 16:10"/>Nohoile bhi sat-ta roti 4,000 manu nimite dise, aru kiman ta tukri bachi kene joma korise? <verse eid="MAT 16:10"/><verse number="11" style="v" sid="MAT 16:11"/>Kineka kori kene tumikhan buja nai Moi roti laga kotha kowa nohoi koi kene? Pharisee aru Sadducee laga khomir pora hoshiar thakibi.” <verse eid="MAT 16:11"/><verse number="12" style="v" sid="MAT 16:12"/>Etu pichete taikhan bujhi jaise Jisu to roti te khomir thaka pora hoshiar hoija bhi kowa nohoi, kintu Pharisee aru Sadducee khan laga kotha sikhai diya pora hoshiar thakibi koi thakisele.<verse eid="MAT 16:12"/></para>
  <para style="s">Peter Pora Jisu Ke Khrista Shikar Kora</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13"/>Etu pichete jitia Jisu Caesarea Philippi town usorte ahise, Jisu Tai laga chela khan ke hudise, “Manu khan pora Manu laga Putro ke kun koi kene mate?” <verse eid="MAT 16:13"/><verse number="14" style="v" sid="MAT 16:14"/>Taikhan koise, “Kunba koi John Baptizma diya jon, kunba, Elijah, aru kunba Jeremiah, aru ekjon bhabobadi.” <verse eid="MAT 16:14"/><verse number="15" style="v" sid="MAT 16:15"/>Jisu taikhan ke koise, “Kintu tumikhan Moi kun ase koi kene bhabe?” <verse eid="MAT 16:15"/><verse number="16" style="v" sid="MAT 16:16"/>Simon Peter pora jowab dikene koise, “Apuni to Khrista ase, jinda Isor laga Putro.” <verse eid="MAT 16:16"/><verse number="17" style="v" sid="MAT 16:17"/>Jisu taike jowab dikene koise, “Tumi asis paise, Simon Bar Jonah, kele koile manu pora tumike dikhai diya nohoi, kintu Moi laga Baba jun sorgote ase Tai pora he dikhai dise. <verse eid="MAT 16:17"/><verse number="18" style="v" sid="MAT 16:18"/>Moi etu bhi tumike koi ase, tumi Peter ase, aru etu pathor uporte Moi laga girja bonabo. Aru Hades laga hokti pora etu girja ke eku koribo na paribo. <verse eid="MAT 16:18"/><verse number="19" style="v" sid="MAT 16:19"/>Moi tumike sorgo rajyo laga chabi khan dibo. Tumi junke prithibi te bandhi bo, sorgote bhi etu bandhi bo, aru juntu prithibi te chari bo, sorgote bhi etu chari dibo.” <verse eid="MAT 16:19"/><verse number="20" style="v" sid="MAT 16:20"/>Etu pichete Tai chela khan ke hukum dise kunke bhi Tai to Khrista ase nokobi koi kene.<verse eid="MAT 16:20"/></para>
  <para style="s">Jisu He Nijor Mori bole Aru Punoruthan Laga Kotha Kowa</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21"/>Utu somoi pora loi kene, Jisu Tai laga chela khan ke Tai Jerusalem te jabo lagibo, aru ta te bura manu khan, aru mukhyo purohit khan aru niyom likha khan pora Taike bisi dukh dibo aru morai dibo, aru tin din pichete mora pora jee uthibo laga kotha khan koi diya shuru hoise. <verse eid="MAT 16:21"/><verse number="22" style="v" sid="MAT 16:22"/>Etu pichete Peter pora Jisu ke kinar te loi jaise aru gali dibole shuru hoise, eneka koi kene, “Eitu khan Apuni pora dur hobo dibi, Probhu; eitu khan Apuni ke hobole nadibi.” <verse eid="MAT 16:22"/><verse number="23" style="v" sid="MAT 16:23"/>Kintu Jisu ghuri kene Peter ke koise, “Moi laga pichete jabi, Saitan! Tumi Ami laga rasta bondh kori ase, kele koile tumi Isor laga kaam nimite hisab nakore, kintu manu khan laga kaam ke hisab kore.”<verse eid="MAT 16:23"/></para>
  <para style="s">Nijor Cross uthaikene Jisu Pichete Jabi</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24"/>Etu pichete Jisu tai laga chela khan ke koise, “Jun Ami laga piche koribo mon ase, tai nijorke chari bo lagibo, nijor laga Cross lobi, aru Moi laga piche koribi. <verse eid="MAT 16:24"/><verse number="25" style="v" sid="MAT 16:25"/>Kilekoile jun manu tai nijor jibon to bacha bole kore tai harai dibo, aru jun manu Ami nimite nijor jibon to harai dibo tai pabo. <verse eid="MAT 16:25"/><verse number="26" style="v" sid="MAT 16:26"/>Kilekoile ekjon manu laga ki labh ase jitia tai sob duniya to pai jai, kintu nijor jibon to harai diye? Ekjon manu jibon pabo nimite tai ki daam dibo paribo? <verse eid="MAT 16:26"/><verse number="27" style="v" sid="MAT 16:27"/>Kilekoile Manu laga Putro to Tai laga Baba laga mohima pora sorgodoth khan logote wapas ahibo. Etu pichete Tai sob manu ke taikhan laga kaam hisab te inam dibo. <verse eid="MAT 16:27"/><verse number="28" style="v" sid="MAT 16:28"/>Moi hosa pora apnikhan ke koise, tumikhan majote kunba yate khara ase jun namora age te Manu laga Putro ke Tai laga rajyo loi kene akas te ahi thaka dikhibo.”<verse eid="MAT 16:28"/></para>
  <chapter eid="MAT 16"/>
  <chapter number="17" style="c" sid="MAT 17"/>
  <para style="s">Chehera Aru Kapra Bodli Huwa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1"/>Choi din pichete Jisu tai logote Peter, James aru tai laga bhai John ke loise, aru taikhan nijor pora ekta untcha pahar uporte jaise. <verse eid="MAT 17:1"/><verse number="2" style="v" sid="MAT 17:2"/>Aru Jisu nijorke taikhan age te alag ekjon kori kene dikhaise. Tai laga chehera suryo nisena ujala dikhaise, aru Tai laga kapra khan puhor nisena boga hoi jaise. <verse eid="MAT 17:2"/><verse number="3" style="v" sid="MAT 17:3"/>Sabi, ta te taikhan logote Moses aru Elijah ulaikene Jisu logote kotha kori thakise. <verse eid="MAT 17:3"/><verse number="4" style="v" sid="MAT 17:4"/>Peter jowab dikene Jisu ke koise, “Probhu, amikhan yate thaka to bhal ase naki. Apuni itcha ase koile, Moi etu jagate aram kori bole chaat bonabo- ekta Apuni nimite, aru ekta Moses nimite, aru ekta Elijah nimite.” <verse eid="MAT 17:4"/><verse number="5" style="v" sid="MAT 17:5"/>Jitia tai kotha kori thakise, sabi, ekta ujala badal taikhan ke bondh kori dise, aru etu badal pora ekta awaj ulaikena eneka koise, “Etu Moi laga bisi morom Putro ase, jun uporte moi bisi khushi ase. Tai laga kotha huni bhi.” <verse eid="MAT 17:5"/><verse number="6" style="v" sid="MAT 17:6"/>Jitia tinjon chela khan etu hunise, taikhan bisi bhoi kori kene matite girise aru nijor chehera mati phale saise. <verse eid="MAT 17:6"/><verse number="7" style="v" sid="MAT 17:7"/>Etu pichete Jisu ahise aru taikhan ke chui kene koise, “Uthibi aru bhoi na koribi.” <verse eid="MAT 17:7"/><verse number="8" style="v" sid="MAT 17:8"/>Etu pichete taikhan suku uthaikene saise, kintu taikhan khali Jisu he nohoile dusra kunke bhi dikha nai.<verse eid="MAT 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9"/>Taikhan jitia pahar upor pora nami ahi thakise, Jisu taikhan ke hukum dise, eneka koi kene, “Etu laga sapna kunke bhi nakobi jitia tak Manu laga Putro mora pora arubi jinda nohoi jai.” <verse eid="MAT 17:9"/><verse number="10" style="v" sid="MAT 17:10"/>Tai laga chela khan Taike eneka koi kene hudise, “Tenehoile kele kunba niyom likha manu khan Elijah he poila ahibo lage koi?” <verse eid="MAT 17:10"/><verse number="11" style="v" sid="MAT 17:11"/>Jisu taikhan ke jowab dikene koise, “Elijah hosa pora bhi ahibo aru sob to thik kori dibo. <verse eid="MAT 17:11"/><verse number="12" style="v" sid="MAT 17:12"/>Kintu Moi tumikhan ke koi ase, Elijah to poila pora ahi jaise, kintu taikhan taike chini bole para nai. Ulta, tai uporte ki kori bole itcha thakise taikhan etu kori dise. Thik eneka he, Manu Laga Putro bhi taikhan laga hathte bisi dukh pabo.” <verse eid="MAT 17:12"/><verse number="13" style="v" sid="MAT 17:13"/>Titia he chela khan bujise Tai John Baptizma laga kotha taikhan ke kori thakise koi kene.<verse eid="MAT 17:13"/></para>
  <para style="s">Jisu Pora Biya Atma Thaka Putro Ke Bhal kora</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14"/>Jitia taikhan manu joma hoi thaka jagate ahise, ekjon manu Tai usorte ahise, Tai age te athukari se, <verse eid="MAT 17:14"/><verse number="15" style="v" sid="MAT 17:15"/>aru koise, “Probhu, moi laga chokra uporte daya koribi, kele koile tai pagla hoi kene ase, aru bisi dukh pai ase. Kilekoile tai khali jui uporte giri thake, aru khali panite ghusi thake. <verse eid="MAT 17:15"/><verse number="16" style="v" sid="MAT 17:16"/>Moi taike Apuni laga chela khan usorte ani sele, kintu taikhan bhal kori bole para nai.” <verse eid="MAT 17:16"/><verse number="17" style="v" sid="MAT 17:17"/>Jisu jowab dikene koise, “Biswas nathaka aru biya jamana laga manu khan, aru kiman deri nimite Moi tumikhan logote thakibo lagibo? Kiman deri tumikhan ke dhorjo koribo? Taike Moi laga samne te anibi.” <verse eid="MAT 17:17"/><verse number="18" style="v" sid="MAT 17:18"/>Jisu pora bhoot atma ke khedai dise, aru etu atma tai laga gaw pora ulai jaise, aru utu somoite etu chokra to bhal hoi jaise.<verse eid="MAT 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19"/>Etu pichete Jisu laga chela khan lukai kene Taike koise, “Kile amikhan bhoot ke kheda bole para nai?” <verse eid="MAT 17:19"/><verse number="20" style="v" sid="MAT 17:20"/>Jisu taikhan ke koise, “Kile mane tumikhan laga biswas komti thaka nimite. Moi hosa pora tumikhan ke koi ase, jodi tumikhan sorso dana nisena hoilebi biswas thakile, tumikhan etu pahar ke kobo, ‘Yate pora hati kene ta te jabi,’ aru etu hati jabo, aru tumikhan nimite eku bhi napara kaam nohobo. <verse eid="MAT 17:20"/><verse number="21" style="v" sid="MAT 17:21"/>Kintu eitu khan sob to, prathana aru upwas pora nohoile dusra eku pora na paribo.”<verse eid="MAT 17:21"/></para>
  <para style="s">Jisu Tai Nijor Mori bole aru Punoruthan Laga Kotha Kowa</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22"/>Jitia taikhan Galilee te thakise, Jisu Tai laga chela khan ke koise, “Manu laga Putro ke manu khan laga hath di dibo, <verse eid="MAT 17:22"/><verse number="23" style="v" sid="MAT 17:23"/>aru taikhan pora Taike morai dibo, aru tin dinte Taike mora pora uthai dibo.” Etu huni kene chela khan bisi mon dukh hoise.<verse eid="MAT 17:23"/></para>
  <para style="s">Mondoli Laga Khajana</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24"/>Jitia taikhan Capernaum jagate punchise, ekjon manu jun dui taka chandi poisa utha manu Peter usorte ahise aru koise, “Apnikhan laga Shika manu to dui taka chandi poisa<note caller="+" style="f"><char style="fr" closed="false">17.24 </char><char style="ft" closed="false">Mondoli karone kar luwa.</char></note> to diye na nai?” <verse eid="MAT 17:24"/><verse number="25" style="v" sid="MAT 17:25"/>Tai koise, “Hoi.” Jitia Peter ghor te ghusi loise, Jisu taike poila kotha korise, eneka koi kene, “Tumi ki bhabe, Simon? Kun logot pora prithibi laga raja khan poisa uthai? Taikhan laga bacha khan pora na dusra khan pora?<note caller="+" style="f"><char style="fr" closed="false">17.25 </char><char style="ft" closed="false">Utu somoikhante rajakhan jiti kene loi ana manu khan ke kar loi thakise.</char></note>” <verse eid="MAT 17:25"/><verse number="26" style="v" sid="MAT 17:26"/>Jitia tai koise, “Dusra khan pora,” Jisu taike koise, “Tinehoile bacha khan nimite ene to eku daam nai.” <verse eid="MAT 17:26"/><verse number="27" style="v" sid="MAT 17:27"/>Kintu amikhan nimite poisa utha manu ke paap koribo nadibo, etu nimite nodi te jabi, ekta maas dhura kata phelabi aru juntu maas ke poila pai etu ke loi kene anibi. Jitia tumi maas laga mukh khuli loi, ta te charta chandi pabo. Lobi aru jai kene poisa utha manu ke tumi aru Ami nimite bhi dibi.”<verse eid="MAT 17:27"/></para>
  <chapter eid="MAT 17"/>
  <chapter number="18" style="c" sid="MAT 18"/>
  <para style="s">Sob Pora Dangor</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1"/>Utu somoite Jisu laga chela khan Tai usorte ahise aru koise, “Tinehoile kun sorgo laga rajyote sobse dangor ase?” <verse eid="MAT 18:1"/><verse number="2" style="v" sid="MAT 18:2"/>Jisu pora Tai usorte ekta bacha ke mati kene taikhan majote bohise, <verse eid="MAT 18:2"/><verse number="3" style="v" sid="MAT 18:3"/>aru koise, “Moi hosa pora tumikhan ke koi ase, jitia tak apuni chutu bacha khan nisena nohoi, tumikhan ekjon bhi sorgo laga rajyote ghusi bole na paribo. <verse eid="MAT 18:3"/><verse number="4" style="v" sid="MAT 18:4"/>Etu karone, jun manu nijorke ekta bacha nisena chutu koribo, tai he sorgo laga rajyote sobse dangor ase. <verse eid="MAT 18:4"/><verse number="5" style="v" sid="MAT 18:5"/>Jun manu chutu bacha khan ke etu nisena Moi laga naam te ahibole diye tai Moike pai jai. <verse eid="MAT 18:5"/><verse number="6" style="v" sid="MAT 18:6"/>Kintu jodi etu bacha khan majote ekjon bhi Moike biswas kore, aru kunba manu utu bacha ke paap kaam kori bole diye koile, utu manu nimite dangor pathor tai laga gola te bandhi kene nodi te dubi le he bhal hobo.<verse eid="MAT 18:6"/></para>
  <para style="s">Paap Laga Porikha</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7"/>Etu prithibi laga manu khan ke bisi morom lage, juntu kaam khan nimite taikhan paap kori ase. Eitu khan sob purah hobo lage, kintu utu manu khan uporte aru dangor sajai hobo jun etu paap kaam hobole di ase. <verse eid="MAT 18:7"/><verse number="8" style="v" sid="MAT 18:8"/>Jodi tumi laga hath nohoile theng nimite tumike girai de koile, etu ke kati dibi aru tumi laga gaw pora phelai dibi. Tumi nimite duita hath aru theng thaki kene norokte ja pora to gaw te hath nohoile theng nathaki kene sorgote ja to he bhal hobo. <verse eid="MAT 18:8"/><verse number="9" style="v" sid="MAT 18:9"/>Jodi tumi laga suku nimite paap koribo diye koile, ulai dibi aru tumi laga gaw pora phelai dibi. Kilekoile tumi nimite duita suku thaki kene norokte ja pora to gaw te ekta suku thaki kene sorgote ja he bhal hobo.<verse eid="MAT 18:9"/></para>
  <para style="s">Harai Juwa Mer Laga Dristanto</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10"/>Hoshiar thakibi, etu chutu bacha khan eku kaam nai koi kene nabhabi bhi. Kilekoile Moi tumikhan ke koi ase, taikhan laga sorgodoth khan pora Moi laga sorgote thaka Baba laga chehera hodai sai thake. <verse eid="MAT 18:10"/><verse number="11" style="v" sid="MAT 18:11"/>Kilekoile Manu laga Putro to harai ja khan nimite ahise. <verse eid="MAT 18:11"/><verse number="12" style="v" sid="MAT 18:12"/>Tumikhan ki bhabona ase? Jodi ekjon manu logote eksoh mer khan ase, aru ekta harai jaise koile, tai ninyanve mer khan ke pahar te chari kene, ekta harai ja ke bisaribo nohoi? <verse eid="MAT 18:12"/><verse number="13" style="v" sid="MAT 18:13"/>Jodi tai pai jai, Moi hosa pora koi ase, utu ninyanve mer khan pora bhi harai ja ekta pai ja-a nimite bisi khushi hobo. <verse eid="MAT 18:13"/><verse number="14" style="v" sid="MAT 18:14"/>Thik etu nisena, Sorgote thaka Baba laga itcha nohoi eitu khan nisena ekjon chutu hoile bhi harai jabole.<verse eid="MAT 18:14"/></para>
  <para style="s">Jodi Bhai-Kokai Pora Birodh Paap Kore</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15"/>Jodi tumi laga bhai pora tumi uporte paap korise koile, jabi aru tai laga golti koi dibi, tai aru tumi ekla duijon majote. Jodi tai tumi laga kotha hune koile, tumi laga bhai ke jiti loise<note caller="+" style="f"><char style="fr" closed="false">18.15 </char><char style="ft" closed="false">Due. 19:15.</char></note>. <verse eid="MAT 18:15"/><verse number="16" style="v" sid="MAT 18:16"/>Kintu jodi tai tumi laga kotha nahune koile, ekjon duijon ke tumi logote loijabi, eneka hoile duijon tinjon manu pora ki hoise, eitu khan taikhan laga mukh pora jani jabo. <verse eid="MAT 18:16"/><verse number="17" style="v" sid="MAT 18:17"/>Aru jodi taikhan laga kotha khan bhi nahune koile, girja ke etu laga kotha to koi dibi. Jodi tai girja laga bhi kotha nahune koile, taike ekjon Porjati aru poisa utha manu nisena chari di bhi. <verse eid="MAT 18:17"/><verse number="18" style="v" sid="MAT 18:18"/>Moi hosa pora koi ase tumikhan ke, ki jinis khan prithibi te bandibo etu sorgote bhi hobo; aru ji jinis khan prithibi te chari bo etu sorgote bhi hobo. <verse eid="MAT 18:18"/><verse number="19" style="v" sid="MAT 18:19"/>Aru bhi Moi hosa pora tumikhan ke koise, jodi duijon majote mon mili kene ki karone hoile bhi mangise koile, taikhan nimite Moi laga Baba jun sorgote ase eitu khan kori dibo. <verse eid="MAT 18:19"/><verse number="20" style="v" sid="MAT 18:20"/>Kilekoile juntu jagate duijon tinjon Moi naam te joma kore, taikhan majote Moi ase.”<verse eid="MAT 18:20"/></para>
  <para style="s">Khyama Nadiya Nokor Laga Dristanto</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21"/>Etu pichete Peter ahise aru Jisu ke koise, “Probhu, kiman bar moi laga bhai ami uporte paap kaam koribo aru taike maph dibo? Sat bar tak?” <verse eid="MAT 18:21"/><verse number="22" style="v" sid="MAT 18:22"/>Jisu taike koise, “Moi tumike sat bar tak koribo kowa nai, kintu sattar laga sat bar tak. <verse eid="MAT 18:22"/><verse number="23" style="v" sid="MAT 18:23"/>Etu karone sorgo laga rajyo to ekjon raja nisena jun tai laga kaam kora manu logote hisab-kitab kori bole itcha kori loise. <verse eid="MAT 18:23"/><verse number="24" style="v" sid="MAT 18:24"/>Jitia tai hisab-kitab kori bole shuru hoise, tai usorte ekjon nokor ke loi anise, jun tai logot pora dos hajar talent pabo thakise.<note caller="+" style="f"><char style="fr" closed="false">18.24 </char><char style="ft" closed="false">Purab desh khan te dos hazar toka to he sob pora dangor poisa ginti thakise.</char></note> <verse eid="MAT 18:24"/><verse number="25" style="v" sid="MAT 18:25"/>Kintu tai logote eku pora bhi baki tirabole thaka nai, etu pora malik pora tai aru tai laga maiki bacha khan aru taikhan logot ki thakise etu sob bikiri koridi kene dhar tirabole hukum dise. <verse eid="MAT 18:25"/><verse number="26" style="v" sid="MAT 18:26"/>Etu huni kene nokor matite girise aru malik age te athukari kene mangise, ‘Malik, amike olop somoi dibi, aru ami apuni ke sob tirai dibo.’ <verse eid="MAT 18:26"/><verse number="27" style="v" sid="MAT 18:27"/>Aru malik tai laga kotha huni kene morom lagi jaise, aru tai laga dhar maph kori dise aru taike chari dise. <verse eid="MAT 18:27"/><verse number="28" style="v" sid="MAT 18:28"/>Kintu, jitia etu nokor bahar te ulaise, tai logote ek sou denarii<note caller="+" style="f"><char style="fr" closed="false">18.28 </char><char style="ft" closed="false">Ek dinari toh hajara kora manu laga ek din laga hisab thakise.</char></note> dhaar luwa nokor ke dikhise. Tai utu nokor ke gola te jor pora dhori kene eneka koise, ‘Moi laga ki dhar ase etu tirabi.’ <verse eid="MAT 18:28"/><verse number="29" style="v" sid="MAT 18:29"/>Etu pichete utu nokor nichete girise aru taike kandi kene maph mangise, eneka koi kene, ‘Amike olop somoi dibi, aru ami apuni ke sob tirai dibo.’ <verse eid="MAT 18:29"/><verse number="30" style="v" sid="MAT 18:30"/>Kintu utu age laga nokor to eneka kori bole itcha thaka nai. Ulta, tai jaise aru bondhi ghor bhitor te hali dise, jitia tak tai laga dhar natirai. <verse eid="MAT 18:30"/><verse number="31" style="v" sid="MAT 18:31"/>Etu karone jitia dusra nokorkhan etu dikhise, taikhan bisi mon biya hoise, aru jai kene malik ke ki hoise etu sob koi dise. <verse eid="MAT 18:31"/><verse number="32" style="v" sid="MAT 18:32"/>Etu pichete etu nokor laga malik taike matise, aru koise, ‘Tumi mon kala thaka nokor, moi tumi laga dhar khan sob maph kori dise, kele koile tumi kandi kene moike maph manga nimite. <verse eid="MAT 18:32"/><verse number="33" style="v" sid="MAT 18:33"/>Tumi bhi nijor manu ke daya koribo para nai, jineka moi tumi uporte daya korise?’ <verse eid="MAT 18:33"/><verse number="34" style="v" sid="MAT 18:34"/>Aru malik gusa thakise aru taike sajai diya manu laga hathte dise, jitia tak tai baki khan natirai. <verse eid="MAT 18:34"/><verse number="35" style="v" sid="MAT 18:35"/>Etu nisena Moi laga sorgote thaka Baba bhi tumikhan ke eneka koribo, jitia tak tumikhan nijor bhai kokai khan ke maph nakoribo.”<verse eid="MAT 18:35"/></para>
  <chapter eid="MAT 18"/>
  <chapter number="19" style="c" sid="MAT 19"/>
  <para style="s">Shadi Kora Chara-Chari Laga Sikha</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1"/>Aru eneka hoise, jitia Jisu eitu khan koi kene khotom hoise, tai Galilee pora ulaise, aru Jordan nodi laga paar thaka Judah jagate ahise. <verse eid="MAT 19:1"/><verse number="2" style="v" sid="MAT 19:2"/>Aru bisi manu khan tai laga piche-piche ahise; aru Tai ta te taikhan ke changai korise.<verse eid="MAT 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3"/>Pharisee khan bhi tai usorte ahise, taike porikha kori bole lagise, aru taike koise, “Ki nimite hoile bhi ekjon manu tai laga maiki ke chari bole niyom ase na nai? <verse eid="MAT 19:3"/><verse number="4" style="v" sid="MAT 19:4"/>Aru Tai jowab te taikhan ke koise, “Tumikhan Isor kotha te purah nai, Tai jun prothom te sristi bonaise, taikhan ke mota aru mahila bonaise? <verse eid="MAT 19:4"/><verse number="5" style="v" sid="MAT 19:5"/>Aru koise, ‘etu nimite ekjon manu baba aru ama ke chari bo, aru tai laga maiki logote jabo: aru tai duijon ekta sharir hoi jabo.<note caller="+" style="f"><char style="fr" closed="false">19.5 </char><char style="ft" closed="false">Gen. 2:24.</char></note>’ <verse eid="MAT 19:5"/><verse number="6" style="v" sid="MAT 19:6"/>Eneka pora taikhan aru duita nohoi, hoile bhi ekta sharir hoijai. Etu nimite Isor ki eke logote milai dise, manu khan etu ke alag na koribi.” <verse eid="MAT 19:6"/><verse number="7" style="v" sid="MAT 19:7"/>Taikhan koise, “Tinehoile kele Moses koise chara-chari laga ekta kagos likhi bole, aru taike chari dibole?” <verse eid="MAT 19:7"/><verse number="8" style="v" sid="MAT 19:8"/>Tai taikhan ke koise, “Kilekoile tumikhan laga mon to bisi tan ase etu nimite Moses pora tumikhan laga maiki chari dibole koise: hoile bhi age te eneka thaka nai. <verse eid="MAT 19:8"/><verse number="9" style="v" sid="MAT 19:9"/>Aru Moi tumikhan ke koi ase, jun bhi tai laga maiki ke chari bo, khali bebichar kotha karone chari kene, aru dusra ke shadi koribo, tai bebichar laga kaam kore: aru jun utu pora chari diye maiki ke shadi koribo, tai bebichar laga kaam kore.” <verse eid="MAT 19:9"/><verse number="10" style="v" sid="MAT 19:10"/>Tai laga chela khan taike koise, “Ekjon manu tai laga maiki logote eneka ase koile, shadi nakora he bhal ase.” <verse eid="MAT 19:10"/><verse number="11" style="v" sid="MAT 19:11"/>Hoile bhi tai taikhan ke koise, “Sob manu khan etu kotha ke lobole na paribo, khali taikhan ke chari kene jun khan ke etu dise. <verse eid="MAT 19:11"/><verse number="12" style="v" sid="MAT 19:12"/>Kilekoile ta te kunba hijira khan asele, jun khan taikhan laga ama laga pet pora he eneka jonom hoise: aru ta te kunba hijira thakise jun khan ke manu khan pora hijira bonaise: aru ta te kunba hijira khan thakise jun khan sorgo laga desh nimite nije ke hijira bonaise. Tai jun etu ke lobole pare, taike lobole dibi.”<verse eid="MAT 19:12"/></para>
  <para style="s">Bacha khan Moi Usorte Ahibo Dibi</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13"/>Etu pichete, dusra khan pora Tai usorte chutu-chutu bacha khan ke anise, Tai laga hath taikhan uporte rakhi kene asirbad koribo nimite, kintu chela khan pora taikhan ke gali dise. <verse eid="MAT 19:13"/><verse number="14" style="v" sid="MAT 19:14"/>Hoile bhi Jisu pora baroh jonke koise, “Bacha khan ke ahibole dibi, Ami logote ahibole taikhan ke narukhabi, kele koile sorgo laga rajyo taikhan nisena pora he ase.” <verse eid="MAT 19:14"/><verse number="15" style="v" sid="MAT 19:15"/>Aru Jisu pora taikhan uporte hath rakhise aru taikhan ke asirbad dise, aru ta te pora jai jaise.<verse eid="MAT 19:15"/></para>
  <para style="s">Dhuni Jawan</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16"/>Sabi, ekjon manu Jisu usorte ahise aru hudise, “Shika manu, moi anonto jibon pabo nimite ki bhal kaam koribo lagibo?” <verse eid="MAT 19:16"/><verse number="17" style="v" sid="MAT 19:17"/>Jisu taike koise, “Tumi kele Moike bhal to ki ase koi kene hudi ase? Khali Ekjon<note caller="+" style="f"><char style="fr" closed="false">19.17 </char><char style="ft" closed="false">Isor.</char></note> he bhal ase, kintu jodi tumi sorgote ghusi bole mon ase koile, Isor laga niyom khan mani bhi.” <verse eid="MAT 19:17"/><verse number="18" style="v" sid="MAT 19:18"/>Etu manu Taike koise, “Kuntu niyom?” Jisu koise, “Morai nadibi, bebichar kaam na koribi, chor nakuribi, misa gawahi nadibi, <verse eid="MAT 19:18"/><verse number="19" style="v" sid="MAT 19:19"/>Ama aru baba ke sonman koribi, aru ghor usorte thaka manu ke morom koribi jineka nijorke kora nisena.” <verse eid="MAT 19:19"/><verse number="20" style="v" sid="MAT 19:20"/>Aru etu jawan manu pora Taike koise, “Eitu khan sob ami mani loise. Aru ami ki koribo lagi ase?” <verse eid="MAT 19:20"/><verse number="21" style="v" sid="MAT 19:21"/>Jisu taike koise, “Jodi tumi pura thik hobole itcha ase koile, jabi, tumi logote ki ase sob bikiri kori dibi aru gorib manu khan ke di dibi, aru sorgote tumi laga dhun sompoti pabo; aru ahibi, Ami laga piche koribi.” <verse eid="MAT 19:21"/><verse number="22" style="v" sid="MAT 19:22"/>Kintu jitia etu jawan Jisu ki koise huni loise, tai mon dukh hoi kene jai jaise, kele koile tai logote bisi dhun sompoti thakise.<verse eid="MAT 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23"/>Jisu tai laga chela khan ke koise, “Moi hosa pora tumikhan ke koi ase, ekjon dhuni manu nimite sorgo laga rajyote ghusi bole digdar ase. <verse eid="MAT 19:23"/><verse number="24" style="v" sid="MAT 19:24"/>Arubi Moi tumikhan ke koi ase, ekjon dhuni manu Isor laga rajyote gusa pora to ekta uth bhiji laga chenda bhitor pora paar kori kene ghusa to he asan hobo.” <verse eid="MAT 19:24"/><verse number="25" style="v" sid="MAT 19:25"/>Jitia chela khan etu hunise, taikhan bisi asurit hoise, eneka koi kene, “Tinehoile kunkhan he bachibo?” <verse eid="MAT 19:25"/><verse number="26" style="v" sid="MAT 19:26"/>Kintu Jisu taikhan ke saise aru koise, “Manu khan nimite etu napara kaam ase, kintu Isor nimite sob pare.” <verse eid="MAT 19:26"/><verse number="27" style="v" sid="MAT 19:27"/>Etu pichete Peter jowab dikene Taike koise, “Sabi, amikhan sob chari kene Apuni laga piche korise. Amikhan nimite ki thakibo?” <verse eid="MAT 19:27"/><verse number="28" style="v" sid="MAT 19:28"/>Jisu taikhan ke koise, “Moi hosa pora tumikhan ke koi ase, notun jamana te jitia Manu laga Putro pora Tai laga singhason te bohibo, tumikhan jun Ami laga piche korise, tumikhan bhi baroh ta singhason te bohibo, aru Israel desh laga baroh ta jat ke bisar koribo. <verse eid="MAT 19:28"/><verse number="29" style="v" sid="MAT 19:29"/>Sob manu jun ghor khan, nohoile bhai kokai khan, nohoile didi bhoini khan, nohoile baba, nohoile ama, nohoile bacha khan, nohoile kheti khan, Ami laga naam nimite chari diye koile, taikhan ki chari dise etu pora bhi eksoh bar bisi pabo aru namora jibon to pai lobo. <verse eid="MAT 19:29"/><verse number="30" style="v" sid="MAT 19:30"/>Kintu bisi manu jun age te ase taikhan piche hoi jabo, aru piche khan age hoi jabo.<verse eid="MAT 19:30"/></para>
  <chapter eid="MAT 19"/>
  <chapter number="20" style="c" sid="MAT 20"/>
  <para style="s">Angur Kheti Te Hajira Kora</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1"/>Sorgo rajyo to ekjon mati malik nisena ase, jun phojurte bahar ulaikene tai laga kheti nimite manu bisari bole jaise. <verse eid="MAT 20:1"/><verse number="2" style="v" sid="MAT 20:2"/>Jitia tai kaam kora manu khan logote ek dinte ek denarius<note caller="+" style="f"><char style="fr" closed="false">20.2 </char><char style="ft" closed="false">Ek dinarius to ek din hajira laga daam thakise.</char></note> pora kotha milai loi, tai kaam kora manu khan ke kheti te pathaise. <verse eid="MAT 20:2"/><verse number="3" style="v" sid="MAT 20:3"/>Aru tai nou baji nisena te bahar te jaise, aru dusra hajira kora manu khan eku kaam napai kene ene khara thaka dikhise. <verse eid="MAT 20:3"/><verse number="4" style="v" sid="MAT 20:4"/>Aru taikhan ke koise, ‘Tumikhan bhi angur bagan te jabi, aru ki thik ase ami tumikhan ke dibo.’ <verse eid="MAT 20:4"/><verse number="5" style="v" sid="MAT 20:5"/>Aru taikhan jaise. Arubi tai baroh baji nisena te bahar te jaise aru eneka he korise. <verse eid="MAT 20:5"/><verse number="6" style="v" sid="MAT 20:6"/>Aru tin baji nisena te tai bahar te jaise, aru dusra khan ke ene khara thaka dikhise, aru taikhan ke koise, ‘Tumikhan pura din kele yate ene khara ase?’ <verse eid="MAT 20:6"/><verse number="7" style="v" sid="MAT 20:7"/>Taikhan taike koise, ‘Kilekoile kun manu bhi amikhan ke hajira te luwa nai.’ Taike koise, ‘Tumikhan bhi angur bagan te jabi.’ <verse eid="MAT 20:7"/><verse number="8" style="v" sid="MAT 20:8"/>Eneka para jitia saam hoise, angur bagan laga malik pora imandar ke koise, ‘Hajira kora khan ke mati bhi, aru taikhan laga hajira dibi, pichete aha pora prothom ula tak.’ <verse eid="MAT 20:8"/><verse number="9" style="v" sid="MAT 20:9"/>Aru jitia taikhan ahise jun khan ke pans baji nisena te hajira te rakhise, taikhan ke ekta poisa dise. <verse eid="MAT 20:9"/><verse number="10" style="v" sid="MAT 20:10"/>Hoile sobse poila ahikena kaam kora khan bhabise taikhan bisi pabo; kintu taikhan bhi ek taka he paise. <verse eid="MAT 20:10"/><verse number="11" style="v" sid="MAT 20:11"/>Aru taikhan ghor laga malik ke biya paikena kiba kibi kobole lagise. <verse eid="MAT 20:11"/><verse number="12" style="v" sid="MAT 20:12"/>Koise, ‘eitu khan pichete ahikena ek-ghanta he kaam korise, hoile bhi apuni taikhan ke bhi amikhan nisena he korise, jun khan sob kaam korise aru din laga gorom loise.’ <verse eid="MAT 20:12"/><verse number="13" style="v" sid="MAT 20:13"/>Hoile bhi tai taikhan bhitor te ekjon ke jowab dise, aru koise, ‘Sathi, Ami tumikhan ke eku bhi golti kora nai: tumi ami logote ek poisa te monjur hoise nohoi? <verse eid="MAT 20:13"/><verse number="14" style="v" sid="MAT 20:14"/>Tumi laga ki ase lobi, aru nijor rasta jabi: Ami piche aha khan ke bhi iman he dibo, jiman tumikhan ke dibo. <verse eid="MAT 20:14"/><verse number="15" style="v" sid="MAT 20:15"/>Na ami laga ki ase etu pora ami khushi koribo na paribo naki? Na tumi suku juli ase, kele koile ami bhal ase?’ <verse eid="MAT 20:15"/><verse number="16" style="v" sid="MAT 20:16"/>Eneka pora piche khan poila hobo, aru poila piche hobo: kele koile bisi ke matise, hoile bhi olop ke he bisarise.”<verse eid="MAT 20:16"/></para>
  <para style="s">Jisu He Tai Mori bole Laga Tin Bar Kowa</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17"/>Aru Jisu Jerusalem te jai thaka homoi te rasta te Tai laga baroh ta chela khan ke alag pora loise aru taikhan ke koise, <verse eid="MAT 20:17"/><verse number="18" style="v" sid="MAT 20:18"/>“Sabi, Amikhan Jerusalem te jai ase: aru Manu laga Putro ke mukhyo purohit khan laga hathte aru niyom likha khan laga hathte di dibo. Aru taikhan Taike mora bole laga faisla hunai dibo, <verse eid="MAT 20:18"/><verse number="19" style="v" sid="MAT 20:19"/>aru Taike sorom dikena mora bole, aru Cross te mari dibole nimite Porjati khan laga hathte di dibo: aru tisra dinte Tai aru bhi jee uthibo.”<verse eid="MAT 20:19"/></para>
  <para style="s">Ama Laga Anurodh</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20"/>Etu pichete, Zebedee laga maiki aru tai duijon laga chokra khan Jisu usorte ahise, aru matha niche kori kene Jisu ke ekta kiba mangibole ahise. <verse eid="MAT 20:20"/><verse number="21" style="v" sid="MAT 20:21"/>Aru Tai koise, “Apuni ki mangi ase?” Tai taike koise, “Monjur hobi Apuni laga desh te ami laga etu duita chokra, ekjon Apuni laga dyna phale, aru ekjon Apuni laga baya phale bohibo dibi.” <verse eid="MAT 20:21"/><verse number="22" style="v" sid="MAT 20:22"/>Hoile bhi Jisu jowab dise aru chokra duijon ke eneka hudise, “Tumikhan nabuje tumikhan ki mangi ase. Tumikhan utu kup pora khabole paribo juntu pora Ami khabole ase, aru eneka baptizma lobole paribo jineka baptizma pora ami baptizma lobole ase?” Taikhan taike koise, “Amikhan paribo.” <verse eid="MAT 20:22"/><verse number="23" style="v" sid="MAT 20:23"/>Aru Tai taikhan ke koise, “Jineka hoile bhi tumikhan Ami laga kup pora khabole ase, aru eneka baptizma lobole ase jineka baptizma pora Ami baptizma lobole ase: hoile bhi Ami laga dyna aru baya phale bohi bole to Ami dibole laga nohoi, hoile bhi etu taikhan ke dibole ase jun khan nimite Ami laga Pormeshwar Baba pora jaga bonai kene rakhise.” <verse eid="MAT 20:23"/><verse number="24" style="v" sid="MAT 20:24"/>Aru jitia dos jon chela khan pora etu hunise, taikhan etu duita bhai uporte nije ke dangor banabole kosis kora nimite bisi biya paise. <verse eid="MAT 20:24"/><verse number="25" style="v" sid="MAT 20:25"/>Hoile bhi Jisu taikhan ke tai usorte matise, aru koise, “Tumikhan jani ase Porjati laga rajakhan taikhan uporte takot cholai thakise, aru taikhan jun khan dangor ase taikhan dusra khan uporte takot cholai thakise. <verse eid="MAT 20:25"/><verse number="26" style="v" sid="MAT 20:26"/>Hoilebi tumikhan bhitor te eneka hobole nohoi: hoilebi jun bhi tumikhan bhitor te dangor hobole mon ase, taike tumikhan laga nokor hobole dibi. <verse eid="MAT 20:26"/><verse number="27" style="v" sid="MAT 20:27"/>Aru tumikhan bhitor te jun pora sobse age hobole mon ase, taike tumikhan laga nokor hobole dibi. <verse eid="MAT 20:27"/><verse number="28" style="v" sid="MAT 20:28"/>Thik jineka Manu laga Putro sewa lobole aha nohoi, hoile bhi sewa kori bole ahise, aru bisi nimite tai laga jibon ke daan dibole ahise.”<verse eid="MAT 20:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29"/>Aru taikhan jitia Jericho sheher pora ulaise, ekta dangor bhir Tai piche korise. <verse eid="MAT 20:29"/><verse number="30" style="v" sid="MAT 20:30"/>Aru, rasta kinar te bohi kene thaka duita andha manu, jitia taikhan hunise Jisu ta te pora jai ase, hala kori bole lagise, koise, “Probhu, David laga Putro, amikhan uporte daya koribi.” <verse eid="MAT 20:30"/><verse number="31" style="v" sid="MAT 20:31"/>Aru bisi manu khan taikhan ke gali kori bole lagise chup thakibi koi kene, kintu taikhan aru bhi bisi jor pora hala kori bole lagise, koise, “Amikhan uporte morom koribi, Oh Probhu, David laga Putro.” <verse eid="MAT 20:31"/><verse number="32" style="v" sid="MAT 20:32"/>Aru Jisu thik ta te rukhise, aru taikhan ke matise, aru koise, “Tumikhan ki lagi ase juntu ami tumikhan nimite kori bole paribo?” <verse eid="MAT 20:32"/><verse number="33" style="v" sid="MAT 20:33"/>Taikhan Taike koise, “Probhu, amikhan laga suku khuli dibi.” <verse eid="MAT 20:33"/><verse number="34" style="v" sid="MAT 20:34"/>Etu nimite Jisu taikhan uporte morom lagise, aru taikhan laga sukukhan chuise: aru ekbar te taikhan laga suku pora dikhi bole paise, aru taikhan Tai laga piche korise.<verse eid="MAT 20:34"/></para>
  <chapter eid="MAT 20"/>
  <chapter number="21" style="c" sid="MAT 21"/>
  <para style="s">Jitikena Juwa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1"/>Jitia Jisu aru tai laga chela khan Jerusalem te punchise aru Bethphage te ahise, Oliv Pahar te, titia Jisu duita chela ke pathaise, <verse eid="MAT 21:1"/><verse number="2" style="v" sid="MAT 21:2"/>taikhan ke eneka koi kene, “Tumikhan laga usorte thaka bosti te jabi, aru tumikhan loge-loge ekta gadha aru tai laga puwali ke bandi kene thaka dikhibo. Taikhan ke khuli kene Ami logote anibi. <verse eid="MAT 21:2"/><verse number="3" style="v" sid="MAT 21:3"/>Jodi kunba manu etu nimite kiba hudise koile, eneka koi dibi, ‘Probhu pora lagi ase,’ aru utu manu pora apnikhan ke eku bhi nakobo.” <verse eid="MAT 21:3"/><verse number="4" style="v" sid="MAT 21:4"/>Aru juntu kotha bhabobadi khan pora Isor kotha koi disele, eitu khan purah hoise. Tai eneka koise,<verse eid="MAT 21:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="MAT 21:5"/>“Zion laga chukri khan ke koi dibi,</para>
  <para style="q" vid="MAT 21:5">‘Sabi, tumi laga Raja tumi logote ahi ase,</para>
  <para style="q" vid="MAT 21:5">Nomro hoi kene gadha uporte-</para>
  <para style="q" vid="MAT 21:5">Ekta jawan gadha laga puwali uporte<note caller="+" style="f"><char style="fr" closed="false">21.5 </char><char style="ft" closed="false">Zech. 9:9.</char></note>.”’<verse eid="MAT 21:5"/></para>
  <para style="m">
    <verse number="6" style="v" sid="MAT 21:6"/>Etu pichete chela khan jaise aru jineka Jisu pora koise, thik eneka he korise. <verse eid="MAT 21:6"/><verse number="7" style="v" sid="MAT 21:7"/>Taikhan gadha aru tai laga puwali ke loi kene anise aru taikhan laga uporte chador urai dise, aru Jisu taikhan uporte bohise. <verse eid="MAT 21:7"/><verse number="8" style="v" sid="MAT 21:8"/>Jerusalem te jai thaka somoite, bisi manu khan nijor laga bahar kapra bichai dise, aru kunba khan to ghas laga pata kati kene rasta pura te bichai dise.<note caller="+" style="f"><char style="fr" closed="false">21.8 </char><char style="ft" closed="false">Jisu ke sonman diya thakise.</char></note> <verse eid="MAT 21:8"/><verse number="9" style="v" sid="MAT 21:9"/>Etu pichete Jisu laga age te aru pichete jai thaka manu khan hala korise, eneka koi kene,</para>
  <para style="q" vid="MAT 21:9">“Hosanna David laga Putro ke!</para>
  <para style="q" vid="MAT 21:9">Asis te ase jun Probhu laga naam loi kene ahi ase!</para>
  <para style="q" vid="MAT 21:9">Hosanna sob pora uporte!<note caller="+" style="f"><char style="fr" closed="false">21.9 </char><char style="ft" closed="false">Ps. 118:26.</char></note>”<verse eid="MAT 21:9"/></para>
  <para style="m">
    <verse number="10" style="v" sid="MAT 21:10"/>Jitia Jisu Jerusalem te ahise, pura sheher Taike dikhi kene asurit hoise aru taikhan majote eneka koise, “Etu kun ase?” <verse eid="MAT 21:10"/><verse number="11" style="v" sid="MAT 21:11"/>Aru manu khan jowab dise, “Etu Jisu ase Galilee laga Nazareth te thaka ekjon bhabobadi.”<verse eid="MAT 21:11"/></para>
  <para style="s">Jisu Pora Mondir Sapha Kora</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12"/>Etu pichete Jisu Jerusalem laga mondoli te jaise. Tai ta te saman bikiri kora aru kini thaka khan sobke khedai dise, aru poisa bodli kora khan laga mez ulta kori dise aru chiriya bikiri kora manu khan ke bahar te khedai dise. <verse eid="MAT 21:12"/><verse number="13" style="v" sid="MAT 21:13"/>Jisu taikhan ke koise, “Isor kotha te eneka likhi kene ase, ‘Moi laga ghor to Prathana laga ghor koi kene matibo,’ kintu tumikhan etu ke chor laga ghor bonai dise.” <verse eid="MAT 21:13"/><verse number="14" style="v" sid="MAT 21:14"/>Etu pichete suku andha aru theng lengra khan Jisu logote girja te jaise, aru Tai taikhan ke bhal kori dise. <verse eid="MAT 21:14"/><verse number="15" style="v" sid="MAT 21:15"/>Kintu jitia mukhyo purohit aru niyom likha manu khan Jisu laga asurit kaam khan kora, aru bacha khan mondoli bhitor te, “Hosanna David laga Putro ke,” koi kene hala kora hunise, taikhan bisi ghusa hoise. <verse eid="MAT 21:15"/><verse number="16" style="v" sid="MAT 21:16"/>Taikhan Jisu ke koise, “Taikhan ki koi ase Apuni huni ase na nai?” Jisu taikhan koise, “Hoi! Kintu tumikhan kitia bhi Isor kotha te purah nai naki, ‘Chutu bacha khan laga mukh pora prosansa kori bole Apuni sikhai dise’?” <verse eid="MAT 21:16"/><verse number="17" style="v" sid="MAT 21:17"/>Etu pichete Jisu taikhan ke chari kene Bethany nogor te jaise aru etu rati ta te ghumai se.<verse eid="MAT 21:17"/></para>
  <para style="s">Jisu Dimoru Gash Ke Shrap Diya</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18"/>Phojurte jitia Jisu Jerusalem sheher te wapas jaise, Tai bhuk lagi jaise. <verse eid="MAT 21:18"/><verse number="19" style="v" sid="MAT 21:19"/>Rasta kinar te ekta dimoru ghas dikhise, Tai ghas usorte jaise aru khali pata khan he dikhise. Tai etu ghas ke koise, “Aji pora tumi laga ghas te kitia bhi phol nadhuribi,” aru loge-loge etu ghas sukhi jaise. <verse eid="MAT 21:19"/><verse number="20" style="v" sid="MAT 21:20"/>Jitia Tai laga chela khan etu dikhise, taikhan asurit lagi kene taikhan majote hudi thakise, “Kineka kori kene etu ghas phat sukhi jaise?” <verse eid="MAT 21:20"/><verse number="21" style="v" sid="MAT 21:21"/>Jisu taikhan ke jowab dikene koise, “Moi hosa pora koi ase, jodi tumikhan duita mon nohoi kene biswas thakile, khali etu ghas ke kora nisena he nohoi kintu tumikhan ekta pahar ke bhi kobole paribo, ‘Uthi bhi aru samundar te ghusi bhi, aru eneka he hobo. <verse eid="MAT 21:21"/><verse number="22" style="v" sid="MAT 21:22"/>Jodi tumi biswas kore, tumi prathana te ki mangibo etu pai jabo.”<verse eid="MAT 21:22"/></para>
  <para style="s">Jisu Laga Adhikar Huda</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23"/>Jitia Jisu girja ghor te ahi kene sikhai thakise, mukhyo purohit aru girja laga bura manu khan Tai usorte ahise, eneka koi kene, “Ki hisab pora apuni eneka kori ase, aru kun pora apuni ke adhikar dise?” <verse eid="MAT 21:23"/><verse number="24" style="v" sid="MAT 21:24"/>Jisu taikhan ke jowab dikene koise, “Moi bhi tumikhan ke ekta kotha hudibo. Jodi tumikhan etu laga jowab dise koile, Ami bhi tumikhan laga jowab dibo. <verse eid="MAT 21:24"/><verse number="25" style="v" sid="MAT 21:25"/>John pora manu khan ke baptizma diya to kun laga adhikar pora dise? Sorgo pora na manu khan pora?” Taikhan nijor majote eneka kotha koise, “Jodi amikhan ‘Sorgo pora’ koile, Tai amikhan ke kobo, ‘To kele tumikhan taike biswas kora nai?’ <verse eid="MAT 21:25"/><verse number="26" style="v" sid="MAT 21:26"/>Kintu jodi amikhan ‘manu khan pora’ koise koile, etu manu khan pora amikhan ke biya pabo, kele koile taikhan sob John ke ekjon bhabobadi ase koi kene mane.” <verse eid="MAT 21:26"/><verse number="27" style="v" sid="MAT 21:27"/>Etu pichete taikhan Jisu ke jowab dikene koise, “Amikhan najane.” Jisu bhi taikhan ke koise, “Ami bhi tumikhan ke Ami kun laga adhikar pora kori ase etu nakobo.<verse eid="MAT 21:27"/></para>
  <para style="s">Duijon Putro Laga Dristanto</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28"/>Kintu tumikhan ki bhabe? Ekjon manu laga duita chokra thakise. Tai poila dangor chokra ke koise, ‘Putro, aji jai kene angur laga kheti te kaam koribi.’ <verse eid="MAT 21:28"/><verse number="29" style="v" sid="MAT 21:29"/>Tai laga chokra pora jowab dikene koise, ‘Moi nakoribo,’ kintu olop somoi pichete tai jai kene kaam korise. <verse eid="MAT 21:29"/><verse number="30" style="v" sid="MAT 21:30"/>Etu pichete tai laga dusra chokra ke bhi tineka koise. Kintu tai jowab dikene koise, ‘Moi jabo, malik,’ kintu tai janai. <verse eid="MAT 21:30"/><verse number="31" style="v" sid="MAT 21:31"/>Duijon chokra majote kun pora baba laga itcha korise?” Taikhan koise, “Poila chokra pora.” Jisu taikhan ke koise, “Hosa pora Moi koi ase, tumikhan pora bhi poisa utha manu aru bebichari kora khan he poila Isor laga rajyote ghusi bo. <verse eid="MAT 21:31"/><verse number="32" style="v" sid="MAT 21:32"/>Kele koile John to tumikhan logote dharmikta pora ahise, kintu tumikhan taike biswas kora nai. Kintu poisa utha manu khan aru bebichar kora khan he taike biswas korise. Kintu tumikhan, etu dikhikena bhi, tumikhan mon ghura nai aru taike biswas kora nai.<verse eid="MAT 21:32"/></para>
  <para style="s">Kisan Laga Dristanto</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33"/>Huni lobi aru dusra dristanto ke. Ta te ekjon manu thakise, ekjon mati malik. Tai angur laga kheti korise, tai bera lagai dise, aru angur ros chipai kene ulabole laga gadda khundi se, aru kheti ke sabole nimite untcha chang ghor bonaise, aru dusra manu khan angur laga kheti koribo nimite bhara dise. Etu pichete tai dusra desh te jai jaise. <verse eid="MAT 21:33"/><verse number="34" style="v" sid="MAT 21:34"/>Jitia angur kati bole somoi ahise, tai kunba nokorkhan ke pathai kene kheti kora khan ke tai laga kheti laga angur mangi bole pathai. <verse eid="MAT 21:34"/><verse number="35" style="v" sid="MAT 21:35"/>Kintu jitia utu kheti kora khan nokorkhan ke lok paise, taikhan ekjon nokor ke marise, aru ekjon ke morai dise, aru ekjon ke pathor marikena morai dise. <verse eid="MAT 21:35"/><verse number="36" style="v" sid="MAT 21:36"/>Arubi, malik pora dusra nokorkhan ke pathaise, poila patha pora bhi bisi pathai, kintu kheti kora manu khan utu nokorkhan poila te kora nisena etu nokorkhan ke bhi kore. <verse eid="MAT 21:36"/><verse number="37" style="v" sid="MAT 21:37"/>Etu pichete, utu malik tai nijor laga chokra ke pathai, eneka koi kene, ‘Taikhan Moi laga chokra ke sonman koribo.’ <verse eid="MAT 21:37"/><verse number="38" style="v" sid="MAT 21:38"/>Kintu jitia kheti kora manu khan tai laga chokra ke dikhise, kheti kora khan nijor majote koi, ‘Malik hobole thaka to etu ase. Ahibi, amikhan taike morai dibo aru tai laga sompoti laga malik hoi jabo.’ <verse eid="MAT 21:38"/><verse number="39" style="v" sid="MAT 21:39"/>Eneka hoi kene taikhan pora taike dhori loise, aru angur laga kheti te loi kene morai de. <verse eid="MAT 21:39"/><verse number="40" style="v" sid="MAT 21:40"/>Etiya, jitia utu kheti laga malik ahe, Tai pora utu kheti kora manu khan ke ki koribo?” <verse eid="MAT 21:40"/><verse number="41" style="v" sid="MAT 21:41"/>Taikhan Jisu ke koise, “Tai utu manu khan ke biya pora khotom kori dibo, aru kheti to dusra khan ke kheti kori bole di dibo, aru taikhan pora Taike kheti kata somoite taikhan laga kheti te ula bostu ani dibo.” <verse eid="MAT 21:41"/><verse number="42" style="v" sid="MAT 21:42"/>Jisu taikhan ke koise, “Tumikhan kitia bhi Isor kotha pura nai,</para>
  <para style="q" vid="MAT 21:42">‘Ekta pathor junke ghor bona manu pora phelai diye,</para>
  <para style="q" vid="MAT 21:42">Etu pathor he sob ghor laga asol pathor hoijai.</para>
  <para style="q" vid="MAT 21:42">Etu to Isor pora he ase,</para>
  <para style="q" vid="MAT 21:42">Aru etu to amikhan laga suku te ekdom bhal ase?<note caller="+" style="f"><char style="fr" closed="false">21.42 </char><char style="ft" closed="false">Ps. 118:22-23.</char></note>’<verse eid="MAT 21:42"/></para>
  <para style="m">
    <verse number="43" style="v" sid="MAT 21:43"/>Etu karone Ami tumikhan ke koi ase, tumikhan logot pora Isor laga rajyo to loijabo aru utu desh ke di dibo jun bhal phol dhure. <verse eid="MAT 21:43"/><verse number="44" style="v" sid="MAT 21:44"/>Jun khan etu pathor uporte giri bo tai bhangi kene mihin hoi jabo. Kintu jun manu uporte etu giri bo, taike chipai dibo.” <verse eid="MAT 21:44"/><verse number="45" style="v" sid="MAT 21:45"/>Jitia mukhyo purohit aru Pharisee khan Tai laga dristanto hunise, taikhan bujhi jaise Tai taikhan laga kotha kori ase koi kene. <verse eid="MAT 21:45"/><verse number="46" style="v" sid="MAT 21:46"/>Taikhan Jisu ke dhori bole bisari thakise, kintu taikhan manu khan ke bhoi khai thakise, kele koile manu khan Jisu ke ekjon bhabobadi ase koi kene mani thakise.<verse eid="MAT 21:46"/></para>
  <chapter eid="MAT 21"/>
  <chapter number="22" style="c" sid="MAT 22"/>
  <para style="s">Shadi Bhojan Laga Dristanto</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1"/>Jisu jowab dise aru taikhan ke dristanto pora kotha korise, eneka koi kene, <verse eid="MAT 22:1"/><verse number="2" style="v" sid="MAT 22:2"/>“Sorgo laga rajyo eneka ase jineka ekjon raja pora tai chokra laga shadi nimite kha luwa khan taiyar korise. <verse eid="MAT 22:2"/><verse number="3" style="v" sid="MAT 22:3"/>Raja pora nokorkhan ke pathaikena shadi te mata manu khan ke bisari bole dise, kintu kunbi ahibole mon thaka nai. <verse eid="MAT 22:3"/><verse number="4" style="v" sid="MAT 22:4"/>Aru bhi raja pora tai laga dusra nokorkhan ke eneka koi kene pathaise, ‘Jai kene shadi te mata manu khan ke kobi, “Sabi, Ami pora kha luwa bonai kene ase. Moi laga bhal guru aru mosto saguli khan ke morai dise, aru sob to taiyar hoi kene ase. Shadi laga kha luwa kori bole ahibi.’” <verse eid="MAT 22:4"/><verse number="5" style="v" sid="MAT 22:5"/>Kintu taikhan mon diya nai aru jai jaise, kunba kheti kori bole, aru kunba nijor dukan te jai jaise. <verse eid="MAT 22:5"/><verse number="6" style="v" sid="MAT 22:6"/>Aru kunba to raja laga nokorkhan ke dhori loise, aru sorom dibole laga kaam korise, aru morai dise. <verse eid="MAT 22:6"/><verse number="7" style="v" sid="MAT 22:7"/>Raja bisi khong uthise, aru tai laga sipahi khan ke pathaise aru tai laga nokor ke morai diya manu khan ke morai dise aru taikhan laga sheher ke julai dise. <verse eid="MAT 22:7"/><verse number="8" style="v" sid="MAT 22:8"/>Etu pichete tai laga nokorkhan ke koise, ‘Shadi laga kha luwa taiyar hoise, kintu jun manu khan ke matise, taikhan shadi te ahibole thik nohoi. <verse eid="MAT 22:8"/><verse number="9" style="v" sid="MAT 22:9"/>Etu nimite rasta khan te jabi aru tumikhan junke lok pai taikhan sobke shadi laga bhat khabole mati bhi.’ <verse eid="MAT 22:9"/><verse number="10" style="v" sid="MAT 22:10"/>Etu pichete raja laga nokorkhan rasta khan te jaise aru jiman bhal aru biya manu khan ke lok paise, taikhan sobke joma kori kene anise, aru shadi laga ghor te manu khan pora bhorta hoise. <verse eid="MAT 22:10"/><verse number="11" style="v" sid="MAT 22:11"/>Kintu jitia raja ahikena manu khan ke saise, tai ekjon manu ke shadi laga kapra napindi kene thaka dikhise<note caller="+" style="f"><char style="fr" closed="false">22.11 </char><char style="ft" closed="false">Utu din khan te rajakhan pora shadi te mata manu khan ke pindibole kapra bhi di thakisele.</char></note>. <verse eid="MAT 22:11"/><verse number="12" style="v" sid="MAT 22:12"/>Aru raja pora taike koise, ‘Sathi, tumi shadi laga kapra napindi kene kineka yate ahise?’ Kintu etu manu eku bhi kobole para nai. <verse eid="MAT 22:12"/><verse number="13" style="v" sid="MAT 22:13"/>Etu pichete raja pora tai laga nokorkhan ke koise, ‘Etu manu laga theng aru hath bandhi bhi, aru andhera jagate phelai dibi, juntu jagate tai khali kandi thakibo aru daat kamuri thakibo.’ <verse eid="MAT 22:13"/><verse number="14" style="v" sid="MAT 22:14"/>Bisi manu khan ke mati sele, kintu khali kunba khan ke he basi loise.”<verse eid="MAT 22:14"/></para>
  <para style="s">Caesar Ke Khajana Diya</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15"/>Etu pichete kunba Pharisee khan jaise aru Jisu ke Tai nijor laga kotha pora phasai dibole taikhan kotha kori thakise. <verse eid="MAT 22:15"/><verse number="16" style="v" sid="MAT 22:16"/>Etu pichete taikhan laga chela aru Herod laga manu khan ke milai kene Jisu logote pathaise. Taikhan koise, “Shika manu, amikhan jane Apuni to hosa ase, aru Apuni Isor laga hosa rasta pora sikhai diye. Kun laga kotha bhi apuni hisab nakore, kele koile Apuni to manu laga chehera nasai. <verse eid="MAT 22:16"/><verse number="17" style="v" sid="MAT 22:17"/>Tinehoile amikhan ke kobi, Apuni ki bhabe? Caesar<note caller="+" style="f"><char style="fr" closed="false">22.17 </char><char style="ft" closed="false">Rome laga raja laga naam.</char></note> ke poisa diya to thik niyom ase na nai?” <verse eid="MAT 22:17"/><verse number="18" style="v" sid="MAT 22:18"/>Kintu Jisu taikhan laga biya chal jani jaise aru koise, “Tumi kopoti khan kele Moike porikha kori ase? <verse eid="MAT 22:18"/><verse number="19" style="v" sid="MAT 22:19"/>Amike kar diya laga chandi poisa to dikha bhi.” Etu pichete taikhan ekta chandi poisa anikena Jisu ke dise. <verse eid="MAT 22:19"/><verse number="20" style="v" sid="MAT 22:20"/>Jisu taikhan ke dikhai kene koise, “Etu kun laga noksa aru naam ase?” <verse eid="MAT 22:20"/><verse number="21" style="v" sid="MAT 22:21"/>Taikhan Jisu ke koise, “Caesar laga.” Etu pichete Jisu taikhan ke koise, “Tinehoile ki to Caesar laga ase etu taike dibi, aru ki to Isor laga ase eitu khan Isor ke dibi.” <verse eid="MAT 22:21"/><verse number="22" style="v" sid="MAT 22:22"/>Jitia taikhan etu hunise, taikhan asurit hoise. Etu pichete taikhan Jisu ke chari kene jaise.<verse eid="MAT 22:22"/></para>
  <para style="s">Sadducee Khan Pora Punoruthan Laga Huda</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23"/>Eke dinte kunba Sadducee khan, jun khan punoruthan te biswas nakore, taikhan Jisu usorte ahise. Taikhan Jisu ke eneka hudise, <verse eid="MAT 22:23"/><verse number="24" style="v" sid="MAT 22:24"/>“Shika manu, Moses pora koise, ‘Jodi kunba manu bacha nathaki kene mori jai, tai laga bhai to tai laga maiki ke shadi koribo lage aru tai laga kokai nimite bacha jonom dibo lage.’<note caller="+" style="f"><char style="fr" closed="false">22.24 </char><char style="ft" closed="false">Due. 25:5-6.</char></note> <verse eid="MAT 22:24"/><verse number="25" style="v" sid="MAT 22:25"/>Etiya, taikhan majote satta bhai kokai khan thakise. Poila, dangor kokai shadi korise aru mori jaise. Bacha nathaka karone, etu maiki ke mora manu laga dusra bhai nimite rakhidise. <verse eid="MAT 22:25"/><verse number="26" style="v" sid="MAT 22:26"/>Etu pichete dusra bhai bhi eneka he korise, aru dusra bhai bhi, eneka kori kene pura sat-ta bhai koikai shadi korise. <verse eid="MAT 22:26"/><verse number="27" style="v" sid="MAT 22:27"/>Sob bhai kokai khan morija pichete, utu maiki bhi mori jai. <verse eid="MAT 22:27"/><verse number="28" style="v" sid="MAT 22:28"/>Etiya, mori kene jinda huwa dinte, sat-ta bhai kokai majote, tai kun laga maiki hobo? Kilekoile taikhan sob etu maiki ke shadi kori sele.” <verse eid="MAT 22:28"/><verse number="29" style="v" sid="MAT 22:29"/>Kintu Jisu taikhan ke jowab dikene koise, “Tumikhan golti ase, kelemane tumikhan shastro najane aru Isor laga hokti bhi najane. <verse eid="MAT 22:29"/><verse number="30" style="v" sid="MAT 22:30"/>Kilekoile mori kene jinda huwa manu khan shadi nakore aru shadi nimite nadiye. Hoilebi, taikhan duth khan nisena sorgote thake. <verse eid="MAT 22:30"/><verse number="31" style="v" sid="MAT 22:31"/>Kintu, mori kene jee utha laga kotha to, tumikhan Isor laga kotha koi diya te pura nai naki, eneka koi kene thaka, <verse eid="MAT 22:31"/><verse number="32" style="v" sid="MAT 22:32"/>‘Moi Abraham, Isaac, aru Jacob laga Isor ase?’ Isor to mora manu khan laga Isor nohoi, kintu jinda manu khan laga Isor ase.<note caller="+" style="f"><char style="fr" closed="false">22.32 </char><char style="ft" closed="false">Exo. 3:6.</char></note>” <verse eid="MAT 22:32"/><verse number="33" style="v" sid="MAT 22:33"/>Jitia joma hoi kene thaka manu khan Jisu laga sikhai diya kotha hunise, taikhan asurit hoise.<verse eid="MAT 22:33"/></para>
  <para style="s">Dangor Hukum</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34"/>Kintu jitia Pharisee khan Jisu pora Sadducee khan laga mukh chup kori diya hunise, taikhan eke logote mili kene joma hoise. <verse eid="MAT 22:34"/><verse number="35" style="v" sid="MAT 22:35"/>Taikhan majote, ekjon ukil, Jisu ke porikha kori bole ekta kotha hudise- <verse eid="MAT 22:35"/><verse number="36" style="v" sid="MAT 22:36"/>“Shika manu, sob niyom laga majote, kuntu niyom he sob pora dangor ase?” <verse eid="MAT 22:36"/><verse number="37" style="v" sid="MAT 22:37"/>Jisu koise, “‘Tumi laga Isor ke pura mon pora, aru pura atma, aru pura bhabona pora morom koribi<note caller="+" style="f"><char style="fr" closed="false">22.37 </char><char style="ft" closed="false">Deu. 6:5.</char></note>.’ <verse eid="MAT 22:37"/><verse number="38" style="v" sid="MAT 22:38"/>Etu he sob pora dangor aru poila niyom ase. <verse eid="MAT 22:38"/><verse number="39" style="v" sid="MAT 22:39"/>Aru dusra niyom to eneka ase- ‘Nijorke morom kora nisena tumi laga ghor usor manu khan ke bhi morom koribi.’<note caller="+" style="f"><char style="fr" closed="false">22.39 </char><char style="ft" closed="false">Lev. 19.18. </char></note> <verse eid="MAT 22:39"/><verse number="40" style="v" sid="MAT 22:40"/>Jiman niyom aru bhabobadi khan laga kotha khan ase, etu duita niyom uporte khara ase.”<verse eid="MAT 22:40"/></para>
  <para style="s">Khrista Kun Laga Putro Ase?</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41"/>Etiya, jitia Pharisee khan sob joma hoi kene thaka somoite, Jisu taikhan ke ekta kotha hudise. <verse eid="MAT 22:41"/><verse number="42" style="v" sid="MAT 22:42"/>Tai koise, “Tumikhan Khrista ke ki bhabe? Tai kun laga Putro ase?” Taikhan koise, “David laga Putro.” <verse eid="MAT 22:42"/><verse number="43" style="v" sid="MAT 22:43"/>Jisu taikhan ke koise, “Tinehoile kineka kori kene David to atma te Taike probhu koi kene mate, eneka koi kene,<verse eid="MAT 22:43"/></para>
  <para style="q">
    <verse number="44" style="v" sid="MAT 22:44"/>‘Isor pora moi laga Probhu ke koise,</para>
  <para style="q" vid="MAT 22:44">“Moi laga dyna hathte bohibi,</para>
  <para style="q" vid="MAT 22:44">Jitia tak Moi tumi laga dushman khan ke tumi laga theng nichete na ane’”<note caller="+" style="f"><char style="fr" closed="false">22.44 </char><char style="ft" closed="false">Psa. 110:1.</char></note>?<verse eid="MAT 22:44"/></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45"/>Jodi David pora Khrista ke ‘Probhu’ matise, tinehoile kineka Tai David laga chokra hobo?” <verse eid="MAT 22:45"/><verse number="46" style="v" sid="MAT 22:46"/>Kun bhi Jisu ke ekta jowab bhi dibole para nai, aru utu din pora kun bhi Taike ekta kotha bhi nahuda hoise.<verse eid="MAT 22:46"/></para>
  <chapter eid="MAT 22"/>
  <chapter number="23" style="c" sid="MAT 23"/>
  <para style="s">Pharisee Aru Purohit Khan Karone Sat-ta Hai Kotha Khan</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1"/>Etu pichete Jisu tai laga chela aru joma hoi kene thaka manu khan ke kotha korise. <verse eid="MAT 23:1"/><verse number="2" style="v" sid="MAT 23:2"/>Tai koise, “Niom likha khan aru Pharisee khan Moses boha jagate bohe. <verse eid="MAT 23:2"/><verse number="3" style="v" sid="MAT 23:3"/>Etu karone taikhan ki hukum diye tumikhan etu koribi, aru sai thakibi. Kintu taikhan laga kaam hisab te na koribi, kele koile taikhan mukh pora koi, hoile bhi kaam pora nakore. <verse eid="MAT 23:3"/><verse number="4" style="v" sid="MAT 23:4"/>Taikhan juntu saman bhari hoi eitu khan bandhi diye aru bukhi bole digdar hoijai, aru manu khan laga kandha te rakhi diye. Kintu taikhan nijor laga anguli bhi uthabole itcha nakore. <verse eid="MAT 23:4"/><verse number="5" style="v" sid="MAT 23:5"/>Taikhan dikha bole nimite he bhal niyom khan kore. Kilekoile taikhan matha te chamra laga boksa dangor bonai kene bandhe, aru taikhan kapra laga rusi khan dangor kore. <verse eid="MAT 23:5"/><verse number="6" style="v" sid="MAT 23:6"/>Taikhan bisi sonman pa-a jagate kha luwa kora khushi pai, aru mondoli te bisi sonman pa jagate bohe. <verse eid="MAT 23:6"/><verse number="7" style="v" sid="MAT 23:7"/>Aru bajar te taikhan ke ekdom salam diya aru ‘Rabbi’ koi kene manu khan pora mata khushi pai. <verse eid="MAT 23:7"/><verse number="8" style="v" sid="MAT 23:8"/>Kintu tumikhan ke ‘Rabbi<note caller="+" style="f"><char style="fr" closed="false">23.8 </char><char style="ft" closed="false">Shika manu</char></note>’ koi kene matibo dibo nalage kele koile khali ekjon he Shika manu ase, aru tumikhan sob bhai kokai ase. <verse eid="MAT 23:8"/><verse number="9" style="v" sid="MAT 23:9"/>Aru tumikhan ke ‘Baba’ koi kene matibo nadibi, kele koile tumikhan laga khali ekjon he Baba Isor ase, jun sorgote ase. <verse eid="MAT 23:9"/><verse number="10" style="v" sid="MAT 23:10"/>Tumikhan ke ‘Shika manu’ koi matibo nadibi, kele koile tumikhan laga hikhok to Khrista he ase. <verse eid="MAT 23:10"/><verse number="11" style="v" sid="MAT 23:11"/>Kintu tumikhan majote kun bisi dangor ase tai to tumi laga nokor hobo. <verse eid="MAT 23:11"/><verse number="12" style="v" sid="MAT 23:12"/>Jun khan nijorke uthai thake taike nomro kori dibo, aru jun khan nijorke nomro koribo taike uthai dibo.<verse eid="MAT 23:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13"/>Kintu, O niyom likha khan aru Pharisee khan, tumi kopoti khan ke hai ase! Tumikhan dusra manu khan nimite sorgo rajyo bondh kori diye. Kilekoile tumikhan nijor naghuse, aru ghusi bole thaka dusra khan ke bhi ghusi bole nadiye. <verse eid="MAT 23:13"/><verse number="14" style="v" sid="MAT 23:14"/>O niyom likha khan aru Pharisee khan, tumi kopoti khan ke hai ase! Kilekoile tumikhan bidhowa khan ke thogai kene taikhan laga ghor chingi loi. Etu pichete girja te jai kene manu khan ke dikha bole lamba prathana kore. Tumikhan uporte sobse biya sajai hobo. <verse eid="MAT 23:14"/><verse number="15" style="v" sid="MAT 23:15"/>O niyom likha khan aru Pharisee khan, tumi kopoti khan ke hai ase! Kilekoile tumikhan samundar pora aru dusra desh khan te jai kene tumikhan laga dhorom mani bole mon ghura bo diye, aru jitia tai tumikhan laga niyom to mani loi, tumikhan taike poila pora bhi aru bisi norok laga bacha bonai de.<verse eid="MAT 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16"/>Tumikhan ke hai ase, tumikhan andha hoi kene rasta dikhai thaka khan, tumikhan jun koi, ‘Jun manu mondoli laga naam loi kene kosom khai, etu eku nohoi. Kintu jun manu mondoli laga suna chandi laga naam loi kene kosom khai, tai etu kosom rakhibo lage.’ <verse eid="MAT 23:16"/><verse number="17" style="v" sid="MAT 23:17"/>Tumi murkho aru andha manu khan! Kuntu sob pora dangor ase, suna chandi na utu mondoli jun pora suna chandi khan ke pobitro bonai? <verse eid="MAT 23:17"/><verse number="18" style="v" sid="MAT 23:18"/>Aru, ‘Jun manu bedi laga kosom khai, etu eku nohoi. Kintu jun manu Isor laga bedi te daan thaka laga kosom khai, tai etu kosom manibo lagibo.’ <verse eid="MAT 23:18"/><verse number="19" style="v" sid="MAT 23:19"/>O Tumikhan murkho aru andha manu khan! Kuntu sob pora dangor ase, utu daan khan na Isor laga bedi jun pora etu daan ke pobitro bonai diye? <verse eid="MAT 23:19"/><verse number="20" style="v" sid="MAT 23:20"/>Etu karone, jun manu Isor laga bedi laga kosom khai, tai etu aru etu logote thaka sob saman khan laga kosom khai loi. <verse eid="MAT 23:20"/><verse number="21" style="v" sid="MAT 23:21"/>Jun ekjon mondoli laga kosom khai, tai etu mondoli aru mondoli ghor te thaka Isor laga kosom khai loi. <verse eid="MAT 23:21"/><verse number="22" style="v" sid="MAT 23:22"/>Aru jun sorgo laga kosom khai, tai Isor laga singhason aru Tai usorte boha khan sob laga kosom khai loi.<verse eid="MAT 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23"/>O niyom likha khan aru Pharisee khan, tumi kopoti khan ke hai ase! Kilekoile tumikhan pudina, aru pata, aru dhaniya laga dos bhag di thake, aru bisi ujon thaka niyom, faisla, maph, aru biswas laga kotha khan ke chari diye- eitu khan bhi kori bole laga asele, hoilebi dusra khan bhi nakorikena nacharibo lage. <verse eid="MAT 23:23"/><verse number="24" style="v" sid="MAT 23:24"/>Tumikhan andha cholawta khan, jun khan makhi dikhile ghin lage, aru ekta uth-janwar ke khai loi.<verse eid="MAT 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25"/>O niyom likha khan aru Pharisee khan, tumi kopoti khan ke hai ase! Kilekoile tumikhan kup aru thali laga bahar phale sapha kori thake, hoile bhi bhitor te to joborjosti pora luwa aru lalchi pora bhorta ase. <verse eid="MAT 23:25"/><verse number="26" style="v" sid="MAT 23:26"/>Tumi andha Pharisee, poila kup aru thali laga bhitor te ki ase etu ke sapha koribi, titia eitu khan laga bahar khan bhi nijor pora sapha hoi jabo.<verse eid="MAT 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27"/>O niyom likha khan aru Pharisee khan, tumi kopoti khan ke hai ase! Kilekoile tumikhan chuna mara pathor laga kobor nisena ase, juntu bahar pora sundur dikhe, hoile bhi bhitor te mora manu khan laga hardi khan, aru sob moila khan pora bhorta ase. <verse eid="MAT 23:27"/><verse number="28" style="v" sid="MAT 23:28"/>Thik eneka nisena tumikhan bhi bahar pora manu khan usorte hosa te thaka nisena dikhe, hoilebi bhitor te misa misi aru paap pora bhorta ase.<verse eid="MAT 23:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29"/>O niyom likha khan aru Pharisee khan, tumi kopoti khan ke hai ase! Kilekoile tumikhan utu bhabobadi khan laga kobor khan bonaise, aru utu dharmikta te thaka manu khan laga pathor laga kobor ke sundur pora korise, <verse eid="MAT 23:29"/><verse number="30" style="v" sid="MAT 23:30"/>Aru koise, ‘Amikhan baba laga baba khan laga homoi te amikhan thakise koile, amikhan etu bhabobadi khan laga khun phelai diya te bhag nolobole thakise.’ <verse eid="MAT 23:30"/><verse number="31" style="v" sid="MAT 23:31"/>Eneka pora tumikhan nije pora he koi ase tumikhan taikhan laga bacha khan ase jun khan pora bhabobadi khan ke morai dise. <verse eid="MAT 23:31"/><verse number="32" style="v" sid="MAT 23:32"/>Etu nimite tumikhan baba laga baba khan laga hisab ke tumikhan bhorta koribi. <verse eid="MAT 23:32"/><verse number="33" style="v" sid="MAT 23:33"/>Tumikhan saph khan, saph laga khandan khan, kineka pora tumikhan norok laga sajai pora polabole paribo? <verse eid="MAT 23:33"/><verse number="34" style="v" sid="MAT 23:34"/>Etu nimite, sabi, Ami tumikhan ke bhabobadi aru gyaani aru niyom likha khan ke pathai ase. Kunba khan ke tumikhan pora morai dibo aru Cross uporte maribo, aru kunba khan ke tumikhan Isor laga kotha kora ghor te tumikhan pora chabuk pora maribo aru ekta sheher pora dusra sheher laga bahar te khedai dibo. <verse eid="MAT 23:34"/><verse number="35" style="v" sid="MAT 23:35"/>Eneka pora tumikhan uporte prithibi te jiman hosa te thaka khan ase taikhan laga khun ahibo, hosa te thaka Abel laga khun pora shuru kori kene Barachias laga chokra Zacharias laga khun tak, junke tumikhan pobitro jaga aru bedi majot te morai disele. <verse eid="MAT 23:35"/><verse number="36" style="v" sid="MAT 23:36"/>Hosa pora ami tumikhan ke koidi ase, eitu khan sob aji-kali laga yug uporte ahibo.<verse eid="MAT 23:36"/></para>
  <para style="s">Jerusalem Nimite Koi Diya</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37"/>Jerusalem, Jerusalem, tumi jun khan bhabobadi khan ke morai diye aru jun khan ke tumikhan logot pathai diye taikhan ke bhi tumikhan pathor mari dise! Kiman bar Moi tumi laga bacha khan ke milai dibole itcha thakise, jineka ekta murgi ama tai laga bacha khan ke tai laga pakhi nichete joma kore, kintu tumikhan ahibole itcha thaka nai! <verse eid="MAT 23:37"/><verse number="38" style="v" sid="MAT 23:38"/>Sabi, tumikhan laga ghor pora tumikhan ke ekla chari dibo. <verse eid="MAT 23:38"/><verse number="39" style="v" sid="MAT 23:39"/>Kilekoile Moi tumikhan ke koi ase, etiya pora tumikhan Amike nadikhibo jitia tak tumikhan eneka nakoi, ‘Tai asis te ase jun Probhu laga naam pora ahise.<note caller="+" style="f"><char style="fr" closed="false">23.39 </char><char style="ft" closed="false">Psa. 118:26.</char></note>’”<verse eid="MAT 23:39"/></para>
  <chapter eid="MAT 23"/>
  <chapter number="24" style="c" sid="MAT 24"/>
  <para style="s">Mondir Nosto Hobo Age Te Kowa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1"/>Jisu mondoli laga bahar te ulaikene nijor rasta te jai thakise. Tai laga chela khan Tai usorte ahikena mondoli ghor dikhai thakise. <verse eid="MAT 24:1"/><verse number="2" style="v" sid="MAT 24:2"/>Kintu Tai jowab dise aru taikhan ke koise, “Tumikhan etu sob dikhi ase na nai? Moi hosa pora koi ase, etu sob pathor khan matite phelai dibo. Ekta pathor bhi ekta uporte thakibo nadibo, sobke bhangai kene girai dibo.”<verse eid="MAT 24:2"/></para>
  <para style="s">Yug Hekh Huwa Chihna</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3"/>Jitia Tai Oliv Pahar te bohi thakise, Tai laga chela khan lukai kene ahise, eneka koi kene, “Amikhan ke kobi, eitu khan kitia hobole ase? Apuni aru ahibole thaka aru etu duniya laga somoi khotom hobole laga din to, kineka pora amikhan ke dikhai dibo?” <verse eid="MAT 24:3"/><verse number="4" style="v" sid="MAT 24:4"/>Jisu jowab dise, “Hoshiar thakibi, kun pora bhi tumikhan ke thogabole nadibi. <verse eid="MAT 24:4"/><verse number="5" style="v" sid="MAT 24:5"/>Kilekoile bisi manu ami laga naam loi kene ahibo. Taikhan kobo, ‘Moi Khrista ase,’ aru bisi manu khan ke thogai dibo. <verse eid="MAT 24:5"/><verse number="6" style="v" sid="MAT 24:6"/>Tumikhan larai kora aru larai hobole thaka laga khobor hunibo. Hoilebi tumikhan chinta na koribi, kele koile prithibi khotom nohua age te eitu khan sob purah hobo lage. <verse eid="MAT 24:6"/><verse number="7" style="v" sid="MAT 24:7"/>Ekta desh pora dusra desh ke bhirodh koribo, aru ekta rajyo pora dusra rajyo ke hinsa koribo. Utu somoite bisi jagate khabole nathakibo aru mati khan bisi hili bo. <verse eid="MAT 24:7"/><verse number="8" style="v" sid="MAT 24:8"/>Kintu eitu khan sob to bacha jonom hobole nimite bikhabole shuru huwa he ase. <verse eid="MAT 24:8"/><verse number="9" style="v" sid="MAT 24:9"/>Etu pichete tumikhan ke taikhan pora saja dibo aru morai dibo. Tumikhan ke sob desh khan pora Ami laga naam nimite ghin koribo. <verse eid="MAT 24:9"/><verse number="10" style="v" sid="MAT 24:10"/>Etu pichete bisi manu laga biswas harai jabo, aru ekjon-ekjon ke thogabo aru ghin koribo. <verse eid="MAT 24:10"/><verse number="11" style="v" sid="MAT 24:11"/>Misa bhabobadi khan bisi ulabo aru bisi manu ke thogai dibo. <verse eid="MAT 24:11"/><verse number="12" style="v" sid="MAT 24:12"/>Kilekoile niyom namana khan bisi hoi jabo, aru bisi manu laga morom to thanda hoi jabo. <verse eid="MAT 24:12"/><verse number="13" style="v" sid="MAT 24:13"/>Kintu jun hekh tak biswas te thakibo, taikhan he bachibo. <verse eid="MAT 24:13"/><verse number="14" style="v" sid="MAT 24:14"/>Etu sorgo rajyo laga bhal khobor to pura prithibi te ekta gawahi hoi kene pura desh te prochar koribo. Etu pichete hekh din to ahibo.<verse eid="MAT 24:14"/></para>
  <para style="s">Ghin Laga Letera Bostu</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15"/>Etu karone, jitia tumikhan ghin laga kaam pora khotom kori diya dikhibo, juntu kotha bhabobadi Daniel pora koi disele, tumikhan pobitro jagate khara kori kene dikhibo<note caller="+" style="f"><char style="fr" closed="false">24.15 </char><char style="ft" closed="false">Dan. 9:27; 11:31; 12:11.</char></note>”- kun puri ase tai bujhi lobi,- <verse eid="MAT 24:15"/><verse number="16" style="v" sid="MAT 24:16"/>“Etu pichete jun khan Judea te ase taikhan ke pahar uporte polabole dibi, <verse eid="MAT 24:16"/><verse number="17" style="v" sid="MAT 24:17"/>jun manu ghor uporte ase, taike ghor laga saman khan lobole nichete jabole nadibi, <verse eid="MAT 24:17"/><verse number="18" style="v" sid="MAT 24:18"/>aru jun kheti te ase taike ghor te jai kene chador lobole nadibi. <verse eid="MAT 24:18"/><verse number="19" style="v" sid="MAT 24:19"/>Kintu, utu dinte jun khan pet te bacha nohoile bhi dudh khai thaka bacha khan logote ase, taikhan bisi dukh pabo! <verse eid="MAT 24:19"/><verse number="20" style="v" sid="MAT 24:20"/>Prathana koribi eneka to thanda din nohoile Bisram dinte eitu khan nahobole nimite. <verse eid="MAT 24:20"/><verse number="21" style="v" sid="MAT 24:21"/>Etu pichete dangor dukh digdar din ahijabo, etu somoite kitia bhi napa laga dukh khan pabo, aru etu nisena dukh kitia bhi aru nahibo. <verse eid="MAT 24:21"/><verse number="22" style="v" sid="MAT 24:22"/>Jitia tak utu din khotom nahobo, ekjon manu bhi nabachibo. Kintu basi luwa manu khan laga prathana pora he etu dukh din khan ke khata kori dibo. <verse eid="MAT 24:22"/><verse number="23" style="v" sid="MAT 24:23"/>Etu pichete jodi kunba pora tumike koi, ‘Sabi, Khrista yate ase!’ Nohoile bhi, ‘Tai ta te ase!’ Taikhan ke biswas na koribi. <verse eid="MAT 24:23"/><verse number="24" style="v" sid="MAT 24:24"/>Kile mane misa Khrista aru misa bhabobadi khan ahibo aru asurit kaam khan kori kene dikha bo, tumikhan ke thogabo, parile Isor pora basi kene thaka khan ke bhi. <verse eid="MAT 24:24"/><verse number="25" style="v" sid="MAT 24:25"/>Sabi, Ami tumikhan ke etiya pora he eitu khan koi dise. <verse eid="MAT 24:25"/><verse number="26" style="v" sid="MAT 24:26"/>Etu karone, jodi taikhan pora tumikhan ke koi, ‘Sabi, Tai eku bhi nathaka jagate ase,’ eneka jagate najabi. Nohoile bhi, ‘Sabi, Tai ghor bhitor te ase,’ eneka khan biswas na koribi. <verse eid="MAT 24:26"/><verse number="27" style="v" sid="MAT 24:27"/>Kilekoile jineka bhijili purab pora ujala hoi aru phat kori kene paschim tak jule, thik etu nisena Manu laga Putro bhi eneka ahibo. <verse eid="MAT 24:27"/><verse number="28" style="v" sid="MAT 24:28"/>Juntu jagate janwar khan mori kene thake, etu jagate mangso kha chiriya khan joma hoi.<verse eid="MAT 24:28"/></para>
  <para style="s">Manu Laga Putro Aha</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29"/>Kintu loge-loge dukh digdar din khan pichete, suryo to andhera hoi jabo, aru chand to ujala nadiya hoi jabo, aru tara khan akas pora giri jabo, aru sorgo laga hokti to hili jabo. <verse eid="MAT 24:29"/><verse number="30" style="v" sid="MAT 24:30"/>Etu pichete Manu laga Putro aha din laga chihna akas te dikhai dibo, aru sob prithibi laga jati khan kandibo. Taikhan Manu laga Putro ke purah hokti aru dangor mohima pora akas laga badal te aha dikhibo. <verse eid="MAT 24:30"/><verse number="31" style="v" sid="MAT 24:31"/>Tai pora Tai laga sorgodoth khan ke dangor bajana pora awaj kori kene prithibi te pathabo, aru taikhan Isor pora basi luwa manu khan ke prithibi laga char kona pora joma kori lobo.<verse eid="MAT 24:31"/></para>
  <para style="s">Dimoru Gash Laga Sikha</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32"/>Etu dristanto to dimoru laga ghas pora sikhi lo bhi. Jitia tai laga daal khan norom hoijai aru notun pata khan ulai ahe, titia tumikhan jani jai gorom din ahi ase. <verse eid="MAT 24:32"/><verse number="33" style="v" sid="MAT 24:33"/>Thik eneka, jitia eitu khan dikhibo, tumikhan jani jabi Manu laga Putro to dorja usorte punchi ase. <verse eid="MAT 24:33"/><verse number="34" style="v" sid="MAT 24:34"/>Moi hosa pora tumikhan ke koi ase, etu yug khotom nohobo jitia tak eitu khan sob pura hoi najai. <verse eid="MAT 24:34"/><verse number="35" style="v" sid="MAT 24:35"/>Akas aru prithibi to harai jabo, kintu Moi laga ekta chutu kotha bhi naharabo.<verse eid="MAT 24:35"/></para>
  <para style="s">Etu Din Aru Homoi Kunbi Najane</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36"/>Kintu kitia utu din aru somoi ahibo, kun bhi najane, sorgodoth khan bhi najane, nohoile Putro bhi najane, khali Baba ekla he jane. <verse eid="MAT 24:36"/><verse number="37" style="v" sid="MAT 24:37"/>Kineka Noah laga dinte hoise etu nisena Manu laga Putro aha din bhi eneka hobo. <verse eid="MAT 24:37"/><verse number="38" style="v" sid="MAT 24:38"/>Kilekoile utu somoite bhi, Noah pora naw bhitor te naghusa din tak, manu khan nisa-pani khai thakise, shadi kori thakise aru shadi koridi thakise, <verse eid="MAT 24:38"/><verse number="39" style="v" sid="MAT 24:39"/>aru taikhan eku jani kene thaka nai aru jitia ban-pani ahise, taikhan sobke pani pora loi jaise- etu nisena Manu laga Putro aha din bhi etu nisena ahibo. <verse eid="MAT 24:39"/><verse number="40" style="v" sid="MAT 24:40"/>Etu pichete duijon manu kheti te thakibo- ekjon ke loijabo, aru ekjon ke chari dibo. <verse eid="MAT 24:40"/><verse number="41" style="v" sid="MAT 24:41"/>Duijon maiki mil te chawal khundi thakibo- ekjon ke loijabo, aru ekjon ke chari dibo. <verse eid="MAT 24:41"/><verse number="42" style="v" sid="MAT 24:42"/>Etu karone nijor jagate taiyar hoi kene thakibi, kele koile tumi najane kuntu dinte tumi laga Probhu ahibo. <verse eid="MAT 24:42"/><verse number="43" style="v" sid="MAT 24:43"/>Kintu etu jani kene thakibi, jodi ghor laga malik to kuntu somoite chor ahibo etu jani thakile, tai to taiyar hoi kene thaki bole asele aru etu chor ke tai laga ghor bhitor te ghusi bole nadibo thakise. <verse eid="MAT 24:43"/><verse number="44" style="v" sid="MAT 24:44"/>Etu karone tumikhan bhi taiyar thakibi, kele koile Manu laga Putro to tumikhan nabhaba somoite ahibo.<verse eid="MAT 24:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45"/>Etu nimite, kun sob pora thik aru gyaan thaka nokor ase, junke tai laga malik pora biswas rakhi kene tai kha luwa thik somoite dibole aru ghor laga kaam sabole nimite rakhikena ase? <verse eid="MAT 24:45"/><verse number="46" style="v" sid="MAT 24:46"/>Utu nokor asis pabo jitia tai laga malik ahikena taike kaam kori thaka dikhibo. <verse eid="MAT 24:46"/><verse number="47" style="v" sid="MAT 24:47"/>Hosa pora Moi tumikhan ke koi ase utu malik pora Tai laga ki ase etu sob utu nokor laga jimedari te rakhidibo. <verse eid="MAT 24:47"/><verse number="48" style="v" sid="MAT 24:48"/>Kintu jodi etu biya nokor mon bhitor te koi, ‘Moi laga malik to deri pora ahibo,’ <verse eid="MAT 24:48"/><verse number="49" style="v" sid="MAT 24:49"/>aru tai dusra nokorkhan ke mari bole shuru hoijai, aru modhu kha manu khan logote mili kene nisa-pani khai, <verse eid="MAT 24:49"/><verse number="50" style="v" sid="MAT 24:50"/>aru tai nabhaba aru najana somoite tai laga malik ahijai. <verse eid="MAT 24:50"/><verse number="51" style="v" sid="MAT 24:51"/>Etu pichete tai laga malik taike saja dibo aru dhongi manu khan logote rakhidibo, aru ta te khali kanda aru daat kamura he hobo.<verse eid="MAT 24:51"/></para>
  <chapter eid="MAT 24"/>
  <chapter number="25" style="c" sid="MAT 25"/>
  <para style="s">Dos Jon Kumari Chukri Khan Laga Dristanto</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1"/>Aru, etu somoite, sorgo laga rajyo to dosta chukri nisena ase jun taikhan laga saaki loi kene taikhan laga mota hobole thaka khan ke lok kori bole jaise. <verse eid="MAT 25:1"/><verse number="2" style="v" sid="MAT 25:2"/>Pans jon to murkho thakise aru pans jon to gyaani thakise. <verse eid="MAT 25:2"/><verse number="3" style="v" sid="MAT 25:3"/>Kilekoile utu pansta chukri taikhan laga saaki to loise, kintu taikhan tel lobole borton to pahori jaise. <verse eid="MAT 25:3"/><verse number="4" style="v" sid="MAT 25:4"/>Hoilebi utu pansta gyaani chukri khan to borton te tel hali kene taikhan logot saaki bhi loi jaise. <verse eid="MAT 25:4"/><verse number="5" style="v" sid="MAT 25:5"/>Jitia taikhan logot shadi kori bole thaka mota ahibole deri hoise, taikhan sob neendh lagi kene ghumai jaise. <verse eid="MAT 25:5"/><verse number="6" style="v" sid="MAT 25:6"/>Kintu rati laga majote ta te ekta awaj hunise, ‘Sabi, shadi koribo thaka mota ahise! Jabi aru taikhan ke lok koribi.’ <verse eid="MAT 25:6"/><verse number="7" style="v" sid="MAT 25:7"/>Etu pichete chukri khan sob uthi kene taikhan laga sakhi julai se. <verse eid="MAT 25:7"/><verse number="8" style="v" sid="MAT 25:8"/>Kintu murkho chukri khan gyaani chukri khan ke koise, ‘Amikhan ke apnikhan laga tel olop dibi kelemane amikhan laga saaki to bhuti jabole ase,’ <verse eid="MAT 25:8"/><verse number="9" style="v" sid="MAT 25:9"/>Kintu utu gyaani chukri khan jowab dikene koise, ‘Amikhan aru apnikhan nimite bhi napuncha hoi jabo, etu pora to jai kene tel bikiri kora manu pora nijor nimite kini lobi.’ <verse eid="MAT 25:9"/><verse number="10" style="v" sid="MAT 25:10"/>Jitia taikhan kini bole jaise, shadi kora mota khan punchi kene ghor bhitor te jaise, aru jun khan taiyar thakise taikhan logote shadi kori bole jaise, aru dorja bondh kori dise. <verse eid="MAT 25:10"/><verse number="11" style="v" sid="MAT 25:11"/>Etu pichete utu murkho chukri khan ahi kene koise, ‘Malik, malik, amikhan nimite bhi dorja khuli bhi.’ <verse eid="MAT 25:11"/><verse number="12" style="v" sid="MAT 25:12"/>Kintu tai jowab dikene koise, ‘Hosa pora Moi tumikhan ke koi ase, Moi tumikhan ke najane.’ <verse eid="MAT 25:12"/><verse number="13" style="v" sid="MAT 25:13"/>Etu karone saikene thakibi, kele koile kuntu din nohoile bhi kuntu somoite Manu laga Putro wapas ahibo tumikhan najane.<verse eid="MAT 25:13"/></para>
  <para style="s">Bordan Laga Dristanto</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14"/>Kile mane etu to ekjon manu safar te jai thaka nisena ase. Tai nijor laga nokorkhan ke matise aru taikhan ke Tai laga dhun khan dise. <verse eid="MAT 25:14"/><verse number="15" style="v" sid="MAT 25:15"/>Ekjon ke pansta talents<note caller="+" style="f"><char style="fr" closed="false">25.15 </char><char style="ft" closed="false">Talent to 5000 suna laga sikha ase.</char></note> dise, dusra ke duita talents dise<note caller="+" style="f"><char style="fr" closed="false">25.15 </char><char style="ft" closed="false">Dui hazar suna laga sikha.</char></note>, aru ekjon dusra ke ekta talent dise. Tai sobke taikhan laga kaam hisab te dise, aru joldi kori kene taikhan laga safar nimite ulai jai. <verse eid="MAT 25:15"/><verse number="16" style="v" sid="MAT 25:16"/>Jun manu ke pansta bordan disele tai jai kene kaam te cholai se aru tai aru bhi pansta bordan bisi paise. <verse eid="MAT 25:16"/><verse number="17" style="v" sid="MAT 25:17"/>Etu nisena junke duita bordan disele tai bhi duita bordan aru bhi paise. <verse eid="MAT 25:17"/><verse number="18" style="v" sid="MAT 25:18"/>Kintu juntu nokor ke ekta bordan disele, tai jai kene mati khundi kene malik pora diya poisa to rupai dise. <verse eid="MAT 25:18"/><verse number="19" style="v" sid="MAT 25:19"/>Etiya, bisi din pichete nokorkhan laga malik to wapas ahe aru taikhan ke bordan diya laga hisab khan mange. <verse eid="MAT 25:19"/><verse number="20" style="v" sid="MAT 25:20"/>Pansta bordan pa-a nokor ahi kene aru bhi pansta bordan bisi kori kene tai laga malik ke dise. Tai koise, ‘Malik, apuni amike pansta bordan dise. Kintu sabi, moi etu dui guna bisi kori dise.’ <verse eid="MAT 25:20"/><verse number="21" style="v" sid="MAT 25:21"/>Tai laga malik taike koise, ‘Bisi bhal korise, bhal aru imandar nokor! Tumi bisi imandar pora kaam khan korise. Moi tumike sob kaam khan sabole jimedari di ase. Ahibi aru tumi laga malik logote khushi koribi.’ <verse eid="MAT 25:21"/><verse number="22" style="v" sid="MAT 25:22"/>Dusra nokor junke duita bordan disele tai ahikena koise, ‘Malik, apuni amike duita bordan dise. Kintu sabi, moi aru duita bisi bordan kori dise.’ <verse eid="MAT 25:22"/><verse number="23" style="v" sid="MAT 25:23"/>Tai laga malik taike koise, ‘Bisi bhal korise, bhal aru imandar nokor ase! Tumi bisi imandar pora kaam khan korise. Moi tumike sob kaam khan sabole jimedari di ase. Ahibi aru tumi laga malik logot te khushi koribi.’ <verse eid="MAT 25:23"/><verse number="24" style="v" sid="MAT 25:24"/>Etu pichete ekta bordan pa-a nokor ahikena koise, ‘Malik, moi jani ase apuni bisi kara manu ase. Apuni juntu jagate bijon naphelai ta te guti khan joma kore, aru juntu jagate kheti nakore ta te kheti kate. <verse eid="MAT 25:24"/><verse number="25" style="v" sid="MAT 25:25"/>Moi bhoi khai thakise, etu karone moi jai kene mati bhitor te lukai kene rakhise. Sabi, apuni ki dise etu yate ase.’ <verse eid="MAT 25:25"/><verse number="26" style="v" sid="MAT 25:26"/>Kintu tai laga malik jowab dikene taike koise, ‘Tumi mon kala aru alsi kora nokor, tumi jani ase, moi juntu jagate bijon naphelai ta te guti khan joma kore, aru juntu jagate kheti nakore ta te kheti kate. <verse eid="MAT 25:26"/><verse number="27" style="v" sid="MAT 25:27"/>Etu karone moi laga poisa to poisa ghor te dise koile bhal hobole thakise, aru jitia moi wapas ahibo moi laga poisa logote munafa bhi pabo thakise. <verse eid="MAT 25:27"/><verse number="28" style="v" sid="MAT 25:28"/>Etu karone, tai laga hath pora bordan khan loi lobi aru jun logote dosta bordan ase taike di dibi. <verse eid="MAT 25:28"/><verse number="29" style="v" sid="MAT 25:29"/>Kilekoile jun manu khan bisi ase- taike aru bhi dibo- ekdom bhorta pora aru bhi dibo. Kintu jun manu khan logote eku bhi nai, taikhan logote ki ase eitu khan bhi tai pora chingi loi lobo. <verse eid="MAT 25:29"/><verse number="30" style="v" sid="MAT 25:30"/>Etu kaam nathaka nokor ke andhera jagate phelai dibi, juntu jagate khali kandi thaka aru daat kamuri thaka he hobo.’<verse eid="MAT 25:30"/></para>
  <para style="s">Hekh Din Laga Bisar</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31"/>Jitia Manu laga Putro tai laga mohima aru pura sorgodoth khan logote ahibo, etu pichete Tai laga mohima laga jagate bohibo. <verse eid="MAT 25:31"/><verse number="32" style="v" sid="MAT 25:32"/>Tai laga age te sob desh khan joma hobo, aru Tai manu khan ke ekjon pora dusra jonke alag koribo, jineka roikhya pora mer aru saguli ke alag kori diye. <verse eid="MAT 25:32"/><verse number="33" style="v" sid="MAT 25:33"/>Tai mer khan ke Tai laga dyna hath phale rakhibo aru saguli khan ke baya hath phale rakhibo. <verse eid="MAT 25:33"/><verse number="34" style="v" sid="MAT 25:34"/>Etu pichete Raja pora Tai laga dyna hathte thaka manu khan ke koise, ‘Ahibi, Moi laga Baba pora tumikhan ke asis dikene ase, juntu rajyo tumikhan nimite prithibi bona somoite rakhi sele, etu tumikhan laga hoise. <verse eid="MAT 25:34"/><verse number="35" style="v" sid="MAT 25:35"/>Kilekoile Moi bhuka thakise aru tumikhan Moike khilai se; Moi pyaas lagi thakise aru tumikhan Moike pani khabole dise; <verse eid="MAT 25:35"/><verse number="36" style="v" sid="MAT 25:36"/>Moi eku kapra pindhi kene thaka nai aru tumi moike pindhibole dise; Moi bemar aru bondhi ghor te thakise aru tumi moike sabole ahise.’ <verse eid="MAT 25:36"/><verse number="37" style="v" sid="MAT 25:37"/>Etu pichete dharmik khan Taike jowab dikene kobo, ‘Probhu, amikhan kitia Apuni bhuk lagi thaka dikhise aru khilai se? Nohoile Apuni pyaas laga homoi te Apuni ke pani dise? <verse eid="MAT 25:37"/><verse number="38" style="v" sid="MAT 25:38"/>Aru amikhan kitia Apuni ke nachina manu ase koi kene loi jaise? Nohoile bhi kapra pindhibole nathaka dikhi kene kapra pindhai dise? <verse eid="MAT 25:38"/><verse number="39" style="v" sid="MAT 25:39"/>Aru amikhan kitia Apuni ke bemar ase nohoile bhi bondhi ghor te ase koi kene Apuni usorte ahise? <verse eid="MAT 25:39"/><verse number="40" style="v" sid="MAT 25:40"/>Etu pichete Raja pora jowab dikene taikhan ke kobo, ‘Hosa pora Moi tumikhan ke koi ase, ki kaam tumi Moi laga bhai khan nimite korise, tumi Moi nimite he korise.’ <verse eid="MAT 25:40"/><verse number="41" style="v" sid="MAT 25:41"/>Etu pichete Tai bhi kobo Tai laga baya hath phale thaka manu khan ke, ‘Moi laga usor pora dur hoi jabi, tumi paap manu khan, khotom nohua jui te jabi juntu jaga biya atma aru tai laga duth khan nimite bonaise, <verse eid="MAT 25:41"/><verse number="42" style="v" sid="MAT 25:42"/>kele koile Moi bhuk lagi thakise, kintu tumikhan Moike eku bhi khabole diya nai; Moi pyaas lagi thakise, kintu tumikhan Moike pani bhi khabole diya nai; <verse eid="MAT 25:42"/><verse number="43" style="v" sid="MAT 25:43"/>Moi nachina manu thakise, kintu tumikhan Moike mata nai; kapra pindhibole thaka nai, kintu tumikhan Moike kapra pindhi diya nai; bemar aru bondhi ghor te thakise, kintu tumikhan Moike sabole aha nai.’ <verse eid="MAT 25:43"/><verse number="44" style="v" sid="MAT 25:44"/>Etu pichete taikhan bhi jowab dikene kobo, ‘Probhu, amikhan kitia Apuni ke bhuka, pyasa, bahar manu, kapra pindhibole nathaka, bemar, bondhi ghor te, eneka kora dikhise aru Apuni ke sewa kora nai? <verse eid="MAT 25:44"/><verse number="45" style="v" sid="MAT 25:45"/>Etu pichete Tai jawab dikene kobo, ‘Hosa para Moi tumikhan ke koi ase, ji kaam tumi Moi laga manu khan nimite kora nai tumi Moi nimite bhi kora nai.’ <verse eid="MAT 25:45"/><verse number="46" style="v" sid="MAT 25:46"/>Titia Jisu eneka koise, “Eitu khan kitia bhi khotom nohua saja pabo, kintu dharmik khan anonto jibon pabo.”<verse eid="MAT 25:46"/></para>
  <chapter eid="MAT 25"/>
  <chapter number="26" style="c" sid="MAT 26"/>
  <para style="s">Jisu Ke Morai Dibole Bhabona</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1"/>Jitia Jisu sob kotha khan koi kene khotom korise, Tai chela khan ke koise, <verse eid="MAT 26:1"/><verse number="2" style="v" sid="MAT 26:2"/>“Tumikhan jani kene ase dui din pichete Nistar utsov din ahi ase, aru Manu laga Putro ke Cross te morai dibole di dibo.” <verse eid="MAT 26:2"/><verse number="3" style="v" sid="MAT 26:3"/>Etu pichete mukhyo purohit aru bura khan sob ahikena moha purohit Caiaphas laga ghor te eke logote joma hoise. <verse eid="MAT 26:3"/><verse number="4" style="v" sid="MAT 26:4"/>Taikhan sob kineka kori kene Jisu ke dhoribo aru chalak pora Taike morai dibo, etu bhabona kori thakise. <verse eid="MAT 26:4"/><verse number="5" style="v" sid="MAT 26:5"/>Kilekoile taikhan majot te eneka koi thakise, “Utsov laga somoite nohoi, nohoile etu nimite manu khan majote jhagara ulabo pare.”<verse eid="MAT 26:5"/></para>
  <para style="s">Bethany Te Jisu Ke Abhishek Kora</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6"/>Jitia Jisu Bethany bosti te ekjon bemar manu Simon koi kene tai laga ghor te thakise, <verse eid="MAT 26:6"/><verse number="7" style="v" sid="MAT 26:7"/>aru Tai mez te bohi thakise, ekjon mahila Jisu usorte bisi daam laga tel ke ekta mati laga kolsi te hali kene anise, aru tai Jisu laga matha te hali dise. <verse eid="MAT 26:7"/><verse number="8" style="v" sid="MAT 26:8"/>Kintu jitia Jisu laga chela khan etu dikhise, taikhan ghusa hoi kene koise, “Eneka nuksan kora laga motlob to ki ase? <verse eid="MAT 26:8"/><verse number="9" style="v" sid="MAT 26:9"/>Eitu ke bisi daam pora bikiri kori kene gorib manu khan ke dibo paribole thakise.” <verse eid="MAT 26:9"/><verse number="10" style="v" sid="MAT 26:10"/>Kintu Jisu, etu sob jani kene, taikhan ke koise, “Tumikhan kele etu mahila ke digdar di ase? Tai moi nimite bhal kaam kori dise. <verse eid="MAT 26:10"/><verse number="11" style="v" sid="MAT 26:11"/>Kilekoile tumikhan logote gorib manu khan to hodai thakibo, kintu Moi tumikhan logote hodai nathakibo. <verse eid="MAT 26:11"/><verse number="12" style="v" sid="MAT 26:12"/>Kitia etu mahila pora Moi laga gaw uporte te tel hali dise, tai Moike kobor te nadhala age te taiyar koridi ase. <verse eid="MAT 26:12"/><verse number="13" style="v" sid="MAT 26:13"/>Hosa pora Moi tumikhan ke koi ase, jitia etu bhal khobor pura prithibi te prochar hobo, etu mahila pora ki korise tai laga yaad te etu kotha koribo.”<verse eid="MAT 26:13"/></para>
  <para style="s">Judas Pora Jisu Ke Thogai Diya</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14"/>Etu pichete baroh jon chela majote ekjon chela, Judas Iscariot, tai mukhyo purohit khan logot jaise, <verse eid="MAT 26:14"/><verse number="15" style="v" sid="MAT 26:15"/>aru koise, “Apuni khan moike ki dibole itcha kori ase, jodi moi apnikhan nimite Jisu ke thogai diye?” Titia taikhan trista chandi laga sikka ulaikene taike dise. <verse eid="MAT 26:15"/><verse number="16" style="v" sid="MAT 26:16"/>Aru utu somoi pora Judas to kineka kori kene Jisu ke thogai dibo etu bisari thakise.<verse eid="MAT 26:16"/></para>
  <para style="s">Chela Khan Logot Nistar Purbb</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17"/>Etiya, khomir nathaka roti laga nakha-a utsov laga poila dinte Jisu laga chela khan eneka koi kene ahise, “Apuni kuntu jagate amikhan Nistar purbb laga khana kori bole nimite jaga taiyar koribo dibo itcha ase?” <verse eid="MAT 26:17"/><verse number="18" style="v" sid="MAT 26:18"/>Jisu koise, “Sheher te jai kene kunba ekjon manu logote jabi aru taike kobi, ‘Malik pora koise, “Moi laga somoi usor hoi ase. Moi tumi laga ghor te Nistar purbb khana Moi laga chela khan nimite rakhibo.”’” <verse eid="MAT 26:18"/><verse number="19" style="v" sid="MAT 26:19"/>Aru chela khan eneka he korise aru taikhan Nistar purbb nimite khana taiyar kori loise.<verse eid="MAT 26:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20"/>Jitia saam hoise, Jisu tai laga baroh jon chela khan logote khabole bohise. <verse eid="MAT 26:20"/><verse number="21" style="v" sid="MAT 26:21"/>Aru jitia taikhan khai thakise, Jisu koise, “Hosa pora Moi tumikhan ke koi ase, tumikhan majot te ekjon pora Amike thogai dibo.” <verse eid="MAT 26:21"/><verse number="22" style="v" sid="MAT 26:22"/>Taikhan huni kene bisi mon dukh hoise, aru sob chela khan ekjon pichete ekjon eneka hudibole shuru hoise, “Probhu, hosa pora moi nohoi na?” <verse eid="MAT 26:22"/><verse number="23" style="v" sid="MAT 26:23"/>Jisu jowab dikene koise, “Etu ekjon kun Moi logote mili kene ekta thali te khaise, tai pora he Moike thogai dibo. <verse eid="MAT 26:23"/><verse number="24" style="v" sid="MAT 26:24"/>Manu laga Putro jabo lagibo, jineka Tai nimite Isor kotha te likhi kene ase. Kintu utu manu ke bisi hai ase jun pora Manu laga Putro ke thogabole ase! Tai nimite to jonom nohua he bhal hobole ase.” <verse eid="MAT 26:24"/><verse number="25" style="v" sid="MAT 26:25"/>Etiya Judas, kun Jisu ke thogabole thakise, jowab dikene koise, “Rabbi, hosa pora moi nohoi na? Jisu taike koise, “Tumi nijor pora he koi dise.”<verse eid="MAT 26:25"/></para>
  <para style="s">Probhu Bhoj Sthapon Kora</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26"/>Jitia taikhan khai thakise, Jisu roti loi kene Isor ke asirbad dikena bhangai se. Aru chela khan ke dikene koise, “Lobi, aru khabi. Etu Moi laga gaw ase.” <verse eid="MAT 26:26"/><verse number="27" style="v" sid="MAT 26:27"/>Titia, Jisu kup to loise aru Isor ke dhanyavad dise, aru taikhan ke eneka koi kene dise, “Tumikhan sob etu kup pora pi lobi. <verse eid="MAT 26:27"/><verse number="28" style="v" sid="MAT 26:28"/>Kilekoile etu Moi laga khun dwara vachan ase, etu pora sob manu paap pora khyama pabo. <verse eid="MAT 26:28"/><verse number="29" style="v" sid="MAT 26:29"/>Kintu Moi tumikhan ke koi ase, Baba laga rajyote Moi etu notun angur phol laga ros tumikhan logot napia tak, etu angur ros to aru napibo.”<verse eid="MAT 26:29"/></para>
  <para style="s">Peter Ashikar Kori bole Thaka Jisu Pora Age Pora Koi Diya</para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30"/>Jitia taikhan atma laga gana kori loise, taikhan ulaikene Oliv Pahar te jaise. <verse eid="MAT 26:30"/><verse number="31" style="v" sid="MAT 26:31"/>Etu pichete Jisu taikhan ke koise, “Tumikhan sob aji rati moi nimite biswas te giri jabo, kele koile Isor kotha te eneka likhi kene ase,</para>
  <para style="q" vid="MAT 26:31">‘Moi mer roikhya kora manu ke morai dibo</para>
  <para style="q" vid="MAT 26:31">Aru sob mer khan alag-alag jagate polai jabo.<note caller="+" style="f"><char style="fr" closed="false">26.31 </char><char style="ft" closed="false">Zech. 13:7</char></note>’<verse eid="MAT 26:31"/></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32"/>Kintu Moi mora pora uthija pichete, Moi tumikhan laga age Galilee te jabo.”<verse eid="MAT 26:32"/></para>
  <para style="m">
    <verse number="33" style="v" sid="MAT 26:33"/>Kintu Peter jowab dikene Jisu ke koise, “Jodi sob manu Apuni ke chari le bhi, moi Apuni ke kitia bhi nacharibo.” <verse eid="MAT 26:33"/><verse number="34" style="v" sid="MAT 26:34"/>Jisu taike koise, “Hosa pora Moi tumike koi ase, aji rati te, murga phojurte hala nakora age te, tumi Moike tin bar najane kobo.” <verse eid="MAT 26:34"/><verse number="35" style="v" sid="MAT 26:35"/>Peter Jisu ke koise, “Jodi moi Apuni logote moribo lage koile bhi, moi kitia bhi Apuni ke najane nakobo.” Aru sob chela khan bhi eneka eke kotha koise.<verse eid="MAT 26:35"/></para>
  <para style="s">Gethsemane Te Jisu Prathana</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36"/>Etu pichete Jisu taikhan logote Gethsemane koi kene ekta jagate jaise, aru chela khan ke koise, “Yate bohi thakibi Moi jai kene ta te prathana koribo. <verse eid="MAT 26:36"/><verse number="37" style="v" sid="MAT 26:37"/>Jisu pora Peter aru Zebedee laga duita chokra khan ke Tai logote loi jaise aru bisi chinta hoi kene mon dukh kori jaise. <verse eid="MAT 26:37"/><verse number="38" style="v" sid="MAT 26:38"/>Etu pichete Jisu taikhan ke koise, “Moi laga atma to bisi mon dukh ase, mori jabo nisena tak. Yate thakibi aru Moike rukhi thakibi.” <verse eid="MAT 26:38"/><verse number="39" style="v" sid="MAT 26:39"/>Aru Jisu olop age te jaise, aru matha niche kori kene prathana korise. Tai koise, “Moi laga Baba, jodi Apuni itcha hoile, etu kup to Moi usor pora hatai dibi. Kintu, Moi laga itcha pora nohoi, hoile bhi Apuni laga itcha pora he.” <verse eid="MAT 26:39"/><verse number="40" style="v" sid="MAT 26:40"/>Titia Jisu ahi kene chela khan ke ghumai thaka dikhise, aru Peter ke koise, “Tumikhan Moi nimite ek ghanta bhi rukhibole para nai? <verse eid="MAT 26:40"/><verse number="41" style="v" sid="MAT 26:41"/>Sai thakibi aru prathana kori thakibi, titia tumikhan porikha te nagiribo nimite. Atma to hosa pora bhi itcha ase, kintu mangso to komjur ase.” <verse eid="MAT 26:41"/><verse number="42" style="v" sid="MAT 26:42"/>Tai aru dusra bar prathana kori bole jaise, Tai koise, “Moi laga Baba, jodi etu Moi nakha tak Moi pora paar nohoi koile, Apuni laga itcha hobi.” <verse eid="MAT 26:42"/><verse number="43" style="v" sid="MAT 26:43"/>Tai aru bhi ahi kene taikhan ke ghumai thaka dikhise, kele koile taikhan laga suku neendh pora bhari hoi kene thakise. <verse eid="MAT 26:43"/><verse number="44" style="v" sid="MAT 26:44"/>Taikhan ke aru chari kene aru tin bar ula prathana kori bole jaise, aru age nisena he koise. <verse eid="MAT 26:44"/><verse number="45" style="v" sid="MAT 26:45"/>Etu pichete Jisu ahikena Tai laga chela khan ke koise, “Tumikhan aru bhi ghumai kene aram kori ase? Sabi, somoi to ahi ase aru Manu laga Putro ke thogai kene paapi manu laga hathte dibole ase. <verse eid="MAT 26:45"/><verse number="46" style="v" sid="MAT 26:46"/>Uthi bhi, amikhan jabo. Sabi, kun moike thogabole ase, tai usorte ahi ase.”<verse eid="MAT 26:46"/></para>
  <para style="s">Jisu Ke Thogai Kena Dhori Luwa</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47"/>Jitia Tai kotha kori thakise, titia, Judas, baroh jon chela khan majote ekjon ahise. Tai logote bisi manu khan talwar aru lathi dhori kene thakise, mukhyo purohit aru cholawta khan pora pathaise. <verse eid="MAT 26:47"/><verse number="48" style="v" sid="MAT 26:48"/>Titia etu manu kun Jisu ke thogai dibole thakise tai pora ekta chihna kori kene koise, “Kunke moi chuma dibo, tai he ase. Taike dhori bhi.” <verse eid="MAT 26:48"/><verse number="49" style="v" sid="MAT 26:49"/>Loge-loge tai Jisu usorte ahise aru koise, “Salam, Rabbi!” Aru tai Jisu ke chuma dise. <verse eid="MAT 26:49"/><verse number="50" style="v" sid="MAT 26:50"/>Jisu taike koise, “Sathi, tumi ki kori bole ahise etu kori lobi.” Etu pichete taikhan ahise, Jisu uporte hath lagaise, aru dhuri loise. <verse eid="MAT 26:50"/><verse number="51" style="v" sid="MAT 26:51"/>Sabi, ekjon kun Jisu usorte thakisele tai laga hath khuli se, aru tai laga talwar ulaikene moha purohit laga nokor ke marise aru tai laga kaan kati dise. <verse eid="MAT 26:51"/><verse number="52" style="v" sid="MAT 26:52"/>Titia Jisu taike koise, “Tumi laga talwar kote pora ulaise ta te wapas rakhibi, kun manu talwar uthabo tai etu talwar pora khotom hoi jabo. <verse eid="MAT 26:52"/><verse number="53" style="v" sid="MAT 26:53"/>Nohoile bhi tumikhan bhabe Moi Baba ke mati bona paribo, aru Tai baroh sorgodoth khan laga legion ekbar pora pathai dibo koi kene? <verse eid="MAT 26:53"/><verse number="54" style="v" sid="MAT 26:54"/>Kintu eneka hoile Isor kotha ki likha ase etu kineka purah hobo, yate ki hoi ase etu sob nohoile?” <verse eid="MAT 26:54"/><verse number="55" style="v" sid="MAT 26:55"/>Utu somoite Jisu manu khan ke koise, “Tumikhan talwar aru lathi loi kene Moike dhori bole ahise naki, jineka ekta chor ke dhuribole aha nisena? Hodai Moi mondoli te bohi kene sikhai thakise, aru tumikhan utu somoite Moike dhura nai. <verse eid="MAT 26:55"/><verse number="56" style="v" sid="MAT 26:56"/>Kintu eitu khan sob purah hoise, tineka hoile bhabobadi khan pora Isor kotha te likhi kene thaka khan pura hobo nimite.” Etu pichete sob chela khan Jisu ke chari kene polai jaise.<verse eid="MAT 26:56"/></para>
  <para style="s">Jisu Caiaphas Age Te</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57"/>Jun khan Jisu ke dhori kene loi jaise, aru Caiaphas ekjon maha purohit laga usorte loi jaise, juntu jagate niyom likha khan aru bura manu khan joma hoi kene thakise. <verse eid="MAT 26:57"/><verse number="58" style="v" sid="MAT 26:58"/>Kintu Peter dur pora Jisu laga piche korise aru moha purohit laga bisar kora jagate jaise. <verse eid="MAT 26:58"/><verse number="59" style="v" sid="MAT 26:59"/>Etiya moha purohit aru tai laga sabha manu khan Jisu ke morai dibo koi kene misa gawahi dibole manu bisari thakise. <verse eid="MAT 26:59"/><verse number="60" style="v" sid="MAT 26:60"/>Taikhan ekjon bhi pa-a nai, etu laga age te bisi misa laga gawahi dibole khan thakisele. Kintu pichete khali duijon he age te ahise, <verse eid="MAT 26:60"/><verse number="61" style="v" sid="MAT 26:61"/>Aru koise, “Etu manu koise, ‘Moi etu Isor laga girja ghor ke bhangai kene aru tin dinte bonai dibo pare.’” <verse eid="MAT 26:61"/><verse number="62" style="v" sid="MAT 26:62"/>Utu dangor purohit khara kori kene Taike koise, “Apuni logote eku jowab nai? Eitu khan ki ase taikhan pora Apuni uporte gawahi di thaka to?” <verse eid="MAT 26:62"/><verse number="63" style="v" sid="MAT 26:63"/>Kintu Jisu chup chap thakise. Aru dangor purohit Taike koise, “Moi jinda Isor laga naam pora apuni ke hukum di ase, Apuni amikhan ke kobi Apuni Isor laga Putro, Khrista to ase na nohoi.” <verse eid="MAT 26:63"/><verse number="64" style="v" sid="MAT 26:64"/>Jisu taikhan ke jowab dise, “Tumi nijor pora he koi dise. Kintu Moi tumike koi ase, etiya pora tumikhan Manu laga Putro ke Hokti laga dyna hathte bohi thaka dikhibo, aru akas laga badal uporte aha dikhibo.” <verse eid="MAT 26:64"/><verse number="65" style="v" sid="MAT 26:65"/>Etu pichete moha purohit bisi ghusa hoi kene tai laga kapra phataise, aru koise, “Etu manu Isor laga bodnam korise! Amikhan aru ki etiya gawahi lage? Sabi, etiya amikhan sob Isor laga bodnam huni loise. <verse eid="MAT 26:65"/><verse number="66" style="v" sid="MAT 26:66"/>Tumikhan laga ki bhabona ase?” Taikhan jowab dikene koise, “Tai to mora he thik hobo.” <verse eid="MAT 26:66"/><verse number="67" style="v" sid="MAT 26:67"/>Etu pichete taikhan Jisu laga chehera te thuki se aru Taike marise, aru kunba khan to thapor marise, <verse eid="MAT 26:67"/><verse number="68" style="v" sid="MAT 26:68"/>eneka koi kene, “Amikhan ke bhabobani koribi, tumi Khrista. Kun pora tumike mari ase?”<verse eid="MAT 26:68"/></para>
  <para style="s">Peter Pora Jisu Ke Ashikar Kora</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69"/>Etiya, Peter to ghor bahar te bohi thakise, aru ekjon nokor chukri tai usorte ahise aru koise, “Tumi bhi Jisu logote Galilee te thakise.” <verse eid="MAT 26:69"/><verse number="70" style="v" sid="MAT 26:70"/>Kintu tai sob laga usorte nohoi koise, “Tumi ki laga kotha kori ase moi najane.” <verse eid="MAT 26:70"/><verse number="71" style="v" sid="MAT 26:71"/>Jitia tai dorja laga bahar te ulaise, dusra ekjon nokorni taike dikhise aru manu khan ke koise, “Etu manu bhi Nazareth Jisu logote thakise.” <verse eid="MAT 26:71"/><verse number="72" style="v" sid="MAT 26:72"/>Tai aru bhi nohoi koi kene kosom khaise, “Moi etu manu ke najane!” <verse eid="MAT 26:72"/><verse number="73" style="v" sid="MAT 26:73"/>Aru olop deri pichete jun khan ta te khara thakise, taikhan ahikena Peter ke koise, “Hosa pora tumi bhi taikhan majote ekjon ase, tumi laga kotha kora pora he bujhi jaise.” <verse eid="MAT 26:73"/><verse number="74" style="v" sid="MAT 26:74"/>Etu pichete tai kosom dise aru khaise, “Ami etu manu ke najane,” aru loge-loge murga hala korise. <verse eid="MAT 26:74"/><verse number="75" style="v" sid="MAT 26:75"/>Etu pichete Peter Jisu pora ki hoise le etu yaad korise, “Murga hala nakora age te tumi Moike tin bar najane kobo.” Eneka hoi kene tai bahar te ulaise aru bisi mon tita hoi kene kandise.<verse eid="MAT 26:75"/></para>
  <chapter eid="MAT 26"/>
  <chapter number="27" style="c" sid="MAT 27"/>
  <para style="s">Pilate Logot Jisu Ke Diya</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1"/>Kitia phojur hoise, sob moha purohit khan aru bura khan mili kene Jisu ke morai dibole kotha milai thakise. <verse eid="MAT 27:1"/><verse number="2" style="v" sid="MAT 27:2"/>Taikhan Jisu ke bandi kene loi jaise, aru Governor Pilate laga hathte dise.<verse eid="MAT 27:2"/></para>
  <para style="s">Judas Fansi Kora</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3"/>Etu pichete Judas, jun pora Jisu ke thogaise, Jisu ke bodnam kora dikhise, aru tai mon ghurai kene trista chandi laga sikka moha purohit khan aru bura khan ke eneka koi kene wapas kori dise, <verse eid="MAT 27:3"/><verse number="4" style="v" sid="MAT 27:4"/>“Moi ekjon eku golti nathaka laga khun ke thogai dise.” Kintu taikhan koise, “Utu ki ase amikhan nimite? Nijor pora sai lobi.” <verse eid="MAT 27:4"/><verse number="5" style="v" sid="MAT 27:5"/>Titia tai chandi laga sikka khan mondoli te phelai dise, aru bahar te ulai jai kene nijorke fansi lagai kene mori jaise. <verse eid="MAT 27:5"/><verse number="6" style="v" sid="MAT 27:6"/>Titia moha purohit khan chandi laga sikka khan loi kene koise, “Etu chandi laga sikka khan tijori te rakhibole niyom nai, kelemane etu sikka khun laga daam te diya hoise.” <verse eid="MAT 27:6"/><verse number="7" style="v" sid="MAT 27:7"/>Taikhan sob eke logote mili kene kotha korise aru etu poisa loi kene mati kinise aru etu jaga to nachina manu khan laga kobor nimite rakhise. <verse eid="MAT 27:7"/><verse number="8" style="v" sid="MAT 27:8"/>Etu karone, aji tak etu mati ke, “Khun laga Kheti” koi kene rakhi ase. <verse eid="MAT 27:8"/><verse number="9" style="v" sid="MAT 27:9"/>Jeremiah bhabobadi pora ki kotha koi disele etu sob purah hoi jaise, “Taikhan trista chandi laga sikka loise, aru Israel laga bacha khan pora tai uporte etu daam rakhidise,<note caller="+" style="f"><char style="fr" closed="false">27.9 </char><char style="ft" closed="false">Zech. 11:12-13</char></note> <verse eid="MAT 27:9"/><verse number="10" style="v" sid="MAT 27:10"/>aru taikhan etu loi kene mati kini loise, Probhu pora jineka moike koi diya nisena.”<verse eid="MAT 27:10"/></para>
  <para style="s">Pilate Age Te Jisu</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11"/>Titia Jisu Governor usorte khara korise aru tai pora Jisu ke hudise, eneka koi kene, “Apuni Yehudi khan laga Raja ase naki?” Jisu taike jowab dise, “Apuni he koise.” <verse eid="MAT 27:11"/><verse number="12" style="v" sid="MAT 27:12"/>Kintu jitia moha purohit aru bura khan pora Jisu ke doshi dise, Tai eku jowab diya nai. <verse eid="MAT 27:12"/><verse number="13" style="v" sid="MAT 27:13"/>Etu pichete Pilate Jisu ke koise, “Apuni uporte bodnam khan ani kene diya to Apuni huna nai naki? <verse eid="MAT 27:13"/><verse number="14" style="v" sid="MAT 27:14"/>Kintu Jisu taike jowab diya nai, Taike bodnam kora khan ke bhi, titia Governor etu dikhi kene bisi asurit lagise.<verse eid="MAT 27:14"/></para>
  <para style="s">Ginti Napara Manu Khan Pora Barabbas Ke Bachaise</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15"/>Etiya dangor kha luwa laga niyom hisab te manu khan nimite Governor pora taikhan ke bondhi ghor pora chari dibole mon kore taikhan basi lobo pare. <verse eid="MAT 27:15"/><verse number="16" style="v" sid="MAT 27:16"/>Etu somoite taikhan logote ekjon bisi biya koidi Barabbas koi kene thakise. <verse eid="MAT 27:16"/><verse number="17" style="v" sid="MAT 27:17"/>Jitia taikhan sob eke logote joma hoise, Pilate taikhan ke koise, “Tumikhan nimite kunke chari dibo? Barabbas na Jisu junke Khrista mate?” <verse eid="MAT 27:17"/><verse number="18" style="v" sid="MAT 27:18"/>Kilekoile Pilate jani thakise taikhan Jisu ke ghin kora nimite tai laga hathte dise. <verse eid="MAT 27:18"/><verse number="19" style="v" sid="MAT 27:19"/>Kintu jitia tai bisar kora jagate bohi thakise, tai laga maiki pora kotha pathai kene koise, “Etu golti nathaka manu logote eku na koribi, kelemane moi aji Jisu laga sapna dikhi kene bisi dukh pai ase.” <verse eid="MAT 27:19"/><verse number="20" style="v" sid="MAT 27:20"/>Titia mukhyo purohit khan aru bura khan pora ta te joma thaka manu khan ke Barabbas ke chari dibole nimite koise, aru bodli te Jisu ke morai dibole mangise. <verse eid="MAT 27:20"/><verse number="21" style="v" sid="MAT 27:21"/>Titia governor pora jowab dikene taikhan ke koise, “Etu duijon majot te moi pora junke kunke chari dibole tumikhan laga itcha ase?” Taikhan koise, “Barabbas.” <verse eid="MAT 27:21"/><verse number="22" style="v" sid="MAT 27:22"/>Pilate taikhan ke koise, “Tinehoile moi etu Jisu kun Khrista ase koi tai logote ki koribo?” Taikhan sob jowab dise, “Taike Cross te morai dibi.” <verse eid="MAT 27:22"/><verse number="23" style="v" sid="MAT 27:23"/>Titia tai koise, “Kile, Tai ki laga golti kaam korise?” Kintu taikhan jor pora hala kori kene koise, “Taike Cross te mari dibi.”<verse eid="MAT 27:23"/></para>
  <para style="s">Jisu Ke Cross Te Morai Dibole Pilate Pora Hukum Diya</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24"/>Jitia Pilate dikhise tai aru eku kori bole napara hoise, aru manu khan pora dangor jhagara ulai dibo koi kene jani loise, etu pora tai manu khan usorte hath dhulaise aru koise, “Etu manu laga khun nimite moi laga eku golti nai, tumikhan nijor pora he sai lobi.” <verse eid="MAT 27:24"/><verse number="25" style="v" sid="MAT 27:25"/>Sob manu khan jowab dikene koise, “Tai laga khun to amikhan aru amikhan laga bacha khan uporte ahibole dibi.” <verse eid="MAT 27:25"/><verse number="26" style="v" sid="MAT 27:26"/>Titia Barabbas ke taikhan nimite chari dise kintu tai Jisu ke mari kene dukh diya pichete Taike Cross te morai dibo khan nimite di dise.<verse eid="MAT 27:26"/></para>
  <para style="s">Jisu Ke Ninda Kora</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27"/>Titia Governor laga sipahi khan Jisu ke Governor logote loi jaise jun jagate sipahi khan joma kori kene thakise. <verse eid="MAT 27:27"/><verse number="28" style="v" sid="MAT 27:28"/>Taikhan Jisu laga kapra ulai dise aru sundur rong laga kapra Taike pindhai dise. <verse eid="MAT 27:28"/><verse number="29" style="v" sid="MAT 27:29"/>Aru kata laga mukut bonaikena Tai laga matha te lagai dise aru dyna hathte ekta lathi dhori bole dise. <verse eid="MAT 27:29"/><verse number="30" style="v" sid="MAT 27:30"/>Taikhan Jisu usorte athukari loise aru taike sorom khilai dise, aru matha te mari dikene eneka koise, “Hey Yehudi laga Raja!” <verse eid="MAT 27:30"/><verse number="31" style="v" sid="MAT 27:31"/>Jitia taikhan Jisu ke sorom khilai dise, taikhan kapra ulai loise aru tai laga nijor kapra aru lagai dise, aru Cross te mari dibole nimite loi jaise.<verse eid="MAT 27:31"/></para>
  <para style="s">Cross Te Morai Diya</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32"/>Jitia taikhan bahar te ulai ahise, ekjon Cyrene sheher pora Simon koi kene paise, junke taikhan Cross bukhi bole dise. <verse eid="MAT 27:32"/><verse number="33" style="v" sid="MAT 27:33"/>Taikhan Golgotha koi kene ekta jagate ahise, etu motlob to “Matha Laga Hardi Jaga.” <verse eid="MAT 27:33"/><verse number="34" style="v" sid="MAT 27:34"/>Taikhan Jisu ke dawai milai kene thaka draikha ros khabole dise. Kintu jitia Tai etu jiba te chati saise, Tai etu khabo para nai. <verse eid="MAT 27:34"/><verse number="35" style="v" sid="MAT 27:35"/>Jitia taikhan Jisu ke Cross te mari dise, taikhan Jisu laga kapra khan chithi khili kene bhag kori loise,<note caller="+" style="f"><char style="fr" closed="false">27.35 </char><char style="ft" closed="false">Ps. 22:18</char></note> <verse eid="MAT 27:35"/><verse number="36" style="v" sid="MAT 27:36"/>aru taikhan ta te bohi kene Jisu ke rukhi thakise. <verse eid="MAT 27:36"/><verse number="37" style="v" sid="MAT 27:37"/>Aru Jisu laga matha uporte taikhan eneka likhi dise, “Etu Jisu ase, Yehudi jati laga Raja.” <verse eid="MAT 27:37"/><verse number="38" style="v" sid="MAT 27:38"/>Etu pichete utu duita chor ke Jisu logote Cross te mari dise, ekjon Tai laga dyna phale aru ekjon ke Tai laga baya phale. <verse eid="MAT 27:38"/><verse number="39" style="v" sid="MAT 27:39"/>Jun manu etu paar kori kene jai taikhan Jisu ke dikhi kene sorom khilai diye aru taikhan laga matha hilai kene hath milai, <verse eid="MAT 27:39"/><verse number="40" style="v" sid="MAT 27:40"/>aru eneka koi kene, “Tumi jun Isor laga mondoli ke bhangai kene tin din pichete bonai dibo thakise, nijorke bachabi! Jodi Tumi Isor laga Putro ase koile, Cross pora namikene ahibi!” <verse eid="MAT 27:40"/><verse number="41" style="v" sid="MAT 27:41"/>Etu nisena moha purohit khan bhi Jisu ke sorom khilai dise, aru taikhan logote niyom jana manu aru cholawta khan bhi thakise, aru koise, <verse eid="MAT 27:41"/><verse number="42" style="v" sid="MAT 27:42"/>“Tai dusra manu khan ke bachai dise, kintu Nijorke bacha bole para nai. Tai Israel desh laga Raja ase. Taike Cross pora namikene ahibo dibi, aru etu pichete amikhan Taike biswas koribo. <verse eid="MAT 27:42"/><verse number="43" style="v" sid="MAT 27:43"/>Tai Isor ke biswas kore, Isor ke Taike bacha bole dibi etiya, jodi Isor Taike lage koile. Kile mane Tai koise, ‘Moi Isor laga Putro ase.’” <verse eid="MAT 27:43"/><verse number="44" style="v" sid="MAT 27:44"/>Etu nisena chor duita jun Jisu logote Cross te mari dise, tai bhi Jisu ke sorom khilai diya laga kotha koise.<verse eid="MAT 27:44"/></para>
  <para style="s">Jisu Mora</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45"/>Aru jitia choi ghanta hoise pura desh te andhera ahi jaise aru pura nou ghanta nohua tak andhera thakise. <verse eid="MAT 27:45"/><verse number="46" style="v" sid="MAT 27:46"/>Jitia tin baji hoise, Jisu ekdom jor pora eneka koi kene kandise, “Eli, Eli, lama sabachthani?” Etu mane, “Ami laga Isor, Ami laga Isor, Apuni kele Moike chari dise?<note caller="+" style="f"><char style="fr" closed="false">27.46 </char><char style="ft" closed="false">Ps. 22:1</char></note>” <verse eid="MAT 27:46"/><verse number="47" style="v" sid="MAT 27:47"/>Jitia ta te khara kori thaka manu khan etu kotha hunise, taikhan koise, “Tai Elijah ke mati ase.” <verse eid="MAT 27:47"/><verse number="48" style="v" sid="MAT 27:48"/>Titia ekjon manu polai jai kene norom kapra te tenga ros pani pora bhorta hoi kene thaka loi kene anise, aru ekta lamba ghar laga khuri te lagase, aru taike dikene Jisu ke khila bole dise. <verse eid="MAT 27:48"/><verse number="49" style="v" sid="MAT 27:49"/>Ta te thaka manu khan pora koise, “Taike ekla chari di bhi. Moi khan sabo jodi Elijah ahikena Taike bachai na nai.” <verse eid="MAT 27:49"/><verse number="50" style="v" sid="MAT 27:50"/>Etu pichete Jisu aru bhi hala kori kene jor pora kandise aru Tai laga atma ke chari dise. <verse eid="MAT 27:50"/><verse number="51" style="v" sid="MAT 27:51"/>Etu somoite, mondoli laga purdah upor pora loi kene niche tak dui bhag hoi kene phatise, aru matise, aru pathor khan bhi bhangi kene adha hoi jaise. <verse eid="MAT 27:51"/><verse number="52" style="v" sid="MAT 27:52"/>Aru Isor laga manu kunkhan ghumai jaise, taikhan laga kobor khuli jaise aru taikhan uthijaise. <verse eid="MAT 27:52"/><verse number="53" style="v" sid="MAT 27:53"/>Taikhan Jisu jinda huwa pichete kobor pora ulaikene ahise, pobitro sheher Jerusalem te ghusi se, aru bisi manu ke dikhai dise. <verse eid="MAT 27:53"/><verse number="54" style="v" sid="MAT 27:54"/>Aru jitia sipahi aru kun tai logote thaki kene Jisu ke sai thakise, mati hila aru ki hoise etu dikhise, taikhan bisi bhoi lagise aru koise, “Hosa pora etu manu to Isor laga Putro thakise.” <verse eid="MAT 27:54"/><verse number="55" style="v" sid="MAT 27:55"/>Aru bisi maiki khan jun Jisu laga pichete Galilee pora berai thakisele taikhan ta te thakise aru dur pora Jisu ke sai thakise. <verse eid="MAT 27:55"/><verse number="56" style="v" sid="MAT 27:56"/>Taikhan majote Mary Magdalene, Joseph aru James laga ama Mary, aru Zebedee laga chokra khan laga ama bhi thakise.<verse eid="MAT 27:56"/></para>
  <para style="s">Jisu Ke Kobor Dise</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57"/>Jitia saam hoise, ekjon dhuni manu Joseph koi kene Arimathea bosti pora ahise, tai bhi Jisu laga chela thakisele. <verse eid="MAT 27:57"/><verse number="58" style="v" sid="MAT 27:58"/>Tai Pilate usorte jai kene Jisu laga gaw to mangise. Etu pichete Pilate pora hukum dikene taike dise. <verse eid="MAT 27:58"/><verse number="59" style="v" sid="MAT 27:59"/>Aru Joseph pora Jisu laga gaw to loise, aru mihin kapra pora bandhi dise. <verse eid="MAT 27:59"/><verse number="60" style="v" sid="MAT 27:60"/>Aru tai nijor laga notun kobor te rakhidise, juntu tai pathor kati kene rakhi thakisele. Etu pichete tai ekta dangor chaka nisena pathor pora kobor to bondh kori dise aru tai jai jaise. <verse eid="MAT 27:60"/><verse number="61" style="v" sid="MAT 27:61"/>Mary Magdalene aru dusra Mary bhi ta te thakise, kobor laga utu phale bohi thakise.<verse eid="MAT 27:61"/></para>
  <para style="s">Koboristan Te Rukhi Thaka Sipahi khan</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62"/>Dusra din, juntu din to Taiyar Kora din<note caller="+" style="f"><char style="fr" closed="false">27.62 </char><char style="ft" closed="false">Bisram Din laga ek din age ke etu mate.</char></note> pichete thakise, maha purohit khan aru Pharisee khan eke logote Pilate usorte joma hoi kene thakise. <verse eid="MAT 27:62"/><verse number="63" style="v" sid="MAT 27:63"/>Taikhan koise, “Sahab, amikhan yaad ase jitia utu thogai diya manu jinda thaka somoite, tai koise, ‘Tin din pichete moi jinda hobo.’ <verse eid="MAT 27:63"/><verse number="64" style="v" sid="MAT 27:64"/>Etu karone hukum dibi, tin din tak etu kobor to bhal kori kene pehera dibole nimite, nohoile Tai laga chela khan ahikena chor kori loijabo, aru manu khan ke kobo, ‘Tai mora pora jinda hoi jaise.’ Aru poila pora bhi etiya laga kotha to bisi hoi jabo.” <verse eid="MAT 27:64"/><verse number="65" style="v" sid="MAT 27:65"/>Pilate taikhan ke koise, “Ekjon sipahi ke lobi. Jabi aru tumi kineka pora pehera lagabo paribo, etu nisena koribi.” <verse eid="MAT 27:65"/><verse number="66" style="v" sid="MAT 27:66"/>Titia taikhan jai kene kobor ke bhal pora pehera dise, pathor te mohor marikena sipahi khan ke rukhibo dise.<verse eid="MAT 27:66"/></para>
  <chapter eid="MAT 27"/>
  <chapter number="28" style="c" sid="MAT 28"/>
  <para style="s">Punoruthan Huwa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1"/>Etiya Bisram din khotom hobole hoise, jitia hapta laga poila din ulai thakise, Mary Magdalene aru dusra Mary kobor sabole ahise. <verse eid="MAT 28:1"/><verse number="2" style="v" sid="MAT 28:2"/>Aru sabi, ta te bisi dangor mati hili se, kele koile Probhu laga ekjon sorgodoth sorgo pora nichete namise, aru pathor ke ghurai kene hatai dise, aru etu uporte bohi jaise. <verse eid="MAT 28:2"/><verse number="3" style="v" sid="MAT 28:3"/>Tai laga chehera to bhijili nisena, aru tai laga kapra to borop nisena boga thakise. <verse eid="MAT 28:3"/><verse number="4" style="v" sid="MAT 28:4"/>Kobor rukhi thaka sipahi khan dikhi kene bhoi pora hili jaise aru taikhan mora manu nisena hoi jaise. <verse eid="MAT 28:4"/><verse number="5" style="v" sid="MAT 28:5"/>Kintu utu sorgodoth kotha kori kene maiki khan ke koise, “Bhoi na koribi, kele koile moi jani ase tumikhan Jisu ke bisari bole ahise, junke Cross te mari disele. <verse eid="MAT 28:5"/><verse number="6" style="v" sid="MAT 28:6"/>Tai yate nai, kintu jinda hoise, jineka Tai pora koise. Ahi kene sabi juntu jagate Taike rakhi sele. <verse eid="MAT 28:6"/><verse number="7" style="v" sid="MAT 28:7"/>Joldi jabi aru chela khan ke kobi, ‘Tai to mora pora jinda hoise. Sabi, Tai Galilee te tumikhan age jai ase. Ta te tumikhan Taike dikhibo.’ Sabi, Moi tumikhan ke koi dise.” <verse eid="MAT 28:7"/><verse number="8" style="v" sid="MAT 28:8"/>Mahila khan dangor bhoi aru khushi pora kobor ke chari kene joldi jaise, aru chela khan ke kobole nimite polaikene jaise. <verse eid="MAT 28:8"/><verse number="9" style="v" sid="MAT 28:9"/>Sabi, Jisu taikhan ke lok paise, eneka koi kene, “Salam! Apuni logote shanti thakibi!” Utu mahila khan ahikena Tai laga theng dhuri kene Taike aradhana korise. <verse eid="MAT 28:9"/><verse number="10" style="v" sid="MAT 28:10"/>Etu pichete Jisu taikhan ke koise, “Bhoi nakuribi. Jabi jai kene Moi laga bhai-kokai khan ke Galilee te jabole kobi. Ta te taikhan Moike dikhibo.”<verse eid="MAT 28:10"/></para>
  <para style="s">Sipahi khan Laga Khobor</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11"/>Jitia mahila khan jai thakise, titia, kunba sipahi khan sheher te jaise aru moha purohitkhan ke ki hoise sob koi dise. <verse eid="MAT 28:11"/><verse number="12" style="v" sid="MAT 28:12"/>Jitia taikhan bura khan ke lok korise aru taikhan ke bhi ki hoise etu koi dise, aru taikhan sipahi khan ke bisi poisa dise, <verse eid="MAT 28:12"/><verse number="13" style="v" sid="MAT 28:13"/>aru koise, “Eneka kobi, ‘Tai laga chela khan rati te ahikena Tai laga gaw chor korise, jitia amikhan ghumai thakise.’ <verse eid="MAT 28:13"/><verse number="14" style="v" sid="MAT 28:14"/>Jodi etu khobor Governor tak punchi jai, amikhan tai logote kotha koribo aru tumikhan uporte digdar ahibo nadibo.” <verse eid="MAT 28:14"/><verse number="15" style="v" sid="MAT 28:15"/>Titia sipahi khan poisa loise aru taikhan pora ki koise etu he koise. Etu laga kotha bisi Yehudi manu khan pora hunise aru aji tak etu kotha koi thake.<verse eid="MAT 28:15"/></para>
  <para style="s">Dangor Adhikar</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16"/>Kintu egaroh jon chela Galilee te jaise, ekta pahar te jun to Jisu pora ahibole koise. <verse eid="MAT 28:16"/><verse number="17" style="v" sid="MAT 28:17"/>Jitia taikhan Jisu ke dikhise, taikhan Taike aradhana korise, kintu kunba taikhan majote bhabona korise. <verse eid="MAT 28:17"/><verse number="18" style="v" sid="MAT 28:18"/>Jisu taikhan usorte ahise aru kotha korise aru koise, “Sob sorgo aru prithibi laga adhikar Moike dise. <verse eid="MAT 28:18"/><verse number="19" style="v" sid="MAT 28:19"/>Etu nimite jabi aru sob desh te Moi laga chela bonabi. Taikhan ke Baba, Putro aru Pobitro Atma laga naam pora baptizma dibi. <verse eid="MAT 28:19"/><verse number="20" style="v" sid="MAT 28:20"/>Taikhan ke Moi ki hukum dise eitu khan sikhai dibi. Etu janibi, Moi tumikhan logote hodai ase, etu jamana laga hekh din tak.”<verse eid="MAT 28:20"/></para>
  <chapter eid="MAT 28"/>
</usx>
