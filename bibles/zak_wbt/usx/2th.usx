<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2TH" style="id">- Zanaki 2 Thessalonians</book>
  <para style="h">2 Abhatesaronike</para>
  <para style="toc3">2 Abhatesaronike</para>
  <para style="toc2">2 Abhatesaronike</para>
  <para style="toc1">Enyaarubha ya kabhiri ya Pauro ku Bhatesaronike</para>
  <para style="mt2">Enyaarubha ya kabhiri ya Pauro ku</para>
  <para style="mt1">Bhatesaronike</para>
  <para style="imt">Obhutaangiro</para>
  <para style="ip">Kwiibhaga iguhi kweema Pauro atume enyaarubha yaaye yo okutaanga, akabhona amangʼana kubha, abhiikirirya bha Tesaronike bhatamenyeekereerye bhuzomu ameegyo gaaye agaandi. Abhaandi bhakiiseega kubha Yeesu yaari amariri kukyoora. Na abhaandi bhaari bhatigiri emirimo gyaabhu gyoosi, kwo okubha bhakiisiga kubha, Yeesu yaari arakyoora eriibhaga ryoryoosi. Abhaandi bhateendiri kukora emirimo kwe ekigirirye kyo obhutobhu. Kweego, Pauro akakaama enyaarubha yino ya kabhiri, okubha akyoosye amiiseego kya gayo, gano gataari no obhuheene. Munyaarubha yino ya kabhiri akakumiirirya kubha, Yeesu yaari akyaari kukyoora mukyaaro na akabhakumiirirya okugeenderera kukora emirimo kwo omukya.</para>
  <chapter number="1" style="c" sid="2TH 1"/>
  <para style="s">Obhukeerya</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1"/>Enyaarubha yino nikaamiri enye Pauro, hamwe na Sirwano<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="fk" closed="false">Sirwano </char><char style="ft" closed="false">mukitabhu kya Amahokya ga Abheega arabhirikirwa </char><char style="fqa" closed="false">Siira.</char></note> na Timoteo, tubhakaamiiri emwe abhiikirirya na abhahoreeru abhaandi bhoosi, mumwiikiriirye Taatabhugya Taata weetu no Omukuru Yeesu Krisito bhano mukwiikara mumugye gwa Tesaronike.<verse eid="2TH 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2TH 1:2"/>Orubhaango no omureembe okurwa ku Taata Taatabhugya no Omukuru Yeesu Krisito bhibhe neemwe.<verse eid="2TH 1:2"/></para>
  <para style="s">Abhiikirirya bhatoongerwe ekoro hano bhakunyaaka</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3"/>Abhahiiri bheetu, ereenderwa tubhuge, “Ozomirye, Taatabhugya,” eriibhaga ryoosi kwiiguru weenyu, kwo okubha obhwiikirirya bhweenyu bhurakura bhukongʼu, kweeki okuseegana kweenyu kurageenderera kukura. <verse eid="2TH 1:3"/><verse number="4" style="v" sid="2TH 1:4"/>Kweego, turiikumya mumakanisa ga Taatabhugya kwe ekigirirye kyo okwiikongʼeererya no obhwiikirirya bhweenyu, munyaako yoosi yino mukubhona.<verse eid="2TH 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 1:5"/>Gayo goosi gareerekya kubha, obhutini bhwe ekiina kya Taatabhugya ni bhwe eheene. Na kwe ekigirirye kiyo, emwe murabharwa kubha mureenderwa mubhutemi bhwaaye,<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="fk" closed="false">Obhutemi bhwaaye </char><char style="ft" closed="false">ni hagiro hayo hoosi hano Taatabhugya niwe omukaangati. Rora </char><char style="it">obhutemi bhwa Taatabhugya</char> mu Bhugaruri bhwa Amangʼana Amakongʼu.</note> bhuno mukunyaakira. <verse eid="2TH 1:5"/><verse number="6" style="v" sid="2TH 1:6"/>Taatabhugya arakora ge eheene, ewe arabhaha enyaako bhano bhakubhanyaakya emwe, <verse eid="2TH 1:6"/><verse number="7" style="v" sid="2TH 1:7"/>na arabhaha obhumuunyi emwe bhano mukunyaaka, hamwe neetwe. Arakora gayo hano Omukuru Yeesu araaze okurwa mwiisaaro hamwe na bhamaraika<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="fk" closed="false">Bhamaraika</char><char style="ft" closed="false">. Rora engʼana </char><char style="it">maraika</char> mu Bhugaruri bhwa Amangʼana Amakongʼu.</note> bhaaye bha amanaga, <verse eid="2TH 1:7"/><verse number="8" style="v" sid="2TH 1:8"/>mumireengeeri gyo omuriro. Yeesu niwe arabhatema bhoosi bhano bhakumwaanga Taatabhugya na bhano bhatakwiigwa Amangʼana Amazomu go Omukuru weetu Yeesu. <verse eid="2TH 1:8"/><verse number="9" style="v" sid="2TH 1:9"/>Obhutemwa bhwaabhu bhurabha bhwo okusikibhwa kirakeego, no okutuurwa kure no Omukuru no obhuguungo bhwaaye obhukuru. <verse eid="2TH 1:9"/><verse number="10" style="v" sid="2TH 1:10"/>Obhutemwa bhuyo bhurabha orusiku rurya Omukuru araaze kuguungibhwa na abhahoreeru<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="fk" closed="false">Abhahoreeru</char><char style="ft" closed="false">. Rora engʼana yino mu Bhugaruri bhwa Amangʼana Amakongʼu.</char></note> bhaaye, no okusuungʼaana obhusuuku bhwoosi okurwa kubhoosi bhano bhamwiikiriirye. Neemwe mwoosi murabha gati waabhu, kwo okubha mwiikiriirye amangʼana gano tukabhabhuurira.<verse eid="2TH 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 1:11"/>Kwe ekigirirye kiyo, turabhasabhira eriibhaga ryoosi, kubha Taatabhugya weetu abhasakirye okwiikara kyeego ekweenderwa mubhubhirikirwa bhweenyu. Kweeki turamusabha kubha, amare amangʼana amazomu goosi gano mukweenda kukora, ne emirimo gyeenyu gyoosi gyo obhwiikirirya. <verse eid="2TH 1:11"/><verse number="12" style="v" sid="2TH 1:12"/>Turasabha ego, okubha eriina ryo Omukuru weetu Yeesu ribhe riraguungibhwa kwe ekigirirye kyeenyu. Kweeki neemwe mubhe muraguungibhwa kwe ekigirirye kyaaye. Gano garatuukana no orubhaango rwa Taatabhugya weetu no Omukuru Yeesu Krisito.<verse eid="2TH 1:12"/></para>
  <chapter eid="2TH 1"/>
  <chapter number="2" style="c" sid="2TH 2"/>
  <para style="s">Omukuru Yeesu araaza okubha amusikye omwaangi</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1"/>Bhoono abhahiiri bheetu, turabhakaamira iguru yo okuuza kwo Omukuru weetu Yeesu Krisito, na kyeego turiikumanie kweewe.<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="xt" closed="false">Rora <ref loc="1TH 4:17">1 Abhatesaronike 4:17</ref>.</char></note> Turabhasabha kubha, <verse eid="2TH 2:1"/><verse number="2" style="v" sid="2TH 2:2"/>mutiitiimaata bhwaangu no okubha ne ehaho orusiku rwo okuuza kwo Omukuru ruhikiri. Hamwe mwiigwiiri ego, okurwa mumangʼana amarebhe go obhurooti, kasi go okurwaaza, kasi enyaarubha yino eriiseegwa kubha erwiiri oweetu. <verse eid="2TH 2:2"/><verse number="3" style="v" sid="2TH 2:3"/>Mutiikirirya muutu wowoosi abhakaangirirye kuryoryoosi rirya, kwo okubha orusiku ruyo rutakuhika, tee eziisiku zirya abhaatu bhaaru bharaamwaange Taatabhugya, hano omwaangi wurya<note caller="+" style="f"><char style="fr" closed="false">2:3 </char><char style="ft" closed="false">Obhugazuro bhwo </char><char style="fk" closed="false">omwaangi wurya </char><char style="ft" closed="false">ni mwaangi wa Krisito na wuno akusarya emigiro gya Taatabhugya gyoosi. Omwaangi wuno atari Seetaani, nawe woosi arakora omukoonyo gwo okumwaanga Taatabhugya. Rora engʼana </char><char style="it">Seetaani</char> mu Bhugaruri bhwa Amangʼana Amakongʼu.</note> araarorekane kubhweero. Niwe wuyo araasikibhwe kubhuteero. <verse eid="2TH 2:3"/><verse number="4" style="v" sid="2TH 2:4"/>Ewe araanga ebhigiro bhyoosi bhino abhaatu bhararora kubha ni isaambwa, kasi bhino bhakuseengera, na ariituura iguru ya bhyoosi. Kweeki arasikira no okwiikara mwiiseengerero rya Taatabhugya no okwiikora kubha ewe niwe Taatabhugya.<verse eid="2TH 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 2:5"/>Mutakuhiita kubha, hano niari hamwe neemwe, nikabhabhuurira gayo goosi? <verse eid="2TH 2:5"/><verse number="6" style="v" sid="2TH 2:6"/>Na mumenyiri kino kikumweerekya bhoono ego, okubha arorekane kwiibhaga rino rikweenderwa. <verse eid="2TH 2:6"/><verse number="7" style="v" sid="2TH 2:7"/>Naabhe bhoono, omwaangi wuyo arakora emirimo eno yiibhisiri. Nawe atakurorekana tee wuno akumurekya okukora emirimo kubhweero araaruusibhweho. <verse eid="2TH 2:7"/><verse number="8" style="v" sid="2TH 2:8"/>Hayo niho omwaangi wuyo araarorekane. Nawe Omukuru Yeesu hano araaze, aramwiita no omwiika okurwa mumunwa gwaaye, na aramusikya kwo obhuguungo bhwo okuuza kweewe.<verse eid="2TH 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2TH 2:9"/>Eriibhaga ryo okuuza kwaaye, omwaangi wuyo, araaza na amanaga goosi ga Seetaani no okukora ebhyeerekenio ne ebhitiika bhyo orurimi. <verse eid="2TH 2:9"/><verse number="10" style="v" sid="2TH 2:10"/>Arabhakaangirirya kwe eziinzira nzaru, bhoosi bhano bhari munzira yo okubhura, kwo okubha bhatakwiikirirya kuseega obhuheene okubha bhatuuribhwe. <verse eid="2TH 2:10"/><verse number="11" style="v" sid="2TH 2:11"/>Kweego Taatabhugya abhaheeri omweeya bhakaangatwe no obhunagya bhwo okubhabhurya, okubha bhageenderere okwiikirirya orurimi. <verse eid="2TH 2:11"/><verse number="12" style="v" sid="2TH 2:12"/>Hayo, bhoosi bhano bhatakwiikirirya obhuheene, nawe bharazomererwa ebhibhi, bharatinirwa ekiina.<verse eid="2TH 2:12"/></para>
  <para style="s">Okwiimeerera mubhugumiru no okugwaata ameegyo</para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13"/>Nawe etwe, tureenderwa tumubhuurire Taatabhugya, “Ozomirye,” eriibhaga ryoosi kwiiguru weenyu, emwe abhahiiri bheetu bhano museegirwe no Omukuru Yeesu. Tureenderwa kukora ego, kwo okubha Taatabhugya akabhasora emwe okurwa obhweemero bhwo kubhuumbwa, okubha mutuuribhwe. Obhutuuribhwa bhuyo mubhusuungʼaaniri kwe Ekoro Muhoreeru wuno abheerirye, na kwo okwiikirirya obhuheene. <verse eid="2TH 2:13"/><verse number="14" style="v" sid="2TH 2:14"/>Taatabhugya akabhabhirikira, okubha mutuuribhwe kwe enzira ya Amangʼana Amazomu gano twaabharwaaziiri oweenyu. Abhabhirikiiri okubha mubhone okwiisaangya mubhuguungo bhwo Omukuru weetu Yeesu Krisito. <verse eid="2TH 2:14"/><verse number="15" style="v" sid="2TH 2:15"/>Bhoono abhahiiri bheetu, mwiimeerere bhugumiru no okugwaata ameegyo gano mukasuungʼaana, eraabhe ni kwo obhurwaazi bhweetu, kasi kwe eziinyaarubha zyeetu.<verse eid="2TH 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 2:16"/>Taata weetu Taatabhugya atuseegiri, na kwo orubhaango rwaaye aratugosorerya kirakeego no okutuha eriisigo eriizomu. Turamusabha ewe hamwe no Omukuru weetu Yeesu Krisito kubha, <verse eid="2TH 2:16"/><verse number="17" style="v" sid="2TH 2:17"/>abhagosorerye eziikoro no okubhagumirya, okubha mubhone okugaamba no okukora amangʼana goosi amazomu.<verse eid="2TH 2:17"/></para>
  <chapter eid="2TH 2"/>
  <chapter number="3" style="c" sid="2TH 3"/>
  <para style="s">Pauro na abharikyaaye bharasabha amasabhi</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1"/>Bhoono abhahiiri bheetu, mutusabhire okubha Amangʼana iguru wo Omukuru Yeesu gageenderere kunyaragana bhwaangu, okubha abhaatu bhagasuungʼaane kwo obhusuuku, kyeego gaari kweemwe. <verse eid="2TH 3:1"/><verse number="2" style="v" sid="2TH 3:2"/>Mutusabhire okubha Taatabhugya atutuurye mubhaatu abhabhi na bhe ebhibhi, kwo okubha etari bhoosi bhano bhakwiikirirya amangʼana gayo. <verse eid="2TH 3:2"/><verse number="3" style="v" sid="2TH 3:3"/>Nawe Omukuru Yeesu ni muheene, ewe arabhagumirya emwe no okubhariibha na Seetaani, omubhi wurya. <verse eid="2TH 3:3"/><verse number="4" style="v" sid="2TH 3:4"/>Neewe Omukuru aratuha eriisigo ikuru iguru weenyu, kubha bhoono murakora gano tukabharagania, kweeki mukyageenderera okugakora. <verse eid="2TH 3:4"/><verse number="5" style="v" sid="2TH 3:5"/>Omukuru abhakaangate eziikoro zyeenyu mubhuseegi bhwa Taatabhugya no obhwiikongʼeererya bhuno bhukeerekibhwa na Krisito.<verse eid="2TH 3:5"/></para>
  <para style="s">Obhurekya iguru yo obhutobhu</para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6"/>Abhahiiri bheetu, turabharagania kwe eriina ryo Omukuru Yeesu Krisito kubha, mwiiriihe na abhahiiri bhoosi bhano ni bhatobhu, bhano bhatakugwaata ameegyo gano tukabhaha. <verse eid="2TH 3:6"/><verse number="7" style="v" sid="2TH 3:7"/>Turabhuga ego, kwo okubha emwe mumenyiri kyeego ekweenderwa okweega ekireengyo kyeetu. Hano twaari neemwe, tutaari bhatobhu, <verse eid="2TH 3:7"/><verse number="8" style="v" sid="2TH 3:8"/>kweeki twaari tutakurya ebhyaakurya kumuutu wowoosi bhusa. Nawe twaari turakora emirimo kwo omukya obhutiku no omwiisi, okubha tutamunyaakya muutu wowoosi kweemwe. <verse eid="2TH 3:8"/><verse number="9" style="v" sid="2TH 3:9"/>Tukakora ego, etari kubha tutakweenderwa okubhona ekigiro okurwa kweemwe, nawe tukeenda tubhe ekireengyo kweemwe okubha mutweege. <verse eid="2TH 3:9"/><verse number="10" style="v" sid="2TH 3:10"/>Kweeki hano twaari hamwe neemwe, tukabhaswaagya, “Muutu wowoosi wuno atakweenda okukora emirimo, atarya ebhyaakurya.”<verse eid="2TH 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 3:11"/>Tubhugiri amangʼana gayo, kwo okubha twiigwiiri bhariho abhaatu abhaandi oweenyu ni bhatobhu, bhatakukora kyokyoosi, nawe bhariisikirya mumangʼana ga abhaandi. <verse eid="2TH 3:11"/><verse number="12" style="v" sid="2TH 3:12"/>Abhaatu bhayo turabharagania no okubhatoongera kubhuturo bhwo Omukuru Yeesu Krisito kubha, bhabhe bharakora emirimo kwo obhusuuku, okubha bhabhone ebhyaakurya bhyaabhu abheene. <verse eid="2TH 3:12"/><verse number="13" style="v" sid="2TH 3:13"/>Nawe emwe abhahiiri bheetu, mutakwa emitwe okukora amazomu.<verse eid="2TH 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2TH 3:14"/>Kyeego omuutu wowoosi atakweenda okugwaata obhuswaagyo bhweetu, bhuno bhuri munyaarubha yino, mwiiriihe no omuutu wuyo. Mutagwaatana neewe, okubha arore eziisoni. <verse eid="2TH 3:14"/><verse number="15" style="v" sid="2TH 3:15"/>Nawe mutamurora kyo omubhisa, mubhe muramuhiinya kyo omurikyeenyu.<verse eid="2TH 3:15"/></para>
  <para style="s">Amangʼana go okuraga</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16"/>Bhoono, Omukuru Yeesu omweene, niwe esimuka yo omureembe, abhe arabhaha omureembe eriibhaga ryoosi muziinzira zyoosi. Omukuru abhe hamwe neemwe mwoosi. <verse eid="2TH 3:16"/><verse number="17" style="v" sid="2TH 3:17"/>Enye Pauro nirabhakaamira obhukeerya bhuno kwo okubhoko kwaane omweene. Runo nirwo orukaamo muziinyaarubha zyaane zyoosi, na niigo nikukaama.<verse eid="2TH 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2TH 3:18"/>Orubhaango rwo Omukuru weetu Yeesu Krisito, rubhe hamwe neemwe mwoosi.<verse eid="2TH 3:18"/></para>
  <chapter eid="2TH 3"/>
</usx>
