<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Toto</book>
  <para style="h">ফিলেমন</para>
  <para style="toc3">ফিলেমন</para>
  <para style="toc2">ফিলেমন</para>
  <para style="toc1">ফিলেমনহিং পাউলকো লাওয়া চিঠি</para>
  <para style="mt1">ফিলেমনহিং</para>
  <para style="mt2">পাউলকো লাওয়া চিঠি</para>
  <para style="imt">ন্যাইপাওয়া</para>
  <para style="ip">ফিলেমনহা ইচো টেবো মিং নিওয়া দেংওয়া দিংঙা নিমগা আসা আকুহা কোলোসি শহরকো দেংওয়া নিমি চুইরোওয়া। অৗনেসিমসহা আকো ডেইয়া নিমি, আকুহা গিরিকো সাসো ক্যাপুমসা রোম শহরতা দেকায়ে। আউতা আকুহা জেংওয়া পোইং পাউলহিং দোসুয়ে। আকু সময়তাহা পাউলহিংয়া জেলতা সুংপুমি নিমি। আকো দেংওয়াকো সোতারাং পাউলহা অৗনেসিমোসহিংয়া প্রভু ইশুতা পারামি নিমি। ই চিঠিতা পাউলহা ফিলেমনহিং আকো ডেইয়া অৗনেসিমোসহিং নিংপুদাংমি নিও তামসা জাংয়ে, আকুহা কাম বিগারেমি নিনাহা আকুহিং ছোমা জোপিকো জো আসা ডেইয়া বেপা মোকো, আদো দেংওয়া বেপা স্বাগত জোকো তামসা জাংচায়ে।</para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1" />ইশু খ্রীষ্টকো সোতা কৈদি জিংপুওয়া কা পাউল, আসা তিমোথীকোসো, কাবিকো জেজেংওয়া ব্যারো ফিলিমনহিং, <verse eid="PHM 1:1" /><verse number="2" style="v" sid="PHM 1:2" />আসা কাবিকো হুম্রি অপ্পিয়া আসা কাবিহিংপা সেওয়া জোওয়া অর্খিপ্পস, আসা নাকো সাতা জমা জিংওয়া সেংজাতা দেংওয়াবিহিং কা ই চিঠি লাদাংয়ো। <verse eid="PHM 1:2" /><verse number="3" style="v" sid="PHM 1:3" />য়োংকো সেংজা আপা আসা প্রভু ইশু খ্রীষ্টহা নাবিহিং অনুগ্রহ আসা তিমেওয়া পিচাকো!<verse eid="PHM 1:3" /></para>
  <para style="s">ফিলিমোনকো জেজেংওয়া আসা দেংওয়া</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />ও কুং এ ফিলিমন, কুং পাচাইওয়াবিতা নাতিহিং প্যারাপামসা কা কুং সেংজাহিং হাত্রংদো গারানি তারোওয়া, <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />হাংপাতানাহা প্রভু ইশুকোতা নিওয়া নাকো দেংওয়া আসা সেংজাকো পবিত্র দিংঙাবিকো তোইতা জেজেংপা জোয়ো তাওয়াকো তোইতা কা হিংয়ো। <verse eid="PHM 1:5" /><verse number="6" style="v" sid="PHM 1:6" />নাকো দেংওয়াকো সেওয়াসো কাবি খ্রীষ্টকোতা য়ুংনুওয়া কাবিকোতা নিওয়া তাংসা ছোসোওয়া নুওয়াংহিং নাপোসো গেকো চুওয়া সে পিচাকো তামসা কা পাচাইরোওয়া। <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />ও কুং এ, নাকো জেজেংওয়াসো কাহিংয়া সিওপা গাগ্রুওয়া আসা সাডুংওয়া মুংচামি নিও, হাংপাতানাহা নাকোসোহা সেংজাকো পবিত্র দিংঙাবিকো তুংসিংহা গাগ্রুমি নিও।<verse eid="PHM 1:7" /></para>
  <para style="s">অৗনেসিমোসকো সোতা জাংচাওয়া</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />আকো সোতা খ্রীষ্টকোতা নাকো সাডুংওয়া ডুওয়া জিংমসা নাতিহা হাং জোনেকোমে তামসা কা আজ্ঞা জোকো চুকোগা, <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />আদো জেজেংওয়াকো সোতা নাতিহিং জাংচারোওয়া। ওয়ারাংপুওয়া দিংঙা আসা ইশু খ্রীষ্টকো সোতা কৈদি জিংপুওয়া কা পাউলহা <verse eid="PHM 1:9" /><verse number="10" style="v" sid="PHM 1:10" />অৗনেসিমোসহিং লামতুপা জোপি তামসা কা নাতিহিং জাংচারোওয়া, আকুহা কা জেলতা নিনুহা দেংমসা কুং চেংওয়া ত্যাবাপা জোমসা কাহিং এমি নিও। <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />নাগাইহা আকুহা নাকো সোতাহা হাইরে কাম মালাগেওয়া বেপা নিমগা। আদো নেহা আকুহা নাকো আসা কুং নিহসোকোসারাং কাম জোওয়া জিংপুমি নিও। <verse eid="PHM 1:11" /><verse number="12" style="v" sid="PHM 1:12" />কা আকুহিংয়া ন্যাসারাং নাকোতা নিংপুদাংমি নিও। আকুহিংয়া কা সিওপারাং জেজেংপা জোমগা। <verse eid="PHM 1:12" /><verse number="13" style="v" sid="PHM 1:13" />এনতাওয়া দেরেং হিংপাপুওয়াকো সোতা কা জেলতা নিনুহা নাতি মাতানুওয়া আকুহিংনাং কাহিং কাংকো এপুকোগা। <verse eid="PHM 1:13" /><verse number="14" style="v" sid="PHM 1:14" />আদো নাতিহিং মাজাংপা এপা এচাকোহা কাহিংয়া এনতাপা মাজিংতো। আকো সোতা কাহিং লামতুপা জোকো নাতিহিং সুজামেপা মাজিংকো, আদো ইহা নাকো ইচ্ছাসো জিংকো তামসা কা নোমি। <verse eid="PHM 1:14" /><verse number="15" style="v" sid="PHM 1:15" />অৗনেসিমোসহা নাতিহিংপা হাত্রংদো য়ুংকো সোতা আম্যইম্যই তানাং জিংপুমদোওয়া। <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />নেহা আকুহা ডেইয়া ত্যাবাপা মোকো, ডেইয়ারোমা জেজেংওয়া কুং দেংওয়া এগা। আকুহা কুং সোতাহা সিওপারাং জেজেংপা নিও। জুপাতা আসা প্রভুতাহা আকুহা ঝান নাকো সোতাহা হাসেকো জেজেংওয়া নিকোগা।<verse eid="PHM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17" />আকো সোতা নাতিমি কাহিং আপনিকো ব্যারো নোনাহা, আকুহিংনে কাহিং ত্যাবাপা গ্রহন জোপি। <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />আকুমি হাইক্রি মেংতাপা জোমি নিনাহা আসা হাইক্রি তাকো নিনাহা কুং মিংতা হিসাব এপি। <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />কা পাউল আপনিকো খুইসো লামসা জাংরোওয়া, আকুহা কারাং তাপুরোওয়া। নাকো আপনিকো সাদিরে কুংসো য়ুচাওয়াহা কা জাংওয়া জাংওয়া জোমগ্যইরোওয়া। <verse eid="PHM 1:19" /><verse number="20" style="v" sid="PHM 1:20" />আকো সোতা ও কুং এ, প্রভুতা কুং সোতা জিংদো ই জোপ্পি। খ্রীষ্টকোতা কুং তুংসিংহা গাগ্রুওয়াসো মেইপুকো। <verse eid="PHM 1:20" /><verse number="21" style="v" sid="PHM 1:21" />নাতিহা কুং জাংওয়া জোপিরোওয়া আসা সিওপারাং জোপিরোওয়া তামসা লাওয়াতা কা ভরসা জোরোওয়া। <verse eid="PHM 1:21" /><verse number="22" style="v" sid="PHM 1:22" />আসা ন্যাসারাং ইচো নুওয়াং, নাকো পাচাইওয়াসো কারে নাকোতা ওয়াংচোং মুংকোদোওয়া তাওয়া আশা এমি নিও, আসা কুং সোতারে য়ুংদু সিরি তৈয়ার জোয়েপি।<verse eid="PHM 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />খ্রীষ্ট ইশুকো সোতা কাহিংপা কৈদি জিংপুওয়া কুং ব্যারো ইপাফ্রাসরে নাতিহিংয়া অভিবাদন কাইপুমি নিও। <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" />এপারাং কাহিংপা কাম জোওয়া মর্কুস, অরিস্তাখর্স, দেমাস আসা লুকরে অভিবাদন তাদিংয়ো। <verse eid="PHM 1:24" /><verse number="25" style="v" sid="PHM 1:25" />প্রভু ইশু খ্রীষ্টকো অনুগ্রহ নাকো লাংবেহিংপা হাত্রংদো নিকো।<verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>