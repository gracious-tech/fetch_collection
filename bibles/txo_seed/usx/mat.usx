<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">আমথি</book>
  <para style="h">মথি</para>
  <para style="toc3">মথি</para>
  <para style="toc2">মথি</para>
  <para style="toc1">মথিকো লাওয়া এনতাওয়া দেরেং</para>
  <para style="mt1">মথিকো লাওয়া</para>
  <para style="mt2">এনতাওয়া দেরেং</para>
  <para style="imt">নাইপাওয়া</para>
  <para style="ip">ই হিগাহা মথি তাওয়া ইশুকো য়োংতোংকো লাওয়া এনতাওয়া দেরেংকো হিগাগা। ইতাহা নাগাইকো সময়সো নাপোইতেমি নিওয়া মুক্তিদাতাহা ইশুরাংগা তামসা তিংপামি নিও। নাগাইকো সময়তাহা সেংজাহা আপনিকো য়োংতোং য়হুদি জ্যাবিহিং ইচো মুক্তিদাতা নিংপুরো তামসা নাপোইওয়া নিমগা। আকু নাপোইওয়া সেংজাহা ইশুহিং ই বাসিমতিতা নিংপুমসা পুরা জোমি নিও। ই এনতাওয়া দেরেংহা আকু জ্যাহিং, হানি জ্যাতা ইশু কেমমে আসা আকো সাদি পেংমমে, ই য়হুদি জ্যাবিকো সোতাদাং মোকো, আদো বাসিমতিকো তাংসা দিংঙাবিকো সোতারেগা।</para>
  <para style="ip">মথিকো লাওয়া এনতাওয়া দেরেংহা এনতাপা মিলাইমসা লামি নিও, ইতাহা ইশুকো কেওয়াসোহা সিপুওয়া আসা আকুহা ন্যাসারাং ঙারোওয়া নুওয়াংবি লামি নিও। ইতাহা আকো কেওয়া, বাপ্তিস্মা জোওয়া, পরিকছাতা পরেওয়া আসা গালীল লোইবিতা হোওয়া, ঝিপাওয়া আসা দিংঙাবিহিং সাংপাওয়া কামবিকো তোইতা লামি নিও। আকুহা য়রুশালেম হোওয়া, আউতা ইয়্যা চোইপা য়ুংওয়া, ক্রুসতা সিপুওয়া আসা ন্যাসারাং সাসুংয়ুতা ঙারোওয়া নুওয়াংবি লামি নিও। ই এনতাওয়া দেরেংসোহা ইশুহিংয়া লিংপাং আসা লোডিংবাকো লোইকো ভেদ ওয়েওয়া অধিকার মুংওয়া মাটা উটকেওয়া তামসা তিংপামি নিও। আকো ঝিপাওয়াবিতাহা সিওচেহা ই বিষয়বিতারাং নিও।</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">ইশুকো চিমাকো দিংঙাবি</para>
  <para style="r">(<ref loc="LUK 3:23-38">লুক ৩:২৩-৩৮</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />ইশু খ্রীষ্টহা অব্রাহাম আসা দাউদকো চেংওয়া নিমগা। ইহা আকো চিমাকো দিংঙাবিকো মিংগা।<verse eid="MAT 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="MAT 1:2" />অব্রাহামকো চেংওয়া ইসহাক নিমি, ইসহাককো চেংওয়া য়াকুব, য়াকুবকো চেংওয়াবিহা য়হুদা আসা আকো ডুওয়া এবি নিমি।<verse eid="MAT 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MAT 1:3" />য়হুদাকো তামার কাটুকো চেংওয়া ফারেস আসা জাহের, ফারেসকো চেংওয়া হেসরোন, হেসরোনকো চেংওয়া আরাম,<verse eid="MAT 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MAT 1:4" />আরামকো চেংওয়া অম্মিনাদাব, অম্মিনাদাবকো চেংওয়া নহসোন, নহসোনকো চেংওয়া সোলোমন,<verse eid="MAT 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MAT 1:5" />সোলোমনকো রাহাব কাটুকো চেংওয়া বোওজ, বোওজকো রুথ কাটুকো চেংওয়া অবেত, অবেতকো চেংওয়া য়িশাই।<verse eid="MAT 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="MAT 1:6" />য়িশাইকো চেংওয়াহা জাইপু দাউদ। দাউদকো চেংওয়া সোলোমন নিমি। আকো আয়ুহা উরিয়াকো মে বেথসেদা নিমি।<verse eid="MAT 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MAT 1:7" />সোলোমনকো চেংওয়া রাহবাম, রাহবামকো চেংওয়া অবিয়া, অবিয়াকো চেংওয়া আশা,<verse eid="MAT 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MAT 1:8" />আশাকো চেংওয়া য়াহোসাপাত, য়াহোসাপাতকো চেংওয়া য়হোরাম, য়হোরামকো চেংওয়া উজ্জিয়া,<verse eid="MAT 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MAT 1:9" />উজ্জিয়াকো চেংওয়া য়োতাম, য়োতামকো চেংওয়া আহাজ, আহাজকো চেংওয়া হিজকিয়া,<verse eid="MAT 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MAT 1:10" />হিজকিয়াকো চেংওয়া মানসে, মানসেকো চেংওয়া আমোন, আসা আমোনকো চেংওয়া য়োসিয়া নিমি।<verse eid="MAT 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MAT 1:11" />আবিহিংয়া বেবিলোনতা প্যইমসা পুরানুকো সময়তা য়োসিয়াকো চেংওয়া য়োকোনিয়াস আসা আকো এবি কেহে।<verse eid="MAT 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MAT 1:12" />বেবিলোনতা পুরানতেনুওয়া য়োকোনিয়াসকো চেংওয়া সালতিয়েল, সালতিয়েলকো চেংওয়া য়েরুবাবেল,<verse eid="MAT 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="MAT 1:13" />য়েরুবাবেলকো চেংওয়া অবিউদ, অবিউদকো চেংওয়া এলয়াকিম, এলয়াকিমকো চেংওয়া আজোর,<verse eid="MAT 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="MAT 1:14" />আজোরকো চেংওয়া সাদোক, সাদোককো চেংওয়া আখিম, আখিমকো চেংওয়া এলিউদ,<verse eid="MAT 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="MAT 1:15" />এলিউদকো চেংওয়া এলাজার, এলাজারকো চেংওয়া মত্তান, মত্তানকো চেংওয়া য়াকুব,<verse eid="MAT 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="MAT 1:16" />আসা য়াকুবকো চেংওয়া য়োসেফ জিংয়ে। য়োসেফহা মরিয়োমকো ওয়া নিমি। ই মরিয়োমরাং খ্রীষ্ট তাওয়া ইশুহিং চেংপাহে।<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />এপারাং অব্রাহামসো দাউদ চোইপা চৌদ্দ পুস্তা জিংপুমি নিমি, আসা দাউদসোহা ইস্রাইলিবিহিং বেবিলোনতা প্যইমসা পুরানু চোইপা চৌদ্দ পুস্তা জিংপুয়ে। আসা আত্রংসোহা খ্রীষ্ট কেনুকো সময় চোইপা ন্যাসারাং চৌদ্দ পুস্তারাং জিংপুয়ে।<verse eid="MAT 1:17" /></para>
  <para style="s">ইশু খ্রীষ্টকো কেওয়া</para>
  <para style="r">(<ref loc="LUK 2:1-7">লুক ২:১-৭</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />নেহা ইশু খ্রীষ্টকো কেওয়াহা এপা জিংপুয়ে: আকো আয়ু মরিয়োমকোহা য়োসেফহিংপা বিয়ৌ জিংরো তাওয়া নুওয়াং জিংতেমি, আদো আবিকো বিয়ৌ জিংওয়ারোমা নাগাইসোরাং মরিয়োমহা পবিত্র লাংবেকো সেসো চেং বুংমি নিমি, <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />আদো আকুহিং বিয়ৌ জোরো তাওয়া য়োসেফহা ইচো তাংজি নিওয়া দিংঙা নিমি। আকো সোতা আকুহা দিংঙাকো নাগাইতা মরিয়োমহিং মেংতাপা মাজিংকো তামসা চেকেপা পেইপুরো তাওয়া নোয়ে।<verse eid="MAT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20" />এপা নোদিংনুওয়া মাংবুইওয়াতা আকুহিংয়া সেংজাকো পোইং তিংরেমসা জাংয়ে, “ও দাউদ জাইপুকো চিমাতা কেওয়া য়োসেফ, নাতিহা মরিয়োমহিং বিয়ৌ জোকোহা মাচ্ছুংগে। আকো ফেমাতা নিওয়া চেংহা পবিত্র লাংবেকো সেসো জিংওয়াগা। <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />আকুহা চেংওয়া কেরোওয়া। আকু চেংওয়াকো মিংহা নাতিহা ইশু একো জো, হাংপাতানাহা আকুহা আপনিকো দিংঙাবিহিং পাপসো ওয়েংপারোওয়া।” <verse eid="MAT 1:21" /><verse number="22" style="v" sid="MAT 1:22" />সেংজাহা অগমবক্তাকোসো য়্যইওয়া ই নুওয়াংহা তাংসা জিংকো তামসা ই জিংমগা: <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />“কাং, নামেরি মেমেহা চেং বুংরোওয়া, আসা আকুহা ইচো চেংওয়া কেরোওয়া, আসা আকো মিংহা ইম্মানুয়েল এরোওয়া। ‘ইম্মানুয়েল’ তামসা জাংওয়াহা সেংজা য়াংবিহিংপা নিও।”<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />য়োসেফ জিংজুওয়াসো হেরোংয়ে আসা মাংবুইওয়াতা সেংজাকো লোডিংবাকো পোইংকো জাংওয়া নুওয়াং হিংমসা মরিয়োমহিং বিয়ৌ জোমসা আপনিকোতা পারায়ে। <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />আদো মরিয়োম চেং মাকেনু চোইপা য়োসেফহা আকুহিংপা মাজিংতো। মরিয়োমহা চেং কেনতেনুওয়া য়োসেফহা আকু চেংওয়াকো মিংহা ইশু এহে।<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">নুসো ইশুহিং দোসপাকো ওয়াংওয়া</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />ইশু য়হুদিয়াকো বেথলেহেম তাওয়া লোইতা কেমি নিমি। আত্রংকো সময়তাহা হেরোদহা আকু য়হুদিয়া জায়গাকো জাইপু নিমি। ইশু কেনতেনুকো নোইতা জ্যােতিষিবিহা নুসো আকুহিং মোপামসা য়রুশালেমতা ওয়াংয়ে। <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />আবিহা দিংঙাবিহিং উইয়ে, “আম্যই নাগাই কেওয়া য়হুদিবিকো জাইপুহা হাংতা নিংগা? আকো কেওয়া নুওয়াং প্যারাতাংপাওয়া পুইমাহিং কাবিহা নুসো ত্যইওয়া তিংয়ো আসা আকুহিং দোসপামসা চুনুইমসা নোংকো তামসা ওয়াংমি।”<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />ই নুওয়াং হিংমসা হেরোদ জাইপুহা তুংসিং চিচপুয়ে, আসা য়রুশালেমকো দিংঙাবিরে হাং জোকোমে মোজোকোমে মাইপা জিংপুয়ে। <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />আসা হেরোদ জাইপুহা আউতা মাটা পাউবিহিং আসা তাংজিকো উটকেওয়াবিহিং মোউমসা “মুক্তি পিচাওয়া জাইপু খ্রীষ্টহা হাংতা কেকোমে?” তামসা উইয়ে।<verse eid="MAT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5" />আবিহা জাংয়ে, “য়হুদিয়াকো বেথলেহেম লোইতা কেনেরোওয়া, হাংপাতানাহা তাংজিকো হিগাতা অগমবক্তাহা ইকো তোইতা এপা লাতেমি নিও,<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />‘ও য়হুদিয়াকো বেথলেহেম,</para>
  <para style="q2" vid="MAT 2:6">নাতিহা য়হুদিয়া শহরকো প্যাকোতাহা হাই জোমসারে আত্যইচিংপা মাতো।</para>
  <para style="q1" vid="MAT 2:6">হাংপাতানাহা নাকোসো ইচো টাবো জাইপু নোমসা লেরোওয়া,</para>
  <para style="q1" vid="MAT 2:6">আসা আকুরাং গোইত্র ত্যাবাপা কুং দিংঙা ইস্রাইলিবিহিং ল্যাচোইরোওয়া’।”<note caller="+" style="x"><char style="xo" closed="false">২:৬ </char><char style="xt" closed="false"><ref loc="MIC 5:2">মিকা ৫:২</ref></char></note><verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />ই হিংমসা হেরোদহা আকু নুসো ওয়াংওয়া জ্যোতিষিবিহিং ইদ্যাতা পুরামসা উইয়ে, আসা পুইমা হাত্রং তিংমমে, আকুহা আবিকোসো সিদা চ্যইয়ে। <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />আকো নোইতাহা আকুহা আবিহিং বেথলেহেমতা নিংপুমসা জাংয়ে, “নাবিহা হোমসা চেংকো তোইতা তাংসা নুওয়াং সেন্নেপা সিদা চ্যইপামসা কাহিং দেরেং হিংপারে, আসা কারে আকুহিং চুনুইমসা নোংকো হোরোওয়া।”<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />হেরোদ জাইপুকো জাংওয়া হিংমসা আকু জ্যোতিষিবিহা বেথলেহেমতা হোয়ে। ন্যাতাসো হোনুওয়া আবিহা নুসো তিংওয়া পুইমাহা ন্যাসারাং তিংয়ে। আকু পুইমাহা আবিকো নাগাই নাগাই হোয়ে আসা আকু চেং নিওয়া সাকো তোইতা জাকায়ে। <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />হাত্রং আবি ই পুইমাহিং তিং, আত্রংহা আবিহা সিওপারাং য়াংতাসুয়ে। <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />আকু সাতা দেকানতেনুওয়া আবিহা নাপোতা হোয়ে আসা চেংহিংয়া আয়ু মরিয়োমকো নুইতা তিংয়ে। আসা আবিহা আকো কোকোইতা চুইনুইসুমসা নোংসুয়ে, আসা আপনি আপনিকো চোংবেসো সুন, ওহও্যহপা মেনাংওয়া সাং আসা উইসে এনতাপা মেনাংওয়া চুইতি নোপামসা পিচায়ে।<verse eid="MAT 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 2:12" />আকো নোইতাহা আবিহা মাংবুইওয়াতা “হেরোদ জাইপুকোতা মাল্যাকাগ্যই” তাওয়া লোডিংবাকো প্যইংকোসো জাংওয়া হিংয়ে, আসা আবিহা দোসরা ন্যাতা জিংমসা আপনিকো লোইতা লাকাপুয়ে।<verse eid="MAT 2:12" /></para>
  <para style="s">মিশ্র লোইতা ক্যানেওয়া</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />আকু জ্যোতিষিবি হোপুনতেনুকো নোইতাহা য়োসেফহা মাংবুইওয়াতাহা প্রভুসেংজাকো পোইংহিং তিংয়ে আসা পোইংহা আকুহিংয়া জাংয়ে, “সেন্নেপা আয়ুসো চেংওয়াহিং পুরামসা মিশ্র লোইতা ক্যাপু, আসা কা মাজাংনু চোইপা নাবিহা আউতারাং য়ুং, হাংপাতানাহা হেরোদহা চেংওয়াহিং স্যাকো মোদিংয়ো।”<verse eid="MAT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14" />এপা মাংবুইওয়াতা তিংনুওয়া য়োসেফহা আয়ুসো চেংওয়াহিং পুরামসা লিসুংতারাং মিশ্র লোইতা ক্যারাপুয়ে, <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />আসা হেরোদ মাসিনু চোইপা আবিহা আউতারাং য়ুংয়ে। এপারাং প্রভুসেংজাহা অগমবক্তাহিং নাগাইসো জাংপাওয়া ই নুওয়াং পুরা জিংরেমগা, “কাহা মিশ্র লোইসো আপনিকো চেংওয়াহিং মোউয়ে।”<note caller="+" style="x"><char style="xo" closed="false">২:১৫ </char><char style="xt" closed="false"><ref loc="HOS 11:1">হোসে ১১:১</ref></char></note><verse eid="MAT 2:15" /></para>
  <para style="s">হেরোদহা চেংওয়াবিহিং স্যাপাওয়া</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />জ্যোতিষিবিহা আপনিহিং ল্যহপাপুয়ে তাওয়া নুওয়াং সিদা চ্যইমসা হেরোদ জাইপুহা সেদ্রাংপুয়ে। আসা জ্যোতিষিবিকোসো সিদা চ্যইওয়া সময় অনুসার হেরোদহা বেথলেহেম লোইকো আসা আউতা হুরাপা নিওয়া জায়গাকো লো নিহনিংকো লিকো তাংসা চেংবিহিংয়া স্যাপাপুয়ে। <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />আত্রংহা য়র্মিয়া অগমবক্তাকো নাগাইসো জাংওয়া নুওয়াং তাংসা পুরা জিংয়ো,<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />“রামা শহরতা ইচো ক্যা হিংয়ে,</para>
  <para style="q2" vid="MAT 2:18">কাইসুওয়া, আসা পিংচ্যাসুওয়া।</para>
  <para style="q1" vid="MAT 2:18">রায়েলহা আপনিকো চেংওয়াবিকো সোতা কাইদিংয়ো।</para>
  <para style="q2" vid="MAT 2:18">আকুহা সিওপা কাইমসা দোসরা নোইপাদো ঙাকোরাং মেকেংতো,</para>
  <para style="q2" vid="MAT 2:18">হাংপাতানাহা তাংসা চেংবিহা সিপুমি নিও।”<note caller="+" style="x"><char style="xo" closed="false">২:১৮ </char><char style="xt" closed="false"><ref loc="JER 31:15">য়ের্মিয়া ৩১:১৫</ref></char></note><verse eid="MAT 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />হেরোদ সিপুনতেনুওয়া প্রভুসেংজাকো লোডিংবাকো পোইংহা মিশ্র লোইতা য়োসেফহিং মাংবুইওয়াতা তিংরেমসা জাংয়ে,<verse eid="MAT 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 2:20" />“লো, নেহা আয়ুসো চেংওয়াহিং পুরামসা ইস্রাইল লোইতা লাকাতু, হাংপাতানাহা চেংওয়াহিং স্যাকো কেংওয়া দিংঙাহা সিপুনতেয়ো।” <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />আকো নোইতাহা য়োসেফহা আয়ুসো চেংওয়াহিং পুরামসা ইস্রাইল লোইতা লাকাপুয়ে।<verse eid="MAT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 2:22" />আদো হেরোদ জাইপু সিপুনতেনুকো নোইতাহা আকো চেংওয়া অর্কিলাউস তাওয়া আকু জায়গাতা য়হুদিয়াকো জাইপু জিংমি নিও তাওয়া হিংমসা য়োসেফহা আউতা হোকো চুসুংপুয়ে। আসা ন্যাসারাং লোডিংবাকো পোইংকো মাংবুইওয়াতা জাংওয়া হিংমসা আবিহা গালীলতা হোয়ে, <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />আসা আকুহা নাসরত তাওয়া শহরতা হোমসা য়ুংপুয়ে। এপা জোমসারাং অগমবক্তাকো জাংওয়া নুওয়াংহা তাংসা জিংয়ো “আকুহিংয়া নাসরি তানেরোওয়া।”<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">বাপ্তিস্মা পিচাওয়া য়হুন্নাকো দেরেং</para>
  <para style="r">(<ref loc="MRK 1:1-8">মর্কুস ১:১-৮</ref>; <ref loc="LUK 3:1-18">লুক ৩:১-১৮</ref>; <ref loc="JHN 1:19-28">য়হুন্না ১:১৯-২৮</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />আকু সময়তা বাপ্তিস্মা পিচাওয়া য়হুন্নাহা য়হুদিয়াকো চিচ্চোওয়া জায়গাতা দিংঙাবিহিং এপা জাংমসা দেরেং হিংপাদাংয়ে, <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />“আপনি আপনিকো পাপকো পশ্চতাপ জোমসা আকু পাপহিং ল্যাতে, হাংপাতানাহা সেংজাকো রাজ্যহা আবেইতা দেপাদাংতেয়ো।” <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />নেহা এশাইয়া অগমবক্তারে য়হুন্নাকো তোইতা নাগাইসোরাং এপা জাংমি নিমগা:</para>
  <para style="q1" vid="MAT 3:3">“হিং, চিচ্চোওয়া জায়গাতা ইচো সাডিংপা ঙামসা এপা জাংদিংয়ো,</para>
  <para style="q2" vid="MAT 3:3">‘প্রভুসেংজাকো লেওয়া ন্যাতা ঠিক জো,</para>
  <para style="q2" vid="MAT 3:3">আকো তেইওয়া ন্যাতাবি গেংপা জো’।”<note caller="+" style="x"><char style="xo" closed="false">৩:৩ </char><char style="xt" closed="false"><ref loc="ISA 40:3">এশাইয়া ৪০:৩</ref></char></note><verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />য়হুন্নাহা ত্যাইরম্যাকো মুসাসো ফিওয়া আংদুং লুচাংমি, আসা কেংনুংতা বেকোংকো কোংন্যা জিংচাংমি, আসা দিংজ্রাসো চুংচাকো শুইমাকো পুতিবি চাচাংমি। <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />য়রুশালেম শহর, য়হুদিয়াকো তাংসা লোই আসা য়র্দন জোরাসো হুরাপা দিংঙাবিহা আকোতা ওয়াংপায়ে, <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />আসা আপনি আপনিকো পাপহিং ল্যাতেমসা ওয়াংওয়াবিহিংয়া য়হুন্নাহা য়র্দন জোরাতা বাপ্তিস্মা পিচায়ে।<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />ফরিসি আসা সদুকি তাওয়া তাংজিকো নিহসো পারাকো উইসে দিংঙাবিরে বাপ্তিস্মা লাংকো য়হুন্নাকোতা লেয়ে। আবিহিং ওয়াংপাওয়া তিংমসা য়হুন্নাহা জাংয়ে, “ও সিওপা লিং নিওয়া পুইয়াকো চেংবাই, সেংজাকো জোওয়া ন্যায়সো ক্যাচকো তামসা নাবিহিংয়া হাংসু জাংপিংগা? <verse eid="MAT 3:7" /><verse number="8-9" style="v" sid="MAT 3:8-9" />নাবিহা আপনি আপনিকো পাপহিংয়া পশ্চতাপ জোয়ো তামসা লায়োংদানাহা আকো নাগাইতা এনতাওয়া কাম তিংপা। ‘কাবিহা অব্রাহামকো চেংচুংবিগা’ আকো সোতা ন্যায়সোহা ক্যাকো চুরোওয়া তামসা নাবিহা মোনোগে, কা নাবিহিংয়া জাংরোওয়া, হাংপাতানাহা সেংজাহা ই লুংটুইসোরে অব্রাহামকো চেংবি নোপাকো চুরোওয়া। <verse eid="MAT 3:8-9" /><verse number="10" style="v" sid="MAT 3:10" />সিংতেংকো দেবেতা ন্যায়কো দুপে সোকানতেও। এনতাপা ফল মেসেওয়া তাংসা সিংতেংহিংয়া নেমসা মেতা বাডোইপুরোওয়া।<verse eid="MAT 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11" />“আজিপ্পারাং, কা নাবিহিংয়া আপনি আপনিকো পাপহিং পশ্চতাপ জোকো তামসা নাবিহিংয়া তিসো বাপ্তিস্মা পিচাদাংয়ে, আদো কুং নোইতা লেপাওয়াহা নাবিহিংয়া পবিত্র লাংবে আসা মেহসো বাপ্তিস্মা পিচারোওয়া। আকুহা কারোমা টেবোগা। কা আকো কোরোংবি পুউওয়া ডেইয়া বেপারে মোতো। <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />আকুহা গেহুং তাওয়া কুরাহা খুইতা চুংপুনতেয়ো। তাপুনতেনুকো নোইতাহা গেহুংবিহা তোপাতা এরোওয়া, আদো ভিতোবিহা হাত্রংরে মিসিওয়া মেহতা চুংপুরোওয়া।”<verse eid="MAT 3:12" /></para>
  <para style="s">ইশুকো বাপ্তিস্মা লাংওয়া</para>
  <para style="r">(<ref loc="MRK 1:9-11">মর্কুস ১:৯-১১</ref>; <ref loc="LUK 3:21-22">লুক ৩:২১-২২</ref>; <ref loc="JHN 1:32-34">য়হুন্না ১:৩২-৩৪</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />আত্রংকো সময় ইশুহা গালীলসো দেরেয়ে আসা আকুহা বাপ্তিস্মা লাংকো সোতা য়র্দন জোরাতা য়হুন্নাকোতা লেয়ে। <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />আদো য়হুন্নাহা আকুহিংয়া এপা জাংমসা য়োইকো কেংয়ে, “কাহা নাতিহিংয়া বাপ্তিস্মা পিচাকো ছুকো বেপা মোতো, নাতিহা কাহিং বাপ্তিস্মা পিচানেকোগা। আদো নাতিহা কুংতা ওয়াংয়ো।”<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />ইশুহা আকুহিং জাংয়ে, “নেহা এপারাং জো, হাংপাতানা সেংজাকো তাংজিহিং পুরা জোকো য়াংবিহা নেহা এপারাং জোনেরোওয়া।”</para>
  <para style="p" vid="MAT 3:15">ই নুওয়াং হিংমসা য়হুন্নাহা ইশুহিং বাপ্তিস্মা পিচায়ে।<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />বাপ্তিস্মা লাংপুনতেনুকো নোইতাহা ইশুহা তিসো বাইরে নোয়ে, আত্রংহা লোডিংবা ওয়েচপুয়ে আসা আকুহা সেংজাকো লাংবেহিং কুইজা ত্যাবাপা উইপামসা আপনিকোতা লেপাদাংওয়া তিংয়ে। <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />আত্রংরাং লোডিংবাসো এপা জাংওয়া ক্যা হিংয়ো, “ইহা কুং জেজেংওয়া চেংওয়াগা, ইহিংপা কা গাগ্রুপা নিও।”<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">শয়তানহা ইশুহিং পাপতা পুরাকো কেংওয়া</para>
  <para style="r">(<ref loc="MRK 1:12-13">মর্কুস ১:১২-১৩</ref>; <ref loc="LUK 4:1-13">লুক ৪:১-১৩</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />আকো নোইতাহা শয়তানহা ইশুহিং পরিকছা জোকো তামসা পবিত্র লাংবেহা ইশুহিং চিচ্চোওয়া জায়গাতা পুরায়ে। <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />আউতা ইশুহা নিহকাইয়ু জেইসুং লিসুং হাইরে মাচাতো। আকো সোতা আকুহা সিওপারাং লোবোসুংপুমি নিমি। <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />আত্রংরাং শয়তানহা আকোতা ওয়াংমসা জাংয়ে, “আজিপ্পারাং নাতিহা সেংজাকো চেংওয়া বেনাহা ই লুংটুইহিং কোব্রেং জিংপুকো তামসা জাং।”<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />ইশুহা জাংয়ে, “তাংজিকো হিগাতাহা এপা জাংমি নিও, ‘দিংঙাহা চাওয়া-আংওয়াসোদাং মাবাচেমগা, আদো সেংজাকো নামুসো নোওয়া তাংসা য়্যইদিসো বাচেমগা’।”<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />আকো নোইতাহা শয়তানহা ইশুহিংয়া পবিত্র শহর য়রুশালেমতা পুরায়ে আসা দেমসাকো হানিরোমা তোইতা সামসা জাংয়ে, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />“আজিপ্পারাং নাতিহা সেংজাকো চেংওয়া বেনাহা ইসো লিতা তোইং। তাংজিকো হিগাতা এপা লামি নিও,</para>
  <para style="q" vid="MAT 4:6">‘সেংজাহা নাকো সোতা আপনিকো লোডিংবাকো পোইংবিহিং নিংপুরোওয়া,</para>
  <para style="q" vid="MAT 4:6">আসা নাকো কোকোইবি লুংটুইতা মাতাত্যাচাকো তামসা আবিহা নাতিহিংয়া খুইবিসোরাং প্যইপিরোওয়া’।”<note caller="+" style="x"><char style="xo" closed="false">৪:৬ </char><char style="xt" closed="false"><ref loc="PSA 91:11-12">ভজন ৯১:১১-১২</ref></char></note><verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />ইশুহা জাংয়ে, “তাংজিকো হিগাতাহা এপারে লামি নিও, ‘নাতিহা আপনিকো সেংজাহিং পরিক্ছা মোজো’।”<note caller="+" style="x"><char style="xo" closed="false">৪:৭ </char><char style="xt" closed="false"><ref loc="DEU 6:16">ব্যবস্থা ৬:১৬</ref></char></note><verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />ন্যাসারাং শয়তানহা ইশুহিংয়া ইচো উচুংওয়া য়্যাগ্যইতা পুরায়ে আসা বাসিমতিকো তাংসা লোইকো টেরবো টেরবো রাজ্যবি আসা আউতা নিওয়া এনতা-এনতাওয়া সোংসাবি তিংপামসা জাংয়ে, <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />“কাহিংমি চুনুইমসা নোংনাহা কা ই তাংসা নাতিহিং পিচারোওয়া।”<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />ইশুহা জাংয়ে, “ও শয়তান, নাতিহা ইসো হ্যাপুই! তাংজিকো হিগাতা এপা লামি নিও ‘নাতিহা নাকো সেংজাহিং মেংচে চুনুইমসা নোং, আসা আকো মেংচে সেওয়া জো’।”<verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />শয়তানহা ইশুহিং হুইতেমসা হোপুইয়ে, আসা লোডিংবাকো পোইংবিহা লেমসা ইশুহিং য়ুজ্রুয়ে।<verse eid="MAT 4:11" /></para>
  <para style="s">ইশুহা গালীলতা আপনিকো কাম জোদাংওয়া</para>
  <para style="r">(<ref loc="MRK 1:14-15">মর্কুস ১:১৪-১৫</ref>; <ref loc="LUK 4:14-15">লুক ৪:১৪-১৫</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />য়হুন্নাহা জেলতা নিনা তাওয়া হিংমসা ইশুহা গালীল লুংবিতা লাকাপুয়ে। <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />আদো আকুহা নাসরত লোইহিং হুইতেমসা কোফর্নহুম শহরতা য়ুংয়াকো হোপুয়ে। কোর্ফরনহুম শহরহা গালীল দাব্রিকো আবেইতা জবুলুন আসা নোপতালি লুংবিতা নিমি। <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />এপারাং এশাইয়া অগমবক্তাকো জাংওয়া য়্যইদিহা পুরা জিংয়ো:<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />“য়র্দন জোরা নুব্যা গালীল দাব্রিতা হ্যাওয়া ন্যাতাতা নিওয়া জবুলুন আসা নোপতালি জায়গাকো দিংঙাবাই,</para>
  <para style="q2" vid="MAT 4:15">আসা গালীলতা য়ুংওয়া দোসরা জ্যাকো দিংঙাবাই!<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />নাঘিওয়াতা য়ুংওয়াবিহা টেবো হাহাইওয়া তিংরোওয়া।</para>
  <para style="q2" vid="MAT 4:16">সিদিংকো নামুতা আসা নাঘিওয়াতা নিমবিহা</para>
  <para style="q1" vid="MAT 4:16">আবিকো তোইতা টেবো হাহাইপা তাত্রাইরোওয়া।”<note caller="+" style="x"><char style="xo" closed="false">৪:১৬ </char><char style="xt" closed="false"><ref loc="ISA 9:1-2">এশাইয়া ৯:১-২</ref></char></note><verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />আত্রংসোরাং ইশুহা দেরেং হিংপামসা এপা জাংয়ে, “আপনি আপনিকো পাপহিং কাবিহা পাপ জোমরাংগা তামসা পাপহিং ল্যাতে, হাংপাতানাহা সেংজাকো রাজ্যহা আবেইতা দেয়োংতেয়ো।”<verse eid="MAT 4:17" /></para>
  <para style="s">ইশুহা জেরে তিমবিহিং মোউওয়া</para>
  <para style="r">(<ref loc="MRK 1:16-20">মর্কুস ১:১৬-২০</ref>; <ref loc="LUK 5:1-11">লুক ৫:১-১১</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />সাইয়ুহা গালীল দাব্রিকো আরি-আরিতা তেইদিংনুওয়া ইশুহা নিহসো জেরে তিওয়াবিহিং জেরে তিদিংওয়া তিংয়ে। আবিহা পত্রস তাওয়া সিমোন আসা আকো এ আন্দ্রিয়াস নিমি। <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />ইশুহা আবিহিং জাংয়ে, “কুং নুনুই হুইপা, নাবিহা নায়া প্যইমেপা কা নাবিহিংয়া দিংঙা প্যইওয়া বানাইরোওয়া।” <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />ই হিংতানি আবিহা আপনিকো জেরেবি হুইতেমসা ইশুকো নুনুই হুইপুয়ে।<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />আকো নোইতাহা আস্যই নাগাই হ্যানুওয়া আকুহা জোব্দিকো নিহসো চেংওয়া য়াকুব আসা য়হুন্নাহিং দোসুয়ে। আবিহা আপনিকো আপা জোব্দিহিংপা নোওয়াইতা গামসা জেরে তোদিংমি। ইশুহা আবিহিংনে মোউয়ে। <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />আত্রংহা আবিহা আপনিকো আপাহিংয়া নোওয়াইতা হুইতেমসা ইশুকো নুনুই হুইপুয়ে।<verse eid="MAT 4:22" /></para>
  <para style="s">ইশুকো ঝিপাওয়া, হিংপাওয়া আসা সাংপাওয়া</para>
  <para style="r">(<ref loc="LUK 6:17-19">লুক ৬:১৭-১৯</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />ইশুহা গালীলকো তাংসা লুংবিবিতা কোইয়ে। আকুহা জায়গা-জায়গাতা নিওয়া য়হুদিবিকো জোংসুওয়া সাবিতা হোয়ে আসা দিংঙাবিহিং ঝিপামসা সেংজাকো রাজ্য আবেইতা দেয়োংতেয়ো তাওয়া এনতাওয়া দেরেং হিংপায়ে। আকুহা দোসুওয়া সেই য়োংন্যা দ্যইংচপুওয়া হাইমবিহিং সাংপায়ে। <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />এপা জিংপুনুওয়া গালীলকো আবেইতা নিওয়া সিরিয়া লোইবিতারে আকো নুওয়াং হিংয়ায়ে। দিংঙাবিহা তাংসা য়োংন্যা আসা মাসাংওয়া হাইমবিহিং আকোতা পারায়ে। আউতা উইসে জেসাং দ্যইংচপুওয়া দিংঙাবি, লেরাহিংয়া জ্যানা পেইওয়া, আসা লেরাহা কোকোই খুই চোংচপুওয়া হাইওয়া নিমি। ইশুহা আবি তাংসাহিংনাং সাংপায়ে। <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />উইসে দিংঙাবিহা আকো নুনুই হুইয়ে। আকু দিংঙাবিহা গালীল লুংবিকো, ত্যাচো শহরকো লুংবিসো, য়রুশালেম শহর, য়হুদিয়া লুংবি আসা য়র্দন জোরাকো নুব্যাসো ওয়াংওয়া নিমি।<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">য়্যাগ্যইতা হিংপাওয়া ইশুকো দেরেং</para>
  <para style="r">(<ref loc="LUK 6:20-26">লুক ৬:২০-২৬</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />উইসে য়ায়া-য়ুয়ুপা দিংঙাবি চিত্তা তিংমসা ইশুহা য়্যাগ্যইকো তোইতা হোমসা গায়ে আসা য়োংতোংবিরে লেমসা আকো হুরাপা গায়ে। <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />আসা আকুহা আবিহিং ঝিপামসা এপা জাংয়ে:<verse eid="MAT 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />“আশিষিত নিও, আপনিহিং সেংজাকো নাগাইতা জোরোংওয়া নোমবিহা!</para>
  <para style="q2" vid="MAT 5:3">হাংপাতানাহা সেংজাকো রাজ্যহা আবিকোরাংগা।<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />আশিষিত নিও, তুংসিংতা কাইমবিহা!</para>
  <para style="q2" vid="MAT 5:4">হাংপাতানাহা আবিকো তুংসিংতাহা সেংজাকোসো তিমেওয়া মুংরোওয়া।<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />আশিষিত নিও, আপনিহিং আপেচাপা নোমবিহা!</para>
  <para style="q2" vid="MAT 5:5">হাংপাতানাহা আবিহা বাসিমতিতা অধিকার জোকো মুংচারোওয়া।<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />আশিষিত নিও, সেংজাকো জোকো কেংওয়া কামতা নাগাই গ্যহকো ইচ্ছা জোমবিহা!</para>
  <para style="q2" vid="MAT 5:6">হাংপাতানাহা সেংজাহা আবিহিংয়া আকু কাম জোকো য়ুজ্রুরোওয়া।<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />আশিষিত নিও, লামতুপা জোমবিহা!</para>
  <para style="q2" vid="MAT 5:7">হাংপাতানাহা আবিহা লামতুওয়া মুংচারোওয়া।<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />আশিষিত নিও, তুংসিংতা চোসোওয়াবিহা!</para>
  <para style="q2" vid="MAT 5:8">হাংপাতানাহা আবিরাং সেংজাহিং তিংরোওয়া।<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />আশিষিত নিও, চাংসপামবিহিংয়া!</para>
  <para style="q2" vid="MAT 5:9">হাংপাতানাহা সেংজাহা আবিহিংয়া কুং চেংবিগা তামসা জাংরোওয়া।<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />আশিষিত নিও, সেংজাকো তাংজিকো সোতা কোইচ্যাওয়াবিহা!</para>
  <para style="q2" vid="MAT 5:10">হাংপাতানাহা সেংজাকো রাজ্যহা আবিকোরাংগা।”<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />“আশিষিত নিও, কাহিং দেংওয়াকো সোতা দিংঙাবিহা হাত্রং নাবিহিং নিন্দা জো, আসা দুঃখ, আসা নাবিকো তোইতা তাংসা মেংতাওয়া নুওয়াংবি য়্যইসু। <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />আত্রংহা নাবিহা গাগ্রুমসা য়াংতা, হাংপাতানাহা লোডিংবাতা নাবিহিংয়া টেবো ইনাম এমি নিও। এপারাং নাবিরোমা নাগাইকো অগমবক্তাবিহিংয়া দিংঙাবিহা দুঃখ পিচামি নিমগা।”<verse eid="MAT 5:12" /></para>
  <para style="s">নী আসা হাহাইওয়া</para>
  <para style="r">(<ref loc="MRK 9:50">মর্কুস ৯:৫০</ref>; <ref loc="LUK 14:34-35">লুক ১৪:৩৪-৩৫</ref>, <ref loc="LUK 11:33">১১:৩৩</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />“নাবিহা বাসিমতিকো নী বেপাগা। আদো নীরাং মাজেংনাহা হাংসো জেংপাকোগা? আকুহা হাইরে কামতারাং মালাগেমসা বাডোইনেরোওয়া আসা দিংঙাবিহা হুইংদ্যাপুরোওয়া।”<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />“নাবিহা বাসিমতিকো হাহাইওয়া বেপাগা। য়্যাগ্যইকো তোইতা নিওয়া শহরহা গুংমসা য়ুংমক্যইমগা। <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />আসা হাংসুরে দিব্রি লারাইপামসা তোপাসো মাতুংমগা, আদো সাতা নিওয়া তাংসাহিং হাহাইপা জিংকো তামসা দিব্রিহিংয়া তোলোংওয়া তিরাতা ওইমসা এমগা। <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />এপারাং নাবিকো হাহাইওয়ারে দোসরা দিংঙাবিকো নাগাইতা হাহাইপা জিংকো আসা দোসরাবিরে নাবিকো জোওয়া এনতাওয়া কামবি তিংরোওয়া আসা লোডিংবাতা নিওয়া নাবিকো সেংজা আপাকো মহিমা জোরোওয়া।”<verse eid="MAT 5:16" /></para>
  <para style="s">লিংপাংকো তোইতা ঝিপাওয়া</para>
  <para style="r">(<ref loc="LUK 16:17">লুক ১৬:১৭</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />“কাহা মোসাকো পিচাওয়া লিংপাং আসা অগমবক্তাবিকো জাংওয়া নুওয়াংবিহিং য়োইকো লেমগা তামসা মোনোগে, আদো কাহা আকু নুওয়াংহিং পুরা জোকো তামসা লেমগা। <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />হাংপাতানাহা আজিপ্পারাং কা নাবিহিং জাংরোওয়া, হাত্রং চোইপা ডিংবাসো বাসিমতি মায়াং, আত্রং চোইপা সেংজাকো লিংপাংতা লামি নিওয়া আত্যইচোওয়া নুওয়াংবি পুরা মাজিংনু চোইপা ইহা মায়াংরোওয়া। <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />লিংপাংকো হানিরোমা আত্যইচোওয়া নুওয়াংবিহিং হিংমসা মোজোওয়া আসা মোজোকো তামসা ঝিপাওয়া দিংঙাহা সেংজাকো রাজ্যতা হাংসুরোমা চিয়োপা জিংরোওয়া। আদো লিংপাংকো নুওয়াংহিং আপনিরে হিংমসা জোওয়া আসা দোসরাবিহিংনে জোকো ঝিপাওয়াহা সেংজাকো রাজ্যতা টেবো জিংরোওয়া।”<verse eid="MAT 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 5:20" />আকো সোতা কা নাবিহিংয়া জাংরোওয়া, সেংজাকো জাংওয়া নুওয়াংবিহিং তাংজিকো উটকেওয়াবি আসা ফরিসিবিরোমা এনতাপা হিংমসা মোজোনাহা নাবিহা সেংজাকো রাজ্যতা হোচা মোমুংরোওয়া।<verse eid="MAT 5:20" /></para>
  <para style="s">সেদ্রাংদুওয়াকো তোইতা ঝিপাওয়া</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />“নাগাইকো দিংঙাবিহিংয়া মোসাকো লিংপাংতাহা এপা জাংমি নিমগা, ‘দিংঙা মাস্যাকো, স্যানাহা দন্ড মুংরোওয়া’ তামসা জাংওয়া নিমগা। ইহা নাবিরাং গেমি নিও। <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />আদো কা নাবিহিং জাংরোওয়া, আপনিকো এহিংপা সেদ্রাংপাওয়াবিহা দন্ড মুংরোওয়া। হাংসু আপনিকো এহিং হাইরে মেগেমগা তামসামি জাংনাহা, আকুহা হানিরোমা টেবো য়হুদি ন্যায় জোমবিকো আবেইতা জাকানেরোওয়া। আপনিকো এহিং তৌজিগা তামসা জাংওয়াবিহা নরককো মেতা দেকাকো ছুরোওয়া।<verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />“আকো সোতা দেমসাতা ভেটি পিচাদাংনুরোমা নাগাই নাকো এ নাতিহিংপা সেদ্রাংপামি নিও তাওয়া সিদা চ্যইনাহা <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />আপনিকো ভেটি ভেদিকো আবেইতা এতেমসা নাগাইহা হোমসা আপনিকো এহিংপা চাংসুতু। আকো নোইতা মেংচে ওয়াংমসা আপনিকো ভেটি সেংজাহিং পিচা।<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />“ন্যায় জোওয়া জায়গাতা দেকানুরোমা নাগাই, মৌকা নিনুরাং স্যাসুওয়া দিংঙাহিংপা নাত্যাতারাং চাংসুপুই। মেনাহা আকুহা নাকো তোইতা মেংতাপা জোমসা হাংসুরোমা টেবো ন্যায় জোওয়াকোতা ত্যইপুরোওয়া আসা ন্যায় জোওয়াহা নাতিহিংয়া সিপাইবিকোতা ত্যইপুরোওয়া আসা নাতিহিংয়া জেলতা সুংপুরোওয়া। <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />আজিপ্পারাং কা নাবিহিং জাংরোওয়া, আত্রংহা তাংসা ন্যাস্যা মাতানু চোইপা নাতিহা আকু জেলসোহা নোচা মোমুংরোওয়া।<verse eid="MAT 5:26" /></para>
  <para style="s">মোনুংনাংসুকো তামসা ঝিপাওয়া</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />“মোসাকো লিংপাংতাহা ‘নুংনাংসুমতুরোওয়া’ তামসা লামি নিও তাওয়া নুওয়াংহা নাবিহা হিংমি নিও। <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />আদো কা জাংরোওয়া, হাংসু ইচো মেমেহিং মেংতাওয়া নোচেংসো ন্যই, আকুহা তুংসিং নাপোসো আকু মেমেহিংপা নুংনাংসপুনতেওয়া নিমগা। <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />নাকো দাংক্রেং মিচোহা নাতিহিং পাপতা চোইপানাহা আকুহিংয়া য়োমসা বাডোইপুই। নাকো তাংসা জুপা নরকতা বাডোইচাপুওয়ারোমা নাকো ইচো মিচো মাতাওয়ারাং নাকো সোতাহা এনতাওয়াগা। <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />এপারাং নাতিহা নাকো দাংক্রেং খুইকো সোতা পাপতাবেমি দেকানাহা আকুহিংয়া ঠেমসা বাডোইপুই। নাকো তাংসা জুপা নরকতা বাডোইচপুমরোমাহা, আকু খুই মাতোওয়ারাং নাকো সোতা এনতাওয়াগা।<verse eid="MAT 5:30" /></para>
  <para style="s">পেইসুওয়াকো তোইতা ঝিপাওয়া</para>
  <para style="r">(<ref loc="MAT 19:9">মথি ১৯:৯</ref>; <ref loc="MRK 10:11-12">মর্কুস ১০:১১-১২</ref>; <ref loc="LUK 16:18">লুক ১৬:১৮</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />“মোসাকো লিংপাংতাহা ‘মে পেইমবিহা সোকুতা লেখা-পরি জোমসা পেইকো’ তামসা জাংমি নিও। <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />আদো কা জাংরোওয়া, মেকো নুংনাংসুওয়াকো দোষ মাতাপা মেহিং পেইওয়াহা আকুহিং নুংনাংপামগা আসা এপারাং পেইপুওয়া মেহিং বিয়ৌ জোওয়ারে নুংনাংসুওয়ারাংগা।<verse eid="MAT 5:32" /></para>
  <para style="s">মানাপোইকো তামসা ঝিপাওয়া</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />“ন্যাসারাং মোসাকো লিংপাংতাহা নাগাইকো দিংঙাবিহিংয়া জাংমি নিও, ‘অ্যাজাপা মানাপোই, আদো সেংজাকো নাগাইতা নাপোইপুনতেওয়া নুওয়াংবি তাংসা জোকো’ তাওয়াহা নাবিহা গেমিরাং নিও। <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />আদো কা নাবিহিং জাংরোওয়া, হাই নুওয়াংতারে নাবিহা মানাপোইগে। লোডিংবাকো মিং লাংমসা নাপোইমতুমগা, হাংপাতানাহা আকুহা সেংজাকো গাদিংগা। <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />বাসিমতিকো মিং লাংমসারে নাপোইমতুমগা, ইহা সেংজাকো তাংবা এওয়া জায়গাগা। আসা য়রুশালেমকো মিং লাংমসারে নাপোইমতুমগা, আকুহা টেবো জাইপু সেংজাকো শহরগা। <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />এপারাং আপনিকো পোরো সুমসারে নাপোইমতুমগা, হাংপাতানাহা নাবিহা আপনিকো পোরোকো ইগে পুরিংরে হাংপাপা আসা দাসিপা জোমক্যইমগা। <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />আকো সোতা নাবিরে মানাপোইগ্যই কোওয়াবেনাহা ‘কোওয়ারাং’ কিতা মোকোওয়াবেনাহা ‘মোকোওয়ারাং’ তামসা জাংপুই। ইরোমা সিওপা জিংপুওয়াহা শয়তানসো লেওয়াগা।<verse eid="MAT 5:37" /></para>
  <para style="s">বদলা মালাংকো তামসা ঝিপাওয়া</para>
  <para style="r">(<ref loc="LUK 6:29-30">লুক ৬:২৯-৩০</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />“নাবিহা লিংপাংতা হিংমি নিও, ‘মিচোকো বদলা মিচো, সেতাংকো বদলা সেতাং।’ <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />আদো কা জাংরোওয়া, নাবিহিং মেংতাপা জোমবিহিং বদলা মালাং। হাংসু নাকো দাংক্রেং য়ুওয়াইতা ত্যাচোং, আকুহিংয়া নাকো কেক্রেং য়ুওয়াইতারে ত্যাচোংকো পিচা। <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />হাংসু নাকো লুচাওয়া লাসু গিংচাকো সোতা ন্যায় জোমবিকোতা পুরাকো কেং, আকুহিংয়া নাকো জেকেটরে পিচাপুই। <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />হাংসু নাতিহিং ইবাং চোইপা ব্যা সাজ্রুকো হেহেং, আকুহিংপা নিহবাং চোইপা সাজ্রুতু। <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />আসা নাতিহিংপা য়াওয়াহিং পিচা, আসা খিকো য়াংমবিহিংনে খিকো পিচা।<verse eid="MAT 5:42" /></para>
  <para style="s">নাতিহিং মোসোংপা জোমবিহিং জেজেংপা জো</para>
  <para style="r">(<ref loc="LUK 6:27-28">লুক ৬:২৭-২৮</ref>,<ref loc="LUK 6:32-36">৩২-৩৬</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />“নাবিহা মোসাকো লিংপাংতা এপা লাওয়াহা গেমিরাং নিও, ‘আপনিকো সাবেইবিহিং জেজেংপা জো’ আসা নাতিহিং মোসোংপা জোমবিহিংয়া আচকাপা জো। <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />আদো কা নাবিহিংয়া জাংরোওয়া, নাতিহিং মাসোংপা জোমবিহিংনে জেজেংপা জো। আসা আপনিহিং মাসুংপা জোমবিকো সোতারে পাচাইপি। <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />এপা জোনাহা নাবিহা লোডিংবাতা নিওয়া সেংজা আপাকো চেংওয়া-চেমে জিংরোওয়া, হাংপাতানাহা সেংজাহা মেংতাওয়া আসা এনতাওয়া নিহসোকো সোতারাং সিনি ভ্যহপামগা, এপারাং পাপি আসা তাংজি নিহসোকো সোতারাং ওয়্যাইতি ওয়্যাপামগা। <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />আপনিহিং জেজেংপা জোওয়াবিহিং মেংচে জেজেংপা জোনাহা নাবিহা হাং ইনাম মুংচাকো চুকোগা? এপাহা তোংক্যা জুমবিরে জোমগা। <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />নাবিমি আপনিকো দিংঙাবিহিং মেংচে অভিবাদন জোনাহা, নাবিহা দোসরারোমা হানি টেবো কাম জোমি নিংগাসা? সেংজাহিং মানাইমবিরে এপা জিংওয়া কামহা জোমগা। <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />আকো সোতা লোডিংবাতা নিওয়া নাবিকো সেংজা আপা তাংসা নুওয়াংতা এনতাপা নিমি ত্যাবাপা নাবিরে তাংসা নুওয়াংতা এনতাপা জিং।”<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">মোতোমবিহিং পিচাওয়াকো তোইতা ঝিপাওয়া</para>
  <para style="r">(<ref loc="LUK 11:2-4">লুক ১১:২-৪</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />ইশুহা ন্যাসারাং ঝিপামসা জাংয়ে, “হোশিয়ার য়ুং, নাবিকো তাংজিহা দিংঙাবিহিং তিংপাকো সোতা মোজোঘ্যই। মোকোনাহা নাবিহা লোডিংবাতা নিওয়া নাবিকো সেংজা আপাকোসো হাইরে ইনাম মোমুংরোওয়া।”<verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />“আকো সোতা নাবিহা মোতোমবিহিং হাইক্রি পিচানুওয়া দোসরা দিংঙাবিহিং মাহিংপা, এপাজিংওয়াহা তেপি দিংঙাবি মেংচে দিংঙাবিকোসো প্রশংসা মুংচাকো আসা তিংপাকো সোতা জোংসুওয়া সাবিতা আসা ন্যাতাবিতা জোমগা। আজিপ্পারাং কা নাবিহিং জাংরোওয়া, আবিহা দিংঙাবিকোসো প্রশংসা মুংচামসা আকু ইনামহা মুংচানতেমি নিও। <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />আদো নাবিহা মাতামবিহিং পিচানুওয়া দোসরাহা মাতিংকো।<note caller="+" style="f"><char style="fr" closed="false">৬:৩ </char><char style="ft" closed="false">গ্রিক ক্যাতাহা ই জাংওয়া নাকো দাংক্রেং খুইসো পিচাওয়াহা কেক্রেং খুইহা সিদা মোচোইকো, তাওয়া জিংমগা।</char></note> <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />পিচানুওয়া নাতিহা চিচিপা পিচাপুই আসা চিচিপা পিচানু তিংওয়া সেংজা আপাহা নাতিহিংয়া ইনাম পিচারোওয়া।”<verse eid="MAT 6:4" /></para>
  <para style="s">পাচাইওয়াকো তোইতা ঝিপাওয়া</para>
  <para style="r">(<ref loc="LUK 11:2-4">লুক ১১:২-৪</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />“হাত্রং নাবি পাচাই, আত্রংহা তেপিবি ত্যাবাপা মাজিং, হাংপাতানাহা আবিহা দোসরা দিংঙাবি তিংকো তামসা জোংসুওয়া সাবিতা আসা ন্যাতাকো আবেই আবেইতা জামসা পাচাইকো কেংমগা। আজিপ্পারাং কা নাবিহিং জাংরোওয়া, আবিহা দিংঙাবিকোসো প্রশংসা মুংচামসা আকু ইনামহা মুংচানতেমি নিও। <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />আদো নাবিহা পাচাইদাংনুওয়া সিরি নাপোতা হোমসা লাপুং গি, আসা তিমেওয়া জায়গাতা য়ুংওয়া নাকো সেংজা আপাকোতা পাচাই, আসা চেকেপা জোওয়া কামহিং তিংওয়া নাকো সেংজা আপাহা নাতিহিংয়া ইনাম পিচারোওয়া।”<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />আসা পাচাইনুওয়া সেংজাহিং মানাইওয়া দোসরা জ্যাবিকো জোমি ত্যাবাপা নেকো নেত্তা হাইরে অর্থ মোতোওয়া শব্দসো মাপাচাইগে। পাচাইপুনতেওয়া নুওয়াংকো সোতা ন্যাসা-ন্যাসা মাপাচাইগে। <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />নাবিহা আবি ত্যাবাপা মাজিং, হাংপাতানাহা য়ানুরোমা নাগাইসোরাং নাবিহিং হাং-হাং ঘ্যইকোমে তাংসা নুওয়াংহা নাবিকো সেংজা আপারাং গেমগা।<verse eid="MAT 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9" />“নাবিহা এপা পাচাই:</para>
  <para style="q1" vid="MAT 6:9">‘ও লোডিংবাতা নিওয়া কাবিকো সেংজা আপা,</para>
  <para style="q2" vid="MAT 6:9">নাকো পবিত্র মিংহিং প্রশংসা জিংকো,<verse eid="MAT 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MAT 6:10" />নাকো রাজ্য লেকো,</para>
  <para style="q1" vid="MAT 6:10">নাকো ইচ্ছা লোডিংবাতা ত্যাবাপা ই বাসিমতিতারে তাংসা জিংকো।<verse eid="MAT 6:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="MAT 6:11" />সদাইদিন ঘ্যইওয়া চাওয়া-আংওয়াবি হিনিরে কাবিহিং পিচা,<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />কাবিকো জোওয়া পাপবি কাবিহিং ছমা জোপি,</para>
  <para style="q2" vid="MAT 6:12">হেপা কাবিরে কাবিকো তোইতা পাপ জোমবিহিং ছমা জোপিমি নিমমে।<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />কাবিহিং পাপকো পরিকছাতা মোপুরাপি,</para>
  <para style="q2" vid="MAT 6:13">আদো কাবিহিং দুষ্ট শয়তানসো য়োইপি।</para>
  <para style="q" vid="MAT 6:13">[হাংপাতানাহা রাজ্য, সে আসা প্রশংসাহা হাত্রং জিংদো নাকোরাংগা। আমেন।’]”<verse eid="MAT 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />“নাকো তোইতা মেংতাপা পাপ জোমবিহিং ছমা পিচানাহা, লোডিংবাতা নিওয়া নাকো সেংজা আপারে নাতিহিংয়া ছমা মিচারোওয়া। <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />আদো নাবিমি দোসরাহিং ছমা মিচানাহা নাবিকো সেংজা আপারে নাবিকো পাপহিংয়া ছমা মিচারোওয়া।”<verse eid="MAT 6:15" /></para>
  <para style="s">উপাস য়ুংওয়াকো তোইতা ঝিপাওয়া</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />“হাত্রং নাবি উপাস য়ুং, আত্রংহা নাবিহা তেপিবি ত্যাবাপা নাবিকো য়ুওয়াই নাভিপা জোমসা মোয়ুং, তেপিবিহা উপাস য়ুংয়ে তামসা দোসরাহিং তিংপাকো সোতা য়ুওয়াই নাভিপা জোমসা য়ুংমগা। আজিপ্পারাং কা নাবিহিং জাংরোওয়া, আবিহা দিংঙাবিকোসো প্রশংসা মুংচামসা আকু ইনামহা মুংচানতেমি নিও। <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />নাবিহা উপাস য়ুংনুওয়া আতাংকো ত্যাবাপা পোরোতা চুইতি সুইমসা য়ুওয়াই মিরাচা আসা আপনিকো নামু দুচা। <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />এপা জোনাহা দিংঙাবি মোকো, আদো তিমেওয়া জায়গাতা য়ুংওয়া নাকো সেংজা আপা মেংচে নাকো উপাস য়ুংওয়া তিংরোওয়া আসা নাকো চেকেপা জোওয়া কামবি তিংওয়া নাকো আপাহা নাতিহিংয়া ইনাম পিচারোওয়া।<verse eid="MAT 6:18" /></para>
  <para style="s">লোডিংবাতা দুংপানেওয়া পুংজি</para>
  <para style="r">(<ref loc="LUK 12:33-36">লুক ১২:৩৩-৩৬</ref>, <ref loc="LUK 16:13">১৬:১৩</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />“আপনিকো সোতা বাসিমতিতা পুংজিবি মোদুংপাগে। ইতা দুংপাওয়া পুংজিবিতাহা পেতাবি প্যইরোওয়া, চা চাপুরোওয়া আসা কুইমবি কুচপুরোওয়া। <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />আপনিকো সোতা লোডিংবাতা পুংজিবি দুংপা। আউতাহা পেতারে মাপ্যইরোওয়া, চারে মাচারোওয়া আসা কুইওয়াবিরে মুকুচারোওয়া, <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />হাংপাতানাহা হাংতা নাবিকো পুংজিনি, আউতারাং নাবিকো তু্ংসিংরে নিরোওয়া।<verse eid="MAT 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />“জুপাকো দিব্রিহা মিচোগা। মিচোমি এনতাপা নিনাহা তাংসা জুপারাং হাহাইপা জিংরোওয়া। <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />আদো নাকো মিচোমি মেংতাপা নিনাহা তাংসা জুপারাং নাঘিপা জিংরোওয়া। এপারাং নাকো তুংসিংতা নিওয়া হাহাইওয়াহা নাঘিপা জিংপুনুওয়া আকুহা হাসেকো নাটুংপা জিংকোগা!<verse eid="MAT 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />“হাংসুরে নিহসো গিরিকো কাম জোমক্যইরোওয়া। মোকোনাহা আকুহা ইচোহিংয়া মেংতাপা আসা ইচোহিংয়া জেজেংপা জোরোওয়া, আকুহা ইচোকো জাংওয়া হিংরোওয়া আসা ইচোকোহা মাহিংরোওয়া। এপারাং নাবিরে সেংজা আসা বাসিমতিকো পুংজি নিহসোকোসা সেওয়া জোমক্যইরোওয়া।<verse eid="MAT 6:24" /></para>
  <para style="s">মিসিংদুকো</para>
  <para style="r">(<ref loc="LUK 12:22-31">লুক ১২:২২-৩১</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />“আকো সোতা কা নাবিহিং জাংরোওয়া, বাচেকো সোতা হাং চানেকোমে, হাং আংনেকোমে, আসা জুপাকো সোতা হাং লুচানেকোমে তামসা সিংদুমগ্যই, হাংপাতানাহা চাওয়া আংওয়াবিরোমা সাদি আসা লুচাওয়া আংদুংবিরোমাহা জুপাহা টেবো মোকোমগা? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />ডিংবাতা ভুইওয়া জিয়া-জিপেইবিহিং কাং, আবিহা অংটিবি মামিমগা, মোইপ্যাবি মাচ্যামগা, আসা হাইরে তোপাতা দুংপাকোরে মোদুংপামগা। আদো লোডিংবাতা নিওয়া নাবিকো সেংজা আপাহা আবিহিংয়া চাকো পিচামগা। আকু জিয়া-জিপেইবিরোমা নাবিহা সিওপারাং পাংক্যইপা নিমকোতা? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />নাবিতাহা হাংসু সিংদুমসা আপনিকো সাদিহিং অ্যাইংসি সিওপাকো চুকোগা?<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />“নাবিহা লুচাওয়া আংদুংকো সোতা হাংপা সিংদুমগা? চুংচাতা লোওয়া মাইবেবিহিং কাং, আবিহা কামরে মোজোমগা, লুচাওয়া আংদুংবিরে মাফিমগা, <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />আদো কা নাবিহিং জাংদিংয়ো, সোলোমন জাইপুকোরে এসে পুংজিবি নিদো, আকু মাইবেবি ত্যাবাপা তিংমক্যইতো। <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />হিনিকো নিংওয়া আসা জুকুংকো সেংপুমসা মেহতা চুংপুওয়া সাম্যা-সুতিবিহিংনে সেংজাহা এপা এনতাপা দিংমসা এনাহা আকুহা নাবিহিংয়া লুচাওয়া আংদুংবিহা মিচাকোগা? হানি নাবিকো দেংওয়াহা?<verse eid="MAT 6:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 6:31" />“আকো সোতা হাং চাকোমে, হাং আংকোমে আসা হাং লুচাকোমে তাওয়াতা নাবিহা সিংদুমঘ্যই, <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />হাংপাতানাহা সেংজাহিং মাদেংওয়া দোসরা জ্যাকো দিংঙাবি মেংচে এপা জিংওয়া সিংদুমগা। ই তাংসা নুওয়াংবিহা নাবিহিং ঘ্যইরোওয়া তামসা লোডিংবাতা নিওয়া নাবিকো সেংজা আপারাং গেমি নিও। <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />নাগাইহা সেংজাকো রাজ্যহিং মো, আসা আকো আজ্ঞাবি পালন জো, আসা আকুহা ই তাংসা নাবিহিং পিচারোওয়া। <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />আকো সোতা জুকুং হাং জিংকোমে তামসা সিংদুমঘ্যই, হাংপাতানাহা জুকুং হাং জিংকোমে জুকুংকো দিনরাং সিংদুরোওয়া। হিনিকো কোইচ্যাওয়াহা হিনিকো সোতাহা তেংপা নিও।”<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">দোসরাহিং দোষ মাতিংপা</para>
  <para style="r">(<ref loc="LUK 6:37-38">লুক ৬:৩৭-৩৮</ref>,<ref loc="LUK 6:41-42">৪১-৪২</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />ইশুহা ন্যাসারাং জাংয়ে, “দোসরাহিং দোষ মাটিংপা, আসা সেংজারে নাবিহিংয়া দোষ মাটিংপারোওয়া। <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />হাংপাতানাহা হেপা নাবি দোসরাবিহিং দোষি তিংপামে, এপারাং সেংজারে নাবিহিংয়া দোষি তিংপারোওয়া। হেপা নাবি দোসরাহিং জোমমে, এপারাং সেংজারে নাবিহিংনে জোরোওয়া।”<verse eid="MAT 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3" />“নাবিহা দোসরাকো মিচোকো সিংচা তিংমগা, আদো আপনিকো মিচোকো সিংদ্রাংহা হাংপাসা মাতিংমগা? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />নাবিকো আপনিকো মিচোতা সিংদ্রাং নিনাহা, আপনিকো আপু-এবিহিংয়া হেপা জাংকো চুকোগা? ‘হানি কা নাকো মিচোকো সিংচা নোপাপিরে তামসা।’ <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />ও তেপিবাই! নাগাইহা নাকো আপনিকো মিচোকো সিংদ্রাংহিং নোপা, আসো মেংচে দোসরাকো মিচোকো সিংচা নোপাকো চোসোপা তিংরোওয়া।”<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />হানি পবিত্রনি, আকুহা খিয়াবিহিং মিচাগে, মোকোনাহা আকু খিয়াবিহা তুইপেং হুরামসা নাবিহিংনাং চিরোওয়া। নাবিকো মোতিবিহা পাকাবিকো নাগাইতা মাবাডোই, মোকোনাহা আকু পাকাবিহা আকুহিংয়া হিনদ্যা-চিদ্যাপুরোওয়া।<verse eid="MAT 7:6" /></para>
  <para style="s">য়াচা, মোচা আসা বেচা</para>
  <para style="r">(<ref loc="LUK 11:9-13">লুক ১১:৯-১৩</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />“য়াচা, নাবিহা মুংচারোওয়া। মোচোই, নাবিহা দোচারোওয়া। লাপুংবেচা, নাবিকো সোতা ওয়েপিরোওয়া। <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />হাংপাতানাহা য়াচামবিহিংয়া পিচারোওয়া, মোচোইমবিহা দোচারোওয়া আসা লাপুং বেচামবিকো সোতাহা ওয়েপিরোওয়া। <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />নাবিতাহা হাংসু এপাজিংওয়া আপা নিংগা, আপনিকো চেংওয়া কোব্রেং য়ানুওয়া লুংটুই পিচাওয়া? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />আসা নায়া য়ানুওয়া পুইয়া পিচাওয়া? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />এপারাং নাবিহা মেংতাপা জিংমসারে আপনিকো চেংওয়া-চেমেবিহিং এনতাওয়া নুওয়াংবি পিচাকো গেনাহা আকুরোমা লোডিংবাতা নিওয়া নাবিকো সেংজা আপাহা আকোতা য়াচামবিহিংয়া ঝান হাসে এনতা-এনতাওয়া নুওয়াংবি পিচাকোগা।<verse eid="MAT 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />“দিংঙাবিহা নাবিহিং হেপা জোপিকো তামসা নাবি নোমমে, এপারাং নাবিরে আবিহিং জোপ্পি। ইরাং মোসাকো লাওয়া তাংজিকো লিংপাং আসা অগমবক্তাবিকো জাংতেওয়া মাটা নুওয়াংগা।<verse eid="MAT 7:12" /></para>
  <para style="s">টেবো আসা আপেচওয়া লাপুং</para>
  <para style="r">(<ref loc="LUK 13:14">লুক ১৩:১৪</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />“আপেচাওয়া লাপুংসো সেংজাকো রাজ্যতা হোতু, হাংপাতানাহা টেবো লাপুং আসা টেবো ন্যাতাহা নরকতা পুরামগা। ই ন্যাতাসো হোমবিহা উইসে নিমগা। <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />আপেচাওয়া লাপুংসো আপেচাওয়া ন্যাতাহা হ্যামরাপা জিংমগা, আদো আকুরাং সাদিতা চোইপামগা। ই ন্যাতাহিং দোচওয়াবিহা সিওপা মাতামগা।<verse eid="MAT 7:14" /></para>
  <para style="s">দিংঙাহিংয়া আকো কামসোরাং নাইমগা</para>
  <para style="r">(<ref loc="LUK 6:43-46">লুক ৬:৪৩-৪৬</ref>, <ref loc="LUK 13:25-27">১৩:২৫-২৭</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />“প্যায়োং অগমবক্তাবিকোসো হোশিয়ার য়ুং, আবিহা বাইরেসোহা লুকা ত্যাবাপা জিংমসা ওয়াংরোওয়া, আদো নাপোসোহা চুসুং-মাইসুংক্যইওয়া চুংচাকো দোমা ত্যাবাপা জিংরোওয়া। <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />নাবিহা আবিহিংয়া আবিকো কামসোরাং নাইরোওয়া। সোসাকো সিংতেংসোহা আংগুর আসা লুংদিংকো সিংতেংসো মুইরাসে সেকোগা? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />এপা জোমসারাং এনতাওয়া সিংতেংসোহা এনতাওয়া ফল সেমগা। আদো মেংতাওয়া সিংতেংসোহা মেংতাওয়া ফলরাং সেমগা। <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />এনতাওয়া সিংতেংহা মেংতাওয়া ফল সেমক্যইমগা, আসা মেংতাওয়া সিংতেংরে এনতাওয়া ফল সেমক্যইমগা। <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />এনতাপা ফল মেশেওয়া তাংসা সিংতেংবিহিংয়া নেমসা মেহতা বাডোইপুরোওয়া। <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />এপারাং নাবিরে অগমবক্তাবিহিংয়া আবিকো কাম জোওয়াবিসোরাং নাইরোওয়া।<verse eid="MAT 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />“কাহিং ‘প্রভু, প্রভু’ তাওয়াবিতাহা লেরাহা সেংজাকো রাজ্যতা হোচা মামুংরোওয়া। লোডিংবাতা নিওয়া কুং আপাকো ইচ্ছা সেই কাম জোমবি মেংচে হোচা মুংরোওয়া। <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />ন্যায় জোওয়া দিনতাহা উইসে দিংঙাবিহা কাহিং এপা জাংরোওয়া, ‘প্রভু, ও প্রভু, কাবিহা নাকো মিংতা আগমবাণী মায়্যইংগা? নাকো মিংকো সে লাংমসা জেসাংবি মোনোপাংগা? আসা নাকো মিংতা আআংপেপেচপুওয়া কামবি মোজোংগা?’ <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />আত্রংহা কা আবিহিংয়া জাংরোওয়া, ‘ও মেংতাপা কাম জোমবাই! নাবিহিংয়া কা মানাইয়াংনা। কুংসো তানাং হ্যাতু।’<verse eid="MAT 7:23" /></para>
  <para style="s">সাকো নিহদ্যা হুটিং</para>
  <para style="r">(<ref loc="LUK 6:43-49">লুক ৬:৪৩-৪৯</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />“আজিপ্পারাং, কুং জাংওয়া ই নুওয়াং হিংমসা জোমবিহা সাডুংওয়া পাত্যারুংতা হুটিং চুমসা আপনিকো সা বানাইওয়া দুংজি নিওয়া দিংঙা ত্যাবাপা জিংমগা। <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />সা বানাই পুনতেনুওয়া টেবো ওয়্যাতি ওয়্যায়ে, ব্যান্যা হ্যায়ে, বিংঙা হ্যায়ে, আসা আকু সাতা সুচপুয়ে, আদো আকু সাহা ম্যাহ্যাতো, হাংপাতানাহা আকুহা সাডুংওয়া লুংটুইতা হুটিং চুউমসা বানাইওয়া সা নিমগা।<verse eid="MAT 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 7:26" />“আদো হাংসু কুং জাংওয়া হিংমসারে মোজো, আবিহা বার্পুইকো তোইতা সা বানাইওয়া তৌউজি দিংঙা ত্যাবাপা জিংমগা। <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />সা বানাইপুনতেনুওয়া ওয়্যাতি ওয়্যায়ে, বান্যা হ্যায়ে, বিংঙা হ্যায়ে আসা আকু সাতা সুচপুয়ে, আসা আকু সাহা হ্যাপুমসা বিনাশ জিংপুয়ে।”<verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />ইশুহা এপা জিংওয়া নুওয়াং ঝিপাপুনতেনুকো নোইতাহা আকু হিংদিংওয়া উইসে দিংঙাবিহা আআংপেপেপা জিংপুয়ে, <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />হাংপাতানাহা আকুহা দোসরা তাংজিকো উটকেওয়াবি বেপা মোকোপা, আদো ইচো অধিকার নিওয়া দিংঙা ত্যাবাপা জিংমসা ঝিপাচাংমি।<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">ইশু য্যা চাপুওয়া দিংঙাহিং সাংপাওয়া</para>
  <para style="r">(<ref loc="MRK 1:40-45">মর্কুস ১:৪০-৪৫</ref>; <ref loc="LUK 5:12-16">লুক ৫:১২-১৬</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />ইশু য়্যাগ্যইসো লেতা উইপাদাংনুওয়া উইসে দিংঙাবিহা আকো নুনুই হুইপায়ে। <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />আত্রংরাং ইচো য্যাসো মেইপুওয়া দিংঙা লেমসা আকো কোকোইতা নোংরেমসা জাংয়ে, “উটকেওয়া, নাতিবেমি সাংপাকো কেংনাহা কাহিংয়া সাংপাকো চুরোওয়া।”<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />ইশুহা আকো তোইতা খুই এমসা জাংয়ে, “নাতি সাংকো তামসা কা কেংরোওয়া।” আত্রংতারাং আকো য্যাহা সাংচপুয়ে। <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />ইশুহা আকুহিংয়া জাংয়ে, “কাং, ই নুওয়াংহা হাংসুহিংনে মাজাং। আদো পাউবিকোতা হোমসা আপনিহিং তিংপা আসা মোসাকো লাতেওয়া লিংপাংতা ত্যাবাপা ভেটি পিচামসা তাংসাহিং নাতিহা সাংতেয়ো তামসা প্রমান পিচা।”<verse eid="MAT 8:4" /></para>
  <para style="s">রোমি কেপ্ট্যাইনকো ডেইয়া সাংওয়া</para>
  <para style="r">(<ref loc="LUK 7:1-10">লুক ৭:১-১০</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />ইশু কোর্ফরনহুম শহরতা ওয়াংনুওয়া ইচো রোমি কেপ্ট্যাইন ওয়াংমসা আকুহিং জাংচায়ে, <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />“ও প্রভু, কুং ডেইয়াহা তেইমক্যইওয়া য়োংন্যা নিওয়াকো সোতা নেহা দুঃখ মুমসা ন্যাগুতা জিংদিংনা।”<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />ইশুহা আকুহিংয়া জাংয়ে, “কা ওয়াংমসা আকুহিং সাংপারোওয়া।”<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />আদো কেপ্ট্যাইনহা জাংয়ে, “ও প্রভু, নাতিহা কুং সাতা ওয়াংনেক্যইপা এসেপাকো টেবো কা মোকো, আদো য়্যইদি মেংচে জাংপি, কুং ডেইয়াহা সাংচপুরোওয়া। <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />হাংপাতানাহা কারে কাইজিবিকো অধিকারতা নিও, আসা কুং অধিকারতারে সিপাইবি নিও। কা ইচোহিং ‘হ্যাতু’ তানাহা আকুহা হ্যামগা, আসা দোসরাহিং ‘ওয়াং’ তানাহা আকুহা ওয়াংমগা। কুং ডেইয়াহিং ‘এপা জো’ তানাহা আত্রংহা আকুহা জোমগা।”<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />ই নুওয়াং হিংমসা ইশুহা আআংপেপেচপুয়ে আসা আপনিকো নুনুই হুইওয়া দিংঙাবিহিং জাংয়ে, “আজিপ্পারাং কা নাবিহিং জাংরোওয়া, এসেপাকো টেবো দেংওয়া নিওয়া দিংঙাহা কাহা ইস্রাইলিবিকো প্যাকোতারে মোদোয়াংতো। <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />কা নাবিহিং জাংরোওয়া, নুসো আসা দিসোহা দোসরা জ্যাকো দিংঙা উইসে লেরোওয়া, অব্রাহাম, ইসাহাক আসা য়াকুবহিংপা লোডিংবাকো রাজ্যতা চাওয়া-আংওয়াতা গারোওয়া। <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />আদো সেংজাকো রাজ্যতা য়ুংকো তামসা জেংওয়া ইস্রাইলিবিহা বাইরে নাঘিওয়াতা বাডোইচাপুরোওয়া আসা আউতাহা আবিহা কাইরোওয়া আসা সেতাং কিট্টিওয়া।”<verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />আকো নোইতাহা ইশুহা জাংয়ে, “তুরোওয়া, নেহা নাতিহা হোপুই, নাকো দেংমি ত্যাবাপারাং জিংরোওয়া।” আত্রংরাং কেপ্ট্যাইনকো ডেইয়াহা সাংচপুয়ে।<verse eid="MAT 8:13" /></para>
  <para style="s">উইসে দিংঙাবি সাংওয়া</para>
  <para style="r">(<ref loc="MRK 1:29-34">মর্কুস ১:২৯-৩৪</ref>; <ref loc="LUK 4:38-41">লুক ৪:৩৮-৪১</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />আকো নোইতা ইশুহা পত্রসকো সাতা হোয়ে। আউতা আকুহা পত্রসকো জুমেহিংয়া চোরোউ-চোরোউপা হাইমসা জিংদিংওয়া তিংয়ে। <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />ইশুহা আকো খুই সুয়ে আসা আকো হাইওয়াহা সাংচপুয়ে। আকুহা লোমসা আকুহিং চাওয়া-আংওয়াবি পিচায়ে।<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />জিরুং জিংপুনুওয়া দিংঙাবিহা সিংঙো দ্যইংচপুওয়া আসা উইসে হাইমবিহিং ইশুকোতা পারায়ে। ইশুহা আপনি য়্যইমসারাং সিংঙোবিহিং নোপায়ে আসা তাংসা হাইওয়াবিহিং সাংপায়ে। <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />এপারাং এশাইয়া অগমবক্তাকো জাংওয়া নুওয়াংহা তাংসা জিংয়ো:</para>
  <para style="q" vid="MAT 8:17">“আকুরাং য়োংকো জুপাকো য়োংন্যা</para>
  <para style="q" vid="MAT 8:17">আসা হাইওয়া-মোংওয়াবিহা আপনিরাং পুচায়ে।”<note caller="+" style="x"><char style="xo" closed="false">৮:১৭ </char><char style="xt" closed="false"><ref loc="ISA 53:4">এশাইয়া ৫৩:৪</ref></char></note><verse eid="MAT 8:17" /></para>
  <para style="s">নিহসো য়োংতোংবি ইশুকো নুনুই হুইদাংওয়া</para>
  <para style="r">(<ref loc="LUK 9:57-62">লুক ৯:৫৭-৬২</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />ইশুহা আপনিকো হুরাপা উইসে দিংঙা তিংমসা আপনিকো য়োংতোংবিহিং জাংয়ে, “তে, য়াংবিহা দাব্রিকো নুব্যাতা হ্যাকো।” <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />আত্রংরাং ইচো তাংজিকো উটকেওয়াহা আকোতা ওয়াংমসা জাংয়ে, “উটকেওয়া, নাতি হাংতা হ্যাবা কারে নাতিহিংপারাং হ্যারো।”<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />ইশুহা আকুহিংয়া জাংয়ে, “কাং, মাংস্রিবিকোহা গুংচোইকো হোরোংবা আসা জিয়া-জিপেইবিকোহা বাসা নিও, আদো দিংঙাকো চেংওয়াকোহা পোরো একো জায়গারে মোতো।”<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />আসা য়োংতোংবিকো প্যাকোতাহা ইচোহা জাংয়ে, “প্রভু, নাগাইহা কাহিং হোমসা কুং আপাকো সিপুওয়া জুপা লিকাকো পিচা।”<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />ইশুহা আকুহিংয়া জাংয়ে, “নাতিহা কুং নুনুই হুই, সিপুওয়া জুপাবিহা আবিরাং আপনিকো সিপুওয়া জুপাহিং লিচপুকো।”<verse eid="MAT 8:22" /></para>
  <para style="s">ইশুহা বিংঙা জেসেহিং সাংপাওয়া</para>
  <para style="r">(<ref loc="MRK 4:35-41">মর্কুস ৪:৩৫-৪১</ref>; <ref loc="LUK 8:22-25">লুক ৮:২২-২৫</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />ইশুহা নোওয়াইতা বাইয়ে আসা য়োংতোংবিরে আকুহিংপারাং চিত্তা ঝাহাদিকো নুব্যা হ্যাদাংয়ে। <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />একবিরি ঝাহাদিতা টেবো বিংঙা হ্যায়ে। তিকো চুরা লোমসা নোওয়াইহিংনাং নুপাপুদাংয়ে, আদো ইশুহা নোওয়াইতারাং জিংদিংওয়া নিমি। <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />আসা য়োংতোংবিহা ইশুহিংয়া এপা জাংমসা টুসুয়ে, “বাচাইপি প্রভু! য়াংবিহা নুচপুমসা সিপুদাংতেনা।”<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />ইশুহা আবিহিংয়া জাংয়ে, “নাবিহা হাংপা চুসুংমগা? হানি নাবিকো দেংওয়াহা?” আসা লোমসা আকুহা বিংঙা আসা ঝাহাদিহিং চিংচাইয়ে, আসা আকু চিংচাইনতানি বিংঙা আসা ঝাহাদিহা চিচোপুয়ে। <verse eid="MAT 8:26" /><verse number="27" style="v" sid="MAT 8:27" />এপা জিংওয়া তিংমসা আবি তাংসা আআংপেপেচপুয়ে আসা জাংয়ে, “ইহা হেপাজিংওয়া দিংঙা মেতা? ইকো জাংওয়াহা বিংঙা জেসে আসা ঝাহাদিবিরে হিংমুং।”<verse eid="MAT 8:27" /></para>
  <para style="s">সিংঙো দ্যইংচপুওয়া নিহসো দিংঙা</para>
  <para style="r">(<ref loc="MRK 5:1-20">মর্কুস ৫:১-২০</ref>; <ref loc="LUK 8:26-39">লুক ৮:২৬-৩৯</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />ইশু ঝাহাদিকো নুব্যাই গদরিনিবিকো জায়গাতা দেরেনুওয়া আউতাহা তোম্যইবিরিসো সিংঙো দ্যইংচপুওয়া নিহসো দিংঙাবিহা আকুহিং দোসুয়ে। আবিহা সিওপারাং চুসুংমাইসুক্যইপা নিমি। আকো সোতা আকু জায়গাসোহা হাংসুরে তেইমক্যইমি। <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />আবিহা এপা জাংমসা ঙাসুয়ে, “ও সেংজাকো চেংওয়া, নাতিহা কাবিহিং হাং জোকো ওয়াংমগা? ন্যায় জোকো সময় মাজিংয়াংদো নাতিহা কাবিহিং দুঃখ পিচাকো ওয়াংমগা?”<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />আবিকোসো আস্যস্যই তানাংতা উইসে পাকাবিকো পারা য়োচোইদিংমি। <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />আসা আকু সিংঙোবিহা ইশুহিং জাংচায়ে, “কাবিহিংমি নোপাপুদানাহা আকু পাকাবিকো নাপোতা হোকো পিচা।”<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />আসা ইশুহা আকু সিংঙোবিহিংয়া জাংয়ে, “হোপুই!” আত্রংহা আবিহা নিহসো দিংঙাকোসো নোপুমসা পাকাবিকো নাপোতা হোপুয়ে। আসা পাকাকো পারাবিহা তাংসা য়্যাগ্যইসো ট্যইংমসা ঝাহাদিতা নুচপুমসা সিপুয়ে।<verse eid="MAT 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 8:33" />পাকা ল্যাচোইমবিহা ক্যাপুয়ে, আসা শহরতা হোমসা তাংসা নুওয়াং আসা আকু সিংঙো দ্যইংচপুওয়াবিহিংয়া হাং জিংপুমমে আকু তাংসা হিংপায়ে। <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />ই নুওয়াং হিংমসা শহরকো তাংসা দিংঙাবিহা ইশুহিং দোসপাকো লেয়ে, আসা আকুহিং তিংমসা দিংঙাবিহা আবিকো জায়গাসো হ্যাপুই তামসা আকুহিংয়া জাংচায়ে।<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">ইচো সাঁপে দিংঙা সাংওয়া</para>
  <para style="r">(<ref loc="MRK 2:1-12">মর্কুস ২:১-১২</ref>; <ref loc="LUK 5:17-26">লুক ৫:১৭-২৬</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />আকো নোইতা ইশুহা নোওয়াইতা বাইপুমসা ঝাহাদিকো দিব্যা আপনিকো য়ুংওয়া শহরতা লায়োংয়ে। <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />আসা দিংঙাবিহা ইচো সাঁপেহিং ন্যাগু নিপারাং পুপামসা আকোতা পারায়ে। আকু দিংঙাবিকো দেংওয়া তিংমসা ইশুহা আকু সাঁপেহিং জাংয়ে, “ও চেংওয়া, নাতিহা সাডুংপা জিং, নাকো পাপহা ছমা জিংপুনতেয়ো।”<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />ইশুকো ই নুওয়াং জাংওয়া হিংমসা ইচো নিহসো তাংজিকো উটকেওয়াবিহা তাইবিলারাই জাংসুয়ে, “ই দিংঙাহা সেংজা ত্যাবাপা জোমসা পাপহিং ছমা জিংয়ো তামসা সেংজাহিং নিন্দা জোয়ো।”<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />আবিকো তুংসিংকো নুওয়াং কোইমসা ইশুহা জাংয়ে, “নাবিহা তুংসিংতা হাংপা এপাজিংওয়া মেংতাওয়া নোচেং নোমগা? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />নেহা জাংকে, ই দিংঙাহিংয়া ‘নাকো পাপ ছমা জিংয়ো তাকো’ মোকোনাহা ‘লোমসা হোতু’ তাকো হানি জাংতোংপা নিংগা? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />আদো কাং, ই বাসিমতিতা দিংঙাকো চেংওয়াহা দিংঙাকো পাপহিং ছমা জোওয়া অধিকার নিও তামসা নাবিহা গেকো ছুকো।” আসা আকুহা আকু সাঁপেহিং জাংয়ে, “লো, আসা আপনিকো ন্যাগু য়োপুমসা সাতা হোতু।”<verse eid="MAT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7" />আত্রংহা আকু দিংঙাহা তাত্রিংপা লোমসা সাতা হোপুয়ে। <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />ই আআংপেপেচপুওয়া কাম তিংমসা আকু দিংঙাবিহা চুসুংপুয়ে। সেংজাহা দিংঙাহিং এপা জিংওয়া সে পিচাওয়া তিংমসা আবিহা আকুহিংয়া প্রশংসা জোয়ে।</para>
  <para style="s" vid="MAT 9:8">ইশুহা মথিহিং মোউওয়া</para>
  <para style="r" vid="MAT 9:8">(<ref loc="MRK 2:16-17">মর্কুস ২:১৬-১৭</ref>; <ref loc="LUK 5:27-32">লুক ৫:২৭-৩২</ref>)</para>
  <para style="p" vid="MAT 9:8">
    <figure style="fig" file="lb00309.jpg" size="col" ref="৯:৮" /> <verse eid="MAT 9:8" /><verse number="9" style="v" sid="MAT 9:9" />ইশুহা আউসো হ্যাদাংনুওয়া মথি মিং নিওয়া ইচো দিংঙাহিং তোংক্যা জুমবিকো গাচাংওয়া জায়গাতা গাদিংওয়া তিংয়ে, আসা আকুহিং জাংয়ে, “কুং নুনুই লেই।” আসা আকুহা লোমসা আকো নুনুই হুইপুয়ে।<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />আসা জিরুং মথিকো সাতা চাকো গানুওয়া, উইসে তোংক্যা জুমবি আসা দোসরা পাপিবি লেমসা ইশু আসা আকো য়োংতোংবিহিংপা চাকো গায়ে। <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />হাত্রং ইচো নিহসো ফরিসিবি ই তিং, আত্রংহা আবিহা ইশুকো য়োংতোংবিহিং জাংয়ে, “নাবিকো উটকেওয়াহা হাংপাসা তোংক্যা জুমবি আসা দোসরা পাপিবিহিংপা চাচাংমগা?”<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />ইশুহা ই হিংমসা জাংয়ে, “মাহাইমবিহিংয়া ডাক্তার মোঘ্যইমগা, আদো হাইমবিহিংয়া ঘ্যইমগা। <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />আদো নাবিহা তাংজিকো হিগাতা লাওয়া ই নুওয়াংহা হাং জাংকো কেংমে তামসা কোইকো জো, ‘কাহিংয়া বলিদান মোকো, নাবিকো লামতুওয়া ঘ্যইরোওয়া।’ হাংপাতানাহা কা তাংজি নিওয়াবিহিং মোকো, আদো পাপিবিহিং বাচাইকো লেমগা।”<verse eid="MAT 9:13" /></para>
  <para style="s">উপাস য়ুংওয়াকো তোইতা উইওয়া</para>
  <para style="r">(<ref loc="MRK 2:18-22">মর্কুস ২:১৮-২২</ref>; <ref loc="LUK 5:33-39">লুক ৫:৩৩-৩৯</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />আকো নোইতা বাপ্তিস্মা পিচাওয়া য়হুন্নাকো য়োংতোংবিহা ইশুকোতা লেহে আসা আকুহিং উইয়ে, “কাবি আসা ফরিসিবিহা হাত্রংদো উপাস য়ুংচামগা। আদো হাংপা নাকো য়োংতোংবিহা উপাস মায়ুংমগা?”<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />ইশুহা আবিহিং জাংয়ে, “বিয়ৌতা হোনুওয়া বিয়ৌলা চিত্তা নিনু চোইপা দিংঙাবিহা লোচোপেংঙেংপা জোমসা য়ুংকোগা? আদো আকু দিন দেয়োংরোওয়া, হাত্রং আবিহিংপা বিয়ৌলাহিং ওয়েংপাপুই, আত্রংহা আবিহা উপাস য়ুংরোওয়া।<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />“হাংসুরে জেবে আংদুংতাহা চুবে আংদুং মোতোরোওয়া, হাংপাতানাহা চুবে আংদুংমি তোনাহা জেবে আকু আংদুংহা চোংচপুমসা ন্যাসারাং সিওপা য়াইপুরোওয়া।<verse eid="MAT 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 9:17" />“হাংসুরে জেবে বেকোংকো জিয়োতাহা চুবে আংগুরকো য়ু মোওয়্যাইরোওয়া, মোকোনাহা জিয়োহা ওয়্যাপুরোওয়া, আসা য়ুরে ক্যাপুরোওয়া, আসা জিয়োরে মেংতাপা জিংপুরোওয়া। চুবে আংগুরকো য়ুহা চুবে বেকোংকো জিয়োতারাং এনেমগা, আসা নিহসোসা এনতাপা জিংমগা।”<verse eid="MAT 9:17" /></para>
  <para style="s">য়াইরোসকো চেমে</para>
  <para style="r">(<ref loc="MRK 5:21-43">মর্কুস ৫:২১-৪৩</ref>; <ref loc="LUK 5:33-39">লুক ৫:৩৩-৩৯</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />ইশু ই নুওয়াং জাংওয়া কোকোইত্তা আউতা ইচো য়হুদিবিকো মাটা দিংঙা দেয়োংয়ে। আকুহা ইশুকো কোকোইতা নোংমসা জাংচায়ে, “উটকেওয়া, কুং চেমেহা নেগাতিগা সিপুনা, আদো নাতিমি ওয়াংমসা আকো তোইতা খুই ওইপিনাহা আকুহা ঙারোরোওয়া।”<verse eid="MAT 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 9:19" />ইশুহা লোপুমসা আকুহিংপারাং হোয়ে আসা য়োংতোংবিরে আকো নুনুই হুইপুয়ে।<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />আত্রংরাং ইচো লো বার্নিংসো য়ুতি মাচ্যাওয়া মেমেহা নুনুইসো লেমসা ইশুকো আংদুংকো আরিহিং সুয়ে, <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />হাংপাতানাহা আকুহা আকো “আংদুং মেংচে সুচা মুংদো কাহা সাংপুরোওয়া তামসা নোমি নিমি।”<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />ইশু নোই ল্যামসা কাংনুওয়া আকু মেমেহিং তিংয়ে, আসা জাংয়ে, “চেমে সাডুংপা জিং, নাকো দেংওয়াসো নাতিহিংয়া সাংপামি নিও।” আত্রংতারাং আকু মেমেহা সাংচপুয়ে।<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />আসা ইশুহা মাটা য়াইরসকো সাতা দেকায়ে, আকুহা আউতা সিপুওয়া জুপাহিং লিকাদাংনুকো বাশি মুইওয়াবি আসা উইসে দিংঙাবিহা চিলিংসুমসা কাইসুদিংওয়া তিংয়ে। <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />ইশুহা আবিহিং জাংয়ে, “বাইরেতা হ্যাতু, হাংপাতানাহা চেমেহা মিসিয়াংতো, আদো জিংদিংনা।” আবিহা আকো এপাজাংওয়া হিংমসা লেংসুয়ে। <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />তাংসাহিং বাইরে নোপাপুনতেনুওয়া আকুহা নাপোতা হোয়ে, আসা আকু চেমেকো খুই সুয়ে, আসা আকু চেমেহা তাত্রিংপা লোয়ে। <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />আসা আকু নুওয়াংহা আকু লুংবিকো তাংসা জায়গাতা বেইপুয়ে।<verse eid="MAT 9:26" /></para>
  <para style="s">মিচো মাতিংওয়া নিহসো দিংঙাবি</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />ইশুহা আকু জায়গাহিং হুইতেমসা হ্যাদাংনুওয়া নিহসো মিচো মাতিংওয়া দিংঙাবিহা “ও দাউদকো চেংওয়া, কাবিকো তোইতা লামতুপি” তামসা আকো নুনুই নুনুই হুইপুয়ে।<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />আকু সাতা দেকানতেনুকো নোইতাহা আকুহা সাকো নাপোতা হোয়ে, আসা আকু নিহসো মিচো মাতিংওয়া দিংঙাবিরে ইশু নিওয়াতা দেয়োংয়ে। ইশুহা আবিহিংয়া জাংয়ে, “কা ইহা জোকো চুরোওয়া তামসা নাবিহা দেংমগা?”</para>
  <para style="p" vid="MAT 9:28">আবিহা আকুহিংয়া “ওই প্রভু” তামসা জাংসুয়ে।<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />আত্রংহা আকুহা আবিকো মিচো সুমসা জাংয়ে, “নাবিকো দেংমি ত্যাবাপারাং নাবিহিংয়া জিংকো।” <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />আসা আবিহা তিংকো চুয়ে। ইশুহা আবিহিংয়া “ই নুওয়াং হাংসুহিংনে মাজাংকো তামসা আজ্ঞা জোয়ে।” <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />আদো আবিহা হোয়ে, আসা আকু লোইকো তাংসা জায়গাতা আকো নুওয়াং হিংপায়ে।<verse eid="MAT 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />আসা আবি হোপুনতেনুকো নোইতা দিংঙাবিহা ইচো সিংঙো দ্যইংচপুমসা য়্যইমক্যইওয়া দিংঙাহিং ইশুকোতা পারায়ে। <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />ইশু জেসাং নোপাপুনতানি আকু লেংবাহা য়্যইকো চুপুয়ে, আসা উইসে দিংঙাবিহা “ইস্রাইয়েল লোইতা এপাজিংওয়া হাত্রংরে মাতিংয়াংতো” তামসা আআংপেপেচপুয়ে।<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />আদো ফরিসিবিহা জাংসুয়ে, “জেসাংবিকো গিরিকো সেসো ইহা জেসাংবি নোপাচাংমগা।”<verse eid="MAT 9:34" /></para>
  <para style="s">ইচো নিহসো লুকুইবি</para>
  <para style="r">(<ref loc="MRK 6:34">মর্কুস ৬:৩৪</ref>; <ref loc="LUK 10:2">লুক ১০:২</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />ইশুহা তাংসা শহর আসা লোইকো জোংসুওয়া সাবিতা ঝিপামসা সেংজাকো রাজ্যকো এনতাওয়া দেরেং হিংপামসা তাংসা দিংঙাবিকো য়োংন্যাবি সাংপামসা তেইয়ে। <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />উইসে দিংঙাবিহিং তিংমসা আকো তুংসিংহা আবিকো তোইতা লামতুপুয়ে, হাংপাতানাহা আবিহা গোইত্র মাতাওয়া লুকাবি ত্যাবাপা দুঃখ মুংওয়া আসা লাংচ্যা দিংঙাবি ত্যাবাপা নিমি। <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />আকুহা য়োংতোংবিহিং জাংয়ে, “মোইপ্যাহা উইসে নিও, আদো লুকুইবিহা লিয়োপা নিও। <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />নাবিহা মোইপ্যাকো গিরিহিংপা মোইপ্যা য়োওয়া লুকুইবি নিংপিকো তামসা পাচাই।”<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">ইশু বার্চো য়োংতোংবিহিং মোউওয়া</para>
  <para style="r">(<ref loc="MRK 3:13-19">মর্কুস ৩:১৩-১৯</ref>, <ref loc="MRK 6:7-13">৬:৭-১৩</ref>; <ref loc="LUK 6:12-16">লুক ৬:১২-১৬</ref>, <ref loc="LUK 9:2-6">৯:২-৬</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />ইশুহা বার্চো য়োংতোংবিহিং মোউমসা সিংঙোবিহিং নোপাওয়া আসা তাংসা য়োংন্যা, হাইওয়া-মোংওয়াবিহিং সাংপাওয়া অধিকার পিচায়ে। <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />ই বার্চো জেংওয়া পোইংবিহা ইবিরাংগা:</para>
  <para style="q" vid="MAT 10:2">নাগাইহা পত্রস তাওয়া সিমোন আসা</para>
  <para style="q" vid="MAT 10:2">আকো এ আনড্রিয়াস,</para>
  <para style="q" vid="MAT 10:2">জোব্দিকো চেংওয়া য়াকুব আসা আকো এ য়হুন্না,<verse eid="MAT 10:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MAT 10:3" />ফিলিপ আসা</para>
  <para style="q" vid="MAT 10:3">বারথোলোমাই,</para>
  <para style="q" vid="MAT 10:3">থোমা আসা</para>
  <para style="q" vid="MAT 10:3">তোংক্যা জুওয়া মথি,</para>
  <para style="q" vid="MAT 10:3">অল্পোয়সকো চেংওয়া য়াকুব,</para>
  <para style="q" vid="MAT 10:3">থেদিয়োস,<verse eid="MAT 10:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MAT 10:4" />আসা দেশকো সোতা লুইসুওয়া সিমোন আসা</para>
  <para style="q" vid="MAT 10:4">য়হুদা ইস্করিয়োত, (আকুহা ইশুহিং প্যইপাওয়াগা)।<verse eid="MAT 10:4" /></para>
  <para style="s">বার্চো য়োংতোংবিকো কাম</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />ইশুহা আকু বার্চোহিংয়া এপা জাংমসা নিংপুয়ে, “নাবিহা দোসরা জ্যাকো দিংঙাবিকোতা আসা সামরিবিকো শহরবিতা মোহো। <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />আদো য়াংপুওয়া লুকাবি ত্যাবাপা ইস্রাইলিবিকোতা হোতু। <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />আসা দিংঙাবিহিং ‘সেংজাকো রাজ্যহা আবেইতা দেপাদাংতেয়ে’ তামসা হিংপা। <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />হাইমবিহিং সাংপা, সিপুমবিহিং ঙারোপা, য্যা চাপুমবিহিং সাংপা আসা জেসাংবিহিং নোপা। নাবিহা এপারাং মুংচায়ো দোসরাবিহিংনে এপারাং পিচা। <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />সুন, জাতাং আসা তামাকো ইচে ন্যাস্যারে মোপুগে। <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />দোসরা লোইতা হোদাংনুওয়া সিপি, আংদুং, কোরোং আসা জুচোইওয়া দ্রোইংরে মোপুগে, হাংপাতানাহা লুকুইবিহা ঘ্যইওয়া সেই তাংসা মুংচানেরোওয়া।<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />“হানি শহর আসা লোইতা নাবি হো, আউতা হাংসু দেংকো চুওয়া দিংঙানি, আকুহিং মো, আসা আকু লোইহিং মাহুইতেনু চোইপা আকোতারাং য়ুং। <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />আকো সাতা হোদাংনুওয়া নাতিহিং তিমেপা জিংকো তামসা জাং। <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />আকু সাতামি তিমেওয়া য়ুচকোবেওয়া দিংঙা নিনাহা, নাবিকো তিমেওয়াহা আকু সাতা য়ুংরোওয়া। আদো আকুমি তিমেওয়া য়ুচকোবেপা মাতানাহা, নাবিকো তিমেওয়াহা নাবিকোতারাং লায়োংপুরোওয়া। <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />দোসরামি নাবিহিং লেই মাতানাহা আসা নাবিকো য়্যইদি মাহিংদানাহা, আকু সা আসা শহরসো নোপাদাংনুওয়া আপনিকো কোকোইকো দুনা আউতারাং ত্যাতে। <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />আজিপ্পারাং, কা নাবিহিংয়া জাংরোওয়া, ন্যায়কো দিনতাহা আকু শহরকো দশারোমা সদোম আসা গমোরাকো দশা সহায়কো চুরোওয়া।<verse eid="MAT 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />“কাং, কা নাবিহিংয়া দোমাবিকো প্যাকোতা লুকাবিহিং নিংপুমি ত্যাবাপা নিংপুদাংয়ো, আকো সোতা নাবিহা পুইয়া ত্যাবাপা চলাক আসা কুইজা ত্যাবাপা ম্যমম্যইপা জিং। <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />আদো দিংঙাবিহিংপা হোশিয়ার য়ুং, হাংপাতানাহা আবিহা নাবিহিংয়া ন্যায় জোওয়া সাতা সাপুরোওয়া, আসা জোংসুওয়া সাতা নাবিহিংয়া সাটাসো ডুরোওয়া। <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />নাবিহিংয়া কুং সোতা টেবো কাইজি আসা জাইপুবিকো নাগাইতা জাপারোওয়া, আত্রংরাং নাবিহা আবি আসা দোসরা জ্যাবিকো নাগাইতা কুং নুওয়াং জাংকো মুংরোওয়া। <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />আদো হাত্রং আবি নাবিহিং প্যইপাপুই, আত্রংহা হেপা আসা হাং য়্যইনেকোমে তামসা সিংদুমগে, হাংপাতানাহা নাবিহা হাং য়্যইনেকোমে, আত্রংরাং নাবিহিংয়া পিচারোওয়া। <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />হাংপাতানাহা য়্যইওয়াহা নাবি আপনিবি মায়্যইরোওয়া, আদো নাবিকো আপাকো লাংবে নাবিকোতা জিংমসা য়্যইরোওয়া।<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />“দিংঙাবিহা আপনিকো আপু, এবিহিং স্যাকো স্যইপুরোওয়া। আপাহা চেংওয়া চেমেহিং, আসা চেংওয়া চেমেহা আপা আয়ুকো তোইতা বিরোধ জোরোওয়া আসা আবিহিং স্যাপারোওয়া। <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />কুং সোতা নাবিহিংয়া তাংসা আচকাপা জোরোওয়া। আদো নোইস্যা চোইপা হাংসু সাডুংপা য়ুং, আকুহা উদ্ধার মুংচারোওয়া। <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />হাত্রং আবি নাবিহিং ইচো শহরতা কোইচ্যাপা, আত্রংহা ইদ্যাতা ক্যাপু, হাংপাতানাহা আজিপ্পারাং কা নাবিহিং জাংরোওয়া, দিংঙাকো চেংওয়া লেনুরোমা নাগাইহা নাবিহা ইস্রাইলকো তাংসা লোই শহরবিতা এনতাওয়া দেরেং হিংপাওয়া মাত্যইয়াংরোওয়া।<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />“য়োংতোংহা আপনিকো উটকেওয়ারোমা আসা ডেইয়াহা আপনিকো গিরিওয়ারোমা টেবো মাজিংমগা। <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />য়োংতোংহা আপনিকো উটকেওয়া আসা ডেইয়াহা আপনিকো গিরি ত্যাবাপা জিংনেরোওয়া। এপারাং দিংঙাবিমি কা সাকো গিরিহিংনাং সিংঙোকো জাইপু বালজিবুল<note caller="+" style="f"><char style="fr" closed="false">১০:২৫ </char><char style="ft" closed="false">বালজিবুল তাওয়াহা শয়তানকো দোসরা মিংগা।</char></note> তানাহা, ঝান কুং সাকো দিংঙাবিহিংয়া হাং জাংকোগা?<verse eid="MAT 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />“আকো সোতা আবিহিংপা মাচ্ছুংগে, হাংতানাহা তুংমসা মাতিংওয়া আসা গুংমসা সিদা মাচ্যইওয়া হাইরে মোতো। <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />হানি নুওয়াং কা নাবিহিং নাঘিওয়াতা জাং, আকুহা নাবিহা হাহাইওয়াতা জাংপি, আসা হাই নুওয়াং নাবি নানুংতা হিংমমে, আকুহা সাকো গুইপুসো সাডিংপা ঙামসা হিংপা। <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />জুপাহিং মেংচে স্যাওয়া, আদো লাংবেহিংয়া স্যামক্যইওয়া আবিহিংপাহা মাচ্ছুংগে, আকুরোমাহা লাংবে আসা জুপা নিহসোহিংসা নরকতা দাংপাকো চুওয়া সেংজাহিংপা মেংচে চুসুং। <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />ইচে পাইসাতা নিহপু বাংগেরা জিয়া মোলোংমগা? আবিকো প্যাকোতাহা ইপুরে নাবিকো আপাকো ইচ্ছা মাতাপা লিতা মাহুইমগা। <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />এপারাং সেংজাহা নাবিকো পোরোকো পুরিংরে তাংসা চেংমি নিও। <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />আকো সোতা নাবিহা মাচ্ছুংগে, নাবিহা উইসে বাংগেরাবিরোমা সিওপা পাংক্যইপা নিও।<verse eid="MAT 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />“কাং, হাংসু দিংঙাবিকো নাগাইতা কাহিং স্বীকার জো, কারে আকুহিংয়া লোডিংবাতা নিওয়া কুং আপাকো নাগাইতা স্বীকার জোরোওয়া। <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />আদো হাংসু কাহিং দিংঙাবিকো নাগাইতা ইন্কার জো, আকুহিংয়া কারে লোডিংবাতা নিওয়া কুং সেংজা আপাকো নাগাইতা ইন্কার জাংরোওয়া।<verse eid="MAT 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />“কা বাসিমতিতা তিমেওয়া পামসা লেয়ো তামসা নাবিহা মোনোগে। তিমেওয়া পাওয়া মোকো, আদো তালওয়ার চালাইকো কা লেমগা। <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />হাংপাতানাহা কা চেংওয়াহিংয়া আকো আপাকো তোইতা, আসা চেমেহিংয়া আকো আয়ুকো তোইতা, আসা নামাহিংয়া আকো জুমেকো তোইতা মেংতাপা জোপাকো লেমগা। <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />দিংঙাকো দুসমনহা আকো আপনিকো সাকো নাপোকোরাং নিরোওয়া।<verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />“হাংসু কাহিংরোমা সিওপা আপনিকো আয়ু আপাহিং জেজেংপা জো, আকুহা কুং য়োংতোং জিংকোবেপা মোতো। হাংসু কাহিংরোমা সিওপা আপনিকো চেংচুংহিং জেজেংপা জো, আকুরে কুং য়োংতোং জিংকোবেপা মোতো। <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />হাংসু আপনিকো ক্রুস পুমসা কুং নুনুই মাহুই, আকুরে কুং য়োংতোং জিংমক্যইরোওয়া। <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />হাংসু আপনিকো সাদিহিং বাচাইকো কেং, আকুহা য়াংপারোওয়া, আসা আপনিকো সাদি কুং সোতা য়াংপামবিহা আকুহা বাচাইরোওয়া।<verse eid="MAT 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />“হাংসু নাবিহিং গ্রহন জো, আকুহা কাহিং গ্রহন জোমগা, এপারাং কাহিং গ্রহন জোমবিহা কাহিং নিংপুওয়াহিং গ্রহন জোমগা। <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />অগমবক্তাহিংয়া ‘অগমবক্তাগা’ তামসা স্বাগত জোওয়াহা অগমবক্তাকো ত্যাবাপারাং ইনাম মুংচারোওয়া। এপারাং সেংজাকো নাগাইতা তাংজি তিংওয়া দিংঙাহিং স্বাগত জোওয়াহা আকো ত্যাবাপারাং ইনাম মুংচারোওয়া। <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />হাংসু ই আপেবিতাহা ইচোহিং কুং য়োংতোং নোমসা চাওয়াংওয়া এক গ্লাস তি পেয়াং, আকুহা হাত্রংরে আপনিকো ইনামহা মায়াংপারোওয়া।”<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">ইশু আসা বাপ্তিস্মা পিচাওয়া য়হুন্না</para>
  <para style="r">(<ref loc="LUK 7:18-35">লুক ৭:১৮-৩৫</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />আপনিকো বার্চো য়োংতোংবিহিং ই নুওয়াং আজ্ঞা জোপুনতেনুকো নোইতাহা ইশুহা গালীলকো দিংঙাবিহিং ঝিপাকো আসা এনতাওয়া দেরেং হিংপাকো শহরতা হোয়ে।<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />বাপ্তিস্মা পিচাওয়া য়হুন্না জেলতা নিনুওয়া, আকুহা ইশুকো জোওয়া কামবিকো তোইতা হিংয়ে। আকুহা আপনিকো ইচো নিহসো য়োংতোংবিহিং মোউমসা ইশুকোতা উইকো নিংপুয়ে, <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />আবিহা ইশুকোতা ওয়াংমসা ই নুওয়াং উইয়ে, “কাবিকো আশা জোওয়া মুক্তি পিচাওয়া জাইপু খ্রীষ্টহা নাতিরাংগা না কাবিহা দোসরাহিং খুইচাকোগা?”<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />ইশুহা আবিহিং জাংয়ে, “নাবিহা হাং-হাং তিংদিংমে, আসা হিংদিংমে, হোমসা আকু নুওয়াংরাং য়হুন্নাহিং জাংয়াপি, <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />মিচো মিতিংমবিহা তিংদিংনা, তেইমক্যইমবিহা তেইদিংনা, য্যা চাপুওয়াবিহা সাংদিংনা, নানুং মাহিংওয়াবিহা হিংদিংনা, সিপুমবিহা ঙারোদিংনা আসা জোরোংবিহা এনতাওয়া দেরেং হিংচা মুংদিংনা। <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />কুং তোইতা শংঙ্কা মোজোওয়া দিংঙাহা আশিষিত নিও।”<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />য়হুন্নাকো য়োংতোংবি হোপুনতেনুকো নোইতাহা ইশুহা দিংঙাবিহিংয়া য়হুন্নাকো বিষয়তা জাংয়ে, “নাবিহা চিচ্চোওয়া জায়গাতাহা হাং কাংকো হোমগা? বিংঙাসো য়াপাদিংওয়া মিপাহিংগা? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />না হাং কাংকো হোমগাসা? না এনতাওয়া এনতাওয়া আংদুং লুওয়া দিংঙাহিং কাংকো হোমগা। এনতাওয়া এনতাওয়া আংদুং লুওয়া দিংঙাবিহা জাইপুবিকো য়ুংওয়া সাতামি মায়ুংমগা। <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />আজিপ্পারাং জাংকে নাবিহা হাং কাংকো হোমগা? না অগমবক্তাহিংগা? ওই, আজিপ্পামি জাংদানাহা, নাবিহা অগমবক্তারোমা ইচো টেবো দিংঙাহিং তিংমি নিও। <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />হাংপাতানাহা তাংজিকো হিগাতাহা সেংজাহা য়হুন্নাকো তোইতারাং এপা জাংমি নিও, ‘কাং, কা নাকো নাগাই নাগাই কুং পোইংহিং নিংপুরোওয়া, আকুহা নাকো ন্যাতাহিং তৈয়ার জোরোওয়া।’<verse eid="MAT 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 11:11" />“আজিপ্পারাং কা নাবিহিং জাংরোওয়া, বাপ্তিস্মা পিচাওয়া য়হুন্নারোমা টেবো দিংঙাহা মেকেয়াংতো। আদো সেংজাকো রাজ্যতা হাংসু তাংসারোমা চিয়োপা নি, আকুহা য়হুন্নারোমারে টেবো জিংরোওয়া। <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />বাপ্তিস্মা পিচাওয়া য়হুন্নাকো এনতাওয়া দেরেং হিংপাওয়া সময়সোহা নেচোইপা সেংজাকো রাজ্যহা সিওপারাং নাগাই গ্যইদিংমি নিও, আসা বিরোধ জোমবিহা সেংজাকো রাজ্যকো তোইতা সিওপারাং জিয়োকো কেংদিংয়ো। <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />বাপ্তিস্মা পিচাওয়া য়হুন্নাকো সময় চোইপা মোসাকো লিংপাং আসা তাংসা অগমবক্তাবিহা সেংজাকো রাজ্যকো বিষয়তা য়্যইমি নিও। <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />আসা আবিকো জাংওয়া নুওয়াংমি দেংনাহা আবিকো লেরোওয়া তাওয়া এলিয়াহা য়হুন্নারাংগা। <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />হাংসুকো হিংওয়া নানুং নি, আবিহা হিংকো।<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />“হিনি জুকুংকো দিংঙাবিহিংয়া কা হাংসুহিংপা নোওকোগা? আবিহা হাতিতা গামসা আপনিকো ব্যারোবিহিংপা এপা য়্যইওয়া আপেবি ত্যাবাপা নিও,<verse eid="MAT 11:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="MAT 11:17" />‘কাবিহা নাবিকো সোতা য়াংতাওয়াকো বাসি মুইয়ে, আদো নাবিহা মায়ৌতো।</para>
  <para style="q" vid="MAT 11:17">কাবিহা লোচো পেংঙেংওয়া লেহদি লেদো, নাবিহা মাকাইতো।’<verse eid="MAT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 11:18" />“য়ু মাআংওয়া আসা উপাস য়ুংওয়া য়হুন্না লেয়ে, আকুহিংয়া নাবিহা জেসাং বাইওয়া দিংঙা তামসা জাংমগা। <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />কা দিংঙাকো চেংওয়াহা চাপা-আংপামসা লেয়ো, আদো কাহিংয়া ‘কাং, আকু মায়াওয়া, গাইব্রে, তোংক্যা জুওয়া আসা পাপিবিকো ব্যারো তামসা দোষ তিংপায়ো!’ সেংজাকো দুংজিহিংয়া আকো ফলসোরাং ঠিক তিংপারোওয়া।”<verse eid="MAT 11:19" /></para>
  <para style="s">পাপসো মালায়োংওয়াবিহিং হোশিয়ার</para>
  <para style="r">(<ref loc="LUK 10:13-15">লুক ১০:১৩-১৫</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />হানি শহরবিতা ইশুহা উইসে আআংপেপেচপুওয়া কামবি জো, আকু শহরকো দিংঙাবিহা আপনি আপনিকো পাপহিং মাল্যাওয়াকো সোতা আকুহা আকু শহরকো দিংঙাবিহিংয়া সাডিংপা ঙামসা এপা জাংয়ে <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />“ও খোরাজিম আসা বেথসেদাকো দিংঙাবাই, নাবিকো তোইতাহা টেবো দুঃখ দেপায়ে, হাংপাতানাহা নাবিকো প্যাকোতা জোওয়া আআংপেপেচপুক্যইওয়া কামবিহা তুরোস আসা সিদোন শহরতা জোনাহা, আকো দিংঙাবিহা নাগাইসোরাং পাপহিং ল্যাকোগা আসা পাপহিং ল্যাওয়া তিংপাকো সোতা বোরাকো আংদুং লুমসা চেকা নাইকোগা। <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />কা নাবিহিংয়া জাংরোওয়া, ন্যায়কো দিনতাহা নাবিকো দুঃখরোমাহা সেংজাহা তুরোস আসা সিদোনকো দিংঙাবিকো দুঃখরাং সহায়কো চুওয়া জিংরোওয়া।” <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />“ও কোর্ফরনহুমকো দিংঙাবাই! নাবিহা লোডিংবাতা দেকারো তাওয়া নোমগা? নাবিহা নরকতারাং দেকারোওয়া, হাংপাতানাহা সদোমতারে নাবিহিং ত্যাবাপা আআংপেপেচপুক্যইওয়া কাম তিংপানাহা সদোম শহরহা নেচোইপা নিদিংকোগা। <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />আদো কা নাবিহিং জাংরোওয়া, ন্যায়কো দিনতাহা নাবিকোরোমাহা সদোম শহরকো দিংঙাবিকো দন্ড সহায়কো চুরোওয়া।”<verse eid="MAT 11:24" /></para>
  <para style="s">য়াপুমবিহিং শাপাওয়া</para>
  <para style="r">(<ref loc="LUK 10:21-22">লুক ১০:২১-২২</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />আত্রংহা ইশুহা পাচাইয়ে, “ও সেংজা আপা, লোডিংবাসো বাসিমতিকো গিরি, কা নাতিহিংয়া গারানি তারোওয়া, হাংপাতানাহা নাতিহা ই নুওয়াংহিংয়া দুংজি আসা নোচেং নিওয়া দিংঙাবিসো ম্যইমসা এয়ো, আসা আপেবিবেপা জিংওয়া দিংঙাবিহিংয়া তিংপায়ো। <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />আজিপ্পারাং আপা, নাতিহিংয়া এপা জোওয়ারাং এনতায়ো।”<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />ইশুহা দিংঙাবিহিংয়া জাংয়ে, “কুং আপাহা কাহিংয়া তাংসা নুওয়াং ত্যইমি নিও। আপা ল্যামসা চেংওয়াহিংয়া হাংসুরে মানাইমগা আসা চেংওয়া ল্যামসা আপাহিংনে হাংসুরে মানাইমগা। আদো চেংওয়াকো নাইপাপিওয়াবিহা আপাহিংয়া নাইমগা।<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />“ও ব্যা পুমসা য়াপুমবাই, নাবি তাংসা কুংতা ওয়াং, কা নাবিহিংয়া শাকো পিচারোওয়া। <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />কুং তোং পুউ, আসা কাহিংপা ঝি, হাংপাতানাহা কুং তুংসিংতা সাংমেওয়া আসা মেসেদ্রাংওয়া নিও আসা নাবিহা লাংবেতা শাচা মুংরোওয়া। <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />হাংপাতানাহা কুং তোংহা জাংতোংপা নিও, আসা কুং ব্যাহা ফেলেংপা নিও।”<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">সানুকো দিনকো গিরি</para>
  <para style="r">(<ref loc="MRK 2:26-28">মর্কুস ২:২৬-২৮</ref>, <ref loc="MRK 3:1-6">৩:১-৬</ref>; <ref loc="LUK 6:1-11">লুক ৬:১-১১</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />আত্রংকো সময়তাহা ইশুহা সানুকো দিনতাহা গেহুংবিরিকো ন্যাতা জিংমসা হোদাংমি। আমা পাংপুওয়াকো সোতা আকো য়োংতোংবিহা গেহুংকো মোইপ্যা দ্যইমসা নিচোইমসা চায়ে। <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />ই তিংমসা ফরিসিবিহা ইশুহিংয়া জাংয়ে, “কাং, নাকো য়োংতোংবিহা পবিত্র সানুকো দিনতা লিংপাংতা মোজোকো জাংওয়া কামবিরে জোদিংয়ো।”<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />ইশুহা আবিহিংয়া জাংয়ে, “দাউদ জাইপু আসা আকো ব্যারোবিহা আমা পাংপুনুওয়া হাং জোমমে নাবিহা মাপারাইংগা? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />আকুহা সেংজাকো সাতা হোমসা সেংজাহিং পিচাপুনতেনুওয়া কোব্রেংহা ব্যারোবিহিংপা চায়ে। লিংপাংতা নিওয়া সেই আকু কোব্রেংহা পাউবি মোকোনাহা হাংসুরে চামতুকোগা। <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />ন্যাসারাং নাবিহা মোসাকো লিংপাংতা মাপারাইয়াংগা? সানুকো দিনতাহা পাউহা দেমসাতা হাত্রংদো কাম জোমগা। এপারাং আবিহা সানুকো দিনকো লিংপাংহিংয়া মামানেমগা। আদো আবিহা দোষি মাজিংমগা। <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />কা নাবিহিংয়া জাংরোওয়া, দেমসারোমা ডিয়োওয়া ইচো ইতা নিয়ো। <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />‘কাহিংয়া সেংচেংবিকো বলিদান মোকো, নাবিকো লামতুওয়া ঘ্যইরো’ তামসা তাংজিকো হিগাতা জাংওয়া নুওয়াংমি কোইনাহা নাবিহা কুং য়োংতোংবিহিংয়া দোষ মাতিংপাকোগা। <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />কা দিংঙাকো চেংওয়াহা সানুকো দিনকোরে গিরিগা।”<verse eid="MAT 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />আউসো নোপুমসা ইশুহা আবিকো জোংসুওয়া সাতা হোয়ে। <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />আউতাহা ইচো খুই সেংপুওয়া দিংঙা নিমি, আসা ইশুহিং দোষ তিংপারো তাওয়া নোমসা ফরিসিবিহা উইয়ে, “লিংপাং অনুসারহা সানুকো দিনতাহা হাইওয়াহিং সাংপাকো তুকোগা না মাতুকোগা?”<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />ইশুহা জাংয়ে, “নাবিকো লুকামি সানুকো দিনতাহা হোক্রাতা হুইচানাহা নাবিহা সেন্নেপা বাইরেতা দেইমসা মোনোপাকোগা? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />লুকাবিরোমা দিংঙাহা সিওপারাং পাংক্যইপা নিও। আকো সোতা লিংপাংতা নিওয়া সেই সানুকো দিনতাহা এনতাওয়া কাম জোকোহা এনতাপা জিংমগা।”<verse eid="MAT 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13" />আকো নোইতা ইশুহা আকু খুই সেংপুওয়া দিংঙাহিং জাংয়ে, “নাকো খুই উইদাং হী।” আকুহা খুই হীয়ে, আসা আকো খুইহা আত্রংতারাং সাংমসা দোসরা খুই ত্যাবাপারাং জিংপুয়ে। <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />আত্রংহা ফরিসিবিহা জোংসুওয়া সাসো নোপুমসা হ্যাপুয়ে আসা ইশুহিং হেপা স্যানেকোমে তামসা হুইসুয়ে।<verse eid="MAT 12:14" /></para>
  <para style="s">সেংজাকো জেংওয়া ডেইয়া</para>
  <para style="r">(<ref loc="MRK 3:7-12">মর্কুস ৩:৭-১২</ref>; <ref loc="LUK 6:17-19">লুক ৬:১৭-১৯</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />আপনিকো তোইতা মেংতাপা নোসুওয়া সিদা চ্যইমসা ইশুহা আউসো হোপুয়ে। উইসে দিংঙাবিহা আকো নুনুই হুইপুয়ে, আসা আকুহা আবিকো প্যাকোতা নিওয়া তাংসা হাইওয়াবিহিং সাংপায়ে। <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />আদো আকুহা আবিহিংয়া ইকো তোইতাহা হাংসুহিংনে হাইরে মাজাংগে তামসা জাংয়ে। <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />এপারাং এশাইয়া অগমবক্তাকো লাওয়া ই নুওয়াং তাংসা জিংপুয়ে,<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />“কাং, কুং জেংওয়া জেজেংওয়া ডেইয়াহা ইরাংগা।</para>
  <para style="q1" vid="MAT 12:18">ইকোসোহা কা সিওপারাং গাগ্রুপা নিও,</para>
  <para style="q1" vid="MAT 12:18">ইকোতা কা কুং লাংবে হোরোওয়া,</para>
  <para style="q1" vid="MAT 12:18">আসা ইরাং তাংসা জ্যাকো দিংঙাহিংয়া ন্যায়কো দেরেং হিংপারোওয়া।<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />ইহা মাস্যাসুরোওয়া, সাডিংপা চিলিংমসারে মাঙারোওয়া, আসা দিংঙাবিকো প্যাকোতারে ঙামসা মেতেইরোওয়া।<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />ওক্রেপা নিওয়া মিপারে ইহা মেমেরোওয়া</para>
  <para style="q1" vid="MAT 12:20">আসা মোমমোপা লারাইদিংওয়া দিব্রিরে ম্যাস্যারোওয়া। ইহা নোইস্যাতাহা ন্যায়হিংয়া জিয়োওয়াতা পুরারোওয়া।<verse eid="MAT 12:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="MAT 12:21" />আসা তাংসা দোসরা জ্যাকো দিংঙাবিহা ইকো তোইতারাং আশা এরোওয়া।”<note caller="+" style="x"><char style="xo" closed="false">১২:২১ </char><char style="xt" closed="false"><ref loc="ISA 42:1-4">এশাইয়া ৪২:১-৪</ref></char></note><verse eid="MAT 12:21" /></para>
  <para style="s">ইশুহিংয়া ফরিসিবিহা কোমে মোকোমে তাওয়া</para>
  <para style="r">(<ref loc="MRK 3:20-30">মর্কুস ৩:২০-৩০</ref>; <ref loc="LUK 11:14-23">লুক ১১:১৪-২৩</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />দিংঙাবিহা সিংঙো দ্যইংচপুমসা মিচো মাতিংওয়া আসা য়্যইমক্যইওয়া ইচো দিংঙাহিং ইশুকোতা পারায়ে। ইশুহা আকুহিংয়া সাংপাপুনতেনুওয়া আকুহা তিংমসা য়্যইকো চুপুয়ে। <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />ই তিংমসা তাংসা দিংঙাবিহা আআংপেপেচপুমসা এপা জাংসুয়ে, “ইরাং দাউদ জাইপুকো চেংওয়া, আসা সেংজাকো সেকেংত্যাওয়া খ্রীষ্টদোওয়া?”<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />ই হিংমসা ফরিসিবিহা জাংয়ে, “ইহা জেসাংকো গিরি বালজিবুলকো সেসো জেসাং নোপাচাংমগা।”<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />আবিকো এপাজিংওয়া নোওয়া সিদা চ্যইমসা ইশুহা আবিহিংয়া জাংয়ে, “হানি লোইতা স্যাসুওয়ানি, আকু লোইহা আপনিরাং দাংপুরোওয়া। এপারাং হানি শহর আসা প্যাপ্যাম্যাম্যাবিকো প্যাকোতা পাইসু-চোংসুওয়া নিনাহা আকুরে দাংপুমগা। <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />শয়তানমি শয়তানহিং নোপামসা আপনিকো বিরোধ জোনাহা, আবিকো লোইহা হেপা তাইকোগাসা? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />নাবিহা কাহিংয়া জেসাংকো জাইপু বালজিবুলকো সেসো জেসাং নোপামকো জাংদিংয়ো। এপা বেনাহা নাবিকো দিংঙাবিহা হাংসুকো সেসো জেসাং নোপাকোগাসা? এপামি জিংনাহা নাবি আপনিবিকো দিংঙাবিরাং নাবিহিংয়া দোষি তিংপারোওয়া। <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />আদো কা সেংজাকো সেসো জেসাং নোপারোওয়া আসা ইসোরাং সেংজাকো রাজ্যহা নাবিকো প্যাকোতা লেপুনতেমি নিও তাওয়া নুওয়াংহা নাবিহা সিদা চ্যইরোওয়া।”<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />“ন্যাসারাং হিং, বুচুইওয়া দিংঙাহিং নাগাই মাজিংপা হাংসু দিংঙারে আকো সাকো সোংসাহিং কুকো মাচুরোওয়া। আকুহিং জিংপুনতেনু মেংচে সাহিং কুকো চুরোওয়া।”<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />“হাংসু কাহিংপা মোতো, আকুহা কাহিং মোসোংপা জোওয়াগা, আসা হাংসু কাহিং মোয়োজরু, আকুহা কুং য়োওয়ারে হিংচাইবিরিপা গাচপারোওয়া। <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />আকো সোতা কা নাবিহিং জাংরোওয়া, দিংঙাবিকো জোওয়া তাংসা পাপ আসা সেংজাহিং বিরোধ জোওয়াবিহা ছমা জিংকো চুরোওয়া, আদো পবিত্র লাংবেকো তোইতা মাতুপা য়্যইওয়া পাপহা ছমা মাজিং। <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />কা দিংঙাকো চেংওয়াকো তোইতা য়্যইওয়া পাপহা ছমা জিংরোওয়া, আদো পবিত্র লাংবেকো তোইতা বিরোধ জোওয়া পাপহা ই সময়তারে ছমা মাজিং আসা দেপাওয়া সময়তারে হাত্রংরে ছমা মাজিং।”<verse eid="MAT 12:32" /></para>
  <para style="s">সিংতেংহিংয়া আকো ফলসোরাং নাইমগা</para>
  <para style="r">(<ref loc="LUK 6:43-45">লুক ৬:৪৩-৪৫</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />“এনতাওয়া ফল সেওয়া সিংতেংহা এনতাপারাং নিনেরোওয়া। সিংতেংরাং এনতাপা মাতানাহা ফলরে এনতাপা মাজিং, সিংতেংহা সেবেসোরাং নাইমগা।”<verse eid="MAT 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 12:34" />ও লিং নিওয়া পুইয়াকো চেংবাই! মেংতাপা জিংমসা নাবিহা এনতাওয়া নুওয়াংহা হেপা য়্যইকো চুকোগা? হাংপাতানাহা তুংসিংতা মেইপুওয়া নুওয়াংরাং নামুসো নোমগা। <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />এনতাওয়া দিংঙাহা আপনিকো তুংসিং নাপোতা নিওয়া এনতাওয়া সোংসাবিসো এনতাওয়া নুওয়াংবি নোপামগা, আদো মেংতাওয়া দিংঙাবিহা আপনিকো নাপোতা নিওয়া মেংতাওয়া নোচেংসো মেংতাওয়া নুওয়াংরাং নোপামগা। <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />কা নাবিহিং জাংরোওয়া, হাংসু দিংঙা মাতুওয়া নুওয়াংবি য়্যই, ন্যায়কো দিনতাহা আবিহা আকো লেখা পিচানেরোওয়া। <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />হাংপাতানাহা নাকো য়্যইওয়াসোরাং নাতিহা দোষি জিংরোওয়া, আসা নাকো য়্যইওয়াসোরাং নাতিহা নির্দোষ জিংরোওয়া।<verse eid="MAT 12:37" /></para>
  <para style="s">চিহ্ন কাংকো কেংওয়া</para>
  <para style="r">(<ref loc="MRK 8:11-12">মর্কুস ৮:১১-১২</ref>; <ref loc="LUK 11:29-32">লুক ১১:২৯-৩২</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />আত্রংহা তাংজিকো উটকেওয়াবি আসা ইচো নিহসো ফরিসিবিহা আকুহিং জাংয়ে, “উটকেওয়া কাবিহিং ইচো চিহ্ন তিংপা, কাবি কাংকো কেংমি।”<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />ইশুহা আবিহিং জাংয়ে, “হিনি জুকুংকো দিংঙাবিহা সিওপারাং মেংতাওয়া আসা নুংনাংসুওয়া নিও, ইবিহা চিহ্ন মেংচে কাংকো কেংমগা, আদো অগমবক্তা য়োনাকো তোইতা জিংপুওয়া চিহ্ন ল্যামসা ইবিহা দোসরা হাই চিহ্নরে ন্যইচা মামুং, <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />হাংপাতানাহা হেপা য়োনাহা টেবো নায়াকো ফেমাকো নাপোতা জেংসুং-লিসুং সাসুংয়ু চোইপা য়ুংমে, এপারাং দিংঙাকো চেংওয়ারে সাসুংয়ু চোইপা মোংটোকো লিতা য়ুংনেরোওয়া। <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />ন্যায়কো দিনতা নিনেবে শহরকো দিংঙাবিহা জামসা হিনি জুকুংকো দিংঙাবিহিংয়া দোষ তিংপারোওয়া, হাংপাতানাহা য়োনাহা সেংজাকো নুওয়াং হিংপানুওয়া আবিহা আপনি আপনিকো পাপহিং হুইতেয়ে। আদো কাং, য়োনারোমা ডিয়োওয়া ইচো ইতা নিও। <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />ন্যায়কো দিনতাহা মাংকো শেবা দেশকো জাইমুহা জামসা হিনি জুকুংকো দিংঙাবিহিংয়া দোষ তিংপারোওয়া, হাংপাতানাহা সোলোমন জাইপুকো দুংজিকো নুওয়াং হিংকো আকুহা তানাংসো ওয়াংমগা, আদো কাং, সোলোমনরোমাহা ইতা টেবো ইচো নিও।<verse eid="MAT 12:42" /></para>
  <para style="s">মেংতাওয়া সিংঙো লায়োংওয়া</para>
  <para style="r">(<ref loc="LUK 11:24-26">লুক ১১:২৪-২৬</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />“হাত্রং মেংতাওয়া লাংবে দিংঙাকোসো নোপুমসা হ্যা, আকুহা শাওয়া মোমসা এনতাপা শাদু নিওয়া জায়গাবি মোমসা তেইমগা, আদো হাংতারে মামুংমগা। <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />এপাজিংওয়া জায়গা হাংতারে মামুংনুওয়া নাগাইকো য়ুংওয়াত্রাং হোপুরো তামসা আকুহা লায়োংমগা। আউতা লায়োংনুওয়া আকুহা নাগাইকো সাহা হাইরে মাতাপা সাইপুনতেওয়া আসা এনতাপা চোপামসা এপুনতেওয়া তিংমগা। <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />আত্রংহা ই তিংমসা আকুহা হোমসা ন্যাসারাং নীচো আপনিরোমা ডিয়োওয়া জেসাংবিহিং মোউপামসা পারামগা, আসা নাপোতা হোমসা আবিহা য়ুংমগা, আসা আকু দিংঙাকোহা নাগাইকোরোমা নোইকো দশাহা সিওপা মেংতাপা জিংমগা। হিনি জুকুংকো মেংতাওয়া দিংঙাবিকো দশারে এপারাং জিংরোওয়া।”<verse eid="MAT 12:45" /></para>
  <para style="s">ইশুকো আয়ুসো এবি</para>
  <para style="r">(<ref loc="MRK 3:31-35">মর্কুস ৩:৩১-৩৫</ref>; <ref loc="LUK 8:19-21">লুক ৮:১৯-২১</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />ইশুহা উইসে দিংঙাবিহিংপা য়্যইসুদিংনুওয়া, আকো আয়ু আসা এবি বাইরেতা জাদিংমি, আসা আকুহিংপা য়্যইসুকো কেংদিংমি।<verse eid="MAT 12:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 12:47" />আত্রংহা ইচোহা জাংয়ে, “প্রভু, নাকো আয়ুসো এবিহা বাইরেতা জাদিংনা, আসা নাতিহিংপা য়্যইকো কেংদিংনা।”<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />আদো আকুহিংপা য়্যইদিংওয়াহিংয়া ইশুহা জাংয়ে, “কুং আয়ুসো কুং এবিহা হাংসুগা?”<verse eid="MAT 12:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 12:49" />আসা আকুহা য়োংতোংবিহিং খুইসো তিংপামসা জাংয়ে, “কাং, কুং আয়ু আসা কুং এবিহা ইবিরাংগা। <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />হাংপাতানাহা হাংসু লোডিংবাতা নিওয়া কুং আপাকো ইচ্ছাহিং পুরা জো, আকুরাং কুং এ, হুম্রি, আসা আয়ুগা।”<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">অংটি মিওয়াকো মিংচি</para>
  <para style="r">(<ref loc="MRK 4:1-12">মর্কুস ৪:১-১২</ref>,<ref loc="MRK 4:25">২৫</ref>; <ref loc="LUK 8:4-10">লুক ৮:৪-১০</ref>, <ref loc="LUK 10:23-24">১০:২৩-২৪</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />আকু দিনতারাং ইশুহা সাসো নোমসা গালীল ঝাহাদিকো আরিতা গায়ে। <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />উইসে দিংঙাবিহা আকো আবেইতা দেরেয়ে, আকো সোতা আকুহা নোওয়াইতা গায়ে। উইসে দিংঙাবিহা ঝাহাদিকো আরিতারাং জায়ে। <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />ইশুহা আকু দিংঙাবিহিংয়া মিংচি ল্যামসা উইসে নুওয়াংবি জাংয়ে।</para>
  <para style="p" vid="MAT 13:3">“ইচো দিংঙাহা অংটি মিকো হোয়ে। <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />আসা অংটি মিনুওয়া লেরা অংটিবিহা ন্যাতাতা হুইয়ে, আসা জিয়া-জিপেইবি লেমসা আকু অংটিবিহা চাপুয়ে। <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />লেরা অংটিবিহা মোংটো মাতাওয়া লুংটুইবিরিতা হুইয়ে, আসা উইসে মোংটো মাতামকো সোতা অংটিহা সেন্নেপা নিংয়ে। <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />আদো হাত্রং সানি বো, আত্রংহা আকুহা য়োংপুয়ে আসা ডেবে উইদাং মাতামকো সোতা সেংপুয়ে। <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />লেরা অংটিবিহা সোসাবিরিতা হুইয়ে, আসা সোসাবিহা দেপুমসা আকুহিংয়া মেরোংপুয়ে। <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />আদো লেরা অংটিবিহা পোপফ্যইওয়া মোংটোতা হুইয়ে, আসা লেরাহা তিশ, লেরাহা সাঠি, আসা লেরাহা একশো গুনরোমা সিওপা শেয়ে।”<verse eid="MAT 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 13:9" />হাংসুকো হিংওয়া নানুং নি, আকুহা হিংকো।<verse eid="MAT 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />আসা য়োংতোংবিহা লেমসা আকুহিং জাংয়ে, “নাতিহা আবিহিংপা হাংপাসা মিংচিতা য়্যইচাংমগা?”<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />ইশুহা আবিহিংয়া জাংয়ে, নাবিহিংয়া সেংজাকো রাজ্যকো দুংজি পিচামি নিও, আদো আবিহিংয়া মিচায়াংতো। <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />হাংপতানাহা হাংসুকোতা কোইওয়া তুংসিংনি, আকুহিংয়া ন্যাসা পিচারোওয়া, আসা আকোহা উইসে জিংরোওয়া। আদো হাংসুকো মোতো, আকুহিংপা নিওয়ারে আকোসো গিংচাপুরোওয়া। <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />আকো সোতা কাহা আবিহিং ঝিপানুওয়া মিংচিতা য়্যইচাংমি, হাংপাতানাহা আবিহা ন্যইকোহা ন্যইমগা, আদো মাতিংমগা, হিংকোহা হিংমগা, আদো মোকোইমগা। <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />এশাইয়া অগমবক্তাকো জাংওয়াহা আবিকোতা তাংসা জিংয়ো:</para>
  <para style="q1" vid="MAT 13:14">“হিংকোহা হিংমগা, আদো হাত্রংরে মোকোইমগা,</para>
  <para style="q1" vid="MAT 13:14">কাংকোহা কাংমগা, আদো হাত্রংরে মাতিংমগা।<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />হাংপাতানাহা আবিকো তুংসিংরাং বাংদাইপা জিংপুনতেয়ো,</para>
  <para style="q2" vid="MAT 13:15">আবিকো নানুংহা মাহিংপা জিংপুনতেয়ো,</para>
  <para style="q2" vid="MAT 13:15">আবিকো মিচোহা মেইচপুনতেমি নিও,</para>
  <para style="q1" vid="MAT 13:15">মোকোনাহা আবিহা মিচোসো তিংকোগা,</para>
  <para style="q2" vid="MAT 13:15">নানুংসো হিংকোগা,</para>
  <para style="q2" vid="MAT 13:15">তুংসিংসো কোইকোগা,</para>
  <para style="q1" vid="MAT 13:15">আসা কুংতা লায়োংকোগা,</para>
  <para style="q2" vid="MAT 13:15">আসা কা আবিহিংয়া সাংপাকোগা।”<note caller="+" style="x"><char style="xo" closed="false">১৩:১৫ </char><char style="xt" closed="false"><ref loc="ISA 6:9">এশাইয়া ৬:৯</ref>,<ref loc="ISA 6:10">১০</ref></char></note><verse eid="MAT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />“আদো নাবিহা আশিষিত নিও, হাংপাতানাহা নাবিকো মিচোসো তিংয়ো আসা নানুংসো হিংয়ো। <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />আজিপ্পারাং কা নাবিহিং জাংরোওয়া, নাবিকো তিংওয়াহা উইসে অগমবক্তাবি আসা তাংজি নিওয়া দিংঙাবিহা ন্যইকো কেংদিংমগা, আদো মাতিংতো, আসা নাবিকো হিংওয়া নুওয়াংবিরে হিংকো কেংদিংমগা, আদো হিংচা মামুংতো।<verse eid="MAT 13:17" /></para>
  <para style="s">অংটি মিওয়াকো নুওয়াং ল্যাপিওয়া</para>
  <para style="r">(<ref loc="MRK 4:13-20">মর্কুস ৪:১৩-২০</ref>; <ref loc="LUK 8:11-15">লুক ৮:১১-১৫</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />“নেহা অংটি মিওয়া মিংচিকো নুওয়াং হিং, <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />ন্যাতাবিরিতা মিওয়া অংটিবিহা ইরাংগা। দিংঙাবিহা সেংজাকো রাজ্যকো য়্যইদিবিহা হিংকোহা হিংমগা, আদো মোকোইমগা। আত্রংহা জেসাং লেমসা আকো তুংসিংতা হানি অংটি মি-মিইনি, আকুহা গিংচামসা পুচামগা। <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />লুংটুইবিরিতা মিওয়া অংটিহা ইরাংগা, লেরা দিংঙাবিহা য়্যইদি হিংতানি য়াংতামসা দেংমগা আসা আপনিকো তুংসিংতা এমগা। <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />আদো আকুহা আপনিকো দেবে মাতাওয়াকো সোতা আম্যই চোইপা মেংচে য়ুংমগা, আসা য়্যইদিতা দেংওয়াকো সোতা দিংঙাবিকোসো দুঃখ আসা সতাওয়াট ওয়াংতানি আকুহা নুনুই ওয়েংপুমগা। <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />সোসাবিরিতা হুইওয়া অংটিহা ইরাংগা, হাংসু য়্যইদি হিং, আদো ই বাসিমতিতা নিওয়া উইসে সোংসাবিকো সিংদুওয়া আসা পুংজিবিকো জেজেংওয়াসো য়্যইদিহিং য়োইমগা, আসা আকুহা অংসে শেমক্যইমগা। <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />আদো এনতাওয়া মোংটোতা হুইওয়া অংটিহা ইরাংগা, হাংসু এনতাপা য়্যইদি হিং, আসা কোই, আবিহা আজিপ্পা অংসে শেপামগা, আকো মিওয়া অংটিহা তিশ গুনা, সাঠি গুনা একশো গুনারোমা সিওপা সেপামগা।”<verse eid="MAT 13:23" /></para>
  <para style="s">সামাকো মিংচি</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />ইশুহা আবিহিংয়া ন্যাসারাং দোসরা মিংচি হিংপায়ে, “সেংজাকো রাজ্যহা এপা নিও, ইচো দিংঙাহা আপনিকো লুংনিংতা এনতাওয়া অংটি মিয়ে। <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />আদো দিংঙাবি জিংদিংনুওয়া আবিহিং মেংতাপা জোওয়া দিংঙা ওয়াংমসা গেহুংকো প্যাকো-প্যাকোতা সাম্যাকো অংটি মিমসা হোপুয়ে। <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />নেহা গেহুং ডেমসা মোইপ্যা প্যাকো তোংপানুওয়া আউতা সাম্যারে তিংয়ে।”<verse eid="MAT 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27" />সাকো গিরিওয়াকোতা ডেইয়াবি ওয়াংমসা জাংয়ে, “উটকেওয়া, নাতিহা আপনিকো লুংনিংতাহা এনতাওয়া অংটি মিমকোতা? আউতাহা সাম্যাহা হানিসো ওয়াংগা?”<verse eid="MAT 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28" />গিরিহা আবিহিংয়া জাংয়ে, “হাংসু দুসমনবিমে এপা জোমকোগা।”</para>
  <para style="p" vid="MAT 13:28">ডেইয়াবিহা আকুহিংয়া জাংয়ে, “মেনা কাবিহা হোমসা আকু সাম্যাহিংয়া ওইয়াপুকোগা?”<verse eid="MAT 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29" />আদো গিরিওয়াহা জাংয়ে, “এপা মোজোগে, নাবিমি সাম্যা ওইপুনাহা গেহুংরে ওইচপুগে। <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />মোইপ্যা চ্যাকো মোতোংচেহা নিদ্যাহিংসা চিত্তা দেকো পিচা, আসা মোইপ্যা চ্যাকো তোংপানুওয়া কা কাংপামবিহিং ‘নাগাইহা সাম্যাহিং চ্যামসা মেহতা চুংকো জমা জো আসা গেহুংহা য়োমসা তোপাতা এনতাপা এহে’ তামসা জাংরোওয়া।”<verse eid="MAT 13:30" /></para>
  <para style="s">তৌরিকো অংটি আসা সোঁরাকো মিংচি</para>
  <para style="r">(<ref loc="MRK 4:30-34">মর্কুস ৪:৩০-৩৪</ref>; <ref loc="LUK 13:18-21">লুক ১৩:১৮-২১</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />ইশুহা আবিহিংয়া দোসরা মিংচি ল্যায়ে, “সেংজাকো রাজ্যহা তৌরিকো অংটি ত্যাবাপাগা। ইচো দিংঙাহা আকু অংটি পুমসা আপনিকো লুংনিংতা মিয়ে। <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />আকুহা তাংসা অংটিবিরোমা আত্যইচিংপা জিংমগা, আদো হাত্রং ডেপু, আত্রংহা আকুহা তাংসা সাকবিরোমা টেবো ডেপুমসা আকুহা সিংতেংরাং জিংপুমগা। ডিংবাকো জিয়া-জিপেইবি লেমসা আকো গেইবেবিতা বাসা বানাইমগা।”<verse eid="MAT 13:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />আকুহা আবিহিংয়া দোসরা মিংচিরে হিংপায়ে, “সেংজাকো রাজ্যহা বুইপাওয়া সোঁরা ত্যাবাপাগা। ইচো মেমেহা উইসে পিটোতা বুইপাওয়া সোঁরা আস্যস্যই লাসিয়ে, আসা আকু পিতো মাবুইনু চোইপা আকুহিংয়া ইচো জায়গাতারাং এহে।”<verse eid="MAT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />ইশুহা ই তাংসা নুওয়াংহা দিংঙাবিহিং মিংচিতা হিংপায়ে, মিংচি ল্যামসা আকুহা আবিহিংয়া হাইরে মাহিংপাতো। <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />এপারাং অগমবক্তাকো জাংওয়া য়্যইদিহা তাংসা জিংয়ো,</para>
  <para style="q1" vid="MAT 13:35">“কা নাবিহিংপা মিংচিতা য়্যইরোওয়া,</para>
  <para style="q1" vid="MAT 13:35">আসা বাসিমতি দিংনুসোহা মেগেয়াংওয়া নুওয়াংবি জাংরোওয়া।”<note caller="+" style="x"><char style="xo" closed="false">১৩:৩৫ </char><char style="xt" closed="false"><ref loc="PSA 78:2">ভজন ৭৮:২</ref></char></note><verse eid="MAT 13:35" /></para>
  <para style="s">সাম্যাকো মিংচিকো নুওয়াং</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />আকো নোইতাহা আকুহা উইসে দিংঙাহিং হুইতেমসা সাতা হোপুয়ে, আসা আকো য়োংতোংবিহা আকোতা ওয়াংমসা জাংয়ে, “লুংনিংকো সাম্যাকো মিংচি ল্যাওয়াহা হাংমে কাবিহিং জাংপি।”<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />আকুহা আবিহিংয়া জাংয়ে, “এনতাওয়া অংটি মিওয়াহা দিংঙাকো চেংওয়াগা। <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />লুংনিংহা বাসিমতিগা। এনতাওয়া অংটিহা সেংজাকো রাজ্যকো দিংঙাবিগা, আসা সাম্যাহা শয়তানকো সন্তানবিগা। <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />সাম্যাকো অংটি মিওয়াহা শয়তানগা। মোইপ্যা চ্যাকো তোংপাওয়াহা বাসিমতিকো ন্যইস্যাকো দিনগা। কাম জোমবিহা লোডিংবাকো পোইংবিগা।”<verse eid="MAT 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40" />“হেপা সাম্যা ওইমসা মেহতা চুংপুমে, বাসিমতিকো নোইস্যাকো দিনবিতারে এপারাং জিংরোওয়া। <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />কা দিংঙাকো চেংওয়াহা আপনিকো পোইংবি নিংপুরোওয়া, আসা তাংসা পাপ জোপাওয়াবি আসা মেংতাপা কাম জোমবি কুং রাজ্যসো জমা জোরোওয়া। <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />আসা আবিহিংয়া হাত্রংরে মিসিওয়া মেহতা বাডোইপুরোওয়া। আউতাহা দিংঙাবিহা কাইরোওয়া আসা সেতাং কিট্টিরোওয়া। <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />আত্রংহা তাংজি নিওয়াবিহা আপাকো রাজ্যতা সিনি ত্যাবাপা চাইচাইপা জিংরোওয়া। হাংসুকো হিংওয়া নানুং নি, আকুহা হিংকো।<verse eid="MAT 13:43" /></para>
  <para style="s">লিতেওয়া পুংজি <figure style="fig" alt="মোংটোকো নাপোতা লিমসা এওয়া পুংজিবি" file="hk00144.jpg" size="col" ref="১৩:৪৩" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />“সেংজাকো রাজ্যহা লুংনিংতা ম্যইমসা এওয়া উইসে পুংজি ত্যাবাপাগা। ইচো দিংঙাহা আকু পুংজি দোচামসা গাগ্রুপা জিংমসা হোয়ে, আসা আপনিকোতা নিওয়া তাংসা পিচামসা আকু লুংনিং চোইয়ে।<verse eid="MAT 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />“ন্যাসারাং সেংজাকো রাজ্যহা মোতিবি মোমসা চোইওয়া ইচো বেপার জোওয়া দিংঙা ত্যাবাপাগা। <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />আকুহা ইচো পাংক্যইওয়া মোতি দোনুকো নোইতাহা আপনিকোতা নিওয়া তাংসা পিচামসা আকু মোতি চোইয়ে।<verse eid="MAT 13:46" /></para>
  <para style="s">নায়া প্যইওয়া জেরে</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />“ন্যাসারাং সেংজাকো রাজ্যহা ঝাহাদিতা তিওয়া ইচো জেরে ত্যাবাপারেগা। ইতাহা তাংসা জ্যাকো নায়া ওয়াংয়ে। <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />আসা জেরে মেইনুওয়া দিংঙাবিহা আকুহিংয়া আরিতা দেইমসা নোপায়ে, আসা গামসা এনতা-এনতাওয়াবিহিংয়া য়োটিতা দুংপায়ে, আসা মেংতাওয়াবিহিংয়া বাইরেতা বাডোইপুয়ে। <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />বাসিমতিকো ন্যইস্যাকো দিনতারে এপারাং জিংরোওয়া। লোডিংবাকো পোইংবিহা লেমসা মেংতাওয়াবিহিংয়া তাংজিবিকো প্যাকোসো ওয়েংপাপুরোওয়া, <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />আসা আবিহিংয়া হাত্রংরে মিসিওয়া মেহতা বাডোইপুরোওয়া। আউতাহা দিংঙাবিহা কাইরোওয়া আসা সেতাং কিট্টিরোওয়া।”<verse eid="MAT 13:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />ইশুহা আবিহিং উইয়ে, “নাবিহা ই তাংসা নুওয়াংবি কোইংগা?”</para>
  <para style="p" vid="MAT 13:51">আবিহা জাংয়ে, “কোইনা উটকেওয়া।”<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />আসা ইশুহা আবিহিং জাংয়ে, “আকো সোতা সেংজাকো রাজ্যকো য়োংতোং জিংকো মুংওয়া তাংসা তাংজিকো উটকেওয়াহা সাকো গিরি ত্যাবাপা জিংমগা। সাকো গিরিহা আপনিকো সোংসা এওয়া জায়গাসো চুবে আসা জেবে পাংক্যইওয়া সোংসাবি বাইরে নোপামগা।”<verse eid="MAT 13:52" /></para>
  <para style="s">আদর মুংওয়া অগমবক্তা</para>
  <para style="r">(<ref loc="MRK 6:1-6">মর্কুস ৬:১-৬</ref>; <ref loc="LUK 4:16-30">লুক ৪:১৬-৩০</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />ই মিংচিবি ল্যাপুনতেনুকো নোইতাহা ইশুহা আউসো হোপুইয়ে। <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />আসা আপনিকো শহরতা ওয়াংমসা আকুহা আবিকো জোংসুওয়া সাতা আবিহিং ঝিপায়ে। আকো ঝিপাওয়া হিংমবিহা আআংপেপেপা জিংপুমসা জাংয়ে, “ইহিংয়া আআংপেপেচপুক্যইওয়া দুংজি আসা সেকো কামহা হানিসো ওয়াংয়ুং? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />ইহা কেংপ্রাকো কাম জোওয়াকো চেংওয়া মোকোমগা? ইকো আয়ুকো মিংহা মরিয়োম আসা ইকো এবিহা য়াকুব, য়োসেফ, সিমোন, আসা য়হুদা মোকোমগা? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />ইকো হুম্রিবিহা য়াংবিহিংপা মাতাংগা? মেনা ইহিংয়া এপা জিংওয়া নুওয়াংবিহা হানিসো ওয়াংগাসা?” <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />এপা জাংমসা আবিহা ইশুহিংপা সেদ্রাংপুয়ে।</para>
  <para style="p" vid="MAT 13:57">আদো ইশুহা আবিহিংয়া জাংয়ে, “অগমবক্তাহিংয়া আপনিকো লোইতা আসা আপনিকো সাতা ল্যামসা ইদ্যাতাহা আদর মুংমগা।” <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />আবিকো মাদেংওয়াকো সোতা আকুহা আউতাহা সেকো উইসে কামবিহা মোজোতো।<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">বাপ্তিস্মা পিচাওয়া য়হুন্নাকো সিপুওয়া</para>
  <para style="r">(<ref loc="MRK 6:14-29">মর্কুস ৬:১৪-২৯</ref>; <ref loc="LUK 9:7-9">লুক ৯:৭-৯</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />আত্রংকো সময়হা গালীলতা রাজ জোওয়া হেরোদ এনতিপাসহা ইশুকো জোওয়া কামবিকো নুওয়াং হিংয়ে, <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />আসা আকুহা আপনিকো কাম জোমবিহিং জাংয়ে, “ইহা বাপ্তিস্মা পিচাওয়া য়হুন্নাগা। ইহা সিপুওয়াসোহা ঙারোমকোগুং। আকো সোতা সেতা ই কামবিহা আকোসো জিংমসা জোদিংয়ো।”<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />হাংপাতানাহা হেরোদহা আপনিকো এ ফিলিপকো মে হেরোদিয়াসকো সোতা য়হুন্নাহিংয়া প্যইমসা জেলতা সুংমসা এওয়া নিমি। <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />য়হুন্নাহা হেরোদহিংয়া এপা জাংওয়া নিমি, “লিংপাং অনুসারহা নাতিহা নাকো একো মেহিংয়া এপা আপনিকো মে বানাইমসা এচামতুকোগা।” <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />এপা জাংপুওয়াকো সোতা হেরোদহা য়হুন্নাহিংয়া স্যাকো কেংদিংমি, আদো আকুহা দিংঙাবিহিংপা চুসুংমি, হাংপাতানাহা দিংঙাবিহা য়হুন্নাহিংয়া অগমবক্তাগা তামসা দেংমি।<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />আদো সাইয়ুহা হেরোদকো কেওয়া দিনকো য়াংতাওয়াতা হেরোদিয়াসকো চেমেহা আবিকো প্যাকোতা য়োইমসা হেরোদহিং গাগ্রুপায়ে। <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />এপা জিংনুওয়া আকুহা আকু চেমেহিংয়া হাই য়াদো পিচারো তামসা নাপোইয়ে। <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />আকো আয়ুকো ঝিপাওয়া সেই চেমেহা জাংয়ে, “বাপ্তিস্মা পিচাওয়া য়হুন্নাকো পোরো কাহিংয়া বারাংতা পিচা।” <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />ই হিংমসা জাইপু হেরোদহা সিংদুয়ে, আদো আকো কেওয়া দিনতা ওয়াংওয়া উইসে দিংঙাবিকো নাগাইতা নাপোই পুনতেওয়াকো সোতা আকুহা আকু চেমেকো য়াওয়া সেই তাংসা জোপি তামসা আজ্ঞা জোয়ে। <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />আসা আকুহা জেলতা য়হুন্নাকো পোরো ঠেপাকো নিংপুয়ে। <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />আকো পোরোহা বারাংতা পামসা আকু চেমেহিং পিচায়ে। চেমেহা আকুহা আপনিকো আয়ুকোতা সারেয়ে। <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />আকো নোইতা য়হুন্নাকো য়োংতোংবিহা লেমসা আকো সিপুওয়া জুপা পুমসা লিকাপুয়ে। আসা আবিহা হোমসা ইশুহিং দেরেং জাংয়ায়ে।<verse eid="MAT 14:12" /></para>
  <para style="s">ইশুহা পাঁচ হাজার দিংঙাহিং চাকো পিচাওয়া</para>
  <para style="r">(<ref loc="MRK 6:30-44">মর্কুস ৬:৩০-৪৪</ref>; <ref loc="LUK 9:10-17">লুক ৯:১০-১৭</ref>; <ref loc="JHN 6:1-14">য়হুন্না ৬:১-১৪</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />হাত্রং ইশু য়হুন্নাহিং স্যাপাপুওয়া দেরেং হিং, আত্রংহা আকুহা নোওয়াইতা বাইপুমসা ইচোদাং আউসো ইচো চিচ্চোওয়া জায়গাতা হোয়ে। ই হিংনুওয়া উইসে দিংঙাবিহা শহরবিসো তেইপুমসা আকুহিংপা হুইসপুয়ে। <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />ইশুহা নোওয়াইসো উইনুওয়া উইসে দিংঙাবিহিং তিংয়ে। আকু উইসে দিংঙাহিং তিংমসা আকো তুংসিংহা আবিকো তোইতা লামতুপুয়ে, আসা আকুহা আউতা নিওয়া হাইমবিহিং সাংপায়ে।<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />জিরোং জিংপুনুওয়া য়োংতোংবিহা এপা জাংমসা আকোতা ওয়াংয়ে, “ইতাহা হাইরে মোতো, আসা সিনিরে হুইপুনতেয়ো। ই উইসে দিংঙাবিহিং নিংপি, আসা ইবিহা আবেই আবেইকো লোই-লোইতা হোমসা আপনিকো সোতা চাওয়া আংওয়াবি চোইচাপুকো।”<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />আদো ইশুহা আবিহিং জাংয়ে, “আবিহা হ্যামঘ্যইকো। নাবিরাং আবিহিংয়া চাকো পিচা।”<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />আবিহা আকুহিংয়া জাংয়ে, “ইতা কাবিকোতা ঙাচো কোব্রেং আসা নিহপু নায়া মেংচে নিও।”<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />আত্রংহা আকুহা জাংয়ে, “আকুহা কুংতা পা।” <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />আকুহা দিংঙাবিহিংয়া ওয়াংবোইতা গাকো জাংয়ে, আসা আকু ঙাচো কোব্রেং আসা নিহপু নায়া চুংমসা লোডিংবাতা ন্যইমসা সেংজাহিং গারানি তায়ে, আসা কোব্রেংবি ছিমসা য়োংতোংবিহিং পিচায়ে, আসা য়োংতোংবিহা দিংঙাবিহিং চোপিয়ে। <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />আবি তাংসা গাইক্যইপা চায়ে, আসা লাওয়া চোংব্রাবিহা আবি য়োনুওয়া বার্চো ডেংগে মেইপুয়ে। <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />মেমেবি আসা চেংচুংবি ল্যামসা চাওয়া আংওয়াবিহা আউতা পাঁচ হাজার পোজা দিংঙাবি নিমি।<verse eid="MAT 14:21" /></para>
  <para style="s">ইশুহা তিকো তোইতা তেইওয়া</para>
  <para style="r">(<ref loc="MRK 6:45-56">মর্কুস ৬:৪৫-৫৬</ref>; <ref loc="JHN 6:15-21">য়হুন্না ৬:১৫-২১</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />আকো নোইতা ইশুহা দিংঙাবিহিং নিংপুনতেনুওয়া য়োংতোংবিহিংয়া নোওয়াইতা বাইপামসা আকুরোমা নাগাই দাব্রিকো নুব্যাই হ্যাকো পিচায়ে। <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />আসা উইসে দিংঙাবিহিং নিংপুনতেনুওয়া আকুহা ইচোদাং পাচাইকো তোলোংওয়া য়্যাগ্যইতা হোয়ে। মারিমোপুনুওয়া ইশুহা ইচোদাং য়্যাগ্যইতা নিমি। <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />আদো নোওয়াইহা আত্রং চোইপাহা ঝাহাদিকো চেব্রেসোহা প্যাকোতা দেকানতেমি। আসা বিংঙাহা তুইপেং ভিওয়াকো সোতা নোওয়াইহিংয়া ঝাহাদিতা চুরা লোমসা নাগাই হোমক্যইতো।<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />হাপকুং হোহোইনুওয়া ইশুহা তিকো তোইসো তেইপামসা য়োংতোংবিকোতা লেপায়ে। <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />হাত্রং য়োংতোংবি আকুহিংয়া তিকো তোই-তোই তেইদিংওয়া তিং, আত্রংহা আবিহা চুসুংপুমসা জাংয়ে, “ইহা জেসাংগা!” আসা আবিহা সিওপারাং চুসুংপুমসা চিলিংসুয়ে।<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />আদো আত্রংতারাং ইশুহা জাংয়ে, “মাচ্ছুংগে, কারাংগা, সাডুংপা য়ুং।”<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />পত্রসহা আকুহিংয়া জাংয়ে, “ও প্রভু, নাতিরাং বেনাহা কাহিংয়া নাকোতা তিকো তোই-তোই তেইপামসা ওয়াংকো আজ্ঞা পিচা।”<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />আকুহা জাংয়ে, “লেই।”</para>
  <para style="p" vid="MAT 14:29">পত্রসহা নোওয়াইসো উইমসা ইশুকোতা তিকো তোই-তোই তেইপামসা লেহে। <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />আদো বিংঙা সিওপা ভিওয়া আসা চুরা লোওয়া তিংমসা আকুহা চুসুংপুয়ে। আসা তিতা নুচপুদাংনুওয়া “ও প্রভু, কাহিং বাচাইপি” তামসা ঙামসা জাংয়ে।<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />ইশুহা তাত্রিংপা আকো খুই প্যইমসা জাংয়ে, “হানি নাকো দেংওয়াহা, নাতিহা হাংপা সন্দেহ জোমগা?”<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />হাত্রং আবি নোওয়াইতা ল্যই, আত্রংহা বিংঙা ভিওয়াহা সাংয়ে। <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />নোওয়াইতা নিওয়া য়োংতোংবিহা আকুহিংয়া নোংসুয়ে, আসা জাংসুয়ে, “আজিপ্পারাং নাতিহা সেংজাকো চেংওয়া গুং।”<verse eid="MAT 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />নুব্যা দেকানুওয়া আবিহা গনেসোরেত তাওয়া জায়গাতা উইয়ে। <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />হাত্রং আকু জায়গাকো দিংঙাবি ইশুহিং নাই, আত্রংহা আবিহা দিব্যা নুব্যাকো জায়গাবিতা দেরেং কাইপুয়ে, আসা দিংঙাবিহা উইসে হাইওয়াবিহিং আকোতা পারায়ে। <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />আবিহা আকো আংদুংকো আরিকো নামু মেংচে সুচা মুংকো তামসা আকুহিং জাংচায়ে, আসা হাসে ইচো দিংঙাবি আকো আংদুংহিং সুচানি, আবিহা তাংসা সাংচপুয়ে।<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">চোসোওয়াসো ধুইওয়া</para>
  <para style="r">(<ref loc="MRK 7:1-13">মর্কুস ৭:১-১৩</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />য়রুশালেমসো লেওয়া লেরা ফরিসিবি আসা তাংজিকো উটকেওয়াবিহা ইশুকোতা লেয়ে, আসা জাংয়ে, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“নাকো য়োংতোংবিহা আটা আজাবিকো ল্যচ্যইপ্যচ্যইহিংয়া হাংপা মামানেমগা? আবিহা চানুরোমা নাগাইকো লিংপাংতা নিওয়ারে পুরা মোজোমগা।”<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />আকুহা আবিহিংয়া জাংয়ে, “নাবিরে হাংপা আপনিকো লিংপাংকো সোতা সেংজাকো লিংপাংহিংয়া মামানেমগা? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />হাংপাতানাহা সেংজাহা জাংমি নিও, আপনিকো আয়ুসো আপাহিংয়া আদর জো, আসা আয়ু আপাকো তোইতা হাংসু মেংতাপা য়্যই, আকুহা আজিপ্পারাং সিনেরোওয়া। <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />আদো নাবিহা জাংমগা, ‘হাংসু আপনিকো আয়ুসো আপাহিং নাতিহা কুংসো হাং য়ুচাকো কেংমে, আকুহা কাহা সেংজাহিং পিচাপুনতেমি নিও’ আকো সোতা আপনিকো আপাহিংয়া আদর জোমঘ্যইরোওয়া। <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />এপা জোমসারাং নাবিহা আপনিকো ল্যচ্যইপ্যচ্যইকো সোতা সেংজাকো য়্যইদিহিংয়া হাইরে টেকামাচুইপা জোপুমি নিও। <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />ও তেপিবাই! এশাইয়া অগমবক্তাকো জাংতেওয়া নুওয়াংবিহা নাবিহিংয়া তিতিয়ে:<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />‘ই দিংঙাবিহা কাহিংয়া নামুসো মেংচে আদর জোমগা,</para>
  <para style="q1" vid="MAT 15:8">আদো ইবিকো তুংসিংহা কুংসো তানাং নিও।<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />নাবিকো কাহিং তাচাওয়াহা তেংবেগা,</para>
  <para style="q" vid="MAT 15:9">আদো নাবিকো ঝিপাওয়াহা দিংঙাবিকো ঝিপাওয়া লিংপাং মেংচেগা।’<note caller="+" style="x"><char style="xo" closed="false">১৫:৯ </char><char style="xt" closed="false"><ref loc="ISA 29:13">এশাইয়া ২৯:১৩</ref></char></note>”<verse eid="MAT 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />ইশুহা দিংঙাবিহিং মোউমসা জাংয়ে, “হিং, আসা কোই। <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />নামুসো চামসা নাপোতা হোওয়া চাওয়া-আংওয়াবিসোহা দিংঙাহিংয়া মেংতাপা মোজোমগা। আদো হানি নুওয়াং নামুসো বাইরে নো, আকুরাং দিংঙাহিংয়া মেংতাপা জোমগা।”<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />আকো নোইতা য়োংতোংবিহা ওয়াংমসা আকুহিং জাংয়ে, “নাতিহা গেদিংগা? ফরিসিবিহা নাকো নুওয়াং হিংমসা সেদ্রাংপুমি নিনা।”<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />আদো আকুহা জাংয়ে, “লোডিংবাতা নিওয়া কুং আপাকো মাতিংওয়া সিংতেংবিহা তাংসা ডেবেসোরাং ওইচপুরোওয়া। <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />আবিকো নুওয়াংরাং মাহিংগে, আবিহা মিচো মাতিংওয়া উটকেওয়াবিগা। মিচো মাতিংওয়া ইচো দিংঙাহা দোসরা মিচো মাতিংওয়াহিং ত্যইংনাহা আবি নিহসোসা হোক্রাতা হুইচারোওয়া।”<verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />পত্রসহা আকুহিংয়া জাংয়ে, “কাবিহিং ই মিংচিতা জাংওয়া নুওয়াংহা হাং জাংকো কেংমে কোইপাপি।”<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />ইশুহা জাংয়ে, “নাবিরে নেচোইপা মোকোইয়াংগা? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />নাবিহা মেগেয়াংগা, হানি চাওয়া-আংওয়াবি নামুকো নাপোতা হো, আকুহা ফেমাতা হোমসা বাইরে নোপুমগা। <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />আদো হানি নুওয়াং নামুসো বাইরে নো, আকুহা তুংসিংসো নোমগা, আসা আকুসোরাং দিংঙাহিংয়া মেংতাপা জোমগা। <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />হাংপাতানাহা দিংঙাকো তুংসিং নাপোসোরাং মেংতাপা নোওয়া, স্যাওয়া, নুংনাংসুওয়া, কুইওয়া, আজ্যাপা জাংজ্রুওয়া আসা মিছিপা জোওয়া নুওয়াংবিহা বাইরে নোমগা। <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />ই নুওয়াংবিসোহা দিংঙাবিহিংয়া মেংতাপা জোপামগা। আদো খুই মাদুপা চাওয়াসোহা আকুহিংয়া মেংতাপা মোজোমগা।”<verse eid="MAT 15:20" /></para>
  <para style="s">কনানী মেমেকো দেংওয়া</para>
  <para style="r">(<ref loc="MRK 7:24-30">মর্কুস ৭:২৪-৩০</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />ইশুহা আকু জায়গাহিং হুইতেমসা তুরোস আসা সিদোনকো শহরকো হুরাপা নিওয়া জায়গাবিতা হোপুইয়ে। <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />আকু জায়গাসোহা ইচো কনানী মেমে লেমসা ঙামসা জাংয়ে, “ও প্রভু, দাউদকো চেংওয়া, কুং তোইতা লামতুপি। কুং চেমেহিংয়া জেসাং দ্যইচপুওয়াকো সোতা সিওপারাং দুঃখ মুংদিংনা।”<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />ইশুহা আকুহিংয়া হাইরে মাজাংতো। আকো য়োংতোংবিহা আকোতা ওয়াংমসা আকুহিং জাংচায়ে, “ইহিংয়া নিংপি, হাংপাতানাহা ইহা ঙামসা য়োংকো নুনুই হুইদিংনা।”<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />ইশুহা আকুহিং জাংয়ে, “কাহিংয়া ইস্রাইল জ্যাকো য়াংপুওয়া লুকাবিকো সোতা মেংচে নিংপুমগা।”<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />আদো আকু মেমেহা ওয়াংমসা আকো নাগাইতা চুনুইমসা জাংয়ে, “ও প্রভু, কাহিং য়ুজ্রুপি।”<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />আকুহা জাংয়ে, “আপেবিকো চাদিংওয়া কোব্রেং গিংমসা কিয়াবিহিং পিচাওয়াহা এনতাওয়া মোকো।”<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />আকু মেমেহা জাংয়ে, “আজিপ্পারাংগা প্রভু, আদো কিয়াবিরে আপনিকো গিরিবি চাদিংনু হুইচাওয়া চোংব্রাবি য়োমসা চামগা।”<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />আত্রংহা ইশুহা আকুহিংয়া জাংয়ে, “ও মেমে, নাকো দেংওয়াহা টেবো নিয়ুং! নাকো নোওয়া সেই তাংসা নাতিহিংয়া জিংকো।” আকু মেমেকো চেমেহা আত্রংতারাং সাংচপুয়ে।<verse eid="MAT 15:28" /></para>
  <para style="s">ইশুহা চার হাজার দিংঙাবিহিং চাকো পিচাওয়া</para>
  <para style="r">(<ref loc="MRK 7:31-8:10">মর্কুস ৭:৩১–৮:১০</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />ইশুহা আউসো নোমসা গালীলি ঝাহাদিকো আরি আরিসো জিংপুমসা হোয়ে, আসা য়্যাগ্যইকো তোইতা হোমসা আউতা গায়ে। <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />আত্রংহা উইসে দিংঙাবিহা আকোতা ওয়াংয়ে, আসা আবিকো চিত্তা পারাওয়া তেইকো মাচুওয়া, চা-সিওয়া, মিচো মাতিংওয়া, য়্যইকো মাচুওয়া আসা লেরা উইসে হাইওয়া দিংঙাবিহিং আকো নাগাইতা পারায়ে, আসা আকুহা আবি তাংসাহিং সাংপাপিয়ে। <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />আত্রংহা য়্যইকো মাচুমবিহা য়্যইওয়া, সাঁপেবিহা সাংওয়া, তেইকো মাচুমবিহা তেইওয়া, আসা মিচো মাতিংবিরে তিংকো চুওয়া তিংমসা দিংঙাবিহা আআংপেপেপা জিংপুয়ে, আসা আবিহা ইস্রাইলকো সেংজাহিং তাচায়ে।<verse eid="MAT 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />আত্রংহা ইশুহা য়োংতোংবিহিং আপনিকো আবেইতা মোউমসা জাংয়ে, “ই দিংঙাবিহিং তিংমসা কাহা সিওপারাং লামতুনা। ইবিহা সাসুংয়ুসো কাহিংপারাং নিও। ইবিহিংয়া চাওয়া হাইরে মোতো। ইবিহিংয়া কা নুইতোং মিনিংপুরো। মোকোনাহা ইবিহা ন্যাতাতা আমা পাংপুমসা লোবোসুংপুরোওয়া।”<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />আত্রংহা য়োংতোংবিহা ইশুহিংয়া জাংয়ে, “এসে উইসে দিংঙাবিহিংয়া ই চিচ্চোওয়া জায়গাতাহা চাকো পিচাকোহা কাবিহা এসে কোব্রেং হাংতা লাকোগা?”<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />ইশুহা আবিহিংয়া জাংয়ে, “নাবিহিংপাহা হাসে ইচো কোব্রেং নিংগা?”</para>
  <para style="p" vid="MAT 15:34">আবিহা জাংয়ে, “নীচো কোব্রেং আসা ইপু নিহপু আপেচাওয়া নায়া মেংচে নিনা।”<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />ইশুহা তাংসা দিংঙাবিহিংয়া ওয়াংবোইতা গাকো তামসা জাংয়ে। <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />আকুহা আকু নীচো কোব্রেং আসা নায়াবি চুংমসা সেংজাহিং গারানি তামসা জাংপুনতেনুওয়া কোব্রেং ছিমসা য়োংতোংবিকোতা সোইয়ে, আসা য়োংতোংবিহা দিংঙাবিহিং চোপিয়ে। <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />আউতা নিওয়া দিংঙাবিহা তাংসারাং চাসুয়ে, আসা গাইয়ে। আসা লাওয়া কোব্রেংকো চোংব্রাবিহা আবিহা নীচো চেরেং মেইপক্যইপা য়োয়ে। <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />মেমেবি আসা চেংচুংবিহিং ল্যামসা আউতা চাওয়াহা পোজা দিংঙাবিদাং মেংচে চার হাজার গাংদাং মাগাংদাংপা নিমি। <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />আকো নোইতাহা ইশুহা আকু দিংঙাবিহিংয়া আউসো নিংপিয়ে। আসা আকুহা নোওয়াইতা বাইমসা মাগাদান তাওয়া লোইতা হ্যাপুয়ে।<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">আআংপেপেচপুওয়া কামবি কাংকো কেংওয়া</para>
  <para style="r">(<ref loc="MRK 8:11-13">মর্কুস ৮:১১-১৩</ref>; <ref loc="LUK 12:54-56">লুক ১২:৫৪-৫৬</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />ফরিসিবি আসা সদুকিবিহা ইশুকোতা লেয়ে, আসা আকুহিং লোডিংবাসো লেনাহা ইচো চিহ্ন তিংপা তামসা পরিক্ছা জোয়ে।<verse eid="MAT 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 16:2" />আদো আকুহা আবিহিংয়া জাংয়ে, “জিরোং জিংপুনুওয়া নাবিহা জাংমগা, ‘জুকুংকো দিনহা এনতাপা জিংরোওয়া, হাংপাতানাহা ডিংবাহা অ্যালুইপা নিও।’ <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />আসা হাপকুংহা জাংমগা, ‘ডিংবাহা অ্যালুইপা আসা নাটুংপা জিংমি নিও, হিনিহা বিংঙা হ্যারগুং।’ নাবিহা ডিংবাকো মোকে-চোকেওয়া কাংমসা হাং জিংকোমে জাংকো চুমগা, আদো সময়কো চিহ্নবি কাংমসা হাং জিংকোমে তামসা হাংপা জাংকো মাচুমগা। <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />হিনি জুকুংকো ই দিংঙাবিহা মেংতাওয়া আসা নুনাংসুওয়াবি নিও। ইবিহা আআংপেপেচপুওয়া চিহ্নবি মেংচে মোমগা, আদো অগমবক্তা য়োনাকো চিহ্ন ল্যামসা দোসরা হাইরে ন্যইচা মামুংরোওয়া।” আকো নোইতা ইশুহা আবিহিং হুইতেমসা আউসো হ্যাপুইয়ে।<verse eid="MAT 16:4" /></para>
  <para style="s">ফরিসি আসা সুদুকিবিকো ঝিপাওয়াবিকো বিষয়তা</para>
  <para style="r">(<ref loc="MRK 8:14-21">মর্কুস ৮:১৪-২১</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />আকো নোইতাহা য়োংতোংবিহা ঝাহাদিকো নুব্যাই দেকানুওয়া আবিহা কোব্রেং পাকো লারিংপুয়ে তামসা প্যারাতাংয়ে।<verse eid="MAT 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 16:6" />ইশুহা আবিহিংয়া জাংয়ে, “হোশিয়ার য়ুং, ফরিসি আসা সুদুকিবিকো সোঁরাসো জোগেমসা য়ুং।”<verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />য়োংতোংবিহা তাইবিলারাই জাংসুয়ে, “য়াংবি কোব্রেং মাপামকো সোতা, আকুহা এপা জাংমদোওয়া।”<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />ইশুহা ই নুওয়াং সিদা চ্যইমসা জাংয়ে, “হানি নাবিকো দেংওয়াহা? হাংপা নাবিহা কোব্রেং মাপানা তামসা আপনি লারাই য়্যইসুদিংগা? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />নাবিহা নেচোইপা মোকোইয়াংগা? পাঁচ হাজার দিংঙাবিহিং ঙাচো কোব্রেংসো চাকো পিচানুওয়া নাবিহা হাসে ইচো ডেংগে য়োংগা? নাবিহা আকু লারিংপুংগা? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />আসা ন্যাসারাং নীচো কোব্রেংসো চার হাজার দিংঙাহিং চাকো পিচানুওয়া নাবিহা লাওয়া কোব্রেংহা হাসে ইচো ডেংগে য়োংগা? আকুরে লারিংপুংগা? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />কাহা নাবিহিংয়া কোব্রেংকো তোইতা জাংওয়া মোকোমি তামসা নাবিহা হাংপা মোকোইমগা? আদো ফরিসি আসা সুদুকিবিকো সোঁরাসো হোশিয়ার য়ুং।”<verse eid="MAT 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12" />আত্রংহা আবিহা কোইয়ে, আকুহা কোব্রেং বুইপাওয়া সোঁরাকো মোকো, ফরিসি আসা সুদুকিবিকো ঝিপাওয়াবিসো হোশিয়ার য়ুংকো তামসা জাংমকো গুং।<verse eid="MAT 16:12" /></para>
  <para style="s">ইশুহা হাংসুমে?</para>
  <para style="r">(<ref loc="MRK 8:27-30">মর্কুস ৮:২৭-৩০</ref>; <ref loc="LUK 9:18-21">লুক ৯:১৮-২১</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />ইশুহা কোইসোরিয়া ফিলিপ্পীকো জায়গাতা ওয়াংপুনতেনুওয়া, আকুহা আপনিকো য়োংতোংবিহিং উইয়ে, “দিংঙাবিহা দিংঙাকো চেংওয়াহিংয়া হাংসুগা তামসা জাংমগা?”<verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />আবিহা জাংয়ে, “লেরাহা বাপ্তিস্মা পিচাওয়া য়হুন্না, লেরাহা জাংসুয়ে এলিয়া, আসা লেরাহা য়র্মিয়া, মোকোনাহা অগমবক্তাবিতাহা ইচোদোওয়া তামসা জাংসুচাংমি।”<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />আকুহা আবিহিংয়া জাংয়ে, “নাবিহা হাং জাংকোগা, কাহা হাংসুগা?”<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />সিমোন পত্রসহা জাংয়ে, “নাতিহা ঙাজ্যইং সেংজাকো চেংওয়া, মুক্তি পিচাওয়া জাইপু খ্রীষ্ট।”<verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />ইশুহা আকুহিংয়া জাংয়ে, “য়োনাকো চেংওয়া সিমোন, নাতিহা আশিষিত নিও, হাংপাতানাহা নাতিহা দিংঙাকো নোচেংসো নোওয়া জাংওয়া মোকো, আদো লোডিংবাতা নিওয়া কুং আপারাং নাতিহিং কোইপামগা। <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />কা নাতিহিংয়া জাংরোওয়া, নাতিহা পত্রসগা (পত্রস তাওয়াহা পাত্যারুংগা)। ই পাত্যারুংতারাং কা কুং মন্ডলিবিহিং জাপারোওয়া, আসা ই কুং মন্ডলিহিংয়া সিদিংকো সেরে জিয়োমক্যইরোওয়া। <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />কা নাতিহিংয়া সেংজাকো রাজ্যকো লাপুং ওয়েওয়া গোইচোবি পিচারোওয়া। হানি নাতি বাসিমতিতা দাঁ, আকুহা লোডিংবাতা দাঁচপুরোওয়া, আসা হানি নাতি বাসিমতিতা ওয়ে, আকুহা লোডিংবাতা ওয়েচপুরোওয়া।” <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />আকো নোইতাহা আকুহা য়োংতোংবিহিংয়া কা মুক্তি পিচাওয়া খ্রীষ্টগা তাওয়া নুওয়াং হাংসুহিংনে মাজাংকো তামসা জাংয়ে।<verse eid="MAT 16:20" /></para>
  <para style="s">ইশুহা আপনিকো সিওয়াকো তোইতা ল্যাওয়া</para>
  <para style="r">(<ref loc="MRK 8:31-33">মর্কুস ৮:৩১-৩৩</ref>; <ref loc="LUK 9:22">লুক ৯:২২</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />আকু সময়সো ইশুহা য়োংতোংবিহিংয়া আকুহা য়রুশালেমতা হোনেরোওয়া, আসা আউতা য়হুদি মাটা ওয়ারাংপাবি, মাটা পাউবি আসা তাংজিকো উটকেওয়াবিকোসো উইসে নুওয়াংতা কোইচ্যানেরোওয়া, সিনেরোওয়া আসা সাসুংয়ুকো নোইতাহা ন্যাসারাং সিওয়াসো ঙারোনেরোওয়া তাওয়া নুওয়াংবিহা আত্রংসো য়ুতা আকুহা আকো য়োংতোংবিহিং ল্যায়ে।<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />আদো পত্রসহা আকুহিংয়া ইদ্যাতা পুরামসা এপা জাংমসা য়েংয়ে, “প্রভু, সেংজাহা নাকো তোইতা হাত্রংরে এপা মাজোকো।”<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />আদো আকুহা পত্রসকোতা ন্যইমসা জাংয়ে, “ও শয়তান, কুং আবেইসো ওয়েংপু, নাতিহা কুং ন্যাতাতা কুটিওয়া লুংটুই একো কেংদিংয়ো, হাংপাতানাহা নাতিহা সেংজাকো নুওয়াংতা মোকো, আদো দিংঙাবিকো নুওয়াংতা প্যারাপামগুং।”<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />আকো নোইতা ইশুহা আকো য়োংতোংবিহিং জাংয়ে, “হাংসু কুং নুনুই হুইকো কেং, আকুহা আপনিকো জুপাকো ইচ্ছাহিংয়া ল্যানেরোওয়া, আসা আপনিকো ক্রুস পুমসা কুং নুনুই হুইনেরোওয়া। <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />হাংপাতানাহা হাংসু আপনিকো সাদিহিং বাচাইকো কেং, আকুহা য়াংপারোওয়া, আদো হাংসু কুং সোতা আপনিকো সাদি য়াংপা, আকুহা তুতেংজু য়ুংওয়া সাদি মুংচারোওয়া। <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />দিংঙাহা বাসিমতিতা নিওয়া তাংসাহিংনাং আপনিকো খুইতা পারাদো, হাত্রংরে মিশিওয়া সাদিবেমি য়াংপাপুনাহা হাং তোইংদ্যা নিংগা? আসা দিংঙাহা আপনিকো সাদিকো সোতাহা হাং পিচাকো চুকোগা? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />হাংপাতানাহা দিংঙাকো চেংওয়াহা আপনিকো আপাকো মহিমাতা আপনিকো লোডিংবাকো পোইংবিহিংপা লেরোওয়া, আসা আত্রংহা আকুহা তাংসা দিংঙাবিহিং আবিকো কাম জোওয়া সেই ইনাম পিচারোওয়া। <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />আজিপ্পারাং, কা নাবিহিংয়া জাংরোওয়া, ই জাওয়াবিতাহা লেরাহা দিংঙাকো চেংওয়াহিংয়া আপনিকো রাজ্যতা দেপাওয়া মাতিংনু চোইপা মিসিরোওয়া।”<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">ইশুকো য়ুওয়্যাই দোসরা জিংপুওয়া</para>
  <para style="r">(<ref loc="MRK 9:2-13">মর্কুস ৯:২-১৩</ref>; <ref loc="LUK 9:28-36">লুক ৯:২৮-৩৬</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />সাটুয়ু নোইতা ইশুহা পত্রস, য়াকুব আসা আকো এ য়হুন্নাহিং মেংচে আকুহিংপা তোলোংওয়া য়্যাগ্যইকো তোইতা পুরামসা হোয়ে। <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />তোইতা দেকানুওয়া য়োংতোংবি ন্যইদিংওয়া কোকোইত্তা ইশুকো য়ুওয়্যাই দোসরা জিংপুয়ে। আকো য়ুওয়্যাইহা সানি বেপা হাহাইপা জিংপুয়ে আসা আকো আংদুংহা চাচাইপা হাংপাপা জিংপুয়ে। <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />একবিরি আউতাহা অগমবক্তা মোসা আসা এলিয়া তিংরেয়ে আসা ইশুহিংপা য়্যইসুয়ে। <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />ই তিংমসা পত্রসহা ইশুহিং জাংয়ে, “প্রভু, কাবিরে ইতা নিওয়াহা এনতাপারাং জিংয়ো। নাকো ইচ্ছা জিংনাহা কা ইতা সুংচো গ্যই বানাইরোওয়া, ইচোহা নাতিহিং, ইচোহা মোসাহিং, আসা ইচোহা এলিয়াহিং।”<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />পত্রসহা এপা জাংমসা য়্যইওয়া কোকোইত্তা আউতাহা গুইং তুরেপুয়ে আসা আকু গুইং তুওয়াসোহা আবিহা ইচো ক্যা হিংয়ে, “ইহা কুং জেজেংওয়া চেংওয়াগা, কা ইহিংপা গাগ্রুপা নিও। নাবিহা ইকো নুওয়াং হিং।”<verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />ই ক্যা হিংমসা য়োংতোংবিহা চুসুংপুমসা লিতা নুউমসা চুনুইসুয়ে। <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />আদো ইশু লেমসা আবিহিং সুমসা জাংয়ে, “লো, মাচ্ছুংগে!” <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />আসা আবি লোমসা কাংনুওয়া আউতাহা ইশু মেংচে নিমি, দোসরাহা হাংসুরে মাতামি।<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />য়্যাগ্যইসো উইপামসা লেপানুওয়া ইশুহা আবিহিং আজ্ঞা জোয়ে, “কাং, কা দিংঙাকো চেংওয়া সিমসা মাঙারোনু চোইপা নাবিকো ই তিংওয়া নুওয়াংহা হাংসুহিংনে মাজাংঘ্যই।”<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />য়োংতোংবিহা ইশুহিং উইয়ে, “তাংজিকো উটকেওয়াবিহা হাংপাসা খ্রীষ্টরোমা নাগাইহা এলিয়া লেনেরো তামসা জাংচাংমগা?”<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />ইশুহা জাংয়ে, “ওই, আজিপ্পারাং এলিয়াহা তাংসা নুওয়াং তৈয়ার জোকো লেনেরোওয়া। <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />কাং, কা নাবিহিং জাংরোওয়া, এলিয়াহা লেপুনতেও। আদো দিংঙাবিহা আকুহিংয়া নাইমক্যইতো আসা আবিহা আকুহিংয়া হাই জোদাংবেপা জিং, আকুরাং জোয়ো আসা কা দিংঙাকো চেংওয়াহিংনে আবিহা এপারাং জোরোওয়া।” <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />আত্রং মেংচে ইশুহা বাপ্তিস্মা পিচাওয়া য়হুন্নাকো তোইতা জাংমকো গুং তামসা য়োংতোংবিহা কোইয়ে।<verse eid="MAT 17:13" /></para>
  <para style="s">সিংঙো দ্যইংচপুওয়া পোজা</para>
  <para style="r">(<ref loc="MRK 9:14-29">মর্কুস ৯:১৪-২৯</ref>; <ref loc="LUK 9:37-43">লুক ৯:৩৭-৪৩</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />আকো নোইতা ইশুহা য়োংতোংবিহিংপা উইসে দিংঙা নিওয়াতা ওয়াংপুনতেনুকো নোইতাহা ইচো দিংঙাহা আকো আবেইতা তুরুই চুইনুইমসা জাংয়ে, <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />“প্রভু, কুং চেংওয়াকো তোইতা লামতুপি, হাংপাতানাহা ইহিংয়া জ্যান্যাপেইওয়া য়োংন্যা নিওয়াকো সোতা সিওপারাং দুঃখ মুংদিংনা। আকুহা লেচোংহা মেতা আসা লেচোংহা তিতা ইপুচাংমি। <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />কাহা আকুহিংয়া নাকো য়োংতোংবিকোতা পারায়ে, আদো আবিহা আকুহিংয়া সাংপামক্যইতো।”<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />আত্রংহা ইশুহা জাংয়ে, “ও দেংকো মোচুওয়া আসা ভ্রমতা পরেওয়া দিংঙাবাই! হাত্রং চোইপা কা নাবিহিংপা য়ুংকোগা? আকুহিং ইতা কুংতা পারা।” <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />ইশুহা আকু জেসাংহিংয়া চিংচাইয়ে, আসা আকু জেসাংহা আকু পোজাকো জুপাসো নোপুয়ে। আসা আকু পোজাহা আত্রংতারাং সাংয়ে।<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />আত্রংহা য়োংতোংবিহা ইশুকোতা চেকেপা ওয়াংমসা জাংয়ে, “কাবিহা আকু জেসাংহিংয়া হাংপা নোপাকো মাচুমগা?”<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />আকুহা য়োংতোংবিহিংয়া জাংয়ে, “নাবিকো দেংওয়া লিয়োমকো সোতাগা। আজিপ্পারাং কা নাবিহিং জাংরোওয়া, নাবিকোতা তৌরিকো অংসে এসেকোমি দেংওয়া নিনাহা ই য়্যাগ্যইহিং ‘ইসো ওয়েংপু’ তানাহা আকুহা ওয়েংপুরোওয়া। আসা নাবিহা হাই জিংদো জোক্যইরোওয়া। <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />[আদো এপাজিংওয়া জেসাংহা পাচাইওয়া আসা উপাস মাতানাহা মোনোমগা।”]<verse eid="MAT 17:21" /></para>
  <para style="s">ইশুহা ন্যাসারাং আপনিকো সিওয়াকো তোইতা ল্যাওয়া</para>
  <para style="r">(<ref loc="MRK 9:30-32">মর্কুস ৯:৩০-৩২</ref>; <ref loc="LUK 9:43-45">লুক ৯:৪৩-৪৫</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />আবিহা গালীল জায়গাতা য়ুংদিংনুওয়া ইশুহা য়োংতোংবিহিংয়া জাংয়ে, “দিংঙাকো চেংওয়াহিংয়া প্যইমসা দিংঙাবিকো খুইতা স্যইপুরোওয়া। <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />আসা আবিহা আকুহিংয়া স্যাপুরোওয়া, আদো আকুহা সাসুংয়ুকো নোইতাহা ঙারোরোওয়া।”</para>
  <para style="p" vid="MAT 17:23">ই হিংমসা য়োংতোংবিহা সিওপারাং তুংসিং চিচাপুয়ে।<verse eid="MAT 17:23" /></para>
  <para style="s">ইশুহা দেমসাকো তোংক্যা তাওয়া</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />হাত্রং ইশু আসা আকো য়োংতোংবি কোর্ফরনহুমতা ওয়াং, আত্রংহা দেমসাকো তোংক্যা জুমবিহা পত্রসকোতা ওয়াংমসা জাংয়ে, “নাবিকো উটকেওয়াহা তোংক্যা মাতাকোগা?”<verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />আকুহা জাংয়ে, “ওই তারোওয়ে।”</para>
  <para style="p" vid="MAT 17:25">পত্রস সাতা দেয়োংতেনুওয়া ইশুহা আকুহিংয়া উইয়ে, “সিমোন, নাকো নোচেংতাহা হেপা জিংচাংমগা? ই বাসিমতিকো জাইপুবিহা হাংসুকোসো তোংক্যা জুকোগা? আপনিকো চেংচুবিকোসোগা না দোসরাবিকোসোগা?”<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />পত্রসহা জাংয়ে, “দোসরাবিকোসো।”</para>
  <para style="p" vid="MAT 17:26">ইশুহা আকুহিংয়া জাংয়ে, “এপা বেনাহা আপনিকো চেংবিহা তোংক্যা তামঘ্যরগুং। <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />আদো য়াংবিহা ই দিংঙাবিহিংয়া তুংসিং মাচিচপাসি। নাতিহা হোতু, আসা দাব্রিতা জেরে তিকাতু। আসা হানিরোমা নাগাই জেরেতা ওয়াংওয়া নায়া নোপামসা আকো নামু ওয়ে। আকো নামুতা নাতিহা জাতাংকো ইচো টাংকা দোরোওয়া। আকুহা দেমসাকো তোংক্যা জুওয়াবিকোতা সামসা য়োংকো নিহসোকোসা তাতে।”<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">লোডিংবাকো লোইতা হাংসুরোমা টেবো</para>
  <para style="r">(<ref loc="MRK 9:33-35">মর্কুস ৯:৩৩-৩৫</ref>; <ref loc="LUK 9:46-48">লুক ৯:৪৬-৪৮</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />আত্রংকো সময়হা য়োংতোংবিহা ইশুকোতা ওয়াংমসা উইয়ে, “সেংজাকো রাজ্যতাহা হাংসুরোমা টেবোহা হাংসুগা?”<verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />আকুহা ইচো আপেচাওয়া চেংহিং মোউমসা আবিকো প্যাকোতা জাপায়ে, <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />আসা জাংয়ে, “আজিপ্পারাং কা নাবিহিং জাংরোওয়া, আপনিকো তুংসিংসো মেংতাপা নোওয়া ল্যামসা আপেচাওয়া চেং ত্যাবাপা জিংমক্যইনাহা হাত্রংরে সেংজাকো রাজ্যতা হোমক্যইরোওয়া। <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />হাংসু ই আপেচাওয়া চেং ত্যাবাপা আপনিহিং আপেচপা নো, আকুরাং সেংজাকো রাজ্যতা টেবো জিংরোওয়া। <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />হাংসু কুং মিংতা এপা জিংওয়া আপেহিং গ্রহন জো, আকুহা কাহিং গ্রহন জোওয়াগা।<verse eid="MAT 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />“আদো হাংসু কুং তোইতা দেংওয়া ই আপেবিতাহা ইচোহিং পাপ জোপানাহা, আকুরোমাহা আকো নেটোংতা ওয়াংটাকো লুংটুই জিংমসা আকুহিংয়া ঝাহাদিকো চমেংতা বাডোই পুওয়ারাং এনতারোওয়া।<verse eid="MAT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7" />“টেবো পাপ ওয়াংকো ই বাসিমতিতা! হাংপাতানাহা ই বাসিমতিতাহা দিংঙাবিহিংয়া পাপতা পুরাওয়া নুওয়াংবি নিও, এপা জিংওয়া নুওয়াংবিহা ওয়াংকোহা ওয়াংমগা, আদো টেবো দুঃখ ওয়াংকো আকু দিংঙাকোতাহা, হাংসু দোসরাহিং পাপতা পুরামমে! <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />নাকো খুই আসা কোকোইমি নাতিহিং পাপ জোপানাহা আকুহিংয়া ঠেমসা বাদোইপুই। কোকোই আসা খুই নিপা নরককো মেহতা বাডোইচাপুমরোমাহা, খুই কোকোই মাতাপা হাত্রংরে মিসিওয়া সাদিতা হোকো নাকো সোতাহা এনতারোওয়া। <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />নাকো মিচোমি নাতিহিং পাপতা পুরানাহা আকুহিংয়া নোপামসা বাডোইপুই। নিহসো মিচো নিপা নরককো মেহতা বাডোইচাপুমরোমাহা মিচো মিতিংওয়া জিংমসারাং সাদি নিওয়াতা হোকো নাকো সোতাহা এনতারোওয়া।”<verse eid="MAT 18:9" /></para>
  <para style="s">য়াংপুওয়া লুকাকো মিংচি</para>
  <para style="r">(<ref loc="LUK 15:3-7">লুক ১৫:৩-৭</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />“হোশিয়ার য়ুং, নাবিহা ই আপেবিহিংয়া ইচোহিংনে মিছিমেপা মোজো, হাংপাতানাহা কা নাবিহিংয়া জাংরোওয়া, ইবিহিংয়া য়ারাপাওয়া পোইংবিহা লোডিংবাতা কুং আপাকো নাগাইতা নিও। <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />[হাংপাতানাহা কা দিংঙাকো চেংওয়াহা য়াংপুমবিহিংনাং বাচাইকো লেমগা।]<verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />“নাবিহা হাং নোংগা? নাকাইপু লুকাবি নিওয়া দিংঙাকো ইপু লুকামি য়াংপুনাহা আকু দিংঙাহা হাং জোকোগা? আকুহা লেরা নিরানব্বই লুকাবিহিংয়া ল্যাচোইওয়াতারাং হুইতেমসা আকু য়াংপুওয়া ইপু লুকাহিং মোমোকাকোগা? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />আকুমি য়াংপুওয়া লুকাহিং দোচানাহা, আজিপ্পারাং কা নাবিহিং জাংরোওয়া, আকু মায়াংয়াংওয়া নিরানব্বই লুকাবিরোমাহা আকু ইপু লুকাকো সোতা আকুহা সিওপারাং য়াংতারোওয়া। <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />এপারাং লোডিংবাতা নিওয়া নাবিকো আপাকোহা ই ইচ্ছা নিও, ই আপেবিতাহা হাংসুরে মাদাংকো।<verse eid="MAT 18:14" /></para>
  <para style="s">মেংতাপা কাম জোওয়া এ</para>
  <para style="r">(<ref loc="LUK 17:3">লুক ১৭:৩</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />“নাকো ইচো দেংওয়া এমি নাকো তোইতা মেংতাপা কাম জোনাহা, নাতি ইচোদাং হোমসা আকো দোষ তিংপাপি। আকুমি নাকো নুওয়াং হিংনাহা, নাতিহা আকুহিংয়া আপনিকো কাটুতা লাপোংমসা পারা। <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />আদো আকুমি মাহিংনাহা, তাংজিকো হিগাতা জাংমি ত্যাবাপা নাতিহিংপা ইচো নিহসো দিংঙাবি পুরাতু আসা নিহসো সুংচোকো প্রমানতা তাংসা নুওয়াং সল্লাতা জিংকো। <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />ন্যাসারাং আকুহা নাবিকো নুওয়াংরে হিংকো ইন্কার জোনাহা, মন্ডলিহিং জাং। আকুহা মন্ডলিকো নুওয়াংরে হিংকো মেকেংনাহা, আকুহা নাকো সোতাহা তাংজি মাতাওয়া আসা তোংক্যা জুমবি ত্যাবাপা জিংপুকো।<verse eid="MAT 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />“আজিপ্পারাং, কা নাবিহিংয়া জাংরোওয়া, নাবি বাসিমতিতা হাই মেই, আকুহা লোডিংবাতা মেইচাপুরোওয়া। আসা নাবি বাসিমতিতা হাই ওয়ে, আকুহা লোডিংবাতা ওয়েচপুরোওয়া।<verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />“ন্যাসারাং কা নাবিহিংয়া জাংরোওয়া, বাসিমতিতা নাবিহা নিহসো চিত্তা গাসুমসা ইচো তুংসিং জিংমসা হাইক্রি য়ানাহা, নাবিকো লোডিংবাতা নিওয়া আপাহা নাবিহিংয়া পিচারোওয়া, <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />হাংপাতানাহা হাংতা নিহসো মোকোনাহা সুংচো কুং মিংতা চিত্তা য়ুংসু, আউতাহা কা নাবিহিংপা নিরোওয়া।”<verse eid="MAT 18:20" /></para>
  <para style="s">মাপ মাপিচাওয়া ডেইয়াকো মিংচি</para>
  <para style="r">(<ref loc="LUK 17:4">লুক ১৭:৪</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />পত্রসহা ওয়াংমসা ইশুহিংয়া উইয়ে, “প্রভু, কুং ইচো দেংওয়া এমি কুং তোইতা পাপ জোদিংনাহা কাহা আকুহিংয়া হাসে ইকোই চোইপা মাপ পিচানেকোগা? নীকোই চোইপাগা?”<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />ইশুহা আকুহিংয়া জাংয়ে, “কা নাতিহিংয়া জাংরোওয়া, নীকোই মোকোমি, সত্তরি গুনা নীকোই চোইপা।<verse eid="MAT 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23" />“আকো সোতা সেংজাকো রাজ্যহা ইচো জাইপুহা আপনিকো ডেইয়াবিকোতা হিসাব লাংওয়া ত্যাবাপাগা। <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />হাত্রং আকু হিসাব লাংকো কেং, আত্রংহা দশ হাজার সুনকো টাংকা ঋণ য়ুওয়া দিংঙাহা আকোতা সারেয়ে। <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />আদো আকু দিংঙা তাকো মাচুনুওয়া আকো জাইপুহা আকুহিং আসা আকো মে, আকো চেংচুংবি, আসা আকোতা নিওয়া তাংসা পিচামসা ঋণ তাকো তামসা আজ্ঞা জোয়ে।<verse eid="MAT 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26" />“আত্রংহা আকু ডেইয়াহা আকো কোকোইকো নাগাই কাটুসো তুরুই চুনুইমসা জাংয়ে, ‘উটকেওয়া, সাইয়ু নিহয়ু খুইপি, কা নাকো তাংসা ঋণ তাপিরোওয়া।’ <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />আত্রংহা আকু ডেইয়াকো জাইপুহা লামতুপুমসা আকুহিংয়া ল্যাপিয়ে, আসা আকো তাংসা ঋণ মাপ জোপিয়ে।<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />“আদো আকু ডেইয়াহা নোপুমসা হ্যাদাংনুওয়া আপনিকো ব্যারো ডেইয়াবিতাহা ইচোহিং দোসুয়ে। আকু ব্যারোহা আকোসো একশো জাতাংকো টাংকা য়ুওয়া নিমি। আকুহা আকুহিংয়া গোংটোতা প্যইমসা জাংয়ে, ‘নাকো ঋণ তাকো জো।’<verse eid="MAT 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29" />“আদো আকো ব্যারোহা চুনুইমসা আকুহিংয়া জাংচায়ে, ‘সাইয়ু-নিহয়ু খুইপি, কা নাতিহিংয়া তাংসা ঋণ তাপিরোওয়া।’ <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />আদো আকুহা মামানেতো, আসা হোমসা ঋণ মাতানু চোইপা আকুহিংয়া জেলতা সুংপুইয়ে। <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />হাত্রং আকো ডেইয়া ব্যারোবি ই তাংসা তিং, আত্রংহা আবিহা সিওপারাং তুংসিং চিচাপুয়ে। আবিহা হোমসা ই তাংসা নুওয়াংবিহা আপনিকো জাইপুকোতা জাংয়াপুয়ে। <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />আত্রংহা আকু জাইপুহা আকু ডেইয়াহিংয়া আপনিকোতা মোউমসা জাংয়ে, ‘ও মেংতাওয়া ডেইয়া, নাতিহা কাহিং জাংচায়ে, আসা কাহা নাকো তাংসা ঋণ মাপ জোপিয়ে। <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />কাহা নাকো তোইতা লামতুপা জোমি ত্যাবাপা নাতিরে নাকো ব্যারো ডেইয়াবিকো তোইতা লামতুপা জোনেকো মোকোতা?’ <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />আসা আকু জাইপুহা সেদ্রাংপুমসা আকুহিংয়া তাংসা ঋণ মাতানু চোইপা জেলতা সুংকো তামসা আজ্ঞা জোয়ে।”<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />ইশুহা আকো য়োংতোংবিহিংয়া জাংয়ে, “নাবিহা আপনিকো ইচো দেংওয়া এহিংয়া আপনিকো তুংসিং নাপোসোরাং মাপ মিচানাহা, লোডিংবাতা নিওয়া কুং আপারে নাবিহিংয়া এপারাং জোরোওয়া।”<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">মেহিং পেইমতুরোওয়া তাওয়াকো তোইতা ঝিপাওয়া</para>
  <para style="r">(<ref loc="MRK 10:1-12">মর্কুস ১০:১-১২</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />ই নুওয়াং জাংপুনতেনুকো নোইতাহা ইশুহা গালীলসোহা য়হুদিয়াকো য়র্দন জোরাকো নুব্যাতা হোয়ে। <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />উইসে দিংঙাবিহা আকো নুনুই হুইপুয়ে, আসা আকুহা আউতা দিংঙাবিহিংয়া সাংপায়ে।<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />ইচো নিহসো ফরিসিবিহা আকোতা ওয়াংমসা আকুহিং পরিক্ছা জোমসা উইয়ে, “দিংঙাহা হাইরে কারণ মাতাপা আপনিকো মেহিং পেইকো লিংপাংতা জাংওয়া সেই তুকোগা না মোতুকোগা?”<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />আদো আকুহা জাংয়ে, “নাবিহা তাংজিকো হিগাতা মাপাড়াইয়াংগা? শুরুতা সেংজাহা দিংঙাহিং দিংনুওয়া পোজাসো মেমেহিং দিংমগা। <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />‘আকো সোতা দিংঙাহা আপনিকো আয়ু, আপাহিং ল্যামসা আপনিকো মেহিংপা য়ুংপুমগা, আসা আবি নিহসোহা ইচো জুপা জিংপুমগা।’ <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />আবিহা নেহা নিহসো মোকো, আদো ইচো জুপা জিংরোওয়া। আকো সোতা সেংজাহা হাংসুহিং চিত্তা ইচো জোমি নি, আকুহিংয়া দিংঙাবিহা মেপেইপাকো।”<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />আবিহা আকুহিংয়া জাংয়ে, “এপা বেনাহা মেহিং পেইওয়াবিহিংয়া পেইপুওয়াকো লেখা-পরি বানাইমসা পেইকো তামসা মোসাহা হাংপা লামগাসা?”<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />ইশুহা আবিহিংয়া জাংয়ে, “নাবিকো তুংসিং লুংটুই ত্যাবাপা জিংওয়াকো সোতারাং মোসাহা মেহিং পেইকো ছুরোওয়া তাওয়া নুওয়াং জাংমগা। আদো বাসিমতি দিংনুসোহা এপা মাতামগা। <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />কা নাবিহিংয়া জাংরোওয়া, নুংনাংসুওয়াকো দোষ মাতাপা মেহিং পেইমসা দোসরাহিং বিয়ৌ জোনাহা, আকুরে নুংনাংওয়ারাংগা।”<verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />য়োংতোংবিহা আকুহিংয়া জাংয়ে, “ওয়াসো মেকোহা এপাজিংওয়া সমন্ধবেমি নিনাহা বিয়ৌ মোজোওয়ারাং এনতারোওয়া।”<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />ইশুহা আবিহিংয়া জাংয়ে, “তাংসা দিংঙাবিহা এপা জিংওয়া য়্যইদিহা মানেমক্যইমগা, আবি মেংচে মানেকো চুরোওয়া, হাংসুহিং সেংজা পিচামমে। <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />হাংপাতানাহা লেরাহা কেনুসোরাং নপুংসক<note caller="+" style="f"><char style="fr" closed="false">১৯:১২ </char><char style="ft" closed="false">নপুংসক তাওয়াহা হিজারাহিং জাংমগা।</char></note> নিমগা, আসা লেরাহা দিংঙাকো বানাইওয়া নপুংসক নিমগা। আসা লেরাহা আপনিহিং সেংজাকো রাজ্যকো সোতা নপুংসক জিংমসা য়ুংমগা। হাংসু গ্রহন জোকো ছু, আকুহা ইহিংয়া গ্রহন জোকো।”<verse eid="MAT 19:12" /></para>
  <para style="s">আপেচিংওয়া চেংবিহিং আশিষ</para>
  <para style="r">(<ref loc="MRK 10:13-16">মর্কুস ১০:১৩-১৬</ref>; <ref loc="LUK 18:15-17">লুক ১৮:১৫-১৭</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />ইশু আপেবিকো তোইতা খুই ওইমসা পাচাইপিকো তামসা দিংঙাবিহা আবিহিং ইশুকোতা পারায়ে। আদো য়োংতোংবিহা আকু দিংঙাহিংয়া য়েংয়ে।<verse eid="MAT 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 19:14" />আদো ইশুহা জাংয়ে, “আপেবিহিংয়া কুংতা ওয়াংকো পিচা, আবিহিং মোয়োই, হাংপাতানাহা সেংজাকো রাজ্যহা এপাজিংওয়াবিকোরাংগা।” <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />আসা ইশুহা আকু আপেবিকো তোইতা খুই ওইমসা আশিষ পিচামসা আউসো হ্যাপুয়ে।<verse eid="MAT 19:15" /></para>
  <para style="s">পুপুউ দিংঙা</para>
  <para style="r">(<ref loc="MRK 10:17-31">মর্কুস ১০:১৭-৩১</ref>; <ref loc="LUK 18:18-30">লুক ১৮:১৮-৩০</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />ইকোইহা আকোতা ওয়াংমসা ওয়াংটেংটেংগেংওয়া দিংঙাহা জাংয়ে, “ও উটকেওয়া, হাত্রংরে মিসিওয়া সাদি মুংচাকোহা কাহা হাং এনতাওয়া কাম জোনেকোগা?”<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />ইশুহা আকুহিংয়া জাংয়ে, “এনতাওয়া কামকো সোতাহা নাতিহা কাহিংয়া হাংপা উইমগা? এনতাওয়াহা ইচো মেংচে নিও। আদো নাতিহা সাদিতা হোকো কেংনাহা, সেংজাকো আজ্ঞাহিং পালন জো।”<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />আকুহা ইশুহিংয়া জাংয়ে, “হানি আজ্ঞাবিগা?”</para>
  <para style="p" vid="MAT 19:18">ইশুহা আকুহিংয়া জাংয়ে, “নাতিহা দিংঙা মাস্যা, মোনুংনাংসু, মুকুই, প্যায়োং গাওয়াই মিচা। <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />আয়ু আপাকো আদর জো, আসা আপনিকো সাবেইবিহিংনে আপনিহিং ত্যাবাপা জেজেংপা জো।”<verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />আকু ওয়াংটেংটেংগেওয়া দিংঙাহা ইশুহিংয়া জাংয়ে, “ই তাংসা আজ্ঞাবিহা কাহা পালন জোমসারাং ওয়াংমি নিও। কাহা নেহা দোসরা হাং জোনেকোগাসা?”<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />ইশুহা আকুহিংয়া জাংয়ে, “নাতিমি চোসোপা জিংকো কেংনাহা, হোমসা নাতিহিংপা নিওয়া তাংসা পুংজি পিচামসা জোরোংবিহিং ন্যাস্যা চোপি, আসা নাতিহা লোডিংবাতা পুংজি মুংচারোওয়া, আসা ওয়াংমসা কুং নুনুই হুই।”<verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />আত্রংহা আকু দিংঙাহা ই নুওয়াং হিংমসা তুংসিং চিচপুমসা হোপুইয়ে, হাংপাতানাহা আকোতাহা উইসে পুংজিবি নিমি।<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />আকো নোইতাহা ইশুহা য়োংতোংবিহিং জাংয়ে, “আজিপ্পারাং, কা নাবিহিংয়া জাংরোওয়া, সেংজাকো রাজ্যতাহা পুপুউ দিংঙাহিংয়া হোকোহা হ্যামরাপা নিও। <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />ন্যাসারাং কা নাবিহিংয়া জাংরোওয়া, পুপুউ দিংঙাহিংয়া সেংজাকো রাজ্যতা হোওয়ারোমা, ত্যাইরম্যা ল্যাকো হোইংব্যইসো হোকো জাংতোংপা জিংরোওয়া।”<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />ই হিংমসা য়োংতোংবিহা সিওপারাং আআংপেপেচপুমসা জাংয়ে, “এপা বেনাহা হাংসু মুক্তি মুংকো চুকোগাসা?”<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />ইশুহা আবিহিংয়া ন্যইমসা জাংয়ে, “দিংঙাবিকো সোতাহা ইহা মাতুওয়াগা, আদো সেংজাকোতাহা তাংসা তুমগা।”<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />আত্রংহা পত্রসহা জাংয়ে, “কাং, কাবিহা তাংসা হুইতেমসা নাকো নুনুই হুইমি নিও। কাবিহা হাং মুংচাকোগা?”<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />ইশুহা আবিহিংয়া জাংয়ে, “আজিপ্পারাং, কা নাবিহিংয়া জাংরোওয়া, হাত্রং দিংঙাকো চেংওয়াহা আকু চুবে বাসিমতিতা আপনিকো মহিমাকো গাদিংতা গা, আত্রংহা কুং নুনুই হুইওয়া নাবিরে বার্চো গাদিংতা গারোওয়া, আসা ইস্রাইলিবিকো বার্চো জিরিহিং ন্যায় জোরোওয়া। <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />কুং সোতা আপনিকো সা, আপু এবি, আনা-হুম্রিবি, আয়ু-আপা, চেংবি আসা মোংটো-কেটো হুইতেমবিহা ইরোমা একশো গুন সিওপা মুংরোওয়া। আসা দেপাওয়া দিনবিতাহা হাত্রংরে মিসিওয়া সাদি মুংচারোওয়া। <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />আদো উইসে হাংসু নাগাই জিং, আকুহা নুনুই জিংপুরোওয়া, আসা নুনুই নিমবিহা নাগাই জিংপুরোওয়া।”<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">আংগুরবিরিকো মিংচি</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />ইশুহা জাংয়ে, “সেংজাকো রাজ্যহা ইচো মোংটোকো গিরিকো মিংচি ত্যাবাপাগা, হাংসু হাপকুংসো আপনিকো আংগুরবিরিতা কাম জোপাকো হাজিরাসো দিংঙা মোরেমমে। <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />আসা ‘সাইয়ুকো হাজিরা পিচারো’ তামসা লেরা কাম জোওয়াবিহিংয়া কামতা লাগাইমমে।”<verse eid="MAT 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3" />“ন্যাসারাং আকুহা হাপকুংকো নয়বাজি কাচিতা হাতিতা হ্যাদাংনুওয়া আকুহা লেরা দিংঙাবিহিংয়া কাম মোতোমসা এপারাং জাসুদিংওয়া তিংয়ে। <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />আসা আকুহা আবিহিংয়া জাংয়ে, ‘নাবিরে কুং আংগুরবিরিতা কাম জোয়াকো হোতু, হাজিরা হাসে মুংচাকোমে কা নাবিহিংয়া পিচারোওয়া।’ <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />আসা আবিহা হোপুইয়ে। আকুহা ন্যাসারাং বারো বোজেদাংনু আসা তিন বোজেদাংনু বাইরে নোমসা এপারাং জোয়ে। <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />ন্যাসারাং আকুহা পাঁচ বোজেদাংনু নোমসা কাংনুওয়া দিংঙাবিহিংয়া ইতা উতা জাসুদিংওয়া তিংয়ে। আকুহা আবিহিংনে জাংয়ো নাবিহা হাংপা হিমিসিং ইতা হাইরে মোজোপা জাসুদিংগা?”<verse eid="MAT 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7" />আবিহা আকুহিংয়া জাংয়ে, “হাংসুরে কাবিহিংয়া কামতা মালাগাইনা।”</para>
  <para style="p" vid="MAT 20:7">আকুহা আবিহিংয়া জাংয়ে, “নাবিরে কুং আংগুরবিরিতা কাম জোকো হোতু।” <verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />জিরুং জিংপুনুওয়া আংগুরবিরিকো গিরিহা আপনিকো কাম জোপাওয়াহিং জাংয়ে, “লুকুই লেমবিহিং মোউমসা হাংসুরোমা নোইস্যা লেমবিকোসো শুরু জোমসা হাংসুরোমা নাগাই লেমবিহিং হাজিরা পিচা। <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />আসা পাঁচ বাজিসো কাম জোমবিহিংয়া নাগাই মোউমসা সাইয়ুকো হাজিরা পিচায়ে। <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />আত্রংহা হাংসুরোমা নাগাইসো লুকুই ওয়াংওয়াবিহা উইসে মুংচাকোদোওয়া তামসা নোয়ে, আদো আবিহা তাংসারাং সাইয়ু-সাইয়ুকো মেংচে হাজিরা মুংচায়ে। <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />হাজিরা মুংচানতেনুওয়া আবিহা মোংটোকো গিরিকো তোইতা বিরোধ জোমসা ন্যাক্যানুকুপা য়্যইসুয়ে।” <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />আবিহা জাংসুয়ে, “ই নোইতা লেমবিহা এক ঘন্টা মেংচে কাম জোয়ে, আদো নাতিহা আবিহিংয়া কাবি হিমিসিং সানিতা কাম জোমবিহিংপারাং দাদাপা হাজিরা পিচায়ো।”<verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />আদো গিরিওয়াহা আবিকো প্যাকোতাহা ইচোহিং জাংয়ে, ও ব্যারো কাহা নাবিহিংয়া হাইরে মাতুপা মোজোয়াংতো। নাতিহা কাহিংপা সাইয়ুকো হাজিরাকো সোতা কাম জোওয়া মোকোতা? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />নাকো মুংচানেকো হাজিরাহা নাতিহা পুচামসা হোপুই, ই নোইস্যাতা লেমবিহিংনে কা নাতিহিং ত্যাবাপারাং পিচাকো কেংমি। <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />কুং হাইনি, আকুহা কা আপনি হাই জোকো কেংদাংবা জোচা মোমুংকোগা? কুং পিচাওয়াতা নাতিহা হাংপা মিচো তুচাকোগা?<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />“এপারাং নাগাইকোহা নুনুই জিংরোওয়া, আসা নুনুইকোহা নাগাই জিংরোওয়া।”<verse eid="MAT 20:16" /></para>
  <para style="s">ইশুহা ন্যাসা আপনিকো সিরকো ল্যাওয়া</para>
  <para style="r">(<ref loc="MRK 10:32-34">মর্কুস ১০:৩২-৩৪</ref>; <ref loc="LUK 18:31-34">লুক ১৮:৩১-৩৪</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />য়রুশালেম হোদিংনুওয়া ইশুহা বার্চো য়োংতোংবিহিংয়া ইদ্যাতা পুরামসা ন্যাতাতারাং আবিহিংয়া জাংয়ে, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />“কাং, য়াংবিহা য়রুশালেম হোদাংয়ে। আউতাহা দিংঙাকো চেংওয়াহিংয়া মাটা পাউবি আসা তাংজিকো উটকেওয়াবিকো খুইতা ত্যইপুরোওয়া, আসা আবিহা আকুহিংয়া সিনেওয়া দন্ড পিচারোওয়া। <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />আকুহিংয়া লেফেপারোওয়া, সোতাসো পোরোওয়া, আসা ক্রুসতা থ্যইমসা স্যাকো তামসা আবিহা আকুহিংয়া দোসরা জ্যাকো খুইতা স্যইপুরোওয়া, আসা আকুহা সাসুংয়ুকো নোইতাহা ন্যাসারাং ঙারোরোওয়া।”<verse eid="MAT 20:19" /></para>
  <para style="s">ইচো আয়ুকো জাংচাওয়া</para>
  <para style="r">(<ref loc="MRK 10:34-45">মর্কুস ১০:৩৪-৪৫</ref>; <ref loc="LUK 22:24-27">লুক ২২:২৪-২৭</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />আকো নোইতাহা জোব্দিয়াকো চেংওয়াবিকো আয়ুহা আপনিকো চেংওয়াবিহিং চিত্তা পুরামসা ইশুকো আবেইতা তুরুই চুনুইমসা আকুহিং জাংচায়ে।<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />ইশুহা আকুহিংয়া জাংয়ে, “জাং, নাতিহা হাং ঘ্যইকোগা?”</para>
  <para style="p" vid="MAT 20:21">আকুহা ইশুহিংয়া জাংয়ে, “কা জাংচারোওয়া, নাকো রাজ্যতা নাতি জাইপু জিংনুওয়া ই কুং নিহসো চেংওয়াহা নাকো দাংক্রেং আসা কেংরেংতা য়ুংচা মুংকো।”<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />ইশুহা আকুহিংয়া জাংয়ে, “নাতিহা হাং য়াদিংমমে আকুহা মেগেয়াংতো। হানি কচৌরাকো সাইতি কা আংদাং, আকুহা নাতিহা আংকো চুকোগা?”</para>
  <para style="p" vid="MAT 20:22">আবিহা জাংয়ে, “কাবিহা ছুরো।”<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />আত্রংহা ইশুহা জাংয়ে, “কুং কচৌরাকো সাইতি নাবিহা আংকো চুরোওয়া, আদো কুং দাংক্রেং আসা কেক্রেং কাটুতা য়ুংকো পিচাকোহা কু খুইতা মাতানা। ই জায়গাহা আবিকোগা, হাংসুকো সোতা কুং আপা তৈয়ার জোমসা এমমে।”<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />ই হিংমসা লেরা ত্যাচো য়োংতোংবিহা আকু নিহসো য়োংতোংবিহিংপা সেদ্রাংপুয়ে। <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />আদো ইশুহা আবিহিংয়া আপনিকোতা মোউমসা জাংয়ে, “নাবিহা গেমিরাং নিও, দোসরা জ্যাকো মাটাবিহা আপনিকো জোকো কেংমেপা অধিকার জোমগা, আসা টেরবো টেরবো দিংঙাবিহা দোসরাকো তোইতা অধিকার জোকো কেংমগা। <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />আদো নাবিকো প্যাকোতাহা এপা মাজিংকো, হাংসু নাবিকো প্যাকোতা টেবো জিংকো কেং, আকুহা নাবি তাংসাকো ডেইয়া জিংনেরোওয়া। <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />হাংসু নাবিকো প্যাকোতা নাগাই জিংকো কেং, আকুহা নাবিকো ডেইয়া জিংনেরোওয়া। <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />এপারাং দিংঙাকো চেংওয়ারে সেওয়া মুংচাকো মোকো, আদো দোসরাহিং সেওয়া জোকো আসা উইসে দিংঙাবিহিং পাপসো ছুটকারা জোকো আপনিকো সাদি পিচাকো লেমগা।”<verse eid="MAT 20:28" /></para>
  <para style="s">নিহসো মিচো মাতিংওয়া দিংঙা</para>
  <para style="r">(<ref loc="MRK 10:46-52">মর্কুস ১০:৪৬-৫২</ref>; <ref loc="LUK 18:35-43">লুক ১৮:৩৫-৪৩</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />ইশু আসা আকো য়োংতোংবি য়রিহো হোদানুওয়া, উইসে দিংঙাবিহা আকো নুনুই হুইসপুয়ে। <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />ন্যাতাকো আবেইতা গাদিংওয়া নিহসো মিচো মাতিংওয়াবিহা ইশু আকু ন্যাতা জিংমসা হ্যাদাংয়ো তাওয়া হিংমসা সাডুংপা ঙামসা এপা জাংসুয়ে, “ও প্রভু, দাউদকো চেংওয়া, কাবিকো তোইতা লামতুপি।”<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />উইসে দিংঙাবিহা আবিহিং চেকেপা য়ুং তামসা য়েংয়ে, আদো আবিহা ঝান-ঝান ঙাসুমসা জাংসুয়ে, “ও প্রভু, দাউদকো চেংওয়া, কাবিকো তোইতা লামতুপি।”<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />আত্রংহা ইশুহা জায়ে আসা আবিহিং মোউমসা জাংয়ে, “নাবিকো সোতাহা কা হাং জোপিকোগা?”<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />আবিহা আকুহিংয়া জাংচায়ে, “ও প্রভু, কাবিহা তিংকো ছুকো।”<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />আত্রংহা ইশুহা আবিহিংয়া লামতুপুয়ে আসা আবিকো মিচো সুপিয়ে। আত্রংতারাং আবিহা তিংকো ছুয়ে আসা ইশুকো নুনুই হুইপুয়ে।<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">য়রুশালেমতা ইশুহিং এনতাপা স্বাগত জোওয়া</para>
  <para style="r">(<ref loc="MRK 11:1-11">মর্কুস ১১:১-১১</ref>; <ref loc="LUK 19:28-40">লুক ১৯:২৮-৪০</ref>; <ref loc="JHN 12:12-19">য়হুন্না ১২:১২-১৯</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />হাত্রং আবি ইশুসো আকো য়োংতোংবি য়রুশালেমকো আবেইতা জেইতুন জুংকো বেথফাগে তাওয়া জায়গাতা দেয়োং, আত্রংহা ইশুহা নিহসো য়োংতোংবিহিংয়া এপা জাংমসা নিংপুয়ে, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />“নাবিহা আকু আবেইকো লোইতা হোতু। আউতা দেকানতানি নাবিহা ইপু গধা আসা আকো চেংবেহিং তাইমসা এদিংওয়া দোসুরোওয়া। আকুহিং সিমসা কুংতা পারা। <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />দোসরামি নাবিহিং হাইক্রি জাংদানাহা ‘ইহা প্রভুহিং ঘ্যইরো’ তামসা জাং, আসা আকুহা নাবিহিংয়া কাইপিরোওয়া।”<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />অগমবক্তাকো তাংজিকো হিগাতা লাওয়া তাংসা জিংকো তামসারাং এপা জিংরেমগা:<verse eid="MAT 21:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MAT 21:5" />“সিয়োনতা য়ুংওয়া দিংঙাবিহিং জাং,</para>
  <para style="q" vid="MAT 21:5">‘কাং, নেহা নাবিকো জাইপুহা নাবিকোতা ওয়াংপায়ে,</para>
  <para style="q" vid="MAT 21:5">আকুহা নম্র জিংমসা গধাকো তোইতা বাইপামসা দেপাদাংয়ো,</para>
  <para style="q" vid="MAT 21:5">আকো বাইওয়াহা গধাকো চেংবেতাগা’।”<note caller="+" style="x"><char style="xo" closed="false">২১:৫ </char><char style="xt" closed="false"><ref loc="ZEC 9:9">জোকোরিয়া ৯:৯</ref></char></note><verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />আত্রংহা নিহসো য়োংতোংবিহা হোয়ে, আসা আবিহা ইশুকো খুইমি ত্যাবাপারাং জোয়ে। <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />আবিহা গধাসো আকো চেংবেহিং পারায়ে, আসা আবিহা আকো তোইতা আংদুংবি ন্যায়ে, আসা ইশুহা আকো তোইতা গায়ে। <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />উইসে দিংঙাবিহা আপনি আপনিকো আংদুং ন্যাতাতা ন্যাসুয়ে, আসা লেরাহা সিংতেংকো গেইবেবি ঠেহসুমসা ন্যাতাবিতা ন্যাসুমসা ইশুহিং স্বাগত জোয়ে। <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />ইশুকো নাগাই আসা নুনুই তেইমবি তাংসা দিংঙাবিহা এপা জাংমসা প্রশংসা জোয়ে,</para>
  <para style="q" vid="MAT 21:9">“দাউদকো চেংওয়াকো মিংহা টেবো জিংকো!</para>
  <para style="q" vid="MAT 21:9">প্রভুসেংজাকো মিংতা ওয়াংবিহা আশিষিত নিও,</para>
  <para style="q" vid="MAT 21:9">হাংসুরোমা তোইতা নিওয়া সেংজাকো মিংহা টেবো জিংকো।”<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />হাত্রং আকু য়রুশালেমতা দেকা, আত্রংহা শহরতা চেচোওয়াইপা জিংপুয়ে, আসা দিংঙাবিহা উইসুয়ে, “ইহা হাংসুমেতা?” <verse eid="MAT 21:10" /><verse number="11" style="v" sid="MAT 21:11" />উইসে দিংঙাবিকো প্যাকোতা লেরাবিহা জাংসুয়ে, “আকুহা গালীলকো নাসরতসো ওয়াংওয়া অগমবক্তা ইশুগা।”<verse eid="MAT 21:11" /></para>
  <para style="s">ইশুহা দেমসাতা হোওয়া</para>
  <para style="r">(<ref loc="MRK 11:15-19">মর্কুস ১১:১৫-১৯</ref>; <ref loc="LUK 19:45-48">লুক ১৯:৪৫-৪৮</ref>; <ref loc="JHN 2:13-22">য়হুন্না ২:১৩-২২</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />ইশুহা সেংজাকো দেমসাতা হোয়ে, আসা আকুহা দেমসাতা পিচাওয়া-চোইচাওয়া তাংসাহিং ঘিপুয়ে, ন্যাস্যা সোমবিকো টেবিলবি আসা পোরোই পিচামবিকো গাওয়া সোংসাবি দিরাইপাপুয়ে। <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />আকুহা আবিহিংয়া জাংয়ে, “তাংজিকো হিগাতা এপা লামি নিও ‘কুং সাহিংয়া পাচাইওয়া সা তানেরোওয়া।’ আদো নাবিহা ইহিংয়া মেংদাংবিকো গাসুওয়া হোরোংবা বানাইমি নিও।”<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />মিচো মাতিংওয়াবি আসা তেইমকোইওয়াবিহা ইশু দেমসাতা নিনুরাং ওয়াংয়ে, আসা আকুহা আবিহিং সাংপাপিয়ে। <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />আদো মাটা পাউবি আসা তাংজিকো উটকেওয়াবিহা আকো জোওয়া আআংপেপেচপুওয়া কামবি তিংয়ে আসা চেংবিরে দেমসাতা দাউদকো চেংওয়াহিং প্রশংসা জিংকো তামসা ঙাসুওয়া হিংনুওয়া আবিহা সেদ্রাংপুয়ে। <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />আসা আবিহা আকুহিংয়া জাংয়ে, “হিংদিংগা, ইবিহা হাং জাংদিংগা?”<note caller="+" style="x"><char style="xo" closed="false">২১:১৬ </char><char style="xt" closed="false"><ref loc="PSA 8:2">ভজন ৮:২</ref></char></note></para>
  <para style="p" vid="MAT 21:16">আত্রং ইশুহা আবিহিংয়া জাংয়ে, “ওই, হিংদিংনা। নাবিহা তাংজিকো হিগাতা লামি নিওয়া মাপাড়াইংগা?</para>
  <para style="q" vid="MAT 21:16">আপেবি আসা য়ো আংদিংওয়া চেংবিকো নামুসো নাতিহা প্রশংসা নোপামি নিও।”<verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />আত্রংহা আবিহিং হুইতেমসা ইশুহা শহরসো নোমসা বেথানিয়া হোমসা আউতা জিংয়াপুয়ে।<verse eid="MAT 21:17" /></para>
  <para style="s">মুইরাসেকো সিংতেং</para>
  <para style="r">(<ref loc="MRK 11:12-14">মর্কুস ১১:১২-১৪</ref>,<ref loc="MRK 11:20-24">২০-২৪</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />হাপকুং ইশু য়রুশালেম শহরতা লাকাদাংনুওয়া আকুহা আমা পাংপুয়ে। <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />ন্যাতাকো আরিতা আকুহা ইতেং মুইরাসেকো সিংতেং তিংয়ে। আকুহা আকু সিংতেংকো আবেইতা ওয়াংয়ে, আদো আউতাহা লাপা ল্যামসা হাইরে মামুংতো। আত্রংহা আকুহা সিংতেংহিংয়া জাংয়ে, “ইসো য়ুতাহা নাকোতাহা হাত্রংরে ফল মেশেকো” আসা আকু মুইরাসেকো সিংতেংহা আত্রংতারাং য়োংপুয়ে।<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />ই তিংমসা য়োংতোংবিহা আআংপেপেচপুমসা উইয়ে, “ই মুইরাসেকো সিংতেংহা তাত্রিংপা হেপা য়োংপুমেতা?”<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />ইশুহা আবিহিংয়া জাংয়ে, “আজিপ্পারাং, কা নাবিহিংয়া জাংরোওয়া, নাবিকোতা দেংওয়া নিও আসা সন্দেহমি মাতানাহা, ই মুইরাসেকো সিংতেংহিংয়া হাং জোমে এসে মেংচে মোকো, আদো ই য়্যাগ্যইহিংনে ‘ওইচপুমসা ঝাহাদিতা বাদোইচাপুই’ তামসা জাংনাহা আকুহা বাদোইচপুরোওয়া। <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />দেংমসা পাচাইওয়াতা নাবি হাই য়াচা আকুহা মুংচারোওয়া।”<verse eid="MAT 21:22" /></para>
  <para style="s">ইশুকো অধিকারকো তোইতা উইওয়া</para>
  <para style="r">(<ref loc="MRK 11:27-33">মর্কুস ১১:২৭-৩৩</ref>; <ref loc="LUK 20:1-8">লুক ২০:১-৮</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />ইশুহা দেমসাতা হোয়ে, আসা আকু ঝিপাদিংনুওয়া মাটা পাউবি আসা লেরা য়হুদি মাটা ওয়ারাংপাবিহা আকোতা লেয়ে, আসা জাংয়ে, “হানি অধিকারসো নাতিহা ই কামবি জোমগা? আসা হাংসু নাতিহিংয়া ই অধিকার পিচাংগা?”<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />ইশুহা আবিহিংয়া জাংয়ে, “কারে নাবিহিংয়া ইচো নুওয়াং উইরোওয়া। হানি কা নাবিহিং উই আকুমি জাংনাহা, কা হানি অধিকারসো ই কাম জোদিংমমে, আকুহা নাবিহিংনে জাংরোওয়া। <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />য়হুন্নাহা বাপ্তিস্মা পিচাওয়া অধিকার হানিসো মুংগা? সেংজাসোগা না দিংঙাবিকোসোগা?”</para>
  <para style="p" vid="MAT 21:25">আবিহা তাইবিলারাই এপা জাংসুয়ে, “সেংজাসো তানাহা, আকুহা ‘এপা বেনাহা নাবিহা আকুহিংয়া হাংপা মেদেংগা?’ তারোওয়া। <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />আদো ‘দিংঙাবিকোসো’ তানাহা, য়াংবিহিংয়া দিংঙাবিকোসো চুসুংনেপা নিও, হাংপাতানাহা তাংসারাং য়হুন্নাহিংয়া অগমবক্তাগা তামসা নোমগা।” <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />আকো সোতা আবিহা ইশুহিংয়া জাংয়ে, “কাবিহা মেগেরো।”</para>
  <para style="p" vid="MAT 21:27">আত্রং ইশুহা আবিহিংয়া জাংয়ে, “কারে হানি অধিকারসো ই কাম জোদিংমমে, আকুহা মাজাংরো।”<verse eid="MAT 21:27" /></para>
  <para style="s">নিহসো চেংওয়াকো মিংচি</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />ইশুহা আবিহিংয়া ন্যাসারাং জাংয়ে, “নাবিহা হাং নোমগা? ইচো দিংঙাকো নিহসো চেংওয়া নিমি। আকুহা দেসোইওয়া চেংওয়াকোতা হোমসা জাংয়ে, ‘চেংওয়া, হিনিহা আংগুরবিরিতা হোমসা কাম জোপি।’ <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />আকু দেসোইওয়া চেংওয়াহা জাংয়ে, ‘কাহা মাহ্যারো!’ আদো আকুহা নোইতাহা তুংসিং হুরামসা হোমসা কাম জোয়ে। <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />দোসরা চেংওয়াকোতারে আকুহা হোমসা এপারাং জাংয়ে। আকুহা জাংয়ে, ‘কা হোরো।’ আদো আকুহা মোহোতো।<verse eid="MAT 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31" />“নেহা আবি নিহসোতাহা হাংসু আপাকো আজ্ঞাহিং পালন জোংগা?” আবিহা জাংয়ে, “ডেসোইওয়া চেংওয়া!”</para>
  <para style="p" vid="MAT 21:31">ইশুহা আবিহিংয়া জাংয়ে, “আজিপ্পারাং, কা নাবিহিংয়া জাংরোওয়া, তোংক্যা জুমবি আসা নুংনাংবিহা নাবিরোমা নাগাই সেংজাকো রাজ্যতা হোরোওয়া। <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />হাংপাতানাহা য়হুন্নাহা নাবিকোতা তাংজিকো ন্যাতা তিংপাকো লেয়ে, আদো নাবিহা আকো তোইতা মাদেংতো, আদো তোংক্যা জুমবি আসা নুংনাংসুওয়াবিহা আকো তোইতা দেংয়ে। নাবিহা ই তিংমসারে পশ্চতাপ মাজোতো, আসা আকো তোইতা মাদেংতো।”</para>
  <para style="s" vid="MAT 21:32">আদিয়া কামাইমবিকো মিংচি</para>
  <para style="r" vid="MAT 21:32">(<ref loc="MRK 12:1-12">মর্কুস ১২:১-১২</ref>; <ref loc="LUK 20:9-19">লুক ২০:৯-১৯</ref>)</para>
  <para style="p" vid="MAT 21:32">
    <figure style="fig" alt="আদিয়া কামাইমবিকো মিংচি" file="lb00103.jpg" size="col" ref="২১:৩২" /> <verse eid="MAT 21:32" /><verse number="33" style="v" sid="MAT 21:33" />ইশুহা আবিহিংয়া জাংয়ে, “ন্যাসারাং নাবিহা দোসরা মিংচিরে হিং: ইচো সময়তাহা ইচো মোংটোকো গিরি নিমি। আকুহা আংগুরবিরি তিংয়ে, আসা আকো হুরাপা বিরিয়ামসা আউতাহা আংগুরহিং ছুইমসা সাইতি নোপাওয়া জাকা আসা ইচো লুংনিংহিং কাংওয়া টোংসারে বানাইয়ে। আকুহা আকু আংগুরবিরিহিংয়া আদিয়া কামাইওয়াবিকোতা এতেমসা আপনিহা তানাংকো লোইতা হোপুইয়ে। <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />হাত্রং আংগুর মিংকো তোংপা, আত্রংহা আকুহা আদিয়া কামাইওয়া দিংঙাবিকোতা আপনিকো আদিয়া মুংচানেওয়া আংগুর লাকো তামসা ডেইয়াবিহিং নিংপুয়ে।<verse eid="MAT 21:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 21:35" />“আদো আকু আদিয়া কামাইওয়াবিহা ডেইয়াবিহিংয়া প্যইমসা ইচোহিংয়া ডুপুয়ে, ইচোহিংয়া স্যাপুয়ে, আসা ইচোহিংয়া লুংটুই টোপুইয়ে। <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />ন্যাসারাং আকুহা নাগাইকোরোমা সিওপা ডেইয়াবিহিং নিংপুয়ে, আদো আকু কাংপাওয়াবিহা আবিহিংনে এপারাং জোয়ে, <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />আসা ন্যইস্যাতাহা আকু লুংনিংকো গিরিহা ‘কুং চেংওয়াহিংয়া আবিহা আদর জোকোদোওয়া’ তাওয়া নোমসা, নোইস্যাতাহা আকুহা আপনিকো চেংওয়াহিং আবিকোতা নিংপুয়ে।<verse eid="MAT 21:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38" />“আদো আদিয়া কামাইমবিহা চেংওয়াহিং তিংমসা তাইবিলারাই জাংসুয়ে, ‘ইহা মোংটোকো গিরিওয়াকো চেংওয়ারাংগা। লেই, ইহিং স্যারো, আসা ইকো মোংটো-কেটোহা তাংসা য়োংকো আপনিকো বানাইকো।’ <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />আসা আবিহা আকুহিং প্যইসুয়ে আসা আংগুরবিরিসো হেইপুমসা আকুহিংয়া বাইরেতা পুরামসা স্যাকাপুয়ে।<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />“আকো সোতা হাত্রং আংগুরবিরিকো গিরি ওয়াং, আত্রংহা আকুহা আকু আদিয়া কামাইওয়াবিহিংয়া হাং জোকোগা?”<verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />আকু টেবো পাউবি আসা য়হুদি ওয়ারাংপাবিহা আকুহিংয়া জাংয়ে, “আকুহা আকু মেংতাওয়া দিংঙাবিহিংয়া দাংপারোওয়া, আসা আংগুরবিরিহা দোসরা আদিয়া কামাইওয়াবিহিং আদিয়াতা পিচারোওয়া, হাংসু আকুহিং আংগুর মিংনুওয়া সময়তা পোচ্রামমে।”<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />ইশুহা আবিহিংয়া জাংয়ে, “নাবিহা হাত্রংরে তাংজিকো হিগা মাপাড়াইগা?</para>
  <para style="q" vid="MAT 21:42">‘হানি লুংটুইহিং সা বানাইমবিহা মোঘ্যইরো তামসা হুইতেমে,</para>
  <para style="q" vid="MAT 21:42">আকুরাং আরিকো মাটা লুংটুই জিংপুয়ে,</para>
  <para style="q" vid="MAT 21:42">ইহা প্রভুসেংজাকোসো জিংপুমগা,</para>
  <para style="q" vid="MAT 21:42">আসা য়োংকো মিচোকো নাগাইতাহা ইহা আআংপেপেপা নিও।’<note caller="+" style="x"><char style="xo" closed="false">২১:৪২ </char><char style="xt" closed="false"><ref loc="PSA 118:22">ভজন ১১৮:২২</ref>,<ref loc="PSA 118:23">২৩</ref></char></note><verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />“আকো সোতা কা নাবিহিংয়া জাংরোওয়া, সেংজাকো রাজ্যহা নাবিকোসো গিংচাপুরোওয়া, আসা ফল শেপাওয়া এপা জিংওয়া জ্যাকো দিংঙাহিং পিচাপুরোওয়া। <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />ই লুংটুইকো তোইতা হুইওয়া তাংসা লুংটুইবিহা চোচোনোনোপা জিংপুরোওয়া, আসা হানি লুংটুইকো তোইতা ই লুংটুই হুই, আকু তাংসা লুংটুইবিরে চোচোনোনোপা জিংপুরোওয়া।”<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />হাত্রং মাটা পাউবি আসা ফরিসিবি আকো মিংচি হিং, আত্রংহা আবিকো তোইতারাং ই মিংচি ল্যামগুং তামসা কোইয়ে। <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />আবিহা আকুহিংয়া প্যইকো কেংয়ে, আদো আবিহা উইসে দিংঙাবিসো চুসুংপুয়ে, হাংপাতানাহা দিংঙাবিহা ইশুহিংয়া ইচো অগমবক্তাগা তামসা নোমি।<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">বিয়ৌকো চাওয়া আংওয়াকো মিংচি</para>
  <para style="r">(<ref loc="LUK 14:15-24">লুক ১৪:১৫-২৪</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />আসা ইশুহা ন্যাসারাং দোসরা মিংচি ল্যামসা জাংয়ে, <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />“সেংজাকো রাজ্যহা ইচো জাইপুকো চেংওয়াকো বিয়ৌতা চাকো আংকো পিচাকো তৈয়ার জোমি ত্যাবাপাগা। <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />আকু জাইপুহা বিয়ৌতা নিমতো পিচাওয়াবিহিং মোউয়াকো আপনিকো ডেইয়াবিহিং নিংপুয়ে। আদো আকু দিংঙাবিহা ওয়াংকো মেকেংতো।<verse eid="MAT 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4" />“ন্যাসারাং দোসরা ডেইয়াবিহিং এপা জাংমসা নিংপুয়ে, ‘হ্যামসা আকু নিমতো মুংচাওয়াবিহিং জাংয়াতু, চাকো-আংকো তৈয়ার জিংতেনা, পিকাবি, আসা বুচুই-বাচাওয়া সেংচেংবি স্যাওয়া নিও, আসা তাংসা সোংসাবি তৈয়ার জিংতেয়ো। নেহা বিয়ৌতা লেই।’”<verse eid="MAT 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5" />“আদো আবিহা মাহিংরেপা জোমসা আপনি আপনিকো কামতা হোপুয়ে। লেরাহা আপনিকো লুংনিংবিতা হ্যাপুয়ে আসা লেরাবিহা আপনিকো ব্যাপারকো কামবিতা হ্যাপুয়ে। <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />লেরাহা জাইপুকো ডেইয়াবিহিংনাং লেফেপায়ে আসা ডুমসা স্যাপুয়ে। <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />আকু জাইপুহা সিওপারাং সেদ্রাংপুমসা আপনিকো সিপাইবিহিং নিংপুমসা আকু স্যামবিহিংয়া দাংপাপুয়ে আসা আবিকো শহরতা মেহ চুংপুয়ে।”<verse eid="MAT 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 22:8" />“আত্রংহা জাইপুহা আকো ডেইয়াবিহিং জাংয়ে, ‘বিয়ৌহা তৈয়ার জিংপুনতেও, আদো নিমতো মুংচাওয়াবিহা ওয়াংকো য়োগ্য়্য মোতো। <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />আকো সোতা শহরকো ন্যাতাবিতা নাবিহা হোমসা তাংসা দিংঙাবিহিং বিয়ৌতা ওয়াংকো মোউয়াতু।’ <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />আকো সোতা ডেইয়াবিহা শহরতা হোমসা ন্যাতা-ন্যাতাতা দোসুওয়া এনতাওয়া মেংতাওয়া তাংসা দিংঙাবিহিং মোউয়ামসা জমা জোয়ে আসা বিয়ৌকো সিরিহিংয়া দিংঙাবিসো মেইপাপুয়ে।”<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />“আদো হাত্রং জাইপু দিংঙাবিহিং নাপোতা হোমসা কাং, আত্রংহা বিয়ৌকো আংদুং মোলুওয়া ইচো দিংঙাহিং তিংয়ে, <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />আসা উইয়ে, ‘ও ব্যারো, হেপা নাতিহা বিয়ৌকো আংদুং মালুউপা ইতা ওয়াংগা?’ আকু দিংঙাহা হাইরে জাংকো মোচুতো।”<verse eid="MAT 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13" />“আত্রংহা জাইপুহা ডেইয়াবিহিং জাংয়ে, আকুহিং খুই কোকোই তাইমসা বাইরে নাটুংওয়াতা বাডোইপুই। আউতা কাইরোওয়া আসা সেতাং কিট্টিপা মাংরোওয়া।”<verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />হাংপাতানাহা মোউওয়াবিহা উইসে নিও, আদো জেংচপুওয়াবিহা আস্যই মেংচে নিও।<verse eid="MAT 22:14" /></para>
  <para style="s">তোংক্যা তাওয়াকো বিষয়তা উইওয়া</para>
  <para style="r">(<ref loc="MRK 12:13-17">মর্কুস ১২:১৩-১৭</ref>; <ref loc="LUK 20:20-26">লুক ২০:২০-২৬</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />আসা ফরিসিবিহা হোমসা চিত্তা জোংসুয়ে, আসা ইশুহিংয়া আকো নুওয়াংতা হেপা ফাসাইকোমে তামসা খুইসুয়ে। <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />ফরিসিবিহা আবিকো য়োংতোংবিহিং হেরোদ জাইপুকো দিংঙাবিহিংপা ইশুকোতা নিংপুয়ে।</para>
  <para style="p" vid="MAT 22:16">আবিহা ইশুহিংয়া উইয়ে, “উটকেওয়া, নাতিহা আজিপ্পা নুওয়াং মেংচে জাংমগা তামসা কাবিহা গেমগা। আসা সেংজাকো ন্যাতাকো তোইতা আজিপ্পা ঝিপামগা। নাতিহা দিংঙাবিকো নুওয়াংতা মাতেইমগা।, আসা দিংঙাবিকো য়ুওয়াই কাংমসারে কাম মোজোমগা। <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />আকো সোতা কাবিহিং জাং, রোমিকো মাটা সিজারহিং তোংক্যা তাওয়াহা এনতাওয়াগা না মেংতাওয়াগা?”<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />আদো ইশুহা আবিকো মেংতাওয়া নোচেংবি সিদা চ্যইমসা জাংয়ে, “ও তেপিবাই, হাংপা নাবিহা কাহিং ফাসাইকো কেংমগা? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />তোংক্যা তাওয়া টাংকাহা কাহিং তিংপাকে।” আবিহা রোমিকো টাংকা আকোতা পায়ে। <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />ইশুহা আবিহিং উইয়ে, “ইতাহা হাংসুকো ছাপ আসা হাংসুকো মিং নিংগা?”<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />আবিহা জাংয়ে, “সিজারকো ছাপ নিনা।”</para>
  <para style="p" vid="MAT 22:21">আত্রংহা ইশুহা আবিহিংয়া জাংয়ে, “সিজারকো কাটুহা সিজারহিং পিচা, আসা সেংজাকো কাটুহা সেংজাহিং পিচা।” <verse eid="MAT 22:21" /><verse number="22" style="v" sid="MAT 22:22" />ইশুকো জাংওয়া নুওয়াং হিংমসা আবিহা আআংপেপেপা জিংপুয়ে। আসা আবিহা ইশুহিংয়া আউতারাং হুইতেমসা হোপুয়ে।<verse eid="MAT 22:22" /></para>
  <para style="s">সিমসা ঙারোওয়াকো তোইতা উইওয়া</para>
  <para style="r">(<ref loc="MRK 12:18-27">মর্কুস ১২:১৮-২৭</ref>; <ref loc="LUK 20:27-40">লুক ২০:২৭-৪০</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />আত্রংকো দিনতাহা লেরা সদুকিবিহা ইশুকোতা লেহে। (সদুকিবি তাওয়া তাংজিকো পারাকো দিংঙাবিহা দিংঙা সিপুনুকো নোইতাহা ন্যাসারাং ঙারোমি তাওয়া নুওয়াংতা মাদেংমি।) আসা আবিহা ইশুহিং উইয়ে, <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />“উটকেওয়া, মোসাহা এপা লামি নিও, ‘হাংসু দিংঙাকো চেংচুং মাজিংপা সিপু, আকো এহা ডুওয়াকো মেহিং বিয়ৌ জোনেরোওয়া। আসা আকো ডুওয়াকো সোতা চেংচুং চেংপানেরোওয়া।’ <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />কাবিকো প্যাকোতাহা নীচো ডুওয়া এবি নিও। ডেসোইওয়া চেংওয়াহা বিয়ৌ জোমসা চেংচুং মাজিংপা সিপুয়ে। আসা আকো মেহা আকো মাইলা এরোংওয়াহিংপা বিয়ৌ জোয়ে। <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />এপারাং মাইলা চেংওয়াসোহা চিংস্যওয়া চেংওয়া চোইপা মুরিংমু লুংঙাহিং বিয়ৌ জোমসা সিপুয়ে। <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />আসা নোইস্যাতাহা আকু মেমেরে সিপুয়ে। <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />নেহা সিওয়াসো ঙারোনুওয়া আকু মেমেহা হাংসুকো মে জিংকোগা? হাংপাতানাহা আকু মেমেহিংপাহা তাংসা ডুওয়া এবিরাং বিয়ৌ জোমি নিও।”<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />ইশুহা আবিহিং জাংয়ে, “নাবিহা ভুলতা পরেমি নিও, হাংপাতানাহা নাবিহা তাংজিকো হিগাতা আসা সেংজাকো সেকো তোইতা মোকোইয়াংতো। <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />হাংপাতানাহা সিপুমসা ঙারোনুওয়া দিংঙাবিহা বিয়ৌ মোজোমগা, আদো আবিহা লোডিংবাকো পোইংবি বেপা জিংপুমগা।”<verse eid="MAT 22:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 22:31" />“আদো সিওয়াসো ঙারোরো তাওয়াকো বিষয়তাহা সেংজাহা নাবিহিংয়া হাং জাংমি নিমমে, আকুহা নাবিহা মাপাড়াইয়াংগা? <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />‘কা অব্রাহামকো সেংজা, ইসহাককো সেংজা আসা য়াকুবকো সেংজাগা।’ আকুহা সিপুমবিকো মোকো, আদো ঙাজ্যইংবিকো সেংজাগা।” <verse eid="MAT 22:32" /><verse number="33" style="v" sid="MAT 22:33" />এপারাং ইশুকো ঝিপাওয়া হিংমসা দিংঙাবিহা তাংসা আআংপেপেপা জিংপুয়ে।<verse eid="MAT 22:33" /></para>
  <para style="s">হানিরোমা টেবো জ্ঞান</para>
  <para style="r">(<ref loc="MRK 12:28-34">মর্কুস ১২:২৮-৩৪</ref>; <ref loc="LUK 10:25-28">লুক ১০:২৫-২৮</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />ইশুহা সদুকিবিহিংয়া য়্যইমক্যইপা জোপুয়ে তাওয়া নুওয়াংহা ফরিসিবিহা হিংমসা আবিহা চাংসুমসা ইশুকোতা লেহে। <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />আবিকো প্যাকোতা ইচো তাংজিকো উটকেওয়াহা ইশুহিং এপা জাঁচ জোমসা উইয়ে, <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“উটকেওয়া, লিংপাংকো হানিরোমা টেবো আজ্ঞাহা হানিগা?”<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />ইশুহা আবিহিং জাংয়ে, “প্রভু নাকো সেংজাহিং তাংসা তুংসিংসো, তাংসা সাদিসো, তাংসা নোচেংসো জেজেংপা জো।”<note caller="+" style="x"><char style="xo" closed="false">২২:৩৭ </char><char style="xt" closed="false"><ref loc="DEU 6:5">ব্যবস্থা ৬:৫</ref></char></note> <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />হানিরোমা নাগাই আসা টেবো আজ্ঞাহা ইরাংগা। <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />এপারাং দোসরা আজ্ঞাহা ইগা, আপনিহিং জেজেংপা জোমি ত্যাবাপা নাকো সাবেইবিহিংনে জেজেংপা জো।<note caller="+" style="x"><char style="xo" closed="false">২২:৩৯ </char><char style="xt" closed="false"><ref loc="LEV 19:18">লেবী ১৯:১৮</ref></char></note> <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />তাংসা লিংপাং আসা অগমবক্তাবিকো ঝিপাওয়াহা ই আজ্ঞাসোরাং লেমগা।<verse eid="MAT 22:40" /></para>
  <para style="s">খ্রীষ্টহা হাংসুকো চেংওয়াগা</para>
  <para style="r">(<ref loc="MRK 12:35-37">মর্কুস ১২:৩৫-৩৭</ref>; <ref loc="LUK 20:41-44">লুক ২০:৪১-৪৪</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />হাত্রং ফরিসিবি ইচো জায়গাতা তাংসা চিত্তা গাসুদিং, আত্রংহা ইশুহা আবিহিং উইয়ে, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />“খ্রীষ্টকো বিষয়তা নাবিহা হাং নোমগা? আকুহা হাংসুকো চেংওয়াগা?”</para>
  <para style="p" vid="MAT 22:42">আবিহা জাংয়ে, “আকুহা দাউদকো চেংওয়াগে।”<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />ইশুহা আবিহিংয়া জাংয়ে, “এপা বেনাহা হাংপা দাউদহিংয়া সেংজাকো লাংবেহা ‘প্রভু’ তাকো জাংপাংগা? হাংপাতানাহা দাউদ জাইপুহা এপা জাংমি নিও,<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />প্রভুসেংজাহা কুং প্রভুহিংয়া এপা জাংয়ে,</para>
  <para style="q1" vid="MAT 22:44">‘নাতিহা কুং দাংক্রে কাটুতা গা,</para>
  <para style="q1" vid="MAT 22:44">হাত্রং চোইপা কা নাকো দুসমনবিহিং নাকো কোকোইকো তাংবাতা মোনোংপা।’<note caller="+" style="x"><char style="xo" closed="false">২২:৪৪ </char><char style="xt" closed="false"><ref loc="PSA 110:1">ভজন ১১০:১</ref></char></note><verse eid="MAT 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 22:45" />“দাউদ জাইপুরাং আকুহিং প্রভুসেংজা তামসা জাংনাহা, হেপা খ্রীষ্টহা দাউদকো চেংওয়া জিংকোগা? <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />হাংসুরে আকুহিংয়া হাইরে জাংমক্যইতো, আসা আকু দিনসোহা হাংসুরে আকোতাহা হাইরে উইকো সাহস জোমক্যইতো।”<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">তাংজিকো উটকেওয়াবি আসা ফরিসিবিহিং চেতাউনি</para>
  <para style="r">(<ref loc="MRK 12:38-39">মর্কুস ১২:৩৮-৩৯</ref>; <ref loc="LUK 11:43">লুক ১১:৪৩</ref>,<ref loc="LUK 11:46">৪৬</ref>, <ref loc="LUK 20:45-46">২০:৪৫-৪৬</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />আত্রংহা ইশুহা উইসে দিংঙাবি আসা আপনিকো য়োংতোংবিহিং জাংয়ে, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />“তাংজিকো উটকেওয়াবি আসা ফরিসিবিহা মোসাকো লিংপাংহিং ঝিপাওয়া অধিকার মুংচামি নিও। <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />আকো সোতা আবিকো জাংওয়া হিং, আসা জো, আদো আবিকো জোমি ত্যাবাপাহা মোজো, হাংপাতানাহা আবিহা ঝিপাকোহা ঝিপামগা, আদো আপনিবিহা মোজোমগা। <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />আবিহা পুউকো মাঠুইওয়া লিংপাংকো ব্যা জিংমসা দিংঙাবিকো বুচুংতা এমগা। আদো আবি আপনিহা আকু তোরোইকোরে ইক্র্যোই ক্র্যোইসোরে মাসুমগা।<verse eid="MAT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5" />“আদো আবিহা আপনিকো তাংসা কামবিহা দিংঙাবিহিং তিংপাকো সোতা মেংচে জোমগা। আবিহা আপনিকো তিঙাং আসা খুইবিতাহা লিংপাংতা লামি নিওয়া টেরবো টেরবো বুটিবি বানাইমসা জিংমগা, আসা আপনিহিং তাংজি তিংপাকো সোতা লুওয়া আংদুংবিতা হিয়ো-হিয়োপা ঝুমকাবি থ্যইমগা। <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />চাওয়া-আংওয়াবিতা আদর আসা জোংসুওয়া সাবিতা এনতা-এনতাওয়া গাদুবিতা গাকো কেংমগা, <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />আসা হাতিবিতা দিংঙাবি অভিবাদন তামসা জাংওয়া আসা উটকেওয়া তাপিওয়া এনতামগা।<verse eid="MAT 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8" />“আদো নাবিহিংয়া হাংসুরে ‘উটকেওয়া’ তামসা মাজাংকো, হাংপাতানাহা নাবিকোহা ইচো মেংচে উটকেওয়া নিও, আসা নাবিহা তাংসা ডুওয়া-এবি আসা আনা-হুম্রিবিগা। <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />নাবিহা বাসিমতিতা হাংসুহিংনে আপা তামসা মাজাংঘ্যই, হাংপাতানাহা নাবিকোহা ইচো মেংচে আপা নিও, আকুহা লোডিংবাতা য়ুংমগা। <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />নাবিহিংয়া হাংসুরে ‘উটকেওয়া’ তামসা মাজাংকো, হাংপাতানাহা নাবিকোহা ইচো মেংচে উটকেওয়া নিও, আকুহা খ্রীষ্টগা। <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />নাবিকো প্যাকোতাহা হাংসু টেবোনি, আকুহা নাবিকো ডেইয়া জিংরোওয়া। <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />হাংসু আপনি টেবো জিংকো কেং, আকুহা আপেচপা জিংপুরোওয়া, আসা হাংসু আপনিহিং আপেচপা জোকো কেং, আকুহা টেবো জিংপুরোওয়া।<verse eid="MAT 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />“টেবো দুঃখ ওয়াংরোওয়া, নাবি তাংজিকো উটকেওয়া আসা ফরিসি তেপিবাই! হাংপাতানাহা নাবিহা দিংঙাবিকো সোতাহা সেংজাকো রাজ্যকো লাপুং তুংমি নিও। নাবিহা আপনিরে মোহোমগা, আসা হোদাংওয়াবিহিংনে হোকো মিচামগা। <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />[নাবিকোতা টেবো দুঃখ ওয়াংরোওয়া, তাংজিকো উটকেওয়া আসা ফরিসি তেপিবাই! নাবিহা মুরিংবিহিং ল্যইপামসা আবিকো সা আসা মোংটো-কেটোবি গিংচামগা, আসা তিংপাকো সোতা ডালাইপা পাচাইমগা। আকো সোতা নাবিহা দোসরারোমা সিওপা দন্ড মুংরোওয়া।]<verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />“নাবিকোতা টেবো দুঃখ ওয়াংরোওয়া, নাবি তাংজিকো উটকেওয়া আসা ফরিসি তেপিবাই! হাংপাতানাহা নাবিহা ইচো দিংঙাহিং য়হুদিবিকো তাংজিতা পারারো তামসা মোংটো আসা ঝাহাদিকো ন্যাতা তেইমগা, আসা আকু য়হুদিবিকো লিংপাংতা ওয়াংপুনতেনুওয়া নাবিহা আকুহিংয়া নাবিরোমা সিওপা নরকতা দন্ড মুংওয়া বানাইমগা।<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />“টেবো দুঃখ ওয়াংরোওয়া, নাবি মিচো মাতিংওয়া উটকেওয়াবাই! হাংসু জাংদিংগা, দেমসাকো তোইতা নোপোইনুওয়া হাংসুনে হাইরে মাজিং, আদো দেমসাকো সুনকো তোইতা নোপোইনুওয়া আকু নোপোইওয়াসো জিংচপুরোওয়া। <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />হাইরে মেগেওয়া আসা মিচো মাতিংওয়াবাই, হানি ডিয়োমগা? সুনগা না সুনহিং পবিত্র জোওয়া দেমসাগা? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />‘ভেদিকো তোইতা নোপোইনুওয়া হাইরে মাজিংমগা, আদো আকো তোইতা এওয়া ভেটিকো তোইতা নোপোইনাহা আকু নাপোইওয়াসোহা জিংচপুমগা।’ <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />ও মিচো মাতিংওয়াবাই, হানি ডিয়োমগা? ভেটিগা না ভেটিহিং পবিত্র জোওয়া ভেদিগা? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />আকো সোতা ভেদি সুমসা নাপোইওয়াহা ভেদি আসা আউতা পিচাওয়া তাংসা ভেটিবি সুমসা নাপোইমগা। <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />দেমসাকো তোইতা নাপোইওয়াহা দেমসা আসা আকো নাপোতা নিওয়াকো তোইতা নাপোইমগা। <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />লোডিংবাকো তোইতা নাপোইওয়াহা সেংজাকো গাদিংকো আসা আউতা গাওয়া সেংজাকো মিংতারাং নাপোইমগা।<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />“নাবিকোতাহা টেবো দুঃখ ওয়াংরোওয়া, নাবি তাংজিকো উটকেওয়া আসা ফরিসি তেপিবাই! হাংপাতানাহা নাবিহা পুদিনা, সোঁপ আসা জিরাকো দশাংশ সেংজাহিং পিচামগা, আদো লিংপাংকো মাটা নুওয়াং ন্যায়, লামতুওয়া আসা দেংওয়াবিকোহা প্যারামাপামগা। আকু দোসরা নুওয়াংবিহিংপাহা নাবিহা ই লিংপাংকো নুওয়াংবিরে জোনেকোগা।” <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />ও নাবি মিচো মাতিংওয়া অগুওয়াবাই, নাবিহা মুদুহিংয়া য়িমগা, আদো ত্যাইরম্যাহিংয়া হুইচপুমগা।<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />“নাবিকোতাহা টেবো দুঃখ ওয়াংরোওয়া, তাংজিকো উটকেওয়া আসা ফরিসি তেপিবাই! হাংপাতানাহা নাবিহা চোপোই আসা বারাংকোহা বাইরে কাটুহা মেংঝিমগা, আদো নাপো কাটুসোহা বাংওয়া আসা আপনিকো মেংতাওয়া ইচ্ছাহিং স্যামক্যইওয়াসো মেইওয়া নিমগা। <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />মিচো মাতিংওয়া ফরিসিবাই, নাগাইহা চোপোই আসা বারাংকো নাপো কাটু মাইঝি, আসা আকো বাইরে কাটুরে চাইচাইপা জিংকো।<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />“নাবিকোতাহা টেবো দুঃখ ওয়াংরোওয়া, তাংজিকো উটকেওয়া আসা ফরিসি তেপিবাই, হাংপাতানাহা নাবিহা চুরাই ন্যাওয়া তাম্যইবি ত্যাবাপা নিও, হানি বাইরে কাটুসো জেজেংপা তিংমমে, আদো নাপো কাটুসোহা সিপুওয়া দিংঙাবিকো লুইটোবি আসা তাংসা মেংতাওয়াসো মেইমি নিমগা। <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />এপারাং নাবিরে বাইরে দিংঙাবিকো নাগাইতা তাংজি তিংমগা, আদো নাপোতাহা তেইপি আসা মেংতাওয়াসো মেইমি নিমগা।”<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />“নাবিকোতাহা টেবো দুঃখ ওয়াংরোওয়া, নাবি তাংজিকো উটকেওয়া আসা ফরিসি তেপিবাই! হাংপাতানাহা নাবিহা অগমবক্তাবিকো সোতা তোম্যইবি বানাইমগা, তাংজি নিওয়াবিকো তাম্যইহিং সাজাইমগা, <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />আসা জাংমগা, ‘কাবিকো আপনিকো আটা আজাবিকো সময়তা অগমবক্তাবিহিং স্যায়ে, আদো কাবিরে আবিহিংপামি নিনাহা আবিহিংপা এপা কাম জোকো মায়ুজ্রুকোগা।’ <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />এপারাং নাবিহা অগমবক্তাবিহিং স্যাওয়াকো চেংচুংবিগা তাওয়াকো প্রমানহা নাবি আপনিবিরাং পিচামগা। <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />নাবিকো আটা আজাবিকো শুরু জোওয়া পাপকো কামবি পুরা জো।<verse eid="MAT 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33" />“ও পুইয়াবাই, আসা লিং নিওয়া পুইয়াকো চেংবাই! নাবিহা হেপা নরককো দন্ডসো ক্যাকো ছুকোগা? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />আকো সোতা কা নাবিকোতা অগমবক্তাবিহিং, দুংজি নিওয়া দিংঙাবিহিং আসা তাংজিকো উটকেওয়াবিহিং নিংপুরোওয়া। আবিকো প্যাকোতাহা নাবিহা লেরাহিংয়া স্যাপুরোওয়া, লেরাহিংয়া ক্রুসতা থ্যইপুরোওয়া, আসা লেরাহিংয়া আপনিকো জোংসুওয়া সাবিতা সাটাসো ডুরোওয়া, আসা শহর শহরবিতা সতায়রোওয়া। <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />এপারাং বাসিমতিতা ক্যাপাওয়া তাংসা তাংজি নিওয়া দিংঙাবিকো য়ুতিহা তাংজি নিওয়া হাবিলকো য়ুতিসোহা বেরেক্য়াকো চেংওয়া জকরিয়াকো য়ুতি চোইপা, হাংসুহিং নাবি পবিত্র দেমসা আসা ভেদিকো প্যাকোতা স্যাপুমমে, আকু দোষহা নাবিকো তোইতা হুইরোওয়া। <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />আজিপ্পারাং, কা নাবিহিং জাংরোওয়া, ই তাংসা দোষবিহা নেকো দিংঙাবিকো তোইতা হুইরোওয়া।<verse eid="MAT 23:36" /></para>
  <para style="s">য়রুশালেমহিং চেতাউনি পিচাওয়া</para>
  <para style="r">(<ref loc="LUK 13:34-35">লুক ১৩:৩৪-৩৫</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />“ও য়রুশালেম, ও য়রুশালেম, নাতিহা অগমবক্তাবিহিং স্যায়ে আসা সেংজাকো নাবিকোতা নিংপুমবিহিংয়া নাবিহা লুংটুই টোয়ে! হেপা কেকাকো আংমা আপনিকো চেংবেবিহিং বেগ্রেংকো লিতা তুংমসা এমমে, এপারাং কা নাকো চেংবিহিংয়া জমা জোকো কেংয়ে, আদো নাতিহা মামানেতো। <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />কাং, কা নাবিকো সাহিংয়া পেইপুরোওয়া আসা আকু সাহা চিচ্চোপা জিংপুরোওয়া। <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />হাংপাতানাহা কা নাবিহিংয়া জাংরোওয়া, ‘প্রভুসেংজাকো মিংতা ওয়াংওয়াহা আশিষিত নিও’ তামসা মাজাংনু চোইপা নাবিহা কাহিংয়া মাতিংরোওয়া।”<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">নোইস্যাকো দিনকো চিহ্নবি</para>
  <para style="r">(<ref loc="MRK 13:1-13">মর্কুস ১৩:১-১৩</ref>; <ref loc="LUK 21:5-19">লুক ২১:৫-১৯</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />আকো নোইতা ইশুহা দেমসাসো নোমসা হ্যাদাংনুওয়া আকো য়োংতোংবিহা আকুহিংয়া দেমসাকো এনতাওয়া সাবি তিংপাকো তামসা আকো আবেইতা ওয়াংয়ে। <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />আদো আকুহা আবিহিংয়া জাংয়ে, “নাবিহা ই তাংসা তিংদিংয়ো, মোকোতা? আজিপ্পারাং কা নাবিহিং জাংরোওয়া, ইরুং লুংটুইকো তোইতা ইরুং লুংটুইরে মায়ুংরোওয়া, তাংসা হ্যাপুরোওয়া।”<verse eid="MAT 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />ইশু জেইতুন য়্যাগ্যইতা গাদিংনুওয়া য়োংতোংবিহা চিচিপা ওয়াংমসা আকুহিং উইয়ে, “কাবিহিং জাংওয়া ই নুওয়াংহা হাত্রং জিংকোগা? নাকো লারেমসা লেপাদাংওয়া আসা ই বাসিমতিহা দাংপুদাংওয়া নিও তাওয়াকো চিহ্নহিংয়া কাবিহা হেপা সিদা চ্যইকোগা?”<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />ইশুহা আবিহিংয়া জাংয়ে, “হোশিয়ার য়ুং, হাংসুরে নাবিহিং ল্যহইপাকো মোছুকো, <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />হাংপাতানাহা উইসে দিংঙাবিহা ‘খ্রীষ্টগা’ তামসা কুং মিংতা লেরোওয়া আসা উইসে দিংঙাবিহিংয়া ল্যহপারোওয়া। <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />নাবিহা লুইসুয়ে তাওয়া আসা লুইসুওয়াকো দেরেংবি হিংরোওয়া। আদো আত্রংহা নাবিহা মাচ্ছুংগে। আকু তাংসা নুওয়াংবিহা জিংনেকোরাংগা, আদো বাসিমতিহা আত্রংতারাং মাদাংরোওয়া। <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />হাংপাতানাহা জ্যাকো তোইতা জ্যা আসা রাজ্যকো তোইতা রাজ্য বিরোধ জোসুরোওয়া, আসা জায়গা জায়গাতা চাওয়া আংওয়াবি মামুংপা জিংপুরোওয়া আসা নিংঙা হ্যারোওয়া। <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />আদো ই তাংসাহা দেপাওয়া চুসুংমাইসুং-ক্যইওয়াহা দুঃখকো শুরু মেংচেগা।<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />“আত্রংহা আবিহা নাবিহিংয়া প্যইমসা সতায়রোওয়া আসা কোইচ্যাপাকো স্যাপুরোওয়া, আসা কুং মিংকো সোতা তাংসা জ্যাবিহা নাবিহিংয়া আচকাপা জোরোওয়া। <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />আত্রংহা উইসে দিংঙাবিহা দেংকোরে ল্যাপুরোওয়া, আসা ইচোহা দোসরাহিং ধোকা আসা আচকাপা জোরোওয়া। <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />উইসে প্যায়োং য়্যইওয়া অগমবক্তাবি লেরোওয়া আসা উইসে দিংঙাবিহিংয়া দুদুইপারোওয়া। <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />আসা মেংতাওয়া সিওপা জিংপুওয়াকো সোতা উইসে দিংঙাবিকোতাহা জেজেংওয়ারে মোতোপা জিংপুরোওয়া। <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />আদো নোইস্যা চোইপা সহায়মসা সাডুংপা য়ুংবিহা বাচেরোওয়া। <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />আসা তাংসা জ্যাকো দিংঙাবি হিংকো তামসা বাসিমতিকো আরিকোংপে চোইপা সেংজাকো রাজ্যকো এনতাওয়া দেরেং হিংপারোওয়া, আকো নোইতা মেংচে বাসিমতিহা দাংপুরোওয়া।<verse eid="MAT 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />“অগমবক্তা দানিয়েলকো ‘দেমসাকো পবিত্র জায়গাতা আচকাক্যইওয়া সোংসা এওয়া নিরোওয়া’ তামসা জাংওয়াহা নাবিহা তিংরোওয়া। (ই জাংওয়া নুওয়াংহা পড়াইমবিহা কোইকো।) <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />আত্রংহা হাংসু য়হুদিয়াতানি, আবিহা য়্যাগ্যইবিতা ক্যাচপুকো। <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />সাকো কেংবুতা নিমবিহা সাকো লিতা উইমসা নাপোতা নিওয়া সোংসাবি লাকো তামসা মোহোকো। <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />লুংনিংতা কাংপামবিহা লুচাওয়া আংদুংবি লাকোরে সাতা লাকামসা মোহোকো। <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />আত্রংহা ফেমাতা চেং নিওয়াবি আসা য়ো পেয়াংওয়া আয়ুবিহিংয়া হাসেকো চুসুং-মাইসুংক্যইপা জিংকোমে! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />সেইগু আসা সানুকো দিনতা ক্যামঘ্যইকো<note caller="+" style="f"><char style="fr" closed="false">২৪:২০ </char><char style="ft" closed="false">সেইগুহা ইস্রাইল লোইতাহা সিওপা ওয়্যাতি ওয়্যাচাংমি।</char></note> তামসা নাবিহা সেংজাকোতা পাচাই। <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />হাংপাতানাহা আত্রংকো দিনতাহা এপাজিংওয়া টেবো দুঃখকো দিনবি দেয়োংরোওয়া, এপাজিংওয়াহা বাসিমতিহিং দিংওয়াসোহা হাত্রংরে নেচোইপা মাজিংয়াংতো, আসা হাত্রংরে জিংকোরে মাজিংরোওয়া। <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />সেংজামি আকু দুঃখকো দিনহিংয়া লিয়োপা মোজোপিনাহা, হাংসুরে বাচেমক্যইকোগা, আদো আপনিকো জেংওয়া দিংঙাবিকো সোতা আকুহা আকু দিনবিহা লিওপা জোপিরোওয়া।<verse eid="MAT 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23" />“আত্রংহা নাবিহিংয়া দোসরামি ‘কাং, খ্রীষ্টহা ইতা নিও আসা উতা নিও’ তামসামি জাংনাহা এপাজিংওয়া নুওয়াংবিতাহা মাদেং। <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />হাংপাতানাহা প্যায়োংকো খ্রীষ্টবি, আসা প্যায়োং অগমবক্তাবি তিংরেরোওয়া, আবিহা টেরবো টেরবো চিহ্নবি তিংপামসা ছুওয়া সেই সেংজাকো জেংওয়া দিংঙাবিহিংনে ল্যইপারোওয়া। <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />কাং, কাহা নাবিহিংয়া ই নুওয়াংহা নাগাইসোরাং জাংপুনতেমি নিও।<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />“দিংঙাবিমি নাবিহিংমি ‘কাং, খ্রীষ্টহা চিচ্চোওয়া জায়গাতা নিও’ তামসামি জাংনাহা বাইরে নোমসা মাহ্যা। আসা ‘কাং, আকুহা নাপো সিরিবিতা নিও’ তামসা জাংদো আবিকো তোইতা মাদেং। <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />হাংপাতানাহা হেপা নুব্যাসো তিত্রাইনু দিব্যাতা চোইপা হাহাইপা তিংমমে, এপারাং দিংঙাকো চেংওয়া লেনুরে তিংরোওয়া। <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />হাংতা অ্যাপুওয়ানি, আউতাহা সিগুংবিরে পুংসুমগা।<verse eid="MAT 24:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />“আকু দুঃখকো দিনবিতাহা তাত্রিংপা সিনিহা নাটুংপা জিংপুরোওয়া, আসা তারিরে হাংজি মিচারোওয়া, আসা পুইমাবিহা ডিংবাসো হুইচারোওয়া আসা ডিংবাকো সেবিহা য়াচপুরোওয়া। <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" />আত্রংহা দিংঙাকো চেংওয়াকো চিহ্নহা ডিংবাতা তিংরোওয়া, আসা বাসিমতিকো তাংসা জ্যাকো দিংঙাবিহা লোচোপেংগেংপা জিংপুরোওয়া, আসা আবিহা দিংঙাকো চেংওয়াহিংয়া ডিংবাকো মুওয়াবিতা সে আসা টেবো মহিমাতা দেপাওয়া তিংরোওয়া। <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />আকুহা আপনিকো লোডিংবাকো পোইংবিহিংয়া পেপনেকো টেবো আওয়াজতা চিত্তা নিংপুরোওয়া, আসা আবিহা ডিংবাকো ইচো আরিসোহা দোসরা আরি চোইপা তাংসা জায়গাসোরাং আকো জেংওয়াবিহিং জমা জোরোওয়া।<verse eid="MAT 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />“আদো মুইরাকো সিংতেংসো ইচো নুওয়াং ঝি। হাত্রং আকো গেইবেবি নোমরাংগাং, আসা সিংতেংহা নোইচু নোইদাং, আত্রংহা বোওয়াহা আবেইতা দেপাদাংতেও তামসা নাবিহা সিদা চ্যইমগা। <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />এপারাং কুং জাংওয়া ই তাংসা নুওয়াংবি জিংদিংওয়া নাবি তিংনুওয়া কা লেপাদাংতেয়ুং তামসা নাবিহা গেরোওয়া। <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />কা নাবিহিংয়া আজিপ্পারাং জাংরোওয়া, ই তাংসা নুওয়াংবি মাজিংয়াংনু চোইপা নেকো দিংঙাবিহা মাসিরোওয়া। <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />ডিংবাসো বাসিমতিহা য়াংপুরোওয়া, আদো কুং জাংওয়া নুওয়াংবিহা হাত্রংরে মায়াংরোওয়া।<verse eid="MAT 24:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />“আদো আকু দিন আসা সময়বিহা হাত্রং জিংকোমে তামসাহা হাংসুরে মেগেমগা, লোডিংবাকো পোইংবিরে মেগেমগা আসা চেংওয়ারে মেগেমগা, আদো সেংজা আপা মেংচে গেমগা। <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />দিংঙাকো চেংওয়া লারেমসা লেপানুওয়া নোহাকো সময়তা ত্যাবাপা জিংরোওয়া। <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />হাংপাতানাহা ব্যান্যা হ্যানুরোমা নাগাই নোহা তিকো জাহাজকো নাপোতা মোহোয়াংনু চোইপা দিংঙাবিহা চাদিংমগা, আংদিংমগা আসা বিয়ৌবি জোদিংমগা। <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />আসা বান্যাসো জোওমসা সিপুনুরোমা নাগাইহা হাং জিংকোমে তাওয়া আবিহা হাইরে মেগেয়াংমগা। আকু ত্যাবাপারাং দিংঙাকো চেংওয়া লেনুরে জিংরোওয়া। <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />আকু সময়তাহা নিহসো দিংঙাবিহা নিয়াংতা কাম জোদিংওয়া কোকোইত্তা ইচোহিংয়া পুরাচারোওয়া ইচোহিংয়া হুইতেরোওয়া। <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />নিহসো মেমেবিহা ওয়াংটা হুইসুদিংনুওয়া ইচোহিংয়া পুরাচারোওয়া, ইচোহা হুইতেরোওয়া। <verse eid="MAT 24:41" /><verse number="42" style="v" sid="MAT 24:42" />আকো সোতারাং নাবিরে হাত্রংদো তৈয়ার য়ুং, হাংপাতানাহা নাবিকো প্রভু হাত্রংকো দিন লেকোমে নাবিহা সিদা মোচ্যইরোওয়া। <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />সাকো গিরিওয়াহা কুইওয়া হাত্রং ওয়াংকোমে তামসা সিদা চ্যইনাহা আকুহা মাজিংপা সাহিং খুইমসা কুকো মিচাকোগা তাওয়া নুওয়াং নাবিহা কোইকো জো। <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />আকো সোতারাং নাবিরে হাত্রংদো তৈয়ার য়ুং, হাংপাতানাহা দিংঙাকো চেংওয়াহা নাবি মোনোমি চুইনুরাং লেরোওয়া।<verse eid="MAT 24:44" /></para>
  <para style="s">দেংওয়াসো দুংজি নিওয়া ডেইয়া</para>
  <para style="r">(<ref loc="LUK 12:41-48">লুক ১২:৪১-৪৮</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />“হাংসু ডেইয়া দেংকো চুওয়া আসা দুংজি নিওয়া নিংগা, আকুহিংয়া সাকো গিরিহা আকো সাহিং কাংকো চি ত্যইমসা দোসরা ডেইয়াবিহিং সময়-সময়তা চাওয়া-আংওয়াবি পিচাকো তামসা খুইতেমগা। <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />আকু সাকো গিরি লায়োংমসা ওয়াংনুওয়া আকুমি দোসরা ডেইয়াবিহিং এপারাং জোদিংওয়া দোসুনাহা, আকুহিংয়া ইনাম পিচারোওয়া। <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />আজিপ্পারাং, কা জাংরোওয়া, আকু সাকো গিরিহা আকু ডেইয়াহিংয়া আকো তাংসা পুংজিবিকো তোইতা অধিকার পিচারোওয়া। <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />আদো আকু মেংতাওয়া ডেইয়ামি আকো তুংসিংতা, ‘কুং গিরিহা তানাংতা হোমি নিও, আসা সেন্নেপা মেলেরোওয়া’ <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />তামসা কাম জোওয়া ব্যারোবিহিং ডুমসা গাইমবিহিংপা চাকো আংকো কেংনাহা, <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />আকু ডেইয়াকো গিরিওয়াহা আকু মেগেমি চুইনু আসা মোনোমি চুইনুকো সময়তারাং দেরেরোওয়া। <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />আসা আকো গিরিওয়াহা আকুহিংয়া সিওপারাং ডুমসা তেপি দিংঙাবিহিংপা চিত্তা দন্ড পিচারোওয়া। আউতা আকুহা কাইরোওয়া আসা সেতাং কিট্টিরোওয়া।”<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">ত্যাচো নামেরি মেমেবিকো মিংচি</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />ইশুহা ন্যাসারাং জাংয়ে, “সেংজাকো রাজ্যহা বিয়ৌকো বিয়ৌলাহিং ন্যাতা ইপো চোইপা দিব্রি পুমসা দোসপাকো হোওয়া ত্যাচো নামেরি মেমেবি ত্যাবাপাগা। <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />আবিকো প্যাকোতাহা ঙাচোহা দুংজি মাতাওয়া ঙাচোহা দুংজি নিওয়া মেমেবি নিমি। <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />আকু দুংজি মাতাওয়া নামেরি মেমেবিহা দিব্রিহা পুয়ে, আদো তেংকোইপা ক্রাংটিহা মাপুতো। <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />আদো আকু দুংজি নিওয়া ঙাচো নামেরিবিহা দিব্রি আসা বোত্রাতাহা ক্রাংটি পুয়ো। <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />আসা বিয়ৌকো বিয়ৌলাহা গোইপাপুমসা সেন্নেপা মোওয়াংনুওয়া আবিহা জিংদাংপুমসা জিংজুয়ে।<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />“আদো বারো বাজি লিসুং কাচিতাহা ‘বিয়ৌলা দেয়োংয়ে, আসা দোসপাকো ওয়াং’ তামসা জাংওয়া আওয়াজ হিংয়ে।<verse eid="MAT 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7" />“আত্রংহা আকু নামেরি মেমেবিহা লোমসা আবিকো দিব্রি তৈয়ার জোয়ে। <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />আকু দুংজি মাতাওয়া নামেরিবিহা দুংজি নিওয়াবিহিং জাংয়ে, ‘কাবিহিংনে অ্যাইসি ক্রাংটি পিচা, হাংপাতানাহা কাবিকো দিব্রিহা সিপুদাংতেনা।’<verse eid="MAT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9" />“আকু দুংজি নিওয়া নামেরিবিহা জাংয়ে, ‘আঁহা, কাবিহিং আসা নাবিহিং তেংওয়া ক্রাংটি কাবিহিংপা মাতানা, আদো ক্রাংটি পিচাওয়াবিকোতা নাবিহা হোমসা চোইচাতু।’<verse eid="MAT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10" />“আদো আবি ক্রাংটি চোইয়াকো হোনুওয়া বিয়ৌলাহা দেরেয়ে। আসা আকু তৈয়ার নিওয়া নামেরি মেমেবিহা আকুহিংপা বিয়ৌতা চাকো আংকো হোয়ে, আসা লাপুংহা গিচপুয়ে।<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />“আকো নোইতাহা আকু দুংজি মাতাওয়া ঙাচো নামেরিবিরে আউতা দেরেমসা মোউসুয়ে, ‘প্রভু, প্রভু, কাবিহিংনে লাপুং ওয়েপি।’<verse eid="MAT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12" />“আদো আত্রংহা আকু বিয়ৌলাহা জাংয়ে, ‘কা আজিপ্পারাং নাবিহিং জাংরোওয়া, কা নাবিহিংয়া মানাইমি!’<verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />“আকো সোতা তৈয়ার য়ুং, হাংপাতানাহা কা হানি দিনতা লেকোমে আসা হানি সময়তা দেরেকোমে নাবিহা সিদা মাচ্যইরোওয়া।” <figure style="fig" alt="বিয়ৌতা ওয়াংওয়া ত্যাচো নামেরি মেমেবিকো মিংচি" file="lb00318.jpg" size="col" ref="২৫:০" /><verse eid="MAT 25:13" /></para>
  <para style="s">সুংচো ডেইয়াবিকো মিংচি</para>
  <para style="r">(<ref loc="LUK 19:11-27">লুক ১৯:১১-২৭</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />ইশুহা ন্যাসারাং জাংয়ে, “লোডিংবাকো রাজ্যহা এপা নিও: তানাং হ্যাদাংওয়া ইচো দিংঙা নিমি। আকুহা আকো ডেইয়াবিহিং মোউমসা আকো ন্যাস্যা চিত্যইতেয়ে। <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />আকুহা ডেইয়াবিহিংয়া কাম জোকো ছুওয়া সেই ইচোহিংয়া ঙাচো সুনকো টাংকা, ইচোহিংয়া নিহসো সুনকো টাংকা, ইচোহিংয়া ইচো সুনকো টাংকা পিচাতেয়ে। আসা আকুহা তানাংতা হোপুইয়ে। <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />আকু ঙাচো সুনকো টাংকা মুংচাওয়া ডেইয়াহা সেন্নেপা হোমসা আকু ন্যাস্যাহিংয়া কাম জোমসা দোসরা ঙাচো সুনকো টাংকা কামাইয়ে। <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />এপারাং নিহসো সুনকো টাংকা মুংচাওয়া ডেইয়ারে দোসরা নিহসো সুনকো টাংকা কামাইয়ে। <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />আদো আকু ইচো সুনকো টাংকা মুংচাওয়া ইচো ডেইয়াহা হোমসা আকো গিরিকো টাংকাহা মোংটোতা লিইকাপুয়ে।<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />“আকো উইসে লো নোইতা আবিকো গিরি লায়োংমসা ডেইয়াবিহিং আকো ন্যাস্যাকো হিসাব য়ায়ে। <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />আকু ঙাচো সুনকো টাংকা মুংচাওয়া ডেইয়াহা দোসরা ঙাচো সুনকো টাংকা পামসা এপা জাংয়ো, ‘ও কুং গিরি, নাতিহা কাহিংয়া ঙাচো সুনকো টাংকা পিচামগা, আদো কাং, কাহা দোসরা ঙাচো সুনকো টাংকা কামাইমি নিও।’<verse eid="MAT 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21" />“আকো গিরিহা আকুহিংয়া জাংয়ে, ‘ও আসল আসা এনতাওয়া দেংকো ছুওয়া ডেইয়া! নাতিহা এনতাপারাং জোয়ো। নাতিহা আস্যস্যই ন্যাস্যাতারে দেংকো ছুওয়া জিংয়ো, নেহা কা নাতিহিংয়া উইসে নুওয়াংতারে অধিকার পিচারোওয়া। নেহা কাহিংপারাং গাগ্রুপা জিং।’<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />“আসা নিহসো সুনকো টাংকা মুংচাওয়ারে ওয়াংমসা এপা জাংয়ে, ‘ও কুং গিরি, নাতিহা কাহিং নিহসো সুনকো টাংকা পিচামগা। আদো কাং, কাহা দোসরা নিহসো কামাইমি নিও।’<verse eid="MAT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23" />“আকো গিরিহা আকুহিংয়া জাংয়ে, ‘ও আসল আসা এনতাওয়া দেংকো চুওয়া ডেইয়া! নাতিহা এনতাপারাং জোয়ো। নাতিহা অ্যাইংসি ন্যাস্যাতারে দেংকো ছুওয়া জিংয়ো, নেহা কা নাতিহিংয়া উইসে নুওয়াংতারে অধিকার পিচারোওয়া। নেহা কাবিহিংপারাং গাগ্রুপা জিং।’<verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />“আত্রংহা আকু ইচো সুনকো টাংকা মুংচাওয়া ডেইয়ারে লেমসা জাংয়ে, ‘ও কুং গিরিওয়া, নাকো তুংসিংহা লুংটুই বেপা নিও তামসা কা গেমগা। নাতিহা হাংতা মিমি আউতারে মোইপ্যা চ্যামগা, হাংতা অংসে মিমি আউতা অংসে য়োমগা। <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />আকো সোতা কা চুসুংপুমসা নাকো ন্যাস্যাহা পুমসা মোংটোতা লিকাপুয়ে। নাকো ন্যাস্যাহা কাং, ইতারাং নিও।’<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />“আকো গিরিহা আকুহিংয়া জাংয়ে, ‘নাতিহা মেংতাওয়া আসা ডুমক্যইওয়া ডেইয়া! কাহা হাংতা অংটি মিমি আউতারে অংসে য়োকো কেংমগা তামসাহা নাতিহা গেমিরাং নিমগা। <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />আকো সোতা নাতিহা কুং ন্যাস্যাহা পুমসা খিওয়া দিংঙাবিহিং কাম জোকো পিচানাহা তুকোগা। এপামি জোনাহা কা লায়োংমসা ওয়াংনুওয়া কুং ন্যাস্যাকো চেংবেবিরে কাহা মুংচাকোগা!’ <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />আকো নোইতাহা গিরিওয়াহা আজ্ঞা জোয়ে, ‘ই ডেইয়াকোতা নিওয়া ন্যাস্যা গিংমসা ত্যাচো সুনকো টাংকা নিওয়া ডেইয়াহিং পিচাপুই। <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />হাংপাতানাহা হাংসুহিংপানি, আকুহা ন্যাসারাং মুংচারোওয়া, আসা আকোহা সিওপা জিংপুরোওয়া। হাংসুহিংপা মোতো, আকুহিংপা অ্যাইসি নিওয়ারে আকোসোহা গিংচপুরোওয়া। <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />ই কাম মাতাওয়া ডেইয়াহিংয়া বাইরে নাঘিওয়াতা বাডোইপুই। আউতাহা কাইমসা সেটাং কিট্টিরোওয়া’।”<verse eid="MAT 25:30" /></para>
  <para style="s">নোইস্যাকো ন্যায়</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />“দিংঙাকো চেংওয়াহা আকো মহিমাতা আপনিকো লোডিংবাকো পোইংহিংপা লেনুওয়া আকো মহিমিত গাদিংতা আকুহা গারোওয়া। <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />বাসিমতিকো তাংসা জ্যাকো দিংঙাবিহা আকো নাগাইতা জমা জিংরোওয়া, আসা লুকাকো গোইত্রহা লুকাবিহিংয়া এতাবিসো ওয়েংপামি ত্যাবাপা দিংঙাবিহিংয়া ওয়েংপারোওয়া। <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />আকো দাংক্রেং কাটুতা লুকাবিহিং আসা কেক্রেং কাটুতা এতাবিহিং এরোওয়া।<verse eid="MAT 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34" />“আত্রংহা জাইপুহা আকো দাংক্রেং কাটুকোবিহিং জাংরোওয়া, ‘ও, কুং আপাকোসো আশিষ মুংচাওয়াবাই! লেই, বাসিমতি দিংনুসোরাং নাবিকো সোতা তৈয়ার জোওয়া রাজ্যতা য়ুং। <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />হাংপাতানাহা কা আমা পাংনুওয়া নাবিহা কাহিংয়া চাওয়া পিচায়ো, কাহিং তি সেকেংনুওয়া নাবিহা পেয়াংয়ো, আসা কা তানাংসো কোইয়োংকো ওয়াংনুওয়া নাবিহা কাহিংয়া সাতা পুরায়ো। <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />আসা কা পাইক্রি নিনুওয়া আংদুং পিচায়ো, কা হাইনুওয়া নাবিহা কাহিং কাংপিয়ো, আসা কা জেলতা নিনুওয়া নাবিহা কাহিং কাংকো ওয়াংয়ো।’<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />“আত্রংহা তাংজি নিওয়া দিংঙাবিহা আকুহিংয়া জাংরোওয়া, ‘ও প্রভু, হাত্রং কাবি নাতিহিংয়া হাপাংওয়া তিংগা, আসা চাকো পিচাংগা? হাত্রং তি সেকেংওয়া তিংগা, আসা তি পেয়াংগা? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />হাত্রং কাবি নাতিহিংয়া কাবিকো লোইতা কোইয়োংকো ওয়াংওয়া তিংগা, আসা নাতিহিং য়ুংকো পিচাংগা? আসা হাত্রং নাতিহিং পাইক্রি তিংগা, আসা আংদুং পিচাংগা? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />আসা হাত্রং কাবি নাতিহিংয়া হাইওয়া আসা জেলতা য়ুংওয়া তিংগা, আসা কাবিহা নাকোতা ওয়াংগা?’<verse eid="MAT 25:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40" />“আত্রংহা জাইপুহা আবিহিংয়া এপা জাংরোওয়া, ‘আজিপ্পারাং, কা নাবিহিংয়া জাংরোওয়া, নাবিহা ই কুং দিংঙাবিকোতাহা হানিরোমা চিয়োওয়াহিং হাই জো, নাবিহা আকুহা কাহিংনাং জোওয়াগা।’<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />“আকো নোইতাহা আকুহা কেক্রেং কাটুকো দিংঙাবিহিং জাংরোওয়া, ‘ও লেইসাওয়া দিংঙাবাই! কুংসো তানাং হোতু, শয়তান আসা আকো পোইংবিকো সোতা তৈয়ার জোওয়া হাত্রংরে মিসিওয়া মেহতা হোতু! <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />হাংপাতানাহা কা হাপাংপুমি নিমগা, নাবিহা কাহিংয়া চাকো মিচাতো। সেকেংপুমি নিমগা মেপেইয়াংতো। <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />কোইয়োংকো ওয়াংওয়া নিমগা, নাবিহা কাহিংয়া সাতা য়ুংকো মাপুরাতো। পাইক্রি নিমগা, নাবিহা কাহিংয়া আংদুং মিচাতো, হাইমি নিমগা আসা জেলতা নিমগা, নাবিহা কাহিংয়া কাংকো মোয়াংতো।’<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />“আত্রংহা আবিরে এপা জাংরোওয়া, ‘প্রভু, হাত্রং কাবি নাতিহিংয়া হাপাংওয়াসো সেকেংওয়া তিংগা, আসা কোইয়োংকো ওয়াংওয়া, পাইক্রি, হাইওয়া, জেলতা, তিংগা? আসা নাতিহিং মাকাংগা?’<verse eid="MAT 25:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45" />“আত্রংহা জাইপুহা আবিহিংয়া জাংরোওয়া, ‘আজিপ্পারাং, কা নাবিহিংয়া জাংরোওয়া, ই তাংসা কুং দিংঙাবিকোতাহা হানিরোমা চিয়োওয়াহিং হাই মোজো, আকুহা নাবিহা কাহিংনাং মোজোওয়াগা।’<verse eid="MAT 25:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46" />“আত্রংহা ইবিহা হাত্রংরে মিসিওয়া দন্ড মুংরোওয়া, আদো তাংজি নিওয়া দিংঙাবিহা হাত্রংরে মিসিওয়া সাদিতা হোরোওয়া।”<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">ইশুহিং স্যাসুকো হুইসুওয়া</para>
  <para style="r">(<ref loc="MRK 14:1-2">মর্কুস ১৪:১-২</ref>; <ref loc="LUK 22:1-2">লুক ২২:১-২</ref>; <ref loc="JHN 11:45-53">য়হুন্না ১১:৪৫-৫৩</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />ইশুহা ই নুওয়াং জাংপুনতেনুকো নোইতাহা আপনিকো য়োংতোংবিহিং জাংয়ে, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />“নাবিহা গেমিরাং নিও, নেহা সানিহয়ুকো নোইতাহা নিস্তার মানক্যা ওয়াংরোওয়া, আসা দিংঙাকো চেংওয়াহিংয়া ক্রুসতা থ্যইমসা স্যাকো প্যইপুরোওয়া।”<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />আত্রংহা কাইয়াফা মিং নিওয়া টেবো পাউকো লাঙাংতা মাটা পাউবি আসা দোসরা য়হুদি মাটা ওয়ারাংপাবি চাংসুমসা জোংসুয়ে। <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />আসা আবিহা ইশুহিংয়া হেপা চেকেপা প্যইকোমে আসা স্যাকোমে তামসা হুইসুয়ে। <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />আদো আবিহা জাংয়ে, “মানক্যাকো সময়তা মোকোমি, মেনাহা দিংঙাবিকো প্যাকোতাহা টেবো চেচোওয়াইপা জিংপুরোওয়া।”<verse eid="MAT 26:5" /></para>
  <para style="s">ইশুকো পোরোতা পাংক্যইওয়া চুইতি নাইওয়া</para>
  <para style="r">(<ref loc="MRK 14:3-9">মর্কুস ১৪:৩-৯</ref>; <ref loc="JHN 12:1-8">য়হুন্না ১২:১-৮</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />ইশু বেথানিয়াতা য্যাসো হাইমসা সাংওয়া সিমোনকো সাতা নিনুওয়া, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />ইচো মেমেহা এনতাওয়া বোত্রাতা পাংকোইওয়া ওহও্যহপা মেনাংওয়া চুইতি পামসা ইশুকোতা লেয়ে, আসা আকু চাকো গানুওয়া আকু মেমেহা ইশুহিং আদর পিচাকো তামসা ইশুকো পোরোতা লুপুয়ে। <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />হাত্রং য়োংতোংবি ই তিং, আত্রংহা আবিহা সেদ্রাংপামসা জাংয়ে, “হাংকো সোতা এসেকো পাংকোইওয়া চুইতিহা এপারাং লাডু বাদোইমগা? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />ইরোমাহা ইহিংয়া পিচামসা জোরোংবিহিং ন্যাস্যাহা চোপিনাহা তুকোগা।”<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />আদো ইশুহা ই নুওয়াং সিদা চ্যইমসা আবিহিং জাংয়ে, “নাবিহা ই মেমেহিংয়া হাংপা দুঃখ পিচামগা? আকুহা কুং সোতাহা ইচো এনতাওয়া কাম জোমি নিও। <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />হাংপাতানাহা জোরোংবিহা হাত্রংদো নাবিহিংপারাং নিরোওয়া, আদো কাহা নাবিহিংপাহা মাতারোওয়া। <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />আকুহা ই ওহও্যহপা মেনাংওয়া চুইতিহা কুং জুপাতা লুমসা কাহিং লির্কো সোতা তৈয়ার জোমগা। <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />আজিপ্পারাং কা নাবিহিং জাংরোওয়া, বাসিমতিকো তাংসা জায়গাতা হাংতা হাংতা এনতাওয়া দেরেং হিংপা, আউতা ইকো জোওয়া ই কামরে প্যারাপারোওয়া।”<verse eid="MAT 26:13" /></para>
  <para style="s">য়হুদাহা ইশুহিং প্যইপাকো তৈয়ার জোওয়া</para>
  <para style="r">(<ref loc="MRK 14:10-11">মর্কুস ১৪:১০-১১</ref>; <ref loc="LUK 22:3-6">লুক ২২:৩-৬</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />আকো নোইতাহা বার্চো য়োংতোংবিকো প্যাকোতা ইচো য়হুদা ইস্করিয়োত তাওয়াহা মাটা পাউবিকোতা হোয়ে, <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />আসা জাংয়ে, “কামি ইশুহিংয়া নাবিকো খুইতামি প্যইপানাহা, কাহিংয়া হাং পিচাকোগা?” আবিহা আকুহিং জাতাংকো ইকাইসো ত্যাচো টাংকা পিচায়ে। <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />আত্রংসো য়ুতাহা য়হুদাহা ইশুহিং প্যইপাকো মৌকা মোইয়ে।<verse eid="MAT 26:16" /></para>
  <para style="s">নোইস্যাকো চাওয়া</para>
  <para style="r">(<ref loc="MRK 14:12-26">মর্কুস ১৪:১২-২৬</ref>; <ref loc="LUK 22:7-23">লুক ২২:৭-২৩</ref>; <ref loc="JHN 13:21-30">য়হুন্না ১৩:২১-৩০</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />সোঁরা মালুওয়া কোব্রেং চাওয়া মানক্যাকো নাগাইকো দিন য়োংতোংবিহা ইশুকোতা ওয়াংমসা উইয়ে, “নাকো সোতা কাবিহা নিস্তার মানক্যা<note caller="+" style="f"><char style="fr" closed="false">২৬:১৭ </char><char style="ft" closed="false">সোরা মালুওয়া কোব্রেং চাওয়া মানক্যা আসা নিস্তার মানক্যাহা লারাংসা লারাংসা মানক্যাগা, আদো চিত্তা ওয়াংওয়া মানক্যা জিংওয়াকো সোতা দিংঙাবিহা আকু মানক্যাহিংয়া ইচো মিংসোরাং নাইমগা।</char></note> চাকোহা হাংতা তৈয়ার জোকোগা?”<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />আকুহা জাংয়ে, “শহরতা ইচো দিংঙাকোতা হোতু, আসা আকুহিং জাং, ‘উটকেওয়া জাংদিংনা, কুং সময় আবেইতা ওয়াংপুনতেনা। কা কুং য়োংতোংবিহিংপা নাকো সাতা নিস্তার মানক্যা চারো’।” <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />য়োংতোংবিহা ইশুকো জাংওয়া সেই নিস্তার মানক্যা চাকো আউতারাং তৈয়ার জোয়ে।<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />হাত্রং জিরোং জিংপু, আত্রংহা আকুহা বার্চো য়োংতোংবিহিংপা চাকো গায়ে। <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />আবি চাদিংনুওয়া ইশুহা জাংয়ে, “আজিপ্পারাং, কা নাবিহিং জাংরোওয়া, নাবিকো প্যাকোতাহা ইচোহা কাহিং প্যইপাপুরোওয়া।”<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />আত্রংহা আবিহা সিওপারাং তুংসিং চিচাপুমসা তাংসা ইচো ইচো জোমসা আকুহিং উইয়ে, “প্রভু আকুহা কাগা?”<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />আকুহা জাংয়ে, “হাংসু কাহিংপা চোপোইতা কোব্রেং বুমিনি, আকুরাং কাহিং প্যইপাপুরোওয়া। <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />দিংঙাকো চেংওয়াহা আকো তোইতা তাংজিকো হিগাতা লাওয়া সেই সিকোহা সিনেরোওয়া। আদো টেবো দুঃখ ওয়াংরোওয়া দিংঙাকো চেংওয়াহিং প্যইপাওয়া দিংঙাকোতাহা! আকু দিংঙাহা আকো সোতাহা মেকেওয়ারাং এনতাকোগা।”<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />আত্রংহা প্যইপাকো কেংওয়া য়হুদাহা আকুহিং উইয়ে, “উটকেওয়া, আকুহা কাগা?”</para>
  <para style="p" vid="MAT 26:25">ইশুহা আকুহিংয়া জাংয়ে, “নাতি আপনিরাং জাংপুয়ে।”<verse eid="MAT 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />আবি চাসু-আংসুদিংনুওয়া ইশুহা কোব্রেং চুংয়ে আসা সেংজাহিং গারানি তামসা আকুহা আকু কোব্রেং মেয়ে আসা য়োংতোংবিহিং পিচামসা জাংয়ে, “এই চা, ইহা কুং জুপাগা।”<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />আকো নোইতাহা আকুহা কচৌরা চুংয়ে আসা সেংজাহিং গারানি তামসা য়োংতোংবিহিং পিচামসা জাংয়ে, “নাবি তাংসা ই কচৌরা আং, <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />হাংপাতানাহা ইহা সেংজাকো নাপোইতেওয়া চুবে করারহিং পক্কা জোওয়া কুং য়ুতিগা। ই য়ুতিহা তাংসা দিংঙাকো পাপ ছমাকো সোতা ক্যাপারোওয়া। <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />আদো কা নাবিহিং জাংরোওয়া, কুং আপাকো রাজ্যতা নাবিহিংপা চুবে জোমসা মাআংনু চোইপা কা ই আংগুরকো সিংতেংকো ফলসো মাআংরোওয়া।” <verse eid="MAT 26:29" /><verse number="30" style="v" sid="MAT 26:30" />আসা ইচো লেহদি লেহপুনতেনুওয়া আবিহা জেইতুন য়্যাগোইতা হোপুইয়ে।<verse eid="MAT 26:30" /></para>
  <para style="s">পত্রসকো মানাইমি তামসা জাংওয়া</para>
  <para style="r">(<ref loc="MRK 14:27-31">মর্কুস ১৪:২৭-৩১</ref>; <ref loc="LUK 22:31-34">লুক ২২:৩১-৩৪</ref>; <ref loc="JHN 13:36-38">য়হুন্না ১৩:৩৬-৩৮</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />আত্রংহা ইশুহা আবিহিং জাংয়ে, “হিনি লিসুংহা নাবিহা তাংসা কাহিং হুইতেমসা ক্যাপুরওয়া, হাংপাতানাহা তাংজিকো হিগাতাহা এপা লামি নিও,</para>
  <para style="q" vid="MAT 26:31">‘কা গোইত্রহিং স্যারোওয়া, আসা লুকাবিহা হিংচাইবিরিপা জিংপুরোওয়া।’<note caller="+" style="x"><char style="xo" closed="false">২৬:৩১ </char><char style="xt" closed="false"><ref loc="ZEC 13:7">জোকোরিয়া ১৩:৭</ref></char></note><verse eid="MAT 26:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32" />আদো কা সিপুওয়াসো ঙারোনুওয়া নাবিরোমা নাগাই গালীলতা হোরোওয়া।”<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />পত্রসহা আকুহিংয়া জাংয়ে, “তাংসা নাতিহিং হুইতেদো কাহা নাতিহিংয়া হাত্রংরে মাহুইতেরো।”<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />ইশুহা আকুহিংয়া জাংয়ে, “আজিপ্পারাং, কা নাতিহিংয়া জাংরোওয়া, হিনি লিসুংরাং কেকা ওনুরোমা নাগাই নাতিহা কাহিং সুংকোই চোইপা মানাইমি তামসা জাংরোওয়া।”<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />পত্রসহা আকুহিংয়া জাংয়ে, “নাতিহিংপা সিনেদো কা নাতিহিংয়া মানাইমি তামসা হাত্রংরে মাজাংরো। আসা তাংসা দোসরা য়োংতোংবিরে এপারাং জাংসুয়ে।”<verse eid="MAT 26:35" /></para>
  <para style="s">গেতসমনি দুংরাইতা ইশুকো পাচাইয়াওয়া</para>
  <para style="r">(<ref loc="MRK 14:32-42">মর্কুস ১৪:৩২-৪২</ref>; <ref loc="LUK 22:29-46">লুক ২২:২৯-৪৬</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />আকো নোইতা ইশুহা গেতসামানি তাওয়া জায়গাতা আবিহিংপা হোয়ে, আসা য়োংতোংবিহিং জাংয়ে, “নাবিহা ইতারাং য়ুংতে, কাহা এংসি বারগাং হোমসা পাচাইয়ারোওয়া।” <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />আসা আপনিহিংপাহা পত্রস আসা জোব্দিয়াকো নিহসো চেংওয়াহিং পুরামসা আকুহা সিওপারাং তুংসিং চিচাপুমসা লোচোপেংঙেংপা জিংপুয়ে। <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />আত্রংহা আকুহা আবিহিংয়া জাংয়ে, “কুং তুংসিংহা চিচামসা আরাংপারাংপা জিংমসা তুংসিংরাং টুইপুকো বেপা জিংদিংয়ো। নাবিহা ইতারাং মাজিংপা য়ুংমসা কাহিং য়ুজ্রু।” <verse eid="MAT 26:38" /><verse number="39" style="v" sid="MAT 26:39" />আসা আকুহা এংসি তানাং হ্যামসা চুনুইমসা এপা জাংমসা পাচাইয়ে, “ও কুং আপা, জিংদানাহা ই কুংতা দেপাওয়া দুঃখকো কচৌরা কুংসো ওয়েংপাপি। আদো কুং ইচ্ছাসো মোকো, আদো নাকো ইচ্ছাসো তাংসা জিংকো।”<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />আত্রংহা আকুহা য়োংতোংবিকোতা ওয়াংয়ে, আসা আবিহিংয়া জিংদিংওয়া দোসুয়ে। আকুহা পত্রসহিং জাংয়ে, নাবিহা কাহিংপা এক ঘন্টারে মাজিংপা য়ুংমক্যইংগা? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />মাজিংপা য়ুং, পরিকছাতা মোপোরেকো তামসা পাচাই। লাংবেহা তৈয়ার নিও, আদো জুপাহা মাচুপা নিও।<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />আকুহা ন্যাসারাং হোমসা এপা জাংমসা পাচাইয়ে, “ও কুং আপা, ই দেপাওয়া দুঃখকো কচৌরা কুংসো ওয়েংপাকোরাং মাতুদানাহা, নাকো ইচ্ছারাং তাংসা জিংকো।” <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />আকুহা ন্যাসারাং য়োংতোংবিকোতা ওয়াংনুওয়া আবিহিংয়া ন্যাসারাং জিংজুওয়া দোসুয়ে। আবিহা মিচো ওয়েকোরাং মাচুতো।<verse eid="MAT 26:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 26:44" />আসা ইশুহা আবিহিংয়া এপারাং হুইতেমসা সুংকোই চোইপা ন্যাসারাং নাগাইকো ত্যাবাপা পাচাইয়াকো হোয়ে।<verse eid="MAT 26:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45" />আকো নোইতাহা আকুহা য়োংতোংবি নিওয়াতা ওয়াংমসা জাংয়ে, “নাবিহা নেচোইপা জিংমসা সাদিংগা? হিং, কা দিংঙাকো চেংওয়াহা পাপিবিকো খুইতা দেকাকো সময় জিংতেয়ো। <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />নেহা লো, তে! কাং, ‘কাহিং প্যইপাওয়া দিংঙারে ওয়াংপুনতেয়ো’।”<verse eid="MAT 26:46" /></para>
  <para style="s">ইশুহিং প্যইপুওয়া</para>
  <para style="r">(<ref loc="MRK 14:43-50">মর্কুস ১৪:৪৩-৫০</ref>; <ref loc="LUK 22:47-53">লুক ২২:৪৭-৫৩</ref>; <ref loc="JHN 18:3-12">য়হুন্না ১৮:৩-১২</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />ইশু য়্যইদিংওয়া কোকোইত্তা, বার্চো য়োংতোংবিতাহা ইচো য়হুদাহা আউতা দেরেয়ে। আকুহিংপাহা মাটা পাউবি আসা দোসরা য়হুদি মাটা ওয়ারাংপাবিকো নিংপুওয়া কাসুমা আসা দ্যইবি চুংওয়া উইসে দিংঙাবিরে নিমি। <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />আকুহিং প্যইপাওয়া য়হুদাহা আবিহিংয়া এপা জিংওয়া চিহ্ন পিচাওয়া নিমি, “হানি দিংঙাহিং কা চুম্মা জো, আকুরাং ইশুগা, আকুহিং প্যই।” <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />আত্রংতারাং ইশুকোতা হোমসা য়হুদাহা জাংয়ে, “ও উটকেওয়া, অভিবাদন!” আসা আকুহা ইশুহিংয়া চুম্মা জোয়ে।<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />ইশুহা আকুহিংয়া জাংয়ে, “ও ব্যারো, নাতিহা হাং জোকো ওয়াংমে, আকুহা জোপুই।”</para>
  <para style="p" vid="MAT 26:50">আত্রংহা আবিহা নাগাই ওয়াংমসা তাংসা ইশুহিং প্যইপুয়ে। <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />ই তিংনুওয়া ইশুহিংপা চিত্তা নিওয়াবিতাহা ইচোহা আপনিকো তালওয়ার য়োয়ে, আসা টেবো পাউকো ডেইয়াকো নানুং থেহপুয়ে।<verse eid="MAT 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52" />আত্রংহা ইশুহা আকুহিংয়া জাংয়ে, “নাকো তালওয়ারহা সেপাতা ওয়্যা, হাংপাতানাহা তালওয়ারসো থেসুমবিহা তাংসা তালওয়ারসোরাং সিনেমগা। <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />নাতিহা হাং নোমগা, কা কুং আপাহিং জাংচামক্যইকোগা, আসা আকুহা সেন্নেপা বার্চো পারা<note caller="+" style="f"><char style="fr" closed="false">২৬:৫৩ </char><char style="ft" closed="false">বার্চো পারা তাওয়াহা পন্চাশ হাজার গাংদাং-মাগাদাংপা নিওয়া সিপাইবিগা।</char></note> সিপাইবিরোমা সিওপা লোডিংবাকো পোইংবিহিং কুং সোতা মেনেংপিকোগা? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />আদো কামি য়াপুদানাহা তাংজিকো হিগাতা এপা জিংনেকোগা তামসা লাওয়া নুওয়াংহা হেপা পুরা জিংকোগা?”<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />আত্রংরাং ইশুহা উইসে দিংঙাবিহিং জাংয়ে, “মেংদাংবিহিং প্যইকো ওয়াংমি ত্যাবাপা তালওয়ার আসা দ্যইবি পামসা নাবিহা হাংপা কাহিং প্যইকো ওয়াংমগা? কাহা সদাইবিরি দেমসাতা ঝিপামসা য়ুংচাংমগা, আত্রংহা নাবিহা কাহিংয়া মোপ্যইতো। <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />আদো অগমবক্তাবিকো তাংজিকো হিগাকো নুওয়াংবি তাংসা জিংকো তামসা ই তাংসা জিংমগা।” আত্রংহা তাংসা য়োংতোংবিহা ইশুহিং হুইতেমসা ক্যাপুয়ে।<verse eid="MAT 26:56" /></para>
  <para style="s">লাচি জাংওয়াকো আবেইতা ইশু</para>
  <para style="r">(<ref loc="MRK 14:53-65">মর্কুস ১৪:৫৩-৬৫</ref>; <ref loc="LUK 22:54-71">লুক ২২:৫৪-৭১</ref>; <ref loc="JHN 18:13-24">য়হুন্না ১৮:১৩-২৪</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />ইশুহিং প্যইমবিহা আকুহিংয়া টেবো পাউ কাইয়াফাকোতা পুরায়ে। আউতাহা তাংজিকো উটকেওয়াবি আসা দোসরা য়হুদি মাটা ওয়ারাংপাবি জমা জিংওয়া নিমি। <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />আদো পত্রসহা তানাংসো ইশুহিংপা হুইপামসা টেবো পাউকো লাঙাং চোইপা দেরেয়ে, আসা নোইস্যা চোইপা হাং জিংকোমে, আকু কাংকো সোতা নাপোতা হোমসা আকুহা সা কুইমবিহিংপা গায়ে।<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />মাটা পাউবি আসা আউতা জমা জিংওয়া মাটা লাচিজাংওয়াবিহা ইশুহিংয়া স্যাকো তামসা আকো তোইতা প্যায়োং দোষ লাগাইমবিহিং মোসোইয়ে। <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />উইসে প্যায়োং দোষ লাগাইওয়াবিহা আউতা লেয়ে, আদো আবিহা হাইরে প্রমান মামুংতো। নোইস্যাতা নিহসো দিংঙা নাগাই লেয়ে, <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />আসা জাংয়ে, “ই দিংঙাহা ‘কা সেংজাকো দেমসাহিংয়া য়্যামসা সাসুংয়ুতা ন্যাসারাং ইহিংয়া লোপাকো ছুরো’ তায়ো।”<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />আত্রংহা টেবো পাউহা লোমসা ইশুহিংয়া জাংয়ে, “নাতিহা হাইরে মায়্যইকোগা? ই দিংঙাবিকো নাকো তোইতা বিরোধ জোওয়া গাওয়াইহা হাংগা?” <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />আদো ইশুহা চেকেপা য়ুংয়ে। টেবো পাউহা আকুহিংয়া জাংয়ে, “ঙাজ্যইং সেংজাকো মিংতা কা নাতিহিংয়া আজ্ঞা পিচারোওয়া, কাবিহিং জাং, নাতিহা সেংজাকো চেংওয়া খ্রীষ্টগা?”<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />ইশুহা আকুহিংয়া জাংয়ে, “নাতিরাং জাংপুয়ো। আদো কা নাতিহিংয়া জাংরোওয়া, নেহা ইসো য়ুতাহা নাবিহা দিংঙাকো চেংওয়াহিংয়া টেবো সে নিওয়া সেংজাকো দাংক্রেং কাটুতা গাওয়া, আসা লোডিংবাসো মুওয়াতা লেপাদাংওয়া তিরোওয়া।”<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />আত্রংহা টেবো পাউহা আপনিকো আংদুং ছিমসা জাংয়ে, “ইহা সেংজাকো তোইতা বিরোধ য়্যইয়ো। য়াংবিহিংয়া নেহা দোসরা প্রমানহা হাং ঘ্যইকোগা? নাবিহা নেকো ইকো সেংজাকো তোইতা বিরোধ য়্যইওয়াহা হিংমি নিও। <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />নেহা জাং, নাবিহা হাং নোংকা?”</para>
  <para style="p" vid="MAT 26:66">আবিহা জাংসুয়ে, “ইহা দোষিগা ইহা সিনেকো বেপারাং নিও।”<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />আত্রংহা আবিহা ইশুহিংয়া নামুতা তোতি তোতোমসা আকুহিংয়া গুসি টোয়ে, আসা লেরাহা এপা জাংমসা ত্যাচোংমসা জাংয়ে, <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />“ও খ্রীষ্ট, নেহা কাবিহিং অগমবাণী জাং! নাতিহিং দুওয়াহা হাংসুগা?”<verse eid="MAT 26:68" /></para>
  <para style="s">পত্রসহা ইশুহিং মানাইমি তাওয়া</para>
  <para style="r">(<ref loc="MRK 14:66-72">মর্কুস ১৪:৬৬-৭২</ref>; <ref loc="LUK 22:56-62">লুক ২২:৫৬-৬২</ref>; <ref loc="JHN 18:15-18">য়হুন্না ১৮:১৫-১৮</ref>,<ref loc="JHN 18:25-27">২৫-২৭</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />আত্রং চোইপা পত্রসহা বাইরে লাগাইতারাং গাদিংমি। ইচো ডেইয়ামুহা আকোতা লেমসা জাংয়ে, “নাতিরে গালীলতা য়ুংওয়া ইশুহিংপারাং নিমকোতা?”<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />আদো আকুহা তাংসাকো নাগাইতা মোকোমি তামসা জাংয়ে, “নাতিহা হাং জাংদিংমে, কা মোকোইনা।”<verse eid="MAT 26:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71" />আকুহা বাইরে লাঙাংকো লাপুং কাটুতা হোনুওয়া ইচো দোসরা ডেইয়ামুহা আকুহিং তিংমসা আউতা নিওয়া দিংঙাবিহিং জাংয়ে, “ই দিংঙারে নাসরতকো ইশুহিংপারাং নিমগা।”<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />পত্রসহা ন্যাসারাং নাপোইমসা জাংয়ে, “কা আকু দিংঙাহিংয়া মানাইমি।”<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />আকো আম্যই নোইতাহা আউতা নিওয়াবিরে পত্রসকো আবেইতা ওয়াংমসা জাংয়ে, “আজিপ্পারাং, নাতিরে আকুহিংপারাং নিমগা, হাংপাতানাহা নাকো য়্যইওয়াসোরাং নাতিহিংয়া নাইদিংয়ো।”<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />আসা ন্যাসারাং পত্রসহা আপনিহিং নাপোইমসা জাংয়ে, “কামি ল্যইপানাহা সেংজাকো সেংদ্রাংহা কুং তোইতা হুইকো, কাহা আকু দিংঙাহিংয়া মানাইমি।” এপা জাংওয়া কোকোইত্তা কেকা ওপুয়ে।<verse eid="MAT 26:74" /></para>
  <para style="p">
    <verse number="75" style="v" sid="MAT 26:75" />আত্রংহা পত্রসহা “কেকা ওয়ারোমা নাগাই নাতিহা কাহিং সুংকোই চোইপা মানাইমি তামসা ইশুকো জাংওয়া নুওয়াং প্যারাতাংয়ে।” আত্রংহা আকুহা বাইরে হ্যামসা মিতি জাজাপা কাইয়ে।<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">য়হুদা ইস্কোরিতিকো সিপুওয়া</para>
  <para style="r">(<ref loc="MRK 15:1">মর্কুস ১৫:১</ref>; <ref loc="LUK 23:1-2">লুক ২৩:১-২</ref>; <ref loc="JHN 18:28-32">য়হুন্না ১৮:২৮-৩২</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />হাপকুং হোহোইনুসো তাংসা মাটা পাউবি আসা দোসরা য়হুদি মাটা ওয়ারাংপাবিহা ইশুকো তোইতা বিরোধ জোসুমসা আকুহিংয়া স্যানেরোওয়া তামসা হুইসুয়ে। <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />আসা আবিহা আকুহিংয়া তাইপুমসা পুরায়ে, আসা টেবো কাইজি পিলাতসকোতা সায়ে।<verse eid="MAT 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />আত্রংহা ইশুহিং প্যইপাওয়া য়হুদাহা আকুহিংয়া স্যাপুরোওয়া তাওয়া নুওয়াং হিংনুওয়া পশ্চতাপ জোয়ে, আসা মাটা পাউবি আসা দোসরা য়হুদি মাটা ওয়ারাংপাবিহিং জাতাংকো ইকাইসো ত্যাচো টাংকা লাপপিয়ে, <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />আসা জাংয়ে, “কাহা ইচো দোষ মাতাওয়া দিংঙাহিং প্যইপামসা পাপ জোমি নিও।”</para>
  <para style="p" vid="MAT 27:4">আদো আবিহা জাংয়ে, “আকুহা কাবিহা মেগেরো! নাতি আপনিরাং গেচা।”<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />আত্রংহা য়হুদা ইস্কোরোতিহা আকু জাতাংকো টাংকাবিহা দেমসাতা বাডোইতেমসা হোপুয়ে, আসা আকুহা থ্যইচামসা সিপুয়ে।<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />আদো মাটা পাউবিহা আকু টাংকাবি য়োমসা জাংয়ে, “ই টাংকাহা দেমসাকো ন্যাস্যা এওয়াতা একোহা তাংজিকো লিংপাংহা মিচারোওয়া, হাংপাতানাহা ইহা দিংঙাহিং স্যাকো পিচাওয়া ন্যাস্যাগা।” <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />আবিহা আপনি লারাই হুইসুমসা আকু ন্যাস্যাসোহা কোইয়োংকো ওয়াংওয়াবি সিপুনু লিওয়া কুমালেকোতা<note caller="+" style="f"><char style="fr" closed="false">২৭:৭ </char><char style="ft" closed="false">কুমালে তাওয়াহা মোংটোকো জিয়োবি বানাইওয়াহিং জাংমগা।</char></note> মোংটো চোইয়ে। <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />আকো সোতা আকু মোংটোহিংয়া নেচোইপা য়ুতিকো মোংটো তামসা জাংমগা। <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />আত্রংহা অগমবক্তা য়র্মিয়াকো জাংওয়া নুওয়াংহা এপারাং তাংসা পুরা জিংয়ো,</para>
  <para style="q" vid="MAT 27:9">“ইস্রাইলকো দিংঙাবিহা আকু জায়গাহিং দাম জোওয়াহা জাতাংকো ইকাইসো ত্যাচো টাংকাসোগা, আকুহা আবিরাং পুচায়ো। <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />আসা সেংজাহা কাহিং খুইমি ত্যাবাপারাং কুমালেকো মোংটোকো সোতা আবিহা পিচায়ে।”<note caller="+" style="x"><char style="xo" closed="false">২৭:৯-১০ </char><char style="xt" closed="false"><ref loc="ZEC 11:12">জোকোরিয়া ১১:১২</ref>,<ref loc="ZEC 11:13">১৩</ref></char></note><verse eid="MAT 27:10" /></para>
  <para style="s">পিলাতসকো নাগাইতা ইশু</para>
  <para style="r">(<ref loc="MRK 15:2-15">মর্কুস ১৫:২-১৫</ref>; <ref loc="LUK 23:3-5">লুক ২৩:৩-৫</ref>,<ref loc="LUK 23:13-25">১৩-২৫</ref>; <ref loc="JHN 18:29-19:16">য়হুন্না ১৮:২৯–১৯:১৬</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />ইশুহা রোমি টেবো কাইজি পিলাতসকো নাগাইতা জায়ে, আসা কাইজিহা ইশুহিংয়া উইয়ে, “নাতিহা য়হুদিবিকো জাইপুগা?”</para>
  <para style="p" vid="MAT 27:11">ইশুহা জাংয়ে, “নাতিরাং এপা জাংদিংয়ো।”<verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />আত্রংহা মাটা পাউবি আসা লেরা য়হুদি মাটা ওয়ারাংপাবিহা আকো তোইতা দোষি তিংপায়ে, আদো আকুহা হাইরে মোয়্যইতো। <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />আত্রং পিলাতোসহা আকুহিংয়া জাংয়ে, “নাকো তোইতাহা আবিহা উইসে দোষ তিংপাদিংয়ো, নাতিহা হিংদিংগা?” <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />আদো ইশুহা আকুহিংয়া ইচো নুওয়াংকোরে জবাব মিচাতো। ই তিংমসা টেবো কাইজিহা সিওপারাং আআংপেপেচপুয়ে।<verse eid="MAT 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />য়হুদিবিহিং ল্যাপিওয়া মানক্যাতাহা উইসে দিংঙাবিকো ইচ্ছা জোওয়া সেই কাইজিহা ইচো কৈদিহিং ল্যাপি চাংওয়া লিংপাং নিমি। <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />আত্রংকো সময়তাহা বারাব্বা মিং নিওয়া ইচো চুসুং-মাইসুংক্যইওয়া কৈদি নিমি। <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />আকো সোতা দিংঙাবিহা আউতা জমা জিংয়ে, পিলাতসহা আবিহিং উইয়ে, “নাবিহা হাং ঘ্যইকোগা? কা নাবিকো সোতা হাংসুহিং ল্যাপিকোগা? বারাব্বাহিংগা না খ্রীষ্ট তাওয়া ইশুহিংগা?” <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />হাংপাতানাহা আবিহা ইশুহিং মিচিমসারাং স্যইপুমগা তামসা পিলাতোসহা গেমি নিমি।<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />ন্যায় জোওয়া গাদিংতা গাদিংনুরাং আকো মেহা এপা জাংমসা দেরেং কাইপুয়ে, “আকু দোষ মাতাওয়া দিংঙাহিংয়া হাইরে মোজোগ্যই, হাংপাতানাহা হিনি লিসুং মাংবুইওয়াতাহা আকো সোতা কা সিওপারাং দুঃখ মুংমি নিও।”<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />আদো মাটা পাউবি আসা দোসরা য়হুদি মাটা ওয়ারাংপাবিহা “বারব্বাহিং ল্যামসা ইশুহিং স্যাকো” তামসা দিংঙাবিহিং দুদুইপায়ে।<verse eid="MAT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21" />পিলাতসহা ন্যাসারাং আবিহিং উইয়ে, “ই নিহসোতাহা হানিহিং কা নাবিকো সোতা ল্যাপিকোগা তামসা নাবিহা ইচ্ছা জোদিংগা?”</para>
  <para style="p" vid="MAT 27:21">আবিহা “বারব্বাহিং ল্যাপি” তামসা জাংসুয়ে।<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />পিলাতোসহা আবিহিংয়া জাংয়ে, “এপা বেনাহা খ্রীষ্ট তাওয়া ইশুহিংয়া কা হাং জোকোগা?”</para>
  <para style="p" vid="MAT 27:22">আবি তাংসা জাংসুয়ে, “আকুহিংয়া ক্রুসতা টাপুই।” <verse eid="MAT 27:22" /><verse number="23" style="v" sid="MAT 27:23" />পিলাতসহা জাংয়ে, “হাংপাসাহা? আকুহা হাং মাতুপা জোপুমি নিংগা?”</para>
  <para style="p" vid="MAT 27:23">আদো আবিহা ন্যাসারাং সিওপা ঙাসুমসা জাংসুয়ে, “আকুহিংয়া ক্রুসতা টাপুই।”<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />আদো হাই জোদো মাতুমসা ন্যাসারাং সিওপা চেচোওয়াইপা জিংপুকোদোওয়া তাওয়া নোমসা পিলাতসহা উইসে দিংঙাবিকো নাগাইতা আপনিকো খুই দুমসা জাংয়ে, “নাবি আপনিবিরাং গেচা, ই দিংঙাহিং স্যাওয়াতাহা কাহিং পাপ মাজিংকো।”<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />তাংসা দিংঙাবিহা জাংসুয়ে, “আকো পাপহা কাবি আসা কাবিকো চেংচুংবিকো তোইতা হুইকো।”<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />আত্রংহা পিলাতসহা আবিকো সোতা বারব্বাহিং ল্যাপিয়ে, আদো ইশুহিংয়া সাটাসো ডুমসা ক্রুসতা স্যাকো তামসা রোমি সিপাইবিকোতা স্যইপুয়ে।<verse eid="MAT 27:26" /></para>
  <para style="s">সিপাইবিহা ইশুহিং মিচিপা জোওয়া</para>
  <para style="r">(<ref loc="MRK 15:16-20">মর্কুস ১৫:১৬-২০</ref>; <ref loc="JHN 19:2-3">য়হুন্না ১৯:২-৩</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />আকো নোইতাহা কাইজি পিলাতসকো সিপাইবিহা ইশুহিংয়া টেবো সাকো নাপোতা পুরায়ে, আসা তাংসা সিপাইবিহিং আউতা জমা জোয়ে। <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />আবিহা ইশুকো আংদুং জুপাসো লুমসা আকুহিংয়া জাইপুকো লুওয়া বেওয়া অ্যালুইওয়া আংদুং লুপায়ে। <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />আবিহা সোসাকো ফেটা ফিমসা আকো পোরোতা লুপায়ে, আসা আকো দাংক্রেং খুইতা দ্যই পিচায়ে, আসা আকো নাগাইতা চুনুইমসা আকুহিংয়া এপা জাংমসা ল্যইস্যইপায়ে, “য়হুদিবিকো জাইপুকো মিং টেবো জিংকো।” <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />আকো নোইতাহা আবিহা আকুহিংয়া তোতি তোতোয়ে, আসা দ্যই গিংমসা আকো পোরোতা পোউয়ে। <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />আবিহা আকুহিংয়া লেফেপাপুনতেনুকো নোইতাহা আকুহিং লুপাওয়া অ্যালুইওয়া আংদুংহা লুউসুয়ে, আসা আকো আপনিকো আংদুং লুউপামসা আকুহিংয়া ক্রুসতা স্যাকো পুরায়ে।<verse eid="MAT 27:31" /></para>
  <para style="s">ইশুহিং ক্রুসতা থ্যইপুওয়া</para>
  <para style="r">(<ref loc="MRK 15:21-32">মর্কুস ১৫:২১-৩২</ref>; <ref loc="LUK 23:26-43">লুক ২৩:২৬-৪৩</ref>; <ref loc="JHN 19:17-27">য়হুন্না ১৯:১৭-২৭</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />ন্যাতাসো হ্যাদিংনুওয়া আবিহা সিমোন মিং নিওয়া কুরেনি শহরকো ইচো দিংঙাহিং দোসুয়ে, আসা আবিহা আকুহিংয়া তোতোউসি ইশুকো ক্রুস পুউপায়ে। <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />আসা হাত্রং আবি গলগাথা তাওয়া জায়গাতা দেকা, (গলগাথা তাওয়াহা পোরোকো লুইটো জায়গা তামগা)। <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />আসা আবিহা আকুহিংয়া চিইনি লাসিওয়া কাক্যইওয়া আংগুরকো য়ু পেয়াংয়ে, আদো আকুহা অ্যাইসি আংমসা আংকো মেকেংতো।<verse eid="MAT 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35" />আবিহা আকুহিংয়া ক্রুসতা টাপুনতেনুওয়া, আবিহা আকো আংদুংহা পোসুকো সোতা চিঠা বাডোইসুয়ে। <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />আসা আবিহা আউতারাং য়ুংসুমসা ইশুহিং খুইসুয়ে। <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />আসা আবিহা “ই ইশুহা য়হুদিবিকো জাইপুগা” তামসা লাওয়া দোষহা আকো পোরোকো তোইতা তেপায়ে। <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />আকুহিংপাহা নিহসো কুইমবিহিংনে ক্রুসতা থ্যইওয়া নিমি, ইচোহিংয়া কেকেরেং কাটুতা আসা ইচোহিংয়া দাংক্রেং কাটুতা। <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />আউসো হ্যাওয়া ওয়াংওয়াবিরে আপনি আপনিকো পোরো য়াপামসা আকুহিং ল্যইস্যইপামসা জাংয়ে, <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />“ও দেমসা য়্যাপুওয়া আসা সাসুংয়ুতা লোপাপুওয়া, আপনিহিং বাচাই, আসা সেংজাকো চেংওয়া বেনাহা, ক্রুসসো উইপামসা লেই।”<verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />মাটা পাউবি, তাংজিকো উটকেওয়াবি আসা দোসরা য়হুদি মাটা ওয়ারাংপাবিরে ইশুহিং ল্যইস্যইপামসা জাংয়ে, <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />“ইহা দোসরাহিংয়া বাচাইয়ে, আদো আপনিহিংয়া বাচাইক্যইতো। ইহা ইস্রাইলকো জাইপু বেনাহা নেহা ক্রুসসো লিতা ঊইপামসা লেকো, আসা কাবি ইহিংয়া দেংরোওয়া। <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />ইহা সেংজাহিংয়া দেংমগা, আসা ‘কাহা সেংজাকো চেংওয়াগা’ তামসা জাংমগা। সেংজামি ইহিং বাচাইকো কেংনাহা আকুরাং ইহিংহা বাচাইপিকো।” <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />এপা জোমসারাং আকুহিংপা থ্যইপুওয়া কুইমবিরে আকুহিংয়া ল্যইস্যইপায়ে।<verse eid="MAT 27:44" /></para>
  <para style="s">ইশুকো সিপুওয়া</para>
  <para style="r">(<ref loc="MRK 15:33-41">মর্কুস ১৫:৩৩-৪১</ref>; <ref loc="LUK 23:44-49">লুক ২৩:৪৪-৪৯</ref>; <ref loc="JHN 19:28-30">য়হুন্না ১৯:২৮-৩০</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />জেইসুং বারো বাজিসোহা তিন বাজি চোইপা তাংসা লোইবিতা নাটুংপা জিংপুয়ে। <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />তিন বোজেগাংনুওয়া ইশুহা সাডিংপা এপা জাংমসা ঙায়ে, “ইলোই, ইলোই, লামা সবখথানি?” ই জাংওয়াহা, “ও কুং সেংজা, ও কুং সেংজা, নাতিহা কাহিয়া হাংপা পেইপুমগা?”<verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />আউতা জাসুংদিংবিতাহা লেরাহা ই হিংমসা জাংয়ে, “ই দিংঙাহা এলিয়াহিং মোউদিংয়ো।”<verse eid="MAT 27:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 27:48" />আবিকো প্যাকোসো ইচো দিংঙাহা তাত্রিংপা ঠুইপুমসা য়্যাক্যইওয়া য়ুতা গ্যরোই ভুয়ায়ে, আসা দ্যইতা কেপামসা ইশুহিং পেয়োংকো পিচায়ে। <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />আদো লেরাহা জাংসুয়ে, “কাংরো, মেনা এলিয়া ইহিং বাচাইকো ওয়াংকোমে?”<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />আত্রংহা ইশুহা ন্যাসারাং সিদিংপা ঙায়ে আসা আপনিকো সাদি ল্যাপুয়ে।<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />আত্রংরাং দেমসাকো নাপোকো পর্দাহা তোইসোহা লিতা চোইপা নুইওয়্যা জিংপুমসা ছিচপুয়ে, আসা নিংঙা হ্যায়ে, আসা টেরবো পাত্যারুংবিরে ওয়্যাপুয়ে। <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />তোম্যইবি ওয়েচপুয়ে, আসা সিপুনতেওয়া উইসে সেংজাকো পবিত্র দিংঙাবিকো সিপুওয়া জুপাবিহা ঙারোয়ে। <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />ইশু সিওয়াসো ঙারোনতেনুকো নোইতা আবিহা আপনি আপনিকো তোম্যইসো নোসুয়ে, আসা আবিহা পবিত্র শহরতা হোয়ে আসা উইসে দিংঙাবিকোতা তিংয়ায়ে।<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />হাত্রং কেপ্টেইন আসা আকুহিংপা ইশুহিং খুইদিংওয়াবি নিংঙা হ্যাওয়া আসা আউতা হাই জিংপুওয়াবি তিং, আত্রংহা আবিহা চুসুংপুমসা এপা জাংয়ে, “আজিপ্পারাং, ইহা সেংজাকো চেংওয়ারাং গুং।”<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />উইসে মেমে দিংঙাবিরে তানাংসো জামসা ন্যইসুদিংওয়া নিমি। আবিহা গালীলসোরাং ইশুহিং য়ুজ্রুমসা আকো নুনুই হুইপাওয়া নিমি। <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />আবিকো প্যাকোতা মরিয়োম মগ্দলিনি, য়াকুব আসা য়োসেপকো আয়ু মরিয়োম, আসা জোব্দিকো নিহসো চেংওয়াবিকো আয়ু নিমি।<verse eid="MAT 27:56" /></para>
  <para style="s">ইশুহিং লিপুওয়া</para>
  <para style="r">(<ref loc="MRK 15:42-47">মর্কুস ১৫:৪২-৪৭</ref>; <ref loc="LUK 23:50-56">লুক ২৩:৫০-৫৬</ref>; <ref loc="JHN 19:38-42">য়হুন্না ১৯:৩৮-৪২</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />জিরোং জিংপুনুওয়া আরিমাথিয়া শহরকো য়োসেব মিং নিওয়া ইচো পুপুউ দিংঙা লেয়ে। আকুহা আপনিরে ইশুকো য়োংতোং নিমি। <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />আকুহা পিলাতসকোতা হোমসা ইশুকো সিপুওয়া জুপা য়াকায়ে, আসা পিলাতসহা ইশুকো জুপাহা আকুহিং পিচাকো তামসা আজ্ঞা জোয়ে। <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />য়োসেবহা ইশুকো সিপুওয়া জুপা পুমসা এনতাওয়া সুতিকো আংদুংসো লোইংয়ে, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />আসা আকুহা টেবো পাত্যারুংহিং হোংপামসা বানাইওয়া চুবে তোম্যইতা ইশুকো সিপুওয়া জুপা এহে, আসা তোম্যইকো হোংরোংবাহিংয়া টেবো লুংটুইসো মেইপুইয়ে, আসা আকুহা হোপুইয়ে। <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />তোম্যইকো আবেইতাহা মরিয়োম মগ্দলিনি আসা দোসরা মরিয়োমরে গাদিংওয়া নিমি।<verse eid="MAT 27:61" /></para>
  <para style="s">তাম্যইহিং কুইওয়াবি</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />আকো জুকুংহা সানুকো দিনতা মাটা পাউবি আসা ফরিসিবিহা পিলাতসকোতা জমা জিংমসা জাংয়ে, <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />“উটকেওয়া কাবিহা গেদিংমি নিয়ো, আকু ল্যহইপেহা মাসিয়াংনুহা ‘কা সিমসা ন্যাসারাং সাসুংয়ুতা ঙারোরোওয়া’ তামসা জাংচাংমগা। <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />আকো সোতা সাসুংয়ু চোইপা তাম্যইহিং খুইকো তামসা আজ্ঞা জোপি, মোকোনাহা আকো য়োংতোংবিহা লেমসা আকো জুপাহা কুমসা পুচারোওয়া, আসা ‘আকুহা সিপুওয়াসো ঙারোয়ে’ তামসা দিংঙাবিহিং জাংরোওয়া, আসা আকু ল্যইপাওয়াহা নোইকো ধোকাহা নাগাইকোরোমা মেংতাপা জিংরোওয়া।”<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />এপা জিংনুওয়া পিলাতসহা আবিহিংয়া জাংয়ে, “নাবিহা আপনিবিরাং সিপাইবিহিং পুরামসা ছুওয়া সেই তাম্যইহিং খুইপা।” <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />আত্রংহা আবিহা হোমসা তাম্যইহিং জগায়মসা একো তাম্যইকো হোংরোংবাহিং মেইওয়া লুংটুইতা নাইরেপাতেয়ে আসা সিপাইবিহিং খুইপায়ে।<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">ইশুহা সিপুওয়াসো ঙারোওয়া</para>
  <para style="r">(<ref loc="MRK 16:1-11">মর্কুস ১৬:১-১১</ref>; <ref loc="LUK 24:1-12">লুক ২৪:১-১২</ref>; <ref loc="JHN 20:1-18">য়হুন্না ২০:১-১৮</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />সানুকো দিনকো নোইতা আইতাবারে হাপকুং হোহোইনুওয়া মরিয়োম মগ্দলিনি আসা দোসরা মরিয়োমহা ইশুহিং এওয়া তাম্যই কাংকো ওয়াংয়ে।<verse eid="MAT 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2" />আত্রংহা টেবো নিংঙা হ্যায়ে, হাংপাতানাহা সেংজাকো ইচো পোইং লোডিংবাসো লিতা উইয়ে, আসা লেমসা লুংটুই ওয়েংপামসা আকু লুংটুইকো তোইতা গায়ে। <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />আকো য়ুওয়াইহা তাত্রাইওয়া ত্যাবাপা আসা আংদুংহা কাওয়া ত্যাবাপা হাংপাপা নিমি। <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />আকোসো চুসুংপুমসা আকু তোম্যই খুইওয়া দিংঙাবিহা ফিপুয়ে, আসা সিপুমবেপা জিংপুয়ে।<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />আদো লোডিংবাকো পোইংহা আকু মেমেবিহিংয়া জাংয়ে, “নাবিহা মাচ্ছুংগে, হাংপাতানাহা কাহা গেমি নিও, নাবিহা ক্রুসতা থ্যইমসা স্যাপুওয়া ইশুহিং মোদিংয়ো। <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />আকুহা ইতা মোতো, হাংপাতানাহা আকো জাংওয়া সেই আকুহা ঙারোনতেমি নিও। লেই, আকুহিং এওয়া জায়গা কাং। <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />আসা সেন্নেপা হোমসা আকো য়োংতোংবিহিং, ‘প্রভুহা সিপুওয়াসো ঙারোনতেমি নিও। আকুহা নাবিরোমা নাগাই গালীলতা হোদাংয়ে, আউতাহা নাবিহা আকুহিংয়া তিংরোওয়া’ তামসা দেরেং জাংপি! নেহা হোতু, কাহা নাবিহিংয়া জাংপুনতেমি নিও।”<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />আত্রংহা আবিহা চুসুংকোরে চুসুংপুয়ে আসা সিওপারাং গাগ্রুপুমসা সেন্নেপা তোম্যইসো নোপুমসা য়োংতোংবিহিং ই দেরেং হিংপাকো ঠুইপুয়ে।<verse eid="MAT 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 28:9" />ইশুহা আবিহিংপা একবিরি দোসুমসা জাংয়ে, “নাবিহিং তিমেপা জিংকো!” আত্রংহা আবিহা চুনুইসুমসা আকো কোকোইত্তা চুংসুমসা নোংসুয়ে। <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />আত্রংহা ইশুহা আবিহিং জাংয়ে, “মাচ্ছুংগে, কুং এবিহিং হোমসা গালীলতা হোকো জাংয়াপি, আসা আউতাহা আবিহা কাহিং তিংরোওয়া।”<verse eid="MAT 28:10" /></para>
  <para style="s">তোম্যই খুইমবিকো দেরেং</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />হাত্রং আকু মেমেবি ন্যাতাতা নিমে, আত্রংহা লেরা তোম্যই খুইমবিহা শহরতা হোমসা মাটা পাউবিহিং আউতা হাই জিংপু আকু দেরেংবি হিংপায়ে। <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />আত্রংহা মাটা পাউবি, আসা দোসরা য়হুদি মাটা ওয়ারাংপাবিহা চাংসুমসা “নেহা য়াংবিহা হাং জোকোগা?” তামসা আবিহা হুইসুয়ে আসা আবিহা সিপাইবিহিং সিওপা ন্যাস্যা পিচামসা <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />“নাবিহা ‘লিসুং কাবি জিংজুনুকো নোইতা ইশুকো য়োংতোংবি ওয়াংমসা আকো সিপুওয়া জুপা কুচপুমসা পুচায়ে’ তামসা জাংকো তামসা জাংয়ে। <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />রোমি টেবো কাইজিমি ই নুওয়াং হিংনাহা কাবি আকুহিংপা য়্যইসুমসা নাবিহিংয়া বাচাইপিরোওয়া।” <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />আকু তোম্যই খুইমবিহা ন্যাস্যা য়ুচামসা মাটা পাউবিকো ঝিপামবেপা জাংসুয়ে। ই নুওয়াংহা নেচোইপা য়হুদিবিকো প্যাকোতাহা বেইদিংমি নিও।<verse eid="MAT 28:15" /></para>
  <para style="s">ইশুহা য়োংতোংবিকোতা তিংরেওয়া।</para>
  <para style="r">(<ref loc="MRK 16:14-18">মর্কুস ১৬:১৪-১৮</ref>; <ref loc="LUK 24:36-49">লুক ২৪:৩৬-৪৯</ref>; <ref loc="JHN 20:19-23">য়হুন্না ২০:১৯-২৩</ref>; <ref loc="ACT 1:6-8">প্রেরিত ১:৬-৮</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />এগারচো য়োংতোংবিহা ইশুকো জাংতেওয়া গালীল জায়গাকো য়্যাগ্যইতা হোসুয়ে। <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />ইশুহিং তিংতানি আবিহা আকো নাগাই চুনুইসুহে। আদো লেরা য়োংতোংবিহিংয়া ইশুরাং কোমমে-মোকোমমে তাওয়া সন্দেহ জিংপুয়ে। <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />আত্রংহা ইশু আবিকো আবেইতা লেমসা জাংয়ে, “লোডিংবাসো বাসিমতিকো তাংসা অধিকার কাহিং পিচামি নিও। <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />নেহা নাবিহা হোমসা তাংসা জ্যাকো দিংঙাবিহিং কুং য়োংতোং বানাই। আবিহিং আপা, চেংওয়া আসা পবিত্র লাংবেকো মিংতা বাপ্তিস্মা পিচা। <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />কুং নাবিহিং আজ্ঞা জোওয়া তাংসা হিংমসা পালন জোকো আবিহিং ঝিপাতু। কাং, কা হাত্রংদো বাসিমতিকো নোইস্যাকো দিন চোইপা নাবিহিংপারাং নিরোওয়া।”<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>