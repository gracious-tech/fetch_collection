<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="NEH" style="id">- Siwu Old Testament</book>
  <para style="h">NEXEMIA</para>
  <para style="toc1">Nexemia Ɔko</para>
  <para style="toc2">Nex</para>
  <para style="toc3">Ne</para>
  <para style="mt1">NEXEMIA</para>
  <para style="mt2">ƆKO</para>
  <para style="imt">ATƆ̃MEƉEAKATƆ̃</para>
  <para style="im">Maawo <char style="bk">Nexemia Ɔko</char> ɔɣɛ ɔpia kusɛ kuna ame:</para>
  <para style="ip">(1) Nexemia ikpese iba Yerusalem, ngbegɔ i Persia igara ɔsese wũ sɔ ɔsɛ ɔ̃aɖe Yuda karɔ̃ nyɔisose.</para>
  <para style="ip">(2) Yerusalem abere iledza itsue.</para>
  <para style="ip">(3) Kumɛgɔ i Ezra ɔka Ɣaa mmara fiɛ maturi ɔɖi ma akpi maɣɛ.</para>
  <para style="ip">(4) Ara mama wa i Nexemia ɔbara lɛ Yuda nyɔisose awe.</para>
  <para style="ip">Nnɛ lobɔrɛ kayi kukaakɔ i ɔko ame nɖe kumɛgɔ i Nexemia ɔsiaiti i Ɣaa iso pelepele, i irabiara ame gu ngbɔ ɔsɛ ɔkparamakayi ɔtã wũ malamala ame.</para>
  <para style="iot">Ɔko ame atɔ̃medziri</para>
  <para style="io1">Nexemia ɔkpese ɔba Yerusalem <char style="ior">1.1-2.20</char></para>
  <para style="io1">Maledza Yerusalem abere itsue <char style="ior">3.1-7.73</char></para>
  <para style="io1">Maka mmara fiɛ maledza ndamu ibara miɣɛtɛ <char style="ior">8.1-10.39</char></para>
  <para style="io1">Ara mama awɛ̃ wa i Nexemia ɔbara. <char style="ior">11.1-13.31</char></para>
  <chapter number="1" style="c" sid="NEH 1" />
  <para style="s1">Nexemia Kayiikparama</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 1:1" />Nexemia, Xakalia ɔbibirɛrɛĩ atɔ̃me i ngbe ne.</para>
  <para style="b" vid="NEH 1:1" />
  <para style="p" vid="NEH 1:1">Iyi iwɛ̃ i Kislev wɔ nɖe ma Hebrise kuwa kaiwɛ̃va ame i ikɔ sinyɔva ame ne, lowe i Susa. <verse eid="NEH 1:1" /><verse number="2" style="v" sid="NEH 1:2" />Xanani, wũ ɔnyibirɛrɛĩ ɔwɛ̃ ku marɛrɛ̃ mama ɔbɔrɛ i Yuda maba. Ne lokarɛ ma atɔ̃me i ma Yudase ma lotere maikɛlɛ kafɔrɔ̃ ame fiɛ lokarɛ ara i Yerusalem iso ana.<verse eid="NEH 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NEH 1:3" />Maɣere me sɔ, "Ma Yudase ma lotere i sisande ame fiɛ makpese maba ibuiti karɔ̃ ame ne, ma ngbã ɖe inyɛwe gu kunuarɛ gbaã. Yerusalem abere ɔɔbiɛ fiɛ ɔtɔ ɔɔtsuedza ɔmagɛ̃ kuyogodɔ̃."<verse eid="NEH 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 1:4" />Gɔ lonɔ atɔ̃me wagbe ne, lokpase losɛ i karɔ̃ lobiɛ kaku. Lomararã so ayi awɛ̃, lonyikanya gu kayiikparama lotã kato Ɣaa. <verse eid="NEH 1:4" /><verse number="5" style="v" sid="NEH 1:5" />Kere ne loɣɛ sɔ,</para>
  <para style="pm" vid="NEH 1:5">"O, <char style="nd">Bosate</char>, kato Ɣaa, ɔsiare gu Ɣaa wɔ nɖe ifɔ̃ra. Nwɔ nsɛ ɔmɔɛ̃ ɔ̃ kuɖɔɛ ndamu ɔla ku mma nsɛ maɖɔɛ wũ fiɛ masɛ mawarɛ ɔ̃ mmara. <verse eid="NEH 1:5" /><verse number="6" style="v" sid="NEH 1:6" />Kã atsue, si abusi fɔ anɔmi anyɔ si anɔ fɔ ɔɖabo kayiikparama kasɛ̃ gu anɔwã i fɔ anɔ, i fɔ maɖabo Israel maturi iti. Nto loɖi bo Israel kaɖe akpi wa bobara i fɔ iso loɣere-ɔ. Wũ mɔmɔ gu wũ mawa pelepele ɔbara ikpi i fɔ iso. <verse eid="NEH 1:6" /><verse number="7" style="v" sid="NEH 1:7" />Bobara ɔtile i fɔ iso gbaã. Boibara i fɔ mmaraisi, asɛ̃ra gu mmara ara wa atã bo iki i fɔ ɔɖabo Mose iso.<verse eid="NEH 1:7" /></para>
  <para style="pm">
    <verse number="8" style="v" sid="NEH 1:8" />"Nyigi asɛra wa aɣere fɔ ɔɖabo Mose. Aɣere wũ sɔ, 'Si miiɖe ɔnukuare ne, loasamera mi lopia i nɖebi ame. <verse eid="NEH 1:8" /><verse number="9" style="v" sid="NEH 1:9" />Ɣɛɛ si mifiriki miba i wũ kɔrɛ fiɛ mimɔɛ̃ wũ mmara mila ne, si ta karɔ̃ kawirikɔ̃ mamɔɛ̃ fɔ maturi lɛ mafɔrɔĩ makɛlɛgu dzoroo, i kuɖokpo kayirinɔ kɔraa ne, loasa ma kanya lobɔrɛgu i mmɔ, lobɔ i ngbegɔ loɖi lɛ wũ Iyere kawekɔ̃.'<verse eid="NEH 1:9" /></para>
  <para style="pm">
    <verse number="10" style="v" sid="NEH 1:10" />"Fɔ maɖabo gu fɔ maturi maɖe; mma aɖigu fɔ ɔle siare gu kɔrɔ̃ teteree. <verse eid="NEH 1:10" /><verse number="11" style="v" sid="NEH 1:11" />O, Sate, kã fɔ ɔɖabo wɔgbe kayiikparama atsue. Kã fɔ maɖabo mama ma nsɛ mana isoɣɔ i kuwarɛ ipia fɔ iyere iso atsue. Tã fɔ ɔɖabo isaruɛ nɔme i kumɛgɔ aanyɔ wũ nnya i igara wɔgbe anɔ."</para>
  <para style="p" vid="NEH 1:11">Mme loɖe igara ndãkadze ku ɔwi wɔmɔ ame.<verse eid="NEH 1:11" /></para>
  <chapter eid="NEH 1" />
  <chapter number="2" style="c" sid="NEH 2" />
  <para style="s1">Nexemia Ɔkɛlɛ Yerusalem</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 2:1" />Ɔwi ɔwɛ̃ i Nisan<note caller="+" style="f"><char style="fr" closed="false">2.1 </char><char style="ft" closed="false">Nisan: Iɖe ma Babilonse gu ma Hebrise kuwa ɖeakatɔ̃, kɔ̃ ame nɖe Abib i ma Hebrise awa ame gɔ Abib ɖe ma Kanaanse iyere.</char></note> kuwa i Artaxsasta sigara ɔɖewi ikɔ sinyɔva ame ne, gɔ mabɔ ndã ne, mme losu fiɛ losɔrɛ̃ me lotã igara. Loikpo so i ɔ̃ anɔmi ame lonya fiɛ. <verse eid="NEH 2:1" /><verse number="2" style="v" sid="NEH 2:2" />Ne ɔso igara ɔkarɛ me sɔ, "Be lotã anyɔ kpaã i anɔ gɔ aito anyɛ? Nnɛgbe iiɖe kuira, ɣɛɛ ato amararã so i ɔtu ame."</para>
  <para style="p" vid="NEH 2:2">Lonigã gbaã, <verse eid="NEH 2:2" /><verse number="3" style="v" sid="NEH 2:3" />ɣɛɛ loɣere igara sɔ, "Igara si ɔsɛ ngbã ɔwi daaro! Ɔmagɛ̃ wɔ ame mabiara wũ mawa ɔɔkpese ikpakpi, fiɛ ɔtɔ ana ɔtsuedza ɔmagɛ̃ kuyogodɔ̃. Be ɔso fiɛ loibakpo so ku anɔ?"<verse eid="NEH 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 2:4" />Igara ɔkarɛ me sɔ, "Be ato abie sɔ lobara lotã-ɔ?"</para>
  <para style="p" vid="NEH 2:4">Kere ne lokparamakayi lotã kato Ɣaa, <verse eid="NEH 2:4" /><verse number="5" style="v" sid="NEH 2:5" />ne lotã igara mmuai sɔ, "Si iɖe igara kuɖɔɛ fiɛ fɔ ɔɖabo ara ɔbo-ɔ anɔ ne, iyɔ tã ɔsese me i ɔmagɛ̃siare ame i Yuda, si losɛ loaledza ngbegɔ mabiara wũ mawa, iɖaɛ."<verse eid="NEH 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 2:6" />Gɔ i igararɔ̃go si i igara kɔrɛ ne ɔkarɛ me sɔ, "Ayi arɛ̃ aasu asɛ ɔri? Si asɛ ne, iɖe ɔwi wɔ ame aakpese aba?" Iɖe igara kuɖɔɛ sɔ ɔ̃asese me ne losɛ ɔwi ne.<verse eid="NEH 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NEH 2:7" />Loɣere wũ ana sɔ, "Si iɖe igara kuɖɔɛ ne, tã matsɛrɛ siko mapia me i kɔrɔ̃ si lokɛlɛgu Frat kuɣɛ̃kabokɔ̃ Ibuiti ame manyoisose, si maatã me ɔri loki i ma karɔ̃ ame lokɛlɛ Yuda. <verse eid="NEH 2:7" /><verse number="8" style="v" sid="NEH 2:8" />Lokarɛ ɔko wɔ loala lokɛlɛgu Asaf, igara ipo nyɔisose ana, si ɔ̃atã me adziri losu lowe kuyogodɔ̃ sitsue, lotã ɔlekasɛkɔ̃ ga mpia i isɔrɛyo kɔrɛ gu ɔmagɛ̃siare abere gu iyo nɛ ame loawe." Igara ɔtɔrã ɔsia i nwa lokarɛ iso, alasɔ wũ Ɣaa abualɛ kɔrɔ̃ ɔsia me iso ɔso. <verse eid="NEH 2:8" /><verse number="9" style="v" sid="NEH 2:9" />Ne ɔso loso ɔri lokɛlɛ Frat kuɣɛ̃kabokɔ̃ Ibuiti manyoisose kɔrɛ, losu igara siko lotã ma. Igara ɔɔsese me makpakpɛ̃dze makpakpa mawɛ̃ gu pɔngɔmakpakpɛ̃dze mawɛ̃ makɛlɛgu me ana.<verse eid="NEH 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 2:10" />Ɔwi wɔ i Sanbalat, Xoronse gu ɔ̃ buaidze Tobia wɔ nɖe Amon ɔkpakpa ɔnɔ nnɛgbe ne, ikpɛ̃ ma sikpã sɔ ɔturi ɔɔba ɔto ɔ̃abara isɛɛ ɔtã Israel mabi.<verse eid="NEH 2:10" /></para>
  <para style="s1">Nexemia Ɔsɛ Ɔ̃anyɔ Yerusalem Ibere</para>
  <para style="p">
    <verse number="11" style="v" sid="NEH 2:11" />Lorui lokɛlɛ Yerusalem, gɔ lowe i mmɔ ayi atɛ kama ne, <verse eid="NEH 2:11" /><verse number="12" style="v" sid="NEH 2:12" />iyi tɛare ku kasɛ̃ ame ne loɣo ɔri ku marɛrɛ̃ mawɛ̃. Loiɣere kuwɛ̃ ira nɛ i wũ Ɣaa ɔsu ɔsia i wũ ɔtu iso sɔ lobara lotã Yerusalem. Mabɔi kumawɛ̃ iiwe iɖo nwɔ iso loto losɛ.<verse eid="NEH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NEH 2:13" />Kasɛ̃ gamɔ ne loki i Kagbolomi Kayogodɔ̃ kanya losɛ loabo i Iboroi Ibiɔ kɔrɛ, losɛ katɔ̃ losɛ loabo i Aku Kayogodɔ̃ kɔrɛ. Gɔ lokiki ne, lonyɔ Yerusalem abere wa mabiɛ mafere i karɔ̃ gu kuyogodɔ̃ gɔ i ɔtɔ ɔtsuedza losɛ ikpo. <verse eid="NEH 2:13" /><verse number="14" style="v" sid="NEH 2:14" />Kere ne losɛ lokɛlɛ katɔ̃ lobo i Ibiɔ Kayogodɔ̃ gu i Igara Iba kɔrɛ, ɣɛɛ kukakɔi siina i abereku ndɛ̃ gɔ wũ bɔi aawo ɔki. <verse eid="NEH 2:14" /><verse number="15" style="v" sid="NEH 2:15" />Ne ɔso loya loki kagbolomi ame ku kasɛ̃, lola loɔnyɔ ibere kukaakɔ. Katsɔrakɔ̃ ne, lopɛ lofiriki lokpese losɛ loaki i Kagbolomi Kayogodɔ̃ kanya fiɛ lobo i ɔmagɛ̃siare ame. <verse eid="NEH 2:15" /><verse number="16" style="v" sid="NEH 2:16" />Makpakpa iiɣe ngbegɔ lokɛlɛ ɣee nnɛ losɛ nto lobara, alasɔ ipɛ ɔwi wɔmɔ ne, loiɣere ma Yudase ɣee masɔrɛdze ɣee makpakpaturi ɣee maturi mama ma loabara karabara ndɛ̃ kuwɛ̃ kuira tɔtɔ.<verse eid="NEH 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NEH 2:17" />Kere ne ka loɣere ma sɔ, "Minyɔ kumɛgɔ bopia i kukpakpi ame, gɔ Yerusalem ɔɔkpese ikpakpi fiɛ ɔtɔ ɔɔtsuedza ɔ̃ kuyogodɔ̃. Miba, si boledza Yerusalem abere itsue si boisibawe i kunuarɛ siare ame." <verse eid="NEH 2:17" /><verse number="18" style="v" sid="NEH 2:18" />Loɣere ma kumɛgɔ i Ɣaa abualɛra piagu me, gu nnɛ i igara ɔ̃ɔɣere me ana.</para>
  <para style="p" vid="NEH 2:18">Matã mmuai sɔ, "Mitã botsɛ ibere iledza itsue." Ne ɔso masɛ karabara sɛɛ gagbe karɔ̃.<verse eid="NEH 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NEH 2:19" />Ɣɛɛ gɔ Sanbalat Xoronse, gu Tobia wɔ nɖe Amon ɔkpakpa gu Arabse wɔ marɔ sɔ Gesem ɔnɔ itɔ̃me nɛgbe ne, mabara bo aɣiãra fiɛ mama bo. Makarɛ bo sɔ, "Be iɖe mito mibara?" Ɔta mito mita miya i igara iso?"<verse eid="NEH 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NEH 2:20" />Lotã ma mmuai sɔ, "Kato Ɣaa to ɔ̃atã bo isaruɛ. Bo ɔ̃ maɖabo aata boledza ibere itsue. Ɣɛɛ mi ne, mina kuira nɛ miate i Yerusalem ame kiniɔ sɔ iɖe mi ire fiɛ kuira na maasu manyigi mi lɛ mi kaɖekɔ̃ i ne ame."<verse eid="NEH 2:20" /></para>
  <chapter eid="NEH 2" />
  <chapter number="3" style="c" sid="NEH 3" />
  <para style="s1">Maledza Yerusalem Ibere Itsue</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 3:1" />Eliasib wɔ nɖe sɔrɛdzekpakpa pelepele gu ɔ̃ masɔrɛdzelaa ɔta masɛ maabara karabara maledza Sɛrɛrerɔ̃ Kayogodɔ̃ itsue. Masekelera kã fiɛ ka mapia akui i wã kasɛkɔ̃, ne matsue ibere isɛ iabo Kulafa Adzarara kɔrɛ ne masekelera wã, ne masɛgu i katɔ̃ isɛ iabo ta Xananel Adzarara iso. <verse eid="NEH 3:1" /><verse number="2" style="v" sid="NEH 3:2" />Yeriko marɛrɛ̃ ɔtsue ibere kasɛ ga nsiai, ne Zakur, Imri ɔbibirɛrɛĩ ka ɔtsue kasɛ ga losiai Yeriko marɛrɛ̃ ɔkpɛ.<verse eid="NEH 3:2" /></para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" sid="NEH 3:3" />Xasena mabibirɛrɛĩ ɔledza Ikpɛ Kayogodɔ̃ itsue. Masia kã sitsue ne mapia kã akui gu akuisokubɔrai gu kayogodɔsɛ̃sidziri i kɔ̃ kasɛkɔ̃. <verse eid="NEH 3:3" /><verse number="4" style="v" sid="NEH 3:4" />Ɔturi wɔ ka loledza kasɛ ga nsiai nɖe Meremot, Uria ɔbibirɛrɛĩ, Xakoz ɔwabirɛrɛĩ. Ɔturi wɔ ka loledza ibere kasɛ ga nsiai Meremot ɔkpɛ nɖe Mesulam, Berekia ɔbibirɛrɛĩ, Mesezabel ɔwabirɛrɛĩ. Zadok, Baana ɔbibirɛrɛĩ ana ka loledza kasɛ ga nsiai. <verse eid="NEH 3:4" /><verse number="5" style="v" sid="NEH 3:5" />Tekoa marɛrɛ̃ ka loledza ibere kasɛ ga losiai. Ɣɛɛ Tekoa makpakpaturi ɔsɛ̃ maipia kɔrɔ̃ i karabara ga i ma manyɔisose ɔtã ma.<verse eid="NEH 3:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="NEH 3:6" />Yoyada, Pasea ɔbibirɛrɛĩ gu Mesulam, Besodeya ɔbibirɛrɛĩ nɖe maturi ma loledza Yesana Kayogodɔ̃. Masia kã sitsue ne mapia akui gu akuisokubɔrai gu kayogodɔsɛ̃sidziri i kɔ̃ nsɛkɔ̃. <verse eid="NEH 3:6" /><verse number="7" style="v" sid="NEH 3:7" />Mma ka loledza ibere kasɛ ga ka losiai nɖe marɛrɛ̃ ma lobɔrɛ i Gibeon gu Mizpa - Melatia, Gibeonse gu Yadon wɔ lobɔrɛ i Meronot - ngɔi mɛ lowe i Frat kuɣɛ̃kabokɔ̃ Ibuiti nyɔisose iɖeiso kayirinɔ. <verse eid="NEH 3:7" /><verse number="8" style="v" sid="NEH 3:8" />Uziel, Xarxaya ɔbibirɛrɛĩ, wɔ nɖe sikãrɛtɛatorese ɔwɛ̃, loledza kasɛ ga nsiai Melatia mɛrɛ̃ ɔkpɛ. Ne Xanania wɔ nɖe ngarãdu mabaradze ɔwɛ̃ ka loledza ngbegɔ losiai. Maledza Yerusalem isɛ iabo Ibere Bɛbɛɛbɛa iso. <verse eid="NEH 3:8" /><verse number="9" style="v" sid="NEH 3:9" />Refaya, Xur ɔbibirɛrɛĩ, wɔ loɖe Yerusalem ibuiti kasɛ kawɛ̃ ɔɖeisoi ka loledza ibere kasɛ ga losiai. <verse eid="NEH 3:9" /><verse number="10" style="v" sid="NEH 3:10" />Kasɛ ga losiai ngagbe ne, Yedaya, Xarumaf ɔbibirɛrɛĩ ka loledza kasɛ ga nto kanyɔ ɔ̃ iyo isɛ. Ne Xatus, Xasabneya ɔbibirɛrɛĩ ka ɔledza kasɛ ga losiai. <verse eid="NEH 3:10" /><verse number="11" style="v" sid="NEH 3:11" />Malkiya, Xarim ɔbibirɛrɛĩ gu Xasub, Paxat Moab ɔbibirɛrɛĩ ka ɔledza kasɛ mama gu Sikpo Adzarara. <verse eid="NEH 3:11" /><verse number="12" style="v" sid="NEH 3:12" />Salum, Xaloxes ɔbibirɛrɛĩ wɔ loɖe Yerusalem ibuiti kasɛ tsɔra nyɔisose, ka loledza ibere kasɛ ga ka losiai. Ɔ̃ mabibirɔ̃gomi ɔbuai wũ iso i ne ibara ame.<verse eid="NEH 3:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="NEH 3:13" />Xanun gu mma nsi i Zanoa ɔledza Kagbolomi Kayogodɔ̃. Maledza kã itsue, ne mapia akui i kanya fiɛ mapia akuisokubɔrai gu kayogodɔsɛ̃sidziri i kɔ̃ nsɛkɔ̃. Maledza ibere nɛ lokarã lɛ meta alafa ana gu siru isɛ iabo Aku Kayogodɔ̃.<verse eid="NEH 3:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="NEH 3:14" />Malkiya, Rekab ɔbibirɛrɛĩ wɔ nɖe Bet Xakerem nyɔisose loledza Aku Kayogodɔ̃. Ɔledza kã itsue fiɛ ɔpia kã akui gu kã akuisokubɔrai gu kayogodɔsɛ̃sidziri i kɔ̃ nsɛkɔ̃.<verse eid="NEH 3:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="NEH 3:15" />Salum, Kol Xoze ɔbibirɛrɛĩ, Mizpa ibuiti nyoisose ɔɖe loledza Ibiɔ Kayogodɔ̃. Ɔledza kã itsue, ɔbara isã fiɛ ɔpia kã akui gu akuisokubɔrai gu kayogodɔsɛ̃sidziri i kɔ̃ nsɛkɔ̃. Ɔtsue Siloam Iba ibere nɛ mpia i igara Kawĩmi kɔrɛ isɛ iabo asɛtiĩ wa loso abɔrɛ i igara David Ɔmagɛ̃siare ame. <verse eid="NEH 3:15" /><verse number="16" style="v" sid="NEH 3:16" />Nexemia, Abzuk ɔbibirɛrɛĩ, wɔ nɖe Bet Zur ibuiti kasɛ kawɛ̃ ɖeisose loledza ibere itsue isɛ iabo kakɔi ga mpia i David akpibiɔ kanɔsɔ̃ kɔrɛ, ka ita i mmɔ ikɛlɛ iwo nɛ makuri makpesera iba kɔrɛ, ka isɛ iabo Mma lofɔ iyere Iyo kɔrɛ.<verse eid="NEH 3:16" /></para>
  <para style="s1">Ma Levise Ma Lobara Karabara i Ibere iso</para>
  <para style="p">
    <verse number="17" style="v" sid="NEH 3:17" />Ne kama ne ma Levise ma wũ maledza ibere i Rexum, Bani ɔbibirɛrɛĩ kayirinɔ. Xasabia wɔ nɖe Keila ibuiti kasɛ kawɛ̃ nyɔisose ɔledza kasɛ ga loba i Rexum ɔkpɛ kama. Ɔbara karabara gagbe ɔtã ɔ̃ ibuiti. <verse eid="NEH 3:17" /><verse number="18" style="v" sid="NEH 3:18" />Ɔ̃ kama ne, ma kaɖemabi ka loledza i Binui, Xenadad ɔbibirɛrɛĩ kayirinɔ. Ɔɖe Keila ibuiti kasɛ tsɔra ɖeisose. <verse eid="NEH 3:18" /><verse number="19" style="v" sid="NEH 3:19" />Nwɔ ka loledza ibere i Binui ɔkpɛ kama, nɖe Ezer, Yesua ɔbibirɛrɛĩ wɔ nɖe Mizpa ɖeisose. Ɔledza kasɛ mama, ita i ngbegɔ nto inyɔ kakui ikɛlɛ akpirakasɛkɔ̃ isɛ iabo ibere ɔyokã. <verse eid="NEH 3:19" /><verse number="20" style="v" sid="NEH 3:20" />Baruk, Zabai ɔbibirɛrɛĩ loledza kasɛ ga loba i Ezer ɔkpɛ kama ku ɔdzegere, ita i ibere ɔyokã isɛ iabo sɔrɛdzekpakpa pelepele Eliasib iyo kabɔrɛnya. <verse eid="NEH 3:20" /><verse number="21" style="v" sid="NEH 3:21" />Ɔ̃ kama ne, Meremot, Uria ɔbibirɛrɛĩ, Xakoz ɔwabirɛrɛĩ, ɔledza ibere kakɔi mama ana, ita i Eliasib iyo kabɔrɛnya isɛ iabo iyo kawirikɔ̃.<verse eid="NEH 3:21" /></para>
  <para style="s1">Masɔrɛdze Ma Loledza Ibere</para>
  <para style="p">
    <verse number="22" style="v" sid="NEH 3:22" />Ɔ̃ kama ne masɔrɛdze ma i abuiti wa i ndɛ̃mɔ ɔledza kasɛ ga nsiai. <verse eid="NEH 3:22" /><verse number="23" style="v" sid="NEH 3:23" />Benyamin gu Xasub ɔledza kasɛ ga losiai i ma iyo katɔ̃. Ne Azaria wɔ nɖe Maaseya ɔbibirɛrɛĩ, Anania ɔwabirɛrɛĩ ɔɖe loledza kasɛ ga i ɔ̃ iyo kuruɛ. <verse eid="NEH 3:23" /><verse number="24" style="v" sid="NEH 3:24" />Binui, Xenadad ɔbibirɛrɛĩ, loledza kasɛ ga losiai. Kasɛ gagbe ɔta i Azaria iyo kɔrɛ isɛ iabo ibere ɔyokã iso. <verse eid="NEH 3:24" /><verse number="25" style="v" sid="NEH 3:25" />Ne Palal, Uzai ɔbibirɛrɛĩ lobara karabara i kasɛ ga mpia i kanɔsɔ̃ isɛ ku kato isɛ adzarara wa mpia i igara kawekɔ̃ imatã i madzuɛ̃se kasɛkɔ̃ inyamɔ. Palal kama ne, Pedaya, Paros ɔbibirɛrɛĩ <verse eid="NEH 3:25" /><verse number="26" style="v" sid="NEH 3:26" />gu isɔrɛyo maɖabo ma nsi i Ofel kabemi iso ka losiai maledza ibere isɛ iabo kakɔi ga mpia i Ndu Kayogodɔ̃ kanɔsɔ̃ to ikɛlɛ Adzarara siĩa i kuɣɛ̃kabɔrɛkɔ̃ isɛ.<verse eid="NEH 3:26" /></para>
  <para style="s1">Maturi Mama Ma Lobara Karabara i Ibere Iso</para>
  <para style="p">
    <verse number="27" style="v" sid="NEH 3:27" />Tekoa marɛrɛ̃ ka loledza kasɛ ga losiai i isɔrɛyo maɖabo kama. Marɛrɛ̃ ɔbara karabara ita i ibodɛ̃ mama iso, ita i Adzarara siare wa lobɔrɛ piriri katɔ̃ isɛ iabo Ofel ibere kɔrɛ.<verse eid="NEH 3:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="NEH 3:28" />Masɔrɛdze ɔledza ibere ita i Ipɔngɔ Kayogodɔ̃ katikpe ikɛlɛ. Ma ɔbiara ɔledza kasɛ ga mpia i ɔ̃ mɔmɔ iyo katɔ̃. <verse eid="NEH 3:28" /><verse number="29" style="v" sid="NEH 3:29" />Ma kama ne Zadok, Imer ɔbibirɛrɛĩ ɔledza kasɛ ga nto kanyɔ ɔ̃ iyo anɔ. Ɔ̃ kama ne Semaya, Sekania ɔbibirɛrɛĩ wɔ nɖe Kuɣɛ̃kabɔrɛkɔ̃ Kayogodɔ̃ dzuɛ̃se ɔ̃ wũ ɔledza ibere kasɛ. <verse eid="NEH 3:29" /><verse number="30" style="v" sid="NEH 3:30" />Ɔ̃ kama ne Xanania, Selemia ɔbibirɛrɛĩ ka loledza kasɛ kawɛ̃ ne Xanun wɔ nɖe Zalaf ɔbibirɛrɛĩ kuɔva ɔledza kasɛ mama. Ma kama ne Mesulam, Berekia ɔbibirɛrɛĩ ɔledza ngbegɔ mpia i kanɔsɔ̃ ku ɔ̃ kawekɔ̃ ayo. <verse eid="NEH 3:30" /><verse number="31" style="v" sid="NEH 3:31" />Sikãrɛtɛ̃atorese ɔwɛ̃ Malkiya, ɔɖe ka loledza kasɛ ga nsiai Mesulam ɔkpɛ isɛ iabo isɔrɛyo maɖabo gu kuɣamaɖese iyo kɔrɛ, i Kakɔinyɔ Kayogodɔ̃ kanɔsɔ̃, ikɛlɛ isɛ iabo i kayoi ga mpia i ɔyokã kato. <verse eid="NEH 3:31" /><verse number="32" style="v" sid="NEH 3:32" />Sikãrɛtɛamatorese tsɔra gu kuɣamaɖese ɔledza ibere katsɔrakɔ̃. Kasɛ gagbe ɔta i iyo nɛ i ibere ɔyokã kato kɔrɛ isɛ iabo Sɛrɛrerɔ̃ Kayogodɔ̃ iso.<verse eid="NEH 3:32" /></para>
  <chapter eid="NEH 3" />
  <chapter number="4" style="c" sid="NEH 4" />
  <para style="s1">Nexemia Matsirise</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 4:1" />Ɔwi wɔ i Sanbalat ɔnɔ sɔ boto boledza Yerusalem ibere itsue ne, ikpɛ̃ wũ sikpã fiɛ ibo wũ so gbaã. Ɔbara ma Yudase aɣiãra. <verse eid="NEH 4:1" /><verse number="2" style="v" sid="NEH 4:2" />Ne ɔɣɛ i ɔ̃ malaa gu Samaria makpakpɛ̃dze ikuri anɔmi ame sɔ, "Be i ma Yudase fɛfɛã mamɔ to mabara? Ma ibere mato maaledza? Mato maasɔrɛ ara? Maawo ne ɔro ku iyi iwɛ̃? Mato maawo ata wa ɔtɔ ɔɔpɛ, ɔkuri ɔɖi ɔbɔrɛgu i aku ikpe kame ɔsu ɔtsue ibere?"<verse eid="NEH 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NEH 4:3" />Tobia Amonse, ɔwe i ɔ̃ kɔrɛ ɔ̃ wũ ɔɣɛ sɔ, "Nnɛ mato matsue ne - si ɔgidi kɔraa ɔya ne iso ne, ɔto ɔ̃abiɛ ma ata ibere ɔfere i karɔ̃!"<verse eid="NEH 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 4:4" />Ao, bo Ɣaa, kã bo kayiikparama atsue, nɔ kumɛgɔ mato masopara bo. Tã ma aɣiãra si akpese asia i ma mɔmɔ ati iso. Su mapia nrɔɔ̃ lɛ kakpãramɔɛã i kafɔrɔ̃ ame. <verse eid="NEH 4:4" /><verse number="5" style="v" sid="NEH 4:5" />Daasu ma iɣɛrɛ atsɛ ma ɣee daaɖi ma akpi i fɔ anɔmi ame, alasɔ matia ibere matsuedze i ma anɔmi ame.<verse eid="NEH 4:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="NEH 4:6" />Ne ɔso bokɛlɛgu ibere itsue katɔ̃, gbɔgbɔɔgbɔ ne ɔɖuɖu ɔbo ne kukɔlɛme ndɛ̃, alasɔ maturi ɔbara karabara ku ma ɔtu ɔɖuɖu.<verse eid="NEH 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NEH 4:7" />Ɣɛɛ gɔ i Sanbalat, Tobia, ma Arabse, ma Amonse gu Asdod marɛrɛ̃ ɔnɔ sɔ Yerusalem ibere iledza itsue karabara to kasɛ katɔ̃ kukaakɔ ne, fiɛ ka mato matɛ̃ kubiɛkɔ̃ maro ne, mana sikpã gbaã. <verse eid="NEH 4:7" /><verse number="8" style="v" sid="NEH 4:8" />Ne ɔso mabara kanyakawɛ̃ sɔ ma ɔɖuɖu aata kakpã i Yerusalem iso mapia kukpɔkɔtɔ i ɔ̃ ame. <verse eid="NEH 4:8" /><verse number="9" style="v" sid="NEH 4:9" />Ɣɛɛ bokparamakayi botã bo Ɣaa ne boɣedza madzuɛ̃se i ngɔi. Maturi magbe ɔla maɔdzuɛ̃ matsirise ifura nɛgbe kasɛ̃ i kakɔme.<verse eid="NEH 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 4:10" />Tɔtɔ ne, ma Yudase ɔɣɛ sɔ, "Marabaradze ɔle ka ɔto ɔro ɣɛɛ ibere bibiɛa ɔkpese isi gbodzoo gɔ boito boawo ibere ɔledza itsue."<verse eid="NEH 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NEH 4:11" />Bo matsirise ana ɔɣɛ sɔ, "Maito maatsue kɔraa fiɛ boto boabo i ma ndɛ̃, boɖoe ma iyɔ kere karabara aatuĩ."<verse eid="NEH 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NEH 4:12" />Ne ma Yudase ma nsi mamatã bo matsirise ɔba maatã bo itsue ɔwi gbodzoo sɔ, "Kakɔi biara mipɛ mifiriki ne, mato maata mabo bo iso."<verse eid="NEH 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NEH 4:13" />Nnɛgbe ɔso ne, loɖi maturi losese ibere kama isɛ i ibere karɔ̃ isɛ ngɔi mɛ nfere kpawee. Loɣɛ ma lopia i akuri ame i ma ayomaturi kanya ne mato apɛmi, afele gu kuta fiɛ mato madzuɛ̃ mmɔ. <verse eid="NEH 4:13" /><verse number="14" style="v" sid="NEH 4:14" />Gɔ lonyɔ ara ame kukaakɔ ne, lota loya loɣere makpakpaturi, matɔ̃ɖedze gu maturi tsɔra sɔ, "Midaanigã matsirise. Minyigi sɔ Sate ne ɔsiare gu nwɔ nɖe ifɔ̃ra ɔɖe, si mikpɛ̃ i mi manyii iti, mi mabi gu mi mare gu mi ayo iti."<verse eid="NEH 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NEH 4:15" />Ɔwi wɔ i bo matsirise ɔnɔ sɔ ka boɣe ma ɔriita i bo iso ne, matsue sɔ Ɣaa ɔɔnina ne ame. Bo ɔɖuɖu ɔkpese bokɛlɛ ibere kɔrɛ, ne ɔbiara ɔkɛlɛgu ɔ̃ karabara katɔ̃.<verse eid="NEH 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NEH 4:16" />Ita i iyi nɛmɔ iso ne, wũ marɛrɛ̃ kasɛ ɔbara karabara, gɔ i kasɛ tsɔra ɔwe i akpakpɛ̃rapia ame mala afele, akpirafɔra gu kuta. Matɔ̃ɖedze ɔya i Yuda maturi ɔɖuɖu <verse eid="NEH 4:16" /><verse number="17" style="v" sid="NEH 4:17" />ma nto matsue ibere kama. Ma nto masore ibere itsue ara, ɔsu kɔrɔ̃ kuwɛ̃ mala maɔbara ala karabara, ne ka mato akpakpɛ̃ra i kɔrɔ̃ nyɔare ame ne. <verse eid="NEH 4:17" /><verse number="18" style="v" sid="NEH 4:18" />Matsuedze ɔbiara ana ɔsara ipɛmi i ɔ̃ iso fiɛ mala maɔbara karabara. Ɣɛɛ ɔturi wɔ nɖe kadadafɛ̃dze ɔwe i wũ kɔrɛ.<verse eid="NEH 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NEH 4:19" />Kere ne loɣere makpakpaturi, matɔ̃ɖedze gu maturi tsɔra sɔ, "Karabara ɔsi fiɛ kase kakpa, fiɛ bo ɔbiara ɔsame ɔɣɛ i ibere iso dzoroo i ɔ̃ ɔlaa kɔrɛ. <verse eid="NEH 4:19" /><verse number="20" style="v" sid="NEH 4:20" />Kakɔi karere ga minɔ kadadã silɔ ne, mimɔɛ̃ ɔri miba miasakanyagu bo i mmɔ. Bo Ɣaa to ɔ̃akpɛ̃ kakpã ɔtã bo!"<verse eid="NEH 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NEH 4:21" />Ne ɔso bokɛlɛgu karabara katɔ̃ ita i kaya gbɔgbɔɔgbɔ isɛ iabo ɔwi wɔ i awãmi sɛ abɔrɛ. <verse eid="NEH 4:21" /><verse number="22" style="v" sid="NEH 4:22" />Ɔwi wɔmɔ ame ne loɣere maturi ana sɔ, "Ma ɔbiara gu ɔ̃ buaidze si mala maɔwe i Yerusalem ku kasɛ̃, si maaɖe madzuɛ̃se ku kasɛ̃ ame fiɛ ka maabara karabara ku ikpɛnɛ ame." <verse eid="NEH 4:22" /><verse number="23" style="v" sid="NEH 4:23" />Ne ɔso mme oo, wũ manyii oo, ɣee wũ maɖabo oo gu wũ madzuɛ̃se ma mpia i wũ kɔrɛ ne, boiɖi bo arapia bosɛ. Ɔbiara ɔla akpakpɛ̃ra si ɔsɛ ɔka ndu ana kɔraa.<verse eid="NEH 4:23" /></para>
  <chapter eid="NEH 4" />
  <chapter number="5" style="c" sid="NEH 5" />
  <para style="s1">Mawedza Mawɛrɛba Anyɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 5:1" />Kiniɔ ne marɛrɛ̃ gu ma mare ɔbiɛ malakulu teteree mata maya i ma manyii ma Yudase iso. <verse eid="NEH 5:1" /><verse number="2" style="v" sid="NEH 5:2" />Ma mawɛ̃ to maɣɛ sɔ, "Bo gu bo mabibirɛrɛĩ gu mabibirɔ̃gomi ɔsi gbodzoo; ikote sɔ boana geɖebu si boaɖe fiɛ boawe ngbã."<verse eid="NEH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NEH 5:3" />Mamama to maɣɛ sɔ, "Boto bosu bo nkpɛkɔ̃ gu wainnkpɛkɔ̃ gu ayo bopia i awoba ame fiɛ boto bona geɖebu boɖe ku kukãsiare ame."<verse eid="NEH 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 5:4" />Mamama ana ɔkpese mato maɣɛ sɔ, "Ɔnyɛ boto bosɛ boanyɛ sikã fiɛ boto botã igara toto i bo nkpɛkɔ̃ gu wainnkpɛkɔ̃ iti. <verse eid="NEH 5:4" /><verse number="5" style="v" sid="NEH 5:5" />Atoasɔ sosina siwɛ̃ gu ima iwɛ̃ iɖe bo lɛ bo manyii ma Yudase mama awe fiɛ bo mabi ana se lɛ ma mabi awe ne, ɣɛɛ bo ne inya sɔ boasu bo mabibirɛrɛĩ gu mabibirɔ̃gomi bopia i sisande ame. Bo mabibirɔ̃gomi mawɛ̃ ka maɖe masande koko. Ɣɛɛ kuira na boabara alasɔ bo nkpɛkɔ̃ gu wainnkpɛkɔ̃ ka mipia i maturi mama nrɔɔ̃ ame."<verse eid="NEH 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 5:6" />Ɔwi wɔ lonɔ ma ibiɛ kulu gu atɔ̃me wagbe ne, lona sikpã gbaã. <verse eid="NEH 5:6" /><verse number="7" style="v" sid="NEH 5:7" />Losɛ iti ame i wã iso, ne lokidza makpakpaturi gu matɔ̃ɖedze ne. Loɣere ma sɔ, "Mito miɖe mi mɔmɔ manyii amumu!" Ne ɔso lokpere isarɛ siare si lokidza ma. <verse eid="NEH 5:7" /><verse number="8" style="v" sid="NEH 5:8" />Ne loɣere ma sɔ, "Boɔpia kubɛ lɛ kumɛgɔ ikote boɣa bo manyii ma Yudase mawɛ̃ ma marɔdɛ̃ matã nɖebi mama, boɖi i sisande ame. Kiniɔ ne mito mirɔdɛ̃ mi manyii, kɔraa si maakpese maarɔdɛ̃ ma matã bo!" Malokanana, alasɔ kuira na maawo ɔɣɛ.<verse eid="NEH 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NEH 5:9" />Ne ɔso lokɛlɛgu i katɔ̃ sɔ, "Nnɛ mito mibara iilɛ. Ikote sɔ miabara ara i bo Ɣaa kunigã ame, si nɖebi mama maturi ma nɖe bo matsirise iibana ɔri wɔ iso maabara bo aɣiãra. <verse eid="NEH 5:9" /><verse number="10" style="v" sid="NEH 5:10" />Bo gu wũ manyii to bonyɛ sikã gu geɖebu botã maturi. Ɣɛɛ mitã sɔ kusia gbodzoo ifɔ si ituĩ. <verse eid="NEH 5:10" /><verse number="11" style="v" sid="NEH 5:11" />Mikpesera masose nkpɛkɔ̃ gu wainnkpɛkɔ̃, oliva nkpɛkɔ̃ gu ma ayo mitã ma ɔluwɛ̃. Ana ne mikpesera kusia gbodzoo gɔ mito mifɔ ma - ika kulafa nɛ mifɔ i sikã, geɖebu, ndã, nnɔĩ iso mitã ma."<verse eid="NEH 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NEH 5:12" />Matã mmuai sɔ, "Boto boabara i nnɛ aɣɛ iso. Boakpesera ara botã ma fiɛ boibakpura ma kuira bobua."</para>
  <para style="p" vid="NEH 5:12">Kere ne lokpere masɔrɛdze lobɔ ne lotã makpakpaturi gu matɔ̃ɖedze ɔkã ndamu sɔ maabara i nnɛ maɣɛ masɛ iso. <verse eid="NEH 5:12" /><verse number="13" style="v" sid="NEH 5:13" />Lokpakpa wũ awu tagbaraa kafɛ̃siakɔ̃ ana ne loɣɛ sɔ, "Ɔturi biara wɔ loasɛ̃ ɔ̃ibabara i ndamu iso ne, Ɣaa si ɔkpakpa nwɔmɔ ɔɖi i ɔ̃ iyo gu ɔ̃ karana ɔɖuɖu ame lɛgbe. Ngbɔ si makpakpa ɔturi wɔmɔ igbã ara maɖi si ɔse ikunu!"</para>
  <para style="p" vid="NEH 5:13">I nnɛgbe kanya ne, iturikuri ɔɖuɖu ɔtɔrã masia iso sɔ, "Si iba ngbɔ," ne male <char style="nd">Bosate</char>. Ne maturi ɔbara lɛ kumɛgɔ maɣɛ masɛ ne.<verse eid="NEH 5:13" /></para>
  <para style="s1">Nexemia Iisɛ Ɔbie ɔ̃ Ɔnɔwɛ̃saã Ɔkpɛ</para>
  <para style="p">
    <verse number="14" style="v" sid="NEH 5:14" />Ita i ɔwi wɔ masɛra me lɛ ma Yudase nyoisose i Yuda karɔ̃ iso ne, lobara karabara gagbe akɔ aweo-anyɔ. Ita i igara Artaxsasta sigara ɔɖewi ikɔ sinyɔva ame isɛ iabo ɔ̃ ikɔ sitɛinyɔare ame. Ɣɛɛ i akɔ wagbe ame ne, mme oo, wũ manyii oo pelepele ne, boiɖe araɖea wa masɛ mato matã nyɔisose. <verse eid="NEH 5:14" /><verse number="15" style="v" sid="NEH 5:15" />Ɣɛɛ mma loɔɖe manyɔisose maɖe me katɔ̃ ne, makpese ato siare masia i kaɖe iso. Mafɔ sikãfudza abi sina isu ibua i araɖea gu ndã wa i kaɖe sɛ katã iso. Ma maɖabo ana kɔraa ɔɔsakara so mapia kaɖe. Ɣɛɛ mme ne, loibara ara wamɔ ala Ɣaa kunigã gɔ mpia i wũ ame ɔso. <verse eid="NEH 5:15" /><verse number="16" style="v" sid="NEH 5:16" />Ne kanya ne, losu so lopia i ibere itsue karabara ame. Ne wũ marɛrɛ̃ ɔɖuɖu ɔsakanya i mmɔ matã karabara, boiɣa karɔ̃ kukawɛ̃ botã so. <verse eid="NEH 5:16" /><verse number="17" style="v" sid="NEH 5:17" />Isu ibua ne, maturi kulafa kuwɛ̃ gu siru ma loɖe ma Yudase gu matɔ̃ɖedze ɔɖe ara i wũ kɔrɛ, ibua ne ngbɔ ame i mma lobɔrɛ i nɖebi mɛ loki milɔ bo kɔrɛ si maba ana ne. <verse eid="NEH 5:17" /><verse number="18" style="v" sid="NEH 5:18" />Iyi biara ne ara wa nsɛ lotã ɔɖe nantsuĩrɛrɛ̃ ɔwɛ̃, masɛrɛrerɔ̃ ma mba iɖa maɖo ikuɔ, makɔkɔ gu iyomarodza gbodzoo mala maɔwa maɔtã me. Ayi aweo biara kama ne, loɣa ndã agbã gbodzoo losɛ. Ɣɛɛ i ara ɔɖuɖu wagbe ame kɔraa ne, loitã kaɖe ɔtã me nyoisose araɖea wa ikote sɔ maatã me kuiyikuiyi, alasɔ lonya sɔ ato ɔsi i maturi magbe iso gbaã.<verse eid="NEH 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NEH 5:19" />O wũ Ɣaa, nyigi me si wũ ara si abo-ɔ anɔ i ara ɔɖuɖu wa loɔbara lotã maturi magbe iti.<verse eid="NEH 5:19" /></para>
  <chapter eid="NEH 5" />
  <chapter number="6" style="c" sid="NEH 6" />
  <para style="s1">Maturi Ɔbara Adzuni Nyanyariã i Nexemia Iso</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 6:1" />Sanbalat, Tobia, Gesem Arabse gu bo matsirise tsɔra ɔnɔ sɔ loɔledza ibere itsue fiɛ kabiɛkɔ̃ kukawɛ̃ siina i ne ame. Atoasɔ ipɛ ɔwi wɔmɔ ne, loipia akui i kuyogodɔ̃ kanya. <verse eid="NEH 6:1" /><verse number="2" style="v" sid="NEH 6:2" />Ne Sanbalat gu Gesem ɔsese me kanya sɔ, "Ba, si bosarɛ i Ono katɛfɛkɔ̃ i kamagɛĩ kawɛ̃ ame."</para>
  <para style="p" vid="NEH 6:2">Ɣɛɛ mato mabara adzuni gɔ maabara me iraboa. <verse eid="NEH 6:2" /><verse number="3" style="v" sid="NEH 6:3" />Ne ɔso losese ma makpabo ku mmuai mɛgbe sɔ, "Nto lobara karabara nyaa kawɛ̃ gɔ loibawo ɔso ɔba. Be ɔso loanyua karabara losɛ katuĩ, kere lota loso loba i mi kɔrɛ i mmɔ?" <verse eid="NEH 6:3" /><verse number="4" style="v" sid="NEH 6:4" />Masese me ɔturi ku kanya ngbɔ ikpɛ ina sɔɔ̃, ne mme wũ lotã ma mmuai mɛmɔ ame ne.<verse eid="NEH 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NEH 6:5" />Kere ne Sanbalat ɔledza ɔ̃ ɔɖabo isese me, ku kanya gamɔ ame. Nnɛgbe loɖe ɔkpɛ ruva ɔto ɔsese me ɔturi ne. Ɔto ɔko wɔ maisɛ̃ kanya i ɔ̃ kɔrɔ̃ ame. <verse eid="NEH 6:5" /><verse number="6" style="v" sid="NEH 6:6" />Matsɛrɛ atɔ̃me wagbe mapia i ɔko ame sɔ,</para>
  <para style="pm" vid="NEH 6:6">"Itsue pia i ɔwiri ame i nɖebi ndɛ̃ - gu Gesem ana ɔɣere me sɔ ɔnukuare iɖe - sɔ mi gu ma Yudase ɔɔsɛ iti nyanyariã ame sɔ miabara itaiyaiso, ne ɔso fiɛ mito mitsue ibere ne. Isu ibua ne, i atsue wagbe kanya ne ka ato aba aakpese ma Yudase igara. <verse eid="NEH 6:6" /><verse number="7" style="v" sid="NEH 6:7" />Maɣɛ sɔ ɔɔɖikanyamaɖidze ana asɛ gɔ mala maɔpɛ imomo i fɔ iso i Yerusalem sɔ, 'Yuda ka ɔba igara!' Kiniɔ ne, itsue nɛgbe to iare isɛ iabo i igara kɔrɛ, ne ɔso ba si bosakanya bosɛ iti ame i itɔ̃me iso."<verse eid="NEH 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NEH 6:8" />Losese wũ mmuai mɛgbe sɔ, "Kuira iito ikɛlɛ i katɔ̃ lɛ ato aɣɛ. Fɔ mɔmɔ kere nto awe ne i fɔ iti ame."<verse eid="NEH 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NEH 6:9" />Ma ɔɖuɖu to mabie sɔ mapia bo ifɔ̃, mato mabu sɔ, "Ma nrɔɔ̃ aafɛ̃ i karabara iso iyɔ kaibawiri."</para>
  <para style="p" vid="NEH 6:9">Ɣɛɛ lokparamakayi sɔ, "Kiniɔ ne pia wũ nrɔɔ̃ ɔle."<verse eid="NEH 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 6:10" />Iyi iwɛ̃ lopasa losɛ Semaya, Delaya ɔbibirɛrɛĩ, Mexetabel ɔwabirɛrɛĩ wɔ masɛ̃ mapia i ɔ̃ iyo kɔrɛ. Ɔɣɛ sɔ, "Tã bo gu-ɔ si bosɛ boasarɛ i Ɣaa isɔrɛyo kame, si bosɛ̃ isɔrɛyo akui. Fɔ matsirise to maba maaɖue-ɔ ku kasɛ̃."<verse eid="NEH 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NEH 6:11" />Ɣɛɛ lotã wũ mmuai sɔ, "Mme, ɔrɛrɛĩ mɔmɔ lɛgbe aarui ɔtere? Ɣee ɔturi lɛ mme, si lotere losɛ loawɛrɛ i isɔrɛyo ame si loɖi wũ ngbã? Oɣoo, loibasɛ!" <verse eid="NEH 6:11" /><verse number="12" style="v" sid="NEH 6:12" />Lotsue sɔ iiɖe Ɣaa ɔɖe losese wũ, ɣɛɛ ɔɖikanya ɔta ɔya me iso alasɔ Tobia gu Sanbalat mɛrɛ̃ ɔtã wũ sikã si ɔbara kumɛɔ. <verse eid="NEH 6:12" /><verse number="13" style="v" sid="NEH 6:13" />Masu wũ ɔpaa si ɔpia me ifɔ̃ si lobara ikpi i ne ibara ame. Iyɔ mato maasu itɔ̃me nɛgbe manina me iyere mala maɔsɛ me i karɔ̃.<verse eid="NEH 6:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="NEH 6:14" />O wũ Ɣaa, nyigi Tobia gu Sanbalat ala nnɛ mabara ɔso. Si anyigi kanyaɖidzerɔ̃go Noadia gu kanyamaɖidze tsɔra, mma lola maɔbie sɔ mapia me ifɔ̃.<verse eid="NEH 6:14" /></para>
  <para style="s1">Ibere Karabara Kawirikɔ̃</para>
  <para style="p">
    <verse number="15" style="v" sid="NEH 6:15" />Ne ɔso mawiri ibere itsue karabara ku ma Hebrise kuwa Elul iyi sinyɔiruva iso. Karabara ɔɖuɖu ɔfɔ ayi siru-anyɔ. <verse eid="NEH 6:15" /><verse number="16" style="v" sid="NEH 6:16" />Gɔ i bo matsirise ɔɖuɖu ɔnɔ sɔ boɔwiri ibere karabara ne, nɖebi ɔɖuɖu mɛ loki milɔ bo ɔnigã fiɛ maisifɔ so maɖe, alasɔ matsue sɔ bo Ɣaa lobuai bo iso ɔso karabara ɔwiri.<verse eid="NEH 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NEH 6:17" />I ɔwi wɔmɔ ɔɖuɖu ame ne, ma Yudase makpakpaturi ɔla maɔtsɛrɛ siko maɔsese Tobia, fiɛ ɔ̃ ɔla ɔ̃ɔtã ma sɛ̃ mmuai. <verse eid="NEH 6:17" /><verse number="18" style="v" sid="NEH 6:18" />Maturi gbodzoo ɔwe i ndamu kayirinɔ ku Tobia i Yuda. Ala ɔ̃ mase ɔɖe Sekania, Ara ɔbibirɛrɛĩ, fiɛ Tobia ɔbibirɛrɛĩ Yexoxanan ana ɔyiri Mesulam ɔbibirɔ̃gomi, Mesulam ɔɖe Berekia ɔbibirɛrɛĩ. <verse eid="NEH 6:18" /><verse number="19" style="v" sid="NEH 6:19" />Maturi to maɖeika i ɔ̃ karabara sɛɛ iso i wũ kɔrɛ. Si irere nɛ lopia kanya loɣɛ ne ngbɔ ame mato maɣere wũ ne. Tobia ɔla ɔ̃ɔsese me siko ɔwi gbodzoo ɔsu ɔto ɔpia me ifɔ̃.<verse eid="NEH 6:19" /></para>
  <chapter eid="NEH 6" />
  <chapter number="7" style="c" sid="NEH 7" />
  <para style="p">
    <verse number="1" style="v" sid="NEH 7:1" />Gɔ boɔledza ibere itsue boro kama ne, lopia akui i wã nsɛkɔ̃, ne maɖi kayogodɔ̃madzuɛ̃se gu akamakadze gu ma Levise matã ma karabara. <verse eid="NEH 7:1" /><verse number="2" style="v" sid="NEH 7:2" />Losu Yerusalem ɔmagɛ̃siare inyɔiso lopia i wũ ɔnyiibirɛrɛĩ Xanani gu Xanania nrɔɔ̃ ame. Xanania wɔgbe ɔɖe makpakpɛ̃dzekpakpa wɔ kayirinɔ i Yerusalem ɔlekasɛkɔ̃ ɔwe. Ala ɔɖe ɔrɛrɛ̃ ku ɔnukuare wɔ lonigã Ɣaa ɔɖo marɛrɛ̃ gbodzoo. <verse eid="NEH 7:2" /><verse number="3" style="v" sid="NEH 7:3" />Loɣere ma sɔ, "Midaasɛsɛ̃ Yerusalem kuyogodɔ̃ gbɔgbɔɔgbɔ kuɣɛ̃ ɔɔya kato. Gɔ i kuyogodɔ̃madzuɛ̃se ɔkpese mapia i karabara ne, mitã masɛ̃ akui si mapia kuyogodɔsɛ̃dziri. Ana ne ɖi maturi ma nsi i Yerusalem ɔmagɛ̃siare ame lɛ madzuɛ̃se, mawɛ̃ si madzuɛ̃ ngɔi miwɛ̃ gu mawɛ̃ si madzuɛ̃ ma mɔmɔ ayo kɔrɛ isɛ."<verse eid="NEH 7:3" /></para>
  <para style="s1">Mma Lokpese i Kafɔrɔ̃ Iso Maba Ayere</para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 7:4" />Kiniɔ ne, Yerusalem ɔɖe ɔmagɛ̃siare wɔ lomɔ fiɛ ɔbɛ ɔfere ɔkpa, ɣɛɛ maturi tɛmi lowe i kame fiɛ mailedza ayo itsue tɔtɔ. <verse eid="NEH 7:4" /><verse number="5" style="v" sid="NEH 7:5" />Ne ɔso wũ Ɣaa ɔsu ɔsia i wũ ɔtu iso sɔ lokpere makpakpaturi gu matɔ̃ɖedze gu kaɖe maturi fefea losakanya, si lotsɛrɛ ma ayere i ma ayomaturi kanya. Losɛ loanya maturi ikuri ɖeakatɔ̃ nɛ lokpese i kafɔrɔ̃ iso sikparɛ ayere ɔko. Nnɛgbe lonya matsɛrɛ masɛ i mmɔ ne:<verse eid="NEH 7:5" /></para>
  <para style="b" />
  <para style="pi1">
    <verse number="6" style="v" sid="NEH 7:6" />Mmagbe nɖe ibuiti maturi ma lobɔrɛ i kafɔrɔ̃ iso, i mafɔrɔĩ ma i Babilon igara Nebukadnezar ɔmɔɛ̃ ɔkɛlɛlgu kafɔrɔ̃ iso. (Makpese maba Yerusalem gu Yuda fiɛ ma ɔbiara ɔkɛlɛ ɔ̃ aɖe. <verse eid="NEH 7:6" /><verse number="7" style="v" sid="NEH 7:7" />Makpesegu Zerubabel, Yesua, Nexemia, Azaria, Raamia, Naxamani, Mordekai, Bilsan, Misperet, Bigvai, Nexum gu Baana):</para>
  <para style="b" vid="NEH 7:7" />
  <para style="p" vid="NEH 7:7">Israel kaɖe marɛrɛ̃ ayere i ngbe ne:<verse eid="NEH 7:7" /></para>
  <para style="b" />
  <para style="pi">
    <verse number="8" style="v" sid="NEH 7:8" />Paros ɔkparɛ ɖe maturi kukpi kunyɔ gu kulafa sikɔdzɛ-inyɔ. <verse eid="NEH 7:8" /><verse number="9" style="v" sid="NEH 7:9" />Sefatia ɔkparɛ ɔɖe maturi alafa atɛ gu sikɔdzɛ-inyɔ. <verse eid="NEH 7:9" /><verse number="10" style="v" sid="NEH 7:10" />Ara ɔkparɛ ɔɖe maturi alafa akuɔ gu siru-inyɔ. <verse eid="NEH 7:10" /><verse number="11" style="v" sid="NEH 7:11" />Paxat Moab (iki i Yesua gu Yoab kakpa iso) ɔɖe maturi kukpi kunyɔ gu alafa fafarana gu iweo-fafarana. <verse eid="NEH 7:11" /><verse number="12" style="v" sid="NEH 7:12" />Elam ɔkparɛ ɔɖe maturi kakpi kawɛ̃ gu alafa anyɔ siru-ina. <verse eid="NEH 7:12" /><verse number="13" style="v" sid="NEH 7:13" />Zatu ɔkparɛ ɔɖe maturi alafa fafarana gu sina-iru. <verse eid="NEH 7:13" /><verse number="14" style="v" sid="NEH 7:14" />Zakai ɔkparɛ ɖe maturi alafa akɔdzɛ gu sikuɔ. <verse eid="NEH 7:14" /><verse number="15" style="v" sid="NEH 7:15" />Binui ɔkparɛ ɔɖe maturi alafa akuɔ gu sina-fafarana. <verse eid="NEH 7:15" /><verse number="16" style="v" sid="NEH 7:16" />Bebai ɔkparɛ ɖe maturi alafa akuɔ gu sinyɔ-farafana. <verse eid="NEH 7:16" /><verse number="17" style="v" sid="NEH 7:17" />Azgad ɔkparɛ ɔɖe maturi kukpi kunyɔ gu alafa atɛ sinyɔ-inyɔ. <verse eid="NEH 7:17" /><verse number="18" style="v" sid="NEH 7:18" />Adonikam ɔkparɛ ɔɖe maturi alafa akuɔ gu sikuɔ-ikɔdzɛ. <verse eid="NEH 7:18" /><verse number="19" style="v" sid="NEH 7:19" />Bigvai ɔkparɛ ɔɖe maturi kukpi kunyɔ gu sikuɔ-ikɔdzɛ. <verse eid="NEH 7:19" /><verse number="20" style="v" sid="NEH 7:20" />Adin ɔkparɛ ɔɖe maturi alafa akuɔ gu siru-iru. <verse eid="NEH 7:20" /><verse number="21" style="v" sid="NEH 7:21" />Ater (iki i Xezekia) ɔkparɛ ɔɖe maturi kasiwɛ̃-fainafaina. <verse eid="NEH 7:21" /><verse number="22" style="v" sid="NEH 7:22" />Xasum ɔkparɛ ɔɖe maturi alafa atɛ gu sinyɔ-fafarana. <verse eid="NEH 7:22" /><verse number="23" style="v" sid="NEH 7:23" />Bezai ɔkparɛ ɔɖe maturi alafa atɛ gu sinyɔ-ina. <verse eid="NEH 7:23" /><verse number="24" style="v" sid="NEH 7:24" />Xarif ɔkparɛ maturi ɔɖe kulafa kuwɛ̃ gu iweo-inyɔ. <verse eid="NEH 7:24" /><verse number="25" style="v" sid="NEH 7:25" />Gibeon ɔkparɛ ɔɖe maturi kasiwɛ̃-iru.<verse eid="NEH 7:25" /></para>
  <para style="b" />
  <para style="pi">
    <verse number="26" style="v" sid="NEH 7:26" />Betlexem marɛrɛ̃ gu Netofa marɛrɛ̃ ɔkparɛ ɔɖe maturi kulafa kuwɛ̃ gu fasinafasina-farafana. <verse eid="NEH 7:26" /><verse number="27" style="v" sid="NEH 7:27" />Anatot marɛrɛ̃ ɔkparɛ ɔɖe maturi kulafa gu sinyɔ-fainafaina. <verse eid="NEH 7:27" /><verse number="28" style="v" sid="NEH 7:28" />Bet Azmavet marɛrɛ̃ ɔkparɛ ɔɖe maturi sina-inyɔ. <verse eid="NEH 7:28" /><verse number="29" style="v" sid="NEH 7:29" />Kiriat Yearim marɛrɛ̃ ɔkparɛ, Kefira marɛrɛ̃ ɔkparɛ gu Beerot marɛrɛ̃ ɔkparɛ ɔɖe maturi alafa akɔdzɛ gu sina-itɛ. <verse eid="NEH 7:29" /><verse number="30" style="v" sid="NEH 7:30" />Rama marɛrɛ̃ ɔkparɛ gu Geba marɛrɛ̃ ɔkparɛ ɖe maturi alafa akuɔ gu sinyɔ-ɔwɛ̃. <verse eid="NEH 7:30" /><verse number="31" style="v" sid="NEH 7:31" />Mikmas marɛrɛ̃ ɔkparɛ ɔɖe maturi kulafa gu sinyɔ-inyɔ. <verse eid="NEH 7:31" /><verse number="32" style="v" sid="NEH 7:32" />Betel marɛrɛ̃ ɔkparɛ gu Ai marɛrɛ̃ ɔkparɛ ɔɖe maturi kulafa kuwɛ̃ gu sinyɔ-itɛ. <verse eid="NEH 7:32" /><verse number="33" style="v" sid="NEH 7:33" />Nebo nyɔare marɛrɛ ɔkparɛ ɔɖe maturi siru-inyɔ. <verse eid="NEH 7:33" /><verse number="34" style="v" sid="NEH 7:34" />Elam nyɔare marɛrɛ̃ ɔkparɛ ɔɖe kakpi kawɛ̃ gu alafa anyɔ siru-ina. <verse eid="NEH 7:34" /><verse number="35" style="v" sid="NEH 7:35" />Xarim marɛrɛ̃ ɔkparɛ ɔɖe maturi alafa atɛ sinyɔ. <verse eid="NEH 7:35" /><verse number="36" style="v" sid="NEH 7:36" />Yeriko marɛrɛ̃ ɔkparɛ ɔɖe maturi alafa atɛ sina-iru. <verse eid="NEH 7:36" /><verse number="37" style="v" sid="NEH 7:37" />Lod marɛrɛ ɔkparɛ, Xadid marɛrɛ̃ gu Ono marɛrɛ̃ ɔkparɛ ɔɖe maturi alafa akɔdzɛ sinyɔ-ɔwɛ̃. <verse eid="NEH 7:37" /><verse number="38" style="v" sid="NEH 7:38" />Sena marɛrɛ̃ ɔkparɛ ɔɖe maturi kukpi kutɛ alafa kaiwɛ̃ gu sitɛ.<verse eid="NEH 7:38" /></para>
  <para style="b" />
  <para style="p">
    <verse number="39" style="v" sid="NEH 7:39" />Masɔrɛdze:</para>
  <para style="b" vid="NEH 7:39" />
  <para style="pi" vid="NEH 7:39">Yedaya ɔkparɛ (iki i Yesua kakpa iso) ɔɖe maturi alafa kaiwɛ̃ gu sikɔdzɛ-itɛ.<verse eid="NEH 7:39" /></para>
  <para style="li">
    <verse number="40" style="v" sid="NEH 7:40" />Imer ɔkparɛ ɔɖe maturi kakpi kawɛ̃ siru-inyɔ. <verse eid="NEH 7:40" /><verse number="41" style="v" sid="NEH 7:41" />Pasxur ɔkparɛ ɔɖe maturi kakpi kawɛ̃ gu alafa anyɔ sina-ikɔdzɛ. <verse eid="NEH 7:41" /><verse number="42" style="v" sid="NEH 7:42" />Xarim ɔkparɛ ɔɖe maturi kakpi kawɛ̃ gu iweo-ikɔdzɛ.<verse eid="NEH 7:42" /></para>
  <para style="b" />
  <para style="p">
    <verse number="43" style="v" sid="NEH 7:43" />Ma Levise:</para>
  <para style="b" vid="NEH 7:43" />
  <para style="pi" vid="NEH 7:43">Yesua (iki i Kadmiel wɔ lobɔrɛ i Xodavia kakpa ame) maturi ɔɖe sikɔdzɛ-ina.<verse eid="NEH 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NEH 7:44" />Akamakadze:</para>
  <para style="b" vid="NEH 7:44" />
  <para style="pi" vid="NEH 7:44">Asaf ɔkparɛ ɔɖe maturi kulafa kuwɛ̃ sina-farafana.<verse eid="NEH 7:44" /></para>
  <para style="b" />
  <para style="p">
    <verse number="45" style="v" sid="NEH 7:45" />Kayogodɔ̃madzuɛ̃se:</para>
  <para style="b" vid="NEH 7:45" />
  <para style="pi" vid="NEH 7:45">Salum ɔkparɛ, Ater ɔkparɛ, Talmon ɔkparɛ, Akub ɔkparɛ, Xatita ɔkparɛ gu Sobai ɔkparɛ, ɔɖe maturi kulafa kuwɛ̃ sitɛ-farafana.<verse eid="NEH 7:45" /></para>
  <para style="b" />
  <para style="pi">
    <verse number="46" style="v" sid="NEH 7:46" />Isɔrɛyo maɖabo:</para>
  <para style="b" vid="NEH 7:46" />
  <para style="li1" vid="NEH 7:46">Zixa ɔkparɛ, Xasufa ɔkparɛ, Tabaot ɔkparɛ,<verse eid="NEH 7:46" /></para>
  <para style="li2">
    <verse number="47" style="v" sid="NEH 7:47" />Keros ɔkparɛ, Sia ɔkparɛ, Padon ɔkparɛ,<verse eid="NEH 7:47" /></para>
  <para style="li2">
    <verse number="48" style="v" sid="NEH 7:48" />Lebana ɔkparɛ, Xagaba ɔkparɛ, Salmai ɔkparɛ<verse eid="NEH 7:48" /></para>
  <para style="li2">
    <verse number="49" style="v" sid="NEH 7:49" />Xanan ɔkparɛ, Gidel ɔkparɛ, Gaxar ɔkparɛ<verse eid="NEH 7:49" /></para>
  <para style="li2">
    <verse number="50" style="v" sid="NEH 7:50" />Reaya ɔkparɛ, Rezin ɔkparɛ, Nekoda ɔkparɛ,<verse eid="NEH 7:50" /></para>
  <para style="li2">
    <verse number="51" style="v" sid="NEH 7:51" />Gazam ɔkparɛ, Uza ɔkparɛ, Pasea ɔkparɛ,<verse eid="NEH 7:51" /></para>
  <para style="li2">
    <verse number="52" style="v" sid="NEH 7:52" />Besai ɔkparɛ, Meunim ɔkparɛ, Nefusim ɔkparɛ,<verse eid="NEH 7:52" /></para>
  <para style="li2">
    <verse number="53" style="v" sid="NEH 7:53" />Bakbuk ɔkparɛ, Xakufa ɔkparɛ, Xarxur ɔkparɛ,<verse eid="NEH 7:53" /></para>
  <para style="li2">
    <verse number="54" style="v" sid="NEH 7:54" />Bazlut ɔkparɛ, Mexida ɔkparɛ, Xarsa ɔkparɛ, <verse eid="NEH 7:54" /><verse number="55" style="v" sid="NEH 7:55" />Barkos ɔkparɛ, Sisera ɔkparɛ, Tema ɔkparɛ,<verse eid="NEH 7:55" /></para>
  <para style="li2">
    <verse number="56" style="v" sid="NEH 7:56" />Nezia ɔkparɛ gu Xatifa ɔkparɛ.<verse eid="NEH 7:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="NEH 7:57" />Solomon maɖabo sikparɛ ngbe ne: Sotai ɔkparɛ, Soferet ɔkparɛ, Perida ɔkparɛ,<verse eid="NEH 7:57" /></para>
  <para style="li2">
    <verse number="58" style="v" sid="NEH 7:58" />Yaala ɔkparɛ, Darkon ɔkparɛ, Gidel ɔkparɛ, <verse eid="NEH 7:58" /><verse number="59" style="v" sid="NEH 7:59" />Sefatia ɔkparɛ, Xatil ɔkparɛ, Pokeret Xazebayim ɔkparɛ gu Amon ɔkparɛ.<verse eid="NEH 7:59" /></para>
  <para style="b" />
  <para style="p">
    <verse number="60" style="v" sid="NEH 7:60" />Isɔrɛyo maɖabo ɔkparɛ gu Solomon maɖabo ɔkparɛ ɔba maɖe maturi alafa atɛ gu kasiwɛ̃-inyɔ.<verse eid="NEH 7:60" /></para>
  <para style="b" />
  <para style="pi1">
    <verse number="61" style="v" sid="NEH 7:61" />Maturi ma nsiai lobɔrɛ i Tel Mela, Tel Xarsa, Kerub, Adon gu Imer simagɛ̃ ame maba, ɣɛɛ maiwo ma ayomaturi ɔte ɣee ma ɔkparɛ i Israel mabi ndɛ̃ ɔte nɖe magbe ne:<verse eid="NEH 7:61" /></para>
  <para style="b" />
  <para style="pi">
    <verse number="62" style="v" sid="NEH 7:62" />Delaya ɔkparɛ, Tobia ɔkparɛ gu Nekoda ɔkparɛ ɔɖe maturi alafa akuɔ gu sina-inyɔ<verse eid="NEH 7:62" /></para>
  <para style="b" />
  <para style="p">
    <verse number="63" style="v" sid="NEH 7:63" />Mma lobɔrɛ i masɔrɛdze ndɛ̃ nɖe:</para>
  <para style="b" vid="NEH 7:63" />
  <para style="pi" vid="NEH 7:63">Xabaya ɔkparɛ, Xakoz ɔkparɛ gu Barzilai (ɔrɛrɛ̃ wɔ loyiri Barzilai Gileadse ɔbibirɔ̃gomi fiɛ makpere ɔrɛrɛ̃ ku iyere nɛmɔ).<verse eid="NEH 7:63" /></para>
  <para style="pi1">
    <verse number="64" style="v" sid="NEH 7:64" />Maturi magbe ɔbie ma mawa ayere i siɣekparɛ siko ame ɣɛɛ mainya. Ne ɔso masu ma sɔ maisekele maaɖe masɔrɛdze. <verse eid="NEH 7:64" /><verse number="65" style="v" sid="NEH 7:65" />Karɔ̃ nyɔisose ɔsi ma mmara sɔ masiina ɔri maɖe araɖea wa nse sekelee aɖo kuawɛ̃, tagbi sɔrɛdze ɔwɛ̃ to ɔsumu ku Urim gu Tumim<note caller="+" style="f"><char style="fr" closed="false">7.65 </char><char style="ft" closed="false">Urim gu Tumim: Iɖe ara anyɔ wa i sɔrɛdze sɛ ɔsu ɔla ɔ̃atsue ala Ɣaa kuɖɔɛ iso ara i Israel.</char></note>.<verse eid="NEH 7:65" /></para>
  <para style="b" />
  <para style="pi1">
    <verse number="66" style="v" sid="NEH 7:66" />Iturikuri ɔɖuɖu ɔɖe kukpi sina inyɔ alafa atɛ sikuɔ. <verse eid="NEH 7:66" /><verse number="67" style="v" sid="NEH 7:67" />Ma maɖaborɛrɛ̃ gu maɖaborɔ̃go na i kukame gɔgbe ame. Ma maɖe kukpi kukɔdzɛ gu alafa atɛ sitɛ-ikɔdzɛ. Ma marɛrɛ̃ akamakadze gu marɔ̃go akamakadze ɔɖe alafa anyɔ sina-iru. <verse eid="NEH 7:67" /><verse number="68" style="v" sid="NEH 7:68" />Apɔngɔ ɔɖe alafa akɔdzɛ sitɛ-ikuɔ, mafiripɔngɔ ɔɖe alafa anyɔ sina-iru, <verse eid="NEH 7:68" /><verse number="69" style="v" sid="NEH 7:69" />kapuapɔngɔ ɔɖe alafa ana sitɛ-iru gu mafirimu kukpi kukuɔ alafa akɔdzɛ gu sinyɔ.<verse eid="NEH 7:69" /></para>
  <para style="s1">Kuɖɔɛ Ame Karatã Itã Isɔrɛyo Itsue</para>
  <para style="p">
    <verse number="70" style="v" sid="NEH 7:70" />Ayo makpakpa mawɛ̃ ɔtã kuɖɔɛ ame karatã itã karabara. Karɔ̃ nyɔisose ara wa ɔtã masu mapia i karana kakɔlakɔ̃ ame nɖe: sikãrɛtɛa kilo fainafaina gu ɔfã, arɔi siru, masɔrɛdze kato arapia alafa aru gu sitɛ. <verse eid="NEH 7:70" /><verse number="71" style="v" sid="NEH 7:71" />Ara wa i ayo makpakpa mawɛ̃ ɔtã masu mapia i karana kakɔlakɔ̃ ame itã karabara nɖe: sikãrɛtɛa kilo kulafa kuwɛ̃ gu sikɔdzɛ gu sikãfudza lɛ toni ɔwɛ̃. <verse eid="NEH 7:71" /><verse number="72" style="v" sid="NEH 7:72" />Ara wa maturi tsɔra ɔtã ngbe ne: sikãrɛtɛa lɛ toni ɔwɛ̃ sikãfudza lɛ toni ɔwɛ̃ gu masɔrɛdze kato arapia sikuɔ-ikɔdzɛ.<verse eid="NEH 7:72" /></para>
  <para style="b" />
  <para style="s1">Maturi Ka Masi i Ma Kasɛkɔ̃</para>
  <para style="pi">
    <verse number="73" style="v" sid="NEH 7:73" />Ne masɔrɛdze, ma Levise, kayogodɔ̃madzuɛ̃se, akamakadze gu isɔrɛyo maɖabo Israel mabi mawɛ̃ gu maturi ɔɖuɖu ɔkɛlɛ, masɛ maasɛ i ma mɔmɔ simagɛ̃ ame.</para>
  <para style="p" vid="NEH 7:73">Ɔwi wɔ i kuwa kɔdzɛva ɔba ne Israel mabi ka masi i ma simagɛ̃ ame.<verse eid="NEH 7:73" /></para>
  <chapter eid="NEH 7" />
  <chapter number="8" style="c" sid="NEH 8" />
  <para style="s1">Ezra Ɔka Mmara Ɔte Kaɖe</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 8:1" />Ɔwi wɔ i maturi ka masi i ma simagɛ̃ ame ku ma Hebrise kuwa kɔdzɛva, Etanim ame ne, maturi ɔɖuɖu ɔba maasakanya lɛ ɔturi ɔwɛ̃ i ɔgbami wɔ i Ndu Kayogodɔ̃ katɔ̃. Maɣere Ezra, ratsɛrɛse sɔ ɔɖi <char style="nd">Bosate</char> Mmara mɛ ɔtã Israel mabi ɔkigu i Mose iso Ɔko ɔbɔ.<verse eid="NEH 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NEH 8:2" />Ne ɔso sɔrɛdze Ezra, ɔsu Mmara ɔko ɔbɔ iturikuri nɛ losakanya anɔmi ame ku kuwa kɔdzɛva, iyi ɖeakatɔ̃ iso. Iturikuri ɔɖe marɛrɛ̃ i marɔ̃go gu mma loɔmɔ maawo ara karɔ̃ ɔnɔ. <verse eid="NEH 8:2" /><verse number="3" style="v" sid="NEH 8:3" />Ezra ɔka Mmara teteree ɔtã ma i ɔgbami wɔ i Ndu Kayogodɔ̃ katɔ̃, ita i kaya isɛ iabo kakɔme ame i marɛrɛ̃, marɔ̃go gu mamama ma loawo ara karɔ̃ ɔnɔ anɔmi ame. Ne maturi ɔɖuɖu ɔkã Mmara Ɔko ika atsue kukaakɔ.<verse eid="NEH 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 8:4" />Ezra, ratsɛrɛse ɔya i kakɔlɛkɔ̃ bɛbɛɛbɛa ga mabara ala kukolo matã iyi iso. Matitia, Sema, Anaya, Uria, Xilkia gu Maaseya ɔya i ɔ̃ kuɖearɔ̃ iso, ne Pedaya, Misael, Malkiya, Xasum, Xasbadana, Zekaria gu Mesulam ana ɔya i ɔ̃ kubena iso ne.<verse eid="NEH 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NEH 8:5" />Ezra ɔbusi ɔko. Maturi ɔɖuɖu to manya wũ alasɔ ɔya i ngbegɔ lokɔlɛ iɖo ma ɔɖuɖu. Gɔ ɔbusi ɔko ne maturi ɔɖuɖu ɔta maya. <verse eid="NEH 8:5" /><verse number="6" style="v" sid="NEH 8:6" />Ezra ɔle <char style="nd">Bosate</char>, Ɣaa siare, ne maturi ɔɖuɖu ɔkɔlɛ nrɔɔ̃ kato mafɔ kanya sɔ, "Si iba ngbɔ! Si iba ngbɔ!" Kere ne makɔlɛ anɔ mafu i karɔ̃ masumu <char style="nd">Bosate</char> ne.<verse eid="NEH 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NEH 8:7" />Gɔ ame maturi ɔɖuɖu ɔya i ma nsɛkɔ̃ i mmɔ ne, Yesua Bani, Serebia, Yamin, Akub, Sabetai, Xodia, Maaseya, Kelita, Azaria, Yozabad, Xanan gu Pelaya, mma ɔɖuɖu nɖe ma Levise, ɔbuai i maturi iso sɔ si manɔ mmara karɔ̃. <verse eid="NEH 8:7" /><verse number="8" style="v" sid="NEH 8:8" />Maka Ɣaa Mmara i Ɔko ame, matã ikpa fiɛ ka maledza karɔ̃ iɖi kukaakɔ, si maturi aawo nnɛ mato maka karɔ̃ ɔnɔ kukaakɔ.<verse eid="NEH 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NEH 8:9" />Kere ne Nexemia karɔ̃ nyɔisose, sɔrɛdze Ezra gu ratsɛrɛse gu ma Levise ma lote maturi ara ɔɣere kaɖe ɔɖuɖu sɔ, "Ikpɛnɛ nɛgbe se sekelee itã, <char style="nd">Bosate</char>, mi Ɣaa. Midaamararã so ɣee midaabiɛ kaku." Alasɔ maturi ɔɖuɖu ɔbiɛ kaku gɔ mato makã mmara atɔ̃me atsue.<verse eid="NEH 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 8:10" />Ne Nexemia ɔɣere ma sɔ, "Mikɛlɛ, si misɛ miaɖe araɖea sɛɛ si minɛ wain nyɛkɛã, si mitã mma nna kuira maaɖe. Ikpɛnɛ nɛgbe se sekelee itã bo Sate. Midaamararã so, alasɔ isoɣɔ ina i <char style="nd">Bosate</char> iso nɖe mi ɔle."<verse eid="NEH 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NEH 8:11" />Ma Levise ɔɣɔra maturi ɔɖuɖu situ maɣɛ sɔ, "Milokanana, alasɔ ikpɛnɛ nɛgbe se sekelee, midamararã so."<verse eid="NEH 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NEH 8:12" />Kere ne, maturi ɔɖuɖu ɔrui fiɛ makɛlɛ masɛ maaɖe ara manɛ ara, masese maturi mama aɖera fiɛ maɖe iyi mana isoɣɔ gbaã. Ala maɔnɔ ara wa maɣere ma karɔ̃ kukaakɔ.<verse eid="NEH 8:12" /></para>
  <para style="s1">Kukpakɛ Ame Iyiɖea</para>
  <para style="p">
    <verse number="13" style="v" sid="NEH 8:13" />Iyi nyɔare i kuwa ame ne, ayomaturi makpakpa ɔɖuɖu gu masɔrɛdze gu ma Levise ɔsakanya i Ezra ratsɛrɛse kɔrɛ sɔ maakigu wũ i mmara atɔ̃me ame. <verse eid="NEH 8:13" /><verse number="14" style="v" sid="NEH 8:14" />Masɛ maanya sɔ matsɛrɛ masɛ i <char style="nd">Bosate</char> Mmara mɛ ɔtã kaɖe iki i Mose iso sɔ, ikote sɔ Israel mabi aarui masɛ maawe i kukpakɛ ame ku iyiɖea ɔwi i kuwa kɔdzɛva ame, <verse eid="NEH 8:14" /><verse number="15" style="v" sid="NEH 8:15" />si mapɛ itɔ̃me nɛgbe imomo i Yerusalem ɔmagɛ̃siare gu ma simagɛ̃ mama ame sɔ, "Mibɔrɛ mikɛlɛ kabemi karɔ̃ iso. Misɛ miatu nnɔĩ adzirikpai gu aputudziri akpai gu anya akpai gu sikɛ gu adziri mama akpai. Si misɛ miabara kukpakɛ gɔ ame miawe, lɛ kumɛgɔ matsɛrɛ masɛ i mmara ame awe."<verse eid="NEH 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NEH 8:16" />Ne ɔso maturi ɔbɔrɛ makɛlɛ masɛ maatu adzirikpai mabɔ. Masu wã mabara kukpakɛ i ma mɔmɔ ayo asã iso, i ma anyamɔ, gu i Ɣaa iyo kasarɛkɔ̃ i Ndu Kayogodɔ̃ ɔgbami iso gu i Efrayim Kayogodɔ̃ kɔrɛ ɔgbami iso. <verse eid="NEH 8:16" /><verse number="17" style="v" sid="NEH 8:17" />Ne ɔso ikuri ɔɖuɖu nɛ lose i kafɔrɔ̃ iso maba ɔpɛ kukpakɛ, ne masɛ maawe i kɔ̃ ame. Ita i Yosua, Nun ɔbibirɛrɛĩ ɔwi isɛ iabo iyi nɛmɔ iso ne, Israel mabi iiɖe iyi lɛgbe manya. Ne mana isoɣɔ gbaã.<verse eid="NEH 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NEH 8:18" />Ita i iyi ɖeakatɔ̃ iso isɛ iabo iyi tsɔra iso ne, Ezra ɔka ara i Ɣaa Mmara Ɔko ame ku ikpɛnɛ biara. Maɖe iyiɖea ayi akɔdzɛ, iyi fafaranava iso ne, mabara iturikuri isarɛ, i asɛra kanya awe.<verse eid="NEH 8:18" /></para>
  <chapter eid="NEH 8" />
  <chapter number="9" style="c" sid="NEH 9" />
  <para style="s1">Israel Mabi Ɔɖi Ma Akpi Maɣɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 9:1" />Kuwa kɔdzɛ gɔmɔ ame iyi sinyɔnaare iso ne, Israel mabi ɔba maasa so kanya. Manyikanya, mapia ipundusikoto gɔ maɖi sise mafere i ati iso. <verse eid="NEH 9:1" /><verse number="2" style="v" sid="NEH 9:2" />Israel mabi ɔɖe katɔ̃ maɖi so ise i mafɔ ɔɖuɖu kɔrɛ. Ne Israel mabi ɔta maya fiɛ maɖi ma akpi wa mabara gu ma mawa ɔtile maɣɛ. <verse eid="NEH 9:2" /><verse number="3" style="v" sid="NEH 9:3" />Maya i ngbegɔ ame maɣɛ fiɛ maka <char style="nd">Bosate</char>, ma Ɣaa Mmara Ɔko matã ma, ifɔ siɖɔwũ itɛ. Siɖɔwũ itɛ mama i mmara ika kama ne, maɖi ma akpi maɣɛ, ne masumu <char style="nd">Bosate</char>, ma Ɣaa ne. <verse eid="NEH 9:3" /><verse number="4" style="v" sid="NEH 9:4" />Ma Levise ɔya i asɛtiĩ iso, mmɔ i Yesua, Bani, Kadmiel, Sebania, Buni, Serebia, Bani gu Kenani - ɔya ne makparamakayi ku silɔ teteree matã <char style="nd">Bosate</char> ma Ɣaa ne. <verse eid="NEH 9:4" /><verse number="5" style="v" sid="NEH 9:5" />Ne ma Levise - Yesua, Kadmiel, Bani, Xasabneya, Serebia, Xodia, Sebania gu Petaxia - ɔlakulu maɣɛ sɔ, “Mita miya si mile <char style="nd">Bosate</char>, mi Ɣaa, nwɔ mpia ɔwi daaro ikɛlɛ ɔwi daaro."</para>
  <para style="s1" vid="NEH 9:5">Akpi Iɖiiɣɛ Kayiikparama</para>
  <para style="pm" vid="NEH 9:5">"Maale fɔ iyere nɛ mba ɔle, fiɛ maakɔlɛ ne kato maɖo kusɛkusɛ gu ile ɔɖuɖu.<verse eid="NEH 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 9:6" />Fɔ ɔnɔwɛ̃saã nɖe <char style="nd">Bosate</char>. Fɔ lobara kato, ta kato dzoroo gu kã awãmi akuri ara ɔɖuɖu. Fɔ lobara karɔ̃ gu ɔpo gu ara ɔɖuɖu wa mpia i karɔ̃ iso gu ɔpo ame. Fɔ nsɛ atã irabiara ngbã. Kato ara akuri siare sɛ asumu-ɔ.<verse eid="NEH 9:6" /></para>
  <para style="pm">
    <verse number="7" style="v" sid="NEH 9:7" />"Fɔ nɖe <char style="nd">Bosate</char>, Ɣaa, nwɔ loɖi Abram fiɛ akɔ wũ abɔrɛgu i Ur i Kaldea karɔ̃ iso fiɛ afirikira ɔ̃ iyere sɔ Abraham. <verse eid="NEH 9:7" /><verse number="8" style="v" sid="NEH 9:8" />Anya ɔ̃ ɔtu sɔ ɔɖe ɔnukuare ɔtã-ɔ fiɛ akãgu wũ ndamu, sɔ aasu ma Kanaanse, ma Xitise, ma Amorise, ma Perizise, ma Yebuse gu ma Girgasise nrɔ̃ atã ɔ̃ ɔkparɛ. Ɔɔmɔɛ̃ fɔ kaɣɛkasɛ ala alasɔ ase bɔlɔlɔ.<verse eid="NEH 9:8" /></para>
  <para style="pm">
    <verse number="9" style="v" sid="NEH 9:9" />"Anya kumɛgɔ i bo mawa ɔwe inyɛ i Egipte karɔ̃ iso. Anɔ ma ibiɛ kulu i Ɔpo Rɛtɛa kanya. <verse eid="NEH 9:9" /><verse number="10" style="v" sid="NEH 9:10" />Abara awawã akparĩ gu awawãra siare asu ata aya i Igarakpakpa iso gu ɔ̃ maɖabo gu ɔ̃ karɔ̃ iso maturi ɔɖuɖu iso, alasɔ aɣe ma Egiptese amumuɔ gu iteso i ma iso. Iki ara wagbe iso atã fɔ iyere ɔre kayi fiɛ ise ngbɔ ipɛ nɔme. <verse eid="NEH 9:10" /><verse number="11" style="v" sid="NEH 9:11" />Aɣɛ ɔpo ndɛ̃ i ma katɔ̃, ne maki i karɔ̃ korea iso mafe. Ɣɛɛ mma ntere masiai ma ne, atã masɛ ndu i ngɔi mɛ lowodoro lɛ kumɛgɔ i ita sɛ iwã ikɛlɛ ndu gbodzoo karɔ̃ awe. <verse eid="NEH 9:11" /><verse number="12" style="v" sid="NEH 9:12" />Atã adɔdɔ wa lomini ibo ɔkɔ ma i ikpɛnɛ ame fiɛ kasɛ̃ ne, afiɛ ate ma ɔtɔ i ɔri wɔ maaki iso.<verse eid="NEH 9:12" /></para>
  <para style="pm">
    <verse number="13" style="v" sid="NEH 9:13" />"Aso abɔrɛ i kato aba i Sinai Kube iso. Aɖe ma ika abɔrɛgu i kato. Atã ma asɛra gu mmara wa loya fiɛ ase bɔlɔlɔ fiɛ atã ma asɛ̃ra gu mmaraisi wa nlɛ. <verse eid="NEH 9:13" /><verse number="14" style="v" sid="NEH 9:14" />Atã matsue fɔ iwarãyi sekelea fiɛ atã ma mmaraisi gu asɛ̃ra gu mmara akigu i fɔ ɔɖabo Mose iso. <verse eid="NEH 9:14" /><verse number="15" style="v" sid="NEH 9:15" />Gɔ kukã ɔkpɛ̃ ma ne, atã ma aɖera wa lobɔrɛ i kato fiɛ gɔ ɔme ɔkore ma ne, atã ndu ɔbɔrɛ i ita ame mitã ma. Aɣere ma sɔ makɛlɛ masɛ maafɔ karɔ̃ ga akã ndamu ku fɔ kɔrɔ̃ gɔ akɔlɛ kato atã ma sɔ aatã ma.<verse eid="NEH 9:15" /></para>
  <para style="pm">
    <verse number="16" style="v" sid="NEH 9:16" />"Ɣɛɛ ma, bo mawa ɔkɔlɛ so kato fiɛ mawe ɔnɔle, ne masɛ̃ maiwarɛ fɔ silɔ dzɛ atã ma ne. <verse eid="NEH 9:16" /><verse number="17" style="v" sid="NEH 9:17" />Masɛ̃ sɔ maito makã atsue. Maɣara awawãra ɔɖuɖu wa abara i ma ndɛ̃. Mabara ɔnɔle fiɛ i ma itaiyaiso ame ne, maɖi tɔ̃ɖedze sɔ si ɔkɔ ma si makpese makɛlɛ ma sisande ame. Ɣɛɛ fɔ ne, Ɣaa wɔ losu akpi ɔtsɛ aɖe. Abualɛra gu nnyainyɔ ɔyi i fɔ ame, aisɛ ana sikpã malamala, ayigu kuɖɔɛ gbaã. Ne ɔso ainyua ma asɛ. <verse eid="NEH 9:17" /><verse number="18" style="v" sid="NEH 9:18" />Atoasɔ mabara inantsuĩbi kumiamia irapɔa matã so fiɛ maɣɛ sɔ, 'Nnɛgbe nɖe mi ɣaa, nwɔ loɖi mi ɔbɔrɛgu i Egipte karɔ̃ iso ne,' ɣee si mabara imusuora gbaã ne ainyua ma asɛ.<verse eid="NEH 9:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="NEH 9:19" />"Ala fɔ nnyainyɔ siare ɔso ne ainyua ma asɛ i fafuĩ ame. Aitã adɔdɔ wa lomini aɖe ma katɔ̃ ku ikpɛnɛ ame ɔnyua ma ikɔ i ma ɔri iso ɣee aitã ɔtɔ wɔ lofiɛ ɔfere i ɔri wɔ iso maaki, ku kasɛ̃ ɔrui i ma kɔrɛ. <verse eid="NEH 9:19" /><verse number="20" style="v" sid="NEH 9:20" />Atã sɔ fɔ Siwarã sɛɛ, si site ma ara. Aiɖi fɔ mana i ma nnya ame fiɛ atã ma ndu i ma kutukã ame manɛ. <verse eid="NEH 9:20" /><verse number="21" style="v" sid="NEH 9:21" />Anyɔ ma iso akɔ sina gɔ mawe i fafuĩ ame, kuira iinya ma. Arapia iikpi i ma iso fiɛ ma ngba iiɣe.<verse eid="NEH 9:21" /></para>
  <para style="pm">
    <verse number="22" style="v" sid="NEH 9:22" />"Atã ma sigarakuɖekɔ̃ gu nɖebi. Atã mafɔ nɖebi mɛ nse ame dzoroo ku ma nrɔ̃. Atã mafɔ Xesbon igara Sixon karɔ̃, atã mafɔ Basan igara Og karɔ̃. <verse eid="NEH 9:22" /><verse number="23" style="v" sid="NEH 9:23" />Atã ma mabi ɔsi lɛ awãmi wa i kuɖokpo awe. Ne akɔ ma abɔ i karɔ̃ ga iso aɣere ma mawa sɔ makɛlɛ masɛ maabo si mafɔ. <verse eid="NEH 9:23" /><verse number="24" style="v" sid="NEH 9:24" />Ma ɔkparɛ losɛ maafɔ karɔ̃. Ne asu ma Kanaanse ma nsi i karɔ̃ iso, apia i ma nrɔɔ̃ ame. Asu ma Kanaanse, ibua i ma magara iso gu ma maturi apia i fɔ maturi nrɔɔ̃ ame sɔ mabara ma lɛ maɖɔɛ. <verse eid="NEH 9:24" /><verse number="25" style="v" sid="NEH 9:25" />Mamɔɛ̃ simagɛ̃siare dzɛ mba ɔle gu nrɔ̃ mɛ nlɛ, ne masu ayo wa ame loyigu ara sɛɛ agbaãagbã. Mafɔ abiɔ wa maɔkuri masɛ, wainnkpɛkɔ̃ gu oliva nkpɛkɔ̃ gu aɖedziribi gbodzoo. Maɖe ara, mami, mana so, ne maɖe kayi gbaã ku ara sɛɛ gbodzoo wa atã ma.<verse eid="NEH 9:25" /></para>
  <para style="pm">
    <verse number="26" style="v" sid="NEH 9:26" />"Ɣɛɛ ne maikã-ɔ atsue ne mata maya-ɔ iso, makpa fɔ mmara masɛ i kama. Maɖue fɔ kanyamaɖidze ma lotã ma kuka sɔ si makpese maba fɔ kɔrɛ. Ne mabara amusuora wa nna iɣɛ. <verse eid="NEH 9:26" /><verse number="27" style="v" sid="NEH 9:27" />Ne ɔso asu ma apia i ma matsirise nrɔɔ̃ ame fiɛ mawedza ma inyɛ. Ɣɛɛ gɔ mato mawedza ma inyɛ ne, mabiɛ malakulu makpere-ɔ. Anɔ ma kulu abɔrɛgu i kato, ne i fɔ nnyainyɔ gbodzoo ame ne atã ma maɖidze, mma loɖi ma i ma matsirise nrɔɔ̃ ame.<verse eid="NEH 9:27" /></para>
  <para style="pm">
    <verse number="28" style="v" sid="NEH 9:28" />"Ɣɛɛ kumɛgɔ ame mana iwarã ne, masɛ mabara ikpi i fɔ anɔ. Kere ne anyua ma asɛ makɛlɛ maabo i ma matsirise nrɔɔ̃ ame si matsirise si maɖe ma iso. Ne gɔ mabiɛ malakulu makpere-ɔ ana ne, anɔ ma kulu i kato, ne i fɔ nnyainyɔ gbodzoo ame asɛ aɖi ma ɔwi ku ɔwi ame.<verse eid="NEH 9:28" /></para>
  <para style="pm">
    <verse number="29" style="v" sid="NEH 9:29" />"Atã ma kuka sɔ si makpese maba i fɔ mmara kɔrɛ. Ɣɛɛ ne makɔlɛ so kato fiɛ maiwarɛ fɔ mmara. Maɣɛrɛ fɔ mmara mɛ nsɛ mitã ɔturi ɔwe ngbã si ɔwarɛ me. Ku ma ɔnɔle ne mapɛ ma kama mafirikira matã-ɔ, ne maka simɔ fiɛ masɛ̃ sɔ maibakã atsue. <verse eid="NEH 9:29" /><verse number="30" style="v" sid="NEH 9:30" />Aɣara so atã ma akɔ gbodzoo. Asu fɔ Siwarã atã ma kuka akigu i fɔ kanyamaɖidze iso. Ɣɛɛ masɛ̃, mainɔ, ne ɔso asu ma apia i magbamikui nɖebi nrɔɔ̃ ame. <verse eid="NEH 9:30" /><verse number="31" style="v" sid="NEH 9:31" />Ɣɛɛ ala fɔ nnyainyɔ gbodzoo ɔso ne, aiwɔra ma ɣee anyua ma asɛ alasɔ fɔ ne, abualɛra gu nnyainyɔ Ɣaa aɖe.<verse eid="NEH 9:31" /></para>
  <para style="pm">
    <verse number="32" style="v" sid="NEH 9:32" />"Ne ɔso kiniɔ ne, Ao, bo Ɣaa, ɔsiare, ɔlesate gu Ɣaa wɔ nɖe ifɔ̃ra, fɔ wɔ nsɛ amɔɛ̃ fɔ ndamu ku fɔ kuɖɔɛ gɔ loisɛ kufiriki ala, daatã inyɛwe ɔɖuɖu nɛ loba i bo iso, bo magara, bo makpakpaturi, bo masɔrɛdze gu kanyamaɖidze, tete mɛrɛ̃ gu fɔ maturi ɔɖuɖu iso, ita i Asiria magara ɔwi iba iabo nɔme, si iɖe idzɛ i fɔ anɔmi ame. <verse eid="NEH 9:32" /><verse number="33" style="v" sid="NEH 9:33" />Fɔ ɔkpɛ ɔya gɔ ara ɔɖuɖu wagbe ɔba i bo iso. Nnɛ ikote sɔ aabara i ɔnukuare ɔri iso iɖe abara. Bo ɣɛɛ ne, ira nɛ loilɛ bobara. <verse eid="NEH 9:33" /><verse number="34" style="v" sid="NEH 9:34" />Bo magara, bo matɔ̃ɖedze, bo masɔrɛdze gu bo mawa mɛrɛ̃ iibara i fɔ mmara iso. Maikã fɔ mmaraisi gu fɔ kuka gɔ atã ma atsue. <verse eid="NEH 9:34" /><verse number="35" style="v" sid="NEH 9:35" />Atoa ɔwi wɔ mapia i ma sigarakaɖekɔ̃ ame kɔraa, fiɛ mato maɖe ara sɛɛ gbodzoo wa atã ma i karɔ̃ sɛɛ ga lobɛ kafere kɔraa ne, maisumu-ɔ ɣee maifiriki i ma siri nyanyariã iso.<verse eid="NEH 9:35" /></para>
  <para style="pm">
    <verse number="36" style="v" sid="NEH 9:36" />"Ɣɛɛ ka nyɔ bo, boɔkpese masande nɔme, masande i karɔ̃ ga asu atã bo mawa sɔ maɖe kã iso aɖedziribi gu ara sɛɛ mama wa kasɛ katã. <verse eid="NEH 9:36" /><verse number="37" style="v" sid="NEH 9:37" />Ala bo akpi ɔso ne, karɔ̃ ara sɛɛ gbodzoo wa nsɛ abɔrɛ i kã ame sɛ akɛlɛ magara ma kayirinɔ asu bo apia kɔrɛ. Magara magbe sɛ maɖe bo iso gu bo ayomabɔi iso lɛ kumɛgɔ maɖɔɛ. Bopia i imɔrɛ̃ siare ame gbaã.<verse eid="NEH 9:37" /></para>
  <para style="s1">Kaɖe Ɔkã Ndamu</para>
  <para style="p">
    <verse number="38" style="v" sid="NEH 9:38" />"Ara ɔɖuɖu wa loba ɔso ne, boto bokã ndamu mɛ loanyi bo, botsɛrɛ bosɛ, fiɛ bo matɔ̃ɖedze, bo ma Levise gu bo masɔrɛdze aapia kɔrɔ̃ i ne kayirinɔ."<verse eid="NEH 9:38" /></para>
  <chapter eid="NEH 9" />
  <chapter number="10" style="c" sid="NEH 10" />
  <para style="p">
    <verse number="1" style="v" sid="NEH 10:1" />Maturi ma lopia kɔrɔ̃ i ndamu kayirinɔ loɖe:</para>
  <para style="b" vid="NEH 10:1" />
  <para style="li1" vid="NEH 10:1">Abã karɔ̃ nyɔisose Nexemia, Xakalia ɔbibirɛrɛĩ.</para>
  <para style="b" vid="NEH 10:1" />
  <para style="li1" vid="NEH 10:1">Zedekia, <verse eid="NEH 10:1" /><verse number="2" style="v" sid="NEH 10:2" />Seraya, Azaria, Yeremia,<verse eid="NEH 10:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="NEH 10:3" />Pasxur, Amaria, Malkiya,<verse eid="NEH 10:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="NEH 10:4" />Xatus, Sebania, Maluk,<verse eid="NEH 10:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="NEH 10:5" />Xarim, Meremot, Obadia,<verse eid="NEH 10:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="NEH 10:6" />Daniel, Gineton, Baruk,<verse eid="NEH 10:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="NEH 10:7" />Mesulam, Abiya, Miyamin,<verse eid="NEH 10:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="NEH 10:8" />Maazia, Bilgai gu Semaya.</para>
  <para style="li1" vid="NEH 10:8">Ma loɖe masɔrɛdze ne.<verse eid="NEH 10:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="NEH 10:9" />Ma Levise loɖe:</para>
  <para style="b" vid="NEH 10:9" />
  <para style="li1" vid="NEH 10:9">Azania ɔbibirɛrɛĩ Yesua, Binui wɔ lobɔrɛ i Xenadad ɔkparɛ ame gu Kadmiel,<verse eid="NEH 10:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="NEH 10:10" />ma maturi mama loɖe: Sebania,</para>
  <para style="li1" vid="NEH 10:10">Xodia, Kelita, Pelaya, Xanan,<verse eid="NEH 10:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="NEH 10:11" />Mika, Rexob, Xasabia,<verse eid="NEH 10:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="NEH 10:12" />Zakur, Serebia, Sebania,<verse eid="NEH 10:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="NEH 10:13" />Xodia, Bani gu Beninu.<verse eid="NEH 10:13" /></para>
  <para style="b" />
  <para style="m">
    <verse number="14" style="v" sid="NEH 10:14" />Kaɖe matɔ̃ɖedze loɖe:</para>
  <para style="b" vid="NEH 10:14" />
  <para style="li1" vid="NEH 10:14">Paros, Paxat-Moab, Elam, Zatu, Bani<verse eid="NEH 10:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="NEH 10:15" />Buni, Azgad, Bebai,<verse eid="NEH 10:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="NEH 10:16" />Adoniya, Bigvai, Adin,<verse eid="NEH 10:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="NEH 10:17" />Ater, Xezekia, Azur,<verse eid="NEH 10:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="NEH 10:18" />Xodia, Xasum, Bezai,<verse eid="NEH 10:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="NEH 10:19" />Xarif, Anatot, Nebai,<verse eid="NEH 10:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="NEH 10:20" />Magpias, Mesulam, Xezir,<verse eid="NEH 10:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="NEH 10:21" />Mesezabel, Zadok, Yadua,<verse eid="NEH 10:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="NEH 10:22" />Pelatia, Xanan, Anaya<verse eid="NEH 10:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="NEH 10:23" />Xosea, Xanania, Xasub,<verse eid="NEH 10:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="NEH 10:24" />Xaloxes, Pilxa, Sobek,<verse eid="NEH 10:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="NEH 10:25" />Rexum, Xasabna, Maaseya,<verse eid="NEH 10:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="NEH 10:26" />Axiya, Xanan, Anan,<verse eid="NEH 10:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="NEH 10:27" />Maluk, Xarim gu Baana.<verse eid="NEH 10:27" /></para>
  <para style="b" />
  <para style="s1">Maturi Ɔkã Ndamu</para>
  <para style="pm">
    <verse number="28" style="v" sid="NEH 10:28" />"Maturi tsɔra - masɔrɛdze, ma Levise, kayogodɔ̃madzuɛ̃se, akamakadze, isɔrɛyo maɖabo gu maturi ɔɖuɖu ma loɖi so ise mabɔrɛgu i nɖebi mama mɛ i karɔ̃ iso ame i Ɣaa Mmara iti, ɔbara atɔ̃menyia. Ma mare gu ma mabirɛrɛĩ i mabirɔ̃gomi ɔɖuɖu ma nsɛ mawo ara karɔ̃ ɔnɔ ana ɔwe i ne ame. <verse eid="NEH 10:28" /><verse number="29" style="v" sid="NEH 10:29" />Mmagbe ɔɖuɖu ɔbua i ma manyii makpakpaturi, ne makã ndamu gu sigbarĩ manyi so sɔ maasɛ i Ɣaa Mmara mɛ ɔtã ɔkigu i ɔ̃ ɔɖabo Mose iso kukaakɔ. Ibua ne sɔ maamɔɛ̃ <char style="nd">Bosate</char> bo Ɣaa, mmaraisi, asɛra, gu asɛ̃ra ɔɖuɖu bola.<verse eid="NEH 10:29" /></para>
  <para style="pm">
    <verse number="30" style="v" sid="NEH 10:30" />"Boɣɛ bosɛ sɔ boibasu bo mabibirɔ̃gomi botã nɖebi mɛ loki milɔ bo maturi sɔ mayiri fiɛ ngbɔ ame boibatã bo mabibirɛrɛĩ ɔyiri ma mabibirɔ̃gomi ana ne.<verse eid="NEH 10:30" /></para>
  <para style="pm">
    <verse number="31" style="v" sid="NEH 10:31" />"Si nɖebi mɛ loki milɔ bo maturi ɔsu ma kuɣaiɖe ara ɣee ɔraɖui mabɔ ku iwarãyi ɣee iyi sekelea iso gɔ maarɔdɛ̃ ne, boibaɣa wã. Ikɔ kɔdzɛva biara ame ne, boibakpɛ̃ karɔ̃ fiɛ boasu aso ɔɖuɖu botsɛ.<verse eid="NEH 10:31" /></para>
  <para style="pm">
    <verse number="32" style="v" sid="NEH 10:32" />"Boɔsu bosia so iso sɔ ikɔ biara ne, boatã sikãfudza gram ina masu mabara ara itã kasumu i bo Ɣaa iyo ame. <verse eid="NEH 10:32" /><verse number="33" style="v" sid="NEH 10:33" />Boatã isɔrɛyo boɖoboɖo wɔ nsɛ masia i ɔpɔrɔ̃ iso, itã iyi biara geɖebu asɔrɛ gu araifɛ̃ asɔrɛ gu asɔrɛ ku Iwarã ayi, Ɔgbaleti Ɣɛtɛ asɔrɛ gu ayiɖea wa masɛ, asɔrɛ sekelea; itã ikpi asɔrɛ si masu mabara ikpikusoisɔrɛ itã Israel mabi akpi gu itã bo Ɣaa iyo karabara ɔɖuɖu.<verse eid="NEH 10:33" /></para>
  <para style="pm">
    <verse number="34" style="v" sid="NEH 10:34" />"Bo masɔrɛdze, ma Levise gu maturi - ɔɔbara kareremi si botsue ɔwi wɔ i bo iyomaturi biara aasu ndɔrɛ̃ mabɔ i <char style="nd">Bosate</char> bo Ɣaa iyo ku ikɔ biara. Bobara kumɛɔ gɔ maasɔrɛ ara i isɔrɛkasege iso, lɛ matsɛrɛ mapia i Mmara ame.<verse eid="NEH 10:34" /></para>
  <para style="pm">
    <verse number="35" style="v" sid="NEH 10:35" />"Boto bosu bosia so iso sɔ bo ɔraɖui ɖeakatɔ̃ gu bo aɖedziribi ɖeakatɔ̃ ku ikɔ biara ame ne, boasu wã bobɔ i <char style="nd">Bosate</char> iyo ame.<verse eid="NEH 10:35" /></para>
  <para style="pm">
    <verse number="36" style="v" sid="NEH 10:36" />"Lɛ kumɛgɔ matsɛrɛ masɛ i Mmara ame ana awe ne, boasu bo abiete gu bo manantsuĩ abi ɖeakatɔ̃ gu bo masɛrɛrerɔ̃ abi ɖeakatɔ̃ gu bo kutepui abi ɖeakatɔ̃ bobɔ i bo Ɣaa iyo. Iaɖe masɔrɛdze ma nto mabara kasumu karabara i mmɔ ɔkpɛ. <verse eid="NEH 10:36" /><verse number="37" style="v" sid="NEH 10:37" />"Ngbɔ ame boto boasu siraũ ɖeakatɔ̃, bo geɖebu asɔrɛ ɖeakatɔ̃, bo aɖedziribi igbã biara, bo wain gu bo nnɔĩ ɖeakatɔ̃ bosu bokɛlɛgu masɔrɛdze i bo Ɣaa iyo ame. Boto boatã ma Levise bo ɔraɖui ikaweova, mma nsɛ mafɔ ara ikaweova i bo simagɛ̃ ɔɖuɖu dzɛ ame bosɛ bobara karabara. <verse eid="NEH 10:37" /><verse number="38" style="v" sid="NEH 10:38" />Si ma Levise to mafɔ ara ikaweova ne, ikote sɔ sɔrɛdze wɔ nɖe Aron ɔkparɛ aawe i ma ndɛ̃. Ma Levise aasu ara ikaweova ɔɖuɖu wa mafɔ ikaweova makɛlɛgu i arakakɔlakɔ̃ ayo ame i bo Ɣaa iyo ame. <verse eid="NEH 10:38" /><verse number="39" style="v" sid="NEH 10:39" />Israel maturi ibua i ma Levise aasu karatã wa mato, geɖebu, wain ɣɛtɛ gu nnɔĩ makɛlɛgu i arakakɔlakɔ̃ ngbegɔ masɛ isɔrɛyo ara. Ana ne maasɛ wã i ayo wa ame i masɔrɛdze ma nto mabara kasumu karabara gu kayogodɔ̃madzuɛ̃se gu akamakadze sɛ mawe ame.</para>
  <para style="pm" vid="NEH 10:39">"Boibanyua bo Ɣaa iyo bosɛ."<verse eid="NEH 10:39" /></para>
  <chapter eid="NEH 10" />
  <chapter number="11" style="c" sid="NEH 11" />
  <para style="s1">Maturi Ma Lowe i Yerusalem</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 11:1" />Kiniɔ ne Israel kaɖe matɔ̃ɖedze ɔsɛ i Yerusalem ɔmagɛ̃siare ame. Ne maturi tsɔra ame ne, ɔturi weova biara wɔ iso i kareremi ɔsia ne, ikote sɔ ɔ̃arui ɔsɛ ɔ̃asɛ i Yerusalem, ɔmagɛ̃siare sekelea ame. Iyɔ maturi kaiwɛ̃ tsɔra ne maawe i ma mɔmɔ simagɛ̃ ame. <verse eid="NEH 11:1" /><verse number="2" style="v" sid="NEH 11:2" />Kaɖe ɔle maturi ɔɖuɖu ma lotɔrã ku kuɖɔɛ sɔ maawe i Yerusalem ɔmagɛ̃siare ame.<verse eid="NEH 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NEH 11:3" />Mmagbe nɖe abuiti manyoisose ma losɛ i Yerusalem (kiniɔ ne Israel mabi mawɛ̃, masɔrɛdze, ma Levise, isɔrɛyo maɖabo gu Solomon maɖabo ɔkparɛ ɔsɛ i Yuda simagɛ̃ ame, ɔbiara ɔsɛ i ɔ̃ ara iso i ma mɔmɔ simagɛ̃ ame. <verse eid="NEH 11:3" /><verse number="4" style="v" sid="NEH 11:4" />Gɔ ise lɛgbe ne maturi mama ɔbɔrɛ i Yuda gu Benyamin nrɔ̃ ame maba maasɛ i Yerusalem).</para>
  <para style="b" vid="NEH 11:4" />
  <para style="m" vid="NEH 11:4">Maturi ma lobɔrɛ i Yuda ɔkparɛ ame loɖe:</para>
  <para style="b" vid="NEH 11:4" />
  <para style="mi" vid="NEH 11:4">Uzia ɔbibirɛrɛĩ Ataya, Zekaria ɔwabirɛrɛĩ, Amaria ɔbibirɛrɛĩ Zekaria, Sefatia ɔbibirɛrɛĩ Amaria, Maxalalel ɔbibirɛrɛĩ Amaria wɔ lobɔrɛ i Perez ɔkparɛ ame. <verse eid="NEH 11:4" /><verse number="5" style="v" sid="NEH 11:5" />Baruk ɔbibirɛrɛĩ Maaseya, nwɔ loɖe Kol-Xoze ɔwabirɛrɛĩ, Xazaya ɔbibirɛrɛĩ Kol-Xoze, Adaya ɔbibirɛrɛĩ Xazaya, Yoyarib ɔbibirɛrɛĩ Adaya, Zekaria ɔbibirɛrɛĩ Yoyarib, ɔɖe Sela ɔkparɛ. <verse eid="NEH 11:5" /><verse number="6" style="v" sid="NEH 11:6" />Perez ɔkparɛ wɔ losɛ i Yerusalem ɔɖe iwobara marɛrɛ̃ alafa ana sikuɔ-farafana.<verse eid="NEH 11:6" /></para>
  <para style="b" />
  <para style="m">
    <verse number="7" style="v" sid="NEH 11:7" />Benyamin ɔkparɛ ame maturi ma lorui maba Yerusalem loɖe:</para>
  <para style="b" vid="NEH 11:7" />
  <para style="mi" vid="NEH 11:7">Mesulam ɔbibirɛrɛĩ Salu, Yoed ɔwabirɛrɛĩ, Pedaya ɔbibirrɛĩ Yoed, Kolaya ɔbibirɛrɛĩ Pedaya, Maaseya ɔbibirɛrɛĩ Kolaya, Itiel ɔbibirɛrɛĩ Maaseya, Yesaya ɔbibirɛrɛi Itiel, <verse eid="NEH 11:7" /><verse number="8" style="v" sid="NEH 11:8" />ɔ̃ masiaidze loɖe: Gabai gu Salai. Ne ɔso Benyamin kamele marɛrɛ̃ ɔɖe alafa kaiwɛ̃ gu sinyɔ-farafana. <verse eid="NEH 11:8" /><verse number="9" style="v" sid="NEH 11:9" />Ma tɔ̃ɖedze loɖe Yoel, Zikri ɔbibirɛrɛĩ, ne Xasenua ɔbibirɛrɛĩ Yuda loɖe ɔmagɛ̃siare Ibuiti Nyɔare nyɔisose.<verse eid="NEH 11:9" /></para>
  <para style="b" />
  <para style="m">
    <verse number="10" style="v" sid="NEH 11:10" />Masɔrɛdze ame ne:</para>
  <para style="b" vid="NEH 11:10" />
  <para style="mi" vid="NEH 11:10">Yoyarib ɔbibirɛrɛĩ Yedaya, Yakin; <verse eid="NEH 11:10" /><verse number="11" style="v" sid="NEH 11:11" />Xilkia ɔbibirɛrɛĩ Seraya, Mesulam ɔbibirɛrɛĩ Xilkia, Zadok ɔbibirɛrɛĩ Mesulam, Merayot ɔbibirɛrɛĩ Zadok, Axitub ɔbibirɛrɛĩ Merayot. Axitub wɔgbe ɔɖe ara nyɔisose i Ɣaa iyo ame. <verse eid="NEH 11:11" /><verse number="12" style="v" sid="NEH 11:12" />Yedaya, Yakin gu Seraya mɛrɛ̃ manyii, ma lobara karabara i Ɣaa iyo ame ɔɖe marɛrɛ̃ alafa farafana gu sinyɔ-inyɔ. Yeroxam ɔbibirɛrɛĩ Adaya, ɔɖe Pelalia ɔwabirɛrɛĩ, Amzi ɔbibirɛrɛĩ Pelalia, Zekaria ɔbibirɛrɛĩ Amzi, Pasxur ɔbibirɛrɛĩ Zekaria, Malkiya ɔbibirɛrɛĩ Pasxur. <verse eid="NEH 11:12" /><verse number="13" style="v" sid="NEH 11:13" />Ne Adaya manyii ma loɖe ayomaturi makpakpa ɔɖe alafa anyɔ gu sina-inyɔ. Azarel ɔbibirɛrɛĩ Amasai, ɔɖe Azai ɔwabirɛrɛĩ, Mesilemot ɔbibirɛrɛĩ Azai, nwɔ nɖe Imer ɔbibirɛrɛĩ. <verse eid="NEH 11:13" /><verse number="14" style="v" sid="NEH 11:14" />Ne Amasai manyii ɔɖe iwobara marɛrɛ̃ kulafa kuwɛ̃ gu sinyɔ-farafana. Ma tɔ̃ɖedze loɖe Xagedolim ɔbibirɛrɛĩ Zabdiel.<verse eid="NEH 11:14" /></para>
  <para style="b" />
  <para style="m">
    <verse number="15" style="v" sid="NEH 11:15" />Ma Levise ame ne:</para>
  <para style="mi" vid="NEH 11:15">Xasub ɔbibirɛrɛĩ Semaya, Azrikam ɔwabirɛrɛĩ, Xasabia ɔbirirɛrɛĩ Azrikam, fiɛ Xasabia ɔse nɖe Buni. <verse eid="NEH 11:15" /><verse number="16" style="v" sid="NEH 11:16" />Sabetai gu Yozabad ɔɖe ma Levise makpakpa inyɔ mawɛ̃ ma lonyɔ Ɣaa iyo inyamɔ karabara iso. <verse eid="NEH 11:16" /><verse number="17" style="v" sid="NEH 11:17" />Mika ɔbibirɛrɛĩ Matania, ɔɖe Zabdi ɔwabirɛrɛĩ, fiɛ Zabdi ɔɖe Asaf ɔbibirɛrɛĩ. Asaf nsɛ ɔɖe katɔ̃ i sibaipɛ aka gu kayiikparama ame. Maɖi Bakbukia ɔɖe ɔnyɔare i ɔ̃ manyii ndɛ̃; Samua ɔbibirɛrɛĩ Abda, Galal ɔbibirɛrɛĩ Samua fiɛ Yedutun ɔbibirɛrɛĩ Galal. <verse eid="NEH 11:17" /><verse number="18" style="v" sid="NEH 11:18" />Ma Levise ma i ɔmagɛ̃siare sekelea ame kukame ɔɖe maturi alafa anyɔ fasinafasina-ina.<verse eid="NEH 11:18" /></para>
  <para style="b" />
  <para style="m">
    <verse number="19" style="v" sid="NEH 11:19" />Kayogodɔ̃madzuɛ̃se loɖe:</para>
  <para style="b" vid="NEH 11:19" />
  <para style="mi" vid="NEH 11:19">Akub, Talmon gu ma manyii mawɛ̃ ma lodzuɛ̃ kuyogodɔ̃. Ma ɔɖuɖu kukame ɔɖe marɛrɛ̃ kulafa kuwɛ̃ gu sikɔdzɛ-inyɔ.<verse eid="NEH 11:19" /></para>
  <para style="b" />
  <para style="p">
    <verse number="20" style="v" sid="NEH 11:20" />Israel mabi tsɔra gu masɔrɛdze tsɔra gu ma Levise tsɔra ɔsame mabo i Yuda simagɛ̃ ame, ɔbiara ɔwe i ɔ̃ mɔmɔ mawa karɔ̃ iso.<verse eid="NEH 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NEH 11:21" />Isɔrɛyo maɖabo ɔsɛ i Ofel kabemi iso, Zixa gu Gispa loya ma i kanya.<verse eid="NEH 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NEH 11:22" />Ma Levise ma lowe i Yerusalem tɔ̃ɖedze loɖe Uzi, Bani ɔbibirɛrɛĩ wɔ nɖe Xasabia ɔwabirɛrɛĩ, Xasabia ɔɖe Matania ɔbibirɛrɛĩ fiɛ Matania ɔɖe Mika ɔbibirɛrɛĩ. Uzi ɔbɔrɛ i Asaf ɔkparɛ ame, ma loɖe akamakadze ma i Ɣaa iyo ame kasumu ɔnyɔ. <verse eid="NEH 11:22" /><verse number="23" style="v" sid="NEH 11:23" />Igara ɔbara mmara i akamakadze iso gu kumɛgɔ maabara ma ikpɛnɛ biara karabara iso.<verse eid="NEH 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NEH 11:24" />Mesezabel ɔbibirɛrɛĩ Petaxia, nwɔ loɖe Yuda ɔbibirɛrɛĩ Zera ɔkparɛ loɖe Igara ɔturi wɔ lonyɔ atɔ̃me ɔɖuɖu wa lopɛgu Israel mabi igara kayirinɔ.<verse eid="NEH 11:24" /></para>
  <para style="s1">Maturi Ma Losɛ i Simagɛ̃ Mama Ame</para>
  <para style="p">
    <verse number="25" style="v" sid="NEH 11:25" />Kumagɛĩ ku kɔ̃ nrɔ̃ ne, Yuda maturi mawɛ̃ ɔsɛ i Kiriat Arba gu nsɛkɔ̃ mɛ loki milɔ mmɔ, i Dibon gu ɔ̃ nsɛkɔ̃, i Yekabzeel gu ɔ̃ kumagɛĩ, <verse eid="NEH 11:25" /><verse number="26" style="v" sid="NEH 11:26" />i Yesua, i Molada gu i Bet Pelet, <verse eid="NEH 11:26" /><verse number="27" style="v" sid="NEH 11:27" />i Xazar Sual, Beerseba gu ɔ̃ nsɛkɔ̃, <verse eid="NEH 11:27" /><verse number="28" style="v" sid="NEH 11:28" />i Ziklag, i Mekona gu ɔ̃ nsɛkɔ̃ ame, <verse eid="NEH 11:28" /><verse number="29" style="v" sid="NEH 11:29" />i En Rimon, i Zora gu i Yarmut, <verse eid="NEH 11:29" /><verse number="30" style="v" sid="NEH 11:30" />Zanoa, Adulam gu kumagɛĩ gɔ loki kulɔ sɛ̃, i Lakis gu ɔ̃ nkpɛkɔ̃ gu Azeka ku ne nsɛkɔ̃ ame. Ne ɔso masɛ i ndɛ̃mɔ ita i Beerseba ikɛlɛ Xinom Kagbolomi ame.<verse eid="NEH 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NEH 11:31" />Benyamin ɔkparɛ ma lobɔrɛ i Geba ɔsɛ i Mikmas, Aiya, Betel gu ɔ̃ nsɛkɔ̃, <verse eid="NEH 11:31" /><verse number="32" style="v" sid="NEH 11:32" />i Anatot, Nob gu Anania, <verse eid="NEH 11:32" /><verse number="33" style="v" sid="NEH 11:33" />i Xazor, Rama gu Gitayim, <verse eid="NEH 11:33" /><verse number="34" style="v" sid="NEH 11:34" />i Xadid, Zeboim gu Nebalat, <verse eid="NEH 11:34" /><verse number="35" style="v" sid="NEH 11:35" />i Lod gu Ono gu i Kusɛ̃mabaradze Kagbolomi ame.<verse eid="NEH 11:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NEH 11:36" />Yuda ma Levise akuri awɛ̃ ɔsɛ i Benyamin karɔ̃ ame.<verse eid="NEH 11:36" /></para>
  <chapter eid="NEH 11" />
  <chapter number="12" style="c" sid="NEH 12" />
  <para style="s1">Masɔrɛdze Gu Ma Levise Ayere</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 12:1" />Masɔrɛdze gu ma Levise ma losɛ kukpa kukpa gu Zerubabel, Sealtiel ɔbibirɛrɛĩ gu Yesua mɛrɛ̃ ngbe ne:</para>
  <para style="li1" vid="NEH 12:1">Seraya, Yeremia, Ezra,<verse eid="NEH 12:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="NEH 12:2" />Amaria, Maluk, Xatus,<verse eid="NEH 12:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="NEH 12:3" />Sekania, Rexum, Meremot,<verse eid="NEH 12:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="NEH 12:4" />Ido, Gineton, Abiya,<verse eid="NEH 12:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="NEH 12:5" />Miyamin, Moadia, Bilga,<verse eid="NEH 12:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="NEH 12:6" />Semaya, Yoyarib, Yedaya,<verse eid="NEH 12:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="NEH 12:7" />Salu, Amok, Xilkia gu Yedaya.</para>
  <para style="m" vid="NEH 12:7">Mmagbe loɖe matɔ̃ɖedze matã masɔrɛdze gu ma manyii i Yesua ɔwi ame ne.<verse eid="NEH 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NEH 12:8" />Ma Levise loɖe Yesua, Binui, Kadmiel, Serebia, Yuda gu Matania ana. Matania gu ɔ̃ manyii lonyɔ sibaipɛ akaika iso. <verse eid="NEH 12:8" /><verse number="9" style="v" sid="NEH 12:9" />Bakbukia gu Uni gu ma manyii, ɔya i ma kanɔsɔ̃ i kasumu ame.<verse eid="NEH 12:9" /></para>
  <para style="s1">Sɔrɛdze Pelepele Yesua Ɔkparɛ</para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 12:10" />Yesua loɖe Yoyakim ɔ̃ ɔse, Yoyakim ɔɣe Eliasib, Eliasib ɔɣe Yoyada, <verse eid="NEH 12:10" /><verse number="11" style="v" sid="NEH 12:11" />Yoyada ɔɣe Yonatan ne Yonatan ɔɣe Yadua.<verse eid="NEH 12:11" /></para>
  <para style="s1">Masɔrɛdze Ayo Makpakpa</para>
  <para style="p">
    <verse number="12" style="v" sid="NEH 12:12" />I Yoyakim ɔwi ame ne, masɔrɛdze ma loɖe ayo makpakpa ngbe ne:</para>
  <para style="li1" vid="NEH 12:12">Meraya itã Seraya iyomaturi;</para>
  <para style="li1" vid="NEH 12:12">Xanania itã Yeremia iyomaturi;<verse eid="NEH 12:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="NEH 12:13" />Mesulam itã Ezra iyomaturi;</para>
  <para style="li1" vid="NEH 12:13">Yexoxanan itã Amaria iyomaturi;<verse eid="NEH 12:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="NEH 12:14" />Yonatan itã Maluk iyomaturi;</para>
  <para style="li1" vid="NEH 12:14">Yosef itã Sekania iyomaturi;<verse eid="NEH 12:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="NEH 12:15" />Adna itã Xarim iyomaturi;</para>
  <para style="li1" vid="NEH 12:15">Xelkai itã Merayot iyomaturi;<verse eid="NEH 12:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="NEH 12:16" />Zekaria itã Ido iyomaturi;</para>
  <para style="li1" vid="NEH 12:16">Mesulam itã Gineton iyomaturi;<verse eid="NEH 12:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="NEH 12:17" />Zikri itã Abiya iyomaturi;</para>
  <para style="li1" vid="NEH 12:17">Piltai itã Miniamin gu Moadia iyomaturi;<verse eid="NEH 12:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="NEH 12:18" />Samua itã Bilga iyomaturi;</para>
  <para style="li1" vid="NEH 12:18">Yexonatan itã Semaya iyomaturi;<verse eid="NEH 12:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="NEH 12:19" />Matenai itã Yoyarib iyomaturi;</para>
  <para style="li1" vid="NEH 12:19">Uzi itã Yedaya iyomaturi;<verse eid="NEH 12:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="NEH 12:20" />Kalai itã Salu iyomaturi;</para>
  <para style="li1" vid="NEH 12:20">Eber itã Amok iyomaturi;<verse eid="NEH 12:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="NEH 12:21" />Xasabia itã Xilkia iyomaturi;</para>
  <para style="li1" vid="NEH 12:21">Netanel itã Yedaya iyomaturi.<verse eid="NEH 12:21" /></para>
  <para style="s1">Masɔrɛdze Ayo Makpakpa Gu Ma Levise Ayo Makpakpa</para>
  <para style="p">
    <verse number="22" style="v" sid="NEH 12:22" />Matsɛrɛ ma Levise iyomaturi makpakpa ayere i Eliasib, Yoyada, Yoxanan gu Yadua ɔwi ame. Ngbɔ ame matsɛrɛ masɔrɛdze ayere masɛ i Persia igara Dario sigara ɔɖewi ne. <verse eid="NEH 12:22" /><verse number="23" style="v" sid="NEH 12:23" />Ngbɔ ame matsɛrɛ ayomaturi makpakpa i ma Levise ɔkparɛ ndɛ̃ ayere mapia i arabafetɔ̃me siko ame isɛ iabo Yoxanan, Eliasib ɔbibirɛrɛĩ ɔwi.<verse eid="NEH 12:23" /></para>
  <para style="s1">Isɔrɛyo Ame Karabara Iɣɛ Itã Maturi</para>
  <para style="p">
    <verse number="24" style="v" sid="NEH 12:24" />Ma Levise matɔ̃ɖedze loɖe Xasabia, Serebia gu Kadmiel ɔbibirɛrɛĩ Yesua, gu ma manyii ma loya i ma kanɔsɔ̃ i isɔrɛyo ame. Mala maɔle Ɣaa maɔpɛ siba ana. Mawɛ̃ i ikuri ame sɛ matɔrã ku silɔ masia i mama ɔkpɛ iso lɛ kumɛgɔ i David, Ɣaameturi ɔsɛ sɔ mala maɔbara awe.<verse eid="NEH 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NEH 12:25" />Matania, Bakbukia, Obadia, Mesulam, Talmon gu Akub ɔɖe kayogodɔ̃madzuɛ̃se. Ma lola maɔdzuɛ̃ ara kakɔlakɔ̃ ayo wa i kuyogodɔ̃ kɔrɛ. <verse eid="NEH 12:25" /><verse number="26" style="v" sid="NEH 12:26" />Maturi magbe ɔbara karabara i Yoyakim wɔ loɖe Yesua ɔbibirɛrɛĩ gu Yozadak ɔwabirɛrɛĩ ɔwi ame gu i Nexemia karɔ̃ nyoisose ɔwi gu i Ezra wɔ loɖe sɔrɛdze gu ratsɛrɛdze ɔwi ame.<verse eid="NEH 12:26" /></para>
  <para style="s1">Nexemia Ɔsekelera Yerusalem Ɔmagɛ̃siare Abere</para>
  <para style="p">
    <verse number="27" style="v" sid="NEH 12:27" />Ɔwi wɔ maasekelera Yerusalem abere ne, masɛ maakpedza ma Levise mabɔrɛgu i ma nwekɔ̃ ɔɖuɖu ame mabɔ Yerusalem, si maɖe abere isekelera iyi ku isoɣɔ, sibaipɛ aka gu kumomoi, masango gu siwɛ̃masango. <verse eid="NEH 12:27" /><verse number="28" style="v" sid="NEH 12:28" />Akamakadze ana ne mabɔrɛgu ma i Yerusalem awo ame maba maasakanya, mawɛ̃ ana ɔbɔrɛ i ma Netofatse kumagɛĩ ame. <verse eid="NEH 12:28" /><verse number="29" style="v" sid="NEH 12:29" />Mamama ɔbɔrɛ i Bet Gilgal gu Geba gu Azmavet awo ame, ala akamakadze ɔbara nsɛkɔ̃ matã so maki malɔ Yerusalem ɔmagɛ̃siare. <verse eid="NEH 12:29" /><verse number="30" style="v" sid="NEH 12:30" />Gɔ i masɔrɛdze gu ma Levise ɔɔsekelera so i kubarara kanya kama ne, masekelera iturikuri gu kuyogodɔ̃ gu abere ana.<verse eid="NEH 12:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NEH 12:31" />Lotã Yuda matɔ̃ɖedze ɔya makɛlɛ ibere kato iso. Loɣɛ akamakadze lopia akuri anyɔ wa lomɔ ame si maka sibaipɛ aka. Ika iwɛ̃ ɔki i kuɖearɔ̃ iso i ibere kato matsue iti Aku Kayogodɔ̃ kɔrɛ. <verse eid="NEH 12:31" /><verse number="32" style="v" sid="NEH 12:32" />Mma losiai ma loɖe Xosaya gu Yuda matɔ̃ɖedze kasɛ, <verse eid="NEH 12:32" /><verse number="33" style="v" sid="NEH 12:33" />ibua ku Azaria, Ezra gu Mesulam, <verse eid="NEH 12:33" /><verse number="34" style="v" sid="NEH 12:34" />Yuda, Benyamin, Semaya gu Yeremia. <verse eid="NEH 12:34" /><verse number="35" style="v" sid="NEH 12:35" />Ana ne masɔrɛdze mawɛ̃ ɔla kudadã masiai ma. Ma loɖe Zekaria, Yonatan ɔbibirɛrɛĩ, Yonatan wɔ nɖe Semaya ɔbibrɛrɛĩ, Semaya wɔ nɖe Matania ɔbibirɛrɛĩ, Matania wɔ nɖe Mikaya ɔbibirɛrɛĩ, Mikaya wɔ nɖe Zakur ɔbibirɛrɛĩ, Zakur wɔ nɖe Asaf ɔbibirɛrɛĩ. <verse eid="NEH 12:35" /><verse number="36" style="v" sid="NEH 12:36" />Zekaria manyii loɖe - Semaya, Azarel, Milalai, Gilalai, Maai, Netanel, Yuda gu Xanani. Ma ɔbiara ɔmɔɛ̃ David Ɣaameturi kuka ara wa ɔsɛ mato. Ezra ratsɛrɛdze loɖe iturikuri ɔsɛ katɔ̃. <verse eid="NEH 12:36" /><verse number="37" style="v" sid="NEH 12:37" />Gɔ mabo i Ibiɔ Kayogodɔ̃ ne, masɛ siĩ maya asɛtiĩ wa lokɛlɛ David Ɔmagɛ̃siare ame. Maya makɛlɛ ibere kato ne maki i David iyo kato makɛlɛ Ndu Kayogodɔ̃ kɔrɛ i ɔmagɛ̃ kuɣɛ̃kabɔrɛkɔ̃ isɛ.<verse eid="NEH 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NEH 12:38" />Akamakadze ikuri nyɔare ɔki i kubena iso. Losiai ma wũ mɔmɔ gu Yuda matɔ̃ɖedze kasɛ nyɔare i ibere kato. Boki bofe Ɔkpo Adzarara kɔrɛ bokɛlɛ Ibere Bɛbɛɛbɛa kɔrɛ. <verse eid="NEH 12:38" /><verse number="39" style="v" sid="NEH 12:39" />Ne ka boki i Efrayim Kayogodɔ̃ kato iki i Yesana Kayogodɔ̃ kato, iki i Ikpɛ Kayogodɔ̃ kato, iki i Xananel Adzarara gu Kulafa Adzarara kɔrɛ isɛ iabo ta Sɛrɛrerɔ̃ Kayogodɔ̃ kɔrɛ. Ne matuĩ i Madzuɛ̃se Kayogodɔ̃ kɔrɛ.<verse eid="NEH 12:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="NEH 12:40" />Ne Sibaipɛ akamakadze akuri anyɔ ɔɖuɖu ɔba maaya i ma nsɛkɔ̃ i Ɣaa iyo ame ne. Ngbɔ ame lobara gu makpakpa kasɛ ma nsɛgu me ana ne. <verse eid="NEH 12:40" /><verse number="41" style="v" sid="NEH 12:41" />Ngbɔ ame i masɔrɛdze - mma ku ma kudadã i bo ikuri ame ma loɖe: Eliakim, Maaseya, Miniamin, Mikaya, Elioenai, Zekaria gu Xanania ana ɔbara ne. <verse eid="NEH 12:41" /><verse number="42" style="v" sid="NEH 12:42" />Ana ne Maaseya, Semaya, Eleazar, Uzi, Yexoxanan, Malkiya, Elam gu Ezer ana ɔwe i ikuri ame. Akamakadze akuri ɔka aka i ma tɔ̃ɖedze Yezraxia isɔ̃ra kayirinɔ. <verse eid="NEH 12:42" /><verse number="43" style="v" sid="NEH 12:43" />Ne masɔrɛ ara gbodzoo ku ikpɛnɛ nɛmɔ, ku kaɣiɖu ifa alasɔ Ɣaa ɔtã ma isoɣɔ gbaã. Marɔ̃go gu mabiɛtɛ ana ɔfa kaɣiɖu ku isoɣɔ. Kaɣiɖu ifa ku isoɣɔ kulu wa lowe i Yerusalem ɔre gɔ maawo ɔnɔ dzoroo.<verse eid="NEH 12:43" /></para>
  <para style="s1">Ara Wa Maato Itã Isɔrɛyo</para>
  <para style="p">
    <verse number="44" style="v" sid="NEH 12:44" />Ɔwi wɔmɔ ame ne maɖi marɛrɛ̃ mawɛ̃ sɔ manyɔ ara kakɔlakɔ̃ iso, itã ara ito, ɔraɖui ɖeakatɔ̃ gu ara ikaweova. Mmagbe karabara kaɖe sɔ maafɔ ɔraɖui kasɛ ga nɖe masɔrɛdze gu ma Levise ɔkpɛ i mmara kanya i nkpɛkɔ̃ mɛ loki milɔ simagɛ̃ ame, makɔla i arakakɔlakɔ̃ ayo ame. Ala Yuda kaɖe ɔna isoɣɔ i masɔrɛdze gu ma Levise kasumu iso ɔso. <verse eid="NEH 12:44" /><verse number="45" style="v" sid="NEH 12:45" />Mabara ma Ɣaa kasumu karabara gu isekelera karabara, lɛ kumɛgɔ i akamakadze gu kayogodɔ̃madzuɛ̃se ana sɛ mabara, i asɛra wa i David gu ɔ̃ ɔbi Solomon ɔbara masɛ kanya. <verse eid="NEH 12:45" /><verse number="46" style="v" sid="NEH 12:46" />Ta kokowi, i David gu Asaf ɔwi ame ne, akamakadze ɔwe matɔ̃ɖedze gɔ mala maɔɖe ma katɔ̃, si mato maka ile gu sibaipɛ aka matã Ɣaa. <verse eid="NEH 12:46" /><verse number="47" style="v" sid="NEH 12:47" />Ne ɔso i Zerubabel gu Nexemia ɔwi ame ne, Israel mabi ɔɖuɖu ɔla maɔto ara ikpɛnɛ biara ɔkpɛ maɔtã akamakadze gu kayogodɔ̃madzuɛ̃se isoinyɔ. Masɛ maɖi ara sekelea wa nɖe ma Levise ɔkpɛ masɛ ise fiɛ ma Levise ana sɛ maɖi kasɛ ga nɖe Aron ɔkparɛ ɔkpɛ masɛ ise.<verse eid="NEH 12:47" /></para>
  <chapter eid="NEH 12" />
  <chapter number="13" style="c" sid="NEH 13" />
  <para style="s1">Iɖiso Ise i Nɖebi Mama Maturi Kɔrɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 13:1" />Iyi nɛmɔ iso ne maka Mose Mmara Ɔko matã kaɖe teteree gɔ manɔ. Ne manya sɔ matsɛrɛ i kakɔi kawɛ̃ sɔ maadatã ma Amonse ɣee ma Moabse kuwɛ̃ ɔri sɔ ɔba i Ɣaa iturikuri ame kuiyikuiyi. <verse eid="NEH 13:1" /><verse number="2" style="v" sid="NEH 13:2" />Ala ne, maiba maasarɛgu Israel mabi ku araɖea gu ndu i ma irisɛ ame. Ɣɛɛ ne masɛ maawanyi Balaam sɔ si ɔgbarĩ Israel mabi. (Ɣɛɛ bo Ɣaa ɔfirikira sigbarĩ sikpese kusɛkusɛ.) <verse eid="NEH 13:2" /><verse number="3" style="v" sid="NEH 13:3" />Gɔ i Israel mabi ɔnɔ mmaraisi mɛgbe ne maɖi mafɔ sikparɛ ma pelepele mpia i ma ndɛ̃ masɛ ise.<verse eid="NEH 13:3" /></para>
  <para style="s1">Ara Ɣɛtɛ Wa i Nexemia Ɔkpadzɛ̃ Ɔbɔ</para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 13:4" />Tɔtɔ ne, masu ara kakɔlakɔ̃ ayo wa i bo Ɣaa iyo inyɔiso mapia i sɔrɛdze Eliasib kayirinɔ. Gɔ i Eliasib ɔturi loɖe Tobia ne, <verse eid="NEH 13:4" /><verse number="5" style="v" sid="NEH 13:5" />ɔɖi iyo nɛ lomɔ ɔtã Tobia. Iyo nɛgbe ame saa ne, mala maɔsɛ geɖebu asɔrɛ gu kuakɔrɔ̃kɔrɔã, isɔrɛyo arɔi gu akɔi gu geɖebu araɖea, wain ɣɛtɛ, nnɔĩ akaweova wa nɖe ma Levise, akamakadze, kayogodɔ̃madzuɛ̃se gu ara wa masɛ mato matã masɔrɛdze.<verse eid="NEH 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 13:6" />Ɣɛɛ gɔ i ara wagbe to akɛlɛ i katɔ̃ ne, loiwe i Yerusalem. Loɔkpese lokɛlɛ Babilon igara Artaxsasta kɔrɛ ku ɔ̃ sigara ɔɖewi ikɔ sitɛnyɔare ame. Ɔwi kama ne lokarɛ wũ ɔri <verse eid="NEH 13:6" /><verse number="7" style="v" sid="NEH 13:7" />ne lokpese loba Yerusalem ne. Ɔwi wɔgbe ame loba loanya iranyanyariã nɛ i Eliasib ɔbara, i kumɛgɔ ɔtã Tobia iyo i Ɣaa iyo kasɔrɛkɔ̃ ame. <verse eid="NEH 13:7" /><verse number="8" style="v" sid="NEH 13:8" />Iiwe me ɔmɛrɛ̃ ɖuɖuuɖu ne loɖi Tobia iyo ara ɔɖuɖu lobɔrɛgu i iyokame lopɛyu i inyamɔ ne. <verse eid="NEH 13:8" /><verse number="9" style="v" sid="NEH 13:9" />Lotã silɔ sɔ masekelera kuyoi, ne ka losu Ɣaa iyo ara gu geɖebu asɔrɛ gu kuakɔrɔ̃kɔrɔã losɛ i ne ame.<verse eid="NEH 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 13:10" />Loba loanɔ sɔ aratoa wa nɖe ma Levise ɔkpɛ ne maisu matã ma. Ne iti ma Levise ɔɖuɖu gu akamakadze ma nsɛ mabara kasumu karabara ɔɔkpese makɛlɛ ma mɔmɔ nkpɛkɔ̃ ame. <verse eid="NEH 13:10" /><verse number="11" style="v" sid="NEH 13:11" />Ne ɔso lonyagalagu makpakpa ne lokarɛ ma sɔ, "Be ɔso minyua Ɣaa iyo misɛ?" Kere ne lokpere ma Levise gu akamakadze losakanya fiɛ lotã ma mawe i ma nsɛkɔ̃.<verse eid="NEH 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NEH 13:12" />Ne Yuda maturi ɔɖuɖu ɔsu ma geɖebu ɔraɖui, wain gu nnɔĩ akaweova mabɔ i arakukɔlakɔ̃ ne. <verse eid="NEH 13:12" /><verse number="13" style="v" sid="NEH 13:13" />Loɖi sɔrɛdze Selemia, ɔkotsɛrɛdze Zadok gu Levise wɔ marɔ sɔ Pedaya, ne losu arakukɔlakɔ̃ ayo inyɔiso lopia i ma nrɔɔ̃ ame. Loɖi Zakur ɔbibirɛrɛĩ Xanan, ɔɖe Matania ɔwabirɛrɛĩ, si ɔla ɔ̃abuai ma. Loɖi mmagbe alasɔ maturi sɛ manyɔ ma sɔ maba ɔnukuare. Losɛra ma sɔ mala maɔɣɛ ara wa maturi ɔto maɔtã ma manyii.<verse eid="NEH 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NEH 13:14" />O wũ Ɣaa, nyigi me i nnɛgbe ame, daakpa anɔmi afu i ira nɛ lobara ku ɔnukuare lotã Ɣaa iyo gu kasumu i ne ame.<verse eid="NEH 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NEH 13:15" />Ɔwi wɔmɔ ame i Yuda ne, lonya maturi to mawa ndã ku iwarãyi iso, mawɛ̃ to masu kamɔ masorera mafiripɔngɔ isu ibua wain, wain abi, aboi, gu ato agbãagbã. Ne mato masu ara wagbe ɔɖuɖu mabɔ i Yerusalem ku Iwarãyi iso. Ne ɔso losi ma mmara i araɖea irɔdɛ̃ ku iyi nɛmɔ iso. <verse eid="NEH 13:15" /><verse number="16" style="v" sid="NEH 13:16" />Ma Tirose ma lowe i Yerusalem sɛ masu akpɛ gu ara mama mabɔ maarɔdɛ̃ matã ma Yudase ku iwarãyi i Yerusalem. <verse eid="NEH 13:16" /><verse number="17" style="v" sid="NEH 13:17" />Lonyagalagu Yuda makpakpaturi fiɛ loɣere ma sɔ, "Mme ɔtile ira iɖe mito mibara i ngbe - mito mipukutura iwarãyi? <verse eid="NEH 13:17" /><verse number="18" style="v" sid="NEH 13:18" />Iiɖe ara wagbe i mi mawa ɔbara ɔso i Ɣaa ɔtã kukpakpi ɔɖuɖu gɔgbe ɔba i bo iso gu ɔmagɛ̃siare wɔgbe iso ɣɛɛ? Kiniɔ ne ka mito mirɛgɛ̃ra sikpã mibua sɔ siba i Israel iso iki Iwarãyi ipukutura iso."<verse eid="NEH 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NEH 13:19" />Gɔ i kuɣɛ̃ ɔɔna kuto kubo iyo ku kutsuɛ fiɛ iwarãyi ne, losi mmara sɔ masɛ̃ Yerusalem kuyogodɔ̃ si madaabusi kɔ̃ gbɔgbɔɔgbɔ Iwarãyi aafe. Lotã wũ mɔmɔ marɛrɛ̃ mawɛ̃ ɔya i kuyogodɔ̃ kanya gɔ maibatã kuwɛ̃ ɔri sɔ ɔbogu ato kuawɛ̃ i ɔmagɛ̃ ame ku Iwarãyi iso. <verse eid="NEH 13:19" /><verse number="20" style="v" sid="NEH 13:20" />Kuɣamaɖese gu ara agbãagbã marɔdɛ̃se sɛ makamu marɛ i Yerusalem kama ɔkpɛ ɔwɛ̃ ɣee inyɔ. <verse eid="NEH 13:20" /><verse number="21" style="v" sid="NEH 13:21" />Ɣɛɛ losi ma mmara loɣere ma sɔ, "Be ɔso miba miakamu i ibere kama mirɛ? Si miledza ne ibara ne loamɔɛ̃ mi." Ita i ɔwi wɔmɔ iso ne maisiba ku Iwarãyi iso. <verse eid="NEH 13:21" /><verse number="22" style="v" sid="NEH 13:22" />Kere ne loɣere ma Levise sɔ masekelera so si masɛ maadzuɛ̃ kuyogodɔ̃, si itã sɔ maabara Iwarãyi sekelee.</para>
  <para style="b" vid="NEH 13:22" />
  <para style="p" vid="NEH 13:22">O wũ Ɣaa, nyigi si abara isɛɛ atã me i nnɛgbe ɔso ana, si anyɔ me nnya i fɔ kuɖɔɛ siare kanya.<verse eid="NEH 13:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="NEH 13:23" />Ɣɛɛ lonya loɖiite i ɔwi wɔmɔ ame ana sɔ Yuda marɛrɛ̃ mawɛ̃ ɔɔyiri marɔ̃go mabɔrɛgu Asdod, Amon gu Moab. <verse eid="NEH 13:23" /><verse number="24" style="v" sid="NEH 13:24" />Ma mabi kasɛ sɛ maɣɛ Asdod siɖe ɣee kaɖe karere maturi siɖe, ɣɛɛ maisɛ mawo Yuda siɖe ɔɣɛ. <verse eid="NEH 13:24" /><verse number="25" style="v" sid="NEH 13:25" />Losi ma mmara, logbarĩ ma. Lopɛ ma mawɛ̃ fiɛ lorui ma siwɛrɛ̃. Lotã makã ndamu i Ɣaa iyere ame ne loɣere ma sɔ, "Midaasu mi mabibirɔ̃gomi mitã ma mabibirɛrɛĩ ɣee midaayiri ma mabibirɔ̃gomi mitã mi mabibirɛrɛĩ ɣee midaayiri ma mi mɔmɔ. <verse eid="NEH 13:25" /><verse number="26" style="v" sid="NEH 13:26" />Iiɖe marɔ̃go magbe igbã iyiri ɔso i Israel igara Solomon ɔbara ikpi ɣɛɛ? Igara kuwɛ̃ iifɔ iyere i nɖebi gbodzoo ame lɛ Solomon. Ɣaa ɔɖɔɛ wũ fiɛ ɔtã ɔɖe sigara i Israel ɔɖuɖu iso, ɣɛɛ ɔ̃ kɔraa ne, mafɔrɔ̃go ɔkɔ wũ mapia i ikpi ame. <verse eid="NEH 13:26" /><verse number="27" style="v" sid="NEH 13:27" />Ito iakote sɔ boanɔ kiniɔ sɔ mi wũ ka mito mibara ɔtile siare ɔɖuɖu wɔgbe? Ito ialɛ sɔ miito miɖe ɔnukuare mitã Ɣaa iki i mafɔrɔ̃go iyiri ame ana?"<verse eid="NEH 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NEH 13:28" />Yoyada ɔbibirɛrɛĩ ɔwɛ̃ wɔ nɖe Sɔrɛdzekpakpa Pelepele Eliasib ɔwabirɛrɛĩ, ɔyiri Sanbalat Xoronse ɔbibirɔ̃gomi. Ne losa wũ loɖi i wũ kɔrɛ.<verse eid="NEH 13:28" /></para>
  <para style="b" />
  <para style="p">
    <verse number="29" style="v" sid="NEH 13:29" />O wũ Ɣaa, fɔ anɔ si asia i ma iso ala kumɛgɔ mapukutura sisɔrɛdzeiɖe gu ndamu mɛ mpia i mi gu masɔrɛdze gu ma Levise ndɛ̃.<verse eid="NEH 13:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NEH 13:30" />Ne ɔso losekelera masɔrɛdze gu ma Levise loɖi i irabiara nɛ loɖe mafɔ gu ma kubarara ame. Ne lotã ma ɔbiara ɔ̃ mɔmɔ karabara ne. <verse eid="NEH 13:30" /><verse number="31" style="v" sid="NEH 13:31" />Lonyɔ sɔ mato ndɔrɛ̃ fiɛ matã ɔraɖui ɖeakatɔ̃ ku ɔwi wɔ masɛ iso.</para>
  <para style="b" vid="NEH 13:31" />
  <para style="p" vid="NEH 13:31">O wũ Ɣaa nyigi me si wũ ara si abo-ɔ anɔ.<verse eid="NEH 13:31" /></para>
  <chapter eid="NEH 13" />
</usx>