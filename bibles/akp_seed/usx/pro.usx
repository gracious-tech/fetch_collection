<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PRO" style="id">- Siwu Old Testament</book>
  <para style="h">AGBÃ</para>
  <para style="toc1">Agbã Ɔko</para>
  <para style="toc2">Agbã</para>
  <para style="toc3">Ag</para>
  <para style="mt1">AGBÃ</para>
  <para style="mt2">ƆKO</para>
  <para style="imt">ATƆ̃MEƉEAKATƆ̃</para>
  <para style="im">
    <char style="bk">Agbã Ɔko</char> ɖe araite i ngbã sɛɛ isɛ gu Ɣaa kasumu iso wa masirakanya lɛ simai gu agbã awe. Atɔ̃me wagbe kasɛ siare ɔɖeika i iyi biara nsɛgbai i ngbã ame iso. Ɔko ɔsɛ karɔ̃ ku inyigira itɔ̃me sɔ, "<char style="nd">Bosate</char> kunigã nɖe inɔkpa karɔ̃isɛ." (1.7) Isɔgu i katɔ̃ iɖeika gɔ iiɖe ngbã sɛɛ isɛ i Ɣaa kunigã ame kere, ɣɛɛ iyi biara itsue gu nsɛgbai sɛɛ i maturi iso ana. Atɔ̃me wa maɣɛ kurukutua gbodzoo pia i ɔko ame wa loɖi Israel makuere maratedze adzuni, i ara wa i nwɔ nsɛ ɔnigã Ɣaa ɣee kawolai aabara si itɔ̃me nyaa ɣee ira irere ɔba ame ate. Atɔ̃me wagbe awɛ̃ ɔpɛgu malɛdze sinyii ibara gu kasɛgu manyii i karabara ame. Wã awɛ̃ ɔɖeika i ɔturi ikososo imɔɛ̃so ila i maturi ndɛ̃ gu kumɛgɔ i ɔturi iɖesoiso ɔnya i ngbã ame iso.</para>
  <para style="ip">Ɔko ɔɖeika gbodzoo i nsɛgbai sɛɛ lɛ karɔ̃ibɔso, iɣaraso, kuwarɛ ipia mawɛrɛba gu ɔnukuareiɖe itã malaa iso.</para>
  <para style="iot">Ɔko ame atɔ̃medziri</para>
  <para style="io1">Iwola ile <char style="ior">1.1-9.18</char></para>
  <para style="io1">Solomon agbã <char style="ior">10.1-29.27</char></para>
  <para style="io1">Agur atɔ̃me <char style="ior"><ref loc="PRO 30:1-33">30.1-33</ref></char></para>
  <para style="io1">Simai mama <char style="ior"><ref loc="PRO 31:1-31">31.1-31</ref></char></para>
  <chapter number="1" style="c" sid="PRO 1" />
  <para style="s1">Kumɛgɔ I Agbã Ɔfɔ Kuɣa</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1" />Israel igara David ɔbibirɛrɛĩ, Solomon iwola agbã i ngbe ne:<verse eid="PRO 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 1:2" />Wã nsɛ atã ɔturi ɔtsue iwola fiɛ ɔsɛ ɔna ikpadzɛ̃;</para>
  <para style="q2" vid="PRO 1:2">asɛ atã ɔturi karɔ̃inɔ i atɔ̃me wa lowodoro ame.<verse eid="PRO 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 1:3" />Asɛ atã ɔturi ɔna ikpadzɛ̃ fiɛ ɔsɛ ɔsɛ ngbã sɛɛ,</para>
  <para style="q2" vid="PRO 1:3">ɔbara nnɛ nlɛ fiɛ iya gu i ɔri iso.<verse eid="PRO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 1:4" />Asɛ ate ɔturi wɔ loinya kayi ame inɔkpa gu ikososo,</para>
  <para style="q2" vid="PRO 1:4">fiɛ asɛ abara makoso manya ara maɖiite gu mma losɛ iti ame.<verse eid="PRO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 1:5" />Mitã kawolai si ɔkã atsue si ɔsu ɔbua i nwa ɔto ɔsuã iso</para>
  <para style="q2" vid="PRO 1:5">si nwɔ nsɛ ɔnya ara ɔɖiite si ɔna kuka -<verse eid="PRO 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 1:6" />gɔ ɔ̃atsue agbã, agbã ipɛ,</para>
  <para style="q2" vid="PRO 1:6">simai gu adzolo karɔ̃.<verse eid="PRO 1:6" /></para>
  <para style="b" />
  <para style="s1">Kuka Kutã Makoso</para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 1:7" />
    <char style="nd">Bosate</char> kunigã nɖe inɔkpa karɔ̃isɛ,</para>
  <para style="q2" vid="PRO 1:7">ɣɛɛ madzunisɛĩ sɛ manyɔ iwola gu ikpadzɛ̃ pupurii.<verse eid="PRO 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8" />Wũ ɔbi, kã fɔ ɔse iturikpadzɛ̃ atsue,</para>
  <para style="q2" vid="PRO 1:8">si adaanyua fɔ ɔnyi araite apɛyu.<verse eid="PRO 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9" />Ato aaɖe itinyira nɛ nto ilɛnyɔ i fɔ iti,</para>
  <para style="q2" vid="PRO 1:9">gu kusanya gɔ loakɛrɛ fɔ ɔme.<verse eid="PRO 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 1:10" />Wũ ɔbi, si makpibaradze to masɔsɔla-ɔ ku kanyamɛrɛ̃ ne,</para>
  <para style="q2" vid="PRO 1:10">daatɔrã asia iso.<verse eid="PRO 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11" />Tã bosu lɛ maɣɛ sɔ, "Ba bokɛlɛ,</para>
  <para style="q2" vid="PRO 1:11">si bosɛ boawɛrɛ bosia, boɖoe ɔturi.</para>
  <para style="q2" vid="PRO 1:11">Tã bobo ɔrere wɔ loiɣɛrɛ iso siefe kere.<verse eid="PRO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12" />Boawɔra ma boɖi pelepele fiɛ maisibawe.</para>
  <para style="q2" vid="PRO 1:12">Maabiara ma lɛ kumɛgɔ i makpise sɛ makɛlɛ iwo ame pelepele.<verse eid="PRO 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13" />Boto boana karana sɛɛ agbãagbã</para>
  <para style="q2" vid="PRO 1:13">bosu kakpãramɔɛã boyira bo ayo ame.<verse eid="PRO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14" />Ba baragu bo mawɛ̃,</para>
  <para style="q2" vid="PRO 1:14">sikã kakotoi kawɛ̃ awe katã bo ɔɖuɖu."<verse eid="PRO 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15" />Wũ ɔbi, daasɛgu ma,</para>
  <para style="q2" vid="PRO 1:15">daasia kukpa i ma siri iso.<verse eid="PRO 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16" />Alasɔ masɛ makarara i ira lalaa ibara iti</para>
  <para style="q2" vid="PRO 1:16">fiɛ ima ifere i karɔ̃ iti mato mapɛsiwa.<verse eid="PRO 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 1:17" />Siefe kere magbere asabu masɛ</para>
  <para style="q2" vid="PRO 1:17">i kurodzai ɔɖuɖu anɔmi ame!<verse eid="PRO 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18" />Marɛrɛ̃ magbe sɛ mawɛrɛ masia ma mɔmɔ ima;</para>
  <para style="q2" vid="PRO 1:18">masɛ magbere kere masia so!<verse eid="PRO 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19" />Ngbɔ i mma ɔɖuɖu nsɛ masu ɔtile mabie kusia kawirikɔ̃ se ne;</para>
  <para style="q2" vid="PRO 1:19">mma nsɛ mana kusia ne, kɔ̃ nsɛ kuwɔra ma ngbã.<verse eid="PRO 1:19" /></para>
  <para style="s1">Iwola Kulu I Ɔvurã Iso</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20" />Iwola to kulu teteree i ɔvurã iso,</para>
  <para style="q2" vid="PRO 1:20">ɔsɛ ɔkɔlɛ silɔ kato i itiri.<verse eid="PRO 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 1:21" />Ɔto ɔkpere maturi i sivurã iso i ngbegɔ maturi ɔsi ku kulu,</para>
  <para style="q2" vid="PRO 1:21">ɔɣɛ i ɔmagɛ̃siare kubɔrɛnya ɔto ɔɖeika.<verse eid="PRO 1:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 1:22" />Ɔto ɔɣɛ sɔ, "Madzunisɛĩ, iɖe ɔwi wɔ mianyua mi adzunisɛ̃ra iɖɔɛ?</para>
  <para style="q2" vid="PRO 1:22">Maɣiãrase, iɖe ɔwi wɔ mianyua aɣiãra ibara?</para>
  <para style="q2" vid="PRO 1:22">Mma loikpa anɔ, iɖe ɔwi wɔ mianyua inɔkpa itsiri?<verse eid="PRO 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23" />Si ɔkã mikã wũ iyira atsue ne,</para>
  <para style="q2" vid="PRO 1:23">tee lobusi wũ ɔtu lotã mi,</para>
  <para style="q2" vid="PRO 1:23">lotã mitsue wũ adzuni.<verse eid="PRO 1:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24" />Ɣɛɛ ɔwi wɔ lokpere ne misɛ̃ me</para>
  <para style="q2" vid="PRO 1:24">fiɛ gɔ loɖi wũ kɔrɔ̃ losɔ̃ ne, kuwɛ̃ iikpa anya.<verse eid="PRO 1:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 1:25" />Alasɔ misɛ̃ wũ kuka ɔɖuɖu</para>
  <para style="q2" vid="PRO 1:25">fiɛ misɛ̃ wũ iyira.<verse eid="PRO 1:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 1:26" />Ne ɔso mme wũ loama mi si kukpakpi ɔba i mi iso.</para>
  <para style="q2" vid="PRO 1:26">Loabara mi aɣiãra si inyɛwe ɔba i mi iso -<verse eid="PRO 1:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 1:27" />si ifu mi iso lɛ awɛ awe</para>
  <para style="q2" vid="PRO 1:27">fiɛ ipɛ ifere mi lɛ kagbadadururu awe,</para>
  <para style="q2" vid="PRO 1:27">ne isoma gu imɔrɛ̃ ɔba mi iso.<verse eid="PRO 1:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 1:28" />"Iyɔ mato maakpere me ɣɛɛ loibatɔrã;</para>
  <para style="q2" vid="PRO 1:28">mato maanyɔnyɔ me ɣɛɛ maibanya me ɖa.<verse eid="PRO 1:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 1:29" />Gɔ matsiri inɔkpa</para>
  <para style="q2" vid="PRO 1:29">fiɛ masɛ̃ maisu <char style="nd">Bosate</char> kunigã,<verse eid="PRO 1:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 1:30" />gɔ masɛ̃ wũ kuka</para>
  <para style="q2" vid="PRO 1:30">fiɛ manyɔ wũ iyira pupurii,<verse eid="PRO 1:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 1:31" />iyɔ mato maaɖe ma nsɛgbai adziribi</para>
  <para style="q2" vid="PRO 1:31">fiɛ mamigu ma siriita adziribi.<verse eid="PRO 1:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 1:32" />Alasɔ madzunisɛĩ ne iturikpadzɛ̃ kuka atsue idaakã nsɛ iɖoe ma;</para>
  <para style="q2" vid="PRO 1:32">fiɛ mma loikpa anɔ ne, iti isiasoiso nsɛ iwɔra ma.<verse eid="PRO 1:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 1:33" />Ɣɛɛ ɔturi wɔ lokã me atsue aasɛ ngbã i kaɣɔ ame</para>
  <para style="q2" vid="PRO 1:33">fiɛ ɔsɛ ɔwe fala, ɔ̃isɛ ɔnigã iraboa."<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" sid="PRO 2" />
  <para style="s1">Iwola Kusia</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 2:1" />Wũ ɔbi, si afɔ wũ atɔ̃me</para>
  <para style="q2" vid="PRO 2:1">fiɛ amɔɛ̃ wũ mmara mɛ losi-ɔ ala,<verse eid="PRO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 2:2" />fiɛ akã iwola atsue</para>
  <para style="q2" vid="PRO 2:2">asu fɔ ɔtu asia ne iso, anɔkarɔ̃ ne,<verse eid="PRO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 2:3" />si abie iwola wodoroa ku kulu,</para>
  <para style="q2" vid="PRO 2:3">fiɛ akɔlɛ silɔ kato akpere karɔ̃inɔ,<verse eid="PRO 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 2:4" />si abie ne lɛ sikãfudza awe</para>
  <para style="q2" vid="PRO 2:4">fiɛ anyɔnyɔ ne lɛ karana ga masu makɔla awe ne,<verse eid="PRO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 2:5" />iyɔ ato aanɔ <char style="nd">Bosate</char> kunigã karɔ̃</para>
  <para style="q2" vid="PRO 2:5">fiɛ ana isaruɛ i Ɣaa itsue ame.<verse eid="PRO 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 2:6" />Alasɔ <char style="nd">Bosate</char> nsɛ ɔtã iwola,</para>
  <para style="q2" vid="PRO 2:6">fiɛ ɔ̃ kanya ame i inɔkpa gu karɔ̃inɔ sɛ abɔrɛ.<verse eid="PRO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 2:7" />Ɔsɛ ɔsu iɖeiso ɔsɛ maturi bɔlɔlɔa,</para>
  <para style="q2" vid="PRO 2:7">ɔɖe akpiraifɔra ɔtã mma ɔsɛ nna iɣɛrɛ.<verse eid="PRO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 2:8" />Ala ɔsɛ ɔdzuɛ̃ maturi ma nsɛ masiai itɔ̃me tɔrɔrɔa,</para>
  <para style="q2" vid="PRO 2:8">fiɛ ɔsɛ ɔnyɔ ɔ̃ manukuarese iso.<verse eid="PRO 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9" />Iyɔ ne ato aana karɔ̃inɔ i nnɛ nɖe sibɔlɔlɔ gu itɔ̃meyaa</para>
  <para style="q2" vid="PRO 2:9">gu itɔ̃meiɖaɛ ikate gu ngbã sɛɛ biara isɛ iso.<verse eid="PRO 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 2:10" />Alasɔ iwola to iabo-ɔ i ɔtu ame,</para>
  <para style="q2" vid="PRO 2:10">fiɛ inɔkpa to iawe fɔ ɔkala ɔmɛrɛ̃.<verse eid="PRO 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 2:11" />Ara ibara ku iwola aanyɔ-ɔ iso</para>
  <para style="q2" vid="PRO 2:11">fiɛ karɔ̃inɔ aadzuɛ̃-ɔ.<verse eid="PRO 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12" />Iwola to iaɖi-ɔ ibɔrɛgu i maturi nyanyariã ɔri lalaa iso,</para>
  <para style="q2" vid="PRO 2:12">gu ito iaɖi-ɔ i maturi atɔ̃me wa logɔgɔlɔ kɔrɛ,<verse eid="PRO 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 2:13" />mmagbe sɛ masɛ̃ siri sɛɛ,</para>
  <para style="q2" vid="PRO 2:13">masɛ masɛ ngbã i idududu siri ame,<verse eid="PRO 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 2:14" />masɛ mana isoɣɔ i ara lalaa ibara ame</para>
  <para style="q2" vid="PRO 2:14">fiɛ so sɛ siɣɔ ma i aranyanyariã siri dzɛ logɔgɔlɔ ame,<verse eid="PRO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 2:15" />mma siri nse gɔdɔrɔ,</para>
  <para style="q2" vid="PRO 2:15">fiɛ kasɔla ɔyi i sɛ̃ iso.<verse eid="PRO 2:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16" />Iwola to iaɖi-ɔ ibɔrɛgu i rãrɔdze ame ana,</para>
  <para style="q2" vid="PRO 2:16">iɖi-ɔ i ɔre wɔ loɔsu so rãrɔdze wɔ nsɛ ɔsu atɔ̃me mɛrɛ̃mɛrɛã nrɔɔ̃ ame,<verse eid="PRO 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 2:17" />nwɔ loɔrui i ɔ̃ sibitɛ ame kurã kɔrɛ</para>
  <para style="q2" vid="PRO 2:17">fiɛ ɔsɛ ɔsɛ̃ ndamu mɛ ɔbara i Ɣaa anɔ.<verse eid="PRO 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 2:18" />Ala ɔrɔ̃go wɔgbe iyo ikɛlɛ, ɖe kukpi ɔri iso,</para>
  <para style="q2" vid="PRO 2:18">mmɔ isɛ se lɛ kukpi aɖe ikɛlɛ.<verse eid="PRO 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 2:19" />Kuwɛ̃ iisɛ ɔsɛ ɔ̃ kɔrɛ ɔkpese</para>
  <para style="q2" vid="PRO 2:19">ɣee ɔkpese ɔba ɔ̃anya ngbã ɔri.<verse eid="PRO 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20" />Ne ɔso sɛ i maturi sɛɛ siri iso,</para>
  <para style="q2" vid="PRO 2:20">si asɛ i maturi bɔlɔlɔa kunenekɔ̃.<verse eid="PRO 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21" />Alasɔ maturi sɛɛ loawe i karɔ̃ iso</para>
  <para style="q2" vid="PRO 2:21">fiɛ maturi ma nna iɣɛrɛ loakuti i kã iso.<verse eid="PRO 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 2:22" />Ɣɛɛ maawɔra matilese i karɔ̃ iso,</para>
  <para style="q2" vid="PRO 2:22">fiɛ maarui makpibaradze ku siɖu maɖi i kã iso.<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" sid="PRO 3" />
  <para style="s1">Kuka Kutã Makoso</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 3:1" />Wũ ɔbi, daaɣara ara wa lote-ɔ,</para>
  <para style="q2" vid="PRO 3:1">ɣɛɛ mɔɛ̃ wũ mmaraisi la i fɔ ɔtu ame.<verse eid="PRO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2" />Alasɔ ato aatã sɔ fɔ agbanayi aasi ku akɔ gbodzoo</para>
  <para style="q2" vid="PRO 3:2">fiɛ aabɔ-ɔ isaruɛ.<verse eid="PRO 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3" />Daatã ɔnukuareiɖe gu kuɖɔɛ si are-ɔ kama kuiyikuiyi.</para>
  <para style="q2" vid="PRO 3:3">Su wã pia i ɔme,</para>
  <para style="q2" vid="PRO 3:3">si amɔɛ̃ wã apia i iti ame.<verse eid="PRO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4" />Iyɔ aafɔ iyere sɛɛ fiɛ fɔ ara to aabo anɔ</para>
  <para style="q2" vid="PRO 3:4">i Ɣaa gu ɔturi kɔrɛ.<verse eid="PRO 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5" />Siaiti i <char style="nd">Bosate</char> iso ku fɔ ɔtu ɔɖuɖu</para>
  <para style="q2" vid="PRO 3:5">daapiɛtɛ i fɔ mɔmɔ karɔ̃inɔ iso.<verse eid="PRO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6" />Fɔ kasusu si kasia i Ɣaa iso i irabiara ame,</para>
  <para style="q2" vid="PRO 3:6">iyɔ ne ɔto ɔ̃atã fɔ ɔri ame ɔkpa.<verse eid="PRO 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 3:7" />Daanyɔ so sɔ aɣe iwola.</para>
  <para style="q2" vid="PRO 3:7">Nigã <char style="nd">Bosate</char>, si asɛ̃ ikpi.<verse eid="PRO 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8" />Nnɛgbe to iatã fɔ sosina isosarɛ</para>
  <para style="q2" vid="PRO 3:8">fiɛ iapia fɔ akui ɔle.<verse eid="PRO 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9" />Su fɔ karana pia <char style="nd">Bosate</char> kuwarɛ</para>
  <para style="q2" vid="PRO 3:9">ngbɔ ame si abara fɔ ɔraɖui ɖeakatɔ̃ igbã biara ne.<verse eid="PRO 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10" />Iyɔ mi kuwu to kuayigu ɔraɖui kubiɛ kuwiri,</para>
  <para style="q2" vid="PRO 3:10">fiɛ wain ɣɛtɛ to ɔ̃abiɛ ɔwiri i fɔ ndã kasɛkɔ̃.<verse eid="PRO 3:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 3:11" />Wũ ɔbi, daanyɔ <char style="nd">Bosate</char> iturikpadzɛ̃ pupurii</para>
  <para style="q2" vid="PRO 3:11">fiɛ ɔ̃ iyira daaɖaa-ɔ.<verse eid="PRO 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12" />Alasɔ <char style="nd">Bosate</char> sɛ ɔkpadzɛ̃ mma ɔsɛ ɔɖɔɛ,</para>
  <para style="q2" vid="PRO 3:12">lɛ ɔse sɛ ɔkpadzɛ̃ ɔ̃ ɔbibirɛrɛĩ wɔ ɔ̃isɛ ɔpia kuɣɛ awe.<verse eid="PRO 3:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13" />So si siɣɔ ɔturi wɔ nsɛ ɔtu iwola.</para>
  <para style="q2" vid="PRO 3:13">So si siɣɔ nwɔ kɔrɔ̃ lopɛgu karɔ̃inɔ,<verse eid="PRO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14" />alasɔ ne ame kusia lɛ kuɖo sikãfudza</para>
  <para style="q2" vid="PRO 3:14">fiɛ nnɛ nsɛ ibɔrɛ ne ame lɛ iɖo sikãrɛtɛa.<verse eid="PRO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15" />Iwola ɔfɔ kuɣa ɔɖo ikɛrɛra nɛ mba kuɣa iɖo.</para>
  <para style="q2" vid="PRO 3:15">Ara wa asɛ abie kuiwɛ̃ iibawo ɔkategu wũ.<verse eid="PRO 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16" />Ɔmɔɛ̃ ngbã tagbaraa ɔto i kuɖearɔ̃,</para>
  <para style="q2" vid="PRO 3:16">fiɛ ɔmɔɛ̃ karana gu kuwarɛ ɔto i kubena.<verse eid="PRO 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17" />Ɔ̃ siri iso ba ɔmɛrɛ̃,</para>
  <para style="q2" vid="PRO 3:17">fiɛ ɔ̃ siri ɔɖuɖu ɖe isobuɛ.<verse eid="PRO 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18" />Kudziri gɔ nsɛ kutã ngbã kuɖe kutã mma nsɛ mapɔrɛ wũ mapia so,</para>
  <para style="q2" vid="PRO 3:18">so aaɣɔ mma loamɔɛ̃ wũ mala teteree.<verse eid="PRO 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19" />Iki i iwola ame i <char style="nd">Bosate</char> ɔsɛra karɔ̃ sikaĩ,</para>
  <para style="q2" vid="PRO 3:19">iki i karɔ̃inɔ ame ɔsɛra kato i kã kasɛkɔ̃,<verse eid="PRO 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20" />iki i ɔ̃ inɔkpa ame ndu ɔgodɛ̃ i kuwodorokɔ̃,</para>
  <para style="q2" vid="PRO 3:20">fiɛ adɔdɔ ɔpɛ kuɖobiobio.<verse eid="PRO 3:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 3:21" />Wũ ɔbi, mɔɛ̃ iwola wodoroa gu ara ibara ku iwola la,</para>
  <para style="q2" vid="PRO 3:21">daatã arui i fɔ adzuni ame.<verse eid="PRO 3:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22" />Ato aaɖe ngbã atã-ɔ,</para>
  <para style="q2" vid="PRO 3:22">gu ikɛrɛra itã fɔ ɔme.<verse eid="PRO 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23" />Iyɔ ato aasɛ i fɔ ɔri iso i kaɣɔ ame,</para>
  <para style="q2" vid="PRO 3:23">fiɛ aibatura i ira iso.<verse eid="PRO 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24" />Si arɛ ne, aibanigã.</para>
  <para style="q2" vid="PRO 3:24">Si akɛlɛ arɛ ne, sirɛ aawe-ɔ ɔmɛrɛ̃.<verse eid="PRO 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25" />Si kukpakpi ɔba ɔluwɛ̃ kere ne,</para>
  <para style="q2" vid="PRO 3:25">ɣee itikpi ɔba i matilese iso ne, ɔtu si ɔdaakɛ-ɔ ku ifɔ̃,<verse eid="PRO 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26" />alasɔ <char style="nd">Bosate</char> nɖe nwɔ aasiaiti iso,</para>
  <para style="q2" vid="PRO 3:26">fiɛ ɔ̃ibatã fɔ kukpa ɔbo i kata ame.<verse eid="PRO 3:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27" />Si aba ɔri aabara irere i fɔ ɔle ame ne,</para>
  <para style="q2" vid="PRO 3:27">daasɛ̃ isɛɛ ibara itã mma lokote.<verse eid="PRO 3:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28" />Daaɣere fɔ ɔnyii sɔ,</para>
  <para style="q2" vid="PRO 3:28">"Kɛlɛ, si akpese aba, kɔrãkaɖe loasu lotã-ɔ" -</para>
  <para style="q2" vid="PRO 3:28">ɔwi wɔ ira nɛmɔ se-ɔ kiniɔ fiɛ.<verse eid="PRO 3:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 3:29" />Daabara adzuni sɔ aabara fɔ ɔnyii iraboa,</para>
  <para style="q2" vid="PRO 3:29">nwɔ nsi i fɔ kɔrɛ fiɛ ɔto ɔsiaiti i fɔ iso.<verse eid="PRO 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30" />Si ɔturi iibara-ɔ iboa ne,</para>
  <para style="q2" vid="PRO 3:30">daakidza wũ abara kulu ku wũ.<verse eid="PRO 3:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31" />Daarɛtɛra anɔmi i ɔtilese iso</para>
  <para style="q2" vid="PRO 3:31">ɣee daasiai ɔ̃ kurabarara kukuwɛ̃.<verse eid="PRO 3:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32" />Alasɔ <char style="nd">Bosate</char> ɔtsiri kasɔla ɔturi</para>
  <para style="q2" vid="PRO 3:32">ɣɛɛ ɔsɛ ɔpia kulaa ku ɔturi sɛɛ.<verse eid="PRO 3:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33" />
    <char style="nd">Bosate</char> sigbarĩ sia i ɔtilese iyo iso,</para>
  <para style="q2" vid="PRO 3:33">ɣɛɛ ɔsɛ ɔfere ɔturi bɔlɔlɔa kasɛkɔ̃ kusɛkusɛ.<verse eid="PRO 3:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34" />Ɔsɛ ɔbara maɣiãrase ma lote so aɣiãra</para>
  <para style="q2" vid="PRO 3:34">ɣɛɛ ɔsɛ ɔtã mabɔsokarɔĩ abualɛra.<verse eid="PRO 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35" />Mma mba iwola kaɖekɔ̃ nɖe kuwarɛ;</para>
  <para style="q2" vid="PRO 3:35">ɣɛɛ ɔsɛ ɔpia madzunisɛĩ kunuarɛ.<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" sid="PRO 4" />
  <para style="s1">Iwola Kusia</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1" />Wũ mabi, minɔ ɔse iturikpadzɛ̃ atɔ̃me;</para>
  <para style="q2" vid="PRO 4:1">misɛ atsue kukaakɔ si mianɔ ara karɔ̃.<verse eid="PRO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2" />Alasɔ kuka sɛɛ nto lotã mi,</para>
  <para style="q2" vid="PRO 4:2">ne ɔso midaanyua wũ araite mipɛyu.<verse eid="PRO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3" />Ɔwi wɔ loɖe kabirɛrɛĩ kere i tete iyo,</para>
  <para style="q2" vid="PRO 4:3">gu ɔbi ɔnɔwɛ̃saã wɔ loimɔ, lotã wũ ɔnyi ne,<verse eid="PRO 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 4:4" />tete ɔte me ara. Ɔɣere me sɔ,</para>
  <para style="q2" vid="PRO 4:4">"Mɔɛ̃ wũ atɔ̃me pia i iti ame kukaakɔ.</para>
  <para style="q2" vid="PRO 4:4">Bara sia i wũ mmaraisi iso, si aasɛ ngbã.<verse eid="PRO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5" />Bie iwola, si abie karɔ̃inɔ;</para>
  <para style="q2" vid="PRO 4:5">daaɣara wũ atɔ̃me ɣee anyua wã asɛ.<verse eid="PRO 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6" />Daanyua iwola asɛ, iyɔ ɔto ɔ̃adzuɛ̃-ɔ.</para>
  <para style="q2" vid="PRO 4:6">Ɖɔɛ wũ, iyɔ ɔto ɔ̃anyɔ-ɔ iso.<verse eid="PRO 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7" />Iwola nɖe ira nɛ lonya iɖo; ne ɔso bie iwola.</para>
  <para style="q2" vid="PRO 4:7">Si ana ara gbodzoo kɔraa ne, bie karɔ̃inɔ.<verse eid="PRO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8" />Dzuĩ wũ sɔ ɔɖe ira ne lofɔ kuɣa, iyɔ ɔto ɔ̃akɔlɛ-ɔ kato.</para>
  <para style="q2" vid="PRO 4:8">Pɔrɛ wũ pia so, ɔto ɔ̃apia-ɔ kuwarɛ.<verse eid="PRO 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9" />Iwola to ɔ̃ase lɛ aɣɔ̃la wa nto alɛnyɔ i fɔ iti iso,</para>
  <para style="q2" vid="PRO 4:9">fiɛ ɔ̃asu igaraikoto nɛ nto ilɛnyɔ ɔtɔmedza-ɔ."<verse eid="PRO 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10" />Wũ ɔbi, kã wũ atɔ̃me atsue si afɔ wã apia i kame,</para>
  <para style="q2" vid="PRO 4:10">si aasɛ ngbã afɔ akɔ gbodzoo.<verse eid="PRO 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11" />Iwola ɔri ɔɖe nto lote-ɔ</para>
  <para style="q2" vid="PRO 4:11">fiɛ siri tɔrɔrɔa iso nto lokɔkɔ-ɔ lokigu.<verse eid="PRO 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12" />Si asɛ ne, kuira iibaya-ɔ i ɔri iso,</para>
  <para style="q2" vid="PRO 4:12">si ato atere ise ne, aibatura i kuira iso.<verse eid="PRO 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13" />Mɔɛ̃ ara wa mate-ɔ la teteree; daanyua wã asɛ.</para>
  <para style="q2" vid="PRO 4:13">Dzuɛ̃ ne kukaakɔ, alasɔ ne nɖe fɔ ngbã ne.<verse eid="PRO 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14" />Daasɛ i matilese kanenekɔ̃;</para>
  <para style="q2" vid="PRO 4:14">ɣee daaki i maturi nyanyariã kakikɔ̃.<verse eid="PRO 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15" />Sɛ̃ ɔri wɔmɔ, daasɛ i ɔ̃ iso.</para>
  <para style="q2" vid="PRO 4:15">Sɛnɛkɛ̃ i ɔ̃ iso si aki i ɔri mama iso akɛlɛ.<verse eid="PRO 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16" />Alasɔ maisɛ mawo ɔrɛ si maibara iranyanyariã.</para>
  <para style="q2" vid="PRO 4:16">Maisɛ marɛ sirɛ tagbi mabara ɔturi iraboa.<verse eid="PRO 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17" />Ɔtile ibara nɖe ma aɖera</para>
  <para style="q2" vid="PRO 4:17">fiɛ amumuɔ nɖe ma ndã mɛ manɛ.<verse eid="PRO 4:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18" />Ɔturi bɔlɔlɔa ɔri se lɛ kaya kuɣɛ̃ ibɔrɛ awe.</para>
  <para style="q2" vid="PRO 4:18">Kusɛ kufiɛ kuledza ifiɛ kubua gbɔgbɔɔgbɔ kaɖe ɔɔkpa kukaakɔ.<verse eid="PRO 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19" />Matilese ɔri se lɛ idududu kpirikpiria awe.</para>
  <para style="q2" vid="PRO 4:19">Maisɛ matsue nnɛ nsɛ itã matura.<verse eid="PRO 4:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20" />Wũ ɔbi, sɛ atɔ̃me wa nto loɣɛ atsue,</para>
  <para style="q2" vid="PRO 4:20">si akã wũ atɔ̃me wa nto loɣere-ɔ atsue kukaakɔ.<verse eid="PRO 4:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21" />Daatã wã arui i fɔ anɔmi iso,</para>
  <para style="q2" vid="PRO 4:21">ledza wã pia i fɔ ɔtu ame.<verse eid="PRO 4:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22" />Alasɔ aɖe ngbã atã mma nsɛ mana wã,</para>
  <para style="q2" vid="PRO 4:22">fiɛ iɖe isosarɛ itã kuturidziri ɔɖuɖu.<verse eid="PRO 4:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23" />I wã ɔɖuɖu ame ne, dzuɛ̃ fɔ ɔtu kukaakɔ,</para>
  <para style="q2" vid="PRO 4:23">alasɔ ɔtu ame i irabiara nɛ asɛ abara i ngbã ame ɔbɔrɛ.<verse eid="PRO 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24" />Tsiri nnɛ loiɖe ɔnukuare iɣɛ,</para>
  <para style="q2" vid="PRO 4:24">si arera so kama i kasɔla gu mila atɔ̃me iɣɛ kɔrɛ.<verse eid="PRO 4:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25" />Tã fɔ anɔmi si anyɔ fɔ katɔ̃ siĩ,</para>
  <para style="q2" vid="PRO 4:25">si anyɔ nnɛ nsɛ-ɔ i katɔ̃ tutuutu.<verse eid="PRO 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26" />Ɖi siri sɛɛ dzɛ iso aaki tã so</para>
  <para style="q2" vid="PRO 4:26">si asu siri dzɛ nɣɛ teteree kere.<verse eid="PRO 4:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27" />Daasɛnɛkɛ̃ akɛlɛ kuɖearɔ̃ ɣee kubena iso.</para>
  <para style="q2" vid="PRO 4:27">Rera so kama i iranyanyariã ɔri kɔrɛ.<verse eid="PRO 4:27" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="s1">Rera So Kama I Ɔturire Iso</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1" />Wũ ɔbi, kã wũ iwola atɔ̃me atsue,</para>
  <para style="q2" vid="PRO 5:1">si akã wũ araite gu karɔ̃inɔ atɔ̃me atsue kukaakɔ,<verse eid="PRO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2" />sɔ abara ara ku iwola,</para>
  <para style="q2" vid="PRO 5:2">fiɛ adzuɛ̃ fɔ kanya ame atɔ̃me ku inɔkpa.<verse eid="PRO 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3" />Alasɔ rãrɔdze kanya sɛ kaɣɛ atɔ̃me lɛ maɣendu mɛ nto misɔrɛ̃,</para>
  <para style="q2" vid="PRO 5:3">fiɛ ɔ̃ akaɖe ɔruɛ aɖo nnɔĩ;<verse eid="PRO 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4" />ɣɛɛ kawirikɔ̃ ɔsɛ ɔwe ɔɖo lɛ kanaroro awe,</para>
  <para style="q2" vid="PRO 5:4">fiɛ ɔsɛ ɔwe ɔbe lɛ ibeinyɔ itekpe awe.<verse eid="PRO 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5" />Ɔ̃ ngba sɛ miso mikɛlɛ kukpi kɔrɛ;</para>
  <para style="q2" vid="PRO 5:5">ne ɔ̃ inene sɛ ikɛlɛ siĩ ta ikpibiɔ ame.<verse eid="PRO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6" />Ɔ̃isɛ ɔbu iti ame kuiwɛ̃ i ngbã ɔri iso;</para>
  <para style="q2" vid="PRO 5:6">ɔ̃ siri ɔgɔgɔlɔ ɣɛɛ ɔ̃isɛ ɔtsue ngbɔ.<verse eid="PRO 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7" />Iyɔ wũ mabi, kiniɔ ne, mikã me atsue;</para>
  <para style="q2" vid="PRO 5:7">midaare kama i atɔ̃me wa nto loɣere mi kɔrɛ.<verse eid="PRO 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8" />Miki i ɔri wɔ iso miapia kama dzoroo i ɔrɔ̃go wɔgbe kɔrɛ,</para>
  <para style="q2" vid="PRO 5:8">midaasɛ ɔ̃ iyo kukui kɔrɛ,<verse eid="PRO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9" />si iiɖe ngbɔ ne, mito miasu mi kuwarɛ mitã maturi mama,</para>
  <para style="q2" vid="PRO 5:9">miasu mi akɔ mitã nwɔ nɖe ɔtilese.<verse eid="PRO 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10" />Si iiɖe ngbɔ ne mafɔ to maaɖe mi karana mami,</para>
  <para style="q2" vid="PRO 5:10">fiɛ mi awururu, to akɛlɛ aarera ɔturi mama iyo.<verse eid="PRO 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11" />I fɔ ngbã kawirikɔ̃ ne, ato aatɔtɔrɛ̃,</para>
  <para style="q2" vid="PRO 5:11">si so ɔɔtu fɔ sosina fiɛ siɔfɛ̃.<verse eid="PRO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 5:12" />Ato aaɣɛ sɔ, "Lotsiri ikpadzɛ̃ lo!</para>
  <para style="q2" vid="PRO 5:12">Wũ ɔtu ɔsɛ iyira i karɔ̃ pupurii!<verse eid="PRO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13" />Losɛ̃ loinɔ wũ maratedze atɔ̃me;</para>
  <para style="q2" vid="PRO 5:13">loikã wũ maratedze araite atsue.<verse eid="PRO 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14" />Itikpi ɔro ɔba me iso</para>
  <para style="q2" vid="PRO 5:14">ku kunuarɛ i iturikuri ɔɖuɖu nɛ losakanya ndɛ̃."<verse eid="PRO 5:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15" />Nɛ ndu bɔrɛgu i fɔ mɔmɔ itawo ame,</para>
  <para style="q2" vid="PRO 5:15">si anɛ ndu mɛ nto miyi misia i fɔ itubiɔ ame.<verse eid="PRO 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16" />Fɔ ndu mɛ nto miyi misia si mibiɛ mikɛlɛ sivurã iso?</para>
  <para style="q2" vid="PRO 5:16">Fɔ kuworei gɔ lobɔrɛ i me ame si kubore i itiri?<verse eid="PRO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17" />Tã aɖe fɔ ɔnɔwɛ̃ are,</para>
  <para style="q2" vid="PRO 5:17">aibaɖe mi gu mafɔ are kuiyikuiyi.<verse eid="PRO 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18" />Fɔ ndu godɛã si miɖe kusɛkusɛ mitã-ɔ,</para>
  <para style="q2" vid="PRO 5:18">si ana isoɣɔ i fɔ siporoporoi ame ɔre iso.<verse eid="PRO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19" />Ɖuirɔ̃go lɛnyɔa, ɖuibitɛ ɔɖe.</para>
  <para style="q2" vid="PRO 5:19">Tã ɔ̃ anyɛ si apia-ɔ ɔmɛrɛ̃ i mina ame ɔwi biara,</para>
  <para style="q2" vid="PRO 5:19">si ɔ̃ kuɖɔɛ si kupia-ɔ isoɣɔ.<verse eid="PRO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20" />Wũ ɔbi, be ɔso aabie sɔ aasiai rãrɔdze?</para>
  <para style="q2" vid="PRO 5:20">Be ɔso aapɔrɛ rãrɔdze apia so?<verse eid="PRO 5:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21" />Ɔturi siri gu nsɛgbai se kpawee i <char style="nd">Bosate</char> anɔmi ame,</para>
  <para style="q2" vid="PRO 5:21">fiɛ ɔsɛ ɔtsue ɔ̃ siri ɔɖuɖu.<verse eid="PRO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22" />Ɔtilese aranyanyariã ibara nsɛ amɔɛ̃ wũ lɛ kata,</para>
  <para style="q2" vid="PRO 5:22">fiɛ ɔ̃ akpi siwɛ̃ nsɛ sinyi wũ teteree.<verse eid="PRO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23" />Ɔturi wɔ nna iturikpadzɛ̃ ne, ɔkpi ɔsɛ ɔkpi,</para>
  <para style="q2" vid="PRO 5:23">fiɛ ɔ̃ mɔmɔ adzunisɛ̃ra gbodzoo nsɛ akã wũ ayura.<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" sid="PRO 6" />
  <para style="s1">Atɔ̃me Mama Wa Iso Ɔturi Aadzuɛ̃ So</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 6:1" />Wũ ɔbi, si aya i fɔ ɔnyii kama,</para>
  <para style="q2" vid="PRO 6:1">aya i kuso kanya atã ɔturi mama ne,<verse eid="PRO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 6:2" />fiɛ fɔ kanya ɔɔpia-ɔ i kata ame,</para>
  <para style="q2" vid="PRO 6:2">fiɛ fɔ atɔ̃me wa aɣɛ ɔnyi-ɔ ato ne,<verse eid="PRO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 6:3" />iyɔ ɔɔbo i fɔ ɔnyii nrɔɔ̃ ame.</para>
  <para style="q2" vid="PRO 6:3">Wũ ɔbi, nnɛ aabara aɖi so nɖe sɔ:</para>
  <para style="q1" vid="PRO 6:3">Kɛlɛ ɔ̃ kɔrɛ si abɔsokarɔ̃;</para>
  <para style="q2" vid="PRO 6:3">si apɛ fɔ ɔnyii nrɔɔ̃ teteree!<verse eid="PRO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4" />Daama anɔmi arɛ sirɛ,</para>
  <para style="q2" vid="PRO 6:4">daatua sirɛ ana kɔraa.<verse eid="PRO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5" />Ɖi so lɛ kumɛgɔ i kasɔlɔ sɛ kaɖi so kabɔrɛgu i gbere nrɔɔ̃ ame,</para>
  <para style="q2" vid="PRO 6:5">lɛ kumɛgɔ i karodzai sɛ kaɖi so kabɔrɛgu i karɔisɛdze ɔwɛ̃ ame awe.<verse eid="PRO 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6" />Dãdze, kɛlɛ kabɔibi kɔrɛ;</para>
  <para style="q2" vid="PRO 6:6">si anyɔ kã arabarara si atsue iwola!<verse eid="PRO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 6:7" />Kɔdze na wũ</para>
  <para style="q2" vid="PRO 6:7">nyɔisose ɣee ɖeisose kuwɛ̃ ana na wũ.<verse eid="PRO 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 6:8" />Ɣɛɛ ɔsɛ ɔledza araɖea ɔkɔla ɔsɛ i kusɛ ame,</para>
  <para style="q2" vid="PRO 6:8">fiɛ ɔsɛ ɔsira ɔ̃ araɖea kanya ku ɔraɖui ɔsɔrɛ̃wi.<verse eid="PRO 6:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9" />Ɖãdze, ku me ɔwi aakɛlɛ arɛ i mmɔ isɛ iabo?</para>
  <para style="q2" vid="PRO 6:9">Iɖe ɔwi wɔ aata i sirɛ?<verse eid="PRO 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10" />Si nrɛ kɛkɛĩ, ntua sirɛ kɛkɛĩ,</para>
  <para style="q2" vid="PRO 6:10">lopia nrɔɔ̃ i ngba ame losɛ lowarã ni -<verse eid="PRO 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 6:11" />siwɛrɛba to siaba-ɔ iso lɛ yukukpe awe</para>
  <para style="q2" vid="PRO 6:11">fiɛ idaawe aabo-ɔ iso lɛ adzoɖaɛse awe.<verse eid="PRO 6:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12" />Nwɔ nɖe ipɛ̃ gu ɔtilese</para>
  <para style="q2" vid="PRO 6:12">ɔ̃ nsɛ ɔkiki ɔla mila ne.<verse eid="PRO 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 6:13" />Ɔsɛ ɔma ɔturi anɔmi,</para>
  <para style="q2" vid="PRO 6:13">ɔbara ikparĩ ku ngba i karɔ̃,<note caller="+" style="fe"><char style="fr" closed="false">6.13 </char><char style="ft" closed="false" /></note></para>
  <para style="q2" vid="PRO 6:13">fiɛ ɔsɛ ɔsu nrɔɔ̃ gu arɔĩ ɔbara ala akparĩ.<verse eid="PRO 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 6:14" />Ɔɖe kasɔla ɔturi, ɔsɛ ɔbara iranyanyariã adzuni -</para>
  <para style="q2" vid="PRO 6:14">fiɛ ɔsɛ ɔpia kulu i maturi ndɛ̃ ɔwi biara.<verse eid="PRO 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15" />Ne ɔso kukpakpi to kuaba wũ iso ɔluwɛ̃ kere,</para>
  <para style="q2" vid="PRO 6:15">ɔto ɔ̃afɛ̃ ɔluwɛ̃ - gɔ ɔ̃isibawo ɔta i ɔnyɛ.<verse eid="PRO 6:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 6:16" />Ara akuɔ pia i <char style="nd">Bosate</char> sɛ ɔtsiri,</para>
  <para style="q2" vid="PRO 6:16">wã akɔdzɛ ɖe anyanyara atã wũ:<verse eid="PRO 6:16" /></para>
  <para style="q3">
    <verse number="17" style="v" sid="PRO 6:17" />iteso anɔmi,</para>
  <para style="q3" vid="PRO 6:17">mila ɔnyagɛmi,</para>
  <para style="q3" vid="PRO 6:17">nrɔɔ̃ mɛ lofere mma loiɣɛrɛ ima i karɔ̃,<verse eid="PRO 6:17" /></para>
  <para style="q3">
    <verse number="18" style="v" sid="PRO 6:18" />ɔtu wɔ nsɛ ɔbara siriita nyanyariã,</para>
  <para style="q3" vid="PRO 6:18">ngba mɛ nsɛ mipɛsiwa i iranyanyariã ibara iso,<verse eid="PRO 6:18" /></para>
  <para style="q3">
    <verse number="19" style="v" sid="PRO 6:19" />aɖansiɛ ladze wɔ nsɛ ɔla mila</para>
  <para style="q3" vid="PRO 6:19">gu ɔturi wɔ nsɛ ɔpia kulu i manyiibi ndɛ̃.<verse eid="PRO 6:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 6:20" />Wũ ɔbi, mɔɛ̃ fɔ ɔse mmaraisi la</para>
  <para style="q2" vid="PRO 6:20">si adaanyua fɔ ɔnyi araite apɛyu.<verse eid="PRO 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21" />Nyi wã sia i fɔ ɔtu iso ɔwi biara,</para>
  <para style="q2" vid="PRO 6:21">si anyi wã apia i ɔme.<verse eid="PRO 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 6:22" />Si asɛ ne, ato aakɔkɔ-ɔ,</para>
  <para style="q2" vid="PRO 6:22">si arɛ ne, aadzuɛ̃-ɔ,</para>
  <para style="q2" vid="PRO 6:22">si ata ne, aaɖegu-ɔ ika.<verse eid="PRO 6:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23" />Alasɔ mmaraisi mɛgbe ɖe ɔkaniɛ,</para>
  <para style="q2" vid="PRO 6:23">araite wagbe ɖe ɔtɔ,</para>
  <para style="q1" vid="PRO 6:23">fiɛ ikpadzɛ̃ iyira</para>
  <para style="q2" vid="PRO 6:23">nɖe ngbã ɔri,<verse eid="PRO 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24" />wa loaɖi-ɔ abɔrɛgu i sidzetɔrɔ̃go nrɔɔ̃ ame,</para>
  <para style="q2" vid="PRO 6:24">abɔrɛgu i rãrɔdze ɔnyamɛrɛ̃ atɔ̃me ame.<verse eid="PRO 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25" />Daatã ɔ̃ kulɛ si kukpɛ̃-ɔ ɔkã.</para>
  <para style="q2" vid="PRO 6:25">Ɣee daatã ɔ̃ anɔmi ikikidza si imɔɛ̃-ɔ.<verse eid="PRO 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26" />Alasɔ sidzetɔrɔ̃go ne, ɔ̃abɔ-ɔ karɔ̃ ase lɛ boɖoboɖo kaboi kere,</para>
  <para style="q2" vid="PRO 6:26">fiɛ rãrɔdze aatã ayura fɔ mɔmɔ ngbã.<verse eid="PRO 6:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 6:27" />Ɔrɛrɛ̃ aawo ɔtɔ ɔɖi ɔsia so iso</para>
  <para style="q2" vid="PRO 6:27">sɔ ɔ̃ arapia iibatsue?<verse eid="PRO 6:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28" />Ɣee ɔturi aawo ɔsɛ i atɔgirĩ iso</para>
  <para style="q2" vid="PRO 6:28">sɔ ɔ̃ ngba iibatsue?<verse eid="PRO 6:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29" />Ngbɔ kere ise itã ɔrɛrɛ̃ wɔ nsɛ ɔrɛgu ɔturire ne.</para>
  <para style="q2" vid="PRO 6:29">Ɔbiara wɔ nsɛ ɔrɔ ɔturire ne, maakpadzɛ̃ wũ kutsue.<verse eid="PRO 6:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30" />Maturi iisɛ manyɔ yukukpe pupurii si kukã to wũ</para>
  <para style="q2" vid="PRO 6:30">fiɛ ɔyu ira ɔɖe ɔsu ɔnidza kɔ̃.<verse eid="PRO 6:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31" />Ɣɛɛ si mamɔɛ̃ wũ ne, ikote sɔ ɔ̃atã kuso ikpɛ ikɔdzɛ,</para>
  <para style="q2" vid="PRO 6:31">atoasɔ ɔto ɔ̃asu ɔ̃ iyo ara ɔɖuɖu ɔtã kuso.<verse eid="PRO 6:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32" />Ɣɛɛ ɔrɛrɛ̃ wɔ nsɛ ɔrɛgu ɔturire ne ɔna adzuni.</para>
  <para style="q2" vid="PRO 6:32">Ɔrɛrɛ̃ wɔ nsɛ ɔbara kumɛɔ ne ɔsɛ ɔwɔra so.<verse eid="PRO 6:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 6:33" />Agbɛ gu kunuarɛ loaɖe ɔ̃ ɔkpɛ,</para>
  <para style="q2" vid="PRO 6:33">fiɛ ɔ̃ kunuarɛ iibaro kuiyikuiyi.<verse eid="PRO 6:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34" />Alasɔ sirerɛ sɛ sitã ɔrã ɔna sikpã gbaã,</para>
  <para style="q2" vid="PRO 6:34">iyɔ ɔ̃ibanyɔ nnya si ɔto ɔbara ɔtikuso.<verse eid="PRO 6:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35" />Ɔ̃ibatɔrã ɔfɔ ikpata kuso kukuwɛ̃,</para>
  <para style="q2" vid="PRO 6:35">fiɛ ɔ̃ibafɔ kuwɛrɛso kumekume kusi.<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" sid="PRO 7" />
  <para style="s1">Isɛ̃itã Atɔ̃me Mama I Rãrɔdze Iso</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 7:1" />Wũ ɔbi, mɔɛ̃ wũ atɔ̃me la,</para>
  <para style="q2" vid="PRO 7:1">si aledza wũ mmaraisi apia i fɔ ame.<verse eid="PRO 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2" />Mɔɛ̃ wũ mmaraisi la si aawe ngbã.</para>
  <para style="q2" vid="PRO 7:2">La wũ araite kukaakɔ lɛ fɔ inɔmibi awe.<verse eid="PRO 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 7:3" />Nyi wã sia i fɔ arɔĩ iso;</para>
  <para style="q2" vid="PRO 7:3">si atsɛrɛ wã asia i fɔ ame i ɔtu iso.<verse eid="PRO 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4" />Ɣere iwola sɔ, "Fɔ nɖe wũ ɔnyiiko,"</para>
  <para style="q2" vid="PRO 7:4">si akpere karɔ̃inɔ sɔ fɔ lɛdze.<verse eid="PRO 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5" />Ara wagbe aaɖi-ɔ abɔrɛgu i rãrɔdze kɔrɛ,</para>
  <para style="q2" vid="PRO 7:5">aɖi-ɔ i ɔturire wɔ loɔɖe so iso ku ɔ̃ ɔnyamɛrɛ̃ atɔ̃me kɔrɛ.<verse eid="PRO 7:5" /></para>
  <para style="b" />
  <para style="s1">Sidzetɔrɔ̃go</para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 7:6" />Ɔwi ɔwɛ̃ ne, loya i wũ iyo fesere kɔrɛ</para>
  <para style="q2" vid="PRO 7:6">loto lonyɔ ara lokigu i iyoi ame.<verse eid="PRO 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 7:7" />Lonya maporoporoi mawɛ̃ ma loiɣe kayi ame,</para>
  <para style="q2" vid="PRO 7:7">ne lonya kaporoporoi kawɛ̃</para>
  <para style="q2" vid="PRO 7:7">gɔ kana adzuni kɔraa i ma ndɛ̃.<verse eid="PRO 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8" />Ɔsɛ i ɔvurã iso ɔso ɔto ɔkɛlɛ sidzetɔrɔ̃go iyo isɛ,</para>
  <para style="q1" vid="PRO 7:8">i ngbegɔ ivurãkpasa pia,<verse eid="PRO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9" />ku iɣɛ̃kɛlɛ, nbgɔ ame i kaɖe ɔtsɛ iro kere,</para>
  <para style="q2" vid="PRO 7:9">fiɛ idududu to isɛ karɔ̃.<verse eid="PRO 7:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 7:10" />Kere ne ɔrɔ̃go wɔmɔ ɔpia ara lɛ nwɔ nsɛ ɔsiai marɛrɛ̃ awe,</para>
  <para style="q2" vid="PRO 7:10">ɔba ɔ̃sarɛgu wũ fiɛ ɔwe kasɔla kasusu.<verse eid="PRO 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11" />(Ɔɖe nwɔ nsɛ ɔlakulu gu nwɔ loiwarɛ ara;</para>
  <para style="q2" vid="PRO 7:11">ɔ̃isɛ ɔwe i iyo kuiyikuiyi.<verse eid="PRO 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12" />Si aanyɔ ka ɔɣɛ i ɔvurã iso, kiniɔ ame ka ɔpia i itiri,</para>
  <para style="q2" vid="PRO 7:12">si ka akpɛ̃ so, ka ɔɣɛ i ɔɣokã biara ame, ɔto ɔlala anɔmi.)<verse eid="PRO 7:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="PRO 7:13" />Ɔpɔrɛ ɔporoporoi wɔmɔ ɔpia so ne ɔfiɔ̃ kanya ne,</para>
  <para style="q2" vid="PRO 7:13">ne ɔrɔ̃go ɔkidza anɔmi ɔnyɔ wũ totoroo ɔɣɛ sɔ:<verse eid="PRO 7:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 7:14" />"Nɔme ne nto lotã wũ ndamu mɛ lokã kuso;</para>
  <para style="q2" vid="PRO 7:14">loba isobuɛ isɔrɛ loabara i iyo.<verse eid="PRO 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15" />Ne ɔso lobɔrɛ loba loasarɛgu-ɔ ne.</para>
  <para style="q2" vid="PRO 7:15">Loɔnyɔnyɔ-ɔ fiɛ kini lonya-ɔ ne!<verse eid="PRO 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16" />Nyɔ, wũ karɛkɔ̃ ne, losɛ kã ku ara</para>
  <para style="q2" vid="PRO 7:16">ku akalala ku kukua wa mabɔrɛgu i Egipte karɔ̃ iso.<verse eid="PRO 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17" />Lofere ngarãdu mɛ</para>
  <para style="q2" vid="PRO 7:17">masu korobo, pepere gu sinamon mabara ala i wũ karɛkɔ̃ iso.<verse eid="PRO 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18" />Ba, bokɛlɛ boabara kuɖɔɛ bomi gbɔgbɔɔgbɔ kɔrã kaya;</para>
  <para style="q2" vid="PRO 7:18">tã bopia so isoɣɔ ku kuɖɔɛ kukaakɔ!<verse eid="PRO 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19" />Wũ ɔrã na i kaa;</para>
  <para style="q2" vid="PRO 7:19">ɔkpa ɔri dzoroa.<verse eid="PRO 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20" />Ɔsu sikã gbodzoo ɔpia i ɔ̃ kakotokui ame,</para>
  <para style="q2" vid="PRO 7:20">ɔgbaleti to ɔ̃aka ibi fiɛ ɔ̃akpese ɔba kaa."<verse eid="PRO 7:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 7:21" />Ɔrɔ̃go ɔsu atɔ̃me mɛrɛ̃mɛrɛã ɔsɔsɔla ɔporoporoi</para>
  <para style="q2" vid="PRO 7:21">fiɛ ɔsu kasɔla ɔnyamɛrɛ̃ akaɖe ɔmɔɛ̃ wũ.<verse eid="PRO 7:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22" />Ɔsiai ɔrɔ̃go ɔluwɛ̃</para>
  <para style="q2" vid="PRO 7:22">lɛ nantsuĩrɛrɛ̃ wɔ maaɖoe awe,</para>
  <para style="q1" vid="PRO 7:22">ɔsiai wũ lɛ kasɔlɔ nto kabo i kakpasa ame,<verse eid="PRO 7:22" /></para>
  <para style="q2">
    <verse number="23" style="v" sid="PRO 7:23" />gbɔgbɔɔgbɔ sirɛ̃ sɛ sitsue kã akɔ̃.</para>
  <para style="q1" vid="PRO 7:23">Ɔporoporoi wɔmɔ ɔse kere lɛ karodzai ga lotere kabo i kata ame awe,</para>
  <para style="q2" vid="PRO 7:23">fiɛ ɔ̃iɣe kɔraa sɔ ɔ̃ ngbã kawirikɔ̃ i mmɔ ne.<verse eid="PRO 7:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 7:24" />Kiniɔ ne, wũ mabi, mikã me atsue,</para>
  <para style="q2" vid="PRO 7:24">misɛ atsue minɔ nnɛ nto loɣɛ.<verse eid="PRO 7:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 7:25" />Midaatã sɔ mi ɔtu aafiriki ɔsia i ɔrɔ̃go wɔgbe igbã nsɛgbai iso,</para>
  <para style="q2" vid="PRO 7:25">midaayu ɔri mikɛlɛ ɔ̃ kukikɔ̃ iso.<verse eid="PRO 7:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 7:26" />Ɔ̃ɔtara maturi gbodzoo ɔɖe i karɔ̃;</para>
  <para style="q2" vid="PRO 7:26">maturi ma ɔ̃ɔwɔra ɔsi gbaã.<verse eid="PRO 7:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27" />Si asɛ ɔ̃ kɔrɛ i ɔ̃ iyo ne, asɛ i ɔri siare iso ato akɛlɛ makpise aɖe.</para>
  <para style="q2" vid="PRO 7:27">Kɛlɛ ɔ̃ kasɛkɔ̃ ato aasɛ katɔ̃ akɛlɛ fɔ ikpibiɔ ame.<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" sid="PRO 8" />
  <para style="s1">Iwola Ile</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1" />Iwola iisɛ ɔkperegu, kulu ɣɛɛ?</para>
  <para style="q2" vid="PRO 8:1">Karɔ̃inɔ iisɛ ikɔlɛ silɔ kato ɣɛɛ?<verse eid="PRO 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2" />Ɔta ɔɣɛ i kubemi iso i ɔri kuruɛ,</para>
  <para style="q2" vid="PRO 8:2">ɔɖi kayakɔ̃ i irikpasa.<verse eid="PRO 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3" />Ɔɣɛ i kuyogodɔ̃ kuruɛ, to ikɛlɛ ɔmagɛ̃siare ame,</para>
  <para style="q2" vid="PRO 8:3">i kubɔrɛnya ne ɔto ɔɣɛ teteree sɔ,<verse eid="PRO 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4" />"Maturi awune, mi nto lokpere lo.</para>
  <para style="q2" vid="PRO 8:4">Maturi awune mabi ɔɖuɖu, mi nto lokɔlɛ silɔ kato lokpere.<verse eid="PRO 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5" />Mi ma nɖe makoso, mitsɛ iwola itsue gu ikososo.</para>
  <para style="q2" vid="PRO 8:5">Mi madzunisɛĩ minɔ ara karɔ̃.<verse eid="PRO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6" />Mikã atsue, alasɔ atɔ̃me nyaa loaɣere mi.</para>
  <para style="q2" vid="PRO 8:6">Nnɛ loya, ilɛ loabusi kanya loɣɛ.<verse eid="PRO 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7" />Loto lobusi kanya loɣɛ ɔnukuare,</para>
  <para style="q2" vid="PRO 8:7">alasɔ wũ kanya ɔtsiri mila.<verse eid="PRO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8" />Wũ kanya ame atɔ̃me ɔɖuɖu ɔya;</para>
  <para style="q2" vid="PRO 8:8">kasɔla gu mila na i wã kuiwɛ̃ ame.<verse eid="PRO 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9" />Wã ɔɖuɖu ame ɔkpa nwɔ nsɛ ɔnɔ ara karɔ̃,</para>
  <para style="q2" vid="PRO 8:9">asɛ akote nwɔ mba inɔkpa.<verse eid="PRO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10" />Miɖi wũ araite i sikãfudza kanya,</para>
  <para style="q2" vid="PRO 8:10">miɖi inɔkpa i sikãrɛtɛa sɛɛ kanya.<verse eid="PRO 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11" />Alasɔ iwola lɛ iɖo ikɛrɛra sɛɛ,</para>
  <para style="q2" vid="PRO 8:11">kuira na aabie sɔ iakategu ne.<verse eid="PRO 8:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12" />"Mme iwola, lopiagu anɔibe losakanya;</para>
  <para style="q2" vid="PRO 8:12">loba inɔkpa gu inyaiɖiite.<verse eid="PRO 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13" />
    <char style="nd">Bosate</char> kunigã nɖe iranyanyariã itsiri.</para>
  <para style="q2" vid="PRO 8:13">Lotsiri iteso gu katoikɔlɛso.</para>
  <para style="q2" vid="PRO 8:13">Lotsiri nsɛgbai nyanyariã gu mila atɔ̃me iɣɛ.<verse eid="PRO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14" />Kuka gu iwola ɖe wũ are;</para>
  <para style="q2" vid="PRO 8:14">loba karɔ̃inɔ fiɛ loba ɔle.<verse eid="PRO 8:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15" />Wũ iso i magara sɛ maki maɖe sigara</para>
  <para style="q2" vid="PRO 8:15">fiɛ wũ iso maɖeisoi sɛ maki mabara mmara mɛ loya.<verse eid="PRO 8:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16" />Wũ iso i maɖeisoi sɛ maki maɖeiso,</para>
  <para style="q2" vid="PRO 8:16">fiɛ wũ iso i makpakpaturi ɔɖuɖu sɛ maɖeiso i karɔ̃ iso.<verse eid="PRO 8:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17" />Nsɛ loɖɔɛ mma nsɛ maɖɔɛ me</para>
  <para style="q2" vid="PRO 8:17">fiɛ mma nsɛ mabie me teteree sɛ manya me.<verse eid="PRO 8:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18" />Karana gu kuwarɛ se me;</para>
  <para style="q2" vid="PRO 8:18">karana gu ara bɔlɔlɔa ibara wa loasɛ pia i wũ kɔrɛ.<verse eid="PRO 8:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19" />Wũ idziribi lɛ iɖo sikãrɛtɛa sɛɛ.</para>
  <para style="q2" vid="PRO 8:19">Wũ kusia ɔfɔ kuɣa kuɖo sikãfudza sɛɛ.<verse eid="PRO 8:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20" />Ara bɔlɔlɔa ibara i ɔri iso nsɛ losɛ,</para>
  <para style="q2" vid="PRO 8:20">fiɛ itɔ̃me nɛ loya ɔri iso nsɛ loki,<verse eid="PRO 8:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21" />sɔ si loɣɛ karana lotã maturi ma loɖɔɛ me,</para>
  <para style="q2" vid="PRO 8:21">si lotã ma ara si ayi ma ara kakɔlakɔ̃.<verse eid="PRO 8:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22" />"Mme nɖe ira ɖeakatɔ̃ nɛ i <char style="nd">Bosate</char> ɔbara ku ɔwi wɔ ɔsɛ ɔ̃ karabara karɔ̃,</para>
  <para style="q2" vid="PRO 8:22">fiɛ ka ɔbara ɔ̃ kokowi ara.<verse eid="PRO 8:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23" />Ɔɖi me ɔsɛ kokooko,</para>
  <para style="q2" vid="PRO 8:23">ita karɔ̃kasɛkɔ̃ fiɛ kayiiso ɔba kaare kaya.<verse eid="PRO 8:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24" />Maɔɣe me ku ɔwi wɔ sipo na,</para>
  <para style="q2" vid="PRO 8:24">loɖe siwore kugodɛkɔ̃ ngbegɔ i ndu ɔyi pelepele katɔ̃.<verse eid="PRO 8:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25" />Fiɛ maasɛra abe i karɔ̃,</para>
  <para style="q2" vid="PRO 8:25">si abemi aaba ne, maɔɣe me koko.<verse eid="PRO 8:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26" />Maɔɣe me mpia fiɛ mabara karɔ̃, kã adziri gu sikua,</para>
  <para style="q2" vid="PRO 8:26">ɣee fiɛ mabara kayiiso sise sirere ana.<verse eid="PRO 8:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27" />Lopia fiɛ <char style="nd">Bosate</char> ɔsɛra kato i kã kasɛkɔ̃,</para>
  <para style="q2" vid="PRO 8:27">fiɛ ɔsia igbado ɔkpɛ giligilia i ndu kuwodorokɔ̃ iso.<verse eid="PRO 8:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28" />Ka mpia ku ɔwi wɔ ɔsɛra adɔdɔ i kato,</para>
  <para style="q2" vid="PRO 8:28">fiɛ ɔɣedza kuwodorokɔ̃ ndu kugodɛkɔ̃ i karɔ̃.<verse eid="PRO 8:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 8:29" />Ka mpia ku ɔwi wɔ ɔsɛ ame ɔtã ɔpo</para>
  <para style="q2" vid="PRO 8:29">sɔ ndu iibatu ɔ̃ mmaraisi,</para>
  <para style="q1" vid="PRO 8:29">ka mpia fiɛ ɔsɛra sikaĩ ɔtã karɔ̃.<verse eid="PRO 8:29" /></para>
  <para style="q2">
    <verse number="30" style="v" sid="PRO 8:30" />Iyɔ ne mme loɖe kusɛ̃baradze i ɔ̃ kɔrɛ.</para>
  <para style="q1" vid="PRO 8:30">Loyigu isoɣɔ ku ikpɛnɛ biara.</para>
  <para style="q2" vid="PRO 8:30">Nsɛ lona isoɣɔ i ɔ̃ anɔmi ame ɔwi biara.<verse eid="PRO 8:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31" />Nsɛ lona isoɣɔ i ɔ̃ kayiiso ɔɖuɖu iso</para>
  <para style="q2" vid="PRO 8:31">fiɛ so sɛ siɣɔ me i maturi awune iso.<verse eid="PRO 8:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32" />"Wũ mabi, kiniɔ ne, ka mikã me atsue.</para>
  <para style="q2" vid="PRO 8:32">So aaɣɔ mma nsɛ maki i wũ siri iso.<verse eid="PRO 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33" />Mikã wũ araite atsue si mitsue iwola.</para>
  <para style="q2" vid="PRO 8:33">Midaasɛ̃ ne.<verse eid="PRO 8:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34" />So aaɣɔ ɔturi wɔ nsɛ ɔkã me atsue,</para>
  <para style="q2" vid="PRO 8:34">fiɛ ɔto ɔnyɔ tuee i wũ kuyogodɔ̃ iyi biara,</para>
  <para style="q2" vid="PRO 8:34">fiɛ ɔɣɛ ɔsia i wũ kukui kanya.<verse eid="PRO 8:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35" />Alasɔ ɔturi wɔ nsɛ ɔnya me ne, ɔsɛ ɔna ngbã,</para>
  <para style="q2" vid="PRO 8:35">fiɛ <char style="nd">Bosate</char> sɛ ɔnyɔ wũ nnya.<verse eid="PRO 8:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36" />Ɣɛɛ ɔturi wɔ loisɛ ɔnya me sɛ ɔbara so kako;</para>
  <para style="q2" vid="PRO 8:36">mma ɔɖuɖu lotsiri me ne, kukpi masɛ maɖɔɛ."<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" sid="PRO 9" />
  <para style="s1">Iwola Gu Adzunisɛ̃</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 9:1" />Iwola ɔɔtsue ɔ̃ iyo;</para>
  <para style="q2" vid="PRO 9:1">ɔ̃ɔɣedza akpa akɔdzɛ i ne ame.<verse eid="PRO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2" />Ɔ̃ɔɖoe ɔ̃ bɔi fiɛ ɔ̃ɔlupura ɔ̃ wain,</para>
  <para style="q2" vid="PRO 9:2">fiɛ ɔ̃ɔtu ɔ̃ ɔpɔrɔ̃ ana.<verse eid="PRO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3" />Ɔ̃ɔpia ɔ̃ maɖaborɔ̃gomi ɔsese, si makpedza maturi</para>
  <para style="q2" vid="PRO 9:3">mabɔrɛgu i ɔmagɛ̃siare kakɔlɛkɔ̃.<verse eid="PRO 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 9:4" />Maɣɛ sɔ, "Mi madzunisɛĩ, miba i ngbe!"</para>
  <para style="q2" vid="PRO 9:4">Ɔsɛ ɔɣere mma nna inyaiɖiite sɛɛ sɔ,<verse eid="PRO 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 9:5" />"Miba miaɖe wũ araɖea,</para>
  <para style="q2" vid="PRO 9:5">si minɛ wũ ndã mɛ loɔlupu.<verse eid="PRO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 9:6" />Minyua mi adzunisɛ̃ siri, si miasɛ ngbã;</para>
  <para style="q2" vid="PRO 9:6">misɛ i karɔ̃inɔ ɔri iso.<verse eid="PRO 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 9:7" />"Ɔturi wɔ nsɛ ɔyira aɣiãrase ne, sitia ɔsɛ ɔnɔ;</para>
  <para style="q2" vid="PRO 9:7">ɔturi wɔ nsɛ ɔsɛ̃ ɔtilese ne, iraboa nsɛ ibara wũ.<verse eid="PRO 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8" />Daasɛ̃ atã aɣiãrase, ɔto ɔ̃atsiri-ɔ;</para>
  <para style="q2" vid="PRO 9:8">ɣɛɛ si asɛ̃ atã kawolai ne ɔto ɔ̃aɖɔɛ-ɔ.<verse eid="PRO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 9:9" />Te kawolai ara, ɔto ɔ̃atsue iwola ɔbua.</para>
  <para style="q2" vid="PRO 9:9">Te ɔturi bɔlɔlɔa ara, ɔto ɔ̃abua ne i ɔ̃ araisuã iso.<verse eid="PRO 9:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 9:10" />"<char style="nd">Bosate</char> kunigã nɖe iwola karɔ̃isɛ;</para>
  <para style="q2" vid="PRO 9:10">Ɔsekelea itsue nɖe ara karɔ̃inɔ.<verse eid="PRO 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11" />Alasɔ iki i iwola iso ne, maatã fɔ ayi ɔsi,</para>
  <para style="q2" vid="PRO 9:11">fiɛ maasu akɔ gbodzoo mabua-ɔ i ngbã ame.<verse eid="PRO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12" />Si atsue iwola ne, fɔ loana ne kusia,</para>
  <para style="q2" vid="PRO 9:12">si aɖe aɣiãrase ne, fɔ ɔnɔwɛ̃ loawe inyɛ."<verse eid="PRO 9:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 9:13" />Ɔrɔ̃go kadzunisɛĩ nsɛ ɔlakulu;</para>
  <para style="q2" vid="PRO 9:13">ɔna ikpadzɛ̃ fiɛ ɔna inɔkpa.<verse eid="PRO 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14" />Ɔsɛ ɔsɛ i iyara iso i ɔ̃ kukui kanya,</para>
  <para style="q2" vid="PRO 9:14">ɔsɛ ɔsɛ i iyara iso i ɔmagɛ̃siare kakɔlɛkɔ̃ ga loɖo,<verse eid="PRO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 9:15" />ɔto mma nsɛ mafe,</para>
  <para style="q2" vid="PRO 9:15">masɛ siĩ i ma ɔri iso ikpere.<verse eid="PRO 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 9:16" />Ɔsɛ ɔɣɛ sɔ, "Mitã mma ɔɖuɖu nɖe madzunisɛĩ si maba i ngbe!"</para>
  <para style="q2" vid="PRO 9:16">Ɔsɛ ɔɣere madzunisɛĩ sɔ,<verse eid="PRO 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 9:17" />"Ndu mɛ mayu sɛ miwe ɔmɛrɛ̃.</para>
  <para style="q2" vid="PRO 9:17">Aɖera wa maɖe i iwɛrɛ ame sɛ awe ɔmɛrɛ̃ nyɛkɛ̃nyɛkɛ̃!"<verse eid="PRO 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18" />Ɣɛɛ maiɣe ɖuɖuuɖu sɔ makpise pia i mmɔ,</para>
  <para style="q2" vid="PRO 9:18">fiɛ maiɣe sɔ ɔ̃ maturi kpedzaa pia i ikpibiɔ kawodorokɔ̃.<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" sid="PRO 10" />
  <para style="s1">Solomon Agbã</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1" />Solomon agbã ngbe ne:</para>
  <para style="q1" vid="PRO 10:1">Ɔbi wolai sɛ ɔpia ɔ̃ ɔse isoɣɔ,</para>
  <para style="q2" vid="PRO 10:1">ɣɛɛ ɔbi kadzunisɛĩ sɛ ɔpia ɔ̃ ɔnyi isoma.<verse eid="PRO 10:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2" />Karana ga mana iki i aranyanyariã ibara ame na kusia.</para>
  <para style="q2" vid="PRO 10:2">Ɣɛɛ ara bɔlɔlɔa ibara sɛ iɖi ɔturi ibɔrɛgu i kukpi ame.<verse eid="PRO 10:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3" />
    <char style="nd">Bosate</char> iisɛ ɔtã kukã ɔkpɛ̃ ɔturi bɔlɔlɔa,</para>
  <para style="q1" vid="PRO 10:3">ɣɛɛ ɔsɛ ɔtɛ̃ ɔtilese ara ibie ɔri.<verse eid="PRO 10:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4" />Ɖãdze nrɔɔ̃ mɛ loisɛ mipɛgu mibara sɛ mitã siwɛrɛba,</para>
  <para style="q2" vid="PRO 10:4">ɣɛɛ nwɔ mba ɔdzini nrɔɔ̃ sɛ mibɔ karana.<verse eid="PRO 10:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5" />Ɔbi wɔ nsɛ ɔsa ɔraɖui kanya ku ɔsɔrɛ̃wi ɖe ɔbi wolai,</para>
  <para style="q2" vid="PRO 10:5">ɣɛɛ ɔbi wɔ nsɛ ɔrɛ ku ɔraɖui ɔsɔrɛ̃wi ɖe nwɔ nsɛ ɔpia kunuarɛ.<verse eid="PRO 10:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6" />Kusɛkusɛ sɛ kusia i ɔturi bɔlɔlɔa iti iso,</para>
  <para style="q2" vid="PRO 10:6">ɣɛɛ ɔturi nyanyariã kanya sɛ kakɔla ɔtile.<verse eid="PRO 10:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7" />Ɔturi bɔlɔlɔa inyigi ɖe kusɛkusɛ</para>
  <para style="q2" vid="PRO 10:7">ɣɛɛ ɔtilese iyere sɛ iyu.<verse eid="PRO 10:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 10:8" />Kawolai sɛ kabara i mmaraisi iso ku ɔtu</para>
  <para style="q2" vid="PRO 10:8">ɣɛɛ kadzunisɛĩ ɖeaka sɛ kabo i iwɔ ame.<verse eid="PRO 10:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9" />Ɔturi wɔ nsi ngbã ku ɔnukuare ne, ɔsɛ ɔwe i kaɣɔ ame,</para>
  <para style="q2" vid="PRO 10:9">ɣɛɛ nwɔ nsɛ ɔsiai kasɔla siri to ɔ̃abɔrɛ kayi.<verse eid="PRO 10:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10" />Ɔturi wɔ nsɛ ɔma ɔturi anɔmi ku adzuni lalaa sɛ ɔbɔ imɔrɛ̃,</para>
  <para style="q2" vid="PRO 10:10">ɣɛɛ kadzunisɛĩ ɖeaka sɛ kabo i iwɔ ame.<verse eid="PRO 10:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 10:11" />Ɔturi bɔlɔlɔa kanya ɖe ngbã itubiɔ,</para>
  <para style="q2" vid="PRO 10:11">ɣɛɛ ɔturi nyanyariã kanya sɛ kakɔla ɔtile.<verse eid="PRO 10:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12" />Itsiri sɛ ikpadzɛ̃ kulu ibɔ,</para>
  <para style="q2" vid="PRO 10:12">ɣɛɛ kuɖɔɛ sɛ kufu i aɣɛrɛ ɔɖuɖu iso.<verse eid="PRO 10:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13" />Iwola atɔ̃me sɛ abɔrɛ i nwɔ mba karɔ̃inɔ ikaɖe ame,</para>
  <para style="q2" vid="PRO 10:13">ɣɛɛ iporobi lokote itã kadzunisɛĩ kama.<verse eid="PRO 10:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14" />Maturi wolai sɛ masa inɔkpa kanya.</para>
  <para style="q2" vid="PRO 10:14">ɣɛɛ madzunisɛĩ kanya ame atɔ̃me sɛ abɔ iwɔ.<verse eid="PRO 10:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15" />Ranase karana nɖe ɔ̃ ɔmagɛ̃siare wɔ mba ɔle,</para>
  <para style="q2" vid="PRO 10:15">ɣɛɛ siwɛrɛba nɖe wɛrɛba iwɔ.<verse eid="PRO 10:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16" />Ɔturi bɔlɔlɔa sɛ ɔsu ɔ̃ kuso ɔsɛ ngbã,</para>
  <para style="q2" vid="PRO 10:16">ɣɛɛ ɔtilese kuso sɛ kubɔ wũ kutsueikpadzɛ̃.<verse eid="PRO 10:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17" />Ɔturi wɔ nsɛ ɔɖɔɛ ikpadzɛ̃ sɛ i ngbã ɔri iso,</para>
  <para style="q2" vid="PRO 10:17">ɣɛɛ ɔturi wɔ losɛ̃ iyira ne, ɔsɛ ɔkɔkɔ mamama ɔyura.<verse eid="PRO 10:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18" />Ɔturi wɔ lokɔla itsiri ne ladze ɔɖe,</para>
  <para style="q2" vid="PRO 10:18">fiɛ ɔturi wɔ nsɛ ɔla mila ɔnina ɔturi iyere ɔki ne, kadzunisɛĩ ɔɖe.<verse eid="PRO 10:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19" />Akaɖe gbodzoo sɛ ikɔ ɔturi ipia i ikpi ame,</para>
  <para style="q2" vid="PRO 10:19">ɣɛɛ nwɔ nsɛ ɔkososo ku ikaɖe ne, ɔɣe iwola.<verse eid="PRO 10:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20" />Ɔturi bɔlɔlɔa ɔnyagɛmi ne, sikãfudza sɛɛ ɔɖe,</para>
  <para style="q2" vid="PRO 10:20">ɣɛɛ ɔtilese ɔtu iire kuira.<verse eid="PRO 10:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21" />Ɔturi bɔlɔlɔa akaɖe sɛ apia maturi gbodzoo katetere,</para>
  <para style="q2" vid="PRO 10:21">ɣɛɛ madzunisɛĩ sɛ makpi alasɔ mana kasusu.<verse eid="PRO 10:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22" />
    <char style="nd">Bosate</char> kusɛkusɛ sɛ kubɔ ɔturi karana,</para>
  <para style="q2" vid="PRO 10:22">fiɛ imɔrɛ̃ kuiwɛ̃ iisɛ ibua i kã iso.<verse eid="PRO 10:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23" />Kadzunisɛĩ sɛ ɔna isoɣɔ i nsɛgbai lalaa ame,</para>
  <para style="q2" vid="PRO 10:23">ɣɛɛ nwɔ mba karɔ̃inɔ sɛ ɔna isoɣɔ i iwola iso.<verse eid="PRO 10:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24" />Ira nɛ ɔtilese sɛ ɔnigã nsɛ iba wũ iso.</para>
  <para style="q2" vid="PRO 10:24">Ɣɛɛ nnɛ i ɔturi bɔlɔlɔa sɛ ɔbie sɛ iba i kame itã wũ.<verse eid="PRO 10:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25" />Si aw<note caller="+" style="fe"><char style="fr" closed="false">10.25 </char><char style="ft" closed="false" /></note>ɛ ɔɔkpɛ̃ ne, ɔtilese iisibawe,</para>
  <para style="q2" vid="PRO 10:25">ɣɛɛ ɔturi bɔlɔlɔa ne, ɔɣɛ teteree ɔwi ɖaa.<verse eid="PRO 10:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26" />Kumɛgɔ i ndãbea sɛ mibo inyɛ, fiɛ kuyɔ sɛ kubo inɔmi ne,</para>
  <para style="q2" vid="PRO 10:26">ngbɔ kere dãdze se ɔtã nwɔ lopia wũ katɔme ne.<verse eid="PRO 10:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 10:27" />
    <char style="nd">Bosate</char> kunigã nsɛ kutã agbanayi ɔsɛ katɔ̃,</para>
  <para style="q2" vid="PRO 10:27">ɣɛɛ ɔturi nyanyariã akɔ sɛ atu kaku.<verse eid="PRO 10:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28" />Ɔturi bɔlɔlɔa ɔriinyɔ nɖe isoɣɔ,</para>
  <para style="q2" vid="PRO 10:28">ɣɛɛ ɔturi nyanyariã ɔriinyɔ ɖe siefe.<verse eid="PRO 10:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29" />
    <char style="nd">Bosate</char> ɔri ɖe katarikɔ̃ ɔtã ɔturi bɔlɔlɔa,</para>
  <para style="q2" vid="PRO 10:29">ɣɛɛ ɔsɛ ɔwɔra mma nsɛ mabara aranyanyariã.<verse eid="PRO 10:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30" />Maibarui ɔturi bɔlɔlɔa i ɔ̃ kasɛkɔ̃ kuiyikuiyi,</para>
  <para style="q2" vid="PRO 10:30">ɣɛɛ maarui ɔturi nyanyariã maɖi i karɔ̃ iso.<verse eid="PRO 10:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31" />Iwola atɔ̃me sɛ abɔrɛ i ɔturi bɔlɔlɔa kanya ame,</para>
  <para style="q2" vid="PRO 10:31">ɣɛɛ maatu mila ɔnyagɛmi maɖi.<verse eid="PRO 10:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32" />Ɔturi bɔlɔlɔa kanya ame atɔ̃me sɛ atã kuka,</para>
  <para style="q2" vid="PRO 10:32">ɣɛɛ ɔtilese kanya ɔyigu mila.<verse eid="PRO 10:32" /></para>
  <para style="b" />
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" sid="PRO 11" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1" />
    <char style="nd">Bosate</char> ɔtsiri ikerera nɛ loiyi,</para>
  <para style="q2" vid="PRO 11:1">ɣɛɛ ikerera sɛɛ sɛ ipia wũ isoɣɔ.<verse eid="PRO 11:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2" />Si katoikɔlɛso ɔba ne, kunuarɛ ka losisai;</para>
  <para style="q2" vid="PRO 11:2">ɣɛɛ karɔ̃ibɔso sɛ ibagu iwola.<verse eid="PRO 11:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3" />Maturi sɛɛ ɔnukuareiɖe sɛ ɔkɔkɔ ma,</para>
  <para style="q2" vid="PRO 11:3">ɣɛɛ mila sɛ miwɔra mma nna ɔnukuare.<verse eid="PRO 11:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4" />Karana ɖe siefe ku itɔ̃meɣɛyi,</para>
  <para style="q2" vid="PRO 11:4">ɣɛɛ sibɔlɔlɔ sɛ siɖi ɔturi i kukpi ame.<verse eid="PRO 11:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5" />Ɔturi wɔ nna iɣɛrɛ sibɔlɔlɔ nsɛ sitã ɔ̃ ɔri ɔse siĩ,</para>
  <para style="q2" vid="PRO 11:5">ɣɛɛ ɔtilese mɔmɔ aranyanyariã ibara nsɛ atã ɔrɔ̃.<verse eid="PRO 11:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 11:6" />Ɣaa sɛ ɔɖi ma nse bɔlɔlɔ alasɔ malɛ,</para>
  <para style="q2" vid="PRO 11:6">ɣɛɛ mma nna ɔnukuare kubie nyanyariã nsɛ kumɔɛ̃ ma.<verse eid="PRO 11:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 11:7" />Si ɔtilese ɔkpi ne, ɔ̃ ɔriinyɔ ɔɔtuĩ;</para>
  <para style="q2" vid="PRO 11:7">nwa pelepele ɔnyɔ ɔri i ɔ̃ ɔle iti sɛ akpese siefe.<verse eid="PRO 11:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 11:8" />
    <char style="nd">Bosate</char> sɛ ɔɖi ɔturi bɔlɔlɔa i imɔrɛ̃ ame,</para>
  <para style="q2" vid="PRO 11:8">fiɛ isɛ iba i ɔturi nyanyariã iso bowũ.<verse eid="PRO 11:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 11:9" />Nwɔ loisɛ ɔnigã Ɣaa sɛ ɔsu ɔ̃ kanya atɔ̃me ɔnina ɔ̃ ɔnyii,</para>
  <para style="q2" vid="PRO 11:9">ɣɛɛ ɔturi bɔlɔlɔa sɛ ɔsu inɔkpa ɔbɔrɛ i ne ame.<verse eid="PRO 11:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 11:10" />Si ɔturi bɔlɔlɔa ɔna isaruɛ ne, ɔmagɛ̃siare maturi sɛ mana isoɣɔ;</para>
  <para style="q2" vid="PRO 11:10">si ɔturi nyanyariã ɔwɔ ne, isoɣɔ kulu masɛ mala.<verse eid="PRO 11:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 11:11" />Iki i ɔturi sɛɛ kusɛkusɛ ame i masɛ makɔlɛ ɔmagɛ̃siare kato,</para>
  <para style="q2" vid="PRO 11:11">ɣɛɛ iki i ɔturi nyanyariã kanya ame ne, masɛ mawɔra ɔmagɛ̃siare.<verse eid="PRO 11:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 11:12" />Ɔturi wɔ loiɣe iwola nsɛ ɔbara ɔ̃ ɔnyii aɣiãra,</para>
  <para style="q2" vid="PRO 11:12">ɣɛɛ ɔturi wɔ mba karɔ̃inɔ sɛ ɔpia ɔ̃ ɔnyagɛmi i irɛkpo.<verse eid="PRO 11:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 11:13" />Ituriraɣɛse nsɛ ɔɣɛ awɛrɛra,</para>
  <para style="q2" vid="PRO 11:13">ɣɛɛ ɔturi wɔ masɛ masiaiti iso sɛ ɔkɔla itɔ̃me.<verse eid="PRO 11:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 11:14" />Ngbegɔ kɔdze wolai na ne, kaɖe nsɛ kaba karɔ̃,</para>
  <para style="q2" vid="PRO 11:14">ɣɛɛ adzuni matãdze gbodzoo sɛ matã iɖeiso.<verse eid="PRO 11:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 11:15" />Ɔturi wɔ nsɛ ɔya i ɔturi mama kuso kama to ɔ̃awe inyɛ gbaã,</para>
  <para style="q2" vid="PRO 11:15">ɣɛɛ ɔturi wɔ losɛ̃ kamaiya sɛ ɔna kaɣɔ.<verse eid="PRO 11:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 11:16" />Kayiribielea ɔrɔ̃go sɛ ɔna kuwarɛ,</para>
  <para style="q2" vid="PRO 11:16">ɣɛɛ ɔtile marɛrɛ̃ sɛ mana karana kere.<verse eid="PRO 11:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 11:17" />Kayiribielea ɔturi sɛ ɔbara isɛɛ ɔtã so,</para>
  <para style="q2" vid="PRO 11:17">ɣɛɛ ɔtilese sɛ ɔbɔ imɔrɛ̃ i ɔ̃ mɔmɔ iso.<verse eid="PRO 11:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 11:18" />Ɔturi nyanyariã sɛ ɔna kuso gɔ losɔsɔla wũ,</para>
  <para style="q2" vid="PRO 11:18">ɣɛɛ nwɔ lobara ara bɔlɔlɔa sɛ ɔna kuso gbaã.<verse eid="PRO 11:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 11:19" />Gbaã ne, ɔturi wɔ nsɛ ɔbara ara bɔlɔlɔa aasɛ ngbã,</para>
  <para style="q2" vid="PRO 11:19">ɣɛɛ ɔturi wɔ nsɛ ɔbie aranyanyariã ibara to ɔ̃akpi.<verse eid="PRO 11:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 11:20" />
    <char style="nd">Bosate</char> sɛ ɔtsiri maturi ma mba kasɔla adzuni,</para>
  <para style="q2" vid="PRO 11:20">ɣɛɛ ɔsɛ ɔna isoɣɔ i mma siri nna iɣɛrɛ.<verse eid="PRO 11:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 11:21" />Fɔ nnɛgbe ɖe sɔ: Maibasɛ̃ kutsueikpadzɛ̃ ɔtilese,</para>
  <para style="q2" vid="PRO 11:21">ɣɛɛ maturi bɔlɔlɔa ne, maibakpadzɛ̃ ma kutsue.<verse eid="PRO 11:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22" />Ɔrɔ̃go ku kulɛ wɔ nna iwola se lɛ</para>
  <para style="q2" vid="PRO 11:22">sikãrɛtɛa kagɔrɔĩ ga mpia i kparako ɔpu iso.<verse eid="PRO 11:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 11:23" />Ɔturi bɔlɔlɔa kubie ɖe ira sɛɛ,</para>
  <para style="q2" vid="PRO 11:23">ɣɛɛ ɔturi nyanyariã ɔriinyɔ ɖe Ɣaa sikpã.<verse eid="PRO 11:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 11:24" />Ɔturi ɔrere sɛ ɔtã ara faa ɣɛɛ ɔsɛ ɔna ara kɔraa ɔbua;</para>
  <para style="q2" vid="PRO 11:24">ɔturi mama iisɛ ɔɖi kɔrɔ̃ ɔtã ara ɣɛɛ siwɛrɛba nsɛ siba wũ iso.<verse eid="PRO 11:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 11:25" />Ɔturi wɔ nsɛ ɔbara kayiribielea to ɔ̃ana isaruɛ,</para>
  <para style="q2" vid="PRO 11:25">ɔturi wɔ nsɛ ɔtã ɔmama ndu ne, ɔme iibakore ɔ̃ mɔmɔ.<verse eid="PRO 11:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 11:26" />Ɔturi wɔ nsɛ ɔkɔla geɖebu ɔraɖui fiɛ ɔ̃irɔdɛ̃ ne, masɛ magbarĩ wũ,</para>
  <para style="q2" vid="PRO 11:26">ɣɛɛ ɔturi wɔ nsɛ ɔrɔdɛ̃ gɔ inya ne, masɛ mafere wũ kusɛkusɛ.<verse eid="PRO 11:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 11:27" />Ɔturi wɔ nsɛ ɔnyɔnyɔ isɛɛ ɔri ne ɔsɛ ɔbo anɔ,</para>
  <para style="q2" vid="PRO 11:27">ɣɛɛ nwɔ nsɛ ɔbie ilalaa ne, ilalaa nsɛ iba i wũ iso.<verse eid="PRO 11:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28" />Ɔturi wɔ nsɛ ɔsiaiti i ɔ̃ karana iso sɛ ɔrɔ̃,</para>
  <para style="q2" vid="PRO 11:28">ɣɛɛ ɔturi bɔlɔlɔa sɛ ɔse lɛ iyata yuɛ awe.<verse eid="PRO 11:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 11:29" />Ɔturi wɔ nsɛ ɔɖaa ɔ̃ iyomaturi ne, ɔwiri loaɖe ɔ̃ kaɖekɔ̃,</para>
  <para style="q2" vid="PRO 11:29">fiɛ kadzunisɛĩ aaɖe ɔɖabo ɔtã mawolai.<verse eid="PRO 11:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 11:30" />Ɔturi bɔlɔlɔa idziribi ɖe kudziri gɔ nsɛ kutã ngbã,</para>
  <para style="q2" vid="PRO 11:30">fiɛ ɔturi wɔ nsɛ ɔɖi maturi sikala ne ɔɣe iwola.<verse eid="PRO 11:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 11:31" />Si masɛ matã maturi bɔlɔlɔa nnɛ lokote ma i karɔ̃ iso ne,</para>
  <para style="q2" vid="PRO 11:31">maibatã ɔturi wɔ loiɣe Ɣaa gu kpibaradze nnɛ lokote maɖodza ɣɛɛ?<verse eid="PRO 11:31" /></para>
  <para style="b" />
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" sid="PRO 12" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 12:1" />Ɔturi wɔ nsɛ ɔɖɔɛ ikpadzɛ̃ ne ɔsɛ ɔɖɔɛ inɔkpa,</para>
  <para style="q2" vid="PRO 12:1">ɣɛɛ nwɔ lotsiri iyira ne, itɔ ɔɖe.<verse eid="PRO 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 12:2" />
    <char style="nd">Bosate</char> sɛ ɔnyɔ ɔturi sɛɛ nnya,</para>
  <para style="q2" vid="PRO 12:2">ɣɛɛ <char style="nd">Bosate</char> sɛ ɔtã kasɔla siriita ɔturi ipɔ.<verse eid="PRO 12:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 12:3" />Ɔturi iibawo ɔsɛra so iki i ɔtile ame,</para>
  <para style="q2" vid="PRO 12:3">fiɛ maibawo ɔturi bɔlɔlɔa ɔrui i ɔ̃ kasɛkɔ̃.<verse eid="PRO 12:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4" />Ɔrɔ̃go wɔ mba nsɛgbai sɛɛ ɖe igaraikoto i ɔ̃ ɔrã iti.</para>
  <para style="q1" vid="PRO 12:4">Ɣɛɛ ɔturire wɔ nsɛ ɔbɔ kunuarɛ se lɛ iɖa bua i ɔ̃ ɔrã ikui ame awe.<verse eid="PRO 12:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 12:5" />Ɔturi bɔlɔlɔa siriita ɔya,</para>
  <para style="q2" vid="PRO 12:5">ɣɛɛ ɔtilese kuka ɖe kasɔla.<verse eid="PRO 12:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 12:6" />Ɔtilese atɔ̃me wɛrɛ asia si aafere ima i karɔ̃,</para>
  <para style="q2" vid="PRO 12:6">ɣɛɛ ɔturi sɛɛ ikaɖe sɛ iɖi ɔturi.<verse eid="PRO 12:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 12:7" />Masɛ mawuĩ ɔtilese i karɔ̃ kere ɔsiina,</para>
  <para style="q2" vid="PRO 12:7">ɣɛɛ ɔturi sɛɛ iyo sɛ iya teteree.<verse eid="PRO 12:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 12:8" />Ɔturi iwola kanya masɛ male wũ,</para>
  <para style="q2" vid="PRO 12:8">ɣɛɛ masɛ manyɔ ɔturi wɔ mba adzuni lalaa pupurii.<verse eid="PRO 12:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 12:9" />Ilɛ sɔ aiɖe kuira ɣɛɛ aba ɔɖabo,</para>
  <para style="q2" vid="PRO 12:9">iɖo sɔ aabara so ɔturi siare ɣɛɛ ana araɖea kuawɛ̃.<verse eid="PRO 12:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 12:10" />Ɔturi bɔlɔlɔa sɛ ɔnyɔ ɔ̃ mabɔi iso,</para>
  <para style="q2" vid="PRO 12:10">ɣɛɛ ɔtilese kayiribielea ga loɖo ɖe ɔtile.<verse eid="PRO 12:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 12:11" />Ɔturi wɔ nsɛ ɔkpɛ̃ ɔ̃ ɔwĩ sɛ ɔna araɖea gbodzoo,</para>
  <para style="q2" vid="PRO 12:11">ɣɛɛ ɔturi wɔ nsɛ ɔsiai i ara wa loire kuira kama ne, ɔna adzuni.<verse eid="PRO 12:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 12:12" />Ɔtilese kubie nɖe ɔturi nyanyariã kakpãramɔɛã;</para>
  <para style="q2" vid="PRO 12:12">ɣɛɛ ɔturi bɔlɔlɔa ɔɖu sɛ ɔre iti.<verse eid="PRO 12:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 12:13" />Ɔturi nyanyariã akaɖe lalaa nsɛ amɔɛ̃ wũ lɛ kata awe,</para>
  <para style="q2" vid="PRO 12:13">ɣɛɛ ɔturi bɔlɔlɔa sɛ ɔtere i imɔrɛ̃ kanya.<verse eid="PRO 12:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 12:14" />Atɔ̃me wa ɔturi ɔbusi kanya ɔɣɛ nsɛ abɔ wũ isɛɛ</para>
  <para style="q2" vid="PRO 12:14">fiɛ karabara ga ɔturi ɔsu nrɔɔ̃ ɔbara nsɛ kabɔ wũ kusia.<verse eid="PRO 12:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 12:15" />Kadzunisɛĩ ɔri ɔya i ɔ̃ mɔmɔ anɔ,</para>
  <para style="q2" vid="PRO 12:15">ɣɛɛ kawolai sɛ ɔkã kuka atsue.<verse eid="PRO 12:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16" />Kadzunisɛĩ sɛ kaɖi kã sikpã kate ɔluwɛ̃,</para>
  <para style="q2" vid="PRO 12:16">ɣɛɛ kawolai iisɛ katã sitia mmuai.<verse eid="PRO 12:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 12:17" />Aɖansiɛ nukuarese sɛ ɔɣɛ kanyakaɣɛ gbaã,</para>
  <para style="q2" vid="PRO 12:17">ɣɛɛ aɖansiɛ ladze sɛ ɔla mila.<verse eid="PRO 12:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18" />Kasusu idaabara atɔ̃me sɛ atsue ɔturi lɛ ipɛmi awe.</para>
  <para style="q2" vid="PRO 12:18">Ɣɛɛ kawolai atɔ̃me sɛ abɔ ɔturi isosarɛ.<verse eid="PRO 12:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 12:19" />Ɔnukuarese atɔ̃me sɛ awe ɔwi ɖaa,</para>
  <para style="q2" vid="PRO 12:19">ɣɛɛ ladze mila sɛ miwe ɔwi kɛkɛĩ kere.<verse eid="PRO 12:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 12:20" />Kasɔla pia i mma nto mabie inyanyariã ibara kasusu ame,</para>
  <para style="q2" vid="PRO 12:20">ɣɛɛ mma nsɛ mabie isobuɛ sɛ mana isoɣɔ.<verse eid="PRO 12:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 12:21" />Iraboa kuiwɛ̃ iisɛ iba i ɔturi bɔlɔlɔa iso,</para>
  <para style="q2" vid="PRO 12:21">ɣɛɛ matilese ɔyigu kukpakpi.<verse eid="PRO 12:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 12:22" />Maladze ɖe inyanyara i <char style="nd">Bosate</char> anɔ,</para>
  <para style="q2" vid="PRO 12:22">ɣɛɛ ɔsɛ ɔna isoɣɔ i maturi ma mba ɔnukuare iso.<verse eid="PRO 12:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 12:23" />Ɔturi wolai iisɛ ɔtara kanya i ɔ̃ inɔkpa iso,</para>
  <para style="q2" vid="PRO 12:23">ɣɛɛ madzunisɛĩ sɛ malakulu i adzunisɛ̃ra iso.<verse eid="PRO 12:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 12:24" />Nwɔ nsɛ ɔpia ɔdzegere kɔrɔ̃ nsɛ kuɖe sigara,</para>
  <para style="q2" vid="PRO 12:24">ɣɛɛ ndã ibara sɛ iwiri i sisande karabara ame.<verse eid="PRO 12:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 12:25" />Iyasoiso sɛ ibɔ ɔturi karɔ̃,</para>
  <para style="q2" vid="PRO 12:25">ɣɛɛ katetere ipia atɔ̃me sɛ apia wũ isoɣɔ.<verse eid="PRO 12:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 12:26" />Ɔturi bɔlɔlɔa sɛ ɔdzuɛ̃ so i ɔ̃ kulaaipia ame,</para>
  <para style="q2" vid="PRO 12:26">ɣɛɛ matilese ɔri sɛ ɔkɔ ma ɔyura.<verse eid="PRO 12:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 12:27" />Dãdze iisɛ ɔna kaputubɔi ɔfɛ̃,</para>
  <para style="q2" vid="PRO 12:27">ɣɛɛ ɔturi wɔ mba ɔdzegere sɛ ɔna karana ga lofɔ kuɣa.<verse eid="PRO 12:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 12:28" />Ngbã pia i ara bɔlɔlɔa ibara ɔri iso,</para>
  <para style="q2" vid="PRO 12:28">fiɛ ɔturi wɔ loki i ɔri wɔgbe iso iisɛ ɔkɛlɛ kukpi ngbe.<verse eid="PRO 12:28" /></para>
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" sid="PRO 13" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 13:1" />Ɔbi wolai sɛ ɔkã ɔ̃ ɔse araite atsue,</para>
  <para style="q2" vid="PRO 13:1">ɣɛɛ aɣiãrase iisɛ ɔkã iyira atsue.<verse eid="PRO 13:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 13:2" />Ɔturi sɛ ɔɖe ara sɛɛ ɔbɔrɛgu i ɔ̃ kanya atɔ̃me adziribi ame,</para>
  <para style="q2" vid="PRO 13:2">ɣɛɛ nwɔ nna ɔnukuare sɛ ɔbie amumuɔ ibara.<verse eid="PRO 13:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3" />Ɔturi wɔ lokososo kanya sɛ ɔdzuɛ̃ ɔ̃ ngbã,</para>
  <para style="q2" vid="PRO 13:3">ɣɛɛ ɔturi wɔ nsɛ ɔɖe akaɖe malamala kere sɛ ɔbo i imɔrɛ̃ ame.<verse eid="PRO 13:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 13:4" />Ara sɛ akpɛ̃ dãdze ɔkã ɣɛɛ ɔ̃isɛ ɔna kuira,</para>
  <para style="q2" vid="PRO 13:4">ɣɛɛ ɔturi wɔ mba ɔdzegere sɛ ɔna ara gbodzoo ɔmi.<verse eid="PRO 13:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 13:5" />Ɔturi bɔlɔlɔa ɔtsiri mila,</para>
  <para style="q2" vid="PRO 13:5">ɣɛɛ ɔtilese sɛ ɔkpadzɛ̃ kunuarɛ gu isopa ɔbɔ.<verse eid="PRO 13:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 13:6" />Ara bɔlɔlɔa ibara sɛ idzuɛ̃ ɔturi wɔ nna iɣɛrɛ,</para>
  <para style="q2" vid="PRO 13:6">ɣɛɛ aranyanyariã ibara sɛ itã kpibaradze ɔrɔ̃.<verse eid="PRO 13:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 13:7" />Ɔturi ɔwɛ̃ ɔbara so ranase, ɣɛɛ ɔna kuira;</para>
  <para style="q2" vid="PRO 13:7">ɔmama ɔbara so wɛrɛba, ɣɛɛ ɔba karana gbaã.<verse eid="PRO 13:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 13:8" />Ɔturi karana nsɛ kaɖi wũ i ngbã imɔrɛ̃ ame,</para>
  <para style="q2" vid="PRO 13:8">ɣɛɛ wɛrɛba iisɛ ɔnɔ ifura kuiwɛ̃.<verse eid="PRO 13:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 13:9" />Ɔturi bɔlɔlɔa ɔtɔ sɛ ɔsa kukaakɔ,</para>
  <para style="q2" vid="PRO 13:9">ɣɛɛ mato maanidza ɔtilese ɔkaniɛ.<verse eid="PRO 13:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 13:10" />Iteso ne, alu kere isɛ ibɔ,</para>
  <para style="q2" vid="PRO 13:10">ɣɛɛ mma nsɛ makã kuka atsue kɔrɛ masɛ manya iwola.<verse eid="PRO 13:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 13:11" />Sikã dzɛ mana i nasikãmala ɔri iso sɛ siro mala,</para>
  <para style="q2" vid="PRO 13:11">ɣɛɛ nwɔ nsɛ ɔwe inyɛ ɔsa sikã kanya kɛkɛĩ kɛkɛĩ ne, sito siaɣe sisia.<verse eid="PRO 13:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 13:12" />Ɔriinyɔ nɛ lofe kama sɛ itã ɔtu ibo,</para>
  <para style="q2" vid="PRO 13:12">ɣɛɛ ɔturi kubie gɔ loba i kame ɖe kudziri gɔ nsɛ kutã ngbã.<verse eid="PRO 13:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 13:13" />Ɔturi wɔ lonyɔ kuka pupurii to ɔ̃atã ne kuso,</para>
  <para style="q2" vid="PRO 13:13">ɣɛɛ ɔturi wɔ lowarɛ mmaraisi ne ɔ̃afɔ ne kuso.<verse eid="PRO 13:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 13:14" />Kawolai araite ɖe itubiɔ nɛ lotã ngbã,</para>
  <para style="q2" vid="PRO 13:14">isɛ iɖi ɔturi ibɔrɛgu i kukpi kata ame.<verse eid="PRO 13:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 13:15" />Ara karɔ̃inɔ sɛɛ sɛ ibɔ anɔibo,</para>
  <para style="q2" vid="PRO 13:15">ɣɛɛ maturi ma nna ɔnukuare ɔri sɛ ɔwe ɔle.<verse eid="PRO 13:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 13:16" />Kawolai biara sɛ kabara ara ku inɔkpa,</para>
  <para style="q2" vid="PRO 13:16">ɣɛɛ kadzunisɛĩ sɛ kaɖi kã adzunisɛ̃ra kayi.<verse eid="PRO 13:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 13:17" />Kpabo ɔtilese sɛ ɔbo imɔrɛ̃ ame,</para>
  <para style="q2" vid="PRO 13:17">ɣɛɛ ɔnukuare ɔturi wɔ mapia katɔ̃me sɛ ɔbɔ isosarɛ.<verse eid="PRO 13:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 13:18" />Ɔturi wɔ losɛ̃ ikpadzɛ̃ ifɔ ne siwɛrɛba gu kunuarɛ nsɛ aba i wũ iso.</para>
  <para style="q2" vid="PRO 13:18">Ɣɛɛ ɔrere wɔ lofɔ iyira ne masɛ mapia wũ kuwarɛ.<verse eid="PRO 13:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 13:19" />Ɔturi wɔ kubie loba i kame ne, ɔsɛ ɔna isoɣɔ gbaã,</para>
  <para style="q2" vid="PRO 13:19">ɣɛɛ madzunisɛĩ ɔtsiri ngbɔ maanyua aranyanyariã ibara.<verse eid="PRO 13:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 13:20" />Ɔturi wɔ nsɛ ɔsɛgu mawolai sɛ ɔtsue iwola,</para>
  <para style="q2" vid="PRO 13:20">ɣɛɛ ɔturi wɔ lopia kulaa ku madzunisɛĩ sɛ ɔwe inyɛ.<verse eid="PRO 13:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 13:21" />Kukpakpi sɛ kutere kusiai kpibaradze,</para>
  <para style="q2" vid="PRO 13:21">ɣɛɛ isaruɛ nɖe ɔturi bɔlɔlɔa kuso.<verse eid="PRO 13:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 13:22" />Ɔturi sɛɛ sɛ ɔnyua kaɖekɔ̃ ɔsɛ ɔ̃ mabi gu ma mabi,</para>
  <para style="q2" vid="PRO 13:22">ɣɛɛ masɛ makɔla kpibaradze karana masɛ ɔturi bɔlɔlɔa.<verse eid="PRO 13:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 13:23" />Ɔwi ɔmɔi wɛrɛba kaputuku nsɛ kalɛ araɖea gbodzoo,</para>
  <para style="q2" vid="PRO 13:23">ɣɛɛ ara idaabara i ɔri iso sɛ ifɔ araɖea ɔɖuɖu wamɔ.<verse eid="PRO 13:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 13:24" />Ɔturi wɔ loisɛ ɔsu ɔpɛdziri i ɔbi iso ne, ɔtsiri ɔ̃ ɔbi;</para>
  <para style="q2" vid="PRO 13:24">ɣɛɛ nwɔ nsɛ ɔɖɔɛ ɔ̃ ɔbi sɛ ɔpia kubɛ ɔkpadzɛ̃ wũ kutsue.<verse eid="PRO 13:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 13:25" />Ɔturi bɔlɔlɔa sɛ ɔna aɖera ɔɖe ɔmi kukaakɔ,</para>
  <para style="q2" vid="PRO 13:25">ɣɛɛ kukã sɛ kukpɛ̃ ɔtilese.<verse eid="PRO 13:25" /></para>
  <para style="b" />
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" sid="PRO 14" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 14:1" />Ɔrɔ̃go wolai sɛ ɔtsue ɔ̃ iyo,</para>
  <para style="q2" vid="PRO 14:1">ɣɛɛ ku ala nrɔɔ̃ i ɔrɔ̃go kadzunisɛĩ sɛ kabiɛ ɔ̃ ire.<verse eid="PRO 14:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 14:2" />Ɔturi wɔ nsɛ ɔsɛ ngbã bɔlɔlɔa sɛ ɔnigã <char style="nd">Bosate</char>,</para>
  <para style="q2" vid="PRO 14:2">ɣɛɛ nwɔ nsɛ ɔsɛ ngbã nyanyariã sɛ ɔnyɔ wũ pupurii.<verse eid="PRO 14:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 14:3" />Kadzunisɛĩ ikaɖe sɛ ikpadzɛ̃ ipɛ ɔdziri ibɔ wũ,</para>
  <para style="q2" vid="PRO 14:3">ɣɛɛ mawolai ɔnyagɛmi sɛ ɔdzuɛ̃ ma.<verse eid="PRO 14:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4" />Si manantsuĩ na ne, araɖeibui sɛ ise ikunu,</para>
  <para style="q2" vid="PRO 14:4">ɣɛɛ ɔraɖui gbodzoo ina sɛ ibɔrɛ i nantsuĩrɛrɛ̃ ɔle ame.<verse eid="PRO 14:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 14:5" />Aɖansiɛ nukuarese iisɛ ɔla sila,</para>
  <para style="q2" vid="PRO 14:5">ɣɛɛ aɖansiɛ ladze sɛ ɔla mila.<verse eid="PRO 14:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 14:6" />Aɣiãrase sɛ ɔbie iwola ɣɛɛ ɔ̃isɛ ɔnya ne,</para>
  <para style="q2" vid="PRO 14:6">ɣɛɛ inɔkpa se pɔkɔsɔɔ itã nwɔ lonɔ ara karɔ̃.<verse eid="PRO 14:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 14:7" />Rera so kama i kadzunisɛĩ kɔrɛ,</para>
  <para style="q2" vid="PRO 14:7">alasɔ aibanɔ inɔkpa i ɔ̃ kanya.<verse eid="PRO 14:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 14:8" />Kawolai ɔkpɛ nɖe sɔ ɔ̃aɣara so ɔtsue nnɛ ɔ̃abara karɔ̃,</para>
  <para style="q2" vid="PRO 14:8">ɣɛɛ kadzunisɛĩ sɛ ɔsɔsɔla so.<verse eid="PRO 14:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 14:9" />Kadzunisɛĩ sɛ ɔbara aɣiãra i ikpi iyira iso,</para>
  <para style="q2" vid="PRO 14:9">ɣɛɛ Ɣaa sɛ ɔna isoɣɔ si ɔturi ɔbara isɛɛ.<verse eid="PRO 14:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 14:10" />Ɔturi mɔmɔ nɣe ibo gu ibɛbɛrɛ nɛ mpia i ɔ̃ ɔtu ame,</para>
  <para style="q2" vid="PRO 14:10">fiɛ ɔturi mama iibawo ɔnagu wũ ne isoɣɔ.<verse eid="PRO 14:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 14:11" />Mato maawɔra ɔtilese iyo,</para>
  <para style="q2" vid="PRO 14:11">ɣɛɛ ɔturi sɛɛ ikpayo to iamɔ.<verse eid="PRO 14:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 14:12" />Ɔturi to ɔnyɔ sɔ ɔri wɔ iso ɔsi ngbã lɛ,</para>
  <para style="q2" vid="PRO 14:12">ɣɛɛ i kawirikɔ̃ ne isɛ ikɔ wũ ipia i kukpi ame.<verse eid="PRO 14:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 14:13" />Si mato mama sima kɔraa ne, ibo sɛ iwe i ɔtu ame,</para>
  <para style="q2" vid="PRO 14:13">ne isoɣɔ aawo ɔwirigu isoma.<verse eid="PRO 14:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 14:14" />Nwɔ nna kafɔkaɖe to ɔ̃afɔ kuso gɔ lokotegu wũ i ɔ̃ siri nyanyariã iti,</para>
  <para style="q2" vid="PRO 14:14">ne ɔturi sɛɛ to ɔ̃afɔ ɔ̃ kuso ana.<verse eid="PRO 14:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 14:15" />Kadzunisɛĩ sɛ ɔfɔ itɔ̃me irere ɔɖe,</para>
  <para style="q2" vid="PRO 14:15">ɣɛɛ kawolai sɛ ɔdzuĩ ɔ̃ inene ame kukaakɔ.<verse eid="PRO 14:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 14:16" />Ɔturi wolai sɛ ɔnigã <char style="nd">Bosate</char> fiɛ ɔsɛ ɔre iranyanyariã kama,</para>
  <para style="q2" vid="PRO 14:16">ɣɛɛ kadzunisɛĩ sɛ ɔsia so ara fiɛ ɔ̃isɛ ɔsu kuira i ira iso.<verse eid="PRO 14:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 14:17" />Ɔturi wɔ nsɛ ɔna sikpã malamala sɛ ɔbara adzunisɛ̃ra,</para>
  <para style="q2" vid="PRO 14:17">ɣɛɛ masɛ matsiri nwɔ nsɛ ɔkososo ku adzuni.<verse eid="PRO 14:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 14:18" />Kadzunisɛĩ kaɖekɔ̃ nɖe ɔ̃ adzunisɛ̃ra,</para>
  <para style="q2" vid="PRO 14:18">ɣɛɛ kawolai sigaraikoto nɖe inɔkpa.<verse eid="PRO 14:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 14:19" />Maturi nyanyariã sɛ mabɔitikarɔ̃ matã maturi sɛɛ,</para>
  <para style="q2" vid="PRO 14:19">fiɛ matilese sɛ mabɔitikarɔ̃ i maturi bɔlɔlɔa kayogodɔ̃.<verse eid="PRO 14:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 14:20" />Wɛrɛba magbamikui ana kɔraa sɛ matsiri wũ,</para>
  <para style="q2" vid="PRO 14:20">ɣɛɛ ranase ba malaa gbodzoo.<verse eid="PRO 14:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 14:21" />Ɔturi wɔ nsɛ ɔnyɔ ɔ̃ ɔnyii pupurii sɛ ɔbara ikpi,</para>
  <para style="q2" vid="PRO 14:21">ɣɛɛ so sɛ siɣɔ nwɔ nsɛ ɔbara maɣiãni kayiribielea.<verse eid="PRO 14:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 14:22" />Mma nsɛ maɖo iranyanyariã iisɛ maɣɛrɛ ɣɛɛ?</para>
  <para style="q2" vid="PRO 14:22">Ɣɛɛ mma nsɛ maɖo isɛɛ ne, nnyainyɔ gu ɔnukuare nɖe ma ɔkpɛ.<verse eid="PRO 14:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 14:23" />Kubɛ ipia biara sɛ kubɔ kusia,</para>
  <para style="q2" vid="PRO 14:23">ɣɛɛ akaɖe kere kere sɛ abɔ siwɛrɛba.<verse eid="PRO 14:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 14:24" />Mawolai karana nɖe ma sigaraikoto,</para>
  <para style="q2" vid="PRO 14:24">ɣɛɛ madzunisɛĩ ne, adzunisɛ̃ra nɖe ma ɔkpɛ.<verse eid="PRO 14:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 14:25" />Aɖansiɛ nukuarese sɛ ɔɖi ngbã,</para>
  <para style="q2" vid="PRO 14:25">ɣɛɛ aɖansiɛ ladze sɛ ɔsɔsɔla maturi.<verse eid="PRO 14:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 14:26" />Nwɔ nsɛ ɔnigã <char style="nd">Bosate</char> ba ɔlekasɛkɔ̃,</para>
  <para style="q2" vid="PRO 14:26">fiɛ iaɖe katarikɔ̃ ɔtã ɔ̃ mabi.<verse eid="PRO 14:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 14:27" />
    <char style="nd">Bosate</char> kunigã ɖe itubiɔ nɛ nsɛ itã ngbã,</para>
  <para style="q2" vid="PRO 14:27">isɛ iɖi ɔturi ibɔrɛgu i kukpi kata ame.<verse eid="PRO 14:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 14:28" />Maturi gbodzoo kusime ɖe igara kuwarɛ,</para>
  <para style="q2" vid="PRO 14:28">ɣɛɛ si maturi na ne igarabibirɛrɛĩ na ɔle.<verse eid="PRO 14:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 14:29" />Ɔturi wɔ nsɛ ɔɣara so ba karɔ̃inɔ kukaakɔ,</para>
  <para style="q2" vid="PRO 14:29">ɣɛɛ ɔturi wɔ nsɛ ɔna sikpã malamala sɛ ɔɖi adzunisɛ̃ra kayi.<verse eid="PRO 14:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 14:30" />Adzuni wa nsi i karɔ̃ ku isobuɛ sɛ itã sosina ngbã,</para>
  <para style="q2" vid="PRO 14:30">ɣɛɛ kanɔbɛbɛ sɛ katã akui ɔbu.<verse eid="PRO 14:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 14:31" />Ɔturi wɔ nsɛ ɔwedza mawɛrɛba inyɛ sɛ ɔtia ma Baradze;</para>
  <para style="q2" vid="PRO 14:31">ɣɛɛ ɔturi ɔrere wɔ nsɛ ɔbara maɣiãni kayiribielea sɛ ɔwarɛ Ɣaa.<verse eid="PRO 14:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 14:32" />Si kukpakpi ɔba ne, matilese sɛ marɔ̃,</para>
  <para style="q2" vid="PRO 14:32">ɣɛɛ ɔturi bɔlɔlɔa ba katarikɔ̃ ta kukpi ame kɔraa.<verse eid="PRO 14:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 14:33" />Iwola ɔfɔ kasɛkɔ̃ i nwɔ mba karɔ̃inɔ adzuni ame,</para>
  <para style="q2" vid="PRO 14:33">fiɛ ɔsɛ ɔtã matsue wũ ta i madzunisɛĩ ndɛ̃.<verse eid="PRO 14:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PRO 14:34" />Sibɔlɔlɔ sɛ sikɔlɛ kaɖe kato,</para>
  <para style="q2" vid="PRO 14:34">ɣɛɛ ikpi ɖe kunuarɛ itã kaɖe biara.<verse eid="PRO 14:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="PRO 14:35" />Igara sɛ ɔna isoɣɔ i ɔɖabo wolai iso,</para>
  <para style="q2" vid="PRO 14:35">ɣɛɛ ɔsɛ ɔna sikpã i ɔɖabo wɔ nsɛ ɔbɔ kunuarɛ iso.<verse eid="PRO 14:35" /></para>
  <para style="b" />
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" sid="PRO 15" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 15:1" />Itɔ̃me mmuai itã ku silɔ pɔkɔsɔɔ sɛ iɣɔra sikpã,</para>
  <para style="q2" vid="PRO 15:1">ɣɛɛ kanya isɔsɔ̃ ɔturi sɛ itã sikpã ɔkɔlɛ kato.<verse eid="PRO 15:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2" />Ɔturi wolai ɔnyagɛmi sɛ ɔɖi inɔkpa ɔte,</para>
  <para style="q2" vid="PRO 15:2">ɣɛɛ adzunisɛ̃ra nsɛ abɔrɛ i kadzunisɛĩ kanya kere.<verse eid="PRO 15:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3" />
    <char style="nd">Bosate</char> anɔmi pia i kakɔi biara.</para>
  <para style="q2" vid="PRO 15:3">Ɔto ɔnya nwɔ nto ɔbara ɔtile gu nwɔ nto ɔbara isɛɛ.<verse eid="PRO 15:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4" />Ikaɖe ku silɔ pɔkɔsɔɔ ɖe kudziri gɔ nsɛ kutã ngbã,</para>
  <para style="q2" vid="PRO 15:4">ɣɛɛ kasɔla ɔnyagɛmi sɛ ɔpia ɔturi siwarã igbɛ.<verse eid="PRO 15:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 15:5" />Kadzunisɛĩ sɛ ɔnyɔ ɔ̃ ɔse ikpadzɛ̃ pupurii,</para>
  <para style="q2" vid="PRO 15:5">ɣɛɛ ɔturi wɔ nsɛ ɔnɔ iyira ba iɣaraso ku adzuni sɛɛ.<verse eid="PRO 15:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6" />Karana gbodzoo pia i ɔturi bɔlɔlɔa iyo.</para>
  <para style="q2" vid="PRO 15:6">Ɣɛɛ ɔtilese ara wa ɔna sɛ atã ɔna amɔrɛã.<verse eid="PRO 15:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7" />Mawolai kanya sɛ kasamera inɔkpa;</para>
  <para style="q2" vid="PRO 15:7">ɣɛɛ iise ngbɔ ku madzunisɛĩ situ.<verse eid="PRO 15:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8" />
    <char style="nd">Bosate</char> ɔtsiri ɔtilese isɔrɛ,</para>
  <para style="q2" vid="PRO 15:8">ɣɛɛ ɔturi sɛɛ kayiikparama sɛ ɔɣɔ <char style="nd">Bosate</char> anɔ.<verse eid="PRO 15:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9" />
    <char style="nd">Bosate</char> ɔtsiri ɔtilese nsɛgbai;</para>
  <para style="q2" vid="PRO 15:9">ɣɛɛ ɔsɛ ɔɖɔɛ mma nsɛ mabie ara bɔlɔlɔa ibara.<verse eid="PRO 15:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10" />Kutsueikpadzɛ̃ teteree se itã ɔturi wɔ lonyua ɔri ɔsɛ.</para>
  <para style="q2" vid="PRO 15:10">Ɔturi wɔ nsɛ ɔtsiri iyira to ɔ̃akpi.<verse eid="PRO 15:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 15:11" />Si kukpi gu iwɔ abusi ase i <char style="nd">Bosate</char> anɔmi ame ne,</para>
  <para style="q2" vid="PRO 15:11">iyɔ ɔturi awune ɔtu se kpawee ɔɖo!<verse eid="PRO 15:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12" />Aɣiãrase iisɛ ɔbie sɔ mayira wũ;</para>
  <para style="q2" vid="PRO 15:12">ɔ̃isɛ ɔsɛ ɔsu itɔ̃me ɔtugu kawolai.<verse eid="PRO 15:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13" />Ɔtu wɔ nsɛ ɔna isoɣɔ sɛ ɔtã kanɔɣɔa,</para>
  <para style="q2" vid="PRO 15:13">ɣɛɛ si imararãso pia i ɔtu ame ne, isɛ ipia ɔturi siwarã igbɛ.<verse eid="PRO 15:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14" />Ɔturi ɔtu wɔ nsɛ ɔnya ara ɔɖiite sɛ ɔbie inɔkpa,</para>
  <para style="q2" vid="PRO 15:14">ɣɛɛ kadzunisɛĩ kanya sɛ kaɣɛ adzunisɛ̃ra.<verse eid="PRO 15:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 15:15" />Mma mato mayika mabɔ karɔ̃ ayi ɔɖuɖu sɛ awe ɔle,</para>
  <para style="q2" vid="PRO 15:15">ɣɛɛ nwɔ nsɛ ɔna isoɣɔ nsɛ ɔɖe iyi ku ɔwi biara.<verse eid="PRO 15:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16" />Ara kɛkɛĩ wa i ɔturi ba fiɛ <char style="nd">Bosate</char> kunigã ɔbua iso</para>
  <para style="q2" vid="PRO 15:16">lɛ iɖo karana gbodzoo ga i amɔrɛã ɔbua.<verse eid="PRO 15:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17" />Ɔraɖui yuɛ aɖera wa i kuɖɔɛ ɔbua iso</para>
  <para style="q2" vid="PRO 15:17">lɛ aɖo nantsuĩ wɔ mba iɖa aɖera wa itsiri ɔbua iso.<verse eid="PRO 15:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18" />Ɔturi wɔ nsɛ ɔna sikpã malamala sɛ ɔbɔ kulu,</para>
  <para style="q2" vid="PRO 15:18">ɣɛɛ ɔturi pɔkɔsɔa sɛ ɔnidza kalɔ.<verse eid="PRO 15:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19" />Dãdze ɔri iso i miyu sɛ mifɔ mitɛ̃,</para>
  <para style="q2" vid="PRO 15:19">ɣɛɛ ɔturi sɛɛ ɔri iso ɖe ɔri wɔ makpɛ̃ mayira kukaakɔ.<verse eid="PRO 15:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20" />Ɔbi wolai sɛ ɔpia ɔ̃ ɔse isoɣɔ,</para>
  <para style="q2" vid="PRO 15:20">ɣɛɛ ɔturi dzunisɛĩ sɛ ɔnyɔ ɔ̃ ɔnyi pupurii.<verse eid="PRO 15:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21" />Kadzunisɛĩ sɛ ɔna isoɣɔ i adzunisɛ̃ra iso,</para>
  <para style="q2" vid="PRO 15:21">ɣɛɛ nwɔ nsɛ ɔnɔ ara karɔ̃ sɛ ɔsɛ i ɔri tɔrɔrɔa iso.<verse eid="PRO 15:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 15:22" />Siriita iisɛ siba i kame si kuka na i ne ame,</para>
  <para style="q2" vid="PRO 15:22">ɣɛɛ si kuka matãdze ɔsi ne siriita sɛ sisɛ katɔ̃ kukaakɔ.<verse eid="PRO 15:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23" />Itɔ̃me mmuai itã kukaakɔ mala sɛ ipia ɔturi isoɣɔ -</para>
  <para style="q2" vid="PRO 15:23">fiɛ itɔ̃me nɛ maɣɛ ku ne ɔɣɛwi sɛ ilɛ ɔnɔ!<verse eid="PRO 15:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24" />Mawolai ne, ngbã ɔri to ɔkɛlɛ kato</para>
  <para style="q2" vid="PRO 15:24">sɔ si ɔrera so kama i ikpibiɔ ame iso ikɛlɛ.<verse eid="PRO 15:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25" />
    <char style="nd">Bosate</char> sɛ ɔbiɛ kakɔlɛsokatoi iyo,</para>
  <para style="q2" vid="PRO 15:25">ɣɛɛ ɔsɛ ɔsɛra ame ɔtã kpisere.<verse eid="PRO 15:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26" />
    <char style="nd">Bosate</char> ɔtsiri ɔtilese adzuni,</para>
  <para style="q2" vid="PRO 15:26">ɣɛɛ ɔsɛ ɔna isoɣɔ i mma lokpa i ɔ̃ anɔmi ame iso.<verse eid="PRO 15:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27" />Anɔbese sɛ ɔkpadzɛ̃ ɔ̃ iyomaturi ɔpia i imɔrɛ̃ ame.</para>
  <para style="q2" vid="PRO 15:27">Ɣɛɛ ɔturi wɔ lotsiri kawɛrɛra ifɔ ne, ɔ̃asɛ ngbã.<verse eid="PRO 15:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28" />Ɔturi bɔlɔlɔa sɛ ɔdzuĩ itɔ̃me iso kukaakɔ fiɛ ɔsɛ ɔtã mmuai,</para>
  <para style="q2" vid="PRO 15:28">ɣɛɛ ɔtilese sɛ ɔbusi kanya ɔɣɛ itɔ̃me nyanyariã irere faa.<verse eid="PRO 15:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 15:29" />
    <char style="nd">Bosate</char> pia dzoroo i ɔtilese kɔrɛ</para>
  <para style="q2" vid="PRO 15:29">ɣɛɛ <char style="nd">Bosate</char> sɛ ɔnɔ ɔturi bɔlɔlɔa kayiikparama.<verse eid="PRO 15:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 15:30" />Anɔɣɔa sɛ apia ɔturi ɔtu isoɣɔ,</para>
  <para style="q2" vid="PRO 15:30">fiɛ itɔ̃me bielea sɛ itã akui ɔsarɛ.<verse eid="PRO 15:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31" />Ɔturi wɔ nsɛ ɔkã iyira nɛ lotã ngbã atsue</para>
  <para style="q2" vid="PRO 15:31">to ɔ̃awe i mawolai ndɛ̃.<verse eid="PRO 15:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32" />Ɔturi wɔ nsɛ ɔsɛ ikpadzɛ̃ i karɔ̃ ne, sɛ ɔnyɔ so pupurii,</para>
  <para style="q2" vid="PRO 15:32">ɣɛɛ ɔturi wɔ nsɛ ɔbie iyira ne ɔsɛ ɔna ara karɔ̃inɔ.<verse eid="PRO 15:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33" />
    <char style="nd">Bosate</char> kunigã sɛ kute ɔturi iwola,</para>
  <para style="q2" vid="PRO 15:33">fiɛ karɔ̃ibɔso sɛ iba fiɛ kuwarɛ.<verse eid="PRO 15:33" /></para>
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1" />Ɔturi awune sɛ ɔbara ɔriita i adzuni ame,</para>
  <para style="q2" vid="PRO 16:1">ɣɛɛ <char style="nd">Bosate</char> kɔrɛ i ne iɖi iɣɛ sɛ ibɔrɛ.<verse eid="PRO 16:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2" />Ɔturi arabarara ɔɖuɖu na iɣɛrɛ i ɔ̃ mɔmɔ kɔrɛ,</para>
  <para style="q2" vid="PRO 16:2">ɣɛɛ <char style="nd">Bosate</char> nsɛ ɔkere nnɛ i ɔturi ɔbara ɔnyɔ.<verse eid="PRO 16:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3" />Su irabiara nɛ aabara pia i <char style="nd">Bosate</char> nrɔɔ̃ ame,</para>
  <para style="q2" vid="PRO 16:3">iyɔ fɔ adzuni siriita to siaba i kame.<verse eid="PRO 16:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4" />
    <char style="nd">Bosate</char> sɛ ɔbara irabiara i ɔ̃ mɔmɔ adzuni iso -</para>
  <para style="q2" vid="PRO 16:4">ɔbara ta ɔtilese kukpakpi iyi ɔsɛ.<verse eid="PRO 16:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5" />
    <char style="nd">Bosate</char> ɔtsiri makɔlɛsokatoi ɔɖuɖu.</para>
  <para style="q2" vid="PRO 16:5">Fɔ nnɛgbe ɖe gbaã sɔ: Maibanyua matilese kutsueikpadzɛ̃ kuiyikuiyi!<verse eid="PRO 16:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6" />Iki <char style="nd">Bosate</char> iɖɔɛ gu ɔnukuareiɖe itã wũ ne, ɔsɛ ɔsu bo akpi ɔtsɛ bo;</para>
  <para style="q2" vid="PRO 16:6">iki i <char style="nd">Bosate</char> kunigã ame ne ɔturi sɛ ɔɖi so i iranyanyariã ame.<verse eid="PRO 16:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7" />Si ɔturi ɔrere nsɛgbai ɔbo i <char style="nd">Bosate</char> anɔ ne,</para>
  <para style="q2" vid="PRO 16:7">ɔsɛ ɔtã sɔ nwɔmɔ matsirise sɛ mawegu i isobuɛ ame.<verse eid="PRO 16:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8" />Ara tɛmi wa i ɔturi ba ku sibɔlɔlɔ</para>
  <para style="q2" vid="PRO 16:8">lɛ iɖo ara gbodzoo wa mana i ɔri wɔ loiya iso.<verse eid="PRO 16:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9" />Ɔturi awune sɛ ɔbara siriita i ɔ̃ mɔmɔ ɔri iso,</para>
  <para style="q2" vid="PRO 16:9">ɣɛɛ <char style="nd">Bosate</char> nsɛ ɔte ɔ̃ kanenekɔ̃.<verse eid="PRO 16:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10" />Igara ikaɖe ne, ikpakpatɔ̃me iɖe,</para>
  <para style="q2" vid="PRO 16:10">fiɛ ɔ̃isɛ ɔbara iɣɛrɛ si ɔɖaɛ itɔ̃me.<verse eid="PRO 16:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11" />Ikerera gu ara ikere sɛɛ ɔɖuɖu ɔbɔrɛ i <char style="nd">Bosate</char> kɔrɛ;</para>
  <para style="q2" vid="PRO 16:11">akerera ɔɖuɖu wa i akpo ame ɖe ɔ̃ arabarara.<verse eid="PRO 16:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 16:12" />Magara ɔtsiri iranyanyariã ibara,</para>
  <para style="q2" vid="PRO 16:12">alasɔ ara bɔlɔlɔa ibara iso masɛra sigaraiyara.<verse eid="PRO 16:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13" />Magara sɛ mana isoɣɔ i ɔnukuareiɣɛ iso;</para>
  <para style="q2" vid="PRO 16:13">masɛ maɖɔɛ ɔturi wɔ nsɛ ɔɣɛ ɔnukuare.<verse eid="PRO 16:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14" />Igara sikpã ɖe kukpi kpabo,</para>
  <para style="q2" vid="PRO 16:14">ɣɛɛ nwɔ nɣe iwola sɛ ɔɣɔra sɛ̃.<verse eid="PRO 16:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15" />Igara anɔɣɔa ame ne, ngbã mpia.</para>
  <para style="q2" vid="PRO 16:15">Fiɛ ɔ̃ nnyainyɔ se lɛ adɔdɔ i kusɛ ame.<verse eid="PRO 16:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16" />Ilɛ si ana iwola iɖo sɔ aana sikãrɛtɛa.</para>
  <para style="q2" vid="PRO 16:16">Ilɛ si aɖi karɔ̃inɔ iɖo sɔ aaɖi sikãfudza.<verse eid="PRO 16:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17" />Ɔturi sɛɛ nsɛgbai sɛ miɖi so i iranyanyariã ame;</para>
  <para style="q2" vid="PRO 16:17">ɔturi wɔ nsɛ ɔkososo ku ɔ̃ nsɛgbai sɛ ɔdzuɛ̃ ɔ̃ ngbã.<verse eid="PRO 16:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18" />Iteso sɛ iɖe iwɔ katɔ̃,</para>
  <para style="q2" vid="PRO 16:18">inyɔso sɛ iɖe irɔ̃ katɔ̃.<verse eid="PRO 16:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19" />Karɔ̃ibɔso i mawɛrɛba ndɛ̃ lɛ iɖo</para>
  <para style="q2" vid="PRO 16:19">kakpãramɔɛã iɣɛgu matesoi.<verse eid="PRO 16:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20" />Ɔturi wɔ nsɛ ɔkã araite sɛɛ atsue sɛ ɔna isaruɛ,</para>
  <para style="q2" vid="PRO 16:20">so sɛ siɣɔ nwɔ nsɛ ɔsiaiti i <char style="nd">Bosate</char> iso.<verse eid="PRO 16:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21" />Ɔturi wolai ta i ɔtu ame ne, masɛ marɔ wũ sɔ karɔ̃inɔse,</para>
  <para style="q2" vid="PRO 16:21">fiɛ ikaɖe nɛ nsɛ ilɛ ɔnɔ sɛ itã mafɔ ɔturi maɖe.<verse eid="PRO 16:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22" />Ara karɔ̃inɔ ɖe ngbã itubu itã mma mba ne,</para>
  <para style="q2" vid="PRO 16:22">ɣɛɛ adzunisɛ̃ra sɛ abɔ kutsueikpadzɛ̃ itã madzunisɛĩ.<verse eid="PRO 16:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23" />Ɔturi wolai ɔtu sɛ ɔdzuɛ̃ ɔ̃ kanya,</para>
  <para style="q2" vid="PRO 16:23">fiɛ ɔ̃ kanya sɛ katã araite ɔsɛ katɔ̃.<verse eid="PRO 16:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24" />Itɔ̃me nɛ nsɛ ilɛ ɔnɔ ne, kuɣesɛi kuɖe,</para>
  <para style="q2" vid="PRO 16:24">iba ɔkala ɔmɛrɛ̃ fiɛ isɛ isa sosina.<verse eid="PRO 16:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25" />Ɔri ɔwɛ̃ pia wɔ ibara lɛ ɔkote i ɔturi anɔmi ame,</para>
  <para style="q2" vid="PRO 16:25">ɣɛɛ ɔ̃ kawirikɔ̃ ɖe kukpi.<verse eid="PRO 16:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26" />Araɖea wa nsɛ akpɛ̃ rabaradze ɔkã nsɛ atã ɔbara karabara;</para>
  <para style="q2" vid="PRO 16:26">kukã nsɛ kutã ɔɣiɛ so.<verse eid="PRO 16:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27" />Ikpekete nsɛ ɔɖo iranyanyariã i ɔturi iso,</para>
  <para style="q2" vid="PRO 16:27">fiɛ ɔ̃ ikaɖe se lɛ ɔtɔ wɔ nsɛ ɔtsuedza ara awe.<verse eid="PRO 16:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28" />Kasɔla ɔturi sɛ ɔpia kulu i maturi ndɛ̃,</para>
  <para style="q2" vid="PRO 16:28">fiɛ ituriraiɣɛ sɛ inina maburise ndɛ̃.<verse eid="PRO 16:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29" />Ɔtilese sɛ ɔɣɛ ɔpia ɔ̃ ɔnyii</para>
  <para style="q2" vid="PRO 16:29">fiɛ ɔsɛ ɔkɔ wũ ɔkigu i ɔri wɔ loilɛ iso.<verse eid="PRO 16:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30" />Ɔturi wɔ nsɛ ɔma ɔturi anɔmi ne ɔba adzuni lalaa;</para>
  <para style="q2" vid="PRO 16:30">ɔturi wɔ losɛ̃ sinyako kpa ne, ɔsɛ ɔbara iranyanyariã.<verse eid="PRO 16:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31" />Iti fudza ɖe kuwarɛ igaraikoto;</para>
  <para style="q2" vid="PRO 16:31">masɛ mana ne iki ara bɔlɔlɔa ibara ame.<verse eid="PRO 16:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32" />Ɔturi wɔ nsɛ ɔɣara so lɛ ɔɖo kpãrɛrɛĩ,</para>
  <para style="q2" vid="PRO 16:32">nwɔ nsɛ ɔɖesoiso lɛ ɔɖo nwɔ nsɛ ɔmɔɛ̃ ɔmagɛ̃siare.<verse eid="PRO 16:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33" />Mapɛ kareremi i ngba ndɛ̃,</para>
  <para style="q2" vid="PRO 16:33">ɣɛɛ <char style="nd">Bosate</char> nsɛ ɔɖaɛ ne ame.<verse eid="PRO 16:33" /></para>
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" sid="PRO 17" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1" />Boɖoboɖo korea kasɛi iɖe i ilo gu isobuɛ ame lɛ iɖo</para>
  <para style="q2" vid="PRO 17:1">iyo nɛ ame loyigu iyiɖea fiɛ kulu ɔbua iso.<verse eid="PRO 17:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2" />Ɔɖabo wɔ wolai to ɔ̃aɖe i ɔbirɛrɛĩ wɔ nsɛ ɔbɔ kunuarɛ iso,</para>
  <para style="q2" vid="PRO 17:2">fiɛ ɔ̃ana kaɖekɔ̃ i ara ame lɛ manyiirɛrɛĩ ndɛ̃ ɔwɛ̃ awe.<verse eid="PRO 17:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3" />Masɛ mawanɛkɛ̃ra sikãfudza i ne ira ame fiɛ masɛ mawanɛkɛ̃ra skãrɛtɛa i ɔferewu ame,</para>
  <para style="q2" vid="PRO 17:3">ɣɛɛ <char style="nd">Bosate</char> ne ɔsɛ ɔla ɔturi ɔtu ɔnyɔ.<verse eid="PRO 17:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4" />Ɔtilese sɛ ɔkã ɔturi nyanyariã atɔ̃me atsue;</para>
  <para style="q2" vid="PRO 17:4">fiɛ ladze sɛ ɔsɛ kutsue sɔ ɔ̃anɔ ɔturi nyanyariã atɔ̃me.<verse eid="PRO 17:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5" />Ɔturi wɔ nsɛ ɔbara mawɛrɛba aɣiãra sɛ ɔtia ma Baradze,</para>
  <para style="q2" vid="PRO 17:5">Ɔturi wɔ nsɛ ɔna isoɣɔ si itikpi ɔba i ɔmama iso ne, ɔ̃afɔ kutsueikpadzɛ̃.<verse eid="PRO 17:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6" />Mawa i mabi ɖe ɔkpakpa sigaraikoto,</para>
  <para style="q2" vid="PRO 17:6">fiɛ mabi sɛ maɖe ndamu i ma maɣese iso.<verse eid="PRO 17:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7" />Ikaɖe sɛɛ iisɛ ikote kadzunisɛĩ,</para>
  <para style="q2" vid="PRO 17:7">ngbɔ ame i mila ila iisɛ ikote ɔɖeisoi ne.<verse eid="PRO 17:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8" />Kawɛrɛra itã se lɛ kumɛgɔ mapia ibelesa itã nwɔ lotã kã,</para>
  <para style="q2" vid="PRO 17:8">kakɔi biara ga ɔki ne isɛ ire iti.<verse eid="PRO 17:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9" />Ɔturi wɔ nsɛ ɔsu ikpi ɔtsɛ ne, ɔsɛ ɔtã sɔ kuɖɔɛ ɔwe;</para>
  <para style="q2" vid="PRO 17:9">ɣɛɛ ɔturi wɔ loɖi atɔ̃me kuere ɔbɔ ne, ɔsɛ ɔsamera malaa ndɛ̃.<verse eid="PRO 17:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10" />Si makpadzɛ̃ itɔ̃me i ara karɔ̃inɔse iso ne,</para>
  <para style="q2" vid="PRO 17:10">isɛ ibo wũ i iti ame iɖo si mapɛ kadzunisɛĩ ikpɛ kulafa.<verse eid="PRO 17:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11" />Ɔturi nyanyariã kubie kere nɖe sɔ itaiyaiso;</para>
  <para style="q2" vid="PRO 17:11">maasese ɔkpakpa wɔ loisɛ ɔnyɔ nnya i ɔ̃ iso.<verse eid="PRO 17:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12" />Isarɛgu iketeke nɛ mamɔɛ̃ ibi masu,</para>
  <para style="q2" vid="PRO 17:12">lɛ iɖo isarɛgu kadzunisɛĩ si ɔla ɔ̃abara ɔ̃ adzunisɛ̃ra.<verse eid="PRO 17:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13" />Ɔturi wɔ losu iranyanyariã ɔtã kuso i isɛɛ kanya ne,</para>
  <para style="q2" vid="PRO 17:13">iranyanyariã iibabɔrɛ i ɔ̃ iyo kuiyikuiyi.<verse eid="PRO 17:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14" />Kulu karɔ̃isɛ se lɛ kumɛgɔ ɔwore wɔ matɛ̃ ɔtsɛ iɖu,</para>
  <para style="q2" vid="PRO 17:14">ne ɔso nyua fiɛ iaba iakpese itɔ̃me biɛlɛa.<verse eid="PRO 17:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15" />Ɔturi wɔ lotã ɔturi nyanyariã ibɛ fiɛ ɔtã nwɔ loiɣɛrɛ ipɔ ne,</para>
  <para style="q2" vid="PRO 17:15">
    <char style="nd">Bosate</char> ɔtsiri wã anyɔ ɔɖuɖu.<verse eid="PRO 17:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16" />Mme kusia ɔso i kadzunisɛĩ to sikã,</para>
  <para style="q2" vid="PRO 17:16">gɔ ɔna kubie ɔtã sɔ ɔ̃atsue iwola?<verse eid="PRO 17:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17" />Ɔlaa sɛ ɔɖɔɛ ɔturi ku ɔwi biara,</para>
  <para style="q2" vid="PRO 17:17">ɣɛɛ maɣe ɔnyiibi sɔ ɔ̃aɖi lɛdze ku ɔmɔrɛ̃wi.<verse eid="PRO 17:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18" />Ɔturi wɔ nna adzuni sɛ ɔpia kanya i kuso kamaiya ame</para>
  <para style="q2" vid="PRO 17:18">ne ɔsɛ ɔya i ɔ̃ ɔnyii kama.<verse eid="PRO 17:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19" />Ɔturi wɔ nsɛ ɔɖɔɛ kulu sɛ ɔɖɔɛ ikpi;</para>
  <para style="q2" vid="PRO 17:19">ɔturi wɔ lopia kayogodɔ̃ kɔlɛa i kabɔrɛnya ne, ɔsɛ ɔbie iwɔ.<verse eid="PRO 17:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 17:20" />Ɔturi wɔ mba kasɔla ɔtu iisɛ ɔna isaruɛ</para>
  <para style="q2" vid="PRO 17:20">fiɛ ɔturi wɔ mba kasɔla ɔnyagɛmi sɛ ɔbo i imɔrɛ̃ ame.<verse eid="PRO 17:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21" />Ɔbi wɔ nɖe kadzunisɛĩ ɖe isoma ɔtã ɔ̃ ɔse</para>
  <para style="q2" vid="PRO 17:21">fiɛ kadzunisɛĩ ɔse na isoɣɔ kuiwɛ̃.<verse eid="PRO 17:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22" />Ɔtu wɔ nsɛ ɔna isoɣɔ se kere lɛ kua sɛɛ awe,</para>
  <para style="q2" vid="PRO 17:22">ɣɛɛ siwarã dzɛ nto simararã so sɛ sitã akui sɛ akore wolowolo.<verse eid="PRO 17:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23" />Ɔtilese sɛ ɔfɔ kawɛrɛra,</para>
  <para style="q2" vid="PRO 17:23">si ɔ̃afirikira itɔ̃me nɛ loya imama.<verse eid="PRO 17:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24" />Ɔturi wɔ nsɛ ɔnɔ ara karɔ̃ sɛ ɔbie iwola ɔri,</para>
  <para style="q2" vid="PRO 17:24">ɣɛɛ kadzunisɛĩ anɔmi sia i karɔ̃ kawirikɔ̃ iso.<verse eid="PRO 17:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25" />Ɔbi dzunisɛĩ ɖe isoma ɔtã ɔ̃ ɔse</para>
  <para style="q2" vid="PRO 17:25">fiɛ ɔsɛ ɔtã ɔ̃ ɔnyi wɔ loɣe wũ ibo gu ibɛbɛrɛ.<verse eid="PRO 17:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26" />Iilɛ sɔ maakpadzɛ̃ ɔturi wɔ loiɣɛrɛ kutsue,</para>
  <para style="q2" vid="PRO 17:26">ɣee mapɛ makpakpaturi i ma ɔnukuare iti.<verse eid="PRO 17:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27" />Ɔturi wɔ mba inɔkpa sɛ ɔkososo ku ikaɖe</para>
  <para style="q2" vid="PRO 17:27">fiɛ ɔturi wɔ nsɛ ɔɖesoiso ku sikpã ba ara karɔ̃inɔ.<verse eid="PRO 17:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28" />Si kadzunisɛĩ ɔlokanana kɔraa ne, masɛ mabu wũ kawolai</para>
  <para style="q2" vid="PRO 17:28">fiɛ masɛ mabu wũ ara karɔ̃inɔse si ɔma kanya.<verse eid="PRO 17:28" /></para>
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" sid="PRO 18" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 18:1" />Ɔturi wɔ loisɛ ɔɖɔɛ maturi ne ɔ̃ ɔnɔwɛ̃saã ɔkpɛ kama ɔsɛ ɔti;</para>
  <para style="q2" vid="PRO 18:1">ɔ̃isɛ ɔkã kuka kukuwɛ̃ atsue.<verse eid="PRO 18:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2" />Kadzunisɛĩ iisɛ ɔna isoɣɔ kuiwɛ̃ i ara karɔ̃inɔ iso,</para>
  <para style="q2" vid="PRO 18:2">ɣɛɛ ɔsɛ ɔna isoɣɔ i ɔ̃ mɔmɔ adzuni gu nnɛ ɔ̃aɣɛ iso.<verse eid="PRO 18:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3" />Si ɔturi ɔbara aranyanyariã ne, masɛ manyɔ wũ pupurii,</para>
  <para style="q2" vid="PRO 18:3">fiɛ si kunuarɛ ɔmɔɛ̃ ɔturi ne isopa ka loaba.<verse eid="PRO 18:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4" />Ɔturi awune kanya ame atɔ̃me ne, ɔpo wodoroa aɖe,</para>
  <para style="q2" vid="PRO 18:4">ɣɛɛ iwola itubiɔ ɖe ngbegɔ i ndu sɛ mibɔrɛ pipiipi.<verse eid="PRO 18:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5" />Iilɛ sɔ aaya i ɔtilese kama</para>
  <para style="q2" vid="PRO 18:5">ɣee awarã ɔturi wɔ loiɣɛrɛ apia i atɔ̃mekaɣɛkɔ̃.<verse eid="PRO 18:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6" />Kadzunisɛĩ kanya ame atɔ̃me sɛ abɔ wũ kulu,</para>
  <para style="q2" vid="PRO 18:6">fiɛ ɔ̃ ikaɖe sɛ ibɔ ipɛ.<verse eid="PRO 18:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7" />Kadzunisɛĩ kanya nsɛ kapia wũ i iwɔ ame,</para>
  <para style="q2" vid="PRO 18:7">fiɛ ɔ̃ kanya ɖe kata ga nsɛ kaɖi wũ.<verse eid="PRO 18:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8" />Ituriraɣɛse atɔ̃me se lɛ aɖera wa mba ɔmɛrɛ̃ awe;</para>
  <para style="q2" vid="PRO 18:8">asɛ abo ta ɔturi mina kame ame.<verse eid="PRO 18:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9" />Ɔturi wɔ lobara karɔ̃fɛfɛ̃ i ɔ̃ karabara ame ne,</para>
  <para style="q2" vid="PRO 18:9">raninase ɔnyii ɔɖe.<verse eid="PRO 18:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10" />
    <char style="nd">Bosate</char> iyere ɖe adzarara wa mba ɔle,</para>
  <para style="q2" vid="PRO 18:10">ɔturi bɔlɔlɔa sɛ ɔtere ɔkɛlɛ wã ame fiɛ ɔsɛ ɔwe i kaɣɔ ame.<verse eid="PRO 18:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11" />Ranase ɔmagɛ̃siare wɔ mba ɔle nɖe ɔ̃ karana,</para>
  <para style="q2" vid="PRO 18:11">masɛ manyɔ kã lɛ ibere kɔlɛa ɔkpã wɔ nto ɔdzuɛ̃ wũ awe.<verse eid="PRO 18:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12" />Fiɛ ɔturi aakpase ne, iteso sɛ iwe i ɔ̃ ame,</para>
  <para style="q2" vid="PRO 18:12">ɣɛɛ karɔ̃ibɔso sɛ iba fiɛ kuwarɛ.<verse eid="PRO 18:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13" />Ɔturi wɔ nsɛ ɔtã itɔ̃me mmuai gɔ ɔ̃ikã atsue ɔnɔ tɔtɔ ne,</para>
  <para style="q2" vid="PRO 18:13">ne nɖe ɔ̃ adzunisɛ̃ra gu kunuarɛ ne.<verse eid="PRO 18:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14" />Ɔturi siwarã nsɛ simɔɛ̃ wũ sila i ɔnyɛ ame,</para>
  <para style="q2" vid="PRO 18:14">ɣɛɛ si siwarã ɔfɔ igbɛ ne, ɔriinyɔ siina.<verse eid="PRO 18:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15" />Nwɔ nsɛ ɔnɔ ara karɔ̃ sɛ ɔna inɔkpa;</para>
  <para style="q2" vid="PRO 18:15">fiɛ ɔturi wolai sɛ ɔbie inɔkpa.<verse eid="PRO 18:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16" />Ɔturi karatã sɛ kabusi ɔri katã wũ,</para>
  <para style="q2" vid="PRO 18:16">fiɛ isɛ ikɔ wũ ikɛlɛgu maturi nyaa anɔ.<verse eid="PRO 18:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17" />Ɔturi wɔ nsɛ ɔɖe katɔ̃ ɔkɛlɛgu ɔ̃ itɔ̃me sɛ ɔte lɛ nwɔ ɔkpɛ loya;</para>
  <para style="q2" vid="PRO 18:17">gbɔgbɔɔgbɔ ɔturi mama ɔba ɔ̃akarɛ wũ atɔ̃me.<verse eid="PRO 18:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18" />Kareremi sɛ katã kulu ɔɖaɛ</para>
  <para style="q2" vid="PRO 18:18">fiɛ kasɛ kakpura mma nto makpɛ̃gu so teteree ndɛ̃.<verse eid="PRO 18:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19" />Ɔnyii wɔ maɣɛrɛ ne ɔɣɛgu so ɔɖo ɔmagɛ̃siare wɔ mba ɔle,</para>
  <para style="q2" vid="PRO 18:19">fiɛ kulu ibara ba ɔle lɛ ɔlekasɛkɔ̃ kuyogodɔ̃ gɔ mapia ibɔrasɛ̃dziri awe.<verse eid="PRO 18:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20" />Ɔturi kanya idziribi to iatã wũ ɔmi</para>
  <para style="q2" vid="PRO 18:20">fiɛ nnɛ ɔɣɛ to iaba i ɔ̃ ngbã iso ɔmi.<verse eid="PRO 18:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21" />Kukpi gu ngbã pia i ɔnyagɛmi nrɔɔ̃ ame,</para>
  <para style="q2" vid="PRO 18:21">fiɛ mma loɖɔɛ ne to maaɖe ne idziribi.<verse eid="PRO 18:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22" />Ɔturi wɔ lona ɔrɔ̃go sɛɛ ɔyiri ne, ɔna ira nɛ nlɛ,</para>
  <para style="q2" vid="PRO 18:22">fiɛ ɔsɛ ɔna nnyainyɔ ibɔrɛ i <char style="nd">Bosate</char> kɔrɛ.<verse eid="PRO 18:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23" />Wɛrɛba sɛ ɔpɛ nrɔɔ̃ itã kayiribielea;</para>
  <para style="q2" vid="PRO 18:23">ɣɛɛ ranase sɛ ɔtã itɔ̃me mmuai ku ada.<verse eid="PRO 18:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24" />Kulaa gbodzoo ipia sɛgu kukpi;</para>
  <para style="q2" vid="PRO 18:24">burise ɣɛɛ ne, ɔsɛ ɔpɛ ɔmatã ɔɖo ta ɔnyiibi mɔmɔ kɔraa.<verse eid="PRO 18:24" /></para>
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" sid="PRO 19" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 19:1" />Wɛrɛba wɔ nsɛgbai nna iɣɛrɛ</para>
  <para style="q2" vid="PRO 19:1">lɛ ɔɖo kadzunisɛĩ ladze.<verse eid="PRO 19:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2" />Ɔdzini wɔ ame inɔkpa na iilɛ,</para>
  <para style="q2" vid="PRO 19:2">ɣee iilɛ sɔ ɔturi aakarara fiɛ ɔ̃ayu ɔri.<verse eid="PRO 19:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3" />Ɔturi adzunisɛ̃ra nsɛ anina ara i ɔ̃ ngbã iso,</para>
  <para style="q2" vid="PRO 19:3">ɣɛɛ ɔsɛ ɔna sikpã i <char style="nd">Bosate</char> iso.<verse eid="PRO 19:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4" />Karana sɛ kakpadzɛ̃ malaa gbodzoo kabɔ ɔturi,</para>
  <para style="q2" vid="PRO 19:4">ɣɛɛ wɛrɛba ɔlaa sɛ ɔrui ɔnyua wũ.<verse eid="PRO 19:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5" />Aɖansiɛ ladze iibawe sɔ maibakpadzɛ̃ wũ kutsue,</para>
  <para style="q2" vid="PRO 19:5">fiɛ nwɔ nsɛ ɔla mila iibawe fala kere.<verse eid="PRO 19:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6" />Maturi gbodzoo sɛ mabara ara si mabo ɔɖeisoi anɔ,</para>
  <para style="q2" vid="PRO 19:6">fiɛ ɔturi biara sɛ ɔpia kulaa ku nwɔ nsɛ ɔtã maturi ara.<verse eid="PRO 19:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7" />Wɛrɛba manyiibi ɔɖuɖu sɛ marui manyua wũ.</para>
  <para style="q2" vid="PRO 19:7">Kumɛɔ ame i ɔ̃ malaa ana kɔraa sɛ mare wũ kama ne.</para>
  <para style="q1" vid="PRO 19:7">Atoasɔ ɔto ɔpia kubɛ ɔɖegu ma ika ne,</para>
  <para style="q2" vid="PRO 19:7">kuira iisɛ ibɔrɛ ne ame.<verse eid="PRO 19:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8" />Ɔturi wɔ nsɛ ɔtsue iwola sɛ ɔɖɔɛ ɔ̃ mɔmɔ;</para>
  <para style="q2" vid="PRO 19:8">ɔturi wɔ nsɛ ɔnyɔ karɔ̃inɔ lɛ ira nyaa sɛ ɔna isaruɛ.<verse eid="PRO 19:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9" />Aɖansiɛ ladze iibawe sɔ maibakpadzɛ̃ wũ kutsue,</para>
  <para style="q2" vid="PRO 19:9">fiɛ nwɔ nsɛ ɔla mila to ɔ̃awɔ.<verse eid="PRO 19:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10" />Iikote sɔ kadzunisɛĩ aɖe kayi ku ɔmɛrɛ̃,</para>
  <para style="q2" vid="PRO 19:10">fiɛ iasɛ iaɖe sɔ ɔsande aaɖe ɔɖeisoi i makpakpaturi iso!<verse eid="PRO 19:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11" />Ɔturi iwola nsɛ itã ɔɣara so</para>
  <para style="q2" vid="PRO 19:11">fiɛ kuwarɛ kuɖe kutã wũ si maɣɛrɛ wũ kɔraa ne, ɔ̃isɛ ɔkpa anya.<verse eid="PRO 19:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12" />Igara sikpã ina se lɛ dzata sifafã awe;</para>
  <para style="q2" vid="PRO 19:12">ɣɛɛ ɔ̃ nnyainyɔ ɔse lɛ kuɖobiobio lopɛ kufere i sikua iso awe.<verse eid="PRO 19:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13" />Ɔbi wɔ nɖe kadzunisɛĩ ɖe itikpi ɔtã ɔ̃ ɔse,</para>
  <para style="q2" vid="PRO 19:13">fiɛ ɔre wɔ nɖe kalɔdze se lɛ kado wɔ nto ɔpɛ ɔ̃ito ɔnyua awe.<verse eid="PRO 19:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14" />Ayo gu karana ɖe kaɖekɔ̃ ga lobɔrɛ i ɔbi maɣese kɔrɛ,</para>
  <para style="q2" vid="PRO 19:14">ɣɛɛ ɔre wolai ne, ɔbɔrɛ i <char style="nd">Bosate</char> kɔrɛ.<verse eid="PRO 19:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15" />Ndã ibara sɛ itã marɛ mirɛ siare,</para>
  <para style="q2" vid="PRO 19:15">fiɛ dãdze ne, kukã nsɛ kukpɛ̃ wũ.<verse eid="PRO 19:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16" />Ɔturi wɔ nsɛ ɔbara i mmara iso sɛ ɔsɛ ngbã,</para>
  <para style="q2" vid="PRO 19:16">ɣɛɛ ɔturi wɔ loiwarɛ mmara, to ɔ̃akpi.<verse eid="PRO 19:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17" />Ɔturi wɔ nsɛ ɔbara mawɛrɛba kayiribielea sɛ ɔnyɛ ira ɔtã <char style="nd">Bosate</char>.</para>
  <para style="q2" vid="PRO 19:17">Ne <char style="nd">Bosate</char> to ɔ̃atã wũ kuso i nnɛ ɔbara iti.<verse eid="PRO 19:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18" />Kpadzɛ̃ fɔ ɔbi, ala ne ame i ɔriinyɔ pia,</para>
  <para style="q2" vid="PRO 19:18">ɣɛɛ daabara kuira nɛ abie wũ kukpi.<verse eid="PRO 19:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19" />Ɔturi wɔ nsɛ ɔna sikpã malamala aafɔ ne kuso,</para>
  <para style="q2" vid="PRO 19:19">alasɔ si afɔ wũ ne, ato aaledza ibara ngbɔ ana.<verse eid="PRO 19:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20" />Kã kuka atsue si afɔ asɛra apia,</para>
  <para style="q2" vid="PRO 19:20">iyɔ kawirikɔ̃ ne aato aatsue iwola.<verse eid="PRO 19:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21" />Ɔturi sɛ ɔbara adzuni gbodzoo,</para>
  <para style="q2" vid="PRO 19:21">ɣɛɛ nnɛ i <char style="nd">Bosate</char> sɛ ɔbie nsɛ iba i ne ame.<verse eid="PRO 19:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22" />Ɔturi kubie nɖe ɔnukuare kuɖɔɛ.</para>
  <para style="q2" vid="PRO 19:22">Ilɛ si aɖe wɛrɛba iɖo sɔ aaɖe ladze.<verse eid="PRO 19:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23" />
    <char style="nd">Bosate</char> kunigã sɛ kutã ngbã.</para>
  <para style="q2" vid="PRO 19:23">Iyɔ ɔturi aawe i isobuɛ ame, iraboa iibabara wũ.<verse eid="PRO 19:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24" />Si dãdze ɔpia kɔrɔ̃ i irɔi ame ne,</para>
  <para style="q2" vid="PRO 19:24">ɔ̃ibaɖi kɔ̃ ɔsu ɔpia i kanya ana kɔraa!<verse eid="PRO 19:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25" />Pɛ aɣiãrase, kadzunisɛĩ to ɔ̃atsɛ iwola itsue;</para>
  <para style="q2" vid="PRO 19:25">nyagalagu ara karɔ̃inɔse, ɔto ɔ̃atsɛ anɔikpa.<verse eid="PRO 19:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26" />Ɔbi wɔ nsɛ ɔbara ɔ̃ ɔse ɔtile fiɛ ɔsɛ ɔsa ɔ̃ ɔnyi ɔɖi iyo ne,</para>
  <para style="q2" vid="PRO 19:26">nwɔ nsɛ ɔbɔ kunuarɛ gu isopa ɔɖe.<verse eid="PRO 19:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27" />Wũ ɔbi, si anyua atsueikã araite ne,</para>
  <para style="q2" vid="PRO 19:27">aato aasɛnɛkɛ̃ i inɔkpa atɔ̃me kɔrɛ.<verse eid="PRO 19:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28" />Aɖansiɛ ituripɛ̃ sɛ ɔbara aɣiãra i itɔ̃me nɛ loya iso;</para>
  <para style="q2" vid="PRO 19:28">ɔturi nyanyariã sɛ ɔɖɔɛ itɔ̃me nɛ loikote iɣɛ.<verse eid="PRO 19:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29" />Kutsueikpadzɛ̃ se kutã maɣiãrase;</para>
  <para style="q2" vid="PRO 19:29">ipɛ se itã madzunisɛĩ kama.<verse eid="PRO 19:29" /></para>
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 20:1" />Ndã sɛ mibɔ aɣiãra, ndã kpokporoa sɛ mibɔ imami.</para>
  <para style="q2" vid="PRO 20:1">Mma nsɛ manɛ fiɛ misɛ mikɔ ma miyura iiɣe iwola.<verse eid="PRO 20:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2" />Igara sikpã teterea ina se lɛ dzata sifafã awe;</para>
  <para style="q2" vid="PRO 20:2">ɔturi wɔ nsɛ ɔpia wũ sikpã sɛ ɔyura ɔ̃ ngbã.<verse eid="PRO 20:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3" />Ɔturi wɔ nsɛ ɔkpɛ so ɔɖi i kulu ame ne, ɔsɛ ɔpia so kuwarɛ,</para>
  <para style="q2" vid="PRO 20:3">ɣɛɛ kadzunisɛĩ biara sɛ ɔlɔ kalɔ mala.<verse eid="PRO 20:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4" />Dãdze iisɛ ɔkpɛ̃ ɔwĩ ku ɔkpɛ̃wi;</para>
  <para style="q2" vid="PRO 20:4">ne ɔso ɔraɖui ɔsɔrɛ̃wi ne ɔ̃isɛ ɔna kuira ɔsɔrɛ̃.<verse eid="PRO 20:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5" />Ɔturi awune adzuni se lɛ ɔpo wodoroa,</para>
  <para style="q2" vid="PRO 20:5">ɣɛɛ ara karɔ̃inɔse sɛ ɔɖi wã ɔbɔ.<verse eid="PRO 20:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6" />Maturi gbodzoo sɛ maɣɛ sɔ maɖe manukuarese,</para>
  <para style="q2" vid="PRO 20:6">ɣɛɛ lɛ aanya nukuarese ɔwɛ̃?<verse eid="PRO 20:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7" />Ɔturi bɔlɔlɔa sɛ ɔsɛ ngbã mɛ nna iɣɛrɛ;</para>
  <para style="q2" vid="PRO 20:7">kusɛkusɛ aaba i ɔ̃ mabiama iso.<verse eid="PRO 20:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8" />Si igara ɔsɛ i ɔ̃ iyara iso si ɔɣɛ itɔ̃me ne,</para>
  <para style="q2" vid="PRO 20:8">ɔsɛ ɔfɛ fiɛ ɔnya aranyanyariã ɔɖuɖu ɔɖiite.<verse eid="PRO 20:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9" />Nna loawo ɔɣɛ sɔ, "Lokpa i ɔtu ame;</para>
  <para style="q2" vid="PRO 20:9">losekele fiɛ ikpi na me iso."?<verse eid="PRO 20:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10" />Akerera wa loiyi gu ara isusu ne loiyi ne,</para>
  <para style="q2" vid="PRO 20:10">
    <char style="nd">Bosate </char> ɔtsiri wã anyɔ ɔɖuɖu.<verse eid="PRO 20:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11" />Ɔbiɛtɛ kɔraa ne, ɔ̃ arabarara masu matsue wũ,</para>
  <para style="q2" vid="PRO 20:11">si ɔ̃ nsɛgbai lɛ gu si mikote.<verse eid="PRO 20:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12" />Kutsue gɔ nsɛ kunɔ ara gu inɔmi nɛ nsɛ inya ara ne,</para>
  <para style="q2" vid="PRO 20:12">
    <char style="nd">Bosate</char> lobara wã anyɔ ɔɖuɖu.<verse eid="PRO 20:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13" />Daaɖɔɛ sirɛ si iiɖe ngbɔ ato aamɔ wɛrɛba.</para>
  <para style="q2" vid="PRO 20:13">Busi anɔmi si araɖea aawe-ɔ.<verse eid="PRO 20:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14" />Raɣadze sɛ ɔɣɛ sɔ, "Kuɣa iilɛ, kuɣa iilɛ!"</para>
  <para style="q2" vid="PRO 20:14">Iyɔ si ɔrui ne, ɔsɛ ɔle so i kuɣaiɖe iso.<verse eid="PRO 20:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15" />Sikãrɛtɛa pia gu ata wa lofɔ kuɣa gbodzoo pia,</para>
  <para style="q2" vid="PRO 20:15">ɣɛɛ kanya ga nsɛ kaɖi inɔkpa kaɣɛ ɖe ikɛrɛra nɛ lofɔ kuɣa iɖo fiɛ iibɔ.<verse eid="PRO 20:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16" />Fɔ ɔturi wɔ loya i ɔfɔ kuso kama awu,</para>
  <para style="q2" vid="PRO 20:16">si asu apia awoba ame si ɔya i ɔrɔ̃go wɔ ɔ̃iɣe kama.<verse eid="PRO 20:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17" />Aɖera wa masɔsɔla ɔturi mafɔ ne, asɛ awe nwɔ losɔsɔla ɔturi ɔmɛrɛ̃,</para>
  <para style="q2" vid="PRO 20:17">ɣɛɛ ne kama ne, kutai nsɛ kuyi wũ i kanya.<verse eid="PRO 20:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18" />Bara adzuni iki i kuka sɛɛ ifɔ tɔtɔ ame.</para>
  <para style="q2" vid="PRO 20:18">Fɔ kuka gu isɔ̃ra si ato aakpɛ̃ kakpã.<verse eid="PRO 20:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19" />Ituriraɣɛse sɛ ɔɖi itɔ̃me wɛrɛa ɔɣɛ;</para>
  <para style="q2" vid="PRO 20:19">ne ɔso daabara mawɛ̃ ku minukuarese.<verse eid="PRO 20:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20" />Si ɔturi ɔgbarĩ ɔ̃ ɔse ɣee ɔnyi ne,</para>
  <para style="q2" vid="PRO 20:20">ɔ̃ ɔkaniɛ aanyi i idududu kpirikpiria ame.<verse eid="PRO 20:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21" />Kaɖekɔ̃ ga mayasoiso mafɔ ku karɔ̃kasɛkɔ̃ ne,</para>
  <para style="q2" vid="PRO 20:21">kusɛkusɛ iisɛ kuwe i ne ame ku kawirikɔ̃.<verse eid="PRO 20:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22" />Daaɣɛ sɔ, "Loatã-ɔ ikpi nɛgbe kuso!"</para>
  <para style="q2" vid="PRO 20:22">Nyɔ <char style="nd">Bosate</char> ɔri, ne ɔto ɔ̃aɖi-ɔ.<verse eid="PRO 20:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23" />
    <char style="nd">Bosate</char> ɔtsiri akerera wa loiyi</para>
  <para style="q2" vid="PRO 20:23">fiɛ isusura nɛ loiyi iisɛ iɣɔ wũ anɔ.<verse eid="PRO 20:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24" />
    <char style="nd">Bosate</char> nsɛ ɔte ɔturi kukpa kanekɔ̃.</para>
  <para style="q2" vid="PRO 20:24">Nda ngbɔ ɔturi aawo ɔ̃ mɔmɔ nsɛgbai karɔ̃ ɔnɔ?<verse eid="PRO 20:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 20:25" />Kata kaɖe sɔ ɔturi aasu ira ɔsɛ ise ɔtã Ɣaa ku siwa</para>
  <para style="q2" vid="PRO 20:25">fiɛ ne kama ɔ̃aba ɔ̃abara adzuni i ndamu mɛ ɔkã iso.<verse eid="PRO 20:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26" />Igara wolai sɛ ɔfɛ fiɛ ɔnya maturi nyanyariã ɔɖiite,</para>
  <para style="q2" vid="PRO 20:26">fiɛ ɔsɛ ɔtã manene ma iso ku kamɔipɛ kubore.<verse eid="PRO 20:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27" />
    <char style="nd">Bosate</char> ɔkaniɛ sɛ ɔsa ɔbo i ɔturi awune siwarã ame;</para>
  <para style="q2" vid="PRO 20:27">ɔsɛ ɔfiɛ ɔfere i ɔturi kame ame.<verse eid="PRO 20:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28" />Nnyainyɔ gu ɔnukuareiɖe nsɛ atã igara kaɣɔ;</para>
  <para style="b" vid="PRO 20:28" />
  <para style="q2" vid="PRO 20:28">fiɛ iki i kuɖɔɛ ame ne, ɔ̃ sigaraiyara ɣɛ teteree.<verse eid="PRO 20:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29" />Maporoporoi ikɛrɛra nɖe ma ɔle,</para>
  <para style="q2" vid="PRO 20:29">siɣaa i iti nɖe ɔkpakpa kuwarɛ.<verse eid="PRO 20:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30" />Akama gu agbɛ sɛ afore iranyanyariã aɖi,</para>
  <para style="q2" vid="PRO 20:30">fiɛ ipɛ sɛ iɖi nsɛgbai nyanyariã i ɔturi ame.<verse eid="PRO 20:30" /></para>
  <para style="b" />
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" sid="PRO 21" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 21:1" />Igara ɔtu pia i <char style="nd">Bosate</char> nrɔɔ̃ ame;</para>
  <para style="q2" vid="PRO 21:1">ɔsɛ ɔkɔ wũ ɔkigu i ngbegɔ ɔsɛ ɔɖɔɛ lɛ nduborea awe.<verse eid="PRO 21:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2" />Ɔturi arabarara ɔɖuɖu se lɛ aya i ɔ̃ mɔmɔ kɔrɛ</para>
  <para style="q2" vid="PRO 21:2">ɣɛɛ <char style="nd">Bosate</char> sɛ ɔkere ɔtu ɔnyɔ.<verse eid="PRO 21:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3" />Ira sɛɛ gu nnɛ loya ibara</para>
  <para style="q2" vid="PRO 21:3">sɛ ibo <char style="nd">Bosate</char> anɔ iɖo isɔrɛ.<verse eid="PRO 21:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4" />Inyɔso anɔmi gu katoikɔlɛso ne,</para>
  <para style="q2" vid="PRO 21:4">matilese ɔkaniɛ wɔ nɖe ikpi kere iɖe!<verse eid="PRO 21:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5" />Ɔturi wɔ mba ɔdzini siriita sɛ siɖe kusia</para>
  <para style="q2" vid="PRO 21:5">ayi kumɛgɔ i siri mala gu sikurukutua sɛ sibɔ siwɛrɛba.<verse eid="PRO 21:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6" />Mila ɔnyagɛmi isu ina karana ne,</para>
  <para style="q2" vid="PRO 21:6">ipipi nɛ nsɛ ife kere gu kukpi kata ɔri aɖe.<verse eid="PRO 21:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7" />Maturi nyanyariã ɔtile nsɛ iwɔra ma,</para>
  <para style="q2" vid="PRO 21:7">alasɔ masɛ masɛ̃ ira sɛɛ ibara.<verse eid="PRO 21:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8" />Ɔturi wɔ loɣɛrɛ ɔri sɛ ɔgɔ,</para>
  <para style="q2" vid="PRO 21:8">ɣɛɛ nwɔ nna iɣɛrɛ sɛ ɔbara ira nɛ loya.<verse eid="PRO 21:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9" />Iyo isã ɔɣokã iso iwe lɛ iɖo</para>
  <para style="q2" vid="PRO 21:9">iyo kame iwegu kalɔdze ɔrɔ̃go.<verse eid="PRO 21:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10" />Ɔtilese sɛ ɔbie iranyanyariã ibara;</para>
  <para style="q2" vid="PRO 21:10">ɔ̃ ɔnyii ara iisɛ akpɛ̃ wũ nnya.<verse eid="PRO 21:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11" />Si makpadzɛ̃ aɣiãrase kutsue ne, nwɔ loiɣe kayi ame sɛ ɔtsue iwola;</para>
  <para style="q2" vid="PRO 21:11">si mate nwɔ nɣe iwola ara ne, ɔsɛ ɔkpa anɔ.<verse eid="PRO 21:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12" />Ɔbɔlɔlɔa sɛ ɔnyɔ ɔtilese iyo ɔsɛ ikpo</para>
  <para style="q2" vid="PRO 21:12">fiɛ ɔsɛ ɔkpadzɛ̃ matilese ɔpia i iwɔ ame.<verse eid="PRO 21:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13" />Ɔturi wɔ nsɛ ɔtɛ̃ra atsue i mawɛrɛba kaku iso ne,</para>
  <para style="q2" vid="PRO 21:13">ɔ̃ wũ ɔto ɔ̃abiɛ kaku fiɛ kuwɛ̃ iibanɔ ɔtã wũ.<verse eid="PRO 21:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14" />Karatã ga matã i iwɛrɛ ame sɛ kaɣɔra sikpã,</para>
  <para style="q2" vid="PRO 21:14">fiɛ kawɛrɛra ga makɔla i awu ame sɛ ibɔ isobuɛ i sikpã lala ame.<verse eid="PRO 21:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15" />Si mabara ira nɛ loya ne isɛ itã ɔturi bɔlɔlɔa isoɣɔ</para>
  <para style="q2" vid="PRO 21:15">ɣɛɛ iɖe ifɔ̃ra itã maturi nyanyariã.<verse eid="PRO 21:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16" />Ɔturi wɔ losɛnɛkɛ̃ i ara karɔ̃inɔ ɔri iso ne,</para>
  <para style="q2" vid="PRO 21:16">ɔto ɔ̃asɛ ɔ̃awarã i makpise ndɛ̃.<verse eid="PRO 21:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17" />Ɔturi wɔ nsɛ ɔɖɔɛ kayi iɖe ne, ɔsɛ ɔkpese wɛrɛba;</para>
  <para style="q2" vid="PRO 21:17">ɔturi wɔ nsɛ ɔɖɔɛ ndã gu nnɔĩ ne, ɔ̃ibana ara.<verse eid="PRO 21:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18" />Ɔtilese masɛ masu matã kukpuraso i ɔturi bɔlɔlɔa kanya,</para>
  <para style="q2" vid="PRO 21:18">fiɛ ɔturi wɔ loiɖe ɔnukuarese masɛ masu matã kukpuraso i ɔturi sɛɛ kanya.<verse eid="PRO 21:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 21:19" />Fafuĩ ame iwe lɛ iɖo</para>
  <para style="q2" vid="PRO 21:19">ɔrɔ̃go kalɔdze gu kanasikpã kɔrɛ isɛ.<verse eid="PRO 21:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20" />Ɔturi wolai iyo ne araɖea wa mba ɔmɛrɛ̃ gu nnɔĩ pia;</para>
  <para style="q2" vid="PRO 21:20">ɣɛɛ kadzunisɛĩ sɛ ɔɖe irabiara nɛ ɔba.<verse eid="PRO 21:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21" />Ɔturi wɔ nsɛ ɔbie ara bɔlɔlɔa ibara gu kuɖɔɛ ne,</para>
  <para style="q2" vid="PRO 21:21">ɔ̃ana ngbã gu isaruɛ gu kuwarɛ.<verse eid="PRO 21:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22" />Ɔturi wolai sɛ ɔta ɔbo i makparɛrɛĩ ɔmagɛ̃siare iso</para>
  <para style="q2" vid="PRO 21:22">fiɛ ɔsɛ ɔbibiɛ ɔlekasɛkɔ̃ ga iso masiaiti ɔfere i karɔ̃.<verse eid="PRO 21:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23" />Ɔturi wɔ nsɛ ɔkososo ku ɔ̃ kanya gu ɔnyagɛmi ne,</para>
  <para style="q2" vid="PRO 21:23">ɔ̃isɛ ɔpia so i imɔrɛ̃ ame.<verse eid="PRO 21:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24" />Katoikɔlɛsoi gu ɔtesoi</para>
  <para style="q2" vid="PRO 21:24">wɔ nsɛ ɔbara inyɔso kaɖu ara masɛ makpere sɔ "Aɣiãrase".<verse eid="PRO 21:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25" />Dãdze ɔrakolo nsɛ ɔɖoe wũ,</para>
  <para style="q2" vid="PRO 21:25">alasɔ ɔ̃ nrɔɔ̃ ɔsɛ̃ karabara ibara.<verse eid="PRO 21:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26" />Dãdze sɛ ɔkɛkɛ anɔ ɔbua ku ɔwi biara,</para>
  <para style="q2" vid="PRO 21:26">ɣɛɛ ɔturi bɔlɔlɔa sɛ ɔtã maturi ara faa.<verse eid="PRO 21:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27" />Ɔtilese isɔrɛ ɖe inyanyara -</para>
  <para style="q2" vid="PRO 21:27">ibua inyanyarĩ gbaã si iɖe sɔ masu ne mabɔ ku adzuni nyanyariã!<verse eid="PRO 21:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28" />Aɖansiɛ ladze to ɔ̃awɔ,</para>
  <para style="q2" vid="PRO 21:28">fiɛ ɔrere wɔ lokã wũ atsue to ɔ̃awɔ.<verse eid="PRO 21:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29" />Ɔtilese sɛ ɔbua ɔbara anɔɣɔa.</para>
  <para style="q2" vid="PRO 21:29">ɣɛɛ ɔturi sɛɛ sɛ ɔsɛ iti ame i ɔ̃ nsɛgbai iso.<verse eid="PRO 21:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30" />Iwola gu ara karɔ̃inɔ gu adzuni ibara kuawɛ̃</para>
  <para style="q2" vid="PRO 21:30">iibawo iti ɔre si ita iya i <char style="nd">Bosate</char> iso.<verse eid="PRO 21:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31" />Masɛ maledza ipɔngɔ masɛ itã kakpã iyi,</para>
  <para style="q2" vid="PRO 21:31">ɣɛɛ iɖeiso pia i <char style="nd">Bosate</char> nrɔɔ̃ ame.<verse eid="PRO 21:31" /></para>
  <para style="b" />
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" sid="PRO 22" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 22:1" />Iyere sɛɛ ibie lɛ iɖo karana gbodzoo;</para>
  <para style="q2" vid="PRO 22:1">maturi si manyɔ-ɔ ku kuwarɛ lɛ iɖo sikãrɛtɛa ɣee sikãfudza.<verse eid="PRO 22:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2" />Ranase gu wɛrɛba ɔkate i nnɛgbe ame:</para>
  <para style="q2" vid="PRO 22:2">
    <char style="nd">Bosate</char> ɔɖe lobara ma ɔɖuɖu.<verse eid="PRO 22:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3" />Ɔturi wolai sɛ ɔnya itikpi ɔɖe katɔ̃ fiɛ ɔsɛ ɔkɔla so i katarikɔ̃;</para>
  <para style="q2" vid="PRO 22:3">ɣɛɛ kadzunisɛĩ sɛ ɔsu so ɔpia i kame, fiɛ ɔsɛ ɔwe inyɛ i ne iti.<verse eid="PRO 22:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4" />Karɔ̃ibɔso gu <char style="nd">Bosate</char> kunigã,</para>
  <para style="q2" vid="PRO 22:4">sɛ atã karana gu kuwarɛ gu ngbã tagbaraa.<verse eid="PRO 22:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5" />Miyu gu kuta se i ɔturi nyanyariã ɔri iso,</para>
  <para style="q2" vid="PRO 22:5">ɣɛɛ nwɔ nsɛ ɔdzuɛ̃ so sɛ ɔrera so kama i wã kɔrɛ.<verse eid="PRO 22:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6" />Kpadzɛ̃ ɔbi i ɔri wɔ ikote sɔ ɔ̃aki iso,</para>
  <para style="q2" vid="PRO 22:6">iyɔ si ɔmɔ ne, ɔ̃ibasɛnɛkɛ̃ i ɔ̃ iso.<verse eid="PRO 22:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7" />Maranase sɛ maɖe mawɛrɛba iso,</para>
  <para style="q2" vid="PRO 22:7">fiɛ ɔturi wɔ lonyɛ ira i ɔturi kɔrɛ ne, ɔsande ɔsɛ ɔɖe ɔtã nyɛtãse.<verse eid="PRO 22:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8" />Ɔturi wɔ lopɛ ɔtile aasɔrɛ̃ imɔrɛ̃ siare,</para>
  <para style="q2" vid="PRO 22:8">iyɔ ɔ̃ sikpã kutsueikpadzɛ̃ ɔdziri aatuĩ.<verse eid="PRO 22:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9" />Maafere ɔturi wɔ mba kayiribielea kusɛkusɛ,</para>
  <para style="q2" vid="PRO 22:9">alasɔ ɔsɛ ɔɣɛ ɔ̃ araɖea ku mawɛrɛba.<verse eid="PRO 22:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10" />Sa aɣiãrase ɖi, iyɔ kulu to kuatuĩ,</para>
  <para style="q2" vid="PRO 22:10">kalɔ gu sitia ana aatuĩ.<verse eid="PRO 22:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11" />Ɔturi wɔ nsɛ ɔɖɔɛ ɔtu wɔ lokpa fiɛ ɔɣe ikaɖe nɛ lobualɛ ɔturi ne,</para>
  <para style="q2" vid="PRO 22:11">ɔto ɔ̃aɖe igara ɔlaa.<verse eid="PRO 22:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12" />
    <char style="nd">Bosate</char> anɔ sɛ adzuɛ̃ inɔkpa,</para>
  <para style="q2" vid="PRO 22:12">ɣɛɛ ɔsɛ ɔkpɔkpɔtɔra mma nna ɔnukuare itɔ̃me.<verse eid="PRO 22:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13" />Dãdze nsɛ ɔɣɛ sɔ, "Dzata pia i inyamɔ!"</para>
  <para style="q2" vid="PRO 22:13">Ɣee sɔ, "Mato maaɖoe me i ɔvurã iso!"<verse eid="PRO 22:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14" />Rãrɔdze kanya ne, iwo wodoroa iɖe.</para>
  <para style="q2" vid="PRO 22:14">Ɔturi wɔ iso <char style="nd">Bosate</char> ɔna sikpã nto ɔ̃apɛ ɔbo ne ame.<verse eid="PRO 22:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15" />Si adzunisɛ̃ra ɔmini ɔbi ɔtu iso ne,</para>
  <para style="q2" vid="PRO 22:15">ikpadzɛ̃ ɔpɛdziri nsɛ ɔbɛse wã ɔɖi i wũ iso.<verse eid="PRO 22:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16" />Ɔturi wɔ nsɛ ɔwedza mawɛrɛba inyɛ sɔ ɔ̃ ara si asi abua,</para>
  <para style="q2" vid="PRO 22:16">gu nwɔ nsɛ ɔtã ranase ara ne - ma inyɔ ɔɖuɖu sɛ makpese mawɛrɛba.<verse eid="PRO 22:16" /></para>
  <para style="b" />
  <para style="s1">Simai Sitɛ</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 22:17" />Sɛ atsue si anɔ mawolai atɔ̃me;</para>
  <para style="q2" vid="PRO 22:17">si fɔ adzuni si asia i nnɛ lote-ɔ iso,<verse eid="PRO 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18" />alasɔ ilɛ si akɔla wã i fɔ ɔtu ame</para>
  <para style="q2" vid="PRO 22:18">fiɛ wã ɔɖuɖu sia-ɔ i kanya iso.<verse eid="PRO 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19" />Nto lobie sɔ siaiti i <char style="nd">Bosate</char> iso,</para>
  <para style="q2" vid="PRO 22:19">ɔso nto lote-ɔ ara nɔme fɔ wũ kɔraa ne.<verse eid="PRO 22:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20" />Ɔtsɛrɛ loitsɛrɛ araite sitɛ,</para>
  <para style="q2" vid="PRO 22:20">wa ame i kuka gu inɔkpa pia lotã-ɔ?<verse eid="PRO 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21" />Si lote-ɔ ɔnukuare gu nnɛ lokote,</para>
  <para style="q2" vid="PRO 22:21">sɔ si aawo mmuai sɛɛ ɔtã</para>
  <para style="q2" vid="PRO 22:21">mma lopia-ɔ katɔme ɣɛɛ?<verse eid="PRO 22:21" /></para>
  <para style="b" />
  <para style="s2">Ɔwɛ̃</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22" />Daayu wɛrɛba ala ɔ̃ siwɛrɛba ɔso,</para>
  <para style="q2" vid="PRO 22:22">daaɖe ɣiãni amumu i atɔ̃makaɣɛkɔ̃,<verse eid="PRO 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23" />alasɔ <char style="nd">Bosate</char> to ɔ̃afɔ ma itɔ̃me,</para>
  <para style="q2" vid="PRO 22:23">fiɛ ɔto ɔ̃awɔra mma loɖe ma amumu ngbã.<verse eid="PRO 22:23" /></para>
  <para style="b" />
  <para style="s2">Inyɔ</para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24" />Daapia kulaa ku ɔturi wɔ nsɛ ɔna sikpã malamala,</para>
  <para style="q2" vid="PRO 22:24">daasɛgu kanasikpã.<verse eid="PRO 22:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25" />Si iiɖe ngbɔ ne, aato aasuã ɔ̃ nsɛgbai</para>
  <para style="q2" vid="PRO 22:25">fiɛ fɔ ngbã aabo i kata ame.<verse eid="PRO 22:25" /></para>
  <para style="b" />
  <para style="s2">Itɛ</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26" />Daaɖe ɔturi wɔ nsɛ ɔpia kɔrɔ̃ i kuso kamaiya ame</para>
  <para style="q2" vid="PRO 22:26">ɣee daaya i ɔturi wɔ lonyɛ kuso kama;<verse eid="PRO 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27" />alasɔ si kuira na-ɔ aasu atã i kuso kanya ne,</para>
  <para style="q2" vid="PRO 22:27">fɔ mɔmɔ karɛkɔ̃ ne, mato maafɔ-ɔ kã iso.<verse eid="PRO 22:27" /></para>
  <para style="b" />
  <para style="s2">Ina</para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28" />Daarui kume kuere kuere</para>
  <para style="q2" vid="PRO 22:28">gɔ i fɔ mawatɛtɛ ɔsia masɛ.<verse eid="PRO 22:28" /></para>
  <para style="b" />
  <para style="s2">Iru</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29" />Ɔɔnya ɔturi wɔ mba kusɛ̃ i ɔ̃ karabara ame?</para>
  <para style="q2" vid="PRO 22:29">Ɔto ɔ̃asumu magara</para>
  <para style="q2" vid="PRO 22:29">iiɖe maturi fefea ɔ̃asumu.<verse eid="PRO 22:29" /></para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" sid="PRO 23" />
  <para style="s2">Ikuɔ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 23:1" />Si asi i ɔpɔrɔ̃ katɔ̃ sɔ aaɖegu ɔɖeisoi ara ne,</para>
  <para style="q2" vid="PRO 23:1">nyɔ nnɛ nse i fɔ katɔ̃ kukaakɔ.<verse eid="PRO 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2" />Si aɖe ɖeɖei ne,</para>
  <para style="q2" vid="PRO 23:2">iyɔ ɖesoiso teteree.<verse eid="PRO 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3" />Daawe ɔrakolo i ɔ̃ aɖera mɛrɛ̃mɛrɛã iso,</para>
  <para style="q2" vid="PRO 23:3">alasɔ aɖera wa masɛ masɔsɔla ɔturi aɖe.<verse eid="PRO 23:3" /></para>
  <para style="s2">Ikɔdzɛ</para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4" />Daaɖaa so sɔ aakpese ranase;</para>
  <para style="q2" vid="PRO 23:4">tsue iwola si aɖi ne i adzuni ame.<verse eid="PRO 23:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5" />Su anɔmi si anyɔ karana, kere ka kakpa,</para>
  <para style="q2" vid="PRO 23:5">alasɔ kato kaare abue</para>
  <para style="q2" vid="PRO 23:5">fiɛ kaafɛrɛrɛ kakɛlɛ ɔwiri ame lɛ finikpo awe.<verse eid="PRO 23:5" /></para>
  <para style="s2">Fafarana</para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6" />Daaɖe ɔyiriɖoi aɖera,</para>
  <para style="q2" vid="PRO 23:6">daawe ɔrakolo i ɔ̃ aɖera mɛrɛ̃mɛrɛã iso;<verse eid="PRO 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7" />alasɔ ɔɖe ɔturi ɔwɛ̃ igbã</para>
  <para style="q2" vid="PRO 23:7">nwɔ nto ɔbu iti ame i kuso iso ɔwi biara.</para>
  <para style="q1" vid="PRO 23:7">Ɔsɛ ɔɣere-ɔ sɔ, "Ɖe ara, si anɛ ara,"</para>
  <para style="q2" vid="PRO 23:7">ɣɛɛ atɔ̃me wagbe iibɔrɛ i ɔ̃ ɔtu ame.<verse eid="PRO 23:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8" />Ato aara aɖera kɛkɛĩ wa ɔɔɖe</para>
  <para style="q2" vid="PRO 23:8">fiɛ fɔ ile atɔ̃me wa aɣɛ to aɖe siefe.<verse eid="PRO 23:8" /></para>
  <para style="s2">Kaiwɛ̃</para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9" />Daaɖe kadzunsɛĩ ika,</para>
  <para style="q2" vid="PRO 23:9">ɔto ɔ̃anyɔ iwola nɛ mpia i fɔ atɔ̃me ame pupurii.<verse eid="PRO 23:9" /></para>
  <para style="b" />
  <para style="s2">Iweo</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10" />Daarui kume kuere kuere,</para>
  <para style="q2" vid="PRO 23:10">ɣee amɔɛ̃ makpisemabi nkpɛkɔ̃ afɔ i ma kɔrɛ.<verse eid="PRO 23:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 23:11" />Daabara ngbɔ alasɔ ma Fɔdze ba ɔle;</para>
  <para style="q2" vid="PRO 23:11">ɔto ɔ̃afɔ ma kanya i itɔ̃me iso ɔta ɔya-ɔ iso.<verse eid="PRO 23:11" /></para>
  <para style="s2">Iweo-ɔ̃wɛ̃</para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12" />Su fɔ ɔtu sia i araite atɔ̃me iso,</para>
  <para style="q2" vid="PRO 23:12">si akã inɔkpa atɔ̃me atsue.<verse eid="PRO 23:12" /></para>
  <para style="s2">Iweo-inyɔ</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13" />Daasɛ̃ sɔ aito akpadzɛ̃ fɔ ɔbi kutsue.</para>
  <para style="q2" vid="PRO 23:13">Si aɖeɖe wũ ɔdziri ne, ɔ̃ibakpi.<verse eid="PRO 23:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14" />Kpadzɛ̃ ɔbi kutsue ku ɔdziri</para>
  <para style="q2" vid="PRO 23:14">si aɖi ɔ̃ ngbã abɔrɛgu i kukpi ame.<verse eid="PRO 23:14" /></para>
  <para style="b" />
  <para style="s2">Iweo-itɛ</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15" />Wũ ɔbi, si fɔ ɔtu ɔtsue iwola ne,</para>
  <para style="q2" vid="PRO 23:15">iyɔ wũ ɔtu to ɔ̃ana isoɣɔ;<verse eid="PRO 23:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16" />so to siaɣɔ wũ ɔkala</para>
  <para style="q2" vid="PRO 23:16">si aɣɛ nnɛ loya.<verse eid="PRO 23:16" /></para>
  <para style="s2">Iweo-ina</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17" />Daarɛtɛra anɔmi i makpibaradze iso,</para>
  <para style="q2" vid="PRO 23:17">ɣɛɛ we <char style="nd">Bosate</char> kunigã ame teteree ɔwi ɔɖuɖu.<verse eid="PRO 23:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18" />Si abara ngbɔ gbaã ne, ɔriinyɔ pia i kɔrãkaɖe ame itã-ɔ,</para>
  <para style="q2" vid="PRO 23:18">fiɛ fɔ ɔriinyɔ iibaɖe siefe.<verse eid="PRO 23:18" /></para>
  <para style="s2">Iweo-iru</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19" />Wũ ɔbi, nɔ, si atsue iwola,</para>
  <para style="q2" vid="PRO 23:19">si asu fɔ ɔtu asia i ɔri sɛɛ iso.<verse eid="PRO 23:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20" />Daapia kulaa ku ndã gbodzoo manɛdze</para>
  <para style="q2" vid="PRO 23:20">ɣee daapia kulaa ku mina siare mawedze,<verse eid="PRO 23:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21" />alasɔ tarɛ̃dze gu ɖeɖei sɛ makpese mawɛrɛba;</para>
  <para style="q2" vid="PRO 23:21">fiɛ mirɛ siare irɛ sɛ mitã mawe i ara kɛkɛa ame.<verse eid="PRO 23:21" /></para>
  <para style="s2">Iweo-ikuɔ</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22" />Kã fɔ ɔse wɔ loɣe-ɔ atɔ̃me atsue,</para>
  <para style="q2" vid="PRO 23:22">ana ne daanyɔ fɔ ɔnyi pupurii i ɔ̃ sikpakpaso ame.<verse eid="PRO 23:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23" />Ɣa ɔnukuare, daaɖi wũ arɔĩ.</para>
  <para style="q2" vid="PRO 23:23">Na iwola, iturikpadzɛ̃ gu ara karɔ̃inɔ.<verse eid="PRO 23:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24" />Ɔturi bɔlɔlɔa ɔse sɛ ɔna isoɣɔ gbaã;</para>
  <para style="q2" vid="PRO 23:24">ɔrɛrɛ̃ wɔ loɣe ɔbi wolai sɛ ɔna isoɣɔ i ɔ̃ iso.<verse eid="PRO 23:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25" />Tã fɔ ɔse gu fɔ ɔnyi si mana isoɣɔ;</para>
  <para style="q2" vid="PRO 23:25">si ɔnyi wɔ loɣe-ɔ si ɔna isoɣɔ!<verse eid="PRO 23:25" /></para>
  <para style="b" />
  <para style="s2">Iweo-ikɔdzɛ</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26" />Wũ ɔbi, su fɔ ɔtu tã me,</para>
  <para style="q2" vid="PRO 23:26">si anyɔ wũ nsɛgbai asɛ ikpo,<verse eid="PRO 23:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27" />alasɔ sidzetɔrɔ̃go ɖe iwo wodoroa,</para>
  <para style="q2" vid="PRO 23:27">fiɛ ɔre wɔ loɔsu so rãrɔdze ɖe itubiɔ mɔmɔriã.<verse eid="PRO 23:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28" />Ɔsɛ ɔwɛrɛ ɔsia lɛ yukukpe awe,</para>
  <para style="q2" vid="PRO 23:28">fiɛ ɔsɛ ɔbara sɔ mma loisɛ maɖe ɔnukuare sɛ masi i marɛrɛ̃ ndɛ̃.<verse eid="PRO 23:28" /></para>
  <para style="b" />
  <para style="s2">Iweo-fafarana</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29" />Nna mba isoma? Nna nsɛ ɔna ibo gu ibɛbɛrɛ?</para>
  <para style="q2" vid="PRO 23:29">Nna nsɛ ɔbara kulu? Nna nsɛ ɔlɔ ɔsɔ?</para>
  <para style="q2" vid="PRO 23:29">Nna iso nsɛ ibɛbɛ siefe? Nna anɔmi nsɛ arɛtɛ abara dɔɔ̃?<verse eid="PRO 23:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30" />Mma nsɛ makamu i ndã kayirinɔ,</para>
  <para style="q2" vid="PRO 23:30">mma nsɛ maɖɔɛ ndã mɛ malupu inɛ inyɔ ne.<verse eid="PRO 23:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31" />Daanyɔ ndã gɔ mirɛtɛ,</para>
  <para style="q2" vid="PRO 23:31">gɔ mito mifu i ikɔi ame,</para>
  <para style="q2" vid="PRO 23:31">fiɛ si anɛ ne misɛ mife pɔkɔsɔɔ!<verse eid="PRO 23:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32" />Katsɔrakɔ̃ ne misɛ miɖo lɛ aɣɛ awe,</para>
  <para style="q2" vid="PRO 23:32">fiɛ misɛ miɖi kabiɛtɛ lɛ kabeku awe.<verse eid="PRO 23:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33" />Fɔ anɔmi to aanya afɔ̃ra</para>
  <para style="q2" vid="PRO 23:33">fiɛ aato aanya akpɔkpɔtɔra i fɔ adzuni ame.<verse eid="PRO 23:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34" />Ato aase lɛ ɔturi wɔ nto ɔrɛ sirɛ i ɔpo wɔ loise kpoo iso.</para>
  <para style="q2" vid="PRO 23:34">Aase lɛ ɔturi wɔ nsi i nduisoibuɛ ame fiɛ ito ife i ngbe gu i mmɔ.<verse eid="PRO 23:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35" />Ato aaɣɛ sɔ, "Mawuĩ me ira, ɣɛɛ iraboa iibara me!</para>
  <para style="q2" vid="PRO 23:35">Mapɛ me ɣɛɛ iibo me!</para>
  <para style="q1" vid="PRO 23:35">Iɖe ɔwi wɔ loarɛgɛ̃</para>
  <para style="q2" vid="PRO 23:35">si loabie ndã mama lonɛ?"<verse eid="PRO 23:35" /></para>
  <para style="b" />
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" sid="PRO 24" />
  <para style="s2">Iweo-kaiwɛ̃</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1" />Daarɛtɛra anɔmi i matilese iso,</para>
  <para style="q2" vid="PRO 24:1">fiɛ daabie sɔ aawe i ma ikuri ame;<verse eid="PRO 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2" />alasɔ ɔtile ara iso masɛ mabu i iti ame,</para>
  <para style="q2" vid="PRO 24:2">fiɛ masɛ maɖeika i kumɛgɔ maabɔ imɔrɛ̃.<verse eid="PRO 24:2" /></para>
  <para style="b" />
  <para style="s2">Sinyɔ</para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3" />Iwola masɛ masu matsue iyo,</para>
  <para style="q2" vid="PRO 24:3">fiɛ masɛ masɛra ne iki i karɔ̃inɔ ame.<verse eid="PRO 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4" />Iki i inɔkpa ame masɛ masu karana ga loibɔ</para>
  <para style="q2" vid="PRO 24:4">fiɛ kato kalɛnyɔ mayigu i kuyoi ame.<verse eid="PRO 24:4" /></para>
  <para style="b" />
  <para style="s2">Sinyɔ-ɔwɛ̃</para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5" />Ɔturi wolai ba ɔle gbaã,</para>
  <para style="q2" vid="PRO 24:5">fiɛ ɔturi wɔ ku inɔkpa sɛ ɔna ɔle ɔbua.<verse eid="PRO 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6" />Alasɔ isɔ̃ra sɛɛ ame miawo ɔta kakpã,</para>
  <para style="q2" vid="PRO 24:6">fiɛ iɖeiso sɛ iba iki i kuka matãdze gbodzoo iso.<verse eid="PRO 24:6" /></para>
  <para style="b" />
  <para style="s2">Sinyɔ-inyɔ</para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7" />Iwola ɔfe kato ikɔlɛ itã kadzunisɛĩ,</para>
  <para style="q2" vid="PRO 24:7">fiɛ ɔna kuira ɔ̃aɣɛ i iturikuri kanyakasakɔ̃ i itiri.<verse eid="PRO 24:7" /></para>
  <para style="b" />
  <para style="s2">Sinyɔ-itɛ</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8" />Ɔturi wɔ nsɛ ɔɖo iranyanyariã adzuni ne,</para>
  <para style="q2" vid="PRO 24:8">ɔ̃ masɛ makpere sɔ aranyanyariã sate ne.<verse eid="PRO 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9" />Kadzunisɛĩ adzunisɛ̃ra ibara ɖe ikpi,</para>
  <para style="q2" vid="PRO 24:9">fiɛ maturi ɔtsiri aɣiãrase.<verse eid="PRO 24:9" /></para>
  <para style="b" />
  <para style="s2">Sinyɔ-ina</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10" />Si asɛ afɛ̃ ku imɔrɛ̃ ɔwi ne,</para>
  <para style="q2" vid="PRO 24:10">fɔ ɔle ɔbua ɔtɛmi!<verse eid="PRO 24:10" /></para>
  <para style="b" />
  <para style="s2">Sinyɔ-iru</para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11" />Fɔ mma masɛgu maaɖoe,</para>
  <para style="q2" vid="PRO 24:11">si amɔɛ̃ mma nsɛ dodadoda to makɛlɛ maaɖaɛ ma ɔme afegu kama.<verse eid="PRO 24:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12" />Si aɣɛ sɔ, "Boiɣe kuira i nnɛgbe iso" ne,</para>
  <para style="q2" vid="PRO 24:12">nwɔ nsɛ ɔkere ɔtu ɔnyɔ ne ɔ̃ibanya ne ɔɖiite?</para>
  <para style="q1" vid="PRO 24:12">Nwɔ nsɛ ɔdzuɛ̃ fɔ ngbã ne, ɔɣe ne.</para>
  <para style="q2" vid="PRO 24:12">Ɔto ɔ̃atã ɔbiara ɔtikuso i nnɛ ɔbara kanya.<verse eid="PRO 24:12" /></para>
  <para style="b" />
  <para style="s2">Sinyɔ-ikuɔ</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13" />Wũ ɔbi, nɛ maɣendu ala milɛ;</para>
  <para style="q2" vid="PRO 24:13">maɣendu mɛ i kuɣesɛi ame aawe-ɔ ɔmɛrɛ̃.<verse eid="PRO 24:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14" />Tsue sɔ ngbɔ ana i iwola sɛ iwe fɔ ɔkala ɔmɛrɛ̃ ne;</para>
  <para style="q2" vid="PRO 24:14">si anya ne ne, iyɔ ɔriinyɔ piɔ-ɔ i ɔwi wɔ nto ɔba ame,</para>
  <para style="q2" vid="PRO 24:14">fiɛ fɔ ɔriinyɔ iibaɖe siefe.<verse eid="PRO 24:14" /></para>
  <para style="b" />
  <para style="s2">Sinyɔ-ikɔdzɛ</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 24:15" />Daase lɛ ɔtilese wɔ nsɛ ɔpia ɔkpã ɔwɛrɛ gɔ ɔ̃abiɛ ɔturi bɔlɔlɔa iyo,</para>
  <para style="q2" vid="PRO 24:15">daata abo i ɔ̃ kawekɔ̃ ayu wũ;<verse eid="PRO 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16" />alasɔ atoasɔ ɔturi bɔlɔlɔa sɛ ɔrɔ̃ ikpɛ ikɔdzɛ ne, ɔsɛ ɔta ana,</para>
  <para style="q2" vid="PRO 24:16">ɣɛɛ matilese sɛ marɔ̃ si mabo i kukpakpi ame.<verse eid="PRO 24:16" /></para>
  <para style="b" />
  <para style="s2">Sinyɔ-fafarana</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17" />Daana isoɣɔ si fɔ tsirise ɔrɔ̃.</para>
  <para style="q2" vid="PRO 24:17">Si ɔtura ne so daaɣɔ-ɔ.<verse eid="PRO 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18" />Si iiɖe ngbɔ ne, <char style="nd">Bosate</char> to ɔ̃anya iyɔ iibabo wũ anɔ,</para>
  <para style="q2" vid="PRO 24:18">fiɛ ɔto ɔ̃atuĩdza sikpã ina i ɔ̃ iso.<verse eid="PRO 24:18" /></para>
  <para style="b" />
  <para style="s2">Sinyɔ-kaiwɛ̃</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19" />Daana sikpã ala maturi nyanyariã iti,</para>
  <para style="q2" vid="PRO 24:19">fiɛ daarɛtɛra anɔmi i matilese iso,<verse eid="PRO 24:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20" />alasɔ ɔturi nyanyariã na ɔriinyɔ kuwɛ̃ ku kɔrãkaɖe ame,</para>
  <para style="q2" vid="PRO 24:20">fiɛ mato maanidza ɔtilese ɔkaniɛ.<verse eid="PRO 24:20" /></para>
  <para style="b" />
  <para style="s2">Sitɛ</para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21" />Wũ ɔbi, nigã <char style="nd">Bosate</char> gu igara,</para>
  <para style="q2" vid="PRO 24:21">daabua i matsuelese iso.<verse eid="PRO 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22" />Alasɔ iwɔ aabɔrɛ i ma inyɔ ɔɖuɖu kɔrɛ iba i matsuelese iso ɔluwɛ̃.</para>
  <para style="q2" vid="PRO 24:22">Nna nɣe itikpi nɛ loabɔrɛ i Ɣaa ɣee igara kɔrɛ iba i ma iso?<verse eid="PRO 24:22" /></para>
  <para style="s1">Mawolai Simai Mama</para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 24:23" />Nwagbe ɖe mawolai simai ana:</para>
  <para style="q1" vid="PRO 24:23">Ɔturi kama isiai i atɔ̃meiɣɛ ame iilɛ.<verse eid="PRO 24:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24" />Ɔturi wɔ nsɛ ɔɣere ɔturi wɔ loɣɛrɛ sɔ, "Aɖe ibɛ" ne -</para>
  <para style="q2" vid="PRO 24:24">maturi aagbarĩ wũ fiɛ nɖebi aatsiri wũ.<verse eid="PRO 24:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25" />Ɣɛɛ ialɛgu maturi ma nsɛ makpadzɛ̃ ɔturi wɔ loɣɛrɛ kutsue,</para>
  <para style="q2" vid="PRO 24:25">kusɛkusɛ gbaã aaba i ma iso.<verse eid="PRO 24:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26" />Ɔturi wɔ nsɛ ɔtã itɔ̃me mmuai ku ɔnukuare ne</para>
  <para style="q2" vid="PRO 24:26">ite sɔ ɔlaa gbaã ɔɖe.<verse eid="PRO 24:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27" />Wiri fɔ inyamɔ karabara</para>
  <para style="q2" vid="PRO 24:27">si akpɛ̃ siwĩ;</para>
  <para style="q2" vid="PRO 24:27">ne kama, tsue fɔ iyo.<verse eid="PRO 24:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28" />Daaɖe aɖansiɛ ata aya i fɔ ɔnyii iso siefe,</para>
  <para style="q2" vid="PRO 24:28">ɣee asu fɔ kanya asɔsɔla ku mila.<verse eid="PRO 24:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29" />Daaɣɛ sɔ, "Loabara wũ lɛ nnɛ ɔbara me.</para>
  <para style="q2" vid="PRO 24:29">Loabara wũ nnɛ ɔbara me lotikuso."<verse eid="PRO 24:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30" />Loki i dãdze ɔwɛ̃ kakpɛkɔ̃ lofe,</para>
  <para style="q2" vid="PRO 24:30">ne loki i kadzunisɛĩ wainkakpɛkɔ̃ ame ne.<verse eid="PRO 24:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31" />Miyu gu akora ɔfɔ ɔwĩ ame pelepele,</para>
  <para style="q2" vid="PRO 24:31">sikua ɔyi siɣɛ sifɔ karɔ̃,</para>
  <para style="q2" vid="PRO 24:31">fiɛ ɔ̃ ata ibere ɔɔrɔ̃.<verse eid="PRO 24:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32" />Losɛ iti ame i nnɛ lonya iso.</para>
  <para style="q2" vid="PRO 24:32">I nnɛ lonya ame ne, losuã ira lobɔrɛgu i kame sɔ:<verse eid="PRO 24:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33" />"Sirɛ kɛkɛĩ, sirɛ itua kɛkɛĩ,</para>
  <para style="q2" vid="PRO 24:33">karĩ nrɔɔ̃ si asɛ kɛkɛĩ awarã -<verse eid="PRO 24:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34" />siwɛrɛba nto siamɔɛ̃ ɔturi lɛ yukukpe awe</para>
  <para style="q2" vid="PRO 24:34">fiɛ ɔɣiã sɛ ɔba i ɔturi iso lɛ ɔrɛrɛ̃ wɔ lotɔ so akpandza awe.<verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" sid="PRO 25" />
  <para style="s1">Solomon Agbã Mama</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 25:1" />Agbã wagbe ɖe Solomon are ana. Yuda igara Xezekia maturi ɔledza itsɛrɛ.<verse eid="PRO 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2" />Iɖe kuwarɛ kutã Ɣaa sɔ ɔsɛ ɔkɔla ira;</para>
  <para style="q2" vid="PRO 25:2">ɣɛɛ magara kuwarɛ nɖe sɔ mafafarɛ ira ame.<verse eid="PRO 25:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3" />Lɛ kumɛgɔ boibawo kuɖokpo kukɔlɛme gu karɔ̃ kuwodorome ɔtsue ne,</para>
  <para style="q2" vid="PRO 25:3">ngbɔ ame boibawo magara adzuni ɔtsue ne.<verse eid="PRO 25:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4" />Ɖi anyini i sikãfudza ame,</para>
  <para style="q2" vid="PRO 25:4">iyɔ sikãfudzatorese aana karabara ira.<verse eid="PRO 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5" />Ɖi ɔtilese i igara anɔmi ame,</para>
  <para style="q2" vid="PRO 25:5">iyɔ ɔ̃ sigaraiyara to iaya teteree i ara bɔlɔlɔa ibara ame.<verse eid="PRO 25:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6" />Daakɔlɛ so kato i igara anɔ,</para>
  <para style="q2" vid="PRO 25:6">fiɛ daabie sɔ aasɛ i maturi nyaa kasɛkɔ̃.<verse eid="PRO 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7" />Ilɛ sɔ ɔ̃aɣere-ɔ sɔ, "Ba sɛ i kakɔlɛkɔ̃ i ngbe,"</para>
  <para style="q2" vid="PRO 25:7">iɖo sɔ ɔ̃apia-ɔ kunuarɛ i makpakpaturi anɔmi ame.</para>
  <para style="b" vid="PRO 25:7" />
  <para style="q1" vid="PRO 25:7">Ira nɛ anya ku fɔ anɔmi ne,<verse eid="PRO 25:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="PRO 25:8" />daayasoiso asu nnɛ anya akɛlɛgu i atɔ̃mekaɣɛkɔ̃.</para>
  <para style="q1" vid="PRO 25:8">Be ato aabara ku ɔwi kama si fɔ ɔnyii ɔba ɔ̃apia-ɔ kunuarɛ?<verse eid="PRO 25:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9" />Si ato akpadzɛ̃ itɔ̃me ku fɔ ɔnyii ne;</para>
  <para style="q2" vid="PRO 25:9">daaɖi ɔturi mama iwɛrɛra aɣɛ,<verse eid="PRO 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10" />si nwɔ lonɔ aapia-ɔ kunuarɛ,</para>
  <para style="q2" vid="PRO 25:10">fiɛ fɔ iyere lalaa aba iafɔ karɔ̃ isɛ.<verse eid="PRO 25:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11" />Itɔ̃me nɛ maɣɛ i ne ɔwi iso ne,</para>
  <para style="q2" vid="PRO 25:11">ise lɛ sikãrɛtɛa irataa i sikãfudza ira iso awe.<verse eid="PRO 25:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12" />Ɔturi wolai kuka, se lɛ sikãrɛtɛa itsuebi ɣee ikɛrɛra</para>
  <para style="q2" vid="PRO 25:12">itã nwɔ nsɛ ɔkã wũ atsue.<verse eid="PRO 25:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13" />Lɛ kumɛgɔ i ndu yululua sɛ miɣɔra ɔturi sosina ku ɔraɖui ɔsɔrɛ̃wi ne,</para>
  <para style="q2" vid="PRO 25:13">ngbɔ ame i kpabo ɔnukuarese se ɔtã nwɔ lopia wũ katɔ̃me ne,</para>
  <para style="q2" vid="PRO 25:13">ɔsɛ ɔɣɔra ɔ̃ masate somina.<verse eid="PRO 25:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14" />Ɔturi wɔ nsɛ ɔɣɛ ɔsɛ i karatã iso ɣɛɛ ɔ̃isɛ ɔtã ne,</para>
  <para style="q2" vid="PRO 25:14">ɔse lɛ adɔdɔ gu ɔwiri wa loisɛ apɛ kado.<verse eid="PRO 25:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15" />Iɣaraso nsɛ ifɔ ira i igara kɔrɛ,</para>
  <para style="q2" vid="PRO 25:15">fiɛ ɔnyagɛmi pɔkɔsɔa nsɛ ɔwo ikui ɔbiɛ.<verse eid="PRO 25:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16" />Si anya maɣendu ne, nɛ kɛkɛɛkɛ kere -</para>
  <para style="q2" vid="PRO 25:16">si anɛ gbodzoo aɖodza ne, ɔra kere ara.<verse eid="PRO 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17" />Daala ɔɔsɛ fɔ ɔnyii iyo malamala -</para>
  <para style="q2" vid="PRO 25:17">si ka ato asɛ malamala ne ato aapa ɔmɛrɛ̃ fiɛ ɔ̃atsiri-ɔ.<verse eid="PRO 25:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18" />Ɔturi wɔ nsɛ ɔɖe mila aɖansiɛ i ɔ̃ ɔnyii iso ne,</para>
  <para style="q2" vid="PRO 25:18">ɔse lɛ ikpo ɣee itekpe ɣee kuta sirɛ̃ awe.<verse eid="PRO 25:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19" />Iti isia i ɔturi wɔ nna ɔnukuare iso ku ɔmɔrɛ̃wi,</para>
  <para style="q2" vid="PRO 25:19">se lɛ inyɛbɔ ɣee kukpasɛa iso awe.<verse eid="PRO 25:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20" />Ɔturi wɔ nto ɔka kuka ɔtã ɔtu wɔ nto ɔmararã so</para>
  <para style="q2" vid="PRO 25:20">se lɛ ɔturi wɔ loɖi ɔkati ɔsɛ ku ɔyuwi,</para>
  <para style="q2" vid="PRO 25:20">ɣee lɛ ndãbea mafere i iyɛi ame.<verse eid="PRO 25:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21" />Si kukã to fɔ tsirise ne, tã wũ aɖera si ɔɖe;</para>
  <para style="q2" vid="PRO 25:21">si ɔme to ɔkore wũ ne, tã wũ ndu si ɔnɛ.<verse eid="PRO 25:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22" />Si abara nnɛgbe ne, ise lɛ atɔgirĩ asu afere wũ i iti,</para>
  <para style="q2" vid="PRO 25:22">fiɛ <char style="nd">Bosate</char> to ɔ̃atã-ɔ ne kuso.<verse eid="PRO 25:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23" />Kato ɔwiri sɛ ɔbɔ kado,</para>
  <para style="q2" vid="PRO 25:23">fiɛ ituriraiɣɛ ɔnyagɛmi sɛ ɔtã mana sikpã gu adaa anɔ.<verse eid="PRO 25:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24" />Iyo isã ɔɣokã iso isɛ lɛ iɖo</para>
  <para style="q2" vid="PRO 25:24">iyo kame iwegu kalɔdze ɔrɔ̃go.<verse eid="PRO 25:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25" />Itɔ̃me bielea ifɔ ibɔrɛgu i kadzorokɔ̃,</para>
  <para style="q2" vid="PRO 25:25">se lɛ ndu yululua awe mitã ɔturi wɔ ɔme to ɔkore.<verse eid="PRO 25:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26" />Si ɔturi bɔlɔlɔa ɔbara iranyanyariã i ɔtilese anɔmi ame ne,</para>
  <para style="q2" vid="PRO 25:26">ngbɔ kere ise lɛ ndu godɛã mɛ malupu iba ɣee itubiɔ ndu mɛ loɣɛ awe.<verse eid="PRO 25:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27" />Maɣendu gbodzoo inɛ iilɛ,</para>
  <para style="q2" vid="PRO 25:27">fiɛ iilɛ sɔ aabie kuwarɛ gbodzoo ata so.<verse eid="PRO 25:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28" />Ɔturi wɔ loisɛ ɔɖesoiso ne,</para>
  <para style="q2" vid="PRO 25:28">ɔse lɛ ɔmagɛ̃siare wɔ mabiɛ ibere maɖi masɛ.<verse eid="PRO 25:28" /></para>
  <para style="b" />
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" sid="PRO 26" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 26:1" />Lɛ ɔyu ku kusɛ ame awe ɣee kado ku ɔraɖui ɔsɔrɛ̃wi awe ne,</para>
  <para style="q2" vid="PRO 26:1">ngbɔ i kuwarɛ iikote kutã kadzunisɛĩ ne.<verse eid="PRO 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2" />Lɛ kumɛgɔ i kanagini sɛ kafɛrɛrɛ ne, ɣee iɣororo sɛ ifɛrɛrɛ iki ne,</para>
  <para style="q2" vid="PRO 26:2">ngbɔ i sigbarĩ dzɛ loikote sɛ sikɛlɛ kukakɔi ne.<verse eid="PRO 26:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3" />Bosɛ bosu ɔdziri i ipɔngɔ iso, ne masɛ mapia kukomisɛi i ɔfirimu ɔpu iso, sɔ mabara nnɛ bobie,</para>
  <para style="q2" vid="PRO 26:3">fiɛ ɔdziri se ɔtã madzunisɛĩ mi kama.<verse eid="PRO 26:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4" />Daatã kadzunisɛĩ itɔ̃me mmuai i ɔ̃ adzunisɛ̃ra kanya,</para>
  <para style="q2" vid="PRO 26:4">si iiɖe ngbɔ fɔ wũ ne ato aaba aase lɛ ɔ̃ awe.<verse eid="PRO 26:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5" />Tã kadzunisɛĩ itɔ̃me mmuai i ɔ̃ adzunisɛ̃ra kanya,</para>
  <para style="q2" vid="PRO 26:5">si iiɖe ngbɔ ne ɔto ɔ̃anyɔ so sɔ ɔɣe iwola.<verse eid="PRO 26:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6" />Ɔturi wɔ nsɛ ɔpia kadzunisɛĩ katɔme ne,</para>
  <para style="q2" vid="PRO 26:6">ise lɛ ɔsɛ ɔtu ɔ̃ mɔmɔ kukpa ɣee ɔsɛ ɔbara so ɔtile.<verse eid="PRO 26:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7" />Lɛ kumɛgɔ i ɔle na bafã akpabɔ iso ne,</para>
  <para style="q2" vid="PRO 26:7">ngbɔ i igbã se i kadzunisɛĩ kanya ame ne.<verse eid="PRO 26:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8" />Ɔturi wɔ nsɛ ɔpia kadzunisɛĩ kuwarɛ ne,</para>
  <para style="q2" vid="PRO 26:8">ɔse lɛ ɔturi wɔ lonyi ita ɔpia i iwɛĩ ame awe.<verse eid="PRO 26:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 26:9" />Kumɛgɔ i siyu se i tarɛ̃dze kɔrɔ̃ ame ne,</para>
  <para style="q2" vid="PRO 26:9">ngbɔ i igbã se i kadzunisɛĩ kanya ame ne.<verse eid="PRO 26:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 26:10" />Kumɛgɔ i kutapɛdze sɛ ɔpia ɔturi ɔrere igbɛ ne,</para>
  <para style="q2" vid="PRO 26:10">ngbɔ ame kere ɔturi wɔ losu kadzunisɛĩ ɣee ɔrere wɔ nto ɔfe ɔpaa ne.<verse eid="PRO 26:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 26:11" />Lɛ kumɛgɔ i kpɛkpɛ sɛ ɔkpese ɔkɛlɛ ɔ̃ mɔmɔ kura kɔrɛ ne,</para>
  <para style="q2" vid="PRO 26:11">ngbɔ ame i kadzunisɛĩ sɛ ɔkpese ɔkɛlɛ ɔ̃ mɔmɔ adzunisɛ̃ra kɔrɛ ne.<verse eid="PRO 26:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 26:12" />Ɔriinyɔ pia kadzunisɛĩ ɔɖo</para>
  <para style="q2" vid="PRO 26:12">ɔturi wɔ nsɛ ɔbu so kawolai.<verse eid="PRO 26:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 26:13" />Dãdze sɛ ɔɣɛ sɔ, "Dzata pia i ɔri iso,</para>
  <para style="q2" vid="PRO 26:13">dzata to ɔkiki i itiri!"<verse eid="PRO 26:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 26:14" />Kumɛgɔ i kukui sɛ kukidza i kɔ̃ kubɔrai ame ne,</para>
  <para style="q2" vid="PRO 26:14">ngbɔ i dãdze sɛ ɔkidza so i ɔ̃ karɛkɔ̃ iso ne.<verse eid="PRO 26:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 26:15" />Si dãdze ɔpia kɔrɔ̃ i irɔi ame ne, ɔ̃ibaɖi kɔ̃;</para>
  <para style="q2" vid="PRO 26:15">kɔ̃ iɖi isu ipia i kanya ame sɛ iwe wũ ndã gbaã.<verse eid="PRO 26:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 26:16" />Dãdze sɛ ɔbu so kawolai</para>
  <para style="q2" vid="PRO 26:16">ɔɖo maturi ikɔdzɛ ma nsɛ matã itɔ̃me mmuai ku adzuni sɛɛ.<verse eid="PRO 26:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 26:17" />Ɔturi wɔ nsɛ ɔpia kanya i kulu gɔ loipɛgu wũ ame</para>
  <para style="q2" vid="PRO 26:17">se kere lɛ ɔturi wɔ nsɛ ɔmɔɛ̃ kpɛkpɛ atsue.<verse eid="PRO 26:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 26:18" />Lɛ kumɛgɔ i lalase sɛ ɔwɛrɛ̃</para>
  <para style="q2" vid="PRO 26:18">kaka mɔɛã ɣee ɔpɛ mirɛ̃ ne,<verse eid="PRO 26:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 26:19" />ngbɔ nɖe ɔturi wɔ nsɛ ɔsɔsɔla ɔ̃ ɔnyii</para>
  <para style="q2" vid="PRO 26:19">ɔɣɛ sɔ, "Kuɛrɛ kere nto lopia lo!"<verse eid="PRO 26:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 26:20" />Si katɔrɛ̃ ɔro ne, ɔtɔ sɛ ɔnyi;</para>
  <para style="q2" vid="PRO 26:20">si ituriraiɣɛ na ne, kulu sɛ kuro.<verse eid="PRO 26:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21" />Lɛ kumɛgɔ i akaĩ sɛ atã ɔtɔ ɔwara fiɛ ndɔrɛ̃ sɛ mitã ɔtɔ ɔtsue ne,</para>
  <para style="q2" vid="PRO 26:21">ngbɔ kere kalɔdze sɛ ɔpia ɔtɔ i kulu ame ne.<verse eid="PRO 26:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 26:22" />Ituriraiɣɛ atɔ̃me se lɛ aɖera wa mba ɔmɛrɛ̃ awe;</para>
  <para style="q2" vid="PRO 26:22">asɛ abo ta ɔturi mina kame ame.<verse eid="PRO 26:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 26:23" />Lɛ kumɛgɔ makua sise ibui ku sikãfudza wanɛkɛã ne,</para>
  <para style="q2" vid="PRO 26:23">ngbɔ i itɔ̃me mɛrɛ̃mɛrɛã iɣɛ nɛ ɔtu nyanyariã ɔbua iso se ne.<verse eid="PRO 26:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 26:24" />Kpɛ̃guse sɛ ɔɖeika sɛɛ ɔkɔla so,</para>
  <para style="q2" vid="PRO 26:24">ɣɛɛ ɔkɔla kasɔla i ɔ̃ ɔtu ame.<verse eid="PRO 26:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 26:25" />Atoasɔ ɔsɛ ɔɖeika sɛɛ ilɛ ɔnɔ ne, daafɔ wũ aɖe,</para>
  <para style="q2" vid="PRO 26:25">alasɔ amusuora akɔdzɛ pia i ɔ̃ ɔtu ame.<verse eid="PRO 26:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 26:26" />Si itsiri ɔwɛrɛ i ɔ̃ ame ala kasɔla ɔso ne,</para>
  <para style="q2" vid="PRO 26:26">ɔ̃ inyanyarĩ to iabɔrɛ kayi.<verse eid="PRO 26:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 26:27" />Si ɔturi ɔkuri iwo ne, ɔto ɔ̃akpase ɔbo i ne ame.</para>
  <para style="q2" vid="PRO 26:27">Si ɔturi ɔmɛlɛdza ita ne ito iamɛlɛ isia wũ iso.<verse eid="PRO 26:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 26:28" />Mila ɔnyagɛmi sɛ ɔtsiri maturi ma ɔnina,</para>
  <para style="q2" vid="PRO 26:28">fiɛ kanyamɛrɛ̃ atɔ̃me sɛ awɔra ara.<verse eid="PRO 26:28" /></para>
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" sid="PRO 27" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 27:1" />Daaɖe ndamu i kɔrãkaɖe iso,</para>
  <para style="q2" vid="PRO 27:1">alasɔ aiɣe nnɛ i iyi aakpadzɛ̃ ibɔ.<verse eid="PRO 27:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2" />Tã ɔturi mama si ɔle-ɔ, iiɖe fɔ mɔmɔ kanya;</para>
  <para style="q2" vid="PRO 27:2">ɔturi wɔ i kuruɛ si ɔle-ɔ, iiɖe fɔ mɔmɔ sinyako.<verse eid="PRO 27:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3" />Ita ba ɔrɔrã fiɛ sise ne ato aɖe,</para>
  <para style="q2" vid="PRO 27:3">ɣɛɛ kadzunisɛĩ sikpã ipia ɔturi ba ɔrɔrã iɖo wã anyɔ ɔɖuɖu.<verse eid="PRO 27:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4" />Ɔturi wɔ loyigu sikpã sɛ ɔbara ɔtile fiɛ sikpã teterea sɛ siwɔra ara,</para>
  <para style="q2" vid="PRO 27:4">ɣɛɛ ɔturi wɔ nto ɔkpɛ̃ sirerɛ ɔkpɛ ɔɖo.<verse eid="PRO 27:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5" />Ɔturi inyagalagu i ɔgbami</para>
  <para style="q2" vid="PRO 27:5">lɛ iɖo kuturiɖɔɛ wɛrɛa.<verse eid="PRO 27:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6" />Si fɔ ɔlaa ɔkpadzɛ̃gu-ɔ itɔ̃me ne, awo iti ɔsia i ɔ̃ iso</para>
  <para style="q2" vid="PRO 27:6">ɣɛɛ tsrise ipɔpɔrɛ ɔturi gbodzoo ɖe kasɔla.<verse eid="PRO 27:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7" />Ɔturi wɔ loɔmi sɛ ɔpupura maɣendu,</para>
  <para style="q2" vid="PRO 27:7">ɣɛɛ nwɔ kukã to ne, irabiara nɛ mba ɔɖo kɔraa sɛ iwe ɔ̃mɛrɛ̃ i kanya.<verse eid="PRO 27:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8" />Ɔturi wɔ loyu ɔ̃ iyo ɔri</para>
  <para style="q2" vid="PRO 27:8">se lɛ karodzai ga loyu kã irodzayo kɔrɛ awe.<verse eid="PRO 27:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9" />Ngarãdu gu kuakɔrɔ̃kɔrɔã sɛ apia ɔtu isoɣɔ,</para>
  <para style="q2" vid="PRO 27:9">fiɛ ɔmɛrɛ̃ wɔ mpia i ɔturi ɔlaa ame sɛ ibɔrɛ i ɔ̃ kuka sɛɛ ame.<verse eid="PRO 27:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10" />Daanyua fɔ ɔlaa ɣee fɔ ɔse ɔlaa asɛ,</para>
  <para style="q2" vid="PRO 27:10">fiɛ daasɛ fɔ ɔnyii iyo ku iyi nɛ itikpi ɔba-ɔ iso.</para>
  <para style="q2" vid="PRO 27:10">Ɔgbamikui wɔ lobore ɔmatã-ɔ lɛ ɔɖo fɔ ɔnyibirɛrɛ̃ wɔ mpia dzoroo.<verse eid="PRO 27:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11" />Wũ ɔbi, tsue iwola, si apia wũ ɔtu isoɣɔ;</para>
  <para style="q2" vid="PRO 27:11">iyɔ loawo ɔtã ɔturi ɔrere wɔ loanyɔ me pupurii itɔ̃me mmuai.<verse eid="PRO 27:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12" />Ɔturi wolai sɛ ɔnya itikpi fiɛ ɔsɛ ɔwɛrɛ so i katarikɔ̃;</para>
  <para style="q2" vid="PRO 27:12">ɣɛɛ kadzunisɛĩ sɛ ɔsu so ɔpia i kame, fiɛ ɔsɛ ɔwe inyɛ i ne iti.<verse eid="PRO 27:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13" />Fɔ ɔturi wɔ loya i ɔfɔ kama awu,</para>
  <para style="q2" vid="PRO 27:13">si asu apia awoba ame si ɔya i ɔrɔ̃go wɔ loɔsu so rãrɔdze kama.<verse eid="PRO 27:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14" />Ɔturi wɔ nsɛ ɔlakulu ɔfere ɔ̃ ɔnyii kusɛkusɛ ku kaya ne,</para>
  <para style="q2" vid="PRO 27:14">masɛ mabu ne sigbarĩ matã wũ.<verse eid="PRO 27:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15" />Ɔre wɔ nɖe kalɔdze se lɛ kado</para>
  <para style="q2" vid="PRO 27:15">wɔ nto ɔpɛ ɔ̃ito ɔnyua awe.<verse eid="PRO 27:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16" />Ɔturi wɔ nsɛ ɔsɛ̃ wũ se lɛ ɔwiri wɔ nto ɔfuri ɔto ɔtuĩdza,</para>
  <para style="q2" vid="PRO 27:16">ɣee ɔse lɛ ɔsu ɔ̃ kɔrɔ̃ ɔto ɔka nnɔĩ awe.<verse eid="PRO 27:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17" />Ibɔra nsɛ iruɛ ibɔra,</para>
  <para style="q2" vid="PRO 27:17">ngbɔ i ɔturi sɛ ɔruɛ ɔ̃ ɔnyii ne.<verse eid="PRO 27:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18" />Ɔturi wɔ nsɛ ɔnyɔ ɔ̃ kubo iso to ɔ̃aɖe kɔ̃ adziribi,</para>
  <para style="q2" vid="PRO 27:18">fiɛ ɔturi wɔ nsɛ ɔdzuɛ̃ ɔ̃ ɔkɔse mato maapia kuwarɛ ne.<verse eid="PRO 27:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19" />Kumɛgɔ i katɔ̃ sɛ kare katɔ̃ mɔmɔ si anyɔ i ndu ame ne,</para>
  <para style="q2" vid="PRO 27:19">ngbɔ i ɔturi nsegbai sɛ mikategu ɔ̃ ɔtu ne.<verse eid="PRO 27:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20" />Kukpi gu iwɔ aisɛ ami kuiyikuiyi,</para>
  <para style="q2" vid="PRO 27:20">ngbɔ ame i maturi sɛ mabie ara mabua.<verse eid="PRO 27:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21" />Masɛ mawanɛkɛ̃ra sikãfudza i ne ira ame fiɛ masɛ mawanɛkɛ̃ra skãrɛtɛa i ɔferewu ame,</para>
  <para style="q2" vid="PRO 27:21">ɣɛɛ masɛ makere ɔturi manyɔ ku ile nɛ ɔsɛ ɔna.<verse eid="PRO 27:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22" />Atoasɔ si asu ɔwɛi awete kadzunisɛĩ</para>
  <para style="q2" vid="PRO 27:22">lɛ kumɛgɔ masɛ mawete atitabi i kaɣɛ ame ne,</para>
  <para style="q2" vid="PRO 27:22">aibaɖi ɔ̃ adzunisɛ̃ra i ɔ̃ ame anya.<verse eid="PRO 27:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 27:23" />Nyɔ sɔ aɣe fɔ masɛrɛrerɔ̃ ikuri kuseme kukaakɔ,</para>
  <para style="q2" vid="PRO 27:23">si ala fɔ manantsuĩ kukaakɔ.<verse eid="PRO 27:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 27:24" />Alasɔ karana iisɛ kase ɔwi ɖaa,</para>
  <para style="q2" vid="PRO 27:24">fiɛ sigaraikoto ana iisɛ ise itã siɣekparɛ ɔɖuɖu.<verse eid="PRO 27:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 27:25" />Si sikua siina fiɛ sikua ɣɛtɛ ɔre ne,</para>
  <para style="q2" vid="PRO 27:25">fiɛ masa sikua kanya i abemi iso ne,<verse eid="PRO 27:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 27:26" />fɔ sɛrɛrerɔ̃ abi to aatã ana arapia,</para>
  <para style="q2" vid="PRO 27:26">fiɛ aana sikã abɔrɛgu i fɔ kutepuĩ ame asu aɣa kakpɛkɔ̃.<verse eid="PRO 27:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27" />Ato aana katepuĩ inyendu gbodzoo lɛ araɖea</para>
  <para style="q2" vid="PRO 27:27">itã mi gu fɔ iyomaturi</para>
  <para style="q2" vid="PRO 27:27">fiɛ aana akararã fɔ maɖabobirɔ̃gomi.<verse eid="PRO 27:27" /></para>
  <para style="b" />
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" sid="PRO 28" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 28:1" />Ɔtilese sɛ ɔrui ɔtere atoasɔ kuwɛ̃ iisɛ ɔtere ɔsia wũ,</para>
  <para style="q2" vid="PRO 28:1">ɣɛɛ ɔturi bɔlɔlɔa sɛ ɔwegu kagbegbe ɔtu lɛ dzata awe.<verse eid="PRO 28:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2" />Si kaɖe ɔta kayasoiso ne, kã maɖeisoi sɛ masi,</para>
  <para style="q2" vid="PRO 28:2">ɣɛɛ ɔturi wolai fiɛ ɔba ara karɔ̃inɔ sɛ ɔtã sɔ ibiara se ne kume.<verse eid="PRO 28:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3" />Ɔɖeisoi wɔ nsɛ ɔwedza mawɛrɛba inyɛ</para>
  <para style="q2" vid="PRO 28:3">se lɛ kado terea wɔ nsɛ ɔsore ɔraɖui ɔkɛlɛgu.<verse eid="PRO 28:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4" />Maturi ma losɛ̃ mmara ne, masɛ male matilese,</para>
  <para style="q2" vid="PRO 28:4">ɣɛɛ mma lomɔɛ̃ mmara mato sɛ mata maya i matilese iso.<verse eid="PRO 28:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5" />Maturi nyanyariã iisɛ manɔ itɔ̃me nɛ loya karɔ̃,</para>
  <para style="q2" vid="PRO 28:5">ɣɛɛ mma nsɛ mabie <char style="nd">Bosate</char> sɛ manɔ ne karɔ̃ kukaakɔ.<verse eid="PRO 28:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 28:6" />Wɛrɛba wɔ nsɛgbai nna iɣɛrɛ</para>
  <para style="q2" vid="PRO 28:6">lɛ ɔɖo ranase wɔ nna ɔnukuare.<verse eid="PRO 28:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 28:7" />Ɔturi wɔ nsɛ ɔmɔɛ̃ mmara ɔla ne, ɔbi wolai ɔɖe,</para>
  <para style="q2" vid="PRO 28:7">ɣɛɛ nwɔ nsɛ ɔpia kulaa gu maɖeɖei sɛ ɔpia ɔ̃ ɔse kunuarɛ.<verse eid="PRO 28:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 28:8" />Ɔturi wɔ nsɛ ɔmɔdza ɔ̃ karana iki i kusia kɔlɛa iso</para>
  <para style="q2" vid="PRO 28:8">sɛ ɔsira sɛ̃ kanya ɔsia iso ɔtã ɔturi mama wɔ loabara mawɛrɛba kayiribielea.<verse eid="PRO 28:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9" />Ɔturi wɔ lotɛ̃ atsue i mmara iso ne,</para>
  <para style="q1" vid="PRO 28:9">Ɣaa sɛ ɔtsiri ta ɔ̃ kayiikparama.<verse eid="PRO 28:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10" />Ɔturi wɔ nsɛ ɔsɔsɔla ɔturi bɔlɔlɔa ɔpia i ɔri nyanyariã iso ne,</para>
  <para style="q2" vid="PRO 28:10">ɔto ɔ̃abo i ɔ̃ mɔmɔ kata ame,</para>
  <para style="q2" vid="PRO 28:10">ɣɛɛ mma nna iɣɛrɛ to maafɔ kaɖekɔ̃ sɛɛ.<verse eid="PRO 28:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11" />Ranase sɛ ɔbu so sɔ ɔɣe iwola,</para>
  <para style="q2" vid="PRO 28:11">ɣɛɛ wɛrɛba wɔ nsɛ ɔnɔ ara karɔ̃ aatsue si gbaã ne ranase ɣe iwola.<verse eid="PRO 28:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12" />Si maturi bɔlɔlɔa to maɖeiso ne, isoɣɔ gbodzoo ɔwe;</para>
  <para style="q2" vid="PRO 28:12">ɣɛɛ si matilese ɔkpese maɖeisoi ne, maturi sɛ matere maawɛrɛ.<verse eid="PRO 28:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13" />Ɔturi wɔ nsɛ ɔfu ɔ̃ akpi ara ne, ɔ̃isɛ ɔna isaruɛ,</para>
  <para style="q2" vid="PRO 28:13">ɣɛɛ ɔturi wɔ nsɛ ɔɖi ɔ̃ akpi ɔɣɛ fiɛ ɔsɛ ɔnyua wã ibara ne, maanyɔ wũ nnya.<verse eid="PRO 28:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14" />So aaɣɔ ɔturi wɔ nsɛ ɔnigã <char style="nd">Bosate</char> ɔwi biara,</para>
  <para style="q2" vid="PRO 28:14">ɣɛɛ ɔturi wɔ losɛ̃ ɔ̃ ɔtu ne, ɔsɛ ɔbo i imɔrɛ̃ ame.<verse eid="PRO 28:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15" />Ɔtilese wɔ nsɛ ɔɖe mawɛrɛba kaɖe iso ne,</para>
  <para style="q2" vid="PRO 28:15">ɔse lɛ dzata wɔ nto ɔɖi silɔ ɣee iketeke nɛ ntere sɔ iamɔɛ̃ ira awe.<verse eid="PRO 28:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16" />Ɔɖeisoi wɔ nna ara karɔ̃inɔ ɖe nwɔ mba ɔtile,</para>
  <para style="q2" vid="PRO 28:16">ɣɛɛ nwɔ nsɛ ɔtsiri kusia iki i maturi iyu ame to ɔ̃asɛ ngbã tagbaraa.<verse eid="PRO 28:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17" />Ɔturi wɔ i ituriɖoe iɣɛrɛ to iɖaa ne,</para>
  <para style="q2" vid="PRO 28:17">ɔto ɔ̃ala ɔ̃atetere isɛ iabo i ɔ̃ ɔkpiwi;</para>
  <para style="q2" vid="PRO 28:17">kuwɛ̃ si ɔdaabuai wũ ɔrui ɔtere.<verse eid="PRO 28:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18" />Ɔturi wɔ nsɛ ɔbara ara sɛɛ aana kaɣɔ,</para>
  <para style="q2" vid="PRO 28:18">ɣɛɛ ɔturi wɔ siri logɔgɔlɔ to ɔ̃arɔ̃ ɔluwɛ̃.<verse eid="PRO 28:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19" />Ɔturi wɔ nsɛ ɔkpɛ̃ ɔ̃ ɔwĩ sɛ ɔna araɖea gbodzoo,</para>
  <para style="q2" vid="PRO 28:19">ɣɛɛ ɔturi wɔ nsɛ ɔɣɛ kanya kanya sɔ ɔ̃akpɛ̃ ɔwĩ ɣɛɛ ɔ̃ibara kuira i ne iso ne, ɔ̃ siwɛrɛba aaya adziri.<verse eid="PRO 28:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20" />Ɔturi wɔ mba ɔnukuare ne, kusɛkusɛ asia wũ iso gbaã,</para>
  <para style="q2" vid="PRO 28:20">ɣɛɛ ɔturi wɔ nɣɛ soiso sɔ ɔ̃ana sikã gu karana ne, maibasɛ̃ wũ kutsueikpadzɛ̃.<verse eid="PRO 28:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21" />Ɔturi kama isiai i itɔ̃meiɖaɛ ame iilɛ -</para>
  <para style="q2" vid="PRO 28:21">ɣɛɛ araɖea kosoi wa i ɔturi aafɔ iti ɔso ne, ɔ̃aɣɛrɛ.<verse eid="PRO 28:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22" />Kanyase sɛ ɔyasoiso si ɔna karana,</para>
  <para style="q2" vid="PRO 28:22">ɣɛɛ ɔ̃iɣe sɔ ɔɣiã ɣɛ ɔsia wũ.<verse eid="PRO 28:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23" />Ɔturi wɔ nsɛ ɔnyagalagu ɔmama to ɔ̃ana nnyainyɔ ɔbua i kawirikɔ̃</para>
  <para style="q2" vid="PRO 28:23">ɔɖo nwɔ nsɛ ɔɣɛ kasɔla kanya ame atɔ̃me mɛrɛ̃mɛrɛã.<verse eid="PRO 28:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24" />Ɔturi wɔ nsɛ ɔyu ɔ̃ ɔse ɣee ɔ̃ ɔnyi</para>
  <para style="q2" vid="PRO 28:24">fiɛ ɔsɛ ɔɣɛ sɔ, "Iiɖe ira lalaa" ne -</para>
  <para style="q2" vid="PRO 28:24">ɔnyanyarĩ kere lɛ raninase.<verse eid="PRO 28:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25" />Ɖeɖei sɛ ɔbɔ kulu gu kalɔ,</para>
  <para style="q2" vid="PRO 28:25">ɣɛɛ ɔturi wɔ nsɛ ɔsiaiti i <char style="nd">Bosate</char> iso to ɔ̃ana isaruɛ.<verse eid="PRO 28:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26" />Ɔturi wɔ lofɔ so ɔɖe ɖe kadzunisɛĩ,</para>
  <para style="q2" vid="PRO 28:26">ɣɛɛ nwɔ nsɛ ɔsɛ i iwola ame sɛ ɔwe i kaɣɔ ame.<verse eid="PRO 28:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27" />Ɔturi wɔ nsɛ ɔtã mawɛrɛba ara ne, kuira iibaɣiã wũ,</para>
  <para style="q2" vid="PRO 28:27">ɣɛɛ nwɔ nsɛ ɔfirikira anɔ i mawɛrɛba iso ne, masɛ maagbarĩ wũ gbaã.<verse eid="PRO 28:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28" />Si ɔtilese ɔkpese ɔɖeisoi ne, maturi sɛ matere maawɛrɛ;</para>
  <para style="q2" vid="PRO 28:28">ɣɛɛ si matilese ɔwɔ ne, maturi bɔlɔlɔa sɛ mawe.<verse eid="PRO 28:28" /></para>
  <para style="b" />
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" sid="PRO 29" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 29:1" />Ɔturi wɔ mayira ɔwi gbodzoo ɣɛɛ ɔsɛ̃ ɔ̃isu kuira i ne ame ne,</para>
  <para style="q2" vid="PRO 29:1">ɔto ɔ̃awɔ ɔluwɛ̃ gɔ maisibawo wũ ɔsa.<verse eid="PRO 29:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2" />Si maturi bɔlɔlɔa to maɖeiso ne, maturi sɛ mana isoɣɔ;</para>
  <para style="q2" vid="PRO 29:2">ɣɛɛ si maturi nyanyariã to maɖeiso ne, maturi sɛ matɔrɛ̃.<verse eid="PRO 29:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3" />Ɔbi wɔ nsɛ ɔɖɔɛ iwola ne, ɔsɛ ɔpia ɔ̃ ɔse isoɣɔ;</para>
  <para style="q2" vid="PRO 29:3">ɣɛɛ nwɔ nsɛ ɔpia kulaa ku sidzetɔmarɔ̃go sɛ ɔnina ɔ̃ karana ame.<verse eid="PRO 29:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4" />Igara wɔ lobara ara tɔrɔrɔa sɛ ɔsɛra kaɖe,</para>
  <para style="q2" vid="PRO 29:4">ɣɛɛ igara wɔ mba anɔ ibɛbɛ i sikã gu kuwɛrɛra ifɔ sɛ ɔbiɛ kã.<verse eid="PRO 29:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5" />Ɔturi wɔ nsɛ ɔɣere ɔ̃ ɔnyii kasɔla kanyamɛrɛ̃ atɔ̃me</para>
  <para style="q2" vid="PRO 29:5">sɛ ɔɖaɛ awulɛ ɔtã so.<verse eid="PRO 29:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6" />Ɔturi nyanyariã akpi nsɛ amɔɛ̃ ɔ̃ mɔmɔ,</para>
  <para style="q2" vid="PRO 29:6">ɣɛɛ ɔturi bɔlɔlɔa aawo aka ɔka ɔna isoɣɔ.<verse eid="PRO 29:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7" />Ɔturi bɔlɔlɔa sɛ ɔsu ira i mawɛrɛba ɔkpɛ i itɔ̃meiɣɛ i ɔri iso ame,</para>
  <para style="q2" vid="PRO 29:7">ɣɛɛ ɔtilese iisu kuira i ne igbã iso.<verse eid="PRO 29:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8" />Maɣiãrase sɛ mapia kulu i ɔmagɛ̃siare ame,</para>
  <para style="q2" vid="PRO 29:8">ɣɛɛ mawolai sɛ manidza sikpã.<verse eid="PRO 29:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9" />Si ɔturi wolai ɔsɛ atɔ̃mekaɣɛkɔ̃ ku kadzunisɛĩ ne,</para>
  <para style="q2" vid="PRO 29:9">kadzunisɛĩ sɛ ɔnyagɛ̃ ɔla ɔ̃ama sima, fiɛ isobuɛ iisɛ iwe.<verse eid="PRO 29:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10" />Maturiɖoese sɛ matsiri ɔturi wɔ nɖe ɔnukuarese</para>
  <para style="q2" vid="PRO 29:10">fiɛ maturiɖoese sɛ mabie sɔ maaɖoe ɔturi sɛɛ.<verse eid="PRO 29:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11" />Kadzunisɛĩ sɛ ɔɖi ɔ̃ sikpã ɔɖuɖu ɔte lɛ kumɛgɔ ɔ̃awo,</para>
  <para style="q2" vid="PRO 29:11">ɣɛɛ ɔturi wolai sɛ ɔmɔɛ̃ so ɔla.<verse eid="PRO 29:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12" />Si ɔɖeisoi sɛ ɔkã mila atɔ̃me atsue ne,</para>
  <para style="q2" vid="PRO 29:12">ɔ̃ makpakpa ɔɖuɖu to maakpese matilese.<verse eid="PRO 29:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13" />Wɛrɛba gu nwɔ nsɛ ɔwedza maturi inyɛ ɔɖuɖu ɔkate i nnɛgbe ame:</para>
  <para style="q2" vid="PRO 29:13">
    <char style="nd">Bosate</char> nsɛ ɔtã ma inyɔ ɔɖuɖu anɔmi sɔ manya ara.<verse eid="PRO 29:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14" />Si igara ɔɣɛgu mawɛrɛba atɔ̃me i ɔri wɔ loya iso ne,</para>
  <para style="q2" vid="PRO 29:14">ɔ̃ sigaraiyara aaya teteree ɔwi biara.<verse eid="PRO 29:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15" />Ɔturi iyira ɔpɛdziri sɛ ɔtã matsue iwola,</para>
  <para style="q2" vid="PRO 29:15">ɣɛɛ ɔbi wɔ maɖi atsue kere ɖe kunuarɛ ɔtã ɔ̃ ɔnyi.<verse eid="PRO 29:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16" />Si ɔtile to ɔkɛlɛ katɔ̃ ne, ikpi ibara sɛ ikɛlɛ katɔ̃,</para>
  <para style="q2" vid="PRO 29:16">ɣɛɛ maturi bɔlɔlɔa nto maanya matilese karɔkɔ̃.<verse eid="PRO 29:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17" />Kpadzɛ̃ fɔ ɔbi iyɔ ɔto ɔ̃atã-ɔ isobuɛ;</para>
  <para style="q2" vid="PRO 29:17">fiɛ ɔ̃apia-ɔ isoɣɔ.<verse eid="PRO 29:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18" />Si Ɣaa kaɖikate na i kaɖe ame ne, kaɖe iisɛ kakososo ku kã nsɛgbai;</para>
  <para style="q2" vid="PRO 29:18">ɣɛɛ so aaɣɔ nwɔ nsɛ ɔmɔɛ̃ mmara ɔla.<verse eid="PRO 29:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19" />Maisɛ masu atɔ̃me kere mayira ɔɖabo;</para>
  <para style="q2" vid="PRO 29:19">alasɔ si ɔnɔkarɔ̃ ana kɔraa ne, ɔ̃ito ɔ̃abara ne.<verse eid="PRO 29:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20" />Ɔriinyɔ pia kadzunisɛĩ ɔɖo ɔturi wɔ loisɛ ɔsɛ iti ame tɔtɔ;</para>
  <para style="q2" vid="PRO 29:20">fiɛ ɔsɛ ɔɖeikaɖe ku sinyatɔ.<verse eid="PRO 29:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21" />Si ɔturi ɔpia ɔ̃ ɔɖabo sibi ta sibiɛtɛ ame ne,</para>
  <para style="q2" vid="PRO 29:21">ɔto ɔ̃abɔ isoma ku kawirikɔ̃.<verse eid="PRO 29:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22" />Ɔturi wɔ nsɛ ɔna sikpã sɛ ɔbɔ kulu</para>
  <para style="q2" vid="PRO 29:22">fiɛ kanasikpaĩ sɛ kabara akpi gbodzoo.<verse eid="PRO 29:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23" />Ɔturi katoikɔlɛso sɛ ibɔ wũ karɔ̃,</para>
  <para style="q2" vid="PRO 29:23">ɣɛɛ karɔ̃ibɔso sɛ ibɔ ɔturi kuwarɛ.<verse eid="PRO 29:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24" />Ɔturi wɔ loya i yukukpe kama ne, ɔsɛ ɔtsiri ɔ̃ mɔmɔ ngbã;</para>
  <para style="q2" vid="PRO 29:24">ɔsɛ ɔwe i ndamu kayirinɔ fiɛ ɔna ɔri ɔwararã sɔ ɔ̃aɣɛ ɔnukuare.<verse eid="PRO 29:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25" />Iturinigã aase lɛ isɛ ikpadzɛ̃ ɔturi ipia i iyebi ame,</para>
  <para style="q2" vid="PRO 29:25">ɣɛɛ ɔturi ɔrere wɔ nsɛ ɔsiaiti i <char style="nd">Bosate</char> iso aawe i kaɣɔ ame.<verse eid="PRO 29:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26" />Maturi gbodzoo sɛ mabie sɔ mabo ɔɖeisoi anɔ,</para>
  <para style="q2" vid="PRO 29:26">ɣɛɛ <char style="nd">Bosate</char> nsɛ ɔɖaɛ itɔ̃me i ɔri iso ɔtã ɔturi.<verse eid="PRO 29:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27" />Maturi bɔlɔlɔa sɛ matsiri mma loisɛ maɖe ɔnukuare;</para>
  <para style="q2" vid="PRO 29:27">matilese sɛ matsiri maturi sɛɛ.<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" sid="PRO 30" />
  <para style="s1">Agur Iwola Simai</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1" />Agur, Yake ɔbibirɛrɛĩ ikpakpatɔ̃me i ngbe ne.</para>
  <para style="q1" vid="PRO 30:1">Agur wɔgbe ɔɣere Itiel,</para>
  <para style="q2" vid="PRO 30:1">Itiel gu Ukal sɔ,<verse eid="PRO 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 30:2" />"Mme nɖe nwɔ isɛ̃iɖo i maturi ndɛ̃;</para>
  <para style="q2" vid="PRO 30:2">lona ara karɔ̃inɔ lɛ ɔturi awune awe.<verse eid="PRO 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3" />Loisuã iwola,</para>
  <para style="q2" vid="PRO 30:3">fiɛ loiɣe kuira i Ɔsekelea iso.<verse eid="PRO 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4" />Kuwɛ̃ iikɛlɛ kato ɔkpese ɔba karɔ̃ ɔnya.</para>
  <para style="q2" vid="PRO 30:4">Kuwɛ̃ iisa ɔwiri kanya ɔpia i ɔ̃ nrɔɔ̃tata ame ɔnya.</para>
  <para style="q1" vid="PRO 30:4">Kuwɛ̃ iinyi ndu ɔɖuɖu ɔpia i ɔ̃ ɔkati ame ɔnya.</para>
  <para style="q2" vid="PRO 30:4">Kuwɛ̃ iisɛra karɔ̃ kuwirikɔ̃ ame ɔɖuɖu.</para>
  <para style="q1" vid="PRO 30:4">Si ɔrere ɔɔbara ara wagbe igbã ne ɣere me ɔ̃ iyere. Si ɔrere ɔɔbara ara wagbe igbã ne ɣere me ɔ̃ ɔbi iyere.</para>
  <para style="q2" vid="PRO 30:4">Ɣere me si aɣe!<verse eid="PRO 30:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5" />"Ɣaa itɔ̃me biara nɛ ɔɣɛ ɖe ɔnukuare.</para>
  <para style="q2" vid="PRO 30:5">Ɔɖe akpiraifɔra ɔtã mma lobara katarikɔ̃ i ɔ̃ kɔrɛ.<verse eid="PRO 30:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6" />Daasu itɔ̃me kuiwɛ̃ abua i ɔ̃ are iso.</para>
  <para style="q2" vid="PRO 30:6">Si iiɖe ngbɔ ne ɔto ɔ̃anyagalagu-ɔ ɔte-ɔ sɔ ladze aɖe.<verse eid="PRO 30:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7" />"Ara anyɔ nto lokarɛ-ɔ, O <char style="nd">Bosate</char>;</para>
  <para style="q2" vid="PRO 30:7">bara wã tã me fiɛ loakpi, wã nɖe sɔ:<verse eid="PRO 30:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8" />Rera iturisɔsɔla gu mila ila kama dzoroo i wũ kɔrɛ.</para>
  <para style="q2" vid="PRO 30:8">Daatã me siwɛrɛba ɣee karana,</para>
  <para style="q2" vid="PRO 30:8">ɣɛɛ tã me wũ ikpɛnɛ araɖea kere.<verse eid="PRO 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9" />Si iiɖe ngbɔ ne, nto loana gbodzoo iyɔ loɔsɛ̃-ɔ</para>
  <para style="q2" vid="PRO 30:9">loɣɛ sɔ, 'Nna nɖe <char style="nd">Bosate</char>?'</para>
  <para style="q1" vid="PRO 30:9">Ɣee loakpese wɛrɛba, losɛ loayu kayu,</para>
  <para style="q2" vid="PRO 30:9">iyɔ loaɣɛra wũ Ɣaa iyere.<verse eid="PRO 30:9" /></para>
  <para style="b" />
  <para style="s1">Agur Agbã</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10" />"Daanina ɔɖabo iyere i ɔ̃ ɔkɔse kɔrɛ.</para>
  <para style="q2" vid="PRO 30:10">Si iiɖe ngbɔ ne, ɔɖabo to ɔ̃agbarĩ-ɔ, fiɛ aafɔ ne kuso.<verse eid="PRO 30:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11" />"Maturi mawɛ̃ pia gɔ masɛ magbarĩ ma mase</para>
  <para style="q2" vid="PRO 30:11">fiɛ maisɛ mafere ma manyi kusɛkusɛ.<verse eid="PRO 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12" />Mma nsɛ mabu so sɔ makpa</para>
  <para style="q2" vid="PRO 30:12">ɣɛɛ maifore ma anyini maɖi.<verse eid="PRO 30:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13" />Mma mpia fiɛ masɛ manyɔ so,</para>
  <para style="q2" vid="PRO 30:13">fiɛ masɛ makɔlɛ ma anɔ manyɔ maturi mama pupurii.<verse eid="PRO 30:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 30:14" />Mma mba anyɛ ɖe atekpe</para>
  <para style="q2" vid="PRO 30:14">fiɛ ma aregba ɖe apɛmi</para>
  <para style="q1" vid="PRO 30:14">wa maasu makɛkɛ mawɛrɛba i karɔ̃ iso</para>
  <para style="q2" vid="PRO 30:14">gu maɣiãni maɖi i maturi awune ndɛ̃.<verse eid="PRO 30:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15" />"Ndutoto ba mabibirɔ̃gomi inyɔ.</para>
  <para style="q2" vid="PRO 30:15">Mato mabiɛ maɣɛ sɔ, "Tã bo! Tã bo!"</para>
  <para style="b" vid="PRO 30:15" />
  <para style="q1" vid="PRO 30:15">"Ara atɛ pia gɔ aisɛ ami kuiyikuiyi.</para>
  <para style="q2" vid="PRO 30:15">Ana wa loisɛ aɣɛ sɔ, 'ka ilɛ!' Wã nɖe:<verse eid="PRO 30:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 30:16" />Ikpibiɔ, ɔlɛma ɔɣekoto,</para>
  <para style="q2" vid="PRO 30:16">karɔ̃ ga loisɛ kami ku ndu</para>
  <para style="q2" vid="PRO 30:16">gu ɔtɔ wɔ loisɛ ɔɣɛ kuiyikuiyi sɔ, 'Ka ilɛ!'<verse eid="PRO 30:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17" />"Inɔmi nɛ nsɛ ibara ɔse aɣiãra,</para>
  <para style="q2" vid="PRO 30:17">fiɛ iisɛ iwarɛ ne ɔnyi ipia i kuira ame ne,</para>
  <para style="q1" vid="PRO 30:17">ne i kagbolomi ame kakparodza aarui kaɖi</para>
  <para style="q2" vid="PRO 30:17">fiɛ akolomo aawe ne ne.<verse eid="PRO 30:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 30:18" />"Ara atɛ pia wa nsɛ abara me ɣaa gbaã,</para>
  <para style="q2" vid="PRO 30:18">ara ana wa loisɛ lonɔkarɔ̃, wã nɖe:<verse eid="PRO 30:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 30:19" />kumɛgɔ i finikpo sɛ ɔfɛrɛrɛ i kuɖokpo ame,</para>
  <para style="q2" vid="PRO 30:19">kumɛgɔ i aɣɛ sɛ asɛ i itasiare iso,</para>
  <para style="q1" vid="PRO 30:19">kumɛgɔ i nduisoibuɛ sɛ isia i ɔpo iso ikɛlɛ,</para>
  <para style="q2" vid="PRO 30:19">gu kumɛgɔ i ɔrɛrɛ̃ gu ɔbitɛ̃ ɔsɛ.<verse eid="PRO 30:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20" />"Kumɛgɔgbe i rãrɔdze sɛ ɔsɛ:</para>
  <para style="q2" vid="PRO 30:20">Ɔsɛ ɔɖe aɖera, ɔnukutu kanya</para>
  <para style="q2" vid="PRO 30:20">iyɔ ɔsɛ ɔɣɛ sɔ, "Loibara ku ira nyanyariã."<verse eid="PRO 30:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 30:21" />"Ara atɛ nsɛ atã karɔ̃ ɔti,</para>
  <para style="q2" vid="PRO 30:21">ara ana ɔɖo kã isore, wã nɖe:<verse eid="PRO 30:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 30:22" />si ɔɖabo ɔkpese igara,</para>
  <para style="q2" vid="PRO 30:22">si kadzunisɛĩ ɔɖe ara ɔmi,<verse eid="PRO 30:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 30:23" />si ɔrɔ̃go wɔ maisɛ maɖɔɛ ɔyiri kurã,</para>
  <para style="q2" vid="PRO 30:23">gu si ɔɖaborɔgomi ɔba ɔ̃afɔ ɔ̃ ɔkɔnyi kasɛkɔ̃.<verse eid="PRO 30:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 30:24" />"Ara ana se tɛmi i karɔ̃ iso,</para>
  <para style="q2" vid="PRO 30:24">ɣɛɛ aɣe iwola gbaã, wã nɖe:<verse eid="PRO 30:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 30:25" />Kubɔibi ɖe ara wa mabara ana ɔle,</para>
  <para style="q2" vid="PRO 30:25">ɣɛɛ kusɛ kusira araɖea kanya kusɛ ku ɔraɖui ɔsɔrɛ̃wi.<verse eid="PRO 30:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 30:26" />Mamiɛĩ ɖe ara wa nna ɔle,</para>
  <para style="q2" vid="PRO 30:26">ɣɛɛ masɛ mabara ma kawekɔ̃ ta ata ndɛ̃;<verse eid="PRO 30:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 30:27" />kugbadzedzei na igara,</para>
  <para style="q2" vid="PRO 30:27">ɣɛɛ ma ɔɖuɖu ɔsɛ isia isia i ma siɖebia ame masakanya.<verse eid="PRO 30:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 30:28" />Ikpalamo ne, aawo ne ɔmɔɛ̃ ku kɔrɔ̃,</para>
  <para style="q2" vid="PRO 30:28">ɣɛɛ isɛ iwe i igaraiyo ame.<verse eid="PRO 30:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 30:29" />"Ara atɛ pia wa nsɛ asɛ sigara ɔsɛ,</para>
  <para style="q2" vid="PRO 30:29">ara ana sɛ asɛ ikɛrɛ ɔsɛ, wã nɖe:<verse eid="PRO 30:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 30:30" />dzata wɔ nɖe kpãrɛrɛĩ i mabɔi ndɛ̃,</para>
  <para style="q2" vid="PRO 30:30">fiɛ ɔ̃isɛ ɔrui ɔtere i kuira kanya;<verse eid="PRO 30:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 30:31" />ikɔle nɛ lowarɛ abue, itekpã,</para>
  <para style="q2" vid="PRO 30:31">igara wɔ i ɔ̃ makpakpɛ̃dze ɔki malɔ wũ.<verse eid="PRO 30:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32" />"Si abara adzunisɛ̃ra fiɛ ato akɔlɛ so kato,</para>
  <para style="q2" vid="PRO 30:32">ɣee si abara adzuni nyanyariã ne,</para>
  <para style="q2" vid="PRO 30:32">lokanana!<verse eid="PRO 30:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33" />Si mapɛ kakpei ɔraũ ne, isɛ ise kpɛ̃kpɛɛkpɛ̃,</para>
  <para style="q2" vid="PRO 30:33">fiɛ si manyɛdɛ̃ ɔɣɔ̃ teteree ne, ima nsɛ ibɔrɛ.</para>
  <para style="q2" vid="PRO 30:33">Ne ɔso si mapia sikpã lala ne isɛ ibɔ kulu."<verse eid="PRO 30:33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" sid="PRO 31" />
  <para style="s1">Matã Igara Ɔwɛ̃ Kuka</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1" />Nwagbe nɖe atɔ̃me wa i Igara Lemuel, Masa igara - ikpakpatɔ̃me nɛ ɔsuã ɔbɔrɛgu i ɔ̃ ɔnyi kɔrɛ ne.<verse eid="PRO 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2" />"O, wũ ɔbi! O, wũ kayiri ame ɔbi,</para>
  <para style="q2" vid="PRO 31:2">O, wũ ndamu ɔbi!<verse eid="PRO 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 31:3" />Daasu fɔ ɔle asiai marɔ̃go,</para>
  <para style="q2" vid="PRO 31:3">daasu fɔ sirɛrɛ̃ atã mma nsɛ mawɔra magara.<verse eid="PRO 31:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4" />"O, Lemuel! Iiɖe magara ɔkpɛ ɔɖe i mmɔ -</para>
  <para style="q2" vid="PRO 31:4">wain inɛ iilɛ itã magara,</para>
  <para style="q2" vid="PRO 31:4">ɔɖeisoi iisɛ ɔbie ndã kpokporoa.<verse eid="PRO 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5" />Si iiɖe ngbɔ, si ɔnɛ me ne, ɔto ɔ̃aɣara mmara,</para>
  <para style="q2" vid="PRO 31:5">fiɛ ɔto ɔ̃afirikira mma mato mawedza inyɛ ɔɖuɖu atɔ̃me sɔ aiya.<verse eid="PRO 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6" />Mitã mma nto mawɔ ndã kpokporoa;</para>
  <para style="q2" vid="PRO 31:6">mitã mma nsɛ mana ibo gu ibɛbɛrɛ wain.<verse eid="PRO 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7" />Mitã manɛ si maɣara ma siwɛrɛba,</para>
  <para style="q2" vid="PRO 31:7">manɛ si maisibanyigi ma inyɛwe ana.<verse eid="PRO 31:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8" />"Ɖeika tã mma loisɛ mawo ika ɔɖe kanya,</para>
  <para style="q2" vid="PRO 31:8">ɖeika si afɔ, maturi ɔɖuɖu ma nna kuira gu buaidze kanya.<verse eid="PRO 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9" />Ɖeika si aɖaɛ itɔ̃me i ɔri wɔ loya iso;</para>
  <para style="q2" vid="PRO 31:9">si afɔ mawɛrɛba gu maɣiãni kanya."<verse eid="PRO 31:9" /></para>
  <para style="b" />
  <para style="s1">Ɔre Ku Nsɛgbai Sɛɛ</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 31:10" />Nna loana ɔre sɛɛ ku iwobara?</para>
  <para style="q2" vid="PRO 31:10">Ɔfɔ kuɣa fafaafã ɔɖo ita nɛ lofɔ kuɣa.<verse eid="PRO 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11" />Ɔ̃ ɔrã sɛ ɔsiaiti pelepele i ɔ̃ ɔre iso</para>
  <para style="q2" vid="PRO 31:11">fiɛ kuira sɛɛ iisɛ inya wũ.<verse eid="PRO 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12" />Ɔsɛ ɔbara isɛɛ ɔtã ɔrɛrɛ̃, iiɖe iraboa,</para>
  <para style="q2" vid="PRO 31:12">i ɔ̃ agbanayi ɔɖuɖu ame.<verse eid="PRO 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13" />Ɔsɛ ɔbie sɛrɛrerɔ̃ siwɛrɛ̃ gu ɖɔti</para>
  <para style="q2" vid="PRO 31:13">fiɛ ɔsɛ ɔsu ɔ̃ nrɔɔ̃ ɔbara karabara ku isoɣɔ.<verse eid="PRO 31:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14" />Ɔse lɛ kuɣamaɖese nduisoibuɛ awe,</para>
  <para style="q2" vid="PRO 31:14">fiɛ ɔsɛ ɔkpadzɛ̃ araɖea ɔbɔrɛgu i kudzorokɔ̃ ɔbɔ.<verse eid="PRO 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15" />Ɔsɛ ɔrɛ ɔta mala fiɛ kaɖe sɛ kasɛ̃.</para>
  <para style="q2" vid="PRO 31:15">Ɔsɛ ɔtã ɔ̃ iyomaturi aɖera</para>
  <para style="q2" vid="PRO 31:15">fiɛ ɔsɛ ɔtã ɔ̃ maɖaborɔ̃gomi ma aɖera.<verse eid="PRO 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16" />Ɔsɛ ɔbara adzuni ɔbie kakpɛrɔ̃ ɔɣa;</para>
  <para style="q2" vid="PRO 31:16">fiɛ ɔsɛ ɔsu sikã dzɛ ɔna i ɔ̃ karabara ame, ɔkpɛ̃ kamɔwĩ.<verse eid="PRO 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17" />Ɔsɛ ɔbara ɔ̃ karabara ku ɔle;</para>
  <para style="q2" vid="PRO 31:17">fiɛ ɔsɛ ɔpia ɔ̃ nrɔɔ̃ ɔle ɔtã karabara.<verse eid="PRO 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18" />Ɔsɛ ɔnyɔ sɔ ɔ̃ kuɣaiɖe sɛ ibɔ wũ kusia.</para>
  <para style="q2" vid="PRO 31:18">Ɔ̃ ɔkaniɛ iisɛ ɔnyi ku kasɛ̃.<verse eid="PRO 31:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19" />Ɔsɛ ɔmɔɛ̃ ɔdziri wɔ iso mapia ɖɔti</para>
  <para style="q2" vid="PRO 31:19">fiɛ ɔsɛ ɔmɔɛ̃ katara ku arɔĩ ana.<verse eid="PRO 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20" />Ɔsɛ ɔbusi kɔrɔ̃ ame ɔtã mawɛrɛba</para>
  <para style="q2" vid="PRO 31:20">fiɛ ɔsɛ ɔbuai maɣiãni.<verse eid="PRO 31:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21" />Ɔ̃isɛ ɔnigã i ɔ̃ iyomaturi iso si ɔyu pia,</para>
  <para style="q2" vid="PRO 31:21">alasɔ ma ɔɖuɖu sɛ mafu so kundu wɔ lofɔ kuɣa.<verse eid="PRO 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22" />Ɔsɛ ɔbara ɔ̃ karɛkɔ̃ iso sikati;</para>
  <para style="q2" vid="PRO 31:22">fiɛ ɔsɛ ɔpia akalala gu ɔgo sikati lɛ igara arapia.<verse eid="PRO 31:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23" />Maturi sɛ mawarɛ ɔ̃ ɔrã i itiri,</para>
  <para style="q2" vid="PRO 31:23">ngbegɔ ɔsɛ ɔsɛ i karɔ̃ i karɔ̃ kaɖe makpakpa ndɛ̃.<verse eid="PRO 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24" />Ɔsɛ ɔkã akalala ara ɔrɔdɛ̃,</para>
  <para style="q2" vid="PRO 31:24">fiɛ ɔsɛ ɔrɔdɛ̃ sisɔnyira ɔtã kuɣamaɖese.<verse eid="PRO 31:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25" />Ɔba ɔle fiɛ ɔɣɛ teteree ku ɔ̃ nsegbai gu kuwarɛ;</para>
  <para style="q2" vid="PRO 31:25">ayi wa nto aba ɖe sima i ɔ̃ kɔrɛ.<verse eid="PRO 31:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26" />Ɔsɛ ɔɖeika ku iwola,</para>
  <para style="q2" vid="PRO 31:26">fiɛ ɔnukuare araite pia i ɔ̃ ɔnyagɛmi iso.<verse eid="PRO 31:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27" />Ɔsɛ ɔrara anɔmi ɔnyɔ ara kuseme i ɔ̃ iyo ame</para>
  <para style="q2" vid="PRO 31:27">fiɛ ɔ̃isɛ ɔbara ndã.<verse eid="PRO 31:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28" />Ɔ̃ mabi sɛ mata makpere wũ sɔ, kusɛkusɛ ɔturi;</para>
  <para style="q2" vid="PRO 31:28">ɔ̃ ɔrã ana sɛ ɔkpere wũ ngbɔ ame fiɛ ɔsɛ ɔle wũ ɔɣɛ sɔ,<verse eid="PRO 31:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29" />"Marɔ̃go gbodzoo pia mma nsɛ mabara ara sɛɛ wa lobo anɔ;</para>
  <para style="q2" vid="PRO 31:29">ɣɛɛ fɔ ne, aɖe ma ɔɖuɖu iso."<verse eid="PRO 31:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30" />Situriire ne, kasɔla iɖe fiɛ kulɛ ne, ira siefe iɖe;</para>
  <para style="q2" vid="PRO 31:30">ɣɛɛ ɔrɔ̃go wɔ nsɛ ɔnigã <char style="nd">Bosate</char> ne, ilɛ sɔ maale wũ.<verse eid="PRO 31:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31" />Mitã wũ ɔ̃ karabara kuso,</para>
  <para style="q2" vid="PRO 31:31">si male wũ i itiri ala karabara ga ɔbara iti.<verse eid="PRO 31:31" /></para>
  <chapter eid="PRO 31" />
</usx>