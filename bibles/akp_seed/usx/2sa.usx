<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2SA" style="id">- Siwu Old Testament</book>
  <para style="h">2 SAMUEL</para>
  <para style="toc1">2 SAMUEL</para>
  <para style="toc2">2 Samuel</para>
  <para style="toc3">2 Sa</para>
  <para style="mt1">SAMUEL</para>
  <para style="mt2">ƆKO NYƆARE</para>
  <para style="imt">ATƆ̃MEƉEAKATƆ̃</para>
  <para style="ip">
    <char style="bk">Samuel Ɔko Nyɔare</char> ɖe nwɔ lokɛlɛgu Samuel <char style="bk">Ɔko Ɖeakatɔ̃ katɔ̃</char>. Ɔɖe nwɔ loɖeika i David iɖeiso lɛ igara arabafetɔ̃me iso. Iɖeakatɔ̃ ɔ̃ iɖeiso i Yuda i kala iso (Iti1-4) gu isegu ɔ̃ iɖeiso i Kaɖe ɔɖuɖu iso, ibua i Israel i kato (Iti 5-24). Iɖe atɔ̃me wa lose i David iso kukaakɔ ku kumɛgɔ ɔkpɛ̃gu matsirise i kaɖe ame gu mafɔ nrɔ̃ sile si ɔsu ɔmɔdza ɔ̃ sigarakaɖekɔ̃ si ɔsɛra so teteree i ɔ̃ siɖebia kanya. Maɖi mate sɔ David ɔɖe ɔrɛrɛ̃ wɔ lowe kafɔkaɖe wodoroa fiɛ ɔsumu Ɣaa. Ana ne ɔɖe ɔturi wɔ lotã ɔ̃ maturi ɔfɔ wũ maɖe. Ɣɛɛ ɔwi ɔmɔi ne maɖi mate sɔ ɔɖe ɔturi wɔ lowe amumuɣɔ gbaã fiɛ ɔbie sɔ ɔbara aranyanyariã si ɔsu ɔmidza so ala ɔ̃ mɔmɔ kubie gu nnɛ ɔto ɔnyɔ ɔri ɔtã iti. Ɣɛɛ ɔwi ɔrere wɔ i <char style="nd">Bosate</char> kanyaɖidze Natan ɔɖi ɔ̃ ikpi ɔsɛ wũ i anɔ ne, ɔsɛ ɔɖi ɔ̃ ikpi ɔɣɛ fiɛ ɔsɛ ɔfɔ kutsueikpadzɛ̃ nɛ Ɣaa sɛ ɔsese.</para>
  <para style="ip">David ngbã gu ara wa ɔbara ɔbo Israel maturi anɔ gbaã sɔ kama kama gɔ i kaɖe ɔwe i imɔrɛ̃ ame, fiɛ mabie igara mama ne, ɔɖe ɔwɛ̃ wɔ loaɖe "David ɔbi", ne nɖe sɔ ɔ̃aɖe David ɔkparɛ wɔ loase lɛ ɔ̃ awe.</para>
  <para style="iot">Kumɛgɔ maɣɛ ɔko</para>
  <para style="io1">David ɔɖe sigara i Yuda iso (1.1-4.12)</para>
  <para style="io1">David ɔɖe sigara i Israel ɔɖuɖu iso (5.1-24.25)</para>
  <para style="io2">Akɔ ɖeakatɔ̃ (5.1-10.19)</para>
  <para style="io2">David gu Batseba (11.1-12.25)</para>
  <para style="io2">Anyɛwe gu Amɔrɛã (12.26-20.26)</para>
  <para style="io2">Kama kama akɔ ame (21.1-24.25)</para>
  <chapter number="1" style="c" sid="2SA 1" />
  <para style="s1">David Ɔnɔ Saul Kukpi</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 1:1" />I Saul kukpi kama ne, David ɔbɔrɛ i kakpã ga ame ɔɖe ma Amalekse iso ɔkpese ɔkɛlɛ Ziklag, ngbegɔ ɔwe ayi anyɔ. <verse eid="2SA 1:1" /><verse number="2" style="v" sid="2SA 1:2" />Ikpɛnɛ tɛare iso ne, ɔrɛrɛ̃ ɔwɛ̃ ɔtere ɔbɔrɛ i Saul kasɛkɔ̃, ɔ̃ awu ɔkɛkɛ fiɛ ɔsebu ɔwe wũ i iti. Gɔ ɔba ɔ̃abo David kɔrɛ ne, ɔkɛlɛ ɔrɛ i karɔ̃ i kuwarɛ ame.<verse eid="2SA 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 1:3" />Ne David ɔkarɛ wũ sɔ, "Lɛ abɔrɛ?"</para>
  <para style="p" vid="2SA 1:3">Ne ɔtã mmuai sɔ, "Lotere lobɔrɛ i Israel mabi kasɛkɔ̃."<verse eid="2SA 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 1:4" />David ɔkarɛ wũ sɔ, "Ɣere me, be lobɔrɛ?"</para>
  <para style="p" vid="2SA 1:4">Ne ɔtã mmuai sɔ, "Marɛrɛ̃ ɔtere i kakpã katɔ̃. Maturi gbodzoo ɔrɔ̃ kakpã. Ana ne Saul gu ɔ̃ ɔbi Yonatan ɔkpi."<verse eid="2SA 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 1:5" />Ne David ɔkarɛ ɔporoporoi wɔ loba ɔ̃aɣere wũ itɔ̃me sɔ, "Nda abara atsue sɔ Saul gu ɔ̃ ɔbibirɛrɛĩ Yonatan ɔkpi?"<verse eid="2SA 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 1:6" />Ne ɔporoporoi ɔtã mmuai sɔ, "Iba sɔ lowe i Gilboa kube iso fiɛ lonya Saul kumɛgɔ i ɔpiɛtɛ i ɔ̃ ifele iso, makpakpɛ̃dze ma nsi i abuɛ wa i apɔngɔ sɛ akpadzɛ̃ iso ɔɔro ɔki malɔ wũ. <verse eid="2SA 1:6" /><verse number="7" style="v" sid="2SA 1:7" />Gɔ ɔfiriki fiɛ ɔnya me ne, ɔkpere me, ne lokarɛ wũ sɔ, 'Lotã-ɔ iti be si lobara lotã-ɔ?'<verse eid="2SA 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 1:8" />"Ɔkarɛ me sɔ, 'Fɔ nɖe nna?'</para>
  <para style="p" vid="2SA 1:8">Lotã wũ mmuai sɔ, " 'Amalekse loɖe.'<verse eid="2SA 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 1:9" />"Ɔɣere me sɔ, 'Ba ya i wũ kɔrɛ i ngbe si aɖoe me! Lopia i kukpi ibo teteree ame ɣɛɛ lopia ngbã.'<verse eid="2SA 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 1:10" />"Ne ɔso lobore lobo wũ loɖoe wũ alasɔ lotsue sɔ gɔ ɔ̃ɔrɔ̃ ne, ɔ̃isibana ngbã. Losisi ɔ̃ sigaraikoto nɛ nsia wũ i iti gu kagɔrɔĩ ga mpia wũ i kɔrɔ̃ lobɔ-ɔ i ngbe, wũ sate."<verse eid="2SA 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 1:11" />Kere ne David gu marɛrɛ̃ ma ɔɖuɖu mpia wũ i kɔrɛ ɔmɔɛ̃ ma awu makɛkɛ ne. <verse eid="2SA 1:11" /><verse number="12" style="v" sid="2SA 1:12" />Mabara kaku, mabiɛ fiɛ manyikanya isɛ iabo kutsuɛ matã Saul gu ɔ̃ ɔbi Yonatan, gu <char style="nd">Bosate </char> makpakpɛ̃dze gu Israel iyo alasɔ marɔ̃ kakpã i ipɛmi kanya.<verse eid="2SA 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 1:13" />Ne David ɔkarɛ ɔporoporoi wɔ losu itɔ̃me ɔbɔ wũ sɔ, "Lɛ abɔrɛ?"</para>
  <para style="p" vid="2SA 1:13">Ne ɔtã mmuai sɔ, "Ɔfɔ loɖe, ɔ Amalekse loɖe."<verse eid="2SA 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 1:14" />Ne David ɔkarɛ wũ sɔ, "Be ɔso ainigã sɔ aakɔlɛ fɔ kɔrɔ̃ aɖoe nwɔ i <char style="nd">Bosate</char> ɔsɔla nnɔĩ?"<verse eid="2SA 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 1:15" />Ne David ɔkpere ɔ̃ kpãrɛrɛĩ ɔwɛ̃ ɔɣere wũ sɔ, "Kɛlɛ aatsue wũ ira aɖoe!" Ne ɔtsue wũ ira fiɛ ɔkpi ne. <verse eid="2SA 1:15" /><verse number="16" style="v" sid="2SA 1:16" />Ala David ɔɔɣere wũ sɔ, "Fɔ kɔrɔ̃ ame ɔdziri lotsue-ɔ, Fɔ mɔmɔ losu fɔ kanya aɣɛ sɔ, 'Loɖoe nwɔ i <char style="nd">Bosate</char> ɔsɔla nnɔĩ.' "<verse eid="2SA 1:16" /></para>
  <para style="s1">David Ɔbiɛ Saul Gu Yonatan</para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 1:17" />Ne David ɔpia ɔnɔ wɔgbe i Saul gu ɔ̃ ɔbibirɛrɛĩ Yonatan iso, <verse eid="2SA 1:17" /><verse number="18" style="v" sid="2SA 1:18" />ɔɣɛ sɔ mate Yuda marɛrɛ̃ kuta isomanɔ wɔgbe, (matsɛrɛ wũ mapia i Yasar Ɔko ame) sɔ:<verse eid="2SA 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="2SA 1:19" />"Fɔ kulɛ, O Israel maɖoe marara i abe atititɛ̃.</para>
  <para style="q2" vid="2SA 1:19">Nda i makpãrɛrɛĩ ɔrɔ̃ kakpã ngbɔ!<verse eid="2SA 1:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="2SA 1:20" />"Midaaɣɛ ne i Gat,</para>
  <para style="q2" vid="2SA 1:20">midaapɛ ne imomo i Askelon,</para>
  <para style="q1" vid="2SA 1:20">si iiɖe ngbɔ so to siaɣɔ ma Filistise mabibirɔ̃gomi,</para>
  <para style="q2" vid="2SA 1:20">si iiɖe ngbɔ mma loitu sirɛrɛ̃ mabibirɔ̃gomi to maana isoɣɔ.<verse eid="2SA 1:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="2SA 1:21" />"O Gilboa abe,</para>
  <para style="q2" vid="2SA 1:21">midaarɔ̃ ima, fiɛ kado si ɔdaapɛ ɔfere mi iso,</para>
  <para style="q2" vid="2SA 1:21">ɣee midaawe karɔ̃ ga iso i geɖebu ɔraɖui aalɛ.</para>
  <para style="q1" vid="2SA 1:21">Alasɔ mmɔ manina makpãrɛrɛĩ akpirafɔra ne,</para>
  <para style="q2" vid="2SA 1:21">Saul akpiraifɔra, maisisɔla ne nnɔĩ.<verse eid="2SA 1:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="2SA 1:22" />Ibɔrɛ i mma maɖoe ima ame,</para>
  <para style="q2" vid="2SA 1:22">makpãrɛrɛĩ siturina ame,</para>
  <para style="q1" vid="2SA 1:22">Yonatan kuta iisikpese kama,</para>
  <para style="q2" vid="2SA 1:22">Saul itekpe iikpese kama iimi.<verse eid="2SA 1:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="2SA 1:23" />"Saul gu Yonatan -</para>
  <para style="q2" vid="2SA 1:23">i ngbã ame ne, maɖɔɛ ma fiɛ i ngbã ame ne mapia maturi isoɣɔ,</para>
  <para style="q2" vid="2SA 1:23">maisame i kukpi ame kɔraa.</para>
  <para style="q1" vid="2SA 1:23">Masɛ mapɛsiwa maɖo kukpekpeyu,</para>
  <para style="q2" vid="2SA 1:23">mawe ɔle maɖo madzata.<verse eid="2SA 1:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="2SA 1:24" />"O Israel mabibirɔ̃gomi,</para>
  <para style="q2" vid="2SA 1:24">mibiɛ Saul,</para>
  <para style="q1" vid="2SA 1:24">wɔ lopia mi ɔkati rɛtɛa ɖɔbɔrɔa gu arapia sɛɛ,</para>
  <para style="q2" vid="2SA 1:24">nwɔ losu sikãrɛtɛa ara ɔkɛrɛ mi i mi arapia iso.<verse eid="2SA 1:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="2SA 1:25" />"Nyɔ kumɛgɔ i makpãrɛrɛĩ ɔrɔ̃ kakpã!</para>
  <para style="q2" vid="2SA 1:25">Yonatan ɔrɔ̃ kakpã i fɔ kube iso.<verse eid="2SA 1:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="2SA 1:26" />Loto lobiɛ-ɔ, wũ ɔnyiibi Yonatan;</para>
  <para style="q2" vid="2SA 1:26">loisɛ lopia-ɔ kuɣɛ.</para>
  <para style="q1" vid="2SA 1:26">Fɔ kuɖɔɛ gɔ aba atã me ɔwodoro,</para>
  <para style="q2" vid="2SA 1:26">kuwodoro kuɖo marɔ̃go kuɖɔɛ.<verse eid="2SA 1:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="2SA 1:27" />"Nyɔ kumɛgɔ i makpãrɛrɛĩ ɔrɔ̃ kakpã!</para>
  <para style="q2" vid="2SA 1:27">Kakpã akpɛ̃ra ɔwɔ!"<verse eid="2SA 1:27" /></para>
  <chapter eid="2SA 1" />
  <chapter number="2" style="c" sid="2SA 2" />
  <para style="s1">Masɛra David Sigara I Yuda</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 2:1" />I Saul gu Yonatan kukpi kama ne, David ɔkarɛ <char style="nd">Bosate</char> sɔ, "Loya lokɛlɛ Yuda ɔmagɛ̃ ɔwɛ̃ ame?"</para>
  <para style="p" vid="2SA 2:1">Ne <char style="nd">Bosate</char> ɔɣere wũ sɔ, "Ya kɛlɛ."</para>
  <para style="p" vid="2SA 2:1">Ne David ɔkarɛ sɔ, "Lɛ si lokɛlɛ?"</para>
  <para style="p" vid="2SA 2:1">Ne <char style="nd">Bosate</char> ɔɣere wũ sɔ, "Kɛlɛ Xebron."<verse eid="2SA 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 2:2" />Ne ɔso David ɔya ɔkɛlɛ Xebron ku ɔ̃ mare inyɔ ɔɖuɖu, Axinoam wɔ lobɔrɛ i Yezrel gu Abigail wɔ loɖe Nabal, Karmelse wɔ loɔkpi ɔre. <verse eid="2SA 2:2" /><verse number="3" style="v" sid="2SA 2:3" />Ɔkɔ marɛrɛ̃ ma lowegu wũ, ɔbiara gu ɔ̃ iyomaturi masɛ maasɛ i Xebron gu simagɛ̃ dzɛ loki silɔ mmɔ ame. <verse eid="2SA 2:3" /><verse number="4" style="v" sid="2SA 2:4" />Ne Yuda marɛrɛ̃ ɔba Xebron maba maasɔla David nnɔĩ sɔ ɔɖe sigara i Yuda iyo iso ne.</para>
  <para style="p" vid="2SA 2:4">Gɔ maɣere David sɔ Yabes Gilead marɛrɛ̃ lobiara Saul ne, <verse eid="2SA 2:4" /><verse number="5" style="v" sid="2SA 2:5" />David ɔpia makpabo Yabes Gilead marɛrɛ̃ kɔrɛ sɔ masɛ maaɣere ma sɔ, "<char style="nd">Bosate</char> si ɔfere mi kusɛkusɛ ala kayiribielea ga miɖi mite mi ɔkɔse Saul gɔ mibiara wũ ɔso. <verse eid="2SA 2:5" /><verse number="6" style="v" sid="2SA 2:6" />Kiniɔ ne, <char style="nd">Bosate</char> si ɔnyɔ mi nnya ɔɖe ɔnukuare ɔtã mi, fiɛ mme wũ mi ara aabo me anɔ ngbɔ ala nnɛ mibara ɔso. <verse eid="2SA 2:6" /><verse number="7" style="v" sid="2SA 2:7" />Kiniɔ ne, mina ɔtu si miwe kagbegbe alasɔ mi ɔkɔse Saul ɔɔkpi, fiɛ Yuda maturi ɔɔsɛra me sigara."<verse eid="2SA 2:7" /></para>
  <para style="s1">Masɛra Isboset Sigara I Israel</para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 2:8" />Ɣɛɛ i ɔwi wɔgbe ame ne Abner wɔ nɖe Ner ɔbibirɛrɛĩ fiɛ ɔɖe Saul makpakpɛ̃dze ɔkpakpa ɔkɔ Saul ɔbibirɛrɛĩ Isboset ɔkɛlɛgu Maxanayim. <verse eid="2SA 2:8" /><verse number="9" style="v" sid="2SA 2:9" />Ɔsɛra wũ sigara i Gilead gu Asuri gu Yezreel, i Efrayim ana gu Benyamin gu Israel ɔɖuɖu iso.<verse eid="2SA 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 2:10" />Isboset wɔ loɖe Saul ɔbibirɛrɛĩ ɔfɔ akɔ sina fiɛ masɛra wũ sigara i Israel, fiɛ ɔɖe sigara akɔ anyɔ. Yuda iyo ɣɛɛ ne, masiai David. <verse eid="2SA 2:10" /><verse number="11" style="v" sid="2SA 2:11" />David ɔɖe sigara i Xebron i Yuda iyo iso akɔ akɔdzɛ gu awa akuɔ.<verse eid="2SA 2:11" /></para>
  <para style="s1">Kakpã Ga Loba I Israel Gu Yuda Ndɛ̃</para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 2:12" />Iyi iwɛ̃ ne, Abner wɔ nɖe Ner ɔbibirɛrɛĩ gu Isboset wɔ nɖe Saul ɔbibirɛrɛĩ makpakpɛ̃dze ɔbɔrɛ i Maxanayim makɛlɛ Gibeon. <verse eid="2SA 2:12" /><verse number="13" style="v" sid="2SA 2:13" />Yoab wɔ ɔnyi loɖe Zeruya gu David makpakpɛ̃dze ɔbɔrɛ masɛ maasarɛgu ma i Gibeon ibu kanya. Ikuri iwɛ̃ ɔsɛ i ibu kasɛ kawɛ̃, mma ana ɔsɛ i kasɛ nyɔare.<verse eid="2SA 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 2:14" />Ne Abner ɔɣere Yoab sɔ, "Tã botã maporoporoi ɔgba si mate ma sirɛrɛ̃ i bo anɔ."</para>
  <para style="p" vid="2SA 2:14">Ne Yoab ɔtã mmuai sɔ, "Ilɛ, tã ma ɔri."<verse eid="2SA 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 2:15" />Ne ɔso mata maya ne maka marɛrɛ̃ iweo-inyɔ maɖi i Benyamin gu Isboset, Saul ɔbibirɛrɛĩ kasɛ fiɛ maka iweo-inyɔ ana maɖi i David kasɛ. <verse eid="2SA 2:15" /><verse number="16" style="v" sid="2SA 2:16" />Ma ɔbiara ɔmɔɛ̃ ɔ̃ ɔlaa i iti, ɔtsue wũ itekpe i iwãgɛsɛ ne ma ɔɖuɖu ɔrɔ̃ makpi ne. Ne ɔso masɛ marɔ mmɔ i Gibeon sɔ Xelkat-xazurim.<note caller="+" style="f"><char style="fr" closed="false">2.16 </char><char style="ft" closed="false">Xelkat-xazurim: Atekpe karɔ̃</char></note><verse eid="2SA 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 2:17" />Kakpã ga losiai ɔwe ɔle ku iyi nɛmɔ, David makpakpɛ̃dze ɔɖe Abner gu Israel makpakpɛ̃dze iso.<verse eid="2SA 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 2:18" />Zeruya mabibirɛrɛĩ itɛ ɔɖuɖu ɔwe i mmɔ ma nɖe Yoab, Abisai gu Asaxel. Asaxel ɔla ɔ̃atere ise lɛ kasɔlɔ. <verse eid="2SA 2:18" /><verse number="19" style="v" sid="2SA 2:19" />Asaxel ɔtere ɔsiai Abner gɔ ɔ̃imani ɔki i kuɖearɔ̃ ɣee kubena.<verse eid="2SA 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 2:20" />Abner ɔfiriki ɔnyɔ wũ ne ɔkarɛ sɔ, "Fɔ aɖe i mmɔ, Asaxel?"</para>
  <para style="p" vid="2SA 2:20">Ne ɔtã mmuai sɔ, "Mme loɖe."<verse eid="2SA 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 2:21" />Ne Abner ɔɣere wũ sɔ, "Firiki kɛlɛ kuɖearɔ̃ ɣee kubena iso, tere siai ɔporoporoi mama i kama si aɖoe wũ afɔ ɔ̃ akpakpɛ̃ra bowũ." Ɣɛɛ Asaxel iikpese itere isiai wũ i kama.<verse eid="2SA 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 2:22" />Abner ɔledza isɛ̃ itã Asaxel sɔ, "Kpese me i kama, si atã loɖoe-ɔ ne, loibawo fɔ nyiibi Yoab ɔnyɔ i katɔ̃."<verse eid="2SA 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 2:23" />Ɣɛɛ Asaxel ɔsɛ̃ sɔ ɔ̃ibakpese, ne ɔso Abner ɔsu ɔ̃ ifele ɔdziri ɔtuĩ wũ i kayiri ɔbɔrɛ wũ i kama ɔbɔrɛ ɔrɔ̃ i mmɔ ɔkpi ɔluwɛ̃. Si kpakpɛ̃dze biara ɔbo ngbegɔ i Asaxel ɔrɔ̃ kakpã ne, ɔtuĩ.<verse eid="2SA 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 2:24" />Ɣɛɛ Yoab gu Abisai ɔtere masiai Abner fiɛ gɔ kuɣɛ̃ ka kuto kubo iyo ne, maba maabo Amma kabemi iso i Gia kɔrɛ i ɔri wɔ nkpa Gibeon karɔ̃kpia iso. <verse eid="2SA 2:24" /><verse number="25" style="v" sid="2SA 2:25" />Benyamin makpakpɛ̃dze ɔki maya Abner i kama. Mapɛ ibo mamini Abner i kabemi itititɛ̃.<verse eid="2SA 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 2:26" />Ne Abner ɔkpere Yoab ɔɣɛ sɔ, "Ipɛmi si iwɔra maturi kayi daaro? Aito atsue sɔ nnɛgbe to iawiri i kaɖo ame ɣɛɛ? Ku me ɔwi aaɣere fɔ makpakpɛ̃dze sɔ makpese i ma manyii Israel mabi i kama?"<verse eid="2SA 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 2:27" />Ne Yoab ɔtã mmuai sɔ, "Lotarĩgu Ɣaa sɔ si adaakpere me ne, tee wũ makpakpɛ̃dze aatere masiai ma gbɔgbɔɔgbɔ kaɖe aasɛ̃."<verse eid="2SA 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 2:28" />Ne ɔso Yoab ɔfɛ̃ kadadã, ne makpakpɛ̃dze ɔɖuɖu ɔtuĩ fiɛ maisitere masiai ma manyii Israel mabi ɣee makpɛ̃gu ma.<verse eid="2SA 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 2:29" />Kasɛ̃ gamɔ ɔɖuɖu ne, Abner gu ɔ̃ makpakpɛ̃dze ɔsɛ maki i Araba, mawara Yordan ɔwore masɛ makɛlɛ i katɔ̃ maki i Bitron ɔɖuɖu ka masɛ maabo Maxanayim.<verse eid="2SA 2:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 2:30" />Ne Yoab ɔkpese Abner i kama fiɛ ɔsa makpakpɛ̃dze kanya ne. Asaxel kama ne, David makpakpɛ̃dze iweo-kaiwɛ̃ loyu. <verse eid="2SA 2:30" /><verse number="31" style="v" sid="2SA 2:31" />Ɣɛɛ David makpakpɛ̃dze ɔɖoe ma Benyaminse alafa atɛ gu sikuɔ ma lowegu Abner. <verse eid="2SA 2:31" /><verse number="32" style="v" sid="2SA 2:32" />Masu Asaxel kpise masɛ maabiara i ɔ̃ ɔse ikpibiɔ ame i Betlehem. Ne Yoab gu ɔ̃ maturi ɔsɛ kasɛ̃ ɔɖuɖu masɛ maabo Xebron ku ɔɖesɛrã ne.<verse eid="2SA 2:32" /></para>
  <chapter eid="2SA 2" />
  <chapter number="3" style="c" sid="2SA 3" />
  <para style="p">
    <verse number="1" style="v" sid="2SA 3:1" />Kakpã ɔwe i Saul iyo gu David iyo ndɛ̃ igu ɔfɔ ɔwi ɔdzoro. David iyo ɔla iɔwe ɔle ibua, ɣɛɛ Saul iyo ɔle ɔla karɔ̃ iba.<verse eid="2SA 3:1" /></para>
  <para style="s1">David Mabibirɛrɛĩ Ma Ɔɣe I Xebron</para>
  <para style="li1">
    <verse number="2" style="v" sid="2SA 3:2" />Maɣe mabibirɛrɛĩ matã David i Xebron:</para>
  <para style="li2" vid="2SA 3:2">Ɔ̃ ɔbi ɖeakatɔ̃ loɖe Amnon, ɔbirɛrɛĩ wɔ i Axinoam wɔ lobɔrɛ i Yezrel ɔɣe;<verse eid="2SA 3:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="2SA 3:3" />Ɔbirɛrɛĩ nyɔare loɖe Kileab wɔ i Abigail, Nabal wɔ lobɔrɛ i Karmel kpise ɔre ɔɣe;</para>
  <para style="li1" vid="2SA 3:3">Ɔtɛare loɖe Absalom wɔ i Maaxa, Gesur igara Talmai ɔbibirɔ̃gomi ɔɣe;<verse eid="2SA 3:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="2SA 3:4" />Ɔnaare loɖe Adoniya wɔ i Xagit ɔɣe;</para>
  <para style="li1" vid="2SA 3:4">ɔruva nɖe Sefatya wɔ i Abital ɔɣe;<verse eid="2SA 3:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="2SA 3:5" />fiɛ ɔkuɔva nɖe Itream wɔ i David ɔre Egla ɔɣe ɔtã wũ.</para>
  <para style="b" vid="2SA 3:5" />
  <para style="li4" vid="2SA 3:5">Mabibirɛrɛĩ magbe maɣe matã David i Xebron ne.<verse eid="2SA 3:5" /></para>
  <para style="s1">Abner Ɔwara Ɔkɛlɛ David Kɔrɛ</para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 3:6" />Ɔwi wɔ i kakpã to i Saul iyo gu David iyo ndɛ̃ ne, Abner ɔ̃ wũ ɔla ɔ̃ɔɣedza ɔ̃ mɔmɔ siɖebia i karɔ̃ i Saul iyo. <verse eid="2SA 3:6" /><verse number="7" style="v" sid="2SA 3:7" />Saul ɔwe ɔsɔrɔ̃ ɔwɛ̃ wɔ marɔ Rizpa fiɛ ɔɖe Aya ɔbibirɔ̃gomi. Iyi iwɛ̃ ne, Isboset ɔkarɛ Abner sɔ, "Be ɔso arɛgu wũ ɔse ɔsɔrɔ̃?"<verse eid="2SA 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 3:8" />Sikpã ɔmɔɛ̃ Abner gbaã i nnɛ i Isboset ɔkarɛ wũ ɔso, ne ɔso ɔkarɛ wũ sɔ, "Abu sɔ nwɔ loisɛ loɖe ɔnukuare lɛ kpɛkpɛ loɖe i Yuda iyo kasɛ? Ipɛ i nɔme ne, losu so lotã fɔ ɔse Saul iyo, ɔ̃ iyomaturi gu ɔ̃ malaa ku ɔnukuare. Loiɖi mi lotã David, ɣɛɛ kiniɔ ne, ato anagu me sikpã ala iɣɛrɛ nɛ loba i ɔrɔ̃go wɔgbe iti! <verse eid="2SA 3:8" /><verse number="9" style="v" sid="2SA 3:9" />Ɣaa si ɔte me ɔledza me ite si loibara nnɛ i <char style="nd">Bosate</char> ɔɣɛ ɔsɛ ku ndamu sɔ ɔ̃abara ɔtã David. <verse eid="2SA 3:9" /><verse number="10" style="v" sid="2SA 3:10" />Loanyɔ sɔ sigarakaɖekɔ̃ ɔfiriki sibɔrɛgu i Saul iyo sikɛlɛ David sigaraiyara i Israel gu Yuda iso ita i Dan isɛ iabo Beerseba." <verse eid="2SA 3:10" /><verse number="11" style="v" sid="2SA 3:11" />Isboset iisina ɔtu ɔbusi kanya ɔɣere Abner kuira alasɔ ɔto ɔnigã wũ.<verse eid="2SA 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 3:12" />Ne Abner ɔpia maturi David kɔrɛ sɔ masɛ maaɣere wũ i ɔ̃ kanya sɔ, "Nna mba karɔ̃? Baragu me kanyakawɛ̃ si lobuai-ɔ lokɔ Israel kaɖe ɔɖuɖu lobɔ-ɔ."<verse eid="2SA 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 3:13" />Ne David ɔtã mmuai sɔ, "Ilɛ, loabaragu-ɔ kanyakawɛ̃, ɣɛɛ loakarɛ ira iwɛ̃ lobɔrɛgu i fɔ kɔrɛ: Daaba i wũ kɔrɛ si aisɛgu Saul ɔbibirɔ̃gomi Mixal." <verse eid="2SA 3:13" /><verse number="14" style="v" sid="2SA 3:14" />Ne David ɔpia makpabo sɔ masɛ maaɣere Saul ɔbibirɛrɛĩ Isboset sɔ, "Su wũ ɔre Mixal wɔ iti ara lobara ala ma Filistise kulafa ma loɖoe akurinyaĩ sese me."<verse eid="2SA 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 3:15" />Ne ɔso Isboset ɔpia masɛ maakɔ wũ maruigu i ɔ̃ ɔrã Paltiel wɔ nɖe Lais ɔbibirɛrɛĩ kɔrɛ. <verse eid="2SA 3:15" /><verse number="16" style="v" sid="2SA 3:16" />Ɔ̃ ɔrã ɣɛɛ ne, ɔsiai wũ i kama ɔto ɔbiɛ ɔsɛ ɔ̃abo Baxurim. Ne Abner ɔɣere wũ sɔ, "Kpese kɛlɛ iyo!" Ne ɔso ɔkpese ɔkɛlɛ.<verse eid="2SA 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 3:17" />Abner ɔsɛ iti ame ku Israel kaɖe makpakpa ɔɣɛ sɔ, "Iɔfɔ ɔwi kiniɔ gɔ mito mibie sɔ misɛra David sigara. <verse eid="2SA 3:17" /><verse number="18" style="v" sid="2SA 3:18" />Kiniɔ ne, ka misɛra wũ, ala <char style="nd">Bosate</char> ɔsiaita ku kaɣɛkasɛ ɔtã David sɔ, 'Wũ ɔɖabo David iso loaki loaɖi wũ maturi Israel kaɖe lobɔrɛgu i ma Filistise gu ma matsirise ɔɖuɖu nrɔɔ̃ ame.' "<verse eid="2SA 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 3:19" />Abner mɔmɔ ana ɔɖegu ma Benyaminse ika. Ne ka ɔkɛlɛ Xebron ɔsɛ ɔ̃aɣere David ibiara nɛ i Israel gu Benyamin iyo ɔɖuɖu ɔbie sɔ maabara ne. <verse eid="2SA 3:19" /><verse number="20" style="v" sid="2SA 3:20" />Gɔ Abner ɔba David kɔrɛ i Xebron ne, ɔsɛgu ɔ̃ marɛrɛ̃ sinyɔ, ne ɔso David ɔtu ma gu ɔ̃ marɛrɛ̃ ɔpɔrɔ̃ maɖe kakpakpe. <verse eid="2SA 3:20" /><verse number="21" style="v" sid="2SA 3:21" />Ne Abner ɔɣere David sɔ, "Tã lorui ɔluwɛ̃ loasa Israel kaɖe ɔɖuɖu kanya ɔluwɛ̃ lotã wũ ɔkɔse igara si makã ndamu matã-ɔ si aɖe sigara i ma ɔɖuɖu iso, lɛ kumɛgɔ i fɔ ɔtu to ɔbie." Ne ɔso David ɔɖi Abner ɔri i isobuɛ ame.<verse eid="2SA 3:21" /></para>
  <para style="s1">Yoab Ɔɖoe Abner</para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 3:22" />Iifɔ ɔwi ɖuɖuuɖu ne, David makpakpɛ̃dze gu Yoab ɔkpese maba Xebron gɔ masɛ maata mabo i ma matsirise iso maasore karana gbodzoo mabɔ. Ɣɛɛ Abner siina i David kɔrɛ i Xebron, ala ɔ̃ɔɖi wũ ɔri fiɛ ka ɔkpa i isobuɛ ame. <verse eid="2SA 3:22" /><verse number="23" style="v" sid="2SA 3:23" />Gɔ Yoab gu makpakpɛ̃dze ɔɖuɖu ɔba maabo ne, maɣere wũ sɔ Abner wɔ nɖe Ner ɔbibirɛrɛĩ ɔba igara kɔrɛ fiɛ igara ɔɔɖi wũ ɔri i isobuɛ ame.<verse eid="2SA 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 3:24" />Ne ɔso Yoab ɔkɛlɛ igara kɔrɛ ɔsɛ ɔ̃akarɛ wũ sɔ, "Be iɖe abara i ngbe? Nyɔ, Abner ɔba i fɔ kɔrɛ, be ɔso atã wũ ɔrui? Kiniɔ ka ɔkpa! <verse eid="2SA 3:24" /><verse number="25" style="v" sid="2SA 3:25" />Aɣe Abner, Ner ɔbibirɛrɛĩ, ɔba ɔ̃asɔsɔla-ɔ si ɔnyɔ fɔ ife gu ikpese si ɔnyɔ irabiara nɛ ato abara."<verse eid="2SA 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 3:26" />Kere ne Yoab ɔrui i David kɔrɛ fiɛ ɔpia Abner makpabo masɛ maakɔ wũ makpesera mabɔrɛgu i Sira itubu kɔrɛ mabɔ, ɣɛɛ David iiɣe. <verse eid="2SA 3:26" /><verse number="27" style="v" sid="2SA 3:27" />Gɔ Abner ɔkpese ɔba Xebron ne, Yoab ɔkɔ wũ mabo i iyo kabɔrɛnya lɛ itɔ̃me ɔto ɔbie sɔ ɔɣere wũ i iwɛrɛ ame. Ne i mmɔ kere Yoab ɔɖi itekpe ɔtsue Abner i kayiri ɔɖoe wũ ɔsu ɔtikuso ala gɔ ɔɖoe ɔ̃ ɔnyiibi Asaxel iti.<verse eid="2SA 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 3:28" />Kama gɔ David ɔnɔ nnɛgbe ne, ɔɣɛ sɔ, "Bo gu wũ sigarakaɖekɔ̃ na iɣɛrɛ ɖaa i <char style="nd">Bosate</char> anɔ i Abner, Ner ɔbibirɛrɛĩ kukpi gɔgbe ame. <verse eid="2SA 3:28" /><verse number="29" style="v" sid="2SA 3:29" />Ɔ̃ ima si ikarɛ so iti i Yoab gu ɔ̃ ɔse iyo ɔɖuɖu iso! Nwɔ nto ɔkpɛ̃ iyɛi ɣee ɔnyɛ ɔnyɛrɛtɛa, ɣee ɔsɛ i sidziri iso, ɣee ɔkpi i kakpã ame ɣee ɔkpi kukã si ɔdaaro i Yoab iyo."<verse eid="2SA 3:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 3:30" />(Yoab gu ɔ̃ ɔnyiibi Abisai ɔɖoe Abner ala ma ɔnyiibi Asaxel wɔ i Abner ɔɖoe i kakpã ame i Gibeon ɔso.)<verse eid="2SA 3:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 3:31" />Ne David ɔɣere Yoab gu mma ɔɖuɖu lowe i ɔ̃ kɔrɛ sɔ, "Mikɛkɛ mi awu si minyɔme ipundu sikoto si misɛ i isoma ame i Abner katɔ̃." Igara mɔmɔ ɔgbi aɖaka kama. <verse eid="2SA 3:31" /><verse number="32" style="v" sid="2SA 3:32" />Mabiara Abner i Xebron. Igara ɔbiɛ wororo i Abner ibiɔ katɔ̃, fiɛ maturi ɔɖuɖu ɔbiɛ ana.<verse eid="2SA 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 3:33" />Igara ɔka isomanɔ wɔgbe ɔtã Abner:</para>
  <para style="q1" vid="2SA 3:33">"Iikote sɔ Abner aakpi lɛ ɔturi wɔ liobara i mmara iso.<verse eid="2SA 3:33" /></para>
  <para style="q2">
    <verse number="34" style="v" sid="2SA 3:34" />Mainyi-ɔ nrɔɔ̃,</para>
  <para style="q2" vid="2SA 3:34">maipia fɔ ngba i ikpo ame.</para>
  <para style="q1" vid="2SA 3:34">Arɔ̃ lɛ nwɔ lorɔ̃ i ɔtile maturi nrɔɔ̃ ame."</para>
  <para style="p" vid="2SA 3:34">Ne maturi ɔɖuɖu ɔbiɛ Abner ana ne.<verse eid="2SA 3:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2SA 3:35" />Ɔwi wɔ i kuɣɛ̃ iibo iyo ne, ma ɔɖuɖu ɔba maatã David iti sɔ ka ɔpia ira kɛkɛĩ i kanya, ɣɛɛ David ɔkã ndamu ɔɣɛ sɔ, "Ɣaa si ɔte me, ɔledza me ite si ira ɔti me i kanya fiɛ kuɣɛ̃ aabo iyo!"<verse eid="2SA 3:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2SA 3:36" />Maturi ɔɖuɖu ɔkarã inɔ, fiɛ ibo ma anɔ, fiɛ gbaã ne, irabiara nɛ i igara ɔbara ɔbo ma anɔ. <verse eid="2SA 3:36" /><verse number="37" style="v" sid="2SA 3:37" />Ne ɔso iyi nɛmɔ ne, mma ɔɖuɖu lowe i mmɔ gu Israel ɔɖuɖu ɔtsue sɔ igara kɔrɔ̃ na i Abner, Ner ɔbibirɛrɛĩ kukpi ame.<verse eid="2SA 3:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="2SA 3:38" />Ne igara ɔkarɛ ɔ̃ makpakpɛ̃dze sɔ, "Miiɣe sɔ ɔturi siare gu ɔkpakpaturi lokpi i Israel nɔme ɣɛɛ? <verse eid="2SA 3:38" /><verse number="39" style="v" sid="2SA 3:39" />Nɔme atoasɔ mme nɖe igara wɔ masɔla nnɔĩ ne, nrɔɔ̃ ɔfɛ̃ me ala Zeruya mabibirɛrɛĩ magbe ɔfe ɔle matã me. <char style="nd">Bosate</char> mɔmɔ si ɔtã iranyanyariã baradze kuso i ɔ̃ kurabarara nyanyariã kanya!"<verse eid="2SA 3:39" /></para>
  <chapter eid="2SA 3" />
  <chapter number="4" style="c" sid="2SA 4" />
  <para style="s1">Maɖoe Isboset</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 4:1" />Gɔ Isboset, Saul ɔbibirɛrɛĩ ɔnɔ sɔ maɖoe Abner i Xebron ne, ɔtu ɔkpa wũ fiɛ Israel ɔɖuɖu ana ɔti. <verse eid="2SA 4:1" /><verse number="2" style="v" sid="2SA 4:2" />Saul ɔbi ɔwe marɛrɛ̃ inyɔ ma loɖe ma maturi katɔ̃ masɛ maata mabo maturi iso mafɔ ma ara. Ɔwɛ̃ marɔ Baana fiɛ ɔnyɔare loɖe Rexab. Rimon wɔ lobɔrɛ i Beerot fiɛ ɔɖe Benyamin kamele ɔturi mabibirɛrɛĩ maɖe - masɛ manyɔ Beerot lɛ Benyamin kakpai, <verse eid="2SA 4:2" /><verse number="3" style="v" sid="2SA 4:3" />alasɔ Beerot maturi ɔtere makɛlɛ masɛ maasɛ i Gitayim lɛ mafɔfiɛ masi i mmɔ lɛ mafɔ ipɛ i ɔwi wɔ matsɛrɛ ara wagbe.<verse eid="2SA 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 4:4" />(Yonatan, Saul ɔbi ɔwe ɔbibirɛrɛĩ ɔwɛ̃ wɔ loɖe bafã i ngba me minyɔ ɔɖuɖu. Ɔfɔ akɔ aru fiɛ maturi ɔbɔrɛ i Yezrel maba maaɣɛ sɔ Saul gu Yonatan ɔkpi i kakpã ame. Ɔbinyɔisose ɔputa wũ sɔ si ɔtere, ɣɛɛ gɔ ɔto ɔtere ku siwa ne, ɔbi ɔkpase, ne ɔkpese bafã ne. Ɔ̃ iyere loɖe Mefiboset ne.)<verse eid="2SA 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 4:5" />Rekab gu Baana ma nɖe Rimon wɔ lobɔrɛ i Beerot mabibirɛrɛĩ ɔɣo Isboset iyo ɔri masɛ maabo mmɔ kuɣɛ̃ kerebee gɔ ɔrɛ ku kakɔme ɔto ɔwarã kɛkɛĩ. <verse eid="2SA 4:5" /><verse number="6" style="v" sid="2SA 4:6" />Mabo makɛlɛ iyo kame lɛ atitabi maaka, ne matsue wũ ipɛmi i iyiri maɖoe. Ne Rekab gu ɔ̃ ɔnyiibi Baana matere iwɛrɛ ne.<verse eid="2SA 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 4:7" />Maɔkɛlɛ iyo gɔ ɔrɛ i ɔ̃ karɛkɔ̃ iso i irɛyo ame. Gɔ matsue wũ ipɛmi maɖoe maro ne, matu wũ iti maruigu, masɛ ɔri kasɛ̃ ɔɖuɖu maki Araba ɔri. <verse eid="2SA 4:7" /><verse number="8" style="v" sid="2SA 4:8" />Masu Isboset iti mabɔ David i Xebron maba maaɣere igara sɔ, "Nya Isboset, Saul wɔ nɖe fɔ tsirise fiɛ ɔbie sɔ si ɔɖoe-ɔ ɔbibirɛrɛĩ iti i ngbe ne. Nɔme ne, <char style="nd">Bosate</char> ɔɔti Saul gu ɔ̃ ɔɣekparɛ kuso i nnɛ mabara wũ ɔkɔse igara iti."<verse eid="2SA 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 4:9" />Ne David ɔtã Rekab gu ɔ̃ ɔnyiibi Baana, Rimon wɔ lobɔrɛ i Beerot mabibirɛrɛĩ mmuai sɔ, "Ayi kumɛgɔ i <char style="nd">Bosate</char> wɔ loɖi me ɔbɔrɛgu i wũ amɔrɛã ɔɖuɖu ame si ngbã ne, <verse eid="2SA 4:9" /><verse number="10" style="v" sid="2SA 4:10" />gɔ ɔturi ɔba ɔ̃aɣere me sɔ, 'Saul ɔkpi' fiɛ ɔbu sɔ itɔ̃me sɛɛ iɖe ɔbɔ me ne, lomɔɛ̃ wũ sikiti loɖoe wũ i Ziklag. Ne loɖe kuso gɔ lotã wũ i ɔ̃ itɔ̃me iti ne! <verse eid="2SA 4:10" /><verse number="11" style="v" sid="2SA 4:11" />Ne iyɔ nda loabara matilese ma lomɔɛ̃ ɔturi wɔ loibara ma ku ikpi i ɔ̃ iyo i ɔ̃ karɛkɔ̃ iso maɖoe wũ- loibakarɛ ɔ̃ ima iti lobɔrɛgu i ma nrɔɔ̃ ame loyura ma i kayi gagbe iso!"<verse eid="2SA 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 4:12" />Ne ɔso David ɔtã ɔ̃ maturi silɔ ne maɖoe ma, matu ma nrɔɔ̃ gu ngba matara ma masa i ibu iwɛ̃ kɔrɛ i Xebron. Ɣɛɛ masu Isboset iti mabiara i Abner ibiɔ ame i Xebron.<verse eid="2SA 4:12" /></para>
  <chapter eid="2SA 4" />
  <chapter number="5" style="c" sid="2SA 5" />
  <para style="s1">Masɛra David Sigara I Israel Gu Yuda Iso</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 5:1" />Israel kumele ɔɖuɖu ɔba David kɔrɛ i Xebron maɣere wũ sɔ, "Fɔ mɔmɔ sosina gu ima iwɛ̃ iɖe bo. <verse eid="2SA 5:1" /><verse number="2" style="v" sid="2SA 5:2" />Ɔwi wɔ lofe gɔ i Saul ɔɖe bo igara ne, fɔ loɖegu Israel katɔ̃ i bo kakpã ame. Ne <char style="nd">Bosate</char> ɔɣere-ɔ sɔ, 'Fɔ loakɔkɔ wũ maturi Israel kaɖe fiɛ aakpese nwɔ loaɖe ma iso.' "<verse eid="2SA 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 5:3" />Gɔ Israel kaɖe makpakpa ɔɖuɖu ɔɔba Igara David kɔrɛ i Xebron ne, igara ɔkã ndamu ɔtã ma i <char style="nd">Bosate</char> katɔ̃ fiɛ ka masɔla David nnɔĩ masɛra wũ sigara i Israel.<verse eid="2SA 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 5:4" />David ɔfɔ akɔ sitɛ fiɛ ɔkpese igara fiɛ ɔɖe sigara akɔ sina. <verse eid="2SA 5:4" /><verse number="5" style="v" sid="2SA 5:5" />I Xebron ne, ɔɖe sigara i Yuda iso akɔ akɔdzɛ gu awa akuɔ, fiɛ i Yerusalem ne, ɔɖe sigara i Israel ɔɖuɖu gu Yuda iso akɔ sitɛ-atɛ.<verse eid="2SA 5:5" /></para>
  <para style="s1">David Ɔkpɛ̃gu Yerusalem</para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 5:6" />Igara gu ɔ̃ marɛrɛ̃ ɔsɛ makɛlɛ Yerusalem, ne mata kakpã i ma Yebuse ma nsi i mmɔ iso. Ma Yebuse ɔɣere David sɔ, "Aibawo ngbe ɔbo, manɔbiɛdze gu mabafã kɔraa aatɛ̃-ɔ ɔri." Mabu sɔ, "David iibawo ngbe ɔbo ɔnya." <verse eid="2SA 5:6" /><verse number="7" style="v" sid="2SA 5:7" />Ɣɛɛ David ɔmɔɛ̃ Zion wɔ matsue ibere mapia - wɔ nɖe David Ɔmagɛ̃siare.<verse eid="2SA 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 5:8" />Iyi nɛmɔ ne, David ɔɣɛ sɔ, "Nwɔ loaɖe ma Yebuse iso ne, ikote sɔ ɔ̃aki i ndu iwo ame fiɛ ɔ̃abo manɔbiɛdze gu mabafã ma i David ɔtsiri kɔrɛ. Ne ɔso masɛ maɣɛ sɔ, "Manɔbiɛdze gu mabafã iibabo i igaraiyo."<verse eid="2SA 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 5:9" />Ne David ɔbara kasɛkɔ̃ i ngbegɔ matsue ibere makidza fiɛ ɔkpere mmɔ sɔ David Ɔmagɛ̃siare. Ɔledza kugbamiku gɔ loki kulɔ mmɔ ita i ngbegɔ mayira mapia i kame. <verse eid="2SA 5:9" /><verse number="10" style="v" sid="2SA 5:10" />Ne David ɔla ɔle iwe ibua, ala <char style="nd">Bosate</char> Ɣaa Ɔlesate ɔwegu wũ.<verse eid="2SA 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 5:11" />Ɔwi wɔmɔ ame ne, Xiram wɔ loɖe Tiro igara ɔsese David makpabo ku seder sidziri, marawedze, atayomatsuedze ne matsue igaraiyo matã David. <verse eid="2SA 5:11" /><verse number="12" style="v" sid="2SA 5:12" />Ne David ɔtsue sɔ <char style="nd">Bosate</char> ɔɔsɛra wũ i iyara iso lɛ igara i Israel fiɛ ɔ̃ sigarakaɖekɔ̃ ɔɔfɔ iyere ala ɔ̃ maturi Israel kaɖe iti.<verse eid="2SA 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 5:13" />Gɔ David ɔrui i Xebron ne, ɔsu masɔrɔ̃ ɔbua fiɛ ɔyiri marɔ̃go mama ɔbua i Yerusalem fiɛ maɣe mabibirɛrɛĩ gu mabibirɔ̃gomi mabua matã wũ. <verse eid="2SA 5:13" /><verse number="14" style="v" sid="2SA 5:14" />Mabi ma maɣe matã wũ ayere i Yerusalem ngbe ne: Samua, Sobab, Natan, Solomon, <verse eid="2SA 5:14" /><verse number="15" style="v" sid="2SA 5:15" />Ibxar, Elisua, Nefeg, Yafia, <verse eid="2SA 5:15" /><verse number="16" style="v" sid="2SA 5:16" />Elisama, Elyada gu Elifelet.<verse eid="2SA 5:16" /></para>
  <para style="s1">David Ɔɖe Ma Filistise Iso</para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 5:17" />Gɔ ma Filistise ɔnɔ sɔ maɔsɛra David sigara i Israel ne, mata kakpã gu ma ɔle ɔɖuɖu sɔ maanyɔnyɔ wũ, ɣɛɛ David ɔnɔ, ne ɔso ɔkɛlɛ kawɛrɛkɔ̃.<note caller="+" style="f"><char style="fr" closed="false">5.17 </char><char style="ft" closed="false">Lɛ ipia i 1 Sam 22 1, 4-5; 24.22, ne, David ɔwe kawɛrɛkɔ̃ i Adulam ɔkpolo ame. </char><char style="fp" closed="false" /><char style="fp" closed="false" /><char style="fp" closed="false" /><char style="fp" closed="false" /><char style="fp" closed="false" /></note> <verse eid="2SA 5:17" /><verse number="18" style="v" sid="2SA 5:18" />Ne ma Filistise ɔba maafere i Refaim kagbolomi ame; <verse eid="2SA 5:18" /><verse number="19" style="v" sid="2SA 5:19" />ne David ɔkarɛ <char style="nd">Bosate</char> sɔ, "Losɛ loakpɛ̃ ma Filistise? Aaɖi ma apia me i nrɔɔ̃ ame?"</para>
  <para style="p" vid="2SA 5:19">Ne <char style="nd">Bosate</char> ɔtã wũ mmuai sɔ, "Kɛlɛ, alasɔ gbaã ne, loaɖi ma Filistise lopia-ɔ i nrɔɔ̃ ame."<verse eid="2SA 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 5:20" />Ne ɔso David ɔkɛlɛ Baal Perazim fiɛ ɔɖe ma iso i mmɔ. Ɔɣɛ sɔ, "Lɛ kumɛgɔ i ndu sɛ mibiɛ mibo ɔturi iso ne, ngbɔ i <char style="nd">Bosate</char> ɔbiɛ ɔbo wũ matsirise iso ne." Ne ɔso marɔ mmɔ sɔ Baal Perazim. <verse eid="2SA 5:20" /><verse number="21" style="v" sid="2SA 5:21" />Ma Filistise ɔtere manyua ma arapɔa mafere i mmɔ, David gu ɔ̃ makpakpɛ̃dze ɔsore wã maruigu.<verse eid="2SA 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 5:22" />Ma Filistise ɔledza ikpese iba iabiɛ ibo i Rafaim Kagbolomi ame ɔwi ɔwɛ̃ ana, <verse eid="2SA 5:22" /><verse number="23" style="v" sid="2SA 5:23" />ne ɔso David ɔkarɛ <char style="nd">Bosate</char> fiɛ ɔtã wũ mmuai sɔ, "Daakɛlɛ ma kɔrɛ tiĩ ne, ɣɛɛ ki lɔ ma si abɔrɛ ma i kama isɛ si abo ma iso i nguadziri katɔ̃. <verse eid="2SA 5:23" /><verse number="24" style="v" sid="2SA 5:24" />Ɔwi wɔ aana anɔ ɔsɛ inene i adziri atititɛ̃ ne, pɛsiwa mala sɛ alasɔ ne karɔ̃ nɖe sɔ <char style="nd">Bosate</char> ɔɔɖe-ɔ katɔ̃ ɔ̃akpɛ̃gu ma Filistise makpakpɛ̃dze ne." <verse eid="2SA 5:24" /><verse number="25" style="v" sid="2SA 5:25" />Ne ɔso David ɔbara lɛ <char style="nd">Bosate</char> ɔɣere wũ, ɔɖoe ma Filistise ita i Gibeon i ɔri ɔɖuɖu wɔ nkpa Gezer iso.<verse eid="2SA 5:25" /></para>
  <chapter eid="2SA 5" />
  <chapter number="6" style="c" sid="2SA 6" />
  <para style="s">Masu Ndamu Aɖaka Mabɔ Yerusalem</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 6:1" />David ɔledza makpakpɛ̃dze sɛɛ i Israel kanya isira, ma ɔɖuɖu ɔɖe marɛrɛ̃ kukpi sitɛ. <verse eid="2SA 6:1" /><verse number="2" style="v" sid="2SA 6:2" />Ne David gu ɔ̃ makpakpɛ̃dze ɔɖuɖu ɔkɛlɛ Baala<note caller="+" style="f"><char style="fr" closed="false">6.2 </char><char style="ft" closed="false">Mmɔ masɛ marɔ ana sɔ Kiriat Yearim ne. Nyɔ 1Koronika 13:6</char></note> i Yuda sɔ maasu Ɣaa Ndamu aɖaka wa masɛ makpere ala Iyere<note caller="+" style="f"><char style="fr" closed="false">6.2 </char><char style="ft" closed="false">Iyere: Iɖe Bosate iyere nɛ Israel mabi iisɛ makpere maɖi kayi ne nɖe YHWH ne masɛ makpere kere sɔ Iyere ne</char></note>, <char style="nd">Bosate</char> Ɔlesate Iyere, nwɔ nsi i ɔ̃ sigaraiyara iso i Makerubi ndɛ̃ i ndamu aɖaka iso. <verse eid="2SA 6:2" /><verse number="3" style="v" sid="2SA 6:3" />Masu Ɣaa aɖaka masia i ibuɛ ɣɛtɛ nɛ i manantsuĩ to makpadzɛ̃ fiɛ mabɔrɛgu wã i Abinadab iyo nɛ nɣɛ i kabemi iso. Uza gu Axio ma nɖe Abinadab mabibirɛrɛĩ nto makɔ ibuɛ ɣɛtɛ nɛgbe. <verse eid="2SA 6:3" /><verse number="4" style="v" sid="2SA 6:4" />Ɣaa ndamu aɖaka ɔsia iso fiɛ Axio ɔsɛ ɔɖe ne katɔ̃. <verse eid="2SA 6:4" /><verse number="5" style="v" sid="2SA 6:5" />David gu Israel kaɖe ɔɖuɖu to maɖe iyi gu ma ɔle ɔɖuɖu i <char style="nd">Bosate</char> anɔ ku aka, akasa, siwɛ̃ masango, masango, sipiridon gu kumomoi.<verse eid="2SA 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 6:6" />Gɔ mabo Nakon imɔtu ne, manantsuĩ ma nto makpadzɛ̃ ibuɛ ɔwɛ̃ ɔtura, ne ɔso Uza ɔɖi kɔrɔ̃ ɔmɔɛ̃ Ɣaa ndamu aɖaka. <verse eid="2SA 6:6" /><verse number="7" style="v" sid="2SA 6:7" /><char style="nd">Bosate</char> ɔnagu Uza sikpã teteree ala nnɛ ɔbara ne ɔ̃iwarɛ wũ, ne ɔso Ɣaa ɔwuĩ wũ ɔɖe i karɔ̃ ɔɖoe wũ i Ɣaa ndamu aɖaka kɔrɛ i mmɔ.<verse eid="2SA 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 6:8" />Ne sikpã ɔmɔɛ̃ David i <char style="nd">Bosate</char> sikpã dzɛ ɔɖi i Uza iso ngbe ne. Ne ɔso ipɛ i nɔme ne, masɛ marɔ mmɔ sɔ Perez Uza<note caller="+" style="f"><char style="fr" closed="false">6.8 </char><char style="ft" closed="false">Perez Uza: Ne karɔ̃ nɖe sɔ Bosate ɔɖi sikpã ɔsia i Uza iso.</char></note> ipɛ ɔwi wɔ matsɛrɛ ara wagbe.<verse eid="2SA 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 6:9" />David ɔnigã <char style="nd">Bosate</char> ku iyi nɛmɔ ne ɔɣɛ sɔ, "Nda i <char style="nd">Bosate</char> ndamu aɖaka aaba aase i wũ kɔrɛ?" <verse eid="2SA 6:9" /><verse number="10" style="v" sid="2SA 6:10" />Ɔ̃ibie sɔ ɔ̃asu <char style="nd">Bosate</char> ndamu aɖaka ɔkɛlɛgu i ɔ̃ kɔrɛ i David Ɔmagɛ̃siare ame, ɣɛɛ ɔkidza wã ɔsɛ ɔ̃asɛ i Obed-Edom wɔ lobɔrɛ i Gatse iyo. <verse eid="2SA 6:10" /><verse number="11" style="v" sid="2SA 6:11" />Ndamu aɖaka ɔse i Obed-Edom Gatse iyo awa atɛ fiɛ <char style="nd">Bosate</char> ɔfere ma gu ɔ̃ iyo ɔɖuɖu kusɛkusɛ.<verse eid="2SA 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 6:12" />Kiniɔ ne maɣere Igara David sɔ, "<char style="nd">Bosate</char> ɔɔfere Obed-Edom iyo gu irabiara nɛ ɔba kusɛkusɛ ala Ɣaa ndamu aɖaka ɔso." Ne ɔso David ɔkɛlɛ ɔsɛ ɔ̃asu Ɣaa ndamu aɖaka ɔbɔrɛgu i Obed-Edom iyo ɔbɔ David Ɔmagɛ̃siare ame ku isoɣɔ. <verse eid="2SA 6:12" /><verse number="13" style="v" sid="2SA 6:13" />Gɔ mma nsore <char style="nd">Bosate</char> ndamu aɖaka ɔɔɖi ngba mikuɔ ne, David ɔsɔrɛ nantsuĩrɛrɛ̃ gu inantsuĩbi nɛ mba iɖa ɔtã <char style="nd">Bosate</char>. <verse eid="2SA 6:13" /><verse number="14" style="v" sid="2SA 6:14" />David mɔmɔ ɔpia ɖɔti ɖɔbɔrɔa ɔmearapia fiɛ ɔto ɔtɔ i <char style="nd">Bosate</char> anɔ gu ɔ̃ ɔle ɔɖuɖu, <verse eid="2SA 6:14" /><verse number="15" style="v" sid="2SA 6:15" />fiɛ David gu Israel ɔɖuɖu ɔsu <char style="nd">Bosate</char> ndamu aɖaka mabɔ ku kulu gu kudadã ifɛ̃.<verse eid="2SA 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 6:16" />Ɔwi wɔ masore <char style="nd">Bosate</char> ndamu aɖaka mato mabogu i David Ɔmagɛ̃siare ame ne, Mixal, Saul ɔbirɔ̃gomi to ɔnyɔ ara ɔkigu i fesere ame. Ne gɔ ɔnya kumɛgɔ i Igara David to ɔpɛ ikpamule, ɔtɔ i <char style="nd">Bosate</char> anɔ ne, ɔnyɔ wũ pupurii i ɔ̃ ɔtu ame.<verse eid="2SA 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 6:17" />Masu <char style="nd">Bosate</char> ndamu aɖaka maba maasɛ i ikpayo nɛ i David ɔpɛ ɔtã ne ame fiɛ ɔbara araifɛ̃ gu isobuɛ asɔrɛ ɔtã <char style="nd">Bosate</char>. <verse eid="2SA 6:17" /><verse number="18" style="v" sid="2SA 6:18" />Gɔ ɔfɛ̃ araifɛ̃ gu isobuɛ asɔrɛ ɔtã <char style="nd">Bosate </char> ɔro ne, ɔfere maturi kusɛkusɛ i <char style="nd">Bosate</char> Ɔlesate iyere ame. <verse eid="2SA 6:18" /><verse number="19" style="v" sid="2SA 6:19" />Ne David ka ɔtã ɔturi biara i Israel, marɛrɛ̃ gu marɔ̃go boɖoboɖo kaboi gu siɖɔabi,<note caller="+" style="f"><char style="fr" closed="false">6.19 </char><char style="ft" closed="false">Siɖɔabi: Siko siwɛ̃ ame ne maɣɛ sɔ sina akpe </char></note> wainabikorea abo marɛrɛ̃ i marɔ̃go pelepele fiɛ ɔbiara ɔkɛlɛ ɔ̃ iyo ne.<verse eid="2SA 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 6:20" />Gɔ i David ɔsɛ ɔ̃abo iyo si ɔfere ɔ̃ iyomaturi kusɛkusɛ ne, Mixal, Saul ɔbibirɔ̃gomi ɔbɔrɛ ɔba ɔ̃asarɛgu wũ ɔɣɛ sɔ, "Ne nda i Israel Igara ka ɔbua ɔsopara so nɔme ngbɔ ni, ɔɖi isɔ̃ kakukaku i ɔ̃ maɖabo masanderɔ̃go anɔmi ame lɛ katurisasoi biara aabara!"<verse eid="2SA 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 6:21" />David ɔɣere Mixal sɔ, "<char style="nd">Bosate</char> wɔ lonyɔ me sɔ lokɔlɛ loɖo fɔ ɔse gu ɔ̃ iyomaturi ɔɖuɖu fiɛ ɔsɛra me sigara i <char style="nd">Bosate</char> Israel kaɖe iso anɔ iɖe loto lotɔ. Ne ɔso nto loɖe iyi i <char style="nd">Bosate</char> anɔ. <verse eid="2SA 6:21" /><verse number="22" style="v" sid="2SA 6:22" />Loasopa loɖo ngbɔ, fiɛ loabɔsokarɔ̃ i wũ mɔmɔ anɔ loɖo kumɛgɔgbe, ɣɛɛ loawe kuwarɛ i masanderɔ̃go ma itɔ̃me aɣɛ anɔmi ame."<verse eid="2SA 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 6:23" />Ne ɔso Mixal, Saul ɔbibirɔ̃gomi iiɣe ɔbi gbɔgbɔɔgbɔ ɔkpi.<verse eid="2SA 6:23" /></para>
  <chapter eid="2SA 6" />
  <chapter number="7" style="c" sid="2SA 7" />
  <para style="s1">
    <char style="nd">Bosate</char> Ɔkã Ndamu Ɔtã David</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 7:1" />Kama gɔ i igara ɔɔna kasɛ i ɔ̃ igaraiyo fiɛ <char style="nd">Bosate</char> ɔɔtã wũ iwarã ɔbɔrɛgu i ɔ̃ matsirise ɔɖuɖu nrɔɔ̃ ame ne, <verse eid="2SA 7:1" /><verse number="2" style="v" sid="2SA 7:2" />ɔɣere kanyaɖidze Natan sɔ, "Nyɔ, losi i seder kukolo igaraiyo ame, gɔ i Ɣaa ndamu aɖaka se i ikpayo ame."<verse eid="2SA 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 7:3" />Ne Natan ɔtã igara mmuai sɔ, "Irabiara nɛ mpia-ɔ i iti ame ne, bara, alasɔ <char style="nd">Bosate</char> piagu-ɔ."<verse eid="2SA 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 7:4" />Ɣɛɛ kasɛ̃ gamɔ ne, <char style="nd">Bosate</char> itɔ̃me ɔba Natan sɔ:<verse eid="2SA 7:4" /></para>
  <para style="pm">
    <verse number="5" style="v" sid="2SA 7:5" />"Kɛlɛ aaɣere wũ ɔɖabo David sɔ, ' <char style="nd">Bosate</char> sɔ: Iiɖe fɔ loatsue iyo atã me losɛ i kame. <verse eid="2SA 7:5" /><verse number="6" style="v" sid="2SA 7:6" />Ita i ɔwi wɔ lokɔ Israel mabi lobɔrɛgu i Egipte karɔ̃ iso ibo nɔme ne, loɔwe loki i kakɔi kawɛ̃ lokɛlɛ kakɔi mama gɔ ikpayo nɖe wũ kasɛkɔ. <verse eid="2SA 7:6" /><verse number="7" style="v" sid="2SA 7:7" />Kakɔi biara ga loɔki gu Israel mabi ne, loɔkarɛ mma loɖi sɔ makɔkɔ wũ kaɖe Israel sɔ, "Be ɔso aitsue seder kukolo iyo atã me?" '<verse eid="2SA 7:7" /></para>
  <para style="pm">
    <verse number="8" style="v" sid="2SA 7:8" />Kiniɔ ne, ɣere wũ ɔɖabo David sɔ, ' <char style="nd">Bosate</char> Ɔlesate sɔ: Lokɔ-ɔ lobɔrɛgu i masɛrɛ sikuakaɖekɔ̃, masɛrɛ inyɔiso karabara ame, lobara-ɔ nwɔ loaɖe wũ kaɖe Israel iso. <verse eid="2SA 7:8" /><verse number="9" style="v" sid="2SA 7:9" />Loɔwegu-ɔ i kakɔi biara ga ɔɔki fiɛ loɔɖoe fɔ matsirise ma loki malɔ-ɔ i fɔ anɔ. Kiniɔ ne, loatã fɔ iyere ɔre, lɛ karɔ̃ iso maturi ma lofɔ iyere maɖo ɔwɛ̃. <verse eid="2SA 7:9" /><verse number="10" style="v" sid="2SA 7:10" />Loatã wũ kaɖe Israel kasɛkɔ̃ fiɛ loato ma lɛ ɔraɖui, si maawe ma mɔmɔ karɔ̃ fiɛ kuwɛ̃ iisibaɖaa ma. Matilese iisibaɖe ma iso lɛ mabara ku karɔ̃kasɛkɔ̃, <verse eid="2SA 7:10" /><verse number="11" style="v" sid="2SA 7:11" />fiɛ mala maɔbara ku ɔwi wɔ lotã makɔdze ɔkɔ wũ kaɖe Israel. Loatã-ɔ iwarã ana i fɔ matsirise ɔɖuɖu nrɔɔ̃ ame.</para>
  <para style="pm" vid="2SA 7:11">"<char style="nd">Bosate</char> sɔ tsue sɔ <char style="nd">Bosate</char> mɔmɔ loasɛra iyo ɔtã-ɔ: <verse eid="2SA 7:11" /><verse number="12" style="v" sid="2SA 7:12" />Si fɔ agbanayi ɔɔsɔ̃ fiɛ ɔɔkora kama ne, loatara fɔ ɔkparɛ, fɔ mɔmɔ ɔbi fiɛ loasɛra ɔ̃ sigaraɖekɔ̃ i fɔ kama. <verse eid="2SA 7:12" /><verse number="13" style="v" sid="2SA 7:13" />Ɔ̃ nɖe nwɔ loatsue iyo ɔtã wũ Iyere fiɛ loatã ɔ̃ sigaraiyara iibaturi inya kayi daaro. <verse eid="2SA 7:13" /><verse number="14" style="v" sid="2SA 7:14" />Loaɖe wũ ɔse, fiɛ ɔ̃aɖe wũ ɔbibirɛrɛĩ. Si ɔɣɛrɛ ne, loasu maturi awune lɛ kadziri lokpadzɛ̃ wũ kutsue. <verse eid="2SA 7:14" /><verse number="15" style="v" sid="2SA 7:15" />Ɣɛɛ wũ kuɖɔɛ gɔ loba lotã wũ iibaro i wũ anɔ, lɛ lomɔɛ̃ kuɖɔɛ loɖi i Saul gɔ lotara fiɛ ato aba awe. <verse eid="2SA 7:15" /><verse number="16" style="v" sid="2SA 7:16" />Fɔ iyo gu fɔ sigarakaɖekɔ̃ aaya me i anɔ ɔwi daaro, fɔ sigaraiyara iibaturi inya.' "<verse eid="2SA 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 7:17" />Natan ɔba ɔ̃aɣere David kaɖikate atɔ̃me ɔɖuɖu wagbe.<verse eid="2SA 7:17" /></para>
  <para style="s1">David Ɔkparamakayi Ɔpɛ Bosate Siba</para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 7:18" />Ɔwi kama ne Igara David ɔkɛlɛ ɔsɛ ɔ̃asɛ i ikpayo nɛ ɔɣedza ɔtã ndamu aɖaka i <char style="nd">Bosate</char> anɔ fiɛ ɔɣɛ sɔ,</para>
  <para style="pm" vid="2SA 7:18">
    <char style="nd">Bosate</char> Wɔ Nsiguso, loiɖe kuira, fiɛ wũ iyo maturi iiɖe kumawɛ̃ fiɛ ɔɔkɔ me aba aabogu ta ngbe. <verse eid="2SA 7:18" /><verse number="19" style="v" sid="2SA 7:19" />O <char style="nd">Bosate</char> Wɔ Nsiguso fiɛ lɛ nnɛgbe iisi-ɔ ne, ɔɔɣɛ ara sɛɛ asɛ i fɔ ɔɖabo iyo iso. O <char style="nd">Bosate</char> Wɔ Nsiguso, kumɛgɔgbe nɖe ɔri wɔ iso asɛ abara ara ku ɔturi biara?<verse eid="2SA 7:19" /></para>
  <para style="pm">
    <verse number="20" style="v" sid="2SA 7:20" />"Be i David aaɣɛ ɔbua ana? O <char style="nd">Bosate</char> Wɔ Nsiguso, ala aɣe fɔ ɔɖabo. <verse eid="2SA 7:20" /><verse number="21" style="v" sid="2SA 7:21" />I fɔ itɔ̃me iti gu fɔ kuɖɔɛ kanya ne, ɔɔbara ira siare nɛgbe fiɛ ɔɔtã fɔ ɔɖabo ɔtsue ne.<verse eid="2SA 7:21" /></para>
  <para style="pm">
    <verse number="22" style="v" sid="2SA 7:22" />"Amɔ lo <char style="nd">Bosate</char> Wɔ Nsiguso! Kuwɛ̃ iise lɛ fɔ, fiɛ Ɣaa mama kuwɛ̃ na iɖo fɔ, lɛ boɔnɔ ala bo mɔmɔ atsue. <verse eid="2SA 7:22" /><verse number="23" style="v" sid="2SA 7:23" />Fiɛ Kaɖe kukawɛ̃ ga nse lɛ fɔ maturi Israel na - kaɖe kawɛ̃ ga iti i Ɣaa ɔsɛ ɔ̃atã kuso ɔfɔ ɔtã so, sɔ ɔ̃afɔ iɣere ɔtã so fiɛ ɔbara awawãra siare gu nwa mba ifɔ̃ gɔ ɔsa nɖebi gu ma aɣɔ i fɔ maturi ma aɖi atã so, mma iti atã kuso fiɛ aɖi abɔrɛgu i Egipte karɔ̃ iso katɔ̃. <verse eid="2SA 7:23" /><verse number="24" style="v" sid="2SA 7:24" />Ɔɔsɛra Israel kaɖe lɛ fɔ mare ɔwi daaro fiɛ <char style="nd">Bosate</char> ɔɔkpese ma Ɣaa lo.<verse eid="2SA 7:24" /></para>
  <para style="pm">
    <verse number="25" style="v" sid="2SA 7:25" />"Kiniɔ ne, <char style="nd">Bosate</char> Ɣaa, mɔɛ̃ kaɣɛkasɛ ga abara i fɔ ɔɖabo gu i ɔ̃ iyo iso la ɔwi ɖaa. Bara lɛ aɣɛ asɛ, <verse eid="2SA 7:25" /><verse number="26" style="v" sid="2SA 7:26" />si fɔ iyere aare kayi daaro. Iyɔ maturi aaɣɛ sɔ, ' <char style="nd">Bosate</char> Ɔlesate nɖe Ɣaa i Israel kaɖe iso!' Fiɛ fɔ ɔɖabo David iyo aana kayakpa i fɔ anɔ.<verse eid="2SA 7:26" /></para>
  <para style="pm">
    <verse number="27" style="v" sid="2SA 7:27" />"O <char style="nd">Bosate</char> Ɔlesate wɔ nɖe Israel Ɣaa, ɔɔɖi nnɛgbe ate fɔ ɔɖabo aɣɛ sɔ, 'Loatsue iyo lotã-ɔ.' Ne ɔso i fɔ ɔɖabo ɔna ɔtu ɔto ɔkparamakayi ɔɣere-ɔ nwagbe ne. <verse eid="2SA 7:27" /><verse number="28" style="v" sid="2SA 7:28" />O <char style="nd">Bosate</char> Wɔ Nsiguso, Ɣaa aɖe! Fɔ ndamu ɖe nnɛ iso maasiaiti fiɛ ɔɔɣɛ ara sɛɛ wagbe asɛ i fɔ ɔɖabo iso. <verse eid="2SA 7:28" /><verse number="29" style="v" sid="2SA 7:29" />Kiniɔ ne, tã so si siɣɔ-ɔ si afere fɔ ɔɖabo iyo kusɛkusɛ sɔ iakɛlɛ i katɔ̃ iya i fɔ anɔ kayi daaro ala fɔ <char style="nd">Bosate</char> wɔ Nsiguso loɔɖeika fiɛ ku fɔ kusɛkusɛ ne, fɔ ɔɖabo iyo to iaɖe kusɛkusɛ kayi daaro."<verse eid="2SA 7:29" /></para>
  <chapter eid="2SA 7" />
  <chapter number="8" style="c" sid="2SA 8" />
  <para style="s1">David Iɖeiso I Kakpã Ame</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 8:1" />I ɔwi ame ne, David ɔɖe ma Filistise iso ɔbɔ ma karɔ̃ ne ɔfɔ Meteg Amma i ma Filistise nrɔɔ̃ ame.<verse eid="2SA 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 8:2" />David ɔɖe ma Moabse ana iso. Ɔtã marɛ i karɔ̃ ne ɔsusu ma ku iwɛĩ i ɔbole ame. Si ɔsusu iwɛĩ ikuri iwɛ̃ gu ikuri inyɔa ne iyɔ ɔ̃ɔɖoe ma ɔɖuɖu i akuri anyɔ ame. Ikuri tɛa nɛ ɔ̃asusu ne ɔ̃ɔtã mawe ngbã. Ne ɔso ma Moabse ɔwe i David kayirinɔ fiɛ matã wũ toto.<verse eid="2SA 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 8:3" />Ana ne, David ɔkpɛ̃gu Xadadezer, Rexob ɔbibirɛrɛĩ wɔ nɖe Zoba igara ne ɔɖe wũ iso i kakpã ame ku ɔwi wɔ i David ɔsɛ ɔ̃aledza iɣedza ɔ̃ iɖeiso ɔle i Frat ɔwore kɔrɛ. <verse eid="2SA 8:3" /><verse number="4" style="v" sid="2SA 8:4" />David ɔmɔɛ̃ Xadadezer kubore gɔ i apɔngɔ sɛ akpadzɛ̃ kakpi kawɛ̃, mma nsi i apɔngɔ iso ana ɔmɔɛ̃ kukpi kukɔdzɛ, makpakpɛ̃dze ma nsɛ ngba kukpi sinyɔ. Ɔtutu apɔngɔ ɔɖuɖu wa nsɛ akpadzɛ̃ kubore sikpaɖu iɖo wã kulafa kere ɔ̃itu.<verse eid="2SA 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 8:5" />Gɔ ma Aramse ma i Damasko ɔba maabuai Xadadezer, Zoba igara ne, David ɔɖoe ma kukpi sinyɔ-inyɔ. <verse eid="2SA 8:5" /><verse number="6" style="v" sid="2SA 8:6" />Ɔsɛ makpakpɛ̃dze kasɛkɔ̃ i ma Aramse sigarakaɖekɔ̃ i Damasko ne ɔso ma Aramse ɔwe i ɔ̃ kayirinɔ, mala maɔbɔ wũ toto. <char style="nd">Bosate</char> ɔtã David iɖeiso i kakɔi biara ga ɔki.<verse eid="2SA 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 8:7" />David ɔfɔ sikãrɛtɛa akpirafɔra wa loɖe Xadadezer makpakpa are ne ɔsu wã ɔbɔ Yerusalem. <verse eid="2SA 8:7" /><verse number="8" style="v" sid="2SA 8:8" />Igara David ɔsu ayiwa ibɔra gbodzoo ɔbɔrɛgu i Teba gu Berotai simagɛ̃ dzɛ loɖe Xadadezer sire ame.<verse eid="2SA 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 8:9" />Gɔ i Tou wɔ loɖe Xamat Igara ɔnɔ sɔ David ɔɖe Xadadezer makpakpɛ̃dze ɔɖuɖu iso ne, <verse eid="2SA 8:9" /><verse number="10" style="v" sid="2SA 8:10" />ɔpia ɔ̃ ɔbirɛrɛĩ Yoram sɔ ɔsɛ ɔ̃aya Igara David mmɔ si ɔtã wũ ɖafe i ɔ̃ iɖeiso i kakpã ame ku Xadadezer, nwɔ loɔkpɛ̃gu Tou kakpã ana. Yoram ɔsore sikãfudza, sikãrɛtɛa gu ayiwa ibɔra ara fiɛ ɔba.<verse eid="2SA 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 8:11" />Igara David ɔsu ara wagbe ɔɖuɖu ɔsekelera ɔtã <char style="nd">Bosate</char> lɛ kumɛgɔ ɔbara sikãfudza gu sikãrɛtɛa ara wa ɔɖuɖu ɔmɔɛ̃ i nɖebi mɛ ɔ̃ɔɖeiso i kakpã ame mmɛ loɖe: <verse eid="2SA 8:11" /><verse number="12" style="v" sid="2SA 8:12" />Edom gu Moab, Amon, Filistia gu Amalek gu nwa ɔfɔ i Xadadezer, Rexob ɔbibirɛrɛĩ wɔ loɖe Zoba igara kɔrɛ.<verse eid="2SA 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 8:13" />Gɔ David ɔsɛ ɔ̃aɖoe ma Edomse kukpi kuweo-fafarana i Mma Kagbolomi ame ɔkpese ne, ɔfɔ iyere ɔbua.<verse eid="2SA 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 8:14" />Ɔsɛ makpakpɛ̃dze kusɛkɔ̃ i Edom karɔ̃ ɔɖuɖu iso fiɛ ma Edomse ɔkpese David maɖabo. <char style="nd">Bosate</char> ɔtã David iɖeiso i kakɔi biara ga ɔsɛ.<verse eid="2SA 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 8:15" />David ɔɖe sigara i Israel ɔɖuɖu iso, ɔbara ara i ɔri iso gu nnɛ loya ɔtã ɔ̃ maturi ɔɖuɖu. <verse eid="2SA 8:15" /><verse number="16" style="v" sid="2SA 8:16" />Yoab wɔ ɔnyi loɖe Zeruya loɖe kpakpɛ̃dzekpakpa pelepele, Yexosafat, Axilud ɔbibirɛrɛĩ loɖe nwɔ losia ara ikparĩ; <verse eid="2SA 8:16" /><verse number="17" style="v" sid="2SA 8:17" />Zadok, Axitub ɔbibirɛrɛĩ gu Aximelek, Abiatar ɔbibirɛrɛĩ loɖe masɔrɛdze; Seraya ɔɖe ratsɛrɛdze; <verse eid="2SA 8:17" /><verse number="18" style="v" sid="2SA 8:18" />Benaya, Yexoyada ɔbibirɛrɛĩ loɖe ma Keretse gu ma Peletse<note caller="+" style="f"><char style="fr" closed="false">8.18 </char><char style="ft" closed="false">Ma Keretse gu ma Peletse: Maɖe mafɔ makpakpɛ̃dze ma mala maɔsu ɔpaa.</char></note> makpakpa, fiɛ David mabi ɔɖe igara adzuni matãdze.<verse eid="2SA 8:18" /></para>
  <chapter eid="2SA 8" />
  <chapter number="9" style="c" sid="2SA 9" />
  <para style="s1">David Ɔbara Mefiboset Kayiribielea</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 9:1" />Iyi iwɛ̃ ne David ɔkarɛ sɔ, "Ɔturi ɔwɛ̃ ɔkuti ɔpia ngbã i Saul iyo ame gɔ loawo wũ kayiribielea ɔbara ala Yonatan ɔso?"<verse eid="2SA 9:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 9:2" />Kiniɔ ne ɔɖabo ɔwɛ̃ wɔ lonyɔ Saul iyo iso marɔ sɔ Ziba ɔwe. Makpere wũ sɔ ɔba i David katɔ̃, ne gɔ ɔba ne, igara ɔkarɛ wũ sɔ, "Fɔ marɔ Ziba ne?"</para>
  <para style="p" vid="2SA 9:2">Ne ɔtã mmuai sɔ, "Igara, mme loɖe."<verse eid="2SA 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 9:3" />Ne igara ɔkarɛ wũ sɔ, "Ɔturi ɔwɛ̃ ɔkuti ɔpia ngbã i Saul iyo ame gɔ loabara wũ Ɣaa kayiribielea?"</para>
  <para style="p" vid="2SA 9:3">Ne Ziba ɔtã mmuai sɔ, "Yonatan ɔbibirɛrɛĩ ɔwɛ̃ wɔ nɖe bafã i ngba me minyɔ ɔɖuɖu ɔkuti ɔpia."<verse eid="2SA 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 9:4" />Igara ɔkarɛ wũ sɔ, "Lɛ ɔpia?"</para>
  <para style="p" vid="2SA 9:4">Ziba ɔtã mmuai sɔ, "Ɔpia i Makir, Amiel ɔbibirɛrɛĩ iyo i Lo Debar."<verse eid="2SA 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 9:5" />Ne ɔso Igara David ɔtã masɛ maakɔ wũ mabɔrɛgu i Lo Debar i Makir, Amiel ɔbibirɛrɛĩ iyo mabɔ.<verse eid="2SA 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 9:6" />Ɔwi wɔ i Mefiboset, Yonatan ɔbibirɛrɛĩ, Saul ɔwabirɛrɛĩ ɔba David kɔrɛ ne, ɔbɔitikarɔ̃ ɔtã wũ i kuwarɛ ame.</para>
  <para style="p" vid="2SA 9:6">David ɔkpere wũ sɔ, "Mefiboset!"</para>
  <para style="p" vid="2SA 9:6">Ne ɔtã mmuai sɔ</para>
  <para style="p" vid="2SA 9:6">"Nya mme, Igara."<verse eid="2SA 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 9:7" />David ɔɣere wũ sɔ, "Daanigã, loabara-ɔ kayiribielea ala fɔ ɔse Yonatan ɔso. Loasu nrɔ̃ mɛ ɔɖuɖu loɖe fɔ ɔwa Saul mire lotã-ɔ fiɛ aaɖe ara i wũ ɔpɔrɔ̃ iso ɔwi biara ita i nɔme."<verse eid="2SA 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 9:8" />Mefiboset ɔbɔitikarɔ̃ ɔɣɛ sɔ, "Be i fɔ ɔɖabo wɔ loiɖe kuira ɖe i fɔ anɔ fiɛ ato amararã so i wũ iso?"<verse eid="2SA 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 9:9" />Ne igara ɔpia makpere Ziba wɔ loɖe Saul ɔɖabo mabɔ, ne ɔɣere wũ sɔ, "Loɔsu irabiara nɛ nɖe mi ɔkɔse Saul gu ɔ̃ iyomaturi ire lotã ɔ̃ ɔwabirɛrɛĩ. <verse eid="2SA 9:9" /><verse number="10" style="v" sid="2SA 9:10" />Mi gu fɔ mabi gu fɔ maɖabo si mikpɛ̃ mitã wũ sɔ miasu araɖea minyɔ mi ɔkɔse ɔwabirɛrɛĩ iso. Mefiboset wɔ nɖe mi ɔkɔse ɔwabirɛrɛĩ aaɖe aɖera i wũ ɔpɔrɔ̃ iso ɔwi biara." (Iba sɔ, Ziba ɔwe mabi iweo-iru gu maɖabo sinyɔ.)<verse eid="2SA 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 9:11" />Ne Ziba ɔɣere igara sɔ, "Fɔ ɔɖabo aabara irabiara nɛ i wũ ɔkɔse igara ɔɣere ɔ̃ ɔɖabo sɔ ɔbara." Ne ɔso Mefiboset ɔɖe ara i David ɔpɔrɔ̃ iso lɛ igara mabibirɛrɛĩ ndɛ̃ ɔwɛ̃.<verse eid="2SA 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 9:12" />Mefiboset ɔwe kabi poroporoi ga marɔ sɔ Mika, fiɛ Ziba gu ɔ̃ iyomaturi ɔɖe Mefiboset maɖabo. <verse eid="2SA 9:12" /><verse number="13" style="v" sid="2SA 9:13" />Mefiboset ɔsɛ i Yerusalem alasɔ ɔwi biara ne, ɔla ɔ̃aɖe aɖera i igara ɔpɔrɔ̃ iso, ɔɖe bafã i ɔ̃ ngba minyɔ ɔɖuɖu.<verse eid="2SA 9:13" /></para>
  <chapter eid="2SA 9" />
  <chapter number="10" style="c" sid="2SA 10" />
  <para style="s1">David Ɔɖe Ma Amonse Gu Ma Aramse Iso</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 10:1" />I ɔwi kama ne, ma Amonse igara ɔkpi, ne ɔ̃ ɔbibirɛrɛĩ Xanun ɔsɛ i ɔ̃ ɔse kanya ne. <verse eid="2SA 10:1" /><verse number="2" style="v" sid="2SA 10:2" />David ɔɣere so sɔ, "Loabara Naxas ɔbibirɛrɛĩ Xanun kayiribielea lɛ ɔ̃ ɔse ɔbara me." Ne ɔso David ɔsese maturi sɔ masɛ maabiɛgu Xanun i ɔ̃ ɔse kukpi iti.</para>
  <para style="p" vid="2SA 10:2">Gɔ i David marɛrɛ̃ ɔba ma Amonse karɔ̃ iso ne, <verse eid="2SA 10:2" /><verse number="3" style="v" sid="2SA 10:3" />ma Amonse makpakpɛ̃dzekpakpa ɔkarɛ ma ɔkɔse Xanun sɔ, "Abu sɔ David to ɔwarɛ fɔ ɔse ɔso ɔpia maturi sɔ maba maabiɛgu-ɔ? Iiɖe ɔpia ɔpia ma i fɔ kɔrɛ sɔ maba maayu bo ɔmagɛ̃ manyɔ si maaba maabiɛ wũ?" <verse eid="2SA 10:3" /><verse number="4" style="v" sid="2SA 10:4" />Ne ɔso Xanun ɔmɔɛ̃ David maturi ma ɔpia katɔ̃me ɔkparɛ̃ ma sikore kasɛ, ɔtu ma awu i amɔrɛsɛ ndɛ̃ ɔkpesera ma ɔsese.<verse eid="2SA 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 10:5" />Gɔ David ɔnɔ nnɛ loba ne, ɔpia maɖabo sɔ masɛ maatu marɛrɛ̃ mabge i ɔri alasɔ mapia ma kunuarɛ gbaã. Igara ɔɣere ma sɔ, "Miwe i Yeriko gbɔgbɔɔgbɔ mi sikore aayi iyɔ si miakpese miba kaa."<verse eid="2SA 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 10:6" />Gɔ ma Amonse ɔnya sɔ maɔpia David sikpã ne, matã sikã mafɔ ngbaiso makpakpɛ̃dze kukpi sinyɔ i ma Aramse kɔrɛ i Bet Rexob gu Zoba, Maaka igara ana ɔtã makpakpɛ̃dze kakpi kawɛ̃ fiɛ makpakpɛ̃dze kukpi kuweo-kunyɔ ana ɔbɔrɛ i Tob.<verse eid="2SA 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 10:7" />Gɔ David ɔnɔ nnɛgbe ne, ɔsese Yoab gu marɛrɛ̃ ma ɔɖuɖu loɖe makpakpɛ̃dze si masɛ maakpɛ̃ ma. <verse eid="2SA 10:7" /><verse number="8" style="v" sid="2SA 10:8" />Ma Amonse ɔbɔrɛ maba maaya i kakpã katɔ̃ i ma ɔmagɛ̃siare kayogodɔ̃ kabɔrɛnya, gɔ i ma Aramse ma lobɔrɛ i Zoba gu Rexob gu marɛrɛ̃ ma lobɔrɛ i Tob gu Maaka ma wũ maɣedza so i karɔ̃ ndɛ̃.<verse eid="2SA 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 10:9" />Yoab ɔnya sɔ tsirise makpakpɛ̃dze ɣɛ wũ i katɔ̃ gu kama, ne ɔso ɔɖi makpakpɛ̃dze sɛɛ i Israel sɔ mayagu ma Aramse. <verse eid="2SA 10:9" /><verse number="10" style="v" sid="2SA 10:10" />Ɔsu makpakpɛ̃dze tsɔra ɔpia i ɔ̃ ɔnyiibi Abisai kayirinɔ fiɛ ɔtã mayagu ma Amonse. <verse eid="2SA 10:10" /><verse number="11" style="v" sid="2SA 10:11" />Yoab ɔɣere ɔ̃ ɔnyiibi sɔ, "Si ma Aramse to mawe ɔle maɖo me ne, babuai me, ɣɛɛ si ma Amonse to mawe ɔle maɖo-ɔ ne, loaba loabuai-ɔ. <verse eid="2SA 10:11" /><verse number="12" style="v" sid="2SA 10:12" />We ɔle, si atã bokpɛ̃ botã bo maturi ku kagbegbe gu bo Ɣaa simagɛ̃siare. <char style="nd">Bosate</char> to ɔ̃abara nnɛ loabo wũ anɔ."<verse eid="2SA 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 10:13" />Gɔ Yoab gu ɔ̃ makpakpɛ̃dze ɔta mato mabo si makpɛ̃gu ma Aramse ne, matsɛ irui itere i Yoab kanya. <verse eid="2SA 10:13" /><verse number="14" style="v" sid="2SA 10:14" />Gɔ ma Amonse ɔnya sɔ ma Aramse ɔɔtsɛ itere ne, ma wũ matere i Abisai kɔrɛ mabo i ma ɔmagɛ̃siare ame. Ne ɔso gɔ Yoab ɔsɛ ɔ̃akpɛ̃gu ma Amonse ɔro ne, ɔkpese ɔba Yerusalem.<verse eid="2SA 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 10:15" />Gɔ ma Aramse ɔnya sɔ Israel ɔɖe ma iso kama ne, makpese masikanya. <verse eid="2SA 10:15" /><verse number="16" style="v" sid="2SA 10:16" />Xadadezer ɔtã makpere ma Aramse makpakpɛ̃dze ma i Frat ɔwore kama isɛ mabɔ fiɛ makɛlɛ Xelam. Sobak wɔ loɖe Xadadezer kpakpɛ̃dzekpakpa loɖe ma katɔ̃.<verse eid="2SA 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 10:17" />Gɔ maɣere David nnɛgbe ne, ɔsira Israel ɔɖuɖu kanya, mawara Yordan ɔwore makɛlɛ Xelam. Ma Aramse ɔbara ma kakpã katɔ̃ kuyakɔ̃ gɔ maasarɛgu David i kakpã ame. <verse eid="2SA 10:17" /><verse number="18" style="v" sid="2SA 10:18" />Ɣɛɛ ma Aramse matere i Israel kanya fiɛ David ɔɖoe mma nsi i kubore iso alafa akɔdzɛ gu makpakpɛ̃dze ma nsɛ ngba kukpi sina. Ɔwuĩ Sobak wɔ loɖe makpakpɛ̃dzekpakpa i karɔ̃ ɔkpi i mmɔ. <verse eid="2SA 10:18" /><verse number="19" style="v" sid="2SA 10:19" />Gɔ magara ma ɔɖuɖu lowe i Xadadezer kayirinɔ ɔnya sɔ Israel ɔɔɖe ma iso ne, manyigu Israel isobuɛ kanya makpese ma maɖabo.</para>
  <para style="p" vid="2SA 10:19">Ita i ɔwi wɔmɔ ne, ma Aramse ka mala maɔnigã sɔ maabuai ma Amonse ana.<verse eid="2SA 10:19" /></para>
  <chapter eid="2SA 10" />
  <chapter number="11" style="c" sid="2SA 11" />
  <para style="s1">David Gu Batseba Iso Itɔ̃me</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 11:1" />I kukpɛ ame ɔwi wɔ ame i magara sɛ makɛlɛ kakpã ne, David ɔsese Yoab gu igara makpakpɛ̃dze gu Israel makpakpɛ̃dze ɔɖuɖu. Mawɔra ma Amonse fiɛ maki malɔ Raba ɔmagɛ̃. Ɣɛɛ David ɔwe i Yerusalem.<verse eid="2SA 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 11:2" />Iɣɛ̃kɛlɛ iwɛ̃ ne, David ɔta i ɔ̃ karɛkɔ̃ iso sɔ si ɔnene kɛkɛĩ i igaraiyo isã. Gɔ ɔsɛ i mmɔ ne, ɔnya ɔrɔ̃go ɔwɛ̃ wɔ nto ɔpie ndu, ɔrɔ̃go ɔre situri gbaã. <verse eid="2SA 11:2" /><verse number="3" style="v" sid="2SA 11:3" />Ne David ɔpia masɛ maakarɛ sɔ nna ɔɖe ne. Ɔrɛrɛ̃ ɔɣere David sɔ, "Eliam ɔbibirɔ̃gomi Batseba wɔ nɖe Uria, Xitise ɔre ɔɖe." <verse eid="2SA 11:3" /><verse number="4" style="v" sid="2SA 11:4" />Ne David ɔpia makpabo ɔsɛ maakɔ wũ mabɔ. Gɔ ɔba i ɔ̃ kɔrɛ ne, ɔrɛgu wũ. (Ɔ̃ɔsekelera so i ɔ̃ kayomiya ame ɔro.) Ne ɔrɔ̃go ɔkpese ɔkɛlɛ iyo ne. <verse eid="2SA 11:4" /><verse number="5" style="v" sid="2SA 11:5" />Ɔrɔ̃go ɔla kayiri ne ɔsese David kanya sɔ, "Ka loto kayiri."<verse eid="2SA 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 11:6" />Ne David ɔpia sɔ maɣere Yoab sɔ, "Sese me Uria, Xitise." Ne Yoab ɔsese Uria David kɔrɛ. <verse eid="2SA 11:6" /><verse number="7" style="v" sid="2SA 11:7" />Ɔwi wɔ i Uria ɔba ne, David ɔkarɛ wũ kumɛgɔ i Yoab gu makpakpɛ̃dze ɔse gu kumɛgɔ i kakpã to kakɛlɛ. <verse eid="2SA 11:7" /><verse number="8" style="v" sid="2SA 11:8" />Ne David ɔɣere Uria sɔ, "Kɛlɛ fɔ iyo si asɛ aafere ngba." Ne ɔso Uria ɔrui i igaraiyo fiɛ igara ɔsese wũ karatã. <verse eid="2SA 11:8" /><verse number="9" style="v" sid="2SA 11:9" />Ɣɛɛ Uria ɔrɛ i igaraiyo kabɔrɛnya ku ɔ̃ ɔkɔse maɖabo ɔɖuɖu fiɛ ɔ̃ikɛlɛ ɔ̃ iyo.<verse eid="2SA 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 11:10" />Maɣere David sɔ, "Uria iikɛlɛ iyo." Ne ɔso ɔkarɛ Uria sɔ, "Iiɖe kiniɔ ame abɔrɛ i kadzorokɔ̃ aba ɣɛɛ? Be ɔso aikɛlɛ iyo?"<verse eid="2SA 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 11:11" />Ne Uria ɔɣere David sɔ, "Ndamu aɖaka gu Israel gu Yuda makpakpɛ̃dze si i akpayo ame fiɛ Yoab, kpakpɛ̃dzekpakpa gu wũ ɔkɔse makpakpɛ̃dze pia i aputu ame. Nda loakɛlɛ iyo loaɖe ara lonɛ ndã, lorɛ i wũ ɔre kɔrɛ? Lokã-ɔ sɔ loibabara ngbɔ!"<verse eid="2SA 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 11:12" />Ne David ɔɣere wũ sɔ, "Rɛ i ngbe nɔme ana si kɔrãkaɖe ne, loaɖi-ɔ ɔri." Ne ɔso Uria ɔrɛ i Yerusalem iyi nɛmɔ gu kaɖesɛã. <verse eid="2SA 11:12" /><verse number="13" style="v" sid="2SA 11:13" />David ɔkpedza wũ ɔba ɔ̃aɖegu wũ aɖera ɔnɛ ndã fiɛ David ɔmidza wũ ndã, ɣɛɛ kutsuɛ ne, Uria ɔrɛ i ɔkala iso i ɔ̃ ɔkɔse maɖabo ndɛ̃, ɔ̃ikɛlɛ ɔ̃ iyo.<verse eid="2SA 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 11:14" />Kaya ne, David ɔtsɛrɛ ɔko ɔtã Uria sɔ ɔsu ɔkɛlɛgu Yoab. <verse eid="2SA 11:14" /><verse number="15" style="v" sid="2SA 11:15" />Ɔtsɛrɛ i ɔko ame sɔ, "Su Uria sese ngbegɔ i kakpã ba ɔle. Iyɔ ne mikpese wũ i kama si tsirise si ɔɖoe wũ."<verse eid="2SA 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 11:16" />Ne ɔso gɔ Yoab ɔtã maki malɔ ɔmagɛ̃siare ne, ɔsu Uria ɔɣedza i ngbegɔ i matsirise ma mba ɔle ɔwe. <verse eid="2SA 11:16" /><verse number="17" style="v" sid="2SA 11:17" />Gɔ makpakpɛ̃dze ɔbɔrɛ i ɔmagɛ̃siare ame maba maakpɛ̃gu Yoab ne, David makpakpɛ̃dze mawɛ̃ ɔrɔ̃, fiɛ Uria, Xitise ana ɔrɔ̃ kakpã.<verse eid="2SA 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 11:18" />Yoab ɔpia sɔ masɛ maabɔ David kakpã amaniɛ. <verse eid="2SA 11:18" /><verse number="19" style="v" sid="2SA 11:19" />Ɔɣere kpabo wɔ ɔpia sɔ, "Si ɔɔbɔ igara kakpã amaniɛ wagbe aro ne, <verse eid="2SA 11:19" /><verse number="20" style="v" sid="2SA 11:20" />sianyɔ sikpã to siamɔɛ̃ wũ ɔkarɛ-ɔ sɔ, 'Be ɔso mibore mibo ɔmagɛ̃siare misɛ miakpɛ̃ ngbɔ? Miiɣe sɔ mato maapɛ mirɛ̃ mabɔrɛgu i ibere iso ɣɛɛ? <verse eid="2SA 11:20" /><verse number="21" style="v" sid="2SA 11:21" />Nna loɖoe Abimelex, Yerub-Besef ɔbibirɛrɛĩ? Iiɖe ɔrɔ̃go lokpasera kukɔtɛ i ibere iso ɔwuĩ wũ iti i Tebez fiɛ ɔkpi ɣɛɛ? Be ɔso mibore mibo ibere kumɛɔ?' Si ɔkarɛ-ɔ ngbɔ ne, ɣere wũ sɔ, 'Ana ne fɔ ɔɖabo Uria, Xitise ɔkpi.' "<verse eid="2SA 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 11:22" />Kpabo ɔɣo ɔri, ne gɔ ɔba ɔ̃abo i David kɔrɛ ne, ɔɣere wũ irabiara nɛ i Yoab ɔɣere wũ sɔ ɔɣɛ. <verse eid="2SA 11:22" /><verse number="23" style="v" sid="2SA 11:23" />Ne kpabo ɔɣere David sɔ, "Makpakpɛ̃dze ɔwe ɔle i bo iso mabɔrɛ maba maakpɛ̃ bo i karɔ̃ ndɛ̃, ɣɛɛ bosa ma bokpesegu bokɛlɛgu ɔmagɛ̃ kayogodɔ̃ kabɔrɛnya. <verse eid="2SA 11:23" /><verse number="24" style="v" sid="2SA 11:24" />Ne gɔ mapɛ fɔ maɖabo mirɛ̃ mabɔrɛgu i ibere iso ne, igara makpakpɛ̃dze mawɛ̃ ɔrɔ̃ kakpã. Ana ne, fɔ ɔɖabo Uria, Xitise ɔkpi."<verse eid="2SA 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 11:25" />Ne David ɔɣere kpabo sɔ, "Sɛ aaɣere Yoab sɔ, 'Nnɛgbe si idaaɖa-ɔ, ipɛmi sɛ iɖoe ɔbiara. Mipia kubɛ si miwɔra ɔmagɛ̃siare.' Tã Yoab katetere ku atɔ̃me wagbe."<verse eid="2SA 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 11:26" />Ɔwi wɔ i Uria ɔre ɔnɔ sɔ ɔ̃ ɔrã ɔɔkpi ne, ɔbiɛ wũ. <verse eid="2SA 11:26" /><verse number="27" style="v" sid="2SA 11:27" />Gɔ ɔ̃ɔkisi ɔ̃ ɔrã ɔro ne, David ɔtã makɔ Batseba mabɔ i ɔ̃ iyo ne ɔkpese ɔ̃ ɔre ɔɣe ɔbibirɛrɛĩ ɔtã wũ ne. Ɣɛɛ nnɛ i David ɔbara iiwe <char style="nd">Bosate</char> ɔmɛrɛ̃.<verse eid="2SA 11:27" /></para>
  <chapter eid="2SA 11" />
  <chapter number="12" style="c" sid="2SA 12" />
  <para style="s1">Natan Igbã Gu David Ifiriki</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 12:1" />
    <char style="nd">Bosate</char> ɔpia Natan David kɔrɛ. Gɔ ɔba ne, ɔɣere David sɔ, "Marɛrɛ̃ inyɔ ɔwe i ɔmagɛ̃ ɔwɛ̃ ame, ɔwɛ̃ ɔwe ara fiɛ ɔwɛ̃ ɔɖe wɛrɛba. <verse eid="2SA 12:1" /><verse number="2" style="v" sid="2SA 12:2" />Ranase ɔwe masɛrɛ gu manantsuĩ gbodzoo, <verse eid="2SA 12:2" /><verse number="3" style="v" sid="2SA 12:3" />ɣɛɛ wɛrɛba iiwe kuira iɖo sɛrɛrerɔ̃ibirɔ̃go iwɛ̃ nɛ ɔɣa. Ɔkãrarã ne fiɛ imɔ ku wũ gu ɔ̃ mabi. Ma gu ne loɖe aɖera manɛ i ikɔi iwɛ̃ ame fiɛ ila irɛ i ɔ̃ nrɔɔ̃ ame. Ise wũ kere lɛ ɔbibirɔ̃gomi.<verse eid="2SA 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 12:4" />"Kiniɔ ne iba sɔ risɛdze ɔwɛ̃ ɔba ranase kɔrɛ, ɣɛɛ ɔ̃imɔɛ̃ ɔ̃ mɔmɔ sɛrɛrerɔ̃ ɣee nantsuĩ ɔɖoe ɔwa araɖea ɔtã ɔfɔ. Ɣɛɛ ne, ɔmɔɛ̃ wɛrɛba isɛrɛbi ɔɖoe ɔbara ala sifɔ."<verse eid="2SA 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 12:5" />Sikpã ɔmɔɛ̃ David gbaã i ranase wɔmɔ iso ɔɣere Natan sɔ, "Lokã <char style="nd">Bosate</char> wɔ mpia ngbã sɔ ɔrɛrɛ̃ wɔ lobara ira nɛgbe ne, ikote sɔ ɔ̃akpi! <verse eid="2SA 12:5" /><verse number="6" style="v" sid="2SA 12:6" />Ikote sɔ ɔ̃atã isɛrɛbi kuso ikpɛ ina ala nnɛ ɔbara fiɛ iikpɛ̃ wũ nnya ɔso."<verse eid="2SA 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 12:7" />Ne Natan ɔɣere David sɔ, "Fɔ nɖe ɔrɛrɛ̃ wɔmɔ! <char style="nd">Bosate</char> wɔ nɖe Israel Ɣaa sɔ, 'Losɔla-ɔ nnɔĩ lɛ igara i Israel kaɖe iso, fiɛ loɖi-ɔ lobɔrɛgu i Saul nrɔɔ̃ ame. <verse eid="2SA 12:7" /><verse number="8" style="v" sid="2SA 12:8" />Losu mi ɔkɔse iyo lotã-ɔ fiɛ losu mi ɔkɔse mare lopia-ɔ i nrɔɔ̃ ame. Losu Israel iyo gu Yuda lotã-ɔ. Ne si nwagbe ɔɖuɖu iisi-ɔ ne, tee loatã-ɔ ara lobua. <verse eid="2SA 12:8" /><verse number="9" style="v" sid="2SA 12:9" />Be ɔso aipia <char style="nd">Bosate</char> itɔ̃me kuwarɛ fiɛ abara ikpi i ɔ̃ anɔ? Awuĩ Uria, Xitise ala ipɛmi, ne asu ɔ̃ ɔre akpesera fɔ ɔre. Aɖoe wũ ala ma Amonse ipɛmi. <verse eid="2SA 12:9" /><verse number="10" style="v" sid="2SA 12:10" />Ne ɔso kiniɔ ne, ima ifere i karɔ̃ ku ipɛmi iisibaro i fɔ iyo alasɔ aiwarɛ me, afɔ Uria ɔre akpesera fɔ mɔmɔ ɔre.'<verse eid="2SA 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 12:11" />"<char style="nd">Bosate</char> sɔ, 'I fɔ mɔmɔ iyo ame ne, loatara itikpi lopia-ɔ iso. I fɔ mɔmɔ anɔmi ame ne, loatara fɔ mare lotã ɔwɛ̃ wɔ lobore ɔmatã-ɔ fiɛ ɔ̃arɛgu ma ku kakɔme kerebee i ɔgbami. <verse eid="2SA 12:11" /><verse number="12" style="v" sid="2SA 12:12" />Abara fɔ ɔkpɛ i iwɛrɛ ame, ɣɛɛ loabara nnɛgbe ku anɔwã i Israel ɔɖuɖu anɔ.' "<verse eid="2SA 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 12:13" />Ne David ɔɣere Natan sɔ, "Lobara ikpi i <char style="nd">Bosate</char> iso."</para>
  <para style="p" vid="2SA 12:13">Ne Natan ɔtã wũ mmuai sɔ, "<char style="nd">Bosate</char> ɔɔsu fɔ ikpi ɔtsɛ-ɔ, aibakpi. <verse eid="2SA 12:13" /><verse number="14" style="v" sid="2SA 12:14" />Ɣɛɛ gɔ abara nnɛgbe ne ɔɔtã sɔ <char style="nd">Bosate</char> matsirise si manyɔ wũ pupurii, ɔbibirɛrɛĩ wɔ maaɣe matã-ɔ to ɔ̃akpi."<verse eid="2SA 12:14" /></para>
  <para style="s1">David Ɔbibirɛrɛĩ Ɔkpi</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 12:15" />Gɔ Natan ɔɔkɛlɛ ɔ̃ iyo kama ne, <char style="nd">Bosate</char> ɔsu inyɛpɛ̃ ɔpia i Uria ɔre ɔbi wɔ ɔɣe ɔtã David iso.<verse eid="2SA 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 12:16" />David ɔtã Ɣaa iti i ɔbi iti. Ɔnyikanya, kasɛ̃ ɔɖuɖu ne ɔrɛ i karɔ̃ kunu. <verse eid="2SA 12:16" /><verse number="17" style="v" sid="2SA 12:17" />Ɔ̃ iyomaturi makpakpa ɔba maapɛ wũ nrɔɔ̃ sɔ ɔta i karɔ̃, ɣɛɛ ɔsɛ̃ fiɛ ɔsɛ̃ ana sɔ ɔ̃ito ɔɖegu ma aɖera.<verse eid="2SA 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 12:18" />Ikpɛnɛ kɔdzɛva ne, ɔbi ɔkpi. David maɖabo ɔnigã sɔ maaɣere wũ sɔ ɔbi ɔkpi, alasɔ mabu sɔ, "Si ɔwi wɔ i ɔbi iikpi fiɛ ɔsɛ̃ sɔ ɔ̃ito ɔkã bo atsue ne, nda boabara fiɛ boaɣere wũ sɔ ɔbi ɔɔkpi? Ɔto ɔ̃abara so iraboa."<verse eid="2SA 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 12:19" />David ɔnya sɔ ɔ̃ maɖabo to maɣere so siwɔwɔi, ne ɔso ɔtsue sɔ ɔbi ɔɔkpi. Ne ɔkarɛ ma sɔ, "Ɔbi ne ɔkpi ɔ̃ɔkpi?'</para>
  <para style="p" vid="2SA 12:19">Ne matã wũ mmuai sɔ, "Aĩ, ɔ̃ɔkpi."<verse eid="2SA 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 12:20" />Ne David ɔta i karɔ̃. Ne ɔsɛ ɔ̃apie ndu, ɔsɔla nnɔĩ, ɔfirikira ɔ̃ awu. Ne ka ɔkɛlɛ ikpayo nɛ ɔɣedza ɔtã Ɣaa ndamu aɖaka ame, ɔsɛ ɔ̃asumu. Ne ka ɔkɛlɛ ɔ̃ iyo ne ɔkarɛ araɖea fiɛ matã wũ ɔɖe ne.<verse eid="2SA 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 12:21" />Ne ɔ̃ maɖabo ɔkarɛ wũ sɔ, "Be iɖe ato abara i ngbe ne? Gɔ ɔbi ɔwe ngbã ne, anyikanya, abiɛ, ɣɛɛ kini gɔ ɔbi ɔɔkpi ne, ɔɔta aɖe ara!"<verse eid="2SA 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 12:22" />Ne ɔtã mmuai sɔ, "Gɔ ɔbi ɔwe ngbã ne, lonyikanya fiɛ lobiɛ ala lobu sɔ, 'Siainyɔ <char style="nd">Bosate</char> to ɔ̃anyɔ me nnya ɔtã ɔbi ɔwe ngbã.' <verse eid="2SA 12:22" /><verse number="23" style="v" sid="2SA 12:23" />Ɣɛɛ kiniɔ gɔ ɔ̃ɔkpi ne, be ɔso loakɛlɛ i katɔ̃ lonyikanya? Loawo wũ ɔkpesera ɔbɔ ngbã? Mme ka loakɛlɛ ɔ̃ kɔrɛ, ɔ̃ ne ɔ̃isibakpese ɔba i wũ kɔrɛ."<verse eid="2SA 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 12:24" />Ne David ɔpia ɔ̃ ɔre Batseba kɔrɔ̃ i kayiri ɔsɛ ɔ̃ kɔrɛ ne ɔrɛgu wũ. Ɔɣe ɔbibirɛrɛĩ ɔtã wũ, ne ɔsia wũ sɔ Solomon. <char style="nd">Bosate</char> ɔɖɔɛ wũ; <verse eid="2SA 12:24" /><verse number="25" style="v" sid="2SA 12:25" />gɔ <char style="nd">Bosate</char> ɔɖɔɛ wũ ɔso ne, ɔpia kanyaɖidze Natan sɔ ɔsɛ ɔ̃asia wũ iyere sɔ Yedidia.<note caller="+" style="f"><char style="fr" closed="false">12.25 </char><char style="ft" closed="false">Yedidia: Ne karɔ̃ nɖe sɔ Bosate sɛ ɔɖɔɛ wũ </char></note><verse eid="2SA 12:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 12:26" />I ɔwi wɔgbe ame ne Yoab ana ɔkɛlɛgu i katɔ̃ ɔkpɛ̃gu Raba wɔ loɖe ma Amonse igarakpakpa ɔmagɛ̃siare. <verse eid="2SA 12:26" /><verse number="27" style="v" sid="2SA 12:27" />Ne Yoab ɔpia David makpabo sɔ maɣere wũ sɔ, "Loɔkpɛ̃gu Raba lomɔɛ̃ ma ndu kaɖukɔ̃. <verse eid="2SA 12:27" /><verse number="28" style="v" sid="2SA 12:28" />Kiniɔ ne, sira makpakpɛ̃dze tsɔra kanya si miki milɔ ɔmagɛ̃siare si mimɔɛ̃ wũ. Si iiɖe ngbɔ si lomɔɛ̃ ɔmagɛ̃ ne, iyɔ mme loafɔ iyere."<verse eid="2SA 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 12:29" />Ne ɔso David ɔsira makpakpɛ̃dze ɔɖuɖu kanya masɛ maakpɛ̃gu Raba mamɔɛ̃ ɔmagɛ̃. <verse eid="2SA 12:29" /><verse number="30" style="v" sid="2SA 12:30" />David ɔfɔ ma igaraikoto nɛ nfu i ma igara iti. Sikãrɛtɛa kukereme ɔɖe kilo sitɛ-ina masu mabaragu ala fiɛ masu ata wa lofɔ kuɣa makɛrɛ ne ala - ne masu matɔmedza David. David ɔsore kakpãramɔɛã titiiti ɔbɔrɛgu i ɔmagɛ̃siare wɔmɔ ame. <verse eid="2SA 12:30" /><verse number="31" style="v" sid="2SA 12:31" />Ɔkɔ maturi ɔɖuɖu ɔbɔrɛgu i ɔmagɛ̃siare ame ɔkpesera ma masande ma loasu saa gu awoɖikpuã gu kuɣɛ, ne ɔtã mabara karabara i biriks itu ame. David ɔbara ma Amonse simagɛ̃ ɔɖuɖu ngbɔ, ne kama ne, ma gu ɔ̃ makpakpɛ̃dze ɔɖuɖu ɔkpese makɛlɛ Yerusalem.<verse eid="2SA 12:31" /></para>
  <chapter eid="2SA 12" />
  <chapter number="13" style="c" sid="2SA 13" />
  <para style="s">Amnon Gu Ɔ̃ Ɔnyiiko Tamar Iso Itɔ̃me</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 13:1" />I ɔwi ame ne, Amnon wɔ nɖe David ɔbibirɛrɛĩ ɔtsɛ Tamar wɔ nɖe Absalom ɔnyiiko fiɛ ɔre situri iɖɔɛ. Absalom ɔ̃ wũ David ɔbibirɛrɛĩ ɔɖe.<verse eid="2SA 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 13:2" />Amnon to ɔɖɔɛ ɔ̃ ɔse ɔbibirɔ̃gomi Tamar kaɖu gɔ iɖaa wũ isɛ iabo sɔ ɔpia so ɔnyɛ ala ɔ̃ ɔnyiiko iti. Ɔbitɛ kagbɔɔ ɔɖe, ne ɔso ibara lɛ iibawo ne ame ɔba sɔ ɔ̃abara wũ ira.<verse eid="2SA 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 13:3" />Kiniɔ ne Amnon ɔwe adzunitãdze ɔwɛ̃ wɔ marɔ Yonadab wɔ nɖe Simea ɔbibirɛrɛĩ, David ɔɖeatɔ̃ ɔbi fiɛ ɔbua ɔbe anɔ i iti ame. <verse eid="2SA 13:3" /><verse number="4" style="v" sid="2SA 13:4" />Ɔkarɛ Amnon sɔ, "Be ɔso fiɛ fɔ igara ɔbibirɛrɛĩ ne, kaya biara anyɔ nnya nnya ngbɔ? Aibaɣere me?"</para>
  <para style="p" vid="2SA 13:4">Amnon ɔtã wũ mmuai sɔ, "Loto loɖɔɛ Tamar, wũ ɔse ɔbi Absalom ɔnyiiko."<verse eid="2SA 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 13:5" />Ne Yonadab ɔɣere wũ sɔ, "Kɛlɛ aarɛ i karɛkɔ̃ iso si apia so ɔnyɛ. Si fɔ ɔse ɔba ɔya-ɔ ne, ɣere wũ sɔ, 'Loabie sɔ wũ ɔnyiiko Tamar si ɔba ɔ̃abie irere ɔtã me loɖe. Tã ɔba ɔ̃awa aɖera i wũ anɔ si lonyɔ wũ si ɔ̃apia me aɖera.' "<verse eid="2SA 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 13:6" />Ne ɔso Amnon ɔpia so ɔnyɛ ɔsɛ ɔ̃arɛ, ne gɔ igara ɔba ɔya wũ ne, Amnon ɔɣere wũ sɔ, "Loabie sɔ wũ ɔnyiiko Tamar si ɔba ɔ̃afɛ̃ boɖoboɖo igbãɔ i wũ anɔ si ɔ̃apia me aɖera."<verse eid="2SA 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 13:7" />David ɔsese Tamar kanya i igaraiyo sɔ, "Kɛlɛ fɔ ɔnyiirɛrɛĩ Amnon iyo si asɛ aawa araɖea atã wũ." <verse eid="2SA 13:7" /><verse number="8" style="v" sid="2SA 13:8" />Ne ɔso Tamar ɔkɛlɛ ɔ̃ ɔnyiirɛrɛĩ Amnon wɔ nrɛ i iyo. Ɔka ɔraũ, ɔkpɔkɔtɔ fiɛ ɔfɛ̃ boɖoboɖo i Amnon katɔ̃. <verse eid="2SA 13:8" /><verse number="9" style="v" sid="2SA 13:9" />Ne ka ɔsu ɔpia i irɔi ame ɔtã wũ ne, ɣɛɛ ɔsɛ̃ sɔ ɔ̃ito ɔɖe.</para>
  <para style="p" vid="2SA 13:9">Amnon ɔɣɛ sɔ, "Ɔbiara si ɔbɔrɛ i ngbe." Ne ɔso ɔbiara ɔbɔrɛ ɔnyua wũ. <verse eid="2SA 13:9" /><verse number="10" style="v" sid="2SA 13:10" />Ne Amnon ɔɣere Tamar sɔ, "Su aɖera bɔ me i irɛyo si aba aapia me." Ne Tamar ɔsu boɖoboɖo wɔ ɔfɛ̃ ɔbɔ ɔ̃ ɔnyiirɛrɛĩ Amnon i irɛyo ne. <verse eid="2SA 13:10" /><verse number="11" style="v" sid="2SA 13:11" />Ɣɛɛ gɔ ɔsu ɔkɛlɛgu wũ si ɔɖe ne, ɔmɔɛ̃ wũ i karɔtɔ̃ ɔɣere wũ sɔ, "Ba lorɛgu-ɔ, wũ ɔnyiiko."<verse eid="2SA 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 13:12" />Ɣɛɛ Tamar ɔɣere Amnon sɔ, "Daaɣiɛ me sɔ lorɛgu-ɔ, matsiri nɛ igbã kɔkɔɔkɔ i Israel! Daabara ɔtile ira nɛgbe. <verse eid="2SA 13:12" /><verse number="13" style="v" sid="2SA 13:13" />Mme ne, lɛ loawe ku kunuarɛ? Fiɛ fɔ ne, maanyɔ-ɔ lɛ tilese wɔ loikpa anɔ i Israel. Lotã-ɔ iti ɖegu igara ika ne ɔ̃ibasɛ̃ sɔ ɔ̃ito ɔsu me ɔtã loyiri-ɔ." <verse eid="2SA 13:13" /><verse number="14" style="v" sid="2SA 13:14" />Ɣɛɛ ɔsɛ̃ ɔ̃ikã ɔ̃ ɔnyiiko atsue, ne gɔ ɔwe ɔle ɔɖo wũ ɔso ne, ɔrɛgu wũ i soɔle ame.<verse eid="2SA 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 13:15" />Ne Amnon ɔtsiri ɔ̃ ɔnyiiko ku itsiri nɛ mba ɔle. Ka ɔtsiri wũ kɔraa ɔɖo kumɛgɔ ɔɖɔɛ wũ. Ne Amnon ɔɣere Tamar sɔ, "Ta, si abɔrɛ me iyo!"<verse eid="2SA 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 13:16" />Ne Tamar ɔɣere wũ sɔ, "Ooɣo! Wũ isa iɖi i fɔ iyo aanyanyarĩ iɖo nnɛ ɔɔbara me koko."</para>
  <para style="p" vid="2SA 13:16">Ɣɛɛ ɔsɛ̃ ɔ̃ikã wũ atsue. <verse eid="2SA 13:16" /><verse number="17" style="v" sid="2SA 13:17" />Amnon ɔkpere ɔ̃ mɔmɔ ɔɖabo ɔɣere wũ sɔ, "Sa ɔrɔ̃go wɔgbe ɖi me i iyo si asɛ̃ kukui." <verse eid="2SA 13:17" /><verse number="18" style="v" sid="2SA 13:18" />Ne ɔso ɔ̃ ɔɖabo ɔkpadzɛ̃ ɔrɔ̃go ɔɖi i iyo ɔsɛ̃ kukui. Ɔbitɛ ɔpia awu tagbaraa wa makɛrɛ ku ara wa lofɔ kuɣa alasɔ ngbɔ i igara mabibitɛ kugbɔɔ ɔla maɔpia ne. <verse eid="2SA 13:18" /><verse number="19" style="v" sid="2SA 13:19" />Tamar ɔbara ndɔ̃ ɔfere so iti ame fiɛ ɔkɛkɛ awu tagbaraa kɛrɛa wa lofɔ kuɣa wa ɔpia. Ɔsore nrɔɔ̃ i iti fiɛ ɔrui, ɔto ɔbiɛ kaku teteree gɔ ɔsɛ.<verse eid="2SA 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 13:20" />Ne ɔ̃ ɔnyiirɛrɛĩ Absalom ɔkarɛ wũ sɔ, "Fɔ ɔnyiirɛrɛĩ Amnon ɔrɛgu-ɔ? Lo kaku, wũ ɔnyiiko, fɔ ɔnyiirɛrɛĩ ɔɖe. Daatã iɖaa-ɔ." Ne ɔso Tamar ka ɔwe i ɔ̃ ɔnyiirɛrɛĩ Absalom iyo ɔsɛ sikuɛdze ku isoma ame.<verse eid="2SA 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 13:21" />Gɔ Igara David ɔnɔ itɔ̃me nɛgbe ne, ikpɛ̃ wũ sikpã gbaã. <verse eid="2SA 13:21" /><verse number="22" style="v" sid="2SA 13:22" />Absalom iiɣere Amnon kuira, isɛɛ oo ilalaa oo, ɣɛɛ ɔtsiri wũ alasɔ ɔpia ɔ̃ ɔnyiiko Tamar kunuarɛ.<verse eid="2SA 13:22" /></para>
  <para style="s1">Absalom Ɔɖoe Amnon</para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 13:23" />Akɔ anyɔ kama gɔ mma nto makparɛ̃ Absalom masɛrɛ siwɛrɛ̃ ɔwe i Baal Xazor i Efrayim kume iso ne, Absalom ɔkpere igara mabibirɛrɛĩ ɔɖuɖu sɔ maba i mmɔ. <verse eid="2SA 13:23" /><verse number="24" style="v" sid="2SA 13:24" />Absalom ɔsɛ ɔ̃aɣere igara David kɔrɛ sɔ, "Mma nto makparɛ̃ fɔ ɔɖabo masɛrɛ siwɛrɛ̃ ɔɔba. Lotã-ɔ iti ne, mi gu fɔ maakpakpa si miba miabua me."<verse eid="2SA 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 13:25" />Ne ɔ̃ ɔse ɔɣɛ sɔ, "Ooɣo, wũ ɔbi bo ɔɖuɖu iibakɛlɛ, boto boakpese ato botã-ɔ." Atoasɔ Absalom ɔɣiɛ wũ ne, ɔsɛ̃, ɣɛɛ ɔtã wũ ɔ̃ kusɛkusɛ.<verse eid="2SA 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 13:26" />Ne Absalom ɔɣere ɔ̃ ɔse sɔ, "Si fɔ aito aba ne, iyɔ tã wũ ɔɖeatɔ̃ Amnon si ɔba bokɛlɛ."</para>
  <para style="p" vid="2SA 13:26">Ne igara ɔkarɛ wũ sɔ, "Be ɔso si ɔsɛgu mi?" <verse eid="2SA 13:26" /><verse number="27" style="v" sid="2SA 13:27" />Ɣɛɛ Absalom ɔɣiɛ wũ ne ɔso ɔnɔ karɔ̃ Amnon gu igara mabibirɛrɛĩ tsɔra ɔsɛgu wũ.<verse eid="2SA 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 13:28" />Ne Absalom ɔɣere ɔ̃ maɖabo sɔ, "Mikã atsue! Si Amnon ɔɔnɛ ndã fiɛ ka ɔto ɔrɛ̃ fiɛ loɣere mi sɔ, 'Miwuĩ Amnon ira ne,' si miɖoe wũ. Midaanigã, mme nto lopia mi. Miwe ɔle si miwe kagbegbe." <verse eid="2SA 13:28" /><verse number="29" style="v" sid="2SA 13:29" />Ne ɔso Absalom maturi ɔbara Amnon nnɛ Absalom ɔɣere ma sɔ mabara. Ne igara mabi ɔɖuɖu ɔta masɛ i ma mafirimu iso matere ne.<verse eid="2SA 13:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 13:30" />Gɔ masɛ i ɔri ne, ipɛ i David i kutsue sɔ, "Absalom ɔɔɖoe igara mabibirɛrɛĩ ɔɖuɖu, kuwɛ̃ iikuti." <verse eid="2SA 13:30" /><verse number="31" style="v" sid="2SA 13:31" />Igara ɔta ɔya ɔkɛkɛ ɔ̃ awu, ɔkɛlɛ ɔrɛ i karɔ̃ kunu, ɔ̃ maɖabo ma nɣɛ i ɔ̃ kɔrɛ ɔɖuɖu ɔkɛkɛ ma awu.<verse eid="2SA 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 13:32" />Ɣɛɛ Yonadab, Simea wɔ nɖe David ɔnyiibirɛrɛ̃ ɔbi ɔɣɛ sɔ, "Sate si ɔdaafɔ ɔɖe sɔ maɖoe igara mabibirɛrɛĩ ɔɖuɖu, Amnon kere lokpi. Nnɛgbe loɔɖe Absalom adzuni ita i iyi nɛ i Amnon ɔrɛgu ɔ̃ ɔnyiko Tamar ne. <verse eid="2SA 13:32" /><verse number="33" style="v" sid="2SA 13:33" />Wũ ɔkɔse igara si ɔdaafɔ ɔɖe sɔ igara mabibirɛrɛĩ ɔɖuɖu ɔkpi. Amnon ɔnɔwɛ̃ kere lokpi."<verse eid="2SA 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2SA 13:34" />Ɔwi wɔmɔ ame ne, Absalom ɔɔtere.</para>
  <para style="p" vid="2SA 13:34">Ɔrɛrɛ̃ wɔ nɣɛ i kadzuɛkɔ̃ iso ɔnyɔ ne ɔnya sɔ maturi gbodzoo to maso kabemi maba i ɔri iso i ɔ̃ kuɣɛ̃iyokabokɔ̃ isɛ. Ne dzuɛ̃se ɔsɛ ɔ̃aɣere igara sɔ, "Lonya maturi i Xoronaim isɛ i kabemi iso."<verse eid="2SA 13:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2SA 13:35" />Ne Yonadab ɔɣere igara sɔ, "Loiɣere-ɔ? Nyɔ igara mabibirɛrɛĩ ɔɔba i ngbe; iba lɛ kumɛgɔ i fɔ ɔɖabo ɔɣɛ."<verse eid="2SA 13:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2SA 13:36" />Si ɔ̃aɣɛ ɔro ne, igara mabibirɛrɛĩ ɔɔba maabo, mato mabiɛ teteree. Igara ana, gu ɔ̃ maɖabo ɔɖuɖu ɔbiɛ boroboroboro.<verse eid="2SA 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="2SA 13:37" />Absalom ɔtere ɔkɛlɛ Talmai, Amixud ɔbibirɛrɛĩ wɔ nɖe Gesur igara kɔrɛ. Ɣɛɛ David ɔbiɛ ɔ̃ ɔbibirɛrɛĩ Amnon ayi gbodzoo.<verse eid="2SA 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="2SA 13:38" />Gɔ Absalom ɔtere ɔkɛlɛ Gesur ne, ɔwe i mmɔ akɔ atɛ.<verse eid="2SA 13:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="2SA 13:39" />Gɔ i David ɔɔbiɛ Amnon ɔro fiɛ iɔlɛ wũ ne, ɔtsɛ Absalom inyigi.<verse eid="2SA 13:39" /></para>
  <chapter eid="2SA 13" />
  <chapter number="14" style="c" sid="2SA 14" />
  <para style="s1">Yoab Ɔkpesera Absalom Ɔbɔ Yerusalem</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 14:1" />Yoab, Zeruya ɔbibirɛrɛĩ ɔtsue sɔ igara to ɔnyigi Absalom. <verse eid="2SA 14:1" /><verse number="2" style="v" sid="2SA 14:2" />Ne ɔso Yoab ɔpia masɛ maakɔ ɔrɔ̃go nɔgbadze ɔwɛ̃ mabɔrɛgu i Tekoa mabɔ. Ne ɔɣere wũ sɔ, "Bara so lɛ ɔrɔ̃go wɔ nto ɔkisi ɔ̃ maturi ayi gbodzoo si apia kaku ara. Daaledza so asɔla nnɔĩ. <verse eid="2SA 14:2" /><verse number="3" style="v" sid="2SA 14:3" />Iyɔ kɛlɛ igara kɔrɛ si asɛ aaɣere wũ atɔ̃me wagbe." Ne Yoab ɔɣere wũ nnɛ ɔ̃asɛ ɔ̃aɣɛ ne.<verse eid="2SA 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 14:4" />Ne ɔrɔ̃go wɔ lobɔrɛ i Tekoa ɔkɛlɛ igara kɔrɛ, ɔkɛlɛ ɔrɛ ɔfu anɔ i karɔ̃ i kuwarɛ ame ɔtã igara ɔɣere wũ sɔ, "O Igara, buai me!"<verse eid="2SA 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 14:5" />Igara ɔkarɛ wũ sɔ, "Be nto iɖaa-ɔ?"</para>
  <para style="p" vid="2SA 14:5">Ne ɔrɔ̃go ɔtã mmuai sɔ, "Gbaã ne kuɛdze loɖe, wũ ɔrã ɔɔkpi. <verse eid="2SA 14:5" /><verse number="6" style="v" sid="2SA 14:6" />Fɔ ɔɖabo ɔwe mabibirɛrɛĩ inyɔ, matsɛ ikpɛ̃ i karɔ̃ iputu ame gɔ kuwɛ̃ na gɔ ɔ̃akpura ma, ne ɔwɛ̃ ɔwuĩ ɔ̃ ɔnyiibi ira fiɛ ɔkpi ne. <verse eid="2SA 14:6" /><verse number="7" style="v" sid="2SA 14:7" />Kiniɔ ne, kalɛ ɔɖuɖu ɔɔta maɣɛ i fɔ ɔɖabo iso maɣɛ sɔ, 'Ɖi fɔ ɔbi wɔ loɖoe ɔ̃ ɔnyiibi bɔ si boɖoe wũ botikuso i ɔ̃ ɔnyiibi wɔ ɔɖoe iti, iyɔ boɔwɔra biarase ana.' Mabie sɔ maanidza itɔgirĩ nɛ ame ka mba ɔtɔ i wũ iyo matã sɔ wũ ɔrã iyere gu ɔkparɛ aayu i karɔ̃ iso."<verse eid="2SA 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 14:8" />Ne igara ɔɣere ɔrɔ̃go sɔ, "Kɛlɛ iyo ne loto loatã mmara i fɔ kanya."<verse eid="2SA 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 14:9" />Ɣɛɛ ɔrɔ̃go wɔ lobɔrɛ i Tekoa ɔɣere wũ sɔ, "Wũ ɔkɔse igara si ɔtã iɣɛrɛ si iba bo gu wũ ɔse iyomaturi iso, ipɔ si ire ɔ̃ sigaraiyara kama dzoroo."<verse eid="2SA 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 14:10" />Ne igara ɔtã mmuai sɔ, "Si ɔrere ɔɣere-ɔ irere ne, kɔ wũ bɔ me, iyɔ ɔ̃isibakarɛ-ɔ kuira ana."<verse eid="2SA 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 14:11" />Kere ne ɔrɔ̃go ɔɣɛ sɔ, "Igara si ɔkã <char style="nd">Bosate</char> wɔ nɖe ɔ̃ Ɣaa sɔ ɔtɛ̃ nwɔ loati wũ ɔbi kpise kuso ɔri si ɔ̃ibabɔ iwɔ ɔbua, si wũ ɔbibirɛrɛĩ ɔbi wɔ lokuti iibakpi."</para>
  <para style="p" vid="2SA 14:11">Ne igara ɔɣɛ sɔ, "Lokã sɔ ayi kumɛgɔ i <char style="nd">Bosate</char> si ngbã ne, fɔ ɔbi iti ɔwɛrɛ̃ kuwɛ̃ iibakpase ɔse i karɔ̃."<verse eid="2SA 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 14:12" />Kere ne ɔrɔ̃go ɔɣɛ sɔ, "Tã fɔ ɔɖabo si ɔɣere wũ ɔkɔse igara itɔ̃me iwɛ̃."</para>
  <para style="p" vid="2SA 14:12">Ne igara ɔtã mmuai sɔ, "Ɣɛ nnɛ aba."<verse eid="2SA 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 14:13" />Ne ɔrɔ̃go ɔɣɛ sɔ, "Ne iyɔ be ɔso fiɛ abara ira nɛgbe igbã i Ɣaa maturi iso? Si igara ɔɖeika lɛgbe ne, ɔ̃ɔtã so ipɔ gɔ ɔ̃ikpesera ɔ̃ ɔbi wɔ ɔsɛ̃ ɔbɔ. <verse eid="2SA 14:13" /><verse number="14" style="v" sid="2SA 14:14" />Lɛ kumɛgɔ si ndu ɔwiri mifere i karɔ̃ maisibawo me ɔbodza ne, ngbɔ boakpi ne. Ɣɛɛ iiɖe ngbɔ i Ɣaa to ɔbie, ɣɛɛ ɔsɛ ɔbie ɔri wɔ iso ɔ̃akpesera ɔturi wɔ masa i ɔ̃ kɔrɛ ɔbɔ.<verse eid="2SA 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 14:15" />"Fiɛ kiniɔ ne, loba loɣere wũ ɔkɔse igara nnɛgbe alasɔ maturi to mapia me ifɔ̃. Ne ɔso fɔ ɔɖabo ɔbu sɔ, 'Loaɖegu igara ika siainyɔ ɔto ɔ̃abara nnɛ loto lokarɛ ɔtã me. <verse eid="2SA 14:15" /><verse number="16" style="v" sid="2SA 14:16" />Siainyɔ igara to ɔ̃aɖi ɔ̃ ɔɖabo ɔbɔrɛgu i nwɔ nto ɔbie sɔ ɔ̃aɖoe bo gu wũ ɔbi ɔɖi i Ɣaa kaɖekɔ̃ ga ɔtã bo iso.'<verse eid="2SA 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 14:17" />"Kiniɔ ne, fɔ ɔɖabo sɔ, 'Wũ ɔkɔse igara itɔ̃me nɛ ɔɣɛ si itã sɔ kuwɛ̃ iibapɛgu wũ kaɖekɔ̃ alasɔ wũ ɔkɔse igara ne, ɔse lɛ Ɣaa kpabo wɔ nɣe isɛɛ gu ilalaa. <char style="nd">Bosate</char> wɔ nɖe fɔ Ɣaa si ɔwegu-ɔ.' "<verse eid="2SA 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 14:18" />Ne igara ɔɣere ɔrɔ̃go sɔ, "Nnɛ loto loba loakarɛ-ɔ ne, daasɛ̃ sɔ aito atã me ne mmuai."</para>
  <para style="p" vid="2SA 14:18">Ne ɔrɔ̃go ɔɣɛ sɔ, "Wũ ɔkɔse igara si ɔɖeika."<verse eid="2SA 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 14:19" />Ne igara ɔkarɛ sɔ, "Yoab kɔrɔ̃ na i nnɛgbe ɔɖuɖu ame ɣɛɛ?"</para>
  <para style="p" vid="2SA 14:19">Ne ɔrɔ̃go ɔtã mmuai sɔ, "Lokã wũ ɔkɔse igara sɔ, kuwɛ̃ iibawo ɔfiriki ɔkɛlɛ kuɖearɔ̃ ɣee kubena i nnɛ wũ ɔkɔse igara ɔɣɛ iso. Aĩ, fɔ ɔɖabo Yoab lopia me sɔ lobara ngbɔ, fiɛ ɔ̃ lopia fɔ ɔɖabo atɔ̃me i kanya. <verse eid="2SA 14:19" /><verse number="20" style="v" sid="2SA 14:20" />Fɔ ɔɖabo Yoab ɔbara ngbɔ si ɔfirikira nnɛ nto kiniɔ. Wũ sate ba iwola lɛ Ɣaa kpabo - ɔɣe irabiara nɛ nto i karɔ̃ iso."<verse eid="2SA 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 14:21" />Ne igara ɔɣere Yoab sɔ, "Lonɔ, loabara kumɛɔ, kɛlɛ aakɔ Absalom bɔ."<verse eid="2SA 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 14:22" />Yoab ɔkɛlɛ ɔrɛ i igara katɔ̃ i kuwarɛ ame, ɔfere igara kusɛkusɛ. Ne Yoab ɔɣɛ sɔ, "Nɔme fɔ ɔɖabo to ɔtsue sɔ ɔ̃ ara ɔbo wũ ɔkɔse igara anɔ alasɔ igara ɔtɔrã ɔsia i nnɛ ɔ̃ ɔɖabo ɔkarɛ iso."<verse eid="2SA 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 14:23" />Ne Yoab ɔkɛlɛ Gesur ɔsɛ ɔ̃akɔ Absalom ɔkpesegu ɔbɔ Yerusalem ne. <verse eid="2SA 14:23" /><verse number="24" style="v" sid="2SA 14:24" />Ɣɛɛ igara ɔɣɛ sɔ, "Ɔkɛlɛ ɔ̃ mɔmɔ iyo, ɔdaanya me katɔ̃." Ne ɔso Absalom ɔkɛlɛ ɔ̃ iyo, ɔ̃inya igara katɔ̃.<verse eid="2SA 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 14:25" />I Israel ɔɖuɖu ne, kuwɛ̃ na gɔ masɛ male ɔ̃ situri ire lɛ Absalom. Ita i ɔ̃ itititɛ̃ iba i ɔ̃ ngbatata ne, ikparĩ kuiwɛ̃ na wũ iso. <verse eid="2SA 14:25" /><verse number="26" style="v" sid="2SA 14:26" />Ɔwi ɔrere si ɔkparɛ̃ iti ne ɔla ɔ̃ɔkere sɛ̃ fiɛ sɛ̃ kukereme ɔfɔ lɛ kilo inyɔ gu ira lɛ masɛ kere ara i igara kusɛme. Ɔla ɔ̃akparɛ̃ iti ɔwi ku ɔwi si ka siba ɔrɔrã siɖo wũ.<verse eid="2SA 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 14:27" />Maɣe mabibirɛrɛĩ itɛ gu ɔbibirɔ̃gomi ɔwɛ̃ matã Absalom. Ɔ̃ ɔbibirɔ̃gomi iyere nɖe Tamar fiɛ ɔba ɔ̃akpese ɔrɔ̃go wɔ lore situri gbaã.<verse eid="2SA 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 14:28" />Absalom ɔwe i Yerusalem akɔ anyɔ, ɔ̃inya igara katɔ̃. <verse eid="2SA 14:28" /><verse number="29" style="v" sid="2SA 14:29" />Ne ɔpia sɔ makpere Yoab mabɔ si ɔpia wũ igara kɔrɛ, ɣɛɛ Yoab iisɛ ɔ̃ kɔrɛ. Ɔpia wũ ɔturi ɔkpɛ nyɔare, Yoab ɔsɛ̃ ɔ̃isɛ ɔ̃ kɔrɛ. <verse eid="2SA 14:29" /><verse number="30" style="v" sid="2SA 14:30" />Ne Absalom ɔɣere ɔ̃ maɖabo sɔ, "Minya Yoab kamɔ kakpɛkɔ̃ ga mpia i wũ kare kɔrɛ i mmɔ, misɛ miapia kã ɔtɔ." Ne ɔso Absalom maɖabo ɔpia kakpɛkɔ̃ ɔtɔ.<verse eid="2SA 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 14:31" />Ne Yoab ɔkɛlɛ Absalom iyo ɔsɛ ɔ̃akarɛ wũ sɔ, "Be ɔso i fɔ maɖabo ɔpia wũ kakpɛkɔ̃ ɔtɔ?"<verse eid="2SA 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 14:32" />Ne Absalom ɔɣere Yoab sɔ, "Nyɔ, lopia-ɔ ɔturi sɔ, 'Ba si lopia-ɔ asɛ aakarɛ igara sɔ, "Be ɔso atã lobɔrɛ i Gesur loba, si lodaaba kɔraa tee ilɛ me iɖo!" 'Kiniɔ ne, loto lobie sɔ lonya igara ku anɔ, si loɖe ipɔ ne, si ɔɖoe me."<verse eid="2SA 14:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 14:33" />Ne ɔso Yoab ɔsɛ ɔ̃aɣere igara ngbɔ. Ne igara ɔpia Absalom maturi fiɛ ɔba ɔ̃abɔitikarɔ̃ ɔtã igara ne. Ne igara ɔfiɔ̃ wũ irɛkpo ne.<verse eid="2SA 14:33" /></para>
  <chapter eid="2SA 14" />
  <chapter number="15" style="c" sid="2SA 15" />
  <para style="s1">Absalom Ɔbara Itaiyaiso Adzuni</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 15:1" />Iifɔ ɔwi ne, Absalom ɔbie kabore ga i apɔngɔ sɛ akpadzɛ̃ gu apɔngɔ gu isomadzuɛ̃se siru ma lotere maɖe wũ katɔ̃ ɔtã so. <verse eid="2SA 15:1" /><verse number="2" style="v" sid="2SA 15:2" />Ɔla ɔ̃ata kaya tutuutu ɔsɛ ɔ̃aya i ɔvurã wɔ nkpa ɔmagɛ̃siare kayogodɔ̃. Ɔwi ɔrere si ɔturi ɔsu itɔ̃me ɔbɔ sɔ igara si ɔɣɛ ɔtã wũ ne, Absalom ɔ̃akarɛ wũ sɔ, "Kameɖe abɔrɛ?" Nwɔmɔ ɔ̃atã mmuai sɔ, "Fɔ ɔɖabo ɔbɔrɛ i Israel kamele kawɛ̃ ame." <verse eid="2SA 15:2" /><verse number="3" style="v" sid="2SA 15:3" />Kere ne Absalom ɔ̃aɣere wũ sɔ, "Nyɔ fɔ itɔ̃me nɛ iso aɣɛ ɔya fiɛ ilɛ, ɣɛɛ kuwɛ̃ na i igara kanya ɔ̃anɔ fɔ itɔ̃me." <verse eid="2SA 15:3" /><verse number="4" style="v" sid="2SA 15:4" />Iyɔ Absalom ɔ̃akɛlɛgu i katɔ̃ sɔ, "Ɔbara maabara me tɔ̃meɣɛdze i kaɖe ame fiɛ! Iyɔ tee ɔbiara wɔ mba itɔ̃me aaba i wũ kɔrɛ loɣɛ lotã ma i ɔri iso."<verse eid="2SA 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 15:5" />Ana ne, si ɔrere ɔbore ɔbo wũ si ɔbɔitikarɔ̃ ɔtã wũ ne, Absalom ɔ̃aɖi kɔrɔ̃ ɔmɔɛ̃ nwɔmɔ ɔfiɔ̃ wũ irɛkpo. <verse eid="2SA 15:5" /><verse number="6" style="v" sid="2SA 15:6" />Ngbɔ i Absalom ɔbara i Israel mabi ma ɔɖuɖu losu ma atɔ̃me mabɔ igara sɔ ɔɣɛ ɔtã ma ne. Ɔki i ɔri wɔgbe iso ɔyu Israel maturi situ.<verse eid="2SA 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 15:7" />Akɔ ana<note caller="+" style="f"><char style="fr" closed="false">15.7 </char><char style="ft" closed="false">Akɔ ana: Kakɔi ne iɖe akɔ sina </char></note> kama ne, Absalom ɔɣere igara sɔ, "Tã me lokɛlɛ Xebron loaɖi ndamu mɛ lokã lotã <char style="nd">Bosate</char>. <verse eid="2SA 15:7" /><verse number="8" style="v" sid="2SA 15:8" />Ɔwi wɔ i fɔ ɔɖabo ɔwe i Gesur i Aram ne, lokã ndamu mɛgbe sɔ, 'Si <char style="nd">Bosate</char> ɔkpesera me ɔkɛlɛgu Yerusalem ne, loasɛ loasumu <char style="nd">Bosate</char> i Xebron.' "<verse eid="2SA 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 15:9" />Ne igara ɔɣere wũ sɔ, "Kɛlɛ i isobuɛ ame." Ne ɔso ɔkɛlɛ Xebron.<verse eid="2SA 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 15:10" />Ne Absalom ɔpia makpabo i Israel kumele ɔɖuɖu kɔrɛ i iwɛrɛ ame sɔ maɣɛ sɔ, "Kumɛgɔ ame mianɔ kudadã ɔkparĩ ne, iyɔ miɣɛ sɔ, 'Absalom ka ɔɖe igara i Xebron.' " <verse eid="2SA 15:10" /><verse number="11" style="v" sid="2SA 15:11" />Marɛrɛ̃ alafa anyɔ ma lobɔrɛ i Yerusalem ɔsiai Absalom. Makpedza ma sɔ maba kere, ɣɛɛ maiɣe kuira i nnɛ nto ikɛlɛ i katɔ̃. <verse eid="2SA 15:11" /><verse number="12" style="v" sid="2SA 15:12" />Gɔ ame i Absalom to ɔsɔrɛ ara ɔtã Ɣaa ne, ɔpia sɔ masɛ maakpere Axitofel ana, Gilonse wɔ loɖe David adzunitãdze mabɔrɛgu i ma aɖe Gilo mabɔ. Ne ɔso adzuni nyanyariã wa ɔɖo ɔwe ɔle abua, fiɛ Absalom masiaidze ɔlagu isi ibua.<verse eid="2SA 15:12" /></para>
  <para style="s1">David Ɔtere I Yerusalem</para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 15:13" />Kpabo ɔwɛ̃ ɔba ɔ̃aɣere David sɔ, "Israel kaɖe ka masiai i Absalom kama."<verse eid="2SA 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 15:14" />Kere ne David ɔɣere ɔ̃ makpakpa ma lowegu wũ i Yerusalem sɔ, "Mita ku siwa! Ikote sɔ bo ɔɖuɖu aatere ɔluwɛ̃ si iiɖe ngbɔ boto boawɔ i Absalom nrɔɔ̃ ame. Ikote sɔ boarui ɔluwɛ̃ si iiɖe ngbɔ ɔto ɔ̃apɛsiwa ɔtere ɔfe bo ɔwɔra bo, ɔwɔra ɔmagɛ̃siare ku ipɛmi ana."<verse eid="2SA 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 15:15" />Igara makpakpa ɔtã igara mmuai sɔ, "Fɔ maɖabo ɔɔledza so sɔ maabara irabiara nɛ i bo ɔkɔse igara ɔɣɛ."<verse eid="2SA 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 15:16" />Igara ɔɣo ɔri, fiɛ ɔ̃ iyomaturi ɔɖuɖu ɔsiai wũ, ɣɛɛ ɔnyua ɔ̃ masɔrɔ̃ iweo ɔsɛ sɔ manyɔ igaraiyo iso. <verse eid="2SA 15:16" /><verse number="17" style="v" sid="2SA 15:17" />Ne ɔso igara ɔɣo ɔri, maturi ɔɖuɖu ɔsiai wũ fiɛ masɛ maatuĩ i igu kɛkɛĩ i kabenya. <verse eid="2SA 15:17" /><verse number="18" style="v" sid="2SA 15:18" />Ɔ̃ makpakpɛ̃dze ɔɖuɖu ɔsu so mate igara, ma Keretse ɔɖuɖu, gu ma Peletse<note caller="+" style="f"><char style="fr" closed="false">15.18 </char><char style="ft" closed="false">Ma Keretse gu ma Peletse: Maɖe mafɔ makpakpɛ̃dze ma mala maɔsu ɔpaa. </char></note> gu ma Gitise alafa akuɔ ɔɖuɖu ma losiai wu ɔbɔrɛ i Gat ɔsu so mate igara.<verse eid="2SA 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 15:19" />Ne igara ɔɣere Itai, Gitise sɔ, "Be ɔso fiɛ aasiai bo? Kpese kɛlɛ aawegu igara Absalom. Ɔfɔ aɖe, ɔfɔrɔĩ wɔ masa i kaa aɖe. <verse eid="2SA 15:19" /><verse number="20" style="v" sid="2SA 15:20" />Kɔmakaɖe kere aba. Ne ka loatã asiai bo akiki gɔ mme kɔraa loiɣe ngbegɔ losɛ? Kpesegu fɔ karɔ̃ maturi si mikɛlɛ. <char style="nd">Bosate</char> si ɔbara mi kayiribielea si ɔɖe ɔnukuare ɔtã mi."<verse eid="2SA 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 15:21" />Ɣɛɛ Itai ɔtã igara mmuai sɔ, "Lokã <char style="nd">Bosate</char>, fiɛ ayi kumɛgɔ i wũ ɔkɔse igara si ngbã ne, kakɔi biara ga i wũ ɔkɔse igara aakɛlɛ, kukpi oo ngbã oo ne, mmɔ i fɔ ɔɖabo aawe ne."<verse eid="2SA 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 15:22" />David ɔɣere Itai sɔ, "Kɛlɛ katɔ̃, sɛ kɛlɛ." Ne ɔso Itai Gatse gu ɔ̃ maturi ɔɖuɖu gu ma ayomaturi ma lowe i ɔ̃ kɔrɛ ɔrui masiai wũ.<verse eid="2SA 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 15:23" />Mma ɔɖuɖu nsi i kusɛkɔ̃ i karɔ̃ iso ɔbiɛ teteree gɔ i igra gu maturi to mafe. Igara ana ɔwara Kidron Kagbolomi fiɛ maturi ɔɖuɖu ɔsɔ̃ iti fafuĩ ame isɛ.<verse eid="2SA 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 15:24" />Zadok ana ɔwe i mmɔ fiɛ ma Levise ɔɖuɖu ma lowegu wũ ɔsore Ɣaa ndamu aɖaka. Masora Ɣaa aɖaka masɛ fiɛ Abiatar ɔsɔrɛ ara gbɔgbɔɔgbɔ maturi ɔɖuɖu ɔbɔrɛ i ɔmagɛ̃siare ame maro.<verse eid="2SA 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 15:25" />Kere ne igara ɔɣere Zadok sɔ, "Mikpesera Ɣaa ndamu aɖaka mikɛlɛgu ɔmagɛ̃siare ame. Si wũ ara ɔbo <char style="nd">Bosate</char> anɔ ne, ɔto ɔ̃akpesera me ɔbɔ fiɛ ɔ̃atã lonya wã gu ɔ̃ kasɛkɔ̃ ana. <verse eid="2SA 15:25" /><verse number="26" style="v" sid="2SA 15:26" />Ɣɛɛ si ɔɣɛ sɔ, 'Fɔ ara iibo me anɔ' ne, lotɔrã sɔ ɔbara me nnɛ nlɛ wũ."<verse eid="2SA 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 15:27" />Igara ɔɣere sɔrɛdze Zadok ana sɔ, "Iiɖe kanyaara aɖe ɣɛɛ? Kpese kɛlɛ ɔmagɛ̃siare ame i isobuɛ ame, ku fɔ ɔbibirɛrɛĩ Aximaz gu Yonatan, Abiatar ɔbibirɛrɛĩ. Mi gu Abiatar si mikpese mikɛlɛ gu mi mabibirɛrɛĩ inyɔ ɔɖuɖu. <verse eid="2SA 15:27" /><verse number="28" style="v" sid="2SA 15:28" />Loawe losia i ngbegɔ masɛ mawara ɔwore makɛlɛ fafuĩ ame gbɔgbɔɔgbɔ miasese me kanya." <verse eid="2SA 15:28" /><verse number="29" style="v" sid="2SA 15:29" />Ne ɔso Zadok gu Abiatar ɔkpesegu Ɣaa ndamu aɖaka makɛlɛgu Yerusalem fiɛ mawe i mmɔ.<verse eid="2SA 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 15:30" />Ɣɛɛ David ɔkɛlɛgu ɔsɛ katɔ̃ ɔya Oliva Kube, ɔto ɔbiɛ gɔ ɔsɛ. Ɔfu so ara iti fiɛ ɔsɛ ngba kunu lɛ ikparĩ itã imararãso. Maturi ɔɖuɖu ma lowegu wũ ɔfu so ara i ma ati ma wũ fiɛ mato mabiɛ gɔ masɛ mato maya makɛlɛ. <verse eid="2SA 15:30" /><verse number="31" style="v" sid="2SA 15:31" />Maba maaɣere David sɔ, "Axitofel pia i mma gu Absalom lota maɣɛ-ɔ iso ame." Ne ɔso David ɔkparamakayi ɔɣɛ sɔ, " O <char style="nd">Bosate</char>, tã sɔ Axitofel adzuni wa ɔ̃atã si akpese adzunisɛ̃ra."<verse eid="2SA 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 15:32" />Gɔ David ɔya kube ɔbo i itititɛ̃ ngbegɔ i maturi ɔla maɔsumu Ɣaa ku ɔwiɔ ne, Xusai wɔ lobɔrɛ i Arki ɔwe i mmɔ si ɔsarɛgu wũ, ɔkɛkɛ ɔ̃ awu, ɔpia so ɔsebu i iti. <verse eid="2SA 15:32" /><verse number="33" style="v" sid="2SA 15:33" />Ne David ɔɣere wũ sɔ, "Si asiai me ne, ato kere aakpese atã me. <verse eid="2SA 15:33" /><verse number="34" style="v" sid="2SA 15:34" />Ɣɛɛ si akpese akɛlɛ ɔmagɛ̃siare ame fiɛ aɣere Absalom sɔ, 'O igara loaɖe fɔ ɔɖabo; fɔ ɔse ɔɖabo loɖe ku ɔwiɔ, ɣɛɛ kiniɔ ne, loaɖe fɔ ɔɖabo,' si abara ngbɔ ne, iyɔ ato aabuai me akpɔkpɔtɔra Axitofel adzuni wa ɔ̃atã. <verse eid="2SA 15:34" /><verse number="35" style="v" sid="2SA 15:35" />Masɔrɛdze Zadok gu Abiatar to maawegu-ɔ i mmɔ. Ɣere ma irabiara nɛ aanɔ i igaraiyo. <verse eid="2SA 15:35" /><verse number="36" style="v" sid="2SA 15:36" />Ma mabibirɛrɛĩ inyɔ, Zadok ɔbibirɛrɛĩ, Aximaz gu Abiatar ɔbibirɛrɛĩ, Yonatan pia i ma kɔrɛ. Si anɔ irere ne, pia ma si maba maaɣere me."<verse eid="2SA 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="2SA 15:37" />Ne ɔso Xusai wɔ nɖe David ɔlaa ɔba ɔ̃abo Yerusalem ku ɔwi wɔ i Absalom to ɔbo i ɔmagɛ̃siare ame.<verse eid="2SA 15:37" /></para>
  <chapter eid="2SA 15" />
  <chapter number="16" style="c" sid="2SA 16" />
  <para style="s1">David Gu Ziba Iso Itɔ̃me</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 16:1" />Ɔwi wɔ i David ɔɔfe kube itititɛ̃ kɛkɛĩ ne, Ziba wɔ lonyɔ Mefiboset ara iso ɔya ɔsia sɔ ɔ̃asarɛgu wũ. Ɔsɛgu mafirimu gbodzoo ma losore boɖoboɖo akuri alafa anyɔ, wainabikorea akpano kulafa gu aboi akpano kulafa gu ndã kabui.<verse eid="2SA 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 16:2" />Ne igara ɔkarɛ Ziba sɔ, "Be ɔso abɔ ara wagbe?"</para>
  <para style="p" vid="2SA 16:2">Ne Ziba ɔtã mmuai sɔ, "Lobɔ mafirimu sɔ igara iyomaturi si masɛ iso, boɖoboɖo gu adziribi ana ne si makpakpɛ̃dze aaɖe, si misu ndã mitã mma iaɖa i fafuĩ ame si mana ɔle."<verse eid="2SA 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 16:3" />Ne igara ɔkarɛ sɔ, "Ne i ɖe fɔ ɔkɔse ɔwabirɛrɛĩ?"</para>
  <para style="p" vid="2SA 16:3">Ziba ɔtã wũ mmuai sɔ, "Ɔpia i Yerusalem alasɔ ɔbu sɔ, 'Nɔme Israel kaɖe to maakpesera wũ ɔwa sigarakaɖekɔ̃ matã me.' "<verse eid="2SA 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 16:4" />Kere ne igara ɔɣere Ziba sɔ, "Nnɛ ɔɖuɖu nɖe Mefiboset ire ɔɔkpese fɔ ɔkpɛ kiniɔ."</para>
  <para style="p" vid="2SA 16:4">Ne Ziba ɔɣɛ sɔ, "Lobɔitikarɔ̃ lotã-ɔ lo, tã wũ ara si abo wũ ɔkɔse igara anɔ."<verse eid="2SA 16:4" /></para>
  <para style="s1">Simei Ɔgbarĩ David</para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 16:5" />Gɔ ame i Igara David to ɔbore ɔbo Baxurim ne, ɔrɛrɛ̃ ɔwɛ̃ wɔ lobɔrɛ i Saul kalɛ gu i ɔ̃ iyo ame ɔba ɔ̃atu wũ i mmɔ. Ɔ̃ iyere loɖe Simei, Gera ɔbibirɛrɛĩ ne. Ɔbɔrɛ i ɔmagɛ̃ ame ɔto ɔgbarĩ David mɛrɛ̃. <verse eid="2SA 16:5" /><verse number="6" style="v" sid="2SA 16:6" />Ɔto ɔpɛ igara gu ɔ̃ makpakpa ata atoasɔ igara makpakpɛ̃dze ɔɖuɖu gu isomadzuɛ̃se igbãɔ ɔsɛgu David i kuɖearɔ̃ gu kubena iso. <verse eid="2SA 16:6" /><verse number="7" style="v" sid="2SA 16:7" />Gɔ ɔto ɔgbarĩ David ne, Simei ɔɣɛ sɔ, "Bɔrɛ fe, bɔrɛ fe, fɔ turiɖoese gu katuripɛmi! <verse eid="2SA 16:7" /><verse number="8" style="v" sid="2SA 16:8" /><char style="nd">Bosate</char> ɔɔtã-ɔ kuso i Saul iyomaturi ima ɔɖuɖu nɛ afere i karɔ̃ fiɛ ato aɖe sigara i ɔ̃ kanya. <char style="nd">Bosate</char> ɔɔsu fɔ sigarakaɖekɔ̃ ɔpia i fɔ ɔbibirɛrɛĩ Absalom nrɔɔ̃ ame. Ɔɔkpase awɔ ala turiɖoese aɖe ɔso!"<verse eid="2SA 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 16:9" />Kere ne Abisai, Zeruya ɔbibirɛrɛĩ ɔkarɛ igara sɔ, "Be ɔso i kpɛkpɛkpia wɔgbe aabgarĩ wũ ɔkɔse igara? Tã lokɛlɛ loatu wũ iti."<verse eid="2SA 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 16:10" />Ɣɛɛ igara ɔɣere wũ sɔ, "Be i nnɛgbe ɔsu mi i mmɔ, Zeruya mabibirɛrɛĩ? Si ɔto ɔgbarĩ alasɔ <char style="nd">Bosate</char> ɔɣere wũ sɔ, 'Gbarĩ David ' ne, nna loakarɛ sɔ, 'Be ɔso ato abara ngbɔ?' "<verse eid="2SA 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 16:11" />Ne David ɔɣere Abisai gu ɔ̃ makpakpa ɔɖuɖu sɔ, "Wũ mɔmɔ ɔbi, wũ sina gu ima to ɔbie sɔ ɔɖoe me. Ne iyɔ Benyaminse wɔgbe ɣɛɛ! Minyua wũ; mitã ɔgbarĩ me, ala <char style="nd">Bosate</char> lopia wũ sɔ ɔbara kumɛɔ. <verse eid="2SA 16:11" /><verse number="12" style="v" sid="2SA 16:12" />Siainyɔ <char style="nd">Bosate</char> to ɔ̃anyɔ wũ imɔrɛ̃ ɔkpesera me ɔpia i ɔ̃ ndamu kusɛkusɛ ame ala Simei sigbarĩ dzɛgbe nɔme ɔso."<verse eid="2SA 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 16:13" />Ne ɔso David gu ɔ̃ maturi ɔsɛ i ɔri iso fiɛ Simei ana ɔsɛ i kabemi isɛ isɛ i ma kanɔsɔ̃ isɛ, ɔto ɔgbarĩ David ne ɔpɛ wũ ata ne ɔsa aku ɔfere wũ i ɔwiri ame. <verse eid="2SA 16:13" /><verse number="14" style="v" sid="2SA 16:14" />Igara gu ɔ̃ maturi ɔɖuɖu ɔsɛ maabo ma kabokɔ̃ ku isotu. Mmɔ ka ɔwe ɔwarã ne.<verse eid="2SA 16:14" /></para>
  <para style="s1">Axitofel Adzuni Wa Ɔtã Gu Xusai Are</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 16:15" />Ɔwi wɔmɔ ame ne, Absalom gu Israel marɛrɛ̃ ɔɖuɖu ɔba maabo Yerusalem, ne Axitofel ɔwegu wũ. <verse eid="2SA 16:15" /><verse number="16" style="v" sid="2SA 16:16" />Ne Xusai, Arkise wɔ nɖe David ɔlaa ɔkɛlɛ Absalom kɔrɛ ɔɣere wũ sɔ, "Igara si ɔsɛ ngbã dzoroo! Igara si ɔsɛ ngbã dzoroo!"<verse eid="2SA 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 16:17" />Ne Absalom ɔkarɛ Xusai sɔ, "Kuɖɔɛ gɔgbe aate fɔ ɔlaa ne? Si fɔ ɔlaa ɔɖe ne, be ɔso fiɛ aisiai wũ?"<verse eid="2SA 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 16:18" />Ne Xusai ɔɣere Absalom sɔ, "Aɔ, nwɔ i <char style="nd">Bosate</char> gu kaɖe ɔɖi, fiɛ Israel marɛrɛ̃ ɔɖuɖu siai ne, ɔ̃ loasiai fiɛ ɔ̃ kɔrɛ loawe ne. <verse eid="2SA 16:18" /><verse number="19" style="v" sid="2SA 16:19" />Ana ne, nna si losumu? Iiɖe ɔbi loasumu ɣɛɛ? Lɛ kumɛgɔ losumu fɔ ɔse ne, ngbɔ loasumu-ɔ ne."<verse eid="2SA 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 16:20" />Ne Absalom ɔkarɛ Axitofel sɔ, "Tã fɔ adzuni, be si bobara?"<verse eid="2SA 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 16:21" />Ne Axitofel ɔɣere Absalom sɔ, "Rɛgu fɔ ɔse masɔrɔ̃ ma ɔnyua ɔsɛ sɔ madzuɛ̃ igarayo. Iyɔ Israel ɔɖuɖu aanɔ sɔ mi gu fɔ ɔse ɔɔkɛ ɔkati fiɛ iapia mma ɔɖuɖu mpia i fɔ kɔrɛ ɔle maya teteree." <verse eid="2SA 16:21" /><verse number="22" style="v" sid="2SA 16:22" />Ne ɔso mapɛ ikpayo i iyo isã matã Absalom ne ɔrɛgu ɔ̃ ɔse masɔrɔ̃ i Israel kaɖe ɔɖuɖu anɔ.<verse eid="2SA 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 16:23" />Kiniɔ ne i ɔwi wɔmɔ ame ne, David gu Absalom sɛ manyɔ Axitofel adzuni wa ɔsɛ ɔtã lɛ kumɛgɔ i ɔturi aakarɛ ira ɔnɔ i Ɣaa kɔrɛ.<verse eid="2SA 16:23" /></para>
  <chapter eid="2SA 16" />
  <chapter number="17" style="c" sid="2SA 17" />
  <para style="s1">Xusai Ɔsɔsɔla Absalom</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 17:1" />Ne Axitofel ɔɣere Absalom sɔ, "Tã loɖi si lokɔ Israel makpakpɛ̃dze kukpi kuweo-kunyɔ si loti David kama ku kasɛ̃ gagbe. <verse eid="2SA 17:1" /><verse number="2" style="v" sid="2SA 17:2" />Loabo wũ iso ku ɔwi wɔ iɔɖa wũ fiɛ ɔ̃ɔfɛ̃. Loabo wũ iso, mati makpakpa ku ifɔ̃ iyɔ mma ɔɖuɖu mpia i ɔ̃ kɔrɛ aatere. Igara kere loaɖoe <verse eid="2SA 17:2" /><verse number="3" style="v" sid="2SA 17:3" />fiɛ loakpesera maturi ɔɖuɖu lobɔ-ɔ. Ɔturi wɔ kukpi ato abie aatã maturi ɔɖuɖu ɔkpese maba fiɛ ma kuwɛ̃ iibare igbɛ." <verse eid="2SA 17:3" /><verse number="4" style="v" sid="2SA 17:4" />Adzuni wagbe ɔbo Absalom gu Israel kaɖe makpakpa ɔɖuɖu anɔ.<verse eid="2SA 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 17:5" />Ɣɛɛ Absalom ɔɣɛ sɔ, "Mikpere Xusai, Arkise si bonɔ sɔ be ɔ̃aɣɛ ɔ̃ wũ. <verse eid="2SA 17:5" /><verse number="6" style="v" sid="2SA 17:6" />Gɔ Xusai ɔba ɔ̃abo ne, Absalom ɔɣere wũ sɔ, "Nya adzuni wa i Axitofel ɔtã. Bobara lɛ ɔɣɛ? Si ooɣo ne, tã bo fɔ adzuni."<verse eid="2SA 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 17:7" />Xusai ɔtã Absalom mmuai sɔ, "Adzuni wa i Axitofel ɔtã i ɔwi wɔgbe iilɛ. <verse eid="2SA 17:7" /><verse number="8" style="v" sid="2SA 17:8" />Xusai ɔsɔgu sɔ, aɣe fɔ ɔse gu ɔ̃ maturi ne, makpãrɛrɛĩ maɖe fiɛ masɛ makpɛ̃ lɛ iketeke nɛ mabi mayu. Ana ne, fɔ ɔse ne, kpakpɛ̃dze kuere ɔɖe, ɔ̃ibarɛ i makpakpɛ̃dze kɔrɛ ku kasɛ̃. <verse eid="2SA 17:8" /><verse number="9" style="v" sid="2SA 17:9" />Kiniɔ kɔraa ne, siainyɔ ɔwɛrɛ i ɔkpolo ɣee kakɔi karere. Si ɔɖe katɔ̃ ɔbo fɔ makpakpɛ̃dze iso ɔɖoe mawɛ̃ fiɛ maturi ɔnɔ ne, mato maaɣɛ sɔ, ' Maɔwɔra makpakpɛ̃dze mawɛ̃ i mma nsisai Absalom ndɛ̃.' <verse eid="2SA 17:9" /><verse number="10" style="v" sid="2SA 17:10" />Iyɔ nane kpakpɛ̃dze wɔ mba kagbegbe ɔɖo, fiɛ ɔba ɔtu lɛ dzata kɔraa ne, ifɔ̃ aamɔɛ̃ wũ, alasɔ Israel kaɖe ɔɖuɖu ɣe sɔ fɔ ɔse ne, kpãrɛrɛĩ ɔɖe, fiɛ mma ɔɖuɖu mpiagu wũ ba kagbegbe.<verse eid="2SA 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 17:11" />"Ne ɔso loatã-ɔ adzuni sɔ, tã Israel ɔɖuɖu ma losi lɛ ɔpo katɔ̃ iwarĩ, ita i Dan i kato isɛ iabo Beerseba i kala si maba maasikanya i fɔ kɔrɛ si fɔ mɔmɔ aɖe ma katɔ̃ i kakpã ame. <verse eid="2SA 17:11" /><verse number="12" style="v" sid="2SA 17:12" />Iyɔ boabo wũ iso i kakɔi biara ga ɔpia, boafu wũ iso lɛ kumɛgɔ i kakpekpeyu sɛ kaso kabo i ikɔkɔibi iso awe. Iyɔ ɔ̃ oo, ɔ̃ maturi oo ne, kuwɛ̃ iibakuti gbanadze. <verse eid="2SA 17:12" /><verse number="13" style="v" sid="2SA 17:13" />Si ɔtere ɔsɛ ɔ̃awɛrɛ i ɔmagɛ̃siare ame ne, tã Israel ɔɖuɖu si mabɔ siwɛ̃ bopia ɔmagɛ̃ wɔmɔ bokpadzɛ̃ wũ bosɛ boafere i kagbolomi ame sɔ nane ita kɔraa iibakuti."<verse eid="2SA 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 17:14" />Ne Absalom gu Israel marɛrɛ̃ ɔɖuɖu ɔɣɛ sɔ, "Xusai, Arkise adzuni wa ɔtã lɛ aɖo Axitofel are." Alasɔ <char style="nd">Bosate</char> ɔɔɖo sɔ ɔ̃akpɔkpɔtɔra Axitofel adzuni sɛɛ si itã <char style="nd">Bosate</char> si ɔbɔ itikpi i Absalom iso.<verse eid="2SA 17:14" /></para>
  <para style="s1">Xusai Ɔsɛ̃ David Sɔ Ɔtere</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 17:15" />Ne Xusai ɔɣere masɔrɛdze Zadok gu Abiatar sɔ, Axitofel ɔtã Absalom gu Israel makpakpa adzuni sɔ mabara kumɛgɔ gu kumɛgɔ, ɣɛɛ lotã ma adzuni sɔ mabara nnɛ gu nnɛ. <verse eid="2SA 17:15" /><verse number="16" style="v" sid="2SA 17:16" />Kiniɔ ne, mipia David ɔturi ɔluwɛ̃ sɔ, 'Daarɛ i Yordan ɔwore kawarakɔ̃ i fafuĩ ame, wara ɔluwɛ̃ ne si iiɖe ngbɔ mato maaba maame igara gu ɔ̃ maturi ɔɖuɖu ma mpia i ɔ̃ kɔrɛ.' "<verse eid="2SA 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 17:17" />Yonatan gu Aximaz ɔwe i En Rogel. Iɖe sɔ maapia ɔɖaborɔ̃gomi sɔ ɔsɛ ɔ̃aɣere Yonatan gu Aximaz si masɛ maaɣere Igara David alasɔ iibalɛgu ma si manya ma sɔ mato mabo i ɔmagɛ̃siare ame. <verse eid="2SA 17:17" /><verse number="18" style="v" sid="2SA 17:18" />Ɣɛɛ ɔporoporoi ɔwɛ̃ ɔnya ma ɔsɛ ɔ̃aɣere Absalom. Ne ɔso ma inyɔ ɔrui mala makɛlɛ ɔrɛrɛ̃ ɔwɛ̃ iyo i Baxurim. Ɔwe itubiɔ i ɔ̃ inyamɔ, ne ɔso maso mabo i ne ame. <verse eid="2SA 17:18" /><verse number="19" style="v" sid="2SA 17:19" />Ne ɔrɛrɛ̃ ɔre ɔsu ira ɔwarɛ ɔfu i itubiɔ kanya iso ɔsu kamɔ ɔla iso gɔ kuwɛ̃ iiɣe kuira i ne iso.<verse eid="2SA 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 17:20" />Gɔ Absalom marɛrɛ̃ ɔba maatu ɔrɔ̃go i iyo ne, makarɛ wũ sɔ, "I ɖe Aximaz gu Yonatan?"</para>
  <para style="p" vid="2SA 17:20">Ne ɔrɔ̃go ɔtã ma mmuai sɔ, "Mawara kaworei makpa." Manyɔnyɔ ma, ɣɛɛ mainya kuwɛ̃ ne ɔso makpese makɛlɛ Yerusalem.<verse eid="2SA 17:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 17:21" />Gɔ Absalom marɛrɛ̃ ɔɔrui kama ne, Yonatan mɛrɛ̃ ɔya mabɔrɛ i itubiɔ ame makɛlɛ masɛ maaɣere Igara David sɔ, "Ta si awara ɔwore ɔluwɛ̃, Axitofel ɔtã adzuni sɔ mabara kumɛgɔgbe gu kumɛgɔgbe i fɔ iso." <verse eid="2SA 17:21" /><verse number="22" style="v" sid="2SA 17:22" />Ne ɔso David gu mma ɔɖuɖu mpia wũ i kɔrɛ ɔta mawara Yordan ɔwore, ma ɔɖuɖu ɔwara maro fiɛ kaɖe ɔsɛ̃, kuwɛ̃ iisikuti sɔ ɔ̃iwara Yordan.<verse eid="2SA 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 17:23" />Gɔ Axitofel ɔnya sɔ maifɔ ɔ̃ adzuni ne, ɔsu ɔ̃ ɔfirimu iso asɛra ɔsia iso ne ɔta ɔsɛ ɔkɛlɛ ɔ̃ iyo i ma aɖe. Gɔ ɔledza ɔ̃ iyo ɔsɛ ne, ɔsa so. Ne mabiara wũ i ɔ̃ ɔse ikpibiɔ ame ne.<verse eid="2SA 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 17:24" />David ɔkɛlɛ Maxanayim fiɛ Absalom ana ɔwara Yordan ɔwore ku Israel marɛrɛ̃ ɔɖuɖu. <verse eid="2SA 17:24" /><verse number="25" style="v" sid="2SA 17:25" />Absalom ɔɖi Amasa makpakpɛ̃dze ɔkpakpa i Yoab kanya. Amasa ne, Yeter,<note caller="+" style="f"><char style="fr" closed="false">17.25 </char><char style="ft" closed="false">Yeter: Ne ame nɖe Ithra ne </char></note> ɔbirɛrɛĩ ɔɖe. Yeter Israelse<note caller="+" style="f"><char style="fr" closed="false">17.25 </char><char style="ft" closed="false">Israelse: ɣee Yezreelse</char></note> ɔyiri Abigail, Naxas ɔbibirɔ̃gomi wɔ nɖe Yoab ɔnyi Zeruya ɔnyiibi. <verse eid="2SA 17:25" /><verse number="26" style="v" sid="2SA 17:26" />Israel mabi gu Absalom ɔsikanya i kasɛkɔ̃ i Gilead karɔ̃ iso.<verse eid="2SA 17:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 17:27" />Gɔ David ɔbo Maxanayim ne, Sobi, Naxas wɔ lobɔrɛ i Raba fiɛ ɔɖe Amonse ɔbirɛrɛĩ gu Makir, Amiel wɔ lobɔrɛ i Lo Debar ɔbirɛrɛĩ gu Barzilai wɔ loɖe Gileadse ɔbɔrɛ i Rogelim ɔmagɛ̃ ame <verse eid="2SA 17:27" /><verse number="28" style="v" sid="2SA 17:28" />ɔbɔ arɛisora, abui gu akɔi gu iyo ara wa mapɔ. Ana ne mabɔ kakpã, arĩ, ɔraũ, atitabi sɛa, kaɣakpei, ayiforobi gu <verse eid="2SA 17:28" /><verse number="29" style="v" sid="2SA 17:29" />maɣendu gu nantsuĩ inyɛndu kpɛkpɛã, masɛrɛ gu nantsuĩ inyɛndu nyia mabɔ David gu ɔ̃ maturi sɔ maɖe. Alasɔ maɣɛ sɔ, "Iɔɖa maturi fiɛ kukã gu kutukã ka kuto ma i fafuĩ ame."<verse eid="2SA 17:29" /></para>
  <chapter eid="2SA 17" />
  <chapter number="18" style="c" sid="2SA 18" />
  <para style="s1">Maɖe Absalom Iso Maɖoe Wũ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 18:1" />David ɔsira makpakpɛ̃dze ma lowegu wũ kanya ɔɣɛ ma i alafa gu kukpi ame fiɛ ɔɖi matɔ̃ɖedze ɔtã kakpi biara gu kulafa biara. <verse eid="2SA 18:1" /><verse number="2" style="v" sid="2SA 18:2" />David ɔɣɛ ɔ̃ makpakpɛ̃dze aka atɛ, ika iwɛ̃ ɔwe i Yoab kayirinɔ, iwɛ̃ i Yoab ɔnyiibi Abisai, Zeruya ɔbi kayirinɔ, fiɛ ika tɛare ɔwe i Itai Gitise kayirinɔ. Igara ɔɣere makpakpɛ̃dze sɔ, "Mme, wũ mɔmɔ loasɛ lobɔrɛgu mi."<verse eid="2SA 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 18:3" />Ɣɛɛ makpakpɛ̃dze ɔɣere wũ sɔ, "Iikote sɔ abɔrɛ akɛlɛ; aibasiai bo, alasɔ si makpɛ̃gu bo fiɛ bofiriki botere ne, maibapia bo kanya. Si bo kasɛ ɔkpi kɔraa ne, iibasu ma kuira i mmɔ, ɣɛɛ fɔ ɔnɔwɛ̃ afɔ kuɣa aɖo bo kukpi kuweo. Ialɛ iɖo sɔ aawe i ɔmagɛ̃siare ame ala ɔɔpia bo ɔle ɔsese."<verse eid="2SA 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 18:4" />Ne igara ɔɣere ma sɔ, "Loabara nnɛ nlɛ mi iɖo."</para>
  <para style="p" vid="2SA 18:4">Ne ɔso igara ɔya i ɔmagɛ̃siare kayogodɔ̃ ɔto ɔnyɔ fiɛ ɔ̃ makpakpɛ̃dze to mabɔrɛ masɛ mafe i alafa gu kukpi akuri ame. <verse eid="2SA 18:4" /><verse number="5" style="v" sid="2SA 18:5" />Ne igara ɔɣere Yoab gu Abisai gu Itai sɔ, "Wũ ɔso ne, mibara Absalom pɔkɔsɔɔ lo." Makpakpɛ̃dze ɔɖuɖu ɔnɔ gɔ igara to ɔɣere matɔ̃ɖedze itɔ̃me nɛgbe i Absalom iso.<verse eid="2SA 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 18:6" />David makpakpɛ̃dze ɔbɔrɛ i ɔmagɛ̃ makɛlɛ karɔ̃ ame masɛ maakpɛ̃gu Israel. Makpɛ̃ kakpã i Efrayim ipo ame. <verse eid="2SA 18:6" /><verse number="7" style="v" sid="2SA 18:7" />David makpakpɛ̃dze ɔɖe Israel iso i mmɔ, maɖoe maturi gbodzoo - kukpi sinyɔ. <verse eid="2SA 18:7" /><verse number="8" style="v" sid="2SA 18:8" />Kakpã katɔ̃ ɔbɛ ikɛlɛ karɔ̃ ɔɖuɖu iso gu ipo ɔɖuɖu ame ku iyi nɛmɔ, ne mma ipo ɔme ɔsi maɖo mma maɖoe ala ipɛmi. <verse eid="2SA 18:8" /><verse number="9" style="v" sid="2SA 18:9" />Iba sɔ Absalom ɔsarɛgu David makpakpɛ̃dze. Ɔsɛ i ɔfirimu iso, ne gɔ ɔfirimu ɔki i ɔɖum siare ɔwɛ̃ ku akpai siare kayirinɔ ne, Absalom siwɛrɛ̃ ɔmɔɛ̃ idzirikpa. Ɔfirimu wɔ iso ɔsɛ ɔtere ɔfe ɔkpa, ɔnyua wũ ɔsa i ɔwiri ame i mmɔ.<verse eid="2SA 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 18:10" />Gɔ kpakpɛ̃dze ɔwɛ̃ ɔnya nnɛ loba ne, ɔɣere Yoab sɔ, "Lonya Absalom sa i ɔɖum ɔwɛ̃ ame kiniɔ."<verse eid="2SA 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 18:11" />Ne Yoab ɔkarɛ ɔrɛrɛ̃ wɔ loɣere wũ itɔ̃me sɔ, "Bee! Anya wũ? Be ɔso aiɖoe wũ i mmɔ? Tee loatã-ɔ sikãfudza abi aweo fiɛ lokɔlɛ-ɔ kato ku kpãrɛrɛĩkpakpa kafiami."<verse eid="2SA 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 18:12" />Ɣɛɛ ɔrɛrɛ̃ ɔtã Yoab mmuai sɔ, "Si nane sikãfudza kilo iweo-inyɔ akere afere me i nrɔɔ̃ ame kɔraa ne, loibasia kɔrɔ̃ i igara ɔbibirɛrɛĩ iso, alasɔ i bo atsue ame i igara ɔɣere mi gu Abisai gu Itai sɔ, 'Minyɔ Absalom iso mitã me lo.' <verse eid="2SA 18:12" /><verse number="13" style="v" sid="2SA 18:13" />Fiɛ sɔ lobara wũ iraboa ne; gbaã ne igara to ɔ̃atsue, fɔ nto aɖe ɔturi ɖeakatɔ̃ wɔ loatere ɔɣɛ me."<verse eid="2SA 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 18:14" />Ne Yoab ɔɣɛ sɔ, "Loibanina ɔwi i fɔ iso." Ne ɔsu akpɔrɔ atɛ ɔtsue Absalom i ɔtu ame gɔ ɔ̃ikpi fiɛ ɔsa i ɔɖum kudziri iso. <verse eid="2SA 18:14" /><verse number="15" style="v" sid="2SA 18:15" />Ne Yoab akpirasarãdze iweo ɔki malɔ Absalom maɖoe wũ ne.<verse eid="2SA 18:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 18:16" />Ne Yoab ɔfɛ̃ kadadã ɔtuĩdza makpakpɛ̃dze fiɛ makpese i Israel i kama ne. <verse eid="2SA 18:16" /><verse number="17" style="v" sid="2SA 18:17" />Masase Absalom mafuĩdza mapia i iwo siare iwɛ̃ ame i ipo ame, mabodza ata ikpe siare mafere wũ iso. Gɔ iba ngbɔ ne, Absalom Israel maturi ɔɖuɖu ɔtere makɛlɛ ma ayo.<verse eid="2SA 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 18:18" />Ɔwi wɔ i Absalom ɔsɛ ngbã ne, ɔsu itĩ ɔsɛ ɔ̃akarã i ngbegɔ marɔ sɔ Igara Kagbolomi ame lɛ ira nɛ maanyigi wũ ala, alasɔ ɔɣere so sɔ, "Lona ɔbirɛrɛĩ wɔ lotɔrã wũ iyere fiɛ maanyigi me." Ne ɔso ɔsu ɔ̃ iyere ɔsiai itĩ, masɛ marɔ ne sɔ Absalom Itĩ ipɛ i ɔwi wɔ matsɛrɛ ara wagbe.<verse eid="2SA 18:18" /></para>
  <para style="s1">Maɣere David Absalom Kukpi</para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 18:19" />Ne Zadok ɔbibirɛrɛĩ Aximaz ɔɣɛ sɔ, "Tã lotere loaɣere igara itɔ̃me nɛgbe sɔ <char style="nd">Bosate</char> ɔɔɖi wũ ɔbɔrɛgu i ɔ̃ matsirise nrɔɔ̃ ame."<verse eid="2SA 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 18:20" />Ne Yoab ɔɣere wũ sɔ, "Iiɖe fɔ loasɛ aaɣɛ itɔ̃me nɛgbe nɔme, iyi mama aasɛ, ɣɛɛ iikote sɔ aabara kumɛɔ nɔme alasɔ igara ɔbibirɛrɛĩ ɔkpi."<verse eid="2SA 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 18:21" />Kere ne Yoab ɔɣere Kusise sɔ, "Kɛlɛ aaɣere igara nnɛ anya." Ne Kusise ɔbɔitikarɔ̃ ɔtã Yoab fiɛ ɔpia ise ne.<verse eid="2SA 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 18:22" />Ne Zadok ɔbibirɛrɛĩ Aximaz ɔledza Yoab iɣere sɔ, "Kumekume ise ne, lotã-ɔ iti tã lotere losiai Kusise i kama."</para>
  <para style="p" vid="2SA 18:22">Ne Yoab ɔɣere wũ sɔ, "Wũ ɔbi, be ɔso ato abie sɔ aakɛlɛ? Ana ku itɔ̃me nɛ loabɔ-ɔ kusia."<verse eid="2SA 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 18:23" />Ɣɛɛ Aximaz sɔ, "Kumekume ise ne, lobie sɔ loatere loaɣɛ kokooko."</para>
  <para style="p" vid="2SA 18:23">Ne ɔso Yoab ɔɣere wũ sɔ, "Tere!" Kere ne Aximaz ɔpia ise ɔtere ɔki i Yordan katɛfɛkɔ̃ ɔri iso isɛ ɔfe Kusise ne.<verse eid="2SA 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 18:24" />Gɔ ame i David si i kama ibere gu kame ire ndɛ̃ i ɔka ame ne, dzuɛ̃se ɔya ɔkɛlɛ isã ɔki i ibere iso, ne gɔ ɔnyɔ ne, ɔnya ɔrɛrɛ̃ ɔwɛ̃ tere ɔnɔwɛ̃ ɔto ɔba. <verse eid="2SA 18:24" /><verse number="25" style="v" sid="2SA 18:25" />Ne dzuɛ̃se ɔkpere igara ɔtã wũ itsue ne.</para>
  <para style="p" vid="2SA 18:25">Ne igara ɔɣɛ sɔ, "Si ɔ̃ ɔnɔwɛ̃ ɔɖe ne, iyɔ itɔ̃me sɛɛ ɔsɛgu." Nwɔ ntere ise togu ibore ibo.<verse eid="2SA 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 18:26" />Kere ne dzuɛ̃se ɔnya ɔrɛrɛ̃ mama wɔ ntere ɔto ɔba, ne ɔɣere nwɔ nɣɛ i kayogodɔ̃ sɔ, "Nyɔ, ɔrɛrɛ̃ mama tere ɔto ɔba ɔ̃ ɔnɔwɛ̃!"</para>
  <para style="p" vid="2SA 18:26">Ne igara ɔɣɛ sɔ, "Ɔ̃ wũ itɔ̃me sɛɛ ɔsɛgu."<verse eid="2SA 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 18:27" />Ne dzuɛ̃se ɔɣɛ sɔ, "Ibara me sɔ ɔɖeakatɔ̃ tere lɛ Zadok ɔbibirɛrɛĩ Aximaz awe."</para>
  <para style="p" vid="2SA 18:27">Ne igara ɔɣɛ sɔ, "Ɔturi sɛɛ ɔɖe ne ɔso itɔ̃me sɛɛ ɔsɛgu."<verse eid="2SA 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 18:28" />Kere ne Aximaz ɔkpere igara ɔɣere sɔ, "Ibiara se kukaakɔ!" Ne ɔbɔitikarɔ̃ ɔtã igara ɔɣɛ sɔ, "Boale <char style="nd">Bosate</char> fɔ Ɣaa! Ɔ̃ɔɖi mma lota maɣɛ wũ ɔkɔse igara iso ɔtã."<verse eid="2SA 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 18:29" />Ne igara ɔkarɛ sɔ, "Ɔporoporoi Absalom pia kukaakɔ?"</para>
  <para style="p" vid="2SA 18:29">Ne Aximaz ɔtã mmuai sɔ, "Ɔwi wɔ i Yoab to ɔpia me gu fɔ ɔɖabo Kusise katɔ̃me ne, lonya ikpɔkpɔtɔ siare i mmɔ, ɣɛɛ loiɣe nnɛ iɖe."<verse eid="2SA 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 18:30" />Ne igara ɔɣɛ sɔ, "Fe ya i kuruɛ i ngbe." Ne ɔso ɔrui ɔya i kuruɛ i mmɔ.<verse eid="2SA 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 18:31" />Kere ne Kusise ɔba ɔ̃abo ne, ɔɣɛ sɔ, "Wũ ɔkɔse igara, nɔ itɔ̃me sɛɛ! Nɔme ne, <char style="nd">Bosate</char> ɔɖi-ɔ ɔbɔrɛgu i mma ɔɖuɖu lota maɣɛ-ɔ iso."<verse eid="2SA 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 18:32" />Ne igara ɔkarɛ Kusise sɔ, "Ɔporoporoi Absalom pia kukaakɔ?"</para>
  <para style="p" vid="2SA 18:32">Ne Kusise ɔtã mmuai sɔ, "Wũ ɔkɔse igara matsirise ɔɖuɖu ma lota maɣɛ-ɔ iso sɔ maabara-ɔ iraboa si mase lɛ ɔporoporoi wɔmɔ."<verse eid="2SA 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 18:33" />Itidza igara, ne ɔta ɔbo i iyo nɛ matsue masia iso i kayogodɔ̃ kato ame ɔto ɔbiɛ kaku ne. Gɔ ame ɔsɛ ne, ɔbiɛ ɔɣɛ sɔ, "Ao, wũ ɔbi Absalom! Wũ ɔbi ni, wũ ɔbi Absalom! Tee me loakpi i fɔ kanya kere - O Absalom, wũ ɔbi, wũ ɔbi!"<verse eid="2SA 18:33" /></para>
  <chapter eid="2SA 18" />
  <chapter number="19" style="c" sid="2SA 19" />
  <para style="s1">Yoab Ɔnyagalagu David</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 19:1" />Maɣere Yoab sɔ, "Igara to ɔbiɛ ɔmararã so i Absalom iti." <verse eid="2SA 19:1" /><verse number="2" style="v" sid="2SA 19:2" />Fiɛ makpakpɛ̃dze ɔɖuɖu ne, iyi nɛmɔ iɖeiso ɔkpese imararãso, alasɔ iyi nɛmɔ ne makpakpɛ̃dze ɔnɔ maɣɛ sɔ, "Igara to ɔbiɛ ɔ̃ ɔbi." <verse eid="2SA 19:2" /><verse number="3" style="v" sid="2SA 19:3" />Makpakpɛ̃dze ɔyu mabo i ɔmagɛ̃siare ame lɛ mma lorui matere i kakpã ame fiɛ kunuarɛ to ma. <verse eid="2SA 19:3" /><verse number="4" style="v" sid="2SA 19:4" />Igara ɔfu so ara i katɔ̃ fiɛ ɔto ɔbiɛ teteree ɔɣɛ sɔ, "O, wũ ɔbi Absalom! O, Absalom wũ ɔbi, wũ ɔbi ni!"<verse eid="2SA 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 19:5" />Kere ne Yoab ɔkɛlɛ igara kɔrɛ i iyo ɔɣere wũ sɔ, "Nɔme ne, apia fɔ makpakpɛ̃dze ɔɖuɖu ma lokpɛ̃ i fɔ ngbã, fɔ mabirɛrɛĩ gu mabirɔ̃gomi gu fɔ mare gu fɔ masɔrɔ̃ iti kunuarɛ. <verse eid="2SA 19:5" /><verse number="6" style="v" sid="2SA 19:6" />Ato aɖɔɛ mma lotsriri-ɔ fiɛ atsiri mma nto maɖɔɛ-ɔ. Nɔme ne, ate sekele sɔ fɔ makpakpɛ̃dze matɔ̃ɖedze gu makpakpɛ̃dze ngbã iisu-ɔ kuira i mmɔ. Lonya sɔ tee ito iawe-ɔ ɔmɛrɛ̃ si bo ɔɖuɖu ɔkpi fiɛ Absalom pia ngbã ku nɔme. <verse eid="2SA 19:6" /><verse number="7" style="v" sid="2SA 19:7" />Kiniɔ ne, bɔrɛ kɛlɛ aapia fɔ makpakpɛ̃dze kɔrɔ̃ i kayiri. Lokã <char style="nd">Bosate</char> sɔ si aibɔrɛ akɛlɛ ne, kuwɛ̃ iibakuti fiɛ kaɖe aaro. Nnɛgbe to ianyanyarĩ iɖo atikpi ɔɖuɖu wa loɔbɔrɛ-ɔ iso ita i fɔ siporoporoi ame ipɛ i kiniɔ."<verse eid="2SA 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 19:8" />Ne ɔso igara ɔta ɔsɛ ɔ̃asɛ i ɔmagɛ̃ kayogodɔ̃. Gɔ maɣere makpakpɛ̃dze sɔ, "Igara ka ɔsi i kayogodɔ̃" ne, ma ɔɖuɖu ɔbɔrɛ maba i ɔ̃ kɔrɛ.</para>
  <para style="s1" vid="2SA 19:8">David Ɔkpese Ɔkɛlɛ Yerusalem</para>
  <para style="p" vid="2SA 19:8">Ɔwi wɔmɔ ame ne, Absalom Israel makpakpɛ̃dze ɔɔtere makpa ma ayo.<verse eid="2SA 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 19:9" />I Israel kumele ɔɖuɖu ame ne, maturi ɔɖuɖu to mawararãgu so maɣɛ sɔ, "Igara ɔɖi bo ɔbɔrɛgu i bo matsirise nrɔɔ̃ ame, ɔ̃ ɔɖe loɖi bo ɔbɔrɛgu i ma Filistise nrɔɔ̃ ame. Ɣɛɛ kiniɔ ne, ɔ̃ɔtere i bo karɔ̃ iso ala Absalom ɔso, <verse eid="2SA 19:9" /><verse number="10" style="v" sid="2SA 19:10" />fiɛ Absalom wɔ bosɛra sigara sɔ ɔɖe bo igara ne, ɔ̃ɔkpi i kakpã ame. Ne ɔso be ɔso miito miɣɛ kuira i igara ikpese iba iso?"<verse eid="2SA 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 19:11" />Ne Igara David ɔpia Zadok gu Abiatar ma nɖe masɔrɛdze sɔ, "Mikarɛ Yuda makpakpa sɔ, 'Be ɔso fiɛ mi loaɖe matsɔra i igara ikpesegu ibɔ i ɔ̃ igaraiyo ame alasɔ nnɛ mato maɣɛ i Israel ɔɖuɖu ɔɔbo igara i kutsue i ɔ̃ kasɛkɔ̃. <verse eid="2SA 19:11" /><verse number="12" style="v" sid="2SA 19:12" />Mi nɖe wũ malɛdze, wũ sosina gu ima. Ne ɔso be ɔso i mi nɖe matsɔra sɔ miakpesera igara mibɔ?" <verse eid="2SA 19:12" /><verse number="13" style="v" sid="2SA 19:13" />Si miɣere Amasa sɔ, 'Iiɖe wũ sosina gu ima aɖe ɣɛɛ? Lokã Ɣaa sɔ ɔte me, si ɔte me ɔbua si iiɖe fɔ loaɖe wũ makpakpɛ̃dze ɔkpakpa i Yoab kanya ita i kiniɔ ito ikɛlɛ.' "<verse eid="2SA 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 19:14" />David ara ɔmɔɛ̃ Yuda maturi ɔtu ne ɔso mabara adzuni awɛ̃ mapia igara ɔturi sɔ, "Mi gu fɔ makpakpɛ̃dze ɔɖuɖu si mikpese miba." <verse eid="2SA 19:14" /><verse number="15" style="v" sid="2SA 19:15" />Kere ne igara ɔɣo ɔri ɔsɛ ɔ̃abo Yordan ɔkpokpo.</para>
  <para style="p" vid="2SA 19:15">Kiniɔ ne, Yuda marɛrɛ̃ ɔɔba maasikanya i Gilgal sɔ maasarɛgu igara makɔ wũ mawara Yordan ɔwore. <verse eid="2SA 19:15" /><verse number="16" style="v" sid="2SA 19:16" />Benyaminse Simei wɔ nɖe Gera ɔbi fiɛ ɔbɔrɛ i Baxurim ɔpɛsiwa ɔsiai Yuda maturi sɔ maasarɛgu Igara David. <verse eid="2SA 19:16" /><verse number="17" style="v" sid="2SA 19:17" />Benyamin maturi kakpi kawɛ̃ ɔsiai wũ gu Ziba, ɔɖabo wɔ lonyɔ Saul iyo iso gu ɔ̃ mabibirɛrɛĩ iweo-iru gu ɔ̃ maɖabo sinyɔ. Mapɛsiwa masɛ maabo Yordan kɔrɛ i ngbegɔ i igara ɔwe. <verse eid="2SA 19:17" /><verse number="18" style="v" sid="2SA 19:18" />Mawara Yordan i kawarakɔ̃ si makɔ igara gu ɔ̃ iyomaturi mawaragu ɔwore i kawarakɔ̃ fiɛ mabara irabiara nɛ ɔkarɛ ɔbɔrɛgu i ma kɔrɛ.</para>
  <para style="p" vid="2SA 19:18">Gɔ i Simei Gera ɔbibirɛrɛĩ ɔwara Yordan ne ɔkɛlɛ ɔrɛ i igara ngbatɔ̃ <verse eid="2SA 19:18" /><verse number="19" style="v" sid="2SA 19:19" />ne ɔɣere wũ sɔ, "Wũ ɔkɔse si ɔdaatã me ipɔ lo, ɔdaanyigi ikpi nɛ lobara ku iyi nɛ wũ ɔkɔse igara ɔrui i Yerusalem. Igara si ɔɖi ne i ɔ̃ adzuni ame. <verse eid="2SA 19:19" /><verse number="20" style="v" sid="2SA 19:20" />Alasɔ mme fɔ ɔɖabo ɣe sɔ lobara ikpi, ɣɛɛ nɔme ne, mme nɖe ɔturi ɖeakatɔ̃ wɔ lobɔrɛ i Yosef iyo ɔɖuɖu ame loba losarɛgu wũ ɔkɔse igara."<verse eid="2SA 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 19:21" />Ne Abisai wɔ nɖe Zeruya ɔbi ɔɣɛ sɔ, "Maibaɖoe Simei i nnɛgbe iti? Ɔgbarĩ nwɔ i <char style="nd">Bosate</char> ɔsɔla nnɔĩ."<verse eid="2SA 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 19:22" />Ne David ɔtã mmuai sɔ, "Bo gu Zeruya mabi adzuni iibara awɛ̃ i itɔ̃me nɛgbe ame. Nɔme ne, miɔkpese wũ matsirise! Ikote sɔ maaɖoe ɔturi ku nɔme ikpɛnɛ nɛgbe i Israel? Nɔme ne, loiɣe sɔ mme nɖe igara i Israel iso?" <verse eid="2SA 19:22" /><verse number="23" style="v" sid="2SA 19:23" />Ne ɔso Igara ɔɣere Simei, ɔkã ndamu ɔsia iso ɔtã wũ sɔ, "Maibaɖoe-ɔ."<verse eid="2SA 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 19:24" />Mefiboset wɔ nɖe Saul ɔwabirɛrɛĩ ana ɔso ɔkɛlɛ ɔsɛ ɔ̃asarɛgu igara. Ita i iyi nɛ i igara ɔrui i ɔmagɛ̃siare ame ne, ɔ̃inyɔ ɔ̃ ngba iso, ɔ̃ikparɛ̃ ɔ̃ ɔkore gu ɔ̃ sinyararã, ɔ̃ifore ɔ̃ ara ana gbɔgbɔɔgbɔ iyi nɛ igara ɔkpese ɔba i isobuɛ ame. <verse eid="2SA 19:24" /><verse number="25" style="v" sid="2SA 19:25" />Gɔ ɔbɔrɛ i Yerusalem ɔba ɔ̃asarɛgu igara ne, igara ɔkarɛ wũ sɔ, "Mefiboset, be ɔso fiɛ aisiai me?"<verse eid="2SA 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 19:26" />Ne ɔtã mmuai sɔ, "Wũ ɔkɔse igara ɣe sɔ fɔ ɔɖabo ne, bafã loɖe, ne ɔso loɣɛ sɔ, 'Loatã masia ɔfirimu asɛra iso losɛ iso si loawo ɔsiai igara.' Ɣɛɛ Ziba wɔ nɖe wũ ɔɖabo ɔɔɖi me ɔtã. <verse eid="2SA 19:26" /><verse number="27" style="v" sid="2SA 19:27" />Ɔ̃ɔnina fɔ ɔɖabo iyere ɔtã wũ ɔkɔse igara. Wũ ɔkɔse igara se lɛ Ɣaa kpabo, ne ɔso bara nnɛ loabo-ɔ anɔ. <verse eid="2SA 19:27" /><verse number="28" style="v" sid="2SA 19:28" />Wũ ɔwa ɔkparɛ ɔɖuɖu ne, kukpi pɛ lokote kutã bo i fɔ wũ ɔkɔse igara nrɔɔ̃ ame. Ɣɛɛ atã fɔ ɔɖabo kaɖekɔ̃ i mma nsɛ maɖe ara i fɔ ɔpɔrɔ̃ iti ndɛ̃. Ne ɔso losiina ɔri loakarɛ kuira lobɔrɛgu i igara kɔrɛ lobua."<verse eid="2SA 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 19:29" />Ne igara ɔɣere wũ sɔ, "Be aakpese aɣɛ abua? Loɔɣere Ziba sɔ mi gu wũ si miɣɛ so aputu."<verse eid="2SA 19:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 19:30" />Mefiboset ɔɣere igara sɔ, " Kiniɔ ne tã ɔsu irabiara gɔ wũ ɔkɔse igara ɔɔba i isobuɛ ame."<verse eid="2SA 19:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 19:31" />Barzilai Gileadse ana ɔso ɔbɔrɛ i Rogelim ɔmagɛ̃ ame ɔba sɔ maakɔ igara mawaragu Yordan ɔwore ɔsɛ wũ ɔri ita i mmɔ. <verse eid="2SA 19:31" /><verse number="32" style="v" sid="2SA 19:32" />Barzilai ɔɖe ɔrɛrɛ̃kpakpa wɔ loɔsɛ katɔ̃ i akɔ ame, ɔ̃ɔfɔ akɔ fasinafasina. Ɔwe kɔrɔ̃ ame kukaakɔ, fiɛ ɔnyɔ igara iso ku ɔwi wɔ ɔwe i Maxanayim. <verse eid="2SA 19:32" /><verse number="33" style="v" sid="2SA 19:33" />Igara ɔɣere Barzilai sɔ, "Wara bagu me bokɛlɛ si aba aawe i wũ kɔrɛ i Yerusalem si loanyɔ-ɔ iso."<verse eid="2SA 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2SA 19:34" />Ɣɛɛ Barzilai ɔtã igara mmuai sɔ, " Loɔbe posoposo kaɖu gɔ loakɛlɛ Yerusalem ku igara. <verse eid="2SA 19:34" /><verse number="35" style="v" sid="2SA 19:35" />Ɣɛɛ be ɔso i igara aabara me kayiribielea gagbe igbã? Loɔfɔ akɔ fasinafasina kiniɔ, loisibakpese lonya ikpaki i isɛɛ gu ilalaa ndɛ̃. Loisibakpese lonya ɔmɛrɛ̃ i araɖea gu anɛa ndɛ̃. Loisibakpese lonɔ marɛrɛ̃ gu marɔ̃go silɔ si maka aka. Ato kere loakpese losia i wũ ɔkɔse igara iso. <verse eid="2SA 19:35" /><verse number="36" style="v" sid="2SA 19:36" />Fɔ ɔɖabo aawaragu igara Yordan ɔwore losɛ igu kɛkɛĩ kere. <verse eid="2SA 19:36" /><verse number="37" style="v" sid="2SA 19:37" />Tã fɔ ɔɖabo si ɔkpese ɔkɛlɛ sɔ loakpi i wũ mɔmɔ ɔmagɛ̃ ame i tete gu mmã ikpibiɔ kɔrɛ. Ɣɛɛ nya fɔ ɔɖabo Kimxam i ngbe. Tã ɔwaragu wũ ɔkɔse igara, si abara ibiara nɛ aɖɔɛ atã wũ."<verse eid="2SA 19:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="2SA 19:38" />Ne igara ɔɣɛ sɔ, "Kimxam aawara ɔsiai me fiɛ loabara ibiara nɛ loabo-ɔ anɔ lotã wũ. Ibiara nɛ anyɔ ɔri abɔrɛgu i wũ kɔrɛ ne, loabara lotã-ɔ."<verse eid="2SA 19:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="2SA 19:39" />Ne ɔso maturi ɔɖuɖu ɔwara Yordan maro, ne kere igara ɔ̃ wũ ɔwara ne. Igara ɔpɔrɛ Bazilai ɔpia so ɔtã wũ ɔ̃ kusɛkusɛ fiɛ Barzilai ɔkpese ɔkɛlɛ ɔ̃ iyo.<verse eid="2SA 19:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="2SA 19:40" />Gɔ igara ɔwara ɔkɛlɛ Gilgal ne, Kimxam ɔwara ɔwore ku wũ. Yuda makpakpɛ̃dze ɔɖuɖu gu Israel makpakpɛ̃dze kasɛ kawɛ̃ ɔkɔ igara mawaragu.<verse eid="2SA 19:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="2SA 19:41" />Iifɔ ɔwi ne, Israel marɛrɛ̃ ɔɖuɖu ɔtsɛ igara kɔrɛ ikɛlɛ iɣere wũ sɔ, "Be ɔso i bo manyii Yuda marɛrɛ̃ ɔyu igara maruigu fiɛ makɔ wũ gu ɔ̃ iyomaturi mawara Yordan ɔwore gu ɔ̃ makpakpɛ̃dze ɔɖuɖu ɔbua?"<verse eid="2SA 19:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="2SA 19:42" />Ne Yuda marɛrɛ̃ ɔɖuɖu ɔtã Israel marɛrɛ̃ mmuai sɔ, "Bobara ngbɔ alasɔ igara ne, bo ɔlɛdze ɔɖe. Be ɔso ito ikpɛ̃ mi sikpã? Be bofɔ igara araɖea awɛ̃ boɖe? Bosu ira iwɛ̃ botã so?"<verse eid="2SA 19:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="2SA 19:43" />Kere ne Israel marɛrɛ̃ ɔtã Yuda marɛrɛ̃ mmuai sɔ, "Boba kaɖekɔ̃ ikpɛ iweo i igara ame, fiɛ ne kama ne, boba David gbaã boɖo miba. Ne ɔso be ɔso mito mipupurira bo? Iiɖe bo loɖe katɔ̃ boɣɛ sɔ boakɔ bo igara bobɔ ɣɛɛ?"</para>
  <para style="p" vid="2SA 19:43">Ɣɛɛ Yuda marɛrɛ̃ ɔtã Israel marɛrɛ̃ mmuai i ituridaawarɛ ame kɔraa mabua maɖo Israel marɛrɛ̃.<verse eid="2SA 19:43" /></para>
  <chapter eid="2SA 19" />
  <chapter number="20" style="c" sid="2SA 20" />
  <para style="s">Seba Ɔta Ɔya I David Iso</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 20:1" />Ɔwi wɔmɔ ame ne, kulupiadze ɔwɛ̃ wɔ marɔ Seba, fiɛ ɔɖe Bikri ɔbibirɛrɛĩ fiɛ ɔbɔrɛ i Benyamin kamele ame ɔwe i mmɔ. Ɔfɛ̃ kadadã ɔlakulu ɔɣɛ sɔ,</para>
  <para style="q1" vid="2SA 20:1">"Bona kaɖekɔ̃ i David ame,</para>
  <para style="q2" vid="2SA 20:1">bona kakɔi i Yese ɔbi ame!</para>
  <para style="q1" vid="2SA 20:1">O Israel, ɔbiara si ɔkɛlɛ ɔ̃ ikpayo ame!"<verse eid="2SA 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 20:2" />Ne ɔso Israel marɛrɛ̃ ɔɖuɖu ɔkpese i David kama masiai Bikri ɔbibirɛrɛĩ Seba. Ɣɛɛ Yuda marɛrɛ̃ ɔwegu ma igara ita i Yordan ɔwore katɔ̃ isɛ iabo Yerusalem.<verse eid="2SA 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 20:3" />Gɔ David ɔkpese ɔkɛlɛ ɔ̃ igaraiyo i Yerusalem ne, ɔsu ɔ̃ masɔrɔ̃ iweo ma ɔnyua ɔsɛ i kama sɔ madzuɛ̃ igaraiyo ɔpia i iyo ise i madzuɛ̃se kayirinɔ. Ɔnyɔ ma iso, ɣɛɛ ɔ̃isirɛgu ma. Ɔtã ma masɛ ise lɛ makpisemare gbɔgbɔɔgbɔ makpi.<verse eid="2SA 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 20:4" />Kere ne igara ɔɣere Amasa sɔ, "Kpere Yuda marɛrɛ̃ ɔɖuɖu sɔ masikanya i ngbe i ayi atɛ ame si fɔ mɔmɔ ana si aba." <verse eid="2SA 20:4" /><verse number="5" style="v" sid="2SA 20:5" />Ɣɛɛ gɔ Amasa ɔsɛ ɔkpere Yuda marɛrɛ̃ ne, ɔfɔ ɔwi ɔɖo ɔwi wɔ i igara ɔsɛ wũ.<verse eid="2SA 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 20:6" />Ne David ɔɣere Abisai sɔ, "Kiniɔ ne, nnɛ i Bikri ɔbibirɛrɛĩ Seba to ɔ̃abara bo to ianyanyarĩ iɖo nnɛ i Absalom ɔbara. Kɔ mi ɔkɔse makpakpɛ̃dze si mitere misiai wũ si ɔ̃ibana simagɛ̃siare dzɛ matsue abere mapia ame ɔbo ɔtere bo iso." <verse eid="2SA 20:6" /><verse number="7" style="v" sid="2SA 20:7" />Ne ɔso Abisai ɔɖegu Yoab makpakpɛ̃dze gu ma Keretse gu ma Peletse<note caller="+" style="f"><char style="fr" closed="false">20.7 </char><char style="ft" closed="false">Ma Keretse gu ma Peletse: Maɖe mafɔ makpakpɛ̃dze ma mala maɔsu ɔpaa.</char></note> gu makpãrɛrɛĩ ɔɖuɖu katɔ̃ masɛ mabɔrɛ i Yerusalem matere masiai Bikri ɔbibirɛrɛĩ Seba kama.<verse eid="2SA 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 20:8" />Gɔ ame mapia i Gibeon Itasiare kɔrɛ ne, Amasa ɔba ɔ̃atu ma. Yoab ɔpia makpakpɛ̃dze ara, ɔsu kafiami ɔnyi so i ɔsɔ ame, fiɛ itekpe ɔwe i ɔyuɛ ame isarã iso. Gɔ ɔɖi kukpa ɔba katɔ̃ ne, ikpase ibɔrɛ i ɔyuɛ ame.<verse eid="2SA 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 20:9" />Ne Yoab ɔɣere Amasa sɔ, "Wũ ɔnyii, nda ise? Ne Yoab ɔsu ɔ̃ kuɖearɔ̃ ɔmɔɛ̃ Amasa i ɔkore si ɔfiɔ̃ wũ irɛkpo. <verse eid="2SA 20:9" /><verse number="10" style="v" sid="2SA 20:10" />Amasa iidzuɛ̃ so i itekpe nɛ i Yoab to i kɔrɔ̃ ame iso, ne ɔso Yoab ɔsu ne ɔtsue wũ i iyiri, siɣɛrɛ ɔbɔrɛ sifere i karɔ̃. Ɔ̃isitsue wũ ɔkpɛ nyɔare fiɛ Amasa ɔkpi. Ne Yoab gu ɔ̃ ɔnyiibi Abisai ɔtere masiai Bikri ɔbibirɛrɛĩ Seba.<verse eid="2SA 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 20:11" />Ne Yoab ɔrɛrɛ ɔwɛ̃ ɔya i Amasa kɔrɛ ɔɣɛ sɔ, "Ɔbiara wɔ i Yoab ara ɔbo anɔ gu mma nɖe David mare si masiai Yoab!" <verse eid="2SA 20:11" /><verse number="12" style="v" sid="2SA 20:12" />Amasa ɔrɛ i mmɔ i ɔ̃ mɔmɔ ima ame ne ɔrɛrɛ̃ ɔwɛ̃ ɔnya sɔ makpakpɛ̃dze ɔɖuɖu ma loba maabo i mmɔ ne, matuĩ. Gɔ ɔnya sɔ ɔbiara wɔ loba ɔ̃abo Amasa kɔrɛ ɔtuĩ ne, ɔrɛrɛ̃ wɔmɔ ɔbore wũ ɔɖi i ɔri iso ɔpia i sikua ame ɔsu awu ɔfu wũ. <verse eid="2SA 20:12" /><verse number="13" style="v" sid="2SA 20:13" />Gɔ maɔbore Amasa maɖi i ɔri iso kama ne, makpakpɛ̃dze ɔɖuɖu ɔso ɔri masiai Yoab mati Seba wɔ nɖe Bikri ɔbibirɛrɛĩ kama.<verse eid="2SA 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 20:14" />Seba ɔki i Israel kumele ɔɖuɖu ame isɛ iabo Abel Bet Maaka gu ma Beritse ibuiti ame fiɛ ma ɔɖuɖu ɔsikanya ne masiai wũ. <verse eid="2SA 20:14" /><verse number="15" style="v" sid="2SA 20:15" />Makpakpɛ̃dze ɔɖuɖu ma losiai Yoab ɔba maki malɔ Seba i Abel Bet Maaka. Makuri sise mali ɔmagɛ̃siare ibere nɛ i kama, matsɛ ne iwete ku sidziri sɔ si irɔ̃, <verse eid="2SA 20:15" /><verse number="16" style="v" sid="2SA 20:16" />ne ɔrɔ̃go ku iwola ɔwɛ̃ ɔkpere ɔbɔrɛgu i ɔmagɛ̃siare ame sɔ, "Mikã atsue! Mikã atsue! Miɣere Yoab sɔ ɔba i ngbe si loɖegu wũ ika." <verse eid="2SA 20:16" /><verse number="17" style="v" sid="2SA 20:17" />Yoab ɔkɛlɛ ɔ̃ kɔrɛ isɛ, ne ɔrɔ̃go ɔkarɛ sɔ, "Fɔ nɖe Yoab?"</para>
  <para style="p" vid="2SA 20:17">Ne Yoab ɔtɔrã sɔ, "Aĩ, mme loɖe."</para>
  <para style="p" vid="2SA 20:17">Ne ɔrɔ̃go ɔɣɛ sɔ, "Kã nnɛ i fɔ ɔɖabo to ɔba ɔ̃aɣɛ atsue."</para>
  <para style="p" vid="2SA 20:17">Ne Yoab ɔɣere wũ sɔ, "Loto lokã-ɔ atsue."<verse eid="2SA 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 20:18" />Ne ɔrɔ̃go ɔkɛlɛgu i katɔ̃ sɔ, "Kokooko ne, ɔɣɛ mala maɔɣɛ sɔ, 'Fɔ mmuai bɔrɛgu i Abel kɔrɛ,' iyɔ itɔ̃me ɔɔɖaɛ. <verse eid="2SA 20:18" /><verse number="19" style="v" sid="2SA 20:19" />Boɖe isobuɛ gu ɔmagɛ̃ wɔ nsɛ ɔbara ara i ɔri iso i Israel. Ato abie sɔ awɔra ɔmagɛ̃siare wɔ lonya, ɔba kuwarɛ i Israel. Be ɔso ato abie sɔ ame <char style="nd">Bosate</char> kaɖekɔ̃?"<verse eid="2SA 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 20:20" />Ne Yoab ɔtã mmuai sɔ, "Kuiyikuiyi! Iiɖe ngbɔ nɖe wũ adzuni sɔ loame ɣee lowɔra <char style="nd">Bosate</char> kaɖekɔ̃! <verse eid="2SA 20:20" /><verse number="21" style="v" sid="2SA 20:21" />Iiɖe ngbɔ nɖe itɔ̃me. Ɔrɛrɛ̃ wɔ marɔ Seba fiɛ ɔɖe Bikri ɔbibirɛrɛĩ wɔ lobɔrɛ i Efrayim kabemi karɔ̃ iso ɔta ɔya i igara iso, i David iso. Miɖi ɔrɛrɛ̃ ɔwɛ̃ wɔgbe mitã me si loarui i mi ɔmagɛ̃siare kɔrɛ."</para>
  <para style="p" vid="2SA 20:21">Ne ɔrɔ̃go ɔɣere Yoab sɔ, "Mato maafuĩdza ɔ̃ iti mabɔrɛgu i ibere iso masese-ɔ."<verse eid="2SA 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 20:22" />Kere ne ɔrɔ̃go wɔgbe ɔrui ɔsɛ ɔ̃asarɛgu maturi ɔɖuɖu fiɛ ku ɔ̃ iwola kuka ne, matu Seba, Bikri ɔbibirɛrɛĩ iti mafuĩdza masese Yoab. Ne ɔso Yoab ɔfɛ̃ kadadã fiɛ ɔ̃ makpakpɛ̃dze ka masasame marui i ɔmagɛ̃siare kɔrɛ ɔbiara ɔkɛlɛ ma aɖe. Ne Yoab ka ɔkpese ɔkɛlɛ igara kɔrɛ i Yerusalem ne.<verse eid="2SA 20:22" /></para>
  <para style="s1">David Makpakpa</para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 20:23" />Yoab loɖe makpakpɛ̃dze ɔɖuɖu i Israel ɔkpakpa, Benaya wɔ nɖe Yexoyada ɔbibirɛrɛĩ ɔɖe ma Keretse gu ma Peletse ɔkpakpa. <verse eid="2SA 20:23" /><verse number="24" style="v" sid="2SA 20:24" />Adoniram loɖe mma nto mabara ɔɣiɛ karabara ɔkpakpa, Yexosafat, Axilud ɔbibirɛrɛĩ loɖe nwɔ losia ara ikparĩ; <verse eid="2SA 20:24" /><verse number="25" style="v" sid="2SA 20:25" />Seva ɔɖe ratsɛrɛdze; Zadok gu Abiatar ɔɖe masɔrɛdze; <verse eid="2SA 20:25" /><verse number="26" style="v" sid="2SA 20:26" />fiɛ Ira wɔ loɖe Yairise ɔɖe David sɔrɛdze.<verse eid="2SA 20:26" /></para>
  <chapter eid="2SA 20" />
  <chapter number="21" style="c" sid="2SA 21" />
  <para style="s1">David Ɔtã Ma Gibeonse Itikuso</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 21:1" />Ɔwi wɔ i David to ɔɖe sigara ne, kukã ɔbo akɔ atɛ buu i kuɖokpo, ne ɔso David ɔbiɛ kaku ɔpia <char style="nd">Bosate</char>. Ne <char style="nd">Bosate</char> ɔɣere wũ sɔ, "Kukã ɔbo alasɔ Saul gu ɔ̃ iyo ɔɣɛrɛ alasɔ maɖoe ma Gibeonse."<verse eid="2SA 21:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 21:2" />Igara ɔkpere ma Gibeonse ne ɔɖe ma ika. (Ma Gibeonse iiɖe Israel mabi ɣɛɛ ma Amorise ma lokuti. Israel mabi ɔkã sɔ maatã masɛ ngbã, ɣɛɛ Saul ɔdzini ikpɛ̃ i Israel gu Yuda iti ne ɔbie sɔ si ɔwɔra ma.) <verse eid="2SA 21:2" /><verse number="3" style="v" sid="2SA 21:3" />David ɔkarɛ ma Gibeonse sɔ, "Be loabara lotã mi? Nda loabara sɔ lotã iɣɛrɛ nɛ mabara mi kuso si miafere <char style="nd">Bosate</char> kaɖekɔ̃ kusɛkusɛ?<verse eid="2SA 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 21:4" />Ma Gibeonse ɔtã mmuai sɔ, "Bona ɔri boakarɛ sikãrɛtɛa ɣee sikãfudza bobɔrɛgu i Saul ɣee ɔ̃ iyomaturi kɔrɛ, fiɛ bona ɔri boɖoe ɔturi kuwɛ̃ i Israel."</para>
  <para style="p" vid="2SA 21:4">David ɔkarɛ sɔ, "Be mito mibie sɔ lobara lotã mi?<verse eid="2SA 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 21:5" />Matã igara mmuai sɔ, "Ɔrɛrɛ̃ wɔ lowɔra bo fiɛ ɔta ɔya i bo iso fiɛ boɔro bosiina kasɛkɔ̃ i Israel ne, <verse eid="2SA 21:5" /><verse number="6" style="v" sid="2SA 21:6" />mitã bo mabirɛrɛĩ ikɔdzɛ i ɔ̃ ɔkparɛ ame, si maɖoe ma masɛ i <char style="nd">Bosate</char> anɔmi i Gibea ɔmagɛ̃ ame - Saul wɔ <char style="nd">Bosate</char> ɔsɔla nnɔĩ aɖe."</para>
  <para style="p" vid="2SA 21:6">Ne ɔso igara ɔɣɛ sɔ, "Loasu ma lotã mi."<verse eid="2SA 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 21:7" />Igara ɔnyɔ Mefiboset wɔ nɖe Yonatan ɔbibirɛrɛĩ fiɛ ɔɖe Saul ɔwabirɛrɛĩ nnya ala ndamu mɛ David gu Yonatan Saul ɔbibirɛrɛĩ ɔkã i <char style="nd">Bosate</char> anɔ ɔso. <verse eid="2SA 21:7" /><verse number="8" style="v" sid="2SA 21:8" />Ɣɛɛ igara ɔsu Armoni gu Mefiboset, ma nɖe Aya ɔbibirɔ̃gomi Rizpa mabi ma ɔɣe ɔtã Saul ɔbua i Saul ɔbibirɔ̃gomi Merab mabibirɛrɛĩ iru iso. Merab ɔɣe mabi magbe ɔtã Adriel wɔ nɖe Barzilia wɔ lobɔrɛ i Mexolat ɔbibirɛrɛĩ. <verse eid="2SA 21:8" /><verse number="9" style="v" sid="2SA 21:9" />Ɔsu ma ɔtã ma Gibeonse, ne maɖoe ma masɛ i kabemi iso i <char style="nd">Bosate</char> anɔmi ame. Ma ikɔdzɛ ɔɖuɖu ɔkpi ɔluwɛ̃, maɖoe ma i kamɔ ɔruiwi ayi ɖeakatɔ̃ ame, ɔwi wɔ i kamɔ irui ɔsɛ karɔ̃ kere. <verse eid="2SA 21:9" /><verse number="10" style="v" sid="2SA 21:10" />Rizpa wɔ nɖe Aya ɔbibirɔ̃gomi ɔsu ipundukoto ɔbara kasɛkɔ̃ ɔtã so i itasiare iso. Ɔwe i mmɔ ita i kamɔ ɔruiwi karɔ̃ isɛ gbɔgbɔɔgbɔ kado ɔpɛ ɔfere i makpise iso. Ɔ̃itã kato kurodzai sɔ kusɛ i makpise iso ku ikpɛnɛ ɣee kuputubɔi si kupɛgu ma ku kasɛ̃. <verse eid="2SA 21:10" /><verse number="11" style="v" sid="2SA 21:11" />Ɔwi wɔ maɣere David nnɛ i Rizpa, Saul ɔsɔrɔ̃, Aya ɔbibirɔ̃gomi ɔbara ne, <verse eid="2SA 21:11" /><verse number="12" style="v" sid="2SA 21:12" />David ɔsɛ ɔ̃asu Saul gu ɔ̃ ɔbi Yonatan akui i Yabes Gilead maturi kɔrɛ. (Yabes Gilead maturi ɔsu ma i iwɛrɛ ame i Bet San itiri, ngbegɔ i ma Filistise ɔsa ma gɔ maɔɖoe Saul i Gilboa kama.) <verse eid="2SA 21:12" /><verse number="13" style="v" sid="2SA 21:13" />David ɔsu Saul gu ɔ̃ ɔbibirɛrɛĩ Yonatan akui i mmɔ isu ibua i mma maɖoe manyua masɛ are ana.<verse eid="2SA 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 21:14" />Mabiara Saul gu ɔ̃ ɔbibirɛrɛĩ Yonatan akui i Saul ɔse Kis ikpibiɔ ame, i Zela ɔmagɛ̃ ame i Benyamin karɔ̃ iso. Ne mabara ibiara nɛ i igara ɔɣɛ. Ne kama ne Ɣaa ɔtã kayiikparama mmuai i karɔ̃ iti.<verse eid="2SA 21:14" /></para>
  <para style="s1">Kakpã I Ma Filistise Iso</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 21:15" />Kakpã ɔba i ma Filistise gu Israel mabi ndɛ̃ ana. David ɔkɛlɛgu ɔ̃ maturi masɛ maakpɛ̃ ma Filistise ne so ɔtu wũ ne. <verse eid="2SA 21:15" /><verse number="16" style="v" sid="2SA 21:16" />Ne Isbi-Benob, Rafa ɔkparɛ ɔwɛ̃ wɔ ayiwa ifele iti ɔrɔrã ɔɖe kilo itɛ gu kama fiɛ ɔla itekpe ɣɛtɛ ɔɣɛ sɔ ɔ̃aɖoe David. <verse eid="2SA 21:16" /><verse number="17" style="v" sid="2SA 21:17" />Ɣɛɛ Abisai Zeruya ɔbibirɛrɛĩ ɔba ɔ̃abuai David. Ɔwuĩ Filistise i karɔ̃ ne ɔɖoe wũ. Kere ne David maturi ɔkã maɣere wũ sɔ, "Kuiyikuiyi aisibabɔrɛgu bo akɛlɛ kakpã ame si Israel ɔkaniɛ ɔtɔ iibanyi."<verse eid="2SA 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 21:18" />Ɔwi kama ne kakpã mama ɔba ku ma Filistise i Gob. Ɔwi wɔmɔ ame ne, Sibekai Xusatse ɔɖoe Saf, wɔ nɖe ɔwɛ̃ i Rafa<note caller="+" style="f"><char style="fr" closed="false">21.18 </char><char style="ft" closed="false">Rafa: Maturi barani</char></note> ɔkparɛ ame.<verse eid="2SA 21:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 21:19" />I kakpã mama ku ma Filistise ame i Gob ne, Elxanan wɔ nɖe Yaare-Oregim ɔbibirɛrɛĩ wɔ lobɔrɛ i Betlehem ɔɖoe Goliat wɔ lobɔrɛ i Gat ɔnyiibi, ɔ̃ ifele ɔdziri ɔse lɛ katiwedze ɔdziri awe.<verse eid="2SA 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 21:20" />I kakpã mama ga loba i Gat ana ne, ɔrɛrɛ̃ siare ɔwɛ̃ ɔwe gɔ ɔwe arɔĩ akuɔ i kɔrɔ̃ biara iso, fiɛ akpagirĩ akuɔ i kukpa biara iso - wã ɔɖuɖu ɔɖe sinyɔ-ana. Ɔɖe nwɔ lobɔrɛ i Rafa ɔkparɛ ame. <verse eid="2SA 21:20" /><verse number="21" style="v" sid="2SA 21:21" />Gɔ ɔbara Israel aɣiãra ne Yonatan, Simea wɔ nɖe David ɔnyiibi, ɔbibirɛrɛĩ loɖoe wũ.<verse eid="2SA 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 21:22" />Maturi ina magbe ɔbɔrɛ i Rafa ɔkparɛ wɔ lobɔrɛ i Gat ame, fiɛ mawɔ i David gu ɔ̃ marɛrɛ̃ nrɔɔ̃ ame.<verse eid="2SA 21:22" /></para>
  <chapter eid="2SA 21" />
  <chapter number="22" style="c" sid="2SA 22" />
  <para style="s1">David Ɔka Ileaka Ɔtã Bosate</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 22:1" />David ɔka kuka gɔgbe atɔ̃me ku ɔwi wɔ i <char style="nd">Bosate</char> ɔɖi wũ i ɔ̃ matsirise ɔɖuɖu nrɔɔ̃ ame gu i Saul nrɔɔ̃ ame. <verse eid="2SA 22:1" /><verse number="2" style="v" sid="2SA 22:2" />Ɔɣɛ sɔ,</para>
  <para style="q1" vid="2SA 22:2">"<char style="nd">Bosate</char> nɖe wũ itasiare, wũ ɔlekasɛkɔ̃ gu wũ fɔdze;<verse eid="2SA 22:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="2SA 22:3" />wũ Ɣaa nɖe wũ itasiare, ɔ̃ lotarĩgu,</para>
  <para style="q2" vid="2SA 22:3">wũ akpiraifɔra gu wũ iɖi ɔle.</para>
  <para style="q1" vid="2SA 22:3">Ɔ̃ nɖe wũ ɔlekasɛkɔ̃, wũ katarikɔ̃ gu wũ ɖidze -</para>
  <para style="q2" vid="2SA 22:3">aɖi me abɔrɛgu i maturi nyanyariã nrɔɔ̃ ame.<verse eid="2SA 22:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="2SA 22:4" />Lokpere <char style="nd">Bosate</char>, nwɔ lokote ɔtã ile,</para>
  <para style="q2" vid="2SA 22:4">ne lona iɖi lobɔrɛgu i wũ matsirise nrɔɔ̃ ame.<verse eid="2SA 22:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="2SA 22:5" />"Kukpi sipotutaa ɔki silɔ me;</para>
  <para style="q2" vid="2SA 22:5">iwɔ nduborea teteree ɔmɔɛ̃ me mito.<verse eid="2SA 22:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="2SA 22:6" />Ikpibiɔ awɛĩ ɔmini me ato;</para>
  <para style="q2" vid="2SA 22:6">fiɛ kukpi iyebi ɔgbere ise me.<verse eid="2SA 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="2SA 22:7" />Lokpere <char style="nd">Bosate</char> i wũ isoma ame;</para>
  <para style="q2" vid="2SA 22:7">lokpere wũ Ɣaa si ɔbuai me.</para>
  <para style="q1" vid="2SA 22:7">Ɔnɔ wũ silɔ i ɔ̃ isɔrɛyo ame;</para>
  <para style="q2" vid="2SA 22:7">wũ kaku ɔbo wũ i atsue ame.<verse eid="2SA 22:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="2SA 22:8" />"Karɔ̃ ɔti kasɛ kakpese,</para>
  <para style="q2" vid="2SA 22:8">kato sikaĩ ɔti;</para>
  <para style="q2" vid="2SA 22:8">siti sikpakpa alasɔ ɔna sikpã.<verse eid="2SA 22:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="2SA 22:9" />Kuyɔ ɔbɔrɛ i ɔ̃ ɔɣɔ̃ ame;</para>
  <para style="q2" vid="2SA 22:9">ne ɔtɔ sinyagɛmi ɔbɔrɛ i kanya ame,</para>
  <para style="q2" vid="2SA 22:9">fiɛ akaĩ wa lomɔɛ̃ ato ɔbɔrɛ i kã ame.<verse eid="2SA 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="2SA 22:10" />Ɔkɛ kato ɔso ɔba karɔ̃;</para>
  <para style="q2" vid="2SA 22:10">adɔdɔ kpinakpina ɔwe i ɔ̃ ngba kayirinɔ.<verse eid="2SA 22:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="2SA 22:11" />Ɔta ɔsɛ i kerubi iso ne ɔfɛrɛrɛ ne;</para>
  <para style="q2" vid="2SA 22:11">ɔkɛlɛ kato i ɔwiri abue iso.<verse eid="2SA 22:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="2SA 22:12" />Ɔpia so idududu lɛ ɔ̃ ikatigbɔdɔ ɔki ɔlɔ so -</para>
  <para style="q2" vid="2SA 22:12">kado adɔdɔ kpirikpiria i kuɖokpo.<verse eid="2SA 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="2SA 22:13" />Ikpawaĩ ɔfiɛ iki ilɔ wũ</para>
  <para style="q2" vid="2SA 22:13">ikpawaĩ lɛ ɔtɔ imama ɔsa ibɔrɛ.<verse eid="2SA 22:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="2SA 22:14" />
    <char style="nd">Bosate</char> ɔɖi silɔ i kato lɛ kadoiɖu;</para>
  <para style="q2" vid="2SA 22:14">Nwɔ Lokɔlɛ ɔɖo silɔ ɔre.<verse eid="2SA 22:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="2SA 22:15" />Ɔpɛ mirɛ̃ ne ɔsamera ɔ̃ matsirise,</para>
  <para style="q2" vid="2SA 22:15">ɔpɛ ɔtɔ imama ɔsamera ma matere.<verse eid="2SA 22:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="2SA 22:16" />Gɔ <char style="nd">Bosate</char> ɔna sikpã,</para>
  <para style="q2" vid="2SA 22:16">fiɛ ɔwarã teteree ɔbɔrɛgu i ɔɣɔ̃ ame ne,</para>
  <para style="q1" vid="2SA 22:16">ɔpo ame kugbolomi ɔse wawe</para>
  <para style="q2" vid="2SA 22:16">ne karɔ̃ sikaĩ ɔse kpawee ne.<verse eid="2SA 22:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="2SA 22:17" />"Ɔso ɔbɔrɛ i kato ne ɔɖi kɔrɔ̃ ɔmɔɛ̃ me ne;</para>
  <para style="q2" vid="2SA 22:17">ɔkpadzɛ̃ me ɔɖi i ndu wodoroa ame.<verse eid="2SA 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="2SA 22:18" />Ɔfɔ me ɔbɔrɛgu i wũ matsirise ma mba ɔle nrɔɔ̃ ame,</para>
  <para style="q2" vid="2SA 22:18">ɔfɔ me ɔbɔrɛgu i wũ makpɛ̃guse ma mba ɔle kaɖu nrɔɔ̃ ame.<verse eid="2SA 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="2SA 22:19" />Mabo me iso ku iyi nɛ lobo imɔrɛ̃ ame,</para>
  <para style="q2" vid="2SA 22:19">ɣɛɛ <char style="nd">Bosate</char> loɖe wũ buaidze.<verse eid="2SA 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="2SA 22:20" />Ɔkɔ me ɔbɔ kakɔĩ ga lowarɛ;</para>
  <para style="q2" vid="2SA 22:20">ɔɖi me alasɔ lobo wũ anɔ.<verse eid="2SA 22:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="2SA 22:21" />"<char style="nd">Bosate</char> ɔɔtã me kuso i wũ sibɔlɔlɔ iti;</para>
  <para style="q2" vid="2SA 22:21">ɔ̃ɔtã me kuso i kumɛgɔ wũ nrɔɔ̃ ame ɔkpa iti.<verse eid="2SA 22:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="2SA 22:22" />Ala loɔmɔɛ̃ <char style="nd">Bosate</char> siri lola ɔso.</para>
  <para style="q2" vid="2SA 22:22">Loibara ikpi iki i wũ Ɣaa isɛ̃ ame.<verse eid="2SA 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="2SA 22:23" />Ɔ̃ mmara ɔɖuɖu pia me i iti ame.</para>
  <para style="q2" vid="2SA 22:23">Loipɛ lofiriki i ɔ̃ asɛ̃ra iso.<verse eid="2SA 22:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="2SA 22:24" />Loibara iɣɛrɛ i ɔ̃ anɔ</para>
  <para style="q2" vid="2SA 22:24">fiɛ loɔɖi so i ikpi ame.<verse eid="2SA 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="2SA 22:25" />
    <char style="nd">Bosate</char> ɔɔtã me kuso i wũ sibɔlɔlɔ iti.</para>
  <para style="q2" vid="2SA 22:25">
    <char style="nd">Bosate</char> ɔɔtã me kuso i kumɛgɔ wũ nrɔɔ̃ ame ɔkpa i ɔ̃ anɔ.<verse eid="2SA 22:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="2SA 22:26" />"Asɛ aɖi so ate mma nsɛ maɖe ɔnukuare sɔ aɖe ɔnukuarese.</para>
  <para style="q2" vid="2SA 22:26">Asɛ aɖi so ate mma nna iɣɛrɛ sɔ ana iɣɛrɛ.<verse eid="2SA 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="2SA 22:27" />Asɛ aɖi so ate mma ɔtu lokpa sɔ akpa,</para>
  <para style="q2" vid="2SA 22:27">ɣɛɛ matilese ne aisɛ anyɔ ma nnya.<verse eid="2SA 22:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="2SA 22:28" />Asɛ aɖi mabɔsokarɔĩ</para>
  <para style="q2" vid="2SA 22:28">ɣɛɛ fɔ anɔmi sia i mma nsɛ manyɔ so gɔ aabɔ ma karɔ̃.<verse eid="2SA 22:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="2SA 22:29" />O <char style="nd">Bosate</char> fɔ nɖe wũ ɔkaniɛ;</para>
  <para style="q2" vid="2SA 22:29">
    <char style="nd">Bosate</char> sɛ ɔfirikira wũ idududu ikpese ikpawaĩ.<verse eid="2SA 22:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="2SA 22:30" />Asɛ abuai me si lota lobo matsirise makpakpɛ̃dze iso;</para>
  <para style="q2" vid="2SA 22:30">Ɣaa ɔle ame nsɛ lowara ibere.<verse eid="2SA 22:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="2SA 22:31" />"Ɣaa ɣɛɛ ne, ɔ̃ siri ɔkpa.</para>
  <para style="q2" vid="2SA 22:31">
    <char style="nd">Bosate </char> itɔ̃me ɖe nnɛ iso maasiaiti.</para>
  <para style="q1" vid="2SA 22:31">Akpiraifɔra ɔɖe</para>
  <para style="q2" vid="2SA 22:31">ɔtã mma ɔɖuɖu nsɛ matarĩgu wũ.<verse eid="2SA 22:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="2SA 22:32" />
    <char style="nd">Bosate</char> ɔnɔwɛ̃saã nɖe Ɣaa.</para>
  <para style="q2" vid="2SA 22:32">Ɣaa ɔnɔwɛ̃saã nɖe Itasiare.<verse eid="2SA 22:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="2SA 22:33" />Ɣaa nɖe wũ ɔlekasɛkɔ̃</para>
  <para style="q2" vid="2SA 22:33">fiɛ ɔsɛ ɔbara wũ ɔri ɔkpa.<verse eid="2SA 22:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="2SA 22:34" />Ɔsɛ ɔbara wũ ngba lɛ kasɔlɔ ɔkpɛ awe;</para>
  <para style="q2" vid="2SA 22:34">ɔsɛ ɔmɔɛ̃ me ɔla i abe iso.<verse eid="2SA 22:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="2SA 22:35" />Ɔsɛ ɔkpadzɛ̃ me kumɛgɔ loakpɛ̃ kakpã;</para>
  <para style="q2" vid="2SA 22:35">wũ nrɔɔ̃ sɛ miwo ayiwa kuta ɔkpadzɛ̃.<verse eid="2SA 22:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="2SA 22:36" />Asɛ atã me fɔ iɖeiso akpiraifɔra,</para>
  <para style="q2" vid="2SA 22:36">akɔ so abɔ karɔ̃ ne abara me ɔsiare.<verse eid="2SA 22:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="2SA 22:37" />Abɛra ɔri atã wũ ngba,</para>
  <para style="q2" vid="2SA 22:37">si wũ ngbakɔrɔ iibapɛ mifiriki.<verse eid="2SA 22:37" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="38" style="v" sid="2SA 22:38" />"Lotere losiai wũ matsirise fiɛ lowɔra ma.</para>
  <para style="q2" vid="2SA 22:38">Loipɛ lokpese gbɔgbɔɔgbɔ lowɔra ma.<verse eid="2SA 22:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="2SA 22:39" />Lowɔra ma pelepele fiɛ maisibawo ɔta;</para>
  <para style="q2" vid="2SA 22:39">marɔ̃ mafere i wũ ngbatɔ̃.<verse eid="2SA 22:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="2SA 22:40" />Asɛ atã me ɔle atã kakpã;</para>
  <para style="q2" vid="2SA 22:40">atã wũ makpɛ̃guse ɔrɔ̃ i wũ ngbatɔ̃.<verse eid="2SA 22:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="2SA 22:41" />Atã wũ matsirise ɔpɛ mafiriki matere,</para>
  <para style="q2" vid="2SA 22:41">ne lowɔra wũ matsirise.<verse eid="2SA 22:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="2SA 22:42" />Mabiɛ mabie kabuai, ɣɛɛ kuwɛ̃ na ɔ̃aɖi ma -</para>
  <para style="q2" vid="2SA 22:42">makpere <char style="nd">Bosate</char> ɣɛɛ ɔ̃itɔrã.<verse eid="2SA 22:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="2SA 22:43" />Lobibiɛ ma makpese lɛ karɔ̃ ɔsebu ɖɛkpɛrɛa awe.</para>
  <para style="q2" vid="2SA 22:43">Lowete fiɛ lonene ma lɛ ibata i sivurã iso.<verse eid="2SA 22:43" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="44" style="v" sid="2SA 22:44" />"Aɖi me i wũ maturi itaiyaiso ame;</para>
  <para style="q2" vid="2SA 22:44">ne amɔɛ̃ me ala lɛ nɖebi ɖeisose.</para>
  <para style="q1" vid="2SA 22:44">Maturi ma loiɣe abɔ i wũ kayirinɔ,<verse eid="2SA 22:44" /></para>
  <para style="q2">
    <verse number="45" style="v" sid="2SA 22:45" />ne mafɔ ɔba maapɛ mamatã me;</para>
  <para style="q2" vid="2SA 22:45">kumɛgɔ ame maanɔ wũ silɔ kere, masɛ mawarɛ me.<verse eid="2SA 22:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="2SA 22:46" />Ma ɔɖuɖu ɔyu katetere;</para>
  <para style="q2" vid="2SA 22:46">mabɔrɛ i ma silekusɛkɔ̃ maba mato mati makpakpa.<verse eid="2SA 22:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="2SA 22:47" />"<char style="nd">Bosate</char> pia ngbã! Maale wũ Itasiare!</para>
  <para style="q2" vid="2SA 22:47">Maakɔlɛ Ɣaa kato, Itasiare, wũ Ɖidze!<verse eid="2SA 22:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="2SA 22:48" />Ɔɖe Ɣaa wɔ nsɛ ɔtikuso ɔtã me</para>
  <para style="q2" vid="2SA 22:48">nwɔ nsɛ ɔsu nɖebi ɔpia i wũ kayirinɔ,<verse eid="2SA 22:48" /></para>
  <para style="q2">
    <verse number="49" style="v" sid="2SA 22:49" />nwɔ nsɛ ɔtã me iwarã i wũ matsirise nrɔɔ̃ ame.</para>
  <para style="q1" vid="2SA 22:49">Akɔlɛ me kato aɖo wũ makpɛ̃guse;</para>
  <para style="q2" vid="2SA 22:49">aɖi me abɔrɛgu i maturi nyanyariã nrɔɔ̃ ame.<verse eid="2SA 22:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="2SA 22:50" />O <char style="nd">Bosate</char>, ne ɔso loale-ɔ i nɖebi ndɛ̃.</para>
  <para style="q2" vid="2SA 22:50">Loaka ileaka lotã fɔ iyere.<verse eid="2SA 22:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="2SA 22:51" />Ɔsɛ ɔtã ɔ̃ igara iɖeiso siare;</para>
  <para style="q2" vid="2SA 22:51">ɔsɛ ɔɖi kayiribielea ɔte nwɔ ɔsɔla nnɔĩ,</para>
  <para style="q2" vid="2SA 22:51">ɔtã David gu ɔ̃ ɔkparɛ ɔwi daaro."<verse eid="2SA 22:51" /></para>
  <chapter eid="2SA 22" />
  <chapter number="23" style="c" sid="2SA 23" />
  <para style="s1">David Atɔ̃me Tsɔra</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 23:1" />David atɔ̃me tsɔra i ngbe ne:</para>
  <para style="q1" vid="2SA 23:1">"David Yese ɔbibirɛrɛĩ ɔɣɛ ikpakpatɔ̃me,</para>
  <para style="q2" vid="2SA 23:1">Ɔturi wɔ i Nwɔ Lokɔlɛ Ɔɖo ɔkɔlɛ kato ikpakpatɔ̃me,</para>
  <para style="q1" vid="2SA 23:1">ɔrɛrɛ̃ wɔ i Yakob Ɣaa ɔsɔla nnɔĩ,</para>
  <para style="q2" vid="2SA 23:1">ɔturi wɔ lowe ileaka mɛrɛ̃mɛrɛã ɔtã Israel.<verse eid="2SA 23:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="2SA 23:2" />"<char style="nd">Bosate</char> Siwarã ɔɖeika sikigu i wũ ame;</para>
  <para style="q2" vid="2SA 23:2">ɔ̃ itɔ̃me ɔsia me i ɔnyagɛmi iso.<verse eid="2SA 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="2SA 23:3" />Israel Ɣaa ɔɖeika,</para>
  <para style="q2" vid="2SA 23:3">Israel Itasiare ɔɣere me sɔ,</para>
  <para style="q1" vid="2SA 23:3">'Si ɔturi ɔɖe maturi iso i sibɔlɔlɔ ame ne,</para>
  <para style="q2" vid="2SA 23:3">si ɔɖeiso i Ɣaa kunigã ame ne,<verse eid="2SA 23:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="2SA 23:4" />ɔsɛ ɔse lɛ kaya kuɣɛ̃ ibɔrɛ ɔtɔ</para>
  <para style="q2" vid="2SA 23:4">ku kaya ga adɔdɔ na awe.</para>
  <para style="q1" vid="2SA 23:4">Ɔsɛ ɔse lɛ kumɛgɔ isɛ ikpa ku kado kama</para>
  <para style="q2" vid="2SA 23:4">ne isɛ itã sikua ɔre i karɔ̃.'<verse eid="2SA 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="2SA 23:5" />"Wũ iyo se kukaakɔ ku Ɣaa.</para>
  <para style="q2" vid="2SA 23:5">Ɔbaragu me ndamu daaro,</para>
  <para style="q2" vid="2SA 23:5">mɛ nɣɛ kukaakɔ i ɔri biara iso.</para>
  <para style="q1" vid="2SA 23:5">Ɔto ɔ̃atã me iɖi lɛ isaruɛ</para>
  <para style="q2" vid="2SA 23:5">fiɛ ɔ̃atã wũ kubie ɔɖuɖu ɔba ne ame.<verse eid="2SA 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="2SA 23:6" />Ɣɛɛ maturi nyanyariã ɔɖuɖu ne maasu ma mapɛyu lɛ miyu</para>
  <para style="q2" vid="2SA 23:6">mɛ maisɛ masu nrɔɔ̃ mabodza awe.<verse eid="2SA 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="2SA 23:7" />Ɔturi ɔrere wɔ nsɛ ɔpɛgu miyu</para>
  <para style="q2" vid="2SA 23:7">sɛ ɔsu ibɔraira ɣɛɛ ifele ɔdziri;</para>
  <para style="q2" vid="2SA 23:7">masɛ matsuedza mɛ i ngbegɔ mise."<verse eid="2SA 23:7" /></para>
  <para style="s1">David Makpãrɛrɛĩ Ma Lofɔ Iyere</para>
  <para style="q1">
    <verse number="8" style="v" sid="2SA 23:8" />David makpãrɛrɛĩ ayere ngbe ne:</para>
  <para style="p" vid="2SA 23:8">Yoseb-Basebet wɔ loɖe Takemonse, loɖe ma Itɛ ɔkpakpa. Ɔsu ifele ɔɖoe maturi alafa fafarana fiɛ ɔɖoe ma i kakpã kawɛ̃ ame.<verse eid="2SA 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 23:9" />Nwɔ i ɔ̃ kama loɖe Eleazar Dodai ɔbibirɛrɛĩ, ɔbɔrɛ i Axo ɔkparɛ ame. Lɛ makpãrɛrɛĩ itɛ ɔwɛ̃ ne, ɔwegu David fiɛ mabara ma Filistise ma losakanya i Pas Dammim matã kakpã aɣiãra. Ne kere Israel maturi ɔkpese kama, <verse eid="2SA 23:9" /><verse number="10" style="v" sid="2SA 23:10" />ɣɛɛ Eleazar ɔya i ɔ̃ kayakɔ̃ ɔwuĩ ma Filistise i karɔ̃ gbɔgbɔɔgbɔ so ɔtu ɔ̃ kɔrɔ̃ ɔɖo wũ kaɖoma gɔ ɔma ipɛmi ɔla. <char style="nd">Bosate</char> ɔtã iɖeiso siare ku iyi nɛmɔ. Kama ne makpakpɛ̃dze ɔkpese maba Eleazar kɔrɛ, ɣɛɛ ne maɖi akpakpɛ̃ra gu ara mama i makpise iso.<verse eid="2SA 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 23:11" />I ɔ̃ kama Samma Agee ɔbibirɛrɛĩ Xararse ɔsiai. Ɔwi wɔ i ma Filistise ɔsikanya i Lexi fiɛ mata kakpã i Israel mabi iso i ngbegɔ karɔ̃ ɔyigu ayiforobi awɛĩ ne, Israel makpakpɛ̃dze ɔrui matere i ma Filistise kɔrɛ. <verse eid="2SA 23:11" /><verse number="12" style="v" sid="2SA 23:12" />Ɣɛɛ Samma ɔya i ɔ̃ kayakɔ̃ i kakpɛkɔ̃ ndɛndɛ̃. Ɔkpɛ̃ i kã iti ne ɔwuĩ ma Filistise i karɔ̃, ne <char style="nd">Bosate</char> ɔtã iɖeiso siare.<verse eid="2SA 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 23:13" />Ɔraɖui ɔsɔrɛ̃wi ne, makpãrɛrɛĩ itɛ i makpakpa sitɛ ndɛ̃ ɔba David kɔrɛ i ɔkpolo ame i Adulam. Ɔwi wɔgbe ne ma Filistise makpakpɛ̃dze mawɛ̃ ɔbara kasɛkɔ̃ i Refaim Kagbolomi ame. <verse eid="2SA 23:13" /><verse number="14" style="v" sid="2SA 23:14" />Ɔwi wɔmɔ ame ne David ɔwe i ɔlekasɛkɔ̃, fiɛ ma Filistise makpakpɛ̃dze ɔbara kasɛkɔ̃ i Betlehem. <verse eid="2SA 23:14" /><verse number="15" style="v" sid="2SA 23:15" />Ɔme ɔkore David gbaã ne ɔɣɛ sɔ, "Loaɖɔɛ si ɔrere aabɔ me ndu mɛ i ibiɔ ame i Betlehem kayogodɔ̃ kɔrɛ lonɛ kere!" <verse eid="2SA 23:15" /><verse number="16" style="v" sid="2SA 23:16" />Ne ɔso makpãrɛrɛĩ itɛ mamɔ ɔkpɛ̃ maki i ma Filistise kasɛkɔ̃, maka ndu mabɔrɛgu i ibiɔ ame i Betlehem kayogodɔ̃ kɔrɛ masore mabɔ David. Ɣɛɛ ɔsɛ̃ ɔ̃inɛ me, ne ɔsu me ɔfere i <char style="nd">Bosate</char> anɔ i ne kanya. <verse eid="2SA 23:16" /><verse number="17" style="v" sid="2SA 23:17" />Ɔɣɛ sɔ, "O <char style="nd">Bosate</char>, kuiyikuiyi sɔ loabara ne igbã! Ito iase kere lɛ lonɛ marɛrɛ̃ ma lomɔrɛ̃dza ma ngbã ima." Ne ɔso David iinɛ ndu.</para>
  <para style="p" vid="2SA 23:17">Kumɛgɔgbe loɖe makpãrɛrɛĩ itɛ magbe kubarara ne.<verse eid="2SA 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 23:18" />Abisai wɔ nɖe Yoab Zeruya ɔbibirɛrɛĩ, ɔnyiibi loɖe ma Sitɛ tɔ̃ɖedze. Ɔsu ɔ̃ ifele ɔɖoe maturi alafa atɛ, ne ɔso ɔfɔ iyere lɛ ma Itɛ. <verse eid="2SA 23:18" /><verse number="19" style="v" sid="2SA 23:19" />Matã wũ kuwarɛ maɖo ma Itɛ. Ɔkpese ma ɔkpakpa pelepele, atoasɔ maisu wũ mapia i ma ndɛ̃.<verse eid="2SA 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 23:20" />Benaya Yexoyada ɔbibirɛrɛĩ ɔɖe kpãrɛrɛĩ wɔ lowe kagbegbe gbaã ɔbɔrɛ i Kabzeel, ɔbara ara siare. Ɔwuĩ ma Moabse makpãrɛrɛĩ inyɔ ma nlɛ maɖo i karɔ̃. Ɔso ɔbo i iwo ame ku iyi nɛ kado ku atumagirĩ to ɔpɛ fiɛ ise kpɔlɔkpɔlɔ ɔsɛ ɔ̃aɖoe dzata. <verse eid="2SA 23:20" /><verse number="21" style="v" sid="2SA 23:21" />Ɔwuĩ Egiptese siare ɔwɛ̃ i karɔ̃ atoasɔ ɔla ifele ne, Benaya ɔsu ikpo ɔkpɛ̃gu wũ. Ne ɔtsuɛ ifele ɔfɔ i Egiptese kɔrɔ̃ ame ne ɔsu ne ɔɖoe wũ. <verse eid="2SA 23:21" /><verse number="22" style="v" sid="2SA 23:22" />Kumɛgɔgbe loɖe Benaya Yexoyada ɔbibirɛrɛĩ kubarara ne. Ɔ̃ wũ ɔfɔ iyere lɛ makpãrɛrɛĩ itɛ ma losɛ maaka ndu. <verse eid="2SA 23:22" /><verse number="23" style="v" sid="2SA 23:23" />Ɔfɔ kuwarɛ gbaã ɔɖo ɔrere i maturi Sitɛ ndɛ̃, ɣɛɛ maipia wũ i maturi Itɛ ndɛ̃. David ɔsu wũ ɔsɛra i ɔ̃ isomadzuɛ̃se kanya.<verse eid="2SA 23:23" /></para>
  <para style="b" />
  <para style="li2">
    <verse number="24" style="v" sid="2SA 23:24" />Mmagbe lowe i maturi Sitɛ ndɛ̃ ne:</para>
  <para style="li3" vid="2SA 23:24">Asaxel Yoab ɔnyiibi,</para>
  <para style="li3" vid="2SA 23:24">Elxanan Dodo ɔbibirɛrɛĩ wɔ lobɔrɛ i Betlehem,<verse eid="2SA 23:24" /></para>
  <para style="li3">
    <verse number="25" style="v" sid="2SA 23:25" />Samma wɔ lobɔrɛ i Xarod,</para>
  <para style="li3" vid="2SA 23:25">Elika wɔ lobɔrɛ i Xarod,<verse eid="2SA 23:25" /></para>
  <para style="li3">
    <verse number="26" style="v" sid="2SA 23:26" />Xelez wɔ lobɔrɛ i Palti,</para>
  <para style="li3" vid="2SA 23:26">Ira Ikes ɔbibirɛrɛĩ wɔ lobɔrɛ i Tekoa,<verse eid="2SA 23:26" /></para>
  <para style="li3">
    <verse number="27" style="v" sid="2SA 23:27" />Abiezer wɔ lobɔrɛ i Anatot,</para>
  <para style="li3" vid="2SA 23:27">Mebunai Xusatse,<verse eid="2SA 23:27" /></para>
  <para style="li3">
    <verse number="28" style="v" sid="2SA 23:28" />Zalmon wɔ lobɔrɛ Axo,</para>
  <para style="li3" vid="2SA 23:28">Maxarai Netofatse,<verse eid="2SA 23:28" /></para>
  <para style="li3">
    <verse number="29" style="v" sid="2SA 23:29" />Xeled, Baana ɔbibirɛrɛĩ wɔ nɖe Netofatse,</para>
  <para style="li3" vid="2SA 23:29">Itai Ribai ɔbibirɛrɛĩ wɔ lobɔrɛ Gibea i Benyamin karɔ̃ ame.<verse eid="2SA 23:29" /></para>
  <para style="li3">
    <verse number="30" style="v" sid="2SA 23:30" />Benaya Piratonse,</para>
  <para style="li3" vid="2SA 23:30">Xiddai wɔ lobɔrɛ i Gaas kuwɛlagbolomi ame.<verse eid="2SA 23:30" /></para>
  <para style="li3">
    <verse number="31" style="v" sid="2SA 23:31" />Abi-Albon Arbatse,</para>
  <para style="li3" vid="2SA 23:31">Azmavet Barxumse,<verse eid="2SA 23:31" /></para>
  <para style="li3">
    <verse number="32" style="v" sid="2SA 23:32" />Eliaba Saalbonse,</para>
  <para style="li3" vid="2SA 23:32">Yasen mabibirɛrɛĩ,</para>
  <para style="li3" vid="2SA 23:32">Yonatan <verse eid="2SA 23:32" /><verse number="33" style="v" sid="2SA 23:33" />Samma ɔbibirɛrɛĩ wɔ lobɔrɛ Xarar,</para>
  <para style="li3" vid="2SA 23:33">Axiam, Sarar ɔbibirɛrɛĩ wɔ lobɔrɛ i Xarar,<verse eid="2SA 23:33" /></para>
  <para style="li3">
    <verse number="34" style="v" sid="2SA 23:34" />Elifelet Axasbai ɔbibirɛrɛĩ Maakatse</para>
  <para style="li3" vid="2SA 23:34">Eliam Axitofel ɔbibirɛrɛĩ Gilonse<verse eid="2SA 23:34" /></para>
  <para style="li3">
    <verse number="35" style="v" sid="2SA 23:35" />Xezro wɔ lobɔrɛ i Karmel,</para>
  <para style="li3" vid="2SA 23:35">Paarai wɔ lobɔrɛ i Arbi,<verse eid="2SA 23:35" /></para>
  <para style="li3">
    <verse number="36" style="v" sid="2SA 23:36" />Igal, Natan ɔbibirɛrɛĩ wɔ lobɔrɛ i Zoba,</para>
  <para style="li3" vid="2SA 23:36">Xagri ɔbibirɛrɛĩ,<verse eid="2SA 23:36" /></para>
  <para style="li3">
    <verse number="37" style="v" sid="2SA 23:37" />Zelek Amonse</para>
  <para style="li3" vid="2SA 23:37">Naxarai Beerotse, wɔ loɖe Yoab Zeruya ɔbibirɛrɛĩ akpirasarãdze,<verse eid="2SA 23:37" /></para>
  <para style="li3">
    <verse number="38" style="v" sid="2SA 23:38" />Ira Itrise</para>
  <para style="li3" vid="2SA 23:38">Gareb Itrise<verse eid="2SA 23:38" /></para>
  <para style="li3">
    <verse number="39" style="v" sid="2SA 23:39" />gu Uria Xitise.</para>
  <para style="li2" vid="2SA 23:39">Ma ɔɖuɖu ɔɖe maturi sitɛ-ikɔdzɛ.<verse eid="2SA 23:39" /></para>
  <chapter eid="2SA 23" />
  <chapter number="24" style="c" sid="2SA 24" />
  <para style="s1">David Ɔtã Maka Makpakpɛ̃dze</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 24:1" />Ɔwi mama ne <char style="nd">Bosate</char> ɔnagu Israel mabi sikpã ana, ne ɔtã sɔ David si ɔbɔ imɔrɛ̃ i ma iso. Ɔɣere David sɔ, "Kɛlɛ si atã maka makpakpɛ̃dze i Israel gu Yuda."<verse eid="2SA 24:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 24:2" />Ne ɔso igara David ɔɣere Yoab gu makpakpɛ̃dze makpakpa ma lowegu wũ sɔ, "Miki i Israel kumele ɔɖuɖu ame ita i Dan ɔmagɛ̃ i kato ikɛlɛ Beerseba ɔmagɛ̃ i kala. Si mitsɛrɛ makpakpɛ̃dze ayere si loatsue mma ɖoɖooɖo mpia."<verse eid="2SA 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 24:3" />Ɣɛɛ Yoab ɔtã igara mmuai sɔ, "<char style="nd">Bosate </char> fɔ Ɣaa si ɔmɔdza fɔ makpakpɛ̃dze ikpɛ kulafa gu kama, si wũ ɔkɔse igara si ɔnya. Ɣɛɛ be ɔso i wũ ɔkɔse igara to ɔbie sɔ ɔbara nnɛmɔ igbã?"<verse eid="2SA 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 24:4" />Igara ɔya iso sɔ Yoab gu makpakpɛ̃dze makpakpa si mabara i ɔ̃ itɔ̃me iso. Ne ɔso marui i ɔ̃ kɔrɛ masɛ maaka mma loɔkote makpakpɛ̃dze i Israel.<verse eid="2SA 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 24:5" />Gɔ mawara Yordan ɔwore kama ne, mabara kasɛkɔ̃ i Aroer ɔmagɛ̃ i kala i kagbolomi ame, ne ka maki i Gad ame makɛlɛ Yazer. <verse eid="2SA 24:5" /><verse number="6" style="v" sid="2SA 24:6" />Makɛlɛ Gilead gu Tatim Xodsi ibuiti ame, ne mabo Dan Yaan gu ndɛ̃mɔ ikɛlɛ Sidon isɛ. <verse eid="2SA 24:6" /><verse number="7" style="v" sid="2SA 24:7" />Ne ka makɛlɛ Tiro wɔ abere ɔki alɔ isɛ gu ma Xivise gu ma Kanaanse simagɛ̃ ɔɖuɖu ame. Katsɔrakɔ̃ ne, makɛlɛ Beerseba i Negev i Yuda karɔ̃ ame.<verse eid="2SA 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 24:8" />Gɔ maɔki i karɔ̃ ɔɖuɖu iso ne, makpese maba Yerusalem i awa kaiwɛ̃ gu ayi sinyɔ kama.<verse eid="2SA 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 24:9" />Yoab ɔtã igara itsue i makpakpɛ̃dze kusime iso: I Israel ne maturi kukpi alafa fafarana ma lotiri makote fiɛ maawo ipɛmi ɔpɛ, fiɛ i Yuda ne maturi kukpi alafa aru.<verse eid="2SA 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 24:10" />Gɔ David ɔɔtã maka maturi kama ne ɔ̃ kaɣere ɔɖaa wũ, ne ɔɣere <char style="nd">Bosate</char> sɔ, "Lobara ikpi siare i nnɛ lobara ame. O <char style="nd">Bosate</char> su fɔ ɔɖabo ikpi tsɛ wũ. Lobara idzimira gbaã."<verse eid="2SA 24:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 24:11" />Fiɛ David aata ku kaɖesɛã kaya ne, <char style="nd">Bosate</char> itɔ̃me ɔɔba Gad wɔ loɖe Ɣaa kanyaɖidze, David kanyaara sɔ, <verse eid="2SA 24:11" /><verse number="12" style="v" sid="2SA 24:12" />"Kɛlɛ aaɣere David sɔ, ' <char style="nd">Bosate</char> sɔ, Nto losu ara atɛ losɛ-ɔ i anɔmi ame. Ɖi iwɛ̃ nɛ loatã iba-ɔ iso.' "<verse eid="2SA 24:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 24:13" />Ne ɔso Gad ɔkɛlɛ David kɔrɛ ne ɔɣere wũ sɔ, "Kukã si kubo i fɔ karɔ̃ iso akɔ atɛ? Ɣee awa atɛ gɔ aatere fɔ matsirise ma loatere masiai-ɔ? Ɣee inyɛpɛ̃ si iba i fɔ karɔ̃ iso ayi atɛ? Kiniɔ ne bu iti ame i ne iso si lotsue kumɛgɔ loatã nwɔ lopia me katɔ̃me mmuai."<verse eid="2SA 24:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 24:14" />David ɔɣere Gad sɔ, "Lopia i isoma ame gbaã. Boabo i <char style="nd">Bosate </char> nrɔɔ̃ ame alasɔ ɔba kayiribielea gbodzoo; ɣɛɛ daatã lobo i wũ matsirise nrɔɔ̃ ame."<verse eid="2SA 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 24:15" />Ne ɔso <char style="nd">Bosate</char> ɔsese inyɛpɛ̃ Israel ita i kaya gamɔ gbɔgbɔɔgbɔ ɔwi wɔ masɛ ɔɣo, ne maturi kukpi sikɔdzɛ ɔkpi ita i Dan ikɛlɛ Beerseba simagɛ̃ ame. <verse eid="2SA 24:15" /><verse number="16" style="v" sid="2SA 24:16" />Ɔwi wɔ i Ɣaa kpabo ɔɖi kɔrɔ̃ si ɔwɔra Yerusalem ne, <char style="nd">Bosate</char> ɔfirikira adzuni ala ara wa loɔnina ɔso ne ɔɣere kpabo wɔ nto ɔwɔra maturi sɔ, "Ka ilɛ! Nyua nnɛ ato abara." Ɔwi wɔmɔ ne <char style="nd">Bosate</char> kpabo ɔɔbo Arauna Yebuse imɔtu.<verse eid="2SA 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 24:17" />Ɔwi wɔ i David ɔnya kpabo wɔ nto ɔɖoe maturi ne, ɔɣere <char style="nd">Bosate</char> sɔ, "Mme loɣɛrɛ fiɛ lobara ikpi. Mmagbe ne masɛrɛrerɔ̃ maɖe. Maibara kuira, tã fɔ kɔrɔ̃ si kusia bo gu wũ iyomaturi iso."<verse eid="2SA 24:17" /></para>
  <para style="s1">David Ɔpɛ Isɔrɛkasege</para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 24:18" />Ikpɛnɛ nɛmɔ ame ne Gad ɔkɛlɛ David kɔrɛ ɔsɛ ɔ̃aɣere wũ sɔ, "Ya kɛlɛ Arauna Yebuse imɔtu si asɛ aapɛ isɔrɛkasege atã <char style="nd">Bosate</char> i mmɔ." <verse eid="2SA 24:18" /><verse number="19" style="v" sid="2SA 24:19" />Ne ɔso David ɔya ɔkɛlɛ lɛ kumɛgɔ i <char style="nd">Bosate</char> ɔɣɛ ɔkigu i Gad iso. <verse eid="2SA 24:19" /><verse number="20" style="v" sid="2SA 24:20" />Gɔ Arauna ɔnyɔ fiɛ ɔnya igara gu ɔ̃ maturi to maba ɔ̃ isɛ ne, ɔbɔrɛ ɔkɛlɛ ɔsɛ ɔ̃akɔlɛ ɔfu anɔ i karɔ̃ i igara katɔ̃.<verse eid="2SA 24:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 24:21" />Arauna ɔkarɛ sɔ, "Be ɔso i wũ ɔkɔse igara ɔba i ɔ̃ ɔɖabo kɔrɛ?"</para>
  <para style="p" vid="2SA 24:21">David ɔtã mmuai sɔ, "Si loɣa fɔ imɔtu si loapɛ isɔrɛkasege lotã <char style="nd">Bosate</char>, si inyɛpɛ̃ nɛ loba i maturi iso aatuĩ."<verse eid="2SA 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 24:22" />Arauna ɔɣere David sɔ, "Wũ ɔkɔse igara si ɔsu nnɛ ɔbie si ɔsɔrɛ. Nya manantsuĩ itã araifɛ̃ isɔrɛ, fiɛ nya kamɔ ipɛ kukolo gu manantsuĩ ɔmeisosidziri dzɛ aasu lɛ ndɔrɛ̃. <verse eid="2SA 24:22" /><verse number="23" style="v" sid="2SA 24:23" />Arauna sɔ, "O igara Aruana to ɔsu ara ɔɖuɖu wagbe ɔtã igara. Ana ne <char style="nd">Bosate</char> fɔ Ɣaa si ɔfɔ fɔ isɔrɛ."<verse eid="2SA 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 24:24" />Ɣɛɛ igara ɔtã Arauna mmuai sɔ, "Oɣoo, nɣɛ iso sɔ loatã-ɔ kuso i ne iti. Loibasɔrɛ araifɛ̃ isɔrɛ lotã <char style="nd">Bosate</char> wũ Ɣaa i nnɛ loitã kuso iti."</para>
  <para style="p" vid="2SA 24:24">Ne ɔso David ɔɣa imɔtu gu manantsuĩ ne ɔtã sikãfudza abi siru. <verse eid="2SA 24:24" /><verse number="25" style="v" sid="2SA 24:25" />David ɔpɛ isɔrɛkasege i mmɔ ne ɔsɔrɛ araifɛ̃ asɔrɛ gu isobuɛ asɔrɛ ɔtã <char style="nd">Bosate</char>. Ne <char style="nd">Bosate</char> ɔnɔ kayiikparama i karɔ̃ iti, ne inyɛpɛ̃ ɔtuĩ i Israel iso ne.<verse eid="2SA 24:25" /></para>
  <chapter eid="2SA 24" />
</usx>