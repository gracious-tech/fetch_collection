<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="3JN" style="id">-Yemsa New Testament</book>
  <para style="h">3 Yohannis</para>
  <para style="toc1">3 Yohannisni wosiya</para>
  <para style="toc2">3 Yohannis</para>
  <para style="toc3">3 Yoha.</para>
  <para style="mt1">Wosi Yohannisni Keezsa Wosiya</para>
  <para style="imt1">Gachgiru</para>
  <para style="ip">Wosi Yohannisni keezsa wosiyaas tichchenaas «Kur'u sina wosi Yohannisnik» sinfaat tichchenaas dey Gayiyos yiste betekiristanini zoonsiisik. Tichi bar isa hamnarik oom kiristanani meyanon argasina boor'a Gayiyosnin galatte. Ooma ugnak dey Diyotrofis yiste jallin asuskin teetbaason oodanak make.</para>
  <para style="iot">Matsafaas Siruk Ephna Ephobaas</para>
  <para style="io1">Gachgiru <char style="ior"><ref loc="3JN 1:1-4">1-4</ref></char></para>
  <para style="io1">Gayiyosnik imte galata <char style="ior"><ref loc="3JN 1:5-8">5-8</ref> </char></para>
  <para style="io1">Diyotrofisni waqasto <char style="ior"><ref loc="3JN 1:9-10">9-10</ref> </char></para>
  <para style="io1">Dimexirosnik imte galata <char style="ior"><ref loc="3JN 1:11-12">11-12</ref> </char></para>
  <para style="io1">Koor'uba <char style="ior"><ref loc="3JN 1:13-15">13-15</ref> </char></para>
  <chapter number="1" style="c" sid="3JN 1"/>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1"/>Betekiristanini kur'u sina keeshtefena shunto Gayiyosnik;</para>
  <para style="p" vid="3JN 1:1">Kur'u asu sina taakin woste wosiya; <verse eid="3JN 1:1"/><verse number="2" style="v" sid="3JN 1:2"/>Zomotaaso! Foonees zuuttera ho'itanak fayyane foonaknawa esiisimato dey kaanees ma'arik foonak shiiphefawungwa. <verse eid="3JN 1:2"/><verse number="3" style="v" sid="3JN 1:3"/>Futoni amantonesewa futoosik fooneese asin isa isa kiristana ayni meya yeesere makseten odefana kabaasik akamanontu girengwa. <verse eid="3JN 1:3"/><verse number="4" style="v" sid="3JN 1:4"/>Naanggotnaasikito futoosik kessa girset foobaason odoostan denalo taan girsifa wuza aafa.<verse eid="3JN 1:4"/></para>
  <para style="s1">Gayiyos Suuste</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5"/>Zomotaaso! Neek irba sinefeknu ayni meyak amanamto wosto wostetarwa. <verse eid="3JN 1:5"/><verse number="6" style="v" sid="3JN 1:6"/>Baasso dey ne zagita keeshtanni wostoosik amanynyini zuuttoosi sina neek zaala maksetewa. Hashnu dey hamone ugnaasik Ha'ooson girsuni wuzason baassok argasifaatane ma'arwa. <verse eid="3JN 1:6"/><verse number="7" style="v" sid="3JN 1:7"/>Baasso Kiristoosnik wostosonek kesefe kabaasik Aazabni meyakin isa argasunu aane ephotowa. <verse eid="3JN 1:7"/><verse number="8" style="v" sid="3JN 1:8"/>Futoni wostooson haa'er sinanik es effetena asuni meyanon argasunik sholsuwa.<verse eid="3JN 1:8"/></para>
  <para style="s1">Diyotrofisni Waqastonewa Dimexirosni Suustone</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9"/>Zeemo sinak betekiristaniisik dabdabbe tichingwa; sinuntano Betekiristanini zoonsi sinanak sholefe Diyotrofis innotin aane ephphetowe. <verse eid="3JN 1:9"/><verse number="10" style="v" sid="3JN 1:10"/>Es bari boor'a nittoki yaafana kabaasik bar innotin me'fetnawa salphsifetna zagina mangu wostooson zuutira asu zuuttambesiise asik makona; es bar hooro shakaan bar teetbaasik ayni meyanon aane ephpheteefe. Oomni meya dey ephphetoosonoytemato kalfe dey betekiristaniissin kalle kisife.<verse eid="3JN 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11"/>Zomotaaso! Ma'a wuzaasne feer sintano mangu wuzaasne feer sinatatawa. Ma'a wostooson wostefe bar zuuttambaase Ha'ooskingwa. Sinuntano mangu wostooson wostefe bar zuuttambaase Ha'ooson aane arifewa. <verse eid="3JN 1:11"/><verse number="12" style="v" sid="3JN 1:12"/>Dimexirosnik asu zuuttambaase ma'ariktu zaala makedifewa. Futoos dey teetbaasik zaala makedifa. Inno dey barik zaala makefeniwa; zaalniis futo sinnamato arifatwa.<verse eid="3JN 1:12"/></para>
  <para style="s1">Koi'ni Nagani Ooshsho</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13"/>Neek tichunak sholefana showo wuza faarwa; sinuntano dabdabbek tichunak aane sholotwa. <verse eid="3JN 1:13"/><verse number="14" style="v" sid="3JN 1:14"/>Han ta'anon neen uphonamato abdi zagifawungwa; es kabaasik aafe aafe biira wolloniwa. <verse eid="3JN 1:14"/><verse number="15" style="v" sid="3JN 1:15"/>Naga neek sinfawungwa; zomoneesakito neek naga ooshshesedife; ne dey zomoniisakito isarbesi isarbesiisik naganiison baassok makowa.<verse eid="3JN 1:15"/></para>
  <chapter eid="3JN 1"/>
</usx>
