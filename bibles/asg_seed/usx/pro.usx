<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PRO" style="id">PRO - Cishingini Agwara Kambari [asg] KATAGARDA KA ANSA Katagarda ka ANSA ANS</book>
  <para style="toc3">An</para>
  <para style="toc2">Ansa</para>
  <para style="toc1">Katagarda ka Ansa</para>
  <para style="mt1">Katagarda ka Ansa</para>
  <para style="imt">Kuɓa̱yuwa̱</para>
  <para style="im">Katagarda ka Ansa, katagarda kaꞋa ka na o ɓolongi kuyotsongusu ku kuyongo ku ma̱riki n ku kutoni. Kuyotsongusu ka ki ta̱ uɗiki n ansa n cicoꞋo tsu mogono Sulemanu. Kuyotsongusu ka ku pece ta̱ cicoꞋo n tsulau, a̱ ida̱shi i ma̱riki n i gbani-gbani, a na a yaꞋin kadanshi ke le n uye kakau. Kadanshi ka̱ a̱bunda̱i ki ta̱ a kadanshi ki ili i na yi a̱ kugita̱sa̱ anana m makpaꞋa. Katagarda ka ka̱ gita̱ ta̱ n kuciɓaka uma, Wovon u Ka̱shile ɗaɗa ugiti u kuyeve. 1:7 Ili i na i ɗikai lo katagarda ka, ka lyaꞋa ta̱ kelime n kuyaꞋan kadanshi ka na ki ida̱shi i kutoni i ɗa koci ba, ama ili i na a kiwanai kene n kuyongo ku ma̱riki. IcuꞋu i kadanshi ka wawaꞋa ka nampa ko yotsongu icuꞋu i kuyeve ku nlum mi Isaraila n cau, tsu na vuza vu cicoꞋo u kuyaꞋan a makyan ma na ili i yoku i ɗa̱nga̱i. Ukuna u nampa wa wi ta̱ a kadanshi ki ida̱shi i kpaꞋa, n i tsulaga. U yoku kpamu wi ta̱ a kadanshi ki ida̱shi a̱ ka̱tsuma̱ ka uma, ko kpamu ida̱shi yu usuɓi. Ukuna wa̱ a̱bunda̱i wi ta̱ a kadanshi, vu goyo ka̱ci ka̱ nu, uka̱ni u ka̱ɗu, n kuɗika aza a unambi n a̱shi a singai n ida̱shi i ma̱riki a̱ ka̱tsa̱ma̱ ka̱ a̱ja̱Ꞌa̱.</para>
  <para style="iot">Ili i na yi punu u udari a katagarda ka nampa</para>
  <para style="io1">Kucikpa ku ansa 1:1-9; 18</para>
  <para style="io1">Ansa Sulemanu 10:1-22; 16</para>
  <para style="io1">Kadanshi ka ansa kamangankupa, 22:16-24; 34</para>
  <para style="io1">Ansa kadanshi o yoku a Sulemanu 25:1-29; 27</para>
  <para style="io1">Kadanshi ka Agur 30:1-31</para>
  <para style="io1">Kadanshi ko yoku ka ku yotsongusu 31:1-31</para>
  <chapter number="1" style="c" sid="PRO 1" />
  <para style="s1">Ugiti u kuyeve</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1" />Ansa a Sulemanu kolobo ka Dawuda mogono mi Isaraila.<verse eid="PRO 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 1:2" />Na ɗa ansa a na a̱ kuɓa̱nka̱ wu,</para>
  <para style="q2" vid="PRO 1:2">vu yeve cicoꞋo n odoki a singai,</para>
  <para style="q2" vid="PRO 1:2">ka̱ta̱ e yeve kudansa i na yi usokongi<verse eid="PRO 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 1:3" />adama a na a̱ ciya̱,</para>
  <para style="q2" vid="PRO 1:3">kuyotsongusu ku cicoꞋo,</para>
  <para style="q2" vid="PRO 1:3">n usuɓi, n afada a mayun,</para>
  <para style="q2" vid="PRO 1:3">n ili i na yi mayin,<verse eid="PRO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 1:4" />a zuwa vuza vu unambi u kuyeve,</para>
  <para style="q2" vid="PRO 1:4">wo okpo n kuyeve,</para>
  <para style="q2" vid="PRO 1:4">o yotsongusu a̱ɗa̱nga̱ni tsu na</para>
  <para style="q2" vid="PRO 1:4">a kuyaꞋan kusheshe ku singai.<verse eid="PRO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 1:5" />YaꞋan vuza vu cicoꞋo u pana ka̱ta̱ u doku ciya̱ kuyeve,</para>
  <para style="q2" vid="PRO 1:5">vuza vu uyevi kpamu</para>
  <para style="q2" vid="PRO 1:5">u ciya̱ uɓa̱nki<verse eid="PRO 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 1:6" />adama a na e yeve i na ansa i a kadanshi,</para>
  <para style="q2" vid="PRO 1:6">kadanshi ka aza o cicoꞋo n iteꞋe i le.<verse eid="PRO 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 1:7" />Wovon u Vuzavaguɗu u ɗaɗa ugiti u kuyeve,</para>
  <para style="q2" vid="PRO 1:7">ama kalau ka goyo ta̱ cicoꞋo n odoki.<verse eid="PRO 1:7" /></para>
  <para style="s1">Odoki u ka̱ɗa̱nga̱ni</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8" />Pana, Maku ma̱va̱, pana kadanshi ke esheku a̱ nu,</para>
  <para style="q2" vid="PRO 1:8">kpamu ka̱ta̱ vu ka̱sukpa̱ odoki a̱na̱ku a̱ nu ba,<verse eid="PRO 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9" />adama a na kuyotsongu ku le</para>
  <para style="q2" vid="PRO 1:9">ki ta̱ o ku doku wu tsugbayin,</para>
  <para style="q2" vid="PRO 1:9">ka̱ta̱ okpo ili kuɗeku i singai a kuɗeku ku nu.<verse eid="PRO 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 1:10" />Maku ma̱va̱, ɗa baci aza a unushi a kparasai nu,</para>
  <para style="q2" vid="PRO 1:10">ka̱ta̱ vu ushuku ba.<verse eid="PRO 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11" />Ɗa baci a danai, &lt;&lt;Ta̱wa̱ tsu gbaɓa kaci,</para>
  <para style="q2" vid="PRO 1:11">tsu una vuma yoku,</para>
  <para style="q2" vid="PRO 1:11">tsu bana tsu bopo tsu una aza a babu unushi,<verse eid="PRO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12" />YaꞋan tsu soɗongu le ra̱ka̱-ra̱ka̱ tsu kasaun,</para>
  <para style="q2" vid="PRO 1:12">tsa aza a na a̱ gida̱la̱i a kubana e kpenle.<verse eid="PRO 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13" />ka̱ta̱ ci ciya̱ uciyi n a̱bunda̱i,</para>
  <para style="q2" vid="PRO 1:13">ci shatangu iꞋuwa i tsu n ucanuku u gbani,<verse eid="PRO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14" />ta̱wa̱ vu gbaɓa ka̱ci n a̱tsu,</para>
  <para style="q2" vid="PRO 1:14">ka̱ta̱ tsu pece ili i na tsu bokoi.&gt;&gt;<verse eid="PRO 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15" />Maku ma̱va̱, ka̱ta̱ vu gbaɓa ka̱ci ka̱ nu n icuꞋu i uma a nanlo ba,</para>
  <para style="q2" vid="PRO 1:15">yaꞋan daꞋangi n ele,<verse eid="PRO 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16" />adama a na i ta̱ m moloko a̱ ubuta̱ u kuyaꞋan ka gbani-gbani,</para>
  <para style="q2" vid="PRO 1:16">i ta̱ ufoɓi ayin tutu adama a munuka. <verse eid="PRO 1:16" /><verse number="17" style="v" sid="PRO 1:17" />Gbani ɗa azuku maza</para>
  <para style="q2" vid="PRO 1:17">a̱ a̱shi a manunu ma na a cigai kuka̱na̱.<verse eid="PRO 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18" />ama icuꞋu i uma a nanlo,</para>
  <para style="q2" vid="PRO 1:18">ka̱ci ke le kaꞋa a tsu zuwaka maza.</para>
  <para style="q2" vid="PRO 1:18">e ci reme ili ba, wuma u le ɗa koci.<verse eid="PRO 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19" />Ta ukocishi wu uye</para>
  <para style="q2" vid="PRO 1:19">wa aza a̱ kutsa̱n ki ikebe i nannai,</para>
  <para style="q1" vid="PRO 1:19">kutsa̱n ka ki ta̱ o ku okpo ma̱giti mu ukpa̱ me le.</para>
  <para style="q2" vid="PRO 1:19">Ci coꞋo ci ta̱ e meɗevile.<verse eid="PRO 1:19" /></para>
  <para style="s1">Kadanshi a ukuna u ku iwan cicoꞋo</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20" />Panai, cicoꞋo ci ta̱ e meɗevile a uye n kuden, <verse eid="PRO 1:20" /><verse number="21" style="v" sid="PRO 1:21" />ci ta̱ e meɗevile n utsura a̱ utsutsu i likuci, n ubuta̱ u na uma dem a tsu yaꞋan oɓolo. <verse eid="PRO 1:21" /><verse number="22" style="v" sid="PRO 1:22" />&lt;&lt;Ali wannai ɗa, a̱ɗa̱ aza a na yi n ugboji ba,</para>
  <para style="q2" vid="PRO 1:22">yi ta̱ o kuyongo nannai ko ugboji?</para>
  <para style="q1" vid="PRO 1:22">Ali wanai ɗai, a̱ɗa̱ aza o kugoyi,</para>
  <para style="q2" vid="PRO 1:22">yi ta̱ a kupana uyoꞋo wu ulami u na yi a kuyaꞋan,</para>
  <para style="q2" vid="PRO 1:22">a̱ɗa̱ a lau i iwain kuyeve?<verse eid="PRO 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23" />Ishi baci i zuwa atsuvu i pana uɓarangi u va̱.</para>
  <para style="q2" vid="PRO 1:23">Mi ishi a̱ ku tsuwa̱nka̱ ɗa̱ n ayinviki a̱ va̱,</para>
  <para style="q2" vid="PRO 1:23">ka̱ta̱ n zuwa ɗa̱ i yeve kadanshi ka̱ va̱.<verse eid="PRO 1:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24" />Adama a na n ɗeke ta̱, ɗa̱ i iwain kupana,</para>
  <para style="q2" vid="PRO 1:24">n ɗengusa̱i ekiye a̱ va̱ wa̱ a̱ ɗa̱ ama ko vuza u zuwaka ba,<verse eid="PRO 1:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 1:25" />I iwain kutono odoki a̱ va̱ ra̱ka̱,</para>
  <para style="q2" vid="PRO 1:25">kpamu i ciga uɓarangi ɗa̱ u va̱ ba. <verse eid="PRO 1:25" /><verse number="26" style="v" sid="PRO 1:26" />Mi ta̱ o ku zoꞋoso ɗa̱,</para>
  <para style="q2" vid="PRO 1:26">a makyan ma atakaci,</para>
  <para style="q1" vid="PRO 1:26">mi ta̱ a kuyaꞋanka ɗa̱ ulami,</para>
  <para style="q2" vid="PRO 1:26">a makyan ma na ma̱dukpa̱ ma̱ ta̱wa̱i ɗa̱,<verse eid="PRO 1:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 1:27" />Ayin a na baci atakaci a̱ ta̱wa̱i ɗa̱</para>
  <para style="q2" vid="PRO 1:27">tsu kabatalikpau,</para>
  <para style="q2" vid="PRO 1:27">a ayin a na yi o kusoꞋo atakaci n awuya.<verse eid="PRO 1:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 1:28" />Ka̱ta̱ i ɗeke mu,</para>
  <para style="q2" vid="PRO 1:28">ama mi a̱ ku ushuku ɗa̱ ba.</para>
  <para style="q1" vid="PRO 1:28">yi ta̱ a̱ ku la̱nsa̱ mu a̱ ubuta̱ dem,</para>
  <para style="q2" vid="PRO 1:28">ama yi a̱ kuciya̱ mu ba.<verse eid="PRO 1:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 1:29" />Adama a na i iwan ta̱ kuyeve ugaꞋin u kuyeve ba,</para>
  <para style="q2" vid="PRO 1:29">kpamu i zagba i pana wovon u Vuzavaguɗu ba.<verse eid="PRO 1:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 1:30" />Yi ushuku n odoki a̱ va̱ ba,</para>
  <para style="q2" vid="PRO 1:30">i iwain uɓarangi u va̱.<verse eid="PRO 1:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 1:31" />Adama a nannai yi ta̱ a̱ kuciya̱ katsupu ku ulinga u ɗa̱,</para>
  <para style="q2" vid="PRO 1:31">yi ta̱ a̱ kucuwa̱ n una̱mgbuka̱tsuma̱ u ɗa̱. <verse eid="PRO 1:31" /><verse number="32" style="v" sid="PRO 1:32" />Aza a unambi u kuyeve a tsu kuwa̱ ta̱, adama a na a̱ ushuku n cicoꞋo ba,</para>
  <para style="q2" vid="PRO 1:32">Alau tamkpamu a̱ tsu kuwa̱ ta̱ adama a na a zuwaka ba.<verse eid="PRO 1:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 1:33" />Ama yaba dem vu na baci u panakai mu,</para>
  <para style="q2" vid="PRO 1:33">wi ta̱ a̱ kuda̱sa̱ngu m ma̱ta̱na̱.</para>
  <para style="q1" vid="PRO 1:33">Ko ili tana yi a̱ kuciya̱ yi ba,</para>
  <para style="q2" vid="PRO 1:33">babu kpamu ili i na i kuneke yi wovon.&gt;&gt;<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" sid="PRO 2" />
  <para style="s1">Ugain u cicoꞋo</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 2:1" />Maku ma̱ va̱,</para>
  <para style="q1" vid="PRO 2:1">ushuku n kadanshi ka̱ va̱.</para>
  <para style="q2" vid="PRO 2:1">ka̱ ta̱ vu sokongu kadanshi ka̱ va̱,<verse eid="PRO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 2:2" />Zuwa atsuvu a ukuna u cicoꞋo,</para>
  <para style="q2" vid="PRO 2:2">vu yaꞋan moloko ma na vu yeve i ɗa.<verse eid="PRO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 2:3" />Mayun,</para>
  <para style="q2" vid="PRO 2:3">folono uyevi ka̱ta̱ vu la̱nsa̱ kuyeve,<verse eid="PRO 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 2:4" />la̱nsa̱ ku ɗa tsa azurufa,</para>
  <para style="q2" vid="PRO 2:4">vu la̱nsa̱ tsu na a̱ tsu la̱nsa̱ uciyi u na wi usokongi.<verse eid="PRO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 2:5" />Ka̱ta̱ vu yeve wovon u Vuzavaguɗu,</para>
  <para style="q2" vid="PRO 2:5">ka̱ta̱ vu ciya̱ kuyeve ku Ka̱shile.<verse eid="PRO 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 2:6" />Adama a na Vuzavaguɗu ɗa u tsu neke cicoꞋo,</para>
  <para style="q2" vid="PRO 2:6">kuyeve n cicoꞋo kpamu,</para>
  <para style="q2" vid="PRO 2:6">a una̱ u ni u ɗa ku tsu uta̱.<verse eid="PRO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 2:7" />U tsu neke ta̱ aza a na</para>
  <para style="q2" vid="PRO 2:7">i o kutono mejege cicoꞋo,</para>
  <para style="q2" vid="PRO 2:7">a̱yi ɗa ma̱ra̱ga̱ wa aza</para>
  <para style="q2" vid="PRO 2:7">a na i o kutono derere.<verse eid="PRO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 2:8" />Adama a na utsu la̱na̱ ta̱</para>
  <para style="q2" vid="PRO 2:8">ukuna wa afada a mayun,</para>
  <para style="q2" vid="PRO 2:8">u tsu ere ta̱ uye wa aza a na i a kuciga yi.<verse eid="PRO 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9" />Yi ta̱ e kuyeve ukuna wu usuɓi n afada n ukuna u mejege,</para>
  <para style="q2" vid="PRO 2:9">n uye u na u gaꞋin dem.<verse eid="PRO 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 2:10" />Adama a na vi ta̱ a̱ kuciya̱ cicoꞋo a̱ ka̱ɗu ka̱ nu,</para>
  <para style="q2" vid="PRO 2:10">kuyeve kpamu ki ta̱ e kuneke wu ma̱za̱nga̱.<verse eid="PRO 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 2:11" />Kula̱na̱ ku nu ki ta̱ e ku ere wu</para>
  <para style="q2" vid="PRO 2:11">kuyeve ku nu ki ta̱ o kutono n avu.<verse eid="PRO 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12" />CicoꞋo ci ta̱ a̱ ku uta̱ka̱ wu a ka gbani-gbani.</para>
  <para style="q2" vid="PRO 2:12">a uma a kadanshi ka kavama.<verse eid="PRO 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 2:13" />Aza a na a̱ ka̱sukpa̱i uye u mayun,</para>
  <para style="q2" vid="PRO 2:13">adama a na o yongo a uye u ka̱yimbi,<verse eid="PRO 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 2:14" />aza a na a tsu pana uyoꞋo u kuyaꞋan ka gbani-gbani,</para>
  <para style="q2" vid="PRO 2:14">a̱ ma̱za̱nga̱ n ka gbani-gbani.<verse eid="PRO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 2:15" />aza a na uye u le wi magaba ba,</para>
  <para style="q2" vid="PRO 2:15">aza a na uye u le u modoruko u ɗa.<verse eid="PRO 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16" />CicoꞋo ci ta̱ e kere wu we ekiye a kashakanlai, vuza wi ukuna u na u kparasa wu n una̱ wu uyoꞋo u ni.<verse eid="PRO 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 2:17" />vuza na u ka̱sukpa̱i vali vu ni a ayin a utsura a̱ ni,</para>
  <para style="q2" vid="PRO 2:17">vuza na u tsu koɗo uzuwakpani u na u yaꞋin e kelime ka̱ Ka̱shile.<verse eid="PRO 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 2:18" />Adama a na kpaꞋa ku ni uye wu ukpa̱ u ɗa,</para>
  <para style="q2" vid="PRO 2:18">uye u ni a kubana a ubuta̱ wa̱ ukpisa̱ u ɗa.<verse eid="PRO 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 2:19" />Vuza na baci de dem u banai ubuta̱ u ni, u tsu bono ba.</para>
  <para style="q2" vid="PRO 2:19">Wi o ku doku kubono a uye u wuma ba.<verse eid="PRO 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20" />Adama a nannai, mayun ɗa vu tono uye,</para>
  <para style="q2" vid="PRO 2:20">u na uma a singai o tonoi,</para>
  <para style="q2" vid="PRO 2:20">vu tono uye wa aza a usuɓi.<verse eid="PRO 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21" />Uma a na i a kuyaꞋan ukuna u mejege,</para>
  <para style="q2" vid="PRO 2:21">e le ɗa aza a na a̱ kuda̱sa̱ngu a iɗika ya. <verse eid="PRO 2:21" /><verse number="22" style="v" sid="PRO 2:22" />Ama i ta̱ a ku una aza a gbani-gbani punu a i ɗika ya,</para>
  <para style="q2" vid="PRO 2:22">aza a na i m ma̱riki ba, i ta̱ a ku takpa le punu.<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" sid="PRO 3" />
  <para style="s1">Odoki adama A̱ɗa̱nga̱ni</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 3:1" />Maku ma̱va̱, ka̱ta̱ vu cinukpa n kuyotsongusu kuva ba̱.</para>
  <para style="q2" vid="PRO 3:1">ama ka̱sukpa̱ ka̱ɗu ka̱ nu ke reme wila̱ u va̱.<verse eid="PRO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2" />Ku yotsongusu ku va̱ ki ta̱ a ku neke wu ma̱ta̱na̱ n wuma wu ugaɗi.<verse eid="PRO 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3" />Ka̱ta̱ vu ushuku vu ka̱sukpa̱ kamayun n kasingai ba, shiya le a̱ kuɗeku ku nu,</para>
  <para style="q2" vid="PRO 3:3">ɗana le kpamu a̱ ka̱ɗu ka̱ nu.<verse eid="PRO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4" />Ɗa baci vu yaꞋin nanai,</para>
  <para style="q2" vid="PRO 3:4">Ka̱shile ki ta a kuyaꞋan ma̱za̱nga̱ n avu.</para>
  <para style="q2" vid="PRO 3:4">Vi ta̱ a̱ kuciya̱ ulyaꞋi a̱ ka̱tsuma̱ kuyongo kuna vi a kuyaꞋan n uma.<verse eid="PRO 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5" />Ushuku n Vuzavaguɗu n ka̱ɗu ka̱ nu dem.</para>
  <para style="q2" vid="PRO 3:5">Ka̱ta̱ vu piꞋisa a kuyeve ku nu ba.<verse eid="PRO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6" />Ciɓa n Vuzavaguɗu a ili i na vi a kuyaꞋan dem,</para>
  <para style="q2" vid="PRO 3:6">a̱yi tana wi ta̱ a ku yotsongu wu uye u singai. <verse eid="PRO 3:6" /><verse number="7" style="v" sid="PRO 3:7" />Ka̱ta̱ vu ɗika ka̱cika̱nu vuza vu cicoꞋo ɗa ba,</para>
  <para style="q2" vid="PRO 3:7">pana wovon u Vuzavaguɗu</para>
  <para style="q2" vid="PRO 3:7">vu ka̱sukpa̱ ka gbani-gbani.<verse eid="PRO 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8" />Ɗa baci vu yaꞋan nanai, wi ta̱ o kokpo an a̱guma̱ a singai,</para>
  <para style="q2" vid="PRO 3:8">a na o ku potsotongu untsu a̱ nu ka̱ta̱ a̱ ɓa̱nka̱ mɓa̱la̱ n nu.<verse eid="PRO 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9" />Neke Ka̱shile tsugbayin ni na vi n i ɗa,</para>
  <para style="q2" vid="PRO 3:9">n umaci wi ili yu ugiti i kashina i nu ra̱ka̱.<verse eid="PRO 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10" />Ɗa baci vu yaꞋan nanai, mpon nu mi ta̱ a kushana n ili i kulyaꞋa.</para>
  <para style="q2" vid="PRO 3:10">Vi ta̱ mini mi inabi ma̱ a̱bunda̱i, ali vu kpa̱ɗa̱ kuciya̱ ubuta̱ una va̱ kutsuwa̱n maꞋan ra̱ka̱.<verse eid="PRO 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 3:11" />Maku ma̱va̱, ka̱ta̱ vu goyo udansuki u Vuzavaguɗu ba,</para>
  <para style="q2" vid="PRO 3:11">ka̱ta̱ kpamu vu iwan u ɓarangi u ba.<verse eid="PRO 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12" />Adama a na Vuzavaguɗu u tsu ɓarangu ta̱ aza ana u cigai,</para>
  <para style="q2" vid="PRO 3:12">u teku tsuna kesheku ka tsu ɓarangu maku ma na u cigai.<verse eid="PRO 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13" />Vuza ma̱za̱nga̱ ɗa vuza na u ciya̱i cicoꞋo,</para>
  <para style="q2" vid="PRO 3:13">n vuza na kpamu u ciya̱i kuyeve.<verse eid="PRO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14" />Adama ana kodokpotsu ko cicoꞋo ka̱ ni ka laꞋa ta̱ ka azurufa,</para>
  <para style="q2" vid="PRO 3:14">ugaꞋin u ni u laꞋa ta̱ kazanariya.<verse eid="PRO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15" />U laꞋa ta̱ katali ku ugaꞋin ikebe, babu ili i na a ku gisangu n a̱yi.<verse eid="PRO 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16" />Ugboji u tsu doku ta̱ wuma wu ugaɗi,</para>
  <para style="q2" vid="PRO 3:16">tsu udukuyan n tsugbayin.<verse eid="PRO 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17" />Uye uni uye wu uyoꞋo uɗa, ra̱ka̱ vu le tana u ma̱ta̱na̱ uɗa.<verse eid="PRO 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18" />Aza ana i n ugboji,</para>
  <para style="q2" vid="PRO 3:18">ita̱ m ma̱za̱nga̱,</para>
  <para style="q1" vid="PRO 3:18">cicoꞋo ci ta̱ a kuneke le wuma.<verse eid="PRO 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19" />Vuzavaguɗu u yaꞋin aduniya n cicoꞋo ci ni,</para>
  <para style="q2" vid="PRO 3:19">n kuyeve ku ni kpamu u yaꞋin gaɗi.<verse eid="PRO 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20" />N kuyeve kuni ɗa nyeneke mu uga̱vi n ɓa̱yuwa̱i,</para>
  <para style="q2" vid="PRO 3:20">eleshu kpamu o yoꞋo mini i ɗika.<verse eid="PRO 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 3:21" />Maku ma̱va̱, reme ugboji u nu n kuyeve ku nu.</para>
  <para style="q1" vid="PRO 3:21">ka̱ta̱ vu ka̱sukpa̱ le a̱ ka̱sukpa̱ wu ba.<verse eid="PRO 3:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22" />I ta̱ a ku okpo wu wuma,</para>
  <para style="q2" vid="PRO 3:22">n ugaꞋin tsu ucanuku wu ili i singai wa̱ nu.<verse eid="PRO 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23" />Ta va kuyaꞋan nwalu a uye u nu nannai m ma̱ta̱na̱</para>
  <para style="q2" vid="PRO 3:23">vi tana a̱ kuta̱ɗa̱tsa̱ ba.<verse eid="PRO 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24" />Ɗa baci vu vaki, vi a kupana wovon ba,</para>
  <para style="q2" vid="PRO 3:24">ɗa baci vu vaki alavu a̱ nu i ta̱ o ku yokpo.<verse eid="PRO 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25" />Ka̱ta̱ vu pana wovon wa atakaci a na a̱ kuta̱wa̱ wu makyan me te ba.</para>
  <para style="q2" vid="PRO 3:25">ko kpamu atakaci a na a kuciya̱ aza gbani-gbani tsu wunla̱ ba.<verse eid="PRO 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26" />Vuzavaguɗu wi ta̱ a ku ere wu,</para>
  <para style="q2" vid="PRO 3:26">wi a ku ka̱sukpa̱ wu vu a za a maza ba.<verse eid="PRO 3:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27" />YaꞋanka aza ana a cigai u ba̱nki kasingai,</para>
  <para style="q2" vid="PRO 3:27">a makyan mana baci vi a kufuɗa ra̱ku.<verse eid="PRO 3:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28" />Ka̱ta̱ vu dana vutoku nu,</para>
  <para style="q2" vid="PRO 3:28">&lt;&lt;Wala biꞋi sai makpaꞋa vu bono,</para>
  <para style="q2" vid="PRO 3:28">ka̱ta̱ n neke wu,&gt;&gt; wana ɗa tana vi ni i ɗa lo.<verse eid="PRO 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 3:29" />Ka̱ta̱ vu sheshe ke vutoku vu nu kagbanigbani ba,</para>
  <para style="q2" vid="PRO 3:29">vuza̱ nu na yi ida̱shi i singai n koɓolo.<verse eid="PRO 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30" />Ka̱ta̱ vu yaꞋan kanana n vuza babu u kuna ba,</para>
  <para style="q2" vid="PRO 3:30">babu tana u nusaka wu.<verse eid="PRO 3:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31" />Ka̱ta̱ vu yaꞋan cisheꞋe n aza kuyaꞋan ka gbani-gbani ba,</para>
  <para style="q2" vid="PRO 3:31">ko vu zagba uye u yoku u le ba.<verse eid="PRO 3:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32" />Adama ana Vuzavaguɗu u iwan ta̱ aza ana a kuyaꞋan ka gbani-gbani,</para>
  <para style="q2" vid="PRO 3:32">ama u ci ciga ta̱ aza a kamayun a̱ ka̱ɗu.<verse eid="PRO 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33" />Una̱wuya u Ka̱shile wita̱ a kpaꞋa ku vuza gbani-gbani,</para>
  <para style="q2" vid="PRO 3:33">ama u tsu zuwaka ta̱ kpaꞋa a ka za a usuɓi una̱singai.<verse eid="PRO 3:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34" />U tsu goyo ta̱ aza izoshi i kugoyi,</para>
  <para style="q2" vid="PRO 3:34">ama u ci neke ta̱ kasingai wa aza uremi u kaci.<verse eid="PRO 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35" />Vuza vu cicoꞋo u tsu ciya̱ ta̱ tsugbayin,</para>
  <para style="q2" vid="PRO 3:35">ama kalau ki ta̱ o kusoꞋo wono.<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" sid="PRO 4" />
  <para style="s1">Odoki o cicoꞋo wa̱ a̱ɗa̱nga̱ni</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1" />Muku n va̱, panai odoki ana Dada ɗa̱ u piꞋisakai ɗa̱.</para>
  <para style="q2" vid="PRO 4:1">zuwa ugboji, vi ta̱ kpamu a̱ kuciya̱ ku yeve.<verse eid="PRO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2" />Adama ana n mi ta̱ e kuneke ɗa̱ odoki a singai, ka̱ta̱ i ka̱sukpa̱ ku piꞋisa ku va̱ ba.<verse eid="PRO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3" />A ayin ana mi ishi maku a kpaꞋa ku Dada va̱,</para>
  <para style="q2" vid="PRO 4:3">mpa maku mo mogono maꞋan, maku mu ucigi maꞋa wa̱ a̱na̱ku a̱va̱,<verse eid="PRO 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 4:4" />u piꞋisakai mu ɗa udanai mu,</para>
  <para style="q2" vid="PRO 4:4">&lt;&lt;Reme kadanshi ka̱va̱ n ka̱ɗu ka̱ nu,</para>
  <para style="q2" vid="PRO 4:4">tono wila̱ u va̱ vi ta̱ a̱ kuciya̱ wuma.<verse eid="PRO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5" />La̱nsa̱ cicoꞋo, la̱nsa̱ kuyeve,</para>
  <para style="q2" vid="PRO 4:5">ka̱ta̱ vu cinukpa ko vu iwan kaꞋa,<verse eid="PRO 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6" />Ka̱ta̱ vu ka̱sukpa̱ cicoꞋo ba, ci ta̱ tana e ku ere wu,</para>
  <para style="q2" vid="PRO 4:6">ciga tsu ɗa, tsu ɗa ci ta̱ tana feu a kula̱na̱ wu.<verse eid="PRO 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7" />Ugiti u cicoꞋo u ɗanna, ciya̱ cicoꞋo, n ili i na vu ciya̱i dem,</para>
  <para style="q2" vid="PRO 4:7">ciya̱ ku yeve.<verse eid="PRO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8" />Ciga tsu ɗa, ci ta̱ a kuneke wu tsugbayin.</para>
  <para style="q2" vid="PRO 4:8">oɓongu tsu ɗa, ci ta̱ tana kpamu a kuneke wu tsugbayin.<verse eid="PRO 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9" />Wi ta̱ a ku okpo wu ma̱kuꞋun ma tsugbayin a kaci ka̱ nu,</para>
  <para style="q2" vid="PRO 4:9">ma̱kuꞋun ma singai ma ku cikpa kpamu.&gt;&gt;<verse eid="PRO 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10" />Pana, maku ma̱va̱, ushuku n ili i na n danai,</para>
  <para style="q2" vid="PRO 4:10">a̱ya̱ a wuma a̱ nu kpamu i ta̱ o ko okpo a̱ ka̱bunda̱i.<verse eid="PRO 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11" />N piꞋisa ka wu ta̱ ɗe, uye u cicoꞋo,</para>
  <para style="q2" vid="PRO 4:11">n tonoi n avu a uye u na wi mejege.<verse eid="PRO 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12" />Vu yaꞋan baci nwalu n cicoꞋo, babu ili i na ya ku kpada wu uye,</para>
  <para style="q2" vid="PRO 4:12">a makyan mana vi a ilaɗi, vi a kuta̱ɗa̱tsa̱ ba.<verse eid="PRO 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13" />Reme odoki a nanlo a n utsura, ka̱ta̱ vu ka̱sukpa̱ a ɗa ba,</para>
  <para style="q2" vid="PRO 4:13">reme a ɗa mayin, adama ana wuma uɗa wa̱ nu.<verse eid="PRO 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14" />Ka̱ta̱ vu uwa a uye wa aza gbani-gbani ba,</para>
  <para style="q2" vid="PRO 4:14">ka̱ta̱ kpamu vu yaꞋan nwalu a uye wa aza a na a kuyaꞋan gbani-gbani ba.<verse eid="PRO 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15" />Katsukpa, ka̱ta̱ vu wala a uɗa ba,</para>
  <para style="q2" vid="PRO 4:15">kpatala vu ka̱sukpa̱ u ɗa, ka̱ta̱ vu yaꞋan nwalu n nu kau.<verse eid="PRO 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16" />Adama ana aza a gbani-gbani a nanlo a tsu lata ba,</para>
  <para style="q2" vid="PRO 4:16">sai a yaꞋan kagbanigbani, alavu a tsu ka̱na̱ a̱shi e le ba,</para>
  <para style="q2" vid="PRO 4:16">sai a zuwa vuza yoku u ta̱ɗa̱tsa̱.<verse eid="PRO 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17" />Kagbanigbani ka ɗaɗa ilikulya i le,</para>
  <para style="q2" vid="PRO 4:17">vishili kpamu vu ɗaɗa ili i kusoꞋo i le.<verse eid="PRO 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18" />Uye wa aza a usuɓi wita̱ uteku tsu ku uta̱ ku kutashi ku kanna ku ɗa,</para>
  <para style="q2" vid="PRO 4:18">kutashi kuna ku tsu ka̱na̱ kudokusu ali wa akana kanna a kaci mayin.<verse eid="PRO 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19" />Uye wa aza gbani-gbani wita̱ u teku tsu ka̱yimbi ka kpaɓam,</para>
  <para style="q2" vid="PRO 4:19">a̱ tsu yeve i na i tsu zuwa le ku ta̱ɗa̱tsa̱ ba.<verse eid="PRO 4:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20" />Maku ma̱va̱, pana i na mi a kudansa,</para>
  <para style="q2" vid="PRO 4:20">zuwa atsuvu mayin vu pana kadanshi ka̱ va̱.<verse eid="PRO 4:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21" />PiꞋisa kaꞋa ka̱ta̱ vu ka̱sukpa̱ ka ka̱ uta̱ a kusheshe ku nu ba,</para>
  <para style="q2" vid="PRO 4:21">zuwa kaꞋa a ka̱ɗu ka̱ nu,<verse eid="PRO 4:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22" />adama ana wuma u ɗa, wa aza ana i a̱ kula̱nsa̱ le.</para>
  <para style="q2" vid="PRO 4:22">n upoci wi ikyamba i vuma ra̱ka̱.<verse eid="PRO 4:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23" />Ere ka̱ɗu ka̱ nu n utsura u nu ra̱ka̱,</para>
  <para style="q2" vid="PRO 4:23">adama ana a̱ ka̱tsa̱ma̱ ka̱ ni ka wuma u tsu uta̱ tsu mini.<verse eid="PRO 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24" />Vu ka̱sukpa̱ kadanshi ka a uwa,</para>
  <para style="q2" vid="PRO 4:24">ka̱ta̱ kpamu vu yaꞋan daꞋin n kadanshi ku una̱ ure, ure.<verse eid="PRO 4:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25" />Ka̱sukpa̱ a̱shi a̱ nu a inda magaba mayin,</para>
  <para style="q2" vid="PRO 4:25">a ukuna u kadanshi ka̱ nu mayun ɗa.<verse eid="PRO 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26" />Vu yeve ana vu yeve ta̱ ili i na vi a kuyaꞋan,</para>
  <para style="q2" vid="PRO 4:26">ili i na vi a kuyaꞋan ra̱ka̱ kpamu yi ta̱ o ku okpo mayin.<verse eid="PRO 4:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27" />Ka̱ta̱ vu katsukpa usingai ko u gula̱ ba,</para>
  <para style="q2" vid="PRO 4:27">takpa kune ku nu a uye u ka gbani-gbani.<verse eid="PRO 4:27" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="s1">Udansuki adama tsugbani</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 5:1" />Maku ma̱ku ma̱va̱, zuwa atsuvu vu pana ugboji u va̱,</para>
  <para style="q2" vid="PRO 5:1">ɓa̱yuwa̱ atsuvu vu pana kuyeve ku va̱,<verse eid="PRO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2" />adama ana vu yaꞋan ili dem n ka̱ɗu ida̱shi,</para>
  <para style="q2" vid="PRO 5:2">ka̱ta̱ una̱ u nu kpamu u yotsongu ana vi ta̱ n uyevi.<verse eid="PRO 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3" />Adama ana nlebu mu una̱ n kashakanlai ugan ba n yaꞋan uyoꞋo ci ishigi,</para>
  <para style="q2" vid="PRO 5:3">kpamu kadanshi ka̱ni ka laꞋa ta̱ mani n leku,<verse eid="PRO 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4" />ama a ukocishi kuyongo ni i ɗa, okono aɗa,</para>
  <para style="q2" vid="PRO 5:4">wi ta̱ a kusapa wu tsu kotokobi ku una̱ ure ka alyu.<verse eid="PRO 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5" />Ene a̱ ni a ukpisa̱ u ɗa i a kubana,</para>
  <para style="q2" vid="PRO 5:5">uye uni wita̱ a kubanka wu ubuta̱ wi ida̱shi wa̱ a̱kpisa̱.<verse eid="PRO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6" />Ili i bura yi n uye u wuma ba,</para>
  <para style="q2" vid="PRO 5:6">uye u ni magaba ma wi ba,</para>
  <para style="q2" vid="PRO 5:6">a̱yi tana u yeve ana ta uɗa wi nannai ba.<verse eid="PRO 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7" />Gogo na maku ma̱va̱, pana ka mu,</para>
  <para style="q2" vid="PRO 5:7">ka̱ta̱ vu ka̱sukpa̱ kadanshi ka una̱ u va̱ ba.<verse eid="PRO 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8" />YaꞋan daꞋin n uye u ni,</para>
  <para style="q2" vid="PRO 5:8">ka̱ta̱ vu bana ɗevu n utsutsu u kpaꞋa ku ni ba,<verse eid="PRO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9" />ka̱ta̱ utsura u nu u kotso wa aza yoku ba,</para>
  <para style="q2" vid="PRO 5:9">vu kuwa̱ a̱ ka̱ɗa̱nga̱ni ekiye aza babu asuvayali.<verse eid="PRO 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10" />Omoci tana a̱ kupura̱ utsura wi ikyamba i nu,</para>
  <para style="q2" vid="PRO 5:10">mele ma̱ nu ma bana ta̱ a kpaꞋa ku vuza yoku gbani.<verse eid="PRO 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11" />Ka̱ta̱ a ukoci u wuma u nu vu ka̱na̱ ci inka a̱ ka̱tsuma̱ ku usuɗukpi,</para>
  <para style="q2" vid="PRO 5:11">a makyan mana mɓa̱la̱ n takumai i kyamba i nu,<verse eid="PRO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 5:12" />Vi ta̱ a kudana, &lt;&lt;Yiɗa̱i i zuwai ɗa n kpa̱ɗa̱i ku ɗika udansuki?</para>
  <para style="q2" vid="PRO 5:12">Yiɗa̱i i zuwai ɗa ka̱ɗu ka̱va̱ ko goyoi uɓarangi?<verse eid="PRO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13" />N zuwa atsuvu u malum ma̱va̱ ba.</para>
  <para style="q2" vid="PRO 5:13">m bonoko ka̱ɗu ka̱va̱ kpamu we ele ba.<verse eid="PRO 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14" />Ɗanna n yawa ta̱ ɗevu n ku kuwa̱,</para>
  <para style="q2" vid="PRO 5:14">gogo na mi ta̱ ɗevu n kuyaꞋan wono a̱ ka̱tsa̱ma̱ ka uma.&gt;&gt;<verse eid="PRO 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15" />YaꞋan kamayun u vuka vunu,</para>
  <para style="q2" vid="PRO 5:15">vu cigai a̱yi koci.<verse eid="PRO 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16" />Derere ɗa a̱shi mini mi ikyamba ma̱ nu, ma̱ ka̱na̱ ku uwa̱ mini ubuta̱ dem?</para>
  <para style="q2" vid="PRO 5:16">Ko kpamu wo okpo ma yaba dem?<verse eid="PRO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17" />Ka̱sukpa̱ okpo ma̱ nu koci,</para>
  <para style="q2" vid="PRO 5:17">vi e kupece n komoci ba.<verse eid="PRO 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18" />Ka̱sukpa̱ mini ma̱ nu mo okpo n una̱singai,</para>
  <para style="q2" vid="PRO 5:18">yaꞋan ma̱za̱nga̱ n vuka vu nu ka̱ɗa̱nga̱ni.<verse eid="PRO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19" />UgaꞋin u ku ene an mereꞋe,</para>
  <para style="q2" vid="PRO 5:19">ka̱sukpa̱ mani ma ni ma yawai makyan dem,</para>
  <para style="q2" vid="PRO 5:19">ka̱sukpa̱ ucigi u ni kpamu u reme wu.<verse eid="PRO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20" />Maku ma̱va̱ yiɗa̱i i kuzuwa vuka vuza cishakanlai ulya kaci ka̱ nu?</para>
  <para style="q2" vid="PRO 5:20">Yiɗa̱i i kuzuwa vu oɓongu vuka vuza yoku?<verse eid="PRO 5:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21" />Adama ana uye u wuma u vuma, e keteshe ka i a̱ a̱shi a Vuzavaguɗu,</para>
  <para style="q2" vid="PRO 5:21">Vuzavaguɗu tana u tsu kondo ta̱ uye u ni dem.<verse eid="PRO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22" />Unushi u vuza gbani-gbani maza maꞋa wa̱ ni,</para>
  <para style="q2" vid="PRO 5:22">awin a unushi u ni a tsu remei ta̱ mayin.<verse eid="PRO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23" />Utsu kuwa̱ ta̱ adama ukpa̱ɗi u ku reme ka̱cika̱ni</para>
  <para style="q2" vid="PRO 5:23">tsulau tsa a̱bunda̱i tsu ni tsu ɗa tsa a ku unai.<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" sid="PRO 6" />
  <para style="s1">Udansuki adama a tsulau</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 6:1" />Maku ma̱va̱ vu saꞋawa ta̱ ku okpo magan adama a ka̱ja̱ ka̱ nu ubuta̱ u ku isa kutan?</para>
  <para style="q2" vid="PRO 6:1">Vu saꞋawa ta̱ ku shuku vu tsupaka komoci kutan kuna u lyaꞋi?<verse eid="PRO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 6:2" />Ɗa baci kadanshi ka̱nu ka saꞋwai ku ka̱na̱ wu,</para>
  <para style="q2" vid="PRO 6:2">ko kadanshi ku una̱ u nu ko okpoi nu maza,<verse eid="PRO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 6:3" />Gogo na maku ma̱va̱, ili i na va kuyaꞋan i ɗana,</para>
  <para style="q2" vid="PRO 6:3">adama ana vu isa ka̱cika̱nu.</para>
  <para style="q1" vid="PRO 6:3">vu uwa ta̱ tana ɗe ekiye a vuza yoku,</para>
  <para style="q2" vid="PRO 6:3">bana vu goyo ka̱cika̱nu a kelime ka̱ni.</para>
  <para style="q2" vid="PRO 6:3">vu oꞋusoi n ufolu ka̱u.<verse eid="PRO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4" />vu sa̱nka̱ ka̱ci ka̱ nu alavu,</para>
  <para style="q2" vid="PRO 6:4">ko agbaɗiki a̱ a̱shi a̱ nu.<verse eid="PRO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5" />Utuka̱ ka̱cika̱nu uteku tsuna manunu ma̱ tsu fa̱ta̱tsa̱ a ubuta̱ u maza,</para>
  <para style="q2" vid="PRO 6:5">uteku tsuna mesheun ma tsu fa̱ta̱tsa̱ ekiye a vuza vu kutambu.<verse eid="PRO 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6" />Ka̱sukpa̱ vuza vu ukpa̱ɗi u piꞋisa</para>
  <para style="q2" vid="PRO 6:6">ubuta̱ wa̱ a̱riga̱nla̱.<verse eid="PRO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 6:7" />I m mogono ba,</para>
  <para style="q2" vid="PRO 6:7">ko vuzagbayin,</para>
  <para style="q2" vid="PRO 6:7">ko vuza tsugono.<verse eid="PRO 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 6:8" />N nanai dem a tsu ɓolongu ta̱ ili i kulyaꞋa adama a̱ ka̱cika̱le,</para>
  <para style="q2" vid="PRO 6:8">a tsu foɓuso ta̱ a ayin vikyaꞋa adama a̱ lyushi.<verse eid="PRO 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9" />Ali wana ɗai vi a kulyaꞋa kelime n ivaꞋin, avu vuza wonvoli?</para>
  <para style="q2" vid="PRO 6:9">Wanai ɗa vi a̱ kuɗa̱nga̱ alavu?<verse eid="PRO 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10" />Megeshe kenu alavu, megeshe kenu agbaɗiki,</para>
  <para style="q2" vid="PRO 6:10">megeshe kenu mo oɓongu me ekiye adama ana vu uvuka.<verse eid="PRO 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 6:11" />Nanai ɗa unambi u kufa̱ba̱na̱ wu an vuza ma̱ga̱la̱ka̱,</para>
  <para style="q2" vid="PRO 6:11">ka̱ta̱ unambi kpamu u ta̱wa̱ wu tsu koboki.<verse eid="PRO 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12" />Ka̱ka̱ra̱shi ko vuma gbani-gbani,</para>
  <para style="q2" vid="PRO 6:12">u tsu ka̱ra̱sa̱ ta̱ n kadanshi ka kavama a una̱ u ni,<verse eid="PRO 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 6:13" />Utsu yaꞋan ta̱ iyoci n a̱shi a̱ ni,</para>
  <para style="q2" vid="PRO 6:13">u ka̱na̱ kadanshi n izumgbi i ene a̱ni</para>
  <para style="q2" vid="PRO 6:13">a kuyaꞋan ulinga n ka̱jivu ka̱ ni u sokongi.<verse eid="PRO 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 6:14" />A̱ ka̱ɗu ka̱ni tana we a kusheshe ka gbani-gbani,</para>
  <para style="q2" vid="PRO 6:14">a ayin dem u ka̱na̱ ku kuɗa̱ngusa̱ vishili.<verse eid="PRO 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15" />Adama a nannai atakaci i ta̱ a ku ka̱na̱ yi gogo lo.</para>
  <para style="q2" vid="PRO 6:15">m megeshe kenu ɗa i a ku una yi.<verse eid="PRO 6:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 6:16" />Ili i ta̱li yi ta̱ lo ali i cindere, i na Vuzavaguɗu u iwain,</para>
  <para style="q2" vid="PRO 6:16">i na wi a ku kyala ba</para>
  <para style="q2" vid="PRO 6:16">kindi ku kugoyi na yo okpoi ili yi unata wa̱ ni.<verse eid="PRO 6:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 6:17" />Ele ɗa, kindi ku kugoyi,</para>
  <para style="q2" vid="PRO 6:17">n Kelentsu ka a uwa,</para>
  <para style="q2" vid="PRO 6:17">N ekiye aza munuka ma aza babu unushi.<verse eid="PRO 6:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 6:18" />N ka̱ɗu kana ka tsu sheshe ka gbani-gbani,</para>
  <para style="q2" vid="PRO 6:18">N kune ku kuyaꞋan kagbanigbani gogoꞋo,<verse eid="PRO 6:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 6:19" />M magan ma a uwa vuzana utsu dansa u kuna wa uwa,</para>
  <para style="q2" vid="PRO 6:19">N vuza na u tsu ɗa̱ngusa̱ vishili wi itoku i ni.<verse eid="PRO 6:19" /></para>
  <para style="s1">Udansuki adama tsugbani</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 6:20" />Maku ma̱va̱, ɓa̱na̱ odoki a Dada nu</para>
  <para style="q2" vid="PRO 6:20">ka̱ta̱ kpamu vu ka̱sukpa̱ ku yotsongusu ka̱ a̱na̱vu ba.<verse eid="PRO 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21" />Shiya le a̱ ka̱ɗu ka̱nu ayin dem,</para>
  <para style="q2" vid="PRO 6:21">shiya le e kuɗeku kunu.<verse eid="PRO 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 6:22" />Ayin ana baci vu walai, i ta̱ a kutono n avu,</para>
  <para style="q2" vid="PRO 6:22">ayin ana baci vu vaki, i ta̱ a ku inda wu,</para>
  <para style="q2" vid="PRO 6:22">ayin ana baci vu ɗa̱nga̱i, i ta̱ a kuyaꞋan kadanshi n avu.<verse eid="PRO 6:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23" />Adama ana odoki a nampa ma̱kuni maꞋa,</para>
  <para style="q2" vid="PRO 6:23">kuyotsongusu ku nampa kpamu kutashi ku ɗa,</para>
  <para style="q1" vid="PRO 6:23">udansuki n ugbari kpamu</para>
  <para style="q2" vid="PRO 6:23">uye u wuma u ɗa,<verse eid="PRO 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24" />wita̱ a ku kanza wu ubuta̱ u vuka vu gbani-gbani,</para>
  <para style="q2" vid="PRO 6:24">n ubuta̱ wu una̱ wu uyoꞋo u vuka vu vuza.<verse eid="PRO 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25" />Ka̱ta̱ vu cikala ugaꞋin u vuka vu vuza yoku a̱ ka̱ɗu ka̱ nu ba,</para>
  <para style="q2" vid="PRO 6:25">ko kpamu vu ka̱sukpa̱ a̱shi a̱ ni a ɗika asuvu a̱ nu ba,<verse eid="PRO 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26" />A tsu ciya̱ ta̱ kashakanlai n ikebe yi ilikulyaꞋa koci,</para>
  <para style="q2" vid="PRO 6:26">ama vuka vu vuza yoku tsu la̱nsa̱ ta̱ wuma u vuma.<verse eid="PRO 6:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 6:27" />Vuma wita̱ a kufuɗa ku kimba̱ a kina a̱ ma̱ka̱nga̱ ma̱ ni,</para>
  <para style="q2" vid="PRO 6:27">babu na motogu ma̱ni ma̱ kula̱?<verse eid="PRO 6:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28" />Vuma wita̱ a kufuɗa ku wala a gaɗi va̱ a̱ga̱ruwa̱shi akina</para>
  <para style="q2" vid="PRO 6:28">ka̱ta̱ u kpa̱ɗa̱ ku kula̱ adasukpatsu a ene a̱ni?<verse eid="PRO 6:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29" />Ta wi nanai u vuza na u vaki n vuka vu vutoku ni,</para>
  <para style="q2" vid="PRO 6:29">vuza na u yaꞋin nanai dem, wi a kulaka ba.<verse eid="PRO 6:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30" />Uma a tsu neke koboki wono ba,</para>
  <para style="q2" vid="PRO 6:30">ɗa baci a cinai ni u yaꞋin uboki adama kambulu.<verse eid="PRO 6:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31" />N nanai dem ɗa baci e reme ni, mayun ɗa u tsupa kucindere,</para>
  <para style="q2" vid="PRO 6:31">ko ɗa baci, u ku zuwa u namba uciyi u kpaꞋa uni ra̱ka̱.<verse eid="PRO 6:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32" />Ama vuma na u vaki n vuka vu vuza yoku wi mayin ba,</para>
  <para style="q2" vid="PRO 6:32">a̱yi na baci de dem u yaꞋin nanai wu una ta̱ ka̱cika̱ni.<verse eid="PRO 6:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 6:33" />I ta̱ a ku lapai, ka̱ta̱ e nekei wono,</para>
  <para style="q2" vid="PRO 6:33">wono u na wa kukotso ba.<verse eid="PRO 6:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34" />Adama ana cisheꞋe tsu tsu ɗengusa̱ ta̱ wupa u vali,</para>
  <para style="q2" vid="PRO 6:34">u tsu ka̱sukpa̱ ba makyan ma na wi a kutsupa.<verse eid="PRO 6:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35" />Wi a ku isa katsupu ba,</para>
  <para style="q2" vid="PRO 6:35">babu ka̱bunda̱i ka kuneꞋe kana ka ku vaꞋanku wupa u ni ba.<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" sid="PRO 7" />
  <para style="s1">Udansuki adama tsugbani</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 7:1" />Maku ma̱va̱, reme kadanshi ka̱va̱</para>
  <para style="q2" vid="PRO 7:1">ka̱ta̱ kpamu vu zuwa wila̱ u va̱ a̱ ka̱ɗu ka̱ nu.<verse eid="PRO 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2" />Tono wila̱ u va̱, vi ta̱ a̱ ciya̱ wuma,</para>
  <para style="q2" vid="PRO 7:2">ere ku yotsongusu ku va̱ an maku ma ka̱shi ma̱ nu.<verse eid="PRO 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 7:3" />Shiya le ekiye a̱ nu,</para>
  <para style="q2" vid="PRO 7:3">ɗana le a magbaganla ma̱ ka̱ɗu ma̱ nu.<verse eid="PRO 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4" />Dana ugboji a vu ɗa taku va̱,</para>
  <para style="q2" vid="PRO 7:4">ka̱ta̱ vu dana kpamu kuyeve kumaci ku nu,<verse eid="PRO 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5" />i ta̱ a ku ere wu ubuta̱ u tsugbani,</para>
  <para style="q2" vid="PRO 7:5">n ubuta̱ u vuka vu vuza yoku vu na vi n una̱ wu uyoꞋo.<verse eid="PRO 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 7:6" />Kanna ko yoku mi a ku indana,</para>
  <para style="q2" vid="PRO 7:6">n tsu katusu ka kpaꞋa ka̱ va̱.<verse eid="PRO 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 7:7" />Ɗa me enei a̱ ka̱tsuma̱ ka za a babu kusheshe,</para>
  <para style="q2" vid="PRO 7:7">ɗa n zukai vuza yoku a̱ ka̱tsuma̱ ko kolobo,</para>
  <para style="q2" vid="PRO 7:7">ka̱ɗa̱nga̱ni koyoku ka na ki babu ma̱riki.<verse eid="PRO 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8" />A̱yi nwalu a uye ugbayin ɗevu n ubuta̱ u na wi ida̱shi.</para>
  <para style="q2" vid="PRO 7:8">a nwalu a uye a kubana a kpaꞋa ku ni,<verse eid="PRO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9" />n kulivi, makyan mana kanna ki a̱ kuyikpa̱,</para>
  <para style="q2" vid="PRO 7:9">a makyan ma na ka̱yimbi ka kayin ka̱ gita̱i.<verse eid="PRO 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 7:10" />Ɗa u cinai ni,</para>
  <para style="q2" vid="PRO 7:10">u lapulai ka̱cika̱ni tsu kashakanlai o kufoɓuso tsuna u kuya̱nsa̱ yi.<verse eid="PRO 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11" />A̱yi tana vuza motonu ɗa, kpamu n ugbamiwasuvu,</para>
  <para style="q2" vid="PRO 7:11">makyan dem ene a̱ ni i a ida̱shi a kpaꞋa ba.<verse eid="PRO 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12" />Makyan mo yoku a uye, makyan mo yoku kpamu a̱ suvu a likuci,</para>
  <para style="q2" vid="PRO 7:12">ubuta̱ dem una uye u kpatalai, ta ɗe vi a kucinai.<verse eid="PRO 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 7:13" />Ɗa woɓongi ni,</para>
  <para style="q2" vid="PRO 7:13">n kindi ku ugoyi ɗa u danai ni.<verse eid="PRO 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 7:14" />&lt;&lt;Mi ta̱ n ka̱ɗiva̱ ka ida̱shi ma̱ta̱na̱ a kpaꞋa,</para>
  <para style="q2" vid="PRO 7:14">anna mi ta̱ a kushatangu uzuwakpani uva̱.<verse eid="PRO 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15" />I ɗaɗa i zuwai ɗa mu uta̱i adama ana n gasa n avu,</para>
  <para style="q2" vid="PRO 7:15">n ciga ta̱ me ene wu, ɗa tana me enei nu na.<verse eid="PRO 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16" />N pala ta̱ a̱ga̱da̱ a̱va̱</para>
  <para style="q2" vid="PRO 7:16">n arikinla a tsuzogu tsa aza Masar.<verse eid="PRO 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17" />N bufangu ɗe ili ma̱gula̱ni a̱ga̱da̱ va̱,</para>
  <para style="q2" vid="PRO 7:17">n muru vu ma̱gula̱ni, n alosu koɓolo n sinamon.<verse eid="PRO 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18" />Ta̱wa̱, tsu pana uyoꞋo wu ucigi, tsu panakpanai ali usana,</para>
  <para style="q2" vid="PRO 7:18">ta̱wa̱ tsu oɓongbonoi a̱ ka̱tsuma̱ ka maciganai.<verse eid="PRO 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19" />Vali va̱ wi punu a kpaꞋa ba,</para>
  <para style="q2" vid="PRO 7:19">u yaꞋan ta̱ nwalu n daꞋangi.<verse eid="PRO 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20" />U ɗika ta̱ ikebe ya a̱bunda̱i,</para>
  <para style="q2" vid="PRO 7:20">wi a kubono a kpaꞋa ba, sai kanna ka na wotoi u pecei.&gt;&gt;<verse eid="PRO 7:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 7:21" />Ɗa u kondoi le n a̱guma̱ a̱ni,</para>
  <para style="q2" vid="PRO 7:21">n una̱ wu uyoꞋo u ni ɗa u doroi ni.<verse eid="PRO 7:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22" />Gogolo ɗa u tonoi ni</para>
  <para style="q2" vid="PRO 7:22">tsu kanaka kana a ku banka ubuta̱ u ku kiɗa,</para>
  <para style="q1" vid="PRO 7:22">tsu mesheun ma na mi a ka ɗikpangusu a kubana a maza.<verse eid="PRO 7:22" /></para>
  <para style="q2">
    <verse number="23" style="v" sid="PRO 7:23" />Ubuta̱ u na kaya ka sovoi ni ali a̱ ka̱ɗu ka̱ni,</para>
  <para style="q1" vid="PRO 7:23">wita̱ lo tsu manunu mana mo moloko a ku uwa a maza,</para>
  <para style="q2" vid="PRO 7:23">a̱yi u yeve ana n wuma u ni u ɗa u ku tsupaka ba.<verse eid="PRO 7:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 7:24" />Gogo na, muku n va̱, panakai mu,</para>
  <para style="q2" vid="PRO 7:24">zuwai atsuvu i pana kadanshi ka̱ una̱ u va̱.<verse eid="PRO 7:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 7:25" />Ka̱ta̱ yu ushuku n icuꞋu i vuka vu nanlo,</para>
  <para style="q2" vid="PRO 7:25">u zuwa ka̱ɗu ka̱ ɗa̱ ka cikala kuyongo kuni ba,</para>
  <para style="q2" vid="PRO 7:25">ka̱ ta̱ i tono uye u ni ba.<verse eid="PRO 7:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 7:26" />Adama ana a̱yi ɗa wu una uma n a̱bunda̱i,</para>
  <para style="q2" vid="PRO 7:26">u zuwai uma n a̱bunda̱i ukpa̱</para>
  <para style="q2" vid="PRO 7:26">ali i kukece ba.<verse eid="PRO 7:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27" />KpaꞋa ku ni uye u kubana a kpaꞋa ku ukpisa̱ uɗa,</para>
  <para style="q2" vid="PRO 7:27">u na u gida̱la̱ a kubana a kasaun.<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" sid="PRO 8" />
  <para style="s1">Una̱singai wu ugboji</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1" />panai, ugboji wita̱ a̱ meɗevile,</para>
  <para style="q2" vid="PRO 8:1">kuyeve a ku ɗengusa̱ ka̱la̱ka̱tsu ka̱ ni.<verse eid="PRO 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2" />A nsasan, n uye,</para>
  <para style="q2" vid="PRO 8:2">a uɓon u na nsanji n gasai, talo u shamgbai.<verse eid="PRO 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3" />a̱ ka̱kina̱ ku utsutsu u na u uwai a likuci,</para>
  <para style="q2" vid="PRO 8:3">a utsutsu u likuci a̱ meɗevile n ka̱la̱ka̱tsu kagbayin.<verse eid="PRO 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4" />&lt;&lt;A̱ɗa̱ ali, a̱ ɗa̱ ɗa mi a meɗevile,</para>
  <para style="q2" vid="PRO 8:4">meɗevile ma̱ va̱ a u yabadem ɗa.<verse eid="PRO 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5" />A̱ɗa̱ aza unambi u kusheshe, piꞋisai kuyaꞋan ugboji,</para>
  <para style="q2" vid="PRO 8:5">a̱ ɗa̱ alau, la̱nsa̱i kuyeve.<verse eid="PRO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6" />Zuwai atsuvu i pana, adama ana mita̱ a kudana ɗa̱ ili singai,</para>
  <para style="q2" vid="PRO 8:6">ili i na baci de dem n dansai i singai i ɗa.<verse eid="PRO 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7" />Kadanshi kana n dansai mayun ɗa,</para>
  <para style="q2" vid="PRO 8:7">kagbanigbani, ili yu unata i ɗa a una̱ u a̱va̱.<verse eid="PRO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8" />Kadanshi ku una̱ u va̱ ra̱ka̱ kasingai kaꞋa,</para>
  <para style="q2" vid="PRO 8:8">koyoku ki punu ka na ki usokongi ba, ko a uwa.<verse eid="PRO 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9" />Ra̱ka̱ vu le i ta̱ gaɗi u vuza kuyeve,</para>
  <para style="q2" vid="PRO 8:9">derere ɗa kpamu a ubuta̱ wa aza ana i n kuyeve.<verse eid="PRO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10" />Zagba odoki a̱ va̱, una̱ wa azurufa,</para>
  <para style="q2" vid="PRO 8:10">kuyeve kpamu una̱ u kazanariya kasingai,<verse eid="PRO 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11" />adama ana ugboji u lata̱ idolu i singai tsuloboi,</para>
  <para style="q2" vid="PRO 8:11">ili i na vu laꞋi n kuciga ra̱ka̱, wi ku gisanku n a̱yi ba.<verse eid="PRO 8:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12" />&lt;&lt;Mpa, ugboji, mi ta̱ n ugboji,</para>
  <para style="q2" vid="PRO 8:12">mi ta̱ n kuyeve koɓolo n ma̱riki.<verse eid="PRO 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13" />Wovon u Ka̱shile, u ɗaɗa vu iwan kagbanigbani,</para>
  <para style="q2" vid="PRO 8:13">ugbamukaci, n a̱ra̱ɗi, n uye u kagbanigbani.</para>
  <para style="q2" vid="PRO 8:13">n kadanshi ka kuya̱nsa̱, n iwan ta̱ kaꞋa.<verse eid="PRO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14" />Mita̱ n odoki n ugboji,</para>
  <para style="q2" vid="PRO 8:14">mi ta̱ n kuyeve, n utsura.<verse eid="PRO 8:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15" />N ɓa̱nka̱ ta̱ ngono ubuta̱ u tsugono u le,</para>
  <para style="q2" vid="PRO 8:15">a yaꞋin a fada kpamu a zuwa odoki a singai.<verse eid="PRO 8:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16" />N uɓa̱nki u va̱ uɗa ngono ra̱ka̱ mi a kulyaꞋa tsugono,</para>
  <para style="q2" vid="PRO 8:16">ta feu aza kelime n a yaꞋin afada i nanai.<verse eid="PRO 8:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17" />N ciga ta̱ aza ana a cigai mu,</para>
  <para style="q2" vid="PRO 8:17">aza ana a̱ la̱nsa̱i mu ita̱ a̱ kuciya̱ mu.<verse eid="PRO 8:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18" />Uciyi n tsugbayin wi ta̱ wa a̱va̱,</para>
  <para style="q2" vid="PRO 8:18">uciyi u babu uteku n wu usuɓi.mayun ɗa.<verse eid="PRO 8:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19" />Ili i na vu ciya̱i wa̱ a̱ va̱ u laꞋa ta̱ kazanariya ka singai,</para>
  <para style="q2" vid="PRO 8:19">i laꞋa ta̱ azurufa a singai.<verse eid="PRO 8:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20" />N wala ta̱ a uye wu usuɓi,</para>
  <para style="q2" vid="PRO 8:20">a uye u kamayun,<verse eid="PRO 8:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21" />n neke uciyi wa aza ana a cigai mu,</para>
  <para style="q2" vid="PRO 8:21">n shatangu mpon le kpamu n uciyi.<verse eid="PRO 8:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22" />&lt;&lt;Mpa ɗa vuza vu ugiti vuna Vuzavaguɗu u gita̱i kuyaꞋan,</para>
  <para style="q2" vid="PRO 8:22">kafu u yaꞋan ili dem.<verse eid="PRO 8:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23" />A yaꞋan mu ta̱ ali n ayin ugiti,</para>
  <para style="q2" vid="PRO 8:23">kafu u gita̱ wa aduniya.<verse eid="PRO 8:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24" />A matsa mu ta̱ mala mu uga̱vi,</para>
  <para style="q2" vid="PRO 8:24">makyan mana babu a̱shi a̱ mini.<verse eid="PRO 8:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25" />Kafu a yaꞋan nsansa,</para>
  <para style="q2" vid="PRO 8:25">ɗa a yaꞋan mu a ginda,<verse eid="PRO 8:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26" />kafu uyaꞋan aduniya n akamba</para>
  <para style="q2" vid="PRO 8:26">ko kafu na utuka̱ kayala ku ugiti.<verse eid="PRO 8:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27" />Mpa mi ta̱ lo ayin ana u yaꞋin gaɗi,</para>
  <para style="q2" vid="PRO 8:27">a na u pecei uteku u mini,<verse eid="PRO 8:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28" />a na u yaꞋin eleshu gaɗi,</para>
  <para style="q2" vid="PRO 8:28">ɗa kpamu u zuwai uga̱vi wa nɗolu,<verse eid="PRO 8:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 8:29" />a na u zuwakai malaꞋa u teku,</para>
  <para style="q2" vid="PRO 8:29">adama ana ka̱ta̱ mini ma laza ubuta̱ u na a zuwa ni ba,</para>
  <para style="q1" vid="PRO 8:29">kpamu, a na u zuwai u teku wu uduniya.<verse eid="PRO 8:29" /></para>
  <para style="q2">
    <verse number="30" style="v" sid="PRO 8:30" />Mpa ugboji mi ta̱ koɓolo n a̱yi, tsu kafuɗi ku ulinga.</para>
  <para style="q1" vid="PRO 8:30">mpa ɗa makyan dem u tsu pana u yoꞋo,</para>
  <para style="q2" vid="PRO 8:30">a yin tutu n tsu yaꞋan ta̱ ma̱za̱nga̱ n a̱yi.<verse eid="PRO 8:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31" />Mi ta̱ ma̱za̱nga̱ n aduniya a̱ni ra̱ka̱,</para>
  <para style="q2" vid="PRO 8:31">mi ta̱ kpamu a kupana u yoꞋo vuma lima̱.<verse eid="PRO 8:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32" />&lt;&lt;Gogo na, a̱ɗa̱nga̱ni a va̱ panai kadanshi ka̱ va̱,</para>
  <para style="q2" vid="PRO 8:32">yaꞋin tsu na n danai, vi ta̱ tana a kuyaꞋan ma̱za̱nga̱.<verse eid="PRO 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33" />Panai, odoki a̱ va̱ adama ana i gbojo,</para>
  <para style="q2" vid="PRO 8:33">ka̱ta̱ i iwan a ɗa ba.<verse eid="PRO 8:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34" />Vuza vu una̱singai ɗa vuza na u panakai mu,</para>
  <para style="q2" vid="PRO 8:34">wi kashani utsutsu kanna dem,</para>
  <para style="q2" vid="PRO 8:34">a ku vana utsutsu u ku wala u va̱.<verse eid="PRO 8:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35" />Adama ana vuza na baci dem u ciya̱i mu, u ciya̱ ta̱ wuma.</para>
  <para style="q2" vid="PRO 8:35">iyoci i kuciya̱ mapasa ma singai ubuta̱ u Vuzavaguɗu ɗa.<verse eid="PRO 8:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36" />Ama vuza na baci dem u kpa̱ɗi kuciya̱ mu, u foro ta̱ ka̱cika̱ni,</para>
  <para style="q2" vid="PRO 8:36">vuza na baci de dem u iwain mu, u ciga ta̱ ukpa̱Ꞌa̱.&gt;&gt;<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" sid="PRO 9" />
  <para style="s1">Ugboji n tsulau</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 9:1" />Ugboji u maꞋa ta̱ kpaꞋa ku ni</para>
  <para style="q2" vid="PRO 9:1">u sheꞋwei nshilya n cindere n ni.<verse eid="PRO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2" />U zuwai a kiɗai i nyama adama a̱ ka̱ɗiva̱, u foɓusoi ma̱kya̱n a̱ ni,</para>
  <para style="q2" vid="PRO 9:2">ɗa kpamu u foɓusoi ka̱ɗiva̱ ka̱ ni.<verse eid="PRO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3" />U suku ta̱ agbashi a̱ ni a̱ ma̱ci,</para>
  <para style="q2" vid="PRO 9:3">adama ana u ɗekushe a kusan ku u gaɗi a likuci.<verse eid="PRO 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 9:4" />&lt;&lt;Ka̱sukpa̱ a̱ ɗa̱ na yi aza ugboji ba.&gt;&gt;</para>
  <para style="q2" vid="PRO 9:4">kpatalai na,</para>
  <para style="q2" vid="PRO 9:4">wa aza unambi wu u ka̱ni wa asuvu.<verse eid="PRO 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 9:5" />&lt;&lt;Ta̱wa̱i i lyaꞋa ilikulya i va̱,</para>
  <para style="q2" vid="PRO 9:5">soꞋi ma̱kya̱n ma na n foɓusoi.<verse eid="PRO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 9:6" />Ka̱sukpa̱ unambi u kusheshe, adama ana i ciya̱ wuma,</para>
  <para style="q2" vid="PRO 9:6">yaꞋin nwalu a uye wu u yeve.&gt;&gt;<verse eid="PRO 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 9:7" />&lt;&lt;Yabadem na baci u dansukai vuza vu kugoyi, wi ta̱ a kuronoko ka̱cika̱ni kugoyi.</para>
  <para style="q2" vid="PRO 9:7">vuzana kpamu u dansuka vuza gbani-gbani, a̱yi ɗa u kuciya̱ mɓa̱la̱.<verse eid="PRO 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8" />Ko kenu ka̱ ta̱ vu dansuka vuza vu kugoyi ba, adama ana wita̱ a ku iwan wu.</para>
  <para style="q2" vid="PRO 9:8">Ama vu dansuka baci vuza vu ugboji, a̱ yi tana wi ta̱ a kuciga wu.<verse eid="PRO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 9:9" />Neke vuza vu ugboji odoki, ka̱ta̱ a̱yi tana udoku ugboji,</para>
  <para style="q2" vid="PRO 9:9">PiꞋisaka vuza vu usuɓi, ka̱ta̱ a̱yi tana udoku n kuyeve.<verse eid="PRO 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 9:10" />Wovon u Ka̱shile u ɗa u giti ugboji,</para>
  <para style="q2" vid="PRO 9:10">kpamu kuyeve ku Vuza ciɗa nanlo ɗaɗa kuyeve.<verse eid="PRO 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11" />Adama a̱ va̱, ayin a̱ nu i ta̱ o ku doku kuyimkpa,</para>
  <para style="q2" vid="PRO 9:11">ka̱ta̱ o doku wu kpamu a̱ya̱ a wuma a̱ nu.<verse eid="PRO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12" />Vi baci nu ugboji, vi ta̱ nu ugboji adama a̱ ka̱cika̱nu,</para>
  <para style="q2" vid="PRO 9:12">ama, vi baci n kugoyi, a vu ɗa koci vi a ku takacika.&gt;&gt;<verse eid="PRO 9:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 9:13" />Kalau ka vuka, za kadanshi n a̱bunda̱i,</para>
  <para style="q2" vid="PRO 9:13">vuza vu unambi u kusheshe ɗa, u yeve ili ba.<verse eid="PRO 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14" />U tsu da̱sa̱ngu ta̱ u tsutsu u kpaꞋa ku ni,</para>
  <para style="q2" vid="PRO 9:14">a kakuba ki ida̱shi ka̱ ni ku ugaɗi ka likuci,<verse eid="PRO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 9:15" />a kuɗeke aza ana i a nwalu,</para>
  <para style="q2" vid="PRO 9:15">aza ana kusheshe ku le ki a ubuta̱ wu ulinga u le.<verse eid="PRO 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 9:16" />Utsu dana ta̱, &lt;&lt;A̱ɗa̱ aza unambi u kusheshe ta̱wa̱i na.&gt;&gt;</para>
  <para style="q2" vid="PRO 9:16">wa aza unambi wu uka̱ni u ka̱ɗu kpamu utsu dana ta̱.<verse eid="PRO 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 9:17" />&lt;&lt;Mini mu uboki ma tsu yokpo ta̱,</para>
  <para style="q2" vid="PRO 9:17">ilikulyaꞋa i na a tsu lyaꞋa usokongi wita̱ n uyoꞋo.&gt;&gt;<verse eid="PRO 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18" />Ama aza ana a uwai ekiye a̱ ni, e yeve a na a̱kpisa̱ a ɗa i a ubuta̱ wa ba.</para>
  <para style="q2" vid="PRO 9:18">kpamu omoci a̱ ni, i ta̱ a̱ ku gida̱la̱ kubana ubuta̱ wi ida̱shi ya a̱kpisa̱.<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" sid="PRO 10" />
  <para style="s1">Ansa a Sulemanu</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1" />Ansa a Sulemanu a ɗa na,</para>
  <para style="q1" vid="PRO 10:1">maku mu ugboji ma tsu zuwa ta̱ Dada ni ma̱za̱nga̱,</para>
  <para style="q2" vid="PRO 10:1">ama kalau ka maku, ili yu una̱mgbi u ka̱tsuma̱ i ɗa wa a̱na̱ku a̱ ni.<verse eid="PRO 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2" />Uciyi una o ɓolongi a uye u gbanigbani, u tsu neke i li ba,</para>
  <para style="q2" vid="PRO 10:2">ama ida̱shi yu usuɓi u tsu utuka̱ ta̱ vuma ukpa̱.<verse eid="PRO 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3" />Vuzavaguɗu wi a̱ kuka̱sukpa̱ vuza vu usuɓi a̱ ka̱tsuma̱ ka kambulu ba</para>
  <para style="q2" vid="PRO 10:3">ama u tsu sa̱nka̱ ta̱ kusheshe ka aza a gbani-gbani ku shana.<verse eid="PRO 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4" />Tsurogo tsu tsu zuwa ta̱ vuma unambi,</para>
  <para style="q2" vid="PRO 10:4">ama kuyaꞋan ku ulinga ku tsu tuka̱ ta̱ n uciyi.<verse eid="PRO 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5" />A̱yi na u ɓolongi ili i kashina n lyushi a̱yi ɗa vuza vu ugboji.</para>
  <para style="q2" vid="PRO 10:5">ama a̱yi na u latai a ayin a vikyaꞋa a̱yi ɗa vuza na u tsu tuka̱ n wono.<verse eid="PRO 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6" />Una̱singai wita̱ a kaci ka vuza vu usuɓi,</para>
  <para style="q2" vid="PRO 10:6">ama u vuza gbani-gbani u tsu sokongu ta̱ u kuna u vishili u ni.<verse eid="PRO 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7" />Kuciɓasa ku vuza vu usuɓi una̱singai u ɗa,</para>
  <para style="q2" vid="PRO 10:7">ama kula ku vuza gbani-gbani ki i ta̱ a̱ ku na̱mgba̱.<verse eid="PRO 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 10:8" />Vuza vu ugboji, a̱yi ɗa u tsu ushuku n odoki,</para>
  <para style="q2" vid="PRO 10:8">ama vuza kadanshi ka tsulau wi ta̱ a̱ ku na̱mgba̱.<verse eid="PRO 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9" />Vuza na dem wi an nwalu a̱ ka̱tsuma̱ ku usuɓi, utsu yaꞋan ta̱ nwalu n ni m ma̱ta̱na̱.</para>
  <para style="q2" vid="PRO 10:9">ama vuza vu unambi usuɓi a tsu yeve yi ta̱.<verse eid="PRO 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10" />Vuza na u tsu reme ka mayun, u tsu tuka̱ ta̱ n atakaci,</para>
  <para style="q2" vid="PRO 10:10">ama vuza na udanshi kamayun utsu tuka̱ ta̱ m ma̱ta̱na̱<verse eid="PRO 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 10:11" />Kadanshi ka vuza vu usuɓi ka̱shi ka̱ mini ma wuma maꞋa,</para>
  <para style="q2" vid="PRO 10:11">ama kadanshi ka vuza gbani-gbani ka tsu sokongu ta̱ u kuna u vishili u ni.<verse eid="PRO 10:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12" />Tsurala tsu zuwa ta̱ vishili,</para>
  <para style="q2" vid="PRO 10:12">ama ucigi u tsu cinukpa ta̱ nu unushi ra̱ka̱.<verse eid="PRO 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13" />Uma ugboji a tsu dansa ta̱ ka̱ ma̱riki,</para>
  <para style="q2" vid="PRO 10:13">ama uma a gbanigbani u gaꞋan ta̱ atakaci ka le.<verse eid="PRO 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14" />Vuza vu ugboji u tsu ɓolongu ta̱ ku yeve,</para>
  <para style="q2" vid="PRO 10:14">ama una̱ u kalau u tsu tuka̱ ta̱ nu u kpa̱.<verse eid="PRO 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15" />Udukuyan, mashilya maꞋa ma vuza vu uciyi,</para>
  <para style="q2" vid="PRO 10:15">ama unambi munuka maꞋa ma vu za vu unambi.<verse eid="PRO 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16" />Katsupu ka kuyaꞋan kasingai kaɗa wuma,</para>
  <para style="q2" vid="PRO 10:16">ama katsupu ka vuza vu unushi ka ɗa atakaci.<verse eid="PRO 10:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17" />A̱yi vuzana u tsu ushuku n ugbari n odoki, wi ta̱ a ku ciya̱ wuma,</para>
  <para style="q2" vid="PRO 10:17">ama a̱ yi vuzana u tsu inwan ugbari wi ta̱ a̱ kupuwa̱nka̱.<verse eid="PRO 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18" />Vuza na dem u tsu sokongu tsurala, kayaꞋin ka uwa kaꞋa,</para>
  <para style="q2" vid="PRO 10:18">vuzana kpamu dem u tsu la̱nga̱sa̱ ula uma kalau kaꞋa.<verse eid="PRO 10:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19" />Kadanshi ka yimkpa baci a̱ bunda̱i ɗa vuma u tsu ciya̱ unushi,</para>
  <para style="q2" vid="PRO 10:19">ama vuza vu ugboji ɗa baci vi, sai vu paɗa bini.<verse eid="PRO 10:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20" />Kadanshi ka vuza vu usuɓi, ki ta̱ an azurufa ana a zagbai,</para>
  <para style="q2" vid="PRO 10:20">ama ka̱ɗu ka vuza gbani-gbani ki nu ugaꞋin ba ko kenu.<verse eid="PRO 10:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21" />Kadanshi vuza vu usuɓi ku tsu lyaꞋatangu uma n a̱bunda̱i,</para>
  <para style="q2" vid="PRO 10:21">ama kalau ka tsu kuwa̱ ta̱ adama unambi wu usuɓi.<verse eid="PRO 10:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22" />Una̱singai u Vuzavaguɗu u tsu tuka̱ ta̱ n uciyi,</para>
  <para style="q2" vid="PRO 10:22">ama ka̱bunda̱i ku ulinga ko tsu doku uciyi ba.<verse eid="PRO 10:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23" />U kalau, kuyaꞋan ku ka gbani-gbani, ili yu ugulani u ɗai,</para>
  <para style="q2" vid="PRO 10:23">ama u vuza kuyeve, ugboji u tsu yokpo ta̱.<verse eid="PRO 10:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24" />I na vu za gbani-gbani wi o wovon, i ɗa i kuciya̱i</para>
  <para style="q2" vid="PRO 10:24">ama i na vuza vu usuɓi u cigai i ɗaɗa a ku ciya̱.<verse eid="PRO 10:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25" />Ayin a na baci kabatalikpau ka gbanigbani ka lazai, i o kudoku ku ene aza a gbanigbani ba,</para>
  <para style="q2" vid="PRO 10:25">ama vuza usuɓi u tsu shamgba ta̱ n utsura ali a kubana u teku.<verse eid="PRO 10:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26" />Ka̱ta̱ vu zuwa korogo ka yaꞋanka wu ili ba,</para>
  <para style="q2" vid="PRO 10:26">ta lo wa ko okpo wu tsu mini ma kalam a anga ko kpamu tsu ka̱nga̱ a̱ a̱shi a̱ nu.<verse eid="PRO 10:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 10:27" />Wovon u Ka̱shile u tsu doku ta̱ wuma wu ugaɗi,</para>
  <para style="q2" vid="PRO 10:27">ama wuma u vuza gbani-gbani wi ta̱ gbati.<verse eid="PRO 10:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28" />A̱pa̱ a vuza vu usuɓi ma̱za̱nga̱ maꞋa,</para>
  <para style="q2" vid="PRO 10:28">ama a̱pa̱ aza vuza gbani-gbani a̱ tsu tuka̱ n ili ba.<verse eid="PRO 10:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29" />Uye u Vuzavaguɗu mashilya ma ku ere maꞋa u vuza vu usuɓi,</para>
  <para style="q2" vid="PRO 10:29">ama ili munuka i ɗa ubuta̱ wa aza kuyaꞋan ka gbani-gbani.<verse eid="PRO 10:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30" />Aza usuɓi i ta̱ a kuciya̱ ukanji ayin tutu,</para>
  <para style="q2" vid="PRO 10:30">ama a̱ ku ka̱sukpa̱ aza gbani-gbani iɗika ya ba.<verse eid="PRO 10:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31" />Aza usuɓi a tsu dansa ta̱ ugboji,</para>
  <para style="q2" vid="PRO 10:31">ama kelentsu kana ka tsu dansa a uwa ki ta̱ a kuyaꞋan ugbati.<verse eid="PRO 10:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32" />Kelentsu ka vuza vu usuɓi ka yeve ta̱ i na i gaꞋin,</para>
  <para style="q2" vid="PRO 10:32">ama una̱ u vuza gbani-gbani, wi ni yoku ba sai kadanshi ka gbani-gbani koci.<verse eid="PRO 10:32" /></para>
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" sid="PRO 11" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1" />Vuzavaguɗu u tsu iwan ta̱ vuza kagisamkpatsu ka a uwa,</para>
  <para style="q2" vid="PRO 11:1">ama u tsu pana ta̱ uyoꞋo wa za agisamkpatsu a mayun.<verse eid="PRO 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2" />A̱ra̱ɗi a̱ tsu tuka̱ ta̱ n wono,</para>
  <para style="q2" vid="PRO 11:2">ama vuza babu a̱ra̱ɗi vuza vu ugboji ɗa.<verse eid="PRO 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3" />UgaꞋin wa aza kamayun a ka̱ɗu, u tsu tono ta̱ n ele,</para>
  <para style="q2" vid="PRO 11:3">ama aza unambi u kamayun a tsu una ta̱ ka̱cika̱le adama a ka gbani-gbani ke le.<verse eid="PRO 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4" />Udukuyan u tsu yongo n ugaꞋin a kanna ka ku kiɗa ka afada ba,</para>
  <para style="q2" vid="PRO 11:4">ama ida̱shi yu usuɓi i tsu utuka̱ ta̱ vuma ubuta̱ wu ukpa̱.<verse eid="PRO 11:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="PRO 11:5" />U kuna wu usuɓi wa aza babu unushi u tsu tono a̱ n ele a uye u magaba,</para>
  <para style="q2" vid="PRO 11:5">ama aza a gbani-gbani a tsu yikpa̱ ta̱ adama ka a gbani-gbani ke le.<verse eid="PRO 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 11:6" />Usuɓi wa aza ka mayun a̱ɗa̱ u tsu utuka̱ le ta̱,</para>
  <para style="q2" vid="PRO 11:6">ama aza iyaꞋanshi m modoruko o tsu okpo le ta̱ maza.<verse eid="PRO 11:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 11:7" />Vuza gbani-gbani u tsu kuwa̱ ta̱ n kusheshe ku ni dem,</para>
  <para style="q2" vid="PRO 11:7">ka̱ta̱ a̱pa̱ a utsura a̱ ni ra̱ka̱ a̱ na̱mgba̱.<verse eid="PRO 11:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 11:8" />A̱ tsu utuka̱ ta̱ vuza vu usuɓi atakaci,</para>
  <para style="q2" vid="PRO 11:8">ka̱ta̱ a ɗa o bono u vuza gbani-gbani.<verse eid="PRO 11:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 11:9" />Aza gbani-gbani n una̱ u le u ɗa a tsu una a za le,</para>
  <para style="q2" vid="PRO 11:9">ama aza usuɓi a ubuta̱ u kuyeve ku le u ɗa a tsu laꞋaka.<verse eid="PRO 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 11:10" />Vuza vu usuɓi u laꞋaka ba ci, likuci i tsu i yaꞋan ta̱ ma̱za̱nga̱,</para>
  <para style="q2" vid="PRO 11:10">ɗa baci vuza gbani-gbani u kuwa̱i, uma a tsu yaꞋan ta̱ feu ma̱za̱nga̱.<verse eid="PRO 11:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 11:11" />Likuci i ci ciya̱ ta̱ tsugbayin adama una̱singai a uma usuɓi,</para>
  <para style="q2" vid="PRO 11:11">ama a tsu fa̱da̱ ta̱ likuci adama una̱ u uma a gbani-gbani.<verse eid="PRO 11:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 11:12" />Ukuna u tsulau u ɗa vu goyo toku nu,</para>
  <para style="q2" vid="PRO 11:12">vuza ugboji u tsu paɗa ta̱ bini.<verse eid="PRO 11:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 11:13" />Vuza kadanshi ka a̱bunda̱i n kula̱nga̱su u tsu sokongu kakuna ba.</para>
  <para style="q2" vid="PRO 11:13">Ama vuma vu usuɓi u su sokongu ta̱ ka kuna.<verse eid="PRO 11:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 11:14" />A ubuta̱ una wi babu vuza kelime, uduniya u tsu yikpa̱ ta̱,</para>
  <para style="q2" vid="PRO 11:14">ama ka̱bunda̱i ka aza kuneke odoki ka tsu tuka̱ ta̱ uduniya ida̱shi i ma̱ta̱na̱.<verse eid="PRO 11:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 11:15" />Ɗa baci vu ushuki ko okpo magan adama komoci vi ta̱ o ko kpo n wono,</para>
  <para style="q2" vid="PRO 11:15">ama vuzana u iwain wi ta̱ a kulaka.<verse eid="PRO 11:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 11:16" />Vuka vu usuɓi u su ciya̱ ta̱ tsugbayin,</para>
  <para style="q2" vid="PRO 11:16">ama aza asuvu a yali udukuyan u ɗa koci a ku ciya̱.<verse eid="PRO 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 11:17" />Vuma vu usuɓi u tsu ciya̱ ka̱ ta̱ ka̱cika̱ni u gaꞋin,</para>
  <para style="q2" vid="PRO 11:17">ama vuza gbani-gbani u tsu ronoko ta̱ ka̱cika̱ni atakaci.<verse eid="PRO 11:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 11:18" />Aza gbani-gbani a tsu ciya̱ ili i makara ba,</para>
  <para style="q2" vid="PRO 11:18">ama uma u usuɓi a tsu ciya̱ ta̱ uciyi u mayun.<verse eid="PRO 11:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 11:19" />Usuɓi usingai u tsu la̱nsa̱ka̱ ta̱ vuza wuma,</para>
  <para style="q2" vid="PRO 11:19">ama vuza na u dakaki kula̱nsa̱ ka gbani-gbani wi ta̱ a ku kuwa̱.<verse eid="PRO 11:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 11:20" />Vuzavaguɗu u tsu iwan ta̱ aza kusheshe ku gbani-gbani,<verse eid="PRO 11:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="PRO 11:21" />ama u tsu ka̱sukpa̱ ta̱ a aza usuɓi a laꞋaka.<verse eid="PRO 11:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22" />UgaꞋin u vuka dem wi baci n ka̱ɗu kasingai ba,</para>
  <para style="q2" vid="PRO 11:22">wi ta̱ tsu makawani ma azanari a vunu vu ma̱gurusunu.<verse eid="PRO 11:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 11:23" />Kusheshe ku uma usuɓi, kuɗa kasingai,</para>
  <para style="q2" vid="PRO 11:23">ama kusheshe ka̱ a̱ɗu ka aza a gbani-gbani ku ɗa wupa ayin tutu.<verse eid="PRO 11:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 11:24" />Aza o yoku a tsu neke ta̱ kuneꞋe ba̱ri, ka̱ta̱ tana uciyi u le u yimkpa,</para>
  <para style="q2" vid="PRO 11:24">ama aza o yoku a tsu neke vuza ko kenu ba, ama ka̱ta̱ okpo nu unambi.<verse eid="PRO 11:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 11:25" />Vuza na u tsu neke ba̱ri, u ku okpo ta̱ vuza vu uciyi,</para>
  <para style="q2" vid="PRO 11:25">ɓa̱nka̱ otoku a̱ nu, a vu feu i ta̱ a ku ɓa̱nka̱ wu.<verse eid="PRO 11:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 11:26" />Uma a tsu yaꞋanka ta̱ vuzana u sokongi ishina una̱,</para>
  <para style="q2" vid="PRO 11:26">ama una̱singai u ɗa u vuza na u dengei.<verse eid="PRO 11:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 11:27" />Vuza na u la̱nsa̱i ugaꞋin u tsu ciya̱ ta̱ kasingai,</para>
  <para style="q2" vid="PRO 11:27">ama vuza na u la̱nsa̱i una̱mgbi, wi ta̱ a kuciya̱ u ɗa.<verse eid="PRO 11:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28" />Vuza na dem u nekei ka̱ɗu wu udukuyan u ni wi ta̱ a ku yikpa̱,</para>
  <para style="q2" vid="PRO 11:28">ama vuza vu usuɓi wi ta̱ o kutopo uteku tsa a̱vuku a̱ ta̱ku a ka̱kina̱ ka mini.<verse eid="PRO 11:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 11:29" />Aza na a̱ tsu tuka̱ n atakaci a i kpaꞋa le, a u kotsushi utsu ciya̱ ili yi uka̱ni ba.</para>
  <para style="q2" vid="PRO 11:29">kpamu kalau ki ta̱ o ku okpo kagbashi ka vuza vu ugboji.<verse eid="PRO 11:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 11:30" />Usuɓi u neke ta̱ vuma wuma,</para>
  <para style="q2" vid="PRO 11:30">vuza na wi n ugboji, kpamu utsu isa ta̱ wuma.<verse eid="PRO 11:30" /></para>
  <para style="q2">
    <verse number="31" style="v" sid="PRO 11:31" />Ɗa baci aza usuɓi a̱ ciya̱i u peci u le aduniya,</para>
  <para style="q2" vid="PRO 11:31">ni ɗa tamkpamu wo ku okpo wa aza unushi u gbani-gbani.<verse eid="PRO 11:31" /></para>
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" sid="PRO 12" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 12:1" />Vuza na baci dem u cigai ugbari u ciga ta̱ kuyeve,</para>
  <para style="q2" vid="PRO 12:1">ama vuza na u iwain ugbari kalau ka.<verse eid="PRO 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 12:2" />Vuma vu usuɓi u tsu la̱nsa̱ ta̱ uɓa̱nki u Ka̱shile,</para>
  <para style="q2" vid="PRO 12:2">ama Ka̱shile ka tsu una ta̱ vuza vu kusheshe ku gbani-gbani.<verse eid="PRO 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 12:3" />Vuma u tsu ciya̱ katsura a ubuta̱ u ka gbani-gbani ba,</para>
  <para style="q2" vid="PRO 12:3">ama ma̱giti ma aza usuɓi ma ci shamgba ta̱ n utsura mayin.<verse eid="PRO 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4" />Vuka vu usuɓi ili i ma̱za̱nga̱ i ɗa u vali ni,</para>
  <para style="q2" vid="PRO 12:4">ama vuka vu na vu tsu neke vali ni wono, u tsu okpo ta̱ an ketele ku ushami i kyamba i ni.<verse eid="PRO 12:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 12:5" />Kusheshe ka aza usuɓi kusheshe ku mayun ku ɗa,</para>
  <para style="q2" vid="PRO 12:5">ama odoki aza a gbani-gbani modoruko ma koci.<verse eid="PRO 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 12:6" />Odoki a vuza gbani-gbani o tsu okpo ta̱ an maza,</para>
  <para style="q2" vid="PRO 12:6">ama kadanshi ka vuza vu usuɓi ka tsu tuka̱ le ta̱.<verse eid="PRO 12:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 12:7" />A tsu una ta̱ vuza gbani-gbani ra̱kura̱ka̱,</para>
  <para style="q2" vid="PRO 12:7">ama kpaꞋa ku vuza vu usuɓi ki ta̱ a ku shamgba n utsura mayin.<verse eid="PRO 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 12:8" />A tsu cikpa ta̱ vuma vu usuɓi adama ugboji u ni,</para>
  <para style="q2" vid="PRO 12:8">ama a tsu goyo ta̱ vuza ka̱ɗu ka a gbani-gbani.<verse eid="PRO 12:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 12:9" />U ku laꞋa ta̱ n kugaꞋan n unambi u nu, vi a̱ kula̱nsa̱ ili i kulya,</para>
  <para style="q2" vid="PRO 12:9">An va ku bonoko ka̱cika̱nu avu ili i yoku i ɗa.</para>
  <para style="q2" vid="PRO 12:9">tana ili i na va kulyaꞋa i laꞋa ta̱ utsura u nu.<verse eid="PRO 12:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 12:10" />Vuma vu usuɓi u tsu la̱na̱ ta̱ ma̱ta̱na̱ mi ilikuzuwa i ni,</para>
  <para style="q2" vid="PRO 12:10">ama vuza gbani-gbani ili i tsu bankai ba<verse eid="PRO 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 12:11" />Kacimbi kana kaci yaꞋan ulinga ka̱u,</para>
  <para style="q2" vid="PRO 12:11">utsu yaꞋan ta̱ n ilikulya ya a̱bunda̱i,</para>
  <para style="q2" vid="PRO 12:11">tsulau tsu a̱ la̱nga̱sa̱ makyan adama ulinga u gbani.<verse eid="PRO 12:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 12:12" />Vuma gbani-gbani kusheshe ku ni ku ɗa u yaꞋan ka gbani-gbani,</para>
  <para style="q2" vid="PRO 12:12">ama vuza usuɓi u tsu sheshe ta̱ ka singai.<verse eid="PRO 12:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 12:13" />Kadanshi ka vuza gbani-gbani ka tsu okpoi ta̱ maza,</para>
  <para style="q2" vid="PRO 12:13">ama vuza vu usuɓi u tsu utuka̱ ta̱ ka̱cika̱ni a̱ ka̱tsuma̱ ka atakaci.<verse eid="PRO 12:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 12:14" />Katsupu ka vuma dem ki ta̱ a ubuta̱ u kadanshi ka̱ni n ulinga u ni,</para>
  <para style="q2" vid="PRO 12:14">wi ta̱ a̱ kuciya̱ ili i na i gaꞋin ni.<verse eid="PRO 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 12:15" />Kalau ke ce ene ta̱ uye u wuma u ni derere ɗa,</para>
  <para style="q2" vid="PRO 12:15">ama vuza vu ugboji u tsu pana ta̱ odoki.<verse eid="PRO 12:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16" />Kalau ka tsu yotsongu ta̱ wupa u ni gogolo,</para>
  <para style="q2" vid="PRO 12:16">ama vuza vu ugboji u tsu keɓece koyoku ba.<verse eid="PRO 12:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 12:17" />Vuza na u tsu dansa kamayun wi ta̱ a kusala usuɓi,</para>
  <para style="q2" vid="PRO 12:17">ama kayaꞋin ka uwa ka tsu dansa ta̱ a uwa.<verse eid="PRO 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18" />Kadanshi kana a yaꞋin babu kusheshe,</para>
  <para style="q2" vid="PRO 12:18">ka tsu tuka̱ ta̱ n usa̱n tsu usapi u kotokobi,</para>
  <para style="q2" vid="PRO 12:18">ama kelentsu ka vuza vu ugboji ka tsu tuka̱ ta̱ n ma̱ta̱na̱.<verse eid="PRO 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 12:19" />Kamayun ki ta̱ a kugeshe a li a kubana u teku,</para>
  <para style="q2" vid="PRO 12:19">ama u kuna wa uwa gogolo u tsu kotso ta̱.<verse eid="PRO 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 12:20" />Ukuna wa uwa u ɗa u tsu shatangu ka̱ɗu ka aza gbani-gbani,</para>
  <para style="q2" vid="PRO 12:20">ama ukuna u ma̱za̱nga̱ u ɗa wa aza ana a tsu neke odoki a singai.<verse eid="PRO 12:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 12:21" />Ko ka gbani-gbani ka kuciya̱ vuza vu usuɓi ba,</para>
  <para style="q2" vid="PRO 12:21">ama atakaci a̱bunda̱i a ɗa a kuciya̱ vuza gbani-gbani.<verse eid="PRO 12:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 12:22" />Vuzavaguɗu u tsu iwan ta̱ vuza kadanshi ka a uwa,</para>
  <para style="q2" vid="PRO 12:22">ama u tsu pana ta̱ uyoꞋo wa aza a na a ci yaꞋan kamayun.<verse eid="PRO 12:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 12:23" />Vuza vu usuɓi u tsu sokongu ta̱ kuyeve ku ni,</para>
  <para style="q2" vid="PRO 12:23">ama kalau ka tsu utuka̱ ta̱ n tsulau tsu ni e keteshe.<verse eid="PRO 12:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 12:24" />Ulinga wa a wuya utsu neke ta̱ utsura,</para>
  <para style="q2" vid="PRO 12:24">ama tsurogo ci ta̱ a kuzuwa wu vu okpo ka gbashi.<verse eid="PRO 12:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 12:25" />Una̱mgbi u ka̱ɗu, u tsu sa̱nka̱ ta̱ vuma ma̱za̱nga̱,</para>
  <para style="q2" vid="PRO 12:25">ama kadanshi ko odoki ka tsu zuwa ta̱ wuma ma̱za̱nga̱.<verse eid="PRO 12:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 12:26" />Vuza vu usuɓi u tsu neke ta̱ ka̱ja̱Ꞌa̱ ka̱ ni odoki a singai,</para>
  <para style="q2" vid="PRO 12:26">ama ulinga u vuza gbani-gbani u tsu zuwa ta̱ u puwa̱nka̱.<verse eid="PRO 12:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 12:27" />Vi baci korogo, vi a̱ kuciya̱ ili i na vi a̱ kula̱nsa̱ ba,</para>
  <para style="q2" vid="PRO 12:27">ama vu yaꞋan baci ulinga ka̱u, vi ta̱ a̱ kuciya̱ udukuyan.<verse eid="PRO 12:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 12:28" />Ukuna wu usuɓi, uye u wuma u ɗa,</para>
  <para style="q2" vid="PRO 12:28">nwalu a̱ ka̱tsuma̱ ku u ɗa u tsu banka vuza ukpisa̱ ba.<verse eid="PRO 12:28" /></para>
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" sid="PRO 13" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 13:1" />Maku mu ugboji ma tsu isa ta̱ ugbari u Dada ni,</para>
  <para style="q2" vid="PRO 13:1">ama maku ma kugoyi ma tsu pana kadanshi ba.<verse eid="PRO 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 13:2" />Vuma vu usuɓi u ci lyaꞋa ta̱ ili a u tsura wu una̱ u ni,</para>
  <para style="q2" vid="PRO 13:2">ama vuma vu unambi wu usuɓi u tsu bonoko ta̱ a̱pa̱ a̱ ni a ubuta̱ u vishili.<verse eid="PRO 13:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3" />YaꞋan ci coꞋo n ili i na vi a kudansa, adama ana vu isa wuma u nu.</para>
  <para style="q2" vid="PRO 13:3">Vuma vu na u kpa̱ɗa̱i kuyaꞋan cicoꞋo n kadanshi ka̱ ni ba,</para>
  <para style="q2" vid="PRO 13:3">u tsu uka ta̱ ka̱cika̱ni muna.<verse eid="PRO 13:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 13:4" />Vuza vu ukpa̱ɗi u tsu ciga ta̱ udukuyan,</para>
  <para style="q2" vid="PRO 13:4">ama u ci ciya̱ ili i yoku ba.</para>
  <para style="q2" vid="PRO 13:4">ama kayaꞋin ku ulinga</para>
  <para style="q2" vid="PRO 13:4">ki ta̱ a kuciya̱ ili i na wi a kuciga ba̱ri.<verse eid="PRO 13:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 13:5" />Vuza vu usuɓi u tsu iwan ta̱ ukuna wa a uwa,</para>
  <para style="q2" vid="PRO 13:5">ama vuza gbani-gbani u tsu yaꞋan ta̱ ili i wono n i kugoyi.<verse eid="PRO 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 13:6" />Usuɓi u tsu ere ta̱ vuza vu babu unushi,</para>
  <para style="q2" vid="PRO 13:6">ama ka gbani-gbani ka tsu vakangu ta̱ vuza vu u nushi.<verse eid="PRO 13:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 13:7" />Vuza yoku utsu ɗika ta̱ ka̱cika̱ni vuza vu uciyi ɗa, kpamu tana wi n ili ba,</para>
  <para style="q2" vid="PRO 13:7">vuza yoku u ɗika ta̱ ka̱cika̱ni a̱yi vuza vu unambi ɗa,</para>
  <para style="q2" vid="PRO 13:7">kpamu tana a̱yi vuza vu uciyi ɗa ka̱u.<verse eid="PRO 13:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 13:8" />Uciyi u vuma wita̱ a kufuɗa ku isa wuma u ni,</para>
  <para style="q2" vid="PRO 13:8">ama vuza vu unambi babu vuza na u tsu gbandarasa yi.<verse eid="PRO 13:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 13:9" />Kutashi ka aza usuɓi ku tsu akana ta̱ ka̱u,</para>
  <para style="q2" vid="PRO 13:9">ama kutashi ka aza gbani-gbani u kimushi u ɗa u ci yaꞋan.<verse eid="PRO 13:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 13:10" />Ugbamukaci vishili vuɗa utsu tuka̱ koci,</para>
  <para style="q2" vid="PRO 13:10">ama a̱ tsu ciya̱ ta̱ ugboji ubuta̱ wa aza ana a tsu pana odoki.<verse eid="PRO 13:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 13:11" />Udukuyan u na a̱ ciya̱i n uye usingai ba, u tsu puwa̱nka̱ ta̱ gogoꞋo,</para>
  <para style="q2" vid="PRO 13:11">ama vuza na de dem u ɓolongi ikebe kenu kenu i tsu ka̱na̱ ta̱ kudokusu.<verse eid="PRO 13:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 13:12" />Ku zuwa ku ka̱ɗu kuna a takpai a kubana kelime ku tsu zuwa ta̱ ka̱ɗu ka̱ ka̱na̱ mɓa̱la̱.</para>
  <para style="q2" vid="PRO 13:12">ama mali mana a̱ ciwa̱ta̱ngi mita̱ tsu maɗanga ma wuma.<verse eid="PRO 13:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 13:13" />Vuza na baci de dem u goyoi odoki wita̱ a ku saꞋawa odoki a̱ni,</para>
  <para style="q2" vid="PRO 13:13">ama vuzana baci de dem u tonoi odoki a wita̱ a̱ kuciya̱ katsupu.<verse eid="PRO 13:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 13:14" />Kuyotsongu ku vuza vu ugboji, kuɗolu ku mini ma wuma ma a,</para>
  <para style="q2" vid="PRO 13:14">vuza na utsu bonoko vuma a ubuta̱ u maza mu ukpa̱.<verse eid="PRO 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 13:15" />Kuyeve ku singai kutsu tuka̱ ka̱ ta̱ mapasa ma singai,</para>
  <para style="q2" vid="PRO 13:15">ama uye wa a za gbani-gbani wi ta̱ n utsura.<verse eid="PRO 13:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 13:16" />Vuza vu ugboji u ci yeve ta̱ ili i na wi a kuyaꞋan,</para>
  <para style="q2" vid="PRO 13:16">ama kalau ka tsu yotsongu ta̱ tsulau cini e keteshe.<verse eid="PRO 13:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 13:17" />Kalingata ka gbani-gbani ka tsu uwa ta̱ atakaci,</para>
  <para style="q2" vid="PRO 13:17">ama kalingata ka mayun ka tsu tuka̱ ta̱ n ma̱ta̱na̱.<verse eid="PRO 13:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 13:18" />Vuza na baci de dem u iwain kushuku n odoki, u tsu okpo ta̱ n wono n unambi,</para>
  <para style="q2" vid="PRO 13:18">ama vuzana baci dem wu ushuki n odoki utsu ciya̱ ta̱ tsugbayin.<verse eid="PRO 13:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 13:19" />Ili i singai i ɗa vuma u ciya̱ ili i na u kuɓa̱nka̱ ka̱cika̱ni,</para>
  <para style="q2" vid="PRO 13:19">alau a tsu iwan ta̱ ku ka̱sukpa̱ ka gbani-gbani.<verse eid="PRO 13:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 13:20" />A̱ yi na wi nwalu koɓolo n aza ugboji</para>
  <para style="q2" vid="PRO 13:20">utsu doku ta̱ n ugboji,</para>
  <para style="q2" vid="PRO 13:20">ama ka̱ja̱Ꞌa̱ ka a lau wita̱ a kulyaꞋa kelime n ku na̱mgba̱.<verse eid="PRO 13:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 13:21" />Ka gbani-gbani ko tsu tono ta̱ aza unushi,</para>
  <para style="q2" vid="PRO 13:21">ama una̱singai u ɗa katsupu ka vuza vu usuɓi.<verse eid="PRO 13:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 13:22" />Vuma vu usuɓi wita̱ a̱ kuciya̱ udukuyan, ali u ka̱sukpa̱ka̱ ntsukaya n ni,</para>
  <para style="q2" vid="PRO 13:22">ama udukuyan wa aza unushi wita̱ o ku okpo wa aza usuɓi.<verse eid="PRO 13:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 13:23" />Kashina ka vuza vu unambi i ta̱ a kufuɗa kuneke ilikulya n a̱bunda̱i,</para>
  <para style="q2" vid="PRO 13:23">ama unambi u kamayun ka tsu pura̱ngu ta̱ uɗa ra̱ka̱.<verse eid="PRO 13:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 13:24" />A̱ yi na utsu gbara maku ma̱ ni ba, u ciga ma ba,</para>
  <para style="q2" vid="PRO 13:24">ama a̱yi na u cigai maku ma̱ ni u tsu gbara ta̱ maku ma̱ ni mayin.<verse eid="PRO 13:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 13:25" />Vuma vu usuɓi u tsu lyaꞋa ta̱ ilikulya ali u cuwa̱,</para>
  <para style="q2" vid="PRO 13:25">ama vuma gbani-gbani, n kambulu kaꞋa utsu yongo ayin tutu.<verse eid="PRO 13:25" /></para>
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" sid="PRO 14" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 14:1" />Vuka vu ugboji vu tsu maꞋa ta̱ kpaꞋa ku ni,</para>
  <para style="q2" vid="PRO 14:1">ama kalau ka tsu fa̱da̱ ta̱ kpaꞋa ku ni n ekiye a̱ ni.<verse eid="PRO 14:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 14:2" />Vuza na u tsu yaꞋan kamayun a̱ yi ɗa u tsu pana wovon u Ka̱shile,</para>
  <para style="q2" vid="PRO 14:2">ama a̱ yi vuza vu modoruko kugoyo ku ɗa u tsu goyoi.<verse eid="PRO 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 14:3" />Kadanshi ka kalau mashashau ma a kucina̱ ku ni,</para>
  <para style="q2" vid="PRO 14:3">ama kadanshi ka vuza vu ugboji ka tsu ere yi ta̱.<verse eid="PRO 14:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4" />Ubuta̱ u na wi babu anaka a vicimba, teɗai a̱ kuciya̱ ilikulyaꞋa?</para>
  <para style="q2" vid="PRO 14:4">Ama ubuta̱ u na wi n obomburon a vicimba, i ta̱ a̱ kuciya̱ ilikulya ya a̱bunda̱i.<verse eid="PRO 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 14:5" />Ngan n vuza vu usuɓi, mayun ɗa.</para>
  <para style="q2" vid="PRO 14:5">ama vuza vu ngan ma a uwa, u tsu ka̱ra̱ka̱ ta̱ n a uwa.<verse eid="PRO 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 14:6" />Vuza kugoyi u tsu la̱nsa̱ ta̱ ugboji ama u su ciya̱ ba,</para>
  <para style="q2" vid="PRO 14:6">ama kuyeve ki na atakaci u keyevi ba.<verse eid="PRO 14:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 14:7" />YaꞋan daꞋangi n kalau,</para>
  <para style="q2" vid="PRO 14:7">adama ana wi n ili i na wa ku yotsongu ba.<verse eid="PRO 14:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 14:8" />Ugboji u keyevi u ɗaɗa u yeve uye wa nwalu n ni,</para>
  <para style="q2" vid="PRO 14:8">ama tsulau tsu kalau tsu tsu vakangi ta̱.<verse eid="PRO 14:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 14:9" />Kalau ka tsu yaꞋan ta̱ ugulani n unushi,</para>
  <para style="q2" vid="PRO 14:9">ama vuza vu usuɓi n ka̱ɗu ka u tsu folono a cinukpa kai unushi.<verse eid="PRO 14:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 14:10" />Ka̱ɗu dem ke yeve ta̱ una̱mgbi u ka̱tsuma̱ u ni,</para>
  <para style="q2" vid="PRO 14:10">kpamu babu vuzana u kufuɗa ku yeve ma̱za̱nga̱ ma̱ ni.<verse eid="PRO 14:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 14:11" />KpaꞋa ku vuza gbani-gbani ki ta̱ a ku fa̱da̱,</para>
  <para style="q2" vid="PRO 14:11">ama kpaꞋa ku vuza vu usuɓi ki ta̱ o kutopo.<verse eid="PRO 14:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 14:12" />Ili i na vuma u sheshei ku dana i ɗa uye u singai,</para>
  <para style="q2" vid="PRO 14:12">wi ta̱ a kubanka yi ukpa̱.<verse eid="PRO 14:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 14:13" />Ko a ka̱tsuma̱ ki izoshi, gaꞋan ba una̱mgbi u ka̱tsuma̱ wi ta̱ punu.</para>
  <para style="q2" vid="PRO 14:13">ma̱za̱nga̱ ma laza baci, una̱mgbi u ka̱tsuma̱ wi ta̱ punu.<verse eid="PRO 14:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 14:14" />Vuma gbani-gbani a tsu tsupai ki ta̱ n ka gbani-gbani ka̱ ni,</para>
  <para style="q2" vid="PRO 14:14">vuza singai kpamu a tsu tsupai ki ta̱ n kasingai ka̱ ni.<verse eid="PRO 14:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 14:15" />Kalau ka tsu ushuku ta̱ n ili dem,</para>
  <para style="q2" vid="PRO 14:15">ama vuza vu ugboji u tsu indana ta̱ mayin kafu u yaꞋan ili i yoku.<verse eid="PRO 14:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 14:16" />Vuma vu ugboji, utsu pana ta̱ wovon u Ka̱shile,</para>
  <para style="q2" vid="PRO 14:16">ama kalau ka tsu yaꞋan ta̱ ili gogoꞋo babu cicoꞋo.<verse eid="PRO 14:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 14:17" />Vuza vu wupa u tsu yaꞋan ta̱ kakuna n tsulau,</para>
  <para style="q2" vid="PRO 14:17">ka̱ta̱ a iwan vuza kusheshe ku gbani-gbani.<verse eid="PRO 14:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 14:18" />Vuza vu unambi u kusheshe u tsu ciya̱ ta̱ ili u teku u tsulau u ni,</para>
  <para style="q2" vid="PRO 14:18">ama vuza vu usuɓi katsupu ka̱ni kuyeve ku ɗa.<verse eid="PRO 14:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 14:19" />Mayun vuza gbani-gbani wi ta̱ a̱ ku kuɗa̱ngu e kelime ka vuza vu usuɓi,</para>
  <para style="q2" vid="PRO 14:19">vuza ka gbani-gbani kpamu a utsutsu u vuza vu usuɓi.<verse eid="PRO 14:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 14:20" />Babu vuza na wi a kuciga vuza vu unambi,</para>
  <para style="q2" vid="PRO 14:20">ama vuza vu uciyi wi ta̱ n a̱ja̱Ꞌa̱ n a̱bunda̱i.<verse eid="PRO 14:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 14:21" />A̱yi vuzana u goyoi vutoku ni, u yaꞋan ta̱ unushi,</para>
  <para style="q2" vid="PRO 14:21">ama vuza vu una̱singai u ɗa vuzana u ɓa̱nka̱i vuza vu unambi.<verse eid="PRO 14:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 14:22" />Vuza na u tsu foɓuso ka gbani-gbani, uye u ɗa wi a̱ ku ka̱sukpa̱ ba?</para>
  <para style="q2" vid="PRO 14:22">Ama ucigi n usuɓi wi ta̱ o ku okpo u vuzana wi o kufoɓuso ili i singai.<verse eid="PRO 14:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 14:23" />YaꞋan ulinga vi ta̱ ili i wuma,</para>
  <para style="q2" vid="PRO 14:23">ama vu da̱sa̱ngu baci a kadanshi vi ta̱ o ku okpo vuza vu unambi.<verse eid="PRO 14:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 14:24" />Katsupu ka vuza vu ugboji udukuyan u ɗa,</para>
  <para style="q2" vid="PRO 14:24">ama katsupu ka kalau tsulau tsu ɗa.<verse eid="PRO 14:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 14:25" />Vuza kamayun u ciꞋisa ta̱ wuma,</para>
  <para style="q2" vid="PRO 14:25">ama ka yaꞋan ka uwa za modoruko ɗa.<verse eid="PRO 14:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 14:26" />A̱yi vuzana wi n wovon u u Vuzavaguɗu wi ta̱ a̱ kuciya̱ ida̱shi i ma̱ta̱na̱,</para>
  <para style="q2" vid="PRO 14:26">kpamu Vuzavaguɗu wi ta̱ o ku okpo ubuta̱ u kusheɗeku u muku n ni.<verse eid="PRO 14:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 14:27" />Wovon u Vuzavaguɗu u ɗaɗa ubuta̱ u wuma,</para>
  <para style="q2" vid="PRO 14:27">u ɗa u ku zuwa vuma u pasa maza mu u kpa̱.<verse eid="PRO 14:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 14:28" />Tsugbayin tsu mogono tsu ɗaɗa ka̱bunda̱i ka uma a na wi na a ɗa,</para>
  <para style="q2" vid="PRO 14:28">ama uma i lo baci ba, tsugono gbani ɗa.<verse eid="PRO 14:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 14:29" />Vuma na u tsu na̱mgba̱ ka̱tsuma̱ ba, wi ta̱ n kuyeve,</para>
  <para style="q2" vid="PRO 14:29">ama vuza vu una̱mgbi u ka̱tsuma̱ u tsu tuka̱ ta̱ tsulau tsu ni e keteshe.<verse eid="PRO 14:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 14:30" />Ka̱ɗu ki ida̱shi ka̱ tsu neke ta̱ wuma i kyamba,</para>
  <para style="q2" vid="PRO 14:30">ama cisheꞋe tsu tsu shamatangu ta̱ etele.<verse eid="PRO 14:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 14:31" />A̱yi vuza na u doroi vuza vu unambi, u goyo ta̱ Vuzavaguɗu,</para>
  <para style="q2" vid="PRO 14:31">ama vuza na baci de dem u ɓa̱nka̱i vuza vu unambi, u cikpa ta̱ Ka̱shile.<verse eid="PRO 14:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 14:32" />A za gbani-gbani, e le ɗa a tsu vakangu ka̱cikele n ka gbani-gbani ke le,</para>
  <para style="q2" vid="PRO 14:32">ama aza usuɓi a tsu ere ta̱ ka̱cikele n ka singai ke le.<verse eid="PRO 14:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 14:33" />Ugboji wi ta̱ ida̱shi u vuza kuyeve dem,</para>
  <para style="q2" vid="PRO 14:33">a li a̱ ka̱tsa̱ma̱ ka wuma u alau feu u tsu yotsongu ta̱ ka̱cika̱ni.<verse eid="PRO 14:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 14:34" />Usuɓi u tsu neke ta̱ uduniya tsugbayin,</para>
  <para style="q2" vid="PRO 14:34">ama u nushi u tsu neke ta̱ uduniya wono.<verse eid="PRO 14:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 14:35" />Mogono ma tsu pana ta̱ u yoꞋo u kagbashi ku ugboji,</para>
  <para style="q2" vid="PRO 14:35">ama wupa u ni wi ta̱ ubuta̱ u vuza na u tsu yaꞋan ili wono.<verse eid="PRO 14:35" /></para>
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" sid="PRO 15" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 15:1" />Wushuki u singai u tsu ta̱na̱ta̱ngu ta̱ ka̱ɗu,</para>
  <para style="q2" vid="PRO 15:1">ama kadanshi ku usuɗukpi ka tsu ɗa̱ngusa̱ ta̱ ka̱ɗu.<verse eid="PRO 15:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2" />Kelentsu ka vuza vu ugboji ke tsu neke ta̱ kuyeve,</para>
  <para style="q2" vid="PRO 15:2">ama una̱ u kalau u tsu tsuwa̱n tsulau.<verse eid="PRO 15:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3" />A̱shi a Vuzavaguɗu i ta̱ a ubuta̱ dem,</para>
  <para style="q2" vid="PRO 15:3">a kinda aza a singai n aza a gbani-gbani.<verse eid="PRO 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4" />Kelentsu kana ka̱ tsu dansa kasingai, ki ta̱ u teku tsu maɗanga ma wuma,</para>
  <para style="q2" vid="PRO 15:4">ama kelentsu ka a uwa ka tsu una ta̱ ayinviki asingai.<verse eid="PRO 15:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 15:5" />Kalau ka tsu goyo ta̱ ugbari u Dada ni,</para>
  <para style="q2" vid="PRO 15:5">ama vuzana dem u tsu zuwa atsuvu u pana odoki, vuza vu ugboji ɗa.<verse eid="PRO 15:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6" />KpaꞋa ka aza usuɓi ki ta̱ n uciyi wa̱ bunda̱i,</para>
  <para style="q2" vid="PRO 15:6">ama uciyi u vuza gbani-gbani u tsu tuka̱ le ta̱ n atakaci.<verse eid="PRO 15:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7" />Una̱u u vuza vu ugboji u tsu dansa ta̱ u kuna u kuyeve,</para>
  <para style="q2" vid="PRO 15:7">ama ka̱ɗu ka kalau ka tsu yaꞋan nanai ba.<verse eid="PRO 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8" />Vuzavaguɗu u tsu iwan ta̱ alyuka a vuza gbani-gbani.</para>
  <para style="q2" vid="PRO 15:8">Ama kavasa ka vuza singai ka tsu zuwai ta̱ ma̱za̱nga̱.<verse eid="PRO 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9" />Vuzavaguɗu u tsu iwan ta̱ uye u uma a gbani-gbani,</para>
  <para style="q2" vid="PRO 15:9">ama u ci ciga ta̱ aza na a tsuyaꞋan kasingai.<verse eid="PRO 15:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10" />Ɗa baci vu nusai, mayun ɗa a takacika wu,</para>
  <para style="q2" vid="PRO 15:10">a̱yi na u iwain kulapulu wita̱ a ku kuwa̱.<verse eid="PRO 15:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 15:11" />Ukpa̱ n munuka mi ta̱ a ubuta̱ u Ka̱shile,</para>
  <para style="q2" vid="PRO 15:11">teɗai tamkpamu a̱ɗu a uma a̱ lima̱.<verse eid="PRO 15:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12" />Vuza vu kugoyi u tsu ciga a dansukai ba,</para>
  <para style="q2" vid="PRO 15:12">u tsu bana u vuza vu ugboji ba.<verse eid="PRO 15:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13" />Ka̱ɗu ka̱ ma̱za̱nga̱ ka̱ tsu tuka̱ ta̱ n i meshe,</para>
  <para style="q2" vid="PRO 15:13">ama una̱mgbi u ka̱ɗu ka̱tsu una ta̱ ayinviki.<verse eid="PRO 15:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14" />Uma ugboji a tsu la̱nsa̱ ta̱ kuyeve,</para>
  <para style="q2" vid="PRO 15:14">ama ilikulyaꞋa i kalau i ɗa ɗa tsulau.<verse eid="PRO 15:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 15:15" />Wuma wa aza unambi ra̱ka̱ wi ta̱ tukpa n atakaci,</para>
  <para style="q2" vid="PRO 15:15">ama a̱ɗu aza ma̱za̱nga̱ a makyan dem ita̱ a̱ ka̱tsuma̱ ka kupana uyoꞋo.<verse eid="PRO 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16" />U lata̱ vu okpo n unambi n wovon u Vuzavaguɗu,</para>
  <para style="q2" vid="PRO 15:16">ana va kuciya̱ udukuyan wa̱ a̱bunda̱i koɓolo n atakaci.<verse eid="PRO 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17" />U lata̱ vu lyaꞋa tsuwaꞋa tsu babu mkpaɗi ucigi de wi baci lo,</para>
  <para style="q2" vid="PRO 15:17">ana va ku takuma i nyama i singai tsurala ci baci lo.<verse eid="PRO 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18" />Vuza vu usuɗukpi u ka̱ɗu u tsu ɗa̱ngusa̱ ta̱ vishili,<verse eid="PRO 15:18" /></para>
  <para style="q2">
    <verse number="19" style="v" sid="PRO 15:19" />Uye u vuza vu wonvoli tukpa ɗa u ɗa wi n awana,</para>
  <para style="q2" vid="PRO 15:19">ama uye u vuza vu usuɓi a̱ ka̱ɗu uba̱rukpi uɗa wi.<verse eid="PRO 15:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20" />Maku mu ugboji u tsu zuwa ta̱ esheku a̱ ni u pana uyoꞋo</para>
  <para style="q2" vid="PRO 15:20">ama kalau ka tsu goyo ta̱ a̱na̱ku ni.<verse eid="PRO 15:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21" />Tsulau ili i ma̱za̱nga̱ i kajarishi i ɗa,</para>
  <para style="q2" vid="PRO 15:21">ama vuza na wi n kuyeve u tsu yaꞋan ta̱ ili ni derere.<verse eid="PRO 15:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 15:22" />Ɗa baci odoki i lo ba, ka kuna ka tsu na̱mgba̱ ta̱</para>
  <para style="q2" vid="PRO 15:22">ama n odoki a̱bunda̱i, a tsu ciya̱ ta̱ u lyaꞋi.<verse eid="PRO 15:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23" />Yaba dem u tsu pana ta̱ uyoꞋo u wu ushuki u kadanshi kasingai,</para>
  <para style="q2" vid="PRO 15:23">ili singai i ɗa a yaꞋan kadanshi ka singai a ayin ana agaꞋin.<verse eid="PRO 15:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24" />Uma ugboji a tsu tono ta̱ uye u na u kubanka le ubuta̱ u wuma,</para>
  <para style="q2" vid="PRO 15:24">adama ana wu utuka̱ le a ubuta̱ wu ukpa̱.<verse eid="PRO 15:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25" />Vuzavaguɗu u tsu fa̱da̱ ta̱ kpaꞋa ku vuza vu ugbamukaci,</para>
  <para style="q2" vid="PRO 15:25">ama u tsu kanza ta̱ kureꞋe ku kagapa.<verse eid="PRO 15:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26" />Vuzavaguɗu u tsu iwan ta̱ kusheshe ku vuza gbani-gbani,</para>
  <para style="q2" vid="PRO 15:26">ama u tsu yaꞋan ta̱ ma̱za̱nga̱ n kadanshi ka a singai.<verse eid="PRO 15:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27" />Vuza kalyaꞋa, u tsu ronoko to kpaꞋa ku ni atakaci,</para>
  <para style="q2" vid="PRO 15:27">ama a̱yi vuza na u iwain kalyaꞋa wi ta̱ a kuyongo n wuma.<verse eid="PRO 15:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28" />Ka̱ɗu ka vuza vu usuɓi ka tsu sheshe ta̱ kafu kushuku kadanshi,</para>
  <para style="q2" vid="PRO 15:28">ama kelentsu ka vuza gbani-gbani ka tsu dansa ta̱ ka gbani-gbani.<verse eid="PRO 15:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 15:29" />Vuzavaguɗu u tsu yongo ta̱ daꞋangi n vuma gbani-gbani,</para>
  <para style="q2" vid="PRO 15:29">ama u tsu pana ta̱ kavasa ka vuma vu usuɓi.<verse eid="PRO 15:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 15:30" />Imeshi i tsu zuwa ta̱ vuma u yaꞋan ma̱za̱nga̱,</para>
  <para style="q2" vid="PRO 15:30">kpamu arabali a singai a tsu tuka̱ ta̱ n ma̱ta̱na̱ i kyamba.<verse eid="PRO 15:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31" />Vuza na dem u pana odoki a wuma,</para>
  <para style="q2" vid="PRO 15:31">wi ta̱ o kuyongo a̱ ka̱tsuma̱ ka aza ugboji.<verse eid="PRO 15:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32" />Vuza na dem u iwain ugbari, ka̱cika̱ni kaꞋa u goyoi,</para>
  <para style="q2" vid="PRO 15:32">ama vuza na baci de dem wu ushuki n kulapu, wi ta̱ a ku ciya̱ kuyeve.<verse eid="PRO 15:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33" />Wovon u Ka̱shile kuyotsongu su ku ugboji ku ɗa,</para>
  <para style="q2" vid="PRO 15:33">kpamu sai vu goyo ka̱cika̱nu, yeve ka̱ta̱ vu ciya̱ tsugbayin.<verse eid="PRO 15:33" /></para>
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1" />Kusheshe ku ka̱ɗu ku vuma ku ɗa,</para>
  <para style="q2" vid="PRO 16:1">ama ku ushuku,</para>
  <para style="q2" vid="PRO 16:1">ku Vuzavaguɗu ku ɗa.<verse eid="PRO 16:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2" />E kene ku vuma, ili i na u yaꞋin dem derere ɗa,</para>
  <para style="q2" vid="PRO 16:2">ama Vuzavaguɗu ɗa kashatangi.<verse eid="PRO 16:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3" />Zuwa ka Vuzavaguɗu ulinga u nu,</para>
  <para style="q2" vid="PRO 16:3">ofoɓuso a̱ nu tana i ta̱ a̱ kuciya̱ ulyaꞋi.<verse eid="PRO 16:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4" />Ili i na Vuzavaguɗu u yaꞋin dem derere ɗa,</para>
  <para style="q2" vid="PRO 16:4">ko vuza gbani-gbani adama a kanna ka atakaci.<verse eid="PRO 16:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5" />Vuzavaguɗu u tsu iwan ta̱ vuza na de dem wi n ugbamukaci</para>
  <para style="q2" vid="PRO 16:5">we a̱ ku ka̱sukpa̱ le a laꞋaka ubuta̱ wa atakaci ba.<verse eid="PRO 16:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6" />A ubuta̱ wu ucigi n kuyaꞋan kasingai, a tsu cinukpaka ta̱ vuma u nushi,</para>
  <para style="q2" vid="PRO 16:6">kpamu ubuta̱ wovon u Vuzavaguɗu,</para>
  <para style="q2" vid="PRO 16:6">vuma u tsu katsukpa ta̱ ka gbani-gbani.<verse eid="PRO 16:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7" />Makyan ma na vu yaꞋin ili i na Vuzavaguɗu wi a kuciga,</para>
  <para style="q2" vid="PRO 16:7">vi ta̱ a kufuɗa kubonoko irala i nu yo okpo a̱ja̱Ꞌa̱.<verse eid="PRO 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8" />U laꞋa ta̱ n kugan vu ciya̱ kenu a uye u singai,</para>
  <para style="q2" vid="PRO 16:8">ana va ku ɓolongu n a̱bunda̱i n uye u kalyaꞋa.<verse eid="PRO 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9" />Vuma u tsu sheshe ta̱ a̱ ka̱ɗu ka̱ ni,</para>
  <para style="q2" vid="PRO 16:9">ama Ka̱shile ka ka tsu shatangu.<verse eid="PRO 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10" />Kadanshi a una̱ u mogono ki ta̱ tsu a kaka a̱ Ka̱shile,</para>
  <para style="q2" vid="PRO 16:10">ayin dem u tsu kiɗa ta̱ a fada derere.<verse eid="PRO 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11" />Vuzavaguɗu u ciga ta̱ kagisamkpatsu ka singai,</para>
  <para style="q2" vid="PRO 16:11">ka̱ta̱ kpamu ka wina dem ko okpo derere.<verse eid="PRO 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 16:12" />Ngono n tsu iwan ta̱ ka gbani-gbani,</para>
  <para style="q2" vid="PRO 16:12">adama ana ka singai kaɗa ka tsu zuwa tsugono tsu tsurukpa.<verse eid="PRO 16:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13" />Mogono ma tsu pana ta̱ uyoꞋo u kadanshi ka singai,</para>
  <para style="q2" vid="PRO 16:13">u tsu ciga ta̱ aza kudansa kamayun ka̱u.<verse eid="PRO 16:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14" />Wupa u mogono u kutuka̱ n ukpa̱ u ɗa,</para>
  <para style="q2" vid="PRO 16:14">ama vuza na wi n ugboji u tsu yaꞋan ta̱ moloko mana u ta̱na̱ta̱ngu mogono ka̱ɗu.<verse eid="PRO 16:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15" />Kasingai ka mogono tsu keleshu kaꞋa kana ka tsu tuka̱ m mini ma gaɗi n lyushi,</para>
  <para style="q2" vid="PRO 16:15">wuma wi ta̱ punu.<verse eid="PRO 16:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16" />U laꞋa ta̱ kugaꞋan vu ciya̱ ugboji, ana va kuciya̱ kazanariya,</para>
  <para style="q2" vid="PRO 16:16">u laꞋa ta̱ n kugaꞋan vu zagba kuyeve ana vaku zagba azurufa.<verse eid="PRO 16:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17" />Uye u vuza vu usuɓi u tsu katsukpa ta̱ ka gbani-gbani,</para>
  <para style="q2" vid="PRO 16:17">vuzana u lapulai uye u ni, wuma u ni uɗa wi e ku ere.<verse eid="PRO 16:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18" />Ugbamukaci u tsu tuka̱ ta̱ n ukpa̱,</para>
  <para style="q2" vid="PRO 16:18">kugoyi kpamu ku tsu vakangu ta̱ vuza.<verse eid="PRO 16:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19" />U laꞋa ta̱ vo okpo vuza vu unambi vuza vu usuɓi,</para>
  <para style="q2" vid="PRO 16:19">ana va ku okpo a̱ ka̱tsuma̱ ka aza ugbamukaci, ali na vu ciya̱ ili a̱ ka̱tsuma̱ ke le.<verse eid="PRO 16:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20" />A̱yi na dem wu ushuki n odoki, wi ta̱ a ku laꞋa ka,</para>
  <para style="q2" vid="PRO 16:20">vuza vu una̱singai u ɗa a̱ yi na wu ushuki n Vuzavaguɗu.<verse eid="PRO 16:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21" />Vuza vu ugboji a tsu ɗekei ta̱ vuza kuyeve,</para>
  <para style="q2" vid="PRO 16:21">adama ana kadanshi ku uyoꞋo ka ɗaɗa uma a tsu laꞋa n ku ciga.<verse eid="PRO 16:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22" />Ugboji ka̱shi ka vuma ka a ubuta̱ wa aza ana i nu ɗa,</para>
  <para style="q2" vid="PRO 16:22">ama tsulau tsu tsu tuka̱ ta̱ alau n atakaci.<verse eid="PRO 16:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23" />Vuma vu ugboji u tsu sheshe ta̱ kafu u dansa,</para>
  <para style="q2" vid="PRO 16:23">ka̱ta̱ tana ka danshi ka̱ ni ka̱ ciya̱ wu ushuki.<verse eid="PRO 16:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24" />Kadanshi ku uyoꞋo ka tsu yaꞋan ta̱ an kabashi ki ishigi,</para>
  <para style="q2" vid="PRO 16:24">n uyoꞋo a̱ ka̱ɗu, a̱ ku tuka̱ n ma̱ta̱na̱ i kyamba.<verse eid="PRO 16:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25" />A kene ku vuma, wi ta̱ n uye u na u laꞋi n mayin,</para>
  <para style="q2" vid="PRO 16:25">ama a ukocishi, ukpa̱ u ɗa.<verse eid="PRO 16:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26" />Kambulu ka tsu zuwa ta̱ vuza zamalinga u dakaka u linga,</para>
  <para style="q2" vid="PRO 16:26">adama ana u ciga ta̱ u cuwa̱ta̱ngu ka̱cika̱ni.<verse eid="PRO 16:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27" />Vuma gbani-gbani u tsu sheshe ta̱ kuyaꞋan kagbani-gbani,</para>
  <para style="q2" vid="PRO 16:27">kadanshi ka̱ ni kpamu ka tsu ka̱na̱ ta̱ ku tasa a na akina.<verse eid="PRO 16:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28" />Vuza vu babu kamayun u tsu ɗa̱ngusa̱ ta̱ vishili,</para>
  <para style="q2" vid="PRO 16:28">vuza kuyun u tsu pece ta̱ a̱ja̱Ꞌa̱ ni ana i ɗeɗevu.<verse eid="PRO 16:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29" />Aza kavama, a tsu doro ta̱ a̱ za̱ ni,</para>
  <para style="q2" vid="PRO 16:29">a li u vakangi ubuta̱ u wa atakaci.<verse eid="PRO 16:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30" />A̱ yi na u tsu yaꞋan iyoci n a̱shi, modoruko maꞋa wi a kuciga kuyaꞋan,</para>
  <para style="q2" vid="PRO 16:30">vuza na u tsu yaꞋan iyoci n una̱ uni, ka gbani-gbani kaꞋa wi a kuciga ku yaꞋan.<verse eid="PRO 16:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31" />Ka̱nji ka̱ri, okokolo a tsugbayin a ɗa,</para>
  <para style="q2" vid="PRO 16:31">katsupu kaꞋa a wuma u vuza vu usuɓi.<verse eid="PRO 16:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32" />U lata̱ n kugaꞋan vu okpo vuza vu u ka̱ni u ka̱ɗu, ana va ku okpo vuza vu utsura,</para>
  <para style="q2" vid="PRO 16:32">u laꞋa ta̱ kpamu n kugaꞋan vu fuɗa ka̱cika̱ni, u laꞋa u likuci.<verse eid="PRO 16:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33" />Uma a tsuyaꞋan ta̱ kazagba adama ana e yeve i na i gaꞋin,</para>
  <para style="q2" vid="PRO 16:33">ama Vuzavaguɗu a̱ yi ɗa ka zagbi.<verse eid="PRO 16:33" /></para>
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" sid="PRO 17" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1" />U laꞋa ta̱ n kugaꞋan vu lyaꞋa tsuwa babu kusan n ka̱ɗu ida̱shi</para>
  <para style="q1" vid="PRO 17:1">an va kulyaꞋa tsuwa tsu ka̱ɗiva̱ a kpaꞋa ku vishili.<verse eid="PRO 17:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2" />Kagbashi ku ugboji, ki ta̱ a kulyaꞋa tsugono</para>
  <para style="q2" vid="PRO 17:2">a kpaꞋa ku maku ma na ma tsu tuka̱ n wono,</para>
  <para style="q2" vid="PRO 17:2">ali u ciya̱ upecu wi ili yi uka̱ni derere tsu vuza te punu a kpaꞋa ka.<verse eid="PRO 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 17:3" />Azanariya n azurufa n akina a tsu kondo le,</para>
  <para style="q2" vid="PRO 17:3">ta Vuzavaguɗu u tsu kondo ka̱ɗu nannai.<verse eid="PRO 17:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4" />Vuza gbani-gbani, u tsu zuwaka ta̱ atsuvu wi ili i gbani-gbani,</para>
  <para style="q2" vid="PRO 17:4">kayaꞋin ka uwa ka tsu bonoko ta̱ n asuvu a̱ ni u vuza na u tsu dansa u kuna u kavama.<verse eid="PRO 17:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5" />Vuza na baci de dem ugoyi vuza vu unambi, u shika ta̱ Ka̱shile ka na ka yaꞋin ni,</para>
  <para style="q2" vid="PRO 17:5">vuza na u yaꞋin ma̱za̱nga̱ adama una̱mgbi u vutoku wi a kulaka ubuta̱ wa atakaci ba.<verse eid="PRO 17:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6" />U gaꞋin wu nkoshi ntsukaya n ɗa,</para>
  <para style="q2" vid="PRO 17:6">ugaꞋin u muku kpamu i sheku i le i ɗa.<verse eid="PRO 17:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7" />Kadanshi kasingai ka tsu untsa n kalau ba,</para>
  <para style="q2" vid="PRO 17:7">ko tana a uwa untsa n vuza kelime.<verse eid="PRO 17:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8" />KalyaꞋa ki ta̱ an katali ki ili mereve a a̱shi a vuza na u nekei a ɗa,</para>
  <para style="q2" vid="PRO 17:8">ubuta̱ u na u kpatalai dem derere ɗa.<verse eid="PRO 17:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9" />Vuza na u cinukpai u nushi, ucigi u ɗa wi a kula̱nsa̱,</para>
  <para style="q2" vid="PRO 17:9">ama vuza na u tsu reme u nushi a̱ ka̱ɗu, u tsu pece ta̱ a̱ja̱Ꞌa̱ e ɗeɗevu.<verse eid="PRO 17:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10" />Uɓarangi u kute u yawa ta̱ vuza na wi n kuyeve u yeve</para>
  <para style="q2" vid="PRO 17:10">n ulapi u kalau amangatawun.<verse eid="PRO 17:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11" />Vuma gbani-gbani u tsu zuwa ta̱ kaci o kugoyi koci,</para>
  <para style="q2" vid="PRO 17:11">i ta̱ a ku suꞋuku yi n vuza unambi wa asuvu a yali ka̱ta̱ a lapai.<verse eid="PRO 17:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12" />U kulaꞋa ta̱ n ugaꞋin vuza u gasa m ma̱kunzukunzu vuza wupa,</para>
  <para style="q2" vid="PRO 17:12">vuza na e pecei ni n muku n ni,</para>
  <para style="q2" vid="PRO 17:12">an vuza wa ku gasa n kalau a̱ ka̱tsuma̱ ka tsulau tsu ni.<verse eid="PRO 17:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13" />Vuza na u tsupai kasingai n ka gbani-gbani,</para>
  <para style="q2" vid="PRO 17:13">ka gbanigbani ki a̱ ku ka̱sukpa̱ kpaꞋa ku ni ba.<verse eid="PRO 17:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14" />Ugiti u vishili, wi ta̱ an kuyene ku mini ku na ku peciki,</para>
  <para style="q2" vid="PRO 17:14">sai a shamkpa maꞋan ali babu ma lyaꞋa kelime.<verse eid="PRO 17:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15" />Vuza na wu utukai vuza vu unushi,</para>
  <para style="q2" vid="PRO 17:15">n vuza na u takacikai vuza vu usuɓi</para>
  <para style="q2" vid="PRO 17:15">dem vu le ili yu unata i ɗa u Vuzavaguɗu.<verse eid="PRO 17:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16" />Gbani ɗa a una ikebe adama ana a̱ la̱nsa̱ka̱ kalau kuyeve,</para>
  <para style="q2" vid="PRO 17:16">adama a na wo okpoi a̱ yi vuza vu usuɓi ɗa ba.<verse eid="PRO 17:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17" />Ka̱ja̱Ꞌa̱ ka tsu yaꞋan ta̱ ucigi ayin tutu,</para>
  <para style="q2" vid="PRO 17:17">vutoku kpamu adama a̱ ma̱ ɓa̱nka̱na̱i maꞋa a matsai ni.<verse eid="PRO 17:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18" />Vuza vu babu kusheshe ɗa koci,</para>
  <para style="q2" vid="PRO 17:18">u kuɗika a̱miki a kutan ku vutoku vu ni.<verse eid="PRO 17:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19" />A̱ yi na wi a kuciga unushi, vishili vu ɗa wi a kuciga,</para>
  <para style="q2" vid="PRO 17:19">A̱ yi na kpamu u maꞋin mashilya mu ugaɗi u ka̱ra̱i n a̱yi wi ta̱ a̱ kula̱nsa̱ ka̱ ka̱cika̱ni munuka.<verse eid="PRO 17:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 17:20" />Vuma vu ka̱ɗu ka gbani-gbani u ci ciya̱ kulya ku kelime ba,</para>
  <para style="q2" vid="PRO 17:20">vuza na de dem u tsu dansa a uwa u tsu uwa ta̱ atakaci.<verse eid="PRO 17:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21" />Ili ya atakaci ɗa vuma u matsa maku kalau,</para>
  <para style="q2" vid="PRO 17:21">dada vu kalau u tsu yongo n ma̱za̱nga̱ ba.<verse eid="PRO 17:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22" />Ka̱ɗu ka ma̱za̱nga̱, a̱guma̱ asingai ɗa,</para>
  <para style="q2" vid="PRO 17:22">ama ka̱ɗu ku una̱mgbuka̱tsuma̱ u tsu ɗekpetengu ta̱ vuma.<verse eid="PRO 17:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23" />Vuma gbani-gbani u ciꞋisa ta̱ kalya u sokongi</para>
  <para style="q2" vid="PRO 17:23">adama ana u sabasa afada a mayun.<verse eid="PRO 17:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24" />Vuza vu kuyeve, u tsu sheshe ta̱ ka kuna ku ugboji,</para>
  <para style="q2" vid="PRO 17:24">ama kalau ki ta̱ a kindi ku kavama.<verse eid="PRO 17:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25" />Kalau ka maku ili ya atakaci ɗa u dada ni,</para>
  <para style="q2" vid="PRO 17:25">ili yu una̱mgbuka̱tsuma̱ i ɗa kpamu u vuza na u matsai ni.<verse eid="PRO 17:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26" />Wi n ugaꞋin a yaꞋanka vuza vu babu unushi afada ba,</para>
  <para style="q2" vid="PRO 17:26">ko a faba vuzagbayin adama a kamayun ka̱ ni.<verse eid="PRO 17:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27" />Vuza na u tsu dansa ke nu, keyevi kaꞋa,</para>
  <para style="q2" vid="PRO 17:27">kpamu a̱yi na wi n ka̱ɗu ka̱ yuwu keyevi kaꞋa.<verse eid="PRO 17:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28" />Ko kalau feu u paɗa baci bini, a tsu ɗikai ta̱ vuza vu ugboji ɗa,</para>
  <para style="q2" vid="PRO 17:28">ɗa baci u paɗai bini udansai ka kuna ba,</para>
  <para style="q2" vid="PRO 17:28">uma i ta̱ a kuɗika yi keyevi.<verse eid="PRO 17:28" /></para>
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" sid="PRO 18" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 18:1" />Vuza na u tsuyaꞋan cija̱Ꞌa̱ ba,</para>
  <para style="q2" vid="PRO 18:1">utsu la̱nsa̱ ta̱ u ciya̱ kulyaꞋa ku kelime ku ni koci,</para>
  <para style="q2" vid="PRO 18:1">u tsu iwan ta̱ n odoki ana i a singai.<verse eid="PRO 18:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2" />Kalau ka tsu pana uyoꞋo u ciya̱ kuyeve ba,</para>
  <para style="q2" vid="PRO 18:2">ama u tsu pana ta̱ uyoꞋo u dansa kusheshe ku ni koci.<verse eid="PRO 18:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3" />Makyan mana ka gbani-gbani ka̱ ta̱wa̱i, kugoyi feu ki ta̱ ta̱wa̱,</para>
  <para style="q2" vid="PRO 18:3">koɓolo n unambi u kasingai, i ta̱ a̱ kuciya̱ kugoyi.<verse eid="PRO 18:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4" />Kadanshi ku una̱ u vuma, ki ta̱ n uga̱vi tsu mini,</para>
  <para style="q2" vid="PRO 18:4">ka̱shi ku ugboji tankpamu ki ta̱ uteku tsu kuɗolu ku mini mana mi e kuyene.<verse eid="PRO 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5" />U gaꞋan vu yaꞋanka vuma gbani-gbani kasingai,</para>
  <para style="q2" vid="PRO 18:5">ko vu sa̱nka̱ vuza vu babu unushi usuɓi ba.<verse eid="PRO 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6" />Kadanshi ka kalau ka tsu tuka̱ ta̱ n kunani,</para>
  <para style="q2" vid="PRO 18:6">una̱ u ni u tsu ronokoi ta̱ ulapi.<verse eid="PRO 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7" />Kadanshi ka kalau ka tsu unai ta̱,</para>
  <para style="q2" vid="PRO 18:7">una̱ u ni u tsu okpoi ta̱ maza.<verse eid="PRO 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8" />Kadanshi ka vuza kuyun, ki ta̱ tsu ilikulya yu uyoꞋo,</para>
  <para style="q2" vid="PRO 18:8">a kugida̱la̱ a ku uwa a i kyamba.<verse eid="PRO 18:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9" />Ka iwain ku ulinga,</para>
  <para style="q2" vid="PRO 18:9">ka̱ja̱Ꞌa̱ ka vuza kula̱nga̱su kaꞋa.<verse eid="PRO 18:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10" />Kula ku Vuzavaguɗu tsu mashilya mu utsura ma a,</para>
  <para style="q2" vid="PRO 18:10">vuma vu usuɓi u tsu suma ta̱ u uwa u da̱sa̱ngu n ma̱ta̱na̱.<verse eid="PRO 18:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11" />U vuza vu uciyi, udukuyan u ni tsu likuci yi nshilya n ɗa.</para>
  <para style="q2" vid="PRO 18:11">a kusheshe ku ni, udukuyan uni u ka̱ra̱Ꞌi tsu mashilya mu ugaɗi.<verse eid="PRO 18:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12" />Ugbamukaci u tsu vakangu ta̱ vuza,</para>
  <para style="q2" vid="PRO 18:12">ama uka̱ni u kaci u tsu tuka̱ ta̱ n ucikpi.<verse eid="PRO 18:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13" />Vuza na baci wu ushuki kadanshi babu u pana,</para>
  <para style="q2" vid="PRO 18:13">tsulau tsu ɗa n ili i wono i ni.<verse eid="PRO 18:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14" />Ayinviki ki a vuma i ta̱ a ku fuɗa kugbama a̱ suvu nu mɓa̱la̱,</para>
  <para style="q2" vid="PRO 18:14">ama vuma na ayinviki a̱ ni a takpai a̱pa̱, ka̱ ni ko kotso ta̱.<verse eid="PRO 18:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15" />Ka̱ɗu ka vuza ugboji ayin tutu ki ta̱ a̱ kula̱nsa̱ uye u kudoku kuyeve,</para>
  <para style="q2" vid="PRO 18:15">atsuvu a vuza vu ugboji a̱ tsu la̱nsa̱ ta̱ kuyeve ayin tutu.<verse eid="PRO 18:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16" />KuneꞋe ku tsu ɓa̱yuwa̱ ka̱ ta̱ utsutsu,</para>
  <para style="q2" vid="PRO 18:16">ali ku banka wu ubuta̱ u ku ene uma gbagbaꞋin.<verse eid="PRO 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17" />Vuzana u tuka̱i kadanshi ka̱ ni n ugiti, u tsu okpo ta̱ adanshi a̱ yi ɗa vuza kamayun,</para>
  <para style="q2" vid="PRO 18:17">sai ayin ana vuza yoku wu uta̱i u yaꞋankai ni kece biꞋi.<verse eid="PRO 18:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18" />Kazagba kaꞋa ka̱ tsu tuka̱ kananai uteku,</para>
  <para style="q2" vid="PRO 18:18">a̱yi ɗa u tsu pece a̱ ka̱tsuma̱ ka aza utsura.<verse eid="PRO 18:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19" />Ɓa̱nka̱ aza̱ nu ele tana i ta̱ a ku ere wu tsu mashilya mu utsura,</para>
  <para style="q2" vid="PRO 18:19">ama vu shilika̱ baci n ele, i ta̱ a ku ɓa̱ya̱ngu ku utsutsu.<verse eid="PRO 18:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20" />Adama a katsupu ka kadanshi ka̱nu,</para>
  <para style="q2" vid="PRO 18:20">tsu nanai tsu ɗa vi a̱ kuciya̱ wuma.<verse eid="PRO 18:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21" />Ukpa̱ n wuma wi ta̱ a utsura u kelentsu ka̱ nu,</para>
  <para style="q2" vid="PRO 18:21">aza ana a cigai kaꞋa i ta̱ a kulaꞋa uciyi u le.<verse eid="PRO 18:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22" />Vuza na u ciya̱i vuka, u ciya̱ ta̱ ili singai,</para>
  <para style="q2" vid="PRO 18:22">urotu wu uciyi mapasa ma singai maꞋan u Vuzavaguɗu.<verse eid="PRO 18:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23" />Vuza vu unambi u tsu yaꞋan ta̱ kadanshi n ka̱la̱ka̱tsu ka̱ kula̱nsa̱ asuvayali,</para>
  <para style="q2" vid="PRO 18:23">ama vuza vu uciyi u tsu neke ta̱ wu ushiki babu asuvayali.<verse eid="PRO 18:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24" />Cija̱Ꞌa̱ tsu yoku tsu tsu geshe ba,</para>
  <para style="q2" vid="PRO 18:24">ama cija̱Ꞌa̱ tsu yoku ci ta̱ n kamayun ali ka laꞋi ka̱ aza̱ nu.<verse eid="PRO 18:24" /></para>
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" sid="PRO 19" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 19:1" />U laꞋa ta̱ n kugaꞋan vuza vu unambi a̱ ka̱tsuma̱ ku unambi u ni n kamayun,</para>
  <para style="q2" vid="PRO 19:1">ana a kudana wo okpo ta̱ kalau vuza vu kadanshi ka a uwa.<verse eid="PRO 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2" />U gaꞋan vuma u yongo babu kuyeve ba,</para>
  <para style="q2" vid="PRO 19:2">ko kpamu vu okpo vuza na u tsu ci yaꞋan ili gogoꞋo vu la̱nga̱sa̱ uye.<verse eid="PRO 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3" />Ayin a na baci tsulau tsu vuma tsu vakangi vuma,</para>
  <para style="q2" vid="PRO 19:3">ka̱ta̱ ka̱ɗu ka̱ ni ka ka̱na̱ wupa n Vuzavaguɗu.<verse eid="PRO 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4" />Uciyi u tsu ɓolongu ta̱ a̱ja̱Ꞌa̱ n a̱bunda̱i,</para>
  <para style="q2" vid="PRO 19:4">ama ka̱ja̱Ꞌa̱ ka na vuza vu unambi wi n kaꞋa u tsu iwain ta̱.<verse eid="PRO 19:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5" />Vuza magaꞋan ma a uwa wi a ku saꞋwa ku laꞋaka a ubuta̱ wa atakaci ba,</para>
  <para style="q2" vid="PRO 19:5">ta feu kayaꞋin ka uwa nanai, a̱ yi feu wi a̱ ku ka̱sukpa̱ ba.<verse eid="PRO 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6" />Yaba dem u tsu la̱nsa̱ ta̱ mapasa ma singai a̱ ubuta̱ u vuza na u tsu neke ba̱ri,</para>
  <para style="q2" vid="PRO 19:6">yaba dem u ciga ta̱ wo okpo ka̱ja̱Ꞌa̱ ka vuza na u ci neke kuneꞋe ka̱u.<verse eid="PRO 19:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7" />Ɗa baci a̱ za̱ni a iwain ni adama unambi u ni,</para>
  <para style="q2" vid="PRO 19:7">ni ɗai tamkpamu vuma va u ku kotsoꞋo so n a̱ja̱Ꞌa̱ ni?</para>
  <para style="q1" vid="PRO 19:7">Ko ni ɗai baci u folonoi le, babu vuza na u kupana ka yi.<verse eid="PRO 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8" />A̱ yi vuzana u ciya̱i ugboji, wuma u ni u ɗa u cigai,</para>
  <para style="q2" vid="PRO 19:8">a̱ yi vuzana u we erei kuyeve kpamu wi ta̱ a̱ ku ba̱ruwa̱.<verse eid="PRO 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9" />MagaꞋan ma a uwa mi a ku laꞋaka a ubuta̱ wa atakaci ba,</para>
  <para style="q2" vid="PRO 19:9">ta feu nannai kayaꞋin ka a uwa ki ta̱ a̱ ku kuwa̱.<verse eid="PRO 19:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10" />U gaꞋan kalau ka yaꞋan ida̱shi ma̱za̱nga̱ ba,</para>
  <para style="q2" vid="PRO 19:10">nannai kpamu u laꞋa ta̱ n gbani-gbani kagbashi ka lyaꞋa tsugono wu ngono.<verse eid="PRO 19:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11" />Ugboji u vuma u tsu neke yi ta̱ uka̱ni u ka̱ɗu,</para>
  <para style="q2" vid="PRO 19:11">ucikpi u ni uɗa u cinukpa n unushi.<verse eid="PRO 19:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12" />Wupa u mogono wita̱ tsu yura̱ i kawu,</para>
  <para style="q2" vid="PRO 19:12">ama kasingai ka̱ ni ka̱ tsu tuka̱ ta̱ n una̱singai tsu ciza.<verse eid="PRO 19:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13" />Kalau ka maku ka tsu ronoko ta̱ dada vu ni atakaci,</para>
  <para style="q2" vid="PRO 19:13">vuka vu vishili vi ta̱ tsu uɗa̱kpi u mini.<verse eid="PRO 19:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14" />KpaꞋa n uciyi ili yi uka̱ni i ɗa a ubuta̱ wi isheku,</para>
  <para style="q2" vid="PRO 19:14">ama vuka vu ma̱riki a ubuta̱ u Vuzavaguɗu ɗa,<verse eid="PRO 19:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15" />Wonvoli u tsu zuwa ta̱ vuma alavu a̱bunda̱i,</para>
  <para style="q2" vid="PRO 19:15">vuza na u tsu iwan ulinga tamkpamu wita̱ a kutakacika.<verse eid="PRO 19:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16" />Vuza na u tsu ere kadanshi, wuma u ni u ɗa wi e ku ere,</para>
  <para style="q2" vid="PRO 19:16">ama vuza na u tsu kpa̱ɗa̱ ku zuka n uye u ni, wita̱ a̱ ku kuwa̱.<verse eid="PRO 19:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17" />Vuza na baci de dem u tsu yaꞋan kasingai u vuza vu unambi, Vuzavaguɗu ɗa wi e kuneke kutan,</para>
  <para style="q2" vid="PRO 19:17">wi ta̱ kpamu a̱ kuciya̱ katsupu a ili i na u yaꞋin.<verse eid="PRO 19:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18" />Gbara maku ma̱ nu, adama ana n tsu nannai uzuwi u ka̱ɗu wita̱ punu,</para>
  <para style="q2" vid="PRO 19:18">ka̱ ta̱ vu ɓa̱nka̱ una̱mgbi u ni ba.<verse eid="PRO 19:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19" />Vuza vu usuɗukpi u ka̱ɗu wi ta̱ a ku soꞋo atakaci,</para>
  <para style="q2" vid="PRO 19:19">ɗa baci vu utukai ni kute, sai vu doku kpamu vu utuka̱i.<verse eid="PRO 19:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20" />Zuwa atsuvu vu pana odoki, ka̱ta̱ vu isa kuyotsongusu,</para>
  <para style="q2" vid="PRO 19:20">adama ana kanna ko yoku vi ta̱ o ku okpo vuza vu ugboji.<verse eid="PRO 19:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21" />Kusheshe ku ka̱ɗu ku vuma ki ta̱ n a̱bunda̱i,</para>
  <para style="q2" vid="PRO 19:21">ama kusheshe ku Vuzavaguɗu ku ɗa koci ki a kushana.<verse eid="PRO 19:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22" />I na a cigai u vuma i ɗaɗa ucigi,</para>
  <para style="q2" vid="PRO 19:22">u laꞋa ta̱ n ku gaꞋan n vuza vu unambi an vuza na u tsu dansa a uwa.<verse eid="PRO 19:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23" />Wovon u Vuzavaguɗu u tsu neke ta̱ wuma,</para>
  <para style="q2" vid="PRO 19:23">ka̱ ta̱ tana vuza u ciya̱ ku uvuka,</para>
  <para style="q2" vid="PRO 19:23">babu ili i na i kuciya̱i.<verse eid="PRO 19:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24" />Kowonvoni ka tsu uka ta̱ kukiye a̱ mevene ma kusan,</para>
  <para style="q2" vid="PRO 19:24">ama wi a kufuɗa wa banka una̱ u ni ba.<verse eid="PRO 19:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25" />Gbara vuza kugoyi, vuza vu unambi u kusheshe wi ta̱ a kuyaꞋan ugboji,</para>
  <para style="q2" vid="PRO 19:25">dansuka keyevi, wita̱ o kudoku n kuyeve.<verse eid="PRO 19:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26" />Vuza na baci de dem u takacikai Dada ni ɗa kpamu u lokoi a̱na̱ku ni a kpaꞋa,</para>
  <para style="q2" vid="PRO 19:26">maku maꞋan mana ma tsu tuka̱ n wono n kugoyi.<verse eid="PRO 19:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27" />Maku ma̱va̱ ɗa baci vu ka̱sukpa̱i kupana kuyotsongusu,</para>
  <para style="q2" vid="PRO 19:27">vita̱ a kucinukpa n ili i na vu yevei ɗe.<verse eid="PRO 19:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28" />MagaꞋan ma a uwa u tsu yaꞋan ka ta̱ afada a mayun kavama,</para>
  <para style="q2" vid="PRO 19:28">vuma gbani-gbani u shatangu ta̱ una̱ u ni n kawuya ci ilikulya.<verse eid="PRO 19:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29" />A foɓuso ta̱ atakaci adama aza a kavama,</para>
  <para style="q2" vid="PRO 19:29">macaka kpamu adama a kalau.<verse eid="PRO 19:29" /></para>
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 20:1" />Ma̱kya̱n ili modoruko i ɗa, ili ku soꞋo yu utsura i tuka̱ n vishili i ɗa,</para>
  <para style="q2" vid="PRO 20:1">Yaba dem vu na ma vakangi wi nu ugboji ba.<verse eid="PRO 20:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2" />Usuɗukpi u wupa u mogono u tsu zuwa ta̱ kujeꞋe ke ki ikyamba, uteku tsu yura̱ i kawu,</para>
  <para style="q2" vid="PRO 20:2">yaba dem vu na u zuwai ni wupa wi ta̱ a ku kuwa̱.<verse eid="PRO 20:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3" />Ili i tsugbayin i ɗa vuma wu utuka̱ ka̱cika̱ni ubuta̱ u vishili.<verse eid="PRO 20:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4" />Vuza wonvoli u tsu cimba kashina n lyushi ba,</para>
  <para style="q2" vid="PRO 20:4">ka̱ta̱ ayin a vukyaꞋa a yawa baci wo okpo lekeɗi.<verse eid="PRO 20:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5" />Kusheshe ku ka̱ɗu ku vuma ki ta̱ an mini mu uga̱vi,</para>
  <para style="q2" vid="PRO 20:5">vuza na wi n kuyeve ɗa koci wi a kurono maꞋa.<verse eid="PRO 20:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6" />Uma n a̱bunda̱i a tsu sala ta̱ ukuna wu ucigi u le,</para>
  <para style="q2" vid="PRO 20:6">ama yayi wa kufuɗa kuciya̱ vuma vu usuɓi?<verse eid="PRO 20:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7" />Vuza usuɓi u ci yaꞋan ta̱ nwalu n singai,</para>
  <para style="q2" vid="PRO 20:7">aza una̱singai a ɗa muku n na mi a̱ kuta̱wa̱ n ka̱ca̱pa̱ ka̱ni.<verse eid="PRO 20:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8" />Mogono ma na mi ida̱shi a kakuba ka afada,</para>
  <para style="q2" vid="PRO 20:8">n a̱shi a̱ ni ɗa wi a̱ ku utuka̱ aza gbani-gbani ra̱ka̱.<verse eid="PRO 20:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9" />Ya yi wa kufuɗa wa dana, &lt;&lt;Mpa n ciɗatangu ta̱ ka̱ɗu ka̱va̱,</para>
  <para style="q2" vid="PRO 20:9">m buwa nu unushi u yoku ba&gt;&gt;?<verse eid="PRO 20:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10" />Kagisamkpatsu ka uwa n ka modoruko,</para>
  <para style="q2" vid="PRO 20:10">ra̱ka̱ vu le ili yu unata i ɗa u Vuzavaguɗu.<verse eid="PRO 20:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11" />A tsu yeve ta̱ muku n kenken a ubuta̱ wu ukuna wi ili i na u tsu yaꞋansa,</para>
  <para style="q2" vid="PRO 20:11">i ta̱ a kufuɗa kuyeve ko kuyongo ku le ku singai ku ɗa, ko ku mejege.<verse eid="PRO 20:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12" />Atsuvu adama a kupana, a̱shi kpamu adama e ku ene,</para>
  <para style="q2" vid="PRO 20:12">Vuzavaguɗu ɗa u yaꞋin le ra̱ka̱.<verse eid="PRO 20:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13" />Ka̱ta̱ vo okpo vuza va alavu ayin tutu ba, adama ana talo unambi wi a̱ ku ka̱na̱ wu.</para>
  <para style="q2" vid="PRO 20:13">ɓa̱yuwa̱ a̱shi a̱ nu, vi ta̱ a̱ kuciya̱ ilikulya ya a̱bunda̱i.<verse eid="PRO 20:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14" />&lt;&lt;Katsuli ka tsu dana ta̱ ili ya i gaꞋan ba, ko kenu,&gt;&gt;</para>
  <para style="q2" vid="PRO 20:14">ama makyan ma na baci u lazai, ka̱ ta̱ u yaꞋan a̱ra̱ɗi u dana u ciya̱ ta̱ ili i singai.<verse eid="PRO 20:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15" />Azanariya n atali a singai i ta̱ lo gbani,</para>
  <para style="q2" vid="PRO 20:15">ama una̱ u na u tsu dansa ka kuyeve, u laꞋa le ta̱ n ku gaꞋan ra̱ka̱.<verse eid="PRO 20:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16" />Isai motogu ma vuza na u shamgbai tsu magan mo komoci ka na kalyaꞋi kutan,</para>
  <para style="q2" vid="PRO 20:16">remei ucanuku u ni wo okpo magan adama o komoci ka.<verse eid="PRO 20:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17" />Ilikulya i na a̱ ciya̱i a uye wa a uwa yi ta̱ n uyoꞋo u kulya ka̱u,</para>
  <para style="q2" vid="PRO 20:17">ama a ukocishi wita̱ o ku okpo an kayala a una̱.<verse eid="PRO 20:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18" />N odoki a ɗa kakuna ka tsu gaꞋan,</para>
  <para style="q2" vid="PRO 20:18">la̱nsa̱ odoki a ugboji kafu vu bana kuvon.<verse eid="PRO 20:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19" />Vuza na u tsu ka̱ra̱Ꞌa̱ n udansai a uwa, u tsu palukpa ta̱ ili i na yi u sokongi,</para>
  <para style="q2" vid="PRO 20:19">adama nanai, yaꞋan dangi n vuza vu motonu ma̱ a̱bunda̱i.<verse eid="PRO 20:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20" />Ɗa baci vuza u shikai dada ni ko a̱na̱kpa̱ ni,</para>
  <para style="q2" vid="PRO 20:20">ma̱kuni ma̱ ni mi ta̱ a̱ ku kuwa̱ e mere ma ka̱yimbi.<verse eid="PRO 20:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21" />Ili yu uka̱ni i na a̱ ciya̱i gogoꞋo a ugiti,</para>
  <para style="q2" vid="PRO 20:21">wi o ku okpo wu una̱singai a ukocishi ba.<verse eid="PRO 20:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22" />Ka̱ta̱ vu dana, &lt;&lt;Mi ta̱ a kutsupa ka gbani-gbani,&gt;&gt;</para>
  <para style="q2" vid="PRO 20:22">Ama ka̱sukpa̱ Vuzavaguɗu, a̱ yi ɗa u ku wawa wu.<verse eid="PRO 20:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23" />Kagisamkpatsu ka a uwa ili yu unata i ɗa u Vuzavaguɗu,</para>
  <para style="q2" vid="PRO 20:23">kagisamkpatsu ka uwa ka gaꞋan ba.<verse eid="PRO 20:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24" />Nwalu n vuma dem, Vuzavaguɗu ɗa u foɓusoi,</para>
  <para style="q2" vid="PRO 20:24">ni ɗai vuma u kufuɗa kuyeve uye una wi o kutono?<verse eid="PRO 20:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 20:25" />Maza maꞋa u vuma u reme ili i yoku babu kusheshe</para>
  <para style="q2" vid="PRO 20:25">ka̱ta̱ n ka̱ca̱pa̱ kpamu u ciɓa n uzuwakpani u ni.<verse eid="PRO 20:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26" />Mogono mu ugboji ma tsu utuka̱ ta̱ uma a gbani-gbani,</para>
  <para style="q2" vid="PRO 20:26">ka̱ta̱ kpamu u takacika le babu asuvayali.<verse eid="PRO 20:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27" />Ayinviki a vuma kutashi ku ɗa ku Vuzavaguɗu,</para>
  <para style="q2" vid="PRO 20:27">u tsu la̱na̱ ta̱ ali a̱ ka̱ɗu ka̱ ni n kusheshe ku ni.<verse eid="PRO 20:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28" />Ucigi koɓolo n kamayun ka tsu kanza ta̱ mogono,</para>
  <para style="q2" vid="PRO 20:28">kakuba ko tsugono ka̱ ni ka shamgba a ubuta̱ wu ucigi.<verse eid="PRO 20:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29" />UgaꞋin wa a̱ɗa̱nga̱ni wi ta̱ a utsura u le,</para>
  <para style="q2" vid="PRO 20:29">ama ugaꞋin wu nkoshi tankpamu wu ɗa ɗa ka̱nji ka̱ri.<verse eid="PRO 20:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30" />Ulapi wu usuɗukpi u tsu utuka̱ ta̱ ka gbani-gbani,</para>
  <para style="q2" vid="PRO 20:30">u tsu ciɗatangu ta̱ ka̱ɗu n kusheshe ra̱ka̱.<verse eid="PRO 20:30" /></para>
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" sid="PRO 21" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 21:1" />Ka̱ɗu ko mogono ki ta̱ tsu mini mo kuɗolu</para>
  <para style="q2" vid="PRO 21:1">a kukiye ku Vuzavaguɗu,</para>
  <para style="q2" vid="PRO 21:1">Vuzavaguɗu tsu vadalukpai ta̱ ubuta̱ una wi a kuciga dem.<verse eid="PRO 21:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2" />Vuma wi ta̱ a kusheshe uye u ni mayin ɗa wi,</para>
  <para style="q2" vid="PRO 21:2">ama Vuzavaguɗu utsu gisanku ta̱ ka̱ɗu.<verse eid="PRO 21:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3" />KuyaꞋan kamayun n usuɓi,</para>
  <para style="q2" vid="PRO 21:3">u laꞋa ta̱ alyuka wishi ubuta̱ u Vuzavaguɗu.<verse eid="PRO 21:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4" />Ugbamukaci n a̱ra̱ɗi,</para>
  <para style="q2" vid="PRO 21:4">ɗaɗa ma̱kuni ma aza gbanigbani.</para>
  <para style="q2" vid="PRO 21:4">na lo va tana unushi uɗa.<verse eid="PRO 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5" />Kusheshe ku ma̱riki kpamu ku tsu neke ta̱ uciyi wa a̱bunda̱i,</para>
  <para style="q2" vid="PRO 21:5">ama vuza na u sheshe gogoꞋo u tsu okpo ta̱ n unambi.<verse eid="PRO 21:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6" />Uciyi u na uma a ciya̱i ubuta̱ wa elentsu a uwa,</para>
  <para style="q2" vid="PRO 21:6">u tsu kotso ta̱ an ka̱nga̱,</para>
  <para style="q2" vid="PRO 21:6">kpamu u tsu banka ta̱ vuma ubuta̱ wu ukpa̱.<verse eid="PRO 21:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7" />Unambi wu usuɓi wa a za gbanigbani wi ta̱ a ku pura̱ngu le u lazaka,</para>
  <para style="q2" vid="PRO 21:7">a dama na a iwain ta̱ kuyaꞋan ili i na yi i ma̱riki.<verse eid="PRO 21:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8" />Uye u vuza vu u nushi u tsu yongo ta̱ n o kondo,</para>
  <para style="q2" vid="PRO 21:8">ama ka̱ɗu ka vuza vu babu unushi ka ci yaꞋan ta̱ kamayun.<verse eid="PRO 21:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9" />U kulaꞋa ta̱ n kugaꞋan vu da̱sa̱ngu a kunu ku kenu pulai,</para>
  <para style="q2" vid="PRO 21:9">ana va kuda̱sa̱ngu asuvu a kpaꞋa ku gbayin n vuka vu vishili.<verse eid="PRO 21:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10" />Ka̱ɗu ka vuza gbanigbani ka ci sheshe ta̱ kuyaꞋan kagbanigbani,</para>
  <para style="q2" vid="PRO 21:10">u tsu pana asuvayali a vuza na i a ida̱shi ɗeɗevu ba.<verse eid="PRO 21:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11" />Makyan mana baci a takacikai aza a kugoyi,</para>
  <para style="q2" vid="PRO 21:11">vuza vu unambi u kusheshe feu u ci ciya̱ ta̱ ugboji.</para>
  <para style="q2" vid="PRO 21:11">makyan ma na a yaꞋankai vuza vu ugboji kadanshi,</para>
  <para style="q2" vid="PRO 21:11">utsu doku ta̱ n kuyeve.<verse eid="PRO 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12" />Ka̱shile, vuza vu usuɓi, u tsu zuwa ta̱ a̱shi a kpaꞋa ku vuza ka gbani-gbani,</para>
  <para style="q2" vid="PRO 21:12">utsu goyo ta̱ aza gbani-gbani ali a̱ na̱mgba̱.<verse eid="PRO 21:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13" />Vuma u kpanduku baci atsuvu a̱ ni adama a̱ ma̱shi ma vuza vu unambi,</para>
  <para style="q2" vid="PRO 21:13">a̱yi feu wita̱ a kuyaꞋan ma̱shi ma̱ kula̱nsa̱ uɓa̱nki,</para>
  <para style="q2" vid="PRO 21:13">ama wi tana feu a̱ kuciya̱ wushiki ba.<verse eid="PRO 21:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14" />KuneꞋe ku usokongi ku tsu loko ta̱ wupa,</para>
  <para style="q2" vid="PRO 21:14">kalya kpamu ka vaꞋanku ta̱ wupa u gbayin.<verse eid="PRO 21:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15" />Ukuna u ma̱za̱nga̱ uɗa u vuza vu usuɓi,</para>
  <para style="q2" vid="PRO 21:15">a yaꞋan afada a mayun,</para>
  <para style="q2" vid="PRO 21:15">ama u vuza gbani-gbani, ili yi una̱mgbi u ka̱tsuma̱ i ɗa.<verse eid="PRO 21:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16" />Vuma na u puwa̱nka̱i a ubuta̱ u cicoꞋo,</para>
  <para style="q2" vid="PRO 21:16">wi ta̱ a kuvuka o koɓolo ka a̱kpisa̱.<verse eid="PRO 21:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17" />Vuza na de dem u cigai kupana ku uyoꞋo, wi ta̱ o ku okpo vuza vu unambi,</para>
  <para style="q2" vid="PRO 21:17">vuza na de dem u cigai ma̱kya̱n n maniꞋin,</para>
  <para style="q2" vid="PRO 21:17">wi a ku saꞋawa ku okpo vuza vu udukuyan ba.<verse eid="PRO 21:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18" />A tsu takacika ta̱ vuza gbanigbani adama na isa vuza vu usuɓi,</para>
  <para style="q2" vid="PRO 21:18">vuza vu babu kamayun kpamu</para>
  <para style="q2" vid="PRO 21:18">adama ana isa vuza kamayun a̱ ka̱ɗu.<verse eid="PRO 21:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 21:19" />U lata̱ n kugaꞋan vu da̱sa̱ngu a ka kamba,</para>
  <para style="q2" vid="PRO 21:19">ana va kuda̱sa̱ngu n vuka vu wupa n vishili.<verse eid="PRO 21:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20" />A kpaꞋa ku vuza vu cicoꞋo ubuta̱ u kufoɓo ilikulya m mani ma singai u ɗa.</para>
  <para style="q2" vid="PRO 21:20">ama kalau ka tsu lyaꞋa ta̱ ili i ni i na wi n i ɗa ra̱ka̱.<verse eid="PRO 21:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21" />Ya ba dem vu na u la̱nsa̱i usuɓi koɓolo n ucigi,</para>
  <para style="q2" vid="PRO 21:21">u ci ciya̱ ta̱ wuma, n uciyi n tsugbayin.<verse eid="PRO 21:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22" />Vuza vu cicoꞋo vi te u tsu lyaꞋa ta̱ likuci i gbangam,</para>
  <para style="q2" vid="PRO 21:22">vuna a fuɗi o kuvon i a kpaꞋa ku ni,</para>
  <para style="q2" vid="PRO 21:22">ali u ɓoso mashilya mana i a kukeɗeke a̱pa̱.<verse eid="PRO 21:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23" />Vuza na de dem u ka̱na̱i una̱ u ni n kelentsu ka̱ ni,</para>
  <para style="q2" vid="PRO 21:23">u tsu ere ta̱ ka̱cika̱ni a ubuta̱ wa atakaci.<verse eid="PRO 21:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24" />Vuza vu ugbamukaci n vuza va a̱ra̱ɗi,</para>
  <para style="q2" vid="PRO 21:24">vuza ku kugoyi ɗa kula kuni,</para>
  <para style="q2" vid="PRO 21:24">u tsuyaꞋan ta̱ ili n kugoyi n a̱ra̱ɗi.<verse eid="PRO 21:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25" />Mali ma vuza wono mi ta̱ o ku okpo ukpa̱ uni,</para>
  <para style="q2" vid="PRO 21:25">adama ana ekiye a̱ ni a iwan ta̱ ku yaꞋan u linga.<verse eid="PRO 21:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26" />Kanna lakam uma a gbanigbani a tsu dakaka ta̱ adama a na a yaꞋan modoruko,</para>
  <para style="q2" vid="PRO 21:26">ama vuza vu usuɓi u tsu dakaka ta̱ adama na u neke ba̱ri.<verse eid="PRO 21:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27" />Alyuka a vuza gbanigbani ili yu unata i ɗa,</para>
  <para style="q2" vid="PRO 21:27">be le kuneꞋe ku na a̱ tuka̱i n kusheshe ku gbanigbani.<verse eid="PRO 21:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28" />MagaꞋan ma uwa mita̱ a ku takacika,</para>
  <para style="q2" vid="PRO 21:28">ama i ta̱ a ku ɗesukpa̱ vuza na u tsu dansa kasingai.<verse eid="PRO 21:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29" />Uma a gbanigbani a tsu ɗika ta̱ ka̱cika̱le e yeve ta̱ ili ra̱ka̱,</para>
  <para style="q2" vid="PRO 21:29">ama a za usuɓi a tsu sheshe ta̱ u kuna wi na a kuyaꞋan.<verse eid="PRO 21:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30" />Babu ugboji, ko kuyeve, ko odoki</para>
  <para style="q2" vid="PRO 21:30">a na a kulaꞋa Ka̱shile.<verse eid="PRO 21:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31" />A tsu foɓo so ta̱ ko odoku adama a kanna ka kuvon,</para>
  <para style="q2" vid="PRO 21:31">ama ulyai u Ka̱shile u ɗa.<verse eid="PRO 21:31" /></para>
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" sid="PRO 22" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 22:1" />Kula ku usingai ku laꞋa ta̱ udukuyan wa a̱bunda̱i,</para>
  <para style="q2" vid="PRO 22:1">mapasa ma singai ma laꞋa ta̱ uciyi wa azurufa n wa azanariya.<verse eid="PRO 22:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2" />Vuza vu uciyi n vuza vu unambi ili i te i ɗa,</para>
  <para style="q2" vid="PRO 22:2">adama a na Ka̱shile kaꞋa ka yaꞋin le dem.<verse eid="PRO 22:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3" />Vuza vu usuɓi u ce ene ta̱ kawuya ka̱ta̱ u sheɗeku,</para>
  <para style="q2" vid="PRO 22:3">ama kalau ka tsu uka ta̱ ka̱ci ka̱ ni ka̱ta̱ ta na u takacika.<verse eid="PRO 22:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4" />U ka̱ni u kaci n wovon u Ka̱shile,</para>
  <para style="q2" vid="PRO 22:4">udukuyan u ɗa n tsugbayin n wuma.<verse eid="PRO 22:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5" />Awana n maza i ta̱ uye wa aza a gbani-gbani,</para>
  <para style="q2" vid="PRO 22:5">vuza na dem u foɓusoi ka̱ɗu ka̱ ni wi ta̱ a ku yaꞋan daꞋangi n a̱ le.<verse eid="PRO 22:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6" />Yotsongu maku uye u na wa ku tono,</para>
  <para style="q2" vid="PRO 22:6">ko u kutsa ba ci wi a kucinukpa nu ɗa ba.<verse eid="PRO 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7" />Vuza vu uciyi u tsu lyaꞋaka ta̱ vuza vu unambi tsugono,</para>
  <para style="q2" vid="PRO 22:7">vuza kutan kpamu kagbashi kaꞋa e kiye a ka nekei.<verse eid="PRO 22:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8" />Ya ba dem vu na uca̱Ꞌi ka agbanigbani, wi ta̱ ku kyaꞋa kagbanigbani,</para>
  <para style="q2" vid="PRO 22:8">kpamu kalangu ka modoruko ka ni ki ta̱ o ku koɗo.<verse eid="PRO 22:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9" />Ya ba dem na u tsu neke ba̱ri wita̱ a ku ciya̱ una̱singai,</para>
  <para style="q2" vid="PRO 22:9">adama ana ilikulya i ni i ɗa u tsu pece ke aza unambi.<verse eid="PRO 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10" />Utuka̱ vuza kugoyi, yeve ka̱ta̱ vishili vu kotso,</para>
  <para style="q2" vid="PRO 22:10">ka̱ta̱ vishili n ishikushi i kotso.<verse eid="PRO 22:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11" />A̱yi na u tsuyaꞋan kasingai ka̱ta̱ u dansa mayin,</para>
  <para style="q2" vid="PRO 22:11">wita̱ o ku okpo ka̱ja̱Ꞌa̱ ko mogono.<verse eid="PRO 22:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12" />A̱shi a̱ Ka̱shile i ta̱ a kinda kuyeve,</para>
  <para style="q2" vid="PRO 22:12">ama u tsu taɗuku ta̱ kadanshi ka gbanigbani.<verse eid="PRO 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13" />Korogo ka tsu dana ta̱, &lt;&lt;Kawu wita̱ lo pulai.</para>
  <para style="q2" vid="PRO 22:13">muꞋuta̱ baci wita̱ a ku una mu uye.&gt;&gt;<verse eid="PRO 22:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14" />Una̱ u kashakanlai kpenle ku uga̱vi ku ɗa,</para>
  <para style="q2" vid="PRO 22:14">vuza na Ka̱shile ki a wupa n a̱yi wita̱ a ku yikpa̱ a ku ɗa.<verse eid="PRO 22:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15" />Tsulau cita̱ ugbaɓurangi n ka̱ɗu ka maku,</para>
  <para style="q2" vid="PRO 22:15">ama mashashau mu ugbari mi ta̱ o ku lokoi u ɗa.<verse eid="PRO 22:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16" />Vuza na de dem u takacikai vuza vu unambi adama ana u doku udukuyan u ni,</para>
  <para style="q2" vid="PRO 22:16">ko kpamu u nekei vuza vu udukuyan ili, wi ta̱ a ku okpo n unambi.<verse eid="PRO 22:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 22:17" />Zuwa atsuvu vu pana kadanshi ka vuza vu ugboji,</para>
  <para style="q2" vid="PRO 22:17">ka̱ta̱ vu yaꞋan cicoꞋo a̱ ka̱ɗu ka̱ nu,<verse eid="PRO 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18" />adama ana, wita̱ a kugaꞋan, ɗa baci vu zuwai le a̱ nu,</para>
  <para style="q2" vid="PRO 22:18">ɗa dem vu le a̱ ciya̱i ida̱shi una̱ u nu.<verse eid="PRO 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19" />Adama ana kamayun ka̱ nu ko yongo u Vuzavaguɗu,</para>
  <para style="q2" vid="PRO 22:19">n yotsongu wu ta̱ e le anana.<verse eid="PRO 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20" />Kadanshi ka kamangankupa kaꞋa na kana n ɗana kai nu,</para>
  <para style="q2" vid="PRO 22:20">kadanshi ko odoki n kuyeve ba,<verse eid="PRO 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21" />adama ana n yotsongu wu ili i na yi kamayun,</para>
  <para style="q2" vid="PRO 22:21">adama ana vu neke wushuki u mayun.<verse eid="PRO 22:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22" />Ka̱ta̱ vu ya̱nsa̱ vuza vu unambi, adama ana wi nu unambi ba,</para>
  <para style="q2" vid="PRO 22:22">ko kpamu vu doro aza unambi ubuta̱ wa afada,<verse eid="PRO 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23" />adama ana Vuzavaguɗu u tsu shamgba ta̱ adama e le,</para>
  <para style="q2" vid="PRO 22:23">ka̱ta̱ wu una wuma u vuza na u ya̱nsa̱i le.<verse eid="PRO 22:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24" />Ka̱ta̱ vu yaꞋan cija̱Ꞌa̱ n vuza wupa ba,</para>
  <para style="q2" vid="PRO 22:24">ka̱ta̱ vu gbaɓa ka̱cika̱nu n ka yaꞋin ka̱ vishili ba,<verse eid="PRO 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25" />Talo va tono uye u ni</para>
  <para style="q2" vid="PRO 22:25">ka̱ta̱ vu uka ka̱cika̱nu a maza.<verse eid="PRO 22:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26" />Ka̱ta̱ vu ushuku ku tsupa ka vuza kutan ba,</para>
  <para style="q2" vid="PRO 22:26">ko kpamu vu okpo magan adama vuza kutan ba,<verse eid="PRO 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27" />adama ana ɗa baci vi n ili i na vu kutsupaka ba,</para>
  <para style="q2" vid="PRO 22:27">i ta̱ a ku ɗika kajiba ki ivaꞋin ka nu a laza ka.<verse eid="PRO 22:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28" />Ka̱ta̱ vu takpa katali ka kureꞋe ka aza a cau,</para>
  <para style="q2" vid="PRO 22:28">kana ikaya i nu i shikpa̱i ba.<verse eid="PRO 22:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29" />Vu tsu e ene ta̱ kafuɗi ku ulinga ubuta̱ wu ulinga u ni?</para>
  <para style="q2" vid="PRO 22:29">U tsu shamgba ta̱ e kelime ko ngono,</para>
  <para style="q2" vid="PRO 22:29">ama wa ku shamgba u yaꞋanka aza ana e yevei ni ulinga ba.<verse eid="PRO 22:29" /></para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" sid="PRO 23" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 23:1" />Ɗa baci vu da̱sa̱ngi kulyaꞋa ilikulya n mogono,</para>
  <para style="q2" vid="PRO 23:1">la̱na̱ ka̱ta̱ vindana mayin i na yi e kelime ka̱ nu.<verse eid="PRO 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2" />Avu vuza kalya ɗa baci,</para>
  <para style="q2" vid="PRO 23:2">to, reme ka̱cika̱nu,<verse eid="PRO 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3" />Ka̱ta̱ vu yaꞋan mali mi ilikulya i ni ba,</para>
  <para style="q2" vid="PRO 23:3">adama ana i ɗaɗa cico tsu nu ba.<verse eid="PRO 23:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4" />Ka̱ta̱ vu takacika ka̱cika̱nu adama a kula̱nsa̱ udukuyan ba,</para>
  <para style="q2" vid="PRO 23:4">gbojo ko ka̱cika̱nu adama ana vu suma kaꞋa,<verse eid="PRO 23:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="PRO 23:5" />adama ana, ayin ana baci de dem vu la̱na̱i u ɗa wi ta̱ o ku kotso,</para>
  <para style="q2" vid="PRO 23:5">adama ana sawu ɗa o tsu topo evelyu,</para>
  <para style="q2" vid="PRO 23:5">a tsu imkpi tsu shafu gaɗi a Ka̱shile.<verse eid="PRO 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6" />Ka̱ta̱ vulya ilikulya i vuza vu ulyopi ba,</para>
  <para style="q2" vid="PRO 23:6">ka̱ta̱ vu yaꞋan mali mi ilikulya yu uyoꞋo i ni ba,<verse eid="PRO 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7" />adama na a̱yi vuza cico ci na wa kuna ɗa.</para>
  <para style="q2" vid="PRO 23:7">Ka̱ta̱ u dana&lt;&lt;LyaꞋi n i soꞋi.&gt;&gt;Ama ka̱ɗu ka̱ ni ki lo koɓolo n a̱ɗa̱ ba.<verse eid="PRO 23:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8" />Vi ta̱ a kushama i kenu i na vu lyaꞋi va,</para>
  <para style="q2" vid="PRO 23:8">ka̱ta̱ vu la̱nga̱sa̱ kadanshi ka singai ka̱ nu.<verse eid="PRO 23:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9" />Ka̱ta̱ vu yaꞋan kadanshi atsuvu a kalau ba,</para>
  <para style="q2" vid="PRO 23:9">adama na wita̱ a kugoyo ugboji u kadanshi ka̱ nu.<verse eid="PRO 23:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10" />Ka̱ta̱ vu muɗa̱ urotu u kureꞋe wi iɗika u tsumani ba</para>
  <para style="q2" vid="PRO 23:10">ko kpamu vu pasa visa ashina a mkpan ba,<verse eid="PRO 23:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 23:11" />adama ana kishi ke le, vuza vu utsura ɗa,</para>
  <para style="q2" vid="PRO 23:11">wita̱ a ku shamgba adama e le ka̱ta̱ u shilika̱ n na vu.<verse eid="PRO 23:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12" />Zuwa asuvu, ka̱ta̱ vu pana kuyotsongu,</para>
  <para style="q2" vid="PRO 23:12">vu zuwa atsuvu a̱ nu kpamu ubuta̱ u kadanshi ku ugboji.<verse eid="PRO 23:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13" />Ka̱ta̱ vu ka̱sukpa̱ ku gbara maku ba,</para>
  <para style="q2" vid="PRO 23:13">adama na ko niniɗai baci vu lapai ni wi a ku kuwa̱ ba.<verse eid="PRO 23:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14" />Adama na ɗa baci vu lapai ni n kafabatsu,</para>
  <para style="q2" vid="PRO 23:14">vu ɓa̱nka̱ ta̱ wuma u ni ubuta̱ wa atakaci a munuka.<verse eid="PRO 23:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15" />Maku ma̱va̱, ɗa baci vu gbojoi,</para>
  <para style="q2" vid="PRO 23:15">ka̱ɗu ka̱va̱ feu ki ta̱ o ku yokpo.<verse eid="PRO 23:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16" />Wuma u va̱ u kuyaꞋan ta̱ ma̱za̱nga̱,</para>
  <para style="q2" vid="PRO 23:16">ɗa baci una̱u nu udanshi kasingai.<verse eid="PRO 23:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17" />Ka̱ta̱ vu yaꞋan tsurala tsu vuza vu unushi ba,</para>
  <para style="q2" vid="PRO 23:17">ama ayin tutu vu yongo n tsurala tsu wovon u Ka̱shile.<verse eid="PRO 23:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18" />Ɗa baci vu yaꞋan nanai, vi ta̱ a ku yaꞋan ma̱za̱nga̱ a ayin a kelime,</para>
  <para style="q2" vid="PRO 23:18">kpamu Ka̱shile ki ta̱ a ku yaꞋan kawu i na vu cigai u yaꞋan ka wu.<verse eid="PRO 23:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19" />Maku ma̱va̱, zuwa atsuvu mayin vu pana adama na vu ciya̱ ugboji,</para>
  <para style="q2" vid="PRO 23:19">ka̱ta̱ vu zuwa ka̱ɗu ka nu uye u singai.<verse eid="PRO 23:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20" />Ka̱ta̱ vu gbaɓa ka̱cika̱nu n osoꞋi ba,</para>
  <para style="q2" vid="PRO 23:20">ko kpamu aza kalya ba,<verse eid="PRO 23:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21" />adama na osoꞋi koɓolo n aza kalya a i ta̱ o kokpo aza unambi,</para>
  <para style="q2" vid="PRO 23:21">ka̱ta̱ agbaɗiki a pala le n akashi.<verse eid="PRO 23:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22" />Pana kadanshi ka eshevu a̱ yi na u neke nu wuma,</para>
  <para style="q2" vid="PRO 23:22">kpamu ka̱ta̱ vu goyo a̱na̱ku a̱ nu a ayin a na u kuci ba.<verse eid="PRO 23:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23" />Tsula kamayun ka̱ ta̱ vu denge ba,</para>
  <para style="q2" vid="PRO 23:23">ka̱ta̱ kpamu vu ciya̱ ugboji n ugbari n kuyeve.<verse eid="PRO 23:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24" />Muku mu usuɓi n tsu zuwa ta̱ i sheku e le ma̱za̱nga̱.<verse eid="PRO 23:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25" />YaꞋan i na dada nu n a̱na̱kpa̱ nu a kuyaꞋan ma̱za̱nga̱,</para>
  <para style="q2" vid="PRO 23:25">ka̱ta̱ kpamu vu ka̱sukpa̱ a̱na̱kpa̱ nu a na a maci nu feu a yaꞋan ma̱za̱nga̱.<verse eid="PRO 23:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26" />Maku ma̱ va̱, neke mu ka̱ɗu ka̱ nu,</para>
  <para style="q2" vid="PRO 23:26">ka̱ta̱ vu ka̱sukpa̱ a̱shi a̱ nu o tono uye u va̱.<verse eid="PRO 23:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27" />Adama ana kashakanlai kpenle ku ɗa ku uga̱vi,</para>
  <para style="q2" vid="PRO 23:27">vuka vu vuza kpamu uye wa atakaci u ɗa.<verse eid="PRO 23:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28" />U tsu vaku ta̱ a ku vana an vuza maga̱lka̱,</para>
  <para style="q2" vid="PRO 23:28">ka̱ta̱ u ka̱na̱ ku doku ka̱bunda̱i ka aza tsugbani.<verse eid="PRO 23:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29" />Ya yi ɗa wi a malapa mu? Ya yi ɗa wi u na̱mgbi u ka̱tsuma̱?</para>
  <para style="q2" vid="PRO 23:29">Ya yi ɗa u tsu zama vishili babu unushi? Ya yi ɗa u tsu ka̱na̱ mololo an deꞋen ni?</para>
  <para style="q1" vid="PRO 23:29">Ya yi ɗa vuza na wi n muna babu munla̱i?</para>
  <para style="q2" vid="PRO 23:29">Ya yi ɗa tsu yongo n a̱shi a shili?<verse eid="PRO 23:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30" />A̱yi ɗa vuza na u ci geshe ubuta̱ u kusoꞋo ku ma̱ra̱,</para>
  <para style="q2" vid="PRO 23:30">Aza na u tsu ka̱na̱ kusoꞋo ma̱ra̱ icuꞋu kakau.<verse eid="PRO 23:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31" />Ka̱ta̱ vu ka̱sukpa̱ ma̱ra̱ ma la̱nga̱sa̱ wu ba,</para>
  <para style="q2" vid="PRO 23:31">ko ana mo okpoi ushili n ugaꞋin u kene,</para>
  <para style="q2" vid="PRO 23:31">nu uyoꞋo u kusoꞋo.<verse eid="PRO 23:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32" />Ka̱ta̱ u koci u ka̱na̱ kuluma yi an koko,</para>
  <para style="q2" vid="PRO 23:32">a mataɗaka an kudyaɓu.<verse eid="PRO 23:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33" />Ka̱ta̱ a̱shi a̱ nu a ka̱na̱ kene ili kakawu,</para>
  <para style="q2" vid="PRO 23:33">ka̱ta̱ vu ka̱na̱ kusheshe u kuna n kadanshi ka kavama.<verse eid="PRO 23:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34" />Ka̱ta̱ vokpo an vuma na u vaki a mala,</para>
  <para style="q2" vid="PRO 23:34">ko an vuma na wi a̱ ka̱ta̱la̱la̱ gaɗi vu maɗanga ma kpantsu a mini.<verse eid="PRO 23:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35" />Ka̱ta̱ vu dana, ai vuza yoku u lapa mu ta̱, &lt;&lt;Ama u foro mu ba,</para>
  <para style="q2" vid="PRO 23:35">a lapa mu ta̱ ama n pana n ɓa̱la̱ ba.</para>
  <para style="q1" vid="PRO 23:35">Wanai ɗa ma ku jimgba n soꞋo ma yoku.&gt;&gt;<verse eid="PRO 23:35" /></para>
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" sid="PRO 24" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1" />Ka̱ta̱ vu yaꞋanka uma a kavama tsurala ba,</para>
  <para style="q2" vid="PRO 24:1">ko vu yaꞋan mali ma kuyongo n a̱ le ba,<verse eid="PRO 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2" />adama na ka̱ɗu ke le, ka ci sheshe i yoku ba, sai vishili,</para>
  <para style="q2" vid="PRO 24:2">una̱u u le kpamu sai kavama.<verse eid="PRO 24:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3" />N ugboji u ɗa a maꞋin kpaꞋa,</para>
  <para style="q2" vid="PRO 24:3">n ubuta̱ u kuyeve u ɗa kpamu ɗa kushamgba yi,<verse eid="PRO 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4" />n ubuta̱ u kuyeve u ɗa a shatangi unu</para>
  <para style="q2" vid="PRO 24:4">n ucanuku u singai ra̱ka̱ n uciyi.<verse eid="PRO 24:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5" />Vuza vu ugboji u tsu yaꞋan ta̱ n utsura,</para>
  <para style="q2" vid="PRO 24:5">keyevi kpamu ka tsu lyaꞋa ta̱ kelime n kudoku n utsura,<verse eid="PRO 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6" />adama na ubuta̱ wu ugboji u uma u ɗa a tsuyaꞋan kuvon,</para>
  <para style="q2" vid="PRO 24:6">kpamu ubuta̱ wa odoki u uma u ɗa a ci ciya̱ u lyaꞋi.<verse eid="PRO 24:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7" />Ugboji wi ta̱ n atakaci a kuyeve ubuta̱ u kalau,</para>
  <para style="q2" vid="PRO 24:7">a u ubuta̱ u kadanshi uma a tsu fuɗa a dansa u kuna u ma̱riki ba.<verse eid="PRO 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8" />Ya ba dem na u tsu sheshe kuyaꞋan ka gbani-gbani,</para>
  <para style="q2" vid="PRO 24:8">a ku ɗekei ta̱, mogono ma vishili.<verse eid="PRO 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9" />Kusheshe kuyaꞋan ka gbani-gbani, u nushi u ɗa,</para>
  <para style="q2" vid="PRO 24:9">vuza kugoyi kpamu ili yu unata i ɗa ubuta̱ u uma.<verse eid="PRO 24:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10" />Ɗa baci vu oꞋoi a kanna ka atakaci,</para>
  <para style="q2" vid="PRO 24:10">mayun ɗa an vi nu utsura ba.<verse eid="PRO 24:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11" />Isa aza na i a kurono a ku banka ubuta̱ u munuka,</para>
  <para style="q2" vid="PRO 24:11">Geshe aza na i a katambalusa a ku bana u kpiꞋisa̱.<verse eid="PRO 24:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12" />Ɗa baci vu danai, &lt;&lt;Mpa n yeve ili nampa ya ba,</para>
  <para style="q2" vid="PRO 24:12">adama nanai mpa, ili i bura mu ba.&gt;&gt; Ciɓai an Ka̱shile ka yevei i na ci yaꞋan, kpamu u yeve ta̱ i na ci a kusheshe,</para>
  <para style="q2" vid="PRO 24:12">ashe wa ku tsupa ka tsu derere vi na tsuyaꞋan va ba?<verse eid="PRO 24:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13" />Maku ma̱va̱, lyaꞋa ishigi, adama i ɗa yi ta̱ n ugain.</para>
  <para style="q2" vid="PRO 24:13">kpamu kuɗa̱kpa̱ ku kabashi ki ishigi ko tsu yokpo ta̱ una̱.<verse eid="PRO 24:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14" />Yeve an ta ugboji wi a̱ ka̱ɗu ka̱ nu nanai,</para>
  <para style="q2" vid="PRO 24:14">ɗa ba ci vu ciya̱i u ɗa, vi ta̱ a kuyongo n a̱pa̱ kelime,</para>
  <para style="q2" vid="PRO 24:14">kpamu a̱pa̱ a̱ nu i a ku puwa̱nka̱ ba.<verse eid="PRO 24:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 24:15" />Ka̱ta̱ vu vaꞋanku a kavaꞋawan tsu vuma gbanigbani, a kpaꞋa ku vuza vu usuɓi,</para>
  <para style="q2" vid="PRO 24:15">ka̱ta̱ vu la̱nga̱sa̱ kpaꞋa ku vuza vu usuɓi ba,<verse eid="PRO 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16" />adama na vuza vu usuɓi u su yikpa̱ ta̱ ku cindere ka̱ta̱ u ɗa̱nga̱ kpamu,</para>
  <para style="q2" vid="PRO 24:16">ama u na̱mgbi u te u tsuna ta̱ aza gbanigbani.<verse eid="PRO 24:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17" />Ka̱ta̱ vu yaꞋan ma̱za̱nga̱, adama ili gbanigbani i na i ciya̱i vu rala nu ba,</para>
  <para style="q2" vid="PRO 24:17">kpamu ka̱ta̱ vu yaꞋan ma̱za̱nga̱ a ayin ana u fa̱ta̱tsa̱i u yikpa̱i ba,<verse eid="PRO 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18" />talo, Vuzavaguɗu wa kene, ka̱ta̱ u na̱mgba̱ ka̱tsuma̱,</para>
  <para style="q2" vid="PRO 24:18">ka̱ta̱ kucikpa u vadalukpa wupa u ni.<verse eid="PRO 24:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19" />Ka̱ta̱ vu takacika ka̱cika̱nu adama vuza gbanigbani ba,</para>
  <para style="q2" vid="PRO 24:19">kpamu ka̱ta̱ vu yaꞋan tsura tsa aza gbanigbani ba,<verse eid="PRO 24:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20" />adama na vuma gbanigbani wi n a̱pa̱m kelime ba,</para>
  <para style="q2" vid="PRO 24:20">kutashi ku vuza gbanigbani ki ta̱ a ku kima̱.<verse eid="PRO 24:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21" />Maku ma̱ va̱ pana wovon u Ka̱shile n mogono,</para>
  <para style="q2" vid="PRO 24:21">kpamu ka̱ta̱ vu gbaɓa ka̱cika̱nu n a̱ka̱ra̱shi ba,<verse eid="PRO 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22" />adama ana kawuya ki ta̱ a̱ ku ɗa̱nga̱ n moloko we le,</para>
  <para style="q2" vid="PRO 24:22">ya yi u yevei uteku u munuka ma na dem vu le a ku tuka̱?<verse eid="PRO 24:22" /></para>
  <para style="s1">Kadanshi ka a̱bunda̱i ka aza ugboji</para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 24:23" />Nava feu kadanshi ka aza ugboji ka.<verse eid="PRO 24:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24" />Ya ba dem vu na baci de dem u danai vuza gbanigbani, &lt;&lt;Avu vu nusa ba,&gt;&gt;</para>
  <para style="q2" vid="PRO 24:24">uma i ta̱ a kuyaꞋan kai una̱, ka̱ta̱ uduniya kpamu e ne unata u ni,<verse eid="PRO 24:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25" />Ama aza na de dem u tsu dansuka vuma gbanigbani wita̱ a kuciya̱ una̱u usingai,</para>
  <para style="q2" vid="PRO 24:25">una̱u usingai wa a̱bunda̱i wi ta̱ a ku cipa̱ wa̱ le.<verse eid="PRO 24:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26" />Vuza dem u danshi kamayun</para>
  <para style="q2" vid="PRO 24:26">u yotsongu ta̱ cija̱Ꞌa̱ ci singai.<verse eid="PRO 24:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27" />Lapula biꞋi ulinga u nu ra̱ka̱ pulai,</para>
  <para style="q2" vid="PRO 24:27">kotso ku lapula ili ya ashina i nu ra̱ka̱,</para>
  <para style="q2" vid="PRO 24:27">ka̱ta̱ yeve a ukocishi vu maꞋa kpaꞋa ku nu.<verse eid="PRO 24:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28" />Ka̱ta̱ vu neke ngaꞋan adama vu toku nu babu ili ba,</para>
  <para style="q2" vid="PRO 24:28">ka̱ta̱ vu dansa a uwa ba.<verse eid="PRO 24:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29" />Ka̱ta̱ vu dana &lt;&lt;Mpa sai n tsupa u teku tsu na u yaꞋan kai mu ba,</para>
  <para style="q2" vid="PRO 24:29">n ku tsupa ta̱ i na u yaꞋankai mu.&gt;&gt;<verse eid="PRO 24:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30" />N wala ta̱ n kashina ka korogo,</para>
  <para style="q2" vid="PRO 24:30">n kashina ka vuza vu babu ugboji,<verse eid="PRO 24:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31" />ɗa menei ka ka shana ta̱ na a wana,</para>
  <para style="q2" vid="PRO 24:31">i ɗika ya kpamu i shanai n mita̱,</para>
  <para style="q2" vid="PRO 24:31">kpamu nshilya n ni n ɓosoi a li iɗika.<verse eid="PRO 24:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32" />A na menei, ɗa n sheshei u kuna wa,</para>
  <para style="q2" vid="PRO 24:32">ɗa n ciya̱i odoki a nampa.<verse eid="PRO 24:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33" />Ɗa baci alavu n agbaɗiki a laꞋi nu gan,</para>
  <para style="q2" vid="PRO 24:33">ayin kenu, vo oɓongu ekiye nu adama na vu vuka,<verse eid="PRO 24:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34" />nanai ɗa unambi wa kufa̱ba̱na̱ wu i li, an vuza ma̱ga̱la̱ka̱,</para>
  <para style="q2" vid="PRO 24:34">ka̱ta̱ kpamu u ɗa u ka̱na̱ wu an koboki.<verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" sid="PRO 25" />
  <para style="s1">Ansa o yoku a Sulemanu</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1" />Nava feu ansa a Sulemanu a ɗa a na uma Hizekiya mogono ma Yahuda ma pura̱i.<verse eid="PRO 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2" />U Ka̱shile tsugbayin tsu ni tsu ɗa a pala ka kuna,</para>
  <para style="q2" vid="PRO 25:2">ama u mogono tsugbayin tsu ni tsu ɗa u palakpusa ka kuna.<verse eid="PRO 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3" />U teku tsu na gaɗi wi daꞋangi n iɗika,</para>
  <para style="q2" vid="PRO 25:3">ta a̱ɗu an ngono i na atakaci a ku palakpusa nanai.<verse eid="PRO 25:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4" />Utuka̱ unata u azurufa wa,</para>
  <para style="q2" vid="PRO 25:4">ka̱ta̱ kawakana tamkpamu ka ciya̱ azurufa ana wa ku yaꞋanka u linga,<verse eid="PRO 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5" />u tuka̱ n vuza gbanigbani e kelime ka mogono,</para>
  <para style="q2" vid="PRO 25:5">ka̱ta̱ kakuba ka tsugono ka̱ ni ka ciya̱ ushikpi wu usuɓi.<verse eid="PRO 25:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6" />Ka̱ta̱ vu utuka̱ kacika̱nu e keteshe e kelime ko mogono</para>
  <para style="q2" vid="PRO 25:6">ko a ubuta̱ wa za a gbagbaꞋin ba,<verse eid="PRO 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7" />adama ana u ku lata̱ n ugaꞋin e ɗeke wu, &lt;&lt;Avu ta̱wa̱ gaɗi na,&gt;&gt;</para>
  <para style="q2" vid="PRO 25:7">an a ku neke wu wono ubuta̱ wa aza a̱ gba̱ra̱-gba̱ra̱.</para>
  <para style="q2" vid="PRO 25:7">I na a̱shi a̱ nu enei,<verse eid="PRO 25:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="PRO 25:8" />ka̱ta̱ vu yaꞋan moloko ma ku banka ubuta̱ wa afada ba,</para>
  <para style="q1" vid="PRO 25:8">adama a na ka̱ta̱ a ukocishi vu namba ili i na va ku yaꞋan ba,</para>
  <para style="q2" vid="PRO 25:8">ɗa baci vutoku nu u nekei nu wono.<verse eid="PRO 25:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9" />Da̱sa̱ngi i panakpanai n tovu,</para>
  <para style="q2" vid="PRO 25:9">kpamu ka̱ta̱ vu utuka̱ vutoku nu e keteshe ba,<verse eid="PRO 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10" />adama ana ka̱ta̱ aza ana i a kupana ka̱ɗa̱ a zuwa ɗa̱ yo okpo n wono ba,</para>
  <para style="q2" vid="PRO 25:10">ta lo tsugbayin tsu nu tsa yikpa̱.<verse eid="PRO 25:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11" />Kadanshi kana ka̱ uta̱i ɗe, derere ɗa ka ki,</para>
  <para style="q2" vid="PRO 25:11">tsu ugaꞋin u kazanariya a gaɗi va azurufa.<verse eid="PRO 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12" />Kupana ko odoki a vuza vu ugboji,</para>
  <para style="q2" vid="PRO 25:12">u laꞋa ta̱ ucanuku u tsuloboi u na a kalai n azanari koci.<verse eid="PRO 25:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13" />Kalingata ku usuɓi,</para>
  <para style="q2" vid="PRO 25:13">ka tsu zuwa ta̱ ka̱ɗu ka aza u suki a̱ ni ma̱za̱nga̱,</para>
  <para style="q2" vid="PRO 25:13">u teku tsu katali ku uta̱ni a ayin usuɗukpi.<verse eid="PRO 25:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14" />Vuma na u yaꞋin uzuwukpani u na wa ku neke kuneꞋe, kpamu u ciya̱ u neke ba,</para>
  <para style="q2" vid="PRO 25:14">wi ta̱ tsu wunla̱i n eleshu a babu mini.<verse eid="PRO 25:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15" />N uka̱ni u ka̱ɗu u ɗa a tsu fuɗa a lyaꞋa vuza vu utsura,</para>
  <para style="q2" vid="PRO 25:15">kelentsu kasingai kpamu ka tsu ɓoso ta̱ etele.<verse eid="PRO 25:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16" />vu ciya̱ baci ishigi, lyaꞋa i ɗa u teku wu u tsura u nu,</para>
  <para style="q2" vid="PRO 25:16">ta lo i ɗa ya laꞋa wu a̱bunda̱i ka̱ta̱ vu shama i ɗa.<verse eid="PRO 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17" />Ka̱ta̱ vu dakaka kubana a kpaꞋa ku tovu ba,</para>
  <para style="q2" vid="PRO 25:17">ta lo wa koꞋo n avu ka̱ta̱ u iwan wu.<verse eid="PRO 25:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18" />Vuma na dem wu ushuki ku okpo magan ma a uwa u vutoku ni</para>
  <para style="q2" vid="PRO 25:18">wi ta̱ o ku okpo an kalangu ka kuvon ko kotokobi, ko kaya ka alyu.<verse eid="PRO 25:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19" />Ku ushuku kutono vuza babu usuɓi a ayin atakaci</para>
  <para style="q2" vid="PRO 25:19">wi ta̱ a ku okpo an kanga ka na ka shamai, ko kpamu nwalu n kune kuna ku koɗoi.<verse eid="PRO 25:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20" />Vuza na baci de dem u yaꞋankai vuza vu una̱mgbi u ka̱tsa̱ma̱ vishipa</para>
  <para style="q2" vid="PRO 25:20">wi ta̱ an vuza na o foɗoi motogu a ayin uta̱ni,</para>
  <para style="q2" vid="PRO 25:20">ko kpamu tsu mini ma kalam ko kakpaɗi a̱ kuntsu.<verse eid="PRO 25:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21" />Ɗa baci vu enei vurala nu a kambulu, neke yi ilikulya u lyaꞋa n mini kpamu u soꞋo,<verse eid="PRO 25:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22" />nanai ɗa va ku dyaɓa a̱ga̱ruwa̱shi akina a kaci ka̱ ni,</para>
  <para style="q2" vid="PRO 25:22">ka̱ta̱ Vuzavaguɗu tana u zuwa ka wu una̱singai.<verse eid="PRO 25:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23" />Tsu na wunla̱ u kasana u tsu tuka̱ n mini,</para>
  <para style="q2" vid="PRO 25:23">ta feu una̱ u vuza gbani-gbani u tsu ka̱ra̱ka̱ n wupa nanai.<verse eid="PRO 25:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24" />U ku laꞋa ta̱ n ugaꞋin vu da̱sa̱ngu a kunu ku kenu pulai vu kpaꞋa,</para>
  <para style="q2" vid="PRO 25:24">ana va da̱sa̱ngu a kpaꞋa n vuka vu vishili.<verse eid="PRO 25:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25" />Tsu mini ma̱ ta̱ku a ka̱ɗu ka vu za kakuli,</para>
  <para style="q2" vid="PRO 25:25">ta kadanshi kasingai ki iɗika i daꞋangi ki nanai.<verse eid="PRO 25:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26" />Vuza vu usuɓi na u ka̱sukpa̱i ka gbani-gbani ka lyai ni,</para>
  <para style="q2" vid="PRO 25:26">wi ta̱ an ka̱shi ka mini ma na ma̱ na̱mgba̱i, ko kayinva ka mini ma tsukono.<verse eid="PRO 25:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27" />U gaꞋan vu lyaꞋa ishigi n a̱bunda̱i ba,</para>
  <para style="q2" vid="PRO 25:27">ta feu kula̱nsa̱ ku tsugbayin ki nanai.<verse eid="PRO 25:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28" />Vuma na baci u fuɗa u remei ka̱cika̱ni ba,</para>
  <para style="q2" vid="PRO 25:28">wi ta̱ an likuci i na o ɓosoi mashilya ma̱ ni.<verse eid="PRO 25:28" /></para>
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" sid="PRO 26" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 26:1" />Uteku tsu mini mu uta̱ni a ayin a kpandari,</para>
  <para style="q2" vid="PRO 26:1">ta tsugbayin tsu kpa̱ɗi kugaꞋan n kalau nanai.<verse eid="PRO 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2" />Una̱wuya wi a kulya vuza babu unushi ba.</para>
  <para style="q2" vid="PRO 26:2">wi ta tsu nnu n na n tsu imkpa gaɗi,</para>
  <para style="q2" vid="PRO 26:2">an nwalu babu kucipa̱ iɗika.<verse eid="PRO 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3" />A yaꞋan ta̱ mashashau a dama majaki, iryangama kpamu adama odoku,</para>
  <para style="q2" vid="PRO 26:3">ama kalangu adama alau.<verse eid="PRO 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4" />Ka̱ta̱ vu ushuku kalau n kadanshi ka tsulau tsu ni ba,</para>
  <para style="q2" vid="PRO 26:4">ta lo va ta̱wa̱ vo okpo tsu ni.<verse eid="PRO 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5" />Ushuku kalau, derere n tsulau tsu ni,</para>
  <para style="q2" vid="PRO 26:5">ta lo wa ta̱wa̱ we ene ka̱cika̱ni vuza vu ugboji.<verse eid="PRO 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6" />Ya ba dem vu na u tsu neke kalau a kaka</para>
  <para style="q2" vid="PRO 26:6">u gbatya ta̱ njuvu n ene a̱ ni, kpamu ɗa u la̱nsa̱ka̱i kaci ka̱ ni atakaci.<verse eid="PRO 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7" />Uteku tsu na ene a ma̱kuta̱ i upinda̱ri</para>
  <para style="q2" vid="PRO 26:7">ta ansa i una̱ u kalau nannai,<verse eid="PRO 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8" />Uteku tsu na a tsu kpa̱ɗa̱ kushiya katali a ka̱vimgba̱tsu,</para>
  <para style="q2" vid="PRO 26:8">nanai ɗa feu a tsu kpa̱ɗa̱ ku neke kalau tsugbayin nannai.<verse eid="PRO 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 26:9" />Ansa a una̱ u kalau,</para>
  <para style="q2" vid="PRO 26:9">i ta̱ tsu kawana a kukiye, ka na ko soꞋi ki a ku yaꞋanka ugulani.<verse eid="PRO 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 26:10" />Uteku tsu katain ka na ka tsu yaꞋan matawuka babu ku zuwaka, ali ka̱ta̱ u yaꞋanka uma n a̱bunda̱i muna,</para>
  <para style="q2" vid="PRO 26:10">nannai ɗa vuza na u ɗikai kalau ulinga wi, ta feu vuza na u ɗikai ka̱ka̱ra̱shi wi nannai.<verse eid="PRO 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 26:11" />Uteku tsu na meshe ma tsu shama ka̱ta̱ u bono u peɗe,</para>
  <para style="q2" vid="PRO 26:11">ta kalau ka tsu doku su tsulau tsu ni nannai.<verse eid="PRO 26:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 26:12" />Vu ene baci vuza na we enei ka̱cika̱ni vuza vu ugboji ɗa,</para>
  <para style="q2" vid="PRO 26:12">kalau ki ta̱ n a̱pa̱ a na a laꞋi ni.<verse eid="PRO 26:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 26:13" />Korogo ka tsu dana ta̱, &lt;&lt;Mi a̱ ku uta̱ ba, Kawu wi ta̱ lo uye.</para>
  <para style="q2" vid="PRO 26:13">Ka̱di ki ta̱ lo a uye u gbayin.&gt;&gt;<verse eid="PRO 26:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 26:14" />Uteku tsu na ka̱kpa̱ga̱ ka tsu ka̱na̱ kukpatala n ko obonoi utsutsu,</para>
  <para style="q2" vid="PRO 26:14">ta korogo ka tsu ka̱na̱ ku baꞋinkpusa a kajiba ka̱ ni nannai.<verse eid="PRO 26:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 26:15" />Korogo ka tsu uka ta̱ kukiye a mevene ma kusan,</para>
  <para style="q2" vid="PRO 26:15">ama ka̱ta̱ u kpa̱ɗa̱ kufuɗa ku banka una̱.<verse eid="PRO 26:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 26:16" />Korogo ka ce ene ta̱ ka̱cika̱ni,</para>
  <para style="q2" vid="PRO 26:16">vuza vu ugboji ɗa ali u laꞋa uma e cindere usuɓi.<verse eid="PRO 26:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 26:17" />A̱yi na u cinai vishili vu na vu burai ni ba ɗa u ukai una̱,</para>
  <para style="q2" vid="PRO 26:17">wita̱ tsu vuma na u tsu reme mesheꞋe a kutsuvu.<verse eid="PRO 26:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 26:18" />Tsu kajarishi ka na ka tsuyaꞋan ugulani n akina n aya koɓolo n ukpa̱,<verse eid="PRO 26:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 26:19" />ta a̱yi vuma na u doroi vutoku ni,</para>
  <para style="q2" vid="PRO 26:19">ɗa udanai, &lt;&lt;Ai, mpa ugulani u ɗa koci mi a kuyaꞋan.&gt;&gt;<verse eid="PRO 26:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 26:20" />Nɗanga mi lo baci ba, ɗa akina a tsu kima̱,</para>
  <para style="q2" vid="PRO 26:20">kpamu vuza kuyun wi lo baci ba, vishili vu feu vu tsu kotso ta̱.<verse eid="PRO 26:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21" />Tsu na cikina tsu yongo n a̱ga̱ruwa̱shi usuɗukpi wa akina, n tsu na nɗanga kpamu n tsu yongo akina,</para>
  <para style="q2" vid="PRO 26:21">ta vuza kula̱nsa̱ ku vishili u tsu yongo nanai.<verse eid="PRO 26:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 26:22" />Kadanshi ka vuza kuyun ci ilikulya yi uyoꞋo ɗa ki,</para>
  <para style="q2" vid="PRO 26:22">ka tsu laza ta̱, ka̱ta̱ ka uwa a ka̱tsuma̱ ki ikyamba.<verse eid="PRO 26:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 26:23" />Una̱ wu uyoꞋo koɓolo n ka̱ɗu ka gbani-gbani,</para>
  <para style="q2" vid="PRO 26:23">ki ta̱ tsu mogbodo ma ciꞋin mana a paɗarai n azurufa.<verse eid="PRO 26:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 26:24" />Vuza cisheꞋe u tsu sokongu ta̱ cisheꞋe tsu ni n una̱ wu uyo,</para>
  <para style="q2" vid="PRO 26:24">ama ka̱ɗu ka̱ni ki ta̱ ushani tukpa n ka gbani-gbani.<verse eid="PRO 26:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 26:25" />A makyan ma na baci udansai kadanshi ka singai,</para>
  <para style="q2" vid="PRO 26:25">ka̱ ta̱ vu ushuku n a̱yi ba,</para>
  <para style="q2" vid="PRO 26:25">adama ana ka̱ɗu ka̱ ni tukpa ɗa ka ki n kusheshe ki ili yi unata.<verse eid="PRO 26:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 26:26" />Ko ana wo okpoi wi ta̱ a kusokongu tsurala ci ni n ugboji,</para>
  <para style="q2" vid="PRO 26:26">ama ka gbani-gbani ka̱ ni ki ta̱ a̱ ku uta̱ e keteshe a̱ ka̱tsuma̱ ko oɓolo a u uma.<verse eid="PRO 26:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 26:27" />Ya ba dem vu na u ga̱va̱i kpenle adama a ka gbani-gbani, wi ta̱ a ku yikpa̱ punu a ku ɗa,</para>
  <para style="q2" vid="PRO 26:27">a̱yi vuza na kpamu u gindalukpai katali, a̱yi ɗa ka ka ku tsugba.<verse eid="PRO 26:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 26:28" />KayaꞋin ka uwa ka ci iwan ta̱ vuza na u yaꞋankai a uwa,</para>
  <para style="q2" vid="PRO 26:28">ka̱ta̱ vuza vu una̱ uyoꞋo tamkpamu u yaꞋan ta̱ koli.<verse eid="PRO 26:28" /></para>
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" sid="PRO 27" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 27:1" />Ka̱ta̱ vu keɗe a̱pa̱m n makpaꞋa ba,</para>
  <para style="q2" vid="PRO 27:1">adama ana vu yeve u teku tsu na makpaꞋa va uku uta̱ ba.<verse eid="PRO 27:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2" />Ka̱ta̱ vu cikpa ka̱cika̱nu ba,</para>
  <para style="q2" vid="PRO 27:2">ka̱sukpa̱ uma a cikpa wu, ama ba avu nu una̱ u nu ba.<verse eid="PRO 27:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3" />Katali ki ta̱ n a̱miki, kayala feu ta nanai,</para>
  <para style="q2" vid="PRO 27:3">ama atakaci a na kalau ka tsu rono a laꞋa le ta̱ a̱miki dem.<verse eid="PRO 27:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4" />Wupa ili gbanigbani i ɗa, u tsuna ta̱,</para>
  <para style="q2" vid="PRO 27:4">ama dem n nanai u yawa tsurala ba.<verse eid="PRO 27:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5" />U laꞋa ta̱ vu dansuka vuza e keteshe,</para>
  <para style="q2" vid="PRO 27:5">an va ku yotsongi cigai u sokongi.<verse eid="PRO 27:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6" />Ka̱ja̱Ꞌa̱ ko ana u la̱nga̱shi nu ka̱ɗu,</para>
  <para style="q2" vid="PRO 27:6">vurala vu ɗa ko ana wo oɓongi nu n a̱bunda̱i.<verse eid="PRO 27:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7" />Vuza vu ucuwi u tsu cikala n ku soꞋo ishigi ba,</para>
  <para style="q2" vid="PRO 27:7">ama u vuza kambulu ko ili yo okono i ɗa, uyoꞋo u ɗa wi a kupana.<verse eid="PRO 27:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8" />Tsuna manunu ma tsu ka̱sukpa̱ cikinda ci ni,</para>
  <para style="q2" vid="PRO 27:8">ta feu vuza na u ka̱sukpa̱i kpaꞋa ku ni feu wi nanai.<verse eid="PRO 27:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9" />Ili ma̱gula̱ni n mani ma ma̱gula̱ni ma tsu neke ta̱ ma̱za̱nga̱ a̱ ka̱ɗu,</para>
  <para style="q2" vid="PRO 27:9">ama ma̱za̱nga̱ ma cija̱Ꞌa̱ mi ta̱ ubuta̱ wa odoki a singai.<verse eid="PRO 27:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10" />Ka̱ta̱ vu iwan ka̱ja̱Ꞌa̱ ka̱ nu ba, ko ka̱ja̱Ꞌa̱ ka Dada vu nu ba,</para>
  <para style="q2" vid="PRO 27:10">kpamu ka̱ta̱ vu bana a kpaꞋa ku tovu, a kanna kana vi nu una̱mgbi u ka̱tsuma̱ ba.</para>
  <para style="q1" vid="PRO 27:10">u laꞋa ta̱ n kugaꞋan n vuza na yi ida̱shi ɗeɗevu</para>
  <para style="q2" vid="PRO 27:10">n toku nu vu na wi daꞋangi.<verse eid="PRO 27:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11" />Gbojo, maku ma̱va̱ adama ana ka̱ɗu ka̱va̱ ka yaꞋan ma̱za̱nga̱,</para>
  <para style="q2" vid="PRO 27:11">adama ana n neke wu ushuki u vuza na u goyoi mu.<verse eid="PRO 27:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12" />Vuza vu ugboji u tsu ene ta̱ ka gbani-gbani ka̱ ta̱ u suma,</para>
  <para style="q2" vid="PRO 27:12">ama vuza vu unambi wu ugboji u tsu bana ta̱ ka̱ta̱ tana u takacika.<verse eid="PRO 27:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13" />Isa motogu ma vuza na wu ushuki ku okpo magan mo komoci,</para>
  <para style="q2" vid="PRO 27:13">n ma vuza na wu ushuki ku okpo magan ma kashakanlai.<verse eid="PRO 27:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14" />Vuza na baci de dem u jimgbasai vutoku n kacaꞋa n usana,</para>
  <para style="q2" vid="PRO 27:14">derere ɗa n ishikushi i ni.<verse eid="PRO 27:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15" />Vuka vu vishili,</para>
  <para style="q2" vid="PRO 27:15">vita̱ an kacaꞋa ki ijaꞋashi i mini,<verse eid="PRO 27:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16" />ɗa baci vu danai vi ta̱ a ku sa̱nka̱i, ka̱ta̱ wo okpo an usa̱nki u wunla̱</para>
  <para style="q2" vid="PRO 27:16">ko tsu ku reme ku mani ma agujiyan n kataka ka kukiye.<verse eid="PRO 27:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17" />Tsu na vuyum vu tsu gboro vuyum</para>
  <para style="q2" vid="PRO 27:17">ta feu vuma n vuma o tsu ɓa̱nka̱na̱i nanai.<verse eid="PRO 27:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18" />Vuza na u tsu la̱na̱ maɗanga ma ma̱biri u tsu lyaꞋa ta̱ umaci u ni,</para>
  <para style="q2" vid="PRO 27:18">ama vuza na u tsu la̱na̱ vuzagbayin vu ni, wi ta̱ a̱ kuciya̱ tsugbayin.<verse eid="PRO 27:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19" />Tsu na vuma u tsu inda ka̱cika̱ni a mini,</para>
  <para style="q2" vid="PRO 27:19">ta feu ka̱ɗu ka vuma ka tsu yotso vuma nanai.<verse eid="PRO 27:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20" />Asaun n ukpisa̱ a tsu cuwa̱ ba</para>
  <para style="q2" vid="PRO 27:20">ta feu a̱shi a uma a̱ tsu kpa̱ɗa̱ kucuwa̱ nanai.<verse eid="PRO 27:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21" />Azanariya n azurufa n akina aɗa a tsu kondo a ɗa,</para>
  <para style="q2" vid="PRO 27:21">ta feu vuma nanai a tsu kondoi ta̱ ubuta̱ u kucikpa u ni.<verse eid="PRO 27:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22" />Jara kalau n mashin a̱ ma̱suku</para>
  <para style="q2" vid="PRO 27:22">tsu kiya ku ilya,</para>
  <para style="q2" vid="PRO 27:22">dem n nanai tsulau tsu ni ci a ku kotso ba.<verse eid="PRO 27:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 27:23" />La̱na̱ ushiga wi ili kuzuwa i nu,</para>
  <para style="q2" vid="PRO 27:23">ka̱ta̱ kpamu vu yeve ma̱ta̱na̱ ma anaka a̱ nu,<verse eid="PRO 27:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 27:24" />adama ana uciyi u tsu geshe ali a kubana u teku ba,</para>
  <para style="q2" vid="PRO 27:24">ta feu tsugono ci nanai, tsu ci geshe ali n tsukaya ba.<verse eid="PRO 27:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 27:25" />A tsu kana ta̱ mita̱ ka̱ta̱ masavu mo topo</para>
  <para style="q2" vid="PRO 27:25">a tsu ɓolongu ta̱ kpamu a̱vuku adama anaka,<verse eid="PRO 27:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 27:26" />a tsu tsuyaꞋan ta̱ aminya n cileme tsa nlala,</para>
  <para style="q2" vid="PRO 27:26">a tsu cimba ta̱ kpamu kashina n ikebe ya nraɗika.<verse eid="PRO 27:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27" />I ta̱ a kuciya̱ mani ma nraɗika ma kulyaꞋa ba̱ri,</para>
  <para style="q2" vid="PRO 27:27">mana ma ku lyaꞋatangu kpaꞋa ku nu</para>
  <para style="q2" vid="PRO 27:27">koɓolo n a kabashi n nkere n nu.<verse eid="PRO 27:27" /></para>
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" sid="PRO 28" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 28:1" />Vuma gbanigbani u tsu ka̱na̱ ta̱ ilaɗi gbani, babu vuza na wi a kusaɓa yi,</para>
  <para style="q2" vid="PRO 28:1">ama aza usuɓi a tsu shamgba ta̱ ba̱ri an kawu.<verse eid="PRO 28:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2" />Iɗika yi baci a kuyaꞋan kagbanigbani, ɗa i tsu ka̱na̱ kusabaꞋa ngono,</para>
  <para style="q2" vid="PRO 28:2">ama ubuta̱ u na baci mogono mi n ugboji n kuyeve,</para>
  <para style="q2" vid="PRO 28:2">iɗika i tsu shamgba ta̱ ka̱ta̱ i geshe.<verse eid="PRO 28:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3" />Vuza tsugono na utsu doro uma a̱ ni,</para>
  <para style="q2" vid="PRO 28:3">wita̱ an mini ma atali ma na ma tsu la̱nga̱sa̱ ili kashina.<verse eid="PRO 28:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4" />A̱yi na u tsu iwan kutono wila̱, wita̱ koɓolo n aza a gbanigbani,</para>
  <para style="q2" vid="PRO 28:4">ama ɗa baci vi a kutono wila̱ a vu vurala va aza gbanigbani ɗa.<verse eid="PRO 28:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5" />Uma gbanigbani e yeve kasingai ba,</para>
  <para style="q2" vid="PRO 28:5">ama aza kutoni ku Yesu e yeve ta̱ ka mayin.<verse eid="PRO 28:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 28:6" />Ulata̱ vokpo vuza vu unambi vu kasingai,</para>
  <para style="q2" vid="PRO 28:6">an va kokpo vuza vu uciyi vu gbanigbani.<verse eid="PRO 28:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 28:7" />A̱yi na u tsu tono wila̱, maku mu ugboji maꞋa,</para>
  <para style="q2" vid="PRO 28:7">ama ka̱je ka ka̱ka̱ra̱shi u tsu ronoko ta̱ dada ni wono.<verse eid="PRO 28:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 28:8" />Ɗa baci vu ciya̱i udukuyan ubuta̱ u gbanigbani,</para>
  <para style="q2" vid="PRO 28:8">udukuyan wa wita̱ a ku bono ubuta̱ wa aza na i a kuyaꞋan ka a za unambi kasingai.<verse eid="PRO 28:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9" />Ɗa baci vuma u iwain kutono wila̱ u Ka̱shile,</para>
  <para style="q2" vid="PRO 28:9">ko kavasa ka̱ ni feu, ili yu unata i ɗa.<verse eid="PRO 28:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10" />Aza na a tsu zuwa uma usuɓi a yaꞋan unushi</para>
  <para style="q2" vid="PRO 28:10">i ta̱ a ku yikpa̱ e kpenle kuna a̱ga̱pa̱i,</para>
  <para style="q2" vid="PRO 28:10">ama aza babu u nushi i ta̱ a kuciya̱ ili singai.<verse eid="PRO 28:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11" />Aza uciyi a ci ɗika ta̱ ka̱cika̱ le aza ugboji,</para>
  <para style="q2" vid="PRO 28:11">ama vuzavunambi vu ugboji u yeve ta̱ i na igain.<verse eid="PRO 28:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 28:12" />Ɗa baci vuza vu usuɓi u ciya̱i ulyai, ya ba dem u tsu yaꞋan ta̱ ma̱za̱nga̱.</para>
  <para style="q2" vid="PRO 28:12">Ama ɗa baci vuza gbanigbani u ciya̱i ulyai, uma a̱ tsu la̱nsa̱ta̱ ubuta̱ a sheɗeku.<verse eid="PRO 28:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13" />Aza na a tsu sokongu unushi u le, wa kuciya̱ ulyai ba,</para>
  <para style="q2" vid="PRO 28:13">ama ya ba dem vuna u dansai ɗa u ka̱sukpa̱i u ɗa, i ta̱ a ku pana asuvu ayali a̱ ni.<verse eid="PRO 28:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14" />Aza a na a tsu pana wovon u Ka̱shile ayin tutu, a tsu yongo ta̱ n ma̱ta̱na̱,</para>
  <para style="q2" vid="PRO 28:14">ama ɗa baci u yaꞋan ugbamukaci wita̱ a kuna̱mgba̱.<verse eid="PRO 28:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15" />Tsugono tsu gbanigbani cita̱ an maza ma gbanigbani ubuta̱ wa aza unambi,</para>
  <para style="q2" vid="PRO 28:15">an kawu ko kakunzu ka munuka.<verse eid="PRO 28:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16" />Mogono ma na mi n kuyeve ba, wita̱ a ku doro uma a̱ ni,</para>
  <para style="q2" vid="PRO 28:16">ama vuza na u iwain kalya wita̱ a kuciya̱ wuma wu ugaɗi.<verse eid="PRO 28:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17" />Vuza ma̱ga̱la̱ka̱ na wi n mpasa n uma ekiye ni, a ku takacikayi, wita̱ a ku ka̱na̱ ilaɗi a li ukpisa̱ u ni.</para>
  <para style="q2" vid="PRO 28:17">Ka̱ta̱ i ɓa̱nka̱i ba.<verse eid="PRO 28:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18" />Ɗa baci vu yaꞋan ku usuɓi, vi ta̱ a kuda̱sa̱ngu n ma̱ta̱na̱,</para>
  <para style="q2" vid="PRO 28:18">ama vuza gbanigbani i ta̱ a kunai babu usa̱n.<verse eid="PRO 28:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19" />Kacimbi kana ka tsu yaꞋan ulinga wa a̱bunda̱i, ka ci ciya̱ ta̱ ilikulya ya a̱bunda̱i,</para>
  <para style="q2" vid="PRO 28:19">ama vuza na u tsu ciga gbani, wita̱ a kuroko ka̱cika̱ni unambi.<verse eid="PRO 28:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20" />Vuza vu usuɓi wita̱ a kuciya̱ uciyi wa a̱bunda̱i</para>
  <para style="q2" vid="PRO 28:20">ama vuza na u tsu la̱nsa̱ uciyi gogo, wita̱ a ku uwa atakaci.<verse eid="PRO 28:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21" />KuyaꞋan ku kazagba kugan ba,</para>
  <para style="q2" vid="PRO 28:21">ama dem n nanai adama ilikulya, vuma wita̱ a ku fuɗa wa yaꞋan unushi.<verse eid="PRO 28:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22" />Aza ulyopi a ci ciga ta̱ a ciya̱ uciyi gogo,</para>
  <para style="q2" vid="PRO 28:22">ka̱ta̱ u kpa̱ɗa̱ kuyeve a na a okpo aza unambi babu usa̱n ba.<verse eid="PRO 28:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23" />Ya ba dem vu na u dansukai toku wita̱ a kuciya̱ ucikpi a ayin ukoci,</para>
  <para style="q2" vid="PRO 28:23">ka̱ta̱ ula vuza na u yaꞋankai ni una̱ wu uyoꞋo.<verse eid="PRO 28:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24" />Vuza na de dem ubokoi ucanuku u dada ni n a̱kpa̱ ni</para>
  <para style="q2" vid="PRO 28:24">ɗa u danai, &lt;&lt;Ai na lo i yoku i ɗa ba.&gt;&gt;</para>
  <para style="q2" vid="PRO 28:24">a̱yi n vuza ma̱ga̱lka̱ derere ɗa i.<verse eid="PRO 28:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25" />Kutsa̱n ku tsu tuka̱ta̱ n vishili,</para>
  <para style="q2" vid="PRO 28:25">ama vuza na u tsu keɗike Ka̱shile ma̱ka̱nga̱, wita̱ a kuciya̱ uciyi wa a̱bunda̱i.<verse eid="PRO 28:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26" />Aza na e ci keɗike ka̱cika̱ le a̱pa̱ alawu a ɗa,</para>
  <para style="q2" vid="PRO 28:26">ama ya ba dem vuna u walai n ugboji wita̱ a kulaka.<verse eid="PRO 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27" />Ya ba dem vuna u cineke aza unambi ba̱ri, wi a kunamba ba ili ba,</para>
  <para style="q2" vid="PRO 28:27">ama a̱yi na u tsu yimba̱ku a̱shi a̱ ni we e le, i ta̱ a kila̱kpa̱i.<verse eid="PRO 28:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28" />Ɗa baci aza gbanigbani i a kulya tsugono, uma a tsu sheɗeku ta̱.</para>
  <para style="q2" vid="PRO 28:28">ama ayin na baci tsugono tsuta̱ ekiye e le uma usuɓi o tsu doku ta̱.<verse eid="PRO 28:28" /></para>
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" sid="PRO 29" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 29:1" />Vuza na baci de dem wi n ugbamukaci, ɗa u kpa̱ɗa̱i ku pana udansuki,</para>
  <para style="q2" vid="PRO 29:1">i ta̱ a kuɓosoyi, ali ula uteku tsu na a ku fuɗa a lapula.<verse eid="PRO 29:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2" />Aza usuɓi i baci a tsugono, uma a tsu pana ta̱ uyoꞋo.</para>
  <para style="q2" vid="PRO 29:2">Ama ɗa baci aza a gbanigbani i o tsugono, uma a tsu ka̱na̱ ta̱ mololo.<verse eid="PRO 29:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3" />Vuma na u ci ciga ugboji, u tsu zuwa ta̱ dada ni ma̱za̱nga̱,</para>
  <para style="q2" vid="PRO 29:3">ama koto ni ka ashakanlai, ka̱ tsu la̱nga̱sa̱ ta̱ udukuyan u ni.<verse eid="PRO 29:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4" />Mogono mu usuɓi ma tsu zuwa ta̱ iɗika i ni i gan,</para>
  <para style="q2" vid="PRO 29:4">ama vuza na u tsu la̱nsa̱ kalya, u tsu la̱nga̱sa̱ ta̱ i ɗika i ni.<verse eid="PRO 29:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5" />Vuza na u tsu yaꞋanka toku ni una̱ wu uyoꞋo,</para>
  <para style="q2" vid="PRO 29:5">maza ma u tsu shikpa̱ka̱ a ene e le.<verse eid="PRO 29:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6" />Unushi u vuza gbanigbani u tsokpo ta̱ maza wa̱ni,</para>
  <para style="q2" vid="PRO 29:6">ama vuza vu usuɓi u tsu laꞋaka ta̱, ka̱ta̱ worokpo n ma̱za̱nga̱.<verse eid="PRO 29:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7" />Vuza vu usuɓi u tsu dama ta̱ adama aza unambi,</para>
  <para style="q2" vid="PRO 29:7">ama, vuza gbanigbani u tsu yeve n ka nanlo ba.<verse eid="PRO 29:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8" />Aza a gbanigbani a tsu zuwa ta̱ likuci ra̱ka̱ i dagaza,</para>
  <para style="q2" vid="PRO 29:8">ama aza usuɓi a tsu vaꞋanka ta̱ uma a̱ɗu.<verse eid="PRO 29:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9" />Ɗa baci vuza vu ugboji u bankai kalau ubuta̱ wa afada,</para>
  <para style="q2" vid="PRO 29:9">ka̱ta̱ kalau ka ka̱na̱ izoshi n wupa, ka̱ta̱ kadanshi ka kpa̱ɗa̱ ku kotso.<verse eid="PRO 29:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10" />Aza a̱ ma̱ga̱lka̱ a ci ciga aza a babu unushi ba,</para>
  <para style="q2" vid="PRO 29:10">ama aza usuɓi a tsu la̱nsa̱ ta̱ uteku tsuna a ɓa̱nka̱ le.<verse eid="PRO 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11" />Alau a tsutuka̱ta̱ tsulau ci le e keteshe,</para>
  <para style="q2" vid="PRO 29:11">ama aza ugboji a tsu sokongu ta̱ ci le.<verse eid="PRO 29:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12" />Ɗa baci monogo mushuku yi n kadanshi ka aza uwa,</para>
  <para style="q2" vid="PRO 29:12">ana ntaji a̱ ni ra̱ka̱ ita̱ a kokpo aza a gbanigbani.<verse eid="PRO 29:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13" />Aza unambi n aza kalya dem vu le kete ka i,</para>
  <para style="q2" vid="PRO 29:13">Vuzavaguɗu ɗa u nekei le a̱shi adama e kene.<verse eid="PRO 29:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14" />Ɗa baci mogono ma yaꞋankai vuza vu unambi afada a singai,</para>
  <para style="q2" vid="PRO 29:14">tsugono tsu ni ci ta̱ a kugeshe ali ntsukaya.<verse eid="PRO 29:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15" />Ugbari u maku u tsu tuka̱ta̱ n ugboji,</para>
  <para style="q2" vid="PRO 29:15">ama maku magbanigbani ma tsu neke ta̱ a̱na̱kpa̱ ni wono.<verse eid="PRO 29:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16" />Ɗa baci aza a gbanigbani i o tsugono, kagbanigbani ka tsu yimkpa ta̱,</para>
  <para style="q2" vid="PRO 29:16">ama aza usuɓi i ta̱ a kuzuwa le a yikpa̱.<verse eid="PRO 29:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17" />Gbara muku n nu, i ta̱ a ku neke wu ma̱ta̱na̱ ma ka̱ɗu</para>
  <para style="q2" vid="PRO 29:17">ka̱ta̱ a zuwa wu ma̱za̱nga̱.<verse eid="PRO 29:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18" />Ɗa baci ubuta̱ wi babu kadanshi ka Ka̱shile, uma a tsu yaꞋanta̱ ida̱shi kavama.</para>
  <para style="q2" vid="PRO 29:18">Ama vuza ma̱ta̱na̱ ɗa a̱yi na u tonoi wila̱ u Ka̱shile.<verse eid="PRO 29:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19" />Kadanshi ku una̱ koci ka kugbara kagbashi ba,</para>
  <para style="q2" vid="PRO 29:19">adama na wita̱ a kupana ka̱ta̱ uyeve ama wa ku yaꞋan ili ba.<verse eid="PRO 29:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20" />Ka̱shile ka tsu kuɓa̱nka̱ ta̱ kalau gogo,</para>
  <para style="q2" vid="PRO 29:20">u laꞋa vuza kadanshi gogo babu cico.<verse eid="PRO 29:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21" />Vuza na baci uleꞋeshei kagbashi tun a̱yi kenu,</para>
  <para style="q2" vid="PRO 29:21">a ukoci wita̱ a kuɗika ka̱cika̱ni maku makpaꞋa.<verse eid="PRO 29:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22" />A za na a tsu yaꞋan wupa gogo, a tsu ɗengusa̱ta̱ vishili,</para>
  <para style="q2" vid="PRO 29:22">ka̱ta̱ kpamu a yaꞋan unushi wa a̱bunda̱i.<verse eid="PRO 29:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23" />A̱ra̱ɗi a vuma a tsu tuka̱i ta̱ n kugoyi,</para>
  <para style="q2" vid="PRO 29:23">ama ma̱riki mita̱ a kutuka̱ n tsugbayin.<verse eid="PRO 29:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24" />Vuma na de dem u yaꞋan cija̱Ꞌa̱ n koboki, u ciga wuma u ni ba.</para>
  <para style="q2" vid="PRO 29:24">ɗa baci a ɗeke ni tsugan ubuta̱ wa afada, u kupaɗa ta̱ bini.<verse eid="PRO 29:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25" />Kupana ku wovon u vuma, maza maꞋa</para>
  <para style="q2" vid="PRO 29:25">ama vuza na uzuwakai Ka̱shile a̱pa̱m u kuciya̱ ta̱ ma̱ta̱na̱.<verse eid="PRO 29:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26" />Uma n a̱bunda̱i a̱ tsu la̱nsa̱ ta̱ ucigi ubuta̱ wa ngono,</para>
  <para style="q2" vid="PRO 29:26">ama afada usuɓi, a Ka̱shile ka a ɗa i.<verse eid="PRO 29:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27" />I na vuza vu usuɓi u cigai ba, i ɗa kayan ka uwa,</para>
  <para style="q2" vid="PRO 29:27">i na tankpamu vuza gbanigbani u cigai ba, i ɗa vuza vu usuɓi.<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" sid="PRO 30" />
  <para style="s1">Akaka a Agu</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1" />Akaka a Agu kolobo ka Yake.</para>
  <para style="q1" vid="PRO 30:1">Vuma va u danai, Vuzavaguɗu Ka̱shile moꞋuta̱</para>
  <para style="q2" vid="PRO 30:1">Mpa moꞋuta̱, Vuzavaguɗu, utsura u va̱ u kotso ta̱.<verse eid="PRO 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 30:2" />Mayun mpa n lata̱ ya ba dem tsulau.</para>
  <para style="q2" vid="PRO 30:2">mi n kuyeve tsu uma.<verse eid="PRO 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3" />Mpa n la̱nsa̱ kuyeve ku ugboji ba,</para>
  <para style="q2" vid="PRO 30:3">mpa kpamu n yeve vuza ciɗa vu nanlo ba.<verse eid="PRO 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4" />Ya yi u sawai ku kumba gaɗi ɗa u cipa̱i?</para>
  <para style="q2" vid="PRO 30:4">Ya yi u sawai kureme wunla̱ a kataka ka kukiye ka ni?</para>
  <para style="q1" vid="PRO 30:4">Ya yi u sawai ku ka̱ta̱la̱ mini a kuminya ku ni?</para>
  <para style="q2" vid="PRO 30:4">Ya yi kpamu u shikpa̱i uteku wu uduniya?</para>
  <para style="q1" vid="PRO 30:4">Ya yi a ci ɗeke kula ku ni, kpamu ya yi a ci ɗeke kula ku maku ma̱ ni?</para>
  <para style="q2" vid="PRO 30:4">Dana mu, vu yeve ba ci.<verse eid="PRO 30:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5" />Kadanshi ka Ka̱shile ra̱ka̱ mayun ɗa,</para>
  <para style="q2" vid="PRO 30:5">ma̱ra̱ga̱ ma a, wa aza na a̱ la̱nsa̱i kusheɗeku wa̱ a̱ ni.<verse eid="PRO 30:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6" />Ka̱ta̱ vu doku kadanshi ka̱ ni ba,</para>
  <para style="q2" vid="PRO 30:6">ta lo wa ku dansuka wu ka̱ta̱ vokpo kayan ka uwa.<verse eid="PRO 30:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7" />Vuzavaguɗu i li ire i ɗa n la̱nsa̱i wa̱ nu,</para>
  <para style="q2" vid="PRO 30:7">yaꞋan ka mu i ɗa kafu n kuwa̱.<verse eid="PRO 30:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8" />Takpa ukuna wa uwa u bana dangi n mpa,</para>
  <para style="q2" vid="PRO 30:8">ka̱ta̱ vu neke mu uciyi ko unambi ba,</para>
  <para style="q2" vid="PRO 30:8">ama neke mu ilikulya derere n ucigi u va̱,<verse eid="PRO 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9" />ta lo ma cuwa̱ ka̱ta̱ n cinukpa n a̱vu,</para>
  <para style="q2" vid="PRO 30:9">ka̱ta̱ n dana &lt;&lt;Ya yi Vuzavaguɗu&gt;&gt;</para>
  <para style="q1" vid="PRO 30:9">ko kpamu n namba ka̱ta̱ n boko,</para>
  <para style="q2" vid="PRO 30:9">ka̱ta̱ n la̱nga̱sa̱ kula ku ka Ka̱shile ka̱ va̱.<verse eid="PRO 30:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10" />Ka̱ta̱ vu la̱nga̱sa̱ kagbashi kula ubuta̱ u vuzagbayin vu ni ba,</para>
  <para style="q2" vid="PRO 30:10">ta lo va yaꞋan unushi u na a kila̱kpa̱ wu.<verse eid="PRO 30:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11" />N kukece ta̱ ili gbaniꞋgbani i na̱shi i na uma a ci yaꞋan,</para>
  <para style="q2" vid="PRO 30:11">aza yoku a ci shika ta̱ ishekpu i le</para>
  <para style="q2" vid="PRO 30:11">ka̱ta̱ a̱ kpa̱ɗa̱ ku cikpa ina̱kpu i le.<verse eid="PRO 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12" />Aza yoku a ce ene ta̱ ka̱cika̱le i ta̱ ciɗa,</para>
  <para style="q2" vid="PRO 30:12">ashe tana i ta̱ nu unata.<verse eid="PRO 30:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13" />Aza yoku i ta̱ na a̱ra̱ɗi,</para>
  <para style="q2" vid="PRO 30:13">a ci ɗika ta̱ ka̱cika̱le e le va ili yoku i ɗa.<verse eid="PRO 30:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 30:14" />Aza yoku anga e le otokobi a ɗa,</para>
  <para style="q2" vid="PRO 30:14">atakpamkpatsu e le kpamu mawun ɗa,</para>
  <para style="q1" vid="PRO 30:14">adama na okotsotongu aza unambi uduniya ra̱ka̱,</para>
  <para style="q2" vid="PRO 30:14">n ofoloni ra̱ka̱ a ka̱tsuma̱ ka uma.<verse eid="PRO 30:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15" />Kutsa̱n ki ta̱ n nkere nre. A ci ɗeke le ta̱.</para>
  <para style="q2" vid="PRO 30:15">Nemu koɓolo n Nemu.</para>
  <para style="q1" vid="PRO 30:15">Ili tatsu yi ta̱ lo i na i ci cuwa̱ ba,</para>
  <para style="q2" vid="PRO 30:15">Ali i na̱shi i na i ci dana &lt;&lt;U yawa mu ta̱ ba.&gt;&gt;<verse eid="PRO 30:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 30:16" />E le ɗa, asaun, n ka̱tsa̱ma̱ ka madari ma na ma maci ba,</para>
  <para style="q2" vid="PRO 30:16">n iɗika i na ka̱ta̱ i cuwa̱i n mini ba,</para>
  <para style="q2" vid="PRO 30:16">n akina a na a sawai ku dana, &lt;&lt;U yawa mu ta̱ ba,&gt;&gt;<verse eid="PRO 30:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17" />A̱shi a na o goyoi dada</para>
  <para style="q2" vid="PRO 30:17">ɗa a iwain kucikpa mma</para>
  <para style="q1" vid="PRO 30:17">agawun a kuyene i ta̱ a kuta̱sa̱ a ɗa</para>
  <para style="q2" vid="PRO 30:17">ka̱ta̱ asakali a takuma le.<verse eid="PRO 30:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 30:18" />I li itatsu ɗa yi a ku neke mu mereve,</para>
  <para style="q2" vid="PRO 30:18">a li i na̱shi i na n yeve ba<verse eid="PRO 30:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 30:19" />u teku tsu na kajimba ka tsu wala gaɗi,</para>
  <para style="q2" vid="PRO 30:19">u teku tsu na koko ka tsu wala a katali,</para>
  <para style="q1" vid="PRO 30:19">u teku tsu na kpantsu ku tsu wala a mini,</para>
  <para style="q2" vid="PRO 30:19">n uteku tsu na mavali ma tsu yaꞋan n mekere.<verse eid="PRO 30:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20" />Na ɗa u teku tsu na kashakanlai ki</para>
  <para style="q2" vid="PRO 30:20">u lyaꞋa ba ci ka̱ta̱ u gboro una̱</para>
  <para style="q2" vid="PRO 30:20">ka̱ta̱ u dana, &lt;&lt;Mpa n yaꞋan u nushi ba.&gt;&gt;<verse eid="PRO 30:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 30:21" />I li yi ta̱ lo i na̱shi</para>
  <para style="q2" vid="PRO 30:21">i na vuza u duniya u ku fuɗa ku yaꞋan ahankuri i ɗa ba,<verse eid="PRO 30:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 30:22" />kagbashi ɗa baci kokpoi mogono,</para>
  <para style="q2" vid="PRO 30:22">n kalau a yaꞋan na baci ka̱cuwa̱i n ilikulya,<verse eid="PRO 30:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 30:23" />ɗa baci vuka vu unambi u mapasa u ciya̱i vali,</para>
  <para style="q2" vid="PRO 30:23">n kagbashi ka na ka gadai a̱na̱ku a̱ ni.<verse eid="PRO 30:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 30:24" />I li i kenu i na̱shi feu yi ta̱ lo u duniya,</para>
  <para style="q2" vid="PRO 30:24">ama i ta̱ n ugboji ka̱u,<verse eid="PRO 30:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 30:25" />Ojuno i nu utsura ba,</para>
  <para style="q2" vid="PRO 30:25">ama a tsu la̱nsa̱ ta̱ ilikulya i le n lyushi<verse eid="PRO 30:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 30:26" />Rema nnama n ɗa n na mi babu utsura,</para>
  <para style="q2" vid="PRO 30:26">ama dem n nanai a ci maꞋa ta̱ i uwa i le a tali,<verse eid="PRO 30:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 30:27" />Akyun i n mogono ba,</para>
  <para style="q2" vid="PRO 30:27">ama dem n nanai a tsu wala ta̱ magaba,<verse eid="PRO 30:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 30:28" />Karagba, vi ta̱ a kufuɗa vu ka̱na̱i n ekiye,</para>
  <para style="q2" vid="PRO 30:28">dem n nanai a tsu uwa ta̱ a kefeku ka mogono.<verse eid="PRO 30:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 30:29" />Ili i tatsu yi ta̱ lo,</para>
  <para style="q2" vid="PRO 30:29">ali i na̱shi i na i tsu wala n atankama.<verse eid="PRO 30:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 30:30" />E le ɗa kawu, a̱ yi na ulai ya ba dem mgbayin a ka̱tsuma̱ ka nnama,</para>
  <para style="q2" vid="PRO 30:30">a̱ yi na u tsu kpatala adama a vu toku ba,<verse eid="PRO 30:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 30:31" />n kepen ki isali n ma̱ga̱ji,</para>
  <para style="q2" vid="PRO 30:31">koɓolo n mogono ma na mi koɓolo n osoji a̱ ni.<verse eid="PRO 30:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32" />Ɗa baci vi ɗe a tsulau, a ku yaꞋanka ka̱cika̱ nu a̱ra̱ɗi</para>
  <para style="q2" vid="PRO 30:32">ko kpamu a fama an foɓo adama kagbani-gbani,</para>
  <para style="q2" vid="PRO 30:32">to pala una̱ u nu n kukiye.<verse eid="PRO 30:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33" />tsu na kukuciwa ku mani ku tsu tuka̱ n maniꞋin,</para>
  <para style="q2" vid="PRO 30:33">u pinda̱ri u vunu kpamu u zuwa mpasa mu uta̱ a vunu,</para>
  <para style="q2" vid="PRO 30:33">ta feu wupa u tsu tuka̱ n vishili nanai.<verse eid="PRO 30:33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" sid="PRO 31" />
  <para style="s1">Kadanshi ka mogono Lemuwelu</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1" />Na ɗa kadanshi ka mogono Lemuwelu. Kana a̱na̱ku a̱ ni o yotsongi ni.<verse eid="PRO 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2" />Yiɗa̱i vi a kuyaꞋan maku ma̱ va̱? Yiɗa̱i vi a kuyaꞋan maku ma̱ va̱, maku ma̱ va̱ ma na n matsai?</para>
  <para style="q2" vid="PRO 31:2">Yiɗa̱i vi a kuyaꞋan, maku ma a kucina ma va̱?<verse eid="PRO 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 31:3" />Ka̱ta̱ vu neke katsura ka̱ nu ubuta̱ wa a̱ma̱ci ba,</para>
  <para style="q2" vid="PRO 31:3">ko kpamu vu bonoko ugboji u nu wa aza na a tsu takacika ngono.<verse eid="PRO 31:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4" />Ugain u ɗa a vu Lemuwelu,</para>
  <para style="q2" vid="PRO 31:4">Ugan mogono ma soꞋo ma̱ra̱ ba,</para>
  <para style="q2" vid="PRO 31:4">ko ngono n soꞋo ma̱ra̱ mu utsura ba,<verse eid="PRO 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5" />ta lo a ta̱wa̱ a cinukpa n wila̱ u na o tonoi,</para>
  <para style="q2" vid="PRO 31:5">ka̱ta̱ a iwan kamayun ka uma a na o doroi.<verse eid="PRO 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6" />Neke vuza na wi a ku kuwa̱ ma̱ra̱ mu utsura,</para>
  <para style="q2" vid="PRO 31:6">ma̱kya̱n tamkpamu wa aza na i nu una̱mgbi u ka̱tsuma̱,<verse eid="PRO 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7" />ka̱sukpa̱i le o soꞋo ka̱ta̱ a cinukpa n unambi u le</para>
  <para style="q2" vid="PRO 31:7">a̱ kpa̱ɗa̱ ku ciɓa n atakaci e le kpamu.<verse eid="PRO 31:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8" />YaꞋan kadanshi adama ebebe a na a tsu dansa ba,</para>
  <para style="q2" vid="PRO 31:8">na aza na i na a̱ɓa̱nki ba.<verse eid="PRO 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9" />Ɓa̱yuwa̱ una̱ adama na vu dansa afada asingai,</para>
  <para style="q2" vid="PRO 31:9">ɓa̱nka̱ aza unambi n ofoloni.<verse eid="PRO 31:9" /></para>
  <para style="s1">Vuka vu na vu tsu pana wovon u Ka̱shile</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 31:10" />Yayi wa kufuɗa ku ciya̱ vuka vu usuɓi?</para>
  <para style="q2" vid="PRO 31:10">U lata̱ kazanariya ugain.<verse eid="PRO 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11" />Vali ni u tsu ushuku ta̱ n a̱yi,</para>
  <para style="q2" vid="PRO 31:11">ka̱ta̱ tana u ciya̱ ili ra̱ka̱ i na u cigai.<verse eid="PRO 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12" />U tsu yaꞋankai ta̱ kasingai, ba ka gbani-gbani ba,</para>
  <para style="q2" vid="PRO 31:12">a ayin a wuma a̱ ni dem.<verse eid="PRO 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13" />U tsu la̱nsa̱ ta̱ tsugbere tsu tsuzogu ka̱ta̱ u yaꞋan kuca n ekiye a̱ ni n ma̱ta̱na̱.<verse eid="PRO 31:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14" />Wi ta̱ an kpantsu ka aza tsulaga,</para>
  <para style="q2" vid="PRO 31:14">u tsu tuka̱ ta̱ n ilikulya i ni dangi.<verse eid="PRO 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15" />U tsu ɗa̱nga̱ ta̱ n kpasani</para>
  <para style="q2" vid="PRO 31:15">ka̱ta̱ u yaꞋanka aza a kpaꞋa ilikulya</para>
  <para style="q2" vid="PRO 31:15">ka̱ta̱ u buka kpamu abara a̱ ni.<verse eid="PRO 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16" />U tsu la̱na̱ ta̱ kashina mayin kafu u tsula,</para>
  <para style="q2" vid="PRO 31:16">n atakaci ulinga a̱ ni a ɗa u tsu shikpa̱ kashina ka nɗanga.<verse eid="PRO 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17" />U tsu zuwa ta̱ ka̱ɗu</para>
  <para style="q2" vid="PRO 31:17">ka̱ta̱ u yaꞋan ulinga n utsura.<verse eid="PRO 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18" />U tsu yeve ta̱, ɗa baci kodokpotsu ka uwa ni.</para>
  <para style="q2" vid="PRO 31:18">ma̱kuni ma̱ ni ma tsu yongo ta̱ a kutasa ali kayin washi.<verse eid="PRO 31:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19" />Na ekiye a̱ ni a ɗa u tsu ka̱na̱ tsugbere</para>
  <para style="q2" vid="PRO 31:19">na ekiye a̱ ni a ɗa kpamu u tsu yaꞋan kucaꞋa.<verse eid="PRO 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20" />U tsu neke ta̱ aza unambi ba̱ri,</para>
  <para style="q2" vid="PRO 31:20">koɓolo n ofoloni feu nanai.<verse eid="PRO 31:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21" />U tsu pana wovon u a yaꞋan uta̱ni ba,</para>
  <para style="q2" vid="PRO 31:21">adama na muku n ni ra̱ka̱ mita̱ ntogu mu uta̱ni.<verse eid="PRO 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22" />U tsu caꞋa ka ta̱ ka̱cika̱ni mayaga ma a̱ga̱da̱,</para>
  <para style="q2" vid="PRO 31:22">aminya a̱ ni tsugbere tsu ɗa tsu singai tsu mini ma garula.<verse eid="PRO 31:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23" />Vali ni vuza vu uyevi ɗa o koɓolo ka uma</para>
  <para style="q2" vid="PRO 31:23">ɗa baci u da̱sa̱ngi koɓolo n tsugbayin tsu likuci.<verse eid="PRO 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24" />U tsu caꞋa ta̱ aminya a tsugbere ka̱ta̱ u denge.</para>
  <para style="q2" vid="PRO 31:24">U tsu denke ta̱ a za tsulaga aɗambura.<verse eid="PRO 31:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25" />Uciyi koɓolo n usuɓi u ɗa aminya a̱ ni,</para>
  <para style="q2" vid="PRO 31:25">wi ta̱ o ku zoꞋoso a a yaꞋan e kelime.<verse eid="PRO 31:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26" />U tsu yaꞋan ta̱ kadanshi n ugboji,</para>
  <para style="q2" vid="PRO 31:26">kuyotsongu ku ni ku singai ku ɗa.<verse eid="PRO 31:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27" />U tsu la̱na̱ ta̱ muku ni mayin,</para>
  <para style="q2" vid="PRO 31:27">a̱ yi ili bura yi n wonvoli ba.<verse eid="PRO 31:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28" />Muku ni n tsu ɗa̱ngu ta̱ ka̱ta̱ a cikpai</para>
  <para style="q2" vid="PRO 31:28">vali ni feu u tsu cikpai ta̱.<verse eid="PRO 31:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29" />U tsu dana ta̱, &lt;&lt;A̱ma̱ci n a̱bunda̱i a tsu yaꞋan ta̱ i na a cikpa le,</para>
  <para style="q2" vid="PRO 31:29">ama avu vu laꞋa le ta̱ dem.&gt;&gt;<verse eid="PRO 31:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30" />KuyaꞋan ku gaye u kuna u gbani u ɗa,</para>
  <para style="q2" vid="PRO 31:30">ama vuka vu na vu tsu pana wovon u Ka̱shile, a̱ yi ɗa ili ku cikpa.<verse eid="PRO 31:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31" />Neke ni katsupu ka atakaci ulinga a̱ ni,</para>
  <para style="q2" vid="PRO 31:31">ka̱ta̱ ugain wu ulinga u ni kpamu wu utuka̱i e keteshe.<verse eid="PRO 31:31" /></para>
  <chapter eid="PRO 31" />
</usx>