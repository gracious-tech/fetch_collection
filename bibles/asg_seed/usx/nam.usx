<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="NAM" style="id">- Cishingini Agwara Kambari [asg]</book>
  <para style="toc3">Nah</para>
  <para style="toc2">Nahum</para>
  <para style="toc1">Katagarda ka Nahum</para>
  <para style="mt2">Keneki</para>
  <para style="mt">Nahum</para>
  <para style="imt">Kuɓa̱yuwa̱</para>
  <para style="im">Katagarda ka Nahum ka ishipa i ma̱za̱nga̱ i ɗa adama a̱ uyikpi u Niniva, likuci i gbayin i Asiriya i na yi a tsurala n Isaraila. Ugan ba a ɗana ta̱ katagarda ka a ka̱ya̱ ka (612) kafu a matsa Yesu. I ta̱ e kene uyikpi u Niniva atakaci a̱ Ka̱shila̱ a ɗa adama a ugbamukaci u ni n ka gbani-gbani ka̱ ni. Atakaci a nampa a̱ ta̱wa̱ ta̱ a ukocishi u tsumani ci cindere kafu a matsa Yesu.</para>
  <para style="iot">Ili i na yi punu udari</para>
  <para style="io1">Afada adama a Niniva 1:1-15</para>
  <para style="io1">Uyikpi u Niniva 2:1; 3:19</para>
  <chapter number="1" style="c" sid="NAM 1" />
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1" />Akaka adama a Niniva. Na lo va ɗaɗa katagarda ka kene ka na keneki Nahum vuza va aza a Elikoshi we enei.<verse eid="NAM 1:1" /></para>
  <para style="s1">Wupa u Vuzavaguɗu adama a Niniva</para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 1:2" />Vuzavaguɗu Ka̱shile vuza cisheꞋe ɗa,</para>
  <para style="q2" vid="NAM 1:2">vuza na u ci yaꞋan katsupu,</para>
  <para style="q1" vid="NAM 1:2">Vuzavaguɗu vuza katsupu ɗa,</para>
  <para style="q2" vid="NAM 1:2">vuza va asuvu a usuɗukpi kpamu.</para>
  <para style="q1" vid="NAM 1:2">Vuzavaguɗu u tsu tsupa ta̱ irala i ni,</para>
  <para style="q2" vid="NAM 1:2">u tsu bonoko ta̱ wupa u ni a̱ ubuta̱ wi irala i ni.<verse eid="NAM 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 1:3" />Vuzavaguɗu vuza wupa ɗa gogoꞋo ba,</para>
  <para style="q2" vid="NAM 1:3">ama vuza tsu tsugbayin n utsura ɗa,</para>
  <para style="q2" vid="NAM 1:3">Vuzavaguɗu wi a̱ kukpa̱ɗa̱ kutakacika vuza vu unushi ba.</para>
  <para style="q1" vid="NAM 1:3">Uye u na Vuzavaguɗu u tsu wala, kabatalikpau ka gbayin ka tsu vugula̱ ta̱,</para>
  <para style="q2" vid="NAM 1:3">eleshu kpamu ɗaɗa kubuta̱ ku ene a̱ ni.<verse eid="NAM 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 1:4" />U tsu ɓarangu ta̱ mala ali me ɗekpe,</para>
  <para style="q2" vid="NAM 1:4">u tsu zuwa ta̱ nyeneke ra̱ka̱ n ɗekpe.</para>
  <para style="q1" vid="NAM 1:4">ali n ubuta̱ u kalina a Bashan nu nsasan n Kamelu dem,</para>
  <para style="q2" vid="NAM 1:4">a na i n mita̱ ma̱ ta̱ku nu nɗanga n tsu ɗekpe ta̱,</para>
  <para style="q2" vid="NAM 1:4">a̱pa̱lu a Lebano dem a tsu lumba ta̱.<verse eid="NAM 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 1:5" />Nsasan m gbagbaꞋin n tsu gba̱ɗa̱ ta̱ e kelime ka̱ ni,</para>
  <para style="q2" vid="NAM 1:5">aginda kpamu a tsu derikpe ta̱.</para>
  <para style="q1" vid="NAM 1:5">Ka̱ta̱ iɗika i jengeɗe e kelime ka̱ ni,</para>
  <para style="q2" vid="NAM 1:5">e, ali aduniyan koɓolo n ili i na yi punu dem.<verse eid="NAM 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 1:6" />Yayi wa kufuɗa kushamgba e kelime ka̱ ni, u yaꞋan baci wupa?</para>
  <para style="q2" vid="NAM 1:6">Yayi wa kufuɗa kugbama asuvu e kelime ka̱ ni, ɗa baci u yaꞋin wupa?</para>
  <para style="q1" vid="NAM 1:6">Wupa u ni u tsu va̱ma̱ ta̱ tsa akina,</para>
  <para style="q2" vid="NAM 1:6">akpanlai a gbagbaꞋin o tsu ɓoso ta̱ e kelime ka̱ ni.<verse eid="NAM 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 1:7" />Vuzavaguɗu vuza singai ɗa,</para>
  <para style="q2" vid="NAM 1:7">ubuta̱ u kusheɗeku u ɗa wi a kanna ka atakaci.</para>
  <para style="q1" vid="NAM 1:7">U tsu ere ta̱ aza a na a̱ tsu sheɗeku wa̱ a̱ ni.<verse eid="NAM 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 1:8" />Ama tsu mini ma na ma ayai wi ta̱ a kuniꞋwa̱nta̱ngu irala i ni ra̱ka̱,</para>
  <para style="q2" vid="NAM 1:8">wi ta̱ a kuyawaka Niniva uteku,</para>
  <para style="q2" vid="NAM 1:8">ka̱ta̱ u loko aza a na a iwain ni a kubana a̱ ka̱yimbi.<verse eid="NAM 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 1:9" />Yiɗa̱i i zuwai ɗa yi a kushiya tsurala n Vuzavaguɗu?</para>
  <para style="q2" vid="NAM 1:9">Ili ra̱ka̱ ko yiɗa̱i baci wi ta̱ a kubonoko i ɗa gbani,</para>
  <para style="q2" vid="NAM 1:9">babu vuza na u kuyaꞋan tsurala n a̱yi kure.<verse eid="NAM 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 1:10" />Irala i ni,</para>
  <para style="q2" vid="NAM 1:10">i ta̱ ugbaɓi tsa awana,</para>
  <para style="q1" vid="NAM 1:10">i ta̱ an osoꞋi a na a osoꞋi ma̱ra̱ ma makai le,</para>
  <para style="q2" vid="NAM 1:10">a n nwalu n a tangalangi a maza me le,</para>
  <para style="q1" vid="NAM 1:10">i ta̱ o kusongu le ra̱ka̱,</para>
  <para style="q2" vid="NAM 1:10">an mita̱ me ɗekpu.<verse eid="NAM 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 1:11" />Punu a̱ ka̱tsuma̱ ka Niniva, ɗa vuza yoku wu uta̱i,</para>
  <para style="q2" vid="NAM 1:11">vuza na u foɓusoi ka gbani-gbani a kubana u Vuzavaguɗu,</para>
  <para style="q1" vid="NAM 1:11">u nekei odoki a gbani-gbani.<verse eid="NAM 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NAM 1:12" />Ili i na Vuzavaguɗu u danai i ɗaɗa na,</para>
  <para style="q1" vid="NAM 1:12">&lt;&lt;A̱ɗa̱ aza Asuriya, ko a na wo okpoi yi ta̱ n ka̱bunda̱i,</para>
  <para style="q2" vid="NAM 1:12">tukpa n utsura kpamu,</para>
  <para style="q2" vid="NAM 1:12">i ta̱ kugbatya ɗa̱, ka̱ta̱ a takpa ɗa̱.</para>
  <para style="q1" vid="NAM 1:12">A̱ɗa̱ aza a Yahuda, ko a na wo okpoi n neke ɗa̱ ta̱ atakaci,</para>
  <para style="q2" vid="NAM 1:12">mi o kudoku ma takacika ɗa̱ kpamu ba.<verse eid="NAM 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 1:13" />Gogo na mi ta̱ o kukoɗo kogboro ke eɗeku a̱ ɗa̱,</para>
  <para style="q2" vid="NAM 1:13">ka na aza Niniva a zuwakai ɗa̱,</para>
  <para style="q1" vid="NAM 1:13">ka̱ta̱ kpamu n kasa ikani,</para>
  <para style="q2" vid="NAM 1:13">i na a shiyakai ɗa̱.&gt;&gt;<verse eid="NAM 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="NAM 1:14" />Vuzavaguɗu u neke ta̱ kadanshi,</para>
  <para style="q2" vid="NAM 1:14">adama a Niniva u danai,</para>
  <para style="q1" vid="NAM 1:14">&lt;&lt;I o kudoku kupana kula ku nu ba.</para>
  <para style="q2" vid="NAM 1:14">A̱ma̱li u sheꞋwei n uluwi a̱ nu,</para>
  <para style="q2" vid="NAM 1:14">mi ta̱ a kukapa a ɗa a̱ ka̱tsuma̱ ka a̱Ꞌisa̱ a̱ma̱li a̱ nu,</para>
  <para style="q1" vid="NAM 1:14">ka̱ta̱ n foɓuso ko wu kasaun,</para>
  <para style="q2" vid="NAM 1:14">adama a na avu ili i ma̱riki i ɗa ba.&gt;&gt;<verse eid="NAM 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 1:15" />La̱na̱, a gaɗi vu nsasan m gbagbaꞋin,</para>
  <para style="q2" vid="NAM 1:15">ene a vuza na u tsu tuka̱ n arabali a singai a ɗa na,</para>
  <para style="q2" vid="NAM 1:15">a̱yi na u tsu sala ukuna u ma̱ta̱na̱.</para>
  <para style="q1" vid="NAM 1:15">Avu Yahuda, zuwa ka̱ɗiva̱ a̱ nu,</para>
  <para style="q2" vid="NAM 1:15">Shatangu uzuwakpani u nu.</para>
  <para style="q1" vid="NAM 1:15">Adama a na ili i gbani-gbani i nanlo Niniva,</para>
  <para style="q2" vid="NAM 1:15">a takpai ta̱ ra̱ka̱.</para>
  <para style="q2" vid="NAM 1:15">i ta̱ a ku una le ra̱ka̱-ra̱ka̱.<verse eid="NAM 1:15" /></para>
  <chapter eid="NAM 1" />
  <chapter number="2" style="c" sid="NAM 2" />
  <para style="s1">Uyikpi u Niniva</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 2:1" />Vuza munuka u foɓuso ta̱, avu Niniva,</para>
  <para style="q2" vid="NAM 2:1">u zuwa ta̱ osoji a mashilya ma̱ likuci ma.</para>
  <para style="q1" vid="NAM 2:1">a yaꞋan kindi ku ubuta̱ u kusheɗeku wu n nshilya,</para>
  <para style="q2" vid="NAM 2:1">foɓuso mayin,</para>
  <para style="q2" vid="NAM 2:1">ɓolongu osoji a̱ nu ra̱ka̱.<verse eid="NAM 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 2:2" />Adama a na Vuzavaguɗu wi ta̱ o kubonoko,</para>
  <para style="q2" vid="NAM 2:2">n ugaꞋin u Yahuda n wa aza a Isaraila ra̱ka̱,</para>
  <para style="q1" vid="NAM 2:2">ko ɗa baci aza a̱ kupura̱ uciyi,</para>
  <para style="q2" vid="NAM 2:2">a̱ pura̱i uciyi u likuci u le ra̱ka̱,</para>
  <para style="q2" vid="NAM 2:2">ko ɗa baci a̱ la̱nga̱sa̱i a shina a̱ nɗimbi e le.<verse eid="NAM 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 2:3" />Nra̱ga̱ mo osoji ma aza a Niniva n na n fuɗai kuvon,</para>
  <para style="q2" vid="NAM 2:3">n shilyamgba ta̱ ushili,</para>
  <para style="q1" vid="NAM 2:3">osoji i ta̱ u uki,</para>
  <para style="q2" vid="NAM 2:3">n akashi a̱ shili.</para>
  <para style="q1" vid="NAM 2:3">Ekeke o doku e le a kutasa,</para>
  <para style="q2" vid="NAM 2:3">tsu melentsu ma akina,</para>
  <para style="q2" vid="NAM 2:3">a̱ kuɗa̱ngusa̱ nsara e kuneke le wovon.<verse eid="NAM 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 2:4" />Odoku, n ekeke odoku o kuvon,</para>
  <para style="q2" vid="NAM 2:4">a̱ ka̱na̱i ilaɗi i kavama a uye,</para>
  <para style="q1" vid="NAM 2:4">a kubana n obonoi,</para>
  <para style="q2" vid="NAM 2:4">punu asuvu a̱ ka̱ba̱nga̱ ka̱ likuci.</para>
  <para style="q1" vid="NAM 2:4">ku uta̱ ku le tsu kutashi ku ma̱kuni ku ɗa,</para>
  <para style="q2" vid="NAM 2:4">a nwalu a na ulaɗi.<verse eid="NAM 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 2:5" />Mogono ma Niniva me ɗekei osoji a gbagbaꞋin a̱ ni,</para>
  <para style="q2" vid="NAM 2:5">ɗa a̱ ka̱na̱i ku ta̱ɗa̱tsa̱ n yikpa̱i a uye a̱ kuta̱wa̱.</para>
  <para style="q1" vid="NAM 2:5">A dakakai a kubana a mashilya ma̱ likuci ma,</para>
  <para style="q2" vid="NAM 2:5">ɗa a̱ shikpa̱i i na i kere le.<verse eid="NAM 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 2:6" />A̱ ɓa̱yuwa̱i adaɓa a̱ mini,</para>
  <para style="q2" vid="NAM 2:6">ɗa kpaꞋa ku mogono ku ripula̱i.<verse eid="NAM 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 2:7" />O foɗoi Egbere aminya ɗa a lazai n a̱yi,</para>
  <para style="q2" vid="NAM 2:7">agbashi a nkere n ni a̱ ma̱shi,</para>
  <para style="q1" vid="NAM 2:7">ma̱shi ma kpalu me le tsu ma̱shi ma moɗoi ma a,</para>
  <para style="q2" vid="NAM 2:7">a zuwai ekiye e le aci.<verse eid="NAM 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 2:8" />Tsu mini ma na mo ɓosoi a̱ ka̱sha̱n,</para>
  <para style="q2" vid="NAM 2:8">aza a Niniva a kusuma a̱ ku uta̱ punu,</para>
  <para style="q1" vid="NAM 2:8">uma a kudana le &lt;&lt;Shamgbai! Shamgbai!&gt;&gt;</para>
  <para style="q2" vid="NAM 2:8">Ama babu vuza na u kpatalai wu indanai kucina̱.<verse eid="NAM 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 2:9" />Pura̱ngi azurufa.</para>
  <para style="q2" vid="NAM 2:9">Pura̱ngi azanariya.</para>
  <para style="q1" vid="NAM 2:9">Likuci ya yi ta̱ tukpa nu uciyi kakau,</para>
  <para style="q2" vid="NAM 2:9">uciyi u ni wi n uteku ba.<verse eid="NAM 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 2:10" />Niniva u na̱mgba̱ ta̱,</para>
  <para style="q2" vid="NAM 2:10">wo okpo ta̱ agali,</para>
  <para style="q2" vid="NAM 2:10">a̱ɗu a uma a̱ ni e derikpe ta̱,</para>
  <para style="q2" vid="NAM 2:10">a̱ka̱nga̱tsu e le e kujeꞋe,</para>
  <para style="q1" vid="NAM 2:10">a̱kyun e le kpamu a mɓa̱la̱,</para>
  <para style="q2" vid="NAM 2:10">a̱shi e le ra̱ka̱ a̱ ula̱nga̱shi.<verse eid="NAM 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 2:11" />Yiɗa̱i i ciya̱i likuci i Niniva,</para>
  <para style="q1" vid="NAM 2:11">i na yi tsu kpenle ki ikawu?</para>
  <para style="q1" vid="NAM 2:11">Kpenle ku na a̱ tsu ɓa̱na̱ muku mi ikawu,</para>
  <para style="q1" vid="NAM 2:11">ubuta̱ u na kawu n a̱ma̱ci e le a̱ tsu ka̱ra̱Ꞌa̱,</para>
  <para style="q2" vid="NAM 2:11">koɓolo n muku mi ikawu babu wovon.<verse eid="NAM 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 2:12" />Kawu u tsu saza ta̱ i na,</para>
  <para style="q2" vid="NAM 2:12">i yawai ni koɓolo m muku n ni,</para>
  <para style="q1" vid="NAM 2:12">ka̱ta̱ kpamu wu una ka vuka vu ni manama,</para>
  <para style="q2" vid="NAM 2:12">u shatangu kpenle ku ni n uciyi ugbani,</para>
  <para style="q2" vid="NAM 2:12">ungu a̱ ni kpamu nu nnama n kakamba.<verse eid="NAM 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 2:13" />Vuzavaguɗu u danai,</para>
  <para style="q2" vid="NAM 2:13">&lt;&lt;Mi ta̱ a tsurala n avu Niniva,</para>
  <para style="q1" vid="NAM 2:13">mi ta̱ o kusongu ekeke o odoku o kuvon a̱ nu,</para>
  <para style="q2" vid="NAM 2:13">ka̱ta̱ kotokobi ku una osoji a̱ nu aza a na i tsu ikawu,</para>
  <para style="q2" vid="NAM 2:13">mi ta̱ a̱ kusa̱nka̱ wu vu una uduniyan.</para>
  <para style="q2" vid="NAM 2:13">Ka̱ta̱ n sa̱nka̱ aza u suki a̱ nu kubanka n akaka a na e kuneke wovon.&gt;&gt;<verse eid="NAM 2:13" /></para>
  <chapter eid="NAM 2" />
  <chapter number="3" style="c" sid="NAM 3" />
  <para style="s1">Niniva wi ta̱ o ko okpo agali</para>
  <para style="p">
    <verse number="1" style="v" sid="NAM 3:1" />Ili ya atakaci i ɗa avu likuci i munuka,</para>
  <para style="q2" vid="NAM 3:1">a̱yi na u shanai tukpa n aꞋuwa a̱bunda̱i,</para>
  <para style="q1" vid="NAM 3:1">n ucanuku u na a isai.<verse eid="NAM 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 3:2" />Panai, izumgbi yi nshashau n yi ekeke,</para>
  <para style="q2" vid="NAM 3:2">n izumgbi ya ilaɗi yo odoku,</para>
  <para style="q2" vid="NAM 3:2">n kugba̱ɗa̱ ke ekeke o odoku.<verse eid="NAM 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 3:3" />Inda biꞋi akumbi odoku o kuvon,</para>
  <para style="q2" vid="NAM 3:3">otokobi nu nsara a kutasa tsa akina,</para>
  <para style="q1" vid="NAM 3:3">na ɗa koɓolo ka uma ka na unai,</para>
  <para style="q2" vid="NAM 3:3">na ɗa kaginga ke even a uma,</para>
  <para style="q1" vid="NAM 3:3">even a uma babu uteku,</para>
  <para style="q2" vid="NAM 3:3">uma a̱ kuta̱ɗa̱tsa̱ a gaɗi vu even a ikyamba.<verse eid="NAM 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 3:4" />Ili i nanlo ra̱ka̱ i yaꞋan ta̱ adama a tsugbani ci Niniva,</para>
  <para style="q2" vid="NAM 3:4">kashakanlai kasingai ka nanlo ka una̱ wu uyoꞋo,</para>
  <para style="q1" vid="NAM 3:4">ma̱ma̱ci mo tsuboci ma a,</para>
  <para style="q2" vid="NAM 3:4">a̱yi na u ya̱nsa̱i uduniyan ubuta̱ u tsugbani u ni,</para>
  <para style="q2" vid="NAM 3:4">uma kpamu a̱ ubuta̱ wa alaꞋwin a̱ ni.<verse eid="NAM 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 3:5" />Vuzavaguɗu malaꞋimili u danai, mi ta̱ a tsurala n avu,</para>
  <para style="q2" vid="NAM 3:5">mi ta̱ a̱ ku Va̱ga̱lukpa̱ ciyanpa tsu nu, ka̱ta̱ m palaka a̱shi a̱ ni.</para>
  <para style="q1" vid="NAM 3:5">Ka̱ta̱ n zuwa iɗika kakau yi ene ciyampa tsu nu,</para>
  <para style="q2" vid="NAM 3:5">ka̱ta̱ tsugono kpamu ce ene wono u nu.<verse eid="NAM 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 3:6" />Mi ta̱ a ku vishangu wu ili yu unata,</para>
  <para style="q2" vid="NAM 3:6">ka̱ta̱ n goyo wu,</para>
  <para style="q2" vid="NAM 3:6">n bonoko wu ili i kugoyi.<verse eid="NAM 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 3:7" />Aza a na e enei nu ra̱ka̱ i ta̱ a kusuma ka̱ta̱ a dana,</para>
  <para style="q2" vid="NAM 3:7">&lt;&lt;Niniva wo okpo ta̱ agali, ya yi u kuyaꞋan kpalu ku ni?&gt;&gt;</para>
  <para style="q2" vid="NAM 3:7">Te ɗai n kuciya̱ aza na e kuneke yi kadanshi ka uremi u ka̱ɗu?<verse eid="NAM 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 3:8" />Niniva, avu vu laꞋa ta̱ likuci i Tebesu,</para>
  <para style="q2" vid="NAM 3:8">i na yi a ka̱kina̱ ka kuyene ku Nilu,</para>
  <para style="q2" vid="NAM 3:8">m mini uka̱ra̱Ꞌi u ni dem?</para>
  <para style="q1" vid="NAM 3:8">Mala maꞋa ubuta̱ u kusheɗeku u ni,</para>
  <para style="q2" vid="NAM 3:8">mini maꞋa mashilya ma ni.<verse eid="NAM 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 3:9" />Itopiya m Masar ɗa utsura u ni,</para>
  <para style="q2" vid="NAM 3:9">Futu n Libiya ele ɗa a̱ tsu ɓa̱nka̱ yi,<verse eid="NAM 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 3:10" />N nannai dem a ɗikai ni,</para>
  <para style="q2" vid="NAM 3:10">a bankai ugbashi,</para>
  <para style="q1" vid="NAM 3:10">a minjarai aci a̱ muku n ni,</para>
  <para style="q2" vid="NAM 3:10">a nsanji mu uye dem.</para>
  <para style="q1" vid="NAM 3:10">A yaꞋin kazagba adama nkoshi m gba̱ra̱-gba̱ra̱ n ni</para>
  <para style="q2" vid="NAM 3:10">ɗa a shiyai uma a gbagbaꞋin a̱ ni dem ni ikani.<verse eid="NAM 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 3:11" />Avu a̱ ka̱ci ka̱ nu Niniva vi ta̱ o kusoꞋo ma̱ra̱ ma makau,</para>
  <para style="q2" vid="NAM 3:11">ka̱ta̱ vu takacika n a̱bunda̱i,</para>
  <para style="q2" vid="NAM 3:11">ali vu la̱nsa̱ ubuta̱ u kusheɗeku a̱ ubuta̱ wi irala i nu.<verse eid="NAM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 3:12" />Nshilya mu utsura u nu ra̱ka̱ mi ta̱ o ko okpo babu utsura,</para>
  <para style="q2" vid="NAM 3:12">i ta̱ a kulyaꞋa le tsu umaci u ma̱biri,</para>
  <para style="q2" vid="NAM 3:12">u na u geꞋwei,</para>
  <para style="q1" vid="NAM 3:12">a makyan ma na baci a̱ gba̱ɗa̱i maɗanga ma,</para>
  <para style="q2" vid="NAM 3:12">ka̱ta̱ umaci wa u yikpa̱ a̱ una̱ u vuza na u kulyaꞋa le.<verse eid="NAM 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 3:13" />La̱na̱ biꞋi osoji a̱ nu,</para>
  <para style="q2" vid="NAM 3:13">i ta̱ tsa a̱ma̱ci e mere ma̱ nu.</para>
  <para style="q1" vid="NAM 3:13">Utsutsu wi iɗika i nu yi ta̱ uɓa̱yuwi,</para>
  <para style="q2" vid="NAM 3:13">adama a irala i nu,</para>
  <para style="q2" vid="NAM 3:13">akina e leɓece ta̱ agbaguratsu e le.<verse eid="NAM 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="NAM 3:14" />Kenuku mini adama a na i ta̱ a ku kambuku wu,</para>
  <para style="q2" vid="NAM 3:14">tarai mini ma̱ a̱bunda̱i kafu kuvon ku yawa.</para>
  <para style="q1" vid="NAM 3:14">Doku katsura ka nshilya n nu,</para>
  <para style="q2" vid="NAM 3:14">bana a kadaɓa vu na̱na̱ ciꞋin,</para>
  <para style="q2" vid="NAM 3:14">ɗika ili kuyaꞋanka iputa̱.<verse eid="NAM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 3:15" />Dem n ofoɓuso a nampa,</para>
  <para style="q2" vid="NAM 3:15">akina a ɗa a kulyaꞋa wu,</para>
  <para style="q1" vid="NAM 3:15">kotokobi kpamu ki ta̱ a kugbatya kuɗeku ku nu.</para>
  <para style="q2" vid="NAM 3:15">Ka̱ta̱ a lyaꞋa wu tsa kakyuꞋun.</para>
  <para style="q1" vid="NAM 3:15">Vu doku ka̱bunda̱i ka̱ nu tsa akyuꞋun,</para>
  <para style="q2" vid="NAM 3:15">ɗa vu yimkpai n ka̱bunda̱i ci ishigi.<verse eid="NAM 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="NAM 3:16" />Vu doki ka̱bunda̱i ka aza a tsulaga a̱ nu,</para>
  <para style="q2" vid="NAM 3:16">ali a laꞋi ka̱bunda̱i ka azangata a gaɗi,</para>
  <para style="q1" vid="NAM 3:16">e le i ta̱ tsu nta̱ɗa̱ma̱ci n na n tsu ba̱ra̱kpa̱ evelyu e le,</para>
  <para style="q2" vid="NAM 3:16">ka̱ta̱ a imkpa a laza.<verse eid="NAM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="NAM 3:17" />Ngono n nu i ta̱ tsu nta̱ɗa̱ma̱ci,</para>
  <para style="q2" vid="NAM 3:17">nkoshi m gba̱ra̱-gba̱ra̱ n nu mi ta̱ an ka̱kuma̱ ka nta̱ɗa̱ma̱ci</para>
  <para style="q2" vid="NAM 3:17">a ku tele a̱ wuya̱n</para>
  <para style="q1" vid="NAM 3:17">a ayin a uta̱ni</para>
  <para style="q2" vid="NAM 3:17">ka̱ta̱ makyan ma na baci kanna ku uta̱i a imkpa a laza,</para>
  <para style="q2" vid="NAM 3:17">babu vuza na u yevei ubuta̱ u na a kubana.<verse eid="NAM 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="NAM 3:18" />Avu mogono ma Asiriya,</para>
  <para style="q2" vid="NAM 3:18">nguɓi n nu n lata ta̱,</para>
  <para style="q1" vid="NAM 3:18">e yevei a̱ nu a gbaɗika ta̱.</para>
  <para style="q2" vid="NAM 3:18">Uma a̱ nu a wacuwai a nsasan,</para>
  <para style="q2" vid="NAM 3:18">babu vuza na u ku ɓolongu le.<verse eid="NAM 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="NAM 3:19" />Babu i na i kupotsotongu untsu a̱ nu,</para>
  <para style="q2" vid="NAM 3:19">untsu a̱ nu a munuka a ɗa.</para>
  <para style="q1" vid="NAM 3:19">Vuza na baci de dem u panai arabali a̱ nu,</para>
  <para style="q2" vid="NAM 3:19">ka̱ta̱ u ɓasa ekiye u dana,</para>
  <para style="q1" vid="NAM 3:19">adama a na yayi u kpa̱ɗa̱i ku takacika,</para>
  <para style="q2" vid="NAM 3:19">ekiye a̱ nu?<verse eid="NAM 3:19" /></para>
  <chapter eid="NAM 3" />
</usx>