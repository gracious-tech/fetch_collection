<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="OBA" style="id">OBO - Cishingini Agwara Kambari [asg]</book>
  <para style="h">Obodiya</para>
  <para style="toc3">Obo</para>
  <para style="toc2">Obodiya</para>
  <para style="toc1">Katagarda ko Obodiya</para>
  <para style="mt1">Katagarda ko</para>
  <para style="mt2">Obodiya</para>
  <para style="imt">Kuɓa̱yuwa̱</para>
  <para style="im">Katagarda ke kenu ka nampa a ɗana ta̱ kaꞋa ayin atakaci, ana Urushelima u yikpa̱i a̱ ka̱ya̱ ka (586) kafu a matsa Yesu Kirisiti. Aza a Edom a na i a uɓon u ɗakai n tsugaɗi n Urushelima, ele irala ya aza a Yahuda i ɗa. A makyan ma na Urushelima u yikpa̱i, a yaꞋin ma̱za̱nga̱ n atakaci aza e le, a na a kupana asuvayali e le. Nannai koci ba ɗa a uwai a̱ pura̱i ucanuku u likuci wa, a̱ ɓa̱nka̱i aza a na a̱ tuka̱i likuci ya n kuvon. Obodiya u yaꞋin kene u danai, i ta̱ a kutakacika Edom, i ta̱ a kulyaꞋa yi n kuvon tsu na a kuyaꞋanka kagimi ka irala yi Isaraila.</para>
  <para style="iot">Ili i na yi punu udari a katagarda ka nampa</para>
  <para style="iot">1 Atakaci aza a Edom 1:1-14</para>
  <para style="iot">1 Kanna ka Vuzavaguɗu 1:15-21</para>
  <chapter number="1" style="c" sid="OBA 1" />
  <para style="s1">Kene ku uyikpi u Edom</para>
  <para style="p">
    <verse number="1" style="v" sid="OBA 1:1" />Na ɗa akaka a Vuzavaguɗu MalaꞋimili a na Obodiya wu enei tsa alatani a ukuna wu iɗika i Edom.<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="ISA 34:5-17">Ish 34:5-17</ref>; <ref loc="ISA 63:1-6">63:1-6</ref>; <ref loc="EZK 25:12-14">Ij 25:12-14</ref>; <ref loc="EZK 35:1-15">35:1-15</ref>; <ref loc="AMO 1:11-12">Em 1:11-12</ref>; <ref loc="MAL 1:2-5">Mal 1:2-5</ref></char></note></para>
  <para style="q1" vid="OBA 1:1">A̱ suki vuza vu usuki uduniyan,</para>
  <para style="q2" vid="OBA 1:1">ɗa kpamu tsu panai akaka u Vuzavaguɗu a danai,</para>
  <para style="q1" vid="OBA 1:1">&lt;&lt;Ɗenga̱i tsu bana ci yaꞋan kuvon n iɗika i Edom.&gt;&gt;<verse eid="OBA 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="OBA 1:2" />Vuzavaguɗu u danai,</para>
  <para style="q2" vid="OBA 1:2">La̱na̱, n kubonoko wu ta̱ vu okpo kenu a̱ ka̱tsuma̱ ku uduniyan u na u buwai,</para>
  <para style="q2" vid="OBA 1:2">i ta̱ o goyo wu ko kenu ba.<verse eid="OBA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="OBA 1:3" />A̱ra̱ɗi a̱ nu o doro wu ta̱ avu Edom,</para>
  <para style="q2" vid="OBA 1:3">avu na vi a̱ ida̱shi a kaɓatsu,</para>
  <para style="q2" vid="OBA 1:3">avu na vi a̱ ida̱shi a gaɗi vu nsasan m gbagbaꞋin,</para>
  <para style="q1" vid="OBA 1:3">a ku dana a̱ ka̱ɗu ka̱ nu,</para>
  <para style="q2" vid="OBA 1:3">&lt;&lt;Yayi u kufuɗa kucipa̱ka̱ mu a iɗika?&gt;&gt;<verse eid="OBA 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="OBA 1:4" />Ko vi ishi baci vi ɗimkpai gaɗi tsu mashangi,</para>
  <para style="q2" vid="OBA 1:4">ko vi ishi vu yaꞋan kpaꞋa a̱ ka̱tsuma̱ ka azangata,</para>
  <para style="q2" vid="OBA 1:4">mi ta̱ o kurono wu ɗe n cipa̱ka̱ a iɗika.<verse eid="OBA 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="OBA 1:5" />Ɗa baci oboki a uwai a kpaꞋa ku nu,</para>
  <para style="q2" vid="OBA 1:5">ɗa baci kpamu aza a̱ ma̱ga̱la̱ka̱ a̱ ta̱wa̱i nu n kayin,</para>
  <para style="q2" vid="OBA 1:5">i ta̱ a kuɗika ili i na a cigai ɗa.</para>
  <para style="q1" vid="OBA 1:5">ɗa baci kpamu oboki a umaci wu nɗanga a uwai a kashina ka̱ nu,</para>
  <para style="q2" vid="OBA 1:5">kuɗayu ku ɗa a̱ kuka̱sukpa̱ka̱ wu koci,<verse eid="OBA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="OBA 1:6" />Ama a̱ɗa̱ uma e Edom, kumaci ku Isuwa,</para>
  <para style="q2" vid="OBA 1:6">a una wu ta̱,</para>
  <para style="q2" vid="OBA 1:6">uciyi u ɗa̱ ra̱ka̱ a̱ pura̱ ta̱ u ɗa.<verse eid="OBA 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="OBA 1:7" />Uduniyan u na vu gbaɓai kaci n e le,</para>
  <para style="q2" vid="OBA 1:7">i ta̱ o kuloko wu a iɗika i nu.</para>
  <para style="q2" vid="OBA 1:7">i ta̱ a̱ kuya̱nsa̱ wu ka̱ta̱ a lyaꞋa wu n kuvon.</para>
  <para style="q1" vid="OBA 1:7">a̱ja̱Ꞌa̱ a na vi a kulyaꞋa ilikulya koɓolo n e le,</para>
  <para style="q2" vid="OBA 1:7">i ta̱ a ku azuku wu maza,</para>
  <para style="q2" vid="OBA 1:7">ka̱ta̱ a dana vi n ugboji ba.<verse eid="OBA 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="OBA 1:8" />Mpa Vuzavaguɗu n dana ta̱,</para>
  <para style="q1" vid="OBA 1:8">a kanna ka na n kutakacika Edom,</para>
  <para style="q2" vid="OBA 1:8">mi ta̱ a ku una aza a ugboji a Edom,</para>
  <para style="q2" vid="OBA 1:8">mi ta̱ a ku takpa aza e kuyeve a nsansa n Isuwa.<verse eid="OBA 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="OBA 1:9" />Teman, ovonshi a utsura a̱ nu i ta̱ a kupana wovon,</para>
  <para style="q2" vid="OBA 1:9">i ta̱ a ku una yaba dem a kusan ku Isuwa.<verse eid="OBA 1:9" /></para>
  <para style="s1">Unushi u Edom</para>
  <para style="q1">
    <verse number="10" style="v" sid="OBA 1:10" />Adama o kuyongo ku wuya ku na vu yaꞋankai vuza nu Yakubu,</para>
  <para style="q2" vid="OBA 1:10">vi ta̱ o ku okpo n wono,</para>
  <para style="q2" vid="OBA 1:10">i ta̱ a ku una wu ra̱ka̱-ra̱ka̱.<verse eid="OBA 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="OBA 1:11" />A kanna ka nanlo vu shamgbai a kakambu a kinda,</para>
  <para style="q2" vid="OBA 1:11">a makyan ma na irala a̱ pura̱i u uciyi u ni,</para>
  <para style="q2" vid="OBA 1:11">omoci kpamu o ɓosoi a̱ utsutsu u ni,</para>
  <para style="q2" vid="OBA 1:11">ɗa a taɗuki kazagba adama a Urushelima,</para>
  <para style="q2" vid="OBA 1:11">avu feu vu okpoi tsu vuza te a̱ ka̱tsuma̱ ke le.<verse eid="OBA 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="OBA 1:12" />U gaꞋan vu yaꞋan ma̱za̱nga̱ adama atakaci a na vuza nu u uwai ba.</para>
  <para style="q2" vid="OBA 1:12">U gaꞋan vu yaꞋan ma̱za̱nga̱ adama atakaci aza a Yahuda a kanna ka na i a ku una le ba.</para>
  <para style="q1" vid="OBA 1:12">U gaꞋan vu zoꞋoso le a kanna ka a atakaci e le ba.<verse eid="OBA 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="OBA 1:13" />U gaꞋan vu uwa a̱ likuci i uma a̱ va̱,</para>
  <para style="q2" vid="OBA 1:13">a kanna ka na i atakaci ba,</para>
  <para style="q2" vid="OBA 1:13">u gaꞋan vu yaꞋan ma̱za̱nga̱ adama a̱ ma̱dukpa̱ ma na ma̱ ciya̱i vuza nu ba.<verse eid="OBA 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="OBA 1:14" />U gaꞋan vu shamgba a nsanji mu uye vu una aza a na a cigai a laꞋaka ba.</para>
  <para style="q2" vid="OBA 1:14">u gaꞋan vu neke aza a na a sumai a laꞋakai ekiye a irala i le,</para>
  <para style="q2" vid="OBA 1:14">a kanna ka na atakaci ke le ba.<verse eid="OBA 1:14" /></para>
  <para style="s1">Kanna ka Vuzavaguɗu ki ta̱ ɗevu</para>
  <para style="q1">
    <verse number="15" style="v" sid="OBA 1:15" />Kanna ka na mpa Vuzavaguɗu n kuyaꞋanka, uduniya ra̱ka̱ afada ka yawa ta̱ ɗevu.</para>
  <para style="q1" vid="OBA 1:15">Avu Edom ili i na vu yaꞋin, i ta̱ feu a kuyaꞋanka wu i ɗa.</para>
  <para style="q2" vid="OBA 1:15">Ili i na vu yaꞋin, yi ta̱ o kubono a ka̱ci ka̱ nu.<verse eid="OBA 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="OBA 1:16" />Tsu na i soꞋi atakaci,</para>
  <para style="q2" vid="OBA 1:16">a kusan ku ciɗa ku va̱,</para>
  <para style="q1" vid="OBA 1:16">ta feu uduniya u na u buwai a kutakacika nannai,</para>
  <para style="q2" vid="OBA 1:16">i ta̱ o ku soꞋo atakaci,</para>
  <para style="q2" vid="OBA 1:16">ali okpo adanshi ka̱ta̱ a yaꞋan le ba.<verse eid="OBA 1:16" /></para>
  <para style="s1">UlyaꞋi wa aza Isaraila a ukocishi</para>
  <para style="q1">
    <verse number="17" style="v" sid="OBA 1:17" />Ama i ta̱ a̱ kuciya̱ aza a na a laꞋakai a kusan ku Sihiyona,</para>
  <para style="q2" vid="OBA 1:17">wi ta̱ o ko okpo ubuta̱ wu ida̱shi i ciɗa.</para>
  <para style="q2" vid="OBA 1:17">Ka̱ta̱ kumaci ku Yakubu ku doku ku ciya̱ ili yi uka̱ni i le.<verse eid="OBA 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="OBA 1:18" />Kumaci ku Yakubu ki ta̱ kokpo tsa akina,</para>
  <para style="q2" vid="OBA 1:18">kpaꞋa ku Isufu tsu melentsu ma akina,</para>
  <para style="q1" vid="OBA 1:18">kpaꞋa ku Isuwa ko okpo ciꞋiwa̱,</para>
  <para style="q2" vid="OBA 1:18">i ta̱ o kusongu le una le.</para>
  <para style="q1" vid="OBA 1:18">Ko vuza u kulaꞋaka ba,</para>
  <para style="q2" vid="OBA 1:18">mpa Vuzavaguɗu n dansai.<verse eid="OBA 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="OBA 1:19" />Aza a Isaraila a na i a Negebu,</para>
  <para style="q2" vid="OBA 1:19">i ta̱ a̱ kuka̱na̱ kusan ku Isuwa,</para>
  <para style="q1" vid="OBA 1:19">aza a na i a idashi aginda aza a Yahuda,</para>
  <para style="q2" vid="OBA 1:19">i ta̱ a ku isa iɗika ya aza a Filisitiya,</para>
  <para style="q1" vid="OBA 1:19">aza a Isaraila i ta̱ a kulyaꞋa uka̱ni,</para>
  <para style="q2" vid="OBA 1:19">wu uɓon wi iɗika ya aza a Ifirayimu n Samariya.</para>
  <para style="q2" vid="OBA 1:19">kumaci ku Bayami kpamu ku lyaꞋa Giliyadu. <verse eid="OBA 1:19" /><verse number="20" style="v" sid="OBA 1:20" />Kabunda̱i ko osoji ka Isaraila a na a bankai ugbashi,</para>
  <para style="q2" vid="OBA 1:20">i ta̱ o kubono a̱ ka̱na̱ iɗika ya aza KanaꞋana, ali a kubana a zarefatu.</para>
  <para style="q1" vid="OBA 1:20">Agbashi a na i a Urushelima a uɓon u Sefaradu</para>
  <para style="q2" vid="OBA 1:20">i ta̱ a ku isa likuci i Negebu.<verse eid="OBA 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="OBA 1:21" />Aza na a laꞋakai n wuma i ta̱ a ku gaɗukpa,</para>
  <para style="q2" vid="OBA 1:21">a kubana a kusan ku Sihiyona a Urushelima,</para>
  <para style="q1" vid="OBA 1:21">a̱ ka̱na̱ kusan ku Isuwa,</para>
  <para style="q2" vid="OBA 1:21">Vuzavaguɗu n ka̱ci ka̱ ni ɗa u kulyaꞋa tsugono ɗe.<verse eid="OBA 1:21" /></para>
  <chapter eid="OBA 1" />
</usx>