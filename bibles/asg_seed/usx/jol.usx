<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JOL" style="id">- Cishingini Agwara Kambari [asg]</book>
  <para style="toc3">Juw</para>
  <para style="toc2">Juwelu</para>
  <para style="toc1">Katagarda ka Juwelu</para>
  <para style="mt1">KATAGARDA KA JUWELU</para>
  <para style="mt">Kuɓa̱yuwa̱</para>
  <para style="is1">Ukuna u Katagarda ka nampa</para>
  <para style="ip">A̱ ciya̱ ili yi a̱bunda̱i a ukuna u keneki Juwelu ba. kpamu a̱ ciya̱ e yeve a makyan ma na u yongoi n wuma ba. Ama i ta̱ o cicoꞋo a ɗana ta̱ katagarda ka̱ ni ka a makyan ma̱ a̱ya̱ amangatawantawun (500) a kubana a̱ya̱ amangatawa̱na̱shi, (400) kafu a matsa Yesu (bc) a ayin a na iɗika i Fashiya yi o tsugono tsa aduniyan.</para>
  <para style="ip">Juwelu u yaꞋan ta̱ kene ka ukuna u ma̱dukpa̱ m akyun n kanbulu a uɓon u Falisadinu. A̱ ka̱tsuma̱ ki ili nampa we ene ta̱ urotu u kanna ka̱ kuta̱wa̱ ka Vuzavaguɗu, ayin a na Vuzavaguɗu u kutakacika aza a na a iwain kusheshe ka aza a usuɓi. Keneki ka ka dana ta̱ kusheshe ku Ka̱shile n kudana uma a̱ shika̱ unushi u le, n uzuwakpani u kulapulu n una̱singai adama uma a̱ ni. Ili i kindana i ɗaɗa uzuwukpani u na Ka̱shile ka yaꞋin u danai, wi ta̱ a̱ ku suku n ayinviki a ciɗa a̱ ubuta̱ u uma a̱ ni dem, ali n a̱ma̱ci olobo nu nkoshi dem derere. Ukuna u na wi punu u keci Ma̱dukpa̱ m akyun 1:1; 2:17 Uzuwukpani u kulapulusuka 2:18-27 Kanna ka Vuzavaguɗu 2:28; 3:21.</para>
  <chapter number="1" style="c" sid="JOL 1" />
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1" />Vuzavaguɗu u yaꞋin kadanshi n Juwelu kolobo ka Petuwelyu.<verse eid="JOL 1:1" /></para>
  <para style="s1">Ma̱dukpa̱ ma akyun a iɗika</para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 1:2" />Panai kakuna ka nampa, a̱ɗa̱ nkoshi m gba̱ra̱-gba̱ra̱,</para>
  <para style="q2" vid="JOL 1:2">zuwai atsuvu a̱ ɗa̱, a̱ɗa̱ na yi punu ida̱shi a iɗika ya.</para>
  <para style="q1" vid="JOL 1:2">a saꞋwa ta̱ kuyaꞋan ili i tsu nampa a ayin a̱ ɗa̱?</para>
  <para style="q2" vid="JOL 1:2">Ko a ayin a ikaya i ɗa̱?<verse eid="JOL 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 1:3" />Tonukoi muku n ɗa̱ kaꞋa,</para>
  <para style="q2" vid="JOL 1:3">ka̱ta̱ muku n ɗa̱ feu o tonuko muku n le,</para>
  <para style="q2" vid="JOL 1:3">ka̱ta̱ muku ntsukaya n ɗa̱ o tonuko ntsukaya n na n kuta̱wa̱.<verse eid="JOL 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 1:4" />Ili i na ka̱kuma̱ ka̱ nta̱ɗa̱ma̱ci ka takumai ɗa i buwai,</para>
  <para style="q2" vid="JOL 1:4">akyun a gbagbaꞋin o kotso a takumai,</para>
  <para style="q1" vid="JOL 1:4">Ili i na akyun a gbagbaꞋin a takumai ɗa i buwai,</para>
  <para style="q2" vid="JOL 1:4">ka̱kuma̱ ka̱ nta̱ɗa̱ma̱ci n kenkeꞋen ko kotso ka takumai.<verse eid="JOL 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 1:5" />Jimgbai, a̱ɗa̱ na ma̱ra̱ ma makai, i shika̱,</para>
  <para style="q2" vid="JOL 1:5">lapai una̱, a̱ɗa̱ na yi osoꞋi a̱ ma̱ra̱,</para>
  <para style="q1" vid="JOL 1:5">lapai una̱ adama a unambi u ma̱kya̱n ma savu,</para>
  <para style="q2" vid="JOL 1:5">adama a na e pece ɗa̱ ta̱ n maꞋan.<verse eid="JOL 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 1:6" />Adama a na uma a̱ kpa̱ta̱ra̱ ta̱ iɗika i va̱,</para>
  <para style="q2" vid="JOL 1:6">uma a utsura a ɗa,</para>
  <para style="q2" vid="JOL 1:6">ka̱bunda̱i ke le ki kukece ba,</para>
  <para style="q1" vid="JOL 1:6">anga e le i ta̱ n alyu tsu anga a kawu,<verse eid="JOL 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 1:7" />A̱ la̱nga̱sa̱ ta̱ ashina a itacishi a̱ va̱,</para>
  <para style="q2" vid="JOL 1:7">ɗa a takumai nɗanga mu mbiri.</para>
  <para style="q1" vid="JOL 1:7">E sheꞋwei a̱vu e le ra̱ka̱,</para>
  <para style="q2" vid="JOL 1:7">a̱ ka̱sukpa̱i acaka e le wa̱ri.<verse eid="JOL 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 1:8" />Shika̱i tsu mekere,</para>
  <para style="q2" vid="JOL 1:8">ma na mi a̱ ma̱shi adama a ukpa̱ u kamana ka̱ ni.<verse eid="JOL 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 1:9" />Anan ganu a̱ na̱mgba̱i a̱tsuma̱,</para>
  <para style="q2" vid="JOL 1:9">adama a na babu kuneꞋe ki ishina n ki ili i kusoꞋo,</para>
  <para style="q2" vid="JOL 1:9">a kpaꞋa ku Vuzavaguɗu.<verse eid="JOL 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 1:10" />Ashina ra̱ka̱ okpo ta̱ a̱pula̱ka̱,</para>
  <para style="q2" vid="JOL 1:10">iɗika feu i ɗekpe ɗe,</para>
  <para style="q1" vid="JOL 1:10">Ishina i na̱mgba̱ ɗe,</para>
  <para style="q2" vid="JOL 1:10">ma̱kya̱n feu me ɗekpe ɗe,</para>
  <para style="q2" vid="JOL 1:10">babu kpamu maꞋin ma zaitu.<verse eid="JOL 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 1:11" />Na̱mgba̱i a̱tsuma̱ a̱ɗa̱ acimbi,</para>
  <para style="q2" vid="JOL 1:11">lapai una̱, a̱ɗa̱ acimbi ashina a itacishi,</para>
  <para style="q1" vid="JOL 1:11">na̱mgba̱i a̱tsuma̱ adama a itabi m bali,</para>
  <para style="q2" vid="JOL 1:11">adama a na a̱ la̱nga̱sa̱ ta̱ ili i kashina.<verse eid="JOL 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 1:12" />Ashina a itacishi a̱ ɗa̱ e ɗekpe ta̱ ra̱ka̱,</para>
  <para style="q2" vid="JOL 1:12">nɗanga mu mbiri n ɗa̱ n ɗekpe ta̱,</para>
  <para style="q1" vid="JOL 1:12">nɗanga n Ruman, nu nshuwa nu nɗanga n na m buwai</para>
  <para style="q2" vid="JOL 1:12">ra̱ka̱ n ɗekpe ta̱.</para>
  <para style="q1" vid="JOL 1:12">Mayun ma̱za̱nga̱ ma vuma vu lima̱ mo kotso ta̱.<verse eid="JOL 1:12" /></para>
  <para style="s1">Kushika̱ ku unushi n avasa</para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 1:13" />A̱ɗa̱ anan ganu a na yi a kuyaꞋan alyuka,</para>
  <para style="q2" vid="JOL 1:13">a katalikalyuka ka Vuzavaguɗu, ukai akashi a kpalu, i shika̱,</para>
  <para style="q1" vid="JOL 1:13">i uwa A̱Ꞌisa̱ a gbayin yi asa n akashi a kpalu a̱ ɗa̱,</para>
  <para style="q1" vid="JOL 1:13">adama a na babu ishina ko ma̱kya̱n,</para>
  <para style="q2" vid="JOL 1:13">ma na a kuyaꞋanka alyuka A̱Ꞌisa̱ a gbayin a̱ Ka̱shile ka̱ ɗa̱.<verse eid="JOL 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 1:14" />Salai kuyaꞋan kakuli,</para>
  <para style="q2" vid="JOL 1:14">yaꞋin koɓolo ka gbangam.</para>
  <para style="q1" vid="JOL 1:14">ɓolongi nkoshi m gba̱ra̱-gba̱ra̱ n uma a iɗika ya ra̱ka̱,</para>
  <para style="q2" vid="JOL 1:14">A̱Ꞌisa̱ a gbayin a Vuzavaguɗu Ka̱shile ka̱ ɗa̱,</para>
  <para style="q1" vid="JOL 1:14">i banka n ma̱shi ma̱ ɗa̱ u Vuzavaguɗu.<verse eid="JOL 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 1:15" />Ili ya atakaci ɗa a kanna ka nanlo.</para>
  <para style="q2" vid="JOL 1:15">Adama a na kanna ka Vuzavaguɗu ka yawa ta̱ ɗevu,</para>
  <para style="q2" vid="JOL 1:15">atakaci a ɗa a MalaꞋimili a̱ kuta̱wa̱.<verse eid="JOL 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 1:16" />A̱ a̱shi a̱ tsu ɗa a̱ la̱nga̱sa̱i tsu ilikulyaꞋa,</para>
  <para style="q2" vid="JOL 1:16">babu ma̱za̱nga̱ n kupana ku uyoꞋo,</para>
  <para style="q2" vid="JOL 1:16">a kpaꞋa ku Ka̱shile ka̱ tsu.<verse eid="JOL 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 1:17" />IcuꞋu i kuwa̱i adama a uɗekpu wi iɗika,</para>
  <para style="q2" vid="JOL 1:17">mpon n na̱mgba̱i, ɗa n fa̱da̱i.</para>
  <para style="q1" vid="JOL 1:17">adama a na babu ishina,<verse eid="JOL 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 1:18" />La̱na̱ tsu na anaka i a̱ yura̱.</para>
  <para style="q2" vid="JOL 1:18">Ushiga wa anaka u yangalai,</para>
  <para style="q1" vid="JOL 1:18">adama a na a̱ ciya̱ ijanu ba,</para>
  <para style="q2" vid="JOL 1:18">ushiga wu nlala feu atakaci.<verse eid="JOL 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 1:19" />Vuzavaguɗu, wa̱ a̱ nu u ɗa mi a̱ ma̱shi,</para>
  <para style="q2" vid="JOL 1:19">adama a na akina a lyaꞋa ta̱ ubuta̱ u kalina.</para>
  <para style="q2" vid="JOL 1:19">melentsu ma akina mo songu ta̱ nɗanga n kakamba ra̱ka̱.<verse eid="JOL 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 1:20" />Nnama n kakamba feu mi ta̱ a̱ ma̱shi wa̱ a̱ nu,</para>
  <para style="q2" vid="JOL 1:20">adama a na nyeneke n ɗekpe ta̱ ra̱ka̱.<verse eid="JOL 1:20" /></para>
  <chapter eid="JOL 1" />
  <chapter number="2" style="c" sid="JOL 2" />
  <para style="s1">Ma̱dukpa̱ ma akyun tsu urotu u kanna ka Vuzavaguɗu</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 2:1" />Lika̱i vugbala a Sihiyona,</para>
  <para style="q2" vid="JOL 2:1">i sala a kusan ku gbayin ku ciɗa ku va̱.</para>
  <para style="q1" vid="JOL 2:1">YaꞋan aza a na i a̱ ida̱shi a iɗika ya ra̱ka̱ e jeꞋeke ikyamba,</para>
  <para style="q2" vid="JOL 2:1">adama a na kanna ka Vuzavaguɗu ki ta̱ lo a̱ ku ta̱wa̱, ka yawa ta̱ ɗevu.<verse eid="JOL 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 2:2" />Kanna ka atakaci kaꞋa n ka̱yimbi,</para>
  <para style="q2" vid="JOL 2:2">kanna ke eleshu n ka̱yimbi ka kpaɓam.</para>
  <para style="q1" vid="JOL 2:2">tsu ka̱yimbi ke eleshu ka na ka palai nsansa,</para>
  <para style="q2" vid="JOL 2:2">ta ka̱bunda̱i ka akyun ka ki a̱ kuta̱wa̱ nannai,</para>
  <para style="q1" vid="JOL 2:2">ka na ka̱ta̱ a sawai ku ene ba,</para>
  <para style="q2" vid="JOL 2:2">kpamu o kudoku ku ene tsu nanlo ba,</para>
  <para style="q2" vid="JOL 2:2">ali ntsukaya n na n kuta̱wa̱.<verse eid="JOL 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 2:3" />A kutakuma vica̱Ꞌa̱ tsa akina,</para>
  <para style="q1" vid="JOL 2:3">E kelime ke le iɗika ya tsu kashina ka Adini,</para>
  <para style="q2" vid="JOL 2:3">a̱ ka̱ca̱pa̱ ke le iɗika ya tsu ka̱pula̱ka̱,</para>
  <para style="q2" vid="JOL 2:3">babu ili i na i kulaꞋaka ekiye e le.<verse eid="JOL 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 2:4" />I ta̱ n iyoci yi odoku,</para>
  <para style="q2" vid="JOL 2:4">a ilaɗi tsu odoku o kuvon.<verse eid="JOL 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 2:5" />Ci izumgbi yi ekeke odoku,</para>
  <para style="q2" vid="JOL 2:5">a ci ɗikpangi a gaɗi va a nsansa,</para>
  <para style="q1" vid="JOL 2:5">ci izumgbi i kakamba ka na ki a̱ kukula̱,</para>
  <para style="q2" vid="JOL 2:5">a na osoji a utsura ugeri adama o kuvon.<verse eid="JOL 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 2:6" />Uma ene le baci, e ci jeꞋeke ta̱ ikyamba,</para>
  <para style="q2" vid="JOL 2:6">a̱shi e le koli-koli.<verse eid="JOL 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 2:7" />A̱ tsu ta̱wa̱ ta̱ tsu ovonshi,</para>
  <para style="q2" vid="JOL 2:7">a kumba mashilya tsu osoji.</para>
  <para style="q1" vid="JOL 2:7">A tsu dasa ta̱ derere adaru-adaru,</para>
  <para style="q2" vid="JOL 2:7">a tsu kpatala ba.<verse eid="JOL 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 2:8" />Babu vuza na u tsu uwa uye u vutoku,</para>
  <para style="q2" vid="JOL 2:8">yaba dem o kutono kadaru ka̱ ni,</para>
  <para style="q1" vid="JOL 2:8">a tsu pasamgbanai ta̱ e mere ma irala,</para>
  <para style="q2" vid="JOL 2:8">kpamu i ku shamgbatangu ba.<verse eid="JOL 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 2:9" />A tsu bana ta̱ n o bonoi a̱ likuci,</para>
  <para style="q2" vid="JOL 2:9">a tsu suma ta̱ a gaɗi vu nshilya.</para>
  <para style="q1" vid="JOL 2:9">A tsu kumba ta̱ a uwa a iꞋuwa</para>
  <para style="q2" vid="JOL 2:9">a uwa atusu a iꞋuwa a na oboki.<verse eid="JOL 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 2:10" />E kelime ke le iɗika i tsu gba̱ɗa̱ ta̱,</para>
  <para style="q2" vid="JOL 2:10">ka̱ ta̱ gaɗi a̱da̱nga̱shile e jengeɗe,</para>
  <para style="q1" vid="JOL 2:10">kanna n wotoi okpoi ka̱yimbi,</para>
  <para style="q2" vid="JOL 2:10">azangata kpamu feu o doku e neke kutashi ba.<verse eid="JOL 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 2:11" />N ka̱la̱ka̱tsu ka utsura ɗa Vuzavaguɗu,</para>
  <para style="q2" vid="JOL 2:11">udanai osoji a̱ ni,</para>
  <para style="q1" vid="JOL 2:11">yiɗa̱i a ku gisangu n ka̱bunda̱i ko osoji a̱ ni,</para>
  <para style="q2" vid="JOL 2:11">osoji a na o tsu tono kadanshi ka̱ ni.</para>
  <para style="q2" vid="JOL 2:11">a laꞋa ta̱ kukece,</para>
  <para style="q1" vid="JOL 2:11">Kanna ka Vuzavaguɗu kagbayin kaꞋa,</para>
  <para style="q2" vid="JOL 2:11">kanna ko wovon ka̱u,</para>
  <para style="q2" vid="JOL 2:11">Yayi wa kufuɗa ku shamgba?<verse eid="JOL 2:11" /></para>
  <para style="s1">Uɗeki u kushika̱ unushi</para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 2:12" />Vuzavaguɗu u danai, &lt;&lt;Ko n nannai.&gt;&gt;</para>
  <para style="q2" vid="JOL 2:12">&lt;&lt;Bonoi wa̱ a̱ va̱ n a̱ɗu a̱ ɗa̱ ra̱ka̱,</para>
  <para style="q1" vid="JOL 2:12">n kakuli n ma̱shi n una̱mgbi u ka̱tsuma̱.<verse eid="JOL 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 2:13" />a̱ɗu a̱ ɗa̱ o yotsongu ushiki wu unushi u ɗa̱,</para>
  <para style="q2" vid="JOL 2:13">ba kukara ku ntogu n ɗa̱ koci ba.</para>
  <para style="q1" vid="JOL 2:13">I bono a̱ ubuta̱ u Vuzavaguɗu Ka̱shile ka̱ ɗa̱,</para>
  <para style="q2" vid="JOL 2:13">adama a na a̱yi vuza kasingai ɗa n asuvayali,</para>
  <para style="q1" vid="JOL 2:13">vuza na u ci yaꞋan wupa gogo ba,</para>
  <para style="q2" vid="JOL 2:13">kpamu vuza vu ucigi u na u tsu sabaꞋa ba,</para>
  <para style="q2" vid="JOL 2:13">ama u tsu ronono ta̱ a̱ ubuta̱ u kutuka̱ n ma̱dukpa̱.<verse eid="JOL 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 2:14" />yayi u yevei ko Vuzavaguɗu Ka̱shile ka̱ tsu,</para>
  <para style="q2" vid="JOL 2:14">wi ta̱ a kusabaꞋa kusheshe ku ni,</para>
  <para style="q2" vid="JOL 2:14">u zuwaka tsu una̱singai,</para>
  <para style="q1" vid="JOL 2:14">ali ci yaꞋan kuneꞋe ki ishina n ili i kusoꞋo?<verse eid="JOL 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 2:15" />Lika̱i vugbala a Sihiyona,</para>
  <para style="q2" vid="JOL 2:15">i sala kuyaꞋan kakuli.</para>
  <para style="q1" vid="JOL 2:15">yi erengu ka̱ci ka̱ ɗa̱,</para>
  <para style="q2" vid="JOL 2:15">ka̱ta̱ i yaꞋan koɓolo ka ciɗa.<verse eid="JOL 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 2:16" />I ɓolongu uma,</para>
  <para style="q2" vid="JOL 2:16">ka̱ta̱ yi erengu koɓolo ka u Vuzavaguɗu,</para>
  <para style="q1" vid="JOL 2:16">i ɓolongu nkoshi,</para>
  <para style="q2" vid="JOL 2:16">n muku nu nreɓu,</para>
  <para style="q2" vid="JOL 2:16">ali vali vu savu n vuka vu savu feu uta̱ a̱ kunu ku le, a̱ ta̱wa̱.<verse eid="JOL 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 2:17" />YaꞋan anan ganu a na i a kuyaꞋanka, Vuzavaguɗu u linga e mere ma katalikalyuka n kafalaka ka̱ A̱Ꞌisa̱ a gbayin, a̱ shika̱.</para>
  <para style="q1" vid="JOL 2:17">A dana, &lt;&lt;Vuzavaguɗu pana asuvayali a uma nu.</para>
  <para style="q2" vid="JOL 2:17">Ka̱ta̱ vu ka̱sukpa̱ uma a uka̱ni a̱ nu a yaꞋan wono ba,</para>
  <para style="q2" vid="JOL 2:17">ka̱ta̱ vu ka̱sukpa̱ uduniyan u yoku u lyaꞋaka le tsugono ba,</para>
  <para style="q1" vid="JOL 2:17">ali a dana,</para>
  <para style="q2" vid="JOL 2:17">&lt;Teɗai Ka̱shile ka̱ ɗa̱ ki?&gt; &gt;&gt;<verse eid="JOL 2:17" /></para>
  <para style="s1">Wushuki u Vuzavaguɗu</para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 2:18" />Ɗa Vuzavaguɗu u sa̱Ꞌa̱i iɗika i ni,</para>
  <para style="q2" vid="JOL 2:18">u panai asuvayali a uma ni.<verse eid="JOL 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JOL 2:19" />Vuzavaguɗu wushuki uma a̱ ni, u danai.</para>
  <para style="q1" vid="JOL 2:19">&lt;&lt;La̱na̱i, mi ta̱ a̱ kusuꞋuku ɗa̱ ishina m ma̱kya̱n n maniꞋin,</para>
  <para style="q2" vid="JOL 2:19">ali i yawa ɗa̱, yi o kudoku ko okpo ili i ma̱ka̱n</para>
  <para style="q2" vid="JOL 2:19">a̱ ubuta̱ u uma ba.<verse eid="JOL 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 2:20" />&lt;&lt;Mi ta̱ o kuloko akyun daꞋangi n a̱ɗa̱,</para>
  <para style="q2" vid="JOL 2:20">a na uta̱i uɓon u gaɗi a na a̱ tuka̱i ɗa̱ n kuvon,</para>
  <para style="q2" vid="JOL 2:20">mi ta̱ o kuloko le a kubana a kakamba ka na ki n vuza ba,</para>
  <para style="q1" vid="JOL 2:20">aza e kelime le a̱ yikpa̱ a Mala,</para>
  <para style="q2" vid="JOL 2:20">aza a na i o kutono le tamkpamu a̱ yikpa̱ a Mala me Mere.</para>
  <para style="q1" vid="JOL 2:20">ushami we even a ikyamba e le wi ta̱ a̱ kuɗa̱nga̱,</para>
  <para style="q2" vid="JOL 2:20">ushami u gbani-gbani u le wi ta̱ a̱ kuka̱ra̱Ꞌa̱ a̱ ubuta̱ dem.</para>
  <para style="q2" vid="JOL 2:20">adama a na mpa Vuzavaguɗu n yaꞋan ta̱ ili i mereve.<verse eid="JOL 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 2:21" />Ka̱ta̱ vu pana wovon ba, avu iɗika,</para>
  <para style="q2" vid="JOL 2:21">yaꞋan ma̱za̱nga̱ vu pana uyoꞋo,</para>
  <para style="q1" vid="JOL 2:21">adama a na Vuzavaguɗu ɗa u yaꞋin ili i gbayin i nanlo.<verse eid="JOL 2:21" /></para>
  <para style="q2">
    <verse number="22" style="v" sid="JOL 2:22" />A̱ɗa̱ nnama n kakamba, ka̱ta̱ i pana wovon ba,</para>
  <para style="q2" vid="JOL 2:22">adama a na ijanu i topo ta̱.</para>
  <para style="q1" vid="JOL 2:22">Nɗanga kpamu feu n matsa ta̱,</para>
  <para style="q2" vid="JOL 2:22">nɗanga ma̱ mbiri n mi itacishi a matsa ta̱ mayin.<verse eid="JOL 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOL 2:23" />YaꞋin ma̱za̱nga̱, a̱ɗa̱ aza a Sihiyona,</para>
  <para style="q2" vid="JOL 2:23">i pana uyoꞋo nu mpa Vuzavaguɗu Ka̱shile ka̱ ɗa̱,</para>
  <para style="q1" vid="JOL 2:23">adama a na n yoꞋoko ɗa̱ ta̱ mini ma̱ ugiti,</para>
  <para style="q2" vid="JOL 2:23">ɗa kpamu n yoꞋoko yi ɗa̱ a makyan ma na ma untsai.<verse eid="JOL 2:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOL 2:24" />&lt;&lt;Ulanga u kulapu wi ta̱ a kushana tukpa n ishina,</para>
  <para style="q2" vid="JOL 2:24">Okotsu a gbagbaꞋin i ta̱ a kushana ali a ɓarakpa.</para>
  <para style="q2" vid="JOL 2:24">i ta̱ a kushana n ma̱kya̱n m maniꞋin ma zaitu.<verse eid="JOL 2:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOL 2:25" />Mi ta̱ o kubonoko ɗa̱ n ili i na akyun a takumai a̱ ka̱tsuma̱ ka̱ a̱ya̱ a nanlo,</para>
  <para style="q2" vid="JOL 2:25">akyun a gbagbaꞋin n e kenkeꞋen,</para>
  <para style="q2" vid="JOL 2:25">nu nta̱ɗa̱ma̱ci, ko ka̱kuma̱ ka akyun a na i yevei,</para>
  <para style="q1" vid="JOL 2:25">ɗaɗa osoji a utsura a na n suꞋuki ɗa̱.<verse eid="JOL 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOL 2:26" />&lt;&lt;Gogo na yi ta̱ a kulyaꞋa ilikulyaꞋa ali i cuwa̱,</para>
  <para style="q2" vid="JOL 2:26">ali i cikpa kula ku Vuzavaguɗu Ka̱shile ka̱ ɗa̱,</para>
  <para style="q2" vid="JOL 2:26">a̱yi na u yaꞋankai ɗa̱ ili i mereve,</para>
  <para style="q1" vid="JOL 2:26">kpamu i o kudoku kuneke uma a̱ va̱ wono ba.<verse eid="JOL 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOL 2:27" />A̱ɗa̱ uma a Isaraila talo ye kuyeve a na mpa mi ta̱ a̱ ka̱tsuma̱ ka̱ ɗa̱,</para>
  <para style="q2" vid="JOL 2:27">mpa ɗa Vuzavaguɗu Ka̱shile ka̱ ɗa̱,</para>
  <para style="q2" vid="JOL 2:27">babu vuza vu yoku, kpamu i o kudoku kuneke uma a̱ va̱ wono ba.<verse eid="JOL 2:27" /></para>
  <para style="s1">Kanna ka Vuzavaguɗu</para>
  <para style="q1">
    <verse number="28" style="v" sid="JOL 2:28" />&lt;&lt;Ayin a na baci ili nampa i kotsoi,</para>
  <para style="q2" vid="JOL 2:28">ka̱ta̱ n suꞋuku uma a̱ va̱ ra̱ka̱ n ayinviki a̱ va̱.</para>
  <para style="q1" vid="JOL 2:28">muku n ɗa̱ olobo nu nkere i ta̱ a kuyaꞋan kene,</para>
  <para style="q2" vid="JOL 2:28">nkoshi mi ta̱ a kuyaꞋan alatani,</para>
  <para style="q2" vid="JOL 2:28">muku mo olobo n ɗa̱ a yaꞋan kene tsa alatani.<verse eid="JOL 2:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOL 2:29" />Ali n agbashi a̱ ɗa̱ ali n a̱ma̱ci,</para>
  <para style="q2" vid="JOL 2:29">mi ta̱ a̱ kutsunku le ayinviki a̱ va̱ a kanna ka nanlo.<verse eid="JOL 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOL 2:30" />Ka̱ta̱ n yotsongu urotu wi ili i mereve, gaɗi n iɗika,</para>
  <para style="q2" vid="JOL 2:30">i ta̱ a̱ kutsuwa̱n mpasa n akina n ugbodoli u ka̱nga̱.<verse eid="JOL 2:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOL 2:31" />Kanna ki ta̱ o ko okpo ka̱yimbi,</para>
  <para style="q2" vid="JOL 2:31">wotoi tamkpamu wo okpo ushili tsu mpasa.</para>
  <para style="q1" vid="JOL 2:31">Kafu kanna ka Vuzavaguɗu ka nanlo ka̱ ta̱wa̱. <verse eid="JOL 2:31" /><verse number="32" style="v" sid="JOL 2:32" />Wi ta̱ o ko okpo vuza na baci dem u ɗekei,</para>
  <para style="q2" vid="JOL 2:32">kula ku Vuzavaguɗu wi ta̱ a̱ kuciya̱ wishi,</para>
  <para style="q1" vid="JOL 2:32">adama a na a kusan ku Sihiyona n Urushelima,</para>
  <para style="q2" vid="JOL 2:32">i ta̱ a kuciya̱ aza a na a kulaꞋaka,</para>
  <para style="q2" vid="JOL 2:32">tsu na mpa Vuzavaguɗu n danai,</para>
  <para style="q1" vid="JOL 2:32">a̱ ka̱tsuma̱ ka aza na a laꞋakai</para>
  <para style="q2" vid="JOL 2:32">i ta̱ a̱ kuciya̱ aza a na mpa Vuzavaguɗu n ɗekei.<verse eid="JOL 2:32" /></para>
  <chapter eid="JOL 2" />
  <chapter number="3" style="c" sid="JOL 3" />
  <para style="s1">Vuzavaguɗu wi ta̱ a kuyaꞋanka uduniya afada</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 3:1" />Vuzavaguɗu u danai, &lt;&lt;A ayin a nanlo,</para>
  <para style="q2" vid="JOL 3:1">mi ta̱ o kubonoko Yahuda n Urushelima n una̱singai u le,<verse eid="JOL 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 3:2" />Mi ta̱ o kuɓolongu uduniyan ra̱ka̱,</para>
  <para style="q2" vid="JOL 3:2">n tuka̱ le a̱ ka̱ra̱Ꞌa̱ ka Jehoshafatu.</para>
  <para style="q1" vid="JOL 3:2">Ta ɗe mi a kutakacika le adama a uma a̱ va̱,</para>
  <para style="q2" vid="JOL 3:2">adama a na a wacuwa ta̱ aza a Isaraila, ili yi uka̱ni i va̱.</para>
  <para style="q1" vid="JOL 3:2">ɗa kpamu e pecekushi iɗika i va̱.<verse eid="JOL 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 3:3" />A yaꞋain kazagba adama uma a̱ va̱,</para>
  <para style="q2" vid="JOL 3:3">e dengei muku mo olobo nu nkere okpoi agbashi,</para>
  <para style="q1" vid="JOL 3:3">adama a na a tsupaka ashakanlai n ma̱kya̱n.<verse eid="JOL 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOL 3:4" />&lt;&lt;A̱ɗa̱ aza a Taya n aza a Sidon n uɓon Filisitiya, yiɗa̱i i cigai kuyaꞋanka mu? Yi ta̱ e kusheshe i tsupa ili i na n yaꞋankai ɗa̱? Ta baci nannai, gogo na mi ta̱ a ku kucikpa kubonoko kaꞋa a kaci ka̱ ɗa̱. <verse eid="JOL 3:4" /><verse number="5" style="v" sid="JOL 3:5" />Adama a na i pura̱ ta̱ azurufa n azanariya a na i ucanuku u singai u va̱ i bankai a̱ nva̱li ma̱ a̱ma̱li a̱ ɗa̱. <verse eid="JOL 3:5" /><verse number="6" style="v" sid="JOL 3:6" />Ɗa kpamu i pura̱i uma a̱ va̱ aza a Yahuda n aza a Urushelima, i denke yi aza e Helene, adama a na i banka le daꞋangi n iɗika i le. <verse eid="JOL 3:6" /><verse number="7" style="v" sid="JOL 3:7" />La̱na̱i, gogo na mpa mi ta̱ a kuzuwa le o bono a̱ ubuta̱ u na yi ishi i dengei le va, ka̱ta̱ n yaꞋanka ɗa̱ ili i na i yaꞋankai le. <verse eid="JOL 3:7" /><verse number="8" style="v" sid="JOL 3:8" />I ta̱ e kudenke aza a Yahuda muku n ɗa̱ olobo nu nkere, ka̱ta̱ e le tamkpamu e denke aza a Sabina, a̱ ubuta̱ wu mɓa̱ri a iɗika ya aza Arabiya, mpa Vuzavaguɗu n dansai.&gt;&gt;<verse eid="JOL 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 3:9" />Salai ukuna u nampa wa a̱ ka̱tsuma̱ ku uduniyan,</para>
  <para style="q2" vid="JOL 3:9">i dana, foɓusoi kuyaꞋan kuvon.</para>
  <para style="q1" vid="JOL 3:9">i ɗengusa̱ eyevi o kuvon,</para>
  <para style="q2" vid="JOL 3:9">i zuwa osoji a yawa ɗevu, a laza a kubana kuvon.<verse eid="JOL 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 3:10" />Lapai mba̱ri n vicimba n ɗa̱ mo okpo otokobi,</para>
  <para style="q2" vid="JOL 3:10">i bonoko muwun n vikyaꞋa n ɗa̱ nsara,</para>
  <para style="q2" vid="JOL 3:10">yaꞋan vuza babu utsura u dana,</para>
  <para style="q1" vid="JOL 3:10">&lt;&lt;Mpa vuza vu utsura ɗa.&gt;&gt;<verse eid="JOL 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 3:11" />Dakakai i ta̱wa̱, a̱ɗa̱ uduniyan u na yi uka̱ra̱Ꞌi n uma a̱ va̱,</para>
  <para style="q2" vid="JOL 3:11">i ɓolongu ɗe a̱ ka̱ra̱Ꞌa̱.</para>
  <para style="q2" vid="JOL 3:11">Vuzavaguɗu, zuwa osoji a̱ nu a gasa a̱ ubuta̱ wa.<verse eid="JOL 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 3:12" />&lt;&lt;YaꞋan uduniya u ɗa̱nga̱,</para>
  <para style="q2" vid="JOL 3:12">a̱ ka̱na̱ uye a kubana a̱ ka̱ra̱Ꞌa̱ ka afada ka Jehoshafatu,</para>
  <para style="q1" vid="JOL 3:12">adama a na ta ɗe n ku da̱sa̱ngu,</para>
  <para style="q2" vid="JOL 3:12">n yaꞋanka uduniyan u na wi uka̱ra̱Ꞌi n uma a̱ va̱ afada.<verse eid="JOL 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 3:13" />Ka gbani-gbani ke le ka yimkpa ta̱,</para>
  <para style="q2" vid="JOL 3:13">remei nkawun n ɗa̱ i kana le, tsu ishina i na i geꞋwei.</para>
  <para style="q1" vid="JOL 3:13">Ta̱wa̱i i dasa le, tsu na a tsu pisha ma̱kya̱n,</para>
  <para style="q2" vid="JOL 3:13">adama a na okotsu a kupisha ma̱kya̱n a shana,</para>
  <para style="q2" vid="JOL 3:13">ogbodo a gbagbaꞋin a shana a pasa.&gt;&gt;<verse eid="JOL 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 3:14" />Ka̱bunda̱i ka uma,</para>
  <para style="q2" vid="JOL 3:14">ki ta̱ punu a̱ ka̱ra̱Ꞌa̱ ka afada a̱ Ka̱shile,</para>
  <para style="q1" vid="JOL 3:14">adama a na kanna ka Vuzavaguɗu ka yawa ta̱ ɗevu,</para>
  <para style="q2" vid="JOL 3:14">a̱ ka̱ra̱Ꞌa̱ ka kukiɗa afada.<verse eid="JOL 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 3:15" />Kanna n wotoi i ta̱ o ko okpo ka̱yimbi,</para>
  <para style="q2" vid="JOL 3:15">azangata feu kpamu e kuneke kutashi ba.<verse eid="JOL 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 3:16" />Vuzavaguɗu wi ta̱ a kuyaꞋan yura̱ a Sihiyona,</para>
  <para style="q2" vid="JOL 3:16">wi ta̱ a̱ kuɗa̱ngusa̱ ka̱la̱ka̱tsu ka̱ ni a Urushelima,</para>
  <para style="q2" vid="JOL 3:16">gaɗi a̱da̱nga̱shile n iɗika yi ta̱ a̱ kugba̱ɗa̱.</para>
  <para style="q1" vid="JOL 3:16">Ama Vuzavaguɗu ɗa ubuta̱ u kusheɗeku u uma a̱ ni,</para>
  <para style="q2" vid="JOL 3:16">mashilya kpamu a uma a Isaraila.<verse eid="JOL 3:16" /></para>
  <para style="s1">Una̱singai adama a uma a̱ Ka̱shile.</para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 3:17" />&lt;&lt;Talo ye kuyeve a na mpa ɗa Vuzavaguɗu Ka̱shile ka̱ ɗa̱,</para>
  <para style="q2" vid="JOL 3:17">yi ta̱ e kuyeve a na mi a ida̱shi a Sihiyona,</para>
  <para style="q2" vid="JOL 3:17">kusan ku ciɗa ku va̱,</para>
  <para style="q1" vid="JOL 3:17">Urushelima wi ta̱ o okpo ciɗa,</para>
  <para style="q2" vid="JOL 3:17">babu kpamu irala i na i kudoku kuciya̱ ulyaꞋi wa̱ a̱ ni.<verse eid="JOL 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 3:18" />&lt;&lt;A kanna ka nanlo, nsansa mi ta̱ kushana n ma̱kya̱n,</para>
  <para style="q2" vid="JOL 3:18">ka̱ta̱ aginda tamkpamu a shana n mani ma anaka,</para>
  <para style="q2" vid="JOL 3:18">nyeneke ma aza a Yahuda ra̱ka̱ n shana n mini.</para>
  <para style="q1" vid="JOL 3:18">ka̱shi ka̱ mini ki ta̱ a̱ ku uta̱ ɗe a kpaꞋa ku Vuzavaguɗu,</para>
  <para style="q2" vid="JOL 3:18">ka̱ta̱ me neke ka̱ra̱Ꞌa̱ ka nɗanga n Akashiya kuta̱nu<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="fq" closed="false">ka̱ra̱Ꞌa̱ ka nɗanga n Akashiya </char><char style="ft" closed="false">Ka̱ra̱Ꞌa̱ ka nampa ka ɗaɗa feu e ci ɗeke Shitim. </char></note>.<verse eid="JOL 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 3:19" />&lt;&lt;Ama Masar wi ta̱ o ko okpo agali,</para>
  <para style="q2" vid="JOL 3:19">Edom tamkpamu wo okpo kakamba,</para>
  <para style="q1" vid="JOL 3:19">adama a ka gbani-gbani ka na a yaꞋankai aza a Yahuda,</para>
  <para style="q2" vid="JOL 3:19">a unai aza a babu unushi a iɗika i Yahuda.<verse eid="JOL 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 3:20" />Ama Yahuda wi ta̱ o ko okpo ubuta̱ wi ida̱shi i uma ayin dem</para>
  <para style="q2" vid="JOL 3:20">Urushelima tamkpamu a kubana a tsukaya dem<verse eid="JOL 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 3:21" />Mi ta̱ a kutsupa unushi u munuka ma aza a babu unushi,</para>
  <para style="q2" vid="JOL 3:21">mi a kucinukpa ka le u ɗa ba,</para>
  <para style="q2" vid="JOL 3:21">mpa Vuzavaguɗu mi ta̱ o kuyongo a Sihiyona.&gt;&gt;<verse eid="JOL 3:21" /></para>
  <chapter eid="JOL 3" />
</usx>