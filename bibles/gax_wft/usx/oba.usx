<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="OBA" style="id">- Guji Bible</book>
  <para style="h">Obaadiyaa Raagichaa</para>
  <para style="toc1">Kitaaba Obaadiyaa Raagichaa</para>
  <para style="toc2">Obaadiyaa Raagichaa</para>
  <para style="toc3">Oba.</para>
  <para style="mt1">Kitaaba Obaadiyaa Raagichaa</para>
  <para style="imt">Seensa</para>
  <para style="ip">Kitaab gabaabaan kun dhaloota Kiristoosiitiin dura bara dhibba shanii fi saddeettamii jaatti diigama Yerusaalemiitiin duuba yennaa hin beekkanne keessatti dhaggame; yennaa san Edoomiin kibba gara aduun baatutti dhaggantu, bara dheera'aaf diina Yihuda'aa ta teete, diigama Yerusaalemiititti gammadiisaan, worra Yerusaalem lolu qarqaariisaan qabeenna qachaa Yerusaalemii saamiisatti jirtiiyyu. Edoom diinota Israa'elii dhibii woliin adabbii jaddu'uu fi injifatam akka isii irra dhaqqabu, Obaadiyaan raaga dubbate.</para>
  <para style="iot">Haadhoo Dubbi'ii</para>
  <para style="io1">Adabamiisa Edoomii <char style="ior"><ref loc="OBA 1:1-14">1-14</ref></char></para>
  <para style="io1">Guyyaa Mootii Waan Maraa <char style="ior"><ref loc="OBA 1:15-21">15-21</ref></char></para>
  <chapter number="1" style="c" sid="OBA 1"/>
  <para style="s1">Adabamiisa Edoomii</para>
  <para style="p">
    <verse number="1" style="v" sid="OBA 1:1"/>Mudhiin Mootiin Waan Maraa Waaqi marroo biyya Edoomii Obaadiya'atti mudhise asiin jala jirti:</para>
  <para style="q1" vid="OBA 1:1">Ergamaan tokko</para>
  <para style="q2" vid="OBA 1:1">gara gosa biyya adda addaa ergamee,</para>
  <para style="q1" vid="OBA 1:1">«Ka'aa! Dhandhee,</para>
  <para style="q2" vid="OBA 1:1">biyya Edoomii lollaa!» jedhuun</para>
  <para style="q2" vid="OBA 1:1">ergaa Mootii Waan Maraa irraa dhagganneerra.<verse eid="OBA 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="OBA 1:2"/>Ammalle Mootiin Waan Maraa Edoomiin,</para>
  <para style="q1" vid="OBA 1:2">«Kunoo, gosa biyya adda addaa keessatti</para>
  <para style="q2" vid="OBA 1:2">akka ati dadhaddu,</para>
  <para style="q2" vid="OBA 1:2">ijjumaa akka tuffatantu hin godha.<verse eid="OBA 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="OBA 1:3"/>Ati ka mana keeti</para>
  <para style="q2" vid="OBA 1:3">addee ol jette gaara irratti ka ijaarratte,</para>
  <para style="q2" vid="OBA 1:3">ka holla dhaka'aa keessa leetu,</para>
  <para style="q1" vid="OBA 1:3">‹Eentu lafatti gad na buusa?› ka jettu,</para>
  <para style="q2" vid="OBA 1:3">koora keetittuu si sobe.<verse eid="OBA 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="OBA 1:4"/>Ati akka risa'aa gubbaa irra yoo kaatelle,</para>
  <para style="q2" vid="OBA 1:4">mandhee teeti urjoota oddu'utti,</para>
  <para style="q2" vid="OBA 1:4">yoo ijaarrattelle,</para>
  <para style="q2" vid="OBA 1:4">ani achii gad si buusa<verse eid="OBA 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="OBA 1:5"/>Hattuun Yookiin saantuun</para>
  <para style="q2" vid="OBA 1:5">halkaniin mana keeti yoo dhufane,</para>
  <para style="q2" vid="OBA 1:5">haguma barbaadane qofa fudhatan.</para>
  <para style="q1" vid="OBA 1:5">Worri midhaan woyni'ii guuratulle,</para>
  <para style="q2" vid="OBA 1:5">woxoo hin lakkisa.</para>
  <para style="q1" vid="OBA 1:5">Diinni keeti ammoo</para>
  <para style="q2" vid="OBA 1:5">ijjuma si hin balleessa.<verse eid="OBA 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="OBA 1:6"/>Isin sanyiin Esaawuu<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="fqa" closed="false">Sanyii Esaawuu: </char><char style="ft" closed="false">Kolbaa Edoomii jedhamuu hin dande'ama.</char></note></para>
  <para style="q2" vid="OBA 1:6">manni keessan soffameera.</para>
  <para style="q2" vid="OBA 1:6">Karri teessan duudiille saamanteerti.<verse eid="OBA 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="OBA 1:7"/>Goliin teeti si sobanee,</para>
  <para style="q2" vid="OBA 1:7">biyya teeti keessa si ari'ane.</para>
  <para style="q1" vid="OBA 1:7">Jaaloti teeti worri addatamane</para>
  <para style="q2" vid="OBA 1:7">dhossa'aan tiyyoo si duratti afanee,</para>
  <para style="q2" vid="OBA 1:7">‹Qarummaan isaa meet› jedhane.<verse eid="OBA 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="OBA 1:8"/>Guyyaa sanitti Mootiin Waan Maraa:</para>
  <para style="q2" vid="OBA 1:8">Ani qaroolle Edoom keessaa,</para>
  <para style="q2" vid="OBA 1:8">worra hubantii qabu</para>
  <para style="q2" vid="OBA 1:8">gaara Esaawuu irraa hin balleessu.<verse eid="OBA 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="OBA 1:9"/>Ee qachaa Temaanii!</para>
  <para style="q2" vid="OBA 1:9">Loltooti teeti hin bararaqan;</para>
  <para style="q2" vid="OBA 1:9">worri gaara Esaawuu irra</para>
  <para style="q2" vid="OBA 1:9">jiranu martinuu hin ijjeefaman.<verse eid="OBA 1:9"/></para>
  <para style="s1">Adabamiisa Edoomii</para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="OBA 1:10"/>«Sanyii Obboleessa keeti Yaaqoobii</para>
  <para style="q2" vid="OBA 1:10">hunnaan waan ijjeetteef,</para>
  <para style="q2" vid="OBA 1:10">hin qaanotta;</para>
  <para style="q2" vid="OBA 1:10">haga bara baraalle hin badda.<verse eid="OBA 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="OBA 1:11"/>Guyyaa alagaan karra saame,</para>
  <para style="q2" vid="OBA 1:11">worri ormaa dalleya cassee seenee</para>
  <para style="q2" vid="OBA 1:11">Yerusaalem irratti hixaa buufate,</para>
  <para style="q2" vid="OBA 1:11">atille akkuma worra sanii itti teetee,</para>
  <para style="q2" vid="OBA 1:11">irraa fagaattee dhaabbatte.<verse eid="OBA 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="OBA 1:12"/>Guyyaa obboleessi keeti rakkatu</para>
  <para style="q2" vid="OBA 1:12">isatti qacifatuun,</para>
  <para style="q2" vid="OBA 1:12">guyyaa badii kolbaa Yihuda'aa, gammaduun,</para>
  <para style="q2" vid="OBA 1:12">guyyaa gadda isaanii geeraruun</para>
  <para style="q2" vid="OBA 1:12">si'iif hin malle.<verse eid="OBA 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="OBA 1:13"/>Guyyaa badii kolbaa tiyyaa</para>
  <para style="q2" vid="OBA 1:13">qachaa isaanii seenuun,</para>
  <para style="q2" vid="OBA 1:13">guyyaa badii isaanii itti qacifatuun,</para>
  <para style="q2" vid="OBA 1:13">karra isaaniille saamuun</para>
  <para style="q2" vid="OBA 1:13">si'iif hin malle.<verse eid="OBA 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="OBA 1:14"/>Guyyaa gadda isaanii</para>
  <para style="q2" vid="OBA 1:14">qaxxaamura kara'aa irra dhaabbattee</para>
  <para style="q2" vid="OBA 1:14">worra baqatanee bayanu qaddee</para>
  <para style="q2" vid="OBA 1:14">dabarsitee diinotatti kennuun,</para>
  <para style="q2" vid="OBA 1:14">si'iif hin malle.<verse eid="OBA 1:14"/></para>
  <para style="s1">Mootiin Waan Maraa Gosa Biyya Adda Addaatitti Hin Mura</para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="OBA 1:15"/>«Guyyaan ani Mootiin Waan Maraa</para>
  <para style="q2" vid="OBA 1:15">gosa biyya adda addaa maratti muru dhikaateera;</para>
  <para style="q1" vid="OBA 1:15">Edoom, akkuma ati nama irratti goote</para>
  <para style="q2" vid="OBA 1:15">si'i irralle'etti hin godhama;</para>
  <para style="q2" vid="OBA 1:15">hujiin teeti hantuun mataa keetitti hin deebiti.<verse eid="OBA 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="OBA 1:16"/>Akkuma kolbaan tiyya</para>
  <para style="q2" vid="OBA 1:16">gaara kiyya woyyicha irratti</para>
  <para style="q2" vid="OBA 1:16">muduunuu rakko'oo unte,</para>
  <para style="q2" vid="OBA 1:16">gosi biyya adda addaa marti</para>
  <para style="q2" vid="OBA 1:16">adoo wol irraa hin kutin hin unti;</para>
  <para style="q2" vid="OBA 1:16">irra caalaalle hin unti;</para>
  <para style="q2" vid="OBA 1:16">akka hin jirrelle hin teeti.<verse eid="OBA 1:16"/></para>
  <para style="s1">Injifachaa Israa'elii</para>
  <para style="q1">
    <verse number="17" style="v" sid="OBA 1:17"/>Worri gariin ammoo</para>
  <para style="q2" vid="OBA 1:17">gaara Xiyoonii irratti hin hafan,</para>
  <para style="q2" vid="OBA 1:17">gaarri Xiyooniille woyyicha hin te'a;</para>
  <para style="q2" vid="OBA 1:17">sanyiin Yaaqoobii ammoo</para>
  <para style="q2" vid="OBA 1:17">worra lafa isaanii</para>
  <para style="q2" vid="OBA 1:17">isaan irraa fudhate irraa</para>
  <para style="q2" vid="OBA 1:17">deebifatanee hin fudhatan.<verse eid="OBA 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="OBA 1:18"/>Sanyiin Yaaqoobii akka ibiddaa,</para>
  <para style="q2" vid="OBA 1:18">sanyiin Yoseefiille</para>
  <para style="q2" vid="OBA 1:18">akka bobe'aa te'anee,</para>
  <para style="q2" vid="OBA 1:18">sanyii Esaawuu ta akka huuraa</para>
  <para style="q2" vid="OBA 1:18">gubanee hin fixan;</para>
  <para style="q2" vid="OBA 1:18">sanyii Esaawuu keessaa ka hafu</para>
  <para style="q2" vid="OBA 1:18">tokkolle hin jiru.<verse eid="OBA 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="OBA 1:19"/>Worri biyya Yihuda'aatiin gara kibbaa jiranu</para>
  <para style="q2" vid="OBA 1:19">gaara Esaawuu,</para>
  <para style="q2" vid="OBA 1:19">worri gaara jala jiranu ammoo</para>
  <para style="q2" vid="OBA 1:19">biyya Filisxeemotaa hin qabatan;</para>
  <para style="q2" vid="OBA 1:19">isaan Samaariya'aa fi</para>
  <para style="q2" vid="OBA 1:19">lafa sanyii Efreemii hin qabatan;</para>
  <para style="q2" vid="OBA 1:19">sanyiin Beniyaaminii ammoo</para>
  <para style="q2" vid="OBA 1:19">Giil'aad hin qabatan.<verse eid="OBA 1:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="OBA 1:20"/>Loltooti Israa'elii</para>
  <para style="q2" vid="OBA 1:20">worri booji'amee Kana'aan keessa jiru</para>
  <para style="q2" vid="OBA 1:20">haga Zaarefa'aatitti hin qabatan;</para>
  <para style="q2" vid="OBA 1:20">worri Yerusaalemii booji'amee</para>
  <para style="q2" vid="OBA 1:20">Safaaraad jiru</para>
  <para style="q2" vid="OBA 1:20">qachoota biyya Yihuda'aa</para>
  <para style="q2" vid="OBA 1:20">ka gara kibbaa<note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="fqa" closed="false">Qachoota kibba Yihuda'aa: </char><char style="ft" closed="false">Isaan kun qachoota Negebii ti.</char></note> jiranu hin qabatan.<verse eid="OBA 1:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="OBA 1:21"/>Worri isaan bilisa baasu gaara Xiyoonii irratti</para>
  <para style="q2" vid="OBA 1:21">ol bayanee gaara Esaawuu hin bulchan;</para>
  <para style="q2" vid="OBA 1:21">yennaa san mootummaan</para>
  <para style="q2" vid="OBA 1:21">ta Mootii Waan Maraa hin teeti» jedha.<verse eid="OBA 1:21"/></para>
  <chapter eid="OBA 1"/>
</usx>
