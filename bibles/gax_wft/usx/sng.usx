<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="SNG" style="id">- Guji Bible</book>
  <para style="h">Kitaaba Faaruu Solomoonii</para>
  <para style="toc1">Kitaaba Faaruu Solomoonii</para>
  <para style="toc2">Kitaaba Faaruu Solomoonii</para>
  <para style="toc3">Far. Sol.</para>
  <para style="mt1">Kitaaba Faaruu Solomoonii</para>
  <para style="imt">Seensa</para>
  <para style="ip">Kitaab faaruu Solomoonii irra caalaa wolaloo jaalalaa faaruu dhiirti dubartii, dubartiin dhiira faarfattu. Hiikkaa garii keessatti kitaab kun, «Faaruu faaruu caaltu» yookiin, «Faaruu keessaa faaruu guddoo bareeddu» jedhamee beekkama. Woraabbii afaan Ibrootaa keessatti kitaab kun ka Solomoonii te'uun isaa waan beekkameef, kitaaba Solomoonii jedhama.</para>
  <para style="ip">Faaruu tana worri Yihudootaa yennaa hedduu jaalala Waaqaa fi kolbaa isaa wodhakkaa jiruun wol fakkeessan; worri Kiristaanaa jaalala Kiristoosii fi Wolde'a Kiristaanaa wodhakkaa jiruun wol fakkeessan.</para>
  <para style="iot">Haadhoo Dubbi'ii</para>
  <para style="io1">Faaruu Qaraa<char style="ior"><ref loc="SNG 1:1-2:7">1:1—2:7</ref></char></para>
  <para style="io1">Faaruu Lammeesso'oo<char style="ior"><ref loc="SNG 2:8-3:5">2:8—3:5</ref></char></para>
  <para style="io1">Faaruu Sadeesso'oo<char style="ior"><ref loc="SNG 3:6-5:1">3:6—5:1</ref></char></para>
  <para style="io1">Faaruu Arfeesso'oo<char style="ior"><ref loc="SNG 5:2-6:3">5:2—6:3</ref></char></para>
  <para style="io1">Faaruu Shaneesso'oo<char style="ior"><ref loc="SNG 6:4-8:4">6:4—8:4</ref></char></para>
  <para style="io1">Faaruu Jayeesso'oo<char style="ior"><ref loc="SNG 8:5-14">8:5-14</ref></char></para>
  <chapter number="1" style="c" sid="SNG 1"/>
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1"/>Faaruu Solomoonii ta faaruu mara caaltu.<verse eid="SNG 1:1"/></para>
  <para style="s1">Faaruu Qaraa</para>
  <para style="sp">Waajibittiin</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 1:2"/>«Jaalalli keeti daadhii woyni'ii waan caaluuf,</para>
  <para style="q2" vid="SNG 1:2">afaan kiyya keessa na sunqadhu.<verse eid="SNG 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 1:3"/>Fooleen fiqiree teetii hin uddootti;</para>
  <para style="q2" vid="SNG 1:3">maqaan keeti akka fiqiree dhangalaatuu ti;</para>
  <para style="q2" vid="SNG 1:3">tanaaf durri marti si jaalatti.<verse eid="SNG 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 1:4"/>Na fudhadhuu deemi! Ariifannuu ti;</para>
  <para style="q2" vid="SNG 1:4">ee, mooticha gara kolloo teetii na geessi.</para>
  <para style="sp" vid="SNG 1:4">Jaaloti</para>
  <para style="q1" vid="SNG 1:4">Nuuti si'iin firinxiindhee hin gammanna;</para>
  <para style="q2" vid="SNG 1:4">daadhii woyni'ii caalaa jaalala keeti leellinna;</para>
  <para style="q2" vid="SNG 1:4">dubartooti marti dhuguma si jaalatan.<verse eid="SNG 1:4"/></para>
  <para style="sp">Waajibittii</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 1:5"/>Ee, durra Yerusaalemii!</para>
  <para style="q2" vid="SNG 1:5">Ani gurraattii te'ulle,</para>
  <para style="q2" vid="SNG 1:5">akka dunkaanii Qedaarii,</para>
  <para style="q2" vid="SNG 1:5">akka gollaa mana mootummaa Solomoonii miidhaga.<verse eid="SNG 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 1:6"/>Ani gurraattii waan te'eef,</para>
  <para style="q2" vid="SNG 1:6">aduun waan na gurraachessiteef,</para>
  <para style="q2" vid="SNG 1:6">na hin daaw'atina'a!</para>
  <para style="q1" vid="SNG 1:6">Obboleeyyan tiyya natti aaranee,</para>
  <para style="q2" vid="SNG 1:6">oorruu muka woyni'ii akka eegu na godhane;</para>
  <para style="q2" vid="SNG 1:6">muka woyni'ii kiyya ani hin eeganne.<verse eid="SNG 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 1:7"/>Jaala kiyya ka lubbu'uu!</para>
  <para style="q2" vid="SNG 1:7">Hoolee teeti eessa akka tiffattu,</para>
  <para style="q2" vid="SNG 1:7">Waareelle eessatti akka boqachiifattu natti himi.</para>
  <para style="q1" vid="SNG 1:7">Ani maaniif hoolee jaalota teetii bira</para>
  <para style="q2" vid="SNG 1:7">akka dubartii fuula hagooggattee joonja?» jette.<verse eid="SNG 1:7"/></para>
  <para style="sp">Waajibichi</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 1:8"/>Ati ta dubartii mara caalaa miidhaddu!</para>
  <para style="q2" vid="SNG 1:8">Yoo hin beenne teete,</para>
  <para style="q2" vid="SNG 1:8">hoolee gula ideemi!</para>
  <para style="q2" vid="SNG 1:8">Ilmoolee re'e'ee teeti</para>
  <para style="q2" vid="SNG 1:8">dunkaanii tissitootaa bira dheechifadhu.<verse eid="SNG 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 1:9"/>Obboleettii tiyya!</para>
  <para style="q2" vid="SNG 1:9">Ati fardoo garreettaa fardaan harkifamu harkisanu</para>
  <para style="q2" vid="SNG 1:9">ka Fara'oonii keessaa</para>
  <para style="q2" vid="SNG 1:9">akka farda tokkoo ti.<verse eid="SNG 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 1:10"/>Mallaan teeti seesaan,</para>
  <para style="q2" vid="SNG 1:10">mormi keetille dooqaan miidhageera.<verse eid="SNG 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 1:11"/>Ani<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="fqa" closed="false">Ani: </char><char style="fqa" closed="false">Afaan Ibrootaatiin «Nuuti» </char><char style="ft" closed="false">Jedha. Nuuti jechuun isaa akka mootichi ifi himu.</char></note> worqii gurraa,</para>
  <para style="q2" vid="SNG 1:11">ta meeti'iin seefante hujisiisa.<verse eid="SNG 1:11"/></para>
  <para style="sp">Waajibittii</para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 1:12"/>Mootiin areerratiisatti jiruun,</para>
  <para style="q2" vid="SNG 1:12">fiqireen tiyya uddaa ifii fiqqitte.<verse eid="SNG 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 1:13"/>Jaalalleen kiyya akka subba qumbi'ii ti;</para>
  <para style="q2" vid="SNG 1:13">inni odduu harma kiyyaa boqata.<verse eid="SNG 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 1:14"/>Jaalalleen kiyya naaf akka daraaraa uddowu,</para>
  <para style="q2" vid="SNG 1:14">ka addee muka woyni'ii</para>
  <para style="q2" vid="SNG 1:14">ka madda En-Gedii keessaa ti.<verse eid="SNG 1:14"/></para>
  <para style="sp">Waajibichi</para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 1:15"/>Ee, jaalallee tiyya, ati attam attam miidhadda!</para>
  <para style="q2" vid="SNG 1:15">Ee, attam attam miidhadda!</para>
  <para style="q2" vid="SNG 1:15">Ilti teeti akka ila saphaliisaa ti.<verse eid="SNG 1:15"/></para>
  <para style="sp">Waajibittii</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 1:16"/>Jaalallee kiyya, ati attam attam miidhadda!</para>
  <para style="q2" vid="SNG 1:16">Ati attam attam nama gammachiitta!</para>
  <para style="q2" vid="SNG 1:16">Taqeen teenna akka marra bisile'ee ti.<verse eid="SNG 1:16"/></para>
  <para style="sp">Waajibichi</para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 1:17"/>Utubaan mana keennaa muka hindheensaa ti;</para>
  <para style="q2" vid="SNG 1:17">dagaleen isaalle muka birbirsaa ti.<verse eid="SNG 1:17"/></para>
  <chapter eid="SNG 1"/>
  <chapter number="2" style="c" sid="SNG 2"/>
  <para style="sp">Waajibittii</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 2:1"/>Ani akka daraaraa lafa Sharoniitii fi</para>
  <para style="q2" vid="SNG 2:1">akka daraaraa dhooqa keessaa ti.<verse eid="SNG 2:1"/></para>
  <para style="sp">Waajibichi</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 2:2"/>Jaalalleen tiyya dubartoota oddu'utti</para>
  <para style="q2" vid="SNG 2:2">akka daraaraa qoree odduu jiruu ti.<verse eid="SNG 2:2"/></para>
  <para style="sp">Waajibittii</para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 2:3"/>Jaalalleen kiyya dargaggoota oddu'utti,</para>
  <para style="q2" vid="SNG 2:3">akka muka appili'ii ka baddaa keessa jiruu ti.</para>
  <para style="q1" vid="SNG 2:3">Ani gaaddisa isaa jala tee'iisatti hin gammada;</para>
  <para style="q2" vid="SNG 2:3">midhaan isaalle afaan kiyyatti hin mi'owa.<verse eid="SNG 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 2:4"/>Inni gara mana gammadaa na geesse;</para>
  <para style="q2" vid="SNG 2:4">beessisi jaalala isaa na irra jira.<verse eid="SNG 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 2:5"/>Ani jaalala isaatiin qabame waan gaggabeef,</para>
  <para style="q2" vid="SNG 2:5">midhaan woyni'ii nyaachisa'aatii na jabeessa'a;</para>
  <para style="q2" vid="SNG 2:5">midhaan muka appili'iitiin na gammachiisa'a.<verse eid="SNG 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 2:6"/>Harki isaa bitaachi mataa kiyya jala adoo jiraataa;</para>
  <para style="q2" vid="SNG 2:6">harki isaa middichi adoo na hanqafataa.<verse eid="SNG 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 2:7"/>Ee dubartoota Yerusaalemii,</para>
  <para style="q2" vid="SNG 2:7">haga inni fedhuma ifiitiin ka'utti,</para>
  <para style="q2" vid="SNG 2:7">jaalallee kiyya tirtirsitanee akka hin dammassine,</para>
  <para style="q2" vid="SNG 2:7">ani maqaa jilibaa yookiin gadansa badda'aatiin,</para>
  <para style="q2" vid="SNG 2:7">isin magannifadha.<verse eid="SNG 2:7"/></para>
  <para style="s1">Faaruu Lammeesso'oo</para>
  <para style="sp">Waajibittii</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 2:8"/>Kunoo, jaalalleen kiyya,</para>
  <para style="q2" vid="SNG 2:8">gaarota irra u'utaalaa,</para>
  <para style="q2" vid="SNG 2:8">koobota irra burraaqaa dhufuun qoonqoo dhage'a.<verse eid="SNG 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 2:9"/>Jaalalleen kiyya jilibaa yookiin</para>
  <para style="q2" vid="SNG 2:9">ilmoolee gadansaa fakkaata.</para>
  <para style="q1" vid="SNG 2:9">Kunoo inni dalleya mana keennaa duuba dhaabbata;</para>
  <para style="q2" vid="SNG 2:9">qowa dalleyaatiin,</para>
  <para style="q2" vid="SNG 2:9">fodda'aan gara keessaa ilaaliisatti jira.<verse eid="SNG 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 2:10"/>Jaalalleen kiyya natti dubbatee,</para>
  <para style="q2" vid="SNG 2:10">«Jaalallee tiyya, dansittii tiyya!</para>
  <para style="q2" vid="SNG 2:10">Koy, woliin ideenna.<verse eid="SNG 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 2:11"/>Kunoo, ganni dabareera;</para>
  <para style="q2" vid="SNG 2:11">bokkeenni roobuu lakkisee caameera.<verse eid="SNG 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 2:12"/>Daraaraan baquu jalqabeera;</para>
  <para style="q2" vid="SNG 2:12">yennaan faaruu faarfatanu geetteerti;</para>
  <para style="q2" vid="SNG 2:12">qoonqoon saphaliisaa lafa teenna keessatti</para>
  <para style="q2" vid="SNG 2:12">dhage'anteerti.<verse eid="SNG 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 2:13"/>Harruun midhaanotteerti;</para>
  <para style="q2" vid="SNG 2:13">woyniille daraartee uddootteerti.</para>
  <para style="q1" vid="SNG 2:13">Jaalallee tiyya, dansittii tiyya!</para>
  <para style="q2" vid="SNG 2:13">Ka'i, woliin ideenna» naan jedhe.<verse eid="SNG 2:13"/></para>
  <para style="sp">Waajibichi</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 2:14"/>Ee, saphaliisa tiyya,</para>
  <para style="q2" vid="SNG 2:14">ta holla dhakaa keessaa,</para>
  <para style="q2" vid="SNG 2:14">ta addee dhokata gaara keessaa,</para>
  <para style="q2" vid="SNG 2:14">fuula keeti natti mudhisi;</para>
  <para style="q2" vid="SNG 2:14">qoonqoo teeti na dhageessis;</para>
  <para style="q2" vid="SNG 2:14">qoonqoon teeti natti tolti;</para>
  <para style="q2" vid="SNG 2:14">fuulli keeti natti miidhaga.<verse eid="SNG 2:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 2:15"/>Jeedalootaa fi ilmoolee jeedalootaa</para>
  <para style="q2" vid="SNG 2:15">worra woynii teenna ta daraariisatti jirtu</para>
  <para style="q2" vid="SNG 2:15">nu duraa balleessu, nuu qaba'a.<verse eid="SNG 2:15"/></para>
  <para style="sp">Waajibittii</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 2:16"/>Jaalalleen kiyya, kiyyuma;</para>
  <para style="q2" vid="SNG 2:16">anille ta isaa ti;</para>
  <para style="q2" vid="SNG 2:16">inni daraaraa dansaa keessa horii tissa.<verse eid="SNG 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 2:17"/>Ee jaalallee kiyya! Adoo boruun hin dayya'in,</para>
  <para style="q2" vid="SNG 2:17">aduun adoo hin bayin,</para>
  <para style="q2" vid="SNG 2:17">akka jiliba'aa yookiin</para>
  <para style="q2" vid="SNG 2:17">akka ilmoolee gadansaa,</para>
  <para style="q2" vid="SNG 2:17">gaara bu'aa bayii qabu irra</para>
  <para style="q2" vid="SNG 2:17">utaalaa gara kiyya koy.<verse eid="SNG 2:17"/></para>
  <chapter eid="SNG 2"/>
  <chapter number="3" style="c" sid="SNG 3"/>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 3:1"/>Ani halkan guutuu taqee tiyya irratti</para>
  <para style="q2" vid="SNG 3:1">jaala kiyya ka lubbu'uu barbaade;</para>
  <para style="q2" vid="SNG 3:1">ani isa barbaade ammoo hin dhaggine.<verse eid="SNG 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 3:2"/>Ani amma ka'ee qachaa keessa,</para>
  <para style="q2" vid="SNG 3:2">karaa irra, woldeennaa kara'aa irra deddeemee,</para>
  <para style="q2" vid="SNG 3:2">jaala kiyya ka lubbu'uu hin barbaada;</para>
  <para style="q2" vid="SNG 3:2">ani barbaade ammoo isa hin dhaggine.<verse eid="SNG 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 3:3"/>Worri qachaa eegu adoo asii fi achi deemanuu,</para>
  <para style="q2" vid="SNG 3:3">na dhaggane;</para>
  <para style="q2" vid="SNG 3:3">anille, «Jaala kiyya ka lubbu'uu</para>
  <para style="q2" vid="SNG 3:3">dhaggitaneertanii?» jedhee gaafadhe.<verse eid="SNG 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 3:4"/>Isaan irra akkuma dabareen,</para>
  <para style="q2" vid="SNG 3:4">jaala kiyya ka lubbu'uu san dhaggee,</para>
  <para style="q2" vid="SNG 3:4">isa qabadhe;</para>
  <para style="q2" vid="SNG 3:4">gara mana haadha tiyyaa,</para>
  <para style="q2" vid="SNG 3:4">gara kolloo haadha na deetteetitti</para>
  <para style="q2" vid="SNG 3:4">haga isa geeffadhutti gad isa hin lakkinne.<verse eid="SNG 3:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 3:5"/>Ee dubartoota Yerusaalemii,</para>
  <para style="q2" vid="SNG 3:5">haga inni fedhuma ifiitiin ka'utti,</para>
  <para style="q2" vid="SNG 3:5">jaalallee kiyya tirtirsitanee akka hin dammassine,</para>
  <para style="q2" vid="SNG 3:5">ani maqaa jilibaa yookiin gadansa badda'aatiin,</para>
  <para style="q2" vid="SNG 3:5">isin magannifadha.<verse eid="SNG 3:5"/></para>
  <para style="s1">Faaruu Sadeesso'oo</para>
  <para style="sp">Waajibittii</para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 3:6"/>Ka lafa goomole'ee keessaa</para>
  <para style="q2" vid="SNG 3:6">akka duumensa aaraa</para>
  <para style="q2" vid="SNG 3:6">ol bayiisatti jiru,</para>
  <para style="q2" vid="SNG 3:6">ka akka fiqiree qumbi'ii fi hixaanaan</para>
  <para style="q2" vid="SNG 3:6">daldaltooti uddowaa mara irraa hujattee kun eennu?<verse eid="SNG 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 3:7"/>Kunoo, barcumaan mootumma'aa<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="fqa" closed="false">Barcumaa mootumma'aa: </char><char style="ft" closed="false">Barcumaan mootumma'aa kun ka kolbaan Solomoon ittiin ba'attee asii fi achi ideentu.</char></note> ka Solomoonii,</para>
  <para style="q2" vid="SNG 3:7">loltoota hunnaameyyii Israa'elii</para>
  <para style="q2" vid="SNG 3:7">keessaa ta filatante jaatamaan marfameera.<verse eid="SNG 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 3:8"/>Marti isaaniituu shallaagaa hidhatan;</para>
  <para style="q2" vid="SNG 3:8">martinuu muuxannoo lolaa qaban;</para>
  <para style="q2" vid="SNG 3:8">bidhaa halkaniitiif</para>
  <para style="q2" vid="SNG 3:8">tokko tokkoon isaanii shallaagaa hidhataneeran.<verse eid="SNG 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 3:9"/>Mootichi Solomoon muka Libaanonii irraa,</para>
  <para style="q2" vid="SNG 3:9">barcumaa mootumma'aa ka ifii hujisiifate.<verse eid="SNG 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 3:10"/>Miilli barcumaa mootumma'aa sanii meetii irraa,</para>
  <para style="q2" vid="SNG 3:10">irkoon isaa worqii irraa,</para>
  <para style="q2" vid="SNG 3:10">addeen tee'iisaa woyaa dhiille'een gonfameera;</para>
  <para style="q2" vid="SNG 3:10">keessa isaa dubartoota Yerusaalemiititti seesee huje.<verse eid="SNG 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 3:11"/>Ee Dubartoota Yerusaalemii,</para>
  <para style="q2" vid="SNG 3:11">dhaqa'aatii kallacha Solomoonii mootichaa,</para>
  <para style="q2" vid="SNG 3:11">ka haati isaa guyyaa fuudha isaa,</para>
  <para style="q2" vid="SNG 3:11">guyyaa gadhaan isaa gammadetti</para>
  <para style="q2" vid="SNG 3:11">itti keette ilaala'a.<verse eid="SNG 3:11"/></para>
  <chapter eid="SNG 3"/>
  <chapter number="4" style="c" sid="SNG 4"/>
  <para style="sp">Waajibichi</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 4:1"/>Jaalallee tiyya, ati attam attam dansitti'i!</para>
  <para style="q2" vid="SNG 4:1">Ee, ati attam attam dansitti'i!</para>
  <para style="q1" vid="SNG 4:1">Ilti teeti shaashii ati hagooggattu keessaa,</para>
  <para style="q2" vid="SNG 4:1">akka ila saphaliisaa kuulle'e;</para>
  <para style="q2" vid="SNG 4:1">rifeensi mataa keetii</para>
  <para style="q2" vid="SNG 4:1">re'oota gaara Giil'aadii irraa</para>
  <para style="q2" vid="SNG 4:1">gad yaa'anu fakkaata.<verse eid="SNG 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 4:2"/>Ilkaan keeti akka hoolota adii</para>
  <para style="q2" vid="SNG 4:2">yennaa rifeensi isaanii muramu</para>
  <para style="q2" vid="SNG 4:2">nafi isaanii dhiqamee bisaan keessaa bayanuu ti;</para>
  <para style="q2" vid="SNG 4:2">hooloti tun martinuu lakkuu dhalti;</para>
  <para style="q2" vid="SNG 4:2">maseenti takkaalle isaan keessa hin jirtu.<verse eid="SNG 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 4:3"/>Hidhiin teeti haarrii diintuu fakkaatti;</para>
  <para style="q2" vid="SNG 4:3">haasonni keeti namatti tola.</para>
  <para style="q1" vid="SNG 4:3">Mallaan teeti shaashii ati hagooggattu keessaa,</para>
  <para style="q2" vid="SNG 4:3">midhaan rumaanii ka gargar baqaqe fakkaata.<verse eid="SNG 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 4:4"/>Mormi keeti xelleephoo Daawitii,</para>
  <para style="q2" vid="SNG 4:4">ta wonteen gugurdoon kum tokko,</para>
  <para style="q2" vid="SNG 4:4">wonteen goototaa martinuu</para>
  <para style="q2" vid="SNG 4:4">itti fannifamanu fakkaata.<verse eid="SNG 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 4:5"/>Harmi keeti lamaanuu jilibaa ilmoolee,</para>
  <para style="q2" vid="SNG 4:5">lakkuu jilibaa ilmoole'ee,</para>
  <para style="q2" vid="SNG 4:5">ta daraaraa keessa dheeddu fakkaata.<verse eid="SNG 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 4:6"/>Adoo boruun hin dayya'in,</para>
  <para style="q2" vid="SNG 4:6">aduun adoo hin bayin,</para>
  <para style="q2" vid="SNG 4:6">ani gara gaara qumbi'iitii fi</para>
  <para style="q2" vid="SNG 4:6">gara kooba hixaanaa hin dhaqa.<verse eid="SNG 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 4:7"/>Jaalallee tiyya, ati attam attam dansitti'i!</para>
  <para style="q2" vid="SNG 4:7">Womaa dhidhinna hin qaddu.<verse eid="SNG 4:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 4:8"/>Waajibittii tiyya, Libaanon irraa gara kiyya koy!</para>
  <para style="q2" vid="SNG 4:8">Libaanon irraa gara kiyya koy!</para>
  <para style="q1" vid="SNG 4:8">Qaccee gaara Amaanaa irraa,</para>
  <para style="q2" vid="SNG 4:8">qaccee gaara Siinaariitii fi Hermoonii,</para>
  <para style="q2" vid="SNG 4:8">goda neenqaa,</para>
  <para style="q2" vid="SNG 4:8">koobota qeeransaa irralle gad bu'i.<verse eid="SNG 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 4:9"/>Obboleettii tiyya, waajibittii tiyya!</para>
  <para style="q2" vid="SNG 4:9">Ati midhuu teeti takkatti'iin,</para>
  <para style="q2" vid="SNG 4:9">dirata morma keetiitiin</para>
  <para style="q2" vid="SNG 4:9">qalbii tiyya boojite.<verse eid="SNG 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 4:10"/>Obboleettii tiyya, waajibittii tiyya!</para>
  <para style="q2" vid="SNG 4:10">Jaalalli keeti attam attam nama gammachiisa!</para>
  <para style="q2" vid="SNG 4:10">daadhii woyni'ii caalaa</para>
  <para style="q2" vid="SNG 4:10">attam attam gabbi nama godha!</para>
  <para style="q1" vid="SNG 4:10">Fooleen fiqiree teetii uddowaa mara caalti.<verse eid="SNG 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 4:11"/>Waajibittii tiyya!</para>
  <para style="q2" vid="SNG 4:11">Hidhiin teeti akka dhaaba dammaa</para>
  <para style="q2" vid="SNG 4:11">nadhii coccossiti;</para>
  <para style="q2" vid="SNG 4:11">aananii fi dammi arraba keeti jala jiran;</para>
  <para style="q2" vid="SNG 4:11">fooleen woyaa teetii akka foolee</para>
  <para style="q2" vid="SNG 4:11">hindheensa Libaanonii ti.<verse eid="SNG 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 4:12"/>Obboleettii tiyya, waajibittii tiyya!</para>
  <para style="q2" vid="SNG 4:12">Ati akka oorruu itti ijaaramee ti;</para>
  <para style="q2" vid="SNG 4:12">akka madda dalleyaan marfameetii fi</para>
  <para style="q2" vid="SNG 4:12">akka burqaa cuqqaalamee ti.<verse eid="SNG 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 4:13"/>Ati akka oorruu muka rumaanii,</para>
  <para style="q2" vid="SNG 4:13">ka midhaan dansaa buusu,</para>
  <para style="q2" vid="SNG 4:13">ka daraaraan uddowuu fi</para>
  <para style="q2" vid="SNG 4:13">biqiltuun naardoosii achi keessa jiranuu ti.<verse eid="SNG 4:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 4:14"/>Muki Naardoosii, biqiltuun uddoottu,</para>
  <para style="q2" vid="SNG 4:14">marri uddowu, qarafaan,</para>
  <para style="q2" vid="SNG 4:14">muki hixaanaa, muki qumbi'ii,</para>
  <para style="q2" vid="SNG 4:14">daraaraan hargiisaatii fi</para>
  <para style="q2" vid="SNG 4:14">uddowaan dansaan adda addaa marti</para>
  <para style="q2" vid="SNG 4:14">achi keessa jiran.<verse eid="SNG 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 4:15"/>Ati akka burqaa bisaan addee oorru'uu,</para>
  <para style="q2" vid="SNG 4:15">ka boolla keessaa yaa'u,</para>
  <para style="q2" vid="SNG 4:15">bisaan gaara Libaanoniitii gad yaa'uu ti.<verse eid="SNG 4:15"/></para>
  <para style="sp">Waajibittii</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 4:16"/>Ee, qilleensa kaabaa dammaqi!</para>
  <para style="q1" vid="SNG 4:16">Ee, qilleensa kibbaa koy!</para>
  <para style="q1" vid="SNG 4:16">Oorruu tiyyatti qilleensi;</para>
  <para style="q2" vid="SNG 4:16">fooleen isi'ii uddoottuun fiqittuu ti.</para>
  <para style="q1" vid="SNG 4:16">Jaalalleen kiyya gara oorruu ifii dhufee</para>
  <para style="q2" vid="SNG 4:16">midhaan oorruu ifii dansaa nyaatuu ti.<verse eid="SNG 4:16"/></para>
  <chapter eid="SNG 4"/>
  <chapter number="5" style="c" sid="SNG 5"/>
  <para style="sp">Waajibichi</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 5:1"/>Obboleettii tiyya, waajibittii tiyya!</para>
  <para style="q2" vid="SNG 5:1">Ani gara oorruu tiyyaa dhufeera;</para>
  <para style="q2" vid="SNG 5:1">qumbii tiyyaa fi uddowaa kiyya wolitti qabadheera;</para>
  <para style="q2" vid="SNG 5:1">nadhii dhaaba damma kiyyaa nyaadheera;</para>
  <para style="q2" vid="SNG 5:1">daadhii woyni'ii tiyyaa fi aanan kiyya uneera.</para>
  <para style="sp" vid="SNG 5:1">Jaaloti</para>
  <para style="q1" vid="SNG 5:1">Nyaadha'a, jaalota, una'a, jaalalaan machowa'a!<verse eid="SNG 5:1"/></para>
  <para style="s1">Faaruu Arfeesso'oo</para>
  <para style="sp">Waajibittii</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 5:2"/>Ani rafeera; yaadi kiyya ammoo rafee hin jiru;</para>
  <para style="q2" vid="SNG 5:2">jaalalleen kiyya balbala dhodhowaa,</para>
  <para style="q2" vid="SNG 5:2">«Obboleettii tiyya, jaalallee tiyya!</para>
  <para style="q2" vid="SNG 5:2">Saphaliisa tiyya, ta dhidhinna hin qanne, naa bani!</para>
  <para style="q1" vid="SNG 5:2">Mataan kiyya fixeensaan,</para>
  <para style="q2" vid="SNG 5:2">rifeensi mataa kiyyaalle</para>
  <para style="q2" vid="SNG 5:2">dabana halkaniitiin jiidheera» jedhuun dhage'e.<verse eid="SNG 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 5:3"/>Ani ammoo, «Woyaa tiyya baafadheeraa,</para>
  <para style="q2" vid="SNG 5:3">attam deebisee uffadha ree?</para>
  <para style="q1" vid="SNG 5:3">Ani miila kiyya dhiqadheera,</para>
  <para style="q2" vid="SNG 5:3">attam deebisee xureessa ree?» jedheen.<verse eid="SNG 5:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 5:4"/>Jaalalleen kiyya karaa qowaatiin</para>
  <para style="q2" vid="SNG 5:4">harka ifii gara keessaa keye;</para>
  <para style="q2" vid="SNG 5:4">gadhaan kiyya isaaf na raafame.<verse eid="SNG 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 5:5"/>Ani jaalallee kiyyaaf balbala baniisaaf ka'ee,</para>
  <para style="q2" vid="SNG 5:5">harka kiyyaan qabannoo cufana'aa yennaa qabadhe,</para>
  <para style="q2" vid="SNG 5:5">fiqireen qumbi'ii harka kiyya irraa coccoxxee,</para>
  <para style="q2" vid="SNG 5:5">qabannoo san irratti dhangalaate.<verse eid="SNG 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 5:6"/>Ani jaalallee kiyyaaf balbala bane;</para>
  <para style="q2" vid="SNG 5:6">inni ammoo deebi'ee deemeera.</para>
  <para style="q1" vid="SNG 5:6">Yennaa inni dubbate san,</para>
  <para style="q2" vid="SNG 5:6">gadhaan na rifate.</para>
  <para style="q1" vid="SNG 5:6">Ani isa barbaade;</para>
  <para style="q2" vid="SNG 5:6">ammoo hin dhaggine.</para>
  <para style="q1" vid="SNG 5:6">Ani isa waame;</para>
  <para style="q2" vid="SNG 5:6">inni na jalaa hin owwaanne.<verse eid="SNG 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 5:7"/>Namooti asii fi achi deemaa qachaa eeganu</para>
  <para style="q2" vid="SNG 5:7">na dhaggane;</para>
  <para style="q2" vid="SNG 5:7">isaan dikanee na madeessane;</para>
  <para style="q2" vid="SNG 5:7">eeddoti dalleya qacha'aa</para>
  <para style="q2" vid="SNG 5:7">woyaa tiyya na irraa mulqane.<verse eid="SNG 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 5:8"/>Ee, dubartoota Yerusaalemii,</para>
  <para style="q2" vid="SNG 5:8">jaalallee kiyya yennaa dhaggitane,</para>
  <para style="q2" vid="SNG 5:8">maan isatti hintan seetan?</para>
  <para style="q1" vid="SNG 5:8">Ani jaalala isaatiin akka dhibameeru,</para>
  <para style="q2" vid="SNG 5:8">itti naa hima'a.<verse eid="SNG 5:8"/></para>
  <para style="sp">Dubartooti Jaaloti Waajibitti'ii</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 5:9"/>Ati ta dubartoota mara caalaa dansittii teete!</para>
  <para style="p" vid="SNG 5:9">Jaalalleen keeti worra kaan ka attam caalu inni?</para>
  <para style="q2" vid="SNG 5:9">Ati akkas ka nu magannifattu,</para>
  <para style="q2" vid="SNG 5:9">jaalalleen keeti worra kaan ka attam caalu inni?<verse eid="SNG 5:9"/></para>
  <para style="sp">Waajibittii</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 5:10"/>Jaalalleen kiyya diimaa hargiisa;</para>
  <para style="q2" vid="SNG 5:10">inni nama kuma kudhan keessalle'etti hin mudhata.<verse eid="SNG 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 5:11"/>Buqqiin mataa isaa worqii qulluu fakkaatti;</para>
  <para style="q2" vid="SNG 5:11">rifeensi mataa isaa luuccaa,</para>
  <para style="q2" vid="SNG 5:11">gurraacha akka harraaqessaa ti.<verse eid="SNG 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 5:12"/>Ilti isaa akka saphaliisa adii</para>
  <para style="q2" vid="SNG 5:12">madda bisaanii bira tee'uu,</para>
  <para style="q2" vid="SNG 5:12">ka akka waan aananiin dhiqatee</para>
  <para style="q2" vid="SNG 5:12">addaatuu,</para>
  <para style="q2" vid="SNG 5:12">akka dooqaa jirti.<verse eid="SNG 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 5:13"/>Mallaan isaa akka oorruu uddowa'aa ti;</para>
  <para style="q2" vid="SNG 5:13">hidhiin isaa akka daraaraa</para>
  <para style="q2" vid="SNG 5:13">fiqiree qumbi'ii dhangalaasuu ti.<verse eid="SNG 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 5:14"/>Harki isaa ulee worqi'ii</para>
  <para style="q2" vid="SNG 5:14">ta dooqaan seefante fakkaata;</para>
  <para style="q2" vid="SNG 5:14">nafi isaa ilka arbaa</para>
  <para style="q2" vid="SNG 5:14">ka dhakaa, «Safiiros» jedhamuun</para>
  <para style="q2" vid="SNG 5:14">seefame fakkaata.<verse eid="SNG 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 5:15"/>Miilli isaa utubaa cabbii cululuxxu'uu,</para>
  <para style="q2" vid="SNG 5:15">ka worqii qulluu irra dhaabbatu fakkaata.</para>
  <para style="q1" vid="SNG 5:15">Inni gaara Libaanonii fakkaata;</para>
  <para style="q2" vid="SNG 5:15">akka hindheensa Libaanonii</para>
  <para style="q2" vid="SNG 5:15">ka mara caalaa filatame.<verse eid="SNG 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 5:16"/>Haasonni isaa guddoo mi'owa;</para>
  <para style="q2" vid="SNG 5:16">inni guddoo jaalatama'a.</para>
  <para style="q1" vid="SNG 5:16">Ee, dubartoota Yerusaalemii,</para>
  <para style="q2" vid="SNG 5:16">jaalalleen kiyya, jaalli kiyya isa.<verse eid="SNG 5:16"/></para>
  <chapter eid="SNG 5"/>
  <chapter number="6" style="c" sid="SNG 6"/>
  <para style="s1">Dubartooti Jaaloti Waajibitti'ii</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 6:1"/>Ati ta dubartoota caalaa dansittii teete!</para>
  <para style="q2" vid="SNG 6:1">Jaalalleen keeti eessa dhaqe?</para>
  <para style="q1" vid="SNG 6:1">Akka si woliin barbaannu,</para>
  <para style="q2" vid="SNG 6:1">karaa kam gore?<verse eid="SNG 6:1"/></para>
  <para style="sp">Waajibittii</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 6:2"/>Jaalalleen kiyya horii tiffatiisaaf,</para>
  <para style="q2" vid="SNG 6:2">daraaraalle guuratiisaaf,</para>
  <para style="q2" vid="SNG 6:2">gara oorruu uddowaa ifii gad dhaqeera.<verse eid="SNG 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 6:3"/>Ani ta jaalallee kiyyaa ti; innille kiyya;</para>
  <para style="q2" vid="SNG 6:3">inni odduu daraara'aa horii tissa.<verse eid="SNG 6:3"/></para>
  <para style="s1">Faaruu Shaneesso'oo</para>
  <para style="sp">Waajibichi</para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 6:4"/>Ee, jaalallee tiyya,</para>
  <para style="q2" vid="SNG 6:4">ati akka qachaa Tiiza'aa miidhadda;</para>
  <para style="q2" vid="SNG 6:4">akka qachaa Yerusaalemii tolta;</para>
  <para style="q2" vid="SNG 6:4">akka loltoota baandiraa qabatanee deemanuu</para>
  <para style="q2" vid="SNG 6:4">arnya qadda.<verse eid="SNG 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 6:5"/>Ilti teeti waan na boojiteef,</para>
  <para style="q2" vid="SNG 6:5">na irraa deebifadhu!</para>
  <para style="q1" vid="SNG 6:5">Rifeensi mataa keetii re'oota</para>
  <para style="q2" vid="SNG 6:5">gaara Giil'aadii irraa gad yaatu fakkaata.<verse eid="SNG 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 6:6"/>Ilkaan keeti akka hoolota adii</para>
  <para style="q2" vid="SNG 6:6">dhiqamanee bisaan keessaa bayanuu addaata;</para>
  <para style="q2" vid="SNG 6:6">hooloti tun martinuu lakkuu dhalti malee</para>
  <para style="q2" vid="SNG 6:6">isaan keessa maseenti hin jirtu.<verse eid="SNG 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 6:7"/>Mallaan teeti lamaan</para>
  <para style="q2" vid="SNG 6:7">shaashii ati hagooggattu keessaa,</para>
  <para style="q2" vid="SNG 6:7">midhaan rumaanii ka gargar baqaqe fakkaatti.<verse eid="SNG 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 6:8"/>Giittoti jaatamaa fi gursumeeyyiin saddeettami,</para>
  <para style="q2" vid="SNG 6:8">durri laakkossi isaanii haga hin qanne,</para>
  <para style="q2" vid="SNG 6:8">jiraachuu dande'an.<verse eid="SNG 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 6:9"/>Saphaliisi tiyya</para>
  <para style="q2" vid="SNG 6:9">ta anaaf dhidhinna hin qanne isii qofa;</para>
  <para style="q2" vid="SNG 6:9">isiin haadha ifiitiif takkatti'i;</para>
  <para style="q2" vid="SNG 6:9">ta isii deette isii jaalatti.</para>
  <para style="q1" vid="SNG 6:9">Ijoolleen durraa isii dhagganee</para>
  <para style="q2" vid="SNG 6:9">«Ati ta leellifante» jedhaneen;</para>
  <para style="q2" vid="SNG 6:9">giittotii fi gursumeeyyiille isii leellisane.<verse eid="SNG 6:9"/></para>
  <para style="sp">Dubartooti Jaaloti Waajibitti'ii</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 6:10"/>Ta akka boruu dayya'uu mudhattu,</para>
  <para style="q2" vid="SNG 6:10">ta akka ji'aa miidhaddu,</para>
  <para style="q2" vid="SNG 6:10">ta akka adu'uu issitu,</para>
  <para style="q2" vid="SNG 6:10">ta akka loltoota baandiraa qabatanuu</para>
  <para style="q2" vid="SNG 6:10">arnya qaddu tun eennu?<verse eid="SNG 6:10"/></para>
  <para style="sp">Waajibichi</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 6:11"/>Ani muki woyni'ii akka quunxe,</para>
  <para style="q2" vid="SNG 6:11">muki rumaaniille akka guntute ilaaliisaaf,</para>
  <para style="q2" vid="SNG 6:11">gara dhooqa oorruu muka, «Almond» jedhamuu</para>
  <para style="q2" vid="SNG 6:11">gad dhaqe.<verse eid="SNG 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 6:12"/>Adoo ani hin beekin halchaan tiyya na buttee,</para>
  <para style="q2" vid="SNG 6:12">garreettaa fardaan harkifamu</para>
  <para style="q2" vid="SNG 6:12">ka qondaaltota kolbaa tiyyaa keessa na keette.<verse eid="SNG 6:12"/></para>
  <para style="sp">Dubartooti Jaaloti Waajibitti'ii</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 6:13"/>Ee, Shulaamitti'i! Deebi'i, deebi'i!</para>
  <para style="q2" vid="SNG 6:13">Akka nuuti si ilaalluuf, deebi'i, deebi'i!</para>
  <para style="sp" vid="SNG 6:13">Waajibichi</para>
  <para style="q1" vid="SNG 6:13">Akka nama sirba darabaa lamaa ilaaluu,</para>
  <para style="q2" vid="SNG 6:13">Shulaamittii tana isin maaf ilaaltan?<verse eid="SNG 6:13"/></para>
  <chapter eid="SNG 6"/>
  <chapter number="7" style="c" sid="SNG 7"/>
  <para style="sp">Waajibichi</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 7:1"/>Ee, intala qondaalaa!</para>
  <para style="q2" vid="SNG 7:1">Miilli keeti kophee bexxellicha keessaa,</para>
  <para style="q2" vid="SNG 7:1">attam attam dansa'a!</para>
  <para style="q1" vid="SNG 7:1">Baarreen tafa keetii dooqa</para>
  <para style="q2" vid="SNG 7:1">harki nama hujii harkaa beeku huje fakkaata.<verse eid="SNG 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 7:2"/>Handhurti teeti kuruurruu</para>
  <para style="q2" vid="SNG 7:2">akka qorii daadhiin woyni'ii keessaa hin dhabannee fakkaatti.</para>
  <para style="q1" vid="SNG 7:2">Uffaan keeti tuulaa qamadi'ii</para>
  <para style="q2" vid="SNG 7:2">ta daraaraan itti naanneffame fakkaata.<verse eid="SNG 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 7:3"/>Harmi keeti lamaanuu</para>
  <para style="q2" vid="SNG 7:3">lakkuu ilmoolee jiliba'aa fakkaata.<verse eid="SNG 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 7:4"/>Mormi keeti xelleephoo</para>
  <para style="q2" vid="SNG 7:4">ilka arbaa irraa hujante fakkaata.</para>
  <para style="q1" vid="SNG 7:4">Ilti teeti lamaanuu baleessa Heshiboonii</para>
  <para style="q2" vid="SNG 7:4">ka karra Batraabiimii biraa fakkaatan.</para>
  <para style="q1" vid="SNG 7:4">Funnaan keeti xelleephoo Libaanonii</para>
  <para style="q2" vid="SNG 7:4">ta gara Damaasqo'oo fuula galteertu fakkaata.<verse eid="SNG 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 7:5"/>Mataan keeti gaara Qarmelosii fakkaata;</para>
  <para style="q2" vid="SNG 7:5">rifeensi mataa keetiille</para>
  <para style="q2" vid="SNG 7:5">maraa haarrii dhiille'ee fakkaata;</para>
  <para style="q2" vid="SNG 7:5">mootichille shurrubbaa kanaan booji'ameera.<verse eid="SNG 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 7:6"/>Ee, jaalallee tiyya!</para>
  <para style="q2" vid="SNG 7:6">Ati attam attam miidhadda!</para>
  <para style="q2" vid="SNG 7:6">Ati attam attam tolta!</para>
  <para style="q2" vid="SNG 7:6">Attam attam nama gammachiitta!<verse eid="SNG 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 7:7"/>Hojjaan teeti muka meexxi'ii,</para>
  <para style="q2" vid="SNG 7:7">harmi keeti unkuruura isi'ii fakkaata.<verse eid="SNG 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 7:8"/>Ani, «Muka meexxi'ii san hin yaaba;</para>
  <para style="q2" vid="SNG 7:8">damee isaa hin qabadha» jedhe.</para>
  <para style="q1" vid="SNG 7:8">Harmi keeti akka unkuruura woyni'ii,</para>
  <para style="q2" vid="SNG 7:8">fooleen hafuura keetii</para>
  <para style="q2" vid="SNG 7:8">akka foolee muka appili'ii teetuu ti.<verse eid="SNG 7:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="SNG 7:9"/>Fooleen afaan keetiille</para>
  <para style="q2" vid="SNG 7:9">akka foolee daadhii woyni'ii dansa'aa teetuu ti.</para>
  <para style="sp" vid="SNG 7:9">Waajibittii</para>
  <para style="q1" vid="SNG 7:9">Daadhiin woyni'ii sun</para>
  <para style="q2" vid="SNG 7:9">hidhi'ii fi ilkaan jaalallee kiyyaa keessa dabartee,</para>
  <para style="q2" vid="SNG 7:9">laana gad buutuu ti.<verse eid="SNG 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 7:10"/>Ani ta jaalallee kiyyaa ti;</para>
  <para style="q2" vid="SNG 7:10">inni na halcha.<verse eid="SNG 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 7:11"/>Jaalallee kiyya, koy!</para>
  <para style="q2" vid="SNG 7:11">Baadiyyaa dhandhee,</para>
  <para style="q2" vid="SNG 7:11">ollaa keessa bullaa ti.<verse eid="SNG 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 7:12"/>Barii ganamaan kaanee,</para>
  <para style="q2" vid="SNG 7:12">gara addee muka woyni'ii dhandhee,</para>
  <para style="q2" vid="SNG 7:12">muki woyni'ii guntutee akka baqe,</para>
  <para style="q2" vid="SNG 7:12">muki rumaaniille akka daraare ilaalla!</para>
  <para style="q1" vid="SNG 7:12">Ani achitti jaalala kiyya si'iif hin kenna.<verse eid="SNG 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 7:13"/>Midhaan muka fedhii jaalalaa kakkaasu</para>
  <para style="q2" vid="SNG 7:13">hin uddowa;</para>
  <para style="q2" vid="SNG 7:13">ee, jaalallee kiyya,</para>
  <para style="q2" vid="SNG 7:13">midhaan dadansaan marti,</para>
  <para style="q2" vid="SNG 7:13">ka amma guuramee fi ka bilchaate,</para>
  <para style="q2" vid="SNG 7:13">ka ani si'iif lafa keyeeru</para>
  <para style="q2" vid="SNG 7:13">balbala teenna dura jiran.<verse eid="SNG 7:13"/></para>
  <chapter eid="SNG 7"/>
  <chapter number="8" style="c" sid="SNG 8"/>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 8:1"/>Ati adoo obboleessa kiyya</para>
  <para style="q2" vid="SNG 8:1">ka harma haadha tiyyaa hodhe, naaf teetee,</para>
  <para style="q2" vid="SNG 8:1">ani karaa irratti si dhaggee,</para>
  <para style="q2" vid="SNG 8:1">adoo si sunqadhee jiraadhe,</para>
  <para style="q2" vid="SNG 8:1">silaa eennulle na hin tuffatuuyyu.<verse eid="SNG 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 8:2"/>Ani silaa gara mana haadha tiyyaa,</para>
  <para style="q2" vid="SNG 8:2">ta na barsiittee si geessee,</para>
  <para style="q2" vid="SNG 8:2">daadhii woyni'ii dansaa sii kennee,</para>
  <para style="q2" vid="SNG 8:2">cunfaa midhaan muka rumaaniille</para>
  <para style="q2" vid="SNG 8:2">si obaasaayyu.<verse eid="SNG 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 8:3"/>Harki isaa bitaachi</para>
  <para style="q2" vid="SNG 8:3">mataa kiyya jala adoo jiraataa;</para>
  <para style="q2" vid="SNG 8:3">harki isaa middichi adoo na hanqafata.<verse eid="SNG 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 8:4"/>Ee, dubartoota Yerusaalemii,</para>
  <para style="q2" vid="SNG 8:4">jaalalleen kiyya haga inni fedhuma ifiitiin ka'utti,</para>
  <para style="q2" vid="SNG 8:4">akka isa hin dammassine,</para>
  <para style="q2" vid="SNG 8:4">ani isin kadhadha.<verse eid="SNG 8:4"/></para>
  <para style="s1">Faaruu Jayeesso'oo</para>
  <para style="sp">Dubartooti Jaaloti Waajibitti'ii</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 8:5"/>Ta jaalallee ifii qabattee,</para>
  <para style="q2" vid="SNG 8:5">goomolee keessaa ol bayiisatti jirtu tun eennu?</para>
  <para style="sp" vid="SNG 8:5">Waajibittii</para>
  <para style="q1" vid="SNG 8:5">Ani muka appili'ii jalaa si kaase;</para>
  <para style="q2" vid="SNG 8:5">haati teeti achitti ulfoottee,</para>
  <para style="q2" vid="SNG 8:5">isiin achitti ciniinsifattee si deette.<verse eid="SNG 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 8:6"/>Akka chaappa'aatitti gadhaa keeti keessatti,</para>
  <para style="q2" vid="SNG 8:6">irree teeti irralle'etti na mallatteeffadhu.</para>
  <para style="q1" vid="SNG 8:6">Jaalalli akka du'aa jabaata;</para>
  <para style="q2" vid="SNG 8:6">hinaaffaalle akka boolla awwaalaa jabaatti.</para>
  <para style="q1" vid="SNG 8:6">Bobeenni isi'ii akka bobe'a ibiddaa,</para>
  <para style="q2" vid="SNG 8:6">ka tallisuu ti.<verse eid="SNG 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 8:7"/>Bisaan guddaan</para>
  <para style="q2" vid="SNG 8:7">ibidda jaalalaa dhaanfuu hin dande'u;</para>
  <para style="q2" vid="SNG 8:7">lolaan haree hin dande'u.</para>
  <para style="q1" vid="SNG 8:7">Nami tokko qabeenna mana ifii mara</para>
  <para style="q2" vid="SNG 8:7">jaalalaaf yoo kenne,</para>
  <para style="q2" vid="SNG 8:7">ijjumaa hin tuffatama.<verse eid="SNG 8:7"/></para>
  <para style="sp">Obboleeyyan Waajibitti'ii</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 8:8"/>Nuuti obboleettii diqqittii,</para>
  <para style="q2" vid="SNG 8:8">guntuta hin baasin takka qanna.</para>
  <para style="q1" vid="SNG 8:8">Guyyaa isii kadhatane,</para>
  <para style="q2" vid="SNG 8:8">nuuti maan goona laati?<verse eid="SNG 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 8:9"/>Adoo isiin dalleyaa dhaka'aa teetee,</para>
  <para style="q2" vid="SNG 8:9">xelleephoo meeti'ii isii irratti hin ijaarra;</para>
  <para style="q2" vid="SNG 8:9">adoo isiin balbala teetee,</para>
  <para style="q2" vid="SNG 8:9">saanqaa hindheensaatiin hin cunna.<verse eid="SNG 8:9"/></para>
  <para style="sp">Waajibittii</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 8:10"/>Ani dalleya dhaka'aa ti;</para>
  <para style="q2" vid="SNG 8:10">harmi kiyya xelleephoo fakkaata;</para>
  <para style="q2" vid="SNG 8:10">ani ila isaa duratti nama nageya isaaf fidu te'e.<verse eid="SNG 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 8:11"/>Solomoon Ba'aal-Hamoon keessaa</para>
  <para style="q2" vid="SNG 8:11">oorruu muka woyni'ii qabaayyu.</para>
  <para style="q1" vid="SNG 8:11">Oorruu muka woyni'ii san worra eegutti kireesse;</para>
  <para style="q2" vid="SNG 8:11">tokko tokkoon isaanii</para>
  <para style="q2" vid="SNG 8:11">gatii midhaan woyni'iitiif,</para>
  <para style="q2" vid="SNG 8:11">meetii kuma tokko tokko fidaniiyyu.<verse eid="SNG 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 8:12"/>Oorruun muka woyni'ii tiyya, tiyyuma;</para>
  <para style="q2" vid="SNG 8:12">ee Solomoon, ati kuma fudhadhu;</para>
  <para style="q2" vid="SNG 8:12">worri oorruu muka woyni'ii eegulle</para>
  <para style="q2" vid="SNG 8:12">dhibba lama fudhatuu ti.<verse eid="SNG 8:12"/></para>
  <para style="sp">Waajibichi</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 8:13"/>Ee, ati ta oorruu keessa leetu,</para>
  <para style="q2" vid="SNG 8:13">jaaloti tiyya qoonqoo teeti caqasiisatti jiran;</para>
  <para style="q2" vid="SNG 8:13">anille qoonqoo teeti dhage'uu ti.<verse eid="SNG 8:13"/></para>
  <para style="sp">Waajibittii</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 8:14"/>Jaalallee kiyya, dafii koy!</para>
  <para style="q2" vid="SNG 8:14">Akka jiliba'aa yookiin akka ilmoolee gadansaa</para>
  <para style="q2" vid="SNG 8:14">gaara uddowaan itti latu irraa utaalii koy!<verse eid="SNG 8:14"/></para>
  <chapter eid="SNG 8"/>
</usx>
