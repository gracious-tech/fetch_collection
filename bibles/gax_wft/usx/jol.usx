<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JOL" style="id">- Guji Bible</book>
  <para style="h">Yo'elii Raagichaa</para>
  <para style="toc1">Kitaaba Yo'elii Raagichaa</para>
  <para style="toc2">Yo'elii Raagichaa</para>
  <para style="toc3">Yo'e.</para>
  <para style="mt1">Kitaaba Yo'elii Raagichaa</para>
  <para style="imt">Seensa</para>
  <para style="ip">Yo'eliin raagichi yoom akka lafa irra le'ee fi marroo dabarsii le'ii isaa wonni guddoon beekkamu hin jiru; te'uu malee kitaab isaa kun ka dhaggame dhaloota Kiristoosiitiin dura gara jaarraa shaneesso'oo yookiin arfeesso'ootitti, yennaa mootummaa mootii moototaa ta Faaresii akka te'e herregama; inni lafa Israa'eliititti yennaan hubiisi awwaannisaatii fi caami badii guddoo fidu akka dhufu'uu jiru hima; wonni kun guyyaan dhufa Mootii Waan Maraa ka dhikaate akka te'e akka mudhittu dubbata; guyyaan Mootii Waan Maraa yennaa dhufu, Mootiin Waan Maraa fedhii isaa balchittii worra mormanu mara akka adabu itti dabalee dubbata. Raagichi, kolbaan cubbuu irraa akka deebitu waamicha Mootii Waan Maraa himiisaan, cubbuu irraa deebinaan, Mootiin Waan Maraa addee duriititti isaan deebisee akka isaan eebbisu hubachiisa. Raaga isaa keessatti guddoo ka mudhatu, waadaa Mootiin Waan Maraa dhiiraa fi dubartii, dargaggootaa fi jaarsota, kolbaa ifii duudii irralle'etti Ayyaana ifii akka ergu ka himu.</para>
  <para style="iot">Haadhoo Dubbi'ii</para>
  <para style="io1">Hubiisa awwaannisaa<char style="ior"><ref loc="JOL 1:1-2:17">1:1—2:17</ref></char></para>
  <para style="io1">Waadaa adde'etti deebi'iisaa<char style="ior"><ref loc="JOL 2:18-27">2:18-27</ref></char></para>
  <para style="io1">Guyyaa Mootii Waan Maraa<char style="ior"><ref loc="JOL 2:28-3:21">2:28—3:21</ref></char></para>
  <chapter number="1" style="c" sid="JOL 1"/>
  <para style="s1">Hubiisa Awwaannisaa</para>
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1"/>Jechi Mootii Waan Maraa ka gara Yo'elii ilma Phetu'elii dhufe kana:<verse eid="JOL 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 1:2"/>Isin jaarsoleen dhage'a'a!</para>
  <para style="q2" vid="JOL 1:2">Worri Yihudaa keessa jirtanu dhage'a'a!</para>
  <para style="q1" vid="JOL 1:2">Wonni akkasii kun bara keessan keessatti,</para>
  <para style="q2" vid="JOL 1:2">yookiin bara abbootii teessanii keessatti teetee beettii?<verse eid="JOL 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 1:3"/>Waan kana ijoollee teessanitti hima'a;</para>
  <para style="q2" vid="JOL 1:3">ijoolleen teessanille ijoollee ifiititti,</para>
  <para style="q2" vid="JOL 1:3">ijoolleen isaaniille dhaloota dhufutti himanuu ti!<verse eid="JOL 1:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 1:4"/>Ka ilmoolee awwaannisa irraa hafe,</para>
  <para style="q2" vid="JOL 1:4">awwaannisi dargageessi nyaate;</para>
  <para style="q2" vid="JOL 1:4">ka awwaannisa dargageessa irraa hafe,</para>
  <para style="q2" vid="JOL 1:4">awwaannisi gugurdaan nyaate;</para>
  <para style="q2" vid="JOL 1:4">ka awwaannisa gugurdaa irraa hafe,</para>
  <para style="q2" vid="JOL 1:4">korophiis nyaate.<verse eid="JOL 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 1:5"/>Daadhiin woyni'ii waan isin irraa citteef,</para>
  <para style="q2" vid="JOL 1:5">isin worri machoottanu, dammaqa'aatii bowa'a!</para>
  <para style="q1" vid="JOL 1:5">Isinille worri daadhii woyni'ii untanu,</para>
  <para style="q2" vid="JOL 1:5">wiiccifadha'aa bowa'a!<verse eid="JOL 1:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 1:6"/>Kolbaan hunnaameyyiin bandallaan biyya tiyya tinteerti;</para>
  <para style="q2" vid="JOL 1:6">ilkaan isaanii akka ilkaan neenqaa,</para>
  <para style="q2" vid="JOL 1:6">a'oon isi'ii akka a'oo neenqa dhala'aa ti.<verse eid="JOL 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 1:7"/>Isaan woynii tiyya balleessane;</para>
  <para style="q2" vid="JOL 1:7">muka harru'uu kiyyalle mummurane;</para>
  <para style="q2" vid="JOL 1:7">quncee irraa quncisanee gatanee,</para>
  <para style="q2" vid="JOL 1:7">dameeleen addaattee hatte.<verse eid="JOL 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 1:8"/>Akka intala durraa woyaa gaddaa uffattee,</para>
  <para style="q2" vid="JOL 1:8">nami isii kadhatu waan du'eef boottuu,</para>
  <para style="q2" vid="JOL 1:8">isinille bowa'a!<verse eid="JOL 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 1:9"/>Kennaan midhaaniitii fi daadhii woyni'ii</para>
  <para style="q2" vid="JOL 1:9">Galma Mootii Waan Maraa irraa citte;</para>
  <para style="q2" vid="JOL 1:9">tanaaf hayyooti Mootii Waan Maraa tajaajilanu</para>
  <para style="q2" vid="JOL 1:9">wiiccifatanee bowan.<verse eid="JOL 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 1:10"/>Fichaan duwwaa hafeera;</para>
  <para style="q2" vid="JOL 1:10">midhaan badeera;</para>
  <para style="q2" vid="JOL 1:10">muki woyni'ii gogeera;</para>
  <para style="q2" vid="JOL 1:10">muki ejersaalle qooreera;</para>
  <para style="q2" vid="JOL 1:10">tanaaf latti hin bootti.<verse eid="JOL 1:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 1:11"/>Qamadi'ii fi garbuun,</para>
  <para style="q2" vid="JOL 1:11">midhaan galfamu martinuu waan badeef,</para>
  <para style="q2" vid="JOL 1:11">isin qonnaan bultooti gadda'a!</para>
  <para style="q2" vid="JOL 1:11">Isin worri woynii dhaabulle bowa'a!<verse eid="JOL 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 1:12"/>Muki woyni'iitii fi harru'uu qooreera;</para>
  <para style="q2" vid="JOL 1:12">muki rumaani'ii, muki meexxi'iitii fi appilii,</para>
  <para style="q2" vid="JOL 1:12">muki ficha'aa duudiin gogeera;</para>
  <para style="q2" vid="JOL 1:12">gammadi ilmaan namaa badeera.<verse eid="JOL 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 1:13"/>Kennaan midhaaniitii fi daadhii woyni'ii</para>
  <para style="q2" vid="JOL 1:13">ta Galma Waaqa keessaniitiif dhikeessitanu waan hin jirreef,</para>
  <para style="q2" vid="JOL 1:13">isin hayyooti woyaa gaddaa uffadha'aatii bowa'a!</para>
  <para style="q2" vid="JOL 1:13">Isin worri addee ciinca'aatitti tajaajiltanu, wiiccifadha'a!</para>
  <para style="q2" vid="JOL 1:13">Isin hayyooti Waaqa kiyya tajaajiltanu</para>
  <para style="q2" vid="JOL 1:13">woyaa gaddaa uffadha'aatii halkan duudii bowa'a!<verse eid="JOL 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 1:14"/>Laamaa woyyicha lassa'a!</para>
  <para style="q2" vid="JOL 1:14">Yaa'ii woyyittii waama'a!</para>
  <para style="q2" vid="JOL 1:14">Jaarsole'ee fi worra biyya san le'anu mara,</para>
  <para style="q2" vid="JOL 1:14">Galma Mootii Waan Maraa Waaqaa keessaniititti wolitti qaba'a!</para>
  <para style="q2" vid="JOL 1:14">Gara Mootii Waan Maraalle iyya'a!<verse eid="JOL 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 1:15"/>Aanne'e! Guyyaan Mootii Waan Maraa dhikaateera!</para>
  <para style="q2" vid="JOL 1:15">Waaqi waan mara dande'u guyyaan inni badii fidu dhikaateera.<verse eid="JOL 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 1:16"/>Sagaleen ila teenna duraa,</para>
  <para style="q2" vid="JOL 1:16">gammadii fi ililleessi Galma Waaqa keennaa keessaa,</para>
  <para style="q2" vid="JOL 1:16">ijjumaa badeera.<verse eid="JOL 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 1:17"/>Sanyiin facaafante biyyee jalatti korondhatteerti.</para>
  <para style="q2" vid="JOL 1:17">Midhaan waan badeef, manni kuusaa duwweera;</para>
  <para style="q2" vid="JOL 1:17">gootaraalle diigameera.<verse eid="JOL 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 1:18"/>Loon marra waan dhabaneef, madhataa asii achi yaa'an;</para>
  <para style="q2" vid="JOL 1:18">hoolotille rakkatiissatti jiran.<verse eid="JOL 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 1:19"/>Ee Mootii Waan Maraa! Marra diidaa ibiddi waan fixeef,</para>
  <para style="q2" vid="JOL 1:19">muka badda'aalle ibiddi waan gubeef,</para>
  <para style="q2" vid="JOL 1:19">ani gara keeti iyya.<verse eid="JOL 1:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 1:20"/>Maddi bisaanii isaan irraa waan gogeef,</para>
  <para style="q2" vid="JOL 1:20">marri diidaa isaan irraa waan gubateef,</para>
  <para style="q2" vid="JOL 1:20">bineensinuu gara keeti iyya.<verse eid="JOL 1:20"/></para>
  <chapter eid="JOL 1"/>
  <chapter number="2" style="c" sid="JOL 2"/>
  <para style="s1">Guyyaa Mootii Waan Maraa</para>
  <para style="p">
    <verse number="1" style="v" sid="JOL 2:1"/>Xiyoonitti tultullaa afuufa'a!</para>
  <para style="q2" vid="JOL 2:1">Gaara Xiyoonii woyyicha irratti</para>
  <para style="q2" vid="JOL 2:1">qoonqoo dammassitu dhageessisa'a!</para>
  <para style="q1" vid="JOL 2:1">Guyyaan Mootii Waan Maraa ariifatee waan dhufaaruuf,</para>
  <para style="q2" vid="JOL 2:1">worri lafa san le'u marti hollatuu ti!<verse eid="JOL 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 2:2"/>Guyyaan sun guyyaa dukkanaatii fi dimimmisaa,</para>
  <para style="q2" vid="JOL 2:2">guyyaa duumensaatii fi dukkana duuddu'uu ti;</para>
  <para style="q2" vid="JOL 2:2">akka boruun dayya'ee gaara irra babadhatu,</para>
  <para style="q2" vid="JOL 2:2">awwaannisi baca'aa fi hunnaamessi lafa guuta.</para>
  <para style="q1" vid="JOL 2:2">Wonni waan kana fakkaatu tanaan dura hin teene,</para>
  <para style="q2" vid="JOL 2:2">haganaa achille ijjumaa hin teetu.<verse eid="JOL 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 2:3"/>Dura isaaniitiin ibiddi gubaa deema;</para>
  <para style="q2" vid="JOL 2:3">duuba isaaniille'een bobe'i gubaa deema;</para>
  <para style="q2" vid="JOL 2:3">latti isaan bira hin geyin,</para>
  <para style="q2" vid="JOL 2:3">oorruu Edenii fakkaatti;</para>
  <para style="q2" vid="JOL 2:3">latti isaan bira dabarane ammoo,</para>
  <para style="q2" vid="JOL 2:3">goomolee duwwaa fakkaatti;</para>
  <para style="q2" vid="JOL 2:3">wonni isaan jalaa miliqu tokkolle hin jiru.<verse eid="JOL 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 2:4"/>Isaan farda fakkaatan;</para>
  <para style="q2" vid="JOL 2:4">akka farda lolaa gulufan.<verse eid="JOL 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 2:5"/>Akka garreettaa fardaa hididdisaa,</para>
  <para style="q2" vid="JOL 2:5">gaarota gubbaa utaalan;</para>
  <para style="q2" vid="JOL 2:5">akka ibidda huura gubuu,</para>
  <para style="q2" vid="JOL 2:5">waan mara guban;</para>
  <para style="q2" vid="JOL 2:5">akka loltoota jajjaboo lolaaf qophowanee,</para>
  <para style="q2" vid="JOL 2:5">gogeessaan yaa'an.<verse eid="JOL 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 2:6"/>Yennaa isaan dhaggite, kolbaan hin bararaxxi;</para>
  <para style="q2" vid="JOL 2:6">fuulli namaa soda'aan shankallowa.<verse eid="JOL 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 2:7"/>Akka duultotaa lolan;</para>
  <para style="q2" vid="JOL 2:7">akka loltootaa dalleya yaabanee dabaran;</para>
  <para style="q2" vid="JOL 2:7">tarre'een gara duraa yaa'an;</para>
  <para style="q2" vid="JOL 2:7">gara ifii yaa'anu irraa hin goranu.<verse eid="JOL 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 2:8"/>Tokko tokkoon isaanii,</para>
  <para style="q2" vid="JOL 2:8">tarre'een gara duraa yaa'an;</para>
  <para style="q2" vid="JOL 2:8">woraanaa fi guubee diinaa caccassanee dabaran;</para>
  <para style="q2" vid="JOL 2:8">wonni isaan dhooggu hin jiru.<verse eid="JOL 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 2:9"/>Gara qacha'aa timan;</para>
  <para style="q2" vid="JOL 2:9">dalleya qacha'aa irra fiigan;</para>
  <para style="q2" vid="JOL 2:9">utaalaa mana yaaban;</para>
  <para style="q2" vid="JOL 2:9">akka hattu'uu fodda'aan seenan.<verse eid="JOL 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 2:10"/>Latti isaan duratti hin tachooti;</para>
  <para style="q2" vid="JOL 2:10">gubbaalle hin raafanti.</para>
  <para style="q1" vid="JOL 2:10">Adu'uu fi jiin dukkanowan;</para>
  <para style="q2" vid="JOL 2:10">urjootille ifiisa hin lakkisan.<verse eid="JOL 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 2:11"/>Mootiin Waan Maraa qoonqoo ifii ta akka mandiisu'uu</para>
  <para style="q2" vid="JOL 2:11">loltoota ifii irratti dhageessisa;</para>
  <para style="q2" vid="JOL 2:11">loltooti isaa attam attam heddu'u!</para>
  <para style="q1" vid="JOL 2:11">Worri isaaf ajajamu bandalla'a;</para>
  <para style="q2" vid="JOL 2:11">dhugumaan guyyaan Mootii Waan Maraa gudda'a;</para>
  <para style="q2" vid="JOL 2:11">guddoo sodaachisaa waan te'eef,</para>
  <para style="q2" vid="JOL 2:11">guyyaa san eentu dande'ee dhaabbata?<verse eid="JOL 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 2:12"/>Mootiin Waan Maraa, «Ammumaayyuu, gadhaa keessan tokkochaan,</para>
  <para style="q2" vid="JOL 2:12">laamaan, bowaa fi gaddaan gara kiyya deebi'a'a!» jedha.<verse eid="JOL 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 2:13"/>Gadda keessan mudhisiisaaf,</para>
  <para style="q2" vid="JOL 2:13">woyaa teessan tarsaasiis hin gewu;</para>
  <para style="q1" vid="JOL 2:13">Mootiin Waan Maraa Waaqi keessan arjaa, mararaa,</para>
  <para style="q2" vid="JOL 2:13">mufi'iif ka hin ariifanne, ka jaalala bara baraa guddaa qabu,</para>
  <para style="q2" vid="JOL 2:13">adabiisaafille ka hin ariifanne, waan te'eef,</para>
  <para style="q2" vid="JOL 2:13">gara isaa deebi'a'a!<verse eid="JOL 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 2:14"/>Akka wotoo, Mootiin Waan Maraa Waaqi keessan</para>
  <para style="q2" vid="JOL 2:14">mufii irraa deebi'ee,</para>
  <para style="q2" vid="JOL 2:14">eebba ifii isiniif hin kenna fa'a.</para>
  <para style="q1" vid="JOL 2:14">Isinille Mootii Waan Maraa Waaqa keessaniif,</para>
  <para style="q2" vid="JOL 2:14">kennaa midhaaniitii fi daadhii woyni'ii hin dhikeessitan.<verse eid="JOL 2:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 2:15"/>Xiyoon keessatti tultullaa afuufa'a!</para>
  <para style="q2" vid="JOL 2:15">Laama woyyicha lassa'a!</para>
  <para style="q2" vid="JOL 2:15">Yaa'ii woyyittii waama'a!<verse eid="JOL 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 2:16"/>Kolbaa wolitti qaba'aatii,</para>
  <para style="q2" vid="JOL 2:16">yaa'ii woyyitti'iif qopheessa'a;</para>
  <para style="q2" vid="JOL 2:16">jaarsolee waama'a;</para>
  <para style="q2" vid="JOL 2:16">ijoolle'ee fi daa'immaan harmaalle wolitti qaba'a;</para>
  <para style="q2" vid="JOL 2:16">waajibootinuu kolloo ifii lakkisanuu ti.<verse eid="JOL 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 2:17"/>Hayyooti Mootii Waan Maraa tajaajilanu,</para>
  <para style="q2" vid="JOL 2:17">seensuma Galma Waaqaatii fi addee ciinca'aa wodhakka'atti bowanuu ti.</para>
  <para style="q1" vid="JOL 2:17">Isaan, «Mootii Waan Maraa, kolbaa teeti marari;</para>
  <para style="q2" vid="JOL 2:17">gosi dhibiin, ‹Waaqi keessan meet?› jedhiisaan,</para>
  <para style="q2" vid="JOL 2:17">akka nu tuffatanuu fi qaanessanu hin godhin» jedhanuu ti.<verse eid="JOL 2:17"/></para>
  <para style="s1">Deebii Waaqi Kolbaa Ifiitiif Kenne</para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 2:18"/>Mootiin Waan Maraa lafa ifiitiif hinaafee,</para>
  <para style="q2" vid="JOL 2:18">kolbaa ifiille marare.<verse eid="JOL 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 2:19"/>Mootiin Waan Maraa kolbaa ifiitiif deebisee,</para>
  <para style="q2" vid="JOL 2:19">«Kunoo, ani midhaan, daadhii woyni'iitii fi zayitii ejersaa,</para>
  <para style="q2" vid="JOL 2:19">haga quuttanutti isiniif hin kenna;</para>
  <para style="q2" vid="JOL 2:19">ani haganaa achi,</para>
  <para style="q2" vid="JOL 2:19">gosa biyya adda addaa oddu'utti</para>
  <para style="q2" vid="JOL 2:19">akka qaanottanu hin godhu.<verse eid="JOL 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 2:20"/>Awwaannisa gara kaabaatii isinitti dhufe</para>
  <para style="q2" vid="JOL 2:20">isin irraa fageessa;</para>
  <para style="q2" vid="JOL 2:20">gara goomole'eetii fi gara lafa urmaa isin irraa hin oofa;</para>
  <para style="q2" vid="JOL 2:20">ka dura yaa'u gara abbaayaa baya adu'uu,</para>
  <para style="q2" vid="JOL 2:20">ka duuba yaa'u gara abbaayaa seensa adu'uu hin oofa.</para>
  <para style="q2" vid="JOL 2:20">Achitti reeffi isaanii shamee hin ajowa.</para>
  <para style="q1" vid="JOL 2:20">Dhugumaan ani Mootiin Waan Maraa</para>
  <para style="q2" vid="JOL 2:20">waan guddoo isiniif godheera.<verse eid="JOL 2:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 2:21"/>«Ee lafa, hin sodaatin.</para>
  <para style="q2" vid="JOL 2:21">ani Waaqi waan guddoo waan sii godheef,</para>
  <para style="q2" vid="JOL 2:21">gammadii firinxiix!<verse eid="JOL 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOL 2:22"/>Isinille bineensota hin sodaatina'a;</para>
  <para style="q2" vid="JOL 2:22">marri itti bobbaatanu bisilee te'eera.</para>
  <para style="q2" vid="JOL 2:22">Mukille midhaan buuseera;</para>
  <para style="q2" vid="JOL 2:22">muki Harru'uutii fi muki woyni'ii midhaan bacaa buuseera.<verse eid="JOL 2:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="JOL 2:23"/>«Isin kolbaa Xiyoonii!</para>
  <para style="q2" vid="JOL 2:23">Mootii Waan Maraa Waaqa keessaniin</para>
  <para style="q2" vid="JOL 2:23">gammada'aatii firinxiixa'a;</para>
  <para style="q2" vid="JOL 2:23">inni yenna'aan,</para>
  <para style="q2" vid="JOL 2:23">akkuma durii bokkeya dansaa</para>
  <para style="q2" vid="JOL 2:23">ka duraatii fi duubaa isiniif kenneera.<verse eid="JOL 2:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOL 2:24"/>Eeddummeen midhaaniin ta guutante hin teeti;</para>
  <para style="q2" vid="JOL 2:24">daadhiin woyni'iitii fi zayitiin ejersaa</para>
  <para style="q2" vid="JOL 2:24">addee itti cunfantu guuttee irraan dhangalaati.<verse eid="JOL 2:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOL 2:25"/>Bara heddu'uuf akka loltoota guddo'oo ka ani isinitti ergee,</para>
  <para style="q2" vid="JOL 2:25">midhaan awwaannisi gugurdaan,</para>
  <para style="q2" vid="JOL 2:25">korophiis, ilmooleen awwaannisaatii fi</para>
  <para style="q2" vid="JOL 2:25">awwaannisi dargaggeeyyiin isin irraa fixane</para>
  <para style="q2" vid="JOL 2:25">ani isiniif hin deebisa.<verse eid="JOL 2:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOL 2:26"/>Nyaattanee hin quuttan;</para>
  <para style="q2" vid="JOL 2:26">ka waan baasaa hedduu isinii godhe</para>
  <para style="q2" vid="JOL 2:26">ana Mootii Waan Maraa Waaqa keessan hin leellifattan;</para>
  <para style="q2" vid="JOL 2:26">isin kolbaan tiyya haganaa achi hin qaanottanu.<verse eid="JOL 2:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOL 2:27"/>Kolbaa tiyya! Ani akka odduu teessan jiru,</para>
  <para style="q2" vid="JOL 2:27">Mootii Waan Maraa Waaqa keessan akka te'ee fi</para>
  <para style="q2" vid="JOL 2:27">ana malee Mootiin Waan Maraa dhibiin akka hin jirre hin beettan.</para>
  <para style="q2" vid="JOL 2:27">Haganaa achi kolbaan tiyya deebitee hin qaanottu» jedhe.<verse eid="JOL 2:27"/></para>
  <para style="s1">Guyyaa Mootii Waan Maraa</para>
  <para style="p">
    <verse number="28" style="v" sid="JOL 2:28"/>Ani Mootiin Waan Maraa, «Kanaan duuba, Ayyaana kiyya</para>
  <para style="q2" vid="JOL 2:28">nama mara irratti hin dhangalaasa;</para>
  <para style="q2" vid="JOL 2:28">ilmaanii fi ijoolleen durraa teessan raaga hin dubbatan;</para>
  <para style="q2" vid="JOL 2:28">jaarsoleelle oojjuu hin oojjatan;</para>
  <para style="q2" vid="JOL 2:28">dargaggootille mudhii hin dhaggan.<verse eid="JOL 2:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOL 2:29"/>Yennaa san,</para>
  <para style="q2" vid="JOL 2:29">ani tajaajiltoota tiyya dhiiraa fi dubartii irratti</para>
  <para style="q2" vid="JOL 2:29">Ayyaana kiyya hin dhangalaasa.<verse eid="JOL 2:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="JOL 2:30"/>«Gubba'aa fi lafa irratti, waan baasaa,</para>
  <para style="q2" vid="JOL 2:30">dhiigaa fi ibidda, duumensa aaraalle hin mudhisa.<verse eid="JOL 2:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOL 2:31"/>Guyyaan Mootii Waan Maraa gudda'aa fi sodaachisaan</para>
  <para style="q2" vid="JOL 2:31">adoo hin dhufiniin dura,</para>
  <para style="q2" vid="JOL 2:31">aduun hin dukkanootti; jiin dhiiga hin uffata.<verse eid="JOL 2:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOL 2:32"/>Worri maqaa Mootii Waan Maraa waamu marti hin fayya;</para>
  <para style="q2" vid="JOL 2:32">akkuma ani Mootiin Waan Maraa jedhe,</para>
  <para style="q2" vid="JOL 2:32">worri ani waame gaara Xiyoonii irratti,</para>
  <para style="q2" vid="JOL 2:32">Yerusaalem keessalle'etti hafee hin fayya» jedhe.<verse eid="JOL 2:32"/></para>
  <chapter eid="JOL 2"/>
  <chapter number="3" style="c" sid="JOL 3"/>
  <para style="s1">Mootiin Waan Maraa Gosa Biyya Adda Addaatitti Hin Mura</para>
  <para style="p">
    <verse number="1" style="v" sid="JOL 3:1"/>Mootiin Waan Maraa,</para>
  <para style="q1" vid="JOL 3:1">«Bara sanii fi yennaa sanitti,</para>
  <para style="q2" vid="JOL 3:1">boojuu Yihuda'aatii fi Yerusaalemii</para>
  <para style="q2" vid="JOL 3:1">yennaa deebisu,<verse eid="JOL 3:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="JOL 3:2"/>gosa biyya adda addaa mara wolitti qabee,</para>
  <para style="q2" vid="JOL 3:2">dhooqa Yoshaafaaxiititti<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="fqa" closed="false">Yoshaafaax: </char><char style="ft" closed="false">Afaan Ibrootaatiin </char><char style="fqa" closed="false">Mootiin Waan Maraa mure </char><char style="ft" closed="false">jechu'u.</char></note> hin geessa;</para>
  <para style="q2" vid="JOL 3:2">sababa isaan kolbaa tiyya Israa'el</para>
  <para style="q2" vid="JOL 3:2">biyya ormaatitti bittinneessanee,</para>
  <para style="q2" vid="JOL 3:2">lafa tiyya qoqoodataneef,</para>
  <para style="q2" vid="JOL 3:2">achitti isaanitti mura.<verse eid="JOL 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 3:3"/>Kolbaa tiyya ta booji'ante qoodamiisaaf,</para>
  <para style="q2" vid="JOL 3:3">hixaa buufataneeran;</para>
  <para style="q2" vid="JOL 3:3">ilmaan dhiiraa</para>
  <para style="q2" vid="JOL 3:3">dubartii woliin sagaagalaneef gatii kennanee,</para>
  <para style="q2" vid="JOL 3:3">ijoollee durraa daadhii woyni'iititti gurguratanee</para>
  <para style="q2" vid="JOL 3:3">ittiin unane.<verse eid="JOL 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JOL 3:4"/>«Isin worri Xiiroosii fi Sidoonii, adaala Filisxeemotaa keessa worri jirtanu maraayyuu, maan ana irraa qaddan? Ana haluu bayiisaaf teetanii? Yoo akkas teetanu te'e, ani hujii teessan ariifadhee mataa keessanitti hin deebisa. <verse eid="JOL 3:4"/><verse number="5" style="v" sid="JOL 3:5"/>Meeti'ii fi worqii tiyya, akkasuma meya kiyya ka gatii guddoo qabu fudhattanee galma keessan keessa keyattaneertan. <verse eid="JOL 3:5"/><verse number="6" style="v" sid="JOL 3:6"/>Namoota Yihuda'aatii fi Yerusaalemii biyyaa isaanii irraa fageessiisaaf, worra Giriikootaatitti gurgurtaneertan. <verse eid="JOL 3:6"/><verse number="7" style="v" sid="JOL 3:7"/>Amma ani addee isin isaan itti gurgurtane san lakkisanee akka ka'anu isaan hin godha. Waan isin isaan gootane, anille isin hin godha. <verse eid="JOL 3:7"/><verse number="8" style="v" sid="JOL 3:8"/>Ani ijoollee teessan ta dhiiraatii fi ta durraa namoota Yihuda'aatitti akka gurguramanu hin godha; isaanille dabarsanee namoota Saaba'aa, ka biyya fago'ootitti isaan hin gurguratan.<verse eid="JOL 3:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 3:9"/>«Lassii tana gosa biyya adda addaatitti lassa'a;</para>
  <para style="q2" vid="JOL 3:9">lolaaf qophowa'a;</para>
  <para style="q2" vid="JOL 3:9">loltoota kakkaasa'a;</para>
  <para style="q2" vid="JOL 3:9">loltooti teessan martinuu as dhikaatanee lolanuu ti.<verse eid="JOL 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 3:10"/>Qottoo teessan shallaagaa,</para>
  <para style="q2" vid="JOL 3:10">haantuu teessan eboo tunsiifadha'a;</para>
  <para style="q2" vid="JOL 3:10">nami dadhabaalle, ‹Ani jaba'a› jedhuu ti.<verse eid="JOL 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 3:11"/>Isin gosi biyya adda addaa duudiin,</para>
  <para style="q2" vid="JOL 3:11">dafa'aa baya'aatii,</para>
  <para style="q2" vid="JOL 3:11">dhooqatti wolitti dacha'a'a!» jedha.</para>
  <para style="b" vid="JOL 3:11"/>
  <para style="q1" vid="JOL 3:11">Ee Mootii Waan Maraa loltoota teeti gad ergi.<verse eid="JOL 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 3:12"/>Gosi biyya adda addaa martinuu ka'anee,</para>
  <para style="q2" vid="JOL 3:12">gara dhooqa Yoshaafaaxii dhaqanuu ti;</para>
  <para style="q2" vid="JOL 3:12">ani Mootiin Waan Maraa,</para>
  <para style="q2" vid="JOL 3:12">gosa biyya adda addaa ta adaala saniititti muriisaaf,</para>
  <para style="q2" vid="JOL 3:12">achi hin tee'a.<verse eid="JOL 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 3:13"/>Hammeenni isaanii guddoo bacateera;</para>
  <para style="q2" vid="JOL 3:13">akka midhaan geye haantu'uun haamanu isaan haama'a;</para>
  <para style="q2" vid="JOL 3:13">akka unkuruura woyni'ii addee itti cunfanutti guutanee dhiitanu dhiita'a!<verse eid="JOL 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 3:14"/>Guyyaan Mootiin Waan Maraa dhooqa mura'aa keessatti muru dhikaateera;</para>
  <para style="q2" vid="JOL 3:14">tanaaf gumiin bindillaan dhooqa mura'aa keessatti wolitti qabanteerti.<verse eid="JOL 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 3:15"/>Adu'uu fi ji'i hin dukkanowan;</para>
  <para style="q2" vid="JOL 3:15">urjootille ifa hin kennanu.<verse eid="JOL 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 3:16"/>Mootiin Waan Maraa Xiyoon keessaa akka neenqaa dhangaa dhowa;</para>
  <para style="q2" vid="JOL 3:16">Yerusaalem keessalle'ee hin mandi'a;</para>
  <para style="q2" vid="JOL 3:16">gubba'aa fi latti hin raafaman;</para>
  <para style="q1" vid="JOL 3:16">Mootiin Waan Maraa ammoo kolbaa ifii Israa'eliif,</para>
  <para style="q2" vid="JOL 3:16">addee itti baqatanu kushee hin te'a;<verse eid="JOL 3:16"/></para>
  <para style="s1">Waaqi Kolbaa Ifii Hin Eebbisa</para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 3:17"/>Tanaaf kolbaa isaatiin, «Ani Mootiin Waan Maraa Waaqi keessan,</para>
  <para style="q2" vid="JOL 3:17">Waaqa keessan akka te'e hin beettan;</para>
  <para style="q1" vid="JOL 3:17">Gaara woyyicha kiyya Xiyoon irra hin le'a;</para>
  <para style="q2" vid="JOL 3:17">Yerusaalemille qachaa woyyicha hin teeti;</para>
  <para style="q2" vid="JOL 3:17">ormi deebi'ee ijjumaa isii hin qabatu.<verse eid="JOL 3:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 3:18"/>«Guyyaa sanitti gaarri duudiin muka woyni'ii hin uffata;</para>
  <para style="q2" vid="JOL 3:18">kooba irratti loon aanan mirganu hin dhaggaman;</para>
  <para style="q2" vid="JOL 3:18">lagi Yihudaa keessa jiru duudiin bisaaniin guutama;</para>
  <para style="q2" vid="JOL 3:18">Galma Waaqaa keessaa bisaan hin burqa;</para>
  <para style="q2" vid="JOL 3:18">dhooqa muka gololchaa<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="fqa" closed="false">Muka gololchaa: </char><char style="ft" closed="false">Afaan Ibrootaatiin </char><char style="fqa" closed="false">Shiixiim </char><char style="ft" closed="false">jechu'u.</char></note> hin obaasa.<verse eid="JOL 3:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 3:19"/>«Sababa namooti Gibxi'iitii fi namooti Edoomii Yihudaa irratti hammeennaan ka'anee,</para>
  <para style="q2" vid="JOL 3:19">biyya isaanii keessatti</para>
  <para style="q2" vid="JOL 3:19">dhiiga nama balleessaa hin qannee dhangalaasaneef,</para>
  <para style="q2" vid="JOL 3:19">biyyi Gibxi'ii goomolee hin teeti;</para>
  <para style="q2" vid="JOL 3:19">Edoomille goomolee ona hin teeti.<verse eid="JOL 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 3:20"/>Ammoo biyya Yihuda'aa keessa kolbaan haga bara baraa hin leeti; Yerusaalem keessalle dhalootaa haga dhalootaatitti hin leeti;<verse eid="JOL 3:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 3:21"/>Haluu dur namoota Yihuda'aatii fi namoota Yerusaalemiitiif hin baasin ture,</para>
  <para style="q2" vid="JOL 3:21">amma hin baasaaf.</para>
  <para style="q1" vid="JOL 3:21">Ani Mootiin Waan Maraa gaara Xiyoonii irra hin le'a» jedheera.<verse eid="JOL 3:21"/></para>
  <chapter eid="JOL 3"/>
</usx>
