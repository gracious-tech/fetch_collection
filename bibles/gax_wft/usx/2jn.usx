<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Guji Bible</book>
  <para style="h">2 Ergaa Yohaannisii</para>
  <para style="toc1">Ergaa Yohaannis Erge Ta Lammeesso'oo</para>
  <para style="toc2">2 Ergaa Yohaannisii</para>
  <para style="toc3">2 Yoh.</para>
  <para style="mt1">Ergaa Yohaannis Erge</para>
  <para style="mt2">Ta Lammeesso'oo</para>
  <para style="imt">Seensa</para>
  <para style="ip">Ergaa Yohaannis erge ta lammeesso'oo ka barreesse jaarsicha ergamaa Yohaannis. Inni giittittii filatantee fi ijoollee isi'iitiif barreesse; jechuulle wolde'a kiristaanaa tokkoo fi miseensa isaatiif te'uu hin dhabu. Ergaan gabaadduun tun, akka wol jaalatanu yaadachiisiisaaf, barsiisota dharaameyyi'ii fi barsiisa isaanii irraa ifi eeggachiisiisaaf barreeffante.</para>
  <para style="iot">Haadhoo Dubbi'ii</para>
  <para style="io1">Seensa <char style="ior"><ref loc="2JN 1:1-3">1-3</ref></char></para>
  <para style="io1">Jaalaltiin Waan Maraa Caalti <char style="ior"><ref loc="2JN 1:4-6">4-6</ref></char></para>
  <para style="io1">Gorsaa fi ifi eeggachiisaa <char style="ior"><ref loc="2JN 1:7-11">7-11</ref></char></para>
  <para style="io1">Nageya Dhaamiisa <char style="ior"><ref loc="2JN 1:12-13">12-13</ref></char></para>
  <chapter number="1" style="c" sid="2JN 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1"/>Ana jaarsa biraa, giittittii filatantee fi ijoollee isi'iitiif:</para>
  <para style="p" vid="2JN 1:1">Ani dhugumaan isin jaaladha, na calla'aa moti, ammoo worri dhugaa beeku duudiinuu isin jaalata. <verse eid="2JN 1:1"/><verse number="2" style="v" sid="2JN 1:2"/>Sababille dhugaan nu keessa jirtu tun haga bara baraa nu woliin hin jiraatti. <verse eid="2JN 1:2"/><verse number="3" style="v" sid="2JN 1:3"/>Badhaadhi, arjumma'aa fi nageenni, Waaqa Abba'aa fi Yesuus Kiristoosii Ilma Abba'aa biraa, dhuga'aa fi jaalalaan nu woliin jiraatuu ti.<verse eid="2JN 1:3"/></para>
  <para style="s1">Dhuga'aa Fi Jaalala</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4"/>Akkuma Abbaan nu ajajetti, ijoollee teeti keessaa gariin dhuga'aan jiraatanuun dhaggiis guddoo na gammachiiseera. <verse eid="2JN 1:4"/><verse number="5" style="v" sid="2JN 1:5"/>Ammalle giitti'i! Akka wol jaalannuuf, ajaja jalqabaa jalqannee qannu san si yaadachiisiisaaf malee, ajaja haareya si'iif barreessiisaaf moti. <verse eid="2JN 1:5"/><verse number="6" style="v" sid="2JN 1:6"/>Jaalala jechuun ajaja Waaqaatiif ajajamiisaan le'iisa. Akkuma isin martinuu jalqabaa jalqaddanee dhageettane, ajaji isaa akka jaalalaan leetanu. <verse eid="2JN 1:6"/><verse number="7" style="v" sid="2JN 1:7"/>Akka Yesuus Kiristoos fooniin<note caller="+" style="f"><char style="fr" closed="false">1:7</char><char style="fqa" closed="false">Fooniin: </char><char style="ft" closed="false">Nafa namumma'aatiin</char></note> gara biyya lafaa dhufe worri dhugaa hin baanne, worri nama dokonkorsanu hedduun gara biyya lafaa bayaneeran. Eennulle nami akkasii nama nama dokonkorsuu fi nama Kiristoos mormu. <verse eid="2JN 1:7"/><verse number="8" style="v" sid="2JN 1:8"/>Gatii guutuu akka dhaggattanu malee, gatii waan hujjanee akka hin dhanne ifi eeggadha'a! <verse eid="2JN 1:8"/><verse number="9" style="v" sid="2JN 1:9"/>Nami barsiisa Yesuusiitiin hin jiraannee fi irraa goree deemu mara Waaqa hin qabu; nami barsiisa Kiristoosii qabatee ittiin jiraatu mara ammoo Abba'aa fi Ilma qaba. <verse eid="2JN 1:9"/><verse number="10" style="v" sid="2JN 1:10"/>Barsiisa kana adoo hin qabatin eennulle gara keessan yoo dhufe, mana keessanitti isa hin fudhatina'a! Nageyalle hin fuudhina'a! <verse eid="2JN 1:10"/><verse number="11" style="v" sid="2JN 1:11"/>Nami nageya isa fuudhu, hujii isaa hantuu san qoodama.<verse eid="2JN 1:11"/></para>
  <para style="s1">Nageya Dhaamiisa</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12"/>Waan isiniif barreessu waan hedduu qaba; te'uu malee woraqataa fi hallu'uun isiniif barreessiisaaf hin barbaadu; ammoo gammadi keenna guutuu akka te'uuf, gara keessan dhufee ilaan wol dhagginee, isin woliin haasowiisaaf addii qaba.<verse eid="2JN 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13"/>Ijoolleen obboleettii teeti filatantu'uu nageya si'iif dhaanti.<verse eid="2JN 1:13"/></para>
  <chapter eid="2JN 1"/>
</usx>
