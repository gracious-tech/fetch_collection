  <para style="io2">Galmi Waaqaa ijaarame<char style="ior"><ref loc="1KI 5:1-8:66">5:1—8:66</ref></char></para>
  <para style="io2">Woggoota Duubaa<char style="ior"><ref loc="1KI 9:1-11:43">9:1—11:43</ref></char></para>
