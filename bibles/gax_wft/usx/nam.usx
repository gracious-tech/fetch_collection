<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="NAM" style="id">- Guji Bible</book>
  <para style="h">Naahomii Raagichaa</para>
  <para style="toc1">Kitaaba Naahomii Raagichaa</para>
  <para style="toc2">Naahomii Raagichaa</para>
  <para style="toc3">Nah.</para>
  <para style="mt1">Kitaaba Naahomii Raagichaa</para>
  <para style="imt">Seensa</para>
  <para style="ip">Kitaab Naahomii bara duriitii jalqabanee diinota Israa'elii hamoota ka te'ane, worra Asooriitiif qachaa guddittii ta teete, Marroo badii Nanawwe'ee wolaloo dhikeessa. Nanawween dhaloota Kiristoosiitiin dura gara woggaa dhibba torbaatitti baduun isi'ii, gosa gadhaa jabaattuu<note caller="+" style="f"><char style="fr" closed="false">1:0 </char><char style="fqa" closed="false">Gadhaa jabaattu: </char><char style="ft" closed="false">Gadhi-jabeenni kun hammeenna mudhisa.</char></note> fi koortu irratti Waaqi akka muru mudhisa.</para>
  <para style="iot">Haadhoo Dubbi'ii</para>
  <para style="io1">Muraa Nanawwee irratti murante<char style="ior"><ref loc="NAM 1:1-5">1:1-5</ref></char></para>
  <para style="io1">Badii Nanawwe'ee<char style="ior"><ref loc="NAM 2:1-3:19">2:1—3:19</ref></char></para>
  <chapter number="1" style="c" sid="NAM 1"/>
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1"/>Mudhiin marroo Nanawwe'ee, kitaab mudhi'ii ka Naahomii nama biyya Elqoshii kana.<verse eid="NAM 1:1"/></para>
  <para style="s1">Waaqi Nanawwe'etti Mufate</para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 1:2"/>Waaqi hinaatticha;</para>
  <para style="q2" vid="NAM 1:2">Mootii Waan Maraa ka haluulle bawu;</para>
  <para style="q2" vid="NAM 1:2">inni mufii jadduu ifiitiin</para>
  <para style="q2" vid="NAM 1:2">diinota ifii irratti balaa buusa.<verse eid="NAM 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 1:3"/>Waaqi hunnaa guddoo qaba,</para>
  <para style="q2" vid="NAM 1:3">ammoo ariifatee hin aaru;</para>
  <para style="q2" vid="NAM 1:3">Yakkaamessa adabu male hin lakkisu.</para>
  <para style="b" vid="NAM 1:3"/>
  <para style="q2" vid="NAM 1:3">Karaan isaa bubbe'ee fi danbalii keessa;</para>
  <para style="q2" vid="NAM 1:3">duumensi bukuu<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="fqa" closed="false">Bukuu: </char><char style="ft" closed="false">Yookiin awwaara.</char></note> miila isaa ti.<verse eid="NAM 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 1:4"/>Inni abbaayaa xixee hin gossa;</para>
  <para style="q2" vid="NAM 1:4">laga maralle hin gossa;</para>
  <para style="q2" vid="NAM 1:4">Baashaan latti marraan beekkantee fi</para>
  <para style="q2" vid="NAM 1:4">Qarmelos latti qonnaan beekkante qooraneeran;</para>
  <para style="q2" vid="NAM 1:4">daraaraan Libaanosii harca'aneeran.<verse eid="NAM 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 1:5"/>Gaaroti isa duratti hin tacho'an;</para>
  <para style="q2" vid="NAM 1:5">koobotille hin baqan.</para>
  <para style="q2" vid="NAM 1:5">Latti isa duratti,</para>
  <para style="q2" vid="NAM 1:5">biyyi lafaatii fi</para>
  <para style="q2" vid="NAM 1:5">ka isii keessa le'anu marti hin raafaman.<verse eid="NAM 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 1:6"/>Mufii isaa jadduu dura eentu dhaabbatuu dande'a?</para>
  <para style="q2" vid="NAM 1:6">O'a aarii isaa eentu dande'ee ossa?</para>
  <para style="q2" vid="NAM 1:6">Mufiin isaa akka ibiddaa bobeetti;</para>
  <para style="q2" vid="NAM 1:6">rassaalle isa duratti hin bututa.<verse eid="NAM 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 1:7"/>Waaqi dansa'a;</para>
  <para style="q2" vid="NAM 1:7">yennaa rakkinnaa addee itti baqatanu.</para>
  <para style="q2" vid="NAM 1:7">Inni worra itti baqatu rakkinna irraa hin dhoogga;<verse eid="NAM 1:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="NAM 1:8"/>diinota ifii ammoo akka lolaa haxowuu</para>
  <para style="q2" vid="NAM 1:8">ijjumaa balleessee, dukkanatti hin ari'a.<verse eid="NAM 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 1:9"/>Isin maaf Waaqa irratti mala dhoottan?</para>
  <para style="q2" vid="NAM 1:9">Inni ijjumaa isin hin balleessa;</para>
  <para style="q2" vid="NAM 1:9">lammeessoo nami isa irratti ka'u hin jiru.<verse eid="NAM 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 1:10"/>Isin worri machoottanu,</para>
  <para style="q2" vid="NAM 1:10">akka qoree wol xaxxeetii fi</para>
  <para style="q2" vid="NAM 1:10">akka hicaacee goddee hin gubattan.<verse eid="NAM 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 1:11"/>Ee Nanawwe'e, nami Waaqa irratti mala dhowu,</para>
  <para style="q2" vid="NAM 1:11">ka waan hantuu gorsulle,</para>
  <para style="q2" vid="NAM 1:11">si keessaa ka'e.<verse eid="NAM 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 1:12"/>Mootiin Waan Maraa,</para>
  <para style="q2" vid="NAM 1:12">kolbaa ifii Israa'eliin, «Worri Asoorii hunnaameyyi'ii fi</para>
  <para style="q2" vid="NAM 1:12">hedduu te'anulle,</para>
  <para style="q2" vid="NAM 1:12">ijjeefamanee, hin badan.</para>
  <para style="q2" vid="NAM 1:12">Kolbaa tiyya, tanaan dura ani isin rakkisulle,</para>
  <para style="q2" vid="NAM 1:12">yoona deebi'ee isin hin rakkisu.<verse eid="NAM 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 1:13"/>Amma ani waanjoo worra Asoorii isin irraa cassee,</para>
  <para style="q2" vid="NAM 1:13">wodaroo sibiilaa ta ittiin hidhantane</para>
  <para style="q2" vid="NAM 1:13">isin irraa hin ciccira» jedhe.<verse eid="NAM 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NAM 1:14"/>Mootiin Waan Maraa marroo worra Asoorii,</para>
  <para style="q2" vid="NAM 1:14">«Haganaa achi</para>
  <para style="q2" vid="NAM 1:14">sanyiin maqaa keessan waansittu hin jiraattu;</para>
  <para style="q2" vid="NAM 1:14">galma waaqota keessanii keessaa</para>
  <para style="q2" vid="NAM 1:14">waaqota dharaa fakkii bocantee fi</para>
  <para style="q2" vid="NAM 1:14">fakkii baqisiifantee hujantee hin balleessa.</para>
  <para style="q2" vid="NAM 1:14">Isin worra bu'aa hin qanne waan teeteef,</para>
  <para style="q2" vid="NAM 1:14">boolla awwaalaa isiniif hin qota» jedhee ajaja baaseera.<verse eid="NAM 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 1:15"/>Kunoo, ergamaan oduu gammadaa odeessu,</para>
  <para style="q2" vid="NAM 1:15">ka nageya lallabu gaara gubba'aa dhufaara.</para>
  <para style="q1" vid="NAM 1:15">Kolbaa Yihuda'aa! Diinni keessan ijjumaa waan badeef,</para>
  <para style="q2" vid="NAM 1:15">haganaa achi biyya teessan hin qabatanu.</para>
  <para style="q1" vid="NAM 1:15">Tanaaf, gammadaan jilifadha'a.</para>
  <para style="q2" vid="NAM 1:15">Waan Waaqaaf kenniisaaf waadaa galtane Waaqaaf kenna'a.<verse eid="NAM 1:15"/></para>
  <chapter eid="NAM 1"/>
  <chapter number="2" style="c" sid="NAM 2"/>
  <para style="s1">Badii Nanawwe'ee</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 2:1"/>Nanawwe'e, ka balaa sitti buusu dhufeera.</para>
  <para style="q2" vid="NAM 2:1">Kushee teeti jabeeffadhu;</para>
  <para style="q2" vid="NAM 2:1">karaa eegi;</para>
  <para style="q2" vid="NAM 2:1">hidha keeti hidhadhu;</para>
  <para style="q2" vid="NAM 2:1">lolaaf qopheeffadhu.<verse eid="NAM 2:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 2:2"/>Saantuun sanyii Yaaqoobii saantulle,</para>
  <para style="q2" vid="NAM 2:2">woynii isaaniille balleessitulle,</para>
  <para style="q1" vid="NAM 2:2">Waaqi ilmaan Yaaqoobii ka te'ane,</para>
  <para style="q2" vid="NAM 2:2">ulfinna Israa'elii hin deebisa.<verse eid="NAM 2:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 2:3"/>Loltooti diinaa wontee diintuu qabataneeran;</para>
  <para style="q2" vid="NAM 2:3">isaan woyaa dhiillee uffataneeran;</para>
  <para style="q2" vid="NAM 2:3">yennaa isaan lolaaf qophowanu,</para>
  <para style="q2" vid="NAM 2:3">sibiilli garreettaa farda isaanii hin billiccisa;</para>
  <para style="q2" vid="NAM 2:3">woraanni isaanille hin mirmiffama.<verse eid="NAM 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 2:4"/>Garreettoti fardaa karaa irra ariiti'iin gulufan;</para>
  <para style="q2" vid="NAM 2:4">woldeennaa kara'aa keessa asii fi achi gulufan.</para>
  <para style="q1" vid="NAM 2:4">Isaan umeessaa<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="fqa" closed="false">Umeessaa: </char><char style="ft" closed="false">Yookiin Xassaa</char></note> bobe'u fakkaatan;</para>
  <para style="q2" vid="NAM 2:4">akka balaqqeetti'ii gugatan.<verse eid="NAM 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 2:5"/>Mootiin Asoorii loltoota ifii beekkantuu hin waama;</para>
  <para style="q2" vid="NAM 2:5">isaan dhufaaranuun karaa irratti hin gufatan;</para>
  <para style="q2" vid="NAM 2:5">gara dalleya qacha'aa hin gulufan;</para>
  <para style="q2" vid="NAM 2:5">wonteelle qophootteerti.<verse eid="NAM 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 2:6"/>Karri karaa lagaa ba'a jettee banante;</para>
  <para style="q2" vid="NAM 2:6">manni mootumma'aa jige.<verse eid="NAM 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 2:7"/>Nanawween salphatte;</para>
  <para style="q2" vid="NAM 2:7">mootittiin isi'ii booji'antee fudhatante;</para>
  <para style="q2" vid="NAM 2:7">tajaajiltooti isi'ii ta dubarti'ii,</para>
  <para style="q2" vid="NAM 2:7">qoonqoo gaddaa</para>
  <para style="q2" vid="NAM 2:7">ta akka qoonqoo saphaliisaa dhageessisan.</para>
  <para style="q2" vid="NAM 2:7">Gaddaan qoma ifii dhodhowatan.<verse eid="NAM 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 2:8"/>Akka bisaan naanniga cassee,</para>
  <para style="q2" vid="NAM 2:8">kolbaan Nanawwee keessaa hin baqatti!</para>
  <para style="q1" vid="NAM 2:8">«Dhaabbadhu! Dhaabbadhu!» jedhanee iyyan,</para>
  <para style="q2" vid="NAM 2:8">ammoo nami tokkolle hin deebi'u.<verse eid="NAM 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 2:9"/>Karri qachaa sanii baca'a,</para>
  <para style="q2" vid="NAM 2:9">qabeenni adda addaalle tuula'a;</para>
  <para style="q2" vid="NAM 2:9">Dhaqa'aatii meeti'ii fi worqii saama'a!<verse eid="NAM 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 2:10"/>Nanawween baddee, ontee, duwwiteerti!</para>
  <para style="q2" vid="NAM 2:10">soda'aan baqanee, jilbille sheephiseera.</para>
  <para style="q1" vid="NAM 2:10">Neenqoleen marti hin hollatti;</para>
  <para style="q2" vid="NAM 2:10">fuulli nama maraatuu shankallowe!<verse eid="NAM 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 2:11"/>Mandheen neenqaa,</para>
  <para style="q2" vid="NAM 2:11">godi isaan dardaroota neenqaa itti nyaachisanu,</para>
  <para style="q2" vid="NAM 2:11">latti neenqi kormii fi dhalaan</para>
  <para style="q2" vid="NAM 2:11">sodaa malee keessa deddeemanu fakkaattu</para>
  <para style="q2" vid="NAM 2:11">qachaa sun amma meet ree?<verse eid="NAM 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 2:12"/>Neenqi ilmoolee ifiitiif foon kukkuta;</para>
  <para style="q2" vid="NAM 2:12">neenqa dhala'aafille ka gewu adansa.</para>
  <para style="q1" vid="NAM 2:12">Inni goda ifii waan adanseen,</para>
  <para style="q2" vid="NAM 2:12">boolla ifiille foon kukkutameen guuta.<verse eid="NAM 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NAM 2:13"/>Nanawwe'e! Mootiin Waan Maraa Ka Waan Mara dade, «Kunoo, ani si morma! Garreettaa fardaa keeti ibiddaan guba. Loltoota teeti shallaaga'aan fixa; waan ati adanfattu mara ani lafa irraa balleessa; qoonqoon ergantoota teetiille haganaa achi hin dhage'antu» jedha.<verse eid="NAM 2:13"/></para>
  <chapter eid="NAM 2"/>
  <chapter number="3" style="c" sid="NAM 3"/>
  <para style="s1">Nanawwe'eef Aanne'e</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 3:1"/>Qachaa dhiiga namaa dhangalaasu,</para>
  <para style="q2" vid="NAM 3:1">ka sobaan guutame, ka saantu'uun guutame,</para>
  <para style="q2" vid="NAM 3:1">ka booju'uun guutame, Nanawwe'eef aanne'e!<verse eid="NAM 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 3:2"/>Worcaqqeessi<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="fqa" closed="false">Worcaqqeessi: </char><char style="ft" closed="false">Yookiin dhuqaasi</char></note> liche'eetii fi kokokkeessi korbo'oo,</para>
  <para style="q2" vid="NAM 3:2">hididdeessi fardaatii fi gugukkeessi garreettaa fardaa,</para>
  <para style="q2" vid="NAM 3:2">hin dhage'ama!<verse eid="NAM 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 3:3"/>Abbootiin fardaa hin gulufan,</para>
  <para style="q2" vid="NAM 3:3">shallaagaan isaanii hin billiccisa,</para>
  <para style="q2" vid="NAM 3:3">woraanni isaanii hin calaqqisa;</para>
  <para style="q2" vid="NAM 3:3">nami hedduun waan ijjeefameef,</para>
  <para style="q2" vid="NAM 3:3">reeffi tuulameera;</para>
  <para style="q2" vid="NAM 3:3">reeffi hedduu waan te'eef,</para>
  <para style="q2" vid="NAM 3:3">gufuu isaanitti te'eera!<verse eid="NAM 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 3:4"/>Ati ta xanoo xantu,</para>
  <para style="q2" vid="NAM 3:4">ta ilatti toltu sababa sagaagala keetii tun teete;</para>
  <para style="q2" vid="NAM 3:4">ati sagaagalummaa teetiin kolbaa garboonsitee,</para>
  <para style="q2" vid="NAM 3:4">xanoo teetiin gosa biyya adda addaalle gurgurte.<verse eid="NAM 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 3:5"/>Mootiin Waan Maraa Ka Waan Mara dade,</para>
  <para style="q2" vid="NAM 3:5">«Nanawwe'e, ani si morma;</para>
  <para style="q2" vid="NAM 3:5">uffana keeti si irraa shooqee<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="fqa" closed="false">Shooqee: </char><char style="ft" closed="false">Saaqe.</char></note> fuula keetitti buqa<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="fqa" closed="false">Buqa: </char><char style="ft" closed="false">Yookiin uffis.</char></note>;</para>
  <para style="q2" vid="NAM 3:5">gosi marti qullaa keeti,</para>
  <para style="q2" vid="NAM 3:5">mootummaalle salphinna keeti akka dhaggitu godha.<verse eid="NAM 3:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 3:6"/>«Ani huura<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="fqa" closed="false">Huura: </char><char style="ft" closed="false">Xuri.</char></note> sitti gata,</para>
  <para style="q2" vid="NAM 3:6">si tuffadha<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="fqa" closed="false">Tuffadha: </char><char style="ft" closed="false">Malch.</char></note>,</para>
  <para style="q2" vid="NAM 3:6">akka si daaw'atanulle godha.<verse eid="NAM 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 3:7"/>«Achiin duuba worri si daaw'ate marti si irraa baqataa,</para>
  <para style="q2" vid="NAM 3:7">‹Nanawween baddeerti; eentu bowaaf?› jedhan;</para>
  <para style="q2" vid="NAM 3:7">ka si jajjabeessu ani eessaa siif dhagga ree?» jedhe.<verse eid="NAM 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 3:8"/>Nanawwe'e, ati qachaa Tebesii<note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="fqa" closed="false">Tebes: </char><char style="ft" closed="false">Amma </char><char style="fqa" closed="false">Amooni</char><char style="ft" closed="false">jedhama; qachaa guddaa kaaba biyya Gibxi'ii jiru.</char></note>,</para>
  <para style="q2" vid="NAM 3:8">ka laga Nayilii<note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="fqa" closed="false">Nayili: </char><char style="ft" closed="false">Itoophiyaa keessatti </char><char style="fqa" closed="false">Abbayi</char><char style="ft" closed="false">jedhama.</char></note> biraa,</para>
  <para style="q2" vid="NAM 3:8">ka bisaan marseeru,</para>
  <para style="q2" vid="NAM 3:8">ka kaabiin isaa abbaaya'aa,</para>
  <para style="q2" vid="NAM 3:8">ka bisaan akka dalleyaa marseeru hin caaltaa?<verse eid="NAM 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 3:9"/>Qachaan Tebesii loltoota Itoophiya'aatii<note caller="+" style="f"><char style="fr" closed="false">3:9 </char><char style="fqa" closed="false">Itoophiyaa: </char><char style="ft" closed="false">Yaadannoo Dad. 2:13 irratti kenname ilaali.</char></note> fi Gibxi'ii</para>
  <para style="q2" vid="NAM 3:9">ta haga hin qanneen eegameera;</para>
  <para style="q2" vid="NAM 3:9">Worri Fuxiitii fi Liibiya'aalle qarqaartota Tebesii ti.<verse eid="NAM 3:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 3:10"/>Te'uu malee worri Tebesii qabamanee,</para>
  <para style="q2" vid="NAM 3:10">booji'amaneeran;</para>
  <para style="q2" vid="NAM 3:10">daa'immaan isaaniille</para>
  <para style="q2" vid="NAM 3:10">woldeennaa kara'aa mara irratti,</para>
  <para style="q2" vid="NAM 3:10">dhaka'aan tumamanee jijjiganeeran;</para>
  <para style="q2" vid="NAM 3:10">qondaaltota Tebesii irratti hixaa buufataneeran;</para>
  <para style="q2" vid="NAM 3:10">worri gugurdaan Tebesii marti</para>
  <para style="q2" vid="NAM 3:10">wodaroo sibiilaatiin hidhaman.<verse eid="NAM 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 3:11"/>Nanawwe'e, atille hin machootta,</para>
  <para style="q2" vid="NAM 3:11">gara dhokaataa hin ideenta;</para>
  <para style="q2" vid="NAM 3:11">diina duraa addee itti baqattu</para>
  <para style="q2" vid="NAM 3:11">hin barbaaddatta.<verse eid="NAM 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 3:12"/>Kusheen teeti mara akka muka harru'uu</para>
  <para style="q2" vid="NAM 3:12">ka midhaan qara bilchaatee ti.</para>
  <para style="q1" vid="NAM 3:12">Yoo hargufame,</para>
  <para style="q2" vid="NAM 3:12">afaan worra nyaatuu keessa harca'a.<verse eid="NAM 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 3:13"/>Loltoota teeti ilaali;</para>
  <para style="q2" vid="NAM 3:13">isaan akka dubarti'ii ti.</para>
  <para style="q1" vid="NAM 3:13">Balbalti biyya teetii</para>
  <para style="q2" vid="NAM 3:13">diinota keetiif badhattee bananteerti;</para>
  <para style="q2" vid="NAM 3:13">danqaraa balbalootaalle ibiddi fixeera.<verse eid="NAM 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="NAM 3:14"/>Diinaan waan marfantuuf,</para>
  <para style="q2" vid="NAM 3:14">bisaan woraabbadhu,</para>
  <para style="q2" vid="NAM 3:14">kushee teeti jabeeffadhu;</para>
  <para style="q2" vid="NAM 3:14">biyyee faaraa sukkuumii,</para>
  <para style="q2" vid="NAM 3:14">dhiitii qopheessii,</para>
  <para style="q2" vid="NAM 3:14">faara loobame huji!<verse eid="NAM 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 3:15"/>Achitti ibiddaan gubata;</para>
  <para style="q2" vid="NAM 3:15">shallaagaalle'een kukkutanta.</para>
  <para style="q2" vid="NAM 3:15">Ibiddi akka awwaannisaa si fixa.</para>
  <para style="b" vid="NAM 3:15"/>
  <para style="q1" vid="NAM 3:15">Akka awwaannisaatii fi</para>
  <para style="q2" vid="NAM 3:15">akka korophiisaa horuma hori!<verse eid="NAM 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="NAM 3:16"/>Ati urjoota gubba'aa caalaa,</para>
  <para style="q2" vid="NAM 3:16">daldaltoota teeti fakkanfatteerta.</para>
  <para style="q2" vid="NAM 3:16">Isaan akka awwaannisaa</para>
  <para style="q2" vid="NAM 3:16">biyya qorranee ka'anee badan.<verse eid="NAM 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="NAM 3:17"/>Eeddoti teeti akka korophiisaa ti;</para>
  <para style="q2" vid="NAM 3:17">qondaaltoti teeti akka korophiisa</para>
  <para style="q2" vid="NAM 3:17">Guyyaa qabbanaa</para>
  <para style="q2" vid="NAM 3:17">dalleya irratti heechatee ti.</para>
  <para style="q1" vid="NAM 3:17">Yennaa aduun baatu, koolaan ka'ee deema;</para>
  <para style="q2" vid="NAM 3:17">gara inni dhaqe eennuulle hin beeku.<verse eid="NAM 3:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="NAM 3:18"/>Ee mootii Asoorii,</para>
  <para style="q2" vid="NAM 3:18">eeddoti teeti muganeeran;</para>
  <para style="q2" vid="NAM 3:18">qondaaltoti teeti dunquuqqowaneeran.</para>
  <para style="q1" vid="NAM 3:18">Kolbaan teeti gaara irratti bittinnootteerti;</para>
  <para style="q2" vid="NAM 3:18">nami isaan wolitti qabulle hin jiru.<verse eid="NAM 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="NAM 3:19"/>Miidhama keeti nami goomsu hin jiru;</para>
  <para style="q2" vid="NAM 3:19">madaan teeti hin fayyitu.</para>
  <para style="q1" vid="NAM 3:19">Nami oduu jinnana keeti dhage'e marti</para>
  <para style="q2" vid="NAM 3:19">gammadaan harka dhowa.</para>
  <para style="q1" vid="NAM 3:19">Nami gadhi-jabinna keeti ka muummee hin qanne</para>
  <para style="q2" vid="NAM 3:19">jalaa bayeeru jiraa ree?<verse eid="NAM 3:19"/></para>
  <chapter eid="NAM 3"/>
</usx>
