<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LAM" style="id">- Guji Bible</book>
  <para style="h">Gadda Ermiyaasii</para>
  <para style="toc1">Kitaaba Gadda Ermiyaasii</para>
  <para style="toc2">Kitaaba Gadda Ermiyaasii</para>
  <para style="toc3">Gad.</para>
  <para style="mt1">Kitaaba Gadda Ermiyaasii</para>
  <para style="imt">Seensa</para>
  <para style="ip">Kitaab gadda Ermiyaasii kun dhaloota Kiristoosiitiin dura woggaa dhibba shanii fi saddeettamii jaatti Yerusaalem waan diigantee fi kolbaan isi'iille waan baqatteef wolaloo gaddaa shanan ka wolitti qabatee dhiyaate. Kutaan kitaaba kanaa irra caalaa marroo bowaatii fi gaddaa odeessulle, waan Waaqatti addatiisaa fi addii qabaatiisaa kutaan dubbatulle jira. Wolaloota kana Yihudooti dhaloota Kiristoosiitiin dura woggaa dhibba shanii fi saddeettamii jaatti, badii Yerusaalem irra dhaqqadde qaabbi'iif woggaa wogga'aan guyyoota waaqonfannaa laamaatii fi gadda irratti itti fayyadaman.</para>
  <para style="iot">Haadhoo dubbi'ii</para>
  <para style="io1">Gadda Yerusaalemii<char style="ior"><ref loc="LAM 1:1-22">1:1-22</ref></char></para>
  <para style="io1">Adabamiisa Yerusaalemii<char style="ior"><ref loc="LAM 2:1-22">2:1-22</ref></char></para>
  <para style="io1">Adabamiisaa fi addii<char style="ior"><ref loc="LAM 3:1-66">3:1-66</ref></char></para>
  <para style="io1">Diigama Yerusaalemii<char style="ior"><ref loc="LAM 4:1-22">4:1-22</ref></char></para>
  <para style="io1">Daadimata mararti'ii<char style="ior"><ref loc="LAM 5:1-22">5:1-22</ref></char></para>
  <chapter number="1" style="c" sid="LAM 1"/>
  <para style="s1">Gadda Yerusaalemii</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 1:1"/>Yerusaalemiin dur kolbaan keessa guutte attam qofi hatte!</para>
  <para style="q2" vid="LAM 1:1">Ka gosa biyya adda addaa oddu'utti guddoo teete,</para>
  <para style="q2" vid="LAM 1:1">attam akka haadha hiyyeessaa teete.</para>
  <para style="q2" vid="LAM 1:1">Qachoota oddu'utti giittii ta teete,</para>
  <para style="q2" vid="LAM 1:1">attam akka garbaa teete.<verse eid="LAM 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 1:2"/>Halkan guutuu hin bootti,</para>
  <para style="q2" vid="LAM 1:2">imimmaan boqoo isi'ii irra yaati.</para>
  <para style="q2" vid="LAM 1:2">Jaalota isi'ii keessaa</para>
  <para style="q2" vid="LAM 1:2">ka isii jajjabeessu tokkolle hin jiru.</para>
  <para style="q2" vid="LAM 1:2">Jaaloti isi'ii marti isii mormataneeran;</para>
  <para style="q2" vid="LAM 1:2">diinalle itti te'aneeran.<verse eid="LAM 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 1:3"/>Kolbaan Yihuda'aa</para>
  <para style="q2" vid="LAM 1:3">garbumma'aa fi eloo jaddu'uun rakkattee,</para>
  <para style="q2" vid="LAM 1:3">biyya ifii irraa ari'antee,</para>
  <para style="q2" vid="LAM 1:3">addee «Teenna» hin jenne,</para>
  <para style="q2" vid="LAM 1:3">lafa dhibii keessa leete.</para>
  <para style="q1" vid="LAM 1:3">Karaan milixxu ka hin jirre,</para>
  <para style="q2" vid="LAM 1:3">diinaan marfante.<verse eid="LAM 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 1:4"/>Nami jilaaf gara Xiyoonii dhufu,</para>
  <para style="q2" vid="LAM 1:4">waan hin jirreef,</para>
  <para style="q2" vid="LAM 1:4">karaan karra isi'ii martinuu duwwaa te'e;</para>
  <para style="q2" vid="LAM 1:4">Hayyootille gaddaan aadan.</para>
  <para style="q2" vid="LAM 1:4">Durrooti isi'ii hin gadditi.</para>
  <para style="q2" vid="LAM 1:4">Xiyoon gadda keessa jirti.<verse eid="LAM 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 1:5"/>Diinoti isi'ii isii irratti goottomanee,</para>
  <para style="q2" vid="LAM 1:5">badhaadhaneeran.</para>
  <para style="q1" vid="LAM 1:5">Bacinna cubbuu isi'iitiif,</para>
  <para style="q2" vid="LAM 1:5">Waaqi isii rakkise;</para>
  <para style="q1" vid="LAM 1:5">Ijoolleen isi'ii diinaan booji'antee,</para>
  <para style="q2" vid="LAM 1:5">fudhatanteerti.<verse eid="LAM 1:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 1:6"/>Ulfinni Yerusaalemii marti</para>
  <para style="q2" vid="LAM 1:6">irraa deemeera.</para>
  <para style="q1" vid="LAM 1:6">Sooreyyiin isi'iille</para>
  <para style="q2" vid="LAM 1:6">akka gadansa beelowee dadhabee,</para>
  <para style="q2" vid="LAM 1:6">worra isa ari'u duraa hin baqannee te'aneeran.<verse eid="LAM 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 1:7"/>Yerusaalem rakkatee mana dhaddee</para>
  <para style="q2" vid="LAM 1:7">waan dansaa ifii durii qaabatte.</para>
  <para style="q1" vid="LAM 1:7">Kolbaan isi'ii ammoo diinaan waan injifatanteef,</para>
  <para style="q2" vid="LAM 1:7">nami isii qarqaarulle hin jiru.</para>
  <para style="q2" vid="LAM 1:7">Diinoti isi'iille diigama isi'iititti kollane.<verse eid="LAM 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 1:8"/>Yerusaalem cubbuu guddoo hujjee</para>
  <para style="q2" vid="LAM 1:8">xomorootteerti;</para>
  <para style="q2" vid="LAM 1:8">isaan waan duwwaa isii dhagganeef,</para>
  <para style="q2" vid="LAM 1:8">worri isii ulfeessanu marti tuffataneeran;</para>
  <para style="q2" vid="LAM 1:8">isiinuu aadiisaan,</para>
  <para style="q2" vid="LAM 1:8">fokko'oon fuula ifii achi garagalti.<verse eid="LAM 1:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 1:9"/>Xomorummaan isi'ii woyaa isi'ii irratti mudhatti;</para>
  <para style="q2" vid="LAM 1:9">isiin waan hegeri teetu hin beenne;</para>
  <para style="q2" vid="LAM 1:9">jinnanni isi'ii sodaachisa'a;</para>
  <para style="q2" vid="LAM 1:9">ka isii jajjabeessu tokkolle hin jiru.</para>
  <para style="q2" vid="LAM 1:9">Diinoti isi'ii waan isii injifataneef,</para>
  <para style="q2" vid="LAM 1:9">rakkoo isi'ii akka ilaaluuf gara Waaqaa iyyite.<verse eid="LAM 1:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 1:10"/>Diinoti Yerusaalemii</para>
  <para style="q2" vid="LAM 1:10">qabeenna isi'ii dadansaa saamane.</para>
  <para style="q1" vid="LAM 1:10">Isiin Galma Waaqaa ka ifii,</para>
  <para style="q2" vid="LAM 1:10">ka Waaqi worri Yihudoota hin te'in</para>
  <para style="q2" vid="LAM 1:10">akka hin seenne dhoogge seenanuun dhaggite.<verse eid="LAM 1:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 1:11"/>Kolbaan isi'ii marti sagale'eef aaddi;</para>
  <para style="q2" vid="LAM 1:11">lubbu'uun jiraatiisaaf</para>
  <para style="q2" vid="LAM 1:11">qabeenna dadansaa ifii sagale'een jijjiiratti.</para>
  <para style="q1" vid="LAM 1:11">Yerusaalem «Waaqa! Na ilaali;</para>
  <para style="q2" vid="LAM 1:11">salphinna kiyya duudiille dhaggi!<verse eid="LAM 1:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 1:12"/>«Isin worri karaa tartanu,</para>
  <para style="q2" vid="LAM 1:12">isiniif womaayyuu te'uu dhaddulle,</para>
  <para style="q2" vid="LAM 1:12">ka Waaqi guyyaa mufii jaddu'uu natti fide,</para>
  <para style="q2" vid="LAM 1:12">rakkinna kiyya kana ka fakkaatu jiraa ree?</para>
  <para style="q2" vid="LAM 1:12">Me ilaala'aatii, dhagga'a!<verse eid="LAM 1:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 1:13"/>«Waaqi ol-gubbaa irraa ibidda erge;</para>
  <para style="q2" vid="LAM 1:13">ibiddille lafee tiyya keessa gube.</para>
  <para style="q2" vid="LAM 1:13">Inni tiyyoo miila kiyyatti afee,</para>
  <para style="q2" vid="LAM 1:13">duubatti na deebise.</para>
  <para style="q2" vid="LAM 1:13">Inni qofi na lakkisee,</para>
  <para style="q2" vid="LAM 1:13">guyyaa guutuu na gaggasse.<verse eid="LAM 1:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 1:14"/>«Inni waanjoo cubbuu tiyyaa wolitti hidhee,</para>
  <para style="q2" vid="LAM 1:14">morma kiyya irra keyeera.</para>
  <para style="q1" vid="LAM 1:14">Isiin guddoo waan ulfaattuuf</para>
  <para style="q2" vid="LAM 1:14">hunna na dhooggite.</para>
  <para style="q1" vid="LAM 1:14">Waaqi diinota ani dande'ee ifi irraa hin dhooggannetti</para>
  <para style="q2" vid="LAM 1:14">dabarsee na kenne.<verse eid="LAM 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 1:15"/>«Waaqi loltoota jajjaboo ani qabu dhidhiiteera;</para>
  <para style="q2" vid="LAM 1:15">inni dargaggoota tiyya balleessiisaaf loltoota erge;</para>
  <para style="q2" vid="LAM 1:15">kolbaa tiyya akka midhaan woyni'ii cunfe.<verse eid="LAM 1:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 1:16"/>«Wonni ani imimmaan tiyya</para>
  <para style="q2" vid="LAM 1:16">dhangalaasee bowuuf tana:</para>
  <para style="q2" vid="LAM 1:16">ka na jajjabeessu waan na irraa fagaateef,</para>
  <para style="q2" vid="LAM 1:16">ka na jabeessu hin jiru;</para>
  <para style="q2" vid="LAM 1:16">Diinni waan injifateef,</para>
  <para style="q2" vid="LAM 1:16">ijoolleen tiyya qofi hatteerti» jetti.<verse eid="LAM 1:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 1:17"/>Xiyoon harka ifii badhitteerti;</para>
  <para style="q2" vid="LAM 1:17">ka isii jajjabeessu ammoo hin jiru.</para>
  <para style="q2" vid="LAM 1:17">Ollooti isi'ii duudiin sanyii Yaaqoobiititti</para>
  <para style="q2" vid="LAM 1:17">diinota akka itti te'anu Waaqi ajajeera.</para>
  <para style="q2" vid="LAM 1:17">Yerusaalem odduu isaaniititti xomorootteerti.<verse eid="LAM 1:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 1:18"/>Yerusaalem, «Anattuu ajaja isaa dide malee,</para>
  <para style="q2" vid="LAM 1:18">Waaqi sirrii godhe.</para>
  <para style="q2" vid="LAM 1:18">Isin kolbaan marti dhage'a'a; rakkoo tiyyaalle ilaala'a;</para>
  <para style="q2" vid="LAM 1:18">dargaggooti tiyya dhiiraa fi dubartiin marti booji'amaneeran.<verse eid="LAM 1:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 1:19"/>«Ani jaalota tiyya mara waammadhe;</para>
  <para style="q2" vid="LAM 1:19">isaan ammoo na qarqaaruu didatane.</para>
  <para style="q2" vid="LAM 1:19">Hayyootaa fi sooreyyiin tiyya</para>
  <para style="q2" vid="LAM 1:19">lubbuu ifii jiraachisiisaaf, sagalee adoo barbaadatanuu</para>
  <para style="q2" vid="LAM 1:19">karaa qacha'aa keessatti du'ane.<verse eid="LAM 1:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 1:20"/>«Waaqa kiyya, attam akka rakkadhee,</para>
  <para style="q2" vid="LAM 1:20">keessi kiyya laalatee,</para>
  <para style="q2" vid="LAM 1:20">gadhaan kiyya raafame ilaali;</para>
  <para style="q2" vid="LAM 1:20">kolbaa tiyya alatti shallaagaan,</para>
  <para style="q2" vid="LAM 1:20">mana keessatti duuti fixiisatti jirti.<verse eid="LAM 1:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 1:21"/>«Kolbaan aadiisa kiyya dhageetteerti;</para>
  <para style="q2" vid="LAM 1:21">ammoo eennulle na hin jajjabeessine.</para>
  <para style="q2" vid="LAM 1:21">Diinoti kiyya marti rakkoo tiyya dhage'anee,</para>
  <para style="q2" vid="LAM 1:21">waan ati na irratti gootetti gammadaneeran.</para>
  <para style="q2" vid="LAM 1:21">Guyyaa jette san fidiitii,</para>
  <para style="q2" vid="LAM 1:21">isaanille akka kiyya te'anuu ti.<verse eid="LAM 1:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 1:22"/>«Hammeenni isaanii marti si duratti mudhatuu ti;</para>
  <para style="q2" vid="LAM 1:22">akkuma cubbuu tiyyaaf na adadde isaanille adabi.</para>
  <para style="q2" vid="LAM 1:22">Ani guddoo waan aadeef,</para>
  <para style="q2" vid="LAM 1:22">gaggabeera» jetti.<verse eid="LAM 1:22"/></para>
  <chapter eid="LAM 1"/>
  <chapter number="2" style="c" sid="LAM 2"/>
  <para style="s1">Adabamiisa Yerusaalemii</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 2:1"/>Attam attam Waaqi mufii ifiitiin</para>
  <para style="q2" vid="LAM 2:1">Xiyoonitti duumensa uffise!</para>
  <para style="q1" vid="LAM 2:1">Guddinna isi'iille ol-gubbaa irraa</para>
  <para style="q2" vid="LAM 2:1">gad lafatti darbe.</para>
  <para style="q1" vid="LAM 2:1">Xiyoon ijjata miila isaa akka teete,</para>
  <para style="q2" vid="LAM 2:1">guyyaa mufii ifii isii hin qaabanne.<verse eid="LAM 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 2:2"/>Waaqi bultoo Israa'elii mara</para>
  <para style="q2" vid="LAM 2:2">marartii malee balleesse.</para>
  <para style="q1" vid="LAM 2:2">Kushee Yihuda'aa mufii ifiitiin diigee balleessee,</para>
  <para style="q2" vid="LAM 2:2">Mootumma'aa fi bulchitoota isi'ii</para>
  <para style="q2" vid="LAM 2:2">gad lafatti gatee salphise.<verse eid="LAM 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 2:3"/>Mufii ifii jaddu'uun,</para>
  <para style="q2" vid="LAM 2:3">hunna Israa'elii mara dhoogge.</para>
  <para style="q1" vid="LAM 2:3">Diinni yennaa isaanitti dhufelle,</para>
  <para style="q2" vid="LAM 2:3">gargaaruu didate.</para>
  <para style="q1" vid="LAM 2:3">Akkuma bobeenni ibiddaa,</para>
  <para style="q2" vid="LAM 2:3">waan adaala isaa jiru mara gubu,</para>
  <para style="q2" vid="LAM 2:3">Waaqi Israa'el gube.<verse eid="LAM 2:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 2:4"/>Inni akka diinaa daaya ifii itti qajeelfate;</para>
  <para style="q2" vid="LAM 2:4">harka middicha ifiille qopheeffate.</para>
  <para style="q1" vid="LAM 2:4">Worra ila namaatitti tolu duudii,</para>
  <para style="q2" vid="LAM 2:4">akka diinaa ijjeese.</para>
  <para style="q1" vid="LAM 2:4">Dunkaanii kolbaa Xiyoonii irratti mufii ifii,</para>
  <para style="q2" vid="LAM 2:4">akka ibiddaa isaan irratti gabbise.<verse eid="LAM 2:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 2:5"/>Waaqi akka diinaatitti,</para>
  <para style="q2" vid="LAM 2:5">Israa'el balleesse;</para>
  <para style="q2" vid="LAM 2:5">inni kushee isi'ii maraa fi</para>
  <para style="q2" vid="LAM 2:5">mana mootummaa isi'ii mara balleesse.</para>
  <para style="q1" vid="LAM 2:5">Kolbaa Yihuda'aa irratti</para>
  <para style="q2" vid="LAM 2:5">bowichaa fi gadda bira dabarse.<verse eid="LAM 2:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 2:6"/>Galma ifii akka gosee fichaa keessaa</para>
  <para style="q2" vid="LAM 2:6">diigee balleesse;</para>
  <para style="q1" vid="LAM 2:6">Waaqi jilaa fi Sanbati Xiyoon keessatti</para>
  <para style="q2" vid="LAM 2:6">akka dedhamanu godhe.</para>
  <para style="q1" vid="LAM 2:6">Inni mufii ifii jaddu'uun</para>
  <para style="q2" vid="LAM 2:6">mootichaa fi hayyicha salphise.<verse eid="LAM 2:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 2:7"/>Waaqi addee ciincaa ifii didee,</para>
  <para style="q2" vid="LAM 2:7">Galma ifiille lakkise.</para>
  <para style="q1" vid="LAM 2:7">Dalleya mana mootummaa isi'ii</para>
  <para style="q2" vid="LAM 2:7">harka diinaatitti dabarsee kenne;</para>
  <para style="q2" vid="LAM 2:7">akkuma guyyaa jilaatitti godhamu,</para>
  <para style="q2" vid="LAM 2:7">Galma Waaqa keessatti diinni qeexale.<verse eid="LAM 2:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 2:8"/>Waaqi dalleya qachaa Xiyoonii diigiisaaf murteessee</para>
  <para style="q2" vid="LAM 2:8">wodaroo miki'ii<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="fqa" closed="false">Wodaroo miki'ii: </char><char style="ft" closed="false">Ta dheerinnaa fi badhinna woyii haga ittiin ilaalanu.</char></note> buuseera.</para>
  <para style="q1" vid="LAM 2:8">Inni balleessiisaaf</para>
  <para style="q2" vid="LAM 2:8">harka ifii irraa hin deebifanne.</para>
  <para style="q1" vid="LAM 2:8">Xelleepho'oo fi dalleya isi'ii</para>
  <para style="q2" vid="LAM 2:8">wolumatti diigeera.<verse eid="LAM 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 2:9"/>Balbalti karra isi'ii marti awwaalante,</para>
  <para style="q2" vid="LAM 2:9">danqaraan isi'iille caccabee bade.</para>
  <para style="q1" vid="LAM 2:9">Mootichii fi qondaaltoti isi'ii ari'amanee</para>
  <para style="q2" vid="LAM 2:9">gosa biyya dhibi'ii odduu jiran;</para>
  <para style="q1" vid="LAM 2:9">Haganaa achi seerri hin jiraatu;</para>
  <para style="q2" vid="LAM 2:9">raagoti isi'iille Waaqa irraa</para>
  <para style="q2" vid="LAM 2:9">mudhii hin dhagganu.<verse eid="LAM 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 2:10"/>Jaarsoleen qachaa Xiyoonii</para>
  <para style="q2" vid="LAM 2:10">mataa ifiititti bukuu<note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="fqa" closed="false">Bukuu: </char><char style="ft" closed="false">Yookiin awwaar.</char></note> firfirfatanee,</para>
  <para style="q2" vid="LAM 2:10">woyaa gaddaa uffatanee,</para>
  <para style="q2" vid="LAM 2:10">cadhi jedhanee lafa tee'ane.</para>
  <para style="q1" vid="LAM 2:10">Durri qachaa Xiyoonii</para>
  <para style="q2" vid="LAM 2:10">gaddaan lafa ilaalti.<verse eid="LAM 2:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 2:11"/>Kolbaan tiyya waan fixanteef,</para>
  <para style="q2" vid="LAM 2:11">ijoolle'ee fi annoolleen</para>
  <para style="q2" vid="LAM 2:11">karaa qacha'aa irratti waan gaggabaneef</para>
  <para style="q2" vid="LAM 2:11">bowiisaan ilti na jaamaarti.</para>
  <para style="q1" vid="LAM 2:11">Keessi kiyya na laalatee,</para>
  <para style="q2" vid="LAM 2:11">addii kutadhe.<verse eid="LAM 2:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 2:12"/>Ijoolleen akka loltoota madoottee,</para>
  <para style="q2" vid="LAM 2:12">karaa qacha'aa irratti gaggabanee,</para>
  <para style="q2" vid="LAM 2:12">«Sagale'ee fi bisaan» meet jedhaa,</para>
  <para style="q2" vid="LAM 2:12">harka haadha isaanii irratti du'an.<verse eid="LAM 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 2:13"/>Ee Yerusaalem, maan siin jedha?</para>
  <para style="q2" vid="LAM 2:13">Maani'iin wol si qixxeessa?</para>
  <para style="q1" vid="LAM 2:13">Xiyoonii tiyya, akka si jajjabeessuuf,</para>
  <para style="q2" vid="LAM 2:13">maaniin wol si fakkeessa?</para>
  <para style="q1" vid="LAM 2:13">Badiin si irra dhaqqadde akka abbaaya'aa badho'o;</para>
  <para style="q2" vid="LAM 2:13">eentu si fayyisuu dande'a?<verse eid="LAM 2:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 2:14"/>Raagoleen teeti</para>
  <para style="q2" vid="LAM 2:14">mudhii dharaa ta bu'aa hin qanne si'iif dhaggite.</para>
  <para style="q1" vid="LAM 2:14">Mudhii dharaatii fi dokonkora si'iif dhaggite malee,</para>
  <para style="q2" vid="LAM 2:14">yakkaa teeti si'itti ifa baasanee</para>
  <para style="q2" vid="LAM 2:14">badii si'itti dhufaartu si'i irraa hin oolchine.<verse eid="LAM 2:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 2:15"/>Worri karaa dabaru marti</para>
  <para style="q2" vid="LAM 2:15">cooraa harka sitti dhowaa, mataa ifii raasaa,</para>
  <para style="q2" vid="LAM 2:15">«Yerusaalemiin tun ta shaggummaa guutuu qadduu fi</para>
  <para style="q2" vid="LAM 2:15">qachaa biyyi lafaa duudiin itti gammaddee motii?» jedhan.<verse eid="LAM 2:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 2:16"/>Diinoti keeti marti afaan bananee si'itti cooran.</para>
  <para style="q2" vid="LAM 2:16">Ilkaan ciniinnatanee, «Yerusaalem balleessine.</para>
  <para style="q1" vid="LAM 2:16">Guyyaan nuuti eeggataa turre kana;</para>
  <para style="q2" vid="LAM 2:16">amma bira geennee dhaggine» jedhan.<verse eid="LAM 2:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 2:17"/>Waaqi waan yaade muummesse;</para>
  <para style="q2" vid="LAM 2:17">jecha ifiille guute.</para>
  <para style="q1" vid="LAM 2:17">Akkuma dur murteesse marartii malee si balleessee,</para>
  <para style="q2" vid="LAM 2:17">hunna diinota keetii jabeessee,</para>
  <para style="q2" vid="LAM 2:17">jinnana keetitti akka gammadanu godhe.<verse eid="LAM 2:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 2:18"/>Kolbaa qachaa Xiyoonii,</para>
  <para style="q2" vid="LAM 2:18">gara Waaqaa iyya'a!</para>
  <para style="q1" vid="LAM 2:18">Dalleya qachaa Xiyoonii,</para>
  <para style="q2" vid="LAM 2:18">imimmaan teeti halkanii fi guyyaa</para>
  <para style="q2" vid="LAM 2:18">akka lagaa yaatuu ti;</para>
  <para style="q2" vid="LAM 2:18">hin cadhisin;</para>
  <para style="q2" vid="LAM 2:18">boyiisalle hin lakkisin.<verse eid="LAM 2:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 2:19"/>Halkan guutuu yennaa yenna'atti ka'ii iyyi!</para>
  <para style="q2" vid="LAM 2:19">Waan gadhaa keeti keessa jiru,</para>
  <para style="q2" vid="LAM 2:19">Waaqa duratti dhikeessi.</para>
  <para style="q1" vid="LAM 2:19">Lubbuu ijoollee teetii,</para>
  <para style="q2" vid="LAM 2:19">ta qaxxaamura karaa irratti</para>
  <para style="q2" vid="LAM 2:19">beelaan gaggabaneef,</para>
  <para style="q2" vid="LAM 2:19">daadimanna'aan harka keeti gara Waaqaa ol kaasi.<verse eid="LAM 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 2:20"/>Yerusaalem, «Ee, Waaqa, kunoo ilaali!</para>
  <para style="q2" vid="LAM 2:20">Kolbaan ati akkana gooteertu jirtii?</para>
  <para style="q2" vid="LAM 2:20">Dubartooti annoolee ifii deyane nyaatanuu tii?</para>
  <para style="q1" vid="LAM 2:20">Hayyootii fi raagoti</para>
  <para style="q2" vid="LAM 2:20">Galma Waaqaa keessatti ijjeefamanuu tii?<verse eid="LAM 2:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 2:21"/>«Dargaggootii fi maanguddooti,</para>
  <para style="q2" vid="LAM 2:21">karaa irratti jiganee du'aneeran.</para>
  <para style="q1" vid="LAM 2:21">Dargaggooti dhiiraatii fi dubarti'ii</para>
  <para style="q2" vid="LAM 2:21">shallaaga'aan ijjeefamaneeran.</para>
  <para style="q1" vid="LAM 2:21">Guyyaa mufii teetii</para>
  <para style="q2" vid="LAM 2:21">marartii malee isaan qalte.<verse eid="LAM 2:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 2:22"/>«Akka guyyaa jilaa,</para>
  <para style="q2" vid="LAM 2:22">diinota kiyya adaala mara irraa waanteerta.</para>
  <para style="q1" vid="LAM 2:22">Guyyaa mufii Waaqaa,</para>
  <para style="q2" vid="LAM 2:22">ka miliqe yookiin jiru'uun ka hafe hin jiru.</para>
  <para style="q1" vid="LAM 2:22">Ijoollee ani uumadhee guddifadhe</para>
  <para style="q2" vid="LAM 2:22">diinni kiyya na jalaa fixe» jedhi.<verse eid="LAM 2:22"/></para>
  <chapter eid="LAM 2"/>
  <chapter number="3" style="c" sid="LAM 3"/>
  <para style="s1">Adabama, Cubbuu Irraa Deebi'iisaa Fi Addii</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 3:1"/>Ani nama ulee mufii Waaqaatiin,</para>
  <para style="q2" vid="LAM 3:1">adabamee rakkinna dhagge.<verse eid="LAM 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 3:2"/>Inni addee ifi hin jirre,</para>
  <para style="q2" vid="LAM 3:2">dukkanatti na ari'e.<verse eid="LAM 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 3:3"/>Inni dhugumaan guyyaa mara deddeebi'ee,</para>
  <para style="q2" vid="LAM 3:3">harka ifiitiin na adabe.<verse eid="LAM 3:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 3:4"/>Inni foonii fi gogaa kiyya dulloonsee,</para>
  <para style="q2" vid="LAM 3:4">lafee tiyyalle caccasse.<verse eid="LAM 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 3:5"/>Inni na marsee,</para>
  <para style="q2" vid="LAM 3:5">rakkinna hadhowa'aa fi laaleffata keessa na galche.<verse eid="LAM 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 3:6"/>Inni akka worra dur du'ee awwaalamee,</para>
  <para style="q2" vid="LAM 3:6">dukkana keessa akka le'u na tolche.<verse eid="LAM 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 3:7"/>Akka ani hin baaneef,</para>
  <para style="q2" vid="LAM 3:7">dalleya marsee natti ijaaree,</para>
  <para style="q2" vid="LAM 3:7">wodaroo sibiilaa ulfaattu'uun na hidhe.<verse eid="LAM 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 3:8"/>Qarqaarsaaf itti iyyadhulle,</para>
  <para style="q2" vid="LAM 3:8">na caqasuu dide.<verse eid="LAM 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 3:9"/>Karaa kiyya dhaka'aan duuchee,</para>
  <para style="q2" vid="LAM 3:9">daandii tiyyalle daddasse.<verse eid="LAM 3:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 3:10"/>Inni akka doobbaa<note caller="+" style="f"><char style="fr" closed="false">3:10 </char><char style="fqa" closed="false">Doobbaa: </char><char style="fqa" closed="false">Bineensa hamaa iyyaa fakkaatu tokko. </char></note> ciisee na gaaduutii fi</para>
  <para style="q2" vid="LAM 3:10">akka neenqa dhokaata jiruu ti.<verse eid="LAM 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 3:11"/>Inni karaa irraa na harkisee, kukkutee,</para>
  <para style="q2" vid="LAM 3:11">qarqaarsa malee na lakkise.<verse eid="LAM 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 3:12"/>Guubee ifii dhisee,</para>
  <para style="q2" vid="LAM 3:12">itti qajeelfata daaya ifii na godhe.<verse eid="LAM 3:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 3:13"/>Inni daaya subba ifii keessaa luqqisee,</para>
  <para style="q2" vid="LAM 3:13">kalattii tiyya woraane.<verse eid="LAM 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 3:14"/>Kolbaan tiyya marti natti kollitee,</para>
  <para style="q2" vid="LAM 3:14">guyyaa guutuu weeddu'uun natti murgite.<verse eid="LAM 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 3:15"/>Inni rakkinnaan jiruu tiyya hadheessee,</para>
  <para style="q2" vid="LAM 3:15">waan akka hargiisaa na quusse.<verse eid="LAM 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 3:16"/>Inni cabbi'iin ilkaan kiyya caccassee,</para>
  <para style="q2" vid="LAM 3:16">bukuu keessatti na gangalche.<verse eid="LAM 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 3:17"/>Ani nageya dhabee,</para>
  <para style="q2" vid="LAM 3:17">gammadi maan akka te'e dedhe.<verse eid="LAM 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 3:18"/>Tanaaf ani «Jabeenni kiyya,</para>
  <para style="q2" vid="LAM 3:18">addiin ani Waaqa irraa eegadhu marti baddeerti» jedhe.<verse eid="LAM 3:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 3:19"/>Rakko'oo fi daaqa kiyya qaabatiis,</para>
  <para style="q2" vid="LAM 3:19">akka qararu'uutii fi hadhoottu'uu natti teeteerti.<verse eid="LAM 3:19"/></para>
  <para style="q2">
    <verse number="20" style="v" sid="LAM 3:20"/>Ani yennaa tana qaabadhu mara,</para>
  <para style="q2" vid="LAM 3:20">mataa buusa.<verse eid="LAM 3:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 3:21"/>Teetulle yennaa waan tokko qaabadhu,</para>
  <para style="q2" vid="LAM 3:21">addii qaba:<verse eid="LAM 3:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 3:22"/>Jaalalli Waaqaa ka bara baraa waan te'eef,</para>
  <para style="q2" vid="LAM 3:22">marartii isaa ta dhuma hin qanne irraa ta kaate</para>
  <para style="q2" vid="LAM 3:22">nuuti badiisa dhanne.<verse eid="LAM 3:22"/></para>
  <para style="q2">
    <verse number="23" style="v" sid="LAM 3:23"/>Jaalallii fi marartiin isaa barii mara haareya;</para>
  <para style="q2" vid="LAM 3:23">addatamummaan isaa guddo'o.<verse eid="LAM 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="LAM 3:24"/>Ani ifiin, «Waaqi qooda kiyya;</para>
  <para style="q2" vid="LAM 3:24">tanaaf isatti addadha» jedhe.<verse eid="LAM 3:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="LAM 3:25"/>Waaqi worra addi'iin isa eegatuuf,</para>
  <para style="q2" vid="LAM 3:25">worra isa barbaaduuf dansa'a.<verse eid="LAM 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="LAM 3:26"/>Tanaaf nami cadhisee</para>
  <para style="q2" vid="LAM 3:26">fayyisiisa Waaqaa eegatiis dansa'a.<verse eid="LAM 3:26"/></para>
  <para style="q2">
    <verse number="27" style="v" sid="LAM 3:27"/>Nami bara dargaggumma'aatitti</para>
  <para style="q2" vid="LAM 3:27">waanjoo ba'atiisa barachuun dansa'a.<verse eid="LAM 3:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="LAM 3:28"/>Yennaa Waaqi waanjoo isa ba'achiise,</para>
  <para style="q2" vid="LAM 3:28">qofii ifii cadhisee tee'uu ti.<verse eid="LAM 3:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="LAM 3:29"/>Ammalle addiin jiraatuu waan dandeettuuf,</para>
  <para style="q2" vid="LAM 3:29">ifi gad qabuu ti.<verse eid="LAM 3:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="LAM 3:30"/>Nama isa kabaluuf boqoo ifii kennuu ti;</para>
  <para style="q2" vid="LAM 3:30">arraballe fudhatuu ti.<verse eid="LAM 3:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="LAM 3:31"/>Waaqi haga bara baraa isa hin gatu.<verse eid="LAM 3:31"/></para>
  <para style="q2">
    <verse number="32" style="v" sid="LAM 3:32"/>Inni nama gaddisiisulle,</para>
  <para style="q2" vid="LAM 3:32">akka jaalala ifii ka bara baraa gudda'aatitti marartii qaba.<verse eid="LAM 3:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="LAM 3:33"/>Inni nama rakkisu'uu fi gaddisiisu'utti hin gammadu.<verse eid="LAM 3:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="LAM 3:34"/>Hidhantooti biyya tokkoo</para>
  <para style="q2" vid="LAM 3:34">yennaa dhiitamanu,<verse eid="LAM 3:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="LAM 3:35"/>Waaqa Ol-Aanaa duratti</para>
  <para style="q2" vid="LAM 3:35">mirgi ilmaan namaa yennaa dhooggamu,<verse eid="LAM 3:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="LAM 3:36"/>Haajaan nama tokkoo haqa yennaa dhabu,</para>
  <para style="q2" vid="LAM 3:36">Waaqi kana hin dhagguu?<verse eid="LAM 3:36"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="37" style="v" sid="LAM 3:37"/>Waaqi adoo hin ajajin,</para>
  <para style="q2" vid="LAM 3:37">ka dubbatee woy godhuu dande'u eennu?<verse eid="LAM 3:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="LAM 3:38"/>Wonni dansa'aa fi hantuulle</para>
  <para style="q2" vid="LAM 3:38">ajaja Waaqa Ol-Aana'aatiin teetii motii ree?<verse eid="LAM 3:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="LAM 3:39"/>Nami adoo hin du'in</para>
  <para style="q2" vid="LAM 3:39">sababa cubbuu ifiitiin</para>
  <para style="q2" vid="LAM 3:39">yoo adabame maaf gunguma ree?<verse eid="LAM 3:39"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="40" style="v" sid="LAM 3:40"/>Karaa keenna qorqorree ilaallee,</para>
  <para style="q2" vid="LAM 3:40">gara Waaqaa deebinuu ti.<verse eid="LAM 3:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="LAM 3:41"/>Kowa'a gadha'aa fi harka keenna</para>
  <para style="q2" vid="LAM 3:41">gara Waaqa ol-gubbaa jiruu ol kaannee,<verse eid="LAM 3:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="LAM 3:42"/>«Nuuti ajaja keeti didannee, jallannee</para>
  <para style="q2" vid="LAM 3:42">atille nu'uuf hin araaranne.<verse eid="LAM 3:42"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="43" style="v" sid="LAM 3:43"/>«Ati aari'iin guutantee, nu ariitee,</para>
  <para style="q2" vid="LAM 3:43">marartii malee nu ijjeette.<verse eid="LAM 3:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="LAM 3:44"/>Daadimannaan teenna si bira akka hin geenne,</para>
  <para style="q2" vid="LAM 3:44">duumensaan ifi gollatte.<verse eid="LAM 3:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="LAM 3:45"/>Gosa biyya adda addaa oddu'utti</para>
  <para style="q2" vid="LAM 3:45">xuri'ii fi huuraa nu goote.<verse eid="LAM 3:45"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="46" style="v" sid="LAM 3:46"/>«Diinoti keenna marti</para>
  <para style="q2" vid="LAM 3:46">afaan bananee nutti murgane.<verse eid="LAM 3:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="LAM 3:47"/>Soda'aa fi boolla bu'iis,</para>
  <para style="q2" vid="LAM 3:47">diigamaa fi badiin nu dhaqqaddeerti» hin jenna.<verse eid="LAM 3:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="LAM 3:48"/>Kolbaan tiyya waan badeef</para>
  <para style="q2" vid="LAM 3:48">imimmaan ila tiyyaa akka lagaa lolaati.<verse eid="LAM 3:48"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="49" style="v" sid="LAM 3:49"/>Imimmaan tiyya yennaa mara lolaati,<verse eid="LAM 3:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="LAM 3:50"/>Tun haga Waaqi ol-gubbaa irraa gad</para>
  <para style="q2" vid="LAM 3:50">ilaalee na dhaggutti teeti.<verse eid="LAM 3:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="LAM 3:51"/>Waan diinni kolbaa qachaa Yerusaalemii irratti godhe</para>
  <para style="q2" vid="LAM 3:51">yennaa dhaggitu gadhaan kiyya hin gadda.<verse eid="LAM 3:51"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="52" style="v" sid="LAM 3:52"/>Diinoti kiyya ka sababa malee na jibbanu</para>
  <para style="q2" vid="LAM 3:52">akka gororri'ii na adansane.<verse eid="LAM 3:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="LAM 3:53"/>Jiru'uunuu boollatti na gatanee</para>
  <para style="q2" vid="LAM 3:53">afaan boollaa dhaka'aan cufane.<verse eid="LAM 3:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="LAM 3:54"/>Bisaan mataa kiyya irra dacha'ee,</para>
  <para style="q2" vid="LAM 3:54">ani «Du'aara» jedhe.<verse eid="LAM 3:54"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="55" style="v" sid="LAM 3:55"/>Qilee boollaa keessaa,</para>
  <para style="q2" vid="LAM 3:55">maqaa keeti waammadhe.<verse eid="LAM 3:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="LAM 3:56"/>Ati gaaffii tiyya dhageetteertaa,</para>
  <para style="q2" vid="LAM 3:56">yennaa ani qarqaarsaaf sitti iyyadhu,</para>
  <para style="q2" vid="LAM 3:56">gurra keeti hin qabatin; ammoo furii naa kenni!<verse eid="LAM 3:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="LAM 3:57"/>Yennaa ani si waammadhe,</para>
  <para style="q2" vid="LAM 3:57">ati na bira dhuttee, «Hin sodaatin!» naan jette.<verse eid="LAM 3:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="LAM 3:58"/>Goottaa kiyya! Haajaa kiyya fudhattee,</para>
  <para style="q2" vid="LAM 3:58">lubbuu tiyya wodatte.<verse eid="LAM 3:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="LAM 3:59"/>Goottaa kiyya!</para>
  <para style="q2" vid="LAM 3:59">Daba na irratti hujame dhaggiteerta,</para>
  <para style="q2" vid="LAM 3:59">ati naaf muri!<verse eid="LAM 3:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="LAM 3:60"/>Haluu diinoti na irratti qabanuu fi</para>
  <para style="q2" vid="LAM 3:60">mala isaan na irratti dhowane</para>
  <para style="q2" vid="LAM 3:60">mara dhaggiteerta.<verse eid="LAM 3:60"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="61" style="v" sid="LAM 3:61"/>Ee waaqa! Murgoo isaan natti murgane,</para>
  <para style="q2" vid="LAM 3:61">mala isaan natti dhowane dhageetteerta.<verse eid="LAM 3:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="LAM 3:62"/>Guyyaa guutuu diinoti kiyya,</para>
  <para style="q2" vid="LAM 3:62">na irratti hasaasaa, gunguman.<verse eid="LAM 3:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="LAM 3:63"/>Kunoo isaan yennaa tee'anu fi ka'anu mara,</para>
  <para style="q2" vid="LAM 3:63">weeddu'uun natti murgan.<verse eid="LAM 3:63"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="64" style="v" sid="LAM 3:64"/>Ee Waaqa!</para>
  <para style="q2" vid="LAM 3:64">Akka hujii isaaniititti isaaniif kenni!<verse eid="LAM 3:64"/></para>
  <para style="q1">
    <verse number="65" style="v" sid="LAM 3:65"/>Abaarsi keeti akka isaanitti dhufu,</para>
  <para style="q2" vid="LAM 3:65">mataa isaanii jabeessi!<verse eid="LAM 3:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="LAM 3:66"/>Waaqa kiyya! Aari'iin isaan ari'iitii,</para>
  <para style="q2" vid="LAM 3:66">Biyya lafaa irraa isaan balleessi.<verse eid="LAM 3:66"/></para>
  <chapter eid="LAM 3"/>
  <chapter number="4" style="c" sid="LAM 4"/>
  <para style="s1">Diigama Yerusaalemii</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 4:1"/>Worqiin attam calalaqa ifii dhaddee,</para>
  <para style="q2" vid="LAM 4:1">worqiin qulqulluun attam jijjiirante!</para>
  <para style="q1" vid="LAM 4:1">Dhakaan Galmi Waaqaa ittiin ijaarame</para>
  <para style="q2" vid="LAM 4:1">attam karaa irratti bittinnowe!<verse eid="LAM 4:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 4:2"/>Ilmaan Xiyoonii worri dur</para>
  <para style="q2" vid="LAM 4:2">akka worqii gatii guddo'ootitti ilaallamanu</para>
  <para style="q2" vid="LAM 4:2">amma attam akka faara</para>
  <para style="q2" vid="LAM 4:2">harka namaatiin hujamee te'ane!<verse eid="LAM 4:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 4:3"/>Jeedaltinuu<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="fqa" closed="false">Jeedalti: </char><char style="ft" closed="false">Ukkullolle hin jedhanti.</char></note> ilmee ifii</para>
  <para style="q2" vid="LAM 4:3">harma hoosifatti,</para>
  <para style="q2" vid="LAM 4:3">kolbaa tiyya ammoo akka guchiin gammoojji'ii</para>
  <para style="q2" vid="LAM 4:3">ilme'etti gadhaa jabaatu teeteerti.<verse eid="LAM 4:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 4:4"/>Dheebuu bisaaniitiin</para>
  <para style="q2" vid="LAM 4:4">arrabi ijoolle'ee laagada'atti goge.</para>
  <para style="q1" vid="LAM 4:4">Jjoolleen sagalee kadhatti;</para>
  <para style="q2" vid="LAM 4:4">ammoo ka itti kennu hin jiru.<verse eid="LAM 4:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 4:5"/>Kolbaan dur waan dansaa nyaataa turte</para>
  <para style="q2" vid="LAM 4:5">karaa irratti beelaan dhumatte;</para>
  <para style="q2" vid="LAM 4:5">worri dur woyaa dhiillee uffatee guddate</para>
  <para style="q2" vid="LAM 4:5">amma tuulaa daadha'aa irra irkate.<verse eid="LAM 4:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 4:6"/>Adabamiis kolbaa tiyyaa</para>
  <para style="q2" vid="LAM 4:6">adabamiisa Sodoom,</para>
  <para style="q2" vid="LAM 4:6">harki nama tokkoolle adoo hin tuqin</para>
  <para style="q2" vid="LAM 4:6">dedhuma badde san caala.<verse eid="LAM 4:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 4:7"/>Sooreyyiin isaanii cabbii caalaa calalaqanee,</para>
  <para style="q2" vid="LAM 4:7">aanan caalaa addaatan;</para>
  <para style="q2" vid="LAM 4:7">nafi isaaniille dooqa caalaa dhiille'e;</para>
  <para style="q2" vid="LAM 4:7">akki dansummaa isaaniille akka dhakaa Safiirosii tola.<verse eid="LAM 4:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 4:8"/>Amma fuulli isaanii cilee caalaa gurraachoweera;</para>
  <para style="q2" vid="LAM 4:8">nami karaa irratti isaan beekuuyyuu hin jiru.</para>
  <para style="q1" vid="LAM 4:8">Gogaan isaanii shuntuuratee lafe'etti maxxanee,</para>
  <para style="q2" vid="LAM 4:8">akka muka gogee te'eera.<verse eid="LAM 4:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 4:9"/>Worra midhaan ficha'aa dhabee</para>
  <para style="q2" vid="LAM 4:9">suutuma suutaan</para>
  <para style="q2" vid="LAM 4:9">beelaan du'ee mannaa,</para>
  <para style="q2" vid="LAM 4:9">worra shallaaga'aan du'e woyya.<verse eid="LAM 4:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 4:10"/>Badiin kolbaa tiyyatti yennaa dhutte</para>
  <para style="q2" vid="LAM 4:10">dubartooti gadhi-laafeyyiin</para>
  <para style="q2" vid="LAM 4:10">ijoollee ifii harka ifiitiin</para>
  <para style="q2" vid="LAM 4:10">nyaatiisaaf iffeelane.<verse eid="LAM 4:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 4:11"/>Waaqi aarii hantuu ifii buusee</para>
  <para style="q2" vid="LAM 4:11">hundee isi'ii balleessiisaaf,</para>
  <para style="q2" vid="LAM 4:11">Xiyoonitti ibidda gabbise.<verse eid="LAM 4:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 4:12"/>Moototi lafaalle te'ee kolbaan biyya lafaa,</para>
  <para style="q2" vid="LAM 4:12">diinoti yookiin nyaaphi karra dalleya Yerusaalemii</para>
  <para style="q2" vid="LAM 4:12">seenuu akka dande'anu hin dhugeeffanne.<verse eid="LAM 4:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 4:13"/>Te'uu malee,</para>
  <para style="q2" vid="LAM 4:13">sababa cubbuu raagota isi'iitii fi</para>
  <para style="q2" vid="LAM 4:13">yakkaa hayyoota isi'ii</para>
  <para style="q2" vid="LAM 4:13">dhiiga worra yakkaa hin qannee</para>
  <para style="q2" vid="LAM 4:13">dhangalaasaneef tun teete.<verse eid="LAM 4:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 4:14"/>Isaan dhiigaan waan battowaneef</para>
  <para style="q2" vid="LAM 4:14">nami woyaa isaaniituu tuqu hin jiru.</para>
  <para style="q1" vid="LAM 4:14">Isaan akka balla'aa</para>
  <para style="q2" vid="LAM 4:14">karaa irra titimisane.<verse eid="LAM 4:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 4:15"/>Namooti «Isin worri battoottane, achi deema'a!</para>
  <para style="q2" vid="LAM 4:15">Nu hin tuqina'a» jedhanee isaanitti iyyane.</para>
  <para style="q1" vid="LAM 4:15">Yennaa isaan baqatanee joonjane,</para>
  <para style="q2" vid="LAM 4:15">kolbaan gosa biyya adda addaa,</para>
  <para style="q2" vid="LAM 4:15">«Haganaa achi isaan as turuu hin dande'anu!» jedhane.<verse eid="LAM 4:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 4:16"/>Waaqi ifumaafuu isaan bittinneesse;</para>
  <para style="q2" vid="LAM 4:16">inni deebi'ee isaan hin ilaalu.</para>
  <para style="q2" vid="LAM 4:16">Hayyooti hin kabajantu,</para>
  <para style="q2" vid="LAM 4:16">jaarsoleelle fudhatama hin qabaattu.<verse eid="LAM 4:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 4:17"/>Akkasuma qarqaarsa adoo eegannuu</para>
  <para style="q2" vid="LAM 4:17">ilti nu dadhadde;</para>
  <para style="q2" vid="LAM 4:17">gosa biyya nu qarqaaruu hin dandeenne irraa</para>
  <para style="q2" vid="LAM 4:17">qarqaarsa eegane.<verse eid="LAM 4:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 4:18"/>Diinoti keenna waan nu gaadanuuf</para>
  <para style="q2" vid="LAM 4:18">kara'aayyuu deemiisa hin dandeenne.</para>
  <para style="q1" vid="LAM 4:18">Muummeen teenna dhikaattee,</para>
  <para style="q2" vid="LAM 4:18">barri keenna waan hobba'eef,</para>
  <para style="q2" vid="LAM 4:18">guyyooti keenna laakkossatti galeera.<verse eid="LAM 4:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 4:19"/>Diinoti keenna</para>
  <para style="q2" vid="LAM 4:19">risaa caalaa ariifatan;</para>
  <para style="q2" vid="LAM 4:19">gaara irra nu ari'anee,</para>
  <para style="q2" vid="LAM 4:19">goomolee keessalle'etti nu gaadane.<verse eid="LAM 4:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 4:20"/>Ka Waaqi nu'uuf muude,</para>
  <para style="q2" vid="LAM 4:20">ka nuuti, «Hafuura jiruu teennaa ti;</para>
  <para style="q2" vid="LAM 4:20">gaaddisa isaa jalatti</para>
  <para style="q2" vid="LAM 4:20">gosa biyya adda addaa odduu hin leena» jenne,</para>
  <para style="q2" vid="LAM 4:20">boolla isaan nu'uuf qotane keessatti qabame.<verse eid="LAM 4:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 4:21"/>Isin kolbaa qachaa Edoomii,</para>
  <para style="q2" vid="LAM 4:21">worra biyya Uzii keessa leetanu,</para>
  <para style="q2" vid="LAM 4:21">gammada'aa ilillisa'a;</para>
  <para style="q2" vid="LAM 4:21">ammoo muduunuun mufii Waaqaa</para>
  <para style="q2" vid="LAM 4:21">isinitti dhufaarti;</para>
  <para style="q2" vid="LAM 4:21">isin machoottanee qullaa deentan.<verse eid="LAM 4:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 4:22"/>Kolbaa Xiyoonii!</para>
  <para style="q2" vid="LAM 4:22">Adabbiin teessan hobbaateerti;</para>
  <para style="q1" vid="LAM 4:22">Waaqi haganaa achi</para>
  <para style="q2" vid="LAM 4:22">boojuu keessa akka leetanu isin hin godhu.</para>
  <para style="q1" vid="LAM 4:22">Ee kolbaa Edoomii,</para>
  <para style="q2" vid="LAM 4:22">inni yakkaa teessan hin adaba</para>
  <para style="q2" vid="LAM 4:22">cubbuu teessanille qaaleyatti baasa.<verse eid="LAM 4:22"/></para>
  <para style="b"/>
  <chapter eid="LAM 4"/>
  <chapter number="5" style="c" sid="LAM 5"/>
  <para style="s1">Daadimata Marartii Dhaggatiisaaf Dhikaate</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 5:1"/>Ee Waaqa, waan nu irratti te'e qaabadhu;</para>
  <para style="q2" vid="LAM 5:1">kunoo, salphinna keennalle dhaggi.<verse eid="LAM 5:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 5:2"/>Qabeenna keenna ormi,</para>
  <para style="q2" vid="LAM 5:2">mana keenna alagaan fudhate.<verse eid="LAM 5:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 5:3"/>Nuuti ijoollee worri irraa du'e,</para>
  <para style="q2" vid="LAM 5:3">ta abbaa hin qannee teeneerra;</para>
  <para style="q2" vid="LAM 5:3">haadhotiin teennalle</para>
  <para style="q2" vid="LAM 5:3">haadha hiyyeessaa te'aneeran.<verse eid="LAM 5:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 5:4"/>Bisaan unnuuf hin kaffalla;</para>
  <para style="q2" vid="LAM 5:4">qoraanille hin bitanna.<verse eid="LAM 5:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 5:5"/>Akka horii waanjoo itti hidhanee</para>
  <para style="q2" vid="LAM 5:5">oofamiisaan guddoo dadhanneerra;</para>
  <para style="q2" vid="LAM 5:5">fooralle nu dhoogganeeran.<verse eid="LAM 5:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 5:6"/>Sagalee quufiisaaf,</para>
  <para style="q2" vid="LAM 5:6">worra Gibxi'iitii fi Asooriititti harka kennanne.<verse eid="LAM 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 5:7"/>Abbootiin teenna ta durii</para>
  <para style="q2" vid="LAM 5:7">cubbuu hujjee dabarte;</para>
  <para style="q2" vid="LAM 5:7">nuuti ammoo sababa cubbuu isaaniitiif</para>
  <para style="q2" vid="LAM 5:7">rakkatiisatti jirra.<verse eid="LAM 5:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 5:8"/>Garbooleen nu bulchan;</para>
  <para style="q2" vid="LAM 5:8">nami harka isaaniitii nu baasu hin jiru.<verse eid="LAM 5:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 5:9"/>Goomolee keessa</para>
  <para style="q2" vid="LAM 5:9">ijjeechaan waan jirtuuf,</para>
  <para style="q2" vid="LAM 5:9">lubbuu teenna gurgurannee,</para>
  <para style="q2" vid="LAM 5:9">sagalee dhagganna.<verse eid="LAM 5:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 5:10"/>Beela irraa ka ka'e</para>
  <para style="q2" vid="LAM 5:10">gogaan keenna</para>
  <para style="q2" vid="LAM 5:10">akka suunsumaa gurraachoweera.<verse eid="LAM 5:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 5:11"/>Dubartoota Xiyoon keessatti,</para>
  <para style="q2" vid="LAM 5:11">durralle qachoota Yihuda'aa keessatti</para>
  <para style="q2" vid="LAM 5:11">hunnaan woliin rafane.<verse eid="LAM 5:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 5:12"/>Sooreyyiin harka isaaniitiin fannifante;</para>
  <para style="q2" vid="LAM 5:12">jaarsoleen ulfinna dhadde.<verse eid="LAM 5:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 5:13"/>Dargaggoota dhiiraa</para>
  <para style="q2" vid="LAM 5:13">hunnaan daakuu daassifatane;</para>
  <para style="q2" vid="LAM 5:13">ijoolleen dhiiraa</para>
  <para style="q2" vid="LAM 5:13">qoraan guddaa ba'atanee tintimane<note caller="+" style="f"><char style="fr" closed="false">5:13 </char><char style="fqa" closed="false">Tintimane: </char><char style="ft" closed="false">Yookiin gatantarane.</char></note>.<verse eid="LAM 5:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 5:14"/>Jaarsoleen</para>
  <para style="q2" vid="LAM 5:14">yaa'ii karra qacha'aa,</para>
  <para style="q2" vid="LAM 5:14">dargaggootille sirba lakkitteerti.<verse eid="LAM 5:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 5:15"/>Gammadi gadhaa keenna keessaa badeera,</para>
  <para style="q2" vid="LAM 5:15">sirbi keenna gara bowaa deebi'eera.<verse eid="LAM 5:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 5:16"/>Nuuti cubbuu waan hunyeef,</para>
  <para style="q2" vid="LAM 5:16">ulfinni nu irraa ka'eera;</para>
  <para style="q2" vid="LAM 5:16">nu'uuf aanne'e!<verse eid="LAM 5:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 5:17"/>Waan kanaaf gadhaan nu dhibameera;</para>
  <para style="q2" vid="LAM 5:17">iltille nu cuurrotteerti.<verse eid="LAM 5:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 5:18"/>Sababa kanaaf gaarri Xiyoonii onee,</para>
  <para style="q2" vid="LAM 5:18">jeedalti irra burraaxxi.<verse eid="LAM 5:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 5:19"/>Ee Waaqa, ati ammoo,</para>
  <para style="q2" vid="LAM 5:19">haga bara baraa mooti'i;</para>
  <para style="q2" vid="LAM 5:19">barcumaan mootummaa teetiille</para>
  <para style="q2" vid="LAM 5:19">dhalootaa haga dhalootaatitti jiraata.<verse eid="LAM 5:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 5:20"/>Ati maaf ijjumaa nu deete?</para>
  <para style="q2" vid="LAM 5:20">Maaf haga kana mara nu lakkitte?<verse eid="LAM 5:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 5:21"/>Ee Waaqa, akka duriititti nu deebifadhu,</para>
  <para style="q2" vid="LAM 5:21">nuutille hin deebina;</para>
  <para style="q2" vid="LAM 5:21">bara keenna haaressii akka durii nuu tolchi.<verse eid="LAM 5:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 5:22"/>Yoo kana hin tolchin ati nu gatteerta;</para>
  <para style="q2" vid="LAM 5:22">akka maleelle nutti aarteerta.<verse eid="LAM 5:22"/></para>
  <chapter eid="LAM 5"/>
</usx>
