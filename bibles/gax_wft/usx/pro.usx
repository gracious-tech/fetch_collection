<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PRO" style="id">- Guji Bible</book>
  <para style="h">Kitaaba Fakkeennaa</para>
  <para style="toc1">Kitaaba Fakkeennaa</para>
  <para style="toc2">Kitaaba Fakkeennaa</para>
  <para style="toc3">Fak.</para>
  <para style="mt1">Kitaaba Fakkeennaa</para>
  <para style="imt">Seensa</para>
  <para style="ip">Kitaab fakkeennaa seera ittiin bulmaataatii fi barsiisa dhugeeffanna'aa ka haala jedhi'iitii fi fakkeennaatiin wolitti qabameeru. Hedduun isaanii waanuma nami guyyuma guyya'aan huju ifi keessaa qaban. Kitaab kun «Qarummaan jalqabaa Mootii Waan Maraa sodaatiisa» ka jedhu yaadachiisiisaan jalqaba. Achiin duuba waan hamilee dhugeeffanna'aa qofa dubbatiisa adoo hin te'in, gara yaada wolii galaatii fi amala dansa'aalle hin dabara. Jedhiin kitaaba kanaa hedduun beekkumsa barsiisota Israa'elootaa ta durii durii marroo waan nami qaroon haala adda addaa keessatti hujuu mudhisan. Isaan kana keessaa gariin marroo firooma maati'ii, ka dhibiin marroo hujii dhibi'ii dubbatan. Gariin waan tokkummaa kolbaa keessaa, kuun barbaachisummaa ifi toowatiisaa dubbatan. Bacaan isaanii marroo gadhi-laafinnaa, marroo ossataa, marroo hiyyeeyyii kabajiisaatii fi marroo jaalotaaf addatamiisaa dubbatan.</para>
  <para style="iot">Haadhoo Dubbi'ii</para>
  <para style="io1">Qarummaa Leellisiisa<char style="ior"><ref loc="PRO 1:1-9:18">1:1—9:18</ref></char></para>
  <para style="io1">Fakkeenna Solomoonii<char style="ior"><ref loc="PRO 10:1-29:27">10:1—29:27</ref></char></para>
  <para style="io1">Jechoota Aguurii<char style="ior"><ref loc="PRO 30:1-33">30:1-33</ref></char></para>
  <para style="io1">Jedhii adda addaa Hedduu<char style="ior"><ref loc="PRO 31:1-31">31:1-31</ref></char></para>
  <chapter number="1" style="c" sid="PRO 1"/>
  <para style="s1">Bu'aa Fakkeennaa</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1"/>Fakkeenni Solomoonii ilma Daawitii, ka mootii Israa'elii ka asii gad jiranu:<verse eid="PRO 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 1:2"/>Isaan kun namooti qarumma'aa fi</para>
  <para style="q2" vid="PRO 1:2">qajeelfama dansaa akka fudhatanu,</para>
  <para style="q2" vid="PRO 1:2">jechoota beekkumsa ifi keessaa qabanu,</para>
  <para style="q2" vid="PRO 1:2">akka hubatanu,<verse eid="PRO 1:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PRO 1:3"/>balchumma'aa fi haqaan,</para>
  <para style="q2" vid="PRO 1:3">waan dhugaa te'e godhiisaan,</para>
  <para style="q2" vid="PRO 1:3">amala qarumma'aatiin</para>
  <para style="q2" vid="PRO 1:3">qajeelfama akka fudhatanu,<verse eid="PRO 1:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="PRO 1:4"/>worri beekkumsaan hin bilchaatin,</para>
  <para style="q2" vid="PRO 1:4">hubantii akka qabaatanu,</para>
  <para style="q2" vid="PRO 1:4">dargaggooti beekkumsaa fi,</para>
  <para style="q2" vid="PRO 1:4">qalbii akka qabaatanu qarqaaran.<verse eid="PRO 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 1:5"/>Worri qarooleen fakkeenna kana caqasanee,</para>
  <para style="q2" vid="PRO 1:5">barumsa ifii itti ede'atanuu ti;</para>
  <para style="q2" vid="PRO 1:5">worri hubantii qabanulle</para>
  <para style="q2" vid="PRO 1:5">qajeelfama irraa fudhatanuu ti.<verse eid="PRO 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 1:6"/>Akka kanaan isaan fakkeennaa fi mammaassa,</para>
  <para style="q2" vid="PRO 1:6">hiikkaa jedhi'iitii fi</para>
  <para style="q2" vid="PRO 1:6">hiibboo worra qaroole'eelle hin hubatan.<verse eid="PRO 1:6"/></para>
  <para style="s1">Gorsa Dargaggeeyyi'iif Kenname</para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 1:7"/>Qarummaan jalqabaa,</para>
  <para style="q2" vid="PRO 1:7">Mootii Waan Maraa sodaatiisa;</para>
  <para style="q2" vid="PRO 1:7">gowwooleen ammoo,</para>
  <para style="q2" vid="PRO 1:7">qarumma'aa fi gorsa tuffatti.<verse eid="PRO 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8"/>Ilma kiyya, gorsa abbaa keetii dhage'i;</para>
  <para style="q2" vid="PRO 1:8">barsiisa haadha teetiille hin lakkisin<verse eid="PRO 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9"/>Barsiisi isaanii,</para>
  <para style="q2" vid="PRO 1:9">mataa keetiif akka kallacha ulfinnaa ti;</para>
  <para style="q2" vid="PRO 1:9">morma keetiifille,</para>
  <para style="q2" vid="PRO 1:9">akka meya seesaaf diramee ti.<verse eid="PRO 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 1:10"/>Ilma kiyya,</para>
  <para style="q2" vid="PRO 1:10">cubbaaleyyiin yoo si hawadatte,</para>
  <para style="q2" vid="PRO 1:10">tole hin jedhiniif.<verse eid="PRO 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11"/>Isaan yoo, «Nu woliin koy;</para>
  <para style="q2" vid="PRO 1:11">dhiiga namaa dhangalaasiisaaf</para>
  <para style="q2" vid="PRO 1:11">dhokannee gaadanna;</para>
  <para style="q2" vid="PRO 1:11">nama yakkaa hin qanne,</para>
  <para style="q2" vid="PRO 1:11">sababa malee miidhiisaaf kara'atti eeganna!<verse eid="PRO 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12"/>Akka addee worri du'e jiru,</para>
  <para style="q2" vid="PRO 1:12">akka worra gara boolla awwaalaa gad bu'uu,</para>
  <para style="q2" vid="PRO 1:12">adoo isaan jiru'uu fi fayya'aan jiranuu,</para>
  <para style="q2" vid="PRO 1:12">kowaa isaan liqinsinaa ti!<verse eid="PRO 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13"/>Nuuti meya gatii guddo'oo</para>
  <para style="q2" vid="PRO 1:13">ka gosa adda addaa hin dhagganna;</para>
  <para style="q2" vid="PRO 1:13">mana keennalle</para>
  <para style="q2" vid="PRO 1:13">waan saamanneen</para>
  <para style="q2" vid="PRO 1:13">hin guutanna!<verse eid="PRO 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14"/>Koy nu woliin hirmaadhu;</para>
  <para style="q2" vid="PRO 1:14">waan hannaan fudhanne</para>
  <para style="q2" vid="PRO 1:14">woliin qoodanna»</para>
  <para style="q2" vid="PRO 1:14">yoo si'iin jedhane,<verse eid="PRO 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15"/>Ilma kiyya, isaan woliin hin deemin;</para>
  <para style="q2" vid="PRO 1:15">daandii isaanii irraa miila keeti eeggadhu.<verse eid="PRO 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16"/>Miilli isaanii gara cubbu'uu rukkisa;</para>
  <para style="q2" vid="PRO 1:16">isaan dhiiga dhangalaasiisaaf ariifatan.<verse eid="PRO 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 1:17"/>Adoo sinbirree dhaggituu</para>
  <para style="q2" vid="PRO 1:17">fonxoroo itti afuun,</para>
  <para style="q2" vid="PRO 1:17">bu'aa hin qaddu.<verse eid="PRO 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18"/>Namooti kun dhiiguma ifii</para>
  <para style="q2" vid="PRO 1:18">dhangalaasiisaaf dhokatanee gaadan;</para>
  <para style="q2" vid="PRO 1:18">isaan ifuma dhokatanee gaadan.<verse eid="PRO 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19"/>Muummeen worra joljoluu akkas jirti;</para>
  <para style="q2" vid="PRO 1:19">joljolummaan isaan ijjeetti.<verse eid="PRO 1:19"/></para>
  <para style="s1">Waamicha Qarumma'aa</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20"/>Qarummaan woldeennaa</para>
  <para style="q2" vid="PRO 1:20">kara'aa keessaa iyyitee waammatti;</para>
  <para style="q2" vid="PRO 1:20">badhinna keessaa qoonqoo ol qabattee iyyiti.<verse eid="PRO 1:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 1:21"/>Karaa namooti hogisanu keessaa iyyiti;</para>
  <para style="q2" vid="PRO 1:21">seensuma qacha'aa keessaa dubbatti:<verse eid="PRO 1:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 1:22"/>Isiin, «Isin worri gowwooleen,</para>
  <para style="q2" vid="PRO 1:22">haga yoomii,</para>
  <para style="q2" vid="PRO 1:22">gowwummaa teessan jaalattan?</para>
  <para style="q1" vid="PRO 1:22">Isin worri murgaameyyiin,</para>
  <para style="q2" vid="PRO 1:22">haga yoomii,</para>
  <para style="q2" vid="PRO 1:22">murgoo teessanitti gammaddan?</para>
  <para style="q1" vid="PRO 1:22">Isin worri gowwooleen,</para>
  <para style="q2" vid="PRO 1:22">haga yoomii beekkumsa jibbitan?<verse eid="PRO 1:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23"/>Isin xixicha kiyya yoo dhageettane,</para>
  <para style="q2" vid="PRO 1:23">ani silaa waan gadhaa kiyya keessa jiru,</para>
  <para style="q2" vid="PRO 1:23">yaada kiyya akka beettanu hin godhaayyu.<verse eid="PRO 1:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24"/>Isin ammoo,</para>
  <para style="q2" vid="PRO 1:24">yennaa ani waamu eega diddanee,</para>
  <para style="q2" vid="PRO 1:24">yennaa ani harka kiyya diriirsu,</para>
  <para style="q2" vid="PRO 1:24">eega itti hin xiyyeeffatinii,<verse eid="PRO 1:24"/></para>
  <para style="q2">
    <verse number="25" style="v" sid="PRO 1:25"/>isin gorsa kiyya mara tuffatanee,</para>
  <para style="q2" vid="PRO 1:25">xixicha kiyyalle eega hin fudhatinii,<verse eid="PRO 1:25"/></para>
  <para style="q2">
    <verse number="26" style="v" sid="PRO 1:26"/>yennaa isin farra keessa jirtanu,</para>
  <para style="q2" vid="PRO 1:26">anille isinitti hin kolla.</para>
  <para style="q1" vid="PRO 1:26">Yennaa balaan isinitti bu'u</para>
  <para style="q2" vid="PRO 1:26">ani isinitti hin murga.<verse eid="PRO 1:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 1:27"/>Yennaa wonni hantuun,</para>
  <para style="q2" vid="PRO 1:27">akka bubbee bokkeyaa isinitti dhuttu,</para>
  <para style="q2" vid="PRO 1:27">yennaa balaan akka hobonbolatti'ii isin haxowu,</para>
  <para style="q2" vid="PRO 1:27">yennaa dhippinnii fi rakkinni isin irra garagalu,</para>
  <para style="q2" vid="PRO 1:27">ani isinitti murga.<verse eid="PRO 1:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 1:28"/>Yennaa san isin na hin waantan;</para>
  <para style="q2" vid="PRO 1:28">ani ammoo deebii isiniif hin kennu;</para>
  <para style="q1" vid="PRO 1:28">Isin akka malee na barbaaddan,</para>
  <para style="q2" vid="PRO 1:28">ammoo na hin dhaggitanu.<verse eid="PRO 1:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 1:29"/>Isin beekkumsa Waan jibbitaneef,</para>
  <para style="q2" vid="PRO 1:29">Mootii Waan Maraa sodaatiisa,</para>
  <para style="q2" vid="PRO 1:29">waan hin filanneef,<verse eid="PRO 1:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 1:30"/>Isin gorsa kiyya waan hin fudhatiniif,</para>
  <para style="q2" vid="PRO 1:30">xixicha kiyya mara waan tuffataneef,<verse eid="PRO 1:30"/></para>
  <para style="q2">
    <verse number="31" style="v" sid="PRO 1:31"/>isin midhaanuma hujattane hin nyaattan;</para>
  <para style="q2" vid="PRO 1:31">bu'aa mala nama irratti</para>
  <para style="q2" vid="PRO 1:31">dhoottanee hin dhaggatan.<verse eid="PRO 1:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 1:32"/>Worra beekkumsaan hin bilchaatin</para>
  <para style="q2" vid="PRO 1:32">qarummaa irra fagaatiisatti ijjeesa;</para>
  <para style="q2" vid="PRO 1:32">gowwooleelle rincica isaaniititti,</para>
  <para style="q2" vid="PRO 1:32">isaan balleessa.<verse eid="PRO 1:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 1:33"/>Worri na dhage'u ammoo,</para>
  <para style="q2" vid="PRO 1:33">nageyaan le'a;</para>
  <para style="q2" vid="PRO 1:33">waan hantuu adoo hin sodaatin,</para>
  <para style="q2" vid="PRO 1:33">bidhaa malee jiraata» jetti.<verse eid="PRO 1:33"/></para>
  <chapter eid="PRO 1"/>
  <chapter number="2" style="c" sid="PRO 2"/>
  <para style="s1">Eebba Qarummaa Irraa Dhaggamu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 2:1"/>Ilma kiyya, jecha kiyya yoo fudhatte,</para>
  <para style="q2" vid="PRO 2:1">ajaja kiyyalle qalbii teeti keessatti yoo bulfatte,<verse eid="PRO 2:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PRO 2:2"/>gurra keeti gara qarumma'aa yoo qabatte,</para>
  <para style="q2" vid="PRO 2:2">gadhaa keetille gara hubanti'ii yoo deebifatte,<verse eid="PRO 2:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PRO 2:3"/>beekkumsa guddaa yoo waammatte,</para>
  <para style="q2" vid="PRO 2:3">hubanti'iif qoonqoo ol qabattee yoo iyyite,<verse eid="PRO 2:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="PRO 2:4"/>akka meeti'ii yookiin akka qabeenna dhoffameeruu,</para>
  <para style="q2" vid="PRO 2:4">qarummaa yoo barbaadde,<verse eid="PRO 2:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="PRO 2:5"/>ati Mootii Waan Maraa sodaatiisa hin hubatta;</para>
  <para style="q2" vid="PRO 2:5">beekkumsa Waaqa beekiisalle hin dhaggatta.<verse eid="PRO 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 2:6"/>Mootiin Waan Maraa, qarummaa waan namaa kennuuf,</para>
  <para style="q2" vid="PRO 2:6">beekkumsii fi hubantiin isa biraa dhufan.<verse eid="PRO 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 2:7"/>Inni worra qajeela'aaf, qarummaa kenna;</para>
  <para style="q2" vid="PRO 2:7">worra komii hin qanneefille, wontee isaaniif te'a.<verse eid="PRO 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 2:8"/>Inni daandii haqaa hin toowata;</para>
  <para style="q2" vid="PRO 2:8">karaa worra isaaf addatamuulle hin eega.<verse eid="PRO 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9"/>Achiin duuba ati balchumma'aa fi haqa,</para>
  <para style="q2" vid="PRO 2:9">waan dhugaa te'ee fi daandii dansaa mara hin hubatta.<verse eid="PRO 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 2:10"/>Qarummaan gara qalbii teetii waan dhuttuuf,</para>
  <para style="q2" vid="PRO 2:10">beekkumsi si gammachiisa.<verse eid="PRO 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 2:11"/>Qalbeeffatiis si hin eeddi; hubatiisille si hin toowatti.<verse eid="PRO 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12"/>Qarummaan karaa worra hama'aa irraa,</para>
  <para style="q2" vid="PRO 2:12">worra dubbii micciiru irraa si hin dhooggiti;<verse eid="PRO 2:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="PRO 2:13"/>worri akkasii kun karaa dukkanaa ideemiisaaf,</para>
  <para style="q2" vid="PRO 2:13">daandii qajeelaa worra lakkisu;<verse eid="PRO 2:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="PRO 2:14"/>waan hantuu godhiisatti worra gammadu;</para>
  <para style="q2" vid="PRO 2:14">micciiramummaa hamaaleyyi'iititti</para>
  <para style="q2" vid="PRO 2:14">worra firinxiixu;<verse eid="PRO 2:14"/></para>
  <para style="q2">
    <verse number="15" style="v" sid="PRO 2:15"/>karaan isaanii micciirama'a;</para>
  <para style="q2" vid="PRO 2:15">ideensi isaaniille daddaba'a.<verse eid="PRO 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16"/>Qarummaan dubartii gaarayyeeffattuu,</para>
  <para style="q2" vid="PRO 2:16">ta jechoota gammachiisuun nama qaxafattu</para>
  <para style="q2" vid="PRO 2:16">jalaa si baachi.<verse eid="PRO 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 2:17"/>Dubartiin tun dhirsa dargagumma'aan</para>
  <para style="q2" vid="PRO 2:17">heerumte lakkittee,</para>
  <para style="q2" vid="PRO 2:17">waadaa Waaqa duratti galte deeteerti.<verse eid="PRO 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 2:18"/>Manni isi'ii gara du'aa,</para>
  <para style="q2" vid="PRO 2:18">daandiin isi'ii gara ekera'aa geessa.<verse eid="PRO 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 2:19"/>Worri gara isi'ii dhaqu hin deebi'u</para>
  <para style="q2" vid="PRO 2:19">yookiin daandii jiru'uu hin dhaggatu.<verse eid="PRO 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20"/>Maarre ati karaa namoota dansa'aa</para>
  <para style="q2" vid="PRO 2:20">hin ideenta; daandii balchootaa irraa</para>
  <para style="q2" vid="PRO 2:20">akka hin gorre hin eegatta.<verse eid="PRO 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21"/>Worri qajeelaan lafa irra hin le'an;</para>
  <para style="q2" vid="PRO 2:21">worri yakkaa hin qannelle</para>
  <para style="q2" vid="PRO 2:21">isii keessatti hin hafan.<verse eid="PRO 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 2:22"/>Worri hamaan ammoo lafa irraa hin bada;</para>
  <para style="q2" vid="PRO 2:22">worri hin addatanne isii irraa hin buqqa'a.<verse eid="PRO 2:22"/></para>
  <chapter eid="PRO 2"/>
  <chapter number="3" style="c" sid="PRO 3"/>
  <para style="s1">Gorsa Dargaggootaaf Kenname</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 3:1"/>Ilma kiyya, waan ani si barsiisu hin dedhin;</para>
  <para style="q2" vid="PRO 3:1">ajajoota kiyya gadha'atti qabadhu.<verse eid="PRO 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2"/>Isaan guyyoota sii ede'anee,</para>
  <para style="q2" vid="PRO 3:2">woggoota hedduu si leesisan;</para>
  <para style="q2" vid="PRO 3:2">qananumma'aa fi nageya sii kennan.<verse eid="PRO 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3"/>Mararti'ii fi addatamummaa ijjumaa hin lakkisin;</para>
  <para style="q2" vid="PRO 3:3">morma keetitti hidhadhu;</para>
  <para style="q2" vid="PRO 3:3">gadhaa keeti keessatti qabadhu.<verse eid="PRO 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4"/>Achiin duuba ati Waaqaa fi nama duratti</para>
  <para style="q2" vid="PRO 3:4">fudhatamaa fi maqaa dansaa hin dhaggatta.<verse eid="PRO 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5"/>Gadhaa tokkochaan Mootii Waan Maraatitti addadhu;</para>
  <para style="q2" vid="PRO 3:5">hubantii teetitti hin irkatin.<verse eid="PRO 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6"/>Karaa keeti maraan isa beeki;</para>
  <para style="q2" vid="PRO 3:6">inni daandii teeti si'iif hin qajeelcha.<verse eid="PRO 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 3:7"/>«Ani qaro'o!» ifiin hin jedhin;</para>
  <para style="q2" vid="PRO 3:7">Mootii Waan Maraa sodaadhu;</para>
  <para style="q2" vid="PRO 3:7">waan hantuu irraa fagaadhu.<verse eid="PRO 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8"/>Kun nafa keetiif fayyaa,</para>
  <para style="q2" vid="PRO 3:8">lafee teetiifille jabeenna hin te'a.<verse eid="PRO 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9"/>Qabeenna keetiin,</para>
  <para style="q2" vid="PRO 3:9">midhaan keeti mara keessaa mataa kenniisaan,</para>
  <para style="q2" vid="PRO 3:9">Mootii Waan Maraatiif ulfinna kenni.<verse eid="PRO 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10"/>Achiin duuba gootaraan keeti</para>
  <para style="q2" vid="PRO 3:10">midhaaniin hin guutama;</para>
  <para style="q2" vid="PRO 3:10">daadhiin teeti waabaa guutantee irra hin danbalaati.<verse eid="PRO 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 3:11"/>Ilma kiyya, qajeelcha Mootii Waan Maraa hin tuffatin;</para>
  <para style="q2" vid="PRO 3:11">xixicha isaalle hin jibbin.<verse eid="PRO 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12"/>Abbaan ilma itti gammadu akkuma qajeelchu,</para>
  <para style="q2" vid="PRO 3:12">Mootiin Waan Maraalle nama jaalatu qajeelcha.<verse eid="PRO 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13"/>Nami qarummaa dhaggatu,</para>
  <para style="q2" vid="PRO 3:13">ka hubantii qabu ka gammade.<verse eid="PRO 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14"/>Qarummaan meetii caalaa bu'aa qaddi;</para>
  <para style="q2" vid="PRO 3:14">worqii caalaalle fayyaddi.<verse eid="PRO 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15"/>Qarummaan dooqa gatii guddo'oo caalaa gatii qaddi;</para>
  <para style="q2" vid="PRO 3:15">waan ati halchitu keessaa ka isi'iin qixxawu hin jiru.<verse eid="PRO 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16"/>Harka isi'ii middicha keessa</para>
  <para style="q2" vid="PRO 3:16">jiruu dheertu'utti jira;</para>
  <para style="q2" vid="PRO 3:16">harka isi'ii bitaacha keessa</para>
  <para style="q2" vid="PRO 3:16">durumma'aa fi ulfinnatti jira.<verse eid="PRO 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17"/>Karaan isi'ii karaa gammadaa ti;</para>
  <para style="q2" vid="PRO 3:17">daandiin isi'ii daandii nageyaa ti.<verse eid="PRO 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18"/>Isiin worra jabeessee isii qabateef,</para>
  <para style="q2" vid="PRO 3:18">muka jiru'uu ti;</para>
  <para style="q2" vid="PRO 3:18">worri jabeessee isii qabate hin gammada.<verse eid="PRO 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19"/>Mootiin Waan Maraa qarummaa ifiitiin lafa dade;</para>
  <para style="q2" vid="PRO 3:19">hubantii ifiitiin ol-gubbaa jabeessee dhaabe.<verse eid="PRO 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20"/>Beekkumsa isaatiin</para>
  <para style="q2" vid="PRO 3:20">qileen abbaayotaa gargar dayyaate,</para>
  <para style="q2" vid="PRO 3:20">duumensille tiifuu tiife.<verse eid="PRO 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 3:21"/>Ilma kiyya, qarumma'aa fi qalbeeffata jabeessii qabadhu;</para>
  <para style="q2" vid="PRO 3:21">isaan ila teeti duraa hin gorin.<verse eid="PRO 3:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22"/>Isaan si'iif jiruu,</para>
  <para style="q2" vid="PRO 3:22">morma keetiifille seesa hin te'an.<verse eid="PRO 3:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23"/>Achiin duuba ati nageyaan</para>
  <para style="q2" vid="PRO 3:23">karaa keeti hin deenta;</para>
  <para style="q2" vid="PRO 3:23">miilli keetille hin gufatu.<verse eid="PRO 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24"/>Yennaa irkattu hin sodaattu;</para>
  <para style="q2" vid="PRO 3:24">yennaa rattulle</para>
  <para style="q2" vid="PRO 3:24">hirriibi keeti mi'owaa hin te'a.<verse eid="PRO 3:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25"/>Yennaa balaan</para>
  <para style="q2" vid="PRO 3:25">dedhuma worra hamaa irra dhaqqabu,</para>
  <para style="q2" vid="PRO 3:25">ati hin sodaattu.<verse eid="PRO 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26"/>Mootiin Waan Maraa addii waan sii te'uuf,</para>
  <para style="q2" vid="PRO 3:26">miila keeti tiyyoo irraa hin eega.<verse eid="PRO 3:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27"/>Worra wonni dansaan malteef,</para>
  <para style="q2" vid="PRO 3:27">waan dansaa godhiisaaf adoo dandeettuu,</para>
  <para style="q2" vid="PRO 3:27">waan dansaan godhiisa hin lakkisin.<verse eid="PRO 3:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28"/>Adoo harkaa qadduu, «Boru sii kennaatii,</para>
  <para style="q2" vid="PRO 3:28">deebi'ii koy!» namaan hin jedhin.<verse eid="PRO 3:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 3:29"/>Nama si addatee si bira tee'u irratti</para>
  <para style="q2" vid="PRO 3:29">waan hantuu hin yaadin.<verse eid="PRO 3:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30"/>Adoo nami si hin miidhin,</para>
  <para style="q2" vid="PRO 3:30">akkasumaan nama hin himatin.<verse eid="PRO 3:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31"/>Nama hunnaan nama irratti ka'u hin halchin;</para>
  <para style="q2" vid="PRO 3:31">karaa isaa tokkolle hin filatin.<verse eid="PRO 3:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32"/>Sababille Mootiin Waan Maraa</para>
  <para style="q2" vid="PRO 3:32">nama micciiramaa jibba;</para>
  <para style="q2" vid="PRO 3:32">nama qajeelaa ammoo guddoo jaalata.<verse eid="PRO 3:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33"/>Mootiin Waan Maraa</para>
  <para style="q2" vid="PRO 3:33">mana worra hama'aa hin abaara;</para>
  <para style="q2" vid="PRO 3:33">mana worra balcha'aa ammoo hin eebbisa.<verse eid="PRO 3:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34"/>Mootiin Waan Maraa worra murgutti hin murga;</para>
  <para style="q2" vid="PRO 3:34">worra gad ifi qabuuf badhaadha hin kenna.<verse eid="PRO 3:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35"/>Worri qarooleen ulfinna hin dhaggatan;</para>
  <para style="q2" vid="PRO 3:35">worri gowwooleen ammoo hin salphatan.<verse eid="PRO 3:35"/></para>
  <chapter eid="PRO 3"/>
  <chapter number="4" style="c" sid="PRO 4"/>
  <para style="s1">Bu'aa Qarummaa Irraa Dhaggamu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1"/>Ilmaan tiyya, gorsa abbaa keessanii caqasa'a;</para>
  <para style="q2" vid="PRO 4:1">itti xiyyeeffadha'aatii,</para>
  <para style="q2" vid="PRO 4:1">hubantii dhaggadha'a.<verse eid="PRO 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2"/>Ani barsiisa kiyya dansaa isiniif kenna;</para>
  <para style="q2" vid="PRO 4:2">maarre isin barsiisa kiyya hin lakkisina'a.<verse eid="PRO 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3"/>Yennaa ani mana abbaa kiyyaatitti mucaa diqqa'aa,</para>
  <para style="q2" vid="PRO 4:3">haadha tiyyaaf ilma tokkochaa san,<verse eid="PRO 4:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="PRO 4:4"/>abbaan kiyya na barsiisee,</para>
  <para style="q2" vid="PRO 4:4">«Jecha kiyya mara</para>
  <para style="q2" vid="PRO 4:4">gadhaa tokkochaan qabadhu;</para>
  <para style="q2" vid="PRO 4:4">hin leetaa,</para>
  <para style="q2" vid="PRO 4:4">ajaja kiyya eegadhu.<verse eid="PRO 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5"/>Qarummaa dhaggadhu;</para>
  <para style="q2" vid="PRO 4:5">hubantii qabaadhu;</para>
  <para style="q2" vid="PRO 4:5">jecha kiyya hin dedhin</para>
  <para style="q2" vid="PRO 4:5">yookiin irraa hin deebi'in.<verse eid="PRO 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6"/>Qarummaan gollaa sii teetii,</para>
  <para style="q2" vid="PRO 4:6">isii hin dedhin;</para>
  <para style="q2" vid="PRO 4:6">si eeddiitii,</para>
  <para style="q2" vid="PRO 4:6">isii jaaladhu.<verse eid="PRO 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7"/>Qarummaan waan mara caalti;</para>
  <para style="q2" vid="PRO 4:7">tanaaf isii dhaggadhu.</para>
  <para style="q1" vid="PRO 4:7">Waan ati qaddu mara si kaffalchiittulle,</para>
  <para style="q2" vid="PRO 4:7">hubantii bitadhu.<verse eid="PRO 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8"/>Ulfinna isi'iif kenni;</para>
  <para style="q2" vid="PRO 4:8">isiille ol si qaddi;</para>
  <para style="q2" vid="PRO 4:8">isii hanqafadhu;</para>
  <para style="q2" vid="PRO 4:8">isiille ulfinna si'iif hin kenniti.<verse eid="PRO 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9"/>Isiin daraaraa seesaaf wolitti hidhame,</para>
  <para style="q2" vid="PRO 4:9">mataa keeti irra hin keetti;</para>
  <para style="q2" vid="PRO 4:9">kallacha dansaa si'iif hin kenniti» jedhe.<verse eid="PRO 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10"/>Ilma kiyya caqasi;</para>
  <para style="q2" vid="PRO 4:10">barri le'ii teetii akka heddatu,</para>
  <para style="q2" vid="PRO 4:10">jecha kiyya fudhadhu.<verse eid="PRO 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11"/>Ani karaa qarumma'aa si barsiiseera;</para>
  <para style="q2" vid="PRO 4:11">daandii qajeelaa irra</para>
  <para style="q2" vid="PRO 4:11">si sooresseera.<verse eid="PRO 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12"/>Yennaa ideentu karaan sitti hin dhiphatu;</para>
  <para style="q2" vid="PRO 4:12">yennaa rukkittulle hin gufattu.<verse eid="PRO 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13"/>Gorsa sii kenname jabeessii qabadhu;</para>
  <para style="q2" vid="PRO 4:13">gad hin lakkisin;</para>
  <para style="q2" vid="PRO 4:13">jiruu teeti waan te'eef,</para>
  <para style="q2" vid="PRO 4:13">midhassii eegadhu.<verse eid="PRO 4:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14"/>Daandii worra hama'aa hin hordofin</para>
  <para style="q2" vid="PRO 4:14">yookiin karaa worra hantuu hujuu irra hin deemin.<verse eid="PRO 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15"/>Karaa san irraa fagaadhu;</para>
  <para style="q2" vid="PRO 4:15">irraa deebi'iitii,</para>
  <para style="q2" vid="PRO 4:15">karaa keeti deemi.<verse eid="PRO 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16"/>Isaan haga waan hantuu godhanutti</para>
  <para style="q2" vid="PRO 4:16">dande'anee hin rafanu;</para>
  <para style="q2" vid="PRO 4:16">haga nama dokonkorsanutti</para>
  <para style="q2" vid="PRO 4:16">foora hin qabanu.<verse eid="PRO 4:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17"/>Isaan sagalee hammeennaa nyaatan;</para>
  <para style="q2" vid="PRO 4:17">daadhii woyni'ii</para>
  <para style="q2" vid="PRO 4:17">ta hunnaan nama irratti ka'iisaa unan.<verse eid="PRO 4:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18"/>Daandiin balchoole'ee akka ifa barii ganamaa,</para>
  <para style="q2" vid="PRO 4:18">ka haga orra'aatitti</para>
  <para style="q2" vid="PRO 4:18">ifaatuma ideemuu ti.<verse eid="PRO 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19"/>Daandiin worra hama'aa ammoo</para>
  <para style="q2" vid="PRO 4:19">akka dukkana dimmaa ti;</para>
  <para style="q2" vid="PRO 4:19">isaan waan isaan gufachiisu hin beekanu.<verse eid="PRO 4:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20"/>Ilma kiyya waan ani jedhutti xiyyeeffadhu;</para>
  <para style="q2" vid="PRO 4:20">jecha kiyya midhassii caqasi.<verse eid="PRO 4:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21"/>Isaan ila teeti duraa hin gorin;</para>
  <para style="q2" vid="PRO 4:21">gadhaa keeti keessatti qabadhu.<verse eid="PRO 4:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22"/>Isaan worra isaan dhaggatuuf jiru'u;</para>
  <para style="q2" vid="PRO 4:22">nafa isaanii maraaf fayyinna.<verse eid="PRO 4:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23"/>Maddi jiruu teetii qalbii waan teeteef,</para>
  <para style="q2" vid="PRO 4:23">waan mara caalaa</para>
  <para style="q2" vid="PRO 4:23">qalbii teeti eegadhu.<verse eid="PRO 4:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24"/>Dubbii micciiriisa afaan keeti irraa fageessi;</para>
  <para style="q2" vid="PRO 4:24">dubbii malaamaltumma'aa irraa</para>
  <para style="q2" vid="PRO 4:24">hidhii teeti eegadhu.<verse eid="PRO 4:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25"/>Ilti teeti gara fuula duraa</para>
  <para style="q2" vid="PRO 4:25">qajeelaa ilaaltuu ti;</para>
  <para style="q2" vid="PRO 4:25">ifiin dura qofa ilaali.<verse eid="PRO 4:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26"/>Daandii miilli keeti irra deemu,</para>
  <para style="q2" vid="PRO 4:26">wol qixxeeffadhu.</para>
  <para style="q2" vid="PRO 4:26">Karaan keeti dansaa te'uu ti.<verse eid="PRO 4:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27"/>Gara middaa yookiin gara bita'aa hin gorin;</para>
  <para style="q2" vid="PRO 4:27">miila keeti waan hantuu irraa eegadhu.<verse eid="PRO 4:27"/></para>
  <chapter eid="PRO 4"/>
  <chapter number="5" style="c" sid="PRO 5"/>
  <para style="s1">Gaarayyeeffatiisa Irraa Fagaatiisa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1"/>Ilma kiyya, qarummaa tiyyatti xiyyeeffadhu;</para>
  <para style="q2" vid="PRO 5:1">gara hubantii tiyyaa gurra keeti deebifadhu.<verse eid="PRO 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2"/>Yoo tana goote waan hantu'uu fi</para>
  <para style="q2" vid="PRO 5:2">dansaa gargar hin baafatta;</para>
  <para style="q2" vid="PRO 5:2">dubbiin teetille beekkumsa hin mudhitti.<verse eid="PRO 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3"/>Hidhiin dubartii gaarayyeeffattuu nadhii coccossiti;</para>
  <para style="q2" vid="PRO 5:3">dubbiin isi'ii zayitii caalaa lallaatti;<verse eid="PRO 5:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="PRO 5:4"/>dhuma irratti ammoo akka hargiisaa hadhootti;</para>
  <para style="q2" vid="PRO 5:4">akka shallaagaa qara lamaa</para>
  <para style="q2" vid="PRO 5:4">qara qaddi.<verse eid="PRO 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5"/>Miilli isi'ii gara du'aa deema;</para>
  <para style="q2" vid="PRO 5:5">ijjati isi'ii daandii</para>
  <para style="q2" vid="PRO 5:5">gara addee worri du'e jiru geessa.<verse eid="PRO 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6"/>Isiin karaa jiru'uu hin yaadattu;</para>
  <para style="q2" vid="PRO 5:6">karaan isi'ii daddaba'a;</para>
  <para style="q2" vid="PRO 5:6">ammoo isi'itti hin beekkamu.<verse eid="PRO 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7"/>Amma ilmaan tiyya,</para>
  <para style="q2" vid="PRO 5:7">na caqasa'a;</para>
  <para style="q2" vid="PRO 5:7">jecha afaan kiyyaa irraa hin gorina'a.<verse eid="PRO 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8"/>Karaa keeti isii irraa fageessi;</para>
  <para style="q2" vid="PRO 5:8">qarqara balbala mana isi'iititti hin dhikaatin.<verse eid="PRO 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9"/>Yoo tana godhuu dhabaatte,</para>
  <para style="q2" vid="PRO 5:9">ulfinna keeti namoota dhibi'iif,</para>
  <para style="q2" vid="PRO 5:9">jiruu teetiille</para>
  <para style="q2" vid="PRO 5:9">nama marartii hin qannetti hin kennita.<verse eid="PRO 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10"/>Karra teetille alagaan hin fudhata;</para>
  <para style="q2" vid="PRO 5:10">eloon teetille mana ormaa hin duroonsiti.<verse eid="PRO 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11"/>Foon keetii fi nafi keeti yennaa dhumate,</para>
  <para style="q2" vid="PRO 5:11">muummee jiruu teetiititti hin aadda;<verse eid="PRO 5:11"/></para>
  <para style="q2">
    <verse number="12" style="v" sid="PRO 5:12"/>ati, «Hayii, ani maaf gorsa jibbe?</para>
  <para style="q2" vid="PRO 5:12">Gadhaan kiyya maaf qajeelfama tuffate?<verse eid="PRO 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13"/>Ani barsiisota tiyya hin caqanne;</para>
  <para style="q2" vid="PRO 5:13">gurra kiyya gara worra na gorsuu hin deebifanne.<verse eid="PRO 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14"/>Wolde'a kolba'aa duudii keessatti,</para>
  <para style="q2" vid="PRO 5:14">badii guddoo biraan baye» hin jetta.<verse eid="PRO 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15"/>Niitii teeti akkuma boolluma bisaanii keetii fi</para>
  <para style="q2" vid="PRO 5:15">baleessuma keetii, achuma keessaa uni.<verse eid="PRO 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16"/>Maddi keeti diidatti,</para>
  <para style="q2" vid="PRO 5:16">bisaan lagaa keeti</para>
  <para style="q2" vid="PRO 5:16">karaa keessatti dhangala'uu qabaa ree?<verse eid="PRO 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17"/>Isaan si qofaaf te'anuu ti;</para>
  <para style="q2" vid="PRO 5:17">alagaa woliin hin qoodamin.<verse eid="PRO 5:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18"/>Maddi keeti ka eebbifame te'uu ti;</para>
  <para style="q2" vid="PRO 5:18">niitii teeti ta qeedhumma'aan fuute woliin firinxiixi.<verse eid="PRO 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19"/>Isiin jaalatantuu akka gadansaa,</para>
  <para style="q2" vid="PRO 5:19">biifa qabeettii</para>
  <para style="q2" vid="PRO 5:19">akka jiliba'aa</para>
  <para style="q2" vid="PRO 5:19">sii teetuu ti.</para>
  <para style="q1" vid="PRO 5:19">Harmi isi'ii yennaa mara</para>
  <para style="q2" vid="PRO 5:19">dheebuu si baasuu ti;</para>
  <para style="q2" vid="PRO 5:19">jaalala isi'iitiin</para>
  <para style="q2" vid="PRO 5:19">yennaa mara machowi.<verse eid="PRO 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20"/>Ilma kiyya,</para>
  <para style="q2" vid="PRO 5:20">maaf dubartii gaarayyeeffattu'uun machootta?</para>
  <para style="q2" vid="PRO 5:20">Maaniif qoma dubartii nama dhibi'ii hanqafatta?<verse eid="PRO 5:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21"/>Hujiin namaa Mootiin Waan Maraa duratti ifa;</para>
  <para style="q2" vid="PRO 5:21">inni daandii namaa mara dhagga.<verse eid="PRO 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22"/>Nami hamaan hujuma ifiitiin tiyyoo seena;</para>
  <para style="q2" vid="PRO 5:22">cubbuma ifiitiin qabama.<verse eid="PRO 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23"/>Inni qajeelfama waan dhabeef du'a;</para>
  <para style="q2" vid="PRO 5:23">gowwummaa guddoo ifiitiin</para>
  <para style="q2" vid="PRO 5:23">karaa irraa miliqa.<verse eid="PRO 5:23"/></para>
  <chapter eid="PRO 5"/>
  <chapter number="6" style="c" sid="PRO 6"/>
  <para style="s1">Gowwummaa Irraa Ifi Eeggatiisa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 6:1"/>Ilma kiyya, namaaf wobii yoo teete,</para>
  <para style="q2" vid="PRO 6:1">marroo nama dhibi'iitiif</para>
  <para style="q2" vid="PRO 6:1">harka wol dhowatiisaan</para>
  <para style="q2" vid="PRO 6:1">waadaa yoo galte,<verse eid="PRO 6:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PRO 6:2"/>woma dubbatteen tiyyoo yoo seente,</para>
  <para style="q2" vid="PRO 6:2">jechuma afaan keetii bayeen yoo qabante,<verse eid="PRO 6:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PRO 6:3"/>ilma kiyya, harka nama sanii waan seenteef,</para>
  <para style="q2" vid="PRO 6:3">ifi baasiisaaf,</para>
  <para style="q2" vid="PRO 6:3">gara nama sanii dhaqiitii,</para>
  <para style="q2" vid="PRO 6:3">gad ifi qabi;</para>
  <para style="q2" vid="PRO 6:3">akka inni wobummaa san si irraa buusuuf</para>
  <para style="q2" vid="PRO 6:3">isa gaafadhu.<verse eid="PRO 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4"/>Adoo tana hin godhin hin rafin;</para>
  <para style="q2" vid="PRO 6:4">hirriibi ila teeti irra hin marin.<verse eid="PRO 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5"/>Akka gadansi worra adansu jalaa,</para>
  <para style="q2" vid="PRO 6:5">sinbirreen tiyyoo jalaa miliqanu,</para>
  <para style="q2" vid="PRO 6:5">atille ifi baasi.<verse eid="PRO 6:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6"/>Ati namicha booseya,</para>
  <para style="q2" vid="PRO 6:6">me dhaqiitii mixaa dhukkulle ilaali;</para>
  <para style="q2" vid="PRO 6:6">mala isaa ilaaliitii qaroo te'i.<verse eid="PRO 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 6:7"/>Isaan sooressa,</para>
  <para style="q2" vid="PRO 6:7">toowataa yookiin bulchaa hin qabanu;<verse eid="PRO 6:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="PRO 6:8"/>te'uu malee sagalee ifii ta bonaa,</para>
  <para style="q2" vid="PRO 6:8">waan isaaniif barbaachisu</para>
  <para style="q2" vid="PRO 6:8">yennaa midhaan galu keessa wolitti qabatan.<verse eid="PRO 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9"/>Ati namichi boosenni</para>
  <para style="q2" vid="PRO 6:9">haga yoomii achi ratta?</para>
  <para style="q2" vid="PRO 6:9">Ati yoom hirriibaa kaata?<verse eid="PRO 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10"/>Ati diqqoo adoo rattuu,</para>
  <para style="q2" vid="PRO 6:10">diqqoo adoo mudduu,</para>
  <para style="q2" vid="PRO 6:10">foorfatiisaafille</para>
  <para style="q2" vid="PRO 6:10">diqqoo adoo harka wol irra naqattuu,<verse eid="PRO 6:10"/></para>
  <para style="q2">
    <verse number="11" style="v" sid="PRO 6:11"/>hiyyummaan akka saantu'uu,</para>
  <para style="q2" vid="PRO 6:11">akka nama meya woraanaa hidhatee,</para>
  <para style="q2" vid="PRO 6:11">sitti hin dhufa.<verse eid="PRO 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12"/>Nami gadhe'ee fi nami hamaan,</para>
  <para style="q2" vid="PRO 6:12">ka dubbii micciiraa asii fi achi deemu,<verse eid="PRO 6:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="PRO 6:13"/>ka ilaan qiphifatu,</para>
  <para style="q2" vid="PRO 6:13">ka miilaan beessisa kennu,</para>
  <para style="q2" vid="PRO 6:13">ka qubaan akeeku,<verse eid="PRO 6:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="PRO 6:14"/>ka gadhaa ifii keessatti</para>
  <para style="q2" vid="PRO 6:14">mala hamaa dhowu,</para>
  <para style="q2" vid="PRO 6:14">yennaa mara lola kaasa.<verse eid="PRO 6:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15"/>Tanaaf balaan dedhuma isatti hin bu'a;</para>
  <para style="q2" vid="PRO 6:15">yoosuma cabiisa hin fayyine caba.<verse eid="PRO 6:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 6:16"/>Wonni jaa ta Mootiin Waan Maraa jibbu,</para>
  <para style="q2" vid="PRO 6:16">torbeessoon ta inni dhiqatu jiran;<verse eid="PRO 6:16"/></para>
  <para style="q2">
    <verse number="17" style="v" sid="PRO 6:17"/>isaan kun ila tuffi'ii,</para>
  <para style="q2" vid="PRO 6:17">arraba dharaa,</para>
  <para style="q2" vid="PRO 6:17">harka dhiiga worra yakkaa hin qannee dhangalaasu,<verse eid="PRO 6:17"/></para>
  <para style="q2">
    <verse number="18" style="v" sid="PRO 6:18"/>gadhaa waan hantuu yaadu,</para>
  <para style="q2" vid="PRO 6:18">miila gara waan hantu'uu fiigu,<verse eid="PRO 6:18"/></para>
  <para style="q2">
    <verse number="19" style="v" sid="PRO 6:19"/>nama dharaan nama irratti dhugaa bayu,</para>
  <para style="q2" vid="PRO 6:19">ka obboleeyyan oddu'utti lola kakkaasu.<verse eid="PRO 6:19"/></para>
  <para style="s1">Gaarayyeeffatiisa Irraa Ifi Eeggatiisa</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 6:20"/>Ilma kiyya, ajaja abbaa keetii eegadhu;</para>
  <para style="q2" vid="PRO 6:20">barsiisa haadha teetiille hin lakkisin.<verse eid="PRO 6:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21"/>Yennaa mara gadhaa keeti keessa keyadhu;</para>
  <para style="q2" vid="PRO 6:21">morma keetille'etti hidhadhu.<verse eid="PRO 6:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 6:22"/>Isaan yennaa ati ideentu</para>
  <para style="q2" vid="PRO 6:22">si sooressan;</para>
  <para style="q2" vid="PRO 6:22">yennaa rattu si eegan;</para>
  <para style="q2" vid="PRO 6:22">yennaa ati dammaxxu</para>
  <para style="q2" vid="PRO 6:22">si'itti dubbatan.<verse eid="PRO 6:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23"/>Ajaji kun issa'a;</para>
  <para style="q2" vid="PRO 6:23">barsiisi kunille ifa;</para>
  <para style="q2" vid="PRO 6:23">qajeelfamaan sirreeffamiis</para>
  <para style="q2" vid="PRO 6:23">karaa jiru'uu ti.<verse eid="PRO 6:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24"/>Dubartii hantuu irraa,</para>
  <para style="q2" vid="PRO 6:24">arraba lallaafaa dubartii</para>
  <para style="q2" vid="PRO 6:24">gaarayyeeffatitti'ii irraa si eega.<verse eid="PRO 6:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25"/>Gadhaa keeti keessatti</para>
  <para style="q2" vid="PRO 6:25">dansummaa isi'ii hin halchin;</para>
  <para style="q2" vid="PRO 6:25">ilti isi'ii si hin booji'in.<verse eid="PRO 6:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26"/>Gatiin dubartii sagaagaltitti'ii</para>
  <para style="q2" vid="PRO 6:26">haga xaltaa daabbo'oo ti;</para>
  <para style="q2" vid="PRO 6:26">dubartiin gaarayyeeffattuun ammoo</para>
  <para style="q2" vid="PRO 6:26">gatii jiruu teetii si kaffalchiitti.<verse eid="PRO 6:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 6:27"/>Nami ibidda boba'atti qabatee,</para>
  <para style="q2" vid="PRO 6:27">woyaan isaa adoo hin gubatin</para>
  <para style="q2" vid="PRO 6:27">hafuu dandeettu hin jiraa?<verse eid="PRO 6:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28"/>Yookiin nami kashila irra ijjatee,</para>
  <para style="q2" vid="PRO 6:28">miilli isaa adoo hin gubatin</para>
  <para style="q2" vid="PRO 6:28">hafuu dande'u hin jiraa?<verse eid="PRO 6:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29"/>Nami niitii namaa woliin rafulle akkasuma te'a;</para>
  <para style="q2" vid="PRO 6:29">nami niitii namaa tuqee</para>
  <para style="q2" vid="PRO 6:29">adoo hin adabamin hafu hin jiru.<verse eid="PRO 6:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30"/>Hattichi yennaa beelote,</para>
  <para style="q2" vid="PRO 6:30">beela ifii bayiisa qofaaf yoo hate,</para>
  <para style="q2" vid="PRO 6:30">nami isa hin tuffatu.<verse eid="PRO 6:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31"/>Yoo qabame ammoo,</para>
  <para style="q2" vid="PRO 6:31">qabeenna inni qabu mara gaafattulle,</para>
  <para style="q2" vid="PRO 6:31">dachaa torba godhee kaffalaa motii ree?<verse eid="PRO 6:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32"/>Nami gaarayyeeffatu ammoo qalbii hin qabu;</para>
  <para style="q2" vid="PRO 6:32">nami gaarayyeeffatu marti ifi balleessa.<verse eid="PRO 6:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 6:33"/>Inni mada'aa fi salphinna hin dhaggata;</para>
  <para style="q2" vid="PRO 6:33">qaaniin ijjumaa isa irraa hin baddu.<verse eid="PRO 6:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34"/>Hinaaffaan abbaa manaa waan aarsituuf,</para>
  <para style="q2" vid="PRO 6:34">inni yennaa haluu bayu</para>
  <para style="q2" vid="PRO 6:34">marartii hin qabu.<verse eid="PRO 6:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35"/>Inni kaffaltii tokkolle hin fudhatu;</para>
  <para style="q2" vid="PRO 6:35">haga fedhe bacatulle,</para>
  <para style="q2" vid="PRO 6:35">kennansi aarii isaa hin qabbaneessu.<verse eid="PRO 6:35"/></para>
  <chapter eid="PRO 6"/>
  <chapter number="7" style="c" sid="PRO 7"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 7:1"/>Ilma kiyya, jecha kiyya eegadhu;</para>
  <para style="q2" vid="PRO 7:1">ajaja kiyya gadhaa keeti keessatti qabadhu.<verse eid="PRO 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2"/>Akka leetuuf,</para>
  <para style="q2" vid="PRO 7:2">ajaja kiyya eeggadhu;</para>
  <para style="q2" vid="PRO 7:2">barsiisa kiyyalle</para>
  <para style="q2" vid="PRO 7:2">akka gumaa ila teetii eeggadhu.<verse eid="PRO 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 7:3"/>Akka qube'ee quba keetitti keyadhu;</para>
  <para style="q2" vid="PRO 7:3">gadhaa keeti keessatti barreeffadhu.<verse eid="PRO 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4"/>Qarumma'aan, «Ati obboleettii tiyya» jedhi;</para>
  <para style="q2" vid="PRO 7:4">hubantiille'een, «Ati fira kiyya» jedhii waami.<verse eid="PRO 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5"/>Isaan dubartii gaarayyeeffattuu,</para>
  <para style="q2" vid="PRO 7:5">ta jechoota gammachiisuun</para>
  <para style="q2" vid="PRO 7:5">nama qaxafattu irraa si eegan.<verse eid="PRO 7:5"/></para>
  <para style="s1">Soba Dubartii Gaarayyeeffattu'uu</para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 7:6"/>Gaafa tokko ani karaa foddaa</para>
  <para style="q2" vid="PRO 7:6">mana kiyyaatiin ala ilaalee,<verse eid="PRO 7:6"/></para>
  <para style="q2">
    <verse number="7" style="v" sid="PRO 7:7"/>worra yaadaan hin bilchaatin keessaa,</para>
  <para style="q2" vid="PRO 7:7">dargaggoota oddu'uu,</para>
  <para style="q2" vid="PRO 7:7">dargaggeessa qalbii hin qanne tokko dhagge.<verse eid="PRO 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8"/>Inni karaa cinaa mana dubartii takkaa geessu gula,</para>
  <para style="q2" vid="PRO 7:8">gara mana isi'ii ideemiisatti jiraayyu.<verse eid="PRO 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9"/>Yennaan sun aduun seentee,</para>
  <para style="q2" vid="PRO 7:9">galgala dimimmisa</para>
  <para style="q2" vid="PRO 7:9">halkan dukkana keessa.<verse eid="PRO 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 7:10"/>Achiin duuba dubartittiin gad isatti baate;</para>
  <para style="q2" vid="PRO 7:10">isiin akka sagaagaltu'uu uffattee</para>
  <para style="q2" vid="PRO 7:10">nama dokonkorsiisaaf mala qaddiiyyu.<verse eid="PRO 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11"/>Isiin ta ila gad hin qabanne,</para>
  <para style="q2" vid="PRO 7:11">mati-jabeetti'i;</para>
  <para style="q2" vid="PRO 7:11">isiin ijjumaa mana hin teettu.<verse eid="PRO 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12"/>Takka karaa irra,</para>
  <para style="q2" vid="PRO 7:12">takka woldeennaa kara'aa irra</para>
  <para style="q2" vid="PRO 7:12">cinaa karaa maraa irra</para>
  <para style="q2" vid="PRO 7:12">dhaabbattee eeggatti.<verse eid="PRO 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 7:13"/>Isiin isa qaddee,</para>
  <para style="q2" vid="PRO 7:13">sunqattee, fokkoo malee, isaan,<verse eid="PRO 7:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 7:14"/>«Ani kennansa tokkumma'aa qaba;</para>
  <para style="q2" vid="PRO 7:14">adha waan waadaa gale muummesseera.<verse eid="PRO 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15"/>Maarre ani si fudhatiisaaf gad baye;</para>
  <para style="q2" vid="PRO 7:15">ani si dhaggiisaaf dharra'eeruun,</para>
  <para style="q2" vid="PRO 7:15">kunoo si dhagge.<verse eid="PRO 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16"/>Ani woyaa quncee talba'aa</para>
  <para style="q2" vid="PRO 7:16">ta biyya Gibxi'iititti seefantee hujante,</para>
  <para style="q2" vid="PRO 7:16">taqee tiyya irra afeera.<verse eid="PRO 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17"/>Taqee tiyyatti fiqiree, qumbii,</para>
  <para style="q2" vid="PRO 7:17">dakkaraa fi qurunfudii irraa hujante itti biifeera.<verse eid="PRO 7:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18"/>Koy, haga latti bariitutti</para>
  <para style="q2" vid="PRO 7:18">jaalala keenna dheebuu baanaa ti;</para>
  <para style="q2" vid="PRO 7:18">jaalalaan ifii gammachiinnaa ti.<verse eid="PRO 7:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19"/>Dhirsi kiyya mana hin jiru;</para>
  <para style="q2" vid="PRO 7:19">inni fagoo deemeera.<verse eid="PRO 7:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20"/>Inni beesee guddoo</para>
  <para style="q2" vid="PRO 7:20">fudhatee deemeera;</para>
  <para style="q2" vid="PRO 7:20">haga ji'i goobanutti</para>
  <para style="q2" vid="PRO 7:20">deebi'ee hin galu» jette.<verse eid="PRO 7:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 7:21"/>Isiin jechoota gammachiisuun</para>
  <para style="q2" vid="PRO 7:21">karaa irraa isa gorsite;</para>
  <para style="q2" vid="PRO 7:21">dubbii damma dibiisaan</para>
  <para style="q2" vid="PRO 7:21">isa dokonkorsite.<verse eid="PRO 7:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22"/>Yoosuma inni akka sangaa gara qalamu deemuu,</para>
  <para style="q2" vid="PRO 7:22">akka gadansa</para>
  <para style="q2" vid="PRO 7:22">gara fonxoro'oo deemuu,</para>
  <para style="q2" vid="PRO 7:22">isii gula deeme.<verse eid="PRO 7:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 7:23"/>Haga daayi tiruu isaa woraanutti,</para>
  <para style="q2" vid="PRO 7:23">akka sinbirreen kaatee tiyyoo seentu,</para>
  <para style="q2" vid="PRO 7:23">innille wonni kun</para>
  <para style="q2" vid="PRO 7:23">lubbuu isaatitti akka dhuttu hin beenne.<verse eid="PRO 7:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 7:24"/>Ammalle ilmaan tiyya,</para>
  <para style="q2" vid="PRO 7:24">na caqasa'a;</para>
  <para style="q2" vid="PRO 7:24">waan ani jedhulle</para>
  <para style="q2" vid="PRO 7:24">itti xiyyeeffadha'a.<verse eid="PRO 7:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 7:25"/>Gadhaan keessan gara karaa isi'ii hin deebi'in;</para>
  <para style="q2" vid="PRO 7:25">daandii isi'ii gula ideentanee</para>
  <para style="q2" vid="PRO 7:25">karaa irraa hin gorina'a.<verse eid="PRO 7:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 7:26"/>Isiin namoota hedduu madeessitee jissiteerti;</para>
  <para style="q2" vid="PRO 7:26">namoota bindillaalle ijjeetteerti;<verse eid="PRO 7:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27"/>Manni isi'ii karaa addee worri du'e jiru,</para>
  <para style="q2" vid="PRO 7:27">ka gara awwaalaa gad geessu.<verse eid="PRO 7:27"/></para>
  <chapter eid="PRO 7"/>
  <chapter number="8" style="c" sid="PRO 8"/>
  <para style="s1">Waamicha Qarumma'aa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1"/>Qarummaan hin waantuu ree?</para>
  <para style="q2" vid="PRO 8:1">Hubantiin qoonqoo ol hin qabattuu ree?<verse eid="PRO 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2"/>Isiin kooba karaa biraa gubbaa,</para>
  <para style="q2" vid="PRO 8:2">addee qaxxaamura kara'aa dhaabbatti.<verse eid="PRO 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3"/>Karra gara qacha'aa seenanu biraa,</para>
  <para style="q2" vid="PRO 8:3">addee seensuma qacha'aatii,</para>
  <para style="q2" vid="PRO 8:3">qoonqoo ifii ol qabattee iyyaa,<verse eid="PRO 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4"/>«Ee namoota, ani isin waama;</para>
  <para style="q2" vid="PRO 8:4">qoonqoo tiyya ol qabadhee</para>
  <para style="q2" vid="PRO 8:4">ilmaan namaa mara waama.<verse eid="PRO 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5"/>Isin worri hin bilchaatin qarummaa qabaadha'a;</para>
  <para style="q2" vid="PRO 8:5">isin worri gowwaan hubantii qabaadha'a.<verse eid="PRO 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6"/>Ani waan bu'aa qabu dubbataaraa caqasa'a;</para>
  <para style="q2" vid="PRO 8:6">waan sirrii te'e dubbatiisaaf</para>
  <para style="q2" vid="PRO 8:6">afaan kiyya saaqadha.<verse eid="PRO 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7"/>Afaan kiyya dhugaa dubbata;</para>
  <para style="q2" vid="PRO 8:7">arrabi kiyya waan hantuu jibba.<verse eid="PRO 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8"/>Jechooti afaan kiyyaa marti haqa;</para>
  <para style="q2" vid="PRO 8:8">isaan keessaa daddabaan</para>
  <para style="q2" vid="PRO 8:8">yookiin micciiramaan hin jiru.<verse eid="PRO 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9"/>Worra hubantii qabuuf,</para>
  <para style="q2" vid="PRO 8:9">marti isaaniituu ifa;</para>
  <para style="q2" vid="PRO 8:9">worra beekkumsa qabuuf dokonkora hin qabu.<verse eid="PRO 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10"/>Meetii caalaa gorsa kiyya,</para>
  <para style="q2" vid="PRO 8:10">worqii qulqulluu caalaalle beekkumsa filadha'a.<verse eid="PRO 8:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11"/>«Qarummaan dooqa diimaa waan caaltuuf,</para>
  <para style="q2" vid="PRO 8:11">wonni ati halchitu marti isii woliin</para>
  <para style="q2" vid="PRO 8:11">wol hin qixxoottu.<verse eid="PRO 8:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12"/>«Ani qarummaan,</para>
  <para style="q2" vid="PRO 8:12">malaammessummaa woliin jiraadha;</para>
  <para style="q2" vid="PRO 8:12">beekkumsii fi qalbeeffatiis kiyya.<verse eid="PRO 8:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13"/>Mootii Waan Maraa sodaatiis</para>
  <para style="q2" vid="PRO 8:13">waan hantuu jibbiisa;</para>
  <para style="q2" vid="PRO 8:13">ani kooraa fi bondhooriisa,</para>
  <para style="q2" vid="PRO 8:13">karaa hama'aa fi dubbii micciirantuu jibba.<verse eid="PRO 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14"/>Gorsii fi muraan haqaa tiyya;</para>
  <para style="q2" vid="PRO 8:14">ani hubanti'ii fi hunnalle hin qaba.<verse eid="PRO 8:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15"/>Moototi anaan mootii te'an;</para>
  <para style="q2" vid="PRO 8:15">bulchitootille anaan seera haqaa baasan.<verse eid="PRO 8:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16"/>Bulchitooti,</para>
  <para style="q2" vid="PRO 8:16">qondaaltoti biyya bulchanu martinuu</para>
  <para style="q2" vid="PRO 8:16">anaan biyya bulchan.<verse eid="PRO 8:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17"/>Ani worra na jaalatu hin jaaladha;</para>
  <para style="q2" vid="PRO 8:17">worri na barbaadatu na hin dhagga.<verse eid="PRO 8:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18"/>Durumma'aa fi ulfinni,</para>
  <para style="q2" vid="PRO 8:18">qabeenni hin dabarree fi milkiin na bira jiran.<verse eid="PRO 8:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19"/>Midhaan kiyya</para>
  <para style="q2" vid="PRO 8:19">worqii qulqulluu caala;</para>
  <para style="q2" vid="PRO 8:19">kennansi kiyya meetii qullittii caala.<verse eid="PRO 8:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20"/>Ani karaa balchumma'aa irra,</para>
  <para style="q2" vid="PRO 8:20">daandii haqaa irra ideema.<verse eid="PRO 8:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21"/>Worra na jaalatuuf</para>
  <para style="q2" vid="PRO 8:21">qabeenna hin kenna;</para>
  <para style="q2" vid="PRO 8:21">gootaraa isaaniille hin guuta.<verse eid="PRO 8:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22"/>«Mootiin Waan Maraa,</para>
  <para style="q2" vid="PRO 8:22">hujii ifii ta durii durii san maraan dura,</para>
  <para style="q2" vid="PRO 8:22">ana qarummaa dade.<verse eid="PRO 8:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23"/>Jalqaba bara durii durii,</para>
  <para style="q2" vid="PRO 8:23">biyyi lafaa adoo hin dadamin ani muudame.<verse eid="PRO 8:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24"/>Yennaa abbaayaan gugurdoon hin jirre,</para>
  <para style="q2" vid="PRO 8:24">yennaa maddi bisaaniituu hin jirre ani dhaladhe.<verse eid="PRO 8:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25"/>Gaarotaa fi kooboti adoo hin dadamin dura</para>
  <para style="q2" vid="PRO 8:25">ani dhaladhe.<verse eid="PRO 8:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26"/>Waaqi lafa yookiin diida adoo hin dadin dura,</para>
  <para style="q2" vid="PRO 8:26">yookiin biyyee biyya lafaa takkaalle adoo hin dadin</para>
  <para style="q2" vid="PRO 8:26">ani dhaladhe.<verse eid="PRO 8:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27"/>Yennaa inni abbaaya'aan gubbaa ol-gubbaa diriirse,</para>
  <para style="q2" vid="PRO 8:27">ani achi jiraayyu.<verse eid="PRO 8:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28"/>Yennaa inni gubbaa irratti duumensa dade,</para>
  <para style="q2" vid="PRO 8:28">yennaa inni madda abbaaya'aa dade,<verse eid="PRO 8:28"/></para>
  <para style="q2">
    <verse number="29" style="v" sid="PRO 8:29"/>bisaan ajaja isaa irra akka hin dabarre,</para>
  <para style="q2" vid="PRO 8:29">yennaa inni meessaa abbaayota gugurdo'oo tolche,</para>
  <para style="q2" vid="PRO 8:29">yennaa inni meessaa hundee lafaa tolche,</para>
  <para style="q2" vid="PRO 8:29">ani achi jiraayyu.<verse eid="PRO 8:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 8:30"/>Ani yennaa san akka ogeessa guddichaa te'ee,</para>
  <para style="q2" vid="PRO 8:30">isa woliin achi jiraayyu.</para>
  <para style="q2" vid="PRO 8:30">Ani yennaa mara isa duratti gammadaa,</para>
  <para style="q2" vid="PRO 8:30">guyyuma guyya'aan</para>
  <para style="q2" vid="PRO 8:30">isa gammachiisaa tureeyyu.<verse eid="PRO 8:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31"/>Ani biyya lafaa ta isaa duudi'iin firinxiixaa,</para>
  <para style="q2" vid="PRO 8:31">nama maraan gammadaa tureeyyu.<verse eid="PRO 8:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32"/>«Ammalle ilmaan tiyya, na caqasa'a;</para>
  <para style="q2" vid="PRO 8:32">worri karaa kiyya eegatu ka gammade.<verse eid="PRO 8:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33"/>Gorsa kiyya caqasa'aatii,</para>
  <para style="q2" vid="PRO 8:33">qaroo te'a'a;</para>
  <para style="q2" vid="PRO 8:33">gorsa kiyya cadhittanee hin ilaalina'a.<verse eid="PRO 8:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34"/>Nami na caqasu,</para>
  <para style="q2" vid="PRO 8:34">ka guyyuma guyya'aan</para>
  <para style="q2" vid="PRO 8:34">balbala tiyya duratti dammaqee,</para>
  <para style="q2" vid="PRO 8:34">karaa balbala tiyyaa duratti na eegatu</para>
  <para style="q2" vid="PRO 8:34">ka gammade.<verse eid="PRO 8:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35"/>Nami na dhaggatu jiruu dhaggata;</para>
  <para style="q2" vid="PRO 8:35">Mootii Waan Maraa biralle'etti</para>
  <para style="q2" vid="PRO 8:35">fudhatama qabaata.<verse eid="PRO 8:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36"/>Nami na dhabu ifi miidha;</para>
  <para style="q2" vid="PRO 8:36">nami na jibbu marti du'a jaalata» jetti.<verse eid="PRO 8:36"/></para>
  <chapter eid="PRO 8"/>
  <chapter number="9" style="c" sid="PRO 9"/>
  <para style="s1">Qarumma'aa Fi Gowwummaa</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 9:1"/>Qarummaan mana ifii ijaarratteerti;</para>
  <para style="q2" vid="PRO 9:1">isiin utuboota mana ifii torba</para>
  <para style="q2" vid="PRO 9:1">boccee dhaabbatteerti.<verse eid="PRO 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2"/>Isiin horii qaltee,</para>
  <para style="q2" vid="PRO 9:2">daadhii woyni'ii naxxee,</para>
  <para style="q2" vid="PRO 9:2">sagaleelle qopheessiteerti.<verse eid="PRO 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3"/>Qachaa keessa kooba irra dhaabbatanee,</para>
  <para style="q2" vid="PRO 9:3">akka waamanuuf,</para>
  <para style="q2" vid="PRO 9:3">isiin dubartoota tajaajiltoota ifii ergitee,<verse eid="PRO 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 9:4"/>«Nami yaadaan hin bilchaatin marti</para>
  <para style="q2" vid="PRO 9:4">as kowa'aa seena'a!» jetti;</para>
  <para style="q2" vid="PRO 9:4">worra qalbii hin qannelle'een,<verse eid="PRO 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 9:5"/>«Kowa'a, sagalee tiyya nyaadha'a;</para>
  <para style="q2" vid="PRO 9:5">daadhii ani naqelle una'a.<verse eid="PRO 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 9:6"/>Isin jiru'uun hin jiraattaniitii,</para>
  <para style="q2" vid="PRO 9:6">karaa gowwumma'aa lakkisa'a;</para>
  <para style="q2" vid="PRO 9:6">karaa hubanti'ii irra ideema'a» jetti.<verse eid="PRO 9:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 9:7"/>Nami murgaamessa gorsu,</para>
  <para style="q2" vid="PRO 9:7">arraba fudhata;</para>
  <para style="q2" vid="PRO 9:7">nami nama hamaa xixu qaanii ifitti fida.<verse eid="PRO 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8"/>Nama murgaamessa yoo gorsite si hin jibba;</para>
  <para style="q2" vid="PRO 9:8">nama qaroo yoo xixxe si hin jaalata.<verse eid="PRO 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 9:9"/>Nama qaroo gorsi</para>
  <para style="q2" vid="PRO 9:9">inni irra caalaa qaroo hin te'a;</para>
  <para style="q2" vid="PRO 9:9">nama balchaa barsiisi,</para>
  <para style="q2" vid="PRO 9:9">inni beekkumsa itti hin ede'ata.<verse eid="PRO 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 9:10"/>Qarummaan jalqabaa Mootii Waan Maraa sodaatiisa;</para>
  <para style="q2" vid="PRO 9:10">Woyyicha san beekiisi hubantii dhaggatiisa.<verse eid="PRO 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11"/>Qarummaan bara jiruu teetii hin baceessiti;</para>
  <para style="q2" vid="PRO 9:11">woggoota jiruu teetii itti sii edeeti.<verse eid="PRO 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12"/>Qaroo yoo teete,</para>
  <para style="q2" vid="PRO 9:12">bu'aan isi'ii teetuma;</para>
  <para style="q2" vid="PRO 9:12">ati yoo murgaamessa teete ifuma miita.<verse eid="PRO 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 9:13"/>Dubartiin gowwittiin dubbattitti'i;</para>
  <para style="q2" vid="PRO 9:13">isiin daalle'e;</para>
  <para style="q2" vid="PRO 9:13">beekkumsa hin qaddu.<verse eid="PRO 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14"/>Isiin qachaa keessa kooba irra,</para>
  <para style="q2" vid="PRO 9:14">balbala mana ifii dura barcumaa irra teetti.<verse eid="PRO 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 9:15"/>Worra karaa san dabaru,</para>
  <para style="q2" vid="PRO 9:15">ka qajeelee karaa ifii deemu waantee,<verse eid="PRO 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 9:16"/>«Isin worri yaadaan hin bilchaatin,</para>
  <para style="q2" vid="PRO 9:16">as gora'a» jetti;</para>
  <para style="q2" vid="PRO 9:16">worra qalbii hin qannelle'een,<verse eid="PRO 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 9:17"/>«Bisaan hannaa hin mi'owa;</para>
  <para style="q2" vid="PRO 9:17">sagaleen dhokaataan nyaatanu,</para>
  <para style="q2" vid="PRO 9:17">hin kurootti» jetti.<verse eid="PRO 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18"/>Isaan ammoo worri du'e akka achi jiru,</para>
  <para style="q2" vid="PRO 9:18">worri isiin waantelle,</para>
  <para style="q2" vid="PRO 9:18">qilee addee worri du'e jiruu keessa</para>
  <para style="q2" vid="PRO 9:18">akka jiranu hin beekanu.<verse eid="PRO 9:18"/></para>
  <chapter eid="PRO 9"/>
  <chapter number="10" style="c" sid="PRO 10"/>
  <para style="s1">Fakkeenna Solomoonii</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 10:1"/>Fakkeenni Solomoonii</para>
  <para style="q2" vid="PRO 10:1">ka asii gad jiru:</para>
  <para style="q2" vid="PRO 10:1">ilmi qaroon abbaa ifii gammachiisa;</para>
  <para style="q2" vid="PRO 10:1">ilmi gowwaan haadha ifii gaddisiisa.<verse eid="PRO 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2"/>Qabeenni karaa hin malleen dhaggame</para>
  <para style="q2" vid="PRO 10:2">bu'aa hin qabu;</para>
  <para style="q2" vid="PRO 10:2">balchummaan ammoo</para>
  <para style="q2" vid="PRO 10:2">du'a jalaa nama baatti.<verse eid="PRO 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 10:3"/>Mootiin Waan Maraa worri balchaan</para>
  <para style="q2" vid="PRO 10:3">akka beelotanu hin godhu;</para>
  <para style="q2" vid="PRO 10:3">worra hamaa ammoo waan halchane</para>
  <para style="q2" vid="PRO 10:3">akka isaan hin dhagganne hin godha.<verse eid="PRO 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4"/>Harki boosenni nama hiyyoonsa;</para>
  <para style="q2" vid="PRO 10:4">harki jabaatee huju ammoo nama duroonsa.<verse eid="PRO 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5"/>Worri yenna'aan midhaan galfatu qaro'o;</para>
  <para style="q2" vid="PRO 10:5">worri yennaa midhaan galfatiisaa rafu ammoo</para>
  <para style="q2" vid="PRO 10:5">hin salphata.<verse eid="PRO 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 10:6"/>Eebbi mataa balchootaa irra jira;</para>
  <para style="q2" vid="PRO 10:6">worri hunnaan nama irratti ka'u dubbii dansa'aan</para>
  <para style="q2" vid="PRO 10:6">hunnaan nama irratti ka'iisa ifii gollatan.<verse eid="PRO 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7"/>Yaadannoon nama balcha'aa eebbaaf hin teeti;</para>
  <para style="q2" vid="PRO 10:7">maqaan nama hama'aa ammoo hin dedhama.<verse eid="PRO 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 10:8"/>Nami gadhaa ifii keessatti qaro'oo seera fudhata;</para>
  <para style="q2" vid="PRO 10:8">nami gowwaan dubbattichi ammoo</para>
  <para style="q2" vid="PRO 10:8">gara badi'ii deema.<verse eid="PRO 10:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9"/>Nami haqaan ideemu nageyaan le'a;</para>
  <para style="q2" vid="PRO 10:9">nami karaa micciiramaa gula deemu ammoo</para>
  <para style="q2" vid="PRO 10:9">hin saaxilama.<verse eid="PRO 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10"/>Nami ilaan qiphifatu rakkinna fida;</para>
  <para style="q2" vid="PRO 10:10">nami gowwaan dubbattichi ammoo</para>
  <para style="q2" vid="PRO 10:10">gara badi'ii deema.<verse eid="PRO 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 10:11"/>Afaan nama balcha'aa madda jiru'uu ti;</para>
  <para style="q2" vid="PRO 10:11">worri hunnaan nama irratti ka'u ammoo</para>
  <para style="q2" vid="PRO 10:11">dubbii dansa'aan</para>
  <para style="q2" vid="PRO 10:11">hunnaan nama irratti ka'iisa ifii gollatan.<verse eid="PRO 10:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12"/>Jibbi lola kaasa;</para>
  <para style="q2" vid="PRO 10:12">jaalalli ammoo yakkaa mara golla.<verse eid="PRO 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13"/>Qarummaan afaan qaroole'ee irra jirti;</para>
  <para style="q2" vid="PRO 10:13">adabbiin ammoo dudda</para>
  <para style="q2" vid="PRO 10:13">gowwoole'ee irra jirti.<verse eid="PRO 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 10:14"/>Qarooleen beekkumsa tuulatti;</para>
  <para style="q2" vid="PRO 10:14">dubbiin gowwa'aa ammoo badii fiddi.<verse eid="PRO 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15"/>Qabeenni dureeyyi'iif qachaa dalleya dhaka'aa qabu;</para>
  <para style="q2" vid="PRO 10:15">hiyyummaan ammoo badii hiyyeeyyi'ii ti.<verse eid="PRO 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16"/>Gatiin eloo balcha'aa jiru'u;</para>
  <para style="q2" vid="PRO 10:16">bu'aan nama hama'aa adabbi'i.<verse eid="PRO 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17"/>Nami gorsa fudhatu karaa jiru'uu namatti mudhisa;</para>
  <para style="q2" vid="PRO 10:17">nami xixicha tuffatu ammoo</para>
  <para style="q2" vid="PRO 10:17">karaa irraa nama milissa.<verse eid="PRO 10:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18"/>Nami jibba ifii dhoffatu dharaamessa;</para>
  <para style="q2" vid="PRO 10:18">nami hamii odeessu gowwa'a.<verse eid="PRO 10:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19"/>Jechoota bacaa keessaa,</para>
  <para style="q2" vid="PRO 10:19">cubbuun hin dhabantu;</para>
  <para style="q2" vid="PRO 10:19">nami arraba ifii eegatu ammoo qaro'o.<verse eid="PRO 10:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20"/>Dubbiin nama balcha'aa akka meetii qullu'uu ti;</para>
  <para style="q2" vid="PRO 10:20">yaadi nama hama'aa ammoo gatii hin qabu.<verse eid="PRO 10:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21"/>Afaan nama balcha'aa nama hedduu areera;</para>
  <para style="q2" vid="PRO 10:21">worri gowwaan ammoo</para>
  <para style="q2" vid="PRO 10:21">qalbii dhabiisaan du'a.<verse eid="PRO 10:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22"/>Eebbi Mootii Waan Maraa durummaa kenna;</para>
  <para style="q2" vid="PRO 10:22">inni rakkinna isi'itti hin dabalu.<verse eid="PRO 10:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23"/>Nami gowwaan waan hantuu hujiisatti gammada;</para>
  <para style="q2" vid="PRO 10:23">nami hubantii qabu ammoo</para>
  <para style="q2" vid="PRO 10:23">qarumma'atti gammada.<verse eid="PRO 10:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24"/>Nama hamaa waan inni guddoo sodaatutti itti dhufa;</para>
  <para style="q2" vid="PRO 10:24">nama balchaa ammoo</para>
  <para style="q2" vid="PRO 10:24">waan inni guddoo halchutti isaaf kennama.<verse eid="PRO 10:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25"/>Hobonbolattiin yennaa kaatu,</para>
  <para style="q2" vid="PRO 10:25">worra hamaa haxoottee dabarti;</para>
  <para style="q2" vid="PRO 10:25">worri balchaan ammoo</para>
  <para style="q2" vid="PRO 10:25">haga bara baraa</para>
  <para style="q2" vid="PRO 10:25">jabaatee dhaabbata.<verse eid="PRO 10:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26"/>Wonni dhangaggowu ilkaan,</para>
  <para style="q2" vid="PRO 10:26">aarrille ila akkuma rakkisu,</para>
  <para style="q2" vid="PRO 10:26">nami booseyille</para>
  <para style="q2" vid="PRO 10:26">nama isa ergatu rakkisa.<verse eid="PRO 10:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 10:27"/>Mootii Waan Maraa sodaatiis jiruu dheeressa;</para>
  <para style="q2" vid="PRO 10:27">woggaan nama hama'aa ammoo gabaaddu'u.<verse eid="PRO 10:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28"/>Addiin worra balcha'aa gammada;</para>
  <para style="q2" vid="PRO 10:28">addiin worra hama'aa bu'aa hin qaddu.<verse eid="PRO 10:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29"/>Karaan Mootii Waan Maraa</para>
  <para style="q2" vid="PRO 10:29">worra balcha'aaf gollaa jaddu'u;</para>
  <para style="q2" vid="PRO 10:29">worra hantuu hujuuf ammoo badi'i.<verse eid="PRO 10:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30"/>Worri balchaan ijjumaa hin munyuuqu;</para>
  <para style="q2" vid="PRO 10:30">worri hamaan ammoo lafa irratti hin hafu.<verse eid="PRO 10:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31"/>Afaan worra balcha'aa qarummaa dubbata;</para>
  <para style="q2" vid="PRO 10:31">arrabi dubbii micciiru ammoo hin murama.<verse eid="PRO 10:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32"/>Afaan worra balcha'aa dubbii toltu beeka;</para>
  <para style="q2" vid="PRO 10:32">afaan worra hama'aa ammoo micciiriisa qofa beeka.<verse eid="PRO 10:32"/></para>
  <chapter eid="PRO 10"/>
  <chapter number="11" style="c" sid="PRO 11"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1"/>Mootiin Waan Maraa madaala sobaa jibba;</para>
  <para style="q2" vid="PRO 11:1">dhakaa madaalaa ka sirrii te'etti gammada.<verse eid="PRO 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2"/>Koorri yennaa dhufu,</para>
  <para style="q2" vid="PRO 11:2">salphinni hin dhufa;</para>
  <para style="q2" vid="PRO 11:2">gad ifi qabiisaan ammoo qarummaan dhutti.<verse eid="PRO 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3"/>Worri qajeelaan komii dhabiisaan qajeelfaman;</para>
  <para style="q2" vid="PRO 11:3">worri hin addatanne ammoo</para>
  <para style="q2" vid="PRO 11:3">maltumma'aan badan.<verse eid="PRO 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4"/>Guyyaa mura'aa durummaan bu'aa hin qaddu;</para>
  <para style="q2" vid="PRO 11:4">balchummaan ammoo du'a irraa si hamburti.<verse eid="PRO 11:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5"/>Worra komii hin qanne</para>
  <para style="q2" vid="PRO 11:5">balachummaan karaa isaanii qajeelchiti;</para>
  <para style="q2" vid="PRO 11:5">worri hamaan ammoo</para>
  <para style="q2" vid="PRO 11:5">hammeennuma ifiitiin jiga.<verse eid="PRO 11:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 11:6"/>Nama qajeelaa</para>
  <para style="q2" vid="PRO 11:6">balchumma'atti isa baasa;</para>
  <para style="q2" vid="PRO 11:6">worri hin addatanne ammoo</para>
  <para style="q2" vid="PRO 11:6">halchuma ifii hantu'uun qabaman.<verse eid="PRO 11:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 11:7"/>Nami hamaan yennaa du'u,</para>
  <para style="q2" vid="PRO 11:7">addiin isaalle hin baddi;</para>
  <para style="q2" vid="PRO 11:7">durummaan inni addatu</para>
  <para style="q2" vid="PRO 11:7">womaa isaaf hin baatu.<verse eid="PRO 11:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 11:8"/>Nami balchaan rakkoo jalaa hin baya;</para>
  <para style="q2" vid="PRO 11:8">nami hamaan ammoo</para>
  <para style="q2" vid="PRO 11:8">addee isaa rakkinnatti hin gala.<verse eid="PRO 11:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 11:9"/>Nami hamaan dubbii afaan ifiitiin nama balleessa;</para>
  <para style="q2" vid="PRO 11:9">nami balchaan beekkumsa ifiitiin baya.<verse eid="PRO 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 11:10"/>Worra balcha'aaf yennaa milkoottu,</para>
  <para style="q2" vid="PRO 11:10">kolbaan qacha'aa hin firinxiixi.</para>
  <para style="q1" vid="PRO 11:10">Worri hamaan yennaa badu,</para>
  <para style="q2" vid="PRO 11:10">isaan hin ilillisan.<verse eid="PRO 11:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 11:11"/>Eebba worra balcha'aatiin qachaan tokko guddata;</para>
  <para style="q2" vid="PRO 11:11">dubbii afaan worra hama'aatiin ammoo hin bada.<verse eid="PRO 11:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 11:12"/>Nami qalbii hin qanne nama tuffata;</para>
  <para style="q2" vid="PRO 11:12">nami qalbii qabu ammoo cadhi jedha.<verse eid="PRO 11:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 11:13"/>Nami hamatu dhossaa eegee hin dande'u;</para>
  <para style="q2" vid="PRO 11:13">nami addatamaan ammoo dhossaa eega.<verse eid="PRO 11:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 11:14"/>Gorsitooti yoo hin jiraatin</para>
  <para style="q2" vid="PRO 11:14">mootummaan takka hin jiddi;</para>
  <para style="q2" vid="PRO 11:14">gorsitooti hedduun yoo jiraatte ammoo</para>
  <para style="q2" vid="PRO 11:14">nageyaan jiraatti.<verse eid="PRO 11:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 11:15"/>Nami alaga'aaf wobii te'u hin rakkata;</para>
  <para style="q2" vid="PRO 11:15">nami wobii te'iisa jibbu ammoo</para>
  <para style="q2" vid="PRO 11:15">nageyaan hin jiraata.<verse eid="PRO 11:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 11:16"/>Dubartiin arjaan ulfinna hin dhaggatti;</para>
  <para style="q2" vid="PRO 11:16">worri hunnaan nama irratti ka'u ammoo</para>
  <para style="q2" vid="PRO 11:16">durummaa qofa dhaggata.<verse eid="PRO 11:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 11:17"/>Gadhi-laafessi</para>
  <para style="q2" vid="PRO 11:17">ifumaaf bu'aa dhaggatta;</para>
  <para style="q2" vid="PRO 11:17">gadhi-jabeessi ammoo</para>
  <para style="q2" vid="PRO 11:17">ifuma miidha.<verse eid="PRO 11:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 11:18"/>Nami hamaan bu'aa isa sobu dhaggata;</para>
  <para style="q2" vid="PRO 11:18">nami balchumma'aan huju ammoo</para>
  <para style="q2" vid="PRO 11:18">gatii addachiittuu dhaggata.<verse eid="PRO 11:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 11:19"/>Nami dhugumaan balchaa te'e jiru'uun hin le'a;</para>
  <para style="q2" vid="PRO 11:19">nami waan hantuu ari'u ammoo hin du'a.<verse eid="PRO 11:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 11:20"/>Mootiin Waan Maraa</para>
  <para style="q2" vid="PRO 11:20">worra yaada micciirama'aa jibba;</para>
  <para style="q2" vid="PRO 11:20">worra komii hin qannetti ammoo</para>
  <para style="q2" vid="PRO 11:20">hin gammada.<verse eid="PRO 11:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 11:21"/>Dhugumaan nami hamaan</para>
  <para style="q2" vid="PRO 11:21">adoo hin adabamin hin hafu;</para>
  <para style="q2" vid="PRO 11:21">worri balchaan ammoo</para>
  <para style="q2" vid="PRO 11:21">adabbii jalaa hin baya.<verse eid="PRO 11:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22"/>Dubartiin shaggittiin qalbii hin qanne,</para>
  <para style="q2" vid="PRO 11:22">akka qubee worqi'ii</para>
  <para style="q2" vid="PRO 11:22">ta funnaan booyye'ee irra jirtuu ti.<verse eid="PRO 11:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 11:23"/>Halchaan nama balcha'aa</para>
  <para style="q2" vid="PRO 11:23">waan dansaa qofaan muummotti;</para>
  <para style="q2" vid="PRO 11:23">halchaan nama hama'aa ammoo</para>
  <para style="q2" vid="PRO 11:23">mufi'iin muummotti.<verse eid="PRO 11:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 11:24"/>Nami gariin toluma karra ifii namaaf kenna;</para>
  <para style="q2" vid="PRO 11:24">ammoo irra caalaa duroomaa deema;</para>
  <para style="q2" vid="PRO 11:24">nami gariin akka malee donnooma;</para>
  <para style="q2" vid="PRO 11:24">ammoo hiyyoommataatuma deema.<verse eid="PRO 11:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 11:25"/>Nami arjaan hin durooma;</para>
  <para style="q2" vid="PRO 11:25">nami dheebuu nama baasulle</para>
  <para style="q2" vid="PRO 11:25">ifille'eef dheebuu hin baya.<verse eid="PRO 11:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 11:26"/>Nama midhaan kuufatee tursu</para>
  <para style="q2" vid="PRO 11:26">kolbaan hin abaarti;</para>
  <para style="q2" vid="PRO 11:26">nami midhaan baasee</para>
  <para style="q2" vid="PRO 11:26">gurguratu ammoo</para>
  <para style="q2" vid="PRO 11:26">eebba dhaggata.<verse eid="PRO 11:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 11:27"/>Nami waan dansaa jabaatee barbaadu,</para>
  <para style="q2" vid="PRO 11:27">waan dansaa dhaggata;</para>
  <para style="q2" vid="PRO 11:27">nami waan hantuu barbaadu ammoo</para>
  <para style="q2" vid="PRO 11:27">waan hantuu dhaggatta.<verse eid="PRO 11:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28"/>Nami durummaa ifiititti addatu hin jiga;</para>
  <para style="q2" vid="PRO 11:28">nami balchaan ammoo</para>
  <para style="q2" vid="PRO 11:28">akka baala jiidha'aa hin bisila.<verse eid="PRO 11:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 11:29"/>Nami maatii ifii rakkisu,</para>
  <para style="q2" vid="PRO 11:29">harka duwwaa hin hafa;</para>
  <para style="q2" vid="PRO 11:29">gowwaan tajaajilaa qaro'oo hin te'a.<verse eid="PRO 11:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 11:30"/>Hujiin nama balcha'aa</para>
  <para style="q2" vid="PRO 11:30">muka jiru'uu ti;</para>
  <para style="q2" vid="PRO 11:30">nami barsiisee lubbuu namaa deebisu qaro'o.<verse eid="PRO 11:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 11:31"/>Worri balchaan lafa irratti</para>
  <para style="q2" vid="PRO 11:31">gatii hujii ifii akkuma dhaggatanu,</para>
  <para style="q2" vid="PRO 11:31">worri Waaqa malee le'uu fi</para>
  <para style="q2" vid="PRO 11:31">worri cubbaaleyyiille lafa irratti akkasuma</para>
  <para style="q2" vid="PRO 11:31">gatii hujii ifii hin dhaggatan.<verse eid="PRO 11:31"/></para>
  <chapter eid="PRO 11"/>
  <chapter number="12" style="c" sid="PRO 12"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 12:1"/>Nami qajeelfama jaalatu,</para>
  <para style="q2" vid="PRO 12:1">beekkumsa jaalatta;</para>
  <para style="q2" vid="PRO 12:1">nami xixicha jibbu ammoo gowwa'a.<verse eid="PRO 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 12:2"/>Nami dansaan Mootii Waan Maraa biratti</para>
  <para style="q2" vid="PRO 12:2">fudhatama hin dhaggata;</para>
  <para style="q2" vid="PRO 12:2">worra yaada hama'aa ammoo</para>
  <para style="q2" vid="PRO 12:2">Mootiin Waan Maraa itti hin mura.<verse eid="PRO 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 12:3"/>Nami karaa hama'aan jabaatee dhaabbatuu hin dande'u;</para>
  <para style="q2" vid="PRO 12:3">balchaan ammoo adde'ee hin tacho'u.<verse eid="PRO 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4"/>Niitiin qalbeeffattuun dhirsa ifiitiif akka kallachaa ti;</para>
  <para style="q2" vid="PRO 12:4">ta isa qaanessitu ammoo</para>
  <para style="q2" vid="PRO 12:4">akka dhukkuba lafee nyaatuu ti.<verse eid="PRO 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 12:5"/>Yaadi worra balcha'aa yaada haqaa ti;</para>
  <para style="q2" vid="PRO 12:5">gorsi worra hama'aa ammoo nama soba.<verse eid="PRO 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 12:6"/>Jechi nama hama'aa dhiiga dhangalaasiisa;</para>
  <para style="q2" vid="PRO 12:6">jechi nama balcha'aa ammoo</para>
  <para style="q2" vid="PRO 12:6">dhiiga dhangalaasiisa jalaa baasa.<verse eid="PRO 12:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 12:7"/>Namooti hamaaleyyiin hin badan;</para>
  <para style="q2" vid="PRO 12:7">deebi'aneelle hin dhaggamanu.</para>
  <para style="q2" vid="PRO 12:7">Maatiin worra balcha'aa ammoo</para>
  <para style="q2" vid="PRO 12:7">jabaattee dhaabbatti.<verse eid="PRO 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 12:8"/>Nami akkuma qarummaa ifiititti leellifama;</para>
  <para style="q2" vid="PRO 12:8">nami qalbii micciirama'aa ammoo</para>
  <para style="q2" vid="PRO 12:8">hin tuffatama.<verse eid="PRO 12:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 12:9"/>Nama sagalee nyaatu adoo hin qabaatin,</para>
  <para style="q2" vid="PRO 12:9">nama guddaa ifi fakkeessuu mannaa,</para>
  <para style="q2" vid="PRO 12:9">nama ifi gad qabee</para>
  <para style="q2" vid="PRO 12:9">hojjataa te'ee le'u woyya.<verse eid="PRO 12:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 12:10"/>Nami balchaan horii ifiitiif hin marara;</para>
  <para style="q2" vid="PRO 12:10">nami hamaan</para>
  <para style="q2" vid="PRO 12:10">ammoo yennaa mara gadhaa jabaata.<verse eid="PRO 12:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 12:11"/>Nami jabaatee lafa qotu sagalee bacaa hin qabaata;</para>
  <para style="q2" vid="PRO 12:11">ka waan bu'aa hin qanne ari'u ammoo gowwa'a.<verse eid="PRO 12:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 12:12"/>Nami hamaan waan worri hamaan saame kajeela;</para>
  <para style="q2" vid="PRO 12:12">nami balchaan ammoo horee bacata.<verse eid="PRO 12:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 12:13"/>Nami hamaan jechuma hamaa ifiitiin qabama;</para>
  <para style="q2" vid="PRO 12:13">nami balchaan ammoo rakkinna jalaa hin baya.<verse eid="PRO 12:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 12:14"/>Nami waan afaan isaa keessaa bayuun</para>
  <para style="q2" vid="PRO 12:14">waan dansaa quufa;</para>
  <para style="q2" vid="PRO 12:14">akkuma hujii harka ifiititti gatii isaaf malte fudhata.<verse eid="PRO 12:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 12:15"/>Nama gowwaa karaan isaa qajeelaa itti fakkaata;</para>
  <para style="q2" vid="PRO 12:15">nami qaroon ammoo gorsa caqasa.<verse eid="PRO 12:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16"/>Aariin nama gowwa'aa yoosuma beekkanti;</para>
  <para style="q2" vid="PRO 12:16">nami qalbeeffataan ammoo</para>
  <para style="q2" vid="PRO 12:16">arraba tuffatee lakkisa.<verse eid="PRO 12:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 12:17"/>Dhugaa bayaan dhugaamessi,</para>
  <para style="q2" vid="PRO 12:17">dubbii dhuga'aa dhugaa baya;</para>
  <para style="q2" vid="PRO 12:17">dhugaa bayaan dharaamessi ammoo soba dubbata.<verse eid="PRO 12:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18"/>Dubbiin gar-maleen</para>
  <para style="q2" vid="PRO 12:18">akka shallaaga'aa nama woraanti;</para>
  <para style="q2" vid="PRO 12:18">arrabi nama qaro'oo ammoo nama fayyisa.<verse eid="PRO 12:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 12:19"/>Afaan dhuga'aa haga bara baraa jiraata;</para>
  <para style="q2" vid="PRO 12:19">arrabi sobaa ammoo yennaa diqqoo qofa jiraata.<verse eid="PRO 12:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 12:20"/>Gadhaa worra waan hantuu maluu keessa</para>
  <para style="q2" vid="PRO 12:20">sobatti jira;</para>
  <para style="q2" vid="PRO 12:20">worri waan nageyaa namatti gorsu ammoo</para>
  <para style="q2" vid="PRO 12:20">hin gammada.<verse eid="PRO 12:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 12:21"/>Nama balchaa rakkinni itti hin dhufu;</para>
  <para style="q2" vid="PRO 12:21">nama hamaa ammoo rakkinni itti bacata.<verse eid="PRO 12:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 12:22"/>Mootiin Waan Maraa afaan dhara dubbatu jibba;</para>
  <para style="q2" vid="PRO 12:22">namoota dhugaammeyyi'itti ammoo hin gammada.<verse eid="PRO 12:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 12:23"/>Nami qalbeeffataan beekkumsa ifii dhoffata;</para>
  <para style="q2" vid="PRO 12:23">namooti gowwaan ammoo</para>
  <para style="q2" vid="PRO 12:23">gowwummaa ifii mudhifatan.<verse eid="PRO 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 12:24"/>Nami jabaatee hujatu bulchaa hin te'a;</para>
  <para style="q2" vid="PRO 12:24">nami boosenni ammoo</para>
  <para style="q2" vid="PRO 12:24">garbicha namaa hin te'a.<verse eid="PRO 12:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 12:25"/>Mami gadhaa namaa keessa yoo jiraate</para>
  <para style="q2" vid="PRO 12:25">gad nama qaba;</para>
  <para style="q2" vid="PRO 12:25">jechi dansaan ammoo nama gammachiisa.<verse eid="PRO 12:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 12:26"/>Nami balchaan karaa namaaf akeeka;</para>
  <para style="q2" vid="PRO 12:26">nami hamaan ammoo karaa irraa nama qaba.<verse eid="PRO 12:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 12:27"/>Nami boosenni foon adamo'oon fideeyyuu</para>
  <para style="q2" vid="PRO 12:27">hin bilcheeffatu;</para>
  <para style="q2" vid="PRO 12:27">nami jabaatee huju ammoo</para>
  <para style="q2" vid="PRO 12:27">waan gatii qabu hin dhaggata.<verse eid="PRO 12:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 12:28"/>Karaa balchumma'aa irra jiru'utti jira;</para>
  <para style="q2" vid="PRO 12:28">daandii san irra duuti hin jirtu.<verse eid="PRO 12:28"/></para>
  <chapter eid="PRO 12"/>
  <chapter number="13" style="c" sid="PRO 13"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 13:1"/>Ilmi qaroon gorsa abbaa ifii hin fudhata;</para>
  <para style="q2" vid="PRO 13:1">ilmi murgaamessi ammoo xixicha hin dhage'u.<verse eid="PRO 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 13:2"/>Nami waan dansaa afaan isaa keessaa bayu irraa,</para>
  <para style="q2" vid="PRO 13:2">waan dansaa dhaggata;</para>
  <para style="q2" vid="PRO 13:2">worri hin addatanne ammoo</para>
  <para style="q2" vid="PRO 13:2">hunnaan nama irratti ka'iisaaf halchan.<verse eid="PRO 13:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3"/>Nami afaan ifii eegatu,</para>
  <para style="q2" vid="PRO 13:3">jiruu ifii eegata;</para>
  <para style="q2" vid="PRO 13:3">ka ifi eegataa hin dubbanne ammoo hin bada.<verse eid="PRO 13:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 13:4"/>Nami boosenni hin halcha malee</para>
  <para style="q2" vid="PRO 13:4">womaa hin dhaggatu;</para>
  <para style="q2" vid="PRO 13:4">nami jabaatee huju ammoo waan halche hin dhaggata.<verse eid="PRO 13:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 13:5"/>Nami balchaan dhara jibba;</para>
  <para style="q2" vid="PRO 13:5">nami hamaan ammoo qaani'ii fi salphinna fida.<verse eid="PRO 13:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 13:6"/>Balchummaan nama yakkaa hin qanne eeddi;</para>
  <para style="q2" vid="PRO 13:6">hammeenni ammoo cubbaalessa balleessa.<verse eid="PRO 13:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 13:7"/>Nami womaa adoo hin qabaatin</para>
  <para style="q2" vid="PRO 13:7">dureessa ifi fakkeessu tokko jira;</para>
  <para style="q2" vid="PRO 13:7">ka dhibiin ammoo qabeenna guddaa adoo qabuu</para>
  <para style="q2" vid="PRO 13:7">hiyyeessa ifi fakkeessu tokko jirra.<verse eid="PRO 13:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 13:8"/>Nami dureessi karra ifiitiin</para>
  <para style="q2" vid="PRO 13:8">jiruu ifii wodatiisa dande'a fa'a te'a;</para>
  <para style="q2" vid="PRO 13:8">nami hiyyeessi ammoo</para>
  <para style="q2" vid="PRO 13:8">karra waan hin qanneef,</para>
  <para style="q2" vid="PRO 13:8">jiruu ifii wodatiisaaf itti hin rakkatu.<verse eid="PRO 13:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 13:9"/>Ifi worra balcha'aa yennaa mara ifa;</para>
  <para style="q2" vid="PRO 13:9">issaan nama hama'aa ammoo hin dhaama.<verse eid="PRO 13:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 13:10"/>Ifi jajiis lola qofa kaasa;</para>
  <para style="q2" vid="PRO 13:10">qarummaan ammoo worra gorsa fudhatu bira jirti.<verse eid="PRO 13:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 13:11"/>Karri ariiti'iin dhaggatane ariifattee baddi;</para>
  <para style="q2" vid="PRO 13:11">ka diqqeessee diqqeessee</para>
  <para style="q2" vid="PRO 13:11">kuufate ammoo itti ede'ata.<verse eid="PRO 13:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 13:12"/>Addiin yennaa turte gadhaa nama gaddisiitti;</para>
  <para style="q2" vid="PRO 13:12">halchaan muummotte ammoo</para>
  <para style="q2" vid="PRO 13:12">midhaan muka jiru'uu ti.<verse eid="PRO 13:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 13:13"/>Nami gorsa tuffatu badii ifi irratti fida;</para>
  <para style="q2" vid="PRO 13:13">nami ajaja ulfeessu</para>
  <para style="q2" vid="PRO 13:13">ammoo gatii irraa dhaggata.<verse eid="PRO 13:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 13:14"/>Barsiisi nama qaro'oo madda jiru'uu ti;</para>
  <para style="q2" vid="PRO 13:14">tiyyoo du'aa irraa nama deebisa.<verse eid="PRO 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 13:15"/>Qalbeeffati dansaan ulfinna namaaf kenniti;</para>
  <para style="q2" vid="PRO 13:15">karaan worra hin addatannee ammoo bu'aa-bayi'i.<verse eid="PRO 13:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 13:16"/>Nami qalbeeffataan beekkumsaan hujata;</para>
  <para style="q2" vid="PRO 13:16">gowwaan ammoo gowwummaa ifii</para>
  <para style="q2" vid="PRO 13:16">badhinnatti mudhisa.<verse eid="PRO 13:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 13:17"/>Ergamaan hamaan rakkoo keessa gala;</para>
  <para style="q2" vid="PRO 13:17">ergamaan addatamaan ammoo nageya buusa.<verse eid="PRO 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 13:18"/>Nama qajeelfama tuffatu</para>
  <para style="q2" vid="PRO 13:18">hiyyumma'aa fi salphinnatti itti dhufa;</para>
  <para style="q2" vid="PRO 13:18">nami xixicha dhage'ee deebi'uu ammoo hin ulfaata.<verse eid="PRO 13:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 13:19"/>Halchaan muummottu namatti mi'ootti;</para>
  <para style="q2" vid="PRO 13:19">gowwooleen ammoo</para>
  <para style="q2" vid="PRO 13:19">waan hantuu irraa deebi'iisa jibban.<verse eid="PRO 13:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 13:20"/>Nami qaroo woliin ideemu qaroo hin te'a;</para>
  <para style="q2" vid="PRO 13:20">waa'elli gowwa'aa ammoo hin farra.<verse eid="PRO 13:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 13:21"/>Wonni hantuun cubbaaleyyii ariiti;</para>
  <para style="q2" vid="PRO 13:21">qananummaan ammoo gatii balcha'aa ti.<verse eid="PRO 13:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 13:22"/>Nami dansaan ijoollee ijoollee ifiitiif</para>
  <para style="q2" vid="PRO 13:22">dhaala lakkisee dabara;</para>
  <para style="q2" vid="PRO 13:22">qabeenni cubbaalessaa ammoo</para>
  <para style="q2" vid="PRO 13:22">balcha'aaf kuufama.<verse eid="PRO 13:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 13:23"/>Fichaan nama hiyyeessaa</para>
  <para style="q2" vid="PRO 13:23">midhaan bacaa kennuu dande'a;</para>
  <para style="q2" vid="PRO 13:23">haqa dhabiisi ammoo haxowee duraa balleessa.<verse eid="PRO 13:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 13:24"/>Nami ilma ifii adabiisa mararfatu ilma ifii jibba;</para>
  <para style="q2" vid="PRO 13:24">ka jaalatu ammoo malaan adabee isa guddisa.<verse eid="PRO 13:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 13:25"/>Nami balchaan haga quufutti nyaata;</para>
  <para style="q2" vid="PRO 13:25">nami hamaan yennaa mara beelota.<verse eid="PRO 13:25"/></para>
  <chapter eid="PRO 13"/>
  <chapter number="14" style="c" sid="PRO 14"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 14:1"/>Dubartiin qaroon mana ifii ijaarratti;</para>
  <para style="q2" vid="PRO 14:1">dubartiin gowwaan ammoo</para>
  <para style="q2" vid="PRO 14:1">harkuma ifiitiin mana ifii diiddi.<verse eid="PRO 14:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 14:2"/>Nami karaa qajeelaa ideemu</para>
  <para style="q2" vid="PRO 14:2">Mootii Waan Maraa sodaata;</para>
  <para style="q2" vid="PRO 14:2">ka karaan isaa micciirama'aa ammoo isa tuffata.<verse eid="PRO 14:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 14:3"/>Nama gowwaa dubbuma isaatitti adabbii isatti fida;</para>
  <para style="q2" vid="PRO 14:3">nama qaroo ammoo afaan isaatitti isa eega.<verse eid="PRO 14:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4"/>Lafa qotiyyoon hin jirre gootaraan duwwaa hin te'a;</para>
  <para style="q2" vid="PRO 14:4">hunna qotiyyo'ootiin ammoo</para>
  <para style="q2" vid="PRO 14:4">midhaan hin bacata.<verse eid="PRO 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 14:5"/>Dhugaa bayaan dhugaammessi hin sobu;</para>
  <para style="q2" vid="PRO 14:5">dhugaa bayaan dharaamessi ammoo dhara dubbata.<verse eid="PRO 14:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 14:6"/>Nami murgaamessi qarummaa hin barbaada;</para>
  <para style="q2" vid="PRO 14:6">garuu hin dhaggatu;</para>
  <para style="q2" vid="PRO 14:6">worra qalbeeffataa ammoo</para>
  <para style="q2" vid="PRO 14:6">beekkumsa dhaggatiisi hin dhibu.<verse eid="PRO 14:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 14:7"/>Afaan isaa irraa</para>
  <para style="q2" vid="PRO 14:7">beekkumsa waan hin dhagganneef,</para>
  <para style="q2" vid="PRO 14:7">nama gowwaa irraa fagaadhu.<verse eid="PRO 14:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 14:8"/>Qarummaan nama qalbeeffata'aa</para>
  <para style="q2" vid="PRO 14:8">karaa irraa akka hin gorre tolchiti;</para>
  <para style="q2" vid="PRO 14:8">gowwummaan nama gowwa'aa</para>
  <para style="q2" vid="PRO 14:8">ammoo karaa irraa gorsiti.<verse eid="PRO 14:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 14:9"/>Gowwooleen ciincaa sababa cubbu'uutiif dhikaatutti murgan;</para>
  <para style="q2" vid="PRO 14:9">odduu worra qajeela'aa ammoo</para>
  <para style="q2" vid="PRO 14:9">fedhii dansa'atti jira.<verse eid="PRO 14:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 14:10"/>Nami martinuu</para>
  <para style="q2" vid="PRO 14:10">gammadaa fi gadda hadhowaa ifii hin beeka;</para>
  <para style="q2" vid="PRO 14:10">ka isa woliin qoodamu hin jiru.<verse eid="PRO 14:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 14:11"/>Manni worra hama'aa hin jiga;</para>
  <para style="q2" vid="PRO 14:11">qe'een worra qajeela'aa ammoo hin badhatti.<verse eid="PRO 14:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 14:12"/>Karaan sirrii namatti fakkaatu jira;</para>
  <para style="q2" vid="PRO 14:12">muummeen isaa ammoo gara du'aa geessa.<verse eid="PRO 14:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 14:13"/>Kolla keessaayyuu gaddi jiraachuu dande'a;</para>
  <para style="q2" vid="PRO 14:13">gammadi gaddaan muummowuu dande'a.<verse eid="PRO 14:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 14:14"/>Nami hamaan gatii hammeenna ifii hin fudhata;</para>
  <para style="q2" vid="PRO 14:14">nami dansaalle gatii hujii dansaa ifii hin fudhata.<verse eid="PRO 14:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 14:15"/>Gowwaan waan mara dhugeeffata;</para>
  <para style="q2" vid="PRO 14:15">qalbeeffataan ammoo ijjata ifii hin ilaallata.<verse eid="PRO 14:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 14:16"/>Nami qaroon waan hantuu sodaatee irraa hin deebi'a;</para>
  <para style="q2" vid="PRO 14:16">nami gowwaan ammoo ifi hin eegatu;</para>
  <para style="q2" vid="PRO 14:16">hin ariifatalle'e.<verse eid="PRO 14:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 14:17"/>Nami dafee aaru waan gadhee huja;</para>
  <para style="q2" vid="PRO 14:17">nami mala namatti dhowu hin jibbatama.<verse eid="PRO 14:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 14:18"/>Nami hin bilchaatin gowwummaa dhaala;</para>
  <para style="q2" vid="PRO 14:18">nami qalbeeffataan beekkumsa</para>
  <para style="q2" vid="PRO 14:18">akka kallachaa keyata.<verse eid="PRO 14:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 14:19"/>Worri hamaan worra dansaa duratti,</para>
  <para style="q2" vid="PRO 14:19">worri cubbaaleyyiin</para>
  <para style="q2" vid="PRO 14:19">karra worra balcha'aa duratti gad hin jedhan.<verse eid="PRO 14:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 14:20"/>Hiyyeessi ollaa ifiitiinuu hin jibbatama;</para>
  <para style="q2" vid="PRO 14:20">dureessi ammoo jaalota hedduu qaba.<verse eid="PRO 14:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 14:21"/>Nami nama tuffatu cubbaalessa;</para>
  <para style="q2" vid="PRO 14:21">nami hiyyeessaaf nayu ka gammade.<verse eid="PRO 14:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 14:22"/>Worri mala hamaa dhowu</para>
  <para style="q2" vid="PRO 14:22">karaa irraa goranii motii ree?</para>
  <para style="q2" vid="PRO 14:22">Worri mala dansaa dhowu ammoo hin jaalataman;</para>
  <para style="q2" vid="PRO 14:22">hin addatamanille'e.<verse eid="PRO 14:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 14:23"/>Jabaatanee hujiis bu'aa qaba;</para>
  <para style="q2" vid="PRO 14:23">oduu callaa odeessiis ammoo</para>
  <para style="q2" vid="PRO 14:23">gara hiyyumma'aa qofa nama geessiti.<verse eid="PRO 14:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 14:24"/>Qananummaan kallacha qaroole'ee ti;</para>
  <para style="q2" vid="PRO 14:24">gowwummaan ammoo seesa gowwoole'ee ti.<verse eid="PRO 14:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 14:25"/>Dhugaa bayaan dhugaammessi jiruu fayyisa;</para>
  <para style="q2" vid="PRO 14:25">dhugaa bayaan dharaamessi ammoo hin soba.<verse eid="PRO 14:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 14:26"/>Nami Mootii Waan Maraa sodaatu</para>
  <para style="q2" vid="PRO 14:26">kushee jadduu qaba;</para>
  <para style="q2" vid="PRO 14:26">ijoollee isaatiifille addee itti baqattu hin teeti.<verse eid="PRO 14:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 14:27"/>Mootii Waan Maraa sodaatiis madda jiru'uu ti;</para>
  <para style="q2" vid="PRO 14:27">tiyyoo du'aa irraa nama deebisa.<verse eid="PRO 14:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 14:28"/>Ulfinni mooti'ii bacinna kolba'aa ti;</para>
  <para style="q2" vid="PRO 14:28">kolbaan yoo hin jiraatin ammoo inni hin bada.<verse eid="PRO 14:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 14:29"/>Nami ossatu hubantii guddoo qaba;</para>
  <para style="q2" vid="PRO 14:29">nami dafee aaru ammoo gowwummaa mudhisa.<verse eid="PRO 14:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 14:30"/>Yaadi nageyaa jiruu nafaaf kenna;</para>
  <para style="q2" vid="PRO 14:30">hinaaffaan ammoo lafee tortorsa.<verse eid="PRO 14:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 14:31"/>Nami hiyyeessa cunqursu</para>
  <para style="q2" vid="PRO 14:31">ka isa dade tuffata;</para>
  <para style="q2" vid="PRO 14:31">ka hiyyeeyyi'iif nayu ammoo</para>
  <para style="q2" vid="PRO 14:31">Waaqaaf ulfinna kenna.<verse eid="PRO 14:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 14:32"/>Nami hamaan hammeenna ifiitiin bada;</para>
  <para style="q2" vid="PRO 14:32">nami balchaan du'a keessalle'etti</para>
  <para style="q2" vid="PRO 14:32">addee itti baqatu qaba.<verse eid="PRO 14:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 14:33"/>Qarummaan gadhaa worra woy hubatuu keessa leeti;</para>
  <para style="q2" vid="PRO 14:33">isiin gadhaa gowwootaa keessatti ammoo hin beekkantu.<verse eid="PRO 14:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 14:34"/>Balchummaan kolbaa ol qaddi;</para>
  <para style="q2" vid="PRO 14:34">cubbuun ammoo kolbuma mara salphitti.<verse eid="PRO 14:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 14:35"/>Mootiin tajaajilaa qaro'otti hin gammada;</para>
  <para style="q2" vid="PRO 14:35">ka isa fokkisiisutti ammoo hin mufata.<verse eid="PRO 14:35"/></para>
  <chapter eid="PRO 14"/>
  <chapter number="15" style="c" sid="PRO 15"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 15:1"/>Deebiin dansaan aarii qabbaneessiti;</para>
  <para style="q2" vid="PRO 15:1">jechi jabaan aarii kakkaasa.<verse eid="PRO 15:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2"/>Arrabi qaro'oo beekkumsa saada;</para>
  <para style="q2" vid="PRO 15:2">afaan gowwa'aa ammoo gowwummaa dubbata.<verse eid="PRO 15:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3"/>Ilti Mootii Waan Maraa addee mara jirti;</para>
  <para style="q2" vid="PRO 15:3">waan hantu'uu fi dansaalle hin dhaggiti.<verse eid="PRO 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4"/>Arrabi dansaan muka jiru'uu ti;</para>
  <para style="q2" vid="PRO 15:4">arrabi dabaan ammoo yaada namaa cassa.<verse eid="PRO 15:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 15:5"/>Gowwaan gorsa abbaa ifii tuffata;</para>
  <para style="q2" vid="PRO 15:5">nami xixicha dhage'u ammoo qarummaa mudhisa.<verse eid="PRO 15:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6"/>Mana nama balcha'aa keessa qabeenna gudda'atti jira;</para>
  <para style="q2" vid="PRO 15:6">bu'aan nami hamaan dhaggatu ammoo</para>
  <para style="q2" vid="PRO 15:6">rakkoo itti fiddi.<verse eid="PRO 15:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7"/>Afaan qaro'oo beekkumsa facaasa;</para>
  <para style="q2" vid="PRO 15:7">qalbiin gowwa'aa ammoo akkasii moti.<verse eid="PRO 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8"/>Mootiin Waan Maraa ciincaa worra hama'aa hin jibba;</para>
  <para style="q2" vid="PRO 15:8">daadimati worra qajeela'aa ammoo</para>
  <para style="q2" vid="PRO 15:8">isa gammachiisa.<verse eid="PRO 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9"/>Mootiin Waan Maraa karaa worra hama'aa hin jibba;</para>
  <para style="q2" vid="PRO 15:9">worra balchummaa gula deemu ammoo hin jaalata.<verse eid="PRO 15:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10"/>Nama daandii irraa goru adabbii jaddu'utti eegata;</para>
  <para style="q2" vid="PRO 15:10">ka xixicha jibbulle hin du'a.<verse eid="PRO 15:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 15:11"/>Addeen worri du'e jiruu fi addeen badi'ii</para>
  <para style="q2" vid="PRO 15:11">Mootii Waan Maraa duratti eega beekkantee,</para>
  <para style="q2" vid="PRO 15:11">gadhaan namaa attam attam</para>
  <para style="q2" vid="PRO 15:11">irra caalaa hin beekkanne ree?<verse eid="PRO 15:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12"/>Nami murgaamessi xixamuu hin jaalatu;</para>
  <para style="q2" vid="PRO 15:12">inni nama qaroolle gorsa hin gaafatu.<verse eid="PRO 15:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13"/>Nami gadhaan isaa gammade fuula ifa;</para>
  <para style="q2" vid="PRO 15:13">nami gadhaan isaa gadde ammoo yaada caba.<verse eid="PRO 15:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14"/>Qalbiin nama hubantii qabuu beekkumsa barbaaddi;</para>
  <para style="q2" vid="PRO 15:14">afaan nama gowwa'aa ammoo</para>
  <para style="q2" vid="PRO 15:14">gowwummaa raama.<verse eid="PRO 15:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 15:15"/>Hiyyeessaaf guyyaan marti hama'a;</para>
  <para style="q2" vid="PRO 15:15">gadhaa gammada qabuuf ammoo</para>
  <para style="q2" vid="PRO 15:15">guyyaan marti jila.<verse eid="PRO 15:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16"/>Qabeenna guddaa hogaa qabuu mannaa,</para>
  <para style="q2" vid="PRO 15:16">qabeenna diqqaa qabaatanee</para>
  <para style="q2" vid="PRO 15:16">Mootii Waan Maraa sodaataa le'iisa woyya.<verse eid="PRO 15:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17"/>Addee jibbi jirutti cooma sanga'aa nyaatiisaa mannaa,</para>
  <para style="q2" vid="PRO 15:17">addee jaalalli jirutti</para>
  <para style="q2" vid="PRO 15:17">shaanaa nyaatiisa woyya.<verse eid="PRO 15:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18"/>Nami dafee aaru lola kaasa;</para>
  <para style="q2" vid="PRO 15:18">nami ossatu ammoo</para>
  <para style="q2" vid="PRO 15:18">lola qabbaneessa.<verse eid="PRO 15:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19"/>Karaan nama booseyaa qore'een cufameera;</para>
  <para style="q2" vid="PRO 15:19">karaan nama qajeela'aa ammoo</para>
  <para style="q2" vid="PRO 15:19">gufuu hin qabu.<verse eid="PRO 15:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20"/>Ilmi qaroon abbaa ifii gammachiisa;</para>
  <para style="q2" vid="PRO 15:20">nami gowwaan ammoo haadha ifii tuffata.<verse eid="PRO 15:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21"/>Nama gowwaa gowwumma'atti gammachiisa;</para>
  <para style="q2" vid="PRO 15:21">nami qaroon ammoo karaa qajeelaa deema.<verse eid="PRO 15:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 15:22"/>Gorsi yoo hin jiraatin karoorri hin milkowu;</para>
  <para style="q2" vid="PRO 15:22">gorsitooti yoo heddatte ammoo</para>
  <para style="q2" vid="PRO 15:22">karoorri hin milkowa.<verse eid="PRO 15:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23"/>Nami deebii malte namaaf deebisiisaan gammada;</para>
  <para style="q2" vid="PRO 15:23">dubbiin yennaa isi'ii maltetti</para>
  <para style="q2" vid="PRO 15:23">dubbatantu attam attam dansa'a!<verse eid="PRO 15:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24"/>Karaan nama qaro'oo addee</para>
  <para style="q2" vid="PRO 15:24">worri du'e jirutti akka inni gad hin buuneef,</para>
  <para style="q2" vid="PRO 15:24">gara jiru'uutitti ol isa geessa.<verse eid="PRO 15:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25"/>Mootiin Waan Maraa mana worra kooruu hin diiga;</para>
  <para style="q2" vid="PRO 15:25">meessaa haadha hiyyeessaa ammoo hin eega.<verse eid="PRO 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 15:26"/>Mootiin Waan Maraa yaada worra hama'aa hin jibba;</para>
  <para style="q2" vid="PRO 15:26">yaadi worra qulqullu'uu ammoo</para>
  <para style="q2" vid="PRO 15:26">isa gammachiisan.<verse eid="PRO 15:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27"/>Nami joljolaan maatii ifii irratti rakkoo fida;</para>
  <para style="q2" vid="PRO 15:27">nami safuu jibbu ammoo hin le'a.<verse eid="PRO 15:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28"/>Gadhaan nama balcha'aa</para>
  <para style="q2" vid="PRO 15:28">deebii kenniisaan dura itti yaada;</para>
  <para style="q2" vid="PRO 15:28">afaan nama hama'aa ammoo dubbii hantuu dubbata.<verse eid="PRO 15:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 15:29"/>Mootiin Waan Maraa nama hamaa irraa fagoo jira;</para>
  <para style="q2" vid="PRO 15:29">daadimata balcha'aa ammoo hin dhage'a.<verse eid="PRO 15:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 15:30"/>Fuulli ifaan gadhaa namaa gammachiisa;</para>
  <para style="q2" vid="PRO 15:30">oduun gammadaa lafee jabeessiti.<verse eid="PRO 15:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31"/>Nami xixicha jiruu kennu caqasu,</para>
  <para style="q2" vid="PRO 15:31">qaroolee odduu hin le'a.<verse eid="PRO 15:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32"/>Nami gorsa tuffatu,</para>
  <para style="q2" vid="PRO 15:32">ifi tuffata;</para>
  <para style="q2" vid="PRO 15:32">nami xixicha dhage'u ammoo</para>
  <para style="q2" vid="PRO 15:32">hubantii dhaggata.<verse eid="PRO 15:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33"/>Mootii Waan Maraa sodaatiis qarummaa nama barsiisa;</para>
  <para style="q2" vid="PRO 15:33">ulfinna dhaggatiisaan dura gad ifi qabiisatti jira.<verse eid="PRO 15:33"/></para>
  <chapter eid="PRO 15"/>
  <chapter number="16" style="c" sid="PRO 16"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1"/>Nami gadhaa ifiititti hin yaadata;</para>
  <para style="q2" vid="PRO 16:1">yaada san guutuu ka dande'u ammoo</para>
  <para style="q2" vid="PRO 16:1">Mootii Waan Maraa qofa.<verse eid="PRO 16:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2"/>Nami akka ifiif ilaalutti</para>
  <para style="q2" vid="PRO 16:2">karaan isaa marti qulqulluu isatti fakkaata;</para>
  <para style="q2" vid="PRO 16:2">yaada gadhaa isaa ammoo</para>
  <para style="q2" vid="PRO 16:2">Mootiin Waan Maraa hin madaala.<verse eid="PRO 16:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3"/>Waan gootu mara</para>
  <para style="q2" vid="PRO 16:3">Mootii Waan Maraatitti magannee kennadhu;</para>
  <para style="q2" vid="PRO 16:3">wonni ati yaaddu marti si'iif hin milkootti.<verse eid="PRO 16:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4"/>Mootiin Waan Maraa waan mara sababa dadeef qaba;</para>
  <para style="q2" vid="PRO 16:4">worra hamaaleyyi'iifille inni guyyaa badi'ii qopheesseera.<verse eid="PRO 16:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5"/>Mootiin Waan Maraa worra kooru hin jibba;</para>
  <para style="q2" vid="PRO 16:5">isaan ijjumaa adabbii jalaa hin bayanu.<verse eid="PRO 16:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6"/>Jaalalaa fi addatamumma'aan</para>
  <para style="q2" vid="PRO 16:6">nama yakkeef araarri godhama;</para>
  <para style="q2" vid="PRO 16:6">Mootii Waan Maraa sodaatiisaan</para>
  <para style="q2" vid="PRO 16:6">nami waan hantuu irraa fagaata.<verse eid="PRO 16:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7"/>Karaan namaa Mootii Waan Maraa yennaa gammachiise,</para>
  <para style="q2" vid="PRO 16:7">diinoti isaatuu isa woliin nageyaan le'an.<verse eid="PRO 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8"/>Qabeenna bacaa</para>
  <para style="q2" vid="PRO 16:8">karaa haqa hin te'iniin dhaggatanuu mannaa,</para>
  <para style="q2" vid="PRO 16:8">qabeenna diqqaa karaa balchumma'aatiin dhaggatanu woyya.<verse eid="PRO 16:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9"/>Nami gadhaa ifii keessatti karoora hin baafata;</para>
  <para style="q2" vid="PRO 16:9">Mootiin Waan Maraa ammoo karoora isaa san hin murteessa.<verse eid="PRO 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10"/>Mootiin akka Mootii Waan Maraa dubbata;</para>
  <para style="q2" vid="PRO 16:10">afaan isaa haqa hin dassu.<verse eid="PRO 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11"/>Madaallii fi safarri sirrii te'e ka Mootii Waan Maraa ti;</para>
  <para style="q2" vid="PRO 16:11">dhakaan madaalli'ii martinuu hujuma isaa ti.<verse eid="PRO 16:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 16:12"/>Barcumaan mootumma'aa</para>
  <para style="q2" vid="PRO 16:12">balchumma'aan waan jabaatuuf,</para>
  <para style="q2" vid="PRO 16:12">moototi hujii hantuu jibbuu qaban.<verse eid="PRO 16:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13"/>Moototi dubbii dhuga'aatitti gammadan;</para>
  <para style="q2" vid="PRO 16:13">nama dhugaa dubbatu jaalatan.<verse eid="PRO 16:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14"/>Mufiin mooti'ii akka ergamaa du'aa ti;</para>
  <para style="q2" vid="PRO 16:14">nami qaroon ammoo mufii hin qabbaneessa.<verse eid="PRO 16:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15"/>Fuulli mooti'ii yennaa ifu jiruun jirti;</para>
  <para style="q2" vid="PRO 16:15">isa biratti fudhatama dhaggatiis</para>
  <para style="q2" vid="PRO 16:15">akka rooba furmaataa ti.<verse eid="PRO 16:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16"/>Worqii dhaggatiisa irra qarummaa dhaggatiis,</para>
  <para style="q2" vid="PRO 16:16">meetii caalaa hubantii filatiis</para>
  <para style="q2" vid="PRO 16:16">attam attam caalti!<verse eid="PRO 16:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17"/>Kolbaan dansaan waan hantuu irraa fagaatti;</para>
  <para style="q2" vid="PRO 16:17">nami karaa ifii eeggatu jiruu ifii eeggata.<verse eid="PRO 16:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18"/>Ifi jajuun badiisatti,</para>
  <para style="q2" vid="PRO 16:18">koorri jigiisatti nama geessa.<verse eid="PRO 16:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19"/>Worra kooru woliin boojuu qoodamiisaa mannaa,</para>
  <para style="q2" vid="PRO 16:19">worra hiyyeeyyii woliin gad ifi qabiisa woyya.<verse eid="PRO 16:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20"/>Nami gorsa dhage'u,</para>
  <para style="q2" vid="PRO 16:20">qananummaa dhaggata;</para>
  <para style="q2" vid="PRO 16:20">nami Mootii Waan Maraa</para>
  <para style="q2" vid="PRO 16:20">addatulle hin gammada.<verse eid="PRO 16:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21"/>Worri qaroon «Qalbeeffattoota» jedhaman;</para>
  <para style="q2" vid="PRO 16:21">dubbiin mi'oottuun beekkumsa namaaf dabalti.<verse eid="PRO 16:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22"/>Qarummaan worra isii qabuuf madda jiru'uu ti;</para>
  <para style="q2" vid="PRO 16:22">gowwummaan ammoo worra gowwa'atti adabbii fiddi.<verse eid="PRO 16:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23"/>Nami qaroon itti yaadatee dubbata;</para>
  <para style="q2" vid="PRO 16:23">dubbiin afaan isaa nama barsiitti.<verse eid="PRO 16:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24"/>Dubbiin dansaan akka nadhii dammaa ti;</para>
  <para style="q2" vid="PRO 16:24">namatti mi'ootti;</para>
  <para style="q2" vid="PRO 16:24">lafee namaatiifille fayyinna kenniti.<verse eid="PRO 16:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25"/>Karaan namatti qajeelaa fakkaatu jira;</para>
  <para style="q2" vid="PRO 16:25">dhuma irratti ammoo gara du'aa geessa.<verse eid="PRO 16:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 16:26"/>Fedhiin sagale'ee akka nami jabaatee huju gooti;</para>
  <para style="q2" vid="PRO 16:26">beeltille huji'itti isa kakkaachi.<verse eid="PRO 16:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27"/>Nami badaan waan hantuu mala dhowa;</para>
  <para style="q2" vid="PRO 16:27">dubbiin isaalle akka ibiddaa nama guddi.<verse eid="PRO 16:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28"/>Nami micciiramaan lola kaasa;</para>
  <para style="q2" vid="PRO 16:28">nami nama hamatu jaalota gargar baasa.<verse eid="PRO 16:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29"/>Nami hunnaan nama irratti ka'u</para>
  <para style="q2" vid="PRO 16:29">ollaa ifii karaa irraa milissa;</para>
  <para style="q2" vid="PRO 16:29">daandii dansaa hin teennelle'etti geessa.<verse eid="PRO 16:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30"/>Nami ilaan qiphifatu hammeenna mala dhowa;</para>
  <para style="q2" vid="PRO 16:30">ka hidhii ciniinnatulle hammeenna yaadata.<verse eid="PRO 16:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31"/>Arriin kallacha ulfinnaa ti;</para>
  <para style="q2" vid="PRO 16:31">isiin jiruu balchumma'aatiin dhagganti.<verse eid="PRO 16:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32"/>Nama hunnaamessaa mannaa,</para>
  <para style="q2" vid="PRO 16:32">nama ossataa woyya;</para>
  <para style="q2" vid="PRO 16:32">nama hunnaan qachaa tokko qabatuu mannaa,</para>
  <para style="q2" vid="PRO 16:32">nama ifi qabatu woyya.<verse eid="PRO 16:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33"/>Murtee godhatiisaaf kolbaan hixaa buufatti;</para>
  <para style="q2" vid="PRO 16:33">waan mara ka murteessu ammoo Mootii Waan Maraa ti.<verse eid="PRO 16:33"/></para>
  <chapter eid="PRO 16"/>
  <chapter number="17" style="c" sid="PRO 17"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1"/>Mana waan nyaatanuun guutamee,</para>
  <para style="q2" vid="PRO 17:1">wol dhaba qabuu mannaa,</para>
  <para style="q2" vid="PRO 17:1">daabboo godduu nageyaa woyya.<verse eid="PRO 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2"/>Tajaajilaan qaroon ilma salphicha irratti bulchaa hin te'a;</para>
  <para style="q2" vid="PRO 17:2">inni obboleeyyan dhaala qoodantu woliin</para>
  <para style="q2" vid="PRO 17:2">akka obboleessaa dhaala hin qoodama.<verse eid="PRO 17:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3"/>Ibiddi worqi'ii fi meetii haga ilaala;</para>
  <para style="q2" vid="PRO 17:3">Mootiin Waan Maraa ammoo</para>
  <para style="q2" vid="PRO 17:3">gadhaa namaa haga ilaala.<verse eid="PRO 17:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4"/>Nami hamaan waan hantuu caqasa;</para>
  <para style="q2" vid="PRO 17:4">nami dharaamessi dubbii dharaamessaa</para>
  <para style="q2" vid="PRO 17:4">miidhassee caqasa.<verse eid="PRO 17:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5"/>Nami worra hiyyeeyyi'itti murgu,</para>
  <para style="q2" vid="PRO 17:5">ka isaan dade arrassa;</para>
  <para style="q2" vid="PRO 17:5">nami badii namaatitti gammadu,</para>
  <para style="q2" vid="PRO 17:5">adoo hin adabamin hin hafu.<verse eid="PRO 17:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6"/>Ilmaan ilmaan isaanii</para>
  <para style="q2" vid="PRO 17:6">maanguddootaaf kallacha isaanii ti;</para>
  <para style="q2" vid="PRO 17:6">worri ijoollee ifiitiif ulfinna isaanii ti.<verse eid="PRO 17:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7"/>Dubbiin dansaan nama gowwa'aaf hin teetu;</para>
  <para style="q2" vid="PRO 17:7">dubbiin dharaa irra caala'aayyuu</para>
  <para style="q2" vid="PRO 17:7">bulcha'aaf hin teetu.<verse eid="PRO 17:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8"/>Safuun nama isii kennuuf akka xano'oo ti;</para>
  <para style="q2" vid="PRO 17:8">addee dhaqanu maratti waan isaaf milkoottu itti fakkaatti.<verse eid="PRO 17:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9"/>Nami yakkaa namaaf araaramu,</para>
  <para style="q2" vid="PRO 17:9">jaala qabaata.</para>
  <para style="q1" vid="PRO 17:9">Nami dubbii dabartetti deddeebi'u ammoo</para>
  <para style="q2" vid="PRO 17:9">jaalota gargar baasa.<verse eid="PRO 17:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10"/>Gowwaan yennaa dhibba dhaanamee</para>
  <para style="q2" vid="PRO 17:10">ka itti dhage'amu caalaa,</para>
  <para style="q2" vid="PRO 17:10">xixichi tokko nama qaroo itti dhage'ama.<verse eid="PRO 17:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11"/>Nami hamaan nama irratti ka'iisa qofa barbaada;</para>
  <para style="q2" vid="PRO 17:11">isa loliisaaf</para>
  <para style="q2" vid="PRO 17:11">ergamaan marartii hin qanne tokko hin ergama.<verse eid="PRO 17:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12"/>Nama gowwaa gowwummaa ifii keessa jirutti</para>
  <para style="q2" vid="PRO 17:12">dhaqiisa mannaa,</para>
  <para style="q2" vid="PRO 17:12">doobbaa<note caller="+" style="f"><char style="fr" closed="false">17:12 </char><char style="fqa" closed="false">Doobbaa: </char><char style="fqa" closed="false">Bineensa iyyaa fakkaatu. </char></note> dhalaa</para>
  <para style="q2" vid="PRO 17:12">ilmeen jalaa fudhatantetti dhaquu woyya.<verse eid="PRO 17:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13"/>Nami waan dansaa isaaf godhaneef,</para>
  <para style="q2" vid="PRO 17:13">waan hantuu yoo deebise,</para>
  <para style="q2" vid="PRO 17:13">wonni hantuun mana isaa irraa hin fagaattu.<verse eid="PRO 17:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14"/>Lola jalqabiis akka bisaan hidha qabame cassee yaa'uu ti;</para>
  <para style="q2" vid="PRO 17:14">tanaaf ati adoo dubbiin hin jalqabin qabbaneessi.<verse eid="PRO 17:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15"/>Nama yakkaamessa bilisa baasiisaa fi</para>
  <para style="q2" vid="PRO 17:15">nama balcha'atti muriisa,</para>
  <para style="q2" vid="PRO 17:15">lamaanuu Mootiin Waan Maraa hin jibba.<verse eid="PRO 17:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16"/>Gowwaan qarummaa</para>
  <para style="q2" vid="PRO 17:16">dhaggatiisaaf eega hin halchinee,</para>
  <para style="q2" vid="PRO 17:16">beeseen inni harka ifiitii qabu</para>
  <para style="q2" vid="PRO 17:16">maan isaaf gooti ree?<verse eid="PRO 17:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17"/>Jaalli yennaa mara si jaalata;</para>
  <para style="q2" vid="PRO 17:17">obboleessille yennaa rakko'ootiif dhalata.<verse eid="PRO 17:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18"/>Nami qalbii hin qanne tokko wolii galtee jabeessiisaaf,</para>
  <para style="q2" vid="PRO 17:18">namaan harka wol dhowata;</para>
  <para style="q2" vid="PRO 17:18">ollaa ifiitiifille wobii dabara.<verse eid="PRO 17:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19"/>Nami lola jaalatu cubbuu jaalata;</para>
  <para style="q2" vid="PRO 17:19">nami ifi jaju badii ifitti waama.<verse eid="PRO 17:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 17:20"/>Nama yaada micciiramaa qabuuf hin milkoottu;</para>
  <para style="q2" vid="PRO 17:20">nami nama sobulle rakkoo keessa seena.<verse eid="PRO 17:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21"/>Ilma gowwaa uumatuun gadda namatti fida;</para>
  <para style="q2" vid="PRO 17:21">abbaan ilma gowwa'aa gammada hin qabu.<verse eid="PRO 17:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22"/>Gadhaan gammadu akka qorsa dansa'aa ti;</para>
  <para style="q2" vid="PRO 17:22">yaadi cabaan ammoo lafee goggossa.<verse eid="PRO 17:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23"/>Nami hamaan haqa dassiisaaf,</para>
  <para style="q2" vid="PRO 17:23">dhossa'aan safuu fudhata.<verse eid="PRO 17:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24"/>Ilti nama qaro'oo gara qarumma'aa ilaalti;</para>
  <para style="q2" vid="PRO 17:24">ilti nama gowwa'aa ammoo gara mara joonjiti.<verse eid="PRO 17:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25"/>Ilmi gowwaan gadda abbaa ifiititti fida;</para>
  <para style="q2" vid="PRO 17:25">haadha isa deettelle jiruu itti hadheessa.<verse eid="PRO 17:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26"/>Nama yakkaa hin qanne adabuun,</para>
  <para style="q2" vid="PRO 17:26">yookiin qondaaltota qajeelummaa isaaniitiif dhaanuun</para>
  <para style="q2" vid="PRO 17:26">dansa'aa moti.<verse eid="PRO 17:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27"/>Nami beekaan dubbii qusata;</para>
  <para style="q2" vid="PRO 17:27">nami hubataalle hin sarma.<verse eid="PRO 17:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28"/>Gowwaanuu yoo cadhise qaroo fakkaata;</para>
  <para style="q2" vid="PRO 17:28">afaan ifiille yoo qabate</para>
  <para style="q2" vid="PRO 17:28">akka hubata'aatitti ilaallama.<verse eid="PRO 17:28"/></para>
  <chapter eid="PRO 17"/>
  <chapter number="18" style="c" sid="PRO 18"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 18:1"/>Nami nama woliin wolii hin galle,</para>
  <para style="q2" vid="PRO 18:1">fedhii ifii qofa gula deemuu barbaada;</para>
  <para style="q2" vid="PRO 18:1">muraa haqaa maraayyuu hin morma.<verse eid="PRO 18:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2"/>Nami gowwaan yaada ifii qofaa</para>
  <para style="q2" vid="PRO 18:2">namatti mudhisuu barbaada malee,</para>
  <para style="q2" vid="PRO 18:2">hubanti'itti hin gammadu.<verse eid="PRO 18:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3"/>Hammeenni yennaa dhufu,</para>
  <para style="q2" vid="PRO 18:3">tuffatamiisille hin dhufa;</para>
  <para style="q2" vid="PRO 18:3">salphinnalle woliin qaani'itti dhufa.<verse eid="PRO 18:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4"/>Dubbiin afaan namaa akka bisaan qile'ee ti;</para>
  <para style="q2" vid="PRO 18:4">maddi qarumma'aa ammoo akka bisaan yaa'uu ti.<verse eid="PRO 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5"/>Nama hama'aaf goluun,</para>
  <para style="q2" vid="PRO 18:5">yookiin nama yakkaa hin qanne</para>
  <para style="q2" vid="PRO 18:5">haqa dhoogguun dansa'aa moti.<verse eid="PRO 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6"/>Haasonni nama gowwa'aa lola isatti kaasa;</para>
  <para style="q2" vid="PRO 18:6">afaan isaalle dhaanamiisa isatti fida.<verse eid="PRO 18:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7"/>Gowwaa dubbii isaatittuu isa balleessa;</para>
  <para style="q2" vid="PRO 18:7">afaanuma isaatittuu akka tiyyo'oo isa qaba.<verse eid="PRO 18:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8"/>Dubbiin nama nama hamatuu</para>
  <para style="q2" vid="PRO 18:8">akka sagalee mi'oottu'uu ti;</para>
  <para style="q2" vid="PRO 18:8">isiin gara qochumaanii gad hin buuti.<verse eid="PRO 18:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9"/>Nami huji'itti booseyu</para>
  <para style="q2" vid="PRO 18:9">obboleessa nama wo balleessuu ti.<verse eid="PRO 18:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10"/>Mootiin Waan Maraa</para>
  <para style="q2" vid="PRO 18:10">akka xelleephoo jaddu'uu ti;</para>
  <para style="q2" vid="PRO 18:10">worri balchooleen</para>
  <para style="q2" vid="PRO 18:10">itti baqatanee bayan.<verse eid="PRO 18:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11"/>Qabeenni dureeyyi'ii isaaniif</para>
  <para style="q2" vid="PRO 18:11">akka qachaa dalleya dhaka'aa jabaa qabuu ti;</para>
  <para style="q2" vid="PRO 18:11">isaan akka dalleya dheera'aatitti</para>
  <para style="q2" vid="PRO 18:11">isa hedatan.<verse eid="PRO 18:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12"/>Badiisa ifiitiin dura nami hin koora;</para>
  <para style="q2" vid="PRO 18:12">ulfinnaan dura ammoo</para>
  <para style="q2" vid="PRO 18:12">gad ifi qabiisatti dhufa.<verse eid="PRO 18:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13"/>Dubbii adoo hin caqasin deebii kennuun,</para>
  <para style="q2" vid="PRO 18:13">gowwumma'a;</para>
  <para style="q2" vid="PRO 18:13">fokko'olle'e.<verse eid="PRO 18:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14"/>Yaadi namaa dhibee hin ossata;</para>
  <para style="q2" vid="PRO 18:14">yaadi yoo cabe ammoo</para>
  <para style="q2" vid="PRO 18:14">eentu isa fayyisuu dande'a ree?<verse eid="PRO 18:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15"/>Qalbiin nama hubata'aa beekkumsa dhaggatti;</para>
  <para style="q2" vid="PRO 18:15">gurri nama qaro'oolle beekkumsa barbaada.<verse eid="PRO 18:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16"/>Kennansi nama isa kennuuf karaa bana;</para>
  <para style="q2" vid="PRO 18:16">fuula worra gugurda'aa dura isa dhikeessa.<verse eid="PRO 18:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17"/>Nami isa mormu dhufee haga isa mormutti,</para>
  <para style="q2" vid="PRO 18:17">nami dura dhufee dubbii ifii yaa'i'itti dhikeeffatu,</para>
  <para style="q2" vid="PRO 18:17">waan sirrii te'e fakkaata.<verse eid="PRO 18:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18"/>Hixaa buufatiis moromaa qabbaneessa;</para>
  <para style="q2" vid="PRO 18:18">wol mormitoota jajjadduu lamaan gargar baasa.<verse eid="PRO 18:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19"/>Obboleessi yakkaan irratti hujame</para>
  <para style="q2" vid="PRO 18:19">qachaa dalleya dhaka'aa qabu caalaa jabaata.</para>
  <para style="q2" vid="PRO 18:19">Moromaan akka danqaraa sibiilaa</para>
  <para style="q2" vid="PRO 18:19">ka karra dalleya dhaka'aa ittiin cufanuu ti.<verse eid="PRO 18:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20"/>Nami bu'aa waan afaan isaa keessaa bayuun quufa;</para>
  <para style="q2" vid="PRO 18:20">dubbii arrabi isaa dubbattelle'een dharraa baya.<verse eid="PRO 18:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21"/>Arrabi hunna du'aa fi jiru'uu qaba;</para>
  <para style="q2" vid="PRO 18:21">worri isa jaalatu bu'aa isaa hin nyaata.<verse eid="PRO 18:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22"/>Nami haadha manaa dhaggatu waan dansaa dhaggata;</para>
  <para style="q2" vid="PRO 18:22">Mootii Waan Maraa biralle'ee fudhatama dhaggata.<verse eid="PRO 18:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23"/>Hiyyeessi marartii dhaggatiisaaf gaafata;</para>
  <para style="q2" vid="PRO 18:23">dureessi ammoo jabeennaan deebii kenna.<verse eid="PRO 18:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24"/>Jaaloti gariin nama balleessiti;</para>
  <para style="q2" vid="PRO 18:24">jaaloti obboleessa caalaa</para>
  <para style="q2" vid="PRO 18:24">namatti dhikaatanulle ammoo hin jiran.<verse eid="PRO 18:24"/></para>
  <chapter eid="PRO 18"/>
  <chapter number="19" style="c" sid="PRO 19"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 19:1"/>Gowwaa dubbii micciiruu mannaa,</para>
  <para style="q2" vid="PRO 19:1">hiyyeessa komii male le'u woyya.<verse eid="PRO 19:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2"/>Beekkumsa adoo hin qabaatin,</para>
  <para style="q2" vid="PRO 19:2">halchaan callaan dansa'aa moti;</para>
  <para style="q2" vid="PRO 19:2">nami akka malee ariifatu karaa irraa gora.<verse eid="PRO 19:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3"/>Nami gowwummaa ifiitiin jiruu ifii balleessa;</para>
  <para style="q2" vid="PRO 19:3">gadhaa ifii keessatti ammoo</para>
  <para style="q2" vid="PRO 19:3">Mootii Waan Maraa komata.<verse eid="PRO 19:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4"/>Durummaan jaala hedduu namaa fiddi;</para>
  <para style="q2" vid="PRO 19:4">hiyyeessi ammoo jaala ifiituu dhaba.<verse eid="PRO 19:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5"/>Nami dharaan dhugaa bayu,</para>
  <para style="q2" vid="PRO 19:5">adoo hin adabamin hin hafu;</para>
  <para style="q2" vid="PRO 19:5">ka dhara dubbatulle adabbii jalaa hin bayu.<verse eid="PRO 19:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6"/>Namooti hedduun qondaaltota duratti</para>
  <para style="q2" vid="PRO 19:6">fudhatama dhaggatiisa barbaadan;</para>
  <para style="q2" vid="PRO 19:6">nama wo namaa kennuufille martinuu jaala.<verse eid="PRO 19:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7"/>Nama hiyyeessa firri isaatuu eega jibbee,</para>
  <para style="q2" vid="PRO 19:7">jaaloti isaa ammoo attam attam</para>
  <para style="q2" vid="PRO 19:7">caalchisanee isa irraa fagaatanu ree!</para>
  <para style="q2" vid="PRO 19:7">Inni kadhataa isaan gula deema,</para>
  <para style="q2" vid="PRO 19:7">isaan ammoo irraa fagaatan.<verse eid="PRO 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8"/>Nami qarummaa qabu lubbuu ifii jaalata;</para>
  <para style="q2" vid="PRO 19:8">nami hubantii jaalatu hin qananooma.<verse eid="PRO 19:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9"/>Nami dharaan dhugaa bayu,</para>
  <para style="q2" vid="PRO 19:9">adoo hin adabamin hin hafu;</para>
  <para style="q2" vid="PRO 19:9">ka dhara dubbatulle hin bada.<verse eid="PRO 19:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10"/>Qananummaan gowwa'aaf hin teetu;</para>
  <para style="q2" vid="PRO 19:10">qondaaltota bulchiisi garbichaaf</para>
  <para style="q2" vid="PRO 19:10">caala'aayyuu attam attam baddu'u!<verse eid="PRO 19:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11"/>Qarummaan ossata namaaf kenniti;</para>
  <para style="q2" vid="PRO 19:11">arraba tuffatanee irra dabariis ulfinna.<verse eid="PRO 19:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12"/>Aariin mooti'ii akka dhangaa dhowiisa neenqaa ti;</para>
  <para style="q2" vid="PRO 19:12">fudhatama isa irraa dhaggatiis ammoo</para>
  <para style="q2" vid="PRO 19:12">akka fixeensa marra irraa ti.<verse eid="PRO 19:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13"/>Ilmi gowwaan abbaa ifiititti badii fida;</para>
  <para style="q2" vid="PRO 19:13">haati manaa dubbattittiin akka bokkeya qacacuu ti.<verse eid="PRO 19:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14"/>Manaa fi durummaa worra irraa dhaalan;</para>
  <para style="q2" vid="PRO 19:14">haati manaa qalbittiin ammoo</para>
  <para style="q2" vid="PRO 19:14">kennansa Mootii Waan Maraa ti.<verse eid="PRO 19:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15"/>Booseyummaan hirriiba hamaa namatti fida;</para>
  <para style="q2" vid="PRO 19:15">nami hujii malee tee'u beelaan rakkata.<verse eid="PRO 19:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16"/>Nami ajaja eegatu jiruu ifii eegata;</para>
  <para style="q2" vid="PRO 19:16">nami karaa Waaqaa tuffatu ammoo hin du'a.<verse eid="PRO 19:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17"/>Nami hiyyeessaaf gadhaa laafu</para>
  <para style="q2" vid="PRO 19:17">akka waan Mootii Waan Maraatiif liqeessee ti;</para>
  <para style="q2" vid="PRO 19:17">Mootiin Waan Maraa gatii isaaf hin kaffala.<verse eid="PRO 19:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18"/>Deebisiisaaf adoo addiin jirtuu,</para>
  <para style="q2" vid="PRO 19:18">ijoollee teeti adabi;</para>
  <para style="q2" vid="PRO 19:18">gad lakkittee akka isaan du'anu hin godhin.<verse eid="PRO 19:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19"/>Nami akka malee aaru tokko</para>
  <para style="q2" vid="PRO 19:19">gatii aarii sanii fudhatuu qaba;</para>
  <para style="q2" vid="PRO 19:19">ati yennaa tokko rakkoo keessaa yoo isa baatte,</para>
  <para style="q2" vid="PRO 19:19">itti deebi'iis keeti ammalle hin hafu.<verse eid="PRO 19:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20"/>Gara duraa qaroo akka teetuuf,</para>
  <para style="q2" vid="PRO 19:20">gorsa caqasi;</para>
  <para style="q2" vid="PRO 19:20">qajeelfama fudhadhu.<verse eid="PRO 19:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21"/>Gadhaa namaa keessa Yaada heddu'utti jira;</para>
  <para style="q2" vid="PRO 19:21">ka te'u ammoo yaada Mootii Waan Maraa qofa.<verse eid="PRO 19:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22"/>Wonni nami barbaadu jaalala bara baraa ti;</para>
  <para style="q2" vid="PRO 19:22">dharaamessa te'iisaa mannaa,</para>
  <para style="q2" vid="PRO 19:22">hiyyeessa te'uu woyya.<verse eid="PRO 19:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23"/>Mootii Waan Maraa sodaatiis</para>
  <para style="q2" vid="PRO 19:23">gara jiru'uu nama geessa;</para>
  <para style="q2" vid="PRO 19:23">nami Mootii Waan Maraa sodaatu gabbi jedhee le'a;</para>
  <para style="q2" vid="PRO 19:23">wonni hantuulle isa hin tuxxu.<verse eid="PRO 19:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24"/>Nami booseyi harka ifii qorii keessa hin keya;</para>
  <para style="q2" vid="PRO 19:24">gara afaan ifiituu hin deebifatu.<verse eid="PRO 19:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25"/>Nama murgu dhaani;</para>
  <para style="q2" vid="PRO 19:25">nami gowwaalle qarummaa hin barata;</para>
  <para style="q2" vid="PRO 19:25">nama hubataa xixi innille beekkumsa hin dhaggata.<verse eid="PRO 19:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26"/>Ka abbaa ifii saamu,</para>
  <para style="q2" vid="PRO 19:26">haadha ifiille ka manaa ari'u,</para>
  <para style="q2" vid="PRO 19:26">ilma fokko'oo fi salphinna fidu.<verse eid="PRO 19:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27"/>Ilma kiyya,</para>
  <para style="q2" vid="PRO 19:27">ati yoo gorsa kiyya dhage'iisa lakkitte,</para>
  <para style="q2" vid="PRO 19:27">waan beettuuyyuu irraa badda.<verse eid="PRO 19:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28"/>Dhugaa bayaan dharaa haqa irratti murga;</para>
  <para style="q2" vid="PRO 19:28">afaan nama hama'aa waan hantuu gad liqinsa.<verse eid="PRO 19:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29"/>Worra murguuf muraan,</para>
  <para style="q2" vid="PRO 19:29">worra gowwa'aaf dhaanichi qophoweera.<verse eid="PRO 19:29"/></para>
  <chapter eid="PRO 19"/>
  <chapter number="20" style="c" sid="PRO 20"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 20:1"/>Daadhiin woyni'ii murgaamessa,</para>
  <para style="q2" vid="PRO 20:1">untoon jadduun xeenxiraa nama gooti;</para>
  <para style="q2" vid="PRO 20:1">nami isaan kanaan dokonkore qaro'oo moti.<verse eid="PRO 20:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2"/>Aariin mooti'ii akka neenqa dhangaa dhowuu ti;</para>
  <para style="q2" vid="PRO 20:2">nami isa aarsulle jiruu ifii dhaba.<verse eid="PRO 20:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3"/>Wol dhaba irraa fagaatiis ulfinna namaaf kenna;</para>
  <para style="q2" vid="PRO 20:3">gowwaan yennaa mara lola kaasa.<verse eid="PRO 20:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4"/>Nami booseyi yenna'aan hin qotatu;</para>
  <para style="q2" vid="PRO 20:4">yennaa midhaan galfatanu inni midhaan barbaada,</para>
  <para style="q2" vid="PRO 20:4">ammoo womaa hin dhaggatu.<verse eid="PRO 20:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5"/>Yaadi gadhaa namaa akka bisaan qilee keessaa ti;</para>
  <para style="q2" vid="PRO 20:5">nami qalbii qabu ammoo</para>
  <para style="q2" vid="PRO 20:5">achi keessaa hin woraabbata.<verse eid="PRO 20:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6"/>Nami hedduun, «Nuuti worra addatama'a» ifiin jedhan;</para>
  <para style="q2" vid="PRO 20:6">nama addatamaa ammoo eentu dhaggatuu dande'a?<verse eid="PRO 20:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7"/>Nami balchaan komii malee le'a;</para>
  <para style="q2" vid="PRO 20:7">ijoolleen isa gula ideentulle ta hiree dansaa qaddu.<verse eid="PRO 20:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8"/>Mootiin barcumaa mura'aa irra tee'eeru,</para>
  <para style="q2" vid="PRO 20:8">iluma ifiitiin waan hantuu ilaalee beeka.<verse eid="PRO 20:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9"/>Eennutti, «Ani gadhaa kiyya qulqulleeffadheera;</para>
  <para style="q2" vid="PRO 20:9">ani cubbuu hin qabu» jedhuu dande'a ree?<verse eid="PRO 20:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10"/>Mootiin Waan Maraa madaala sirrii hin te'inii fi</para>
  <para style="q2" vid="PRO 20:10">safara sirrii hin te'in jibba.<verse eid="PRO 20:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11"/>Ijoolleenuu qulqulloota akka te'ane,</para>
  <para style="q2" vid="PRO 20:11">sirrii te'uu isaaniille,</para>
  <para style="q2" vid="PRO 20:11">hujii ifiitiin hin beekkaman.<verse eid="PRO 20:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12"/>Gurra dhage'uu fi ila dhaggitu,</para>
  <para style="q2" vid="PRO 20:12">lachuu ka dade Mootii Waan Maraa ti.<verse eid="PRO 20:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13"/>Akka hin hiyyoommane,</para>
  <para style="q2" vid="PRO 20:13">hirriiba hin jaalatin.</para>
  <para style="q2" vid="PRO 20:13">Midhaan akka quuttu,</para>
  <para style="q2" vid="PRO 20:13">dammaqii hujadhu.<verse eid="PRO 20:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14"/>Nami woy bitatu,</para>
  <para style="q2" vid="PRO 20:14">«Wonni kun baddu'u, wonni kun baddu'u» jedha;</para>
  <para style="q2" vid="PRO 20:14">bitateen duuba, «Dansaa bitadhe» jedhee ifi jaja.<verse eid="PRO 20:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15"/>Worqi'ii fi dooqi baca'atti jira;</para>
  <para style="q2" vid="PRO 20:15">afaan dubbii beekkumsaa dubbatu ammoo,</para>
  <para style="q2" vid="PRO 20:15">akka dhakaa gatii guddo'oo ti.<verse eid="PRO 20:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16"/>Nama alaga'aaf wobii te'e woyaa irraa mulqadhu;</para>
  <para style="q2" vid="PRO 20:16">marroo nama alagaa sanii woyaa isaa qabadhu.<verse eid="PRO 20:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17"/>Sagaleen hannaan dhaggante namatti hin mi'ootti;</para>
  <para style="q2" vid="PRO 20:17">duubarra ammoo akka maansa afaan nama guutee teeti.<verse eid="PRO 20:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18"/>Gorsa fudhadhuu karoora baafadhu;</para>
  <para style="q2" vid="PRO 20:18">qajeelfama fudhadhuu duuli.<verse eid="PRO 20:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19"/>Nami hamatu dhossaa mudhisa;</para>
  <para style="q2" vid="PRO 20:19">tanaaf nama dubbii baceessu irraa fagaadhu.<verse eid="PRO 20:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20"/>Nami abba'aa fi haadha ifii abaaru,</para>
  <para style="q2" vid="PRO 20:20">akka issaa dukkana duudduu keessatti dhaamee hin te'a.<verse eid="PRO 20:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21"/>Qabeenni jalqaba irratti</para>
  <para style="q2" vid="PRO 20:21">dafee dhaalaan dhufu,</para>
  <para style="q2" vid="PRO 20:21">dhuma irratti eebba hin qabu.<verse eid="PRO 20:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22"/>Nami si irratti waan hantuu yoo huje,</para>
  <para style="q2" vid="PRO 20:22">«Anille deebisee waan hantuu irratti huja» hin jedhin;</para>
  <para style="q2" vid="PRO 20:22">Mootiin Waan Maraa si baasaa,</para>
  <para style="q2" vid="PRO 20:22">isa eegadhu.<verse eid="PRO 20:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23"/>Mootiin Waan Maraa madaala sirrii hin te'in hin jibba;</para>
  <para style="q2" vid="PRO 20:23">safari sirrii hin te'inille isa hin gammachiisu.<verse eid="PRO 20:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24"/>Ijjata namaa ka qajeelchu</para>
  <para style="q2" vid="PRO 20:24">Mootii Waan Maraa ti;</para>
  <para style="q2" vid="PRO 20:24">nami karaa ifii attam beekuu dande'a ree?<verse eid="PRO 20:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 20:25"/>Nami tokko adoo itti hin yaadin,</para>
  <para style="q2" vid="PRO 20:25">Waaqaaf waadaa galee,</para>
  <para style="q2" vid="PRO 20:25">duuba irra yoo gaabbe,</para>
  <para style="q2" vid="PRO 20:25">tiyyoo seeniisa.<verse eid="PRO 20:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26"/>Mootiin qaroon worra hamaa miidhassee beeka;</para>
  <para style="q2" vid="PRO 20:26">inni marartii malee isaan hin adaba.<verse eid="PRO 20:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27"/>Mootiin Waan Maraa qalbii namaa hin ilaala;</para>
  <para style="q2" vid="PRO 20:27">keessa namaalle hin qorqora.<verse eid="PRO 20:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28"/>Mararti'ii fi addatamummaan nageyaan mootii eegan;</para>
  <para style="q2" vid="PRO 20:28">barcumaan mootummaa isaa</para>
  <para style="q2" vid="PRO 20:28">addatamumma'aan jabaatee dhaabbata.<verse eid="PRO 20:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29"/>Ulfinni dargaggootaa jabeenna isaanii ti;</para>
  <para style="q2" vid="PRO 20:29">ulfinni maanguddootaalle arrii isaanii ti.<verse eid="PRO 20:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30"/>Adabbiin madeessitu waan hantuu qulqulleessiti;</para>
  <para style="q2" vid="PRO 20:30">dhaaniisille keessa namaa qulqulleessa.<verse eid="PRO 20:30"/></para>
  <chapter eid="PRO 20"/>
  <chapter number="21" style="c" sid="PRO 21"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 21:1"/>Yaadi mooti'ii harka Mootii Waan Maraa keessa jira;</para>
  <para style="q2" vid="PRO 21:1">inni akka bisaan yaa'uu gara fedhe isa deebisa.<verse eid="PRO 21:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2"/>Namatti hujiin inni huju martinuu</para>
  <para style="q2" vid="PRO 21:2">sirrii isatti fakkaatti;</para>
  <para style="q1" vid="PRO 21:2">Mootiin Waan Maraa ammoo</para>
  <para style="q2" vid="PRO 21:2">yaada isaa hin madaala.<verse eid="PRO 21:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3"/>Balchumma'aa fi haqa hujuun,</para>
  <para style="q2" vid="PRO 21:3">ciincaa caalaa Mootii Waan Maraa biratti</para>
  <para style="q2" vid="PRO 21:3">fudhatama qaba.<verse eid="PRO 21:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4"/>Ifi jajiis, bondhooriisii fi</para>
  <para style="q2" vid="PRO 21:4">hujiin worra hamaaleyyi'ii cubbu'u.<verse eid="PRO 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5"/>Karoorri worra jabaatee hujuu bu'aa buusa;</para>
  <para style="q2" vid="PRO 21:5">jarjarri ammoo gara hiyyu'uu nama geessa.<verse eid="PRO 21:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6"/>Karri arraba sobaatiin horatane,</para>
  <para style="q2" vid="PRO 21:6">akkuma hurrii takkumaan gara gorte dhabanuu tii fi</para>
  <para style="q2" vid="PRO 21:6">akkuma tiyyoo nama ijjeettuu ti.<verse eid="PRO 21:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7"/>Namooti hamaaleyyiin</para>
  <para style="q2" vid="PRO 21:7">waan sirrii te'e hujuu waan jibbanuuf,</para>
  <para style="q2" vid="PRO 21:7">hunnaan nama irratti ka'iis isaanii</para>
  <para style="q2" vid="PRO 21:7">haxowee isaan hin baleessa.<verse eid="PRO 21:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8"/>Karaan worra yakkaa hujuu micciirama'a;</para>
  <para style="q2" vid="PRO 21:8">karaan worra yakkaa hin qannee ammoo qajeela'a.<verse eid="PRO 21:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9"/>Niitii dubbatittii woliin le'iisaa mannaa,</para>
  <para style="q2" vid="PRO 21:9">roga heellichoo manaa irra le'uu woyya.<verse eid="PRO 21:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10"/>Nami hamaan waan hantuu halcha;</para>
  <para style="q2" vid="PRO 21:10">eennulle'eef marartii hin qabu.<verse eid="PRO 21:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11"/>Nami murgu yennaa adabamu,</para>
  <para style="q2" vid="PRO 21:11">nami gowwaan qarummaa dhaggata;</para>
  <para style="q2" vid="PRO 21:11">nama qaroo yennaa barsiisane,</para>
  <para style="q2" vid="PRO 21:11">beekkumsa dhaggata.<verse eid="PRO 21:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12"/>Waaqi balchaan,</para>
  <para style="q2" vid="PRO 21:12">waan mana worra hama'aa keessatti</para>
  <para style="q2" vid="PRO 21:12">hujamiisatti jiru hin beeka;</para>
  <para style="q2" vid="PRO 21:12">worra hamaa san badii itti hin fida.<verse eid="PRO 21:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13"/>Hiyyeessa rakkatee iyyuuf nami hin dhageenne,</para>
  <para style="q2" vid="PRO 21:13">innille rakkattee yennaa iyyu,</para>
  <para style="q2" vid="PRO 21:13">nama isa qarqaaru hin dhaggatu.<verse eid="PRO 21:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14"/>Kennansi dhossa'aan kenname aarii caffachiisa;</para>
  <para style="q2" vid="PRO 21:14">safuun dhossa'aan harka keessa keyanulle,</para>
  <para style="q2" vid="PRO 21:14">aarii guddoo hin qabbaneessa.<verse eid="PRO 21:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15"/>Haqi yennaa hujamu,</para>
  <para style="q2" vid="PRO 21:15">worra balchoota hin gammachiisa;</para>
  <para style="q2" vid="PRO 21:15">worra waan hantuu huju ammoo hin bararassa.<verse eid="PRO 21:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16"/>Nami karaa hubanti'ii irraa goru,</para>
  <para style="q2" vid="PRO 21:16">yaa'ii worra du'ee keessa bu'a.<verse eid="PRO 21:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17"/>Nami qananummaa jaalatu hin hiyyoommata;</para>
  <para style="q2" vid="PRO 21:17">nami daadhii woyni'iitii fi carree jaalatu ijjumaa hin duroommatu.<verse eid="PRO 21:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18"/>Nami hamaan farra nama balcha'aaf qopheessetti,</para>
  <para style="q2" vid="PRO 21:18">nami hin addatannelle</para>
  <para style="q2" vid="PRO 21:18">farra nama qajeela'aaf qopheessetti hin gala.<verse eid="PRO 21:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 21:19"/>Niitii dubbatittii aartu woliin le'iisa mannaa,</para>
  <para style="q2" vid="PRO 21:19">goomolee keessa le'iisa woyya.<verse eid="PRO 21:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20"/>Nami qaroon qabeenna gatii guddo'ootii fi zayitii ejersaa mana ifii keessatti kuufata;</para>
  <para style="q2" vid="PRO 21:20">nami gowwaan waan qabu mara balleessa.<verse eid="PRO 21:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21"/>Nami balchumma'aa fi jaalala hordofu,</para>
  <para style="q2" vid="PRO 21:21">jiruu, balchumma'aa fi ulfinna hin dhaggata.<verse eid="PRO 21:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22"/>Nami qaroon qachaa worra jajjaba'aa hin qabata;</para>
  <para style="q2" vid="PRO 21:22">kushee isaan itti addatanulle hin diiga.<verse eid="PRO 21:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23"/>Nami afaan ifiitii fi arraba ifii eegatu,</para>
  <para style="q2" vid="PRO 21:23">rakkinna irraa ifi eegata.<verse eid="PRO 21:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24"/>Nami kooruu fi hunnaan nama irratti ka'u,</para>
  <para style="q2" vid="PRO 21:24">«Ka namatti murgu» jedhama;</para>
  <para style="q2" vid="PRO 21:24">inni kooraan guutameera.<verse eid="PRO 21:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25"/>Harki isaa hujii waan jibbuuf,</para>
  <para style="q2" vid="PRO 21:25">nami booseyi kajeella'aan du'a.<verse eid="PRO 21:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26"/>Inni guyyaa guutuu kajeela;</para>
  <para style="q2" vid="PRO 21:26">nami balchaan ammoo</para>
  <para style="q2" vid="PRO 21:26">harka keessa adoo hin qabatin kenna.<verse eid="PRO 21:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27"/>Mootiin Waan Maraa ciincaa nama hama'aa jibba;</para>
  <para style="q2" vid="PRO 21:27">yennaa nami yaada hama'aan kennu fa'a irraa caalaa jibba.<verse eid="PRO 21:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28"/>Dhugaa bayi dharaamessaa hin baddi;</para>
  <para style="q2" vid="PRO 21:28">dhugaa bayi dhugaamessaa ammoo</para>
  <para style="q2" vid="PRO 21:28">haga bara baraa hin jiraatti.<verse eid="PRO 21:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29"/>Nami hamaan mataa jabaata;</para>
  <para style="q2" vid="PRO 21:29">nami qajeelaan ammoo marroo</para>
  <para style="q2" vid="PRO 21:29">hujii ifii itti yaadata.<verse eid="PRO 21:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30"/>Qarummaan, hubanti'ii fi</para>
  <para style="q2" vid="PRO 21:30">karoorri Mootii Waan Maraa</para>
  <para style="q2" vid="PRO 21:30">ifi irraa dhooggatiisa dandeessittu hin jirtu.<verse eid="PRO 21:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31"/>Guyyaa lolaatiif farda hin qopheeffatan;</para>
  <para style="q2" vid="PRO 21:31">ka nama injifachiisu ammoo Mootii Waan Maraa ti.<verse eid="PRO 21:31"/></para>
  <chapter eid="PRO 21"/>
  <chapter number="22" style="c" sid="PRO 22"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 22:1"/>Durummaa guddo'oo mannaa, maqaa dansaa woyya;</para>
  <para style="q2" vid="PRO 22:1">meeti'ii fi worqii caalaa</para>
  <para style="q2" vid="PRO 22:1">fudhatama qabaachuu woyya.<verse eid="PRO 22:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2"/>Isaan lamaanuu ka dade,</para>
  <para style="q2" vid="PRO 22:2">Mootii Waan Maraa waan te'eef,</para>
  <para style="q2" vid="PRO 22:2">dureessii fi hiyyeessi wol qixxe'e.<verse eid="PRO 22:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3"/>Nami qalbeeffataan balaa dhaggee dhokata;</para>
  <para style="q2" vid="PRO 22:3">nami gowwaan ammoo ittuma ideemee rakkata.<verse eid="PRO 22:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4"/>Gad ifi qabiisii fi Mootii Waan Maraa sodaatiis</para>
  <para style="q2" vid="PRO 22:4">karra, ulfinnaa fi jiruu namaaf kennan.<verse eid="PRO 22:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5"/>Karaa namoota hama'aa keessa qore'ee fi tiyyo'otti jira;</para>
  <para style="q2" vid="PRO 22:5">nami ifi eegatu ammoo irraa fagaata.<verse eid="PRO 22:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6"/>Ijoollee karaa sirri'ii barsiisi;</para>
  <para style="q2" vid="PRO 22:6">yennaa dulloomanelle isaan</para>
  <para style="q2" vid="PRO 22:6">karaa san irraa hin goranu.<verse eid="PRO 22:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7"/>Dureessi hiyyeessa bulcha;</para>
  <para style="q2" vid="PRO 22:7">ka liqeeffatulle ka liqeessuuf tajaajila'a.<verse eid="PRO 22:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8"/>Nami hammeenna facaasu rakkoo haammata;</para>
  <para style="q2" vid="PRO 22:8">uleen aarii isaalle hin baddi.<verse eid="PRO 22:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9"/>Sagalee ifii hiyyeeyyii woliin waan qoodamuuf,</para>
  <para style="q2" vid="PRO 22:9">nami arjaan hin eebbifama.<verse eid="PRO 22:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10"/>Nama murgu gad baasi;</para>
  <para style="q2" vid="PRO 22:10">wol dhabille hin baya;</para>
  <para style="q2" vid="PRO 22:10">lolli, arrabille hin jiraatu.<verse eid="PRO 22:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11"/>Nami yaada qullu'uu fi dubbii qulluu jaalatu,</para>
  <para style="q2" vid="PRO 22:11">jaala mooti'ii hin te'a.<verse eid="PRO 22:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12"/>Ilti Mootii Waan Maraa beekkumsa eeddi;</para>
  <para style="q2" vid="PRO 22:12">dubbii worra hin addatannee ammoo inni hin balleessa.<verse eid="PRO 22:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13"/>Nami booseyi, «Neenqi ala jira!</para>
  <para style="q2" vid="PRO 22:13">Yookiin ani karaa irratti hin du'a» jedha.<verse eid="PRO 22:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14"/>Afaan dubartii gaarayyeeffattu'uu akka boolla qile'ee ti;</para>
  <para style="q2" vid="PRO 22:14">nami Mootii Waan Maraa abaare isii keessa bu'a.<verse eid="PRO 22:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15"/>Gowwummaan yaada ijoolle'ee qabatteerti;</para>
  <para style="q2" vid="PRO 22:15">uleen xixxa'aa ammoo gowwummaa isaan irraa hin fageessiti.<verse eid="PRO 22:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16"/>Nami durummaa ede'atiisaaf hiyyeessa cunqursu,</para>
  <para style="q2" vid="PRO 22:16">ka dureessaaf kennansa kennulle lamaanuu hin hiyyoommatan.<verse eid="PRO 22:16"/></para>
  <para style="s1">Jecha Qaro'oo</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 22:17"/>Gurra keeti itti qabadhuutii,</para>
  <para style="q2" vid="PRO 22:17">Waan qaroon jedhu caqasi!</para>
  <para style="q2" vid="PRO 22:17">Gadhaa keeti gara barsiisa kiyyaa deebifadhu!<verse eid="PRO 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18"/>Isiin dansaa waan teeteef, gadhaa keetitti qabadhuutii,</para>
  <para style="q2" vid="PRO 22:18">yennaa mara marroo isi'ii dubbadhu.<verse eid="PRO 22:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19"/>Akka ati Mootii Waan Maraatitti addattuuf,</para>
  <para style="q2" vid="PRO 22:19">ani adha si barsiisa.<verse eid="PRO 22:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20"/>Jechoota gorsaatii fi beekkumsaa</para>
  <para style="q2" vid="PRO 22:20">soddoma ani si'iif hin barreessinee ree?<verse eid="PRO 22:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21"/>Worra si erguuf deebii dhuga'aa akka deebittuuf,</para>
  <para style="q2" vid="PRO 22:21">dhuga'aa fi jecha dhuga'aa ani si hin barsiinnee ree?<verse eid="PRO 22:21"/></para>
  <para style="s1">Tokkeessoo</para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22"/>Worra hiyyeeyyii waan hiyyeeyyii te'aneef hin saamin;</para>
  <para style="q2" vid="PRO 22:22">worra rakkataa addee mura'aatitti hin farrisiisin.<verse eid="PRO 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23"/>Mootiin Waan Maraa isaaniif waan falmatuuf,</para>
  <para style="q2" vid="PRO 22:23">nama isaan saamu hin saama.<verse eid="PRO 22:23"/></para>
  <para style="s1">Lammeessoo</para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24"/>Nama aarammeessa jaala hin godhatin;</para>
  <para style="q2" vid="PRO 22:24">nama dafee aarutti hin maxxanin.<verse eid="PRO 22:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25"/>Ati isa irraa barattee,</para>
  <para style="q2" vid="PRO 22:25">tiyyoo isaa keessa seenta fa'a.<verse eid="PRO 22:25"/></para>
  <para style="s1">Sadeessoo</para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26"/>Nama waada'aaf harka namaa dhowu,</para>
  <para style="q2" vid="PRO 22:26">yookiin liqa'aaf wobii dabaru hin te'in.<verse eid="PRO 22:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27"/>Ati waan kaffaltuu yoo dhadde,</para>
  <para style="q2" vid="PRO 22:27">itilleen teeti si jalaa hin fuudhatanti.<verse eid="PRO 22:27"/></para>
  <para style="s1">Arfeessoo</para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28"/>Dhakaa meessa'aa ka durii ka abbootiin durii dhaabane adde'ee hin munyuussin.<verse eid="PRO 22:28"/></para>
  <para style="s1">Shaneessoo</para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29"/>Ati nama hujii ifiitiin leenji'eeru dhaggiteertaa?</para>
  <para style="q2" vid="PRO 22:29">Inni mootota dura tajaajila malee,</para>
  <para style="q2" vid="PRO 22:29">nama mara dura hin tajaajilu.<verse eid="PRO 22:29"/></para>
  <chapter eid="PRO 22"/>
  <chapter number="23" style="c" sid="PRO 23"/>
  <para style="s1">Jayeessoo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 23:1"/>Sagalee nyaatiisaaf bulchaa woliin yennaa teettu,</para>
  <para style="q2" vid="PRO 23:1">waan si dura jirtu san hubadhuu ilaali.<verse eid="PRO 23:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2"/>Nyaatiisaaf dharraa guddoo yoo qabaattelle,</para>
  <para style="q2" vid="PRO 23:2">ifi qabadhu.<verse eid="PRO 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3"/>Sagaleen sun waan si sodduuf,</para>
  <para style="q2" vid="PRO 23:3">mi'aan isi'ii si hin joljolsin.<verse eid="PRO 23:3"/></para>
  <para style="s1">Torbeessoo</para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4"/>Duroomiisaaf jettee akka malee hin elowin;</para>
  <para style="q2" vid="PRO 23:4">ifi qabatiisaaf qarummaa qabaadhu.<verse eid="PRO 23:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5"/>Durummaan akka risaa koolaan ka'uu,</para>
  <para style="q2" vid="PRO 23:5">haga lipheettii ilaatitti,</para>
  <para style="q2" vid="PRO 23:5">nama duraa baduu hin dandeetti.<verse eid="PRO 23:5"/></para>
  <para style="s1">Saddeetessoo</para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6"/>Sagalee nama donnaa hin nyaatin;</para>
  <para style="q2" vid="PRO 23:6">mi'aan isi'ii si hin joljolsin.<verse eid="PRO 23:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7"/>Inni akka nama yennaa mara marroo gatii sagaleen sun baachu yaaduu ti;</para>
  <para style="q2" vid="PRO 23:7">inni afaaniin, «Nyaadhu; uni» siin jedha;</para>
  <para style="q2" vid="PRO 23:7">gadhaan isaa ammoo si woliin hin jiru.<verse eid="PRO 23:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8"/>Diqqoo nyaatteeyyuu hin diddidda;</para>
  <para style="q2" vid="PRO 23:8">dubbii galataa teetille hin balleessita.<verse eid="PRO 23:8"/></para>
  <para style="s1">Sagaleessoo</para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9"/>Inni dubbii qarumma'aa teetitti waan murguuf,</para>
  <para style="q2" vid="PRO 23:9">gowwa'atti hin dubbatin.<verse eid="PRO 23:9"/></para>
  <para style="s1">Kudhaneessoo</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10"/>Dhakaa meessa'aa ka durii adde'ee hin munyuussin</para>
  <para style="q2" vid="PRO 23:10">yookiin fichaa ijoollee abbaa hin qannee</para>
  <para style="q2" vid="PRO 23:10">meessaa hin dabarin.<verse eid="PRO 23:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 23:11"/>Waaqi isaan wodu jabaa waan te'eef,</para>
  <para style="q2" vid="PRO 23:11">inni isaaniif hin falmata.<verse eid="PRO 23:11"/></para>
  <para style="s1">Kudhanii Tokkeessoo</para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12"/>Qalbii teeti gara gorsaa,</para>
  <para style="q2" vid="PRO 23:12">gurra keetille gara beekkumsaa deebifadhu.<verse eid="PRO 23:12"/></para>
  <para style="s1">Kudhanii Lammeessoo</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13"/>Ijoollee teeti adabiisa hin lakkisin;</para>
  <para style="q2" vid="PRO 23:13">kuta'aan yoo dhaante isaan hin du'anu.<verse eid="PRO 23:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14"/>Ati yoo kuta'aan isaan dhaante,</para>
  <para style="q2" vid="PRO 23:14">lubbuu isaanii du'a irraa hin hamburta.<verse eid="PRO 23:14"/></para>
  <para style="s1">Kudhanii Sadeessoo</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15"/>Ilma kiyya, ati qaroo yoo teete,</para>
  <para style="q2" vid="PRO 23:15">gadhaan kiyya hin gammada.<verse eid="PRO 23:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16"/>Yennaa afaan keeti waan sirrii te'e dubbatu,</para>
  <para style="q2" vid="PRO 23:16">keessi kiyya guddoo gammada.<verse eid="PRO 23:16"/></para>
  <para style="s1">Kudhanii Arfeessoo</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17"/>Yennaa mara Mootii Waan Maraa</para>
  <para style="q2" vid="PRO 23:17">sodaatiisaaf hinaaf malee,</para>
  <para style="q2" vid="PRO 23:17">cubbaaleyyi'itti hin hinaafin.<verse eid="PRO 23:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18"/>Dhugumaan ati gara fuula duraa addii qadda;</para>
  <para style="q2" vid="PRO 23:18">addiin teetille hin baddu.<verse eid="PRO 23:18"/></para>
  <para style="s1">Kudhanii Shaneessoo</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19"/>Ilma kiyya, caqasi;</para>
  <para style="q2" vid="PRO 23:19">qaroolle te'i;</para>
  <para style="q2" vid="PRO 23:19">qalbii teetille daandii qajeelaa irratti eegadhu.<verse eid="PRO 23:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20"/>Worra daadhii woyni'ii akka malee unuu fi</para>
  <para style="q2" vid="PRO 23:20">worra foon akka malee nyaatu woliin hin jaalomin.<verse eid="PRO 23:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21"/>Worri machowuu fi worri gadhitoon hin hiyyoommatan;</para>
  <para style="q2" vid="PRO 23:21">hirriibi hamaan isaaniille woyaa ciccittuu isaanitti hin uffisa.<verse eid="PRO 23:21"/></para>
  <para style="s1">Kudhanii Jayeessoo</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22"/>Abbaa keeti ka si uume dhage'i;</para>
  <para style="q2" vid="PRO 23:22">haadha teetille yennaa isiin dulloonte hin tuffatin.<verse eid="PRO 23:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23"/>Dhuga'aa fi qarummaa,</para>
  <para style="q2" vid="PRO 23:23">gorsaa fi hubantii bitadhu malee hin gurgurin.<verse eid="PRO 23:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24"/>Abbaan nama balcha'aa gammada guddaa qaba;</para>
  <para style="q2" vid="PRO 23:24">ka ilma qaroo qabulle isatti hin gammada.<verse eid="PRO 23:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25"/>Abbaan keetii fi haati teeti gammadanuu ti;</para>
  <para style="q2" vid="PRO 23:25">haati si deette akka malee gammadduu ti.<verse eid="PRO 23:25"/></para>
  <para style="s1">Kudhanii Torbeessoo</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26"/>Ilma kiyya, qalbii teeti naa kenni;</para>
  <para style="q2" vid="PRO 23:26">ilti teetille karaa kiyya ilaaltuu ti.<verse eid="PRO 23:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27"/>Dubartiin sagaagaltittiin akka boolla qile'ee ti;</para>
  <para style="q2" vid="PRO 23:27">niitiin gaarayyeeffattuun akka balleessa dhipha'aa ti.<verse eid="PRO 23:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28"/>Isaan akka worra nama saamuu riphanee si eegan;</para>
  <para style="q2" vid="PRO 23:28">dhiira hedduu niitii ifiitiif akka hin addatanne godhan.<verse eid="PRO 23:28"/></para>
  <para style="s1">Kudhanii Saddeetessoo</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29"/>Ka waacifu eennu?</para>
  <para style="q2" vid="PRO 23:29">Ka gaddu eennu?</para>
  <para style="q2" vid="PRO 23:29">Ka wol dhabu eennu?</para>
  <para style="q2" vid="PRO 23:29">Ka nama komatu eennu?</para>
  <para style="q2" vid="PRO 23:29">Ka sababa malee madowu eennu?</para>
  <para style="q2" vid="PRO 23:29">Ka ila diimatu eennu?<verse eid="PRO 23:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30"/>Worra daadhii woyni'ii irra turu,</para>
  <para style="q2" vid="PRO 23:30">ka yennaa mara daadhii woyni'ii</para>
  <para style="q2" vid="PRO 23:30">ta makaa qaddu barbaaduu motii ree?<verse eid="PRO 23:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31"/>Daadhiin woyni'ii yennaa diimattu,</para>
  <para style="q2" vid="PRO 23:31">shurrubbee keessaa yennaa calalaxxu,</para>
  <para style="q2" vid="PRO 23:31">akka kasoo yennaa isii unanu</para>
  <para style="q2" vid="PRO 23:31">si hin halchisiisin.<verse eid="PRO 23:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32"/>Muummee irratti akka dhudhuufa'aa si idditi;</para>
  <para style="q2" vid="PRO 23:32">akka buuti'iille hadhaa sitti naxxi.<verse eid="PRO 23:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33"/>Ilti teeti waan haareya dhaggiti;</para>
  <para style="q2" vid="PRO 23:33">qalbiin teetille hin cucurruuxxi.<verse eid="PRO 23:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34"/>Akka nama abbaayaa irra rafuu,</para>
  <para style="q2" vid="PRO 23:34">akka nama qaccee utubaa hobolo'oo irra irkatuu hin teeta.<verse eid="PRO 23:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35"/>Ati, «Na dhowane;</para>
  <para style="q2" vid="PRO 23:35">ani ammoo hin miidhanne;</para>
  <para style="q2" vid="PRO 23:35">na dhaanane;</para>
  <para style="q2" vid="PRO 23:35">ani ammoo hin dhukkuffanne;</para>
  <para style="q2" vid="PRO 23:35">untoo dhibii barbaadatiisaaf, yoom dammaqa?» jetta.<verse eid="PRO 23:35"/></para>
  <chapter eid="PRO 23"/>
  <chapter number="24" style="c" sid="PRO 24"/>
  <para style="s1">Kudhanii Sagaleessoo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1"/>Namoota hamoolee hin hinaafin;</para>
  <para style="q2" vid="PRO 24:1">jaalummaa isaanii hin halchin.<verse eid="PRO 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2"/>Gadhaan isaanii hunnaan nama irratti ka'iisa yaada;</para>
  <para style="q2" vid="PRO 24:2">afaan isaaniille marroo maltumma'aa dubbata.<verse eid="PRO 24:2"/></para>
  <para style="s1">Diddameessoo</para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3"/>Manni qarumma'aan ijaarama;</para>
  <para style="q2" vid="PRO 24:3">hubantiille'een jabeeffama.<verse eid="PRO 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4"/>Beekkumsaan kollooti mana sanii</para>
  <para style="q2" vid="PRO 24:4">meya gatii guddo'ootii fi</para>
  <para style="q2" vid="PRO 24:4">meya dadansa'aan guutaman.<verse eid="PRO 24:4"/></para>
  <para style="s1">Diddamii Tokkeessoo</para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5"/>Nami qaroon hunna jadduu qaba;</para>
  <para style="q2" vid="PRO 24:5">nami beekkumsa qabulle jabeenna dabalata.<verse eid="PRO 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6"/>Lolaaf bayiisaaf qajeelcha,</para>
  <para style="q2" vid="PRO 24:6">injifatiisaafille gorsitoota hedduu barbaachisa.<verse eid="PRO 24:6"/></para>
  <para style="s1">Diddamii Lammeessoo</para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7"/>Nama gowwa'aaf qarummaan akka malee ol fagaatti;</para>
  <para style="q2" vid="PRO 24:7">inni addee mari'ii keessatti</para>
  <para style="q2" vid="PRO 24:7">afaan ifii hin saaqatu.<verse eid="PRO 24:7"/></para>
  <para style="s1">Diddamii Sadeessoo</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8"/>Nami waan hantuu godhiisaaf mala dhowu,</para>
  <para style="q2" vid="PRO 24:8">inni, «Malticha» jedhamee beekkama.<verse eid="PRO 24:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9"/>Malli gowwa'aa cubbu'u;</para>
  <para style="q2" vid="PRO 24:9">namooti nama murgu hin jibban.<verse eid="PRO 24:9"/></para>
  <para style="s1">Diddamii Arfeessoo</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10"/>Ati bara rakko'oo keessa yoo raafante,</para>
  <para style="q2" vid="PRO 24:10">jabeenni keeti attam attam diqqa'a!<verse eid="PRO 24:10"/></para>
  <para style="s1">Diddamii Shaneessoo</para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11"/>Worra gara du'aa geeffamanu baasi;</para>
  <para style="q2" vid="PRO 24:11">worra gara qalamiisaa tintimanu deebisi.<verse eid="PRO 24:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12"/>Ati, «Nuuti marroo waan kanaa hin beenne» yoo jette,</para>
  <para style="q2" vid="PRO 24:12">ka gadhaa namaa qorqoru kana hin hubatuu ree?</para>
  <para style="q2" vid="PRO 24:12">Ka jiruu teeti eegu hin beekuu ree?</para>
  <para style="q1" vid="PRO 24:12">Inni nama tokko tokkoofuu</para>
  <para style="q2" vid="PRO 24:12">akka hujii isaatitti gatii isaaf hin kaffaluu ree?<verse eid="PRO 24:12"/></para>
  <para style="s1">Diddamii Jayeessoo</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13"/>Ilma kiyya, dammi dansaa waan te'eef,</para>
  <para style="q2" vid="PRO 24:13">damma nyaadhu;</para>
  <para style="q2" vid="PRO 24:13">nadhiin dhaaba dammaa keessaa sitti hin mi'ootti.<verse eid="PRO 24:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14"/>Qarummaalle lubbuu teetiif</para>
  <para style="q2" vid="PRO 24:14">akkuma san akka mi'oottu beeki;</para>
  <para style="q2" vid="PRO 24:14">ati yoo isii dhaggatte,</para>
  <para style="q2" vid="PRO 24:14">gara fuula duraa addii qadda;</para>
  <para style="q2" vid="PRO 24:14">addiin teetille hin baddu.<verse eid="PRO 24:14"/></para>
  <para style="s1">Diddamii Torbeessoo</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 24:15"/>Akka nama hama'aa</para>
  <para style="q2" vid="PRO 24:15">mana nama balcha'aa dhokattee hin gaadin.</para>
  <para style="q2" vid="PRO 24:15">Mana isaa irralle'etti hunnaan hin ka'in.<verse eid="PRO 24:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16"/>Nami balchaan yennaa torba jigulle deebi'ee hin ka'a;</para>
  <para style="q2" vid="PRO 24:16">nami hamaan ammoo badii keessa bu'a.<verse eid="PRO 24:16"/></para>
  <para style="s1">Diddamii Saddeetessoo</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17"/>Yennaa diinni keeti jigu hin gammadin;</para>
  <para style="q2" vid="PRO 24:17">yennaa inni gufatulle gadhaan keeti hin firinxiixin.<verse eid="PRO 24:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18"/>Itti gammadiisa keeti yoo dhagge,</para>
  <para style="q2" vid="PRO 24:18">Mootiin Waan Maraa hin jaalatu;</para>
  <para style="q2" vid="PRO 24:18">aarii ifii isa irraa hin deebisa.<verse eid="PRO 24:18"/></para>
  <para style="s1">Diddamii Sagaleessoo</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19"/>Waan namooti hamaan hujanu hin qoxxisin;</para>
  <para style="q2" vid="PRO 24:19">yookiin hamoolee hin hinaafin.<verse eid="PRO 24:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20"/>Nami hamaan addii gara fuula duraa hin qabu;</para>
  <para style="q2" vid="PRO 24:20">issaan nama hama'aalle hin dhaama.<verse eid="PRO 24:20"/></para>
  <para style="s1">Soddomeessoo</para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21"/>Ilma kiyya, Mootii Waan Maraatii fi mooticha sodaadhu;</para>
  <para style="q2" vid="PRO 24:21">worra finqilaa woliin jaala hin te'in.<verse eid="PRO 24:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22"/>Mootiin Waan Maraatii fi mootichi</para>
  <para style="q2" vid="PRO 24:22">dedhuma badii worra finqilaa irratti hin fidan;</para>
  <para style="q2" vid="PRO 24:22">badii isaan fidanu eentu beeka ree?<verse eid="PRO 24:22"/></para>
  <para style="s1">Jecha Qaro'oo Ka Dhibii</para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 24:23"/>Isaan kunille jecha qaro'oo ti:</para>
  <para style="q2" vid="PRO 24:23">Muraa keessatti nama wol caalchisuun dansa'aa moti.<verse eid="PRO 24:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24"/>Nama hama'aan, «Ati yakkaa hin qaddu» nama jedhu,</para>
  <para style="q2" vid="PRO 24:24">kolbaan hin abaarti;</para>
  <para style="q2" vid="PRO 24:24">gosi biyya adda addaalle hin jibbiti.<verse eid="PRO 24:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25"/>Worra nama hamaa xixuuf ammoo</para>
  <para style="q2" vid="PRO 24:25">wonni dansaan hin teeti;</para>
  <para style="q2" vid="PRO 24:25">eebbi dansaalle isaan irratti hin bu'a.<verse eid="PRO 24:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26"/>Deebii dhuga'aa deebisuun,</para>
  <para style="q2" vid="PRO 24:26">akka sunqaa hidhi'ii ti.<verse eid="PRO 24:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27"/>Hujii alaa fixadhuu,</para>
  <para style="q2" vid="PRO 24:27">fichaa keeti qopheeffadhu;</para>
  <para style="q2" vid="PRO 24:27">achiin duuba mana keeti ijaaradhu.<verse eid="PRO 24:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28"/>Sababa malee nama irratti dhugaa hin bayin</para>
  <para style="q2" vid="PRO 24:28">yookiin hidhii teetiin nama hin sobin.<verse eid="PRO 24:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29"/>Ati, «Waanuma nami na godhe, anille isa hin godha;</para>
  <para style="q2" vid="PRO 24:29">gatuma hujii isaa isaaf hin deebisa» hin jedhin.<verse eid="PRO 24:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30"/>Ani fichaa nama booseyaa keessa,</para>
  <para style="q2" vid="PRO 24:30">oorruu woyni'ii ta nama qalbii hin qannee</para>
  <para style="q2" vid="PRO 24:30">keessa dabaree deeme.<verse eid="PRO 24:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31"/>Addee mara qoreen itti latteerti;</para>
  <para style="q2" vid="PRO 24:31">shuqunaan lafa golliteerti;</para>
  <para style="q2" vid="PRO 24:31">dalleenni dhaka'aalle irraa jigeera.<verse eid="PRO 24:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32"/>Ani waan kana ilaalee itti yaadee,</para>
  <para style="q2" vid="PRO 24:32">waan dhagge kana irraa barumsa dhaggadhe:<verse eid="PRO 24:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33"/>Ati yennaa diqqoo isi'ii rafii,</para>
  <para style="q2" vid="PRO 24:33">yennaa diqqoo isi'ii mugii,</para>
  <para style="q2" vid="PRO 24:33">foorfatiisaaf yennaa diqqoo isi'ii</para>
  <para style="q2" vid="PRO 24:33">harka wol irra naqadhu.<verse eid="PRO 24:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34"/>Garuu hiyyuun akka saantu'uu,</para>
  <para style="q2" vid="PRO 24:34">beelti akka nama meya lolaa hidhatee</para>
  <para style="q2" vid="PRO 24:34">sitti hin dhufan.<verse eid="PRO 24:34"/></para>
  <chapter eid="PRO 24"/>
  <chapter number="25" style="c" sid="PRO 25"/>
  <para style="s1">Jecha Qarummaa Solomoonii Ka Dhibii</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 25:1"/>Isaan kunille fakkeenna Solomoonii ka dhibii,</para>
  <para style="q2" vid="PRO 25:1">ka qondaaltoti Hisqiyaasii mootii</para>
  <para style="q2" vid="PRO 25:1">Yihuda'aa barreeffama irraa garagalchane.<verse eid="PRO 25:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2"/>Gofa woyii dhossuun ulfinna Waaqaa ti;</para>
  <para style="q2" vid="PRO 25:2">gofa woyii qoratanee baasuun</para>
  <para style="q2" vid="PRO 25:2">ulfinna moototaa ti.<verse eid="PRO 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3"/>Akkuma ol-gubbaan ol fagaattu</para>
  <para style="q2" vid="PRO 25:3">akkuma lattille gaddi fagaattu,</para>
  <para style="q2" vid="PRO 25:3">yaadi moototaalle qorqoramuu hin dande'u.<verse eid="PRO 25:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4"/>Ka meetii irraa meya huju meetii qulluu akka qabaatu,</para>
  <para style="q2" vid="PRO 25:4">ati meetii san irraa xurii kaasi.<verse eid="PRO 25:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5"/>Barcumaan mootumma'aa</para>
  <para style="q2" vid="PRO 25:5">balchumma'aan akka dhaabbatu,</para>
  <para style="q2" vid="PRO 25:5">nama hamaa addee mootiin jiruu kaasi.<verse eid="PRO 25:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6"/>Mootii duratti ol ifi hin qabin;</para>
  <para style="q2" vid="PRO 25:6">nama guddaa ifi hin fakkeessin.<verse eid="PRO 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7"/>Mootichi nama guddaa duratti</para>
  <para style="q2" vid="PRO 25:7">addee gad aantuu sii kenniisaa mannaa,</para>
  <para style="q2" vid="PRO 25:7">addee ol aantuu sii kennu woyya.<verse eid="PRO 25:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 25:8"/>Waan tokko ilumaan dhaggite'eef</para>
  <para style="q2" vid="PRO 25:8">ariifattee gara mura'aa hin dhikeessin;</para>
  <para style="q2" vid="PRO 25:8">nami dhibiin dokonkora keeti yoo mirkaneesse,</para>
  <para style="q2" vid="PRO 25:8">ati dhuma irratti maan teeta ree?<verse eid="PRO 25:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9"/>Haajaa keetiif nama woliin yennaa falmattu,</para>
  <para style="q2" vid="PRO 25:9">gofa nama dhibi'ii hin mudhisin.<verse eid="PRO 25:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10"/>Yoo akkas hin te'in nami waan kana dhage'u si qaanessa;</para>
  <para style="q2" vid="PRO 25:10">maqaan keeti ka bade sun ijjumaa si'iif hin deebi'u.<verse eid="PRO 25:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11"/>Dubbiin yennaa isi'iititti dubbatantu,</para>
  <para style="q2" vid="PRO 25:11">akka quumhaa worqi'ii ka qorii meeti'ii keessaa ti.<verse eid="PRO 25:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12"/>Xixxaan nama qaro'oo nama isa dhage'uuf,</para>
  <para style="q2" vid="PRO 25:12">akka worqii gurraa yookiin meya seesaa</para>
  <para style="q2" vid="PRO 25:12">ka worqii qulluu irraa hujamee ti.<verse eid="PRO 25:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13"/>Bisaan dhakaa roobaatiin qabbanowe,</para>
  <para style="q2" vid="PRO 25:13">yennaa midhaan galcha'aa</para>
  <para style="q2" vid="PRO 25:13">akkuma gadhaa namaa qabbaneessu,</para>
  <para style="q2" vid="PRO 25:13">ergantooti addatamootille</para>
  <para style="q2" vid="PRO 25:13">nama isaan ergatuuf akkasuma;</para>
  <para style="q2" vid="PRO 25:13">isaan yaada goottolee ifii hin foorfachiisan.<verse eid="PRO 25:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14"/>Nami kennansa namaaf hin kennineen ifi jaju,</para>
  <para style="q2" vid="PRO 25:14">akka duumensaa fi qilleensa bokkeya hin qannee ti.<verse eid="PRO 25:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15"/>Nami ossa qabu</para>
  <para style="q2" vid="PRO 25:15">bulchaa biyyaa tokko gadhaa hin laaffifata;</para>
  <para style="q2" vid="PRO 25:15">arrabi dansaan nama mataa jabaatu laaffisa.<verse eid="PRO 25:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16"/>Damma yoo dhaggatte,</para>
  <para style="q2" vid="PRO 25:16">haga si'iif barbaachisu qofa nyaadhu;</para>
  <para style="q2" vid="PRO 25:16">akka malee nyaattu si diddissa.<verse eid="PRO 25:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17"/>Si bagee waan si jibbuuf,</para>
  <para style="q2" vid="PRO 25:17">miilli keeti mana ollaa keetiititti hin daandin.<verse eid="PRO 25:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18"/>Nami dharaan dhugaa nama irratti bayu,</para>
  <para style="q2" vid="PRO 25:18">akka ulee jirmaa yookiin</para>
  <para style="q2" vid="PRO 25:18">akka shallaaga'aa yookiin</para>
  <para style="q2" vid="PRO 25:18">akka daaya qara qabuu ti.<verse eid="PRO 25:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19"/>Rakkinna keessa nama hin addatannetti addatiis,</para>
  <para style="q2" vid="PRO 25:19">akka nama ilkaan tacho'etti</para>
  <para style="q2" vid="PRO 25:19">yookiin miila laashowetti addatuu ti.<verse eid="PRO 25:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20"/>Nama gaddeef faaruu faarsuun,</para>
  <para style="q2" vid="PRO 25:20">akka nama guyyaa boojji'ii</para>
  <para style="q2" vid="PRO 25:20">woyaa isaa isa irraa fuudhanee ti</para>
  <para style="q2" vid="PRO 25:20">yookiin akka soodda mada'atti naqanee ti.<verse eid="PRO 25:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21"/>Diinni keeti yoo beelote sagalee nyaatu kenniif;</para>
  <para style="q2" vid="PRO 25:21">yoo dheebotelle bisaan unu kenniif.<verse eid="PRO 25:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22"/>Tana godhiisaan gaabbee akka inni qaanowu hin goota;</para>
  <para style="q2" vid="PRO 25:22">Mootiin Waan Maraalle gatii si'iif hin kaffala.<verse eid="PRO 25:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23"/>Akkuma qilleensi kaabaa bokkeya fidu,</para>
  <para style="q2" vid="PRO 25:23">arrabi hamatu ila aari'iin nama ilaaltu hin fida.<verse eid="PRO 25:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24"/>Niitii dubbatittii woliin le'iisaa mannaa,</para>
  <para style="q2" vid="PRO 25:24">roga heellichoo manaa irra le'uu woyya.<verse eid="PRO 25:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25"/>Oduun dansaan biyya fago'oo,</para>
  <para style="q2" vid="PRO 25:25">akkuma bisaan qabbanowaa</para>
  <para style="q2" vid="PRO 25:25">lubbuu dheebotte dheebuu baasuu ti.<verse eid="PRO 25:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26"/>Nami balchaan nama hama'aaf karaa kennu,</para>
  <para style="q2" vid="PRO 25:26">akka madda boorayee,</para>
  <para style="q2" vid="PRO 25:26">yookiin akka bisaan boollaa</para>
  <para style="q2" vid="PRO 25:26">ka xurayee ti.<verse eid="PRO 25:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27"/>Damma akka malee nyaatiis dansa'aa moti</para>
  <para style="q2" vid="PRO 25:27">yookiin ulfinna mataa ifii barbaadatiisi ulfinnaa moti.<verse eid="PRO 25:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28"/>Nami ifi qabatiisa hin dandeenne,</para>
  <para style="q2" vid="PRO 25:28">akka qachaa guddicha dalleenni dhaka'aa irraa jigee ti.<verse eid="PRO 25:28"/></para>
  <chapter eid="PRO 25"/>
  <chapter number="26" style="c" sid="PRO 26"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 26:1"/>Dhakaan roobaa bona keessa,</para>
  <para style="q2" vid="PRO 26:1">bokkeenni yennaa midhaan galfatanuuf akkuma hin teene,</para>
  <para style="q2" vid="PRO 26:1">ulfinnille gowwa'aaf hin te'u.<verse eid="PRO 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2"/>Abaarsi akkasumaan nama abaaranu,</para>
  <para style="q2" vid="PRO 26:2">akkuma sinbirroota koolaan asii fi achi kaatuu ti malee,</para>
  <para style="q2" vid="PRO 26:2">nama tokkolle hin miidhu.<verse eid="PRO 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3"/>Licheen fardaaf,</para>
  <para style="q2" vid="PRO 26:3">bixaalli gaange'eef akkuma barbaachisu,</para>
  <para style="q2" vid="PRO 26:3">uleen dudda gowwa'aatiif hin barbaachitti.<verse eid="PRO 26:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4"/>Atinuu akka isaa akka hin teene,</para>
  <para style="q2" vid="PRO 26:4">gowwa'aaf akka gowwummaa isaatitti</para>
  <para style="q2" vid="PRO 26:4">deebii gowwittii hin deebisin.<verse eid="PRO 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5"/>Nami gowwaan qaroo akka ifi hin seene,</para>
  <para style="q2" vid="PRO 26:5">akkuma gowwummaa isaatitti deebii isaaf kenni.<verse eid="PRO 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6"/>Nami nama gowwaa ergatu,</para>
  <para style="q2" vid="PRO 26:6">akka nama miila ifi irraa muree rakkinna ifitti fiduu ti.<verse eid="PRO 26:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7"/>Fakkeenni afaan gowwa'aa keessaa bawu,</para>
  <para style="q2" vid="PRO 26:7">akka miila naafatee rarra'uu ti.<verse eid="PRO 26:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8"/>Nama gowwa'aaf ulfinna kenniis,</para>
  <para style="q2" vid="PRO 26:8">akka nama looyya'atti dhakaa hidhuu ti.<verse eid="PRO 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 26:9"/>Fakkeenni afaan gowwa'aa keessaa bawu,</para>
  <para style="q2" vid="PRO 26:9">akka qoree harka nama machowa'aa keessa jirtuu ti.<verse eid="PRO 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 26:10"/>Nami nama gowwaa yookiin nama karaa deemu qaxaru,</para>
  <para style="q2" vid="PRO 26:10">akka nama daaya akkuma dhagge</para>
  <para style="q2" vid="PRO 26:10">darbatee nama dhagge madeessuu ti.<verse eid="PRO 26:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 26:11"/>Sareen diddiga ifiititti akkuma deebitu,</para>
  <para style="q2" vid="PRO 26:11">gowwaalle gowwummaa ifiititti hin deddeebi'a.<verse eid="PRO 26:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 26:12"/>Nama qaroo ifi sewu dhaggiteertaa?</para>
  <para style="q2" vid="PRO 26:12">Isa caalaa gowwa'atti addii qaba.<verse eid="PRO 26:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 26:13"/>Nami booseyi, «Neenqi karaa keessa jira!</para>
  <para style="q1" vid="PRO 26:13">Neenqi karaa guddaa keessa jira» jedha.<verse eid="PRO 26:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 26:14"/>Miilli saanqa'aa iloo keessa akkuma garagaggalu,</para>
  <para style="q2" vid="PRO 26:14">nami booseyille taqee ifii irra garagaggala.<verse eid="PRO 26:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 26:15"/>Nami booseyi harka ifii qorii keessa hin keya;</para>
  <para style="q2" vid="PRO 26:15">garuu gara afaan ifii deebifatiisa guddoo dadhaba.<verse eid="PRO 26:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 26:16"/>Nami booseyi,</para>
  <para style="q2" vid="PRO 26:16">namoota torba ka hubanti'iin deebii deebisanu caalaa</para>
  <para style="q2" vid="PRO 26:16">qaroo ifi seya.<verse eid="PRO 26:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 26:17"/>Nami akkasumaan dubbii namaa keessa galu,</para>
  <para style="q2" vid="PRO 26:17">akka nama saree karaa ideentu gurra qabuu ti.<verse eid="PRO 26:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 26:18"/>Akkuma maraataan umeessaa ibiddaatii fi</para>
  <para style="q2" vid="PRO 26:18">daaya nama ijjeesu namatti gad lakkisu,<verse eid="PRO 26:18"/></para>
  <para style="q2">
    <verse number="19" style="v" sid="PRO 26:19"/>nami nama gowwoonsee,</para>
  <para style="q2" vid="PRO 26:19">«Ani hin taphadhe» jedhulle akkasuma.<verse eid="PRO 26:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 26:20"/>Qoraan yoo hin jiraatin ibiddi hin dhaama;</para>
  <para style="q2" vid="PRO 26:20">hamiin yoo hin jiraatin lolli hin hafa.<verse eid="PRO 26:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21"/>Cileen kashila,</para>
  <para style="q2" vid="PRO 26:21">muki ibidda akkuma gabbisu,</para>
  <para style="q2" vid="PRO 26:21">nami dubbii tuttuqu lola kaasa.<verse eid="PRO 26:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 26:22"/>Jechi hami'ii akka tuuqata mi'owuu ti;</para>
  <para style="q2" vid="PRO 26:22">gara keessa namaa gad seena.<verse eid="PRO 26:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 26:23"/>Nami afaan ifiitiin dansaa fakkaatee,</para>
  <para style="q2" vid="PRO 26:23">gadhaa ifii keessaa yaada hamaa qabu,</para>
  <para style="q2" vid="PRO 26:23">akka meya faaraa ka meetii itti gonfanee ti.<verse eid="PRO 26:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 26:24"/>Nami kijibu afaaniin nama sossoba;</para>
  <para style="q2" vid="PRO 26:24">gadhaa ifiitiin hantuu yaadata.<verse eid="PRO 26:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 26:25"/>Yaadi hamaan torba</para>
  <para style="q2" vid="PRO 26:25">waan gadhaa isaa keessa guuteeruuf,</para>
  <para style="q2" vid="PRO 26:25">yennaa inni afaan laafee dubbatu,</para>
  <para style="q2" vid="PRO 26:25">isa hin dhugeeffatin.<verse eid="PRO 26:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 26:26"/>Kijibummaa ifii maltumma'aan dhoffatulle,</para>
  <para style="q2" vid="PRO 26:26">hammeenni isaa ammoo gumii</para>
  <para style="q2" vid="PRO 26:26">keessatti diidatti hin baya.<verse eid="PRO 26:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 26:27"/>Nami boolla namaaf qotu,</para>
  <para style="q2" vid="PRO 26:27">ifumaafuu keessa hin bu'a.</para>
  <para style="q1" vid="PRO 26:27">Nami dhakaa namatti konkolaachisulle,</para>
  <para style="q2" vid="PRO 26:27">dhakaan sun deebi'ee isuma irra hin konkolaata.<verse eid="PRO 26:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 26:28"/>Arrabi dharaamessi worruma ifiifuu miidhe jibba;</para>
  <para style="q2" vid="PRO 26:28">afaan sobaan kookkisulle badii namatti fida.<verse eid="PRO 26:28"/></para>
  <chapter eid="PRO 26"/>
  <chapter number="27" style="c" sid="PRO 27"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 27:1"/>Waan Guyyaan fidu waan hin beenneef,</para>
  <para style="q2" vid="PRO 27:1">waan boru te'uun ifi hin jajin.<verse eid="PRO 27:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2"/>Nami si jajuu ti malee, ati ifi hin jajin;</para>
  <para style="q2" vid="PRO 27:2">nami dhibiin si jajuu ti malee, afaan keetiin ifi hin jajin.<verse eid="PRO 27:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3"/>Dhakaan hin ulfaata;</para>
  <para style="q2" vid="PRO 27:3">maansille ba'a'a.</para>
  <para style="q1" vid="PRO 27:3">Nunnussaan gowwaan tuttuqee nama aarsu ammoo,</para>
  <para style="q2" vid="PRO 27:3">isaan lachuu caalaa hin ulfaatti.<verse eid="PRO 27:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4"/>Mufiin gadhi-jabeenna;</para>
  <para style="q2" vid="PRO 27:4">aariin lola'a;</para>
  <para style="q2" vid="PRO 27:4">hinaaffaa dura ammoo</para>
  <para style="q2" vid="PRO 27:4">eentu dhaabbatuu dande'a?<verse eid="PRO 27:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5"/>Jaalala dhokate caalaa,</para>
  <para style="q2" vid="PRO 27:5">xixicha mudhatu woyya.<verse eid="PRO 27:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6"/>Sunqaa diinaatii mannaa,</para>
  <para style="q2" vid="PRO 27:6">jaalli si madeessu woyya.<verse eid="PRO 27:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7"/>Nama quufe,</para>
  <para style="q2" vid="PRO 27:7">dammi itti bushowa;</para>
  <para style="q2" vid="PRO 27:7">nama beelote ammoo</para>
  <para style="q2" vid="PRO 27:7">wonni hadhowuuyyuu itti mi'owa.<verse eid="PRO 27:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8"/>Nami qe'ee ifii keessaa baye,</para>
  <para style="q2" vid="PRO 27:8">akka sinbirree mana ifii keessaa baatee ti.<verse eid="PRO 27:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9"/>Fiqire'ee fi qayyi nama gammachiisan;</para>
  <para style="q2" vid="PRO 27:9">gammachiisiis jaalaalle</para>
  <para style="q2" vid="PRO 27:9">gorsa dansaa isaa irraa madda.<verse eid="PRO 27:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10"/>Jaalota teetii fi jaalota abbaa keetii hin lakkisin;</para>
  <para style="q2" vid="PRO 27:10">yennaa rakkinnaa mana obboleessa keetii hin dhaqin;</para>
  <para style="q2" vid="PRO 27:10">obboleessa fagoo jiruu mannaa,</para>
  <para style="q2" vid="PRO 27:10">ollaa dhikoo jiru woyya.<verse eid="PRO 27:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11"/>Ilma kiyya,</para>
  <para style="q2" vid="PRO 27:11">nama na arrassuuf deebii kennuu akka ani dande'u,</para>
  <para style="q2" vid="PRO 27:11">ati qaroo te'i;</para>
  <para style="q2" vid="PRO 27:11">gadhaa kiyyalle gammachiisi.<verse eid="PRO 27:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12"/>Nami qalbeeffataan waan hantuu dhaggee duraa baqata;</para>
  <para style="q2" vid="PRO 27:12">nami hubantii hin qanne ammoo ittuma ideemee,</para>
  <para style="q2" vid="PRO 27:12">rakkoo keessa seena.<verse eid="PRO 27:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13"/>Nama alaga'aaf wobii te'e woyaa irraa mulqadhu;</para>
  <para style="q2" vid="PRO 27:13">haga inni waan alagaan fudhate san deebisutti</para>
  <para style="q2" vid="PRO 27:13">woyaa san qabadhu.<verse eid="PRO 27:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14"/>Nami barii ganamaan ka'ee,</para>
  <para style="q2" vid="PRO 27:14">qoonqoo ol qabatee nama yoo eebbise,</para>
  <para style="q2" vid="PRO 27:14">eebbi sun abaarsa nama sanitti fakkaata.<verse eid="PRO 27:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15"/>Niitiin dubbattittiin akka mana</para>
  <para style="q2" vid="PRO 27:15">guyyaa roobaa dhim'isaa ooluu ti.<verse eid="PRO 27:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16"/>Isii ittisiis qilleensa ittisiisa,</para>
  <para style="q2" vid="PRO 27:16">yookiin zayitii harkaan qabiisa.<verse eid="PRO 27:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17"/>Akkuma sibiilli sibiila cabbu,</para>
  <para style="q2" vid="PRO 27:17">namille nama cabba.<verse eid="PRO 27:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18"/>Nami muka harru'uu kunuunsu</para>
  <para style="q2" vid="PRO 27:18">midhaan isi'ii hin nyaata;</para>
  <para style="q2" vid="PRO 27:18">nami goottaa ifii eegulle</para>
  <para style="q2" vid="PRO 27:18">ulfinna hin dhaggata.<verse eid="PRO 27:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19"/>Akkuma bisaan fuula namaa mudhisu,</para>
  <para style="q2" vid="PRO 27:19">yaadi namaalle eennummaa namaa mudhisa.<verse eid="PRO 27:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20"/>Addeen worri du'e jiruu fi</para>
  <para style="q2" vid="PRO 27:20">addeen badi'ii ijjumaa hin quuttu;</para>
  <para style="q2" vid="PRO 27:20">ilti namaalle ijjumaa hin quuttu.<verse eid="PRO 27:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21"/>Meeti'ii fi worqiin addee itti baqisiisanu keessatti</para>
  <para style="q2" vid="PRO 27:21">akkuma haga ilaallatamanu,</para>
  <para style="q2" vid="PRO 27:21">namille leellifamiisaan haga ilaalama.<verse eid="PRO 27:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22"/>Gowwaa akka midhaanii</para>
  <para style="q2" vid="PRO 27:22">mooyye'etti tuma'aan yoo tuntelle,</para>
  <para style="q2" vid="PRO 27:22">gowwummaa isa keessaa baasuu hin dandeettu.<verse eid="PRO 27:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 27:23"/>Hoolee teeti haala attamii keessaa akka jirtu</para>
  <para style="q2" vid="PRO 27:23">midhassii beeki;</para>
  <para style="q2" vid="PRO 27:23">loon keetille midhassii tiffadhu.<verse eid="PRO 27:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 27:24"/>Sababille durummaan haga bara baraa hin jiraatu;</para>
  <para style="q2" vid="PRO 27:24">kallachille dhalootaa dhalootatti hin dabaru.<verse eid="PRO 27:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 27:25"/>Marri gogaan haamamee,</para>
  <para style="q2" vid="PRO 27:25">marri haarenni yennaa latu,</para>
  <para style="q2" vid="PRO 27:25">marri koobota irraa yennaa wolitti qabamu,<verse eid="PRO 27:25"/></para>
  <para style="q2">
    <verse number="26" style="v" sid="PRO 27:26"/>buruusoo hoolota teetiitiin daara hin baata;</para>
  <para style="q2" vid="PRO 27:26">re'oota teetille'een fichaa hin bitatta.<verse eid="PRO 27:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27"/>Soorata keetiif, soorata maatii teetiitiif,</para>
  <para style="q2" vid="PRO 27:27">soorata tajaajiltoota teetiifille ka gewu,</para>
  <para style="q2" vid="PRO 27:27">aanan re'e'ee hin qabaatta.<verse eid="PRO 27:27"/></para>
  <chapter eid="PRO 27"/>
  <chapter number="28" style="c" sid="PRO 28"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 28:1"/>Nami hamaan adoo nami hin ari'in baqata;</para>
  <para style="q2" vid="PRO 28:1">nami balchaan ammoo akka neenqaa ifi addata.<verse eid="PRO 28:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2"/>Kolbaan yennaa finqila kaatu,</para>
  <para style="q2" vid="PRO 28:2">bulchitooti isi'ii hin heddatti;</para>
  <para style="q2" vid="PRO 28:2">nama hubata'aa fi beekaa yoo qabaatte ammoo</para>
  <para style="q2" vid="PRO 28:2">mootummaan isi'ii jabaattee hin dhaabbatti.<verse eid="PRO 28:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3"/>Bulchaan hiyyeessa cunqursu</para>
  <para style="q2" vid="PRO 28:3">akka bokkeya midhaan balleessuu ti.<verse eid="PRO 28:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4"/>Worri seera lakkisu nama hamaa leellisa;</para>
  <para style="q2" vid="PRO 28:4">worri seera eegatanu ammoo isaaniin morma.<verse eid="PRO 28:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5"/>Nami hamaan haqa hin beeku;</para>
  <para style="q2" vid="PRO 28:5">worri Mootii Waan Maraa barbaadatu ammoo</para>
  <para style="q2" vid="PRO 28:5">guutumaa guutu'utti haqa beekan.<verse eid="PRO 28:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 28:6"/>Dureessa ideensi isaa micciirama'aatii mannaa,</para>
  <para style="q2" vid="PRO 28:6">hiyyeessa komii hin qanne woyya.<verse eid="PRO 28:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 28:7"/>Ka seera eegu ilma qalbeeffata'a;</para>
  <para style="q2" vid="PRO 28:7">ka gadhitoo woliin jaalomu ammoo</para>
  <para style="q2" vid="PRO 28:7">abbaa ifii salphisa.<verse eid="PRO 28:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 28:8"/>Nami liqaa dhala gudda'aatiin qabeenna ede'atu,</para>
  <para style="q2" vid="PRO 28:8">nama hiyyeessaa nawuuf hin kuusa.<verse eid="PRO 28:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9"/>Nama seeraaf hin ajajanne,</para>
  <para style="q2" vid="PRO 28:9">daadimati isaatuu akka malee hin jibbisiisa.<verse eid="PRO 28:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10"/>Nami nama qajeelaa karaa hama'atti geessu,</para>
  <para style="q2" vid="PRO 28:10">boolla ifumaa qote keessa hin bu'a;</para>
  <para style="q2" vid="PRO 28:10">nami komii hin qanne ammoo</para>
  <para style="q2" vid="PRO 28:10">waan dansaa hin dhaala.<verse eid="PRO 28:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11"/>Nami dureessi qaroo ifi seya;</para>
  <para style="q2" vid="PRO 28:11">hiyyeessi hubantii qabu ammoo</para>
  <para style="q2" vid="PRO 28:11">qorqoree keessa isaa hin beeka.<verse eid="PRO 28:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12"/>Nami balchaan yennaa injifatu,</para>
  <para style="q2" vid="PRO 28:12">martinuu hin gammadan;</para>
  <para style="q2" vid="PRO 28:12">nami hamaan yennaa baallii qabatu ammoo</para>
  <para style="q2" vid="PRO 28:12">namooti hin dhokatan.<verse eid="PRO 28:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13"/>Nami cubbuu ifii dhoffatu,</para>
  <para style="q2" vid="PRO 28:13">hin milkowu;</para>
  <para style="q2" vid="PRO 28:13">nami cubbuu ifii faaci'atuu fi ka isii lakkisu ammoo</para>
  <para style="q2" vid="PRO 28:13">marartii hin dhaggata.<verse eid="PRO 28:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14"/>Nami yennaa mara Mootii Waan Maraa sodaatu</para>
  <para style="q2" vid="PRO 28:14">ka gammade;</para>
  <para style="q2" vid="PRO 28:14">nami mataa jabaatu ammoo rakkinna keessa gala.<verse eid="PRO 28:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15"/>Bulchaan hamaan worra qarqaarsa hin qanne irratti</para>
  <para style="q2" vid="PRO 28:15">akka neenqa dhangaa dhowuu</para>
  <para style="q2" vid="PRO 28:15">yookiin akka doobbaa hiixatee woy qabuu ti.<verse eid="PRO 28:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16"/>Bulchaan hubantii hin qanne</para>
  <para style="q2" vid="PRO 28:16">akka malee nama cunqursa.</para>
  <para style="q1" vid="PRO 28:16">Ka bu'aa haqa hin te'in jibbu ammoo</para>
  <para style="q2" vid="PRO 28:16">bara dheeraa hin le'a.<verse eid="PRO 28:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17"/>Nami nama ijjeese,</para>
  <para style="q2" vid="PRO 28:17">haga du'utti baqataa hin le'a;</para>
  <para style="q2" vid="PRO 28:17">nami tokkolle isa hin qarqaarin.<verse eid="PRO 28:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18"/>Nami komii hin qanne waan hantuu irra hin bu'u;</para>
  <para style="q2" vid="PRO 28:18">nami micciiramaan ammoo dedhuma jiga.<verse eid="PRO 28:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19"/>Nami lafa qotatu sagalee bacaa hin qabaata;</para>
  <para style="q2" vid="PRO 28:19">nami waan bu'aa hin qanne hordofu ammoo hin deega.<verse eid="PRO 28:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20"/>Nami addatamaan guddoo hin eebbifama;</para>
  <para style="q2" vid="PRO 28:20">nami durumma'aaf ariifatu ammoo</para>
  <para style="q2" vid="PRO 28:20">adoo hin adabamin hin hafu.<verse eid="PRO 28:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21"/>Nama wol caalchisuun dansa'aa moti;</para>
  <para style="q2" vid="PRO 28:21">garuu nami bixee daabbo'oo takkatti'iif jedhee</para>
  <para style="q2" vid="PRO 28:21">dokonkora huja.<verse eid="PRO 28:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22"/>Nami donni duroomiisaaf ariifata;</para>
  <para style="q2" vid="PRO 28:22">hiyyuun akka isa eegattu hin beeku.<verse eid="PRO 28:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23"/>Nama afaaniin nama kookkisu caalaa,</para>
  <para style="q2" vid="PRO 28:23">ka balleessaa namatti himee nama xixutti</para>
  <para style="q2" vid="PRO 28:23">dhuma irratti saadama.<verse eid="PRO 28:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24"/>Nami abbaa ifii yookiin haadha ifii saamee,</para>
  <para style="q2" vid="PRO 28:24">«Kun dokonkoraa moti» jedhu,</para>
  <para style="q2" vid="PRO 28:24">inni jaala nama woy balleessuu ti.<verse eid="PRO 28:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25"/>Nami joljolaan lola kakkaasa;</para>
  <para style="q2" vid="PRO 28:25">nami Mootii Waan Maraatitti addatu ammoo</para>
  <para style="q2" vid="PRO 28:25">hin milkowa.<verse eid="PRO 28:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26"/>Nami ifitti addatu gowwa'a;</para>
  <para style="q2" vid="PRO 28:26">nami qarumma'aan deddeebi'u</para>
  <para style="q2" vid="PRO 28:26">ammoo waan hantuu irra hin bu'u.<verse eid="PRO 28:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27"/>Nami hiyyeessaaf kennu womaa hin dhabu;</para>
  <para style="q2" vid="PRO 28:27">nami hiyyeessa ilaalee lakkisu ammoo</para>
  <para style="q2" vid="PRO 28:27">abaarsa hedduu fudhata.<verse eid="PRO 28:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28"/>Yennaa namooti hamooleen baallii fudhatanu,</para>
  <para style="q2" vid="PRO 28:28">kolbaan hin dhokatti;</para>
  <para style="q2" vid="PRO 28:28">yennaa isaan badanu ammoo</para>
  <para style="q2" vid="PRO 28:28">balchooti hin bacatti.<verse eid="PRO 28:28"/></para>
  <chapter eid="PRO 28"/>
  <chapter number="29" style="c" sid="PRO 29"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 29:1"/>Nami yennaa hedduu xixameen duuba didee mataa jabaatu,</para>
  <para style="q2" vid="PRO 29:1">cannana fayyuu hin dandeenne dedhuma caba.<verse eid="PRO 29:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2"/>Balchooti yennaa baallii fudhatanu,</para>
  <para style="q2" vid="PRO 29:2">kolbaan guddoo gammadi;</para>
  <para style="q2" vid="PRO 29:2">yennaa nami hamaan bulchu</para>
  <para style="q2" vid="PRO 29:2">ammoo kolbaan hin aaddi.<verse eid="PRO 29:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3"/>Nami qarummaa jaalatu,</para>
  <para style="q2" vid="PRO 29:3">abbaa ifii gammachiisa;</para>
  <para style="q2" vid="PRO 29:3">nami jaala sagaagaltu'uu te'u ammoo</para>
  <para style="q2" vid="PRO 29:3">qabeenna ifii bittinneessa.<verse eid="PRO 29:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4"/>Mootiin haqa muriisaan biyya ifii hin jabeessa;</para>
  <para style="q2" vid="PRO 29:4">ka safuu fudhatiisaaf joljolu ammoo</para>
  <para style="q2" vid="PRO 29:4">biyya ifii hin balleessa.<verse eid="PRO 29:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5"/>Nami afaan calla'aan nama kookkisu,</para>
  <para style="q2" vid="PRO 29:5">fonxoroo miila ifiititti afa.<verse eid="PRO 29:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6"/>Nami hamaan cubbuu ifiitiin qabama;</para>
  <para style="q2" vid="PRO 29:6">nami balchaan ammoo hin faarfata;</para>
  <para style="q2" vid="PRO 29:6">hin gammadalle'e.<verse eid="PRO 29:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7"/>Nami balchaan marroo haqa hiyyeessaatiif hin haajama;</para>
  <para style="q2" vid="PRO 29:7">Nami hamaan ammoo haajaa hin qabu.<verse eid="PRO 29:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8"/>Namooti namatti murganu qachaa jeeqan;</para>
  <para style="q2" vid="PRO 29:8">namooti qaroon ammoo aarii qabbaneessan.<verse eid="PRO 29:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9"/>Nami qaroon nama gowwaa woliin gara seeraa yoo dhaqe,</para>
  <para style="q2" vid="PRO 29:9">gowwaan sun hin mufata</para>
  <para style="q2" vid="PRO 29:9">yookiin hin murga;</para>
  <para style="q2" vid="PRO 29:9">nageennille hin jiraatu.<verse eid="PRO 29:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10"/>Namooti dhiiga namaa dhangalaasanu,</para>
  <para style="q2" vid="PRO 29:10">nama dhugaammessa jibban;</para>
  <para style="q2" vid="PRO 29:10">nama qajeelaa ijjeesuu barbaadan.<verse eid="PRO 29:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11"/>Nami gowwaan yaada aarii ifii mara dubbata;</para>
  <para style="q2" vid="PRO 29:11">nami qaroon ammoo ossaan ifi qabataa dubbata.<verse eid="PRO 29:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12"/>Bulchaan tokko oduu dharaa yoo caqase,</para>
  <para style="q2" vid="PRO 29:12">qondaaltoti isaa martinuu hamoolee hin te'an.<verse eid="PRO 29:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13"/>Mootiin Waan Maraa isaan lamaaniifuu ila waan kenneef,</para>
  <para style="q2" vid="PRO 29:13">hiyyeessii fi ka hiyyeessa cunqursulle tanaan woluma qixxe'e.<verse eid="PRO 29:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14"/>Mootiin hiyyeessaaf haqaan yoo mure,</para>
  <para style="q2" vid="PRO 29:14">barcumaan mootummaa isaa</para>
  <para style="q2" vid="PRO 29:14">bara dheeraa jabaatee hin dhaabbata.<verse eid="PRO 29:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15"/>Ijoollee xixanee adabuun qarummaa kennitiif;</para>
  <para style="q2" vid="PRO 29:15">ijoolleen gad lakkifante ammoo haadha ifii qaanessiti.<verse eid="PRO 29:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16"/>Yennaa worri hamooleen baallii fudhatanu</para>
  <para style="q2" vid="PRO 29:16">cubbuun hin bacatti;</para>
  <para style="q2" vid="PRO 29:16">balchooti ammoo jinnana isaanii hin dhaggan.<verse eid="PRO 29:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17"/>Ijoollee teeti adabi;</para>
  <para style="q2" vid="PRO 29:17">isaan foora si'iif hin kennan;</para>
  <para style="q2" vid="PRO 29:17">gadhaa keetille hin gammachiisan.<verse eid="PRO 29:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18"/>Addee mudhiin hin jirre,</para>
  <para style="q2" vid="PRO 29:18">kolbaan seera malee teeti;</para>
  <para style="q2" vid="PRO 29:18">nami seera eegatu ammoo ka gammade.<verse eid="PRO 29:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19"/>Tajaajilaan afaan calla'aan hin adabatu;</para>
  <para style="q2" vid="PRO 29:19">inni yoo hubateeyyuu deebii hin kennu.<verse eid="PRO 29:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20"/>Nama dubbii ariifatu dhaggitaa?</para>
  <para style="q2" vid="PRO 29:20">Isa caalaa nama gowwa'atti addii qaba.<verse eid="PRO 29:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21"/>Nami tajaajilaa ifii ijoollummaa isaatii jalqabee qananiisu,</para>
  <para style="q2" vid="PRO 29:21">dhuma irratti gadda ifitti fida.<verse eid="PRO 29:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22"/>Nami aarameessi lola kaasa;</para>
  <para style="q2" vid="PRO 29:22">nami dafee mufatu cubbuu hedduu huja.<verse eid="PRO 29:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23"/>Nami ol ifi qabu salphinna ifitti fida;</para>
  <para style="q2" vid="PRO 29:23">nami gad ifi qabu ammoo ulfinna dhaggata.<verse eid="PRO 29:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24"/>Nami jaala hattu'uu te'u ifi jibba;</para>
  <para style="q2" vid="PRO 29:24">kakatee dhugaa akka bayuuf hin gaafatama;</para>
  <para style="q2" vid="PRO 29:24">dhugaa bayiisaaf ammoo inni itti hin gamu.<verse eid="PRO 29:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25"/>Nama sodaatiis tiyyoo keessa nama seensisa;</para>
  <para style="q2" vid="PRO 29:25">nami Mootii Waan Maraatitti addatu ammoo nageyaan le'a.<verse eid="PRO 29:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26"/>Namooti hedduun bulchaa duratti</para>
  <para style="q2" vid="PRO 29:26">fudhatama dhaggatiisa barbaadan.</para>
  <para style="q1" vid="PRO 29:26">Nami ammoo muraa haqaa</para>
  <para style="q2" vid="PRO 29:26">Mootii Waan Maraa biraa dhaggata.<verse eid="PRO 29:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27"/>Nami balchaan nama hamaa jibba;</para>
  <para style="q2" vid="PRO 29:27">nami hamaalle nama qajeelaa jibba.<verse eid="PRO 29:27"/></para>
  <chapter eid="PRO 29"/>
  <chapter number="30" style="c" sid="PRO 30"/>
  <para style="s1">Jecha Aguurii Ilma Yaaqee</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 30:1"/>Jechi kun jecha Aguurii ilma Yaaqee ti;</para>
  <para style="q2" vid="PRO 30:1">nami kun Itii'elitti,</para>
  <para style="q2" vid="PRO 30:1">Itii'elii fi Ukaalitti dubbate,<verse eid="PRO 30:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PRO 30:2"/>«Ani nama mara caalaa daafana'a;</para>
  <para style="q2" vid="PRO 30:2">hubantii nami qabu ani hin qabu;<verse eid="PRO 30:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PRO 30:3"/>ani qarummaa tokkolle hin baranne;</para>
  <para style="q2" vid="PRO 30:3">ani marroo Waaqa Woyyichaalle womaa hin beeku.<verse eid="PRO 30:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4"/>Ka gara ol-gubba'aa ol dhaqee gad deebi'ee dhufe eennu?</para>
  <para style="q2" vid="PRO 30:4">Ka qilleensa harka ifiitiin wolitti qabe eennu?</para>
  <para style="q1" vid="PRO 30:4">Ka bisaan woyaa ifiitiin mare eennu?</para>
  <para style="q2" vid="PRO 30:4">Ka qaccee lafaa mara jabeessee dhaabe eennu?</para>
  <para style="q1" vid="PRO 30:4">Maqaan isaa eennu? Maqaan ilma isaa eennu?</para>
  <para style="q2" vid="PRO 30:4">Ati yoo beettu teete,</para>
  <para style="q2" vid="PRO 30:4">natti himi!<verse eid="PRO 30:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5"/>«Jechi Waaqaa marti dhuga'a;</para>
  <para style="q2" vid="PRO 30:5">inni worra gara isaa baqate maraaf wonte'e.<verse eid="PRO 30:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6"/>Jecha isaa irratti hin ede'in;</para>
  <para style="q2" vid="PRO 30:6">yoo akkas hin te'in inni si xixa;</para>
  <para style="q2" vid="PRO 30:6">dharaamessalle teetee hin dhagganta» jedhe.<verse eid="PRO 30:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7"/>«Ee Mootii Waan Maraa,</para>
  <para style="q2" vid="PRO 30:7">ani waan lama si kadhadha;</para>
  <para style="q2" vid="PRO 30:7">adoo ani hin du'in</para>
  <para style="q2" vid="PRO 30:7">waan kana lamaan na hin dhooggatin.<verse eid="PRO 30:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8"/>Sobaa fi dhara dubbatiisa na irraa fageessi;</para>
  <para style="q2" vid="PRO 30:8">sagalee guyyuma guyya'aan naa barbaachittu naaf kenni malee,</para>
  <para style="q2" vid="PRO 30:8">durumma'aa fi hiyyummaalle naa hin kennin.<verse eid="PRO 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9"/>Yoo akkas hin te'in,</para>
  <para style="q2" vid="PRO 30:9">ani quufee si hin mormadha;</para>
  <para style="q1" vid="PRO 30:9">‹Mootiin Waan Maraa eennu inni?› si'iin hin jedha;</para>
  <para style="q2" vid="PRO 30:9">yookiin hiyyoommadhee,</para>
  <para style="q2" vid="PRO 30:9">hatee maqaa Waaqa kiyyaa, maqaa keeti hin salphisa.<verse eid="PRO 30:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10"/>«Tajaajilaan akka si hin abaarre,</para>
  <para style="q2" vid="PRO 30:10">atille akka hin rakkanne,</para>
  <para style="q2" vid="PRO 30:10">marroo tajaajilaa tokkoo</para>
  <para style="q2" vid="PRO 30:10">goottaa isaatitti isa hin hamatin.<verse eid="PRO 30:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11"/>Namooti abbaa ifii abaaranu,</para>
  <para style="q2" vid="PRO 30:11">haadha ifiille ka hin saadanne jiran.<verse eid="PRO 30:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12"/>Worri qulluu ifi seyanee,</para>
  <para style="q2" vid="PRO 30:12">ka battummaa ifii</para>
  <para style="q2" vid="PRO 30:12">irraa hin qulqulloomin hin jiran.<verse eid="PRO 30:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13"/>Worri ilaalcha kooraa qabanu,</para>
  <para style="q2" vid="PRO 30:13">ka ila tuffi'iitiin nama ilaalanu,<verse eid="PRO 30:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="PRO 30:14"/>hiyyeessa lafa irraa,</para>
  <para style="q2" vid="PRO 30:14">rakkataa odduu ilmaan namaatii</para>
  <para style="q2" vid="PRO 30:14">nyaatanee balleessiisaaf,</para>
  <para style="q2" vid="PRO 30:14">worri ilkaan isaanii shallaagaa,</para>
  <para style="q2" vid="PRO 30:14">a'oon isaaniille billowa te'e jiran.<verse eid="PRO 30:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15"/>«Ulaa'ulti ijoollee durraa</para>
  <para style="q2" vid="PRO 30:15">ta, ‹Kenni! Kenni!›</para>
  <para style="q2" vid="PRO 30:15">jedhaa iyyitu lama qaddi;</para>
  <para style="q1" vid="PRO 30:15">‹Ijjumaa quufe› ka hin jenne</para>
  <para style="q2" vid="PRO 30:15">waan saditti jira;</para>
  <para style="q2" vid="PRO 30:15">ta arfeesso'oolle ijjumaa ‹Na geye›</para>
  <para style="q2" vid="PRO 30:15">hin jettu:<verse eid="PRO 30:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="PRO 30:16"/>isaanille, addee worri du'e jiru,</para>
  <para style="q2" vid="PRO 30:16">gadaamessa maseena,</para>
  <para style="q2" vid="PRO 30:16">lafa bisaan hin quunnee fi</para>
  <para style="q2" vid="PRO 30:16">ibidda ijjumaa, ‹Na geye› hin jenne.<verse eid="PRO 30:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17"/>«Nama abbaa ifiititti murguu fi</para>
  <para style="q2" vid="PRO 30:17">ajaja haadha ifiille tuffatu,</para>
  <para style="q2" vid="PRO 30:17">harraaqessi gammoojji'ii ila isaa</para>
  <para style="q2" vid="PRO 30:17">isa keessaa hin fuudha;</para>
  <para style="q2" vid="PRO 30:17">rumichille isa hin nyaata.<verse eid="PRO 30:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 30:18"/>«Wonni na baaseffachiisu sad yookiin</para>
  <para style="q2" vid="PRO 30:18">afur ta hubatiisa hin dandeennetti jiraayyu;<verse eid="PRO 30:18"/></para>
  <para style="q2">
    <verse number="19" style="v" sid="PRO 30:19"/>isaanille, karaa risa'aa ka gubbaa irraa,</para>
  <para style="q2" vid="PRO 30:19">karaa bofaa ka rassaa irraa,</para>
  <para style="q2" vid="PRO 30:19">karaa hobolo'oo ka abbaayaa irraatii fi</para>
  <para style="q2" vid="PRO 30:19">karaa dhiirtii fi dubartiin wol jaalatanu.<verse eid="PRO 30:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20"/>«Karaan dubartii gaarayyeeffattu'uu kana:</para>
  <para style="q2" vid="PRO 30:20">Isiin nyaattee afaan ifii haxowattee,</para>
  <para style="q2" vid="PRO 30:20">‹Ani womaa dokonkora hin hunye› jetti.<verse eid="PRO 30:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 30:21"/>«Latti waan sadiiniin yookiin afuriin tachooti;</para>
  <para style="q2" vid="PRO 30:21">dandeetteelle hin ba'attu;<verse eid="PRO 30:21"/></para>
  <para style="q2">
    <verse number="22" style="v" sid="PRO 30:22"/>isaanille, garbichi yennaa mootii te'e,</para>
  <para style="q2" vid="PRO 30:22">gowwaan yennaa quufe,<verse eid="PRO 30:22"/></para>
  <para style="q2">
    <verse number="23" style="v" sid="PRO 30:23"/>dubartiin jibbatante yennaa dhirsa dhaggattee fi</para>
  <para style="q2" vid="PRO 30:23">garbittiin yennaa addee giittii ifii fudhate.<verse eid="PRO 30:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 30:24"/>«Wonni didiqqoon afur,</para>
  <para style="q2" vid="PRO 30:24">ka guddoo qaroo te'an biyya lafaa irra jiran:<verse eid="PRO 30:24"/></para>
  <para style="q2">
    <verse number="25" style="v" sid="PRO 30:25"/>mixaan hunna hin qabu,</para>
  <para style="q2" vid="PRO 30:25">te'uu malee sagalee ifii bona wolitti qabata;<verse eid="PRO 30:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 30:26"/>Osoleen hunnaa hin qaddu,</para>
  <para style="q2" vid="PRO 30:26">te'uu malee odduu rassa'aatitti galti;<verse eid="PRO 30:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 30:27"/>Awwaannisi mootii hin qabu,</para>
  <para style="q2" vid="PRO 30:27">te'uu malee akka loltootaa seeraan ideema.<verse eid="PRO 30:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 30:28"/>Qarcoon<note caller="+" style="f"><char style="fr" closed="false">30:28 </char><char style="fqa" closed="false">Qarcoon: </char><char style="ft" closed="false">Lafa tokko tokkotti lootuu jedhanti.</char></note> harkaan qabamuu dandeetti;</para>
  <para style="q2" vid="PRO 30:28">te'uu malee mana mootumma'aa keessatti dhagganti.<verse eid="PRO 30:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 30:29"/>«Wonni ideensa tolanu sad yookiin afur</para>
  <para style="q2" vid="PRO 30:29">ka arnya ulfinnaa qabanu jiran:<verse eid="PRO 30:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 30:30"/>Neenqa bineensota mara keessaa jaba'aa,</para>
  <para style="q2" vid="PRO 30:30">ka waan mara irraa duubatti hin deebine;<verse eid="PRO 30:30"/></para>
  <para style="q2">
    <verse number="31" style="v" sid="PRO 30:31"/>kormi lukku'uutii fi</para>
  <para style="q2" vid="PRO 30:31">korbeessi re'e'ee ka bondhooranu,</para>
  <para style="q2" vid="PRO 30:31">mootii loltoota ifiitiin marfamee ideemu.<verse eid="PRO 30:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32"/>«Gowwaa teetee, yoo ol ol ifi qadde,</para>
  <para style="q2" vid="PRO 30:32">yookiin hantuu yoo yaadatte,</para>
  <para style="q2" vid="PRO 30:32">afaan keeti qabadhu.<verse eid="PRO 30:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33"/>Akkuma aanan raasiis dhadhaa baasu,</para>
  <para style="q2" vid="PRO 30:33">akkuma funnaan micciiriis dhiiga baasu,</para>
  <para style="q2" vid="PRO 30:33">tuttuqanee nama aarsuun lola kaasa» jedhe.<verse eid="PRO 30:33"/></para>
  <chapter eid="PRO 30"/>
  <chapter number="31" style="c" sid="PRO 31"/>
  <para style="s1">Gorsa Mootichaaf Kenname</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1"/>Jechi asii gadii kun ka haati Lemu'elii mootichaa isa barsiitte:<verse eid="PRO 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2"/>«Ee ilma kiyya,</para>
  <para style="q2" vid="PRO 31:2">ilma gadaamessa kiyyaa,</para>
  <para style="q2" vid="PRO 31:2">ilma Waadaa kiyyaa,<verse eid="PRO 31:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PRO 31:3"/>hunna teeti dubartoota irratti hin fixin;</para>
  <para style="q2" vid="PRO 31:3">yennaa teetille dubartoota mootota balleessitu irratti hin fixin.<verse eid="PRO 31:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4"/>«Ee Lemu'el, moototi daadhii woyni'ii unuu hin qabanu;</para>
  <para style="q2" vid="PRO 31:4">bulchitootille untoo nama macheessitu unuu hin qabanu.<verse eid="PRO 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5"/>Isaan yoo unane,</para>
  <para style="q2" vid="PRO 31:5">seera hin dedhan;</para>
  <para style="q2" vid="PRO 31:5">worra cunqurfame mara haqa hin dhooggan.<verse eid="PRO 31:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6"/>Untoo nama macheessitu,</para>
  <para style="q2" vid="PRO 31:6">nama badiisatti jiruuf,</para>
  <para style="q2" vid="PRO 31:6">daadhii woyni'iille nama farra hantuu keessa jiruuf kenni.<verse eid="PRO 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7"/>Isaan unanee hiyyummaa ifii dedhanuu ti;</para>
  <para style="q2" vid="PRO 31:7">farra ifiille deebi'anee hin qaabatin.<verse eid="PRO 31:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8"/>«Ati worra ifiif dubbatuu hin dandeenneef dubbadhu;</para>
  <para style="q2" vid="PRO 31:8">worra qarqaarsa hin qanne maraaf falmadhu.<verse eid="PRO 31:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9"/>Dubbadhu;</para>
  <para style="q2" vid="PRO 31:9">dhugaa muri.</para>
  <para style="q1" vid="PRO 31:9">Haqa hiyyeessaatii fi</para>
  <para style="q2" vid="PRO 31:9">rakkata'aatiif falmadhu» jette.<verse eid="PRO 31:9"/></para>
  <para style="s1">Niitii Amala Dansaa qaddu</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 31:10"/>Niitii qalbii qaddu eentu dhaggatuu dande'a?</para>
  <para style="q2" vid="PRO 31:10">Isiin dooqa diimaa caalti.<verse eid="PRO 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11"/>Dhirsi isi'ii gadhaa tokkochaan isii addata;</para>
  <para style="q2" vid="PRO 31:11">Inni waan tokkolle hin dhabu.<verse eid="PRO 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12"/>Bara jiruu isi'ii mara waan dansaa isaaf gooti malee,</para>
  <para style="q2" vid="PRO 31:12">waan hantuu isa irratti hin hujju.<verse eid="PRO 31:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13"/>Isiin rifeensa hoole'eetii fi quncee talba'aa barbaaddee,</para>
  <para style="q2" vid="PRO 31:13">harka ifiitiin woyaa dhootti.<verse eid="PRO 31:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14"/>Isiin akkuma hoboloota gugurdoo daldaltootaa,</para>
  <para style="q2" vid="PRO 31:14">biyya fago'oo irraa sagalee fiddi.<verse eid="PRO 31:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15"/>Isiin ganama adoo latti hin bari'in kaatee,</para>
  <para style="q2" vid="PRO 31:15">maatii ifiitiif sagalee kenniti;</para>
  <para style="q2" vid="PRO 31:15">durra tajaajiltoota ifiitiifille</para>
  <para style="q2" vid="PRO 31:15">hujii isaanii itti qooddi.<verse eid="PRO 31:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16"/>Isiin fichaa qorqortee bitatti;</para>
  <para style="q2" vid="PRO 31:16">bu'aa hujii harka ifiitiin</para>
  <para style="q2" vid="PRO 31:16">muka woyni'ii dhaabbatti.<verse eid="PRO 31:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17"/>Isiin hunnaan hujii ifii hujatti;</para>
  <para style="q2" vid="PRO 31:17">irreen isi'iille huji'iif jaddu'u.<verse eid="PRO 31:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18"/>Hujiin isi'ii bu'aa akka qaddu hin beetti;</para>
  <para style="q2" vid="PRO 31:18">issaan isi'iille halkan hin dhaamu.<verse eid="PRO 31:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19"/>Harka ifiitiin fuuttaa qabatti.</para>
  <para style="q2" vid="PRO 31:19">Quba ifiitiin liqaaqaa irbiti.<verse eid="PRO 31:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20"/>Isiin hiyyeessaaf hin kenniti;</para>
  <para style="q2" vid="PRO 31:20">rakkataalle hin qarqaarti.<verse eid="PRO 31:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21"/>Maatiin isi'ii martinuu</para>
  <para style="q2" vid="PRO 31:21">woyaa qorra nama irraa dhooggitu waan qabanuuf,</para>
  <para style="q2" vid="PRO 31:21">yennaa rooba dhaka'aa isaaniif hin yaaddottu.<verse eid="PRO 31:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22"/>Isiin woyaa taqee ifii irra afattu dhowatti;</para>
  <para style="q2" vid="PRO 31:22">isiin woyaa dansaa quncee talba'aa irraa hujantee fi</para>
  <para style="q2" vid="PRO 31:22">woyaa dhiillee uffatti.<verse eid="PRO 31:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23"/>Dhirsi isi'ii jaarsolee biyyaa odduu,</para>
  <para style="q2" vid="PRO 31:23">badhinna karra qacha'aa yennaa tee'u ulfinna qaba.<verse eid="PRO 31:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24"/>Isiin quncee talba'aa irraa woyaa dhoottee gurgurti;</para>
  <para style="q2" vid="PRO 31:24">daldaltootaafille hiituu gurgurti.<verse eid="PRO 31:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25"/>Isiin hunnaa fi ulfinna akka woya'aa uffatti;</para>
  <para style="q2" vid="PRO 31:25">bara dhufaaru itti gammaddi.<verse eid="PRO 31:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26"/>Isiin qarumma'aan dubbatti;</para>
  <para style="q2" vid="PRO 31:26">afaan isi'ii keessa barsiisa dansa'atti jira.<verse eid="PRO 31:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27"/>Isiin jireenna maatii ifii akka dansaa eeddi;</para>
  <para style="q2" vid="PRO 31:27">isiin booseyaa moti.<verse eid="PRO 31:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28"/>Ijoolleen isi'ii lafaa kaatee,</para>
  <para style="q2" vid="PRO 31:28">«Gammadee» jettee isii waanti;</para>
  <para style="q2" vid="PRO 31:28">abbaan manaa isi'iille akkasuma jedhaa, isii leellisaa,<verse eid="PRO 31:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29"/>«Dubartooti hedduun waan dansaa hujaneeran;</para>
  <para style="q2" vid="PRO 31:29">ati ammoo isaan mara hin caalta» jedhaan.<verse eid="PRO 31:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30"/>Miidhagiis nama soba;</para>
  <para style="q2" vid="PRO 31:30">dansummaan hin baddi;</para>
  <para style="q2" vid="PRO 31:30">dubartiin Mootii Waan Maraa sodaattu ammoo hin leellifanti.<verse eid="PRO 31:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31"/>Bu'aa hujii isi'iitiif badhaasa kenna'aaf!</para>
  <para style="q2" vid="PRO 31:31">Hujiin isi'ii badhinna karra</para>
  <para style="q2" vid="PRO 31:31">qacha'aatitti isii leellittuu ti.<verse eid="PRO 31:31"/></para>
  <chapter eid="PRO 31"/>
</usx>
