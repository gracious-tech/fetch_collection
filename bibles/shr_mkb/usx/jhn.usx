<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- Bible en mashi du Congo</book>
  <para style="toc3">Ywn</para>
  <para style="toc2">Yowane</para>
  <para style="toc1">YOWANE</para>
  <para style="h">YOWANE</para>
  <para style="mt1">YOWANE/YOHANA</para>
  <para style="is">EMYANZI Y’AKALEMBE YAYANDIKAGWA NA MUTAGATÎFU YOWANE</para>
  <chapter number="1" style="c" sid="JHN 1"/>
  <para style="s1">Enshokolezi</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1"/>Aha murhondêro<note caller="+" style="f"><char style="fr" closed="false">1, 1 </char><char style="ft" closed="false">idômero ly’amandiko omu cigereki, https:/ /www.academic-bible.com/en/online-bibles/novum-testamentum-graece-na-28/read-the-bible-text/bibel/text/lesen/stelle/53/210001/219999/ch/6acb45d0b66bf43d0c2743fde185e082/ (13.05.2021).</char></note>, erhi Luderho<note caller="+" style="f"><char style="fr" closed="false">1, 1 </char><char style="ft" closed="false">Luderho ye Mugala wa Nyamuzinda, ye Mupersona wa kabiri w’Obusharhu Butagatîfu (<char style="xt"><ref loc="JHN 1:1-18">Ywn 1, 1-18</ref></char>).</char></note> ho àbâ, na Luderho àli haguma na Nyamuzinda, na Luderho àli Nyamuzinda. <verse eid="JHN 1:1"/><verse number="2" style="v" sid="JHN 1:2"/>Kurhenga omurhondêro àli haguma na Nyamuzinda. <verse eid="JHN 1:2"/><verse number="3" style="v" sid="JHN 1:3"/>Byoshi ye wabijiraga, n’omu biremwa byoshi, ntâco calemirwe cirhanalemirwi naye. <verse eid="JHN 1:3"/><verse number="4" style="v" sid="JHN 1:4"/>Obuzîne muli ye bwàli, n’obuzîne bwo bwàli bulangashane bw’abantu. <verse eid="JHN 1:4"/><verse number="5" style="v" sid="JHN 1:5"/>Obulangashane bwamoleka omu mwizimya, n’omwizimya gurhabuzimagya.<verse eid="JHN 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6"/>Hanaciyisha omuntu wali orhumirwe na Nyamuzinda: izîno lyâge ye Yowane<note caller="+" style="f"><char style="fr" closed="false">1, 6 </char><char style="ft" closed="false">Yowane Mubatiza oyo.</char></note>. <verse eid="JHN 1:6"/><verse number="7" style="v" sid="JHN 1:7"/>Ayisha nka muhamîrizi, mpu abè muhamîrizi w’obulangashane, lyo abantu boshi bayêmêra. <verse eid="JHN 1:7"/><verse number="8" style="v" sid="JHN 1:8"/>Arhali ye wali bulangashane, ci kabalamwanzi k’obulangashane.<verse eid="JHN 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 1:9"/>Luderho ye wali bulangashane bw’okuli, bumolekera ngasi muntu; anaciyisha en’igulu. <verse eid="JHN 1:9"/><verse number="10" style="v" sid="JHN 1:10"/>Ali en’igulu, n’igulu ye waliremaga, n’igulu lirhamumanyaga. <verse eid="JHN 1:10"/><verse number="11" style="v" sid="JHN 1:11"/>Ayisha omu bâge, n’abâge barhamuyankiriraga. <verse eid="JHN 1:11"/><verse number="12" style="v" sid="JHN 1:12"/>Ci ngasi boshi bamuyankirîre, abahîre obuhashe bw’okuhinduka bâna ba Nyamuzinda: bo balya bamuyêmêra, <verse eid="JHN 1:12"/><verse number="13" style="v" sid="JHN 1:13"/>ye rhaburhagwa na mukò, erhi n’okulonza kw’omubiri, nîsi erhi n’okulonza kw’omuntu, ci owaburhagwa na Nyamuzinda. <verse eid="JHN 1:13"/><verse number="14" style="v" sid="JHN 1:14"/>Nêci, Luderho acîjizire muntu, anabêra muli rhwe. Nîrhu rhwabwîne irenge lyâge, irenge Nyamuzinda-Îshe ahîre Omugala cûsha, oyunjwîre inêma n’okuli.<verse eid="JHN 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15"/>Yowane ahamîriza, erhi: «Y’oyu ye naderhaga, nti: Owayisha enyuma zâni ye wantangaga, bulya erhi ntac’ibà, erhi ho ali». <verse eid="JHN 1:15"/><verse number="16" style="v" sid="JHN 1:16"/>Nêci, rhweshi rhwahîrwe oku bwimâna bwâge, rhwahâbwa amanêma oku-manêma<note caller="+" style="f"><char style="fr" closed="false">1, 16 </char><char style="ft" closed="false">Kwo kuderha oku amanêma g'Amalaganyo mahyâhya gajire ahâli h’amanêma g’Amalaganyo ga mîra. </char></note>. <verse eid="JHN 1:16"/><verse number="17" style="v" sid="JHN 1:17"/>Bulya amarhegeko rhwagahîrwe na Mûsa, ci inêma n’okuli rhwabidwirhîrwe na Yezu Kristu.<verse eid="JHN 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 1:18"/>Ntà muntu ciru n’omuguma osag’ibona Nyamuzinda; Omugala cûsha yêne, ôbà muli Îshe, ye warhumanyisagyaye.<verse eid="JHN 1:18"/></para>
  <para style="ms1">I. Oburhumisi n’enyigîrizo za Yezu</para>
  <para style="s1">Obuhamîrizi bwa Yowane</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19"/>Alaga obuhamîrizi bwa Yowane, erhi Abayahudi bamurhumira abadâhwa na bene-Levi kurhenga e Yeruzalemu mpu bagend’imudôsa, mpu: «We ndi?» <verse eid="JHN 1:19"/><verse number="20" style="v" sid="JHN 1:20"/>Anacibabwîra n’obwâlagale, arhalahiraga, ababwîra n’obwâlagale, erhi: «Arhali nie Kristu». <verse eid="JHN 1:20"/><verse number="21" style="v" sid="JHN 1:21"/>Nabo badôsa, mpu: «Oligi ndi? Ka we Eliya?» Naye, erhi: «Nanga». Mpu: «Ka we Mulêbi?» Abashuza, erhi: «Nanga». <verse eid="JHN 1:21"/><verse number="22" style="v" sid="JHN 1:22"/>Banacimubwîra, mpu: «Oligi ndi, lyo rhushuza abarhurhumire? Kurhi ociderha wêne?» <verse eid="JHN 1:22"/><verse number="23" style="v" sid="JHN 1:23"/>Naye, erhi: «Nie izù lyayakûliza omu irungu: Muyumanyanye enjira ya Nyakasane, nka oku omulêbi Izaya adesire». <verse eid="JHN 1:23"/><verse number="24" style="v" sid="JHN 1:24"/>Balya bâli barhumirwe bâli Bafarizeyi. <verse eid="JHN 1:24"/><verse number="25" style="v" sid="JHN 1:25"/>Bashub’imudôsa, mpu: «Cirhuma ocibatiza akabà orhali we Kristu, orhanali Eliya erhi Mulêbi?» <verse eid="JHN 1:25"/><verse number="26" style="v" sid="JHN 1:26"/>Yowane abashuza, erhi: «Nie ono mbatiza n’amîshi. Ci ekarhî kinyu hali oyo murhishi: <verse eid="JHN 1:26"/><verse number="27" style="v" sid="JHN 1:27"/>Ye wâyisha enyuma zâni; ciru ntakwânîni nshwêkûle omugozi gw’enkwêrho zâge». <verse eid="JHN 1:27"/><verse number="28" style="v" sid="JHN 1:28"/>Ebyo byàbâga e Betaniya, ishiriza lya Yordani, emunda Yowane akâg’ibatiziza.<verse eid="JHN 1:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29"/>Erhi kuca, Yowane abona Yezu amujayo, aderha, erhi: «Oyu ye Mwâna-buzi<note caller="+" style="f"><char style="fr" closed="false">1, 29 </char><char style="ft" closed="false">Yezu ali nka mwâna-buzi warhumagwa na Nnâmahanga mpu arhufire. Emwa Abayahudi, omwâna-buzi yo yali nterekêro y’okurhenza ebyâha n’okulungana na Nnâmahanga.</char></note> wa Nnâmahanga okûla ecâha c’igulu. <verse eid="JHN 1:29"/><verse number="30" style="v" sid="JHN 1:30"/>“Y’oyu ye naderhaga, nti”: “Oyishire enyuma zâni antalusire, bulya ye wantangag’ibàho”. <verse eid="JHN 1:30"/><verse number="31" style="v" sid="JHN 1:31"/>“Nâni ntâl’imuyishi; ci ye warhumire nyisha nti mbatize n’amîshi, lyo amanyibwa omu Israheli.”» <verse eid="JHN 1:31"/><verse number="32" style="v" sid="JHN 1:32"/>Yowane abà­bwîra, erhi: «Nabwîne Mûka ayandagala emalunga nka ngûkù anamuyimangakwo. <verse eid="JHN 1:32"/><verse number="33" style="v" sid="JHN 1:33"/>“Nâni ntâl’imuyishi, ci owantumaga mpu mbatize n’amîshi ali erhi ambwîzire, erhi”: “Oyu wâbone Mûka ayandagalirakwo anamuyimangako, erhi ye batiza muli Mûka<note caller="+" style="f"><char style="fr" closed="false">1, 33 </char><char style="ft" closed="false">Omukolo gwa Yezu kuli kuhà abantu Mûka Mutagatîfu, ye buzigire bwa Nyamuzinda.</char></note> Mutagatîfu”. <verse eid="JHN 1:33"/><verse number="34" style="v" sid="JHN 1:34"/>“Nêci, nabwîne nanahamîriza oku oyo ye Mwîshogwa wa Nnâmahanga”».<verse eid="JHN 1:34"/></para>
  <para style="s1">Abaganda barhanzi</para>
  <para style="r">(<ref loc="MAT 4:18-20">Mat 4, 18-20</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35"/>Erhi buca, Yowane erhi kandi ali halya n’abaganda babiri. <verse eid="JHN 1:35"/><verse number="36" style="v" sid="JHN 1:36"/>Anacilolêreza Yezu erhi agera, aderha, erhi: «Oyu ye Mwâna-buzi wa Nnâmahanga». <verse eid="JHN 1:36"/><verse number="37" style="v" sid="JHN 1:37"/>Balya baganda babiri erhi bayumva ntyo, bashimba Yezu. <verse eid="JHN 1:37"/><verse number="38" style="v" sid="JHN 1:38"/>Yezu akabaga­na, abona bamukulikîre; anacibadôsa, erhi: «Cici mwalonza?» Nabo, mpu: «Rabi -kwo kuderha Muyigîriza- ngahi ôbà?» <verse eid="JHN 1:38"/><verse number="39" style="v" sid="JHN 1:39"/>Ababwîra, erhi: «Yishi muhabone». Bayisha, babona ah’abâga, banalegerera bo naye olwo lusiku. Zàli nka nsâ ikumi. <verse eid="JHN 1:39"/><verse number="40" style="v" sid="JHN 1:40"/>Balya babiri bayumvagya ebinwa bya Yowane banakulikiraga Yezu, bàlimwo Andreya, mulumuna wa Simoni Petro. <verse eid="JHN 1:40"/><verse number="41" style="v" sid="JHN 1:41"/>Erhi izûba lirhenga emashinji, ashimâna mukulu wâge Simoni Petro, amubwîra, erhi: «Rhwabuganyire Masiha». <verse eid="JHN 1:41"/><verse number="42" style="v" sid="JHN 1:42"/>Amuhekera Mwâmi Yezu. Erhi Yezu amusinza, amubwîra, erhi: «We Simoni, mwene Yônà; we kola Kefa» -kwo kuderha Ibuye.<verse eid="JHN 1:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43"/>Erhi kuca, Yezu erhi alâlire ekuja e Galileya. Anacishimâna Filipo, amubwîra, erhi: «Nshimba». <verse eid="JHN 1:43"/><verse number="44" style="v" sid="JHN 1:44"/>Filipo àli w’e Betisayida, emwâbo Andreya na Petro. <verse eid="JHN 1:44"/><verse number="45" style="v" sid="JHN 1:45"/>Filipo anacishigâna Natanaeli, amubwîra, erhi: «Olya Mûsa aderhaga omu citabu c’Amarhegeko n’oyu abalêbi balêbaga, rhwamubwîne: ye Yezu, Mwene Yozefu, w’e Nazareti!» <verse eid="JHN 1:45"/><verse number="46" style="v" sid="JHN 1:46"/>Natanaeli amushuza, erhi: «K’e Nazareti ya­nkarhenga akantu kinjà?» Naye Filipo, erhi: «Yisha, ocîbonere». <verse eid="JHN 1:46"/><verse number="47" style="v" sid="JHN 1:47"/>Erhi Yezu abona Natanaeli amujaho, anaciderha, erhi: «Y’oyu ye Mwisraheli w’okuli, orhabamwo bulenzi». <verse eid="JHN 1:47"/><verse number="48" style="v" sid="JHN 1:48"/>Natanaeli, erhi: «Ngahi wammanyiraga?» Yezu amushuza, erhi: «Embere Filipo akuhamagale, bulya wali idako ly’omulehe, erhi nakubona». <verse eid="JHN 1:48"/><verse number="49" style="v" sid="JHN 1:49"/>Natanaeli amubwîra, erhi: «Rabi, we Mwene Nyamuzinda, we mwâmi w’Israheli». <verse eid="JHN 1:49"/><verse number="50" style="v" sid="JHN 1:50"/>Yezu amushuza anamubwîra, erhi: «Wamayêmêra bulya nakubwîzire nti nakubwîne idako ly’omulehe! Wacibona ebilushire aho!» <verse eid="JHN 1:50"/><verse number="51" style="v" sid="JHN 1:51"/>Anacimubwîra, erhi: «Okuli, okuli, mmubwîzire: mwâcibona irunga liri liyigule na bamalahika ba Nyamuzinda badwîrhe barherema banayandagala enyanya lya Mwene-omuntu.»<verse eid="JHN 1:51"/></para>
  <chapter eid="JHN 1"/>
  <chapter number="2" style="c" sid="JHN 2"/>
  <para style="s1">Obuhya e Kana</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1"/>Olusiku lwa kasharhu<note caller="+" style="f"><char style="fr" closed="false">2, 1 </char><char style="ft" closed="false">olusiku lwa kasharhu: Kurhenga ashimânana bona Filipo na Natanaeli.</char></note>, habà obuhya e Kana omu Galileya. Nnina wa Yezu erhi yo ali. <verse eid="JHN 2:1"/><verse number="2" style="v" sid="JHN 2:2"/>Naye Yezu àli mulâlike kw’obwo buhya bo n’abaganda bâge. <verse eid="JHN 2:2"/><verse number="3" style="v" sid="JHN 2:3"/>Lêro idivayi lyanacibula, bulya idivayi ly’obuhya lyàli erhi lyamâhwa. Nnina wa Yezu anacimubwîra, erhi: «Barhacigwerh’idivayi». <verse eid="JHN 2:3"/><verse number="4" style="v" sid="JHN 2:4"/>Naye Yezu amushuza, erhi: «Nyoko we, k’okwo kurhuyêrekîre? Amango gâni garhacihika». <verse eid="JHN 2:4"/><verse number="5" style="v" sid="JHN 2:5"/>Nnina aj’ibwîra abarhumisi, erhi: «Ngasi oku akammubwîra, mukujire». <verse eid="JHN 2:5"/><verse number="6" style="v" sid="JHN 2:6"/>Hàli rhubindi ndarhu rhwa mabuye, rhw’okuhiramwo amîshi Abayahudi bakalaba, ngasi kaguma ka ngero ibiri erhi isharhu. <verse eid="JHN 2:6"/><verse number="7" style="v" sid="JHN 2:7"/>Yezu ababwîra, erhi: «Yunjuzi orhu rhubindi mîshi». Barhumbumba kuhika oku muhiro. <verse eid="JHN 2:7"/><verse number="8" style="v" sid="JHN 2:8"/>Ashub’ibabwîra, erhi: «Domagi, muhekere omushongwe». Banacimuhêkera. <verse eid="JHN 2:8"/><verse number="9" style="v" sid="JHN 2:9"/>Erhi omushongwe alabulakwo galya mîshi gahindusire divayi, arhànali amanyire aha eryo divayi lyarhengaga, ci abarhumisi bàl’idôma amîshi erhi bamanyire bwinjà, ahamagala omuhya mulume, <verse eid="JHN 2:9"/><verse number="10" style="v" sid="JHN 2:10"/>amubwîra, erhi: «Kali abandi idivayi linjà barhang’ihâna, n’erhi abantu bakolabalimwo orukara, lyo barhanza elirhali linjà. Ci wêhe wal’irhanzir’ibîka idivayi linjà kuhika buno!» <verse eid="JHN 2:10"/><verse number="11" style="v" sid="JHN 2:11"/>Co cisômerîne cirhanzi ca Yezu eco. Acijiraga e Kana omu Galileya. Ayêrekana irenge lyâge, n’abaganda bâge bamuyêmêra. <verse eid="JHN 2:11"/><verse number="12" style="v" sid="JHN 2:12"/>Okubundi anaciyandagalira e Kafarnaumu bo na nnina, na bene wâbo<note caller="+" style="f"><char style="fr" closed="false">2, 12 </char><char style="ft" closed="false">Bene wâbo Yezu bo bantu b’omulala gwa Mariya na Yozefu.</char></note>, n’abaganda bâge. Ajirayo nsiku nsungunu.<verse eid="JHN 2:12"/></para>
  <para style="s1">Yezu ahulusa abakâg’iguliza omu ka-Nyamuzinda</para>
  <para style="r">(<ref loc="MAT 21:12-13">Mat 21, 12-13</ref>; <ref loc="MRK 11:15-17">Mrk 11, 15-17</ref>; <ref loc="LUK 19:45-46">Luk 19, 45-46</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13"/>Basâka w’Abayahudi erhi àbà hôfi, Yezu ayinamukira e Yeruzalemu. <verse eid="JHN 2:13"/><verse number="14" style="v" sid="JHN 2:14"/>Abugâna abarhunzi omu ka-Nyamuzinda bakâg’irhimbûla enkafu, ebibuzi n’engûkù, n’abandi badahîre erhi badwîrhe bakâba. <verse eid="JHN 2:14"/><verse number="15" style="v" sid="JHN 2:15"/>Ayanka omugozi, ahunga omunyuli, abahulusa boshi omu ka-Nyamuzinda bo n’ebibuzi n’enkafu zâbo; ashandâza ensaranga z’abakâg’ikâba n’oburhalulè bwâbo abukunungula. <verse eid="JHN 2:15"/><verse number="16" style="v" sid="JHN 2:16"/>Anacibwîra abarhunzi b’engûkù, erhi: «Rhenzi ebi. Enyumpa ya Larha murhayihindulaga cibuye». <verse eid="JHN 2:16"/><verse number="17" style="v" sid="JHN 2:17"/>Abaganda bâge bakengêra eci cinwa c’Amandiko: «Obushiru bw’enyumpa yâwe bwayish’indya»<note caller="+" style="f"><char style="fr" closed="false">2, 17 </char><char style="ft" closed="false">Olulanga lwa <char style="xt" link-href="PSA 69:10"><ref loc="PSA 69:68--1">69(68), 10</ref></char>.</char></note>. <verse eid="JHN 2:17"/><verse number="18" style="v" sid="JHN 2:18"/>Obwo Abayahudi banacijaho, bamubwîra, mpu: «Cimanyîso cici orhuyêresiremwo obuhashe bw’okujira ntya?» <verse eid="JHN 2:18"/><verse number="19" style="v" sid="JHN 2:19"/>Naye Yezu abashuza, erhi: «Shabûli aka ka-Nyamuzinda; nashub’ikayimanza omu nsiku isharhu». <verse eid="JHN 2:19"/><verse number="20" style="v" sid="JHN 2:20"/>Abayahudi bamubwîra, mpu: «Aka ka-Nyamuzinda kayûbasirwe myâka makumi anni na ndarhu, nâwe mpu wâshub’ikayimanza omu nsiku isharhu?» <verse eid="JHN 2:20"/><verse number="21" style="v" sid="JHN 2:21"/>Ci yêhe ka-Nyamuzinda k’omubiri gwâge aderhaga. <verse eid="JHN 2:21"/><verse number="22" style="v" sid="JHN 2:22"/>Erhi abà amâfûka omu bafù lyo abaganda bâge bakengîre ako kanwa; bayêmêra Amandiko n’akanwa Yezu aderhaga.<verse eid="JHN 2:22"/></para>
  <para style="s1">Yezu omu Yeruzalemu</para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23"/>Amango ali e Yeruzalemu oku lusiku lukulu lwa Basâka, bantu banji bayêmêra oku izîno lyâge, erhi bamâbona ebisômerîne akâg’ijira. <verse eid="JHN 2:23"/><verse number="24" style="v" sid="JHN 2:24"/>Ci Yezu yêhe arhacîkubagiragabo, bulya àli abamanyire boshi, <verse eid="JHN 2:24"/><verse number="25" style="v" sid="JHN 2:25"/>arhanali alagîrîre oku­bwîrwa na ndi: àli amanyire akali aha murhima gwa ngasi muntu.<verse eid="JHN 2:25"/></para>
  <chapter eid="JHN 2"/>
  <chapter number="3" style="c" sid="JHN 3"/>
  <para style="s1">Yezu ayigîriza Nikodemu</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1"/>Hàli mulume muguma w’omu Bafarizeyi, izîno lyâge Nikodemu, muguma omu bagula b’Abayahudi. <verse eid="JHN 3:1"/><verse number="2" style="v" sid="JHN 3:2"/>Anacijà emwa Yezu budufu, amubwîra, erhi: «Rabi, rhumanyire oku we Mwigîriza warhumagwa na Nnâmahanga; ntâye wa­nkajira ebisômerîne odwîrhe wajira nka Nyamuzinda arhali bo naye». <verse eid="JHN 3:2"/><verse number="3" style="v" sid="JHN 3:3"/>Yezu amushuza, erhi: «Okuli, okuli, nkubwîzire, ntâye wankabona Obwâmi bwa Nyamuzinda nka arhashubir’iburhwa buhyâhya». <verse eid="JHN 3:3"/><verse number="4" style="v" sid="JHN 3:4"/>Nikodemu amubwîra, erhi: «Kurhi omuntu akaciburhwa anakola mushosi?» <verse eid="JHN 3:4"/><verse number="5" style="v" sid="JHN 3:5"/>Yezu amushuza, erhi: «Okuli, okuli, nkubwîzire, ntâye wankajà omu Bwâmi bwa Nyamuzinda nka arhashubir’iburhwa omu mîshi na muli Mûka Mutagatîfu<note caller="+" style="f"><char style="fr" closed="false">3, 5 </char><char style="ft" closed="false">Okuburhwa omu mîshi na muli Mûka Mutagatîfu kwo kubatizibwa. Nka kulyâla ntâye wa­nkamanya kurhi empûsi egenda, ntyo ntêye wankayumva enjira za Mûka Mutagatîfu. Co cirhuma abantu bahêkwa na Mûka Mutagatîfu, kanji barhayumvibwa n’abandi bantu. Ciru hali abatagatîfu bakâg’iderhwa basirhe, bulya ebijiro byâbo birhàli nka bya bandi bantu</char></note>. <verse eid="JHN 3:5"/><verse number="6" style="v" sid="JHN 3:6"/>“Eciburhwa n’omubiri guli mubiri, n’eciburhwa na Mûka guli mûka”. <verse eid="JHN 3:6"/><verse number="7" style="v" sid="JHN 3:7"/>“Orhasômeragwa obwenge nkubwîzire, nti”: “Kukwânîne okuburhwa buhyâhya”. <verse eid="JHN 3:7"/><verse number="8" style="v" sid="JHN 3:8"/>“Empûsi olunda esîmire lwo enahûkiza: onayumve omuhûsi gwâyo, ci orhîshi emunda yarhenga erhi emunda yajà. Kwo n’okwo ngasi yêshi oburhwa na Mûka”»<note caller="+" style="f"><char style="fr" closed="false">3, 8 </char><char style="ft" closed="false">Arhali byâge byâge Kristu aderha; aderha ebi arhenzagya emw’Îshe. </char></note>. <verse eid="JHN 3:8"/><verse number="9" style="v" sid="JHN 3:9"/>Naye Nikodemu, erhi: «Kurhi okwo kwankahashikana?» <verse eid="JHN 3:9"/><verse number="10" style="v" sid="JHN 3:10"/>Yezu amushuza, erhi: «Kàli oli muyigîriza omu Israheli, wanagal’ihaba ebyo? <verse eid="JHN 3:10"/><verse number="11" style="v" sid="JHN 3:11"/>“Okuli, okuli, nkubwîre, ebi rhuyishi byo rhuderha, n’ebi rhwabwîne byo rhunywêra akasheba, ci murhayêmêra obuhamîrizi bwîrhu”. <verse eid="JHN 3:11"/><verse number="12" style="v" sid="JHN 3:12"/>“Akabà murhayêmîri nka nammubwîra eby’en’igulu, kurhi mwa­ nkayêmêra nkola nammubwîra eby’empingu”? <verse eid="JHN 3:12"/><verse number="13" style="v" sid="JHN 3:13"/>“Ntâye wayinamukire empingu aha nyuma z’olya wahonaga empingu, Mwene-omuntu ôbà empingu”»<note caller="+" style="f"><char style="fr" closed="false">3, 13 </char><char style="ft" closed="false">Omu bantu boshi, Yezu, Mwêne -Omuntu, kwo acîderha, yêne wankamanya eby’empingu, bulya ye wayihubukaga.</char></note>.<verse eid="JHN 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 3:14"/>«Kulyâla Mûsa amanikaga enjoka omu irungu, ntyo, kukwânîne Mwene-omuntu ayinamulwe, <verse eid="JHN 3:14"/><verse number="15" style="v" sid="JHN 3:15"/>“lyo ngasi yêshi omuyêmîre abona obuzîne bw’ensiku n’amango”. <verse eid="JHN 3:15"/><verse number="16" style="v" sid="JHN 3:16"/>“Nêci, Nnâmahanga azigîre igulu, kuhika abâna Omugala cûsha, mpu ngasi yêshi wâmuyêmêra alek’ihera, ci abone obuzîne bw’ensiku n’amango”. <verse eid="JHN 3:16"/><verse number="17" style="v" sid="JHN 3:17"/>“Bulya Nyamuzinda arharhumaga Omugala en’igulu mpu ayish’ihana igulu, ci mpu lyo aciza igulu”. <verse eid="JHN 3:17"/><verse number="18" style="v" sid="JHN 3:18"/>“Ngasi omuyêmîre, arhahanwa; ci orhamuyêmîri, mîra olwâge lwatûbagwa, bulya arhayêmêraga izîno lya Mugala cûsha wa Nnâmahanga”<note caller="+" style="f"><char style="fr" closed="false">3, 18 </char><char style="ft" closed="false">Owalonza obucire, kukwânîne abulongeze kuli Kristu, omu kuyêmêra Yezu wafâga oku musalaba.</char></note>. <verse eid="JHN 3:18"/><verse number="19" style="v" sid="JHN 3:19"/>“Nalwo olubanja lw’olu: obulangashane bwayishire en’igulu, n’abantu ba­gal’isîma omwizimya ahâli h’obulangashane, bulya ebijiro byâbo byàli bibî”. <verse eid="JHN 3:19"/><verse number="20" style="v" sid="JHN 3:20"/>“Nêci, ngasi yêshi ojira ebibî, erhi kushomba ashomba obulangashane arhanajà ahâli obulangashane, lyo ebijiro byâge birhamanyibwa”. <verse eid="JHN 3:20"/><verse number="21" style="v" sid="JHN 3:21"/>“Ojira okushingânîne yêhe, anajè ahalangala, lyo babona oku ebijiro byâge Nyamuzinda abijirira”».<verse eid="JHN 3:21"/></para>
  <para style="s1">Obuhamîrize bwa Yowane buzinda</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22"/>Enyuma ly’ebyo, Yezu ajà bo n’abaganda bâge omu cihugo c’e Yudeya; ajirayo nsiku haguma nabo, anakabatiza. <verse eid="JHN 3:22"/><verse number="23" style="v" sid="JHN 3:23"/>Naye Yowane erhi adwîrhe abatiza e Heno<note caller="+" style="f"><char style="fr" closed="false">3, 23 </char><char style="ft" closed="false">Heno abà omu lubanda lwa Yordani.</char></note>, hôfi h’e Salimi, bulya amîshi galiyo manji, n’abantu bakayish’ibatizi­bwa. <verse eid="JHN 3:23"/><verse number="24" style="v" sid="JHN 3:24"/>Erhi Yowane arhacishwêkwa obwo. <verse eid="JHN 3:24"/><verse number="25" style="v" sid="JHN 3:25"/>Hanacizûka akadali ekarhî k’abaganda ba Yowane n’Omuyahudi oku kucishuka<note caller="+" style="f"><char style="fr" closed="false">3, 25 </char><char style="ft" closed="false">Nkaba ako kadali kàli kayêrekîre obubatizo.</char></note>. <verse eid="JHN 3:25"/><verse number="26" style="v" sid="JHN 3:26"/>Bajà emwa Yowane, bamubwîra, mpu: «Rabi, olya wali naye ishiriza lya Yordani, olya wahamîririzagya, naye akola adwîrhe abatiza, n’abantu boshi badwîrhe bamushimba!» <verse eid="JHN 3:26"/><verse number="27" style="v" sid="JHN 3:27"/>Yowane anacishuza, erhi: «Ntâco omuntu ankacîhà nka cirhamuhirwi kurhenga enyanya. <verse eid="JHN 3:27"/><verse number="28" style="v" sid="JHN 3:28"/>“Mwene muli bahamîrizi bâni kulya naderhaga, nti”: “Arhali nie Kristu, ci ntumirwe nti mmushokolere”: <verse eid="JHN 3:28"/><verse number="29" style="v" sid="JHN 3:29"/>“Ogwêrhe omuhya erhi muhya-mulume; ci omwîra w’omuhya-mulume, omuyimangira n’okumuyumva, anasîme akayumva izù ly’omu­ hya-mulume”. “Ogwo gwo mwishingo gwâni, na buno gukola guli mwimâna”. <verse eid="JHN 3:29"/><verse number="30" style="v" sid="JHN 3:30"/>“Kukwânîne agandâze, nâni ncifunye”. <verse eid="JHN 3:30"/><verse number="31" style="v" sid="JHN 3:31"/>“Owarhenga enyanya akulire boshi”; “naye owa hano igulu anali w’en’igulu”, “n’ebyaderha binali by’en’igulu”. “Owarhenga empingu alushire boshi”. <verse eid="JHN 3:31"/><verse number="32" style="v" sid="JHN 3:32"/>“Eby’abwîne n’eby’ayumvîrhe byo ahamîriza; ci ntâye oyêmêra obuhamîrizi bwâge”. <verse eid="JHN 3:32"/><verse number="33" style="v" sid="JHN 3:33"/>“Oyêmêra obuhamîrizi bwâge ayêrekana oku Nyamuzinda aderha okunali”. <verse eid="JHN 3:33"/><verse number="34" style="v" sid="JHN 3:34"/>“Oyu Nyamuzinda arhumaga, binwa bya Nyamuzinda aderha, bulya Nyamuzinda nka ahâna Mûka Mutagatîfu arhagera”. <verse eid="JHN 3:34"/><verse number="35" style="v" sid="JHN 3:35"/>“Nnâmahanga-Îshe asîma Omugala, anahizire byoshi omu maboko gâge”. <verse eid="JHN 3:35"/><verse number="36" style="v" sid="JHN 3:36"/>“Oyêmêra Omugala, agwêrhe obuzîne bw’ensiku n’amango; olahîre okuyêmêra Omugala, arhakabona akalamo, ci obukunizi bwa Nyamuzinda bwâmumananakwo”».<verse eid="JHN 3:36"/></para>
  <chapter eid="JHN 3"/>
  <chapter number="4" style="c" sid="JHN 4"/>
  <para style="s1">Omuciza w’igulu acîmanyisa emw’Abasamâriya</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1"/>Erhi Yezu amanya oku Abafarizeyi bayumvîrhe oku akola agwêrhe baganda banji kulusha Yowane n’oku adwîrhe abatiza bantu banji kumulusha, <verse eid="JHN 4:1"/><verse number="2" style="v" sid="JHN 4:2"/>n’obwo arhali Yezu yêne wakâg’ibatiza, ci baganda bâge, <verse eid="JHN 4:2"/><verse number="3" style="v" sid="JHN 4:3"/>arhenga e Yudeya, acîshubirira e Galileya. <verse eid="JHN 4:3"/><verse number="4" style="v" sid="JHN 4:4"/>Kwàli kukwânîne atwikanye omu Samâriya. <verse eid="JHN 4:4"/><verse number="5" style="v" sid="JHN 4:5"/>Anacihika omu cishagala ciguma c’e Samâriya, ciderhwa Sikara, hôfi h’ishwa Yakôbo ahâga omugala Yozefu. <verse eid="JHN 4:5"/><verse number="6" style="v" sid="JHN 4:6"/>Ho iriba lya Yakôbo<note caller="+" style="f"><char style="fr" closed="false">4, 6 </char><char style="ft" closed="false">Galya mango izûba liyimanga. </char></note> libà aho. Yezu ali amârhama n’enjira; anacitamala oku cikunguzo c’iriba. Zàli nka nsâ ndarhu. <verse eid="JHN 4:6"/><verse number="7" style="v" sid="JHN 4:7"/>Mukazi muguma w’Omusamâriya ayish’idôma. Yezu anacimubwîra, erhi: «Mpà nâni mîshi nnywe». <verse eid="JHN 4:7"/><verse number="8" style="v" sid="JHN 4:8"/>Abaganda bâge bâli bajir’igula ebiryo omu lugo. <verse eid="JHN 4:8"/><verse number="9" style="v" sid="JHN 4:9"/>Olya mukazi w’Omusamâriya amubwîra, erhi: «Kurhi we Muyahudi wanka­mpûna amîshi, nie Musamâriya?» Bulya Abayahudi n’Abasamâriya barhabonanagakwo. <verse eid="JHN 4:9"/><verse number="10" style="v" sid="JHN 4:10"/>Yezu amushuza, erhi: «Ocimanyaga enshôkano ya Nnâmahanga okanamanya ndi okubwîzire, erhi: “Mpà nâni nnywe”, wakabire we muhûna, naye anakakuhîre amîshi g’obuzîne<note caller="+" style="f"><char style="fr" closed="false">4, 10 </char><char style="ft" closed="false">Omu Mandiko matagatîfu, amîshi lyo inêma lya Nnâmahanga.</char></note>». <verse eid="JHN 4:10"/><verse number="11" style="v" sid="JHN 4:11"/>Olya mukazi amubwîra, erhi: «Yâgirwa, ci orhagwêrhi eci wankadômeramwo, n’iriba lirî lirî. Ngahi wankacibona amîshi g’obuzîne? <verse eid="JHN 4:11"/><verse number="12" style="v" sid="JHN 4:12"/>K’olushirage larha Yakôbo warhuhâga eri iriba, anyweramwo bo n’abâna n’ebintu byâge?» <verse eid="JHN 4:12"/><verse number="13" style="v" sid="JHN 4:13"/>Yezu amushubiza, erhi: «Ngasi yêshi onywakwo aga mîshi ashub’iyumva enyôrha; <verse eid="JHN 4:13"/><verse number="14" style="v" sid="JHN 4:14"/>Ci owanywe oku mîshi namuhà, arhakayumva nyôrha ciru n’eliguma; bulya amîshi namuhà gamuhindukamwo iriba lyakahululamwo amîshi g’obuzîne bw’ensiku n’amango». <verse eid="JHN 4:14"/><verse number="15" style="v" sid="JHN 4:15"/>Nyamukazi, erhi: «Waliha, mpà nâni kwo ago mîshi, lyo irhondo ntaciyumva nyôrha, lyo ntanakaciyish’idôma bano». <verse eid="JHN 4:15"/><verse number="16" style="v" sid="JHN 4:16"/>Yezu amubwîra, erhi: «Kanya, ohamagale balo, ogal’igaluka». <verse eid="JHN 4:16"/><verse number="17" style="v" sid="JHN 4:17"/>Olya mukazi amushuza, erhi: «Ntajira mulume». Yezu amushubiza, erhi: «Nêci, kwo binali, orhajira mulume. <verse eid="JHN 4:17"/><verse number="18" style="v" sid="JHN 4:18"/>Bulya wamaja omu mwa balume barhanu, n’oyu oli omu mwâge arhali balo. Nêci, orhanywesiri». <verse eid="JHN 4:18"/><verse number="19" style="v" sid="JHN 4:19"/>Nyamukazi, erhi: «Yâgirwa, namâbona oku oli mulêbi. <verse eid="JHN 4:19"/><verse number="20" style="v" sid="JHN 4:20"/>Balarha bakâg’iharâmya kw’eyi ntondo<note caller="+" style="f"><char style="fr" closed="false">4, 20 </char><char style="ft" closed="false">Ntondo ya Garizimi eyo.</char></note>, ninyu mpu Yeruzalemu ho hantu h’okuharâmya». <verse eid="JHN 4:20"/><verse number="21" style="v" sid="JHN 4:21"/>Yezu amubwîra, erhi: «We mukazi, nyêmêra, amango gahisire, arhananciri kuli eyi ntondo erhi e Yeruzalemu mwacikaharâmya Larha. <verse eid="JHN 4:21"/><verse number="22" style="v" sid="JHN 4:22"/>Mw’oyo munakaharâmya eci murhishi, rhwêhe rhuharâmya eci rhuyishi; bulya obucire omu Buyahudi burhenga. <verse eid="JHN 4:22"/><verse number="23" style="v" sid="JHN 4:23"/>Câba amango gayiruka -ganakola go gano- abaharâmya okunali bakola bakâharâmya Larha omu murhima gwâbo n’okunali; bulya abo bo Larha alonza mpu bamuharâmye. <verse eid="JHN 4:23"/><verse number="24" style="v" sid="JHN 4:24"/>Nyamuzinda abà mûka, n’abamuharâmya kukwânîne bamuharâmye omu murhima n’okunali». <verse eid="JHN 4:24"/><verse number="25" style="v" sid="JHN 4:25"/>Olya mukazi anacimubwîra, erhi: «Nyîshi oku Masiha, olya baderha Kristu, ayisha. Amango ayisha, ye warhuyigîriza byoshi». <verse eid="JHN 4:25"/><verse number="26" style="v" sid="JHN 4:26"/>Yezu amushuza, erhi: «Nie ono ndwîrhe nakudesa». <verse eid="JHN 4:26"/><verse number="27" style="v" sid="JHN 4:27"/>Ho n’aho abaganda bâge bayisha, basômerwa erhi babona adwîrhe aganîza omukazi. Ci ntâye washagîre mpu amudôsa, erhi: «Ci wamudôsa», erhi: «Carhuma wamuganîza?» <verse eid="JHN 4:27"/><verse number="28" style="v" sid="JHN 4:28"/>Nyamukazi anacisiga akabindi kâge, alibirhira eka, aj’ibwîra abantu, erhi: <verse eid="JHN 4:28"/><verse number="29" style="v" sid="JHN 4:29"/>«Yishi mubone omulume wamambwîra ebi najizire byoshi. K’arhankabà ye Kristu?» <verse eid="JHN 4:29"/><verse number="30" style="v" sid="JHN 4:30"/>Banacirhenga omu lugo, bajà emunda àli. <verse eid="JHN 4:30"/><verse number="31" style="v" sid="JHN 4:31"/>Ago mango abaganda bâge bakâg’imuyinginga banamubwîra, mpu: «Waliha Mwigiriza, ebiryo bino». <verse eid="JHN 4:31"/><verse number="32" style="v" sid="JHN 4:32"/>Naye abashuza, erhi: «Ngwêrhe ebiryo murhishi». <verse eid="JHN 4:32"/><verse number="33" style="v" sid="JHN 4:33"/>Abaganda bâge bakadôsanya, mpu: «Nkaba hali owamudwîrhîre eby’alya<note caller="+" style="f"><char style="fr" closed="false">4, 33 </char><char style="ft" closed="false">eby’alya: biri binwa bibirhi: «ebi» na «alya». Omu mashi mubà enshishula binwa amango herufi z’izù zibirhi zirhimânana. </char><char style="fp" closed="false">a abugâne a, ahinduke â kwo kuderha a mulîri: mpâga agâni mamvu: mpâgâgani mamvu. </char><char style="fp" closed="false">a abugâne e, a anarhoge omu kuhubula, bihinduke byombi e mulirî: narhenga e Bukafu: narhegêBukafu </char><char style="fp" closed="false">i abugâne a, ahinduke y: ebi alya: eby’alya. </char><char style="fp" closed="false">i arhimâne o, ahinduke iyu: omukazi oduga budufu: omukazyuduga budufu. </char><char style="fp" closed="false">a arhimâna o, a ye mwofi kuli o anarhoge hasigale o: omwâna oderha bwenêne: omwanoderha bwenêne.</char><char style="fp" closed="false">o arhimâne e, ahinduke we: engoko ekaliza bânagoko: engokwekaliza bânagoko.</char><char style="fp" closed="false">n’ebindi n’ebindi…</char></note>?» <verse eid="JHN 4:33"/><verse number="34" style="v" sid="JHN 4:34"/>Yezu ababwîra, erhi: «Ebiryo byâni kuli kujira obulonza bw’owa­ntumaga n’okuyûkiriza omukolo gwâge. <verse eid="JHN 4:34"/><verse number="35" style="v" sid="JHN 4:35"/>“Ka murhaderha, mpu”: “Hasigire myêzi ini emyâka eyêre?” “Nâni mmubwîzire”: “Yinamuli amasù, mubone oku amashwa gakola gayâkirize n’emyâka”. <verse eid="JHN 4:35"/><verse number="36" style="v" sid="JHN 4:36"/>“Omusârûzi akola ahâbwa oluhembo lwâge; akola adwîrhe alunda emburho oku buzîne bw’ensiku n’amango, na ntyo owarhwêraga naye akola asîma bo n’omusârûzi”. <verse eid="JHN 4:36"/><verse number="37" style="v" sid="JHN 4:37"/>“Nêci aka kanwa kanali k’okuli: orhwêra ali wago, n’osârûla ali wago”. <verse eid="JHN 4:37"/><verse number="38" style="v" sid="JHN 4:38"/>“Nammurhumire okuj’isârûla<note caller="+" style="f"><char style="fr" closed="false">4, 38 </char><char style="ft" closed="false">Abasârûzi zo Ntumwa, n’abarhwêraga bo balya balêbi bashokoleraga Entumwa, na kulusha boshi, Mwâmi Yezu yêne.</char></note> ebi murhalibukiraga; bandi balibusire ninyu mwalya emyâka y’amalibuko gâbo”».<verse eid="JHN 4:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39"/>Basamâriya banji b’eco cishagala bamuyêmêra erhi kalya kanwa k’olya mukazi karhuma, erhi: «Anambwîzire ebi najizire byoshi». <verse eid="JHN 4:39"/><verse number="40" style="v" sid="JHN 4:40"/>Erhi Abasamâriya bamuhikaho, bamuyinginga mpu acumbike. Ajirayo nsiku ibiri zône. <verse eid="JHN 4:40"/><verse number="41" style="v" sid="JHN 4:41"/>Bandi banji bamuyêmêra erhi nyigîrizo zirhuma. <verse eid="JHN 4:41"/><verse number="42" style="v" sid="JHN 4:42"/>Bakâbwîra olya mukazi, mpu: «Arhaciri binwa byâwe birhumire rhuyêmêra; nîrhu rhwêne rhwamuyumvîrhe, rhunakola rhumanyire bwinjà oku kwo binali, oyu ye Muciza w’igulu».<verse eid="JHN 4:42"/></para>
  <para style="s1">Yezu afumya mugala wa murhambo muguma</para>
  <para style="r">(<ref loc="MAT 8:5-13">Mat 8, 5-13</ref>; <ref loc="LUK 7:1-11">Luk 7, 1-11</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43"/>Erhi zirya nsiku ibiri zigera, anacilîkûla, ajà e Galileya. <verse eid="JHN 4:43"/><verse number="44" style="v" sid="JHN 4:44"/>Yezu yêne àli erhi adesire mpu ntà mulêbi okengwa omu cihugo câbo. <verse eid="JHN 4:44"/><verse number="45" style="v" sid="JHN 4:45"/>Erhi ahika e Galileya, abanya-Galileya bamuyankirira, bulya bâli erhi babwîne ebi ajiraga e Yeruzalemu byoshi oku lusiku lukulu; bulya nabo bâli oku lusiku lukulu. <verse eid="JHN 4:45"/><verse number="46" style="v" sid="JHN 4:46"/>Ashub’ijà e Kana y’e Galileya, erya ahindulaga amîshi okubà divayi. Yali murhambo muguma walwazagya omugala e Kafarnaumu. <verse eid="JHN 4:46"/><verse number="47" style="v" sid="JHN 4:47"/>Oyo mulume erhi ayumva oku Yezu ahika e Galileya kurhenga e Yudeya, amuguma omu cirali, anamushenga mpu ayandagalîre emwâge, aj’ifumya omugala wali hôfi h’okufà. <verse eid="JHN 4:47"/><verse number="48" style="v" sid="JHN 4:48"/>Yezu amubwîra, erhi: «Ka mukabà murhabwîni ebisômerîne n’ebirhangâzo murhâyêmêre?» <verse eid="JHN 4:48"/><verse number="49" style="v" sid="JHN 4:49"/>Naye nyamurhwâli, erhi: «Muhânyi, yandagala embere o­mwâna anfîre». <verse eid="JHN 4:49"/><verse number="50" style="v" sid="JHN 4:50"/>Yezu amubwîra, erhi: «Gendaga, mugala wâwe ali mutaraga». Nyamulume anaciyêmêra ako kanwa ka Yezu, alîkûla. <verse eid="JHN 4:50"/><verse number="51" style="v" sid="JHN 4:51"/>Oku aciri omu njira y’okuyandagalira emwâge, abambali bayisha, bamubwîra mpu omugala afumire. <verse eid="JHN 4:51"/><verse number="52" style="v" sid="JHN 4:52"/>Abadôsa ensà yonêne arhondêraga okuyumva amagala. Bamushuza, mpu: «Nnjo aha nsâ nda ishushira lyamurhengagamwo». <verse eid="JHN 4:52"/><verse number="53" style="v" sid="JHN 4:53"/>Îshe abona oku yo na nsâ Yezu amubwîraga, erhi: «Mugala wâwe ali mutaraga». Anaciyêmêra ye n’ab’omu mwâge boshi. <verse eid="JHN 4:53"/><verse number="54" style="v" sid="JHN 4:54"/>Eco co cisômerîne ca kabiri Yezu àjizire erhi ashubira e Galileya kurhenga e Yudeya.<verse eid="JHN 4:54"/></para>
  <chapter eid="JHN 4"/>
  <chapter number="5" style="c" sid="JHN 5"/>
  <para style="s1">Yezu afumya omulwâla ah’iriba lya Betesta</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1"/>Enyuma ly’ebyo, lwanacibà lusiku lukulu lw’Abayahudi, naye Yezu ayinamukira e Yeruzalemu. <verse eid="JHN 5:1"/><verse number="2" style="v" sid="JHN 5:2"/>Aha maziba g’ebibuzi, omu cishagala c’e Yeruzalemu, habà iriba liderhwa Betesta<note caller="+" style="f"><char style="fr" closed="false">5, 2 </char><char style="ft" closed="false">Omu cihabraniya, Bet-Hêsed, kuli kuderha «nyumpa ya lukogo», nyumpa ya bwonjo bwa Nnâmahanga.</char></note> omu ciyahudi. Eryo iriba lijira mbaraza irhanu. <verse eid="JHN 5:2"/><verse number="3" style="v" sid="JHN 5:3"/>Balwâla mwandu bakâg’igwishira mw’ezo mbaraza: emihûrha, abahinange n’abahozire enjingo bakâg’ilingûza oku amîshi gashabagana. <verse eid="JHN 5:3"/><verse number="4" style="v" sid="JHN 5:4"/>Bulya liguma liguma malahika wa Nyakasane akâg’iyandagalira omu maziba n’okushabaganya amîshi. N’erhi amîshi gabaga gabirunduka, owarhangag’ikajamwo ye wanakag’ifuma endwâla yâge. <verse eid="JHN 5:4"/><verse number="5" style="v" sid="JHN 5:5"/>Hàli muntu muguma, erhi ali myâka makumi asharhu na munâni alwâla. <verse eid="JHN 5:5"/><verse number="6" style="v" sid="JHN 5:6"/>Yezu anacimubona agwîshîre, erhi anamanyire oku emyâka ekola minji kurhenga ali ntyo. Amubwîra, erhi: «Ka walonza okufuma?» <verse eid="JHN 5:6"/><verse number="7" style="v" sid="JHN 5:7"/>Naye olya mulwâla, erhi: «Muhânyi, ntajira owaka­mpira omu maziba nka amîshi gabirunduka; na nkaderha nti mmujâge, erhi mpahika, nnanshimâne owundi mîra antangaga». <verse eid="JHN 5:7"/><verse number="8" style="v" sid="JHN 5:8"/>Yezu amubwîra, erhi: «Yimuka, oyanke encingo yâwe, ocîgendere». <verse eid="JHN 5:8"/><verse number="9" style="v" sid="JHN 5:9"/>Olya mulume anacifuma oku ilindo liguma; ayanka encingo yâge, agenda. Ci olwo lusiku lwàli lwa Sabato. <verse eid="JHN 5:9"/><verse number="10" style="v" sid="JHN 5:10"/>Abayahudi babwîra oyo muntu wâfuma­ga, mpu: «Ene lwa Sabato, orhankabarhula encingo yâwe». <verse eid="JHN 5:10"/><verse number="11" style="v" sid="JHN 5:11"/>Naye abashuza, erhi: «Ci owanfumagya anambwîzire, erhi: Yanka encingo yâwe, ogende!» <verse eid="JHN 5:11"/><verse number="12" style="v" sid="JHN 5:12"/>Bamudôsa, mpu: «Ye ndi oyo wakubwîraga, erhi: Yanka encingo yâwe, ogende?» <verse eid="JHN 5:12"/><verse number="13" style="v" sid="JHN 5:13"/>Ci olya muntu wafumaga arhàli amumanyire, bulya Yezu àli amâzonga omu lubaga lwàli lulundumîne. <verse eid="JHN 5:13"/><verse number="14" style="v" sid="JHN 5:14"/>Erhi kugera nsiku, Yezu amushimâna omu ka-Nyamuzinda; anacimubwîra, erhi: «W’oyu wafumire; irhondo orhacijiraga byâha<note caller="+" style="f"><char style="fr" closed="false">5, 14 </char><char style="ft" closed="false">Okufuma kw’omubiri ciri cimanyîso c’okufûka kw’omûka. Omuntu Mwâmi Yezu ashimanyire kukwânîne ahinduke muntu muhyâhya, kukwânîne obuzîne bwa Kristu bumujemwo bunamujire mwâna wa Nnâmahanga.</char></note>, olek’ibà kubî kulusha okurhanzi». <verse eid="JHN 5:14"/><verse number="15" style="v" sid="JHN 5:15"/>Olya mulume anacigend’ibwîra Abayahudi oku Yezu ye wamufumagya. <verse eid="JHN 5:15"/><verse number="16" style="v" sid="JHN 5:16"/>Okwo kwarhuma Abayahudi barhondêra okuhîvulula Yezu mpu bulya akâg’ijira ntyo olwa Sabato. <verse eid="JHN 5:16"/><verse number="17" style="v" sid="JHN 5:17"/>Ci Yezu yêhe abashuza, erhi: «Oku Larha adwîrhe akola erhi nâni kwo n’okwo». <verse eid="JHN 5:17"/><verse number="18" style="v" sid="JHN 5:18"/>Okwo kwarhuma Abayahudi bakâlonza okumuyîrha, arhali okwenge akâg’ivuna olwa Sabato kwônene, ci bwenêne bulya akâg’iderha mpu Nyamuzinda ye Îshe n’okucîyumanyanya na Nnâmahanga.<verse eid="JHN 5:18"/></para>
  <para style="s1">Omukolo gwa Mugala wa Nyamuzinda</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19"/>Yezu anacishuza, ababwîra, erhi: «Okuli, okuli, mmubwîre, Mugala wa Nnâmahanga arhankahash’ijira ebi arhabonaga Îshe ajira: ngasi byoshi Îshe ajira, n’Omugala kwo na kuguma abijira. <verse eid="JHN 5:19"/><verse number="20" style="v" sid="JHN 5:20"/>“Bulya Nyamuzinda Îshe azigira Omugala, n’ebi ajira byoshi, anamuyêrekebyo; acinamuyêreka ebilushire ebyo, murhangâle”. <verse eid="JHN 5:20"/><verse number="21" style="v" sid="JHN 5:21"/>“Nka oku Îshe afûla abafù anabahè obuzîne, kwo n’okwo Omugala naye abalonzize anabahè obuzîne”. <verse eid="JHN 5:21"/><verse number="22" style="v" sid="JHN 5:22"/>“Bulya Îshe arhatwîra ndi lubanja: ci ngasi lubanja alulîkira Omugala”, <verse eid="JHN 5:22"/><verse number="23" style="v" sid="JHN 5:23"/>“lyo abantu boshi bakenga Omugala, nk’oku bakenga Îshe. “Orhakenga Omugala, erhi arhanakenga Îshe wamurhumaga”. <verse eid="JHN 5:23"/><verse number="24" style="v" sid="JHN 5:24"/>“Okuli, okuli, mmubwîre, oyumva akanwa kâni akanayêmêra owantumaga, obuzîne bw’ensiku n’amango erhi bwâge, arhakanahêkwa lubanja, ci ahimire olufù, ajà omu buzîne”. <verse eid="JHN 5:24"/><verse number="25" style="v" sid="JHN 5:25"/>“Nêci mmubwîzire: amango gayishire -ganakola go gano- abafîre bâyumve izù lya Mwene Nyamuzinda, n’abaliyumve banalame”. <verse eid="JHN 5:25"/><verse number="26" style="v" sid="JHN 5:26"/>“Nk’oku Îshe ye nn’obuzîne, kwo anahîre Omugala mpu abè nn’obuzîne”, <verse eid="JHN 5:26"/><verse number="27" style="v" sid="JHN 5:27"/>“anamuhîre obuhashe bw’okutwa emmanja zoshi, bulya ali Mwene-omuntu”. <verse eid="JHN 5:27"/><verse number="28" style="v" sid="JHN 5:28"/>“Murhasômeragwa n’okwo: bulya amango gayiruka, abâli omu nshinda boshi bârhengemwo bamâyumva izù lyâge”; <verse eid="JHN 5:28"/><verse number="29" style="v" sid="JHN 5:29"/>“abakozire aminjà bafûkire obuzîne, n’abajizire amabî bafûkire olubanja”. <verse eid="JHN 5:29"/><verse number="30" style="v" sid="JHN 5:30"/>“Oku bwâni, ntâco nankahash’ijira niene”. “Olunyumvîrhe lwo ntwa; n’akanwa kâni kashingânîne, bulya ntajira oku nnonzize, ci oku owa­ntumaga alonzize”. <verse eid="JHN 5:30"/><verse number="31" style="v" sid="JHN 5:31"/>“Akabà nie ncihamîriza niene, obuhamîrizi bwâni burhali bwo”. <verse eid="JHN 5:31"/><verse number="32" style="v" sid="JHN 5:32"/>“Wundi odwîrhe wampamîririza, nnamanyire oku obuhamîrizi bwâge kuli nie buli bw’okuli”. <verse eid="JHN 5:32"/><verse number="33" style="v" sid="JHN 5:33"/>“Mwâli murhumire abantu emwa Yowane<note caller="+" style="f"><char style="fr" closed="false">5, 33 </char><char style="ft" closed="false">Lolà <char style="xt"><ref loc="JHN 1:19-28">1, 19-28</ref></char>.</char></note>, naye adesire okunali”. <verse eid="JHN 5:33"/><verse number="34" style="v" sid="JHN 5:34"/>“Nie ono ntalonza buhamîrizi bwa muntu; ci ebyo mbidesire nti lyo mucunguka”. <verse eid="JHN 5:34"/><verse number="35" style="v" sid="JHN 5:35"/>“Yowane kàli kamole katwanyire kanalangashîne; mwanali mulonzize okusîma hisanzi hisungunu omu bumoleke bwâge”. <verse eid="JHN 5:35"/><verse number="36" style="v" sid="JHN 5:36"/>“Niehe ngwêrhe obuhamîrizi bulushire obwa Yowane: emikolo Larha a­mpâga mpu njire; eyo mikolo njira yo ehamîriza oku Larha ye wa­ntumaga”. <verse eid="JHN 5:36"/><verse number="37" style="v" sid="JHN 5:37"/>“Na Larha wantumaga, yêne ye muhamîrizi wâni. Mw’oyo murhasig’iyumva izù lyâge ciru n’eliguma, murhanasâg’ibona obusù bwâge”, <verse eid="JHN 5:37"/><verse number="38" style="v" sid="JHN 5:38"/>n’ecinwa câge cirhammubamwo, bulya oyu arhumaga murhamuyêmêra”. <verse eid="JHN 5:38"/><verse number="39" style="v" sid="JHN 5:39"/>“Muhumba Amandiko, bulya mucîkebirwe mpu mwo mubà akalamo karhahwa; ci nago kumpamîriza gampamîriza!” <verse eid="JHN 5:39"/><verse number="40" style="v" sid="JHN 5:40"/>“Ci murhalonza okujà emunda ndi lyo mubona obuzîne”. <verse eid="JHN 5:40"/><verse number="41" style="v" sid="JHN 5:41"/>“Irenge ly’abantu, ntalilonza”. <verse eid="JHN 5:41"/><verse number="42" style="v" sid="JHN 5:42"/>“Ci mmanyire oku murhajira buzigire bwa Nnâmahanga”. <verse eid="JHN 5:42"/><verse number="43" style="v" sid="JHN 5:43"/>“Nayishire oku izîno lya Larha, murhananyankiriraga; erhi owundi ankacirhuma yênene, oyo mwanamuyankirira”. <verse eid="JHN 5:43"/><verse number="44" style="v" sid="JHN 5:44"/>“Kurhi mwankayêmêra mwe mulonza okukuzibwa ngasi muguma n’abâbo, ci obukuze burhenga emwa Nnâmahanga yêne murhabulonza?” <verse eid="JHN 5:44"/><verse number="45" style="v" sid="JHN 5:45"/>“Murhamanyaga mpu nie nâmmushobeke emwa Larha”. “Mûsa mucicîkubagira ye wâmmushobeke”. <verse eid="JHN 5:45"/><verse number="46" style="v" sid="JHN 5:46"/>“Bulya muciyêmêraga Mûsa, mwankanyêmîre nâni; bulya ebi ayandisire nie abiyandikîre”. <verse eid="JHN 5:46"/><verse number="47" style="v" sid="JHN 5:47"/>“Ci mukabà murhayêmîri ebi ayandisire, kurhi mwankayêmêra ebinwa byâni?”»<verse eid="JHN 5:47"/></para>
  <chapter eid="JHN 5"/>
  <chapter number="6" style="c" sid="JHN 6"/>
  <para style="s1">Yezu aluza emigati</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mat 14, 13-21</ref>; <ref loc="MRK 6:32-44">Mrk 6, 32-44</ref>; <ref loc="LUK 9:10-17">Luk 9, 10-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1"/>Okuhandi Yezu anaciyikirira ishiriza ly’enyanja y’e Galileya, ederhwa Tiberiyadi. <verse eid="JHN 6:1"/><verse number="2" style="v" sid="JHN 6:2"/>Abantu mwandu erhi bamushimbire, bulya bâli bamâbona ebisômerîne akâg’ijirira abalwâla. <verse eid="JHN 6:2"/><verse number="3" style="v" sid="JHN 6:3"/>Yezu anacirheremera oku ntondo, adahalakwo bo n’abaganda bâge. <verse eid="JHN 6:3"/><verse number="4" style="v" sid="JHN 6:4"/>Basâka, lwo lusiku lukulu lw’Abayahudi, ali hôfi. <verse eid="JHN 6:4"/><verse number="5" style="v" sid="JHN 6:5"/>Erhi ayînamula amasù, Yezu abona olubaga lunji lumushimbire. Ancibwîra Filipo, erhi: «Ngahi rhwankagulira emigati bâlya?» <verse eid="JHN 6:5"/><verse number="6" style="v" sid="JHN 6:6"/>Amubwîraga ntyo mpu amurhangule, bulya àli amanyire yêne oku ajira. <verse eid="JHN 6:6"/><verse number="7" style="v" sid="JHN 6:7"/>Filipo amushuza, erhi: «Emigati ya ngoyo<note caller="+" style="f"><char style="fr" closed="false">6, 7 </char><char style="ft" closed="false">«ngoyo»: Ngoyo ibiri, go mafundo makumi abiri erhi magerha magana abiri. Igerha lyànkafire idinari liguma, lwo lusaranga lw’Abaroma.</char></note> ibiri erhankabalumîra, ciru ngasi muntu ankahâbwa hisungunu». <verse eid="JHN 6:7"/><verse number="8" style="v" sid="JHN 6:8"/>Muguma omu baganda bâge, ye Andreya, mulumuna wa Simoni Petro, amubwîra, erhi: <verse eid="JHN 6:8"/><verse number="9" style="v" sid="JHN 6:9"/>«Hano hali mwâna muguma odwîrhe migati irhanu y’engano na nfî ibiri; ci kwône cirigi cici eco kuli ogu mwandu gw’abantu?» <verse eid="JHN 6:9"/><verse number="10" style="v" sid="JHN 6:10"/>Yezu anacibabwîra, erhi: «Mubwîre abantu babwârhale». Obukere bwàli ho bunji. Banacibwârhala balume nka bihumbi birhanu. <verse eid="JHN 6:10"/><verse number="11" style="v" sid="JHN 6:11"/>Okubundi Yezu ayanka erya migati, n’erhi abà amâvuga omunkwa, ayigabira abantu bâli babwârhîre, n’enfî kwo na kwo, nk’oku balonzagya. <verse eid="JHN 6:11"/><verse number="12" style="v" sid="JHN 6:12"/>Erhi babà bamâyigurha, abwîra abaganda bâge, erhi: «Mugushe ebihimbi bisigîre, bilek’iherera busha». <verse eid="JHN 6:12"/><verse number="13" style="v" sid="JHN 6:13"/>Babigusha, bayunjuza birhimbiri ikumi na bibiri by’ebisigaliza by’erya migati y’engano irhanu bàlyaga. <verse eid="JHN 6:13"/><verse number="14" style="v" sid="JHN 6:14"/>Erhi abantu babona eco cisômerîne Yezu ajiraga, bakaderha, mpu: «Nêci, y’oyu ye mulêbi wayisha en’igulu». <verse eid="JHN 6:14"/><verse number="15" style="v" sid="JHN 6:15"/>Yezu erhi amanya oku balonza okumugwârha mpu bamujire mwâmi, acîgendera, ashub’icîfulika oku ntondo yêneyêne.<verse eid="JHN 6:15"/></para>
  <para style="s1">Yezu alambagira omu nyanja</para>
  <para style="r">(<ref loc="MAT 14:22-23">Mat 14, 22-23</ref>; <ref loc="MRK 6:45-52">Mrk 6, 45-52</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16"/>Erhi bijinga, abaganda bâge bayandagalira oku nyanja, <verse eid="JHN 6:16"/><verse number="17" style="v" sid="JHN 6:17"/>bashonera omu bwârho, bayikira, bajà e Kafarnaumu. Bwayira na Yezu arhabahikakwo; <verse eid="JHN 6:17"/><verse number="18" style="v" sid="JHN 6:18"/>erhi n’empûsi edwîrhe yashungûrha, enyanja yabira. <verse eid="JHN 6:18"/><verse number="19" style="v" sid="JHN 6:19"/>Bâli bamâvugama nka stadi<note caller="+" style="f"><char style="fr" closed="false">6, 19 </char><char style="ft" closed="false">Estadi nguma ziri nka meteri 185.</char></note> makumi abiri n’irhanu erhi makumi asharhu, erhi Yezu ayegêra obwârho ayish’agenda omu nyanja. Banacirhemuka. <verse eid="JHN 6:19"/><verse number="20" style="v" sid="JHN 6:20"/>Ci Yezu ababwîra, erhi: «Niene, murhayôbohaga!» <verse eid="JHN 6:20"/><verse number="21" style="v" sid="JHN 6:21"/>Bâli bakola bamuyanka omu bwârho, ci aho honêne o­bwârho bwahika aha banajâga.<verse eid="JHN 6:21"/></para>
  <para style="s1">Yezu ayigîriza omu sinagogi y’e Kafarnaumu</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22"/>Erhi buca, olubaga lwàli lusigîre ishiriza lwabona oku obwârho bwàli buguma bwônene n’oku Yezu arhàli abujiremwo haguma n’abaganda bâge. ci bône bâli bagenzire. <verse eid="JHN 6:22"/><verse number="23" style="v" sid="JHN 6:23"/>Ci kwône agandi mârho gàli gayishire, garhenga e Tiberiyadi, halya baliraga omugati omu kuvuga Nyakasane omunkwa. <verse eid="JHN 6:23"/><verse number="24" style="v" sid="JHN 6:24"/>Erhi abantu babona oku Yezu arhali ho n’oku abaganda bâge ntâbo, bashonera omu bwârho, bagenda e Kafarnaumu, bajà balonza Yezu. <verse eid="JHN 6:24"/><verse number="25" style="v" sid="JHN 6:25"/>Erhi bamushimâna ishiriza, bamudôsa, mpu: «Yâgirwa, mangaci wahikaga eno?» <verse eid="JHN 6:25"/><verse number="26" style="v" sid="JHN 6:26"/>Yezu abashuza, erhi: «Okuli, okuli, mmubwîre, mudwîrhe mwanonza arhali bisômerîne mwabwîne birhumire, ci bulya mwalîre emigati mwayigurha. <verse eid="JHN 6:26"/><verse number="27" style="v" sid="JHN 6:27"/>Mukâkola, arhali orhulyolyo rhuhwa rhurhuma, ci ebiryo biyôrha buzîne ensiku n’amango birhuma. Ebyo biryo Mwene-omuntu wamuhâbyo, bulya ye Îshe Nyamuzinda ahizirekwo ecimanyîso câge». <verse eid="JHN 6:27"/><verse number="28" style="v" sid="JHN 6:28"/>Banacimubwîra, mpu: «Kurhi rhwâjiraga lyo rhukola emikolo ya Nnâmahanga?» <verse eid="JHN 6:28"/><verse number="29" style="v" sid="JHN 6:29"/>Naye Yezu abashuza, erhi: «Omukolo gwa Nnâmahanga kwo kuyêmêra oyo arhumaga». <verse eid="JHN 6:29"/><verse number="30" style="v" sid="JHN 6:30"/>Nabo, mpu: «Cimanyîso cici warhuyêrekaga lyo rhukuyêmêra? Bici ojira? <verse eid="JHN 6:30"/><verse number="31" style="v" sid="JHN 6:31"/>Balarha balire amâna<note caller="+" style="f"><char style="fr" closed="false">6, 31 </char><char style="ft" closed="false">Amâna gàli nka mugati mununu gwamanukaga emalunga oku kulîsa Abayahudi omu irungu. <char style="xt"><ref loc="PSA 78:24">Lul 78, 24</ref></char>.</char></note> omu irungu, nka oku biyandisirwe: Abahîre omugati gw’emalunga mpu balye».<verse eid="JHN 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32"/>Yezu anacibashuza, erhi: «Okuli, mmubwîre, arhali Mûsa wammuhâga omugati gw’empingu; Larha ye mmuhà omugati gw’empingu, gwo mugati gw’okunali. <verse eid="JHN 6:32"/><verse number="33" style="v" sid="JHN 6:33"/>Bulya omugati gwa Nnâmahanga, gwo gulya guhona empingu gunahâne obuzîne en’igulu». <verse eid="JHN 6:33"/><verse number="34" style="v" sid="JHN 6:34"/>Nabo bamubwîra, mpu: «Yâgirwa, orhuhè ensiku zoshi kuli ogwo mugati». <verse eid="JHN 6:34"/><verse number="35" style="v" sid="JHN 6:35"/>Yezu abashuza, erhi: «Nie mugati gw’obuzîne; ojîre emunda ndi arhankacishalika, n’onyêmîre arhankaciyumva nyôrha. <verse eid="JHN 6:35"/><verse number="36" style="v" sid="JHN 6:36"/>Ci nammubwîzireko: mudwîrhe mwambona ci murhanyêmîri. <verse eid="JHN 6:36"/><verse number="37" style="v" sid="JHN 6:37"/>Ebi Larha ampà byoshi byajà emunda ndi, n’ojire emunda<note caller="+" style="f"><char style="fr" closed="false">6, 37 </char><char style="ft" closed="false">Okujà emunda Yezu ali kwo kumuyêmêra. </char></note> ndi ntakamukwêba embuga; <verse eid="JHN 6:37"/><verse number="38" style="v" sid="JHN 6:38"/>bulya nahonyire empingu, arhali mpu nkajira oku nalonza, ci oku owa­ntumaga alonza. <verse eid="JHN 6:38"/><verse number="39" style="v" sid="JHN 6:39"/>Naye owantumaga alonza mpu ntarheraga bici muli birya ampâga, ci mpu mbifûle olusiku luzinda. <verse eid="JHN 6:39"/><verse number="40" style="v" sid="JHN 6:40"/>Nêci, kwo Larha alonza mpu ngasi obona Omugala anamuyêmêre abè n’obuzîne bw’ensiku n’amango, nâni mmufûle olusiku luzinda».<verse eid="JHN 6:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41"/>Ci Abayahudi erhi badwîrhe bacîduduma erhi ye rhumire, bulya anadesire, erhi: «Nie mugati gwahonaga empingu». <verse eid="JHN 6:41"/><verse number="42" style="v" sid="JHN 6:42"/>Bakaderha, mpu: «Ka arhali ye Yezu, ola mugala wa Yozefu? Ka rhuhabire îshe na nnina? “Kurhi akolaga aderha, erhi” : “Nahonaga empingu?”» <verse eid="JHN 6:42"/><verse number="43" style="v" sid="JHN 6:43"/>Yezu abashuza, ababwîra, erhi: «Murhacîdudumaga. <verse eid="JHN 6:43"/><verse number="44" style="v" sid="JHN 6:44"/>“Ntâye wankajà emunda ndi nka Larha wantumaga arhamukulwiri; nâni nayîsh’imufûla olusiku luzinda”. <verse eid="JHN 6:44"/><verse number="45" style="v" sid="JHN 6:45"/>“Kuyandisirwe n’abalêbi”: “Boshi bayish’iyigîrizibwa na Nnâmahanga”<note caller="-" style="x"><char style="xo" closed="false">6, 45 </char><char style="xt" closed="false"><ref loc="ISA 54:13">Iz 54, 13</ref>.</char></note>. “Ngasi yêshi oyumva enyigîrizo za Larha akanaziyankirira, ajà emunda ndi”. <verse eid="JHN 6:45"/><verse number="46" style="v" sid="JHN 6:46"/>“Arhali kwo kuderha oku hali wabwîne Larha, aha nyuma z’olya orhenga emwa Nyamuzinda: oyo ye wabwîne Larha”».<verse eid="JHN 6:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 6:47"/>«Okuli, okuli, mmubwîzire, oyêmîre agwêrhe obuzîne bw’ensiku n’amango. <verse eid="JHN 6:47"/><verse number="48" style="v" sid="JHN 6:48"/>“Nie mugati gw’obuzîne”. <verse eid="JHN 6:48"/><verse number="49" style="v" sid="JHN 6:49"/>“Basho balire amâna omu irungu, banafà”. <verse eid="JHN 6:49"/><verse number="50" style="v" sid="JHN 6:50"/>“Ogu gwo mugati gurhenga empingu: owagulyakwo arhakafa”. <verse eid="JHN 6:50"/><verse number="51" style="v" sid="JHN 6:51"/>“Nie mugati guzîne gwahonaga empingu; owalya kuli ogwo mugati alama ensiku zoshi; n’omugati nâhâna, gwo mubiri gwâni gwalêrhera igulu obuzîne”». <verse eid="JHN 6:51"/><verse number="52" style="v" sid="JHN 6:52"/>Obwo Abayahudi bakâjà kadali bône na nnene, mpu: «Kurhi oyo muntu ankarhuhà omubiri gwâge mpu rhugulye?»<verse eid="JHN 6:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53"/>Yezu anacibabwîra, erhi: «Okuli, okuli, mmubwîre, akabà murhaliri omubiri gwa Mwene-Omuntu murhananywiri omukò gwâge, ntà buzîne bwâbà muli mwe. <verse eid="JHN 6:53"/><verse number="54" style="v" sid="JHN 6:54"/>Olya omubiri gwâni ananywe omukò gwâni, agwêrhe obuzîne bw’ensiku n’amango, nâni namufûla olusiku luzinda. <verse eid="JHN 6:54"/><verse number="55" style="v" sid="JHN 6:55"/>Bulya omubiri gwâni kali kalyo k’okuli n’omukò gwâni ciri cinyôbwa c’okuli. <verse eid="JHN 6:55"/><verse number="56" style="v" sid="JHN 6:56"/>Olya omubiri gwâni ananywe omukò gwâni, abêra muli nie nâni muli ye. <verse eid="JHN 6:56"/><verse number="57" style="v" sid="JHN 6:57"/>Nk’oku Larha wantumaga azîne, nâni nzîne muli Larha, ondya naye alama nie ntumire. <verse eid="JHN 6:57"/><verse number="58" style="v" sid="JHN 6:58"/>Ogwo gwo mugati gwamanukaga empingu; gurhali gwo muguma n’ogu basho balyaga banagal’ifà. Olya ogu mugati alama ensiku zoshi». <verse eid="JHN 6:58"/><verse number="59" style="v" sid="JHN 6:59"/>Ezo nyigîrizo aziyigîrizagya e Kafarnaumu omu sinagogi. <verse eid="JHN 6:59"/><verse number="60" style="v" sid="JHN 6:60"/>Erhi baziyumva, banji omu baganda bâge baderha, mpu: «Eci cinwa camazibuha! Ndi wankaciyumva?»<verse eid="JHN 6:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61"/>Erhi Yezu amanya oku abashimbûlizi badwîrhe bacîduduma okwo kurhuma, anacibabwîra, erhi: «K’okwo kummusômîre? <verse eid="JHN 6:61"/><verse number="62" style="v" sid="JHN 6:62"/>Amango mwâbone mwene-omuntu arheremera aha ayôrhag’abà lyo? <verse eid="JHN 6:62"/><verse number="63" style="v" sid="JHN 6:63"/>Omûka gwo gubamwo obuzîne, omubiri guli gwa busha. Ebinwa mmubwîzire biri mûka, biri buzîne<note caller="+" style="f"><char style="fr" closed="false">6, 63 </char><char style="ft" closed="false">Ebinwa bya Yezu biyêrekîre omugati gw’empingu biri binwa byakurhuhà obuzîne bwa Nnâmahanga, na Mûka Mutagatîfu yêne wakarhuma rhwabiyumva.</char></note>. <verse eid="JHN 6:63"/><verse number="64" style="v" sid="JHN 6:64"/>Ci muli mwe muli abarhayêmîri». Kurhenga omurhondêro erhi Yezu ayishi bandi barhayêmêraga na ndi wâmulenganye.<verse eid="JHN 6:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="JHN 6:65"/>Anacishub’ibà­bwîra, erhi: «Co carhumire mmubwîra nti ntâye wankajà emunda ndi nka arhakushobwîri na Larha». <verse eid="JHN 6:65"/><verse number="66" style="v" sid="JHN 6:66"/>Kurhenga aho banji omu baganda bâge bacîyegûla, banaleka okukamukulikira.<verse eid="JHN 6:66"/></para>
  <para style="s1">Petro amanya oku Yezu ali Nyamuzinda</para>
  <para style="r">(<ref loc="MAT 16:16">Mat 16, 16</ref>)</para>
  <para style="p">
    <verse number="67" style="v" sid="JHN 6:67"/>Okubundi Yezu anacibwîra balya Ikumi-na-babiri, erhi: «Ka ninyu mukola mwâgenda?» <verse eid="JHN 6:67"/><verse number="68" style="v" sid="JHN 6:68"/>Simoni Petro amushuza, erhi: «Yâgirwa, emwandi rhwajà? We gwêrhe ebinwa by’obuzîne bw’ensiku n’amango. <verse eid="JHN 6:68"/><verse number="69" style="v" sid="JHN 6:69"/>Rhwêhe rhuyêmîre rhunamanyire oku we Mutagatîfu wa Nnâmahanga<note caller="+" style="f"><char style="fr" closed="false">6, 69 </char><char style="ft" closed="false">Mutagatîfu wa Nnâmahanga, ye Masiha erhi Kristu.</char></note>». <verse eid="JHN 6:69"/><verse number="70" style="v" sid="JHN 6:70"/>Yezu abashuza, erhi: «Ka ntamwîshogaga oku muli Ikumi-na-babiri? Ci muguma muli mwe ali shetani». <verse eid="JHN 6:70"/><verse number="71" style="v" sid="JHN 6:71"/>Yûda, mwene Simoni w’e Keriyoti aderhaga; bulya ye wali ayish’imulenganya, n’obwo àli wa muli balya Ikumi-na-babiri.<verse eid="JHN 6:71"/></para>
  <chapter eid="JHN 6"/>
  <chapter number="7" style="c" sid="JHN 7"/>
  <para style="s1">Yezu arheremera e Yeruzalemu oku lusiku lukulu anayigîriza</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1"/>Enyuma z’aho, Yezu akageragera omu Galileya; arhankagezire omu Yudeya, bulya Abayahudi bakâg’imulonza mpu bamuyîrhe. <verse eid="JHN 7:1"/><verse number="2" style="v" sid="JHN 7:2"/>Obwo erhi olusiku lukulu lw’Abayahudi, luderhwa lwa Bihando<note caller="+" style="f"><char style="fr" closed="false">7, 2 </char><char style="ft" closed="false">Olwo lusiku lwàli lwa kuvuga Nnâmahanga omunkwa oku myâka n’okuyibuka amango Abayahudi bakâg’ihanda omu mahêma omu irungu erhi barhenga e Mîsiri. Lwajiragwa omu nsiku nzinda za Cambase n’omu ntanzi za Muhaho.</char></note>, luli hôfi. <verse eid="JHN 7:2"/><verse number="3" style="v" sid="JHN 7:3"/>Bene wâbo banacimubwîra mpu: «Rhenga eno, oj’e Yudeya, abaganda bâwe babone ebi odwîrhe wajira. <verse eid="JHN 7:3"/><verse number="4" style="v" sid="JHN 7:4"/>Bulya ntâye walonza okucîmanyisa okola bufundafunda. Obûla odwîrhe wajira ebi byoshi, ciyêrekanage omu igulu». <verse eid="JHN 7:4"/><verse number="5" style="v" sid="JHN 7:5"/>Ciru na bene wâbo barhakâg’imuyêmêra. <verse eid="JHN 7:5"/><verse number="6" style="v" sid="JHN 7:6"/>Yezu anacibashuza, erhi: «Amango gâni<note caller="+" style="f"><char style="fr" closed="false">7, 6 </char><char style="ft" closed="false">Amango ga Yezu go mango g’okufà n’okufûka kwâge.</char></note> garhac’ihika, ci mwêhe amango ginyu gali minjà ensiku zoshi. <verse eid="JHN 7:6"/><verse number="7" style="v" sid="JHN 7:7"/>Igulu lirhankahash’immushomba; niehe linshomba, bulya mpamîriza oku emikolo yalyo eri mibî. <verse eid="JHN 7:7"/><verse number="8" style="v" sid="JHN 7:8"/>Mw’oyo mujè oku lusiku lukulu; niehe ntajakw’olwo lusiku lukulu, bulya amango gâni garhac’iyunjula». <verse eid="JHN 7:8"/><verse number="9" style="v" sid="JHN 7:9"/>Erhi ayûs’iderha ntyo, acîbêrera e Galileya. <verse eid="JHN 7:9"/><verse number="10" style="v" sid="JHN 7:10"/>Ci erhi bene wâbo babà bamârheremera oku lusiku lukulu, naye ayijà bufundafunda, buzira kuciyêrekana. <verse eid="JHN 7:10"/><verse number="11" style="v" sid="JHN 7:11"/>Erhi olusiku lukulu lubà, Abayahudi bakamulonza banaderha, mpu: «Ngahi ali?» <verse eid="JHN 7:11"/><verse number="12" style="v" sid="JHN 7:12"/>Emirhwe y’abantu yakahwe­hwerezanya kuli ye. Baguma, mpu: «Muntu mwinjà». Abandi, mpu: «Nanga, adwîrhe arheba olubaga». <verse eid="JHN 7:12"/><verse number="13" style="v" sid="JHN 7:13"/>Ci ntâye wakâg’imuderha n’obwâlagale erhi kuyôboha Abayahudi kurhumire. <verse eid="JHN 7:13"/><verse number="14" style="v" sid="JHN 7:14"/>Ekarhikarhi k’olusiku lukulu, Yezu anacisôkera e ka-Nyamuzinda, arhondêra ayigîriza. <verse eid="JHN 7:14"/><verse number="15" style="v" sid="JHN 7:15"/>Abayahudi basômerwa, bakaderha, mpu: «Kurhi amanyire amaruba arhanajaga omu masomo?» <verse eid="JHN 7:15"/><verse number="16" style="v" sid="JHN 7:16"/>Yezu anacibashuza, erhi: «Enyigîrizo zâni zirhali zâni, ci z’olya wantumaga. <verse eid="JHN 7:16"/><verse number="17" style="v" sid="JHN 7:17"/>Owalonz’ijira obulonza bwâge, acîbonera erhi ezi nyigîrizo ziri za Nnâmahanga, nîsi erhi niene ncirhumire. <verse eid="JHN 7:17"/><verse number="18" style="v" sid="JHN 7:18"/>Oderha ebyage yêne, irenge lyâge alonza; ci olonza irenge ly’owamurhumaga, oyo ye derha eby’okuli, arhanabamwo bunywesi. <verse eid="JHN 7:18"/><verse number="19" style="v" sid="JHN 7:19"/>Ka Mûsa arhammuhaga Amarhegeko? Ci ntâye muli mwe oshimba Amarhegeko! Cici mwalongeza okunyîrha?» <verse eid="JHN 7:19"/><verse number="20" style="v" sid="JHN 7:20"/>Olubaga lwashuza, mpu: «Olimwo shetani. Ndi walonza okukuyîrha?» <verse eid="JHN 7:20"/><verse number="21" style="v" sid="JHN 7:21"/>Yezu anacibashuza, erhi: «Kantu kaguma<note caller="+" style="f"><char style="fr" closed="false">7, 21 </char><char style="ft" closed="false">kantu kaguma: Omulwâla afumagya aha iriba lya Betesta (<char style="xt"><ref loc="JHN 5:1-9">5, 1-9</ref></char>).</char></note> kône njizire, mwanagal’irhangâla mweshi. <verse eid="JHN 7:21"/><verse number="22" style="v" sid="JHN 7:22"/>Mûsa ammuhîre irhegeko ly’okukembûlwa, arhali kwo kuderha oku Mûsa walidwîrhe, ci bashakulûza, munakujire olwa-Sabato. <verse eid="JHN 7:22"/><verse number="23" style="v" sid="JHN 7:23"/>Ntyo omuntu anakembûlwe olusiku lwa Sabato buzira kuvuna irhegeko<note caller="+" style="f"><char style="fr" closed="false">7, 23 </char><char style="ft" closed="false">Okukembûla kwàli nka kufumya ecirumbu c’omuntu, kurhànali kuhanzîbwe. Kurhi okufumya omuntu-yêshi kwankabâga kubî?</char></note> lya Mûsa. Cirhumirage mulungulwa okwenge nafumize omuntu yêshi olwa-Sabato? <verse eid="JHN 7:23"/><verse number="24" style="v" sid="JHN 7:24"/>Olubanja murhakâg’iluhà ocîshizire, ci mukagemera omuntu oku anakwânîne».<verse eid="JHN 7:24"/></para>
  <para style="s1">Abantu bajà kadali oku cisisi ca Kristu</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25"/>Obwo baguma omu bantu b’e Yeruzalemu bakaderha, mpu: «K’arhali ye badwîrhe balonza okuyîrha oyu? <verse eid="JHN 7:25"/><verse number="26" style="v" sid="JHN 7:26"/>Ci y’oyu odwîrhe aderha n’obwâlagale na ntâko bamubwîzire! K’abakulu b’ecihugo babwinage okunali oku ye Kristu? <verse eid="JHN 7:26"/><verse number="27" style="v" sid="JHN 7:27"/>Ci kwône oyo rhurhahabiri ecisisi câge; Kristu yêhe amango ayisha, ntâye wâmanye ali wa ngahi». <verse eid="JHN 7:27"/><verse number="28" style="v" sid="JHN 7:28"/>Obwo Yezu erhi adwîrhe ayigîriza omu ka-Nyamuzinda; anaciderha, erhi: «Nêci, munyishi munamanyire ndi wa ngahi! Ci kwône arhali niene nacîdwîrhe; ci owantumaga ali w’okunali, murhanamuyishi. <verse eid="JHN 7:28"/><verse number="29" style="v" sid="JHN 7:29"/>Niehe mmuyishi, bulya ye cisisi câni, bulya ye wanantumaga». <verse eid="JHN 7:29"/><verse number="30" style="v" sid="JHN 7:30"/>Balonza okumugwârha; ci ntâye wamuhumirekwo, bulya amango gâge garhal’icihika.<verse eid="JHN 7:30"/></para>
  <para style="s1">Yezu abwîra Abayahudi oku ali hôfi agende</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 7:31"/>Muli eyo ngabo y’abantu, banji bamuyêmêra. Bakacîjamwo, mpu: «K’amango Kristu ayisha acîjira ebisômerîne bilushire ebi oyo muntu ajizire?» <verse eid="JHN 7:31"/><verse number="32" style="v" sid="JHN 7:32"/>Abafarizeyi bayumva oku olubaga ludwîrhe lwamukûnga kungan’aho; bàrhuma abaganda mpu bamugwârhe. <verse eid="JHN 7:32"/><verse number="33" style="v" sid="JHN 7:33"/>Lêro Yezu anacibabwîra, erhi: «Nciri ninyu hisanzi hisungunu ngal’icîgalukira emwa owantumaga-. <verse eid="JHN 7:33"/><verse number="34" style="v" sid="JHN 7:34"/>Mwacinnonza munambule<note caller="+" style="f"><char style="fr" closed="false">7, 34 </char><char style="ft" closed="false">Nnâmahanga alonzibwa amango acibonekana. Owageza ago mango n’oluhînzo, anayish’imulonza anamubule. «Obwenge bwa nyuma nshuzo bufà». Ntyo kwo Abayahudi babîre: amango gâbo gàgezire.</char></note>, n’aha nâbà, murhankahahika». <verse eid="JHN 7:34"/><verse number="35" style="v" sid="JHN 7:35"/>Nabo Abayahudi bakâbwîrizanya, mpu: «Ngahi aho ajà, rhubule kumubona? “K’ajà omu Buyahudi bashandabîne emw’abapagani, agend’iyigîriza abapagani?” <verse eid="JHN 7:35"/><verse number="36" style="v" sid="JHN 7:36"/>“Kwo kurhi okwo adesire, erhi”: “Mwacinnonza munambule, n’aha nâbà, murhankahahika?”»<verse eid="JHN 7:36"/></para>
  <para style="s1">Yezu alaganya amîshi g’akalamo</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37"/>Oluzinda lw’olusiku lukulu, lwo lulushire ezindi, Yezu anaciyimanga, ayâkûza n’izù linene, erhi: «Ngasi ogwêrhwe n’enyôrha, ayishe emunda ndi, anywe; <verse eid="JHN 7:37"/><verse number="38" style="v" sid="JHN 7:38"/>“na ngasi onyêmîre, nk’oku Amandiko gadesire”: “enyîshi z’amîshi g’obuzîne zâhulule omu nda yâge”». <verse eid="JHN 7:38"/><verse number="39" style="v" sid="JHN 7:39"/>Aderhaga Mûka Mutagatîfu abamuyêmêre bâli bayish’ihâbwa; bulya barhàl’isâg’ihâbwa Mûka Mutagatîfu, kulya kubà Yezu arhàli aj’ikuzibwa.<verse eid="JHN 7:39"/></para>
  <para style="s1">Bashub’ijà kadali oku cisisi ca Kristu</para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40"/>Banji omu bantu bayumvagya okwo omu lubaga, bakaderha, mpu: «Okuli, y’oyu ye mulêbi!» <verse eid="JHN 7:40"/><verse number="41" style="v" sid="JHN 7:41"/>Abandi, mpu: «Ye Kristu!» Ci abandi bakashuza, mpu: «Ka Kristu ankarheng’e Galileya? <verse eid="JHN 7:41"/><verse number="42" style="v" sid="JHN 7:42"/>K'Amandiko garhadesiri mpu omu bûko bwa Daudi, omu lugo lw’e Betelehemu Kristu anârhenge?» <verse eid="JHN 7:42"/><verse number="43" style="v" sid="JHN 7:43"/>Obwo olubaga lwalyâna erhi ye rhuma. <verse eid="JHN 7:43"/><verse number="44" style="v" sid="JHN 7:44"/>Baguma balonza okumugwârha, ci ntâye wamuhizirekwo okuboko. <verse eid="JHN 7:44"/><verse number="45" style="v" sid="JHN 7:45"/>Abaganda banacishubûka, bajà emw’abajinji b’abadâhwa n’Abafarizeyi. Nabo babadôsa, mpu: «Carhumire murhamulêrha?» <verse eid="JHN 7:45"/><verse number="46" style="v" sid="JHN 7:46"/>Abaganda bashuza, mpu: «Ntà muntu okol’oshambîre aka oyu muntu!» <verse eid="JHN 7:46"/><verse number="47" style="v" sid="JHN 7:47"/>Abafarizeyi banacibashubiza, mpu: «Kuziga ninyu mwacîrikirîre ntyo! <verse eid="JHN 7:47"/><verse number="48" style="v" sid="JHN 7:48"/>K’omu barhambo erhi omu Bafarizeyi hali omuyêmîre? <verse eid="JHN 7:48"/><verse number="49" style="v" sid="JHN 7:49"/>Ci obu busô bw’abantu barhishi Marhegeko bali bakagwal» <verse eid="JHN 7:49"/><verse number="50" style="v" sid="JHN 7:50"/>Muguma muli bo, ye Nikodemu, olya wali ojîre emwa Yezu, anacibabwîra, erhi: <verse eid="JHN 7:50"/><verse number="51" style="v" sid="JHN 7:51"/>«K’irhegeko lîrhu linatwîre omuntu barhanaj’imuyumva n’okumanyirira eci ajizire?» <verse eid="JHN 7:51"/><verse number="52" style="v" sid="JHN 7:52"/>Bamushuza, mpu: «K’oli Mugalileya nâwe? Osome bwinjà, wabona oku e Galileya erharhenga mulêbi». <verse eid="JHN 7:52"/><verse number="53" style="v" sid="JHN 7:53"/>Okubundi ngasi muntu anacigaluka emwâge.<verse eid="JHN 7:53"/></para>
  <chapter eid="JHN 7"/>
  <chapter number="8" style="c" sid="JHN 8"/>
  <para style="s1">Omukazi w’omugonyi</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1"/>Yezu yêhe acîjira oku ntondo y’Emizêti. <verse eid="JHN 8:1"/><verse number="2" style="v" sid="JHN 8:2"/>Ci erhi gubà mucêracêra, bashub’imubona omu ka-Nyamuzinda, n’olubaga lwoshi lwamukunjûkakwo. Anacibwârhala, arhondêra abayigîriza. <verse eid="JHN 8:2"/><verse number="3" style="v" sid="JHN 8:3"/>Abashamuka b’ihano n’Abafarizeyi bamulêrhera omukazi wagwârhagwa omu bugonyi, bamuhira ekâgarhî k’abà­ntu boshi, <verse eid="JHN 8:3"/><verse number="4" style="v" sid="JHN 8:4"/>babwîra Yezu, mpu: «Waliha Muyigîriza, oyu mukazi agwâsirwe masi-masi omu bugonyi. <verse eid="JHN 8:4"/><verse number="5" style="v" sid="JHN 8:5"/>N’omu Marhegeko, Mûsa adesire mpu abakazi ba bene abo mabuye rhwakâbabanda. Nâwe we kurhi obwîne?» <verse eid="JHN 8:5"/><verse number="6" style="v" sid="JHN 8:6"/>Baderhaga ntyo mpu bamurhege, lyo babona oku bamulega. Ci Yezu acîyunamira, arhondêra ayandika ahanshi n’omunwe gwâge. <verse eid="JHN 8:6"/><verse number="7" style="v" sid="JHN 8:7"/>Erhi abona barhamurhengakwo, anaciyinamuka, ababwîra, erhi: «Olya orhasâg’ijira câha muli mwe amubandage ibuye ly’oburhanzi!» <verse eid="JHN 8:7"/><verse number="8" style="v" sid="JHN 8:8"/>Anacishub’iyunama, ashub’irhondêra ayandika ahanshi. <verse eid="JHN 8:8"/><verse number="9" style="v" sid="JHN 8:9"/>Erhi bayumva ebyo binwa, bakayongoloka muguma muguma, kurhangira oku bashosi; na ntyo Yezu asigala yênene n’olya mukazi wali halya bwimanga. <verse eid="JHN 8:9"/><verse number="10" style="v" sid="JHN 8:10"/>Okubundi Yezu anaciyinamuka, amubwîra, erhi: «We mukazi, ngahi bali? Ka ntâye wacikutwîrire olubanja?» <verse eid="JHN 8:10"/><verse number="11" style="v" sid="JHN 8:11"/>Naye, erhi: «Ntâye, Yâgirwa!» Yezu, erhi: «Nâni ntâko nacikujira. Cîgenderage, ci irhondo orhacihîra okahemuka».<verse eid="JHN 8:11"/></para>
  <para style="s1">Yezu ko kamole k’igulu</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12"/>Yezu ashub’ibabwîra, erhi: «Nie kamole k’igulu; onkulikire arhankage­nda omu mwizimya, ci abà n’obumoleke bw’obuzîne».<verse eid="JHN 8:12"/></para>
  <para style="s1">Bajà kadali oku buhamîrizi bwa Yezu</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13"/>Abafarizeyi banacimubwîra, mpu: «Obu wêne odwîrhe wacîhamîririza, obuhamîrizi bwâwe buli ntâbwo». <verse eid="JHN 8:13"/><verse number="14" style="v" sid="JHN 8:14"/>Yezu abashuza, erhi: «Nêci, niene nie ncîhamîririza, ci kwône obuhamîrizi bwâni buli bw’okuli, bulya nyîshi aha ntenga n’eyi nyêrekîre; ci mwêhe murhishi aha mpubuka n’aha nâlola. <verse eid="JHN 8:14"/><verse number="15" style="v" sid="JHN 8:15"/>Mw’oyo, nka mwatwa olubanja, mubiri mulola; nie ono ntatwîra ndi lubanja; <verse eid="JHN 8:15"/><verse number="16" style="v" sid="JHN 8:16"/>na nkatwa olubanja, olubanja lwâni luli lw’okuli, bulya ntali nienene, ci nie n’olya wa­ntumaga, Larha. <verse eid="JHN 8:16"/><verse number="17" style="v" sid="JHN 8:17"/>N’omu Marhegeko ginyu kuyandisirwe mpu obuhamîrizi bwa ba­ntu babiri buli bw’okuli. <verse eid="JHN 8:17"/><verse number="18" style="v" sid="JHN 8:18"/>Ncîhamîriza niene, na Larha wantumaga naye ampamîririza». <verse eid="JHN 8:18"/><verse number="19" style="v" sid="JHN 8:19"/>Banacimudôsa, mpu: «Sho, ngahi abà?» Yezu abashuza, erhi: «Murhanyishi, murhishi na Larha; mucimmanyaga, mwankamanyire na Larha». <verse eid="JHN 8:19"/><verse number="20" style="v" sid="JHN 8:20"/>Ebyo binwa abiderheraga omu ka-Nyamuzinda, aha bwa mucîmba gw’ecibîkiro, erhi adwîrhe ayigîriza. Ntâye wadesire mpu amuhirakwo olûnu, bulya amango gâge garhal’icihika.<verse eid="JHN 8:20"/></para>
  <para style="s1">Yezu arhonda Abayahudi babula-buyêmêre</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21"/>Yezu ashub’ibabwîra, erhi: «Nâcîgendera; mwannonza munafâne ecâha cinyu. Aha najà murhankahahika». <verse eid="JHN 8:21"/><verse number="22" style="v" sid="JHN 8:22"/>Abayahudi bakadôsanya, mpu: «Ka kucîniga acîniga obu adwîrhe aderha, mpu: “Aha najà murhankahahika?”» <verse eid="JHN 8:22"/><verse number="23" style="v" sid="JHN 8:23"/>Yezu ashub’iderha, erhi: «Mw’oyo muli b’idako, nâni ndi w’enyanya. Mw’oyo muli b’en’igulu, niehe ntali w’en’igulu. <verse eid="JHN 8:23"/><verse number="24" style="v" sid="JHN 8:24"/>“Nammubwîzire nti mwafâna ebyâha binyu. Nêci, akabà murhayêmîri oku nie Nyamubâho<note caller="+" style="f"><char style="fr" closed="false">8, 24 </char><char style="ft" closed="false">Erhi Mûsa adôsa Nyamuzinda izîno lyâge (<char style="xt"><ref loc="EXO 3:13-15">Lub 3, 13-15</ref></char>), amushuza, erhi: «Nie Nyamubâho», erhi: «O­bwîre abâna b’Abayahudi oku Nyamubâho ye kurhumire». Naye Yezu, bulya ali Nyamuzinda, ye Nyamubâho.</char></note>, mwafâna ebyâha binyu”». <verse eid="JHN 8:24"/><verse number="25" style="v" sid="JHN 8:25"/>Banacimubwîra, mpu: «Oli ndi?» Yezu abashuza, erhi: «Oyo na­ mmubwîzire. <verse eid="JHN 8:25"/><verse number="26" style="v" sid="JHN 8:26"/>“Ngwêrhe binji naderha kuli mwe, binji bammutwîrakwo olubanja; ci owantumaga arhaderha ebirhali by’okuli, n’ebi narhenzagya emwâge byo nanderha en’igulu”». <verse eid="JHN 8:26"/><verse number="27" style="v" sid="JHN 8:27"/>Bôhe barhumvagya oku Îshe aderhaga. <verse eid="JHN 8:27"/><verse number="28" style="v" sid="JHN 8:28"/>Obwo Yezu anacibabwîra, erhi: «Amango mwayinamula Mwene-omuntu, lyo mwamanya oku nie Nyamubâho n’oku ntâco njira oku bwâni bwâni; ebi Larha anyigîrizize byo nderha, <verse eid="JHN 8:28"/><verse number="29" style="v" sid="JHN 8:29"/>n’owantumaga rhwe naye rhubà; arhandekaga niene, bulya ensiku zoshi njira ebimusîmîsa». <verse eid="JHN 8:29"/><verse number="30" style="v" sid="JHN 8:30"/>Erhi abà adwîrhe aderha ntyo, ba­nji bàmuyêmêra.<verse eid="JHN 8:30"/></para>
  <para style="s1">Yezu n’Abrahamu</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31"/>Okuhandi Yezu anacibwîra balya Buyahudi bali bamuyêmîre, erhi: «Mukasêra oku binwa byâni, mwâbà baganda bâni b’okunali; <verse eid="JHN 8:31"/><verse number="32" style="v" sid="JHN 8:32"/>mwamanya okuli, n’okuli kwammurhenza omu bujà». <verse eid="JHN 8:32"/><verse number="33" style="v" sid="JHN 8:33"/>Bamushuza, mpu: «Rhuli b’iburha ly’A­brahamu na ntà mango rhusâg’ibà bajà b’omuntu. Kurhi wankarhubwîraga, mpu: mwayish’ibà bantagengwa?» <verse eid="JHN 8:33"/><verse number="34" style="v" sid="JHN 8:34"/>Yezu anacibashuza, erhi: «Okuli, mmubwîre, ngasi muntu ojira ecâha ali mujà. <verse eid="JHN 8:34"/><verse number="35" style="v" sid="JHN 8:35"/>N’omujà arhabêra omu nyumpa ensiku zoshi; omwâna yeki omubà ensiku zoshi. <verse eid="JHN 8:35"/><verse number="36" style="v" sid="JHN 8:36"/>Erhi Omugala akammucungula, mwanarhenga omu bujà lwoshi. <verse eid="JHN 8:36"/><verse number="37" style="v" sid="JHN 8:37"/>Nêci, mmanyire oku muli iburha ly’Abrahamu; kurharhuma murhalonza okunyîrha, bulya ecinwa câni cirhammujà emurhima. <verse eid="JHN 8:37"/><verse number="38" style="v" sid="JHN 8:38"/>Nie ono nderha ebi nabwîne emwa Larha, ninyu mujira ebi mwayumvîrhe emwa sho». <verse eid="JHN 8:38"/><verse number="39" style="v" sid="JHN 8:39"/>Bamushuza, mpu: «Ci Abrahamu ye Larha!» Yezu ababwîra, erhi: «Mucibâga bene-Abrahamu, singa kwo mujira ak'Abrahamu. <verse eid="JHN 8:39"/><verse number="40" style="v" sid="JHN 8:40"/>Ci mw’abo mwalonza okunyîrha okwenge namammubwîra ebinali nayumvîrhe emwa Nnâmahanga. Okwo A­brahamu arhakujiraga! <verse eid="JHN 8:40"/><verse number="41" style="v" sid="JHN 8:41"/>Mw’oyo bijiro bya sho mujira». Banacimubwîra, mpu: «Rhurhaburhagwa omu bugonyi<note caller="+" style="f"><char style="fr" closed="false">8, 41 </char><char style="ft" closed="false">Obugonyi: Omu kanwa k’Abalêbi, obugonyi kwo kugomera Nnâmahanga.</char></note>; Larha ali muguma: ye Nnâmahanga». <verse eid="JHN 8:41"/><verse number="42" style="v" sid="JHN 8:42"/>Yezu anacibabwîra, erhi: «Nnâmahanga acibâga Sho, singa munzigira, bulya muli Nyamuzinda mpubuka n’emwâge narhengaga. Arhali niene nacîdwîrhe, ci ye wantumaga. <verse eid="JHN 8:42"/><verse number="43" style="v" sid="JHN 8:43"/>Cici cirhuma murhayumva enderho zâni? Bulya murhankahash’iyumva ebinwa byâni<note caller="+" style="f"><char style="fr" closed="false">8, 43 </char><char style="ft" closed="false">Barhakayêmêra ebinwa by’okuli, co cirhumire bali bantu ba shetani, ye mushombanyi w’eby’okuli.</char></note>. <verse eid="JHN 8:43"/><verse number="44" style="v" sid="JHN 8:44"/>Sho ye shetani, na nyîfinjo za sho mulonza okujira. Kurhenga omurhondêro erhi ali mwîsi wa bantu; arhali wa kuderha okuli, bulya okuli kurhamubamwo. Nk’aderha eby’obunywesi, omu murhima gwâge abikûla, bulya ali munywesi ye n’îshe w’obunywesi. <verse eid="JHN 8:44"/><verse number="45" style="v" sid="JHN 8:45"/>Niehe murhanyêmêra, bulya nderha okunali. <verse eid="JHN 8:45"/><verse number="46" style="v" sid="JHN 8:46"/>Ndi muli mwe wankanyagîriza oku câha? Akabà nderha okunali, cirhuma murhanyêmêra? <verse eid="JHN 8:46"/><verse number="47" style="v" sid="JHN 8:47"/>Oli wa Nnâmahanga ayumva ebinwa bya Nnâmahanga; akabà murhabiyumva, kwo kuderha oku murhali ba Nnâmahanga». <verse eid="JHN 8:47"/><verse number="48" style="v" sid="JHN 8:48"/>Abayahudi bamushuza, mpu: «Rhurhahabaga erhi: rhuderha nti ôbà Musamâriya n’oku shetani akubamwo». <verse eid="JHN 8:48"/><verse number="49" style="v" sid="JHN 8:49"/>Yezu abashuza erhi: «Ntalimwo shetani, ci ndwîrhe nahà Larha obukuze, ninyu mudwîrhe mwangayaguza. <verse eid="JHN 8:49"/><verse number="50" style="v" sid="JHN 8:50"/>Nie ono, ntalonza irenge lyâni; hali olinnongeza, ye wayish’itwa olubanja. <verse eid="JHN 8:50"/><verse number="51" style="v" sid="JHN 8:51"/>Okuli, okuli, mmubwîzire, oshimba ebinwa byâni arhakabona lufù ciru n’eliguma». <verse eid="JHN 8:51"/><verse number="52" style="v" sid="JHN 8:52"/>Abayahudi bamubwîra, mpu: «lêro rhwamâmanya bwinjà oku shetani akulimwo. “Abrahamu afîre, n’abalêbi nabo bafà; nâwe, mpu”: “Oshimba ebinwa byâni arhakabona lufù ciru n’eliguma!” <verse eid="JHN 8:52"/><verse number="53" style="v" sid="JHN 8:53"/>“K’olushirage Larha Abrahamu wafîre? N’abalêbi nabo bafîre. Oligi ndi we?”» <verse eid="JHN 8:53"/><verse number="54" style="v" sid="JHN 8:54"/>Yezu abashuza, erhi: «Ncicîkuzagye niene, irenge lyâni lyàli lyabà busha; Larha ye nkuza, olya muderha mpu ye Nyamuzinda winyu, <verse eid="JHN 8:54"/><verse number="55" style="v" sid="JHN 8:55"/>n’obwo murhamuyishi. Niehe mmuyishi, n’erhi nakaderha nti ntamuyishi, nanabà munywesi akinyu. Ci mmuyishi nanshimba akanwa kâge. <verse eid="JHN 8:55"/><verse number="56" style="v" sid="JHN 8:56"/>Sho Abrahamu acîshingiraga okuyish’ibona Olusiku lwâni<note caller="+" style="f"><char style="fr" closed="false">8, 56 </char><char style="ft" closed="false">Olusiku lwa Yezu, lwo lusiku acîyêrekana omu irenge lyâge. Olwo lusiku lwa Kristu, Abrahamu alubwîne omu bulêbi.</char></note>; alubwîne anacîshinga bwenêne». <verse eid="JHN 8:56"/><verse number="57" style="v" sid="JHN 8:57"/>Abayahudi banacimubwîra, mpu: «Ci orhac’ibona myâka makumi arhanu; ngahi wacîboneraga Abrahamu?» <verse eid="JHN 8:57"/><verse number="58" style="v" sid="JHN 8:58"/>Yezu abashuza, erhi: «Okuli, okuli, mmubwîzire, erhi Abrahamu arhac’ibà, erhi ho mbà». <verse eid="JHN 8:58"/><verse number="59" style="v" sid="JHN 8:59"/>Banaciyanka ama­buye mpu bamubandego, ci Yezu acîyongolokera, arhenga omu ka-Nyamuzinda.<verse eid="JHN 8:59"/></para>
  <chapter eid="JHN 8"/>
  <chapter number="9" style="c" sid="JHN 9"/>
  <para style="s1">Yezu afumya omuhûrha kurhenga okuburhwa</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1"/>Erhi agera, abona omuntu waburhagwa ali muhûrha. <verse eid="JHN 9:1"/><verse number="2" style="v" sid="JHN 9:2"/>Abaganda bâge bamudôsa, mpu: «Waliha Muyigîriza, ndi wajizire ecâha, oyu muntu erhi ababusi bâge, obûla abusirwe muhûrha?» <verse eid="JHN 9:2"/><verse number="3" style="v" sid="JHN 9:3"/>Yezu, erhi: «Oli ye oli ababusi bâge ntà câha bajizire, ci mpu lyo obuhashe bwa Nnâmahanga bubonekana kuli ye. <verse eid="JHN 9:3"/><verse number="4" style="v" sid="JHN 9:4"/>Obûla bwacibona, kukwânîne njire emikolo y’owantumaga: obudufu buyiruka<note caller="+" style="f"><char style="fr" closed="false">9, 4 </char><char style="ft" closed="false">Ensiku Kristu agezize en’igulu, kwo zàli nka mulegerege gwa mukolo. Ebijingo by’ogo mulegerege n’obudufu, lwo lusiku lw’amababale n’okufà kwa Yezu. Co carhumaga abwîra abaganda olusiku ahânagwa mpu «bukola bwâmi bwa mwizimya» (<char style="xt"><ref loc="LUK 22:53">Luk 22, 53</ref></char>).</char></note>, n’obudufu burhakola. <verse eid="JHN 9:4"/><verse number="5" style="v" sid="JHN 9:5"/>Obu nciri en’igulu, ndi bumoleke bw’igulu». <verse eid="JHN 9:5"/><verse number="6" style="v" sid="JHN 9:6"/>Erhi abà amâderha ntyo, anacitwîra ahanshi, ajira orhujondo n’amarhî gâge, arhushîga oku masù ga gulya muhûrha. <verse eid="JHN 9:6"/><verse number="7" style="v" sid="JHN 9:7"/>Okubundi amubwîra, erhi: «Jaga ocîshuke omu iriba lya Silowe» kwo kuderha: orhumirwe. Gulya muhûrha gwagenda, gwacishuka gwanagaluka erhi gukola gwabona n’obwâlagale. <verse eid="JHN 9:7"/><verse number="8" style="v" sid="JHN 9:8"/>Abalungu bâge n’abantu bakâg’iyôrha bamubona ajà ahûnahûna, baderha, mpu: «K’arhali olya wakâg’iyôrha ahûnahûna oyu?» <verse eid="JHN 9:8"/><verse number="9" style="v" sid="JHN 9:9"/>Baguma, mpu: «Yenêne». Abandi, mpu: «Arhali ye, ci wundi omushushire». Naye, erhi: «Nie nênè». <verse eid="JHN 9:9"/><verse number="10" style="v" sid="JHN 9:10"/>Bamudôsa, mpu: «Kurhi amasù gâwe gabungûsire?» <verse eid="JHN 9:10"/><verse number="11" style="v" sid="JHN 9:11"/>Abashuza, erhi: «Olya baderha mpu ye Yezu, ye wajiraga orhujondo, arhunshîga oku masù, anambwîra, erhi: “Jaga ocîshuke omu iriba lya Silowe”. “Nayijà, nacîshuka, nanabona”». <verse eid="JHN 9:11"/><verse number="12" style="v" sid="JHN 9:12"/>Bamudôsa, mpu: «Ngahi ali?» Naye, erhi: «Ntishi». <verse eid="JHN 9:12"/><verse number="13" style="v" sid="JHN 9:13"/>Banacîkanyanya olya muntu wali muhûrha emw’Abafarizeyi. <verse eid="JHN 9:13"/><verse number="14" style="v" sid="JHN 9:14"/>Olusiku Yezu ajiraga orhujondo anamuzibûla amasù lwàli lwa Sabato<note caller="+" style="f"><char style="fr" closed="false">9, 14 </char><char style="ft" closed="false">Okujira orhujondo gwàli mukolo guhanzibwe olwa-Sabato.</char></note>. <verse eid="JHN 9:14"/><verse number="15" style="v" sid="JHN 9:15"/>Abafarizeyi nabo bashub’imudôsa kurhi amasù gâge gabungûkaga. Naye, erhi: «Anshîga orhujondo oku masù, nagend’icîshuka, nankola ndwîrhe nabona». <verse eid="JHN 9:15"/><verse number="16" style="v" sid="JHN 9:16"/>Bafarizeyi baguma, mpu: «Oyo muntu arharhenga emwa Nnâmahanga, bulya arhakenga Sabato». Abandi, mpu: «Kurhi omunya-byâha ankajira ebisômerîne biri nk’ebi?» Bacîgabamwo bônene na bônene. <verse eid="JHN 9:16"/><verse number="17" style="v" sid="JHN 9:17"/>Banacishub’idôsa olya wali muhûrha, mpu: «Nâwe kurhi odesire kuli oyo wakuzibûlaga amasù?» Naye, erhi: «Ali mulêbi». <verse eid="JHN 9:17"/><verse number="18" style="v" sid="JHN 9:18"/>Ci Abayahudi barhalonzagya okuyêmêra oku oyo muntu ali muhûrha n’oku akol’adwîrhe abona. Kwo kuhamagala ababusi bâge. <verse eid="JHN 9:18"/><verse number="19" style="v" sid="JHN 9:19"/>Babadôsa, mpu: «Ka mugala winyu oyu, olya muderha mpu aburhagwa muhûrha? Kurhi akolaga adwîrhe abona?» <verse eid="JHN 9:19"/><verse number="20" style="v" sid="JHN 9:20"/>Ababusi bâge bashuza, mpu: «Rhuyishi oku rhwe rhwamuburhaga n’oku aburhagwa erhi afîre amasù. <verse eid="JHN 9:20"/><verse number="21" style="v" sid="JHN 9:21"/>Ci oku akola adwîrhe abona n’owamuzibûlaga amasù, rhurhishi. Mumudôse; akola mulume, yêne acîderhera». <verse eid="JHN 9:21"/><verse number="22" style="v" sid="JHN 9:22"/>Bwôba bwa Buyahudi bwarhumaga ababusi bâge baderha ntyo; bulya bâli erhi bahizire mpu owaderhe oku Yezu ye Kristu anakagwe omu sinagogi. <verse eid="JHN 9:22"/><verse number="23" style="v" sid="JHN 9:23"/>Co carhumaga ababusi bâge baderha, mpu: «Akola mulume; mumudôse yêne». <verse eid="JHN 9:23"/><verse number="24" style="v" sid="JHN 9:24"/>Abayahudi bashub’imuhamagala obwa kabiri, bamubwîra, mpu: «Okuze Nnâmahanga! Rhwêhe rhuyishi oku ola muntu ali munyabyâha». <verse eid="JHN 9:24"/><verse number="25" style="v" sid="JHN 9:25"/>Naye, erhi: «Akabà ali munya-byâha, ntishi; kantu kaguma kône mmanyire: nali muhûrha na buno nkola ndwîrhe nabona». <verse eid="JHN 9:25"/><verse number="26" style="v" sid="JHN 9:26"/>Banacimudôsa, mpu: «Kurhi kulya akujizire? Kurhi akuzibwîre amasù?» <verse eid="JHN 9:26"/><verse number="27" style="v" sid="JHN 9:27"/>Abashuza, erhi: «Nammubwîzire mîra, murhanayumvîrhe­. Carhuma mwalonza nshub’immubwîra? Nkaba ninyu mwalonza okubà baganda bâge?» <verse eid="JHN 9:27"/><verse number="28" style="v" sid="JHN 9:28"/>Banacirhondêra bamujâcira, mpu: «Okaba muganda wâge! Rhwêhe rhuli baganda ba Mûsa. <verse eid="JHN 9:28"/><verse number="29" style="v" sid="JHN 9:29"/>Rhwêhe rhuyishi oku Mûsa ye Nnâmahanga abwîzire ebinwa byâge; ci oyo rhurhishi ali wa ngahi?» <verse eid="JHN 9:29"/><verse number="30" style="v" sid="JHN 9:30"/>Olya mulume abashuza, erhi: «Lêro namasômerwa! Murhishi ali wa ngahi omuntu onfumize obuhûrha! <verse eid="JHN 9:30"/><verse number="31" style="v" sid="JHN 9:31"/>Rhuyishi oku Nyamuzinda arhayumvîrhiza banya­-byâha, ci omuntu omurhumikira n’ojira oku alonza ye ayumvîrhiza. <verse eid="JHN 9:31"/><verse number="32" style="v" sid="JHN 9:32"/>Ka mukola muyumvîrhe omuntu azibwîre amasù gw’owaburhagwa muhûrha? <verse eid="JHN 9:32"/><verse number="33" style="v" sid="JHN 9:33"/>Acibâga arhali emwa Nnâmahanga arhenga, ntâco anankajizire». <verse eid="JHN 9:33"/><verse number="34" style="v" sid="JHN 9:34"/>Bamushuza, mpu: «Kurhenga omu nda ya nyoko erhi oyunjwîre byâha, onakola mpu warhuyigîriza!». Banacimulibirhakwo. <verse eid="JHN 9:34"/><verse number="35" style="v" sid="JHN 9:35"/>Yezu ayumva oku bamulibisirekwo. Erhi bacishimânana, amubwîra, erhi: «K’oyêmîre Mwene-omuntu?» <verse eid="JHN 9:35"/><verse number="36" style="v" sid="JHN 9:36"/>Naye, erhi: «Ye ndi, Nyakasane, mmuyêmêre?» <verse eid="JHN 9:36"/><verse number="37" style="v" sid="JHN 9:37"/>Yezu amubwîra, erhi: «Omubwîne, ye dwîrhe akudesa». <verse eid="JHN 9:37"/><verse number="38" style="v" sid="JHN 9:38"/>Naye, erhi: «Nyêmîre, Nyakasane!» Anacifukama embere zâge. <verse eid="JHN 9:38"/><verse number="39" style="v" sid="JHN 9:39"/>Okuhandi Yezu anaciderha, erhi: «Kucîranula kwandwîrhe en’igulu: lyo abarhabona babona, n’ababona babè mihûrha». <verse eid="JHN 9:39"/><verse number="40" style="v" sid="JHN 9:40"/>Abafarizeyi bahali erhi bayumva, bamudôsa, mpu: «Ka rhuligi mihûrha nîrhu?» <verse eid="JHN 9:40"/><verse number="41" style="v" sid="JHN 9:41"/>Yezu ababwîra, erhi: «Mucibaga mihûrha, rhinga ntà câha mugwêrhe<note caller="+" style="f"><char style="fr" closed="false">9, 41 </char><char style="ft" closed="false">Balya Buyahudi barhayêmîri Yezu bali muhûrha, ci barhalonz’ìmanya oku bali yo; na ntyo barhankafuma.</char></note>. Ci mwêhe, mpu: Kubona rhubona! Co ci­rhumire ecâha cinyu ho cinaciri».<verse eid="JHN 9:41"/></para>
  <chapter eid="JHN 9"/>
  <chapter number="10" style="c" sid="JHN 10"/>
  <para style="s1">Lungere mwinjà</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1"/>«Okuli, okuli, mmubwîre, orhayishiri emuhanda omu lugo lw’ebibuzi, ci ayishe muli yindi njira, erhi ciri cishambo na cishumûsi. <verse eid="JHN 10:1"/><verse number="2" style="v" sid="JHN 10:2"/>Naye oyisha emuhanda, ye mungere w’ebibuzi. <verse eid="JHN 10:2"/><verse number="3" style="v" sid="JHN 10:3"/>Oli oku lumvi anamuyigulire, n’ebibuzi binayumve izù lyâge. Anahamagale ebibuzi byâge ciguma ciguma, anabihuluse. <verse eid="JHN 10:3"/><verse number="4" style="v" sid="JHN 10:4"/>Nka bikola biri emuhanda, anabilongolera nnabyo, n’ebibuzi binamuyishe omu nyuma, bulya biyishi izù lyâge. <verse eid="JHN 10:4"/><verse number="5" style="v" sid="JHN 10:5"/>Ci ecigolo, birhankacikulikira; byana­ciyâka, bulya birhamanyiri izù ly’ebigolo». <verse eid="JHN 10:5"/><verse number="6" style="v" sid="JHN 10:6"/>Yezu abatwa ogwo mugani, ci barhamanyaga ebi alonzagya okuderha. <verse eid="JHN 10:6"/><verse number="7" style="v" sid="JHN 10:7"/>Lêro Yezu anacibabwîra, erhi: «Okuli, okuli, mmubwîzire: nie muhango gw’e­bibuzi. <verse eid="JHN 10:7"/><verse number="8" style="v" sid="JHN 10:8"/>Abàli bayishire embere zâni boshi, biri bishambo na bishumûsi; n’ebibuzi birhabayumvagya. <verse eid="JHN 10:8"/><verse number="9" style="v" sid="JHN 10:9"/>Nie muhango; ongeramwo, kucira acira; anagera anahuluke, agal’ishigâna obwasi akera. <verse eid="JHN 10:9"/><verse number="10" style="v" sid="JHN 10:10"/>Ecishambo cikîsha, erhi kuzimba ciri n’okuyîrha n’okusherêza. Niehe ecandwîrhe, nti ebibuzi bibone akalamo, akalamo kanene. <verse eid="JHN 10:10"/><verse number="11" style="v" sid="JHN 10:11"/>Ndi lungere mwinjà. Lungere mwinjà anahâne obuzîne bwâge erhi bibuzi byâge birhuma. <verse eid="JHN 10:11"/><verse number="12" style="v" sid="JHN 10:12"/>Omulimya, orhali lungere n’orhali nn’ebibuzi, akabona eciryanyi, analeke ebibuzi, acîyâkire, n’eciryanyi canabiyâbukamwo, cibishandâze. <verse eid="JHN 10:12"/><verse number="13" style="v" sid="JHN 10:13"/>Ajira ntyo bulya ali mulimya na ntà buzigire ajira oku bibuzi. <verse eid="JHN 10:13"/><verse number="14" style="v" sid="JHN 10:14"/>Ndi lungere mwinjà; nyîshi ebibuzi byâni, nabyo ebibuzi byâni binyishi, <verse eid="JHN 10:14"/><verse number="15" style="v" sid="JHN 10:15"/>nka kulya Larha anyishi nâni nyîshi Larha; nampâne obuzîne bwâni ebibuzi byâni birhuma. <verse eid="JHN 10:15"/><verse number="16" style="v" sid="JHN 10:16"/>Ngwêrhe ebindi bibuzi birhali muno lugo<note caller="+" style="f"><char style="fr" closed="false">10, 16 </char><char style="ft" closed="false">Bindi bibuzi birhali omu lugo: Ebyo bibuzi birhali omu lugo, bo balya hoshi barhali omu Ekleziya ya Kristu, lwo lugo lw’ebibuzi byayumvîrhe izù lyâge. </char></note>; nabyo kukwânîne mbilerhe; byayumva izù lyâni, na ntyo habè busô buguma na lungere muguma. <verse eid="JHN 10:16"/><verse number="17" style="v" sid="JHN 10:17"/>Eci Larha antonyeza kuli kubà bulya mpâna obuzîne bwâni lyo nshub’ibugalukana. <verse eid="JHN 10:17"/><verse number="18" style="v" sid="JHN 10:18"/>Ntâye wankabunyanka, ci niene mbuhâna. Njira obuhashe bw’oku­buhâna n’okushub’ibuyanka: lyo irhegeko Larha ampîre». <verse eid="JHN 10:18"/><verse number="19" style="v" sid="JHN 10:19"/>Abayahudi bacîgabamwo erhi ebyo binwa birhuma. <verse eid="JHN 10:19"/><verse number="20" style="v" sid="JHN 10:20"/>Banji muli bo bakaderha, mpu: «Shetani omulimwo, adwîrhe ahahabuka. Okumuyumvîrhiza kuli kurhamira busha». <verse eid="JHN 10:20"/><verse number="21" style="v" sid="JHN 10:21"/>Abandi, mpu: «Ebyo binwa birhali bya muntu oli­ mwo shetani. Ka shetani ankazibûla amasù g’omuhûrha?»<verse eid="JHN 10:21"/></para>
  <para style="s1">Yezu amanyîsa Abayahudi oku ye Mwene-Nnâmahanga</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22"/>Byanacibà ntyo! Bajira olusiku lukulu lw’aka-Nyamuzinda<note caller="+" style="f"><char style="fr" closed="false">10, 22 </char><char style="ft" closed="false">Olwo lusiku lwakengezagya okuyûbakwa n’okugishwa kw’aka-Nyamuzinda.</char></note> e Yeruzalemu. Gali mango ga mpondo. <verse eid="JHN 10:22"/><verse number="23" style="v" sid="JHN 10:23"/>Yezu akageragera omu ka-Nyamuzinda omu mbaraza ya Salomoni. <verse eid="JHN 10:23"/><verse number="24" style="v" sid="JHN 10:24"/>Abayahudi banacimuzunguluka, mpu: «Mangaci warhurhûza emirhima eleke okumanana? Akabà we Kristu, rhubwîre n’o­bwâlagale». <verse eid="JHN 10:24"/><verse number="25" style="v" sid="JHN 10:25"/>Yezu abashuza, erhi: «Nammubwîzire, ci murhayêmêra. Ebi njira oku izîno lya Larha<note caller="+" style="f"><char style="fr" closed="false">10, 25 </char><char style="fq" closed="false">Larha </char><char style="ft" closed="false">Kwo Mwâmi Yezu ayôrhaga aderha Nyamuzinda ntyo. </char></note> byo bimpamîriza; <verse eid="JHN 10:25"/><verse number="26" style="v" sid="JHN 10:26"/>ci murhayêmêra bulya murhali b’omu bibuzi byâni. <verse eid="JHN 10:26"/><verse number="27" style="v" sid="JHN 10:27"/>Ebibuzi byâni binayumve izù lyâni; mbiyishi, nabyo binankulikire. <verse eid="JHN 10:27"/><verse number="28" style="v" sid="JHN 10:28"/>Mbihà obuzîne bw’ensiku n’amango; ntà mango byâhere na ntâye wankabinkûla omu maboko. <verse eid="JHN 10:28"/><verse number="29" style="v" sid="JHN 10:29"/>Larha wabimpaga ali mukulu kulusha boshi, na ntâye wankakûla akantu omu nfune za Larha. <verse eid="JHN 10:29"/><verse number="30" style="v" sid="JHN 10:30"/>Larha na nâni rhuli muguma». <verse eid="JHN 10:30"/><verse number="31" style="v" sid="JHN 10:31"/>Abayahudi balêrha amabuye mpu bamubandego. <verse eid="JHN 10:31"/><verse number="32" style="v" sid="JHN 10:32"/>Yezu anacibabwîra, erhi: «Nammuyêresire minjà manji garhenga emwa Larha; muli go lihi mwaâmbandira amabuye?» <verse eid="JHN 10:32"/><verse number="33" style="v" sid="JHN 10:33"/>Abayahudi bamushuza, mpu: «Garhali minjà wajizire garhuma rhwakubanda amabuye, ci bulya walogosire ene ocijira Nnâmahanga n’obwo oli muntu». <verse eid="JHN 10:33"/><verse number="34" style="v" sid="JHN 10:34"/>Yezu anacibashuza, erhi: «Ka kurhayandisirwi omu Marhegeko ginyu: “Nadesire nti: muli ba-nyamuzinda<note caller="+" style="f"><char style="fr" closed="false">10, 34 </char><char style="ft" closed="false">Ako kanwa kayêrekîre abatwî b’emmanja bakâg’iderhwa «ba-nyamuzinda», bulya okutwa emmanja kuli kwa Nyamuzinda. Kuziga ntà kulogorha Mwâmi Yezu alogosire ene acîderha Nyamuzinda, bulya abantu kwône banaderhwe «banyamuzinda» (<char style="xt" link-href="PSA 81:6"><ref loc="PSA 81:82--1">Lul 81[82], 6</ref></char>).</char></note>?” <verse eid="JHN 10:34"/><verse number="35" style="v" sid="JHN 10:35"/>“Ecitabu c’Amarhegeko cidesirage oku balya ebinwa bya Nyamuzinda bibwirwa bali ba-nyamuzinda n’Amandiko garhankazâzibwa”; <verse eid="JHN 10:35"/><verse number="36" style="v" sid="JHN 10:36"/>“ninyu oyu Nyamuzinda Îshe ayimikaga anamurhuma en’igulu, mpu”: “Wamalogorha, okwenge nadesire, nti: Nie Mwene-Nyamuzinda!” <verse eid="JHN 10:36"/><verse number="37" style="v" sid="JHN 10:37"/>“Akabà ntakola emikolo ya Larha, murhanyêmêraga”; <verse eid="JHN 10:37"/><verse number="38" style="v" sid="JHN 10:38"/>“ci akabà nyijira, mukalahira kwanyêmêra, nyêmêreri ciru ebyo bijiro, munayôrhe mumanyire oku Larha andimwo n’oku nâni ndi muli Larha”». <verse eid="JHN 10:38"/><verse number="39" style="v" sid="JHN 10:39"/>Baderha mpu bamugwârhe, ci abafuma.<verse eid="JHN 10:39"/></para>
  <para style="s1">Yezu ajà ishiriza lya Yordani</para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40"/>Ashub’icîjîra ishiriza lya Yordani, emunda Yowane akâg’ibatiziza, anayibêra. <verse eid="JHN 10:40"/><verse number="41" style="v" sid="JHN 10:41"/>Bantu banji bakâjà emunda ali. Bakâbwîrana, mpu: «Yowane ntà cisômerîne ciru n’eciguma ajizire; ci ngasi ebi adesire kuli oyo muntu byoshi byàli by’okunali». <verse eid="JHN 10:41"/><verse number="42" style="v" sid="JHN 10:42"/>Na ntyo, banji bàmuyêmêra.<verse eid="JHN 10:42"/></para>
  <chapter eid="JHN 10"/>
  <chapter number="11" style="c" sid="JHN 11"/>
  <para style="s1">Yezu afûla Lazaro</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1"/>E Betaniya, emwâbo Mariya na mwene wâbo Marta yali omulume mu­lwâla, mpu ye Lazaro. <verse eid="JHN 11:1"/><verse number="2" style="v" sid="JHN 11:2"/>Mariya y’olya washîgaga Nyakasane Yezu omugavu anamuhôrhola amagulu n’emviri zâge. Mushinja wâbo Lazaro ye wali mu­lwâla. <verse eid="JHN 11:2"/><verse number="3" style="v" sid="JHN 11:3"/>Bâli bâbo bombi barhumizagya emwa Yezu, mpu: «Yâgirwa, olya ozigira, alwâla». <verse eid="JHN 11:3"/><verse number="4" style="v" sid="JHN 11:4"/>Erhi Yezu akuyumva aderha, erhi: «Eyo ndwâla erhali ya kufà; ci eri ya kumanyîsa irenge lya Nnâmahanga, lyo Mugala wa Nnâmahanga akuzibwa». <verse eid="JHN 11:4"/><verse number="5" style="v" sid="JHN 11:5"/>Yezu azigiraga Marta n’omulumuna na Lazaro. <verse eid="JHN 11:5"/><verse number="6" style="v" sid="JHN 11:6"/>Erhi ayumva oku Lazaro alwâla, ageza zindi nsiku ibiri aho ali. <verse eid="JHN 11:6"/><verse number="7" style="v" sid="JHN 11:7"/>Okubu­ ndi abwîra abaganda bâge, erhi: «Rhujè e Yudeya». <verse eid="JHN 11:7"/><verse number="8" style="v" sid="JHN 11:8"/>Abaganda bâge bamushuza, mpu: «Waliha Muyigîriza, kurhi washubîrira e Yudeya n’obwo kurhaz’igera nsiku Abayahudi balonzagya okukubanda amabuye?» <verse eid="JHN 11:8"/><verse number="9" style="v" sid="JHN 11:9"/>Yezu abà­shuza, erhi: «Ka omu lusiku ensà zirhaba ikumi n’ibiri? Ogenda mûshi arhasârhala, bulya adwîrhe abona obumoleke bw’igulu; <verse eid="JHN 11:9"/><verse number="10" style="v" sid="JHN 11:10"/>ci ogenda budufu ye sârhala, bulya arhacibona». <verse eid="JHN 11:10"/><verse number="11" style="v" sid="JHN 11:11"/>Erhi abà amâbabwîra ntyo, ayûshûla, erhi: «Omwîra wîrhu Lazaro ali îrò; nagend’imutula». <verse eid="JHN 11:11"/><verse number="12" style="v" sid="JHN 11:12"/>Nabo abaganda bâge, mpu: «Nyakasane, akabà îrò ali, afuma». <verse eid="JHN 11:12"/><verse number="13" style="v" sid="JHN 11:13"/>Yezu alonzagya okuderha oku anafîre, ci bôhe bamanya mpu îrò lya kurhamuka. <verse eid="JHN 11:13"/><verse number="14" style="v" sid="JHN 11:14"/>Lêro Yezu ahumanula, erhi: «Lazaro anafîre; <verse eid="JHN 11:14"/><verse number="15" style="v" sid="JHN 11:15"/>nansîmire bulya ntàhali, lyo muyêmêra. Ci rhujage emunda ali». <verse eid="JHN 11:15"/><verse number="16" style="v" sid="JHN 11:16"/>Naye Toma, oderhwa Didimu, abwîra abâbo baganda, erhi: «Kanyi nîrhu rhujeyo, rhugend’ifà rhwe naye!» <verse eid="JHN 11:16"/><verse number="17" style="v" sid="JHN 11:17"/>Erhi Yezu ahika, ashimâna Lazaro ali nsiku ini abishirwe. <verse eid="JHN 11:17"/><verse number="18" style="v" sid="JHN 11:18"/>Kurhenga e Betaniya kuhika e Yeruzalemu ziri stadi<note caller="+" style="f"><char style="fr" closed="false">11, 18 </char><char style="ft" closed="false">Stadi nguma zo nka metere 185.</char></note> ikumi n’irhanu zône. <verse eid="JHN 11:18"/><verse number="19" style="v" sid="JHN 11:19"/>Buyahudi ba­nji bâli bayishire aho mwâbo Marta na Mariya mpu babarhulirize oku lufù lwa mushinja wâbo. <verse eid="JHN 11:19"/><verse number="20" style="v" sid="JHN 11:20"/>Erhi Marta ayumva oku Yezu ayiruka, agend’imulinga, naye Mariya asigala abwârhîre omu nyumpa. <verse eid="JHN 11:20"/><verse number="21" style="v" sid="JHN 11:21"/>Marta abwîra Yezu, erhi: «Waliha, ocibâga hano, mushinja wâni arhankafîre. <verse eid="JHN 11:21"/><verse number="22" style="v" sid="JHN 11:22"/>Ci kwône manyire oku na buno ngasi coshi wankahûna Nnâmahanga anakuhaco». <verse eid="JHN 11:22"/><verse number="23" style="v" sid="JHN 11:23"/>Yezu amubwîra, erhi: «Mushinja wâwe âfûka», <verse eid="JHN 11:23"/><verse number="24" style="v" sid="JHN 11:24"/>Marta, erhi: «Manyire oku afûka omu bufûke bw’olusiku luzinda». <verse eid="JHN 11:24"/><verse number="25" style="v" sid="JHN 11:25"/>Yezu amubwîra, erhi: «Nie bufûke. Onyêmîre, ciru akafà, alama; <verse eid="JHN 11:25"/><verse number="26" style="v" sid="JHN 11:26"/>na ngasi yêshi olama muli nie onanyêmêra, arhakafà ciru n’eliguma. Okwo, ka okuyêmîre?» <verse eid="JHN 11:26"/><verse number="27" style="v" sid="JHN 11:27"/>Naye, erhi: «Nêci, Yâgirwa, nyêmîre oku we Kristu, Mugala wa Nyamuzinda wayishire en’igulu». <verse eid="JHN 11:27"/><verse number="28" style="v" sid="JHN 11:28"/>Erhi ayûs’iderha ebyo binwa, aj’ihamagala mwene wâbo Mariya. Amuhwehwerheza, erhi: «Omuyigîriza kwo ali kuno, akuhamagîre». <verse eid="JHN 11:28"/><verse number="29" style="v" sid="JHN 11:29"/>Mariya erhi ayumva okwo, anacibaduka ho na halya, ajà emunda Yezu àli. <verse eid="JHN 11:29"/><verse number="30" style="v" sid="JHN 11:30"/>Yezu arhàli acija omu lugo; aciri halya Marta amushimânaga. <verse eid="JHN 11:30"/><verse number="31" style="v" sid="JHN 11:31"/>Abayahudi bâli omu nyumpa na Mariya banakâg’imurhûliriza, erhi babona abaduka anahuluka bulibirha, bamukulikira, bamanya mpu aj’ilakira ebwa cûsho. <verse eid="JHN 11:31"/><verse number="32" style="v" sid="JHN 11:32"/>Erhi Mariya ahika aha Yezu ali n’erhi amubona, acîkwêba aha magulu gâge, erhi: «Nyakasane, ocibâga hano, mushinja wâni arhakafîre!» <verse eid="JHN 11:32"/><verse number="33" style="v" sid="JHN 11:33"/>Yezu erhi abona agwîra emirenge haguma n’Abayahudi bâli naye, ecifufu camugwârha anayumva oburhè. <verse eid="JHN 11:33"/><verse number="34" style="v" sid="JHN 11:34"/>Anacidôsa, erhi: «Ngahi mwamuhizire?» Bamushuza, mpu: «Waliha, yishaga ohabone». <verse eid="JHN 11:34"/><verse number="35" style="v" sid="JHN 11:35"/>Yezu anacirhondêra arhoza emirenge. <verse eid="JHN 11:35"/><verse number="36" style="v" sid="JHN 11:36"/>Obwo Abayahudi banaciderha, mpu: «Nêci amusîmaga wa!» <verse eid="JHN 11:36"/><verse number="37" style="v" sid="JHN 11:37"/>Ci abandi muli bo baderha, mpu: «Ci ye wazibûlaga amasù ga gulya muhûrha! Ka arhankahashire okurhegeka oyu arhafè?» <verse eid="JHN 11:37"/><verse number="38" style="v" sid="JHN 11:38"/>Yezu ashub’igwârhwa n’ecifufu, ajà e­bwa cûsho. Gwàli mwîna gufûnisirwe n’ibuye. <verse eid="JHN 11:38"/><verse number="39" style="v" sid="JHN 11:39"/>Yezu anacibabwîra abalondana, erhi: «Kûli eri ibuye! “Marta, erhi: Waliha, akola adwîrhe abaya bulya ene lwo lusiku lwa kani”». <verse eid="JHN 11:39"/><verse number="40" style="v" sid="JHN 11:40"/>Yezu amushuza, erhi: «Ka ntakubwîzire nti akabà oyêmîre, wabona irenge lya Nnâmahanga?» <verse eid="JHN 11:40"/><verse number="41" style="v" sid="JHN 11:41"/>Banacikûla lirya ibuye. Okuhandi Yezu ayînamula amasù, aderha, erhi: «Larha, nkuvuzire omunkwa, kulya kubà wa­nyumvîrhîze. <verse eid="JHN 11:41"/><verse number="42" style="v" sid="JHN 11:42"/>Nyôrha nyîshi oku onyumvîrhiza ensiku zoshi; ci abantu bazungulusire bo barhumire naderha ntyo, lyo bayêmêra oku we wantumaga». <verse eid="JHN 11:42"/><verse number="43" style="v" sid="JHN 11:43"/>Erhi ayûs’iderha ntyo, ayâkûza n’izù linene, erhi: «Lazaro huluka, ojà eno mbuga!» <verse eid="JHN 11:43"/><verse number="44" style="v" sid="JHN 11:44"/>Nyakufà ahuluka, amagulu n’amaboko mashwêke n’orhutambara, n’obusù bubwîke n’omwenda. Yezu ababwîra, erhi: «Shwêkûliye, mu­muleke agende».<verse eid="JHN 11:44"/></para>
  <para style="s1">Abarhambo b’Abayahudi bajà ihano ly’okuyîrha Yezu</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45"/>Erhi babona eco cirhangâzo Yezu ajiraga, Buyahudi banji bâli emwâbo Mariya bamuyêmêra. <verse eid="JHN 11:45"/><verse number="46" style="v" sid="JHN 11:46"/>Ci bayish’irhengamwo n’abaj’ibombolera Abafarizeyi ebi Yezu ajizire. <verse eid="JHN 11:46"/><verse number="47" style="v" sid="JHN 11:47"/>Abajinji b’abadâhwa n’Abafarizeyi kwo kujà ihano, mpu: «Cici rhwâjira obu oyo muntu adwîrhe ajira ebisômerîne binji? <verse eid="JHN 11:47"/><verse number="48" style="v" sid="JHN 11:48"/>Rhukamule­ka, abantu boshi bamuyêmêra, n’Abaroma bayish’irhuyôkera aka-Nyamuzinda n’obûko bwîrhu». <verse eid="JHN 11:48"/><verse number="49" style="v" sid="JHN 11:49"/>Muguma muli bo, Kayifa, ye wali mudâhwa mukulu o­gwo mwâka, ababwîra, erhi: «Murhabona! <verse eid="JHN 11:49"/><verse number="50" style="v" sid="JHN 11:50"/>Ka murhishi mwêki oku ku­kwânîne muntu muguma afîre olubaga lyo ecihugo coshi cirek’ihera?» <verse eid="JHN 11:50"/><verse number="51" style="v" sid="JHN 11:51"/>Arhali yêne wacibwîraga ebyo binwa, ci bulya ali mudâhwa mukulu, alêba oku Yezu ali akwânîne afîre ecihugo câge, <verse eid="JHN 11:51"/><verse number="52" style="v" sid="JHN 11:52"/>arhanali cihugo câge cône, ci mpu lyo ashûbûza abâna ba Nnâmahanga bâli bashandabîne. <verse eid="JHN 11:52"/><verse number="53" style="v" sid="JHN 11:53"/>Kurhenga olwo lusiku, bahiga là mpu kuhika bamuyîrhe. <verse eid="JHN 11:53"/><verse number="54" style="v" sid="JHN 11:54"/>Naye Yezu aleka okucîmoleka Abayahudi. Acîyêgûla, ajà hôfi n’abaciga, omu cishagala ciderhwa Efrayimu, acibêrerayo bo n’abaganda bâge.<verse eid="JHN 11:54"/></para>
  <para style="s1">Hôfi ha Basâka</para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55"/>Basâka w’Abayahudi àli hôfi, n’abantu banji bayinamukira e Yeruzalemu mpu bagend’icicêsa. <verse eid="JHN 11:55"/><verse number="56" style="v" sid="JHN 11:56"/>Bakalongereza Yezu n’okudôsanya omu ka-Nyamuzinda, mpu: «Kurhi mukengîre? K’ayisha oku lusiku lukulu erhi nanga?» <verse eid="JHN 11:56"/><verse number="57" style="v" sid="JHN 11:57"/>Abajinji b’abadâhwa n’Abafarizeyi bâli erhi bàrhegesire mpu owamanye ah’ali anababwîre, bagend’imugwârha.<verse eid="JHN 11:57"/></para>
  <chapter eid="JHN 11"/>
  <chapter number="12" style="c" sid="JHN 12"/>
  <para style="s1">Yezu ashîgwa amavurha g’omugavu</para>
  <para style="r">(<ref loc="MAT 26:6-13">Mat 26, 6-13</ref>; <ref loc="MRK 14:3-9">Mrk 14, 3-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1"/>Erhi hasigala nsiku ndarhu embere za Basâka, Yezu ajà e Betaniya, emunda Lazaro afûlaga àbâga. <verse eid="JHN 12:1"/><verse number="2" style="v" sid="JHN 12:2"/>Bamushêgera, na Marta akamurhumikira. Lazaro naye àli omu bâli oku cîbo bo naye. <verse eid="JHN 12:2"/><verse number="3" style="v" sid="JHN 12:3"/>Mariya anaciyanka enjebe y’amavurha g’omugavu gw’engulo ndârhi, arhondêra agashîga Yezu oku magulu anagahôrhola n’emviri zâge; enyumpa yoshi yayunjula kìsûnunu. <verse eid="JHN 12:3"/><verse number="4" style="v" sid="JHN 12:4"/>Yûda w’e Keriyoti, muguma w’omu baganda bâge, olya wali ayish’imuhâna, aderha, erhi: <verse eid="JHN 12:4"/><verse number="5" style="v" sid="JHN 12:5"/>«Owaguzagya ogu mugavu dinari<note caller="+" style="f"><char style="fr" closed="false">12, 5 </char><char style="ft" closed="false">Idinari lwo lwàli lusaranga lw’Abaroma.</char></note> bihumbi bisharhu, akazihà abakenyi!» <verse eid="JHN 12:5"/><verse number="6" style="v" sid="JHN 12:6"/>Lurhàli lukogo lwa bakenyi aderheraga ntyo, ci bulya càli cishambo na bulya ye wabîkaga enshoho, akazâg’izimba ebyàlimwo. <verse eid="JHN 12:6"/><verse number="7" style="v" sid="JHN 12:7"/>Yezu, erhi: «Mumuleke. “Ogu mugavu àli agubîkîre olusiku lw’okubishwa kwâni<note caller="+" style="f"><char style="fr" closed="false">12, 7 </char><char style="ft" closed="false">olusiku lw’okubishwa kwâni: Eco cijiro ca Mariya ciri nka kulya abantu bashîga omubiri gw’ofîre mpu bamuyêreke obukenge.</char></note>.” <verse eid="JHN 12:7"/><verse number="8" style="v" sid="JHN 12:8"/>“Bulya abakenyi, e­nsiku zoshi muli haguma nabo, ci niehe arhali ensiku zoshi mwâmbona”». <verse eid="JHN 12:8"/><verse number="9" style="v" sid="JHN 12:9"/>Bayahudi banji bamanya oku ho ali aho, banayisha, arhali Yezu yênene o­rhumire, ci mpu babone na Lazaro afûlaga. <verse eid="JHN 12:9"/><verse number="10" style="v" sid="JHN 12:10"/>Abajinji b’abadâhwa bahiga okuyîrha Lazaro naye, <verse eid="JHN 12:10"/><verse number="11" style="v" sid="JHN 12:11"/>bulya Bayahudi banji bakâg’ibaleka erhi ye rhuma, bakayêmêra Yezu.<verse eid="JHN 12:11"/></para>
  <para style="s1">Yezu ajà omu Yeruzalemu</para>
  <para style="r">(<ref loc="MAT 21:1-9">Mat 21, 1-9</ref>; <ref loc="MRK 11:1-10">Mrk 11, 1-10</ref>; <ref loc="LUK 19:28-38">Luk 19, 28-38</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12"/>Erhi buca, erya ngabo y’abantu bâli oku lukulu bayumva oku Yezu ali omu njira y’okujà e Yeruzalemu. <verse eid="JHN 12:12"/><verse number="13" style="v" sid="JHN 12:13"/>Bahagula amashami g’emishugushugu, bagend’imulinga n’okukayakûza, mpu: «Hozana! Agishwe oyu oyishire oku izîno lya Nyakasane, ye Mwâmi w’Israheli!» <verse eid="JHN 12:13"/><verse number="14" style="v" sid="JHN 12:14"/>Yezu abona omucukà gw’endogomi, agushonakwo nk’oku byàli biyandisirwe, mpu: <verse eid="JHN 12:14"/><verse number="15" style="v" sid="JHN 12:15"/>«Orhayôbohaga, mwâli wa Siyoni<note caller="+" style="f"><char style="fr" closed="false">12, 15 </char><char style="ft" closed="false">Mwâli wa Siyoni, kwo kuderha abantu b’e Yeruzalemu.</char></note>; Mwâmi wâwe oyo oyishire, ashonyire oku mucûkà gw’e­ndogomi». <verse eid="JHN 12:15"/><verse number="16" style="v" sid="JHN 12:16"/>Abaganda bâge barhayirukiraga bayumva; ci erhi Yezu abà amâkuzibwa, bakengcra oku ebyo byàli biyandisirwe kuli ye n’oku byo bànali bamujirire. <verse eid="JHN 12:16"/><verse number="17" style="v" sid="JHN 12:17"/>Balya boshi bâli ah’akûlaga Lazaro omu nshinda anamufûla omu bafù, bakâg’ihamîriza. <verse eid="JHN 12:17"/><verse number="18" style="v" sid="JHN 12:18"/>Kwo kwanarhumire olubaga lugend’imulinga: bulya bâli bayumvîrhe oku ajizire eco cisômezo. <verse eid="JHN 12:18"/><verse number="19" style="v" sid="JHN 12:19"/>Obwo Abafarizeyi bakâbwîrana, mpu: «Ka murhabwîni oku murhamuhashe! Obu Olubaga lwoshi lumushimbire!»<verse eid="JHN 12:19"/></para>
  <para style="s1">Yezu alêba oku kukwânîne afè lyo akuzibwa</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20"/>Omu bantu baliyishir’iharâmya oku lusiku lukulu, mwâli Abagereki. <verse eid="JHN 12:20"/><verse number="21" style="v" sid="JHN 12:21"/>Banaciyegera Filipo wali w’e Betisayida omu Galileya, bamubwîra, mpu: «Waliha, rhwankasîmire nîrhu okubona Yezu». <verse eid="JHN 12:21"/><verse number="22" style="v" sid="JHN 12:22"/>Filipo abwîra Andreya; Andreya na Filipo baj’ibwîra Yezu. <verse eid="JHN 12:22"/><verse number="23" style="v" sid="JHN 12:23"/>Yezu abashuza, erhi: «Amango Mwene-omuntu akuzibwa gayishire. <verse eid="JHN 12:23"/><verse number="24" style="v" sid="JHN 12:24"/>Okuli, okuli, mmubwîzire, nka mbeke y’engano erharhogîri omu budaka ekanafâ, enayôrhe yône; ci ekafà, lyo eburha mburho nyinji<note caller="+" style="f"><char style="fr" closed="false">12, 24 </char><char style="ft" closed="false">Nka mbeke ya ngano: Naye Yezu afà lyo acungula abantu, lyo baburhwa omu buzîne buhyâhya. </char></note>. <verse eid="JHN 12:24"/><verse number="25" style="v" sid="JHN 12:25"/>Osîma obuzîne bwâge, anaburhêre; naye oshomba obuzîne bwâge hano igulu, anabulange omu kalamo k’ensiku n’amango. <verse eid="JHN 12:25"/><verse number="26" style="v" sid="JHN 12:26"/>Olonza okunshiga, anshimbe; n’aha ndi, ho n’omwambali wâni ayish’ibà. Omuntu o­nshizire, Larha ayish’imukuza. <verse eid="JHN 12:26"/><verse number="27" style="v" sid="JHN 12:27"/>Bunôla omurhima gwâni gwamâfuduka. Ku­erhi naderhaga? Larha, oncize kuli aga mango. Càbà co carhumaga mpika muli aga mango. <verse eid="JHN 12:27"/><verse number="28" style="v" sid="JHN 12:28"/>Larha, kuza izîno lyâwe!» Izù lyanacirhenga emalunga, erhi: «Nalikuzize nanacîlikuza kandi». <verse eid="JHN 12:28"/><verse number="29" style="v" sid="JHN 12:29"/>Engabo y’abantu yahali, erhi eyumva, yaderha mpu mulazo; abandi, mpu: «Malahika washambâlaga bo naye». <verse eid="JHN 12:29"/><verse number="30" style="v" sid="JHN 12:30"/>Yezu ashuza, erhi: «Arhali nie narhumaga eryo izù lyayumvika, ci mwe mwarhumaga. <verse eid="JHN 12:30"/><verse number="31" style="v" sid="JHN 12:31"/>Ganôla go mango igulu lyatwîrwa olubanja<note caller="+" style="f"><char style="fr" closed="false">12, 31 </char><char style="ft" closed="false">Okufà kwa Yezu n’okufûka kwâge kwarhenza abantu omu bujà bwa shetani, ye wali muluzi w’igulu embere Kristu arhucize.</char></note>; ganôla go mango omuluzi wa lîno igulu ajugucirwa e­mbuga. <verse eid="JHN 12:31"/><verse number="32" style="v" sid="JHN 12:32"/>Nâni bano nyînamulwa kurhenga igulu<note caller="+" style="f"><char style="fr" closed="false">12, 32 </char><char style="ft" closed="false">Omu cigereki «hupsôo», kuli kuyînamulwa na kukuzibwa: Yezu ayînamulwa olusiku abambwa oku musalaba. Obwo abantu boshi babone oku ye Muciza w’igulu. Ntyo kwo ashuzize Abagereki balonzagya okumubona.</char></note>, nânakululira abantu boshi emunda ndi». <verse eid="JHN 12:32"/><verse number="33" style="v" sid="JHN 12:33"/>Aderha ntyo mpu ayêrekane lufù luci ayish’ifà. <verse eid="JHN 12:33"/><verse number="34" style="v" sid="JHN 12:34"/>Olubaga lwamushuza, mpu: «Ci rhwayumvîrhe omu Citabu c’Amarhegeko<note caller="+" style="f"><char style="fr" closed="false">12, 34 </char><char style="ft" closed="false">Ecitabu c’Amarhegeko, go Mandiko matagatîfu, kandi erhi ecigabi cirhanzi ca Bibliya, bitabu birhanu birhanzi: Murh; Lub; Lev; Mib; Lush.</char></note> oku Kristu àbâho ensiku zoshi. “Kurhi w’oyo ocidesirage, mpu”: “Kukwânîne Mwene-omuntu ayinamulwe?” “Yerigi ndi oyo Mwene-omuntu?”» <verse eid="JHN 12:34"/><verse number="35" style="v" sid="JHN 12:35"/>Yezu abashuza, erhi: «Obulangale burhaciri ninyu kasanzi kanene. Kaz’imugende obu bwacibona, lyo omwizimya gulek’immugwanyanya. Ogenda omu mwizimya, arhamanya ah’ajà. <verse eid="JHN 12:35"/><verse number="36" style="v" sid="JHN 12:36"/>Obu mucigwêrhe obulangale, yêmêri obulangale, lyo muhinduka bâna b’obûla­ngâlè». Erhi Yezu ayûs’iderha ntyo, acîgendera, abarhêreka.<verse eid="JHN 12:36"/></para>
  <para style="s1">Yezu afundika enyigîrizo: okubula obuyêmêre kw’Abayahudi</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37"/>Ali ajizire bisômerîne binji omu masù gâbo, barhanamuyêmêraga, <verse eid="JHN 12:37"/><verse number="38" style="v" sid="JHN 12:38"/>lyo aka kanwa k’omulêbi Izaya kayunjula, erhi: «Nyakasane, ndi wayêmîre ebinwa bîrhu? N’okuboko kwa Nyakasane, ndi kwamanyisîbwe»? <verse eid="JHN 12:38"/><verse number="39" style="v" sid="JHN 12:39"/>Câbà barhankanayêmîre, bulya Izaya ashubir’iderha, erhi: <verse eid="JHN 12:39"/><verse number="40" style="v" sid="JHN 12:40"/>«Amasù gâbo agahunyize n’emirhima yâbo ayiziba, mpu lyo amasù gâbo galek’ibona n’emirhima yâbo erek’iyumva, lyo barhahinduka binjà, lyo ntanabafumya<note caller="+" style="f"><char style="fr" closed="false">12, 40 </char><char style="ft" closed="false">Nnâmahanga alonza okuciza abantu boshi, ci arhasêza ndi. Omuntu akalahira inêma lya Nnâmahanga, nalyo linamulahire.</char></note>». <verse eid="JHN 12:40"/><verse number="41" style="v" sid="JHN 12:41"/>Izaya aderha ntyo erhi abona irenge lya Yezu, ye anaderhaga erhi alêba ntyo. <verse eid="JHN 12:41"/><verse number="42" style="v" sid="JHN 12:42"/>Ci kwône banji, ciru n’omu bagula, bamuyêmêra; ci barhakâg’icîyêrekana erhi kuyôboha Abafarizeyi kurhuma, mpu balek’ikagwa omu sinagogi. <verse eid="JHN 12:42"/><verse number="43" style="v" sid="JHN 12:43"/>Ntyo basîma irenge lirhenga emwa abantu ahâli h’irenge lirhenga emwa Nnâmahanga. <verse eid="JHN 12:43"/><verse number="44" style="v" sid="JHN 12:44"/>Yezu anaciyâkûza n’izù linene, erhi: «Onyêmêra, arhali nie ayêmêra, ci olya wantumaga, <verse eid="JHN 12:44"/><verse number="45" style="v" sid="JHN 12:45"/>n’ombwîne erhi owantumaga ye abwîne. <verse eid="JHN 12:45"/><verse number="46" style="v" sid="JHN 12:46"/>Nie bulangale najîre en’igulu, mpu lyo ngasi onyêmîre alek’ibêra omu mwizimya. <verse eid="JHN 12:46"/><verse number="47" style="v" sid="JHN 12:47"/>Oyumva ebinwa byâni arhanabishimbe, arhali nie nâmutwîre olubanja, bulya ntayishig’itwa manja, ci nti ncize igulu. <verse eid="JHN 12:47"/><verse number="48" style="v" sid="JHN 12:48"/>Ongayaguza n’okurhayumva ebinwa byâni agwêrhe owamutwîra olubanja: ebinwa nadesire byo byâmutwîre olubanja olusiku luzinda. <verse eid="JHN 12:48"/><verse number="49" style="v" sid="JHN 12:49"/>Bulya arhali byâni nadesire, ci Larha wantumaga ye wantegesire eby’okuderha n’eby’okuyigîriza. <verse eid="JHN 12:49"/><verse number="50" style="v" sid="JHN 12:50"/>Nanyishi oku irhegeko lyâge liri kalamo k’ensiku n’amango. Ebinwa nderha, oku Larha abimbwîzire kwo mbiderha».<verse eid="JHN 12:50"/></para>
  <chapter eid="JHN 12"/>
  <chapter number="13" style="c" sid="JHN 13"/>
  <para style="ms1">II. Amango ga Yezu na Basâka w’Omwâna-buzi wa Nnâmahanga</para>
  <para style="s1">Yezu ashuk’Entumwa amagulu</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1"/>Embere z’olusiku lukulu lwa Basâka, Yezu erhi amanyire oku amango gâge gahisire g’okurhenga en’igulu n’okushubira emw’Îshe; n’erhi abà amâzigira abâge bàl’igulu, abazigira lwoshi. <verse eid="JHN 13:1"/><verse number="2" style="v" sid="JHN 13:2"/>Erhi babà bakola badwîrhe ba­lya, erhi na shetani ahîrage Yûda w’e Keriyoti mwene Simoni, omu murhima, ihano ly’oku­muhâna, <verse eid="JHN 13:2"/><verse number="3" style="v" sid="JHN 13:3"/>erhi amanyire oku Îshe ahizire obuhashe bwoshi omu maboko gâge n’oku emwa Nnâmahanga arhengaga n’emwa Nnâmahanga ashubira, <verse eid="JHN 13:3"/><verse number="4" style="v" sid="JHN 13:4"/>ayimuka oku cîbo, ahogola ecishûli câge, arhôla ecitambara, acikobeka. <verse eid="JHN 13:4"/><verse number="5" style="v" sid="JHN 13:5"/>Okuhandi anacidubulira amîshi omu ibakuli, arhondêr’ashuka amagulu g’abaganda bâge<note caller="+" style="f"><char style="fr" closed="false">13, 5 </char><char style="ft" closed="false">Okushuka omuntu amagulu gwàli mukolo gwa bajà.</char></note> n’okugahorhola na cirya citambara ali akobesire. <verse eid="JHN 13:5"/><verse number="6" style="v" sid="JHN 13:6"/>Anacihika hali Simoni Petro. Petro amubwîra, erhi: «Nyakasane, ka we wanshuka amagulu?» <verse eid="JHN 13:6"/><verse number="7" style="v" sid="JHN 13:7"/>Yezu ashuza, erhi: «Oku nâjira, orhakumanyiri buno; wâcikuyumva». <verse eid="JHN 13:7"/><verse number="8" style="v" sid="JHN 13:8"/>Petro, erhi: «Nanga, ntà mango wankanshuka amagulu!» Yezu amushuza, erhi: «Nkaba ntakushusiri, orhakacishangîra nâni». <verse eid="JHN 13:8"/><verse number="9" style="v" sid="JHN 13:9"/>Naye Simoni Petro, erhi: «Nyakasane, akabà ntyo, arhali magulu gône, ci n’enfune n’irhwe!» <verse eid="JHN 13:9"/><verse number="10" style="v" sid="JHN 13:10"/>Yezu amubwîra, erhi: «Owamayûs’icîkalaba, ntà kundi ankacicêsibwa; acîre lwoshi. Ninyu mukola mucîre, ci arhali mweshi». <verse eid="JHN 13:10"/><verse number="11" style="v" sid="JHN 13:11"/>Bulya ali amanyire ndi wâmuhâna; co carhumaga aderha, erhi: «Murhali mweshi mucîre». <verse eid="JHN 13:11"/><verse number="12" style="v" sid="JHN 13:12"/>Erhi ayûs’ibashuka amagulu n’erhi abà amâshub’iyambala emyambalo yâge amânashub’ibwârhala oku cîbo, ababwîra, erhi: «Ka muyumvîrhe okwo mmujirîre? <verse eid="JHN 13:12"/><verse number="13" style="v" sid="JHN 13:13"/>Kwo munderha mpu Muyigîriza na Nyakasane, n’okwo muderha kwo binali, bulya ndi ye. <verse eid="JHN 13:13"/><verse number="14" style="v" sid="JHN 13:14"/>Obûla nie Nyakasane na Muyigîriza namâmmushuka amagulu, ninyu mukwânîne okukashukana amagulu. <verse eid="JHN 13:14"/><verse number="15" style="v" sid="JHN 13:15"/>Nammuhîre olwiganyo, nti ninyu mukajira oku mmujirîre. <verse eid="JHN 13:15"/><verse number="16" style="v" sid="JHN 13:16"/>Okuli, okuli, mmubwîre, omushizi arhalusha nnawâbo, n’omuganda arhalusha owamurhumaga. <verse eid="JHN 13:16"/><verse number="17" style="v" sid="JHN 13:17"/>Mukamanya ebyo mukanabijira, mwâbà bany’iragi. <verse eid="JHN 13:17"/><verse number="18" style="v" sid="JHN 13:18"/>Arhali mweshi ndesire; mmanyire abanacîshozire; ci kwônene kuhika akanwa kayandisirwe kabè, mpu: Oyu rhushangîre omugati rhwe naye, ayimusize omwigegere mpu agunshenye<note caller="+" style="f"><char style="fr" closed="false">13, 18 </char><char style="ft" closed="false">Alengezize omwigegere agunshenye: <char style="xt"><ref loc="PSA 40:10">Lul 40, 10</ref></char>.</char></note>. <verse eid="JHN 13:18"/><verse number="19" style="v" sid="JHN 13:19"/>Mbîre nammubwîrakwo buno kurhac’ibà, lyo hano kubà muyêmêra oku nie Nyamubâho. <verse eid="JHN 13:19"/><verse number="20" style="v" sid="JHN 13:20"/>Okuli, okuli, mmubwîzire, oyankirîre omuntu ntumire, erhi anyankirîre, n’onyankirîre, erhi owantumaga ye ayankirîre».<verse eid="JHN 13:20"/></para>
  <para style="s1">Yezu amanyîsa obulyâlya bwa Yûda</para>
  <para style="r">(<ref loc="MAT 26:21-25">Mat 26, 21-25</ref>; <ref loc="MRK 14:18-21">Mrk 14, 18-21</ref>; <ref loc="LUK 22:21-23">Luk 22, 21-23</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21"/>Erhi Yezu ayûs’iderha ntyo, ecifufu camugwârha, ahamîriza, anaciderha, erhi: «Okuli, okuli, mmubwîre, muguma muli mwe ampâna». <verse eid="JHN 13:21"/><verse number="22" style="v" sid="JHN 13:22"/>Abaganda bâge bakalolanakwo, bulya barhàli bamanyire ndi akâg’iderha. <verse eid="JHN 13:22"/><verse number="23" style="v" sid="JHN 13:23"/>Muguma w’omu baganda bâge, olya Yezu azigiraga, àli oku cîbo ashegemize irhwe oku cifuba ca Yezu. <verse eid="JHN 13:23"/><verse number="24" style="v" sid="JHN 13:24"/>Simoni Petro anacimukema, erhi: «Dôsa ndi oyo adwîrhe aderha». <verse eid="JHN 13:24"/><verse number="25" style="v" sid="JHN 13:25"/>Naye ayunamiza irhwe oku cifuba ca Yezu, amubwîra, erhi: «Ndi oyo, Nyakasane?» <verse eid="JHN 13:25"/><verse number="26" style="v" sid="JHN 13:26"/>Yezu ashuza, erhi: «Oyu nankahà ecihimbi c’omugati nârhobeza erhi ye». Anacirhobeza ecihimbi c’omugati, aciyanka, acihêreza Yûda mwene Simoni w’e Keriyoti. <verse eid="JHN 13:26"/><verse number="27" style="v" sid="JHN 13:27"/>Erhi ayûs’imira eco cihimbi c’omugati, Shetani amujamwo. Okuhandi Yezu anacimubwîra, erhi: «Okuwalonza okujira, okujirage duba». <verse eid="JHN 13:27"/><verse number="28" style="v" sid="JHN 13:28"/>Ci muli abàli oku cîbo ntâye wayumvîrhe ecarhumaga amubwîra ako kanwa. <verse eid="JHN 13:28"/><verse number="29" style="v" sid="JHN 13:29"/>Bulya Yûda ye wakâg’ibîka oluhago, banji bacîkebwa mpu Yezu alonzagya okumubwîra, erhi: «Gula ebirhukwânîne oku lusiku lukulu», nîsi erhi amurhegekaga mpu ahè abakenyi akantu. <verse eid="JHN 13:29"/><verse number="30" style="v" sid="JHN 13:30"/>Oku anayûs’imira cirya cihimbi c’omugati, kwo na kuhuluka. Bwàli budufu. <verse eid="JHN 13:30"/><verse number="31" style="v" sid="JHN 13:31"/>Erhi abà amahuluka, Yezu anaciderha, erhi: «Bunôla Mwene-omuntu amâkuzibwa, na Nnâmahanga akuzîbwe muli ye. <verse eid="JHN 13:31"/><verse number="32" style="v" sid="JHN 13:32"/>“Akabà Nnâmahanga akuzîbwe muli ye, naye Nnâmahanga amuhà obukuze, arhanaciyimang’imukuza”».<verse eid="JHN 13:32"/></para>
  <para style="s1">Yezu asêzera abaganda bâge</para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 13:33"/>«Rhwana rhwâni, nciri ninyu hisanzi hisungunu. “Mwayish’innonza… na kulya nabwîraga Abayahudi, nti”: “Aha najà murhankahahika”, “ninyu mmubwîzireko buno”». <verse eid="JHN 13:33"/><verse number="34" style="v" sid="JHN 13:34"/>«Mmuhîre irhegeko lihyâhya: muzigirane; nk’oku na­mmuzigîre, kwo ninyu mukâg’izigirana. <verse eid="JHN 13:34"/><verse number="35" style="v" sid="JHN 13:35"/>“Ecimanyîso abantu boshi babonere­ kwo oku muli baganda bâni, bwo buzigire mwâzigirane”». <verse eid="JHN 13:35"/><verse number="36" style="v" sid="JHN 13:36"/>Simoni Petro amubwîra, erhi: «Yâgirwa, ngahi aho wâjà?» Yezu amushuza, erhi: «Aha nâja, orhankashub’inkulikiraho buno; wâcinshimbe buzinda». <verse eid="JHN 13:36"/><verse number="37" style="v" sid="JHN 13:37"/>Petro amudôsa, erhi: «Yâgirwa, cirhumire ntakakushimba buno? Nahâna obuzîne bwâni we rhumire!» <verse eid="JHN 13:37"/><verse number="38" style="v" sid="JHN 13:38"/>Yezu amushuza, erhi: «Wahâna obuzîne bwâwe nie ntumire? Okuli, okuli, nkubwîre, oluhazi lurhâbikè orhaj’indahira kasharhu<note caller="+" style="f"><char style="fr" closed="false">13, 36-38 </char><char style="ft" closed="false">Ebyo binwa biyêrekîre amababale ga Petro Mutagatîfu (<char style="xt"><ref loc="JHN 21:18-20">21, 18-20</ref></char>).</char></note>».<verse eid="JHN 13:38"/></para>
  <chapter eid="JHN 13"/>
  <chapter number="14" style="c" sid="JHN 14"/>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1"/>«Omurhima gwinyu gurhakangukaga! Muyêmîre Nnâmahanga, mu­nyêmêre nâni. <verse eid="JHN 14:1"/><verse number="2" style="v" sid="JHN 14:2"/>Omu mwa Larha mubà ntebe nyinji. Acibâga arhàli ntyo, nali nammubwîra; nâj’immurheganyiza entebe. <verse eid="JHN 14:2"/><verse number="3" style="v" sid="JHN 14:3"/>Na hano mbà najir’i­mmurheganyiza entebe, naciyish’immuyanka, mmuhêke aha ndi, lyo ninyu mubêra aha ndi. <verse eid="JHN 14:3"/><verse number="4" style="v" sid="JHN 14:4"/>N’enjira y’emunda nâja muyimanyire». <verse eid="JHN 14:4"/><verse number="5" style="v" sid="JHN 14:5"/>Toma amubwîra, erhi: «Yâgirwa, rhurhamanyiri ngahi wâjà. Kurhi rhwankacimanyaga enjira?» <verse eid="JHN 14:5"/><verse number="6" style="v" sid="JHN 14:6"/>Yezu amushuza, erhi: «Nie Njira, nie n’Okuli, nie na Buzîne. “Ntâye wankajà emwa Larha arhanangeziriho”. <verse eid="JHN 14:6"/><verse number="7" style="v" sid="JHN 14:7"/>“Mukammanya, mwanamanya na Larha”. “Ku­ rhenga buno mukola mumumanyire mwanamubwîne”». <verse eid="JHN 14:7"/><verse number="8" style="v" sid="JHN 14:8"/>Filipo amubwîra, erhi: «Yâgirwa, orhuyereke Sho, rhurhimûkwe». <verse eid="JHN 14:8"/><verse number="9" style="v" sid="JHN 14:9"/>Yezu amushuza, erhi: «Filipo, aga mango goshi ndi ninyu orhanasag’immanya? “Ombwîne erhi abwîne na Larha”. “Kurhi wankaciderhaga, erhi”: “Rhuyêreke Sho?”» <verse eid="JHN 14:9"/><verse number="10" style="v" sid="JHN 14:10"/>K’orhayêmîri oku ndi muli Larha, n’oku Larha andimwo? Ebinwa ndwîrhe nammubwîra, ntabiderha oku buhashe bwâni: ci Larha ombâmwo ye dwîrhe akola ebyo byoshi. <verse eid="JHN 14:10"/><verse number="11" style="v" sid="JHN 14:11"/>Nyêmêri! Ndi muli Larha na Larha andimwo. Akabà murhayêmîri, muyêmêre ebijiro byâni birhumire.<verse eid="JHN 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 14:12"/>Okuli, okuli, mmubwîre, onyêmîre, naye ayajire ebijiro ndwîrhe najira. Anayajire ciru ebilushire, bulya najà emwa Larha. <verse eid="JHN 14:12"/><verse number="13" style="v" sid="JHN 14:13"/>Na ngasi kantu mwâhûne Larha oku izîno lyâni, nâmmujirireko, lyo Larha akuzibwa n’Omugala. <verse eid="JHN 14:13"/><verse number="14" style="v" sid="JHN 14:14"/>Eci mwâhûne oku izîno lyâni, nâmmujirireco. <verse eid="JHN 14:14"/><verse number="15" style="v" sid="JHN 14:15"/>Akabà munzigira, mushimbe amarhegeko gâni.<verse eid="JHN 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 14:16"/>Nâni nayîsh’ishenga Larha ammuhè owundi murhulirizi wabêra ninyu ensiku zoshi. <verse eid="JHN 14:16"/><verse number="17" style="v" sid="JHN 14:17"/>Ye Mûka gw’okuli, n’igulu lirhankahash’imuyankirira, bulya lirhamubona lirhanamuyishi. Mwêhe mumuyishi, bulya ali haguma ninyu anammulimwo. <verse eid="JHN 14:17"/><verse number="18" style="v" sid="JHN 14:18"/>Ntâmmuleke bufûzi.</para>
  <para style="p" vid="JHN 14:18">Nâcigaluka emunda muli. <verse eid="JHN 14:18"/><verse number="19" style="v" sid="JHN 14:19"/>Kandi kasanzi kasungunu igulu lirhacimbone. Ci mwêhe mwâmbona, bulya nzîne ninyu mwâbà n’obuzîne. <verse eid="JHN 14:19"/><verse number="20" style="v" sid="JHN 14:20"/>Olwo lusiku<note caller="+" style="f"><char style="fr" closed="false">14, 20 </char><char style="ft" closed="false">Olwo lusiku: amango gakulikira okufûka kwa Yezu.</char></note> mwâmanye oku ndi muli Larha, n’oku ninyu muli muli nie, n’oku nâni ndi muli mwe.<verse eid="JHN 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 14:21"/>«Omanyire amarhegeko gâni akanagashimba, oyo ye onzigira, na ngasi onzigira, ayish’izigirwa na Larha, nâni namuzigira nanciyêrekeye». <verse eid="JHN 14:21"/><verse number="22" style="v" sid="JHN 14:22"/>Yûda arhali olya w’e Keriyoti, amudôsa, erhi: «Yâgirwa, kurhi wankacîyêrekana kuli rhwe okaleka kucîyêreka igulu?» <verse eid="JHN 14:22"/><verse number="23" style="v" sid="JHN 14:23"/>Yezu amushuza, erhi: «Omuntu onzigîre, anabikirire akanwa kâni, naye Larha anamuzigira, rhwanajà omu mwâge, rhunagwîkemwo entebe yîrhu. <verse eid="JHN 14:23"/><verse number="24" style="v" sid="JHN 14:24"/>“Orhanzigira arhabîkirira ebinwa byâni”. “N’e­byo binwa mwayumvîrhe birhali byâni, ci biri bya Larha wantumaga”».<verse eid="JHN 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25"/>«Mmubwîzire ebyo byoshi nciri ekarhî kinyu. <verse eid="JHN 14:25"/><verse number="26" style="v" sid="JHN 14:26"/>“Ci Omurhulirizi, Mûka Mutagatîfu, Larha ârhuma oku izîno lyâni, ye wayish’immuyigîriza byoshi anammukengêze ebinammubwîzire byoshi. <verse eid="JHN 14:26"/><verse number="27" style="v" sid="JHN 14:27"/>“Mmusigîre omurhûla, mmuhîre omurhûla gwâni”. “Ci ntammuhîrigwo kulyâla igulu liguhâna”. “Muhire omurhima omu nda, murhanayôbohaga”. <verse eid="JHN 14:27"/><verse number="28" style="v" sid="JHN 14:28"/>“Mwayumvîrhe oku nammubwîrize, nti”: “Nkola, ci nâgaluka emunda muli.” Mucibâga munzigira, rhinga mudwîrhe mwacîshinga, kulya kubà nâja emwa Larha, bulya Larha ye mukulu kundusha”. <verse eid="JHN 14:28"/><verse number="29" style="v" sid="JHN 14:29"/>“Ntyo nammubwîzire e­byo embere bibè, nti irhondo byamâbà lyo muyêmêra”».<verse eid="JHN 14:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 14:30"/>«Ntacimmubwîra binji, bulya Omurhwâli w’er’igulu<note caller="+" style="f"><char style="fr" closed="false">14, 30 </char><char style="ft" closed="false">Omurhwâli w’eri igulu, ye shetani odwîrhe akolêsa Yûda n’Abayahudi.</char></note> ayiruka. “Ci ntà buhashe agwêrhe kuli nie”. <verse eid="JHN 14:30"/><verse number="31" style="v" sid="JHN 14:31"/>“Ci ku­ kwânîne igulu limanye oku nzigira Larha n’oku ebi Larha antegesire byo njira. Yimuki! rhurhenge hano!”»<verse eid="JHN 14:31"/></para>
  <chapter eid="JHN 14"/>
  <chapter number="15" style="c" sid="JHN 15"/>
  <para style="s1">Yezu ye cigundu c’omuzâbîbu</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1"/>«Nie cigundu c’omuzâbîbu c’okunali, na larha ye muhinzi. <verse eid="JHN 15:1"/><verse number="2" style="v" sid="JHN 15:2"/>“Ngasi ishami lindikwo lirhayâna malehe analihagule, na ngasi ishami liyâna amalehe analishogolere mpu lyo liyâna kulusha”. <verse eid="JHN 15:2"/><verse number="3" style="v" sid="JHN 15:3"/>“Okuca, mîra mwacâga, eci­nwa nammubwîzire cirhumire”. <verse eid="JHN 15:3"/><verse number="4" style="v" sid="JHN 15:4"/>“Mumbêremwo, nâni nâmmubêramwo. Kulya ishami lirhankayâna lyône lirhanasêziri oku cigundu, kwo n’okwo ninyu akabà murhansêzirikwo”. <verse eid="JHN 15:4"/><verse number="5" style="v" sid="JHN 15:5"/>“Nie cigundu, ninyu mwe mashami. Obêra muli nie nâni muli ye, oyo ye yâna malehe manji; bulya buzira nie, ntâco mwankahash’ijira”. <verse eid="JHN 15:5"/><verse number="6" style="v" sid="JHN 15:6"/>“Orhambêzirimwo, anakabulirwa embuga nk’ishami, ayûme; n’amashami mûmu banagarhôle, bagajugunje omu cibêye, gasingônoke”. <verse eid="JHN 15:6"/><verse number="7" style="v" sid="JHN 15:7"/>“Mukambêramwo n’ebinwa byâni bikasêra omu mirhima yinyu, muhûne ngasi coshi mulonzize, mwâcibona”. <verse eid="JHN 15:7"/><verse number="8" style="v" sid="JHN 15:8"/>“Liri irenge lya Larha mukayâna malehe manji, na ntyo kwo mwâbà baganda bâni”. <verse eid="JHN 15:8"/><verse number="9" style="v" sid="JHN 15:9"/>“Oku Larha anzigira, kwo nâni mmuzigira. Mubêre omu buzigire bwâni”. <verse eid="JHN 15:9"/><verse number="10" style="v" sid="JHN 15:10"/>“Mukashimba amarhegeko gâni, mwâbêra omu buzigire bwâni, nk’oku nâni nashimbire amarhegeko ga Larha, nambêra omu buzigire bwâge”. <verse eid="JHN 15:10"/><verse number="11" style="v" sid="JHN 15:11"/>“Mmubwîzire ebyo byoshi, nti lyo obushagaluke bwâni bummubâmwo, lyo n’obushagaluke bwinyu bubà bwimâna”. <verse eid="JHN 15:11"/><verse number="12" style="v" sid="JHN 15:12"/>“Irhegeko lyâni ly’eri”: “muzigirane nk’oku nammuzigire”. <verse eid="JHN 15:12"/><verse number="13" style="v" sid="JHN 15:13"/>“Ntâye wankajira obuzigire bulushire okuhâna obuzîne abîra bâge barhumire”. <verse eid="JHN 15:13"/><verse number="14" style="v" sid="JHN 15:14"/>“Muli bîra bâni mukajira ebi mmurhegesire”. <verse eid="JHN 15:14"/><verse number="15" style="v" sid="JHN 15:15"/>“Ntakacimmuderha bambali bâni, bulya omushizi arhishi eci nnawâbo ajira; mmudesire bîra, bulya ngasi byoshi Larha amanyîsize, nammuyigîrizebyo”. <verse eid="JHN 15:15"/><verse number="16" style="v" sid="JHN 15:16"/>“Arhali mwe mwacînyishogaga, ci nie nacîmmwishogaga, nammuyimanza nti mugende, muyâne amalehe, n’amalehe ginyu gabêreho, lyo Larha ammushobôza ngasi kantu mwâmusengere oku izîno lyâni”. <verse eid="JHN 15:16"/><verse number="17" style="v" sid="JHN 15:17"/>“Mmurhegesire nti muzigirane mwene na nnene”».<verse eid="JHN 15:17"/></para>
  <para style="s1">Igulu lishomba Yezu n’abaganda bâge</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18"/>«Igulu likammushomba, mukengêre oku nie lyarhangag’ishomba. <verse eid="JHN 15:18"/><verse number="19" style="v" sid="JHN 15:19"/>“Mu­cibâga b’igulu, igulu lyankasîmire ecalyo; ci kulya kubà murhali b’igulu, bulya erhi ncimmwîshoga nammuyegûla n’igulu, igulu likola limmushomba”. <verse eid="JHN 15:19"/><verse number="20" style="v" sid="JHN 15:20"/>“Kengêri akanwa nammubwîraga: Omushizi arhankalusha nnawâbo. Erhi banti­ndibuza, ninyu bâmmurhindibuze; akabà bayumvirhîze akanwa kâni, n’akinyu bâkayumvirhize”. <verse eid="JHN 15:20"/><verse number="21" style="v" sid="JHN 15:21"/>“Ci ebyo byoshi bammujirirebyo izîno lyâni lirhuma, bulya barhishi owantumaga.” <verse eid="JHN 15:21"/><verse number="22" style="v" sid="JHN 15:22"/>“Ncibulaga buyisha na ncibâga ntabayigîrizagya, rhinga ntà câha bagwêrhe; ci lêro buno ntà bulyo bacigwêrhe oku câha câbo”. <verse eid="JHN 15:22"/><verse number="23" style="v" sid="JHN 15:23"/>“O­nshomba erhi ashomba Larha”. <verse eid="JHN 15:23"/><verse number="24" style="v" sid="JHN 15:24"/>“Ntàcijiraga ekarhî kâbo ebijiro birhasâg’ijirwa na wundi muntu, barhankabîre na câha; ci buno bàbwîne, bagal’irhushomba rhwe na Larha”. <verse eid="JHN 15:24"/><verse number="25" style="v" sid="JHN 15:25"/>“Ci okwo kwoshi mpu lyo ecinwa ciyandisirwe omu Marhegeko gâbo ciyunjula: Banshombire buzira igwârhiro<note caller="+" style="f"><char style="fr" closed="false">15, 25 </char><char style="ft" closed="false">Banshombire buzira igwârhiro: <char style="xt" link-href="PSA 34:19"><ref loc="PSA 34:35--1">Lul 34(35), 19</ref></char>; <char style="xt" link-href="PSA 68:5"><ref loc="PSA 68:69--1">68(69), 5</ref></char>.</char></note>.” <verse eid="JHN 15:25"/><verse number="26" style="v" sid="JHN 15:26"/>“Mango Omu­rhûlirizi nâmmurhumira kurhenga emwa Larha ayisha, ye Mûka gw’okunali, ohubuka kuli Larha, ayish’impamîriza”. <verse eid="JHN 15:26"/><verse number="27" style="v" sid="JHN 15:27"/>“Ninyu mwayish’impamîriza, kulya kubà mubà nâni kurhenga omurhondêro”».<verse eid="JHN 15:27"/></para>
  <chapter eid="JHN 15"/>
  <chapter number="16" style="c" sid="JHN 16"/>
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1"/>Mmubwîzire ebyo nti lyo mulek’isârhala. <verse eid="JHN 16:1"/><verse number="2" style="v" sid="JHN 16:2"/>Baciyish’immuhulusa omu masinagogi, ciru amango gayiruka, ngasi owâmmuyîrhe amanye mpu kuli kukolera Nnâmahanga. <verse eid="JHN 16:2"/><verse number="3" style="v" sid="JHN 16:3"/>Bâmmujirire okwo kwoshi bulya barharhuma­nyaga rhwe na Larha. <verse eid="JHN 16:3"/><verse number="4" style="v" sid="JHN 16:4"/>Ci mmubwîzire ebyo, nti lyo hano amango gâbyo gayisha, mukengêra oku nali erhi nammubwîzire. Ntammubwîragabyo kurhenga omurhondêro, bulya naciri ekarhî kinyu.<verse eid="JHN 16:4"/></para>
  <para style="s1">Okuyisha kw’Omurhûlirizi</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 16:5"/>«Lêro buno nkola nâja emwa owantumaga, na ntâye muli mwe wandôsa, mpu: “Ngahi wâjà?” <verse eid="JHN 16:5"/><verse number="6" style="v" sid="JHN 16:6"/>“Ci bulya nammubwîzire okwo, oburhè buyunjwîre emirhima yinyu”. <verse eid="JHN 16:6"/><verse number="7" style="v" sid="JHN 16:7"/>“N’obwo ndesire okunali”: “kummukwânîne ngende; bulya nkaba ntagenziri, Omurhûlirizi arhammuyishire; ci nkagenda, nâmmurhumiraye”. <verse eid="JHN 16:7"/><verse number="8" style="v" sid="JHN 16:8"/>“N’irhondo ayisha, ayagîriza igulu oku câha, oku bushinganyanya n’oku lubà­njà”. <verse eid="JHN 16:8"/><verse number="9" style="v" sid="JHN 16:9"/>“Oku câha, bulya barhanyêmîri”. <verse eid="JHN 16:9"/><verse number="10" style="v" sid="JHN 16:10"/>“Oku bushinganyanya, bulya nkola nâja emwa Larha<note caller="+" style="f"><char style="fr" closed="false">16, 10 </char><char style="ft" closed="false">Mûka Mutagatîfu ayish’iyêrekana oku kwo binali Yezu ali Mwene-Nyamuzinda. Okurheremera kwa Yezu omu mpingu ekulyo kw’Îshe ciri cimanyîso c’okuyêrekana oku muli Nyamuzinda anarhengaga.</char></note>, murhakanacimbona”. <verse eid="JHN 16:10"/><verse number="11" style="v" sid="JHN 16:11"/>“Oku lubanja, bulya omurhambo w’er’igulu atwirîrwe olubanja. <verse eid="JHN 16:11"/><verse number="12" style="v" sid="JHN 16:12"/>“Ncigwêrhe binji by’okummubwîra, ci murhankashub’ibihasha”. <verse eid="JHN 16:12"/><verse number="13" style="v" sid="JHN 16:13"/>“Irhondo olya Mûka w’okuli ayisha, ammuyigîriza okuli kwoshi; bulya arhali byâge anaderhe, ci ayish’iderha ngasi ebi ayumvîrhe byoshi, n’ebyaciyîsha, ayish’immubwîrabyo”. <verse eid="JHN 16:13"/><verse number="14" style="v" sid="JHN 16:14"/>“Ayish’inkuza, bulya oku byâni ayish’ihuma, ammubwîre”. <verse eid="JHN 16:14"/><verse number="15" style="v" sid="JHN 16:15"/>“Ebya Larha byoshi biri byâni”. Co cirhumire nderha nti”: “Oku byâni ayish’ihumakwo<note caller="+" style="f"><char style="fr" closed="false">16, 15 </char><char style="ft" closed="false">Mûka Mutagatîfu ayish’imanyîsa, ayish’ihamîriza Yezu n’enyigîrizo zâge; ayish’imanyîsa oku Nyamuzinda Îshe n’Omugala bali muguma.</char></note>, ammubwîre”».<verse eid="JHN 16:15"/></para>
  <para style="s1">Yezu abwîra abaganda bâge oku agaluka duba</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16"/>«Hindi hitya murhâcimbone, na hindi hitya mwâshub’imbona<note caller="+" style="f"><char style="fr" closed="false">16, 16 </char><char style="ft" closed="false">Aho Yezu abwîzire abaganda bâge oku âfà anafûke.</char></note>». <verse eid="JHN 16:16"/><verse number="17" style="v" sid="JHN 16:17"/>Obwo baguma omu baganda bâge babwizanya, mpu: «Kwo kurhi okwo adwîrhe arhubwîra, mpu: “Hindi hitya murhâcimbone, na hindi hitya mwâshub’imbona”, na mpu: “Najà emwa Larha?”» <verse eid="JHN 16:17"/><verse number="18" style="v" sid="JHN 16:18"/>Okubundi bakaziderha, mpu «Ehyo hitya kwo kuderha kurhi? Rhurhamanyiri ebi alonza okuderha». <verse eid="JHN 16:18"/><verse number="19" style="v" sid="JHN 16:19"/>Yezu amanya oku balonza okumudôsa. Anacibabwîra, erhi: «Mudwîrhe mwadôsanya ebi nalonzagya okummubwîra ene nderha, nti: “Hindi bitya murhâcimbone, na hindi hitya mwâshub’imbona”». <verse eid="JHN 16:19"/><verse number="20" style="v" sid="JHN 16:20"/>«Okuli, okuli, mmubwîre, mwayish’ilaka munalakûle; igulu lyôhe lyayish’icîshinga; mwêhe mwayish’ibona oburhè, ci oburhè bwinyu bwayish’ihinduka mwishingo<note caller="+" style="f"><char style="fr" closed="false">16, 20 </char><char style="ft" closed="false">Bayish’ibona oburhè amango g’amalumwa n’okufà kwa Yezu; ci olusiku âfûka bayumva omwîshingo.</char></note>. <verse eid="JHN 16:20"/><verse number="21" style="v" sid="JHN 16:21"/>“Omukazi, nk’ali hôfi h’okuburha, oburhè bunamugwârhe, bulya amango gâge gahisire; ci kwônene nk’amâyûs’iburha omwâna, arhacikengêra galya malibuko gâge, erhi kucîshinga kurhuma, bulya omuntu abusirwe en’igulu”. <verse eid="JHN 16:21"/><verse number="22" style="v" sid="JHN 16:22"/>“Ninyu kwo n’okwo”. “Buno muli burhè; ci nâcimubone n’omurhima gwinyu gwâshagaluke, n’obusîme bwinyu ntâye wâcimmukûle kuli bwo”. <verse eid="JHN 16:22"/><verse number="23" style="v" sid="JHN 16:23"/>“Olwo lusiku ntâco mwâcindôse”. “Okuli, okuli, mmubwîre, eci mwâhûne Larha, ammushobôzaco oku izîno lyâni”. <verse eid="JHN 16:23"/><verse number="24" style="v" sid="JHN 16:24"/>“Kuhika buno, ntâco musig’ihûna oku izîno lyâni. Hûni, mwâhâbwa, n’obusîme bwinyu bwâbà bwimâna”. <verse eid="JHN 16:24"/><verse number="25" style="v" sid="JHN 16:25"/>“Ebyo byoshi nammubwîzirebyo omu migani”. “Amango gayiruka, ntakacimmubwîra omu migani; nâmmushambalira ebya Larha n’obwâlagale”<note caller="+" style="f"><char style="fr" closed="false">16, 25 </char><char style="ft" closed="false">Entumwa zâyumve enyigîrizo za Mwâmi Yezu n’obwâlagale amango âfûka anabarhumira Mûka Mutagatîfu.</char></note>. <verse eid="JHN 16:25"/><verse number="26" style="v" sid="JHN 16:26"/>“Agôla mango, mwâhûne oku izîno lyâni. Ntadesiri nti nayîsh’immusengerera emwa Larha”, <verse eid="JHN 16:26"/><verse number="27" style="v" sid="JHN 16:27"/>“kulya kubà Larha yêne ammuzigira, bulya munzigira munayêmîre oku nahubukaga muli Nyamuzinda”. <verse eid="JHN 16:27"/><verse number="28" style="v" sid="JHN 16:28"/>“Nahubukaga muli Larha, najà en’igulu”. “Buno nkola nârhenga en’igulu, njè emwa Larha”». <verse eid="JHN 16:28"/><verse number="29" style="v" sid="JHN 16:29"/>Abaganda bâge bamubwîra, mpu: «Lêro oshambîre n’obwâlagale, orhanadwîrhi waderhera omu migani! <verse eid="JHN 16:29"/><verse number="30" style="v" sid="JHN 16:30"/>Lêro rhwamâbona oku oyishi byoshi, na ntâye ocilagirîre oku­kudôsa. Lêro rhwamâyêmêra oku wahubukaga muli Nyamuzinda». <verse eid="JHN 16:30"/><verse number="31" style="v" sid="JHN 16:31"/>Yezu abashuza, erhi: «Ka lêro mwamâyêmêra? <verse eid="JHN 16:31"/><verse number="32" style="v" sid="JHN 16:32"/>Amango gayiruka, ciru ganakola gahisire, mwâshandabana ngasi muguma lwâge, munansige niene. Ci ntali niene, nanga, bulya Larha ali nâni. <verse eid="JHN 16:32"/><verse number="33" style="v" sid="JHN 16:33"/>Nammubwîzire ebyo nti lyo mubona omurhûla muli nie. Mwâbone amalumwa omu igulu. Ci muzibuhe! Nahimire igulu».<verse eid="JHN 16:33"/></para>
  <chapter eid="JHN 16"/>
  <chapter number="17" style="c" sid="JHN 17"/>
  <para style="s1">Isâla liyêrekîne obudâhwa bwa Yezu</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1"/>Erhi ayûs’iderha ebyo binwa, Yezu ayînamula amasù, agalamira e­nyanya, aderha, erhi:</para>
  <para style="q1" vid="JHN 17:1">«Larha, amango gahisire: kuza Mugala wâwe, lyo Mugala wâwe akukuza,<verse eid="JHN 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JHN 17:2"/>na bulya wamuhîre obuhashe kuli ngasi ciremwa, lyo ashobôza abà wamuhîre boshi akalamo k’ensiku n’amango.<verse eid="JHN 17:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JHN 17:3"/>Akalamo k’ensiku n’amango kuli kukumanya, w’oyo Nyamuzinda w’okuli wênene, n’oyu warhumaga, Yezu Kristu.<verse eid="JHN 17:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JHN 17:4"/>Nakukuzize en’igulu; nayukirîze omukolo wampâga mpu njire.<verse eid="JHN 17:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JHN 17:5"/>Larha, nâwe onkuzagye buno, onampè lirya irenge nayôrhaga njira e­mwâwe embere igulu liremwe.<verse eid="JHN 17:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JHN 17:6"/>Abantu warhenzagya igulu obampà, nabamanyisize izîno lyâwe. Bâli bâwe, wabampa, banashimba akanwa kâwe.<verse eid="JHN 17:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JHN 17:7"/>Buno bakolaga bamanyire oku ebi wampîre byoshi emwâwe birhenga;<verse eid="JHN 17:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JHN 17:8"/>bulya ebinwa wampâga, nabahîrebyo, banayêmêra okuli oku muli we nahubukaga, banayêmêra oku we wantumaga.<verse eid="JHN 17:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JHN 17:9"/>Bo nsengerîre; ntasengerîri igulu<note caller="+" style="f"><char style="fr" closed="false">17, 9 </char><char style="ft" closed="false">«ntasengerîri igulu»: Igulu, bo balya balahira Obulangashane n’Obuzîne Mwâmi Yezu adwîrhîre abantu. ecinwa «kosmos» omu cigereki, lyo igulu Yowane acikolêsa kubiri. ahandi igulu, kuli kuderha abalemirwe boshi n’aha bayûbaka (<char style="xt"><ref loc="JHN 1:9">Ywn 1, 9</ref>; <ref loc="JHN 3:16">3, 16</ref>; <ref loc="JHN 17:13">17, 13</ref></char>), kandi erhi abalahire Yezu. Kandi igulu kuli kuderha aha Yezu arhumagwa naye arhumaho Entumwa mpu zimanyise Emyanzi y’Akalembe (<char style="xt"><ref loc="JHN 17:18">Ywn 17, 18</ref>.<ref loc="JHN 17:21">21</ref></char>).</char></note>, ci balya wampâga bo nsengerîre, bulya bali bâwe.<verse eid="JHN 17:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JHN 17:10"/>Ebyâni byoshi biri byâwe, n’ebyâwe byoshi biri byâni, na muli bo najîre irenge.<verse eid="JHN 17:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JHN 17:11"/>Ntaciri en’igulu, ci bôhe en’igulu baciri. Nie ono nyishire emwâwe. Larha Mutagatîfu, olange omu izîno lyâwe abà wampâga, lyo babà muguma akîrhu.<verse eid="JHN 17:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JHN 17:12"/>Erhi nciri nabo, nakâg’ibalanga oku izîno lyâwe abà wampâga. Nabalanzire, na ntà muguma wahezire muli bo, aha nyuma ly’o­mwâna w’omuhera, mpu lyo okwayandisirwe kuyunjula.<verse eid="JHN 17:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JHN 17:13"/>Buno lêro nyishire emunda oli; n’ebyo mbidesire buno nciri en’igulu, nti lyo bayumva obusîme bwâni banabuyunjule.<verse eid="JHN 17:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JHN 17:14"/>Nabahîre akanwa kâwe, igulu lyabashomba, bulya barhali b’igulu, nk’oku nâni ntali w’igulu.<verse eid="JHN 17:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 17:15"/>Ntakuhûnyiri nti obarhenze omu igulu, ci nti obalange oku Mubî<note caller="+" style="f"><char style="fr" closed="false">17, 15 </char><char style="ft" closed="false">Oku Mubî erhi omu kubî</char></note>.<verse eid="JHN 17:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JHN 17:16"/>Barhali b’igulu, nk’oku nâni ntali w’igulu.<verse eid="JHN 17:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JHN 17:17"/>Obajire batagatîfu omu okuli: akanwa kâwe kwo okuli.<verse eid="JHN 17:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JHN 17:18"/>Kulya wantumaga igulu, kwo nâni mbarhumire igulu.<verse eid="JHN 17:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JHN 17:19"/>Ncihânyire nterekêro bo barhumire, lyo nabo bahinduka nterekêro omu okuli.<verse eid="JHN 17:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JHN 17:20"/>Arhali bônene nsengerîre, ci na balya banyêmêre erhi kanwa kâbo ka­rhuma.<verse eid="JHN 17:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JHN 17:21"/>Boshi babè muguma. Nk’oku we, Larha, oli muli nie nâni nkulimwo, nabo babè muguma muli rhwe, lyo igulu liyêmêra oku we wa­ntumaga.<verse eid="JHN 17:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JHN 17:22"/>Nabahîre irenge wampâga, nti lyo babà muguma, nka kulya nîrhu rhuli muguma:<verse eid="JHN 17:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JHN 17:23"/>nie muli bo, nâwe muli nie, lyo babà muguma lwoshi, lyo n’igulu limanya oku we wantumaga n’oku nabazigire nka kulya wanzigîre.<verse eid="JHN 17:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JHN 17:24"/>Larha, nnonzize abà wampîre nabo babè nâni aha ndi, lyo babona irenge wampîre, bulya wanzigîre embere z’okulemwa kw’igulu.<verse eid="JHN 17:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JHN 17:25"/>Larha mwimâna, igulu lirhakumanyaga, ci niehe nakumanyire, n’abâla bamanyire oku we wantumaga.<verse eid="JHN 17:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JHN 17:26"/>Nabamanyîsize izîno lyâwe, nanacibamanyîsalyo, lyo obuzigire wa­nzigîre bubà muli bo, lyo nâni mbà muli bo».<verse eid="JHN 17:26"/></para>
  <chapter eid="JHN 17"/>
  <chapter number="18" style="c" sid="JHN 18"/>
  <para style="s1">Yezu agwârhwa</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mat 26, 47-56</ref>; <ref loc="MRK 14:43-52">Mrk 14, 43-52</ref>; <ref loc="LUK 22:47-53">Luk 22, 47-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1"/>Erhi Yezu ayûs’iderha ntyo, anacihuluka bo n’abaganda bâge, bayikira omugezi gw’e Cedroni<note caller="+" style="f"><char style="fr" closed="false">18, 1 </char><char style="ft" closed="false">Cedroni erhi Kedroni, lwo lubanda lugaba Yeruzalemu n’entondo y’Emizêti.</char></note>. Hali ishwa, alijamwo bo n’abaganda bâge. <verse eid="JHN 18:1"/><verse number="2" style="v" sid="JHN 18:2"/>Yûda w’omulenzi ali ahayishi, bulya kanji kanji Yezu akâg’ishimânanaho n’abaganda bâge. <verse eid="JHN 18:2"/><verse number="3" style="v" sid="JHN 18:3"/>Yûda anaciyisha adwîrhe engabo y’abasirika n’abaganda barhumirwe n’abakulu b’abadâhwa n’Abafarizeyi. Bali bafumbasire amatara n’orhumole n’amatumu. <verse eid="JHN 18:3"/><verse number="4" style="v" sid="JHN 18:4"/>Okuhandi, bulya Yezu ali amanyire okwâbà kwoshi, abajayo, ababwîra, erhi: «Ndi mwalonza?» <verse eid="JHN 18:4"/><verse number="5" style="v" sid="JHN 18:5"/>Bamushuza, mpu: «Yezu w’e Nazareti». Naye, erhi: «Nie ono». Yûda wamulenganyagya erhi ali nabo. <verse eid="JHN 18:5"/><verse number="6" style="v" sid="JHN 18:6"/>E­erhi Yezu ayûs’ibabwîra, erhi: «Nie ono», bacîtunda, bahirima lugali. <verse eid="JHN 18:6"/><verse number="7" style="v" sid="JHN 18:7"/>Ashub’ibadôsa, erhi: «Ndi mwalonza?» Nabo bashuza, mpu: «Yezu w’e Nazareti». <verse eid="JHN 18:7"/><verse number="8" style="v" sid="JHN 18:8"/>Naye Yezu, erhi: «Ka ntammubwîzire oku nie ono! Akabà nie mwalonza lekagi abâla bacîgendere». <verse eid="JHN 18:8"/><verse number="9" style="v" sid="JHN 18:9"/>Ebyo byoshi mpu lyo cirya cinwa aderhaga ciyunjula, erhi: «Muli abà wampâga, ntahezagya ciru n’omuguma». <verse eid="JHN 18:9"/><verse number="10" style="v" sid="JHN 18:10"/>Obwo erhi Simoni Petro adwîrhe engôrho. Anaciyiyômola, ayirhimba mwambali w’omudâhwa mukulu, amushishimbula okurhwiri kulyo. Oyo mushi izîno lyâge ye wali Maliko. <verse eid="JHN 18:10"/><verse number="11" style="v" sid="JHN 18:11"/>Yezu anacibwîra Petro, erhi: «Shubiza engôrho yâwe omu lûba. Akabehe Larha anteganyîze, ka ntakanywe<note caller="+" style="f"><char style="fr" closed="false">18, 11 </char><char style="ft" closed="false">Akabehe, go malumwa.</char></note>?»<verse eid="JHN 18:11"/></para>
  <para style="s1">Yezu embere za Hana na Kayifa. Petro ahakana Nnawâbo</para>
  <para style="r">(<ref loc="MAT 26:57-75">Mat 26, 57-75</ref>; <ref loc="MRK 14:53-72">Mrk 14, 53-72</ref>; <ref loc="LUK 22:54-71">Luk 22, 54-71</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12"/>Okubundi, erya ngabo n’omukulu w’abasirika n’abaganda b’Abayahudi bahamirakwo Yezu, bamushwêka. <verse eid="JHN 18:12"/><verse number="13" style="v" sid="JHN 18:13"/>Barhang’imuhêka emwa Hana, bulya àli ishazâla wa Kayifa wali mudâhwa mukulu ogwo mwâka. <verse eid="JHN 18:13"/><verse number="14" style="v" sid="JHN 18:14"/>Kayifa y’olya wahâga Abayahudi eri ihano, erhi: «Kukwânîne muntu muguma afîre olubaga». <verse eid="JHN 18:14"/><verse number="15" style="v" sid="JHN 18:15"/>Ci Simoni Petro bo n’owundi muganda<note caller="+" style="f"><char style="fr" closed="false">18, 15 </char><char style="ft" closed="false">Oyo wundi muganda, ye Yowane wayandikaga eci citabu ca kani c’Emyanzi y’Akalembe.</char></note> bâli bakulikîre Yezu. Oyo wundi muganda àli amanyîbwe n’omudâhwa mukulu. Anacishimba Yezu omu côgo c’omudâhwa mukulu. <verse eid="JHN 18:15"/><verse number="16" style="v" sid="JHN 18:16"/>Petro yêhe abêra abà lumvi embuga. Olya wundi muganda wali omanyikîne n’omudâhwa mukulu anacihuluka; abwîra omujaka­zi wakâg’ilanga omuhango, ageza Petro. <verse eid="JHN 18:16"/><verse number="17" style="v" sid="JHN 18:17"/>Oyo mujàkazi wali aha lumvi adôsa Petro, erhi: «Ka nâwe orhali w’omu baganda b’oyu muntu?» Naye ashuza, erhi: «Nanga, ntali wa muli bo». <verse eid="JHN 18:17"/><verse number="18" style="v" sid="JHN 18:18"/>Abashizi n’abaganda erhi batwanyire omuliro erhi mboho erhuma, bakakalûka. Naye Petro abalimwo anakag’ikalûka. <verse eid="JHN 18:18"/><verse number="19" style="v" sid="JHN 18:19"/>Omudâhwa mukulu anacidôsa Yezu ogw’abaganda bâge n’enyigîrizo zâge. <verse eid="JHN 18:19"/><verse number="20" style="v" sid="JHN 18:20"/>Yezu amushuza, erhi: «Nayigîrizize igulu n’obwâlagale; ensiku zoshi nahanwîre omu sinagogi n’omu ka-Nyamuzinda, mwo Abayahudi barhigânana, na ntâco nadesire bufundafunda. <verse eid="JHN 18:20"/><verse number="21" style="v" sid="JHN 18:21"/>Cirhumire wandôsa? Dôsa abayumvîrhe ebi nabayigîrizize; bamanyire ebi nadesire». <verse eid="JHN 18:21"/><verse number="22" style="v" sid="JHN 18:22"/>Erhi ayûs’iderha ntyo, muguma w’omu baganda bâli aho arhimba Yezu oluhî, anamubwîra, erhi: «Ka kwo bashuza omudâhwa mukulu ntyo?» <verse eid="JHN 18:22"/><verse number="23" style="v" sid="JHN 18:23"/>Yezu amushuza, erhi: «Akabà nadesire kubî, nyêreka aha nahabîre; ci akabà kwinjà nadesire, bici ocinshûrhirage?» <verse eid="JHN 18:23"/><verse number="24" style="v" sid="JHN 18:24"/>Okubundi, Hana amurhuma emwa omudâhwa mukulu Kayifa erhi anaciri mubohe. <verse eid="JHN 18:24"/><verse number="25" style="v" sid="JHN 18:25"/>Simoni Petro naye erhi analigi aho, adwîrhe akalûka. Bamubwîra, mpu: «Nâwe we, k’orhali w’omu baganda bâge?» Ahakana, erhi: «Nanga, ntali wa muli bo». <verse eid="JHN 18:25"/><verse number="26" style="v" sid="JHN 18:26"/>Muguma w’omu bagaragu b’omudâhwa mukulu, mwene wâbo olya Petro ajingûlaga okurhwiri, amubwîra, erhi: «Ka ntakubwîne omu ishwa mwe naye?» <verse eid="JHN 18:26"/><verse number="27" style="v" sid="JHN 18:27"/>Petro ashub’ihaka­na. Ho n’aho oluhazi lwabika.<verse eid="JHN 18:27"/></para>
  <para style="s1">Yezu emwa Bilato</para>
  <para style="r">(<ref loc="MAT 27:1-2">Mat 27, 1-2</ref>.<ref loc="MAT 27:11-31">11-31</ref>; <ref loc="MRK 15:1-20">Mrk 15, 1-20</ref>; <ref loc="LUK 23:1-7">Luk 23, 1-7</ref>.<ref loc="LUK 23:13-25">13-25</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28"/>Banacîrhenza Yezu emwa Kayifa, bamujâna omu lugo lw’omurhegesi. Lyàli sêzi. Ci bôhe barhajâga omu lugo mpu balek’ihumâna<note caller="+" style="f"><char style="fr" closed="false">18, 28 </char><char style="ft" closed="false">Omu bworhrere bw’Abayahudi, okujà omu mw’omupagani gwàli muziro.</char></note>, mpu lyo banahash’ilya oku mwâna-buzi wa Basâka. <verse eid="JHN 18:28"/><verse number="29" style="v" sid="JHN 18:29"/>Bilato anacihuluka, abajayo, abadôsa, erhi: «Cici mushobesire oyu muntu?» <verse eid="JHN 18:29"/><verse number="30" style="v" sid="JHN 18:30"/>Bamushuza, mpu: «Acibâga arhàli muntu mubî, rhurhankakudwîrhîreye». <verse eid="JHN 18:30"/><verse number="31" style="v" sid="JHN 18:31"/>Bilato, erhi: «Yankiye mwêne, mumutwîre nk’oku Amarhegeko ginyu ganadesire». Nabo Abayahudi bamushuza, mpu: «Ntà buhashe<note caller="+" style="f"><char style="fr" closed="false">18, 31 </char><char style="ft" closed="false">Abaroma bâli banyazire Abayahudi obuhashe bw’okutwîra omuntu olufù. Aciyîrhagwa n’Abayahudi, mabuye Mwâmi Yezu àli abandwa; arhàli abambwa oku musalaba, bwo buhane bukali bw’Abaroma.</char></note> rhujira bw’okuyîrha omuntu». <verse eid="JHN 18:31"/><verse number="32" style="v" sid="JHN 18:32"/>Okwo kwoshi mpu lyo akanwa Yezu aderhaga kabà, bulya àli erhi adesire lufù luci ayish’ifà. <verse eid="JHN 18:32"/><verse number="33" style="v" sid="JHN 18:33"/>Okubundi Bilato anacishubira omu k’emmanja; ahamagala Yezu, amudôsa, erhi: «K’oli mwâmi w’Abayahudi?» <verse eid="JHN 18:33"/><verse number="34" style="v" sid="JHN 18:34"/>Yezu amushuza, erhi: «Ka wakumanya wêne erhi wakubwîrwa n’abandi?» <verse eid="JHN 18:34"/><verse number="35" style="v" sid="JHN 18:35"/>Bilato ashuza, erhi: «Ewe, ka nie ono ndigi Muyahudi? Bene winyu n’abajinji b’abadâhwa bakundwîrhîre. Bici wajizire?» <verse eid="JHN 18:35"/><verse number="36" style="v" sid="JHN 18:36"/>Yezu amushuza, erhi: «Obwâmi bwâni<note caller="+" style="f"><char style="fr" closed="false">18, 36 </char><char style="ft" closed="false">Mwâmi Yezu alonza okuderha oku obwâmi bwâge arhabuhâbagwa na bantu.</char></note> burhali bw’en’igulu. Obwâmi bwâni bucibâga bw’en’igulu, bambali bâni bâli banfungira, lyo ndek’ihânwa omu maboko g’Abayahudi. Ci obwâmi bwâni burhali bw’eno». <verse eid="JHN 18:36"/><verse number="37" style="v" sid="JHN 18:37"/>Naye Bilato, erhi: «Kuziga oli mwâmi?» Yezu amushuza, erhi: «Wakudesire! ndi mwâmi. Naburhagwa nanajà en’igulu nti mpamîrize okuli. Ngasi muntu osîma okuli, ayumvîrhiza izù lyâni». <verse eid="JHN 18:37"/><verse number="38" style="v" sid="JHN 18:38"/>Bilato amubwîra, erhi: «Okuli kwo kuci?» Oku ayûs’iderha ntyo, ahuluka, ajà emunda Abayahudi bâli. Anacibabwîra, erhi: «Ntà cibî mmubwînekwo. <verse eid="JHN 18:38"/><verse number="39" style="v" sid="JHN 18:39"/>Mwakômerîre okubona nammushwêkûlira muntu muguma oku Basâka. Ka mulonzizagye ndîke omwâmi w’Abayahudi?» <verse eid="JHN 18:39"/><verse number="40" style="v" sid="JHN 18:40"/>Bashub’iyâma, mpu: «Arhali ye, ci Baraba!» Oyôla. Baraba càli cishambo.<verse eid="JHN 18:40"/></para>
  <chapter eid="JHN 18"/>
  <chapter number="19" style="c" sid="JHN 19"/>
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1"/>Okuhandi Bilato arhegeka mpu bayanke Yezu banamushûrhe emikoba. <verse eid="JHN 19:1"/><verse number="2" style="v" sid="JHN 19:2"/>Abasirika banaciluka ecimane c’emishûgi, bamuhiraco omw'irhwe, bamuyambika ecishûli cidukula. <verse eid="JHN 19:2"/><verse number="3" style="v" sid="JHN 19:3"/>Bakamujaho banaderha, mpu: «Asinge wâni mwâmi w’Abayahudi!» Banakamushûrha empî. <verse eid="JHN 19:3"/><verse number="4" style="v" sid="JHN 19:4"/>Bilato ashub’ihuluka, ababwîra, erhi: «Y’oyu mmudwîrhîre eno mbuga, nti mubone oku ntà cibî namubwînekwo». <verse eid="JHN 19:4"/><verse number="5" style="v" sid="JHN 19:5"/>Yezu anacihuluka erhi akola ayambîrhe cirya cimanè c’emishûgi na cirya cishûli cidukula. Bilato ababwîra, erhi: «Lâbagi omuntu!» <verse eid="JHN 19:5"/><verse number="6" style="v" sid="JHN 19:6"/>Oku banamukozakwo amasù, abajinji b’abadâhwa n’abaganda bayâma, mpu: «Omubambe, omubambe oku musalaba?» Bilato abashuza, erhi: «Mumuyanke mwêne, mugend’imubamba oku musalaba: “niehe ntà cibî mmubwînekwo”». <verse eid="JHN 19:6"/><verse number="7" style="v" sid="JHN 19:7"/>Abayahudi bamushuza, mpu: «Rhujira Irhegeko, n’eryo Irhegeko lidesire mpu afè, bulya acîjizire mwene Nyamuzinda». <verse eid="JHN 19:7"/><verse number="8" style="v" sid="JHN 19:8"/>Erhi Bilato ayumva eco cinwa, ashubiyôboha bwenêne. <verse eid="JHN 19:8"/><verse number="9" style="v" sid="JHN 19:9"/>Ashub’ijà omu k’emmanja, adôsa Yezu, erhi: «Oli wa ngahi?» Ci Yezu arhamushuzagya ka­ntu. <verse eid="JHN 19:9"/><verse number="10" style="v" sid="JHN 19:10"/>Bilato anacimubwîra, erhi: «K’orhalonza okumbwîra? K’orhamanyiri oku ngwêrhe obuhashe bw’okukulika n’obuhashe bw’okukubamba oku musalaba?» <verse eid="JHN 19:10"/><verse number="11" style="v" sid="JHN 19:11"/>Yezu amushuza, erhi: «Ntà buhashe wankambwînekwo, acibâga orhabuhâbagwa kurhenga enyanya. Co cirhumire ecâha c’owampânaga omu maboko gâwe cilushire ecâwe<note caller="+" style="f"><char style="fr" closed="false">19, 11 </char><char style="ft" closed="false">Abalenganyagya Yezu bo Buyahudi, na kulusha abandi boshi, Kayifa na Yûda.</char></note>».<verse eid="JHN 19:11"/></para>
  <para style="s1">Yezu atwirwa okufà</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12"/>Kurhenga aho, Bilato akâlonza oku akamulika. Ci Abayahudi bayâma, mpu: «Okamulika, erhi orhali mwîra wa Sezarì: bulya ngasi yêshi ocijira mwâmi, erhi kugoma agomîre Sezari». <verse eid="JHN 19:12"/><verse number="13" style="v" sid="JHN 19:13"/>Erhi ayumva ebyo binwa, Bilato ahêka Yezu embuga, atamala aha k’emmanja kâge, haderhwa «Litostrotos», omu cihabraniya «Gabata». <verse eid="JHN 19:13"/><verse number="14" style="v" sid="JHN 19:14"/>Lwàli lusiku lw’Amarheganyo ga Basâka, nka nsâ ya kali ndarhu. Bilato abwîra Abayahudi, erhi: «Lolagi omwâmi winyu». <verse eid="JHN 19:14"/><verse number="15" style="v" sid="JHN 19:15"/>Nabo bayâma, mpu: «Rhenza, rhenza! Omubambe oku musalaba!» Bilato abadôsa, erhi: «Kurhi nankabamba omwâmi winyu?» Abajinji b’abadâhwa bamushuza, mpu: «Ntà wundi mwâmi rhujira orhali Sezari!» <verse eid="JHN 19:15"/><verse number="16" style="v" sid="JHN 19:16"/>Obwo anacibahàye mpu bamubambe oku musalaba.</para>
  <para style="s1" vid="JHN 19:16">Yezu abambwa oku musalaba</para>
  <para style="r" vid="JHN 19:16">(<ref loc="MAT 27:31">Mat 27, 31</ref>.<ref loc="MAT 27:33">33</ref>.<ref loc="MAT 27:37-38">37-38</ref>; <ref loc="MRK 15:21-27">Mrk 15, 21-27</ref>; <ref loc="LUK 23:26-34">Luk 23, 26-34</ref>.<ref loc="LUK 23:38">38</ref>)</para>
  <para style="p" vid="JHN 19:16">Banaciyanka Yezu. <verse eid="JHN 19:16"/><verse number="17" style="v" sid="JHN 19:17"/>Abarhula omusalaba gwâge, arhenga omu Lugo, ajà ahantu haderhwa «hantu h’Empanga», omu cihabraniya «Golgota». <verse eid="JHN 19:17"/><verse number="18" style="v" sid="JHN 19:18"/>Hâhôla ho bamubambîre oku musalaba na bandi babiri bo naye, ngasi muguma eburhambi, na Yezu ekarhî. <verse eid="JHN 19:18"/><verse number="19" style="v" sid="JHN 19:19"/>Bilato ayandika olwandiko, alumanika oku musalaba. Ebinwa by’olwo lwandiko by’ebi: «Yezu w’e Nazareti, Mwâmi w’A­Buyahudi». <verse eid="JHN 19:19"/><verse number="20" style="v" sid="JHN 19:20"/>Ezo nderho Bayahudi banji bazisoma, bulya aho Yezu abambira­gwa oku musalaba hàli hôfi n’olugo n’ezo nderho zàli nyandike omu cihabraniya n’omu cilatini n’omu cigereki. <verse eid="JHN 19:20"/><verse number="21" style="v" sid="JHN 19:21"/>Abajinji b’Abayahudi babwîra Bilato, mpu: «Orhayandikaga: Mwâmi w’Abayahudi, ci: Oyu muntu acîhambire, mpu: Nie Mwâmi w’Abayahudi». <verse eid="JHN 19:21"/><verse number="22" style="v" sid="JHN 19:22"/>Bilato ashuza, erhi: «Nayandisire nanayandisirage».<verse eid="JHN 19:22"/></para>
  <para style="s1">Bashokôla emyambalo ya Yezu</para>
  <para style="r">(<ref loc="MAT 27:35">Mat 27, 35</ref>; <ref loc="MRK 15:24">Mrk 15, 24</ref>; <ref loc="LUK 23:34">Luk 23, 34</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23"/>Abasirika erhi babà bamabambira Yezu oku musalaba, bashokôla emyambalo yâge, bayigabamwo bigabi bini, ngasi musirika ciguma, n’ecishûli câge. Eco cishûli cirhàlimwo buhange, canali ca ciremo ciguma kurhenga enyanya kuhika idako. <verse eid="JHN 19:23"/><verse number="24" style="v" sid="JHN 19:24"/>Banacicîjânamwo bône na nnene, mpu: «Rhurhacisharhulaga, ci rhuciyeshe cigole, rhulole ndi wacihêka». Ntyo kwanaciyunjula kulya kwàli kuyandisirwe, mpu: Emyambalo yâni bayigabâna, n’ecishûli câni baciyesha cigole. Ntyôla kwo abasirika bajizire.<verse eid="JHN 19:24"/></para>
  <para style="s1">Yezu na nnina</para>
  <para style="r">(<ref loc="MAT 27:55-56">Mat 27, 55-56</ref>; <ref loc="MRK 15:40-47">Mrk 15, 40-47</ref>; <ref loc="LUK 23:49">Luk 23, 49</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25"/>Aha burhambi bw’omusalaba gwa Yezu bâli bayimanzire: nnina, na mu­nnina, Mariya, mukà-Kleofasi, na Mariya Magadalena, <verse eid="JHN 19:25"/><verse number="26" style="v" sid="JHN 19:26"/>Erhi Yezu abona nnina n’olya muganda arhonyagya eburhambi bwâge, anacibwîra nnina, erhi: «Nyoko we, alà mugala wâwe». <verse eid="JHN 19:26"/><verse number="27" style="v" sid="JHN 19:27"/>Abwîra n’olya muganda, erhi: «Alà nyoko<note caller="+" style="f"><char style="fr" closed="false">19, 27 </char><char style="ft" closed="false">Yowane àli arhuyimangîre rhweshi, n’erhi Mwâmi Yezu amuhà Mariya, rhweshi amuhîre mpu abè nyâmà, nîrhu rhubè bâna bâge. Mariya ye Eva muhyâhya, ye nnina wa ngasi muntu wabusirwe buhyâhya omu mukò gwa Yezu.</char></note>». Kurhenga ago mango nyamuganda amuhêka emwâge.<verse eid="JHN 19:27"/></para>
  <para style="s1">Yezu afà oku musalaba</para>
  <para style="r">(<ref loc="MAT 27:48-50">Mat 27, 48-50</ref>; <ref loc="MRK 15:36-37">Mrk 15, 36-37</ref>; <ref loc="LUK 23:46">Luk 23, 46</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28"/>Enyuma z’aho, Yezu erhi amanyirîre oku byoshi byayunjwîre, mpu lyo ebyayandisirwe byoshi bibà, anaciderha, erhi: «Enyôrha yamangwârha», <verse eid="JHN 19:28"/><verse number="29" style="v" sid="JHN 19:29"/>Ahôla erhi hali akabindi kayunjwîre nkalishi. Banaciyanka ecihôrholo, bacivumvuliza mw’erya nkalishi, bacîshwêkera oku itumu, bamuhêreza mpu anywe. <verse eid="JHN 19:29"/><verse number="30" style="v" sid="JHN 19:30"/>Erhi Yezu ayûs’inywakwo eyo nkalishi, aderha, erhi: «Hoshi aho». Anaciyûnamya irhwe, arhengamwo omûka.<verse eid="JHN 19:30"/></para>
  <para style="s1">Yezu afundwa itumu</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31"/>Lwàli lusiku lw’Amarheganyo ga Basâka, lyo emirhumba erhag’ibêra oku musalaba olwa Sabato, n’olwo lwa-Sabato lwàli lukulu bwenêne, Abayahudi baj’ihûna Bilato mpu babavune emilundi<note caller="+" style="f"><char style="fr" closed="false">19, 31 </char><char style="ft" closed="false">Babavunaga emilundi mpu lyo bafà duba, banabarhenze oku musalaba embere oluzira lwa Sabato lurhangìre.</char></note>, banabamanule, <verse eid="JHN 19:31"/><verse number="32" style="v" sid="JHN 19:32"/>Abasirika bayisha, bavuna omurhanzi emilundi n’owa kabiri mwo balya bâli babambirwe oku musalaba bo naye, <verse eid="JHN 19:32"/><verse number="33" style="v" sid="JHN 19:33"/>Erhi bahika hali Yezu, bashimâna afîre; barhavunaga milundi, <verse eid="JHN 19:33"/><verse number="34" style="v" sid="JHN 19:34"/>ci musirika muguma amushinga itumu omu lubavu, na halya honênè mwarhenga omukò n’amîshi<note caller="+" style="f"><char style="fr" closed="false">19, 34 </char><char style="ft" closed="false">Abakula-mbêre b’Ekleziya bayigîrizize oku ogo mukò ciri cimanyîso, c’Obukaristiya, n’oku ago mîshi co cimanyîso c’Obubatizo.</char></note>. <verse eid="JHN 19:34"/><verse number="35" style="v" sid="JHN 19:35"/>Owabonaga okwo, yêne ye na muhamîrizi, n’obuhamîrizi bwâge buli bw’okuli, anamanyire oku adesire oku­nali, mpu lyo ninyu muyêmêra. <verse eid="JHN 19:35"/><verse number="36" style="v" sid="JHN 19:36"/>Ebyo byoshi byabîre mpu lyo Amandiko gayunjula: Barhakamuvuna kavuha ciru n’akaguma, <verse eid="JHN 19:36"/><verse number="37" style="v" sid="JHN 19:37"/>N’ahandi kuyandisirwe, mpu: Bayish’ilolêreza<note caller="+" style="f"><char style="fr" closed="false">19, 37 </char><char style="ft" closed="false">Okulolêreza, omu kanwa ka Yowane, kwo kuyêmêra n’okushimba Kristu.</char></note> oyu bafundaga itumu.<verse eid="JHN 19:37"/></para>
  <para style="s1">Yezu abishwa</para>
  <para style="r">(<ref loc="MAT 27:57-60">Mat 27, 57-60</ref>; <ref loc="MRK 15:42-46">Mrk 15, 42-46</ref>; <ref loc="LUK 23:50-54">Luk 23, 50-54</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38"/>Okubundi Yozefu w’e Arimatiya ahûna Bilato okumanula omubiri gwa Yezu. Oyo Yozefu ali naye muganda wa Yezu, ci bufundafunda erhi kuyôboha Abayahudi kurhuma. Bilato ayêmêra. Anaciyish’iguyanka. <verse eid="JHN 19:38"/><verse number="39" style="v" sid="JHN 19:39"/>Nikodemu naye ayisha; y’olya warhangag’ijà emwa Yezu budufu. Ali adwîrhe emvangè y’obukù n’omugavu ya ngero nk’igana. <verse eid="JHN 19:39"/><verse number="40" style="v" sid="JHN 19:40"/>Bayanka omubiri gwa Yezu, baguboha omu bitambara banagushîga omugavu nka kulya Abayahudi banakomerera okubisha. <verse eid="JHN 19:40"/><verse number="41" style="v" sid="JHN 19:41"/>Aha bamubambiraga oku musalaba hàli ishwa, na mw’ery’ishwa mwâli enshinda mpyâhya erhalisâg’ibishwamwo ndi. <verse eid="JHN 19:41"/><verse number="42" style="v" sid="JHN 19:42"/>Bulya lwàli lusiku lwa Marheganyo g’Abayahudi, babisha Yezu mw’eyo nshinda yali hôfi.<verse eid="JHN 19:42"/></para>
  <chapter eid="JHN 19"/>
  <chapter number="20" style="c" sid="JHN 20"/>
  <para style="s1">Bashimâna enshinda erhacirimwo ndi</para>
  <para style="r">(<ref loc="MAT 28:1-8">Mat 28, 1-8</ref>; <ref loc="MRK 16:1-8">Mrk 16, 1-8</ref>; <ref loc="LUK 24:1-11">Luk 24, 1-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1"/>Olusiku lurhanzi lw’omugobe<note caller="+" style="f"><char style="fr" closed="false">20, 1 </char><char style="ft" closed="false">Olusiku lurhanzi lw’omugobe erhi lurhanzi nyuma lya Sabato, lwo lukola lusiku lwa Nyakasane lw’abakristu, bulya lwo lusiku Mwâmi Yezu afûkaga, lwo na lusiku Mûka Mutagatîfu ayandagaliraga Entumwa.</char></note>, Mariya Magadalena alamukira ebwa cûsho mucêracêra burhac’ihumanuka; ashimâna bakûzire ibuye oku nshi­nda. <verse eid="JHN 20:1"/><verse number="2" style="v" sid="JHN 20:2"/>Anacikûla omulindi, aj’emunda Simoni Petro àli bo n’olya wundi muganda Yezu arhonyagya, ababwîra, erhi: «Babishwîre Nyakasane, rhurhanamanyiri aha bamuhizire». <verse eid="JHN 20:2"/><verse number="3" style="v" sid="JHN 20:3"/>Petro anacigenda bo n’olya wundi muganda, baj’ebwa cûsho. <verse eid="JHN 20:3"/><verse number="4" style="v" sid="JHN 20:4"/>Bajaga balibirha bombi. Olya wundi muganda ye wali mubidu, kulusha Petro, amushokolera, ahika wa burhanzi aha bwa nshinda. <verse eid="JHN 20:4"/><verse number="5" style="v" sid="JHN 20:5"/>Anaciyûnama, abona ebitambara oku idaho, ci arhamujaga. <verse eid="JHN 20:5"/><verse number="6" style="v" sid="JHN 20:6"/>Simoni Petro wali omukulikire naye ahika. Aj’omu cûsho, abona ebitambara biri oku idaho, <verse eid="JHN 20:6"/><verse number="7" style="v" sid="JHN 20:7"/>n’omwenda bâli bafûnisiremwo irhwe. Ogwo mwenda gurhàli haguma n’ebitambara, ci gwàli muzinge hâgo hâgo. <verse eid="JHN 20:7"/><verse number="8" style="v" sid="JHN 20:8"/>Lyo olya wundi muganda warhangag’ihika aha bwa cûsho naye amujirage. Acîbonera, anayêmêra. <verse eid="JHN 20:8"/><verse number="9" style="v" sid="JHN 20:9"/>Okuli, barhàli basâg’iyumva oku amandiko gadesire oku àli akwânîne afûke omu bafù. <verse eid="JHN 20:9"/><verse number="10" style="v" sid="JHN 20:10"/>Okuhandi abaganda banacishubir’eka.<verse eid="JHN 20:10"/></para>
  <para style="s1">Yezu abonekera Mariya Magadalena</para>
  <para style="r">(<ref loc="MAT 28:9-10">Mat 28, 9-10</ref>; <ref loc="MRK 16:9-11">Mrk 16, 9-11</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11"/>Mariya yêhe àli ayîmanzire aha bwa cûsho, anali adwîrhe afûmêka. Oku adwîrhe alaka, ayûnama, alola omu nshinda, <verse eid="JHN 20:11"/><verse number="12" style="v" sid="JHN 20:12"/>abona bamalahika babiri bayambîrhe emyambalo myêru banabwârhire aha bâli balambisire omubiri gwa Yezu, muguma ebw’irhwe, owundi ebwa magulu. <verse eid="JHN 20:12"/><verse number="13" style="v" sid="JHN 20:13"/>Banacimubwîra, mpu: «We mukazi, bici ebyo walakira?» Naye, erhi: «Bahêsire Nnawîrhu, ntanamanyiri ngahi bamuhizire». <verse eid="JHN 20:13"/><verse number="14" style="v" sid="JHN 20:14"/>Oku ayûs’iderha ntyo, akabagana, abona Yezu ayîmanzire, ci arhamanyaga oku ye. <verse eid="JHN 20:14"/><verse number="15" style="v" sid="JHN 20:15"/>Yezu amudôsa, erhi: «We mukazi, bici ebyo walakira? Ndi walonza?» Acikêbwa mpu ye mulanzi w’ishwa, amubwîra, erhi: «Yâgirwa, akabà we wamuhêsire, ombwîre ngahi wamuhizire, nj’imurhôla». <verse eid="JHN 20:15"/><verse number="16" style="v" sid="JHN 20:16"/>Yezu amubwîra, erhi: «Mariya!» Mariya amumanyîrira, amubwîra omu mahabraniya, erhi: «Rabuni!» kwo kuderha: «Muyigîriza». <verse eid="JHN 20:16"/><verse number="17" style="v" sid="JHN 20:17"/>Yezu amubwîra, erhi: «Orhampumagakwo, bulya ntaj’irheremera emwa Larha. Ci ojage emunda bene wîrhu<note caller="+" style="f"><char style="fr" closed="false">20, 17 </char><char style="ft" closed="false">Abo bene wâbo Yezu, bo haganda bâge.</char></note> bali, obabwîre oku nteremîre emwa Larha na Sho, emwa Nyamuzinda wâni na Nyamuzinda winyu». <verse eid="JHN 20:17"/><verse number="18" style="v" sid="JHN 20:18"/>Mariya Magadalena anacigenda, abwîra abaganda oku abwîne Nyakasane n’oku amubwîzire ebyo binwa.<verse eid="JHN 20:18"/></para>
  <para style="s1">Yezu abonekera abaganda bâge</para>
  <para style="r">(<ref loc="MRK 16:14-18">Mrk 16, 14-18</ref>; <ref loc="LUK 24:36-49">Luk 24, 36-49</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19"/>Bijingo by’olwo lusiku lurhanzi lw’omugobe lwonênè, omu abaganda bâli enyumvi zoshi zàli mpamike erhi kuyôboha Abayahudi kurhuma. Yezu anacipamuka, abayimanga ekarhî, ababwîra, erhi: «Omurhûla muli mwe!» <verse eid="JHN 20:19"/><verse number="20" style="v" sid="JHN 20:20"/>Erhi aderha ntyo, abayêreka enfune n’olubavu. Abaganda basîma bwenêne erhi babona Nyakasane. <verse eid="JHN 20:20"/><verse number="21" style="v" sid="JHN 20:21"/>Yezu ashub’ibabwîra, erhi: «Omurhûla muli mwe! Nk’oku Larha antumaga, nâni mmurhumire». <verse eid="JHN 20:21"/><verse number="22" style="v" sid="JHN 20:22"/>Erhi abà amâderha ntyo, ababûhira omûka, ababwîra, erhi: «Yankiriri Mûka Mutagatîfu. <verse eid="JHN 20:22"/><verse number="23" style="v" sid="JHN 20:23"/>Abamwâkulire e­ byâha, babikulirwe n’abamwâbirekere, babiyôrhane». <verse eid="JHN 20:23"/><verse number="24" style="v" sid="JHN 20:24"/>Ci Toma yêhe, muguma muli balya ikumi na babiri, oderhwa Cihasha, arhâli baguma n’abâbo erhi Yezu ayisha. <verse eid="JHN 20:24"/><verse number="25" style="v" sid="JHN 20:25"/>Abandi baganda bamubwîra, mpu: «Rhwabwîne Nyakasane!» Naye abashuza, erhi: «Nkaba ntabwîni emirhule y’erya migera omu nfune zâge, nkaba ntafundiri omunwe gwâni omu bibande by’emisumari, na nkaba ntahumiri niene omu lubavu lwâge, ntayêmêre».<verse eid="JHN 20:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26"/>Erhi kugera nsiku munâni, abaganda bâli kandi omu nyumpa na Toma haguma nabo. Yezu apamuka erhi n’enyumvi zoshi ziri mpamike; abayimanga ekarhî, erhi: «Omurhûla muli mwe!» <verse eid="JHN 20:26"/><verse number="27" style="v" sid="JHN 20:27"/>Anacibwîra Toma, erhi: «Funda omunwe gwâwe omu: lolà enfune zâni; lêrha okuboko kwâwe, okuhire omu lubavu lwâni; orhanacibaga mubula­-buyêmêre, ci obè mwemêzi». <verse eid="JHN 20:27"/><verse number="28" style="v" sid="JHN 20:28"/>Toma ashuza, erhi: «Nyakasane, Nyamuzinda wâni». <verse eid="JHN 20:28"/><verse number="29" style="v" sid="JHN 20:29"/>Yezu amubwîra, erhi: «Oyêmîre bulya wambwîne. Bali bany’iragi abâyêmêre barhanabwîni».<verse eid="JHN 20:29"/></para>
  <para style="s1">Enfundiko ntanzi y’ecitabu</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30"/>Yezu ajizire bindi bimanyîso binji embere z’abaganda bâge birhayandisirwi mw’eci citabu. <verse eid="JHN 20:30"/><verse number="31" style="v" sid="JHN 20:31"/>Ebîra byayandisirwe nti lyo muyêmêra oku Yezu ye Kristu, Mwene Nnâmahanga, na mukayêmêra, nti lyo mubona obuzîne oku izîno lyâge.<verse eid="JHN 20:31"/></para>
  <chapter eid="JHN 20"/>
  <chapter number="21" style="c" sid="JHN 21"/>
  <para style="s1">Yezu abonekera abaganda bâge eburhambi bw’enyanja y’e Tiberiyadi</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1"/>Enyuma z’aho, Yezu ashub’ibonekera abaganda bâge eburhambi bw’e­ nyanja y’e Tiberiyadi. Alagi oku ababonekeraga<note caller="+" style="f"><char style="fr" closed="false">21, 1 </char><char style="ft" closed="false">Emilongo, kurhenga 1 kuhika 25: Eci cigabi cizinda cayûshûlagwa na Yowane yêne erhi na mushimbûlizi wâge muguma.</char></note>. <verse eid="JHN 21:1"/><verse number="2" style="v" sid="JHN 21:2"/>Simoni Petro, Toma, oderhwa Cihasha, Natanaeli w’e Kana omu Galileya, bene-Zebedeyo na bandi baganda babiri bâli haguma. <verse eid="JHN 21:2"/><verse number="3" style="v" sid="JHN 21:3"/>Simoni Petro anacibabwîra, erhi: «Nkol’iduba». Nabo bamubwîra, mpu: «Nîrhu rhwakushimba». Banacilîkûla, bashonera omu bwârho. Ci mw’obwo budufu, ntâco barhôzire. <verse eid="JHN 21:3"/><verse number="4" style="v" sid="JHN 21:4"/>Erhi izûba lishoshôka emashinji, bahona Yezu ayîmanzire ebulambo, ci abaganda barhamanyaga oku ye. <verse eid="JHN 21:4"/><verse number="5" style="v" sid="JHN 21:5"/>Yezu anacibabwîra, erhi: «Mwe bâna, ka ntà hifi mugwêrhe?» Bamushuza mpu: «Ntâhyo!» <verse eid="JHN 21:5"/><verse number="6" style="v" sid="JHN 21:6"/>Naye, erhi: «Mukwêbe akêshe ebwa kulyo k’obwârho, mwâgwâsa». Banacikakwêba, ci barhacihashag’ikazikûla erhi bunji bwa nfî burhuma. <verse eid="JHN 21:6"/><verse number="7" style="v" sid="JHN 21:7"/>Olya muganda Yezu arhonyagya anacibwîra Petro erhi: «Nyakasane oyo!» Erhi Simoni Petro ayumva mpu Nyakasane oyo, acîbwîka omwambalo gwâge, bulya arhàli ayambîrhe, acîloha omu nyanja. <verse eid="JHN 21:7"/><verse number="8" style="v" sid="JHN 21:8"/>Abandi baganda bayisha omu bwârho, bajà bakulula akêshe n’e­nfî, bulya barhàli kuli n’ecikwî c’enyanja: yali nka misomi magana abiri yône. <verse eid="JHN 21:8"/><verse number="9" style="v" sid="JHN 21:9"/>Erhi bayômoka oku cikwî, babona amakala gayâsire, n’enfî egalikwo n’omugati. <verse eid="JHN 21:9"/><verse number="10" style="v" sid="JHN 21:10"/>Yezu anacibabwîra, erhi: «Lerhagi kuli ezo nfî mudubire». <verse eid="JHN 21:10"/><verse number="11" style="v" sid="JHN 21:11"/>Simoni Petro ashonera omu bwârho, akululira akêshe ebulambo; kàli kayunjwîre bifi binênênè: igana na makumi arhanu na bisharhu. N’obwo zàli nyinji ntyo, akêshe karhaberekaga. <verse eid="JHN 21:11"/><verse number="12" style="v" sid="JHN 21:12"/>Yezu ababwîra, erhi: «Yishagi muyikule». Ntà muguma omu baganda wadesire, mpu amudôsa, mpu: «We ndi?» bulya bâli bamanyire bwinjà oku àli Nyakasane. <verse eid="JHN 21:12"/><verse number="13" style="v" sid="JHN 21:13"/>Okuhandi Yezu anaciyegera, arhôla omugati, abahêreza, n’enfî kwo na kwo. <verse eid="JHN 21:13"/><verse number="14" style="v" sid="JHN 21:14"/>Bwo bwàli bwa kasharhu obwo Yezu abonekera abaganda bâge kurhenga afûka omu bafù.<verse eid="JHN 21:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15"/>Erhi bayûs’iyikula, Yezu adôsa Simoni Petro, erhi: «Simoni, mwene Yowane, k’onzigira kulusha abà?» Amushuza, erhi: «Nêci, Nyakasane, orhahabiri oku nkuzigira». Yezu amubwîra, erhi: «Yabula abâna-buzi bâni». <verse eid="JHN 21:15"/><verse number="16" style="v" sid="JHN 21:16"/>Amudôsa obwa kabiri, erhi: «Simoni, mwene Yowane, k’onzigira?» Amushuza, erhi: «Nêci, Nyakasane, orhahabiri oku nkuzigira». Yezu amubwîra, erhi: «Yabula ebibuzi byâni». <verse eid="JHN 21:16"/><verse number="17" style="v" sid="JHN 21:17"/>Amudôsa obwa kasharhu, erhi: «Simoni, mwene Yowane, k’onzigira?» Petro alumwa erhi ayumva amudôsa kasharhu, erhi «K’onzigira?» Anacimubwîra, erhi: «Yâgirwa, oyishi byoshi, orhahabiri oku nkuzigira». Yezu amubwîra, erhi: «Yabula ebibuzi byâni»<note caller="+" style="f"><char style="fr" closed="false">21, 17 </char><char style="ft" closed="false">Erhi Mwâmi Yezu aha Petro obuhashe bw’okuyâbula abâna-buzi n’ebibuzi byâge, amujira mukulu w’Ekleziya yoshi, amuhà obuhashe bw’okurhegeka abarho n’abakulu</char></note>.<verse eid="JHN 21:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 21:18"/>«Okuli, okuli, nkubwîre, erhi ociri musole, wêne wakâg’ihwinja wanakajà aha olonzize, ci amango wâshosihala, wâlambûle amaboko, owundi akushwêke anakuhêke aha orhalonza. <verse eid="JHN 21:18"/><verse number="19" style="v" sid="JHN 21:19"/>“Erhi aderha okwo, amanyîsa lufù luci Petro ayish’ikuzamwo Nnâmahanga”». Erhi abà amâderha ntyo, amubwîra, erhi: «Nshimba».<verse eid="JHN 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20"/>Oku Petro acikabagana, abona olya muganda Yezu arhonyagya abakulikire, y’olya wali oshegemize irhwe oku cifuba câge erhi bashêga anamudôsa, erhi: «Yâgirwa, ndi wakulenganya?» <verse eid="JHN 21:20"/><verse number="21" style="v" sid="JHN 21:21"/>Erhi Petro amubona, abwîra Yezu, erhi: «Naye ye, Nyakasane?» <verse eid="JHN 21:21"/><verse number="22" style="v" sid="JHN 21:22"/>Yezu amushuza, erhi: «Nkola nalonza nti ayôrhe kuhika ngaluke, ka kukuyêrekîre? W’oyo nshimba». <verse eid="JHN 21:22"/><verse number="23" style="v" sid="JHN 21:23"/>Omwanzi gwavuma omu bashimbûlizi ba Yezu mpu oyo muganda arhakafa. N’obwo Yezu arhàl’ibwîzire Petro, mpu: «Arhakafa», ci mpu: «Nkola nalonza nti ayôrhe kuhika ngaluke, ka kukuyêrekîre?»<verse eid="JHN 21:23"/></para>
  <para style="s1">Obushwinjiro bw’ebinwa</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24"/>Oyo muganda ye muhamîrizi w’ebyo, ye wanabiyandikaga, rhunamanyire oku obuhamîrizi bwâge buli bw’okunali. <verse eid="JHN 21:24"/><verse number="25" style="v" sid="JHN 21:25"/>Hali bindi binji Yezu ajizire. Owabirhondêreza ciguma ciguma, ciru n’igulu lirhankabona aha lyahira ebitabu byankayandikwa.<verse eid="JHN 21:25"/></para>
  <chapter eid="JHN 21"/>
</usx>
