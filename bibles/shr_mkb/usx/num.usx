<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="NUM" style="id">MIB - Bible en mashi du Congo</book>
  <para style="toc3">Mib</para>
  <para style="toc2">Mibalè</para>
  <para style="toc1">EMIBALÈ</para>
  <para style="h">Emibalè</para>
  <para style="mt1">EMIBALÈ</para>
  <para style="imt1">Enshokolezi</para>
  <para style="ip">Ed citabu ciderhwa Mibalè bulya ebigabi byâco bimanyîsa embero za Bene Israheli. Cimanyîsa engerêrezo zâbo na kurhi babalamiraga eburhambi bw’enyanja. Bene Israheli bacîrheganya okurhenga oku ntondo y’e Sinayi bacîganja. Muli eci citabu mushambâlwa ebiyêrekîre entûlo nene bahânaga mpu lyo bacungulwa. Enyuma ly’oburherekêre bwa kabirhi bwa Basaka, barhenga oku ntondo ntagatifu, bahika bunyibunyi omu cihugo ca Kadesi. Erhi barhenga eyo munda, balonza okujà omu cihugo c’e Kanani. Erhi bayûs’ibêra bwenene e Kadesi, bayanka enjira yâbo, bahika e Mowabu, ishiriza ly’e Yeriko. Banya-Madiani bahimwa n’engabo ya Gadi na Rubeni, bacîyôha omu Yordani. Emibalè eshambâla kandi kurhi barhengaga e Mîsiri. Omu citabu c’e Mibalè mubà amarhegeko gayûshûla ag’oku Sinayi. Ebiri omu bikulikirîne ntya:</para>
  <para style="io1">1. Bene Israheli bacîrheganya okubunga: <char style="ior"><ref loc="NUM 1:1-10:10">1, 1—10, 10</ref></char></para>
  <para style="io1">2. Okuhanda omu njira embere bahike: <char style="ior"><ref loc="NUM 1:11-12:16">1, 11—12, 16</ref></char></para>
  <para style="io1">3. Akalamo ka Abrahamu: <char style="ior"><ref loc="NUM 22:1-24:25">22, 1—24, 25</ref></char></para>
  <para style="io1">4. Okuyûbaka kuhyâhya: <char style="ior"><ref loc="NUM 25:1-36:13">25, 1—36, 13</ref></char></para>
  <chapter number="1" style="c" sid="NUM 1"/>
  <para style="ms1">I. Omubalè gw’abantu b’amatabâro</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 1:1"/>Nyakasane ashambâla na Mûsa omw’irungu lya Sînayi, omw’Ihêma ly’embugânano, omu lusiku lurhanzi lw’omwêzi gwa kabirhi, omu mwakagwa kabirhi kurhenga barhenzire e Mîsiri. Anacimubwîra, erhi: <verse eid="NUM 1:1"/><verse number="2" style="v" sid="NUM 1:2"/>«Ojire omubalè<note caller="+" style="f"><char style="fr" closed="false">1, 2 </char><char style="ft" closed="false">Ogwo mubalè murhanzi gwa bene Israheli, guli gwa kulonza okumanya abarhabâzi bali banga embere bajè oku matabâro: omu cihugo babalaganyagya. Omubalè gwa kabirhi omu cigabi ca 26: gali marheganyo g’okugabâna eco cihugo. Mw’okwo kwoshi, bamanyire oku Nyakasane ye bashokolîre yêne yeri eluhya, buzira ntyo lyanahashibà isakrilego (Rhulole omu <char style="xt"><ref loc="2SA 24">2 Sam 24</ref>; <ref loc="EXO 30:11">Lub 30, 11</ref>.<ref loc="EXO 30:16">16</ref></char>: kuyêrekine obwôrhere bw’okujira emibalè). </char></note> gwa bene Israheli boshi, omu kukulikira emilala yâbo nk’oku bashakulûza bâbo banagenda; ojè waganja ngasi mulume, <verse eid="NUM 1:2"/><verse number="3" style="v" sid="NUM 1:3"/>“kurhenga oku ogwêrhe myâka makumi abirhi ali muburhe, kuhêka enyanya, balya balume boshi bankajâga oku matabâro omu bene Israheli; obaganje omu kukulikira emirhwe yâbo we na Aroni”, <verse eid="NUM 1:3"/><verse number="4" style="v" sid="NUM 1:4"/>“Warhabâlwa na mushamuka muguma w’omu ngasi mulala, Olya onali mukulu na cisiki ca bashakulûza wâbo”».<verse eid="NUM 1:4"/></para>
  <para style="s1">Abarhabâzi ba Mûsa omu kuganja</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 1:5"/>Alaga amazîno g’abakurhabâla: kuli bene Rubeni, ali Elisuri mwene Sedeuri, ­ <verse eid="NUM 1:5"/><verse number="6" style="v" sid="NUM 1:6"/>Kuli bene Simoni, ali Shelumieli, mwene Surishadayi, <verse eid="NUM 1:6"/><verse number="7" style="v" sid="NUM 1:7"/>Kuli bene Yûda, ali Nashoni, mwene Aminadabu, <verse eid="NUM 1:7"/><verse number="8" style="v" sid="NUM 1:8"/>Kuli bene Isakari, ali Natanaeli, mwene Suari, <verse eid="NUM 1:8"/><verse number="9" style="v" sid="NUM 1:9"/>Kuli bene Zabuloni, ali Eliabu, mwene Heloni. <verse eid="NUM 1:9"/><verse number="10" style="v" sid="NUM 1:10"/>Kuli bene Yozefu: kuli Efrayimu, ali Elishamaʿ, mwene Amihudi; kuli Menashè, ali Gamalieli, mwene Pedasuri. <verse eid="NUM 1:10"/><verse number="11" style="v" sid="NUM 1:11"/>Kuli bene Benyamini, ali Abidani, mwene Gedeoni. <verse eid="NUM 1:11"/><verse number="12" style="v" sid="NUM 1:12"/>Kuli bene Dani, ali Ahiyezeri, mwene Amishadayi. <verse eid="NUM 1:12"/><verse number="13" style="v" sid="NUM 1:13"/>Kuli bene Aseri, ali Pagieli, mwene Okrani. <verse eid="NUM 1:13"/><verse number="14" style="v" sid="NUM 1:14"/>Kuli bene Gadi, ali Eliasafu mwene Dueli. <verse eid="NUM 1:14"/><verse number="15" style="v" sid="NUM 1:15"/>Kuli bene Nefutali, ali Ahira, mwene Enani. <verse eid="NUM 1:15"/><verse number="16" style="v" sid="NUM 1:16"/>Bo bacîshozirwe omu ndêko abôla, bali barhambo b’emilala ya b’îshe wâbo; bali barhambo b’ebihumbi omu bene Israheli. <verse eid="NUM 1:16"/><verse number="17" style="v" sid="NUM 1:17"/>Mûsa na Aroni erhi babà bamârhôla abôla balume, bamanyisibagwa ngasi muguma oku izîno lyâge, <verse eid="NUM 1:17"/><verse number="18" style="v" sid="NUM 1:18"/>banacilâlika endêko yoshi omu mbugânano, omu lusiku lurhanzi lw’omwêzi gwa kabirhi, banaciyandikwa ngasi baguma omu kushimba emilala yâbo, omu kushimba enyumpa za bashakulûza wâbo, ajà abaganja amazîno, lyo n’irhwe lya ngasi muguma, kurhenga myâka makumi abirhi, kuhêka enyanya. <verse eid="NUM 1:18"/><verse number="19" style="v" sid="NUM 1:19"/>Nk’oku Nyakasane amurhegekega, Mûsa ajira omubalè gwâbo ntyo, oku ntondo ya Sînayi.<verse eid="NUM 1:19"/></para>
  <para style="s1">Omubalè murhanzi gwa Bene Israheli</para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 1:20"/>Bene Rubeni, kulya banalondana, n’oku emilala yâbo enakulikirîne, omu kushimba enyumpa za bashakulûza wâbo, kandi omu kuganja ngasi irhwe na ngasi izîno omu balume ba myâka makumi abirhi kuhêka enyanya, na ngasi boshi bankahêkaga emirasano. <verse eid="NUM 1:20"/><verse number="21" style="v" sid="NUM 1:21"/>Abaganjirwe omu bûko bwa Rubeni, bayimanga bantu bihumbi makumi anni na ndarhu na magana arhanu.<verse eid="NUM 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 1:22"/>Bene Simoni kulya banalondana, na kulya emilala yâbo enakulikirana, omu kushimba enyumpa za bashakulûza wâbo; abaganjîrwe amazîno na ngasi irhwe, omu balume banalikola bagwêrhe myâka makumi abirhi na kuhêka enyanya, ngasi boshi bankanahêkaga emirasano. <verse eid="NUM 1:22"/><verse number="23" style="v" sid="NUM 1:23"/>Abaganjirwe omu bûko bwa Simoni, bayimanga bantu bihumbi makumi arhanu na mwenda na magana asharhu.<verse eid="NUM 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 1:24"/>Bene Gadi, kulya banalondana na kulya emilala yâbo enakulikirana, omu kushimba enyumpa za bashakulûza bâbo, abaganjirwe amazîno na ngasi irhwe, omu balume banalikola bagwêrhe myâka makumi abirhi na kuhêka enyanya ngasi balume bankanahêkaga emirasano. <verse eid="NUM 1:24"/><verse number="25" style="v" sid="NUM 1:25"/>Abaganjirweomu bûko bwa Gadi, bayimanga bantu bihumbi makumi anni na birhanu na magana gali ndarhu na makumi arhanu.<verse eid="NUM 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 1:26"/>Bene Yûda, kulya banalondana na kulya emilala yâbo enakulikirana, omu kushimba enyumpa za bashakulûza bâbo, abaganjirwe amazîno na ngasi irhwe, kurhenga oku muntu wa myâka makumi abirhi kuhêka enyanya, ngasi balume bankanahekaga emirasano. <verse eid="NUM 1:26"/><verse number="27" style="v" sid="NUM 1:27"/>Abaganjirwe omu bûko bwa Yûda bahika omu bantu bihumbi makumi gali nda na bini na magana gali ndarhu.<verse eid="NUM 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 1:28"/>Bene Isakari, oku balondana n’oku emilala yâbo enakulikirana, omu kushimba enyumpa za bashakulûza bâbo, omu kuganja amazîno, kurhenga oku muntu wa myâka makumi abirhi kuhêka enyanya, ngasi balume bankahêkaga emirasano. <verse eid="NUM 1:28"/><verse number="29" style="v" sid="NUM 1:29"/>Abaganjirwe omu bûko bwa Isakari bahika omu bantu bihumbi makumi arhanu na hîni na magana anni.<verse eid="NUM 1:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 1:30"/>Bene Zabuloni, oku balondana n’oku emilala yâbo ekulikirana, omu kushimba enyumpa za bashakulûza bâbo, omu kuganja amazîno n’irhwe lya ngasi muguma, kurhenga oku muntu wa myâka makumi abirhi kuhêka enyanya, ngasi balume bankanahêkaga emirasano. <verse eid="NUM 1:30"/><verse number="31" style="v" sid="NUM 1:31"/>Abaganjirwe omu bûko bwa Zabuloni, bahika omu bantu bihumbi makumi arhanu na nda na magana anni.<verse eid="NUM 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 1:32"/>Bene Yozefu, Bene Efrayimu, oku balondana n’oku emilala yâbo ekulikirana, omu kushimba enyumpa za bashakulûza bâbo, omu kuganja amazîno n’irhwe lya ngasi muguma kurhenga oku muntu wa myâka makumi abirhi kujà enyanya, ngasi balume bankanahêkaga emirasano. <verse eid="NUM 1:32"/><verse number="33" style="v" sid="NUM 1:33"/>Abaganjirwe omu bûko bwa Efrayimu, bahika omu bantu bihumbi makumi anni na magana arhanu. <verse eid="NUM 1:33"/><verse number="34" style="v" sid="NUM 1:34"/>Bene Menashè, oku balondana n’oku emilala yâbo ekulikirana, omu kushimba enyumpa za bashakulûza bâbo, omu kuganja amazîno n’irhwe lya ngasi muguma, kurhenga oku muntu wa myâka makumi abirhi kuhêka enyanya, ngasi balume bankanahêkaga emirasano. <verse eid="NUM 1:34"/><verse number="35" style="v" sid="NUM 1:35"/>Abaganjirwe omu bûko bwa Menashè, bahika omu hantu bihumbi makumi asharhu na bibirhi na magana abirhi.<verse eid="NUM 1:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 1:36"/>Bene Benyamini oku balondana n’oku emilala yâbo ekulikirana, omu kushimba enyumpa za bashakulûza bâbo, omu kuganja amazîno n’irhwe lya ngasi muguma, kurhenga oku muntu wa myâka makumi abirhi kuhêka enyanya, ngasi balume bankanahêkaga emirasano. <verse eid="NUM 1:36"/><verse number="37" style="v" sid="NUM 1:37"/>Abaganjirwe omu bûko bwa Benyamini, bahika omu bantu bihumbi makumi asharhu na birhanu na magana anni.<verse eid="NUM 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 1:38"/>Bene Dani, oku balondana n’oku emilala yaho ekulikirana, omu kushimba enyumpa za bashakulûza bâbo, omu kuganja amazîno n’irhwe lya ngasi muguma, kurhenga oku muntu wa myâka makumi abirhi kuhêka enyanya, ngasi balume bankanahêkaga emirasano. <verse eid="NUM 1:38"/><verse number="39" style="v" sid="NUM 1:39"/>Abaganjirwe omu bûko bwa Dani, bahika omu bantu bihumbi makumi gali ndarhu na bibirhi na magana nda.<verse eid="NUM 1:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 1:40"/>Bene Aseri, oku balondana n’oku emilala yaho ekulikirana, omu kushimba enyumpa za bashakulûza bâbo, omu kuganja amazîno n’irhwe lya ngasi muguma, kurhenga oku muntu wa myâka makumi abirhi kuhêka enyanya, ngasi balume bankanahêkaga emirasano. <verse eid="NUM 1:40"/><verse number="41" style="v" sid="NUM 1:41"/>Abaganjirwe omu bûko bwa Aseri, bahika omu bantu bihumbi makumi anni na ciguma na magana arhanu.<verse eid="NUM 1:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 1:42"/>Bene Nefutali, oku balondana n’oku emilala yâbo ekulikirana, omu kushimba enyumpa za bashakulûza bâbo, omu kuganja amazîno n’irhwe lya ngasi muguma, kurhenga oku muntu wa myâka makumi abirhi kuhêka enyanya, ngasi balume bankanahêkaga emirasano. <verse eid="NUM 1:42"/><verse number="43" style="v" sid="NUM 1:43"/>Abaganjirwe omu bûko bwa Nefutali, bahika omu bantu bihumbi makumi arhanu na bisharhu na magana anni.<verse eid="NUM 1:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 1:44"/>Bo baganjirwe abôla, bo Mûsa n’Aroni baganjaga abôla, boshi na balya baluzi ikumi na babirhi ba bene Israheli: muntu muguma muguma oku emilala yâbo enali. <verse eid="NUM 1:44"/><verse number="45" style="v" sid="NUM 1:45"/>Bene Israheli bàganjirwe boshi, omu kukulikira emilala ya bashakulûza bâbo na kurhenga oku muntu wa myâka makumi abirhi kuhêka enyanya, ngasi balume ba bene Israheli bankanahekaga emirasano. <verse eid="NUM 1:45"/><verse number="46" style="v" sid="NUM 1:46"/>Abaganjirwe boshi, omubalè gwâbo gwahika omu bantu bihumbi magana gali ndarhu na bisharhu na magana arhanu na makumi arhanu. <verse eid="NUM 1:46"/><verse number="47" style="v" sid="NUM 1:47"/>Bene Levi, oku milala yâbo ekulikirana, abôla barhaganjiragwa haguma n’abâbo<note caller="+" style="f"><char style="fr" closed="false">1, 47 </char><char style="ft" closed="false">Ab’omu mulala gwa Levi, kulya kubà barhali bashwêsirwe n’amarhegeko g’abasirika bôhe barhaganjagwa. Baganjwa kwâgo-kwâgo (Lolà ecigabi ca 3 n’eca 4). </char></note>.<verse eid="NUM 1:47"/></para>
  <para style="s1">Irhegeko lya Bene Levi</para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 1:48"/>Nyakasane anacishambâla na Mûsa amubwîra, erhi: <verse eid="NUM 1:48"/><verse number="49" style="v" sid="NUM 1:49"/>«Orhajiraga omubalè gwa bene Levi, orhanabaganjiraga haguma n’abandi bene Israheli. <verse eid="NUM 1:49"/><verse number="50" style="v" sid="NUM 1:50"/>“Ohè bene Levi ecikono c’okukazilanga omucîmba gw’amalaganyo, ebirugu byâgwo na ngasi bindi binabamwo byoshi. Bo bakazihêka ogwôla Mucimha n’ebirugu byamwo byoshi; bo bakazikola muligwo, banakazihanda eburhambi bw’ogwôla Mucimba”. <verse eid="NUM 1:50"/><verse number="51" style="v" sid="NUM 1:51"/>“Amango omucîmba gukola gwagenda, bene Levi bo bakazigugwikûla, n’amango gwamahanda, kandi bene Levi bo bakazigugwika, na owundi muntu orhali mwene Levi erhi ankaderha mpu agulirâna, anafè”. <verse eid="NUM 1:51"/><verse number="52" style="v" sid="NUM 1:52"/>“Bene Israheli bakazihanda ngasi baguma omu cihando câbo, hôfi n’ibendêra lyâbo, na nk’oku emirhwe yâbo y’abalwî enali”. <verse eid="NUM 1:52"/><verse number="53" style="v" sid="NUM 1:53"/>“Ci bene Levi bakazihanda hôfi n’omucîmba gw’Amalaganyo, lyo oburhè bulekija oku lubaga lwa bene Israheli, bene Levi bo bakazilanga omucîmba gw’Amalaganyo”».<verse eid="NUM 1:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="NUM 1:54"/>Bene Israheli banacijira nk’oku Nyakasane àli arhegesire Mûsa koshi. Bajira ntyo.<verse eid="NUM 1:54"/></para>
  <chapter eid="NUM 1"/>
  <chapter number="2" style="c" sid="NUM 2"/>
  <para style="s1">Oku emilala yakulikirana oku cihando</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 2:1"/>Nyakasane anacishambâla na Mûsa na Aroni, ababwîra, erhi: <verse eid="NUM 2:1"/><verse number="2" style="v" sid="NUM 2:2"/>«Bene Israheli ngasi baguma oku cihando banakazija ah’ibendêra lyâbo liri, ngasi mulala gwanakaziba n’ecimanyîso câgwo n’abà gulya mulala banacikulikira. Omu kuhanda bakazilola ngasi baguma ebw’ihêma ly’embugânano, bakaziliyûbaka eburhambi, balizongoloke».<verse eid="NUM 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 2:3"/>Bene Yûda bahanda ebuzûka-zûba boshi n’engabo yâbo y’abalwî. Omurhambo wa bene Yûda ye Nashoni, mwene Aminadabu. <verse eid="NUM 2:3"/><verse number="4" style="v" sid="NUM 2:4"/>Engabo y’abalwî bâge omu kulola balya bajiriragwa omubalè, bali bihumbi makumi gali nda na bini na magana gali ndarhu. <verse eid="NUM 2:4"/><verse number="5" style="v" sid="NUM 2:5"/>Omulala gwa Isakari gumukulikire, omurhambo wa bene Isakariye Natanaeli mwene Suari. <verse eid="NUM 2:5"/><verse number="6" style="v" sid="NUM 2:6"/>Engabo y’abalwî bâge omu kulola balya bajiriragwa omubalè, bali bihumbi makumi arhanu na bini na magana anni. <verse eid="NUM 2:6"/><verse number="7" style="v" sid="NUM 2:7"/>Bakuhîre bene Zabuloni. Omurhambo wa bene Zabuloni ye Eliyabu mwene Heloni. <verse eid="NUM 2:7"/><verse number="8" style="v" sid="NUM 2:8"/>Engabo y’abalwî bâge omu kulola balya bajiriragwa omubalè, bali bihumbi makumi arhanu na nda na bantu magana gali nda. <verse eid="NUM 2:8"/><verse number="9" style="v" sid="NUM 2:9"/>Boshi abâli oku cihando ca Yûda, omubalè gwâbo bihumbi igana na makumi gali munâni na ndarhu na bantu magana anni. Abôla bakazigenda embere.<verse eid="NUM 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 2:10"/>Bene Rubeni banahanda emukondwè, n’engabo yâbo y’abalwî; Omurhambo wa bene Rubeni ye Elisuri mwene Sedeuri. <verse eid="NUM 2:10"/><verse number="11" style="v" sid="NUM 2:11"/>Engabo y’abalwî bâge omu kulola balya bajiriragwa omubalè, bali bihumbi makumi anni na ndarhu na bantu magana arhanu. <verse eid="NUM 2:11"/><verse number="12" style="v" sid="NUM 2:12"/>Bene Simoni bahanda eburhambi bwâge. Omurhambo wa bene Simoni ye Shelumiyeli, mwene Surishadayi. <verse eid="NUM 2:12"/><verse number="13" style="v" sid="NUM 2:13"/>Engabo y’abalwî bâge, omu kulola balya bajiriragwa omubalè, bali bihumbi makumi arhanu na mwenda na bantu magana asharhu. <verse eid="NUM 2:13"/><verse number="14" style="v" sid="NUM 2:14"/>Bene Gadi bakulikîre. Omurhambo wa bene Gadi ye Eliasafi mwene Reweli. <verse eid="NUM 2:14"/><verse number="15" style="v" sid="NUM 2:15"/>Engabo y’abalwî bâge omu kulola balya bajiriragwa omubalè, bali bihumbi makumi anni na birhanu na bantu magana gali ndarhu na makumi arhanu. <verse eid="NUM 2:15"/><verse number="16" style="v" sid="NUM 2:16"/>Boshi abâli oku cihando ca Rubeni, omubalè gwâbo: bihumbi igana na makumi arhanu na ciguma na bantu magana anni na makumi arhanu. Abôla bakazigenda bwa kabirhi. <verse eid="NUM 2:16"/><verse number="17" style="v" sid="NUM 2:17"/>Kandi ihêma ly’e­ mbugânano lyanakulikira, na bene Levi banajà ekarhî k’ebindi bihando. Okwola bahanda kwo banakazikulikirana bakola bagenda, ngasi baguma oku mulongo gwâbo n’ibendêra lyâbo.<verse eid="NUM 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 2:18"/>Ebuzika-zûba eje ibendêra ly’Efrayimu n’engabo yâge. Omurhambo wa­ bo ye Elishamaʿ mwene Amiyudi. <verse eid="NUM 2:18"/><verse number="19" style="v" sid="NUM 2:19"/>Omurhwe gwâge nk’oku omubalè gwâbo gunali: bantu bihumbi makumi anni na magana arhanu. <verse eid="NUM 2:19"/><verse number="20" style="v" sid="NUM 2:20"/>Omulala gwa Menashè gubaje eburhambi. Omurhambo wâbo ye Gamalieli mwene Pedasuri. <verse eid="NUM 2:20"/><verse number="21" style="v" sid="NUM 2:21"/>Omurhwe gwâge nk’oku omubalè gwâbo gunali: bantu bihumbi makumi asharhu na bihirhi na magana abirhi. <verse eid="NUM 2:21"/><verse number="22" style="v" sid="NUM 2:22"/>Bene Benyamini bakuhebe. Omurhambo wa bene Benyamini ye Abidani mugala wa Gedeoni. <verse eid="NUM 2:22"/><verse number="23" style="v" sid="NUM 2:23"/>Omurhwe gwâge nk’oku omubalè gwâbo gunali: bantu bihumbi makumi asharhu na birhanu na magana anni. <verse eid="NUM 2:23"/><verse number="24" style="v" sid="NUM 2:24"/>Boshi abâli oku cihando ca Efrayimu, omubalè gwâbo bihumbi igana na munâni na bantu igana, nk’oku emirhwe yâbo enali. Abôla bakazigenda ba kasharhu.<verse eid="NUM 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 2:25"/>Emwênè eje ibendêra lya Dani n’engabo yâge. Omurhambo wâbo ye Ahiyezeri mugala wa Amishadayi. <verse eid="NUM 2:25"/><verse number="26" style="v" sid="NUM 2:26"/>N’omurhwe gwâge nk’oku omubalè gunali: bantu bihumbi makumi gali ndarhu na bibirhi na magana gali nda. <verse eid="NUM 2:26"/><verse number="27" style="v" sid="NUM 2:27"/>Omulala gw’Aseri gumuje eburhambi, omurhambo wa bene Aseri ye Pagieli, mwene Okrani. <verse eid="NUM 2:27"/><verse number="28" style="v" sid="NUM 2:28"/>Omurhwe gwâge nk’oku omubalè gunali: bantu bihumbi makumi anni na ciguma na magana arhanu. <verse eid="NUM 2:28"/><verse number="29" style="v" sid="NUM 2:29"/>Kandi bene Nefutali bakulikîre. Omurhambo wa bene Nefutali ye Ahira mwene Enani. <verse eid="NUM 2:29"/><verse number="30" style="v" sid="NUM 2:30"/>Omurhwe gwâge nk’oku omubalè gwâbo gunali: bantu bihumbi makumi arhanu na bisharhu na magana anni. <verse eid="NUM 2:30"/><verse number="31" style="v" sid="NUM 2:31"/>Boshi abaganjirwe omu cihando ca Dani, omubalè gwâbo bali bihumbi igana na makumi arhanu na nda na magana gali ndarhu. Bakazigenda ba buzinda, banakulikire ibendêra lyâbo.<verse eid="NUM 2:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 2:32"/>Gwo mubalè gwa bene Israheli ogwôla, omu kukulikira emilala ya bashakulûza bâbo. Omubalè gw’abaganjirwe boshi nk’oku emirhwe yâbo enali, bali bantu bihumbi magana gali ndarhu na bisharhu na magana arhanu na makumi arhanu. <verse eid="NUM 2:32"/><verse number="33" style="v" sid="NUM 2:33"/>Bene Levi barhaganjiragwa muli eyôla mirhwe ya bene Israheli, nk’oku Nyakasane anarhegekaga Mûsa.<verse eid="NUM 2:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 2:34"/>Bene Israheli banacijira nk’oku Nyakasane anali arhegesire Mûsa koshi. Kwo bakazâgihanda ntyo ngasi baguma n’ibendêra lyâbo, kwo banakazâgigenda ntyôla, ngasi baguma omu mulala gwâbo omu kukulikira emilala ya bashakulûza bâbo.<verse eid="NUM 2:34"/></para>
  <chapter eid="NUM 2"/>
  <chapter number="3" style="c" sid="NUM 3"/>
  <para style="s1">Omubalè gwa Bene Levi n’omukolo gwâbo</para>
  <para style="iex">A. Abadâhwa</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 3:1"/>Alaga obûko bw’Aroni n’obwa Mûsa amango Nyakasane ashambâzagya Mûsa oku ntondo ya Sînayi. <verse eid="NUM 3:1"/><verse number="2" style="v" sid="NUM 3:2"/>Alaga amazîno ga bene Aroni: Nadabu lwo lubere lwâge, Abihu, Eleazari na Itamara. <verse eid="NUM 3:2"/><verse number="3" style="v" sid="NUM 3:3"/>Go mazîno ga bene Aroni agôla, bo babumbagwa amaboko mavurha lyo bahâbwa ecikono c’obudâhwa. <verse eid="NUM 3:3"/><verse number="4" style="v" sid="NUM 3:4"/>Nadabu n’Abihu bo bafiraga embere za Nyakasane, amango bacishomagya mpu barherekêra Nyakasane enshangi erhakwânîni oku ntondo ya Sînayi; barhàli baciburha bâna. Eleazari na Itamara bahâbwa obudâhwa embere z’Aroni, îshe wâbo.<verse eid="NUM 3:4"/></para>
  <para style="iex">B. Bene Levi n’omukolo gwâbo</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 3:5"/>Nyakasane ashambâza Mûsa, amubwîra, erhi: <verse eid="NUM 3:5"/><verse number="6" style="v" sid="NUM 3:6"/>«Yegeza bene Levi ahâla, obahire embere z’omudâhwa Aroni, bakazimukolera. <verse eid="NUM 3:6"/><verse number="7" style="v" sid="NUM 3:7"/>Bo bakazijira emikolo Aroni n’olubaga bagwâsirwe okujira ah’ihêma ly’embugânano na ntyo banakazijira emikolo y’omu Mucîmba. <verse eid="NUM 3:7"/><verse number="8" style="v" sid="NUM 3:8"/>Bakazikombêra ebirugu byoshi by’omu ihêma ly’embugânano na ngasi hindi hyoshi bene Israheli bagwâsirwe okujira omu Mucîmba. <verse eid="NUM 3:8"/><verse number="9" style="v" sid="NUM 3:9"/>Abaleviti obahè Aroni n’abagala. Babè bâge loshi omu bene Israheli boshi. <verse eid="NUM 3:9"/><verse number="10" style="v" sid="NUM 3:10"/>Wayîmika Aroni n’abagala omu mikolo y’obudâhwa; owundi w’embuga wankacîshomya mpu ayêgera ahantu himâna anahâbwe obuhane bw’okufà.»<verse eid="NUM 3:10"/></para>
  <para style="iex">C. Okucîshogwa kwâbo</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 3:11"/>Nyakasane anacishambâla bona Mûsa, amubwîra, erhi: <verse eid="NUM 3:11"/><verse number="12" style="v" sid="NUM 3:12"/>«Lolà oku bene Levi mbayansire omu karhî ka bene Israheli, ahâli h’abâna b’enfula, balya bâna b’olubere ba bene Israheli; abôla Baleviti babà ntyo bâni. <verse eid="NUM 3:12"/><verse number="13" style="v" sid="NUM 3:13"/>Bulya ngasi wa lubere yêshi erhi anali wâni: lulya lusiku nahungumulagamwo ngasi wa bûko lubere omu Mîsiri go mango nacîhâga ngasi wa bûko lubere omu Israheli: abè wa muntu, abè wa cintu, byoshi bikola bibà byâni. Nie Nyakasane.»<verse eid="NUM 3:13"/></para>
  <para style="iex">D. Omubalè</para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 3:14"/>Nyakasane ashambâla na Mûsa omu irungu ly’entondo ya Sînayi amubwîra, erhi: <verse eid="NUM 3:14"/><verse number="15" style="v" sid="NUM 3:15"/>«Ojire omubalè gwa bene Levi nk’oku emilala ya bashakulûza bâbo enagenzire na nk’oku emilala yâbo bône enali. Ojire omubalè gwa ngasi wa bûko mulume yêshi kurhenga oku mwâna wa mwêzi muguma kuhêka enyanya.» <verse eid="NUM 3:15"/><verse number="16" style="v" sid="NUM 3:16"/>Mûsa ajira omubalè gwâbo oku irhegeko lya Nyakasane, nk’oku anamurhegekaga. <verse eid="NUM 3:16"/><verse number="17" style="v" sid="NUM 3:17"/>Alaga bene Levi nk’oku amazîno gâbo ganali: Gershoni, Kehati na Merari. <verse eid="NUM 3:17"/><verse number="18" style="v" sid="NUM 3:18"/>Alaga amazîno ga bene Gershoni nk’oku emilala yâbo enali: Libni na Shimeyi. <verse eid="NUM 3:18"/><verse number="19" style="v" sid="NUM 3:19"/>Bene Kehati nk’oku emilala yâbo enali: Amrami, Yisari, Hebroni na Uzieli. <verse eid="NUM 3:19"/><verse number="20" style="v" sid="NUM 3:20"/>Bene Merari, nk’oku emilala yâbo enali: Mahali na Mushi. Bwo bûko bwa Levi obwôla nk’oku emilala ya bashakulûza bâbo enagenzire.<verse eid="NUM 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 3:21"/>Gershoni ye shakulu w’omulala gwa Libni Shimeyi. Baderha mpu milala ya Banya-Gershoni. <verse eid="NUM 3:21"/><verse number="22" style="v" sid="NUM 3:22"/>Omubalè gwâbo omu kuganja abalume boshi kurhenga owa mwêzi muguma kuhêka enyanya, bahika omu bantu bihumbi nda na magana arhanu. <verse eid="NUM 3:22"/><verse number="23" style="v" sid="NUM 3:23"/>Emilala y’Abanya-Gershoni yakazâgihanda enyuma ly’Omucîmba olunda lw’ebuzika-zûba. <verse eid="NUM 3:23"/><verse number="24" style="v" sid="NUM 3:24"/>Omurhambo w’omulala gw’Abanya-Gershoni ye wali Eliyasafu, mwene Layeli. <verse eid="NUM 3:24"/><verse number="25" style="v" sid="NUM 3:25"/>Oku biyêrekîre ihêma ly’embugânano, bene Gershoni bàli bagwêrhe omukolo gw’Omucîmba n’ogw’ihêma, ogw’enshoho yalyo, akacikirizo kàli aha muhango gw’ihêma ly’embugânano. <verse eid="NUM 3:25"/><verse number="26" style="v" sid="NUM 3:26"/>Bàlibagwêrhe omukolo gw’oku birhebo by’omu bululi, oku mushangi gw’aha muhango gw’obululi, oku burhambi bw’Omucîmba koshi n’oku luhêrero n’oku migozi yalo yoshi.<verse eid="NUM 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 3:27"/>Bene Kehati bàli: omulala gw’Abanyamrami, omulala gw’Abayesehari, omulala gw’Abahebroni n’omulala gw’Abaaziyeli. Yo milala ya bene Kehati eyôla. <verse eid="NUM 3:27"/><verse number="28" style="v" sid="NUM 3:28"/>Omu kuganja abalume boshi kurhenga owa mwêzi muguma kujà enyanya, bahika omu bantu bihumbi munâni na magana gali ndarhu; omukolo gwâbo kulanga Ahatagatîfu. <verse eid="NUM 3:28"/><verse number="29" style="v" sid="NUM 3:29"/>Emilala ya bene Kehati yakazâgihanda olunda lw’emukondwè gw’Omucîmba. <verse eid="NUM 3:29"/><verse number="30" style="v" sid="NUM 3:30"/>Omurhambo w’emilala ya bene Kehati ye wali Elisafani, mwene Uzieli. <verse eid="NUM 3:30"/><verse number="31" style="v" sid="NUM 3:31"/>Bo balibagwâsirwe okukazikola oku Mucîmba gw’amalaganyo, oku luhêrero lw’enterekêro, okw’itara n’oku zindi mpêrero zoshi, oku rhundi rhulugu rhw’ahatagatîfu rhulya rhunakolamwo rhwoshi, omwenda na ngasi binaguyêrekera byoshi. <verse eid="NUM 3:31"/><verse number="32" style="v" sid="NUM 3:32"/>Omurhamho w’abarhambo b’abaleviti ye wali Eleazari mwene omudâhwa Aroni, ye wakazagiyimangira abàli bagwêrhe emikolo y’Ahimâma.<verse eid="NUM 3:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 3:33"/>Bene Merari bàli: emilala y’abanya-Mahali, n’emilala ya bene Mushi: yo milala ya bene Merari eyôla. <verse eid="NUM 3:33"/><verse number="34" style="v" sid="NUM 3:34"/>Omubalè gwâbo kurhenga oku mwâna-rhabana wa mwêzi muguma kuhêka enyanya bali bihumbi ndarhu na magana abirhi. <verse eid="NUM 3:34"/><verse number="35" style="v" sid="NUM 3:35"/>Omurhambo w’emilala ya bene Merari ye wali Surieli, mwene Abihayili. Bakazâgihanda olunda lw’emwênè y’Omucîmba. <verse eid="NUM 3:35"/><verse number="36" style="v" sid="NUM 3:36"/>Abanyamerari bo bakazikola oku lukanga lw’Endâro, emirhamba n’emitungo yayo, kuguma n’emifûniko y’amarhwerhwe na ngasi rhulugu rhwa kuli eyôla ndâro, <verse eid="NUM 3:36"/><verse number="37" style="v" sid="NUM 3:37"/>emitungo y’omu marhambi goshi goshi g’obululi, amarhwerhwe gâyo n’emigozi yago. <verse eid="NUM 3:37"/><verse number="38" style="v" sid="NUM 3:38"/>Aha mbêre z’Endâro, olunda lw’ebuzûka-zûba, embere z’ihêma ly’embugânano, yo Mûsa n’Aroni n’abagala hahandaga; bali bagwêrhe omukolo gw’okulanga ahimâna, oku mikolo yanalieyêrekîre bene Israheli. Owundi w’embuga wankadesire mpu ayegere ahôla aliagwâsirwe ahâbwe obuhane bw’okufà. <verse eid="NUM 3:38"/><verse number="39" style="v" sid="NUM 3:39"/>Bene Levi baganjagwa na Mûsa haguma n’Aroni oku irhegeko lya Nyakasane, omu kukulikira emilala yâbo, n’omu kuganja abalume kurhenga oku mwânarhabana wa mwêzi muguma kuhêka enyanya, bali bihumbi makumi abirhi na bibirhi.<verse eid="NUM 3:39"/></para>
  <para style="iex">E. Bene Levi n’okugombôlwa kw’ebiburhwa mbêre</para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 3:40"/>Nyakasane anacibwîra Mûsa, erhi: «Ojire omubalè gwa ngasi lubere lwa mwânarhabana omu Israheli, kurhenga oku wa mwêzi muguma kuhêka enyanya, obaganje ngasi muntu n’izîno lyâge. <verse eid="NUM 3:40"/><verse number="41" style="v" sid="NUM 3:41"/>Orhôle Abaleviti babè bâni, nie Nyakasane, ahâli h’abâna baburhwambere boshi ba bene Israheli; ebishwêkwa by’Abaleviti ahâli h’ebishwêkwa biburhwa-mbêre bya bene Israheli.» <verse eid="NUM 3:41"/><verse number="42" style="v" sid="NUM 3:42"/>Mûsa ajira omubalè gw’abâna b’olubere boshi b’omu Israheli, nk’oku Nyakasane anamurhegekaga. <verse eid="NUM 3:42"/><verse number="43" style="v" sid="NUM 3:43"/>Abânarhabana b’olubere baganjirwe ngasi maguma n’izîno lyâge kurhenga oku mwâna wa mwêzi muguma kuhêka enyanya, bahika omu bihumbi makumi abirhi na bibirhi na magana abirhi na makumi gali nda na basharhu.<verse eid="NUM 3:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 3:44"/>Nyakasane ashambâza Mûsa amubwîra, erhi: <verse eid="NUM 3:44"/><verse number="45" style="v" sid="NUM 3:45"/>Orhôle bene Levi ahâli h’abâna b’olubere ba bene Israheli, n’ebishwêkwa bya bene Levi ahâli h’ebishwêkwa byâbo. Bene Levi babà bâni niene. Nie Nyakasane. <verse eid="NUM 3:45"/><verse number="46" style="v" sid="NUM 3:46"/>Omu kugombôlabalya magana abirhi na makumi gali nda na basharhu balushire omubalè gwa bene Levi. <verse eid="NUM 3:46"/><verse number="47" style="v" sid="NUM 3:47"/>Orhôle sikêli irhanu oku ngasi irhwe lya muntu, wakaziyigerera oku sikêli omu ka-Nyamuzinda, eri ya gêra makumi abirhi. <verse eid="NUM 3:47"/><verse number="48" style="v" sid="NUM 3:48"/>Ezôla nfaranga ozihe Aroni n’abagala, ziri za kugombôla balya barhalusire omubalè gwa bene Levi. <verse eid="NUM 3:48"/><verse number="49" style="v" sid="NUM 3:49"/>Mûsa arhôla zirya nfaranga zagombôlaga balya b’olubere bagombôlagwa na bene Levi. <verse eid="NUM 3:49"/><verse number="50" style="v" sid="NUM 3:50"/>Arhôla enfaranga z’oku bâna b’olubere ba bene Israheli, zàli cihumbi na magana asharhu na sikêli makumi galindarhu n’irhanu, omu kukulikira erya sikêli y’omu ka-Nyamuzinda. <verse eid="NUM 3:50"/><verse number="51" style="v" sid="NUM 3:51"/>Mûsa anacihà Aroni n’abagala zirya nfaranga z’okugombôla, okw’irhegeko lya Nyakasane nk’oku Nyakasane anali arhegesire Mûsa.<verse eid="NUM 3:51"/></para>
  <chapter eid="NUM 3"/>
  <chapter number="4" style="c" sid="NUM 4"/>
  <para style="s1">Bene Levi n’emikolo yâbo</para>
  <para style="iex">A. Bene Kehati</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 4:1"/>Nyakasane anacishambâza Mûsa n’Aroni ederha, erhi: <verse eid="NUM 4:1"/><verse number="2" style="v" sid="NUM 4:2"/>«Oganje bene Kehati omu bene Levi, obaganje nk’oku emilala yâbo n’obûko bwâbo bikulikirine, oku bashakulûza bâbo banali, <verse eid="NUM 4:2"/><verse number="3" style="v" sid="NUM 4:3"/>kurhenga owa myâka makumi asharhu kuhêke enyanya oku myâka makumi arhanu, ngasi boshi banajira omukolo omw’ihêma ly’embugânano omu kujiramwo bushanja bulebe, omwôla ihêma ly’embugânano. <verse eid="NUM 4:3"/><verse number="4" style="v" sid="NUM 4:4"/>Alaga omukolo gwa bene Kehati omw’ihêma ly’embugânano: kwabà kukola oku bintu bimâna bwenêne. <verse eid="NUM 4:4"/><verse number="5" style="v" sid="NUM 4:5"/>Nka bakola barhenga oku cihando, Aroni haguma n’abagala banayisha bayandagaze omwenda, banafunikamwo omucîmba gw’amalaganyo<note caller="+" style="f"><char style="fr" closed="false">4, 5 </char><char style="ft" closed="false">Abadâhwa bône bayêmêrîrwe okuyegêra ebirugu bimâna. Kwàli hanzîbwe oku Bene Levi irhondo barhahîraga bakahuma erhi ciru kulâla oku birugu bimâna (Rhulole omu <char style="xt"><ref loc="NUM 4:15-20">Mib 4, 15-20</ref></char>).</char></note>. <verse eid="NUM 4:5"/><verse number="6" style="v" sid="NUM 4:6"/>Oku nyanya, banabwikira kwo n’omufûniko gw’oluhù lw’ecigoho, kandi banalambûlirakwo omushangi mugumagumà gwa kaduku ka mukara, kandi banashesheza emirhamba y’Omucîmba. <verse eid="NUM 4:6"/><verse number="7" style="v" sid="NUM 4:7"/>Banalambûlira omushangi gw’akaduku oku mêza g’emigati y’enterekêro. Oku nyanya banahirakwo enambi, orhubêhè, engombo, ebikombe by’okukalabira; n’omugati gwa ngasi mango gwanaja oku nyanya lyâgo. <verse eid="NUM 4:7"/><verse number="8" style="v" sid="NUM 4:8"/>Oku nyanya banalambûlirakwo omushangi gw’akalinga konene, kandi banafunikira n’ecifûniko c’oluhù lw’ecigoho, na buzinda bw’ahôla banashesheza emirhamba y’ameza. <verse eid="NUM 4:8"/><verse number="9" style="v" sid="NUM 4:9"/>Banarhôla omushangi gw’akaduku k’omukara banabwîkiramwo ecinâra, kuguma n’amatara gâco, orhusahani rhwâco, orhulugu rhw’okugukira oluvù, enjebe zâco, birya by’obulagîrire oku mukolo gwâco, <verse eid="NUM 4:9"/><verse number="10" style="v" sid="NUM 4:10"/>Hano babà bamaboha ecôla cinâra, kuguma n’orhumole rhwâco, banacihira oku luhù luvunge lulukire oku mirhamba y’okubarhulira. <verse eid="NUM 4:10"/><verse number="11" style="v" sid="NUM 4:11"/>Banalambûlira omushangi gw’akaduku k’omukara oku luhêrero lw’amasholo, kandi banabwikira n’ecifûniko c’oluhù lw’ecigoho, banashesheza n’emirhamba. <verse eid="NUM 4:11"/><verse number="12" style="v" sid="NUM 4:12"/>Banarhôla ebirugu byoshi bikolêsibwa oku mikolo y’ahantu himâna, hano babà bamabiboha omu mushangi gw’akaduku k’omukara, banabibwîkira n’omufûniko gw’oluhù lw’ecigoho, kandi banabihira oku cibarhuliro. <verse eid="NUM 4:12"/><verse number="13" style="v" sid="NUM 4:13"/>Banarhenza oluvù oku luhêrero, kandi banalambûlirakwo omushangi gw’akalinga. <verse eid="NUM 4:13"/><verse number="14" style="v" sid="NUM 4:14"/>Banahira oku nyanya birya birugu binakola kuli lwo byoshi, ebitumbûkizo amakala, amakanya, empaho, enyôgero, ebirugu byoshi by’oku luhêrero na hano babà bamalambûlira kuli byo byoshi omufûniko gw’oluhù lw’ecigoho, banahirakwo emirhamba. <verse eid="NUM 4:14"/><verse number="15" style="v" sid="NUM 4:15"/>Hano Aroni n’abagala bayûsa okubwîkira ahimâna n’ebirugu byamwo byoshi, na hano babà bamayimuka bakola bagenda, bene Kehati banayisha okubibarhula, ci barhahumaga oku bintu bimâna lyo balekifià. Byo bene Kehati bakazihêka ebyo omw’Ihêma ly’embugânano. <verse eid="NUM 4:15"/><verse number="16" style="v" sid="NUM 4:16"/>Eleazari, mwene Aroni, omudâhwa, âbà n’omukolo gw’okukazilanga amavurha g’ecinâra, obukù bw’akisûnunu kinjà, eby’enterekêro ya ngasi mango, n’amavurha g’okushîga. Abà n’omukolo gw’okukazilanga Endâro yoshi, n’ebibâmwo byoshi, omu bimâna n’ebirugu byamwo.» <verse eid="NUM 4:16"/><verse number="17" style="v" sid="NUM 4:17"/>Nyakasane ashambâla na Mûsa n’Aroni, aderha, erhi: <verse eid="NUM 4:17"/><verse number="18" style="v" sid="NUM 4:18"/>«Oshîbirire okuhira ishanja ly’emilala ya bene Kehati hagohago omu bandi bene Levi. <verse eid="NUM 4:18"/><verse number="19" style="v" sid="NUM 4:19"/>Mubajirire ntyo lyo balama balekifa amango bankayegêra ebirugu bimâna bwenêne. <verse eid="NUM 4:19"/><verse number="20" style="v" sid="NUM 4:20"/>Aroni n’abagala banakaziyisha, banayêreka ngasi muguma mulibo omukolo gwâge n’ebi agwâsirwe okubarhula.»<verse eid="NUM 4:20"/></para>
  <para style="iex">B. Bene Gershoni</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 4:21"/>Nyakasane abwîra Mûsa, erhi: <verse eid="NUM 4:21"/><verse number="22" style="v" sid="NUM 4:22"/>«Oganje na bene Gershoni omu kushimba enyumpa za bashakulûza bâbo, oku emilala yâbo egenda. <verse eid="NUM 4:22"/><verse number="23" style="v" sid="NUM 4:23"/>Ojire omubalè gwâbo, kurhenga oku muntu wa myâka makumi asharhu kuhêka enyanya, muli balya banagwâsirwe okujira mukolo mulebe omw’ihêma ly’embugânano. <verse eid="NUM 4:23"/><verse number="24" style="v" sid="NUM 4:24"/>Alaga emikolo y’emilala ya bene Gershoni, ebi bakazijira n’ebi bakazibarhula. <verse eid="NUM 4:24"/><verse number="25" style="v" sid="NUM 4:25"/>Bakazihêka emikango y’Endâro n’ey’ihêma ly’embugânano. <verse eid="NUM 4:25"/><verse number="26" style="v" sid="NUM 4:26"/>Bakazihêka emikango y’obululi n’omushangi gubwîkira omuhango gw’obululi omu marhambi g’Endâro mwoshi, ey’oluhêrero n’emigozi yayo, kuguma n’ebirugu bikola eyôla, na kandi bo bakazijira emikolo enayêrekîre ebyôla byoshi. <verse eid="NUM 4:26"/><verse number="27" style="v" sid="NUM 4:27"/>Emikolo bene Gershoni bakajira yoshi Aroni n’abagala bo bakaziyilola, ebi bagwâsirwe okubarhula n’ebi bagwâsirwe okujira. Mukabalangisa ngasi birugu banagwâsirwe okubarhula. <verse eid="NUM 4:27"/><verse number="28" style="v" sid="NUM 4:28"/>Gwo mukolo gwa bene Gershoni ogwôla omu ihêma ly’embugânano muli ogôla mukolo. Itamara mwene omudâhwa Aroni ye wakazibalola.»<verse eid="NUM 4:28"/></para>
  <para style="iex">C. Bene Merari</para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 4:29"/>«Oganje bene Merari, oku obûko bwâbo n’emilala ya bashakulûza bâbo enali. <verse eid="NUM 4:29"/><verse number="30" style="v" sid="NUM 4:30"/>Obaganje kurhenga oku mulume wa myâka makumi asharhu, kuhêka enyanya, oku myâka makumi arhanu, abankahashiyûkiriza omukolo bahîrwe omw’ihêma ly’embugânano. <verse eid="NUM 4:30"/><verse number="31" style="v" sid="NUM 4:31"/>Yumvagya emikolo wakazibahà: ebi bakazibarhula banakazibikolakwo omw’ihêma ly’embugânano: Oburhungiri bw’Endâro, emirhamba, emitungo n’amarhwerhwe gâyo. <verse eid="NUM 4:31"/><verse number="32" style="v" sid="NUM 4:32"/>Bakazihêka n’emitungo ezungulusire obululi, amarhwerhwe gâyo, emigozi, ebirugu byamwo n’emikolo ebiyêrekîre. Mukaziganja bwinjà ebyôla birugu bagwâsirwe okubarhula ngasi ciguma cimanyirirwe n’izîno lyâco muli ebyôla birugu babahîre okubarhula. <verse eid="NUM 4:32"/><verse number="33" style="v" sid="NUM 4:33"/>Go mukolo gwa bene Merari ogwôla, go mukolo gwâbo omu ihêma ly’embugânano<note caller="+" style="f"><char style="fr" closed="false">4, 33 </char><char style="fqa" closed="false">Ihêma ly’Embugânano, gwàli mukolo gwa Ben Merari mugala wa Levi</char><char style="ft" closed="false">.</char></note>, omurhambo wakazibalola ye Itamara mwene Aroni, omudâhwa.»<verse eid="NUM 4:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 4:34"/>Mûsa, Aroni n’abarhambo baganja<note caller="+" style="f"><char style="fr" closed="false">4, 34 </char><char style="ft" closed="false">Ogu gwo mubalè gwa kabirhi gwa Bene Levi, gushushire bwenêne omubalè gw’Israheli yêshi (cigabi ca 1). Omubalè murhanzi (<char style="xt"><ref loc="NUM 3:15-39">Mib 3, 15-39</ref></char>) guli gwa bundi bwôrhere. </char></note> bene Kehati nk’oku obûko n’emilala ya bashakulûza bâbo enali. <verse eid="NUM 4:34"/><verse number="35" style="v" sid="NUM 4:35"/>Muganje kurhenga owa makumi asharhu kuhêka enyanya oku wa myâka makumi arhanu, balya bankahashiyûkiriza omukolo bahîrwe omu Ihêma ly’embugânano. <verse eid="NUM 4:35"/><verse number="36" style="v" sid="NUM 4:36"/>Abaganjirwe omu milala yâbo bahika oku balume bihumbi bibirhi na magana gali nda na makumi arhanu. <verse eid="NUM 4:36"/><verse number="37" style="v" sid="NUM 4:37"/>Bo baganjirwe b’omu bûko bwa Kehati abôla, bo bakazikola omu Ihêma ly’embugânano, Mûsa n’Aroni babajirira omubalè nk’oku Nyakasane anarhegekaga Mûsa.<verse eid="NUM 4:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 4:38"/>Abaganjirwe b’omu bûko bwa Gershoni, nk’oku emilala yâbo n’enyumpa za bashakulûza bâbo zinali; <verse eid="NUM 4:38"/><verse number="39" style="v" sid="NUM 4:39"/>kurhenga oku wa myâka makumi asharhu kuhêka enyanya oku wa myâka makumi arhanu, balya boshi bankanahashiyûkiriza omukolo bahîrwe omw’Ihêma ly’embugânano. <verse eid="NUM 4:39"/><verse number="40" style="v" sid="NUM 4:40"/>Abaganjirwe boshi omu kukulikira obûko na nk’oku emilala ya bashakulûza bâbo enagenda bahika omu balume bihumbi bibirhi na magana gali ndarhu na makumi asharhu. <verse eid="NUM 4:40"/><verse number="41" style="v" sid="NUM 4:41"/>Bo bajirirwe omubalè abôla omu milala ya bene Gershoni, balya boshi banakazâgijira mukolo mulebe omw’Ihêma ly’embugânano. Mûsa na Aroni babajirira omubalè oku irhegeko lya Nyakasane.<verse eid="NUM 4:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 4:42"/>Abaganjirwe b’omu milala ya bene Merari, omu kushimba obûko na nk’oku emilala ya bashakulûza bâbo ekulikirîne. <verse eid="NUM 4:42"/><verse number="43" style="v" sid="NUM 4:43"/>Kurhenga oku wa myâka makumi asharhu kuhêka enyanya oku wa myâka makumi arhanu, balya bankanahashiyûkiriza omukolo bahîrwe omw’Ihêma ly’embugânano. <verse eid="NUM 4:43"/><verse number="44" style="v" sid="NUM 4:44"/>Abaganjirwe boshi omu kukulikira emilala yâbo, bahika oku balume bihumbi bisharhu na bantu magana abirhi. <verse eid="NUM 4:44"/><verse number="45" style="v" sid="NUM 4:45"/>Bo baganjirwe abôla omu milala ya bene Merari bo Mûsa n’Aroni baganjaga abôla oku irhegeko Nyakasane ahâga Mûsa.<verse eid="NUM 4:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="NUM 4:46"/>Bene Levi, abaganjirwe na Mûsa bo n’Aroni haguma n’abarhambo ba bene Israheli; oku obûko n’emilala ya bashakulûza bâbo ekulikirîne, <verse eid="NUM 4:46"/><verse number="47" style="v" sid="NUM 4:47"/>kurhenga oku wa myâka makumi asharhu kuhêka oku myâka makumi arhanu, boshi abakazagikola n’okubarhula omw’lhêma ly’embugânano. <verse eid="NUM 4:47"/><verse number="48" style="v" sid="NUM 4:48"/>Abaganjirwe boshi bahika omu bihumbi munâni na magana arhanu na makumi gali munâni. <verse eid="NUM 4:48"/><verse number="49" style="v" sid="NUM 4:49"/>Babajirira omubalè nk’oku Nyakasane anarhegekaga Mûsa, omu kukazihà ngasi muguma omukolo ali agwâsirwe ajire n’ebi ali agwâsirwe okubarhula. Kwo bajirirwe omubalè ntyo nk’oku Nyakasane anarhegekaga Mûsa.<verse eid="NUM 4:49"/></para>
  <chapter eid="NUM 4"/>
  <chapter number="5" style="c" sid="NUM 5"/>
  <para style="ms1">II. Amarhegeko ga ngasi lubero</para>
  <para style="s1">Abantu bagalugalu bagwâsirwe okurhenga oku cihando</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 5:1"/>Nyakasane anacibwîra Mûsa, erhi: <verse eid="NUM 5:1"/><verse number="2" style="v" sid="NUM 5:2"/>Orhegeke bene Israheli omu cihando câbo bakazihulusa ngasi wa lushomyo, ngasi wa bibenzi na ngasi yêshi oli mugalugalu erhi mufù gurhuma. <verse eid="NUM 5:2"/><verse number="3" style="v" sid="NUM 5:3"/>Abè mulume abè mukazi, boshi kukwânîne obalibirhekwo omu cihando, balekihemula ecihando câbo, ecôla cihando ndimo ekarhî kâbo. <verse eid="NUM 5:3"/><verse number="4" style="v" sid="NUM 5:4"/>Bene Israheli banacijira kulya bakazihulusa omu cihando balya Nyakasane anarhegekaga Mûsa boshi, banacijira ntyo bene Israheli.<verse eid="NUM 5:4"/></para>
  <para style="s1">Okubabalirana</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 5:5"/>Nyakasane anacibwîra Mûsa, erhi: <verse eid="NUM 5:5"/><verse number="6" style="v" sid="NUM 5:6"/>Obwîre bene Israheli. Erhi hankajira muguma, abè mulume abè mukazi wajira câha cirebe muli birya bibabaza omulungu<note caller="+" style="f"><char style="fr" closed="false">5, 6 </char><char style="ft" closed="false">Ecâha cibabaza omulungu omu kugomera Nyakasane, kuli kulenganya omuntu. Omu kalamo k’abantu, Nyakasane yêne ye nshôko y’obushinganyanya. Amango goshi, okuvuna eryo irhegeko kumugayisa. Okushuza oku izù lya Nnâmahanga gugerera omu kulama bwinjà n’abandi; okuderha mpu olola eb’idini arhakaderha ebiyêrekîre politiki, kubà kuyungunganya kw’abazidohire olubaga barhanalonza bahanûlwe. Oku marhegeko ikumi ga Bibliya muli nda eyêrekîre okulama n’abandi bantu, yo porotiki eyo: omulala, ecinyabuguma, emikolo, okukenga ehya bene (Lush 5).</char></note>, omu kugomera Nyakasane, na ntyo yêne acîjire mubî. <verse eid="NUM 5:6"/><verse number="7" style="v" sid="NUM 5:7"/>Oyo muntu anahungame ecâha câge, abulinagalulira mwene wâbo hirya anamubabazagyakwo, anayûshûlekwo ecigabi ca karhanu, anacihà olya anajiriraga kubî. <verse eid="NUM 5:7"/><verse number="8" style="v" sid="NUM 5:8"/>Akabà olya nyakunyagwa arhagwêrhi owayîmire omu byâge, olya bankahashigalulira kalya kantu kanyagagwa, kalya kantu banakagalulira Nyakasane, bakahe omudâhwa, ci kwônene buzira kuleka cirya cibuzi c’engandabuzi c’okuhyûla cirya bahyûlira olya nna obubî.<verse eid="NUM 5:8"/></para>
  <para style="s1">Ecigabi c’omudâhwa</para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 5:9"/>Bulya kuli ngasi kantu koshi k’enterekêro Bene Israheli balerheraga omudâhwa, oyo mudâhwa ayêmêrîrwe okurhôlakwo ecâge cigabi. <verse eid="NUM 5:9"/><verse number="10" style="v" sid="NUM 5:10"/>Ebi omuntu ankanarhûla byoshi erhi n’omu maboko g’omudâhwa binali, na ngasi ebi muntu lebè ankahà omudâhwa erhi binali by’olya mudâhwa.<verse eid="NUM 5:10"/></para>
  <para style="s1">Omujina</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 5:11"/>Nyakasane anacibwîra Mûsa, erhi: «Ogendidesa bene Israheli, obabwîre, erhi: <verse eid="NUM 5:11"/><verse number="12" style="v" sid="NUM 5:12"/>“Omukazi ogwêrhe ibà erhi ankabà mubamba na ntyo amuhemukire”, <verse eid="NUM 5:12"/><verse number="13" style="v" sid="NUM 5:13"/>“bulya amagenda boshi n’owundi mulume, n’okwôla kurhamanyikini emunda ibà ali, oyo mukazi ocîhemwîre ntyôla bufundafunda, buzira kubà na owankahashimushobeka na erhi akabà ntâye wamugwasire masi masi”. <verse eid="NUM 5:13"/><verse number="14" style="v" sid="NUM 5:14"/>“Erhi nya­mulume akabà n’omujina kuli mukâge, nka na nyamukazi amuhemukire, kandi erhi ankabona omujina kuli mukâge ci kwônene nyamukazi arhamuhemukiraga”, <verse eid="NUM 5:14"/><verse number="15" style="v" sid="NUM 5:15"/>“oyo anahêka mukâge emw’omudâhwa, ayîshe adwîrhe enterekêro kuli ye, cigabi ca kali ikumi c’omulengo<note caller="+" style="f"><char style="fr" closed="false">5, 15 </char><char style="ft" closed="false">Eco cigabi ca kali ikumi c’omulengo gw’enshâno y’engano càli ca litri 4, 5.</char></note> gw’enshâno y’engano. Arhabulagiragakwo mavurha nîsi erhi nshangi, bulya eri nterekêro nkalange y’omujina, nterekêro ya bwikebwe eyakengêze obubî”. <verse eid="NUM 5:15"/><verse number="16" style="v" sid="NUM 5:16"/>“Omudâhwa anabwîra olya mukazi ayegere oluhêrero, ayimange embere za Nyakasane”. <verse eid="NUM 5:16"/><verse number="17" style="v" sid="NUM 5:17"/>“Omudâhwa anayanka amîshi omu kabindi, na hano abà amayanka ehy’akatulo oku budaka bw’Endâro, anahihira mulya mîshi”, <verse eid="NUM 5:17"/><verse number="18" style="v" sid="NUM 5:18"/>“Omudâhwa, anayimanza nyamukazi embere za Nyakasane, analukûla emviri z’okw’irhwe lya nyamukazi; kandi anamufumbasa enterekêro y’obwikebwe, nterekêro ya mujina. Omudâhwa anafumbarha omu maboko gâge amîshi malulu, go galêrha okuhehêrerwa”. <verse eid="NUM 5:18"/><verse number="19" style="v" sid="NUM 5:19"/>“Omudâhwa analahiriza nyamukazi amubwîre, erhi: Akabà ntà mulume walâzire mweshi naye, n’akabà orhahindamukaga okola wacîhemula, n’obwôla ociri omu mwa balo, onayêre muli agâla mîshi g’okuhehêrerwa<note caller="+" style="f"><char style="fr" closed="false">5, 19 </char><char style="ft" closed="false">Mîshi malulu: gali mîshi mahehêrere, ganayîrha (<char style="xt"><ref loc="EXO 15:23-25">Lub 15, 23-25</ref></char>). Okwo kwàli kunywêsa omuntu ecihango amango ntà câzo cihali kuli oyo muntu, lyo bamanya erhi ayâzire nîsi erhi ahire. Ab’omu mulala gwa Semu, bakâgikolêsa amîshi g’omu lwîshi erhi g’omu iriba. Alaga amazîno ga maliba maguma-maguma: Ein-Mishpat* («iriba ly’obucîranuzi»: <char style="xt"><ref loc="GEN 14:7">Murh 14, 7</ref></char>), Meriba *(«nnongwè»: <char style="xt"><ref loc="NUM 20:13">Mib 20, 13</ref></char>).</char></note>”. <verse eid="NUM 5:19"/><verse number="20" style="v" sid="NUM 5:20"/>“Ci erhi akabà wabîre mubamba, n’obwôla ogwêrhe balo, wagenda n’owundi mulume”. <verse eid="NUM 5:20"/><verse number="21" style="v" sid="NUM 5:21"/>“Omudâhwa anamugasha n’ebinwa by’ecihango, anamubwîra”, erhi: “Nyamubâho akujire buhanya na wa busha omu karhî k’olubaga lwâge, oyume emirhibadu, orhunde n’enda”, <verse eid="NUM 5:21"/><verse number="22" style="v" sid="NUM 5:22"/>“n’agâla mîshi galêrha obuhanya gakuje omu nda gayirhunze ganakuyumye emirhibadu. Nyamukazi anashuza<note caller="+" style="f"><char style="fr" closed="false">5, 22 </char><char style="ft" closed="false">Ishuzo: Amen, amen! = «Kwo binali, bibè ntyo». - Omu kuderha ebi binwa, nyanmkazi anayêmêre n’obwâlagale ebinwa byoshi omudâhwa anamugashaga (<char style="xt"><ref loc="DEU 27:15-26">Lush 27, 15-26</ref></char>).</char></note>, erhi: Amen! Amen!” <verse eid="NUM 5:22"/><verse number="23" style="v" sid="NUM 5:23"/>“Omudâhwa anayandika birya binwa<note caller="+" style="f"><char style="fr" closed="false">5, 23 </char><char style="ft" closed="false">Hali okundi bakâgicîgasha: banabwîra omuntu alyè gulya muzingè bayandisirekwo endahiro y’omwîgasho (<char style="xt"><ref loc="EZK 2:8-3:3">Eze 2, 8—3, 3</ref></char>)</char></note> by’okucigasha oku muzingè, kandi anabizagiza muli galya mîshi malulu”. <verse eid="NUM 5:23"/><verse number="24" style="v" sid="NUM 5:24"/>“Ananywêsa nyamukazi galya mîshi malulu na ga kuhehêrerwa, n’agôla mîshi g’okuhehêrerwa ganashandabana muli ye n’obululu bwâgo”. <verse eid="NUM 5:24"/><verse number="25" style="v" sid="NUM 5:25"/>“Omudâhwa erhi abà amâyankirira omu maboko ga nyamukazi erya nterekêro y’omujina, anayimogamoga embere za Nyakasane, anayiyegeza oku luhêrero”. <verse eid="NUM 5:25"/><verse number="26" style="v" sid="NUM 5:26"/>“Anashamarha nshâno ya lihî luguma lw’eyôla nterekêro y’okuyibusa<note caller="+" style="f"><char style="fr" closed="false">5, 26 </char><char style="ft" closed="false">Okuyibusa: Rhulole omu <char style="xt"><ref loc="LEV 2:2">Lev 2, 2</ref></char>.</char></note>, anayisingônokesa oku luhêrero, enyuma ly’ahôla anaywêsa nyamukazi galya mîshi”. <verse eid="NUM 5:26"/><verse number="27" style="v" sid="NUM 5:27"/>“Hano abà amamunywesa galya mîshi oku bikolaga byayishibà: akabà nyamukazi ahemukîre îba, galya mîshi ganalêrha okuhehêrerwa hano ganamujamwo, ganamululire: enda yâge yanarhunda, emirhibadu yâge yanayuma na oyôla mukazi anabà muhanya omu bene wâbo”. <verse eid="NUM 5:27"/><verse number="28" style="v" sid="NUM 5:28"/>“Ci erhi ankabà nyamukazi ali mwêru kwêru, arhahemukaga, arhankajà kwo iga, anacira, akazinaburha”. <verse eid="NUM 5:28"/><verse number="29" style="v" sid="NUM 5:29"/>“Lyo irhegeko ly’omujina eryo, amango omukazi ankahemukira îba omu kuhusha”, <verse eid="NUM 5:29"/><verse number="30" style="v" sid="NUM 5:30"/>“nîsi erhi akabà omulume amajamwo omujina kuli mukâge: oyôla mulume anagendiyimanza mukâge embere za Nyakasane n’omudâhwa anamujirirakwo eryo irhegeko nk’oku linali lyoshi”. <verse eid="NUM 5:30"/><verse number="31" style="v" sid="NUM 5:31"/>“Omulume arhajiziri câha, nyamukazi anabarhula obubî bwâge yêne”».<verse eid="NUM 5:31"/></para>
  <chapter eid="NUM 5"/>
  <chapter number="6" style="c" sid="NUM 6"/>
  <para style="s1">Omuntu orherekîrwe Nyakasane</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 6:1"/>Nyakasane anacibwîra Mûsa, erhi: «Ogendibwîra bene Israheli ntya: <verse eid="NUM 6:1"/><verse number="2" style="v" sid="NUM 6:2"/>“Mango hânabè omulume erhi mukazi wajira eciragâne c’okucîhâna emwa Nyamubâho”, <verse eid="NUM 6:2"/><verse number="3" style="v" sid="NUM 6:3"/>“oyôla muntu analekage okunywa idivayi na ngasi gandi mamvu galalusà goshi; arhanywaga ciru n’enkalishi erhenga omu idivayi erhi omu gandi mamvu galalusà. Arhanywaga ciru n’omurhobo gw’omu mizâbîbu, arhanalyaga ciru emizâbîbu mibishi nîsi eyumire”. <verse eid="NUM 6:3"/><verse number="4" style="v" sid="NUM 6:4"/>“Amango gâge goshi g’oku­cihâna oyôla muntu munyaciragâne arhalyaga ciru n’ehitya birhenga oku mizâbîbu<note caller="+" style="f"><char style="fr" closed="false">6, 4 </char><char style="ft" closed="false">Okwo kulahira ngasi hyoshi hirhenga omu muzâbîbu, kuli kulonza okulahira akalamo k’okubêra hantu haguma aka ab’omu mulala gw’abà-Rekabu (<char style="xt"><ref loc="JER 35:5-8">Yer 35, 5-8</ref></char>).</char></note>, kurhenga oku mogomogo z’emizâbîbu kuhika oku byûla byâyo”. <verse eid="NUM 6:4"/><verse number="5" style="v" sid="NUM 6:5"/>“Amango g’okucîhâna kwâge oyôla munyaciragâne, olugembe lurhankamugera okw’irhwe, kuhika ensiku zâge z’eciragâne c’okucîhâna emwa Nyamubâho zihwe, ayôrha mwimâna, aleke emviri zâge zikule ntyo oku zinalonzize”. <verse eid="NUM 6:5"/><verse number="6" style="v" sid="NUM 6:6"/>“Muli agôla mango g’okucîhâna kwâge, arhankayegêra<note caller="+" style="f"><char style="fr" closed="false">6, 6 </char><char style="ft" closed="false">Omunya-ciragâne n’omudâhwa mukulu (<char style="xt"><ref loc="LEV 21:1-11">Lev 21, 1-11</ref></char>), bagwâsirwe okushimba buzira izâbyo amarhegeko g’enterekêro nyêrukwêru. Arhahîraga akacihemula (Rhulole omu cigabi ca 19).</char></note> omuntu ofîre ciru n’omuguma”, <verse eid="NUM 6:6"/><verse number="7" style="v" sid="NUM 6:7"/>“arhankacîhemula ciru n’oli îshe, ciru n’oli nnina, ciru n’oli mwene wâbo, erhi mwâli wâbo ofîre, bulya okw’irhwe lyâge kwayandagalire omugisho gw’okumurherekêra Nyamuzinda”. <verse eid="NUM 6:7"/><verse number="8" style="v" sid="NUM 6:8"/>“Agôla mango g’eciragâne câge goshi ali muntu orherekîrwe Nyakasane”. <verse eid="NUM 6:8"/><verse number="9" style="v" sid="NUM 6:9"/>“Erhi omuntu ankafira buno buno aha burhambi bwâge, n’okwôla kubè­ muli lirya irhwe lyarherekîrwe Nyamubâho, anamôme irhwe lyâge oku lusiku lw’okucîcêsa; analimôma oku lusiku lwa kali nda”. <verse eid="NUM 6:9"/><verse number="10" style="v" sid="NUM 6:10"/>“Oku lusiku lwa munâni anayisha adwîrhe emunda omudâhwa ali, mahali abirhi ga mpingà erhi bânagoko babirhi ba ngûkù, aha muhango gw’lhêma ly’embugânano”. <verse eid="NUM 6:10"/><verse number="11" style="v" sid="NUM 6:11"/>“Omudâhwa anarherekêra ngûkù nguma oku nterekêro y’oku byâbà, n’eyindi oku nterekêro y’ensirîra, kandi anamujirira empyûlo kuli ecôla câha câge c’agôla mango g’omuntu ofîre. Olwôla lusiku olya muntu wajiraga eciragâne anashubirherekêra irhwe lyâge”. <verse eid="NUM 6:11"/><verse number="12" style="v" sid="NUM 6:12"/>“Kandi anashubirherekêra Nyamubâho ensiku z’eciragâne câge, anarherekêra omwâna-buzi wa mwâka muguma oku nterekêro y’obubî. Ensiku zagezire zirhankaciganjwa bulya eciragâne câge cahemwîrwe”».<verse eid="NUM 6:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 6:13"/>«Alaga irhegeko ly’omuntu wacihânyire; oku lusiku luzinda lw’eciragâne câge banayisha bamudwîrhe ah’ihêma ly’embugânano. <verse eid="NUM 6:13"/><verse number="14" style="v" sid="NUM 6:14"/>“Anahà Nyamubâho entûlo yâge ntyâla: mwâna-buzi wa mwâka muguma orhalikwo ishembo, oku nterekêro y’ensirîra, omushîbuzi gwa mwâka muguma oku nterekêro y’oku byâha, nayo erhabâga n’ishembo, engandabuzi erhalikwo ishembo, oku nterekêro y’omurhûla”. <verse eid="NUM 6:14"/><verse number="15" style="v" sid="NUM 6:15"/>“Ahirekwo ecirhiri c’emigati erhalimwo lwango, migati ya nshâno ya mula mvange n’amavurha n’orhundi rhugati rhutya rhutya rhurhalimwo lwango, rhushîge amavurha, kandi banajiramwo enterekêro y’enkalangè, n’eya okushêsha ecinyôbwa, erya banakômerera okujira”. <verse eid="NUM 6:15"/><verse number="16" style="v" sid="NUM 6:16"/>“Ebyôla omudâhwa anabirherekêra Nyamubâho, anabulihâna enterekêro yâge oku byâha kuguma n’enterekêro yâge y’ensirîra”. <verse eid="NUM 6:16"/><verse number="17" style="v" sid="NUM 6:17"/>“Kandi anarherekêra erya ngandabuzi oku nterekêro y’omurhûla emwa Nyamubâho, kuguma na cirya cirhiri c’emigati erhalimwo lwango. Kandi omudâhwa anajira enterekêro yâge y’enkalangè n’ey’okushêsha ecinyôbwa”. <verse eid="NUM 6:17"/><verse number="18" style="v" sid="NUM 6:18"/>“Olya wajiraga eciragâne anamômera irhwe lyâge ah’Ihêma ly’embugânano, hano abà amârhôla zirya mvîri z’okw’irhwe lyâge lyarherekêragwa, anazihira omu muliro gw’enterekêro y’omurhûla”. <verse eid="NUM 6:18"/><verse number="19" style="v" sid="NUM 6:19"/>“Omudâhwa anayanka ecirhugo c’erya ngandabuzi nka camahya<note caller="+" style="f"><char style="fr" closed="false">6, 19 </char><char style="ft" closed="false">Amarhegeko gayêrekîre abadâhwa gahùnyire oku kuli kwinjà okuhà omudâhwa ecâge cigabi nka ciciri cibishi (<char style="xt"><ref loc="LEV 7:6">Lev 7, 6</ref>.<ref loc="LEV 7:31-34">31-34</ref>; <ref loc="1SA 2:14-15">1 Sam 2, 14-15</ref></char>).</char></note>, anayanka na mugati muguma gurhalimwo lwango muli erya eri omu cirhiri, kuguma na higati higuma nahyo hirhalimwo lwango; na hanôla abà amabihira omu maboko­ g’olya nyakujira eciragâne, nka naye amanamômaga lirya irhwe lyâge lyarherekêragwa”. <verse eid="NUM 6:19"/><verse number="20" style="v" sid="NUM 6:20"/>“Omudâhwa anabimogamoga embere za Nyamubâho: kali kantu kimâna k’omudâhwa kuguma na omushaya gubà gwamamogamogwa, na okugulu kubà kwamakobôlwa. Enyuma z’ahôla, olya wajiraga eciragâne anahashiginywa idivayi”. <verse eid="NUM 6:20"/><verse number="21" style="v" sid="NUM 6:21"/>“Lyo irhegeko ly’owahânaga eciragâne elyo, lyo n’irhegeko lyâge oku nterekêro ankahà Nyamubâho nk’oku ankanahashibona. Eryo irhegeko aliyûkiriza nka kulya anahânaga eciragâne câge”».<verse eid="NUM 6:21"/></para>
  <para style="s1">Isâla ly’omugisho</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 6:22"/>Nyakasane anacishambâza Mûsa amubwîra, erhi:<verse eid="NUM 6:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 6:23"/>«Odese Aroni n’abagala, erhi: “Mukola mwagisha bene Israheli mwanababwîra”, erhi: <verse eid="NUM 6:23"/><verse number="24" style="v" sid="NUM 6:24"/>“Nyakasane akugishe anakulange!” <verse eid="NUM 6:24"/><verse number="25" style="v" sid="NUM 6:25"/>“Nyamubâho akumolekere n’obusù bwâge, anakushobôze engalo zâge!” <verse eid="NUM 6:25"/><verse number="26" style="v" sid="NUM 6:26"/>“Nyamubâho akuyinamulire amalanga, anakuhè omurhûla!” <verse eid="NUM 6:26"/><verse number="27" style="v" sid="NUM 6:27"/>“Ntyo kwo bâkazihira izîno lyâni kuli bene Israheli, nâni nanabagisha.”»<verse eid="NUM 6:27"/></para>
  <chapter eid="NUM 6"/>
  <chapter number="7" style="c" sid="NUM 7"/>
  <para style="ms1">III. Enterekêro z’abarhambo b’Israheli oku lusiku lw’okugishwa kw’Endâro</para>
  <para style="s1">Okuhâna engâlè nterekêro</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 7:1"/>Olusiku Mûsa ayûsagyamwo okuyûbaka Endâro, okugisha, okuyishîga amavurha n’okugisha ebirugu byamwo byoshi, kuguma n’oluhêrero n’ebirugu byâlwo byoshi, erhi abà amanashîga olwo luhêrero amanalugisha, <verse eid="NUM 7:1"/><verse number="2" style="v" sid="NUM 7:2"/>abaluzi b’Israheli bo baligi barhambo b’emilala ya bashakulûza bâbo, bayisha badwîrhe enterekêro zâbo: bo bàli barhambo b’emilala, balya bàli bayimangîre olubaga olusiku lw’omubalè. <verse eid="NUM 7:2"/><verse number="3" style="v" sid="NUM 7:3"/>Bayisha badwîrhe enterekêro zâbo embere za Nyamubâho: Ngâlè ndarhu nfûnikire na mpanzi ikumi n’ibirhi, kwo kuderha: ngâlè nguma oku barhambo babirhi na mpanzi nguma oku ngasi mulala, banaciyisha babidwîrhe ntyôla embere z’Endâro.<verse eid="NUM 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 7:4"/>Nyamubâho ashambâla na Mûsa amubwîra, erhi: <verse eid="NUM 7:4"/><verse number="5" style="v" sid="NUM 7:5"/>«Oyankirire ebyôla bintu by’enterekêro, bikazikolêsibwa oku mikolo omw’Ihêma ly’embugânano; obihe bene Levi, ngasi muguma nk’oku amalagîrire g’omukolo gwâge ganali». <verse eid="NUM 7:5"/><verse number="6" style="v" sid="NUM 7:6"/>Mûsa erhi abà amârhôla zirya ngâlè na zirya mpanzi, abigabira bene Levi. <verse eid="NUM 7:6"/><verse number="7" style="v" sid="NUM 7:7"/>Ahâna ngâlè ibirhi na mpanzi ini kuli bene Gershoni, nk’oku amalagîrire g’omukolo gwâbo ganali. <verse eid="NUM 7:7"/><verse number="8" style="v" sid="NUM 7:8"/>Ahâna ngâlè ini na mpanzi munâni kuli bene Merari nk’oku amalagîrire g’omukolo gwâbo ganali oku bulanzi bw’Itamara mwene omudâhwa Aroni. <verse eid="NUM 7:8"/><verse number="9" style="v" sid="NUM 7:9"/>Ci bene Kehati barhahâbagwa cici, bulya bo bàli bagwêrhe omukolo gw’ebintu bigishe, bàli bagwêrhe okujà kwabihêka aha birhugo byâbo.<verse eid="NUM 7:9"/></para>
  <para style="s1">Enterekêro y’okugisha oluhêrero</para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 7:10"/>Enyuma abarhambo bahâna enterekêro yâbo oku lusiku lw’okugishwa kw’oluhêrero, lwo lusiku balushîgaga amavurha. <verse eid="NUM 7:10"/><verse number="11" style="v" sid="NUM 7:11"/>Banacihêka enterekêro yâbo embere z’oluhêrero. Nyamubâho anacibwîra Mûsa, erhi: «Ngasi lusiku, murhambo muguma akaziyisha adwîrhe enterekêro yâge y’olusiku lukulu lw’okugishwa kw’oluhêrero.»<verse eid="NUM 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 7:12"/>Omurhangiriza wahânaga enterekêro yâge àli Nashoni, mwene Aminadabu w’oku bûko bwa Yûda. <verse eid="NUM 7:12"/><verse number="13" style="v" sid="NUM 7:13"/>Arherekêra enambi y’ecûma c’olunyerere, obuzirho bwâyo bwàli bwa sikêli igana na makumi asharhu, akabêhè k’e cûma c’olunyerere ca sikêli makumi galinda, omu kugerera oku sikêli y’ahantu himâna, ngasi cirugu càli ciyunjwîre nshâno ya mulà, mvange n’amavurha oku nterekêro y’enkalangè. <verse eid="NUM 7:13"/><verse number="14" style="v" sid="NUM 7:14"/>Ahirakwo engombo y’amasholo ga sikêli ikumi, eyunjwîre bukù. <verse eid="NUM 7:14"/><verse number="15" style="v" sid="NUM 7:15"/>Ahirakwo empanzi y’omucûkà, engandabuzi n’omwâna-buzi wa mwa­ka muguma oku nterekêro y’ensirîra. <verse eid="NUM 7:15"/><verse number="16" style="v" sid="NUM 7:16"/>Ahirakwo ecihebe c’enterekêro oku byâha. <verse eid="NUM 7:16"/><verse number="17" style="v" sid="NUM 7:17"/>N’oku nterekêro y’omurhûla ahâna mpanzi ibirhi, ngandabuzi irhanu, bihebe birhanu na bâna-buzi ndarhu ba mwâka muguma. Eyo yo nterekêro ya Nashoni mwene Aminadabu.<verse eid="NUM 7:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 7:18"/>Oku lusiku lwa kabirhi, Natanaeli mwene Suari, murhambo w’obûko bwa bene Isakari naye ahâna enterekêro yâge. <verse eid="NUM 7:18"/><verse number="19" style="v" sid="NUM 7:19"/>Arherekêra enambi y’ecûma c’olunyerere, obuzirho bwâyo bwàli bwa sikêli igana na makumi asharhu, akabêhè k’ecûma c’olunyerere ca sikêli makumi gali nda, omu kugerera oku sikêli y’ahantu himâna, ngasi cirugu càli ciyunjwîre nshâno ya mulà mvange n’amavurha, oku nterekêro y’enkalangè. <verse eid="NUM 7:19"/><verse number="20" style="v" sid="NUM 7:20"/>Ahirakwo engombo y’amasholo ga sikêli ikumi, eyunjwîre bukù. <verse eid="NUM 7:20"/><verse number="21" style="v" sid="NUM 7:21"/>Ahirakwo empanzi y’omucûkà, engandabuzi n’omwâna-buzi wa mwâka muguma oku nterekêro y’ensirîra. <verse eid="NUM 7:21"/><verse number="22" style="v" sid="NUM 7:22"/>Ahirakwo ecihebe c’enterekêro oku byâha, <verse eid="NUM 7:22"/><verse number="23" style="v" sid="NUM 7:23"/>n’oku nterekêro y’omurhûla ahâna mpanzi ibirhi, ngandabuzi irhanu, bihebe birhanu na bâna-buzi barhanu ba mwâka muguma. Eyo yo nterekêro ya Natanaeli mwene Suari.<verse eid="NUM 7:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 7:24"/>Oku lusiku lwa kasharhu ayisha omurhambo wa bene Zabuloni, Eliabu mwene Heloni. <verse eid="NUM 7:24"/><verse number="25" style="v" sid="NUM 7:25"/>Arherekêra enambi y’ecûma c’olunyerere, obuzirho bwâyo bwàli bwa sikêli igana na makumi asharhu, akabêhè k’ecûma c’olunyerere ca sikêli makumi gali nda omu kugerera oku sikêli y’ahantu himâna, ngasi cirugu càli ciyunjwîre nshâno ya mulà mvange n’amavurha, oku nterekêro y’enkalangè. <verse eid="NUM 7:25"/><verse number="26" style="v" sid="NUM 7:26"/>Ahirakwo engombo y’amasholo ga sikêli ikumi, eyunjwîre bukù. <verse eid="NUM 7:26"/><verse number="27" style="v" sid="NUM 7:27"/>Ahirakwo empanzi y’omucûkà, engandabuzi n’omwâna-buzi wa mwâka muguma oku nterekêro y’ensirîra. <verse eid="NUM 7:27"/><verse number="28" style="v" sid="NUM 7:28"/>Ahirakwo ecihebe c’enterekêro oku byâha. <verse eid="NUM 7:28"/><verse number="29" style="v" sid="NUM 7:29"/>N’oku nterekêro y’omurhûla, ahâna mpanzi ibirhi, ngandabuzi irhanu, bihebe birhanu, na bâna-buzi barhanu ba mwâka muguma. Eyo yo nterekêro ya Eliabu mwene Heloni.<verse eid="NUM 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 7:30"/>Oku lusiku lwa kani, ayisha omurhambo wa bene Rubeni, Elisuri mwene Sedeuri. <verse eid="NUM 7:30"/><verse number="31" style="v" sid="NUM 7:31"/>Arherekêra enambi y’ecûma c’olunyerere, obuzirho bwâyo bwàli bwa sikêli igana na makumi asharhu, n’akabêhè k’ecûma c’olunyerere ca sikêli makumi gali nda omu kugerera oku sikêli y’ahantu himâna; ngasi cirugu càli ciyunjwîre nshâno ya mulà, mvange n’amavurha oku nterekêro y’enkalangè. <verse eid="NUM 7:31"/><verse number="32" style="v" sid="NUM 7:32"/>Ahirakwo engombo y’amasholo ga sikêli ikumi eyunjwîre bukù. <verse eid="NUM 7:32"/><verse number="33" style="v" sid="NUM 7:33"/>Ahirakwo empanzi y’omucûkà, engandabuzi n’omwâna-buzi wa mwâka muguma oku nterekêro y’ensirîra. <verse eid="NUM 7:33"/><verse number="34" style="v" sid="NUM 7:34"/>Ahirakwo ecihebe c’enterekêro oku byâha. <verse eid="NUM 7:34"/><verse number="35" style="v" sid="NUM 7:35"/>N’oku nterekêro y’omurhûla, ahâna mpanzi ibirhi, ngandabuzi ibirhi, bihehe birhanu na bânabuzi barhanu ba mwâka muguma. Eyo yo nterekêro ya Elisuri mwene Sedeuri.<verse eid="NUM 7:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 7:36"/>Oku lusiku lwa karhanu ayisha omurhambo wa bene Simoni, Shelumieli mwene Surishadayi. <verse eid="NUM 7:36"/><verse number="37" style="v" sid="NUM 7:37"/>Arherekêra enambi y’ecûma c’olunyerere, obuzirho bwâyo bwàli bwa sikêli igana na makumi asharhu, n’akabêhè k’ecûma c’olunyerere ca sikêli makumi gali nda omu kugerera oku sikêli y’ahantu himâna, ngasi cirugu càli ciyunjwîre nshâno ya mulà, mvange n’amavurha oku nterekêro y’enkalangè. <verse eid="NUM 7:37"/><verse number="38" style="v" sid="NUM 7:38"/>Ahirekwo engombo y’amasholo ga sikêli ikumi eyunjwîre bukù. <verse eid="NUM 7:38"/><verse number="39" style="v" sid="NUM 7:39"/>Ahirakwo empanzi y’omucûkà, engandabuzi n’omwâna-buzi wa mwa­ka muguma oku nterekêro y’ensirîra. <verse eid="NUM 7:39"/><verse number="40" style="v" sid="NUM 7:40"/>Ahirakwo ecihebe c’enterekêro oku byâha. <verse eid="NUM 7:40"/><verse number="41" style="v" sid="NUM 7:41"/>N’oku nterekêro y’omurhûla ahâna mpanzi ibirhi, ngandabuzi irhanu, bihebe birhanu na bâna-buzi barhanu ba mwâka muguma. Eyo yo nterekêro ya Shelumieli mwene Surishadayi.<verse eid="NUM 7:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 7:42"/>Oku lusiku lwa kali ndarhu, ayisha omurhambo wa bene Gadi, Eliasafu mwene Dueli. <verse eid="NUM 7:42"/><verse number="43" style="v" sid="NUM 7:43"/>Arherekêra enambi y’ecûma c’olunyerere, obuzirho bwâyo bwàli bwa sikêli igana na makumi asharhu, n’akabêhe k’ecûma c’olunyerere, ca sikêli makumi gali nda, omu kugerera oku sikêli y’ahantu himâna, ngasi cirugu càli ciyunjwîre nshâno ya mulà mvange n’amavurha oku nterekêro y’e­ nkalange. <verse eid="NUM 7:43"/><verse number="44" style="v" sid="NUM 7:44"/>Ahirakwo engombo y’amasholo ga sikêli ikumi, eyunjwîre bukù. <verse eid="NUM 7:44"/><verse number="45" style="v" sid="NUM 7:45"/>Ahirakwo empanzi y’omucûkà, engandabuzi n’omwâna-buzi wa mwâka muguma oku nterekêro y’ensirîra. <verse eid="NUM 7:45"/><verse number="46" style="v" sid="NUM 7:46"/>Ahirakwo ecihebe c’enterekêro oku byâha, <verse eid="NUM 7:46"/><verse number="47" style="v" sid="NUM 7:47"/>n’oku nterekêro y’omurhûla, ahâna mpanzi ibirhi, ngandabuzi irhanu, bihebe birhanu na bâna-buzi barhanu ba mwâka muguma. Eyo yo nterekêro ya Eliasafu mwene Dueli.<verse eid="NUM 7:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 7:48"/>Oku lusiku lwa kali nda ayisha omurhambo wa bene Efrayimu, Elishamaʿ mwene Amihudi, <verse eid="NUM 7:48"/><verse number="49" style="v" sid="NUM 7:49"/>arherekêra enambi y’ecûma c’olunyerere, obuzirho bwâyo bwàli bwa sikêli igana na makumi asharhu, n’akabêhè k’ecûma c’olunyerere ca sikêli makumi gali nda, omu kugerera oku sikêli y’ahantu himâna, ngasi cirugu càli ciyunjwîre nshâno ya mulà mvange n’amavurha, oku nterekêro y’enkalangè. <verse eid="NUM 7:49"/><verse number="50" style="v" sid="NUM 7:50"/>Ahirakwo engombo y’amasholo ga sikêli ikumi, eyunjwîre bukù. <verse eid="NUM 7:50"/><verse number="51" style="v" sid="NUM 7:51"/>Ahirakwo empanzi y’omucûkà, engandabuzi n’omwâna-buzi wa mwâka muguma, oku nterekêro y’ensirîra. <verse eid="NUM 7:51"/><verse number="52" style="v" sid="NUM 7:52"/>Ahirakwo ecihebe c’enterekêro oku byâha, <verse eid="NUM 7:52"/><verse number="53" style="v" sid="NUM 7:53"/>n’oku nterekêro y’omurhûla, ahâna mpanzi ibirhi, ngandabuzi irhanu, bihebe birhanu na bâna-buzi barhanu ba mwâka muguma. Eyo yo nterekêro ya Elishamaʿ mwene Amihudi.<verse eid="NUM 7:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="NUM 7:54"/>Oku lusiku lwa kali munâni ayisha omurhambo wa bene Menashè, Gamalieli mwene Pedasuri. <verse eid="NUM 7:54"/><verse number="55" style="v" sid="NUM 7:55"/>Arherekêra enambi y’ecûma c’olunyerere, obuzirho bwâyo bwàli bwa sikêli igana na makumi asharhu, n’akabêhe k’ecûma c’olunyerere ca sikêli makumi gali nda, omu kugerera oku sikêli y’ahantu himâna, ngasi cirugu càli ciyunjwîre nshâno ya mulà mvange n’amavurha, oku nterekêro y’enkalangè. <verse eid="NUM 7:55"/><verse number="56" style="v" sid="NUM 7:56"/>Ahirakwo n’engombo y’amasholo ga sikêli ikumi, eyunjwîre bukù. <verse eid="NUM 7:56"/><verse number="57" style="v" sid="NUM 7:57"/>Ahirakwo empanzi y’omucûkà, engandabuzi n’omwâna-buzi wa mwa­ka muguma, oku nterekêro y’ensirîra. <verse eid="NUM 7:57"/><verse number="58" style="v" sid="NUM 7:58"/>Ahirakwo ecihebe c’enterekêro oku byâha, <verse eid="NUM 7:58"/><verse number="59" style="v" sid="NUM 7:59"/>n’oku nterekêro y’omurhûla ahâna mpanzi ibirhi, ngandabuzi irhanu, bihebe birhanu na bâna-buzi barhanu ba mwâka muguma. Eyo yo nterekêro ya Gamalieli mwene Pedasuri.<verse eid="NUM 7:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="NUM 7:60"/>Oku lusiku lwa kali mwenda ayisha omurhambo wa bene Benyamini, Abidani mwene Gedeoni. <verse eid="NUM 7:60"/><verse number="61" style="v" sid="NUM 7:61"/>Arherekêra enambi y’ecûma c’olunyerere, obuzirho bwâyo bwàli bwa sikêli igana na makumi asharhu, n’akabehe k’ecûma c’olunyerere ca sikêli makumi gali nda, omu kugerera oku sikêli y’ahantu himâna. Ngasi cirugu càli ciyunjwîre nshâno ya mulà mvange n’amavurha, oku nterekêro y’enkalangè. <verse eid="NUM 7:61"/><verse number="62" style="v" sid="NUM 7:62"/>Ahirakwo n’engombo y’amasholo ga sikêli ikumi eyunjwîre bukù. <verse eid="NUM 7:62"/><verse number="63" style="v" sid="NUM 7:63"/>Ahirakwo empanzi y’omucûkà, engandabuzi n’omwâna-buzi wa mwâka muguma, oku nterekêro y’ensirîra. <verse eid="NUM 7:63"/><verse number="64" style="v" sid="NUM 7:64"/>Ahirakwo ecihebe c’e­ nterekêro oku byâha. <verse eid="NUM 7:64"/><verse number="65" style="v" sid="NUM 7:65"/>N’oku nterekêro y’omurhûla ahâna mpanzi ibirhi, ngandabuzi irhanu, bihebe birhanu na bâna-buzi barhanu ba mwâka muguma. Eyo yo nterekêro y’Abidani mwene Gedeoni.<verse eid="NUM 7:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="NUM 7:66"/>Oku lusiku lwa kali ikumi, ayisha omurhambo wa bene Dani, Ahiyezeri mwene Amishadayi. <verse eid="NUM 7:66"/><verse number="67" style="v" sid="NUM 7:67"/>Arherekêra enambi y’ecûma c’olunyerere, obuzirho bwâyo bwàli bwa sikli igana na makumi asharhu, akabêhe k’ecûma c’olunyerere ca sikêli makumi gali nda, omu kugerera oku sikêli y’ahantu himâna, ngasi cirugu càli ciyunjwîre nshâno ya mulà mvange n’amavurha oku nterekêro y’enkalangè. <verse eid="NUM 7:67"/><verse number="68" style="v" sid="NUM 7:68"/>Ahirakwo n’engombo y’amasholo ga sikêli ikumi eyunjwîre bukù. <verse eid="NUM 7:68"/><verse number="69" style="v" sid="NUM 7:69"/>Ahirakwo empanzi y’omucûkà, engandabuzi n’omwâna-buzi wa mwa­ka muguma oku nterekêro y’ensirîra. <verse eid="NUM 7:69"/><verse number="70" style="v" sid="NUM 7:70"/>Ahirakwo n’ecihebe c’enterekêro oku byâha. <verse eid="NUM 7:70"/><verse number="71" style="v" sid="NUM 7:71"/>N’oku nterekêro y’omurhûla ahâna mpanzi ibirhi, ngandabuzi irhanu, bihehe birhanu na bâna-buzi barhanu ba mwâka muguma. Eyo, yo nterekêro y’Ahiyezeri mwene Amishadayi.<verse eid="NUM 7:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="NUM 7:72"/>Oku lusiku lwa kali ikumi na luguma, ayisha omurhambo wa bene Aseri, Pagieli mwene Okrani. <verse eid="NUM 7:72"/><verse number="73" style="v" sid="NUM 7:73"/>Arherekêra enambi y’ecûma c’olunyerere, obuzirho bwâyo bwàli bwa sikêli igana na makumi asharhu, akabehe k’ecûma c’olunyerere ca sikêli makumi gali nda, omu kugerera oku sikêli y’ahantu himâna, ngasi cirugu càli ciyunjwîre nshâno ya mulà mvange n’amavurha oku nterekêro y’enkalangè. <verse eid="NUM 7:73"/><verse number="74" style="v" sid="NUM 7:74"/>Ahirakwo engombo y’amasholo ga sikêli ikumi, eyunjwîre bukù. <verse eid="NUM 7:74"/><verse number="75" style="v" sid="NUM 7:75"/>Ahirakwo empanzi y’omucûkà, engandabuzi n’omwâna-buzi wa mwâka muguma oku nterekêro y’ensirîra, <verse eid="NUM 7:75"/><verse number="76" style="v" sid="NUM 7:76"/>oku nterekêro y’okuhyûla oku byâha, ahâna cihebe ciguma. <verse eid="NUM 7:76"/><verse number="77" style="v" sid="NUM 7:77"/>N’oku nterekêro y’omurhûla, ahâna mpanzi ibirhi, ngandabuzi irhanu, bihebe birhanu na bâna-buzi barhanu ba mwâka muguma. Eyo yo nterekêro ya Pagieli mwene Okrani.<verse eid="NUM 7:77"/></para>
  <para style="p">
    <verse number="78" style="v" sid="NUM 7:78"/>Oku lusiku lwa kali ikumi na kabirhi, ayisha omurhambo wa bene Nefutali, Ahira mwene Enani. <verse eid="NUM 7:78"/><verse number="79" style="v" sid="NUM 7:79"/>Arherekêra enambi y’ecûma c’olunyerere, obuzirho bwâyo bwàli bwa sikêli igana na makumi asharhu, akabehe k’ecûma c’olunyerere, ca sikêli makumi gali nda, omu kugerera oku sikêli y’ahantu himâna, ngasi cirugu càli ciyunjwîre nshâno ya mulà mvange n’amavurha, oku nterekêro y’enkalangè. <verse eid="NUM 7:79"/><verse number="80" style="v" sid="NUM 7:80"/>Ahirakwo n’engombo y’amasholo ga sikêli ikumi, eyunjwîre bukù. <verse eid="NUM 7:80"/><verse number="81" style="v" sid="NUM 7:81"/>Ahirakwo empanzi y’omucûkà, engandabuzi, n’omwâna-buzi wa mwâka muguma oku nterekêro y’ensirîra. <verse eid="NUM 7:81"/><verse number="82" style="v" sid="NUM 7:82"/>Ahirakwo ecihebe c’enterekêro oku byâha, <verse eid="NUM 7:82"/><verse number="83" style="v" sid="NUM 7:83"/>n’oku nterekêro y’omurhûla ahâna mpanzi ibirhi, ngandabuzi irhanu, bihebe birhanu na bâna­ buzi barhanu ba mwâka muguma. Eyo, yo nterekêro ya Ahira mwene Enani.<verse eid="NUM 7:83"/></para>
  <para style="p">
    <verse number="84" style="v" sid="NUM 7:84"/>Ezôla, zo ntûlo z’abarhambo ba bene Israheli oku lusiku lukulu lw’okugishwa kwa oluhêrero, lwo lusiku balushigaga amavurha. Ezôla ntûlo zàli: nambi ikumi n’ibirhi z’ecûma c’olunyerere, rhubehe ikumi na rhubirhi rhw’ecûma c’olunyerere na ngombo ikumi n’ibirhi za masholo. <verse eid="NUM 7:84"/><verse number="85" style="v" sid="NUM 7:85"/>Ngasi nambi ya cûma ca lunyerere, obuzirho bwâyo bwàli bwa sikêli igana na makumi asharhu, na ngasi kabehe, ka sikêli makumi gali nda. Obuzirho bw’ebyôla birugu by’olunyerere byoshi, zàli sikêli bihumbi bibirhi na magana anni, omu kugerera oku sikêli y’ahantu himâna. <verse eid="NUM 7:85"/><verse number="86" style="v" sid="NUM 7:86"/>Engombo z’amasholo zàli ziyunjwîre bukù, ngasi nguma yali ya sikêli ikumi omu kugerera oku sikêli y’ahantu himâna. Obuzirho bw’amasholo g’ezôla ngombo bwàli bw’igana na makumi abirhi ga sikêli.<verse eid="NUM 7:86"/></para>
  <para style="p">
    <verse number="87" style="v" sid="NUM 7:87"/>Enyama z’enterekêro y’ensirîra: Mpanzi za mucûka ikumi n’ibirhi, ngandabuzi ikumi n’ibirhi na bâna-buzi ikumi na babirhi ba mwâka muguma, haguma n’enterekêro zâbo z’enkalangè. Hàli bihebe ikumi na bibirhi by’e­ nterekêro oku byâha. <verse eid="NUM 7:87"/><verse number="88" style="v" sid="NUM 7:88"/>Enyama zahanyirwe nterekêro y’omurhûla: Mpanzi makumi abirhi n’ini, ngandabuzi makumi gali ndarhu, bihebe makumi gali ndarhu na bâna-buzi makumi gali ndarhu ba mwâka muguma. Byo byahânyirwe nterekêro ebyôla oku lusiku lw’okugisha oluhêrero, erhi babà bamalushîga amavurha. Oku Nyamuzinda akâgishambâla na Mûsa.<verse eid="NUM 7:88"/></para>
  <para style="p">
    <verse number="89" style="v" sid="NUM 7:89"/>Erhi Mûsa ajàga omw’lhêma ly’embugânano mpu ashambâle na Nyamubâho, akazâgiyumva izù lidwîrhe lyamudesa kurhenga oku nyanya ly’idubiro, elyali lihizirwe oku mucîmba gw’amalaganyo, ekarhî ka balya ba-kerubi babirhi. Anarhondêra okumushabâza.<verse eid="NUM 7:89"/></para>
  <chapter eid="NUM 7"/>
  <chapter number="8" style="c" sid="NUM 8"/>
  <para style="s1">Olw’amatara g’oku ndâro</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 8:1"/>Nyakasane ashambâza Mûsa amubwîra, erhi: <verse eid="NUM 8:1"/><verse number="2" style="v" sid="NUM 8:2"/>«Oshambâle n’Aroni omubwîre, erhi: “Amango wahira amatara<note caller="+" style="f"><char style="fr" closed="false">8, 2 </char><char style="ft" closed="false">'amatara' rhwanagaderha 'rhumole' omu mashi nkana; rhwarhozire 'itara' ci cibà ciswahili</char></note> oku cinara, embere ly’ecôla cinara yo agôla matara nda gagwâsirwe gakazimolekera.”» <verse eid="NUM 8:2"/><verse number="3" style="v" sid="NUM 8:3"/>Aroni anacijira kulya; ahira amatara embere z’ecinâra, nka kulya Nyamubâho anarhegekaga Mûsa. <verse eid="NUM 8:3"/><verse number="4" style="v" sid="NUM 8:4"/>Ecôla cinara càli cijizirwe n’amasholo gône kuhika oku magulu, kuhika oku bwâso bwâco, càli cituzirwe n’amasholo gônene, Mûsa acîjirisagya omu kushimba ec’olwiganyo Nyamubâho amuyêrekaga.<verse eid="NUM 8:4"/></para>
  <para style="s1">Okuyîmikwa kwa Bene Levi</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 8:5"/>Nyakasane ashambâza Mûsa amubwîra; erhi: <verse eid="NUM 8:5"/><verse number="6" style="v" sid="NUM 8:6"/>«Orhôle bene Levi ekarhî ka bene Israheli, onabacêse. <verse eid="NUM 8:6"/><verse number="7" style="v" sid="NUM 8:7"/>“Alaga oku wabacêsa: Obakangûle n’amîshi g’olukangûlo; bageze olugembe oku mubiri gwâbo goshi, bashuke n’emyambalo yâbo bacîcese ntyôla”. <verse eid="NUM 8:7"/><verse number="8" style="v" sid="NUM 8:8"/>“Enyuma z’ahôla, banarhôla empanzi y’omucûkà oku nterekêro y’ensirîra, kuguma n’enterekêro yâge y’enkalangè yajirwa n’e­ nshâno y’omulà mvange n’amavurha. Wanarhôla n’eyindi mpanzi y’omucûkà, ebè nterekêro oku câha”. <verse eid="NUM 8:8"/><verse number="9" style="v" sid="NUM 8:9"/>“Wanashegeza bene Levi embere za ihêma ly’embugânano, kandi wanashubûza endêko ya bene Israheli boshi”. <verse eid="NUM 8:9"/><verse number="10" style="v" sid="NUM 8:10"/>“Wanashegeza bene Levi embere za Nyamubâho, na bene Israheli banahira amaboko<note caller="+" style="f"><char style="fr" closed="false">8, 10 </char><char style="ft" closed="false">Kulambûlira amaboko gâbo kuli bene Levi. Okumulambûlirakwo amaboko kugwêrhe mahugûlo manji: - Bakagilambûlira amaboko oku mbâgwa (<char style="xt"><ref loc="EXO 29:10">Lub 29, 10</ref>; <ref loc="LEV 3:2">Lev 3, 2</ref>.<ref loc="LEV 3:8">8</ref>; <ref loc="LEV 4:4">4, 4</ref></char>). - Eco cijiro cakâgijirwa amango bahêreza omuntu obuhashe (bukulu): <char style="xt"><ref loc="NUM 27:18">Mib 27, 18</ref>; <ref loc="DEU 34">Lush 34</ref></char>. - Eco cijiro cakâgijirwa amango g’enterekêro y’engandabuzi y’empyûlo (<char style="xt"><ref loc="LEV 16:20-22">Lev 16, 20-22</ref></char>). - Kandi eco cijiro cakâgijirwa nka bahâna omugisho (<char style="xt"><ref loc="GEN 48:14">Murh 48, 14</ref></char>).</char></note> gâbo kuli bene Levi”. <verse eid="NUM 8:10"/><verse number="11" style="v" sid="NUM 8:11"/>“Aroni anarherekêra bene Levi nka nterekêro ya kumogamogwa embere za Nyamubâho, nterekêro ehûnyirwe na bene Israheli, mpu babè bantu bakukazijira omukolo gwa Nyamubâho”. <verse eid="NUM 8:11"/><verse number="12" style="v" sid="NUM 8:12"/>“Bene Levi, banahira amaboko oku irhwe ly’empanzi ibirhi, nguma wa­ nayihâna nka nterekêro oku byâha, n’eyindi nka nterekêro ya nsirîra ya Nyamubâho, lyo bahashijira empyûlo kuli bene Levi”. <verse eid="NUM 8:12"/><verse number="13" style="v" sid="NUM 8:13"/>“Wanayimanza bene Levi embere z’Aroni n’embere z’abagala, wanabarherekêra nka nterekêro ya kumogamogwa embere za Nyamubâho”. <verse eid="NUM 8:13"/><verse number="14" style="v" sid="NUM 8:14"/>“Wanayêgûla bene Levi ekarhî k’abandi bene Israheli, na bene Levi banabà bantu bâni niene”. <verse eid="NUM 8:14"/><verse number="15" style="v" sid="NUM 8:15"/>“Enyuma z’ahôla bene Levi banayisha balijira omukolo omu Ihêma ly’embugânano. Ntyo kwo wabacêsa onabarherekêre nka nterekêro ya kumogamogwa”. <verse eid="NUM 8:15"/><verse number="16" style="v" sid="NUM 8:16"/>“Bulya bakola bîmi loshi omu bene Israheli; nabarhôzire nti babè bâni niene ahâli h’omwâna w’olubere, olya wayigula burhangiriza enda ya nina, nacîshozire bo kuli ngasi mwâna wa lubere wa bene Israheli”. <verse eid="NUM 8:16"/><verse number="17" style="v" sid="NUM 8:17"/>“Bulya ngasi mwâna wa lubere wa bene Israheli ali wâni, abè mwâna wa lubere wa muntu, abè wa cintu. Lulya lusiku nayîrhagamwo ngasi lubere omu Mîsiri go mango nacîrherekêraga bo”. <verse eid="NUM 8:17"/><verse number="18" style="v" sid="NUM 8:18"/>“Narhôzire Abaleviti ahâli h’abâna b’olubere ba bene Israheli”. <verse eid="NUM 8:18"/><verse number="19" style="v" sid="NUM 8:19"/>“Nahânyire loshi bene Levi emwa Aroni n’abagala, nka ‘ngalo’, omu karhî ka bene Israheli; bakazijira omukolo gwa bene Israheli omu Ihêma ly’embugânano, bakazijira empyûlo ya bene Israheli, lyo bene Israheli balekijakwo cibande cici, amango bayegêra ahantu himâna”».<verse eid="NUM 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 8:20"/>Mûsa, Aroni na bene Israheli boshi bajirira bene Levi nk’okwôla Nyamubâho anarhegekaga Mûsa, oku hiyêrekîre bene Levi. Kwo bajizire ntyo bene Israheli kuli bo. <verse eid="NUM 8:20"/><verse number="21" style="v" sid="NUM 8:21"/>Abaleviti bacìcêsa, bashuka emyambalo yâbo. Naye Aroni abarherekêra nka nterekêro ya kumogamoga embere za Nyamubâho, abajirira n’empyûlo lyo babà bwinjà. <verse eid="NUM 8:21"/><verse number="22" style="v" sid="NUM 8:22"/>Enyuma z’ahôla, bene Levi bakaziyîsha balijira omukolo gwâbo omu Ihêma embere z’Aroni n’abagala. Bajira nk’oku Nyamubâho anarhegekaga Mûsa oku biyêrekîre bene Levi, okwôla kwo banabajirire.<verse eid="NUM 8:22"/></para>
  <para style="s1">Amango Bene-Levi barhegesirwe okuhâna enterekêro</para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 8:23"/>Nyakasane ashambâza Mûsa, amubwîra, erhi: <verse eid="NUM 8:23"/><verse number="24" style="v" sid="NUM 8:24"/>«Genda obwîre Bene­ Levi, erhi: “Kurhenga oku myâka makumi abirhi n’irhanu, ngasi Mwene-Levi arhegesirwe okuhâna enterekêro, ajire mukolo muguma omu Ihêma ly’Embugânano.” <verse eid="NUM 8:24"/><verse number="25" style="v" sid="NUM 8:25"/>“Kurhenga oku myâka makumi arhanu, arhacisezibwi okuhâna enterekêro; ntà mukolo acisêzibwe okujira.” <verse eid="NUM 8:25"/><verse number="26" style="v" sid="NUM 8:26"/>“Cikwône anarhabâla bene wâbo okushimba ebirhegesirwe omu Ihêma ly’Embugânano, erhi na ntà mukolo asêzibwe. Ntyo kwo wakazijira omu kushimba ebirhegesirwe Bene-Levi.”»<verse eid="NUM 8:26"/></para>
  <chapter eid="NUM 8"/>
  <chapter number="9" style="c" sid="NUM 9"/>
  <para style="ms1">IV. Basâka n’okurhenga e Sînayi</para>
  <para style="s1">Olusiku lukulu lwa Basâka</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 9:1"/>Nyakasane ashambâla na Mûsa oku ntondo ya Sînayi omu mwêzi murhanzi gw’omwâka gwa kabirhi kurhenga barhenzire omu cihugo c’e Mîsiri. <verse eid="NUM 9:1"/><verse number="2" style="v" sid="NUM 9:2"/>Aderha, erhi: «Bene Israheli boshi bakazijira olusiku lukulu lwa Basâka amango ganakwânîne. <verse eid="NUM 9:2"/><verse number="3" style="v" sid="NUM 9:3"/>“Mukazilujira amango ganakwânîne, oku lusiku lw’ikumi na kani lw’ogu mwêzi, ekarhî ka bijingo bibirhi: go mango gakwânîne agôla, mwakazilukuza omu kushimba amarhegeko na ngasi bijiro biluyêrekîre byoshi”». <verse eid="NUM 9:3"/><verse number="4" style="v" sid="NUM 9:4"/>Mûsa agendishambâla na bene Israheli mpu bajire olusiku lukulu lwa Basâka. <verse eid="NUM 9:4"/><verse number="5" style="v" sid="NUM 9:5"/>Banacijira olusiku lukulu lwa Basâka, omu nsiku ikumi n’ini z’omwêzi gwa burhanzi ekarhî ka bijingo bibiri, omu ntondo ya Sînayi. Nk’oku Nyamubâho anarhegekaga Mûsa koshi, kwo bene Israheli banajizire. <verse eid="NUM 9:5"/><verse number="6" style="v" sid="NUM 9:6"/>Omu bantu mwabonekana abarhahashigijira Basâka, bàli bagalugalu erhi cirunda ca muntu cirhuma, ntyo okwôla kwarhuma barhacijira Basâka olwôla lusiku. Erhi babà bamâjà emunda Mûsa n’Aroni bali, <verse eid="NUM 9:6"/><verse number="7" style="v" sid="NUM 9:7"/>babwîra Mûsa, mpu: «Rhwono rhuli bagalugalu erhi cirunda cirhuma, cirhumirage rhwêki rhuhanzibwa okurherekêra Nyamubâho amango gakwânîne, omu karhî ka bene Israheli» <verse eid="NUM 9:7"/><verse number="8" style="v" sid="NUM 9:8"/>Mûsa abashuza, erhi: «Murhangilinda ngendidôsa bici Nyamubâho amurhegesire.» <verse eid="NUM 9:8"/><verse number="9" style="v" sid="NUM 9:9"/>Nyamubâho ashambâla na Mûsa amubwîra, erhi: <verse eid="NUM 9:9"/><verse number="10" style="v" sid="NUM 9:10"/>«Ojishambâla mwe na bene Israheli, obabwîre, erhi: Nka muntu muguma muli mwe nîsi erhi muntu muguma w’omu baburhwa binyu, akabà mugalugalu erhi cirunda cirhumire nîsi erhi abè abalamîre kuli, agwâsirwe naye ajire Basâka<note caller="+" style="f"><char style="fr" closed="false">9, 10 </char><char style="ft" closed="false">Omulongo gwa kali ndarhu gurhuyêresire cihanzo ciguma cône. Hanôla, rhubwîne bibirhi. Kuyêrekîne oku biri binji: ciru cankaba co cihanzo cici, liri irhegeko okukuza Basâka. Ogwêrhe ecihanzo analukuza omu mwêzi gwayisha.</char></note> w’okukuza Nyamubâho. <verse eid="NUM 9:10"/><verse number="11" style="v" sid="NUM 9:11"/>“Omu mwêzi gwa kabirhi mwo bankamujira, omu nsiku ikumi n’ini, ekarhî ka bijingo bibirhi. Banamulye n’emigati erhalimwo lwango, n’enshogo ndulu”. <verse eid="NUM 9:11"/><verse number="12" style="v" sid="NUM 9:12"/>“Barhasizagya cici kuhika oku sêzi, barhanamuvunaga kavuha”. <verse eid="NUM 9:12"/><verse number="13" style="v" sid="NUM 9:13"/>“Erhi kwankabà hali omuntu oyôsire bwinjà, arhanali omu mabalamo, oyo muntu erhi ankabula kwajira olusiku lukulu lwa Basâka, oyo muntu banamukage omu lubaga lwâge; bulya arhahâga Nyamubâho enterekêro amango gakwânîne, yêne anabarhule ecâha câge”. <verse eid="NUM 9:13"/><verse number="14" style="v" sid="NUM 9:14"/>“Erhi omuntu w’ecigolo ohanzire emwinyu ankajira naye Basâka, kukwânîne ashimbe amarhegeko n’ebijiro binayêrekîre Basâka byoshi. Hâbà irhegeko liguma kuli mwe n’oku cigolo n’oku wundi muntu obashizire”».<verse eid="NUM 9:14"/></para>
  <para style="s1">Ecitù c’omuliro</para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 9:15"/>Olusiku bayimazagya Endâro, ecitù cabwîkira eyôla Ndâro: lyo Ihêma ly’amalaganyo. Kurhenga bijingo kujika sêzi, oku Ndâro kwajà oguli nka muliro. <verse eid="NUM 9:15"/><verse number="16" style="v" sid="NUM 9:16"/>Byanakaziyôrha byâbà ntyôla: ecitù canabwîkira Endâro, na budufu canayôrha nka muliro. <verse eid="NUM 9:16"/><verse number="17" style="v" sid="NUM 9:17"/>Erhi ecôla citù carhengaga oku Ihêma, nabo bene Israheli banahandûla, n’aha ecitù cayimangaga ho nabo banakazigwîka ecihando. <verse eid="NUM 9:17"/><verse number="18" style="v" sid="NUM 9:18"/>Bene Israheli bakazihandûla oku irhegeko lya Nyamubâho, kandi oku irhegeko lyâge banashubigwîka ecihando. Bakaziyôrha bali oku cihando, amango goshi naco ecôla citù canakazâgiyôrha ciri oku Ndâro. <verse eid="NUM 9:18"/><verse number="19" style="v" sid="NUM 9:19"/>Erhi ecôla citù cankalegamire nsiku nyinji oku Ndâro, bene Israheli banashimbe lirya irhegeko lya Nyamubâho, barhankaciderha mpu babandûla. <verse eid="NUM 9:19"/><verse number="20" style="v" sid="NUM 9:20"/>Kwo na kuguma, erhi ecôla citù cankagezize nsiku nsungunu zône oku Ndâro: oku irhegeko lya Nyamubâho banagwîka ecihando, kandi oku irhegeko lya Nyamubâho bahandûle. <verse eid="NUM 9:20"/><verse number="21" style="v" sid="NUM 9:21"/>Erhi ecitù cankayimanzire kurhenga bijingo byône kuhika sêzi, cikanasjubiyimuka sêzi, nabo banahandûle, Kandi erhi ecitù cankayimusire kugere lusiku luguma na budufu buguma nabo banahandùle. <verse eid="NUM 9:21"/><verse number="22" style="v" sid="NUM 9:22"/>Erhi ecôla citù cankayôsire oku Ndâro nsiku nyinji, mwêzi erhi mwâka, bene Israheli banayôrha bali oku cihando, arhankadesire mpu bakola bahandûla: erhi canayimukaga ntyâla nabo banajandûle. <verse eid="NUM 9:22"/><verse number="23" style="v" sid="NUM 9:23"/>Oku irhegeko lya Nyamubâho banagwîka ecihando, n’oku irhegeko lya Nyamubâho banahandûla. Bakazâgishimba irhegeko lya Nyamubâho nk’oku Nyamubâho anarhegekaga Mûsa.<verse eid="NUM 9:23"/></para>
  <chapter eid="NUM 9"/>
  <chapter number="10" style="c" sid="NUM 10"/>
  <para style="s1">Emishekera</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 10:1"/>Nyakasane ashambâla na Mûsa amubwîra, erhi: <verse eid="NUM 10:1"/><verse number="2" style="v" sid="NUM 10:2"/>«Otule mishekera ibirhi ya cûma ca lunyerere<note caller="+" style="f"><char style="fr" closed="false">10, 2 </char><char style="ft" closed="false">Mishekera ya cûma ca lunyerere cônene: eri mishekera ekubûsire ya buli bwa metri nka nguma. Bakagiyikolêsa omu ka-Nyamuzinda (Rhulole omu <char style="xt"><ref loc="1CH 15:24">1 Nga 15, 24</ref>; <ref loc="2CH 5:12">2 Nga 5, 12</ref></char>). Ci rhurhamanyiri bwinjinjà cirhumire bayikolêsa hano nka ya basirika.</char></note>; ebè cûma ca lunyerere cônene. Wakaziyikolêsa amango g’okushubûza olubaga n’amango g’okuhandûla bakola barhenga omu cihando. <verse eid="NUM 10:2"/><verse number="3" style="v" sid="NUM 10:3"/>“Nka gwamâbûhwa olubaga lwoshi lwanalundumukira emunda oli, aha Ihêma ly’embugânano”. <verse eid="NUM 10:3"/><verse number="4" style="v" sid="NUM 10:4"/>“Erhi bankabûha mushekera muguma gône, abaluzi, bo baligi barhambo b’ebihumbi bya bene Israheli, banayisha badêke eburhambi bwâwe”. <verse eid="NUM 10:4"/><verse number="5" style="v" sid="NUM 10:5"/>“Erhi bankabûha eyôla mishekera eshakanya omu cihando, balya bahanda olunda lwa ebuzûka-zûba banarhangira okugenda”. <verse eid="NUM 10:5"/><verse number="6" style="v" sid="NUM 10:6"/>“Erhi bankashubibûha eyôla mishekera eshakanya obwa kabirhi, balya bahanda olunda lw’emukondwè, banalikûla nabo. Kandi banashubiyibûha eshakanye amango g’okugenda loshi”. <verse eid="NUM 10:6"/><verse number="7" style="v" sid="NUM 10:7"/>“Wanakaziyibûha amango okola wahamagala olubaga omu ndêko, ci agôla mango erhashakanyagya”. <verse eid="NUM 10:7"/><verse number="8" style="v" sid="NUM 10:8"/>“Abadâhwa bene Aroni bo bakazibûha eyôla mishekera, okwo kwâbà irhegeko ly’ensiku zoshi, omu ngasi bûko bwinyu”. <verse eid="NUM 10:8"/><verse number="9" style="v" sid="NUM 10:9"/>“Amango mukabà mwaja oku matabâro omu cihugo cinyu, mukola mwajilwîsa omushombanyi olibatulakwo entambala, mwanabûha emishekera eshakanye, na Nyamubâho, Nyamuzinda winyu, anamuyumvirhiza, na ntyo anabayôkola kuli abôla bashombanyi binyu”. <verse eid="NUM 10:9"/><verse number="10" style="v" sid="NUM 10:10"/>“Omu nsiku z’obusîme, omu nsiku nkulu zinyu, n’amango mukuzamwo omwêzi nka gwamabaluka, mwanakazibûha emishekera, nka mukola mwarherekêra enterekêro y’ensirîra n’e­ nterekêro y’omurhûla, mwanabûha eyôla mishekera ebè kakengêzo embere za Nyamuzinda winyu. Nie Nyamubâho, Nyamuzinda winyu”».<verse eid="NUM 10:10"/></para>
  <para style="s1">Okurhenga oku Sînayi</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 10:11"/>Oku mwâka gwa kabirhi<note caller="+" style="f"><char style="fr" closed="false">10, 11 </char><char style="ft" closed="false">Erhi wankalola omu <char style="xt"><ref loc="EXO 19:1">Lub 19, 1</ref></char>, wanabona oku bene-Israheli bahikaga omu irungu lya Sînayi enyuma lya myêzi isharhu barhenzire e Mîsiri.</char></note>, omu nsiku makumi abirhi z’omwêzi gwa kabirhi ecitù carhenga oku Ndâro y’obuhamîrizi. <verse eid="NUM 10:11"/><verse number="12" style="v" sid="NUM 10:12"/>Bene Israheli bashubihira njira, barhenga omw’irungu lya Sînayi, cirya citù cagendiyimanga omw’irungu lya Parani. <verse eid="NUM 10:12"/><verse number="13" style="v" sid="NUM 10:13"/>Erhi bakola bagenda obwôla bwa burhanzi, bashimba kulya Nyamubâho arhegekaga Mûsa. <verse eid="NUM 10:13"/><verse number="14" style="v" sid="NUM 10:14"/>Ibendêra ly’ecihando ca bene Yûda lyagenda lya burhanzi, nk’oku emirhwe yâbo yanali, n’omurhwe gwa bene Yûda gwàli gurhegesirwe n’omurhambo Nashoni, mwene Aminadabu; <verse eid="NUM 10:14"/><verse number="15" style="v" sid="NUM 10:15"/>Omurhwe g’obûko bwa bene Isakari gwàli gurhegesirwe n’omurhambo Natanaeli, mwene Suari; <verse eid="NUM 10:15"/><verse number="16" style="v" sid="NUM 10:16"/>Omurhwe g’obûko bwa bene Zabuloni gwàli gurhegesirwe n’omurhambo Eliabu, mwene Heloni. <verse eid="NUM 10:16"/><verse number="17" style="v" sid="NUM 10:17"/>Endâro yanacigwikûlwa, bene Gershoni na bene Merari bagendana eyôla Ndâro. <verse eid="NUM 10:17"/><verse number="18" style="v" sid="NUM 10:18"/>Ibendêra ly’ecihando ca bene Rubeni nalyo lyagenda, nk’oku emirhwe yâbo yanali, n’omurhwe gwa bene Rubeni gwàli gurhegesirwe n’omurhambo Elisuri, mwene Sedeuri. <verse eid="NUM 10:18"/><verse number="19" style="v" sid="NUM 10:19"/>Omurhwe gw’obûko bwa bene Simoni gwàli gurhegesirwe n’omurhambo Shelumieli, mwene Surishadayi; <verse eid="NUM 10:19"/><verse number="20" style="v" sid="NUM 10:20"/>n’omurhwe gw’obûko bwa bene Gadi gwàli gurhegesirwe n’omurhambo Eliasafu, mwene Dueli. <verse eid="NUM 10:20"/><verse number="21" style="v" sid="NUM 10:21"/>Bene Kehati nabo bagenda erhi babarhwîre ebirugu bimâna, abandi bakazigwika Endâro oku balinda bayisha. <verse eid="NUM 10:21"/><verse number="22" style="v" sid="NUM 10:22"/>Ibendêra ly’ecihando ca bene Efrayimu nalyo lyagenda, nk’oku emirhwe yâbo yanali, n’omurhwe gwa bene Efrayimu gwàli gurhegesirwe n’omurhambo Elishamaʿ, mwene Amiyudi. <verse eid="NUM 10:22"/><verse number="23" style="v" sid="NUM 10:23"/>Omurhwe gw’obûko bwa bene Menashè, gwàli gurhegesirwe n’omurhamho Gamalieli, mwene Pedasuri, <verse eid="NUM 10:23"/><verse number="24" style="v" sid="NUM 10:24"/>n’omurhwe gw’obûko bwa bene Benyamini, gwàli gurhegesirwe n’omurhambo Abidani, mwene Gedeoni. <verse eid="NUM 10:24"/><verse number="25" style="v" sid="NUM 10:25"/>Ibendêra ly’ecihando ca bene Dani nalyo lyagenda, nk’oku emirhwe yanali: gwo gwàli murhwe muzinda omu bihando byoshi. Omurhwe gwa Dani gwàli gurhegesirwe n’omurhambo Ahiyezeri, mwene Amishadayi; <verse eid="NUM 10:25"/><verse number="26" style="v" sid="NUM 10:26"/>omurhwe gw’obûko bwa bene Aseri gwàli gurhegesirwe n’omurhambo Pagieli, mwene Okrani, <verse eid="NUM 10:26"/><verse number="27" style="v" sid="NUM 10:27"/>n’omurhwe gwa bene Nefutali gwàli gurhegesirwe n’omurhambo Ahira, mwene Enani. <verse eid="NUM 10:27"/><verse number="28" style="v" sid="NUM 10:28"/>Kwo bakazâgikulikirana ntyo bene Israheli, nk’oku emirhwe yâbo yanali. Banacihira njira.<verse eid="NUM 10:28"/></para>
  <para style="s1">Mûsa n’ishazâla</para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 10:29"/>Mûsa anacibwîra ishazâla Hobabu, mwene Reweli, w’e Madiani erhi: «Rhukolaga rhwajà erya munda Nyamubâho aderhaga, erhi: Namuhà eyôla. Kanya rhugende rhweshi, rhwakujirira aminjà, bulya Nyamubâho alaganîne oku ajirira bene Israheli aminjà.» <verse eid="NUM 10:29"/><verse number="30" style="v" sid="NUM 10:30"/>Hobabu amushuza, erhi: «Ntayîshe, ci nacîshubirira omu cihugo câni n’omu mulala gwâni.» <verse eid="NUM 10:30"/><verse number="31" style="v" sid="NUM 10:31"/>Mûsa aderha, erhi: Nkuhûnyire, orharhurhengagakwo, bulya we omanyire ahantu rhwajà mwahanda omw’irungu, wajâ wâbà nk’izù lîrhu. <verse eid="NUM 10:31"/><verse number="32" style="v" sid="NUM 10:32"/>Okayisha haguma nîrhu, rhwanayishigabâna birya binjà Nyamubâho ânarhuhe.<verse eid="NUM 10:32"/></para>
  <para style="s1">Okugenda</para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 10:33"/>Amango barhengaga oku ntondo ya Nyamubâho<note caller="+" style="f"><char style="fr" closed="false">10, 33 </char><char style="ft" closed="false">Bwo burhanzi obu 'Sînayi' aderhwa ntondo ya Nyamubâho. Amango barhengaga e Mîsiri, bene Israheli bàli barheganyize lugendo lwa nsiku isharhu embere barherekêre (<char style="xt"><ref loc="EXO 3:18">Lub 3, 18</ref>; <ref loc="EXO 5:3">5, 3</ref></char>).</char></note>, bajira nsiku isharhu, bagenda, na muli olwôla lugendo lw’ensiku isharhu, omucîmba gw’amalaganyo ga Nyamubâho gwajà gwabashokolera, gwajà gwabalongeza aha barhamukira. <verse eid="NUM 10:33"/><verse number="34" style="v" sid="NUM 10:34"/>Ecitù ca Nyamubâho cakâgija cayêrêra enyanya zâbo mûshi, nka bamârhenga omu cihando. <verse eid="NUM 10:34"/><verse number="35" style="v" sid="NUM 10:35"/>Erhi omucîmba gw’amalaganyo gwagendaga, Mûsa anaderha, erhi: «Yimuka, Nyamubâho, abanzi bâwe bashandabane! Abakushomba bahirigirhe embere zâwe!» <verse eid="NUM 10:35"/><verse number="36" style="v" sid="NUM 10:36"/>Na erhi gwayimanga, Mûsa anaderhe, erhi: «Hindamuka, Yâgirwa Nyamubâho, oyêrekere ogûla mwandu gw’ebihumbi bya bene Israheli.»<verse eid="NUM 10:36"/></para>
  <chapter eid="NUM 10"/>
  <chapter number="11" style="c" sid="NUM 11"/>
  <para style="ms1">V. Olugendo omu irungu</para>
  <para style="s1">Okucîduduma kw’olubaga</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 11:1"/>Olubaga lwarhondêra okucîdudumira kubî omu kurhwiri kwa Nyamubâho. Nyamubâho ayumva okwôla, n’oburhè bwâge bwayâka bwenêne, omuliro gwa Nyamubâho gwayâka kuli bo, gwarhondêra okuyôca eburhambi bw’ecihando. <verse eid="NUM 11:1"/><verse number="2" style="v" sid="NUM 11:2"/>Olubaga lwalakira emunda Mûsa ali, naye Mûsa ajishenga Nyamubâho, gulya muliro gwanacizima. <verse eid="NUM 11:2"/><verse number="3" style="v" sid="NUM 11:3"/>Abôla hantu bahayîrika izîno lya Tabera<note caller="+" style="f"><char style="fr" closed="false">11, 3 </char><char style="ft" closed="false">Tahera kuli kuderha bwokêre (bwihîrà). Nyamubâho abanîka kw’omuliro, gwakola omwônè (<char style="xt"><ref loc="DEU 9:22">Lush 9, 22</ref></char>).</char></note>, bulya omuliro gwa Nyamubâho gwayâsire kuli bo. <verse eid="NUM 11:3"/><verse number="4" style="v" sid="NUM 11:4"/>Cirundo ca bantu baguma muli bene Israheli carhondêra okuyumva akagegene, ciru na bene Israheli banji bashubirhondêra okucîlasa, mpu: «Ndi wankarhuha enyama rhwalya? <verse eid="NUM 11:4"/><verse number="5" style="v" sid="NUM 11:5"/>Rhwamadula zirya nfî rhwakagilya busha busha konene e Mîsiri, rhwamadula gulya mundagwè, galya malehe, birya bitumbura na balya bapwaro bîrhu. <verse eid="NUM 11:5"/><verse number="6" style="v" sid="NUM 11:6"/>Rhwono rhukola rhwayumira enôla munda oku busha! Amasù gîrhu garhabona agarhali agâla mâna». <verse eid="NUM 11:6"/><verse number="7" style="v" sid="NUM 11:7"/>Agôla mâna gàli nka mogomogo za mahemba, n’oku nshusho gàli gashushire obulo. <verse eid="NUM 11:7"/><verse number="8" style="v" sid="NUM 11:8"/>Olubaga lwakazishandabana lukola lwajigarhôla; kandi lwanagashwera oku lwanjikwa nîsi erhi okugashakulira omu cishakulo; lwakazigayendera aha nyungu nîsi erhi okujiramwo emigati. Gali gagwêrhe obununu bw’omugati gwajiragwa n’amavurha. <verse eid="NUM 11:8"/><verse number="9" style="v" sid="NUM 11:9"/>Erhi olumè lwarhogeraga omu mashwa budufu, lyo n’agôla mâna gakazâgiyandagala nago.<verse eid="NUM 11:9"/></para>
  <para style="s1">Obulagizi bwa Mûsa</para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 11:10"/>Mûsa ayumva oku olubaga ludwîrhe lwacîduduma omu ngasi mulala, ngasi muguma aha c’olusò lw’enyumpa yâge. Oburhè bwa Nyamubâho bwayâka bwenêne. Mûsa akunira, <verse eid="NUM 11:10"/><verse number="11" style="v" sid="NUM 11:11"/>anacibwîra Nyamubâho, erhi: «Carhumaga ojirira mwambali wâwe mabî ga bene agâla, carhumaga nka nalintonyire omu masù gâwe, ombarhuza omuzigo gw’olubaga lwa bene olu? <verse eid="NUM 11:11"/><verse number="12" style="v" sid="NUM 11:12"/>“Ka nie nasingaga olûla lubaga? Ka nie naluburhaga, okwôla nkaba kwanarhuma wambwîra, erhi: Ohugirage oku nda yâwe, nka kula omuzîre ahêka omwâna akola amuyonsa, kuhika muli cirya cihugo wahigaga mpu wahà ababusi bâbo”. <verse eid="NUM 11:12"/><verse number="13" style="v" sid="NUM 11:13"/>“Ngahigi nakûla enyama nahà olu lubaga lôshi? Bulya lwandibuzize n’okulaka omu kuderha”, erhi: “Rhubè nîrhu enyama rhwalya”. <verse eid="NUM 11:13"/><verse number="14" style="v" sid="NUM 11:14"/>“Ntankahasha niene niene okuhêka olûla lubaga; luli luzirho bwenêne kuli nie”. <verse eid="NUM 11:14"/><verse number="15" style="v" sid="NUM 11:15"/>“Ahâli h’okunjira ntyâla, nkusengîre onyîrhe erhi kwo, akabà obwîne ntonyire omu masù gâwe, n’akabà orhalonza mbone obuhanya!”»<verse eid="NUM 11:15"/></para>
  <para style="s1">Nyamubâho ashuza Mûsa</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 11:16"/>Nyamubâho abwîra Mûsa, erhi: «Nshubûlizagya balume makumi gali nda omu bashamuka bene Israheli, balya bakola bantu bakulu banagwêrhe obuhashe oku bandi: obalêrhe aha Ihêma ly’embugânano, babere ahôla mweshi nabo. <verse eid="NUM 11:16"/><verse number="17" style="v" sid="NUM 11:17"/>“Nayishibunguluka nshambâle nâwe ahôla; narhôla kuli gulya mûka gukulikwo, nguhire kuli bo, lyo babarhula mweshi nabo ogwôla muzigo g’olubaga, na ntyôla orhacikazigubarhule wênewêne”. <verse eid="NUM 11:17"/><verse number="18" style="v" sid="NUM 11:18"/>“Ojibwîra olubaga”, erhi: “Mucîcêse oku lusiku lw’irhondo, lyo mwahâbwa enyama mwalya kulya mwakazâgilakira omu marhwiri ga Nyamubâho muderha” mpu: “Ndi wankacirhulisa nîrhu oku nyama? Bulya rhwàli rhucibêrîre bwinjà e Mîsiri! Na Nyamubâho âmuhà e­nyama mwanalya”. <verse eid="NUM 11:18"/><verse number="19" style="v" sid="NUM 11:19"/>“Arhali lusiku luguma lônene mwayirya, arhali nsiku ibirhi zonène, arhali nsiku irhanu zonène, arhali nsiku ikumi zonène nîsi erhi makumi abirhi gônene”. <verse eid="NUM 11:19"/><verse number="20" style="v" sid="NUM 11:20"/>“Ci mwêzi mugumagumà goshi kuhika zimuyîshe emazulu, zimuyihike ebwa kubà mwahakanyire Nyamubâho oli ekarhî kinyu, mwanalakire embere zâge ene mukaziderha”, mpu: “Carhumaga rhurhenga e Mîsiri”». <verse eid="NUM 11:20"/><verse number="21" style="v" sid="NUM 11:21"/>Mûsa ederha, erhi: «Olûla lubaga ndi ekarhî kâlwo, luli lwa bantu bihumbi magana gali ndarhu bagenda n’amagulu, wanabuliderha, erhi: “Nabahà enyama balya omwêzi goshi!” <verse eid="NUM 11:21"/><verse number="22" style="v" sid="NUM 11:22"/>“Ka rhukolaga rhwababâgira ebibuzi n’enkafu lyo babona ngasi muguma hirya hinakwânîne?”» <verse eid="NUM 11:22"/><verse number="23" style="v" sid="NUM 11:23"/>Nyamubâho ashuza Mûsa, erhi: «K’okuboko kwa Nyamubâho kwayofiha bwenêne nici? Okolaga wabona erhi okwôla nakubwîraga kwabà erhi nanga».<verse eid="NUM 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 11:24"/>Mûsa ahuluka ajibwîra olubaga ebyôla binwa bya Nyamubâho, anacishûbûza bagula makumi gali nda omu bashamuka bakulu b’olubaga, abahira eburhambi bw’Ihêma. <verse eid="NUM 11:24"/><verse number="25" style="v" sid="NUM 11:25"/>Nyamubâho ayandagala omu citù, anacishambâla na Mûsa, ayanka kuli gulya mûka gwamulikwo, aguhirakwo balya bagula makumi gali nda; n’oku ogwôla mûka gwanabajakwo ntya, barhondêra okulêba; ci barhaciyûshûlaga. <verse eid="NUM 11:25"/><verse number="26" style="v" sid="NUM 11:26"/>Bantu babirhi, muguma izîno lyâge ye wali Eldadi, n’owundi Medadi, bàli basigîre oku cihando, nabo mûka abajakwo; bàli omu bayandisirwe, ci barhahashagija ebw’Ihêma; nabo barhondêra okulêbera omu cihando. <verse eid="NUM 11:26"/><verse number="27" style="v" sid="NUM 11:27"/>Mwâna muguma wa musole akanya agendibwîra Mûsa, erhi: «Eldadi na Medadi badwîrhe balêbera omu cihando.» <verse eid="NUM 11:27"/><verse number="28" style="v" sid="NUM 11:28"/>Ho na halya, Yozwè, mwene Nuni, abâga murhumisi wa Mûsa kurhenga eburhò bwâge, ajà omu kanwa aderha, erhi: «Mâshi yâgirwa Nnawîrhu Mûsa, obahanze.» <verse eid="NUM 11:28"/><verse number="29" style="v" sid="NUM 11:29"/>Mûsa amushuza, erhi: «Ka wamambonera obumvu? Owabona Nyamuzinda ahindula olubaga lwa Nyamubâho lwoshi lukola lwakazilêba, na Nyamubâho ahire omûka gwâge kulibo!» <verse eid="NUM 11:29"/><verse number="30" style="v" sid="NUM 11:30"/>Mûsa acîshubirira omu cihando n’abagula b’Israheli.<verse eid="NUM 11:30"/></para>
  <para style="s1">Empirahira</para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 11:31"/>Oku irhegeko lya Nyamubâho, empûsi yanacihûsa; eyo mpûsi yarhenga e­bwa nyanja, yayisha edwîrhe empirahira, yazihunika oku cihando, n’ahôla zàgwâga, obulî bwaho bwàli bwa igenda lya mulegerege muguma lunda luguma n’olundi lunda lindi igenda lya mulegerege muguma, eburhambi bw’ecihando n’oku zàli zilundumine kwo kuhêka enyanya, bwàli burherema bwa makoro abirhi kurhenga okw’idaho. <verse eid="NUM 11:31"/><verse number="32" style="v" sid="NUM 11:32"/>Olwôla lusiku loshi, n’obudufu bwoshi, n’erhi buca, olubaga lwarhondêra lwagwârha ezôla mpirahira; owali gwâsire nsungunu àli ahisire omu homori<note caller="+" style="f"><char style="fr" closed="false">11, 32 </char><char style="ft" closed="false">Homori: guli mulengo gwa litri nka 4, 50 (lolà omu <char style="xt"><ref loc="EXO 16:36">Lub 16, 36</ref></char>). Ehomori ciri cihimbi ca kali ikumi c’efa. Efa guli mulengo gwa litri 45.</char></note> ikumi; bayanika ebyôla byâbo eburhambi bw’ecihando coshi. <verse eid="NUM 11:32"/><verse number="33" style="v" sid="NUM 11:33"/>Ci oku enyama zicibali ekanwa omu mîno barhacimira, oburhè bwa Nyamubâho bwanaciyâkira oku lubaga; Nyamubâho abalambika­ mwo banji bwenêne là. <verse eid="NUM 11:33"/><verse number="34" style="v" sid="NUM 11:34"/>Ahôla hantu bahayîrika izîno lya Kibroti-Hatava, e­bwa kubà ahôla ho babishaga lulya lubaga lwagomaga erhi kagegene karhuma. <verse eid="NUM 11:34"/><verse number="35" style="v" sid="NUM 11:35"/>Kurhenga aha Kibroti-Hatava, olubaga lwajà e Heseroti, lwanahanda ahôla Haseroti.<verse eid="NUM 11:35"/></para>
  <chapter eid="NUM 11"/>
  <chapter number="12" style="c" sid="NUM 12"/>
  <para style="s1">Miriamu na Aroni bashomba Mûsa</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 12:1"/>Miriamu n’Aroni, barhondêra okuderhaderha kubî Mûsa erhi omukazi w’omukûshi ayankaga orhuma. Ebwa kubà amayanka omukazi w’omukûshi. <verse eid="NUM 12:1"/><verse number="2" style="v" sid="NUM 12:2"/>Banacirhondêra okuderha, mpu: «Ka Nyamubâho kuli Mûsa yênene aderhera? K’arhaderheraga kuli rhwe rhwêki?» Nyamubâho anaciyumva okwôla. <verse eid="NUM 12:2"/><verse number="3" style="v" sid="NUM 12:3"/>Ci Mûsa acibêraga muntu mutûdu bwenêne, kulusha abandi bantu boshi ba hanôla igulu. <verse eid="NUM 12:3"/><verse number="4" style="v" sid="NUM 12:4"/>Mw’akola kanya konênè, Nyamubâho abwîra Mûsa, Aroni na Miriamu, erhi: «Muhuluke oku muli basharhu, mujè e­ bw’Ihêma ly’embugânano.» Banacihuluka oku bali basharhu.<verse eid="NUM 12:4"/></para>
  <para style="s1">Nyamubâho atumuza Miriamu na Aroni obubî bwâbo</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 12:5"/>Nyamubâho ayandagala omu nkingi y’ecitù, agendibêra aha lusò lw’Ihêma. Ahamagala Aroni na Miriamu, nabo oku bali babirhi bayegêra. <verse eid="NUM 12:5"/><verse number="6" style="v" sid="NUM 12:6"/>Anacibabwîra, erhi: «Yumvi bwinjà ebinwa byâni: “Akabà hali mulêbi wa Nyamubâho mugwêrhe, omu bilôrho mwo ncîmanyisa emwâge, omu bilôrho mmuderhegeza”. <verse eid="NUM 12:6"/><verse number="7" style="v" sid="NUM 12:7"/>“Ci mwambali wâni Mûsa arhali ntyôla; amanyîkîne bwinjà oku ali muntu nkana munôla nyumpa yâni yoshi”. <verse eid="NUM 12:7"/><verse number="8" style="v" sid="NUM 12:8"/>“Nankazimushambâza rhuyerekezanye akanwa, nciyêreke ye ci ntamushambaliza omu migani, yêne anahashilolêreza obusù bwa Nyamubâho. Carhumirage murharhînya okujà kwaderhaderha kubî mwambali wâni Mûsa?”» <verse eid="NUM 12:8"/><verse number="9" style="v" sid="NUM 12:9"/>Oburhè bwa Nyamubâho bwanaciyâka bwenêne kuli bo; anacicîgendera; ecitù canacicîyêgûla kulya nyanya ly’Ihêma. <verse eid="NUM 12:9"/><verse number="10" style="v" sid="NUM 12:10"/>Na, k’orhabona! Miriamu amahinduka wa lushomyo, akola mwêru nka lubula. Aroni ayêrekera emunda Miriamu ali, alola oku akola mushomyo.<verse eid="NUM 12:10"/></para>
  <para style="s1">Obulagizi bwa Aroni na Mûsa</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 12:11"/>Aroni anacibwîra Mûsa, erhi: «Mâshi Yâgirwa, nnawîrhu, omanye wankarhubarhuza ecîra câha rhwâjiraga omu kuhalanjika, rhunakwânîne n’obuhane bwâco. <verse eid="NUM 12:11"/><verse number="12" style="v" sid="NUM 12:12"/>Mâshi arhabâga nka mwâna wa cifù, ye rhenga omu nda ya nina erhi n’omubiri gumonyôsire!» <verse eid="NUM 12:12"/><verse number="13" style="v" sid="NUM 12:13"/>Mûsa anacishenga Nyamubâho aderha, erhi: «Mâshi, Nyamuzinda nkusengîre, omufumye!» <verse eid="NUM 12:13"/><verse number="14" style="v" sid="NUM 12:14"/>Nyamubâho anacibwîra Mûsa, erhi: «Îshe acimukayiraga ebusù arhankageza nsiku nda erhi ayunjwîre nshonyi? Ayôrhe nsiku nda muyungule embuga ly’ecihando; enyuma z’ahôla banashubimuyankirira omwôla cihando.» <verse eid="NUM 12:14"/><verse number="15" style="v" sid="NUM 12:15"/>Miriamu nsiku nda ali muyungule embuga ly’ecihando, n’olubaga lurhahashigigenda, kuhika Miriamu ashubiyankirirwa. <verse eid="NUM 12:15"/><verse number="16" style="v" sid="NUM 12:16"/>Enyuma z’aho, olubaga lwarhenga ahôla Haseroti, bâge­ndihânda omu irungu lya Parani.<verse eid="NUM 12:16"/></para>
  <chapter eid="NUM 12"/>
  <chapter number="13" style="c" sid="NUM 13"/>
  <para style="s1">Enyenzi zàrhumwa e Kanâni</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 13:1"/>Nyamubâho anacibwîra Mûsa, erhi: <verse eid="NUM 13:1"/><verse number="2" style="v" sid="NUM 13:2"/>«Orhume abantu bagendiyênja ecihugo ca Kanâni, co cihugo nâhà bene Israheli. Ojè warhuma muguma muguma omu ngasi bûko; n’abôla warhuma kukwânîne babè b’omu barhambo bâbo.» <verse eid="NUM 13:2"/><verse number="3" style="v" sid="NUM 13:3"/>Mûsa abarhuma kurhenga omwôla irungu lya Parani nk’okwôla Nyamubâho anarhegekaga; abôla barhambo barhumagwa bàli barhambo ba muli bene Israheli. <verse eid="NUM 13:3"/><verse number="4" style="v" sid="NUM 13:4"/>Alaga amazîno gâbo: omu bûko bwa Rubeni, Shamuwa, mwene Zakuru. <verse eid="NUM 13:4"/><verse number="5" style="v" sid="NUM 13:5"/>Omu bûko bwa Simoni, Shafati, mwene Hori, <verse eid="NUM 13:5"/><verse number="6" style="v" sid="NUM 13:6"/>omu bûko bwa Yûda, Kalebu mwene Yefunè, <verse eid="NUM 13:6"/><verse number="7" style="v" sid="NUM 13:7"/>omu bûko bwa Isakari, lgali, mwene Yozefu. <verse eid="NUM 13:7"/><verse number="8" style="v" sid="NUM 13:8"/>Omu bûko bwa Efrayimu, Oseyi, mwene Nuni, <verse eid="NUM 13:8"/><verse number="9" style="v" sid="NUM 13:9"/>omu bûko bwa Benyamini, Palti, mwene Rafu, <verse eid="NUM 13:9"/><verse number="10" style="v" sid="NUM 13:10"/>omu bûko bwa Zabuloni, Gadieli, mwene Sodi, <verse eid="NUM 13:10"/><verse number="11" style="v" sid="NUM 13:11"/>Omu bûko bwa Yozefu, bwa Menashè, Gadi, mwene Susi, <verse eid="NUM 13:11"/><verse number="12" style="v" sid="NUM 13:12"/>omu bûko bwa Dani, Amieli, mwene Gemali, <verse eid="NUM 13:12"/><verse number="13" style="v" sid="NUM 13:13"/>omu bûko bwa Aseri, Seturi, mwene Mikaeli. <verse eid="NUM 13:13"/><verse number="14" style="v" sid="NUM 13:14"/>Omu bûko bwa Nefutali, Nahabi, mwene Vafusi, <verse eid="NUM 13:14"/><verse number="15" style="v" sid="NUM 13:15"/>omu bûko bwa Gadi, Geweli, mwene Maki. <verse eid="NUM 13:15"/><verse number="16" style="v" sid="NUM 13:16"/>Agôla go mazîno g’abantu barhumagwa mpu bâge­ndiyênja ecihugo. Mûsa ayîrika Oseyi mwene Nuni izîno lya Yozwè.<verse eid="NUM 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 13:17"/>Mûsa abarhuma mpu hagendiyênja ecihugo ca Kanâni; ababwîra, erhi: «Musôkere eyôla munda omu kugerera e Nêgebu; musôke oku ntondo. <verse eid="NUM 13:17"/><verse number="18" style="v" sid="NUM 13:18"/>Mulolêreze bwinjà kurhi ecihugo ciyôsire, abantu bayûbakamwo, akabà bali bazibu erhi nanga, akabà bali banyi erhi mwandu. <verse eid="NUM 13:18"/><verse number="19" style="v" sid="NUM 13:19"/>Mulolêreze ecôla cihugo, bantu bayûbakamwo, kurhi ciri, akabà ciri cinjà erhi cibî; mulole ebishagala bayûbakamwo kurhi biri, akabà biri bizibuzibu nîsi erhi biri biyîgule hoshi. <verse eid="NUM 13:19"/><verse number="20" style="v" sid="NUM 13:20"/>Mulole kurhi obudaka buyôsire, erhi buli bwinjà erhi nanga burhali bo, mulole erhi ciri mwo n’emirhi nîsi erhi nanga. Mubè n’oburhwâli, murhôle oku malehe g’ecôla cihugo». Gàli mango g’okutwa emizâbîbu mirhanzi.<verse eid="NUM 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 13:21"/>Basôka, bajà bayenjayenja ecihugo, kurhenga okw’irungu lya Sini kuhika e Rehobu, oku njira yajà e Hamati. <verse eid="NUM 13:21"/><verse number="22" style="v" sid="NUM 13:22"/>Basôka omu Nêgebu, bahika cingana e Hebroni, emunda Akimani, Sheshayi na Talmayi, bene Anaki bayûbakaga. Hebroni ayûbakagwa myâka nda embere lya Sowani w’e Mîsiri. <verse eid="NUM 13:22"/><verse number="23" style="v" sid="NUM 13:23"/>Erhi bahika omu kabanda ka Eskoli batwa ishami ly’omuzâbîbu n’olusisi lw’ogôla muzâbîbu, bayisha balibarhwire bantu babirhi oku murhamba, barhôla n’agandi malehe g’amakomamanga n’emitini. <verse eid="NUM 13:23"/><verse number="24" style="v" sid="NUM 13:24"/>Ahôla bahayîrika izîno ly’akabanda ka Eskoli, erhi olwôla lusisi lw’omuzâbîbu bene Israheli batwâga lwo lurhuma. <verse eid="NUM 13:24"/><verse number="25" style="v" sid="NUM 13:25"/>Enyuma lya nsiku makumi anni kurhenga eyôla munda balijiriyênja ecihugo, <verse eid="NUM 13:25"/><verse number="26" style="v" sid="NUM 13:26"/>bayisha bayishire bajà emunda Mûsa ali n’Aroni, n’endêko ya bene Israheli boshi aha Kadesi, omw’irungu lya Parani. Bababwîra emyanzi nka kulya banarhumagwa; bashambalira n’olubaga loshi, banabayêreka amelehe ga ecôla cihugo.<verse eid="NUM 13:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 13:27"/>Yumvagya oku bashambaliraga Mûsa: «Nêci rhwanajîrage mwa cirya cihugo wanarhurhumagamwo. Okunali ciri cihugo cihululamwo amarhà n’obûci, agâla malehe gône gakumanyise. <verse eid="NUM 13:27"/><verse number="28" style="v" sid="NUM 13:28"/>“Ci olubaga luyûbaka ecôla cihugo luli ludârhi, n’ebishagala byâbo biri bizibuzibu na binene bwenêne; ciru rhwanashimanyiremwo bene Anaki”. <verse eid="NUM 13:28"/><verse number="29" style="v" sid="NUM 13:29"/>“Amaleki ayûbaka ecihugo ca Nêgebu, omu­nya-Hiti, omunya-Yebusi n’omunya-Mori bayûbaka omu ntondo, n’omu­nya-Kanâni ayûbaka oku burhambi bw’enyanja n’oku burhambi bwa Yordani.”»<verse eid="NUM 13:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 13:30"/>Kalebu ayimuka abwîra olubaga lwàli luzonzire Mûsa, erhi: «Yumvi mmubwîre. Kanyi rhusôkere eyôla munda rhurhôle ecôla cihugo bulya rhwanakuhasha.» <verse eid="NUM 13:30"/><verse number="31" style="v" sid="NUM 13:31"/>Ci abandi bantu bàli barheremire naye baderha, mpu: «Rhurhankahasha okusôka mpu rhujilwîsa olwôla lubaga, luli ludârhi kurhulusha». <verse eid="NUM 13:31"/><verse number="32" style="v" sid="NUM 13:32"/>Barhondêra okushambâla kubî kubî oku biyêrekîre ecôla cihugo balijiriyênja, bakaziderha, mpu: «Ecihugo rhwalijiriyênja, ciri cihugo cirya bene co<note caller="+" style="f"><char style="fr" closed="false">13, 32 </char><char style="ft" closed="false">Cihugo cirya bene co* kwo kuderha ecihugo cirhankalamirwamwo, cirhankayûbakwa­ mwo, bulya cirimwo endwâla, cirhayêra, ciyunjwîre biryanyi byône, erhi bulya cilugamwo ebîrha.</char></note>, abantu rhwabwîne muli ecôla cihugo bali bantu balî-balî. <verse eid="NUM 13:32"/><verse number="33" style="v" sid="NUM 13:33"/>“Ciru rhwabwinemwo balya bantu banene-banene, bene Anaki, bulya bûko bw’abantu bahamu bwenêne: rhwàli embere zâbo n’omu masù gâbo, nka mahanzi.”»<verse eid="NUM 13:33"/></para>
  <chapter eid="NUM 13"/>
  <chapter number="14" style="c" sid="NUM 14"/>
  <para style="s1">Akavango n’obuhane</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 14:1"/>Olubaga lwoshi lwalogôshera, lwabanda orhuhababo, lwalakûla obwôla budufu boshi. <verse eid="NUM 14:1"/><verse number="2" style="v" sid="NUM 14:2"/>Bene Israheli boshi bakazicîdudumira Mûsa n’Aroni, n’endêko yoshi yababwîra, erhi: «Ka rhurhankafirire omu cihugo c’e Mîsiri nîsi erhi munôla irungu erhimwo.» <verse eid="NUM 14:2"/><verse number="3" style="v" sid="NUM 14:3"/>Carhuma Nyamubâho arhuhêka muli ecôla cihugo, omu engôrho yagendirhumalirira? Bak’irhwe n’abâna bîrhu bakolaga bagendiba mpira zâbo. Ka kurhali kwinjà kuli rhwe rhucîshubirire e Mîsiri erhi kwo? <verse eid="NUM 14:3"/><verse number="4" style="v" sid="NUM 14:4"/>Banacibwîrana bône nannene, mpu: «Rhucishoge owîrhu murhambo, rhucîshubirire e Mîsiri»<verse eid="NUM 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 14:5"/>Mûsa n’Aroni banacikumba bûbi embere za bene Israheli boshi. <verse eid="NUM 14:5"/><verse number="6" style="v" sid="NUM 14:6"/>Yozwè, mwene Nuni na Kalebu, mwene Yefunè, bantu babirhi omu bagendigiyenja ecihugo, basharhula emyambalo yâbo. <verse eid="NUM 14:6"/><verse number="7" style="v" sid="NUM 14:7"/>Banacibwîra endêko ya bene Israheli yoshi, mpu: «Ecihugo rhwageziremwo coshi nti rhucilorereze, ciri cihugo cinjà bwenê. <verse eid="NUM 14:7"/><verse number="8" style="v" sid="NUM 14:8"/>Nka Nyamuzinda arhurhonyize yêne anarhuhêka muli ecôla cihugo, anarhuheco, ciri cihugo cadubukamwo amarhà n’obûci. <verse eid="NUM 14:8"/><verse number="9" style="v" sid="NUM 14:9"/>Ci kwônene murhahîra mukagomera Nyamubâho, murhanayôbohaga abantu abantu bali muli ecôla cihugo, bulya rhwabahungumula, owakazâgibalanga acîyegwîre kuli bo, na Nyamubâho ali haguma nîrhu, murhabayobôhe.»<verse eid="NUM 14:9"/></para>
  <para style="s1">Oburhè bwa Nyamubâho n’obulagizi bwa Mûsa</para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 14:10"/>Olubaga lwoshi lwahiga mpu lukola lwababanda amabuye, ci agôla mango irenge lya Nyamubâho lyanacîyêrekana oku Ihêma ly’embugânano embere za Bene Israheli boshi. <verse eid="NUM 14:10"/><verse number="11" style="v" sid="NUM 14:11"/>Nyamubâho anacibwîra Mûsa, erhi: «Kuhika mangaci erhi lwanabula okunyêmêra n’obwôla ludwîrhe lwabona ebisômerîne ndwîrhe najira ekarhî kâbo. <verse eid="NUM 14:11"/><verse number="12" style="v" sid="NUM 14:12"/>Nkolaga naluhunikakwo ecihûsi, mmbamalîre, wêne mbè we njira ishanja linene kulusha na lizibu kulusha eri.» <verse eid="NUM 14:12"/><verse number="13" style="v" sid="NUM 14:13"/>Mûsa anacibwîra Nyamubâho, erhi: «Abantu b’e Mîsiri bayishi oku okuboko kwâwe kudârhi warheremagyamwo abâla bantu kurhenga emwâbo, n’okwôla bakumanyisize abantu b’ecôla cihugo. <verse eid="NUM 14:13"/><verse number="14" style="v" sid="NUM 14:14"/>Boshi bayishi oku w’oyu Nyamubâho, ôbà ekarhî k’olu lubaga; oku onakazicîyêrekana emwâbo busù oku busù, w’oyu Nyamubâho; bayishi oku ecitù câwe cibà enyanya zâbo, bayishi oku onakazigenda embere zâbo mûshi omu nkingi y’omuliro. <verse eid="NUM 14:14"/><verse number="15" style="v" sid="NUM 14:15"/>Erhi wankayîrha olu lubaga luhungumuka nka muntu muguma, amashanja gayumvagya ebyadesirwe kuli we gakolaga gayishiderha erhi: <verse eid="NUM 14:15"/><verse number="16" style="v" sid="NUM 14:16"/>Nyamuzinda arhali agwêrhe obuhashe b’okuhêka olubaga muli cirya cihugo alagânanaga mpu abahà co; banaderha mpu co cirhumire abayirhira muno irungu.»<verse eid="NUM 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 14:17"/>Obuhashe bwa Nyakasane buyêrekanage bunôla oku bunabà bunene, nka kulya wanamanyisagya erhi oderha, erhi: <verse eid="NUM 14:17"/><verse number="18" style="v" sid="NUM 14:18"/>«Nyamubâho akêreza omu kukunira, abà na mugale omu bwinjà, anababalire amabî n’ecâha; ci arhankalola omuntu oli n’ecâha nka muntu mwêru kwêru, anahanire obubî bw’ababusi oku bâna bâbo, ciru n’oku bâna b’iburha lya kasharhu n’iburha lya kani. <verse eid="NUM 14:18"/><verse number="19" style="v" sid="NUM 14:19"/>“Yâgirwa, obabalire olûla lubaga kuli obûla bubî lujizire erhi bwonjo bwâwe bunji burhuma, obabalire nk’oku onayôrha obabalira olûla lubaga kurhenga e Mîsiri kuhika hanôla”».<verse eid="NUM 14:19"/></para>
  <para style="s1">Okubabalirwa n’obuhane</para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 14:20"/>Nyamubâho anacishuza, erhi: «Nababaliraga nk’okwôla onasengire; <verse eid="NUM 14:20"/><verse number="21" style="v" sid="NUM 14:21"/>“Ci, mbà nzîne! N’irenge lya Nyamubâho lyabumba igulu lyoshi!” <verse eid="NUM 14:21"/><verse number="22" style="v" sid="NUM 14:22"/>“Abantu boshi babwîne irenge lyâni n’ebisômerîne najiraga e Mîsiri na omw’irungu, abantu bamantangula kali ikumi<note caller="+" style="f"><char style="fr" closed="false">14, 22 </char><char style="ft" closed="false">Kal’ikumi kwo kuderha kanji bwenêne, karhahwa iganjo.</char></note>, barhanyumva izù lyâni”, <verse eid="NUM 14:22"/><verse number="23" style="v" sid="NUM 14:23"/>“abôla boshi barhabone kwo cirya cihugo nalaganyagya n’endahiro ababusi bâbo. Ntâye ciru n’omuguma muli balya bangayaguzagya wacilolakwo”. <verse eid="NUM 14:23"/><verse number="24" style="v" sid="NUM 14:24"/>“Ci mwambali wâni Kalebu yeki, waligwêrhe gundi gundi mûka, anayôsire acîshwêkire kuli nie, namuhisa muli ecôla cihugo alijîre, n’iburha lyâge lyaciyimamwo”. <verse eid="NUM 14:24"/><verse number="25" style="v" sid="NUM 14:25"/>“Omu­nya-Maleki, n’omunya-Kanâni bayûbasire omu kabanda: irhondo, moyo muhindamuke, mujè omw’irungu, omu njira y’ebwa nyanja ndukula”».<verse eid="NUM 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 14:26"/>Nyamubâho ashambâza Mûsa n’Aroni, ababwîra, erhi: <verse eid="NUM 14:26"/><verse number="27" style="v" sid="NUM 14:27"/>«Kuhika mangaci erhi nanayôrha nalembera olûla lubaga luli ntyâla, olwakaziyôrha lwacîduduma kuli nie. Nayumvîrhe eyôla midudumo ya bene Israheli kuli nie. <verse eid="NUM 14:27"/><verse number="28" style="v" sid="NUM 14:28"/>Ogendibabwîra oku mbà nzîne! Nyamubâho okudesire: namujirira nk’okwôla mwanaderheraga omu marhwiri gâni<note caller="+" style="f"><char style="fr" closed="false">14, 28 </char><char style="ft" closed="false">Okwôla mwanaderheraga omu marhwiri gâni: Israheli acîganya okubona arhacifìraga omw’irungu (mulongo gwa 2-4). Nyamubâho amamusama kanwa.</char></note>. <verse eid="NUM 14:28"/><verse number="29" style="v" sid="NUM 14:29"/>Ebirunda binyu munôla irungu byahungumukira. Mweshi mwe mwajiriragwa omubalè erhi muganjwa kurhenga oku wa myâka makumi abirhi kuhêka enyanya, mwe mwanacîdudumiraga kuli nie. <verse eid="NUM 14:29"/><verse number="30" style="v" sid="NUM 14:30"/>Murhahike muli cirya cihugo nalagânanaga nti najimuhiramwo, okuleka Kalebu mwene Yefunè na Yozwè, mwene Nuni. <verse eid="NUM 14:30"/><verse number="31" style="v" sid="NUM 14:31"/>N’abâna binyu barhôrho balya mwaderhaga mpu bakola bajibà nsimha za kuyîrhwa! Niehe nabahêka muli ecôla cihugo, bamanya ecôla cihugo mwagayaguzagya. <verse eid="NUM 14:31"/><verse number="32" style="v" sid="NUM 14:32"/>Ebirunda binyu mw’oyo, munôla irungu byahungumukira; <verse eid="NUM 14:32"/><verse number="33" style="v" sid="NUM 14:33"/>n’abâna hinyu bayabukana amasò gâbo munôla irungu, myâka makumi anni, bo bahêka ntyo obuhane bw’okubula obuyêmêre kwinyu, kuhika ebirunda binyu bihwêre munôla irungu. <verse eid="NUM 14:33"/><verse number="34" style="v" sid="NUM 14:34"/>Kulya mwagezagya nsiku makumi anni mwaja mwalolêreza ecihugo, ntyo kwo ensiku zàli, kwo n’emyâka yâbà: mwabarhula amabî ginyu myâka makumi anni<note caller="+" style="f"><char style="fr" closed="false">14, 34 </char><char style="ft" closed="false">Nsiku makumi anni na myâka makumi anni (<char style="xt"><ref loc="NUM 33:38">Mib 33, 38</ref>; <ref loc="EXO 16:35">Lub 16, 35</ref></char>).</char></note>. Mwanayumviza ahôla okucîberûla kuli nie bunguke buci kulêrha. <verse eid="NUM 14:34"/><verse number="35" style="v" sid="NUM 14:35"/>Niono nie Nyamubâho, nkudesire! Alaga oku najirira eyi ndêko mbî yacîhindulaga kuli nie: boshi bahwêra munôla irungu, mwo bafîra.»<verse eid="NUM 14:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 14:36"/>Balya bantu Mûsa arhumaga mpu bajè balolêreza ecihugo na erhi bagaluka bàrhuma olubaga loshi lucidudumira Nyamubâho, <verse eid="NUM 14:36"/><verse number="37" style="v" sid="NUM 14:37"/>abôla bantu bàjaga baderha kubî kuli ecôla cihugo, abôla bantu bàbandwa n’olufù ho na halya, e­ mbêre za Nyamubâho. <verse eid="NUM 14:37"/><verse number="38" style="v" sid="NUM 14:38"/>Yozwè, mwene Nuni na Kalebu mwene Yefunè bône bafumire olufù muli balya bajagiyenja ecihugo.<verse eid="NUM 14:38"/></para>
  <para style="s1">Okuhimirwa aha Horma</para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 14:39"/>Mûsa anacihêkera bene Israheli boshi ebyôla binwa; olubaga lwoshi lwanaciluha bwenêne. <verse eid="NUM 14:39"/><verse number="40" style="v" sid="NUM 14:40"/>Erhi babà bamazukiriza sêzi sêzi, bakanya, basôkera ebw’irhwêrhwè ly’entondo, banaciderha, mpu: «Rhwonôla! rhukolaga rhwasôkera eyôla munda Nyamubâho anaderhaga ebwa kubà rhwajizire ecâha.» <verse eid="NUM 14:40"/><verse number="41" style="v" sid="NUM 14:41"/>Mûsa ababwîra, erhi: «Carhuma mugendivuna irhegeko lya Nyamubâho? Okwôla kurhamubêre. <verse eid="NUM 14:41"/><verse number="42" style="v" sid="NUM 14:42"/>Murhasôkeraga eyôla bulya Nyamubâho arhali ekarhî kinyu! Mumanye mwene mwarhuma mugendihimwa n’abashombanyi binyu. <verse eid="NUM 14:42"/><verse number="43" style="v" sid="NUM 14:43"/>Bulya omunya-Maleki na omunya-Kanâni bali embere zinyu, mwahungumukira eyôla n’engôrho ebwa kubà mwacîberwîre kuli Nyamubâho; Nyamubâho arhâbè haguma ninyu.» <verse eid="NUM 14:43"/><verse number="44" style="v" sid="NUM 14:44"/>Baharha mpu bônene n’emisî yâbo basôkera oku ntondo; ci omucîmba gw’amalaganyo ga Nyamubâho na Mûsa, gurhafukunyagya omu karhî k’ecihando. <verse eid="NUM 14:44"/><verse number="45" style="v" sid="NUM 14:45"/>Oku bundi, balya banya-Maleki n’Abanya-Kanâni bayûbakaga omwôla ntondo babunguluka, babahima, babarhema bihimbi bihimbi kuhika aha Horma.<verse eid="NUM 14:45"/></para>
  <chapter eid="NUM 14"/>
  <chapter number="15" style="c" sid="NUM 15"/>
  <para style="ms1">VI. Obuhashe bw’abadâhwa na bene Levi</para>
  <para style="s1">Olubero luhyâhya lw’amarhegeko</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 15:1"/>Nyakasane anacibwîra Mûsa, erhi: <verse eid="NUM 15:1"/><verse number="2" style="v" sid="NUM 15:2"/>«Ogendidesa bene Israheli, obabwîre, erhi: Amango mwahika muli cirya cihugo mwagendibêra, ciryala cihugo namuhà, <verse eid="NUM 15:2"/><verse number="3" style="v" sid="NUM 15:3"/>“na nka mukola mwarherekêra Nyamubâho enterekêro yajirwa n’omuliro, ebè ya nsirîra, ebè yindi nterekêro y’okuyunjuliza muhigo mulebe, nîsi erhi nterekêro y’obulonza bw’omuntu konene, kandi erhi ebè nterekêro y’amango g’ensiku nkulu zinyu, mpu lyo, omu kurherekêra enkafu zinyu kandi erhi bibuzi binyu, muhasha okuhêra Nyamubâho enterekêro y’akisûnunu kinjà”. <verse eid="NUM 15:3"/><verse number="4" style="v" sid="NUM 15:4"/>“Omuntu oyishire okuhâna enterekêro yâge emunda Nyamubâho ali, anahira enterekêro y’enkalangè, cihimbi ciguma ca kali ikumi c’enshâno y’omulà n’ecigabi ca kani ca ehîni<note caller="+" style="f"><char style="fr" closed="false">15, 4 </char><char style="ft" closed="false">Kwo kuderha cihimbi ciguma ca kali ikumi c’Efa, yo litri nguma erhi ibirhi. Ehîni gali malitri abirhi erhi anni.</char></note> y’amavurha”. <verse eid="NUM 15:4"/><verse number="5" style="v" sid="NUM 15:5"/>“Wanajira enterekêro y’embulaga na cigabi ciguma ca kani c’ehîni ya idivayi, haguma n’enterekêro y’e­ nsirîra n’enterekêro y’omurhûla oku ngasi mwâna-buzi”. <verse eid="NUM 15:5"/><verse number="6" style="v" sid="NUM 15:6"/>“Oku nterekêro y’engandabuzi, wanahâna bihimbi bibirhi bya kali ikumi by’enshâno y’omulà oku nterekêro y’enkalangè, ci eyôla nshâno ebè mvange n’amavurha”. <verse eid="NUM 15:6"/><verse number="7" style="v" sid="NUM 15:7"/>“Oku nterekêro y’e mbulaga, wanahâna cihimbi ciguma ca kasharhu c’ehîni y’idivayi, ebè nterekêro y’akisûnunu kinjà embere za Nyamubâho”. <verse eid="NUM 15:7"/><verse number="8" style="v" sid="NUM 15:8"/>“Erhi wankarherekêra empanzi, akabà eri ya nterekêro y’ensirîra, kandi erhi ya kuyûkiriza muhigo mulebe, nîsi erhi ebè nterekêro yâwe ya murhûla wahà Nyamubâho”, <verse eid="NUM 15:8"/><verse number="9" style="v" sid="NUM 15:9"/>“haguma n’eyôla mpanzi wanarherekêra, nka nterekêro ya nkalange, bihimbi bibirhi bya kali ikumi by’enshâno y’omulà mvange n’ecihimbi ca kabirhi c’ehîni y’amavurha”. <verse eid="NUM 15:9"/><verse number="10" style="v" sid="NUM 15:10"/>“Wanahâna n’ecihimbi cakabirhi c’ehîni y’idivayi, nka nterekêro y’embulaga: erhi nterekêro ejizirwe n’omuliro, nterekêro ya kisununu kinjà e­mwa Nyamubâho”. <verse eid="NUM 15:10"/><verse number="11" style="v" sid="NUM 15:11"/>“Kwo bakazijira ntyôla oku ngasi mpanzi, oku ngasi ngandabuzi, n’oku ngasi mwâna-buzi erhi omwânahene”. <verse eid="NUM 15:11"/><verse number="12" style="v" sid="NUM 15:12"/>“Oku mubalè gw’ebintu warherekêra gunali kwo nâwe wankanajira ngasi ciguma omu kushimba kulya omubalè gwâbo gunali”. <verse eid="NUM 15:12"/><verse number="13" style="v" sid="NUM 15:13"/>“Ngasi mwambali winyu naye kwo akazijira ntyôla, amango abâna e­nterekêro yasirizibwa, nka nterekêro ya kisununu kinjà emwa Nyamubâho”. <verse eid="NUM 15:13"/><verse number="14" style="v" sid="NUM 15:14"/>“Erhi akabà hali ecigolo mwayêmêrîre okuyûbaka haguma ninyu, kandi erhi abè mubunga mukola mubà naye hamagera emyâka n’emyâka, erhi oyôla akâlonza okuhâna enterekêro, kulya mujira kwo naye agwâsirwe okujira”. <verse eid="NUM 15:14"/><verse number="15" style="v" sid="NUM 15:15"/>“Irhegeko lyabà liguma oku lubaga loshi, kuli mwe mweshi, kuguma n’ecigolo ciyûbasire emwinyu, lyabà irhegeko, oku ngasi iburha linyu lyoshi: oku cigolo na kuli mwe mwene, mweshi mwanakazijirirwa kuguma embere za Nyamubâho”. <verse eid="NUM 15:15"/><verse number="16" style="v" sid="NUM 15:16"/>“Irhegeko lyabà liguma lyonene, n’engeso yâbà nguma yonene, oli kuli mwe, oli oku cigolo ciyûbasire emwinyu.”»<verse eid="NUM 15:16"/></para>
  <para style="s1">Emigati ya burhanzi</para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 15:17"/>Nyamubâho anacibwîra Mûsa, erhi: <verse eid="NUM 15:17"/><verse number="18" style="v" sid="NUM 15:18"/>«Ogendidesa bene Israheli obabwîre, erhi: <verse eid="NUM 15:18"/><verse number="19" style="v" sid="NUM 15:19"/>“Amango mwahika muli cirya cihugo nagendimuhira, na nka mukola mwakazilya omugati gw’ecôla cihugo, mwanaberûlakwo enterekêro ya Nyamubâho” <verse eid="NUM 15:19"/><verse number="20" style="v" sid="NUM 15:20"/>“Nka nterekêro ntangiriza, mwanaberûla oku buntu bw’omugati gwinyu, buntu bwa mugati muguma, mwanagurherekêra nka nterekêro ntangiriza y’oku câno cinyu”. <verse eid="NUM 15:20"/><verse number="21" style="v" sid="NUM 15:21"/>“Kwo mwanakaziyôrha mwajira ntyôla oku buntu burhangiriza bw’omugati gwinyu, mwanaberûlakwo enterekêro ya Nyamubâho, mukaziyôrha mwajira ntyôla mwoyo na iburha linyu”».<verse eid="NUM 15:21"/></para>
  <para style="s1">Okuhyûla oku byâha by’obuhwinja</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 15:22"/>«Erhi mwankajira ecâha omu kuhabuka bulya murhashimbaga galya marhegeko gâni namuhâga kuli Mûsa, <verse eid="NUM 15:22"/><verse number="23" style="v" sid="NUM 15:23"/>“ngasi oku Nyamubâho anamurhegesire koshi erhi arhuma Mûsa kurhenga kwa lulya lusiku Nyamubâho amuhâga amarhegeko gâge na ngasi ganakulikire omu maburhwa ginyu goshi”, <verse eid="NUM 15:23"/><verse number="24" style="v" sid="NUM 15:24"/>“ntya kwo byâbà: akabà mwajizire ecâha buzira kumanya, olubaga loshi lwanarherekêra empanzi ntôrhò nka nterekêro ya nsirîra ya kisununu kinjà embere za Nyamubâho, kuguma n’enkalangè yâge, na embulagwa yâge, mwanajira nka kulya muyôrha murhegesirwe okujira, kandi mwanayûshûlakwo enterekêro y’ecihebe oku câha”. <verse eid="NUM 15:24"/><verse number="25" style="v" sid="NUM 15:25"/>“Omudâhwa anajira enterekêro y’okuhyûla oku lubaga loshi lwa bene Israheli, na ntyôla ecôla câha canababalirwa kuli bo, bulya ciri câha cajiragwa omu kuhabuka. Kandi nka bamahâna enterekêro yâbo, enterekêro yajiragwa n’omuliro embere za Nyamubâho, barherekîre Nyamubâho oku byâha, erhi ecôla câha câbo cirhuma, eci bajiraga omu kuhabuka”, <verse eid="NUM 15:25"/><verse number="26" style="v" sid="NUM 15:26"/>“ecôla câha canababalirwa kuli bene Israheli boshi, n’oku cigolo cibayûbasire ekarhî, bulya kwàli kubabuka”. <verse eid="NUM 15:26"/><verse number="27" style="v" sid="NUM 15:27"/>“Erhi akabà muguma yênene wajizire ecôla câha c’okuhabuka, oyôla muntu anarherekêre empene ya mwâka muguma oku nterekêro y’ecâha”. <verse eid="NUM 15:27"/><verse number="28" style="v" sid="NUM 15:28"/>“Omudâhwa anajira enterekêro y’okuhyûla embere za Nyamubâho, kuli olya muntu wababukaga erhi ajira ecâha; nka bamamujirira eyôla nterekêro y’oku­ hyûla, ecôla câha canamubabalirwa”, <verse eid="NUM 15:28"/><verse number="29" style="v" sid="NUM 15:29"/>“abè mwene Israheli erhi cigolo. Mwâbà n’irhegeko liguma erhi hankajira owajira ecâha omu kuhabuka”. <verse eid="NUM 15:29"/><verse number="30" style="v" sid="NUM 15:30"/>“Cikwônene erhi hankabà owundi, mwene Israheli nîsi erhi cigolo, oyôla akagayisa Nyamubâho n’oluhinzo, akagwe omu lubaga lwâge”. <verse eid="NUM 15:30"/><verse number="31" style="v" sid="NUM 15:31"/>“Bulya anagayagusize akanwa ka Nyamubâho, anabula bwashimba irhegeko lyâge: oyôla muntu akagwe<note caller="+" style="f"><char style="fr" closed="false">15, 31 </char><char style="ft" closed="false">Rhulole omu <char style="xt"><ref loc="LEV 7:20">Lev 7, 20</ref></char>. Oyôla muntu akagwe omu mulala, kurhali kwo kuderha mpu bamuyîrhe omu kumutwa irhwe (nk’oku bakudesire omu <char style="xt"><ref loc="LEV 20:2">Lev 20, 2</ref></char>). Burhangiriza kwàli kulonza okuderha oku oyo muntu wagomire anayegûlwa omu mulala. Erhi ayegûlwe omu cinyabuguma c’abemêzi. Oyo mugoma anayumva oku ahantu bamuyâsize amasù, oku acîhambwîre kuli bene wâbo, nk’oku ntà handi akacibêra omurhali omu maboko ga Nyamubâho, ye mushinganyanya (<char style="xt"><ref loc="LEV 20:6">Lev 20, 6</ref></char>).</char></note>, obubî bwâge kuli ye yêne.”»<verse eid="NUM 15:31"/></para>
  <para style="s1">Obuhane bw’okurhakenga olwa Sabato</para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 15:32"/>Mw’agôla mango bene Israheli banali omw’irungu, bashimâna muntu muguma adwîrhe arhôla enshâli olwa Sabato. <verse eid="NUM 15:32"/><verse number="33" style="v" sid="NUM 15:33"/>Abôla bashimânaga adwîrhe arhôla enshâli, bamuhêka emunda Mûsa ali, emunda Aroni ali n’olubaga. <verse eid="NUM 15:33"/><verse number="34" style="v" sid="NUM 15:34"/>Banacijira abamulanga, bulya oku ankajirwa ntâye ocikumanya. <verse eid="NUM 15:34"/><verse number="35" style="v" sid="NUM 15:35"/>Nyamubâho anacibwîra Mûsa, erhi: «Oyôla muntu afè! Olubaga lwa bene Israheli loshi lumubande amabuye embuga ly’ecihando». <verse eid="NUM 15:35"/><verse number="36" style="v" sid="NUM 15:36"/>Erhi olubaga loshi lubà lwamamurhenza omu cihando, lwamubanda amabuye, anacifà nka kulya Nyamubâho anarhegekaga Mûsa.<verse eid="NUM 15:36"/></para>
  <para style="s1">Obushemberere oku myambalo</para>
  <para style="p">
    <verse number="37" style="v" sid="NUM 15:37"/>Nyakasane abwîra Mûsa, erhi: <verse eid="NUM 15:37"/><verse number="38" style="v" sid="NUM 15:38"/>Ogendidesa bene Israheli, obabwîre bakazihira obushemberêre oku mihiro y’ebishûli byâbo, kurhenga okw’iburha kujà oku lindi, n’oku bushemberêre bwa ngasi muhiro bahirekwo ehigozi y’akaduku k’omukara. <verse eid="NUM 15:38"/><verse number="39" style="v" sid="NUM 15:39"/>Mwabà ntyo n’obushemberêre; omu kubulolakwo, mwanakengêra galya marhegeko ga Nyamubâho goshi lyo mugashimba; mumanye mwankakulikira enyifinjo z’emirhima yinyu erhi ez’amasù ginyu gakazimukululira ebwa kujira kubî. <verse eid="NUM 15:39"/><verse number="40" style="v" sid="NUM 15:40"/>Ntyôla mwakazikengêra amarhegeko gâni goshi, munagashimbe, na ntyo mwanabà bimâna emwa Nyamuzinda winyu. <verse eid="NUM 15:40"/><verse number="41" style="v" sid="NUM 15:41"/>Nie Nyamubâho, Nyamuzinda winyu, owamakûlaga omu cihugo c’e Mîsiri, lyo nyôrha niene Nyamuzinda winyu. Nie Nyamubâho, Nyamuzinda winyu.<verse eid="NUM 15:41"/></para>
  <chapter eid="NUM 15"/>
  <chapter number="16" style="c" sid="NUM 16"/>
  <para style="s1">Okugoma kwa Korè, Datani na Abirami</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 16:1"/>Korè, mwene Yishari, ya Kehati, ka Levi bona Datani n’Abirami bene Eliyabu, na Honi mwene Peleti, Eliyabu na Peleti bàli bene Rubeni, bajamo obucîbone; <verse eid="NUM 16:1"/><verse number="2" style="v" sid="NUM 16:2"/>bacîhindulira Mûsa; bashimânwa na bandi bantu magana abirhi na makumi arhanu b’omu bene Israheli, barhambo b’olubaga, bantu b’irenge na bakengwa. <verse eid="NUM 16:2"/><verse number="3" style="v" sid="NUM 16:3"/>Bashûbûzanya oku kulongôza Mûsa n’Aroni, banacibabwîra, mpu: «Rhwamarhama ninyu, bulya olubaga lwoshi, abantu boshi bali bimâna, na Nyamubâho ali ekarhî kâbo. Cankarhuma mweki mucikuza enyanya ly’olubaga lwa Nyamubâho?» <verse eid="NUM 16:3"/><verse number="4" style="v" sid="NUM 16:4"/>Erhi Mûsa ayumva okwôla, akumba bûbi. <verse eid="NUM 16:4"/><verse number="5" style="v" sid="NUM 16:5"/>Abwîra Korè n’omurhwe gwâge, erhi: Irhondo, Nyamubâho amanyîsa oli wâge n’oli mwimâna, yêne anamuyegeza hôfi naye, oyu acîshozire yêne anamushegeza hôfi naye. <verse eid="NUM 16:5"/><verse number="6" style="v" sid="NUM 16:6"/>Mujirage ntyâla: Murhôle ebitumbûkizo, Korè n’omurhwe gwâwe goshi. <verse eid="NUM 16:6"/><verse number="7" style="v" sid="NUM 16:7"/>Irhondo, muhiremwo omuliro, munahire enshangi oku nyanya embere za Nyamubâho, oyu Nyamubâho akanacîshoga, oyôla yenali mwimâna. Namarhama ninyu bene Levi. <verse eid="NUM 16:7"/><verse number="8" style="v" sid="NUM 16:8"/>Mûsa anacibwîra Korè, erhi: «Yumvagi bene Levi. <verse eid="NUM 16:8"/><verse number="9" style="v" sid="NUM 16:9"/>Ka emwinyu, kuli kunyi okûla Nyamubâho amwishogaga omu karhî ka bene Israheli boshi, amuhira hâgo hâgo mpu mukazimuyegêra munakazikola omu ndâro ya Nyamubâho, n’okuyimangira olubaga omu mukolo gwâlo? <verse eid="NUM 16:9"/><verse number="10" style="v" sid="NUM 16:10"/>Akushegezize hôfi naye, woyo na bene winyu boshi, bene Levi, haguma nâwe, lêro bukolaga budâhwa mwalonza. <verse eid="NUM 16:10"/><verse number="11" style="v" sid="NUM 16:11"/>Okwôla kwo kurhumire we n’omurhwe gwâwe muyishijira ihano y’okucîhindula kuli Nyamubâho! Aroni aligi muntu muci obûla mwacîduduma kuli ye?» <verse eid="NUM 16:11"/><verse number="12" style="v" sid="NUM 16:12"/>Mûsa arhuma mpu bahamagale Datani n’Abirami mwene Eliabu; banacishuza mpu: «Rhurhasôkera eyo». <verse eid="NUM 16:12"/><verse number="13" style="v" sid="NUM 16:13"/>Ka kuli kunyi erhi orhurhenza omu cihugo cahululaga amarhà n’obûci n’okuyishirhuyîrhira munôla irungu<note caller="+" style="f"><char style="fr" closed="false">16, 13 </char><char style="ft" closed="false">Abashombanyi ba Mûsa, erhi bakola balogorha barhagera: Bakûnga ecihugo c’e Mîsiri, cihugo ca bujà, mpu co cihugo cahululagamwo amarhà n’obûci.</char></note>; kandi wacikûnga mpu we nnawîrhu? <verse eid="NUM 16:13"/><verse number="14" style="v" sid="NUM 16:14"/>«Mâshi arhali omu cihugo cihulula amarhà n’obûci warhuhesire, arhali mashwa ga mizâbîbu warhuhîre mpu rhugayîmemwo! Ka omanyire mpu olûla lubaga walujira mihûrha? Rhurhasôkere eyôla munda!» <verse eid="NUM 16:14"/><verse number="15" style="v" sid="NUM 16:15"/>Omu bukunizi bunene, Mûsa anacibwîra Nyamubâho, erhi: «Orhalolaga e­nterekêro yâbo y’enkalangè. Ntasagibanyaga ciru na oli endogomi<note caller="+" style="f"><char style="fr" closed="false">16, 15 </char><char style="ft" closed="false">Endogomi ago mango yali ya ngulo ndârhi, yankaguzirwe nka mpanzi (<char style="xt"><ref loc="EXO 22:4">Lub 22, 4</ref>.<ref loc="EXO 22:9">9</ref></char>). </char></note> yâbo, ciru na ntâye nkola njirire amabî muli bo.»<verse eid="NUM 16:15"/></para>
  <para style="s1">Obuhane</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 16:16"/>Mûsa anacibwîra Korè, erhi: «We n’omurhwe gwâwe, irhondo mubonekane embere za Nyamubâho, we nabo na Aroni. Murhôle ngasi muguma ecitumbûkizo cinyu <verse eid="NUM 16:16"/><verse number="17" style="v" sid="NUM 16:17"/>Muhiremwo enshangi, munagendihêka ngasi muguma ecitumbûkizo câge emunda Nyamubâho ali: biri bitumbûkizo magana abirhi na makumi arhanu; nâwe wêne kuguma n’Aroni, murhôle ngasi muguma ecitumbûkizo câge.» <verse eid="NUM 16:17"/><verse number="18" style="v" sid="NUM 16:18"/>Banacirhôla ngasi muguma ecitumbûkizo câge, banacihira­ mwo omuliro, banahira enshangi oku nyanya, bagendiyimanga aha muhango gw’ihêma ly’embugânano, boshi na Mûsa n’Aroni. <verse eid="NUM 16:18"/><verse number="19" style="v" sid="NUM 16:19"/>Korè ali erhi anahamagîre olubaga loshi oku kucîhindulira Mûsa n’Aroni aha Ihêma ly’embugânano. Okubundi irenge lya Nyamubâho lyabonekera olubaga loshi.<verse eid="NUM 16:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 16:20"/>«Nyamubâho adesa Mûsa n’Aroni, ababwîra erhi: <verse eid="NUM 16:20"/><verse number="21" style="v" sid="NUM 16:21"/>Muciyegûle kuli olu lubaga, nkola naluherêrekeza buno buno<note caller="+" style="f"><char style="fr" closed="false">16, 21 </char><char style="ft" closed="false">Lulema yehà ngasi ciremwa omûka (<char style="xt"><ref loc="GEN 2:7">Murh 2, 7</ref></char>), kandi ye zibà ngasi ciremwa omûka amango alonzize (<char style="xt"><ref loc="PSA 104:29">Lul 104, 29</ref>.<ref loc="PSA 104:30">30</ref></char>) Mûsa akola ayôsire amanyire oku yêhe arhahanirwe haguma n’olubaga (Mulongo gwa 21), ci kurharhumaga arhasengerera ngasi mwêrukwêru.</char></note>.» <verse eid="NUM 16:21"/><verse number="22" style="v" sid="NUM 16:22"/>Banacikumbira akamalanga, baderha mpu: «Mâshi yâgirwa Nyamuzinda, we Nyamuzinda wa ngasi mûka gwa muntu, muntu muguma oyûla wadwîrhe oku kubî, na bunôla mpu okolaga wakunirira olubaga loshi» <verse eid="NUM 16:22"/><verse number="23" style="v" sid="NUM 16:23"/>Nyamubâho ashambâla na Mûsa amubwîra, erhi: <verse eid="NUM 16:23"/><verse number="24" style="v" sid="NUM 16:24"/>«Ogendibwîra olubaga, erhi: “Murhenge eburhambi bw’aha mwa Korè, Datani na Abirami.”»<verse eid="NUM 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 16:25"/>Mûsa ayimuka anacijà emunda Datani n’Abirami bali; n’abagula b’Israheli bayisha bamukulikire. <verse eid="NUM 16:25"/><verse number="26" style="v" sid="NUM 16:26"/>Adesa olubaga loshi aderha, erhi: «Mujè kuli n’enyumpa za bala bantu babî, mumanye murhanahumaga oku ngasi kalugu kâbo, lyo ninyu mulekiherêrekera nka mwamazingazingwa n’ebyâha byâbo». <verse eid="NUM 16:26"/><verse number="27" style="v" sid="NUM 16:27"/>Barhenga eburhambi bw’aha mwa Korè. Datani n’Abirami erhi bali embuga, bayimanzire aha muhango gw’amahêma gâbo, na bakâbo, n’abâna bâbo bakulu n’abarho boshi. <verse eid="NUM 16:27"/><verse number="28" style="v" sid="NUM 16:28"/>Mûsa anaciderha, erhi: «Mukolaga mwamanya oku Nyamubâho wanantumaga okukazijira eyîra mikolo yoshi n’oku ntayijira oku i­rhwe lyâni niene. <verse eid="NUM 16:28"/><verse number="29" style="v" sid="NUM 16:29"/>“Abâla bantu bakafà nk’oku abandi bantu banayôrha bafà, n’akalamo kâbo kakayûrha nk’oku akalamo k’abandi bantu kanayûrha, erhi arhanali Nyamubâho wantumaga”. <verse eid="NUM 16:29"/><verse number="30" style="v" sid="NUM 16:30"/>“Ci erhi Nyamubâho akajira akantu karhuma abandi bantu bazânwa, erhi idaho lyankayashamya akanwa kalyo, likanabamirangusa boshi kuguma n’ebintu byâbo byoshi, erhi bankayandagalira ekuzimu banazîne, aho nêci mwanamayira ho oku abâla bantu banajacire Nyamubâho”».<verse eid="NUM 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 16:31"/>Oku anayûsiderha ebyôla binwa byoshi, obudaka bàli bayimanzirekwo bwanacihahanyuka, <verse eid="NUM 16:31"/><verse number="32" style="v" sid="NUM 16:32"/>idaho lyayashamya akanwa kalyo, lyanacibamirangusa n’emilala yâbo, kuguma na bene Korè boshi n’ebintu byâbo byoshi. <verse eid="NUM 16:32"/><verse number="33" style="v" sid="NUM 16:33"/>Bayandagalira ekuzimu banacizîne, bo na ngasi hyanali hyâbo hyoshi: idaho lyanacibafûnika, bahirigirha embere z’olubaga <verse eid="NUM 16:33"/><verse number="34" style="v" sid="NUM 16:34"/>Bene Israheli bàli eburhambi boshi, bakumbiranya, bakola bayâka, banajà bayâma, banaderha mpu: «Rhuyàke, lyo nîrhu idaho lilekirhumirangusa!» <verse eid="NUM 16:34"/><verse number="35" style="v" sid="NUM 16:35"/>Omuliro gwanacimanuka emwa Nyamubâho gwamirangusa balya bantu magana abirhi na makumi arhanu bajagitumula enshangi.<verse eid="NUM 16:35"/></para>
  <chapter eid="NUM 16"/>
  <chapter number="17" style="c" sid="NUM 17"/>
  <para style="s1">Olw’ebitumbûkizo n’olw’akarhi ka Aroni</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 17:1"/>Nyamubâho ashambâza Mûsa, amubwîra, erhi: <verse eid="NUM 17:1"/><verse number="2" style="v" sid="NUM 17:2"/>«Obwîre omudâhwa Eleazari, mwene Aroni, arhenze ebitumbûkizo omu bwihîrà, onakabulire kulî omuliro gulimwo, <verse eid="NUM 17:2"/><verse number="3" style="v" sid="NUM 17:3"/>“bulya ebi bitumbûkizo oku byâha biri bigishe. Ebitumbûkizo by’abôla bantu, abahemukiraga obuzîne bwâbo bônene, bajiremwo enambûle ndîrî, zikazibwikira oluhêrero lw’enterekêro y’ensirîra; bulya byarherekîrwe Nyamubâho, binakolabigishe, byayôrha ntyôla cimanyîso kuli bene Israheli.”» <verse eid="NUM 17:3"/><verse number="4" style="v" sid="NUM 17:4"/>Omudâhwa Eleazari arhôla birya bitumbûkizo by’omulinga byakolêsiba­gwa na balya bantu bamirangusibagwa n’omuliro, ajiramwo enambûle z’okukazibwîkira oluhêrero. <verse eid="NUM 17:4"/><verse number="5" style="v" sid="NUM 17:5"/>Bene Israheli bayôrha bamanyire oku ntà muntu w’embuga orhali w’omu bûko bwa Aroni, wakacîshomya mpu ayegêra arherekêre Nyamubâho enshangi, anabule okubà aka Korè n’omurhwe gwâge nk’oku Nyamubâho anamumanyisagya omu kanwa ka Mûsa.<verse eid="NUM 17:5"/></para>
  <para style="s1">Okucîduduma kwa bene Israheli</para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 17:6"/>Erhi buca, olubaga loshi lwa bene Israheli lwarhondêra lwacîdudumira Mûsa na Aroni, lwakaziderha mpu: «Mwayisize olubaga lwa Nyamubâho.» <verse eid="NUM 17:6"/><verse number="7" style="v" sid="NUM 17:7"/>Ebwa kubà olubaga lwàli lwamagôrha Mûsa n’Aroni, bombi bayêrekera e­ bw’Ihêma ly’embugânano, ecitù calibwîka n’irenge lya Nyamubâho lyaboneka. <verse eid="NUM 17:7"/><verse number="8" style="v" sid="NUM 17:8"/>Mûsa na Aroni bakanya bajà ebw’Ihêma ly’embugânano. <verse eid="NUM 17:8"/><verse number="9" style="v" sid="NUM 17:9"/>Nyamubâho anacishambâza Mûsa aderha erhi: <verse eid="NUM 17:9"/><verse number="10" style="v" sid="NUM 17:10"/>«Orhenge muli olu lubà­ga, nkola naluhirigisa buno buno.» Bombi banacikumba bûbi. <verse eid="NUM 17:10"/><verse number="11" style="v" sid="NUM 17:11"/>Mûsa anacibwîra Aroni, erhi: «Rhôla ecitumbûkizo, ohiremwo omuliro gw’oku luhêrero, ohirekwo n’enshangi, okanye duba emunda olubaga luli, ogendilujirira empyûlo; bulya oburhè bwa Nyamubâho bwamayâka. Ecibande camarhangira.» <verse eid="NUM 17:11"/><verse number="12" style="v" sid="NUM 17:12"/>Aroni arhôla ecitumbûkizo, nk’oku Mûsa anaderhaga, alibirhira omu karhî k’olubaga. Ecibande càli camarhondera ekarhî k’olubaga. Ahira enshangi omu citumbûkizo, ajira enterekêro y’empyûlo oku lubaga. <verse eid="NUM 17:12"/><verse number="13" style="v" sid="NUM 17:13"/>Ajiyimanga ekarhî k’abamafà n’abazîne; aho Ecibande cacîkwa. <verse eid="NUM 17:13"/><verse number="14" style="v" sid="NUM 17:14"/>Bantu bihumbi ikumi na bini na magana gali nda bafà n’ecôla cibande, buzira kuganja abafàga erhi Korè orhuma. <verse eid="NUM 17:14"/><verse number="15" style="v" sid="NUM 17:15"/>Aroni ashubira emunda Mûsa ali ah’Ihêma ly’embugânano, n’Ecibande erhi camacîkwa.<verse eid="NUM 17:15"/></para>
  <para style="s1">Olw’akarhi k'Aroni</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 17:16"/>Nyamubâho ashambâza Mûsa amubwîra, erhi: <verse eid="NUM 17:16"/><verse number="17" style="v" sid="NUM 17:17"/>«Ogendibwîra bene Israheli bakuhè orhurhi, ngasi bûko karhikaguma, rhwo rhuligi rhurhi ikumi na rhubirhi rhwalerhwa n’abarhambo bâbo boshi kulya emilala yâbo enali ikumi n’ibirhi. Oyandike izîno lya ngasi muguma oku karhî kâge. <verse eid="NUM 17:17"/><verse number="18" style="v" sid="NUM 17:18"/>“Oyandike izîno ly’Aroni oku karhî ka Levi, bulya ngasi murhambo akazibà na karhî kaguma kulya emilala yâbo enali”. <verse eid="NUM 17:18"/><verse number="19" style="v" sid="NUM 17:19"/>“Oyishidekereza orhôla rhurhi omw’Ihêma ly’embugânano embere z’omucîmba gw’amalaganyo, halya nkazishimânana nâwe”. <verse eid="NUM 17:19"/><verse number="20" style="v" sid="NUM 17:20"/>“Omuntu ncîshozire, ayishiba olya akarhi kâge kajirekw’obwâso, na ntyo, nanayûsa embere zâni erya midudumo bene Israheli bakazimujirakwo”».<verse eid="NUM 17:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 17:21"/>Mûsa agendishambâla na bene Israheli, n’abarhambo bâbo boshi bakazimulerhera karhî kaguma, nk’oku emilala yâbo enali, kwo kuderha rhurhi ikumi na rhubirhi, n’akarhi ka Aroni karhulimwo.<verse eid="NUM 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 17:22"/>Mûsa adêkereza orhôla rhurhi embere za Nyamubâho, omw’lhêma ly’obubamîrizi. <verse eid="NUM 17:22"/><verse number="23" style="v" sid="NUM 17:23"/>Erhi buca Mûsa ashubira ebw’Ihêma ly’obubamîrizi, akarhi k’Aroni kajirekwo obwâso, kaligi k’obûko bwa Levi: ako karhî kàli kamajakwo amafufu, kàli kamayâsa, erhi kamanajakwo amalehe. <verse eid="NUM 17:23"/><verse number="24" style="v" sid="NUM 17:24"/>Mûsa ayisha ahulukîne rhulya rhurhi rhwoshi rhwàli embere za Nyamubâho, arhuhira embere za bene Israheli boshi, babona na ngasi muguma arhôla akarhi kâge.<verse eid="NUM 17:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 17:25"/>Nyamubâho abwîra Mûsa erhi: «Oshubize akarhi ka Aroni aha Mucîmba gw’amalaganyo, kakazilangwa nka buhamîrizi emwa ngasi boshi bankalonza okucîhindula, na ntyôla okucîduduma kwâbo kwanahwa emunda ndi, banalekifa». <verse eid="NUM 17:25"/><verse number="26" style="v" sid="NUM 17:26"/>Mûsa anacijira kulya, anacijira nk’oku Nyamubâho àlimurhegesire. <verse eid="NUM 17:26"/><verse number="27" style="v" sid="NUM 17:27"/>Bene Israheli banacibwîra Mûsa mpu: «Lolà oku rhwamafa, rhwamahwa rhweshi. <verse eid="NUM 17:27"/><verse number="28" style="v" sid="NUM 17:28"/>Ngasi yêshi wakaziyegêra Endâro, adwîrhe afà. Ka kukwaninage rhweshi rhufè obwo?»<verse eid="NUM 17:28"/></para>
  <chapter eid="NUM 17"/>
  <chapter number="18" style="c" sid="NUM 18"/>
  <para style="s1">Emikolo y’abadâhwa n’oluhembo lwâbo</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 18:1"/>Nyamubâho anacibwîra Aroni, erhi: «W’oyu na bagala bâwe, haguma n’enyumpa ya sho, mwe mwatumula obubî bwankajirwa ahantu himâna; we na bagala bâwe, mwakazidôsibwa oku bubî bwankajirwa omu mukolo gwinyu gw’obudâhwa. <verse eid="NUM 18:1"/><verse number="2" style="v" sid="NUM 18:2"/>“Ci na bene winyu kuguma, ab’omu bûko bwa Levi, ab’omu mulala gwa sho, obayegeze hôfi nâwe bakazikukolera banakazikurhabâla amango we na bagala bâwe muli omu mirimo yinyu y’omw’Ihêma ly’obuhamîrizi”. <verse eid="NUM 18:2"/><verse number="3" style="v" sid="NUM 18:3"/>“Bakazikurhabâla oku mikolo yâwe yoshi nk’oku mikolo y’Ihêma ly’embugânano. Ci bamanye bankanayegêra ebintu bimâna, erhi oluhêrero, mulekifa oli we oli bo”. <verse eid="NUM 18:3"/><verse number="4" style="v" sid="NUM 18:4"/>“Bakazikugwâsa, bakazikola omu mikolo y’Ihêma ly’embugânano, oku ngasi mikolo enayêrekîre Ihêma. Ci ntà w’embuga wankayegêra”. <verse eid="NUM 18:4"/><verse number="5" style="v" sid="NUM 18:5"/>“Mukazikola omu hantu himâna n’oku luhêrero, lyo oburhè bw’okushimbulira bene Israheli buhwa”. <verse eid="NUM 18:5"/><verse number="6" style="v" sid="NUM 18:6"/>“Nie narhôzire bene winyu Baleviti ekarhî ka bene Israheli; abahâbagwa Nyamubâho we okola obahâbirwe mpu bakazijira omukolo gw’omw’lhêma ly’embugânano”. <verse eid="NUM 18:6"/><verse number="7" style="v" sid="NUM 18:7"/>“We na bagala bâwe, omukolo gwinyu gw’obudâhwa gwabà oku ngasi biyêrekîre oluhêrero n’ebiri enyuma ly’ecisîka<note caller="+" style="f"><char style="fr" closed="false">18, 7 </char><char style="ft" closed="false">Enyuma ly’ecisîka: (<char style="xt"><ref loc="EXO 26:31-34">Lub 26, 31-34</ref></char>) kwo kuderha ahantu himâna bwenêne. Omudâhwa yêne wankahisire ahantu hali nk’aho (<char style="xt"><ref loc="LEV 16:2-3">Lev 16, 2-3</ref></char>).</char></note>, mwakazijira ogwôla mukolo. Mwakazijira omukolo gw’oburherekêre, bulya muli badâhwa. Ow’embuga wankacîshomya mpu ayegêra, anafè”».<verse eid="NUM 18:7"/></para>
  <para style="s1">Omwanya gw’abadâhwa</para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 18:8"/>Nyamubâho anacibwîra Aroni, erhi: «nakuhîre omukolo gw’oku ngasi binamberûlîrwe. Ebintu birherekêre bya bene Israheli, nkuhîre byo we n’abâna bâwe nka ngalo ya ngasi mango. <verse eid="NUM 18:8"/><verse number="9" style="v" sid="NUM 18:9"/>“Alaga ebyakaziba byâwe omu bintu bimâna bwenêne, omu biryo birherekêre: entûlo zoshi za bene Israheli bakazizingalulira, enterekêro z’enkalangè zoshi, enterekêro zâbo zoshi oku byâha n’enterekêro zâbo zoshi z’empongano bakanayîshikampa zoshi: ebyôla byoshi nka bintu bimâna bwenêne, byâbà byâwe kuli we n’oku bagala bâwe”. <verse eid="NUM 18:9"/><verse number="10" style="v" sid="NUM 18:10"/>“Wakalya ebimâna bwenêne; ngasi mulume akazibiryako. Obikenge bwenêne”. <verse eid="NUM 18:10"/><verse number="11" style="v" sid="NUM 18:11"/>“N’ebîra nabyo byakaziba byâwe: ngasi ebi banaberwîre oku ntûlo zâbo, oku ngasi nterekêro z’okumogamoga za bene Israheli; nkuhîre byo we na bagala bâwe na bâli bâwe, n’eryôla liri irhegeko ly’ensiku n’amango; ngasi ocîre w’omu mwâwe, anahasha okubiryako”. <verse eid="NUM 18:11"/><verse number="12" style="v" sid="NUM 18:12"/>“Ngasi mavurha minjà bwenêne bahâna, ngasi idivayi linjà bwenêne bahâna, lihyâhya, erhi ngano, ebirhangiriza by’emyâka yâbo balibirherekêra Nyamubâho, ebyôla nkuhîre byo”. <verse eid="NUM 18:12"/><verse number="13" style="v" sid="NUM 18:13"/>“Ngasi bya mburho yâbo mpyâhya bankanahumbûla omu cihugo câbo mpu babirherekêre Nyamubâho, ebyôla byoshi nabyo nkuhîre byo. Ngasi yêshi onali acîre omu mwâwe anabiryakwo”. <verse eid="NUM 18:13"/><verse number="14" style="v" sid="NUM 18:14"/>“Ngasi byoshi birikwo obuhane omu Israheli, ebyôla biri byâwe nabyo”. <verse eid="NUM 18:14"/><verse number="15" style="v" sid="NUM 18:15"/>“Ngasi wa bûko lubere abè wa bantu, abè wa cintu, birya banahà Nyamubâho, ebyôla byâbà byâwe. Ci kwônene wanakazigombôla olubere lw’omuntu, n’olubere lw’ecintu cigalugalu”. <verse eid="NUM 18:15"/><verse number="16" style="v" sid="NUM 18:16"/>“Wanabigombôlera oku mwêzi muguma biri biburhe, wêne wankaderha ecitwîro, sikêli irhanu z’ecûma c’olunyerere omu kuzigerera oku sikêli y’ahantu himâna, erya ya gêra makumi abirhi”. <verse eid="NUM 18:16"/><verse number="17" style="v" sid="NUM 18:17"/>“Ebirhagombôlwa by’ebi: olubere lw’e­ nkâfu, olubere lw’ebibuzi, olubere lw’empene ebyôla biri bimâna. Okazibulagira omukò gwâbyo oku luhêrero n’amashushi gâbyo wanagayôca gatumbûke mugî: eri nterekêro yajirwa n’omuliro ya kisununu kinjà embere za Nyamubâho”. <verse eid="NUM 18:17"/><verse number="18" style="v" sid="NUM 18:18"/>“N’enyama zâbyo ziri zâwe, gulya mushaya bamogamoga n’okugulu kulyo”. <verse eid="NUM 18:18"/><verse number="19" style="v" sid="NUM 18:19"/>“Ebi bene Israheli baberûlira Nyamubâho oku bintu bimâna nkuhirebyo we na bagala bâwe na bâli bâwe. N’eryo liri irhegeko ly’ensiku n’amango, eri ndagâno nnunge<note caller="+" style="f"><char style="fr" closed="false">18, 19 </char><char style="ft" closed="false">Endagâno nnunge: lolà <char style="xt"><ref loc="LEV 2:13">Lev 2, 13</ref></char>. Amahugûlo gw’omunyu galimwo kubirhi: 1) Erhi wankagushushanya n’engezo (<char style="xt"><ref loc="MAT 13:33">Mat 13, 33</ref>; <ref loc="1CO 5:6">1 Kor 5, 6</ref></char>) erhi bûci, wanabona oku omunyu gugwêrhe obuhashe bw’okuhanza akantu kubola n’obuhashe bw’okushukûlula. Co carhumaga bakazigukolêsa amango gw’okuhâna enterekêro (<char style="xt"><ref loc="LEV 2:13">Lev 2, 13</ref>; <ref loc="EZK 43:24">Eze 43, 24</ref></char>); 2) Omunyu gunakolêsibwe nka nnungo, co cirhumire baderha endagâno nnunge (<char style="xt"><ref loc="NUM 18:19">Mib 18, 19</ref>; <ref loc="2CH 13:5">2 Nga 13, 5</ref></char>): Eri ndagâno y’emyâka n’emyâka. Eyêrekînwe omu lwîganyo lw’omunyu gwo gurhahwa bununu emyâka yoshi. </char></note> y’ensiku zoshi, embere za Nyamubâho kuli we n’okw’iburha lyâwe mweshi.”»<verse eid="NUM 18:19"/></para>
  <para style="s1">Ecigabi ca Bene-Levi</para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 18:20"/>Nyamubâho anacibwîra Aroni, erhi: orhâbè n’akashambala omu cihugo câbo, na ntà cigabi ciru n’eciguma cankaderhwa mpu câwe ekarhî kâbo<note caller="+" style="f"><char style="fr" closed="false">18, 20 </char><char style="ft" closed="false">Kwo kuderha entûlo olubaga lusholôlera Nyamuzinda, yo ebîka abadâhwa.</char></note>. Niehe nie cigabi câwe nie na kashambala kâwe ekarhî ka bene Israheli. <verse eid="NUM 18:20"/><verse number="21" style="v" sid="NUM 18:21"/>Alà oku bene Levi mbahire nka kashambala entûlo yoshi y’omu Israheli, kuli erya mikolo yâbo banajira omw’lhêma ly’embugânano. <verse eid="NUM 18:21"/><verse number="22" style="v" sid="NUM 18:22"/>Bene Israheli barhankaciyegêra Ihêma ly’embugânano, kwanabà kucîbarhuza ecâha cankarhuma bafà. <verse eid="NUM 18:22"/><verse number="23" style="v" sid="NUM 18:23"/>Bene Levi bo bakazijira emikolo y’omw’Ihêma ly’embugânano na bône bankabarhula obubî bwâbo. Irhegeko ly’ensiku n’amango libahanzize okubà (libasêzize okurhâbà) n’akashambala ekarhî ka bene Israheli <verse eid="NUM 18:23"/><verse number="24" style="v" sid="NUM 18:24"/>Bulya bene Levi, akashambala kâbo, mbahire era ntûlo bene Israheli baberûlira Nyamubâho. Co carhumaga nababwîra nti barhabè n’akashambala ekarhî ka bene Israheli.<verse eid="NUM 18:24"/></para>
  <para style="s1">Entûlo</para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 18:25"/>Nyamubâho ashambâla na Mûsa amubwîra, erhi: <verse eid="NUM 18:25"/><verse number="26" style="v" sid="NUM 18:26"/>«Ogendishambâza bene Levi obabwîre, erhi: Amango mwahâbwa na bene Israheli entûlo mmuhîre nka kashambala kinyu, mwanaberûlakwo enterekêro ya Nyamubâho, eri ntûlo oku ntûlo. <verse eid="NUM 18:26"/><verse number="27" style="v" sid="NUM 18:27"/>“N’ebyôla mwaberûla, olugero lwâbyo lubè nk’olugero lw’engano baberûla oku câno, erhi nk’olugero lw’idivayi lihyâhya baberûla oku mukenzi”. <verse eid="NUM 18:27"/><verse number="28" style="v" sid="NUM 18:28"/>“Kwo mwakaziberûla ntyôla ninyu enterekêro ya Nyamubâho kuli zirya ntûlo zoshi mwakazihâbwa na bene Israheli. Eyôla nterekêro mwaberûlira Nyamubâho, mwanayiha omudâhwa Aroni”. <verse eid="NUM 18:28"/><verse number="29" style="v" sid="NUM 18:29"/>“Kuli ebi mwankanahàbwa byoshi, mwanakazirhôlakwo erya nterekêro ya Nyamubâho. Ebiri binjà bwenêne byo mwakazikûlakwo ecigabi cimâna”. <verse eid="NUM 18:29"/><verse number="30" style="v" sid="NUM 18:30"/>“Obabwîre erhi: nka mwamaberûla birya biri binjà bwenêne, entûlo oku bene Levi yanagererwa oku mburho y’oku câno n’oku mburho y’omu mukenzi”. <verse eid="NUM 18:30"/><verse number="31" style="v" sid="NUM 18:31"/>“Mwanabirîra ngasi hantu munalonzize hoshi mwe n’omulala gwinyu bulya lwo luhembo lwinyu olwo oku mukolo goshi mujira omw’Ihêma ly’embugânano”. <verse eid="NUM 18:31"/><verse number="32" style="v" sid="NUM 18:32"/>“Ntà câha mwankajira muli okwôla nka mwamaberûla cirya cigabi cinjà bwenêne, murhankahemula enterekêro nyinjà za bene Israheli, murhankanacifa.”»<verse eid="NUM 18:32"/></para>
  <chapter eid="NUM 18"/>
  <chapter number="19" style="c" sid="NUM 19"/>
  <para style="s1">Enkafu y’omukara</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 19:1"/>Nyamubâho ashambâla na Mûsa n’Aroni, aderha, erhi: <verse eid="NUM 19:1"/><verse number="2" style="v" sid="NUM 19:2"/>Alaga ebinwa b’irhegeko Nyamubâho arhegesire, ene aderha erhi: Ojibwîra bene Israheli bayîshe bandwîrhîre enkâfu y’omukara, erya erhagwêrhi ishembo lici oku mubiri, erhanasagihêka omuzigo. <verse eid="NUM 19:2"/><verse number="3" style="v" sid="NUM 19:3"/>Muyihekere omudâhwa Eleazari, naye anayirhenza omu cihando bagendiyibâgira embere zâge. <verse eid="NUM 19:3"/><verse number="4" style="v" sid="NUM 19:4"/>Omudâhwa Eleazari anarhôla oku mukò gw’eyôla nkâfu n’omunwe gwâge, anajira nago olukangûlo kali nda olunda lw’omuhango gw’Ihêma ly’embugânano. <verse eid="NUM 19:4"/><verse number="5" style="v" sid="NUM 19:5"/>Banayôca eyôla nkâfu erhi anadwîrhe abona! banayôca oluhù lwâyo, enyama zâyo n’omukò gwâyo kuguma n’ecihò câyo. <verse eid="NUM 19:5"/><verse number="6" style="v" sid="NUM 19:6"/>Omudâhwa anarhôla enshâli z’omurhi gw’omwêrezi, ez’olwifûyè n’ebindi by’akaduku; anabikwêba mulyamuliro gudwîrhe gwasingônola erya nkâfu. <verse eid="NUM 19:6"/><verse number="7" style="v" sid="NUM 19:7"/>Kandi anashuka emyambalo yâge, ashukire n’omubiri gwâge omu mîshi, anashubira omu cihando, ayôrhe mugalugalu<note caller="+" style="f"><char style="fr" closed="false">19, 7 </char><char style="ft" closed="false">Nk’oku bishingânîne, omuntu mugalugalu arhagwâsirwi okugaluka omu cihando e­mbêre bijinge (<char style="xt"><ref loc="DEU 23:12">Lush 23, 12</ref></char>) kuleka omudâhwa.</char></note> kuhika bijingo. <verse eid="NUM 19:7"/><verse number="8" style="v" sid="NUM 19:8"/>Naye olya wayôcagya erya nkâfu, anashuka emyambalo yâge, ashukire n’omubiri gwâge omu mîshi, anayôrha mugalugalu kuhika bijingo. <verse eid="NUM 19:8"/><verse number="9" style="v" sid="NUM 19:9"/>Omuntu oli bwinjà anaguka lulya luvù lw’erya nkâfu, anagendilubulagira emuhanda gw’ecihando, omu hantu hinjà; bakazilubikira endêko ya bene Israheli, bakaziluhira omu mîshi g’okubayôbôla; eri nterekêro oku byâha. <verse eid="NUM 19:9"/><verse number="10" style="v" sid="NUM 19:10"/>Oyu wagukaga oluvù lw’erya nkâfu anashuka emyambalo yâge, anayôrha mugalugalu kuhika bijingo. Okwôla, lyâbà irhegeko ly’ensiku zoshi oku bene Israheli n’oku muntu w’ecigolo onayûbasire ekarhî kâbo.<verse eid="NUM 19:10"/></para>
  <para style="s1">Ebiyêrekîre okuzinga</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 19:11"/>Owankahuma oku mufù mulebe erhi mulebe, oyôla anabè mugalugalu nsiku nda. <verse eid="NUM 19:11"/><verse number="12" style="v" sid="NUM 19:12"/>Anayishicîcêsa n’agôla mîshi olusiku lwa kasharhu n’olwa kali nda, anabà bwinjà. Ci erhi akabà arhacîcêsizi oku lusiku lwa kasharhu n’olwa kali nda, arhankabà bwinjà. <verse eid="NUM 19:12"/><verse number="13" style="v" sid="NUM 19:13"/>Owankahuma oku mufù, oku mubiri gw’omuntu wamafa, akabà arhacîcêsizi, oyôla anahemula endâro ya Nyamubâho; kukwânîne akagwe omu bene Israheli. Bulya galya mîshi gakûla ebizinzire garhabulajikire kuli ye; ali mugalugalu, n’agôla mazinga gâge anagayôrhana. <verse eid="NUM 19:13"/><verse number="14" style="v" sid="NUM 19:14"/>Alaga irhegeko erhi omuntu ankafira omw’lhêma. Ngasi yêshi wankajà muli eryo ihêma, na ngasi kalugu kali muli ryo, ebyôla byoshi byanabà bigalugalu kuhika nsiku nda. <verse eid="NUM 19:14"/><verse number="15" style="v" sid="NUM 19:15"/>Ngasi kalugu kafûnule, kalya karhagwêrhi cifûniko cisheke n’ehigozi, kânaba kagalugalu. <verse eid="NUM 19:15"/><verse number="16" style="v" sid="NUM 19:16"/>Ngasi yêshi wankahuma oku muntu wanigiragwa omu mashwa, erhi wundi ofîre kwônene erhi mavuha ga muntu, erhi oku cûsho, oyôla ânabà mugalugalu kuhika nsiku nda.<verse eid="NUM 19:16"/></para>
  <para style="s1">Amîshi g’okukangûla</para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 19:17"/>Kuli oyu muntu mugalugalu, banarhôla oku luvù lw’embâgwa yasingônolagwa nka nterekêro ya mpyûlo oku byâha, banabulagirakwo n’amîshi minjà gali omu kalugu. <verse eid="NUM 19:17"/><verse number="18" style="v" sid="NUM 19:18"/>Omuntu oyôsire bwinjà anayanka ebyâsi by’olwifûyè, na hano abà amabidobeza omu mîshi, anajiramwo olukangûlo oku nyumpa, oku ngasi kalugu n’oku bantu boshi banali halya, kuli omuntu wahumaga oku mavuha, erhi olya muntu bayîrhaga, erhi wundi ofîre kwônene erhi ohumire oku cûsho, <verse eid="NUM 19:18"/><verse number="19" style="v" sid="NUM 19:19"/>omuntu oli bwinjà anajira olukangûlo kuli olya oli mugalugalu, oku lusiku lwa kasharhu na olwa kali nda; anamukulira ecâha câge oku lusiku lwa kali nda. Oyôla muntu mugalugalu anashuka emyambalo yâge, naye yêne anacîshuka omu mîshi, na bijingo ânabà bwinjà. <verse eid="NUM 19:19"/><verse number="20" style="v" sid="NUM 19:20"/>Omuntu wankabà mugalugalu nka arhanacîcêsizi, anakagwe omu lubaga, bulya adwîrhe ahemula ahantu himâna ha Nyamubâho; bulya galya mîshi gakûla ebizinzire garhabulajikire kuli ye: ali mugalugalu. <verse eid="NUM 19:20"/><verse number="21" style="v" sid="NUM 19:21"/>Kuli bo lyabà irhegeko ly’ensiku zoshi. Olya muntu wajiraga olukangûlo lwa galya mîshi gakûla ebizinzire anashuka emyambalo yâge, owankahuma oku mîshi gakûla ebizinzire, anayôrha mugalugalu kuhika bijingo. <verse eid="NUM 19:21"/><verse number="22" style="v" sid="NUM 19:22"/>Ehi akahumwakwo oli mugalugalu, nahyo hinabè higalugalu, n’omuntu wankahihumakwo naye anabè mugalugalu kuhika bijingo<verse eid="NUM 19:22"/></para>
  <chapter eid="NUM 19"/>
  <chapter number="20" style="c" sid="NUM 20"/>
  <para style="ms1">VII. Okurhenga e Kadesi n’okuhika e Mowabu</para>
  <para style="s1">Amîshi ga Meriba</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 20:1"/>Bene Israheli, olubaga loshi bahika omw’irungu lya Sini, omu mwêzi murhanzi. Olubaga lwanacihanda aha Kadesi. Ho Miriyamu afiraga ahôla, ho banamubishire.<verse eid="NUM 20:1"/></para>
  <para style="s1">Okucîduduma kw’olubaga</para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 20:2"/>Bulyâla ahôla harhàli mîshi oku lubaga, boshi banacilundûkira emunda Mûsa na Aroni bali. <verse eid="NUM 20:2"/><verse number="3" style="v" sid="NUM 20:3"/>Olubaga lwalongôla na Mûsa, baderha mpu: Nîrhu rhucifaga galya mango bene wîrhu bafiraga embere za Nyamubâho ka kurhàli kwabà kwo kukulu? <verse eid="NUM 20:3"/><verse number="4" style="v" sid="NUM 20:4"/>Carhumaga olêrha olubaga lwa Nyamubâho munôla irungu, ka mpu lyo rhugûkumukiramwo rhwe n’ebintu bîrhu? <verse eid="NUM 20:4"/><verse number="5" style="v" sid="NUM 20:5"/>Carhumaga orhukûla e Mîsiri, oyisha orhudwîrhe hanôla hantu habî ntyâla? Harhali hantu hankahingwa cici, harhali mutini, harhali muzâbîbu, harhali makomamanga, ciru harhali na mîshi ga kunywa? <verse eid="NUM 20:5"/><verse number="6" style="v" sid="NUM 20:6"/>Mûsa na Aroni barhenga aha ndêko, bakanya baj’ebw’lhêma ly’e­mbugânano. Bakumba bûbi, n’irenge lya Nyamubâho lyanacibabonekera. <verse eid="NUM 20:6"/><verse number="7" style="v" sid="NUM 20:7"/>Nyamubâho ashambâza Mûsa aderha, erhi: <verse eid="NUM 20:7"/><verse number="8" style="v" sid="NUM 20:8"/>Oyanke kalya karhî, onakanye ogendishubûza olubaga we na mwene winyu Aroni; muderheze ibuye e­ mbêre zâbo, libahè amîshi gâlyo. Wanabarhengeza amîshi omwôla ibuye; wanaha olubaga lunywe n’ebintu byâbo. <verse eid="NUM 20:8"/><verse number="9" style="v" sid="NUM 20:9"/>Mûsa arhôla kalya karhî kali embere za Nyamubâho, nka kulya Nyamubâho anamurhegekaga. <verse eid="NUM 20:9"/><verse number="10" style="v" sid="NUM 20:10"/>Mûsa na Aroni bashûbûza olubaga halyâla ibuye<note caller="+" style="f"><char style="fr" closed="false">20, 10 </char><char style="ft" closed="false">Mûsa abula okurhumikira irhegeko Nyamubâho amuhâga (mulongo gwa 8). Ahâli h’okudesa ibuye, nk’oku bamurhumaga, abà lubaga lwo adesa na buzinda ashûrha kwa lirya ibuye. Omu kushimba engani y’Abadâhwa, kwanahashikana oku kwo kwarhumaga Aroni bône Mûsa batumula embere za Nyamubâho (<char style="xt"><ref loc="NUM 20:24">Mib 20, 24</ref>; <ref loc="NUM 27:14">27, 14</ref>; <ref loc="DEU 32:52">Lush 32, 52</ref></char>).</char></note>; Mûsa anacibabwîra erhi: «Yumvagi wâni bagoma! Ka rhwamurhengeza amîshi omûla ibuye?» <verse eid="NUM 20:10"/><verse number="11" style="v" sid="NUM 20:11"/>Mûsa anacilambûla okuboko, ashûrha kabirhi kulya ibuye n’akarhi kâge: mwanacivongoboka mîshi manji, olubaga lwanywa kuguma n’ebintu byâlo.<verse eid="NUM 20:11"/></para>
  <para style="s1">Okuhanwa kwa Mûsa na Aroni</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 20:12"/>Nyamubâho anacibwîra Mûsa na Aroni erhi: «Bulya murhanyêmîre n’okunkuza embere za bene Israheli, murhahise<note caller="+" style="f"><char style="fr" closed="false">20, 12 </char><char style="ft" closed="false">Nyamubâho abâna Mûsa na Aroni omu kubona babulaga obuyêmêre. Barhayêmêraga ho na halya akanwa Nyamubâho ababwîraga oku aha bene Israheli amîshi garhenga omu ibuye. Bamanya mpu nkaba okwo kurhankabà. Barhacihise olubaga omu cihugo babahiganyagya. Omu kulola <char style="xt"><ref loc="DEU 1:37">Lush 1, 37</ref>; <ref loc="DEU 3:26">3, 26</ref></char>, rhwanabona oku Mûsa akagagwa bubî bwa lubaga burhumire. Mib 20 na ngasi mahugûlo gâge goshi (Rhulole nka mulongo gwa 10), ahugwîre oku okukagwa kwa Mûsa kushimbire obubî bwâge yêne. Rhwanakubona omu mulongo gwa 4-5 erhi gwa 8-10. Mw’oko kwoshi, hali okubula obuyêmêre kwa Mûsa</char></note> olu lubaga mwa cirya cihugo nâluhà.» <verse eid="NUM 20:12"/><verse number="13" style="v" sid="NUM 20:13"/>Co cirhuma agôla mîshi gaderhwa mîshi ga Meriba, halya bene Israheli balongôlezagya Nyamubâho, naye anaciyêrekana obuhashe bwâge kuli bo.<verse eid="NUM 20:13"/></para>
  <para style="s1">Edomu abalahirira okuyikira</para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 20:14"/>Kurhenga e Kadesi, Mûsa anacirhuma entumwa emw’omwâmi w’e Edomu mpu bagendimubwîra erhi: «Kwo adesire ntyâla mwene winyu Israheli: Omanyire amalibûko goshi rhwamashimâna.» <verse eid="NUM 20:14"/><verse number="15" style="v" sid="NUM 20:15"/>Balarha banacibungulukira e Mîsiri; rhwanacibêra yo nsiku mwandu. Ci bene e Mîsiri harhulibuza oli rhwe oli balarha. <verse eid="NUM 20:15"/><verse number="16" style="v" sid="NUM 20:16"/>Rhwanacilakira Nyamubâho. Naye anaciyumva omulenge gwîrhu; arhuma malahika mpu arhukûle eyo Mîsiri. Lolà oku rhuli buno aha Kadesi, Lugo elubibi lw’ecihugo câwe. <verse eid="NUM 20:16"/><verse number="17" style="v" sid="NUM 20:17"/>«Oyêmêre rhutwikanye omu cihugo câwe; rhurhagere oli omw’ishwa, oli omu mizâbîbu; rhurhanywe ciru n’amîshi g’omu maliba gâwe; ci rhwashimbulira omulimbwa gw’ebwâmi, buzira kudungukira oli ebwa kulyo, oli ebwa kumosho, kuhika rhurhenge omu cihugo câwe coshi.» <verse eid="NUM 20:17"/><verse number="18" style="v" sid="NUM 20:18"/>Edomu anacimushuza, erhi: «Orhâgere emwâni, akabà onakuhizire, rhwagenzikanwa n’amatumu omu nfune.» <verse eid="NUM 20:18"/><verse number="19" style="v" sid="NUM 20:19"/>Bene Israheli banacimubwîra, mpu: «Mâshi, omu milimbwa rhwacisôkera, erhi rhwankanywa amîshi gâwe, nie n’amasò gâni nanakujuha. Ntà cindi nkuhûnyire, okurhali kugera n’amagulu kwônene.» <verse eid="NUM 20:19"/><verse number="20" style="v" sid="NUM 20:20"/>Edomu anacishuza, erhi: «Orhâgere.» Edomu anaciyisha arhabîre n’engabo yâge, ecibambizize bwenêne. <verse eid="NUM 20:20"/><verse number="21" style="v" sid="NUM 20:21"/>Ntyo kwo Edomu alahiriraga Israheli okugera omu cihugo câge, naye Israheli agendicizongolokera eburhambi bwâge.<verse eid="NUM 20:21"/></para>
  <para style="s1">Okufà kwa Aroni</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 20:22"/>Bene Israheli, olubaga loshi, barhenga e Kadesi, bahika oku ntondo ya Hori. <verse eid="NUM 20:22"/><verse number="23" style="v" sid="NUM 20:23"/>Nyamubâho anacibwirira Mûsa na Aroni okwo ntondo ya Hori, e lubibi lw’ecihugo ca Edomu, erhi: <verse eid="NUM 20:23"/><verse number="24" style="v" sid="NUM 20:24"/>«Aroni akola ajiluhûkira emw’olubaga lwâge; arhaje muli cirya cihugo nahà bene Israheli, bulya murhayumvagya oku namurhegekaga aha mîshi ga Meriba. <verse eid="NUM 20:24"/><verse number="25" style="v" sid="NUM 20:25"/>“Orhôle Aroni n’omugala Eleazari, obasôkane oku ntondo ya Hori”. <verse eid="NUM 20:25"/><verse number="26" style="v" sid="NUM 20:26"/>“Wahogola Aroni emyambalo<note caller="+" style="f"><char style="fr" closed="false">20, 26 </char><char style="ft" closed="false">Nk’oku anayambikaga Aroni emyambalo y’obudâhwa (<char style="xt"><ref loc="LEV 8:7-9">Lev 8, 7-9</ref></char>), kwo n’okwo Mûsa akola amuhogolayo; ayiyambike Eleazari, mugala wa Aroni (<char style="xt"><ref loc="EXO 29:29-30">Lub 29, 29-30</ref></char>). Mûsa ahogola Aroni emyambalo embere afè lyo alekiyishiba mugalugalu erhi akayishimuhumakwo ananafìre.</char></note> yâge, oyiyambike omugala Eleazari. Naye Aroni ashubire omu mulala gwâge, mwo agendifira”». <verse eid="NUM 20:26"/><verse number="27" style="v" sid="NUM 20:27"/>Mûsa anacijira nk’okwôla Nyamubâho anamurhegekaga. Banacisôkera oku ntondo ya Hori, erhi n’olubaga loshi ludwîrhe lwasinza. <verse eid="NUM 20:27"/><verse number="28" style="v" sid="NUM 20:28"/>Mûsa ahogola Aroni emyambalo yâge, ayiyambika omugala Eleazari. Aroni afîra ntyo oku irhwêrhwè ly’entondo. Mûsa na Eleazari banaciyandagala kulya ntondo. <verse eid="NUM 20:28"/><verse number="29" style="v" sid="NUM 20:29"/>Olubaga loshi lwabona oku Aroni anafîre, n’enyumpa y’Israheli yoshi yanacishiba Aroni nsiku makumi asharhu.<verse eid="NUM 20:29"/></para>
  <chapter eid="NUM 20"/>
  <chapter number="21" style="c" sid="NUM 21"/>
  <para style="s1">Okuhimwa kwa mwâmi w’e Aradi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 21:1"/>Omwâmi w’omunya-Kanâni, ye mwâmi w’e Aradi, ayûbakaga omu Nêgebu, ayumva oku Israheli ayiruka, anali omu njira y’e Atarimi. Oyo mwâmi atula bene Israheli kwo entambala, anacibagwarhamwo mpira nyinji. <verse eid="NUM 21:1"/><verse number="2" style="v" sid="NUM 21:2"/>Lêro Israheli arhôla omuhigo embere za Nyamubâho, aderha, erhi: «Yâgirwa, erhi wakampà olu lubaga, nanaluherêrhera n’ebishagala byâlo byoshi.» <verse eid="NUM 21:2"/><verse number="3" style="v" sid="NUM 21:3"/>Nyamubâho ayumva izù ly’Israheli, amuhà abo banya-Kanâni. Babageza oku boji bw’engôrho, babaherêrekeza n’ebishagala byâbo hyoshi. Aho bahayîrika izîno lya Horma.<verse eid="NUM 21:3"/></para>
  <para style="s1">Enjoka y’omulinga</para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 21:4"/>Banacirhenga oku ntondo ya Hori, bakulikira enjira ejîre ebwa nyanja ya Sufu, lyo bahashizunguluka ecihugo c’Edomu. Olubaga lwabula oburhwâli muli eyôla njira. <verse eid="NUM 21:4"/><verse number="5" style="v" sid="NUM 21:5"/>Lwanacirhondêra okucîdudumira Nyamuzinda na Mûsa, lwakaziderha, erhi: «Carhumaga warhukûla e Mîsiri mpu rhuyishifira muno irungu? Ntà mugati, ntà mîshi, rhwanayihisirwe n’ebi biryo b’ishali». <verse eid="NUM 21:5"/><verse number="6" style="v" sid="NUM 21:6"/>Oku bundi Nyamubâho anabarhumira enjoka nkali, zaluma olubaga, na bantu banji bafà muli bene Israheli. <verse eid="NUM 21:6"/><verse number="7" style="v" sid="NUM 21:7"/>Olubaga lwajà emunda Mûsa ali, lwaderha, erhi: «Rhwajizire ecâha, bulya rhwacidudumire Nyamubâho nâwe. Oshenge Nyamubâho arhukûle kw’ezi njoka». Mûsa agendisengerera olubaga. <verse eid="NUM 21:7"/><verse number="8" style="v" sid="NUM 21:8"/>Na Nyamubâho anacibwîra Mûsa, erhi: «Otule enjoka y’omulinga, oyimanike oku murhi wagwîka; ngasi yêshi wankabà analumirwe, erhi ankayilolakwo, anabà na akalamo». <verse eid="NUM 21:8"/><verse number="9" style="v" sid="NUM 21:9"/>Mûsa anacitula enjoka y’omulinga, anaciyimanika oku murhi, n’erhi hankabîre olumirwe n’enjoka, akalola kuli erya njoka y’omulinga, analame.<verse eid="NUM 21:9"/></para>
  <para style="s1">Okujà ishiriza lya Yordani</para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 21:10"/>Bene Israheli bagenda, bajihanda aha Oboti. <verse eid="NUM 21:10"/><verse number="11" style="v" sid="NUM 21:11"/>Barhenga aha Oboti bagendihanda aha Yabarimi, omw’irungu aha ishiriza lya bene Mowabu, olu­nda lw’ebuzûka-zûba. <verse eid="NUM 21:11"/><verse number="12" style="v" sid="NUM 21:12"/>Barhenga ahôla, bagendihanda omu kabanda ka Zaredi. <verse eid="NUM 21:12"/><verse number="13" style="v" sid="NUM 21:13"/>Barhenga aho, bagendihanda ah’ishiriza ly’Arnoni, lwîshi lurhenga omu bihugo by’Abanyamoreni, lukazihulula omw’irungu. Olwo lwîshi Arnoni, lwo lunaligi lubibi lw’ecihugo ca Mowabu n’eca Abanyamoreni. <verse eid="NUM 21:13"/><verse number="14" style="v" sid="NUM 21:14"/>Co carhumaga baderha ntyâla omu citabu c’amatabâro ga Nyamubâho, erhi: «Nyamubâho arhôzire Vahebi, n’obwo arhahimwa muhûsi, ahirakwo emigezi ya Arnoni, <verse eid="NUM 21:14"/><verse number="15" style="v" sid="NUM 21:15"/>kuguma n’amarhambi g’emigezi eri kurhenga oku karhondo ka Ari kuhika oku lubibi lwa Mowabu.» <verse eid="NUM 21:15"/><verse number="16" style="v" sid="NUM 21:16"/>Erhi barhenga aho bajà e Beri. Lyo lirya iriba Nyamubâho abwiriragaho Mûsa, erhi: «Oshûbûze olubaga, nkola naluhà amîshi.» <verse eid="NUM 21:16"/><verse number="17" style="v" sid="NUM 21:17"/>Lêro obwo, Israheli anacirhôla olwimbo aderha, erhi:</para>
  <para style="b" vid="NUM 21:17"/>
  <para style="q1" vid="NUM 21:17">«Cûka wâni maliba!</para>
  <para style="q1" vid="NUM 21:17">Mumukomere akagasha!<verse eid="NUM 21:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="NUM 21:18"/>Mwe maliba gahumbagwa n’abaluzi,</para>
  <para style="q1" vid="NUM 21:18">n’abagula b’olubaga bagayigula</para>
  <para style="q1" vid="NUM 21:18">n’akarhi k’obukulu, n’ebikoma byâbo omu irungu kujà e Matana!»<verse eid="NUM 21:18"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="19" style="v" sid="NUM 21:19"/>Kurhenga omw’irungu bajà e Matana; kurhenga e Matana bajà e Nahalieli; kurhenga e Nahalieli bajà e Bamoti. <verse eid="NUM 21:19"/><verse number="20" style="v" sid="NUM 21:20"/>Kurhenga e Bamoti bajà ebw’akabanda kali omw’ishwa lya bene Mowabu, okw’irhwêrhwè lya Pisga, ntondo ndîrî ebonekana omw’irungu lyoshi.<verse eid="NUM 21:20"/></para>
  <para style="s1">Okuhimwa kw’Abanyamoriti na Bashani</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 21:21"/>Israheli anacilika entumwa emwa Sihoni, mwâmi w’Abanyamoriti mpu bagendimubwîra, erhi: <verse eid="NUM 21:21"/><verse number="22" style="v" sid="NUM 21:22"/>«Ondeke nâni ngere omu cihugo câwe; rhurhadungukire oli omu mashwa, oli ebwa mizâbîbu; rhurhanywe n’amîshi g’amaliba; rhwakulikira omulimbwa gw’ebwâmi kuhika rhurhenge omu cihugo câwe.» <verse eid="NUM 21:22"/><verse number="23" style="v" sid="NUM 21:23"/>Ci Sihoni arhazigaga mpu Israheli atwikanye omu cihugo câge. Sihoni anacishûbûza olubaga lwâge loshi; anacikanya akola agendilwîsa bene Israheli omw’irungu; anacihika aha Yahasi, anacikoza entambala kuli bene Israheli. <verse eid="NUM 21:23"/><verse number="24" style="v" sid="NUM 21:24"/>Israheli amugeza oku bwôji bw’engôrho; amuhima, ananyaga ecihugo câge kurhenga kuli Arnoni kujà e Yaboki, kandi kuhika kuli bene Amoni, bulya Yazeri àli lubibi naye. <verse eid="NUM 21:24"/><verse number="25" style="v" sid="NUM 21:25"/>Israheli anacinyaga ezo ngo zoshi. Ayûbaka omu ngo zoshi za bene Amoriti, Heseboni n’ez’abashizi bâge. <verse eid="NUM 21:25"/><verse number="26" style="v" sid="NUM 21:26"/>Heseboni lwo lwàli lugo lunênênè lwa Sihoni, mwâmi w’Abanyamoriti. Sihoni ye wajagilwîsa omwâmi w’embere wa bene Mowabu, anamunyaga ecihugo câge coshi kuhika kuli Arnoni. <verse eid="NUM 21:26"/><verse number="27" style="v" sid="NUM 21:27"/>Co cirhuma abazihi baderha ntya: «Mukanye e Heseboni we! Olugo lwa Sihoni lushubiyûbakwa, banaluzibuhye! <verse eid="NUM 21:27"/><verse number="28" style="v" sid="NUM 21:28"/>Omuliro gwazûsire e Heseboni, engulumira omu lugo lwa Sihoni yamalîre Ari-Mowabu, yamirangusa entondo z’Arnoni! <verse eid="NUM 21:28"/><verse number="29" style="v" sid="NUM 21:29"/>Buhanya bwâwe, wâni Mowabu! Wamâhera weki lubaga lwa Kemoshi! Bagala bâge bayishaga bayâka, na bâli bâge bagwârhagwa; bajà ba Sihoni, mwâmi w’Abamoriti. <verse eid="NUM 21:29"/><verse number="30" style="v" sid="NUM 21:30"/>Iburha lyâbo lyashandâla kurhenga Heseboni kuhika aha Diboni. Rhwadulika omuliro kurhenga Nofahi kuhika Mediba.» <verse eid="NUM 21:30"/><verse number="31" style="v" sid="NUM 21:31"/>Israheli ayûbaka omw’ishwa ly’Abanyamoriti. <verse eid="NUM 21:31"/><verse number="32" style="v" sid="NUM 21:32"/>Mûsa arhuma abâge­ndilolêreza Yazeri, banacinyaga engo zâge zoshi; bashandabanya Abanyamoriti bazibâgamwo. <verse eid="NUM 21:32"/><verse number="33" style="v" sid="NUM 21:33"/>Banacigolonjoka, basôka omu njira y’e Bashani. Naye Og, mwâmi w’e Bashani, arhabâla n’engabo yâge yoshi mpu akola ajibalwikiza aha Edreyi. <verse eid="NUM 21:33"/><verse number="34" style="v" sid="NUM 21:34"/>Nyamubâho anacibwîra Mûsa, erhi: «Orhamurhînyaga, bulya mmuhizire omu maboko gâwe, ye olubaga lwâwe lwoshi, n’ecihugo câge coshi. Omukolere amabî nka kulya wagakoleraga Sihoni, mwâmi w’Abanyamoriti, wayûbaka­ga aha Heseboni». <verse eid="NUM 21:34"/><verse number="35" style="v" sid="NUM 21:35"/>Banacimuhima, n’abagala n’olubaga lwâge lwoshi. Harhasigalaga ciru n’omuguma ozîne n’ecihugo câge bacirhôla.<verse eid="NUM 21:35"/></para>
  <chapter eid="NUM 21"/>
  <chapter number="22" style="c" sid="NUM 22"/>
  <para style="s1">Bene Israheli balîkûla omu rhubanda rhwa Mowabu</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 22:1"/>Bene Israheli banacilîkûla bagendihanda omu rhubanda rhwa Mowabu, ab’ishiriza lya Yordani, hôfi na Yeriko <verse eid="NUM 22:1"/><verse number="2" style="v" sid="NUM 22:2"/>Balaka, mwene Sipori, abona ebi bene Israheli bajirire Abanyamoriti byoshi. <verse eid="NUM 22:2"/><verse number="3" style="v" sid="NUM 22:3"/>Mowabu arhemuka embere z’olwo lubaga erhi bunji bwâlò burhuma; yêshi ageramwo omusisi erhi bene Israheli bàrhuma. <verse eid="NUM 22:3"/><verse number="4" style="v" sid="NUM 22:4"/>Anacibwîra abashamuka ba Madiani, erhi: «Ka murhabwîni oku eyi nkûmo y’abantu yayisha yafôrha ngasi binarhuli eburhambi byoshi, nka kula enkafu enafôrha obuhasi omu mashwa». Balaka mwene Sipori ye wali mwâmi wa bene Mowabu muli ago mango. <verse eid="NUM 22:4"/><verse number="5" style="v" sid="NUM 22:5"/>Anacirhuma entumwa emwa Balâmu, mwene Beyori, aha Petori, oku burhambi bw’Olwîshi, omu cihugo ca bene Amafu. Amubwîra, erhi: «Lolà oku engabo erhenzire e Mîsiri ebumbire ecihugo, enayûbasire aha ishiriza ly’aha mwâni. <verse eid="NUM 22:5"/><verse number="6" style="v" sid="NUM 22:6"/>“Nkusengîre mâshi obiduhe ohehêrere olu lubaga, bulya lwamandusha misî. Lyoki nankaciluhima nandulibirhekwo lurhenge muno cihugo câni: bulya mmanyire oku oyu ogishire, anagishwe, n’oyu ohehêrerîre anahehêrerwe”».<verse eid="NUM 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 22:7"/>Abashamuka ba Mowabu n’abashamuka ba Madiani banacihira njira, banadwîrhe oluhembo bayishiha omushonga. Oku barhinda aha mwa Balâmu, banacimurhondêreza ebinwa bya Balaka. <verse eid="NUM 22:7"/><verse number="8" style="v" sid="NUM 22:8"/>Anacibashuza, erhi: «Mulâle hano, nyishibaha ishuzo nk’oku Nyamubâho akanambwîra.» Abo baluzi b’e Mowabu banacihanda aha mwa Balâmu. <verse eid="NUM 22:8"/><verse number="9" style="v" sid="NUM 22:9"/>Nyamubâho anaciyagâna Balâmu, amubwîra, erhi: «Bantu baci bala bali aha mwâwe»? <verse eid="NUM 22:9"/><verse number="10" style="v" sid="NUM 22:10"/>Balâmu ashuza Nyamuzinda, erhi: «Balaka mwene Sipori, mwâmi w’e Mowabu ye wabarhumaga mpu bayishimbwîra erhi: <verse eid="NUM 22:10"/><verse number="11" style="v" sid="NUM 22:11"/>Lolà olubaga lwarhenga e Mîsiri, lubumbire ecihugo coshi. Oyîshe, mâshi obahehêrere, lyoki nankahashilulwîsa, nandulibirhekwo.» <verse eid="NUM 22:11"/><verse number="12" style="v" sid="NUM 22:12"/>Nya­muzinda anacibwîra Balâmu, erhi: «Orhagendaga nabo, orhanahehêreraga olwo lubaga, bulya luli lugishe.» <verse eid="NUM 22:12"/><verse number="13" style="v" sid="NUM 22:13"/>Sêzi, Balâmu erhi azûka abwîra balya baluzi ba Balaka, erhi: «Shubiri emwinyu, bulya Nyamubâho andahirire okugenda haguma ninyu.» <verse eid="NUM 22:13"/><verse number="14" style="v" sid="NUM 22:14"/>Balya baluzi b’e Mowabu bahuma enjira yâbo, bashubira emwa Balaka, bamubwîra mpu: Balâmu alahire mpu arhankarhukulikira. <verse eid="NUM 22:14"/><verse number="15" style="v" sid="NUM 22:15"/>Balaka ashubirhumayo abandi baluzi, banji na ba cikono kulusha abarhanzi. <verse eid="NUM 22:15"/><verse number="16" style="v" sid="NUM 22:16"/>Erhi bahika aha mwa Balâmu banacimubwîra mpu: «Kwo adesire ntya Balaka mwene Sipori: “Mâshi, nkuhûnyire, ntâco cakuhanzagya okuyisha eno mwâni”; <verse eid="NUM 22:16"/><verse number="17" style="v" sid="NUM 22:17"/>“Bulya nakuhemba kulya kunakukwânîne, nankuhè ngasi ebi wankanampûna byoshi. Ci oyîshe, nkusengîre, ohehêrere olu lubaga”». <verse eid="NUM 22:17"/><verse number="18" style="v" sid="NUM 22:18"/>Balâmu anacishuza balya bambali ba Balaka erhi: «Ciru Balaka akampa enyumpa yâge eyunjwîre nfaranga na masholo, ntà mango nvune irhegeko lya Nyamubâho, Nyamuzinda wâni, omu cijiro cisungunu erhi cinene. <verse eid="NUM 22:18"/><verse number="19" style="v" sid="NUM 22:19"/>Bunôla mbahunyirage, ninyu mubêrage hano buno budufu, nâni mpashimanya oku Nyamubâho ashubibwîra.» <verse eid="NUM 22:19"/><verse number="20" style="v" sid="NUM 22:20"/>Nyamubâho anacijà emunda Balâmu ali muli obwôla budufu, anacimubwîra, erhi: «K’abà bantu barhajikuhamagala? Genda mwe nabo, ci orhajiraga oku ntakubwiziri.» <verse eid="NUM 22:20"/><verse number="21" style="v" sid="NUM 22:21"/>Balâmu anacizûka sêzi, n’erhi abà amashanira ecihêsi câge, bagenzikanwa na balya baluzi b’e Mowabu.<verse eid="NUM 22:21"/></para>
  <para style="s1">Endogomi ya Balâmu.</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 22:22"/>Oburhè bwa Nyamuzinda bwanaciyâka bulya Balâmu akola ajà eyo munda; na Malahika wa Nyamubâho acîhira muli erya njira mpu amucîke. Balamu àli àshonîre oku ndogomi yâge analusibwe na abambali bahirhi. <verse eid="NUM 22:22"/><verse number="23" style="v" sid="NUM 22:23"/>Erya ndogomi yanacibona Malahika wa Nyamubâho waliyimanzire omu njira anafumbasire engôrho nyômole; endogomi yaleka erya njira yacîjìra omu mashwa. Balâmu arhondêra ashûrha erya ndogomi yâge mpu ayishubiza omu njira. <verse eid="NUM 22:23"/><verse number="24" style="v" sid="NUM 22:24"/>Okubundi, Malahika wa Nyamubâho agendiyimanga omu njira ahâli omongobana, ekarhî k’emizâbîbu eyûbakirwe olugurhu olunda n’olundi lw’e­njira. <verse eid="NUM 22:24"/><verse number="25" style="v" sid="NUM 22:25"/>Endogomi yabona malahika wa Nyamubâho; yacîsinda oku lugurhu, yahirizakwo okugulu kwa Balâmu. Balâmu ashubiyishûrha. <verse eid="NUM 22:25"/><verse number="26" style="v" sid="NUM 22:26"/>Malahika wa Nyamubâho ajà embere kulusha, ayimanga ahafunda kulusha halya harhankahindamukwa ekulyo erhi ekumosho. <verse eid="NUM 22:26"/><verse number="27" style="v" sid="NUM 22:27"/>Erhi endogomi ebona Malahika wa Nyamubâho, yagwîshira idako lya Balâmu. Lêro Balâmu abà burhè, arhondêra ayishûrha akarhi kâge. <verse eid="NUM 22:27"/><verse number="28" style="v" sid="NUM 22:28"/>Nyamubâho ayigula akanwa k’erya ndogomi, yanacibwîra Balâmu, erhi: «Kurhi nieki nakujirîre obu wanshûrha kasharhu?» <verse eid="NUM 22:28"/><verse number="29" style="v" sid="NUM 22:29"/>Balâmu ashuza endogomi, erhi: «Bulya wamancinirakwo; nka nali nfumbasire engôrho, nali nakuyîrha ho n’aha.» <verse eid="NUM 22:29"/><verse number="30" style="v" sid="NUM 22:30"/>Erya ndogomi yashuza Balâmu, erhi: «Ka ntali ndogomi yâwe, eyi okaziyôrha wagendakwo kuhika ene? Ka okola obwîne nakujirira ntya bundi?» Anacishuza, erhi: «Nanga.»<verse eid="NUM 22:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 22:31"/>Nyamubâho anacibwîkûla amasù ga Balâmu. Abona olya Malahika wa Nyamubâho, ali afumbasire engôrho nyômole. Afukamiriza akumba bûbi. <verse eid="NUM 22:31"/><verse number="32" style="v" sid="NUM 22:32"/>Malahika wa Nyamubâho anacimubwîra, erhi: «Carhumaga Oshûrha endogomi yâwe kasharhu koshi? Nie nyishire nti nkucîke, bulya orhankagera nka ndi mw’eyi njira. <verse eid="NUM 22:32"/><verse number="33" style="v" sid="NUM 22:33"/>Endogomi yambwîne, yanakacîhindamukira ngasi kumbona, kasharhu kakulikirîne. N’erhahindamukaga ecîyegûla embere zâni, nali nakuyîrha, nayo nyireke egende ezîne.» <verse eid="NUM 22:33"/><verse number="34" style="v" sid="NUM 22:34"/>Balâmu anacibwîra olya Malahika wa Nyamubâho, erhi: «Najizire ecâha. Ntalimanyire oku oli omu njira embere zâni. Na bunôla akabà kugaya ogayire, niono nagaluka.» <verse eid="NUM 22:34"/><verse number="35" style="v" sid="NUM 22:35"/>Malahika wa Nyamubâho anacishuza Balâmu, erhi: «Ogende n’abà balume. Ci orhayishiderhe akandi kanwa okuleka aka nayishikubwîra. Balâmu anacigenzikanwa na balya baluzi ba Balaka».<verse eid="NUM 22:35"/></para>
  <para style="s1">Balâmu na Balaka</para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 22:36"/>Balaka erhi ayumva oku Balâmu ayishire, ajimuyankirira olunda lw’e Mowabu elubibi lw’Arnoni, aha buzinda bw’ecihugo. <verse eid="NUM 22:36"/><verse number="37" style="v" sid="NUM 22:37"/>Balaka anacibwîra Balâmu, erhi: «Ka ntalinkurhumire abajà bugo ntibajikuhamagala? Carhumaga orhayisha emunda ndi? Ka ntankahasha okukujirira kulya kunakukwânîne?» <verse eid="NUM 22:37"/><verse number="38" style="v" sid="NUM 22:38"/>Balâmu anacishuza Balaka, erhi: «Sinza, niono nyishire emunda oli, ka nankaderhaga akanwa? Oluderho Nyamubâho ahira omu kanwa kâni lwo nanaderha.» <verse eid="NUM 22:38"/><verse number="39" style="v" sid="NUM 22:39"/>Balâmu analikula na Balaka, banacihika aha Kiriyati-Huzoti. <verse eid="NUM 22:39"/><verse number="40" style="v" sid="NUM 22:40"/>Balaka aniga enkafu n’ebibuzi; abihêkerakwo Balâmu na balya baluzi banali naye. <verse eid="NUM 22:40"/><verse number="41" style="v" sid="NUM 22:41"/>Erhi buca, Balaka ajirhôla Balâmu, basôkera bombi e Bamoti-Baala, ho akahashire okuhonera emirongo mizinda y’olubaga.<verse eid="NUM 22:41"/></para>
  <chapter eid="NUM 22"/>
  <chapter number="23" style="c" sid="NUM 23"/>
  <para style="s1">Balâmu agisha bene Israheli</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 23:1"/>Balâmu abwîra Balaka, erhi: «Onyûbakirage hano mpêrero nda, onanteganyize mpanzi nda hano na ngandabuzi nda.» <verse eid="NUM 23:1"/><verse number="2" style="v" sid="NUM 23:2"/>Balaka anacijira nk’okwo Balâmu anamuhûnaga. Anacirherekêra empanzi n’engandabuzi oku ngasi luhêrero. <verse eid="NUM 23:2"/><verse number="3" style="v" sid="NUM 23:3"/>Balâmu anacibwîra Balaka, erhi: «Yimanga hôfi n’eyi nterekêro yâwe okunacîyegûla hitya; hali amango Nyamubâho akambugâna. Ebi akanyêreka byo nâni nakanakumanyisa.» Anacikanya ajà oku hirhondo hirhalikwo cici.<verse eid="NUM 23:3"/></para>
  <para style="s1">Obulêbi bwa Balâmu</para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 23:4"/>Nyamuzinda anacishimânana na Balâmu; naye anacimubwîra, erhi: «Nayûbasirage mpêrero nda, na kuli ngasi luhêrero najirîrekwo enterekêro y’empanzi n’engandabuzi». <verse eid="NUM 23:4"/><verse number="5" style="v" sid="NUM 23:5"/>Nyamubâho anacihira ecinwa omu kanwa ka Balâmu, anacimubwîra, erhi: «Oshubirage emunda Balaka ali, ntyo kwo waderha.» <verse eid="NUM 23:5"/><verse number="6" style="v" sid="NUM 23:6"/>Balâmu anacishubira emunda ali ashimâna anaciyimanzire aha nterekêro yâge, yo n’abaluzi ba Mowabu boshi. <verse eid="NUM 23:6"/><verse number="7" style="v" sid="NUM 23:7"/>Anaciderha binôla binwa, erhi:</para>
  <para style="b" vid="NUM 23:7"/>
  <para style="q1" vid="NUM 23:7">«Balaka anacintenza e Arami,</para>
  <para style="q1" vid="NUM 23:7">Omwâmi w’e Mowabu anantenzize</para>
  <para style="q1" vid="NUM 23:7">omu birhondo by’e Buzûka-zûba,</para>
  <para style="q1" vid="NUM 23:7">ampûna erhi: Oyîshe ompehêrerere Yakôbo!</para>
  <para style="q1" vid="NUM 23:7">Oyîshe ofûhire Israheli!»<verse eid="NUM 23:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 23:8"/>«Kurhigi nankahehêrera, amango Nyamuzinda arhahehêriri?»</para>
  <para style="q1" vid="NUM 23:8">Kurhigi nankafûha, amango Nyamuzinda arhafûha?<verse eid="NUM 23:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 23:9"/>Bulya, kurhenga okw’irhwêrhwè ly’aga mabuye namamubona.</para>
  <para style="q1" vid="NUM 23:9">Kurhenga okw’irhwêrhwè ly’orhurhondo, namamulolêreza.</para>
  <para style="q1" vid="NUM 23:9">Luli lubaga luyûbasire hâgo hâgo, lurhankanaja oku mubalè gw’agandi mashanja.<verse eid="NUM 23:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NUM 23:10"/>Ndi wankaganja entuliri ya Yakôbo,</para>
  <para style="q1" vid="NUM 23:10">ndi wankaberûla enkûmo y’Israheli?</para>
  <para style="q1" vid="NUM 23:10">Mbofa nk’abashinganyanya,</para>
  <para style="q1" vid="NUM 23:10">n’akalamo kâni kaboyûrha aka akâbo!<verse eid="NUM 23:10"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="11" style="v" sid="NUM 23:11"/>Balaka anacibwîra Balâmu, erhi: «Kwo kurhi oku wamanjirira? Nakurhôlaga nti ohehêrere abashombanyi bâni, lêro wêhe kwamaba kubagisha». <verse eid="NUM 23:11"/><verse number="12" style="v" sid="NUM 23:12"/>Balâmu ashuza, erhi: «Ka ntagwâsirwi nderhe kulya Nyamubâho anahizire omu kanwa kâni?» <verse eid="NUM 23:12"/><verse number="13" style="v" sid="NUM 23:13"/>Balaka anacimubwîra, erhi: «Nkulikiraga ahandi hantu. Olu lubaga wabona ntya, olubwîne lunda luguma, ci orhalubwini lwoshi. Olu­mpehehêrere lêro aho». <verse eid="NUM 23:13"/><verse number="14" style="v" sid="NUM 23:14"/>Amujâna ebw’Ishamba ly’Abalâlîzi, okw’irhwêrhwè ly’entondo ya Pisga; ayûbakakwo mpêrero nda, kuli ngasi luguma arherekerêrakwo mpanzi nguma na ngandabuzi nguma. <verse eid="NUM 23:14"/><verse number="15" style="v" sid="NUM 23:15"/>Balâmu anacibwîra Balaka, erhi: « Obêre hôfi n’eyîra nterekêro yâwe nâni nkola nagendirinda.» <verse eid="NUM 23:15"/><verse number="16" style="v" sid="NUM 23:16"/>Nyamubâho anacishimâna Balâmu, anacimuhira ecinwa omu kanwa kâge, anacimubwîra, erhi: «Oshubire emunda Balaka ali, ogendimubwîra ebi binwa.» <verse eid="NUM 23:16"/><verse number="17" style="v" sid="NUM 23:17"/>Anacishubira emunda Balaka ali ayîmanzire hôfi n’enterekêro yâge n’abaluzi b’e Mowabu banali boshi naye. Balaka anacimudôsa erhi: «Kurhi Nyamubâho anadesirage?» <verse eid="NUM 23:17"/><verse number="18" style="v" sid="NUM 23:18"/>Kandi Balâmu anaciderha ebi binwa, erhi:</para>
  <para style="b" vid="NUM 23:18"/>
  <para style="q1" vid="NUM 23:18">«Yimuka Balaka, onayumve,</para>
  <para style="q1" vid="NUM 23:18">ntega okurhwiri, mwene Sipori».<verse eid="NUM 23:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="NUM 23:19"/>Nyamuzinda arhabà muntu okazinywerha</para>
  <para style="q1" vid="NUM 23:19">arhali mwene Adamu okazicîyunjuza.</para>
  <para style="q1" vid="NUM 23:19">Ka ye oderha kône arhanajire cici?</para>
  <para style="q1" vid="NUM 23:19">Ka ye oderha akanwa karhanabè kulya anaderhaga?<verse eid="NUM 23:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="NUM 23:20"/>Nahâbirwe irhegeko ly’okugisha;</para>
  <para style="q1" vid="NUM 23:20">nagisha, ntanaciyunjuze.<verse eid="NUM 23:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="NUM 23:21"/>Ntabwîni bubî buci muli Yakôbo.</para>
  <para style="q1" vid="NUM 23:21">Ntabwîni ntanya nci muli Israheli.</para>
  <para style="q1" vid="NUM 23:21">Nyamubâho Nyamuzinda wâge ali naye,</para>
  <para style="q1" vid="NUM 23:21">aha mwâge wanayumva ecihôgêro c’aha bwâmi.<verse eid="NUM 23:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 23:22"/>Nyamuzinda wamukulaga e Mîsiri,</para>
  <para style="q1" vid="NUM 23:22">emisî yâge eri ya mbogo.<verse eid="NUM 23:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="NUM 23:23"/>Bulya ntà bulozi bwankadunda Yakôbo</para>
  <para style="q1" vid="NUM 23:23">na ntà bulaguzi bwankahasha Israheli.</para>
  <para style="q1" vid="NUM 23:23">Ciru akabà Yakôbo na Israheli banabwirwe mpu:</para>
  <para style="q1" vid="NUM 23:23">«Kurhi oku Nyamuzinda ajira?»<verse eid="NUM 23:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 23:24"/>Lolà olubaga lwacinânûla nka ntale nkazi,</para>
  <para style="q1" vid="NUM 23:24">lwamacûka nka ntale ndume;</para>
  <para style="q1" vid="NUM 23:24">erhahunga erhanacishanshanyula nsimba yayo,</para>
  <para style="q1" vid="NUM 23:24">n’okunywa omukò gw’ebi yanigaga.<verse eid="NUM 23:24"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="25" style="v" sid="NUM 23:25"/>Balaka abwîra Balâmu, erhi: «Olekage okubahehêrera, ci kwône orhabagishaga.» <verse eid="NUM 23:25"/><verse number="26" style="v" sid="NUM 23:26"/>Balâmu ashuza Balaka, erhi: «Ka ntakubwizire oku najira oku Nyamuzinda anadesire kwoshi?» <verse eid="NUM 23:26"/><verse number="27" style="v" sid="NUM 23:27"/>Balaka anacibwîra Balâmu, erhi: «Kanyagya nkuheke ahandi hantu. Nkaba aho hanasîmîsa Nyamuzinda, akuyêmêrere obampehêrerere». <verse eid="NUM 23:27"/><verse number="28" style="v" sid="NUM 23:28"/>Balaka anacijâna Balâmu oku ntondo ya Peyori, ebonekîne omw’irungu lyoshi. <verse eid="NUM 23:28"/><verse number="29" style="v" sid="NUM 23:29"/>Balâmu anacibwîra Balaka, erhi: «Onyûbakire aha mpêrero nda, onanteganyize aha mpanzi nda na ngandabuzi nda.» <verse eid="NUM 23:29"/><verse number="30" style="v" sid="NUM 23:30"/>Balaka anacijira nk’oku Balâmu anamubwîraga, arherekêra empanzi n’engandabuzi oku ngasi luhêrero.<verse eid="NUM 23:30"/></para>
  <chapter eid="NUM 23"/>
  <chapter number="24" style="c" sid="NUM 24"/>
  <para style="s1">Balâmu ashubigisha Israheli</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 24:1"/>Balâmu abona oku Nyamubâho arhonyize okugisha Israheli, lêro arhacijaga nk’agandi mango ebwa kugendidôsa embuko, ci ayêrekeza obusù bwâge ebwa irungu. <verse eid="NUM 24:1"/><verse number="2" style="v" sid="NUM 24:2"/>Erhi Balâmu abà amâyinamula amasù, abona oku bene Israheli bahanzire ishanja oku lindi, anaciyagânwa na Mûka gwa Nyamuzinda, <verse eid="NUM 24:2"/><verse number="3" style="v" sid="NUM 24:3"/>aderha ecinwa câge, erhi:</para>
  <para style="b" vid="NUM 24:3"/>
  <para style="p" vid="NUM 24:3">Obugeremwa bwa Balâmu mwene Beori,</para>
  <para style="p" vid="NUM 24:3">Obugeremwa bwa omuntu onizire isù,<verse eid="NUM 24:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 24:4"/>Obugeramwa bwa olya muntu oyumva ebinwa bya Nyamuzinda,</para>
  <para style="p" vid="NUM 24:4">Kubona abona ebi Ogala-byoshi ayêrekana,</para>
  <para style="p" vid="NUM 24:4">anahâbwe n’ishuzo limâna n’amasù gâge gabungûke.<verse eid="NUM 24:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 24:5"/>Alà oku gayinjiha amahêma gâwe Yakôbo!</para>
  <para style="p" vid="NUM 24:5">n’enyumpa zâwe, Israheli!<verse eid="NUM 24:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 24:6"/>Nka kula orhubanda rhulanduka,</para>
  <para style="p" vid="NUM 24:6">nka kula amashwa mahinge oku lwîshi,</para>
  <para style="p" vid="NUM 24:6">nka binûsi Nyamubâho arhwêraga,</para>
  <para style="p" vid="NUM 24:6">nka kula emiyerezi elandira oku burhambi bw’amîshi.<verse eid="NUM 24:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 24:7"/>Amîshi ganasheshe ebi bindi byâge,</para>
  <para style="p" vid="NUM 24:7">n’emburho yâge egundumuke enyanya ly’ago mîshi manji,</para>
  <para style="p" vid="NUM 24:7">omwâmi wâge ayisha ayêrêra enyanya ly’Agagi,</para>
  <para style="p" vid="NUM 24:7">n’obwâmi bwâge bwajire irenge!<verse eid="NUM 24:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 24:8"/>Nyamuzinda amurhenza e Mîsiri:</para>
  <para style="p" vid="NUM 24:8">amuhà emisî eri nka ya mbogo.</para>
  <para style="p" vid="NUM 24:8">Yamalîra amashanja gashingalala embere zâge.</para>
  <para style="p" vid="NUM 24:8">Yabavunangula orhuvuha, anabatyabule n’emyampi yâge.<verse eid="NUM 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 24:9"/>Anagonye amadwî, acîbundike nka ntale ndume,</para>
  <para style="p" vid="NUM 24:9">nk’amacîbundika nka nsimba, ndi wankacimuzûsa?</para>
  <para style="p" vid="NUM 24:9">Agishwe, owâkugishe n’owakuhinde, akahindwa!<verse eid="NUM 24:9"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="10" style="v" sid="NUM 24:10"/>Oburhè bwa Balaka bwayâka bwenêne kuli Balâmu, ashûrha omu nfune, amubwîra erhi: «Nalikuhamagala nti ohehêrere abashombanyi bâni, wêhe kwamabà kubagisha kasharhu. <verse eid="NUM 24:10"/><verse number="11" style="v" sid="NUM 24:11"/>Na buno yimukaga duba olibirhire emwâwe! Nali ndesire nti nakujira oj’irenge; lêro lolà oku Nyamubâho amakuyegûla kuli lyo.» <verse eid="NUM 24:11"/><verse number="12" style="v" sid="NUM 24:12"/>Balâmu anacishuza Balaka erhi: «Ka ntali erhi nabwîzire entumwa wali orhumire, oku: <verse eid="NUM 24:12"/><verse number="13" style="v" sid="NUM 24:13"/>Ciru Balaka akampa enyumpa yâge eyunjwîre nfaranga na masholo, ntakavuna irhegeko lya Nyamubâho, omu kujira niene nk’oku nnonzize okujira ehinja erhi ehibî; n’oku ngasi oku Nyamubâho anadesire kwo naderha? <verse eid="NUM 24:13"/><verse number="14" style="v" sid="NUM 24:14"/>Alaga oku bunôla nkola nacîshubirira emw’olubaga lwâni; yishaga nkubwîre ehi olu lubaga lwanajirîre olubaga lwâwe omu nsiku zàyisha». <verse eid="NUM 24:14"/><verse number="15" style="v" sid="NUM 24:15"/>Okuhandi anaciderha ebi binwa, erhi:</para>
  <para style="b" vid="NUM 24:15"/>
  <para style="p" vid="NUM 24:15">Bugeramwa bwa Balâmu mwene Beori,</para>
  <para style="p" vid="NUM 24:15">bugeramwa bw’omuntu wanizire isù,<verse eid="NUM 24:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 24:16"/>bugeramwa bw’olya muntu oyumva ebinwa bya Nyamuzinda</para>
  <para style="p" vid="NUM 24:16">ye oyishi eby’Ow’Enyanya</para>
  <para style="p" vid="NUM 24:16">ye olya obona ebyanacibonwe by’Ogala-byoshi</para>
  <para style="p" vid="NUM 24:16">olya okûmba bûbi anagalirhondêra abona.<verse eid="NUM 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 24:17"/>Namamubona, ci kwône arhacibà wa buno;</para>
  <para style="p" vid="NUM 24:17">namamulâba ci kwône arhacibà nk’oli hôfi.</para>
  <para style="p" vid="NUM 24:17">Enyenyêzi yamârhenga muli Yakôbo,</para>
  <para style="p" vid="NUM 24:17">akarhi k’obwâmi kamayimanga omu Israheli;</para>
  <para style="p" vid="NUM 24:17">kamavunanga emyanganga ya Mowabu,</para>
  <para style="p" vid="NUM 24:17">Kamamalîra bene Seti.<verse eid="NUM 24:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 24:18"/>Ecihugo c’Edomu camagwârhwa busâsa,</para>
  <para style="p" vid="NUM 24:18">na Seyiri kwo n’okwo; Israheli amâlambûla obuhashe bwâge.<verse eid="NUM 24:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 24:19"/>Emwa Yakôbo yamârhenga omurhegesi</para>
  <para style="p" vid="NUM 24:19">ye wamalîra ngasi bicisigîre omu ngo na Edomu.<verse eid="NUM 24:19"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="20" style="v" sid="NUM 24:20"/>Balâmu abona Amaleki, anacimubwîra ebi binwa, erhi: «Amaleki lyo ishanja likulu omu mashanja, n’obuzinda bwâge kwabà kushâbûka». <verse eid="NUM 24:20"/><verse number="21" style="v" sid="NUM 24:21"/>Balâmu anacibona bene Keneti, anaciderha, erhi: Aha mwinyu bahazibuhize, ewe Kayini, n’enyumpa zinyu ziri nyûbake oku ibuye. <verse eid="NUM 24:21"/><verse number="22" style="v" sid="NUM 24:22"/>Ci kwônene olugo lwinyu lubà lwa Beori; amango gahi mwanarhenge omu bujà bwa Asûru? <verse eid="NUM 24:22"/><verse number="23" style="v" sid="NUM 24:23"/>Balâmu ashubirira aderha ebi binwa, erhi: Aye, amashanja g’emashinji gabugânana emwênè, <verse eid="NUM 24:23"/><verse number="24" style="v" sid="NUM 24:24"/>n’enkugè olunda lw’e Kitimi. Gamalibûsa Asûru, gamabengeza Eberi; naye obuzinda bwâge kuli kuherêrekera lwoshi. <verse eid="NUM 24:24"/><verse number="25" style="v" sid="NUM 24:25"/>Balâmu erhi abà amayimuka, ahuma njira, acîshubirira emwâge; naye Balaka ajà lwâge lunda.<verse eid="NUM 24:25"/></para>
  <chapter eid="NUM 24"/>
  <chapter number="25" style="c" sid="NUM 25"/>
  <para style="s1">Obubî bwa bene Israheli omu rhubanda rhwa Mowabu</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 25:1"/>Israheli anacijà e Shitimu. Olubaga lwarhondêra olugendo lubî n’abanyere b’e Mowabu. <verse eid="NUM 25:1"/><verse number="2" style="v" sid="NUM 25:2"/>Balinda baluhengulira ebwa kuharâmya abazimu bâbo. Olubaga lwalya lwanafukamira abo bazimu. <verse eid="NUM 25:2"/><verse number="3" style="v" sid="NUM 25:3"/>Erhi Israheli acîshwêkera oku muzimu Bal-Peori, oburhè bwa Nyamubâho bwanaciyâka kuli Israheli. <verse eid="NUM 25:3"/><verse number="4" style="v" sid="NUM 25:4"/>Nyamubâho anacibwîra Mûsa, erhi: «Oshubûze abarhambo b’olubaga boshi. Obamanikire Nyamubâho embere ly’izûba, lyo oburhè bunji bwa Nyamuzinda buzima kuli bene Israheli.» <verse eid="NUM 25:4"/><verse number="5" style="v" sid="NUM 25:5"/>Mûsa anacibwîra abatwî b’emmanja omu Israheli, erhi: «Ngasi muguma muli mwe ayîrhe balya ba muli bene wâbo bàjîre emwa Bal-Peori». <verse eid="NUM 25:5"/><verse number="6" style="v" sid="NUM 25:6"/>Lolà oku ago mango, muntu muguma wa muli bene Israheli anaciyisha adwîrhe embere za bene wâbo omukazi w’omunya-Madiani, erhi na Mûsa adwîrhe asinza, n’omu masù g’olubaga lwa bene Israheli boshi, ludwîrhe lwalakira aha Muhango gw’Ihêma ly’embugânano. <verse eid="NUM 25:6"/><verse number="7" style="v" sid="NUM 25:7"/>Erhi abona kulya, Pinehasi mwene Eleazari, mugala w’omudâhwa Aroni, anacibaduka omu karhî k’olubaga, ayanka itumu, <verse eid="NUM 25:7"/><verse number="8" style="v" sid="NUM 25:8"/>akulikira olya mulume munya-Israheli enyuma l’Ihêma ly’embugânano, abatumirha bombi: olya mulume munya-Israheli n’olya mukazi abafubula enda. Obuhanya bwàli budwîrhe bwayîrha bene Israheli bwayimanga. <verse eid="NUM 25:8"/><verse number="9" style="v" sid="NUM 25:9"/>Bantu bihumbi makumi abirhi na bâni bàfîre n’obwo buhanya.<verse eid="NUM 25:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 25:10"/>Nyamubâho ashambâza Mûsa, amubwîra, erhi: <verse eid="NUM 25:10"/><verse number="11" style="v" sid="NUM 25:11"/>Pinehasi, mwene Eleazari, mugala w’omudâhwa Aroni ye orhumire oburhè bwâni burhûlirira kuli bene Israheli, bulya analigwêrhwe n’omutula gwâni ekarhî ka bene Israheli; ye warhumire muli ogwo mutula gwâni ntamalìra bene Israheli. <verse eid="NUM 25:11"/><verse number="12" style="v" sid="NUM 25:12"/>Co cirhumire ndesire oku: mbahire endagâno yâni y’omurhûla. <verse eid="NUM 25:12"/><verse number="13" style="v" sid="NUM 25:13"/>Yâbà kuli ye n’oku iburha lyâge enyuma zâge; yâbà ndagâno y’obudâhwa bw’ensiku zoshi. Na bulya anabwîne omutula erhi Nyamuzinda wâge orhuma, anahasha okujira enterekêro y’empyûlo kuli bene Israheli.<verse eid="NUM 25:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 25:14"/>Olya mulume w’omunya Israheli wayîrhagwa bône olya mukazi w’omu­nya-Madiani, izîno lyâge ye Zimri, mwene Salu, àli murhambo w’omulala gwa bene Simoni. <verse eid="NUM 25:14"/><verse number="15" style="v" sid="NUM 25:15"/>Naye olya mukazi w’omunya-Madiani wayîrhagwa, izîno lyâge ye Kozbi, mwâli wa Suru, murhambo muguma w’omu milala y’e Madiani. <verse eid="NUM 25:15"/><verse number="16" style="v" sid="NUM 25:16"/>Nyamubâho anacibwîra Mûsa, erhi: <verse eid="NUM 25:16"/><verse number="17" style="v" sid="NUM 25:17"/>Abanya-Madiani, obafarhirize onabayabûse, <verse eid="NUM 25:17"/><verse number="18" style="v" sid="NUM 25:18"/>bulya bo bâli barhangiriza okummuyabûsa, omu bwengehusi bwâbo mwa birya bya Peori na mwa birya bya Kozbi, mwâli w’omurhambo w’e Madiani, olya wayîrhagwa olusiku lw’obuhanya Peori alêrhaga.<verse eid="NUM 25:18"/></para>
  <chapter eid="NUM 25"/>
  <chapter number="26" style="c" sid="NUM 26"/>
  <para style="ms1">VIII. Amarheganyo mahyâhya</para>
  <para style="s1">Omubalè gwa kabirhi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 26:1"/>Erhi bayûsihanwa ntyo<note caller="+" style="f"><char style="fr" closed="false">26, 1 </char><char style="ft" closed="false">Kuhanwa kw’Israheli, lolà: Emibalè 25, 19 omu bindi biyandike</char></note>, Nyamubâho anacibwîra Mûsa n’Eleazari, mwene omudâhwa Aroni, erhi: <verse eid="NUM 26:1"/><verse number="2" style="v" sid="NUM 26:2"/>Ojire omubalè gwa bene Israheli boshi<note caller="+" style="f"><char style="fr" closed="false">26, 2 </char><char style="ft" closed="false">Ogwo mubalè gwa bene Israheli boshi gwabà muhyâhya bulya abantu baganjagwa amango g’omubalè murhanzi, boshi bafirîre omu irungu (mulongo gwa 64)</char></note>, kurhenga oku wa myâka makumi abirhi kujà enyanya, nk’oku emilala ya bashakulûza bâbo enakulikirîne muli bene Israheli boshi ojire omubalè gwa balya boshi bakanahashaga okuhêka emirasano. <verse eid="NUM 26:2"/><verse number="3" style="v" sid="NUM 26:3"/>Mûsa n’omudâhwa Eleazari banacibwîra bene Israheli ntyo omu kabanda ka Mowabu, hôfi na Yordani, aha ishiriza lya Yeriko. <verse eid="NUM 26:3"/><verse number="4" style="v" sid="NUM 26:4"/>Mujire omubalè gwa bene Israheli, kurhenga oku wa myâka makumi abirhi kujà enyanya (nka kulya Nyamubâho anarhegekaga Mûsa na bene Israheli, galya mango barhengaga omu cihugo c’e Mîsiri). <verse eid="NUM 26:4"/><verse number="5" style="v" sid="NUM 26:5"/>Rubeni yo nfula y’Israheli, Bene Rubeni bali: Kuli Henoki, omulala gwa Abahenoki; kuli Palu, omulala gwa Abapalu. <verse eid="NUM 26:5"/><verse number="6" style="v" sid="NUM 26:6"/>Kuli Hezroni, omulala gwa Abahezroni; kuli Karmi, omulala gwa Abakarmi. <verse eid="NUM 26:6"/><verse number="7" style="v" sid="NUM 26:7"/>Yo milala ya bene Rubeni eyo, Abaganjirwe muli bo boshi bâli balume bihumbi makumi anni na bisharhu na bantu magana galinda na makumi asharhu. <verse eid="NUM 26:7"/><verse number="8" style="v" sid="NUM 26:8"/>Bene Palu ali Eliabu, <verse eid="NUM 26:8"/><verse number="9" style="v" sid="NUM 26:9"/>Bene Eliabu bâli: Namueli, Datani n’oyôla wâbo Abirami, balya bâli bashamuka bw’omw’ihano, balya bacîhindulaga kuli Mûsa n’Aroni, omu murhwe gwa Korè, galya mango acîhinduliraga Nyamubâho. <verse eid="NUM 26:9"/><verse number="10" style="v" sid="NUM 26:10"/>Obudaka bwanaciyashama bwabamirangusa (na Korè, galya mango omurhwe gwâge gwafaga, go mango omuliro gwamiragusagya bantu magana abirhi na makumi arhanu. Babà lwîganyo oku bandi. <verse eid="NUM 26:10"/><verse number="11" style="v" sid="NUM 26:11"/>Ci kwône bene Korè barhafaga). <verse eid="NUM 26:11"/><verse number="12" style="v" sid="NUM 26:12"/>Bene Simoni, kulya emilala yâbo enagenzire: Kuli Namueli omulala gw’Abayanamueli; kuli Yakini, omulala gw’Abayakini; kuli Yakini, omulala gw’Abayamini; <verse eid="NUM 26:12"/><verse number="13" style="v" sid="NUM 26:13"/>Kuli Zera, omulala gw’Abazera; kuli Shaulu, Abashauli. <verse eid="NUM 26:13"/><verse number="14" style="v" sid="NUM 26:14"/>Yo milala ya bene Simoni eyo: boshi haguma bihumbi makumi abirhi na bibirhi na bantu magana abirhi. <verse eid="NUM 26:14"/><verse number="15" style="v" sid="NUM 26:15"/>Bene Gadi, kulya emilala yâbo enagenzire: Kuli Sefoni, omulala gw’Abaasefoni; Kuli Hagi, omulala gw’Abahagi; kuli Suni, omulala gw'Abashuni; <verse eid="NUM 26:15"/><verse number="16" style="v" sid="NUM 26:16"/>Kuli Ozni, omulala gwa Abanya-Ozni, kuli Eri, omulala gw’Abaeri; <verse eid="NUM 26:16"/><verse number="17" style="v" sid="NUM 26:17"/>Kuli Arodi, omulala gw’Abarodi; kuli Areli, omulala gw’Abareli. <verse eid="NUM 26:17"/><verse number="18" style="v" sid="NUM 26:18"/>Yo milala ya bene Gadi eyo. Abajirîrwe omubalè bali: bantu bihumbi makumi anni na magana arhanu. <verse eid="NUM 26:18"/><verse number="19" style="v" sid="NUM 26:19"/>Bene Yûda: Eri na Onani; Ci Eri na Onani bafirîre omu cihugo c’e Kanâni. <verse eid="NUM 26:19"/><verse number="20" style="v" sid="NUM 26:20"/>Alaga bene Yûda, kulya emilala yâbo enali: kuli Shela, omulala gw’Abashela; kuli Peresi, omulala gwa Abaperesi; kuli Zera, omulala gw’Abazera. <verse eid="NUM 26:20"/><verse number="21" style="v" sid="NUM 26:21"/>Bene Peresi bâli: Kuli Hesroni, omulala gw’Abahesroni; kuli Hamuli, omulala gw’Abahamuli. <verse eid="NUM 26:21"/><verse number="22" style="v" sid="NUM 26:22"/>Yo milala ya bene Yûda eyo nk’oku bajirirwe omubalè: bantu bihumbi makumi gali nda na ndarhu na magana arhanu. <verse eid="NUM 26:22"/><verse number="23" style="v" sid="NUM 26:23"/>Bene Isakari nk’oku emilala yâbo enali: kuli Tola, omulala gw’Abatolati; kuli Puva, omulala gw’Abapuva. <verse eid="NUM 26:23"/><verse number="24" style="v" sid="NUM 26:24"/>Kuli Yashubu, omulala gw’Abanyashubu; kuli Shimroni omulala gw’Abashimroni. <verse eid="NUM 26:24"/><verse number="25" style="v" sid="NUM 26:25"/>Yo milala ya bene Isakari, nk’oku banajirirwe omubalè: bihumbi magana gali ndarhu na bini na magana asharhu. <verse eid="NUM 26:25"/><verse number="26" style="v" sid="NUM 26:26"/>Bene Zabuloni, kulya emilala yâbo enali: kuli Sêredi, omulala gw’Abasêredi, kuli Eloni, omulala gw’Abaloni; kuli Yaleli, omulala gw’Abayaleli. <verse eid="NUM 26:26"/><verse number="27" style="v" sid="NUM 26:27"/>Eyo yo milala erhenga kuli Zabuloni, nka kulya banajirirwe omubalè: bantu bihumbi magana gali ndarhu na magana arhanu. <verse eid="NUM 26:27"/><verse number="28" style="v" sid="NUM 26:28"/>Bene Yozefu, kulya emilala yâbo enali: Menashè na Efrayim <verse eid="NUM 26:28"/><verse number="29" style="v" sid="NUM 26:29"/>Bene Menashè: Kuli Makiri, omulala gw’Abamakiri. Makiri aburha Galadi; kuli Galadi, omulala gw’Abagaladi. <verse eid="NUM 26:29"/><verse number="30" style="v" sid="NUM 26:30"/>Alaga bene Galadi: Yezeri kwo kurhenga omulala gw’Abayezeri, kuli Heleki, omulala gw’Abaheleki; <verse eid="NUM 26:30"/><verse number="31" style="v" sid="NUM 26:31"/>Asrieli, ye warhengagakwo omulala gw’Abasrieli, Shekemi, ye warhengagakwo omulala gw’Abashikemi; <verse eid="NUM 26:31"/><verse number="32" style="v" sid="NUM 26:32"/>Shemida, ye warhengagakwo omulala gw’Abashemida; Heferi, ye orhengagakwo omulala gw’Abaheferi. <verse eid="NUM 26:32"/><verse number="33" style="v" sid="NUM 26:33"/>Selofehadi, mwene Heferi, arhaburhaga barhabana, ci banyere bône. Alaga amazîno ga bâli ba Selofehadi: Mahla, Noa, Hogla, Milka na Tirsa. <verse eid="NUM 26:33"/><verse number="34" style="v" sid="NUM 26:34"/>Yo milala ya Menashè eyo; abajirîrwe omubalè bali bihumbi magana arhanu na bibirhi na magana gali nda. <verse eid="NUM 26:34"/><verse number="35" style="v" sid="NUM 26:35"/>Alaga bene Efrayimu nk’oku emilala yâbo enali: kuli Shutela, omulala gwa Abashutela; kuli Bekeri, omulala gw’Ababekeri: kuli Tahani, omulala gw’Abatahani. <verse eid="NUM 26:35"/><verse number="36" style="v" sid="NUM 26:36"/>Alaga bene Shutela: kuli Erani, omulala gw’Abaherani; <verse eid="NUM 26:36"/><verse number="37" style="v" sid="NUM 26:37"/>Yo milala ya bene Efrayimu eyo, nk’oku banajirirwe omubalè: bâli bihumbi makumi asharhu na bibirhi na magana arhanu. Abo bo bene Yozefu, nk’oku emilala yâbo enali. <verse eid="NUM 26:37"/><verse number="38" style="v" sid="NUM 26:38"/>Bene Benyamini, nk’oku emilala yâbo enali: kuli Bela, omulala gw’Ababela; kuli Ashbeli, omulala gw’Abashibeli; kuli Ahirami, omulala gw’Abahirami: <verse eid="NUM 26:38"/><verse number="39" style="v" sid="NUM 26:39"/>Kuli Shufami, omulala gw’Abashufami; kuli Hufami, omulala gw’Abahufami. <verse eid="NUM 26:39"/><verse number="40" style="v" sid="NUM 26:40"/>Alaga bagala ba Bela: Aredi na Naamani. Kuli Aredi, omulala gw’Abaaredi; kuli Naamani, omulala gw’Abanaamani. <verse eid="NUM 26:40"/><verse number="41" style="v" sid="NUM 26:41"/>Abo bo bene Benyamini nk’oku emilala yâbo enali, n’abajirîrwe omubalè muli bo bali bihumbi makumi anni na birhanu na magana galindarhu. <verse eid="NUM 26:41"/><verse number="42" style="v" sid="NUM 26:42"/>Alaga bene Dani, nk’oku emilala yâbo enali: kuli Shuhami kwarhenga omulala gw’Abasuhami. Eyo yo milala ya Dani, oku emilala yâbo enagenzire. <verse eid="NUM 26:42"/><verse number="43" style="v" sid="NUM 26:43"/>Emilala y’Abashuhami yoshi nk’oku abajirîrwe omubalè banali: bihumbi makumi gali ndarhu na bini na magana anni. <verse eid="NUM 26:43"/><verse number="44" style="v" sid="NUM 26:44"/>Bene Aseri nk’oku emilala yâbo enali: kuli Yimna, omulala gw’Abayimna; kuli Yishwi, omulala gw’Abayishwi; kuli Beria, omulala gw’Ababeria. <verse eid="NUM 26:44"/><verse number="45" style="v" sid="NUM 26:45"/>Kuli bene Beria: kuli Heberi, omulala gw’Abaheberi; kuli Malkieli, omulala gw’Abamalkieli. <verse eid="NUM 26:45"/><verse number="46" style="v" sid="NUM 26:46"/>Izîno lya mwâli wa Aseri ye wali Serah. <verse eid="NUM 26:46"/><verse number="47" style="v" sid="NUM 26:47"/>Yo milala ya bene Aseri eyo. Abajirîrwe omubalè bali: bihumbi makumi arhanu na bisharhu na magana anni. <verse eid="NUM 26:47"/><verse number="48" style="v" sid="NUM 26:48"/>Bene Nefutali, nk’oku emilala yâbo enali: kuli Yasieli, omulala gw’Abayezieli; kuli Guni, omulala gw’Abaguni; <verse eid="NUM 26:48"/><verse number="49" style="v" sid="NUM 26:49"/>Kuli Yeseri, omulala gw’Abayeseri; kuli Shilemi, omulala gw’Abashilemi. <verse eid="NUM 26:49"/><verse number="50" style="v" sid="NUM 26:50"/>Eyo yo milala ya Nefutali, nk’oku emilala yâbo enali, abajirîrwe omubalè muli bo bali bihumbi makumi anni na birhanu na magana anni. <verse eid="NUM 26:50"/><verse number="51" style="v" sid="NUM 26:51"/>Abo bo bene Israheli bajirirwe omubalè: boshi bahika oku bantu bihumbi magana gali ndarhu na magana gali nda na makumi asharhu. <verse eid="NUM 26:51"/><verse number="52" style="v" sid="NUM 26:52"/>Nyamubâho anacishambâla na Mûsa amubwîra, erhi: <verse eid="NUM 26:52"/><verse number="53" style="v" sid="NUM 26:53"/>Abà bo ecihugo câgabirwa, cibè kashambala kâbo, nk’oku amazîno gâbo ganali. <verse eid="NUM 26:53"/><verse number="54" style="v" sid="NUM 26:54"/>Abali banji, bo wanaha akashambala kanji, n’abali banyi, wanabaha akashambala kasungunu; bakaziha ngasi muguma akashambala kâge, kulya omubalè gwâbo gunali. <verse eid="NUM 26:54"/><verse number="55" style="v" sid="NUM 26:55"/>Ci kwône okwo kugabâna ecihugo kuyesherwe ecigole. Bacigabâna nk’oku emilala ya bashakulûza bâbo enali. <verse eid="NUM 26:55"/><verse number="56" style="v" sid="NUM 26:56"/>Ako kashambala kagabwa omu kuyesha ecigole oku bali banji nk’oku abâli basungunu.<verse eid="NUM 26:56"/></para>
  <para style="s1">Bene Levi bo babâmwo Abashi bene Mushi gwa Merari</para>
  <para style="p">
    <verse number="57" style="v" sid="NUM 26:57"/>Alaga nk’oku emilala ekulikirîne, bene Levi bajirirwe omubalè: Kuli Gershoni, omulala gwa Abagershoni, kuli Kehati, omulala gw’Abakehati; kuli Merari, omulala gw’Abamerari. <verse eid="NUM 26:57"/><verse number="58" style="v" sid="NUM 26:58"/>Alaga emilala ya bene Levi: omulala gw’Abalobuni, omulala gw’Abahebroni, omulala gwa bene Mahali, omulala gwa Bene Mushi (Abashi) n’omulala gw’Abanyakorè. Kehati aburha Amrami. <verse eid="NUM 26:58"/><verse number="59" style="v" sid="NUM 26:59"/>Izîno ly’omugoli wa Amrami ye wali Yokebedi, mwâli wa Levi, oyu nina aburhiraga Levi erhi baciri e Mîsiri; aburhira Amrami: Aroni, Mûsa na Miriyamu, mwâli wâbo. <verse eid="NUM 26:59"/><verse number="60" style="v" sid="NUM 26:60"/>Aroni aburha Nadabu na Abiu, Eleazari na Itamara. <verse eid="NUM 26:60"/><verse number="61" style="v" sid="NUM 26:61"/>Nadabu na Abiu bo balya bafàga amango bajagidudumulira Nyamubâho omuliro gurhali gwo. <verse eid="NUM 26:61"/><verse number="62" style="v" sid="NUM 26:62"/>Abajirîrwe omubalè boshi, kurhenga balume ba mwêzi muguma kujà enyanya, bali bihumbi makumi abirhi na bisharhu. Bulya barhajiriragwa omubalè haguma n’abandi bene Israheli, barhagwêrhi kashambala kaguma nabo. <verse eid="NUM 26:62"/><verse number="63" style="v" sid="NUM 26:63"/>Abo bo bantu baganjirwe na Mûsa n’omudâhwa Eleazari, bo bajiraga omubalè gwa bene Israheli omu rhubanda rhwa Mowabu, hôfi na Yordani aha ishiriza lya Yeriko. <verse eid="NUM 26:63"/><verse number="64" style="v" sid="NUM 26:64"/>Muli bo murhaciri ciru n’omuguma mwa balya bene Israheli Mûsa na Aroni bajiriraga omubalè omu ntondo ya Sînayi. <verse eid="NUM 26:64"/><verse number="65" style="v" sid="NUM 26:65"/>Bulya Nyamubâho àli erhi adesire kuli bo, erhi: «Bafîra omw’irungu; harhasigalaga ciru n’omuguma aha nyuma lya Kalebu mwene Yefunè na Yozwè mwene Nuni».<verse eid="NUM 26:65"/></para>
  <chapter eid="NUM 26"/>
  <chapter number="27" style="c" sid="NUM 27"/>
  <para style="s1">Olwa nyakufà buzira mwâna wayîma</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 27:1"/>Oku bundi bâli ba Selofehadi banaciyegera. Selofehadi àli mwene Heferi, ya Galadi, ga Makiri, ga Menashè; w’omu bûko bwa bene Menashè ga Yozefu. Amazîno gâbo banyere: Mahla, Noa, Hogla, Milka na Tirsa. <verse eid="NUM 27:1"/><verse number="2" style="v" sid="NUM 27:2"/>Banacijà emunda Mûsa ali, embere z’omudâhwa Eleazari, embere z’abarhambo b’olubaga loshi aha ihêma ly’embugânano; banaciderha, mpu: <verse eid="NUM 27:2"/><verse number="3" style="v" sid="NUM 27:3"/>«Larha àfirire omw’irungu; arhâli wa muli balya bacihinduliraga Nyamubâho, b’omu murhwe gwa Korè; ci muntu wafàga n’ecâge câha, arhanasigaga mwânarhabana. <verse eid="NUM 27:3"/><verse number="4" style="v" sid="NUM 27:4"/>“Cici cankarhumaga izîno lya larha lihirigirha omu mulala gwâge? Obu arhasigaga mwânarhabana nîrhu murhuhè ecirhu cigabi omu karhî ka bene wâbo larha.”» <verse eid="NUM 27:4"/><verse number="5" style="v" sid="NUM 27:5"/>Mûsa anacihêka olwo lubanja lwâbo embere za Nyamubâho. <verse eid="NUM 27:5"/><verse number="6" style="v" sid="NUM 27:6"/>Nyamubâho anacibwîra Mûsa, erhi: <verse eid="NUM 27:6"/><verse number="7" style="v" sid="NUM 27:7"/>«Abo bâli ha Selofehadi bàdesire akantu kashingânîne. Obahè nabo, oku kashambala kâbo, cigabi ciguma ekarhî ka bene wâbo îshe; obahè n’akashambala k’îshe wâbo. <verse eid="NUM 27:7"/><verse number="8" style="v" sid="NUM 27:8"/>“Ogendishambâla na bene Israheli, obabwîre ntya”: <verse eid="NUM 27:8"/><verse number="9" style="v" sid="NUM 27:9"/>“Omulume erhi ankafà arhasiziri mugala, akashambala kâge wanakaha omwâli, na erhi akabà arhagwêrhi munyere, akashambala kâge wanakaha bene wâbo”. <verse eid="NUM 27:9"/><verse number="10" style="v" sid="NUM 27:10"/>“Erhi akabà arhagwêrhi bene wâbo; kalya kashambala kâge wanakahà bene wâbo îshe”. <verse eid="NUM 27:10"/><verse number="11" style="v" sid="NUM 27:11"/>“Na erhi akabà bene wâbo îshe barhahabà, kalya kashambala wanakahà mwene wâbo muguma oyegerîne naye omu mulala gwâge, oyo ye wakayôrhana. Kuli bene Israheli okwo kwabà ngeso ya bushinganyanya, nk’oku Nyamubâho anarhegekaga Mûsa”».<verse eid="NUM 27:11"/></para>
  <para style="s1">Yozwè, mukûla wa Mûsa</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 27:12"/>Nyamubâho abwîra Mûsa, erhi: «Osôkere kuli eyi ntondo y’Abarim onalâbe ecihugo nahà bene Israheli. <verse eid="NUM 27:12"/><verse number="13" style="v" sid="NUM 27:13"/>“Wacibona, obuligendiluhûkira emunda bene winyu bajire, nka kulya mwene winyu Aroni àjagayo”. <verse eid="NUM 27:13"/><verse number="14" style="v" sid="NUM 27:14"/>“Bulya, muli galya mango g’ishababè ly’olubaga omw’irungu lya Sini, mwembi murhashimbaga irhegeko nali mbahire ly’okumpeka irenge emunda bali, oku lwa galya mîshi”». (Go mîshi g’aha Meriba, e Kadesi, omw’irungu lya Sini.)<verse eid="NUM 27:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 27:15"/>Mûsa ashambâla na Nyamubâho amubwîra erhi: <verse eid="NUM 27:15"/><verse number="16" style="v" sid="NUM 27:16"/>«Nyamubâho, Nyamuzinda wa ngasi myûka ya bantu, ahirage kuli olûla lubaga omuntu <verse eid="NUM 27:16"/><verse number="17" style="v" sid="NUM 27:17"/>“wakazigenda anagaluke nalo, omuntu wakaziluhulukana analugalule, na ntyo olubaga lwa Nyamubâho lurhaciyôrhe nka bibuzi birhagwêrhi mungere.”»<verse eid="NUM 27:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 27:18"/>Nyamubâho abwîra Mûsa, erhi: «Rhôla Yozwè, mwene Nuni, ali muntu oyunjwîre Mûka. Ogendihira okuboko kwâwe kuli ye<note caller="+" style="f"><char style="fr" closed="false">27, 18 </char><char style="ft" closed="false">Kuhira okuboko kwâge kuli ye: kwo kuderha oku amuyîmike, amuhè obuhashe, amuyandagalizamwo olya Mûka ojira Mûsa ntwâli (<char style="xt"><ref loc="DEU 34:9">Lush 34, 9</ref>; <ref loc="NUM 8:10">Mib 8, 10</ref></char>).</char></note>. <verse eid="NUM 27:18"/><verse number="19" style="v" sid="NUM 27:19"/>Omuhêke embere z’omudâhwa Eleazari n’embere z’olubaga loshi, kandi wanamuyîmika erhi na boshi badwîrhe babona. <verse eid="NUM 27:19"/><verse number="20" style="v" sid="NUM 27:20"/>Omuhirekwo ecigabi c’obuhashe bwâwe, lyo olubaga lwa bene Israheli loshi lukazimuyumva. <verse eid="NUM 27:20"/><verse number="21" style="v" sid="NUM 27:21"/>Anajà embere z’omudâhwa Eleazari, naye anagendidosa ihano ebwa Urimi embere za Nyamubâho. Oku buhashe bwâge, oyu Yozwè, kwo bakazigendera, n’oku buhashe bwâge bakazifulukira bene Israheli boshi, kandi kuguma naye olubaga lwoshi.» <verse eid="NUM 27:21"/><verse number="22" style="v" sid="NUM 27:22"/>Mûsa anacijira nk’okwo Nyamubâho anamurhegekaga. Arhôla Yozwè, amuhêka embere z’omudâhwa Eleazari n’embere z’olubaga loshi. <verse eid="NUM 27:22"/><verse number="23" style="v" sid="NUM 27:23"/>Mûsa, erhi ayûsimulambûlirakwo amaboko, amuyîmika nk’oku Nyamubâho anarhe­gekaga.<verse eid="NUM 27:23"/></para>
  <chapter eid="NUM 27"/>
  <chapter number="28" style="c" sid="NUM 28"/>
  <para style="s1">Amarhegeko gayêrekîre enterekêro</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 28:1"/>Nyamubâho anacishambâza Mûsa amubwîra, erhi: <verse eid="NUM 28:1"/><verse number="2" style="v" sid="NUM 28:2"/>Ohè bene Israheli eri irhegeko, obabwîre, erhi: Mukazikombêra okumpà, omu mango gakwânîne enterekêro yâni n’ebiryo byâni, zo nterekêro zijizirwe n’omuliro, ziri za kisununu kinjà embere zâni. <verse eid="NUM 28:2"/><verse number="3" style="v" sid="NUM 28:3"/>Ojibabwîra, erhi: Alagi enterekêro mwakazihà Nyamubâho:</para>
  <para style="iex" vid="NUM 28:3">A. Enterekêro ya ngasi lusiku</para>
  <para style="p" vid="NUM 28:3">Ngasi lusiku: bâna-buzi babirhi ba mwâka muguma; babè barhagwêrhi ishembo, bakazihânwa ngasi mango. <verse eid="NUM 28:3"/><verse number="4" style="v" sid="NUM 28:4"/>Wanarherekêra mwâna-buzi muguma sêzi, n’owa kabirhi bijingo izûba lihorha. <verse eid="NUM 28:4"/><verse number="5" style="v" sid="NUM 28:5"/>N’ecihimbi ciguma ca kali ikumi c’efa y’enshâno y’omulà mvange n’amavurha g’ecigabi ca kani c’ehîni y’amavurha g’omuzêti magishe. <verse eid="NUM 28:5"/><verse number="6" style="v" sid="NUM 28:6"/>Eyo yo nterekêro y’ensiku n’amango, eyahûnagwa oku ntondo ya Sînayi, ya kisununu kinjà, nterekêro ejizirwe n’omuliro embere za Nyamubâho. <verse eid="NUM 28:6"/><verse number="7" style="v" sid="NUM 28:7"/>Enterekêro y’embulagwa yabà ya mulengo gwa cigabi ca kani c’ehîni n’amavurha g’omuzêti magishe oku ngasi mwâna-buzi; omu hantu hatagatîfu mwo wakazihânira eyo enterekêro y’embulagwa y’idivayi embere za Nyamubâho. <verse eid="NUM 28:7"/><verse number="8" style="v" sid="NUM 28:8"/>Wanarherekêra omwâna-buzi wa kabirhi bijingo izûba lihorha; wanajira nk’oku wajiraga oku nterekêro y’esêzi, eri nterekêro ya kisununu kinjà embere za Nyamubâho.<verse eid="NUM 28:8"/></para>
  <para style="iex">B. Enterekêro y’olwa Sabato</para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 28:9"/>Oku lwa Sabato, mwanarherekêra bâna-buzi babirhi ba mwâka muguma, barhabâgakwo ishembo lici; mwanahâna bigabi bibirhi bya enshâno y’omulà, mvange n’amavurha, kuguma n’embulagwa y’okunywa. <verse eid="NUM 28:9"/><verse number="10" style="v" sid="NUM 28:10"/>Enterekêro y’olwa ngasi Sabato, yakazihirwa oku nterekêro ya ngasi mango n’embulagwa y’okunywa.<verse eid="NUM 28:10"/></para>
  <para style="iex">C. Enterekêro z’omwêzi gwabaluka</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 28:11"/>Oku nsiku ntangiriza n’emyêzi yinyu, mwanakazihâna nka nterekêro ya nsirîra mwahà Nyamubâho, mpanzi ibirhi ntôrhò, ngandabuzi nguma na bâna-buzi babirhi ba mwâka muguma barhagwêrhi ishembo; <verse eid="NUM 28:11"/><verse number="12" style="v" sid="NUM 28:12"/>n’enterekêro y’enkalangè yajà oku ngasi mpanzi, ebè ya bigabi bisharhu bya kali ikumi by’enshâno y’omulà mvange n’amavurha. Enterekêro y’enkalangè yajà oku ngandabuzi, ebè ya bigabi bibirhi bya kali ikumi by’enshâno y’omulà mvange n’amavurha. <verse eid="NUM 28:12"/><verse number="13" style="v" sid="NUM 28:13"/>Enterekêro y’enkalangè yajà oku ngasi mwâna-buzi, ebè ya cigabi ciguma ca kali ikumi c’enshâno y’omulà mvange n’amavurha. Eri nterekêro ya nsirîra ya kisununu kinjà, nterekêro yajirwa n’omuliro embere za Nyamubâho. <verse eid="NUM 28:13"/><verse number="14" style="v" sid="NUM 28:14"/>Enterekêro z’embulagwa zajà kuli ezo nterekêro, cibè cigabi ca kabirhi c’ehîni y’idivayi oku ngasi mpanzi, cigabi ciguma ca kasharhu c’ehîni oku ngandabuzi na cigabi ciguma ca kani c’ehîni oku mwâna-buzi. Yo nterekêro y’ensirîra yakâjirwa eyo ngasi kuhalûka kw’omwêzi, oku ngasi mwêzi, oku myêzi ya ngasi mwâka. <verse eid="NUM 28:14"/><verse number="15" style="v" sid="NUM 28:15"/>Banarherekêra na Nyamubâho ecihebe nka nterekêro oku byâha, erhi hanaciri enterekêro y’ensirîra ya ngasi mango n’embulagwa y’okunywa.<verse eid="NUM 28:15"/></para>
  <para style="iex">D. Enterekêro z’Olusiku lukulu lwa Basâka</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 28:16"/>Oku mwêzi gwa burhanzi, omu nsiku ikumi n’ini z’omwêzi, lwâbà lusiku lukulu lwa Basâka wa Nyamubâho; <verse eid="NUM 28:16"/><verse number="17" style="v" sid="NUM 28:17"/>n’olusiku lwa kali ikumi na karhanu lw’ogwo mwêzi, lwâbà nalo lukulu. Bâgeza nsiku nda erhi balya emigati erhalimwo lwango. <verse eid="NUM 28:17"/><verse number="18" style="v" sid="NUM 28:18"/>Omu lusiku lurhanzi, hanabà embugânano nyimâna: Murhahîra mukajira emikolo midârhi. <verse eid="NUM 28:18"/><verse number="19" style="v" sid="NUM 28:19"/>Mwanahâna enterekêro yajirwa n’omuliro, nterekêro ya nsirîra ya Nyamubâho: mpanzi ibirhi ntôrhò, ngandabuzi nguma na bâna-buzi nda ba mwâka muguma barhanagwêrhi ishembo lici. <verse eid="NUM 28:19"/><verse number="20" style="v" sid="NUM 28:20"/>N’oku nterekêro y’enkalangè yâbo, banajira enshâno y’omulà mvange n’amavurha: bigabi bisharhu bya kali ikumi oku mpanzi nguma, bigabi bibirhi bya kali ikumi, <verse eid="NUM 28:20"/><verse number="21" style="v" sid="NUM 28:21"/>oku ngandabuzi nguma na cihimbi ca kali ikumi oku ngasi mwâna-buzi wa mwa balya bâna-buzi nda. <verse eid="NUM 28:21"/><verse number="22" style="v" sid="NUM 28:22"/>Mwanarherekêra n’ecihebe nka nterekêro oku byâha, lyo muhashijira empyûlo kuli mwe. <verse eid="NUM 28:22"/><verse number="23" style="v" sid="NUM 28:23"/>Mwajira ntyo buzira kuleka erya nterekêro y’ensirîra y’esêzi, bulya eri nterekêro y’ensiku zoshi. <verse eid="NUM 28:23"/><verse number="24" style="v" sid="NUM 28:24"/>Mwâkazijira ntyo ngasi lusiku kuhika oku nsiku nda; byâbà biryo by’enterekêro ejizirwe n’omuliro, nterekêro ya kisununu kinjà embere za Nyamubâho. Eyo nterekêro kwo yakazijirwa ntyo, buzira kuleka erya y’ensiku zoshi, n’enterekêro y’embulagwa yakuja. <verse eid="NUM 28:24"/><verse number="25" style="v" sid="NUM 28:25"/>Oku lusiku lwa kali nda, mwanabà n’embugânano nyimâna: murhahîra mukajira omukolo mudârhi.<verse eid="NUM 28:25"/></para>
  <para style="iex">E Enterekêro z’ensiku nkulu z’emigobe</para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 28:26"/>Oku lusiku lw’emburho mpyâhya, eyêzire burhangiriza, amango mukola mwarherekêra Nyamubâho enkalangè y’ebisârûlwa binyu birhangiriza oku lusiku lukulu lwinyu lw’emigobe, mwanabà n’embugânano nyimâna: murhahîra mukajira omukolo mudârhi. <verse eid="NUM 28:26"/><verse number="27" style="v" sid="NUM 28:27"/>Mwanarherekêra, nka nterekêro ya nsirîra ya kisununu kinjà embere za Nyamubâho, mpanzi ibirhi ntôrhò, engandabuzi na bâna-buzi nda ba mwâka muguma; <verse eid="NUM 28:27"/><verse number="28" style="v" sid="NUM 28:28"/>n’oku nterekêro y’enkalangè, enshâno y’omulà mvange n’amavurha: bigabi bisharhu bya kali ikumi oku ngasi mpanzi, bigabi bibirhi bya kali ikumi oku ngandabuzi, <verse eid="NUM 28:28"/><verse number="29" style="v" sid="NUM 28:29"/>n’ecigabi ca kali ikumi oku ngasi mwâna-buzi wa muli balya bâna-buzi nda. <verse eid="NUM 28:29"/><verse number="30" style="v" sid="NUM 28:30"/>Mwanarherekêra n’ecihebe oku nterekêro n’okuhyûla kuli mwe. <verse eid="NUM 28:30"/><verse number="31" style="v" sid="NUM 28:31"/>Mujire ntyo buzira kuleka erya nterekêro y’ensirîra ya ngasi mango, kuguma n’enkalangè yayo. Ezo nyama, zirhabâgakwo ishembo; kandi mwanakazihirakwo enterekêro z’embulagwa.<verse eid="NUM 28:31"/></para>
  <chapter eid="NUM 28"/>
  <chapter number="29" style="c" sid="NUM 29"/>
  <para style="iex">F. Enterekêro oku lusiku lw’emishekera</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 29:1"/>Omu mwêzi gwa kali nda, oku lusiku lurhanzi lw’omwêzi, mwanabà n’embugânano nyimâna; murhahîra mukajira emikolo midârhi. Lwâbà kuli mwe lusiku lukulu lw’okubûha emishekera<note caller="+" style="f"><char style="fr" closed="false">29, 1 </char><char style="ft" closed="false">Okubûha emishekera: Burhanzirhanzi, bakâgibûha emishekera amango g’ebîrha (<char style="xt"><ref loc="JOS 6:5">Yoz 6, 5</ref>; <ref loc="ZEP 1:16">Sof 1, 16</ref>; <ref loc="AMO 1:14">Amo 1, 14</ref></char>), bakâgibûha omushekera nka bayîmika mwâmi (<char style="xt"><ref loc="NUM 23:21">Mib 23, 21</ref></char>). Erhi amâmi g’Israheli gahwa, Nyakasane ye bakola babûhira emishekera nka Mwâmi w’olubaga lwâge</char></note>. <verse eid="NUM 29:1"/><verse number="2" style="v" sid="NUM 29:2"/>Mwarherekêra, nka nterekêro ya nsirîra, ya kisununu kinjà embere za Nyamubâho, mpanzi nguma ntôrhò, ngandabuzi nguma na bâna-buzi nda ba mwâka muguma barhanalikwo ishembo. <verse eid="NUM 29:2"/><verse number="3" style="v" sid="NUM 29:3"/>N’enterekêro y’enkalangè yajakwo, yabà ya nshâno ya mulà mvange n’amavurha: bigabi bisharhu bya kali ikumi oku mpanzi, bigabi bibirhi bya kali ikumi oku ngandabuzi, <verse eid="NUM 29:3"/><verse number="4" style="v" sid="NUM 29:4"/>na cigabi ciguma ca kali ikumi oku mwâna-buzi wa muli balya bâna-buzi nda <verse eid="NUM 29:4"/><verse number="5" style="v" sid="NUM 29:5"/>Mwanayûshûlakwo n’ecihebe c’enterekêro oku byâha, ebè ya kujira empyûlo kuli mwe. <verse eid="NUM 29:5"/><verse number="6" style="v" sid="NUM 29:6"/>Mwajira ntyo buzira kuyibagira enterekêro y’ensirîra ya ngasi mwêzi, kuguma n’enkalangè yakuja; na buzira kuleka enterekêro y’ensirîra ya ngasi mango n’enterekêro y’enkalangè yakuja, kuguma n’enterekêro z’embulagwa zigwâsirwe okuyushûkakwo nka kulya binarhegesirwe. Ziri nterekêro zakazisingônolwa n’omuliro za kisununu kinjà embere za Nyamubâho.<verse eid="NUM 29:6"/></para>
  <para style="iex">G. Enterekêro oku lusiku lukulu lw’okuhyûla</para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 29:7"/>Omu nsiku ikumi za ogwo mwêzi gwa kali nda, mwanabà n’embugânano nyimâna na kandi lwâbà lusiku lwa kucîbabaza<note caller="+" style="f"><char style="fr" closed="false">29, 7 </char><char style="ft" closed="false">Luli lusiku lukulu lwa kuhyûla (mulongo gwa 11): <char style="xt"><ref loc="LEV 16:29-31">Lev 16, 29-31</ref>; <ref loc="LEV 23:27-32">23, 27-32</ref></char>.</char></note>: murhahîra mukajira omukolo mudârhi. <verse eid="NUM 29:7"/><verse number="8" style="v" sid="NUM 29:8"/>Mwarherekêra enterekêro y’akisûnunu kinjà embere za Nyamubâho: mpanzi nguma, ngandabuzi nguma na bâna-buzi nda ba mwâka muguma barhagwêrhi ishembo. <verse eid="NUM 29:8"/><verse number="9" style="v" sid="NUM 29:9"/>Enterekêro y’enkalangè yajakwo, ebè ya nshâno ya mulà mvange n’amavurha: bigabi bisharhu bya kali ikumi oku mpanzi, bibirhi bya kali ikumi oku ngandabuzi. <verse eid="NUM 29:9"/><verse number="10" style="v" sid="NUM 29:10"/>Ciguma ca kali ikumi oku ngasi muguma mwa balya bâna-buzi nda. <verse eid="NUM 29:10"/><verse number="11" style="v" sid="NUM 29:11"/>Mwanayûshûlakwo n’ecihebe c’enterekêro y’e­nsirîra y’empyûlo ya ngasi mango, n’enterekêro y’enkalangè yakuja, n’enterekêro z’embulagwa zigwâsirwe okuyushûkakwo.<verse eid="NUM 29:11"/></para>
  <para style="iex">H. Enterekêro oku lusiku lw’Amahêma</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 29:12"/>Omu nsiku ikumi n’irhanu z’omwêzi gwa kali nda, mwanabà n’embugânano nyimâna: Murhahîra mukajira omukolo mudârhi. Olukulu lw’okukuza Nyamubâho lwajirwa nsiku nda. <verse eid="NUM 29:12"/><verse number="13" style="v" sid="NUM 29:13"/>Olwo lusiku mwanakazihâna enterekêro y’ensirîra, nterekêro yajirwa n’omuliro, ya kisununu kinjà embere za Nyamubâho: mpanzi ntôrhò ikumi n’isharhu, ngandabuzi ibirhi na bâna-buzi ikumi na bâni ba mwâka muguma barhanagwêrhi ishembo. <verse eid="NUM 29:13"/><verse number="14" style="v" sid="NUM 29:14"/>N’enterekêro y’enkalangè zayushûkakwo, zajirwa n’enshâno y’omulà mvange n’amavurha: bigabi bisharhu bya kali ikumi kuli ngasi mpanzi ya mwa zirya ikumi n’isharhu, bigabi bya kali ikumi kuli ngasi ngandabuzi nguma ya mwa zirya ibirhi <verse eid="NUM 29:14"/><verse number="15" style="v" sid="NUM 29:15"/>na cigabi ciguma ca kali ikumi oku ngasi mwâna-buzi muguma wa mwa balya ikumi na bâni. <verse eid="NUM 29:15"/><verse number="16" style="v" sid="NUM 29:16"/>Mwanayûshûlakwo n’ecihebe c’enterekêro oku byâha; buzira kuleka enterekêro y’ensirîra ya ngasi mango n’enterekêro y’enkalangè yakuja kuguma n’enterekêro z’embulagwa zakuja.<verse eid="NUM 29:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 29:17"/>Oku lusiku lwa kabirhi, mwanarherekêra mpanzi ntôrhò ikumi n’ibirhi, ngandabuzi ibirhi, na bâna-buzi ikumi na bâni ba mwâka muguma barhagwêrhi ishembo. <verse eid="NUM 29:17"/><verse number="18" style="v" sid="NUM 29:18"/>Enterekêro y’enkalangè n’ezindi nterekêro z’embulagwa zayushûka kuli zirya mpanzi, kuli zirya ngandabuzi na kuli balya bâna-buzi, nk’oku omubalè gwâbo gunali na nk’oku binarhegesirwe. <verse eid="NUM 29:18"/><verse number="19" style="v" sid="NUM 29:19"/>Mwanayûshûlakwo ecihebe c’enterekêro oku byâha, buzira kuleka enterekêro y’ensirîra ya ngasi mango, n’enterekêro y’enkalangè yakuja, kuguma n’enterekêro z’embulagwa zakuja.<verse eid="NUM 29:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 29:20"/>Oku lusiku lwa kasharhu, mwarherekêra mpanzi ntôrhò ikumi na nguma, ngandabuzi ibirhi, na bâna-buzi ikumi na bâni ba mwâka muguma, barhagwêrhi ishembo. <verse eid="NUM 29:20"/><verse number="21" style="v" sid="NUM 29:21"/>Kuguma n’enterekêro y’enkalangè yajakwo, n’ezindi nterekêro z’embulagwa oku mpanzi, oku ngandabuzi n’oku bâna-buzi nk’oku omubalè gwâbo gunali na nk’oku irhegeko linadesire. <verse eid="NUM 29:21"/><verse number="22" style="v" sid="NUM 29:22"/>Mwanayûshûlakwo n’ecihebe c’enterekêro oku byâha, buzira kuleka enterekêro y’ensirîra ya ngasi mango, enkalangè ekuja na ey’embulagwa nayo ekuja.<verse eid="NUM 29:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 29:23"/>Oku lusiku lwa kani, mwanarherekêra mpanzi ntôrhò ikumi, bihebe bibirhi na bâna-buzi ikumi na bâni ba mwâka muguma barhanagwêrhi ishembo, <verse eid="NUM 29:23"/><verse number="24" style="v" sid="NUM 29:24"/>kuguma n’enterekêro y’enkalangè yakuja, n’ezindi nterekêro z’embulagwa oku mpanzi, oku ngandabuzi n’oku bâna-buzi nk’oku omubalè gwâbo gunali na nk’oku irhegeko linadesire. <verse eid="NUM 29:24"/><verse number="25" style="v" sid="NUM 29:25"/>Mwanayûshûlakwo n’ecihebe c’enterekêro oku byâbà, buzira kuleka enterekêro y’ensirîra ya ngasi mango, ey’enkalangè ekuja na eya embulagwa nayo ekuja.<verse eid="NUM 29:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 29:26"/>Oku lusiku lwa karhanu, mwanarherekêra mpanzi ntôrhò mwenda, ngandabuzi ibirhi na bâna-buzi ikumi na bâni ba mwâka muguma barhanagwêrhi ishembo; <verse eid="NUM 29:26"/><verse number="27" style="v" sid="NUM 29:27"/>kuguma n’enterekêro y’enkalangè yakuja, n’ezindi nterekêro z’embulagwa, oku mpanzi, oku ngandabuzi n’oku bâna-buzi, nk’oku omubalè gwâbo gunali na nk’oku irhegeko linadesire. <verse eid="NUM 29:27"/><verse number="28" style="v" sid="NUM 29:28"/>Mwanayûshûlakwo n’ecihebe c’enterekêro oku byâha, buzira kuleka enterekêro y’ensirîra ya ngasi mango, ey’enkalangè ekuja n’ey’embulagwa nayo ekuja.<verse eid="NUM 29:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 29:29"/>Oku lusiku lwa kali ndarhu, mwanarherekêra mpanzi ntôrhò munâni, ngandabuzi ibirhi na bâna-buzi ikumi na bâni ba mwâka muguma barhanagwêrhi ishembo; <verse eid="NUM 29:29"/><verse number="30" style="v" sid="NUM 29:30"/>kuguma n’enterekêro y’enkalangè yakuja n’ezindi nterekêro z’embulagwa, oku mpanzi, oku ngandabuzi n’oku bâna-buzi, nk’oku omubalè gwâbo gunali na nk’oku irhegeko linadesire. <verse eid="NUM 29:30"/><verse number="31" style="v" sid="NUM 29:31"/>Mwanayûshûlakwo n’ecihebe c’enterekêro oku byâha, buzira kuleka enterekêro y’ensirîra ya ngasi mango, ey’enkalangè ekuja n’ey’embulagwa nayo ekuja.<verse eid="NUM 29:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 29:32"/>Oku lusiku lwa kali nda, mwanarherekêra mpanzi ntôrhò nda, ngandabuzi ibirhi na bâna-buzi ikumi na bâni ba mwâka muguma, barhagwêrhi ishembo, <verse eid="NUM 29:32"/><verse number="33" style="v" sid="NUM 29:33"/>kuguma n’enterekêro y’enkalangè yakuja, n’ezindi nterekêro z’embulagwa, oku mpanzi, oku ngandabuzi n’oku bâna-buzi, nk’oku omubalè gwâbo gunali na nk’oku irhegeko linadesire. <verse eid="NUM 29:33"/><verse number="34" style="v" sid="NUM 29:34"/>Mwanayûshûlakwo n’ecihebe c’enterekêro oku byâha, buzira kuleka enterekêro y’ensirîra ya ngasi mango, ey’enkalangè ekuja n’ey’embulagwa nayo ekuja.<verse eid="NUM 29:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 29:35"/>Oku lusiku lwa kali munâni, mwanabà n’embugânano nkulu: murhahîra mukajira omukolo mudârhi. <verse eid="NUM 29:35"/><verse number="36" style="v" sid="NUM 29:36"/>Mwanarherekêra enterekêro y’ensirîra, nterekêro yajirwa n’omuliro, ya kisununu kinjà embere za Nyamubâho: mwanarherekêra mpanzi nguma, ngandabuzi nguma na bâna-buzi nda ba mwâka muguma barhanagwêrhi ishembo; <verse eid="NUM 29:36"/><verse number="37" style="v" sid="NUM 29:37"/>kuguma n’enterekêro y’enkalangè yakuja n’ezindi nterekêro z’embulagwa, oku mpanzi, oku ngandabuzi n’oku bâna-buzi, nk’oku omubalè gwâbo gunali na nk’oku irhegeko linadesire. <verse eid="NUM 29:37"/><verse number="38" style="v" sid="NUM 29:38"/>Mwanayûshûlakwo n’ecihebe c’enterekêro oku byâha, buzira kuleka enterekêro y’ensirîra ya ngasi mango, ey’enkalangè ekuja n’ey’embulagwa nayo ekuja.<verse eid="NUM 29:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 29:39"/>Zo nterekêro mwakazirherekêra Nyamubâho ezo oku nsiku nkulu zinyu, buzira kuleka enterekêro z’okuyûkiriza emihigo yinyu n’enterekêro zinyu z’obulonza bwinjà: zo nterekêro z’ensirîra zinyu, enterekêro z’enkalangè zinyu, embulagwa zinyu n’enterekêro z’omurhûla.<verse eid="NUM 29:39"/></para>
  <chapter eid="NUM 29"/>
  <chapter number="30" style="c" sid="NUM 30"/>
  <para style="p">
    <verse number="1" style="v" sid="NUM 30:1"/>Mûsa anacibwîra bene Israheli nk’oku Nyamubâho anali amurhegesire koshi (cfr 29, 40).<verse eid="NUM 30:1"/></para>
  <para style="s1">Amarhegeko g’okuyûkiriza emihigo</para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 30:2"/>Mûsa ashambâla n’abarhambo b’emilala ya bene Israheli aderha, erhi: «Alagi oku Nyamubâho arhegesire: <verse eid="NUM 30:2"/><verse number="3" style="v" sid="NUM 30:3"/>“Erhi omulume ankarhôla omuhigo embere za Nyamubâho, nîsi erhi ankajira endahiro y’okuyûkiriza mulâli mulebe, oyo mulume arhacishubaga omu kanwa kâge; ngasi ebi adesire omu kanwa kâge byoshi, anabiyûkirizagye”. <verse eid="NUM 30:3"/><verse number="4" style="v" sid="NUM 30:4"/>“Erhi omukazi, amango aciri munyere omu nyumpa y’îshe, akabà ahânyire omuhigo embere za Nyamuzinda, na ntyo acîshwêke na mulâli mulebe”, <verse eid="NUM 30:4"/><verse number="5" style="v" sid="NUM 30:5"/>“erhi îshe ankamanya ogwôla muhigo gwâge n’eco ciragâne câge acîshwekagamwo yêne, erhi îshe ankahulika kwônene, arhamubwîre akantu, emihigo olya munyere ankarhôla, na ngasi milâli anajizire yoshi enali y’okuli”. <verse eid="NUM 30:5"/><verse number="6" style="v" sid="NUM 30:6"/>“Ci erhi îshe ankamanya okw’erya mihigo, akanalahira mpu okwo kurhabè, emihigo y’emilâli nyamunyere acîshwekagamwo erhacigwêrhi buhashe buci; na Nyamubâho anamubabalira, ebwa kubà anamulahirire”. <verse eid="NUM 30:6"/><verse number="7" style="v" sid="NUM 30:7"/>“Erhi ankabà aherusire, n’emihigo yâge ecimubako, nîsi erhi akabà acibà ashwesirwe n’emilâli yarhengaga omu kanwa kâge omu kuhalabuka”, <verse eid="NUM 30:7"/><verse number="8" style="v" sid="NUM 30:8"/>“ibà erhi ankamanya kulya akanahulika ago mango amamanya, olya mukazi anayôrha ashwesirwe n’erya mihigo yâge, kuguma n’erya milâli yâge acîshwekagamwo”. <verse eid="NUM 30:8"/><verse number="9" style="v" sid="NUM 30:9"/>“Ci erhi ibà, olusiku amanya kulya akalahirira nyamukazi, omuhigo olya mukazi ajizire, n’omulâli arhôlaga omu kuhalabuka birhacimushwêsiri, na Nyamubâho anamubabalira”».<verse eid="NUM 30:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 30:10"/>Omuhigo gw’omukazi, omukana, erhi ogw’omukazi wahulusîbwe n’ibà, ngasi muhigo na ngasi mulâli mukazi wa bêne oyo ankanajira gunali gw’okuli kuli ye. <verse eid="NUM 30:10"/><verse number="11" style="v" sid="NUM 30:11"/>Erhi akabà omu mw’ibà mw’omukazi arhôleraga omuhigo, erhi abè omwôla mwo ahâniraga ogwo muhigo gw’okucîshweka, <verse eid="NUM 30:11"/><verse number="12" style="v" sid="NUM 30:12"/>erhi îba ankamanya akanacîhulikira, arhamuhakanîre, emihigo yâge yoshi enali y’okunali, kuguma n’emilâli anacishwêkagamwo yoshi yêne. <verse eid="NUM 30:12"/><verse number="13" style="v" sid="NUM 30:13"/>Ci erhi îba ankamanya, n’erya mihigo ayilahîre, ebyarhenzire ekanwa kâge byoshi birhaciri by’okuli: ibà anabirhenzize, na Nyamubâho anamubabalira kuli byo. <verse eid="NUM 30:13"/><verse number="14" style="v" sid="NUM 30:14"/>Ngasi muhigo na ngasi ndahiro omukazi ankahigamwo okucîbabaza, ibà anahasha okuyêmêra erhi okuhakana eyo mihigo. <verse eid="NUM 30:14"/><verse number="15" style="v" sid="NUM 30:15"/>Erhi îba ankahulika kwônene mango malebe, erhi amâyêmêra erya mihigo ya mukâge, ekola y’okunali. Ekola y’okuli ebwa kubà îba anahulisire, arhamubwîzire cici n’obwo ali amanyire. <verse eid="NUM 30:15"/><verse number="16" style="v" sid="NUM 30:16"/>Erhi ankayirhenza buzinda, n’obwo ali amanyire agalinahulika, yêne anabarhule obubî bwanagwârhe mukâge.<verse eid="NUM 30:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 30:17"/>Ago go marhegeko Nyamubâho ahâga Mûsa oku biyêrekîre omukazi n’ibà, oku biyêrekîre îshe w’omunyere n’omunyere yêne, akabà aciri murhò, aciri omu nyumpa y’îshe.<verse eid="NUM 30:17"/></para>
  <chapter eid="NUM 30"/>
  <chapter number="31" style="c" sid="NUM 31"/>
  <para style="ms1">IX. Muhagulo n’okugabâna</para>
  <para style="s1">Amarhegeko gayêrekîre eminyago</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 31:1"/>Nyamubâho ashambâla na Mûsa amubwîra, erhi: <verse eid="NUM 31:1"/><verse number="2" style="v" sid="NUM 31:2"/>«Ogendicîhôlera bene Israheli kuli bene Madiani; n’enyuma z’aho wanahêkwa emunda olubaga lwâwe lwajire.» <verse eid="NUM 31:2"/><verse number="3" style="v" sid="NUM 31:3"/>Mûsa akanya agendishambâla n’olubaga, alubwîra, erhi: Mujire abalume ba muli mwe barhôle emirasano, bagende matabâro, bagendilwîsa Madiani, lyo bajira olwihôlo lwa Nyamubâho kuli Madiani. <verse eid="NUM 31:3"/><verse number="4" style="v" sid="NUM 31:4"/>Okwôla matabâro, murhumekwo balume cihumbi b’omu ngasi mulala ba muli erya milala ya bene-Israheli. <verse eid="NUM 31:4"/><verse number="5" style="v" sid="NUM 31:5"/>Omu bihumbi bya bene Israheli, bajà bacishogamwo balume cihumbi oku ngasi mulala, kwo kuderha oku baligi balume bihumbi ikumi na bibirhi bàjîre oku matabâro. <verse eid="NUM 31:5"/><verse number="6" style="v" sid="NUM 31:6"/>Mûsa abarhuma ebwa kulwa, balume cihumbi oku mulala, bagenda na Pinasi, mwene omudâhwa Eleazari, ye wali odwîrhe ebirugu bimâna n’erya mishekera y’okushekereza. <verse eid="NUM 31:6"/><verse number="7" style="v" sid="NUM 31:7"/>Barhabâlira Madiani nka kulya Nyamubâho anarhegekaga Mûsa, banaciyîrha abalume boshi. <verse eid="NUM 31:7"/><verse number="8" style="v" sid="NUM 31:8"/>Bayîrha n’abâmi b’e Madiani; bo: Evi, Rekemi, Suri, Huru na Reba, bâmi barhanu b’e Madiani. Balâmu mwene Beori naye bamufu­nda engôrho. <verse eid="NUM 31:8"/><verse number="9" style="v" sid="NUM 31:9"/>Bene Israheli bayisha badwîrhe mpira abakazi b’e Madiani n’abâna bâbo barhò; bahagula, banyaga na ngasi bishwêkwa byâbo bya okukazikola na ngasi gandi masô gâbo n’ebindi birugu byâbo byoshi. <verse eid="NUM 31:9"/><verse number="10" style="v" sid="NUM 31:10"/>Ngasi lugo bàbagamwo lwoshi baludûlika muliro na ngasi aha banahandaga hoshi. <verse eid="NUM 31:10"/><verse number="11" style="v" sid="NUM 31:11"/>Erhi babà bamashana eminyago yâbo na ngasi bindi banahagwire byoshi, abantu n’ebintu, <verse eid="NUM 31:11"/><verse number="12" style="v" sid="NUM 31:12"/>bahêka balya bagwârhagwa mpira n’erya minyago emunda Mûsa ali na Eleazari, ye mudâhwa, n’olubaga loshi lwa bene Israheli oku cihando, omu rhubanda rhwa bene Mowabu, hôfi na Yordani aha ishiriza lya Yeriko.<verse eid="NUM 31:12"/></para>
  <para style="s1">Okunigwa kw’abakazi n’okucêsa omunyago</para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 31:13"/>Mûsa, omudâhwa Eleazari, n’abarhambo boshi b’olubaga bayisha bali bayankirira emuhanda gw’ecihando. <verse eid="NUM 31:13"/><verse number="14" style="v" sid="NUM 31:14"/>Mûsa akunirira abarhambo b’eyo ngabo yali oku matabâro, bo balya barhambo b’ebihumbi n’ab’amagana, barhengaga ebwa matabâro. <verse eid="NUM 31:14"/><verse number="15" style="v" sid="NUM 31:15"/>Abadosa, erhi: «Carhumaga murhayîrha abakazi boki? <verse eid="NUM 31:15"/><verse number="16" style="v" sid="NUM 31:16"/>“Bo balya, oku kanwa ka Balâmu, bakululiraga bene Israheli ebwa kugomera Nyamubâho, mwa kulya kwabaga e Peori; na okwo kwarhuma obuhanya bujà omu lubaga lwa Nyamubâho”. <verse eid="NUM 31:16"/><verse number="17" style="v" sid="NUM 31:17"/>“Buno muyîrhage ngasi wa bûko mulume, omu bâna bâbo, na ngasi mukazi okola olâzire n’omulume”. <verse eid="NUM 31:17"/><verse number="18" style="v" sid="NUM 31:18"/>“Ci abânanyere boshi barhacimanya mulume murhabayîrhaga; bâli binyu abo”. <verse eid="NUM 31:18"/><verse number="19" style="v" sid="NUM 31:19"/>“Ninyu mwene mugendihanda e mbuga ly’ecihando nsiku nda; ngasi yêshi wayîsire omuntu na ngasi yêshi wahumire oku mufù, anagendicîcêsa oku lusiku lwa kasharhu n’olusiku lwa kali nda, mwe n’abashwêkwa binyu”. <verse eid="NUM 31:19"/><verse number="20" style="v" sid="NUM 31:20"/>“Mucêse na ngasi mwambalo, ngasi kalugu kajiragwa n’oluhù, ngasi kalugu kajiragwa n’amôya g’empene na ngasi kalugu kajiragwa n’omurhi”». <verse eid="NUM 31:20"/><verse number="21" style="v" sid="NUM 31:21"/>Omudâhwa Eleazari abwîra balya bantu bâli oku matabâro, erhi: «Alagi ebirhegesirwe na lirya irhegeko Nyamubâho ahâga Mûsa: <verse eid="NUM 31:21"/><verse number="22" style="v" sid="NUM 31:22"/>“Amasholo, ebyûma by’olunyerere, eby’omulinga, ebyûma by’akasiteriti na ebya amasasi, ngasi cirugu cankanahashihirwa ecîko, rnunacihire omu muliro; canabà cinjà. Cikwônene cicigwâsirwe naco okucêsibwa n’amîshi g’okucêsa. Ngasi hyoshi hirhankaja ecîko, munahicêse n’amîshi”. <verse eid="NUM 31:22"/><verse number="23" style="v" sid="NUM 31:23"/>“Ngasi cirugu cankahashihirwa ecîko, munacihire omu muliro; canaba cinjà. Ci kwônene cicigwâsirwe naco okucêsibwa n’amîshi g’okucêsa. Ngasi hyoshi hirhankaja ecîko, munahicêse n’amîshi”. <verse eid="NUM 31:23"/><verse number="24" style="v" sid="NUM 31:24"/>“Mwanashuka emyarmbalo yinyu oku lusiku lwa kali nda; rnwanacêsibwa n’enyuma z’aho mwanahashijà omu cihando”».<verse eid="NUM 31:24"/></para>
  <para style="s1">Okugaba omunyago</para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 31:25"/>Nyamubâho ashambâla na Mûsa amubwîra; erhi: <verse eid="NUM 31:25"/><verse number="26" style="v" sid="NUM 31:26"/>Woyo n’omudâhwa Eleazari n’abarhambo b’emilala y’olubaga, mujire omubalè gw’ebi banyagaga byoshi bibè bya bantu, bibè bya bintu. <verse eid="NUM 31:26"/><verse number="27" style="v" sid="NUM 31:27"/>Kandi wanagaba eyo minyago, cihimbi ciguma kuli balya bâli oku matabâro n’ecindi oku lubaga lwoshi. <verse eid="NUM 31:27"/><verse number="28" style="v" sid="NUM 31:28"/>Oku cigabi c’abalwî bâli oku rnatabâro wanayankakwo ecigabi ca Nyamubâho, kwo kuderha cigabi ciguma oku magana arhanu ga bantu, ga nkâfu, ga ndogomi, erhi ga bibuzi. <verse eid="NUM 31:28"/><verse number="29" style="v" sid="NUM 31:29"/>Wanarhôla kuli cirya cigabi câbo, wanaha omudâhwa Eleazari nka rnpongano ya Nyamubâho. <verse eid="NUM 31:29"/><verse number="30" style="v" sid="NUM 31:30"/>Kuli cirya cindi cigabi cahâbwa bene Israheli, wanaberûla ciguma oku bishwêkwa; wanaha bene Levi, balya bajira omukolo gw’okulanga Endâro ya Nyamubâho. <verse eid="NUM 31:30"/><verse number="31" style="v" sid="NUM 31:31"/>Mûsa n’omudâhwa Eleazari banacijira nka kulyâla Nyamubâho anarhegekaga Mûsa. <verse eid="NUM 31:31"/><verse number="32" style="v" sid="NUM 31:32"/>Ebyanyagagwa na balya bâli bajire oku matabâro, bibuzi bihumbi magana gali ndarhu na makumi gali nda na birhanu. <verse eid="NUM 31:32"/><verse number="33" style="v" sid="NUM 31:33"/>Nkâfu bihumbi makumi gali nda n’ibirhi, <verse eid="NUM 31:33"/><verse number="34" style="v" sid="NUM 31:34"/>ndogorni bihumbi makumi gali ndarhu na ciguma. <verse eid="NUM 31:34"/><verse number="35" style="v" sid="NUM 31:35"/>Oku biyêrekîre abantu, owa bûko mukazi olya orhalisâgiyankwa na mulume bâli bantu bihumbi makumi asharhu na bibirhi boshi haguma. <verse eid="NUM 31:35"/><verse number="36" style="v" sid="NUM 31:36"/>Cigabi ciguma cahâbwa balya bâli oku rnatabâro; bibuzi bihumbi magana asharhu na makumi asharhu na nda, na rnagana arhanu. <verse eid="NUM 31:36"/><verse number="37" style="v" sid="NUM 31:37"/>Muli byo, rnagana gali ndarhu na rnakumi gali nda na birhanu byaberûlirwa Nyamubâho; <verse eid="NUM 31:37"/><verse number="38" style="v" sid="NUM 31:38"/>nkâfu bihumbi makumi asharhu na ndarhu, na muli zo mwarhenga nkâfu makumi gali nda n’ibirhi ziberûlirwe Nyamubâho. <verse eid="NUM 31:38"/><verse number="39" style="v" sid="NUM 31:39"/>Ndogorni bihumbi rnakumi asharhu na magana arhanu na muli zo mwarhenga ndogorni makumi gali ndarhu na nguma ziberûlirwe Nyamubâho. <verse eid="NUM 31:39"/><verse number="40" style="v" sid="NUM 31:40"/>Na bantu bihumbi ikumi na ndarhu, na makumi asharhu na babirhi baberûlirwa Nyamubâho. <verse eid="NUM 31:40"/><verse number="41" style="v" sid="NUM 31:41"/>Mûsa aha omudâhwa Eleazari eyo mpongano yaberûliragwa Nyamubâho nka kulya Nyamubâho anali arhegesire Mûsa. <verse eid="NUM 31:41"/><verse number="42" style="v" sid="NUM 31:42"/>Ebiyêrekîre cirya cigabi cahâbagwa bene Israheli, co cirya Mûsa aberûlaga kuli cirya cahâbagwa abalwî. <verse eid="NUM 31:42"/><verse number="43" style="v" sid="NUM 31:43"/>Eco cigabi cahâbagwa olubaga càli ntya: Bibuzi bihumbi magana asharhu na makumi asharhu na nda na rnagana arhanu, <verse eid="NUM 31:43"/><verse number="44" style="v" sid="NUM 31:44"/>nkâfu bihumbi rnakumi asharhu na ndarhu, <verse eid="NUM 31:44"/><verse number="45" style="v" sid="NUM 31:45"/>ndogorni bihumbi makumi asharhu na magana arhanu, <verse eid="NUM 31:45"/><verse number="46" style="v" sid="NUM 31:46"/>na bantu bihumbi ikumi na ndarhu. <verse eid="NUM 31:46"/><verse number="47" style="v" sid="NUM 31:47"/>Kuli eco cigabi cahâbagwa bene Israheli, Mûsa oku ngasi makumi arhanu arhôlakwo cintu ciguma, n’ebyo abiha bene Levi, bo bajira omukolo gw’okulanga Endâro ya Nyamubâho, nka kulya Nyamubâho anarhegekaga Mûsa.<verse eid="NUM 31:47"/></para>
  <para style="s1">Okuhâna enterekêro</para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 31:48"/>Abarhambo b’ebihumbi n’abarhambo b’amagana, banayisha bajà emunda Mûsa ali, <verse eid="NUM 31:48"/><verse number="49" style="v" sid="NUM 31:49"/>banacimubwîra, mpu: «Abarhumisi bâwe baganjire abasirika rhwàli rhulongolîne, harhabulisiri ciru n’omuguma. <verse eid="NUM 31:49"/><verse number="50" style="v" sid="NUM 31:50"/>Co cirhumire rhulihâna enterekêro emwa Nyamubâho: amasholo ngasi muguma arhôzire, engolo, emigufu, orhugondo, ebisikiyo n’amagerha; rhulijiramwo enterekêro y’okuhyûla embere za Nyamubâho». <verse eid="NUM 31:50"/><verse number="51" style="v" sid="NUM 31:51"/>Mûsa n’omudâhwa Eleazari banacirhôla ebyo birugu, ago masholo n’ebyôla bindi birugu byàli erhi byakozirwekwo. <verse eid="NUM 31:51"/><verse number="52" style="v" sid="NUM 31:52"/>Amasholo baberûlaga bagaha Nyamubâho, balya barhambo b’ebihumbi n’ab’amagana gahika omu buzirho bwa sikêli bihumbi ikumi na ndarhu na magana gali nda na makumi arhanu<note caller="+" style="f"><char style="fr" closed="false">31, 52 </char><char style="ft" closed="false">Esikeli 16.750 byo birò nka 190. Sikêli 5 = grama 57 z’ecûma c’olunyerere. Hali emilengo na ngero nyinji, kwo kwarhumaga barhakâg’ikangana (<char style="xt"><ref loc="NUM 3:47">Mib 3, 47</ref>; <ref loc="NUM 18:16">18, 16</ref></char>…).</char></note>. <verse eid="NUM 31:52"/><verse number="53" style="v" sid="NUM 31:53"/>Balya bantu bàlilwa bakazihêka ngasi muguma ecâge cihimbi c’omunyago. <verse eid="NUM 31:53"/><verse number="54" style="v" sid="NUM 31:54"/>Mûsa n’omudâhwa Eleazari erhi babà bamârhôla ngasi masholo bahâbagwa n’abarhambo b’ecihumbi n’ab’amagana, bagahêka omw’Ihêma ly’Embugânano, nka kakengêzo ka bene Israheli embere za Nyamubâho.<verse eid="NUM 31:54"/></para>
  <chapter eid="NUM 31"/>
  <chapter number="32" style="c" sid="NUM 32"/>
  <para style="s1">Bene Rubeni bahâbwa ishwa</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 32:1"/>Bene Rubeni na bene Gadi bali bagwêrhe masô manji bwenêne ga bishwêkwa. Erhi babona oku ecihugo ca Yazeri n’ecihugo ca Galadi biri bihugo binjà kuli ago masô gâbo, <verse eid="NUM 32:1"/><verse number="2" style="v" sid="NUM 32:2"/>bene Rubeni na bene Gadi bakanya bajà emunda Mûsa àli n’omudâhwa Eleazari n’abarhambo b’olubaga, banacibabwîra, mpu: <verse eid="NUM 32:2"/><verse number="3" style="v" sid="NUM 32:3"/>«Ataroti, Diboni, Nimra, Hesboni, Eleale, Sebami, Nebo na Beoni, eci <verse eid="NUM 32:3"/><verse number="4" style="v" sid="NUM 32:4"/>cihugo Nyamubâho anyagaga embere z’olubaga lwa bene Israheli, ciri cihugo cikwânîne olwabûko, na bambali bâwe bagwêrhe amasò.» <verse eid="NUM 32:4"/><verse number="5" style="v" sid="NUM 32:5"/>Bayûshûla, mpu: «Akabà nîrhu rhurhonyire emunda oli, eci cihugo cihâbwe bambali bâwe, kabè ko kashambala kâbo, orhanacirhuyikizagya Yordani».<verse eid="NUM 32:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 32:6"/>Mûsa ashuza bene Gadi na bene Rubeni, erhi: «Kàli bene winyu bakolaga oku matabâro ninyu moyo musigale ahâla? <verse eid="NUM 32:6"/><verse number="7" style="v" sid="NUM 32:7"/>Carhuma mubulisa bene Israheli oburhwâli bw’okujà muli cirya cihugo Nyamubâho ajibaha? <verse eid="NUM 32:7"/><verse number="8" style="v" sid="NUM 32:8"/>Kwa bene oko basho bajiraga erhi mbarhuma nti bagendiyênja ecihugo kurhenga e Kadesi-Barnea. <verse eid="NUM 32:8"/><verse number="9" style="v" sid="NUM 32:9"/>Basôka kuhika ebwa kabanda ka Eskoli, banacibona ecihugo, banaciyisha balibulîsa bene Israheli oburhwâli bw’okujà muli cirya cihugo Nyamubâho àli abahire. <verse eid="NUM 32:9"/><verse number="10" style="v" sid="NUM 32:10"/>N’oburhè bwa Nyamubâho bwanaciyâka bwenêne olwo lusiku; anacihiga erhi: <verse eid="NUM 32:10"/><verse number="11" style="v" sid="NUM 32:11"/>Abâla bantu barhengaga e Mîsiri banakola bagwêrhe myâka makumi abirhi babusirwe na kujà enyanya, barhabone kuli cirya cihugo nalaganyagya n’endahiro nti nacihà Abrahamu, Izaki na Yakôbo, ebwa kubà barhankulikiraga n’obwêmêre. <verse eid="NUM 32:11"/><verse number="12" style="v" sid="NUM 32:12"/>Aha nyuma lya Kalebu mwene Yefunè w’omunya-Kenezeni na Yozwè mwene Nuni, abo bashimbulîre Nyamubâho n’obwêmêre. <verse eid="NUM 32:12"/><verse number="13" style="v" sid="NUM 32:13"/>Lêro oburhè bwa Nyamubâho bwanaciyâka kuli bene Israheli, kwarhuma abaheka omw’irungu myâka makumi anni, kuhika lirya iburha lyajiriraga Nyamubâho amabî lihungumuke. <verse eid="NUM 32:13"/><verse number="14" style="v" sid="NUM 32:14"/>Loli oku mwamaja ahâli ha basho, nka milandûkiza y’ababusi banyabyâha, mukola mwayûshûla oburhè bwa Nyamubâho kuli bene Israheli. <verse eid="NUM 32:14"/><verse number="15" style="v" sid="NUM 32:15"/>Mukalahira bwamushimba, ashubiyûshûla okuleka bene Israheli muno irungu, munarhume olu lubaga loshi luhwa.»<verse eid="NUM 32:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 32:16"/>Bayegera emunda Mûsa ali, banacimubwîra, mpu: «Rhwayûbaka aha engurhu oku masô gîrhu, rhuyûbake n’ebishagala oku bâna bîrhu barhò. <verse eid="NUM 32:16"/><verse number="17" style="v" sid="NUM 32:17"/>“Kuli rhwe, buzira kulegama, rhwarhôla emirasano yîrhu, rhugenzikanwe na bene Israheli, kuhika rhubahise muli cirya cihugo bagwâsirwe okuyûbakamwo, n’abâna bîrhu banayôrha muli ebyo bishagala rhwayûbaka buzibuzibu, omu kuyôboha abantu ba muli eco cihugo”. <verse eid="NUM 32:17"/><verse number="18" style="v" sid="NUM 32:18"/>“Rhurhagaluke emwa bîrhwe kuhika bene Israheli bajè bayûbaka ngasi muguma muli cirya cihugo c’akashambala kâge”. <verse eid="NUM 32:18"/><verse number="19" style="v" sid="NUM 32:19"/>“Bulya rhurhacibe na kashambala kaci haguma nabo olwo lundi lunda lwa Yordani, ciru na oli kuli kulusha, ebwa kubà akashambala kîrhu rhwakahirwe ebwa lîno ishiriza lya Yordani e Buzûka-zûba”».<verse eid="NUM 32:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 32:20"/>Mûsa abashuza, erhi: Akabà yo na njira mwakulikira eyo, mukanarhôla emirasano yinyu mugenzikanwa mweshi na Nyamubâho, <verse eid="NUM 32:20"/><verse number="21" style="v" sid="NUM 32:21"/>akabà abalume badwîrhe emirasano yâbo bayikira Yordani embere za Nyamubâho bagenzikanwe n’abâbo kuhika Nyamubâho abè amarhenza abanzi bâge embere zâge, <verse eid="NUM 32:21"/><verse number="22" style="v" sid="NUM 32:22"/>n’akabà murhagaluke nk’ecihugo cirhacija coshi omu maboko ga Nyamubâho, aho mwanabà buzira bubî embere za Nyamubâho n’embere za bene Israheli, n’ecihugo canabà ko kashambala kinyu embere za Nyamubâho. <verse eid="NUM 32:22"/><verse number="23" style="v" sid="NUM 32:23"/>Ci akabà murhajiziri ntyo, loli oku mwamajira ecâha emunda Nyamubâho ali; munamanye oku ecâha cinyu camukulikira. <verse eid="NUM 32:23"/><verse number="24" style="v" sid="NUM 32:24"/>Muyûbakage ebishagala oku bâna binyu, muyûbakage n’engurhu oku masô ginyu, munayûkirize ebyo binwa birhenzire ekanwa kinyu.<verse eid="NUM 32:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 32:25"/>Bene Gadi na bene Rubeni banashambâza Mûsa, bamubwîra, mpu: Abarhumisi bâwe bajira nk’okwo nnawîrhu adesire. <verse eid="NUM 32:25"/><verse number="26" style="v" sid="NUM 32:26"/>Abâna bîrhu, bakirhwe, amasò gîrhu n’ebishwêkwa bîrhu byoshi byasigala aha omu bishagala bya Galadi. <verse eid="NUM 32:26"/><verse number="27" style="v" sid="NUM 32:27"/>Nabo abarhumisi bâwe, ngasi yêshi onahêka emirasano y’okulwa, bayikira bagere embere za Nyamubâho bajilwa nk’okwo nnawîrhu adesire.<verse eid="NUM 32:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 32:28"/>Lêro aho, kuli bo, Mûsa abâna aga marhegeko emunda omudâhwa Eleazari ali, na Yozwè, mwene Nuni, n’abarhambo b’emilala yoshi ya bene Israheli. <verse eid="NUM 32:28"/><verse number="29" style="v" sid="NUM 32:29"/>Mûsa ababwîra, erhi: «nka bene Gadi na bene Rubeni bamâyikira Yordani, bo balya balume boshi banagwâsirwe okuyanka emirasano yâbo bajilwa embere za Nyamubâho, na nka ecihugo coshi cikola cinyu, mwanayishibaha, nka kashambala kâbo, ecihugo ca Galadi. <verse eid="NUM 32:29"/><verse number="30" style="v" sid="NUM 32:30"/>Ci erhi akabà barhayikirini emirasano yaho bagenzikanwa mweshi nabo, mwanayîshibayûbasa ekarhî kinyu omu cihugo ca Kanâni.»<verse eid="NUM 32:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 32:31"/>Bene Gadi na bene Rubeni bashuza, baderha, mpu: «Oku Nyamubâho abwîzire bambali bâwe rhwakujira. <verse eid="NUM 32:31"/><verse number="32" style="v" sid="NUM 32:32"/>Rhwayikira n’emirasano yîrhu, rhugenzikanwe na Nyamubâho e Kanâni; n’akashambala k’omwîmo gwîrhu kanayôrha luno lundi lunda lwa Yordani.» <verse eid="NUM 32:32"/><verse number="33" style="v" sid="NUM 32:33"/>Mûsa aha bene Gadi na bene Rubeni na cihimbi ciguma ca bene Menashè ga Yozefu obwâmi bwa Sihoni, mwâmi w’Abanyamoreni, abahà n’obwâmi bwa Og mwâmi w’e Bashani, abahà ecihugo coshi, n’ebishagala bya muli co byoshi, emirhundu ya muli co yoshi n’ebindi bishagala biri elubibi lw’eco cihugo.<verse eid="NUM 32:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 32:34"/>Bene Gadi banaciyûbaka Diboni, Ataroti, na Aroweri, <verse eid="NUM 32:34"/><verse number="35" style="v" sid="NUM 32:35"/>Ataroti-Sofani, Yazeri, Yogboha, <verse eid="NUM 32:35"/><verse number="36" style="v" sid="NUM 32:36"/>Beti-Nimra, Beti-Harani, byoshi byàli bishagala bizibuzibu; banaciyûbaka n’engurhu oku masô gâbo.<verse eid="NUM 32:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="NUM 32:37"/>Bene Rubeni bayûbaka Heseboni, Eleale, Kiriyatayimi. <verse eid="NUM 32:37"/><verse number="38" style="v" sid="NUM 32:38"/>Nebo na Baal Meoni; ci amazîno gâbo gayîsh’ihinduka buzinda; bayûbaka na Sibma, banajà bayîrika ebyo bishagala bajaga banyaga amazîno.<verse eid="NUM 32:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 32:39"/>Bene Makiri, mwene Menashè, barhabâlira Galadi, n’erhi babà bamamunyaga, bakungusha Abanyamoreni bayûbakagamwo. <verse eid="NUM 32:39"/><verse number="40" style="v" sid="NUM 32:40"/>Mûsa, ecihugo ca Galadi acîhà Makiri, mwene Menashè; naye anaciyûbaka mulico. <verse eid="NUM 32:40"/><verse number="41" style="v" sid="NUM 32:41"/>Yayiri, mwene Menashè, arhabâla, arhôla ebishagala byâbo, abiyîrika izîno mpu byo: Bishagala bya Yakiri. <verse eid="NUM 32:41"/><verse number="42" style="v" sid="NUM 32:42"/>Nobahu, arhabâla, arhôla ecihugo ca Kenati n’ebishagala byâco; acîhà izîno lyâge.<verse eid="NUM 32:42"/></para>
  <chapter eid="NUM 32"/>
  <chapter number="33" style="c" sid="NUM 33"/>
  <para style="s1">Ebihando bya bene Israheli erhi bâli omu irungu</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 33:1"/>Alaga ebihando bya bene Israheli erhi barhenga omu cihugo c’e Mîsiri, omu kushimba oku emirhwe yâbo yali, oku burhegesi bwa Mûsa na Aroni. <verse eid="NUM 33:1"/><verse number="2" style="v" sid="NUM 33:2"/>Mûsa akazâg’iyandika ahantu bahanzire, n’aha barhenga nk’oku ebihando byâbo byanali; akazishimba irhegeko ahirwe na Nyamubâho. Alaga ebihando byâbo omu kushimba aha banarhengaga hoshi.<verse eid="NUM 33:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 33:3"/>Barhenga e Ramsesi omu mwêzi gwa burhanzi, omu nsiku ikumi n’irhanu za ogwôla mwêzi gwa burhanzi. Mwâli omu lusiku lurhanzi lukulikira Basâka erhi bene Israheli barhenga e Mîsiri bagenda bacîshinga, bagera embere z’Abanya-Mîsiri boshi. <verse eid="NUM 33:3"/><verse number="4" style="v" sid="NUM 33:4"/>Ago mango erhi Abanya-Mîsiri badwîrhe babisha bene wâbo balya bayîrhagwa na Nyamubâho, balya bâli b’enfula boshi; Nyamubâho ayêrekana obushinganyanya bwâge oku bandi banyamuzinda.<verse eid="NUM 33:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 33:5"/>Erhi barhenga e Ramsesi, bene Israheli bagendihanda e Sukoti. <verse eid="NUM 33:5"/><verse number="6" style="v" sid="NUM 33:6"/>Barhenga e Sukoti, bagendihanda aha Etami, cihugo ciri oku burhambi bw’irungu. <verse eid="NUM 33:6"/><verse number="7" style="v" sid="NUM 33:7"/>Barhenga aha Etami, na erhi babà bamagolonjokera ebwa Pihahiroti, ôbà ah’ishiriza lya Balsefoni, bagend’ihanda embere za Migdoli. <verse eid="NUM 33:7"/><verse number="8" style="v" sid="NUM 33:8"/>Barhenga aho mbêre za Pihahiroti, bayikira omu karhî k’enyanja, bajà ebw’irungu. Erhi bayûsa nsiku isharhu, bagenda omw’irungu ly’Etami, bagendihanda aha Mara. <verse eid="NUM 33:8"/><verse number="9" style="v" sid="NUM 33:9"/>Barhenga aha Mara, bagend’ihanda aha Elimi, abo hàli maliba ikumi n’abirhi na mirhanda makumi gali nda; banacihanda aho. <verse eid="NUM 33:9"/><verse number="10" style="v" sid="NUM 33:10"/>Barhenga aha Elimi bagendihanda hôfi n’enyanja Ndukula. <verse eid="NUM 33:10"/><verse number="11" style="v" sid="NUM 33:11"/>Barhenga ebwa nyanja Ndukula, bagendihanda omw’irungu lya Sini. <verse eid="NUM 33:11"/><verse number="12" style="v" sid="NUM 33:12"/>Barhenga omw’irungu lya Sini, bagendihanda aha Dofka. <verse eid="NUM 33:12"/><verse number="13" style="v" sid="NUM 33:13"/>Barhenga aha Dofka, bagendihanda aha Alusi. <verse eid="NUM 33:13"/><verse number="14" style="v" sid="NUM 33:14"/>Barhenga aha Alusi, bagendihanda aha Refidimi n’aho harhàli mîshi ga kunywa oku lubaga. <verse eid="NUM 33:14"/><verse number="15" style="v" sid="NUM 33:15"/>Barhenga e Refidimi, bagendihanda omw’irungu lya Sînayi. <verse eid="NUM 33:15"/><verse number="16" style="v" sid="NUM 33:16"/>Barhenga omw’irungu lya Sînayi, bagendihanda aha Kabroti Hatava. <verse eid="NUM 33:16"/><verse number="17" style="v" sid="NUM 33:17"/>Barhenga aha Kibroti-Hatava, bagendihanda abà Haseroti. <verse eid="NUM 33:17"/><verse number="18" style="v" sid="NUM 33:18"/>Barhenga aha Haseroti, bagend’ihanda aha Ritima. <verse eid="NUM 33:18"/><verse number="19" style="v" sid="NUM 33:19"/>Barhenga aha Ritima, bagendihanda aha Rimôni-Pêres. <verse eid="NUM 33:19"/><verse number="20" style="v" sid="NUM 33:20"/>Barhenga aha Rimôni-Pêres bagendibanda aha Libna. <verse eid="NUM 33:20"/><verse number="21" style="v" sid="NUM 33:21"/>Barhenga aha Libna, bagendihanda aha Risa. <verse eid="NUM 33:21"/><verse number="22" style="v" sid="NUM 33:22"/>Barhenga aha Risa, bagendihanda aha Kehelata. <verse eid="NUM 33:22"/><verse number="23" style="v" sid="NUM 33:23"/>Barhenga aha Kehelata, bagendihanda oku ntondo ya Seferi. <verse eid="NUM 33:23"/><verse number="24" style="v" sid="NUM 33:24"/>Barhenga oku ntondo ya Seferi, bagendibanda aha Harada. <verse eid="NUM 33:24"/><verse number="25" style="v" sid="NUM 33:25"/>Barhenga aha Harada, bagendihanda aha Makeloti. <verse eid="NUM 33:25"/><verse number="26" style="v" sid="NUM 33:26"/>Barhenga aha Makeloti, bagendihanda aha Tahata. <verse eid="NUM 33:26"/><verse number="27" style="v" sid="NUM 33:27"/>Barhenga aha Tahata, bagendihanda aha Terahi. <verse eid="NUM 33:27"/><verse number="28" style="v" sid="NUM 33:28"/>Barhenga aha Terahi, bagendihanda aha Mitika. <verse eid="NUM 33:28"/><verse number="29" style="v" sid="NUM 33:29"/>Barhenga aha Mitika, bagendihanda aha Hasmona. <verse eid="NUM 33:29"/><verse number="30" style="v" sid="NUM 33:30"/>Barhenga aha Hasmona, bagendihanda aha Moseroti. <verse eid="NUM 33:30"/><verse number="31" style="v" sid="NUM 33:31"/>Barhenga aha Moseroti, bagendihanda aha Bene-Yakani. <verse eid="NUM 33:31"/><verse number="32" style="v" sid="NUM 33:32"/>Barhenga aha Bene-Yakani, bagendihanda aha Hori-Gidgadi. <verse eid="NUM 33:32"/><verse number="33" style="v" sid="NUM 33:33"/>Barhenga aha Hori-Gidgadi, bagendihanda aha Yotebata. <verse eid="NUM 33:33"/><verse number="34" style="v" sid="NUM 33:34"/>Barhenga aha Yotebata, bagendihanda aha Abrona. <verse eid="NUM 33:34"/><verse number="35" style="v" sid="NUM 33:35"/>Barhenga aha Abrona, bagendihanda aha Esiongeberi. <verse eid="NUM 33:35"/><verse number="36" style="v" sid="NUM 33:36"/>Barhenga aha Esiongeberi, bagndihanda omw’irungu lya Sini, kwo kuderha aha Kadesi. <verse eid="NUM 33:36"/><verse number="37" style="v" sid="NUM 33:37"/>Barhenga aha Kadesi, bagendihanda oku ntondo ya Hori, aha buzinda bw’ecihugo c’Edomu. <verse eid="NUM 33:37"/><verse number="38" style="v" sid="NUM 33:38"/>Omudâhwa Aroni, asôkera oku ntondo ya Hori, oku irhegeko lya Nyamubâho ajifîrakwo; mwâli omu mwâka gwa makumi anni kurhenga bene Israheli barhenzire e Mîsiri, omu mwêzi gwa karhanu, omu lusiku lurhanzi lw’omwêzi. <verse eid="NUM 33:38"/><verse number="39" style="v" sid="NUM 33:39"/>Aroni àli akola mukulu wa myâka iganana makumi abirhi n’isharhu, erhi afîra oku ntondo ya Hori. <verse eid="NUM 33:39"/><verse number="40" style="v" sid="NUM 33:40"/>Omunya-Kanâni, mwâmi Aradi, owayûbakaga e Nêgebu omu cihugo ca Kanâni, amanya oku bene Israheli bayishire. <verse eid="NUM 33:40"/><verse number="41" style="v" sid="NUM 33:41"/>Barhenga oku ntondo ya Hori, bagendihanda aha Salmona. <verse eid="NUM 33:41"/><verse number="42" style="v" sid="NUM 33:42"/>Barhenga aha Salmona, bagendihanda aha Punoni. <verse eid="NUM 33:42"/><verse number="43" style="v" sid="NUM 33:43"/>Barhenga aha Punoni, bagendihanda aha Oboti. <verse eid="NUM 33:43"/><verse number="44" style="v" sid="NUM 33:44"/>Barhenga aha Oboti, bagendihanda aha Iye-Abarimi, oku lubibi lwa Mowabu. <verse eid="NUM 33:44"/><verse number="45" style="v" sid="NUM 33:45"/>Barhenga aha Iyim-Abarimi, bagendihanda aha Diboni-Gadi. <verse eid="NUM 33:45"/><verse number="46" style="v" sid="NUM 33:46"/>Barhenga aha Diboni-Gadi, bagendihanda aha Almoni-Diblatayima. <verse eid="NUM 33:46"/><verse number="47" style="v" sid="NUM 33:47"/>Barhenga aha Almoni-Diblatayima, bagendihanda omu birhondo bya Abarimu, ishiriza lya Nebo. <verse eid="NUM 33:47"/><verse number="48" style="v" sid="NUM 33:48"/>Barhenga omu birhondo bya Abarimu, bagendihanda omu rhubanda rhwa Mowabu, hôfi na Yordani, aha ishiriza lya Yeriko. <verse eid="NUM 33:48"/><verse number="49" style="v" sid="NUM 33:49"/>Bahanda hôfi na Yordani, kurhenga kuli Beti-ha-Yesimoti kuhika aha Abeli-ha-Shitimi, omu rhubanda rhwa Mowabu.<verse eid="NUM 33:49"/></para>
  <para style="s1">Irhegeko ly’okugabâna ecihugo ca Kanâni</para>
  <para style="p">
    <verse number="50" style="v" sid="NUM 33:50"/>Nyamubâho ashambâla na Mûsa omu rhubanda rhwa Mowabu; anacimubwîra, erhi: <verse eid="NUM 33:50"/><verse number="51" style="v" sid="NUM 33:51"/>Ogendibwîra bene Israheli ntya, erhi: Amango mwanayikire Yordani, na nka mwamaja omu cihugo ca Kanâni, <verse eid="NUM 33:51"/><verse number="52" style="v" sid="NUM 33:52"/>munakungushe embere zinyu, abayûbaka muli eco cihugo boshi. Muhongole amabuye gâbo matâke goshi, muvungunyule n’ensanamu zâbo z’omulinga bàtulaga, munagendihagula ebwa mpêro zâbo omu birhwa. <verse eid="NUM 33:52"/><verse number="53" style="v" sid="NUM 33:53"/>Mwayîma muli eco cihugo, munaciyûbake; bulya nammuhîre eco cihugo nti muciyîmemwo. <verse eid="NUM 33:53"/><verse number="54" style="v" sid="NUM 33:54"/>Mugabâne eco cihugo omu kuciyeshera ecigole, oku emilala yinyu enali. Abà mwahà akashambala kanene babè erhi bo banali banji, n’abà mwahà akashambala kasungunu babè erhi bo banali basungunu. Ecihimbi ecigole cankanahà omuntu erhi co na câge. Mwanacirhôla cibè cinyu nk’oku emilala ya bashakulûza binyu enali. <verse eid="NUM 33:54"/><verse number="55" style="v" sid="NUM 33:55"/>Ci erhi akabà murhakungushire embere zinyu abo bayûbaka omu cihugo, abà mwakanaleka muli bo ekarhî kinyu bakaziyôrha nka mishûgi emuli omu masù, na nka marhadu omu nkanga. Banakaziyôrha bamulola nka bashombanyi bâbo muli eco cihugo mwajiyubakamwo. <verse eid="NUM 33:55"/><verse number="56" style="v" sid="NUM 33:56"/>Ninyu mwene, nanamulibûsa nk’oku nali ndâlîre okubalibûsa.<verse eid="NUM 33:56"/></para>
  <chapter eid="NUM 33"/>
  <chapter number="34" style="c" sid="NUM 34"/>
  <para style="s1">Embibi za Kanâni</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 34:1"/>Nyamubâho anacishambâla na Mûsa, amubwîra, erhi: <verse eid="NUM 34:1"/><verse number="2" style="v" sid="NUM 34:2"/>«Ojirhegeka bene Israheli obabwîre ntya: “Amango mwaja omu cihugo c’e Kanâni, alagi ecihugo mwagendigabânana: Co cihugo ca Kanâni, nk’oku embibi zâge zinali”. <verse eid="NUM 34:2"/><verse number="3" style="v" sid="NUM 34:3"/>“Olunda lw’emukondwè, kuli mwe lwâbà irungu lya Sini, kuhika aha Edomu, n’olubibi lwinyu lw’ebuzûka-zûba lwarhenga oku cikwi c’eyo buzûka-zûba bw’enyanja y’omunyu”, <verse eid="NUM 34:3"/><verse number="4" style="v" sid="NUM 34:4"/>“n’olwo lubibi lwinyu lwanayandagalira emukondwè, lugere oku murhezi gw’Akrabimi, lugere e Sini, lugendihika emukondwè aha Kadesi-Barnea. Lwanashubigenda, lugere e Hasari-Adari, kandi lugere olunda lw’e Asemoni”. <verse eid="NUM 34:4"/><verse number="5" style="v" sid="NUM 34:5"/>“Kurhenga e Asemoni, olwo lubibi lwahika oku mugezi gw’e Mîsiri, lugendihwêra oku Nyanja”. <verse eid="NUM 34:5"/><verse number="6" style="v" sid="NUM 34:6"/>“Nalo olubibi lw’e Mashinji lwâbà Enyanja Nene: lwo lubibi lwinyu olunda lw’e buzika-zûba”. <verse eid="NUM 34:6"/><verse number="7" style="v" sid="NUM 34:7"/>“Lolagi olwabà lubibi lwinyu olunda lw’emwênè: kurhenga oku Nyanja nnene”, <verse eid="NUM 34:7"/><verse number="8" style="v" sid="NUM 34:8"/>“mwanatwa olubibi lwinyu kuhika oku ntondo ya Hori: kurhenga oku ntondo ya Hori, mwalukanyanya aha Muhango gwa Hamati, olubibi lwanahika aha Sedadi”. <verse eid="NUM 34:8"/><verse number="9" style="v" sid="NUM 34:9"/>“Lwagenda kuhika aha Zifroni, lugendihwêra aha Hasari-Enani: lwo lwâbà lubibi lwinyu olwo lw’emwênè”».<verse eid="NUM 34:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 34:10"/>«Mwanatwa olubibi lwinyu lw’ebuzûka-zûba bwa Hasari-Enani aha Sefami. <verse eid="NUM 34:10"/><verse number="11" style="v" sid="NUM 34:11"/>“Olwo lubibi lwanabunguluka kurhenga e Sefami kujà e Harbela ebuzûka-zûba bwa Ayini, lwanayandagala lugere burhambirhambi omu rhurhondo rhuli eburhambi bw’enyanja ya Kinereti olunda lw’ebuzûka-zûba”. <verse eid="NUM 34:11"/><verse number="12" style="v" sid="NUM 34:12"/>“Lwanayandagala kuli Yordani, lugendihwêra oku nyanja y’omunyu. Co cihugo cinyu ecôla n’oku embibi zâco zinacizungolosire.”»<verse eid="NUM 34:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 34:13"/>Mûsa aha bene Israheli eri irhegeko aderha, erhi: «Eco co cihugo Nyamubâho arhegesire mpu cihâbwe erya milala mwenda haguma na cirya cihimbi c’omulala. <verse eid="NUM 34:13"/><verse number="14" style="v" sid="NUM 34:14"/>“Bulya omulala gwa bene Rubeni nka kulya enyumpa za bashakulûza bâbo zinakulikirana, n’omulala gwa bene Gadi, nabo nk’oku enyumpa za bashakulûza wâbo zinakulikirana, bôhe mîra bahâbagwa akabo kashambala: n’ecihimbi c’omulala gwa Menashè naco cahabirwe akâco kashambala”. <verse eid="NUM 34:14"/><verse number="15" style="v" sid="NUM 34:15"/>“Eyo milala ibirhi n’eco cihimbi c’omulala, bahâbirwe akashambala kâbo ebwa lindi ishiriza lya Yordani, aha ishiriza lya Yeriko, olunda lw’ebuzûka-zûba”».<verse eid="NUM 34:15"/></para>
  <para style="s1">Abarhambo bagabiragwa ecihugo ca Kanâni</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 34:16"/>Nyamubâho anacishambâla na Mûsa amubwîra, erhi: <verse eid="NUM 34:16"/><verse number="17" style="v" sid="NUM 34:17"/>«Alaga amazîno g’abantu bagendimugabira eryo ishwa: omudâhwa Eleazari na Yozwè, mwene Nuni. <verse eid="NUM 34:17"/><verse number="18" style="v" sid="NUM 34:18"/>“Kandi wanaja warhôla murhambo muguma muguma omu ngasi mulala, omu kugaba eryo ishwa”. <verse eid="NUM 34:18"/><verse number="19" style="v" sid="NUM 34:19"/>“Alaga amazîno g’abo bantu: Oku mulala gwa Yûda, Kalebu, mwene Yefunè”; <verse eid="NUM 34:19"/><verse number="20" style="v" sid="NUM 34:20"/>“Oku mulala gwa bene Simoni, Shemweli mwene Amihudi”; <verse eid="NUM 34:20"/><verse number="21" style="v" sid="NUM 34:21"/>“Oku mulala gwa Benyamini, Elidadi, mwene Kisloni”; <verse eid="NUM 34:21"/><verse number="22" style="v" sid="NUM 34:22"/>“Oku mulala gwa bene Dani, omurhambo Buki, mwene Yogli”; <verse eid="NUM 34:22"/><verse number="23" style="v" sid="NUM 34:23"/>“Kuli bene Yozefu: oku mulala gwa bene Menashè, omurhambo Hanieli mwene Efodi”; <verse eid="NUM 34:23"/><verse number="24" style="v" sid="NUM 34:24"/>“Kuli bene Efrayimu, omurhambo Kemueli, mwene Shiftani”; <verse eid="NUM 34:24"/><verse number="25" style="v" sid="NUM 34:25"/>“Oku mulala gwa bene Zabuloni, omurhambo Elisafani, mwene Parnaki”; <verse eid="NUM 34:25"/><verse number="26" style="v" sid="NUM 34:26"/>“Oku mulala gwa bene Isakari, omurhambo Paltieli, mwene Azani”; <verse eid="NUM 34:26"/><verse number="27" style="v" sid="NUM 34:27"/>“Oku mulala gw’Aseri; omurhambo Ahihudi, mwene Shelomi”; <verse eid="NUM 34:27"/><verse number="28" style="v" sid="NUM 34:28"/>“Oku mulala gwa Nefutali, omurhambo Pedaheli, mwene Amihudi.”»<verse eid="NUM 34:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 34:29"/>Abo bo Nyamubâho arhegekaga mpu ecihugo ca Kanâni bacigabire bene Israheli.<verse eid="NUM 34:29"/></para>
  <chapter eid="NUM 34"/>
  <chapter number="35" style="c" sid="NUM 35"/>
  <para style="s1">Ecigabi ca bene Levi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 35:1"/>Nyamubâho ashambâla na Mûsa omu rhubanda rhwa Mowabu, hôfi na Yordani, aha ishiriza lya Yeriko aderha, erhi: <verse eid="NUM 35:1"/><verse number="2" style="v" sid="NUM 35:2"/>Orhegeke bene Israheli, oku kashambala ayishihâbwa, bajè bahakwo bene Levi ebishagala bayûbakamwo. Mubahè n’amalambo bakaziyabuliramwo eburhambi bwa ebyo bishagala. <verse eid="NUM 35:2"/><verse number="3" style="v" sid="NUM 35:3"/>Obahè aha bayûbaka, n’amalambo bankahasha okukaziyabulira­mwo ebishwêkwa byâbo, ebinene n’ebisungunu na ngasi bindi bishwêkwa byoshi. <verse eid="NUM 35:3"/><verse number="4" style="v" sid="NUM 35:4"/>Amalambo g’ebyo bishagala bene Levi bayûbakamwo bakazirhangirira oku lukûta lw’olugo, omuhanda, makoro cihumbi, omu marhambi mwoshi.<verse eid="NUM 35:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 35:5"/>Mwanagera embuga ya ngasi lugo, makoro bihumbi bibirhi olunda lw’ebuzûka-zûba, makoro bihumbi bibirhi olunda lw’emukondwè, makoro bihumbi bibirhi olunda lw’ebuzika-zûba na makoro bihumbi bibirhi olunda lw’emwênè. Olugo lwanaja ekâgarhî. Go malambo g’ebyo bishagala <verse eid="NUM 35:5"/><verse number="6" style="v" sid="NUM 35:6"/>Ebishagala mwahà bene Levi biri birya ndarhu mwaleka bakaziyâkiramwo, mwanakazileka ngasi wayîsire omuntu akaziyakiramwo; kandi mwanabayushulira bindi bishagala makumi anni na bibirhi. <verse eid="NUM 35:6"/><verse number="7" style="v" sid="NUM 35:7"/>Ebishagala mwahà bene Levi byoshi haguma byâbà makumi anni na munâni, kuguma n’amalambo g’okuyabulira. <verse eid="NUM 35:7"/><verse number="8" style="v" sid="NUM 35:8"/>Ebyo bishagala mwaja mwarhôla bihimbi by’ecihugo muhire bene Israheli, mukajira ntya: abagwêrhe oluhande lunene bo mwanakazirhôlakwo ebinene, n’abagwêrhe ebisungunu, mwanarhôla na bisungunu. Ngasi baguma bakaziha bene Levi ebishagala bayûbakamwo, omu kulola luhande lunganaci bahâbirwe.<verse eid="NUM 35:8"/></para>
  <para style="s1">Irhegeko ly’ebishagala by’okuyâkirwamwo</para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 35:9"/>Nyamubâho ashambâla na Mûsa, amubwîra, erhi: «Ogendidesa bene Israheli obabwîre ntya: <verse eid="NUM 35:9"/><verse number="10" style="v" sid="NUM 35:10"/>“Amango mwâbà mwamayikira e Yordani, munakola mudekerire, omu cihugo ca Kanâni”, <verse eid="NUM 35:10"/><verse number="11" style="v" sid="NUM 35:11"/>“mwanacîshoga ebishagala byâbà kuli mwe, bishagala by’okuyâkiramwo, mulya ankahashiyakira omuntu wayîsire owâbo buzira luhinzo”. <verse eid="NUM 35:11"/><verse number="12" style="v" sid="NUM 35:12"/>“Ebyo bishagala byo mwakaziyâkiramwo omwihôzi w’omukò, ly’omwîsi alekiyîrhwa arhanacigendisamba embere z’olubaga”. <verse eid="NUM 35:12"/><verse number="13" style="v" sid="NUM 35:13"/>“Ebishagala mwahâna byâbà ndarhu by’okukaziyâkiramwo”. <verse eid="NUM 35:13"/><verse number="14" style="v" sid="NUM 35:14"/>“Muhâne ngo isharhu ishiriza lya Yordani na zindi isharhu omu cihugo ca Kanâni, zibè ngo za kuyâkirwamwo”. <verse eid="NUM 35:14"/><verse number="15" style="v" sid="NUM 35:15"/>“Ezo ngo ndarhu zaba hantu ha kuyâkirwamwo kuli bene Israheli, oku muntu w’ecigolo n’oku ngasi wundi oyûbasire ekarhî kinyu, lyo ngasi muntu wanayisire owundi muntu buzira luhinzo ahashibona aha ayâkira”. <verse eid="NUM 35:15"/><verse number="16" style="v" sid="NUM 35:16"/>“Erhi akabà ashûsire owundi muntu n’ecirugu c’ecûma, n’olya nyakushûrhwa erhi ankafà, owashûrhaga ali mwîsi, na ngasi mwîsi agwâsirwe ahâbwe obuhane bw’okufà”. <verse eid="NUM 35:16"/><verse number="17" style="v" sid="NUM 35:17"/>“Erhi ankabanda ibuye, lirya lyankahashiyîrha, na olya wabandagwa afè, nyakubanda ali mwîsi: n’omwîsi kukwânîne ahâbwe obuhane bw’okufà”. <verse eid="NUM 35:17"/><verse number="18" style="v" sid="NUM 35:18"/>“Erhi ankashûrha n’akarhi kankahashiyîrha, n’erhi olya washûrhagwa ankafà, nyakushûrha ali mwîsi; n’omwîsi kukwânîne ahâbwe obuhane bw’okufà”. <verse eid="NUM 35:18"/><verse number="19" style="v" sid="NUM 35:19"/>“Omwihôzi w’omukò yêne wankayîrha oyo mwîsi; erhi ankajira ah’amushimâna, anamuyîrha”».</para>
  <para style="d" vid="NUM 35:19">Obuhane oku muntu obulazire omukò<verse eid="NUM 35:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 35:20"/>Erhi omuntu ankahirimya owâbo n’omujina erhi amubande kantu kalebe kalya kankamuhirimya, na ntyo olya muntu afè, <verse eid="NUM 35:20"/><verse number="21" style="v" sid="NUM 35:21"/>nîsi erhi akamushûrha n’okuboko kwâge ebwa kumushomba, n’erhi olya muntu ankafà, olya washûrhaga kukwânîne ahâbwe obuhane bw’okufà, bulya ali mwîsi: omwihôzi w’omukò anayîrha olya mwîsi erhi ankajira aha amushimâna. <verse eid="NUM 35:21"/><verse number="22" style="v" sid="NUM 35:22"/>Ci, erhi ankahirimya owundi muntu buzira luhinzo, erhi amubande akantu buzira bulonza bubî, <verse eid="NUM 35:22"/><verse number="23" style="v" sid="NUM 35:23"/>nîsi erhi ankarhogezakwo owâbo ibuye lyankayîrha, na olya muntu afè, buzira kuderha mpu anali mushombanyi wamulongezagya olufù, <verse eid="NUM 35:23"/><verse number="24" style="v" sid="NUM 35:24"/>olubaga lwanatwa olubanja ekarhî ka nyakuyîrha na olya mwihôzi w’omukò, nk’oku amarhegeko gadesire, <verse eid="NUM 35:24"/><verse number="25" style="v" sid="NUM 35:25"/>lwanafumya olya mwîsi kuli olya mwihôzi w’omukò, lwanamushubiza muli lulya lugo ashuba ayâkire; anabêra eyo kuhika aha kufà kw’omudâhwa mukulu, olya washîgagwa amavurha mimâna. <verse eid="NUM 35:25"/><verse number="26" style="v" sid="NUM 35:26"/>Erhi oyo mwîsi akarhenga, embere z’amango, muli lulya lugo ali ayâkire, <verse eid="NUM 35:26"/><verse number="27" style="v" sid="NUM 35:27"/>n’erhi olya mwihôzi w’omukò akamushimâna omu lundi lugo, kuleka lulya lw’okuyâkirwamwo, erhi olya mwihôzi w’omukò akayîrha olya wayîrhaga owâbo, arhajiziri câha ca kuyîrha omuntu, <verse eid="NUM 35:27"/><verse number="28" style="v" sid="NUM 35:28"/>bulya omwîsi kukwânîne abêre omu lugo lw’okuyâkirwamwo, kuhik’aha kufà kw’omudâhwa mukulu. N’enyuma ly’okufà kw’omudâhwa mukulu, anahasha okushubira erya munda akashambala kâge kali. <verse eid="NUM 35:28"/><verse number="29" style="v" sid="NUM 35:29"/>Aga marhegeko gamanyîsa obuhashe bwinyu n’obuhashe bw’amâburhwa ginyu, ngasi hantu mwankanayûbaka hoshi.<verse eid="NUM 35:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 35:30"/>Aha ngasi kuyîrha omuntu, kukwânîne habè abahamirizi, lyône oyo mwîsi ankafà; ci kwône omuhamîrizi muguma arhankarhuma baderha mpu oku buhamîrizi bwâge bakolaga batwîra omuntu okufà. <verse eid="NUM 35:30"/><verse number="31" style="v" sid="NUM 35:31"/>Murhahîra mukayêmêra empongano y’omuntu wayîrhaga owâbo, mpu lyo acira, n’obo akwânîne okufà, bulya agwâsirwe afè. <verse eid="NUM 35:31"/><verse number="32" style="v" sid="NUM 35:32"/>Murhahîra mukayêmêra empongano yarhuma olya muntu wayakiraga omu cihugo ca okuyâkirwamwo, ahashigaluka embere z’okufà kw’omudâhwa mukulu. <verse eid="NUM 35:32"/><verse number="33" style="v" sid="NUM 35:33"/>Murhahîra mukahemula ecihugo mulimwo, bulya omukò gwo guhemula ecihugo, na ntà mpyûlo oku cihugo, oku mukò gwabulagagwa, okurhali kubulaga omukò gw’olya wagubulagaga. <verse eid="NUM 35:33"/><verse number="34" style="v" sid="NUM 35:34"/>Orhahîra okahemula ecihugo muyûbasiremwo, n’ecihugo niono na mbà nyûbasire ekarhî, bulya nie Nyamubâho mbêra ekarhî ka bene Israheli.<verse eid="NUM 35:34"/></para>
  <chapter eid="NUM 35"/>
  <chapter number="36" style="c" sid="NUM 36"/>
  <para style="s1">Akashambala k’abakazi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 36:1"/>Abarhambo b’e milala ya bene Galadi, mwene Makiri, mwene Menashè, w’omu bûko bwa Yozefu, bayisha bajà embere za Mûsa n’embere z’abandi barhambo b’emilala ya bene Israheli. <verse eid="NUM 36:1"/><verse number="2" style="v" sid="NUM 36:2"/>Banaciderha, mpu: «Nyamubâho arhegesire Nnawîrhu ahè bene Israheli ecihugo, omu kubayeshera ecigole; kandi nnawîrhu ahâbirwe na Nyamubâho irhegeko ly’okuhà bâli ba mwene wîrhu Selofehadi ecâbo cigabi c’akashambala. <verse eid="NUM 36:2"/><verse number="3" style="v" sid="NUM 36:3"/>Erhi bakajaga bayankwa n’omulume w’omu bundi bûko bwa bene Israheli, akashambala kâbo kanaba kashambala ka cihimbi citwisire oku kashambala ka balarha, cigendiyûshûla akashambala k’abà erya munda bajiheruka, ntyo kubè kutwa oku kîrhu kashambala. <verse eid="NUM 36:3"/><verse number="4" style="v" sid="NUM 36:4"/>N’amango gayisha, galya mango g’okucîshinga kwa bene Israheli, ako kashambala kâbo kanagendiyushuka oku kashambala k’ab’erya munda baherusire; ntyo akashambala kâbo cibè cihimbi citwisire oku kashambala ka balarha.»<verse eid="NUM 36:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 36:5"/>Mûsa, oku irhegeko lya Nyamubâho, aha bene Israheli irhegeko, aderha, erhi: Omulala gwa bene Yozefu gudesire okushingânîne. <verse eid="NUM 36:5"/><verse number="6" style="v" sid="NUM 36:6"/>Lolagi eci Nyamubâho arhegesire oku biyêrekîre bâli ba Selofehadi: banayankwa n’omulume basimire, casinga abè w’omu bûko bwa b’îshe. <verse eid="NUM 36:6"/><verse number="7" style="v" sid="NUM 36:7"/>Ntyo akashambala ka bene Israheli karhacikazirhenge oku mulala mulebe kajè oku gundi mulala; okwo kwarhuma bene Israheli bakaziyôrhana ngasi baguma akashambala k’omulala gwa b’îshe wâbo. <verse eid="NUM 36:7"/><verse number="8" style="v" sid="NUM 36:8"/>Ngasi mwânanyere yêshi wankabà n’akashambala omu bûko bulebe bwa bene Israheli, kukwânîne ayankwe n’omulume w’omu mulala gw’îshe. Ntyo bene Israheli banakazilanga ngasi baguma akashambala ka b’îshe wâbo. <verse eid="NUM 36:8"/><verse number="9" style="v" sid="NUM 36:9"/>Ntà kashambala karhenga oku mulala kajè oku gundi mulala, ci emilala ya bene Israheli yayôrhana ngasi baguma akashambala kâbo.<verse eid="NUM 36:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 36:10"/>Okwo Nyamubâho arhegekaga Mûsa, kwo na bâli ba Selofehadi bajizire. <verse eid="NUM 36:10"/><verse number="11" style="v" sid="NUM 36:11"/>Mahla, Tirsa, Hogla, Milka na Noa, bâli ba Selofehadi, bayankwa na bene ba mwishè. <verse eid="NUM 36:11"/><verse number="12" style="v" sid="NUM 36:12"/>Bayankwa omu milala ya bene Menashè, mwene Yozefu, na ntyo akashambala kayôrha omu mulala gwa bene îshe wâbo.<verse eid="NUM 36:12"/></para>
  <para style="s1">Okushwinja</para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 36:13"/>Ezo zo ngeso n’amarhegeko Nyamubâho ahâga Mûsa kuli bene Israheli omu rhubanda rhwa Mowabu, hôfi na Yordani, aha ishiriza lya Yeriko.<verse eid="NUM 36:13"/></para>
  <chapter eid="NUM 36"/>
</usx>
