<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHP" style="id">- Nahali</book>
  <para style="h">फिलेपियो</para>
  <para style="toc3">फिलेपियो</para>
  <para style="toc2">फिलेपियो</para>
  <para style="toc1">फिलेपियो पौलुस लिखेल पोत्रो</para>
  <para style="mt2">फिलेपियो पौलुस ने लिखा हुआ पत्र</para>
  <para style="mt1">फिलेपियो पौलुस लिखेल पोत्रो</para>
  <para style="imt">ओलखात</para>
  <para style="ip">पौलुस फिलीपी वाला विश्वासीह यीशु मसीन जेल्मान कोमीत कोमी 61 सालान पासाण पोत्र लिखेल इतो। तो जेली मा <char style="xt"><ref loc="PHP 1:13">1:13</ref></char> इतो तेवी लिखेल इतो निहते रोम माय फिलेपियो हेयरा वाली मोंडलीह लिखेल इतो। आपु फिलेपियोन बारा माय जुनाला नेमा माय थोड़ोक हिक सेकतेह। फिलेपियो एक राजदानीन हियोर इतो पेल्‍ली मोंडली एती, जा माय मकादुनिया माय बुणेल एती। पौलुस एने सिलास एकठास मोंडलीन सुरवात किरेल एता, एने न्या वोर काय एक रातीन केरता जेली माय कोंडायेल इतो, जेवी ता ताहरो एता। <char style="xt"><ref loc="ACT 16">प्रेरितान काम 16</ref></char></para>
  <para style="ip">ज्या पोत्राह लिखणे जुलूम वातु एत्यु। पौलुस ती टेमीन वापेर मोंडलीह तान उगे रेन साबासीन केरता दन्यवाद आपणे, जेवी ता होमलेल काय तो जेली माय हे। <char style="xt"><ref loc="PHP 4:10-19">4:10-19</ref></char> तो जेली माय तान देशा कोहलीक एती तो बी दिखेल हे एने मोंडलीह तीमुथीयुस एने एपाफ्रोदितुसान बारा माय कियेल हे। <char style="xt"><ref loc="PHP 2:19-30">2:19-30</ref></char> काय ता तान स्वागत केरी एने तान अगवाईन सम्मान केरी।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. फिलिप मोंडलीह नमस्‍कार केरीन पोत्रान सुरवात किरेल हे। <char style="ior"><ref loc="PHP 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. ओंगाण तो तान देशान बारा माय थोड़ीक जाणकारी देखाड़ेह एने थोड़ीक चिन्ता ताह तो देखाड़ेह। <char style="ior"><ref loc="PHP 1:3-2:30">1:3–2:30</ref></char></para>
  <para style="io1">3. ओवतो तो विश्वासी जीवणो जीवणेन हिकाड़ेह। <char style="ior"><ref loc="PHP 3:1-4:9">3:1–4:9</ref></char></para>
  <para style="io1">4. पौलुस फिलेपियोन मोंडलीह तान बोकसीस केरता दन्यवाद एने तान आबिवादन मोकलीन निवरावेह। <char style="ior"><ref loc="PHP 4:10-23">4:10-23</ref></char></para>
  <chapter number="1" style="c" sid="PHP 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 16:12">प्रेरितान काम 16:12</ref>
      </char>
    </note>मसी यीशुन पावोर मी पौलुस एने तीमुथीयुसान उगे रेन, सोब बोगवानान माणहान नावे जा मसी यीशु माय फिलेपी हेयरा माय एकी केरीन रेतेह, मोंडलीन आदिकारी एने सेवक हेऱ्या। <figure style="fig" alt="City of PhilippiHigh" file="hk00363c.tif" size="span" copy="Horace Knowles ©" ref="1:1">फिलेपीन हियोर</figure><verse eid="PHP 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 1:2" />आमरो बोगवान आबोख एने मालीक यीशु मसीन उगे रेन तुमूह गीण एने सान्ती जुड़ते रेय।<verse eid="PHP 1:2" /></para>
  <para style="s">पौलुसान विन्ता एने दन्यवाद</para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3" />मी जुलबुखे तुमूह एर केरने, तुलबूखे आपणा बोगवानान दन्यवाद केरने; <verse eid="PHP 1:3" /><verse number="4" style="v" sid="PHP 1:4" />एने जेवी केदी तुमरे केरता विन्ता केरने, ते जेलेम खुसी माय विन्ता केरने। <verse eid="PHP 1:4" /><verse number="5" style="v" sid="PHP 1:5" />काहाकाय तुमू पिल्ले दिह रेन आज वोर हाजाली खुबेर पोसरावणेन मार गोवांद्या रियेल हेते। <verse eid="PHP 1:5" /><verse number="6" style="v" sid="PHP 1:6" />माहु जी वातीन पुरो बुरहो हे काय बोगवान तुमरी विच माय हाजो काम सुरवात किरेल तोच ताह यीशु मसीन द्‍वारे ताह आवणेन दिह वोर पुरो केरी। <verse eid="PHP 1:6" /><verse number="7" style="v" sid="PHP 1:7" />तुमरी केरता मारो जो विचार हाजोच हे, काहाकाय तुमू मारा मोना माय आव बुहेल हेते, ज्यानकेरीन काय एने मार बोंदीम एने हाजाली खोबरीन केरता जापाप, एने प्रमाण आपणेन तुमू सोब मार हेऱ्या गीण माय बागीदार हेते। <verse eid="PHP 1:7" /><verse number="8" style="v" sid="PHP 1:8" />ज्या माय बोगवान मारो गोवा हे काय मी मसी यीशुन गेत मोंग केरीन तुमरी आखान आसा केरथु। <verse eid="PHP 1:8" /><verse number="9" style="v" sid="PHP 1:9" />मी ज्यी विन्ता केरथु काय तुमरो मोंग खेरली इकेल केरीन एने आखी बातीन मोना हेऱ्यो उंजु बी होवटोह वोदते जाय, <verse eid="PHP 1:9" /><verse number="10" style="v" sid="PHP 1:10" />न्या वोर काय तुमू हाजाम रेन हाजी वातुह मोंगाल्ली जाणो, एने मसीन दिह वोर निर्दोस बोणीन रिवो, एने दोस मा मांगाड़ो; <verse eid="PHP 1:10" /><verse number="11" style="v" sid="PHP 1:11" />एने ता देरमान फोला केरीन जा मसी यीशुन द्‍वारे हेते, बोरपुर एते जावो जाकेरीन बोगवानान बोड़ाय एने स्तुती एते रेय।<verse eid="PHP 1:11" /></para>
  <para style="s">मालीकुस जीवाय हे</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12" />एय बाय बोणहा, मारी ज्यी आसा हे काय तुमू ज्यो जाण लिवो काय मी ज्यो विठेल हे, ताहसे हाजाली खुबेर ने बोड़ती ईयेल हे। <verse eid="PHP 1:12" /><verse number="13" style="v" sid="PHP 1:13" /><note caller="+" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="ACT 28:30">प्रेरितान काम 28:30</ref></char></note>न्या वोर काय राजवाड़ान आखा देखरेत केरनार टोलाह, एने न्यावाला आखा माणहाम ज्यो देखाय जायेल हे, काय मी मसीन केरता जेलीम बोंदी हे; <verse eid="PHP 1:13" /><verse number="14" style="v" sid="PHP 1:14" /><note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">खुबेर; थोड़ाक लेख माय बोगवानान खुबेर लिखेल हे।</char></note>एने मालीक माय जा बाहख एने बोणीख हेते, ता माय रेन थोड़ाक मार बोंदी एणेन वोजेसे, ईमोत केरीन बांदिन बोगवानान वचन निदड़क होमलावणेन उंजु बी साहस केरतेह। <verse eid="PHP 1:14" /><verse number="15" style="v" sid="PHP 1:15" />थोड़ाक ते कुयराय एने राड़ीन वोजेसे मसीन पारचार केरतेह एने थोड़ाक हाजी आसा केरीन। <verse eid="PHP 1:15" /><verse number="16" style="v" sid="PHP 1:16" />जा माणहे मोंगान वोजेसे ओहलो केरतेह, काहाकाय ज्यो जाणतेह काय मारो नियाव बोगवानान हाजाली खोबरीन राखवालीन केरनेन केरता माहु आपेल हे। <verse eid="PHP 1:16" /><verse number="17" style="v" sid="PHP 1:17" />एने जुलूम होवटा ते खेराय माय नाह पुण स्वार्थीपोणा माय मसीन पारचार केरतेह काहाकाय ता सोचतेह काय ज्याकेरीन ता जेली माय मार केरता दुख विसती। <verse eid="PHP 1:17" /><verse number="18" style="v" sid="PHP 1:18" />ज्या माय काय फारेक नाह पुड़ेत! एने मी ज्यासे खुस हे, मोहत्वान ते ज्यो हे काय ता तेरीका केरीन नाहते ता तेरीका केरीन ता नाहते ता खाराब उद्देशा पोर नाहते हाजाला पारचार ते मसीन ईथे, एने मी ज्या माय जेलेम खुसुस रेह।<verse eid="PHP 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 1:19" />काहाकाय माहु मालुम हे काय तुमरी विन्तान द्‍वारे, एने यीशु मसीन जीवान दानान द्‍वारे, ज्यान फोल मारो सुटकारो एय। <verse eid="PHP 1:19" /><verse number="20" style="v" sid="PHP 1:20" />मी ते ज्यीच हार्दिक लालसा एने आसा मेलथु काय मी काल्लीस वात माय लाजवाव नाय, पुण जीहे मार मोजबुत साहस ने कारेण मसीन बोड़ाय मार सेरीरान द्‍वारे कायेम इती रियेल हे, तिहेच एवी बी एय, मी जीवतालो रेव नाहते मोर जाव। <verse eid="PHP 1:20" /><verse number="21" style="v" sid="PHP 1:21" />काहाकाय जीवाय ज्यी काय हे? मार केरता जीवाय मसी हे। एने मोत मार केरता फायदो हे। <verse eid="PHP 1:21" /><verse number="22" style="v" sid="PHP 1:22" />पुण केदी सेरीराम जीवतालो रेणेच मार कामान केरता फायदान हे, ते मी नाह जाणेत काय कुणीह निवाड़ने जुवे। <verse eid="PHP 1:22" /><verse number="23" style="v" sid="PHP 1:23" />दुयान विची माय माहु निवाड़नेन तेकलीत ईथे मी जीवायीह ठोकरावीन मसी फाय जाणे आसा केरथु काहाकाय ज्यी वात मार केरता जुलूम हाजी हे। <verse eid="PHP 1:23" /><verse number="24" style="v" sid="PHP 1:24" />पुण मारो सेरीराम रेणु तुमरी केरता जुलूम जोरेवरी हे। <verse eid="PHP 1:24" /><verse number="25" style="v" sid="PHP 1:25" />ज्यानकेरीन काय माहु ज्यान बुरहो हे माहु मालुम हे काय मी जीवतालो रेह, एने तुमू आखा हिऱ्यो रेह। जाकेरीन तुमू बोरहा माय मोजबुत ईती जावो एने ता माय खुस रिवो; <verse eid="PHP 1:25" /><verse number="26" style="v" sid="PHP 1:26" />एने जी मोठवाय तुमू मार बाराम केरतेह, ती मी पोशो तुमू फाय आवुह ते मसी यीशु माय होवटीह वोद जाय। <verse eid="PHP 1:26" /><verse number="27" style="v" sid="PHP 1:27" />फोक्‍तो ओलोस किरो काय तुमरो बोलनो चालनो मसीन हाजाली खोबरीन लायेक रेय काय मी आवीन देखु, नाहते नाय बी आवो, तुमरा बाराम ज्योच हुमलो काय तुमू एकुच जीव माय थोब रेनाह, एने एक मोन एन हाजाली खोबरीन बोरहान केरता मेहनेत केरती रेतेह, <verse eid="PHP 1:27" /><verse number="28" style="v" sid="PHP 1:28" />एने काल्लीस वातु माय विरोद केरनाराह बिय नाह, ज्यो तानकेरता खेतेमान साप निसाणी हे पुण तुमरी केरता सुटकारान एने ज्यो बोगवानान उगे रेन हे। <verse eid="PHP 1:28" /><verse number="29" style="v" sid="PHP 1:29" />काहाकाय मसीन वोजेसे तुमू पोर जी गीण ईयेल काय ता पोर बुरहो ओलास किरो इही नाह पुण तानकेरता दुख बी विठो; <verse eid="PHP 1:29" /><verse number="30" style="v" sid="PHP 1:30" /><note caller="+" style="x"><char style="xo" closed="false">1:30 </char><char style="xt" closed="false"><ref loc="ACT 16:19-40">प्रेरितान काम 16:19-40</ref></char></note>एने तुमूह ओहलीच मेहनेत केरनु हे, जिहकेरीन तुमू माहु केरतालो दिखेल हेते, एने एवी वोर होमेलतेह काय मी ओहलोच केरथु।<verse eid="PHP 1:30" /></para>
  <chapter eid="PHP 1" />
  <chapter number="2" style="c" sid="PHP 2" />
  <para style="s">मसीन गेरबोड़ाय एने मोठवाय</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1" />केदी मसी माय थोड़ीक दिलासो, एने तान मोंग माय दिर, एने जीव ने सेंगेती, एने थोड़ीक किव एने गीण हे।<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">तुमरी सहबागीता जीव हेऱ्यो हे; नाहते जीव तुमूह एक दिहरान सहबागीता माय लावेह</char></note> <verse eid="PHP 2:1" /><verse number="2" style="v" sid="PHP 2:2" />ते मारी ज्यी खुसी पुरी किरो काय एक मोन एन रिवो, एने एकुच मोंग, एने एकुच आसा मीलो। <verse eid="PHP 2:2" /><verse number="3" style="v" sid="PHP 2:3" />स्वार्थ एने जुठी बोड़ायीन केरता काय मा किरो, पुण गेरबोड़ाय माय एका दिहराह सोताह रेन हाजा सुमजो। <verse eid="PHP 2:3" /><verse number="4" style="v" sid="PHP 2:4" />एकेक सोतान केरता ओलोस नाह पुण दिहरान केरता बी चिन्ता केरी, <verse eid="PHP 2:4" /><verse number="5" style="v" sid="PHP 2:5" />जोहलो मसी यीशुन सोबाव इतो तुहलोच तुमरो बी सोबाव रेणे जुवे:<verse eid="PHP 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PHP 2:6" />
    <note caller="+" style="f">
      <char style="fr" closed="false">2:6 </char>
      <char style="ft" closed="false">रिवो; नाहते एय जावो।</char>
    </note>जो बोगवानान वेह रूपाम एन बी तो सोताह,</para>
  <para style="q2" vid="PHP 2:6">बोगवानान गेत नाह सोमज्यो जा माय तो जोड़ाय जाय।<verse eid="PHP 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PHP 2:7" />पुण आपणे आपाह ओहलो शुन्य केर दिनो,</para>
  <para style="q2" vid="PHP 2:7">एने दासान वेह रूप लिदो,</para>
  <para style="q2" vid="PHP 2:7">एने माणहान गेणतीम एय गीयो।<verse eid="PHP 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PHP 2:8" />एने माणहान वेहा माय देखीन सोताह गेरबड़ो किऱ्यो, एने न्या वोर उकुमा माय रिनो काय मोत, होव,</para>
  <para style="q2" vid="PHP 2:8">खुरूसखाम ने मोत बी वेठ लिदो।<verse eid="PHP 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PHP 2:9" />ज्यास ने वोजेसे बोगवान ताह जुलूम मोठो बी किरेल,</para>
  <para style="q2" vid="PHP 2:9">एने ताह तो नाव आपेल जो आखा नावा माय रेन उचो हे।<verse eid="PHP 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PHP 2:10" />
    <note caller="+" style="f">
      <char style="fr" closed="false">2:10 </char>
      <char style="ft" closed="false">निचेन दुनिया; ओहलो मानतेह काय मुरेल माणहे बुईन बुंदे आदारी दुनिया माय रेतेह।</char>
    </note>काय जा हेरगाम एने देरती पोर</para>
  <para style="q2" vid="PHP 2:10">एने देरतीन बुंदे हेते,</para>
  <para style="q2" vid="PHP 2:10">ता सोब यीशुन नाव से मांड्या पोड़ी,<verse eid="PHP 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PHP 2:11" />एने बोगवान आबाख ने बोड़ायीन केरता</para>
  <para style="q2" vid="PHP 2:11">एकेक जिब मान लेय काय यीशु मसीच मालीक हे।<verse eid="PHP 2:11" /></para>
  <para style="s">उजालान गेत चुमको</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12" />ज्यानकेरीन एय मारा मोंगाल्ला, जिहकेरीन तुमू जेलेम से उकुम मानते आयेल हेते, तिहेच केरीन एवी बी नाह मार हेऱ्या रेतेन पुण खाज केरीन मी सेटो रेथु, तीबी बितेन एने कापतेन आप आपणा सुटकारान काम पुरो केरती जावो; <verse eid="PHP 2:12" /><verse number="13" style="v" sid="PHP 2:13" />काहाकाय बोगवानुच हे जो आपणी हाजाली आसा दाड़ीन तुमरा मोना माय आसा एने काम, दुयू वातुन केरनेन पोरबाव टाकेल हे। <verse eid="PHP 2:13" /><verse number="14" style="v" sid="PHP 2:14" />सोब काम बिगेर कुड़कुड़ावतेन एने बिगेर बोलचालान केऱ्या किरो, <verse eid="PHP 2:14" /><verse number="15" style="v" sid="PHP 2:15" />काहाकाय तुमू जी खाराब वोसी माय बोगवानान निर्दोस सोरा बोणीन रिवो, जान विची माय तुमू जीवायीन वचन लेतेन दुनिया माय हेलेगताला दिवान गेत देखातेह। <verse eid="PHP 2:15" /><verse number="16" style="v" sid="PHP 2:16" />काय मसीह जीव उठणेन दिह माहु मोठवाय केरनेन कारीन रेय काय नाह मारो दोवेड़नो एने नाह मारो मेहनेत केरनो उदेड़ एनो। <verse eid="PHP 2:16" /><verse number="17" style="v" sid="PHP 2:17" />केदी माहु तुमरा बोरहान रूप बोलीदान एने सेवा हेऱ्यो आपणी लुय बी वोयाड़ने पोड़ी, तीबी मी खुस हे एने तुमू आखा हिऱ्यो खुसी वाटथु। <verse eid="PHP 2:17" /><verse number="18" style="v" sid="PHP 2:18" />तिहेच तुमू बी खुस रिवो एने मार हेऱ्या खुसी किरो।<verse eid="PHP 2:18" /></para>
  <para style="s">तीमुथीयुस एने इपफ्रुदीतुस</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19" />माहु मालीक यीशु माय आसा हे काय मी तीमुथीयुसाह तुमू फाय चालोच मोकलुह, काय तुमरो हाल होमलीन माहु हुक जुड़ी। <verse eid="PHP 2:19" /><verse number="20" style="v" sid="PHP 2:20" />काहाकाय मार फाय ओहला काल्लोस माणुह नाह सोतो, जो खेराय माय चोखाला मोना केरीन तुमरी बोलायीन बारा माय चिन्ता केरी। <verse eid="PHP 2:20" /><verse number="21" style="v" sid="PHP 2:21" />काहाकाय सोब सोतान कामाम लागेल हेते, नाह काय यीशु मसीन। <verse eid="PHP 2:21" /><verse number="22" style="v" sid="PHP 2:22" />पुण ताह तुमू पारखेल एने जाण बी लियेल हेते काय जीहे सोरो आबाख हेऱ्यो केरने, तोहलोच तु हाजाली खोबरीह पोसार ने मार हेऱ्यो मेहनेत किरेल। <verse eid="PHP 2:22" /><verse number="23" style="v" sid="PHP 2:23" />तानकेरीन माहु आसा हे काय जीहे माहु मालुम पुड़ील काय मारो काय एण्यो हे, तिहेच मी ताह तुमू फाय चालोच मोकली देह। <verse eid="PHP 2:23" /><verse number="24" style="v" sid="PHP 2:24" />एने माहु मालीक माय बुरहो हे काय मी सोता बी तुमूह मिलने उतवाल्युह आवुह। <verse eid="PHP 2:24" /><verse number="25" style="v" sid="PHP 2:25" />पुण मी इपफ्रुदीतुसाह जो मारो बाहख हे, एने मोदेक केरनार एने हाती लेड़ानार एने तुमरो खुबर्‍यो, एने गेरजीन वातु माय मारी सेवा केरनार हे, तुमू फाय मोकेलनेन जोरेवरी सोमज्यो। <verse eid="PHP 2:25" /><verse number="26" style="v" sid="PHP 2:26" />काहाकाय तान मोन तुमू सोबा माय लागेल एतो, तानकेरीन तु दुख माय रेतालो काहाकाय तुमू तान बेमारीन हाल होमलेल एता। <verse eid="PHP 2:26" /><verse number="27" style="v" sid="PHP 2:27" />एने खेरीच तो दुखाऱ्यो ते एय जायेल इतो न्या वोर काय मोरने केरतालो, पुण बोगवान ता पोर किव किऱ्यो, एने ता पोर ओलोस नाह पुण मार पोर बी काय माहु दुखा पोर दुख नाय एय। <verse eid="PHP 2:27" /><verse number="28" style="v" sid="PHP 2:28" />तानकेरीन मी ताह मोकेलनेन पोशो बी कोसीत किऱ्यो काय तुमू ताह पोशा मिलीन खुस एय जावो एने मारो बी दुख कोम एय जाय। <verse eid="PHP 2:28" /><verse number="29" style="v" sid="PHP 2:29" />तानकेरीन तुमू मालीक माय ता हेऱ्या जुलूम खुसी माय मिलाज्यो, एने ओहलान आदर केऱ्या किरज्‍यो, <verse eid="PHP 2:29" /><verse number="30" style="v" sid="PHP 2:30" />काहाकाय तो मसीन कामान केरता तान जीवा पोर वेला विसीन मोतीन आहने आव लागेल इतो, काहाकाय जी कोमी तुमरी उगे रेन मार सेवा माय ईयेल एती तीह पुरी केरी।<verse eid="PHP 2:30" /></para>
  <chapter eid="PHP 2" />
  <chapter number="3" style="c" sid="PHP 3" />
  <para style="s">खेरलो न्यायीपण</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1" />तानकेरीन एय मारा मोंगाल्ला बाय बोणहा, मालीक माय खुस रिवो। तीस वातु तुमूह जाहार ताहार लेखणेन माहु काय तेकलीत नाह एत, एने ज्या माय तुमरी बोलाय हे, <verse eid="PHP 3:1" /><verse number="2" style="v" sid="PHP 3:2" />चिताह रेन होमालीन रिवो, ता खाराब काम केरनाराह रेन होमालीन रिवो, ता काट कुट केरनाराह रेन होमालीन रिवो। <verse eid="PHP 3:2" /><verse number="3" style="v" sid="PHP 3:3" />काहाकाय खेतनावाला आपुस हेते, जा बोगवानान जीवान अगुवाई माय बोक्ती केरतेह, एने मसी यीशु पोर मोठवाय केरतेह, एने सेरीरा पोर बुरहो नाह केरती। <verse eid="PHP 3:3" /><verse number="4" style="v" sid="PHP 3:4" />पुण मी ते सेरीरा पोर बी बुरहो मेल सेकथु। केदी कुणीह सेरीरा पोर बुरहो मेलनेन विचार एय, ते मी ताह रेन बी वोदार बुरहो मेल सेकथु। <verse eid="PHP 3:4" /><verse number="5" style="v" sid="PHP 3:5" /><note caller="+" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="ROM 11:1">रोमीयो 11:1</ref>; </char><char style="xt" closed="false"><ref loc="ACT 23:6">प्रेरितान काम 23:6</ref>; <ref loc="ACT 26:5">26:5</ref></char></note>आठवे दिह मारो खेतना ईयेल, इस्राएलान वोस एने बिन्यामीनान गेराणान हे; इब्रानीन इब्रानी हे; कायदान बाराम केय ताहार फरिसी हे। <verse eid="PHP 3:5" /><verse number="6" style="v" sid="PHP 3:6" /><note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="ACT 8:3">प्रेरितान काम 8:3</ref>; <ref loc="ACT 22:4">22:4</ref>; <ref loc="ACT 26:9-11">26:9-11</ref></char></note>तिवारान बाराम केदी केय ताहार मोंडलीह वेला केरावणार; एने कायदान देरमीपोणान बाराम केदी केय ताहार निर्दोस इतो। <verse eid="PHP 3:6" /><verse number="7" style="v" sid="PHP 3:7" />पुण जी जी वातु मार फायदान एती, तिहेच मी मसीन वोजेसे दुको सोमजी लियेल हे। <verse eid="PHP 3:7" /><verse number="8" style="v" sid="PHP 3:8" />मी आपणा मालीक मसी यीशुन ओलखातीन उत्तमतान वोजेसे सोब वातुह दुको सोमेजथु। ज्यान वोजेसे मी सोब वोस्तुन हानी विसेल, एने ताह कोचरो सोमेजथु, काहाकाय मी मसीह सापड़ावु। <verse eid="PHP 3:8" /><verse number="9" style="v" sid="PHP 3:9" />एने ता माय देखाय जाव; नाह काय ता देरमीपोणा हिऱ्यो, जी नेमाम हे, पुण ता देरमीपोणा हिऱ्यो जो मसी पोर बुरहो केरनेन वोजेसे हे, एने बोगवानान उगे रेन बुरहो केरने से जुड़ेह; <verse eid="PHP 3:9" /><verse number="10" style="v" sid="PHP 3:10" />काहाकाय मी ताह एने तान पोशो जीव उठणेन ताकेतीह, एने तान दुखान सेंगेतीह जाणु, एने तान मोतीन बाराबोरीह सापड़ावु, <verse eid="PHP 3:10" /><verse number="11" style="v" sid="PHP 3:11" />काहाकाय मी किहीक बी केरीन मुरेल माय रेन जीव उठणेन पोद वोर पुचो।<verse eid="PHP 3:11" /></para>
  <para style="s">निसाणीन उगे दोवेड़नो</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12" />ज्यो मतलब नाह काय मी सापड़ाव लियेल हे, नाहते खेरलो बोण जायेल हे; पुण ती वोस्तुह देरनेन केरता दोवड़ीन जाथु, ज्यानकेरता मसी यीशु माहु दिरेल इतो। <verse eid="PHP 3:12" /><verse number="13" style="v" sid="PHP 3:13" /><note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">नाह; थोड़ाक लेख माय एवी नाह लिखेल हे।</char></note>एय बाय बोणहा, मारो विचार ज्यो नाह सोतो काय मी देर लियेल हे; पुण ज्यो ओलोस एक काम केरथु काय जी वातु पासाण रेय जायेल हेत्यु तीह विहरीन, ओंगाणली वातुन उगे चालतेन, <verse eid="PHP 3:13" /><verse number="14" style="v" sid="PHP 3:14" />निसाणीन उगे दोवड़ीन जाथु, काय तो ईनाम सापड़ावु ज्यानकेरता बोगवान माहु मसी यीशु माय उपेर हादेल हे। <verse eid="PHP 3:14" /><verse number="15" style="v" sid="PHP 3:15" />आपु माय रेन जोलाक खेरा हेते, ज्योस विचार केरी, केदी एगदी वात माय तुमरो आंगेच विचार एय ताहार बोगवान ताह बी तुमू पोर देखाड़ देय। <verse eid="PHP 3:15" /><verse number="16" style="v" sid="PHP 3:16" />तानकेरीन जा वोर आपु पुचील हेते, ताच ने गेत चाले। <verse eid="PHP 3:16" /><verse number="17" style="v" sid="PHP 3:17" /><note caller="+" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="1CO 4:16">1 कुरिंथीयो 4:16</ref>; <ref loc="1CO 11:1">11:1</ref></char></note>एय बाय बोणहा, तुमू आखा मिलीन मार गेत चाल चालो, एने ताह उलखो जा ज्यी रिती पोर जीवतेह, जान उदारण तुमू आमरे माय देखतेह; <verse eid="PHP 3:17" /><verse number="18" style="v" sid="PHP 3:18" />काहाकाय होवटास हेते, जा इहकेरीन जीवतेह, जान वात मी तुमूह जाहार ताहार किरेल हे, एने एवी बी रेड़ी रेड़ीन केथु काय ता सोतान बोलनो चालना केरीन मसीन खुरूसखाम ने विरोदी हेते। <verse eid="PHP 3:18" /><verse number="19" style="v" sid="PHP 3:19" />तान सेवेट खेतेम हे, तान देव पेट हे, ता आपणी लाजीन वातु पोर मोठवाय केरतेह, एने देरतीन वोस्तु पोर मोन लागाड़ीन रेतेह। <verse eid="PHP 3:19" /><verse number="20" style="v" sid="PHP 3:20" />पुण आपणो सोतान देस हेरगा माय हे; एने आपु एक सुटकारो आपणार मालीक यीशु मसीन ता रेन आवणेन वाट जोवतेह। <verse eid="PHP 3:20" /><verse number="21" style="v" sid="PHP 3:21" />तु तान ताकेतीन ता पोरबावान गेत जाकेरीन तो आखी वोस्तुह तान आदिकार माय केरनार, आपणा मुरेल सेरीरान वेह बोदलीन, तान बोड़ायीन सेरीरान गेत बोणाव देय।<verse eid="PHP 3:21" /></para>
  <chapter eid="PHP 3" />
  <chapter number="4" style="c" sid="PHP 4" />
  <para style="s">निर्देश</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1" />तानकेरीन एय बाय बोणहा, तुमू मारा कोलाक मोंगाल्ला हेते, जी मारी खुसी एने मुकूट एय, मालीक माय इहीचकेरीन थोबीन रिवो<verse eid="PHP 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 4:2" />मी यूओदियाह एने सुन्तुखे तुमू दुयाह बी विन्ता केरथु काय मालीक माय बोणीख ने गेत एका दिहरा हेऱ्या सहमती बाणावीन रिवो। <verse eid="PHP 4:2" /><verse number="3" style="v" sid="PHP 4:3" />एय खेरला हाती, मी तुवा बी विन्ता केरथु काय तु त्यु बायकुन मोदेक केर, काहाकाय त्यु मार हेऱ्यु हाजाली खुबेर फेहलावणेन, क्लेमेंस एने मारा दिहरा हाती हेऱ्यु मेहनेत किरेल, जान नाव जीवणान पुस्तेक माय लिखेल हेते। <verse eid="PHP 4:3" /><verse number="4" style="v" sid="PHP 4:4" />मालीक माय एक एन कायेम खुस रिवो; मी पुशो केथु, खुस रिवो। <verse eid="PHP 4:4" /><verse number="5" style="v" sid="PHP 4:5" />तुमरी कोमलता आखा माणहा पोर देखाय। मालीक जेल्दी आवण्यो हे। <verse eid="PHP 4:5" /><verse number="6" style="v" sid="PHP 4:6" />काल्ली बी वातुन चिन्ता मा किरो; पुण एकेक वात माय तुमरो निवेदन, विन्ता एने विन्तान द्‍वारा दन्यवाद हेऱ्यो बोगवानान ओंगाण मेलाय जाय। <verse eid="PHP 4:6" /><verse number="7" style="v" sid="PHP 4:7" />तेवी बोगवानान हुक, जो आखा होमेजाह रेन आंगे हे, तुमरा मोनाह एने तुमरा विचाराह मसी यीशु माय एक एणेन द्‍वारा होमालीन मेली। <verse eid="PHP 4:7" /><verse number="8" style="v" sid="PHP 4:8" />ज्यानकेरीन एय बाय बोणहा, जी जी वातु खेरली, आदरणीय, हाज्यी, चोखाली, मोनाह पुटी तोहली, मतलब जी बी हाजा गुण एने स्तुतीन लायेक वातु हेत्यु, त्यु पोर द्यान लागाड्या किरो। <verse eid="PHP 4:8" /><verse number="9" style="v" sid="PHP 4:9" />जी वातु तुमू माह फाय रेन हिकेल हेते, एने स्वीकार किरेल हेते, त्यीह तुमरा आचारण माय लावो। एने होमलेल हेते, एने मार माय दिखेल हेते, तास ने पालेन केऱ्या किरो, तेवी बोगवान जो हुकान जिर हे, तुमरी हिऱ्यो रेय।<verse eid="PHP 4:9" /></para>
  <para style="s">दान ने केरता दन्यवाद</para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10" />मी मालीक माय जुलूम खुस हे काय एवी ओला दिह्यान पासाण तुमरी चिन्ता मार बारा माय पोशी देखाड़णेन गालो जुड़ेल हे; खेरीच तुमूह पेलुच बी ज्यान विचार एतो, पुण तुमूह टेम नाह जुड़नो। <verse eid="PHP 4:10" /><verse number="11" style="v" sid="PHP 4:11" />ज्यो नाह काय मी मारी कोमीन कारीन ज्यो केथु; काहाकाय मी ज्यो हिकेल हे काय जी हाल माय हे; तास माय खुसी केरू। <verse eid="PHP 4:11" /><verse number="12" style="v" sid="PHP 4:12" />मी अनुबव किरेल हे, काय कोमी काय हे एने जादा काय हे; एकेक वात एने सोब हाल माय मी बुखल्यो रेणे, एने एकेक हाल माय का बी काहरी बी सोब हाल माय आफरीन रेणो मी हिकेल हे। <verse eid="PHP 4:12" /><verse number="13" style="v" sid="PHP 4:13" />जो माहो ताकेत आपेह तान द्‍वारे मी आखो काय केर सेकथु। <verse eid="PHP 4:13" /><verse number="14" style="v" sid="PHP 4:14" />तीबी तुमू हाजो किरेल काय मारा दुखा माय मारा हाती बोणना। <verse eid="PHP 4:14" /><verse number="15" style="v" sid="PHP 4:15" />एय फिलेपियो, तु सोता बी जाणेह काय हाजाली खोबरीन पारचारान पेल, जेवी मी मकादुनिया माय रेन गीयो, तेवी तुमूह सोड़ीन उंजु काल्ली मोंडली लेणा देणान बाराम मारी मोदेक नाह केरी। <verse eid="PHP 4:15" /><verse number="16" style="v" sid="PHP 4:16" /><note caller="+" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="ACT 17:1">प्रेरितान काम 17:1</ref></char></note><note caller="+" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="2CO 11:9">2 कुरिंथीयो 11:9</ref></char></note>इहकेरीन जेवी मी थिस्सलुनिक्यो माय ईथे, तेवीह बी तुमू मारी कोमी पुरी केरनेन केरता एकाह रेन जास्ती वार काय पुण मोदेक लेन मुकलेल एता। <verse eid="PHP 4:16" /><verse number="17" style="v" sid="PHP 4:17" />ओहलो नाह काय मी बोकसीस ने आसा केरथु, पुण मी ओहलो दान होदथु जो तुमरा तुमरा खाता माय जोमा केरू। <verse eid="PHP 4:17" /><verse number="18" style="v" sid="PHP 4:18" />मार फाय आखो काय हे, एने जुलूम बी हे; जी वोस्तु तुमू इपफ्रुदीतुस ने आथे ली मुकलेल एता त्युह देरीन मी आखरी गीयोह, तो ते सुखदायक सुगन्द, लेय लेणेन लायेक बोलीदान हे, जो बोगवानाह पुटीह। <verse eid="PHP 4:18" /><verse number="19" style="v" sid="PHP 4:19" />मारो बोगवान बी तान ता मालदेनान गेत जो बोड़ाय हेऱ्यो मसी यीशु माय हे, तुमरी एकेक कोमीह पुरो केरी। <verse eid="PHP 4:19" /><verse number="20" style="v" sid="PHP 4:20" />आमरो बोगवान एने आबाख ने बोड़ाय कायेम इती रेय। आमेन।<verse eid="PHP 4:20" /></para>
  <para style="s">सेवल्यो नमस्‍कार</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21" />एकेक बोगवानान माणहाह, जा मसी यीशु माय हेते नमस्‍कार किवो। जा बायाख एने बोणीख मार हेऱ्या हेते, तुमूह नमस्‍कार केतेह। <verse eid="PHP 4:21" /><verse number="22" style="v" sid="PHP 4:22" />आखा बोगवानान माणहे, खास केरीन जा केसर ने गेराणान हेते, तुमूह नमस्‍कार केतेह। <verse eid="PHP 4:22" /><verse number="23" style="v" sid="PHP 4:23" />आमरा मालीक यीशु मसीन गीण तुमू माणहा पोर इती रेय<verse eid="PHP 4:23" /></para>
  <chapter eid="PHP 4" />
</usx>