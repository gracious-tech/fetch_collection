<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="REV" style="id">- Nahali</book>
  <para style="h">प्रकाशितवाक्य</para>
  <para style="toc3">प्रकाशितवाक्य</para>
  <para style="toc2">प्रकाशितवाक्य</para>
  <para style="toc1">योहान ने प्रकाशितवाक्य</para>
  <para style="mt2">युहन्ना का प्रकाशितवाक्य</para>
  <para style="mt1">योहान ने प्रकाशितवाक्य</para>
  <para style="imt">ओलखात</para>
  <para style="ip">प्रकाशितवाक्यान ज्यो पुस्तेक नोवाला नेम ने आखरी पुस्तेक हे, एने ज्यो सेवली बुखेत लेखाय जायेल हे। प्रेरित योहान यीशु मसीन जेल्मान पासाण 95 वोरह्यान आस पास लिखेल हे <char style="xt"><ref loc="REV 1:1">1:1</ref></char> एने तोच योहान ने हाजाली खुबेर एने योहान ने 1, 2, 3 पोत्रा लिखेल हे। ज्याज योहानाह माणहे, “यीशु जाह पोर मोंग किरेह।” इहकेरीन मानेन ओलेखतेह, <char style="xt"><ref loc="JHN 13:23">योहान 13:23</ref></char> यीशु मसीन हाजाली खुबेर केरता पदमुस नावान टापु पोर सेजा बोगतणे बाजरियेल ईतो, तेवी योहान ज्या पुस्तेकाह लिखेल। <char style="xt"><ref loc="REV 1:9">1:9</ref></char></para>
  <para style="ip">ज्यो पुस्तेक लेखणेन योहान ज्यो एतो काय ज्या पुस्तेकाह वाचणारे यीशु हेऱ्या बोरहा माय रेणेन केरता खुसी जुड़ी, एने यीशुन पुशो आवणो आहने एतो केरीन ता माय आसा पायदा केरने <char style="xt"><ref loc="REV 1:3">1:3</ref>; <ref loc="REV 22:7">22:7</ref></char> तो ज्या पुस्तेकाह आखा बुरहो माणहान केरता लिखेल। पुण खास केरीन मोंडलीह लिखेल ईतो, तान बाराम बाग<char style="xt"><ref loc="REV 2-3">2–3</ref></char> माय जुड़ेह। योहान खुद ने लेख्याह बोगवानान उगे रेन आयेल खुबेर एने जाणाव किथे, एने जी वातुह तो दिखेल ईतो तान पुरावो अलंकारीक बाषा माय आपेह, न्यो जो पुस्तेक हे तो जुनाला नेम ने थोड़ाक बाग हेऱ्यो मिलतो जुलतो हे एने <char style="xt"><ref loc="ZEC 6:1-8">जकर्‍या 6:1-8</ref></char> ज्या बाग हेऱ्यो मिलेह। तिहेस केरीन हात पावल्यु एने हात वाटका ज्यो मीस्र देस पोर आयेल पिड़ान गेत हे, <char style="xt"><ref loc="EXO 7-9">निर्गमन 7–9</ref></char> अद्याय वोर प्रकाशितवाक्य आखरी दिह्यान बाराम वर्णन किरेह, ओवतो यीशु किहीक जिके एने ता पोर बुरहो केरनारे किहीक कायेम वोर जीवताला रेती तो किथे। ज्या पुस्तेकान माद्यम से चेतावणी आपेह एने यीशुह पोशो आवणेन बाराम तुमूह आसा जुड़ी।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. योहान खुद ने ओलखात आपेह काय ज्यी जाणाव ताह किहीक जुड़ेल। <char style="ior"><ref loc="REV 1:1-20">1:1-20</ref></char></para>
  <para style="io1">2. यीशुन उगे रेन हात मोंडलीह प्रतक्श रूप माय बोगवाना फाय रेन जुड़ेल खुबेर किथे। <char style="ior"><ref loc="REV 1:1-3:22">1:1–3:22</ref></char></para>
  <para style="io1">3. हात सिक्‍कान बाराम उल्लेख केरने। <char style="ior"><ref loc="REV 4:1-8:5">4:1–8:5</ref></char></para>
  <para style="io1">4. एने हात पावलीन वर्णन किरेह। <char style="ior"><ref loc="REV 8:6-11:19">8:6–11:19</ref></char></para>
  <para style="io1">5. योहान एक आतल्या सोरान एने हात मुंडा वाला एजगेरा हेऱ्यो किहीक लेड़ाय केरने ज्यो किथे। <char style="ior"><ref loc="REV 12:1-14:20">12:1–14:20</ref></char></para>
  <para style="io1">6. योहान हात रागान वाटकान बाराम लिखीह। <char style="ior"><ref loc="REV 15:1-16:18">15:1–16:18</ref></char></para>
  <para style="io1">7. बोगवान तान जुगा वाला दुसमोना पोर जिक किहीक प्राप्त किरेह। <char style="ior"><ref loc="REV 17:1-20:15">17:1–20:15</ref></char></para>
  <para style="io1">8. योहान नोवालो जुग एने नोवाली देरती जी आवणी हे तान बाराम वर्णन किरेह। <char style="ior"><ref loc="REV 21:1-22:21">21:1–22:21</ref></char></para>
  <chapter number="1" style="c" sid="REV 1"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 1:1"/>यीशु मसीन प्रकाशितवाक्य ज्यो ताह बोगवान ज्यानकेरता आपेल काय तान पावराह त्यु वातु। जीन जेल्दी एणेन जोरवरी हे देखाड़ी। एने तो हेरोगदुताह मोकलीन तान द्‍वारे तान पावोर योहानाह केयो, <verse eid="REV 1:1"/><verse number="2" style="v" sid="REV 1:2"/>योहान बोगवानान वचन एने मसी यीशुन गोवाही। मतलब जो काय तो दिखेल ईतो तान गोवाय दिनो। <verse eid="REV 1:2"/><verse number="3" style="v" sid="REV 1:3"/>बोरकेतवाला ता हेते जा जी जाणाव ने खोबरीन वचनाह होमेलतेह एने ज्या माय जो लिखेल हे तान गेत चालतेह! काहाकाय ज्‍यु आखी वातुह एणेन टेम आहने हे।<verse eid="REV 1:3"/></para>
  <para style="s">हात मोंडलीह नमस्‍कार</para>
  <para style="p">
    <verse number="4" style="v" sid="REV 1:4"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:4 </char>
      <char style="xt" closed="false">
        <ref loc="REV 4:5">प्रकाशितवाक्य 4:5</ref>
      </char>
    </note>योहान ने उगे रेन त्यु हात मोंडल्यु, ज्‍यु आसीया देसा माय हेत्यु:</para>
  <para style="p" vid="REV 1:4">तुमूह गीण एने सान्ती जुड़ी ता बोगवानान उगे रेन जो हे, जो ईतो, एने जो आवण्यो हे, एने ता हात जीवान उगे रेन जा तान राजगादिन ओंगाण हेते, <verse eid="REV 1:4"/><verse number="5" style="v" sid="REV 1:5"/>एने मसी यीशुन उगे रेन, जो खीरलो गोवाह हे, एने मुरेल माय रेन जीव उठणार पिल्लो एने देरतीन राजान आदिकारी हे। तुमूह गीण एने सान्ती जुड़ी।</para>
  <para style="p" vid="REV 1:5">तो आपुह मोंग किरेह एने तो तान लुय केरीन आपणा पापा माय रेन आपुह सोड़व्यो। <verse eid="REV 1:5"/><verse number="6" style="v" sid="REV 1:6"/><note caller="+" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="REV 5:10">प्रकाशितवाक्य 5:10</ref></char></note>एने आपुह एक राज एने तान आबाख बोगवानान केरता चाकर्‍यो बाणाव दिनो। यीशु मसीन बोड़ाय एने आदिकार कायेम कायेम एती रेय! आमेन।<verse eid="REV 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 1:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:7 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:30">मत्ती 24:30</ref>; <ref loc="MRK 13:26">मरकुस 13:26</ref>; <ref loc="LUK 21:27">लुका 21:27</ref>; <ref loc="1TH 4:17">1 थिस्सलुनिक्यो 4:17</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="JHN 19:34">योहान 19:34</ref>,<ref loc="JHN 19:37">37</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:30">मत्ती 24:30</ref>
      </char>
    </note>दिखो, तो वादला हिऱ्यो आवण्यो हे! एने आखा माणहे ताह देखती, ता माणहे बी देखती जा ताह मारील एता। एने देरतीन आखा माणहे तान कारेण साती ठोकीन रेड़ती। आमेन।<verse eid="REV 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 1:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:8 </char>
      <char style="xt" closed="false">
        <ref loc="REV 22:13">प्रकाशितवाक्य 22:13</ref>
      </char>
    </note>मालीक बोगवान जो हे, एने जो ईतो एने जो आवण्यो हे, जो आखाह रेन ताकेतवालो हे, तो ज्यो किथे, “मीच पिल्लो, एने आखरी हे।”<verse eid="REV 1:8"/></para>
  <para style="s">योहानाह मसीन दर्शन</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 1:9"/>मी योहान, तुमरो बाहख यीशु मसीन कारेण दुख एने राज एने दिर माय तुमरी हिऱ्यो बागीदार हे। मी पतमुस नावान टापु माय बोगवानान वचन एने यीशुन गोवाय केणेन कारेण बोंदी ईतो। <verse eid="REV 1:9"/><verse number="10" style="v" sid="REV 1:10"/>मी एप्तान पेल्‍ली दिह चोखाला जीवा माय बोराय गीयो, एने मार पासाण पावलीन आवाज ने गेत मोटलो बोल होमलानो, <verse eid="REV 1:10"/><verse number="11" style="v" sid="REV 1:11"/>तो ज्यो केणे बाजरियेल एतो, “जो काय तु दिखेह, ताह पुस्तेक माय लिखते जा एने त्यु आसीयान सात मोंडल्यु: इफिसुस, समुरना, पिरगमुन, थुआतीरा, सरदीस, फिलादिलफिया, एने लोदिकिया फाय मुकेल दे।” <figure style="fig" alt="Map of seven churches in Asia" file="hk00378c.tif" size="span" copy="Horace Knowles ©" ref="1:11">एशियान हात मोंडलीन नाकाशो</figure><verse eid="REV 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 1:12"/>तेवी मी जो मार हिऱ्यो बोलने बाजरिनोह, ताह देखणेन केरता पासाण फिरनु एने पासाण फिरीन मी होनान हात दिवा मेलनेन जागु दिख्यो, <verse eid="REV 1:12"/><verse number="13" style="v" sid="REV 1:13"/>एने ता दिवान विची माय माणहान सोरान गेत एक एदम्याह मी दिख्यो, जो पाया हिऱ्यो वोर फाड़का पेरीन, एने हाती पोर होनान पुट्टो बांद रियेल ईतो। <verse eid="REV 1:13"/><verse number="14" style="v" sid="REV 1:14"/>तान मुंड एने लेट्या बोरफान एने कापसान गेत चोमेकता एता, एने तान डोला आक्‍ठान आसीन गेत एता। <verse eid="REV 1:14"/><verse number="15" style="v" sid="REV 1:15"/>तान पाय बाठी माय तापाड़ीन चोमकाड़ेल पितलान गेत एता, एने तान आवाज ते जोवराम पोड़तालो पाण्यान गेत एतो। <verse eid="REV 1:15"/><verse number="16" style="v" sid="REV 1:16"/>तो तान जेवड्या आथा माय हात ताराह लीय रियेल ईतो, एने तान मुयाम रेन दाराल्ली दुय दारान तालवार निकेलने बाजरियेल एती। एने तान मुय हिराण पोर निकलेल दिह्यान दोप ने गेत चोमेकतालो। <verse eid="REV 1:16"/><verse number="17" style="v" sid="REV 1:17"/><note caller="+" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="REV 2:8">प्रकाशितवाक्य 2:8</ref>; <ref loc="REV 22:13">22:13</ref></char></note>जेवी मी ताह दिख्यो ते मुरेल ने गेत तान पाया पोर पोड़ गीयो। तेवी तो माहु पोर तान जेवड्या आथा मेलीन केयो, “बिय मा! मीच पिल्लो एने आखरी हे।” <verse eid="REV 1:17"/><verse number="18" style="v" sid="REV 1:18"/>मी तोच हे! जो मोर जायेल ईतो, पुण एवी मी कायेम ने केरता जीवतालो हे। मोत एने आंदारकेली दुनिया पोर मार फाय आदिकार हे। <verse eid="REV 1:18"/><verse number="19" style="v" sid="REV 1:19"/>केरीन जी वातु तु दिखेल हे, एने जी वातु एणे बाजरेन्युह, एने जी वातु ज्यान पासाण एण्यु हेत्यु, त्यु आख्युह लिख ली। <verse eid="REV 1:19"/><verse number="20" style="v" sid="REV 1:20"/>मतलब ता हात तारान मालमात जाह तु मार जेवड्या आथाम दिखेल ईतो, एने ता हात होनान दिवान मालमात: ता हात तारा मोंडलीह खुबेर पोचाड़नारे हेरोगदुत हेते, एने ता हात दिवा हात मोंडल्यु हेत्यु।<verse eid="REV 1:20"/></para>
  <chapter eid="REV 1"/>
  <chapter number="2" style="c" sid="REV 2"/>
  <para style="s">इफिसुस ने मोंडलीह खुबेर</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 2:1"/>इफिसुस मायवाली मोंडलीह खुबेर पोचाड़नार हेरोगदुताह ज्यो लिख:</para>
  <para style="p" vid="REV 2:1">“जो तान जेवड्या आथा माय हात ताराह लीय रिनोह, एने होनान हात दिवान विची माय फिरेह तो ज्यो किथे काय। <verse eid="REV 2:1"/><verse number="2" style="v" sid="REV 2:2"/>जो तु किरेल एने तार मेहनेतीन कामाह एने दिराह मी जाणथु; एने ज्यो बी काय तु खाराब माणहाह देख नाह सिकेत। एने जा सोताह प्रेरित केतेह, पुण ता नाह सोता, तु ताह होदिन जुठा सापड़ायेल हे। <verse eid="REV 2:2"/><verse number="3" style="v" sid="REV 2:3"/>तु दिर दिरेह, एने मार नावान केरता दुख वेठ वेठीन थाकील नाह, एने नाह पासाण फिरनु। <verse eid="REV 2:3"/><verse number="4" style="v" sid="REV 2:4"/>पुण माहु तार विरोद ज्यो केणु हे: तु तारो पेल्लो मोंग सोड़ दियेल हे। <verse eid="REV 2:4"/><verse number="5" style="v" sid="REV 2:5"/>तानकेरता तु कारीन पुड़ेल हे तान ईर किर, एने पाप केरने सोड़ीन पेल ने गेत काम किर। केदी तु पापा माय रेन मोन नाय फिरावहे, ताहार मी तुवा फाय आवीन तार दिवाह तान जागे रेन सिटो केर देह। <verse eid="REV 2:5"/><verse number="6" style="v" sid="REV 2:6"/>पुण होव, तुवा माय ज्यी वात हे काय नीकुलय ने कामाह तु नफरत किरेह, जाह मी बी नफरत केरथु।”<verse eid="REV 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 2:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">2:7 </char>
      <char style="xt" closed="false">
        <ref loc="REV 22:2">प्रकाशितवाक्य 22:2</ref>
      </char>
    </note>जान कान एय ता होमली लेय काय जीव मोंडलीह काय किथे!</para>
  <para style="p" vid="REV 2:7">जा जीत हासील केरी, ताह मी जीवणान जाड़ा माय रेन फोल खाणेन केरता पारवांगी आपुह, जो हेरगा माय बोगवानान बोगीचा माय हे।<verse eid="REV 2:7"/></para>
  <para style="s">समुरनान मोंडलीह खुबेर</para>
  <para style="p">
    <verse number="8" style="v" sid="REV 2:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">2:8 </char>
      <char style="xt" closed="false">
        <ref loc="REV 1:17">प्रकाशितवाक्य 1:17</ref>; <ref loc="REV 22:13">22:13</ref></char>
    </note>समुरना मायवाली मोंडलीह खुबेर पोचाड़नार हेरोगदुताह ज्यो लिख:</para>
  <para style="p" vid="REV 2:8">“जो पिल्लो एने सीवल्यो हे, एने जो मोर जायेल ईतो, एवी जीवतालो एय जायेल हे, तान केणु ज्यो हे। <verse eid="REV 2:8"/><verse number="9" style="v" sid="REV 2:9"/>मी तार दुखाह एने गेरीबीह जाणथु; पुण तु मालदार हे! एने जा माणहे सोताह यहुदि केतेह, पुण ता हेते नाह; एने तार विरोद माय जा खाराब वातु ता केरतेह ताह बी मी जाणथु; पुण सैतान ने सबा हेते! <verse eid="REV 2:9"/><verse number="10" style="v" sid="REV 2:10"/>जो दुख तुमूह वेठण्यो हे, ताहसे मा बिहो। हुमलो! सैतान तुमू माय रेन थोड़ाक माणहाह जेलीम कोंडणो हे, ताकाय तुमू पारखाय जाय एने तुमूह दोह दिह वोर दुख वेठणे पोड़ी। एने तुवाह मोरने पोड़ी तीबी बोरहा माय मोजबुत रे, ते मी तुवाह जित ने ईनाम जीवाय आपुह।<verse eid="REV 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 2:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">2:11 </char>
      <char style="xt" closed="false">
        <ref loc="REV 20:14">प्रकाशितवाक्य 20:14</ref>; <ref loc="REV 21:8">21:8</ref></char>
    </note>“जान कान एय ता होमली लेय काय जीव मोंडलीह काय किथे!</para>
  <para style="p" vid="REV 2:11">“जा जीत हासील केरी, ताह दुसरी मोती से नुकसान नाय पोची।”<verse eid="REV 2:11"/></para>
  <para style="s">पिरगमुन ने मोंडलीह खुबेर</para>
  <para style="p">
    <verse number="12" style="v" sid="REV 2:12"/>पिरगमुन मायवाली मोंडलीह खुबेर पोचाड़नार हेरोगदुताह ज्यो लिख:</para>
  <para style="p" vid="REV 2:12">जा फाय दुय दारान तेज तालवार हे, तो ज्यो किथे। <verse eid="REV 2:12"/><verse number="13" style="v" sid="REV 2:13"/>मी ज्यो जाणथु काय तुमू ता रेतेह जाहरो सैतान ने राजगादि हे। तुमू मार हेऱ्या खेरला हेते एने मार बुरहो केरने ता दिह्या माय पासाण नाह ईनो, जा माय मार विश्वासयोग्य गोवाह अन्तिपास तुमरी विचीम माराय गीयो, जा सैतान रिथे, तेवी बी तुमू माहु नाकार्‍या नाह। <verse eid="REV 2:13"/><verse number="14" style="v" sid="REV 2:14"/>पुण माहु तुमरी विरोद माय थोड्युक वातु केणु हे: तुमरी विची माय थोड़ाक माणहे ओहला हेते जा बिलाम ने हिकवोणान गेत चालतेह, जो बालाक राजाह ज्यो हिकाड़ेल ईतो काय इस्राएली माणहाह मुरतीह चेड़ावो चेड़ायेल खाणो खाय, एने सिनालो केरनेन द्‍वारा ताह पाप माय पाड़नेन आगवाय केरी। <verse eid="REV 2:14"/><verse number="15" style="v" sid="REV 2:15"/>तिहेस केरीन तुमरी विची माय थोड़ाक माणहे हेते जा नीकुलय ने हिकवोणा पोर चालतेह। <verse eid="REV 2:15"/><verse number="16" style="v" sid="REV 2:16"/>केरीन एवी तुमरा पापा माय रेन मोन फिरावो! नाहते मी जेल्दी आवीन मार मुयाम रेन निकेलनार तालवार केरीन ता हिऱ्यो लेड़ाय केरूह।<verse eid="REV 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 2:17"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">2:17 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 6:48-50">योहान 6:48-50</ref>
      </char>
    </note>जान कान एय ता होमली लेय काय जीव मोंडलीह काय किथे!</para>
  <para style="p" vid="REV 2:17">जा जीत हासील केरी, ताह मी लिकायेल मन्ना माय रेन खाणेन आपुह। एने ता माय रेन एकेकाह एक दुवल्यो दिगोड़ बी आपुह एने ता देगड़ा पोर एक नोवालो नाव लिखेल रेय, ता देगड़ाह लेणारा सिवाय कुणीस नाय जाणी।<verse eid="REV 2:17"/></para>
  <para style="s">थुआतीर ने मोंडलीह खुबेर</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 2:18"/>थुआतीरा मायवाली मोंडलीन खुबेर पोचाड़नार हेरोगदुताह ज्यो लिख:</para>
  <para style="p" vid="REV 2:18">बोगवानान बिटोख जान डोला आक्‍ठान आसीन गेत हेते, एने जान पाय हाजा पितलान गेत चोमेकता हेते, तो ज्यो किथे। <verse eid="REV 2:18"/><verse number="19" style="v" sid="REV 2:19"/>मी तुमरा काम, मोंग, बोरहाह, सेवा चाकरी एने दिराह जाणथु। एने मी ज्यो बी जाणथु काय तुमरा एवीन कामे जुनाला कामाह रेन वोड़ीन हेते। <verse eid="REV 2:19"/><verse number="20" style="v" sid="REV 2:20"/>पुण माहु तुमरी विरोद ज्यो केणु हे: तुमू इजेबेल नावान ती बायकुन वेठथे, जी सोताह बोगवानान खुबेर पोचाड़नार हे किथे। ती सोतान हिकवोण ने द्‍वारे मार सेवकाह सिनालो केरने एने मुरतीह चेड़ावो चेड़ायेल खाणो खाणेन केरता गेलेत आगवाय किरेह। <verse eid="REV 2:20"/><verse number="21" style="v" sid="REV 2:21"/>मी तीह पापा माय रेन मोन फिरावणेन केरता मुको आपेल, पुण ती सोता सिनालो केरने से मोन फिरावणे नाह हुदीत। <verse eid="REV 2:21"/><verse number="22" style="v" sid="REV 2:22"/>एने मी तीह पिड़ान खाटला पोर टाकण्यो हे। एने ताह बी जा ती हेऱ्या सिनाला माय बागी हेते, ताकाय ता ती टेम वोर पिड़ाह जेलती रेती; जाह वोर ता ती हेऱ्या किरेल तान खाराब कामान केरता मोन नाय फिरावे। <verse eid="REV 2:22"/><verse number="23" style="v" sid="REV 2:23"/>एने मी तीन आखा अनुयायीह मार देह, तेवी आखी मोंडली जाण जाय काय दिल एने मोनाह पारेखणार मीच हे। एने मी तुमू माय रेन एकेकाह तान कामान गेत बुदलो आपुह।<verse eid="REV 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 2:24"/>पुण मी थुआतीरान बाकी माणहाह, जा ज्यी खाराब हिकवोणाह नाह मानते एने ती वातुह जीह सैतानान उंडाल्यु वातु केतेह त्युह नाह हिकेल सोता। ज्यो केथु काय मी तुमू पोर उंजु होवटो वोजो नाय टाकुह। <verse eid="REV 2:24"/><verse number="25" style="v" sid="REV 2:25"/>पुण जो काय तुमू फाय हे, ताह मार पोशो आवणे वोर देरीन रिवो। <verse eid="REV 2:25"/><verse number="26" style="v" sid="REV 2:26"/>जा जीत हासील केरी, एने मार कामान गेतुच आखरी वोर केरतीच रेय, मी ताह तोच आदिकार आपुह, जो माहु मार आबाख फाय रेन जुड़ेल हे: <verse eid="REV 2:26"/><verse number="27" style="v" sid="REV 2:27"/>मी ताह देसा पोर आदिकार आपुह, ता लोखंडान राजडिंगो लेन राज केरती, एने माटड्यान ठामला गेत टुकड़ा केरीन तोड़ देय। <verse eid="REV 2:27"/><verse number="28" style="v" sid="REV 2:28"/>एने मी ताह विगोस ने तारो बी आपुह।<verse eid="REV 2:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="REV 2:29"/>जान कान एय, ता होमली लेय काय जीव मोंडलीह काय किथे!<verse eid="REV 2:29"/></para>
  <chapter eid="REV 2"/>
  <chapter number="3" style="c" sid="REV 3"/>
  <para style="s">सरदीस मायवाली मोंडलीह खुबेर</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 3:1"/>सरदीस मायवाली मोंडलीन खुबेर पोचाड़नार हेरोगदुताह ज्यो लिख:</para>
  <para style="p" vid="REV 3:1">जा फाय बोगवानान हात जीव एने हात तारा हेते। तो ज्यो किथे काय मी तार कामाह जाणथु; माणहान केणो हे काय तु जीवतालो हे, पुण खेरीच ते माय मुरेल हे! <verse eid="REV 3:1"/><verse number="2" style="v" sid="REV 3:2"/>केरीन जाग जा, एने त्युह मोजबुत किर ज्‍यु बाकी हेत्यु ज्यान पेल काय त्यु मोर जाय। काहाकाय मी तुमरा काल्ला बी कामाह बोगवानान नेजरी माय पुरो नाह दिख्यो। <verse eid="REV 3:2"/><verse number="3" style="v" sid="REV 3:3"/><note caller="+" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="MAT 24:43">मत्ती 24:43</ref>,<ref loc="MAT 24:44">44</ref>; <ref loc="LUK 12:39">लुका 12:39</ref>,<ref loc="LUK 12:40">40</ref>; <ref loc="REV 16:15">प्रकाशितवाक्य 16:15</ref></char></note>तानकेरता ईर किर काय तु कोहली हिकवोण हिकेल एने होमलेल ईतो; एने तान पालेन किर एने पापा माय रेन मोन फिराव। केदी तु जागही नाय, एने मी चोर जिहकेरीन आवणे तिहकेरीन आव जाह, एने तु केदी बी जाण नाय सिकहे काय मी काल्ली टेम तार फाय आव जाह। <verse eid="REV 3:3"/><verse number="4" style="v" sid="REV 3:4"/>पुण सरदीस माय तुमरी फाय थोड़ाक माणहे ओहला बी हेते जा तान फाड़काह एठा नाह केऱ्या। ता दोवल्या फाड़का पेरीन मार हेऱ्या फिरती, काहाकाय ता ज्यी लायकीन हेते। <verse eid="REV 3:4"/><verse number="5" style="v" sid="REV 3:5"/><note caller="+" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="REV 20:12">प्रकाशितवाक्य 20:12</ref>; </char><char style="xt" closed="false"><ref loc="MAT 10:32">मत्ती 10:32</ref>; <ref loc="LUK 12:8">लुका 12:8</ref></char></note>जा जीत हासील केरी, ताह इहीचकेरीन दोवल्या फाड़का पेराय जाती, एने मी तान नाव जीवणान पुस्तेक माय रेन नाय खेडुह। पुण तान नाव मार आबाख ने एने तान हेरोगदुतान सामने खुल्लो गोसीत केरूह काय ता मारा हेते।<verse eid="REV 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 3:6"/>जान कान एय, ता होमली लेय काय जीव मोंडलीह काय किथे!<verse eid="REV 3:6"/></para>
  <para style="s">फिलादिलफियान मोंडलीह खुबेर</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 3:7"/>फिलादिलफिया मायवाली मोंडलीह खुबेर पोचाड़नार हेरोगदुताह ज्यो लिख:</para>
  <para style="p" vid="REV 3:7">“जो चोखालो एने खीरलो हे, एने जो दाऊदान कुची मिलेह। एने जा बायणाह तो उगाड़ेह ताह कुण बी बोंद नाह केर सिकेत, एने जाह तो बोंद किरेह ताह कुण बी उगाड़ नाह सिकेत, तो ज्यो किथे। <verse eid="REV 3:7"/><verse number="8" style="v" sid="REV 3:8"/>मी तुमरा कामाह जाणथु; दिखो, मी तुमरी ओंगाण एक बायणो उगाड़ मीलेल हे, जाह कुण बी बोंद नाय केर सेकी। मी जाणथु काय तार ताकेत कोमी हे, एने तुमू मार हिकवोण ने पालेन किरेल हेते, एने तुमू बोरहावाला बोणीन रेना। <verse eid="REV 3:8"/><verse number="9" style="v" sid="REV 3:9"/>दिखो! सैतान ने सबा एने जा सोताह यहुदि केतेह, पुण ता हेते नाह, एने ता जुठ बोलतेह। मी ताह मोजबुर केर देह काय ता तुमरा पाया पोड़ती, एने जाणती काय मी तुमूह मोंग किरेल हे। <verse eid="REV 3:9"/><verse number="10" style="v" sid="REV 3:10"/>काहाकाय तुमू दिर हेऱ्या मार सेहणेन आदेसाह मानील हेते, एने मी बी तुमूह सताव एणेन टेम माय तुमूह वोचाड़ीन मेलुह, जो जी देरती पोर रेणाराह पारेखणेन केरता आखी दुनिया पोर आवणेवालो हे। <verse eid="REV 3:10"/><verse number="11" style="v" sid="REV 3:11"/>मी उचकाहुच आवण्यो हे। जो काय तुमू फाय हे ता माय बोणीन रिवो, काय एगदो तुमरो जित ने ईनाम तुमू फाय रेन सांडाड़ नाय लेय। <verse eid="REV 3:11"/><verse number="12" style="v" sid="REV 3:12"/><note caller="+" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="REV 21:2">प्रकाशितवाक्य 21:2</ref></char></note>जा जिक जाती ताह मी बोगवानान मोंदिर ने एक खाम बाणावुह, तो पोशो केदी बी मोंदिर ने बाहेर नाय जाय। एने मी ता पोर मार बोगवान ने नाव एने मार बोगवान ने हेयरान नाव नोवालो यरूशलेम लेखुह, जो मार बोगवान ने हेरगान उगे रेन नेचो उतरी, एने मी ता पोर मार नोवालो नाव लेखुह।<verse eid="REV 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 3:13"/>“जान कान एय, ता होमली लेय काय जीव मोंडलीह काय किथे।”<verse eid="REV 3:13"/></para>
  <para style="s">लोदिकियान मोंडलीह खुबेर</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 3:14"/>लोदिकिया मायवाली मोंडलीन खुबेर पोचाड़नार हेरोगदुताह ज्यो लिख:</para>
  <para style="p" vid="REV 3:14">“जो आमेन, बोरहावालो एने खीरलो गोवाह हे, एने बोगवानान बाणावोट ने आदिकारी हे, तो ज्यो किथे।<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="ft" closed="false">मुल; नाहते आदिकारी।</char></note> <verse eid="REV 3:14"/><verse number="15" style="v" sid="REV 3:15"/>मी तार कामाह जाणथु काय तु नाहते ठेंडो हे नाह गेरेम। हाजो एतो काय तु ठेंडो नाहते गेरेम रितो। <verse eid="REV 3:15"/><verse number="16" style="v" sid="REV 3:16"/>तानकेरता तु गुनगुना हे, एने नाह ठेंडो नाह गेरेम हे, मी तुवाह मार मुयाम रेन उगालने जाणे बाजरिनोह! <verse eid="REV 3:16"/><verse number="17" style="v" sid="REV 3:17"/>तु किथे, ‘मी मालदार हे एने मालदार एय जायेल हे; एने मार फाय आखो काय हे, एने माहु काल्ली बी वोस्तुन कोमी नाह सोती।’ पुण तु ज्यो नाह जाणेत काय तु दुखी, खाराब, गेरीब, आंदलो एने नांगेरलो हे। <verse eid="REV 3:17"/><verse number="18" style="v" sid="REV 3:18"/>केरीन मी तुवाह सलाह आपथु काय तु माहु फाय रेन चोखो होनो वेचातो लीय ली काय तु मालदार बोण जाही, एने दोवल्या फाड़का लेन पिर काय तारो नांगेरलान लाज ढापाय जाय। एने तार डोला माय लागाड़नेन केरता सुरमो लीय ली काय तु हास केरीन देख सेकी। <verse eid="REV 3:18"/><verse number="19" style="v" sid="REV 3:19"/><note caller="+" style="x"><char style="xo" closed="false">3:19 </char><char style="xt" closed="false"><ref loc="HEB 12:6">इब्रानियो 12:6</ref></char></note>मी जाह मोंग केरथु, ताह दोपकावथु एने चित्रो बाणावथु। तानकेरता जोसीला बुणो, एने पापा माय रेन मोन फिराव। <verse eid="REV 3:19"/><verse number="20" style="v" sid="REV 3:20"/>दिखो! मी बायणा हिऱ्यो उबरीन ठोकथु; केदी एगदो मार आवाज होमलीन बायणो उगाड़ी, ते मी ता फाय माय आवीन ता हिऱ्यो खाणो खाह, एने तो मार हेऱ्यो। <verse eid="REV 3:20"/><verse number="21" style="v" sid="REV 3:21"/>जा जीत हासील केरी ताह मी मार हिऱ्यो मार राजगादि पोर बोहणेन आदिकार आपुह, जिहकेरीन मी बी जीत हासील केरीन मार आबाख हिऱ्यो राजगादि पोर बोह रिनोह।<verse eid="REV 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 3:22"/>“जान कान एय, ता होमली लेय काय जीव मोंडलीह काय किथे!”<verse eid="REV 3:22"/></para>
  <chapter eid="REV 3"/>
  <chapter number="4" style="c" sid="REV 4"/>
  <para style="s">हेरगा माय आरादना</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 4:1"/>ज्यी वातुन पासाण मी उपेर दिख्यो काय हेरगा माय एक बायणो उगड़ी रेनोह, एने मी पेल पावलीन गेत आवाज होमलेल ईतो, तो माहु केयो, “न्या उपेर आव; मी तुवाह ती वातु देखाडुह, जाह जी वातुन ओंगाण एणे जोरवरी हे।” <verse eid="REV 4:1"/><verse number="2" style="v" sid="REV 4:2"/>पुशो मी तुलेचबूखी चोखाला जीवा माय बोराय गीयो। एने मार ओंगाण हेरगा माय एक राजगादि मील रियेल देख्यो एने ती राजगादि पोर कुण तीबी बोह रियेल एतो। <verse eid="REV 4:2"/><verse number="3" style="v" sid="REV 4:3"/>जो ती राजगादि पोर बोह रियेल ईतो तो यशब एने माणिक्यन देगड़ान गेत देखातालो, एने राजगादिन कावदेन चोमेकतालान गेत एक मेग दनुष्य देखातालो। <verse eid="REV 4:3"/><verse number="4" style="v" sid="REV 4:4"/>ती राजगादिन कावदेन चोववीस राजगादि उंजु एत्यु, त्यु राजगादि पोर मी चोववीस डावाला माणहाह दोवल्या फाड़का पेरीन बोह रियेल एता, जा मुंडा पोर होनान मुकूट पिर रियेल एता। <verse eid="REV 4:4"/><verse number="5" style="v" sid="REV 4:5"/><note caller="+" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="REV 8:5">प्रकाशितवाक्य 8:5</ref>; <ref loc="REV 11:19">11:19</ref>; <ref loc="REV 16:18">16:18</ref>; </char><char style="xt" closed="false"><ref loc="REV 1:4">प्रकाशितवाक्य 1:4</ref></char></note>त्यु राजगादि माय रेन विजेलनेन चोमेक एने वादलान गाजणो निकेलतालो, एने राजगादिन ओंगाण उजालो आपणार हात बोला पेटणे बाजरियेल एता, ता बोगवानान हात जीव हेते। <verse eid="REV 4:5"/><verse number="6" style="v" sid="REV 4:6"/>एने राजगादिन ओंगाण चोमेकताला सिसान गेत दोवल्यो देरीयो पोसरी रियेल ईतो,</para>
  <para style="p" vid="REV 4:6">राजगादिन विचीम एने चार चोमखीर चार जेनवेरे एता, तान ओंगाण पासाण डोलाच डोला एता। <verse eid="REV 4:6"/><verse number="7" style="v" sid="REV 4:7"/>पेल्लो जेनवेर सिहान गेत एतो; एने दुसरो जेनवेर बोयलान गेत एतो; तीसरा जेनवेरान मुय माणहान गेत एतो; चोवथो जेनवेर उड़ताला मोराग्यान गेत एतो। <verse eid="REV 4:7"/><verse number="8" style="v" sid="REV 4:8"/>ता चार बी जेनवेरान सोव सोव फाक एता, एने चार उगे एने माय डोलाच डोला एता। ता दिह ने रात ज्यो केणेन नाह थाकताला:</para>
  <para style="q2" vid="REV 4:8">“चोखालो, चोखालो, चोखालो मालीक बोगवान, आखा रेन ताकेतवालो,</para>
  <para style="q1" vid="REV 4:8">जो ईतो, एने जो हे, एने जो आवण्यो हे।”<verse eid="REV 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 4:9"/>जेवी ता जेनवेर तान जो राजगादि पोर बोह रियेल ईतो, एने जो कायेम वोर जीवतालो हे, बोड़ाय एने मान सम्मान एने दन्यवाद केरताला, <verse eid="REV 4:9"/><verse number="10" style="v" sid="REV 4:10"/>तेवी ता चोववीस डावाला माणहे जो राजगादि पोर बोह रियेल ईतो, तान ओंगाण पाया पोड़ीन तो कायेम जीवतालो रेणारान आरादना केरतेह, ता राजगादिन ओंगाण जान तान मुकूट ज्यो कितेन टाक देना:<verse eid="REV 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 4:11"/>“एय आमरा मालीक एने बोगवान! तुच बोड़ाय, मान पान, एने ताकेत ने बाराबोर हे;</para>
  <para style="q2" vid="REV 4:11">काहाकाय तुच आखी वोस्तुह बाणायेल हे,</para>
  <para style="q1" vid="REV 4:11">एने तारीच मोरजी माय, खेरीच आयेल एती,</para>
  <para style="q2" vid="REV 4:11">एने ती एवी जीवताली हे।”<verse eid="REV 4:11"/></para>
  <chapter eid="REV 4"/>
  <chapter number="5" style="c" sid="REV 5"/>
  <para style="s">गुंडालील पुस्तेक एने मेंड्रो</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 5:1"/>जो राजगादि पोर बोह रियेल ईतो, तान जेवड्या आथाम मी एक पुस्तेक दिख्यो; जान माय एने बाहेर लिखेल एतो, एने तीह हात सिक्‍का लागाड़ीन बोंद किरेल एतो। <verse eid="REV 5:1"/><verse number="2" style="v" sid="REV 5:2"/>एने मी एक ताकेतवाला हेरोगदुताह दिख्यो। जो जोरेस आयड़ीन गोसणा केरने बाजरियेल ईतो, “ज्या गुंडालील पुस्तेक ने सिक्काह तोड़ने एने ताह उगाड़नेन ताकेतवालो कुण हे?” <verse eid="REV 5:2"/><verse number="3" style="v" sid="REV 5:3"/><note caller="+" style="f"><char style="fr" closed="false">5:3 </char><char style="ft" closed="false">देरतीन बुंदेन दुनिया; मुरेल माणहान दुनिया।</char></note>पुण नाह हेरगा माय, नाह देरती पोर, नाह देरतीन नेचो कुण ता पुस्तेकाह उगाड़ने एने ता पुस्तेक माय काय हे देखणेन ताकेत मेलनार कुणीस नाह एतो। <verse eid="REV 5:3"/><verse number="4" style="v" sid="REV 5:4"/>तेवी मी उहकी उहकीन रेड़ने बाज गीयो, काहाकाय ता पुस्तेकाह उगाड़ने एने ता माय जो लिखेल एतो ताह देखणेन लायकीन कुण नाह जुड़नो। <verse eid="REV 5:4"/><verse number="5" style="v" sid="REV 5:5"/>तेवी डावाला माणहा माय रेन एक जाण माहु केयो, “रेड़ी मा। एने देख! यहुदान गेराणान तो सिहो जो दाऊदान वोस हे, ता हात सिक्‍का तोड़ने एने गुंडालीन पुस्तेकाह उगाड़ने केरता ताकेवालो ईयेल हे।”<verse eid="REV 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 5:6"/>तेवी मी दिखो मेंड्रो राजगादिन विची माय उबरेनोह, एने चार जेनवेराह एने डायला माणहा से गेराय रिनोह। तो ओहलो देखातालो काय ताह मारील हे। ताह हात हिंगे एने हात डोला एता, जा बोगवानान हात जीव हेते, जाह आखी देरती पोर मोकलील एतो। <verse eid="REV 5:6"/><verse number="7" style="v" sid="REV 5:7"/>तेवी मेंड्रो जाईन राजगादि पोर जो बोह रियेल ईतो, तान जेवड्या आथाम रेन ता पुस्तेकाह लीय लिदो। <verse eid="REV 5:7"/><verse number="8" style="v" sid="REV 5:8"/>तो ता पुस्तेकाह लिदो तेवी ता चार जेनवेरे एने चोववीस डायला माणहे ता मेंड्रान पाया पोड़ना। ता आखा डायला फाय रेणथो एने ईंगाला माय बोरायेल होनान वाटका एता, त्यु बोगवानान माणहान विन्ता हेत्यु। <verse eid="REV 5:8"/><verse number="9" style="v" sid="REV 5:9"/>ता एक नोवालो गीत गावणे बाजरियेल एता:</para>
  <para style="q1" vid="REV 5:9">“तु ज्या पुस्तेकाह लेणे, एने ज्या पोर लागेल सिक्काह तोड़नेन लायकीन हे।</para>
  <para style="q1" vid="REV 5:9">काहाकाय तुवाह बोलीन रूप माय मार दियेल एतो, एने ताच ने द्‍वारा तु बोगवानान</para>
  <para style="q2" vid="REV 5:9">माणहाह एकेक जाती, बाषा, एने आखी वोस से देसाह वेचातो लेन सोड़ेव लियेल हे,<verse eid="REV 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 5:10"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">5:10 </char>
      <char style="xt" closed="false">
        <ref loc="REV 1:6">प्रकाशितवाक्य 1:6</ref>
      </char>
    </note>ताह आमरा बोगवानान सेवा केरनेन केरता राज एने चाकर्‍यो बाणायेल हे,</para>
  <para style="q2" vid="REV 5:10">एने ता देरती पोर राज केरती।”<verse eid="REV 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 5:11"/>पुशो मी दिख्यो, एने एजार एने लाखो हेरोगदुतान आवाज होमल्यो, ता राजगादि एने ता चार जेनवेरान एने ता डायला माणहान चार उगे उबरियेल एता। <verse eid="REV 5:11"/><verse number="12" style="v" sid="REV 5:12"/>एने ता मोठेस आयड़ीन ज्यो गीत गावणे बाजरियेल एता:</para>
  <para style="q1" vid="REV 5:12">“तो मेंड्रो जो माराय जायेल एतो,</para>
  <para style="q2" vid="REV 5:12">ताकेत, देन, इकेल, आदिकार,</para>
  <para style="q2" vid="REV 5:12">मान सम्मान, बोड़ाय, एने स्तुतीन लायेक हे!”<verse eid="REV 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 5:13"/>एने हेरगाम, देरती पोर, देरतीन नेचो एने देरीयाम जा आखी वोस्तुह, एने आखो जो काय ता माय हे, ज्यो गावतीन होमल्यो:</para>
  <para style="q1" vid="REV 5:13">“जो राजगादि पोर बोह रिनोह तान एने मेंड्रान स्तुती,</para>
  <para style="q2" vid="REV 5:13">एने मान सम्मान, बोड़ाय, एने ताकेत कायेम रेय!”<verse eid="REV 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 5:14"/>तेवी ता चार जेनवेरे केया, “आमेन!” एने डावाला माणहे पाया पोड़ीन आरादना केऱ्या।<verse eid="REV 5:14"/></para>
  <chapter eid="REV 5"/>
  <chapter number="6" style="c" sid="REV 6"/>
  <para style="s">सिक्को</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 6:1"/>ओवतो मेंड्रो हात सिक्‍का माय रेन एक सिक्काह उगाड्यो, एने ता चार जेनवेराम रेन एकाह वादलान गाजणेन गेत आवाज किरतेन होमल्यो, “आव!” <verse eid="REV 6:1"/><verse number="2" style="v" sid="REV 6:2"/>जेवी मी दिख्यो, तेवी एक दुवल्यो गुड़ो देखानो। एने जो ता गोड़ा पोर बोह रियेल ईतो ता फाय एक दोंदली एती, एने ताह एक मुकूट आपायेल एतो। तो जिकील ने गेत जीत हासील केरनेन केरता निकेलनो काय जीत हासील केरी।<verse eid="REV 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 6:3"/>जेवी मेंड्रो दुसरा सिक्काह उगाड्यो, तेवी मी दुसरा जेनवेराह ज्यो कितेन होमल्यो, “आव!” <verse eid="REV 6:3"/><verse number="4" style="v" sid="REV 6:4"/>तेवी रातला रेंगान एक गुड़ो आवो, ता गोड़ा पोर बोहणाराह ज्यी सेक्ती आपेल एतो काय देरती पोर रेन सान्ती विस लेय, ताकाय माणहे एका दिहराह मारी। एने ताह एक मोटली तालवार आपेल एती।<verse eid="REV 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 6:5"/>जेवी मेंड्रो तीसरा सिक्काह उगाड्यो, तीबी मी तीसरा जेनवेराह ज्यो कितेन होमल्यो, “आव!” तेवी मी दिख्यो, ते एक काल्लो गुड़ो देखानो। ता गोड़ा पोर बोहणारान आथा माय एक ताकड़ो एतो। <verse eid="REV 6:5"/><verse number="6" style="v" sid="REV 6:6"/>एने मी ता चार जेनवेरान विची माय रेन एक आवाज ज्यो कितेन होमल्यो, “एक दिह्यान मोंजरीन बोदले एक दिह खाणेन केरता हेरबोर गोव, एने एक दिह्यान मोंजरीन बोदले तीन हेरबोर जुवार। पुण जेतुन ने जाड़ाह एने अंगुरान वाड़ीह नुकसान मा पोचाड़हे!”<verse eid="REV 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 6:7"/>जेवी मेंड्रो चोवथा सिक्काह उगाड्यो, तेवी मी चोवथा जिवताला जेनवेराह ज्यो कितेन होमल्यो, “आव!” <verse eid="REV 6:7"/><verse number="8" style="v" sid="REV 6:8"/><note caller="+" style="f"><char style="fr" closed="false">6:8 </char><char style="ft" closed="false">मुरेल माणहान दुनिया;</char></note>जेवी मी दिख्यो, तेवी माहु ता एक मुरेल ने गेत पेल्ला रेंगान गुड़ो देखानो। ता गोड़ा पोर बोहणारान नाव मोत हे, एने आंदारकेली तान पासाण पासाण जाणे बाजरियेल एती। ताह ज्यो आदिकार आपेल एतो काय काल पाड़ी, बेमारी लागाड़ी, एने देरतीन जेंगली जेनवेरा केरीन माणहाह मार टाकी।<verse eid="REV 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 6:9"/>जेवी मेंड्रो पाचवा सिक्काह उगाड्यो, ते मी वेदीन नेचो ता माणहान जीव दिख्यो। बोगवानान वचन ने पारचार केरनेन कारीन एने तान गोवाय माय विश्वासयोग्य रेणेन कारेण जा ता कियेल एता, तान वोजेसे माराय जायेल एता। <verse eid="REV 6:9"/><verse number="10" style="v" sid="REV 6:10"/>ता मोठेस आयड़ीन केया, “एय ताकेतवाला मालीक, चोखालो एने खीरलो बोगवान हे! तु काह वोर नियाव नाय किरहे, एने केदीह वोर देरती पोर रेणारा माणहा फाय रेन आमरा खुन ने बुदलो नियाव लिहे?” <verse eid="REV 6:10"/><verse number="11" style="v" sid="REV 6:11"/>ता माय रेन एकेकाह दोवल्या फाड़का आपाय गीया, एने ताह कियेल, थोड़ीक वार वोर आराम किरो, जाह वोर काय तुमरा मसी मायवाला हाती सेवक एने बुरहो केरनारा बाय बोणहा मोरनेन गेणती पुरी नाय एय जाय, जा तुमरी गेत माराण्या हेते।<verse eid="REV 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 6:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:12 </char>
      <char style="xt" closed="false">
        <ref loc="REV 11:13">प्रकाशितवाक्य 11:13</ref>; <ref loc="REV 16:18">16:18</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:29">मत्ती 24:29</ref>; <ref loc="MRK 13:24">मरकुस 13:24</ref>,<ref loc="MRK 13:25">25</ref>; <ref loc="LUK 21:25">लुका 21:25</ref></char>
    </note>जेवी मी मेंड्राह साहवा सिक्काह उगाड़तालो दिख्यो। तेवी देरती फाटनी एनो, एने दिह कामल्यान गेत काल्लो, एने चांद लुय ने गेत रातलो एय गीयो। <verse eid="REV 6:12"/><verse number="13" style="v" sid="REV 6:13"/>जुगा वाला तारा देरती पोर इहकेरीन पोड़ गीया, जिहकेरीन मोटलो वादोण आवणे से अंजीरान कोवला फोल पोड़ जातेह। <verse eid="REV 6:13"/><verse number="14" style="v" sid="REV 6:14"/><note caller="+" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="REV 16:20">प्रकाशितवाक्य 16:20</ref></char></note>जुग फाटीन चेटायीन गेत गुंडलाय गीयो, एने एकेक बुयड़ो एने टापु तान जागे रेन सेटा केराय गीया। <verse eid="REV 6:14"/><verse number="15" style="v" sid="REV 6:15"/>तेवी देरतीन राजा, मुखी, आदिकारी, मालदार, ताकेतवाला एने एकेक पावोर एने एकेक आजाद माणुह बोयड़ान गुफा माय एने मोटला देगड़ान बुंदे जाईन लिकाना। <verse eid="REV 6:15"/><verse number="16" style="v" sid="REV 6:16"/><note caller="+" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="LUK 23:30">लुका 23:30</ref></char></note>ता बोयड़ाह एने मोटला देगड़ाह ज्यो केणे बाज गीया, “आमरी उपेर पोड़ जावो एने आमुह तान नेजरी माय रेन वोचाड़ो जो राजगादि पोर बोह रिनोह, एने मेंड्रान रागाह रेन लीकाड़ लिवो! <verse eid="REV 6:16"/><verse number="17" style="v" sid="REV 6:17"/>काहाकाय तान रागान बिय आवी ओहलो दिह आव लागेल हे, एने ओहलो कुण हे जो तान सामनो केर सिकेह?”<verse eid="REV 6:17"/></para>
  <chapter eid="REV 6"/>
  <chapter number="7" style="c" sid="REV 7"/>
  <para style="s">इस्राएल ने एक लाख चोवरेचाड़ीस एजार माणहे</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 7:1"/>ज्यान पासाण मी चार हेरोगदुताह देरतीन चार उगे उबरियेल दिख्यो, ता देरतीन चार उगीन वाराह रूक रियेल एता काय देरती, देरीया एने काल्ला बी जाड़ा पोर वारो नाय चाली। <verse eid="REV 7:1"/><verse number="2" style="v" sid="REV 7:2"/>पुशो मी दुसरा एक हेरोगदुताह उगेवणे रेन उपेर आवतालो दिख्यो, ता फाय जीवताला बोगवानान सिक्को ईतो। एने जा चार हेरोगदुता फाय देरतीह एने देरीयाह नुकसान केरनेन आदिकार आपेल ईतो। मोठेस आयड़ीन केयो, <verse eid="REV 7:2"/><verse number="3" style="v" sid="REV 7:3"/>“आमरा बोगवान ने जा पावोर हेते, तान निंडाला पोर साप लागाड़ नाय देव, ताह वोर देरतीह, देरीयाह एने जाड़ाह नुकसान मा किरहे।” <verse eid="REV 7:3"/><verse number="4" style="v" sid="REV 7:4"/>एने जा पोर बोगवानान साप लागाड़नेन आवो तान गेणती मी होमल्यो, इस्राएली माणहान आखा गेराणा माय एक लाख चोवरेचाड़ीस एजार माणहे एता। <verse eid="REV 7:4"/><verse number="5" style="v" sid="REV 7:5"/>एकेक गेराणान बारा एजार माणहा पोर साप लागाड़नेन आवो, यहुदा, रूबेन, गाद, <verse eid="REV 7:5"/><verse number="6" style="v" sid="REV 7:6"/>आशेर, नप्ताली, मनशी, <verse eid="REV 7:6"/><verse number="7" style="v" sid="REV 7:7"/>शमोन, लेवी, इस्साकार, <verse eid="REV 7:7"/><verse number="8" style="v" sid="REV 7:8"/>जबुलून, युसूफ, बिन्यामीन।<verse eid="REV 7:8"/></para>
  <para style="s">एक मोटली माणहान गेरदी</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 7:9"/>ज्यान पासाण माहु एक गेणाय नाय ओहली माणहान मोटली गेरदी देखानी, ज्या माणहे एकेक देस, गेराणो, जाती एने आलेग आलेग बाषा बोलने वाला एता, ता माणहे राजगादि एने मेंड्रान ओंगाण दोवल्या फाड़का पेरीन आथा माय खजुर ने डालख्यु लेन उबरियेल एता। <verse eid="REV 7:9"/><verse number="10" style="v" sid="REV 7:10"/>एने ता माणहे मोठेस आयड़ीन केताला:</para>
  <para style="p" vid="REV 7:10">“राजगादि पोर बोह रियेल आमरा बोगवान, एने मेंड्रान उगे रेन सुटकारो हे!” <verse eid="REV 7:10"/><verse number="11" style="v" sid="REV 7:11"/>तेवी राजगादिन एने डावाला माणहान, एने चार जेनवेरान कावदेन आखा हेरोगदुत उबरियेल एता। ता राजगादिन ओंगाण उबड़ा पोड़ीन बोगवानान आरादना केऱ्या, <verse eid="REV 7:11"/><verse number="12" style="v" sid="REV 7:12"/>एने केया, “आमेन! स्तुती, बोड़ाय, इकेल, दन्यवाद, मान सम्मान, ताकेत एने सेक्ती कायेम आमरा बोगवानान हे! आमेन!”<verse eid="REV 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 7:13"/>ज्यान पासाण डावाला माणहा माय रेन एक माहु फुशो, “ज्या दोवल्या फाड़का पेरनारे माणहे कुण हेते, एने का रेन आयेल हेते?”<verse eid="REV 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 7:14"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">7:14 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:21">मत्ती 24:21</ref>; <ref loc="MRK 13:19">मरकुस 13:19</ref></char>
    </note>मी ताह जापाप आप्यो, “एय मालीक, ज्यो ते तुस जाणेह।”</para>
  <para style="p" vid="REV 7:14">तो माहु केयो, “ज्या ता माणहे हेते, जा मोटली तेकलीत माय रेन निकलीन आयेल हेते, एने ज्या सोतान फाड़काह मेंड्रान लुय केरीन दोवीन दोवल्या किरेल हेते। <verse eid="REV 7:14"/><verse number="15" style="v" sid="REV 7:15"/>केरीन ज्या बोगवानान राजगादिन ओंगाण हेते, एने बोगवानान मोंदिर माय रात दिह तान सेवा चाकरी केरतेह। तो जो राजगादि पोर बोह रिनोह, तो खुद तान राखवाली केरी। <verse eid="REV 7:15"/><verse number="16" style="v" sid="REV 7:16"/>ता पोशा केदी बुखल्या एने तीहल्या नाय रेती; एने नाह ते दिह एने नाह दोप ताह हेलगाड़ सेकी। <verse eid="REV 7:16"/><verse number="17" style="v" sid="REV 7:17"/>काहाकाय मेंड्रो जो राजगादिन विची माय हे, तो तान गोवाल बोणी, एने ताह जीवाय आपणार पाण्यान जिरा हिऱ्यो ली जाया केरी। एने बोगवान तान डोलान आखा आहवाह नुस देय।”<verse eid="REV 7:17"/></para>
  <chapter eid="REV 7"/>
  <chapter number="8" style="c" sid="REV 8"/>
  <para style="s">हातवो सिक्को</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 8:1"/>जेवी मेंड्रो हातवा सिक्काह उगाड्यो, ते हेरगा माय आरदो गीन्टो वोर सांत वातावरण एय गीयो। <verse eid="REV 8:1"/><verse number="2" style="v" sid="REV 8:2"/>तेवी बोगवानान ओंगाण उबरियेल हात हेरोगदुताह मी दिख्यो, ताह हात पावली आपाय जायेल एती।<verse eid="REV 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 8:3"/>पुशो एक हेरोगदुत होनान दुपदान लेन आवो, एने वेदी पोर उबरेय गीयो। ताह जुलूम दुप आपेल काय आखा बोगवानान माणहान विन्ता हेऱ्यो होनान ती वेदी पोर चेड़ावी, जी राजगादिन ओंगाण हे। <verse eid="REV 8:3"/><verse number="4" style="v" sid="REV 8:4"/>एने दुप ने दुवाड़ो बोगवानान माणहान विन्ता हेऱ्यो हेरोगदुत ने आथा केरीन बोगवानान ओंगाण पोच गीयो। <verse eid="REV 8:4"/><verse number="5" style="v" sid="REV 8:5"/><note caller="+" style="x"><char style="xo" closed="false">8:5 </char><char style="xt" closed="false"><ref loc="REV 11:19">प्रकाशितवाक्य 11:19</ref>; <ref loc="REV 16:18">16:18</ref></char></note>ओवतो हेरोगदुत ता दुपदानाह विस्यो एने ताह वेदीन आक्‍ठा केरीन बुऱ्यो, एने देरती पोर टाग दिनो। जाहसे वादलान माय गाजणे, मोटलो आवाज, विजेलनेन चोमेक एने बुकम्प एणे बाज गीयो।<verse eid="REV 8:5"/></para>
  <para style="s">हात पावल्यु</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 8:6"/>तेवी ता हात हेरोगदुत जा फाय हात पावल्यु एत्यु, त्युह फुकणेन केरता तियार एना।<verse eid="REV 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 8:7"/>पेल्लो हेरोगदुत तान पावलीह फुक्यो। लुय माय मिलायेल बोरफो एने आक्‍ठो देरती पोर पोड़ने बाज गीयो। ज्यान वोजेसे देरतीन एक बाग हेलगी गीयो, उंजु जाड़ान एक बाग हेलगी गीयो, एने आखो निल्लो खेड़ बी रोखड़ो एय गीयो।<verse eid="REV 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 8:8"/>ओवतो दुसरो हेरोगदुत तान पावलीह फुक्यो। ते आक्‍ठान गेत हेलेगतालो एक मोटला बोयड़ान गेत देरीया माय टाकाय गीयो। ज्यान वोजेसे देरीयान एक बाग लुय माय बोदेल गीयो। <verse eid="REV 8:8"/><verse number="9" style="v" sid="REV 8:9"/>एने एक बाग देरीयान जेनवेरे मोर गीया, एने एक बाग डोंडह्या खेतेम एय गीया।<verse eid="REV 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 8:10"/>ओवतो तीसरो हेरोगदुत तान पावलीह फुक्यो। एक मुठलो तारो बोलान गेत हेलेगतेन जुगाम रेन निचो पुड़नो, एने एक बाग नेदी माय एने जोवरान पाण्या पोर जाय पोड़नो। <verse eid="REV 8:10"/><verse number="11" style="v" sid="REV 8:11"/>ता तारान नाव “कोड़वो” हे। एने एक बाग पाणी कोड़वो एय गीयो, एने जुलूम होवटा माणहे ज्या पाण्याह पिणेन कारेण मोर गीया, काहाकाय पाणी कोड़वो एतो।<verse eid="REV 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 8:12"/>जेवी चोवथो हेरोगदुत तान पावलीह फुक्यो। तेवी एक बाग दिह एने एक बाग चांद एने एक बाग तारा पोर बी तेकलीत आवी, ज्यानकेरीन ता तान एक बाग उजालो गोमाड़ देना; ज्यो एनो काय एक बाग दिह एने एक बाग रात आंदारा माय बुड़ गियी।<verse eid="REV 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 8:13"/>जेवी मी पुशो दिख्यो, ते जुगान विची माय एक मोराग्याह उड़ती एने मोठास आवाज माय ज्यो कितेन होमल्यो, “ता तीन हेरोगदुत ने पावलीन आवाज ने वोजेसे। जान फुकणे एवी बाकी हे, देरती पोर रेणारा पोर हाय, हाय, हाय!”<verse eid="REV 8:13"/></para>
  <chapter eid="REV 8"/>
  <chapter number="9" style="c" sid="REV 9"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 9:1"/>जेवी पाचवो हेरोगदुत तान पावलीह फुक्यो, ते मी हेरगाम रेन एक तारो देरती पोर पोड़तालो दिख्यो, एने ताह नेरेग कुंड ने कुची आपाय गियी।<note caller="+" style="f"><char style="fr" closed="false">9:1 </char><char style="ft" closed="false">उंडालो खाडो; जान बुय नाय देखाय उहलो खाडो, मापाय नाय उहलो खाडो। ओहलो मानतेह काय आखरी डेंड एणे वोर खाराब जीव देरतीन उंडाले जागे बांदाय जाताली। </char></note> <verse eid="REV 9:1"/><verse number="2" style="v" sid="REV 9:2"/>ओवतो तो हेरोगदुत नेरेग कुंडाह ती कुची केरीन उगाड़ दिनो, एने ता कुंड माय रेन ओहलो दुवाड़ो निकेलने बाजरियेल एतो, जिहकेरीन काय एक मोटली बाठी माय रेन दुवाड़ो निकेलने; एने ता कुंड माय रेन निकलेल दुवाड़ा केरीन दिह एने वारो कालो एय गीयो। <verse eid="REV 9:2"/><verse number="3" style="v" sid="REV 9:3"/>ता दुवाड़ा माय रेन टिड्या देरती पोर आवा, एने ता टिड्याह देरतीन विचान गेत ताकेत आपाय गियी। <verse eid="REV 9:3"/><verse number="4" style="v" sid="REV 9:4"/>ताह इहकेरीन कियेल एतो काय देरतीन खेड़; जाड़ाह एने काल्ली बी निल्ली वोस्तुह नुकसान नाय केरी, पुण ताच माणहान नुकसान किरज्‍यो जान निंडालो पोर बोगवानान साप नाह सोती। <verse eid="REV 9:4"/><verse number="5" style="v" sid="REV 9:5"/>टिड्याह निसाण आपेल एतो काय माणहाह नाय मारी, पुण पाच मोयना वोर तेकलीत देणेन आदिकार आपेल एतो। ज्यी तेकलीत विचान चावणेन गेत एती। <verse eid="REV 9:5"/><verse number="6" style="v" sid="REV 9:6"/>ता पाच मोयना माय माणहे मोत होद्ती, पुण मोत ताह जुड़ी नाय; एने ता मोरने होद्ती, पुण मोत ताह रेन सेटी नाही।<verse eid="REV 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 9:7"/>ता टिड्या लेड़ायीन केरता तियार किरेल गोड़ान गेत एता; तान मुंडी पोर होनान मुकूट एता, एने तान मुय माणहान मुयान गेत एतो। <verse eid="REV 9:7"/><verse number="8" style="v" sid="REV 9:8"/>तान लेट्या बायकुन लेट्यान गेत, एने दात सिहान दातान गेत एता। <verse eid="REV 9:8"/><verse number="9" style="v" sid="REV 9:9"/>तान साती कवच से ढापायेल ने गेत देखाताली, एने तान फाकान आवाज लेड़ायीन केरता जाताला जुलूम होवटा गोड़ान तांगा से पायदा ईयेल आवाज ने गेत एती। <verse eid="REV 9:9"/><verse number="10" style="v" sid="REV 9:10"/>तान सेमटी विचान सेमटीन होस एती, एने ता माय पाच मोयना वोर माणहान नुकसान केरनेन ताकेत एती। <verse eid="REV 9:10"/><verse number="11" style="v" sid="REV 9:11"/>एक नेरेग कुंड ने हेरोगदुत ता पोर राजा ईतो। इब्रानी बाषा माय तान नाव अबदोन<note caller="+" style="f"><char style="fr" closed="false">9:11 </char><char style="fq" closed="false">अबदोन </char><char style="ft" closed="false">ज्याह थोड़ाक माणहे सैतान एय केतेह।</char></note>; एने युनानी बाषा माय अपोलीयोन<note caller="+" style="f"><char style="fr" closed="false">9:11 </char><char style="fq" closed="false">अपोलीयोन </char><char style="ft" closed="false">ज्याह थोड़ाक माणहे सैतान एय केतेह।</char></note> हे, तान मतलब “खेतेम केरनार।”<verse eid="REV 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 9:12"/>पेल्‍ली मोटली पिड़ा जात रेनी: एने दिखो, ज्‍यु सोब वातुन पासाण दुय उंजु मोटल्यु पिड़ा आवण्यो हेत्यु।<verse eid="REV 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 9:13"/>जेवी साहवो हेरोगदुताह तान पावलीह फुक्यो। मी बोगवानान ओंगाणली होनान वेदीन चार हिंगा माय रेन एक आवाज होमल्यो। <verse eid="REV 9:13"/><verse number="14" style="v" sid="REV 9:14"/>जा साहवा हेरोगदुताह फाय पावली एती ताह केयो, “ता चार हेरोगदुताह जा फरात नेदी हेऱ्या बांदाय रेनाह, ताह सोड़ दे!” <verse eid="REV 9:14"/><verse number="15" style="v" sid="REV 9:15"/>ता चार हेरोगदुताह सोड़ देणेम आवो; ता तास दिह ने, एने तास मोयनान एने तास साल ने केरता तियार केराय जायेल एता, ताकाय ता एक बाग माणहाह मार टाकी। <verse eid="REV 9:15"/><verse number="16" style="v" sid="REV 9:16"/>मी गोड़ा पोर बोहणारा सेनान गेणती होमलेल, ता विस करोड़ एता। <verse eid="REV 9:16"/><verse number="17" style="v" sid="REV 9:17"/>माहु ज्या देरसेन माय गोड़ा पोर बोहणारान सातीन कवच आक्‍ठो, गंदक ने गेत देखानो, एने ता गोड़ान मुंड सिहान मुंडान गेत एतो। एने तान मुया माय रेन आक्‍ठो, दुवाड़ो एने गंदक निकेलतालो। <verse eid="REV 9:17"/><verse number="18" style="v" sid="REV 9:18"/>न्या तीन पिड़ा से मतलब गोड़ान मुया माय रेन निकेलनार आक्‍ठो, दुवाड़ो एने गंदक से एक बाग माणहे माराय गीया। <verse eid="REV 9:18"/><verse number="19" style="v" sid="REV 9:19"/>ता गोड़ान ताकेत तान मुयाम एने सेमटा माय एती। काहाकाय तान सेमटी गेड़हान गेत एती, एने ती सेमटी माय मुंडे बी एता, ज्यान वोजेसे ता माणहाह नुकसान पोचाड़ताला।<verse eid="REV 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 9:20"/>ज्यो देखीन बाकीन माणहे जा त्यु पिड़ा माय रेन वोचेल माणहे जा माराय नाह जायेल एता, ता तान आथा केरीन बाणायेल वोस्तु से मोन नाह फिराया। बुतड़ान एने होना चांदीन डेगड़ान, एने लाकड़ान पुजा केरने नाह सोड्या, ती मुरती नाह देख सिकेत, नाह होमेल सिकेह, नाह चाल सिकेत। <verse eid="REV 9:20"/><verse number="21" style="v" sid="REV 9:21"/>ता खुन, जादु जादुटोणा, सिनालो एने चोरी केरने से मोन नाह फिराया।<verse eid="REV 9:21"/></para>
  <chapter eid="REV 9"/>
  <chapter number="10" style="c" sid="REV 10"/>
  <para style="s">हेरोगदुत एने आतली पुस्तेक</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 10:1"/>पुशो मी हेरगाम रेन निचो उतेरतालो एक उंजु ताकेतदार हेरोगदुत दिख्यो। तो वादलो पांगेर रियेल ईतो एने तान मुंडान आहने एक वालान दोंदली एती; तान मुय दिह्यान गेत, एने पाय आक्‍ठान खाम ने गेत एता। <verse eid="REV 10:1"/><verse number="2" style="v" sid="REV 10:2"/>तान आथा माय एक आतीस उगाड़ील पुस्तेक एती। हेरोगदुत तान जेवड्या पायाह देरीया पोर एने डाखऱ्या पायाह देरती पोर मिल्यो, <verse eid="REV 10:2"/><verse number="3" style="v" sid="REV 10:3"/>एने मोठेस आयड़ेल, जिहकेरीन सिहो ढाखार ने। एने तान आयेड़नेन पासाण ढाखारनेन हात सोबदा होमलाना। <verse eid="REV 10:3"/><verse number="4" style="v" sid="REV 10:4"/>जेवी ता ढाखारनेन हात सोबदा होमलाय गीया, तेवी मी लिखण्यु ईतो, पुण मी हेरगाम रेन ज्यो आवाज होमल्यो, “जी वात ढाखारनेन हात सोबदा माय होमलेल हे; त्युह मा लिखही, पुण आठाली मेल।”<verse eid="REV 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 10:5"/>तेवी जा हेरोगदुताह मी देरीया एने देरती पोर उबरियेल दिखेल ईतो, तो तान जेवड्या आथाह हेरगा उगे विस्यो। <verse eid="REV 10:5"/><verse number="6" style="v" sid="REV 10:6"/>जो कायेम जीवतालो हे, तो जुगाह एने ता माय जो काय हे तो, एने देरती पोर जो काय हे तो, एने देरीया माय जो काय हे ताह बाणायेल हे। ताच ने सुगोण खाईन केयो, “एवी उंजु वार नाय एय।” <verse eid="REV 10:6"/><verse number="7" style="v" sid="REV 10:7"/>पुण जेवी हातवो हेरोगदुत ने होमेलनेन टेम आवी मतलब पावलीह वाजाड़ी, तेवी बोगवानान लिकायेल वात पुरी एय जाय, ज्याह तो तान पावोर एने जाणकाराह आपेल ईतो।<verse eid="REV 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 10:8"/>एने हेरगाम रेन बोलणार माणुह पोशो मार हेऱ्यो वातु केरने बाज गीयो, एने माहु केयो, “जा, जो हेरोगदुत देरीया एने देरती पोर उबरिनोह, तान आथावाली उगड़ील पुस्तेक लीय ली।”<verse eid="REV 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 10:9"/>मी हेरोगदुताह फाय जाईन केयो, “ज्यी आतली पुस्तेक माहु आप दे।” तो माहु केयो,</para>
  <para style="p" vid="REV 10:9">“ज्यीह ली एने खाय ली; ज्यी तार पेटाह खाटालो ते केरी, पुण तारा मुया माय मोवालान गेत गुली लागी।”<verse eid="REV 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 10:10"/>मी ती पुस्तेकीह हेरोगदुत ने आथाम रेन मांगीन खाय गीयो, एने ती मारा मुया माय मोवालान गेत गुली ते लागी। पुण तीह खाणेन पासाण मार मुय खाटालो एय गीयो। <verse eid="REV 10:10"/><verse number="11" style="v" sid="REV 10:11"/>ज्यान पासाण तो माहु ज्यो केयो, “तुवाह मोकतास देसान, जातीन, बाषान एने राजान बाराम पोशो जाणाव केरने पोड़ी।”<verse eid="REV 10:11"/></para>
  <chapter eid="REV 10"/>
  <chapter number="11" style="c" sid="REV 11"/>
  <para style="s">दुय गोवाह</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 11:1"/>ज्यान पासाण कुण तीबी माहु एक मोजणेन केरता डेंगी आप्यो, एने माहु केयो, “जा, बोगवान ने मोंदिर एने वेदीह मोज ली, एने मोंदिर माय आरादना केरनारान गीणती किर ली। <verse eid="REV 11:1"/><verse number="2" style="v" sid="REV 11:2"/><note caller="+" style="x"><char style="xo" closed="false">11:2 </char><char style="xt" closed="false"><ref loc="LUK 21:24">लुका 21:24</ref></char></note>पुण मोंदिरान बाहेर ने खोली सोड़ दे; एने ताह मा मुजही, काहाकाय तो बिगेर यहुदिन केरता हे, एने ता बेचाड़ीस मोयना वोर चोखाला हेयराह पायान बुंदे रोहंदेलती। <verse eid="REV 11:2"/><verse number="3" style="v" sid="REV 11:3"/>मी मारा दुय गोवाह पुरी ताकेत आपुह, एने ता एक एजार दुय होव साठ दिह वोर जाणाव केरती, ता गोंटान गेत फाड़का पिरील रेती जाह दुख देखाड़नेन केरता फांगेरनु।”<verse eid="REV 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 11:4"/>देरतीन मालीक ने ओंगाण उबरेणारे दुय जेतुन ने जाड़े, एने दुय दिवा ज्यास हेते। <verse eid="REV 11:4"/><verse number="5" style="v" sid="REV 11:5"/>केदी एगदो ताह नुकसान पोचाड़ने हुदिह, ते तान मुयाम रेन आक्‍ठो निकलीन तान दुसमोनाह हेलगाड़ दिथे; केदी एगदो ताह नुकसान पोचाड़ने हुदिह, ते खेरीच तो इहीचकेरीन माराय जाय। <verse eid="REV 11:5"/><verse number="6" style="v" sid="REV 11:6"/>तान जाणाव केरनेन दिह्या माय पाणी नाय पोड़ी, केरीन ताह जुगाह बोंद केरनेन आदिकार आपेल हे। एने ताह आखा पाणी पोर आदिकार हे काय लुय माय बोदेल देय; एने ताह ज्यो बी आदिकार हे काय ताह पोटी तुलबूखे आखी बातीन तेकलीत देरती पोर लाव सेकती।<verse eid="REV 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 11:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">11:7 </char>
      <char style="xt" closed="false">
        <ref loc="REV 13:5-7">प्रकाशितवाक्य 13:5-7</ref>; <ref loc="REV 17:8">17:8</ref></char>
    </note>जेवी ता बोगवानान खोबरीन पुकार केर देती, तेवी नेरेग कुंड माय रेन एक खाराब जेनवेर उपेर आवी। एने ता हिऱ्यो लेड़ाय केरीन ताह आरवी देय, एने ताह मार देय, <verse eid="REV 11:7"/><verse number="8" style="v" sid="REV 11:8"/>एने ता दुय गोवाह ने देड़ ता मोटला हेयरान वाटी पोर पोड़ रेती, ज्यो हियोर निसाणीन रूप माय सदोम एने मीस्र केवाथी। न्यास तान मालीक यीशुह खुरूसखाम पोर चेड़ावीन मारील एता। <verse eid="REV 11:8"/><verse number="9" style="v" sid="REV 11:9"/>आखा देस, आखा गेराणा, आखी बाषा, एने आखी जातीन माणहे तान देड़ाह साड़े तीन दिह वोर देखती रेती, एने तान देड़ाह माहणा माय बुजणे नाय देती। <verse eid="REV 11:9"/><verse number="10" style="v" sid="REV 11:10"/>देरती पोर रेणारे माणहे तान मोतीन कारेण जुलूम खुस एती एने खुसी माणावती, एने ता एका दिहराह बोकसीस आपती। काहाकाय ज्या दुय जाणकार देरती पोर रेणारे माणहाह जुलूम तेकलीत दियेल एता। <verse eid="REV 11:10"/><verse number="11" style="v" sid="REV 11:11"/>पुण साड़े तीन दिह्यान पासाण बोगवानान उगे रेन जीवणान हाह ता माय आव गीयो, एने ता तान पायान ताकेत पोर उबरी गीया, एने ताह देखणारे माणहाम जुलूम बिय सावाय गियी। <verse eid="REV 11:11"/><verse number="12" style="v" sid="REV 11:12"/>तेवी ता दुय जाणकाराह हेरगाम रेन एक मोटलो आवाज होमलानो, “न्या उपेर आवो!” तेवी ता वादला माय उपेर जात रेना, ताह उपेर जाताला तान दुसमोन देख्या। <verse eid="REV 11:12"/><verse number="13" style="v" sid="REV 11:13"/><note caller="+" style="x"><char style="xo" closed="false">11:13 </char><char style="xt" closed="false"><ref loc="REV 6:12">प्रकाशितवाक्य 6:12</ref>; <ref loc="REV 16:18">16:18</ref></char></note>तुलेचबूखी देरती फाटनी, एने हेयरान दाहवो बाग पोड़ गीयो; ती देरती फाटतास हात एजार माणहे मोर गीया। एने बाकी वोचेल माणहे बिय गीया एने बोगवानान बोड़ाय केऱ्या।<verse eid="REV 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 11:14"/>दुसरी पिड़ा खेतेम एय गियी, एवी तिसरी पिड़ा आवणी हे!<verse eid="REV 11:14"/></para>
  <para style="s">हातवी पावल्यी</para>
  <para style="p">
    <verse number="15" style="v" sid="REV 11:15"/>जेवी हातवो हेरोगदुत तान पावलीह फुक्यो, तेवी हेरगा माय मोटलो मोटलो आवाज एणे लागो, “एवी दुनिया पोर राज केरनेन ताकेत आमरा मालीक फाय हे, एने तान मसीन हे, एने तान राज कायेम कायेम रेय!” <verse eid="REV 11:15"/><verse number="16" style="v" sid="REV 11:16"/>तेवी चोववीस डावाला माणहे जा बोगवानान ओंगाण जान तान राजगादि पोर बोह रियेल एता, ता बोगवानान ओंगाण मुयान बोरहे पोड़ीन आरादना केऱ्या:<verse eid="REV 11:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="REV 11:17"/>एने केया, “एय आखाह रेन ताकेतवाला मालीक बोगवान, जो हे, एने जो ईतो!</para>
  <para style="q2" vid="REV 11:17">आमु तारो दन्यवाद केरतेह काय तु तारी मोटली ताकेत केरीन तार राज ने काम किऱ्यो,</para>
  <para style="q2" vid="REV 11:17">एने राज केरनेन सुरवात किरेल हे!<verse eid="REV 11:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="REV 11:18"/>आखा देसान माणहे खीजवाय रियेल एता,</para>
  <para style="q2" vid="REV 11:18">पुण तार राग ता पोर आव लागोह,</para>
  <para style="q2" vid="REV 11:18">तो टेम आव लागेल हे काय मुरेल माणहान नियाव केराय जाय,</para>
  <para style="q2" vid="REV 11:18">एने तार पावोर, जाणकार,</para>
  <para style="q2" vid="REV 11:18">एने चोखाला माणहान एने ता आत्या मोठा जा तार नावाह बितेह, ताह फोल आपाय जाय,</para>
  <para style="q2" vid="REV 11:18">एने जा देरतीह खेतेम केरने बाजरेनाह ता बी खेतेम केराय जाय!”<verse eid="REV 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 11:19"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">11:19 </char>
      <char style="xt" closed="false">
        <ref loc="REV 8:5">प्रकाशितवाक्य 8:5</ref>; <ref loc="REV 16:18">16:18</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="REV 16:21">प्रकाशितवाक्य 16:21</ref>
      </char>
    </note>तेवी बोगवानान जो मोंदिर हेरगा माय हे तो उगड़ी गीयो, एने तान मोंदिर माय तान वायदान पेटी देखानी। तेवी विजेलनो, गाजणे, आयेड़नो, एने देरती आलनी, एने मोटलो बोरफो पोड़नो।<verse eid="REV 11:19"/></para>
  <chapter eid="REV 11"/>
  <chapter number="12" style="c" sid="REV 12"/>
  <para style="s">बायकु एने एजगेर</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 12:1"/>पोशो एक मोटली निसाणी जुगा माय देखानी, मतलब एक बायकु दिह्याह पांगेर रियेल एती, एने चांद तीन पायान नेचो एने मुंडा पोर बारा तारान मुकूट ईतो। <verse eid="REV 12:1"/><verse number="2" style="v" sid="REV 12:2"/>ती बायकुह दिह एता, एने तेकलीत ने कारेण ती आयेड़ने बाजरियेल एती, काहाकाय सोराह पायदा केरनेन टेम एतो। <verse eid="REV 12:2"/><verse number="3" style="v" sid="REV 12:3"/>एक उंजु निसाणी जुगा माय देखानी। एने दिखो, रातला रेंगान एक मुठलो एजगेर ईतो, तान हात मुंड एने दोह हिंगे एता एने तान हातु बी मुंडा पोर एक एक मुकूट एतो। <verse eid="REV 12:3"/><verse number="4" style="v" sid="REV 12:4"/>तो तान सेमटा केरीन जुगान एक उगेन ताराह खेचीन देरती पोर नोवो टाक दिनो। तो एजगेर सोराह पायदा एतास खाणेन होदतालो, केरीन ती बायकुन ओंगाण उबरी गीयो जी सोराह पायदा केरनी एती। <verse eid="REV 12:4"/><verse number="5" style="v" sid="REV 12:5"/>ओवती ती बायकु एक सोराह जेल्मो देनी, एने ता सोराह लोखंडान राजडेंगा केरीन आखा देसा पोर राज केरनु एतो। पुण ता सोराह बोगवान एने तान राजगादि फाय उखलीन पोचाड़ाय गीयो। <verse eid="REV 12:5"/><verse number="6" style="v" sid="REV 12:6"/>पुण ती बायकु नाहीन ता जेंगला माय जात रेनी, जा बोगवानान उगे रेन तीन केरता जागु तियार किरेल एतो, ताकाय ती एक एजार दुय होव दिह वोर होमलावाय जाय।<verse eid="REV 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 12:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:7 </char>
      <char style="xt" closed="false">
        <ref loc="JUD 1:9">यहुदा 1:9</ref>
      </char>
    </note>तेवी हेरगा माय लेड़ाय एनी। मीखायेल एने तान हेरोगदुत एजगेरा हेऱ्या लेड़ाणेन केरता निकेलना, एजगेर एने तान हाती ता हेऱ्या लेड़ाना; <verse eid="REV 12:7"/><verse number="8" style="v" sid="REV 12:8"/>पुण एजगेर जिक नाह सीक्‍यो, एने हेरगा माय तान केरता रेणेन जागु नाह रेनो। <verse eid="REV 12:8"/><verse number="9" style="v" sid="REV 12:9"/><note caller="+" style="x"><char style="xo" closed="false">12:9 </char><char style="xt" closed="false"><ref loc="LUK 10:18">लुका 10:18</ref></char></note>एने ता एजगेरा एने तान हेरोगदुताह बुंदे टाक देना, ज्यो तोस जुनालो गेयड़ेक हे, जो खाराब एने सैतान केवाथी, एने आखी दुनियाह बोटकावणार हे। <verse eid="REV 12:9"/><verse number="10" style="v" sid="REV 12:10"/>पुशो मी हेरगा माय रेन ज्यो मोटलो आवाज आवतालो होमल्यो, एवी आमरा बोगवानान सुटकारो, ताकेत, राज! एने तान मसीन आदिकार देखानोह! काहाकाय बुरहो केरनारा पोर आरोप लागाड़नार जो आमरा बोगवानान ओंगाण रात दिह ताह गुनेगार ठेरावीह, ताह नेचो जुगार दियेल हे। <verse eid="REV 12:10"/><verse number="11" style="v" sid="REV 12:11"/>पुण ता मेंड्रान लुय एने तान गोवाहीन वचना केरीन ता पोर जिक सापड़ायेल हेते; काहाकाय ता तान जीवान बी पारवा नाह केऱ्या। <verse eid="REV 12:11"/><verse number="12" style="v" sid="REV 12:12"/>केरीन एय हेरोग एने ता माय रेणारे खुस ईवो, पुण देरती एने देरीया पोर हाय! काहाकाय सैतान जुलूम राग माय तुमरी फाय उतेर आयेल हे, काहाकाय तो जाणेह काय ता फाय टेम थुड़ोस बाकी हे।<verse eid="REV 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 12:13"/>जेवी एजगेराह सोमेज माय आवो काय माहु देरती पोर नेचो टाक दियेल हे, ते ती बायकुन पासाण लागो जी सोराह पायदा किरेल एती। <verse eid="REV 12:13"/><verse number="14" style="v" sid="REV 12:14"/>पुण ती बायकुह मोटला मोराग्यान दुय फाके आपाय गीया काय एजगेर ने ओंगाण रेन उड़ीन जेंगला माय ती जागी पोच जाय, जा तीह एजगेरान ढाचाम रेन होमालीन मेलने माय एक एजार साठ दिह वोर द्यान मेलाय जाय। <verse eid="REV 12:14"/><verse number="15" style="v" sid="REV 12:15"/>एने एजगेर ती बायकुन पासाण तान मुयाम रेन नेदीन गेत पाणी वोयाड्यो, ज्यानकेरता काय ती बायकुह पाण्या केरीन वोयाड़ ली जाय। <verse eid="REV 12:15"/><verse number="16" style="v" sid="REV 12:16"/>पुण देरती ती बायकुन मोदेक किरेल, एने बुय तीन मुय खोलीन ती नेदीह गील लेदी, जी एजगेरान मुयाम रेन निकेलताली। <verse eid="REV 12:16"/><verse number="17" style="v" sid="REV 12:17"/>ज्यान पासाण एजगेराह ती बायकु पोर जुलूम राग आवो; एने बायकु दिहरा वुचेल वोस फाय जा बोगवानान उकुमाह मानतेह एने यीशुन गोवाही केणेन मोजबुत हेते, ता हिऱ्यो लेड़ाणेन केरता गीयो। <verse eid="REV 12:17"/><verse number="18" style="v" sid="REV 12:18"/><note caller="+" style="f"><char style="fr" closed="false">12:18 </char><char style="ft" closed="false">एने एजगेर उब रिनो; थोड़ाक लेख माय मी उबरिनोह लिखेल हे, न्या सोबदा से ओंगाण ने बाग हेऱ्यो जोड़ाय जाथे।</char></note>एने एजगेर देरीयान मीरे जाईन उबरी गीयो।<verse eid="REV 12:18"/></para>
  <chapter eid="REV 12"/>
  <chapter number="13" style="c" sid="REV 13"/>
  <para style="s">दुय जोरवार जेनवेरे</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 13:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">13:1 </char>
      <char style="xt" closed="false">
        <ref loc="REV 17:3">प्रकाशितवाक्य 17:3</ref>,<ref loc="REV 17:7-12">7-12</ref></char>
    </note>ओवतो मी एक ओहला जेनवेराह देरीया माय रेन निकेलतालो दिख्यो। जान दोह हिंग एने हात मुंड एता; तान हिंगा पोर दोह मुकूट, एने तान मुंडा पोर बोगवानान चिहटान नाव लिखेल एतो। <verse eid="REV 13:1"/><verse number="2" style="v" sid="REV 13:2"/>जा जेनवेराह मी दिखेल तो खेड्यान गेत एतो, पुण तान पाय रिसड़ान गेत एने मुय सिहान गेत एतो। ताह एजगेर सोतान सेक्ती, राजगादि एने मुठलो आदिकार आप दिनो। <verse eid="REV 13:2"/><verse number="3" style="v" sid="REV 13:3"/>मी तान मुंडा माय रेन एका पोर ओहलो जेखेम लागेल दिखेल काय तो एवी मोरने पोर हे, पुण तो मार लीय ओहलो जेखेम हुदरी गीयो। एने आखी दुनियान माणहे बोंगलायीन ता जेनवेरान पासाण पासाण चाल देना। <verse eid="REV 13:3"/><verse number="4" style="v" sid="REV 13:4"/>माणहे एजगेरान आरादना केऱ्या, काहाकाय एजगेर ताह राज केरनेन केरता सोतान आदिकार आप दियेल ईतो, एने ज्यो किन जेनवेरान पुजा केऱ्या, “ज्या जेनवेरान बाराबोर कुण हे? एने ज्यान विरोद कुण लेड़ाय सिकेह?”<verse eid="REV 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 13:5"/>ता जेनवेराह मोठाय केरने एने बोगवानान चिहटान वातु बोलणेन केरता मुय आपेल एतो, एने ताह बेचाड़ीस मोयना वोर राज केरनेन आदिकार आपायेल एतो। <verse eid="REV 13:5"/><verse number="6" style="v" sid="REV 13:6"/>तेवी जेनवेर बोगवानान चिहटा केरनेन सुरवात केर दिनो, तो बोगवानान नाव, एने जा बोगवान रिथे तो जागो, एने जा हेरगा माय रेतेह तान चिहटा किऱ्यो। <verse eid="REV 13:6"/><verse number="7" style="v" sid="REV 13:7"/>ताह ज्यो बी हक आपेल एतो काय बोगवानान माणहान विरोद माय लेड़ाय केरी एने ता पोर जिक हासील केरी, एने ताह एकेक गेराणो, माणहे, आलेग आलेग बाषा, एने आखा देस पोर आदिकार आपेल एतो। <verse eid="REV 13:7"/><verse number="8" style="v" sid="REV 13:8"/>दुनियाह बाणावणेन पेल जान नाव मारायेल मेंड्रान जीवणान पुस्तेक माय लिखेल हेते, ताह सोड़ीन आखी देरती पोर रेणारे माणहे ता जेनवेरान आरादना केरती।<verse eid="REV 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 13:9"/>जान कान एय, ता होमली लेय! <verse eid="REV 13:9"/><verse number="10" style="v" sid="REV 13:10"/>जा जेली माय कोंडाणेन केरता हादायेल हेते ता जेली माय कोंडाय जाती; एने जा तालवारी केरीन मारती ता तालवारी केरीन माराय जाती। केरीन बोगवानान माणहाह दिर एने बुरहो ज्याज माय हे।<verse eid="REV 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 13:11"/>पुशो मी देरती माय रेन एक उंजु जेनवेराह निकेलतालो दिख्यो। तान मेंड्रान गेत दुय हिंगे एता, पुण तो एजगेरान गेत बोलतालो। <verse eid="REV 13:11"/><verse number="12" style="v" sid="REV 13:12"/>तो ता पेल्ला जेनवेरान आखो आदिकार तान ओंगाण कामा माय लागाड़तालो। एने ता पेल्ला जेनवेराह जाह मार लीय ओहलो जेखेम हुदरी जायेल एतो, तान आरादना आखी दुनियान माणहाह केरावतालो। <verse eid="REV 13:12"/><verse number="13" style="v" sid="REV 13:13"/>तो दिहरो जेनवेर मोट मोठा चोमेत्कार देखाड़तालो; एने न्या वोर काय माणहान ओंगाण जुगाम रेन देरती पोर आक्‍ठो पाड़ देतालो। <verse eid="REV 13:13"/><verse number="14" style="v" sid="REV 13:14"/>एने जा चोमेत्कार ता जेनवेरान ओंगाण ताह केरनेन होपेल एतो, तो देरती पोर रेणारा माणहाह ठेगतालो। तो ताह केतालो काय ता जेनवेरान मुरती बाणावो जान सेरीर पोर तालवारी केरीन जेखेम लागेल एतो, एने जो पोशो जीवतालो एय जायेल एतो। <verse eid="REV 13:14"/><verse number="15" style="v" sid="REV 13:15"/>ताह जेनवेरान मुरती माय जीव टाकणेन आदिकार आपेल एतो काय मुरती बोलने बाज जाय, एने जोला बी माणहे ता जेनवेरान मुरतीन आरादना नाय केरी, ताह माराव देय। <verse eid="REV 13:15"/><verse number="16" style="v" sid="REV 13:16"/>दुसरो जेनवेर आत्या मोठा, गेरीब मालदार, आजाद एने पावोर आखा माणहाह मोजबुर किऱ्यो काय आप आपणा जेवड्या आथा एने निंडाला पोर तान साप गालाड़ी। <verse eid="REV 13:16"/><verse number="17" style="v" sid="REV 13:17"/>एने जा पोर तो साप मतलब ता जेनवेरान नाव एने तान नावान आकड़ा एय, ताह सोड़ीन दिहरा काल्ला बी माणहे लेन देन नाह केर सेकते।<verse eid="REV 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 13:18"/>जा माय इकेल एय तो ता जेनवेरान आकड़ान मतलब काड़ लेय, काहाकाय ज्या आकड़ा एगदा माणहान नावान बाराबोर हेते। तान आकड़ान ईसाब हे सोव होव साहासट।<verse eid="REV 13:18"/></para>
  <chapter eid="REV 13"/>
  <chapter number="14" style="c" sid="REV 14"/>
  <para style="s">मेंड्रो एने तान माणहे</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 14:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">14:1 </char>
      <char style="xt" closed="false">
        <ref loc="REV 7:3">प्रकाशितवाक्य 7:3</ref>
      </char>
    </note>तेवी मी मेंड्राह सियोन बोयड़ा पोर उबरियेल दिख्यो; एने ता हेऱ्यो एक लाख चोवरेचाड़ीस एजार माणहे एता, ता माणहान निंडाला पोर मेंड्रान एने तान आबाख ने नाव लिखेल एतो। <verse eid="REV 14:1"/><verse number="2" style="v" sid="REV 14:2"/>एने हेरगा माय रेन एक मोटलो आवाज होमलानो जो पाण्यान मोकतास खोदरा, एने चिल्लाटा देन आयेड़नारान गेत एतो। एने जो आवाज मी होमलेल तो ओहलो एतो काय रेणथो वाजाड़नार रेणथो वाजाड़ ने बाजरेनोह। <verse eid="REV 14:2"/><verse number="3" style="v" sid="REV 14:3"/>ता राजगादिन ओंगाण, एने चार जिवताला जेनवेरान, एने डावाला माणहान ओंगाण एक नोवालो गीत गावणे बाजरियेल एता। देरती पोर रेन वेचाता लेन सोड़ेव लियेल एता, ता एक लाख चोवरेचाड़ीस एजार माणहाह सोड़ीन, कुण बी ता गीताह हिक नाह सेकतालो। <verse eid="REV 14:3"/><verse number="4" style="v" sid="REV 14:4"/>ता ओहला माणहे हेते जा केदी बी एगदी बायकु हेऱ्या सिनालो नाह किरेल एता, पुण ता कुवारला हेते; एने जा का बी मेंड्रो जाथे तान पासाण चाल देतेह। आखा माणहान जाती माय रेन ताह वेचातो लेन सोड़ेव लियेल एतो, ता बोगवानान एने मेंड्रान केरता पाक ने पेल्ला फोल हेते। <verse eid="REV 14:4"/><verse number="5" style="v" sid="REV 14:5"/>तान केदी बी जुठ बुलील नाह एता; पुण ता निर्दोस हेते।<verse eid="REV 14:5"/></para>
  <para style="s">तीन हेरोगदुत</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 14:6"/>पुशो मी एक उंजु हेरोगदुताह जुगाम उड़तालो दिख्यो, ता फाय होमलाड़नेन केरता जेलेमक्योन हाजाली खुबेर एती, ज्यी खुबेर देरती पोर रेणारा आखा देस, गेराणो, एने आखी बाषा बोलणारान केरता एती। <verse eid="REV 14:6"/><verse number="7" style="v" sid="REV 14:7"/>तो हेरोगदुत आयड़ीन केयो, “बोगवानान मान पान किरो, एने तान मोठवायीन केरता तान स्तुती किरो! काहाकाय आखा माणहान नियाव केरनेन टेम आव लागेल हे। एने तास ने आरादना किरो, जो हेरोग, देरती, देरीयाह, एने पाण्यान खोदराह बाणायेल हे!”<verse eid="REV 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 14:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">14:8 </char>
      <char style="xt" closed="false">
        <ref loc="REV 18:2">प्रकाशितवाक्य 18:2</ref>
      </char>
    </note>तेवी ज्यान पासाण एक उंजु हेरोगदुत ज्यो कितेन आवो, “पोड़ गीयो! तो मोटलो बाबिलोन पोड़ गीयो! जो तान खाराब कामान दारो आखा देसाह पिवाड़ील एतो!”<verse eid="REV 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 14:9"/>न्या दुयून पासाण एक उंजु तीसरो हेरोगदुत मोटली आवाज माय ज्यो कितेन आवो, केदी एगदो ज्या जेनवेरान एने तान मुरतीन आरादना केरी, एने ता आप आपणा निंडालो पोर तान साप लागाड़ती, <verse eid="REV 14:9"/><verse number="10" style="v" sid="REV 14:10"/>एने ता बोगवानान रागान दारो पिय, ओहली केड़ेक दारो जो बोगवानान वाटका माय बुणेल हे! ता माणहाह चोखाला हेरोगदुतान एने मेंड्रान ओंगाण हेलेगतालो आक्‍ठो, गंदक माय पिड़ा वेठणे पोड़ी। <verse eid="REV 14:10"/><verse number="11" style="v" sid="REV 14:11"/>तान पिड़ान दुवाड़ो कायेम कायेम उटती रेय। जा माणहे ता जेनवेरान एने तान मुरतीन आरादना केरती एने तान नावान साप लागाड़ती, ता माणहाह रात दिह हुक नाय जुड़ी।<verse eid="REV 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 14:12"/>केरीन बोगवानान माणहाह दिर मेलनेन जोरवरी हे, जा बोगवानान उकुमाह मानतेह एने यीशु पोर बुरहो मेलतेह।<verse eid="REV 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 14:13"/>पुशो मी हेरगाम रेन ज्यो आवाज होमल्यो, “ज्यो लिख: बोरकेतवाला ता हेते, जा मालीक पोर बुरहो केरनेन पासाण मोरती!”</para>
  <para style="p" vid="REV 14:13">चोखालो जीव किथे, “होव, काहाकाय तान मेहनेत से ताह आराम जुड़ी, एने तान काम ने ईसाब ता हेऱ्यो मेलाय जाय।”<verse eid="REV 14:13"/></para>
  <para style="s">देरतीन कामाय काटणो</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 14:14"/>ज्यान पासाण मी एक दोवल्यो वादलो दिख्यो, एने वादला पोर माणहान सोरान गेत कुण तीबी बोह रेनोह, तान मुंडी पोर होनान मुकूट एने आथा माय दाराल्ल्यो दातलो ईतो। <verse eid="REV 14:14"/><verse number="15" style="v" sid="REV 14:15"/>पुशो एक उंजु हेरोगदुत मोंदिर माय रेन निकलीन वादला पोर बोह रियेल ता माणहाह मोठेस आयड़ीन केयो, “तु दातला केरीन पाक काट ली, काहाकाय पाक काटणेन टेम आव लागेल हे; एने देरतीन पाक पुरी रिती से तियार एय जायेल हे!” <verse eid="REV 14:15"/><verse number="16" style="v" sid="REV 14:16"/>तेवी जो वादला पोर बोह रियेल ईतो, तो तान दातला केरीन देरतीन पाक काट लिदो, एने देरतीन काटणी केराय गियी।<verse eid="REV 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 14:17"/>तेवी एक उंजु हेरोगदुत हेरगावाला मोंदिर माय रेन बाहेर निकेलनो, तान आथा माय बी एक दाराल्ल्यो दातलो ईतो।<verse eid="REV 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 14:18"/>एक उंजु हेरोगदुत वेदी माय रेन बाहेर आवो, जाह आक्‍ठा पोर आदिकार ईतो, तो ता हेरोगदुताह जा फाय दाराल्ल्यो दातलो ईतो। मोठेस आयड़ीन केयो, “काहाकाय देरतीन अंगुर हास केरीन पाक जायेल हेते, केरीन अंगुर ने गुमसाह दातला केरीन काट ली!” <verse eid="REV 14:18"/><verse number="19" style="v" sid="REV 14:19"/>तेवी हेरोगदुत तान दातलाह देरती पोर फिरावीन देरतीन अंगुर काट लिदो, एने ताह बोगवानान बयंकर रागान रोह ने कुंडा माय जुगार दिनो। <verse eid="REV 14:19"/><verse number="20" style="v" sid="REV 14:20"/><note caller="+" style="x"><char style="xo" closed="false">14:20 </char><char style="xt" closed="false"><ref loc="REV 19:15">प्रकाशितवाक्य 19:15</ref></char></note>हेयरान बाहेर रूहान कुंडा माय अंगुराह रोहंदेल दिनो, एने रूहान कुंडा माय रेन ओलो होवटो लुय निकेलनो काय गोड़ान लगाम वोर पोच गीयो, एने तीन होव किलो मिटर वोर वोय गीयो।<verse eid="REV 14:20"/></para>
  <chapter eid="REV 14"/>
  <chapter number="15" style="c" sid="REV 15"/>
  <para style="s">सेवली पिड़ा लावणारे हात हेरोगदुत</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 15:1"/>पुशो मी जुगा माय एक बोंगलाय ओहली मोटली निसाणी दिख्यो, तो ज्यो काय हात हेरोगदुता फाय हात आवणार पिड़ा एत्यु, त्यु सेवल्यु पिड़ा एत्यु, काहाकाय न्यु हेऱ्यो बोगवानान राग ओलाय जाथे।<verse eid="REV 15:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 15:2"/>तेवी माहु सिसान गेत एक देरीयो देखाय देनो जा माय आक्‍ठो बेचक्यो एय। एने उंजु मी दिख्यो काय जा माणहे ता जेनवेरा एने तान मुरती एने तान आकड़ा पोर जीत हासील किरेल हेते। ता माणहे बी ता सिसान देरीयान उपेर, बोगवानान उगे रेन आपायेल रेणथो लेन उबरियेल एता। <verse eid="REV 15:2"/><verse number="3" style="v" sid="REV 15:3"/>ता माणहे बोगवानान पावोर मुसान एने मेंड्रान गीत गावणे बाजरियेल एता:</para>
  <para style="q1" vid="REV 15:3">“एय आखाह रेन ताकेतवाला मालीक बोगवान,</para>
  <para style="q2" vid="REV 15:3">तार काम मोटला एने बोंगलाय ओहला हेते!</para>
  <para style="q1" vid="REV 15:3">एय देस देसान राजा,</para>
  <para style="q2" vid="REV 15:3">तार वाट खेरली एने खेराय माय बोरायेल हे!<note caller="+" style="f"><char style="fr" closed="false">15:3 </char><char style="ft" closed="false">देस; थोड़ाक लेख माय केल लिखेल हे।</char></note><verse eid="REV 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="REV 15:4"/>एय मालीक, कुण हे जो तुवाह नाय बिय?</para>
  <para style="q2" vid="REV 15:4">एने तार नावान बोड़ाय नाय केरी?</para>
  <para style="q1" vid="REV 15:4">काहाकाय तु उलोस चोखालो हे।</para>
  <para style="q2" vid="REV 15:4">एने आखा देसान माणहे आवी</para>
  <para style="q2" vid="REV 15:4">एने तार आरादना केरती,</para>
  <para style="q1" vid="REV 15:4">काहाकाय तार नियाव ने काम आखा पोर देखाय जायेल हेते।”<verse eid="REV 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 15:5"/>ज्यान पासाण मी ज्यो दिख्यो काय हेरगान मोंदिर माय वायदान तोम्बु खोलाय गीयोह। <verse eid="REV 15:5"/><verse number="6" style="v" sid="REV 15:6"/>ता मोंदिर माय रेन हात हेरोगदुत हात पिड़ा लेन निकेलना, ता हुवाल्ला साप सुतरा फाड़का पेरीन एने साती पोर होनान पुट्टो लेन एता। <verse eid="REV 15:6"/><verse number="7" style="v" sid="REV 15:7"/>तेवी ता चार जीवताला जेनवेरा माय रेन एक एने कायेम कायेम जीवतालो रेणार बोगवान ने रागाम बोरायेल हात वाटकाह, हात हेरोगदुताह आप दिनो। <verse eid="REV 15:7"/><verse number="8" style="v" sid="REV 15:8"/>बोगवानान बोड़ाय एने तान सेक्तीन कारेण मोंदिर दुवाड़ा माय बोराय गीयो, एने जाह वोर हात हेरोगदुतान हात पिड़ा निवेर नाह गियी, ताह वोर मोंदिर माय कुणूस बी जाय नाह सेक्यो।<verse eid="REV 15:8"/></para>
  <chapter eid="REV 15"/>
  <chapter number="16" style="c" sid="REV 16"/>
  <para style="s">बोगवानान रागान वाटका</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 16:1"/>तेवी मी मोंदिर माय रेन एक मोठास आवाज माय ता हात हेरोगदुताह ज्यो कितेन होमल्यो: “जावु, एने बोगवानान रागान हात वाटकाह देरती पोर टाक दिवो!”<verse eid="REV 16:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 16:2"/>तेवी पेल्लो हेरोगदुत जाईन तान वाटको देरती पोर टाक दिनो। ज्यानकेरता ता माणहा पोर जा जेनवेरान साप लागाड़ील एता, एने जा तान मुरतीन पुजा केरताला, ता पोर जुलूम तेकलीत देणेवाला फुड़ा निकेल आवा।<verse eid="REV 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 16:3"/>जेवी दुसरो हेरोगदुत तान वाटकाह देरीया माय टाक दिनो। ते आखो पाणी मुरेल माणहान लुय ने गेत एय गीयो, एने देरीया मायवाला आखा जेनवेरे मोर गीया।<verse eid="REV 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 16:4"/>उंजु तिसरो हेरोगदुत तान वाटकाह नेदी एने पाणीन जिरा पोर टाक दिनो। एने ता लुय बोण गीया। <verse eid="REV 16:4"/><verse number="5" style="v" sid="REV 16:5"/>तेवी मी पाणीन मालीक हेरोगदुताह ज्यो कितेन होमल्यो, “एय चोखाला, जो हे, एने जो ईतो, तु न्यायी हे, एने तु ज्यो नियाव ठिख किरेल हे! <verse eid="REV 16:5"/><verse number="6" style="v" sid="REV 16:6"/>ता चोखाला माणहान एने जाणकारान लुय वोयाड़ेल हेते, केरीन तु न्यायी हे एने न्याह पिणेन केरता लुय आपेल हे। काहाकाय ता ज्‍यीस लायकीन हेते!” <verse eid="REV 16:6"/><verse number="7" style="v" sid="REV 16:7"/>पुशो मी वेदी माय रेन ज्यो आवाज होमल्यो, “होव, एय आखाह रेन ताकेतवाला मालीक बोगवान! तार नियाव ठिख एने खीरलो हे!”<verse eid="REV 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 16:8"/>ज्यान पासाण चोवथो हेरोगदुत तान वाटकाह दिह्या पोर टाक दिनो, एने ताह बिय आवी ओहली आसी केरीन हेलगाड़ देणेन आदिकार आपाय गीयो। <verse eid="REV 16:8"/><verse number="9" style="v" sid="REV 16:9"/>बिय आवी ओहली आसी केरीन माणहे बुंजाणे बाज गीया, एने ता बोगवानान नावान जाह ज्यी पिड़ा पोर आदिकार हे, चिहटा केऱ्या। पुण तान पापाम रेन मोन नाह फिराया, एने नाह बोगवानान बोड़ाय केऱ्या।<verse eid="REV 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 16:10"/>तेवी पाचवो हेरोगदुत तान वाटकाह जेनवेरान राजगादि पोर टाक दिनो। एने तान राज पोर आंदारो सावाय गीयो, एने पिड़ान वोजेसे माणहे आप आपणी जिब चावणे बाज गीया, <verse eid="REV 16:10"/><verse number="11" style="v" sid="REV 16:11"/>पुण पिड़ा एने फुड़ान कारेण ता माणहे हेरगान बोगवानाह हाराप आपणे बाज गीया। पुण खाराब काम केरने नाह सोड्या एने नाह बोगवानान उगे मोन फिराया।<verse eid="REV 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 16:12"/>तेवी साहवो हेरोगदुत मोटली फरात नेदी पोर तान वाटकाह टाक दिनो। एने ती नेदीन पाणी हुक गीयो काय दिह उगता उगे रेन आवणार राजान केरता वाट तियार एय जाय। <verse eid="REV 16:12"/><verse number="13" style="v" sid="REV 16:13"/>पुशो मी डेटकान गेत देखाणार तीन खाराब जीवाह एजगेरान, जेनवेरान, एने जुठा जाणकारान मुयाम रेन निकेलतालो दिख्यो। <verse eid="REV 16:13"/><verse number="14" style="v" sid="REV 16:14"/>ज्या चोमेत्कार केरनार सैतानान खाराब जीव हेते। जा तीन जीव आखी दुनियान राजा फाय निकलीन ज्यानकेरता जातेह, काय ताह आखाह रेन ताकेतवाला बोगवानान ता मोटला दिह्यान लेड़ायीन केरता टुलो केरी। <verse eid="REV 16:14"/><verse number="15" style="v" sid="REV 16:15"/><note caller="+" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="MAT 24:43">मत्ती 24:43</ref>,<ref loc="MAT 24:44">44</ref>; <ref loc="LUK 12:39">लुका 12:39</ref>,<ref loc="LUK 12:40">40</ref>; <ref loc="REV 3:3">प्रकाशितवाक्य 3:3</ref></char></note>“हुमलो! चोर जिहकेरीन आवीह तिहेस केरीन मी उचकाहुच आव लागुह! बोरकेतवाला ता हेते जा वाट जोवती रेतेह, एने तान फाड़का तियार मेलतेह, ताकाय ताह उगड़ा नाय फिरी एने ताह माणहान ओंगाण लाजवाणे नाय पोड़ी!”<verse eid="REV 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 16:16"/>ओवतो खाराब जीव राजाह एने तान सेनाह ती जागे टुलो केऱ्या, जाह इब्रानी बाषा माय आरमागीदोन केतेह।<verse eid="REV 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 16:17"/>तेवी हातवो हेरोगदुत तान वाटकाह वारा पोर टाक दिनो। एने हेरगान मोंदिरा माय बोगवानान राजगादिम रेन एक जोरदार आवाज ज्यो कितेन होमलानो, “आखो काय पुरो एय गीयो!” <verse eid="REV 16:17"/><verse number="18" style="v" sid="REV 16:18"/><note caller="+" style="x"><char style="xo" closed="false">16:18 </char><char style="xt" closed="false"><ref loc="REV 8:5">प्रकाशितवाक्य 8:5</ref>; <ref loc="REV 11:13">11:13</ref>,<ref loc="REV 11:19">19</ref></char></note>पोशो विजली चोमेकणी, आवाज, एने वादलान गाजणे, एने बिय आवी ओहली देरती फाटनी। माणहाह देरती पोर बोणनेन पेल ओली जोरे देरती केदीच नाह फाटनी! <verse eid="REV 16:18"/><verse number="19" style="v" sid="REV 16:19"/>तेवी मोटला हेयरान तीन बाग एय गीया। एने आखा देसान गाव खेतेम एय गीया। बोगवान मोटला बाबिलोन हेयराह डेंड आपणेन केरता ईर किऱ्यो एने बोगवान ताह तान बुड़कील रागान दारा माय बोरायेल पियालो ताह पिणेन केरता आप्यो। <verse eid="REV 16:19"/><verse number="20" style="v" sid="REV 16:20"/><note caller="+" style="x"><char style="xo" closed="false">16:20 </char><char style="xt" closed="false"><ref loc="REV 6:14">प्रकाशितवाक्य 6:14</ref></char></note>एकेक टापु तान जागे रेन हेरकी गीया, एने बोयड़ान ते पुतो बी नाह चालनो। <verse eid="REV 16:20"/><verse number="21" style="v" sid="REV 16:21"/><note caller="+" style="x"><char style="xo" closed="false">16:21 </char><char style="xt" closed="false"><ref loc="REV 11:19">प्रकाशितवाक्य 11:19</ref></char></note>जुगाम रेन माणहा पोर मोण मोण बोरीन गारा पोड़ना, जा चालीह किलोन एता, ज्यी पिड़ान केरता माणहे बोगवानान चिहटा केऱ्या, काहाकाय ज्यी पिड़ा वेठाय नाय ओहली एती।<verse eid="REV 16:21"/></para>
  <chapter eid="REV 16"/>
  <chapter number="17" style="c" sid="REV 17"/>
  <para style="s">नाव लायेल बायकु</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 17:1"/>ज्यान पासाण जा हात हेरोगदुता फाय हात वाटका एता ता माय रेन एक आवीन माहु केयो, “न्या आव, मुठलो हियोर जो मोकतास नेदी हेऱ्यी बोह रेनीह, मी ती सिनालो केरनारीन डेंड तुवाह देखाडुह। <verse eid="REV 17:1"/><verse number="2" style="v" sid="REV 17:2"/>ज्यी हेऱ्या दुनियान राजा सिनालो किरेल एता, एने दुनियान माणहे तीन सिनालान दारा केरीन खोवाय जायेल एता।”<verse eid="REV 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 17:3"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">17:3 </char>
      <char style="xt" closed="false">
        <ref loc="REV 13:1">प्रकाशितवाक्य 13:1</ref>
      </char>
    </note>ज्यान पासाण पुरी रिती से जीव माहु ताबाम केऱ्यो, एने हेरोगदुत माहु एक जेंगला माय ली गीयो। ता मी रातला फाड़का पेरीन खाराब जेनवेरा पोर एक बायकुह बोह रियेल दिख्यो; ता पोर बोगवानान चिहटान नावाह आखी जागी लिखेल एतो एने जेनवेरान हात मुंड एने दोह हिंग एता। <verse eid="REV 17:3"/><verse number="4" style="v" sid="REV 17:4"/>ती बायकु जामण्या एने रातला फाड़का पिर रियेल एती, एने ती होनान एने हिरामोतीन गेयणा माय हिंगराय रियेल एती, एने तीन आथा माय एक होनान सिंगुल ईतो। तो खाराब वोस्तु एने सिनालान एठा पोणा केरीन बोरायेल ईतो। <verse eid="REV 17:4"/><verse number="5" style="v" sid="REV 17:5"/>तीन निंडालो पोर ज्यो नाव लिखेल एतो: “मालमात, मोटलो बाबिलोन सिनालो केरनारान एने देरतीन खाराब वोस्तुन आहख।” <verse eid="REV 17:5"/><verse number="6" style="v" sid="REV 17:6"/>एने मी ती बायकुह बोगवानान माणहान लुय एने यीशुन केरता माराय जायेल एता।</para>
  <para style="p" vid="REV 17:6">जेवी मी तीह दिख्यो तेवी मी पुरी रिती से बोंगलाय गीयो। <verse eid="REV 17:6"/><verse number="7" style="v" sid="REV 17:7"/>तेवी तो हेरोगदुत माहु केयो, “तु काहा बोंगलाह? मी हात मुंड एने दोह हिंगवाला जेनवेराह एने ता पोर बोहणारी बायकुन मालमात तुवाह केह।” <verse eid="REV 17:7"/><verse number="8" style="v" sid="REV 17:8"/><note caller="+" style="x"><char style="xo" closed="false">17:8 </char><char style="xt" closed="false"><ref loc="REV 11:7">प्रकाशितवाक्य 11:7</ref></char></note>जो जेनवार तु दिखेल हे, तो पेल केवी तीबी जिवतालो एतो पुण एवी जिवतालो नाह सोतो; तीबी तो नेरेग कुंड माय रेन बाहेर निकली तेवी तान नास एय जाय। दुनियान सुरवाती रेन जा माणहान नाव जीवणान पुस्तेक माय लेखाय नाह गीयो, ता जेनवेराह जो पेल जिवतालो एतो पुण एवी जिवतालो नाह सोतो, पुण तो पोशो आवण्यो हे, ज्यो देखीन दुनियान आखा माणहे बोंगलाय जाती।<verse eid="REV 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 17:9"/>ज्यो सोमेजणेन केरता इकेल एने बुद्दी जुवी। ता हात मुंड हात बोयड़ा हेते, जा पोर ती बायकु बोह रेनीह। एने ता हात राजा बी हेते: <verse eid="REV 17:9"/><verse number="10" style="v" sid="REV 17:10"/>ता माय रेन पाच राजा पोड़ जायेल हेते, एक राजा एवी बी राज केरने बाजरिनोह, एने दुसरो एक एवी वोर आवो नाह, एने जेवी तो आवी; तेवी थोड़ीक वार ने केरता राज केरी। <verse eid="REV 17:10"/><verse number="11" style="v" sid="REV 17:11"/>एने तो जेनवेर एक टेम माय जिवतालो एतो, पुण एवी जिवतालो नाह सोतो, जो ता हात राजा माय रेन एक हे तान बी नास एण्यो हे।<verse eid="REV 17:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 17:12"/>“दोह हिंग जा तु दिखेल ईतो, ता दोह राजा हेते, जा एवी वोर तान राज केरनेन सुरवात नाह किरेल सोता, पुण ताह जेनवारा हेऱ्यो थोड़ीक वार राज केरनेन केरता आदिकार आपाय जाय। <verse eid="REV 17:12"/><verse number="13" style="v" sid="REV 17:13"/>ता आखा राजा एक मोन एती, एने ता आप आपणी ताकेत एने आदिकार जेनवेराह आपती। <verse eid="REV 17:13"/><verse number="14" style="v" sid="REV 17:14"/>ता आखा मेंड्रान विरोद माय लेड़ाय केरती, पुण मेंड्रो तान हादाड़ील, निवाड़ेल, एने बोरहावाला चेलाह टुलो केरीन ताह आरवी देय, काहाकाय तो मालीक ने मालीक एने राजान राजा हे।”<verse eid="REV 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 17:15"/>तेवी हेरोगदुत माहु केयो, “जी नेदी हेऱ्यो तु सिनालो केरनार बायकुह बोह रियेल दिखेल हे, तो देस, माणहे, गेराणो, एने बाषान टुलो हे।” <verse eid="REV 17:15"/><verse number="16" style="v" sid="REV 17:16"/>जा दोह हिंग एने जेनवेराह तु दिखेल ईतो; ता एने जेनवेर ती सिनालो केरनार बायकुह कुयराय केरीन ती फाय रेन आखो काय सांडाड़ लेती एने तिह उगड़ी केर देती; एने ता तीन सेरीराह खाय जाती एने तीह आक्‍ठा माय हेलगाड़ देती। <verse eid="REV 17:16"/><verse number="17" style="v" sid="REV 17:17"/>बोगवान तान वात पुरो केरनेन केरता ता आखाह एक मोन किर दियेल हे, तान मोना माय ज्योच बोहाड़ दियेल हे काय ता जाह वोर बोगवानान कियेल वात पुरी नाह एय जात, ताह वोर राज केरनेन आप आपणो आदिकार ता जेनवेराह राज होप देय।<verse eid="REV 17:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 17:18"/>“जी बायकुह तु दिखेल ईतो, तो मोटलो हियोर हे एने आखी दुनियान राजा पोर राज किरेह।”<verse eid="REV 17:18"/></para>
  <chapter eid="REV 17"/>
  <chapter number="18" style="c" sid="REV 18"/>
  <para style="s">बाबिलोन हियोर पोड़ जाणे</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 18:1"/>ज्यान पासाण मी एक उंजु हेरोगदुताह हेरगाम रेन उतेरतालो दिख्यो। ताह मुठलो आदिकार ईतो, एने देरती तान उजाला केरीन चोमेक उठनी। <verse eid="REV 18:1"/><verse number="2" style="v" sid="REV 18:2"/><note caller="+" style="x"><char style="xo" closed="false">18:2 </char><char style="xt" closed="false"><ref loc="REV 14:8">प्रकाशितवाक्य 14:8</ref></char></note>तो मोठेस आयड़ीन केयो, “मोटलो बाबिलोन पोड़ गीयो! पोड़ गीयो! तो खाराब जीवान जागु; एने आखी बातीन एठी जीवान ईड्डो एने एकेक एठा एने खाराब चीड़ान ईड्डो एय गीयोह। <verse eid="REV 18:2"/><verse number="3" style="v" sid="REV 18:3"/>काहाकाय आखा देस तान दारो मतलब खाराब ने बियावी ओहली आदेतीह पियेल हेते। ज्यी देरतीन राजा ती हेऱ्या खाराब सिनालो किरेल हेते, एने देरतीन वेपारी तान हुख ने कारेण मालदार एती गीयाह।”<verse eid="REV 18:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 18:4"/>पुशो मी हेरगा माय रेन ज्यो आवाज होमल्यो:</para>
  <para style="q1" vid="REV 18:4">“एय मारा माणहा! ता माय रेन निकलीन न्या आवो!</para>
  <para style="q2" vid="REV 18:4">एने तान पापा माय तुमू बागीदार मा बुणो;</para>
  <para style="q2" vid="REV 18:4">तेवी ता पोर आवणार डेंडाह रेन वोच सिकहो!<verse eid="REV 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="REV 18:5"/>काहाकाय तान पाप हेरगा माय वोर पोच गीयो,</para>
  <para style="q2" vid="REV 18:5">एने बोगवान तान गेलेत कामाह ईर किरेल हे।<verse eid="REV 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 18:6"/>तुमू बी ता हेऱ्या ठिक तोहलोस वेवारो किरो;</para>
  <para style="q2" vid="REV 18:6">जिहकेरीन काय जो तो तुमरी हिऱ्यो किरेल हे।</para>
  <para style="q1" vid="REV 18:6">तान बोदले ताह दुय गुणा आपो,</para>
  <para style="q2" vid="REV 18:6">तुमरी केरता तो वाटका माय दारो बेचकील हे तिहेस केरीन तुमू तान केरता बिचको।<verse eid="REV 18:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 18:7"/>काहाकाय जी बोड़ाय एने ईजुत ती आपणे आपाह आपेल हे,</para>
  <para style="q2" vid="REV 18:7">तिहेस केरीन तुमू तीह दुख आपो।”</para>
  <para style="q1" vid="REV 18:7">काहाकाय ती मोना माय किथे रिथे,</para>
  <para style="q1" vid="REV 18:7">“मी राणी हे!</para>
  <para style="q2" vid="REV 18:7">मी रांडायेल नाह सोती,</para>
  <para style="q2" vid="REV 18:7">मी केदी बी काल्लो दुख नाय मोणावु!<verse eid="REV 18:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 18:8"/>केरीन ती पोर एकुस दिह्या माय पिड़ा आव पोड़ी, मोत, दुख, एने काल।</para>
  <para style="q1" vid="REV 18:8">एने तीह आक्‍ठा माय हेलगाड़ाय जाय,</para>
  <para style="q2" vid="REV 18:8">काहाकाय तीन नियाव केरनार मालीक बोगवान ताकेतवालो हे।”<verse eid="REV 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 18:9"/>ज्यी दुनियान जा राजा ती हेऱ्यो सिनालो किरेल एने हुक माय जियेल एता, ता तीन हेलेगताला दुवाड़ाह देखती एने ता तीन केरता रेड़ती एने दुख मोणावती। <verse eid="REV 18:9"/><verse number="10" style="v" sid="REV 18:10"/>तीन पिड़ा देखीन ता बियीन सेटा उबरीन केती, “एय मुठलो हियोर बाबिलोन! एय मोजबुत गाव, हाय! हाय! एकताल माय तुवाह सेजा जुड़ गियी!”<verse eid="REV 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 18:11"/>देरतीन वेपारी तीन केरता रेड़ती एने दुख मोणावती, काहाकाय तान कुण बी लेय नाय; <verse eid="REV 18:11"/><verse number="12" style="v" sid="REV 18:12"/>मतलब होनो चांदी, मोंगाला दिगोड़ एने हिरो, हुवाल्ला एने जामण्या फाड़का, रेशमी एने रातला फाड़का, आखी बातीन मोग मोग गेंदाणे लाकड़े एने आथीन दातान बाणायेल वोस्तु, मोंगालो लाकोड़, पितेल, लोखंडो एने गेराम लागणार आखी वोस्तु। <verse eid="REV 18:12"/><verse number="13" style="v" sid="REV 18:13"/>एने दालचीनी, मासालो, एसेल गेंदाणार वोस्तु, हालीयान डिक; दारो, तेल, मोयदो, गोव, गाय बुयेल, मेंड्रा बोकड्या, गोड़ा, तांगो, पावोर, सेरीर एने माणहान जीव वोर। <verse eid="REV 18:13"/><verse number="14" style="v" sid="REV 18:14"/>वेपारी तीह केती, “त्यु आख्‍यु हाजी वोस्तु जी माय तार जीव खुस एतो, तो आखो एवी खेतेम एय गीयोह, एने तार आखी ईजुत जात रियेल हे, तु एवी ती वोस्तुह केदी बी होद नाय सिकहे!” <verse eid="REV 18:14"/><verse number="15" style="v" sid="REV 18:15"/>ता वेपारी जा ज्यी वोस्तुन वोजेसे मालदार बोण जायेल एता, ता आखा तीन पिड़ा माय बागीदार एणेन बिय ने कारेण वोजेसे सेटास उबरेती। ता रेड़ती एने दुख मोणावती,<verse eid="REV 18:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 18:16"/>एने केती, “हाय! हाय!” तो मुठलो हियोर हाजा हुवाल्ला, जामण्या एने रातला फाड़का पिर रियेल एतो, एने होनो, मोंगाला दिगोड़, एने हिरामोती माय होबाय रियेल एतो! <verse eid="REV 18:16"/><verse number="17" style="v" sid="REV 18:17"/>एकताल माय तीन मालदेन खेतेम एय गीयो!</para>
  <para style="p" vid="REV 18:17">एकेक डोंडह्यो चालाड़णार एने ता जा डोंडह्या माय पारवास केरतेह, एने मल्लाह जा देरीया माय वेपार केरतेह, सेटा उब रेना। <verse eid="REV 18:17"/><verse number="18" style="v" sid="REV 18:18"/>जेवी माणहे तीन हेलेगणेन दुवाड़ाह देखीन आयड़ीन केया: “काय ज्या मोटला हेयरान गेत एगदो दिहरो हियोर बुणील!” <verse eid="REV 18:18"/><verse number="19" style="v" sid="REV 18:19"/>ता आखा तान मुंडी पोर रेजड़ो टाकती एने रेड़ती एने दुख मोणावती जाईन केती, मुठलो हियोर “हाय! हाय! ज्यो कोलोक बयंकर एने केठीण हे। ज्यान मालदेनान द्‍वारे देरीयान आखा डोंडह्यावाला मालदार एय जायेल एता, एने एकताल माय ता हेयरान आखो काय उजड़ी गीयो!”<verse eid="REV 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 18:20"/>एय हेरोग, एने एय बोगवानान माणहा, प्रेरित, जाणकार तीन खेतेम एणेन कारेण खुसी मोणावो! काहाकाय बोगवान तीह ठिक तोहलोस डेंड आपेल हे जिहकेरीन ती तुमूह आपेल एती!<verse eid="REV 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 18:21"/>पुशो एक ताकेतवान हेरोगदुत मोटली गेरटीन पुड़ान गेत एक देगड़ाह उखील लिदो, एने ज्यो किन देरीया माय जुगार दिनो, “ज्यो मुठलो हियोर बाबिलोन इहीचकेरीन निचो जुगाराय जाय, एने तान केदी बी पुतो नाय चाली। <verse eid="REV 18:21"/><verse number="22" style="v" sid="REV 18:22"/>रेणथो वाजाड़नार, गायेक, पावली वाजाड़नार, एने पावलो फुकणारान आवाज पोशो केदी बी तुवा माय होमलाय नाय देय; एने एवी रेन काल्लो बी काम केरनार माणुह कुणूस तुवा माय पोशो केदी बी नाय जुड़ी; एने गेरटी चालाड़नेन आवाज तार माय पोशो केदी होमलाय नाय देय! <verse eid="REV 18:22"/><verse number="23" style="v" sid="REV 18:23"/>एने दिवान उजालो तुवा माय पोशो केदी बी देखाय नाय, एने वोवड़ान एने वोवड़ीन आवाज पोशो केदी बी तुवा माय होमलाय नाय देय। काहाकाय तार वेपारी दुनिया माय ताकेतवाला एता, एने देरतीन आखा माणहे तार जुठा चोमेत्कारान वोजेसे बारमाय जायेल एता!”<verse eid="REV 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 18:24"/>एने देरती पोर माराय जायेल ता आखा बोगवानान माणहान, एने जाणकारान लुय बाबिलोन हेयरा माय सापड़ेल हे।<verse eid="REV 18:24"/></para>
  <chapter eid="REV 18"/>
  <chapter number="19" style="c" sid="REV 19"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 19:1"/>ज्यी आखी वातुन पासाण हेरगा माय मोकतास माणहान एक मोठेस आयेड़नेन आवाज मी होमल्यो, “बोगवानान स्तुती एय! सुटकारो, बोड़ाय, एने ताकेत आमरा यीशु मसीन हे! <verse eid="REV 19:1"/><verse number="2" style="v" sid="REV 19:2"/>काहाकाय तान नियाव खीरलो एने ठिख हे! तो ती सिनालो केरनारीह जी तीन सिनाला केरीन आखी देरतीन माणहाह खाराब किरेल एती। बोगवान नियाव केरीन तान पावोर ने खुन ने बुदलो लियेल हे।” <verse eid="REV 19:2"/><verse number="3" style="v" sid="REV 19:3"/>ता माणहे पोशा दुसरी वार आयड़ीन केया, “बोगवानान स्तुती एय! तान हेलेगणेन दुवाड़ो कायेम कायेम उड़ती रेय।” <verse eid="REV 19:3"/><verse number="4" style="v" sid="REV 19:4"/>तेवी चोववीस डायला माणहे, एने चार जेनवारे पाया पोड़ीन वोंद्या एने बोगवानान आरादना केऱ्या जो राजगादि पोर बोह रियेल ईतो। एने केया, “आमेन! बोगवानान स्तुती एय!”<verse eid="REV 19:4"/></para>
  <para style="s">मेंड्रान वाराड़ान खाणो</para>
  <para style="p">
    <verse number="5" style="v" sid="REV 19:5"/>तेवी राजगादि माय रेन एक आवाज आवो, “आखा तान पावोर एने आखा माणहे दुयू आतल्या मोटला आमरा बोगवानान स्तुती किरो, तुमू जा ताह बितेह!” <verse eid="REV 19:5"/><verse number="6" style="v" sid="REV 19:6"/>पोशो मी एक मोटली माणहान गेरदीन गेत पाण्यान वोयणेन गेत एने वादलान मोठेस आयेड़णारान गेत आवाज होमलेल, “बोगवानान स्तुती एय!” काहाकाय आमरो मालीक आमरा ताकेतवाला बोगवानान राजा हे! <verse eid="REV 19:6"/><verse number="7" style="v" sid="REV 19:7"/>आवो, आपु खुस एने आनन्दित एता; एने तान महानतान केरीन तान बोड़ाय केरता, एने मेंड्रान वाराड़ान टेम आव लागेल हे, काहाकाय तान लाडी आपणे आपाह तियार किरेल हे।<verse eid="REV 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 19:8"/>तीह साप सुतरा, चोमेकदार, हुवाल्ला फाड़का पेरनेन केरता आपाय गीयाह। काहाकाय ता हुवाल्ला फाड़का बोगवानान माणहान हाजा कामान निसाणी हे।<verse eid="REV 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 19:9"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">19:9 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 22:2">मत्ती 22:2</ref>,<ref loc="MAT 22:3">3</ref></char>
    </note>तेवी हेरोगदुत माहु केयो, “ज्यो लिख, बोरकेतवाला माणहे ता हेते, जा मेंड्रान वाराड़ा माय खाणेन केरता हादाय जायेल हेते।” एने हेरोगदुत माहु पोशो केयो, “ज्या बोगवानान खेरला वचन हेते।”<verse eid="REV 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 19:10"/>तेवी मी तान आरादना केरनेन केरता तान पाया हिऱ्यो पोड़ गीयो। पुण तो माहु केयो, “देख, इहकेरीन मा केरी, मी तार गेत एने दिहरा बुरहो केरनारान गेत एक पावोर हे, ता आखा यीशु देखाड़ेल खेरायीह देर रेनाह। बोगवानान आरादना किर!”</para>
  <para style="p" vid="REV 19:10">काहाकाय जो खेराय यीशु देखाड़ेल हे तो जाणकाराह खुस किरेह।<verse eid="REV 19:10"/></para>
  <para style="s">दोवल्या गोड़ा पोर बोहणार</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 19:11"/>पुशो मी हेरगाह उगेड़तालो दिख्यो, एने ता एक दोवल्यो गुड़ो ईतो। ता गोड़ा पोर बोहणारान बोरहावाला एने सिदो केवाथी; काहाकाय तो खेराय हेऱ्यो हुमच्यो किरेह एने तान लेड़ाय लिड़ेह। <verse eid="REV 19:11"/><verse number="12" style="v" sid="REV 19:12"/>तान डोला ओहला एता मानु आक्‍ठान आसने गेत एय, एने तान मुंडा पोर मोकतास मुकूट एता। ता पोर एक नाव लिखेल एतो, पुण ताह सोड़ीन तो काय हे कुणीस नाह जाणतालो। <verse eid="REV 19:12"/><verse number="13" style="v" sid="REV 19:13"/>तो ओहला फाड़का पिर रियेल ईतो जा लुय माय बुड़ायेल एय। एने तान नाव “बोगवानान बोल हे।” <verse eid="REV 19:13"/><verse number="14" style="v" sid="REV 19:14"/>हेरगान सेना दोवल्या गोड़ा पोर दोवल्या, साप एने हाजाला हुवाल्ला फाड़का पेरीन मेंड्रान पासाण पासाण जाणे बाजरियेल एती। <verse eid="REV 19:14"/><verse number="15" style="v" sid="REV 19:15"/><note caller="+" style="x"><char style="xo" closed="false">19:15 </char><char style="xt" closed="false"><ref loc="REV 14:20">प्रकाशितवाक्य 14:20</ref></char></note>देसा देसान माणहाह आरेवणेन केरता मेंड्रान मुया माय रेन एक तेज दारवाली तालवार निकेलने बाजरियेल एती। तो ता उपेर लोखंडान राजडिंगो लेन राज केरी, एने तो आखाह रेन ताकेतवान बोगवानान रागा केरीन दारान कुंड माय अंगुराह रोहंदली। <verse eid="REV 19:15"/><verse number="16" style="v" sid="REV 19:16"/>तान फाड़का एने जांग पोर ज्यो नाव लिखेल एतो: “राजान राजा एने मालीक ने मालीक!”<verse eid="REV 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 19:17"/>पुशो मी एक हेरोगदुताह दिह्या माय उबरियेल दिख्यो। तो मोठेस आयड़ीन जुगाम उड़णारा चीड़ाह केयो, “आवो एने बोगवानान मोटला खाणान केरता एकठा एय जावो! <verse eid="REV 19:17"/><verse number="18" style="v" sid="REV 19:18"/>आवो एने राजान माह, मुखीन, सिपायान, गोड़ान एने ता पोर बोहणारान, आजाद, पावोर, आत्या मोठान एने आखा माणहान सेरीर खावो!”<verse eid="REV 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 19:19"/>पुशो मी ता जेनवेराह एने दुनियान राजाह दिख्यो, ता हेऱ्यी तान सेना एती एने गोड़ा पोर बोह रियेल माणहा एने तान सेना हेऱ्या लेड़ाणेन केरता एकठा ईयेल एता। <verse eid="REV 19:19"/><verse number="20" style="v" sid="REV 19:20"/><note caller="+" style="x"><char style="xo" closed="false">19:20 </char><char style="xt" closed="false"><ref loc="REV 13:1-18">प्रकाशितवाक्य 13:1-18</ref></char></note>ता जेनवेराह एने जुठा जाणकाराह जो तान ओंगाण चोमेत्कार देखाड़तालो, ता दुयूह बोंदी बोणाव लेदा। जो चोमेत्कार केरीन माणहाह ठेगतालो। एने जा माणहे जेनवेरान साप लियेल एता एने जा माणहे मुरतीन पुजा केरताला। जेनवेराह एने जुठा जाणकाराह दुयूह बी हेलेगताला गंदक एने आक्‍ठान जोवरा माय जीवतालाच टाकाय गीया। <verse eid="REV 19:20"/><verse number="21" style="v" sid="REV 19:21"/>बाकी वोचेल सिपाय ता गोड़ा पोर बोह रियेल माणहान मुया माय रेन निकेलनार तेज दारवाली तालवार केरीन माराय गीया; एने आखा चीड़ा तान माह खाईन आफरी गीया।<verse eid="REV 19:21"/></para>
  <chapter eid="REV 19"/>
  <chapter number="20" style="c" sid="REV 20"/>
  <para style="s">एक एजार वोरह्या</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 20:1"/>पुशो मी हेरगाम रेन एक हेरोगदुताह उतेरतालो दिख्यो, तान आथा माय नेरेग कुंड ने कुची एने एक मोटली हाकुल एती। <verse eid="REV 20:1"/><verse number="2" style="v" sid="REV 20:2"/>हेरोगदुत ता एजगेराह जो जुनालो गेयड़ेक खाराब एने सैतान हे, ताह एजार वोरह्यान केरता देरीन बांद दिनो। <verse eid="REV 20:2"/><verse number="3" style="v" sid="REV 20:3"/>तेवी तो हेरोगदुत ताह नेरेग कुंड माय बोंद केरीन तालो लागाड़ दिनो, एने ता पोर एक सिक्को लागाड़ दिनो, ताकाय जाह वोर एक एजार वोरह्या पुरा नाय एती ताह वोर देसा देसान माणहाह बोटकाव नाय सेकी। एक एजार वोरह्या पुरा एणेन पासाण ताह थोड़ीक वार ने केरता आजाद केराय जाय।<verse eid="REV 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 20:4"/>पुशो मी राजगादि एने ती पोर बोह रियेल माणहाह दिख्यो, ताह नियाव केरनेन आदिकार आपाय जायेल एतो। मी ता माणहान जीव बी दिखेल, जान मुंड यीशुन गोवाही केणेन वोजेसे एने बोगवानान वचन केणेन कारेण काटायेल एतो। ता जेनवेरान एने मुरतीन पुजा नाह किरेल एता, एने ता तान साप निंडाला एने आथा पोर नाह लियेल एता। ता आखा माणहे जीवताला एन मसी हेऱ्या राजान गेत एक एजार वोरह्या वोर राज केरती। <verse eid="REV 20:4"/><verse number="5" style="v" sid="REV 20:5"/>बाकी माणहे जाह वोर जीव नाय उठती ताह वोर एक एजार वोरह्या खेतेम नाह एना। ज्यो पेल्लो जीव उठणो हे। <verse eid="REV 20:5"/><verse number="6" style="v" sid="REV 20:6"/>बोरकेतवालो एने चोखालो माणुह तो हे, जो पेल्ला जीव उठणा माय बेलायेल हे। ओहला माणहा पोर दुसरी मोतीन कायस बी आदिकार नाय मिली; पुण ता बोगवानान एने मसीन चाकऱ्या एती, एने ता हेऱ्या एक एजार वोरह्या वोर राज केरती।<verse eid="REV 20:6"/></para>
  <para style="s">सैतानान आरवाणो</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 20:7"/>जेवी एक एजार वोरह्या पुरा एय जाती, तेवी सैतानाह जेली माय रेन सोड़ देय, <verse eid="REV 20:7"/><verse number="8" style="v" sid="REV 20:8"/>एने सैतान आखी देरती पोर पोसरील देसाह पोटाड़नेन केरता निकेल पोड़ी, गोग एने मागोग न्याह पोटाड़ी। एने ताह लेड़ाणेन केरता टुलो केरी, ता देरीयान रेटान गेत गेणाय नाय ओलाक रेती। <verse eid="REV 20:8"/><verse number="9" style="v" sid="REV 20:9"/>ता आखी देरती पोर पोसरी जाती एने बोगवानान माणहान गेराह एने तान मोंगाल्ला हेयराह चार उगे रेन कोंड लेती। पुण हेरगाम रेन बोगवाना उगे रेन आक्‍ठो नेचो आवी एने ताह खेतेम केर देय। <verse eid="REV 20:9"/><verse number="10" style="v" sid="REV 20:10"/>तेवी सैतान जो ताह दोका माय मेलतालो आक्‍ठो एने गंदक ने जोवरा माय टाकाय गीयो, जा तो जेनवार एने जुठा जाणकार हेते; ता कायेम ताहरी रात ने दिह पिड़ा माय वेला केरती।<verse eid="REV 20:10"/></para>
  <para style="s">मोटली राजगादि एने आखरी नियाव</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 20:11"/>पुशो मी एक दोवल्यी मोटली राजगादि एने जो ती पोर बोह रियेल हे, ताह दिख्यो। तान ओंगाण रेन देरती एने जुग नाह गीया, एने तान पुतो वोर नाह चालनो। <verse eid="REV 20:11"/><verse number="12" style="v" sid="REV 20:12"/>एने मी ता मुरेलाह जा आत्या मोठा एता, ताह बोगवानान राजगादिन सामने उबरियेल दिखेल। एने पुस्तेक खोलाय गीया, तान पासाण जीवणान पुस्तेक खोलाय गियी। मुरेल माणहान नियाव पुस्तेक माय जिहकेरीन लिखेल एतो, तिहेस केरीन तान कामान गेत नियाव एनो। <verse eid="REV 20:12"/><verse number="13" style="v" sid="REV 20:13"/>तेवी देरीया माय जा मुरेल एता ताह तो आप दिनो। मोत एने आंदारकेली माय जा माणहे एता, ताह तो आप दिनो। एने आखा माणहान नियाव तान कामान गेत एनो। <verse eid="REV 20:13"/><verse number="14" style="v" sid="REV 20:14"/>मोत एने आंदारकेली आक्‍ठान जोवरा माय टाकाय गीया। ज्यो आक्‍ठान जोवोर आखरी मोत हे। <verse eid="REV 20:14"/><verse number="15" style="v" sid="REV 20:15"/>एने जा बी माणहान नाव जीवणान पुस्तेक माय लिखेल नाह जुड़नो, ता माणहे आक्‍ठान जोवरा माय टाकाय गीया।<verse eid="REV 20:15"/></para>
  <chapter eid="REV 20"/>
  <chapter number="21" style="c" sid="REV 21"/>
  <para style="s">नोवालो जुग एने नोवाली देरती</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 21:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">21:1 </char>
      <char style="xt" closed="false">
        <ref loc="2PE 3:13">2 पतरस 3:13</ref>
      </char>
    </note>ज्यान पासाण मी एक नोवालो जुग एने नोवाली देरतीह दिख्यो। काहाकाय पेल्लो जुग एने देरती आरताय जायेल एतो, एने देरीयो बी नाह रियेल एतो। <verse eid="REV 21:1"/><verse number="2" style="v" sid="REV 21:2"/><note caller="+" style="x"><char style="xo" closed="false">21:2 </char><char style="xt" closed="false"><ref loc="REV 3:12">प्रकाशितवाक्य 3:12</ref></char></note>तेवी पुशो मी चोखालो हियोर नोवालो यरूशलेम, बोगवानान उगे रेन आमरा वोवड़ान केरता तियार वोवड़ीन गेत हेरगाम रेन नेचो उतेरतालो दिख्यो। <verse eid="REV 21:2"/><verse number="3" style="v" sid="REV 21:3"/>पुशो मी राजगादि माय रेन कुणी तीबी मोठेस आयड़ीन ज्यो केतालो होमल्यो: “दिखो, एवी बोगवानान गेर माणहान विची माय हे! एने बोगवान ता हिऱ्यो रेय, एने ता तान माणहे एती। बोगवान खुद ता हिऱ्यो रेय, एने तान बोगवान एय। <verse eid="REV 21:3"/><verse number="4" style="v" sid="REV 21:4"/>बोगवान तान डोलाम रेन आखा आहवा नुस देय। एने ज्यान पासाण मोत, दुख, रेड़नो नाय रेय, एने पिड़ा बी खेतेम एय जाय। काहाकाय जुनाल्यु वातु एवी गायेब एय गीयो।”<verse eid="REV 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 21:5"/>पुशो जो राजगादि पोर बोह रियेल ईतो तो केयो, “दिखो, मी आखी वातुह नोवाली केर देथु!” एने तो माहु ज्यो बी केयो, “ज्यो लिख ली, काहाकाय ज्यी वातु खेरली एने बोरहान लायकीन हे।” <verse eid="REV 21:5"/><verse number="6" style="v" sid="REV 21:6"/>ज्यान पासाण तो माहु पोशो केयो, “ज्यी वात पुरी एय जायेल हे! मी अल्फा एने ओमेगा, सुरवात एने अन्त हे। जो कुण तिहल्यो हे ताह मी जीवणान जिरा माय रेन फुकेट पिणेन आदिकार आपुह। <verse eid="REV 21:6"/><verse number="7" style="v" sid="REV 21:7"/>जा माणहे जीत हासील केरी तास ज्‍यु वातुह मार फाय रेन सापड़ावती: एने मी तान बोगवान रेह, एने ता मार बेटा बेटी एती। <verse eid="REV 21:7"/><verse number="8" style="v" sid="REV 21:8"/>पुण बिणाराह, अविश्वास केरनारे, खाराब काम केरनाराह, खुन केरनाराह, सिनालो केरनाराह, जादु केरनाराह, मुरतीह पुजा केरनाराह, एने जुठ बोलनारान ईसो ता जोवरा माय रेय, जो आक्‍ठो एने गंदक केरीन हेलेगती रिथे, ज्यी दुसरी मोत हे।”<verse eid="REV 21:8"/></para>
  <para style="s">नोवालो यरूशलेम</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 21:9"/>पोशो हात हेरोगदुता माय रेन एक फाय आखरी हात पिड़ा माय बोरायेल हात वाटका एता, तो मार हेऱ्यो आवीन माहु केयो, “न्या आव, मी तुवाह वोवड़ी मतलब मेंड्रान बायकुह देखाडुह।” <verse eid="REV 21:9"/><verse number="10" style="v" sid="REV 21:10"/>तेवी जीवान द्‍वारे मी ताबाम एनो, एने हेरोगदुत माहु एक मोटला एने उचाच बोयड़ा पोर ली गीयो। तो माहु चोखालो हियोर यरूशलेमाह देखाड्यो, तो बोगवाना फाय रेन हेरगाम रेन नेचो उतेरने बाजरियेल एतो। <verse eid="REV 21:10"/><verse number="11" style="v" sid="REV 21:11"/>एने बोगवानान बोड़ाय हेऱ्यो तो चोमेकणे बाजरियेल एतो। हियोर जुलूम मोंगालो देगड़ान, मतलब यशब ने गेत एने बिल्लोर ने गेत साप सुतरो चोमेकतालो। <verse eid="REV 21:11"/><verse number="12" style="v" sid="REV 21:12"/>ज्या हेयरान बितड़ा उचा एता एने बारा बायणा एता, एने ता बारा बायणा हेऱ्या राखवाली केरनेन केरता बारा हेरोगदुत एता। एने ता बायणा पोर इस्राएल ने बारा गेराणान नाव लिखेल एतो। <verse eid="REV 21:12"/><verse number="13" style="v" sid="REV 21:13"/>न्या माय रेन तीन बायणा दिह उगता उगे: उत्तर दिशान उगे तीन बायणा, दक्शिण दिशान उगे तीन बायणा, दिह बुड़ता उगे तीन बायणा एता। <verse eid="REV 21:13"/><verse number="14" style="v" sid="REV 21:14"/>ज्या हेयरान बितड़ा बारा पायान देगड़ा पोर बाणायेल एतो, एने एकेक पोर मेंड्रान बारा प्रेरितान नाव बारा लिखेल एतो। <verse eid="REV 21:14"/><verse number="15" style="v" sid="REV 21:15"/>जो हेरोगदुत माहु हिऱ्यो वातु केरने बाजरियेल ईतो, ता फाय हेयरा, बायणा, एने हेयरान बितड़ाह मोजणेन केरता होनान एक डेंगी एती। <verse eid="REV 21:15"/><verse number="16" style="v" sid="REV 21:16"/>हियोर चोवकट ने गेत एतो, तान लाम्बाय, चोवड़ाय बाराबोर एती। एने डेंगी केरीन हेयराह तो मोज लेदो: तो दुय एजार चार होव किलो मिटर निकल्लो, तान लाम्बाय एने चोवड़ाय बाराबोर एती। <verse eid="REV 21:16"/><verse number="17" style="v" sid="REV 21:17"/><note caller="+" style="f"><char style="fr" closed="false">21:17 </char><char style="ft" closed="false">उचो; नाहते मोठो। वचन 16 एने 17 माय, ग्रीक लेख माय बारा एजार मिटर कियेल हे, ज्यान जुलूम महत्व एय सिकेह।</char></note>तेवी तो हेयरान बितड़ाह मोज्यो, ते तो एक होव चोवरेचाड़ीस मिटर निकल्लो, ज्यो माप माणहान माप ने गेत एतो जाह हेरोगदुत वापरेल ईतो। <verse eid="REV 21:17"/><verse number="18" style="v" sid="REV 21:18"/>हेयरान बितड़ो यशब नावान देगड़ा केरीन बुणेल एतो, एने हियोर साप सुतरा सिसान गेत चोखो होनान एतो। <verse eid="REV 21:18"/><verse number="19" style="v" sid="REV 21:19"/>एने ता हेयरान पाया आखी बातीन मोंगाला देगड़ा केरीन हिंगारेल एता। पिल्लो दिगोड़ यशब ने, दुसरो निलमणीन, तिसरो लालड़ीन, चोवथो पन्नान, <verse eid="REV 21:19"/><verse number="20" style="v" sid="REV 21:20"/>पाचवो गोमेद ने, साहवो माणिक्यन, हातवो पीतमणीन, आठवो पेरोज ने, नोववी पुखरान, दाहवो लहसनियान, आकरावो दुम्रकान्त ने, एने बारावो चंद्रकांत देगड़ान बुणेल एतो। <verse eid="REV 21:20"/><verse number="21" style="v" sid="REV 21:21"/>बारा बायणा बारा हिरान एता; एकेक बायणो एकुस हिरान बुणेल एतो। एने हेयरान सिड़ीक साप सुतरा सिसान गेत चोखो होनान एती।<verse eid="REV 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 21:22"/>तेवी मी हेयराम काल्लोस मोंदिर नाह दिख्यो, काहाकाय आखाह रेन ताकेतवालो मालीक बोगवान एने मेंड्रोस मोंदिर हे। <verse eid="REV 21:22"/><verse number="23" style="v" sid="REV 21:23"/>ता हेयराह दिह्यान एने चांदान उजालान जोरवुत नाह, काहाकाय बोगवानान तेज केरीन उजालो एणे बाजरेनोह, एने मेंड्रो तान दिवो हे। <verse eid="REV 21:23"/><verse number="24" style="v" sid="REV 21:24"/>देसा देसान माणहे तान उजाला माय चाला फिऱ्या केरती, एने दुनियान राजा जान तान मालदेन ता माय लावती। <verse eid="REV 21:24"/><verse number="25" style="v" sid="REV 21:25"/>ता हेयरान बायणा दिह्या केदी बी बोंद नाय एती, काहाकाय ता रात केदी नाय एय। <verse eid="REV 21:25"/><verse number="26" style="v" sid="REV 21:26"/>आखा देसान माणहे तान ईजुत एने मालदेन ता हेयरा माय लावती <verse eid="REV 21:26"/><verse number="27" style="v" sid="REV 21:27"/>पुण ता माय काल्ली बी एठी वोस्तु केदी बी रिग नाय सेकी, एने नाह खाराब काम केरनारे, एने नाह जुठ बोलणारे ता माय रिग सेकते। पुण तो माणुह ता हेयरा माय रिग सेकी जान नाव मेंड्रान जीवणान पुस्तेक माय लेखायेल हे।<verse eid="REV 21:27"/></para>
  <chapter eid="REV 21"/>
  <chapter number="22" style="c" sid="REV 22"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 22:1"/>ज्यान पासाण हेरोगदुत माहु एक जीवाय आपणार नेदी देखाड्यो, ज्यी नेदी बिल्लोर देगड़ान गेत चोमेकताली, ती बोगवान ने एने मेंड्रान राजगादिम रेन निकेलताली <verse eid="REV 22:1"/><verse number="2" style="v" sid="REV 22:2"/>एने ता हेयरान सेड़कीन विची माय रेन वोयताली। नेदीन दुयू उगे जीवणान जाड़ एता, ता जाड़ा पोर एकेक टेम माय बारा वार फोल लागताला मोयना माय एक वारीन, एने ता जाड़ान पांटा देसा देसान माणहान केरता हुदेरनेन काम केरताला। <verse eid="REV 22:2"/><verse number="3" style="v" sid="REV 22:3"/>एने हेयारा माय कुण बी बोगवानान हाराप माय नाय रेय।</para>
  <para style="p" vid="REV 22:3">पुण बोगवानान राजगादि एने मेंड्रो ता हेयरा माय रेय, एने तान पावोर तान आरादना केरती। <verse eid="REV 22:3"/><verse number="4" style="v" sid="REV 22:4"/>ता माणहे तान मुय देखती, एने यीशुन नाव तान निंडाला पोर लिखेल रेय। <verse eid="REV 22:4"/><verse number="5" style="v" sid="REV 22:5"/>ता पोशो केदी रात नाय एय, एने ताह दिवान एने दिह्यान उजालान गिरेज नाय पोड़ी, काहाकाय मालीक बोगवान खुद तान उजालो रेय, एने ता राजान गेत कायेम कायेम राज केरती।<verse eid="REV 22:5"/></para>
  <para style="s">यीशुन आवणो</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 22:6"/>पुशो हेरोगदुत माहु केयो, “ज्यी वात खेरली एने बोरहान लायेक हे। एने मालीक बोगवान जो तान जीव जाणकाराह आपेह, तो तान पावोर फाय हेरोगदुताह ज्यानकेरता मुकलेल हे काय जेल्दी एणार वातुह देखाड़ी।”<verse eid="REV 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 22:7"/>एने यीशु केयो, “दिखो, मी जेल्दी आवण्यो हे! बोरकेतवाला माणहे ता हेते, जा माणहे ज्यी पुस्तेकीन जाणाव ने वातुन पालेन केरतेह!”<verse eid="REV 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 22:8"/>मी तोस योहान हे, जो ज्यी वातुह होमलेल एने दिखेल ईतो। ज्यी वातुह देखणे एने होमेलनेन पासाण जो हेरोगदुत माहु ज्यी आखी वातुह देखाड़ेल ईतो, मी तान आरादना केरनेन केरता तान पाया पुड़नो। <verse eid="REV 22:8"/><verse number="9" style="v" sid="REV 22:9"/>पुण तो माहु केयो, “देख, इहकेरीन मा केरी! काहाकाय मी तुमरा बाहख जाणकारान जा ज्यी पुस्तेक माय लिखेल वातुन पालेन केरतेह, एक हाती सेवक हे। बोगवानान ओलीस आरादना किर!” <verse eid="REV 22:9"/><verse number="10" style="v" sid="REV 22:10"/>एने तो माहु पोशो केयो, “ज्यी जाणाव ने पुस्तेकीह लिकाड़ीन मा मिलही, काहाकाय ज्यी आखी वातुन पुरो एणेन टेम आहने हे। <verse eid="REV 22:10"/><verse number="11" style="v" sid="REV 22:11"/>जो नुकसान किरेह तो नुकसानुस केरती रेय, एने जो खाराब हे तो खाराबी मायच बोणीन रेय; एने जो हाजो हे तो हाजोस केरती रेय, एने जो चोखो हे तो चोखालो बोणीन रेय।”<verse eid="REV 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 22:12"/>“हुमलो, मी जेल्दी आवणे माय हे! एने माणहान कामान गेत आपाण्यो हे, तो फोल मार फाय हे। <verse eid="REV 22:12"/><verse number="13" style="v" sid="REV 22:13"/><note caller="+" style="x"><char style="xo" closed="false">22:13 </char><char style="xt" closed="false"><ref loc="REV 1:8">प्रकाशितवाक्य 1:8</ref>; </char><char style="xt" closed="false"><ref loc="REV 1:17">प्रकाशितवाक्य 1:17</ref>; <ref loc="REV 2:8">2:8</ref></char></note>पिल्लो एने सेवल्यो, सुरवात एने आखरी मीच हे।”<verse eid="REV 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 22:14"/>बोरकेतवाला ता हेते जा तान फाड़का दोव लेतेह, काहाकाय ताह जीवणान जाड़ान फोल खाणेन आदिकार जुड़ी, एने ता बायणा माय रेन हेयरा माय जाती। <verse eid="REV 22:14"/><verse number="15" style="v" sid="REV 22:15"/>पुण चिता एने जादु केरनारे, सिनालो केरनारे एने खुन केरनारे, मुरतीन पुजा केरनारे एने आखी बातीन जुठाह मोंग केरनारे एने जुठी वातु बाणावणारे, ता आखा हेयरान बाहेर रेती।<verse eid="REV 22:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 22:16"/>“मी यीशु, मार हेरोगदुताह ज्यानकेरता मुकलेल हे काय तुमरी ओंगाण मोंडली माय ज्यी वातुन गोवाही केय सेकी। मी दाऊद ने गेराणान वोस हे; एने मी विगोस ने चोमेकतालो तारो हे।”<verse eid="REV 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 22:17"/>जीव एने वोवड़ी दुयून केणु हे, “आव!”</para>
  <para style="p" vid="REV 22:17">एने जो होमलेह तो किथे, “आव!”</para>
  <para style="p" vid="REV 22:17">एने जो तिहल्यो हे तो आवी; एने जीवाय ने पाणी फुकेट माय लेय लेय।<verse eid="REV 22:17"/></para>
  <para style="s">निवरनो</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 22:18"/>मी योहान एकेक माणहाह केथु, जो ज्यी पुस्तेकीन जाणाव ने वातुह होमलेह: मार ज्यी चेतावणी हे, केदी तो ज्यी वातु माय काह वोड़ावी, ते बोगवान ज्यी पुस्तेक माय लिखेल पिड़ाह तान केरता वोड़ावी। <verse eid="REV 22:18"/><verse number="19" style="v" sid="REV 22:19"/>केदी एगदो ज्यी जाणाव ने पुस्तेक माय रेन काह काड़ देय, ते बोगवान ताह जीवणान जाड़ एने चोखाला हेयराम रेन, जिहकेरीन ज्यी पुस्तेक माय लिखेल हे, तान ईसो निकाल देय।<verse eid="REV 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 22:20"/>यीशु जो ज्यी वातुन गोवाह हे, तो ज्यो केतेह, “मी जेल्दी आवण्यो हे!” आमेन।</para>
  <para style="p" vid="REV 22:20">एय मालीक यीशु, जेल्दी आव!<verse eid="REV 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 22:21"/>मालीक यीशुन गीण बोगवानान माणहा हेऱ्यो रेय। आमेन।<note caller="+" style="f"><char style="fr" closed="false">22:21 </char><char style="ft" closed="false">आखा माणहे; थोड़ाक लेख माय बोगवानान माणहे लिखेल हे; दिहरा थोड़ाक लेख माय बोगवानान आखा माणहे लिखेल हे।</char></note><verse eid="REV 22:21"/></para>
  <chapter eid="REV 22"/>
</usx>
