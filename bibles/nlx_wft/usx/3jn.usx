<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Nahali</book>
  <para style="h">3 योहान</para>
  <para style="toc3">3 योहान</para>
  <para style="toc2">3 योहान</para>
  <para style="toc1">योहान लिखेल तीसरो पोत्रो</para>
  <para style="mt2">युहन्ना ने लिखा हुआ तीसरा पत्र</para>
  <para style="mt1">योहान लिखेल तीसरो पोत्रो</para>
  <para style="imt">ओलखात</para>
  <para style="ip">तीसरो योहानान पोत्र प्रेरित योहान द्‍वारे मसीन जेल्मान 50-100 वोरह्यान विचीम लेखाय जायेल ईतो। योहान सोताह लेखणारान रूप माय नाह केत, पुण सोताह तो डावालो किथे <char style="xt"><ref loc="3JN 1:1">1:1</ref></char> एने <char style="xt"><ref loc="2JN 1:1">2 योहान 1:1</ref></char> माय बी किथे। ओहलो मानाय जाथे काय योहान योहानान गेत जो हाजाली खुबेर लिखेल ईतो एने इफिसुस माय रेतेन तीन पोत्री 1 योहान, 2 योहान, 3 योहान हेते।</para>
  <para style="ip">योहान ज्यी पोत्रीह गयुस नावान एक माणहाह लिखेल ईतो। योहान गयुसाह एक दोस्तीन रूप माय किथे एने बुरहो केरनारा बायह्याख ने पावणाह उठाड़ने बोहाड़ने जुवे, जा फिरतेह निसाण आप्यो।</para>
  <para style="is">रूपरेखा</para>
  <para style="io1">1. योहान तान पोत्रान ओलखात आप्यो। <char style="ior"><ref loc="3JN 1:1">1:1</ref></char></para>
  <para style="io1">2. ओवतो तो गयुसाह खुस किरेह एने बायह्याख ने पावणाय केरने जुवे केरीन निसाण आप्यो। <char style="ior"><ref loc="3JN 1:2-8">1:2-8</ref></char></para>
  <para style="io1">3. तान बाद तो दुय दिहरा एदमी, दियेत्रफुस एने दिमेत्रयुस ने वात केरने। <char style="ior"><ref loc="3JN 1:9-12">1:9-12</ref></char></para>
  <para style="io1">4. तो सेवली वार तान पोत्री लेखणेन बोंद किरेह। <char style="ior"><ref loc="3JN 1:13-14">1:13-14</ref></char></para>
  <chapter number="1" style="c" sid="3JN 1"/>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:29">प्रेरितान काम 19:29</ref>; <ref loc="ROM 16:23">रोमीयो 16:23</ref>; <ref loc="1CO 1:14">1 कुरिंथीयो 1:14</ref></char>
    </note>योहान डायलान उगे रेन मोंगाल्ला गयुसान नाव, जाह मी खेरीच मोंग केरथु।<verse eid="3JN 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2"/>एय मारा मोंगाल्ला हाती, जिहकेरीन तु जीव माय वोड़ती केरने बाजरिनोह, तिहेस केरीन तु आखी वातु माय वोड़ती किरहे, ते हाजालो रिहे ओहली मी विन्ता केरथु। <verse eid="3JN 1:2"/><verse number="3" style="v" sid="3JN 1:3"/>काहाकाय जेवी बी बुरहो केरनार बाहख आवतेह एने तार ती खेरली गोवाय देतेह, ते मी जुलूम खुस एय जाथु, जी खेरायी माय तु खेरीच जिवेह। <verse eid="3JN 1:3"/><verse number="4" style="v" sid="3JN 1:4"/>मार सोरा खेराय माय चालतेह ज्यो होमलीन माहु ज्यी खुसी जुड़ेह, तोलो दिहरा कायताच केरीन नाह जुड़ेत।<verse eid="3JN 1:4"/></para>
  <para style="s">गयुस ने बोक्ती</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5"/>एय मारा मोंगाल्ला हाती, पारका बायाख हिऱ्यो जो काय तु किरेह, ताह तु ईमानदारी माय किरेह। <verse eid="3JN 1:5"/><verse number="6" style="v" sid="3JN 1:6"/>ता मोंडलीन ओंगाण तार मोंगान बाराम पुरावो दियेल हेते। एने जो बोगवानान माणहान केरता हाजो हे, इहकेरीन ताह तु वाटी लागाड़हे ताहार तु जुलूम हाजो किरहे। <verse eid="3JN 1:6"/><verse number="7" style="v" sid="3JN 1:7"/>काहाकाय ता यीशुन नावान केरता निकेल रेनाह, एने बिगेर बुरहो केरनार माणहा फाय रेन कायच नाह लेतेह। <verse eid="3JN 1:7"/><verse number="8" style="v" sid="3JN 1:8"/>तानकेरता ओहला माणहाह गेराम हादणे जुवे, काय आपु बी खेराय माय तान हाती बोणहु।<verse eid="3JN 1:8"/></para>
  <para style="s">दियेत्रफुस एने दिमेत्रयुस</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9"/>मी मोंडलीह थोड़ोक लिखेल ईतो, पुण दियेत्रफुस जो ता माय पुडारी बोणने हुदेह, तो मारी नाह होमलेत। <verse eid="3JN 1:9"/><verse number="10" style="v" sid="3JN 1:10"/>तानकेरता जेवी मी आवुह ते तान कामे जा तो किरेह एर केरावुह, एने आमरा बाराम खाराब खाराब वातु किथे; एने ज्या पोर ओलोस खुस नाह ईत पुण बायाख बी आहने नाह लेत, एने जा आहने लेणे होद्तेह ताह आहने केरनेन रोकेह एने मोंडलीन बाहेर काड़ देणे हुदेह।<verse eid="3JN 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11"/>एय मोंगाल्ला, खाराबान नाह पुण हाजालान गेत बोण। जो हाजो किरेह, तो बोगवाना उगे रेन हे; पुण जो खाराब काम किरेह तो बोगवानाह दिखेल नाह सोतो। <verse eid="3JN 1:11"/><verse number="12" style="v" sid="3JN 1:12"/>दिमेत्रयुसान बारा माय आखा पुरावो आपेल हे; एने आमु बी गोवाय देतेह, एने तु जाणेह काय आमरी गोवाय खेरली हे।<verse eid="3JN 1:12"/></para>
  <para style="s">सेवल्यो नमस्‍कार</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13"/>माहु जुलूम काय तुवाह लेखणु एतो, पुण साई एने पेन केरीन लेखणे नाह हुदीत। <verse eid="3JN 1:13"/><verse number="14" style="v" sid="3JN 1:14"/>पुण मी जेल्दीच तुवाह मीलाह ओहली मार आसा हे, तेवी आपु आमने सामने वातु केरहु।<verse eid="3JN 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15"/>तुवाह सान्ती जुड़ती रेय। न्यावाला हाती तुवाह नमस्‍कार केतेह। तावाला आखा जोड़ीदाराह नाव ली लेन नमस्‍कार किय दिज्ये।<verse eid="3JN 1:15"/></para>
  <chapter eid="3JN 1"/>
</usx>
