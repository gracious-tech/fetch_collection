<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Nahali</book>
  <para style="h">मत्ती</para>
  <para style="toc3">मत्ती</para>
  <para style="toc2">मत्ती</para>
  <para style="toc1">मत्ती लिखेल यीशु मसीन हाजाली खुबेर</para>
  <para style="mt2">मत्ती रचीत यीशु मसीह का सुसमाचार</para>
  <para style="mt1">मत्ती लिखेल यीशु मसीन हाजाली खुबेर</para>
  <para style="imt">ओलखात</para>
  <para style="ip">मत्तीन लिखेल हाजाली खुबेर तो पुस्तेक ज्यो हे जो चार पुस्तेक माय रेन एक हे जो यीशु मसीन जीवणान बारामाय देखाड़ेह। पुस्तेकाम रेन हाजाली खुबेर केवायेल हे, जान मतलब हे यीशुह हेरगाम जाणेन पासाण मत्ती, मरकुस, लुका, एने योहान ज्‍यु आख्‍यु पुस्तेक्‍यु लेखायेल हेत्यु मत्तीन हाजाली खुबेर ज्यो पुस्तेक केदीह लेखायेल ज्यान मालमात जाणकार माणहाह नाह मालुम सोती तीबी आपु इही केय सेकतेह काय यीशुन जेल्मान 60 सालान पासाण ज्यो पुस्तेक लेखानो एय इहकेरीन तो लेखायेल ज्यान मालमात आपुह मालुम नाह सोती तीबी दिहरा माणहान मान्नो हे ज्यो पुस्तेक पलिस्तीन निहते यरूशलेम हेयराम लेखानो एय।</para>
  <para style="ip">ज्यी पुस्तेकीह लेखणार मत्ती हे जो यीशुन चेलो बोणनेन पेल फालो उकालनार इतो एने तो लेवी नावा माय ओलखाय जातालो मत्ती बारा प्रेरिता माय रेन एक इतो एने तो यहुदि वाचणारान केरता ज्यी पुस्तेक लिखेल हे तानकेरता आपु देखतेह काय ज्या पुस्तेकाम 60 रेन वोदार वातु जुनाला नेमान हेते जान बाराम जाणाव ईयेल हे तो सोड़ोवणार मसी यीशुस हे ज्यो तो देखाड़ने हुदेह मत्ती बोगवानान राज ने बाराम जुलूम काय लिखेल हे, यहुदिन आसा एती काय मसी राज कारणान राज ने राजा बोणी मत्ती ज्या विचाराह चेतावणी आपीन बोगवानान आत्मिक राज देखाड़ेह।</para>
  <para style="ip">मत्ती लिखेल हाजाली खुबेर ज्यो एक हाजालो पुस्तेक हे ज्यास माय रेन नोवाला नेमान सुरवात ईथे ज्यो पुस्तेक जुनाला नेमान उगे जाहार ताहार आपणो द्यान ली जाथे ज्यो पुस्तेक नोवालो एने जुनालो दुयाह जोड़ दिथे जाणकार ओहलो देखाड़तेह काय ज्या पुस्तेकाम मुसो लिखेल पंचग्रथ जुनाला नेमान पेल्ला पाच पुस्तेक ज्यान रूप देखाड़ेह यीशु जो बोयड़ा पोर हिकवोण आपेल <char style="xt"><ref loc="MAT 5:7">5:7</ref></char> जान तुलना जो नेमान पुस्तेक बोगवान मुसाह आपेल ता हेऱ्या केर सेकतेह। <char style="xt"><ref loc="DEU 19:3-23:25">व्यवस्था 19:3–23:25</ref></char></para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. यीशुन जेल्मो एने तान सेवान सुरवात मत्ती तान हाजाली खोबरीन सुरवात किरेह। <char style="ior"><ref loc="MAT 1-4">1–4</ref></char></para>
  <para style="io1">2. तान पासाण मत्ती यीशुन सेवान बाराम एने ज्‍यु आख्‍यु वातुन तो हिकाड़ेल तान बाराम देखाड़ेह। <char style="ior"><ref loc="MAT 5-25">5–25</ref></char></para>
  <para style="io1">3. मत्तीन लिखेल हाजाली खुबेर जो आखरी बाग हे तो यीशुन सेवकायीह उचाला बोयड़ान टेकड़ो मतलब तान मोरने एने जीव उठणेन बाराम लिखेल हे। <char style="ior"><ref loc="MAT 26-28">26–28</ref></char></para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">यीशुन वोस</para>
  <para style="r">(<ref loc="LUK 3:23-38">लुका 3:23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />यीशु मसीन बाप दादान नावे लेखायेल सुचीन पुस्तेक ज्‍यु हेत्यु, तो दाऊद राजान वोसीन इतो, दाऊद राजान वोस अब्राहामा पोर रेन सुरू एनो।<verse eid="MAT 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 1:2" />अब्राहामाह रेन इसहाक, इसहाकाह रेन याकुब, एने याकुबाह रेन यहुदा एने तान बाहख पायदा एना, <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />यहुदा एने तामार ने फिरीस एने जोरह पायदा एना, फिरिसान हिसरोन पायदा ईनो, एने हिसरोन ने एराम पायदा एनो, <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />एरामाह रेन अम्मीनादाब पायदा ईनो, अम्मीनादाबाह रेन नहशोन एने नहशोनाह रेन सलमोन पायदा ईनो, <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />सलमोनाह एने राहाबान बोआज पायदा ईनो, बोआज एने रूथ ने ओबेद पायदा ईनो, एने ओबेद ने यीशे पायदा ईनो,<verse eid="MAT 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 1:6" />एने यीशेन दाऊद राजा पायदा ईनो, एने दाऊदान सुलेमान ती बायकुन जी पेल उरीयान बायकु एती<note caller="+" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="2SA 12:24">2 शमुएल 12:24</ref></char></note>, <verse eid="MAT 1:6" /><verse number="7" style="v" sid="MAT 1:7" />सुलेमानाह रेन रेहबाम पायदा ईनो, एन रेहबामाह रेन अबिया पायदा ईनो, एने अबियान आसाफ पायदा ईनो,<note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="2SA 12:24">2 शमुएल 12:24</ref></char></note> <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />आसाफ यहोशापात पायदा ईनो, यहोशापातान योराम पायदा ईनो, एने योरामान उजिया पायदा ईनो, <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />उजियान योताम पायदा ईनो, योतामान आहाज पायदा ईनो, एने आहाजान हिजकिया पायदा ईनो, <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />हिजकियान मनशी पायदा ईनो, मनशीन आमोन पायदा ईनो, एने आमोनान योशिया पायदा ईनो, <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />एने बाबिलोन देसान राजा इस्राएली माणहाह गुलामी माय ली जाणेन टेम माय, योशियान यकुन्या एने तान बाहख पायदा एना।<note caller="+" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="2KI 24:14-15">2 राजा 24:14-15</ref>; <ref loc="2CH 36:10">2 इतिहास 36:10</ref>; <ref loc="JER 27:20">यिर्मया 27:20</ref></char></note><verse eid="MAT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12" />एने ता बाबिलोन माय गुलामी माय एता, तेवी यकुन्यान शालतीएल पायदा ईनो, एने शालतीएलान जरूबाबेल पायदा ईनो, <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />एने जरूबाबेल ने अबीहुद पायदा ईनो, अबीहुदान ईलयाकीम पायदा ईनो, एने ईलयाकीमान आजोर पायदा ईनो, <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />आजोरान सदोक पायदा ईनो, एने सदोकान अखीम पायदा ईनो, एने अखीम ने इलीहुद पायदा ईनो, <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />इलीहुद ने एलियाजर पायदा ईनो, एलियाजरान मत्तान पायदा ईनो, एने मत्तानान याकुब पायदा ईनो, <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />याकुबान युसूफ पायदा ईनो, जो मरीयम ने एदमी इतो, एने मरीयमान यीशु जो मसी केवाथे तो पायदा ईनो,<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />इहकेरीन अब्राहाम रेन दाऊद वोर चोवदा पिढ्यु एन्यु, एने दाऊदाह रेन बाबिलोन माय बोंदी बाणावीन पोचाड़णे वोर चोवदा पिढ्यु एन्यु, तान बाद बाबिलोन माय गुलामीम ली जाणे वोर यीशु मसीन पायदा एणे वोर चोवदा पिढ्यु एन्यु।<verse eid="MAT 1:17" /></para>
  <para style="s">यीशुन जेल्मो</para>
  <para style="r">(<ref loc="LUK 1:26-2:1">लुका 1:26-38–2:1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:18 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 1:27">लुका 1:27</ref>
      </char>
    </note>यीशु मसीन जेल्मो इहकेरीन एनो, जेवी तान आहख मरीयम ने मांगणी युसूफ नावान माणहा हेरी ईयेल एती, तेवी ता दुयाह एकठा एणेन पेल मरयमीह चोखाला जीवा उगे रेन दिह रेना। <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />तीन एदमी युसूफ जो देरमी इतो, एने तीह बदनाम केरने नाह होदतालो, केरीन युसूफ तीह मोनेस सोड़ देणेन विचार किऱ्यो। <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />पुण जेवी युसूफ ज्यी वातुन बाराम मोना माय विचार केरने बाजरियेल इतो, तेवी बोगवानान हेरोगदुत ताह होपना माय देखानो एने केयो, “एय युसूफ दाऊदान सोरा, तु तारी बायकुह तार गेर लावणेन बिहे मा, काहाकाय जो तीन पेटाम हे तो चोखाला जीवान उगे रेन हे, <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" /><note caller="+" style="x"><char style="xo" closed="false">1:21 </char><char style="xt" closed="false"><ref loc="LUK 1:31">लुका 1:31</ref></char></note>ती एक सोराह जेल्मो देय, एने तु तान नाव यीशु मिलजे, काहाकाय तो आपणा माणहान तान पापाम रेन वोचाड़ी।”<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />ज्य सोब ज्यानकेरता एनो काय जो वचन जाणकार बोगवाना उगे रेन कियेल इतो, तो पुरो एय। <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />“दिखो, एक कुवारली सोरीह दिह रेती, एने ती एक सोराह जेणी एने तान नाव इम्मानवेल मेलाय जाय,” तान मतलब हे, “बोगवान आमरी हिऱ्यो हे।”<note caller="+" style="x"><char style="xo" closed="false">1:23 </char><char style="xt" closed="false"><ref loc="ISA 7:14">यशाया 7:14</ref></char></note><verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />तेवी युसूफ निंद माय रेन जागीन बोगवानान हेरोगदुतान उकुम मानेन तिहेस केरीन, युसूफ मरीयम हिऱ्यो वाराड़ केरीन तान गेर लेन आवो; <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" /><note caller="+" style="x"><char style="xo" closed="false">1:25 </char><char style="xt" closed="false"><ref loc="LUK 2:21">लुका 2:21</ref></char></note>एने जाह वोर ती सोराह जेल्मो नाह देनी ताह वोर युसूफ ती हिऱ्यो नाह गीयो, एने युसूफ ता सोरान नाव यीशु मिल्यो।<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">दिह उगता उगेवाला पावणा</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />हेरोदेस राजान काला माय जेवी बेथलेहेम गावाम यहुदिया ईलाका माय यीशुन जेल्मो एनो, ते दिह उगता उगे रेन तारान बाराम मालमात केरनारे जाणकार माणहे यरूशलेम देसा माय आवीन फुसणे बाज गीया। <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />“यहुदिन राजा जान जेल्मो एनोह, तो काहरी हे? काहाकाय आमु दिह उगता उगे तान तारो दिखेल हेते, एने तान पाया पोड़ने आयेल हेते।”<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />ज्य होमलीन हेरोदेस राजा, एने ता हेऱ्या आखा यरूशलेम माय रेणारे माणहे गाबराय गीया। <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />तेवी राजा आखा माणहान मुखी चाकऱ्याह, एने देरेमगुरू न्याह सोबाह एकठा केरीन ताह फुशो, “मसीन जेल्मो काहरी एणे जुवे?”<verse eid="MAT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5" />ता राजाह केया, यहुदि देसाम बेथलेहेम गावा माय, काहाकाय जाणकारान उगे रेन ज्य लेखायेल हे:<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />“एय बेथलेहेम, तु जो यहुदान देस,<note caller="+" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="MIC 5:2">मीका 5:2</ref></char></note></para>
  <para style="q2" vid="MAT 2:6">तु किहीक बी केरीन यहुदान आदिकारी माय आखाम रेन आत्यो नाय मिले;</para>
  <para style="q1" vid="MAT 2:6">काहाकाय तार माय रेन एक आदिकारी निकली,</para>
  <para style="q2" vid="MAT 2:6">तो मारा इस्राएली माणहान राखवाली केरी”<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />तेवी हेरोदेस राजा मालुमात केरनारा माणहाह मोनेस हादिन फुशो, तारो ठिख काल्ला टेम माय देखायेल इतो। <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />एने राजा ताह ज्य केयीन बेथलेहेम गावा माय मुकल्यो, “जावो ता सोरान बाराम हास केरीन पोतो किरो, एने जेवी तो सापड़ी जाय तेवी माहु बी आवीन खोबेर दिज्यो। काहाकाय मी बी आवीन तान पाया पोडु।”<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />ता राजान वात होमलीन जात रेना, एने जा ताराह ता पुर्व माय दिखेल एता तोस तारो तान ओंगाण ओंगाण चालनो; एने जाहरी सोरो एतो, ता जागा पोर जाईन उबरेय गीयो। <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />ता ताराह देखीन ता जुलूम खुस एय गीया। <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />एने ता आखा गेराम जाईन ता सोराह तान आईख ने खोलाम देख्या, एने ता पाया पोड़ीन ताह वोंद्या, एने जान तान जोलो उगाड़ीन ताह होनो, एने लोबान, एने मोग मोग गेंदाण्यो तेल बेट केऱ्या। <figure style="fig" alt="Frankincense branch, censer and incense altar" file="bk00116c.tif" size="col" copy="Horace Knowles ©" ref="2:11">हालीयान जाड़ एने दुणी देणेन वेदी </figure><verse eid="MAT 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 2:12" />ओवतो ताह होपना माय बोगवाना उगे रेन चेतावणी आपी, काय पोशा फिरीन हेरोदेसा फाय मा जाहो, केरीन ता दिहरी वाटे रेन तान देसाम जात रेना।<verse eid="MAT 2:12" /></para>
  <para style="s">युसूफ सोराह एने सोरान आईख लेन मिस्र देसाम जाणे</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />ताह जाणेन पासाण बोगवानान एक हेरोगदुत होपना माय आवीन युसूफाह केयो, “उठ ज्या सोराह एने ज्यान आईख लेन मिस्र देसाम नाह जा; एने जाह वोर मी नाय केव ताह वोर ताच रिजे, काहाकाय हेरोदेस ज्या सोराह हुदेह काय ज्याह माराव देव।”<verse eid="MAT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14" />तेवी युसूफ रातीच उठीन सोराह एने तान आईख लेन मिस्र देसा माय जात रिनो। <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />एने हेरोदेस राजा मोरता वोर ताच रेना। ज्य ज्यानकेरता एनो काय तो वचन जो बोगवानान जाणकारान उगे रेन कियेल एतो, तो पुरो एय: “मी मारा सोराह मिस्र देसाम रेन हादेल हे।”<note caller="+" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="HOS 11:1">होशे 11:1</ref></char></note><verse eid="MAT 2:15" /></para>
  <para style="s">सोराह मारने</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />जेवी हेरोदेस राजाह ज्य मालुम पोड़नो काय इकेल वाला माणहे माहु दुको दियेल हेते, तेवी ताह जुलूम राग आवो, एने माणहाह मोकलीन ग्यानी माणहे कियेल तो तारो देखायेल तोलेक वोर बेथलेहेम गावान, एने आहने पाहनेन गावान आखा सोराह जा दुय वोरह्याह रेन आत्या एता, ता आखाह माराव दिनो।<verse eid="MAT 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 2:17" />तेवी जो यिर्मया जाणकारान उगे रेन कियेल एतो तो वचन पुरो एनो।<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />“रामा माय दुखाम बोरायेल एक बोल होमलाय गीयो;<note caller="+" style="x"><char style="xo" closed="false">2:18 </char><char style="xt" closed="false"><ref loc="JER 31:15">यिर्मया 31:15</ref></char></note></para>
  <para style="q1" vid="MAT 2:18">राहेल तीन सोरान केरता रेड़ताली;</para>
  <para style="q2" vid="MAT 2:18">एने ठावकी रेणे नाह होदताली,</para>
  <para style="q2" vid="MAT 2:18">तीन ते आखा सोरा मोर जायेल एता।”<verse eid="MAT 2:18" /></para>
  <para style="s">मिस्र देसा माय रेन वोलना</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />हेरोदेस राजाह मोरनेन पासाण, बोगवानान एक हेरोगदुत मिस्र देसा माय युसूफाह होपना माय देखानो एने केयो, <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />“उठ, सोराह एने ज्यान आईख लेन इस्राएल देसा माय जातरे, काहाकाय जा माणहे सोरान जीव लेणे होदताला, ता मोर जायेल हेते।” <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />युसूफ जाग उठनो, एने सोराह एने तान आईख लेन इस्राएल देसा माय आवो।<verse eid="MAT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 2:22" />पुण ज्य होमलीन काय अरखीउलास तान आबाख ने हेरोदेसान जागे यहुदिया पोर राज केरने बाजरिनोह, केरीन ता जाणेन बिनो। उंजु ताहरी ताह बोगवान होपना माय सुचना आप्यो काय ता मा जाहे, ओवतो युसूफ गेलील देसाम जात रिनो। <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />एने नासरत नावान गावा माय जाईन रेणे बाज गीयो, काय तो वचन पुरो एय जो जाणकारान द्‍वारे कियेल एतो: “तो नासरी गावान केवाय।”<note caller="+" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="MRK 1:24">मरकुस 1:24</ref>; <ref loc="LUK 2:39">लुका 2:39</ref>; <ref loc="JHN 1:45">योहान 1:45</ref></char></note><verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">बपतीस्मा केरनार योहानान पारचार</para>
  <para style="r">(<ref loc="MAT 1:1-8">मत्ती 1:1-8</ref>; <ref loc="LUK 3:1-18">लुका 3:1-18</ref>; <ref loc="JHN 1:19-28">योहान 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />ता दिह्या माय बपतीस्मा केरनार योहान आवीन यहुदियान जेंगला माय ज्यो पारचार केरने बाज गीयो: <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" /><note caller="+" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="MAT 4:17">मत्ती 4:17</ref>; <ref loc="MRK 1:15">मरकुस 1:15</ref></char></note>“तुमरा पापाह सोड़ीन तुमू मोन फिरावो, काहाकाय हेरगान राज आहने आव लागेल हे!” <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />जान बाराम यशाया जाणकार कियेल इतो, ज्यो तोस हे:<note caller="+" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">यशाया 40:3</ref></char></note></para>
  <para style="q1" vid="MAT 3:3">“उजाड़ी माय एक आयेड़नारान आवाज होमलानो,</para>
  <para style="q2" vid="MAT 3:3">काय बोगवानान वाट तियार किरो,</para>
  <para style="q2" vid="MAT 3:3">एने तान सेड़ेक हुतरी किरो!”<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />ज्यो योहान उटड़ान रोचकान फाड़का पेर रियेल इतो, एने कोमरा माय चामड़ान पुट्टो बांद रियेल इतो। एने तान खाणो टिड्या एने जेंगली मोवाल एतो।<note caller="+" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="2KI 1:8">2 राजा 1:8</ref></char></note> <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />तेवी यरूशलेम हियोर एने यहुदियान आखा माणहे, एने यरदन नेदीन आहने पाहने वाला आखा ईलाकान माणहे योहान फाय आवा। <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />ता आप आपणा पापाह मानेन योहान फाय रेन यरदन नेदी माय बपतीस्मा लेदा।<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:7 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:34">मत्ती 12:34</ref>; <ref loc="MAT 23:33">23:33</ref></char>
    </note>जुलबुखे तो मोकतास फरिसी एने सदुकीह बपतीस्मा लेणेन केरता ता फाय आवताला देखीन तो केयो, “एय गेड़हान पिला, तुमूह कुण हिकाड़ देनोह काय बोगवानान उगे रेन आवणारा रागाह रेन सेटा नाहो? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />तानकेरता पापाम रेन मोनाह बोदलो काय हाजो फोल लावो; <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" /><note caller="+" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="JHN 8:33">योहान 8:33</ref></char></note>एने आप आपणा मोना माय ज्य मा सोचो काय आमरो आबोख ते अब्राहाम हे; काहाकाय मी तुमूह केथु काय बोगवान न्या देगड़ा केरीन अब्राहाम ने केरता सोरो पायदा केर सिकेह। <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" /><note caller="+" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="MAT 7:19">मत्ती 7:19</ref></char></note>एवी कुराड़ ते जाड़ान थुड़ा पोर मिलेल हे, तानकेरता जो जाड़ फोल नाह लावेत, तो काटाय एने आक्‍ठा माय टाकाय जाय। <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />मी ते तुमूह पाण्या केरीन मोन बोदेलनेन बपतीस्मा केरथु, पुण जो मार पासाण आवण्यो हे, तो माहु रेन जादा ताकेतवालो हे, मी ते तान खाहड़ा विसणेन लायकीन नाह सुतो, एने तो तुमूह चोखालो जीव एने आक्‍ठा केरीन बपतीस्मा आपी। <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />तान हुपड़ो तान आथाम हे, एने तान खोलाह हास केरीन साप केरी, एने गोवाह एक जागे मोटक्या माय टुलो केरी, पुण बुहटाह ता आक्‍ठा माय हेलगाड़ देय, जो जेलेम ओलाय नाय।”<verse eid="MAT 3:12" /></para>
  <para style="s">यीशुन बपतीस्मा</para>
  <para style="r">(<ref loc="MAT 1:9-11">मत्ती 1:9-11</ref>; <ref loc="LUK 3:21-22">लुका 3:21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />तुलबूखे यीशु गेलील ने नासरत गावा माय रेन यरदन नेदीन मीरे योहान फाय आवो काय ता फाय रेन बपतीस्मा लेय। <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />पुण योहान इही केयीन रोकणे बाज गीयो, “माहु ते तुवा फाय रेन बपतीस्मा लेणेन गिरेज हे, एने तु माहु फाय आवोह?”<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />यीशु ताह इही केयीन जापाप आप्यो, “एवी ओहलोच एणे दे, काहाकाय आपुह इहीचकेरीन सोब खेराय काम पुरो केरनेन हाजो हे।” तेवी योहान तिहेच केरीन किऱ्यो।<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />जेवी यीशु बपतीस्मा लेन पाण्या माय रेन उपेर आवो, एने दिखो, हेरोग उगड़ी गीयो, एने तो बोगवानान जीवाह पेरवान वेहा माय तान उपेर उतेरतालो दिख्यो। <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" /><note caller="+" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="MAT 12:18">मत्ती 12:18</ref>; <ref loc="MAT 17:5">17:5</ref>; <ref loc="MRK 1:11">मरकुस 1:11</ref>; <ref loc="LUK 9:35">लुका 9:35</ref></char></note>एने दिखो, हेरगा माय रेन एक आवाज आवो: ज्यो मारो मोंगाल्लो बिटोख हे, ज्या पोर मी जुलूम खुस हे।<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">यीशुन पारेख</para>
  <para style="r">(<ref loc="MAT 1:12-13">मत्ती 1:12-13</ref>; <ref loc="LUK 4:1-13">लुका 4:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:1 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 2:18">इब्रानियो 2:18</ref>; <ref loc="HEB 4:15">4:15</ref>; <ref loc="HAB 2:18">हबकुक 2:18</ref></char>
    </note>तेवी चोखालो जीव यीशुह उजाड़ी माय ली गीयो काय सैतानान उगे रेन तान पारेख एय। <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />तो चालीह दिह, एने चालीह रात उपास माय रिनो, तेवी ताह बुख लागी। <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />तेवी सैतान यीशुन आहने आवो एने केयो, “केदी तु बोगवानान बिटोख एय, ते ज्या देगड़ाह केय दे काय रूटो बोण जाय।”<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />पुण यीशु ताह जापाप आप्यो, “वचन माय इहकेरीन लेख मिलेल हे, ‘माणुह रोटा केरीन ओलोस नाह, पुण एकेक वचन जो बोगवानान मुयाम रेन निकलेह, जीवतालो रेय।’”<note caller="+" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="DEU 8:3">व्यवस्था 8:3</ref></char></note><verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />तान पासाण सैतान ताह यरूशलेम हेयरा माय ली गीयो, एने मोंदिरान चुटा पोर उबराख दिनो, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />एने यीशुह केयो, “केदी तु बोगवानान बिटोख एय ते न्या रेन बुंदे कुदजा, काहाकाय वचन माय इहकेरीन लेख मिलेल हे:<note caller="+" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PSA 91:11-12">बजन 91:11-12</ref></char></note></para>
  <para style="q1" vid="MAT 4:6">“बोगवान तान हेरोगदुताह तुवाह वोचाड़नेन केरता उकुम आपी,</para>
  <para style="q2" vid="MAT 4:6">एने ता तुवाह आथा माय उपरूस विस लेती,</para>
  <para style="q2" vid="MAT 4:6">केदी ओहलो नाय एय काय तारा पाया माय दिगोड़ नाय लागे।”<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />पुण यीशु ताह केयो, वचन माय इहकेरीन बी लेख मिलेल हे:</para>
  <para style="q1" vid="MAT 4:7">“तु मालीक तारा बोगवानान पारेख मा किरहे।<note caller="+" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="DEU 6:16">व्यवस्था 6:16</ref></char></note>”<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />ओवतो सैतान ताह एक उचाच बोयड़ा पोर ली गीयो, एने ताह दुनियान आखो राज एने तान बोड़ाय देखाड्यो। <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />एने सैतान ताह केयो, “केदी तु पाया पोड़ीन मारी बोक्ती किरहे ताहार ज्य सोब मी तुवाह आप देह।”<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />तेवी यीशु ताह जापाप आप्यो, “एय सैतान सिटो एय जा, काहाकाय वचन माय लेख मिलेल हे: ‘तु तारा मालीक बोगवानाह ओलोस बोक्ती केर, एने तान उलोस उपास केर।’”<note caller="+" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="DEU 6:13">व्यवस्था 6:13</ref></char></note><verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />तेवी सैतान ताह सोड़ीन जात रिनो, एने दिखो, हेरोगदुत आवीन तान सेवा चाकरी केऱ्या।<verse eid="MAT 4:11" /></para>
  <para style="s">यीशुन सेवान सुरवात</para>
  <para style="r">(<ref loc="MAT 1:14-15">मत्ती 1:14-15</ref>; <ref loc="LUK 4:14-15">लुका 4:14-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:12 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 14:3">मत्ती 14:3</ref>; <ref loc="MRK 6:17">मरकुस 6:17</ref>; <ref loc="LUK 3:19">लुका 3:19</ref>,<ref loc="LUK 3:20">20</ref></char>
    </note> जेवी यीशु ज्य होमल्यो काय बपतीस्मा केरनार योहान देराय जायेल हे, ते तो गेलील माय जात रिनो। <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" /><note caller="+" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="JHN 2:12">योहान 2:12</ref></char></note>एने यीशु नासरत सोड़ीन कफरनहूम हेयरा माय, जो देरीयान देड़े जबुलून एने नप्तालीन ईलाका माय हे, जाईन रेणे बाज गीयो। <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />काहाकाय जो यशाया जाणकारान द्‍वारे कियेल एतो, तो पुरो एय:<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />“जबुलून एने नप्तालीन देस,<note caller="+" style="x"><char style="xo" closed="false">4:15 </char><char style="xt" closed="false"><ref loc="ISA 9:1-2">यशाया 9:1-2</ref></char></note></para>
  <para style="q1" vid="MAT 4:15">देरीयान वाटी पोर, यरदन नेदीन दिड़े,</para>
  <para style="q1" vid="MAT 4:15">बिगेर यहुदिन देस गेलील माय,<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />जा माणहे आदारा माय बोह रियेल एता,</para>
  <para style="q2" vid="MAT 4:16">ता एक मोटलो उजोड़ देख्या;</para>
  <para style="q1" vid="MAT 4:16">एने जा मोतीन सावलान देसाम बोह रियेल एता,</para>
  <para style="q2" vid="MAT 4:16">ता पोर उजोड़ चोमेकनो।”<verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:17 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 3:2">मत्ती 3:2</ref>
      </char>
    </note>तुलबूखे रेन यीशु खोबरीन पारचार सुरू केर दिनो, “तुमरा पापाम रेन मोन फिरावो, काहाकाय हेरगान राज आहने आव लागेल हे।”<verse eid="MAT 4:17" /></para>
  <para style="s">यीशु चार मासऱ्याह हादणे</para>
  <para style="r">(<ref loc="MAT 1:16-20">मत्ती 1:16-20</ref>; <ref loc="LUK 5:1-11">लुका 5:1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />जेवी यीशु गेलील ने देरीयान दिड़े दिड़े जाणे बाजरियेल इतो, तेवी तो दुय बायाख देरीयाम जाल टाकताला दिख्यो, शमोन मतलब, जो पतरस केवाथे, एने तान बायाख अन्द्रियासाह। काहाकाय ता मासऱ्या एता। <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />यीशु ताह केयो, “मार पासाण आवो, मी तुमूह माणहाह बोगवाना फाय किहीक लावणु तो हिकाडुह।” <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />ता यीशुन वात होमलीन जालीह जागेस सोड़ीन तान पासाण चाल देना।<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />ओवतो यीशु थोड़ोक ओंगाण चालीन गीयो, तेवी जब्दीन सोरा याकुब एने तान बायाख योहान ज्या दुय जाणे आबाख हेऱ्या डोंडह्या पोर बोहीन तान जाल हुदारने बाजरियेल एता। तेवी यीशु ताह देखीन हाद्यो। <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />ता चालोच डोंडह्यो एने तान आबाख सोड़ीन यीशुन पासाण चाल देना।<verse eid="MAT 4:22" /></para>
  <para style="s">मोटली गेरदीन केरता यीशुन सेवा</para>
  <para style="r">(<ref loc="LUK 6:17-19">लुका 6:17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:23 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 9:35">मत्ती 9:35</ref>; <ref loc="MRK 1:39">मरकुस 1:39</ref></char>
    </note>यीशु आखा गेलील माय फिरतेन एने तान बोक्ती केरन्या गेरा माय हिकाड़ते, एने हेरगान राज ने हाजाली खोबरीन पारचार किरतेन, एने माणहान आखी बातीन बेमारीह हुदाऱ्यो एने कोमजोरीह सिटो केरते रिनो। <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />एने आखा सीरीया देसाम तान खोबेर पोसरी गियी; केरीन माणहे आखा दुखाऱ्याह, जा बाती बातीन बेमारी एने दुखा माय पोड़ रियेल एता, एने जा माय खाराब जीव रिग रियेल एतो, एने फेपरान बेमारी वाला एने लोखवान दुखाऱ्याह, ता फाय लावा एने यीशु ताह हुदार दिनो। <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />केरीन गेलील, दोह हियोर दिकापुलिस, यरूशलेम, यहुदिया एने यरदन नेदीन ती उगेवाला आखा माणहे टोलान टोला यीशुन पासाण चाल देना।<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">यीशुन बोयड़ाम हिकवोण</para>
  <para style="r">(<ref loc="MAT 5:1-7:29">मत्ती 5:1–7:29</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />जेवी यीशु ती मोटली गेरदीह देखीन तो एक बोयड़ा पोर चेड़ गीयो, एने ताहरी बोह गीयो तेवी तान चेला ता फाय आवा। <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />एने तो तान मुय उगाड़ीन ताह ज्य हिकाड़ने बाज गीयो:<verse eid="MAT 5:2" /></para>
  <para style="s">बोरकेतवालो वचन</para>
  <para style="r">(<ref loc="LUK 6:20-23">लुका 6:20-23</ref>)</para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />“बोरकेतवाला हेते ता जा मोनान गेरबोड़ा हेते;</para>
  <para style="q2" vid="MAT 5:3">काहाकाय हेरगान राज ताच ने हे!<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />बोरकेतवाला हेते ता जा दुख मोणावतेह;</para>
  <para style="q2" vid="MAT 5:4">काहाकाय ताह सान्ती जुड़ी!<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />बोरकेतवाला हेते ता जा नम्र हेते;<note caller="+" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="PSA 37:11">बजन 37:11</ref></char></note></para>
  <para style="q2" vid="MAT 5:5">काहाकाय ता देरतीन वारीस बोणती!<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />बोरकेतवाला हेते ता जा देरमान बुखल्या एने तीहल्या हेते;<note caller="+" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="ISA 55:1-2">यशाया 55:1-2</ref></char></note></para>
  <para style="q2" vid="MAT 5:6">काहाकाय ता आफरी जाती!<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />बोरकेतवाला हेते ता जा गीण केरनारे हेते;</para>
  <para style="q2" vid="MAT 5:7">काहाकाय ता पोर गीण केराय!<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />बोरकेतवाला हेते ता जान मोन चोखो हे;<note caller="+" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="PSA 24:3-4">बजन 24:3-4</ref></char></note></para>
  <para style="q2" vid="MAT 5:8">काहाकाय ता बोगवानाह देखती!<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />बोरकेतवाला हेते ता, जा मेल केरावणारे हेते;</para>
  <para style="q2" vid="MAT 5:9">काहाकाय ता बोगवानान सोरा केवाती!<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:10 </char>
      <char style="xt" closed="false">
        <ref loc="1PE 3:14">1 पतरस 3:14</ref>
      </char>
    </note>बोरकेतवाला हेते ता जा पोर देरमान केरता सेताव आवेह;</para>
  <para style="q2" vid="MAT 5:10">काहाकाय हेरगान राज ताच ने हे!<note caller="+" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="1PE 3:14">1 पतरस 3:14</ref></char></note><verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:11 </char>
      <char style="xt" closed="false">
        <ref loc="1PE 4:14">1 पतरस 4:14</ref>
      </char>
    </note>“बोरकेतवाला हेते तुमू; जेवी माणहे मार केरता तुमरी चिहटा केरती, एने सेतावती एने मार केरता तुमरा विरोद माय जुठ बोली बोलीन तुमरी विरोद माय आखी बातीन खाराब वातु केती।” <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />तुलबूखे आनन्दित एने खुस ईज्यो, काहाकाय तुमरी केरता हेरगा माय मोटलो ईनाम हे; एने तुमूह रेन पेल जा जाणकार एता ताह बी ता इहीचकेरीन वेला केरायेल एता।<note caller="+" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="2CH 36:16">2 इतिहास 36:16</ref>; <ref loc="ACT 7:52">प्रेरितान काम 7:52</ref></char></note><verse eid="MAT 5:12" /></para>
  <para style="s">मिठ एने उजालो</para>
  <para style="r">(<ref loc="MRK 9:50">मरकुस 9:50</ref>; <ref loc="LUK 14:34-35">लुका 14:34-35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:13 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 9:50">मरकुस 9:50</ref>; <ref loc="LUK 14:34">लुका 14:34</ref>,<ref loc="LUK 14:35">35</ref></char>
    </note>तुमू देरतीन मिठ हेते, केदी मिठान खारलो होवाद जात रेय, ते ता खारला होवादाह पोशो किहीक लाव सेकतेह। तो कायस कामान नाह रेत, पुण बाहेर टाक देणु एने माणहे ताह पाया बुंदे रोहदेल देणु। <verse eid="MAT 5:13" /><verse number="14" style="v" sid="MAT 5:14" /><note caller="+" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="JHN 8:12">योहान 8:12</ref>; <ref loc="JHN 9:5">9:5</ref></char></note>तुमू दुनियान उजालो हेते। एने जो गाव बोयड़ा पोर बुहेल हे तो लीक नाह सिकेत। <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" /><note caller="+" style="x"><char style="xo" closed="false">5:15 </char><char style="xt" closed="false"><ref loc="MRK 4:21">मरकुस 4:21</ref>; <ref loc="LUK 8:16">लुका 8:16</ref>; <ref loc="LUK 11:33">11:33</ref></char></note>माणहे चिमणी पेटाड़ीन पायला बुंद नाह डापणु, पुण चिमणीह कोठी पोर मेलनु काय गेरावाला आखा माणहाह उजालो आपेह। <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" /><note caller="+" style="x"><char style="xo" closed="false">5:16 </char><char style="xt" closed="false"><ref loc="1PE 2:12">1 पतरस 2:12</ref></char></note>तिहेस केरीन तुमरो उजालो बी माणहान ओंगाण चोमके काय तुमरा हाजाला काम देखीन ता तुमरा आबाख ने जो हेरगाम हे, बोड़ाय केरी।<verse eid="MAT 5:16" /></para>
  <para style="s">कायदान हिक</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />पुण तुमू ज्य मा सोमजो काय मी कायदाह, एने जाणकारान पुस्तेकाह खेतेम केरनेन आयेल हे। खेतेम केरने नाह पुण पुरो केरनेन आयेल हे। <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" /><note caller="+" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="LUK 16:17">लुका 16:17</ref></char></note><note caller="+" style="f"><char style="fr" closed="false">5:18 </char><char style="ft" closed="false">ज्यान आखो हिकवोण खेरलो हे</char></note>काहाकाय मी तुमूह खेरीच केथु, काय जाह वोर जुग एने देरती टेल नाय जाय, ताह वोर कायदाम रेन एक बी वात नाय टेली, पुण त्यु सोब पुरी एय जाती। <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />तानकेरता जो कुण ज्या आत्याम रेन आत्यो उकुमा माय रेन काल्लो बी एक तोड़ी, एने तिहेच केरीन माणहाह हिकाड़ी, तो हेरगान राज माय आखाम रेन आत्यो केवाय; पुण जो कुण ता उकुमान पालेन केरी एने ताह हिकाड़ी, तोच हेरगान राज माय मोठो केवाय। <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />काहाकाय मी तुमूह केथु, “केदी तुमरो देरमी पोण देरेमगुरू एने फरिसीन देरमाह रेन वोदीन नाय रेय, ते तुमू हेरगान राज माय केदी जाय नाय सिकहो।”<verse eid="MAT 5:20" /></para>
  <para style="s">राग एने खुन</para>
  <para style="r">(<ref loc="LUK 12:57-59">लुका 12:57-59</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />तुमू ज्य होमेल लियेल हेते काय वेगाला वारान माणहाह कियेल एतो, “खुन मा किरहो एने जो कुण खुन केरी तो कोरटाम डेंडान लायकी हे।” <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />पुण मी तुमूह ज्य केथु काय जो कुण आपणा बायाख पोर बिगेर कामे राग केरी,<note caller="+" style="f"><char style="fr" closed="false">5:22 </char><char style="ft" closed="false">थोड़ाक लेख माय बिगेर कारणान ने वोजेसे राग किरेह लिखेल हे </char></note> तो कोरटाम डेंडान लायकी हे, एने जो कुण आपणा बायाख बिगेर कामान हे केय, तो मोटला पोंचाम डेंडान लायकी हे, एने जो कुण केय, “एरे फोगा” तो नेरगान आक्‍ठान डेंडान लायकी हे। <verse eid="MAT 5:22" /><verse number="23" style="v" sid="MAT 5:23" />तानकेरता केदी तु तारी बेट चेड़ावणेन केरता वेदीन<note caller="+" style="f"><char style="fr" closed="false">5:23 </char><char style="ft" closed="false">बोली चेड़ावणेन जागु</char></note> जागे लावेह, एने ताहरी तुवाह एर आवेह, काय तारा बायाख ने मोना माय तार पोर काह विरोद एय, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />ते तारी बेट ताच वेदी हिऱ्यो मेल दे, एने जाईन पेल तारा बायाख हिऱ्यो मेल मिलाप केर, ओवतो आवीन बेट चेड़ावजे। <verse eid="MAT 5:24" /><verse number="25" style="v" sid="MAT 5:25" />जाह वोर तार दुसमोन तार हिऱ्यो हे, ते उतवाल्योह ताह जोड़ीदार बोणावले, काय ओहलो नाय एय काय लेड़ाणार तुवाह नियाव केरनारान आथाम होपी, एने नियाव केरनार तुवाह सिपायड़ान आथाम होपी, एने तुवाह जेलीम कोंड देती। <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />मी तुवाह खेरीच केथु, जाह वोर तु एक एक रूपियो बोर नाय दिहे ताह वोर सुटहे नाय।<verse eid="MAT 5:26" /></para>
  <para style="s">सिनालो</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />सिनालो मा किरहो केरीन कियेल एतो, तो तुमू होमेल लियेल हेते। <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />पुण मी तुमूह केथु, काय केदी कुण एगदी बायकुह गेलेत विचारा केरीन दिखेह, ते तो तान मोना माय पेलुस ती हेऱ्यो सिनालो केर लियेल हे। <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" /><note caller="+" style="x"><char style="xo" closed="false">5:29 </char><char style="xt" closed="false"><ref loc="MAT 18:9">मत्ती 18:9</ref>; <ref loc="MRK 9:47">मरकुस 9:47</ref></char></note>केदी तारो डाखऱ्यो डोलो तुवाह पाप केरावी, ते काड़ीन ताह टाक दे; काहाकाय तार केरता ज्योस हाजो हे काय तार सेरीराम रेन एक खेतेम एय जाए, एने तारो आखो सेरीर नेरगान आक्‍ठा माय टाकाय नाय जाए। <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" /><note caller="+" style="x"><char style="xo" closed="false">5:30 </char><char style="xt" closed="false"><ref loc="MAT 18:8">मत्ती 18:8</ref>; <ref loc="MRK 9:43">मरकुस 9:43</ref></char></note>केदी तारो डाखऱ्यो आथ तुवाह पाप केरावतेय, ते काटीन ताह जुगार दे; काहाकाय तार केरता ज्योस हाजो हे काय तार सेरीराम रेन एक खेतेम एय जाए, एने तारो आखो सेरीर नेरगाम<note caller="+" style="f"><char style="fr" closed="false">5:30 </char><char style="ft" closed="false">हेलेगतालो आक्‍ठो तो केदी नाह ओलाणे</char></note> टाकाय नाय जाए।<verse eid="MAT 5:30" /></para>
  <para style="s">सोड़नेन लेख्यो</para>
  <para style="r">(<ref loc="MAT 19:9">मत्ती 19:9</ref>; <ref loc="MRK 10:11-12">मरकुस 10:11-12</ref>; <ref loc="LUK 16:18">लुका 16:18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />“ज्य बी कियेल एतो, ‘जो कुण तान बायकुह सोड़ने हुदेह, ते लेख्यो आपीन तिह सोड़ देय।’ <note caller="+" style="x"><char style="xo" closed="false">5:31 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">व्यवस्था 24:1-4</ref>; <ref loc="MAT 19:7">मत्ती 19:7</ref>; <ref loc="MRK 10:4">मरकुस 10:4</ref></char></note> <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" /><note caller="+" style="x"><char style="xo" closed="false">5:32 </char><char style="xt" closed="false"><ref loc="MAT 10:11-19">मत्ती 10:11-19</ref>; <ref loc="MRK 10:11">मरकुस 10:11</ref>,<ref loc="MRK 10:12">12</ref>; <ref loc="LUK 16:18">लुका 16:18</ref>; <ref loc="1CO 7:10">1 कुरिंथीयो 7:10</ref>,<ref loc="1CO 7:11">11</ref></char></note>पुण मी तुमूह ज्य केथु काय जो कुण तान बायकुह सिनाला सावाय दिहरा काल्ला बी कारणा से सोड़ेह, तो तीह सिनालो केरावेह; एने जो कुण ती सोड़ दियेल बायकु हेऱ्यो वाराड़ किरेह, तो सिनालो किरेह।”<verse eid="MAT 5:32" /></para>
  <para style="s">सुगोणान बाराम हिकवोण</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />तुमू होमेल लियेल हेते काय वेगाला वारान माणहाह कियेल एतो, जुठी सुगोण मा खाहो, पुण बोगवानान केरता तुमरी सुगोण पुरी किरज्‍यो।<note caller="+" style="x"><char style="xo" closed="false">5:33 </char><char style="xt" closed="false"><ref loc="LEV 19:12">लेव्यवस्था 19:12</ref>; <ref loc="NUM 30:2">गिनती 30:2</ref>; <ref loc="DEU 23:21">व्यवस्था 23:21</ref></char></note> <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />पुण मी तुमूह ज्य केथु काय केवी बी सुगोण मा खाहो; नाह ते हेरगान, काहाकाय तो बोगवानान राजगादि हे;<note caller="+" style="x"><char style="xo" closed="false">5:34 </char><char style="xt" closed="false"><ref loc="JOS 5:12">यहोशु 5:12</ref>; <ref loc="ISA 66:1">यशाया 66:1</ref>; <ref loc="MAT 23:22">मत्ती 23:22</ref>; <ref loc="JAS 5:12">याकुब 5:12</ref></char></note> <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />नाह ते देरतीन, काहाकाय ती तान पायान चोवकी हे; नाह यरूशलेम ने काहाकाय तो मोटला राजान हियोर हे।<note caller="+" style="x"><char style="xo" closed="false">5:35 </char><char style="xt" closed="false"><ref loc="ISA 66:1">यशाया 66:1</ref>; <ref loc="PSA 48:2">बजन 48:2</ref></char></note> <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />एने तुमरा मुंडान बी सुगोण मा खाहो, काहाकाय तुमू एक लेट्याह बी उजलो एने कालो नाह केर सेकते। <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />पुण तुमरी वातु होव ते होव, एने नाह ते नाह एणे जुवे; काहाकाय ज्याह रेन होवटो एणे तो खाराब सैतानान उगे रेन एणे।<verse eid="MAT 5:37" /></para>
  <para style="s">बुदलो लेणेन बाराम हिकवोण</para>
  <para style="r">(<ref loc="LUK 6:29-30">लुका 6:29-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />तुमू होमलेल हेते काय वेगाला माणहाह कियेल एतो, “डोलान बोदले डोला, एने दातान बोदले दात।”<note caller="+" style="x"><char style="xo" closed="false">5:38 </char><char style="xt" closed="false"><ref loc="MAT 21:24">21:24</ref>; <ref loc="LEV 24:20">लेव्यवस्था 24:20</ref>; <ref loc="DEU 19:21">व्यवस्था 19:21</ref></char></note> <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />पुण मी तुमूह ज्यो केथु काय खाराब केरनारान सामनो मा किरहो; पुण जो कुण तारा एक गाड़शा पोर थापो देय, ते तान उगे दिहरो गाड़शो बी केर देजे। <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />केदी एगदो तुवा बोलजोबरी केरीन डेगलो सांडाड़ ने हुदेह ते ताह चोड्डो बी आप दे। <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />एने जो कुण तुवाह रावणी केरीन एक किलो मिटर ली जाय, ते ता हेऱ्यो दुय किलो मिटर जात रिजे। <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />जो कुण तुवा फाय रेन काह उदार मांगी; तो तुवा फाय एय ते आप; एने जो कुण तुवा फाय रेन उदार लेणे हुदेह, ताह देखीन मुय मा फिरीव हे।<verse eid="MAT 5:42" /></para>
  <para style="s">दुसमोनाह मोंग किरो</para>
  <para style="r">(<ref loc="LUK 6:27-28">लुका 6:27-28</ref>,<ref loc="LUK 6:32-36">32-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />तुमू होमेल लियेल हेते काय वेगाला वारान माणहाह कियेल एतो, “आपणा आहेंल्याह मोंग किरज्‍यो; एने दुसमोना हेऱ्या दुसमोनाय।”<note caller="+" style="x"><char style="xo" closed="false">5:43 </char><char style="xt" closed="false"><ref loc="LEV 19:18">लेव्यवस्था 19:18</ref></char></note> <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />पुण मी तुमूह ज्य केथु काय तुमरा दुसमोनाह मोंग किरज्‍यो एने जा तुमूह तेकलीत देतेह तानकेरता विन्ता किरो, <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />इहकेरीन तुमू तुमरा हेरगावाला आबाख ने सोरा केवाहो, काहाकाय तोच हाजाला एने बाकताला दुयू पोर तान दिह उगाड़ने, एने देरमी पापी दुयू पोर पाणी पाड़ने। <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />केदी तुमूह मोंग केरनारा हेऱ्यास तुमू मोंग किरहो, ते तुमरे केरता काय फोल एय? काय फालो उकालनारे बी इहीचकेरीन नाह केरते? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />केदी तुमरा बायाख ओलास तुमू नमस्‍कार किरहो, ते काल्लो मोटलो काम केरतेह? काय बिगेर यहुदि माणहे बी इहकेरीन नाह केरते? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />जीह केरीन तुमरो हेरगावालो आबोख सिद्द<note caller="+" style="f"><char style="fr" closed="false">5:48 </char><char style="ft" closed="false">बोगवानान आखी वातुह मानील माणुह</char></note> हे तिहेच केरीन तुमू बी सिद्द बोणो।<note caller="+" style="x"><char style="xo" closed="false">5:48 </char><char style="xt" closed="false"><ref loc="LEV 19:2">लेव्यवस्था 19:2</ref>; <ref loc="DEU 18:13">व्यवस्था 18:13</ref></char></note><verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">दान किहकेरीन आपणु</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 23:5">मत्ती 23:5</ref>
      </char>
    </note>होमालीन रिज्यो! तुमू माणहाह देखाड़नेन केरता तुमरा देरमान काम मा किरहो, नाह ते तुमरा हेरगावाला आबाख फाय रेन तुमूह कायच बी फोल नाय जुड़ी।<verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />तानकेरता जेवी तु दान किरहे, जिहकेरीन कोपटी माणहे मिटींग माय, एने गेल्ली माय पावली वाजाड़तेह तान गेत मा किरहे, काहाकाय माणहे तान बोड़ाय केरी केरीन ताह ओहलो केरनु, पुण मी तुमूह खेरीच केथु काय ताह तान फोल जुड़ गीयो। <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />पुण जेवी तु दान किरहे, ते जो तारो जीवड्यो आथ किरेह, तो डाखऱ्यो आथ जाणने नाय जुवे। <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />काहाकाय तार दान लिकेल<note caller="+" style="f"><char style="fr" closed="false">6:4 </char><char style="ft" closed="false">माणहाह रेन उलीव</char></note> रेय, तेवी तार आबोख जो आठावे दिखेह, तुवाह बोरकेत आपी।<verse eid="MAT 6:4" /></para>
  <para style="s">विन्तान बाराम हिकवोण</para>
  <para style="r">(<ref loc="LUK 11:2-4">लुका 11:2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:5 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 18:10-14">लुका 18:10-14</ref>
      </char>
    </note>जेवी तु विन्ता किरहे, ते कोपट्यान गेत मा किरहे, काहाकाय ता माणहाह देखाड़नेन केरीन बोक्ती केरन्या गेराम, एने सेड़क्यु पोर उबरीन विन्ता केरनेन ताह हाजो लागणे। मी तुमूह खेरीच केथु काय ताह तान बोरकेत जुड़ गीयो। <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />पुण जेवी तु विन्ता किरहे, ते तारा गेरा माय जा, एने बायणो बोंद केरीन तार बोगवान आबोख जो आठावे हे विन्ता केर। तेवी तार आबोख जो आठावे हे, दिखेह, एने तुवाह बोरकेत आपी।<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />विन्ता केरनेन बुखेत बिगेर यहुदि माणहान गेत च्‍याव च्‍याव मा किरहो, काहाकाय ता सोमेजणु काय तान जास्ती बोलना माय तान होमलाय जाय। <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />तानकेरता तान गेत मा बुणहो, काहाकाय तुमरो आबोख तुमूह मांगणेन पेल जाणेह काय तुमरी काय काय जोरवुत हे। <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" />ओवता तुमू इहकेरीन विन्ता किरज्‍यो:</para>
  <para style="q1" vid="MAT 6:9">“एय आमरा आबा तु जो हेरगा माय हे,</para>
  <para style="q2" vid="MAT 6:9">तारो नाव चोखालो मानाय जाय;<verse eid="MAT 6:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="MAT 6:10" />तारो राज आवी;</para>
  <para style="q1" vid="MAT 6:10">एने तारी मोरजी जिहकेरीन हेरगा माय पुरी ईथे, तिहेस केरीन देरती पोर बी एय।<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />आमरो दाड़ीन दिह ने खाणो आज आमुह आप।<note caller="+" style="f"><char style="fr" closed="false">6:11 </char><char style="ft" closed="false">आमुह गिरेज हे</char></note><verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />एने जिहकेरीन आमु आमरा गुनेगाराह माफ केऱ्याह,</para>
  <para style="q2" vid="MAT 6:12">तिहेच केरीन तु बी आमरा गुनाह माफ केर।<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />एने आमुह पारेख माय मा पाड़हे,</para>
  <para style="q2" vid="MAT 6:13">पुण खाराबाह रेन वोचाड़, काहाकाय राज एने ताकेत एने बोड़ाय कायेम तारीस हे, आमेन।”<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">थोड़ाक लेख माय काहाकाय राज, ताकेत एने बोड़ाय कायेम तारीस हे लिखेल हे</char></note><verse eid="MAT 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:14 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 11:25">मरकुस 11:25</ref>,<ref loc="MRK 11:26">26</ref></char>
    </note>केदी तुमू माणहान गुनाह माफ किरहो, ते तुमरो हेरगावालो आबोख बी तुमरा गुनाह माफ केरी। <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />एने केदी तुमू माणहान गुनाह माफ नाय किरहो, ते तुमरो आबोख बी तुमरा गुनाह माफ नाय केरी।<verse eid="MAT 6:15" /></para>
  <para style="s">उपासान बाराम हिकवोण</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />जेवी तुमू उपास किरहो, ते कोपट्यान गेत मुया पोर कोमजोरी नाय देखाणे जुवे, काहाकाय तान मुय ता ओहलो बाणाव लेणु, काय माणहे ताह उपासी जाणे। मी तुमूह खेरीच केथु काय ताह तान बोरकेत जुड़ गीयो। <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />पुण जेवी तु उपास किरहे, ते मुंडा पोर तेल लागाड़ एने मुय दोवजे, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />तान केरता माणहे नाह पुण तार बोगवान आबोख जो आठावे हे, तुवाह उपासी जाणे। एने तार आबोख जो आठावे हे, दिखेह, एने तुवाह बोरकेत आपी।<verse eid="MAT 6:18" /></para>
  <para style="s">खेरलो देन</para>
  <para style="r">(<ref loc="LUK 12:33-34">लुका 12:33-34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:19 </char>
      <char style="xt" closed="false">
        <ref loc="JAS 5:2">याकुब 5:2</ref>,<ref loc="JAS 5:3">3</ref></char>
    </note>तुमरी केरता देरती पोर मालदेन एकठा मा किरहो, जाहरी ओदाय एने जेंग बिगाड़ ने, एने चोर गेर तोड़ीन चोरी केर लेणे। <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />पुण तुमरी केरता हेरगा माय मालदेन टुलो किरो, ताहरी नाह ते ओदाय एने नाह ते जेंग बिगाड़ ने, एने ताहरी नाह ते चोर गेर तोड़ी एने नाह ते चोरी केरी। <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />काहाकाय जाहरी तुमरो मालदेन हे, ताहरीस तुमरो मोन बी लाग रेय।<verse eid="MAT 6:21" /></para>
  <para style="s">सेरीरान उजालो</para>
  <para style="r">(<ref loc="LUK 11:34-36">लुका 11:34-36</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />सेरीरान दिवो डुलो हे। केदी तार डुलो निर्दोस हे, ते तारो आखो सेरीर बी उजालो रेय। <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />एने केदी तार डुलो खाराब हे, ते तारो आखो सेरीर बी आंदारलो रेय; ज्यानकेरता काय तो उजालो जो तार माय हे केदी आंदारलो एय, ते तो आंदारलो कोलोक मोठो एय।<verse eid="MAT 6:23" /></para>
  <para style="s">बोगवान एने देन</para>
  <para style="r">(<ref loc="LUK 16:13">लुका 16:13</ref>; <ref loc="LUK 12:22-31">12:22-31</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />काल्लो बी पावोर दुय मालक्यान चाकरी नाह केर सिकेत, काहाकाय तो एका हिऱ्यो ईमानदार, एने दिहराह मोंग केरी, नाहते ओवतो एका हिऱ्यो मिलीन रेय एने दिहराह कायच नाय सोमजी। तुमू बोगवानान एने मालदेनान दुयान चाकरी नाह केर सेकते।<verse eid="MAT 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />ज्यानकेरता मी तुमूह केथु काय आपणा जीवान कालजी मा किरहो, काय आमु काय खाहु एने काय पिहु; एने नाह आपणा सेरीरान केरता काय काय पेरहु। काय जीव रोटाह रेन; एने सेरीर फाड़काह रेन वोदार नाह सोतो काय? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />चीड़ाह दिखो, ता नाह ते पेरते नाह ते काटतेह, एने नाह ते मोटक्या माय एकठो केरतेह; तीबी तुमरो हेरगावालो आबोख ताह खावड़ावेह, काय तुमू ताह रेन होवटा किमतीन नाह सोता? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" /><note caller="+" style="f"><char style="fr" closed="false">6:27 </char><char style="ft" closed="false">थोड़ोक जीवो</char></note>तुमरे माय कुण ओहलो हे, जो चिन्ता केरीन तान जीवाय आथ बोर वोदाड़ सेकी?<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />एने फाड़कान केरीन काहा चिन्ता केरतेह? जेंगला मायवाला फुलाह दिखो! ता किहेक मोठा एतेह; ता नाह ते मेहनेत केरते, एने नाह ते हुकतेह। <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />तीबी मी तुमूह केथु, काय सुलेमान राजा बी तान आखा राज ने काल माय ताम रेन एकान गेत बी नाह फाड़का पेरेल इतो।<note caller="+" style="x"><char style="xo" closed="false">6:29 </char><char style="xt" closed="false"><ref loc="1KI 10:4-7">1 राजा 10:4-7</ref>; <ref loc="2CH 9:3-6">2 इतिहास 9:3-6</ref></char></note> <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />तानकेरता एय अविश्वासी! जेवी बोगवान जेंगला मायवाला खेड़ाह, जो आज हे एने काल आक्‍ठा माय हेलगी जाथे, ओहलाह तो फाड़का पेरावेह, ते काय तुमूह न्याह रेन वोदार नाय पेरावी।<verse eid="MAT 6:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 6:31" />तानकेरीन तुमू चिन्ता केरीन ज्य मा किहो काय आमु काय खाहु, एने काय पिहु, एने काय पेरहु। <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />काहाकाय ज्यी दुनियान माणहे ज्यी आखी वोस्तुह होदते रेतेह, पुण तुमरो हेरगावालो आबोख जाणेह काय तुमूह ज्‍यु आखी वोस्तुन गिरेज हे। <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />पुण पेल तुमू बोगवानान राज एने तान देरमाह हुदो, ते ज्‍यु आखी वोस्तु बी तुमूह जुड़ जाती। <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />तानकेरीन हेकालेन चिन्ता मा किरहो, काहाकाय हेकालेन दिह तान चिन्ता तोच केर लेय; आजीन केरीन आजुच ने दुख जुलूम हे।<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">दिहरा पोर गुनो मा लागाड़हे</para>
  <para style="r">(<ref loc="LUK 6:37-38">लुका 6:37-38</ref>,<ref loc="LUK 6:41">41</ref>,<ref loc="LUK 6:42">42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />दिहरा पोर गुनो मा लागाड़हो काय तुमरी पोर बी गुनो नाय लागाड़ाय जाय। <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" /><note caller="+" style="x"><char style="xo" closed="false">7:2 </char><char style="xt" closed="false"><ref loc="MRK 4:24">मरकुस 4:24</ref></char></note>काहाकाय जिहकेरीन तुमू गुनो लागाड़तेह, तिहेस केरीन तुमरी पोर बी गुनो लागाड़ाय; एने जा मापा केरीन तुमू मापतेह, तास मापा केरीन तुमरी केरता बी मापाय। <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />तु तारा बाहख ने डोलाम कोचरो काहा दिखेह, तुवाह तारा डोलाम होट्य नाह मालुम पोड़ेत काय? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />जेवी ताराच डोलाम होट्य हे, ते तार बायाख किहीक केय सिकेह! काय लाव मी तारा डोलाम रेन कोचरो काड़ देह? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />एय कोपटी, पेल तारा डोला माय रेन होट्य काड़ले, तेवी तु तारा बायाख ने डोला माय रेन कोचरो हास केरीन देखीन काड़ सिकहे।<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />चोखाली वोस्तु चिताह मा आपहो, एने तुमरो हिरामोती हुवऱ्यान ओंगाण मा टाकहो; एने ओहलो नाय एय काय हुवऱ्या ताह पाया बुंद रोहदेल देती, एने फिरीन तुमूह फाड टाकती।<verse eid="MAT 7:6" /></para>
  <para style="s">मांगहो ते जुड़ी</para>
  <para style="r">(<ref loc="LUK 11:9-13">लुका 11:9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />एने मी तुमूह केथु, “मांगहो ते तुमूह आपी; हुदहो ते तुमूह जुड़ी; बायणाह ठुको ते तुमरी केरता उगड़ी जाय। <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />काहाकाय जो कुण मांगेह, ताह जुड़ने; एने जो हुदेह ताह सापड़ने; एने जो बायणाह ठोकेह तान केरता उगड़ी जाय।” <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />तुमरे माय रेन ओहलो काल्लो माणुह हे, केदी तान सोरो रूटो मांगी, ते ताह दिगोड़ आपी? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />एने मासो मांगी ते ताह गेयड़ेह आपी? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />जेवी तुमू खाराब एन बी तुमरा सोराह हाजी वोस्तु आपणेन जाणतेह, ते तुमरो हेरगावालो आबोख ता फाय रेन मांगणाराह हाजी वोस्तु काहा नाय आपी?<verse eid="MAT 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">7:12 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 6:31">लुका 6:31</ref>
      </char>
    </note>एने जो वेवारो माणहा फाय रेन तुमू होदतेह, तोहलोच वेवारो माणहा हेऱ्या बी तिहेच केरीन किरो; काहाकाय मुसान कायदो एने जाणकारान हिकवोण ज्‍योच हे।<verse eid="MAT 7:12" /></para>
  <para style="s">हाकड़ी एने चोवड़ी वाट</para>
  <para style="r">(<ref loc="LUK 13:24">लुका 13:24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />“हाकड़ा बायणाम रेन माय जावो, काहाकाय चोवड़ो हे तो बायणो एने हाजी हे ती वाट जी नासान उगे ली जाणे, एने जुलूम हेते जा ता माय रेन माय जातेह।” <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />पुण जो आतल्‍यो हे तो बायणो एने हाकड़ी हे ती वाट जीवणान उगे ली जाथे, एने थोड़ाच हेते ताह जुड़ी।<verse eid="MAT 7:14" /></para>
  <para style="s">जोहलो जाड़ तोहलो फोल</para>
  <para style="r">(<ref loc="LUK 6:43-44">लुका 6:43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />जुठा जाणकाराह रेन होमालीन रिज्यो, जा मेंड्रान वेहा माय तुमू फाय आवतेह, पुण माय रेन ता चिरफाड़ केरनारे कोलवा हेते। <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />तान फोलाह देखीन तुमू ताह ओलखी लिहो। काटाल्या जाड़ा पोर रेन अंगुर, एने खाराब जाड़ा पोर रेन अंजीर तोड़नु काय? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />तानकेरीन एकेक हाजाला जाड़ाह हाजालो फोल आवणे, एने खाराब जाड़ाह खाराब फोल आपणु। <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />हाजाला जाड़ाह खाराब फोल केदी नाह आवणे, एने खाराब जाड़ाह हाजालो फोल केदी नाह लागणे। <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" /><note caller="+" style="x"><char style="xo" closed="false">7:19 </char><char style="xt" closed="false"><ref loc="MAT 3:10">मत्ती 3:10</ref>; <ref loc="LUK 3:9">लुका 3:9</ref></char></note>एने जो जाड़ हाजो फोल नाह लावेत, ताह काट देणु एने आक्‍ठा माय टाक देणु। <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" /><note caller="+" style="x"><char style="xo" closed="false">7:20 </char><char style="xt" closed="false"><ref loc="MAT 12:33">मत्ती 12:33</ref></char></note>तानकेरता तान फोलाह देखीन ताह तुमू ओलखी लिहो।<verse eid="MAT 7:20" /></para>
  <para style="s">मी तुमूह नाह जाणेत</para>
  <para style="r">(<ref loc="LUK 13:25-27">लुका 13:25-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />जा माहु, “एय मालीक, एय मालीक केतेह,” ता माय रेन एक बी हेरगान राज माय जाय नाय सेकी, पुण तास जाय सेकती जा मारा हेरगावाला आबाख ने मोरजी पोर चालती। <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />ते दिह जुलूम माणहे केती, एय मालीक, काय आमु तारा नावान पारचार नाह होमलाड्या, एने जाणाव नाह केऱ्या एने तारा नाव केरीन खाराब जीवाह नाह निकालेल, एने तार नाव से जुलूम बोंगलाय ओहला चोमेत्कार नाह किरेल? <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />ते दिह मी ताह खेरी खेरी केय देह, “मी तुमूह केदीच ओलखेत नाह, एय खाराब काम केरनारे, मार आहने रेन सेटा एय जावो!”<verse eid="MAT 7:23" /></para>
  <para style="s">दुय गेर बाणावणारे माणहे</para>
  <para style="r">(<ref loc="LUK 6:47-49">लुका 6:47-49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />तानकेरता जो कुण मार वचनाह होमलीन तान गेत किरेह तो सोमेजदार माणहान गेत हे; तान गेर जो खेरबा पोर बांदेह। <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />ओवतो पाणी पोड़नो, खुदोर आवो, एने वारो बी आवो, एने गेरा हेऱ्यु ठोकानो; तीबी तो पोड़नो नाह, काहाकाय तान पायो खेरबा माय खोदीन बाणायेल इतो।<verse eid="MAT 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 7:26" />तिहेस केरीन जो कुण मार वचनाह होमलीन तान गेत नाह किरेत तो फोगा माणहान गेत हे, तान गेर तो रेटा माय बांदेह, <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />ओवतो पाणी पोड़नो, खुदोर आवो, एने वारो बी आवो, एने तान गेरा हेऱ्यो ठोकानो; तिहेस तो गेर पोड़ गीयो।<verse eid="MAT 7:27" /></para>
  <para style="s">यीशुन आदिकार</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />
    <note caller="+" style="x">
      <char style="xo" closed="false">7:28 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 1:22">मरकुस 1:22</ref>; <ref loc="LUK 4:32">लुका 4:32</ref></char>
    </note>जेवी यीशु ज्य आखो केणेन निवराव दिनो, तेवी ओहलो एनो काय माणहान गेरदी तान हिकवोणाह होमलीन बोंगलाय गियी। <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />काहाकाय तो ताह देरेमगुरून गेत नाह, पुण आदिकार माय ताह हिकाड़तालो।<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">यीशु कोढ लागेल माणहाह हुदारने</para>
  <para style="r">(<ref loc="MRK 1:40-45">मरकुस 1:40-45</ref>; <ref loc="MRK 5:12-16">5:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />जेवी यीशु बोयड़ा पोर रेन बुंदे उतरनो, एने माणहान मोटली गेरदी तान पासाण चाल देनी। <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" /><note caller="+" style="f"><char style="fr" closed="false">8:2 </char><char style="ft" closed="false">ओहलो मानतेह काय ज्यी बेमारी माणहाह देरमान नेम उगे मोजबुत किरेह </char></note>एने ता एक कोढ लागेल माणुह बी ता एतो, तो तान आहने तान ओंगाण पाया पोड़ीन केयो, “एय मालीक, केदी तारी मोरजी एय, ते तु माहु हुदार सिकेह।”<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />तेवी यीशु आथ ओंगाण केरीन ताह सापलीन केयो, “मारी मोरजी हे, तु हुदेर जाय।” एने चालोच तो हुदेर गीयो। <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />तेवी यीशु ताह केयो, “होमेल ज्य कुणीह मा किहे; पुण तु जाईन चाकऱ्याह देखाड़जे एने जो चेड़ावो मुसा ठेरायेल हे, ताह बेट चेड़ाव काय ता पोर माणहान केरता पुरावो एय।”<verse eid="MAT 8:4" /></para>
  <para style="s">एक रोमन आदिकारीन बुरहो</para>
  <para style="r">(<ref loc="LUK 7:1-10">लुका 7:1-10</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />जेवी यीशु कफरनहूम हेयरा माय आवो, ते एक रोमन आदिकारी ता फाय आवीन मोदेकीन केरता विन्ती किऱ्यो, <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />एने केयो, “एय मालीक मारा एक पावराह लोखवो लाग जायेल हे एने ताह जुलूम तेकलीत ईथे।”<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />तेवी यीशु ताह केयो, “मी आवीन ताह हुदारूह।”<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />आदिकारी ताह जापाप आप्यो, “एय मालीक मी ज्यान लायेक नाह सुतो काय तु मार गेरा माय आवी, केरीन निस्तो एक उकुम आप दे, ते मारो पावोर हुदेर जाय। <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />काहाकाय मी बी एक ओहलो माणुह हे एने सिपाय मार आथा माय हेते। एने जेवी मी एकाह केथु, ‘जा,’ ते तो जाणे; एने दिहराह ‘आव,’ ते तो आवणे; एने मी मार पावराह केणे काय ज्य केर, ते तो ताह केरने।”<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />ज्य होमलीन यीशु बोंगलाय गीयो, एने तान पासाण आवणारे जा माणहे एता ताह केयो, “मी तुमूह खेरीच केथु, मी ओलो पाको बुरहो इस्राएल माय बी कुणीस माय नाह दिख्यो। <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" /><note caller="+" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="LUK 13:29">लुका 13:29</ref></char></note>एने मी तुमूह केथु काय जुलूम माणहे पुर्व एने पश्‍चिम रेन आवीन अब्राहाम, इसहाक, एने याकुब हेऱ्या हेरगान राज ने खाणा माय बोहती। <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" /><note caller="+" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="MAT 22:13">मत्ती 22:13</ref>; <ref loc="MAT 25:30">25:30</ref>; <ref loc="LUK 13:28">लुका 13:28</ref></char></note>पुण राज ने सोरा बाहेर आंदारा माय टाकाय जाती, ताहरी रेड़णो एने दात केकड़ावणो रेय।” <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" />तेवी यीशु आदिकारीह केयो, “गेर जा, जोहलो तार बुरहो हे तोहलोस तार केरता एय।” एने तान पावोर तुलेचबूखे हुदेर गीयो।<verse eid="MAT 8:13" /></para>
  <para style="s">यीशु मोकतास दुखाऱ्याह हुदारने</para>
  <para style="r">(<ref loc="MRK 1:29-34">मरकुस 1:29-34</ref>; <ref loc="LUK 4:38-41">लुका 4:38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />यीशु जेवी पतरसान गेर पोचनो, ते तो पतरसान हाहवोकीह हेरी माय दुखारी खाटला पोर लोट रियेल दिख्यो। <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />एने यीशु तीन आथाह सापल्यो; एने तीन हेरी उतरी गियी, एने ती उठीन तान सेवा चाकरी केरने बाज गियी।<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />एने हाजीन वेला मोकतास माणहे यीशु फाय जुलूम होवटा माणहाह लावा। जा माय खाराब जीवे एता, तो ता खाराब जीवाह तान बोल केरीन निकाल दिनो, एने आखा दुखाऱ्याह हुदार दिनो। <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />काहाकाय जो वचन यशाया जाणकारान द्‍वारे कियेल एतो तो पुरो एय: यीशु सोता आपणी कोमजोरीह लेय लिदो, एने आपणी बेमारीह विस लिदो।<note caller="+" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="ISA 53:4">यशाया 53:4</ref></char></note><verse eid="MAT 8:17" /></para>
  <para style="s">यीशुन चेला बोणनेन किमोत</para>
  <para style="r">(<ref loc="LUK 9:57-62">लुका 9:57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />यीशु जेवी तान कावदेन माणहान एक मोटली गेरदी दिख्यो, ते तो तान चेलाह देरीयान ती मीरे जाणेन उकुम आप्यो। <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />तेवी एक देरेमगुरू आहने आवीन ताह केयो, “एय मास्तेर, जा बी तु जाहे, मी तार पासाण चाल देह।”<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />यीशु ताह जापाप आप्यो, “कोल्यान देर, एने जुगावाला चीड़ान पांजरा रेतेह, पुण माणहान बेटाख फाय मुंड लीकाड़ ने बी जागो नाह सोतो।”<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />एक उंजु दिहरो चेलो ताह केयो, “एय मालीक, पेल माहु जाणे दे, काय मी मार आबाख बुज देव।”<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />यीशु ताह केयो, “तु मार पासाण चाल दे, मुरेल ताह तान मुरदाह बुजणे दे।”<verse eid="MAT 8:22" /></para>
  <para style="s">यीशु तुफानाह ठावको केरने</para>
  <para style="r">(<ref loc="MRK 4:35-41">मरकुस 4:35-41</ref>; <ref loc="LUK 8:22-25">लुका 8:22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />जेवी यीशु डोंडह्या पोर चेड़नो, ते तान चेला बी तान पासाण चेड़ना। <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />एने उचकाहुच देरीया माय ओहलो मोठो तुफान आवो काय डोंडह्यो लाटा माय बुजाणे बाज गीयो, पुण यीशु हुवणे बाजरियेल इतो। <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />तेवी चेला आहने आवीन ताह जागाड्या। एने केया, “एय मालीक, आमुह वोचाड़, आपु खेतेम एणे बाजरेनाह!”<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />तेवी यीशु ताह केयो, “एय अविश्वासी काहा बितेह?” एने तो उठीन वादोण एने पाण्याह दोपकाड्यो, एने आखो ठावको एय गीयो।<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />एने चेला बोंगलायीन केणे बाज गीया, “ज्यो कोहलो माणुह हे? वादोण एने पाणी बी ज्यान उकुम मान्तेह।”<verse eid="MAT 8:27" /></para>
  <para style="s">यीशु दुय खाराब जीव लागेल माणहाह हुदारने</para>
  <para style="r">(<ref loc="MRK 5:1-20">मरकुस 5:1-20</ref>; <ref loc="LUK 8:26-39">लुका 8:26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />जेवी यीशु ती मीरे गदरेनियोन देसा माय पोचनो, ते ताह माहणा माय रेन जाणे बाजरियेल इतो तेवी दुय माणहे मिलना, जा माय खाराब जीव एता, ता दुयू ओला बियावी ओहला एता, काय कुण बी ती वाटे रेन जाय नाह सेकतालो। <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />ता आयड़ीन केणे बाज गीया, “एय बोगवानान बेटाख, आमरो तुवा हेऱ्यो काय काम? काय तु टेमीह रेन पेल आमुह दुख देणेन न्या आयेल हे?”<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />ताह रेन जारीक सेटोह जुलूम होवटा हुवऱ्यान एक टुलो चेरने बाजरियेल इतो। <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />ता खाराब जीव ताह विन्ती केरीन केया, “केदी तु आमुह बाहेर निकालेह, ते पोला हुवऱ्यान टोला माय मोकेल दे।”<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />यीशु ताह केयो, “जावो,” तेवी ता ता माणहा माय रेन निकलीन ता हुवऱ्या माय रिग गीया। ओलो आखो हुवऱ्यान टुलो आड़वाया माय रेन उतरीन देरीया माय जाय पोड़नो, एने बुड़ीन मोर गीया।<verse eid="MAT 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 8:33" />ज्य देखीन हुवऱ्यान गोवाले नाठा, एने हेयराम जाईन ज्‍यु आख्‍यु वातु एने जा माय खाराब जीव एता, तान बाराम आखो काय केय होमलाया। <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />तेवी आखा हेयरान सोब माणहे यीशुह मिलनेन केरता आवा; एने ताह देखीन विन्ती केऱ्या काय तो तान ईलाका माय रेन दिहरी जागे जात रेय।<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">यीशु लोखवान दुखाऱ्याह हुदारने</para>
  <para style="r">(<ref loc="MRK 2:1-12">मरकुस 2:1-12</ref>; <ref loc="LUK 5:17-26">लुका 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />ओवतो यीशु डोंडह्या माय बोहीन ती पार गीयो, एने तान हेयरा माय आवो,<note caller="+" style="f"><char style="fr" closed="false">9:1 </char><char style="ft" closed="false">कफरनहूम </char></note> <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />एने दिखो, थोड़ाक माणहे लोखवान बेमारी वालाह खाटला पोर लोटाड़ीन ता फाय लावा। यीशु तान बुरहो देखीन ता लोखवान बेमारी वाला माणहाह केयो, “एय बेटा! दिर खा, तारा पाप माफ एय गीया।”<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />तेवी देरेमगुरू माय रेन थोड़ाक आपसा माय बोलाचाल केरीन केया, “ज्यो ते बोगवानान चिहटा किरेह।”<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />यीशु तान मोनान वातु जाणीन केयो, “तुमू तुमरा मोना माय खाराब विचार काहा केरतेह? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />होपो काय हे, ‘ज्य केणे काय तारा पाप माफ एय गीया,’ काय ज्य केणे, ‘उठ एने चाल फिर?’ <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />पुण तुमू ज्य जाण लिवो, माहु माणहान बेटाख देरती पोर पापाह माफ केरनेन आदिकार हे।” ओवतो यीशु लोखवान बेमारी वाला माणहाह केयो, “उठ, तारो खाटलो विस एने तार गेर जातरे!”<verse eid="MAT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7" />तो उठीन तान गेर जात रेनो। <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />माणहे ज्य देखीन बिय गीया एने बोगवानान बोड़ाय केरने बाज गीया, जो माणहाह ओहलो आदिकार आपेल हे।<verse eid="MAT 9:8" /></para>
  <para style="s">यीशु मत्तीह हादणे</para>
  <para style="r">(<ref loc="MRK 2:13-17">मरकुस 2:13-17</ref>; <ref loc="LUK 5:27-32">लुका 5:27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />जेवी यीशु ता रेन जाणे बाजरियेल इतो तेवी तो फालो उकालने जागे एक माणहाह बोह रियेल दिख्यो, तान नाव मत्ती एतो। यीशु ताह केयो, “मार पासाण आव लाग। तेवी तो उठीन तान पासाण चाल दिनो।”<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">9:10 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 15:1">लुका 15:1</ref>,<ref loc="LUK 15:2">2</ref></char>
    </note>जेवी यीशु लेवीन गेरा माय रूटो खाणेन बोह रियेल इतो,<note caller="+" style="f"><char style="fr" closed="false">9:10 </char><char style="ft" closed="false">लेवीन गेरा माय</char></note> तेवी जुलूम होवटा फालो उकालनारे एने पापी आवीन ता हेऱ्या बोह रियेल एता। <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />तेवी ज्य देखीन फरिसी यीशुन चेलाह केया, “तुमरो गुरू फालो उकालनारा एने पापी हिऱ्यो काहा खाथे?”<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />ज्य होमलीन यीशु ताह जापाप आप्यो, “वोंसी हाजालान केरता नाह पुण दुखाऱ्यान केरता जोरवरी हे। <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />तानकेरता तुमू जावो एने ज्यान मतलब काय हे तो जाण लिवो, ‘मी बोली नाह, पुण गीण होदथो।’ काहाकाय मी देरमी माणहाह नाह, पुण पापीह हादणेन आयेल हे।”<note caller="+" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="MAT 12:7">मत्ती 12:7</ref>; <ref loc="HOS 6:6">होशे 6:6</ref></char></note><verse eid="MAT 9:13" /></para>
  <para style="s">उपासान बाराम सावाल</para>
  <para style="r">(<ref loc="MAT 2:18-22">मत्ती 2:18-22</ref>; <ref loc="LUK 5:33-39">लुका 5:33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />तेवी बपतीस्मा केरनार योहानान चेला यीशु फाय आवीन केया, “काय कारेण हे, काय आमु एने फरिसी ते उपास देरतेह, पुण तारा चेला उपास काहा नाह देरते?”<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />यीशु ताह जापाप आप्यो, “जाह वोर वोवड़ो वाराड्या हिऱ्यो हे काय ता दुख मोणावती? पुण ता दिह आवती जेवी वोवड़ो ता हिऱ्यो रेन आलेग एय जाय, तेवी ता उपास देरती।<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />“नोवाला फाड़कान ठिगलो जुनाला फाड़का पोर कुण नाह लागाड़ने, काहाकाय तो ठिगलो ता फाड़काह होवटोह फाड़ देय, एने फाड़को जादा कोचलाय जाय। <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />एने नोवाला अंगुरान रूहाह जुनाला चामड़ान थेयली माय नाह बोरते, काहाकाय ओहलो केरहु ताहार चामड़ान थेयली फाट जाथे, तानकेरता नोवाला अंगुरान रूहाह, नोवाली चामड़ान थेयली माय बोरनु, तेवी रूह एने थेयली दुयू वोचीन रेती।”<verse eid="MAT 9:17" /></para>
  <para style="s">यीशु मुरेल सोरीह जीवतो केरने एने दुखारी बायकु हुदारने</para>
  <para style="r">(<ref loc="MRK 5:21-43">मरकुस 5:21-43</ref>; <ref loc="LUK 8:40-56">लुका 8:40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />यीशु ता हिऱ्यो वातु केरनेच बाजरियेल इतो, तोलाक माय यहुदि पोंचान एक आदिकारी ता फाय आवो, एने तान पाया पोड़ीन केयो, “मारी सोरी एवीच मोरनीह; पुण तु केदी आवीन ती पोर आथ मिलहे, ते ती जीवताली एय जाय।”<verse eid="MAT 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 9:19" />तेवी यीशु उठीन, तान चेला हिऱ्यो तान पासाण चाल दिनो।<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />एने ता एक बायकु एती जीह बारा वोरह्या रेन लुय वोयणेन बेमारी एती, ती पासाण रेन आवीन यीशुन फाड़कान सेंडो सापेल लेदी। <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />काहाकाय ती तीन मोना माय विचार केरताली, “केदी मी तान फाड़काह ओलीच सापली लेह ते हुदेर जाह।”<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />यीशु फिरीन तीह दिख्यो, एने केयो, “मार बेटी दिर खा! तारो बुरहो तुवाह हुदार दियेल हे।” एने ती चालोच हुदरी गियी।<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />जेवी यीशु ता आदिकारीन गेर पोचनो। तो पावला वाजाड़नाराह एने गेरदीह आयेड़ तालो दिख्यो, <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />एने यीशु केयो, “तुमू आखा बाहेर जात रिवो, सोरी मोरी नाह, पुण हुवणे बाजरेनीह!” ज्य होमलीन माणहे तान मोजाक उड़ाया। <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />पुण जेवी आखा माणहाह बाहेर निकाल देना, ते यीशु सोरीह मिलेल ती जागे जाईन तीन आथ दिऱ्यो, एने ती जीव उठनी। <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />एने ज्यी वातुन खोबेर आखा देसा माय पोसीर गियी।<verse eid="MAT 9:26" /></para>
  <para style="s">यीशु दुय आंदला माणहाह देखतो केरने</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />जेवी यीशु तारेन जाणे बाजरियेल इतो, ते दुय आंदला तान पासाण चाल देना एने इहकेरीन आयेड़ने बाज गीया, “एय दाऊदान बेटाख, आमु पोर गीण केर!”<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />जेवी यीशु गेरा माय आवो, तेवी यीशु केयो, “तुमूह बुरहो हे काय मी तुमूह हुदार सेकथु?” ता जापाप आप्या, “होव मालीक!”<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />तेवी यीशु तान डोलाह सापलीन केयो, “तुमरा बोरहान गेत, तुमरी केरता एय!” <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />एने तान डोला उगड़ी गीया। ओवतो यीशु ताह सोमजाड़ीन केयो, “उशारिम ज्यी वात कुण बी जाणने नाय जुवे!”<verse eid="MAT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 9:31" />पुण ता ता रेन जाईन आखा देसाम यीशुन बाराम केय होमलाया।<verse eid="MAT 9:31" /></para>
  <para style="s">एक मुकाह बोलतो केरने</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />जेवी यीशु एने तान चेला बाहेर जाणे बाजरियेल एता, तेवी माणहे एक मुकाह जा माय खाराब जीव एतो, ता फाय लावा। <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />एने जेवी तो खाराब जीवाह निकाल दिनो, ते तो मुको, जो पेल कायच बोल नाह सेकतालो, बोलने बाज गीयो। ज्य देखीन आखा माणहे बोंगलायीन केया, “इस्राएल माय ओहली वात केदीच नाह देख्या।”<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />
    <note caller="+" style="x">
      <char style="xo" closed="false">9:34 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:25">मत्ती 10:25</ref>; <ref loc="MAT 12:24">12:24</ref>; <ref loc="MRK 3:22">मरकुस 3:22</ref>; <ref loc="LUK 11:15">लुका 11:15</ref></char>
    </note>पुण फरिसी केया, “ज्यो ते बुतड़ान मुखीन मोदेक लेन बुतड़ाह निकालेह।”<verse eid="MAT 9:34" /></para>
  <para style="s">यीशुन गीण</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />
    <note caller="+" style="x">
      <char style="xo" closed="false">9:35 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:23">मत्ती 4:23</ref>; <ref loc="MRK 1:39">मरकुस 1:39</ref>; <ref loc="LUK 4:44">लुका 4:44</ref></char>
    </note>यीशु यहुदियान बोक्ती केरन्या गेरा माय जाईन हिकाड़तालो, एने बोगवानान राज ने हाजाली खोबरीन पारचार केरतालो, एने माणहान बेमारीह एने सोब बातीन बेमारी एने कोमजोरीह सिटो किरते; ता आखा ईलाका माय गाव गाव एने हियोर हियोर फिरतालो। <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />जेवी तो माणहान गेरदीह दिख्यो, ते ताह माणहा पोर जुलूम किव आवी, काहाकाय माणहे ता मेंड्रान गेत दुखी चिन्ता माय बोरायेल एने नाराज एता जान कुण गोवाल नाह रेणे।<note caller="+" style="x"><char style="xo" closed="false">9:36 </char><char style="xt" closed="false"><ref loc="NUM 27:17">गिनती 27:17</ref>; <ref loc="1KI 22:17">1 राजा 22:17</ref>; <ref loc="2CH 18:16">2 इतिहास 18:16</ref>; <ref loc="EZK 34:5">यहेजकेल 34:5</ref>; <ref loc="MRK 6:34">मरकुस 6:34</ref></char></note> <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" /><note caller="+" style="x"><char style="xo" closed="false">9:37 </char><char style="xt" closed="false"><ref loc="LUK 10:2">लुका 10:2</ref></char></note>तेवी यीशु तान चेलाह केयो, “पाकेल कामाय जुलूम हे, पुण मोंजर्‍या थोड़ाच हेते। <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />तानकेरता कामायीन मालीकाह किवो काय तो तान खेतान कामाय काटणेन केरता मोंजर्‍या मोकली।”<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">बारा चेलान काम</para>
  <para style="r">(<ref loc="MRK 3:13-19">मरकुस 3:13-19</ref>; <ref loc="LUK 6:12-16">लुका 6:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />उवतो यीशु तान बारा चेलाह आहने हादिन, ताह बुतड़ा निकालने एने आखी बातीन बेमारीह, एने आखी बातीन कोमजोरीह सिटो केरनेन आदिकार आप्यो। <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />ता बारा प्रेरितान नावे ज्या हेते: पेल्लो, शमोन जो पतरस केवाणे, एने तान बाहख अन्द्रियास; जब्दीन बिटोख याकुब, एने तान बाहख योहान; <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />फिलीपुस, एने बरतुल्मे, थोमा, एने फालो उकालनार मत्ती, हलफाईन बिटोख याकुब, तद्दे; <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />शमोन कनानी, एने यहुदा इस्‍कोरिती जो यीशुह देराव बी दियेल।<verse eid="MAT 10:4" /></para>
  <para style="s">बारा चेलान सेवान काम</para>
  <para style="r">(<ref loc="MRK 6:7-13">मरकुस 6:7-13</ref>; <ref loc="LUK 9:1-6">लुका 9:1-6</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />तेवी यीशु बाराह चेलाह ज्यो उकुम आपीन मुकल्यो: “बिगेर यहुदि माणहान उगे मा जाहो, एने सामरीयान काल्ला बी हेयराम मा जाहो। <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />पुण इस्राएलान गेराणान टाकायेल मेंड्रा फाय जाज्यो। <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />एने चालते चालतेन ज्यो पारचार किरो, ‘हेरगान राज आहने आव लागेल हे!’<note caller="+" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="LUK 10:4-12">लुका 10:4-12</ref></char></note> <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />दुखाऱ्याह हुदारो, मोरेलाह जीवाड़ो, कोढीह हाजा किरो, बुतड़ाह निकालो, तुमूह फुकेट माय जुड़ेल हे, फुकेट माय आपु। <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />तुमरा थेयला माय नाहते होनो, एने नाह पोयशा, एने नाह ताबो मेलज्यो; <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" /><note caller="+" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="1CO 9:14">1 कुरिंथीयो 9:14</ref>; <ref loc="1TI 5:18">1 तीमुथीयुस 5:18</ref></char></note>वाटीन केरता थेयलो, दुय जोड़ डेगला, खाहड़ा एने डेंगो मा लिहो, काहाकाय मोंजऱ्याह तान खाणो जुड़ने जुवे।”<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />जा बी हेयराम एने गावाम जाहो, ते पोतो लागाड़ो काय काल्लो माणुह जो मोदेक केरनार हे, एने जाह वोर ता रेन नाह निकेलते ताज ने गेराम रिज्यो। <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />जेवी गेराम रिगहो ते ताह बोरकेत आपज्यो। <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />केदी ता गेरान माणहे लायकीन एती ते तुमरी सान्ती ता पोर पोची, पुण केदी ता लायकीन नाय एती ते तुमरी सान्ती तुमू फाय फिरीन आवती रेय। <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" /><note caller="+" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="ACT 13:51">प्रेरितान काम 13:51</ref></char></note>जो कुण तुमूह गेराम नाय हादि एने तुमरी वातु नाय होमली, ते ता गेराम एने ता हेयराम रेन निकेलतेन तुमरा पायाम लेटकेल रेजड़ो जेटेक दिज्यो। <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" /><note caller="+" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 11:24">मत्ती 11:24</ref></char></note><note caller="+" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="LUK 10:4-12">लुका 10:4-12</ref></char></note>मी तुमूह खेरीच केथु, काय नियाव ने दिह ता हेयरान देशाह रेन सदोम एने अमोरान देसान देशाह होवटी वेठणेन लायेक रेय।<verse eid="MAT 10:15" /></para>
  <para style="s">ओंगाण आवणार पिड़ा</para>
  <para style="r">(<ref loc="MRK 13:9-13">मरकुस 13:9-13</ref>; <ref loc="LUK 21:12-17">लुका 21:12-17</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:16 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:3">लुका 10:3</ref>
      </char>
    </note> हुमलो, मी तुमूह मेंड्रान गेत कोलवान विची माय मोकेलथु, तानकेरता गेड़हान गेत ईकेलवाला एने पेरवान गेत बोला बोणो। <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" /><note caller="+" style="x"><char style="xo" closed="false">10:17 </char><char style="xt" closed="false"><ref loc="MRK 13:9-11">मरकुस 13:9-11</ref>; <ref loc="LUK 12:11">लुका 12:11</ref>,<ref loc="LUK 12:12">12</ref>; <ref loc="LUK 21:12-15">21:12-15</ref></char></note>पुण माणहाह रेन जोगवीन रिवो, काहाकाय ता तुमूह मोटला कोरटाम होपती, एने तान पोंचा माय तुमूह चापका देती। <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />तुमूह मार केरता आदिकारीन एने राजान सामने, एने बिगेर यहुदिन ओंगाण पुरावो रेणेन केरता पोचाड़ाय जाहो। <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />जेवी ता तुमूह देरावती, ते इहकेरीन कालजी मा किरहो काय आमु किहीक एने काय केहु; काहाकाय जो काय तुमूह केणेन एय तो तुलेचबूखे केवाय जाय। <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />काहाकाय बोलनारे तुमू नाह सोता; पुण तुमरा आबाख ने जीव तुमरे माय बोली।<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:21 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 13:12">मरकुस 13:12</ref>; <ref loc="LUK 21:16">लुका 21:16</ref></char>
    </note>बाहख बायाख, एने आबोख तान बेटाख मारनेन केरता देरीन होपी; एने सोरा तान आईख आबाख ने विरोद माय एन ताह माराव देती। <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" /><note caller="+" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="MAT 24:9">मत्ती 24:9</ref>; <ref loc="MRK 13:13">मरकुस 13:13</ref>; <ref loc="LUK 21:17">लुका 21:17</ref>; </char><char style="xt" closed="false"><ref loc="MAT 24:13">मत्ती 24:13</ref>; <ref loc="MRK 13:13">मरकुस 13:13</ref></char></note>मार नावान केरता आखा माणहे तुमू हेऱ्या दुसमोनाय केरती, पुण जो सेवली बुखेत वोर दिर देरीन रेय तास ने सुटकारो एय। <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />जेवी ता तुमूह एक गावाम तोपशा केरावती, ते दिहरे जागे जात रिज्यो। मी तुमूह खेरीच केथु, काय तुमू इस्राएलान आखा गावाम फिर नाय लिहो काय मी माणहान बिटोख आव जाह।<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:24 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 6:40">लुका 6:40</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="JHN 13:16">योहान 13:16</ref>; <ref loc="JHN 15:20">15:20</ref></char>
    </note>गुरूह रेन चेला नाह मोठा, एने नाह पावोर तान मालक्याह रेन। <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" /><note caller="+" style="x"><char style="xo" closed="false">10:25 </char><char style="xt" closed="false"><ref loc="MAT 9:34">मत्ती 9:34</ref>; <ref loc="MAT 12:24">12:24</ref>; <ref loc="MRK 3:22">मरकुस 3:22</ref>; <ref loc="LUK 11:15">लुका 11:15</ref></char></note>गुरून गेत चेला, एने मालीकान गेत पावरान रेणु ठिक हे। जेवी ता गेरान मालक्याह बालजबुल केया, ते तान गेरान माणहाह काहा नाय खाराब केती।<verse eid="MAT 10:25" /></para>
  <para style="s">कुणीह बिज्यो</para>
  <para style="r">(<ref loc="LUK 12:2-7">लुका 12:2-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:26 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 4:22">मरकुस 4:22</ref>; <ref loc="LUK 8:17">लुका 8:17</ref></char>
    </note>तानकेरता माणहाह मा बिवो। काहाकाय डापेल कायच नाह सोतो जो उगड़े नाय, एने नाह काय लिकायेल हे जो जाणाय नाय जाय। <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />जो मी तुमूह आदारला माय केथु ताह तुमू उजाला माय किवो, एने जो तुमरा कानाम कियेल हे एने जो होमलेल हेते, ताह तुमू गेरान साजा पोर रेन पारचार किरो। <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />जा सेरीराह नुकसान केरतेह, पुण जीवाह नुकसान नाह केर सेकते, ताह मा बिवो; पुण ताह बिवो जो जीवाह एने सेरीराह दुयूह बी नेरगान आक्‍ठा माय खेतेम केर सिकेह। <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />काय एक रूपियान दुय चीड़ा नाह वेचाते? तीबी तुमरा हेरगावाला आबाख ने मोरजीन बिगेर ताम रेन एक बी बुई पोर पोड़ नाह सिकेत <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />तुमरा मुंडान सोब लेट्या बी गेणायेल हेते। <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />तानकेरता बिवो मा; काहाकाय तुमू जुलूम चीड़ाह रेन वोड़ीन हेते! <figure style="fig" alt="Flat-roofed, olden house in Israel" file="lb00234c.tif" size="col" copy="Horace Knowles ©" ref="10:27">सापाट साजो, जुनाला कालान इस्राएल माय गेर</figure><verse eid="MAT 10:31" /></para>
  <para style="s">यीशुह मान्नु काय नाह मान्नु</para>
  <para style="r">(<ref loc="LUK 12:8-9">लुका 12:8-9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />मी तुमूह केथु, “जो कुण माणहान ओंगाण माहु स्वीकार केर लेय, ताह मी बी मार हेरगावाला आबाख ने सामने स्वीकार केर लेह। <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" /><note caller="+" style="x"><char style="xo" closed="false">10:33 </char><char style="xt" closed="false"><ref loc="2TI 2:12">2 तीमुथीयुस 2:12</ref></char></note>पुण जो कुण माणहान सामने मारो नाकार केरी, ताह मी बी मार हेरगावाला आबाख ने ओंगाण नाकार देह।<verse eid="MAT 10:33" /></para>
  <para style="s">यीशु आवो तेवी काय एनो</para>
  <para style="r">(<ref loc="LUK 12:51-53">लुका 12:51-53</ref>; <ref loc="LUK 14:26-27">14:26-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />“ज्य मा सोमजो काय मी देरती पोर मेल केरावणे आयेल हे, मी मेल केरावणे नाह, पुण तालवार चालाड़ने आयेल हे। <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />काहाकाय मी ज्यानकेरता आयेल हे, बेटाख तान आबाख हेऱ्या रेन, एने बेटीख तीन आईख हेरी रेन, एने वोवड़ीख तीन हाहवोक हेरी रेन सिटो केरने;<note caller="+" style="x"><char style="xo" closed="false">10:35 </char><char style="xt" closed="false"><ref loc="MIC 7:6">मीका 7:6</ref></char></note> <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />एने माणहान गेरल्यास तान दुसमोन रेती।<verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />“जो आईख आबाख माहु रेन जादा मोंग किरेह, तो मार लायकीन नाह सोतो; एने जो बेटीख बेटाख माहु रेन जादा मोंग किरेह, तो बी मार लायकीन नाह सोतो। <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" /><note caller="+" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="MAT 16:24">मत्ती 16:24</ref>; <ref loc="MRK 8:34">मरकुस 8:34</ref>; <ref loc="LUK 9:23">लुका 9:23</ref></char></note>एने जो कुण तान खुरूसखाम उखलीन मार पासाण नाह चालेत, तो मार लायकीन नाह सोतो। <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" /><note caller="+" style="x"><char style="xo" closed="false">10:39 </char><char style="xt" closed="false"><ref loc="MAT 16:25">मत्ती 16:25</ref>; <ref loc="MRK 8:35">मरकुस 8:35</ref>; <ref loc="LUK 9:24">लुका 9:24</ref>; <ref loc="LUK 17:33">17:33</ref>; <ref loc="JHN 12:25">योहान 12:25</ref></char></note>एने जो कुण तान जीवाह वोचाड़ने हुदेह ताह तो गोमाड़ देय, एने जो कुण मार केरता तान जीवाह गोमाड़ी, तो ताह जुड़ी।<verse eid="MAT 10:39" /></para>
  <para style="s">बोरकेत</para>
  <para style="r">(<ref loc="MRK 9:41">मरकुस 9:41</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:40 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:16">लुका 10:16</ref>; <ref loc="JHN 13:20">योहान 13:20</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="MRK 9:37">मरकुस 9:37</ref>; <ref loc="LUK 9:48">लुका 9:48</ref></char>
    </note>“जो कुण तुमूह आहने किरेह, तो माहु आहने किरेह, एने जो कुण माहु आहने किरेह, तो माहु मोकेलनाराह आहने किरेह। <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />जो कुण जाणकाराह जाणकार हे केरीन आहने किरेह, ताह जाणकारान फोल जुड़ी, एने जो कुण खेरलाह खेरलो हे केरीन आहने किरेह, ताह खेरायीन फोल जुड़ी। <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />जो कुण न्या आत्याम रेन एकाह मार चेलो जाणीन एक कोलह्यो पाणी पिवाड़ी, ते मी तुमूह खेरीच केथु, तो काल्ली बी रिती से तान फोल नाय गोमाड़ी।”<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">बपतीस्मा केरनार योहानान उगे रेन खोबेर</para>
  <para style="r">(<ref loc="LUK 7:18-35">लुका 7:18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />जेवी यीशु तान बारा चेलाह उकुम आप दिनो, ते यीशु तान हेयरा माय हिकाड़ने एने पारचार केरनेन केरता ता रेन जात रेनो।<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />बपतीस्मा केरनार योहान जेली माय रेन मसीन कामान खोबेर होमलेल, केरीन तान चेलाह ज्य फुसणे मुकल्यो। <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />“काय आवणार तुस हे, नाहते आमु एगदा दिहरान वाट जुवज्यो?”<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />यीशु ताह जापाप आप्यो, “जो काय तुमू होमेलतेह एने देखतेह, तो आखो जाईन योहानाह केय दिवो: <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" /><note caller="+" style="f"><char style="fr" closed="false">11:5 </char><char style="ft" closed="false">साप किऱ्यो</char></note>आंदला देखतेह, एने लेंगड़ा चालते फिरतेह, कोढी हुदेरतेह एने बेयरा होमेलतेह, एने मुरेल जीवताला एते जातेह, एने गेरब्याह हाजाली खोबेर होमालावाय जाथे।<note caller="+" style="x"><char style="xo" closed="false">11:5 </char><char style="xt" closed="false"><ref loc="ISA 35:5-6">यशाया 35:5-6</ref>; <ref loc="ISA 61:1">61:1</ref></char></note> <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />बोरकेतवालो हे तो माणुह, जो मार केरता ठोकेर नाय खाय!”<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />जेवी ता तारेन चाल देना, ते यीशु जाणे बुखेत योहानान बाराम माणहाह केयो, “तुमू उजाड़ी माय काय देखणे जायेल एता? काय वाराम आलताला टोकराह? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />ओवता तुमू काय देखणे जायेल एता? काय हुवाल्ला फाड़का पेरनारा माणहाह? जा हुवाल्ला फाड़का पेरतेह, ता राजवाड़ाम रेतेह! <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />ते ओवता तुमू काय देखणे जायेल एता? काय एगदा जाणकाराह देखणे? होव, मी तुमूह केथु जाणकाराह रेन बी मोटलाह। <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />ज्यो तोस हे जान बाराम लिखेल हे: ‘देख मी मार खोबर्‍याह तार ओंगाण मोकेलथु,’ जो तार ओंगाण तारी वाट तियार केरी।<note caller="+" style="x"><char style="xo" closed="false">11:10 </char><char style="xt" closed="false"><ref loc="MAL 3:1">मलाखी 3:1</ref></char></note> <verse eid="MAT 11:10" /><verse number="11" style="v" sid="MAT 11:11" />मी तुमूह खेरीच केथु काय जा बायकुम रेन पायदा ईयेल हेते, ताम रेन बपतीस्मा केरनारा योहानाह रेन कुणूस मोठो नाह ईनो; पुण जो हेरगान राज माय आत्याह रेन आत्यो हे तोस ताह रेन मोठो हे। <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" /><note caller="+" style="f"><char style="fr" closed="false">11:12 </char><char style="ft" closed="false">ताकेत माय आवणे बाजरिनोह</char></note>योहान बपतीस्मा केरनारान टेम रेन एवी वोर हेरगान राज माय जोरलेन रिगणो एतेन आयेल हे, एने ताकेतवाला ताह सांडाड़ लेतेह।<note caller="+" style="x"><char style="xo" closed="false">11:12 </char><char style="xt" closed="false"><ref loc="LUK 16:16">लुका 16:16</ref></char></note> <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />काहाकाय आखा जाणकार एने मुसान कायदान पुस्तेक ज्या योहाना वोर जाणाव किरते रेना। <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />केदी ज्यी वातुह मान्ने होद्तेह, ते ज्योस योहान एलिया हे, जो आवण्यो इतो।<note caller="+" style="x"><char style="xo" closed="false">11:14 </char><char style="xt" closed="false"><ref loc="MAL 4:5">मलाखी 4:5</ref>; <ref loc="MAT 17:10-13">मत्ती 17:10-13</ref>; <ref loc="MRK 9:11-13">मरकुस 9:11-13</ref></char></note> <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />जान कान एती, ता होमली लेय।”<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />मी ज्यी टेम ने माणहान गेणती कायता हेऱ्यो केरू? “ता माणहे आटा माय बोहणारा सोरान गेत हेते, जा एका दिहराह आयड़ीन केतेह, <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />‘आमु तुमरी केरता पावली वाजाड़ेल, पुण तुमू नाह नाचना! आमु रेड़ना एने रेड़नेन गीत गायेल, पुण तुमू दुखी नाह एना, ताज ने गेत ज्यी पिढीन माणहे हेते!’ <verse eid="MAT 11:17" /><verse number="18" style="v" sid="MAT 11:18" />काहाकाय बपतीस्मा केरनार योहान नाह खाते पिते आवो, एने तुमू केतेह, ‘ता माय बुतड़ो हे।’ <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />एने मी माणहान बिटोख खाते पितेन आवो, एने ता केतेह, दिखो, ‘खादाड़ एने दारूड्या माणहान, एने फालो उकालन्या पापी माणहान हाती हे!’ पुण ईकेल तान कामाह रेन खेरलो ठेराय जायेल हे।”<verse eid="MAT 11:19" /></para>
  <para style="s">विण बोरहा पोर हाय</para>
  <para style="r">(<ref loc="LUK 10:13-15">लुका 10:13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />उवतो यीशु ता हेयरान माणहाह दोसी ठेरायो, काहाकाय ता माय यीशु जुलूम चोमेत्कारान काम किरेल इतो, तीबी ता हेयरावाला माणहे तान मोन पापाम रेन नाह बोदलेल एता। <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />यीशु केयो, “हाय, खुराजीन! हाय, बेतसेदा! जो ताकेतीन काम तार माय ईयेल एता, केदी ता सुर एने सेदा माय केराय जाता, ते तावाला माणहे गोंटा फांगरीन एने रोखड़ा पोर बोहीन केवीह ने पापाम रेन मोन बोदेल लेता। <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />तानकेरता मी तुमूह केथु काय नियाव ने दिह तुमरी देशाह रेन सुर एने सेदान माणहान देशा जादा वेठाय ओहली रेय। <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />एने एय कफरनहूम, काय तु हेरोग वोर उचो केराय जाहे? तु ते आंदारकेली वोर नेचो जाहे! जा चोमेत्कारान काम तार माय किरेल एता, केदी सदोम माय केराय जाता, ते तो आज वोर बोणीन रेतो!<note caller="+" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="ISA 14:1-15">यशाया 14:1-15</ref>; <ref loc="GEN 19:24-28">उत्पत्ती 19:24-28</ref></char></note> <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />पुण मी तुवाह केथु काय नियाव ने दिह तारी देशाह रेन सदोम ने देशा जादा वेठाय ओहली रेय!”<note caller="+" style="x"><char style="xo" closed="false">11:24 </char><char style="xt" closed="false"><ref loc="MAT 10:15">मत्ती 10:15</ref>; <ref loc="LUK 10:12">लुका 10:12</ref></char></note><verse eid="MAT 11:24" /></para>
  <para style="s">वोजाम दाबायेल माणहाह आराम</para>
  <para style="r">(<ref loc="LUK 10:21-22">लुका 10:21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />तुलबूखे यीशु केयो, “एय आबा, हेरोग एने देरतीन मालीक! मी तारो दन्यवाद केरथु काय तु ज्यी वातुह इकेल एने सोमेज वालाह रेन लीकाड़ मिल्योह, पुण सोराह देखाड़ेल हे। <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />होव, एय आबा, काहाकाय तुवाह ज्योस हाजो लागो।<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />
    <note caller="+" style="x">
      <char style="xo" closed="false">11:27 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 3:35">योहान 3:35</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="JHN 1:18">योहान 1:18</ref>; <ref loc="JHN 10:15">10:15</ref></char>
    </note>“मारो आबोख माहु आखोच होप दियेल हे, एने कुणीच नाह जाणेत काय बिटोख कुण हे, आबोख उलोस जाणेह, एने आबोख कुण हे ज्य बी कुण नाह जाणेत, पुण बिटोख उलोस जाह देखाड़ेल हे, तोच जाणेह।”<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />“एय आखा काम केरनारे, एने वोजा माय दाबायेल माहणे तुमू आखा मार फाय आवो, मी तुमूह आराम आपुह। <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />मारो जुवालो तुमरे उपेर विस लिवो, एने माहु फाय रेन हिको, काहाकाय मी किववालो एने मोना माय गेरीब हे; एने तुमू तुमरा मोना माय आराम किरहो।<note caller="+" style="x"><char style="xo" closed="false">11:29 </char><char style="xt" closed="false"><ref loc="JER 6:16">यिर्मया 6:16</ref></char></note> <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />काहाकाय मारो जुवालो होपो, एने मारो वोजो ओलवो हे।”<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">आरामान दिह्यान बाराम सावाल</para>
  <para style="r">(<ref loc="MRK 2:23-28">मरकुस 2:23-28</ref>; <ref loc="LUK 6:1-5">लुका 6:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />ती टेम माय यीशु विहेवणेन दिह खेता माय लागतो जातालो। तेवी तान चेलाह जुलूम बुख लागेल एती, केरीन ता उब्या तोड़ीन खाणे बाज गीया।<note caller="+" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="DEU 23:25">व्यवस्था 23:25</ref></char></note> <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />पुण फरिसी चेलाह उब्या खाताला देखीन यीशुह केया, “देख, तारा चेला तो काम केरने बाजरेनाह जो आरामान दिह केरने हाजो नाह सोतो!”<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />ज्य होमलीन यीशु ताह जापाप आप्यो, “तुमू ज्य नाह वाशा काय जेवी दाऊदाह एने तान हातीह बुख लागेल, तेवी ता काय किरेल?<note caller="+" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1 शमुएल 21:1-6</ref></char></note> <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />ता किहीक बोगवानान गेरा माय जाईन बेट चेड़ायेल रूटो खायेल, जाह खाणे दाऊदाह एने तान हातीन केरता हाजो नाह एतो, पुण निस्तो चाकर्‍यान केरता ओलोस हाजो एतो।<note caller="+" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="LEV 24:9">लेव्यवस्था 24:9</ref></char></note> <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />काय तुमू कायदा माय ज्य नाह वाशा काय मोंदिर माय सेवा केरनार चाकर्‍यो विहेवणेन दिह मुसान नेमाह तोड़ने, तीबी तो निर्दोस गेणाणे?<note caller="+" style="x"><char style="xo" closed="false">12:5 </char><char style="xt" closed="false"><ref loc="NAM 2:8-10">नहुम 2:8-10</ref></char></note> <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />पुण मी तुमूह केथु काय ज्यो तो हे जो मोंदिराह रेन बी मोठो हे। <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" /><note caller="+" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="MAT 9:13">मत्ती 9:13</ref></char></note>केदी तुमू ज्यान मतलब जाणता, ‘मी गीण पोर खुस एणे, बेट चेड़ायेल बोली पोर नाह,’ ते तुमू विण निर्दोस पोर गुनो नाय लागाड़ता; <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />काहाकाय मी माणहान बिटोख विहेवणेन दिह्यान बी मालीक हे।”<verse eid="MAT 12:8" /></para>
  <para style="s">यीशु आथ पांगला माणहाह हुदारने</para>
  <para style="r">(<ref loc="MRK 3:1-6">मरकुस 3:1-6</ref>; <ref loc="LUK 6:6-11">लुका 6:6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />ता रेन यीशु एने तान चेला यहुदिन बोक्ती केरन्या गेरा माय आवा। <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />ताहरी एक माणुह एतो जान एक आथ पांगलो इतो, एने ता माणहे यीशु पोर गुनो लागाड़नेन केरता ताह फुशा, “काय विहेवणेन दिह हुदारने हाजो हे?”<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:11 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 14:5">लुका 14:5</ref>
      </char>
    </note>यीशु ताह जापाप आप्यो, “तुमरे माय रेन ओहलो कुण हे जान एकुस मेंड्रो हे, एने तो विहेवणेन दिह खाडा माय पोड़ जाय? ते ताह तो खाडा माय रेन देरीन बाहेर नाय काड़ी? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />ते माणहान किमोत मेंड्राह रेन! कोलीक वोदार हे, तानकेरता विहेवणेन दिह बोलो केरने हाजो हे।” <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />तेवी यीशु ता माणहाह केयो, “तार आथ ओंगाण किर।”</para>
  <para style="p" vid="MAT 12:13">तो माणुह आथ ओंगाण केऱ्यो, एने तान आथ दिहरा आथान गेत हुदरी गीयो। <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />तेवी फरिसी बाहेर जाईन यीशुन विरोद माय होमच्‍यो केऱ्या काय ताह किहीक खेतेम केरहु।<verse eid="MAT 12:14" /></para>
  <para style="s">बोगवानान निवाड़ेल पावोर</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />जेवी यीशु ज्य जाणीन ता रेन जात रिनो; एने जुलूम माणहे तान पासाण चाल पोड़ना। एने यीशु ता सोबाह हुदार दिनो, <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />एने यीशु ता सोबाह सोमजाड्यो काय मार बाराम दिहरा माणहाह मा किहो। <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />काहाकाय तो वचन पुरो एय जो यशाया जाणकारान द्‍वारे केवायेल एतो:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />“ज्यो मारो सेवक हे, जाह मी निवाड़ेल हे,<note caller="+" style="x"><char style="xo" closed="false">12:18 </char><char style="xt" closed="false"><ref loc="ISA 42:1-4">यशाया 42:1-4</ref></char></note></para>
  <para style="q2" vid="MAT 12:18">एने ज्यो मारो मोंगाल्लो हे, ज्या पोर मी जुलूम खुस हे।</para>
  <para style="q1" vid="MAT 12:18">मी ज्याह मार जीव आपुह,</para>
  <para style="q2" vid="MAT 12:18">एने ज्यो दिहरी जातीन माणहाह नियाव ने खुबेर देय।<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />तो राड़ जीगड़ो नाय केरी, एने जोरेस आयड़ीन बासेण नाय देय,</para>
  <para style="q2" vid="MAT 12:19">एने आटा माय कुण तान बोल नाय होमली।<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />तो चिह लायेल होटाह नाय तोड़ी,</para>
  <para style="q2" vid="MAT 12:20">एने दुवाण्यी चिमणीह नाय ओलाड़ी।</para>
  <para style="q1" vid="MAT 12:20">जाह वोर तो नियावाह जिकाड़ी नाय,<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />एने आखा देसान माणहे तान नावा माय आसा केरती।”<verse eid="MAT 12:21" /></para>
  <para style="s">यीशु एने बालजबुल</para>
  <para style="r">(<ref loc="MRK 3:20-30">मरकुस 3:20-30</ref>; <ref loc="LUK 11:14-23">लुका 11:14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />तेवी थोड़ाक माणहे एक आंदलो एने मुको एतो ता माणहाह यीशु फाय लावा। ता माणहा माय खाराब जीव एतो, केरीन तो बोल नाह सेकतालो, यीशु ताह हुदार दिनो, एने तो बोलने एने देखणे बाज गीयो। <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />ज्य देखीन आखा माणहे बोंगलायीन केणे बाज गीया, “काय ज्यो दाऊदान सोरो हे।”<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:24 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 9:34">मत्ती 9:34</ref>; <ref loc="MAT 10:25">10:25</ref></char>
    </note>पुण फरिसी ज्य होमलीन केया, “ज्यो ते बुतड़ान आदिकारी बालजबुल ने मोदेक लेन बुतड़ाह काड़ेह।”<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />यीशु तान मोनान वात जाणीन ताह केयो, “जा राज ने माणहा माय फुट पोड़ जाथे, ता राज ने माणहे उजेड़ जाती। एने जा बी हेयरान एने गेराणान माणहा माय फुट पोड़ जाथे, ता किहीक एकठा रेय सेकती। <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />केदी सैतानुच सैतानाह काड़ीह, ताहार तान राज माय फुट पोड़ जायेल हे। ओवतो तान राज किहीक बोणीन रेय। <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />केदी मी बालजबुल ने मोदेक लेन बुतड़ाह काड़थु, ताहार तुमरा वोस कुणीन मोदेक लेन बुतड़ाह काड़तेह? तानकेरता तुमरो नियाव तास केरती। <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />एने केदी मी बोगवानान जीवान मोदेक लेन बुतड़ाह काड़थु, ताहार बोगवानान राज तुमरे आहने आव लागेल हे।<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />“एने काल्लो बी माणुह एगदा तेगड़ा माणहान गेराम रिगीन तान माल नाह लुट सिकेत, पुण पेल ता तेगड़ा माणहाह बांद देय; ओवतो तो तान गेराह लुट लेय।<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:30 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 9:40">मरकुस 9:40</ref>
      </char>
    </note>“जो मार हेऱ्यो नाह सोतो तो मार विरोद माय हे; एने जो मार हेऱ्यो टुलो नाह किरेत, तो फाकरी दिथे। <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" /><note caller="+" style="f"><char style="fr" closed="false">12:31 </char><char style="ft" closed="false">ज्या जो केतेह तो खाराब वात हे</char></note>तानकेरता मी तुमूह केथु काय माणहान आखा बातीन पाप एने चिहटा माफ एय जाती; पुण चोखाला जीवान चिहटान एने पाप केदी बी माफ नाय एती। <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" /><note caller="+" style="x"><char style="xo" closed="false">12:32 </char><char style="xt" closed="false"><ref loc="LUK 12:10">लुका 12:10</ref></char></note>जो कुण माणहान बेटाख ने विरोद माय काह वातु केय तान गुना माफ एय जाती; पुण जो कुण चोखाला जीवान विरोद माय काह केय, तान गुना नाह ज्यी केली माय माफ एती, नाह ते ती केली माय माफ केराय जाती।<verse eid="MAT 12:32" /></para>
  <para style="s">जोहलो जाड़ तोहलो फोल</para>
  <para style="r">(<ref loc="LUK 6:43-45">लुका 6:43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:33 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:20">मत्ती 7:20</ref>; <ref loc="LUK 6:44">लुका 6:44</ref></char>
    </note>“केदी जाड़ हाजो हे, ते तान फोल बी हाजो रेय; पुण केदी जाड़ खाराब रेय, ते तान फोल बी खाराब रेय, काहाकाय जाड़ तान फोला केरीच ने ओलखाय जाणे। <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" /><note caller="+" style="x"><char style="xo" closed="false">12:34 </char><char style="xt" closed="false"><ref loc="MAT 3:7">मत्ती 3:7</ref>; <ref loc="MAT 23:33">23:33</ref>; <ref loc="LUK 3:7">लुका 3:7</ref>; </char><char style="xt" closed="false"><ref loc="MAT 15:18">मत्ती 15:18</ref>; <ref loc="LUK 6:45">लुका 6:45</ref></char></note>एय गेड़हान पिला तुमू खाराब एन बी हाजी वातु किहीक केय सेकतेह? काहाकाय जो मोना माय बोरायेल हे तोच मुया माय आवेह। <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />हाजालो माणुह मोनान मोटक्या माय रेन हाजाली वातु काड़ेह; एने खाराब माणुह खाराब मोटक्या माय रेन खाराब वातु काड़ेह।<verse eid="MAT 12:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 12:36" />“एने मी तुमूह केथु जी बी खाराब वातु माणहे केती नियाव ने दिह आखी वातीन लेख्यो आपती। <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />काहाकाय तु तारी वातु माय निर्दोस एने तारी वातुन केरता गुनेगार ठेराय जाहे।”<verse eid="MAT 12:37" /></para>
  <para style="s">हेरगान निसाणीन मांग</para>
  <para style="r">(<ref loc="MRK 8:11-12">मरकुस 8:11-12</ref>; <ref loc="LUK 11:29-32">लुका 11:29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:38 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:1">मत्ती 16:1</ref>; <ref loc="MRK 8:11">मरकुस 8:11</ref>; <ref loc="LUK 11:16">लुका 11:16</ref></char>
    </note>तेवी देरेमगुरू एने फरिसी न्या माय रेन एक जाण केयो, “एय गुरू, आमु तुवा फाय रेन एक निसाणी देखणे होद्तेह।”<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:39 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:4">मत्ती 16:4</ref>; <ref loc="MRK 8:12">मरकुस 8:12</ref></char>
    </note>यीशु तान वात होमलीन ताह जापाप आप्यो, “ज्या कालान खाराब एने खाराब विचारावाला माणहे निसाणी होद्तेह! पुण योना जाणकारान निसाणीह सोड़ीन काल्लीस निसाणी ताह नाय आपाय।” <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />जिहकेरीन योना तीन दिह ने तीन रात मोटला मासान पेटा माय रियेल, तिहेस केरीन तीन दिह ने तीन रात मी माणहान बिटोख देरती माय रेह।<note caller="+" style="x"><char style="xo" closed="false">12:40 </char><char style="xt" closed="false"><ref loc="MAT 16:4">मत्ती 16:4</ref>; <ref loc="MRK 8:12">मरकुस 8:12</ref></char></note> <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />निनवेन माणहे नियाव ने दिह ज्या कालान माणहा हेऱ्या उठीन ताह गुनेगार ठेरावती, काहाकाय ता योनान पारचार होमलीन मोन फिरायेल एता; एने न्या तो हे जो योनाह रेन बी मुटलो हे!<note caller="+" style="x"><char style="xo" closed="false">12:41 </char><char style="xt" closed="false"><ref loc="JON 1:17">योना 1:17</ref></char></note> <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />नियाव ने दिह दक्शिण देसान राणी, ज्या कालान माणहा हेऱ्यी उठीन ताह गुनेगार ठेरावी, काहाकाय ती सुलेमान राजान एकलीन वातु होमेलनेन केरता देरतीन दिहरे कुपरे रेन आयेल एती; एने न्या तो हे जो सुलेमानाह रेन बी मुटलो हे!<note caller="+" style="x"><char style="xo" closed="false">12:42 </char><char style="xt" closed="false"><ref loc="1KI 10:1-10">1 राजा 10:1-10</ref>; <ref loc="2CH 9:1-12">2 इतिहास 9:1-12</ref></char></note><verse eid="MAT 12:42" /></para>
  <para style="s">खाराब जीवान पोशो आवणे</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />“जेवी खाराब जीव माणहा माय रेन निकेल जाथे, ते हुकेल जागा माय आराम होदते फिरने। पुण ताह नाह सापड़ने, <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />तेवी तो केणे, ‘मी जा गेरा माय रेन निकलेल एतो ताच मार गेरा माय जात रेह।’ एने फिरीन ताह रिकामो, बारेल एने हिंगारेल दिखेह। <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />तेवी तो जाईन ताह रेन बी जादा खाराब हात जीवाह लेन आवेह, एने ता माय रिगीन ता रेणे बाज जातेह, एने ता माणहान वेला पेल रेन बी जादा खाराब एय जाथे। ज्या कालान खाराब माणहान वेला बी ओहलीस एय।”<verse eid="MAT 12:45" /></para>
  <para style="s">यीशुन आहख एने बाहख</para>
  <para style="r">(<ref loc="MRK 3:31-35">मरकुस 3:31-35</ref>; <ref loc="LUK 8:19-21">लुका 8:19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />जेवी यीशु माणहा हिऱ्यो वातु केरतालोस तोलाक माय तान आहख एने बाहख बाहेर उबरियेल एता, ता यीशु हेऱ्या वातु केरने होदताला। <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" /><note caller="+" style="f"><char style="fr" closed="false">12:47 </char><char style="ft" closed="false">थोड़ाक लेख माय ज्यो वचन नाह लिखेल सोतो</char></note>तेवी एक जाण यीशुह केयो, “देख, तारी आहख एने तार बाहख बाहेर उब रेनाह, एने तुवा हेऱ्या वातु केरने होद्तेह।”<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />यीशु ताह जापाप आप्यो, “कुण हे मार आहख? एने कुण हे मार बाहख?” <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />यीशु तान चेलान उगे आथ देखाड़ीन केयो, “दिखो! मारी आहख एने मार बाहख ज्या हेते! <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />काहाकाय जो कुण मार हेरगावाला आबाख ने मोरजी पोर चाली, तोस मार बाहख, एने मार बोणीख, एने मारी आहख हे।”<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">बिज पेरनारान किस्सो</para>
  <para style="r">(<ref loc="MRK 4:1-9">मरकुस 4:1-9</ref>; <ref loc="LUK 8:4-8">लुका 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />ते दिहच यीशु ता गेराम रेन निकलीन देरीयान दिड़े जाईन बोह गीयो। <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" /><note caller="+" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="LUK 5:1-3">लुका 5:1-3</ref></char></note>एने ता हेरी माणहान होवटाली गेरदी टोलवाय गियी, तानकेरता यीशु डोंडह्या पोर चेड़ीन बोह गीयो, एने आखी बिड़ मीरे उबरियेल एती। <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />ओवतो तो ताह किस्सा माय जुलूम वातु केयो, “एक पेरनार पेरने निकेलनो। <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />पेरने बुखेत थोड़ाक दाणा वाटीन दिड़े पोड़ना, ताह चीड़ा आवीन खाय गीया। <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />थोड़ाक दाणा सापराट्या जागा माय पोड़ना, एने ताहरी ताह होवटो माटड्यो नाह जुड़नो, तानकेरीन जेल्दी उग गीया। <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />पुण दिह उगनो एने ता पोर दोप लागो एने ता बुजाय गीया, एने मुले नाह गाड़ाना ता माय ता हुक गीया। <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />थोड़ाक दाणा काटाल्या जुरखील्या माय पोड़ना, एने जुरखील्या वोदीन ताह दाब देना। <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />पुण थोड़ाक दाणा हाजाली बुई माय पोड़ना, एने फोल लावा, काल्लाह होव मोण, काल्लाह साठ मोण, काल्लाह तीस मोण ओहलो फोल आवा,” <figure style="fig" alt="Jesus teaching the crowd by the sea" file="lb00299c.tif" size="span" copy="Horace Knowles ©" ref="13:2">देरीया माय डोंडह्या माय चेड़ीन गेरदीह हिक आपणे</figure><verse eid="MAT 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 13:9" />यीशु केयो, “हुमलो, जान कान एय, ता होमली लेय।”<verse eid="MAT 13:9" /></para>
  <para style="s">किस्सान कारेण</para>
  <para style="r">(<ref loc="MRK 4:10-12">मरकुस 4:10-12</ref>; <ref loc="LUK 8:9-10">लुका 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />ओवता यीशुन चेला आहने आवीन ताह केया, “तु माणहा हिऱ्यो किस्सा माय काहा वातु किरेह?”<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />यीशु ताह जापाप आप्यो, “तुमूह हेरगान राज ने मालमात ने सोमेज आप दियेल हे, पुण ओयाह नाह। <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" /><note caller="+" style="x"><char style="xo" closed="false">13:12 </char><char style="xt" closed="false"><ref loc="MAT 25:29">मत्ती 25:29</ref>; <ref loc="MRK 4:25">मरकुस 4:25</ref>; <ref loc="LUK 8:18">लुका 8:18</ref>; <ref loc="LUK 19:26">19:26</ref></char></note>काहाकाय जा फाय हे ताह उंजु आपाय जाय, एने ता फाय होवटो एय जाय, पुण जा फाय कायच नाय मीले, ता फाय जो बी एय, तो मांगाय जाय। <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />मी ता हिऱ्यो किस्सा माय ज्यानकेरता वातु केरथु काय ता देखते लेन बी नाह देखते, एने होमलीन बी नाह होमेलते, एने नाह सोमेजते। <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />न्यान बाराम यशायान जाणाव पुरी ईथे:<note caller="+" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">यशाया 6:9-10</ref></char></note></para>
  <para style="q1" vid="MAT 13:14">“तुमू काना केरीन होमेलहो, पुण सोमेजहो नाय;</para>
  <para style="q2" vid="MAT 13:14">एने डोला केरीन दिखहो, पुण तुमूह जाणाय नाय,<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />काहाकाय न्या माणहान मोन वातड़ा एय जायेल हेते,</para>
  <para style="q2" vid="MAT 13:15">एने न्यान कान बेयरा एय जायेल हेते</para>
  <para style="q2" vid="MAT 13:15">एने न्या डोलाह बोंद केर लियेल हेते,</para>
  <para style="q1" vid="MAT 13:15">एने ओहलो नाय एय काय न्या डोला केरीन देखती,</para>
  <para style="q2" vid="MAT 13:15">एने काना केरीन होमेलती,</para>
  <para style="q2" vid="MAT 13:15">एने मोना माय सोमेज जाती,</para>
  <para style="q1" vid="MAT 13:15">एने न्या वोलीन बोगवानान उगे आवती,</para>
  <para style="q2" vid="MAT 13:15">एने मी न्याह बेमारी माय रेन हुदार देह।”<verse eid="MAT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />
    <note caller="+" style="x">
      <char style="xo" closed="false">13:16 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:23">लुका 10:23</ref>,<ref loc="LUK 10:24">24</ref></char>
    </note>“पुण तुमू बोरकेतवाला हेते, काहाकाय तुमरा डोला देखतेह एने कान होमेलतेह। <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />काहाकाय मी तुमूह खेरीच केथु काय जुलूम बोगवानान जाणकार एने देरमी माणहे ज्य होदताला काय जी वात तुमू देखतेह, देखी, पुण नाह देख्या, एने जी वात तुमू होमेलतेह, होमलेल, पुण नाह होमल्या।<verse eid="MAT 13:17" /></para>
  <para style="s">बिज पेरनारान किस्सान व्याख्या</para>
  <para style="r">(<ref loc="MRK 4:13-20">मरकुस 4:13-20</ref>; <ref loc="LUK 8:11-15">लुका 8:11-15</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />“एवी तुमू पेरनारान किस्सान मतलब हुमलो। <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />थोड़ाक माणहे वाटीन दिड़े पुड़ेल ता दाणान गेत हेते, जा बोगवानान राज ने वचन ते होमेलतेह, पुण वचन होमलीन बी नाह सोमेजते, काहाकाय तान मोना माय जो काय पेरायेल एतो। ता फाय रेन सैतान आवीन सांडाड़ ली जाथे। ज्या तास हेते जा वाटीन मीरे पेरायेल एता। <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />एने थोड़ाक माणहे सापराट्या जागाम पुड़ेल दाणान गेत हेते, जा बोगवानान वचन होमलीन चालोच खुस एन मान लेतेह। <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />पुण वचनान केरता तान जीवा माय दुख, तेकलीत, सेताव आवेह, ओवता चालोच ठोकेर खातेह, काहाकाय बोगवानान वचनाह हास केरीन मोना माय नाह देऱ्या, तानकेरीन ता थोड़ाच दिह्यान केरता रेतेह। <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />थोड़ाक माणहे जुरखील्या माय पेरायेल दाणान गेत हेते, ता वचन होमेलतेह ते खोरा; पुण दुनिया दारीन चिन्ता एने मालदेनान दुको वचनाह दाब दिथे, एने तो विणफोल्यो रेय जाथे। <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />थोड़ाक माणहे हाजाली बुई माय पेरायेल ने गेत हेते, जा वचनाह होमलीन मानतेह एने फोल लावतेह, काल्ला होव मोण, काल्ला साठ मोण, एने काल्ला तीस मोण।”<verse eid="MAT 13:23" /></para>
  <para style="s">जेंगली बिजान किस्सो</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />यीशु ताह उंजु एक किस्सो केयो: “हेरगान राज ता माणहान गेत हे, जो तान खेताम हाजालो बियारो पेरेह। <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />पुण राती आखा माणहे हुव जातेह, ते तान दुसमोन खेताम आवीन जेंगली दाणा पेर दिथे। <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />जेवी हुका निकेलना एने केणहे लागा, तेवी जेंगली दाणान टोटाला बी वोदीन देखाना। <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />ता खेतान मालक्याह तान पावोर आवीन केया, ‘मालीक, काय तु तार खेता माय हाजाला दाणा नाह पेरेल इतो? ते जेंगली दाणान टोटाला कारीन आवा?’ <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />मालीक ताह केयो, ‘ज्य एगदा दुसमोनान काम हे,’ ता जापाप आप्या, ‘काय तारी मोरजी हे काय आमु जाईन ता टोटालाह उखाल दिज्यो।’ <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />मालीक ताह जापाप आप्यो, ‘मा,’ ओहलो नाय एय काय जेंगली दाणान टोटाला हेऱ्या, तुमू गोवान टोटालाह उखाल दिहो। <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />काटणेन टेम वोर दुयूह एकठास वोदणे दिवो। एने गोव काटणारे मोंजऱ्याह किज्यो, काय पेल जेंगली दाणान टोटालाह हेलगाड़नेन केरता उखालीन पुला बांद लिवो, एने गोवान दाणाह मार मोटक्याम टुलो किरो।”<verse eid="MAT 13:30" /></para>
  <para style="s">राईन बिजान किस्सो</para>
  <para style="r">(<ref loc="MRK 4:30-32">मरकुस 4:30-32</ref>; <ref loc="LUK 13:18-19">लुका 13:18-19</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />यीशु ताह उंजु एक किस्सो केयो, “हेरगान राज राईन दाणान गेत हे, एक माणुह ता दाणाह ली जाईन तान खेताम पेरेह। <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />राईन दाणो आखा बिजाह रेन आत्यो ते रेणे, पुण जेवी वोदणे। तेवी सोब बाजी पालाह रेन ओहलो मोठो जाड़ पोहाणे, काय चीड़ा बी पांजरो बाणावीन रेतेह।”<verse eid="MAT 13:32" /></para>
  <para style="s">खमीर ने किस्सो</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />यीशु ताह उंजु एक किस्सो केयो, “हेरगान राज खमीरान गेत हे, ताह एक बायकु लेन चालीह पायलान फिटा माय बेचकी देनी, तेवी आखो फिट खमीर बोण गीयो।”<verse eid="MAT 13:33" /></para>
  <para style="s">यीशु किस्सान वापेर केरने</para>
  <para style="r">(<ref loc="MRK 4:33-34">मरकुस 4:33-34</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />जी आखी वातु यीशु किस्सा माय माणहाह हिकाड़तालो, एने बिगेर किस्सान यीशु ताह कायच नाह केतालो। <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />काय जो वचन जाणकारे कियेल एता:<note caller="+" style="x"><char style="xo" closed="false">13:35 </char><char style="xt" closed="false"><ref loc="PSA 78:2">बजन 78:2</ref></char></note></para>
  <para style="q1" vid="MAT 13:35">“मी किस्सान द्‍वारे मार वात सोमजाडुह;</para>
  <para style="q2" vid="MAT 13:35">उंजु केल बाणायेल तुलबूखेन लिकायेल वातु मी उगाडुह।”<verse eid="MAT 13:35" /></para>
  <para style="s">जेंगली बिजान किस्सान व्याख्या</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />तान पासाण यीशु माणहान गेरदीह सोड़ीन गेराम गीयो, तेवी तान चेला आहने आवीन केया, “जेंगली दाणान किस्सान मतलब आमुह सोमजाड़ दे।”<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />यीशु ताह जापाप आप्यो, “हाजाला दाणा पेरनार मी माणहान बिटोख हे; <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />देरती खेत हे, हाजाला दाणा बोगवानान राज ने सोरा हेते, एने जेंगली दाणा सैतानान सोरा हेते; <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />एने जेंगली दाणा पेरनार सैतान हे, काटणे बुखेत ज्यी देरतीन सेवल्यो दिह हे, उंजु काटणारे हेरोगदुत हेते। <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />जिहकेरीन जेंगली दाणाह उखालीन हेलगाड़ देणु, तिहेस केरीन ज्यी देरतीन सेवल्यो दिह बी रेय: <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />मी माणहान बिटोख मार हेरोगदुताह मोकलुह, ता मार राज माय आखा खाराब काम केरनाराह, एने दिहराह पाप केरनाराह एकठा केरती, <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />ओवता ताह बाहेर निकालीन देदेकताली आक्‍ठीन बाठी माय टाक देती, ताहरी रेड़नो एने दात केकड़ावणो रेय। <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />तुलबूखे देरमी माणहे बोगवानान राज माय दिह्यान गेत चोमेकती। जान कान एय, ता होमली लेय।”<verse eid="MAT 13:43" /></para>
  <para style="s">लिकायेल खेजानान किस्सो</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />हेरगान राज खेता माय लिकायेल खेजानान गेत हे। एक माणुह ता खेजानाह देखीन लिकाड़ दिनो। तेवी तो खुस एन तान आखो मालदेन वेच देनो, एने ता खेताह वेचातो लेय लेदो।<verse eid="MAT 13:44" /></para>
  <para style="s">मोंगाला हिरामोतीन किस्सो</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />हेरगान राज, हिरामोतीह होदणारा एक वेपारीन गेत हे। <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />जेवी ताह एक मोंगालो हिरामोती जुड़नो, ते तो गेर जाईन तान आखो मालदेन वेचीन ता खेताह वेचातो लेय लेदो।<verse eid="MAT 13:46" /></para>
  <para style="s">मासा देरनारान जालान किस्सो</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />ओवतो हेरगान राज मासा देरनारा जालान गेत हे। ताह देरीया माय टाकणु, एने जाल आखी बातीन मासाह ली आवेह। <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />एने जेवी जाल बोराय जाणे, ते मासऱ्या जालाह खेचीन बाहेर काड़ लेणु, एने ता बोहीन हाजाला मासाह निवाड़ेन ठामला माय टुलो केऱ्या, पुण खाराब मासाह जुगार देना। <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />ज्यी देरतीन सेवल्या दिह्याम ओहलोस एय; एने हेरोगदुत आवीन पापी माणहाम रेन देरमी माणहाह आंगे केरती <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />एने हेरोगदुत पापी माणहाह नेरगान आक्‍ठीन बाठी माय टाक देती, ताहरी ता रेड़ती, एने दात केकड़ावती।<verse eid="MAT 13:50" /></para>
  <para style="s">जुनाली एने नोवाली हिक</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />यीशु तान चेलाह फुशो, “काय तुमू ज्यी आखी वात सोमेजना?” ता केया, “होव।”<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />तेवी यीशु ताह केयो, “जिहकेरीन एक मालीक तान मोटक्याम रेन नोवाली एने जुनाली वोस्तु बाहेर काड़ दिथे, तिहेस केरीन देरेमगुरू न्या बोगवानान राज ने खेरायीन बाराम जाणतेह।”<verse eid="MAT 13:52" /></para>
  <para style="s">नासरत गावा माय यीशुन अपमान</para>
  <para style="r">(<ref loc="MRK 6:1-6">मरकुस 6:1-6</ref>; <ref loc="LUK 4:16-30">लुका 4:16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />जेवी यीशु ज्या आखा किस्सा हिकाड़ीन तारेन जात रिनो, <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />एने तान गावाम आवो, एने यहुदिन बोक्ती केरन्या गेराम जाईन ओहलो हिकाड्यो, काय आखा माणहे बोंगलायीन एका दिहराह केया, “ज्याह ज्यी ताकेत एने इकेल कारीन जुड़ेल हे? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />काय ज्यो पोला हुतारान सोरो नाह सोतो? एने ज्यान आईख ने नाव मरीयम, एने याकुब, युसूफ, शमोन एने यहुदा ज्यान बाहख नाह सोता? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />एने ज्यान बोणह्युक आपणी न्या नाह रेत्यु काय? तीबी ज्याह ओली मोठी इकेल एने ताकेत कारीन जुड़ेल हे?” <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" /><note caller="+" style="x"><char style="xo" closed="false">13:57 </char><char style="xt" closed="false"><ref loc="JHN 4:44">योहान 4:44</ref></char></note>ओहलो विचार केरीन ता यीशु पोर बुरहो नाह केऱ्या।</para>
  <para style="p" vid="MAT 13:57">पुण यीशु ताह केयो, “जाणकाराह तान गेराह एने गावाह सोड़ीन आखी जागे मान सम्मान जुड़ने।” <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />यीशु ताहरी होवटा चोमेत्कार ने काम नाह किऱ्यो, काहाकाय तान गावान माणहे ता पोर बुरहो नाह केऱ्या।<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">योहान बपतीस्मा केरनारान खुन</para>
  <para style="r">(<ref loc="MRK 6:14-29">मरकुस 6:14-29</ref>; <ref loc="MRK 9:7-9">9:7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />ता दिह्या माय गेलील देसान राजा हेरोदेस यीशुन बाराम होमल्यो, <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />एने तान पावराह केयो, “ज्यो खेरीच बपतीस्मा केरनार योहान हे, तो मुरेल माय रेन जीव उठेल हे, तानकेरता ताकेत ने काम तान द्‍वारे एतेह।”<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">14:3 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 3:19">लुका 3:19</ref>,<ref loc="LUK 3:20">20</ref></char>
    </note>काहाकाय हेरोदेस राजा तान बाहख फिलीपुस ने बायकु हेरोदियास ने वोजेसे, योहानाह बांदिन जेली माय कोंडाड़ दियेल इतो। <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />काहाकाय योहान ताह कियेल इतो, “ज्यीह राखणे तार केरता हाजो नाह सोतो!”<note caller="+" style="x"><char style="xo" closed="false">14:4 </char><char style="xt" closed="false"><ref loc="LEV 18:16">लेव्यवस्था 18:16</ref>; <ref loc="LEV 20:21">20:21</ref></char></note> <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />तानकेरता हेरोदेस राजा ताह मारनेन होदतालो, पुण यहुदि माणहाह बितालो, काहाकाय ता माणहे योहानाह जाणकार मानताला।<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />पुण जेवी हेरोदेस राजान जेल्मो दिह आवो, तेवी हेरोदियास ने सोरी माय नाच देखाड़ीन हेरोदेसाह खुस केरी। <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />तेवी राजा सुगोण खाईन तीह केयो, “जो काय तु माहु फाय मांगहे मी तो तुवाह आपु!”<verse eid="MAT 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 14:8" />तीन आहख तीह कियेल केरीन ती केयी, “योहान बपतीस्मा केरनारान मुंड काटाड़ीन एक पाराती माय मेलीन मार केरता मांगाड़ दे!”<verse eid="MAT 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 14:9" />राजा ज्य होमलीन जुलूम नाराज एय गीयो, पुण ता हेऱ्या बोह रियेल पावणान ओंगाण सुगोण खायेल इतो, तानकेरता तीन वात मान लिदो। <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />एने राजा सिपायड़ाह उकुम आप्यो काय योहानान मुंड काटीन तीह लावीन आप दिवो। <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />एने योहानान मुंड काटीन पाराती माय मेलीन लावो, एने सोरीह आप दिनो, एने सोरी तीन आईख आप देनी। <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />तेवी योहानान चेला आवीन देड़ाह ली जाईन बुज देना, एने ता यीशु फाय जाईन खुबेर आप्या।<verse eid="MAT 14:12" /></para>
  <para style="s">पाच एजार माणहाह खावड़ावणे</para>
  <para style="r">(<ref loc="MRK 6:30-44">मरकुस 6:30-44</ref>; <ref loc="LUK 9:10-17">लुका 9:10-17</ref>; <ref loc="JHN 6:1-14">योहान 6:1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />जेवी यीशु योहानान मोतीन बाराम होमल्यो, ते डोंडह्या माय बोहीन एखालोच हुनाला जागाम जात रिनो, एने माणहे ज्य होमलीन हेयरा हेयरा रेन पायेच ता फाय गीया। <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />जेवी यीशु डोंडह्या माय रेन उतरीन दिड़े आवो, ते ता माणहे जुलूम टुलो एय रियेल दिख्यो, एने यीशु ता पोर किव किऱ्यो एने तान बेमारीह हुदार दिनो।<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />जेवी हांज एनी ते चेला यीशुन आहने आवीन केया, “ज्यो हुनालो जागो हे, एने दिह जुलूम डेल जायेल हे। न्या माणहाह मुकेल दे, काय ता गावा माय जाईन तान केरता खाणो वेचातो लेती।”<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />पुण यीशु ताह जापाप आप्यो, “न्याह जाणेन जोरवुत नाह सोती, तुमूच न्याह खाणेन आपो।”<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />चेला ताह केया, “न्या आमु फाय पाच रोटा एने दुय मासाह सोड़ीन दिहरो कायच नाह सोतो।”<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />यीशु ताह केयो, “ताह मार फाय लावो।” <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />तेवी यीशु माणहाह खेड़ा पोर बोहणेन उकुम आप्यो; एने ता पाच रोटाह एने दुय मासाह लिदो एने हेरगान उगे देखीन बोगवानान दन्यवाद किऱ्यो। एने रोटा मुड़ मुड़ीन चेलाह आप्यो, एने चेला माणहाह आप्या। <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />जेवी आखा माणहे खाईन आफरी गीया। तेवी चेला वोचेल रोटान टुकड़ा बारा टोपला बोरीन विशा। <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />एने रोटा खाणारे बायकु एने सोराह सोड़ीन पाच एजार एदमीच एता।<verse eid="MAT 14:21" /></para>
  <para style="s">यीशु पाण्या पोर चालने</para>
  <para style="r">(<ref loc="MRK 6:45-52">मरकुस 6:45-52</ref>; <ref loc="JHN 6:15-21">योहान 6:15-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />तेवी यीशु चालोस तान चेलाह डोंडह्या माय चेड़नेन केरता विन्ता किऱ्यो काय ताह रेन पेल ता ती पार जात रेती, जाह वोर काय तो माणहाह मोकली। <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />यीशु माणहाह मोकली देन बोयड़ा पोर विन्ता केरनेन केरता आंगेच जात रिनो, एने हांज पोर तो एखालोच इतो। <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />ती टेम डोंडह्यो देरीयान विचीम लाटा माय डोलाणे बाजरियेल एतो, काहाकाय वारो सोमोर रेन एतो।<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />एने यीशु राती तीन ते सोव वाचतान टेम माय पाण्या पोर चालतेन तान आहने आवो। <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />चेला ताह पाण्या पोर चालतालो देखीन गाबराय गीया, एने केणे बाज गीया, “ज्यो बुत हे!” एने ता आयेड़ने बाज गीया।<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />तेवी यीशु ता हिऱ्यो चालोस वातु किऱ्यो एने केयो, “ईमोत मिलो! मी हे, बिवो मा!”<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />पतरस ताह जापाप आप्यो, “एय मालीक केदी तुस हे, ते माहु तार फाय पाण्या पोर चालीन आवणेन उकुम आप।”<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />तो केयो, “आव!” तेवी पतरस डोंडह्या पोर रेन उतरीन यीशु फाय जाणेन केरता पाण्या पोर चालने बाज गीयो। <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />पुण वाराह देखीन बिय गीयो, एने जेवी पतरस बुड़ने बाज गीयो ते आयड़ीन केयो, “एय मालीक, माहु वोचाड़।”<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />यीशु चालोस तान आथ देर लिदो एने ताह केयो, “एय अविश्वासी तु काहा सेंका किऱ्यो?”<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />जेवी ता दुयू डोंडह्या पोर चेड़ गीया, तेवी वादोण वारो थोब गीयो। <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />ज्य देखीन ता जा डोंडह्‍याम एता, ताह वोंदिन केया, “खेरीच तु बोगवानान सोरो हे।”<verse eid="MAT 14:33" /></para>
  <para style="s">यीशु गन्नेसरत गावा माय दुखाऱ्या माणहाह हुदारने</para>
  <para style="r">(<ref loc="MRK 6:53-56">मरकुस 6:53-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />ओवता ता देरीयाह पार केरीन गन्नेसरत गावा माय पोचना, <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />तावाला माणहे ताह चालोस ओलखी लेदा। एने आहने पाहने आखा देसा माय खोबेर लेन मोकल्या, एने आखा दुखाऱ्या माणहाह ता फाय लावा। <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />एने ताह विन्ता केरने बाज गीया काय दुखाऱ्याह तान फाड़काह सापेलने देय; एने जोला बी माणहे तान फाड़काह सापेलताला, ता आखा हुदेर गीया।<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">डायडायान हिकवोण</para>
  <para style="r">(<ref loc="MRK 7:1-13">मरकुस 7:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />तेवी यरूशलेम हेयराम रेन थोड़ाक फरिसी एने देरेमगुरू यीशुन आहने आवीन केतेह, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“तारा चेला डायडायान रितीह काहा नाह पालते? एने बिगेर आथ दुयेल रूटो खातेह!” <figure style="fig" alt="Ceremonial washing" file="lb00280c.tif" size="col" copy="Horace Knowles ©" ref="15:2">यहुदिन आथ दोवणेन रिती</figure><verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />यीशु ताह जापाप आप्यो, “तुमू बी तुमरी रितीह मान्नेन केरता काहा बोगवानान उकुमाह टालतेह? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />काहाकाय बोगवान कियेल हे, ‘तार आबाख एने तार आईख ने मान मिलज्यो, एने जो कुण आबाख नाहते आईख खाराब केय तो माराय जाय।’<note caller="+" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="EXO 20:12">निर्गमन 20:12</ref>; <ref loc="EXO 21:17">21:17</ref>; <ref loc="DEU 5:16">व्यवस्था 5:16</ref>; <ref loc="LEV 20:9">लेव्यवस्था 20:9</ref></char></note> <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />पुण तुमू केतेह केदी एगदो तान आबाख नाहते आईख केय, ‘जो काय तुवाह माहु फाय रेन जुड़तालो, तो मी बोगवानाह बेट चेड़ाव दियेल हे,’ <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />ते तो तान आबाख ने मान नाह मेलेत।<note caller="+" style="f"><char style="fr" closed="false">15:6 </char><char style="ft" closed="false">थोड़ाक लेख माय तान आहख आबोख लिखेल हे</char></note> तानकेरीन तुमरी रितीन केरता बोगवानान वचनाह टाल देनाह। <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />एय कोपट्या! यशाया जाणकार तुमरा बाराम ज्यी जाणाव ठिक किरेल हे!<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />“न्या माणहे, ओठा केरीन ते मारो मान मेलतेह,</para>
  <para style="q2" vid="MAT 15:8">पुण न्यान मोन माहु हेऱ्यो रेन सेटो रिथे।<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />एने न्या उदडुस मार नावान बोक्ती केरतेह,</para>
  <para style="q2" vid="MAT 15:9">काहाकाय माणहान नेमाह बोगवानान नेम हे केरीन हिकाड़तेह!”<verse eid="MAT 15:9" /></para>
  <para style="s">एठी केरनार वातु</para>
  <para style="r">(<ref loc="MRK 7:14-23">मरकुस 7:14-23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />तेवी यीशु माणहाह आहने हादिन केयो, “हुमलो एने सोमजो! <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />जो मुया माय जाथे तो माणहाह एठो नाह किरेत, पुण जो मुयाम रेन निकलेह, तोच माणहाह एठो किरेह।”<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />तेवी चेला आहने आवीन केया, “तुवाह मालुम हे काय तारी ज्यी वात होमलीन फरिसी नाराज एय गीया?”<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />तो चेलाह केयो, “एकेक जाड़ जाह मार हेरगावालो आबोख नाह लागाड़ेल सोतो, ताह तु मुला बेलुच उखाल देय। <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" /><note caller="+" style="x"><char style="xo" closed="false">15:14 </char><char style="xt" closed="false"><ref loc="LUK 6:39">लुका 6:39</ref></char></note>ताह जाणे दिवो, ता आंदलाह वाट देखाड़नारे हेते; एने केदी आंदलो आंदलाह वाट देखाड़ी, ते दुयू बी खाडाम जाय पोड़ती।”<verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />ज्य होमलीन पतरस ताह केयो, “ज्यो किस्सो आमुह सोमजाड़ दे।”<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />तो चेलाह केयो, “काय तुमू बी नासमज हेते। <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />काय तुमू नाह जाणते, जो काय मुयाम रेन पेटाम जाथे, तो आगणेन द्‍वारे बाहेर निकेल जाथे। <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" /><note caller="+" style="x"><char style="xo" closed="false">15:18 </char><char style="xt" closed="false"><ref loc="MAT 12:34">मत्ती 12:34</ref></char></note>पुण जो काय माणहान मुयाम रेन निकलेह, तो मोनाम रेन निकलेह एने तोच माणहाह एठो केरने। <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />काहाकाय खाराब विचार, खुन, चोरी, सिनालो, दिहरा सिनालाम फासाड़ने, जुठो पुरावो, एने चिहटा मोना माय रेन निकेलने। <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />ज्योच हे जो माणहाह एठो केरने, पुण बिगेर आथ दुयेल रूटो खाणु तो माणहाह एठो नाह किरेत।”<verse eid="MAT 15:20" /></para>
  <para style="s">बायकुन बुरहो</para>
  <para style="r">(<ref loc="MRK 7:24-30">मरकुस 7:24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />यीशु तारीन निकलीन सुर एने सेदान देसा माय जात रिनो। <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />ता देसा माय रेणार एक कनानी जातीन बायकु रेड़तेन ता फाय आवीन आयड़ीन केयी, “एय मालीक! दाऊदान सोरा, यीशु। मार पोर किव केर, काहाकाय मार सोरीह बुतड़ो जुलूम विताड़ने बाजरिनोह।”<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />पुण यीशु तीह कायच जापाप नाह आप्यो। तेवी तान चेला आवीन ताह केया, “तीह मोकेल दे, काहाकाय ती आमरे पासाण आयेड़तेन आवणे बाजरेनीह।”<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />यीशु जापाप आप्यो, “इस्राएलान गेराणान टाकायेल मेंड्राह सोड़ीन, बोगवान माहु दिहरा कुणीस फाय नाह मोकलेल सोतो।”<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />पुण ती बायकु आवी एने यीशुह नमस्‍कार केरीन केणे बाज गियी, “एय मालीक, मारी मोदेक केर।”<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />यीशु तीह जापाप आप्यो, “सोरान रूटो चिताह आपणे हाजो नाह सोतो।”<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />ती केयी, “ज्य खेरीच हे मालीक, पुण चिता बी ते मालक्यान खाणे बुखेत टेबला पोर रेन उसटालो बुंदे पुड़ेह ते, विसीन खाणु ते खोरा।”<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />ज्य होमलीन यीशु तीह जापाप आप्यो, “एय बाय, तारो बुरहो मोटलो हे! जिहकेरीन तु हुदेह तिहेस केरीन तार केरता एय।” एने तीन सोरी चालोस हुदरी गियी।<verse eid="MAT 15:28" /></para>
  <para style="s">यीशु मोकतास दुखाऱ्या हुदारने</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />ओवतो यीशु ता रेन निकलीन गेलीलान देरीयान आहने आवो, एने एक बोयड़ा पोर चेड़ीन बोह गीयो। <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />तेवी माणहे यीशु फाय लेंगड़ाह, आंदलाह, पांगलाह मुकाह, एने दुखाऱ्या माणहाह बी लावीन यीशुन पाया हेऱ्या मेल देना, एने यीशु ता आखाह हुदार दिनो। <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />मुका बोलतेह, एने पांगला हुदेरतेह, एने लेंगड़ा चालतेह, एने आंदला देखतेह, ज्य आखो देखीन माणहे बोंगलाय गीया, एने इस्राएलान बोगवानान बोड़ाय केऱ्या।<verse eid="MAT 15:31" /></para>
  <para style="s">यीशु चार एजार माणहाह खाणो खावड़ावणे</para>
  <para style="r">(<ref loc="MRK 8:1-10">मरकुस 8:1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />तेवी यीशु तान चेलाह हादिन केयो, “माहु न्या माणहा पोर किव आवेह, काहाकाय न्या तीन दिह रेन मार हेऱ्या हेते, एने न्या फाय खाणेन केरता कायच नाह सोतो। मी न्याह बुखल्योच मोकेलने नाह होदेत, नाह ते बुखल्या न्या वाटेच लेवायीन रेय जाती।”<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />चेला ताह फुशा, “आपुह ज्या उजाड़ी माय ओला रोटा कारीन जुड़ती, काय आपु ओला होवटा माणहाह खावाडीन आफराव हु?”<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />यीशु ताह फुशो, “तुमू फाय कोलाक रोटा हेते।” ता जापाप आप्या, “हात रोटा, एने थोड़ाक आतल्या मासा बी हेते।”<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />तेवी यीशु माणहाह बुई पोर बोहणे केयो। <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />एने तो ता हात रोटा, एने मासाह आथाम लेन हेरगान उगे देखीन बोगवानान दन्यवाद केरीन मुड्यो, एने तान चेलाह आपते गीयो; एने चेला माणहाह वाट देना। <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />इहकेरीन आखा माणहे खाईन आफरी गीया, एने चेला उगरेल रोटान टुकड़ा हात टोपला बोरीन विशा। <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />खाणारे बायकुह एने सोराह सोड़ीन चार एजार एदमीच एता।<verse eid="MAT 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 15:39" />तेवी यीशु माणहाह मोकेल देन डोंडह्या पोर चेड़ीन बोह गीयो, एने मगदन देसान एद्दी माय आवो।<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">चोमेत्कारान मांग</para>
  <para style="r">(<ref loc="MRK 8:11-13">मरकुस 8:11-13</ref>; <ref loc="LUK 12:54-56">लुका 12:54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:38">मत्ती 12:38</ref>; <ref loc="LUK 11:16">लुका 11:16</ref></char>
    </note>तेवी थोड़ाक फरिसी एने सदुकी यीशु फाय आवा, एने ता पारेखणेन केरता केया, “आमुह हेरगान काल्ली बी निसाणी देखाड़।” <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />पुण तो ताह जापाप आप्यो, “हांज पोर तुमू केतेह, ‘आज मोसम हाजो रेय, काहाकाय जुग रातलो हे,’ <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" /><note caller="+" style="f"><char style="fr" closed="false">16:3 </char><char style="ft" closed="false">थोड़ाक लेख माय 2-3 वचन यीशुन सोबदा नाह लिखेल सोतो</char></note>एने वेगाच तुमू केतेह, ‘आज वादोण आवी, काहाकाय जुग रातलो एने बोरसालो एय रेनोह।’ तुमू जुगाह देखीन हवामानान आकारो केय सेकतेह, पुण ज्या टेम माय काय एणे बाजरेनोह, तान बाराम नाह जाण सेकते? <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" /><note caller="+" style="x"><char style="xo" closed="false">16:4 </char><char style="xt" closed="false"><ref loc="MAT 12:39">मत्ती 12:39</ref>; <ref loc="LUK 11:29">लुका 11:29</ref></char></note>ज्या कालान खाराब एने सिनाल्या माणहे निसाणी होद्तेह, पुण योनान निसाणीह सोड़ीन उंजु काल्लीस निसाणी ताह नाय आपाय।”</para>
  <para style="p" vid="MAT 16:4">तेवी यीशु ताह सोड़ीन जात रिनो।<verse eid="MAT 16:4" /></para>
  <para style="s">फरिसी एने सदुकीन हिकवोण</para>
  <para style="r">(<ref loc="MRK 8:14-21">मरकुस 8:14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />चेला देरीयान ती पार गीया, पुण रूटो ली जाणे विहरी गीया। <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" /><note caller="+" style="x"><char style="xo" closed="false">16:6 </char><char style="xt" closed="false"><ref loc="LUK 12:1">लुका 12:1</ref></char></note>यीशु ताह केयो, “फरिसी एने सदुकीन खमीर हारकी हिकवोण हेऱ्या रेन उशारी माय रिज्यो।”<verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />चेला आपसाम विचार केरीन एका दिहराह केया, “आपु रोटा नाह लावा ता माय ज्यो इहकेरीन किथे।”<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />यीशु ज्य जाणीन ताह केयो, “एय अविश्वासी! तुमू रूटो नाह लावा केरीन ओहलो विचार आपसा माय काहा केरतेह? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" /><note caller="+" style="x"><char style="xo" closed="false">16:9 </char><char style="xt" closed="false"><ref loc="MAT 14:17-21">मत्ती 14:17-21</ref></char></note>काय तुमू एवी वोर नाह सोमेजते? काय तुमू ता पाच एजारान पाच रोटा एर नाह सोती? एने ज्य बी तुमूह एर नाह सोतो काय वोचेल रोटान टुकड़ा कोलाक टोपला बोरीन विसेल एता? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" /><note caller="+" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="MAT 15:34-38">मत्ती 15:34-38</ref></char></note>एने नाह ता चार एजारान हात रोटा? एने नाह ज्य काय तुमू कोलाक टोपला बोरीन विसेल एता? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />तुमू काहा नाह सोमेजते? मी तुमूह रोटान बाराम नाह केयो, पुण मी फरिसीन एने सदुकीन हिकवोण रेन होमालीन रेणेन केरता केतालो!”<verse eid="MAT 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12" />तेवी चेलान सोमेज माय आवो काय तो रोटान खमीराह नाह, पुण फरिसी एने सदुकीन हिकवोणीह रेन होमालीन रेणे कियेल इतो।<verse eid="MAT 16:12" /></para>
  <para style="s">पतरस यीशुह मसी केरीन स्वीकार ने</para>
  <para style="r">(<ref loc="MRK 8:27-30">मरकुस 8:27-30</ref>; <ref loc="LUK 9:18-21">लुका 9:18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />यीशु केसरीया फिलेपीन देसाम आवो, एने तान चेलाह फुसेह, “माणहान बेटाख ने बाराम माणहे काय केतेह?”<verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16:14 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 14:1">मत्ती 14:1</ref>,<ref loc="MAT 14:2">2</ref>; <ref loc="MRK 6:14">मरकुस 6:14</ref>,<ref loc="MRK 6:15">15</ref>; <ref loc="LUK 9:7">लुका 9:7</ref>,<ref loc="LUK 9:8">8</ref></char>
    </note>ता केया, “थोड़ाक ते योहान बपतीस्मा केरनार केतेह, एने थोड़ाक एलिया, एने थोड़ाक यिर्मया नाह ते जाणकार माय रेन एक जाणकार हे केतेह।”<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />तो ताह फुशो, “पुण तुमू माहु काय केतेह?”<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16:16 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 6:68">योहान 6:68</ref>,<ref loc="JHN 6:69">69</ref></char>
    </note>शमोन पतरस जापाप आप्यो, “तु जीवताला बोगवानान सोरो मसी हे।”<verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />यीशु ताह जापाप आप्यो, “एय शमोन, योनान सोरा तु बोरकेतवालो हे, काहाकाय माह एने लुय नाह, पुण मार आबोख जो हेरगाम हे, ज्यी वात तुवाह देखाड़ेल हे। <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />एने मी बी तुवाह केथु, ‘तु पतरस हे, एने मी ज्या देगड़ा पोर मार मोंडली बाणावुह, एने मोतीन ताकेत बी ज्याह खेतेम नाय केर सेकी। <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" /><note caller="+" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="MAT 18:18">मत्ती 18:18</ref>; <ref loc="JHN 20:23">योहान 20:23</ref></char></note>मी तुवाह हेरगान राज ने कुची आपुह; एने जो काय तु देरती पोर बांदहे तो हेरगाम बांदाय, एने जो काय तु देरती पोर उगाड़ हे तो हेरगाम खोलाय।’”<verse eid="MAT 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 16:20" />तेवी यीशु तान चेलाह उकुम आप्यो, तुमू कुणीह मा किहो काय मी मसी हे।<verse eid="MAT 16:20" /></para>
  <para style="s">यीशु तान दुख एने मोतीन बाराम जाणाव केरने</para>
  <para style="r">(<ref loc="MRK 8:31-9:1">मरकुस 8:31–9:1</ref>; <ref loc="LUK 9:22-27">लुका 9:22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />तुलेचबूखे रेन यीशु तान चेलाह केणे बाज गीयो, “माहु यरूशलेम माय जाणु जोरवरी हे, ता यहुदिन डायला, एने मुखी चाकऱ्या, एने देरेमगुरून आथे जुलूम दुख विसु एने ता माहु माराव देती, एने मी तीसरे दिह जीव उठुह।”<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />तेवी पतरस यीशुह कुवालोच ली जाईन दोपकाड़ीन केयो, “एय मालीक, बोगवान नाय केरी तार हेऱ्यो ओहलो केदी बी नाय एय।”<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />तो फिरीन पतरसा उगे देखीन केयो, “एय सैतान, मार ओंगाण रेन सिटो एय जा! तु मार केरता ठोकरान कारेण हे, काहाकाय तु बोगवानान वातु पोर नाह, पुण माणहान वातु पोर मोन लागाड़ेह।”<verse eid="MAT 16:23" /></para>
  <para style="s">यीशुन पासाण चालनेन मतलब</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16:24 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:38">मत्ती 10:38</ref>; <ref loc="LUK 14:27">लुका 14:27</ref></char>
    </note>तेवी यीशु तान चेलाह केयो, “केदी कुण मार पासाण आवणे हुदेह, ते तो सोताह नाकारी एने तान खुरूसखाम उखलीन मार पासाण आवी। <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" /><note caller="+" style="x"><char style="xo" closed="false">16:25 </char><char style="xt" closed="false"><ref loc="MAT 10:39">मत्ती 10:39</ref>; <ref loc="LUK 17:33">लुका 17:33</ref>; <ref loc="JHN 12:25">योहान 12:25</ref></char></note>काहाकाय जो कुण तान जीवाह वोचाड़ने हुदेह तो ताह गोमाड़ देय; एने जो तान जीवाह मार केरता गोमाड़ देय तो ताह वोचाड़ लेय। <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />केदी माणुह आखी दुनियाह तान काबाम केर लेय, एने तान जीवाह गोमाड़ देय, ते ताह काय फायदो एय? माणुह तान जीवाह वोचाड़नेन केरता काय आप सेकी। <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" /><note caller="+" style="x"><char style="xo" closed="false">16:27 </char><char style="xt" closed="false"><ref loc="MAT 25:31">मत्ती 25:31</ref>; </char><char style="xt" closed="false"><ref loc="ROM 2:6">रोमीयो 2:6</ref></char></note>मी माणहान बिटोख तान हेरोगदुता हिऱ्यो तान आबाख ने बोड़ाय माय आवी, ती टेम माय एकेकाह तान कामान गेत ताह फोल आपी। <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />मी तुमूह खेरीच केथु काय जा न्या उब रेनाह ता माय रेन थोड़ाक ओहला हेते काय जाह वोर माणहान सोराह तान राज माय आवतालो नाय देख लेती ताह वोर मोतीन होवाद केदी नाय चाखे।”<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">यीशुन वेह बोदेलने</para>
  <para style="r">(<ref loc="MRK 9:2-13">मरकुस 9:2-13</ref>; <ref loc="LUK 9:28-36">लुका 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />सोव दिह्यान पासाण यीशु पतरस, याकुब एने तान बाहख योहानाह आरही लेन उचाला बोयड़ा पोर गीयो, एने ताहरी ताह सोड़ीन दिहरो कुणीस नाह एतो।<note caller="+" style="x"><char style="xo" closed="false">17:1 </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">2 पतरस 1:17-18</ref></char></note> <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />ताहरी तान सामने यीशुन वेह बोदेल गीयो, एने तान मुय दिह्यान गेत चोमेकनो एने तान फाड़का उजालान गेत दोवल्यो एय गीया। <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />तेवी मुसा एने एलिया यीशु हेऱ्या वातु केरताला ताह देखाना। <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />ज्य देखीन पतरस यीशुह केयो, “एय मालीक, आमरो न्या रेणे हाजो हे, केदी तार मोरजी एय ते मी न्या तीन तोम्बु बाणावुह, एक तार केरता, एक मुसान केरता, एने एक एलियान केरता।”<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />पतरस बोलनेस बाजरियेल ईतोन एक दोवल्यो वादलो ताह डाप लेदो, एने ता वादलाम रेन ज्यो बोल होमलानो: “ज्यो मारो मोंगाल्लो बिटोख हे, ज्या पोर मी जुलूम खुस हे: ज्यान हुमलो।”<note caller="+" style="x"><char style="xo" closed="false">17:5 </char><char style="xt" closed="false"><ref loc="GEN 22:2">उत्पत्ती 22:2</ref>; <ref loc="DEU 18:15">व्यवस्था 18:15</ref>; <ref loc="PSA 2:7">बजन 2:7</ref>; <ref loc="ISA 42:1">यशाया 42:1</ref>; <ref loc="MAT 3:17-12:18">मत्ती 3:17–12:18</ref>; <ref loc="MRK 1:11">मरकुस 1:11</ref>; <ref loc="LUK 3:22">लुका 3:22</ref></char></note><verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />चेला ज्य होमलीन जुलूम बिय गीया एने मुयान बोरहेस बुंदे जाय पोड़ना। <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />यीशु आहने आवीन ताह सापल्यो एने केयो, “उठो, बिहो मा।” <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />तेवी ता डोला उचा केरीन देख्या, एने यीशुह सोड़ीन दिहराह कुणीस नाह देख्या।<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />जेवी ता बोयड़ा पोर रेन उतरताला, तेवी यीशु ताह ज्यो उकुम आप्यो, “जाह वोर मी माणहान बिटोख मुरेल माय रेन नाय जीव उठी, ताह वोर जो काय तुमू दिखेल हेते, तो कुणीच मा किहो।”<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />ज्य होमलीन चेला यीशुह सावाल केऱ्या, “ओवता देरेमगुरू इही काहा केतेह काय एलियान पेल आवणो जोरवरी हे।”<note caller="+" style="x"><char style="xo" closed="false">17:10 </char><char style="xt" closed="false"><ref loc="MAL 4:5">मलाखी 4:5</ref></char></note><verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />यीशु जापाप आप्यो, “एलिया ते खेरीच आवी एने आखो काय तियार केरी। <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" /><note caller="+" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="MAT 11:14">मत्ती 11:14</ref></char></note>पुण मी तुमूह खेरीच केथु काय एलिया ते आव लागेल हे, एने माणहे ताह नाह ओलख्या पुण जोहलो जुवे तोहलोस ता हेऱ्या केऱ्या। ठिक तिहेस केरीन माणहान बेटाख बी दुख देती।”<verse eid="MAT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13" />तेवी चेला सोमेजना काय तो आपुह योहान बपतीस्मा केरनारान बाराम कियेल हे।<verse eid="MAT 17:13" /></para>
  <para style="s">खाराब जीव लागेल सोराह हुदारने</para>
  <para style="r">(<ref loc="MRK 9:14-29">मरकुस 9:14-29</ref>; <ref loc="LUK 9:37-43">लुका 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />जेवी ता गेरदी हेऱ्या पोचना, ते एक माणुह यीशु फाय आवो एने मांड्या पोड़ीन केयो, <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />“एय मालीक, मार सोरा पोर किव केर! काहाकाय ताह फेपरो आवीह एने तो जुलूम दुख विठेह, तो केदी आक्‍ठा माय पोड़ जाथे, ते केदी पाण्या माय। <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />मी ताह तार चेला फाय लायेल इतो, पुण ता ताह हुदार नाह सेक्‍या।”<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />यीशु जापाप आप्यो, “एय अविश्वासी एने कोपट्या माणहा! मी केदीह वोर तुमू हिऱ्यो रेह? एने केदीह वोर तुमरी वेठुह? ता सोराह न्या मार फाय लावो!” <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />तेवी यीशु बुतड़ाह दोपकाड्यो, एने तो ताम रेन निकेल गीयो, एने सोरो चालोच हुदेर गीयो।<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />जेवी यीशु एखालोच इतो, ते चेला तान आहने आवीन फुशा, “आमु बुतड़ाह बाहेर काहा नाह काड़ सेक्‍या?”<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />
    <note caller="+" style="x">
      <char style="xo" closed="false">17:20 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:21">मत्ती 21:21</ref>; <ref loc="MRK 11:23">मरकुस 11:23</ref>; <ref loc="1CO 13:2">1 कुरिंथीयो 13:2</ref></char>
    </note>तो ताह केयो, “तुमरा बोरहान कोमीन कारेण,” काहाकाय मी तुमूह खेरीच केथु, केदी तुमरो बुरहो राईन दाणान बाराबोर बी एय, ते ज्या बोयड़ाह केय सिकहो, “न्या रेन हेरकीन ता जातरे,” ते तो जात रेय; एने काल्लीस वात तुमरी केरता एय नाय ओहली नाय रेय। <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" /><note caller="+" style="f"><char style="fr" closed="false">17:21 </char><char style="ft" closed="false">थोड़ाक लेख माय वचन 21 जुड़ेल हे, देखी मरकुस 9:29</char></note>पुण ज्यी जात विन्ता एने उपासान बिगेर नाह निकेलते।<verse eid="MAT 17:21" /></para>
  <para style="s">आपणी मोतीन बाराम यीशुन पोशो जाणाव</para>
  <para style="r">(<ref loc="MRK 9:30-32">मरकुस 9:30-32</ref>; <ref loc="LUK 9:43-45">लुका 9:43-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />जेवी ता गेलील हेयराम एकठास एता, ते यीशु ताह केयो, “एवी माणहान बिटोख माणहान आथाम देराय जाय, <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />एने ता ताह मार टाकती; पुण तो तीसरे दिह जीव उठी।” चेला ज्य होमलीन जुलूम नाराज एना।<verse eid="MAT 17:23" /></para>
  <para style="s">बोक्‍तीन गेरान फालो</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />जेवी यीशु एने तान चेला कफरनहूम हेयराम आवा, तेवी मोंदिरान फालो लेणारे पतरसान आहने आवीन फुशा, “काय तुमरो गुरू मोंदिरान फालो नाह आपेत?”<verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />पतरस केयो “होव आपणे”<note caller="+" style="x"><char style="xo" closed="false">17:25 </char><char style="xt" closed="false"><ref loc="EXO 30:13">निर्गमन 30:13</ref>; <ref loc="EXO 38:26">38:26</ref></char></note> जेवी तो गेराम आवो, ते यीशु ताह फुसणेन पेल ताह केयो, “एय शमोन, तु काय किथे? देरतीन राजा कुणी फाय रेन फालो लेणे? तान सोरा फाय रेन काय पाराया माणहा फाय रेन?”<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />पतरस ताह केयो, “पाराया माणहा फाय रेन।” यीशु ताह केयो, “ते सोरा वोच गीया। <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />तीबी ज्यानकेरता काय आपु ताह ठोकरा नाय खावाड़हु, तु तेलान मीरे जाईन गेली टाक, एने जो मासो पेल निकली, ताह ली; तान मुय उगाड़ हे, ते तुवाह चांदीन एक सिक्को जुड़ी, ताह लावीन मारे एने तार वोतीन ताह आप दिज्ये।”<verse eid="MAT 17:27" /></para>
  <para style="b" />
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">हेरगान राज माय मोटलो कुण?</para>
  <para style="r">(<ref loc="MRK 9:33-37">मरकुस 9:33-37</ref>; <ref loc="LUK 9:46-48">लुका 9:46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">18:1 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 22:24">लुका 22:24</ref>
      </char>
    </note>तुलबूखे चेला यीशु फाय आवीन फुसणे बाज गीया, “हेरगान राज माय आखाम रेन मोठो कुण हे?”<verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />ज्य होमलीन यीशु एक आतल्या सोराह हादिन तान विचीम उबो किऱ्यो, <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" /><note caller="+" style="x"><char style="xo" closed="false">18:3 </char><char style="xt" closed="false"><ref loc="MRK 10:15">मरकुस 10:15</ref>; <ref loc="LUK 18:17">लुका 18:17</ref></char></note>एने केयो, “मी तुमूह खेरीच केथु काय, जाह वोर तुमू नाय बुदेलहो एने सोरान गेत नाय बुणहो, तुमू हेरगान राज माय जाय नाय सिकहो। <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />जो कुण आपणे आपाह ज्या सोरान गेत आत्यो केरी, तो हेरगान राज माय मोठो रेय। <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />एने जो कुण मार नाव से एक ओहला सोराह आहने किरेह, तो माहु आहने किरेह।”<verse eid="MAT 18:5" /></para>
  <para style="s">पाप केरनेन पारेख</para>
  <para style="r">(<ref loc="MRK 9:42-48">मरकुस 9:42-48</ref>; <ref loc="LUK 17:1-2">लुका 17:1-2</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />पुण जो कुण न्या आत्याम रेन जा मार पोर बुरहो केरतेह, एकाह ठुकोर खावाड़ी, तान केरता हाजो रेतो, काय मोटली गेरटीन पुड़ तान गेला माय टागीन, ताह उंडाला देरीया माय टाकाय जातो। <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />ठोकरान केरता दुनिया पोर हाय ठोकेर लागण्यास हेते; पुण हाय ता माणहा पोरजान उगे रेन ठोकेर लागेह।<verse eid="MAT 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">18:8 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:30">मत्ती 5:30</ref>
      </char>
    </note>केदी तार आथ निहे ते पाय तुवाह ठुकोर खावड़ावी, ताहार ताह काटीन जुगार दे; लुलो एने लेंगड़ो एन जीवाय माय रिगणे तार केरता ज्याह रेन हाजो हे! काय दुय आथ नाहते दुय पाय लेन नेरगान आक्‍ठा माय टाकाय जाही। <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" /><note caller="+" style="x"><char style="xo" closed="false">18:9 </char><char style="xt" closed="false"><ref loc="MAT 5:29">मत्ती 5:29</ref></char></note>एने केदी तार डोलान उगे रेन तुवाह ठुकोर लागी, ते ताह काड़ीन जुगार दे, तार केरता ज्योस हाजो हे, काय तु एकुस डुलो लेन जेलेमक्यो जीवाय माय रिगी काय दुय डोला लेन नेरगान आक्‍ठा माय टाकाय जाही।<verse eid="MAT 18:9" /></para>
  <para style="s">टाकायेल मेंड्रान किस्सो</para>
  <para style="r">(<ref loc="LUK 15:3-7">लुका 15:3-7</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">18:10 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 19:10">लुका 19:10</ref>
      </char>
    </note>दिखो, तुमू न्या आत्याम रेन कुणीह बी नेचा मा सुमजो। काहाकाय मी तुमूह केथु, काय हेरगा माय तान हेरोगदुत मार हेरगावाला आबाख ने मुय कायेम देखतेह। <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />काहाकाय माणहान बिटोख टाकायेल ताह वोचाड़ने आयेल हे।<note caller="+" style="f"><char style="fr" closed="false">18:11 </char><char style="ft" closed="false">थोड़ाक लेख माय वचन 11 जुड़ेल हे, देखी लुका 19:10</char></note><verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />तुमू काय सोमेजतेह? केदी एगदा माणहा फाय एक होव मेंड्रा रेय, एने ता माय रेन एक टाकाय जाय, ते ता नोवह्यान नोव मेंड्राह सोड़ीन पुशो बोयड़ा माय जाईन ता टाकायेल मेंड्राह होदणे जाय काय नाय जाय? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />एने जेवी ताह सापड़ी जाथे, ते मी तुमूह खेरीच केथु काय तो ता नोवह्यान नोव मेंड्रान केरता जा टाकायेल नाह एता उलो खुस नाय एय, जुलोक काय ज्या मेंड्रान केरता केरी। <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" /><note caller="+" style="f"><char style="fr" closed="false">18:14 </char><char style="ft" closed="false">तुमरो, थोड़ाक लेख माय आमरो हे</char></note>तिहेस केरीन तुमरा आबाख ने जो हेरगा माय हे ज्यी आसा नाह सोती, काय न्या आत्या माय रेन एक बी खेतेम एय।<verse eid="MAT 18:14" /></para>
  <para style="s">बाहख एने बोणीख ने पाप</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />
    <note caller="+" style="x">
      <char style="xo" closed="false">18:15 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 17:3">लुका 17:3</ref>
      </char>
    </note>
    <note caller="+" style="f">
      <char style="fr" closed="false">18:15 </char>
      <char style="ft" closed="false">थोड़ाक लेख माय तुमरे विरोद नाह लिखेल हे</char>
    </note>यीशु केयो, “केदी तार बाहख विरोद माय गुनो केरी, ते तु ता फाय जा एने एखालाम ता हिऱ्यो वातु केरीन सोमजाड़ दे। केदी तारी वात मान लेय, ते तु ताह वोचाड़ लिहे। <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />एने केदी तो नाय होमली ते एक दुय जाणाह तार हिऱ्यो लिजा काय आखी वातुन दुय नाहते तीन माणहान पुरावान द्‍वारे ठेराय जाय।”<note caller="+" style="x"><char style="xo" closed="false">18:16 </char><char style="xt" closed="false"><ref loc="EXO 30:13-38:26">निर्गमन 30:13–38:26</ref></char></note> <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />केदी तो तान वातु बी नाय मानी ते मोंडलीह कि, एने केदी तो मोंडलीम बी नाय मानी ते, ताह तु पापी एने फालो लेणे वालान गेत सोमेज।<verse eid="MAT 18:17" /></para>
  <para style="s">पारवांगी आपणु नाह आपणु</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />
    <note caller="+" style="x">
      <char style="xo" closed="false">18:18 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:19">मत्ती 16:19</ref>; <ref loc="JHN 20:23">योहान 20:23</ref></char>
    </note>मी तुमूह खेरीच केथु, “जो बी तुमू देरती पोर बांदहो तो हेरगा माय बी बांदाय जाय, एने जो बी तुमू देरती पोर उगाड़हो तो हेरगाम बी उगड़ी। <verse eid="MAT 18:18" /><verse number="19" style="v" sid="MAT 18:19" />उंजु मी तुमूह खेरीच केथु, ‘तुमरे माय रेन दुय माणहे देरती पोर एगदी वातुन केरता एक मोन केरीन मारा हेरगावाला आबाख फाय रेन मांगहो, तिहेस तो तुमूह आप देय। <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />काहाकाय जा बी दुय नाहते तीन माणहे मार नाव लेन टुलो एती, ता मी तान विची माय मी रेथु।’”<verse eid="MAT 18:20" /></para>
  <para style="s">माफ नाह केरनार पावरान किस्सो</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">18:21 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 17:3">लुका 17:3</ref>,<ref loc="LUK 17:4">4</ref></char>
    </note>तेवी पतरस यीशुन आहने आवीन केयो, “एय मालीक, मार बाहख मार विरोद माय गुनो केरी ते, ताह मी कोलाक वारीन माफ केरू, काय हात वार वोर?”<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />यीशु ताह केयो, “मी तुवाह इही नाह केत काय हात वार वोर, <note caller="+" style="f"><char style="fr" closed="false">18:22 </char><char style="ft" closed="false">हात वार ने सेत्तेर वार</char></note>पुण हात वारान सेत्तेर वार वोर।”<note caller="+" style="x"><char style="xo" closed="false">18:22 </char><char style="xt" closed="false"><ref loc="GEN 4:24">उत्पत्ती 4:24</ref></char></note> <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />ताच माय हेरगान राज ता राजान गेत हे, जो एक दिह तान पावरान लेखो लेणे हुद्यो। <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />जेवी ईसाब लेणे बाज गीयो ते एक जाण तान ओंगाण लावाय गीयो, तो दोह एजार तोड़ान केरजो लियेल इतो।<note caller="+" style="f"><char style="fr" closed="false">18:24 </char><char style="ft" closed="false">करोड़ो रूप्या</char></note> <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />जुलबुखे केरजो सुटणेन केरता ता फाय काय नाह एतो, तान मालीक केयो, “ज्याह एने ज्यान बायकु सोराह, एने जो काय बी ज्या फाय हे तो आखो वेच दिवो, एने तो केरजो सुटाड़ाय जाय।” <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />तेवी तो पावोर तान पाया पोड़ीन केयो, “एय मालीक, दिर खा माहु थोड़ाक दिह उंजु आप, मी किहीक बी केरीन तारो आखो केरजो सुट देह। <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />तेवी ता पावरान मालीक ता पोर किव केरीन ताह सोड़ दिनो, एने तान आखो केरजो माफ केर दिनो।”<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />पुण जेवी तो पावोर बाहेर आवो। ते तान हाती एक पावरा माय रेन एक ताह मिलानो, तो तान एक होव दिनार<note caller="+" style="f"><char style="fr" closed="false">18:28 </char><char style="ft" closed="false">होव दिनार मतलब हे रोमन कालान राज माय होव दिह्यान मोंजरीन बाराबोर</char></note> केरजो लियेल इतो, तेवी तो ताह देरीन गिलो दाबीन केयो, “जो काय सुट सिकेह तो सुट दे। <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />तेवी तान हाती पावोर तान पाया पोड़ीन केयो, ‘थोड़ाक दिह दिर खा मी तारो आखो केरजो सुट देह!’ <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />पुण तान वात तो नाह होमल्यो एने जाहु वोर केरजो नाह बुरेत ताह वोर जेलीम कोंड दिनो। <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />तेवी हाती पावोर ज्य देखीन जुलूम दुखी एना, एने जाईन मालक्याह आखी वात केय देना। <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />तेवी तान मालीक ता पावराह हादिन केयो, ‘एय खाराब पावोर, तु माहु फाय विन्ता किरेल एने मी तारो आखो केरजो माफ केर दियेल, <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />ता माय जिहकेरीन मी तार पोर किव किरेल तिहेस केरीन काय तुवाह बी तार हातीन पावराह बी माफ केरनु एतो।’ <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />एने तान मालीक जुलूम रागाईन ताह डेंड आपणारान आथाम होप दिनो, एने जाह वोर केरजो बोर नाह देत ताह वोर तान आथाम रेय।”<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />“इहीचकेरीन तुमरे माय रेन एगदो तान बायाख पुरो मोन से माफ नाय केरी, ते मारो आबोख बी जो हेरगाम हे तुमरा पाप माफ नाय केरी।”<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">तालाक ने बाराम यीशुन हिक</para>
  <para style="r">(<ref loc="MRK 10:1-12">मरकुस 10:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />जेवी यीशु ज्यु वातु केय दिनो, एने गेलील माय रेन जात रिनो; एने यरदन नेदीन ती मीरे यहुदियान देसाम आवो। <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />तेवी होवटाली गेरदी तान पासाण चाल पोड़नी, एने तो ताह हुदाऱ्यो।<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />तेवी थोड़ाक फरिसी यीशुह पारेखणेन केरता, ता फाय आवीन केया, “काय काल्ला कारणान केरता आपणी लाडीह सोड़नेन हाजो हे?”<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />यीशु ताह केयो, “तुमू चोखाली पुस्तेक माय नाह वाच्‍या काय जो ताह बाणायेल, तो पेलुस रेन एदमी एने बायकु बाणायेल हे,<note caller="+" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="GEN 1:27-5:2">उत्पत्ती 1:27–5:2</ref></char></note> <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />एने बोगवान कियेल, ‘केरीन माणुह तान आईख आबाख रेन आंगे एन, तान लाडी हिऱ्यो रेय, एने ता दुयू एक सेरीर रेती?’<note caller="+" style="x"><char style="xo" closed="false">19:5 </char><char style="xt" closed="false"><ref loc="GEN 2:24">उत्पत्ती 2:24</ref></char></note> <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />ता एवी दुय नाह, पुण एक सेरीर हेते, तानकेरता जाह बोगवान जुड़ेल हे, ताह माणहे आंगे नाय केरी।”<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />ता यीशुह केया, “उवतो मुसा ज्य काहा ठेरायेल, काय लेख्यो आपीन तिह सोड़ देय?”<note caller="+" style="x"><char style="xo" closed="false">19:7 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">व्यवस्था 24:1-4</ref>; <ref loc="MAT 5:31">मत्ती 5:31</ref></char></note><verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />तो ताह केयो, “मुसा तुमरा मोनान वातड़ाय ने केरता तुमूह तुमरी लाडीह सोड़ देणेन उकुम आपेल हे, पुण पेल ओहलो नाह एतो।” <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" /><note caller="+" style="x"><char style="xo" closed="false">19:9 </char><char style="xt" closed="false"><ref loc="MAT 5:32">मत्ती 5:32</ref>; <ref loc="1CO 7:10">1 कुरिंथीयो 7:10</ref>,<ref loc="1CO 7:11">11</ref></char></note>एने मी तुमूह केथु, “जो कुण बी सिनालाह सोड़ीन, दिहरी वातीन केरता तान लाडीह सोड़ीन दिहरी हिऱ्यो, वाराड़ किरेह, एने जो सोड़ेल ती हिऱ्यो वाराड़ किरेह तो बी सिनालो किरेह।”<verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />चेला ताह केया, “केदी एदम्याह बायकु हेऱ्यो ओहलो नातो हे, ते हाजो ज्यो हे वाराड़ नाय केरी।”<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />तो ताह केयो, “आखा वाराड़ केऱ्या बिगेर नाह रेय सेकते, निस्ता ता ओलास जाह ज्यो वरदान जुड़ेल हे। <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />काहाकाय थोड़ाक नपुंसक ओहला हेते, जा आईख ने पेटा माय रेन ओहलाच पायदा ईयेल हेते; एने थोड़ाक नपुंसक ओहला हेते; जाह माणहे बाणायेल; एने थोड़ाक नपुंसक ओहला हेते; जा हेरगान राज ने केरता सोताह नपुंसक बाणायेल हेते, जो ज्याह लेय सिकेह, तो लेय लेय।”<verse eid="MAT 19:12" /></para>
  <para style="s">यीशु सोराह बोरकेत आपणे</para>
  <para style="r">(<ref loc="MRK 10:13-16">मरकुस 10:13-16</ref>; <ref loc="LUK 18:15-17">लुका 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />तेवी माणहे सोराह यीशुन आहने लावा काय तो ता पोर आथ मेली, एने विन्ता केरी, पुण चेला ताह दोपकाड्या। <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />यीशु केयो, “सोराह मार फाय आवणे दिवो, ताह मा रूकहो, काहाकाय हेरगान राज ओहलाच ने हे।”<verse eid="MAT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 19:15" />तेवी यीशु ता पोर आथ मेलीन बोरकेत आप्यो एने तारेन जात रिनो।<verse eid="MAT 19:15" /></para>
  <para style="s">मालदार जुवान एने जेलेमक्यो जीवाय</para>
  <para style="r">(<ref loc="MRK 10:17-31">मरकुस 10:17-31</ref>; <ref loc="LUK 18:18-30">लुका 18:18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />एने एक माणुह यीशु फाय आवीन केयो, “एय मालीक, मी काल्लो हाजो काम केरू काय जेलेमक्यो जीवाय सापड़ावु?”<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />तो ताह केयो, “तु माहु हाजा कामान बाराम काहा फुसेह? हाजो ते एकुच हे, पुण केदी तु जीवाय माय रिगणे हुदेह, ते उकुम मान्या केर।”<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />तो ताह केयो, “काल्लो उकुम मानु?”<note caller="+" style="x"><char style="xo" closed="false">19:18 </char><char style="xt" closed="false"><ref loc="EXO 20:13-16">निर्गमन 20:13-16</ref>; <ref loc="DEU 5:17-20">व्यवस्था 5:17-20</ref></char></note> यीशु केयो, “ज्यो काय खुन मा किरहे, सिनालो मा किरहे, चोरी मा किरहे, जुठो पुरावो मा दिहे, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />आपणा आबाख एने आपणी आईख ने मान मिलज्यो, एने आपणा आहेंल्या हेऱ्या आपणे बाराबोर मोंग किरज्‍यो।”<note caller="+" style="x"><char style="xo" closed="false">19:19 </char><char style="xt" closed="false"><ref loc="EXO 20:12">निर्गमन 20:12</ref>; <ref loc="DEU 5:16">व्यवस्था 5:16</ref>; <ref loc="LEV 19:18">लेव्यवस्था 19:18</ref></char></note><verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />तो जुवान ताह केयो, “ज्य आखो, ते मी मानील हे, एवी मार माय काल्ली वातीन कोमी हे?”<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />यीशु ताह केयो, “केदी तु खिरो बोणने हुदेह ते जा, तारो मालदेन वेचीन गेरब्याह आपदी, एने तुवाह हेरगाम मालदेन जुड़ी; एने आवीन मार पासाण चाल पोड़।”<verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />पुण तो जुवान ज्यी वात होमलीन नाराज एन जात रिनो, काहाकाय तो जुलूम मालदार एतो।<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />तेवी यीशु तान चेलाह केयो, “मी तुमूह खेरीच केथु, काय मालदाराह हेरगान राज माय जाणेन जुलूम केठीण हे। <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />तुमूह पुशो केथु काय बोगवानान राज माय मालदाराह जाणे रेन उटड़ाह हुईन डोसा माय रेन सेरकी जाणे होपो हे।”<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />ज्य होमलीन चेला जुलूम बोंगलायीन केया, “ओवतो कुणीन सुटकारो एय सिकेह?”<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />यीशु तान उगे देखीन केयो, “ज्यो माणहान केरता केठीण हे, पुण बोगवानान केरता कायच केठीण नाह सोतो।”<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />पतरस ताह केयो, “देख आमु, ते आखो काय सोड़ीन तार पासाण आव लागेल हेते, ते आमुह काय जुड़ी?”<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />
    <note caller="+" style="x">
      <char style="xo" closed="false">19:28 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 25:31">मत्ती 25:31</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="LUK 22:30">लुका 22:30</ref>
      </char>
    </note>यीशु ताह केयो, “मी तुमूह खेरीच केथु काय नोवाली केली माय जेवी माणहान बिटोख, तान बोड़ाय ने राजगादि पोर बोही, ते तुमू बी जा मार पासाण आयेल हेते, बारा राजगादि पोर बोहीन इस्राएल ने बारा गेराणान नियाव किरहो। <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />एने जो कुण गेराह, बायाख, बोणह्युह, आबाख, आईख, सोरा पोऱ्या, नाहते खेताह मार नावान केरता सोड़ दियेल हे ताह एक होव माप जुड़ी, एने तो जेलेमक्या जीवाय ने आदिकारी रेय। <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" /><note caller="+" style="x"><char style="xo" closed="false">19:30 </char><char style="xt" closed="false"><ref loc="MAT 20:16">मत्ती 20:16</ref>; <ref loc="LUK 13:30">लुका 13:30</ref></char></note>पुण जुलूम जाणे जा ओंगाण हेते, पासाण रेती, एने जा पासाण हेते, ओंगाण एती।<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">अंगुरान वाड़ी माय काम केरनारा मोंजऱ्यान किस्सो</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />“हेरगान राज” एगदा गेरान मालक्यान गेत हे, जो विगोस उठीन बाहेर गीयो, काय तान अंगुरान वाड़ीम मोंजर्‍या लागाड़ी। <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />तो मोंजऱ्याह एक दिनार<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="ft" closed="false">एक दिनार मतलब, एक दिह्यान मोंजरी</char></note> दिह्या पोर ठेरावीन, ताह तान अंगुरान वाड़ी माय मुकल्यो। <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />पुशो तो नोव वासता, निकलीन, दिहरा माणहाह बाजाराम उदेड़ उबरियेल देख्यो। <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />एने ताह केयो, “तुमू बी अंगुरान वाड़ी माय जावो, एने जो काय ठिक हे तो तुमूह आपुह।” <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />तेवी ता बी गीया पोशो तो दिहरे वार बारा वासता एने तीन वाचतान आहने निकलीन तिहेच किऱ्यो। <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />एक पाच वासता तो पुशो निकलीन दिहराह उबरियेल दिख्यो, एने ताह केयो, “तुमू काहा न्या दिह बोर उदेड़ उब रेनाह? <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />ता ताह केया, ‘ज्यानकेरीन काय कुण आमुह काम पोर नाह लागाड्यो,’ तो ताह केयो, तुमू बी अंगुरान वाड़ी माय जावो।”<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />हांज पोर अंगुरान वाड़ीन मालीक तान मुकोड़ दोमाह केयो, “मोंजऱ्याह हादिन पासाणल्याह लागाड़ीन पेल्लाह वोर आखाह मोंजरी आप दे।”<note caller="+" style="x"><char style="xo" closed="false">20:8 </char><char style="xt" closed="false"><ref loc="LEV 19:13">लेव्यवस्था 19:13</ref>; <ref loc="DEU 24:15">व्यवस्था 24:15</ref></char></note> <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />तेवी ता मोंजर्‍या आवा जा पाच वासता लागेल एता, एक गेंटो वोर दिह ईतोन लागेल ताह एक दिनार जुड़नो। <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />जा पेल आयेल एता ता ज्य सोमज्या काय आमुह होवटा जुड़ती; पुण ताह बी एकुस दिनार जुड़नो। <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />जेवी ताह एक दिनार जुड़नो, ते ता मालक्या पोर कुरकुर केरीन केतेह, <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />न्या पासाणल्या एकुच गेंटो काम किरेल एता, एने तो न्याह बी आमरी बाराबोर मोंजरी आप दिनो, जा दिह बोरीन बार विशा, एने दोप वेठ्या? <verse eid="MAT 20:12" /><verse number="13" style="v" sid="MAT 20:13" />तो ता माय रेन एकाह जापाप आप्यो, “एय दोस्ता मी तार हिऱ्यो काईच गेलेत नाह किरेत; काय तु मार हिऱ्यो, एक दिनार नाह ठेरायेल इतो? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />ज्यो तारो हे विसले, एने जातरे; मारी आसा ज्यी हे काय जोलोक तुवाह आपेल हे, तोलोस न्या पासाणल्याह बी आपु। <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />काय ज्य हाजो नाह सोतो काय मी मार माला हेऱ्यो जो पोटी तो केरूह? काय मी हाजो रेह केरीन तु खाराब नेजेर केरीन दिखेह?” <verse eid="MAT 20:15" /><verse number="16" style="v" sid="MAT 20:16" /><note caller="+" style="x"><char style="xo" closed="false">20:16 </char><char style="xt" closed="false"><ref loc="MAT 19:30">मत्ती 19:30</ref>; <ref loc="MRK 10:31">मरकुस 10:31</ref>; <ref loc="LUK 13:30">लुका 13:30</ref></char></note>तिहेच केरीन जा पासाण हेते, ता ओंगाण एती, एने जा ओंगाण हेते, ता पासाण एती।<verse eid="MAT 20:16" /></para>
  <para style="s">आपणी मोतीन बाराम यीशुन तिसरो जाणाव</para>
  <para style="r">(<ref loc="MRK 10:32-34">मरकुस 10:32-34</ref>; <ref loc="LUK 18:31-34">लुका 18:31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />यीशु यरूशलेम जाणे बुखेत, बारा चेलाह कुवालोच ली गीयो, एने वाटे ताह केयो, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />“दिखो, आपु यरूशलेम जातेह, एने माणहान बिटोख मुखी चाकऱ्या, एने देरेमगुरून आथे देराय जाय, एने ता ताह मोतीन लायेक ठेरावती। <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />एने ता यीशुह बिगेर यहुदिन आथा माय होप देती काय ता तान ईजुत उड़ावती, एने चापका देती, एने खुरूसखाम पोर चेड़ावती, एने तो मोरीन पुशो तिसरे दिह जीव उठी।”<verse eid="MAT 20:19" /></para>
  <para style="s">एक आईख ने विन्ती</para>
  <para style="r">(<ref loc="MRK 10:35-45">मरकुस 10:35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />तेवी जब्दीन सोरान आहख तीन सोरा हेऱ्यी यीशु फाय आवीन ताह नमस्‍कार केऱ्यी, एने ता फाय काय मांगणे बाज गियी।<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />यीशु तीह केयो, “तुवाह काय जुवे?” ती ताह केयी, “ज्य काय मारा ज्या दुय सोरा तारा राज माय एक तारे जीवड़े उगे, एने एक तारे डाखरे उगे बोही।”<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />यीशु जापाप आप्यो, “तुमू नाह जाणते काय काय मांगतेह, जो वाटको मी पिण्यो हे, काय तुमू ताह पिय सेकतेह?” ता यीशुह केया, “पिय सेकतेह।”<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />यीशु ताह केयो, “तुमू मारो वाटको ते पिहो, पुण मारी जीवड़े उगे, एने डाखरे उगे कुणीह बोहाड़नो हे ज्य मारो काम नाह सोतो, पुण जाह मारा आबाख ने उगे रेन तियार किरेल हे, ताज ने केरता हे।”<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />जेवी बाकीन दोह चेला ज्यी वात होमल्या, ते ता दुय बायाख पोर खीजवाना। <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />यीशु ताह आहने हादिन केयो, “तुमू जाणतेह, काय बिगेर यहुदिन आदिकारी ता पोर राज केरतेह; एने जा मोठा हेते, ता पोर आदिकार मेलतेह।<note caller="+" style="x"><char style="xo" closed="false">20:25 </char><char style="xt" closed="false"><ref loc="LUK 22:25-26">लुका 22:25-26</ref></char></note> <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" /><note caller="+" style="x"><char style="xo" closed="false">20:26 </char><char style="xt" closed="false"><ref loc="MAT 23:11">मत्ती 23:11</ref>; <ref loc="MRK 9:35">मरकुस 9:35</ref>; <ref loc="LUK 22:26">लुका 22:26</ref></char></note>तोहलो तुमरे माय नाय एय, पुण जो कुण तुमरे माय मोठो बोणने हुदेह, तो तुमरो पावोर बोणी। <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />एने जो तुमरे माय ओंगाण मुखी बोणने हुदेह, तो तुमरो पावोर बोणी। <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />तिहेस केरीन माणहान बिटोख सेवा केरावणे नाह, पुण सेवा केरने आयेल हे, एने मोकतास ने सुटकारान केरता तान जीव आपणे आयेल हे।”<verse eid="MAT 20:28" /></para>
  <para style="s">दुय आंदलान किस्सो</para>
  <para style="r">(<ref loc="MRK 10:46-52">मरकुस 10:46-52</ref>; <ref loc="LUK 18:35-43">लुका 18:35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />जेवी यीशु एने तान चेला यरीहो माय रेन निकेलताला, ते एक मोटली माणहान गेरदी तान पासाण चाल देनी। <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />एने दुय आंदला, जा सेड़कीन दिड़े बोह रियेल एता, ज्य होमल्या काय यीशु जाणे बाजरिनोह, आयड़ीन केणे बाज गीया, “एय मालीक, दाऊदान बेटाख आमु पोर किव केर।”<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />माणहे ताह ठावका रिवो केरीन दोपकाया, पुण ता उंजु मोठेह आयड़ीन केया, “एय मालीक, दाऊदान बेटाख आमु पोर किव केर!”<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />तेवी यीशु उबरीन ताह हाद्यो एने केयो, “तुमरी काय आसा हे काय मी तुमरी केरता केरू?”<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />ता ताह केया, “एय मालीक, ज्योस काय आमु देखणे बाज जाज्यु।”<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />तेवी यीशु किव केरीन तान डोलाह सापल्यो; एने चालोच देखाणे बाज गीयो, एने ता यीशुन पासाण चाल देना।<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">यरूशलेम माय जिकीन रिगणो</para>
  <para style="r">(<ref loc="MRK 11:1-11">मरकुस 11:1-11</ref>; <ref loc="LUK 19:28-40">लुका 19:28-40</ref>; <ref loc="JHN 12:12-19">योहान 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />जेवी ता यरूशलेम ने आहने पोचना, एने जेतुन बोयड़ा पोर बेथफगेन आहने आवा, तेवी यीशु दुय चेलाह ज्य केयीन मुकल्यो। <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />तुमू सोमोरल्या गावा माय जावो, ता पोचताच तुमूह ताहरी एक गेदड़ो बांद मिलेल, एने ती हेऱ्यो पाठड़ो सापड़ी; ताह सोड़ीन मार फाय लीयावज्यो। <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />केदी तुमूह इखेह काह फुसी, ताहार किज्यो, मालीकाह ज्यान गिरेज हे, ते तो जालुस मोकली देय। <verse eid="MAT 21:3" /><verse number="4" style="v" sid="MAT 21:4" />ज्यो ज्यानकेरता एनो काय ज्यो वचन जाणकारान द्‍वारे केवाय जायेल एतो, तो पुरो एय:<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />सियोन ने बेटीह किवो<note caller="+" style="x"><char style="xo" closed="false">21:5 </char><char style="xt" closed="false"><ref loc="ZEC 9:9">जकर्‍या 9:9</ref> </char></note>,</para>
  <para style="q2" vid="MAT 21:5">“देख, तार राजा तुवा फाय आवीह;</para>
  <para style="q1" vid="MAT 21:5">तो बुलो हे, एने गेदड़ा पोर बोह रिनोह;</para>
  <para style="q2" vid="MAT 21:5">मतलब गेदड़ान पाठड़ा पोर।”<verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />तेवी चेला जाईन यीशु जीहे कियेल एतो तिहेच केऱ्या। <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />गेदड़ान पाठड़ाह लावा, एने ता पोर तान फाड़का टाक्या; यीशु ता पोर बोह गीयो। <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />एने मोकतास माणहे जान तान फाड़का वाटी पोर आथऱ्या, एने थोड़ाक माणहे जाड़ा पोर रेन डालख्या काटीन वाटी पोर आथऱ्या। <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />जी गेरदी ओंगाण ओंगाण जाताली एने पासाण पासाण चालताली आयड़ी आयड़ीन केताली, “दाऊदान बेटाख ने होसन्‍ना”<note caller="+" style="f"><char style="fr" closed="false">21:9 </char><char style="ft" closed="false">यशाया; मतलब तु माहु सुटकारो आप।</char></note> मतलब आमुह तु सुटकारो आप बोरकेतवालो हे तो जो मालीक ने नाव से आवीह, हेरगा माय होसन्‍ना!<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />जेवी यीशु यरूशलेम माय पोचनो, ते आखा हेयराम पुकार एय गीयो; एने माणहे केणे बाज गीया, “ज्यो कुण हे?”<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />माणहे केणे बाज गीया, “ज्यो गेलीलान नासरत मायवालो जाणकार यीशु हे।”<verse eid="MAT 21:11" /></para>
  <para style="s">मोंदिर माय रेन वेपारीह निकालनो</para>
  <para style="r">(<ref loc="MRK 11:15-19">मरकुस 11:15-19</ref>; <ref loc="LUK 19:45-48">लुका 19:45-48</ref>; <ref loc="JHN 2:13-22">योहान 2:13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />उवतो यीशु मोंदिर माय गीयो, एने ता आखाह, जा लेन देन केरताला, ताह बाहेर काड़ दिनो, एने पेरवाह वेचणारान पाटला उलटाव दिनो। <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />एने ताह केयो, “वचन माय लिखेल हे, मारो गेर विन्तान गेर केवाय, पुण तुमू ताह डाकुन पाड़ावो बाणाव मेल्याह!<note caller="+" style="x"><char style="xo" closed="false">21:13 </char><char style="xt" closed="false"><ref loc="ISA 56:7">यशाया 56:7</ref>; <ref loc="JER 7:11">यिर्मया 7:11</ref></char></note>”<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />ओवता आंदला एने लेंगड़ा मोंदिरा माय यीशु फाय आवा, एने ताह तो हुदाऱ्यो। <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />पुण जेवी मुखी चाकऱ्या एने देरेमगुरू ज्या कामाह, जा तो किरेल हे, एने सोराह मोंदिर माय दाऊदान बेटाख ने होसन्‍ना आयेड़ताला देख्या, ते रागा माय बोराय गीया, <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />यीशु ताह केयो, “होव,” <note caller="+" style="x"><char style="xo" closed="false">21:16 </char><char style="xt" closed="false"><ref loc="PSA 8:2">बजन 8:2</ref></char></note></para>
  <para style="p" vid="MAT 21:16">काय तुमू ज्य केदीच पुस्तेक माय नाह वाच्‍या? सोरा एने दुद पिताला सोरान मुयाम रेन तो बोड़ाय केरायेल हे?<verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />तेवी यीशु ताह सोड़ीन हेयरान बाहेर बेतनिया माय गीयो, एने ता रात हुवनो।<verse eid="MAT 21:17" /></para>
  <para style="s">यीशु अंजीरान जाड़ाह हाराप देणे</para>
  <para style="r">(<ref loc="MRK 11:12-14">मरकुस 11:12-14</ref>,<ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />जेवी विगोस यीशु हेयराम आवतालो, तेवी यीशुह बुख लागी। <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />एने वाटीन दिड़े एक अंजीरान जाड़ देखीन तो तान आहने गीयो, पुण ताह पांटा सोड़ीन कायच नाह देखीन केयो, “एवी रेन तार पोर केदीच फोल नाय लागी।” एने अंजीरान जाड़ तुलेचबूखे हुक गीयो।<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />ज्यो देखीन चेला बोंगला गीया एने केया, “ज्यो अंजीरान जाड़ चालोच किहीक हुक गीयो?”<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">21:21 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 17:20">मत्ती 17:20</ref>; <ref loc="1CO 13:2">1 कुरिंथीयो 13:2</ref></char>
    </note>यीशु ताह केयो, “मी तुमूह खेरीच केथु, केदी तुमू बुरहो किरहो, एने सेंका दिरहो नाय, ते नाह ज्य ओलोस किरहो, जो ज्या अंजीरान जाड़ा हेऱ्यो किरेल हे; पुण केदी ज्या बोयड़ाह बी किहो, काय उखेल जा, एने देरीयाम जाय पोड़, ते ज्यो एय जाय। <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />एने जो काय तुमू विन्ता माय बुरहो केरीन मांगहो तो सोब तुमूह जुड़ी।”<verse eid="MAT 21:22" /></para>
  <para style="s">यीशुन आदिकार पोर सावाल</para>
  <para style="r">(<ref loc="MRK 11:27-33">मरकुस 11:27-33</ref>; <ref loc="LUK 20:1-8">लुका 20:1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />यीशु मोंदिर माय जाईन हिक आपतालो, तेवी मुखी चाकऱ्या एने डायला माणहे तान जागे आवीन फुशा, “तु ज्य काम कुणीन आदिकार माय किरेह? एने तुवाह ज्यो आदिकार कुण आपेल?”<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />यीशु ताह जापाप आप्यो, “मी बी तुमूह एक वात फुसथो, केदी तो माहु किहो, ताहार मी बी केह काय ज्य काम कुणीन आदिकार माय केरथु। <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />योहानान बपतीस्मा का रेन एतो? हेरगा उगे रेन काय माणहा उगे रेन?”</para>
  <para style="p" vid="MAT 21:25">तेवी ता तान तान विचार केरने बाज गीया काय, केदी आपु केहु “हेरगान उगे रेन।” ताहार ज्‍यु आपुह केय काय, ओवता तुमू तान बुरहो काहा नाह केऱ्या? <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />एने केदी केहु माणहान उगे रेन, ताहार आपुह माणहान बिय हे, काहाकाय ता आखा योहानाह जाणकार मानतेह। <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />तेवी ता यीशुह केया, “आमुह नाह मालुम।”</para>
  <para style="p" vid="MAT 21:27">यीशु बी ताह केयो, ते ओवतो काल्ला आदिकार माय मी ज्य केरथु तो मी बी तुमूह केत नाह।<verse eid="MAT 21:27" /></para>
  <para style="s">दुय सोरान किस्सो</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />तुमूह काय सोमेजतेह, एक माणहान दुय सोरा एता; तु पेल्ला फाय जाईन किथे, “एय बेटा, आज तु अंगुरान वाड़ीम काम केर।” <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />तो जापाप आप्यो, “मी नाह जाण्यो” पुण पासाण रेन ताह पासतावो आवो एने तो गीयो। <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />पुशो दिहरा बेटाख फाय जाईन तो तिहेस केयो, तो जापाप आप्यो, “होव जाथु,” पुण नाह गीयो। <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />ज्या दुया माय रेन कुण आबाख ने मोरजी पुरी किऱ्यो?</para>
  <para style="p" vid="MAT 21:31">ता केया, “पिल्लो बिटोख।” मी तुमूह खेरीच केथु काय फालो लेणार, एने खाराब बायकु तुमूह रेन पेल बोगवानान राज माय आवतेह। <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />काहाकाय योहान खेरायीन वाटे रेन तुमरे फाय आयेल इतो, एने तुमू ता पोर बुरहो नाह केऱ्या, पुण फालो लेणार एने खाराब बायकु न्या ता पोर बुरहो केऱ्या, एने तुमू ज्य देखीन पासाण रेन बी नाह पासताना काय तान बुरहो केर लेता।<note caller="+" style="x"><char style="xo" closed="false">21:32 </char><char style="xt" closed="false"><ref loc="LUK 3:12">लुका 3:12</ref>; <ref loc="LUK 7:29-30">7:29-30</ref></char></note><verse eid="MAT 21:32" /></para>
  <para style="s">खाराब किरसाणान किस्सो</para>
  <para style="r">(<ref loc="MRK 12:1-12">मरकुस 12:1-12</ref>; <ref loc="LUK 20:9-19">लुका 20:9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />यीशु केयो, “उंजु एक किस्सो हुमलो, एक खेतान मालीक इतो, तो अंगुरान वाड़ी लागाड्यो, तान कावदेन वाड़ जेठी, एने ता माय रूहान केरता कुंडण्यो बाणायो; एने मालो बांद्यो, एने किरसाणाह तान ठिको आपीन दिहरा देसा माय जात रिनो।<note caller="+" style="x"><char style="xo" closed="false">21:33 </char><char style="xt" closed="false"><ref loc="ISA 5:1-2">यशाया 5:1-2</ref></char></note> <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />जेवी फोले पाक गीया तेवी तो फोल लेणेन केरता तान पावराह किरसाणा फाय मुकल्यो। <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />पुण किरसाण तान पावराह देरीन, थोड़ाक जाणाह देना, एने थोड़ाक जाणाह मार देना; एने थोड़ाक जाणाह देगड़ा केरीन देना। <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />तो पुशो जास्ती पावराह मुकल्यो, एने ता ता हेऱ्या बी तिहेस केऱ्या। <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />सेवली बुखेत तो तान बेटाख ता फाय ज्य किन मुकल्यो, काय ता मार बेटाख ने मान मेलती। <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />पुण किरसाण बेटाख देखीन तान तान केया ज्‍यु ते वोस हे, आवो, ज्याह मार देता एने ज्यान आखो मालदेन लेय लेता। <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />एने ता ताह देऱ्या एने अंगुरान वाड़ीम रेन बाहेर काड़ीन मार देना।” <figure style="fig" alt="Watchtower in a vineyard" file="hk00105c.tif" size="col" copy="Horace Knowles ©" ref="21:33">अंगुर ने वाड़ी माय मालो </figure><verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />केरीन यीशु ताह फुशो, “जुलबुखे अंगुरान वाड़ीन मालीक आवी, ते ता किरसाणा हिऱ्यो काय केरी।”<verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />तो खाराब माणहाह खेतेम केर देय, “एने अंगुरान वाड़ीन ठिको दिहरा किरसाणाह आप देय, जा टेम पोर कामाय आपती रेती।”<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />यीशु ताह केयो, तुमू केदी पुस्तेक माय ज्यो नाह वाच्‍या?<note caller="+" style="x"><char style="xo" closed="false">21:42 </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">बजन 118:22-23</ref></char></note></para>
  <para style="q1" vid="MAT 21:42">“जा देगड़ाह मिस्तऱ्या खाराब बिगेर कामान सोमजेल एता,</para>
  <para style="q2" vid="MAT 21:42">तोस दिगोड़ कोपरान देड़ान दिगोड़ बोण गीयो?</para>
  <para style="q1" vid="MAT 21:42">ज्य मालीकान उगे रेन एनो, एने आमरी नेजरी माय जुलूम मोठो हे।”<verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />केरीन मी तुमूह केथु, “बोगवानान राज तुमू फाय रेन विसाय जाय; एने ओहली जातीह जी तान फोल आपी, तीह तो आप देय। <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />जो ज्या देगड़ा पोर पोड़ी, तो चुरा चुरा वोल जाय; एने जा पोर पोड़ी, ताह देल देय।”<note caller="+" style="f"><char style="fr" closed="false">21:44 </char><char style="ft" closed="false">ज्यो वचन जुनाला पुस्तेक माय नाह सापेड़ने</char></note><verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />मुखी चाकऱ्या एने फरिसी तान किस्साह होमलीन सोमजी गीया काय ज्‍यु आमरास बाराम किथे। <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />एने ता ताह देरणे होदताला, पुण माणहाह देखीन बिय गीया; काहाकाय माणहे ताह जाणकार सोमेजताला।<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">वाराड़ान खाणान किस्सो</para>
  <para style="r">(<ref loc="LUK 14:15-24">लुका 14:15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />ज्या पोर रेन यीशु पुशो ताह किस्सा माय केणे बाज गीयो। <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />“हेरगान राज ता राजान गेत हे, जो तान सोरान वाराड़ान खाणो आप्यो। <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />एने तो तान एक पावरा फाय खुबेर ली मुकल्यो काय नेवताल्या माणहाह वाराड़ान खाणो खाणे हादाड़े; पुण ता नाह आवणे होद्या। <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />पुशो तो पावराह किन मुकल्यो, नेवताल्या माणहाह किवो: ‘मी खाणो तियार केर मेल्योह मार बुयेल एने पालेल जेनवार माराय जायेल हेते, आखो तियार हे वाराड़ा माय आवो।’ <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />पुण ता नाह होमल्या एने जात रेना काल्लाह खेता माय गीया एने काल्लाह काम केरने गीया। <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />दिहरा माणहे जा वुचेल एता, तान पावराह देरीन तान ईजुत उड़ाया एने मार देना। <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />तेवी राजाह राग आवो, एने तो तान सिपायड़ाह मोकलीन ता खुनीह माराव दिनो, एने तान गावाह हेलगाड़ दिनो। <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />तेवी तो तान पावराह केयो, वाराड़ान खाणो ते तियार हे, पुण हादिल माणहा हाजा नाह एता। <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />केरीन तुमू फाटा पोर जावु एने जोला बी माणहे जुड़ती तोलाह वाराड़ान खाणो खाणे हाद लावज्यो। <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />ता पावोर सेड़की पोर जाईन काय हाजाला काय बाकताला जोला बी सापेड़ना तोला आखाह टुलो केऱ्या; एने वाराड़ान गेरा माय पुरा बोराय गीया।”<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />जेवी राजा पावणाह देखणे माय आवो, तेवी तो ताहरी एक माणहाह दिख्यो, जो वाराड़ान फाड़का नाह पिरेल एतो। <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />तो ताह फुशो एय दोस्ती तु वाराड़ान फाड़का काहा नाह पेरीन आवो? तान मुय बोंद एय गीयो। <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" /><note caller="+" style="x"><char style="xo" closed="false">22:13 </char><char style="xt" closed="false"><ref loc="MAT 8:12">मत्ती 8:12</ref>; <ref loc="MAT 25:30">25:30</ref>; <ref loc="LUK 13:28">लुका 13:28</ref></char></note>तेवी राजा चाकऱ्याह केयो, “ज्यान आथ पाय बांदिन बाहेर आंदारा माय जुगार दिवो, ता रेड़णो, एने दात केकड़ावणे रेय।”<verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />काहाकाय हादिल ते जुलूम हेते, पुण निवाड़ेल थोड़ाच हेते।<verse eid="MAT 22:14" /></para>
  <para style="s">केसराह फालो आपणेन बाराम सावाल</para>
  <para style="r">(<ref loc="MRK 12:13-17">मरकुस 12:13-17</ref>; <ref loc="LUK 20:20-26">लुका 20:20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />तेवी फरिसी जाईन तान तान विचार केऱ्या, काय ताह किहीक वातु माय देरहु। <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />तेवी ता तान चेलाह हेरोदेस हेऱ्या यीशु फाय ज्य केणेन मोकल्या, “एय गुरू, आमु जाणतेह काय तु खिरो हे, एने बोगवानान वाट खेराय माय हिकाड़ने, एने कुणीन पारवाय नाह केरने, काहाकाय तु माणहान मुय देखीन वातु नाह केरने। <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />केरीन तु आमुह कि, तुवाह काय लागेह? केसराह फालो आपणे हाजो हे, काय नाह।”<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />पुण यीशु तान विचार जाणीन केयो, “एय कोपट्या, माहु काहा पारेखतेह? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />फालान एक रूपियो माहु देखाड़ो!”</para>
  <para style="p" vid="MAT 22:19">तेवी ता यीशु फाय एक रूपियो लेन आवा। <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />यीशु ताह फुशो, “ज्यो साप एने नाव कुणान हे?”<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />ता यीशुह केया, “केसरान,” तेवी यीशु ताह केयो, “जो केसरान हे, तो केसराह आपु; एने जो बोगवानान हे तो बोगवानाह आपु।”<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />ज्यो होमलीन ता बोंगलाय गीया, एने यीशुन जागे रेन जात रेना।<verse eid="MAT 22:22" /></para>
  <para style="s">पोशो जीव उठणो एने वाराड़</para>
  <para style="r">(<ref loc="MRK 12:18-27">मरकुस 12:18-27</ref>; <ref loc="LUK 20:27-40">लुका 20:27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />
    <note caller="+" style="x">
      <char style="xo" closed="false">22:23 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 23:8">प्रेरितान काम 23:8</ref>
      </char>
    </note>तीस दिह सदुकी जा मुरेल माय रेन पोशो जीव उठणो सोतोच नाह केणु ता यीशु फाय आवा एने ताह फुशा। <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />“एय गुरू, मुसो कियेल इतो, काय इखेह एदमी बिगेर सोरा ईयेल मोर जाय, ते तान बाहख तान बायकु हिऱ्यो वाराड़ केर लेय, तान बायाख ने केरता वोस पायदा केरी।<note caller="+" style="x"><char style="xo" closed="false">22:24 </char><char style="xt" closed="false"><ref loc="DEU 25:5">व्यवस्था 25:5</ref></char></note> <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />एवी आमरे न्या हात बाहख एता, पिल्लो वाराड़ उलोस केरीन मोर गीयो, एने तान सोरा बी नाह ईयेल एता, तानकेरता तान बायकुह बायाख वाटु मेल गीयो। <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />तिहेस केरीन दिहरो, एने तीसरो बी किऱ्यो एने हात बायाख हेऱ्यो वोर तिहेस एनो। <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />आखान पासाण ती बायकु बी मोर गियी <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />जीव उठणेन पासाण ती ता हात बायह्या माय रेन कुणीन लाडी बोणी? काहाकाय ती आखान लाडी बुणेल एती।”<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />यीशु ताह जापाप आप्यो, “तुमू वचन एने बोगवानान ताकेत नाह जाणते; ज्यानकेरीन बुल माय पोड़ रेनाह। <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />काहाकाय ता जीव उठेन वाराड़ नाय केरती नाह वाराड़ा माय आवती नाह वाराड़ माय होपाती, पुण हेरगा माय बोगवानान दुतान गेत रेती। <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />पुण मुरेल माणहान जीव उठणेन बाराम काय तुमू ज्य वचन नाह वाच्‍या जो बोगवान तुमूह कियेल; <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />‘मी अब्राहाम ने बोगवान, एने इसहाकान बोगवान, एने याकुबान बोगवान हे?’ तो मुरेल तान नाह, पुण जीवतालान बोगवान हे।”<verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />आखा माणहे यीशुन पारचार होमलीन बोंगलाय गीया।<verse eid="MAT 22:33" /></para>
  <para style="s">आखाम रेन मोटलो उकुम</para>
  <para style="r">(<ref loc="MRK 12:28-34">मरकुस 12:28-34</ref>; <ref loc="LUK 10:25-28">लुका 10:25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />जेवी फरिसी होमल्या काय यीशु सदुकीन बोलती बोंद केर दियेल हे, ते ता एकठा एना। <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />ता माय रेन एक देरेमगुरू पारेखणेन केरता ताह फुशो,<note caller="+" style="x"><char style="xo" closed="false">22:35 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">लुका 10:25-28</ref></char></note> <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“एय गुरू, कायदा माय रेन काल्लो उकुम मुठो हे?”<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />यीशु ताह केयो, “तु बोगवान आपणा मालीकाह तारो आखो मोन एने तारो आखो जीव एने तारी आखी बुद्दी केरीन मोंग केर।<note caller="+" style="x"><char style="xo" closed="false">22:37 </char><char style="xt" closed="false"><ref loc="DEU 6:5">व्यवस्था 6:5</ref></char></note> <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />मोटली एने मुखी उकुम ज्‍योस हे। <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />एने तान गेत ज्यो दिहरो बी हे, तु तार आहेंल्याह पोर तार गेत मोंग केर।<note caller="+" style="x"><char style="xo" closed="false">22:39 </char><char style="xt" closed="false"><ref loc="LEV 19:18">लेव्यवस्था 19:18</ref></char></note> <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" /><note caller="+" style="x"><char style="xo" closed="false">22:40 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">लुका 10:25-28</ref></char></note>ज्या दुय उकुम आखा कायदान एने जाणकारान आदार हेते।”<verse eid="MAT 22:40" /></para>
  <para style="s">मसीन बारामाय सावाल</para>
  <para style="r">(<ref loc="MRK 12:35-37">मरकुस 12:35-37</ref>; <ref loc="LUK 20:41-44">लुका 20:41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />जेवी फरिसी एकठा एता, ते यीशु ताह फुशो, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />“मसीन बाराम तुमू काय विचार केरतेह? तो कुणान बिटोख हे?” ता यीशुह केया, “दाऊदान।” <verse eid="MAT 22:42" /><verse number="43" style="v" sid="MAT 22:43" />यीशु ताह फुशो, ते दाऊद चोखाला जीवा माय बोरायीन ताह मालीक काहा किथे?<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />मालीक, मार मालीकाह केयो:<note caller="+" style="x"><char style="xo" closed="false">22:44 </char><char style="xt" closed="false"><ref loc="PSA 110:1">बजन 110:1</ref></char></note></para>
  <para style="q2" vid="MAT 22:44">“मारी जीवड़े उगे बोह,</para>
  <para style="q2" vid="MAT 22:44">जाह वोर काय मी तारा दुसमोनाह तारा पायान बुंदे नाय केर देव।<verse eid="MAT 22:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="MAT 22:45" />हाजो, जेवी दाऊद ताह मालीक किथे, ताहार तो तान बिटोख किहीक ठेरावनो?”<verse eid="MAT 22:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46" />ज्यान जापाप माय काईच बी एक वात नाह केय सीक्‍यो। ते दिह रेन कुण बी पोशो ताह काय फुसणेन ईमोत नाह केऱ्या।<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">देरेमगुरू एने फरिसीह रेन चेकचेल्या रिवो</para>
  <para style="r">(<ref loc="MRK 12:38-39">मरकुस 12:38-39</ref>; <ref loc="LUK 11:43">लुका 11:43</ref>,<ref loc="LUK 11:46">46</ref>; <ref loc="LUK 20:45">20:45</ref>,<ref loc="LUK 20:46">46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />तेवी यीशु गेरदीह एने तान चेलाह केयो, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />देरेमगुरू एने फरिसी मुसान गादि पोर बोह रेनाह; <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />तानकेरता ता तुमूह जो काय केती, तो किरज्‍यो, एने मानज्यो, पुण तान गेत काम मा किरहो; काहाकाय ता केतेह, पुण केरते नाह। <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />ता एक उहलो बारो बांदिन माणहान खादा पोर मेल देतेह, पुण जीवे तान आंगली केरीन बी हेरकावणे नाह होदते। <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" /><note caller="+" style="f"><char style="fr" closed="false">23:5 </char><char style="ft" closed="false">तान फाड़कान कुर बोगवानान प्रती तान बुरहो देखाड़ेह</char></note>ता तान सोब काम माणहाह देखाड़णेन केरता केरतेह: ता तान ता बिजाह चोवड़ो केरनु, एने तान फाड़कान कुर वोदाड़तेह!<note caller="+" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="MAT 6:1">मत्ती 6:1</ref>; <ref loc="NUM 15:38">गिनती 15:38</ref>; <ref loc="DEU 6:8">व्यवस्था 6:8</ref></char></note> <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />खाणे बुखेत खास खास जागो एने बोक्ती केरन्या गेरा माय ओंगाण खास खास जागी बोहणो। <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />आटा माय नमस्‍कार, एने माणहा माय रब्बी केवाड़णेन ताह हाजो लागणे। <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />पुण तुमू रब्बी मा केवाड़हो, काहाकाय तुमरो एकुस मालीक हे, एने तुमू सोब बाय बोणहा हेते। <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />एने देरती पोर कुणीह बी आपणो आबोख मा किहो, काहाकाय तुमरो एकुच आबोख हे; जो हेरगा माय हे। <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />एने मालीक बी मा, केवाहो, काहाकाय तुमरो एकुच मालीक हे, मतलब मसी। <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" /><note caller="+" style="x"><char style="xo" closed="false">23:11 </char><char style="xt" closed="false"><ref loc="MAT 20:26">मत्ती 20:26</ref>,<ref loc="MAT 20:27">27</ref>; <ref loc="MRK 9:35">मरकुस 9:35</ref>; <ref loc="MRK 10:43">10:43</ref>,<ref loc="MRK 10:44">44</ref>; <ref loc="LUK 22:26">लुका 22:26</ref></char></note>जो तुमरे माय मुठो हे, तो तुमरो पावोर बोणी। <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" /><note caller="+" style="x"><char style="xo" closed="false">23:12 </char><char style="xt" closed="false"><ref loc="LUK 14:11">लुका 14:11</ref>; <ref loc="LUK 18:14">18:14</ref></char></note>जो कुण सोताह मोठो बाणावी, तो आत्यो एय जाय एने जो कुण सोताह बोलो बाणावी, तो मोठो केवाय।<verse eid="MAT 23:12" /></para>
  <para style="s">देरेमगुरू एने फरिसी पोर हाय</para>
  <para style="r">(<ref loc="MRK 12:40">मरकुस 12:40</ref>; <ref loc="LUK 11:39-42">लुका 11:39-42</ref>,<ref loc="LUK 11:44">44</ref>,<ref loc="LUK 11:52">52</ref>; <ref loc="LUK 20:47">20:47</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />एय कोपटी देरेमगुरू एने फरिसी तुमरे पोर हाय। तुमू माणहान केरता हेरगान राज ने बायणो बोंद केरतेह, नाहते सोता ता माय रिगतेह, नाहते ता माय रिगणाराह रिगणे देतेह। <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" /><note caller="+" style="f"><char style="fr" closed="false">23:14 </char><char style="ft" closed="false">थोड़ाक लेख माय ज्यो वचन नाह सोतो, मरकुस 12:40।</char></note> “एय कोपटी देरेमगुरू एने फरिसी, तुमरे पोर हाय! तुमू रांडायेल बायकुन गेराह खाय जातेह, एने देखाड़णेन केरता मोकतीस वार वोर विन्ता किरते रेतेह, तान केरता तुमूह होवटोह डेंड जुड़ी।”<verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />एय कोपटी देरेमगुरू एने फरिसी तुमू पोर हाय। तुमू एक जाणाह तुमरी उगे लावणेन केरता आखो पाणी एने बुय माय फिरतेह, एने जेवी तो तुमरी उगे आव जाथे, ते ताह तुमूह रेन दुय गुणा नेरगान लायेक बाणाव देतेह।<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />एय आंदला वाट देखाड़नारे, तुमरे पोर हाय! जा केतेह काय केदी कुण बी मोंदिराम सुगोण खाय ते काय नाह, पुण कुण बी मोंदिरान होनान सुगोण खाय ते, ता हेऱ्यो बांदाय जाय। <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />“एय फोगा एने आंदला, कुण मोठो हे; होनो काय ती मोंदिर जा माय होनो चोखो रिथे। <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />पोशा केतेह काय केदी कुण बी वेदीन सुगोण खाय ते काय नाह, पुण जो बेट चेड़ायेल ता पोर हे, केदी कुण तान सुगोण खाथे ताहार बांदाय जाथे। <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />एय आंदला कुण मोठो हे; बेट काय वेदी जाह रेन बेट चोखो रिथे। <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />ज्यानकेरता जो वेदीन सुगोण खाथे तो तान, एने जो काय ता पोर हे, तान बी सुगोण खाथे। <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />जो मोंदिरान सुगोण खाथे, तो तान एने ता माय रेणारा बोगवानान बी सुगोण खाथे। <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />जो हेरगान सुगोण खाथे, तो बोगवानान राजगादिन एने ता पोर बी सुगोण खाथे।<note caller="+" style="x"><char style="xo" closed="false">23:22 </char><char style="xt" closed="false"><ref loc="ISA 66:1">यशाया 66:1</ref>; <ref loc="MAT 5:34">मत्ती 5:34</ref></char></note><verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />“एय कोपट्या देरेमगुरू एने फरिसी तुमरे पोर हाय। तुमू पुदीना, बड़ीशोब एने जिरान दाहवो ईसो आपतेह पुण तुमू कायदान हाजाली वातुह मतलब नियाव एने किव, एने बोरहाह सोड़ दियेल हेते; जोवतालो काय ज्यु वातुह बी मानता एने नाय सोड़ता।<note caller="+" style="x"><char style="xo" closed="false">23:23 </char><char style="xt" closed="false"><ref loc="LEV 27:30">लेव्यवस्था 27:30</ref></char></note> <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />एय आंदला जाणकारे तुमू चाचड्याह मोहदेल देतेह, पुण उटड़ाह गिल जातेह।<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />“एय कोपट्या देरेमगुरू, एने फरिसी तुमरे पोर हाय। तुमू वाटकी एने तेलीह उपेर उपेर रेन चोलतेह, पुण माय रेन त्यी आदाऱ्य एने सोतान लालुच माय बोरायेल हेत्यु। <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />एय आंदला फरिसी पेल वाटकी एने तेलीह माय रेन उजालो, ते त्यु बाहेर रेन बी साप रेती।<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />
    <note caller="+" style="x">
      <char style="xo" closed="false">23:27 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 23:3">प्रेरितान काम 23:3</ref>
      </char>
    </note>“एय देरेमगुरू, एने फरिसी कोपट्या तुमरे पोर हाय, तुमू चुनो लागाड़ील माहणान गेत हेते, जो उपेर रेन ते हाजो देखाथे, पुण माय मुरेल माणहान आड़े एने आखी बातीन गाण माय बुरेल हे। <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />ज्‍यीस रिती माय तुमू बी उपेर रेन माणहाह खेरला देखातेह, पुण माय रेन कोपेट एने खाराबपोणा माय बोराय रेनाह।<verse eid="MAT 23:28" /></para>
  <para style="s">देरेमगुरू एने फरिसी पोर डेंड ने जाणाव</para>
  <para style="r">(<ref loc="LUK 11:47-51">लुका 11:47-51</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />“एय देरेमगुरू एने फरिसी कोपट्या तुमरे पोर हाय। तुमू जाणकारान माहाण हिगारणु एने खेरला माणहान माहणे बोणावणु, <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />एने केतेह, काय केदी आमु आमरा डायडायान दिह्या माय रेता ताहार जाणकारान खुना माय तान हाती नाय रेता। <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />इहकेरीन ते तुमू सोता पुरावो देतेह, काय तुमू जाणकारान खुनीन बेठहेक हेते। <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />तुमू तुमरा डायडायान पापान कुंडो आखो बोर दिवो। <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" /><note caller="+" style="x"><char style="xo" closed="false">23:33 </char><char style="xt" closed="false"><ref loc="MAT 3:7">मत्ती 3:7</ref>; <ref loc="MAT 12:34">12:34</ref>; <ref loc="LUK 3:7">लुका 3:7</ref></char></note>एय गेड़हान सोरा, तुमू नेरगान डेंडाह रेन किहीक वोचहो? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />तानकेरता दिखो, मी तुमू फाय जाणकाराह एने ईकेलवालाह एने देरेमगुरूह मोकेलथु; एने तुमू ता माय रेन थोड़ाक जाणाह खुरूसखाम पोर चेड़ावहो, एने थोड़ाक जाणाह मार दिहो, एने थोड़ाक जाणाह तुमरा मोंदिरा माय चापका दिहो, एने एक गावा माय रेन दिहरा गावा माय दोवड़ावते ली फिरहो। <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />ज्यानकेरता देरमी हाबीलाह रेन ते बिरीक्यान बिटोख जकरीया वोर, जाह तुमू मोंदिर एने वेदीन विची माय मार दियेल एता, जोला खेरलान लुय देरती पोर वोय जायेल हे, ती सोब तुमरी मुंडी पोर पोड़ी।<note caller="+" style="x"><char style="xo" closed="false">23:35 </char><char style="xt" closed="false"><ref loc="GEN 4:8">उत्पत्ती 4:8</ref>; <ref loc="2CH 24:20-21">2 इतिहास 24:20-21</ref></char></note> <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />मी तुमूह खेरीच केथु, ज्‍यु सोब वातु ज्या कालान माणहा पोर आव पोड़ती।<verse eid="MAT 23:36" /></para>
  <para style="s">यरूशलेम ने केरता मोंग</para>
  <para style="r">(<ref loc="LUK 13:34-35">लुका 13:34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />“एय यरूशलेम, एय यरूशलेम; तु जो जाणकाराह मार टाकेह, एने जाह तुवा फाय मोकलेल, ताह देगड़ाठेल, जोली बी वार मी विचार किरेल काय जीहे कुकड़ी तीन पिलाह फाका बुंदे टुलो किरेह, तिहेस मी बी तारा सोराह टुलो केर लेव, पुण तुमू नाह विचार केऱ्या। <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />दिखो, तुमरो गेर तुमरी केरता उजाड़ सुड़ेल हे।<note caller="+" style="x"><char style="xo" closed="false">23:38 </char><char style="xt" closed="false"><ref loc="JER 22:5">यिर्मया 22:5</ref></char></note> <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />काहाकाय मी तुमूह खेरीच केथु काय एवी रेन जाह वोर तुमू किहो नाय, ‘बोरकेतवालो हे, जो मालीक ने नाव माय आवीह,’ ताह वोर तुमू माहु पोशा केदी नाय दिखहो।”<note caller="+" style="x"><char style="xo" closed="false">23:39 </char><char style="xt" closed="false"><ref loc="PSA 118:26">बजन 118:26</ref></char></note><verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">मोंदिर खेतेम एणेन जाणाव</para>
  <para style="r">(<ref loc="MRK 13:1-2">मरकुस 13:1-2</ref>; <ref loc="LUK 21:5-6">लुका 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />जेवी यीशु मोंदिर माय रेन निकलीन जातालो, ते तान चेला ताह मोंदिरान आवाली देखाड़नेन केरता जागे आवा। <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />तेवी यीशु चेलाह किथे, “तुमू ज्य आखो देखतेह ने मी तुमूह खेरीच केथु, न्या देगड़ा पोर दिगोड़ नाय पोड़ी जाह पाड़ती नाय।”<verse eid="MAT 24:2" /></para>
  <para style="s">तेकलीत एने सेताव</para>
  <para style="r">(<ref loc="MRK 13:3-13">मरकुस 13:3-13</ref>; <ref loc="LUK 21:7-19">लुका 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />जेवी यीशु जेतुन बोयड़ा पोर बोह रियेल इतो, ते चेला ठावकास यीशु फाय आवीन केतेह, “आमुह कि काय ज्यी वातु केवीह एती? तारो आवणेन एने देरतीह खेतेम एणेन काय निसाणी रेय।”<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />यीशु ताह जापाप आप्यो, “होमालीन रिवो कुण तुमूह फासाड़ने नाय जुवे। <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />काहाकाय जुलूम ओहला रेती, जा मारो नाव लेन आवीन केती, ‘मी मसी हे!’ एने मोकतास जाणाह खोवाड़ती। <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />तुमू लेड़ाय एने लेड़ाय ने वात होमेलहो ताहार बिय मा जाहो, काहाकाय ज्य ते एण्योच हे, पुण तुलबूखेच खेतेम नाय एय। <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />काहाकाय देसा पोर देस एने राज पोर राज उठ बोही, एने जागा जागा काल पोड़ती, एने बुकम्प एती। <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />ज्यी आख्‍यु वातु पिढान सुरवात रेती।”<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">24:9 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:22">मत्ती 10:22</ref>
      </char>
    </note>तेवी ता तेकलीत आपणेन केरता तुमूह देराव देती, एने तुमूह मार टाकती एने मार नावान कारेण आखा देसान माणहे तुमू हेऱ्या दुसमोनाय केरती। <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />तेवी मोकतास माणहे ठोकरा खाती, एने एका दिहराह देराव देती, एने एका दिहरा हेऱ्या विरोद केरती। <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />मोकतास जुठा जाणकार उठ बोहती, एने मोकतास माणहान मोन बोटकावती। <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />एदेरमो वोड़ने से मोकतास माणहान मोंग ठेंडो पोड़ जाय, <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" /><note caller="+" style="x"><char style="xo" closed="false">24:13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">मत्ती 10:22</ref></char></note>पुण जा सेवली बुखे वोर दिर खाती रेती, ताच ने सुटकारो एय। <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />एने राज ने ज्यी हाजाली खुबेर आखी देरती पोर पारचार एय जाय। काय आखी जाती पोर गोवाय रेय, तेवी सेवल्यो टेम आव जाय।<verse eid="MAT 24:14" /></para>
  <para style="s">मोटली तेकलीत सुरवात</para>
  <para style="r">(<ref loc="MRK 13:14-23">मरकुस 13:14-23</ref>; <ref loc="LUK 21:20-24">लुका 21:20-24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />ज्यानकेरता तुमू ती उजेड़णार खाराब चिज जीन वात दानिएल जाणकारान द्‍वारे ईयेल एती, चोखाली जागे उबरियेल दिख्यो, “जो वाची तो सोमजी।”<note caller="+" style="x"><char style="xo" closed="false">24:15 </char><char style="xt" closed="false"><ref loc="DAN 9:27">दानिएल 9:27</ref>; <ref loc="DAN 11:31">11:31</ref>; <ref loc="DAN 12:11">12:11</ref></char></note> <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />तेवी जा यहुदिया माय रेती ता, बोयड़ा माय नाह जाया। <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" /><note caller="+" style="x"><char style="xo" closed="false">24:17 </char><char style="xt" closed="false"><ref loc="LUK 17:31">लुका 17:31</ref></char></note>जा दाबा पोर रेती ता तान गेरा माय रेन सामान लेणेन केरता नाय उतरी। <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />एने जा खेता माय रेती, ता तान फाड़का लेणेन केरता पासाण नाय वोलती।<note caller="+" style="x"><char style="xo" closed="false">24:18 </char><char style="xt" closed="false"><ref loc="LUK 17:31">लुका 17:31</ref></char></note><verse eid="MAT 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 24:19" />ता दिह्या माय जी पेटावाली एने आतल्या सोराह बुजो खावाड़तेय, त्युन केरता हाय, हाय! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />एने बोगवाना फाय विन्ता किरते रिवो काय तुमूह ईवाला माय विहेवणेन दिह नाहणे नाय पोड़ी। <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />काहाकाय तुलबूखे उहलो मोटलो तेकलीत रेय, जोहलो देरतीन पेल रेन एवी वोर नाह एनो एने नाय केदी एय।<note caller="+" style="x"><char style="xo" closed="false">24:21 </char><char style="xt" closed="false"><ref loc="DAN 12:1">दानिएल 12:1</ref>; <ref loc="REV 7:14">प्रकाशितवाक्य 7:14</ref></char></note> <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />केदी ता दिह कोम नाय एता, ते काल्लोस जेनवार नाय वोचतो, पुण जा निवाड़ेल हेते, तान कारेण ता दिह कोम एय जाती।<verse eid="MAT 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23" />तुलबूखे केदी इखेह तुमूह केय दिखो, मसी न्या हे, नाहते ता हे, ते बुरहो मा किरहो।<verse eid="MAT 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 24:24" />काहाकाय जुठा मसी एने जुठा जाणकार उठ बोहती, एने मोटली निसाणी, एने बोंगलाड़ टाके ओहला कामे देखाड़ती काय केदी एय सेकी ते निवाड़ेलाह बी खोवाड़ देती। <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />दिखो, मी तुमूह पेलुच रेन ज्य सोब केय दिनोह।<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />तानकेरता केदी ता तुमूह केती, तो जेंगला माय हे; बाहेर मा निकेल जाहु; नाहते दिखो, तो गेरा माय हे, ते बुरहो मा किरहो।<note caller="+" style="x"><char style="xo" closed="false">24:26 </char><char style="xt" closed="false"><ref loc="LUK 17:23-24">लुका 17:23-24</ref></char></note><verse eid="MAT 24:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 24:27" />काहाकाय जिहकेरीन विज जीहे दिह उगता उगे रेन निकलीन दिह बुड़ता उगे वोर विजलेह, तिहेस माणहान बेटाख ने बी आवणो रेय।<note caller="+" style="x"><char style="xo" closed="false">24:27 </char><char style="xt" closed="false"><ref loc="LUK 17:23-24">लुका 17:23-24</ref></char></note> <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" /><note caller="+" style="x"><char style="xo" closed="false">24:28 </char><char style="xt" closed="false"><ref loc="LUK 17:37">लुका 17:37</ref></char></note>जाहरी देड़ रिथे, ताच मोराग्या टुलो एती।<verse eid="MAT 24:28" /></para>
  <para style="s">माणहान बेटाख ने पोशो आवणो</para>
  <para style="r">(<ref loc="MRK 13:24-27">मरकुस 13:24-27</ref>; <ref loc="LUK 21:25-28">लुका 21:25-28</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />ता दिह्या माय सेताव ने पासाण तुलेचबूखे दिह आदारो एय जाय, एने चांदान उजेड़ जात रेय, एने तारा जुगाम रेन बुई पोर आव पोड़ती एने जुगान ताकेत आलाड़ाय जाय।<note caller="+" style="x"><char style="xo" closed="false">24:29 </char><char style="xt" closed="false"><ref loc="ISA 13:10">यशाया 13:10</ref>; <ref loc="ISA 34:4">34:4</ref>; <ref loc="EZK 32:7">यहेजकेल 32:7</ref>; <ref loc="JOL 2:10">योएल 2:10</ref>,<ref loc="JOL 2:31">31</ref>; <ref loc="JOL 3:15">3:15</ref>; <ref loc="REV 6:12-13">प्रकाशितवाक्य 6:12-13</ref></char></note> <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" />तेवी माणहान बेटाख ने निसाणी वादला माय देखाय, एने तेवी देरतीन आखा जातीन माणहे साती ठोकती; एने माणहान बेटाख मोटली ताकेत एने बोड़ाय हिऱ्यो जुगान वादला पोर आवतालो देखती।<note caller="+" style="x"><char style="xo" closed="false">24:30 </char><char style="xt" closed="false"><ref loc="DAN 7:13">दानिएल 7:13</ref>; <ref loc="ZEC 12:10-14">जकर्‍या 12:10-14</ref>; <ref loc="REV 1:7">प्रकाशितवाक्य 1:7</ref></char></note> <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />तो पावलान सोबदा हिऱ्यो तान हेरोगदुताह मुकल्यो, एने ता वादलान ज्यी उगे रेन ती उगे वोर चार उगे रेन तान निवाड़ेल माणहाह एकठा केरती।<verse eid="MAT 24:31" /></para>
  <para style="s">अंजीर ने जाड़ान किस्सो</para>
  <para style="r">(<ref loc="MRK 13:28-31">मरकुस 13:28-31</ref>; <ref loc="LUK 21:29-33">लुका 21:29-33</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />अंजीरान जाड़ा पोर रेन ज्यो किस्सो हिको; जेवी तान डाल कोमाय जाथे एने डाले हेहड़ी जातेह, ते तुमू सोमजी जातेह काय हियालो आहने हे। <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" /><note caller="+" style="f"><char style="fr" closed="false">24:33 </char><char style="ft" closed="false">टेम आहने आवणे बाजरेनोह, सुरू एणे वालो हे, नाहते आहने हे, आवणेन केरता तियार हे</char></note> तिहेच केरीन जेवी तुमूह ज्यु आख्‍यु वातुह दिखहो ताहार सोमजी जाज्यो काय तो आहने हे, एने बायणा पोर हे। <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />मी तुमूह खेरीच केथु काय जाह वोर ज्यी आख्‍यु वातु पुऱ्यू नाय एय जाती, ताह वोर ज्यी पिढी खेतेम नाय एय। <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />जुग एने देरती टेल जाय, पुण मार वचन केदी नाय टेली।<verse eid="MAT 24:35" /></para>
  <para style="s">जाकता रिवो</para>
  <para style="r">(<ref loc="MRK 13:32-37">मरकुस 13:32-37</ref>; <ref loc="LUK 17:26-30">लुका 17:26-30</ref>,<ref loc="LUK 17:34-36">34-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />ते दिह एने तुलबूखेन बाराम कुण नाह जाणेत; नाह हेरगान हेरोगदुत एने नाह बिटोख,<note caller="+" style="f"><char style="fr" closed="false">24:36 </char><char style="ft" closed="false">थोड़ाक लेख माय बेटाख बी नाह लिखेल सोतो। </char></note> पुण आबोख उलोस। <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />जिहकेरीन नोहान दिह्या माय ईयेल एतो, तिहेच केरीन माणहान बेटाख ने आवणो बी एय।<note caller="+" style="x"><char style="xo" closed="false">24:37 </char><char style="xt" closed="false"><ref loc="GEN 6:5-8">उत्पत्ती 6:5-8</ref></char></note> <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />काहाकाय जीहे वादोण पाण्याह रेन पेल्ला दिह्या माय जेदिह वोर नुहो डोंडह्या माय नाह बुठो, ते दिह वोर माणहे खाते पिते रेना एने ता माय वाराड़ ईती रेनो। <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />एने जाह वोर वादोण पाणी आवीन ता आखाह वोयाड़ नाह ली गीयो, ताह वोर ताह काईच बी मालुम नाह पोड़नो; तिहेस माणहान बेटाख ने बी आवणो रेय।<note caller="+" style="x"><char style="xo" closed="false">24:39 </char><char style="xt" closed="false"><ref loc="GEN 7:6-24">उत्पत्ती 7:6-24</ref></char></note> <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />तुलबूखे दुय खेता माय रेती; ता माय रेन एक विसाय जाय एने दिहरो रेय जाय। <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />दुय बायकु गेरटी देलने बाज रेती, त्यु माय रेन एक विसाय जाय एने दिहरीह सोड़ देय। <verse eid="MAT 24:41" /><verse number="42" style="v" sid="MAT 24:42" />तानकेरता जाकता रिवो, काहाकाय तुमू जाणते नाह काय तुमरो मालीक काल्ले दिह आवी।<verse eid="MAT 24:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 24:43" />पुण ज्य जाण लिवो काय केदी गेरान मालीक जाणतो काय चोर कुलबुखे आवण्यो हे, ते जागतो रितो, एने तान गेर लुटणे नाय दितो।<note caller="+" style="x"><char style="xo" closed="false">24:43 </char><char style="xt" closed="false"><ref loc="LUK 12:39-40">लुका 12:39-40</ref></char></note> <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />तानकेरता तुमू बी तियार रिवो, काहाकाय ज्यी टेम माय तुमू विचार नाय केरती, ती टेम माय माणहान बिटोख आव लागी।<verse eid="MAT 24:44" /></para>
  <para style="s">बोरहावालो पावोर एने खाराब पावोर</para>
  <para style="r">(<ref loc="LUK 12:41-48">लुका 12:41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />बोरहावालो एने ईकेलवालो पावोर कुण हे, जाह मालीक तान पावरा पोर सरदार ठेरायेल काय ताह खाणो आपी? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />बोरकेतवालो हे तो पावोर, जाह तान मालीक आवीन तिहेस केरताला देखी। <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />मी तुमूह खेरीच केथु तो ताह सोब मालदेना पोर आदिकारी ठेरावी। <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />पुण केदी तो खाराब पावोर मोना माय सोचणे बाज जाय काय मार मालक्याह आवणेन उंजु जुलूम वार हे, <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />एने तान हातीन पावराह देणे बाज जाय, एने पिणारा हिऱ्यो खाय पिय। <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />ते ता पावरान मालीक ओहले दिह आवी, जेदिह तो तान आवणेन वाट बी निहे जोवतेय, एने जान ताह खुबेर बी निहे एय, <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" /><note caller="+" style="f"><char style="fr" closed="false">24:51 </char><char style="ft" closed="false">तान टुकड़ा टुकड़ा किर दिवो, नाहते बाहेर जुगार दिवो।</char></note>तेवी तो ताह डेंड सेजा देय, एने तान ईसो कोपट्या हिऱ्यो ठेरावी; ता रेड़णो एने दात केकड़ावणे रेय।<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">दोह कुवाऱ्युन किस्सो</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">25:1 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 12:35">लुका 12:35</ref>
      </char>
    </note>तेवी हेरगान राज त्यु दोह कुवाऱ्युन गेत रेय, ज्यु दिवा लेन वोवड़ाह मिलनेन निकेलन्यु। <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />त्युम रेन पाच फोग्यु एने पाच सोमेजदार एत्यु। <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />त्यु फोग्यु त्युन दिवा ते लेद्यु, पुण आरही तेल नाह लेद्यु; <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />पुण सोमेजदार त्युन दिवा हेऱ्यु सिसी माय तेल बी बोर लेद्यु। <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />जेवी वोवड़ाह आवणेन वार लाग गियी, ते त्यु आख्‍यु जोपणे बाज गीयो, एने हुव गीयो।<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />आदि राती ओहली पुकार पोड़नी, “वोवड़ो आवणे बाजरिनोह, ताह मिलणेन केरता चालो।” <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />तेवी त्यु आख्‍यु कुवाऱ्यु उठेन त्युन दिवा हुदारने बाज गीयु। <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />एने फोग्यु सोमेजदाऱ्युह केयु, “तुमरा तेला माय रेन थोड़ोक आमुह बी आपो, काहाकाय आमरा दिवा ओलाणे केरतेह।” <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />पुण सोमेजदाऱ्यु जापाप आप्यो, “ज्य आमरी एने तुमरी केरता पुरो नाय एय; हाजो ते ज्यो हे काय तुमू वेचणारा फाय जाईन तुमरी केरता वेचातो लेन आवो। <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />जेवी त्यु वेचातो तेल लेणेन जाणे बाजरियेल एत्युन वोवड़ो आव गीयो, एने ज्‍यु तियार एत्यु, त्यु ता हेऱ्यु वाराड़ान गेरा माय जात रेन्यु, एने बायणो बोंद एय गीयो।”<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">25:11 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 13:25">लुका 13:25</ref>
      </char>
    </note>पासाण रेन त्यु कुवाऱ्यु बी आवीन केत्युह, “एय मालीक, एय मालीक, आमरे केरता बी बायणो उगाड़ दे।” <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />पुण वुवड़ो जापाप आप्यो, “मी तुमूह खेरीच केथु, मी तुमूह उलखेत नाह।”<note caller="+" style="x"><char style="xo" closed="false">25:12 </char><char style="xt" closed="false"><ref loc="LUK 13:25">लुका 13:25</ref></char></note><verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />तानकेरता जाकता रिवो, काहाकाय तुमू नाहते ता दिह्याह जाणते, नाहते तुलबूखेन टेमाह।<note caller="+" style="x"><char style="xo" closed="false">25:13 </char><char style="xt" closed="false"><ref loc="MRK 13:36">मरकुस 13:36</ref></char></note><verse eid="MAT 25:13" /></para>
  <para style="s">तीन पावरान किस्सो</para>
  <para style="r">(<ref loc="LUK 19:11-27">लुका 19:11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">25:14 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 19:11-27">लुका 19:11-27</ref>
      </char>
    </note>काहाकाय ज्य ता माणहान गेत हे, जो दिहरा देसा माय जाणे बुखेत तान पावराह हादिन तान मालदेन ताह होप देणे। <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />तो एकाह पाच एजार होनान सिक्का, दिहराह दुय एजार एने तिसराह एक एजार, मतलब एकेकाह तान ताकेतीन ईसाब माय आप्यो, एने तेवी तो दिहरा देसा माय जात रिनो। <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />तेवी जाह पाच एजार होनान सिक्का जुड़ेल एता, तो तुलेचबूखे जाईन ता पोयशान लेन देन केऱ्यो, एने उंजु पाच एजार कामाव लेदो। <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />तिहेच केरीन जाह दुय एजार होनान सिक्का जुड़ेल एता, तो बी उंजु दुय एजार कामाव लेदो। <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />पुण जाह एक एजार होनान सिक्का जुड़ेल एता, तो जाईन खाडो खुद्यो, एने तान मालक्यान मालदेन लिकाड़ दिनो। <figure style="fig" alt="Talents" file="hk00168c.tif" size="col" copy="होनान सिक्को" ref="25:15">होनान सिक्को</figure><verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />मोकतास दिह्यान पासाण ता पावरान मालीक पुशो आवीन ता फाय ईसाब लिथे। <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />जाह पाच एजार होनान सिक्का जुड़ेल एता, तो पाच एजार उंजु लावीन केयो, “एय मालीक, तु माहु पाच एजार होनान सिक्का हुपेल इतो, देख, मी पाच एजार उंजु कामायेल हे।” <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />तान मालीक ताह केयो, “जुलूम हाजो हे, हाजो एने ईमानदार पावोर तु थोड़ाच माय ईमानदार रिनो, मी तुवाह जुलूम मालदेनान आदिकारी बाणावुह। तु तारा मालक्यान खुसी माय मिलाय जा।” <verse eid="MAT 25:21" /><verse number="22" style="v" sid="MAT 25:22" />एने जाह दुय एजार होनान सिक्‍का जुड़ेल एता, तो बी आवीन केयो, “एय मालीक, तु माहु दुय एजार होनान सिक्‍का होपेल इतो, देख, मी बी दुय एजार उंजु कामायेल हे।” <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />तान मालीक ताह केयो, जुलूम हाजो हे, हाजो एने बोरहावालो पावोर, तु थोड़ाच माय बोरहावालो रिनो, मी तुवाह जुलूम मालदेनान आदिकारी बाणावुह, तारा मालक्यान खुसी माय मिलाय जा। <verse eid="MAT 25:23" /><verse number="24" style="v" sid="MAT 25:24" />तेवी जाह एक एजार होनान सिक्का जुड़ेल एता, तो आवीन केयो, एय मालीक, मी तुवाह जाणतालो काय तु वातड़ो माणुह हे, तु जा का नाह पेरने तास काटणे, एने जा पोसार ने नाह ता रेन टुलो केरने। <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />तानकेरता मी बिय जायेल एने जाईन तारो मालदेन माटड्या माय लिकाड़ दियेल, “देख, जो तारो हे, तो ज्यो हे।” <verse eid="MAT 25:25" /><verse number="26" style="v" sid="MAT 25:26" />तान मालीक ताह जापाप आप्यो, “एय खाराब एने आलह्या पावोर, जेवी तु ज्य जाणतालो काय जा मी नाह पिऱ्यो ता रेन काटणे, एने जा मी पोसरायेल नाह ता रेन टुलो केरने। <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />ते तु मार पोयशा होवकारा फाय मेल देणु एतो। तेवी मी आवीन वियाजतोज ता फाय रेन लेय लितो। <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />तानकेरता ता एजार होनान सिक्का ता फाय रेन लेय लिवो, एने जा फाय दोह एजार होनान सिक्का हेते, ताह आप दिवो। <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" /><note caller="+" style="x"><char style="xo" closed="false">25:29 </char><char style="xt" closed="false"><ref loc="MAT 13:12">मत्ती 13:12</ref>; <ref loc="MRK 4:25">मरकुस 4:25</ref>; <ref loc="LUK 8:18">लुका 8:18</ref></char></note>काहाकाय जा कुणा फाय हे, ताह उंजु जुड़ी, एने ता फाय जुलूम एय जाय; पुण जा फाय नाह सोतो ता फाय रेन तो बी जो ता फाय हे, सांडाड़ाय जाय। <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" /><note caller="+" style="x"><char style="xo" closed="false">25:30 </char><char style="xt" closed="false"><ref loc="MAT 8:12">मत्ती 8:12</ref>; <ref loc="MAT 22:13">22:13</ref>; <ref loc="LUK 13:28">लुका 13:28</ref></char></note>एने ज्या खाराब पावराह बाहेर आंदारा माय जुगार दिवो, ता रेड़णो एने दात केकड़ावणे हे।”<verse eid="MAT 25:30" /></para>
  <para style="s">सेवल्यो नियाव</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />
    <note caller="+" style="x">
      <char style="xo" closed="false">25:31 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:27">मत्ती 16:27</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="MAT 19:28">मत्ती 19:28</ref>
      </char>
    </note>जेवी माणहान बिटोख तान बोड़ाय माय आवी, एने आखा हेरोगदुत ता हेऱ्या आवती, ते तो तान बोड़ाय ने राजगादि पोर बोही, <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />एने आखा देसान माणहे तान सोमोर टुलो एय जाती; एने जीहे गोवाल मेंड्राह बोकड्या माय रेन आंगे केर दिथे, तिहेस तो ताह एका दिहराह रेन आंगे केरी। <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />तो मेंड्राह तान जीवड़े उगे एने बोकड्याह डाखरे उगे उबो केरी।<note caller="+" style="f"><char style="fr" closed="false">25:33 </char><char style="ft" closed="false">मेंड्रा एने बोकड्यान मतलब खेरला माणहे</char></note> <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />तेवी राजा तान जीवड़े उगे वालाह केय, “एय मार आबाख ने बोरकेतवाला माणहे, आवो, ता राज ने आदिकारी बोण जावो, जो देरतीह रेन पेल तुमरे केरता तियार किरेल हे। <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />काहाकाय मी बुखल्यो इतो, एने तुमू माहु खाणेन आपेल; मी तिहल्यो इतो, एने तुमू माहु पाणी पिवाड़ेल; मी एंजाण्यो इतो, एने तुमू माहु तुमरा गेरा माय हादिल; <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />मी उगाल्लोस इतो, एने तुमू माहु फाड़का पेरायेल; मी दुखाऱ्यो इतो, एने तुमू मारी चाकरी किरेल, मी जेली माय इतो, एने तुमू माहु मिलने आयेल।”<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />तेवी खेरला माणहे ताह जापाप देती, “एय मालीक, आमु कुलबुखे तुवाह बुखल्यो दिखेल एने खावाड़ेल? एने तिहल्यो दिखेल एने पाणी पिवाड़ेल? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />आमु तुवाह कुलबुखे पारको दिखेल, एने आमरा गेरा माय हादिल नाहते उगड़ो दिखेल, एने फाड़का पेरायेल? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />आमु केदीह तुवाह दुखाऱ्यो नाहते जेली माय दिखेल, एने तुवाह मिलने आवाला? <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />तेवी राजा ताह जापाप देय, मी तुमूह खेरीच केथु, काय तुमू जा मारा न्या आत्याम रेन आत्या बायाख माय रेन एका हेऱ्या किरेल, तो मार हेऱ्याच किरेल।”<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />तेवी तो डाखरे उगे वालाह केय, “एय हारापेल माणहे, मार ओंगाण रेन पोला जेलेमक्या आक्‍ठा माय जात रिवो, जो सैतान एने तान दुतान केरता तियार किरेल हे। <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />काहाकाय मी बुखल्यो इतो, एने तुमू माहु खाणेन नाह आप्या, मी तिहल्यो इतो, एने तुमू माहु पाणी नाह पिवाड़ेल; <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />मी पारको इतो, एने तुमू माहु गेरा माय नाह हादिल; मी उगड़ो इतो, एने तुमू माहु फाड़का नाह पेरायेल; मी दुखाऱ्यो एने जेली माय इतो, एने तुमू मारी चाकरी नाह केऱ्या।”<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />तेवी ता जापाप देती, “एय मालीक, आमु केदीह तुवाह बुखल्यो, तिहल्यो, नाहते पारको, नाहते उगड़ो, दुखाऱ्यो, नाहते जेली माय दिखेल, एने तारी सेवा चाकरी नाह केऱ्या?” <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />तेवी तो जापाप आपी, “मी तुमूह खेरीच केथु काय तुमू जा न्या आत्याम रेन आत्यान काल्लास ने मोदेक नाह केऱ्या, तो मार हेऱ्या बी नाह केऱ्या। <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />एने ज्या जेलेमक्यास डेंड बोगती, पुण खेरला माणहे जेलेमक्यास जीवाय माय पोच जाती।”<note caller="+" style="x"><char style="xo" closed="false">25:46 </char><char style="xt" closed="false"><ref loc="DAN 12:2">दानिएल 12:2</ref></char></note><verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">यीशुह देरावणेन विचार</para>
  <para style="r">(<ref loc="MRK 14:1-2">मरकुस 14:1-2</ref>; <ref loc="LUK 22:1-2">लुका 22:1-2</ref>; <ref loc="JHN 11:45-53">योहान 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />जेवी यीशु ज्‍यु सोब वातु केय दिनो, ते तान चेलाह केणे बाज गीयो। <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" /><note caller="+" style="x"><char style="xo" closed="false">26:2 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">निर्गमन 12:1-27</ref></char></note>“तुमू जाणतेह, काय दुय दिह्यान पासाण फसह ने तिवार हे, एने माणहान बिटोख खुरूसखाम पोर चेड़ाय जाणेन केरता देराय जाय।<note caller="+" style="f"><char style="fr" closed="false">26:2 </char><char style="ft" closed="false">जेवी मिस्र देसा माय रेन इस्राएली माणहाह काड़ीन लायेल, तु दिह ता माणहे एर केरीन तिवार केरताला</char></note> एने ता मुखी चाकऱ्यान गेरा माय टोलवाना।”<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />तेवी मुखी चाकऱ्या एने माणहान डायडाया केफा नावान मुखी चाकर्‍यान राजवाड़ान खोली माय टोलवाना। <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />एने तान तान विचार केरने बाज गीया, काय यीशुह दोका माय देरीन मार देहु। <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />पुण ता केया, “तिवारान दिह नाह, नाहते माणहा माय देंगो एय।”<verse eid="MAT 26:5" /></para>
  <para style="s">यीशु पोर मोंगालो तेल चोपेड़नो</para>
  <para style="r">(<ref loc="MRK 14:3-9">मरकुस 14:3-9</ref>; <ref loc="JHN 12:1-8">योहान 12:1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />जेवी यीशु बेतनियाह माय शमोन कोढीन गेरा माय इतो।<verse eid="MAT 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 26:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">26:7 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 7:37">लुका 7:37</ref>,<ref loc="LUK 7:38">38</ref></char>
    </note>ते एक बायकु दोवल्या देगड़ान सिसी माय मोंगालो जटामासीन गेंदाण्यो तेल लेन यीशुन आहने आवी, एने जेवी यीशु रूटो खाणेन बुहेल इतो, ते तान मुंडी पोर रोचवी देनी। <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />ज्य देखीन तान चेला रागा माय केणे बाज गीया, “ज्या तेलाह काहा विरखावेह। <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />ज्याह ते हाजीह किमोत केरीन वेचीन गेरब्या माय वाट देती।”<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />यीशु ज्य होमलीन ताह केयो, “बायकुह काहा तारास देतेह? ती मार मुंडी पोर तेल रोचवीन मार हेऱ्यो हाजो काम किरेल हे। <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />गेरीब ते तुमू हेऱ्यास जेलेम रेती, पुण मी तुमू हिऱ्यो नाय रेव। <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />ज्यी मार सेरीर पोर ज्य इत्र रोचवेल हे, तो माहु बुजाणेन केरता किरेल हे। <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />मी तुमूह खेरीच केथु, ‘आखी दुनियाम जाहरी बी ज्यी हाजाली खुबेर पारचार केराय जाय, ता ज्यीन ज्या कामान बाराम बी केती एने ज्यीन एर केराय जाय।’”<verse eid="MAT 26:13" /></para>
  <para style="s">यहुदा इस्‍कोरिती बुरहो तोड़ने</para>
  <para style="r">(<ref loc="MRK 14:10-11">मरकुस 14:10-11</ref>; <ref loc="LUK 22:3-6">लुका 22:3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />तेवी यहुदा इस्‍कोरिती, जो बारा चेला माय रेन एक इतो, तो मुखी चाकऱ्या फाय गीयो, <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />एने तो केयो, “केदी मी ताह तुमरी आथाम देराव देह, ताहार माहु काय आपहो?” तेवी ता यहुदाह तीस चांदीन रूपिया तोलीन आप देना। <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />एने तो तुलबूखे रेन यीशुह देरावणेन हाजालो मुको होदणे बाज गीयो।<verse eid="MAT 26:16" /></para>
  <para style="s">यीशु चेला हिऱ्यो फसहान आखरी खाणो</para>
  <para style="r">(<ref loc="MRK 14:12-21">मरकुस 14:12-21</ref>; <ref loc="LUK 22:7-13">लुका 22:7-13</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">योहान 13:21-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />अखमीरी रोटान तिवारान पेल्ले दिह, चेला यीशु फाय आवीन फुसतेह, “तुवाह का हाजो लागीह काय आमु तार केरता फसहान तिवार खाणेन तिवार केरहु?”<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />यीशु केयो, “हेयरा माय फोलाणा फाय जाईन ताह किज्यो, गुरू किथे, मार टेम आहने हे; मी मार चेला हिऱ्यो तार गेर फसह तिवार मानावण्यो हे।”<verse eid="MAT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 26:19" />तेवी चेला यीशुन वातु मानेन फसहान तियारी केऱ्या।<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />जेवी हांज एनी तेवी यीशु बारा चेला हिऱ्यो रूटो खाणेन केरता बुठो। <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />जेवी ता खाणे बाजरियेल एता, तेवी यीशु केयो, “मी तुमूह खेरीच केथु काय तुमरा माय रेन एक जाण माहु देराव देय।”<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />ज्यी वात पोर ता जुलूम नाराज एय गीया, एने एकेक जाण यीशुह फुसतेह, “एय गुरू, काय तो मी हे?”<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />यीशु जापाप आप्यो, “जो मारी तेली माय आथ टाकेल हे, तोस माहु देराव देय। <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />माणहान बिटोख ते जीहे तान बारामाय लेखायेल हे, पुण ता माणहा पोर हाय जान आथा केरीन मी माणहान बिटोख मार दुसमोनाह होपाय जाय। केदी ता माणहान जेल्मोच नाय एतो, ते तानकेरता हाजो रेतो।”<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />तेवी यीशुह देरावणार यहुदा केयो, “एय रब्बी, काय तो मी हे?” यीशु ताह केयो, “तु केय दिनो।”<verse eid="MAT 26:25" /></para>
  <para style="s">मालीकान खाणो</para>
  <para style="r">(<ref loc="MRK 14:22-26">मरकुस 14:22-26</ref>; <ref loc="LUK 22:14-20">लुका 22:14-20</ref>; <ref loc="1CO 11:23-25">1 कुरिंथीयो 11:23-25</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />जुलबुखे ता खाताला ते यीशु रूटो लिदो, एने दन्यवाद किऱ्यो एने रूटो मुड्यो, एने चेलाह वाटणेन केयो, “लिवो, खावो; ज्यो मारो सेरीर हे।”<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />पुशो यीशु वाटको विसीन, दन्यवाद किऱ्यो, एने चेलाह आपीन केयो, “तुमू आखा ज्याम रेन पिवो, <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />काहाकाय ज्यी वायदान लुय हे, जी आखान पापान माफीन केरता वोयाड़ाय जाथे। <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />मी तुमूह खेरीच केथु, ‘अंगुरान ज्यो रोह तो दिह आवी ताह वोर नाय पिव, जाह वोर तुमू हिऱ्यो मारा आबाख ने राज माय नोवालो नाय पिव।’”<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />पोशा ता गीत गावीन बोगवानान बोड़ाय केऱ्या, ओवता ता बाहेर जेतुन नावान बोयड़ा पोर गीया।<verse eid="MAT 26:30" /></para>
  <para style="s">पतरसान नाकारान जाणाव</para>
  <para style="r">(<ref loc="MRK 14:27-31">मरकुस 14:27-31</ref>; <ref loc="LUK 22:31-34">लुका 22:31-34</ref>; <ref loc="JHN 13:36-38">योहान 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />तेवी यीशु चेलाह केयो, “तुमू आखा आज रातीच मार बाराम ठोकरा खाहो, काहाकाय लिखेल हे: ‘मी गोवालाह मारूह, एने मेंड्रान टुलो फाटा फुट एय जाती।’ <verse eid="MAT 26:31" /><verse number="32" style="v" sid="MAT 26:32" /><note caller="+" style="x"><char style="xo" closed="false">26:32 </char><char style="xt" closed="false"><ref loc="MAT 28:16">मत्ती 28:16</ref></char></note>पुण मी जीव उठुह एने उवतो तुमूह रेन पेल गेलील माय जाह।”<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />पतरस यीशुह केयो, “केदी आखा तार बाराम ठोकरा खाय ते खाय, पुण मी केदी बी ठोकरा नाय खाव।”<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />यीशु ताह जापाप आप्यो, “मी तुवाह खेरीच केथु, काय आज रातीच कुकड़ो वाहणेन पेल, तु तीन वारीन माहु नाकार दिहे।”<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />पतरस यीशुह जापाप आप्यो, “केदी माहु तार हिऱ्यो मोरने बी पोड़ी, तीबी मी तुवाह नाकारू नाय” एने तिहेस केरीन आखा चेला बी केया।<verse eid="MAT 26:35" /></para>
  <para style="s">गतसमनी माय विन्ता</para>
  <para style="r">(<ref loc="MRK 14:32-42">मरकुस 14:32-42</ref>; <ref loc="LUK 22:39-46">लुका 22:39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />तेवी यीशु तान चेला हिऱ्यो गतसमनी नावान बोगीचा माय आवो, एने तान चेलाह केणे बाज गीयो, “न्याच बोह रिज्यो, ताहुक मी ता जाईन विन्ता केरथु।” <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />यीशु पतरसाह एने जब्दीन, दुय बेटाख आरही लेन गीयो, एने दुखी एने नाराज एणे बाज गीयो। <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />तेवी यीशु ताह केयो, “मारो जीव जुलूम नाराज हे, न्या वोर काय मारो जीव निकेलने किरेह तुमू न्याच थुबो एने मार हेऱ्या जाकता रिवो।”<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />ओवतो यीशु उंजु जारीक ओंगाण जाईन, मुयान बोरहेस जाय पुड़नो, एने ज्यी विन्ता किऱ्यो, “एय मारा आबा, केदी एय सेकी ते, ज्‍यु दुखान वाटको मार हिऱ्यो रेन सिटो एय जाय, तीबी जीहे मी होदथु, तिहे नाह, पुण जीहे तु हुदेह तिहेस एय।”<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />पुशो यीशु चेलान आहने आवीन ताह हुवताला दिख्यो, एने पतरसाह केयो, “काय तुमू मार हेऱ्या एकताल बी जागताला नाह रेय सेकते? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />जाकता रिवो एने विन्ता किरते रिवो, काय तुमू पारेख माय नाय पुड़हो, जीव ते तियार हे, पुण सेरीर कोमजोर हे।”<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />पुशो यीशु दिहरी वार जाईन ज्यी विन्ता किऱ्यो, “एय मारा आबा, मी ज्यो पिव बी नाय ते टेल नाय सेकी, ताहार तारी मोरजी पुरी एय।” <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />तेवी यीशु आवीन ताह पोशा हुवताला दिख्यो, काहाकाय तान डोला निंदी माय गाराय रियेल एता।<verse eid="MAT 26:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 26:44" />ताह सोड़ीन यीशु पुशो जात रिनो, तास सोबदा माय पुशो तिसरी वार विन्ता किऱ्यो। <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />तेवी यीशु चेलान आहने आवीन ताह केयो, “एवी हुवतीस रिवो, एने आराम किरो; दिखो, टेम आव लागेल हे, एने माणहान बिटोख पापीन आथा माय देराय जाथे। <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />उठो! चालो एने दिखो, माहु देरावणार आहनेच आव पुचील हे।”<verse eid="MAT 26:46" /></para>
  <para style="s">यीशु दोका माय देराय जाणे</para>
  <para style="r">(<ref loc="MRK 14:43-50">मरकुस 14:43-50</ref>; <ref loc="LUK 22:47-53">लुका 22:47-53</ref>; <ref loc="JHN 18:3-12">योहान 18:3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />यीशु ज्य केणे बाजरियेल ईतोन यहुदा जो बारा चेलाम रेन एक इतो तो आवो, ता हेऱ्या मुखी चाकऱ्या एने माणहे, एने डायलान उगे रेन मोटली गेरदी, तेलवाऱ्यु एने डेंगा लेन आवा। <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />यीशुह देरावणार ताह ज्य केय दियेल इतो, “जा एदम्याह मी गुल्‍या देह तुच हे; ताह देर लिज्यो।”<verse eid="MAT 26:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 26:49" />एने चालोच यहुदा यीशुन आहने आवीन केयो, “एय रब्बी, नमस्‍कार,” एने ताह जुलूम गुल्‍या दिनो।<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />
    <note caller="+" style="f">
      <char style="fr" closed="false">26:50 </char>
      <char style="ft" closed="false">जेल्दी किर दोस्ती, नाहते न्या किहीक आयेल दोस्ती।</char>
    </note>यीशु ताह केयो, “एय दोस्ती जा कामान केरता तु आयेल हे, तो जेल्दी किर।” तेवी ता आहने आवीन यीशु पोर आथ टाक्या एने ताह देर लेदा। <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />यीशुन हाती माय रेन एक जाण आथ ओंगाण केरीन तान तालवार खेचीन मुखी चाकर्‍यान पावराह दिन तान कान काट दिनो। <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />तेवी यीशु ताह केयो, “तारी तालवार म्यान माय मेल, काहाकाय जा तालवार चालाड़तेह ता सोब तालवारी केरीन माराय जाती। <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />काय तु नाह जाणेत, मी मारा आबाख फाय विन्ता केर सेकथु, एने तु हेरोगदुता माय रेन बारा सिपायाह रेन जास्ती मार फाय एवीच मोकली देय?” <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />पुण पुस्तेक त्यु वातु पुरी एणे जोरेवरी हे, किहीक पुऱ्यू एती?<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />
    <note caller="+" style="x">
      <char style="xo" closed="false">26:55 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 19:47">लुका 19:47</ref>; <ref loc="LUK 21:37">21:37</ref></char>
    </note>तुलबूखे यीशु गेरदीह केयो, “काय तुमू तेलवार एने डेंगा लेन माहु डाकु सोमजीन देरणेन केरता आवाह, मी दाड़ीन मोंदिर माय बोहीन हिकाड़तालो, एने तुमू माहु नाह देऱ्या। <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />पुण ज्य आखो ज्यानकेरता ईयेल हे काय जाणकारान वचन पुरो एय।”</para>
  <para style="p" vid="MAT 26:56">तेवी सोब चेला यीशुह सोड़ीन नाह गीया।<verse eid="MAT 26:56" /></para>
  <para style="s">मोटला पोंचान ओंगाण यीशु</para>
  <para style="r">(<ref loc="MRK 14:53-65">मरकुस 14:53-65</ref>; <ref loc="LUK 22:54-55">लुका 22:54-55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">योहान 18:13-14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />तेवी यीशुह देरनारे ताह केफा नावान मुखी चाकऱ्या फाय लेन गीया, जा देरेमगुरू एने डायला टुलो ईयेल एता। <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />पतरस सीट सिटोच तान पासाण पासाण मुखी चाकर्‍यान खोली माय वोर गीयो, एने माय जाईन सेवल्यो टेम देखणेन केरता काम केरनारा हिऱ्यो बोह गीयो। <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />मुखी चाकऱ्या एने आखो, मोटलो पोंचो यीशुह मार देणेन केरता तान विरोद माय जुठो पुरावो होदताला। <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />पुण जुलूम जुठा पुरावो देणारे ओंगाण आवा, तीबी नाह जुड़नो, सेवले बुखेत दुय जाणे आवा। <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" /><note caller="+" style="x"><char style="xo" closed="false">26:61 </char><char style="xt" closed="false"><ref loc="JHN 2:19">योहान 2:19</ref></char></note>एने केया, “ज्यो कियेल इतो मी बोगवानान मोंदिराह तोड़ीन, ताह तीन दिह्या माय बाणाव सेकथु।”<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />तेवी मुखी चाकर्‍यो उबरेन यीशुह केयो, “तु काईच जापाप नाह आपेत काय? ज्या माणहे तारे विरोद माय काय पुरावो देतेह?” <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />पुण यीशु ठावकोच रिनो, तेवी मुखी चाकर्‍यो ताह केयो, “मी तुवाह जीवताला बोगवानान सुगोण आपथु, काय केदी तु बोगवानान बिटोख मसी हे, ते आमुह किय दे।”<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />यीशु ताह केयो, “तुच केय दिनो; मी तुमूह ज्यो बी केथु काय, एवी रेन तुमू निस्तो माणहान बेटाख आखी ताकेतवालान जीवड़े उगे बुहेल एने जुगान वादला पोर आवतालो दिखहो।”<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />तेवी ज्य होमलीन मुखी चाकऱ्या तान फाड़का फाड्या एने केया, “ज्यो बोगवानान चिहटा किरेल हे, एवी आमुह पुरावान काय गिरेज नाह, दिखो, तुमू एवीच ज्यी चिहटा होमल्याह।” <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />तुमू काय सोचतेह? ता जापाप आप्या, “ज्यो मोरनेन लायेक हे।”<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />तेवी ता यीशुन मुया पोर थुप्या एने ताह दुमा केरीन देना, दिहरा थापोड़ दिन केया, <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />एने केया, “एय मसी, आमुह जाणाव केरीन के तुवाह कुण देनो?”<verse eid="MAT 26:68" /></para>
  <para style="s">पतरस द्‍वारे यीशुह नाकारने</para>
  <para style="r">(<ref loc="MRK 14:66-72">मरकुस 14:66-72</ref>; <ref loc="LUK 22:56-62">लुका 22:56-62</ref>; <ref loc="JHN 18:15-18">योहान 18:15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />पतरस बाहेर खोली माय बोह रियेल इतो तेवी एक पावेरनी ता फाय आवी एने केयी, “तु बी यीशु गेलील वाला हिऱ्यो इतो।”<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />तो सोबान सामने इही किन नाकार दिनो, “मी नाह जाणेत तु काय केणे बाजरेनीह।” <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />जेवी तो बाहेर बायणा पोर जात रिनो, ते दिहरी पावेरनी पतरसाह देखीन, जा ताहरी उबरियेल ताह केयी, “ज्यो बी ते यीशु नासरी हिऱ्यो इतो।”<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />तो सुगोण खाईन पुशो नाकार दिनो, “मी ओया माणहाह नाह उलखेत।”<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />थोड़ीक वार माय माणहे जा ता उबरियेल एता पतरसा फाय आवीन केया, “खेरीच तु बी ताम रेन एक हे, काहाकाय तारो बोल तारी मालमात उगाड़ दिथे।”<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />तेवी पतरस नाकाऱ्यो एने सुगोण खाणे बाज गीयो, “मी ओया माणहाह नाह जाणेत।” एने तुलेचबूखे कुकड़ो वाह दिनो। <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />तेवी पतरसाह यीशुन कियेल वात एर आवी, “कुकड़ा वाहणेन पेल तु तीन वार माहु नाकार दिहे।” तेवी तो बाहेर जाईन उहकी उहकीन रेड़ने बाज गीयो।<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">पिलातुस ने सामने यीशु</para>
  <para style="r">(<ref loc="MRK 15:1">मरकुस 15:1</ref>; <ref loc="LUK 23:1-2">लुका 23:1-2</ref>; <ref loc="JHN 18:28-32">योहान 18:28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />जेवी उजालो एनो ते आखा मुखी चाकऱ्या एने डायडाया यीशुह मार देणेन होमच्‍यो केऱ्या। <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />एने ता यीशुह बांदिन ली गीया एने पिलातुस ने आथाम होप देना।<verse eid="MAT 27:2" /></para>
  <para style="s">यहुदान मोत</para>
  <para style="r">(<ref loc="ACT 1:18-19">प्रेरितान काम 1:18-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">27:3 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 1:18">प्रेरितान काम 1:18</ref>,<ref loc="ACT 1:19">19</ref></char>
    </note>जेवी यीशुह देरावणार यहुदा दिख्यो काय यीशु दोसी ठेराय जायेल हे, ते यहुदा पासतानो एने ता तीस चांदीन सिक्का मुखी चाकऱ्या एने डायडाया फाय पुशो आपणे गीयो। <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />एने केयो, “मी निर्दोसाह मारावणेन केरता देरावीन पाप किरेल हे।” ता केया, “आमुह काय? तुवाह मालुम।”<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />तेवी तो ता पोयशाह मोंदिरा माय टाकीन जात रिनो, एने जाईन जीवेच फासी खाय लिदो।<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />मुखी चाकऱ्या ता पोयशा विसीन केया, “न्याह पेटी माय मेलनेन हाजो नाह सोतो, काहाकाय ज्यी लुयीन किमोत हे।” <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />तेवी ता तान तान होमच्‍यो केरीन ता पोयशान पाराया देसावाला माणहाह बुजणेन केरता कुमारान खेत वेचातो लेय लेदा। <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />ज्यानकेरता तो खेत आज वोर लुयान खेत केवाथे।<verse eid="MAT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 27:9" />तेवी जो वचन यिर्मया जाणकारान द्‍वारे केवाय जायेल एतो, तो पुरो एय गीयो; मुखी चाकऱ्या ता तीस सिक्का मतलब ता ठेरायेल किमोताह जाह इस्राएलान सोरा माय रेन मोकतास सहमती माय ठेरायेल एता लेय लेदा। <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />एने जीहे मालीक माहु उकुम आपेल एतो, तिहेस ताह कुमारान खेताह किमोत माय आप देना।<verse eid="MAT 27:10" /></para>
  <para style="s">पिलातुस ने सावाल</para>
  <para style="r">(<ref loc="MRK 15:2-5">मरकुस 15:2-5</ref>; <ref loc="LUK 23:3-5">लुका 23:3-5</ref>; <ref loc="JHN 18:33-38">योहान 18:33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />जेवी यीशु आदिकारीन ओंगाण उबरियेल इतो, ते आदिकारी यीशुह फुशो, “काय तु यहुदिन राजा हे?” यीशु ताह केयो, “तु सोताच केणे बाजरिनोह।” <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />जेवी मुखी चाकऱ्या एने डायला ता पोर गुनो लागाड़ने बाजरियेल एता, तो काईच जापाप नाह आप्यो।<verse eid="MAT 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 27:13" />केरीन पिलातुस यीशुह केयो, “काय तु नाह होमलेत ज्या तार विरोद माय कोलोक पुरावो देणे बाजरेनाह?”<verse eid="MAT 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14" />पुण यीशु ताह एक वातीन बी जापाप नाह आप्यो, केरीन काय आदिकारीह जुदोच लागो।<verse eid="MAT 27:14" /></para>
  <para style="s">यीशुह सोड़नेन पिलातुस पास नाह ईनो</para>
  <para style="r">(<ref loc="MRK 15:6-15">मरकुस 15:6-15</ref>; <ref loc="LUK 23:13-25">लुका 23:13-25</ref>; <ref loc="JHN 18:39-19:16">योहान 18:39–19:16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />एने देर वोरीह फसह ने तिवारान टेमा माय यहुदि माणहे एक काल्ला बी आरापीह सोड़नेन मांग केरताला, ताह पिलातुस सोड़ देतालो। <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />ती टेम माय ता फाय यीशु बरअब्बा नावान एक नाव लायेल केयदी इतो। <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />जेवी ता एकठा एना, ते पिलातुस ताह केयो, “तुमू कुणाह सोड़ेवण्या काय मी तुमरी केरता सोड़ देव? बरअब्बाह काय यीशुह, जो मसी केवाथे?” <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />काहाकाय पिलातुस जाणतालो काय ता यीशुह कुयराये देरायेल हेते।<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />जेवी तो नियावान गादि पोर बोह रियेल इतो ते तान बायकु ताह केय मोकल्यी, “तु ता देरमीन बाराम आथ मा टाकहे, काहाकाय मी आज होपना माय तानकेरता जुलूम दुख विठेल हे।”<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />मुखी चाकऱ्या एने डायला माणहाह बोड़काया काय ता बरअब्बाह मांग लिवो, एने यीशुह खेतेम केराव देय। <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />आदिकारी ताह फुशो, “न्या दुय जाणा माय रेन कुण जुवेह काय मी तुमरी केरता सोड़ देव?” ता केया, “बरअब्बाह।”<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />पिलातुस ताह फुशो, “पुण यीशुह जो मसी केवाथे ताह काय केरू?” सोब ताह केया, “ताह खुरूसखाम पोर चेड़ाव दिवो।”<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />पुण पिलातुस केयो, “काहा, ज्यो काय गुनो किरेल हे?” पुण उंजु ता आयड़ी आयड़ीन केणे बाज गीया, “ताह खुरूसखाम पोर चेड़ाव दिवो।”<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />जेवी पिलातुस दिख्यो काय काईच बोणताली नाह हासवाताली, पुण गाड गाडीह कापाली वोदते जाथे, ते तो पाणी लेन गेरदीन ओंगाण जिवास ने आथ दुयो एने केयो, “मी ज्या देरमीन लुयीह रेन निर्दोस हे तुमूच जाणो।”<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />आखा माणहे जापाप आप्या, “ज्यान लुय आमु पोर एने आमरा सोरा पोर रेय।”<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />तेवी पिलातुस ज्य होमलीन बरअब्बाह ता माणहान केरता सोड़ दिनो, एने यीशुह चापका देवाड़ीन सिपायाह होप दिनो काय खुरूसखाम पोर चेड़ाव देय।<verse eid="MAT 27:26" /></para>
  <para style="s">सिपायड़ा यीशुन अपमान केऱ्या</para>
  <para style="r">(<ref loc="MRK 15:16-20">मरकुस 15:16-20</ref>; <ref loc="JHN 19:2-3">योहान 19:2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />तेवी पिलातुस ने सिपायड़ा यीशुह किल्‍ला माय ली जाईन आखा तान चार चोमखीर एकठा एना। <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />एने यीशुन फाड़का काड़ीन ताह जामण्या रेंगान फाड़का पेराया, <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />एने काटान मुकूट गुथीन तान मुंडी पोर पेराया, एने तान जेवड्या आथा माय डिंगो देराया, एने तान ओंगाण पाया पोड़ी तान ईजुत उड़ाया, एने केया, “एय यहुदियान राजा, नमस्‍कार,” <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />एने ता पोर थुप्या, एने ताच डेंगा केरीन तान मुंडा माय देणे बाज गीया। <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />जेवी ता यीशुन ईजुत उड़ाव लेदा, तेवी तान सेरीर माय रेन जामण्या फाड़का काड़ीन, एने उंजु ताच ने फाड़का ताह पेराया, एने खुरूसखाम पोर चेड़ावणेन केरता ली गीया।<verse eid="MAT 27:31" /></para>
  <para style="s">यीशुह खुरूसखाम पोर चेड़ावणु</para>
  <para style="r">(<ref loc="MRK 15:21-32">मरकुस 15:21-32</ref>; <ref loc="LUK 23:26-43">लुका 23:26-43</ref>; <ref loc="JHN 19:17-27">योहान 19:17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />बाहेर जाणे बुखेत ताह शिमोन नावान एक कुरेनी माणुह मिलानो, ता ताह उदडुस देऱ्या काय यीशुन खुरूसखाम उखलीन चाले। <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />ता जागा पोर जो गुलगुता, मतलब खोपड़ीन जागु केवाणे ता पोचना। <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />ता पित्त बिसकेल अंगुरान रूह यीशुह पिणेन आप्या, पुण ताह साकीन पिणे नाह हुद्यो।<verse eid="MAT 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35" />तेवी ता यीशुह खुरूसखाम पोर चेड़ाया, एने चिट्ठी टाकीन यीशुन फाड़का वाट लेदा, <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />एने ता बोहीन यीशुन राखवाली केरने बाज गीया। <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />एने तान गुनान चिट्ठी लेखीन तान मुंडीन उपेर लागाड्या, “ज्यो यहुदियान राजा यीशु हे।” <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />तेवी यीशु हेऱ्या दुय बांड एता, एक जीवड़े उगे एने एक डाखरे उगे खुरूसखाम पोर चेड़ायेल एता।<verse eid="MAT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39" />एने जाणारे आवणारे मुंड आलवी आलवीन तान चिहटा केरताला, <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" /><note caller="+" style="x"><char style="xo" closed="false">27:40 </char><char style="xt" closed="false"><ref loc="MAT 26:61">मत्ती 26:61</ref>; <ref loc="JHN 2:19">योहान 2:19</ref></char></note>एने इही केताला, “एय मोंदिराह ओदारनार, एने तीन दिह्या माय बाणावणार, सोताह ते वोचाड़; तु बोगवानान बिटोख हे, ते खुरूसखाम पोर रेन उतेर आव।”<verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />इहीचकेरीन मुखी चाकऱ्या बी देरेमगुरू एने डायडाया हेऱ्या एकठा केर केरीन केताला, <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />“ज्यो दिहराह वोचाड़ेल, एने सोताह नाह वोचाड़ सिकेत, ज्यो ते इस्राएलान राजा हे, एवीच खुरूसखाम पोर रेन उतेर आवी ते आमु तार पोर बुरहो केरहु।”<verse eid="MAT 27:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 27:43" />ज्यो बोगवाना पोर बुरहो किरेल हे, केदी तो ज्याह पसंद किरेह, ते एवी ज्याह सोड़वी लेय, काहाकाय ज्यो कियेल इतो, “मी बोगवानान बिटोख हे।”<verse eid="MAT 27:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 27:44" />तिहेस केरीन बांड बी जा ता हेऱ्या खुरूसखाम पोर चेड़ायेल एता, तान ईजुत उड़ावताला।<verse eid="MAT 27:44" /></para>
  <para style="s">यीशुन जीव निकेलने</para>
  <para style="r">(<ref loc="MRK 15:33-41">मरकुस 15:33-41</ref>; <ref loc="LUK 23:44-46">लुका 23:44-46</ref>; <ref loc="JHN 19:28-30">योहान 19:28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />जेवी दिह्यान बारा वाज गीया, ते आखा देसा माय आदारो सावाय गीयो, एने तीन वाजता वोर आदारोच रेनो। <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />दिह्यान तीन वाजता यीशु मोठेच आयड़ीन केयो, “एली, एली, लमा शबक्तनी?” मतलब “एय मारा बोगवान, हे मारा बोगवान, तु माहु काहा सोड़ दिनो?”<verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />जा आहने उबरियेल एता, ता माय रेन थोड़ाक जाणे ज्य होमलीन केया, “ज्‍यो ते एलियाह आयड़ेह।” <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />ता माय रेन एक चालोच दोवड़नो एने एक स्पंजाह टोकरा माय लेन अंगुरान कोड़वा रूहा माय बुड़ायो, एने सेंडा पोर मेलीन ताह चुहाड्यो।<verse eid="MAT 27:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 27:49" />दिहरा केया, “थोब जावो, देखता एलिया ज्याह वोचाड़ने आवीह काय नाह।”<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />तेवी यीशु पुशो जोरेह आयड़ीन जीव सोड़ दिनो।<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />तेवी मोंदिरान पुड़दो उपेर रेन बुंदे वोर फाटीन दुय टुकड़ा एय गीया, एने देरती आल गियी एने सापोर फुट गीया। <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />एने माहणे उगड़ी गीया, एने हुवताला चोखाला माणहान मोकतास देड़े जीव उठना। <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />एने यीशुह जीव उठणेन पासाण ता माहणा माय रेन निकलीन चोखाला हेयराम गीया एने मोकतास जाणाह देखाना।<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />तेवी सुबेदार एने जा ता हेऱ्या यीशुन राखवाली केरताला, बुकम्प एनो, जो काय ईयेल एतो तो देखीन जुलूम बिय गीया, एने केया, “खेरीच ज्यो बोगवानान बिटोख इतो।”<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />
    <note caller="+" style="x">
      <char style="xo" closed="false">27:55 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 8:2">लुका 8:2</ref>,<ref loc="LUK 8:3">3</ref></char>
    </note>ताहरी मोकत्युस बायकु ज्‍यु गेलील माय रेन यीशुन सेवा किरतेन ता हेऱ्यु आयेल एत्यु, सेट्युस रेन देखताल्यु। <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />त्युम रेन मरीयम मगदलीनी, एने याकुब एने योसेसान आहख मरीयम, एने जब्दीन बेटाख ने आहख एत्यु।<verse eid="MAT 27:56" /></para>
  <para style="s">यीशुह बुजणो</para>
  <para style="r">(<ref loc="MRK 15:42-47">मरकुस 15:42-47</ref>; <ref loc="LUK 23:50-56">लुका 23:50-56</ref>; <ref loc="JHN 19:38-42">योहान 19:38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />जेवी हांज एनी ते युसूफ नावान अरीमतीयान एक मालदार माणुह, जो सोताह यीशुन चिलो केतालो, तो आवो। <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />एने तो पिलातुस फाय जाईन, यीशुन देड़ मांग्‍यो, तेवी पिलातुस आप देणेन उकुम आप्यो। <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />युसूफ देड़ाह उताऱ्यो, एने ताह दोवल्यी डाठी माय गुंडाल्यो, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />एने तान नोवाला माहणा माय मिल्यो, जाह तो सापराट्या माय खोदीन बाणायेल इतो, एने माहणान बायणा पोर मुठोस दिगोड़ टेकाड़ीन जात रिनो। <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />मरीयम मगदलीनी एने दिहरी मरीयम ताहरी माहणान सोमोर बोह रियेल एत्यु।<verse eid="MAT 27:61" /></para>
  <para style="s">यीशुन माहणान राखवाली</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />दिहरे दिह जो तियारीन दिह्यान पासाणल्यो दिह इतो, मुखी चाकऱ्या एने फरिसी पिलातुस फाय एकठा एयीन केया, <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" /><note caller="+" style="x"><char style="xo" closed="false">27:63 </char><char style="xt" closed="false"><ref loc="MAT 16:21">मत्ती 16:21</ref>; <ref loc="MAT 17:23">17:23</ref>; <ref loc="MAT 20:19">20:19</ref>; <ref loc="MRK 8:31">मरकुस 8:31</ref>; <ref loc="MRK 9:31">9:31</ref>; <ref loc="MRK 10:33">10:33</ref>,<ref loc="MRK 10:34">34</ref>; <ref loc="LUK 9:22">लुका 9:22</ref>; <ref loc="LUK 18:31-33">18:31-33</ref></char></note>“एय मालीक, आमुह एर हे काय तो बोटकावणार जीवतालो इतो, तेवी कियेल, ‘मी तीन दिह्यान पुशो जीव उठुह।’ <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />उकुम आप काय तिसरे दिह वोर माहणान राखवाली केरती, ओहलो नाय एय काय तान चेला आवीन ताह चोरीन लेन जात रेती एने माणहाह केणे बाज जाती, तो मुरेल माय रेन जीव उठेल हे, तेवी पासाणल्यो दुको पेल्लाह रेन खाराब रेय।”<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />पिलातुस ताह केयो, “तुमू फाय राखवाल्या ते हेते ने, जावो तुमूह सोमजी तिहे होमालो।”<verse eid="MAT 27:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 27:66" />तेवी ता राखवाल्याह आरही लेन गीया, एने देगड़ा पोर साप लागाड़ीन माहणान राखवाली केऱ्या।<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">यीशुन जीव उठणो</para>
  <para style="r">(<ref loc="MRK 16:1-10">मरकुस 16:1-10</ref>; <ref loc="LUK 24:1-12">लुका 24:1-12</ref>; <ref loc="JHN 20:1-10">योहान 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />विहेवणेन दिह्यान पासाण एप्तान पेल्ले दिह, उजालो एतास, मरीयम मगदलीनी एने दिहरी मरीयम माहणाह देखणे आवी। <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />एने उचकाहुच मुठलो बुकम्प ईनो, काहाकाय मालीकान एक दुत हेरगा माय रेन उतऱ्यो, एने माहणान आहने आवीन ता देगड़ाह सिटो केर दिनो, एने ता पोर बोह गीयो। <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />तान वेह विजलीन गेत, एने तान फाड़का बोरफान गेत, दोवल्या एता। <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />ताह बिन राखवाल्या काप उठना, एने बेसुद एय गीया।<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />हेरोगदुत बायकुह केयो, “बिहो मा, माहु मालुम हे तुमू खुरूसखाम पोर चेड़ायेल ता यीशुह होदत्युह। <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />तो न्या नाह सुतो,” पुण तो वचन कियेल तिहे, “जीव उठेल हे,” आवो ज्‍यो जागो दिखो, जा मालीकान देड़ एतो, <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />पुण तुमू जावो, तान चेलाह किवो काय तो मुरेल माय रेन जीव उठेल हे, एने तुमूह रेन पेल गेलील माय जाथे, एने ताह ता दिखहो, मी तुमूह केय दिनो।<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />त्यु बिय माय एने मोटली खुसी माय माहणान जागे रेन तुलेचबूखे वोलीन तान चेलाह खुबेर देणेन केरता दोवड़ीन जात रेन्यु।<verse eid="MAT 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 28:9" />तेवी यीशु त्युह मिलानो, एने केयो, “तुमूह हुक जुड़ी,” त्यु आहने आव्यु एने यीशुन पाया पोड्यु। <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />तेवी यीशु त्युह केयो, “बिहो मा,” मारा बायह्याख जाईन किवो, “काय गेलील माय जात रेय, ता माहु देखती।”<verse eid="MAT 28:10" /></para>
  <para style="s">राखवाल्यान खुबेर</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />ता जाणेस बाजरियेल एता, एने राखवाल्या माय रेन थोड़ाक जाणे गावा माय आवीन आखी वात मुखी चाकऱ्याह केय होमलाया। <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />तेवी ता डायला हेऱ्या एकठा एन होमच्‍यो केऱ्या, एने सिपायड़ाह मोकतीस चांदी आपीन केया, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />“ज्य किज्यो काय जेवी राती आमु हुव जायेल एता, तेवी तान चेला आवीन ताह चोरीन लेन जात रियेल। <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />एने केदी ज्यी वात पिलातुसान काना माय वोर पोचनी, ते आमु ताह सोमजाड़ लेहु, एने तुमूह वोचाड़ लेहु।”<verse eid="MAT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15" />ता पोयशा देरीन जीहे कियेल एता, तिहेच केऱ्या ज्यी वात आज वोर यहुद्यान माणहे केरतेह।<verse eid="MAT 28:15" /></para>
  <para style="s">यीशु देखाणे एने आखरी उकुम</para>
  <para style="r">(<ref loc="MRK 16:14-18">मरकुस 16:14-18</ref>; <ref loc="LUK 24:36-49">लुका 24:36-49</ref>; <ref loc="JHN 20:19-23">योहान 20:19-23</ref>; <ref loc="ACT 1:6-8">प्रेरितान काम 1:6-8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />
    <note caller="+" style="x">
      <char style="xo" closed="false">28:16 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 26:32">मत्ती 26:32</ref>; <ref loc="MRK 14:28">मरकुस 14:28</ref></char>
    </note>आकरा चेला गेलील ने ता बोयड़ा पोर गीया, जा यीशु ताह कियेल इतो। <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />चेला यीशुह देखीन नमस्‍कार केऱ्या, पुण थोड़ाक जाणे बुल माय एता।<note caller="+" style="x"><char style="xo" closed="false">28:17 </char><char style="xt" closed="false"><ref loc="LUK 24:36-49">लुका 24:36-49</ref></char></note> <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />यीशु तान आहने आवीन केयो, “हेरोग एने देरतीन सोब आदिकार माहु होपायेल हे। <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" /><note caller="+" style="x"><char style="xo" closed="false">28:19 </char><char style="xt" closed="false"><ref loc="ACT 1:8">प्रेरितान काम 1:8</ref></char></note>तानकेरता तुमू जावो, आखी जातीन माणहाह चेला बाणावो, एने ताह आबाख, एने बेटाख ने, चोखाला जीवान नावा माय बपतीस्मा आपु, <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />एने ताह सोब वातु जो मी तुमूह उकुम आपेल हे माणनेन हिकाड़ो; मी देरतीन आखरी वार वोर जेलेमक्योस तुमू हिऱ्यो हे।”<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>