<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2CO" style="id">- Nahali</book>
  <para style="h">2 कुरिंथीयो</para>
  <para style="toc3">2 कुरिंथीयो</para>
  <para style="toc2">2 कुरिंथीयो</para>
  <para style="toc1">कुरिंथीयो पौलुस लिखेल दुसरो पोत्रो</para>
  <para style="mt2">कुरिंथीयो पौलुस ने लिखा हुआ दुसरा पत्र</para>
  <para style="mt1">कुरिंथीयो पौलुस लिखेल दुसरो पोत्रो</para>
  <para style="imt">ओलखात</para>
  <para style="ip">दुसरो कुरिंथीयोन ज्यी पोत्री प्रेरित पौलुस यीशु मसीन जेल्मान 55-56 सालान पासाण लिखेल। <char style="xt"><ref loc="2CO 1:1">1:1</ref></char> पौलुसान ज्‍यु दुय पोत्री माय रेन ज्यी दुसरी पोत्री हे। मोकतास पंडित इहकेरीन केतेह काय ज्यी पोत्रीन पेल कुरिंथीयोह एक मोटली कठोर पोत्री लिखेल ईतो। ज्यान बारा माय <char style="xt"><ref loc="2CO 2:3-4">2:3-4</ref></char> ज्यी पोत्रीन बाराम किथे, पुण ज्यी पोत्री आमरे फाय रेन नाह। ज्यी दुसरी कुरिंथीयोन पोत्री ज्यो आंदाज हे काय ज्यो पोत्र मकादुनिया रेन लिख्यो एय। <char style="xt"><ref loc="2CO 2:13">2:13</ref></char></para>
  <para style="ip">ज्यी पोत्रीन विशेष ज्यी बावनात्मक वातु एने माणहान वातीन चेरचा केराय जायेल हे, ज्यी पोत्री माय पौलुस खुसी माणावेह काय पौलुस जो हाजाली चेतावणी पौलुस तीतुस फाय रेन सापड़ायेल हे तान बाराम पौलुस खुसी माणावेह, ज्यी पोत्री आपणेन बारामाय जुलूम हिक आपेह ज्यी नोवाला नेमान गेत आपेल हे, इही देखाह ज्यी हिक ता बाराम हे काय पोयशा आपणेन बाराम लिखेल हे, जा पोयशा यरूशलेम वाला विश्वासीन मोदेक केरनेन केरता लेखाय जायेल एतो, <char style="xt"><ref loc="2CO 8-9">8–9</ref></char> जा मोंडली माय थोड़ाक माणहे पौलुसान विरोद केरताला, एने थोड़ाक बाहेर रेन आयेल एता ता जुठा प्रेरित ता विरोदान फायदो विसीन पौलुसाह दाबीन सोतान नाव कामावताला, एने पौलुसान आदिकारा पोर सावाल केऱ्या तान केरता ज्यी पोत्रीन सेवल्या ईसा माय यीशु मसीन प्रेरितान नाता माय जोर दिथे।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. पौलुसान मोंडलीह नमस्‍कार। <char style="ior"><ref loc="2CO 1:1-7">1:1-7</ref></char></para>
  <para style="io1">2. पौलुस तान यात्राम बोदलाव केरने एने कुरिंथीयोन बाराम खुबेर जुड़ेल तान बारान एने तान पेल्‍ली पोत्रीन बाराम केणे। <char style="ior"><ref loc="2CO 1:8-7:16">1:8–7:16</ref></char></para>
  <para style="io1">3. यरूशलेम माय रेणारा विश्वासीन केरता दान टुलो केरनेन बाराम पौलुसान सुचना। <char style="ior"><ref loc="2CO 8:1-9:15">8:1–9:15</ref></char></para>
  <para style="io1">4. आखरी माय पौलुस तान प्रेरितान वोचाव किरेह, एने तान आवणारी बेटीन बाराम इसारो किरेह। <char style="ior"><ref loc="2CO 10:1-13:10">10:1–13:10</ref></char></para>
  <chapter number="1" style="c" sid="2CO 1"/>
  <para style="s">परिचय</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 1:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:1">प्रेरितान काम 18:1</ref>
      </char>
    </note>पौलुसान उगे रेन जो बोगवानान मोरजी से मसी यीशुन प्रेरित हे, एने बाहख तीमुथीयुस ने उगे रेन बोगवानान ती मोंडली जी कुरिंथीयो माय हे, एने आखा बोगवानान माणहान नावे जा आखाया माय हेते:<verse eid="2CO 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 1:2"/>बोगवान आपणो आबोख एने मालीक यीशु मसीन उगे रेन तुमूह गीण एने सान्ती जुड़ती रेय।<verse eid="2CO 1:2"/></para>
  <para style="s">पौलुस बोगवानाह दन्यवाद केरने</para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 1:3"/>आपणो मालीक यीशु मसीन आबाख ने जो बोगवान हे, तान दन्यवाद एय, जो गीण ने आबोख एने आखी बातीन सान्तीन बोगवान हे! <verse eid="2CO 1:3"/><verse number="4" style="v" sid="2CO 1:4"/>तो आमरे आखा संकटाम आमुह दिलासो आपेह, एने आमु ता दिलासान कारेण जो बोगवान आमुह आपेह, ता माणहाह बी दिलासो आप सेकी जा काल्ली बी बातीन संकटाम एती। <verse eid="2CO 1:4"/><verse number="5" style="v" sid="2CO 1:5"/>जिहकेरीन मसीन दुखाम आमु होवटाह बाग लेतेह, तिहेस केरीन आमु दिलासा माय बी यीशुन द्‍वारे होवटाह बाग लेतेह। <verse eid="2CO 1:5"/><verse number="6" style="v" sid="2CO 1:6"/>केदी संकट आमु पोर आवीह, ते ज्य तुमरे दिलासान एने सुटकारान केरता हे; एने केदी आमुह दिलासो जुड़ेह, ते ज्य तुमूह दिलासो जुड़ी तान केरता हे, ज्य केरने से तुमू दिर देरीन ता संकटाह वेठ लेतेह, जाह आमु वेठतेह। <verse eid="2CO 1:6"/><verse number="7" style="v" sid="2CO 1:7"/>आमरी आसा तुमरे बाराम मोजबुत हे; काहाकाय आमु जाणतेह काय तुमू जिहकेरीन आमरा दुखाम बाग लेतेह, तिहेस केरीन दिलासान बी बागीदार हेते।<verse eid="2CO 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 1:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:8 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 15:32">1 कुरिंथीयो 15:32</ref>
      </char>
    </note>एय बाय बोणहा, आसीया गावा माय आमु पोर आयेल संकटान बाराम तुमू एंजाणल्या रिहो ओहली आमरी मोरजी नाह सोती। आमु ओहला बारला वोजाम दाबाय जायेल एता, जो आमरी ताकेतीह रेन बाहेर एतो, ओहलो ईयेल एतो काय आमु एवी मोरीस जाहु। <verse eid="2CO 1:8"/><verse number="9" style="v" sid="2CO 1:9"/>एने आमु मोरीस गीयाह ओहलो आमरो मोन आमुह केतालो। ते ज्य तानकेरता एनो काय आमु खुद फिसलो नाह केऱ्या, पुण बोगवाना पोर बुरहो केरी जो मुरेलाह जीवाड़ ने। <verse eid="2CO 1:9"/><verse number="10" style="v" sid="2CO 1:10"/><note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">मोत ने बयानक दुको; थोड़ाक लेख माय बयानक मोत।</char></note>तोच आमुह मोतीन मोटला संकटाम रेन वोचाड़ेल, एने वोचाड़ी बी; एने ता पोर आमरी ज्यी आसा हे। एने तो आमुह ओंगाण बी खेतेरनाक संकटाम रेन वोचाड़ते रेय, <verse eid="2CO 1:10"/><verse number="11" style="v" sid="2CO 1:11"/>तुमू बी आखा मिलीन विन्तान द्‍वारे आमरी मोदेक किरो, काय जो मोटलो वरदान मोकतास ने द्‍वारे आमुह जुड़ेल हे, तान कारेण मोकतास माणहे आमरी उगे रेन दन्यवाद केर सेकी।<verse eid="2CO 1:11"/></para>
  <para style="s">सेवा माय जाणेन केरता पौलुसान बोदलाव</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 1:12"/>काहाकाय आमु आमरा मोनान ज्यी गोवाय पोर मोठाय केरतेह, काय दुनिया माय एने खास केरीन तुमरी विचीम; आमरो सोबाव बोगवानाह पोटी ओहलो चोखालो एने खेरायी माय एतो, जो सेरीरान इकेल केरीन नाह पुण बोगवानान गीणी हेऱ्यो एतो।<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="ft" closed="false">स्पष्ट; थोड़ाक लेख माय चोखाला माय हे।</char></note> <verse eid="2CO 1:12"/><verse number="13" style="v" sid="2CO 1:13"/>आमरी पोत्री माय ओहलो कायच नाह सोतो, जो तुमू वाच एने सोमेज नाह सेकतेह, एने मारी आसा ज्यी हे काय तुमू सेवली बुखेत आखो काय सोमेज लिहो। <verse eid="2CO 1:13"/><verse number="14" style="v" sid="2CO 1:14"/>एने एवी तुमू थोड़ोक आमुह सोमेजतेह पुण जेदिह मालीक यीशु आवी ते दिह मोठाय किरहो जिहकेरीन आमु तुमरी पोर केरतेह।<verse eid="2CO 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 1:15"/>ज्यास बोरहा हिऱ्यो मी पेल आवणे होदतालो काय तुमू फाय आवो, काय तुमूह एक वार उंजु होवटीह गीण जुड़ी। <verse eid="2CO 1:15"/><verse number="16" style="v" sid="2CO 1:16"/><note caller="+" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="ACT 19:21">प्रेरितान काम 19:21</ref></char></note>एने तुमरी हिऱ्यो रेन मकादुनिया माय जाह, एने पुशो मकादुनियाम रेन तुमू फाय आवो, एने तुमू माहु यहुदिया उगे आदेक वोर पोचाड़ दिज्यो। <verse eid="2CO 1:16"/><verse number="17" style="v" sid="2CO 1:17"/>जेवी मी ओहलो विचार किरेल तेवी काय मी संका माय ईतो। एने काय मी ज्यो ठेराव केरथु तो मी सेरीरान गेत केरथु; काय मी वातुम “होव, होव” केरू एने “नाह, नाह” बी केरू? <verse eid="2CO 1:17"/><verse number="18" style="v" sid="2CO 1:18"/>बोगवान आमरो खीरलो गोवा हे; काय ज्यी खुबेर आमु तुमूह कियेल ती होव एने “नाह” दुयू नाह जुड़ते। <verse eid="2CO 1:18"/><verse number="19" style="v" sid="2CO 1:19"/><note caller="+" style="x"><char style="xo" closed="false">1:19 </char><char style="xt" closed="false"><ref loc="ACT 18:5">प्रेरितान काम 18:5</ref></char></note>काहाकाय बोगवानान सोरो यीशु मसी जान आमरे द्‍वारे मतलब मार एने सिलवानुस ने एने तीमुथीयुस ने द्‍वारे तुमरी विचीम पारचार एनो, ता माय होव एने नाह दुयू नाह एता, पुण बोगवानान उगे रेन होवुज एती। <verse eid="2CO 1:19"/><verse number="20" style="v" sid="2CO 1:20"/>काहाकाय बोगवानान जोला बी वायदा हेते, ता आखा ता माय “होव” हेऱ्या खेरीच हेते। तानकेरता तान द्‍वारे “आमेन” बी एनो काय आमरे द्‍वारे बोगवानान बोड़ाय एय। <verse eid="2CO 1:20"/><verse number="21" style="v" sid="2CO 1:21"/>एने आमुह निवाड़ेन तुमरी हिऱ्यो नाता माय मसीम मोजबुत किरेल हे, तोच बोगवान हे। <verse eid="2CO 1:21"/><verse number="22" style="v" sid="2CO 1:22"/>एने तो आमु पोर साप लागाड़ील हे काय आमु तान हेते, एने चोखालो जीव बी बियानान रूप माय मोनाम आपेल हे, जो आवणारा कालाम जुड़ी।<verse eid="2CO 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2CO 1:23"/>मी बोगवानाह पुरावो मेलीन केथु काय मी कुरिंथीयो माय ज्यानकेरता नाह आवो काय मी तुमूह दोपकाड़ ने नाह होद्थु। <verse eid="2CO 1:23"/><verse number="24" style="v" sid="2CO 1:24"/>ज्यी वात नाह सोती काय आमु बोरहा माय तुमू पोर दाबाव टाकणे होद्तेह, पुण आमु तुमरी खुसीन केरता तुमू हेऱ्या हाती हेते, काहाकाय तुमू बुरहो केरीन मोजबुत रेतेह।<verse eid="2CO 1:24"/></para>
  <chapter eid="2CO 1"/>
  <chapter number="2" style="c" sid="2CO 2"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 2:1"/>मी ज्य ठाण लियेल ईतो काय पुशो मी तुमूह नाराज केरने नाय आवो। <verse eid="2CO 2:1"/><verse number="2" style="v" sid="2CO 2:2"/>काहाकाय मी केदी तुमूह नाराज केरू ते माहु खुसी आपणार कुण एय, तोस जाह मी नाराज किरेल। <verse eid="2CO 2:2"/><verse number="3" style="v" sid="2CO 2:3"/>एने मी ज्यी वात तुमूह ज्यानकेरता लिखेल काय ओहलो नाय एय काय मार आवणे रेन, जाह रेन माहु खुसी जुड़ने जुवे मी ताह रेन नाराज एय; काहाकाय माहु तुमू आखा पोर बुरहो हे, काय जी मारी खुसी हे, तीस तुमू आखान बी हे।<verse eid="2CO 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 2:4"/>मोटली तेकलीत एने मोनान केस्टा माय रेन मी जुलूम आहवा गाल गालीन तुमूह लिखेल ईतो। ज्यानकेरता नाह काय नाराज ईहो, पुण ज्यानकेरता काय तुमू ता मोटला मोंगाह जाण लेय, जो माहु तुमू हेऱ्यो हे।<verse eid="2CO 2:4"/></para>
  <para style="s">गेलती केरनाराह माफ</para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 2:5"/>केदी कुण बी नाराज किरेल हे, ते माहु ओलोस नाह, पुण केदी वोड़ावीन केय ताहार थोड़ोक थोड़ोक तुमू आखाह बी नाराज किरेल हे। <verse eid="2CO 2:5"/><verse number="6" style="v" sid="2CO 2:6"/>ओहला माणहान केरता जो डेंड जा बायह्या माय रेन जुलूम जाणे ताह आपेल हेते, तो जुलूम हे। <verse eid="2CO 2:6"/><verse number="7" style="v" sid="2CO 2:7"/>तानकेरता ज्यो हाजो हे काय तुमू तान गुनाह माफ किरो, एने ताह दिलासो आपु, ओहलो नाय एणे जुवे काय ओहलो माणुह दुखा माय बुड़ जाय। <verse eid="2CO 2:7"/><verse number="8" style="v" sid="2CO 2:8"/>तानकेरता मी तुमूह विन्ता केरथु काय तुमरो मोंग ताह देखाड़ो। <verse eid="2CO 2:8"/><verse number="9" style="v" sid="2CO 2:9"/>काहाकाय मी तुमूह ज्य जाणनेन केरता लिखेल ईतो। काय तुमू मारी आखी वातुह मानेन केरता तियार हेते काय नाह। <verse eid="2CO 2:9"/><verse number="10" style="v" sid="2CO 2:10"/>केदी तुमू कुणीह बी कायतान बी बाराम माफ केऱ्या एती, ते मी बी तुमूह माफ केरथु। काहाकाय मी तुमरी केरता मसीन सामने माफ केरथु, <verse eid="2CO 2:10"/><verse number="11" style="v" sid="2CO 2:11"/>काय सैतान तुमू पोर आदिकार नाय केरी, काहाकाय तुमू तान विचाराह रेन एंजाणल्या नाह सोता।<verse eid="2CO 2:11"/></para>
  <para style="s">त्रोआस माय पौलुसाह तेकलीत</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 2:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">2:12 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 20:1">प्रेरितान काम 20:1</ref>
      </char>
    </note>जेवी मी मसी यीशुन हाजाली खुबेर होमलाड़नेन त्रोआस हेयरा माय आवो, एने मालीक मार कामाह पुरो केरनेन केरता एक बायणो उगाड़ दिनो, <verse eid="2CO 2:12"/><verse number="13" style="v" sid="2CO 2:13"/>ते मार मोना माय आराम नाह जुड़नो, ज्यानकेरता काय मी मार बायाख तीतुसाह नाह मिलानो; तानकेरता मी ताह रेन मकादुनियाम जात रिनो।<verse eid="2CO 2:13"/></para>
  <para style="s">मसी माय जिकीन खुसी</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 2:14"/>पुण बोगवानान दन्यवाद एय जो मसी माय कायेम जिकने तिवाराम ली फिरेह, एने मसीन एकलीन हाजाली गेंद आमरे द्‍वारे आखी जागे पोसरावेह। <verse eid="2CO 2:14"/><verse number="15" style="v" sid="2CO 2:15"/>काहाकाय आमु बोगवानान आहने सुटकारो होदणाराह एने खेतेम एणाराह दुयून केरता मसीन हाजाली गेंद हेते। <verse eid="2CO 2:15"/><verse number="16" style="v" sid="2CO 2:16"/>जा खेतेम एण्या हेते तान केरता मोतीन गेंद, एने जा जीवण्या हेते तान केरता जीवणान हाजाली गेंद। हाजो ज्यी वातुन बाराबोर कुण हे? <verse eid="2CO 2:16"/><verse number="17" style="v" sid="2CO 2:17"/>काहाकाय आमु ता माणहान गेत नाह सोता, जा बोगवानान वचनाह सोतान फायदान केरता वापेर केरतेह, एने बोगवानान आमुह मोकलायेल हे। एने आमु मोनान खेराय माय बोगवानाह आहने जाणीन मसीन पावोरान गेत बोलतेह।<verse eid="2CO 2:17"/></para>
  <chapter eid="2CO 2"/>
  <chapter number="3" style="c" sid="2CO 3"/>
  <para style="s">नोवाली वाचान पावोर</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 3:1"/>काय आमु पोशा आमरी बोड़ाय केरने लागज्यो? दिहरा माणहान गेत आमु बी तुमू फाय रेन बोड़ाय ने पत्र लेणेन एने तुमूह आपणेन जोरवुत हे काय? <verse eid="2CO 3:1"/><verse number="2" style="v" sid="2CO 3:2"/>आमरो पत्र ते तुमूच हेते, जो आमरा मोना माय लेखायेल हे, एने ताह आखा माणहे ओलेखतेह एने वाचतेह। <verse eid="2CO 3:2"/><verse number="3" style="v" sid="2CO 3:3"/>एने ज्य देखाड़ेह काय आमरा सेवान वोजेसे तुमू मसीन पत्री हेते, जाह आमु पावोरान गेत मसी माय लिखेल हेते, एने तो साई केरीन देगड़ान पाटी पोर नाह, पुण जीवताला बोगवानान जीवा केरीन एने मोनान माह ने पाटी पोर लिखेल हे।<verse eid="2CO 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 3:4"/>मसीन द्‍वारे जो बोगवाना माय आमरो बुरहो हे, ताच ने वोजेसे बोलतेह। <verse eid="2CO 3:4"/><verse number="5" style="v" sid="2CO 3:5"/>ज्य नाह सोतो काय आमु आपणे आपाह ज्यान बाराबोर सोमेजतेह काय आमरी उगे रेन काल्लो बी काम केर सेकी, पुण आमरी लायकी बोगवानान उगे रेन हे। <verse eid="2CO 3:5"/><verse number="6" style="v" sid="2CO 3:6"/>बोगवान आमुह नोवाली कायदान पावोर एणेन केरता लायकीन बाणायेल हे, जो वायदो लिखेल कायदान पावोर नाह पुण चोखाला जीवान द्‍वारे हे, काहाकाय कायदो ते मारने, पुण जीव जीवाड़ ने।<verse eid="2CO 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 3:7"/>केदी मुसान कायदो जान अक्‍सर डेगड़ा पोर लिखेल एता, एने न्या वोर चोमेकताला काय मुसान मुया पोर बोगवानान बोड़ाय ने उजालान कारेण जो गेटती जातालो, इस्राएली माणहे तान मुयाह देख नाह सेकताला। <verse eid="2CO 3:7"/><verse number="8" style="v" sid="2CO 3:8"/>एने तो बोड़ाय खेतेम एय गियी, ते चोखाला जीवान सेवा वोदार चोमेकणार काहा नाय रेय? <verse eid="2CO 3:8"/><verse number="9" style="v" sid="2CO 3:9"/>केदी माणहाह दोसी ठेरावणार सेवा चोमेकणार हे, ते माणहाह सुटकारो आपणार सेवा वोदार चोमेकणार काहा नाय रेय! <verse eid="2CO 3:9"/><verse number="10" style="v" sid="2CO 3:10"/>एने नोवालो चोमेक जो जादा चोमेकणार हे, तान वोजेसे जुनालो चोमेक खेतेम ईती जाथे। <verse eid="2CO 3:10"/><verse number="11" style="v" sid="2CO 3:11"/>काहाकाय केदी तो गेटणार उजालो एतो, ते तो जो कायेम रेन उंजु बी चोमेकणार काहा नाय एय!<verse eid="2CO 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 3:12"/>तानकेरता आमु ओहली आसा मेलीन ईमोत हेऱ्या बोलतेह। <verse eid="2CO 3:12"/><verse number="13" style="v" sid="2CO 3:13"/>एने मुसान गेत नाह जो तान मुया पोर पुड़दो टाकेल ईतो, काय इस्राएली माणहे ता गेटणारा उजालाह खेतेम एतालो नाय देख सेकी? <verse eid="2CO 3:13"/><verse number="14" style="v" sid="2CO 3:14"/>पुण तान मोन वातड़ो एय गीयो, काहाकाय आज वोर जुनालो नेम वाचणे बुखेत तान मोना पोर पुड़दो डापाय रिथे, तिहेचकेरीन आज बी हे। पुण जेवी केदी एगदो माणुह मसी माय जोड़ाथे, ते तो पुड़दो सिटो एय जाथे। <verse eid="2CO 3:14"/><verse number="15" style="v" sid="2CO 3:15"/>काहाकाय आज वोर जेवी केदी मुसान पुस्तेक वाचाय जाथे, ते तान मोना पोर पुड़दो पुड़ेल रिथे। <verse eid="2CO 3:15"/><verse number="16" style="v" sid="2CO 3:16"/>पुण जेवी केदी तान मोन मालीकान उगे फिरी ताहार तो पुड़दो सिटो एय जाय।<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="ft" closed="false">पुण ओड़नी; पुड़दो निकालाय जाय।</char></note> <verse eid="2CO 3:16"/><verse number="17" style="v" sid="2CO 3:17"/>बोगवान ते जीव हे, एने जा का बी बोगवानान जीव हे ता आजादी हे। <verse eid="2CO 3:17"/><verse number="18" style="v" sid="2CO 3:18"/>पुण जेवी आपु आखान उगाड़ला मुया केरीन बोगवानान उजालो इहकेरीन देखहु, जिहकेरीन आरसा माय, ते बोगवानान द्‍वारे जो जीव हे, आमु तास चोमेकता वेह रूप माय थोड़ो थोड़ो केरीन बोदेलती जातेह।<verse eid="2CO 3:18"/></para>
  <chapter eid="2CO 3"/>
  <chapter number="4" style="c" sid="2CO 4"/>
  <para style="s">माटड्यान ठामलाम देन</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 4:1"/>तानकेरता जेवी आमु पोर ओहली गीण एनी काय आमुह जी सेवा जुड़नी, ते आमु ईमोत नाह सोड़ते। <verse eid="2CO 4:1"/><verse number="2" style="v" sid="2CO 4:2"/>पुण आमु लाज आवी ओहला कामे सोड़ देना, एने नाह मोठाय माय चालते, एने बोगवानान वचन माय सोतान फायदान केरता बेचेक केरती नाह; पुण खेरायीह देखाड़ीन बोगवानान ओंगाण एकेक माणहान मोना माय आपणे आपाह हाजा ठेरावतेह। <verse eid="2CO 4:2"/><verse number="3" style="v" sid="2CO 4:3"/>एने आमरी हाजाली खुबेर जी आमु होमलाड़तेह तान कारेण ज्यो पुड़दो पुड़ेल हे, ते जो खेतेम एणारान केरता पुड़ेल हे। <verse eid="2CO 4:3"/><verse number="4" style="v" sid="2CO 4:4"/>एने ता अविश्वासीन केरता जान इकेल ज्या दुनियान देव जो सैतान हे आंदलो केर दियेल हे। काहाकाय मसी जो बोगवानान वेह रूप हे तान चोमेकणार हाजाली खोबरीन उजालाह ता देख नाय सेकी। <verse eid="2CO 4:4"/><verse number="5" style="v" sid="2CO 4:5"/>आमु ते आमरो नाह पुण यीशु मसीन पारचार केरतेह काय तो मालीक हे, एने आमु सोता यीशु मसीन कारेण तुमरा पावोर हेते। <verse eid="2CO 4:5"/><verse number="6" style="v" sid="2CO 4:6"/>काहाकाय बोगवानुच हे जो कियेल, “आंदारा माय उजालो चोमके,” एने तोस आमरा मोना माय चोमेकनो काय बोगवानान बोड़ाय ने ओलखातान उजालो यीशु मसीन मुया केरीन उजालो एय।<verse eid="2CO 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 4:7"/>पुण आमु माटड्यान ठामलाम गेत हेते, जा माय आत्मिक मालदेन हे। ज्य देखाड़नेन केरता काय मोटली ताकेत आमरी उगे रेन नाह, पुण बोगवानाच उगे रेन ठेराय। <verse eid="2CO 4:7"/><verse number="8" style="v" sid="2CO 4:8"/>आमु चार उगे रेन सेंकेट वेटतेह, पुण खेतेम नाह केराते, एने काईच नाह जुड़ेत, पुण नाराज नाह एते; <verse eid="2CO 4:8"/><verse number="9" style="v" sid="2CO 4:9"/>माणहे पाड़ ते देतेह, पुण खेतेम नाह एते, एने माणहे सेतावतेह ते खोरा, पुण एखाला नाह पोड़ते। <verse eid="2CO 4:9"/><verse number="10" style="v" sid="2CO 4:10"/>आमु यीशुन मोतीह आमरा सेरीरा माय आखी टेम ली फिरतेह, काय यीशुन जीवाय बी आमरा सेरीरा माय देखाय। <verse eid="2CO 4:10"/><verse number="11" style="v" sid="2CO 4:11"/>काहाकाय आमु जा जीवणे बाजरेनाह, कायेम यीशुन कारेण मोतीन आथाम होपाय जातेह काय यीशुन जीवाय बी आमरा मुरेल सेरीर माय देखाय। <verse eid="2CO 4:11"/><verse number="12" style="v" sid="2CO 4:12"/>ज्यानकेरता मोत ते आमु माय, पुण जीवाय तुमू माय काम किरेह।<verse eid="2CO 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 4:13"/>तानकेरता आमरे माय तास बोरहान जीव हे, जान बाराम देरेम पुस्तेक माय लिखेल हे, “मी बुरहो किरेल तानकेरता मी बुलेल।” एने आमु बी बुरहो केरतेह, तानकेरता बोलतेह। <verse eid="2CO 4:13"/><verse number="14" style="v" sid="2CO 4:14"/>काहाकाय आमु जाणतेह काय जो बोगवान मालीक यीशुह जिवाड़ेल हे, तोच आमुह बी यीशु माय गोवांद्यो जाणीन जीवाड़ी, एने तुमरी हिऱ्यो आमुह बी तान ओंगाण उबो केरी। <verse eid="2CO 4:14"/><verse number="15" style="v" sid="2CO 4:15"/>काहाकाय आख्‍यु वोस्तु तुमरी केरता हेत्यु, ताकाय गीण मोकतास माणहा फाय जाथे तान द्‍वारे होवटो एन बोगवानान बोड़ाय ने केरता दन्यवाद बी वोदाड़े।<verse eid="2CO 4:15"/></para>
  <para style="s">बोरहा माय जीवणु</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 4:16"/>तानकेरता आमु ईमोत नाह सोड़ते, एने आमरो बाहेरल्यो सेरीर खेतेम ईती जाथे, पुण आमरो मायवालो सेरीर दाड़ीन दिह नोवालो ईती जाथे। <verse eid="2CO 4:16"/><verse number="17" style="v" sid="2CO 4:17"/>काहाकाय आमरो दुख जो थोड़ीक वार ने केरता हे, आमरे केरता जुलूम मोहत्वान केरता हे, एने आमरी जेलेमक्यो बोड़ाय ली आवीह। <verse eid="2CO 4:17"/><verse number="18" style="v" sid="2CO 4:18"/>एने आमु ते दिखेल वोस्तुह नाह, पुण नाह दिखेल वोस्तुह देखती रेतेह; काहाकाय दिखेल वोस्तु थोड़ास दिह्यान हे, पुण नाह दिखेल वोस्तु जेलेमक्यो बोणीन रिथे।<verse eid="2CO 4:18"/></para>
  <chapter eid="2CO 4"/>
  <chapter number="5" style="c" sid="2CO 5"/>
  <para style="s">आमरो हेरगावालो गेर</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 5:1"/>काहाकाय आमु जाणतेह काय देरतीन आवाल्या थोड़ीक वार ने केरता हेत्यु, जो आमरो सेरीर हे पाड़ाय जाय, एने आमुह बोगवाना उगे रेन हेरगा माय एक ओहलो सेरीर जुड़ी जो आथा केरीन बाणायेल गेर नाह, पुण जेलेमक्योस हे। <verse eid="2CO 5:1"/><verse number="2" style="v" sid="2CO 5:2"/>ज्या गेरा माय ते आमु आयेड़तेह एने मोटली लालुच मेलतेह काय आपणा हेरगान गेराह पिर लेय। <verse eid="2CO 5:2"/><verse number="3" style="v" sid="2CO 5:3"/>काय ज्याह पेरने से आमु नांगेरला नाय रेय। <verse eid="2CO 5:3"/><verse number="4" style="v" sid="2CO 5:4"/>एने आमु ज्या गेरा माय रितेन वोजा माय दाबाईन आयेड़ते रेतेह, काहाकाय आमु ताह उतारने नाह, पुण उंजु पेरने होद्तेह काय तो जो मोरनार हे, जीवणाम बुड़ जाय। <verse eid="2CO 5:4"/><verse number="5" style="v" sid="2CO 5:5"/>जो आमुह आवणारा टेम माय जुड़न्यो हे, ज्यो तान पुरावो हे, एने बोगवान आमुह बियाना माय जीव बी आपेल हे।<verse eid="2CO 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 5:6"/>आमु कायेम ईमोत केरीन रेतेह, एने ज्य जाणतेह काय जाह वोर आमु देरतीन सेरीरान गेरा माय रेतेह, ताह वोर आमु बोगवानाह रेन आंगे हेते। <verse eid="2CO 5:6"/><verse number="7" style="v" sid="2CO 5:7"/>काहाकाय आमरा जीवणा माय जो काय आमु देखतेह तो नाह, पुण बोगवाना पोर बुरहो केरतेह। <verse eid="2CO 5:7"/><verse number="8" style="v" sid="2CO 5:8"/>तानकेरता आमु ईमोत बांदिन रेतेह, एने सेरीराह रेन आंगे एन बोगवाना हेऱ्यो हेरगावाला गेराम रेणे जुलूम हाजो सोमेजतेह। <verse eid="2CO 5:8"/><verse number="9" style="v" sid="2CO 5:9"/>ज्यानकेरता आमरा मोनान मोरजी ज्यी हे, काय आमु देरतीन गेराम रेय नाहते हेरगावाला गेराम रेय पुण आमु ताह मोंगाल्ला लागती रिज्यो। <verse eid="2CO 5:9"/><verse number="10" style="v" sid="2CO 5:10"/><note caller="+" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="ROM 14:10">रोमीयो 14:10</ref></char></note>काहाकाय जोरवरी हे काय आपणो आखान हाल मसीन नियाव केरनेन जागे तान ओंगाण उगड़ी जाय। काय एकेक माणहान जान तान हाजा बाकता कामान बुदलो जा तान सेरीरान द्‍वारे किरेल हेते, ताह जुड़ी।<verse eid="2CO 5:10"/></para>
  <para style="s">बोगवाना हेऱ्यो पोशो मेल मिलाप यीशुन द्‍वारे</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 5:11"/>तानकेरता आमु बोगवानान बिय मानेन आमु माणहाह सोमजाड़तेह, पुण बोगवान आमरो पुरो हाल जाणेह, एने मारी आसा ज्यी हे काय आमरी ज्यी देसा तुमरा मोना माय बी उगड़ी। <verse eid="2CO 5:11"/><verse number="12" style="v" sid="2CO 5:12"/>तीबी आमु तुमरी ओंगाण आमरी बोड़ाय नाह केरती, पुण तुमूह टेम आपतेह काय तुमू आमु पोर मोठाय केरी। एने ताह जापाप आप सिकहो जा मोना पोर नाह, पुण दिखावट पोर मोठाय केरतेह। <verse eid="2CO 5:12"/><verse number="13" style="v" sid="2CO 5:13"/>केदी आमुह माणहे गांडा सोमेजतेह, ते बोगवानान केरता; एने केदी होस माय हेते ते तुमरी केरता। <verse eid="2CO 5:13"/><verse number="14" style="v" sid="2CO 5:14"/>काहाकाय यीशु मसीन मोंग आमुह मोजबुर किर दिथे; तानकेरता आमु ज्य सोमेजतेह काय जेवी एक आखान केरता मुरनो, ते आखा मोर गीया। <verse eid="2CO 5:14"/><verse number="15" style="v" sid="2CO 5:15"/>एने तो आखान केरता ज्यानकेरीन मुरेल काय जा जीवताला हेते, ता ओंगाण सोतान केरता नाय जिवी, पुण तानकेरता जिवी जो तानकेरता मुरेल एने पुशो जीव उठनो।<verse eid="2CO 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 5:16"/>तानकेरता एवी रेन आमु कुणी बी माणहाह होमेलने गेत नाय सुमेजहो, एने आमु मसीह बी सेरीरान गेत जाणेल एता, तीबी एवी रेन ताह इहकेरीन नाय जाणहु। <verse eid="2CO 5:16"/><verse number="17" style="v" sid="2CO 5:17"/>तानकेरता केदी एगदो मसी माय हे तो नोवाली बाणावोट हे; जुनाली वातु वित गीयुह दिखो, एवी आखी वातु नोवाली एय गीयुह। <verse eid="2CO 5:17"/><verse number="18" style="v" sid="2CO 5:18"/>ज्‍यु आखी वातु बोगवाना उगे रेन हेत्यु; जो मसीन द्‍वारे आपणी हिऱ्यो आमरो मेल मिलाप किर लियेल, एने मेल मीलापान सेवा आमुह हुप दियेल हे। <verse eid="2CO 5:18"/><verse number="19" style="v" sid="2CO 5:19"/><note caller="+" style="f"><char style="fr" closed="false">5:19 </char><char style="ft" closed="false">आखा माणहान जातीह मसीन द्‍वारे बोगवान आपुह दोस्ती बोणावीह; नाहते मसी माय बोगवान आखा माणहान जातीह आपुह दोस्ती बोणावीह।</char></note>बोगवान मसी माय एन ता हिऱ्यो दुनियान मेल मिलाप किर लिदो, एने तान गुनान दोस ता पोर नाह लागाड्यो, एने तो मेल मीलापान वचन आमुह हुप दियेल हे।<verse eid="2CO 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CO 5:20"/>तानकेरता आमु मसीन राजदुत हेते; सुमजो बोगवान आमरी द्‍वारे विन्ता केरने बाजरिनोह। एने आमु मसीन उगे रेन बोलतेह काय बोगवाना हेऱ्या मेल मिलाप किर लिवो। <verse eid="2CO 5:20"/><verse number="21" style="v" sid="2CO 5:21"/>जा पापाह रेन एंजाणल्या एता, ताहाच तो आमरे केरता पाप ठेरायेल काय आमु ता माय एन बोगवानान ओंगाण देरमी बोण जाती।<verse eid="2CO 5:21"/></para>
  <chapter eid="2CO 5"/>
  <chapter number="6" style="c" sid="2CO 6"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 6:1"/>आमु जा बोगवानान गोवांद्या एणेन नाते आमु ज्य बी सोमजाड़तेह काय तान गीण जो तुमू पोर ईयेल हे, ताह फालतुक जाणे मा दिवो।<verse eid="2CO 6:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 6:2"/>काहाकाय बोगवान किथे:</para>
  <para style="q2" vid="2CO 6:2">“आपणी खुसीन टेम माय मी तारी होमली लियेल,</para>
  <para style="q1" vid="2CO 6:2">एने सुटकारान दिह मी तारी मोदेक किरेल,”</para>
  <para style="q1" vid="2CO 6:2">एने दिखो एवी खुसीन टेम हे; एने दिखो एवी सुटकारान दिह हे!<verse eid="2CO 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 6:3"/>आमु काल्ली बी वातुम ठोकेर खाणेन टेम नाह आपते, काहाकाय आमरी सेवा, काम पोर काल्लो बी गुनो नाय आवी। <verse eid="2CO 6:3"/><verse number="4" style="v" sid="2CO 6:4"/>पुण एकेक वातु माय बोगवानान पावोरान गेत आमरा हाजाला गुणाह देखाड्या केरतेह, मोटली दिरी माय, गेरीबी माय, मुसीबत माय, <verse eid="2CO 6:4"/><verse number="5" style="v" sid="2CO 6:5"/><note caller="+" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="ACT 16:23">प्रेरितान काम 16:23</ref></char></note>चापका खाणे माय, जेलीम कोंडाणेम, गेरदीह रेन, कामा माय, जागताला रेणे माय, उपास केरनेम, <verse eid="2CO 6:5"/><verse number="6" style="v" sid="2CO 6:6"/>चोखाला माय, इकेल माय, दिरी माय, गीणीन द्‍वारा आमु खुद बोगवानान सेवक एणेन केरता, एने चोखाला जीवान द्‍वारा, एने बिगेर कोपेट खेरला मोंग माय, <verse eid="2CO 6:6"/><verse number="7" style="v" sid="2CO 6:7"/>खेरायीन वचना माय, बोगवानान ताकेत माय, एने देरमान आथ्‍यारा केरीन जा जेवड्या डाखऱ्या आथाम हेते, <verse eid="2CO 6:7"/><verse number="8" style="v" sid="2CO 6:8"/>मान एने मान नाह जुड़ने माय जिक एने आरवाणे माय बोटकावणारान गेत जाणाय जाथे, तीबी आमु खेराय माय बोलतेह। <verse eid="2CO 6:8"/><verse number="9" style="v" sid="2CO 6:9"/>एंजाणल्यान गेत हेते, तीबी आमरो नाव गाजेल हे; मुरेल ने गेत हेते, एने दिखो जीवताला हेते, मार खातेह, पुण माराय नाह जाते। <verse eid="2CO 6:9"/><verse number="10" style="v" sid="2CO 6:10"/>दुख मोणावणारान गेत हेते; पुण जेलेम खुस रेतेह, गेरीब हेते, पुण मोकतास माणहाह मालदार बाणाव देतेह; ओहला हेते काय आमु फाय कायच नाह तीबी आखो मेलतेह।<verse eid="2CO 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 6:11"/>एय कुरिंथीयो, आमु आख्‍यु वातु खोलीन तुमूह कियेल हेते, काहाकाय आमु मोन से तुमूह मोंग केरतेह। <verse eid="2CO 6:11"/><verse number="12" style="v" sid="2CO 6:12"/>एने आमरा मोनाह आमु तुमरी केरता बोंद नाह केऱ्या, पुण तुमूच आमरे केरता तुमरा मोनाह बोंद किर दियेल हेते। <verse eid="2CO 6:12"/><verse number="13" style="v" sid="2CO 6:13"/>पुण मी तुमूह मार सोरा जाणीन केथु, काय आमु पोर मोंग किरो जिहकेरीन आमु तुमूह मोंग केरतेह, एने आमरे केरता तुमरो मोन खुल दिवो।<verse eid="2CO 6:13"/></para>
  <para style="s">जीवताली बोगवानान मोंदिर</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 6:14"/>अविश्वासी हेऱ्या सेंगेत मा किरहो, काहाकाय देरमी एने एदेरमी माणहा हेऱ्यो काय मेल जोल? काय उजालान एने आंदारान काय मेल? <verse eid="2CO 6:14"/><verse number="15" style="v" sid="2CO 6:15"/>मसी एने सैतान हेऱ्यो काय मेल? एने विश्वासी हेऱ्यो अविश्वासीन काय नातो? <verse eid="2CO 6:15"/><verse number="16" style="v" sid="2CO 6:16"/><note caller="+" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="1CO 3:16">1 कुरिंथीयो 3:16</ref>; <ref loc="1CO 6:19">6:19</ref></char></note>एने मुरती हेऱ्यो बोगवानान मोंदिरान काय समंद? काहाकाय आमु ते जीवताला बोगवानान मोंदिर हेते! जिहकेरीन मालीक कियेल हे: “मी ता माय बोहुह,</para>
  <para style="q2" vid="2CO 6:16">एने ता माय चाला फिऱ्या केरूह;</para>
  <para style="q1" vid="2CO 6:16">एने मी तान बोगवान रेह,</para>
  <para style="q2" vid="2CO 6:16">एने ता मार माणहे एती।”<verse eid="2CO 6:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="2CO 6:17"/>तानकेरता बोगवान किथे,</para>
  <para style="q2" vid="2CO 6:17">“तान विची माय रेन निकलो</para>
  <para style="q2" vid="2CO 6:17">एने कुवालाच रिवो,</para>
  <para style="q2" vid="2CO 6:17">एने खाराब वोस्तुह मा सापलो,</para>
  <para style="q2" vid="2CO 6:17">ते मी तुमरो स्वीकार केरूह।<verse eid="2CO 6:17"/></para>
  <para style="q2">
    <verse number="18" style="v" sid="2CO 6:18"/>एने मी तुमरो आबोख एह,</para>
  <para style="q2" vid="2CO 6:18">एने तुमू मार बेटा बेटी ईहो,</para>
  <para style="q2" vid="2CO 6:18">ज्य आखाह रेन ताकेतवाला बोगवानान वचन हे।”<verse eid="2CO 6:18"/></para>
  <chapter eid="2CO 6"/>
  <chapter number="7" style="c" sid="2CO 7"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 7:1"/>एय मोंगाल्ला, जेवी ज्यो वायदो आमुह जुड़नो ते आवो, आपु आपणा आपाह सेरीरान एने जीवान आखा खाराब कामाह चोखो केरता। एने बोगवानाह बितेन चोखाला माय वोड़ता।<verse eid="2CO 7:1"/></para>
  <para style="s">पौलुसान खुसी</para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 7:2"/>आमुह तुमरा मोना माय जागु आपो। आमु कुणी हेऱ्या बी अन्याय नाह केऱ्या, नाह कुणीह बिगाड्या एने नाह कुणीन नुकसान केऱ्या। <verse eid="2CO 7:2"/><verse number="3" style="v" sid="2CO 7:3"/>मी तुमूह दोसी ठेरावणेन केरता ज्य नाह कित। काहाकाय मी पेलुस केय दियेल हे, काय तुमू आमरा मोना माय ओहला बोह गीयाह काय आमु तुमरी हेऱ्या मोरने जीवणेन केरता तियार हेते। <verse eid="2CO 7:3"/><verse number="4" style="v" sid="2CO 7:4"/>मी तुमूह जुलूम ईमोत हिऱ्यो बोलने बाजरिनोह, एने माहु तुमू पोर मोठाय हे; मी दिलासा माय बोराय गीयोह। मार आखा दुखा माय मी खुसी माय बोर पोर रेथु।<verse eid="2CO 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 7:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">7:5 </char>
      <char style="xt" closed="false">
        <ref loc="2CO 2:13">2 कुरिंथीयो 2:13</ref>
      </char>
    </note>काहाकाय जेवी आमु मकादुनिया माय आयेल तीबी आमरा सेरीराह आराम नाह जुड़नो, पुण आमुह चार उगे रेन दुख जुड़तालो: बाहेर जुलूम तेकलीत एती, एने आमरा मोना माय जुलूम बिय एती। <verse eid="2CO 7:5"/><verse number="6" style="v" sid="2CO 7:6"/>तीबी गेरब्याह दिलासो आपणार बोगवान तीतुस आवो, तेवी आमुह दिलासो आप्यो। <verse eid="2CO 7:6"/><verse number="7" style="v" sid="2CO 7:7"/>एने तान आवणे से ओलोस नाह पुण तान ती सान्ती बी, जी ताह तुमरी उगे रेन जुड़ेल एती। तो तुमरी लालुस तुमरा दुख, एने मार केरता तुमरा ईमोत ने खुबेर आमुह होमलाव्यो, एने ता केरीन माहु उंजु बी उत्साह जुड़नो।<verse eid="2CO 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 7:8"/>काहाकाय मी तुमूह मारी पत्री से दुख पोचाड़ेल हे, तीबी मी ज्याकेरीन पासतात नाह, जो मी पेल पासतातालो। काहाकाय मी देखथु काय ती पत्री से तुमूह दुख ते एनोह, पुण तो थोड़ीक वार ने केरता एतो। <verse eid="2CO 7:8"/><verse number="9" style="v" sid="2CO 7:9"/>एवी मी खुस हे, ज्यानकेरता नाह काय तुमूह दुख पोचनो, पुण ज्यानकेरता काय तुमू ता दुखान कारेण मोन फिराया, काहाकाय तुमरा दुख बोगवानान मोरजीन गेत एता, काय आमरी उगे रेन तुमूह काल्ली बी वातु माय नुकसान नाय पोची। <verse eid="2CO 7:9"/><verse number="10" style="v" sid="2CO 7:10"/>काहाकाय बोगवानान उगे रेन आवणार दुख ओहलो पासतावो पायदा किरेह जान परिणाम सुटकारो हे, एने पोशो ताह पासताणे नाह पुड़ेत। पुण दुनियान दुख मोत पायदा किरेह। <verse eid="2CO 7:10"/><verse number="11" style="v" sid="2CO 7:11"/>एने दिखो, जो दुख बोगवानान उगे रेन एनो, तुमरे माय कोलोक उत्साह, एने सोताह वोचाड़नेन आसा, एने राग, बिय, लालुस, खुसी, एने नियाव आपणेन विचार पायदा एनो? तुमू आखी बातीन ज्यो साबीत केरीन देखाड्यो काय तुमू ज्यी वातु से निर्दोस हेते।<verse eid="2CO 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 7:12"/>पुशो मी तुमू फाय ज्य लिखेल ईतो, तो नाहते ज्यानकेरता लिखेल जो नुकसान केऱ्यु, एने नाह तानकेरता जा पोर अन्याय केराय जायेल, पुण ज्यानकेरता काय तुमरी उत्साह जी आमरी केरता हे, ती बोगवान देख सेकी। <verse eid="2CO 7:12"/><verse number="13" style="v" sid="2CO 7:13"/>तानकेरता आमुह दिलासो जुड़नो।</para>
  <para style="p" vid="2CO 7:13">आमरी ज्यी सान्ती हेऱ्यो तीतुसान खुसीन कारीन उंजु बी खुस एनो, काहाकाय तान जीव तुमू आखान कारीन हरा बरा एय जायेल हे। <verse eid="2CO 7:13"/><verse number="14" style="v" sid="2CO 7:14"/>काहाकाय केदी मी तान ओंगाण तुमरे बाराम थोड़ोक मोठाय देखाड़ेल, तीबी लाजवानो नाह, पुण जिहकेरीन आमु तुमूह आखी वातु खेर खेरीच केय दियेल एता। तिहेकेरीन आमरो मोठाय केरने तीतुसान ओंगाण खेरलो निकेलनो। <verse eid="2CO 7:14"/><verse number="15" style="v" sid="2CO 7:15"/>जेवी तुमू तान स्वागत बिय बिन एने कापते कापतेन किरहो, एने तान उकुमान पालेन केरनेन केरता तियार रिहो ताहार तुमरी केरता तान मोंग वोदते जाय। <verse eid="2CO 7:15"/><verse number="16" style="v" sid="2CO 7:16"/>मी जुलूम खुस हे, काहाकाय मी आखी वातु माय तुमू पोर पुरो बुरहो केर सेकथु।<verse eid="2CO 7:16"/></para>
  <chapter eid="2CO 7"/>
  <chapter number="8" style="c" sid="2CO 8"/>
  <para style="s">खुसी से दान आपणु</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 8:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">8:1 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 15:26">रोमीयो 15:26</ref>
      </char>
    </note>एवी एय बाय बोणहा, जी बोगवानान गीण मकादुनियान मोंडल्यु पोर ईयेल हे, तान खुबेर तुमूह आपतेह। <verse eid="2CO 8:1"/><verse number="2" style="v" sid="2CO 8:2"/>काय मकादुनिया वाला माणहे तेकलीत माय मोटली पारेख माय तान खुसी एने जुलूम बारी गेरीबी माय तान उदारता जुलूम वोड़ गियी। <verse eid="2CO 8:2"/><verse number="3" style="v" sid="2CO 8:3"/>तान बाराम मारी ज्यी गोवाय हे, काय ता आपणी ताकेतीह रेन बोरीन पुण ताकेताह रेन बी बाहेर मोन से आपेल। <verse eid="2CO 8:3"/><verse number="4" style="v" sid="2CO 8:4"/>एने ज्या दानाह यहुदि मायवाला बोगवानान माणहान मोदेक केरनेन बागी एणेन केरता आमुह जाहार ताहार जुलूम विन्ता किरेल हेते। <verse eid="2CO 8:4"/><verse number="5" style="v" sid="2CO 8:5"/>एने जिहकेरीन आमु आसा किरेल एता, तिहेस केरीन ता मालीकाह पोशा बोगवानान मोरजी से आमुह बी आपणे आपाह आप देना। <verse eid="2CO 8:5"/><verse number="6" style="v" sid="2CO 8:6"/>तानकेरता आमु तीतुसाह विन्ता किरेल एता काय जिहकेरीन तो पेल सुरवात किरेल ईतो, तिहेस केरीन तुमरी विची माय दान लेणेन गीणीन कामाह लागातार किरतेच रेय। <verse eid="2CO 8:6"/><verse number="7" style="v" sid="2CO 8:7"/><note caller="+" style="f"><char style="fr" closed="false">8:7 </char><char style="ft" closed="false">आमरे केरता तुमरो मोंग; थोड़ाक लेख माय तुमरी केरता आमरो मोंग हे।</char></note>तानकेरता जिहकेरीन तुमू आखी वातुम, मतलब बुरहो, वचन, इकेल एने आखी बातीन उत्साह केरने माय, एने ता मोंग माय जो आमु पोर मेलतेह वोदते जातेह, तिहेस केरीन ज्य दान आपणेन गीणीन काम माय बी वोदती जावो।<verse eid="2CO 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 8:8"/>मी उकुमान रिती पोर ते नाह, पुण दिहराह आपणेन आसा एने तुमरा मोंगान खेरायीह पारेखणेन केरता केथु। <verse eid="2CO 8:8"/><verse number="9" style="v" sid="2CO 8:9"/>तुमू आमरा मालीक यीशु मसीन गीणीन बाराम जाणतेह, काय तो देनी एन बी तुमरी केरता गेरीब बोण गीयो, काय तो गेरीब एणेसे तुमू देनी बोण जावो।<verse eid="2CO 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 8:10"/>ज्यी वातुम मारी राय हे; ज्यो तुमरा केरता फायदु हे, जो काम तुमू गीये वोरीह चालु किरेल हेते, जाह केरने माय बी तुमूच पेल्ला एता। <verse eid="2CO 8:10"/><verse number="11" style="v" sid="2CO 8:11"/>तानकेरता एवी ज्यो काम पुरो किरो जिहकेरीन आसा केरने माय तियार एता, तिहेस केरीन जो तुमू आप सेकतेह तोलोक तुमू आप सेकतेह। <verse eid="2CO 8:11"/><verse number="12" style="v" sid="2CO 8:12"/>केदी तुमूह मोन से आपणेन मोरजी हे जो काय तुमू फाय हे, बोगवान ताह दानाह स्वीकार केरी, पुण तान गेत नाह जो तुमू फाय सोतोच नाह।<verse eid="2CO 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 8:13"/>आमरी आसा ज्यी नाह सोती काय दिहराह आराम एने तुमूह दुख जुड़ी। <verse eid="2CO 8:13"/><verse number="14" style="v" sid="2CO 8:14"/>पुण बाराबोरीन विचाराह रेन ज्यी टेम तुमरी वोड़ती तान कोमी माय काम आवी, काय तान वोड़ती बी तुमरी कोमी माय काम आवी काय बाराबोर एय जाय। <verse eid="2CO 8:14"/><verse number="15" style="v" sid="2CO 8:15"/>जिहकेरीन देरेम पुस्तेक माय लिखेल हे, “जो मोकतोस टुलो किरेल तान काय बी होवटो नाह निकेलनो, एने जो थोड़ो टुलो किरेल तान काय बी कोमी नाह निकेलनो।”<verse eid="2CO 8:15"/></para>
  <para style="s">तीतुसाह कुरिंथीयो माय मोकेलनो</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 8:16"/>बोगवानान दन्यवाद एय, काहाकाय तीतुस ने मोना माय ती उत्साह हे, जी आमुह मोदेक केरी। <verse eid="2CO 8:16"/><verse number="17" style="v" sid="2CO 8:17"/>काय तीतुस आमरो सोमजाड़नो मान लियेल, एने जुलूम खुस एन तो उत्साह माय तान मोरजी से तुमू फाय आवो। <verse eid="2CO 8:17"/><verse number="18" style="v" sid="2CO 8:18"/>आमु तीतुसा हेऱ्या ता बायाख बी मुकलेल हे, जान नाव हाजाली खोबरीन बाराम आखी मोंडली माय फेहली रेनोह। <verse eid="2CO 8:18"/><verse number="19" style="v" sid="2CO 8:19"/>एने ओलोस नाह, पुण मोंडलीन द्‍वारे ठेराय बी गीयोह, काय ज्या दान ने सेवान कामान केरता आमरी हिऱ्यो जाय। आमु ज्य काम ज्यानकेरता केरतेह काय मालीकान बोड़ाय एय, एने आमरी मोनान तियारी देखाय जाय।<verse eid="2CO 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CO 8:20"/>आमु ज्यी वातुम होमालीन रेतेह काय ज्या सोतान मोरजीन कामान बाराम जान सेवा आमु केरतेह, कुण बी आमु पोर गुनो नाय लागाड़ने जुवे। <verse eid="2CO 8:20"/><verse number="21" style="v" sid="2CO 8:21"/>काहाकाय ज्यी वातु मालीकान आहने ओलीस नाह, पुण माणहान आहने बी हाजी हे काय आमु तान कालजी केरतेह।<verse eid="2CO 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CO 8:22"/>आमु ता हेऱ्या आमरा बायाख बी मुकलेल हेते, जाह आमु जाहार ताहार पारखीन जुलूम वातु माय ईमोत वालो दिखेल हेते। पुण एवी तुमू पोर तान मुटलो बुरहो हे, ज्‍यीस कारेण माय तो उंजु बी दिहराह मोदेक केरनेन केरता होवटो तियार हे। <verse eid="2CO 8:22"/><verse number="23" style="v" sid="2CO 8:23"/>केदी एगदो तीतुसान बाराम फुशी, ते तो मार हाती एने तुमरी केरता मारो गोवांद्यो हे; एने केदी आमरा बायाख ने बाराम फुशी, ते ता मोंडलीन मोकलायेल एने मसीन बोड़ाय हेते। <verse eid="2CO 8:23"/><verse number="24" style="v" sid="2CO 8:24"/>तुमरो मोंग एने आमरो तो मोठाय जो तुमरी बाराम हे, मोंडल्युन ओंगाण ताह पुरो केरीन देखाड़ो।<verse eid="2CO 8:24"/></para>
  <chapter eid="2CO 8"/>
  <chapter number="9" style="c" sid="2CO 9"/>
  <para style="s">हाती मसी माणहान केरता मोदेक</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 9:1"/>एवी ती सेवान बाराम जी यहुदिया माय बोगवानान माणहान केरता केराय जाथे, माहु तुमरी केरता लेखणेन जोरवुत नाह सोती। <verse eid="2CO 9:1"/><verse number="2" style="v" sid="2CO 9:2"/>काहाकाय मी तुमरा मोनान तियारीह जाणथु, ज्यान कारीन मी तुमरी बाराम मकादुनिया वालान ओंगाण मोठाय केरथु काय आखायान माणहे एक साल रेन तियार एय रेनाह, एने तुमरो ईमोत उंजु बी मोकतास माणहाह तियार किरेल हे। <verse eid="2CO 9:2"/><verse number="3" style="v" sid="2CO 9:3"/>पुण मी बायाख ज्यानकेरता मुकलेल हे काय आमु जो मोठाय तुमरा बाराम केरतेह, तो ज्यी वातु माय फालतुक नाय ठेराय; पुण जिहकेरीन मी तुमूह कियेल तिहेस केरीन तियार रिज्यो, <verse eid="2CO 9:3"/><verse number="4" style="v" sid="2CO 9:4"/>ओहलो नाय एय काय केदी एगदो मार हेऱ्यो मकादुनिया रेन आवी, एने तुमूह तियार नाय देखी, ज्या बोरहान कारेण आमुह एने तुमूह बी लाजवाणे पोड़ी। <verse eid="2CO 9:4"/><verse number="5" style="v" sid="2CO 9:5"/>तानकेरता मी बायाख ज्यी विन्ता केरनेन जोरवुत सोमजेल काय ता पेलुस तुमरी फाय जाती, एने तुमरा सोतान मोरजीन फोल जान बाराम पेलुच रेन वायदो आपायेल एतो, तियार केर मेली काय ज्य दाबाव माय नाह पुण सोतान मोरजीन फोलान गेत तियार एय।<verse eid="2CO 9:5"/></para>
  <para style="s">पुरा मोना केरीन दान आपणु</para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 9:6"/>पुण वात ज्यी हे: जो थोड़ोक पिरेह, तो थोड़ोक काटती बी; एने जो मोकतोस पिरेह, तो मोकतोस काटी। <verse eid="2CO 9:6"/><verse number="7" style="v" sid="2CO 9:7"/>एकेक जिहकेरीन मोनाम ठाणी तिहेस केरीन दान केरी; एने नाह कुड़कुड़ावीन एने नाह दाबाव से काहाकाय बोगवान खुसी से आपणाराह मोंग किरेह। <verse eid="2CO 9:7"/><verse number="8" style="v" sid="2CO 9:8"/>बोगवान आखी बातीन गीण तुमूह जुलूम होवटो आप सेकीह, ज्याह रेन आखी वातु माय एने आखा टेम माय आखो काय, जो तुमूह जोरवुत हे तुमू फाय रेय; एने एकेक बातीन हाजा कामान केरता तुमू फाय जुलूम काय रेय। <verse eid="2CO 9:8"/><verse number="9" style="v" sid="2CO 9:9"/>जिहकेरीन देरेम पुस्तेक माय लिखेल हे:</para>
  <para style="q1" vid="2CO 9:9">“तो पुरा मोन से गेरब्याह दान आप्यो;</para>
  <para style="q2" vid="2CO 9:9">एने तान खेराय जेलेम बोणीन रेय।”<verse eid="2CO 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 9:10"/>जो पेरनाराह बिज एने खाणेन केरता रूटो आपेह, तो तुमूह बिज आपी, एने ताह फोलदार केरी एने तुमरा पुरा मोनान फोलाह वोदाड़ी। <verse eid="2CO 9:10"/><verse number="11" style="v" sid="2CO 9:11"/>तुमूह एकेक वातु माय मालदार बाणाय जाहो। ज्यान वोजेसे आखा माणहे बोगवानान दन्यवाद केरती। <verse eid="2CO 9:11"/><verse number="12" style="v" sid="2CO 9:12"/>काहाकाय ज्यी सेवाह पुरो केरने से बोगवानान माणहान जोरवुत पुरी ओलीस नाह ईत, पुण माणहान उगे रेन बोगवानान बी जुलूम दन्यवाद केरती। <verse eid="2CO 9:12"/><verse number="13" style="v" sid="2CO 9:13"/>ज्यी सेवाह पुरावो मानेन बोगवानान बोड़ाय केरतेह, काहाकाय तुमू मसीन हाजाली खोबरीह मानेन तान ताबा माय रेतेह; तान एने आखान मोदेक केरने माय खुसी रेतेह। <verse eid="2CO 9:13"/><verse number="14" style="v" sid="2CO 9:14"/>एने ता तुमरी केरता मोटला मोंग माय विन्ता केरतेह, ज्यानकेरता काय तुमू पोर बोगवानान मोटली गीण हे। <verse eid="2CO 9:14"/><verse number="15" style="v" sid="2CO 9:15"/>बोगवानान ता दानान केरता जो गेणतीह रेन बाहेर हे। दन्यवाद एय!<verse eid="2CO 9:15"/></para>
  <chapter eid="2CO 9"/>
  <chapter number="10" style="c" sid="2CO 10"/>
  <para style="s">पौलुस ने आदिकार</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 10:1"/>मी पौलुस जो तुमरी ओंगाण बुलो हे, पुण सेरीरान पासाण तुमरी उगे ईमोत केरथु, तुमूह मसीन गेरबोड़ाय एने हुवालाय ने केरता सोमजाड़थु। <verse eid="2CO 10:1"/><verse number="2" style="v" sid="2CO 10:2"/>मी ज्यी विन्ता केरथु काय तुमरी ओंगाण माहु विण बिय एन ईमोत केरने नाय पोड़ी, जिहकेरीन थोड़ाक माणहे आमुह सेरीरान गेत दुनियान रिती पोर चालनारे सोमेजतेह, एने ईमोत देखाड़णेन विचार केरथु। <verse eid="2CO 10:2"/><verse number="3" style="v" sid="2CO 10:3"/>काहाकाय ज्य खेरीच हे काय आमु दुनिया माय रेतेह, पुण दुनियान माणहान गेत नाह लेड़ते। <verse eid="2CO 10:3"/><verse number="4" style="v" sid="2CO 10:4"/>काहाकाय आमरी लेड़ायीन आथ्‍यार दुनियान नाह, पुण बोगवानान आथ्‍यार हेते जान द्‍वारे दुसमोनान गेड़ाह ओदारनेन केरता ताकेतवाला हेते। <verse eid="2CO 10:4"/><verse number="5" style="v" sid="2CO 10:5"/>तानकेरता आपु केल्पना माय एने एकेक मोठी वातुह, जी बोगवानान ओलखात ने विरोद माय उठीह, पाड़ देतेह; एने एकेक बावनाह कोंडीन मसीन उकुम माणनार बाणाव देतेह। <verse eid="2CO 10:5"/><verse number="6" style="v" sid="2CO 10:6"/>जेवी तुमू सोता पुरावो दिहो काय तुमू पुरी रिती माय उकुम माणनारे हेते; ते एकेक बातीन उकुम नाह माणनाराह डेंड आपणे केरता तियार रेतेह।<verse eid="2CO 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 10:7"/>तुमू तीच वातुह दिखो, जी डोलान सामने हे। केदी एगदाह खुद पोर बुरहो एय काय मी मसीन हे, ते तो ज्य बी जाण लेय काय जिहकेरीन तो मसीन हे, तिहेस केरीन आमु बी हेते। <verse eid="2CO 10:7"/><verse number="8" style="v" sid="2CO 10:8"/>काहाकाय केदी मी ता आदिकारान बाराम उंजु बी मोठाय देखाडु, जो बोगवान तुमूह बिगाड़नेन केरता नाह, पुण बाणावणेन केरता आमुह आपेल हे, ते लाजवाव नाय। <verse eid="2CO 10:8"/><verse number="9" style="v" sid="2CO 10:9"/>ज्यो मी ज्यानकेरता केथु काय मार पोत्रीन द्‍वारे तुमूह बिवाड़नार नाय ठेराव। <verse eid="2CO 10:9"/><verse number="10" style="v" sid="2CO 10:10"/>काहाकाय ता केतेह, “तान पोत्री ते ओलवी एने कमजोर हे; पुण जेवी तो सामने रिथे, ते तो सेरीराम कमजोर एने तान वचन फालतुक मालुम पुड़ेह!” <verse eid="2CO 10:10"/><verse number="11" style="v" sid="2CO 10:11"/>जा ओहलो केतेह, ता ज्यो सोमजी लेय काय जिहकेरीन आमु तुमरी हेऱ्या रेन सेटा हेते, जोहलो पोत्री माय आमु कठोर हेते, तिहेस केरीन तुमरी ओंगाण रेहु तेवी कठोर रेहु।<verse eid="2CO 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 10:12"/>काहाकाय आमुह ज्य ईमोत नाह काय आमु आपणे आपाह ताम रेन ता जा थोड़ाक ने हाती गेणाव नाहते ता माय आपणे आपाह मीलावी। जा आपणी बोड़ाय खुद केरतेह, ता सोता फोगा हेते, जेवी ता आपणा आपाह मापतेह। <verse eid="2CO 10:12"/><verse number="13" style="v" sid="2CO 10:13"/>आमु ते एद्दीन बाहेर केदी बी मोठाय नाय किरज्‍यो, पुण तीच एद्दीम वोर जी बोगवान आमरे केरता ठेरायेल हे; एने ता माय तुमू बी आव लागेल हेते। एने ताच ने गेत मोठाय बी केरहु। <verse eid="2CO 10:13"/><verse number="14" style="v" sid="2CO 10:14"/>काहाकाय आमु आमरी मोठाय ने एद्दीन बाहेर नाह जाते, केदी ओहलो एतो, ते आमु तुमू फाय मसीन हाजाली खुबेर लेन नाय पोचता, पुण मसीन खुबेर होमलाड़तेन तुमू फाय वोर पोच गीयाह। <verse eid="2CO 10:14"/><verse number="15" style="v" sid="2CO 10:15"/>आमु एद्दीन बाहेर दिहरान मेहनेत पोर मोठाय नाह केरती; पुण आमुह आसा हे काय जेवी तुमरो बुरहो वोदती जाय, तेवी आमरी एद्दी बी तुमरी कारेण वोदती जाय। <verse eid="2CO 10:15"/><verse number="16" style="v" sid="2CO 10:16"/>ताकाय आमु तुमरी एद्दीम रेन ओंगाण वोड़ीन हाजाली खुबेर होमलाड़ी, एने ज्य नाह काय आमु दिहरान एद्दी माय बाणायेल कामा पोर मोठाय केरी।<verse eid="2CO 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CO 10:17"/>जीहे देरेम पुस्तेक किथे, “जो मोठाय केरी तो मालीका माय मोठाय केरी।” <verse eid="2CO 10:17"/><verse number="18" style="v" sid="2CO 10:18"/>काहाकाय जो आपणो सोतान बोड़ाय किरेह ताह नाह, पुण जान बोड़ाय मालीक किरेह, तोच स्वीकार केराय जाथे।<verse eid="2CO 10:18"/></para>
  <chapter eid="2CO 10"/>
  <chapter number="11" style="c" sid="2CO 11"/>
  <para style="s">पौलुस एने जुठा प्रेरित</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 11:1"/>केदी तुमू मारी थोड़ीक फोगान वेठ लेता, ते ज्य हाजो एतो; होव, तुमू मारी वेठ बी लेतेह, <verse eid="2CO 11:1"/><verse number="2" style="v" sid="2CO 11:2"/>मी तुमरा बाराम बोगवानान गेत आसा लागाड़ीन रेथु। एने मी एकुच एदम्या हिऱ्यो वायदो किरेल हे, तो मसी यीशु हे, एने तुमूह चोखाली कुवारीन गेत होप देव। <verse eid="2CO 11:2"/><verse number="3" style="v" sid="2CO 11:3"/>पुण मी बिथु काय जिहकेरीन गेयड़ेक तान उशारी माय हवाह बेहकायेल, तिहेस केरीन तुमरो मोन ता खेरलाय एने चोखाला माय जो मसी हेऱ्यो एणे जुवे, खाराब नाय केराय जाय। <verse eid="2CO 11:3"/><verse number="4" style="v" sid="2CO 11:4"/>केदी एगदो तुमू फाय आवीन दिहरा यीशुन पारचार केरी, जान पारचार आमु नाह केऱ्या; एने तुमूह दिहरो जीव जुड़नो, जो पेल नाह जुड़ेल एतो, एने एगदी हाजाली खुबेर होमलाड़ी जीह तुमू पेल नाह मानेल एता, ते तुमू ताह वेठ लेतेह!<verse eid="2CO 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 11:5"/>मी नाह सोमेजथु काय मी ता खास प्रेरिताह रेन कोम हे, जाह तुमू मोटला सोमेजतेह। <verse eid="2CO 11:5"/><verse number="6" style="v" sid="2CO 11:6"/>मी बोलने माय एनाड़ी हे, तीबी इकेल माय नाह। आमु ज्यु एकेक वातु माय आखी बातीम तुमरी केरता केरीन देखाड़ेल हेते।<verse eid="2CO 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 11:7"/>मी सोताह बोलो किरेल काय तुमू बोगवानान नेजरी माय मोठा बुणो? पुण मी फुकेट माय हाजाली खुबेर तुमूह होमलाड़थु काय मी पाप किरेल। <verse eid="2CO 11:7"/><verse number="8" style="v" sid="2CO 11:8"/>मी दिहऱ्यु मोंडली फाय रेन मोंजरी लेन ताह लुटेल काय तुमरी सेवा केरू? <verse eid="2CO 11:8"/><verse number="9" style="v" sid="2CO 11:9"/><note caller="+" style="x"><char style="xo" closed="false">11:9 </char><char style="xt" closed="false"><ref loc="PHP 4:15-18">फिलेपियो 4:15-18</ref></char></note>एने जेवी मी तुमरी हिऱ्यो ईतो, एने माहु कोमी पोड़नी ते मी कुणी पोर बी बार नाह टाक्‍यो, काहाकाय बाहख मकादुनियाम रेन आवीन मार कोमी गेटीह पुरो किरेल; एने मी एकेक वात माय आपणे आपाह बार बोणने से रूकेल, एने ओंगाण बी रोकती रेह। <verse eid="2CO 11:9"/><verse number="10" style="v" sid="2CO 11:10"/>केदी मसीन खेरायी माहु माय हे, ते आखाया देसाम ओहलो मोठाय केरने से माहु कुण नाय रोक सेकी। <verse eid="2CO 11:10"/><verse number="11" style="v" sid="2CO 11:11"/>काहा? काय ज्यानकेरता मी तुमू हिऱ्यो मोंग नाह किरेत? बोगवान ते जाणेह काय मी मोंग केरथु।<verse eid="2CO 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 11:12"/>पुण जो मी केरथु; मी केरतीच रेह, एने जा ता सोताह मोटला प्रेरित केवातेह ताह मी मोठाय केरनेन मुको नाय आप सेकु जा माय आमु मोठाय केरतेह, एने तान मान सम्मान आमरी गेतुच एय। <verse eid="2CO 11:12"/><verse number="13" style="v" sid="2CO 11:13"/>काहाकाय ओहला माणहे जुठा प्रेरित, एने ठेगीन काम केरनारे, एने मसीन प्रेरितान वेह रूप बोदेलनारे हेते। <verse eid="2CO 11:13"/><verse number="14" style="v" sid="2CO 11:14"/>ज्यी काय बोंगलाणेन वात नाह, काहाकाय सैतान खुद बी हेरोगदुतान वेह रूप बुदलेह। <verse eid="2CO 11:14"/><verse number="15" style="v" sid="2CO 11:15"/>तानकेरता केदी तान पावोर बी देरमीन पावोरान गेत वेह रूप बोदली, ते काल्ली मोटली वात हे? पुण तान नियाव तान कामान गेत एय।<verse eid="2CO 11:15"/></para>
  <para style="s">प्रेरितान रूप माय पौलुसान दुख बोगणेम मोठाय</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 11:16"/>मी पुशो केथु, कुण बी माहु फुगो मा सोमजो, नाहते फुगो सोमजीन मारी वेठ लिवो, काय थोड़ीक मोठाय केर सेकु। <verse eid="2CO 11:16"/><verse number="17" style="v" sid="2CO 11:17"/>ज्या जीवान मोठाय माय जो काय मी केणे बाजरिनोह तो मी मालीकान उकुमान गेत नाह, पुण फोगान गेत केथु। <verse eid="2CO 11:17"/><verse number="18" style="v" sid="2CO 11:18"/>काहाकाय जुलूम माणहे सेरीरान गेत मोठाय केरतेह, तीबी मी गोमेंड केरूह। <verse eid="2CO 11:18"/><verse number="19" style="v" sid="2CO 11:19"/>तुमू ते सोमेजदार एन खुसी से फोगान वेठ लेतेह। <verse eid="2CO 11:19"/><verse number="20" style="v" sid="2CO 11:20"/>काहाकाय जेवी तुमूह एगदो पावोर बाणाव लिथे, नाहते तुमूह बारबाद किर दिथे, नाहते ठेग लिथे नाहते आपणे आपाह मोटलो बाणावीह, नाहते तुमरा मुया पोर थापोड़ दिथे, ते तुमू तान वेठ लेतेह। <verse eid="2CO 11:20"/><verse number="21" style="v" sid="2CO 11:21"/>मी लाजवायीन ज्य केथु काय आमु एका दिहरा हेऱ्या गेणती केरीन कोमजोर एय गीयाह,</para>
  <para style="p" vid="2CO 11:21">पुण जी बी वातुम एगदो मोठाय केरनेन केरता ईमोत किरेह, ते मी गांडान गेत केथु, ते मी बी ईमोत केरथु। <verse eid="2CO 11:21"/><verse number="22" style="v" sid="2CO 11:22"/>काय ता ओलास इब्रानी हेते? मी बी हे। काय ता ओलास इस्राएली हेते? मी बी हे। काय ता ओलास अब्राहामान वोस हेते? मी बी हे। <verse eid="2CO 11:22"/><verse number="23" style="v" sid="2CO 11:23"/><note caller="+" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="ACT 16:23">प्रेरितान काम 16:23</ref></char></note>काय ता ओलास मसीन पावोर हेते? मी गांडान गेत केथु, मी ताह रेन वोदिन हे। जास्ती मेहनेत केरने माय; जाहार ताहार जेलीम कोंडाणेम; चापका खाणे माय; जाहार ताहार मोतीन दाक माय। <verse eid="2CO 11:23"/><verse number="24" style="v" sid="2CO 11:24"/>पाच वारीन मी यहुदिन आथा केरीन एकोन चाड़ीस एकोन चाड़ीस चापका खाईल। <verse eid="2CO 11:24"/><verse number="25" style="v" sid="2CO 11:25"/><note caller="+" style="x"><char style="xo" closed="false">11:25 </char><char style="xt" closed="false"><ref loc="ACT 16:22">प्रेरितान काम 16:22</ref>; </char><char style="xt" closed="false"><ref loc="ACT 14:19">प्रेरितान काम 14:19</ref></char></note>तीन वारीन आरीवाला डेंगा केरीन मार खाईल; एने एक वारीन माहु देगड़ा केरीन दियेल; तीन वारीन डोंडह्यो जा पोर मी बुहेल ईतो तो टुट जायेल; एक रात ने दिह मी देरीया माय रियेल। <verse eid="2CO 11:25"/><verse number="26" style="v" sid="2CO 11:26"/><note caller="+" style="x"><char style="xo" closed="false">11:26 </char><char style="xt" closed="false"><ref loc="ACT 9:23">प्रेरितान काम 9:23</ref>; </char><char style="xt" closed="false"><ref loc="ACT 14:5">प्रेरितान काम 14:5</ref></char></note>मी जाहार ताहार यात्राम नेदीन दाकाम, डाकुन दाकाम, यहुदि माणहान दाकाम; बिगेर यहुदि माणहान दाकाम; गावल्यान दाकाम; जेंगलान दाकाम; देरीयान दाकाम; जुठा बायह्यान दाकान विची माय रिनो। <verse eid="2CO 11:26"/><verse number="27" style="v" sid="2CO 11:27"/>मेहनेत एने केस्टाम; जाहार ताहार जागते रेणे माय; बुखल्यो तिहल्यो रेणे माय; जाहार ताहार उपास केरने माय; ईवाला माय उगाड़लो रेणे माय; <verse eid="2CO 11:27"/><verse number="28" style="v" sid="2CO 11:28"/>एने दिहऱ्यु वातुह सोड़ीन जान बाराम मी नाह किरेत; आखी मोंडलीन कालजी दाड़ीन दिह माहु दाबेह। <verse eid="2CO 11:28"/><verse number="29" style="v" sid="2CO 11:29"/>केदी एगदो कमजोर हे, ते काय मी कमजोर नाह ईत? एने एगदाह ठोकर लागेह ते काय मारा जीवाम दुख नाह ईत?<verse eid="2CO 11:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2CO 11:30"/>केदी मोठाय केरने जोरवरी हे, ते मी मारी कमजोरीन वातु पोर मोठाय केरूह। <verse eid="2CO 11:30"/><verse number="31" style="v" sid="2CO 11:31"/>मालीक यीशु बोगवान एने आबोख जो कायेम दन्यवादीत हे, जाणेह काय मी जुठ नाह बुलेत। <verse eid="2CO 11:31"/><verse number="32" style="v" sid="2CO 11:32"/><note caller="+" style="x"><char style="xo" closed="false">11:32 </char><char style="xt" closed="false"><ref loc="ACT 9:23-25">प्रेरितान काम 9:23-25</ref></char></note>दमिश्‍कान अरितास राजान उगे रेन जो आदिकारी ईतो, माहु देरावणेन केरता दमिश्‍कान हेयरान गेड़ान बायणा हेऱ्यो सिपायाह जागल्यो बोहाड़ रियेल ईतो। <verse eid="2CO 11:32"/><verse number="33" style="v" sid="2CO 11:33"/>तेवी एक टोपलाम बोहाड़ीन गेड़ान एक खिड़की माय रेन माहु नेचो उताराय जायेल, एने इहकेरीन मी तान आथाम देराणे से वोच जायेल। <figure style="fig" alt="Entrance to the city gate and wall" file="hk00238c.tif" size="col" copy="Horace Knowles ©" ref="11:32">हेयरान बायणो एने बितड़ा निही रिगणे</figure><verse eid="2CO 11:33"/></para>
  <chapter eid="2CO 11"/>
  <chapter number="12" style="c" sid="2CO 12"/>
  <para style="s">पौलुसान दर्शन एने कोमजोरी</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 12:1"/>एवी मोठाय केरने मार केरता ठिक नाह तीबी केरने पुड़ेह, ज्यानकेरता मी मालीक आपेल दर्शनान एने उजालान चेरचा केरूह। <verse eid="2CO 12:1"/><verse number="2" style="v" sid="2CO 12:2"/>मी मसी यीशु माय एक जाणाह जाणथु; जाह चोवदा वोरह्या पेल तीसरा हेरगा माय विसाय जायेल ईतो। ओहला सेरीरा बेल ईयेल एतो एने विण सेरीरा हेऱ्यो ज्य माहु नाह मालुम। बोगवानाह जी वातुन जाणकारी हे, <verse eid="2CO 12:2"/><verse number="3" style="v" sid="2CO 12:3"/>मी ओहला माणहाह सेरीरा हिऱ्यो नाहते सेरीरान बिगेर नाह मालुम, ज्यो ते बोगवानुस जाणेह। <verse eid="2CO 12:3"/><verse number="4" style="v" sid="2CO 12:4"/>एने हेरगा माय विसाय गीयो, एने केवाय नाय ओहल्यु वातु होमलेल; जी माणहाह बोलनेन पारवांगी नाह। <verse eid="2CO 12:4"/><verse number="5" style="v" sid="2CO 12:5"/>ओहला माणहा पोर मोठाय केरूह, पुण मारी कोमजोरीह सोड़ीन आपणा आपा पोर मोठाय नाय केरू। <verse eid="2CO 12:5"/><verse number="6" style="v" sid="2CO 12:6"/>केदी मी मोठाय केरने होदु तीबी फुगो नाय एव, काहाकाय मी खेरीच केथु; तीबी रोकाय जाथु; ओहलो नाय जिहकेरीन माहु दिखेह नाहते माहु फाय रेन होमलेह, जो काय मी हे ताह रेन वोदार कुण नाय सोमजी।<verse eid="2CO 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 12:7"/>ज्यानकेरता काय मी उजालान मोकतास ने कारेण फुहलाय नाय जाव, एने मार सेरीराम एक काटो टोचलेल हे मतलब सैतानान एक दुत ने माहु दुमा दियेल ताकाय फुहलाय नाय जाव। <verse eid="2CO 12:7"/><verse number="8" style="v" sid="2CO 12:8"/>ज्यान बाराम मी मालीकाह तीन वारीन विन्ता किरेल काय ज्यो मार हेऱ्यो रेन सेटो एय जाय। <verse eid="2CO 12:8"/><verse number="9" style="v" sid="2CO 12:9"/>पुण मालीक माहु केयो, “मार गीण तार केरता जुलूम हे, काहाकाय मार सेक्ती कोमजोरी माय पाकी ईथे।” तानकेरता मी खुसी से मारी कमजोरी पोर गोमेंड केरूह काय मसीन सेक्ती मार पोर सावलो केरती रेय। <verse eid="2CO 12:9"/><verse number="10" style="v" sid="2CO 12:10"/>मी मसीन केरता कोमजोरी माय एने चिहटाम, एने गेरीबीम, दुखाम, सेतावाम, केठणायीम खुस हे, काहाकाय मी कोमजोर एथु; तेवी ताकेतवान रेथु।<verse eid="2CO 12:10"/></para>
  <para style="s">कुरिंथीयोन केरता पौलुसान कालजी</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 12:11"/>मी फुगो ते बुणेल; पुण तुमूच माहु ज्य केरनेन मोजबुर किरेल। तुमू ते मारी बोड़ाय केरने जोवताला, काहाकाय एवी मी कायच बी नाह, तीबी ता मोटला प्रेरिताह रेन काल्ली बी वातुम कोम नाह। <verse eid="2CO 12:11"/><verse number="12" style="v" sid="2CO 12:12"/>प्रेरितान निसाणी बी तुमरी विचीम जुलूम दिरी हेऱ्यो चोमेत्कार, एने बोंगलाय ओहला कामे, एने ताकेत ने काम देखाड़ाय गीया। <verse eid="2CO 12:12"/><verse number="13" style="v" sid="2CO 12:13"/>तुमू काल्ली वातु बी माय दिहरी मोंडलीह रेन कोम एता, ओलोस काय मी तुमू पोर मारो वोजो नाह टाकेल। मारो ज्यो अन्याय माफ किरो।<verse eid="2CO 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 12:14"/>मी तिसरी वार तुमू फाय आवणेन केरता तियार हे, एने मी तुमू पोर कायच वोजो नाय मेलु, काहाकाय मी तुमरो मालदेन नाह, पुण मी तुमूच मोंग केरथु। काहाकाय सोराह तान आईख आबाख ने केरता देन टुलो नाय केरने जुवे, पुण आईख आबाख सोरान केरता देन टुलो केरने जुवे। <verse eid="2CO 12:14"/><verse number="15" style="v" sid="2CO 12:15"/>मी तुमरी केरता जो काय हे खुसी से खीरलो केरूह, एने मी बी खेरचाय जाह पुण तुमूह होवटो मोंग केरथु, ते काय मारो मोंग तुमूह रेन कोम एय? काहाकाय मी तुमूह जादा मोंग केरथु।<verse eid="2CO 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 12:16"/>दिहरा माणहे केय सेकते, पुण एगदो इहकेरीन केय सिकेह काय मी तुमूह उशारी माय फासाड़ लियेल हे। <verse eid="2CO 12:16"/><verse number="17" style="v" sid="2CO 12:17"/>जाह मी तुमू फाय मुकलेल, काय ताम रेन एगदान द्‍वारे मी तुमरो काह फायदो विसेल? <verse eid="2CO 12:17"/><verse number="18" style="v" sid="2CO 12:18"/>मी तीतुसाह सोमजाड़ीन ता हिऱ्यो ता बायाख मुकलेल, ते काय तीतुस तुमरो गेलेत फायदो विसेल? एने आमु एकुच उद्देश पोर नाह चालना काय?<verse eid="2CO 12:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2CO 12:19"/>तुमू एवी वोर सोमेजणे बाजरेनाह काय आमु सोतान वोचाव केरतेह, पुण जिहकेरीन मसी हुदिह, तिहेस आमु बोगवानाह आहने जाणीन बोलतेह, एने एय मोंगाल्ला, आख्‍यु वातु तुमरी वोड़तीन केरता केतेह। <verse eid="2CO 12:19"/><verse number="20" style="v" sid="2CO 12:20"/>माहु बिय हे, ओहलो नाय एय काय मी आवीन जोहलो होदथु, तोहलोस तुमूह नाय देखु; एने माहु बी जोहलो तुमू नाह होदते, तोहलोस दिखहो; एने तुमू माय लेड़ाय, कुयराय, राग, विरोद, ईर्ष्या, चुगली, मोठाय एने लेड़ाय एय। <verse eid="2CO 12:20"/><verse number="21" style="v" sid="2CO 12:21"/>एने ओहलो नाय एय काय मार बोगवान माहु पुशो तुमरी न्या आवणेन केरता माहु पोर दाबाव टाकी, एने माहु पोशो दुख मोणावणे पोड़ी जा पेल पाप किरेल एता, एने खाराब कामे, सिनालो एने हावुस जो ता केरतेह, मोन नाह फिराया।<verse eid="2CO 12:21"/></para>
  <chapter eid="2CO 12"/>
  <chapter number="13" style="c" sid="2CO 13"/>
  <para style="s">सेवली चेतावणी एने नमस्‍कार</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 13:1"/>एवी मी तिसरी वार तुमू फाय आवथु; एने एकेक मुकदमो दुय नाहते तीन माणहान पुरावान द्‍वारे ठेराय जाय। <verse eid="2CO 13:1"/><verse number="2" style="v" sid="2CO 13:2"/>जिहकेरीन मी दुसरी वार तुमरी हिऱ्यो ईतो, तिहेस केरीन एवी सिटो रिते लेन ता माणहे जा पेल पाप किरेल, एने दिहरा आखा माणहाह एवी केय देथु काय केदी मी पुशो आवुह ते नाय सोडु। <verse eid="2CO 13:2"/><verse number="3" style="v" sid="2CO 13:3"/>काहाकाय तुमू ते तान पुरावो होद्तेह काय मसी मार माय बुलेह, जो तुमरी केरता कोमजोर नाह पुण तुमरे माय ताकेतवालो हे। <verse eid="2CO 13:3"/><verse number="4" style="v" sid="2CO 13:4"/>मसी कोमजोरान केरता खुरूसखाम पोर चेड़ावाय ते जायेल, तीबी बोगवानान सेक्ती से जीवतालो हे। आमु बी मसी माय कमजोर हेते, पुण आमु बोगवानान सेक्ती से जीवताला हेते, तुमरी सेवा केरनेन केरता।<verse eid="2CO 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 13:5"/>आपणे आपाह पारखो काय बोरहा माय हेते काय नाह? एने आपणे आपाह जाचो। काय तुमू तुमरा बाराम ज्य नाह जाणते काय यीशु मसी तुमरे माय हे? नाहते तुमू जाच माय ठेगऱ्या निकेलनाह। <verse eid="2CO 13:5"/><verse number="6" style="v" sid="2CO 13:6"/>पुण मारी आसा हे काय तुमू जाण लिहो काय आमु ठेगऱ्या नाह। <verse eid="2CO 13:6"/><verse number="7" style="v" sid="2CO 13:7"/>आमु आमरा बोगवानाह ज्यी विन्ता केरतेह काय तुमू कायच बुराय नाय केरी, ज्यानकेरता नाह काय आमु खेरला देखाय, ज्यानकेरता काय तुमू हाजो केरनार बोणी, चाहे आमु ठेगऱ्या ठेराहु। <verse eid="2CO 13:7"/><verse number="8" style="v" sid="2CO 13:8"/>काहाकाय आमु खेरायीन विरोद माय कायच नाह केर सेकते, पुण खेरलाच ने केरता केर सेकतेह। <verse eid="2CO 13:8"/><verse number="9" style="v" sid="2CO 13:9"/>जेवी आमु कोमजोर एतेह तुमू ताकेतवाला एतेह ते आमु खुस एतेह, एने ज्यी विन्ता बी केरतेह काय तुमू एकेक वाती माय पुरा बोणी। <verse eid="2CO 13:9"/><verse number="10" style="v" sid="2CO 13:10"/>ज्यीच कारेण मी सिटो रेन बी तुमूह जी सोब वातु पेलुच रेन लेखणे बाजरिनोह, जेवी मी तुमू फाय आवुह; तेवी मालीक आपेल आदिकार ने वापेर कठोर बाव माय नाय केरने पोड़ी।<verse eid="2CO 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 13:11"/>एवी सेवली बुखेत एय बाय बोणहा, खुस रिवो; तुमरो सोबाव साप मिलो; एका दिहराह उत्साहित किरते रिवो; एकुच मोन मिलो; ईलीमिलीन रिवो। मोंग एने सान्ती आपणार बोगवान तुमरी हिऱ्यो रेय।<verse eid="2CO 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 13:12"/>बोगवानान चोखाला मोंग माय एका दिहराह नमस्‍कार किरो। एने आखा बोगवानान माणहे तुमूह नमस्‍कार केतेह।<verse eid="2CO 13:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 13:13"/>तुमू पोर मालीक यीशु मसीन गीण, बोगवानान मोंग, एने चोखाला जीवान सेंगेत तुमू हेऱ्यी रेय। <verse eid="2CO 13:13"/><verse number="14" style="v" sid="2CO 13:14"/>मालीक यीशुन गीण एने बोगवानान मोंग एने चोखाला जीवान मेल मिलाप आपु आखा हेऱ्यो ईती रेय।<verse eid="2CO 13:14"/></para>
  <chapter eid="2CO 13"/>
</usx>
