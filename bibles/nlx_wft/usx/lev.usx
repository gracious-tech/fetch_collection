<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LEV" style="id">- Nahali</book>
  <para style="h">लेव्य</para>
  <para style="toc3">लेव्यवस्था</para>
  <para style="toc2">लेव्य</para>
  <para style="toc1">लेव्यव्यवस्था</para>
  <para style="mt2">मुसा ने लिखी हुई किताब</para>
  <para style="mt1">मुसो लिखेल पुस्तेक</para>
  <para style="imt">ओलखात</para>
  <para style="ip">लेव्यव्यवस्था ता नेमा केरीन बुणेल हे जाह बोगवान मुसान द्‍वारे इस्राएल माणहाह आपेल इतो। ज्या नेम बोल्युह चेड़ावणे एने मिलापवाला तोम्बु माय पुजा विदीह कायेम केरनेन बाराम हे। “लेव्यव्यवस्था” सोबदान मतलब हे “लेवीन बाराम,” जो इस्राएल ने तो गेराणो एतो जाह बोगवान चाकऱ्यो बोणने एने मोंदिर ने देखरेत केरनेन केरता निवाड़ेल इतो। रिती रिवाज ने रूप से बुद्दीमानान मान्नो हे काय लेव्यव्यवस्थान पुस्तेक, एने आरहीच पंचग्रंथ ने दिहरा पुस्तेके उत्पत्ती, निर्गमन, गिनती एने व्यवस्थाविवरण जाणाव केरनारान मुसान द्वारा लेखायेल एती। ओहलो मालुम इथे काय खुद ग्रंथ बी ज्यान उगे इशारो किरेह, काहाकाय <char style="xt"><ref loc="LEV 1:1">1:1</ref> </char> माय लिखेल हे बोगवान ज्यु वातु मुसाह कियेल इतो। थोड़ाक बुद्दीमानान ज्य बी मान्नो हे काय ज्य पुस्तेक जुनाला पुरावो केरीन टुलो एन 5 वा नाहते 6 व्वा शतकाम यीशुन पेल बाबुल माय तियार केरायेल एती।</para>
  <para style="ip">लेव्यव्यवस्थान सुरवात माय आपु वाचतेह काय बोगवान चाकऱ्याह बातबातीन बोली चेड़ावणेन उकुम आप्यो। न्या माय रेन थोड़ीक बोली माणहान पापान केरता चेड़ावाय जाताला। दिहरी बोली सोतान मोरजी से, एगदा माणहान बोगवानान बाराम मोंगान वोजेसे चेड़ावाय जाय सेकताला। एक एक टेमा माय ज्य जोरेवरी एतो काय बोली चोखी एने निर्दोस रेय, मतलब माणहान उगे रेन आखाम रेन हाजो रेय। ज्य साप रिती से बोगवानान चोखापोणाह देखाड़तालो। पुस्तेकान सेवेटल्या बागाम ज्य सोमजाड़ेल हे काय इस्राएली एने चाकऱ्या किहीक चोखा रेय सेकतेह नाहते ओवता किहीक एठोपोणा से चोखा एय सेकतेह। ज्या पुस्तेकान मुखी विषय ज्यो हे काय बोगवान चोखो हे, एने ज्या पुस्तेक माय आपेल नेमान पालेन केरीन इस्राएली बोगवानान उपस्थिती माय रेय सेकताला।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. बातबातीन बोली चेड़ावणेन नेमान उकुम आपेल हे। <char style="ior"><ref loc="LEV 1-7">1–7</ref> </char></para>
  <para style="io1">2. हारून एने तान सोराह चाकऱ्यो निवाड़णेन वर्णन हे।<char style="ior"><ref loc="LEV 8-10">8–10</ref></char></para>
  <para style="io1">3. चोखो एने एठो खाणो एने बेमारीन बाराम विद्यु आपेल हे।<char style="ior"><ref loc="LEV 11-16">11–16</ref> </char></para>
  <para style="io1">4. खाणो, तिवार, खाराब वेवार एने विहेवणेन वोरीह जीहे विषया पोर बातबातीन दिहरा उकुम कियेल हे।<char style="ior"><ref loc="LEV 17-27">17–27</ref></char></para>
  <chapter number="1" style="c" sid="LEV 1" />
  <para style="s">होम बोलीन वेदी</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 1:1" />तेवी यहोवा मुसाह हादिन मिलापवाला तोम्बु माय रेन मुसाह केयो, <verse eid="LEV 1:1" /><verse number="2" style="v" sid="LEV 1:2" />“इस्राएल ने माणहाह के काय तुमरे माय रेन केदी एगदो माणुह यहोवान केरता बोली लावे, ताहार तो मेंड्रा बोकड्या नाहते पालन्या जेनवेरा माय रेंच लावीन चेड़ावे।”<verse eid="LEV 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 1:3" />“केदी एगदो माणुह पालन्या जेनवेरा माय रेन बोली केरी, ताहार बिगेर दोसावालो जेनवार मिलापवाला तोम्बुन बायणा पोर चेड़ावे काय यहोवा ताह स्वीकार किरे। <verse eid="LEV 1:3" /><verse number="4" style="v" sid="LEV 1:4" />तो तान आथ बोली चेड़ावण्या जेनवारान मुंडी पोर मेली, एने तो तानकेरता बोली केरनेन स्वीकार केराय जाय। <verse eid="LEV 1:4" /><verse number="5" style="v" sid="LEV 1:5" />तेवी तो ता वासड़ाह यहोवान सामने बोली केरी; एने हारूनान बिटोख जो चाकर्‍यो हे, तो लुयीह आहने ली जाएन ती वेदीन कावदेन सिड़के जो मिलापवाला तोम्बुन बायणा पोर हे। <verse eid="LEV 1:5" /><verse number="6" style="v" sid="LEV 1:6" />उवतो तो बोली चेड़ावण्या जेनवारान चामड़ो काड़ीन ता जेनवेराह टुकड़ा टुकड़ा किरे; <verse eid="LEV 1:6" /><verse number="7" style="v" sid="LEV 1:7" />तेवी हारून चाकर्‍यान बिटोख वेदी पोर आक्‍ठो पेटाड़ी, एने आक्‍ठा पोर लाकड़े हिसाड़ेन मेली। <verse eid="LEV 1:7" /><verse number="8" style="v" sid="LEV 1:8" />एने हारूनान बिटोख जो चाकर्‍यो हे, मुंड एने चेरबा बेल जेनवारान टुकड़ा ता लाकड़ा पोर जा वेदीन आक्‍ठा पोर रेय हिसाड़ेन मेली; <verse eid="LEV 1:8" /><verse number="9" style="v" sid="LEV 1:9" />एने तो तान आतड्या एने पायाह पाण्या केरीन दोवी। तेवी चाकर्‍यो आखा ईसाह वेदी पोर हेलगाड़े ज्‍यीस होमबोली हे, काहाकाय ज्यी होमबोली आक्‍ठान द्वारा यहोवाह खुस केरनी गेंदाणी बोली ठेराय।”<verse eid="LEV 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 1:10" />केदी एगदो माणुह मेंड्रा नाहते बोकड़ान होमबोली चेड़ावी, ताहार पुरो निर्दोस नर जेनवार चेड़ावे। <verse eid="LEV 1:10" /><verse number="11" style="v" sid="LEV 1:11" />एने तो जेनवाराह यहोवान ओंगाण वेदीन उत्तर ने उगे बोली किरे; एने हारूनान बिटोख जो चाकर्‍यो हे, तो तान लुयीह वेदीन कावदेन सिड़के। <verse eid="LEV 1:11" /><verse number="12" style="v" sid="LEV 1:12" />एने चाकर्‍यो जेनवारान टुकड़ा टुकड़ा किरे, मुंड एने चेरबीह आलेग किरे, एने चाकर्‍यो ज्या आखाह ता लाकड़ा पोर हिसाड़ेन मेली जी वेदीन आक्‍ठा पोर रेय; <verse eid="LEV 1:12" /><verse number="13" style="v" sid="LEV 1:13" />एने चाकर्‍यो जेनवारान आतड्या एने पायाह पाण्या केरीन दोवे। एने आखा ईसाह आहने ली जाएन वेदी पोर हेलगाड़े, काहाकाय ज्यी होमबोली आक्‍ठान द्वारा यहोवाह खुस केरनी गेंदाणी बोली ठेराय।<verse eid="LEV 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 1:14" />केदी एगदो माणुह यहोवाह चिड़ान होमबोली चेड़ावी ताहार ओलो नाहते पेरवान चेड़ावो चेड़ावे। <verse eid="LEV 1:14" /><verse number="15" style="v" sid="LEV 1:15" />चाकर्‍यो ताह वेदीन आहने ली जाएन तान गिलो पेंदलीन मुड़ीन देड़ाह रेन आलेग किरे एने वेदी पोर हेलगाड़े; एने चिड़ान आखी लुय ती वेदीन एक उगे वोयाड़ देय। <verse eid="LEV 1:15" /><verse number="16" style="v" sid="LEV 1:16" />ताह चिड़ान गोहाह एने तान फाकाह वेदीन पुर्व उगे टाक देणे जुवे, ज्‍यो तोस जागो हे जाहरी ता वेदी माय रेन निकालीन रोखड़ो टाकतेह। <verse eid="LEV 1:16" /><verse number="17" style="v" sid="LEV 1:17" />तेवी तो ताह फाकड़ा हेर्‍य रेन चिरने जुवे, पुण ताह दुय ईसाम नाय वाटणे जुवे, चाकऱ्याह वेदीन उपेर आक्‍ठा पोर मिलेल लाकड़ान उपेर चिड़ाह हेलगाड़ने जुवे; काहाकाय ज्यी होमबोली आक्‍ठान द्वारा यहोवाह खुस केरनी गेंदाणी बोली ठेराय।<verse eid="LEV 1:17" /></para>
  <chapter eid="LEV 1" />
  <chapter number="2" style="c" sid="LEV 2" />
  <para style="s">एन बेटीन नेम</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 2:1" />जेवी एगदो माणुह यहोवान केरता एन बेट चेड़ावी, ताहार तो मोयदो चेड़ावे; एने ता माय तेल रोचवीन तान उपेर हालयान ढिक मेली; <verse eid="LEV 2:1" /><verse number="2" style="v" sid="LEV 2:2" />तेवी तो ताह हारूनान बेटाख फाय जा चाकऱ्या हेते लावे। एने तो तेल एने एन बेट एने हालयान ढिक माय बेचकायेल एक मुठ बोर मोयदो निकाले, तेवी चाकर्‍यो वेदी पोर एर केरावणेन रूप माय फिटाह आक्‍ठाम हेलगाड़े काय यहोवान केरता हाजी गेंदाणी बेट रेय। <verse eid="LEV 2:2" /><verse number="3" style="v" sid="LEV 2:3" />एने वोचेल एन बेट हारून एने तान सोरान केरता रेय; ज्यी बेट यहोवाह आक्‍ठा केरीन आपाण्‍यी बेटी माय आखाम रेन चोखाली रेय।<verse eid="LEV 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 2:4" />जेवी तुमू चुलाम रांदेल एन बेट लावे ताहार ज्‍य अखमीरी मोयदान रोटा नाहते उपेर रेन तेल टाकेल अखमीरी रोटा रेणे जुवे। <verse eid="LEV 2:4" /><verse number="5" style="v" sid="LEV 2:5" />एने केदी तारी बेट तावा पोर चुड़ायेल एन बेट रेय, ताहार तो तेल बेचकायेल अखमीरी मोयदान फिटान रेणे जुवे। <verse eid="LEV 2:5" /><verse number="6" style="v" sid="LEV 2:6" />तीह टुकड़ा टुकड़ा केरीन ता पोर तेल टाकज्यो, तेवी ती एन बेट एय जाय। <verse eid="LEV 2:6" /><verse number="7" style="v" sid="LEV 2:7" />केदी तुमू एन बेट तेलनेन केड़ाय माय रेन लावतेह, ताहार तो तेल बेचकायेल मोयदान फिटान एणे जुवे। <verse eid="LEV 2:7" /><verse number="8" style="v" sid="LEV 2:8" />एने जी एन बेट ज्यी चिजीम रेन एगदान बोणेल एय, ताह यहोवान आहने ली जाजे; जेवी ती चाकऱ्या फाय लावाय जाय, तेवी चाकर्‍यो ताह वेदीन आहने ली जाय। <verse eid="LEV 2:8" /><verse number="9" style="v" sid="LEV 2:9" />एने चाकर्‍यो एन बेट माय रेन एर केरावणार ईसो निकालीन वेदी पोर हेलगाड़े काय ज्यान हाजी गेंद केरीन यहोवान केरता बेट रेय। <verse eid="LEV 2:9" /><verse number="10" style="v" sid="LEV 2:10" />वोचेल एन बेट हारून एने तान सोरान रेय; ज्यी बेट यहोवान आख्यु बेटी माय रेन जुलूम चोखाली रेय।<verse eid="LEV 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 2:11" />एगदी एन बेट तुमू यहोवान केरता चेड़ावहो, ताहार खमीर बेचकीन मा बाणावहो, तुमू केदी बी यहोवान केरता वेदीन आक्‍ठाम बेटीन रूप माय खमीर एने मोवाल हेलगाड़हो मा। <verse eid="LEV 2:11" /><verse number="12" style="v" sid="LEV 2:12" />तुमू न्याह पेल्‍ली मेर ने चेड़ावो केरीन यहोवान केरता बेट चेड़ावज्यो, पुण खमीर एने मोवाल हाजाली गेंदिन रूप माय वेदीन आक्ठाम हेलगाड़हो मा। <verse eid="LEV 2:12" /><verse number="13" style="v" sid="LEV 2:13" />तुमू तुमरी लायेल एकेक एन बेट माय मिठ टाकज्यो; एने तुमरी एगदी एन बेट तुमरा बोगवाना हेऱ्यी बांदायेल वाचान मिठा बिगेर एणे मा दिहो; तुमरी आखी बेटी हेऱ्या मिठ लावणे जुवे।<verse eid="LEV 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 2:14" />केदी तु यहोवान केरता पेल्‍ली मेरीन एन बेट चेड़ावे, ताहार तारी पेल्‍ली मेरीन एन बेटीन केरता आक्‍ठा माय बुंजेल निल्‍यु निल्‍यु उंब्‍यु, मतलब उंब्‍युह मोलीन दाणाह निकाल लिज्‍यो, ओवता एन बेटीन रूप चेड़ावज्यो। <verse eid="LEV 2:14" /><verse number="15" style="v" sid="LEV 2:15" />एने ता माय तेल टाकज्यो, एने तान उपेर हालयान ढिक मिलज्यो; तेवी ती एन बेट एय जाय। <verse eid="LEV 2:15" /><verse number="16" style="v" sid="LEV 2:16" />एने चाकर्‍यो चोलीन निकालेल दाणाह, एने तेलाह, एने आखा हालयान ढिक एर केरावणार ईसो केरीन हेलगाड़ दे; ज्यी यहोवाह वेदीन आक्‍ठा केरीन चेड़ायेल बेट हे।<verse eid="LEV 2:16" /></para>
  <chapter eid="LEV 2" />
  <chapter number="3" style="c" sid="LEV 3" />
  <para style="s">मेल मिलाप बोलीन नेम</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 3:1" />केदी एगदो माणुह मेल मिलाप बोली चेड़ावेह, एने तो पालन्या जेनवार माय रेन नर जेनवार एने मादा चेड़ावेह, ताहार जो पुरो हाजो एय ताहास तो यहोवान सामने चेड़ावे। <verse eid="LEV 3:1" /><verse number="2" style="v" sid="LEV 3:2" />एने तो तान आथ तान चेड़ावण्या जेनवेरान मुंडा पोर मेली, एने ताह मिलापवाला तोम्बुन बायणा पोर बोली किरे। एने हारूनान सोरा जा चाकऱ्या हेते, ता तान लुयीह वेदीन कावदेन सिड़के। <verse eid="LEV 3:2" /><verse number="3" style="v" sid="LEV 3:3" />एने ता माणहाह मेल मिलाप बोलीम रेन यहोवान केरता वेदीन आक्‍ठाम बेट चेड़ावणे जुवे, मतलब जी चेरबी केरीन आतड्या डापेल रेतेह, एने जी चेरबी ताम लेटकेल रिथे, ती बी। <verse eid="LEV 3:3" /><verse number="4" style="v" sid="LEV 3:4" />एने दुयू बुका एने तान उपेरवाली चेरबी जी कोमरा हेऱ्यी रिथे, एने बुका बेल कालजाह डापणार चेरबीह बी निकाल लेणे जुवे। <verse eid="LEV 3:4" /><verse number="5" style="v" sid="LEV 3:5" />तेवी हारून ने सोरा ज्याह वेदी पोर ती होमबोलीन उपेर मिलेल लाकड़ा पोर हेलगाड़े, काय ज्यान गेंद यहोवाह खुस केरनार बेट ठेराय।<verse eid="LEV 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 3:6" />केदी यहोवान मेल मिलाप बोलीन केरता तान बेट पालन्या जेनवेरा माय रेन रेय, ताहार नर एय नाहते मादा, पुण जो पुरो हाजो एय ताहास तो बेट चेड़ावे। <verse eid="LEV 3:6" /><verse number="7" style="v" sid="LEV 3:7" />केदी तो मेंड्रान पिलाह चेड़ावेह, ताहार ताह यहोवान सामने चेड़ावे। <verse eid="LEV 3:7" /><verse number="8" style="v" sid="LEV 3:8" />एने तो तान बोली चेड़ावण्या जेनवेरान मुंडी पोर आथ मेली एने ताह मिलापवाला तोम्बुन सामने बोली किरे; एने हारूनान सोरा तान लुयीह वेदीन कावदेन सिड़के। <verse eid="LEV 3:8" /><verse number="9" style="v" sid="LEV 3:9" />तेवी मेल मिलाप बोलीम रेन चेरबीह यहोवान केरता आक्ठाम हेलगाड़ीन बोली केरी, मतलब तान चेरबी बोरायेल सेमटिह तो कोमरान आड़ाह रेन आलेग किरे, एने जी चेरबी केरीन आतड्या डापेल रेतेह, एने जी चेरबी ता माय लेटकेल रिथे, <verse eid="LEV 3:9" /><verse number="10" style="v" sid="LEV 3:10" />एने दुयू बुका एने जी चेरबी तान उपेर कोमरा हेऱ्यी रिथे, एने बुका बेल कालजाह डापण्यी कातली बी आलेग किरे। <verse eid="LEV 3:10" /><verse number="11" style="v" sid="LEV 3:11" />एने चाकर्‍यो वेदीन आक्‍ठा पोर ज्याह हेलगाड़ी; ज्यो यहोवान केरता बेट किरेल खाणो ठेराय।<verse eid="LEV 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 3:12" />केदी तो बोकड़ी चेड़ावे, ताहार ताह यहोवान सामने बोली केरी। <verse eid="LEV 3:12" /><verse number="13" style="v" sid="LEV 3:13" />एने तो तान आथ बोकड़ीन मुंडी पोर मेली, एने ताह मिलापवाला तोम्बुन ओंगाण बोली किरे; एने हारूनान बिटोख तान लुयीह वेदीन कावदेन सिड़के। <verse eid="LEV 3:13" /><verse number="14" style="v" sid="LEV 3:14" />तेवी तो ता माय रेन तान चेड़ावो यहोवान केरता आक्‍ठा माय बोली केरीन चेड़ावे, मतलब जी चेरबी केरीन आतड्या डापेल रेतेह, एने जी चेरबी ताम लेटकेल रिथे ती बी, <verse eid="LEV 3:14" /><verse number="15" style="v" sid="LEV 3:15" />एने दुयू बुका एने जी चेरबी तान उपेर कोमरा हेऱ्यी रिथे, एने बुका बेल कालजाह डापण्‍यी कातली, ज्या आखाह तो आलेग केरी। <verse eid="LEV 3:15" /><verse number="16" style="v" sid="LEV 3:16" />एने चाकऱ्यो ताह वेदीन आक्‍ठा माय हेलगाड़ी, ज्‍य आक्ठाम बोली किरेल खाणो ठेराय; ज्यान गेंद यहोवाह खुस किरेह; काहाकाय आखी चेरबी यहोवान हे। <verse eid="LEV 3:16" /><verse number="17" style="v" sid="LEV 3:17" />ज्‍य तुमरी रेणेन जागाम पिढ़ी पिढीन केरता कायेम ने नेम रेय, तुमू लुय एने चेरबी केदी मा खाहो।<verse eid="LEV 3:17" /></para>
  <chapter eid="LEV 3" />
  <chapter number="4" style="c" sid="LEV 4" />
  <para style="s">पापबोलीन नेम</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 4:1" />उवतो यहोवा मुसाह केयो, <verse eid="LEV 4:1" /><verse number="2" style="v" sid="LEV 4:2" />इस्राएल ने माणहाह ज्‍य के काय केदी एखेह माणुह ता कामाम रेन जाह यहोवा नाह केरने कियेल हे, एगदा एक कामाह बुल माय केरीन पापी बोण जाय।<verse eid="LEV 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 4:3" />एने केदी अबिषिक्त चाकऱ्यो ओहलो काम केरी, जान वोजेसे पोरजा दोसी ठेराय, ताहार ताह तान किरेल पापान केरता एक हाजा बोयलाह यहोवाह पापबोली केरीन चेड़ावणे जुवे। <verse eid="LEV 4:3" /><verse number="4" style="v" sid="LEV 4:4" />तो ता बोयलाह मिलापवाला तोम्बुन बायणा पोर यहोवान ओंगाण ली जाएन तान मुंडी पोर आथ मेली, एने ता बोयलाह यहोवान सामने बोली किरे। <verse eid="LEV 4:4" /><verse number="5" style="v" sid="LEV 4:5" />एने अबिषिक्त चाकर्‍यो बोयलान लुयीम रेन थोड़ोक लेन मिलापवाला तोम्बुम ली जाय; <verse eid="LEV 4:5" /><verse number="6" style="v" sid="LEV 4:6" />एने चाकर्‍यो तान आंगली लुयीम बुड़ावी बुड़ावीन एने ताम रेन थोड़ीक लेन चोखाला जागान विचीवाला पोड़दान ओंगाण यहोवान सामने हात वार सिड़के। <verse eid="LEV 4:6" /><verse number="7" style="v" sid="LEV 4:7" />एने चाकर्‍यो ती लुयीम रेन थोड़ीक हाजी गेंदाणी दुणी वेदीन हिंगा पोर जो मिलापवाला तोम्बु माय हे, यहोवान सामने लागाड़े; ओवतो बोयलान आखी लुयीह होमबोलीन वेदीन पाया पोर जो मिलापवाला तोम्बुन बायणा पोर हे रोचीव देय। <verse eid="LEV 4:7" /><verse number="8" style="v" sid="LEV 4:8" />ओवतो तो पापबोलीन बोयलान आखी चेरबीह ताह रेन आलेग किरे, मतलब जी चेरबी केरीन आतड्या डापायेल रेतेह, एने जोली चेरबी ताम लेटकेल रिथे, <verse eid="LEV 4:8" /><verse number="9" style="v" sid="LEV 4:9" />एने दुयू बुका एने तान उपेरवाली चेरबी जी कोमरा हेऱ्यी रिथे, एने बुका बेल कालजाह डापण्‍यी कातली, ज्या आखाह तो इह केरीन आलेग किरे। <verse eid="LEV 4:9" /><verse number="10" style="v" sid="LEV 4:10" />जीहे मेल मिलाप बोलीवाला चेड़ावान बोयलाह रेन आलेग केराय जातेह, एने चाकर्‍यो न्याह होमबोलीन वेदी पोर हेलगाड़े। <verse eid="LEV 4:10" /><verse number="11" style="v" sid="LEV 4:11" />पुण ता बोयलान चामड़ो, पाय, मुंड, आतड्या, साण, <verse eid="LEV 4:11" /><verse number="12" style="v" sid="LEV 4:12" />एने बोयलान आखो माह, मतलब आखा बोयलाह पाड़ावान बाहेर चोखाला जागाम, जाहरी रोखड़ो टाकाय जाथे, ले जायीन लाकड़ा पोर मेलीन आक्‍ठा केरीन हेलगाड़े, जाहरी रोखड़ो टाकाय जाथे, तो ताहरीस हेलगाड़ाय जाय।<verse eid="LEV 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 4:13" />केदी इस्राएल ने आखी मोंडली बुल माय पाप केरी, एने ज्यी वात मोंडलीन नेजरी माय लिकायेल हे, जाह नाह केरनेन आदेस बोगवान आपेल हे, केदी ओहलो ईथे ताहार ता दोसी ठेराती। <verse eid="LEV 4:13" /><verse number="14" style="v" sid="LEV 4:14" />ते जेवी तान किरेल पाप देखाय जाय, तेवी मोंडली एक बोयलाह पापबोली केरीन चेड़ावे। ता ताह मिलापवाला तोम्बुन ओंगाण ली जाय; <verse eid="LEV 4:14" /><verse number="15" style="v" sid="LEV 4:15" />एने मोंडलीन डावाला माणहे आप आपणा आथाह यहोवान ओंगाण बोयलान मुंडी पोर मेली, एने तो बुयेल यहोवान सामने बोली केराय जाय। <verse eid="LEV 4:15" /><verse number="16" style="v" sid="LEV 4:16" />तेवी अबिषिक्त चाकर्‍यो बोयलान लुयीम रेन थोड़ीक मिलापवाला तोम्बु माय ली जाय, <verse eid="LEV 4:16" /><verse number="17" style="v" sid="LEV 4:17" />एने चाकर्‍यो तान आंगली लुयीम बुड़ावीन तीह विचीवाला पोरदान ओंगाण हात वार यहोवान सामने सिड़के। <verse eid="LEV 4:17" /><verse number="18" style="v" sid="LEV 4:18" />एने तीस लुयीम रेन वेदीन हिंगा पोर जो यहोवान ओंगाण मिलापवाला तोम्बुम हे लागाड़े; एने वोचेल आखी लुय होमबोलीन वेदीन पाया पोर जो मिलापवाला तोम्बुन बायणा पोर हे रोचीव देय। <verse eid="LEV 4:18" /><verse number="19" style="v" sid="LEV 4:19" />एने चाकर्‍यो वासड़ान आखी चेरबी निकालीन वेदी पोर हेलगाड़े। <verse eid="LEV 4:19" /><verse number="20" style="v" sid="LEV 4:20" />जीहे पापबोलीन बोयला हेऱ्या किरेल एता तिहेच केरीन न्या हेऱ्या बी किरे; इह केरीन चाकर्‍यो इस्राएली माणहान पाप डापे, ज्या केरीन यहोवा इस्राएल ने माणहाह माफ केर देय। <verse eid="LEV 4:20" /><verse number="21" style="v" sid="LEV 4:21" />एने चाकर्‍यो बोयलाह पाड़ावान बाहेर ली जाएन तिहेच केरीन हेलगाड़े, जिहकेरीन पेल तो बोयलाह हेलगाड़ेल इतो; ज्‍य पुरी मोंडलीन केरता पापबोली ठेराय।<verse eid="LEV 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 4:22" />जेवी एगदो मुखी एदमी पाप केरी, मतलब आपणो बोगवान यहोवान एगदा उकुमान विरूद बुल माय काह केरीन दोसी एय जाय, <verse eid="LEV 4:22" /><verse number="23" style="v" sid="LEV 4:23" />एने तान पाप आखाह मालुम पोड़ जाय, ताहार तो एक हाजो बुकोड़ बोली केरनेन केरता ली जाय। <verse eid="LEV 4:23" /><verse number="24" style="v" sid="LEV 4:24" />एने बोकड़ान मुंडी पोर तान आथ मेली, एने बोकड़ाह ता जागा पोर बोली किरे, जाहरी होमबोली यहोवान ओंगाण बोली केराय जातेह; ज्‍य पापबोली ठेराय। <verse eid="LEV 4:24" /><verse number="25" style="v" sid="LEV 4:25" />तेवी चाकर्‍यो तान आंगली केरीन पापबोली जेनवेरान लुयीम रेन थोड़ीक लेन होमबोलीन वेदीन हिंगा पोर लागाड़े, एने तान लुय होमबोलीन वेदीन पाया पोर रोचीव देय। <verse eid="LEV 4:25" /><verse number="26" style="v" sid="LEV 4:26" />एने चाकर्‍यो तान आखी चेरबीह मेल मिलाप बोलीन चेरबीन गेत वेदी पोर हेलगाड़े; एने चाकऱ्यो मुखीन पापाह डापे, तेवी यहोवा ताह माफ केरी।<verse eid="LEV 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 4:27" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:27 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 15:27-28">गिनती 15:27-28</ref>
      </char>
    </note>केदी सादा माणहाम रेन एगदो बुल माय पाप किरे, ता कामा माय रेन एगदो काम किरेह, जाह केरनेन यहोवा मोना किरेल हे, ते तो दोसी ठेराथी, <verse eid="LEV 4:27" /><verse number="28" style="v" sid="LEV 4:28" />ताहार तो माणुह ता पापान वोजेसे एक हाजी बोकड़ी बोलीन केरता ली यावे; <verse eid="LEV 4:28" /><verse number="29" style="v" sid="LEV 4:29" />तो तान आथ पापबोली चेड़ावण्या जेनवेरान मुंडी पोर मेली, एने होमबोलीन जागा पोर ताह मारे। <verse eid="LEV 4:29" /><verse number="30" style="v" sid="LEV 4:30" />एने चाकर्‍यो तान लुयीम रेन तान आंगली केरीन थोड़ीक लुय लेन होमबोलीन वेदीन हिंगा पोर लागाड़े, एने तान आखी लुयीह तीस वेदीन पाया पोर रोचीव देय। <verse eid="LEV 4:30" /><verse number="31" style="v" sid="LEV 4:31" />एने तान आखी चेरबीह मेल मिलाप बोलीन जेनवारान चेरबीन गेत आलेग किरो, तेवी चाकऱ्यो ताह यहोवान केरता होमबोलीन वेदी पोर हाजी गेंदिन केरता हेलगाड़ने जुवे, इह केरीन चाकर्‍यो ता माणहान पापाह डाप देय, एने यहोवा ता माणहाह माफ केर देय।<verse eid="LEV 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 4:32" />केदी तो माणुह पापबोलीन केरता एक मेंड्रान पिलो लावी, ताहार ती हाजी बोकड़ी रेय, <verse eid="LEV 4:32" /><verse number="33" style="v" sid="LEV 4:33" />एने तो तान आथ पापबोलीन मुंडी पोर मेलने जुवे, एने ताह ता जागा पोर पापबोलीन रूप माय मारने जुवे, जाहरी ता होमबोलीन जेनवेराह मारतेह। <verse eid="LEV 4:33" /><verse number="34" style="v" sid="LEV 4:34" />तेवी चाकर्‍यो तान आंगली केरीन पापबोलीन लुयीम रेन थोड़ीक लेन होमबोलीन वेदीन हिंगा पोर लागाड़े, एने तान आखी लुयीह वेदीन पाया पोर रोचीव देय। <verse eid="LEV 4:34" /><verse number="35" style="v" sid="LEV 4:35" />एने चाकऱ्याह तान आखी चेरबीह मेल मिलाप बोलीन मेंड्रान पिलान चेरबीन आलेग केरी, एने चाकऱ्यो यहोवान केरता आक्‍ठान द्वारा केराण्‍यी बेटीन गेतुस वेदी पोर हेलगाड़े, इह केरीन चाकर्‍यो ता माणहान पापाह डाप देय, एने यहोवा ता माणहाह माफ केर देय।<verse eid="LEV 4:35" /></para>
  <chapter eid="LEV 4" />
  <chapter number="5" style="c" sid="LEV 5" />
  <para style="s">पापबोलीन कारेण</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 5:1" />केदी एगदो माणुह कोरटाम गोवाय देणेन केरता हादाड़ाय जाथे, एने जो काय तो दिखेल हे नाहते होमलेल हे, ताह नाह केत ताहार तो पाप किरेह, ताह तान गुनान केरता देन्ड बोगणे पोड़ी।<verse eid="LEV 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="LEV 5:2" />पुण केदी इखेह माणुह एगदी एठी चिजीह बुल माय सापली लेय, ताहार तो एठा जेंगली जेनवेरान नाहते पालन्या जेनवेरान नाहते लोलनारा एगदा एठा जेन्तुन देड़ रेय, ताहार तो एठो एन दोसी ठेराय।<verse eid="LEV 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 5:3" />पुण केदी एगदो माणुह एगदी एठी चिजीह बुल माय सापील लेय, केदी ती एठी चिज काल्ली बी रितीन काहा नाय रेय, जी केरीन माणहे एठा एय जातेह, ते जेवी तो ती वातीह सोमजी लेय, तेवी तो दोसी ठेराय।<verse eid="LEV 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 5:4" />पुण केदी एगदो बुरो नाहते हाजो केरनेन बिगेर सोची, सोमजीन सुगोण खाय, केदी काल्ली बातीन वात तो बिगेर सोच विचारीन सुगोण खाएन केय, ताहार ओहली वातीम तो दोसी ती टेम ठेराय, जेवी ताह मालुम एय जाय।<verse eid="LEV 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 5:5" />एने जेवी तो ज्‍यु वातु माय रेन काल्ली बी वातीम दोसी रेय, तेवी तो तान पाप स्वीकार केर लेय, जाह तो किरेल हे, <verse eid="LEV 5:5" /><verse number="6" style="v" sid="LEV 5:6" />एने तो यहोवान सामने तान दोसबोली लियावो, मतलब ता पापान कारेण तो एक मेंड्रो नाहते बोकड्यो पापबोली केरनेन केरता लियावो; तेवी चाकर्‍यो तान पापान बाराम पासतावो किरे।<verse eid="LEV 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 5:7" />पुण केदी एगदा माणहाह मेंड्रो नाहते बोकड्यो आपणेन ताकेत नाय रेय, ताहार तान पापान कारेण दुय ओला नाहते पेरवान दुय पिला दोसबोली चेड़ावणेन केरता यहोवा फाय लियावो, ताम रेन एक पापबोलीन केरता एने दिहरो होमबोलीन केरता। <verse eid="LEV 5:7" /><verse number="8" style="v" sid="LEV 5:8" />तो ताह चाकऱ्या फाय लियावो, एने चाकर्‍यो पापबोली वालाह पेल चेड़ावे, एने तान मुंड गेलाम रेन पेंदिल देय, पुण आलेग नाय किरे, <verse eid="LEV 5:8" /><verse number="9" style="v" sid="LEV 5:9" />एने तो पापबोली चिड़ान लुयीम रेन थोड़ीक वेदीन आहने सिड़के, एने जी लुय वोच रेय ती वेदीन पाया पोर रोचवाय जाय; ती पापबोली ठेराय। <verse eid="LEV 5:9" /><verse number="10" style="v" sid="LEV 5:10" />तेवी दिहरा चिड़ाह तो नेमान गेत होमबोली किरे, इह केरीन चाकर्‍यो ता माणहान पापान केरता पासतावो किरे, एने यहोवा ता माणहाह माफ केरी।<verse eid="LEV 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 5:11" />पुण एगदा माणहाह दुय ओला नाहते पेरवान दुय पिला बी नाय आप सेकी, ताहार तो तान पापान कारेण तान चेड़ावणो एक किलो मोयदान दोहवो ईसो पापबोली सोमजीन लियावो; ता पोर नाहते तो तेल टाके, एने नाह हालयान ढिक मेली, काहाकाय तो पापबोली रेय। <verse eid="LEV 5:11" /><verse number="12" style="v" sid="LEV 5:12" />ता माणहाह फिट चाकऱ्या फाय लावणे जुवे, चाकर्‍यो ज्‍याम रेन मुठबोर फिट निकाली, ज्यी एर केरावणी बेट रेय, चाकर्‍यो यहोवाह आक्‍ठान द्वारा किरेल बेटी पोर वेदीन उपेर फिटाह हेलगाड़े, ती पापबोली ठेराय। <verse eid="LEV 5:12" /><verse number="13" style="v" sid="LEV 5:13" />इह केरीन चाकर्‍यो माणहान गुनान केरता पासतावो किरे, एने यहोवा ता माणहाह माफ केरी, एने ज्यी पापबोलीन वुचेल बाग एन बोलीन वुचेल बाग ने गेत चाकर्‍यान रेय।<verse eid="LEV 5:13" /></para>
  <para style="s">दोसबोलीन नेम</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 5:14" />यहोवा मुसाह केयो, <verse eid="LEV 5:14" /><verse number="15" style="v" sid="LEV 5:15" />केदी एगदो यहोवान चोखी किरेल चिजीन बाराम बुल माय गेलती केरी एने पापी ठेराय, ताहार तो यहोवा फाय एक हाजो मेंडो दोसबोलीन केरता लियावो; तान किमोत चोखाला जागान शेकेलान<note caller="+" style="f"><char style="fr" closed="false">5:15 </char><char style="fq" closed="false">शेकेलान </char><char style="ft" closed="false">बारा ग्राम चांदी</char></note> गेत तोलोस तोलाय जाय, जोलोक चाकर्‍यो ठेरावी। <verse eid="LEV 5:15" /><verse number="16" style="v" sid="LEV 5:16" />एने जी चोखाली चिजीन बाराम तो पाप किऱ्यो एय, ताम तो पाचवो ईसो उंजु वोदाड़ीन चाकऱ्याह आपी; एने चाकर्‍यो दोसबोलीन मेंडो चेड़ावीन तानकेरता पासतावो किरे, तेवी तान पाप माफ केराय जाय।<verse eid="LEV 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 5:17" />केदी एगदो ओहलो पाप किरे, जाह कामाह यहोवा नाह केरने कियेल हे, एगदा कामाह किरे, ताहार केदी ताह बुल माय ईयेल एय, तीबी तो दोसी ठेराय, एने ताह तान गुनान बार विसणे पोड़ी। <verse eid="LEV 5:17" /><verse number="18" style="v" sid="LEV 5:18" />केरीन तो एक हाजो मेंडो दोसबोली केरीन चाकऱ्या फाय लियावो, तो तोलीस किमतीन रेय, जोलीक चाकर्‍यो ठेरावी, एने जी गेलती तो बुल माय किरेल हे चाकर्‍यो तान केरता पासतावो किरे, एने ताह माफ केराय जाय। <verse eid="LEV 5:18" /><verse number="19" style="v" sid="LEV 5:19" />ज्यी दोसबोली ठेराय, काहाकाय तो माणुह पाक्को यहोवान ओंगाण दोसी ठेराय।<verse eid="LEV 5:19" /></para>
  <chapter eid="LEV 5" />
  <chapter number="6" style="c" sid="LEV 6" />
  <para style="p">
    <verse number="1" style="v" sid="LEV 6:1" />उवतो यहोवा मुसाह केयो, <verse eid="LEV 6:1" /><verse number="2" style="v" sid="LEV 6:2" />“केदी एगदो माणुह यहोवान बुरहो तोड़ीन पापी ठेराय, जिह काय मालदेन, नाहते लेन देन, नाहते लुटेल मालान बाराम तान बायाख ठेगी, नाहते ताह दुको देय। <verse eid="LEV 6:2" /><verse number="3" style="v" sid="LEV 6:3" />नाहते पुड़ेल चिजीह सापड़ावीन तान बाराम जुठ बोले एने जुठो सुगोण बी खाय; ओहली काल्ली बी वात काहा नाय रेय जीह केरीन माणहे पापी ठेरातेह, <verse eid="LEV 6:3" /><verse number="4" style="v" sid="LEV 6:4" />ते जेवी तो ओहलो केरीन दोसी ठेराय, तेवी जो बी वोस्तु लुट, नाहते ठेगीन, नाहते मालदेन, नाहते टाकायेल चिज ने बाराम जुठ बोल्‍यो एय। <verse eid="LEV 6:4" /><verse number="5" style="v" sid="LEV 6:5" />केदी काल्ली बी चिज काहा नाय रेय जान बाराम तो जुठो सुगोण खादोय; ताहार तो ताह पुरो पुरो आप देय, एने पाचवो ईसो बी वोदाड़ीन बोर देय, जेदिह ज्‍य मालुम रेय काय तो दोसी हे ते दिहस तो जान हे ताह आप देय। <verse eid="LEV 6:5" /><verse number="6" style="v" sid="LEV 6:6" />एने तो यहोवान सामने तान दोसबोली बी लियावो, मतलब एक हाजो मेंडो दोसबोलीन केरता चाकऱ्या फाय लियावो, तो तोलीस किमतीन रेय जोलीक चाकर्‍यो ठेरावी। <verse eid="LEV 6:6" /><verse number="7" style="v" sid="LEV 6:7" />इह केरीन चाकर्‍यो तान केरता यहोवान सामने पाप डापे, एने जा कामाह केरीन तो दोसी एय जायेल हे तान माफी ताह जुड़ी।”<verse eid="LEV 6:7" /></para>
  <para style="s">बात बातीन बोलीन नेम</para>
  <para style="s">होमबोली</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 6:8" />उवतो यहोवा मुसाह केयो, <verse eid="LEV 6:8" /><verse number="9" style="v" sid="LEV 6:9" />हारून एने तान सोराह उकुम आपीन ज्‍य के काय होमबोलीन नेम ज्‍य हे। होमबोली आक्‍ठान उपेर रात बोर वेगोस वोर वेदी पोर पुड़ेल रेय, एने वेदीन आक्‍ठो वेदी पोर हेलेगते रेय। <verse eid="LEV 6:9" /><verse number="10" style="v" sid="LEV 6:10" />एने चाकर्‍यो तान होणीन फाड़का एने तान डिला पोर चोपकिन होणीन फाड़को पेरीन होमबोलीन रोखड़ो, जो वेदी पोर हेलेगणेन बाद वोच जायेल हे, ताह विसीन वेदीन आहने मेली। <verse eid="LEV 6:10" /><verse number="11" style="v" sid="LEV 6:11" />तेवी तो तान ज्या फाड़का काड़ीन दिहरा फाड़का पेरीन रोखड़ाह पाड़ावान बाहेर एगदा चोखा जागा पोर ली जाय। <verse eid="LEV 6:11" /><verse number="12" style="v" sid="LEV 6:12" />पुण वेदीन आक्‍ठो वेदी माय हेलेगते रेणे जुवे, तीह ओलाणे नाय देणे जुवे, चाकऱ्याह दाड़ीन वेगोस वेदी पोर लाकड़े हेलगाड़ने जुवे, ताह वेदी पोर लाकड़े मेलने जुवे, ताह मेल मिलाप बोलीन चेरबी हेलगाड़ने जुवे। <verse eid="LEV 6:12" /><verse number="13" style="v" sid="LEV 6:13" />वेदी पोर आक्‍ठो जेलेम हेलेगते रेणे जुवे; ती केदी ओलाणे नाय जुवे।<verse eid="LEV 6:13" /></para>
  <para style="s">एन बेट</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 6:14" />एन बेट केरनेन नेम ज्‍य हे, हारूनान सोरा ताह वेदीन ओंगाण यहोवान आहने लियावो। <verse eid="LEV 6:14" /><verse number="15" style="v" sid="LEV 6:15" />चाकऱ्याह एन बेट माय रेन मुठ बोर हाजालो फिट लेणे जुवे, तेल एने हालयान ढिक एन बेट पोर जोरेवरी रेणे जुवे, चाकऱ्याह ज्याह वेदी पोर हेलगाड़ने जुवे, ज्‍य यहोवाह एक हाजाली गेंद एने एर केरनी बेट रेय। <verse eid="LEV 6:15" /><verse number="16" style="v" sid="LEV 6:16" />एने ताम रेन जो वोच जाय ताह हारून एने तान सोरा खाय; तो बिगेर खमीर चोखाला जागाम खावाय जाय, मतलब ता मिलापवाला तोम्बुन खोलीम ताह खाय। <verse eid="LEV 6:16" /><verse number="17" style="v" sid="LEV 6:17" />तो खमीर हेऱ्यो रांदाणे नाय जुवी; काहाकाय यहोवाह आक्‍ठान द्वारा केरनी एन बेट माय रेन चाकऱ्याह तान ईसो एणेन केरता आपेल हे; केरीन जीहे पापबोली एने दोसबोली जुलूम हाजो हे, तिहेच केरीन तो बी हे। <verse eid="LEV 6:17" /><verse number="18" style="v" sid="LEV 6:18" />हारूनान सोराम रेन एकेक सोरो आक्‍ठान द्वारा यहोवाह चेड़ायेल बेटीम रेन खाय सिकेह, ज्‍य तुमरी पिढ्युन कायेम ने केरता नेम हे, जो कुण ज्यी एन बेटीह सापली तो चोखो ठेराय।<verse eid="LEV 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 6:19" />पुशो यहोवा मुसाह केयो, <verse eid="LEV 6:19" /><verse number="20" style="v" sid="LEV 6:20" />“जेदिह हारूनान अबिषेक एय, ते दिह तो तान सोरा हिऱ्यो यहोवाह ज्यी बेट चेड़ावे; मतलब एक किलो फिट कायेम एन बेट चेड़ावे, ताम रेन आदोक वेगोच एने आदोक हांज पोर ने टेम चेड़ावे। <verse eid="LEV 6:20" /><verse number="21" style="v" sid="LEV 6:21" />तो तावाम तेला माय रांदे; जेवी तो तेला केरीन तेलाय जाय, तेवी ताह लीयावजे, ज्यी एन बेटीन रांदायेल टुकड़ा यहोवान हाजाली गेंदिन केरता चेड़ावज्यो। <verse eid="LEV 6:21" /><verse number="22" style="v" sid="LEV 6:22" />हारूनान सोराम रेन जो बी तान जागा पोर चाकऱ्यान पोद माय अबिषेक एय, यहोवाह तो एन बेट चेड़ावे, ज्‍यो नेम कायेम ने केरता हे; यहोवान केरता एन बेट पुरीरिती से हेलगाड़ने जुवे। <verse eid="LEV 6:22" /><verse number="23" style="v" sid="LEV 6:23" />चाकर्‍यान एकेक एन बेट पुरीरिती से हेलगाड़ने जुवे; ज्‍यीह खाणे नाय जुवे।”<verse eid="LEV 6:23" /></para>
  <para style="s">पापबोली</para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 6:24" />उवतो यहोवा मुसाह केयो, <verse eid="LEV 6:24" /><verse number="25" style="v" sid="LEV 6:25" />“हारून एने तान सोराह ज्‍य के काय पापबोलीन नेम ज्‍यो हे, जा जागाम होमबोली जेनवार माराय जाथे; तास जागाम पापबली जेनवार बी यहोवान सामने बोली केराय जाय; ज्‍य जुलूम हाजो हे। <verse eid="LEV 6:25" /><verse number="26" style="v" sid="LEV 6:26" />जो चाकऱ्यो पापबोलीह चेड़ावेह ताह तो खाय, एने चोखाला जागा पोर मिलापवाला तोम्बुन खोली माय खाणे जुवे। <verse eid="LEV 6:26" /><verse number="27" style="v" sid="LEV 6:27" />जो कुण तान माहाह सापेल लेय, तो चोखालो एय जाय; एने केदी तान लुयीन सीटा एगदा फाड़का पोर पोड़ जाय, ताहार ताह एगदा चोखाला जागाम दोव दिज्‍ये। <verse eid="LEV 6:27" /><verse number="28" style="v" sid="LEV 6:28" />केदी ताह एगदा माटड्यान ठामला माय उकाले, ताहार ता ठामलाह फोड़ देणे जुवे, केदी ताह पितलान ठामला माय उकाले, ताहार ठामलाह उजाले एने पाण्या केरीन दोवे। <verse eid="LEV 6:28" /><verse number="29" style="v" sid="LEV 6:29" />चाकऱ्या माय रेन आखा एदमी तीह खाय सेकतेह; ज्यी जुलूम हाजी चिज हे। <verse eid="LEV 6:29" /><verse number="30" style="v" sid="LEV 6:30" />पुण केदी पापबोलीन लुय माय रेन मिलापवाला तोम्बुन माय चोखाली जागे पाप डापणेन केरता पोचाड़ाय जाय, ताहार पापबोलीह आक्‍ठाम हेलगाड़ देणे जुवे, चाकर्‍यो तान माह नाह खाय सिकेत।”<verse eid="LEV 6:30" /></para>
  <chapter eid="LEV 6" />
  <chapter number="7" style="c" sid="LEV 7" />
  <para style="s">दोसबोली</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 7:1" />दोसबोलीन केरता ज्‍यो नेम हे, तो जुलूम हाजो हे; <verse eid="LEV 7:1" /><verse number="2" style="v" sid="LEV 7:2" />जा जागा पोर होमबोली जेनवेराह मारतेह, तास जागा पोर दोसबोली जेनवार बी बोली किरे, एने तान लुयीह चाकर्‍यो वेदी पोर कावदेन सिड़के। <verse eid="LEV 7:2" /><verse number="3" style="v" sid="LEV 7:3" />एने तो ता माय वाली आखी चेरबीह चेड़ावे, मतलब तान चेरबीदार सेमटिह, एने जी चेरबी केरीन आतड्या डापेल रेतेह ती बी, <verse eid="LEV 7:3" /><verse number="4" style="v" sid="LEV 7:4" />दुयू बुका एने तान उपेरवाली एने कोमरावाली चेरबी, एने कालजान उपेरली कातली बुका बेल न्या आखाह आलेग केरी। <verse eid="LEV 7:4" /><verse number="5" style="v" sid="LEV 7:5" />एने चाकऱ्यो न्या आखा ईसाह यहोवान केरता वेदी पोर हेलगाड़े, ज्‍य यहोवाह आक्‍ठान द्वारा किरेल दोसबोली हे। <verse eid="LEV 7:5" /><verse number="6" style="v" sid="LEV 7:6" />चाकऱ्या मायवाला आखा एदमी ताम रेन खाय सेकतेह; तो एगदा चोखाला जागाम खावाय जाय; काहाकाय तो जुलूम हाजो हे।<verse eid="LEV 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 7:7" />जिह केरीन पापबोली हे तिहेच केरीन दोसबोली बी हे, त्यु दुयून एकुच नेम हे; चाकर्‍यो त्यु बोल्युह चेड़ावीन पाप डापेह, त्युस वोस्तुह लेय लेय। <verse eid="LEV 7:7" /><verse number="8" style="v" sid="LEV 7:8" />एने जो चाकर्‍यो एगदान केरता होमबोलीह चेड़ावी, ती होमबोली जेनवेरान चामड़ाह चाकर्‍यो लेय लेय। <verse eid="LEV 7:8" /><verse number="9" style="v" sid="LEV 7:9" />एकेक एन बेटीह चाकऱ्यान रेय, जी बाठा माय रांदेल एय, नाहते केड़ाय माय रांदेल एय नाहते तावाम रांदेल एय। <verse eid="LEV 7:9" /><verse number="10" style="v" sid="LEV 7:10" />एने सोब एन बेट, जो तेला माय बेचकायेल एय, नाहते हुकेल रेय, तो हारून ने सोराह एक हारको जुड़ी।<verse eid="LEV 7:10" /></para>
  <para style="s">मेल मिलाप बोली</para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 7:11" />ज्‍यो मेल मिलाप बोलीन नेम हे, जाह एगदो माणुह यहोवाह चेड़ावेह। <verse eid="LEV 7:11" /><verse number="12" style="v" sid="LEV 7:12" />केदी एगदो माणुह ताह दन्यवाद ने केरता चेड़ावी, ताहार दन्यवाद बोली हेऱ्यो तेल बेचकायेल अखमीरी पुड्या, एने तेला केरीन चोपड़ेल अखमीरी रोटा, एने तेल माय कुहणील फिटान पुड्या बी चेड़ावे। <verse eid="LEV 7:12" /><verse number="13" style="v" sid="LEV 7:13" />एने तो तान दन्यवादवाली मेल मिलाप बोली हिऱ्यो खमीरी रोटा बी चेड़ावे। <verse eid="LEV 7:13" /><verse number="14" style="v" sid="LEV 7:14" />एने एकेक ओहला चेड़ावा माय रेन एकेक रूटो यहोवाह विसणेन बेट केरीन चेड़ावी, तो चाकर्‍यान रेय, जो मेल मिलाप बोलीन लुयीह सिड़केह। <verse eid="LEV 7:14" /><verse number="15" style="v" sid="LEV 7:15" />एने ता दन्यवादवाला मेल मिलाप बोलीन माह बोली केरने दिहुस खावाय जाय; ताम रेन कायच बी माह दिहरा दिह्यान केरता नाय वोचणे जुवे।<verse eid="LEV 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 7:16" />पुण केदी तान बोली केरनो मानतान एय, नाहते मोरजी से एय, ताहार ती बोलीह जेदिह ती चेड़ावाय जाय ते दिहस तो खावाय जाय, एने ताम रेन जो वोच जाय तो दिहरे दिह बी खावाय जाय। <verse eid="LEV 7:16" /><verse number="17" style="v" sid="LEV 7:17" />पुण जो काय बोलीन माहाम रेन तीसरे दिह वोर रेय जाय, तो आक्‍ठाम हेलगाड़ाय जाय। <verse eid="LEV 7:17" /><verse number="18" style="v" sid="LEV 7:18" />केदी एगदो माणुह मेल मिलाप बोलीन माह तीसरे दिह खाते, ताहार तो स्वीकार केराय नाय जाय, तो कायच फायदान गेणाय नाय जाय, एने तो खाराब काम सोमजाय जाय, एने जो कुण ताम रेन खाय तान गुनो तास ने मुंडी पोर पोड़ी। <verse eid="LEV 7:18" /><verse number="19" style="v" sid="LEV 7:19" />ओवतो जो माह एगदी एठी चिज सापली लेय, ताहार तो खावाय नाय जाय; तो आक्‍ठाम हेलगाड़ाय जाय, एने जोला जाणे चोखा हेते ता माह खाय, <verse eid="LEV 7:19" /><verse number="20" style="v" sid="LEV 7:20" />पुण जो एठो एन यहोवान मेल मिलाप बोलीन माहाम रेन काह खाय, तो तान माणहाम रेन खेतेम केराय जाय। <verse eid="LEV 7:20" /><verse number="21" style="v" sid="LEV 7:21" />एने केदी एखेह एगदी एठी चिजीह सापलीन यहोवान मेल मिलाप बोली जेनवेरान माहाम रेन खाय, ताहार तो बी तान माणहाम रेन खेतेम केराय जाय, केदी ता माणहान एगदी एठी चिज नाहते एठो जेनवार नाहते काल्ली बी एठी एने खाराब चिज रेय।<verse eid="LEV 7:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 7:22" />ओवतो यहोवा मुसाह केयो, <verse eid="LEV 7:22" /><verse number="23" style="v" sid="LEV 7:23" />“इस्राएल ने माणहाह इह केरीन के काय तुमू नाहते बुयेल, मेंड्रो एने बोकड्यान चेरबी खाहो। <verse eid="LEV 7:23" /><verse number="24" style="v" sid="LEV 7:24" />एने जो जेनवार खुद मोर जाय, एने जो दिहरा जेनवेरान द्वारा माराय जाय, तान चेरबी दिहरा कामाम लागाड़ज्यो, पुण तीह केदी बी खाहो मा। <verse eid="LEV 7:24" /><verse number="25" style="v" sid="LEV 7:25" />केदी एगदो माणुह ओहला जेनवेरान चेरबी खाते, जाह यहोवाह केरता होमबोली केरीन चेड़ाया केरतेह, ताहार ता माणहाह तान माणहाम रेन खेतेम केराय जाय। <verse eid="LEV 7:25" /><verse number="26" style="v" sid="LEV 7:26" />एने तुमू तुमरा गेराम काल्ली बातीन चिड़ान नाहते जेनवेरान लुय केदी मा खाहो। <verse eid="LEV 7:26" /><verse number="27" style="v" sid="LEV 7:27" />केदी एगदो माणुह थोड़ीक लुय खाते ताहार ता माणहाह तान माणहाम रेन खेतेम केराय जाय।”<verse eid="LEV 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 7:28" />ओवतो यहोवा मुसाह केयो, <verse eid="LEV 7:28" /><verse number="29" style="v" sid="LEV 7:29" />इस्राएल ने माणहाह इह केरीन के, जो यहोवान केरता मेल मिलाप बोली चेड़ावी तो तीस मेल मिलाप बोलीम रेन यहोवा फाय बेट लियावे; <verse eid="LEV 7:29" /><verse number="30" style="v" sid="LEV 7:30" />तो तास ने आथा केरीन यहोवान बोलीह, मतलब साती बेल चेरबीह लियावे काय साती आलाड़नेन बेट यहोवान सामने आलाड़ाय जाय। <verse eid="LEV 7:30" /><verse number="31" style="v" sid="LEV 7:31" />एने चाकर्‍यो चेरबीह ते वेदी पोर हेलगाड़े, पुण साती हारून एने तान सोरान रेय। <verse eid="LEV 7:31" /><verse number="32" style="v" sid="LEV 7:32" />ओवता तुमू तुमरी मेल मिलाप बोलीम रेन जिवड़ी जांगीह बी विसणेन बेट सोमजीन चाकऱ्याह आपज्यो; <verse eid="LEV 7:32" /><verse number="33" style="v" sid="LEV 7:33" />हारून ने सोराम रेन मेल मिलाप बोलीन लुय एने चेरबीह चेड़ावे जिवड़ी जांग तास ने ईसो रेय। <verse eid="LEV 7:33" /><verse number="34" style="v" sid="LEV 7:34" />काहाकाय इस्राएलीन मेल मिलाप बोलीम रेन आलाड़नेन बेटीन साती एने विसणेन बेटीन जांगीह लेन, मी हारून चाकऱ्याह एने तान सोराह आपेल हे काय इस्राएल माणहान केरता ज्‍यो नेम कायेम ने केरता रेय। <verse eid="LEV 7:34" /><verse number="35" style="v" sid="LEV 7:35" />जेदिह रेन हारून एने तान सोरा यहोवान आहने चाकर्‍यान पोद पोर निवेड़ना, तेदिह रेन यहोवाह आक्‍ठान द्वारा किरेल बेट हारून एने तान सोरान हे। <verse eid="LEV 7:35" /><verse number="36" style="v" sid="LEV 7:36" />जेदिह यहोवा तान अबिषेक किऱ्यो, ते दिहस तो उकुम आप्यो काय ताह इस्राएल ने उगे रेन ज्‍यो ईसो कायेम जुड़ी; तान पिढीन केरता ज्‍योस हेक ठेराय जायेल।<verse eid="LEV 7:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LEV 7:37" />होमबोली, एन बेट, पापबोली, दोसबोली, चाकर्‍यान अबिषेक बोली, एने मेल मिलाप बोलीन नेम ज्‍योस हे। <verse eid="LEV 7:37" /><verse number="38" style="v" sid="LEV 7:38" />जेवी यहोवा सीने बोयड़ान आहने उजाड़ी माय मुसाह उकुम आपेल काय इस्राएली मार केरता काय काय बेट चेड़ावे, तेवी तो ताह ज्‍योस नेम आपेल इतो।<verse eid="LEV 7:38" /></para>
  <chapter eid="LEV 7" />
  <chapter number="8" style="c" sid="LEV 8" />
  <para style="s">हारून एने तान सोरान अबिषेक</para>
  <para style="r">(<ref loc="EXO 29:1-37">निर्गमन 29:1-37</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 8:1" />ओवतो यहोवा मुसाह केयो, <verse eid="LEV 8:1" /><verse number="2" style="v" sid="LEV 8:2" />“तु हारून एने तान सोरान फाड़का, एने अबिषेक ने तेल, एने पापबोलीन वासड़ो, एने दुय मेंडा एने अखमीरी रोटान टोपलीह ले, <verse eid="LEV 8:2" /><verse number="3" style="v" sid="LEV 8:3" />एने मिलापवाला तोम्बुन बायणा हिऱ्यो लीयाव, एने ताहरीस आखी मोंडलीह टुलो केर।” <verse eid="LEV 8:3" /><verse number="4" style="v" sid="LEV 8:4" />यहोवान ज्या उकुमान गेत मुसो किऱ्यो; एने मोंडली मिलापवाला तोम्बुन बायणा हेऱ्यी एकठी एनी। <verse eid="LEV 8:4" /><verse number="5" style="v" sid="LEV 8:5" />तेवी मुसो मोंडलीह केयो, “जो काम केरनेन उकुम यहोवा आपेल हे, तो ज्‍यो हे।”<verse eid="LEV 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 8:6" />ओवतो मुसा हारून एने तान सोराह आहने ली जाएन पाण्या केरीन उंगलायो। <verse eid="LEV 8:6" /><verse number="7" style="v" sid="LEV 8:7" />तेवी मुसो हारूनाह फाड़का पेरायो, एने पुट्टो वेटालीन चोगा पेराव दिनो, एने एपोद लागाड़ीन एपोद<note caller="+" style="f"><char style="fr" closed="false">8:7 </char><char style="fq" closed="false">एपोद </char><char style="ft" closed="false">चाकऱ्यान फाड़को</char></note> ने गुथील पोट्टा से एपोदाह खेचीन बांद दिनो। <verse eid="LEV 8:7" /><verse number="8" style="v" sid="LEV 8:8" />तेवी मुसो सातीह ढापण्यो फाड़को बांद्यो एने खीसाम उरीम एने तुम्मीम मिल्यो। <verse eid="LEV 8:8" /><verse number="9" style="v" sid="LEV 8:9" />तेवी मुसो हारूनान मुंडी पोर पागड़ी बांदिन पागड़ीन सामने होनान पोट्टीह, मतलब चोखाला मुकूटाह लागाड्यो, जिह केरीन यहोवा मुसाह उकुम आपेल इतो।<verse eid="LEV 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 8:10" />तेवी मुसो अबिषेक ने तेल लेन रेणेन जागो एने जी बी चिज ता माय एत्यु, त्यु आख्‍यु चिजु पोर सेड़कीन त्युह चोख्‍यु किऱ्यो। <verse eid="LEV 8:10" /><verse number="11" style="v" sid="LEV 8:11" />एने मुसो अबिषेक ने थोड़ोक तेल लेन वेदी पोर हात वार सिड़क्‍यो, एने आखो सामान बेल वेदीन एने पाया बेल डेचक्यान अबिषेक केरीन ताह चोखो किऱ्यो। <verse eid="LEV 8:11" /><verse number="12" style="v" sid="LEV 8:12" />एने तो अबिषेक ने तेलाम रेन थोड़ोक हारूनान मुंडी पोर रोचवीन तान अबिषेक केरीन ताह चोखो किऱ्यो। <verse eid="LEV 8:12" /><verse number="13" style="v" sid="LEV 8:13" />ओवतो मुसो हारूनान सोराह आहने लावीन फाड़का पेरायो, एने कोमेर पुट्टो बांदिन तान मुंडी पोर टोपी मेल दिनो, जिह केरीन यहोवा मुसाह उकुम आपेल इतो।<verse eid="LEV 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 8:14" />तेवी मुसो पापबोलीन बोयलाह आहने ली गीयो; एने हारून एने तान सोरा तान आथ पापबोलीन बोयलान मुंडी पोर मेल्या। <verse eid="LEV 8:14" /><verse number="15" style="v" sid="LEV 8:15" />तेवी मुसो ताह बोली किऱ्यो, एने मुसो लुय लेन आंगली केरीन वेदीन चारू हिंगा पोर लागाड़ीन चोखो किऱ्यो, एने लुयीह वेदीन पाया पोर रोचीव दिनो, एने तानकेरता पासतावो केरीन ताह चोखो किऱ्यो। <verse eid="LEV 8:15" /><verse number="16" style="v" sid="LEV 8:16" />एने मुसो आतड्या पोर वाली आखी चेरबी, एने कालजाह डापण्‍यी कातली लिदो, एने चेरबी बेल दुयू बुकाह लेन वेदी पोर हेलगाड्यो। <verse eid="LEV 8:16" /><verse number="17" style="v" sid="LEV 8:17" />पुण मुसो बोयला माय रेन जो काय रेय गीयो ताह, मतलब चामड़ो, माह एने साणाह पाड़ावान बाहेर आक्‍ठाम हेलगाड्यो, जिह केरीन यहोवा मुसाह उकुम आपेल इतो।<verse eid="LEV 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 8:18" />ओवतो मुसो होमबोलीन मेंडाह लावो, हारून एने तान सोरा तान आथ मेंडान मुंडा पोर मेल्या। <verse eid="LEV 8:18" /><verse number="19" style="v" sid="LEV 8:19" />तेवी मुसो मेंडाह बोली किऱ्यो, एने तो वेदीन कावदेन लुय सिड़क्‍यो। <verse eid="LEV 8:19" /><verse number="20" style="v" sid="LEV 8:20" />तेवी मेंडो टुकड़ा टुकड़ा केराय गीयो, एने मुसो मुंड एने चेरबी बेल टुकड़ाह हेलगाड्यो। <verse eid="LEV 8:20" /><verse number="21" style="v" sid="LEV 8:21" />तेवी आते एने पाय पाण्या केरीन दोवाय गीया, एने मुसो पुरा मेंडाह वेदी पोर हेलगाड्यो, ज्यी आक्‍ठा माय बेट किरेल होमबोली एती। ज्यी यहोवान केरता हाजी गेंद एती, मुसो यहोवान उकुमान गेत आखा काम किऱ्यो।<verse eid="LEV 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 8:22" />तेवी मुसा दिहरा मेंडाह जो अबिषेक बोलीन मेंडो एतो ताह आहने लावो, हारून एने तान सोरा तान आथ मेंडान मुंडी पोर मेल्या। <verse eid="LEV 8:22" /><verse number="23" style="v" sid="LEV 8:23" />तेवी मुसो मेंडाह बोली किऱ्यो, एने तान लुयीम रेन थोड़ीक लेन हारूनान जीवड्या कानान सेवटा पोर एने तान जीवड्यो आथ एने जीवड्या पायान आंगठा पोर लागाड्यो। <verse eid="LEV 8:23" /><verse number="24" style="v" sid="LEV 8:24" />तेवी तो हारूनान सोराह आहने ली गीयो, एने लुयीम रेन थोड़ीक एक एकान जीवड्या कानान सेवटा पोर एने जीवड्यो आथ एने जीवड्या पायान आंगठा पोर लागाड्यो; एने मुसो लुयीह वेदी पोर कावदेन सिड़क्‍यो। <verse eid="LEV 8:24" /><verse number="25" style="v" sid="LEV 8:25" />एने तो चेरबी, एने चेरबी वाली सेमटी, एने आतड्या पोर वाली आखी चेरबी, एने कालजाह डापण्‍यी कातली बेल दुयू बुका एने जिवड़ी जांग, ज्‍य आखो लेन आलेग मेली। <verse eid="LEV 8:25" /><verse number="26" style="v" sid="LEV 8:26" />एने अखमीरी रोटान टोपली जी यहोवान ओंगाण मेलायेल एती, ताम रेन एक अखमीरी रूटो, एने तेला माय कुहणायेल मोयदान एक रूटो, एने एक रूटो लेन चेरबी एने जिवड्यी जांगी पोर मेल दिनो; <verse eid="LEV 8:26" /><verse number="27" style="v" sid="LEV 8:27" />एने मुसा ज्यु आख्यु वोस्तुह हारून एने तान सोरान आथाम मेल दिनो, एने आलाड़नेन बेटीन केरता यहोवान ओंगाण आलाड़ाय गियी। <verse eid="LEV 8:27" /><verse number="28" style="v" sid="LEV 8:28" />तेवी मुसो ज्‍यु चिजुह हारून एने तान सोरान आथाम रेन लिदो, ताह वेदी पोर होमबोलीन उपेर हेलगाड्यो, ज्‍य यहोवाह केरता हाजी गेंद आपणेन केरता अबिषेक ने बेट एने यहोवान केरता आक्‍ठान बोली एती। <verse eid="LEV 8:28" /><verse number="29" style="v" sid="LEV 8:29" />तेवी मुसो ता मेंडान सातीह लेन आलाड़नेन बेटीन केरता यहोवान ओंगाण आलाड्यो; एने अबिषेक ने मेंडा माय रेन मुसान ईसो ज्‍योस इनो, जिह केरीन यहोवा मुसाह उकुम आपेल इतो।<verse eid="LEV 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 8:30" />तेवी मुसो अबिषेक ने तेल एने वेदी पोर वाली लुय, दुयूम रेन थोड़ीक लेन हारून एने तान फाड़का पोर एने तान सोरा एने तान फाड़का पोर बी सिड़क्‍यो; एने तो फाड़का बेल हारूनाह बी चोखो किऱ्यो।<verse eid="LEV 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 8:31" />तेवी मुसो हारून एने तान सोराह केयो, “माहाह मिलापवाला तोम्बुन बायणा पोर रांदो, एने ता रोटाह जो अबिषेक बेटीन टोपली माय हे तोस खावो, जीह मी उकुम आपेल हे काय हारून एने तान सोरा ताह खाय। <verse eid="LEV 8:31" /><verse number="32" style="v" sid="LEV 8:32" />केदी माह एने रूटो वोच जाय, ताहार ताह हेलगाड़ दिज्यो। <verse eid="LEV 8:32" /><verse number="33" style="v" sid="LEV 8:33" />एने जाह वोर तुमरा अबिषेक ने दिह पुरा नाय एती ताह वोर, मतलब हात दिह वोर मिलापवाला तोम्बुन बायणान बाहेर मा जाहो, काहाकाय तो हात दिह वोर तुमूह अबिषेक केरते रेय। <verse eid="LEV 8:33" /><verse number="34" style="v" sid="LEV 8:34" />जिह केरीन आज केरायेल हे, तिहेच केरीन केरनेन उकुम यहोवा आपेल हे, जा केरीन तुमरा पाप डापाय जाय। <verse eid="LEV 8:34" /><verse number="35" style="v" sid="LEV 8:35" />केरीन तुमू मिलापवाला तोम्बुन बायणा पोर हात दिह वोर रात दिह रोकाय रिज्यो, एने यहोवान उकुमाह मानज्‍यो, ताहार तुमू मोर नाय जाहो; काहाकाय ओहलोच उकुम माहु आपायेल हे।” <verse eid="LEV 8:35" /><verse number="36" style="v" sid="LEV 8:36" />तेवी यहोवा कियेल ता आखा उकुमान गेत जो तो मुसान द्वारा आपेल इतो, हारून एने तान सोरा केऱ्या।<verse eid="LEV 8:36" /></para>
  <chapter eid="LEV 8" />
  <chapter number="9" style="c" sid="LEV 9" />
  <para style="s">हारूनान द्वारा बोली चेड़ावणो</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 9:1" />आठवे दिह मुसो हारून एने तान सोराह एने इस्राएली डायडायाह हाद्यो, <verse eid="LEV 9:1" /><verse number="2" style="v" sid="LEV 9:2" />एने हारूनाह केयो, “पापबोलीन केरता एक हाजो वासड़ो, एने होमबोलीन केरता एक हाजो मेंडो लेन यहोवान सामने बेट चेड़ाव। <verse eid="LEV 9:2" /><verse number="3" style="v" sid="LEV 9:3" />एने इस्राएल ने माणहाह ज्‍य के, तुमू पापबोलीन केरता एक बुकोड़, एने होमबोलीन केरता एक वासड़ो एने एक मेंड्रान पिलो लिवो, जा एक वोरह्यान एय एने हाजो एय, <verse eid="LEV 9:3" /><verse number="4" style="v" sid="LEV 9:4" />एने मेल मिलाप बोलीन केरता यहोवान सामने चेड़ावणेन केरता एक बुयेल एने एक मेंडो एने तेला केरीन कुहणायेल मोयदान एक एन बेट बी लेय लिवो; काहाकाय आज यहोवा तुमूह देरसेन आपी।”<verse eid="LEV 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 9:5" />एने जी जी चिजीन उकुम मुसो आपेल, त्यु आख्युह ता मिलापवाला तोम्बुन ओंगाण लीयावा; एने आखी मोंडली आहने जाएन यहोवान सामने उबरी गियी। <verse eid="LEV 9:5" /><verse number="6" style="v" sid="LEV 9:6" />तेवी मुसो केयो, “ज्‍य तो काम हे जाह केरनेन केरता यहोवा उकुम आपेल हे काय तुमू ताह किरो; एने यहोवान बोड़ाय तुमूह देखाय।” <verse eid="LEV 9:6" /><verse number="7" style="v" sid="LEV 9:7" />तेवी मुसो हारूनाह केयो, “यहोवान उकुमान गेत वेदीन आहने जाएन तान पापबोली एने होमबोलीह चेड़ावीन तान एने आखा माणहान पापाह डाप; एने माणहान केरता बोलीह चेड़ावीन तान पाप डाप।”<verse eid="LEV 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 9:8" />तानकेरता हारून वेदीन आहने जाएन तान पापबोलीन वासड़ान बोली किऱ्यो। <verse eid="LEV 9:8" /><verse number="9" style="v" sid="LEV 9:9" />एने हारूनान सोरा लुयीह ता फाय ली गीया, तेवी तो तान आंगलीह लुयीम बुड़ावीन वेदीन हिंगा पोर लागाड्यो, एने वुचेल लुयीह वेदीन पाया पोर रोचीव दिनो; <verse eid="LEV 9:9" /><verse number="10" style="v" sid="LEV 9:10" />एने पापबोली मायवाली चेरबी एने बुका एने कालजा पोर ने चेरबी वाली कातली तो वेदी पोर हेलगाड्यो, जीहे यहोवा मुसाह उकुम आपेल इतो। <verse eid="LEV 9:10" /><verse number="11" style="v" sid="LEV 9:11" />तेवी हारून पाड़ावान बाहेर माह एने चामड़ाह हेलगाड्यो।<verse eid="LEV 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 9:12" />तेवी होमबोलीन जेनवेराह बोली केऱ्या; एने हारूनान सोरा लुयीह तान आथाम आप्या, एने तो तीह वेदी पोर कावदेन सिड़ेक दिनो। <verse eid="LEV 9:12" /><verse number="13" style="v" sid="LEV 9:13" />तेवी ता होमबोलीन जेनवेराह टुकड़ा टुकड़ा केरीन मुंडा बेल तान आथाम आप देना, एने तो ताह वेदी पोर हेलगाड़ दिनो। <verse eid="LEV 9:13" /><verse number="14" style="v" sid="LEV 9:14" />एने तो आते एने पायाह दोवीन वेदी पोर होमबोलीन उपेर हेलगाड्यो।<verse eid="LEV 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 9:15" />तेवी तो माणहान चेड़ावाह ओंगाण ली जाएन एने ता पापबोलीन बोकड़ाह जो तानकेरता इतो लेन बोली किऱ्यो, एने पेल ने गेत ताह बी पापबोली केरीन चेड़ायो। <verse eid="LEV 9:15" /><verse number="16" style="v" sid="LEV 9:16" />एने तो होमबोलीह बी आहने ली जाएन रितीन गेत चेड़ायो। <verse eid="LEV 9:16" /><verse number="17" style="v" sid="LEV 9:17" />एने एन बेटीह बी आहने ली जाएन तीम रेन मुठबोर वेदी पोर हेलगाड्यो, ज्‍य वेगोस ने होमबोलीन बिगेर चेड़ावाय गीयो।<verse eid="LEV 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 9:18" />बुयेल एने मेंडो, मतलब जा मेल मिलाप बोली जेनवार, माणहान केरता एता ता बी बोली केराय गीया; एने हारूनान सोरा लुयीह तान आथाम आप्या, एने तो ताह वेदी पोर कावदेन सिड़ेक दिनो। <verse eid="LEV 9:18" /><verse number="19" style="v" sid="LEV 9:19" />एने तो बोयलान चेरबीह, एने मेंडा माय रेन चेरबीदार सेमटिह, एने जी चेरबी केरीन आते डापेल रेतेह तीह, एने बुका बेल कालजा पोर ने चेरबी वाली कातली बी तान आथाम आप्या। <verse eid="LEV 9:19" /><verse number="20" style="v" sid="LEV 9:20" />एने ता चेरबीह साती पोर मेल्या; एने तो ती चेरबी वेदी पोर हेलगाड्यो, <verse eid="LEV 9:20" /><verse number="21" style="v" sid="LEV 9:21" />पुण साती एने जिवड़ी जांगीह हारून मुसान उकुमान गेत आलाड़नेन बेटीन केरता यहोवान सामने आलाड्यो।<verse eid="LEV 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 9:22" />तेवी हारून माणहा निही आथ ओंगाण केरीन ताह बोरकेत आप्यो; एने पापबोली, होमबोली, एने मेल मिलाप बोलीह चेड़ावीन तो नेचो उतेर आवो। <verse eid="LEV 9:22" /><verse number="23" style="v" sid="LEV 9:23" />तेवी मुसो एने हारून मिलापवाला तोम्बुम गीया, एने निकलीन माणहाह बोरकेत आप्या; तेवी यहोवान बोड़ाय आखा माणहाह देखानी। <verse eid="LEV 9:23" /><verse number="24" style="v" sid="LEV 9:24" />एने यहोवान सामने रेन आक्‍ठो निकेलनो एने चेरबी बेल होमबोलीह वेदी पोर हेलगाड़ दिनो; आखा माणहे ज्‍य देखीन जय जयकार केऱ्या एने ता बुय पोर पोड़ीन वोंद्या।<verse eid="LEV 9:24" /></para>
  <chapter eid="LEV 9" />
  <chapter number="10" style="c" sid="LEV 10" />
  <para style="s">नादाब एने अबीहुन पाप</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 10:1" />तेवी नादाब एने अबीहु नावान हारूनान दुय सोरा तान तान दुपदान<note caller="+" style="f"><char style="fr" closed="false">10:1 </char><char style="fq" closed="false">दुपदान </char><char style="ft" closed="false">आरतीन तेली </char></note> लेदा, एने ताम आक्‍ठो बोऱ्या, एने ताम हालयान ढिक टाकीन आलेगुच आक्‍ठाह जान उकुम यहोवा नाह आपेल इतो, यहोवान सामने बोली केऱ्या। <verse eid="LEV 10:1" /><verse number="2" style="v" sid="LEV 10:2" />तेवी यहोवान आहने रेन आक्‍ठो निकेलनो एने ता दुयाह हेलगाड़ देनो, एने ता यहोवान सामने मोर गीया। <verse eid="LEV 10:2" /><verse number="3" style="v" sid="LEV 10:3" />तेवी मुसो हारूनाह केयो, “ज्यी तीस वात हे, जीह यहोवा कियेल इतो काय जो मार आहने आवी, जोरेवरी हे काय तो माहु चोखालो सोमजे, एने आखा माणहान सामने मारी बोड़ाय किरे।” एने हारून ठावकोस रिनो।<verse eid="LEV 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 10:4" />तेवी मुसो मीशाएल एने एलसाफनाह जा हारूनान आजालोख उज्‍जीएलान सोरा एता हादिन केयो, “आहने आवो, एने तान बोतेरजाख चोखाला जागान सामने रेन विसीन पाड़ावान बाहेर ली जावो।” <verse eid="LEV 10:4" /><verse number="5" style="v" sid="LEV 10:5" />मुसान ज्या उकुमान गेत ता आहने जाएन ताह फाड़का बेल विसीन पाड़ावान बाहेर ली गीया। <verse eid="LEV 10:5" /><verse number="6" style="v" sid="LEV 10:6" />तेवी मुसो हारूनाह एने तान सोरा एलीआजर एने ईतामाराह केयो, “तुमू तुमरे मुंडान लेट्या मा वेरो, एने नाह तुमरा फाड़काह फाड़ो ओहलो नाय एय काय तुमू बी मोर जाहो, एने आखी मोंडली पोर तान राग बोड़ेक उठे; पुण तो इस्राएल ने आखा गेराणान माणहे जा तुमरा बायबोंद हेते, एने जा यहोवान लागाड़ेल आक्‍ठा केरीन हेलगी गीया तान केरता दुख मोणावो। <verse eid="LEV 10:6" /><verse number="7" style="v" sid="LEV 10:7" />एने तुमू मिलापवाला तोम्बुन बायणान बाहेर मा जाहो, ओहलो नाय एय काय तुमू मोर जावो; काहाकाय यहोवान अबिषेकान तेल तुमरी पोर लागेल हे।” मुसान ज्या वचनान गेत ता केऱ्या।<verse eid="LEV 10:7" /></para>
  <para style="s">चाकर्‍यान केरता नेम</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 10:8" />ओवतो यहोवा बोगवान हारूनाह केयो, <verse eid="LEV 10:8" /><verse number="9" style="v" sid="LEV 10:9" />“जाह वोर तु नाहते तारा सोरा मिलापवाला तोम्बुम आवती, तेवी तुमरे माय रेन कुण बी अंगुरान दारो पियेल रेय एने नाह काल्ली बातीन मद्य। केदी ओहलो नाय एय काय तुमू मोर जावो; तुमरी पिढ़ी पिढ़ीम ज्‍यो नेम चालते रेय, <verse eid="LEV 10:9" /><verse number="10" style="v" sid="LEV 10:10" />जा केरीन तुमू चोखालो एने एठाम, एने हाजालो एने खाराब माय फारेक केर सीको। <verse eid="LEV 10:10" /><verse number="11" style="v" sid="LEV 10:11" />एने इस्राएल ने माणहाह ता आखा नेमाह हिकाड़ सिकहो, जाह यहोवा मुसान द्वारा ताह केय दियेल हे।”<verse eid="LEV 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 10:12" />ओवतो मुसो हारूनाह एने तान वोचेल दुयू सोरा एलीआजर एने ईतामाराह बी केयो, “यहोवान आक्‍ठाम हेलगाड़ेल बोली माय रेन जो एन बेट वुचेल हे, ताह लेन तुमू वेदीन आहने बिगेर खमीर बेचकेल खावो, काहाकाय ती बेट जुलूम हाजी हे। <verse eid="LEV 10:12" /><verse number="13" style="v" sid="LEV 10:13" />एने तुमू ताह एगदा चोखाला जागाम खावो, तो यहोवाह आक्‍ठान द्वारा हेलगाड़ेल बोली माय रेन तारो एने तारा सोरान हेक हे; काहाकाय मी ओहलोस उकुम सापड़ायेल हे। <verse eid="LEV 10:13" /><verse number="14" style="v" sid="LEV 10:14" />पुण आलाड़ेल बेटीन साती एने विसेल बेटीन जांगीह तुमू, मतलब तु एने तारा बेटा बेट्युख आखा एगदा हाजाला जागाम खावो; काहाकाय ता इस्राएलीन मेल मिलाप बोली माय रेन तुवाह एने तारा सोरान हेक ठेराव दियेल हे। <verse eid="LEV 10:14" /><verse number="15" style="v" sid="LEV 10:15" />माणहाह तान जेनवेरान चेरबी आक्‍ठाम हेलगाड़न्यी बोलीन रूप माय लावणे जुवे, ताह मेल मिलाप बोलीन जांग एने आलाड़ेल साती यहोवान सामने आलाड़नेन केरता आया केरी; ज्या ईसा यहोवान उकुमान गेत जेलेम ने विदीन नेमा केरीन तारा एने तारा सोरान केरता हे।”<verse eid="LEV 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 10:16" />ओवतो मुसो पापबोलीन बोकड़ाह हुद्यो, ते काय दिख्यो काय तो हेलगाड़ाय जायेल हे। तानकेरता एलीआजर एने ईतामार जा हारूनान सोरा वोचेल एता, ताह तो रागा माय आवीन केणे बाज गीयो, <verse eid="LEV 10:16" /><verse number="17" style="v" sid="LEV 10:17" />“पापबोली जी चोखाली हे एने जाह यहोवा तुमूह ज्यानकेरता आपेल हे काय तुमू मोंडलीन गुनान बार तुमरी पोर विसीन तानकेरता यहोवान सामने पाप डापे, तुमू तान माह चोखाला जागाम काहा नाह खादा? <verse eid="LEV 10:17" /><verse number="18" style="v" sid="LEV 10:18" />दिखो, बोकड़ान लुय चोखाला जागान मायता नाह लावा, तुमूह ज्या बोकड़ाह चोखाला जागा पोर खाणु एतो, जिह केरीन मी उकुम आपेल हे।”<verse eid="LEV 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 10:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:19 </char>
      <char style="xt" closed="false">
        <ref loc="LEV 10:1-2">10:1-2</ref>; <ref loc="LEV 17">17</ref></char>
    </note>ज्यान जापाप हारून मुसाह इहकेरीन आप्यो; “देख, आजुस ता तान पापबोली एने होमबोलीह यहोवान सामने चेड़ाया; ओवती मार पोर ओहली पिड़ा आव पुड़ेल हे! केरीन केदी मी आज पापबोलीन माह खातो, ताहार काय ज्यी वात यहोवान सामने हाजी रेती?” <verse eid="LEV 10:19" /><verse number="20" style="v" sid="LEV 10:20" />जेवी मुसो ज्‍य होमल्यो तेवी ताह ज्यी वात हाजी लागी।<verse eid="LEV 10:20" /></para>
  <chapter eid="LEV 10" />
  <chapter number="11" style="c" sid="LEV 11" />
  <para style="s">हाजाला एने बाकताला जेनवेर</para>
  <para style="r">(<ref loc="DEU 14:3-21">व्यवस्था 14:3-21</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 11:1" />ओवतो यहोवा मुसाह एने हारूनाह केयो, <verse eid="LEV 11:1" /><verse number="2" style="v" sid="LEV 11:2" />इस्राएल ने माणहाह किवो, जोला जेनवारे देरती पोर हेते, ता आखा माय रेन तुमू न्या जेनवेरान माह खाय सेकतेह। <verse eid="LEV 11:2" /><verse number="3" style="v" sid="LEV 11:3" />जेनवारा माय रेन जोला चिरायेल नाहते फाटेल खुर्‍यान रेतेह एने वेगेलतेह, ताह खाय सेकतेह। <verse eid="LEV 11:3" /><verse number="4" style="v" sid="LEV 11:4" />पुण वेगेलनारे नाहते फाटेल खुर्‍यावाला माय रेन न्या जेनवाराह मा खाहो, मतलब उटड़ो, जो वेगोल ते किरेह, पुण चिरायेल खुर्‍यान नाह रेत, तानकेरता तो तुमरी केरता एठो ठेरायेल हे। <verse eid="LEV 11:4" /><verse number="5" style="v" sid="LEV 11:5" />एने शापान, जो वेगोल ते किरेह पुण चिरायेल खुर्‍यान नाह रेत, तो बी तुमरी केरता एठो हे। <verse eid="LEV 11:5" /><verse number="6" style="v" sid="LEV 11:6" />एने हुहल्यो जो वेगोल ते किरेह पुण चिरायेल खुर्‍यान नाह रेत, केरीन तो बी तुमरी केरता एठो हे। <verse eid="LEV 11:6" /><verse number="7" style="v" sid="LEV 11:7" />एने हुवोर, जो चिरायेल खुर्‍यान रिथे पुण वेगोल नाह किरेत, तानकेरता तो तुमरी केरता एठो हे। <verse eid="LEV 11:7" /><verse number="8" style="v" sid="LEV 11:8" />न्यान माहाम रेन कायच मा खाहो, एने न्यान देड़ाह आथेलहो बी मा; ज्या ते तुमरी केरता एठा हेते।<verse eid="LEV 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 11:9" />पोशा जोला पाण्‍यावाला जीव हेते ताम रेन तुमू न्याह खाय सेकतेह, मतलब देरीयो नाहते नेदीन पाण्‍यावाला जीवजेन्तु माय रेन जोलान फाके एने खोपण्या रेतेह ताह खाय सेकतेह। <verse eid="LEV 11:9" /><verse number="10" style="v" sid="LEV 11:10" />एने पाण्‍यावाला जेनवाराम रेन जोला जीवदारी बिगेर फाकान एने खोपण्या वाला देरीयो नाहते नेदीम रेतेह, ता आखा तुमरी केरता खाराब हेते। <verse eid="LEV 11:10" /><verse number="11" style="v" sid="LEV 11:11" />ता तुमरी केरता खाराब ठेराना; तुमू तान माहाम रेन कायच मा खाहो, एने तान देड़ाह बी एठा जाणज्‍यो। <verse eid="LEV 11:11" /><verse number="12" style="v" sid="LEV 11:12" />पाण्याम एगदान जेन्तुन फाके एने खोपण्या नाह रेते, ता तुमरी केरता एठा हेते।<verse eid="LEV 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 11:13" />ओवता चिड़ा माय रेन न्याह एठा जाणज्‍यो, ज्या एठा बोणनेन वोजेसे खावाय नाय जाती, मतलब गरूड़, दाड़ी वालो गिदड़, काल्लो गुवड़ो, <verse eid="LEV 11:13" /><verse number="14" style="v" sid="LEV 11:14" />रातलो चिड़ो, एने बात बातीन काल्ला गुवड़ा, <verse eid="LEV 11:14" /><verse number="15" style="v" sid="LEV 11:15" />एने आखी बातीन कागला, <verse eid="LEV 11:15" /><verse number="16" style="v" sid="LEV 11:16" />शुतुर्मुग, रात शिकरा, कारा, एने बात बातीन डिंडो, <verse eid="LEV 11:16" /><verse number="17" style="v" sid="LEV 11:17" />डुडो, बोगल्यो, गुगदो, <verse eid="LEV 11:17" /><verse number="18" style="v" sid="LEV 11:18" />राजहंस, दनेश, गीद, <verse eid="LEV 11:18" /><verse number="19" style="v" sid="LEV 11:19" />सारस, बातीन बोगल्‍या, टिटेवड़ो एने वोट वागलो।<verse eid="LEV 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 11:20" />जोला फाकावाला किड़ा चार पायान बोरहे चालतेह ता आखा तुमरी केरता एठा हेते। <verse eid="LEV 11:20" /><verse number="21" style="v" sid="LEV 11:21" />पुण लोलनारे किड़ा एने फाकावाला जा चार पायान बोरहे चालतेह, जान बुय पोर कुदणे टांगड्या रेतेह ताह ते खाय सेकतेह, <verse eid="LEV 11:21" /><verse number="22" style="v" sid="LEV 11:22" />ता ज्या हेते, मतलब बात बातीन टिड्या, बुबला, मुत्रा, टिड्या <verse eid="LEV 11:22" /><verse number="23" style="v" sid="LEV 11:23" />पुण आखा लोलनारे एने फाकावाला बुमणावा जा चार पायावाला रेतेह ता तुमरी केरता एठा हेते।<verse eid="LEV 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 11:24" />न्यान वोजेसे तुमू एठा ठेराहो; एगदा फाय रेन न्यान देड़ सापलाय जाय तो हांज पोर वोर एठो ठेराय। <verse eid="LEV 11:24" /><verse number="25" style="v" sid="LEV 11:25" />एने जो कुण न्यान देड़ावालो काय बी विसे तो तान फाड़का दोवे एने हांज पोर वोर एठो रेय। <verse eid="LEV 11:25" /><verse number="26" style="v" sid="LEV 11:26" />ओवता जोला जेनवारे चिरायेल खुर्‍यान रेतेह, पुण नाह फाटेल खुर्‍यान एने नाह वेगोल केरनारे हेते, ता तुमरी केरता एठा हेते; जो कुण ताह सापले तो एठो ठेराय। <verse eid="LEV 11:26" /><verse number="27" style="v" sid="LEV 11:27" />एने चार पायान बोरहे चालनार जेन्तुम रेन जोला तेलसान बोरहे चालतेह ता आखा तुमरी केरता एठा हेते; जो कुण तान देड़ आथले तो हांज पोर वोर एठो रेय। <verse eid="LEV 11:27" /><verse number="28" style="v" sid="LEV 11:28" />एने जो कुण तान देड़ विसी तो तान फाड़का दोवे एने हांज पोर वोर एठो रेय; काहाकाय ता तुमरी केरता एठा हेते।<verse eid="LEV 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 11:29" />जा देरती पोर लोलतेह ताम रेन ज्या लोलनारे जेन्तु तुमरी केरता एठा हेते, मतलब नोवल्‍यो, उंदर्‍यो, एने बात बातीन गेरफेड़ो, <verse eid="LEV 11:29" /><verse number="30" style="v" sid="LEV 11:30" />एने हेयड्यो, मुगोर, गिरवलो, सांडा एने आलहेयड्यो। <verse eid="LEV 11:30" /><verse number="31" style="v" sid="LEV 11:31" />आखा लोलनारा जेन्तु माय रेन ज्यास तुमरी केरता एठा हेते; जो कुण न्यान देड़ आथले तो हांज पोर वोर एठो रेय। <verse eid="LEV 11:31" /><verse number="32" style="v" sid="LEV 11:32" />एने न्‍याम रेन एगदान देड़ एगदी चिजी पोर पोड़ जाय ती बी एठी ठेराय, केदी तो लाकड़ान एगदो ठामलो एय, केदी फाड़का, केदी चामड़ो, केदी दुख माणावणेन फाड़का, केदी एगदा कामान कोहलोक बी ठामलो सोब काहा नाय रेय; तो पाण्याम टाकाय जाय, एने हांज पोर वोर एठो रेय, तेवी चोखो सोमजाय जाय। <verse eid="LEV 11:32" /><verse number="33" style="v" sid="LEV 11:33" />एने केदी माटड्यान एगदो ठामलो रेय, जा माय न्या जेन्तुम रेन एगदो पोड़ी, ताहार ता ठामलाम जो काय एय तो एठो ठेराय, एने ठामलाह तुमू फोड़ दिज्यो। <verse eid="LEV 11:33" /><verse number="34" style="v" sid="LEV 11:34" />केदी एठा ठामलान पाणी एगदा खाणा पोर पोड़ी, ताहार खाणो एठो एय जाय; केदी ओहला ठामलाम पिणेन केरता काह एय, ताहार तो बी एठो ठेराय। <verse eid="LEV 11:34" /><verse number="35" style="v" sid="LEV 11:35" />एने केदी मुरेल खाराब जेनवारान एगदो ईसो एगदी चिजी पोर आव पोड़ी, ताहार ती चिज चोखी नाय रेय, तीह टुकड़ा टुकड़ा केर देणे जुवे; केदी तो तंदूर एय केदी केड़ाय, ता तुमरी केरता जेलेम एठी रेय। <verse eid="LEV 11:35" /><verse number="36" style="v" sid="LEV 11:36" />पुण जिर नाहते तेलो जा माय पाणी एकठो रेय, तो ते चोखोच रेय; पुण जो कुण न्यान देड़ाह सापली तो एठो ठेराय। <verse eid="LEV 11:36" /><verse number="37" style="v" sid="LEV 11:37" />केदी ता मुरेल जेनवारान एगदो ईसो पेरन्‍या बियारा पोर आव पोड़ी, तीबी तो बियारो चोखो रेय; <verse eid="LEV 11:37" /><verse number="38" style="v" sid="LEV 11:38" />पुण बिजाड़णेन केरता केदी तुमू थोड़ाक बियारा पोर पाणी टाकतेह, एने तेवी केदी मुरेल जेनवारान एगदो ईसो ता बियारा पोर आव पोड़ी, ताहार तो बियारो तुमरी केरता एठो हे।<verse eid="LEV 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 11:39" />“उंजु जा पालन्या जेनवाराह खाणेन उकुम तुमूह आपेल हे, केदी ताम रेन एगदो जेनवार मोरी, ताहार जो कुण तान देड़ाह सापली, तो हांज पोर वोर एठो रेय। <verse eid="LEV 11:39" /><verse number="40" style="v" sid="LEV 11:40" />एने तान देड़ा माय रेन जो कुण काह खाय तो तान फाड़का दोवे, एने हांज पोर वोर एठो रेय, एने जो कुण तान देड़ विसी तो बी तान फाड़का दोवे एने हांज पोर वोर एठो रेय।<verse eid="LEV 11:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LEV 11:41" />“आखी बातीन देरती पोर लोलनारे जेन्तु हेते; ता खावाती नाय। <verse eid="LEV 11:41" /><verse number="42" style="v" sid="LEV 11:42" />देरती पोर आखा लोलनारे जेन्तु माय रेन जोला पेटान एने चार पायान बोरहे चालतेह, एने वोदार पायावाला रेतेह, ताह तुमू मा खाहो; काहाकाय ता खाराब हेते। <verse eid="LEV 11:42" /><verse number="43" style="v" sid="LEV 11:43" />तुमू काल्ली बातीन लोलनारा जेन्तुन द्वारा सोताह खाराब मा किरहो; एने नाह तान द्वारा सोताह खाराब केरीन एठा ठेराज्‍यो। <verse eid="LEV 11:43" /><verse number="44" style="v" sid="LEV 11:44" />काहाकाय मी तुमरो बोगवान यहोवा हे; केरीन सोताह चोखो केरीन चोखा बोणीन रिवो, काहाकाय मी चोखो हे। तानकेरता तुमू काल्ली बातीन लोलनारे जेन्तुन द्वारा जो देरती पोर चालेह, सोताह एठा मा किरहो। <verse eid="LEV 11:44" /><verse number="45" style="v" sid="LEV 11:45" />काहाकाय मी तो यहोवा हे, जो तुमूह मिस्र देसाम रेन ज्यानकेरता निकाल लायेल हे काय तुमरो बोगवान ठेराव; केरीन तुमू चोखाला बोणो, काहाकाय मी चोखालो हे।”<verse eid="LEV 11:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LEV 11:46" />जेनवारे, चिड़ा एने आखा पाण्‍यावाला जेनवारे, एने देरती पोर आखा लोलनारे जेनवारान बाराम ज्‍योस नेम हे, <verse eid="LEV 11:46" /><verse number="47" style="v" sid="LEV 11:47" />काय माणहे हाजाला जेनवारे एने खाराब जेनवारा माय फारेक केर सेकती, इह केरीन माणहे जाणती काय काल्लो जेनवार खाणेन लायकी हे एने काल्लो खाणेन लायकी नाह सोतो।<verse eid="LEV 11:47" /></para>
  <chapter eid="LEV 11" />
  <chapter number="12" style="c" sid="LEV 12" />
  <para style="s">सोरो पायदा एणेन बाद आईख ने चोखो एणेन नेम</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 12:1" />ओवतो यहोवा मुसाह केयो, <verse eid="LEV 12:1" /><verse number="2" style="v" sid="LEV 12:2" />इस्राएल ने माणहाह किवो, केदी एगदी बायकु सोराह पायदा किरेह, ताहार ती बायकु हात दिह वोर एठी रेय; ज्‍य तीन फाड़को आवणेन टेम एठी एणेन गेत रेय। <verse eid="LEV 12:2" /><verse number="3" style="v" sid="LEV 12:3" />एने आठवे दिह सोरान खेतना एणे जुवे। <verse eid="LEV 12:3" /><verse number="4" style="v" sid="LEV 12:4" />ओवती ती बायकु चोखो केरन्या खुना माय तेहतीस दिह रेय; एने जाह वोर तीन चोखो एणेन दिह पुरा नाय एती ताह वोर ती नाहते एगदी चोखाली चिजीह सापले, एने नाह चोखाला जागाम रिगे। <verse eid="LEV 12:4" /><verse number="5" style="v" sid="LEV 12:5" />केदी बायकु सोरीह पायदा किरेह, ताहार बायकु फाड़को आवणेन गेत दुय एपता वोर एठी रेय; एने ओवती साहासाठ दिह वोर तीन चोखो केरन्या खुना माय रेय।<verse eid="LEV 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 12:6" />जी एवी सोरी नाहते सोराह पायदा किरेल हे, ओहली बायकुन चोखो एणेन खास टेम पुरो एणेन बाद तीह मिलापवाला तोम्बु माय खास बेट लावणे जुवे, तीह ती बेटीह मिलापवाला तोम्बुन बायणा पोर चाकऱ्याह आपणे जुवे; तीह एक वोरह्यान मेंड्रान पिलो होमबोलीन केरता एने पापबोलीन केरता एक पेरवान एक पिलो नाहते ओलो लावणे जुवे। <verse eid="LEV 12:6" /><verse number="7" style="v" sid="LEV 12:7" />तेवी चाकर्‍यो ताह यहोवान सामने तीन केरता पासतावो किरे; एने ती तीन खुन वोयणेन एठोपोणा रेन सुटीन चोखी ठेराय, जी बायकुन सोरो नाहते सोरी पायदा एय तान केरता ज्‍योस नेम हे। <verse eid="LEV 12:7" /><verse number="8" style="v" sid="LEV 12:8" />एने केदी ती फाय मेंड्रो आपणेन ताकेत नाय रेय, ताहार दुय ओला नाहते पेरवान दुय पिला, एक ते होमबोली एने दिहरो पापबोलीन केरता आपी; एने चाकर्‍यो तीन केरता बोली केरी एने पाप डापे, तेवी ती चोखी ठेराय।<verse eid="LEV 12:8" /></para>
  <chapter eid="LEV 12" />
  <chapter number="13" style="c" sid="LEV 13" />
  <para style="s">कुष्‍ठ रोगान बाराम नेम</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 13:1" />ओवतो यहोवा मुसा एने हारूनाह केयो, <verse eid="LEV 13:1" /><verse number="2" style="v" sid="LEV 13:2" />जेवी एगदा माणहान सेरीर ने चामड़ा पोर हुज नाहते डामसो नाहते दोवल्या दाग रेती, केदी चामड़ा पोर कोढ़ान गेत देखाय, ताहार ताह हारून चाकऱ्या फाय नाहते तान सोरा जा चाकऱ्या हेते, ताम रेन एगदा फाय जाय। <verse eid="LEV 13:2" /><verse number="3" style="v" sid="LEV 13:3" />जेवी चाकर्‍यो तान चामड़ाह देखी, केदी जेखेम ने रोचका दोवल्या एय गीया एती एने जेखेम माणहान चामड़ा से वोदार देखाय, ताहार तो सोमजी जाय काय कोढ़ रोग हे; एने चाकर्‍यो ता माणहाह देखीन ताह एठो ठेरावे। <verse eid="LEV 13:3" /><verse number="4" style="v" sid="LEV 13:4" />पुण केदी तो दाग तान चामड़ा माय दोवल्या एय जातेह, पुण चामड़ान माय वोदार नाह देखाय, एने नाह ताहरी वाला रोचका दोवल्या एय गीया एती, ताहार चाकर्‍यो ता माणहाह सात दिह्यान केरता दिहरा माणहाह रेन आलेग केरी। <verse eid="LEV 13:4" /><verse number="5" style="v" sid="LEV 13:5" />एने हातवे दिह चाकर्‍यो ताह जाचे, केदी चाकर्‍यो देखी काय रोगा माय फारेक नाह पुड़ेल सोतो, एने तो चामड़ा पोर उंजु वोदार पोसरेल नाह सोतो ते चाकर्‍यो उंजु सात दिह्यान केरता ताह आलेग किरे। <verse eid="LEV 13:5" /><verse number="6" style="v" sid="LEV 13:6" />सात दिह बाद चाकर्‍यो ता माणहान पोशी जाच किरे, केदी देखाय काय रोग चामड़ा पोर पोसरेल नाय रेय, ते चाकर्‍यो ताह चोखो ठेरावे; काहाकाय तान चामड़ा माय पापड़ी हे; एने तो तान फाड़का दोवीन चोखो एय जाय। <verse eid="LEV 13:6" /><verse number="7" style="v" sid="LEV 13:7" />पुण केदी चाकर्‍यान ती जाचीन बाद जा माय तो चोखो ठेराय जायेल इतो, तो दाग तान चामड़ा पोर जुलूम पोसीर जाय, ताहार तो पोशो चाकऱ्याह देखाड़ने जाय; <verse eid="LEV 13:7" /><verse number="8" style="v" sid="LEV 13:8" />केदी चाकऱ्याह देखाय काय दाग चामड़ा माय पोसीर जायेल हे, ताहार चाकर्‍यो ताह एठो ठेरावे; काहाकाय तो कोढुस हे।<verse eid="LEV 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 13:9" />केदी कोढ़ रोगान गेत एगदा माणहान एय, ताहार तो चाकऱ्या फाय पोचाड़ाय जाय; <verse eid="LEV 13:9" /><verse number="10" style="v" sid="LEV 13:10" />एने चाकर्‍यो ताह देखी, एने केदी ती हुज तान चामड़ा माय दोवली रेय, एने तान वोजेसे रोचका बी दोवल्या एय गीया एती, एने ती हुज माय बिगेर चामड़ान माह रेय, <verse eid="LEV 13:10" /><verse number="11" style="v" sid="LEV 13:11" />ते चाकर्‍यो सोमजे काय तान चामड़ा माय जुनालो कोढ़ हे, तानकेरता तो ताह एठो ठेरावे; एने कोंडीन नाय मेली, काहाकाय तो एठो हे। <verse eid="LEV 13:11" /><verse number="12" style="v" sid="LEV 13:12" />केदी कोढ़ माणहान आखा सेरीरा पोर पोसीर जाय, तो कोढ़ ता माणहान चामड़ाह मुंडे रेन पाये वोर डाप लेय हे चाकऱ्याह देखानो, <verse eid="LEV 13:12" /><verse number="13" style="v" sid="LEV 13:13" />तेवी चाकर्‍यो देखी काय कोढ़ पुरा सेरीराह इह केरीन डापेल हे, काय ता माणहान पुरो सेरीरूस दोवल्यो एय जायेल हे, ते चाकर्‍यो ताह चोखालो ठेरावे। <verse eid="LEV 13:13" /><verse number="14" style="v" sid="LEV 13:14" />पुण जेवी ताम बिगेर चामड़ान जेखेम देखाय, तेवी तो एठो ठेराय। <verse eid="LEV 13:14" /><verse number="15" style="v" sid="LEV 13:15" />एने चाकर्‍यो बिगेर चामड़ावालो माहाह देखीन ताह एठो ठेरावे; काहाकाय तोहलो बिगेर चामड़ावालो माह एठोस रिथे; तो कोढ़ हे। <verse eid="LEV 13:15" /><verse number="16" style="v" sid="LEV 13:16" />पुण केदी तो माह पोशो दोवल्यो एय जाय, ताहार तो माणुह चाकऱ्या फाय जाय, <verse eid="LEV 13:16" /><verse number="17" style="v" sid="LEV 13:17" />एने चाकर्‍यो ता माणहाह जाचे, एने केदी तो रोग पोशो दोवल्यो एय गीयोय, ताहार चाकर्‍यो दुखाऱ्याह चोखो जाणे; तो चोखो हे।<verse eid="LEV 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 13:18" />उंजु केदी एगदान चामड़ा माय फुड़ा बोणीन हुदेर गीया एती, <verse eid="LEV 13:18" /><verse number="19" style="v" sid="LEV 13:19" />एने फोड़ान जागे दोवली हुज नाहते लाली लेन दोवल्यो दाग रेय, ताहार तो चाकऱ्याह देखाड़ी; <verse eid="LEV 13:19" /><verse number="20" style="v" sid="LEV 13:20" />एने चाकर्‍यो ती हुजीह देखी, एने केदी तो चामड़ा से वोदार देखाय, एने तान रोचका बी दोवल्या एय गीया एती, ताहार चाकर्‍यो ज्‍य जाणीन ता माणहाह एठो ठेरावे; काहाकाय तो कोढ़ान रोग हे जो फोड़ाम रेन फुटिन निकलेल हे। <verse eid="LEV 13:20" /><verse number="21" style="v" sid="LEV 13:21" />पुण केदी चाकर्‍यो देखी काय ताम दोवल्या रोचका नाह सोता, एने तो चामड़ा से वोदार नाह, एने तान चोमेक कोम एय जायेल हे, ते चाकर्‍यो ता माणहाह सात दिह वोर आलेग केरीन मेली; <verse eid="LEV 13:21" /><verse number="22" style="v" sid="LEV 13:22" />केदी तो रोग तुलबुखे वोर चामड़ा माय खेरीच पोसरी जाय, ताहार चाकर्‍यो ता माणहाह एठो ठेरावे; काहाकाय तो कोढ़ान बेमारी हे। <verse eid="LEV 13:22" /><verse number="23" style="v" sid="LEV 13:23" />पुण केदी तो दाग नाय पोसरे एने तान जागास पोर रेय, ताहार तो फोड़ान दाग हे; चाकर्‍यो ता माणहाह चोखो ठेरावे।<verse eid="LEV 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 13:24" />उंजु केदी एगदान चामड़ा माय हेलेगणेन जेखेम एय, एने ता हेलेगणेन जेखेम माय बिगेर चामड़ान दाग रातला से दोवल्यो एय जाय, <verse eid="LEV 13:24" /><verse number="25" style="v" sid="LEV 13:25" />ते चाकर्‍यो ताह देखी, केदी ता दागान रोचका दोवल्या एय जायेल हेते, एने तो चामड़ा से वोदार देखाय, ताहार तो कोढ़ हे; जो ता हेलेगणेन डागाम रेन फुट निकलेल हे; चाकर्‍यो ता माणहाह एठो ठेरावे; काहाकाय ताम कोढ़ान रोग हे। <verse eid="LEV 13:25" /><verse number="26" style="v" sid="LEV 13:26" />पुण केदी चाकर्‍यो देखी काय डागाम दोवल्या रोचका एने नाह तो चामड़ा से थोड़ोक वोदार हे, एने तान चोमेक कोम इयेल हे, ताहार तो ताह सात दिह वोर आलेग मीले, <verse eid="LEV 13:26" /><verse number="27" style="v" sid="LEV 13:27" />एने हातवे दिह चाकर्‍यो ताह देखी, एने केदी तो चामड़ा माय पोसीर जायेल एय, ताहार तो ता माणहाह एठो ठेरावे; काहाकाय ताह कोढ़ान रोग हे। <verse eid="LEV 13:27" /><verse number="28" style="v" sid="LEV 13:28" />पुण केदी तो दाग चामड़ा माय नाह पोसऱ्यो एने तान जागास पोर जाहरी ताहरीस हे, एने तान चोमेक कोम ईयेल हे, चाकर्‍यो ता माणहाह चोखो ठेरावे; काहाकाय ता दाग हेलेगणेन वोजेसे हे।<verse eid="LEV 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 13:29" />केदी एगदो एदमी एने बायकुन मुंडी पोर, नाहते एदम्यान दाड़ीम खुवड़ो रेय, <verse eid="LEV 13:29" /><verse number="30" style="v" sid="LEV 13:30" />ते चाकर्‍यो रोगाह देखी, एने केदी तो चामड़ा से वोदार देखाय, एने ता माय बोरला बारीक रोचका एती, ताहार चाकर्‍यो ता माणहाह एठो ठेरावे; तो रोग खुवड़ो, मतलब मुंडीन नाहते दाड़ीन कोढ़ हे। <verse eid="LEV 13:30" /><verse number="31" style="v" sid="LEV 13:31" />एने केदी चाकर्‍यो चामड़ान रोगाह देखी काय तो चामड़ा से वोदार नाह सोतो एने ताम काला रोचका नाह सोता, ताहार तो खोवड़ान दुखाऱ्याह हात दिह वोर आलेग मेली, <verse eid="LEV 13:31" /><verse number="32" style="v" sid="LEV 13:32" />एने सातवे दिह चाकर्‍यो दुखाऱ्याह देखी, तेवी केदी तो चामड़ान रोग पोसरेल नाय रेय, एने ताम पेल्ला रोचका नाय रेती, एने खुवड़ो चामड़ा से वोदार नाय देखाय, <verse eid="LEV 13:32" /><verse number="33" style="v" sid="LEV 13:33" />ताहार तो माणुह लेट्या काट लेणे जुवी, पुण जाहरी खुवड़ो रेय ताहरी काटाय नाय जाय; एने चाकर्‍यो ता चामड़ान रोगवालाह उंजु बी सात दिह वोर आलेग किरे; <verse eid="LEV 13:33" /><verse number="34" style="v" sid="LEV 13:34" />एने सातवे दिह चाकर्‍यो दादाह देखी, केदी तो खुवड़ो चामड़ा माय पोसरेल नाय रेन एने चामड़ा से वोदार नाय देखाय, ताहार चाकर्‍यो ता माणहाह चोखो ठेरावे; एने तो तान फाड़का दोवीन चोखो एय जाय। <verse eid="LEV 13:34" /><verse number="35" style="v" sid="LEV 13:35" />पुण केदी तान चोखो ठेराणेन बाद खुवड़ो चामड़ा माय काय बी पोसरे, <verse eid="LEV 13:35" /><verse number="36" style="v" sid="LEV 13:36" />ताहार चाकर्‍यो ताह देखी, एने केदी तो चामड़ा माय पोसरेल रेय, ताहार चाकर्‍यो बोरला रोचका नाय होदे; काहाकाय तो माणुह एठो हे। <verse eid="LEV 13:36" /><verse number="37" style="v" sid="LEV 13:37" />पुण केदी तान नेजरीम तो दाद जोहलो तोहलोच बोणीन रेय, एने ताम काल्ला रोचका जोम रेनाह, ताहार तो जाणे काय खुवड़ो हुदेर जायेल हे, एने तो माणुह चोखो हे; चाकर्‍यो ताह चोखोस ठेरावे।<verse eid="LEV 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LEV 13:38" />उंजु केदी एगदो एदमी नाहते बायकुन चामड़ा माय दोवल्या दाग एती, <verse eid="LEV 13:38" /><verse number="39" style="v" sid="LEV 13:39" />ताहार चाकर्‍यो देखी, एने केदी तान चामड़ा माय ता दाग कोम दोवल्या एती, ताहार तो जाणे काय ताह चामड़ा माय निकलेल खुवड़ो हे; तो माणुह चोखो हे।<verse eid="LEV 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LEV 13:40" />केदी एगदान मुंडीन लेट्या ओदरी जायेल हेते, ते जाणज्‍यो काय तो चांदरो ते हे पुण चोखो हे। <verse eid="LEV 13:40" /><verse number="41" style="v" sid="LEV 13:41" />एने जान निंडालान ओंगाणल्‍या लेट्या ओदीर गीया एती, ताहार तो निंडालान चांदलो ते हे, पुण चोखो हे। <verse eid="LEV 13:41" /><verse number="42" style="v" sid="LEV 13:42" />केदी चांदरा मुंडी पोर नाहते चांदरा निंडाला पोर रातलान गेत दोवल्यो रोग एय, ताहार जाणज्‍यो काय तो तान चांदरो मुंड नाहते चांदरा निंडाला पोर निकलेल कोढ़ हे। <verse eid="LEV 13:42" /><verse number="43" style="v" sid="LEV 13:43" />केरीन चाकर्‍यो ताह देखी, एने केदी दुखार्‍यान हुज तान चांदरा मुंड नाहते चांदरा निंडाला पोर रातलान गेत दोवल्‍यी रेय, जीहे चामड़ा माय कोढ़ाम रिथे, <verse eid="LEV 13:43" /><verse number="44" style="v" sid="LEV 13:44" />ताहार तो माणुह कोढ़ी हे एने एठो हे; एने चाकर्‍यो ताह जोरेवरी एठो ठेरावे; काहाकाय ती बेमारी तान मुंडी पोर हे।<verse eid="LEV 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LEV 13:45" />जा माय तो दुखाऱ्यो रेय ता कोढ़ीन फाड़का फाटेल एने मुंडीन लेट्या वेरायेल रेती, एने तो तान ओठाह डापीन एठो, एठो आतड्या किरे। <verse eid="LEV 13:45" /><verse number="46" style="v" sid="LEV 13:46" />जोला दिह वोर तो दुखाऱ्यो ताम रेय, तोला दिह वोर तो एठो रेय, एने तो एठो ठेरीन रेय; केरीन तो एखालोच रेया किरे, तान पाड़ावान बाहेर रेय।<verse eid="LEV 13:46" /></para>
  <para style="s">फाड़का नाहते चामड़ान चिजीन कोढ़</para>
  <para style="p">
    <verse number="47" style="v" sid="LEV 13:47" />ओवतो जा फाड़काम कोढ़ान बेमारी रेय, केदी तो फाड़को रोचकान रेय नाहते होणीन, <verse eid="LEV 13:47" /><verse number="48" style="v" sid="LEV 13:48" />ती बेमारी केदी ता होणीन नाहते रोचकान फाड़कान टुकड़ा माय नाहते ती बेमारी चामड़ा माय नाहते चामड़ान बोणेल एगदी चिजी माय रेय, <verse eid="LEV 13:48" /><verse number="49" style="v" sid="LEV 13:49" />केदी फाड़का, चामड़ान टुकड़ा नाहते एगदा चामड़ान वोस्तु माय खास जागे निल्लो नाहते रातलो देखाय, ताहार ज्यो एठो दाग हे एने ज्याह चाकऱ्याह देखाड़ने जुवे। <verse eid="LEV 13:49" /><verse number="50" style="v" sid="LEV 13:50" />एने चाकर्‍यो दागान जाच केरी, एने बेमारीवाली चिजीह सात दिह्यान केरता आलेग जागे मेली; <verse eid="LEV 13:50" /><verse number="51" style="v" sid="LEV 13:51" />एने सातवे दिह चाकर्‍यो ता दुखाऱ्याह देखी, केदी तो फाड़कान टुकड़ा नाहते चामड़ा माय नाहते चामड़ान बोणेल एगदी चिजी माय पोसीर गीयीय, ते जाणज्‍यो काय दाग नुकसान केरनार कोढ़ हे, केरीन ती चिज काल्ला बी कामाम काहा नाय आवी, तीबी एठो ठेराय। <verse eid="LEV 13:51" /><verse number="52" style="v" sid="LEV 13:52" />तो ता फाड़काह जान टुकड़ा माय ती बेमारी एय, केदी ती रोचकान रेय केदी होणीन नाहते चामड़ान चिजीन रेय, ताह हेलगाड़ देय, ती बेमारी नुकसान केरनार कोढ़ान हे; ती चिज आक्‍ठाम हेलगाड़ाय जाय।<verse eid="LEV 13:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LEV 13:53" />केदी चाकर्‍यो देखी काय ती बेमारी ता फाड़कान टुकड़ा माय, नाहते चामड़ान ती चिजीम नाह पोसर्‍यी, <verse eid="LEV 13:53" /><verse number="54" style="v" sid="LEV 13:54" />ताहार जी चिजीम रोग एय ताह दोवणेन उकुम आपी, तेवी चाकऱ्यो ताह उंजु बी सात दिह वोर आलेग मेली; <verse eid="LEV 13:54" /><verse number="55" style="v" sid="LEV 13:55" />एने ताह दोवणेन बाद चाकर्‍यो ताह देखी, एने केदी बेमारी नाहते रेंग बोदलेल एय, एने नाह बेमारी पोसरेल एय, ताहार जाणज्‍यो काय तो एठो हे; ताह आक्‍ठाम हेलगाड़ज्यो, काहाकाय केदी ती बेमारी माय केदी उपेर एय तीबी ती पोसेरनार बेमारी हे। <verse eid="LEV 13:55" /><verse number="56" style="v" sid="LEV 13:56" />पुण केदी चाकर्‍यो देखी काय ताह दोवणेन बाद बेमारीन चोमेक कोम एय गियी, ताहार तो ताह फाड़कान टुकड़ा माय नाहते चामड़ान ती चिजी माय देखाय, ताहार जाणज्‍यो काय तो फाड़ीन निकलेह; <verse eid="LEV 13:56" /><verse number="57" style="v" sid="LEV 13:57" />पुण दाग ता चामड़ा नाहते फाड़का पोर देखाय सिकेह, केदी ओहलो ईथे ताहार दाग वोदणे बाजरेनीह; ता चामड़ाह नाहते फाड़काह हेलगाड़ देणे जुवे। <verse eid="LEV 13:57" /><verse number="58" style="v" sid="LEV 13:58" />केदी ता फाड़कान टुकड़ा माय दाग एय, नाहते चामड़ान जी वोस्तु हे, ताह दोवणेन बाद दाग निकेल जाय, ते तो पोशो दोवाय जाय एने चोखो ठेराय।<verse eid="LEV 13:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LEV 13:59" />रोचकान एने होणीन फाड़कान टुकड़ा माय, नाहते चामड़ान एगदी वोस्तु माय जो कोढ़ ने दाग हे, तान चोखो एने एठो एणेन नेम ज्योस हे।<verse eid="LEV 13:59" /></para>
  <chapter eid="LEV 13" />
  <chapter number="14" style="c" sid="LEV 14" />
  <para style="s">कोढ़ा केरीन चोखो ठेरावाय जाणो</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 14:1" />ओवतो यहोवा मुसाह केयो, <verse eid="LEV 14:1" /><verse number="2" style="v" sid="LEV 14:2" />कोढ़ीन चोखो ठेरावणेन नेम ज्‍यो हे, तो चाकऱ्या फाय पोचाड़ाय जाय; <verse eid="LEV 14:2" /><verse number="3" style="v" sid="LEV 14:3" />चाकऱ्याह ता माणहा फाय पाड़ावान बाहेर जाणे जुवे, चाकऱ्याह ज्‍य देखणेन कोसीत केरने जुवे काय तान कोढ़ान बेमारी हुदेर जायेल हे। <verse eid="LEV 14:3" /><verse number="4" style="v" sid="LEV 14:4" />ते चाकर्‍यो उकुम आपी काय हुदीरनारान केरता दुय चोखाला एने जीवताला चिड़ा, देवदारून लाकड़े, एने रातला रेंगान फाड़को एने जुफान रोप ले जाणे जुवे। <verse eid="LEV 14:4" /><verse number="5" style="v" sid="LEV 14:5" />एने चाकर्‍यो उकुम आपी काय एक चिड़ो वोयताला पाण्यान उपेर, माटड्यान ठामला माय बोली केराय जाय। <verse eid="LEV 14:5" /><verse number="6" style="v" sid="LEV 14:6" />तेवी तो जीवताला चिड़ाह देवदारून लाकड़े एने रातला रेंगान फाड़का एने जुफा न्या आखाह लेन एकठोस ता चिड़ान लुयीम जो वोयताला पाण्यान उपेर बोली किरेल हे बुड़ीव देय; <verse eid="LEV 14:6" /><verse number="7" style="v" sid="LEV 14:7" />एने कोढ़ केरीन चोखाला ठेराणारा पोर सात वार सेड़कीन ताह चोखो ठेरावे, तेवी ता जीवताला चिड़ाह चोवगानाम सोड़ देय। <verse eid="LEV 14:7" /><verse number="8" style="v" sid="LEV 14:8" />एने चोखो ठेराणार तान फाड़काह दोवे, एने आखा लेट्या काटाड़ीन पाण्या केरीन उंगले, तेवी तो चोखो ठेराय; तान बाद तो पाड़ावा माय जाय सेकी, पुण सात दिह वोर तान पाड़ावा रेन बाहेरूस रेय। <verse eid="LEV 14:8" /><verse number="9" style="v" sid="LEV 14:9" />सातवे दिह ताह तान आखा लेट्या काटाड़ लेणे जुवे, ताह तान लेट्या, दाढ़ी, डोलान आखा नेवणा काटाड़ लेणे जुवे, एने तान फाड़काह दोवे, एने पाण्या केरीन उंगले, तेवी तो माणुह चोखो ठेराय।<verse eid="LEV 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 14:10" />आठवे दिह तो दुय हाजा मेंड्रान पिला एने एक वोरह्यान हाजो मेंड्रान पिलो, एने एन बेट केरता तेल बेचकेल पाच किलो फिट, एने आदो किलो तेल लावे। <verse eid="LEV 14:10" /><verse number="11" style="v" sid="LEV 14:11" />एने चोखो ठेरावणार चाकऱ्यो ज्यु आख्यु वोस्तु बेल ता माणहाह मिलापवाला तोम्बुन बायणा पोर यहोवान सामने उबो केरी। <verse eid="LEV 14:11" /><verse number="12" style="v" sid="LEV 14:12" />तेवी चाकर्‍यो एक मेंड्रान पिलो लेन दोसबोलीन केरता ताह एने आदो किलो तेलाह आहने लावे, एने न्या दुयाह आलाड़नेन बेटीन केरता यहोवान सामने आलाड़े; <verse eid="LEV 14:12" /><verse number="13" style="v" sid="LEV 14:13" />एने चाकर्‍यो ता मेंड्रान पिलाह तीस जागे, जाहरी तो पापबोली एने होमबोली जेनवारान बोली केऱ्या केरी, मतलब चोखाला जागाम बोली किरे; काहाकाय जोहलो पापबोली चाकर्‍यान ईसो रेय तिहेच केरीन दोसबोली बी तास ने ईसो ठेराय; तो जुलूम हाजो हे। <verse eid="LEV 14:13" /><verse number="14" style="v" sid="LEV 14:14" />तेवी चाकर्‍यो दोसबोलीन लुयीम रेन थोड़ीक लेन चोखो ठेराण्‍या माणहान जीवड्या कानान सेवटा पोर, एने तान जीवड्या आथान एने जीवड्या पायान आंठा पोर लागाड़े। <verse eid="LEV 14:14" /><verse number="15" style="v" sid="LEV 14:15" />तेवी चाकर्‍यो तीन होव ग्राम ने आस पास तेलाम रेन थोड़ोक लेन तान डाखऱ्या आथान तेलसा पोर टाके, <verse eid="LEV 14:15" /><verse number="16" style="v" sid="LEV 14:16" />एने चाकर्‍यो तान जेवड्या आथान आंगलीह तान डाखऱ्या तेलसा पोर वाला तेलाम बुड़ावीन ता तेलाम रेन थोड़ोक तान आंगली केरीन यहोवान सामने सात वार सिड़के। <verse eid="LEV 14:16" /><verse number="17" style="v" sid="LEV 14:17" />एने जो तेल तान तेलसा पोर रेय जाय चाकर्‍यो ताम रेन थोड़ोक चोखो एण्या माणहान जीवड्या कानान नेचला सेडा पोर एने तान जीवड्या आथ एने जीवड्या पायान आंगठा पोर दोसबोलीन लुयीन उपेर लागाड़े; <verse eid="LEV 14:17" /><verse number="18" style="v" sid="LEV 14:18" />चाकर्‍यो तान तेलसाम वोचेल तेल चोखो एण्या माणहान मुंडी पोर लागाड़े, इह केरीन चाकर्‍यो ता माणहान पाप यहोवान सामने डापे।<verse eid="LEV 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 14:19" />तान बाद चाकर्‍यो पापबोली केरी एने माणहान पाप डापे, जा केरीन तो चोखो एय जाय, तान बाद चाकर्‍यो होमबोली जेनवारान बोली किरे, <verse eid="LEV 14:19" /><verse number="20" style="v" sid="LEV 14:20" />तेवी चाकर्‍यो होमबोली एने एन बेटीह वेदी पोर चेड़ावी, इह केरीन चाकर्‍यो ता माणहान पाप बोली केरीन डापे एने तो माणुह चोखो एय जाय।<verse eid="LEV 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 14:21" />पुण केदी माणुह गेरीब हे एने ताह बुकोड़ आपणेन ताकेत नाय रेय, ताहार तो तान बोली केरावणेन केरता, एने तेल बेचकायेल पाच किलो मोयदो एन बेट एने आदो किलो तेल लावे; <verse eid="LEV 14:21" /><verse number="22" style="v" sid="LEV 14:22" />एने दुय ओला नाहते पेरवान दुय पिला लावे, जा ता लाव सेकती; एने न्‍याम रेन एक ते पापबोलीन केरता एने दिहरो होमबोलीन केरता रेय। <verse eid="LEV 14:22" /><verse number="23" style="v" sid="LEV 14:23" />एने आठवे दिह, तो माणुह त्यु चिजुह चाकऱ्या फाय मिलापवाला तोम्बुन बायणा पोर लावे, त्युह यहोवान सामने बोली चेड़ावाय जाय, जा केरीन माणुह चोखो एय जाय। <verse eid="LEV 14:23" /><verse number="24" style="v" sid="LEV 14:24" />तेवी चाकर्‍यो आदो किलो तेल एने दोसबोलीवाला मेंड्रान पिलाह लेन आलाड़नेन बेटीन केरता यहोवान सामने आलाड़े। <verse eid="LEV 14:24" /><verse number="25" style="v" sid="LEV 14:25" />ओवतो दोसबोलीन मेंड्रान पिलाह बोली केराय जाय; एने चाकर्‍यो तान लुयीम रेन थोड़ीक लेन चोखो ठेराण्‍या माणहान जीवड्या कानान सेवटा पोर, एने तान जीवड्या आथ एने जीवड्या पायान आंगठा पोर लागाड़े। <verse eid="LEV 14:25" /><verse number="26" style="v" sid="LEV 14:26" />ओवतो चाकर्‍यो तेलाम रेन थोड़ोक तान डाखऱ्या आथान तेलसा पोर रोचवीन, <verse eid="LEV 14:26" /><verse number="27" style="v" sid="LEV 14:27" />चाकर्‍यो तान जीवड्या आथान आंगली केरीन, तान डाखऱ्या तेलसा पोर वाला तेलाम रेन थोड़ोक यहोवान सामने सात वार सिड़क। <verse eid="LEV 14:27" /><verse number="28" style="v" sid="LEV 14:28" />ओवतो चाकर्‍यो तान तेलसा पोर वालो तेलाम रेन थोड़ोक चोखो ठेरावणारान जेवड्या कानान सेवटा पोर, एने तान जीवड्यो आथ एने जीवड्या पायान आंगठा पोर, दोसबोलीन लुयीन जागे लागाड़े; <verse eid="LEV 14:28" /><verse number="29" style="v" sid="LEV 14:29" />एने जो तेल चाकर्‍यान तेलसा पोर रेय जाय ताह चोखो ठेराण्‍या माणहान मुंडी पोर रोचवे, इह केरीन यहोवान सामने चाकर्‍यो ता माणहान पाप डापे। <verse eid="LEV 14:29" /><verse number="30" style="v" sid="LEV 14:30" />तेवी तो ओला नाहते पेरवान पिलाम रेन जो तो लाव सिक्‍यो एकाह बोली केरी, <verse eid="LEV 14:30" /><verse number="31" style="v" sid="LEV 14:31" />मतलब जो चिड़ो तो लाव सिक्‍यो, ताम रेन तो एकाह पापबोलीन केरता एने एन बेट बेल दिहराह होमबोलीन केरता चेड़ावे; इह केरीन चाकर्‍यो चोखो ठेरनारान केरता यहोवान सामने तान पाप डापे। <verse eid="LEV 14:31" /><verse number="32" style="v" sid="LEV 14:32" />जाह कोढ़ान बेमारी इयेल एय, एने तान ओलीक ताकेत निह एय काय तो चोखी केरनी चिजीह लाव सेकी, ते तानकेरता ज्‍योस नेम हे।<verse eid="LEV 14:32" /></para>
  <para style="s">गेराम लागेल कोढ़</para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 14:33" />ओवतो यहोवा मुसा एने हारूनाह ज्‍य केयो, <verse eid="LEV 14:33" /><verse number="34" style="v" sid="LEV 14:34" />जेवी तुमू कनान देसाम पोचहो, जाह मी तुमरी सोतान बुय बोणनेन केरता तुमूह आपथु, तुलबुखे केदी मी कोढ़ान बेमारी तुमरा आदिकारान एगदा गेराम देखाडु, <verse eid="LEV 14:34" /><verse number="35" style="v" sid="LEV 14:35" />ते ता गेरान मालीक चाकऱ्या फाय आवीन केणे जुवे काय, मी मारा गेराम कोढ़ान गेत एगदी बेमारी दिखेल हे। <verse eid="LEV 14:35" /><verse number="36" style="v" sid="LEV 14:36" />तेवी चाकर्‍यो उकुम आपी काय ता गेराम बेमारी देखणेन केरता माहु जाणेन पेल ताह खाली किरो, केदी ओहलो नाय एय काय जो काय गेराम रेय तो आखो एठो ठेराय; एने पासाण चाकर्‍यो गेर देखणेन माय जाय। <verse eid="LEV 14:36" /><verse number="37" style="v" sid="LEV 14:37" />तेवी चाकर्‍यो ती बेमारीह देखी; एने केदी ती बेमारी गेरान बितड़ा पोर निला निला नाहते रातलो खुदेल निसाणीन वेहाम एय, एने ता निसाणी बितड़ाम वोदार देखाथे, <verse eid="LEV 14:37" /><verse number="38" style="v" sid="LEV 14:38" />ताहार चाकऱ्याह गेराम रेन बाहेर निकेल आवणे जुवे एने सात दिह वोर गेर बोंद केर देणे जुवे। <verse eid="LEV 14:38" /><verse number="39" style="v" sid="LEV 14:39" />एने हातवे दिह चाकर्‍यो आवीन देखी; एने केदी ती बेमारी गेरान बितड़ा पोर पोसीर गियी एय, <verse eid="LEV 14:39" /><verse number="40" style="v" sid="LEV 14:40" />ताहार चाकर्‍यो उकुम आपी काय जा देगड़ाम बेमारी हे, ताह निकालीन गावान बाहेर एगदा एठा जागाम टाक देय; <verse eid="LEV 14:40" /><verse number="41" style="v" sid="LEV 14:41" />एने चाकर्‍यो गेरान मायतोस कावदेन उखलाड़े, एने तो उखालेल माटड्यो गावान बाहेर एगदा एठा जागाम टाकाय जाय; <verse eid="LEV 14:41" /><verse number="42" style="v" sid="LEV 14:42" />तेवी ता माणहाह नोवाला दिगोड़ केरीन बितड़ो बांदे एने चाकर्‍यो ताबालो गारो लेन बितड़ाह निपे।<verse eid="LEV 14:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LEV 14:43" />एय सेकी एगदो माणुह जुनाला दिगोड़ एने गाराह निकालीन नोवाला दिगोड़ एने गाराह लागाड़े, एने एय सेकी ती बेमारी ता गेराम पोशी देखाय। <verse eid="LEV 14:43" /><verse number="44" style="v" sid="LEV 14:44" />तेवी चाकर्‍यो आवीन ता गेरान जाच केरी, एने केदी ती बेमारी गेराम पोसरी गीयीय, ताहार तो जाण लेय काय ज्‍यो नुकसान केरनार कोढ़ हे; तो गेर एठो हे। <verse eid="LEV 14:44" /><verse number="45" style="v" sid="LEV 14:45" />एने तो माणुह आखो गारा बेल दिगोड़, लाकड़े एने गेराह खोदाड़ीन ओदार देय; एने ती आखी चिजीह विसाड़ीन गावान बाहेर एगदा एठा जागाम टाकाड़ देय। <verse eid="LEV 14:45" /><verse number="46" style="v" sid="LEV 14:46" />एने जाह वोर तो गेर बोंद रेय ताह वोर केदी एगदो गेराम जाय, ताहार तो हांज पोर वोर एठो रेय; <verse eid="LEV 14:46" /><verse number="47" style="v" sid="LEV 14:47" />केदी एगदो माणुह ता गेराम खाणो खाते नाहते ताम हुवेह, ताहार तो माणुह तान फाड़काह दोवे।<verse eid="LEV 14:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LEV 14:48" />पुण गेराम नोवाला दिगोड़ एने गारो लागाड़नेन बाद चाकऱ्याह गेरान चोकसी केरने जुवे, केदी बेमारी गेराम नाह पोसरेल सोती, ताहार ज्‍य जाणीन काय ती बेमारी सेटी एय जायेल हे, ते गेराह चोखो ठेरावे। <verse eid="LEV 14:48" /><verse number="49" style="v" sid="LEV 14:49" />एने ता गेराह चोखालनेन केरता दुय चिड़ा, देवदारून लाकड़े, रातला रेंगान फाड़का एने जुफान रोप लावे, <verse eid="LEV 14:49" /><verse number="50" style="v" sid="LEV 14:50" />एने चाकर्‍यो एक चिड़ाह वोयताला पाण्यान उपेर माटड्यान ठामला माय बोली किरे, <verse eid="LEV 14:50" /><verse number="51" style="v" sid="LEV 14:51" />तेवी चाकर्‍यो देवदारून लाकोड़, रातला रेंगान फाड़का, जुफान रोप एने जीवताला चिड़ाह न्या आखाह लेन बोली किरेल चिड़ान लुयीम एने वोयताला पाण्याम बुड़ीव देय, एने चाकर्‍यो ती लुयीह ता गेरा पोर सात वार सिड़के। <verse eid="LEV 14:51" /><verse number="52" style="v" sid="LEV 14:52" />इह केरीन चाकर्‍यो चिड़ान लुय एने वोयतालो पाणी एने जीवताला चिड़ा एने देवदारून लाकोड़ एने जुफान रोप एने रातला रेंगान फाड़कान द्वारा गेराह चोखो किरे; <verse eid="LEV 14:52" /><verse number="53" style="v" sid="LEV 14:53" />तेवी चाकर्‍यो जीवताला चिड़ाह गावान बाहेर चोवगानाम सोड़ देय; इह केरीन चाकर्‍यो गेरान केरता पासतावो किरे, तेवी गेर चोखो ठेराय।<verse eid="LEV 14:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="LEV 14:54" />आखी बातीन कोढ़ान बेमारी, एने खुवड़ो, <verse eid="LEV 14:54" /><verse number="55" style="v" sid="LEV 14:55" />फाड़का एने गेरान कोढ़, <verse eid="LEV 14:55" /><verse number="56" style="v" sid="LEV 14:56" />एने हुज, फुड़ा एने चोमेकण्या दोवल्या दागान बाराम, <verse eid="LEV 14:56" /><verse number="57" style="v" sid="LEV 14:57" />चोखो एने एठो ठेरावणेन हिक आपणेन नेम ज्‍योस हे। आखी बातीन कोढ़ान नेम ज्‍योस हे।<verse eid="LEV 14:57" /></para>
  <chapter eid="LEV 14" />
  <chapter number="15" style="c" sid="LEV 15" />
  <para style="s">सेरीरान खाराब सफेदपाणी</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 15:1" />ओवतो यहोवा मुसा एने हारूनाह केयो, <verse eid="LEV 15:1" /><verse number="2" style="v" sid="LEV 15:2" />तु इस्राएल ने माणहाह के काय केदी एगदा एदम्यान सेरीर माय सफेदपाणी निकलेह, ताहार तो तान वोजेसे एठो ठेराय। <verse eid="LEV 15:2" /><verse number="3" style="v" sid="LEV 15:3" />केदी तो वोयते रेय, नाहते वोयणे बोंद बी एय, तीबी तान एठोपोणा बोणीन रेय। <verse eid="LEV 15:3" /><verse number="4" style="v" sid="LEV 15:4" />जान सेरीर माय रेन सफेदपाणी निकलेह, तो जा आथेरना पोर तो लोटी, ताहार तो आथरोण एठो ठेराय, एने जी चिजी पोर तो बोही ती चिज बी एठी ठेराय। <verse eid="LEV 15:4" /><verse number="5" style="v" sid="LEV 15:5" />एने जो कुण तान आथेरनाह आथले, तो तान फाड़काह दोवीन पाण्या केरीन उंगले, एने हांज पोर वोर एठो ठेराय रेय। <verse eid="LEV 15:5" /><verse number="6" style="v" sid="LEV 15:6" />केदी इखेह माणुह ती चिजी पोर बुहेह जा पोर सफेदपाणी वोयणार माणुह बुहेल एय, ताहार तो तान फाड़का दोवीन पाण्याम उंगले, एने हांज पोर वोर एठो ठेराय रेय। <verse eid="LEV 15:6" /><verse number="7" style="v" sid="LEV 15:7" />केदी इखेह माणुह सफेदपाणी वोयणारा माणहाह आथलेह, ताहार तो तान फाड़काह दोवीन पाण्याम उंगले एने हांज पोर वोर एठो ठेराय रेय। <verse eid="LEV 15:7" /><verse number="8" style="v" sid="LEV 15:8" />केदी सफेदपाणी वोयणार माणुह एगदा हाजाला माणहा पोर थुपेह, ताहार तो हाजालो माणुह तान फाड़का दोवीन पाण्या केरीन उंगले, एने हांज पोर वोर एठो रेय। <verse eid="LEV 15:8" /><verse number="9" style="v" sid="LEV 15:9" />एने सफेदपाणी वोयणार माणुह एगदी पारवास केरनार वोस्तु पोर बोही, ताहार तो एठो ठेराय। <verse eid="LEV 15:9" /><verse number="10" style="v" sid="LEV 15:10" />एने जो कुण एगदी चिजीह जी तान बुंदे रेनी एय आथले, तो हांज पोर वोर एठो रेय; एने जो कुण ओहली एगदी चिजीह विसे तो तान फाड़काह दोवीन पाण्या केरीन उंगले, एने हांज पोर वोर एठो रेय। <verse eid="LEV 15:10" /><verse number="11" style="v" sid="LEV 15:11" />एने सफेदपाणी वोयणार माणुह एगदाह बिगेर आथ दोयेल आथले, ताहार हाजालो माणुह तान फाड़काह दोवीन पाण्या केरीन उंगले, एने हांज पोर वोर एठो रेय। <verse eid="LEV 15:11" /><verse number="12" style="v" sid="LEV 15:12" />एने सफेदपाणी वोयणार माणुह माटड्यान एगदा ठामलाह आथले, ताहार तो ठामलो फोड़ान जाय, एने लाकड़ान आखी बातीन ठामला पाण्याम दोवे।<verse eid="LEV 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 15:13" />ओवतो जान सफेदपाणी वोयणेन बेमारी रेय, तो जेवी तान बेमारीह रेन हुदेर जाय, ते दिह रेन चोखो ठेराणेन सात दिह गेणे, एने दिह पुरा एणेन बाद तान फाड़काह दोवीन वोयताला पाण्या केरीन उंगले; तेवी तो चोखो ठेराय। <verse eid="LEV 15:13" /><verse number="14" style="v" sid="LEV 15:14" />एने आठवे दिह ता माणहाह दुय ओली नाहते पेरवीन दुय पिला लेन मिलापवाला तोम्बुन बायणा पोर यहोवान सामने जाएन, ताह चाकऱ्याह आपी। <verse eid="LEV 15:14" /><verse number="15" style="v" sid="LEV 15:15" />तेवी चाकर्‍यो ताम रेन एकाह पापबोली, एने दिहराह होमबोलीन केरता बेट चेड़ावे; एने चाकर्‍यो तानकेरता तान सफेदपाणीन वोजेसे यहोवान सामने पाप डापे।<verse eid="LEV 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 15:16" />केदी एगदा एदम्यान अमरपाणी निकील जाथे, ताहार तो तान पुरा सेरीराह पाण्याम दोवे, एने हांज पोर वोर एठो रेय। <verse eid="LEV 15:16" /><verse number="17" style="v" sid="LEV 15:17" />केदी अमरपाणी एगदा फाड़का नाहते चामड़ा पोर पोड़ी, ताहार तो पाण्या केरीन दोवे एने हांज पोर वोर एठो रेय। <verse eid="LEV 15:17" /><verse number="18" style="v" sid="LEV 15:18" />जेवी एगदो एदमी एगदी बायकु हिऱ्यो हुवी, ताहार ता दुयू पाण्याम उंगले, एने हांज पोर वोर एठा रेय।<verse eid="LEV 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 15:19" />ओवतो जेवी एगदी बायकुह फाड़को आवरेय, ताहार ती सात दिह वोर एठी रेय, एने जो कुण तीह आथले तो हांज पोर वोर एठो रेय। <verse eid="LEV 15:19" /><verse number="20" style="v" sid="LEV 15:20" />एने जाह वोर ती एठी रेय ताह वोर जी जी चिजी पोर ती लोटी, एने जी जी चिजी पोर ती बोही, त्यु आख्‍यु एठ्यु ठेराती। <verse eid="LEV 15:20" /><verse number="21" style="v" sid="LEV 15:21" />एने जो कुण फाड़को आयेल बायकुन आथरोणाह आथले, ताहार तो तान फाड़का दोवीन पाण्याम उंगले, एने हांज पोर वोर एठो रेय। <verse eid="LEV 15:21" /><verse number="22" style="v" sid="LEV 15:22" />एने जो कुण ती चिजीह आथलेह जी पोर ती बायकु बोठीय, ताहार ताह तान फाड़का दोवीन पाण्याम उंगले, एने हांज पोर वोर एठो रेय। <verse eid="LEV 15:22" /><verse number="23" style="v" sid="LEV 15:23" />एने केदी एखेह बायकु आथरोणाह आथलेह नाहते ती चिजीह आथलेह जी पोर ती बोठीय, ताहार ती हांज पोर वोर एठी रेय। <verse eid="LEV 15:23" /><verse number="24" style="v" sid="LEV 15:24" />एने केदी एखेह एदमी फाड़को आयेल बायकु हिऱ्यो हुवी, एने तीन फाड़को ताह लाग जाय, ताहार तो एदमी सात दिह वोर एठो रेय, एने जा जा आथरोणा पोर तो लोटी ता आखा एठा ठेराती।<verse eid="LEV 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 15:25" />केदी एगदी बायकुन तीन फाड़को आवणेन ठेरायेल टेमाह रेन वोदार दिह वोर लुय वोयते रेय, नाहते ता ठेरायेल टेमाह रेन वोदार टेम वोर फाड़कावाली रेय, ताहार जाह वोर ती ओहली देशाम रेय ताह वोर ती एठी रेय। <verse eid="LEV 15:25" /><verse number="26" style="v" sid="LEV 15:26" />तीन लुय वोयणेन टेम दाड़ीन दिह जा जा आथेरणा पोर ती बायकु लोटी तो आखो तीन फाड़कान आथरोणान गेत ठेरी; एने जी जी चिजी पोर ती बोही, ती चिज बी तीन फाड़कावाली रेणेन दिह्यान गेत एठी ठेराय। <verse eid="LEV 15:26" /><verse number="27" style="v" sid="LEV 15:27" />एने जो कुण त्यु चिजुह आथले तो एठो ठेराय, केरीन तो तान फाड़का दोवीन पाण्या केरीन उंगले, एने हांज पोर वोर एठो रेय। <verse eid="LEV 15:27" /><verse number="28" style="v" sid="LEV 15:28" />पुण जेवी ती बायकु तीन फाड़को आवणे से एठी एय जाय, ते दिह रेन ती सात दिह वोर गेणे, एने ता दिह्याह वितणेन बाद ती चोखी ठेराय। <verse eid="LEV 15:28" /><verse number="29" style="v" sid="LEV 15:29" />ओवती आठवे दिह ती दुय ओली नाहते पेरवीन दुय पिला लेन मिलापवाला तोम्बुन बायणा पोर चाकऱ्या फाय जाय। <verse eid="LEV 15:29" /><verse number="30" style="v" sid="LEV 15:30" />तेवी चाकर्‍यो एकाह पापबोली एने दिहराह होमबोलीन केरता चेड़ावे; एने चाकर्‍यो तीन केरता तीन फाड़कान एठोपोणान वोजेसे यहोवान सामने पाप डापे।<verse eid="LEV 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 15:31" />इह केरीन तुमू इस्राएल ने माणहाह तान एठोपोणाह रेन आलेग मेल्या किरो, केदी ओहलो नाय एय काय ता यहोवान जागाह जो तान विचीम हे, एठो केरीन तान एठापोणाम फोसीन मोर जाती।<verse eid="LEV 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 15:32" />जान सफेदपाणी निकेलनेन रोग एय एने जो एदमी अमरपाणी निकेलने से एठो एय; <verse eid="LEV 15:32" /><verse number="33" style="v" sid="LEV 15:33" />एने जी बायकु एठापोणान कारेण हाजी नाह सोती; एने काय एदमी काय बायकु, कुणीन बी सफेदपाणी निकेलनेन रोग एय, एने जो एदमी एठी बायकु हिऱ्यो हुवी, न्या आखान केरता ज्‍योस नेम हे।<verse eid="LEV 15:33" /></para>
  <chapter eid="LEV 15" />
  <chapter number="16" style="c" sid="LEV 16" />
  <para style="s">पाप डापणेन दिह</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 16:1" />जेवी हारूनान दुय सोरा यहोवान सामने आहने जाएन एठी बोली चेड़ाया एने मोर गीया, तान बाद यहोवा मुसा हिऱ्यो वातु किऱ्यो; <verse eid="LEV 16:1" /><verse number="2" style="v" sid="LEV 16:2" />एने यहोवा मुसाह केयो, तारा बाहख हारूनाह के काय वायदान पेटीन उपेर पाप डापणेवालो ढापण्यान ओंगाण, विचीवाला पोड़दा माय चोखाला जागाम ताल ताल नाय रिगे नाहते मोर जाहे; काहाकाय मी पाप डापणेन ढापण्यान उपेर वादलाम देखाह। <verse eid="LEV 16:2" /><verse number="3" style="v" sid="LEV 16:3" />जेवी हारून चोखाला जागाम रिगी तेवी इह केरीन रिगे, मतलब पापबोलीन केरता एक बुयेल एने होमबोलीन केरता एक मेंडाह लेन आवी। <verse eid="LEV 16:3" /><verse number="4" style="v" sid="LEV 16:4" />हारून होणीन फाड़कान चोखालो चोगो, एने तान सेरीरा पोर होणीन खुसटो पेरीन, एने होणीन फाड़कान पुट्टो एने होणीन फाड़कान पागड़ी बी बांदिन रिगे; ज्या चोखाला फाड़का हेते एने तो पाण्या केरीन उंगलीन न्याह पेरी। <verse eid="LEV 16:4" /><verse number="5" style="v" sid="LEV 16:5" />एने हारूनाह इस्राएली मोंडली फाय रेन पापबोलीन केरता दुय बुकोड़ एने होमबोलीन केरता एक मेंडो लेय। <verse eid="LEV 16:5" /><verse number="6" style="v" sid="LEV 16:6" />एने हारून ता पापबोलीन बोयलाह जो तास ने केरता रेय चेड़ावीन तान एने तान गेराणान पाप डापे। <verse eid="LEV 16:6" /><verse number="7" style="v" sid="LEV 16:7" />एने ता दुयु बोकड़ाह लेन मिलापवाला तोम्बुन बायणा पोर यहोवान सामने उबराखाड़े। <verse eid="LEV 16:7" /><verse number="8" style="v" sid="LEV 16:8" />एने हारून दुयू बोकड़ा पोर चिट्ठ्यु टाके, एक चिट्‍ठी यहोवान केरता एने दिहरी जेंगलाम सोड़नेन <note caller="+" style="f"><char style="fr" closed="false">16:8 </char><char style="fq" closed="false">जेंगलाम सोड़नेन </char><char style="ft" closed="false">मुल माय अजाजेल</char></note> केरता रेय। <verse eid="LEV 16:8" /><verse number="9" style="v" sid="LEV 16:9" />एने जा बोकड़ा पोर यहोवान नावान चिट्ठी निकले, ताह हारून पापबोलीन केरता चेड़ावे; <verse eid="LEV 16:9" /><verse number="10" style="v" sid="LEV 16:10" />पुण जा बोकड़ा पोर सोड़नेन केरता चिट्ठी निकले, तो यहोवान सामने जीवतालो उबराखाड़ाय जाय काय ता केरीन पाप डापाय जाय, एने तो सोड़नेन केरता जेंगलाम सोड़ाय जाय।<verse eid="LEV 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 16:11" />हारून ती पापबोलीन बोयलाह जो तास ने केरता एय आहने लेन आवी, एने ताह बोली केरीन तान एने तान गेराणान केरता पाप डापे। <verse eid="LEV 16:11" /><verse number="12" style="v" sid="LEV 16:12" />एने जी वेदी यहोवान सामने हे, ता पोर वाला हेलेगताला कोल्‍या केरीन बुरेल आरतीन तेलीह लेन, एने हारून तान दुय मुठूह कुटेल हाजी गेंदाणी आरतीन तेलीह बोरीन, विचीवाला पोड़दान माय लियावीन; <verse eid="LEV 16:12" /><verse number="13" style="v" sid="LEV 16:13" />ता हाजी गेंदाणी वोस्तुह यहोवान सामने आक्‍ठाम टाके, जा केरीन दुणीन दुवाड़ो गोवाय पोत्रान उपेरवाला पाप ढापणेन ढापण्यान उपेर सावाय जाय, नाह ते तो मोर जाय; <verse eid="LEV 16:13" /><verse number="14" style="v" sid="LEV 16:14" />तेवी हारून बोयलान लुयीम रेन थोड़ीक लेन पुर्वान उगे पाप ढापणेन ढापणान उपेर तान आंगली केरीन सिड़के, एने ओवतो ती लुयीम रेन थोड़ीक आंगलीन द्वारा ता ढापणान सामने बी हात वार सेड़की देय। <verse eid="LEV 16:14" /><verse number="15" style="v" sid="LEV 16:15" />ओवतो हारून ता पापबोलीन बोकड़ाह जो सादा माणहान केरता रेय, बोली केरीन तान लुयीह विचीवाला पोड़दा माय लियावो, एने जिह केरीन बोयलान लुयी केरीन हारून किरेल इतो, तिहेच केरीन हारून बोकड़ान लुयी केरीन बी किरे, मतलब ताह पाप ढापणेन ढापणान उपेर एने तान सामने सिड़के। <verse eid="LEV 16:15" /><verse number="16" style="v" sid="LEV 16:16" />एने तो इस्राएल माणहान एठोपोणा एने गुना, एने तान आखा पापान वोजेसे चोखाला जागान केरता बोली किरे; एने मिलापवालो तोम्बु जो ता हेऱ्यो तान बात बातीन एठोपोणान विचीम रिथे, तान केरता बी हारून तिहेच किरे। <verse eid="LEV 16:16" /><verse number="17" style="v" sid="LEV 16:17" />जेवी हारून पाप डापणेन केरता चोखाला जागाम रिगे, तुलबूखे रेन जाह वोर तो तान एने तान गेराणो एने इस्राएल ने आखी मोंडलीन पाप डापेन बाहेर नाय निकले ताह वोर कुण बी माणुह मिलापवाला तोम्बुम नाय रेय। <verse eid="LEV 16:17" /><verse number="18" style="v" sid="LEV 16:18" />ओवतो हारून निकलीन ती वेदी हेऱ्यो जो यहोवान सामने हे जाय एने तान केरता पाप डापे, मतलब बोयलान लुय एने बोकड़ान लुय दुयूम रेन थोड़ीक लेन ती वेदीन चारू खुणान हिंगा पोर लागाड़े। <verse eid="LEV 16:18" /><verse number="19" style="v" sid="LEV 16:19" />एने ती लुयीम रेन थोड़ीक तान आंगलीन द्वारा तीह सात वार ता पोर सिड़के, इह केरीन हारून इस्राएल ने माणहान आखा पापा से एठापोणा से चोखो केरी।<verse eid="LEV 16:19" /></para>
  <para style="s">बोलीन बुकोड़</para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 16:20" />जेवी हारून चोखाले जागे एने मिलापवालो तोम्बु एने वेदीन केरता पाप डापणेन काम केर देय, तेवी जीवताला बोकड़ाह ओंगाण लियावो; <verse eid="LEV 16:20" /><verse number="21" style="v" sid="LEV 16:21" />एने हारून तान दुयू आथाह जीवताला बोकड़ान मुंडी पोर मेलीन इस्राएली माणहान खाराब काम, गुना एने तान आखा पापाह कबुल केरावी, इह केरीन हारून माणहान पापाह बोकड़ान मुंडी पोर टाकी, एने ताह एगदा माणहान आथे जो ज्या कामान केरता तियार एय, सुनसान जागाम मोकलीन सोड़ीव देय। <verse eid="LEV 16:21" /><verse number="22" style="v" sid="LEV 16:22" />तो बुकोड़ तान आखा खाराब कामाह तान उपेर विसीन एगदी उजाड़ी जागाम ली जाय; केरीन तो माणुह ता बोकड़ाह सुनसान जागाम सोड़ देय।<verse eid="LEV 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 16:23" />तेवी हारून मिलापवाला तोम्बुम जाय, एने जी होणीन फाड़काह पेरीन तो चोखाला जागाम रिगेल इतो, ताह काड़ीन ताहरीस मेल देय। <verse eid="LEV 16:23" /><verse number="24" style="v" sid="LEV 16:24" />ओवतो हारून तान पुरा सेरीराह चोखाला जागाम पाणी टाकीन दोवी, तेवी तो तान दिहरा फाड़काह पेरी, तो बाहेर आवी एने सोतान केरता एने माणहान केरता होमबोली चेड़ावीन सोताह एने माणहाह पापाह डापे। <verse eid="LEV 16:24" /><verse number="25" style="v" sid="LEV 16:25" />तेवी हारून वेदी पोर पापबोलीन चेरबीह हेलगाड़े। <verse eid="LEV 16:25" /><verse number="26" style="v" sid="LEV 16:26" />एने जा माणहे सोड़नेन बोकड़ाह सोड़ीन आवी, ता बी तान फाड़काह दोवे, एने पाण्या केरीन उंगले एने तेवी ता पाड़ावा माय रिगे। <verse eid="LEV 16:26" /><verse number="27" style="v" sid="LEV 16:27" />एने पापबोलीन बुयेल एने पापबोलीन बुकोड़ बी जान लुय चोखाला जागाम पाप डापणेन केरता पोचाड़ाय जाय, ता दुयू पाड़ावान बाहेर पोचाड़ाय जाय; तान चामड़ो एने माह एने साण आक्‍ठाम हेलगाड़ाय जाय। <verse eid="LEV 16:27" /><verse number="28" style="v" sid="LEV 16:28" />एने जा ताह हेलगाड़े ता आपणा फाड़काह दोवे, एने पाण्या केरीन उंगले, एने तान बाद ता पाड़ावा माय रिगे।<verse eid="LEV 16:28" /></para>
  <para style="s">पाप डापणेन दिह मान्नो</para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 16:29" />“तुमरी केरता ज्‍यो नेम कायेम ने केरता रेय काय सातवा मोयनान दोहवे दिहे तुमू उपास किरज्‍यो, तुमूह कायच काम नाय केरने जुवे; ते दिह तुमरी हिऱ्यो इखेह तुमरा गावान रेय नाहते पारायो रेय, कुण बी काल्लीस बातीन काम नाय किरे; <verse eid="LEV 16:29" /><verse number="30" style="v" sid="LEV 16:30" />काहाकाय ते दिह तुमूह चोखो केरनेन केरता तुमरा पाप डापाय जाय; एने तुमू तुमरा आखा पापाह रेन यहोवान सामने चोखा ठेराहो। <verse eid="LEV 16:30" /><verse number="31" style="v" sid="LEV 16:31" />ज्‍यो दिह तुमरी केरता विहेवणेन खास दिह हे, तुमूह ते दिह उपास केरने जुवे, ज्‍यो नेम कायेम ने केरता रेय। <verse eid="LEV 16:31" /><verse number="32" style="v" sid="LEV 16:32" />एने जान तान आबाख ने जागा पोर चाकर्‍यान पोद ने केरता अबिषेक एने चोखो केराय जाय, तो चाकर्‍यो पापाह डापे, तो होणीन चोखाला फाड़काह पेरीन, <verse eid="LEV 16:32" /><verse number="33" style="v" sid="LEV 16:33" />चोखालो जागो एने मिलापवालो तोम्बु, एने वेदीन केरता पाप डापे; एने चाकर्‍यान एने मोंडलीन आखा माणहान केरता बी पाप डापे। <verse eid="LEV 16:33" /><verse number="34" style="v" sid="LEV 16:34" />एने ज्‍यो तुमरी केरता कायेम ने केरता नेम रेय काय इस्राएल ने माणहान केरता देर वोरीह एक वार तुमरा आखा पाप डापे।”</para>
  <para style="p" vid="LEV 16:34">यहोवान ज्या उकुमान गेत जो तो मुसाह आपेल इतो हारून किऱ्यो।<verse eid="LEV 16:34" /></para>
  <chapter eid="LEV 16" />
  <chapter number="17" style="c" sid="LEV 17" />
  <para style="s">लुयीन चोखोपोणा</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 17:1" />ओवतो यहोवा मुसाह केयो, <verse eid="LEV 17:1" /><verse number="2" style="v" sid="LEV 17:2" />“हारून एने तान सोराह एने इस्राएल ने आखा माणहाह के काय यहोवा ज्‍यो उकुम आपेल हे; <verse eid="LEV 17:2" /><verse number="3" style="v" sid="LEV 17:3" />एगदो इस्राएली माणुह जो गाय ने एने मेंड्रान एने बोकड़ीन पिलाह पाड़ावा माय नाहते पाड़ावान बाहेर मार सिकेह। <verse eid="LEV 17:3" /><verse number="4" style="v" sid="LEV 17:4" />मिलापवाला तोम्बुन बायणा पोर यहोवान पाड़ावान सामने यहोवाह चेड़ावणेन केरता नाय ली जाय, ताहार ता माणहाह लुय वोयाड़नेन दोस लागी; एने तो माणुह जो लुय वोयाड़नार ठेराय, तो तान माणहान विचीम रेन खेतेम केराय जाय। <verse eid="LEV 17:4" /><verse number="5" style="v" sid="LEV 17:5" />ज्‍यो नेम ज्यानकेरता हे काय इस्राएली माणहे तान बोली जाह ता उदाह चोवगानाम मारतेह, ता ताह मिलापवाला तोम्बुन बायणा पोर चाकऱ्या फाय यहोवान केरता ली जाएन, तास ने केरता मेल मिलाप बोली केरीन बोली केऱ्या किरे; <verse eid="LEV 17:5" /><verse number="6" style="v" sid="LEV 17:6" />एने चाकर्‍यो लुयीह मिलापवाला तोम्बुन बायणा पोर यहोवान वेदीन उपेर सिड़के, एने चेरबीह तान हाजी गेंदीन केरता हेलगाड़े। <verse eid="LEV 17:6" /><verse number="7" style="v" sid="LEV 17:7" />ता जा बोकड़ाह पुजणारे बोणीन सिनालो केरतेह, ता पोशा तान जेनवाराह तानकेरता बोली नाय किरे। तुमरी पिढीन केरता ज्‍यो कायेम ने नेम रेय।”<verse eid="LEV 17:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 17:8" />तु ताह के काय इस्राएल ने गेराणान माणहाम रेन नाहते तान विचीम रेणारे पाराया माय रेन एगदो माणुह काहा नाय रेय जो होमबोली नाहते मेल मिलाप बोली चेड़ावे, <verse eid="LEV 17:8" /><verse number="9" style="v" sid="LEV 17:9" />एने ताह मिलापवाला तोम्बुन बायणा पोर यहोवान केरता चेड़ावणेन केरता नाय लावे; तो माणुह तान माणहा माय रेन खेतेम केराय जाय।<verse eid="LEV 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 17:10" />ओवतो इस्राएल ने गेराणान माणहा माय रेन नाहते तान विचीम रेणारे पाराया माय रेन इखेह माणुह काहा नाय रेय, जो लुय खाय, मी ता लुय खाणारान विरूद एन ताह तान माणहान विचीम रेन खेतेम केर देह। <verse eid="LEV 17:10" /><verse number="11" style="v" sid="LEV 17:11" />काहाकाय सेरीरान जीव लुयीम रिथे; एने तीह मी तुमूह वेदी पोर चेड़ावणेन केरता आपेल हे काय तुमरा जीवान केरता पाप डापाय जाय; काहाकाय जीवान बोदले लुयी केरीस ने पाप डापातेह। <verse eid="LEV 17:11" /><verse number="12" style="v" sid="LEV 17:12" />तानकेरता मी इस्राएल ने माणहाह केथु काय तुमरे माय रेन कुण लुय नाय खाय, एने जो दिहरा देसावालो तुमरे विचीम रिथे, तो बी लुय केदी नाय खाय।<verse eid="LEV 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 17:13" />इस्राएल ने माणहा माय रेन नाहते तान विचीम रेणारा पाराया माय रेन, केदी एगदो माणुह एगदा जेंगली जेनवाराह नाहते चिड़ाह दिरेह, जाह खाय सेकतेह, ताहार ता माणहाह लुय बुई पोर वोयाड़ीन एने माटड्या केरीन तीह डाप देय। <verse eid="LEV 17:13" /><verse number="14" style="v" sid="LEV 17:14" />काहाकाय सेरीरान जीव जो हे ती तान लुयूस हे, जी तान जीवा हेऱ्यी एक हे; केरीन मी इस्राएल ने माणहाह केथु काय काल्ली बी बातीन जेनवारान लुयीह तुमू मा खाहो, काहाकाय आखा जेनवारान जीव तान लुयूस हे; जो कुण तीह खाय, तो खेतेम केराय जाय। <verse eid="LEV 17:14" /><verse number="15" style="v" sid="LEV 17:15" />एने केदी तो इस्राएलवालो एय नाहते पारायो, जो कुण सोता मुरेल जेनवाराह नाहते एगदा दिहरा जेनवारान द्वारा मारायेल जेनवारान माह खाय, तो तान फाड़काह दोवीन पाण्या केरीन उंगले, एने हांज पोर वोर एठो रेय; तेवी तो चोखो रेय। <verse eid="LEV 17:15" /><verse number="16" style="v" sid="LEV 17:16" />पुण केदी तो माणुह तान फाड़काह नाह दोवेत एने नाह उंगलेत, ताहार तान पापान बार सोताह विसणे पोड़ी।<verse eid="LEV 17:16" /></para>
  <chapter eid="LEV 17" />
  <chapter number="18" style="c" sid="LEV 18" />
  <para style="s">सारिरीक समंद ने बाराम नेम</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 18:1" />ओवतो यहोवा मुसाह केयो, <verse eid="LEV 18:1" /><verse number="2" style="v" sid="LEV 18:2" />इस्राएल ने माणहाह के काय मी तुमरो बोगवान यहोवा हे। <verse eid="LEV 18:2" /><verse number="3" style="v" sid="LEV 18:3" />न्या आवणेन पेल तुमू मिस्र देसाम एता, तुमू तो मा किरहो; जो ता एतालो, मी तुमूह कनान देस ली जाथु; तुमूह तो नाह केरनु सोतो, जो ता देसाम ईथे! <verse eid="LEV 18:3" /><verse number="4" style="v" sid="LEV 18:4" />तुमू मारोस नेम मानज्‍यो, एने मारास नेमाह मानते लेन ता पोर चालज्‍यो। मी तुमरो बोगवान यहोवा हे। <verse eid="LEV 18:4" /><verse number="5" style="v" sid="LEV 18:5" />तानकेरता तुमू मारा नेमाह एने मारा निर्णयाह कायेम मानज्‍यो; जो माणुह तान पालेन किरेह, ताहार तो जीवतालो रेय! मी यहोवा हे।<verse eid="LEV 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 18:6" />तुमरे माय रेन एगदो तुमरा एगदा आहेंल्या गेरल्‍यान सेरीर उगाड़नेन ता फाय नाय जाय! मी यहोवा हे। <verse eid="LEV 18:6" /><verse number="7" style="v" sid="LEV 18:7" />तुमरी आईख ने सेरीर, जो तुमरा आबाख ने सेरीर हे, मा उगाड़हो; ती ते तुमरी आहख हे, केरीन तुमू तीन सेरीर मा उगाड़हो। <verse eid="LEV 18:7" /><verse number="8" style="v" sid="LEV 18:8" />तुमरी जिजीक ने बी सेरीर मा उगाड़हो; ती ते तुमरा आबाख ने सेरीर हे। <verse eid="LEV 18:8" /><verse number="9" style="v" sid="LEV 18:9" />तुमरी खास बोणीख एय नाहते जातहेगी एय, नाहते ती तुमरा गेराम पायदा ईयेल एय, केदी दिहरे जागे, तीन सेरीर मा उगाड़हो। <verse eid="LEV 18:9" /><verse number="10" style="v" sid="LEV 18:10" />तुमरी बोतेरजीख नाहते तुमरी नातणीख ने सेरीर मा उगाड़हो, त्युन सेरीर ते सोमजो तुमरोस हे। <verse eid="LEV 18:10" /><verse number="11" style="v" sid="LEV 18:11" />तुमरी बोणीख जी तुमरा आबाख केरीन पायदा इयेल हे, ती तुमरी बोणीख हे, केरीन तीन सेरीर मा उगाड़हो। <verse eid="LEV 18:11" /><verse number="12" style="v" sid="LEV 18:12" />तुमरी फुयीख ने सेरीर मा उगाड़हो; ती ते तुमरा आबाख ने बोणीख हे। <verse eid="LEV 18:12" /><verse number="13" style="v" sid="LEV 18:13" />तुमरी जिजीक ने सेरीर मा उगाड़हो; काहाकाय ती तुमरी आईख ने गेरल्यी हे। <verse eid="LEV 18:13" /><verse number="14" style="v" sid="LEV 18:14" />तुमरा आजालाख ने सेरीर मा उगाड़हो, मतलब तान बायकुन आहने मा जाहो; ती ते तुमरी आजालीख हे। <verse eid="LEV 18:14" /><verse number="15" style="v" sid="LEV 18:15" />तुमरी वोवड़ीख ने सेरीर मा उगाड़हो; ती ते तुमरा बेटाख ने बायकु हे, केरीन तुमू तीन सेरीर मा उगाड़हो। <verse eid="LEV 18:15" /><verse number="16" style="v" sid="LEV 18:16" />तुमरी बाबीख ने सेरीर मा उगाड़हो; ती ते तुमरा बायाख ने सेरीर हे। <verse eid="LEV 18:16" /><verse number="17" style="v" sid="LEV 18:17" />एगदी बायकु एने तीन बेटीख दुयून सेरीर मा उगाड़हो, एने तीन बोतेरजीख नाहते तीन नातणीख तारी बायकु केरीन त्युन सेरीर मा उगाड़हे, त्यु ते आहेंल्‍यु गेरल्‍यु हेत्यु; इह केरीन केरने मोटलो पाप हे। <verse eid="LEV 18:17" /><verse number="18" style="v" sid="LEV 18:18" />जाह वोर तुमरी बायकु जीवताली हे, तुमू तीन बोणीख दिहरी बायकु मा बाणावहो, काय पेल्‍ली जीवताली रेते लेन तीन सेरीर बी उगाड़े।<verse eid="LEV 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 18:19" />जाह वोर एगदी बायकु तीन फाड़को आवणेन वोजेसे एठी रेय, ताह वोर ती फाय तीन सेरीर उगाड़नेन मा जाहो। <verse eid="LEV 18:19" /><verse number="20" style="v" sid="LEV 18:20" />तुमू तुमरा बायबांडलान बायकु फाय जाएन एठा मा इहो। <verse eid="LEV 18:20" /><verse number="21" style="v" sid="LEV 18:21" />तुमू तुमरा एगदा सोराह आक्‍ठान द्वारा मोलेक देवान बोली केरीन मा चेड़ावहो, केदी तुमू इह केरीन केरतेह ताहार तुमू ज्‍योस देखाड़तेह काय तुमू तुमरा यहोवान नावाह आदार नाह केरते! मी यहोवा हे। <verse eid="LEV 18:21" /><verse number="22" style="v" sid="LEV 18:22" />तुमू एगदा एदम्या हेऱ्या तोहलोस सेरीर मा उगाड़हो, जीहे एगदी बायकु हेऱ्या केरतेह; ज्‍यो जुलूम खाराब काम हे। <verse eid="LEV 18:22" /><verse number="23" style="v" sid="LEV 18:23" />तुमू एगदा जेनवारा हेऱ्या खाराब काम केरीन एठा मा इहो, बायकु बी एगदा जेनवारा हेऱ्यी खाराब काम नाय किरे; ज्‍य ते बाणावटीन विरूद हे।<verse eid="LEV 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 18:24" />ओहलो काल्लो बी काम केरीन एठा मा एय जाहो, काहाकाय जा देसान माणहाह मी तुमरे ओंगाण रेन निकालन्‍यो हे, ता ओहला काम केरीन एठा एय जायेल हेते; <verse eid="LEV 18:24" /><verse number="25" style="v" sid="LEV 18:25" />एने तान देस बी एठो एय जायेल हे, केरीन मी ता पोर तान खाराब कामान देन्ड आपथु, एने तो देस ता माय रेणाराह बाहेर निकाल दिथे। <verse eid="LEV 18:25" /><verse number="26" style="v" sid="LEV 18:26" />तानकेरता तुमू मारा नेमाह एने निर्णयान पालेन किरज्‍यो, तुमूह ताम रेन काल्लो बी खाराब काम नाय केरने जुवे; ज्‍यो नेम इस्राएल ने माणहाह एने जा तुमरी विचीम पाराया रेतेह, तान केरता हे। <verse eid="LEV 18:26" /><verse number="27" style="v" sid="LEV 18:27" />जा माणहे तुमूह रेन पेल ता देसाम रेना, ता आखा माणहे जुलूम खाराब काम केऱ्या, जा केरीन तो देस एठो एय जायेल हे। <verse eid="LEV 18:27" /><verse number="28" style="v" sid="LEV 18:28" />केदी तुमू बी तोस काम किरहो, ताहार तुमू देरतीह खाराब किरहो; जी तुमूह तिहेस केरीन बाहेर उगाल देय, जीहे तुमूह रेन पेल रेणारा माणहाह उगाल दियेल। <verse eid="LEV 18:28" /><verse number="29" style="v" sid="LEV 18:29" />केदी इखेह माणुह ओहलो खाराब काम किरे, ताहार ता माणहाह तान माणहा माय रेन खेतेम केराय जाय।<verse eid="LEV 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 18:30" />ज्यो उकुम जो मी तुमूह मान्नेन आपेल हे, ताह तुमू मान्नु हे, एने जा खाराब काम तुमूह रेन पेल इयेल हेते, ता पोर मा चालहो, एने ताह केरीन एठा मा इहो। मी तुमरो बोगवान यहोवा हे।<verse eid="LEV 18:30" /></para>
  <chapter eid="LEV 18" />
  <chapter number="19" style="c" sid="LEV 19" />
  <para style="s">चोखोपोणा एने सोबावान नेम</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 19:1" />ओवतो यहोवा मुसाह केयो, <verse eid="LEV 19:1" /><verse number="2" style="v" sid="LEV 19:2" />इस्राएल ने आखी मोंडलीह के काय तुमू चोखाला बोणीन रिवो; काहाकाय मी तुमरो बोगवान यहोवा चोखालो हे। <verse eid="LEV 19:2" /><verse number="3" style="v" sid="LEV 19:3" />तुमरे माय एक एक माणुह तुमरा आईख आबाख ने आदार किरे, एने मारो विहेवणेन दिह्याह मानज्‍यो, मी तुमरो बोगवान यहोवा हे। <verse eid="LEV 19:3" /><verse number="4" style="v" sid="LEV 19:4" />तुमू मुरतीन बोक्ती मा किरहो, एने देवतान मुरती मा बाणावहो; मी तुमरो बोगवान यहोवा हे।<verse eid="LEV 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 19:5" />
    <note caller="+" style="x">
      <char style="xo" closed="false">19:5 </char>
      <char style="xt" closed="false">
        <ref loc="LEV 26:1">लेव्यवस्था 26:1</ref>; <ref loc="EXO 20:23">निर्गमन 20:23</ref>; <ref loc="EXO 34:17">34:17</ref>; <ref loc="DEU 17:1-5">व्यवस्था 17:1-5</ref></char>
    </note>जेवी तुमू यहोवान केरता मेल मिलाप बोली चेड़ावहो, ताहार तुमू इह केरीन बोली चेड़ावज्यो काय जा केरीन मी तुमू हिऱ्यो खुस एय जाय। <verse eid="LEV 19:5" /><verse number="6" style="v" sid="LEV 19:6" />तुमू तान माह बोलीन दिह एने दिहरे दिह खाय सेकतेह, पुण तीसरे दिह वोर जो रेय जाय तो आक्‍ठाम हेलगाड़ाय जाय। <verse eid="LEV 19:6" /><verse number="7" style="v" sid="LEV 19:7" />केदी ताम रेन कायच बी तीसरे दिह खावाय जाय, ताहार ज्‍य एठो ठेराय, एने स्वीकार नाय केराय। <verse eid="LEV 19:7" /><verse number="8" style="v" sid="LEV 19:8" />केदी एगदो माणुह इह केरीन किरेह, ताहार तो खाराब काम केरनार ठेराय; काहाकाय तो यहोवान चोखाली चिजीन आदार नाह किऱ्यो, तो माणुह तान माणहाम रेन खेतेम केराय जाय।<verse eid="LEV 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 19:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">19:9 </char>
      <char style="xt" closed="false">
        <ref loc="LEV 27:15">लेव्यवस्था 27:15</ref>; <ref loc="DEU 24:19-22">व्यवस्था 24:19-22</ref></char>
    </note>जेवी तुमू काटणेन टेम तुमरी कामाय काटहो, ताहार तुमू आखी उगे रेन खेतान कावदेन वोर मा काटहो, एने केदी उंब्‍या बुय पोर पोड़ जातेह, ताहार तुमू ताह टुलो मा किरहो। <verse eid="LEV 19:9" /><verse number="10" style="v" sid="LEV 19:10" />एने तुमरा अंगुरान वाड़ीन आखा अंगुर मा तुड़हो, एने जा बुय पोर पोड़ जाती ताह मा विसहो, काहाकाय तुमूह ती चिज गेरीब एने पाराया माणहान केरता रेणे दिज्यो; मी तुमरो बोगवान यहोवा हे।<verse eid="LEV 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 19:11" />तुमू चोरी मा किरहो, एने एका दिहरा हेऱ्या कोपेट मा किरहो, एने जुठ मा बुलहो। <verse eid="LEV 19:11" /><verse number="12" style="v" sid="LEV 19:12" />तुमू मारा नावान जुठो सुगोण मा खाहो, बोगवानान नाव खाराब केरतेह; मी यहोवा हे।<verse eid="LEV 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 19:13" />तुमू तुमरा आहेंल्‍याह दुको मा दिहो, ताह मा लुटहो, एने मोंजऱ्यान मोंजरी तार फाय आखी रात वेगोस वोर नाय रेणे जुवे। <verse eid="LEV 19:13" /><verse number="14" style="v" sid="LEV 19:14" />तुमू एगदा बेयराह हाराप मा दिहो, एने एगदा आंदलाह पाड़नेन केरता तान ओंगाण एगदी चिज मा मेलहो; पुण तुमू तुमरा बोगवानान बिय मिलज्यो; मी यहोवा हे।<verse eid="LEV 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 19:15" />नियाव केरने बुखेत अन्याय मा किरहो, एने नाह ते गेरब्यान पक्ष लिजे एने नाह मोटला माणहान मुय देखीन विचार किरजे; एक दिहरान नियाव ईमानदारी से किरजे। <verse eid="LEV 19:15" /><verse number="16" style="v" sid="LEV 19:16" />तुमू दिहरा माणहान विरूद कावदेन चिहटा किरतेन मा फिरहो, एने एक दिहराह मारनेन केरता योजना मा बाणावहो, मी यहोवा हे।<verse eid="LEV 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 19:17" />तुमरा मोनाम एका दिहरान केरता राग मा मेलहो; केदी तुमरो आहेंल्‍यो काह बाकतो किरेह, ताहार ज्यान बाराम ताह सोमजाड़, नाह ते तान पापान बार तुवाह विसणे पोड़ी। <verse eid="LEV 19:17" /><verse number="18" style="v" sid="LEV 19:18" />बुदलो मा लिहो, एने नाह तुमरा आहेंल्या एने नाह गेरल्या हिऱ्यो दुसमोनाय किरज्‍यो, पुण एक दिहरा हेऱ्यो तुमरी गेतुच मोंग किरज्‍यो। मी यहोवा हे।<verse eid="LEV 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 19:19" />तुमू मारा नेमान पालेन किरज्‍यो, तुमरा पालन्या जेनवाराह दिहरा जातीन पालन्या जेनवारा हेऱ्या बेचकाणे मा दिहो; तुमरा खेताम दुय बातीन बियारो एकठास मा पेरहो; एने होण एने रोचकान बेचकीन बुणेल फाड़को मा पेरहो।<verse eid="LEV 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 19:20" />केदी एगदी बायकु पावेरनी एय, एने तीन हेगाय एगदा एदम्या हेऱ्यी इयेल हे, पुण ती पावेरनी नाहते वेचायेल हे एने नाह आजाद केरायेल हे, ती हिऱ्यो केदी इखेह खाराब काम केरी, ताहार ता दुयूह देन्ड ते जुड़ी, पुण ती बायकुन ताबाम नाह एणेन वोजेसे ता दुयू माराय नाय जाय। <verse eid="LEV 19:20" /><verse number="21" style="v" sid="LEV 19:21" />पुण ता माणहाह तान गुनान केरता मिलापवाला तोम्बुन बायणा पोर यहोवाह एक मेंडाह दोसबोलीन केरता लियावो। <verse eid="LEV 19:21" /><verse number="22" style="v" sid="LEV 19:22" />एने चाकर्‍यो ता माणहान किरेल पापान कारेण दोसबोलीन मेंडान द्वारा यहोवान सामने पाप डापे; तेवी तान किरेल पाप माफ केराय जाय।<verse eid="LEV 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 19:23" />ओवता जेवी तुमू कनान देसाम पोचहो, तुमू बात बातीन फोलावाला जाड़े लागाड़हो, ताहार तान फोल तुमरी केरता तीन वोरह्या वोर बिगेर खेतनान गेत ठेराय; केरीन ताम रेन कायच नाय खावाय जाय। <verse eid="LEV 19:23" /><verse number="24" style="v" sid="LEV 19:24" />एने चोवथा वोरह्याम ता जाड़ान आखा फोल यहोवान बोड़ाय ने बेटीन रूप माय चोखा ठेराय। <verse eid="LEV 19:24" /><verse number="25" style="v" sid="LEV 19:25" />तेवी पाचवा वोरह्याम तुमू तान फोल खाज्यो, ज्यानकेरता काय ताम रेन तुमूह वोदार फोल जुड़ी; मी तुमरो बोगवान यहोवा हे।<verse eid="LEV 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 19:26" />तुमू लुय लागेल माह मा खाहो। एने जादु मा किरहो, एने नाह हाजी बाकती मुरतीह मानज्‍यो। <verse eid="LEV 19:26" /><verse number="27" style="v" sid="LEV 19:27" />तुमूह तुमरी मुंडीन दिड़ेवाला लेट्याह काटणे नाय जुवे, एने तुमरी दाड़ी काटणे नाय जुवे। <verse eid="LEV 19:27" /><verse number="28" style="v" sid="LEV 19:28" />एगदा मुरेल माणहाह एर केरनेन केरता तुमू तुमरा सेरीराह मा काटहो, एने तुमरी उपेर एगदी निसाणी गुंदाड़हो मा; मी यहोवा हे।<verse eid="LEV 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 19:29" />तुमू तुमरी बेटह्युक वेश्‍या बाणावीन खाराब मा किरहो, ओहलो नाय एय काय देस वेश्‍यान वोजेसे खाराब काम से बोराय जाय। <verse eid="LEV 19:29" /><verse number="30" style="v" sid="LEV 19:30" />तुमू मारा विहेवणेन दिह्याह पालेन किरज्‍यो, तुमू मारा चोखाला जागान आदार किरज्‍यो; मी यहोवा हे।<verse eid="LEV 19:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 19:31" />बोड़वा एने बुत निकालनारा फाय राय लेणेन केरता मा जावो, एने ओहलाह होदीन तान वोजेसे एठा मा एय जाहो; मी तुमरो बोगवान यहोवा हे।<verse eid="LEV 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 19:32" />डावाला माणहान आदार किरो, जेवी ता गेराम आवी, ताहार उठ बोहज्यो; तुमरा बोगवानान आदार किरो, मी यहोवा हे।<verse eid="LEV 19:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 19:33" />केदी इखेह पारायो तुमरा देसाम तुमरी हिऱ्यो रेय, ताहार ताह तारास मा दिहो। <verse eid="LEV 19:33" /><verse number="34" style="v" sid="LEV 19:34" />जा पाराया तुमरी हेऱ्या रेती, ता तुमरी केरता देसावालान गेत रेती, एने ता हेऱ्या तुमरे गेतुस मोंग किरज्‍यो; काहाकाय तुमू बी मिस्र देसाम पाराया एता; मी तुमरो बोगवान यहोवा हे।<verse eid="LEV 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 19:35" />“तुमू नियाव, पाप, तोल एने परिणाम माय अन्याय मा किरहो। <verse eid="LEV 19:35" /><verse number="36" style="v" sid="LEV 19:36" />एने खेरायीन ताकड़ो, नियावान वोजेन, खेरलो माप एने खेरलो एपा<note caller="+" style="f"><char style="fr" closed="false">19:36 </char><char style="fq" closed="false">एपा </char><char style="ft" closed="false">मोजणेन ठामलो, दोह किलोन माप हे।</char></note> तुमरी फाय रेय। मी तुमरो बोगवान यहोवा हे जो तुमूह मिस्र देसाम रेन निकाल लायेल। <verse eid="LEV 19:36" /><verse number="37" style="v" sid="LEV 19:37" />तुमू मारा आखा नियाव ने नेमाह एने नियाव विदीह एर मीलो, एने तुमू तान पालेन किरज्‍यो। मी यहोवा हे।”<verse eid="LEV 19:37" /></para>
  <chapter eid="LEV 19" />
  <chapter number="20" style="c" sid="LEV 20" />
  <para style="s">उकुम तोड़नेन देन्ड</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 20:1" />ओवतो यहोवा मुसाह केयो, <verse eid="LEV 20:1" /><verse number="2" style="v" sid="LEV 20:2" />इस्राएल ने माणहाह के, “तुमरा देसावालो नाहते इस्राएल ने विचीम रेणारे पारायाम रेन, एखेह काहा नाय रेय जो तान एगदा सोराह मोलेक<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="fq" closed="false">मोलेक </char><char style="ft" closed="false">कनानी माणहान द्वारा पुजा केराणार देव।</char></note> देवताह बोली चेड़ावी, ताहार जोरेवरी माराय जाय; एने माणहे ताह देगड़ाठे। <verse eid="LEV 20:2" /><verse number="3" style="v" sid="LEV 20:3" />मी बी ता माणहान विरूद एन ताह तान माणहाम रेन ज्यान वोजेसे खेतेम केरूह काय तो तान सोराह मोलेक देवताह आपीन मारा चोखाला जागाह एठो केऱ्यो, एने मारा चोखाला नावान आदार नाह किरेत। <verse eid="LEV 20:3" /><verse number="4" style="v" sid="LEV 20:4" />एने केदी तान सोराह मोलेक देवताह बोली चेड़ावे, ताहार माणहे तान बाराम बाहानो बाणावी एने ताह मारे नाय, <verse eid="LEV 20:4" /><verse number="5" style="v" sid="LEV 20:5" />पुण, मी सोता ता माणहाह एने तान गेराणान विरूद एन ताह एने जोला बी तान पासाण जाएन मोलेक देवता हेऱ्या सिनालो केरती, ता आखाह बी तान माणहान विचीम रेन खेतेम केरूह।”<verse eid="LEV 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 20:6" />मी ता माणहान विरूद एह, जो एगदो बुड़वो एने बुत निकालनारा फाय सेलान केरता जाथे, एने तान पासाण एन सिनाल्या बोणी, केरीन मी ता माणहाह तान माणहान विचीम रेन खेतेम केर देह। <verse eid="LEV 20:6" /><verse number="7" style="v" sid="LEV 20:7" />केरीन तुमू सोताह चोखा किरो; एने चोखाला बोणीन रिवो; काहाकाय मी तुमरो बोगवान यहोवा हे। <verse eid="LEV 20:7" /><verse number="8" style="v" sid="LEV 20:8" />मारा उकुमान पालेन किरो एने ताह एर मीलो; काहाकाय मी तुमरो चोखालो केरनार यहोवा हे। <verse eid="LEV 20:8" /><verse number="9" style="v" sid="LEV 20:9" />केदी एगदो माणुह तान आईख आबाख हाराप आपी, ताहार तो माणुह माराय जाय; तो तान आईख आबाख हाराप आपेल हे, केरीन ताह देन्ड जुड़ी।<verse eid="LEV 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 20:10" />ओवतो केदी एखेह माणुह दिहरी बायकु हिऱ्यो सिनालो केरी, ताहार बायकु एने एदमी दुयू सिनालान गुनेगार हेते, केरीन बायकु एने एदम्या दुयूह खेरीस मार टाके। <verse eid="LEV 20:10" /><verse number="11" style="v" sid="LEV 20:11" />केदी इखेह तान आबाख ने बायकु हिऱ्यो हुवी, तो माणुह तान आबाख ने सेरीराह उगाड़णार ठेराय; केरीन ता दुयू माराय जाय, तान खुन तास ने मुंडा पोर पोड़ी। <verse eid="LEV 20:11" /><verse number="12" style="v" sid="LEV 20:12" />केदी इखेह माणुह तान वोवड्यीख हिऱ्यो हुवी, ताहार ता दुयू जोरेवरी माराय जाय; ता उलटा काम केरनारे ठेराती, तान खुन तास ने मुंडा पोर पोड़ी। <verse eid="LEV 20:12" /><verse number="13" style="v" sid="LEV 20:13" />केदी इखेह माणुह एगदा एदम्या हिऱ्यो तोहलोच खाराब काम किरेह, जोहलो काय बायकु हेऱ्यो, ताहार ता दुयू खाराब काम किरेल हेते; केरीन ता दुयू जोरेवरी ता माराय जाती, तान खुन तास ने मुंडा पोर पोड़ी। <verse eid="LEV 20:13" /><verse number="14" style="v" sid="LEV 20:14" />केदी इखेह तान बायकु एने तान हाहवोक दुयूह राखी, ताहार ज्‍यो मोटलो पाप हे; केरीन तो एदमी एने बायकु तीनुन तीनु आक्‍ठाम हेलगाड़ाय जाय, काहाकाय तुमरे विचीम मोटलो पाप नाय एय। <verse eid="LEV 20:14" /><verse number="15" style="v" sid="LEV 20:15" />ओवतो केदी इखेह एदमी जेनवारा हिऱ्यो खाराब काम केरी, ताहार एदमी एने जेनवेराह दुयू जोरेवरी माराय जाय। <verse eid="LEV 20:15" /><verse number="16" style="v" sid="LEV 20:16" />केदी इखेह बायकु एगदा जेनवारा हेऱ्यी खाराब काम केरी, ताहार तुमू ती बायकु एने जेनवेराह मार टाकज्यो, ताह जोरेवरी मार दिज्यो, तान खुन तास ने मुंडा पोर पोड़ी।<verse eid="LEV 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 20:17" />केदी इखेह तान बोणीख केदी ती तान खास बोणीख एय, नाहते होवेत्री, तीन उगाड़लो सेरीर देखी, एने तान बोणीख बी तान उगाड़लो सेरीर देखी, ते ज्यी चिहटान वात हे, ता दुयू तान गेरल्‍यान डोलान सामने खेतेम केराय जाय; काहाकाय जो तान बोणीख ने सेरीराह उगाड़णार ठेराय, ताह तान गुनान बार सोता विसणे पोड़ी। <verse eid="LEV 20:17" /><verse number="18" style="v" sid="LEV 20:18" />केदी इखेह एदमी फाड़का वाली बायकु हिऱ्यो हुवेह एने तीन सेरीर उगाड़ेह, ते तो एदमी तीन फाड़को उगाड़नार ठेराय, एने ती बायकु बी तीन फाड़को उगाड़नार ठेराय, केरीन ता दुयू तान माणहान विचीम रेन खेतेम केराय जाय। <verse eid="LEV 20:18" /><verse number="19" style="v" sid="LEV 20:19" />तारी जिजीक नाहते फुयीख ने सेरीर मा उगाड़हे, काहाकाय जो त्युह उगाड़े ताहार ता दुयूह तान गुनान बार सोता विसणे पोड़ी। <verse eid="LEV 20:19" /><verse number="20" style="v" sid="LEV 20:20" />केदी एखेह तान आजालीख हिऱ्यो हुवी, ताहार तो तान आजालाख ने सेरीर उगाड़णार ठेराय; केरीन दुयूह तान पापान केरता देन्ड जुड़ी, एने ता बिगेर सोरान मोरती। <verse eid="LEV 20:20" /><verse number="21" style="v" sid="LEV 20:21" />केदी इखेह तान बायाख ने बायकु तान, बायकु बाणावी, ताहार ज्याह खाराब काम सोमेजज्‍यो; तो माणुह तान बायाख ने विरूद पाप किरेल हे, तान काल्ला सोरा नाय एती।<verse eid="LEV 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 20:22" />तुमू मारा आखा नेम एने निर्णयाह सोमजीन मानज्‍यो; केदी ओहलो नाय एय काय, जा देसाम मी तुमूह ली जाणे बाजरिनोह तो तुमूह निकाल देय। <verse eid="LEV 20:22" /><verse number="23" style="v" sid="LEV 20:23" />एने जा देसान माणहाह मी तुमरे ओंगाण रेन निकालथो, तान रिती पोर मा चालहो; काहाकाय ता माणहे ज्या आखा खाराब काम किरेल हेते, केरीन मी ता पापाह रेन सीट केरथु। <verse eid="LEV 20:23" /><verse number="24" style="v" sid="LEV 20:24" />पुण मी तुमूह केथु काय तुमू ते तान बुयीन आदिकारी रिहो, एने मी ज्या देसाह जा माय दुद एने मोवालान दार वुयेह तुमरा आदिकार माय केर देह; मी तुमरो बोगवान यहोवा हे जो तुमूह दिहरा देसान माणहाह रेन आलेग किरेल हे। <verse eid="LEV 20:24" /><verse number="25" style="v" sid="LEV 20:25" />तानकेरता तुमू हाजाला एने बाकताला जेनवारा माय, एने हाजाला एने बाकताला चिड़ा माय आलेग वेवार किरज्‍यो; एने एगदो जेनवार नाहते चिड़ो नाहते एगदो बुई पोर लोलनार जीवजेन्तु काहा नाय रेय, जाह मी तुमरी केरता एठो ठेरायेल ताह मा खाहो, ताह खाएन सोताह एठा मा किरहो। <verse eid="LEV 20:25" /><verse number="26" style="v" sid="LEV 20:26" />तुमू मार केरता चोखाला बोणीन रिज्यो, काहाकाय मी यहोवा खुद चोखालो हे, एने मी तुमूह एने देसान माणहाह रेन ज्यानकेरता आलेग किरेल हे काय तुमू कायेम मारास बोणीन रिवो।<verse eid="LEV 20:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 20:27" />“केदी एगदो एदमी एने एगदी बायकु बोड़वाय नाहते बुत निकालनेन काम केरी, ताहार ता खेरीस माराय जाय; ओहलाह देगड़ाठीन मार टाके, तान खुन तास ने मुंडी पोर पोड़ी।”<verse eid="LEV 20:27" /></para>
  <chapter eid="LEV 20" />
  <chapter number="21" style="c" sid="LEV 21" />
  <para style="s">चाकर्‍यान चोखापोणा</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 21:1" />यहोवा मुसाह केयो, “ज्‍यु वातु हारूनान सोराह जा चाकऱ्या हेते के काय एगदा मुरेल माणहाह सापलीन चाकर्‍यो सोताह एठा नाय किरे; <verse eid="LEV 21:1" /><verse number="2" style="v" sid="LEV 21:2" />तुमरा माणहाम रेन कुण बी मोरी ताहार तो ता मोरनारान सेरीराह सापील सिकेह, मतलब तान आहख, आबोख, बिटुख नाहते बेटीख, नाहते बायाख ने केरता, <verse eid="LEV 21:2" /><verse number="3" style="v" sid="LEV 21:3" />नाहते तान सेल्ली बोणीख जीन वाराड़ इयेल नाह सोतो, जीन आहेंल्यो नातो हे, तान केरता ती सोताह एठो केर सिकेह। <verse eid="LEV 21:3" /><verse number="4" style="v" sid="LEV 21:4" />पुण चाकर्‍यो बोणनेन नाते तो तान माणहाम मुखी हे, केरीन तो सोताह ओहलो एठो नाय केरी काय एठो एय जाय।”<verse eid="LEV 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 21:5" />चाकर्‍यो दुखाह देखाड़नेन केरता तान मुंडान टाली नाय केरावी, एने दाड़ी नाय केरावी, एने नाह तान सेरीर चीरे। <verse eid="LEV 21:5" /><verse number="6" style="v" sid="LEV 21:6" />चाकर्‍यो तान बोगवानान केरता चोखो बोणी, न्याह बोगवानान नावान केरता आदार देखाड़ी, काहाकाय ता रोटा एने आक्‍ठान द्वारा बेट यहोवाह पोचाड़तेह, केरीन ता चोखाला बोणीन रेय। <verse eid="LEV 21:6" /><verse number="7" style="v" sid="LEV 21:7" />ओहली बायकु हिऱ्यो वाराड़ नाय किरे, जी एगदा हेऱ्यी खाराब काम किरेल हे, एने उंजु सेड़ी किरेल बायकु हिऱ्यो वाराड़ नाय किरे, काहाकाय चाकऱ्यो तान बोगवानान केरता चोखालो रिथे। <verse eid="LEV 21:7" /><verse number="8" style="v" sid="LEV 21:8" />तानकेरता तु चाकऱ्याह चोखालो जाणज्‍ये, काहाकाय तो तुमरा बोगवानान खाणो चेड़ाया किरेह; केरीन तो तुमरी नेजरीम चोखो ठेराय; काहाकाय मी यहोवा, जो तुमूह चोखो केरथु, चोखालो हे। <verse eid="LEV 21:8" /><verse number="9" style="v" sid="LEV 21:9" />एने केदी चाकर्‍यान बेटीख वेश्‍या बोणीन सोताह एठी केरी, ताहार ती तीन आबाख एठी ठेरावेह; ती आक्‍ठाम हेलगाड़ाय जाय।<verse eid="LEV 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 21:10" />“जो तान बायह्याख माय मुखी चाकर्‍यो एय, जान मुंडी पोर अबिषेक ने तेल रोचवायेल एय, एने जान चोखाला फाड़काह पेरनेन केरता निवोड़ इयेल एय, तो तान मुंडान लेट्या जेवड़ाणे नाय देय, एने नाह तान फाड़का फाड़े। <verse eid="LEV 21:10" /><verse number="11" style="v" sid="LEV 21:11" />तो चाकर्‍यो देड़ाह सापलीन सोताह एठो नाय बाणावे, तो एगदा देड़ा हेऱ्यो नाय जाय, केदी तान आहख आबोख काहा नाय रेती; <verse eid="LEV 21:11" /><verse number="12" style="v" sid="LEV 21:12" />तो बोगवानान चोखाला जागान बाहेर नाय जाय, एने नाह बोगवानान चोखाला जागाह एठो ठेरावी, काहाकाय तो तान बोगवानान अबिषेक ने तेलान मुकूट पेर रिनोह, मी यहोवा हे। <verse eid="LEV 21:12" /><verse number="13" style="v" sid="LEV 21:13" />एने तो चाकर्‍यो कुवारली बायकु हिर्‍योस वाराड़ केरी। <verse eid="LEV 21:13" /><verse number="14" style="v" sid="LEV 21:14" />तो चाकर्‍यो ओहली बायकु हिऱ्यो वाराड़ नाय केरी, जी एगदा एदम्या हेऱ्यी खाराब काम किरेल हे, एने एगदी वेश्‍या नाहते सेड़ी किरेल बायकु, नाहते रांडायेल बायकु हिऱ्यो वाराड़ नाय केरी; चाकर्‍यो तास ने माणहान विचीम रेन एगदी कुवारली सोरी हिऱ्यो वाराड़ केरी। <verse eid="LEV 21:14" /><verse number="15" style="v" sid="LEV 21:15" />तो तान सोराह तान माणहाम एठो नाय केरी; काहाकाय मी ताह चोखो केरनार यहोवा हे।”<verse eid="LEV 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 21:16" />ओवतो यहोवा मुसाह केयो, <verse eid="LEV 21:16" /><verse number="17" style="v" sid="LEV 21:17" />“हारूनाह के काय, केदी तुमरी वोचीन सोरा माय रेन एगदान काल्लो बी दोस एय तो तान बोगवानान रूटो चेड़ावणेन केरता आहने नाय आवी। <verse eid="LEV 21:17" /><verse number="18" style="v" sid="LEV 21:18" />एगदो माणुह, जान एखेह दोस एय, तो आहने नाय आवी, केदी तो आंदलो, लेंगड़ो, नाकचोपट्यो एय, केदी तान थोड़ाक वोदार सेरीरान ईसा रेती, <verse eid="LEV 21:18" /><verse number="19" style="v" sid="LEV 21:19" />नाहते तान पाय, नाहते आथ टुटेल एय, <verse eid="LEV 21:19" /><verse number="20" style="v" sid="LEV 21:20" />नाहते डोंगायेल माणुह, नाहते बुटक्यो, नाहते तान डोलाम दोस एय, नाहते वियोल एने कोढ़ बेमारीवालो माणुह, नाहते वांठो माणुह एय; <verse eid="LEV 21:20" /><verse number="21" style="v" sid="LEV 21:21" />केदी हारून चाकऱ्यान वोचीम रेन इखेह काह दोसावालो एय, ताहार तो यहोवाह होमबोली नाय चेड़ावे, एने तो माणुह बोगवानाह खाणो बेट चेड़ावणेन केरता आहने नाय आवी। <verse eid="LEV 21:21" /><verse number="22" style="v" sid="LEV 21:22" />तो माणुह यहोवान चोखालो एने जुलूम चोखालो दुयू बातीन खाणाह खाय सिकेह, <verse eid="LEV 21:22" /><verse number="23" style="v" sid="LEV 21:23" />पुण तान दोसान वोजेसे तो नाहते विचीवाला पोरदान मायतो आवी, एने नाह वेदीन आहने, जाकेरीन ओहलो नाय एय काय तो मारा चोखाला जागाह एठो केरी; काहाकाय मी तान चोखो केरनार यहोवा हे।” <verse eid="LEV 21:23" /><verse number="24" style="v" sid="LEV 21:24" />तानकेरता मुसो ज्‍यु वातु हारून एने तान सोराह एने इस्राएल ने आखा माणहाह केयो।<verse eid="LEV 21:24" /></para>
  <chapter eid="LEV 21" />
  <chapter number="22" style="c" sid="LEV 22" />
  <para style="s">बेट चेड़ावणेन चोखापोणा</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 22:1" />यहोवा मुसाह केयो, <verse eid="LEV 22:1" /><verse number="2" style="v" sid="LEV 22:2" />हारून एने तान सोराह के, “इस्राएल ने माणहान चोखाली केरायेल वोस्तु से ज्यीह ता मार केरता चोखी केरतेह आलेग मेली, एने मारा चोखाला नावाह एठो मा किरहो, मी यहोवा हे। <verse eid="LEV 22:2" /><verse number="3" style="v" sid="LEV 22:3" />एने ताह के काय तुमरी पिढ़ी माय रेन आख्यु वोस माय रेन इखेह तान एठापोणान देशा माय त्यु चोख्यु किरेल वोस्तुह आथले, ज्युह यहोवान केरता चोखी केरतेह, तो माणुह मार सामने रेन खेतेम केराय जाय; मी यहोवा हे।”<verse eid="LEV 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 22:4" />हारूनान वोचीम रेन काहा नाय एय जो कोढ़ी एय, नाहते तान सफेदपाणी वोयणार एय, तो माणुह जाह वोर चोखो नाय एय जाय, ताह वोर चोखी किरेल चिजीम रेन काय नाय खाय। एने जो देड़ान वोजेसे एठो इयेल एय, नाहते जान अमरपाणी पुड़ेल एय, ओहला माणहाह जो कुण आथले, <verse eid="LEV 22:4" /><verse number="5" style="v" sid="LEV 22:5" />एने जो कुण एगदा ओहला लोलनारे जेन्तुह आथले जा केरीन माणहे एठा एय जातेह, नाहते एगदा ओहला माणहाह आथले जा माय एगदी बातीन एठोपोणा एय, जी ताह बी लाग सिकेह, <verse eid="LEV 22:5" /><verse number="6" style="v" sid="LEV 22:6" />केदी इखेह माणुह त्यु चिजुह आथले ताहार तो हांज पोर वोर एठो रेय, एने जाह वोर पाण्या केरीन उंगले नाय ताह वोर चोखाली चिजीम रेन काय नाय खाय। <verse eid="LEV 22:6" /><verse number="7" style="v" sid="LEV 22:7" />तो दिह बुड़ने बुकेत चोखो ठेराय; एने तेवी तो चोखाली चिजीम रेन खाय सेकी, काहाकाय तान खाणो तोस हे। <verse eid="LEV 22:7" /><verse number="8" style="v" sid="LEV 22:8" />केदी चाकर्‍यो इखेह मुरेल जेनवाराह नाहते एगदा दिहरा जेनवारान द्वारा माराय जायेल हे, ताह खाएन तो सोताह एठो नाय केरी; मी यहोवा हे। <verse eid="LEV 22:8" /><verse number="9" style="v" sid="LEV 22:9" />केरीन चाकऱ्या माणहे मारा नेमान पालेन किरे, ओहलो नाय एय काय ता तीह एठी केरीन पापान बार विसे, एने न्‍युन वोजेसे मोरी बी जाय; मी त्युह चोखो केरनार यहोवा हे।<verse eid="LEV 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 22:10" />“दिहरा गेराणान माणुह एगदी चोखाली वोस्तुह नाय खाणे जुवे, केदी तो चाकऱ्या हेऱ्यो रेणार पारायो एय नाहते मोजुर एय, तीबी नाय खाय। <verse eid="LEV 22:10" /><verse number="11" style="v" sid="LEV 22:11" />केदी चाकर्‍यो एगदा माणहाह तान पोयशा आपीन वेचातो लेय, ताहार तो पावोर चोखाल्‍यु चिजीम रेन खाय सिकेह; एने जा पावोर चाकर्‍यान गेर पायदा इयेल हेते, ता बी तान चोखाला खाणाम रेन खाय सेकतेह। <verse eid="LEV 22:11" /><verse number="12" style="v" sid="LEV 22:12" />केदी चाकर्‍यान बेटीख एगदा पाराया गेराणा हेऱ्यी वाराड़ केरी जो चाकर्‍यो निह एय, ताहार ती बेट किरेल चोखाली चिजीम रेन काय नाय खाय। <verse eid="LEV 22:12" /><verse number="13" style="v" sid="LEV 22:13" />केदी चाकर्‍यान बेटीख रांडायेल नाहते गेराम रेन काड़ायेल एय, एने तीन सोरा निह एती, एने ती सोरान रितीन गेत तीन आबाख ने गेराम रेती एय, ताहार ती तीन आबाख ने खाणाम रेन खाय; पुण पाराया गेराणान कुण ताम रेन नाय खाय। <verse eid="LEV 22:13" /><verse number="14" style="v" sid="LEV 22:14" />एने केदी इखेह माणुह एगदी चोखाली चिजीम रेन काह बुल माय खाय लेय, ताहार तो माणुह चोखाल्‍यु चिज पाचवो ईसो वोड़ावीन चाकऱ्याह बोर देय। <verse eid="LEV 22:14" /><verse number="15" style="v" sid="LEV 22:15" />चाकर्‍यो इस्राएल ने माणहान चोखी किरेल चिजुह, ज्‍युह ता यहोवान केरता चेड़ावती, एठ्यु नाय केरी। <verse eid="LEV 22:15" /><verse number="16" style="v" sid="LEV 22:16" />ता ताह तान चोखाल्‍यु चिजीम रेन खावाड़ीन ताह गुनान दोस नाय विसाड़े; मी तान चोखो केरनार यहोवा हे।”<verse eid="LEV 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 22:17" />ओवतो यहोवा मुसाह केयो, <verse eid="LEV 22:17" /><verse number="18" style="v" sid="LEV 22:18" />“हारून एने तान सोराह, एने इस्राएल ने आखा माणहाह सोमजाड़ीन के काय इस्राएलवाला माणहे, नाहते इस्राएल माय रेणारे पाराया माणहाम रेन कुण बी काहा नाय रेय, जो मानता मानेल एय नाहते खुसीनबोली केरनेन केरता यहोवाह एगदी होमबोली चेड़ावे। <verse eid="LEV 22:18" /><verse number="19" style="v" sid="LEV 22:19" />ताह स्वीकार केरनेन केरता हाजो पालन्यो जेनवार एने मेंडो नाहते बुकोड़ चेड़ावणे जुवे। <verse eid="LEV 22:19" /><verse number="20" style="v" sid="LEV 22:20" />जा जेनवारा माय दोस एय, ताह मा चेड़ावहो, काहाकाय बोगवान ताह स्वीकार नाय केरी। <verse eid="LEV 22:20" /><verse number="21" style="v" sid="LEV 22:21" />एगदो माणुह यहोवाह मेल मिलाप बोली चेड़ावी, ती मेल मिलाप बोली ता माणहान द्वारा आपेल मानता एय, नाहते ज्यी सोतान मोरजी से किरेल एय, जीह तो माणुह यहोवाह चेड़ावेह, तो पालन्यो जेनवार, मेंडो, नाहते बुकोड़ एय, पुण तो हाजालो एय, ता माय कायच दोस नाय रेय। <verse eid="LEV 22:21" /><verse number="22" style="v" sid="LEV 22:22" />तुमू यहोवाह ओहला एगदा जेनवारे नाय चेड़ावणे जुवे जा आंदला, मुड़ायेल, लेंगड़ो, फुड़ावालो, खुवड़ो एने दादवालो, तुमू यहोवान वेदीन आक्‍ठा पोर ता दुखाऱ्या जेनवेरान बेट मा चेड़ावहो। <verse eid="LEV 22:22" /><verse number="23" style="v" sid="LEV 22:23" />जा एगदा पालन्या जेनवार, मेंडान नाहते बोकड़ान एगदो पाय लांबो नाहते सोटो एय, ताह सोतान मोरजी केरीन चेड़ाव सेकतेह, पुण मानता पुरी केरनेन केरता तो स्वीकार नाय एय। <verse eid="LEV 22:23" /><verse number="24" style="v" sid="LEV 22:24" />केदी जेनवारान आंड जेखमी, कुटेल नाहते चिरायेल एय, ताहार तुमू ता जेनवेरान बेट यहोवाह मा चेड़ावहो। <verse eid="LEV 22:24" /><verse number="25" style="v" sid="LEV 22:25" />न्या माय रेन एगदाह तुमू आपणा यहोवान खाणो जाणीन एगदा पाराया देसावाला फाय ओहला जेनवाराह नाय लेणे जुवे, काहाकाय न्या जेनवाराम दोस हे, केरीन ता स्वीकार नाय एती।”<verse eid="LEV 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 22:26" />ओवतो यहोवा मुसाह केयो, <verse eid="LEV 22:26" /><verse number="27" style="v" sid="LEV 22:27" />“जेवी एगदो बुयेल नाहते मेंडो नाहते बोकड़ीन पिलो वियाय, ताहार तान आईख हेऱ्यो ताह हात दिह रेणे दिवो, ओवता आठवे दिह रेन तान बाद ज्या पिलाह यहोवाह आक्‍ठान द्वारा एण्यी बोलीन वेहाम स्वीकार केराय जाय। <verse eid="LEV 22:27" /><verse number="28" style="v" sid="LEV 22:28" />पुण तुमू तेदिहस पालन्यो जेनवार, मेंड्री नाहते बोकड़ी एय, तीह एने तीन पिलाह बोली मा किरहो। <verse eid="LEV 22:28" /><verse number="29" style="v" sid="LEV 22:29" />एने जेवी तुमू यहोवान केरता दन्यवाद ने मेल मिलाप बोली चेड़ावहो, ताहार तीह इह केरीन किरज्‍यो काय तीह बोगवान स्वीकार किरे। <verse eid="LEV 22:29" /><verse number="30" style="v" sid="LEV 22:30" />माह तेदिहस खावाय जाय, ताम रेन कायच बी वेगोस वोर रेणे नाय जुवे; मी यहोवा हे।”<verse eid="LEV 22:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 22:31" />“तानकेरता तुमू मारा उकुमाह मानज्‍यो एने तान पालेन किरज्‍यो; मी यहोवा हे। <verse eid="LEV 22:31" /><verse number="32" style="v" sid="LEV 22:32" />एने मारा चोखाला नावान आदार किरज्‍यो, काहाकाय मी इस्राएल ने माणहान केरता जोरेवरीस चोखो मानाय जाह; काहाकाय मी तुमरो चोखो केरनार यहोवा हे, <verse eid="LEV 22:32" /><verse number="33" style="v" sid="LEV 22:33" />जो तुमूह मिस्र देसाम रेन निकाल लावो, जान वोजेसे मी तुमरो बोगवान बोणनो; मी यहोवा हे।”<verse eid="LEV 22:33" /></para>
  <chapter eid="LEV 22" />
  <chapter number="23" style="c" sid="LEV 23" />
  <para style="s">तिवारान विद्यु</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 23:1" />ओवतो यहोवा मुसाह केयो,<verse eid="LEV 23:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="LEV 23:2" />“इस्राएल ने माणहाह के काय, यहोवान तिवार जान तुमूह चोखाली सोबा एकठी केरनेन केरता ठिक टेमा पोर पारचार केरने पोड़ी, मारा ता तिवार ज्या हेते। <verse eid="LEV 23:2" /><verse number="3" style="v" sid="LEV 23:3" />सोव दिह काम किरज्‍यो, पुण सातवो दिह, विहेवणेन खास दिह एने चोखाली सोबान दिह हे; तेदिह, तुमू काय काम मा किरहो; ज्‍यो तुमरे आखा गेराम यहोवान विहेवणेन दिह ठेराय।<verse eid="LEV 23:3" /></para>
  <para style="s">फसह एने अखमीरी रोटान तिवार</para>
  <para style="r">(<ref loc="NUM 28:16-25">गिनती 28:16-25</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 23:4" />“ओवता यहोवान तिवार जा माय रेन एक एकान ठेरायेल टेमाम तुमूह चोखाली सोबा केरनेन केरता पारचार केरने पोड़ी, ता ज्या हेते। <verse eid="LEV 23:4" /><verse number="5" style="v" sid="LEV 23:5" />यहोवान फसह तिवार पेल्ला मोयनान चोवदावे दिह हांज पोर एया किरे। <verse eid="LEV 23:5" /><verse number="6" style="v" sid="LEV 23:6" />एने तास मोयनान पोंदरावे दिह्या यहोवान केरता अखमीरी रोटान तिवार एया किरे; ता माय तुमू हात दिह वोर अखमीरी रूटो खाया किरज्‍यो। <verse eid="LEV 23:6" /><verse number="7" style="v" sid="LEV 23:7" />ज्या तिवारान पेल्ले दिह तुमू एक चोखाली सोबा किरज्‍यो, तेदिह तुमू काय काम मा किरहो। <verse eid="LEV 23:7" /><verse number="8" style="v" sid="LEV 23:8" />पुण सातु दिह तुमू यहोवाह होमबोली चेड़ाया किरज्‍यो; एने सातवे दिह एक चोखाली सोबा किरज्‍यो; तेदिह तुमू काय काम मा किरहो।”<verse eid="LEV 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 23:9" />ओवतो यहोवा मुसाह केयो, <verse eid="LEV 23:9" /><verse number="10" style="v" sid="LEV 23:10" />इस्राएल ने माणहाह के काय तुमू ता देसाम जाहो, जाह यहोवा तुमूह आपेह एने ता माय कामाय काटहो, तेवी तुमू तुमरी कामायीन पेल्लो पुलो चाकऱ्या फाय लाया किरज्‍यो; <verse eid="LEV 23:10" /><verse number="11" style="v" sid="LEV 23:11" />एने चाकर्‍यो ता पुलाह यहोवान सामने आलाड़ी काय तो तुमरी केरता स्वीकार केराय जाय; चाकर्‍यो पुलाह विहेवणेन दिह्यान दिहरे दिह आलाड़े। <verse eid="LEV 23:11" /><verse number="12" style="v" sid="LEV 23:12" />एने जे दिह तुमू पुलो आलाड़हो ते दिहस एक वोरह्यान हाजो मेंडान पिलो यहोवान केरता होमबोली चेड़ावज्यो। <verse eid="LEV 23:12" /><verse number="13" style="v" sid="LEV 23:13" />एने तुमू ता हेऱ्यो एन बेट तेल एने दोह किलो मोयदो बेचकीन बोगवानान केरता हाजी गेंदीन केरता आक्‍ठान बोलीन रूप माय चेड़ावाय जाय, एने ता हेऱ्यो पिणी बोलीन केरता आदली बोर अंगुरान रूह बी चेड़ावाय जाय। <verse eid="LEV 23:13" /><verse number="14" style="v" sid="LEV 23:14" />जाह वोर तुमू तुमरा बोगवानाह बेट नाह चेड़ावते, ताह वोर तुमू एगदो नोवालो दाणा, फोल नाहते नोवाला दाणान रोटा मा खाहो, ज्‍यो नेम तुमरी पिढीन पिढ़ी तुमरा आखा गेराणा माय कायेम चालते रेय।<verse eid="LEV 23:14" /></para>
  <para style="s">काटायीन तिवार</para>
  <para style="r">(<ref loc="NUM 28:26-31">गिनती 28:26-31</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 23:15" />ओवता ता विहेवणेन दिह्यान दिहरे दिह रेन, मतलब जे दिह तुमू आलाड़ाय जाणार बेटीन पुलाह लावहो, तेदिह रेन पुरा सात आरामान दिह गेण लिज्यो; <verse eid="LEV 23:15" /><verse number="16" style="v" sid="LEV 23:16" />सातवा एपतान दिहरे विहेवणे दिह वोर पाचाह दिह गेणज्‍यो, एने पाचाहवे दिहे यहोवान केरता नोवालो एन बेट चेड़ावज्यो। <verse eid="LEV 23:16" /><verse number="17" style="v" sid="LEV 23:17" />तुमू तुमरा गेराम रेन एपान दुय दोहवा ईसा मोयदान दुय रोटा आलाड़नेन बेटीन केरता लियावज्यो; तो खमीर हेऱ्यो रांदे, एने यहोवान केरता पेल्‍ली मेर ठेराय। <verse eid="LEV 23:17" /><verse number="18" style="v" sid="LEV 23:18" />एने ता रोटा हेर्‍य एक एक वोरह्यान सात हाजा मेंड्रान पिला, एने एक वासड़ो एने दुय मेंडा चेड़ावज्यो; ता हेऱ्या ता एन बेट एने पिणी बोली यहोवान केरता होमबोलीन गेत चेड़ावाय जाय, तो यहोवान केरता हाजो गेंदाणार बोली ठेराय। <verse eid="LEV 23:18" /><verse number="19" style="v" sid="LEV 23:19" />ओवता पापबोलीन केरता एक बुकोड़, एने मेल मिलाप बोलीन केरता एक एक वोरह्यान दुय मेंड्रान पिला चेड़ावज्यो। <verse eid="LEV 23:19" /><verse number="20" style="v" sid="LEV 23:20" />तेवी चाकर्‍यो पेल्‍ली कामायीन रोटा बेल यहोवान सामने आलाड़नेन बेटीन केरता आलाड़े, एने न्या रोटा हेऱ्यो ता दुय मेंड्रान पिला बी आलाड़ाय जाय; ता यहोवान केरता चोखाला, हेते, ता चाकर्‍यान ठेराती। <verse eid="LEV 23:20" /><verse number="21" style="v" sid="LEV 23:21" />एने तुमू ते दिहस ज्‍यो पारचार किरज्‍यो काय आज आमरी एक चोखाली सोबा एय; एने मेहनेत ने काय काम मा किरहो; ज्‍यो नेम तुमरा आखा गेराणाम तुमरी पिढीन पिढ़ी माय कायेम चाले।<verse eid="LEV 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 23:22" />“जेवी तुमू तुमरा खेतान कामाय काटहो ताहार खेतान कोपरावाली आखी कामाय मा काटहो एने खेताम पुड़ेल उंब्‍युह एकठा मा किरहो; ताह तुमू गेरीब माणहे एने तुमरा देसाम आवणारे पाराया माणहान केरता रेणे दिज्यो; मी तुमरो बोगवान यहोवा हे।”<verse eid="LEV 23:22" /></para>
  <para style="s">नोवाला वोरह्यान तिवार</para>
  <para style="r">(<ref loc="NUM 29:1-6">गिनती 29:1-6</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 23:23" />ओवतो यहोवा मुसाह केयो, <verse eid="LEV 23:23" /><verse number="24" style="v" sid="LEV 23:24" />“इस्राएल ने माणहाह के काय सातवा मोयनान पेल्ले दिह्याह तुमू विहेवणेन खास दिह मानज्‍यो; तुमू न्याह माणावणेन केरता बिरा फुकज्‍यो, एने एक चोखाली सोबा एकठी एय। <verse eid="LEV 23:24" /><verse number="25" style="v" sid="LEV 23:25" />तेदिह तुमू मेहनेत ने काय काम मा किरहो, तुमू यहोवाह होमबोली चेड़ावज्यो।”<verse eid="LEV 23:25" /></para>
  <para style="s">पाप डापणेन दिह</para>
  <para style="r">(<ref loc="NUM 29:7-11">गिनती 29:7-11</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 23:26" />ओवतो यहोवा मुसाह केयो, <verse eid="LEV 23:26" /><verse number="27" style="v" sid="LEV 23:27" />“तास सातवा मोयनान दोहवो दिह पाप डापणेन दिह मानाय जाय; तो तुमरी चोखाली सोबान दिह रेय, एने ता माय तुमू उपास देरीन सोताह दुख दिज्यो, एने तुमू यहोवान केरता होमबोली चेड़ावज्यो। <verse eid="LEV 23:27" /><verse number="28" style="v" sid="LEV 23:28" />तेदिह तुमू काल्ली बातीन काम मा किरहो; काहाकाय तो पाप डापणेन दिह निवड़ाय जायेल हे, जा माय तुमरे बोगवान यहोवान सामने तुमरी केरता पाप डापाय जाय। <verse eid="LEV 23:28" /><verse number="29" style="v" sid="LEV 23:29" />केदी इखेह माणुह ते दिह दुख नाय विठे, तो तान माणहाम रेन खेतेम केराय जाय। <verse eid="LEV 23:29" /><verse number="30" style="v" sid="LEV 23:30" />केदी इखेह माणुह तेदिह काम केरी, ताहार मी बोगवान तान माणहान विचीम रेन खेतेम केर देह। <verse eid="LEV 23:30" /><verse number="31" style="v" sid="LEV 23:31" />तुमू काल्लीस बातीन काम मा किरहो; ज्‍यो तुमरी पिढीन पिढ़ी माय तुमरा गेराणाम कायेम ने नेम ठेराय। <verse eid="LEV 23:31" /><verse number="32" style="v" sid="LEV 23:32" />तो दिह तुमरी केरता विहेवणेन खास दिह रेय, तेदिह तुमू उपास देरीन सोताह दुख दिज्यो, तुमू विहेवणेन ज्या खास दिह्याह मोयनान नोव्वे दिह्याह हांज पोर रेन ते दिहरे दिह हांज पोर वोर तुमरो विहेवणेन दिह मान्या किरज्‍यो।”<verse eid="LEV 23:32" /></para>
  <para style="s">खोपड्युन तिवार</para>
  <para style="r">(<ref loc="NUM 29:12-40">गिनती 29:12-40</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 23:33" />ओवतो यहोवा मुसाह केयो, <verse eid="LEV 23:33" /><verse number="34" style="v" sid="LEV 23:34" />“इस्राएल ने माणहाह के काय, सातवा मोयनान पोंदरावे दिह खोपड़ीन तिवार मानाय जाय, यहोवान केरता ज्‍यो चोखालो तिवार सात दिह वोर चाले। <verse eid="LEV 23:34" /><verse number="35" style="v" sid="LEV 23:35" />पेल्ले दिह चोखाली सोबा रेय, तेवी तुमू ताम मेहनेत ने काय काम मा किरहो। <verse eid="LEV 23:35" /><verse number="36" style="v" sid="LEV 23:36" />तुमू सात दिह वोर यहोवान केरता आक्‍ठान द्वारा बोली चेड़ावज्यो। ओवता आठवे दिह तुमरी चोखाली सोबा रेय, एने यहोवान केरता तुमू होमबोली चेड़ावज्यो; ज्‍यो एक मोटला पोंचान दिह हे, एने ताम तुमू मेहनेत ने काय काम मा किरहो।”<verse eid="LEV 23:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LEV 23:37" />यहोवान खास दिह ज्या हेते, ता दिह्याम तुमू यहोवाह बोली चेड़ावज्यो, मतलब होमबोली, एन बेट, मेल मिलाप बोली एने पिणी बोली बी चेड़ावाय जाय, एने चोखाली सोबान पारचार किरज्‍यो। <verse eid="LEV 23:37" /><verse number="38" style="v" sid="LEV 23:38" />न्या आखाह रेन जादा यहोवान विहेवणेन दिह्याह मानज्‍यो, एने तुमरी बेट्यु, एने आख्यु मानता एने तुमरी मोरजी केरीन चेड़ायेल बोल्युह, ज्‍यु यहोवाह अर्पण केरीन चेड़ावज्यो।<verse eid="LEV 23:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 23:39" />“ओवता सातवा मोयनान पोंदरावे दिह, जेवी तुमू तुमरा खेताम रेन कामायीह टुलो केर लिहो, तेवी सात दिह वोर यहोवान तिवार मानज्‍यो; तुमू पेल्ले दिह खास विहेवणेन एने आठवे दिह विहेवज्‍यो। <verse eid="LEV 23:39" /><verse number="40" style="v" sid="LEV 23:40" />एने पेल्ले दिह तुमू हाजा हाजा जाड़ान फोले, एने खजुरान डालख्यु, एने पालावाला जाड़ान डालख्‍यु, एने खोदरान मीरे रेन वाहण्यो लेन तुमरा बोगवान यहोवान सामने सात दिह वोर खुसी माणावज्यो। <verse eid="LEV 23:40" /><verse number="41" style="v" sid="LEV 23:41" />देर वोरीह सात दिह वोर यहोवान केरता ज्यो तिवार मान्या किरज्‍यो, ज्‍यो तुमरी पिढीन पिढ़ी माय कायेम ने विदी ठेराय काय सातवा मोयना माय ज्यो तिवार मानाय जाय। <verse eid="LEV 23:41" /><verse number="42" style="v" sid="LEV 23:42" />तुमू सात दिह वोर खोपड्युम रेया किरज्‍यो, इस्राएल माय पायदा इयेल आखा माणहे त्यु खोपड्युम रेती, <verse eid="LEV 23:42" /><verse number="43" style="v" sid="LEV 23:43" />ज्यानकेरता काय तुमरा पिढीन पिढ़ीवाला माणहे ज्‍य जाण रेय, काय जेवी यहोवा आपु इस्राएलीह मिस्र देसा माय रेन निकालेन लावणे बाजरियेल इतो, तेवी तो ताह खोपड्यु माय रेणे देनो, मी तुमरो बोगवान यहोवा हे।”<verse eid="LEV 23:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LEV 23:44" />इह केरीन मुसो इस्राएल ने माणहाह यहोवान तिवारान बाराम केय होमलायो।<verse eid="LEV 23:44" /></para>
  <chapter eid="LEV 23" />
  <chapter number="24" style="c" sid="LEV 24" />
  <para style="s">चोखाला दिवाह हिंगारनो</para>
  <para style="r">(<ref loc="EXO 27:20-21">निर्गमन 27:20-21</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 24:1" />ओवतो यहोवा मुसाह केयो, <verse eid="LEV 24:1" /><verse number="2" style="v" sid="LEV 24:2" />इस्राएल ने माणहाह ज्‍यो उकुम आप काय मार फाय उजालो केरनेन केरता कुटिन निकालेल हाजालो तेल लियावज्यो काय दिवो कायेम पेटाते रेय। <verse eid="LEV 24:2" /><verse number="3" style="v" sid="LEV 24:3" />हारून यहोवान मिलापवाला तोम्बुम गोवाय पोत्रान विचीवाला पोरदान बाहेर यहोवान सामने, कायेम हांज पोर रेन ते वेगोस वोर हेलगाड़ीन मेली; ज्‍यो नेम तुमरी पिढीन पिढ़ी केरता ठेराय। <verse eid="LEV 24:3" /><verse number="4" style="v" sid="LEV 24:4" />हारून दिवान हाजाला दिवट<note caller="+" style="f"><char style="fr" closed="false">24:4 </char><char style="fq" closed="false">दिवट </char><char style="ft" closed="false">दिवो मेलनेन जागो, नाहते कोठी</char></note> पोर यहोवान सामने दिवाह कायेम हेलेगताला मेली।<verse eid="LEV 24:4" /></para>
  <para style="s">बेटीन रोटा</para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 24:5" />“तु मोयदा लेन बारा रोटा रांदज्‍ये, एक एक रूटो दुय किलो मोयदान बाणावाय जाय। <verse eid="LEV 24:5" /><verse number="6" style="v" sid="LEV 24:6" />तेवी तान दुय रांग बाणावीन, एक एक रांग सोव सोव रोटा, हाजाला होनान बागड़ा पोर यहोवान सामने मिलज्यो। <verse eid="LEV 24:6" /><verse number="7" style="v" sid="LEV 24:7" />एने एक एक रांग पोर चोखाला हालयान ढिक मिलज्यो काय तो रूटो यहोवाह एर केरावणेन वोस्तु एने बोली रेय। <verse eid="LEV 24:7" /><verse number="8" style="v" sid="LEV 24:8" />देर विहेवणे दिह हारून रोटाह यहोवान सामने आरी माय मेली, इस्राएल ने माणहा हेऱ्यी ज्यी वाचा कायेम बोणीन रेय। <verse eid="LEV 24:8" /><verse number="9" style="v" sid="LEV 24:9" />एने ता हारून एने तान सोरान रेती, ता रोटाह चोखाला जागाम खाय, काहाकाय ता रोटा यहोवाह आक्‍ठान द्वारा चेड़ायेल बेटीम रेन हेते; ता रोटा हारून ने केरता कायेम चोखी बेट रेय।”<verse eid="LEV 24:9" /></para>
  <para style="s">नियाव से निषपक्ष देन्ड</para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 24:10" />ता दिह्याम एक इस्राएली बायकुन बिटोख इतो, तान आबोख मिस्र देसाम रेणार इतो; तो इस्राएली माणहान विचीम जात रिनो, तो इस्राएली बायकुन बिटोख एने एक इस्राएली एदमी पाड़ावाम आपसाम लेड़ाणे बाज गीया, <verse eid="LEV 24:10" /><verse number="11" style="v" sid="LEV 24:11" />एने तो इस्राएली बायकुन बिटोख यहोवान नावान चिहटा केरीन हाराप आपणे बाज गीयो। ज्‍य होमलीन माणहे ताह मुसा फाय ली गीया, तान आईख ने नाव शलोमीत एतो, जी दानान कुटूमान दिब्रीन बेटीख एती। <verse eid="LEV 24:11" /><verse number="12" style="v" sid="LEV 24:12" />माणहे सोराह जेलीम कोंड्या, जाकेरीन यहोवान उकुमा से ज्यी वातु पोर विचार केराय जाय।<verse eid="LEV 24:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 24:13" />तेवी यहोवा मुसाह केयो, <verse eid="LEV 24:13" /><verse number="14" style="v" sid="LEV 24:14" />“तुमू ता हाराप देणाराह पाड़ावान बाहेर ली जावो; एने जोला बी चिहटा होमलेल एती, ता आखा आप आपणा आथ तान मुंडी पोर मेली, तेवी आखी मोंडलीन माणहे ताह देगड़ाठे। <verse eid="LEV 24:14" /><verse number="15" style="v" sid="LEV 24:15" />एने तु इस्राएल ने माणहाह के काय, केदी इखेह माणुह तान बोगवानाह हाराप देथे, ताहार ताह तान पापान देन्ड वेठणे पोड़ी। <verse eid="LEV 24:15" /><verse number="16" style="v" sid="LEV 24:16" />यहोवान नावान चिहटा केरनार जोरेवरी माराय जाय, एने ताह आखी मोंडली देगड़ाठे; केदी तो देसावालो एय नाहते पारायो एय, केदी इखेह माणुह यहोवान नावान चिहटा केरी, ताहार तो माराय जाय।”<verse eid="LEV 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 24:17" />“एने केदी इखेह माणुह एगदा दिहरा माणहाह मार टाकेह, ताहार तो जोरेवरी माराय जाय। <verse eid="LEV 24:17" /><verse number="18" style="v" sid="LEV 24:18" />केदी इखेह माणुह एगदा पालन्या जेनवाराह मार टाकेह, तो ताह बोर देय, मतलब जीवान बोदले जीव।”<verse eid="LEV 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 24:19" />“ओवतो केदी इखेह माणुह एगदा दिहरा माणहाह दुख पोचाड़ी, ताहार जिह केरीन तो किरेल एय, तिहेच केरीन ता हेऱ्यो बी केराय जाय, <verse eid="LEV 24:19" /><verse number="20" style="v" sid="LEV 24:20" />मतलब आड़ तोड़नेन बोदले आड़ तोड़ाय जाय, डोलान बोदले डोला, दातान बोदले दात, जोहलो दुख जो बी एगदाह पोचाड़ेल एय, तिहेच केरीन ताह बी पोचाड़ाय जाय। <verse eid="LEV 24:20" /><verse number="21" style="v" sid="LEV 24:21" />जेनवाराह जो मार टाकेह तो ताह बोर देय, पुण माणहाह जो मार टाकेह, तो जोरेवरी माराय जाय। <verse eid="LEV 24:21" /><verse number="22" style="v" sid="LEV 24:22" />तुमरो नेम एकुस रेय, जोहलो देसावालान केरता, तिहेच केरीन पारायान केरता बी रेय, काहाकाय मी तुमरो बोगवान यहोवा हे।” <verse eid="LEV 24:22" /><verse number="23" style="v" sid="LEV 24:23" />तेवी मुसो इस्राएल ने माणहाह ज्‍य सोमजाड्यो; तेवी तो ता हाराप देराणा माणहाह पाड़ावान बाहेर ली जाएन ताह देगड़ाठ्या। एने इस्राएल ने माणहे तिहेच केरीन केऱ्या, जिह केरीन यहोवा मुसाह उकुम आपेल इतो।<verse eid="LEV 24:23" /></para>
  <chapter eid="LEV 24" />
  <chapter number="25" style="c" sid="LEV 25" />
  <para style="s">हातवो वोरीह विहेवणेन वोरीह</para>
  <para style="r">(<ref loc="DEU 15:1-11">व्यवस्था 15:1-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 25:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">25:1 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 23:10-11">व्यवस्था 23:10-11</ref>
      </char>
    </note>ओवतो यहोवा सीने बोयड़ा पोर मुसाह केयो, <verse eid="LEV 25:1" /><verse number="2" style="v" sid="LEV 25:2" />“इस्राएल ने माणहाह के काय जेवी तुमू ता देसाम जाहो जो मी तुमूह आपथु, तेवी बुयीह यहोवान केरता आराम जुड्या किरे। <verse eid="LEV 25:2" /><verse number="3" style="v" sid="LEV 25:3" />तुमू सोव वोरह्या वोर तुमरा खेताम बियारो पेरज्‍यो, एने तुमू तुमरी अंगुरान वाड़ीम सोव वोरह्या वोर साट साटिन खेतान कामाय टुलो केऱ्या किरज्‍यो। <verse eid="LEV 25:3" /><verse number="4" style="v" sid="LEV 25:4" />पुण सातवे वोरीह बुयीह विहेवणे दिज्यो, ज्‍य यहोवाह आदार आपणेन केरता विहेवणेन खास दिह रेय, ताम नाहते तुमू तुमरो खेत पेरज्‍यो एने नाह तुमरा अंगुरान वाड़ी साटज्‍यो। <verse eid="LEV 25:4" /><verse number="5" style="v" sid="LEV 25:5" />तुमू ती कामायीन काटाय मा किरहो, जी कामाय काटणेन बाद तान तान उगेह, एने तुमरा ता अंगुरान वेलाम रेन अंगुर मा तुड़हो जान तुमू साटाय नाह किरेल सोता; काहाकाय ज्‍य बुयीन केरता विहेवणेन वोरीह रेय। <verse eid="LEV 25:5" /><verse number="6" style="v" sid="LEV 25:6" />पुण बुयीन विहेवणेन वोरीहवाली कामायी केरीन तुमूह, एने तुमरा पावोर पावेरन्‍युह, एने तुमरी हेऱ्या रेणारे मोंजर्‍या एने पाराया देसावालाह बी खाणो जुड़ी; <verse eid="LEV 25:6" /><verse number="7" style="v" sid="LEV 25:7" />एने तुमरा जेनवाराह एने देसाम जोला जीवजेन्तु रेती, तान बी चारो बुयीन आखी कामायी केरीन एय।”<verse eid="LEV 25:7" /></para>
  <para style="s">आजादीन वोरह्यो</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 25:8" />सात विहेवणेन वोरीह, मतलब तुमू हात वोरह्यान सातु टोलाह गेणज्‍यो, सातु विहेवणेन वोरह्यान ज्‍यो टेम चालीह ने नोव वोरह्या रेय। <verse eid="LEV 25:8" /><verse number="9" style="v" sid="LEV 25:9" />तेवी सातवा मोयनान दोहवे दिह्याह, मतलब पाप डापणेन दिह, जय जयकारान मोटला सोबदान बिरो तुमरा आखा देसाम आखी जागे फुकाड़ज्‍यो। <verse eid="LEV 25:9" /><verse number="10" style="v" sid="LEV 25:10" />एने तुमू पाचाहवे वोरह्याह चोखालो वोरह्यो मानज्‍यो, एने तुमरा देसाम रेणारे आखा माणहान केरता आजादीन पारचार किरज्‍यो; ज्या वोरह्याह तुमरी न्या आजादीन वोरीह केवाय जाय, तुमरे माय रेन आखाह तान तान खेत आपाय जाय; एने तुमरे कुटूमाम जात रिहो। <verse eid="LEV 25:10" /><verse number="11" style="v" sid="LEV 25:11" />पाचाहवो वोरीह तुमरी केरता आजादीन तिवारान वोरीह रेय; ती वोरीह तुमू मा पेरहो, एने जी कामाय आप आप उगी तीह बी मा काटहो, एने बिगेर साटेल अंगुराह वेलाम रेन अंगुर मा तुड़हो। <verse eid="LEV 25:11" /><verse number="12" style="v" sid="LEV 25:12" />काहाकाय तो जो आजादीन वोरीह रेय; तो तुमरी केरता चोखो रेय; तुमू तान कामाय खेताम रेस ने लेन खाज्यो।<verse eid="LEV 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 25:13" />ज्या आजादीन वोरह्याम एकेक माणहाह तान खेत पोशा जुड़ जाय। <verse eid="LEV 25:13" /><verse number="14" style="v" sid="LEV 25:14" />एने एगदा माणहाह तान जागो वेचणे माय मा ठेगहो, एने जेवी तुमू ता फाय रेन जागो लिहो, तेवी ताह तुमूह मा ठेगणे दिहो। <verse eid="LEV 25:14" /><verse number="15" style="v" sid="LEV 25:15" />आजादीन वोरह्यान बाद जोला वोरह्या वितेल एती, तान गेणती केरीन किमोत ठेरावीन एका दिहरा फाय रेन वेचाता लिज्यो, एने वोरह्यान कामायीन गेत तो तार आथाम वेची। <verse eid="LEV 25:15" /><verse number="16" style="v" sid="LEV 25:16" />जोला वोरह्या उंजु रेती, तोलीस किमोत वोदाड़ज्‍यो, काहाकाय वोरह्यान कामायीन गेणती गेटाड़ज्‍यो, काहाकाय वोरह्यान कामायीन गेणती जोली एय, तोलीस तो तार आथाम वेची। <verse eid="LEV 25:16" /><verse number="17" style="v" sid="LEV 25:17" />तुमू तुमरा बाय बांडलाह ठेगहो मा; तुमू तुमरा बोगवानान बिय मानज्‍यो; मी तुमरो बोगवान यहोवा हे।<verse eid="LEV 25:17" /></para>
  <para style="s">सातवा वोरह्यान तेकलीत</para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 25:18" />तानकेरता तुमू मारा नेमाह एने विद्युह मानज्‍यो एने तान पालेन किरज्‍यो, इह केरीन किरहो, ताहार तुमू तुमरा देसाम हाजे हुके रिहो। <verse eid="LEV 25:18" /><verse number="19" style="v" sid="LEV 25:19" />बुय तुमरी केरता हाजी कामाय उगाड्या केरी, एने तुमू पेट बोरीन खाया किरहो, एने तुमू तुमरा देसाम हाजे हुके रिहो।<verse eid="LEV 25:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 25:20" />पुण केदी तुमू ज्‍य किहो, केदी आपु बियारो नाय पेरहु नाहते आपणी कामाय एकठी नाय केरहु, ताहार सातवे वोरीह आपणी केरता खाणेन केरता कायच बी नाय रेय? <verse eid="LEV 25:20" /><verse number="21" style="v" sid="LEV 25:21" />चिन्ता मा किरो, मी तुमूह सोव्‍वा वोरह्याम ओहली बोरकेत आपुह, काय बुय ने कामाय तीन वोरह्या वोर पुरी। <verse eid="LEV 25:21" /><verse number="22" style="v" sid="LEV 25:22" />तुमू आठवा वोरह्याम पेरहो, एने जुनाली कामायीम रेन खाते रिहो, एने नोव्‍वा वोरह्यान कामाय जाह वोर नाय जुड़ी, ताह वोर तुमू जुनाली कामायीम रेन खाते रिहो।<verse eid="LEV 25:22" /></para>
  <para style="s">बुयीन मालदेन सोड़ेवणेन नेम</para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 25:23" />बुय कायेम ने केरता वेचाय नाय जाय, काहाकाय बुय मारी हे; एने तुमू देरती पोर निसता दिहरा देसावाला एने पारवासीन वेहा माय रेणे बाजरेनाह। <verse eid="LEV 25:23" /><verse number="24" style="v" sid="LEV 25:24" />पुण तुमू तुमरा आदिकारान आखी बुयीम रेन तुमू बुयीह सोड़ीव लिज्यो।<verse eid="LEV 25:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 25:25" />केदी तारो एगदो बायबांडलो गेरीब एन तान सोतान बुयीम रेन थोड़ीक वेच देय, ताहार तान आहेंल्या गेरल्या आवी एने तान गेरल्‍यान केरता विचेल बुयीह सोड़ीव लेय, <verse eid="LEV 25:25" /><verse number="26" style="v" sid="LEV 25:26" />केदी एगदा माणहान केरता कुण सोड़ेवणार निह एय, एने ता फाय ओला पोयशा एती काय सोतास तान ईसाह सोड़ीव सेकी, <verse eid="LEV 25:26" /><verse number="27" style="v" sid="LEV 25:27" />ते तो बुयीन वेचणेन टेम रेन वोरह्याह गेणीन वोरह्यान कामायीन किमोत ताह, जो बुयीह वेचातो लिदो एय, आप देय; तेवी बुय पोशी तान एय जाय। <verse eid="LEV 25:27" /><verse number="28" style="v" sid="LEV 25:28" />पुण केदी तो माणुह तानकेरता बुयीह पोशो सोड़ेवणेन केरता पुरा पोयशा निह एती काय तीह पोशो तान केर सेकी, ताहार तान विचेल बुय आजादीन वोरीह वोर वेचातो लेणारान आथाम रेय; एने आजादीन वोरह्याम सुट जाय तेवी तो माणुह तान सोतान बुयीन पोशो आदिकारी एय जाय।<verse eid="LEV 25:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 25:29" />केदी इखेह माणुह बितड़ा वाला गावाम तान गेर वेचेह, ताहार गेर वेचाणेन बाद एक वोरीह वोर ताह पोशो लेणेन आदिकार रेय, गेराह पोशो लेणेन तान आदिकार एक वोरीह वोर रेय। <verse eid="LEV 25:29" /><verse number="30" style="v" sid="LEV 25:30" />पुण केदी गेरान मालीक वोरीह बोर माय गेर नाय सोड़वे, ताहार तो गेर जो बितड़ा वाला गावाम एय वेचातो लेणारान एने पिढीन पिढ़ी माय तास ने वोचीन बोण जाय; एने आजादीन वोरीह माय बी नाय सुटे। <verse eid="LEV 25:30" /><verse number="31" style="v" sid="LEV 25:31" />पुण बिगेर बितड़ान गावान गेरे ते देसान खेतान गेत गेणाय जाती; ताह सोड़ेवणेन बी एय सेकी, एने ता आजादीन वोरह्याम सुट जाती। <verse eid="LEV 25:31" /><verse number="32" style="v" sid="LEV 25:32" />पुण लेवीन गावान बाराम जा गावे लेवीन सोतान हेते, ताम ता तान गेराह काल्‍ले बी टेम पोशा सोड़ीव सेकतेह। <verse eid="LEV 25:32" /><verse number="33" style="v" sid="LEV 25:33" />एने केदी इखेह लेवी तान ईसो नाय सोड़वी, ते तो विचेल गेर जो तान ईसान गावाम एय आजादीन वोरह्याम लेवीन एय जाय, काहाकाय इस्राएल ने माणहान विचीम लेवीन ईसो तान गावाम ता गेरेच हेते। <verse eid="LEV 25:33" /><verse number="34" style="v" sid="LEV 25:34" />पुण लेवी गावान कावदेन खेत एने चारो वेचाय नाह सेकते, ता खेते कायेम ने केरता लेवीन हेते।<verse eid="LEV 25:34" /></para>
  <para style="s">गेरब्याह उदार आपणो</para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 25:35" />ओवतो केदी तारो इखेह बायबांडलो गेरीब एय जाय, एने तान देशा तार सामने किवीन लायकी एय जाय, ताहार तु ताह होमालज्‍ये; एने ताह बाहख एने पावणान गेत मिलज्ये। <verse eid="LEV 25:35" /><verse number="36" style="v" sid="LEV 25:36" />ताह आपेल तारा केर्जा पोर वियाज मा लेहे; तुमरा बोगवानान बिय मानज्ये, जान वोजेसे तारो बायबांडलो तार हिऱ्यो जिवतालो रेय सिके। <verse eid="LEV 25:36" /><verse number="37" style="v" sid="LEV 25:37" />ताह वियाज पोर पोयशा उदार मा आपहो, एने जो खाणो तो खाय, ता पोर इखेह फायदो लेणेन कोसीत मा किरो। <verse eid="LEV 25:37" /><verse number="38" style="v" sid="LEV 25:38" />मी तुमरो बोगवान यहोवा हे; मी तुमूह कनान देस आपणेन केरता एने तुमरो बोगवान बोणनेन केरता तुमूह मिस्र देसाम रेन निकाल लायेल हे।<verse eid="LEV 25:38" /></para>
  <para style="s">गुलामाह सोड़ेवणेन नेम</para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 25:39" />ओवतो केदी तारो एखेह बायबांडलो तार सामने गेरीब एन सोताह तार आथाम वेच देय, ताहार ता हेऱ्या पावरान गेत चाकरी मा केरावहो। <verse eid="LEV 25:39" /><verse number="40" style="v" sid="LEV 25:40" />तो तार हेऱ्यो मोजुर नाहते एक पावणान गेत रेय, एने आजादीन वोरीह वोर तार हिऱ्यो रिन सेवा किरते रेय। <verse eid="LEV 25:40" /><verse number="41" style="v" sid="LEV 25:41" />तेवी तो सोरा बेल तार फाय रेन निकील जाय, एने तान कुटूमा माय एने तान डायडायान खास जागाम जात रेय। <verse eid="LEV 25:41" /><verse number="42" style="v" sid="LEV 25:42" />काहाकाय ता मारास सेवक हेते, मी ताह मिस्रीन गुलामीम रेन सोड़वीन मिस्र देसाम रेन निकाल लायेल हे; केरीन ता गुलामान गेत वेचाय नाय जाय। <verse eid="LEV 25:42" /><verse number="43" style="v" sid="LEV 25:43" />तुमू ओहला माणहा पोर काठोपोणा से आदिकार मा चालाड़हो; तुमू तुमरा बोगवानान बिय मानज्‍यो। <verse eid="LEV 25:43" /><verse number="44" style="v" sid="LEV 25:44" />तुमरा जा पावोर पावेरन्‍यु रेती ता तुमरे कावदेन देसाम रेन रेय, एने पावोर पावेरन्‍युह तास माय रेन रेय। <verse eid="LEV 25:44" /><verse number="45" style="v" sid="LEV 25:45" />जा माणहे तुमरी विचीम पाराया बोणीन रेती, ताम रेन एने तान कुटूमाम रेन बी जा तुमरे आहने पाहने एती, एने जा तुमरा देसाम पायदा इयेल हेते, ताम रेन तुमू पावोर एने पावेरनी लेय लिवो; एने ता तुमरो ईसो ठेराती। <verse eid="LEV 25:45" /><verse number="46" style="v" sid="LEV 25:46" />तुमू ज्या पाराया देसान पावराह तुमरा सोराह बी आप सेकतेह, जा तुमूह मोरनेन बाद तुमरा सोरान रेती, ता कायेम ने केरता तुमरा पावोर रेती, पुण तुमरा बायबांडला जा इस्राएली हेते ता पोर तुमरो आदिकार काठोपोणा से मा चालाड़हो।<verse eid="LEV 25:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LEV 25:47" />ओवतो केदी तार सामने इखेह पाराया देसावालो मालदार एय जाय, एने तान सामने तारो बाहख गेरीब एन सोताह, तार सामने ता पाराया देसावाला नाहते तान वोचीन आथाम वेच देय, <verse eid="LEV 25:47" /><verse number="48" style="v" sid="LEV 25:48" />ताहार ताह वेचाणेन बाद तो पोशो सोड़ावाय जाय सिकेह; तान बायह्याख माय रेन एगदो ताह सोड़ीव सिकेह, <verse eid="LEV 25:48" /><verse number="49" style="v" sid="LEV 25:49" />नाहते तान काकोख, नाहते निवत्र्यो बाहख, नाहते तान गेराणान कुण बी आहेंल्‍यो गेरल्‍यो ताह सोड़ीव सिकेह; नाहते केदी तो मालदार एय जाय, ताहार तो सोतास ताह सोड़ीव सिकेह। <verse eid="LEV 25:49" /><verse number="50" style="v" sid="LEV 25:50" />तो ताह वेचातो लेणारा हिऱ्यो ताह वेचणेन वोरीह रेन आजादीन वोरीह वोर ईसाब केरी, एने ताह वेचणेन किमोत वोरह्यान गेणतीन गेत रेय, मतलब ती किमोत मोजुर ने दिह्यान गेत ता हेऱ्यो एय। <verse eid="LEV 25:50" /><verse number="51" style="v" sid="LEV 25:51" />केदी आजादीन वोरह्यान पेल जुलूम वोरह्या रेय जाती, ताहार जोला पोयशा केरीन तो लेवानो एय, ताम रेन तो तान सोड़वणेन किमोत तोलाक वोरह्यान आप देय। <verse eid="LEV 25:51" /><verse number="52" style="v" sid="LEV 25:52" />केदी आजादीन वोरीह वोर थोड़ास वोरह्या रेना एती, तीबी तो तान मालीक हिऱ्यो ईसाब केरीन सोताह, सोड़ेवणेन किमोत तोलास वोरह्यान नुसार आप देय। <verse eid="LEV 25:52" /><verse number="53" style="v" sid="LEV 25:53" />पुण तो माणुह देर वोरीह तान मालीक हिऱ्यो मोजुर ने गेत रेय, एने ता माणहा पोर काठोपोणा से मालीक ने आदिकार मा केरने दिवो। <verse eid="LEV 25:53" /><verse number="54" style="v" sid="LEV 25:54" />एने केदी तो माणुह एगदान द्वारा सोड़वाय नाय जाय, ताहार तो आजादीन वोरह्या माय तान सोरा बेल सुट जाय। <verse eid="LEV 25:54" /><verse number="55" style="v" sid="LEV 25:55" />काहाकाय इस्राएल ने माणहे मारास पावोर हेते; ता मारा सेवक हेते, मी मिस्रीन गुलामीम रेन ताह सोड़व्‍यो, मी तुमरो बोगवान यहोवा हे।<verse eid="LEV 25:55" /></para>
  <chapter eid="LEV 25" />
  <chapter number="26" style="c" sid="LEV 26" />
  <para style="s">उकुम मान्नेन बोरकेत</para>
  <para style="r">(<ref loc="DEU 7:12-24">व्यवस्था 7:12-24</ref>; <ref loc="DEU 28:1-14">28:1-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 26:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">26:1 </char>
      <char style="xt" closed="false">
        <ref loc="LEV 19:4">लेव्यवस्था 19:4</ref>; <ref loc="EXO 20:4">निर्गमन 20:4</ref>; <ref loc="DEU 5:8">व्यवस्था 5:8</ref>; <ref loc="DEU 16:21-22">16:21-22</ref>; <ref loc="DEU 27:1">27:1</ref></char>
    </note>तुमू तुमरी केरता मुरती मा बाणावहो, एने एगदी गिड़ेल मुरती नाहते तुमरी केरता एगदो दिगोड़ मा उबराखाड़हो, एने तुमरा देसाम पुजा केरनेन केरता देगड़ान मुरती मा बाणावहो; काहाकाय मी तुमरो बोगवान यहोवा हे। <verse eid="LEV 26:1" /><verse number="2" style="v" sid="LEV 26:2" />तुमू मारा विहेवणेन दिह्याह पालेन किरज्‍यो एने मारा चोखाला जागान आदार किरज्‍यो; मी यहोवा हे।<verse eid="LEV 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 26:3" />केदी तुमू मारा नेमा पोर चालहो एने मारा उकुमाह मानीन तान पालेन किरहो, <verse eid="LEV 26:3" /><verse number="4" style="v" sid="LEV 26:4" />ताहार मी तुमरी केरता टेमा टेमा पोर पाणी पाडुह, खेत कामाय पाकाड़ी एने बुय ने जाड़े फोल्‍या केरती; <verse eid="LEV 26:4" /><verse number="5" style="v" sid="LEV 26:5" />तुमरी कामाय निकालनेन काम ताह वोर चाली, जाह वोर अंगुर एकठा केरनेन टेम आवी एने अंगुर एकठा केरनेन ताह वोर चाली, जाह वोर पेरनेन टेम आवी, तेवी तुमरी फाय खाणेन केरता जुलूम रेय, एने तुमू तुमरा देसाम हाजे हुके रिहो। <verse eid="LEV 26:5" /><verse number="6" style="v" sid="LEV 26:6" />मी तुमरा देसाम सान्ती आपुह, एने तुमू सान्ती से हुवहो एने कुण तुमूह बिवाड़ने नाय आवी; एने मी ता देसाम जीव लेण्‍या जेनवेराह रेणे नाय देव, एने तुमरा देसा माय तालवार नाय चाली। <verse eid="LEV 26:6" /><verse number="7" style="v" sid="LEV 26:7" />एने तुमू तुमरा दुसमोनाह दितेन नाहाड़ देह, एने ता तुमरी तालवार केरीन माराय जाती। <verse eid="LEV 26:7" /><verse number="8" style="v" sid="LEV 26:8" />तुमरे माय रेन पाच माणहे होव माणहाह एने होव माणहे दोह एजार माणहाह नाहाड़ती; एने तुमू तुमरा दुसमोनाह आरेवहो एने ताह तालवार केरीन मार टाकहो। <verse eid="LEV 26:8" /><verse number="9" style="v" sid="LEV 26:9" />एने मी तुमरी उगे किव केरूह एने तुमूह होवटाला सोरावाला बाणावुह, एने तुमरी हिऱ्यो मार वायदाह मोजबुत केरूह। <verse eid="LEV 26:9" /><verse number="10" style="v" sid="LEV 26:10" />एने तुमू मेलीन जुनाला दाणाह खाहो, एने नोवालो रेय तीबी जुनाला दाणाह जुगारने पोड़ी। <verse eid="LEV 26:10" /><verse number="11" style="v" sid="LEV 26:11" />एने मी तुमरे विचीम मारो रेण्‍यो जागो बाणावीन मेलुह, एने मी तुमूह रेन आलेग नाय एव। <verse eid="LEV 26:11" /><verse number="12" style="v" sid="LEV 26:12" />एने मी तुमरी विचीम चालुह एने तुमरो बोगवान रेह, एने तुमू मारा माणहे रिहो। <verse eid="LEV 26:12" /><verse number="13" style="v" sid="LEV 26:13" />मी ते तुमरो बोगवान यहोवा हे, तुमू मिस्र देसाम गुलाम एता, पुण मी तुमूह मिस्र देसाम रेन निकाल लावो; पुण मी तुमरा खांदान जुवालाह तोड़ जुगार्‍यो, एने मी तुमूह पोशो गर्व से चालनारे बाणायो।<verse eid="LEV 26:13" /></para>
  <para style="s">उकुम नाह मान्नेन देन्ड</para>
  <para style="r">(<ref loc="DEU 28:15-68">व्यवस्था 28:15-68</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 26:14" />“केदी तुमू मारे नाय होमेलहो, एने ज्या आखा उकुमाह नाय मानहो, <verse eid="LEV 26:14" /><verse number="15" style="v" sid="LEV 26:15" />एने मारी विदीह खाराब जाणहो, एने तुमरी आत्मा मार नेमाह नफरत किरे, एने तुमू मारा आखा उकुमान पालेन नाय किरहो, ताहार तुमू मारी वाचाह तोड़ दियेल हेते। <verse eid="LEV 26:15" /><verse number="16" style="v" sid="LEV 26:16" />ताहार मी तुमरी हिऱ्यो ज्‍य केरूह; मतलब मी तुमूह गाबरावुह, एने जुलूम मोठो रोग एने हेऱ्या माय दुखाऱ्यो केरूह, एने न्यान वोजेसे तुमरा डोला जीन्‍वाल्‍लाह एय जाती, एने तुमरो मोन जुलूम नाराज एय। एने तुमरो बियारो पेरनो कामान नाय रेय काहाकाय तुमरा दुसमोन ती कामाय खाय जाती; <verse eid="LEV 26:16" /><verse number="17" style="v" sid="LEV 26:17" />एने मी बी तुमरी विरूद एय जाह, एने तुमू तुमरा दुसमोनाह रेन आरवाय जाहो; एने तुमरा दुसमोन तुमरी उपेर आदिकार चालाड़ती, एने जेवी इखेह तुमूह दोवड़ावी बी नाय तीबी तुमू नाहहो।<verse eid="LEV 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 26:18" />“केदी तुमू ज्‍यु वातुन बाद बी मारो उकुम पालेन नाह केरतेह, ताहार मी तुमरा पापान केरता सात गुणा वोदार देन्ड आपुह। <verse eid="LEV 26:18" /><verse number="19" style="v" sid="LEV 26:19" />एने मी तुमरी ताकेतीन गोमेंड तोड़ देह, एने तुमरी केरता जुगाह लोड़ान गेत एने बुयीह पितलान गेत बाणाव देह एने पाणी नाय पोड़ी। <verse eid="LEV 26:19" /><verse number="20" style="v" sid="LEV 26:20" />तुमू केठीण मेहनेत किरहो, पुण ज्‍य केरीन काय बी फायदो नाय एय, तुमरो खेत कामाय नाय उगाड़ी एने बुय ने जाड़ा पोर फोल नाय लागती।”<verse eid="LEV 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 26:21" />केदी तुमू मारे विरूद चालतेस रिहो, एने मारो केणो नाय मानो, ताहार मी तुमरा पापान गेत तुमरी पोर उंजु सात गुणा तेकलीत टाकुह। <verse eid="LEV 26:21" /><verse number="22" style="v" sid="LEV 26:22" />एने मी तुमरी विचीम जेंगली जेनवाराह मोकलुह, ता तुमरा सोराह तुमरी फाय रेन सांडाड़ ली जाती, एने तुमरा पालन्या जेनवाराह खेतेम केर देती, एने तुमरी गेणती गेटाड़ती, जाकेरीन तुमरी सेड़क्‍यु हुनाल्‍यु पोड़ जाती।<verse eid="LEV 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 26:23" />ओवता केदी तुमू न्‍यु वातु पोर बी मारी हिकवोणी केरीन नाय हुदेरहो, एने मार विरूद चालतेस रिहो, <verse eid="LEV 26:23" /><verse number="24" style="v" sid="LEV 26:24" />ताहार मी तुमरी विरूद चालुह, एने मी यहोवा, तुमरा पापान केरता तुमूह सात गुणा देन्ड आपुह। <verse eid="LEV 26:24" /><verse number="25" style="v" sid="LEV 26:25" />तुमू मारी वाचाह तुड़ेल हेते, केरीन मी तुमूह देन्ड आपुह, मी तुमरी विरूद सेना मोकलुह; तुमू वोचणेन केरता तुमरा गावाम जाहो, पुण मी ओहलो केरूह काय तुमरे माय बेमारी पोसरी, तेवी तुमरा दुसमोन तुमूह आरेवती। <verse eid="LEV 26:25" /><verse number="26" style="v" sid="LEV 26:26" />जेवी मी तुमरी केरता एनान आदाराह सेटो केर देह, तेवी दोह बायकु तुमरा रोटा एकुस चुलाम रांदीन तोल तोलीन वाट देती; एने तुमू खाएन बी आफेरहो नाय।<verse eid="LEV 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 26:27" />“ओवता केदी तुमू ज्यान बाद बी मारे नाय होमेलहो, एने मारे विरूद चालतेस रिहो, <verse eid="LEV 26:27" /><verse number="28" style="v" sid="LEV 26:28" />ताहार मी मारा नियावा माय तुमरे विरूद चालुह, एने तुमरा पापान केरता सात गुणा देन्ड आपुह। <verse eid="LEV 26:28" /><verse number="29" style="v" sid="LEV 26:29" />एने तुमूह तुमरा बेटा एने बेटीख ने माह खाणे पोड़ी। <verse eid="LEV 26:29" /><verse number="30" style="v" sid="LEV 26:30" />एने मी तुमरा पुजान उचाला जागाह खेतेम केर देह, एने मी तुमरी हाजाली गेंदिन आक्‍ठान वेदीह तोड़ देह, एने तुमरा देड़ाह तुमरी तुड़ेल मुरती पोर टाक देह; एने तुमू माहु जुलूम खाराब लागहो। <verse eid="LEV 26:30" /><verse number="31" style="v" sid="LEV 26:31" />एने मी तुमरा गावाह उजाड़ देह, एने तुमरा चोखाला जागाह उजाड़ देह, एने तुमरी बेटीन हाजाली गेंदिह स्वीकार नाय केरू। <verse eid="LEV 26:31" /><verse number="32" style="v" sid="LEV 26:32" />एने मी तुमरा देसाह हुनालो केर देह, एने तुमरा दुसमोन जा ताम रेतेह ता ज्‍यु वातुन वोजेसे बोंगलाती। <verse eid="LEV 26:32" /><verse number="33" style="v" sid="LEV 26:33" />एने मी तुमूह बात बातीन देसाम वेरासेर केर देह, मी मारी तालवार खेचुह एने तुमूह खेतेम केरूह, एने तुमरो देस हुनालो एय जाय, एने तुमरा गाव उजाड़ एय जाती। <verse eid="LEV 26:33" /><verse number="34" style="v" sid="LEV 26:34" />तेवी जोला दिह तो देस हुनालो पुड़ेल रेय एने तुमू तुमरा दुसमोनान देसाम रिहो, तोलाक दिह तो तान विहेवणेन टेमाह मानते रेय, तेवीस तो देस विहवी, मतलब विहेवणेन टेम मानते रेय। <verse eid="LEV 26:34" /><verse number="35" style="v" sid="LEV 26:35" />जोला दिह तो हुनालो पोड़ रेय, तोलास दिह तो आराम केरी, मतलब जो आराम ताह तुमू ता रेणेन बुखेत तुमरे विहेवणेन टेमाम निह जुड़नो एय, तो ताह तेवी जुड़ी।”<verse eid="LEV 26:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LEV 26:36" />एने तुमरे माय जा माणहे वोचेल रेती, ता तान दुसमोनान देसाम तान ईमोत गोवाड़ देती, ता आखी चिजी से बिती, ता वाराम उड़ताला पानटान गेत कावदेन नाहती, ता ओहला नाहती जीहे इखेह तालवार लेन तान पासाण पोड़ रेनोह। <verse eid="LEV 26:36" /><verse number="37" style="v" sid="LEV 26:37" />जेवी एखेह तान पासाण केरनार निह एय तीबी सोमजो तालवारीह बिन ता एका दिहरा हेऱ्या रेन ठोकेर खाएन पोड़ते जाती, एने तुमूह तुमरा दुसमोनान सामने उब रेणेन कायच ताकेत नाय रेय। <verse eid="LEV 26:37" /><verse number="38" style="v" sid="LEV 26:38" />तेवी तुमू देस देसान विचीम पोचीन खेतेम एय जाहो, एने तुमू दुसमोनान देसाम आरताय जाहो। <verse eid="LEV 26:38" /><verse number="39" style="v" sid="LEV 26:39" />इह केरीन तुमरा सोरा तुमरा दुसमोनान देसाम तान पापाम सेड़ती, एने तान डायडायान गुनान वोजेसे ता तिहेच केरीन सेड़ती जिह केरीन तान डायडाया सेड़ेल।<verse eid="LEV 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LEV 26:40" />“पुण केदी ता तान एने तान डायडायान गुनाह मान लेती, एने माने काय ता मारे विरूद इयेल एता, एने ता ज्‍य बी माने काय आमु यहोवान विरूद पाप किरेल हेते, <verse eid="LEV 26:40" /><verse number="41" style="v" sid="LEV 26:41" />तानकेरता ता माने काय मी तान विरूद ईनो एने ताह तान दुसमोनान देसाम लावो, केदी ता माणहे तान काठो मोन नम्र एय जाय एने तान पापान केरता देन्ड स्वीकार केरती; <verse eid="LEV 26:41" /><verse number="42" style="v" sid="LEV 26:42" />तेवी जी वाचा मी याकुबा हिऱ्यो बांदेल इतो, तीह मी एर केरूह एने जी वाचा मी इसाहाक हिऱ्यो एने जी वाचा मी अब्राहाम हिऱ्यो बांदेल इतो, तीह बी एर केरूह। <verse eid="LEV 26:42" /><verse number="43" style="v" sid="LEV 26:43" />देस हुनालो रेय, देस विहेवणेन टेमान खुसी मोणावी, तेवी तुमरा वोचेल माणहे तान पापान केरता देन्ड स्वीकार केरती, ता हिकती काय ताह ज्यानकेरता देन्ड जुड़नो काय ता मारा नेमाह नाह मान्या, एने मारा उकुमान पालेन नाह किरेल एता, एने तान जीवाह मारी विदी से नफरत एती। <verse eid="LEV 26:43" /><verse number="44" style="v" sid="LEV 26:44" />ओलो एणेन बाद बी, जेवी ता तान दुसमोनान देसाम बी रेती; मी ताह इह केरीन नाय सोडु, एने मी ता हिऱ्यो मारी ओहली नफरत नाय केरू काय ताह खेतेम केर देव, एने मारी ती वाचाह तोड देव; जी मी ता हिऱ्यो बांदिल इतो, काहाकाय मी तान बोगवान यहोवा हे! <verse eid="LEV 26:44" /><verse number="45" style="v" sid="LEV 26:45" />पुण मी तान हाजान केरता तान डायडाया हेऱ्यी बादेल वाचाह एर केरूह; जाह मी दिहरी जातीन डोलान सामने मिस्र देसाम रेन निकालीन लावो काय मी तान बोगवान ठेराव; मी यहोवा हे।”<verse eid="LEV 26:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LEV 26:46" />ज्‍यु विद्यु एने नेम एने कायदो यहोवा तान उगे रेन इस्राएल ने माणहान केरता सीने बोयड़ा पोर मुसान द्वारा ठेरायेल इतो, ता ज्यास हेते।<verse eid="LEV 26:46" /></para>
  <chapter eid="LEV 26" />
  <chapter number="27" style="c" sid="LEV 27" />
  <para style="s">यहोवान बेट ने समंद माय नेम</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 27:1" />ओवतो यहोवा मुसाह केयो, <verse eid="LEV 27:1" /><verse number="2" style="v" sid="LEV 27:2" />इस्राएल ने माणहाह के काय जेवी इखेह खास मानता मानी, ताहार मानता किरेल माणहे तारे ठेरावणेन गेत यहोवान रेती; <verse eid="LEV 27:2" /><verse number="3" style="v" sid="LEV 27:3" />तानकेरता केदी तो विह वोरह्यान नाहते ताह रेन जादा एने साठ वोरह्या रेन कोम वोयान एदमी एय, ताहार तान केरता चोखाला जागान शेकेल<note caller="+" style="f"><char style="fr" closed="false">27:3 </char><char style="fq" closed="false">शेकेल </char><char style="ft" closed="false">साड़े आकरा ग्राम चांदीन टुकड़ा</char></note> ने गेत पाचाह शेकेलान ठेराती। <verse eid="LEV 27:3" /><verse number="4" style="v" sid="LEV 27:4" />केदी ती बायकु एय, ते ती तीस शेकेल ठेराय। <verse eid="LEV 27:4" /><verse number="5" style="v" sid="LEV 27:5" />केदी तान वोय पाच साल नाहते ताह रेन जास्ती एने विह सालाह रेन कोम एय, ते सोरान किमोत विह शेकेल, एने बायकुन किमोत दोह शेकेल ठेराय। <verse eid="LEV 27:5" /><verse number="6" style="v" sid="LEV 27:6" />केदी तान वोय एक मोयनो नाहते ताह रेन जास्ती एने पाच सालाह रेन कोम एय, ते सोरान किमोत पाच शेकेल, एने एक सोरीन किमोत तीन शेकेल ठेराय। <verse eid="LEV 27:6" /><verse number="7" style="v" sid="LEV 27:7" />केदी तान वोय साठ नाहते साठ रेन जास्ती एय, एने तो एदमी एय, ते तान किमोत पोंदरा शेकेल; एने एक बायकुन किमोत दोह शेकेल ठेराय।<verse eid="LEV 27:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 27:8" />केदी मानता केरनार माणुह ओलो गेरीब हे काय किमोत आपणेन ताकेत नाह सोती, ताहार ता माणहाह चाकर्‍यान सामने लावे, चाकर्‍यो ज्‍य ठेरावी काय तो माणुह कोलीक किमोत बुकतान माय आप सिकेह।<verse eid="LEV 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 27:9" />ओवता जा जेनवाराम रेन माणहे यहोवाह बेट चेड़ावतेह, केदी ओहलाम रेन इखेह माणुह ता जेनवाराम रेन एगदाह बोगवानाह आपी, तो चोखो ठेराय। <verse eid="LEV 27:9" /><verse number="10" style="v" sid="LEV 27:10" />तो ताह काल्लीस रिती से नाय बोदले, नाहते तो बाकतान बोदले हाजो, एने नाह हाजान बोदले बाकतो आपी। एने केदी तो ता जेनवारान जागे दिहरो जेनवार आपी, ताहार तो एने तान बुदलो दुयू चोखाला ठेराती। <verse eid="LEV 27:10" /><verse number="11" style="v" sid="LEV 27:11" />एने जा जेनवाराम रेन माणहे यहोवान केरता बोली नाह चेड़ावते ओहलाम एठा जेनवेराम रेन केदी ता एती, ताहार तो ताह चाकर्‍यान सामने उब राखाड़े, <verse eid="LEV 27:11" /><verse number="12" style="v" sid="LEV 27:12" />तेवी चाकर्‍यो जेनवेरान हाजा बाकता गुण फुसीन तान किमोत ठेरावे; एने जोलीक चाकर्‍यो ठेरावे तान किमोत तोलीस ठेराय। <verse eid="LEV 27:12" /><verse number="13" style="v" sid="LEV 27:13" />केदी माणुह जेनवाराह पोशो लेणे हुदेह, ताहार जी किमोत चाकर्‍यो ठेरायेल एय, तीम ताह पाचवो ईसो उंजु वोदार आपी।<verse eid="LEV 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 27:14" />ओवतो केदी इखेह माणुह तान गेर यहोवान केरता चोखो ठेरावीन आपेह, ताहार चाकर्‍यो गेरान हाजो बाकतो फुसीन तान किमोत ठेरावे; एने जोलीक चाकर्‍यो ठेरावी तान किमोत तोलीस ठेराय। <verse eid="LEV 27:14" /><verse number="15" style="v" sid="LEV 27:15" />एने केदी गेराह चोखो केरनार माणुह गेर सोड़ेवणे होदी, ताहार जोलाक पोयशा चाकर्‍यो तान किमोत ठेरायेल एय ताम तो पाचवो ईसो उंजु वोदाड़ीन आपी, तेवी गेर ता माणहान एय जाय।<verse eid="LEV 27:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 27:16" />ओवतो केदी इखेह माणुह तान खेतान एगदो ईसो यहोवान केरता चोखो ठेरावणे होदी, ताहार तान किमोत ज्यान गेत ठेराय काय ताम कोलोक बियारो पोड़ी; जोलोक खेताम होमेर<note caller="+" style="f"><char style="fr" closed="false">27:16 </char><char style="fq" closed="false">होमेर </char><char style="ft" closed="false">पाचाह शेकेल </char></note> बोर जुवार पोड़ी, तोलाक ने किमोत पाचाह शेकेल ठेराय। <verse eid="LEV 27:16" /><verse number="17" style="v" sid="LEV 27:17" />केदी माणुह तान खेत आजादीन वोरह्या मायच चोखो ठेरावे, ताहार तान किमोत तारे ठेरावणेन पारमाणे ठेराय। <verse eid="LEV 27:17" /><verse number="18" style="v" sid="LEV 27:18" />एने केदी माणुह तान खेत आजादीन वोरह्यान बाद दान किरे, ताहार जोलाक वोरीह दिहरा आजादीन वोरह्या बाकी रेती, तास ने गेत चाकर्‍यो तानकेरता पोयशान ईसाब केरी, तेवी जोलाक ईसाब माय आवती तोलाक चाकर्‍यान ठेरावणे से कोम रेती। <verse eid="LEV 27:18" /><verse number="19" style="v" sid="LEV 27:19" />एने केदी खेत दान केरनार माणुह खेताह पोशो लेणे होदी, ताहार जी किमोत चाकर्‍यो ठेरायेल एय, ताम तो पाचवो ईसो उंजु वोदाड़ीन आपी, तेवी खेत तास ने रेय। <verse eid="LEV 27:19" /><verse number="20" style="v" sid="LEV 27:20" />पुण केदी तो खेताह सोड़ेवणे नाय होदी, नाहते तो ताह दिहरान आथाम विचेल एय, ताहार खेत ओंगाण केदी नाय सोड़ावाय जाय; <verse eid="LEV 27:20" /><verse number="21" style="v" sid="LEV 27:21" />पुण जेवी तो खेत आजादीन वोरह्या माय सुटी, तेवी पुरीरिती से अर्पण किरेल खेतान गेत बोगवानान केरता चोखो ठेराय, मतलब तो खेत चाकऱ्यास ने सोतान खेत बोण जाय। <verse eid="LEV 27:21" /><verse number="22" style="v" sid="LEV 27:22" />ओवतो केदी इखेह तान वेचातो लियेल खेत, जो तान खोतान बुयीन खेतावाला निह एय, यहोवान केरता चोखो ठेरावी, <verse eid="LEV 27:22" /><verse number="23" style="v" sid="LEV 27:23" />ताहार चाकर्‍यो आजादीन वोरीह वोर वालो ईसाब केरीन ता माणहान केरता जोलोक ठेरावे तोलोस तो यहोवान केरता चोखो सोमजीन तेदिहस आप देय। <verse eid="LEV 27:23" /><verse number="24" style="v" sid="LEV 27:24" />आजादीन वोरह्याम तो खेत तास ने आदिकार माय जाफ रेन तो वेचातो लियेल एय, पोशो आव जाय, मतलब जान ती सोतान बुय एय, तास ने पोशी एय जाय। <verse eid="LEV 27:24" /><verse number="25" style="v" sid="LEV 27:25" />जी जी चिजीन किमोत चाकर्‍यो ठेरावी तीन किमोत चोखाला जागास ने शेकेल ने ईसाबा केरीन ठेराय, शेकेलान तोलो विह गेरान<note caller="+" style="f"><char style="fr" closed="false">27:25 </char><char style="fq" closed="false">गेरान </char><char style="ft" closed="false">बारा ग्राम </char></note> ठेराय।<verse eid="LEV 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 27:26" />पुण पालन्या जेनवारान जेठालो पिलो, जो जेठालो एणेन वोजेसे यहोवान ठेरायेल हे, कुण बी मानता नाय माने; केदी तो वासड़ो एय, केदी मेंड्रान नाहते पालन्या जेनवेरान पिलो, तो यहोवास ने हे। <verse eid="LEV 27:26" /><verse number="27" style="v" sid="LEV 27:27" />पुण केदी तो खाराब जेनवारान एय, ताहार ताह चोखो ठेरावणार ताह चाकर्‍यान ठेरायेल किमतीन गेत तान पाचवो ईसो उंजु वोदाड़ीन सोड़ीव सिकेह; एने केदी तो नाय सोड़ावाय जाय, ताहार चाकर्‍यान ठेरायेल किमोत पोर वेचाय जाय।<verse eid="LEV 27:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 27:28" />
    <note caller="+" style="x">
      <char style="xo" closed="false">27:28 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 18:14">गिनती 18:14</ref>
      </char>
    </note>पुण तान आखी चिजीम रेन जो काय इखेह यहोवान केरता अर्पण केरी, केदी माणुह एय केदी जेनवार, केदी तान सोतान बुयीन खेत एय, ओहली एगदी चेड़ायेल चिज वेचाय नाय जाय एने सोड़ावाय नाय जाय; जो काय चेड़ावाय जाय तो यहोवान केरता जुलूम चोखो ठेराय। <verse eid="LEV 27:28" /><verse number="29" style="v" sid="LEV 27:29" />केदी माणहा माय रेन एगदाह मोतीन देन्ड ने केरता अर्पण केराय जाय, ताहार तो पोशो सोड़ावाय नाय जाय; जोरेवरी तो माराय जाय।<verse eid="LEV 27:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 27:30" />
    <note caller="+" style="x">
      <char style="xo" closed="false">27:30 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 18:21">गिनती 18:21</ref>; <ref loc="DEU 14:22-29">व्यवस्था 14:22-29</ref></char>
    </note>ओवतो खेतान आखो दोहवो ईसो, केदी तो खेतान कामाय एय, केदी जाड़ान फोले, तो यहोवास ने हे, तो यहोवान केरता चोखो ठेराय। <verse eid="LEV 27:30" /><verse number="31" style="v" sid="LEV 27:31" />केदी इखेह माणुह तान दोहवा ईसाम रेन काह पोशो वेचातो लेणे होदी, ताहार पाचवो ईसो वोदाड़ीन ताह सोड़वे। <verse eid="LEV 27:31" /><verse number="32" style="v" sid="LEV 27:32" />एने पालन्या जेनवार एने मेंड्रा बोकड्या, मतलब जा जा जेनवार गेणनेन केरता डेंगीन नेचा रेन निकेलन्‍या हेते तान दोहवो ईसो, मतलब दोह दोहान पासाण एक एक जेनवार यहोवान केरता चोखाला ठेराती। <verse eid="LEV 27:32" /><verse number="33" style="v" sid="LEV 27:33" />मालीक ज्यी चिन्ता नाय किरे काय तो जेनवार हाजालो हे नाहते बाकतालो हे, तो जेनवाराह दिहरा जेनवारा हेऱ्यो नाय बोदले; केदी तो बोदली बी लेय, ताहार दुयू जेनवार यहोवान केरता चोखा रेती, तो जेनवार पोशो केदी सोड़ावाय नाय जाय।<verse eid="LEV 27:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LEV 27:34" />जा उकुम यहोवा इस्राएल ने माणहान केरता सीने बोयड़ा पोर मुसाह आपेल इतो, ता ज्या हेते।<verse eid="LEV 27:34" /></para>
  <chapter eid="LEV 27" />
</usx>