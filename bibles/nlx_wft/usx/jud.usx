<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JUD" style="id">- Nahali</book>
  <para style="h">यहुदा</para>
  <para style="toc3">यहुदा</para>
  <para style="toc2">यहुदा</para>
  <para style="toc1">यहुदा लिखेल पोत्रो</para>
  <para style="mt2">यहुदा ने लिखा हुआ पत्र</para>
  <para style="mt1">यहुदा लिखेल पोत्रो</para>
  <para style="imt">ओलखात</para>
  <para style="ip">यहुदा नावान पोत्रीन नाव ज्या लेखणारान नावा पोर मिलाय जायेल हे। यहुदा सोताह याकुब यीशु मसीन बायाख ने रूप माय ओलखात आपेह। तानकेरता तो यीशुन बायह्याख माय रेन एक मानाय जाथे। <char style="xt"><ref loc="JUD 1:1">1</ref></char> आमु नाह जाणते काय ज्यी पोत्री खास मोंडलीन केरता एती, पुण जुनाला नेमान कारेण यहुदा पोत्रीन मुखी वाचणारे यहुदि एता। पुण तो तान पोत्रीह लिखेह ता आखाह जा हादाड़ाय जायेल हेते, जाह आबाख हेऱ्यो मोंग हे एने यीशु मसीन केरता मेलाय जायेल हेते। <char style="xt"><ref loc="JUD 1:1">1:1</ref></char> ज्यी पोत्री नाहते मसीन जेल्मान 60 वोरह्या बाद लेखाय जायेल एतो।</para>
  <para style="ip">आखा बुरहो केरनार माणहाह पोत्री लेखणेन तान निसाण ताह जुठा मास्तेर्‍यान द्‍वारा बोटेकणेन विरोद चेतावणी आपेह <char style="xt"><ref loc="JUD 1:4">1:4</ref></char> जुनाला नेमान गेटना एने पोत्री ताकेत आपणेन केरता किथे। ज्यी पोत्री दुसरा पतरसा हेऱ्यो जुठा मास्तेर्‍या <char style="xt"><ref loc="JUD 1:4">1:4</ref></char>, <char style="xt"><ref loc="2PE 2:1">2 पतरस 2:1</ref></char> हेरोगदुत एने सदोम अमोरान विरोद चेतावणी हेऱ्यो जुलूम विचार बेचकातेह।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. यहुदा पेल वाचणाराह संबोदित किरेह। <char style="ior"><ref loc="JUD 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. तान बाद तो लेखणेन कारेण एने जुठा मास्तेर्‍यान विरोद चेतावणी आपेह। <char style="ior"><ref loc="JUD 1:3-4">1:3-4</ref></char></para>
  <para style="io1">3. तान बाद तो जुनाला नेमावाला माणहान एने गेटनान किस्सो आपेह। <char style="ior"><ref loc="JUD 1:5-16">1:5-16</ref></char></para>
  <para style="io1">4. ओवतो तो ताह किथे काय तान उलेट चेतावणीन केरता काय एणे जुवे। <char style="ior"><ref loc="JUD 1:17-23">1:17-23</ref></char></para>
  <para style="io1">5. बोगवानान बोड़ाय केरीन पोत्रीह निवरावेह। <char style="ior"><ref loc="JUD 1:24-25">1:24-25</ref></char></para>
  <chapter number="1" style="c" sid="JUD 1" />
  <para style="s">नमस्‍कार</para>
  <para style="p">
    <verse number="1" style="v" sid="JUD 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 13:55">मत्ती 13:55</ref>; <ref loc="MRK 6:3">मरकुस 6:3</ref></char>
    </note>यहुदान उगे रेन जो यीशु मसीन पावोर एने याकुबान बाहख हे,</para>
  <para style="p" vid="JUD 1:1">ता हादेल माणहान नावे जा आबाख बोगवाना माय मोंगाल्ला एने यीशु मसीन केरता होमालेल हेते:<verse eid="JUD 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JUD 1:2" />गीण एने सान्ती एने मोंग बोरपुर तुमूह जुड़ते रेय।<verse eid="JUD 1:2" /></para>
  <para style="s">जुठा मास्तेर्‍या</para>
  <para style="p">
    <verse number="3" style="v" sid="JUD 1:3" />एय मोंगाल्ला, जेवी मी तुमूह ता सुटकारान बाराम लेखणेम जुलूम मेहनेत केरीन कोसीत केरने बाजरियेल ईतो जा माय आपु बागी हेते, ते मी तुमूह ज्यो सोमजाड़नेन जोरेवरी जाणेल काय ता बोरहान केरता पुरो कोसीत किरो जो चोखाला माणहाह एकुच वार होपायेल एतो। <verse eid="JUD 1:3" /><verse number="4" style="v" sid="JUD 1:4" />काहाकाय कोलाक माणहे आपु माय लिकाएन आव मीलानाह, तान डेंडान बाराम जुनाला टेम माय पेलुच लेखाय जायेल एतो: ज्या विणबोकत्या हेते, एने आमरा बोगवानान गीणाह लुच्‍चाय माय बोदेल देतेह, एने आमरा मालीक यीशु मसीह नाकारतेह।<verse eid="JUD 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JUD 1:5" />
    <note caller="+" style="f">
      <char style="fr" closed="false">1:5 </char>
      <char style="ft" closed="false">मालीक; थोड़ाक लेख माय यीशु लिखेल हे।</char>
    </note>तुमूह ज्यो आखो मालुमूच हे, तीबी तुमूह ज्यी वातु एर केरावु ओहलो माहु लागेह, तो ज्यो काय मालीक एक जातीह मीस्र देसा माय रेन निवाड़ेन बाहेर काड़ेल, एने ओवतो जा बुरहो नाह मीलेल एता ताह खेतेम किर दियेल। <verse eid="JUD 1:5" /><verse number="6" style="v" sid="JUD 1:6" />जा हेरोगदुत तान पोदाह होमालीन नाह मेल्या एने तान जो जागो ईतो ताह बी सोड़ देना, तो ताह बी नियाव ने दिह्यान केरता आदारा माय, जो जेलेमक्या कालान केरता हे, बांदिन मीलेल हे। <verse eid="JUD 1:6" /><verse number="7" style="v" sid="JUD 1:7" />तान गेतुस सदोम एने अमोरा एने तान आहने पाहनेन गावे, जा न्यान गेत सिनाल्या बोण जायेल एता एने पारका सेरीरान पासाण लाग जायेल एता, आक्‍ठान जेलेमक्यो डेंडा माय देरीन किस्सो ठेरायेल हेते।<verse eid="JUD 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JUD 1:8" />तिहेस केरीन ज्या होपनो देखणारे बी तान तान सेरीराह एठो केरतेह, एने बोगवानान आदिकाराह खाराब जाणतेह, एने उचा पोदवालाह हाजो बाकतो केती रेतेह। <verse eid="JUD 1:8" /><verse number="9" style="v" sid="JUD 1:9" /><note caller="+" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="REV 12:7">प्रकाशितवाक्य 12:7</ref></char></note>पुण मुखी हेरोगदुत मीखायेल, जेवी सैतान मुसान देड़ान बाराम बोलचाल किऱ्यो, ते ताह हाजो बाकतो केयीन आरोप नाह लागाड्यो पुण ज्यो कियेल, “मालीक तुवाह दोपकावी।” <verse eid="JUD 1:9" /><verse number="10" style="v" sid="JUD 1:10" />पुण ज्या माणहे नाह सोमेजते ओहल्यु वातुह हाजो बाकतो केतेह, एने ती वातुह विणएकल्या जेनवेरान गेत सोबाव मायच जाणतेह, एने ता माय सोताह खेतेम केरतेह। <verse eid="JUD 1:10" /><verse number="11" style="v" sid="JUD 1:11" />ता पोर हाय! काहाकाय ता केनान गेत चाल चालना, एने बिलाम ने गेत मोंजरीन केरता खाराब एय गीयाह, एने विरोद केरीन कोरह ने गेत खेतेम एय गीयाह। <verse eid="JUD 1:11" /><verse number="12" style="v" sid="JUD 1:12" />ता तुमरा मोंगान सबा माय तुमरी हेऱ्या खाता पिता, देरीया माय लिकायेल देगड़ान गेत हेते, एने बिंदास तान पेटाह बोरनारे राखवाल्या हेते; ता वारा माय उड़ीन आयेल ठाल्ला वादला हेते, ता उनालान विण फोल्या जाड़े हेते, जा दुय वार मोर जायेल हेते; एने मुला बेलुच उखील जायेल हेते। <verse eid="JUD 1:12" /><verse number="13" style="v" sid="JUD 1:13" />ज्या देरीयान मोटला जेलखा हेते, जाह लाज आवीह केरीन उसेलतेह; डावाडोल तारे हेते, ज्यानकेरता कायेम ने केरता मोटलो आंदारो मेल रेनोह।<verse eid="JUD 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JUD 1:14" />
    <note caller="+" style="f">
      <char style="fr" closed="false">1:14 </char>
      <char style="ft" closed="false">हातवो; आदम एने हनोक ने नाव माय; पेल एने आखरी नावान समावेश केरतेह।</char>
    </note>हनोक बी जो आदमाह रेन हातवी पिढी माय ईतो, न्यान बाराम इहकेरीन जाणाव किरेल, “मालीक तान लाखो चोखाला हेऱ्यो आवो। <verse eid="JUD 1:14" /><verse number="15" style="v" sid="JUD 1:15" />काय आखान नियाव केरी, एने आखा विणबोकत्या तान विणबोक्तीन आखा कामान बाराम जा ता विणबोक्ती माय किरेल हेते, एने ता आखा केड़ेक वातुन बाराम जा विणबोक्ती पापी तान विरोद कियेल हे, आरापी ठेरावी।” <verse eid="JUD 1:15" /><verse number="16" style="v" sid="JUD 1:16" />ज्या ते असंतुष्ट कुड़कुड़ावणारे, एने ताह जो पुटीह तो केरनारे हेते, एने सोतान मुया केरीन गोमेंड ने वातु बोलतेह, एने तान फायदान केरता मुय देखीन बोड़ाय केऱ्या केरतेह।<verse eid="JUD 1:16" /></para>
  <para style="s">चेतावणी एने हिकवोण</para>
  <para style="p">
    <verse number="17" style="v" sid="JUD 1:17" />पुण एय मोंगाल्ला, ती वातुह तुमू एर मीलो जा आमरा मालीक यीशु मसीन प्रेरित पेलुच केय दियेल हेते। <verse eid="JUD 1:17" /><verse number="18" style="v" sid="JUD 1:18" /><note caller="+" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="2PE 3:3">2 पतरस 3:3</ref></char></note>ता तुमूह कियेल एता, सेवल्या काला माय ठेट्ठा केरनारे आवती जा तान विणबोक्तीन खाराब मोरजीन गेत चालती। <verse eid="JUD 1:18" /><verse number="19" style="v" sid="JUD 1:19" />ज्या ता हेते जा फुट पाड़तेह; ज्या सारिरीक माणहे हेते, न्या माय जीव नाह। <verse eid="JUD 1:19" /><verse number="20" style="v" sid="JUD 1:20" />पुण एय मोंगाल्ला, तुमरा चोखाला बोरहा माय तुमू वोड़ती केरतीन एने चोखाला जीवा माय विन्ता केरतीन, <verse eid="JUD 1:20" /><verse number="21" style="v" sid="JUD 1:21" />सोताह बोगवानान मोंग माय बोणावीन मीलो; एने जेलेमक्यो जीवाय ने केरता आमरा यीशु मसीन गीणान वाट जोवते रिवो। <verse eid="JUD 1:21" /><verse number="22" style="v" sid="JUD 1:22" />ता पोर जा सेंका माय हेते गीण किरो; <verse eid="JUD 1:22" /><verse number="23" style="v" sid="JUD 1:23" />एने मोकतास माणहाह नेरगान आक्‍ठाम रेन निकालो; एने मोकतास माणहाह पोर बिय हेऱ्या गीण किरो, पुण ता फाड़काह बी नफरत किरो जो सेरीरान उगे रेन ढागावाला एय जायेल हे।<verse eid="JUD 1:23" /></para>
  <para style="s">बोरकेतवालो वचन</para>
  <para style="p">
    <verse number="24" style="v" sid="JUD 1:24" />एवी जो तुमूह ठोकेर खाणे से वोचाड़ सिकेह, एने तान बोड़ाय ने बोरपुरीन सामने खुसी एने निर्दोस केरीन उबो केर सिकेह, <verse eid="JUD 1:24" /><verse number="25" style="v" sid="JUD 1:25" />ओहला आपणा सुटकारो केरनारा बोगवानाह, यीशु मसी आपणो मालीक ज्यान द्‍वारे बोड़ाय, महत्व, ताकेत एने आदिकार दुनियान पेल, एवी बी एय एने कायेम ने कायेम रेय। आमेन।<verse eid="JUD 1:25" /></para>
  <chapter eid="JUD 1" />
</usx>