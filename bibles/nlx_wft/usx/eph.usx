<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EPH" style="id">- Nahali</book>
  <para style="h">इफिसीयो</para>
  <para style="toc3">इफिसीयो</para>
  <para style="toc2">इफिसीयो</para>
  <para style="toc1">इफिसीयो पौलुस लिखेल पोत्रो</para>
  <para style="mt2">इफिसीयो पौलुस ने लिखा हुआ पत्र</para>
  <para style="mt1">इफिसीयो पौलुस लिखेल पोत्रो</para>
  <para style="imt">ओलखात</para>
  <para style="ip">मसीन जेल्मान 60 वोरह्यान पेल ज्यी इफिसीयोन पोत्री कुलीसियोन पोत्री हेऱ्यी एकठी लेखाय जायेल हे। प्रेरित पौलुस ज्यी ओलखात आपेह काय तोस पोत्रीह लेखणार हे। <char style="xt"><ref loc="EPH 1:1">1:1</ref></char></para>
  <para style="ip">कुलीसियोन पोत्रीन गेत ज्यी पोत्री माय बी होवटोह ते पोंडीतान ज्यो मान्नो हे काय पौलुस ज्यी पोत्रीह लिख्यो एय तानकेरता ईलाकान आलेग आलेग मोंडली माय ज्यी पोत्री फिरावीन वाचाय जाय इहकेरीन पौलुसान इरादो एय सिकेह, जेवी तो ज्यी पोत्रीह लिखेल तेवी पौलुस किथे काय तो जेली माय ईतो। <char style="xt"><ref loc="EPH 3:1">3:1</ref>; <ref loc="EPH 4:1">4:1</ref>; <ref loc="EPH 6:20">6:20</ref></char> जेवी तुखीकुस इफिसीयोन मोंडलीह मिलने इफिसुस जाणे बाजरियेल ईतो तेवी पौलुस ज्यो पोत्रो तान आथाम लेन मोकलेल। <char style="xt"><ref loc="EPH 6:21-22">6:21-22</ref></char></para>
  <para style="ip">इफिसीयो जुलूम मोठो हियोर ईतो ती नेम माय आसीया खेड़ान ती राजदानी एती हेयरा माय अरतीमीस नावान ग्रीक देवतान मोटलो नाव गाजेल मोंदिर एतो ता माय ताह जुलूम नाव लायेल एती <char style="xt"><ref loc="ACT 19:23-31">प्रेरितान काम 19:23-31</ref></char> ज्यो इफिसुस वाली मोंडलीन सुरवात मोजबुत रिती से ईयेल पुण पासाण ती कोमजोर देखाताली। <char style="xt"><ref loc="REV 2:1-7">प्रकाशितवाक्य 2:1-7</ref></char> बोगवान तान माणहाह निवाड़ेन यीशु मसीन द्‍वारे किहीक तान पापा माय रेन सोड़ायेल ज्यी वात पौलुस पोत्रीन पेल्ला ईसा माय साप देखाड़ेह तो मोंडलीन तुलना ता सेरीरा हिऱ्यो किरेह जान मुंड मसी हे एने ती आवाली हिऱ्यो किरेह जीन कोपरान दिगोड़ मसी हे पुस्तेकान दिहरा ईसा माय पौलुस मसी जीवाय किहीक जीवणे जुवे तान बाराम लिखेल हे।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. पौलुस सोता ओलखात आपीन इफिसीयोह नमस्‍कार किथे। <char style="ior"><ref loc="EPH 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. बाद माय तो मोंडलीन नातो कोहलो रेणे जुवे तो साप देखाड़ेह। <char style="ior"><ref loc="EPH 1:3-3:21">1:3–3:21</ref></char></para>
  <para style="io1">3. बाद माय पौलुस मसी किहीक जीवणे जुवे ज्यान वाट देखाड़ेह। <char style="ior"><ref loc="EPH 4:1-6:20">4:1–6:20</ref></char></para>
  <para style="io1">4. पौलुस आखरी सोबदो लेखीन खेतेम किरेह। <char style="ior"><ref loc="EPH 6:21-24">6:21-24</ref></char></para>
  <chapter number="1" style="c" sid="EPH 1" />
  <para style="s">नमस्‍कार</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:19-21">प्रेरितान काम 18:19-21</ref>; <ref loc="ACT 19:1">19:1</ref></char>
    </note>पौलुसान उगे रेन जो बोगवानान मोरजी माय मसी यीशुन प्रेरित हे, <note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">थोड़ाक लेख माय इफिसुस न्या नाह लिखेल सोतो</char></note>इफिसुस माय बोगवानान माणहाह, जा मसी यीशु हेऱ्या तान जीवन माय बुरहो केरनारे हेते।<verse eid="EPH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EPH 1:2" />आमरो आबोख बोगवान एने मालीक यीशु मसीन उगे रेन तुमूह गीण एने सान्ती जुड़ते रेय।<verse eid="EPH 1:2" /></para>
  <para style="s">मसी यीशु माय आत्मिक बोरकेत</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3" />आमरा मालीक यीशु मसीन बोगवान एने आबाख ने दन्यवाद एय काय तो आमुह मसीन द्‍वारा आखी बातीन हेरगावाल्यु आत्मिक बोरकेत आपेल हे। <verse eid="EPH 1:3" /><verse number="4" style="v" sid="EPH 1:4" />जिहकेरीन तो आमुह केल बोणनेन पेल ता माय निवाड़ लियेल हे! काय आमु तान आहने मोंग माय चोखाला एने निर्दोस रेय। <verse eid="EPH 1:4" /><verse number="5" style="v" sid="EPH 1:5" />एने तान मोरजीन हाजी योजनान गेत आमुह तान केरता पेलुस रेन ठेरायेल हे काय यीशु मसीन द्‍वारा आपु बोगवानान गोद लियेल सोरा एने सोर्‍यु एय। <verse eid="EPH 1:5" /><verse number="6" style="v" sid="EPH 1:6" />बोगवानान बोड़ायीन गीण ने स्तुती एय, काहाकाय जीह तो तान मोंगाल्ला सोरान द्‍वारे आमुह फुकेट आपेल हे। <verse eid="EPH 1:6" /><verse number="7" style="v" sid="EPH 1:7" /><note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="COL 1:14">कुलीसियो 1:14</ref></char></note><note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false">तान ओंगाण, तान मोंग ने कारेण बोगवान; नाहते तान ओंगाण, एने मोंग माय जीवणेन केरता, बोगवान।</char></note>आमुह मसी माय तान लुयीन द्‍वारे सुटकारो, मतलब पापान माफी, बोगवानान ती गीण ने देनान गेत जुड़ेल हे। <verse eid="EPH 1:7" /><verse number="8" style="v" sid="EPH 1:8" />जीह तो तान इकेल एने सोमेज ने वापेर केरीन आमु पोर मोकतोस किरेल। <verse eid="EPH 1:8" /><verse number="9" style="v" sid="EPH 1:9" />काहाकाय बोगवान तान मोरजीन मालमात, तान हाजा उद्देशान गेत देखाड़ेल हे, जो तो खुद मसी माय स्थापित किरेल ईतो। <verse eid="EPH 1:9" /><verse number="10" style="v" sid="EPH 1:10" />बोगवानान जी योजना एती काय ठिक टेम आवणे बुखेत हेरगान एने देरतीन आख्‍यु चिजीह टुलो केरी काय मसी तान आदिकारी एय।<verse eid="EPH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 1:11" />मसी माय आमु पेलुस बोगवानान माणहे केरीन तान योजनान गेत निवड़ायेल ठेराय गीया, जो आखी वातु तान मोरजीन गेत केरने, <verse eid="EPH 1:11" /><verse number="12" style="v" sid="EPH 1:12" />एने जा मसी पोर आमु पेलुस आसा मीलेल एता, काय आमु तान बोड़ायीन स्तुती केरी।<verse eid="EPH 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EPH 1:13" />जेवी तुमू खेरलो पारचार होमल्या एने ती हाजाली खोबरी केरीन तुमरो सुटकारो एनो, एने तुमू बी बोगवानान माणहे बोण गीया। एने चोखालो जीव जो वायदो किरेल ताह आपणेन द्‍वारा बोगवान तुमरे पोर सिक्को लागाड़ेल हे एने तुमू मसी पोर बुरहो केऱ्या। <verse eid="EPH 1:13" /><verse number="14" style="v" sid="EPH 1:14" />तो जीव आपणा उत्तर आदिकारीन बाग ने जामीन ने रूप माय ताह वोर आपाय जायेल हे, जाह वोर काय तो आपुह पुरी रिती से सुटकारो नाह आपेत। तान बोड़ाय एने स्तुती एय!<verse eid="EPH 1:14" /></para>
  <para style="s">पौलुसान विन्ता</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15" />ज्यो कारेण हे काय मी बी मालीक मसी यीशु माय तुमरो बुरहो एने चोखाला माणहान केरता तुमरा मोंग ने बाराम होमलीन, <verse eid="EPH 1:15" /><verse number="16" style="v" sid="EPH 1:16" />मी तुमरी केरता बोगवानाह दन्यवाद केरने सोड़ेत नाह, एने मारी विन्ता माय तुमूह एर केऱ्या केरथु। <verse eid="EPH 1:16" /><verse number="17" style="v" sid="EPH 1:17" />काय आमरा मालीक यीशु मसीन बोगवान एने बोड़ायीन आबोख हे, तुमूह इकेल एने बुद्दीन जीव आपी काय तुमू ताह हास केरीन जाण सिकहो। <verse eid="EPH 1:17" /><verse number="18" style="v" sid="EPH 1:18" />एने तुमरा मोनान डोलान उजाला केरीन तुमू जाण जावो काय तान हादावणीन आसा काय हे, एने चोखाला माणहा माय तान मिरास ने बोड़ायीन देन कोहलो हे। <verse eid="EPH 1:18" /><verse number="19" style="v" sid="EPH 1:19" />एने तान ताकेत आमरी उगे जा बुरहो केरतेह, कोलीक हे, तान सेक्तीन प्रबाव ने ता कामान गेत हे, <verse eid="EPH 1:19" /><verse number="20" style="v" sid="EPH 1:20" />बोगवान जो मसीन बाराम किरेल, काय ताह मुरेल माय रेन जिवाड़ेन हेरगा माय तान जीवड़े उगे बोहाड्यो। <verse eid="EPH 1:20" /><verse number="21" style="v" sid="EPH 1:21" />आखी बातीन सत्ता, आदिकारी प्रदानता, ताकेत, आदिकार एने एकेक नावान उपेर, ज्या दुनियान ओलोस नाह, पुण आवता कालाम बी लेवाय जाय। <verse eid="EPH 1:21" /><verse number="22" style="v" sid="EPH 1:22" /><note caller="+" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="COL 1:18">कुलीसियो 1:18</ref></char></note>एने आखो काय मसीन पायान बुंदे केर देनो एने ताह आखी चिजी पोर उचो ठेरावीन मोंडलीह आप देनो। <verse eid="EPH 1:22" /><verse number="23" style="v" sid="EPH 1:23" />मोंडली मसीन सेरीर हे, एने तान बोरपुरी हे, जो आखा माय सोब पुरो किरेह।<note caller="+" style="f"><char style="fr" closed="false">1:23 </char><char style="ft" closed="false">जो खुद आखी जागे आख्‍यु वातु पुरो किरेह; नाहते जो खुद बोगवानान परिपुर्णता माय पुरो बोरायेल हे। </char></note><verse eid="EPH 1:23" /></para>
  <chapter eid="EPH 1" />
  <chapter number="2" style="c" sid="EPH 2" />
  <para style="s">मोतीम रेन जीवायी वोर</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:1 </char>
      <char style="xt" closed="false">
        <ref loc="COL 2:13">कुलीसियो 2:13</ref>
      </char>
    </note>एने तो तुमूह बी जिवाड़ेल, जा तुमरा गुनान एने पापान कारेण मुरेल एता। <verse eid="EPH 2:1" /><verse number="2" style="v" sid="EPH 2:2" />एक टेम एतो जेवी तुमू आत्मिक रूप से उकुम नाह माणनारे एने आत्मिक रूप माय मोर जायेल एता; एने ज्या दुनियान खाराब वाटी पोर चालनारे एता, एने जुगान आदिकारी, ता जीवान गेत जीवताला, जो जीव एवी बी उकुम नाह मान्नारा माय काम केरने बाजरिनोह। <verse eid="EPH 2:2" /><verse number="3" style="v" sid="EPH 2:3" />ज्या माय आमु बी आखा पेल सेरीरान मोरजी पुरी केरनेन केरता जीवताला, एने सेरीर एने मोनान मोरजी पुरी केरताला, एने दिहरा माणहान गेत वेवारा माय रेन रागान सीकार एता।<verse eid="EPH 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 2:4" />पुण बोगवान जुलूम गीण केरनार हे, काहाकाय तान महान मोंगा केरीन आमु पोर मोंग किऱ्यो। <verse eid="EPH 2:4" /><verse number="5" style="v" sid="EPH 2:5" />जेवी आमु उकुम नाह मान्नेन कारेण मुरेल एता, तो आमुह मसी माय जीवाय आप्यो। ज्यो बोगवानान गीण ने द्‍वारा तुमूह वोचाड़ेल हे। <verse eid="EPH 2:5" /><verse number="6" style="v" sid="EPH 2:6" />एने आपुह मसी यीशु माय एक एणेन वोजेसे ता हेऱ्यो जीव उठाड्यो, एने हेरगा माय ता हेऱ्यो बोहाड्यो। <verse eid="EPH 2:6" /><verse number="7" style="v" sid="EPH 2:7" />काय तो आवणे वाला टेम माय तान गीणीन मोठाय मसी यीशु माय आमरे केरता किरेल गीण माय देखाड़ सेकी। <verse eid="EPH 2:7" /><verse number="8" style="v" sid="EPH 2:8" />काहाकाय बोरहान द्‍वारे गीण केरीस ने तुमूह सुटकारो जुड़ेल हे, एने ज्यो तुमरी उगे रेन नाह, पुण बोगवानान दान हे; <verse eid="EPH 2:8" /><verse number="9" style="v" sid="EPH 2:9" />एने नाह कामान कारेण, ओहलो नाय एय काय कुण बी मोठाय केरी। <verse eid="EPH 2:9" /><verse number="10" style="v" sid="EPH 2:10" />काहाकाय आमु बोगवानान बाणायेल हेते, एने मसी यीशु माय ता हाजा कामान केरता बोणेल हेते, जाह बोगवान पेलुस आमुह केरनेन केरता तियार किरेल हे।<verse eid="EPH 2:10" /></para>
  <para style="s">मसी माय एक</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11" />तुमू जा पायदासीस बिगेर यहुदि हेते एने खेतान केरायेल यहुदिन द्‍वारा केवाय जातेह, जा आपणे आप खेतना केरायेल केवाहतेह तुमरा पोसली जीवायीह एर मीलो। <verse eid="EPH 2:11" /><verse number="12" style="v" sid="EPH 2:12" />ईर किरो तुमू तुलबूखे दुनियाम मसी रेन आलेग, एने इस्राएलान पोरजान पोदा रेन आंगे केरायेल, एने वायदान वाचान बागी नाह एता, एने बिगेर आसान एने दुनिया माय बिगेर बोगवानान एता। <verse eid="EPH 2:12" /><verse number="13" style="v" sid="EPH 2:13" />पुण एवी मसी यीशु माय तुमू जा पेल सेटा एता, <note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false">मसीन लुय केरीन, नाहते खुद मसीन अर्पण किरेल मोत केरीन।</char></note>मसीन लुयी केरीन आहने एय गीयाह। <verse eid="EPH 2:13" /><verse number="14" style="v" sid="EPH 2:14" />काहाकाय तीस आमरी सान्ती हे, जी यहुदि एने बिगेर यहुदिह एक केर देनी एने आंगे केरनार जो बितड़ो विची माय एतो, तोड़ देनो। <verse eid="EPH 2:14" /><verse number="15" style="v" sid="EPH 2:15" /><note caller="+" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="COL 2:14">कुलीसियो 2:14</ref></char></note>एने आपणा सेरीर माय खाराब मतलब तो नेम जान उकुम विदीन रिती पोर एती, मीटाड़ देनो काय दुयूह ता माय एक नोवालो माणुह बाणावीन तान विचीम मीलावे। <verse eid="EPH 2:15" /><verse number="16" style="v" sid="EPH 2:16" /><note caller="+" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="COL 1:20">कुलीसियो 1:20</ref></char></note>एने मसीन खुरूसखाम पोर मोतीन कारेण बेदबावाह खेतेम केरीन दुयूह एक सेरीर बाणावीन बोगवाना हेऱ्यो मीलाव दिनो। <verse eid="EPH 2:16" /><verse number="17" style="v" sid="EPH 2:17" />एने तो आवीन तुमू जा बिगेर यहुदि सेटा एता, एने यहुदि जा आहने एता, दुयूह सान्तीन मीलापान हाजाली खुबेर होमलाव्यो। <verse eid="EPH 2:17" /><verse number="18" style="v" sid="EPH 2:18" />काहाकाय यीशुन द्‍वारे आपु दुयून एक जीव एन आबाख फाय पुचीह।<verse eid="EPH 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19" />तानकेरता तुमू बिगेर यहुदि परदेसी एने एंजाणल्या नाह रेना, पुण बोगवानान माणहा हेऱ्या बोगवानान गेराणान एय गीयाह। <verse eid="EPH 2:19" /><verse number="20" style="v" sid="EPH 2:20" /><note caller="+" style="f"><char style="fr" closed="false">2:20 </char><char style="ft" closed="false">जाणकार एने प्रेरित टाकेल पायो; नाहते तो पायो, मतलब जाणकार एने प्रेरित।</char></note>ताह बाणावणो प्रेरित एने जाणकारान द्‍वारे मीलेल पाया पोर, जान आदार खुद मसी यीशु हे। <verse eid="EPH 2:20" /><verse number="21" style="v" sid="EPH 2:21" />आखी आवाली तान द्‍वारे जोड़ाय गियी एने मालीक माय चोखाली मोंदिर एणेन केरता वोदेह। <verse eid="EPH 2:21" /><verse number="22" style="v" sid="EPH 2:22" />मालीक माय एक एणेन वोजेसे तुमू बी जीवान द्‍वारे बोगवानान रेणेन जागो बोणनेन केरता एकठो बोणती जाथे।<verse eid="EPH 2:22" /></para>
  <chapter eid="EPH 2" />
  <chapter number="3" style="c" sid="EPH 3" />
  <para style="s">बिगेर यहुदि माय पौलुसान सेवा</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1" />ज्‍यीस कारेण मी पौलुस जो तुमू बिगेर यहुदिन केरता मसी यीशुन बोंदी हे, बोगवाना से विन्ता केरथु। <verse eid="EPH 3:1" /><verse number="2" style="v" sid="EPH 3:2" />खेरीच तुमू ज्यो होमलेल एती काय बोगवानान तान गीणीन द्‍वारा माहु ज्यो काम आपेल हे जो माहु तुमरे हाजान केरता आपायेल एतो। <verse eid="EPH 3:2" /><verse number="3" style="v" sid="EPH 3:3" />जिहकेरीन माहु उजालान द्‍वारे खेरलान मालमात जाणीव केरीन आपेल एतो, मी तो पेल थोड़ाक माय लिखेल ईतो। <verse eid="EPH 3:3" /><verse number="4" style="v" sid="EPH 3:4" /><note caller="+" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="COL 1:26">कुलीसियो 1:26</ref>,<ref loc="COL 1:27">27</ref></char></note>जेवी तुमू ताह वाचहो, तेवी मसीन खेरला मालमातान बाराम मी किहीक सोमेजथु तुमू जाणहो। <verse eid="EPH 3:4" /><verse number="5" style="v" sid="EPH 3:5" />तो गीया टेमा माय माणहान सोराह ओहलो नाह कियेल ईतो, जिहकेरीन काय जीवान द्‍वारे एवी तान चोखाला प्रेरिताह एने जाणकारा पोर देखाड़ेल हे। <verse eid="EPH 3:5" /><verse number="6" style="v" sid="EPH 3:6" />मतलब ज्यो काय मसी यीशु माय हाजाली खोबरीन द्‍वारे बिगेर यहुदि माणहे विरासत माय बागी, एने एकुस सेरीरान एने वायदान बागी हेते।<verse eid="EPH 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 3:7" />मी बोगवानान ती गीणीन गेत, जो तान ताकेतीन प्रबावान गेत माहु आपाय गीयो, ती हाजाली खोबरीन पावोर बोणनो। <verse eid="EPH 3:7" /><verse number="8" style="v" sid="EPH 3:8" />माहु पोर जो आखा चोखाला माणहा माय रेन आत्याम रेन बी आत्यो हे, ज्यी गीण आप्यो काय मी बिगेर यहुदिह मसीन जेलेमकी देनान हाजाली खुबेर होमलावु। <verse eid="EPH 3:8" /><verse number="9" style="v" sid="EPH 3:9" />एने आखाह ज्यी वात देखाडु काय तो मालमातान प्रबन्द काय हे, जो आखाह बाणावणार बोगवान माय सुरवात रेन लिकायेल हे। <verse eid="EPH 3:9" /><verse number="10" style="v" sid="EPH 3:10" />काय एवी मोंडलीन द्‍वारे बोगवानान बाती बातीन इकेल, ता मुखी एने आदिकारी पोर, जो हेरगा माय हे देखाड़ी। <verse eid="EPH 3:10" /><verse number="11" style="v" sid="EPH 3:11" />ज्यो तो जेलेमक्या उद्देशान गेत एनो, तो आमरा मालीक मसी यीशु माय किरेल ईतो। <verse eid="EPH 3:11" /><verse number="12" style="v" sid="EPH 3:12" />मसी माय एक एणेन नाते एने ता पोर बुरहो केरने से आमुह दिलासो एने बोरहाम आहने आवणेन आदिकार जुड़नो। <verse eid="EPH 3:12" /><verse number="13" style="v" sid="EPH 3:13" />तानकेरता मी विन्ता केरथु काय जो दुख तुमरे केरता माहु एणे बाजरिनोह, ईमोत मा सोड़ो; काहाकाय ता माय तुमरो फायदो हे।<verse eid="EPH 3:13" /></para>
  <para style="s">मसीन मोंग</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14" />ज्यास ने वोजेसे मी आबाख ने ओंगाण गुटण्या टेकथु। <verse eid="EPH 3:14" /><verse number="15" style="v" sid="EPH 3:15" />जा माय हेरोग एने देरती पोर, आखा गेराणान नाव मेलाय जाथे, <verse eid="EPH 3:15" /><verse number="16" style="v" sid="EPH 3:16" />मी विन्ता केरथु काय ती बोड़ायीन ताकेत आपी एने तान देनान गेत तान जीवान द्‍वारा तुमरे माय व्यक्तित्वाह मोजबुत केरी, <verse eid="EPH 3:16" /><verse number="17" style="v" sid="EPH 3:17" />एने बोरहान द्‍वारे मसी तुमरा मोना माय बोही काय तुमू मोंग माय मोजबुत एने पाको एन, <verse eid="EPH 3:17" /><verse number="18" style="v" sid="EPH 3:18" />तुमू आखा चोखाला बोगवानान माणहा हेऱ्या मसीन मोंगान लाम्बाय, चोवड़ाय, उचाय एने उंडाय सोमेज सीको। <verse eid="EPH 3:18" /><verse number="19" style="v" sid="EPH 3:19" />एने मसीन तो मोंग जाण सीको, जो एकलीह रेन बाहेर हे काय तुमू बोगवानान सोबाव से पुरा एय जावो।<verse eid="EPH 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20" />एवी ता बोगवानान केरता जी तान ती ताकेत से जी आमु माय काम किरेह, जोलोक आमु मांग सेकतेह एने जोलोक सोच सेकतेह ताह रेन जुलूम वोदार केर सिकेह। <verse eid="EPH 3:20" /><verse number="21" style="v" sid="EPH 3:21" />ती मोंडली माय एने मसी यीशु माय बोगवानान बोड़ाय पिढीन पिढी वोर जेलेम एते रेय। आमेन।<verse eid="EPH 3:21" /></para>
  <chapter eid="EPH 3" />
  <chapter number="4" style="c" sid="EPH 4" />
  <para style="s">मसीन सेरीरान एकता</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1" />तानकेरता मी जो मालीक यीशुन केरता बोंदी हे, तुमूह विन्ता केरथु काय बोगवाना फाय रेन जीहे हादावणी ईयेल हे, ताह होबे ओहला जीवो। <verse eid="EPH 4:1" /><verse number="2" style="v" sid="EPH 4:2" /><note caller="+" style="x"><char style="xo" closed="false">4:2 </char><char style="xt" closed="false"><ref loc="COL 3:12">कुलीसियो 3:12</ref>,<ref loc="COL 3:13">13</ref></char></note>आखी दीनता एने गेरबोड़ाय माय दिर देरीन आपसाम मोंगा माय एका दिहरान वेठ लिवो। <verse eid="EPH 4:2" /><verse number="3" style="v" sid="EPH 4:3" />एने ती सान्ती जी तुमूह आपसाम बांदिह ता से पायदा ईयेल जीवान एकता बाणावीन मेलनेन केरता एकेक टेमा माय कोसीत किरो। <verse eid="EPH 4:3" /><verse number="4" style="v" sid="EPH 4:4" />एक सेरीर एने एकुस जीव हे; ठिक इहीचकेरीन केरीन ती आसा बी एकुस हे, जा माय तुमू हादाड़ाय गीया। <verse eid="EPH 4:4" /><verse number="5" style="v" sid="EPH 4:5" />एकुस मालीक हे, एकुस बुरहो, एकुस बपतीस्मा, <verse eid="EPH 4:5" /><verse number="6" style="v" sid="EPH 4:6" />एकुस बोगवान हे जो आखान आबोख हे, जो आखान मालीक हे, जो आखा माय काम किरेह, एने जो आखा माय हे। <verse eid="EPH 4:6" /><verse number="7" style="v" sid="EPH 4:7" />पुण आमु माय रेन एकेकाह मसीन दान तान मोज मापान गेत गीण जुड़ेल हे। <verse eid="EPH 4:7" /><verse number="8" style="v" sid="EPH 4:8" />वचन इही किथे:</para>
  <para style="q1" vid="EPH 4:8">“जेवी तो उचेच जागे चेड़नो,</para>
  <para style="q2" vid="EPH 4:8">तेवी बोंदीह बांदिन ली गीयो,</para>
  <para style="q2" vid="EPH 4:8">एने माणहाह दान आप्यो।”<verse eid="EPH 4:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="EPH 4:9" />एवी, “तो उपेर चेड़नो” ज्यान मतलब काय हे? ज्यान मतलब ज्यो हे काय तो पेल देरतीन आखान नेचली जागे उतेरनो।<note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="ft" closed="false">देरतीन आखान निचले जागा माय; नाहते देरतीन निचले बाग माय।</char></note> <verse eid="EPH 4:9" /><verse number="10" style="v" sid="EPH 4:10" />एने जो नेचो उतेर गीयो तोस ज्यो हे, जो आखा जुगाह रेन उपेर चेड़ बी गीयो काय आखो पुरो केरी। <verse eid="EPH 4:10" /><verse number="11" style="v" sid="EPH 4:11" />एने तो थोड़ाक प्रेरित, जाणकार, हाजाली खुबेर होमलाड़नारे, पासटर एने मास्तेर्‍या नियुक्त केरीन आप दिनो। <verse eid="EPH 4:11" /><verse number="12" style="v" sid="EPH 4:12" />जाकेरीन आखा बोगवानान माणहे पाका बोण जाय एने सेवान काम केराय जाय, एने मसीन सेरीर वोदते जाय, <verse eid="EPH 4:12" /><verse number="13" style="v" sid="EPH 4:13" />जाह वोर काय आपु आखान बुरहो एने बुद्दी बोगवानान बेटाख ने ओलखात माय एक नाय एय जाय, एने एक पाको माणुह बोण जाय एने मसीन आखी बोड़ायीन उचायीह सापेल नाय लेय। <verse eid="EPH 4:13" /><verse number="14" style="v" sid="EPH 4:14" />ज्यानकेरता काय आपु ओंगाण सोरान गेत नाय रेय, जो देरीयान लाटान गेत जी उगे ती उगे उसेलने फिरवाय जाणे, एने माणहान ठेग विद्यान वादोण एने माणहान चेतराय ने द्‍वारे वोयते जाथे। <verse eid="EPH 4:14" /><verse number="15" style="v" sid="EPH 4:15" />पुण मोंगा माय खेरी बोली एने आखी वातुम ता माय जो मुंड हे, मतलब आखी बातीन मसी माय वोदते जावो। <verse eid="EPH 4:15" /><verse number="16" style="v" sid="EPH 4:16" /><note caller="+" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="COL 2:19">कुलीसियो 2:19</ref></char></note>जान द्‍वारे बुरहो केरनारान आखो सेरीर मिलाय रेणे, एने तो एकठो बांदिल रेणे, एने एकेक बाग तो जीहे केरने हुदेह तिहे तो किरेह, आपणी बाणावोट मोंगा माय एणेन केरता पुरा सेरीर माय वोड़ती एणे।<verse eid="EPH 4:16" /></para>
  <para style="s">मसी माय नोवाली जीवाय</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17" />तानकेरता मी मालीकान नावा माय चेतावणी आपथु काय जिहकेरीन बिगेर यहुदिन माणहे तान मोनान व्यर्थ विचार माय जीवतेह, तुमू एवी रेन इहकेरीन मा चालो। <verse eid="EPH 4:17" /><verse number="18" style="v" sid="EPH 4:18" />काहाकाय तान इकेल आदारा माय जात रियेल हे, एने मोनान कोपेट एने बिगेर एकलीवाला कोपेट एने बिगेर एकलीन वोजेसे एने बोगवानान जीवायीह रेन ता आंगे एय रेनाह। <verse eid="EPH 4:18" /><verse number="19" style="v" sid="EPH 4:19" />एने ता माय रेन लाज जात रियेल हे; एने ता सोताह खाराब काम केरनेम लागाड़ देनाह, काल्ली बी वात नाह मानेन आखी बातीन खाराब कामा माय लाग रेनाह।<verse eid="EPH 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 4:20" />मसीन बाराम ओहली हिकवोण तुमूह नाह आपेल ईतो। <verse eid="EPH 4:20" /><verse number="21" style="v" sid="EPH 4:21" />केदी तुमू तान बाराम होमलेल एने तान हिकवोणाह स्वीकार किरेल हेते, जो मसी यीशु माय खेरलो हे। <verse eid="EPH 4:21" /><verse number="22" style="v" sid="EPH 4:22" /><note caller="+" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="COL 3:9">कुलीसियो 3:9</ref></char></note>केरीन तुमू तुमरा बोलना चालनान जुनाला माणहाह, जो कोपेट ने खाराब लालसान गेत खेतेम ईती जाथे, उतार दिवो। <verse eid="EPH 4:22" /><verse number="23" style="v" sid="EPH 4:23" />तुमरो सोचणेन एने सेवा केरनेन बोदेलने जुवे। <verse eid="EPH 4:23" /><verse number="24" style="v" sid="EPH 4:24" /><note caller="+" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="COL 3:10">कुलीसियो 3:10</ref></char></note>एने नोवाला माणहाह पिर लिवो, जो बोगवानान गेत खेरायीन न्यायीपण, एने चोखाली जीवाय माय बोणाय गीयोह।<verse eid="EPH 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25" />तानकेरता जुठ बोलनेन सोड़ीन एकेक माणुह तान आहेंल्या हेऱ्या खेरलो बोली, काहाकाय आमु आखा मसीन सेरीरान अंग हेते। <verse eid="EPH 4:25" /><verse number="26" style="v" sid="EPH 4:26" />राग ते किरो, पुण पाप मा किरो, दिह बुड़नेन पेल तुमरो राग ओलाय जाय। <verse eid="EPH 4:26" /><verse number="27" style="v" sid="EPH 4:27" />एने सैतानाह टेम मा आपो, <verse eid="EPH 4:27" /><verse number="28" style="v" sid="EPH 4:28" />जो माणुह पेल चोरी केऱ्या केरतालो, तो पोशो चोरी नाय केरी, पुण हाजा काम केरनेन केरता मेहनेत केरी, ज्यानकेरता काय जा माणहाह गिरेज पुड़ेह ताह आपणेन केरता ता फाय जुलूम काय रेय। <verse eid="EPH 4:28" /><verse number="29" style="v" sid="EPH 4:29" />तुमरा मुयाम रेन हानिकारक खाराब वात नाय निकले, पुण जो हाजो रेय जी हाजी हे, एने आखान फायदान केरता एय, काय होमेलनारान जीवणाम गीण लावी। <verse eid="EPH 4:29" /><verse number="30" style="v" sid="EPH 4:30" />तुमू बोगवानान चोखाला जीवाह दुख मा पोचाड़ो; काहाकाय तास ने द्‍वारा तुमू पोर सुटकारान दिह्यान केरता साप लागाड़ेल हे। <verse eid="EPH 4:30" /><verse number="31" style="v" sid="EPH 4:31" />आखी कड़वाहट, प्रकोप, राग, राड़, खाराब बोलने एने दुख पोचाड़नार वातु एने आखी बातीन खाराबपोणा माय निकाल दिवो। <verse eid="EPH 4:31" /><verse number="32" style="v" sid="EPH 4:32" /><note caller="+" style="x"><char style="xo" closed="false">4:32 </char><char style="xt" closed="false"><ref loc="COL 3:13">कुलीसियो 3:13</ref></char></note>एका दिहरा पोर मोंग एने गीण केरनार बुणो, एने तुमू एका दिहराह माफ केरनारे बुणो, जिहकेरीन बोगवान मसीन वोजेसे तुमूह माफ किरेल हे।<verse eid="EPH 4:32" /></para>
  <chapter eid="EPH 4" />
  <chapter number="5" style="c" sid="EPH 5" />
  <para style="s">उजालाम जीवाय</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1" />तानकेरता तुमू बोगवानान मोंगाल्ला सोरा हेते, तानकेरता बोगवानान गेत बुणो। <verse eid="EPH 5:1" /><verse number="2" style="v" sid="EPH 5:2" />जिहकेरीन मसी आपुह मोंग किऱ्यो, एने आपणे केरता सोताह मोग मोग गेंदाणार आस्त्रान गेत बोगवानान केरता एक बेट एने बोलीन रूप माय चेड़ाव दिनो, तिहेस केरीन मोंग माय जीवाय जीवो।<verse eid="EPH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3" />जिहकेरीन बोगवानान माणहान केरता हाजो हे, तुमरी विचीम सिनालो एने आखी बातीन खाराब कामान एने लोब लालुच ने वातु होमलाणे बी नाय जुवे। <verse eid="EPH 5:3" /><verse number="4" style="v" sid="EPH 5:4" />एने नाह तुमरी विचीम खाराब एने बेवकुफीन वातु एणे जुवे, एने नाह चिहटान, काहाकाय ज्‍यु वातु होबा नाह देत्यु। पुण तुमरा मुया केरीन कायेम बोगवानान दन्यवाद एणे जुवे। <verse eid="EPH 5:4" /><verse number="5" style="v" sid="EPH 5:5" />काहाकाय तुमू ज्यो हास केरीन जाणतेह काय सिनालो केरनारे, एठा एने लोब केरनारे माणहान, जो मुरती पुजान बाराबोर हे, मसी एने बोगवानान राज माय काल्लोस हिस्सेदार नाय मीले।<verse eid="EPH 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 5:6" />कुण बी तुमूह फालतुक वातु माय नाय फासाड़े; काहाकाय ज्‍यीस वातुन वोजेसे बोगवानान राग उकुम नाह माणनारा पोर बोड़केह। <verse eid="EPH 5:6" /><verse number="7" style="v" sid="EPH 5:7" />तानकेरता ओहला माणहा हेऱ्या हिस्सेदार मा बोणहो, <verse eid="EPH 5:7" /><verse number="8" style="v" sid="EPH 5:8" />काहाकाय पेल ते तुमू आदारा माय रेताला, पुण एवी तुमू बोगवाना माय उजालो हेते। केरीन उजालान सोरान गेत जीवाय जीवो, <verse eid="EPH 5:8" /><verse number="9" style="v" sid="EPH 5:9" /><note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="ft" closed="false">उजालो; थोड़ाक लेख माय जीव हे।</char></note>काहाकाय उजालान असर आखी बातीन बोलाय एने न्यायीपण एने खेराय माय हे। <verse eid="EPH 5:9" /><verse number="10" style="v" sid="EPH 5:10" />एने ज्यो पारखो काय बोगवानाह काय पुटीह। <verse eid="EPH 5:10" /><verse number="11" style="v" sid="EPH 5:11" />आदर ने बेकार कामा माय सामील मा ईहो, पुण ताह आखान ओंगाण देखाड़जी। <verse eid="EPH 5:11" /><verse number="12" style="v" sid="EPH 5:12" />काहाकाय त्यु वातुन बाराम ज्युह ता लिकाएन केरतेह, मुया केरीन केणेन बी लाज आवीह। <verse eid="EPH 5:12" /><verse number="13" style="v" sid="EPH 5:13" />जेवी आख्‍यु वातु उजाला माय लावाय जाय तेवी उजाला माय आखो काय देखाय पुड़ेह; <verse eid="EPH 5:13" /><verse number="14" style="v" sid="EPH 5:14" /><note caller="+" style="f"><char style="fr" closed="false">5:14 </char><char style="ft" closed="false">जो हास केरीन देखाथी तो उजालो बुणीह, नाहते तो उजालो ईथे जो हास केरीन देखाड़ीह।</char></note> काहाकाय उजालो आख्‍यु वातु देखाड़ेह पुरी रिती से देखाणार चिज सोता उजालो बोण जाथे। तानकेरता तो किथे,</para>
  <para style="q1" vid="EPH 5:14">“एय हुवणारे, जाग उठो</para>
  <para style="q2" vid="EPH 5:14">एने मुरेल माय रेन जीव जावो,</para>
  <para style="q1" vid="EPH 5:14">ते मसीन उजालो तुमू पोर चोमके।”<verse eid="EPH 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15" />तानकेरीन तुमू किहीक जीवतेह, तान बाराम जोगवीन रिवो। एने फोगा माणहान गेत मा ईहो, पुण एकेल वाला माणहान गेत बुणो। <verse eid="EPH 5:15" /><verse number="16" style="v" sid="EPH 5:16" /><note caller="+" style="x"><char style="xo" closed="false">5:16 </char><char style="xt" closed="false"><ref loc="COL 4:5">कुलीसियो 4:5</ref></char></note>टेमाह हाजा काम केरनेन केरता पुरो वापेर किरो, काहाकाय दिह खाराब हेते। <verse eid="EPH 5:16" /><verse number="17" style="v" sid="EPH 5:17" />एने फोगा मा बुणो, पुण मालीकान मोरजी काय हे, ती सोमजी लिवो।<verse eid="EPH 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EPH 5:18" />दाराह रेन सेटा रिवो, काहाकाय पिणे से जिन्दगी बारबाद एय जाथे; पुण चोखाला जीवा माय बोरपुर ईती जावो। <verse eid="EPH 5:18" /><verse number="19" style="v" sid="EPH 5:19" /><note caller="+" style="x"><char style="xo" closed="false">5:19 </char><char style="xt" closed="false"><ref loc="COL 3:16">कुलीसियो 3:16</ref>,<ref loc="COL 3:17">17</ref></char></note>एने मालीकान केरता आपसा माय पुरा मोना केरीन तुमू बजन, स्तुती गीत एने आत्मिक गीते गाया किरो। <verse eid="EPH 5:19" /><verse number="20" style="v" sid="EPH 5:20" />आमरा मालीक यीशु मसीन नावा माय बोगवान आबाख ने कायेम आखी वातुम दन्यवाद केरती रिवो।<verse eid="EPH 5:20" /></para>
  <para style="s">बायकु एने एदमी</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21" />मसीह बिन एका दिहरान ताबाम रिवो।<verse eid="EPH 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:22 </char>
      <char style="xt" closed="false">
        <ref loc="COL 3:18">कुलीसियो 3:18</ref>; <ref loc="1PE 3:1">1 पतरस 3:1</ref></char>
    </note>एय बायकु, आप आपणा एदम्यान ताबाम ओहल्यु रिवो, जिहकेरीन यीशु मसीन। <verse eid="EPH 5:22" /><verse number="23" style="v" sid="EPH 5:23" />काहाकाय मसी जिहकेरीन मोंडलीन मुंड हे, तिहेस केरीन एदमी बायकुन मुंड हे; एने खुद मसी मोंडलीन सुटकारो केरनार हे, जो तान सेरीर हे। <verse eid="EPH 5:23" /><verse number="24" style="v" sid="EPH 5:24" />जिहकेरीन मोंडली मसीन ताबाम हे, तिहेस केरीन बायकु बी आखी वातु माय एदम्यान ताबाम रेय।<verse eid="EPH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:25 </char>
      <char style="xt" closed="false">
        <ref loc="COL 3:19">कुलीसियो 3:19</ref>; <ref loc="1PE 3:7">1 पतरस 3:7</ref></char>
    </note>एय एदमी, जिहकेरीन मसी मोंडली पोर मोंग केरीन सोताह तान केरता आप दिनो, तिहेस केरीन तुमू तुमरी बायकुह मोंग किरो। <verse eid="EPH 5:25" /><verse number="26" style="v" sid="EPH 5:26" />ताकाय मसी मोंडलीह वचनान द्‍वारा पाण्या से दोवीन चोखो केरीन आमरी गोसणा हेऱ्यो बोगवानाह समर्पित केरी। <verse eid="EPH 5:26" /><verse number="27" style="v" sid="EPH 5:27" />एने तीह एक चोमेकणी मोंडली बोणावीन ता हेऱ्यो उबो केरी, ती माय नाह डाग, चोखो पोणा, निर्दोस, नाह जोरवरी, एने नाह काय कोमी चोखाली एने निर्दोस एय। <verse eid="EPH 5:27" /><verse number="28" style="v" sid="EPH 5:28" />एने इहीचकेरीन एदमी बी तान बायकुह मोंग केरी जिहकेरीन तान सेरीराह मोंग किरेह। जो कुण तान बायकुह मोंग किरेह तो सोताह बी मोंग किरेह। <verse eid="EPH 5:28" /><verse number="29" style="v" sid="EPH 5:29" />(काहाकाय कुण बी सोतान सेरीराह नफरत नाह किरेत, पुण तान हास केरीन पालेन पोषण किरेह जिहकेरीन मसी मोंडलीन किरेह। <verse eid="EPH 5:29" /><verse number="30" style="v" sid="EPH 5:30" />काहाकाय आपु तान सेरीरान आंग हेते।) <verse eid="EPH 5:30" /><verse number="31" style="v" sid="EPH 5:31" />एने जिहकेरीन पुस्तेक माय किथे, “ज्यानकेरता एदमी तान आईख आबाख सोड़ीन तान बायकु हेऱ्यो मिलीन रेय, एने ता दुयू एक सेरीर रेती।” <verse eid="EPH 5:31" /><verse number="32" style="v" sid="EPH 5:32" />ज्यो मालमात ते मोटलो हे, पुण मी ज्यो मसी एने मोंडलीन बाराम केथु। <verse eid="EPH 5:32" /><verse number="33" style="v" sid="EPH 5:33" />पुण तुमरे माय रेन एकेक तान बायकुह मोंग केरने जुवे, जिहकेरीन तो खुद पोर मोंग किरेह, एने बायकु बी तीन एदम्यान मान मेलने जुवे।<verse eid="EPH 5:33" /></para>
  <chapter eid="EPH 5" />
  <chapter number="6" style="c" sid="EPH 6" />
  <para style="s">आहख आबोख एने सोरा</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:1 </char>
      <char style="xt" closed="false">
        <ref loc="COL 3:20">कुलीसियो 3:20</ref>
      </char>
    </note>
    <note caller="+" style="f">
      <char style="fr" closed="false">6:1 </char>
      <char style="ft" closed="false">थोड़ाक लेख माय ज्यो तुमरो मसी माय काम लिखेल हे।</char>
    </note>एय सोरा, मालीक यीशु माय तुमरा आईख आबाख ने वात मानो, काहाकाय ज्यो हाजो हे। <verse eid="EPH 6:1" /><verse number="2" style="v" sid="EPH 6:2" />“तुमरा आईख आबाख ने मान सम्मान किरो,” ज्यो पेल्लो उकुम हे जा हेऱ्यो वायदो बी हे: <verse eid="EPH 6:2" /><verse number="3" style="v" sid="EPH 6:3" />“एने तुमरो बोलो एय एने तुमू देरती पोर जुलूम दिह वोर जीवताला रिहो।”<verse eid="EPH 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 6:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:4 </char>
      <char style="xt" closed="false">
        <ref loc="COL 3:21">कुलीसियो 3:21</ref>
      </char>
    </note>एय आहख आबहेख, तुमू सोराह राग मा लागाड़ो। पुण मालीक यीशुन हिकवोण एने चेतावणी आपतेन तान पालेन पोषण किरो।<verse eid="EPH 6:4" /></para>
  <para style="s">मालीक एने पावोर</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:5 </char>
      <char style="xt" closed="false">
        <ref loc="COL 3:22-25">कुलीसियो 3:22-25</ref>
      </char>
    </note>जा पावोर हेते, ता दुनियान मालीकान उकुम मोनान खेराय माय एने कापतेन मानो; जिहकेरीन मसीन सेवा केरतेह। <verse eid="EPH 6:5" /><verse number="6" style="v" sid="EPH 6:6" />माणहाह खुस केरनारान गेत देखाड़नेन केरता सेवा मा किरो, पुण मसीन पावोरान गेत मोन से बोगवानान मोरजी पोर चालो। <verse eid="EPH 6:6" /><verse number="7" style="v" sid="EPH 6:7" />एने ज्यी सेवा माणहान नाह, पुण मालीकान जाणीन पुरा मोना केरीन किरो। <verse eid="EPH 6:7" /><verse number="8" style="v" sid="EPH 6:8" />एकेक माणुह जो काय हाजो काम किरेह, तो पावोर एने आजाद एय, मालीक फाय रेन ताह फोल जुड़ी।<verse eid="EPH 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:9 </char>
      <char style="xt" closed="false">
        <ref loc="COL 4:1">कुलीसियो 4:1</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="COL 3:25">कुलीसियो 3:25</ref>
      </char>
    </note>एय मालीक तुमू, तुमरा पावराह दोमकी मा दिहो। एने ता हेऱ्या हाजो वेवारो किरो, ज्यो जाणीन काय तुमरो मालीक बोगवान हेरगा माय हे एने तो कुणीन बी बेदबाव नाह केरने।<verse eid="EPH 6:9" /></para>
  <para style="s">आत्मिक लेड़ायीन आथ्‍यार</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10" />ज्यानकेरता, मालीक माय एक एन मोटली ताकेत माय मोजबुत बुणो। <verse eid="EPH 6:10" /><verse number="11" style="v" sid="EPH 6:11" />बोगवानान आखा आथ्‍याराह बांद लिवो, काय तुमू सैतानान योजनान सामने उबरेय सिकहो। <verse eid="EPH 6:11" /><verse number="12" style="v" sid="EPH 6:12" />काहाकाय आपणी लेड़ाय लुय एने माहा हेऱ्यो नाह सोती, पुण हेरगान मुखी हेऱ्यी एने आदिकारी हेऱ्यी एने ज्यी दुनियान आंदारान ताकेत हेऱ्यी, एने ता खाराबान आत्मिक सेना हेऱ्यी हे, जा जुगाम हेते। <verse eid="EPH 6:12" /><verse number="13" style="v" sid="EPH 6:13" />तानकेरता बोगवानान आखा आथ्‍यार बांद लिवो! काय तुमू केठीण दिह्यान सामनो केर सीको, एने आखो काय पुरो केरीन मोजबुत रेय सिकहो। <figure style="fig" alt="Roman soldier" file="lb00196c.tif" size="col" copy="Horace Knowles ©" ref="6:10">रोमी सिपाय</figure><verse eid="EPH 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 6:14" />तानकेरता खेरायीन पोट्टा केरीन तुमरी कोमेर बांद लिवो, एने देरमान कवच पेरीन, <verse eid="EPH 6:14" /><verse number="15" style="v" sid="EPH 6:15" />एने पाया माय सान्तीन हाजाली खुबेर ने तियारीन खाहड़ा पेरीन। <verse eid="EPH 6:15" /><verse number="16" style="v" sid="EPH 6:16" />एने ज्या हेऱ्यो बोरहान ढाल लेन मोजबुत रिवो; जाकेरीन तुमू ता खाराबान हेलेगताला बेलखाह ओलाड़ सीको। <verse eid="EPH 6:16" /><verse number="17" style="v" sid="EPH 6:17" />एने सुटकारान टुपो, एने जीवान तालवार जो बोगवानान वचन हे, लेय लिवो। <verse eid="EPH 6:17" /><verse number="18" style="v" sid="EPH 6:18" />एकेक टेम माय आखी बातीन जीवा माय विन्ता, एने विन्ता किरते रिवो, एने ज्यानकेरता जागते रिवो काय आखा चोखाला माणहान केरता कायेम विन्ता केऱ्या किरो। <verse eid="EPH 6:18" /><verse number="19" style="v" sid="EPH 6:19" />एने मार केरता बी विन्ता किरो काय जेवी मी वचन केणेन केरता मुय खोलुह, तेवी माहु ईमोत हेऱ्यो हाजाली खोबरीन मालमात केय सेकु। <verse eid="EPH 6:19" /><verse number="20" style="v" sid="EPH 6:20" />ज्यानकेरता मी बेड्या एने हाकुल केरीन बांदायेल वकील हे, एने विन्ता किरो काय माहु जिहकेरीन ईमोत हेऱ्यो हाजाली खुबेर केणे जुवे, मी बोल सेकु।<verse eid="EPH 6:20" /></para>
  <para style="s">आखरी नमस्‍कार</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:21 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 20:4">प्रेरितान काम 20:4</ref>; <ref loc="2TI 4:12">2 तीमुथीयुस 4:12</ref></char>
    </note>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:21 </char>
      <char style="xt" closed="false">
        <ref loc="COL 4:7">कुलीसियो 4:7</ref>,<ref loc="COL 4:8">8</ref></char>
    </note>तुखीकुस, जो मारो मोंगाल्लो बाहख एने मालीक माय विश्वासयोग्य पावोर हे, तुमूह आखी वातु केय काय तुमू बी मार बाराम जाणो काय मी किहीक रेथु। <verse eid="EPH 6:21" /><verse number="22" style="v" sid="EPH 6:22" />ताह मी ज्यानकेरता तुमू फाय मोकलेल काय तुमू आमरी खुसीह जाणे, एने तो तुमरा मोनाह उत्साहित केरी।<verse eid="EPH 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23" />आबोख बोगवान एने मालीक यीशु मसीन उगे रेन आखा बायाख सान्ती एने बोरहा हेऱ्यो मोंग जुड़ी। <verse eid="EPH 6:23" /><verse number="24" style="v" sid="EPH 6:24" />जा आमरा मालीक यीशु मसीह अमर मोंग केरतेह, ता आखा पोर बोगवानान गीण एती रेय।<verse eid="EPH 6:24" /></para>
  <chapter eid="EPH 6" />
</usx>