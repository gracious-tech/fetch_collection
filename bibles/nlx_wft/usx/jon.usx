<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JON" style="id">- Nahali</book>
  <para style="h">योना</para>
  <para style="toc3">योना</para>
  <para style="toc2">योना</para>
  <para style="toc1">योनान पुस्तेक</para>
  <para style="mt1">योना कि किताब</para>
  <para style="mt2">योनान पुस्तेक</para>
  <para style="imt">योनान ओलखात</para>
  <para style="ip">योनान पुस्तेक जाणकार योनान निनवे हेयरा माय सेवकायीन बाराम हे। दिहरा जाणाव ने पुस्तेकाह रेन आंगेच, ज्य पुस्तेक बोगवानान खोबरीन तुलना माय जाणकार एने तान कामा पोर जादा द्यान लागाड़नेन किथे। योनान हादावणी तुलेचबूखे एनी जेवी यारोबाम दुसरो इस्राएल ने राजा इतो, कोमीत कोमी 800-750 यीशुन पेल, पुण बुध्दीमान माणहाह ज्य नाह मालुम एतो काय पुस्तेक कुलबुखे लेखायेल एतो।</para>
  <para style="ip">बोगवान योनाह निनवेन विरूद पारचार केरनेन केरता मुकल्यो पुण योना उकुम नाह मान्यो एने निनवे माय जाणे रेन देन दिहरे उगे जात रिनो। <char style="xt"><ref loc="JON 1:1-3">1:1-3</ref></char> तो एक डोंडह्या माय चेड़ीन बोह गीयो, जो तर्शीश हेयरा माय जाणे बाजरियेल एतो। जेवी डोंडह्यो तर्शीश उगे जाणे बाजरियेल एतो ते बोगवान एक मोटलो वादोण मुकल्यो। डोंडह्यो चालाड़णारे जुलूम बिय गीया, एने ता बोगवानान रागाह ठावको केरनेन केरता योनाह देरीया माय जुगार देना। ओवतो बोगवान योनाह गिलनेन केरता एक मोटलो मासो मुकल्यो। योना पासतावो किऱ्यो एने बोगवान ताह जीवतालो रेणे दिनो। बाद माय योना निनवेन विरूद पारचार केरनेन केरता निनवे माय गीयो, एने हेयरान माणहे पासतावो केऱ्या। योनान पुस्तेक ज्यी वाती पोर जोर दिथे बोगवान कुलोक किव केरनार हे, पुण योना ज्य नाह होदतालो काय बोगवान गीण केरी। <char style="xt"><ref loc="JON 4:2">4:2</ref></char></para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. योना किहीक बोगवाना हिऱ्यो रेन सिटो नाह गीयो एने मासान पेटा माय जात रिनो। <char style="ior"><ref loc="JON 1:1-17">1:1-17</ref> </char></para>
  <para style="io1">2. योना मासान पेटा माय रेन बोगवानाह किरेल विन्तान बाराम हे। <char style="ior"><ref loc="JON 2:1-10">2:1-10</ref></char></para>
  <para style="io1">3. योना निनवे माय पारचार केरने एने हेयरान माणहे पासतावो केरने बोगवान ताह वोचाड़नेन फेसलो केरने। <char style="ior"><ref loc="JON 3:1-10">3:1-10</ref></char></para>
  <para style="io1">4. योना ज्यी वाती से रागारो हे काय बोगवान निनवेन माणहा पोर गीण किऱ्यो, एने बोगवान योनाह किथे काय तो आखा माणहाह मोंग केरने। <char style="ior"><ref loc="JON 4:1-11">4:1-11</ref></char></para>
  <chapter number="1" style="c" sid="JON 1" />
  <para style="s">योना बोगवानान उकुमाह टालने</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 1:1" />अमितेन बेटाख योनाह यहोवा बोगवान केयो, <verse eid="JON 1:1" /><verse number="2" style="v" sid="JON 1:2" />“पोला मोटला हियोर निनवे माय जा, एने तावाला माणहान बुराय ने विरूद पारचार केर, काहाकाय तान खाराब कामान चेर्चा मार फाय वोर पुचेल हे।” <verse eid="JON 1:2" /><verse number="3" style="v" sid="JON 1:3" />पुण योनाह बोगवानान वात नाह होमेलनु एतो; केरीन याफा हेयराम जाएन तर्शिश गावाम जाणार एक डोंडह्याम बाड़ो आपीन बोह गीयो, काय यहोवा बोगवानान सामने रेन तर्शिश माय नाह जाव।<verse eid="JON 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 1:4" />तेवी यहोवा बोगवान देरीया माय मोटलो वादोण, एने वारो मुकल्यो तेवी डोंडह्यो मुड़ मुड्याम एतो। <verse eid="JON 1:4" /><verse number="5" style="v" sid="JON 1:5" />तेवी आखा डोंडह्याह चालाड़णारे माणहे बिन जीव जीवान देवताह विन्ता केरने बाज गीया, एने डोंडह्या माय ज्य सोमान एतो ताह देरीया माय टाकणे बाज गीया काय डोंडह्यो फोवरो एय जाय, पुण योना डोंडह्यान नेल्ला खासा माय उतरीन हुव जायेल इतो। <verse eid="JON 1:5" /><verse number="6" style="v" sid="JON 1:6" />तेवी डोंडह्यान मुखी योना फाय जाएन केयो, “तु काहा हुवेह? उठ, तारा देवताह विन्ता केर, एय सिकेह काय तारो बोगवान आपणी कालजी केरी, एने आपुह नाय मारी।”<verse eid="JON 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JON 1:7" />तेवी ता एका दिहराह केया, “आवो आपु चिट्ठी टाकीन जाण लेता काय जी गीऱ्या कुणीन कारेण आयेल हे।” तेवी ता चिट्ठी टाक्या, एने चिट्ठी माय योनान नाव निकेलनो। <verse eid="JON 1:7" /><verse number="8" style="v" sid="JON 1:8" />तेवी ता योनाह फुशा, “आमुह के ज्यी गीऱ्या काहा आवीह? तु काय काम केरने? तु कावालो हे? तु काल्ला देसान एने काल्ला माणहाम रेन आयेल हे?”<verse eid="JON 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 1:9" />योना ताह केयो, “मी इब्री हे, एने हेरगावाला यहोवा बोगवानान जो देरीयो एने देरती दुयाह बाणायेल हे, तान बोक्ती केरनार हे।” <verse eid="JON 1:9" /><verse number="10" style="v" sid="JON 1:10" />तेवी ता जुलूम बिय गीया, एने केणे बाज गीया, “तु ज्य काय किरेल हे?” योना यहोवा बोगवाना हिऱ्यो रेन सिटो नाहणे बाजरिनोह, जी वात ता माणहे जाणताला, काहाकाय योना ताह खुद किय दियेल इतो। <verse eid="JON 1:10" /><verse number="11" style="v" sid="JON 1:11" />तेवी ता योनाह फुशा, “आमु तार हेऱ्या काय किरज्‍यो काय देरीयो ठावको एय जाय?” तुलबूखे देरीयान जेलखा वोड़तेच जाताला।<verse eid="JON 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JON 1:12" />योना ताह केयो, “माहु उखलीन देरीयाम टाक दिवो, तेवी देरीयो ठावको एय जाय, काहाकाय तुमरी पोर जी गीऱ्या मार वोजेसे आयेल हे।”<verse eid="JON 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JON 1:13" />तीबी ता जुलूम मेहनेत केरीन डोंडह्याह चालाड़ीन मेराम लिजाणे होदताला, पुण ताह नाह पोचानो, काहाकाय देरीयान जेलखा वोड़तेच जाताला। <verse eid="JON 1:13" /><verse number="14" style="v" sid="JON 1:14" />तेवी ता माणहे बोगवानाह आयड़ीन केया, “आमु मोन लागाड़ीन तारी विन्ता केरतेह, ज्या माणहान जीवान बोदले आमुह मा मारहे, एने निरदोसान खुनान गुनो आमु पोर मा लागाड़े, जी तारी मोरजी एती तीस ईयेल हे।” <verse eid="JON 1:14" /><verse number="15" style="v" sid="JON 1:15" />तेवी ता माणहे योनाह उखलीन देरीयाम टाक देना, तेवी देरीयान मोटला जेलखे थोप गीया। <verse eid="JON 1:15" /><verse number="16" style="v" sid="JON 1:16" />तेवी ता माणहे बोगवानाह जुलूम बिना, एने ताह बोली केऱ्या एने मानता मान्या।<verse eid="JON 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JON 1:17" />बोगवान देरीयान एक मोटला मासाह मुकल्यो काय योनाह गील जाय, एने योना ता मासान पेटा माय तीन दिह एने तीन रात रिनो।<verse eid="JON 1:17" /></para>
  <chapter eid="JON 1" />
  <chapter number="2" style="c" sid="JON 2" />
  <para style="s">योनान विन्ता</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 2:1" />तेवी योना मासान पेटा माय रेन आपणा बोगवान यहोवाह विन्ता केरीन केयो,<verse eid="JON 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JON 2:2" />“जुलबुखे मी दुखा माय पोड़ीन विन्ता किरेल,</para>
  <para style="q2" vid="JON 2:2">तेवी यहोवा बोगवान मारी विन्ता होमेल लियेल,</para>
  <para style="q1" vid="JON 2:2">ती केली माय रेन मी आयड़ी उठनो,</para>
  <para style="q2" vid="JON 2:2">तेवी तु मारी होमल्यो।<verse eid="JON 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JON 2:3" />तु माहु देरीयान उंडालाम टाक दियेल इतो;</para>
  <para style="q2" vid="JON 2:3">मी उकालान विची माय पुड़ेल इतो,</para>
  <para style="q2" vid="JON 2:3">तारा बोड़कायेल आखा जेलखा एने जावटा मार उपेर रेन वोय गीया।<verse eid="JON 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JON 2:4" />तेवी मी कियेल, मी तारा डोलान सामने रेन निकालाय गीयो।</para>
  <para style="q2" vid="JON 2:4">एवी मी किहीक तारा चोखाला मोंदिर ने उगे पुशो देखुह?<verse eid="JON 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JON 2:5" />मी पाण्या माय न्या वोर बुड़ेल इतो काय जीव जाणे केरतालो,</para>
  <para style="q2" vid="JON 2:5">उंडालो देरीयो मार कावदेन एतो।</para>
  <para style="q2" vid="JON 2:5">हेवाल्यो मार मुंडा माय लेटकी रियेल एतो।<verse eid="JON 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JON 2:6" />मी बोयड़ान थुड़ाम पोच जायेल इतो।</para>
  <para style="q2" vid="JON 2:6">मी बुयारा माय कायेम ने केरता कोंडाय जायेल इतो।</para>
  <para style="q1" vid="JON 2:6">तीबी एय मारा यहोवा बोगवान, तु मार जिवाह मोतीन खोयाराम रेन काड़ेल हे।<verse eid="JON 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JON 2:7" />जेवी मी बेसुद एण्योस इतो, तेवी मी बोगवानाह एर किऱ्यो,</para>
  <para style="q2" vid="JON 2:7">तेवी मारी विन्ता तुवा फाय</para>
  <para style="q2" vid="JON 2:7">एने तारा चोखाला मोंदिर माय पोचनी।<verse eid="JON 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JON 2:8" />जा माणहे दोकान फालतुक वोस्तु पोर मोन लागाड़तेह</para>
  <para style="q2" vid="JON 2:8">ता गीण केरनार बोगवानाह सोड़ देतेह।<verse eid="JON 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JON 2:9" />पुण मी उपकारान गीत गावीन</para>
  <para style="q2" vid="JON 2:9">तारी बोली चेड़ावुह,</para>
  <para style="q2" vid="JON 2:9">जी मानता मी मानेल हे,</para>
  <para style="q2" vid="JON 2:9">तीह मी पुरी केरूह।</para>
  <para style="q1" vid="JON 2:9">सुटकारो बोगवाना फाय रेच ने हे!”<verse eid="JON 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 2:10" />तेवी बोगवान मासाह उकुम आप्यो, “तेवी मासो योनाह देरीयान मीरे उगाल देनो।”<verse eid="JON 2:10" /></para>
  <chapter eid="JON 2" />
  <chapter number="3" style="c" sid="JON 3" />
  <para style="s">योनान उकुम मान्नो</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 3:1" />तेवी दिहरी वारीन पुशो यहोवा बोगवान योनाह केयो। <verse eid="JON 3:1" /><verse number="2" style="v" sid="JON 3:2" />“उठीन पोला मोटला हियोर निनवे माय जा, एने जी वात मी तुवाह केह, ती वातीन पारचार केर।” <verse eid="JON 3:2" /><verse number="3" style="v" sid="JON 3:3" />तेवी योना यहोवा बोगवान कियेल तिह केरीन निनवे माय गीयो, निनवे एक मोटलो हियोर इतो, ता माय फिरनेन तीन दिह पुरा लागताला। <verse eid="JON 3:3" /><verse number="4" style="v" sid="JON 3:4" /><note caller="+" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="MAT 12:41">मत्ती 12:41</ref>; <ref loc="LUK 11:32">लुका 11:32</ref></char></note>योना एक दिह्यान चालनो चालीन हेयरान विच माय जाएन, ज्यो पारचार केऱ्यो, “एवी रेन चालीह दिह पुरा एय जाती, तेवी निनवे हियोर खेतेम एय जाय!”<verse eid="JON 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JON 3:5" />तेवी निनवेन माणहे यहोवा बोगवाना पोर बुरहो केऱ्या, ता दुख माणावणेन केरता उपासान गोसणा केऱ्या। एने मोटला आतल्या आखा माणहे दुख माणावणेन फाड़का पेरहु।<verse eid="JON 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JON 3:6" />जुलबुखे निनवेन राजा जी वात होमल्यो, तेवी राजा राजगादि पोर रेन उठनो, एने तान फाड़का काड़ीन गोंटान फाड़का पेर लिदो, एने रोखड़ान डिगा पोर बोह गीयो। <verse eid="JON 3:6" /><verse number="7" style="v" sid="JON 3:7" />ओवतो राजा आदिकारी हिऱ्यो हुमच्यो केरीन निनवे हेयरा माय ज्यो पारचार केरायो, “नाह माणहे नाहते गाय बुयोल एने बोकड्या, नाहते दिहरा जेनवारे, नाहते चीड़ा, कुण बी नाय खाती एने पिती। <verse eid="JON 3:7" /><verse number="8" style="v" sid="JON 3:8" />माणहे एने जेनवार दुयु बी रेड़ रेड़ीन यहोवान विन्ता किरे, एने गेलेत कामा हेऱ्या रेन सेटा एय, ता गेलेत काम सोड़े एने पाचतावो किरे। <verse eid="JON 3:8" /><verse number="9" style="v" sid="JON 3:9" />एय सिकेह काय यहोवा बोगवान गीण केरी, एने तान मोन बोदेल लेय एने तान जो बुड़केल राग हे, तो ओलाय जाय एने आपु खेतेम एणे से वोच जाहु!”<verse eid="JON 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 3:10" />जेवी यहोवा बोगवान तान कामाह दिख्यो काय ता गेलेत वाटे रेन वोलने बाजरेनाह, तेवी बोगवान तान निर्णय बोदेल दिनो एने ताह जो खेतेम केरनेन ठेरायेल इतो, ताह नाह केऱ्यो।<verse eid="JON 3:10" /></para>
  <chapter eid="JON 3" />
  <chapter number="4" style="c" sid="JON 4" />
  <para style="s">योनान राग एने बोगवानान गीण</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 4:1" />ज्यी वात योनाह जुलूम गेलेत लागी, एने ताह जुलूम राग आवो। <verse eid="JON 4:1" /><verse number="2" style="v" sid="JON 4:2" /><note caller="+" style="x"><char style="xo" closed="false">4:2 </char><char style="xt" closed="false"><ref loc="EXO 34:6">निर्गमन 34:6</ref></char></note>योना यहोवा बोगवानाह इही केन विन्ता किऱ्यो, “एय बोगवान, जुलबुखे मी मार देसाम इतो, तेवी काय मी ज्यी वात नाह कियेल इतो? तान केरता मी तारो उकुम होमलीन पेलुच तर्शिश माय नाहीन जातालो; काहाकाय मी जाणतालो काय तु मोंग एने गीण केरनार बोगवान हे, एने राग उतवाल्यो नाह केरने एने मोंगाल्लो हे, एने दुख देणे से खुस नाह एत। <verse eid="JON 4:2" /><verse number="3" style="v" sid="JON 4:3" />तान केरता एय बोगवान एवी मारो जीव काड़ले; काहाकाय मार केरता जिवतालो रेणे से मोरने हाजो हे।”<verse eid="JON 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 4:4" />यहोवा बोगवान योनाह केयो, “काय तुवाह राग लागोह तो हाजो हे?”<verse eid="JON 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JON 4:5" />तेवी योना ता हेयराम रेन निकलीन दिह उगता उगे बोह गीयो; एने ताहरूह तान केरता एक मालो बाणायो, एने तान सावला माय बोहीन देखणे बाज गीयो काय ज्या हेयरान काय ईथे।<verse eid="JON 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JON 4:6" />तेवी बोगवान, एक कोलान विलो उगाड्यो, एने इही केरीन मोठो किऱ्यो काय योनान मुंडी पोर सावलो एय गीयो, जासे तान दुख सेटो एय, योना ता वेलाह देखीन जुलूम खुस एय गीयो। <verse eid="JON 4:6" /><verse number="7" style="v" sid="JON 4:7" />दिहरे दिह उठ्यान विगोस उजालो एतास, बोगवान एक किड़ो मुकल्यो, तो कोलान वेलाह ओहलो कातऱ्यो काय तो हुकीन मोर गीयो। <verse eid="JON 4:7" /><verse number="8" style="v" sid="JON 4:8" />जुलबुखे दिह उगनो, तेवी बोगवान ताताली जाव चालाड्यो एने दोप योनान मुंडी पोर पोड़नो, तेवी योना जावलाय गीयो। केरीन तो ज्य केन मोत मांग्‍यो, “मार केरता जिवतालो रेणे से मोरने हाजो हे।”<verse eid="JON 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 4:9" />पुण बोगवान योनाह केयो, “तारो राग कोलान वेलान केरता बोड़केल हे काय ज्य हाजो हे?”</para>
  <para style="p" vid="JON 4:9">योना बोगवानाह केयो, “होव ठिक हे, मार रागान वोजेसे मारो जीव जाय तीबी चाली!”<verse eid="JON 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 4:10" />तेवी बोगवान योनाह केयो, “ता वेलान केरता तु कायच मेहनेत नाह किऱ्यो, नाहते तु मुठो किऱ्यो, तो एकुच रातीम खेतेम एय गीयो, तान केरता तु कालजी काहा किरेह! <verse eid="JON 4:10" /><verse number="11" style="v" sid="JON 4:11" />ज्या मोटला निनवे हेयरा माय एक लाख एने विह एजाराह रेन जादा माणहे हेते, जा तान हाजो एने बाकतान बाराम नाह जाणते, एने जुलूम ओहला पालन्या जेनवारे बी हेते, ते काय मी तान कालजी नाय केरू!”<verse eid="JON 4:11" /></para>
  <chapter eid="JON 4" />
</usx>