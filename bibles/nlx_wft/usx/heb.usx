<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HEB" style="id">- Nahali</book>
  <para style="h">इब्रानियो</para>
  <para style="toc3">इब्रानियो</para>
  <para style="toc2">इब्रानियो</para>
  <para style="toc1">इब्रानियोन पोत्रो</para>
  <para style="mt2">इब्रानियो कि पत्री</para>
  <para style="mt1">इब्रानियोन पोत्रो</para>
  <para style="imt">ओलखात</para>
  <para style="ip">यीशु जुनाला नेमान जुलूम होवट्यु जाणाव्युह पुऱ्यू किहीक किरेह ज्यो देखाड़नार इब्रानियोन पोत्र हे। ज्यो एक दिर आपणार पुस्तेक हे! एक हिकवोण माय ज्याह बाणायेल हे, आख्‍यु जाणाव एने मुखी चाकर्‍यान जापापदारीह यीशु किहीक पुरो किरेल हे तो साप देखाड़नार साठ रेन बी जादा जुनाला नेमान उल्लेख ज्यी पुस्तेक माय हे। तानकेरता ज्यो पुस्तेक यहुदि मसी माणहान केरता प्रोत्साहन ईमोत आपणार मानाय गीयो। ज्यान पासाण ज्यो कायदो यीशु किहीक पुरो किरेल तो ज्यी पुस्तेक माय साप देखाड़ेल हे। आखा पापान केरता एकुच वार एने यीशु कायेम ने बोली ईनो। ज्या पुस्तेक माय ओहलो सोमेज आवीह काय यीशु मसी आपुह बोगवाना पोर बुरहो केरनेन केरता तियार किरेह। <char style="xt"><ref loc="HEB 12:2">12:2</ref></char> तिहेस केरीन ज्या काल माय आपु विश्वासीन केरता ज्या पुस्तेक माय मुठलो ईमोत एने प्रोत्साहन हे। आपुह ता पोर निर्बर रेणे जुवे।</para>
  <para style="ip">इब्रानियोन पोत्र कुण लिखेल हे तो आपुह मालुम नाह सोतो, पुण तीबी थोड़ाक पंडित, विदवान माणहान ज्य मान्नु हे काय बोगवानान सेवक प्रेरित पौलुस, लुका, बरनबास ज्या ज्यी पुस्तेक लिखेल एती। तिहेस केरीन ज्य पुस्तेक केवीह लेखानो एय तो बी आपुह मालुम नाह सोतो। पुण जुलूम विदवान इही मानतेह काय ज्य मसीन जेल्मान पासाण 70 वोरह्यान पासाण लेखाय गीयो एय। जेवी यरूशलेम हियोर 70 साल माय खेतेम केराय गीयो। ज्य पुस्तेक जुलूम होवट्यु मोंडली माय वाचाय गीयो एय। ज्यो रोम हेयराम रेन लेखाय जायेल एतो। <char style="xt"><ref loc="HEB 13:24">13:24</ref></char></para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. यीशु बोगवानान आखा जाणाव केरनार एने हेरोगदुताह रेन मुठो हे। <char style="ior"><ref loc="HEB 1:1-4:13">1:1–4:13</ref></char></para>
  <para style="io1">2. जा चाकऱ्या यरूशलेम ने मोंदिर माय सेवा केरतेह ताह रेन बी यीशु मुठो हे <char style="ior"><ref loc="HEB 4:14-7:28">4:14–7:28</ref></char></para>
  <para style="io1">3. मुसाह आपेल उकुम ने द्‍वारे जो जुनाला नेम माय बोगवान तान माणहाह केयो ताह रेन बी यीशुन सेवा मोठी हे। <char style="ior"><ref loc="HEB 8:1-10:31">8:1–10:31</ref></char></para>
  <para style="io1">4. यीशु आखी बातीन मुठो सेवक हे ज्यान बाराम सुचना। <char style="ior"><ref loc="HEB 10:32-13:17">10:32–13:17</ref></char></para>
  <para style="io1">5. थोड़ोक बोद एने साबासकी आपीन ज्या पोत्राह निवरावेह। <char style="ior"><ref loc="HEB 13:18-25">13:18-25</ref></char></para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="s">बोगवानान वचन बेटाख उगे रेन</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />पेल्ला काला माय बोगवान जाणकारान द्‍वारे आमरा डायडाया हिऱ्यो आलेग आलेग टेम माय एने आलेग आलेग रिती से वातु किऱ्यो, <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />पुण एवी न्या सेवल्या दिह्या माय आमु हिऱ्यो बेटाख ने द्‍वारे वातु किरेल, जाह बोगवान आख्‍यु वोस्तुन वारीस ठेरायो, एने तास ने द्‍वारे बोगवान आखी केलीह बाणायेल हे। <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />तो बोगवान बोड़ाय ने उजेड़ एने तान वेहान साप रूप हे, तोच आख्‍यु वोस्तुह तान ताकेतीन वचना केरीन होमालने। जेवी तो आपुह आपणा पापाम रेन दोव दियेल ईतो, ते तो मोटली बोड़ाय पोर बुहेल बोगवानान जीवड़े उगी बोह गीयो।<verse eid="HEB 1:3" /></para>
  <para style="s">बोगवानान बेटाख ने मोठवाय</para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4" />एने हेरोगदुताह रेन तो उलोस हाजो ठिरेल, जुलोक तो ताह रेन मोटलो पद ने वोस बोणीन हाजो नाव सापड़ायेल हे।<verse eid="HEB 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 1:5" />केदी काल्ला हेरोगदुताह बोगवान ज्य कियेल,</para>
  <para style="q1" vid="HEB 1:5">“तु मार बिटोख हे;</para>
  <para style="q2" vid="HEB 1:5">आज मी तार आबोख बोण गीयोह”</para>
  <para style="p" vid="HEB 1:5">एने पोशो ज्य काल्ला हेरोगदुताह कियेल,</para>
  <para style="q2" vid="HEB 1:5">“मी तार आबोख रेह,</para>
  <para style="q2" vid="HEB 1:5">एने तु मार बिटोख।”<verse eid="HEB 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 1:6" />एने जुलबुखे पेल्ला बेटाख दुनिया माय लावीन किथे,</para>
  <para style="q1" vid="HEB 1:6">“बोगवानान सोब हेरोगदुत तान सोराह नमस्‍कार केरी।”<verse eid="HEB 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 1:7" />एने हेरोगदुतान बाराम ज्य किथे,</para>
  <para style="q2" vid="HEB 1:7">“तो तान हेरोगदुताह वारो,</para>
  <para style="q2" vid="HEB 1:7">एने तान सेवकाह देदेकताली आक्‍ठो बाणावीह।”<verse eid="HEB 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 1:8" />पुण बेटाख ने बाराम किथे,</para>
  <para style="q1" vid="HEB 1:8">“एय बोगवान, तारी राजगादि जेलेमक्यीस रेय!<note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="ft" closed="false">एय बोगवान तार राज कायेम रेय; बोगवाना माय तुमरो राज हे।</char></note></para>
  <para style="q2" vid="HEB 1:8">तु तार राज ने शासक नियाव हिऱ्यो किरहे।<verse eid="HEB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9" />तु देरमाह मोंग किरेह एने एदेरमा हिऱ्यो दुसमोनाय किरेल हे।</para>
  <para style="q2" vid="HEB 1:9">केरीन बोगवान, तार बोगवान,</para>
  <para style="q2" vid="HEB 1:9">तार हातीह रेन जादा खुसीन तेल केरीन तारो निवोड़ किरेल हे।”<verse eid="HEB 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 1:10" />एने उंजु ज्य किथे,</para>
  <para style="q1" vid="HEB 1:10">“एय मालीक, पेलुस तु देरतीन पायो टाकेल हे,</para>
  <para style="q2" vid="HEB 1:10">एने हेरोग तार आथान कारागिरी हे।<verse eid="HEB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11" />ता ते खेतेम एय जाती, पुण तु बोणीन रिहे;</para>
  <para style="q2" vid="HEB 1:11">एने ता आखा फाड़कान गेत जुनाला एय जाती।<verse eid="HEB 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12" />तु ताह चादरान गेत चोंडाल दिहे,</para>
  <para style="q2" vid="HEB 1:12">एने ता फाड़कान गेत बोदेल जाती।</para>
  <para style="q1" vid="HEB 1:12">पुण तु तोच हे, एने तार जीवाय ने सेवोट केदी बी नाय एय।”<verse eid="HEB 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 1:13" />हेरोगदुता माय रेन बोगवान कुणीह कुलबुखे कियेल:</para>
  <para style="q1" vid="HEB 1:13">“तु मार जीवड़े उगे बोह,</para>
  <para style="q2" vid="HEB 1:13">जाह वोर काय मी तार दुसमोनाह</para>
  <para style="q2" vid="HEB 1:13">तार पायान बुंदेन चोवकी नाह बाणाव देव।”<verse eid="HEB 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 1:14" />काय आखा हेरोगदुत सेवान केरता निवाड़ेल जीव नाह सोता? जा सुटकारो सापड़ावण्या हेते तान सेवा केरी।<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="s">मुठलो सुटकारो</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />केरीन जोरवरी हे काय ज्यी खेरली वातु आपु होमलेल हेते, त्यु पोर मोन लागाड़े, ओहलो नाय एय काय आपु तीह रेन सेटा जात रेहु। <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />काहाकाय जो वचन हेरोगदुतान द्‍वारे केवाय जायेल एतो, जेवी तो थोबीन रियेल एने एकेक गुनो एने उकुम नाह माणनेन ठिक ठिक बुदलो आपेह, <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />ते आपु ओहला मोटला सुटकारा पोर द्यान नाह देन किहीक वोच सेकतेह? ज्यान बाराम पेल आमुह मालीक केयो, एने जा ताह होमलेल एता ता फाय रेन आमुह पुतो लागो काय तो सुटकारो खीरलो हे। <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />ता सावाय बोगवान तान मोरजीन गेत निसाण्यु, चोमेत्कार ने कामे एने बात बातीन ताकेतीन कामे, एने चोखाला जीवान वरदान वाटाणेन द्‍वारे ज्यान गोवाय दिते रिनो।<verse eid="HEB 2:4" /></para>
  <para style="s">आपणो सुटकारो केरनार</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />बोगवान ती आवणारी देरतीह जीन वात आपु केरतेह, हेरोगदुतान ताबाम नाह होप्यो। <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />पुण कुण तीबी चोखाली पुस्तेक माय ज्यी गोवाय दियेल हे:</para>
  <para style="q1" vid="HEB 2:6">“माणुह काय हे, काय तु ताह इर केरी;</para>
  <para style="q2" vid="HEB 2:6">एने माणहान बिटोख काय हे, काय तु तान चिन्ता किरेह?<verse eid="HEB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />तु ताह हेरोगदुताह रेन थुड़ोस कोम किरेल हे;</para>
  <para style="q2" vid="HEB 2:7">तु ता पोर बोड़ाय एने आदर ने मुकूट मिलेल हे,<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">मोकतास लेख माय तु जो काय बाणायेल ता पोर तु ताह आदिकारी नियुक्त किऱ्यो जुड़ेल हे (देखी बजन 8:6।)</char></note><verse eid="HEB 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 2:8" />तु आखी वोस्तु तान ताबाम किर दियेल हे।”</para>
  <para style="p" vid="HEB 2:8">आखी केल तान ताबाम किरते लेन बोगवान ओहलो कायस नाह सोड्यो, जो तान ताबाम नाह केराय गीयो। पुण खेराय ज्यी हे काय एवी वोर आपुह आखो काय तान ताबाम नाह देखते। <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />पुण आपु यीशुह जो हेरोगदुताह रेन थुड़ोस कोम किरेल ईतो, मोतीन दुख उखेलनेन वोजेसे बोड़ाय एने आदर ने मुकूट पेर रियेल देखतेह, काहाकाय बोगवानान किव माय तु एकेक माणहान केरता मोतीन होवाद चाखी। <verse eid="HEB 2:9" /><verse number="10" style="v" sid="HEB 2:10" />काहाकाय जान केरता आखो काय हे एने जान द्‍वारे आखो काय हे, ताह ज्योच हाजो लागनो काय जुलबुखे तो मोकतास बेटाख बोड़ाय माय पोचाड़ी, ते तान सुटकारो आपणाराह दुख उखेलनेन द्‍वारे पाको केरी।<verse eid="HEB 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 2:11" />काहाकाय चोखो केरनार एने जा चोखाला केराय जातेह, आखा एकुस मुलाम रेन हेते, तीस कारेण तो ताह बाहख बोणीख केणे नाह लाजवात। <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />तो किथे,</para>
  <para style="q1" vid="HEB 2:12">“मी तारो नाव मार माणहाह होमलावुह;</para>
  <para style="q2" vid="HEB 2:12">पोंचान विची माय मी तारो गीत गावुह।”<verse eid="HEB 2:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13" />उंजु पोशो ज्य किथे, “मी ता पोर बुरहो केरूह।” एने उंजु ज्य किथे, “हुमेल, मी ता सोरा हिऱ्यो जाह बोगवान माहु आपेल हे।”<verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />जेवी सोरा माह एने लुय ने गोवांदी हेते, ते तु सोता बी तान बाराबोर तान गोवांद्यो एय गीयो, काहाकाय मोतीन द्‍वारे ताह जाह मोती पोर ताकेत जुड़ेल एती, मतलब सैतानाह विणकाम्यो केर देय, <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />एने जोलाक मोतीन बिय ने वोजेसे जीवाय ने गुलामी माय फुसील एता, ताह सोड़ेव लेय। <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />काहाकाय तो ते हेरोगदुताह नाह, पुण अब्राहाम ने वोसीह मोदेक किरेह। <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />ज्यान वोजेसे ताह ज्य जोवतालो काय आखी वातु माय आपणा बायाख ने गेत बोणी, ज्याकेरीन तो ती वातु माय ज्यु बोगवाना हेऱ्यु नातो मेलत्युह। एक गिणातो एने बोरहावालो मुठलो बोगवानान मुखी चाकर्‍यो बोणी, ताकाय तो माणहान पाप माफ केरनेन केरता बोली बोणी। <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />काहाकाय जेवी तो पारेख ने हाल माय दुख विसेल ईतो, ते तो तान बी मोदेक केर सिकेह जान पारेख ईथे।<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="s">यीशु मुसाह रेन मुठो</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />तानकेरीन एय चोखाला बाय बोणहा, तुमू ज्या हेरगान राज ने हादाड़ेल माय एकठा हेते, तो प्रेरित एने मुखी चाकर्‍यो यीशु पोर जाह आपु कबुल केरतेह, द्यान किरो। <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />तो तान बोणाव नारान केरता बोरहावालो ईतो, जिहकेरीन मुसा बी बोगवानान आखा गेरा माय ईतो। <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />एने यीशु मुसाह रेन उलो जादा बोड़ाय ने लायेक सोमजायेल हे। जोलोक काय गेराह बाणावणार गेराह रेन जादा आदार मिलेह। <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />एकेक गेरान कुण ने कुण बाणावणार रेणे, पुण जो आखो काय बाणायेल तो बोगवान हे। <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />मुसा ते बोगवानान आखा गेरा माय पावरान गेत बोरहावालो रिनो, ज्यी वातुन वर्णन एण्यो एतो, तान गोवाय देय। <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />पुण मसी बिटोख एणेन नाते बोगवानान गेरान आदिकारी हे एने तान गेर आपु हेते। केदी आपु दिर पोर एने आपणी आसान मोठवाय पोर सेवली बुखेत वोर मोजबुती माय थोबीन रेहु।<verse eid="HEB 3:6" /></para>
  <para style="s">विण बोरहान उगे चेतावणी</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />केरीन जीह चोखालो जीव किथे,</para>
  <para style="q1" vid="HEB 3:7">“केदी आज तुमू तान बोल होमेलहो,<verse eid="HEB 3:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 3:8" />ते आपणा मोनाह वातड़ा नाय केरता,</para>
  <para style="q2" vid="HEB 3:8">जोहलो काय राग लागाड़नेन बुखेत एने पारेख ने दिह जेंगला माय किरेल एता।<verse eid="HEB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9" />ताहरी तुमरा डायडाया माहु उलखेल एता, एने पारखेन,</para>
  <para style="q2" vid="HEB 3:9">चालीह वोरह्या वोर मारा कामे दिखेल।<verse eid="HEB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10" />ज्यान वोजेसे मी तुलबूखे माणहा हिऱ्यो रागारो रिनो, एने केयो,</para>
  <para style="q2" vid="HEB 3:10">‘न्यान मोने कायेम बोटेकती रेतेह,</para>
  <para style="q1" vid="HEB 3:10">एने न्या मार उकुमाह नाह मानते।’<verse eid="HEB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11" />तेवी मी रागाम बोरायीन सुगोण खाईल,</para>
  <para style="q2" vid="HEB 3:11">ता मार हुका माय रिगणे नाय जुवे!”<verse eid="HEB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />एय बाय बोणहा, हास केरीन रिवो काय तुमरे माय ओहलो खाराब एने विण बोरहावालो मोन नाय रेणे जुवे, जो तुमूह जीवताला बोगवाना हिऱ्यो रेन सिटो केर ली जाय। <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />पुण जाह वोर तो दिह, “जाह आज ने दिह केतेह,” आपणे ओंगाण हे दाड़ीन दिह एका दिहराह उत्साहित केरती रिवो, ओहलो नाय एय काय तुमरे माय रेन कुण बी तान पापान दोका माय आवीन वातड़ो एय जाय। <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />काहाकाय आपु मसीन गोवांद्या ईयेल हेते, केदी आपु आपणा पेल्ला बोरहा पोर सेवेट वोर मोजबुती माय थोबीन रेहु। <verse eid="HEB 3:14" /><verse number="15" style="v" sid="HEB 3:15" />जिहकेरीन चोखाली पुस्तेक माय किथे,</para>
  <para style="q1" vid="HEB 3:15">“केदी तुमू आज तान बोल होमेलहो,</para>
  <para style="q2" vid="HEB 3:15">ते तुमरा मोनाह वातड़ो मा केर लिहो,</para>
  <para style="q2" vid="HEB 3:15">जिहकेरीन तुमू माहु राग लागाड़नेन बुखेत किरेल एता।”<verse eid="HEB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />कुण एता ता जा तान आवाज होमेलनेन पासाण बोगवानाह राग लागाड्या? काय ता आखा नाह, जा मुसान द्‍वारे मीस्र देसा माय रेन निकलेल एता? <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />एने बोगवान चालीह वोरह्या वोर काल्ला माणहा हिऱ्यो रागारो रिनो? कायताच हिऱ्यो नाह जा पाप किरेल एता, एने तान देड़े जेंगला माय पोड़ रियेल एता। <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />एने बोगवान कुणी हिऱ्यो सुगोण खाईल ईतो, “तुमू मारा हुका माय रिग नाय सिकहो।” काय ताह उलोस नाह जा उकुम नाह मान्या? <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />आपु देखतेह काय ता विण बोरहान वोजेसे रिग नाह सेकना।<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />जेवी आराम माय रिगणेन वायदो एवी वोर हे, ते आपुह बिणे जुवे, ओहलो नाय एय काय तुमरे माय रेन कुण बी ताह रेन एंजाणल्यो रेय जाय। <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />आपुह बी ताच ने गेत हाजाली खुबेर केणेन आयेल एती, पुण होमलेल वचना केरीन ताह काईच फायदो नाह ईनो, काहाकाय होमेलणारान मोना माय बोरहा हेऱ्यो नाह बोहनो। <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />पुण आपु जा बुरहो किरेल हेते, ता आराम माय रिगतेह। जीहे तु कियेल ईतो:</para>
  <para style="q1" vid="HEB 4:3">“मी मारा रागा माय सुगोण खाईल हे,</para>
  <para style="q2" vid="HEB 4:3">ता मारा आराम माय रिग नाय सेकती!”</para>
  <para style="p" vid="HEB 4:3">दुनियाह बोणनेन बुखे रेन तान काम पुरा एय जायेल एता। <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />काहाकाय हातवा दिह्यान बाराम वचन ज्य कियेल हे: “बोगवान हातवे दिह तान आखो काम निवरावीन आराम किरेल।” <verse eid="HEB 4:4" /><verse number="5" style="v" sid="HEB 4:5" />एक वारीन उंजु ज्याच बागाम पोशो किथे, “ता मार आराम माय रिग नाय सेकती।” <verse eid="HEB 4:5" /><verse number="6" style="v" sid="HEB 4:6" />जेवी ज्यी वात बाकी हे काय कोलाक उंजु हेते जा ता आराम माय रिगती, एने ताह तान हाजाली खुबेर पेल होमलायेल ता उकुम नाह मान्या केरीन ता माय नाह रिग्या, पुण एवी बी दिहरान केरता आराम ने बायणो उगड़ो हे। <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />तानकेरीन तो ईखेह खाज दिह्याह ठेरावीन ओलाक दिह्यान पासाण दाऊद ने पुस्तेक माय ताह “आज ने दिह” किथे। जीहे पेल केवाय जायेल एतो,</para>
  <para style="q1" vid="HEB 4:7">“केदी आज तुमू तान बोल होमेलहो,</para>
  <para style="q2" vid="HEB 4:7">ते तुमरा मोनाह वातड़ो मा किरहो।”<verse eid="HEB 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8" />केदी यहोशु ताह आराम माय रिगाड़ लितो, जान बाराम बोगवान वायदो किरेल ईतो, ते बोगवान ज्यान पासाण दिहरा दिह्यान बाराम नाय कितो। <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />ते जो बी एय, जिहकेरीन बोगवान हातवे दिह आराम किरेह, तिहेस केरीन बोगवानान माणहान केरता तो एक आराम बाकी हे। <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />काहाकाय जो तान आराम माय रिगेल हे, तो बी बोगवानान गेत तान काम पुरो केरीन आराम केरती। <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />केरीन आपु ता आराम माय रिगणेन कोसीत केरने जुवे, ओहलो नाय एय काय एगदाह तान गेत उकुम नाह मानेन डेंड बोगणे पोड़ जाय।<verse eid="HEB 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12" />काहाकाय बोगवानान वचन जीवतालो एने ताकेतवालो हे, एने दुयदारी तेलवारीह रेन बी जुलूम तेज हे; एने जीव एने जीवाह, एने गाठ गाठ एने गोदा गोदाह आंगे केरीन आरा पार कोरने। एने मोनान आसा एने विचारान नियाव किरेह। <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />केलीन काल्ली बी वोस्तु बोगवानान नेजरी मा लिकायेल नाह सोती, तान डोलान सामने जाह आपुह लेखो जोखो आपणु हे। एकेक वोस्तु बिगेर लिकायेल उगाड़ली हे एने काल्ली बी लिकायेल नाह सोती।<verse eid="HEB 4:13" /></para>
  <para style="s">यीशु मुठलो चाकर्‍यो</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />जेवी आपणो उहलो मुखी चाकर्‍यो हे, जो हेरगाम रेन आयेल हे, मतलब बोगवानान बिटोख यीशु, ते आवो, आपु आपणा बोरहा माय मोजबुत बोणीन रेता। <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />काहाकाय आपणो उहलो मुखी चाकर्‍यो नाह सुतो जो आपणी कोमजोरी माय आपु हिऱ्यो दुखी नाय एय सिके, पुण तो आखी वातु माय आमरे गेत पारखाय ते जायेल, तीबी विण पाप निकेलनु। <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />केरीन आवो, आपु गीण ने राजगादिन आहने ईमोत बांदिन चालहु काय आपु पोर किव एय, एने ती गीण सापड़ावहु जो गिरेज ने बुखेत आपणी मोदेक केरी।<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />एकेक मुखी चाकर्‍यो माणहा माय रेन निवड़ाय जाथे, एने माणहान आगवाय केरनेन केरता एने बोगवानान सेवा केरनेन केरता निवड़ाय जाथे, ताकाय तो पापान केरता बेट एने बोलीदान चेड़ावी। <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />काहाकाय तो खुद बी मोकतीस कोमजोरीन ताबाम ईतो, केरीन तो विणएकल्याह एने विहरायेल बोटकायेल हेऱ्यो नेरमाय से वेवारो किर सिकेह। <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />एने तानकेरीन ताह जुवे काय जिहकेरीन माणहान केरता तिहेस केरीन सोतान केरता बी पाप बोली चेड़ाया केरी। <verse eid="HEB 5:3" /><verse number="4" style="v" sid="HEB 5:4" />ज्य मुखी चाकर्‍यान आदार ने पोद कुण बी खुद निवाड़ नाह लेणे, जाह वोर काय हारून ने गेत बोगवानान उगे रेन तो ठेराय नाह जात।<verse eid="HEB 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 5:5" />तिहेस केरीन मसी बी मुखी चाकर्‍यो बोणनेन बोड़ाय खुद स्वीकार नाह किऱ्यो, पुण बोगवान ताह कियेल:</para>
  <para style="q1" vid="HEB 5:5">“तु मार बिटोख हे;</para>
  <para style="q2" vid="HEB 5:5">एने आज मी तार आबोख बुणेल हे।”<verse eid="HEB 5:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 5:6" />इहकेरीन तो दिहरे जागी बी किथे,</para>
  <para style="q1" vid="HEB 5:6">“तु मलकिसिदक ने गेत,</para>
  <para style="q2" vid="HEB 5:6">कायेम ने केरता मुखी चाकर्‍यो हे।”<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="ft" closed="false">मलकिसिदक ज्या माय; नाहते मलकिसिदक ने गेत, नाहते मलकिसिदक ने वोस माय रेन मुखी आदिकारी।</char></note> <figure style="fig" alt="priest with his priestly clothes and censer" file="hk00267c.tif" size="col" copy="Horace Knowles ©" ref="5:5">मुखी चाकऱ्यो चाकऱ्यान फाड़का एने दिवा हेऱ्या </figure><verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:7 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 26:36-46">मत्ती 26:36-46</ref>; <ref loc="MRK 14:32-42">मरकुस 14:32-42</ref>; <ref loc="LUK 22:39-46">लुका 22:39-46</ref></char>
    </note>यीशु तान सेरीर माय देरती पोर रेणे टेम माय मोठास सोबदा माय रेड़ रेड़ीन, एने आहवा गालीन ताह जो ताह मोती माय रेन वोचाड़ सेकतालो। विन्ता एने विन्ती किऱ्यो। बोक्ती एने गेरबोड़ाय ने कारेण बोगवान हुमल्यो। <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />बिटोख ईतो तीबी तो आपणो दुख उखलीन उकुम मान्नेन हिक लिदो। <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />उवतो खिरो एय जाणे से, आपणा सोब उकुम मान्नारान केरता जेलेमक्या कालान सुटकारान कारेण बोण गीयो, <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" /><note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="ft" closed="false">मलकिसिदक माय (देखी 5:6।)</char></note>एने ताह बोगवानान उगे रेन मलकिसिदक ने रिती पोर मोटला मुखी चाकर्‍यान पोद जुड़नो।<verse eid="HEB 5:10" /></para>
  <para style="s">बोरहा माय रेन बोटेकणेन मोंजरी</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />ज्यान बाराम आमुह जुलूम वातु केणु हे, एने ज्याह सोमजाड़णेन बी जुलूम केठीण हे, काहाकाय तुमू मोठेह होमेलने बाज गीयाह। <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" /><note caller="+" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="1CO 3:2">1 कुरिंथीयो 3:2</ref></char></note>टेमान गेत ते तुमूह एवी वोर मास्तेर बोण जाणो एतो, पुण एवी जोरवरी ज्य एय जायेल हे काय ईखेह तुमूह पोशो बोगवानान वचनान हिक पेल रेन हिकाड़ी, तुमू ते ओहला एय गीयाह, काय तुमूह खाणान बोदले एवी वोर दुदूच जुवे। <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />दुद पिणाराह ते देरमान वचनान ओलखात नाह रेणे, काहाकाय तो सोरो हे। <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />पुण खाणो सोमेजदारान केरता हे, जा तान अनुबव से हाजा बाकतान ओलखात केरने हिक जायेल हेते।<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />केरीन आवो, मसीन हिक ने सुरवात सोड़ीन, आपु खेरायीन उगे ओंगाण वोड़ती जाता, एने मोतीन डायलाह रेन कामान द्‍वारे पासतावान पायो पोशा नाय टाके, एने बोगवानान उपेर वालो बुरहो, <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" /><note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="ft" closed="false">बपतीस्मा; नाहते चोखो केरनेन नेम।</char></note>बपतीस्मान हिक एने उपेर आथाह मेलनो, एने मुरेल माय रेन जीव उठणो, एने कायेम ने नियाव। <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />एने केदी बोगवान होदी ते आपु ओहलोच केरहु। <verse eid="HEB 6:3" /><verse number="4" style="v" sid="HEB 6:4" />काहाकाय जा माणहे बोरहाह सोड़ देतेह, ताह पुशो पासतावो केरनेन केरता किहीक लाव सेकतेह? ता एक वार बोगवानान उजेड़ माय एता; जा हेरगावाला वरदानान होवाद चाखील एने चोखाला जीवान आपणो वाटो सापड़ायेल हेते, <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />एने ता बोगवानान वचन कोलोक हाजो हे ज्य जाणेल हेते, एने जो आवणारा कालान केरता ताकेत हे। <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />एने केदी ता बोरहाम रेन बोटकी जाती ते ताह पोशो मोन फिरावणे नाह एण्यो हे, काहाकाय ता बोगवानान बेटाख पोशा खुरूसखाम पोर चेड़ावतेह, एने ताह आखान ओंगाण ईजुत वेरनेन बाराम बाणावतेह।<verse eid="HEB 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7" />काहाकाय ती देरती कायेम पोड़नार पाण्याह हुकाड़ दिथे, एने पिय पियेन किरसाणान केरता लागणार कामाय पाकाड़ेह, ती बुय बोगवानान उगे रेन बोरकेत सापड़ावेह। <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />पुण ती बुय काटा एने खेड़ उगाड़ेह, ते ती काईच कामान नाह सोती एने तीह बोगवानान हाराप एने आक्‍ठा केरीन खेतेम केरनेन बिय हे।<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />पुण एय मोंगाल्ला दोस्ती, आमु इहकेरीन वातु केरतेह, पुण तुमरा बाराम ज्याह रेन बी हाजी वातुन बुरहो हे। ती वातु जी तुमरा सुटकाराह लागेल हे। <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />तुमू बोगवानान माणहान कायेम मोदेक केरीन जो मोंग देखाड़ेल हेते, ताह एने तुमरा दिहरा कामाह बोगवान केदी नाय विहरी तु अन्‍यायी नाह सुतो। <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />आमरी जुलूम होवटी आसा हे, काय तुमू माय रेन एकेक जाण जिवाय वोर इहीचकेरीन केठीण मेहनेत किरते रिवो, काय जान तुमू आसा किरते रेतेह। <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />आमरी ज्यी आसा नाह काय तुमू आलह्या बुणो, पुण ता माणहान गेत बुणो, जा बुरहो एने दिरी हेऱ्या ती वोस्तुह सापड़ावतेह, जान बोगवान वायदो किरेल ईतो।<verse eid="HEB 6:12" /></para>
  <para style="s">बोगवानान मोजबुत वायदो</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />बोगवान जेवी अब्राहामाह वायदो किऱ्यो ते सुगोण खाणेन केरता तान ओंगाण सोताह रेन मुठो दिहरो कुणीच नाह एतो, केरीन तो ताच ने नाव माय ज्यी सुगोण खाईल। <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />एने केयो, “मी वायदो केरथु काय तुवाह खेरीच बोरकेत आपुह, एने तुवाह जुलूम होवटा सोरा आपुह।” <verse eid="HEB 6:14" /><verse number="15" style="v" sid="HEB 6:15" />एने केरीन अब्राहाम दिर मेलीन वाट जुवते रिनो, एने ताह तो जुड़नो, जान वायदो बोगवान ता हिऱ्यो किरेल ईतो। <verse eid="HEB 6:15" /><verse number="16" style="v" sid="HEB 6:16" />काहाकाय माणुह ते ताह रेन एगदा मोटला माणहान सुगोण खाणे, एने ती सुगोण सोब बोलचालीह बोंद केरीन जो काय केवाय जाथे ताह पाक्को केर दिथे। <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />बोगवान किरेल वायदाह लेणाराह तु साप केर देणे होदतालो, काय तु तान उद्देशाह केदी नाह बोदेलने; केरीन तु तान वायदा हिऱ्यो तान सुगोण जोड़ दिनो। <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />न्या दुय वातु हेत्यु तान वायदो एने तान सुगोण ज्यु केदी नाह बोदेल सेकत्यु एने जीन बाराम बोगवान केदी जुठ नाह केय सिकेत। केरीन आपु जा बोगवानान आहने आसरो लेणेन केरता आयेल हेते एने जी आसा तु आपेल हे तीह देरीन जुलूम खुसी माय बोरायेल हेते। <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />ज्यी आसा आपणा जीवान केरता ओहलो लंगर हे जो थोबीन एने मोजबुत हे, एने पोड़दान माय चोखाले जागे वोर पुचेह, <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />जाहरी यीशु आपणी वोतीन आपुह रेन पेल रिगेल, तु मलकिसिदक ने रिती माय कायेम कायेम ने केरता मुखी चाकर्‍यो बोण गीयो।<note caller="+" style="f"><char style="fr" closed="false">6:20 </char><char style="ft" closed="false">मलकिसिदक माय (देखी 5:6।)</char></note><verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="s">मलकिसिदक चाकर्‍यो</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />ज्‍यु मलकिसिदक शालेम ने राजा ईतो, एने मुठो पारदान बोगवानान चाकर्‍यो ईतो। जेवी अब्राहाम चार राजाह आरवीन वोलने बाजरियेल ईतो, तेवी मलकिसिदक अब्राहामाह मिलानो एने ताह बोरकेत आप्यो। <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />एने अब्राहाम ताह तो आखो जो तु लेड़ाय माय जिकेल ईतो तान दोहवो ईसो आप्यो। मलकिसिदक ने नावान पेल्लो मतलब हे, “देरमान राजा,” एने उंजु पोशो तान ज्य बी मतलब हे, शालेम ने राजा मतलब “हुक ने राजा।” <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />तान आबोख, आहख एने डायलान काईच बी पुरावो नाह जुड़ेत; तान जेल्मो नाहते तान मोतीन काईच लेख नाह सोतो। पुण बोगवानान बेटाख ने गेतुस कायेम ने केरता चाकर्‍यो बोणीन रिथे।<verse eid="HEB 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />एवी ज्या पोर थोड़ोक विचार किरो काय तो कुलोक मुठो ईतो। जाह आपणो नाव लायेल डायलो अब्राहाम ताह लेड़ाय माय सापड़ेल मालदेन ने आखाम रेन हाजो दोहवो ईसो बेट आपेल। <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />एने लेवीन वोस माय रेन जा चाकऱ्या बोणतेह, ताह नेमान नुसार उकुम हे काय इस्राएलान माणहा फाय रेन मतलब तान सोतान माणहा फाय रेन दोहवो ईसो लेय, ओवता ता अब्राहामान वोस ने काह नाह रेते। <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />मलकिसिदक जो लेवीन वोसान नाह ईतो, पुण तो अब्राहामा फाय रेन एक दोहवो ईसो लियेल एने जाह बोगवानान वायदो जुड़ेल ईतो, ताह बोरकेत आप्यो। <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />ज्या माय काईच सुवशो नाह सुतो काय जो बोरकेत आपेह, तो बोरकेत आपणाराह रेन मुठो रिथे। <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />जा वोर लेवीन सावाल हे, ता माय दाहवो ईसो ता एदम्यान द्‍वारे टुलो केरनु; जो मुरेह पुण मलकिसिदक ने जा वोर सावाल हे दोहवो ईसो तान द्‍वारे टुलो केरनु, जो पुस्तेकान नुसार एवी वोर जीवतालो हे। <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />ते आपु ज्य बी केय सेकतेह काय लेवी बी, जो दाहवो ईसो लिथे, अब्राहाम ने द्‍वारे मलकिसिदकाह दाहवो ईसो आपेल। <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />काहाकाय जेवी मलकिसिदक अब्राहामाह मिलानो, तुलबूखे ते लेवीन जेल्मो बी नाह ईयेल एतो, तु तान डायलान सेरीरा मायच ईतो।<verse eid="HEB 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />केदी लेवी चाकराय ने रितीन द्‍वारे आखो सापेड़ सेकतालो, ते काल्ला दिहरा चाकर्‍यान आवणेन गिरेज नाह एती? काहाकाय ज्यास ने देराव पोर माणहाह कायदो बी आपायेल ईतो। एक ओहला चाकर्‍यान काय गिरेज एती, जो मलकिसिदक ने रिती वालान एने नाह हारून ने रिती वालान। <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />काहाकाय जेवी चाकर्‍यान पोद बोदलाथे, ते कायदाह बी बोदेलनेन गिरेज हे। <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />एने जान बाराम जी वातु कियेल हेत्यु, तु काल्ला दिहरा गेराणान हे, एने ता गेराणान काल्लोस बी माणुह केदी वेदीन सेवक नाह रिनो। <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />ते ज्य साप हे काय आपणो मालीक यहुदान वोस माय रेन पायदा ईयेल ईतो, एने मुसा ता गेराणान केरता चाकर्‍यान पोद ने बाराम काईच वात नाह किऱ्यो।<verse eid="HEB 7:14" /></para>
  <para style="s">मलकिसिदक ने गेत दिहरो चाकर्‍यो</para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15" />एने जो काय आमु कियेल हेते, तो उंजु बी साप हे काय मलकिसिदक ने गेत एक दिहरो चाकर्‍यो बुणीह। <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />तो तान वोस ने नेमान देराव पोर नाह, पुण एक केदी नाह विणखेतेम एणार जीवाय ने सेक्तीन देराव पोर चाकर्‍यो बुणेल हे। <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />काहाकाय पुस्तेक किथे, “तुमू मलकिसिदक ने गेत कायेम ने केरता चाकऱ्या बोण जाहो।”<note caller="+" style="f"><char style="fr" closed="false">7:17 </char><char style="ft" closed="false">मलकिसिदक माय (देखी 5:6।)</char></note> <verse eid="HEB 7:17" /><verse number="18" style="v" sid="HEB 7:18" />पेल्लो कायदो ज्यानकेरता आंगे किरेल काहाकाय तो कोमजोर एने उदेड़ एतो। <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />ज्यानकेरीन मुसान कायदो कुणीह पुरो खिरो नाह केर सेकतालो। एने एवी एक हाजी आसा आपायेल हे जिन द्‍वारे आपु बोगवानान आहने आवतेह।<verse eid="HEB 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20" />एने ज्यी वात बी जोरवरी हे काय बोगवान यीशुह सुगोण ने द्‍वारे मुखी चाकर्‍यो बाणायेल ईतो। जेवी काय दिहराह बिगेर सुगोण नेच मुखी चाकर्‍यो बाणायेल एता। <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />पुण यीशु तेवी एक सुगोण केरीन चाकर्‍यो बुणेल ईतो, जेवी बोगवान ताह कियेल ईतो,</para>
  <para style="q1" vid="HEB 7:21">“मालीक सुगोण खाईल हे,</para>
  <para style="q2" vid="HEB 7:21">एने तो तान मोन केदी नाय बोदली:</para>
  <para style="q1" vid="HEB 7:21">तु कायेम ने केरता चाकर्‍यो बोणीन रिहे।”<verse eid="HEB 7:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="HEB 7:22" />पुण ज्या सुगोण ने कारेण यीशु एक हाजाला वायदान जामीन ठेरानो।<verse eid="HEB 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23" />एवी दिखो, ओहला मोकतास चाकऱ्या एता, जाह मोत तान पोद पोर बोणीन रेणे नाह देनी। <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />पुण यीशु जेलेम हे, तानकेरता तान चाकर्‍यान पोद कायेम रेय। <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />केरीन जा तान द्‍वारे बोगवान फाय आवतेह, तो तान पुरी रिती से सुटकारो केरने माय ताकेतवालो हे, काहाकाय तो तान केरता विन्ता केरनेन केरता जेलेमक्योस जीवतालो हे।<verse eid="HEB 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26" />उहलोस मुखी चाकर्‍यो आपणी गिरेज पुरी केर सेकी, जो चोखालो, विणदोसी, एने जा माय काय पाप नाह सुतो, एने पापीह रेन आंगे किरेल हे, एने हेरगाह रेन बी उचो विसायेल हे। <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />जान केरता दिहरा मुखी चाकर्‍यान गेत ताह गिरेज नाय रेय काय तो दाड़ीन दिह पेल तान पापान केरता उवतो पुशो माणहान पापान केरता बोली चेड़ावी। तो ते कायेम कायेमान केरता तान पापान केरता सोता आपणे आपाह बोलीदान केर दिनो। <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />काहाकाय मुसान कायदो माणहाह जा पुरा नाह सोता मुठलो चाकर्‍यो निवाड़ेह, पुण बोगवानान वायदो तान सुगोणा हिऱ्यो बाणायेल हे। जो वायदो कायदान पासाण आयेल हे, एने जो वायदो मुखी चाकर्‍यान रूप माय बेटाख निवाड़ेल, जो कायेम कायेम ने केरता हे पुरो बोणीन रिथे,<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="s">यीशु आपणो मुठलो चाकर्‍यो</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />जो काय आमु केतेह, तान मुखी वात ज्यी हे काय आपु फाय खेरीच एक उहलो मुखी चाकर्‍यो हे, जो हेरगा माय मोटला बोगवानान राजगादिन जीवड़े उगे जाय बुहेल हे, <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />तो चोखाला जागा पोर मतलब खेरला तोम्बु माय जाह बोगवान बाणायेल ईतो, नाह माणहान आथा केरीन। ती जागे तो मोटला चाकर्‍यान काम किरेह।<verse eid="HEB 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3" />काहाकाय एकेक मुखी चाकऱ्याह ज्यानकेरीन निवाड़नो काय तु बेट एने बोलीदान दुयाह बी चेड़ावी। एने केरीन ज्या मुखी चाकर्‍यान केरता बी ज्यो जोरवरी एतो काय ता फाय बी चेड़ावणेन केरता काह रेय। <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />केदी तो देरती पोर रितो ते तो केदी चाकर्‍यो नाय रितो, काहाकाय तो पेलुस रेन उहलो मुठलो चाकर्‍यो हे, जो यहुदि कायदान नुसार बेट चेड़ावतेह। <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />जो चाकर्‍यान पोद ने काम ता केरतेह तो हेरगा माय जो हे तान एक सावलो एने बाणावट हे। ज्यो तिहेस केरीन हे जेवी मुसा चोखालो तोम्बु बाणावण्योस ईतो, तेवी बोगवान ताह केयो, “एर मेल काय तु एकेक वोस्तु ठिक तास वेह रूपान गेत बाणावजी, जो तुवाह बोयड़ा पोर देखाड़ेल एतो।” <verse eid="HEB 8:5" /><verse number="6" style="v" sid="HEB 8:6" />पुण एवी जी चाकऱ्यान पोद ने सेवा यीशुह सापड़ेल हे, ती तान सेवा कामाह रेन हाजी हे, काहाकाय तो जा वायदान विचगालो हे। जो जुनाला वायदाह रेन हाजो हे, काहाकाय ज्य हाजी वोस्तुन देराव पोर बुणेल हे।<verse eid="HEB 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7" />काहाकाय केदी पेल्ला वायदा माय काय गेलती नाह रेणे, ते दिहरा वायदान केरता काय गिरेज नाह सोती। <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />पुण बोगवानाह ता माणहा माय दोस सापेड़नो एने तो केयो:</para>
  <para style="q1" vid="HEB 8:8">“मालीक किथे, दिखो, तो दिह आवीह,</para>
  <para style="q2" vid="HEB 8:8">जेवी मी इस्राएल ने माणहा हिऱ्यो, एने यहुदान माणहा हिऱ्यो एक नोवालो वायदो बांदुह।<verse eid="HEB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9" />ज्यो वायदो तोहलो नाय रेय जोहलो मी तान डायला हिऱ्यो तुलबूखे किरेल ईतो।</para>
  <para style="q2" vid="HEB 8:9">जेवी मी तान आथ देरीन मीस्र देसा माय रेन निकाल लायेल।</para>
  <para style="q1" vid="HEB 8:9">काहाकाय ता मार वायदा पोर बोरहावाला नाह रेना, जाह मी ता हिऱ्यो बांदिल ईतो,</para>
  <para style="q2" vid="HEB 8:9">केरीन मी ता उगे नाह इऱ्यो।<verse eid="HEB 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10" />उंजु मालीक किथे, काय जो वायदो मी ता दिह्यान पासाण इस्राएल ने माणहा हिऱ्यो बांदुह,</para>
  <para style="q2" vid="HEB 8:10">तो ज्यो हे काय मी मार कायदाह तान मोना माय टाकुह,</para>
  <para style="q1" vid="HEB 8:10">एने ताह तान मोना पोर लेखुह,</para>
  <para style="q1" vid="HEB 8:10">एने मी तान बोगवान ठेराह</para>
  <para style="q2" vid="HEB 8:10">एने ता मारा माणहे ठेराती।<verse eid="HEB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11" />ओवता एकेक जाण आपणा दोस्ती</para>
  <para style="q2" vid="HEB 8:11">एने आहेंल्याह ज्य हिक नाय आपी,</para>
  <para style="q2" vid="HEB 8:11">काय तुमू मालीकाह उलखो।</para>
  <para style="q1" vid="HEB 8:11">काहाकाय तेवी ते आत्या रेन मोठो वोर सोब माहु जाण लेती।<verse eid="HEB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12" />काहाकाय मी तान गुनान माफीन केरता किववालो रेह,</para>
  <para style="q2" vid="HEB 8:12">एने पुशो केदी तान पापाह एर नाय केरू।”<verse eid="HEB 8:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 8:13" />ज्या वायदाह नोवालो किन तो पेल्ला वायदाह जुनालो केर दिनो, जो जुनालो एने जिर जाथे, तो पोशो जेल्दीच मिटाय जाय।<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="s">देरती एने हेरगान बोक्ती</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />ता पेल्ला वायदा माय बी बोक्‍तीन नेम एतो, एने उहलो चोखालो जागु ईतो जो ज्या जेगान ईतो। <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />काहाकाय एक तोम्बु बाणायेल, पेल्ला तोम्बु माय दिवो, एने पाटलो, एने बेट किरेल रोटा एता; एने तो चोखालो जागु केवाह। <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />दिहरो पोड़दान पासाण तो तोम्बु ईतो, जो चोखालो जागु केवाथी। <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />ता माय होनान दुपदान, एने चार उगे रेन होना केरीन बाणायेल वायदान पेटी एने ज्या माय मन्ना माय बोरायेल होनान ठामलो, एने हारूनान डेंगी जी माय कोवला पांटा आव जायेल एता एने ता दुय दिगोड़ जा पोर उकुम लिखेल एता। <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />तान उपेर दुय तेजोमय करुब एता, जा प्रायश्‍चित डापाणे बुखेत सावलो केर रियेल एता; न्यान एकेक केरीन वर्णन केरनेन टेम नाह सुतो। <figure style="fig" alt="Interior of tabernacle" file="bk00278c.tif" size="span" copy="Horace Knowles ©" ref="9:2">बोक्‍तीन गेरान तोम्बुन माय वालो बाग</figure><verse eid="HEB 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6" />ज्यु वोस्तु जीस रिती माय तियार एय गीयुह। ता पेल्ला तोम्बु माय चाकऱ्या कुलबुखे बी रिगीन सेवान काम निवरावतेह। <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />पुण दिहरा माय मुखी चाकर्‍यो उलोस वोरीह बोर माय एकुस वार जाथे, एने बिगेर लुय लेन नाह जाणे; ती लुयीह तो तान केरता एने माणहान बुल चुकने केरता चेड़ावणे। <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />ज्याकेरीन चोखालो जीव ज्योस देखाड़ने काय जाह वोर पिल्लो तोम्बु उबरिनोह, ताह वोर चोखाला जागान वाट नाह देखानी। <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />ज्यो तोम्बु चालु कालान टेम ने केरता एक किस्सो हे; जा माय ओहली बेट एने बोलीदान चेड़ावणु, जाकेरीन बोक्ती केरनारान मोन खेरा नाह एय सेकते। <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />काहाकाय ज्या ते खाणे पिणेन एने बात बातीन चोखो केरनेन सारिरीक नेम हेते, एने बोगवानान द्‍वारा नोवालो नेम बोणनेन वोर लागु एतेह।<verse eid="HEB 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />पुण जेवी मसी आवणार हाजी वोस्तुन मुखी चाकर्‍यो बोणीन आवो, ते तो उंजु बी मोटला एने खेरला तोम्बु माय रेन बोणी, जो आथान बाणायेल नाह मतलब ज्या जेगान नाह।<note caller="+" style="f"><char style="fr" closed="false">9:11 </char><char style="ft" closed="false">सुरवात रेन न्याहरी, थोड़ाक लेख माय आयेल लिखेल हे।</char></note> <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />एने बोकड्या एने वासड़ान लुय ने द्‍वारे नाह पुण तास ने लुय ने द्‍वारे, एकुस वार चोखाला जागा माय रिगेल एने जेलेमक्यो सुटकारो सापड़ाव लिदो। <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />काहाकाय जेवी बोकड्यान एने बोयलान लुय एने हिलगेल वासड़ान रोखड़ाह नेम ने गेत एठा माणहा पोर हितेड़नेन वोजेसे ता चोखा एय जातेह, एने नेम ने गेत बाहेरली रितीन वोजेसे एठोपोणा जात रिथे। <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />ते मसी यीशुन लुय जो आपणे आपाह जेलेमकी जीवान द्‍वारे बोगवानान ओंगाण निर्दोस बेट चेड़ायेल, तुमरा मोनाह मुरेल कामा माय रेन काहा नाय चोखो केरी काय तुमू जीवताला बोगवानान सेवा किरो।<verse eid="HEB 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15" />ज्यानकेरता तो नोवाला वायदान विचगालो हे, काय तान मोतीन द्‍वारे जो पेल्ला वायदान टेम ने पापाह रेन सुटकारो सापड़ावणेन केरता ईयेल हे, हाजा माणहे वायदान गेत जेलेमक्या मिरासाह सापड़ाव लेय। <verse eid="HEB 9:15" /><verse number="16" style="v" sid="HEB 9:16" />काहाकाय जाहरी वायदो केरायेल हे ताहरी वायदो केरनारान मोतीह सोमेज लेणो बी जोरवरी हे। <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />काहाकाय ओहलो वायदो मोरने पोर पाको एणे, एने जाह वोर वायदो केरनार जीवतालो रिथे ताह वोर वायदो कामान नाह रेणे। <verse eid="HEB 9:17" /><verse number="18" style="v" sid="HEB 9:18" />केरीन पिल्लो वायदो बी बिगेर लुय ने नाह बांदायेल।<note caller="+" style="f"><char style="fr" closed="false">9:18 </char><char style="ft" closed="false">वायदो, मोतीन चिट्ठी एने वायदान केरता ग्रीक बाषा माय निस्तो एक सोबदो हे।</char></note> <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />काहाकाय जेवी मुसा सोब माणहाह कायदान एकेक उकुम होमलाव दियेल ते तो वासड़ा एने बोकड्यान लुय लेन, पाणी एने रातला फाड़का एने जुफा जाड़ान डेंगी हिऱ्यो, ता पुस्तेक पोर एने सोब माणहा पोर हितेड़ दिनो <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />एने केयो, “ज्यी ता वायदान लुय हे, जो उकुम बोगवान आपणी केरता आपेल हे।” <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />एने इहीचकेरीन तो तोम्बु एने सेवान सोब सामाना पोर लुय हितड्यो। <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />खेरो ते ज्य हे काय कायदा माय आखी वोस्तु लुय ने द्‍वारे चोखाली एय जाथे, एने बिगेर लुय वोयाड़ेल पापान माफी नाह।<verse eid="HEB 9:22" /></para>
  <para style="s">मसीन बोलीदान पापाह दुवेह</para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />तानकेरीन जोरवरी हे काय हेरगा मायवाली वोस्तुन गेतुच वेह ज्या बोलीदानान द्‍वारे चोखाला केराय जाय, पुण हेरगा मायवाली वोस्तु सोता न्याह रेन हाजा बोलीदानान द्‍वारे चोखाली केराय जाती। <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />काहाकाय मसी ता आथा केरीन बाणायेल चोखाला जागा माय, जो खेरला चोखाला जागान नमुनो हे, रिग्यो नाह पुण हेरगा मायस रिग्यो काय आपणे केरता एवी बोगवानान ओंगाण देखाय जाय। <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />ज्य नाह काय तो आपणे आपाह जाहार ताहार बोली चेड़ावी, जिहकेरीन काय मुखी चाकर्‍यो एकेक वोरीह दिहरान लुय लेन चोखाला जागा माय रिग्या केरने, <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />नाहते दुनियान सुरवाती रेन ताह जाहार ताहार दुख उखेलने पोड़तो; पुण एवीन कालान सेवली बुखेत तो एकुस वार देखायेल काहाकाय आपणास बोलीदानान द्‍वारे पापाह सिटो केर दे। <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />एने जिहकेरीन माणहान केरता एक वार मोरनु एने तान पासाण नियाव ठेरायेल हे, <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />जिहकेरीन मसी बी मोकतास ने पापाह उखेलनेन केरता एक वार बोली ईयेल; एने जा माणहे तान वाट जोवतेह तान सुटकारान केरता दिहरे वार बिगेर पाप उखलेल देखाय जाय।<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />काहाकाय कायदो ज्या माय आवणार हाजी वोस्तुन दिवो हे; पुण तान हासलीन वेह नाह, तानकेरीन ता एकुस बातीन बोलीन द्‍वारे जो एकेक वोरीह बिगेर चुकी चेड़ावतेह, आहने आवणाराह केदी बी खेरो नाह केर सिकेत। <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />नाहते तान बोली चेड़ावणो बोंद काह नाह एय जात? ज्यानकेरीन जेवी सेवा केरनारे एकुस वार चोखा एय जाता, ते उंजु तान मोन ताह पापी नाय ठेरावतो। <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />पुण तान द्‍वारे एकेक वोरीह पापान एर केऱ्या केरनो। <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />काहाकाय ज्यो नाह एण्यो हे काय बोयलान एने बोकड्यान लुय पापाह सेटो केरी।<verse eid="HEB 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5" />तानकेरीन मसी दुनिया माय आवणे बुखेत किथे:</para>
  <para style="q1" vid="HEB 10:5">“बोली एने बेट तु नाह हुदेत,</para>
  <para style="q2" vid="HEB 10:5">पुण मार केरता एक सेरीर तियार किरेल।<verse eid="HEB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6" />होम बोली एने पाप बोली केरीन तु खुस नाह ईनो।<verse eid="HEB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7" />तेवी मी कियेल, ‘जिहकेरीन पुस्तेक माय लिखेल हे, देख, मी न्या हे,’</para>
  <para style="q2" vid="HEB 10:7">एय मारा बोगवान, मी तारी मोरजी पुरी केरने आयेल हे।”<verse eid="HEB 10:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 10:8" />उपेर ते तु किथे, “नाह तु बोली एने बेट एने होम बोल्यीह एने पाप बोल्यीह हुद्यो, एने नाह ताकेरीन खुस ईनो,” ज्यी बोल्यी ते कायदा माय चेड़ावणो। <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />पुशो ज्य बी किथे, “हुमेल, मी आव लागेल हे काय तारी आसा पुरी केरू,” तु पेल्लाह उठाड़ दिथे काय दिहराह बोणावी। <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />तीस आसा माय आपु यीशु मसीन सेरीरान एकुस वार बोली चेड़नेन द्‍वारे चोखा एय जायेल हेते। <figure style="fig" alt="Burnt offering on an altar" file="hk00256c.tif" size="col" copy="Horace Knowles ©" ref="10:10">वेदी पोर बोली</figure><verse eid="HEB 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11" />एकेक चाकर्‍यो ते उबरीन दाड़ीन दिह सेवा किरेह, एने एकुस बातीन बोलीह जो पापाह केदी बी सेटो नाह केर सिकेत, तालताल चेड़ावतेह। <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />पुण ज्यो एदमी ते पापान बोदले एकुस बोली जेलेम ने केरता चेड़ावीन बोगवानान जीवड़े जाय बुहेल हे। <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />एने तुलबूखे रेन ज्यो वाट जुवीह, काय तान दुसमोन तान पाया बुंदेन चोवकी बोणी। <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />काहाकाय तो एकुस बोलीन द्‍वारे ताह जा चोखा एय जातेह, कायेम ने केरता खेरा केर दियेल हे।<verse eid="HEB 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15" />एने चोखालो जीव बी आपुह ज्‍यीस गोवाय किथे; काहाकाय तु पेल कियेल ईतो,<verse eid="HEB 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16" />“मालीक किथे काय जो वायदो मी ता दिह्यान पासाण</para>
  <para style="q2" vid="HEB 10:16">ता हिऱ्यो केरूह तो ज्यो हे काय</para>
  <para style="q1" vid="HEB 10:16">मी मारा कायदाह ताह मोना पोर लेखुह</para>
  <para style="q2" vid="HEB 10:16">एने मी तान विवेक माय टाकुह।”<note caller="+" style="f"><char style="fr" closed="false">10:16 </char><char style="fq" closed="false">“मालीक किथे काय जो वायदो मी ता दिह्यान पासाण ता हिऱ्यो केरूह तो ज्यो हे काय मी मारा कायदाह ताह मोना पोर लेखुह एने मी तान विवेक माय टाकुह।” </char><char style="ft" closed="false">यिर्मया 31:33</char></note><verse eid="HEB 10:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="HEB 10:17" />पुशो तो ज्य किथे, “मी तान पापाह एने तान एदेरमान कामाह पुशो केदी एर नाय केरू।” <verse eid="HEB 10:17" /><verse number="18" style="v" sid="HEB 10:18" />एने जेवी तान माफी एय जायेल हे, ते उंजु पापान बोली नाह रेनी।<verse eid="HEB 10:18" /></para>
  <para style="s">बोगवानान आहने जाता</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />ज्यानकेरीन एय बाय बोणहा, जेवी आपुह यीशुन लुय ने द्‍वारे ता नोवाली एने जिवताली वाटी केरीन चोखाला जागा माय रिगणेन ईमोत एय जायेल हे, <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />जो तो पोड़दान द्‍वारे मतलब तान खुद ने सेरीर ने द्‍वारा एन नोवालो एने जीवताली वाटीन माद्यम उगाड़ दियेल हे। <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />एने ज्यानकेरीन काय आपणो उहलो मुठलो चाकर्‍यो हे, जो बोगवानान गेरान आदिकारी हे, <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />ते आवो, आपु खेरला मोना केरीन एने आखा बोरहा हेऱ्या, एने मोनान दोस ने बावना चोखो केरनेन केरता मोना पोर लुय हितड़ीन, एने सेरीराह चोखाला पाण्या केरीन दोवीन बोगवानान आहने जाता। <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />आवो आपु आपणी आसान अंगीकाराह मोजबुती माय देरीन रेता, काहाकाय जो वायदो किरेल हे, तो खिरो हे; <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />एने मोंग, एने हाजाला कामा माय उहरावणेन केरता आपु एका दिहरान चिन्ता केऱ्या केरता, <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />एने एका दिहरा हेऱ्या एकठा एणेन नाय सोड़ी, जिहकेरीन काय कोलाक ने रिती हे, पुण एका दिहराह उत्साहित केरती रिवो; एने जीहे जीहे ता दिह्याह आहने आवतालो दिखहो तिहे तिहे उंजु बी ज्यो केऱ्या किरो।<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />काहाकाय खेरायीन ओलखात सापड़ावणेन पासाण केदी आपु जाण बुजीन पाप किरते रेहु, ते पापान केरता उंजु काल्लीस बोली बाकी नाह सोती। <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />होव, डेंड ने एक बिय एने वाट जोवणो एने आक्‍ठान जिर बाकी हे जो विरोद केरनाराह खेतेम केर देय। <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />जेवी मुसान कायदाह नाह माणनारे, दुय नाहते तीन जाणान गोवाय पोर, बिगेर गीण केरीन माराय जातालो। <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />ते विचार केर लिवो काय तो कोलोक बारो डेंडान लायेक ठेराय, जो बोगवानान बेटाख पाया केरीन चेदेल एने वायदान लुयीह, जी केरीन तो चोखालो ठेरायेल ईतो, एठो किरेल हे, एने गीण ने जीवान अपमान किरेल हे। <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />काहाकाय आपु ताह जाणतेह, जो कियेल, “बुदलो लेणेन मारो काम हे, मीच बुदलो आपुह।” एने पोशो ज्य काय “मालीक तान माणहान नियाव केरी।” <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />जीवताला बोगवानान आथा माय पोड़ने बिय आवी ओहली वात हे।<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />पुण ता पासाणल्या दिह्याह एर किरो, जा माय उजेड़ सापड़ावीन दुखान मोटली वेला माय थोबीन रेना। <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />केदी केदी ते ज्य काय तुमू चिहटा एने सेताव वेठतेन तामाशो बोणना, एने केदी ज्य काय तुमू तान हाती बोणना जान वेला पुड़ेल एती। <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />काहाकाय तुमू ता पोर बी गीण केऱ्या जा जेली माय एता, एने तुमरो मालदेन बी खुसी माय चोराणे देना; ज्यो सोमजीन काय तुमू फाय एक उंजु बी हाजो एने जेलेमक्योस थोबणार मालदेन हे। <verse eid="HEB 10:34" /><verse number="35" style="v" sid="HEB 10:35" />केरीन ईमोत मा सोड़ो काहाकाय तान फोल मोटलो हे। <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />काहाकाय तुमूह दिर खाणो जोरवरी हे, काहाकाय बोगवानान आसाह पुरी केरीन तुमू वायदान फोल सापड़ावहो। <verse eid="HEB 10:36" /><verse number="37" style="v" sid="HEB 10:37" />काहाकाय पुस्तेक किथे:</para>
  <para style="q1" vid="HEB 10:37">“एवी जुलूम कोम टेम रेय जायेल हे,</para>
  <para style="q2" vid="HEB 10:37">जेवी काय आवणार आवी;</para>
  <para style="q2" vid="HEB 10:37">एने वार नाय लागाड़ी।<verse eid="HEB 10:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="HEB 10:38" />पुण मारो देरमी जाण बोरहा केरीन जीवतालो रेय;</para>
  <para style="q2" vid="HEB 10:38">एने केदी तो पासाण एय जाय,</para>
  <para style="q2" vid="HEB 10:38">ते मारो मोन ता पोर खुस नाय एय।”<verse eid="HEB 10:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="HEB 10:39" />पुण आपु सेटा एणारे नाह सोता काय खेतेम एय जाहु, पुण बुरहो केरनारे हेते काय जीवाह वोचाड़ी।<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="s">बुरहो</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />एवी बुरहो आसा किरेल वोस्तुन निश्चय, एने बिगेर दिखेल वोस्तुन पुरावो हे। <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />काहाकाय ज्यास बोरहान द्‍वारे डायलाह बोगवान फाय रेन बोड़ाय जुड़नी। <verse eid="HEB 11:2" /><verse number="3" style="v" sid="HEB 11:3" /><note caller="+" style="x"><char style="xo" closed="false">11:3 </char><char style="xt" closed="false"><ref loc="JHN 1:3">योहान 1:3</ref></char></note>बोरहास केरीन आपु जाण लेतेह काय आखी दुनिया बोगवानान वचना केरीन बुणेल हे। पुण ज्य नाह काय जो काय देखाह, तो दिखेल वोस्तु केरीन बुणेल एय।<verse eid="HEB 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4" />बोरहा केरीस ने हाबील केनाह रेन हाजी बेट बोगवानान केरता चेड़ायेल, एने ताच ने द्‍वारे ताह देरमी रेणेन गोवाय बी दियेल, काहाकाय बोगवान तान बेटीन बाराम गोवाय दियेल; एने तास ने द्‍वारे तो मोरीन बी एवी वोर वातु किरेह। <verse eid="HEB 11:4" /><verse number="5" style="v" sid="HEB 11:5" />बोरहास केरीन हनोक विसाय जायेल काय मोतीह नाय देखी, एने तान पुतो नाह लागनो काहाकाय बोगवान ताह विस लियेल ईतो, एने ताह विसाय जाणेन पेल तान ज्यी गोवाय एती काय तो बोगवानाह खुस किरेल हे। <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />एने बोरहान बिगेर ताह खुस केरनो नाह एण्यो हे; काहाकाय बोगवानान आहने आवणाराह बुरहो केरने जुवे काय तु हे, एने ताह होदणाराह फोल आपेह। <verse eid="HEB 11:6" /><verse number="7" style="v" sid="HEB 11:7" />बोरहास केरीन नुह ती वातुन बारामाय जी तुलबूखे नाह देखाताल्यु, चेतावणी लेन बोक्ती हिऱ्यो तान गेराणाह वोचाड़नेन केरता डोंडह्यो बाणायो, एने तान द्‍वारे तु दुनियाह दोसी ठेरायेल; एने ता देरमान वोस रिनो जो बोरहा केरीन ईथे।<verse eid="HEB 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8" />बोरहास केरीन अब्राहाम जेवी आयेल ईतो ते उकुम मानेन ओहली जागे निकेल गीयो जाह मिरास माय लिण्यो ईतो; एने ज्य नाह जाणतालो काय मी का जाथु, तीबी निकेल गीयो। <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />बोरहास केरीन तो वायदो किरेल देसा माय, पारका देसा माय पारकान गेत, रेन इसहाक एने याकुब हिऱ्यो, जा ता हेऱ्या तास वायदान वोस एता, तोम्बु माय रेना। <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />काहाकाय अब्राहाम ता मोजबुत पायावाला गावान वाट जोवतालो, ताह हिचाड़णार एने बाणावणार बोगवान हे। <verse eid="HEB 11:10" /><verse number="11" style="v" sid="HEB 11:11" /><note caller="+" style="f"><char style="fr" closed="false">11:11 </char><char style="ft" closed="false">बोरहान द्‍वारे सोरा। तो; थोड़ाक लेख माय बोरहान द्‍वारा खुद साराह दिह रेना, ती सोराह पायदा केरनेन केरता जुलूम डुकेर एय जायेल एती। तीबी लिखेल हे। </char></note> बोरहा केरीन सारा सोता डुकेर एती तीबी पेटावाली एणेन ताकेत सापड़ावेह, काहाकाय ती वायदो केरनाराह खीरलो सोमजेल एती। <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />इहीचकेरीन एकुस जाणा पोर रेन जो मुरेलान गेत एतो, जुगान तारा एने देरीयान रेटीन गेत मोजाय नाय ओलाक वोस पायदा एना।<verse eid="HEB 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13" />ज्या आखा बोरहास ने हाल माय मुरेल; एने ता वायदो किरेल वोस्तुह नाह सापड़ाया, पुण ताह सिटेस रेन देखीन खुस एना एने मान लेदा काय आपु देरती पोर पारका एने बाहेरल्या हेते। <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />जा ओहली वातु केणु, ता देखाड़तेह काय स्वदेसाह होदणे बाजरेनाह। <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />एने जा देसा माय रेन ता निकेल आयेल एता, केदी ताह एर केरता ते ताह वोल जाणेन टेम ईतो। <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />पुण ता एक हाजा मतलब हेरगावाला देसान अबिलाषी हेते; केरीन बोगवान तान बोगवान केवाणेन नाह लाजवाणे, काहाकाय तो तान केरता हियोर तियार किरेल हे।<verse eid="HEB 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17" />बोरहास केरीन अब्राहाम, पारखाणे बुखेत, इसहाकाह बोली चेड़ायेल; एने तो वायदाह खेरो मानेल ईतो <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />एने जाह ज्यो कियेल एतो, “इसहाक पोर रेन तारी वोस केवाय,” तोस तान एकलोताह बेट चेड़ावणेन केरता तियार ईतो। <verse eid="HEB 11:18" /><verse number="19" style="v" sid="HEB 11:19" />काहाकाय तो जाण लियेल ईतो, काय बोगवान ताकेतवालो हे काय ताह मुरेल माय रेन जिवाड़ी; ताच माय रेन किस्सान रिती पोर तो ताह पुशो मिलानो। <verse eid="HEB 11:19" /><verse number="20" style="v" sid="HEB 11:20" />बोरहास केरीन इसहाक याकुब एने एसावाह आवणाऱ्यु वातुन बाराम बोरकेत आप्यो। <verse eid="HEB 11:20" /><verse number="21" style="v" sid="HEB 11:21" />बोरहास केरीन याकुब मोरने बुखेत युसूफ ने दुय बेटाख माय रेन एक एकाह बोरकेत आप्यो, एने तान डेंगीन टेका पोर आसरो लेन बोगवानान बोक्ती किऱ्यो। <verse eid="HEB 11:21" /><verse number="22" style="v" sid="HEB 11:22" />बोरहास केरीन युसूफ, जेवी मोरनेस केरतालो, ते इस्राएल ने सोरा निकेल जाणेन वात केऱ्या, एने तान आड़ान बारा माय उकुम किऱ्यो।<verse eid="HEB 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23" />बोरहास केरीन मुसान आहख आबोख ताह, पायदा एणेन पासाण तीन मोयना वोर लिकाड़ मेल्या, काहाकाय ता देख्या काय सोरो सुंदर हे, एने ता राजान उकुमाह नाह बिना। <verse eid="HEB 11:23" /><verse number="24" style="v" sid="HEB 11:24" />बोरहास केरीन मुसा सियानो एन फिरोनान बेटीख ने बिटोख केवातालो केरीन नाकाऱ्यो। <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />ज्यानकेरीन काय ताह पापा माय थोड़ाक दिह्यान हुक बोगणे रेन बोगवानान माणहा हिऱ्यो दुख बोगणेन गाडोह हाजो लागनो। <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />तो मसीन कारेण निन्दीत एणेन केरता मीस्र ने बण्‍डाराह रेन मोटलो मालदेन सुमज्यो, काहाकाय तान डोला फोल सापड़ावणेन उगे लाग रियेल एता। <verse eid="HEB 11:26" /><verse number="27" style="v" sid="HEB 11:27" />बोरहास केरीन राजान रागाह नाह बिन तो मीस्राह सोड़ दिनो, काहाकाय तो नाह दिखेल ताह सुमजो देखतीन मोजबुत रिनो। <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />बोरहास केरीन तु फसह एने लुय हितेड़नेन विदी मान्यो, काय पेल पायदा ईयेल खेतेम केरनार इस्राएल्या पोर आथ नाय टाकी।<verse eid="HEB 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29" />बोरहास केरीन ता रातला देरीयान ती उगे इहकेरीन उतेर गीया, जिहकेरीन हुकील बुय पोर रेन; एने जेवी मीस्री तोहलोच केरने होद्या ते आखा बुड़ीन मोर गीया। <verse eid="HEB 11:29" /><verse number="30" style="v" sid="HEB 11:30" />बोरहास केरीन यरीहो हेयरान बितड़ो, जेवी ता हात दिह वोर तान कावदेन फिर लेदा, ते तो जाय पोड़नो। <verse eid="HEB 11:30" /><verse number="31" style="v" sid="HEB 11:31" />बोरहास केरीन राहाब वेश्या उकुम नाह माणनारा हेऱ्यी खेतेम नाह एनी, ज्यानकेरीन काय ती खोबर्‍याह होमालीन मिलेल एती।<verse eid="HEB 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32" />एवी उंजु काय केव? काहाकाय टेम नाह सुतो काय गिदोनान, एने बाराक एने शिमशोनान, एने यिफतहान, एने दाऊद एने शमुएलान, एने जाणकारान बाराम केव। <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />न्या बोरहास ने द्‍वारे राज जिकेल; देरमान काम किरेल; वायदो किरेल वोस्तु सापड़ायेल; सिहान मुये बोंद किरेल; <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />आक्‍ठान जिराह हेलो किरेल; तेलवारीन दारीह रेन वोच निकलेल; कोमजोरी माय तेगड़ा ईयेल; लेड़ाय माय बाहदुर निकलेल; पारका देसान सिपायाह दितेन दोवड़ाया। <verse eid="HEB 11:34" /><verse number="35" style="v" sid="HEB 11:35" />बायकु त्युन मुरेल ताह पोशु जीव उठेल देख्यु; कोलाक ते मार खाते खातेन मोर गीया एने सुटकारो नाह होद्या, ज्यानकेरीन काय हाजाला पोशा जीवणान गोवांद्या रेती। <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />कोलाक मोजाक उड़ावणेन; एने चापका खाणेन एने बांदाय जाणेन, एने जेल माय देराणेन द्‍वारे पारखाय गिल्या। <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />डेगड़ाठाय गिल्या; दाऱ्या केरीन चिराय गिल्या; ता गेरबाय माय, एने वेला माय, एने दुख बोगतीन, मेंड्रान एने बोकड्यान चामड़ा पांगरीन, न्यान ता मोऱ्या मोऱ्या फिरना; <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />एने जेंगला, माय एने बोयड़ा, माय एने गुफा माय, एने देरतीन बुयारा माय बोटेकतेन फिरना जेग तान लायेक नाह एतो।<verse eid="HEB 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39" />बोरहास ने द्‍वारे न्या सोबान बाराम हाजी गोवाय दियेल हे, तीबी ताह वायदो किरेल वोस्तु नाह जुड़नी। <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />काहाकाय बोगवान आपणी केरता पेलुस रेन एक हाजी वात ठेरायेल ईतो। काय ता आपणी बिगेर सिद्दता फाय नाय पोची।<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="s">बोगवान आमरो आबोख</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />ज्यानकेरीन जेवी काय गोवाय देणारान ओहलो मुठलो वादलो आपु कोंड रेनोह, ते आवो, एकेक रोकणार वोस्तु एने फासाड़नार पापाह सेटो केरीन, ती दुवेड़ जी माय आपुह दोवेड़नो हे, दिर केरीन दोवेड़ता, <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />एने बोरहाह बाणावणार एने खेरो केरनार यीशुन उगे टिंगते रेता, जो ती खुसीन केरता जी तान ओंगाण दिरेल ईतो, लाज ने काईच चिन्ता नाह केरीन खुरूसखाम ने दुख विठेल, एने बोगवानान राजगादिन जीवड़े उगे जाय बुहेल हे।<verse eid="HEB 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 12:3" />तानकेरीन ता पोर मोन लागाड़ो, जो आपणा विरोदा माय पापीन ओलो विरोद वेठ लियेल काय तुमू नाराज एन ईमोत नाय सोड़ दिहो। <verse eid="HEB 12:3" /><verse number="4" style="v" sid="HEB 12:4" />पाप ने विरोद माय तुमूह ओलो वेठणे नाह पोड़नो काय तुमूह लुय वोयाड़ने पोड़नो एय; <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />एने तुमू ती हिकेह, जी तुमूह बेटाख ने गेत जुड़ेह, विहरी जायेल हेते:</para>
  <para style="q1" vid="HEB 12:5">“एय मार सोरा, मालीकान सिक्शाह उदेड़ वात मा सोमजे,</para>
  <para style="q2" vid="HEB 12:5">एने जेवी तो तुवाह गुड़के ते ईमोत मा सोड़हे।<verse eid="HEB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6" />काहाकाय मालीक जाह मोंग केरने, ताह सिक्शा बी आपणे,</para>
  <para style="q2" vid="HEB 12:6">एने जाह बिटोख बोणाव लेणे, ताह चापका केरीन बी देणे।”<verse eid="HEB 12:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="HEB 12:7" />तुमू दुखाह सिक्शा सोमजीन विठ लिवो; बोगवान तुमूह बेटाख सोमजीन तुमू हिऱ्यो व्यवहार केरने। तो काल्लो बिटोख हे जाह आबोख सिक्शा नाह आपणे? <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />केदी ती सिक्शा जान हाती आखा एतेह, तुमूह सिक्शा नाह जुड़नी, ते तुमू सोरा नाह, पुण सिनालान सोरा ठेराय। <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />पोशो जेवी आपणो सारिरीक आबोख बी आपुह सिक्शा आपताला एने आपु तान आदर केऱ्या, ते काय जीवान आबाख ने उंजु बी ताबाम नाय रिज्यो जाकेरीन आपु जीवताला रेहु। <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />ता ते आपणा आपणा सोमेज ने गेत थोड़ास दिह्यान केरीन सिक्शा आपताला, पुण तो ते आपणा फायदान केरता हे, आपु बी तान चोखालान हाती बोण जाहु। <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />चालुकाला माय बात बातीन सिक्शा खुसीन नाह सोती, पुण दुखास ने देखाथी; तीबी ताह वेठते वेठतेन पाका एय जायेल हेते, ओवतो ताह हुका हेऱ्यो देरमान फोल जुड़ेह।<verse eid="HEB 12:11" /></para>
  <para style="s">हिक एने चेतावणी</para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12" />केरीन डिल्ला आथाह एने कोमजोर गुटण्याह सिदा किरो, <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />एने तुमरा पायान केरता सिदी वाट बाणावो काय लेंगड़ो बोटकी नाय पुण हाजो हुदरी जाय।<verse eid="HEB 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />आखा हेऱ्या मेल किरो, एने ता चोखालाह होदणारे बुणो जान बिगेर कुण मालीकाह केदीच नाय देख सेकी। <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />हास केरीन देखती रिवो, ओहलो नाय एय काय कुण बी बोगवानान गीणीह रेन एंजाणल्यो रेय जाय, नाहते ईखेह मानलो मुल फुटीन तेकलीत देय, एने तान द्‍वारे मोकतास माणहे एठा एय जाती। <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />ओहलो नाय एय काय ईखेह जाण सिनालो केरनार, नाहते एसाव ने गेत विण देरमी रेय जो एक टेमान रोटान बोदले तान पेल पायदा एणेन पोद वेच दिनो। <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" /><note caller="+" style="f"><char style="fr" closed="false">12:17 </char><char style="ft" closed="false">तो ताह हुद्यो; नाहते तो बोरकेत सापड़ावणेन केरता कोसीत किऱ्यो।</char></note>तुमू जाणतेह काय पासाण रेन जेवी तो बोरकेत लेणे हुद्यो ते नेचो गेणाय गीयो, एने रेड़ रेड़ीन बोरकेत सापड़ावणे हुद्यो, पुण तो तान किरेल ने पासतावो नाह किर सीक्‍यो।<verse eid="HEB 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />तुमू ते ता बोयड़ान आहने, जो सापेल सेकताला, एने आक्‍ठा केरीन उजालो ईतो, एने काल्ली गटा, एने आंदारो, एने वादोणान आहने, <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />एने पावलीन आवाज, एने बोलनारान ओहला बोलान आहने नाह आवा, जाह होमेलनारे विन्ता केऱ्या काय एवी आमु हेऱ्या उंजु वातु नाय केरने जुवे। <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />काहाकाय ता ता उकुमाह नाह वेठ सेकना: “केदी काल्लो जेनवेर बी बोयड़ाह सापली ते ताह देगड़ा केरीन देती।” <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />एने तो दर्शन बियावी ओहलो एतो काय मुसा केयो, “मी जुलोम बिथु एने कापथु।”<verse eid="HEB 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22" />पुण तुमू सियोन बोयड़ान आहने, एने जीवताला बोगवानान हियोर, हेरगा मायवालो यरूशलेम एने एजारो हेरोगदुत ने खुसीन सबा माय पुचेल हेते। <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />एने ता पहिलोठान सादो पुंचो एने मोंडली, ज्युन नावे हेरगा माय लेखायेल हेते, एने आखान नियाव केरनार बोगवाना फाय, एने खेरा ईयेल देरमीन जीव, <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />एने नोवाला वायदान विच माय यीशु एने हितेड़नेन ता लुय ने आहने आवाह, जो हाबीलान लुयाह रेन हाजी वातु किथे।<verse eid="HEB 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25" />हास केरीन रिवो, एने ता केणाराह हेऱ्या रेन मुय मा फिरावो, काहाकाय ता माणहे देरती पोर चेतावणी आपणाराह रेन मुय फिरावीन नाह वोच सेकना, ते आपु हेरगा माय रेन चेतावणी आपणाराह रेन मुय फिरावीन किहीक वोच सेकहु? <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />तुलबूखे ते तान बोल देरतीह आलाड़ दियेल एतो, पुण एवी तो जो वायदो किरेल हे, “एक वार पुशो मी देरतीह उलोस नाह पुण जुगाह बी आलाड़ देह।” <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />एने ज्य वाक्य “एक वार पोशो” ज्यी वातुह देखाड़ीह काय जी वोस्तु आल जाथे, ती बुणेल वोस्तु हेत्यु तानकेरीन टेल जाती; काहाकाय जी वोस्तु आलेत नाह, मोजबुत बोणीन रेय। <verse eid="HEB 12:27" /><verse number="28" style="v" sid="HEB 12:28" />जेवी आपुह एक ओहलो राज जुड़ने बाजरेनोह जो केदी आलेस नाय। ते आवो आपु दन्यवादी एय जाता, एने बोक्ती, एने बिय हेऱ्या बोगवानान ओहली आरादना केरता जाकेरीन तो खुस ईथे; <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />काहाकाय आपणो बोगवान खेतेम केरनार आक्‍ठो हे।<verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="s">मसीन गेत जिवाय जीवणेन निर्देश</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />बाय बोणहान मोंग बोणीन रेय। <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />पावणाह नमस्‍कार केरनेन मा विहेरहो, काहाकाय ज्यान द्‍वारे कोलाक माणहे नाह सोमजीन हेरोगदुतान आदर नमस्‍कार किरेल हेते। <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />केदीह इहकेरीन एर किरो सुमजो काय ता हेऱ्या तुमू बी बोंदी हेते, एने जा हेऱ्या खाराब ईथे, तान बी ज्यो सोमजीन एर किरो काय आपणो बी सेरीर हे। <verse eid="HEB 13:3" /><verse number="4" style="v" sid="HEB 13:4" />वाराड़ आखा माय आदर ने वात मानाणे जुवे, एने वाराड़ान आथरोण चोखाली मिलो, काहाकाय बोगवान सिनालो केरनारान, एने पाराई बायकु हेऱ्यो पाप केरनारान नियाव केरी। <verse eid="HEB 13:4" /><verse number="5" style="v" sid="HEB 13:5" />तुमरो सोबाव बिगेर लालुस वालो रेणे जुवे, एने जो तुमू फाय हे तास केरीन हुकेह जीवो; काहाकाय तो सोतास कियेल हे, “मी तुवाह केदी नाय सोडु, एने केदी नाय त्यागु।” <verse eid="HEB 13:5" /><verse number="6" style="v" sid="HEB 13:6" />केरीन आमु बिगेर बिन केतेह,</para>
  <para style="q1" vid="HEB 13:6">“मालीक मारो राखवाल हे,</para>
  <para style="q2" vid="HEB 13:6">मी नाय बिव;</para>
  <para style="q1" vid="HEB 13:6">माणुह मारो काय केर सिकेह।”<verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />जा तुमरा अगुवा एता, एने जा तुमूह बोगवानान वचन होमलायेल हेते, ताह एर मिलो; एने हास केरीन तान बोलनो चालनो देखीन तान बोरहान होस किरो। <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />यीशु मसी काल एने आज एने कायेम एक हारकोस हे। <verse eid="HEB 13:8" /><verse number="9" style="v" sid="HEB 13:9" />बात बातीन खाराब हिक केरीन मा बोटेक जाहो, काहाकाय मोनान गीण केरीन मोजबुत रेणो हाजो हे, नाह काय ती खाणेन वोस्तु जी पोर काम मेलनाराह काईच फायदो नाह ईनो। <verse eid="HEB 13:9" /><verse number="10" style="v" sid="HEB 13:10" />आमरी एक ओहली वेदी हे जी पोर रेन खाणेन आदिकार ता माणहाह नाह सुतो, जा तोम्बु माय सेवा केरतेह। <verse eid="HEB 13:10" /><verse number="11" style="v" sid="HEB 13:11" />काहाकाय जा जेनवेरान लुय मुखी चाकर्‍यो पापान बोलीन केरता चोखाला जागा माय ली जाणे, तान देड़ गावान बाहेर हेलगाड़नु। <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />ज्यानकेरीन, यीशु बी माणहाह तास ने लुयीन द्‍वारे चोखा केरनेन केरता हेडान बाहेर दुख उखलेल। <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />केरीन आवो, आमु ता फाय गावान बाहेर जाता, एने तान अपमान माय बागी एता। <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />काहाकाय न्या आपणो काल्लोस जागावालो हियोर नाह सोतो, पुण आपु एक आवणारा हेयराह होदतेह। <verse eid="HEB 13:14" /><verse number="15" style="v" sid="HEB 13:15" />तानकेरीन आपु तान द्‍वारे स्तुती रूपी बोली, जो ता ओठान फोल हे जा तान नावाह स्वीकार केरतेह, बोगवानाह जेलेमक्यास चेड़ाया केरी। <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />हाजो केरने एने उदारता देखाड़णेन मा विहरो, काहाकाय बोगवान ओहली बोली केरीन खुस एणे।<verse eid="HEB 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17" />तुमरा अगुवान उकुम मानो एने तान ताबाम रिवो, काहाकाय ता तान गेत तुमरा जीवान केरता जाकता रेतेह जाह लेखो आपणे पोड़ी; ता ज्य काम खुसी माय केरती, नाह काय पेल्‍ली हाह ली लेन, काहाकाय ज्यी हाल माय तुमूह काय फायदो नाय एय।<verse eid="HEB 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18" />आमरी केरता विन्ता किरते रिवो, काहाकाय आमुह बुरहो हे काय आमरो मोन चोखो हे: एने आपु आखी वातु माय हाजी चाल चालने होदतेह। <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />विन्ता केरनेन मी तुमूह उंजु बी सोमजाड़थु काय मी जेल्दी तुमरी फाय पुशो आव सेकु।<verse eid="HEB 13:19" /></para>
  <para style="s">आखरी विन्ता</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />
    <note caller="+" style="f">
      <char style="fr" closed="false">13:20 </char>
      <char style="ft" closed="false">तान लुय; नाहते तान खुद ने अर्पण किरेल मोत केरीन। </char>
    </note>एवी हुक वालो बोगवान, जो आपणा मालीक यीशुह जो मेंड्रान मुठलो राखवाल हे जेलेमक्यास लुयीन गुणा केरीन मुरेल माय रेन जिवाड़ेन लियावो, <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />तुमूह एकेक हाजी वातु माय खेरो केरी, ताकेरीन तुमू तान आसा पुरी किरहो, एने यीशु मसीन द्‍वारे तो आपु माय त्यु आख्‍यु वातु पायदा केरी, जो ताह पुटेह। मसीन बोड़ाय जेलेमक्योस इते रेय। आमेन।<verse eid="HEB 13:21" /></para>
  <para style="s">आखरी सोबदा</para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />एय बाय बोणहा, मी तुमूह विन्ता केरथु काय ती हिक ने वातुह वेठ लिवो, काहाकाय मी तुमूह जुलूम सारांश माय लिखेल हे। <verse eid="HEB 13:22" /><verse number="23" style="v" sid="HEB 13:23" />मारी मोरजी ज्यी हे काय तुमूह मालुम पोड़ी काय तीमुथीयुस आपणो बाहख सुट जायेल हे, एने केदी तो जेल्दी आव जाय, ते मी ता हिऱ्यो मिलने आवुह।<verse eid="HEB 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24" />तुमरा आखा अगुवाह एने आखा चोखाला माणहाह नमस्‍कार किवो। इटली वाला तुमूह नमस्‍कार केतेह।<verse eid="HEB 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25" />तुमरे आखा पोर गीण इते रेय। आमेन।<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>