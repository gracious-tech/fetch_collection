<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TH" style="id">- Nahali</book>
  <para style="h">2 थिस्सलुनिक्यो</para>
  <para style="toc3">2 थिस्सलुनिक्यो</para>
  <para style="toc2">2 थिस्सलुनिक्यो</para>
  <para style="toc1">थिस्सलुनिक्यो पौलुस लिखेल दुसरो पोत्रो</para>
  <para style="mt2">थिस्सलुनिक्यो पौलुस ने लिखा हुआ दुसरा पत्र</para>
  <para style="mt1">थिस्सलुनिक्यो पौलुस लिखेल दुसरो पोत्रो</para>
  <para style="imt">ओलखात</para>
  <para style="ip">ज्यो पोत्र थिस्सलुनिक्योह प्रेरित पौलुस लिखेल ईतो <char style="xt"><ref loc="2TH 1:1">1:1</ref></char> पेल्लो पोत्र लेखीन पासाण ज्यो पोत्र कोमीत कोमी मसीन 51 साल पासाण पौलुस ज्यो पोत्र लिखेल जेवी तो ज्यो पोत्र लिखेल तेवी तो कुरिंथीयो हेयराम ईतो ज्यो पोत्र थिस्सलुनिक्यो मोंडलीह लिखेल ज्यी मोंडलीह पौलुस तान दिहरी वारी सेवाम जाणे बुखेत बाणायेल ईतो <char style="xt"><ref loc="ACT 17:1-10">प्रेरितान काम 17:1-10</ref></char> प्रेरितान कामा बाराम ज्यो लिखेल हे मोंडली माय थोड़ाक यहुदि एने थोड़ाक बिगेर यहुदि माणहे एता।</para>
  <para style="ip">ज्यी मोंडलीन माणहे सेवली टेमीन एने मालीकान दिहरी वारीन आवणेन बारामाय थिस्सलुनिक्योन माणहाह जाणनेन केरता जुलूम आसा एती तानकेरता पौलुस तान दुयू बी पोत्री माय चेरचा किरेह ज्यी दिहरी पोत्री हे कोमीत कोमी आदो ईसो आखरी टेमीन बाराम लिखेल हे, ज्या पौलुस जा आलह्या हेते ताह बी चेतावणी आपी एने इही किथे काय आखा एदमी सोतान पेट बोरनेन केरता काम केरी <char style="xt"><ref loc="2TH 3:6-10">3:6-10</ref>।</char></para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. पौलुस सोतान तान हातीन ओलखात केरावेह। <char style="ior"><ref loc="2TH 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. पौलुस बोगवानाह थिस्सलुनिक्यो मोंडलीन केरता दन्यवाद किरेह एने तानकेरता विन्ता किरेह। <char style="ior"><ref loc="2TH 1:3-12">1:3-12</ref></char></para>
  <para style="io1">3. आखरी टेमीन बाराम चेरचा। <char style="ior"><ref loc="2TH 2:1-15">2:1-15</ref></char></para>
  <para style="io1">4. आलह्यान बाराम हिक एने काम केरनेन बाराम पौलुसान जोरेवरी हिकवोण। <char style="ior"><ref loc="2TH 3:1-15">3:1-15</ref></char></para>
  <para style="io1">5. पौलुस मोंडलीन बाराम पोशो नमस्‍कार किरेह। <char style="ior"><ref loc="2TH 3:16-18">3:16-18</ref></char></para>
  <chapter number="1" style="c" sid="2TH 1" />
  <para style="s">नमस्‍कार एने दन्यवाद</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 17:1">प्रेरितान काम 17:1</ref>
      </char>
    </note>मी पौलुस सिलवानुस एने तीमुथीयुस हिऱ्यो ज्यो पोत्रो लेखथु आमरा आबाख बोगवानान एने मालीक यीशु मसीन माणहाह थिस्सलुनिक्योन मोंडली माय हेते,<verse eid="2TH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2TH 1:2" />बोगवान आबाख एने यीशु मसीन उगे रेन तुमूह गीण एने सान्ती जुड़ती रेय।<verse eid="2TH 1:2" /></para>
  <para style="s">नियाव ने दिह</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3" />एय बाय बोणहा, आमुह तुमरा बाराम आखी टेम बोगवानान दन्यवाद किरते रेणे जुवे, एने ज्योस लायकीन हे, ज्यानकेरता काय तुमरो बुरहो जुलूम वोड़ती जाथे, एने तुमू आखान मोंग आपसाम जुलूम वोड़ती जाथे। <verse eid="2TH 1:3" /><verse number="4" style="v" sid="2TH 1:4" />एने न्या वोर काय आमु खुद बोगवानान मोंडली माय तुमरा बाराम मोठाय केरतेह, एने जोला सेताव एने दुख तुमू वेठतेह, ता आखा माय तुमरो दिर एने बुरहो देखाथी।<verse eid="2TH 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 1:5" />ज्यो बोगवानान खेरला नियाव ने साप साप पुरावो हे काय तुमू बोगवानान राज ने लायकीन ठेराहो, जान केरता तुमू दुख वेठणे बाजरेनाह। <verse eid="2TH 1:5" /><verse number="6" style="v" sid="2TH 1:6" />बोगवानान आहने ज्यो नियाव हे काय जा तुमूह दुख देतेह, ताह बोदला माय दुख आपी। <verse eid="2TH 1:6" /><verse number="7" style="v" sid="2TH 1:7" />एने तुमू जो दुख वेठतेह, आमरी हेऱ्यो तुमूह आराम आपी; तुलबूखे जेवी मालीक यीशु तान ताकेतवाला हेरोगदुता हिऱ्यो जेजेलताली आक्‍ठा माय हेरगाम रेन आवी। <verse eid="2TH 1:7" /><verse number="8" style="v" sid="2TH 1:8" />एने जा बोगवानाह नाह ओलेखते एने आपणा मालीक यीशुन हाजाली खोबरीह नाह मानते, ताह डेंड आपी। <verse eid="2TH 1:8" /><verse number="9" style="v" sid="2TH 1:9" />ओहला माणहे मालीक ने ओंगाण रेन एने तान ताकेतीन तेजाह रेन सेटा एन जेलेमक्या खेतेमान डेंड होद्ती। <verse eid="2TH 1:9" /><verse number="10" style="v" sid="2TH 1:10" />ज्यो ते दिह एय, जेवी यीशु तान चोखाला माणहाम बोड़ाय होदणे एने आखा बुरहो केरनाराम बोंगलाणेन कारीन एणेन केरता आवी। एने तुमू बी ता माय बाग लिहो; काहाकाय आमरी गोवाही पोर तुमू बुरहो किरेल एता। <verse eid="2TH 1:10" /><verse number="11" style="v" sid="2TH 1:11" />ज्यानकेरीन आमु कायेम तुमरी केरता बोगवानाह ओहलीस विन्ता केरतेह, ता जीवणान लायकीन सोमजो जा माय तो तुमूह हादिल हे। एने आखी बोलायीन मोरजी एने बोरहान आखा कामाह ताकेत माय पुरो केरी। <verse eid="2TH 1:11" /><verse number="12" style="v" sid="2TH 1:12" /><note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="ft" closed="false">आमरा बोगवानान एने आमरा मालीक ने, नाहते आमरो बोगवान एने मालीक।</char></note>आमरो बोगवान एने मालीक यीशु मसीन गीणान द्‍वारे मालीक यीशु मसीन नाव तुमू माय बोड़ाय जुड़ने जुवे, एने तुमू ता माय।<verse eid="2TH 1:12" /></para>
  <chapter eid="2TH 1" />
  <chapter number="2" style="c" sid="2TH 2" />
  <para style="s">खाराब माणुह</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:1 </char>
      <char style="xt" closed="false">
        <ref loc="1TH 4:15-17">1 थिस्सलुनिक्यो 4:15-17</ref>
      </char>
    </note>एय बाय बोणहा, एवी आपु आपणा मालीक यीशु मसीन आवणेन, एने ता हेऱ्यो आपणो एकठो एणेन बाराम तुमूह विन्ता केरथु, <verse eid="2TH 2:1" /><verse number="2" style="v" sid="2TH 2:2" />एने बोगवाना फाय रेन आवणार खुबेर, पारचार, नाहते पत्रान द्‍वारे जो आमरी उगे रेन एनोह, ज्यो सोमजीन काय मालीकान दिह आहने आव पोचनोह, ते तुमू उचकाहुच नाराज एने दुखी मा ईहो। <verse eid="2TH 2:2" /><verse number="3" style="v" sid="2TH 2:3" />काल्ली बी बातीन कुणी फाय रेन ठेगाहु मा; जाह वोर बोगवानान विरोद सेवल्यो देंगो नाय एय, ताह वोर खाराब माणुह नाय आवी। जो नेरगान आक्‍ठा माय टाकाएन खेतेम एय जाय। <verse eid="2TH 2:3" /><verse number="4" style="v" sid="2TH 2:4" />तो खाराब माणुह विरोद किरेह, एने आखाह जा देव, मुखी केवाथे, सोताह ताह रेन मुठलो ठेरावी, एने न्या वोर काय तो बोगवानान मोंदिर माय बोहीन सोताह देव ठेरावीह। <verse eid="2TH 2:4" /><verse number="5" style="v" sid="2TH 2:5" />जेवी मी तुमू हिऱ्यो ईतो तेवी ज्यी वातु तुमूह कियेल ईतो, तुमूह इर नाह सोती काय? <verse eid="2TH 2:5" /><verse number="6" style="v" sid="2TH 2:6" />तुमू ती वातुह जाणतेह, ज्यी ताह आवणे माय एवी रोक रेनीह। पुण ठिख टेम माय तो खाराब माणुह आवी। <verse eid="2TH 2:6" /><verse number="7" style="v" sid="2TH 2:7" />काहाकाय एदेरमान लिकायेल ताकेत एवी बी काम किरेह, पुण एवी एक रोकणार हे, एने जाह वोर तो सिटो नाय एय जाय ताह वोर रोक रेय। <verse eid="2TH 2:7" /><verse number="8" style="v" sid="2TH 2:8" />तेवी तो कायदान विरोद केरनार खाराब माणुह आवी, एने जेवी यीशु आवी तेवी तान मुया केरीन फुकीन मार टाकी, एने तान आवणेन विजाला केरीन खेतेम केरी। <verse eid="2TH 2:8" /><verse number="9" style="v" sid="2TH 2:9" /><note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="MAT 24:24">मत्ती 24:24</ref></char></note>ता खाराब माणहान आवणो सैतानान ताकेत हेऱ्यो आखी बातीन खोटी ताकेत, एने चोमेत्कार, एने बोंगलाय ओहला कामा हेऱ्यो आवी। <verse eid="2TH 2:9" /><verse number="10" style="v" sid="2TH 2:10" />एने खेतेम एणारा माणहान केरीन आखी बातीन दोकाम फासाड़नेन केरता अन्याय ने कामान वापेर केरी; काहाकाय ता खेरायीह मोंग नाह केऱ्या काय ता माणहान सुटकारो एतो। केरीन ता खेतेम एय जाती। <verse eid="2TH 2:10" /><verse number="11" style="v" sid="2TH 2:11" />एने ता जुठा पोर बुरहो केरती केरीन बोगवान तान विचीम बोटकावणार ताकेत मोकली। <verse eid="2TH 2:11" /><verse number="12" style="v" sid="2TH 2:12" />काहाकाय जा माणहे खेराय पोर बुरहो नाह केरती, पुण खाराब काम केरनेन केरता खुस एतेह, ता आखाह डेंड जुड़ी।<verse eid="2TH 2:12" /></para>
  <para style="s">मोजबुत बोणीन रिवो</para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13" />
    <note caller="+" style="f">
      <char style="fr" closed="false">2:13 </char>
      <char style="ft" closed="false">पेल ने गेत; थोड़ाक लेख माय सुरवात रेन लिखेल हे।</char>
    </note>एय बाय बोणहा, एने बोगवानान मोंगाल्ला माणहे, आमुह तुमरा बाराम कायेम बोगवानान दन्यवाद केरती रेतेह; काहाकाय बोगवान तुमूह सुरवाती रेन निवाड़ लियेल हे काय चोखाला जीवान द्‍वारे चोखाला बोणीन, एने खेराय पोर बुरहो केरीन सुटकारो लिवो। <verse eid="2TH 2:13" /><verse number="14" style="v" sid="2TH 2:14" />एने ज्यी हाजाली खुबेर आमु तुमूह होमलायेल तान द्‍वारे तुमूह हादिल हे, काय तुमू आमरा बोड़ाय ने यीशु मसी माय जोड़ाय सेकी। <verse eid="2TH 2:14" /><verse number="15" style="v" sid="2TH 2:15" />तान केरता एय बाय बोणहा, मोजबुत रिवो; एने जी जी वातु तुमू आमु फाय रेन पत्री एने वचनान द्‍वारे हिकेल हेते, ताह देरीन रिवो।<verse eid="2TH 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 2:16" />आपणो मालीक यीशु मसी खुद, एने आपणो आबोख बोगवान, जो आमुह मोंग किऱ्यो एने गीण माय जेलेमक्यो दिलासो एने हाजी आसा आपेल हे, <verse eid="2TH 2:16" /><verse number="17" style="v" sid="2TH 2:17" />बोगवान तुमरा मोना माय दिलासो आपी एने आखा हाजा काम केरनेन केरता एने वचन माय मोजबुत केरी।<verse eid="2TH 2:17" /></para>
  <chapter eid="2TH 2" />
  <chapter number="3" style="c" sid="2TH 3" />
  <para style="s">विन्ता केरनेन केरता पौलुस केणे</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1" />एवी एय बाय बोणहा, आमरी केरता विन्ता केरती रिवो काय मालीक ने खुबेर उतवाल्योह पोसरती जाय, काय माणहे ताह मान सम्मान हेऱ्यो स्वीकार केरी; जिहकेरीन तुमू माय एनोह। <verse eid="2TH 3:1" /><verse number="2" style="v" sid="2TH 3:2" />एने आपु वाकड़ा एने खाराब माणहाह रेन वोचीन रेहु, काहाकाय एकेक माणुह बोगवानान खुबेर पोर बुरहो नाह किरेत।<verse eid="2TH 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 3:3" />पुण मालीक बोरहावालो हे; तो तुमूह मोजबुत केरी एने सैतानाह रेन होमालीन मेली। <verse eid="2TH 3:3" /><verse number="4" style="v" sid="2TH 3:4" />मालीक माय आमुह तुमू पोर बुरहो हे, काय जो जो उकुम आमु तुमूह आपतेह, ताह तुमू मानतेह, एने मानती बी रिहो। <verse eid="2TH 3:4" /><verse number="5" style="v" sid="2TH 3:5" />बोगवानान मोंग एने मसीन दिर ने उगे रेन मालीक तुमरा मोना माय तुमूह ईमोत आपी।<verse eid="2TH 3:5" /></para>
  <para style="s">आलहाय केरनाराह चेतावणी</para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6" />एय बाय बोणहा, आपणा मालीक यीशु मसीन नावा माय आमु तुमूह उकुम आपतेह, एने तुमू एकेक ओहला विश्वासी बाय बोणहा रेन आलेग रिवो जा खाराब चाल चालतेह, एने जी हिकवोण आमु फाय रेन होमलेल हे तान गेत नाह केरती। <verse eid="2TH 3:6" /><verse number="7" style="v" sid="2TH 3:7" />आमरे गेत किहीक चालने जुवे तो तुमूह खुद मालुम हे, काहाकाय आमु तुमरी विचीम आलह्या नाह एता। <verse eid="2TH 3:7" /><verse number="8" style="v" sid="2TH 3:8" />एने आमु कुणीन बी फुकेट रूटो नाह खादा, पुण तुमू माय रेन कुणी पोर बी बार नाय एय केरीन आमु मेहनेत एने केस्ट केरीन रात ने दिह काम दुंदो किरेल। <verse eid="2TH 3:8" /><verse number="9" style="v" sid="2TH 3:9" />ज्यो नाह सोतो काय आमुह तुमू फाय रेन काह मांगणेन आदिकार नाह, पुण ज्यानकेरता काय आपणा आपाह तुमरी केरता हाजो गोवाह बोणावी काय तुमू आमरी गेत चाली। <verse eid="2TH 3:9" /><verse number="10" style="v" sid="2TH 3:10" />काहाकाय आमु तुमू फाय एता, तेवी बी आमु तुमूह ओहली उकुम आपेल एता, “केदी एगदो काम केरने नाह हुदीत, ते तो खाणे बी नाय जुवे।” <verse eid="2TH 3:10" /><verse number="11" style="v" sid="2TH 3:11" />आमु होमेलतेह काय थोड़ाक माणहे तुमरी विची माय आलह्या हेते, एने कायच काम दुंदो नाह केरती पुण दिहरान कामाम आथ टाक्या केरतेह। <verse eid="2TH 3:11" /><verse number="12" style="v" sid="2TH 3:12" />ओहला माणहाह आमु मालीक यीशु मसी माय उकुम आपतेह एने सोमजाड़तेह, काय हास केरीन जीवाय जिवी एने काम काज केरीन रूटो खाया केरी। <verse eid="2TH 3:12" /><verse number="13" style="v" sid="2TH 3:13" />पुण एय बाय बोणहा, हाजो काम केरनेम ईमोत मा सोड़ो।<verse eid="2TH 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TH 3:14" />केदी एगदो आमरी जी पत्रीन वातुह नाय मानी ते ता पोर नेजेर मीलो, एने ता हेऱ्यो हेंगात मा किरहो, काय ताह लाज आवी। <verse eid="2TH 3:14" /><verse number="15" style="v" sid="2TH 3:15" />तीबी ताह दुसमोन मा सुमजो, पुण विश्वासी हाती जाणीन सोमजाड़ो।<verse eid="2TH 3:15" /></para>
  <para style="s">आखरी नमस्‍कार</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16" />मालीक सोता सान्तीन मुल हे तुमूह आखी बातीन जेलेम सान्ती आपी, एने मालीक तुमू आखा हिऱ्यो कायेम रेय।<verse eid="2TH 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2TH 3:17" />मी, पौलुस, मारा खुद ने आथा केरीन नमस्‍कार लेखथु। एने मारी आखी पत्री माय मारो ज्‍यीस निसाणी हे; मी इहीचकेरीन लेखथु। <verse eid="2TH 3:17" /><verse number="18" style="v" sid="2TH 3:18" />आमरा मालीक यीशु मसीन गीण तुमू आखा पोर एती रेय।<verse eid="2TH 3:18" /></para>
  <chapter eid="2TH 3" />
</usx>