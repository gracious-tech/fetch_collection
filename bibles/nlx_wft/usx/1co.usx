<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CO" style="id">- Nahali</book>
  <para style="h">1 कुरिंथीयो</para>
  <para style="toc3">1 कुरिंथीयो</para>
  <para style="toc2">1 कुरिंथीयो</para>
  <para style="toc1">कुरिंथीयो पौलुस लिखेल पेल्लो पोत्रो</para>
  <para style="mt2">कुरिंथीयो पौलुस ने लिखा हुआ पहला पत्र</para>
  <para style="mt1">कुरिंथीयो पौलुस लिखेल पेल्लो पोत्रो</para>
  <para style="imt">ओलखात</para>
  <para style="ip">प्रेरित पौलुस ज्यी पोत्री यीशुन जेल्मान 55 साल बाद लिखेल। <char style="xt"><ref loc="1CO 1:1">1:1</ref></char> पौलुस कुरिंथीयोन ज्‍यु दुय पोत्रु लिखेल त्युम रेन ज्यी पेल्‍ली पोत्री हे। पौलुसान मोरजी एती काय तो मकादुनिया जाय, एने जाणे बुखेत एने आवणे बुखेत कुरिंथीन माणहाह बेटाहु मकादुनियान जाणेन पेल तो ज्यो पोत्र लिख्यो तेवी तान रेणो इफिसुस हेयरा माय एतो। <char style="xt"><ref loc="1CO 16:5-9">16:5-9</ref></char></para>
  <para style="ip">पौलुसाह कुरिंथीयोन मोंडली माय ज्‍यु बात बातीन समस्या चालने बाजरियेल एती तान जाणकारी ताह जुड़ेल एती, ज्यान जापाप आपणेन केरता पौलुस ज्यो पोत्र लिख्यो कुरिंथीयोन हियोर खाराब एने सिनालान गेत कामे केरनेन बाराम नाव लायेल एतो, तानकेरता ज्यो स्वबाविक एतो काय ओहली समस्या मोंडली माय बी आव लागेल एती। ज्यी दुसरा कुरिंथीयोन पोत्री माय मोंगान बाराम नाव लायेल अद्याय हे तान बी समावेश हे। <char style="xt"><ref loc="1CO 13:1-13">13:1-13</ref></char></para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. पौलुस ने कुरिंथीयोह नमस्‍कार एने तान केरता बोगवानान दन्यवाद। <char style="ior"><ref loc="1CO 1:1-9">1:1-9</ref></char></para>
  <para style="io1">2. मोंडली माय फुटने बाराम होमलेल तान जापाप आपणे। <char style="ior"><ref loc="1CO 1:10-4:21">1:10–4:21</ref></char></para>
  <para style="io1">3. सिनालो एने खाराब कामान समस्यान बाराम जापाप आपणे। <char style="ior"><ref loc="1CO 5-6">5–6</ref></char></para>
  <para style="io1">4. वाराड़ान एने मुरतीन चेड़ावो, होवटालान आरादना एने जीवान दान एने पोशो जीव उठणेन बाराम। <char style="ior"><ref loc="1CO 7-15">7–15</ref></char></para>
  <para style="io1">5. वेवारीक एने व्यक्तिगत मुद्दान बाराम। <char style="ior"><ref loc="1CO 16:1-24">16:1-24</ref></char></para>
  <chapter number="1" style="c" sid="1CO 1" />
  <para style="s">परिचय</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1" />पौलुसान उगे रेन जो बोगवानान मोरजी माय यीशु मसीन प्रेरित बोणनेन हादाय गीयो, एने बाहख सोस्थिनेसान उगे रेन, <verse eid="1CO 1:1" /><verse number="2" style="v" sid="1CO 1:2" /><note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="ACT 18:1">प्रेरितान काम 18:1</ref></char></note>बोगवानान ती मोंडलीन नाव जो कुरिंथीयोन गावा माय हेते, मतलब ता मसी यीशु माय एक एणेन केरीन चोखा केराय गीया, एने चोखा एणेन केरता हादाड़ेल हेते, एने तान सोबान नाव बी जा आखी जागे आमरो एने तुमरो मालीक यीशु मसीन नावा माय विन्ता केरतेह;<verse eid="1CO 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 1:3" />आपणा आबाख ने बोगवानान एने मालीक यीशु मसीन उगे रेन तुमूह गीण एने हुक जुड़ते रेय।<verse eid="1CO 1:3" /></para>
  <para style="s">मसी यीशु पोर बुरहो केरनेन द्‍वारे बोरकेत</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4" />मी तुमरा बाराम आपणा बोगवानान उपकार जेलेमक्युस मानथु, केरीन बोगवानान जी गीण तुमू पोर मसी यीशु माय एनीह। <verse eid="1CO 1:4" /><verse number="5" style="v" sid="1CO 1:5" />काय तुमू मसी माय एक एणेन कारेण तुमू आखी वातु माय मतलब आखो वचन एने आखी इकेल माय मालदार एय गीयाह। <verse eid="1CO 1:5" /><verse number="6" style="v" sid="1CO 1:6" />काय आमरी खुबेर यीशु मसीन बारा माय तुमू माय मोजबुत निकेलनी। <verse eid="1CO 1:6" /><verse number="7" style="v" sid="1CO 1:7" />ज्यानकेरीन काय काल्लास बोरकेत माय तुमूह कोमी नाय एय, जिहकेरीन तुमू आमरा मालीक यीशु मसीन आवणेन वाट जोवते रेतेह। <verse eid="1CO 1:7" /><verse number="8" style="v" sid="1CO 1:8" />तो तुमूह मोजबुत केरीन मेली सेवली वार वोर काय तुमू आमरा मालीक यीशु मसीन पोशो आवणेन दिह निर्दोस ठेराणे जुवे। <verse eid="1CO 1:8" /><verse number="9" style="v" sid="1CO 1:9" />बोगवान विश्वासयोग्य हे, एने तान सुरो मसी यीशुन सेंगेती माय आपुह हादेल हे।<verse eid="1CO 1:9" /></para>
  <para style="s">मोंडलीन मेल मिलाप माय फुट</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10" />एय बाय बोणहा, मी तुमूह आपणा मालीक यीशु मसीन नावा माय विन्ता केरथु, काय तुमू सोब एकुच वात किवो एने तुमरे माय फुट नाय पोड़ने जुवे, पुण एकुच मोन एने एकुच होमच्‍यो केरीन मिलीन रिवो। <verse eid="1CO 1:10" /><verse number="11" style="v" sid="1CO 1:11" />एय मार बाय बोणहा, खलोए ने गेराणान माणहे माहु तुमरा बारा माय कियेल हेते, काय तुमरे माय राड़ एणे बाजरेनीह। <verse eid="1CO 1:11" /><verse number="12" style="v" sid="1CO 1:12" /><note caller="+" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="ACT 18:24">प्रेरितान काम 18:24</ref></char></note>मारो केणेन मतलब ज्यो हे काय तुमरा माय रेन काल्लोह ते आपणा आपाह “पौलुसान,” काल्लोह “अपुल्लोसान,” काल्लोह “केफान,” ते काल्लोह “मसीन,” किथे। <verse eid="1CO 1:12" /><verse number="13" style="v" sid="1CO 1:13" /><note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false">मसीन विबाजन किरेल हे: थोड़ाक लेख माय मसीन विबाजन एय नाह सिकेत।</char></note>काय मसी वाटाय गीयो? काय पौलुस तुमरे केरता खुरूसखाम पोर चेड़ गीयो? काय तुमूह पौलुसान नावा पोर बपतीस्मा जुड़नो? <verse eid="1CO 1:13" /><verse number="14" style="v" sid="1CO 1:14" /><note caller="+" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="ACT 18:8">प्रेरितान काम 18:8</ref>; </char><char style="xt" closed="false"><ref loc="ACT 19:29">प्रेरितान काम 19:29</ref>; <ref loc="ROM 16:23">रोमीयो 16:23</ref></char></note>मी बोगवानान दन्यवाद केरथु काय क्रिस्पुस एने गयुसाह सोड़ीन मी तुमरा माय रेन कुणीह बी बपतीस्मा नाह दिनो। <verse eid="1CO 1:14" /><verse number="15" style="v" sid="1CO 1:15" />तान केरता कुण नाय केय का तुमूह मार नावा माय बपतीस्मा जुड़ेल। <verse eid="1CO 1:15" /><verse number="16" style="v" sid="1CO 1:16" /><note caller="+" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="1CO 16:15">1 कुरिंथीयो 16:15</ref></char></note>एने होव, मी स्तिफनुसान गेराणाह बी बपतीस्मा केऱ्यो, एने न्याह सोड़ीन मी नाह जाणेत काय मी उंजु कुणीन बपतीस्मा केऱ्यो। <verse eid="1CO 1:16" /><verse number="17" style="v" sid="1CO 1:17" />काहाकाय मसी माहु बपतीस्मा केरनेन नाह, पुण हाजाली खुबेर होमलावणे मुकलेल हे, ज्यी खुबेर माणहान एकेलीन गेत होमलावणेन नाह, तान केरता काय मसीन खुरूसखाम पोर मोरनेन ताकेत फालतुक नाय खोवाय।<verse eid="1CO 1:17" /></para>
  <para style="s">मसी बोगवानान इकेल एने ताकेत हे</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18" />काहाकाय खुरूसखाम किस्सो खेतेम एणे जाणे बाजरिनोह तान केरता फोगवाय हे, पुण आमु सुटकारो सापड़ावणारान केरता बोगवानान ताकेत हे। <verse eid="1CO 1:18" /><verse number="19" style="v" sid="1CO 1:19" />काहाकाय देरेम पुस्तेक माय लिखेल हे,</para>
  <para style="p" vid="1CO 1:19">“मी इकेल वालान इकेलाह खेतेम केरूह, एने सोमेजदारान सोमेजाह नाकार केर देह।” <verse eid="1CO 1:19" /><verse number="20" style="v" sid="1CO 1:20" />केरीन का रेनी इकेल? का रिनो देरेमगुरू? का रिनो जी दुनियान बोलाचाल केरनार? काय बोगवान दुनियान इकेलाह फोगवाय नाह ठेरायो। <verse eid="1CO 1:20" /><verse number="21" style="v" sid="1CO 1:21" />काहाकाय जेवी बोगवानान एकेलीन गेत दुनियान इकेल माय बोगवानाह नाह सोमज्या ते बोगवानाह ज्यो हाजो लागनो काय ज्या पारचारान “फोगवायान” द्‍वारे बुरहो केरनेवाला सुटकारो आपी। <verse eid="1CO 1:21" /><verse number="22" style="v" sid="1CO 1:22" />यहुदि माणहाह ते चोमेत्कारान निसाणी जुवे, एने युनानी इकेल होदतेह। <verse eid="1CO 1:22" /><verse number="23" style="v" sid="1CO 1:23" />पुण आमु ते ता खुरूसखाम पोर चेड़ायेल मसीन पारचार केरतेह, जो यहुदि माणहान केरता ठोकरान कारेण एने दिहरी जातीन माणहान केरता फोगवाय हे; <verse eid="1CO 1:23" /><verse number="24" style="v" sid="1CO 1:24" />पुण जाह हादिल हे, काय यहुदि काय दिहरी जातीन माणहे, तान जागे मसी बोगवानान ताकेत एने बोगवानान इकेल हे। <verse eid="1CO 1:24" /><verse number="25" style="v" sid="1CO 1:25" />काहाकाय बोगवानान फोगवाय माणहान इकेलाह रेन इकेल वालो हे; एने बोगवानान कोमजोरी माणहान जोराह रेन जुलूम जोरवार हेते।<verse eid="1CO 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26" />एय बाय बोणहा, तुमूह हादाड़ेल तान ते सुचो काय नाह सेरीरान गेत जुलूम इकेल वाला, एने नाह जुलूम ताकेत, एने जुलूम मालदार नाह हेते। <verse eid="1CO 1:26" /><verse number="27" style="v" sid="1CO 1:27" />पुण बोगवान देरतीन फोगाह निवाड़ लियेल हे, काय इकेल वालाह लाजवाड़े एने बोगवान देरतीन कोमजोराह निवाड़ लियेल हे, काय जोरवाराह लाजवाड़े, <verse eid="1CO 1:27" /><verse number="28" style="v" sid="1CO 1:28" />एने जी वातु दुनियान नेजेर माय नेची एने जा आपणे आपाह मी कायच नाह सुतो केरीन सोमेजतेह ताह बोगवान निवाड़ लिदो, काय जी वातु एने वोस्तु दुनियान नेजरी माय मोहत्वान हेत्यु, ताह पालतुक ठेरावी। <verse eid="1CO 1:28" /><verse number="29" style="v" sid="1CO 1:29" />बोगवान ओहलो किऱ्यो, काहाकाय काल्लो बी जेनवेर तान ओंगाण मोठवाय नाय केरी। <verse eid="1CO 1:29" /><verse number="30" style="v" sid="1CO 1:30" />बोगवान आपु मसी यीशु माय समर्पित केरीन एक एणेन केरता हादिल हे, एने बोगवान आमरे केरता मसीह इकेल बाणायो। एने तान द्‍वारे नियाव केरनार, एने चोखा एने सुटकारो जुड़ेल ठेरायु। <verse eid="1CO 1:30" /><verse number="31" style="v" sid="1CO 1:31" />काहाकाय जीहे लिखेल हे तिहेस एय, “जो मोठवाय केरी तो मालीक माय मोठवाय केरी।”<verse eid="1CO 1:31" /></para>
  <chapter eid="1CO 1" />
  <chapter number="2" style="c" sid="1CO 2" />
  <para style="s">खुरूसखाम पोर चीड़ेल मसीन बारा माय खुबेर</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1" />एय बाय बोणहा, जेवी मी बोगवानान मालमात होमलाव तीन तुमू फाय आवुह,<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">बोगवानान लिकायेल खेराय; थोड़ाक लेख माय बोगवानान बाराम पुरावो लिखेल हे।</char></note> तेवी बोल नाहते इकेल हाजाला हिऱ्यो नाह आवो। <verse eid="1CO 2:1" /><verse number="2" style="v" sid="1CO 2:2" />काहाकाय मी ज्यो ठाण लियेल ईतो, काय तुमरे विच माय यीशु मसी मतलब खुरूसखाम पोर चेड़ायेल मसीह सोड़ीन दिहरी काल्लीस वातीह नाह जाणेत। <verse eid="1CO 2:2" /><verse number="3" style="v" sid="1CO 2:3" /><note caller="+" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="ACT 18:9">प्रेरितान काम 18:9</ref></char></note>मी कोमजोर माय बिय हिऱ्यो एने जुलूम कापते कापतेन तुमरी फाय आवो; <verse eid="1CO 2:3" /><verse number="4" style="v" sid="1CO 2:4" />मार वचन एने मार पारचार माय एकेलीन लालचावणेन वातु नाह, पुण बोगवानान जीवान ताकेतीन पुरावो ईतो। <verse eid="1CO 2:4" /><verse number="5" style="v" sid="1CO 2:5" />ज्यानकेरता काय तुमरो बुरहो माणहान इकेल पोर नाह पुण बोगवानान ताकेती पोर टिकीन रेय।<verse eid="1CO 2:5" /></para>
  <para style="s">बोगवानान इकेल</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6" />तीबी निट माणहाम आमु इकेल होमलावतेह पुण ज्यी दुनियान एने ज्यी दुनियान खेतेम एणेवाला आदिकारीन इकेल नाह; <verse eid="1CO 2:6" /><verse number="7" style="v" sid="1CO 2:7" />पुण आमु बोगवानान तो लिकायेल इकेल, मालमात ने रिती पोर केतेह, जाह बोगवान केल बाणावणेन पेलुच रेन आमरी बोड़ाय ने केरता निवाड़ेल हे। <verse eid="1CO 2:7" /><verse number="8" style="v" sid="1CO 2:8" />जाह ज्यी दुनियान आदिकारी माय रेन कुणीस नाह जाण्यो, काहाकाय केदी ता जाणता ते बोड़ाय वाला उजालान मालक्याह खुरूसखाम पोर नाय चेड़ावता। <verse eid="1CO 2:8" /><verse number="9" style="v" sid="1CO 2:9" />पुण जीहे लिखेल हे:</para>
  <para style="q1" vid="1CO 2:9">“जी वातु डोला नाह देख्या एने कान नाह होमल्या,</para>
  <para style="q2" vid="1CO 2:9">एने जी वातु माणहान मोनाम आवी नाह,</para>
  <para style="q2" vid="1CO 2:9">त्यु आखो बोगवान आपणा मोंग मेलनारान केरता तियार किरेल हे।”<verse eid="1CO 2:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="1CO 2:10" />
    <note caller="+" style="f">
      <char style="fr" closed="false">2:10 </char>
      <char style="ft" closed="false">पुण; थोड़ाक लेख माय कारेण</char>
    </note>पुण बोगवान ताह आपणो जीवान द्‍वारे आमु पोर देखाड़ेल हे, काहाकाय जीव सोब वातु मतलब बोगवानान मिठ्यु वातु बी पारखेह। <verse eid="1CO 2:10" /><verse number="11" style="v" sid="1CO 2:11" />माणहा माय रेन कुण काल्ली माणहान वातु जाणेह, माणहान जीव उलुस जी वातुह जाणेह जो ता माय हे, तिहेस बोगवानान वातु बी कुणीस नाह जाणेत, पुण बोगवानान जीव उलुस। <verse eid="1CO 2:11" /><verse number="12" style="v" sid="1CO 2:12" />पुण आपु माय दुनियान जीव नाह, पुण जो जीव जुड़ेल हे तो बोगवानान उगे रेन हे, काय आपु ती वातुह जाणी जी बोगवान आपुह आपेल हे। <verse eid="1CO 2:12" /><verse number="13" style="v" sid="1CO 2:13" /><note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false">जा फाय जीव हे; नाहते जीव आपेल सोबदा से।</char></note>जाह आपु माणहान हिकाड़ेल एकेलीन वातु माय नाह, पुण बोगवानान जीवान हिकाड़ेल वातु जा माय बोगवानान जीव हे ताह आमु आत्मिक वातु होमलावतेह। <verse eid="1CO 2:13" /><verse number="14" style="v" sid="1CO 2:14" />पुण जो माणुह बोगवानान जीवान वातु स्वीकार नाह किरेत, काहाकाय तान नेजरी माय फोगवाल्यु वातु हेत्यु, एने तो ताह जाण सिकेह काहाकाय तान पारेख चोखाला जीवान रिती केरीन इती रिथे। <verse eid="1CO 2:14" /><verse number="15" style="v" sid="1CO 2:15" />जा माय बोगवानान जीव हे तो आखो काय पारेख लिथे, पुण तो सोता कुणीच पारखाय नाह जात। <verse eid="1CO 2:15" /><verse number="16" style="v" sid="1CO 2:16" />जिहकेरीन देरेम पुस्तेक माय लिखेल हे:</para>
  <para style="q1" vid="1CO 2:16">“काहाकाय मालीकान मोन कुण सोमजेल हे काय ताह हिकाड़ी?”</para>
  <para style="q2" vid="1CO 2:16">पुण आमु माय मसीन मोन हे।<verse eid="1CO 2:16" /></para>
  <chapter eid="1CO 2" />
  <chapter number="3" style="c" sid="1CO 3" />
  <para style="s1">बोगवानान सेवक</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1" />एय बाय बोणहा, मी तुमू हिऱ्यो इहकेरीन वातु नाह केर सीकनो जाह बोगवानान चोखाला जीवान माणहा हिऱ्यो, पुण जिहकेरीन दुनियान माणहा हिऱ्यो एने ता हिऱ्यो जा मसी माय आतल्या सोरा हेते। <verse eid="1CO 3:1" /><verse number="2" style="v" sid="1CO 3:2" /><note caller="+" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="HEB 5:12">इब्रानियो 5:12</ref>,<ref loc="HEB 5:13">13</ref></char></note>मी तुमूह दुद पिवाड़ील खाणो नाह खावाड्यो, काहाकाय तुमू ताह नाह खाय सेकताला एने एवी बी नाह खाय सेकते, <verse eid="1CO 3:2" /><verse number="3" style="v" sid="1CO 3:3" />काहाकाय एवी वोर तुमू दुनियान माणहान गेत हेते, जुलबुखे तुमरा माय विरोद एने राड़ ईथे ते काय तुमू दुनियान नाह सोता? एने काय माणहान रिती पोर नाह चालते? <verse eid="1CO 3:3" /><verse number="4" style="v" sid="1CO 3:4" /><note caller="+" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="1CO 1:12">1 कुरिंथीयो 1:12</ref></char></note>जुलबुखे एक किथे, “मी पौलुसान हे,” एने दिहरो किथे, “मी अपुल्लोसान हे,” इहकेरीन तुमू दुनियान माणहान गेत नाह जीवते?<verse eid="1CO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5" />अपुल्लोस काय हे? एने पौलुस काय हे? सेवक ओलास जान द्‍वारे तुमू बुरहो किरेल हेते। जिहकेरीन बोगवान आखाह आपेल हे तिहेस केरीन काम केरने जुवे। <verse eid="1CO 3:5" /><verse number="6" style="v" sid="1CO 3:6" /><note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="ACT 18:4-11">प्रेरितान काम 18:4-11</ref>; </char><char style="xt" closed="false"><ref loc="ACT 18:24-28">प्रेरितान काम 18:24-28</ref></char></note>मी पिरील अपुल्लोस पाणी टाकेल, पुण बोगवान वोदाड़ेल। <verse eid="1CO 3:6" /><verse number="7" style="v" sid="1CO 3:7" />तान केरता नाहते पेरनार काय हे, एने नाहते पाणी टाकणार काय हे, पुण बोगवानुस सोब काय हे, जो वोदाड़नार हे। <verse eid="1CO 3:7" /><verse number="8" style="v" sid="1CO 3:8" />पेरनार एने पाणी टाकणार दुय एक हेते; पुण एकेक एदमी ताच ने मेहनेतीन गेत बोगवान ताह मोंजरी आपी। <verse eid="1CO 3:8" /><verse number="9" style="v" sid="1CO 3:9" />काहाकाय आपु बोगवानान हाती हेते; तुमू बोगवानान खेते हेते, एने बोगवानान बाणायेल आवाल्या हेते।<verse eid="1CO 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 3:10" />बोगवानान ती गीणान गेत जी माहो आपेल हे, मी चेतरला मिस्तऱ्यान होस पायो टाकेल, एने दिहरो ता पोर आवीन बांद लिथे, पुण एकेक माणुह उशारी माय रिवो काय तो ता पोर किहीक आवाली बांदिह। <verse eid="1CO 3:10" /><verse number="11" style="v" sid="1CO 3:11" />काहाकाय ता पायाह सोड़ीन जो पुड़ील हे, एने तु यीशु मसी हे, कुण बी दिरहो पायो नाह टाक सिकेत। <verse eid="1CO 3:11" /><verse number="12" style="v" sid="1CO 3:12" />केदी कुण ज्या पाया पोर होनो, चांदी, मोंगालो दिगोड़, लाकोड़, एने खेड़ा केरीन आवाली नाह बांदणे। <verse eid="1CO 3:12" /><verse number="13" style="v" sid="1CO 3:13" />ते एकेकान काम देखाय जाय काहाकाय नियाव ने दिह ताह केय, ज्यानकेरता काय आक्‍ठा हेऱ्यो देखाय एने तो आक्‍ठो एकेकान काम पारखी काय कोहलो हे। <verse eid="1CO 3:13" /><verse number="14" style="v" sid="1CO 3:14" />जान काम ता पाया पोर बोणीन थोब रेय तो मोंजरी देरी। <verse eid="1CO 3:14" /><verse number="15" style="v" sid="1CO 3:15" />केदी कुणीन काम हेलगी जाय, ते बाणावणे वालो नुकसान विसी; पुण तो सोता वोच जाय, पुण हिलेगते हिलेगतेन।<verse eid="1CO 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:16 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 6:19">1 कुरिंथीयो 6:19</ref>; <ref loc="2CO 6:16">2 कुरिंथीयो 6:16</ref></char>
    </note>काय तुमू नाह जाणते, काय तुमू बोगवानान मोंदिर हेते, एने बोगवानान जीव तुमरे माय रीथे? <verse eid="1CO 3:16" /><verse number="17" style="v" sid="1CO 3:17" />केदी बोगवानान मोंदिराह कुण बी खेतेम केरी ताहार बोगवान ताह खेतेम केरी। काहाकाय बोगवानान मोंदिर चोखालो हे, एने तो तुमू हेते।<verse eid="1CO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18" />कुण बी सोताह दुको नाय देय। केदी तुमरा माय रेन कुण बी ज्या दुनिया माय सोताह इकेल वालो बाणावणेन केरता फुगो बोण जाय। <verse eid="1CO 3:18" /><verse number="19" style="v" sid="1CO 3:19" />काहाकाय ज्या दुनियान इकेल बोगवानान आहने फोगवाय हे, जीहे केरीन देरेम पुस्तेक माय लिखेल हे, “बोगवान इकेल वालाह तान चेतराय माय फासाड़ दिथे,” <verse eid="1CO 3:19" /><verse number="20" style="v" sid="1CO 3:20" />एने पुशो, “मालीक इकेल वालान विचार जाणेह काय ता उदेड़ हेते।” <verse eid="1CO 3:20" /><verse number="21" style="v" sid="1CO 3:21" />ज्यानकेरता माणहान बारा माय कुण बी मोठलाय नाय केरी, काहाकाय आखो काय तुमरो हे; <verse eid="1CO 3:21" /><verse number="22" style="v" sid="1CO 3:22" />काय पौलुस, काय अपुल्लोस, काय केफा, काय दुनिया, काय जीवाय, काय मोत, काय चालुकाल, काय आवतुकाल, आखो काय तुमरो हे। <verse eid="1CO 3:22" /><verse number="23" style="v" sid="1CO 3:23" />तुमू मसीन हेते, एने मसी बोगवानान हे।<verse eid="1CO 3:23" /></para>
  <chapter eid="1CO 3" />
  <chapter number="4" style="c" sid="1CO 4" />
  <para style="s">मसीन प्रेरित</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1" />माणहे आमुह मसीन चाकऱ्या एने बोगवानान मालमात ने कारबारी सोमजे। <verse eid="1CO 4:1" /><verse number="2" style="v" sid="1CO 4:2" />ओवतो न्या कारबारी माय ज्यी वात देखाथे, काय तो बोरहावालो रेय। <verse eid="1CO 4:2" /><verse number="3" style="v" sid="1CO 4:3" />पुण मार नेजरी माय ज्यी जुलूम आत्यी वात हे, काय तुमू नाहते माणहान ईखेह कोरटा माय ली जाईन माणुह पारखी, पुण मी सोता माहुस नाह पारेखणे। <verse eid="1CO 4:3" /><verse number="4" style="v" sid="1CO 4:4" />काहाकाय मारो मोन माहु काल्लीस वातु माय दोसी नाह ठेराणे, पुण ज्या माय मी बिगेर दोसी नाह ठेरात काहाकाय मार पारेख केरनार मार मालीक हे। <verse eid="1CO 4:4" /><verse number="5" style="v" sid="1CO 4:5" />तानकेरता जाह वोर मालीक नाह आवीत, टेमाह रेन पेल काल्लीस वातीन नियाव मा किरहो, तोस आदारा माय लीकेल वातु उजाला माय देखाड़ी, एने मोनान मतने वातु देखाड़ी, तेवी बोगवानान उगे रेन एकेकान बोड़ाय एय।<verse eid="1CO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6" />एय बाय बोणहा, मी ज्यी ज्यी वातु माय तुमरी केरता आपणी एने अपुल्लोसान वात किस्सान रिती पोर रेन किरेल हे, ज्यानकेरता काय तुमू आमरी द्‍वारे ज्यो पुस्तेक माय लिखेल हे ताह रेन ओंगाण नाह जाणु एने एकान उगे रेन दिहरान विरोद माय मोठलाय मा किरहो। <verse eid="1CO 4:6" /><verse number="7" style="v" sid="1CO 4:7" />तुमरे माय एने दिहरा माय कुण मालमात किरेह? एने तार फाय काय हे, जो तु दिहरा फाय रेन निहे लिदो एय? एने तु दिहरा फाय रेन लिदो एय, ते ओहलो मोठाय काहा किरेह जीहे काय निहे लिदो एय?<verse eid="1CO 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 4:8" />तुमू ज्यो विचार केरतेह काय तुमू मालदार एय गीयाह, तुमू आमरे बिगेर राज केऱ्याह; पुण हाजो एतो काय तुमू राज केरता काय आमु बी तुमरी हेऱ्या राज केरता। <verse eid="1CO 4:8" /><verse number="9" style="v" sid="1CO 4:9" />मारी सोमेज माय बोगवान आमु प्रेरिताह आखान पासाण ता माणहान गेत ठेरायेल हे, जान मोतीन उकुम एय जायेल हे, काहाकाय आमु दुनिया एने हेरोगदुत एने माणहान केरता एक तामाशो ठेरायेल हेते। <verse eid="1CO 4:9" /><verse number="10" style="v" sid="1CO 4:10" />आमु मसीन केरता फोगा हेते, पुण तुमू मसी माय चेतुर हेते; आमु कोमजोर हेते, पुण तुमू पेहेलवान ईवो; तुमूह मान जुड़ेह, पुण आमरी बेजेती ईथे। <verse eid="1CO 4:10" /><verse number="11" style="v" sid="1CO 4:11" />आमु उलबुखे वोर बुखल्या तीहल्या एने फाटेल फाड़का पेरतेह, एने मार खातेह एने मोऱ्या मोऱ्या फिरतेह; <verse eid="1CO 4:11" /><verse number="12" style="v" sid="1CO 4:12" /><note caller="+" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ACT 18:3">प्रेरितान काम 18:3</ref></char></note>एने आमरास आथा केरीन काम केरीन मेहनेत केरतेह, माणहे आमुह बाकता केतेह, पुण आमु बोरकेत आपतेह, ता विताड़तेह, पुण आमु वेठतेह। <verse eid="1CO 4:12" /><verse number="13" style="v" sid="1CO 4:13" />ता बदनाम केरतेह, पुण आमु मोंग माय जापाप आपतेह, आमु आज वोर दुनियान कोचरो एने सिकल्यो आखी चिजीन खुरवेड़ीन गेत ठिरेल हेते।<verse eid="1CO 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14" />मी तुमूह लाजवाड़नेन केरता ज्यी वात नाह लिखेत, पुण मार मोंगाल्ला सोरान गेत तुमूह सोमजाड़थो। <verse eid="1CO 4:14" /><verse number="15" style="v" sid="1CO 4:15" />काहाकाय केदी मसी माय तुमरा, हिकाड़नारे दोह एजार बी रेता, तीबी तुमरा आबहेख होवटास नाह सोता, ज्यानकेरता काय मसी यीशु माय हाजाली खोबरीन द्‍वारा मी तुमरो आबोख ईनो। <verse eid="1CO 4:15" /><verse number="16" style="v" sid="1CO 4:16" /><note caller="+" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="1CO 11:1">1 कुरिंथीयो 11:1</ref>; <ref loc="PHP 3:17">फिलेपियो 3:17</ref></char></note>तानकेरता मी तुमूह विन्ता केरथु, काय मार गेत जीवो। <verse eid="1CO 4:16" /><verse number="17" style="v" sid="1CO 4:17" />ज्यानकेरता मी तीमुथीयुसाह जो मालीक माय मारो मोंगाल्लो, एने मालीकान बोरहावालो सेवक हे, तुमू फाय मुकलेल हे, तो तुमूह मसी यीशु माय मारो सोबाव एर केरावी जीहे काय मी आखी जागे आखी मोंडली माय पारचार केरथु। <verse eid="1CO 4:17" /><verse number="18" style="v" sid="1CO 4:18" />थोड़ाक ते ओहला मोटला बोण जायेल हेते, सोमजो मी तुमू फाय आवो काय नाय। <verse eid="1CO 4:18" /><verse number="19" style="v" sid="1CO 4:19" />पुण मालीकान मोरजी एय ते मी तुमू फाय उतवाल्योच आवुह, एने ता मोठाय ने वातुह नाह, पुण तान ताकेतीह जाण लेह। <verse eid="1CO 4:19" /><verse number="20" style="v" sid="1CO 4:20" />काहाकाय बोगवानान राज वातु माय नाह पुण ताकेत माय हे। <verse eid="1CO 4:20" /><verse number="21" style="v" sid="1CO 4:21" />तुमूह काय जुवेह? काय मी डेंगी लेन तुमू फाय आवो, काय मोंग एने गेरबोड़ायीन मोना हिऱ्यो?<verse eid="1CO 4:21" /></para>
  <chapter eid="1CO 4" />
  <chapter number="5" style="c" sid="1CO 5" />
  <para style="s">मोंडली माय खाराब निती</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1" />न्या वोर होमेलना माय आवीह काय तुमू माय सिनालो ईथे, मतलब ओहलो सिनालो जो दिहरी जाती माय बी निहे एतेय, काय एक माणुह तान आबाख ने लाडीह राखेह। <verse eid="1CO 5:1" /><verse number="2" style="v" sid="1CO 5:2" />एने तुमू दुखी बी ते नाह एते ता माय ओहलो काम केरनाराह तुमरे विच माय रेन निकाल देता, पुण मोठवाय केरतेह। <verse eid="1CO 5:2" /><verse number="3" style="v" sid="1CO 5:3" />मी ते सेरीराह रेन सिटो ईतो, पुण जीवा माय तुमू हिऱ्यो हे। जीहे काय मी रेयीन हाल माय ओहला काम केरनारान बारामाय ज्यो उकुम आप दियेल हे। <verse eid="1CO 5:3" /><verse number="4" style="v" sid="1CO 5:4" />जेवी तुमू एने मारो जीव, आमरा मालीक यीशुन ताकेत हिऱ्यो टुलो एय ते, ओहलो माणुह आमरा मालीक यीशुन नावा माय। <verse eid="1CO 5:4" /><verse number="5" style="v" sid="1CO 5:5" />सेरीराह खाराब केरनेन केरता सैतानाह होपाय जाय, काहाकाय तान जीव मालीक यीशुन दिह्या माय सुटकारो लेय लेय।<verse eid="1CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:6 </char>
      <char style="xt" closed="false">
        <ref loc="GAL 5:9">गलातीयो 5:9</ref>
      </char>
    </note>तुमरो मोठवाय केरनो हाजो नाह सोतो, काय तुमूह नाह जाणते थोड़ोक खमीर आखा कुहणेल फिटाह खमीर केर दिथे। <verse eid="1CO 5:6" /><verse number="7" style="v" sid="1CO 5:7" />जुनालो खमीर काड़ीन आपणे आपाह चोखो किरो काय नोवालो कुहणेल फिट बोण जावो, काहाकाय तुमू बिगेर खमीर ईवो, काहाकाय आमरी बी मेर जो मसी हे बोली ईयेल हे। <verse eid="1CO 5:7" /><verse number="8" style="v" sid="1CO 5:8" />तानकेरता आवो आपु तिवारा माय खुसी केरता नाहते जुनाला खमीर माय एने नाह गेलेत एने खाराबान खमीरा रेन, पुण हुतरो एने खेराय ने अखमीरी रोटा माय।<verse eid="1CO 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9" />मी मारी चिट्ठी माय तुमूह लिखेल हे, काय सिनालान मोंडली माय मा रिहो। <verse eid="1CO 5:9" /><verse number="10" style="v" sid="1CO 5:10" />ज्यो नाय काय तुमू बिलकुर ज्यी दुनियान सिनालो केरनारी नाहते, लालुच नाहते, आदारो केरनारे, नाहते, मुरती पुजणारान सेंगेत मा किरहो; काहाकाय ज्यी हाल माय ते तुमूह दुनियाम रेन निकील जाणेस पोड़ी। <verse eid="1CO 5:10" /><verse number="11" style="v" sid="1CO 5:11" />पुण मारो ज्यो केणो हे काय केदी कुण बी बाहख केयीन सिनालो केरनार, लालची, मुरती पुजणार, जुलनार, पिणार, आदारो केरनार, एय ते, तान सेंगेत मा किरहे एने ओहला माणहा हेऱ्या रूटो बी मा खाहो। <verse eid="1CO 5:11" /><verse number="12" style="v" sid="1CO 5:12" />काहाकाय माहु जा बाहेरवालान नियाव केरनेन काय काम? काय तुमू मायवालान नियाव नाह केरती? <verse eid="1CO 5:12" /><verse number="13" style="v" sid="1CO 5:13" />पुण बाहेरवालान नियाव बोगवान केरने तानकेरता ता खाराब कामे केरनाराह तुमरी विच माय रेन काड़ दिवो।<verse eid="1CO 5:13" /></para>
  <chapter eid="1CO 5" />
  <chapter number="6" style="c" sid="1CO 6" />
  <para style="s">आपसी राड़ीन फिसलो</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1" />काय तुमरा माय रेन कुणीह बी ज्यो ईमोत हे काय जुलबुखे दिहरा हेऱ्यी राड़ एय, ते फेसलान केरता जा माणहे बोगवानाह नाह जाणते ता फाय जाहो एने विश्वासी माणहा फाय नाय जाहो? <verse eid="1CO 6:1" /><verse number="2" style="v" sid="1CO 6:2" />काय तुमू नाह जाणते काय बोगवानान माणहे दुनियान नियाव केरती? तान केरता जुलबुखे तुमूह दुनियान नियाव किरहो, ते काय तुमू आत्याम रेन आत्यी राड़ीन बी होमच्‍यो केरनेन लायेक नाह सोता। <verse eid="1CO 6:2" /><verse number="3" style="v" sid="1CO 6:3" />काय तुमू नाह जाणते काय आपु हेरोगदुतान नियाव किरहो? ते काय दुनियान वातुन होमच्‍यो नाय किरहो? <verse eid="1CO 6:3" /><verse number="4" style="v" sid="1CO 6:4" />केदी तुमूह दुनियान वातुन होमच्‍यो केरनु एय, ते काय ताहास बोहाड़हो जान मोंडली हेऱ्यो काय बी सेंगेत नाह सोती? <verse eid="1CO 6:4" /><verse number="5" style="v" sid="1CO 6:5" />मी तुमूह लाजवाड़नेन केरता ज्यो केथु काय खेरीच तुमरा माय एक बी इकेलदार माणुह नाय मीले, जो आपणा बायाख ने होमच्‍यो केर सेकी? <verse eid="1CO 6:5" /><verse number="6" style="v" sid="1CO 6:6" />तुमरा माय बाहख बाहख माय कोरटाम जाईन लेड़ाय केरतेह, एने तो बी विण बोरहावालान ओंगाण।<verse eid="1CO 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 6:7" />पुण खेरीच तुमरा माय मुठलो गुनो ते ज्‍यु हे काय एका दिहरा माय राड़ केरतेह, अन्याय काहा नाह सेहते? आपणो नुकसान काहा नाह सेहते? <verse eid="1CO 6:7" /><verse number="8" style="v" sid="1CO 6:8" />पुण तुमू ते सोता अन्याय केरतेह एने नुकसान पोचाड़तेह, एने तो बी बायाख। <verse eid="1CO 6:8" /><verse number="9" style="v" sid="1CO 6:9" />काय तुमू नाह जाणते काय अन्याय केरनारे माणहे बोगवानान राज ने वोस नाय एती, दोका माय मा रिहो नाह सिनालो केरनारे, नाह मुरती पुजा केरनारे, नाह दिहरी बायकु हेऱ्यो सिनालो केरनारे, नाह लुच्‍चाय केरनारे, नाह एदम्या हेऱ्यो सिनालो केरनारे, <verse eid="1CO 6:9" /><verse number="10" style="v" sid="1CO 6:10" />चोर, लालच्‍या, पिणारे, जुलनारे, ठेगणारे, बोगवानान राज ने वोस नाय रेती। <verse eid="1CO 6:10" /><verse number="11" style="v" sid="1CO 6:11" />एने तुमरा माय रेन कोलाक इहीचकेरीन जीवणे बाजरियेल एता, पुण तुमू मालीक यीशु मसीन नावा माय एने आमरा बोगवानान जीवा माय दोवायेल हेते, एने चोखाला ईयेल, एने नियाव केरनारे निवड़ाय जायेल हेते।<verse eid="1CO 6:11" /></para>
  <para style="s">सेरीर बोगवानान बोड़ाय ने केरता</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:12 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 10:23">1 कुरिंथीयो 10:23</ref>
      </char>
    </note>आखी वोस्तु मार केरता हाजी ते हेत्यु, पुण आखी वोस्तु फायदान नाह सोत्यु आखी वोस्तु मार केरता हाजी हेत्यु, पुण मी काल्ली बी वातुन ताबा माय नाय रेव। <verse eid="1CO 6:12" /><verse number="13" style="v" sid="1CO 6:13" />रूटो पेटान केरता एने पेट रोटान केरता हे, पुण बोगवान ज्याह एने ताह दुयाह खेतेम केर देय, एने सेरीर सिनालो केरनेन केरता नाह सोतो, पुण मालीकान सेवान केरता हे, एने मालीक सेरीरान चाकरी केरनेन केरता हे। <verse eid="1CO 6:13" /><verse number="14" style="v" sid="1CO 6:14" />बोगवान तान ताकेत केरीन मालक्याह जिवाड़ेल हे, एने आपुह बी जीवाड़ी। <verse eid="1CO 6:14" /><verse number="15" style="v" sid="1CO 6:15" />काय तुमू नाह जाणते काय तुमरो सेरीर मसीन सेरीरान आंग हे? ते काय मी मसीन सेरीरान आंग लेन ताह वेश्यान आंग बाणावो? केदीच नाह। <verse eid="1CO 6:15" /><verse number="16" style="v" sid="1CO 6:16" />काय तुमू नाह जाणते काय जो कुण वेश्या हेऱ्यो सेंगेत किरेह, तो ती हिऱ्यो एक सेरीर एय जाथे? काहाकाय देरेम पुस्तेक माय लिखेल हे, “ता दुयू एक सेरीर एय जाती।” <verse eid="1CO 6:16" /><verse number="17" style="v" sid="1CO 6:17" />पुण जो मालीकान जीवा हेऱ्यो जोड़ाय रिथे, तो ता हेऱ्यो एक जीव एय जाथे। <verse eid="1CO 6:17" /><verse number="18" style="v" sid="1CO 6:18" />सिनालाह रेन वोचीन रिवो, जोला दिहरा पापे माणुह किरेह ता सेरीरान बाहेर हेते, पुण सिनालो केरनार ताच ने सेरीरान विरोद पाप किरेह। <verse eid="1CO 6:18" /><verse number="19" style="v" sid="1CO 6:19" /><note caller="+" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="1CO 3:16">1 कुरिंथीयो 3:16</ref>; <ref loc="2CO 6:16">2 कुरिंथीयो 6:16</ref></char></note>काय तुमू नाह जाणते काय तुमरो सेरीर चोखाला जीवान मोंदिर हे, जो तुमू माय बुहेल हे, एने तुमूह बोगवानान उगे रेन जुड़ेल हे, एने तुमू सोतास ने नाह सोता? <verse eid="1CO 6:19" /><verse number="20" style="v" sid="1CO 6:20" />काहाकाय बोगवान किमोत आपीन वेचातो लेन सोड़ेव लियेल हे, तानकेरता तुमरा सेरीरान द्‍वारे बोगवानान बोड़ाय किरो।<verse eid="1CO 6:20" /></para>
  <chapter eid="1CO 6" />
  <chapter number="7" style="c" sid="1CO 7" />
  <para style="s">वाराड़ान सोमंदान सावाल</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1" />ती वातुन बारामाय जी तुमू लिखेल हेते, काय एदम्याह वाराड़ नाह केरनु हाजो हे।<note caller="+" style="f"><char style="fr" closed="false">7:1 </char><char style="ft" closed="false">जो एदमी वाराड़ नाह किरेत तो हाजो किरेह; नाहते तुमू केतेह काय जो एदमी वाराड़ नाह किरेत तो हाजो किरेह।</char></note> <verse eid="1CO 7:1" /><verse number="2" style="v" sid="1CO 7:2" />काहाकाय जुलूम सिनालो एणे बाजरिनोह, केरीन एकेक एदम्याह सोतान बायकु रेणे जुवे, एने एकेक बायकुन बी सोतान एदमी रेणे जुवे। <verse eid="1CO 7:2" /><verse number="3" style="v" sid="1CO 7:3" />एदमी तान बायकुन मोरजी पुरी केरने जुवे, एने तिहेच बायकु बी तीन एदम्यान मोरजी पुरी केरने जुवे। <verse eid="1CO 7:3" /><verse number="4" style="v" sid="1CO 7:4" />बायकुह तीन सेरीर पोर आदिकार नाह सोतो पुण तीन एदम्यान आदिकार हे, तिहेस एदम्यान बी तान सेरीर पोर आदिकार नाह सोतो, पुण बायकुन हे। <verse eid="1CO 7:4" /><verse number="5" style="v" sid="1CO 7:5" />तुमू एका दिहराह ज्या आदिकार माय रेन बुलवाड़ो मा, पुण सोतान सेंगेतीह रेन थोड़ीक वार ने केरता आंगेच रिवो काय विन्तान केरता टेम जुड़ी, एने पोशा एकठा एय जावो नाहते, ओहलो नाय एय काय तुमरे दिर ने कारेण सैतान तुमूह पारखी। <verse eid="1CO 7:5" /><verse number="6" style="v" sid="1CO 7:6" />पुण मी जो केथु, तो पारवांगी हे नाह काय उकुम। <verse eid="1CO 7:6" /><verse number="7" style="v" sid="1CO 7:7" />मारी ज्यी मोरजी हे काय जोहलो मी हे तोहलाच आखा माणहे रेणे जुवे, पुण एकेकाह बोगवानान उगे रेन खास खास वरदान जुड़ेल हे, कुणीह कोहली बातीन ते कुणीह कोहली बातीन।<verse eid="1CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8" />एवी मी बिगेर वाराड़ा वाल्युह एने रांडायेल बायकुन बारामाय केथु, काय त्युन केरता एखालो रेणे हाजो हे, जोहलो मी हे। <verse eid="1CO 7:8" /><verse number="9" style="v" sid="1CO 7:9" />पुण केदी त्यु दिर नाय खाय ते, वाराड़ केर लेय; काहाकाय वाराड़ केरनो कुवारो रेणे रेन हाजो हे।<verse eid="1CO 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 7:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">7:10 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:32">मत्ती 5:32</ref>; <ref loc="MAT 19:9">19:9</ref>; <ref loc="MRK 10:11">मरकुस 10:11</ref>,<ref loc="MRK 10:12">12</ref>; <ref loc="LUK 16:18">लुका 16:18</ref></char>
    </note>जान वाराड़ एय जायेल हे ताह मी नाह, पुण मालीक उकुम आपेह काय बायकु तीन एदम्याह रेन आंगे एणेन केरता लेख्यो नाय आपी। <verse eid="1CO 7:10" /><verse number="11" style="v" sid="1CO 7:11" />एने केदी आंगे एय बी जाय ते बिगेर दिहरो वाराड़ किरेल रेय, नाहते तीन एदम्या हेऱ्यी पोशी मेल केर लेय, एने एदमी बी तान बायकुह सोड़नेन केरता लेख्यो नाय आपी।<verse eid="1CO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12" />दिहराह मालीक नाह पुण मीच केथु, केदी एगदा बायाख ने बायकु बुरहो निहे मेलतेय, एने ता हेऱ्यी रेणेन केरता राजी हे, ते तु तीह सोड़नेन केरता लेख्यो नाय आपी। <verse eid="1CO 7:12" /><verse number="13" style="v" sid="1CO 7:13" />जी बायकुन एदमी अविश्वासी हे; एने ती हिऱ्यो रेणेन केरता राजी एय, ते ती एदम्याह सोड़नेन केरता लेख्यो नाय आपी। <verse eid="1CO 7:13" /><verse number="14" style="v" sid="1CO 7:14" />काहाकाय ओहलो एदमी जो अविश्वासी हे, तो बायकुन कारेण बोगवानाह समर्पित एयीन चोखालो ठेराथे। एने ओहली बायकु जी अविश्वासी हे, ती एदम्यान कारेण बोगवानाह समर्पित एयीन चोखाली ठेराथे, नाहते तुमरा सोरा पोऱ्या एठा रेता, पुण एवी ते चोखाला हेते। <verse eid="1CO 7:14" /><verse number="15" style="v" sid="1CO 7:15" />पुण केदी अविश्वासी एदमी आंगे एणेन केरता लेख्यान मांग केरी, ते ठिक हे ताह आप दिवो, ओहली हाल माय कुण बी बाहख बोणीख गाठ माय बांदायेल नाह सोता, बोगवान आपुह मेल केरनेन केरता हादिल हे। <verse eid="1CO 7:15" /><verse number="16" style="v" sid="1CO 7:16" /><note caller="+" style="f"><char style="fr" closed="false">7:16 </char><char style="ft" closed="false">तुमू नाह वोचाड़ सेकतेह, काय तुमू ज्यी वात निश्‍चित जाणतेह; नाहते तुमूह मालुम हे काय तुमू वोचाड़ सेकतेह।</char></note>काहाकाय एय बायकु तु काय जाणेह, काय तु तार एदम्यान सुटकारो केराव लिहे? एने एय एदमी तु काय जाणेह, काय तु तारी बायकुन सुटकारो केराव लिहे?<verse eid="1CO 7:16" /></para>
  <para style="s">बोगवान हादिल तिहे चालो</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17" />जीहे केरीन मालीक एकेकाह जीवाय आपेल हे, एने जीहे केरीन बोगवान एकेकाह हादेल हे, तिहेस तो चाले मी आखी मोंडली माय इहीचकेरीन ठेरावथु। <verse eid="1CO 7:17" /><verse number="18" style="v" sid="1CO 7:18" />जो खेतना किरेल हादाड़ेल एय, ते तो बिगेर खेतनान नाय बोणने जुवे, एने जो बिगेर खेतनान हादाड़ेल एय ते तो खेतान नाय केरी। <verse eid="1CO 7:18" /><verse number="19" style="v" sid="1CO 7:19" />नाहते खेतना काह हे, एने नाहते बिगेर खेतना वालो, पुण बोगवानान उकुमाह मान्नुस आखो काय हे। <verse eid="1CO 7:19" /><verse number="20" style="v" sid="1CO 7:20" />एकेक जाण जा हाल माय हादाड़ेल एय तास माय रेय। <verse eid="1CO 7:20" /><verse number="21" style="v" sid="1CO 7:21" />केदी तु पावोरान हाल माय हादाड़ेल एय ते चिन्ता मा किरहे, पुण केदी तु सुट एय सिके ते ओहलोस काम केर।<note caller="+" style="f"><char style="fr" closed="false">7:21 </char><char style="ft" closed="false">पुण केदी तुमूह आजाद एणेन मुको जुड़ी ते तान फायदो विसो; नाहते तुमूह आजाद एणेन मुको जुड़ी तीबी, तुमरा गुलामीन अवस्थान जादा फायदो विस लिवो।</char></note> <verse eid="1CO 7:21" /><verse number="22" style="v" sid="1CO 7:22" />काहाकाय जो पावोरान हाल माय मालक्या माय हादाड़ेल हे तो मसी माय आजाद हेते। <verse eid="1CO 7:22" /><verse number="23" style="v" sid="1CO 7:23" />बोगवान तुमूह किमोत आपीन वेचातो लेन सोड़ेव लियेल हे, तानकेरता माणहान पावोर मा बुणो। <verse eid="1CO 7:23" /><verse number="24" style="v" sid="1CO 7:24" />एय बाय बोणहा, जो कुण जी हाल माय हादाड़ील हे, तो बोगवानान ओंगाण तीच हाल माय जीवो।<verse eid="1CO 7:24" /></para>
  <para style="s">बिगेर वाराड़ावाल्यु एने रांडायेल</para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25" />कुवाऱ्युन बारा माय मालीकान काल्लोस उकुम माहु नाह जुड़नो, पुण बोरहावालो एणेन केरता जोहलो किव मालीक मार पोर किरेल हे, ताच ने होस अनुमती आपथु। <verse eid="1CO 7:25" /><verse number="26" style="v" sid="1CO 7:26" />मारी सोमेज माय ज्यो हाजो हे काय आज काल वेलान कारेण माणुह जोहली हालेत माय हे तोहलोस रेय। <verse eid="1CO 7:26" /><verse number="27" style="v" sid="1CO 7:27" />केदी तारी बायकु एय ते ती हिऱ्यो रेन आंगे एणेन केरता लेख्यो आपणेन कोसीत मा किरहे, एने केदी तारी बायकु निहे एय ते बायकु मा हुदही। <verse eid="1CO 7:27" /><verse number="28" style="v" sid="1CO 7:28" />पुण केदी तु वाराड़ बी किरहे तीबी पाप नाह सोतो, एने केदी कुवारली सोरीन वाराड़ एय ते पाप नाह सोतो, पुण ओहलाह माणहाह वाराड़ान कारेण सेरीरान दुख एय एने मी वोचाड़ने होदथु। <verse eid="1CO 7:28" /><verse number="29" style="v" sid="1CO 7:29" />एय बाय बोणहा मी ज्यो केथु, काय टेम कोम किरेल हे, तानकेरता काय जान बायकु हे ता ओहला रेय काय सुमजो तान बायकु निहे एय; <verse eid="1CO 7:29" /><verse number="30" style="v" sid="1CO 7:30" />एने रेड़नारे ओहला रेय, सुमजो रेड़तेस नाह, एने खुसी केरनारे ओहला रेय सुमजो खुसीस नाह केरती, एने वेचातो लेणारे ओहला रेय सुमजो ता फाय काईच निहे एय। <verse eid="1CO 7:30" /><verse number="31" style="v" sid="1CO 7:31" />एने ज्या दुनियान वोस्तुह वापेरनारे ओहला रेय काय ती वोस्तु माय खोवाय नाय जाय; काहाकाय ज्यी दुनियान रिती एने वेवारो खेतेम एण्यो हे।<verse eid="1CO 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 7:32" />मी ज्यो होदथु काय तुमूह चिन्ता माय नाय जिवी, काहाकाय बिगेर वाराड़ावालो एदमी मालीकान वातुन चिन्ता माय रिथे, काय मालीकाह किहीक खुस मेलु। <verse eid="1CO 7:32" /><verse number="33" style="v" sid="1CO 7:33" />पुण वाराड़ावालो माणुह दुनियान वातुन चिन्ता माय रिथे, काय मारी बायकुह किहीक खुस मेलु। <verse eid="1CO 7:33" /><verse number="34" style="v" sid="1CO 7:34" />वाराड़ावाली एने बिगेर वाराड़ावाली माय बी मालमात हे, बिगेर वाराड़ावाली मालीकान चिन्ता माय रिथे, काय ती सेरीर एने जीव दुयू माय चोखाली रेय, पुण वाराड़ावाली दुनियान चिन्ता माय रिथे, काय मार एदम्याह किहीक खुस मेलु। <verse eid="1CO 7:34" /><verse number="35" style="v" sid="1CO 7:35" />मी ज्यी वातु तुमरास फायदान केरता केथु, नाह काय तुमूह फासाड़नेन केरता, पुण ज्यानकेरता काय जोहलो होबाथे, तोहलोस केराय जाय काय तुमू एक मोन एन मालीकान सेवा चाकरी माय लागीन रिवो।<verse eid="1CO 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36" />जी जोड़ीन मांगणी ईयेल हे एने ता वाराड़ नाह केरनेन होमच्‍यो किरेल हेते, पुण ता एदम्याह लागेह काय तान वेवारो ती कुवारलीन बारामाय ठिक नाय मीले, एने इही ताह लागेह ते ताह वाराड़ केर लेणे जुवे जीहे तो हुदेह, ता माय काय पाप नाय मीले।<note caller="+" style="f"><char style="fr" closed="false">7:36 </char><char style="ft" closed="false">काल्लो बी वाराड़ ईयेल जोड़ो; ताह हाजो लागेह तोहलो, नाहते एदमी तान वाराड़ नाह ईयेल सोरी, केदी ताह लागेह काय तो ता हेऱ्या लायकीन नाह ओहलो वेवारो केरने बाज रिनो एय, एने तीन वोय वाराड़ केरनेन बाराबोर एय, ते तो तान मोरजीन गेत तीन वाराड़ केराव देणे जुवे।</char></note> <verse eid="1CO 7:36" /><verse number="37" style="v" sid="1CO 7:37" />पुण जो ज्या मामलाह आपणा मोना माय ठेरायेल हे, ता कुणीन बी मोजबुरीन ताबाम बांदायेल नाय मीले, पुण तान मोरजी पोर ताबो मिलेह एने जी कुवारली हिऱ्यो वाराड़ केरनेन मोन बाणाव लियेल हे, तो एदमी उंजु बी हाजो किरेह।<note caller="+" style="f"><char style="fr" closed="false">7:37 </char><char style="ft" closed="false">वाराड़ नाह केरनो; नाहते तान सोरीन वाराड़ एणे नाय देय। </char><char style="fp" closed="false">सोरी हेऱ्यो वाराड़ केरी; नाहते तीन वाराड़ एणे देय।</char></note> <verse eid="1CO 7:37" /><verse number="38" style="v" sid="1CO 7:38" />जो वाराड़ किरेह तो हाजो किरेह, जो वाराड़ नाह किरेत तो उंजु बी हाजो किरेह।<note caller="+" style="f"><char style="fr" closed="false">7:38 </char><char style="ft" closed="false">वाराड़ किरेह; नाते तीन सोरीह वाराड़ केरने देय। </char><char style="fp" closed="false">वाराड़ नाह किरेत; नाहते तीन वाराड़ नाह एणे दित।</char></note><verse eid="1CO 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 7:39" />जाह वोर एगदी बायकुन एदमी जीवतालो रिथे, ताह वोर ती ता हेऱ्यी बांदायेल हे; पुण केदी तीन एदमी मोर जाय ते ती कुणी हेऱ्यी बी वाराड़ केर सिकेह, पुण मालीक पोर बुरहो केरनार रेणे जुवे। <verse eid="1CO 7:39" /><verse number="40" style="v" sid="1CO 7:40" />पुण केदी ती वाराड़ नाय केरी, ते मार विचारा माय उंजु बी हाजो हे; एने मी सोमेजथु काय बोगवानान जीव मार माय बी हे।<verse eid="1CO 7:40" /></para>
  <chapter eid="1CO 7" />
  <chapter number="8" style="c" sid="1CO 8" />
  <para style="s">मुरतीह चेड़ायेल खाणो</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1" />एवी मुरतीन ओंगाण चेड़ायेल खाणान बाराम आपु जाणतेह काय आपु आखाह इकेल हे, मोठवाय पायदा केरने पुण मोंग केरीन वोड़ती ईथे। <verse eid="1CO 8:1" /><verse number="2" style="v" sid="1CO 8:2" />कुण सोमजी काय मी काह जाणथो, ते जोहलो जाणने जुवे तोहलो उंजु वोर जाणेत नाह। <verse eid="1CO 8:2" /><verse number="3" style="v" sid="1CO 8:3" />पुण केदी कुण बोगवानाह मोंग केरतेय, ते बोगवान ताह ओलखी लिथे।<verse eid="1CO 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4" />मुरतीन ओंगाण बोली चेड़ायेल वोस्तुह खाणेन बाराम आमु जाणतेह काय मुरती दुनिया माय काल्लीस वोस्तु नाह सोती, एने एकाह सोड़ीन उंजु काल्लोस बोगवान नाह सुतो। <verse eid="1CO 8:4" /><verse number="5" style="v" sid="1CO 8:5" />जुगा माय एने देरती पोर मोकतास देव केवाड़तेह, जीहे काय मोकतास देव एने मोकतास मालीक हेते। <verse eid="1CO 8:5" /><verse number="6" style="v" sid="1CO 8:6" />तीबी आमरी केरता ते एकुस बोगवान हे; मतलब आबोख जान उगे रेन आख्‍यु वोस्तु हेत्यु एने आमु तास ने केरता हेते, एने एकुस मालीक हे, मतलब यीशु मसी जान द्‍वारे आख्‍यु वोस्तु ईयेल हेत्यु, एने आमु बी तास ने द्‍वारे हेते।<verse eid="1CO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7" />पुण सोबाह ज्यी इकेल नाह सोती, पुण काय तीबी एवी वोर मुरतीह काय तीबी सोमेजणे कारेण मुरतीन ओंगाण बोली चेड़ायेल वोस्तुह काय तीबी सोमजीन खातेह, एने तान मोन कोमजोर एणेन कारेण एठो एय जाथे। <verse eid="1CO 8:7" /><verse number="8" style="v" sid="1CO 8:8" />खाणान चिज आपुह बोगवानान आहने नाह पोचाड़ने केदी आपु नाय खाहु ते, आपणो काय दुको नाय एय एने केदी खाहु ते काय फायदो नाह सुतो। <verse eid="1CO 8:8" /><verse number="9" style="v" sid="1CO 8:9" />पुण हास केरीन, ओहलो नाय एय काय तुमरो ज्यो सुटकारो कोमजोर माणहान केरता ठोकरान कारेण एय जाय। <verse eid="1CO 8:9" /><verse number="10" style="v" sid="1CO 8:10" />काहाकाय केदी कुण तुवाह एकलीदाराह मुरतीन मोंदिर माय खाणो खातालो देखी एने तो मोनान कोमजोर माणुह एय ते, काय तान मोनाह मुरतीन ओंगाण बोली चेड़ायेल चिज खाणेन मोन नाय एय जाय। <verse eid="1CO 8:10" /><verse number="11" style="v" sid="1CO 8:11" />इहकेरीन तार एकलीन वोजेसे तो कोमजोर बाहख जान केरता मसी मुरेल, खेतेम एय जाय। <verse eid="1CO 8:11" /><verse number="12" style="v" sid="1CO 8:12" />इहकेरीन बाहख ने विरोद पाप केरने एने तान कोमजोर मोनान जेखेम पोचाड़ीन तुमू मसीन विरोद पाप केरतेह। <verse eid="1CO 8:12" /><verse number="13" style="v" sid="1CO 8:13" />तानकेरता केदी खाणो मार बायाख ठोकरा खावाड़ी ते, मी केदी बी काल्ली रिती माय माह नाय खाव, ओहलो नाय एय काय मी मार बायाख ने केरता ठोकरान कारेण बोणु।<verse eid="1CO 8:13" /></para>
  <chapter eid="1CO 8" />
  <chapter number="9" style="c" sid="1CO 9" />
  <para style="s">प्रेरितान आदिकार एने काम</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1" />काय मी सुटालो नाह सुतो? काय मी प्रेरित नाह सुतो? काय मी यीशुह जो आपणो मालीक हे नाह दिख्यो? काय तुमू मार कामान वोजेसे बोगवाना बाणायेल नाह सोता? <verse eid="1CO 9:1" /><verse number="2" style="v" sid="1CO 9:2" />केदी मी दिहरान केरता प्रेरित नाह सुतो, तीबी तुमरे केरता ते हे, काहाकाय तुमरो मालीका माय एकी हे ज्योस सबुत हे काय मी प्रेरित हे।<verse eid="1CO 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 9:3" />जा माणहे मार चोकसी केरने होद्तेह तानकेरता ज्योच मारो जापाप हे। <verse eid="1CO 9:3" /><verse number="4" style="v" sid="1CO 9:4" />काय आमुह मेहनेत केरीन खाणे पिणेन आदिकार नाह सुतो? <verse eid="1CO 9:4" /><verse number="5" style="v" sid="1CO 9:5" />काय आमुह ज्यो आदिकार नाह सुतो काय आमु आमरी बायकुह सेवान केरता आरही लेन फिरी, जिहकेरीन दिहरा प्रेरित एने मालीक ने बाहख पतरस किरेह? <verse eid="1CO 9:5" /><verse number="6" style="v" sid="1CO 9:6" />काय माहु एने बरनबासाह ज्यो आदिकार नाय मीले काय मेहनेत केरीन कामावीन जिवी। <verse eid="1CO 9:6" /><verse number="7" style="v" sid="1CO 9:7" />ओहलो सिपाय कुण हे जो बिगेर मोंजरीन सिपायीन काम केरी? एने ओहलो कुण हे जो अंगुर ने वाड़ी लागाड़ीन तान फोल नाह खाणे? एने पोशो ओहलो कुण हे, जो मेंड्रान टोलान राखवाली केरीन तान दुद नाह पिणे?<verse eid="1CO 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 9:8" />काय मी ज्यी वातु माणहान रिती पोर रेन बोलथु? नियमान पुस्तेक ज्यी वात नाह कित? <verse eid="1CO 9:8" /><verse number="9" style="v" sid="1CO 9:9" /><note caller="+" style="x"><char style="xo" closed="false">9:9 </char><char style="xt" closed="false"><ref loc="1TI 5:18">1 तीमुथीयुस 5:18</ref></char></note>काहाकाय मुसान कायदा माय लिखेल हे, “मोलने बुखेत बोयलान मुय मा बांदहो।” काय बोगवान बोयलान उलुस कालजी किरेह? <verse eid="1CO 9:9" /><verse number="10" style="v" sid="1CO 9:10" />काय खास केरीन आमरी केरता किथे, होव, आमरी केरतास लेखायेल काहाकाय हाजो हे, काय मोलनार कामाय वाटणेन आसा माय बेसकाणेन केरता चाल्या केरी। <verse eid="1CO 9:10" /><verse number="11" style="v" sid="1CO 9:11" /><note caller="+" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="ROM 15:27">रोमीयो 15:27</ref></char></note>जेवी आमु तुमरी केरता आत्मिक वोस्तु पिरील हेते तेवी ज्यी काल्ली मोठी वात हे? काय तुमरी सारिरीक वोस्तुन कामाय काटी। <verse eid="1CO 9:11" /><verse number="12" style="v" sid="1CO 9:12" />जेवी दिहरान तुमू पोर ज्यो आदिकार हे, ते काय आमरो ज्याह रेन वादार नाय रेय?</para>
  <para style="p" vid="1CO 9:12">पुण आमु ज्यो आदिकार कामा माय नाह लावा; पुण आखो काय खेटतेह काय आमरी द्‍वारे मसीन हाजाली खुबेर माय काह रोक टोक नाय एय। <verse eid="1CO 9:12" /><verse number="13" style="v" sid="1CO 9:13" />काय तुमू नाह जाणते काय जा माणहे मोंदिर माय सेवा चाकरी केरतेह, ता मोंदिरा माय रेन खातेह एने जा वेदीन सेवा चाकरी केरतेह, ता चेड़ावो चेड़ायेल वोस्तु माय इसादार एय जातेह? <verse eid="1CO 9:13" /><verse number="14" style="v" sid="1CO 9:14" /><note caller="+" style="x"><char style="xo" closed="false">9:14 </char><char style="xt" closed="false"><ref loc="MAT 10:10">मत्ती 10:10</ref>; <ref loc="LUK 10:7">लुका 10:7</ref></char></note>इहकेरीन मालीक उकुम आपेल हे काय जा माणहे हाजाली खुबेर होमेलतेह, तान खीरचो हाजाली खुबेर होमेलनारेच पुरो केरी।<verse eid="1CO 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15" />पुण मी न्या माय रेन काल्लो बी आदिकार कामा माय नाह लावु, एने मी जी वात ज्यानकेरता नाह लेखथु काय मार केरता ओहलो केरने जुवे, पुण ज्याह रेन ते माहु मोर जाणुस हाजो हे, ते कुण मार मोठायाह उदेड़ ठेरावी। <verse eid="1CO 9:15" /><verse number="16" style="v" sid="1CO 9:16" />केदी मी हाजाली खुबेर केय होमलावु, ते मार फाय मोठाय केरनेन काय कारेण नाह सोतो, काहाकाय ज्यो ते मार केरतास हे, केदी मी हाजाली खुबेर नाय केय होमलावो ते मार पोर हाय। <verse eid="1CO 9:16" /><verse number="17" style="v" sid="1CO 9:17" />काहाकाय केदी मारी मोरजी माय ज्यो केरथु, ते माहु मोंजरी जुड़ेह, पुण मी ज्यो केरथु काहाकाय बोगवान माहु होपेल हे। <verse eid="1CO 9:17" /><verse number="18" style="v" sid="1CO 9:18" />ते मारी काल्ली मोंजरी हे? ज्यो काय हाजाली खुबेर होमलावणे माय मी मसीन हाजाली खुबेर बिगेर पोयशा लेन दिहराह होमलावथु, न्या वोर काय हाजाली खुबेर माय ज्यो मारो आदिकार हे ताह बी मी पुरी रिती माय काम माय नाय लावु।<verse eid="1CO 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19" />पुण मी आजाद हे एने कुणीन बी काबाम नाह सुतो, तीबी मी मोकतास माणहाह बोगवाना राज माय लावणेन केरता आखा पावोर बोण गीयो। <verse eid="1CO 9:19" /><verse number="20" style="v" sid="1CO 9:20" />जा माणहे मुसान कायदान ताबा माय हेते, ता माणहाह मी मसी माय लावणेन केरता तान गेत बुणील, पुण तान कायदान ताबा माय नाह ईतो। <verse eid="1CO 9:20" /><verse number="21" style="v" sid="1CO 9:21" />जेवी मी बिगेर यहुदि हिऱ्यो ईतो जा बोगवानान कायदान गेत नाह जीवाय जीवतेह, तान गेत मी बी कायदान ताबा माय नाह सोतो, ताकाय ताह मसी फाय लाव सेकु। पुण बोगवानान कायदाह टालेत नाह, एने मी मसीन कायदान पालेन केरथु। <verse eid="1CO 9:21" /><verse number="22" style="v" sid="1CO 9:22" />मी कोमजोरान केरता कोमजोरूस बुणेल काय कोमजोराह खेचीन लियावो, मी आखा माणहान केरता आखो काय बुणेल काय काल्लीन काल्ली रिती माय काल्ला एकान सुटकारो केरावो। <verse eid="1CO 9:22" /><verse number="23" style="v" sid="1CO 9:23" />मी ज्यो आखो काय हाजाली खोबरीन केरता केरथु, काय दिहरा हिऱ्यो तान बागीदार एय जाव।<verse eid="1CO 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 9:24" />काय तुमू नाह जाणते काय दुवेड़ माय ते सोब दोवेड़तेह, पुण ईनाम एकुस जाण ली जाणे? तुमू तिहेस दुवड़ो काय जिकहो। <verse eid="1CO 9:24" /><verse number="25" style="v" sid="1CO 9:25" />एकेक पेहेलवान आखी बातीन दिर खाणे; ता ते एक कोमाणार हार सापड़ावणेन केरता ज्यो सोब केरनु, पुण आपु ते ता हारान केरता काम केरतेह, जो कायेम कोमात नाह। <verse eid="1CO 9:25" /><verse number="26" style="v" sid="1CO 9:26" />तानकेरता मी बिगेर निसाणीन नाह दोवेड़थु, एने नाह वारा माय दुमा देथु। <verse eid="1CO 9:26" /><verse number="27" style="v" sid="1CO 9:27" />पुण मी मार सेरीराह कुटणे मारने एने ताबाम लावथु, ओहलो नाय एय काय दिहराह पारचार केरीन मी सोताच काल्ली बी रिती माय ईनाम लेणेन लायकीन नाय ठेराव।<verse eid="1CO 9:27" /></para>
  <chapter eid="1CO 9" />
  <chapter number="10" style="c" sid="1CO 10" />
  <para style="s">इस्राएली माणहान इतिहासाह रेन चेतावणी</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1" />एय बाय बोणहा, मी नाह हुदेत काय तुमू ज्यी वातीह रेन एंजाणल्या रिवो, काय आपणा आखा डायला जुगान नेड़ा एता, एने आखान आखा देरीयान विच माय रेन पार एय गिल्या; <verse eid="1CO 10:1" /><verse number="2" style="v" sid="1CO 10:2" />तेवी आखा जुगा माय एने देरीया माय मुसान बपतीस्मा लेदाला;<verse eid="1CO 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 10:3" />एने आखा एकुस आत्मिक खाणो खादाला;<verse eid="1CO 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 10:4" />एने आखा एकुस आत्मिक पाणी पिदाला; काहाकाय ता माणहे ता आत्मिक सापरा माय रेन पिताला जो तान आरही आरही चालतालो, एने तो सापोर मसी ईतो। <verse eid="1CO 10:4" /><verse number="5" style="v" sid="1CO 10:5" />पुण बोगवान ता माय रेन मोकतास जाणा पोर खुस नाह ईनो, केरीन ता जेंगला माय मोर गीया।<verse eid="1CO 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6" />जी वात आमरे केरता किस्सो ठेरायेल काय जीहे ता लालुस किरेल, तिहेस केरीन आपु खाराब चिजीन लालुस नाह केरनु; <verse eid="1CO 10:6" /><verse number="7" style="v" sid="1CO 10:7" />एने तुमू मुरतीन पुजारा मा बुणो जोहला काय ता माय रेन कोलाक बोण जायेल एता, जोहलो लिखेल हे, “माणहे खाणे पिणे बोठा एने पासाण एक दिहरा हेऱ्यो खाराब काम केरने बाज गीया।” <verse eid="1CO 10:7" /><verse number="8" style="v" sid="1CO 10:8" />एने आपु सिनालो नाह केरनु, जोहलो ता माय रेन कोलाक जाणे किरेल एता, एने एक दिह्या माय तेवीच एजार मोर गिल्या। <verse eid="1CO 10:8" /><verse number="9" style="v" sid="1CO 10:9" /><note caller="+" style="f"><char style="fr" closed="false">10:9 </char><char style="ft" closed="false">मालीक; थोड़ाक लेख माय मसी लिखेल हे।</char></note>एने आपु नाह मालीकाह पारेखणे जुवे जोहलो ता माय रेन कोलाक जाणे किरेल एता, एने गेड़हान द्‍वारे खेतेम एय गिल्या। <verse eid="1CO 10:9" /><verse number="10" style="v" sid="1CO 10:10" />एने नाह तुमू कुरकुर जीह केरीन ता माय रेन कोलाक जाणे कुरकुर केरताला, एने मोतीन दुतान द्‍वारे खेतेम एय गिल्या। <verse eid="1CO 10:10" /><verse number="11" style="v" sid="1CO 10:11" />पुण ज्यी आखी वात जी ता पोर पोड़नी किस्सान रिती पोर रेन एती; एने ती आमरा इसारान केरता जो दुनियान सेवल्या टेमा माय रेतेह लेखायेल हे। <verse eid="1CO 10:11" /><verse number="12" style="v" sid="1CO 10:12" />तानकेरता जो कुण सुमजेह काय मी मोजबुत हे, तो हास केरीन रेय काय पोड़ नेवो जाय। <verse eid="1CO 10:12" /><verse number="13" style="v" sid="1CO 10:13" />तुमू जी बी पारेख माय मा पोड़तेह ती आखा पोर आवणेवाली हे, एने बोगवान खेरो हे, एने तु तुमूह ताकेतीन बाहेर पारेख माय नाय पोड़ने देय, पुण पारेख माय रेन पार एणेन बी वाट देखाड़ी।<verse eid="1CO 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14" />ज्यानकेरता एय मारा मोंगाल्ला बाय बोणहा, मुरती पुजाह रेन वोचीन रिवो। <verse eid="1CO 10:14" /><verse number="15" style="v" sid="1CO 10:15" />मी तुमू सोमेजदार सोमजीन तुमूह केथु, जो मी केथु ताह तुमू पारखो। <verse eid="1CO 10:15" /><verse number="16" style="v" sid="1CO 10:16" /><note caller="+" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="MAT 26:26-28">मत्ती 26:26-28</ref>; <ref loc="MRK 14:22-24">मरकुस 14:22-24</ref>; <ref loc="LUK 22:19">लुका 22:19</ref>,<ref loc="LUK 22:20">20</ref></char></note>जो वाटको आपु मालीक ने खाणाम वापेरतेह, तान केरता आपु बोगवानाह दन्यवाद केरतेह, एने जेवी केदी आपु ज्याम रेन पितेह, तेवी मसीन लुय माय बेलातेह? एने जेवी आमु रूटो मुड़ीन खातेह, तेवी मसीन सेरीर माय बेलातेह? <verse eid="1CO 10:16" /><verse number="17" style="v" sid="1CO 10:17" />जिहकेरीन एकुस रूटो हे, तिहेस केरीन आपु बी जा मोकतास हेते, एकुस सेरीर हेते, काहाकाय आपु आखा तास एक रोटा माय होमायेल हेते। <verse eid="1CO 10:17" /><verse number="18" style="v" sid="1CO 10:18" />जा सेरीर ने वेह माय इस्राएली हेते ताह दिखो, काय चेड़ावो चेड़ायेल खाणारे बोगवानान वेदी माय नाह बेलाते? <verse eid="1CO 10:18" /><verse number="19" style="v" sid="1CO 10:19" />पुशो मी काय केथु, ज्यो काय मुरती पोर चेड़ायेल काह हे एने काय मुरती काह हे? <verse eid="1CO 10:19" /><verse number="20" style="v" sid="1CO 10:20" />नाह, पुण जा माणहे बोगवानाह नाह मानतेह, ता चेड़ावो चेड़ावतेह, ता बोगवानान केरता नाह पुण बुतड़ान केरता चेड़ावतेह, एने मी नाह केत काय तुमू बुतड़ान हाती हेते। <verse eid="1CO 10:20" /><verse number="21" style="v" sid="1CO 10:21" />तुमू बोगवानान सिंगुल एने बुतड़ान सिंगुल दुय माय रेन पिय नाह सेकते, तुमू बोगवानान पाटलु एने बुतड़ान पाटलु दुय माय बेचकाय नाह सेकते। <verse eid="1CO 10:21" /><verse number="22" style="v" sid="1CO 10:22" />काय आपु बोगवानाह राग लागाड़तेह? एने काय आपु बोगवानाह रेन जादा ताकेतवाला हेते?<verse eid="1CO 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:23 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 6:12">1 कुरिंथीयो 6:12</ref>
      </char>
    </note>थोड़ाक माणहे केतेह, “आखी वातु केरनेन सुट हे।” एने दिहरा माणहे केतेह, “आखो काय केरनेन हाजो हे।” पुण सोब वोस्तु माय वोड़ती नाह एणे। <verse eid="1CO 10:23" /><verse number="24" style="v" sid="1CO 10:24" />सोतान हाजो नाह पुण दिहरान हाजो केरनेन विचार किरो। <verse eid="1CO 10:24" /><verse number="25" style="v" sid="1CO 10:25" />जो काय खाटेकड़ान जागे वेचाथे, तो खावु, एने मोनान सेंकान कारेण सावाल मा फुसो? <verse eid="1CO 10:25" /><verse number="26" style="v" sid="1CO 10:26" />काहाकाय देरती एने तीन बोरपुरी बोगवानान हे। <verse eid="1CO 10:26" /><verse number="27" style="v" sid="1CO 10:27" />केदी बिगेर बोरहावाला माय रेन कुण बी तुमूह नेवता आपी एने तुमू जाणे हुदहो, ते जो काय तुमरे ओंगाण मेली तोच खावु, एने मोनान सेंकान कारेण सावाल मा फुसहो। <verse eid="1CO 10:27" /><verse number="28" style="v" sid="1CO 10:28" />पुण केदी एगदो तुमूह केय, “ज्यो ते मुरतीह चेड़ायेल वोस्तु हे, ते ता केणारान कारेण एने मोनान कारेण मा खाहो।” <verse eid="1CO 10:28" /><verse number="29" style="v" sid="1CO 10:29" />मारो मतलब तारो मोन नाह पुण ता दिहरान मोना माय मार आजादी दिहरान विचार केरीन काहा पारखे? <verse eid="1CO 10:29" /><verse number="30" style="v" sid="1CO 10:30" />केदी मी दन्यवाद केरीन बेचकाथु, ते जा पोर मी उपकार मानथु, तान वोजेसे मारी बदनामी काहा एणे?<verse eid="1CO 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 10:31" />तानकेरता तुमू खावु पिवो जो काय किरो, तो आखो बोगवानान बोड़ाय ने केरता किरो। <verse eid="1CO 10:31" /><verse number="32" style="v" sid="1CO 10:32" />तुमू यहुदिन, युनानीन केरता एने बोगवानान मोंडलीन केरता ठोकरान कारेण मा बुणो। <verse eid="1CO 10:32" /><verse number="33" style="v" sid="1CO 10:33" />जिहकेरीन मी बी सोब वातु माय आखाह खुस मेलथु, एने आपणो नाह पुण मोकतास ने फायदो होदथु, काय ताह सुटकारो जुड़ी।<verse eid="1CO 10:33" /></para>
  <chapter eid="1CO 10" />
  <chapter number="11" style="c" sid="1CO 11" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">11:1 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 4:16">1 कुरिंथीयो 4:16</ref>; <ref loc="PHP 3:17">फिलेपियो 3:17</ref></char>
    </note>तुमू मार गेत चालु जीहे मी मसीन गेत चालथु।<verse eid="1CO 11:1" /></para>
  <para style="s">विन्ता माय मुंड डापणु</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2" />एय बाय बोणहा, मी तुमूह हाजो केथु, काय आखी वातु माय तुमू माहु ईर केरतेह; एने जो नेम मी तुमूह होपेल हे, तान पालेन केरतेह। <verse eid="1CO 11:2" /><verse number="3" style="v" sid="1CO 11:3" />पुण मी होदथु काय तुमू ज्यो सोमजी लेय काय एकेक एदमीन मुंड मसी हे, एने बायकुन मुंड एदमी हे, एने मसीन मुंड बोगवान हे। <verse eid="1CO 11:3" /><verse number="4" style="v" sid="1CO 11:4" />जो एदमी मुंड ढापीन विन्ता एने बोगवानान उखीर रेन जाणाव किरेह, तो सोतान मुंडान ईजुत उड़ावीह। <verse eid="1CO 11:4" /><verse number="5" style="v" sid="1CO 11:5" />पुण जी बायकु उगाल्लो मुंड लेन विन्ता एने बोगवानान उखीर रेन जाणाव किरेह, ती सोतान मुंडान ईजुत उड़ावीह, काहाकाय ती टाली एणेन बाराबोर हे। <verse eid="1CO 11:5" /><verse number="6" style="v" sid="1CO 11:6" />केदी बायकु फाड़कु नाय पांगरी ते लेट्या बी काटाड़ लेय; केदी बायकुन केरता लेट्या काटणो एने टाली केरनो लाजावणेन वात हे, ते फाड़कु पांगरी। <verse eid="1CO 11:6" /><verse number="7" style="v" sid="1CO 11:7" />होव एदम्याह तान मुंड ढापणे हाजो नाह सोतो, काहाकाय तु बोगवानान वेह एने बोड़ाय हे, पुण बायकु एदम्यान बोड़ाय हे। <verse eid="1CO 11:7" /><verse number="8" style="v" sid="1CO 11:8" />काहाकाय एदमी बायकुम रेन नाह बुणील, पुण बायकु एदम्‍याम रेन बुणेल हे; <verse eid="1CO 11:8" /><verse number="9" style="v" sid="1CO 11:9" />एने एदमी बायकुन केरता नाह बुणेल सुतो, पुण बायकु एदम्यान केरता बुणेल हे। <verse eid="1CO 11:9" /><verse number="10" style="v" sid="1CO 11:10" />ज्यानकेरता एने हेरोगदुतान कारेण बायकुह हाजो हे काय आदिकारान निसाणी सोमजीन सोतान मुंड ढापी। <verse eid="1CO 11:10" /><verse number="11" style="v" sid="1CO 11:11" />तीबी बोगवान माय एकीन कारेण बायकु रेन एदमी आलेग नाह, एने एदमी बायकु रेन आलेग नाह। <verse eid="1CO 11:11" /><verse number="12" style="v" sid="1CO 11:12" />काहाकाय बायकु एदम्या माय रेन बुणेल हे, तिहेस केरीन एदमी बी बायकुन द्‍वारे पायदा ईथे, पुण जो सोब बोगवानान उगे रेन आयेल हे। <verse eid="1CO 11:12" /><verse number="13" style="v" sid="1CO 11:13" />तुमू सोतास विचार किरो, काय बायकुह उगाल्लो मुंड लेन बोगवानाह विन्ता केरनो होबा दिथे। <verse eid="1CO 11:13" /><verse number="14" style="v" sid="1CO 11:14" />दुनियान रितीन गेत तुमू नाह जाणते, केदी एदमी लाम्बाला लेट्या मेली ते तान केरता ईजुत उड़ावणेन बाराबोर हे। <verse eid="1CO 11:14" /><verse number="15" style="v" sid="1CO 11:15" />पुण केदी बायकु लाम्बाला लेट्या मेली ताहार तीन केरता होबा हे, काहाकाय लेट्या तीह मुंड ढापणेन केरता आपेल हे। <verse eid="1CO 11:15" /><verse number="16" style="v" sid="1CO 11:16" />पुण केदी कुण बोलाचाल केरने होदि, ते ज्यो जाण लेय काय नाह आमरी एने नाह बोगवानान मोंडलीन ओहली रिती हे।<verse eid="1CO 11:16" /></para>
  <para style="s">मालीकान खाणान बारामाय</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17" />पुण ज्यो उकुम आपतेन मी तुमरी बोड़ाय नाह किरेत, जेवी तुमू बोगवानान बोक्ती केरनेन केरता एकठा टोलवातेह, तेवी हाजो नाह ईत, पुण नुकसान ईथे। <verse eid="1CO 11:17" /><verse number="18" style="v" sid="1CO 11:18" />काहाकाय पेल ते मी ज्यो होमेलथु, काय जेवी तुमू मोंडली माय एकठा एतेह ताहार तुमरा माय फुट ईथे, एने मी ज्यी वातु पोर थुड़ थुड़ो बुरहो बी केरथु। <verse eid="1CO 11:18" /><verse number="19" style="v" sid="1CO 11:19" />काहाकाय बेदबाव बी तुमू माय एय, ज्यानकेरता काय जा माणहा तुमू माय खेरा हेते ता देखाय जाती। <verse eid="1CO 11:19" /><verse number="20" style="v" sid="1CO 11:20" />तान केरता जेवी तुमू एक जागे एकठा एतेह, ते ज्यानकेरता नाह काय मालीकान खाणो खाय। <verse eid="1CO 11:20" /><verse number="21" style="v" sid="1CO 11:21" />काहाकाय खाणेन बुखेत एक दिहराह रेन पेल सोतान खाणो खाय लेतेह, इहीचकेरीन कुण ते बुखल्यो रिथे, एने एगदो ते पियेन दुंदवाय जाथे। <verse eid="1CO 11:21" /><verse number="22" style="v" sid="1CO 11:22" />काय खाणे पिणेन केरता तुमरो गेर नाह सोतो? एने बोगवानान मोंडलीह खाराब जाणतेह, एने जा फाय नाह सोतो ताह लाजवाड़तेह? मी तुमूह काय केव? एने काय मी तुमरी बोड़ाय केरू? नाह; ज्यी वातुन केरता मी तुमरी बोड़ाय नाय केरूह।<verse eid="1CO 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23" />काहाकाय ज्यी हिकवोण माहु मालीक फाय रेन जुड़नीह एने मी तुमू फाय बी पोचाड़ दिनो, जी राती मालीक यीशु देराव दियेल, रूटो लिदो, <verse eid="1CO 11:23" /><verse number="24" style="v" sid="1CO 11:24" />एने बोगवानान उपकार मानेन ता रोटाह मुड़ीन केयो, “ज्यो मारो सेरीर हे जो तुमरी केरता आपाय जायेल हे, मारी इर ने केरता ज्योस केऱ्या किरो।” <verse eid="1CO 11:24" /><verse number="25" style="v" sid="1CO 11:25" />तिहेस केरीन खाणो खाणेन पासाण वाटको लिदो एने केयो, “ज्‍यु वाटको मारी लुय माय नोवाली वायदो हे, जुलबुखे बी पिहो, ते मारी इर ने केरता ज्योस केऱ्या किरो।” <figure style="fig" alt="Jesus eating the Passover meal with his disciples" file="lb00320c.tif" size="span" copy="Horace Knowles ©" ref="11:23">यीशु चेला हिऱ्यो सेवल्यो खाणो खाणे </figure><verse eid="1CO 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 11:26" />काहाकाय जाह वोर तुमू ज्‍यु रूटो खातेह एने ज्या सिंगुल माय रेन पितेह, ते मालीकान मोतीह जाह वोर तु नाह आवीत, पारचार केरती रिवो। <verse eid="1CO 11:26" /><verse number="27" style="v" sid="1CO 11:27" />तानकेरता जो कुण गेलेत रिती माय मालीकान रूटो खाय एने तान वाटका माय रेन पिय, तो मालीकान सेरीरान एने लुयान गुनेगार ठेराय। <verse eid="1CO 11:27" /><verse number="28" style="v" sid="1CO 11:28" />तानकेरता माणुह सोताह पारेख लेय एने इहीचकेरीन ज्या रोटा माय रेन खाय, एने ज्या सिंगुल माय रेन पिय। <verse eid="1CO 11:28" /><verse number="29" style="v" sid="1CO 11:29" />काहाकाय जा खाणे पिणे बुखेत मालीकान सेरीराह नाय उलखे, तो ज्या खाणा पिणा पोर रेन सोतान उपेर डेंड लावतेह। <verse eid="1CO 11:29" /><verse number="30" style="v" sid="1CO 11:30" />जीह केरीन तुमरा माय मोकतास कोमजोर एने दुखाऱ्या हेते, एने मोकतास मोरी बी जायेल हेते। <verse eid="1CO 11:30" /><verse number="31" style="v" sid="1CO 11:31" />केदी आपु सोताह पारेखता ते बोगवाना उखीर रेन डेंड नाय लेता। <verse eid="1CO 11:31" /><verse number="32" style="v" sid="1CO 11:32" />पुण बोगवान आपुह डेंड आपीन आपुह सेजा आपेह, ज्यानकेरता बोगवान आपणो नियाव केरीन दोसी नाय ठेराहो।<verse eid="1CO 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 11:33" />तानकेरता एय मार बाय बोणहा, जुलबुखे तुमू मालीकान खाणो खाणेन केरता टुलो एतेह, ते एका दिहरान केरता थोब्या किरो। <verse eid="1CO 11:33" /><verse number="34" style="v" sid="1CO 11:34" />केदी एगदाह बुख लागतेय ते तान गेरूस रूटो खाईन आवी, ताकाय जेवी तुमू टुलो एतेह, ते डेंडान कारेण नाय एय, रियेल वातुह मी आवीन ठिक केरूह।<verse eid="1CO 11:34" /></para>
  <chapter eid="1CO 11" />
  <chapter number="12" style="c" sid="1CO 12" />
  <para style="s">चोखाला जीवान वरदान</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1" />एय बाय बोणहा, मी नाह हुदेत काय तुमू चोखाला जीवान वरदानान बारामाय एंजाणल्या रिवो। <verse eid="1CO 12:1" /><verse number="2" style="v" sid="1CO 12:2" />जेवी तुमू खेरला बोगवानाह नाह ओलेखताला, ते बात बातीन मुरतीन बोक्ती केरताला। <verse eid="1CO 12:2" /><verse number="3" style="v" sid="1CO 12:3" />तानकेरीन मी तुमूह इसारो आपथु, काय जो कुण बोगवानान जीवान उगे रेन बुलीह, तो नाह केत काय यीशु हाराप वालो हे, एने नाह कुण चोखाला जीवान बिगेर केय सिकेह काय यीशु मालीक हे।<verse eid="1CO 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:4 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 12:6-8">रोमीयो 12:6-8</ref>
      </char>
    </note>वरदान ते जुलूम बातीन हेते, पुण जीव एकुस हे; <verse eid="1CO 12:4" /><verse number="5" style="v" sid="1CO 12:5" />एने सेवा बी जुलूम बातीन हेत्यु, पुण मालीक एकुस हे; <verse eid="1CO 12:5" /><verse number="6" style="v" sid="1CO 12:6" />एने चेकीत एय ओहला कामे जुलूम बातीन हेते, पुण बोगवान एकुस हे, जो एकेक माय आखी बातीन काम किरेह। <verse eid="1CO 12:6" /><verse number="7" style="v" sid="1CO 12:7" />पुण सोबाह फायदो पोचाड़णेन केरता एकेक माय बोगवानान जीव देखाथी। <verse eid="1CO 12:7" /><verse number="8" style="v" sid="1CO 12:8" />काहाकाय चोखाला जीवान द्‍वारे एकेकाह बुद्दीन वचन एने दिहराह इकेलान वचन जुड़ेह। <verse eid="1CO 12:8" /><verse number="9" style="v" sid="1CO 12:9" />एने एगदाह तोस जीव बुरहो केरनेन केरता एने एगदाह तास जीवा केरीन हुदारनेन वरदान आपाय जाथे। <verse eid="1CO 12:9" /><verse number="10" style="v" sid="1CO 12:10" />ओवतो एगदाह ताकेत ने काम केरनेन केरता सेक्ती, एने एगदाह बोगवानान खुबेर केणेन इकेल एने एगदाह जीवान वरदानाह पारेखणेन केरता, एने एगदाह एंजाणल्यु बाषा बोलनेन केरता, एने एगदाह बाषान मतलब केणेन केरता आपेल हे। <verse eid="1CO 12:10" /><verse number="11" style="v" sid="1CO 12:11" />पुण ज्या सोब लागणारे कामे एकुस तो बोगवानान जीव केरने, एने आलेग आलेग वरदान वाट दिथे जाह जो जुवे।<verse eid="1CO 12:11" /></para>
  <para style="s">एक सेरीर मोकतास आंग</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:12 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 12:4">रोमीयो 12:4</ref>,<ref loc="ROM 12:5">5</ref></char>
    </note>काहाकाय जीह केरीन सेरीर ते एक हे, एने तान आंग मोकतास हेते, एने तास एक सेरीरान सोब आंग मोकतास हेते, तीबी सोब मिलीन एकुस सेरीर हेते, तिहेस केरीन मसीन सेरीर बी हे। <verse eid="1CO 12:12" /><verse number="13" style="v" sid="1CO 12:13" />काहाकाय यहुदि, एने बिगेर यहुदि, एने पावोर, एने जो आजाद हे आपु आखा एकुस जीवान द्‍वारे एक सेरीर एणेन केरता बपतीस्मा लेदा, एने आपु आखाह एकुस जीव बोगवान आपेल हे।<verse eid="1CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 12:14" />तानकेरता सेरीर माय एकुस आंग नाह सोतो, पुण मोकतास हेते। <verse eid="1CO 12:14" /><verse number="15" style="v" sid="1CO 12:15" />केदी पाय केय, “मी आथ नाह सुतो, तानकेरता मी सेरीरान नाह सुतो,” ते तो जी कारेण सेरीरान नाय मीले काय? <verse eid="1CO 12:15" /><verse number="16" style="v" sid="1CO 12:16" />केदी कान केय, “मी डुलो नाह सुतो, तानकेरता मी सेरीरान नाह सुतो,” ते तो जी कारेण सेरीरान नाय मीले काय? <verse eid="1CO 12:16" /><verse number="17" style="v" sid="1CO 12:17" />केदी आखो सेरीर डुलोस रितो, ते होमेलनो का रेतो? केदी आखो कानुस सेरीर रितो, ते गेंद लेणो का रेतो? <verse eid="1CO 12:17" /><verse number="18" style="v" sid="1CO 12:18" />पुण बोगवान आंगाह तान मोरजीन गेत एक एक केरीन सेरीर माय मिलेल हे। <verse eid="1CO 12:18" /><verse number="19" style="v" sid="1CO 12:19" />केदी ता सोब एकुस आंग रेता, ते सेरीर का रेतो? <verse eid="1CO 12:19" /><verse number="20" style="v" sid="1CO 12:20" />पुण एवी ते आंग मोकतास हेते, पुण सेरीर एकुस हे। <verse eid="1CO 12:20" /><verse number="21" style="v" sid="1CO 12:21" />डुलो आथाह नाह केय सिकेत, “माहु तारी गिरेज नाह सोती,” एने नाह मुंड पायाह केय सिकेह, “माहु तारी गिरेज नाह सोती।” <verse eid="1CO 12:21" /><verse number="22" style="v" sid="1CO 12:22" />पुण सेरीरान ता आंग जा दिहराह रेन कोमजोर लागतेह, ताज ने जुलूम गिरेज हे; <verse eid="1CO 12:22" /><verse number="23" style="v" sid="1CO 12:23" />एने सेरीरान जा आंगाह आपु खाराब सोमेजतेह, ताह आपु होवटाह ढापीन मेलतेह, एने आपणा होबादार आंगाह ढापणेन गिरेज नाह सोती। <verse eid="1CO 12:23" /><verse number="24" style="v" sid="1CO 12:24" />तीबी आमरा होबादार आंगाह ज्यान गिरेज नाह, पुण बोगवान सेरीराह ओहलो बोणाव दियेल हे काय जा आंगाह आदर ने कोमी एती, ताहचे उंजु बी जुलूम आदार जुड़नो। <verse eid="1CO 12:24" /><verse number="25" style="v" sid="1CO 12:25" />काहाकाय सेरीरा माय फुट नाय पोड़ी, पुण आंग एका दिहरान बाराबोर चिन्ता केरी। <verse eid="1CO 12:25" /><verse number="26" style="v" sid="1CO 12:26" />तानकेरता केदी एक आंग दुख लिथे, ते सोब आंग ता हेऱ्या दुख लेतेह; एने केदी एक आंगान बोड़ाय ईथे ते, ता हेऱ्या सोब आंग खुसी केरतेह।<verse eid="1CO 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 12:27" />इहकेरीन तुमू आखा टुलो एन मसीन सेरीर हेते, एने आलेग आलेग तान आंग हेते; <verse eid="1CO 12:27" /><verse number="28" style="v" sid="1CO 12:28" /><note caller="+" style="x"><char style="xo" closed="false">12:28 </char><char style="xt" closed="false"><ref loc="EPH 4:11">इफिसीयो 4:11</ref></char></note>एने बोगवान मोंडली माय आलेग आलेग माणुह निवाड़ेल हे, पेल्ला प्रेरित, दिहरा जाणकारे, तीसरा हिक आपणारे, एने ताकेत ने काम केरनारे, एने हुदारणारे, एने दिहराह मोदेक केरनारे, एने तियार केरनारे, एने एंजाणल्ली बाषा बोलणारे। <verse eid="1CO 12:28" /><verse number="29" style="v" sid="1CO 12:29" />काय सोब प्रेरित हेते? काय सोब जाणकार हेते? काय सोब हिकाड़नारे हेते? काय सोब ताकेत ने काम केरनारे हेते? <verse eid="1CO 12:29" /><verse number="30" style="v" sid="1CO 12:30" />काय सोबाह हुदारनेन वरदान जुड़ेल हे? काय सोब एंजाणल्ली बाषा बोलतेह? एने काय सोब एंजाणल्ली बाषान अनुवाद केरतेह? <verse eid="1CO 12:30" /><verse number="31" style="v" sid="1CO 12:31" />पुण तुमू मोटला रेन मोटला वरदानान आसा माय रिवो,</para>
  <para style="p" vid="1CO 12:31">पुण मी तुमूह उंजु बी आखाम हाजी वाट देखाड़थु।<verse eid="1CO 12:31" /></para>
  <chapter eid="1CO 12" />
  <chapter number="13" style="c" sid="1CO 13" />
  <para style="s">मोंग आखाम रेन हाजी वाट</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1" />केदी मी माणहान एने हेरोगदुतान बोल बोलुह एने मोंग नाय केरू, ते मी ठेन ठेन केरनार पितलीन गेन्टी एने जेन जेन केरनार जांजऱ्यो हे। <verse eid="1CO 13:1" /><verse number="2" style="v" sid="1CO 13:2" /><note caller="+" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="MAT 17:20">मत्ती 17:20</ref>; <ref loc="MAT 21:21">21:21</ref>; <ref loc="MRK 11:23">मरकुस 11:23</ref></char></note>एने माहु केदी बोगवानान उखीर रेन आवणेवालो खोबरीन वरदान जुड़ेल एय, एने सोब मालमात केरनेन बुद्दी जुड़ेल हे, एने माहु न्या वोर पुरो बुरहो एय काय मी बोयड़ाह सिटो केर देव, पुण मोंग नाय केरू ते मी काईस नाह सुतो। <verse eid="1CO 13:2" /><verse number="3" style="v" sid="1CO 13:3" /><note caller="+" style="f"><char style="fr" closed="false">13:3 </char><char style="ft" closed="false">हेलगाड़नेन केरता; थोड़ाक लेख माय बोड़ाय मारने वाला हे। </char></note>केदी मी मारो आखो मालदेन गेरब्याह वाट देव, एने मारो सेरीर हेलगाड़नेन केरता आप देव, एने मोंग नाय केरू, ते माहु काईस फायदो नाह सुतो।<verse eid="1CO 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4" />मोंग दिर देरनार हे, एने किववालो हे, मोंग विरोद नाह केरने मोंग सोतान बोड़ाय नाह केरने एने फुलने नाह, <verse eid="1CO 13:4" /><verse number="5" style="v" sid="1CO 13:5" />तो बिगेर रितीस नाह चालने, एने सोतान हाजो नाह होदणे, तो किचवाणे नाह एने दिहरान खाराब वातुन ईसाब नाह मेलने। <verse eid="1CO 13:5" /><verse number="6" style="v" sid="1CO 13:6" />मोंग अन्याय ने कामाह देखीन खुस नाह एणे, पुण खेरायीह देखीन खुस एणे। <verse eid="1CO 13:6" /><verse number="7" style="v" sid="1CO 13:7" />तो सोब वातुह वेठ लेणे, एने सोब वातु पोर बुरहो केरने, एने सोब वातुन आसा केरने, एने सोब वातु माय दिर मेलने।<verse eid="1CO 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8" />मोंग केदी टेलने नाह बोगवाना फाय रेन आयेल खुबेर ते खेतेम एय जाय, एने एंजाणल्ली बाषा ते निवरी जाती, एने इकेल एय ते मिट जाय। <verse eid="1CO 13:8" /><verse number="9" style="v" sid="1CO 13:9" />काहाकाय आमरी इकेल आरदे हे, एने आमरी बोगवाना फाय रेन आयेल जाणाव आरदीच हे; <verse eid="1CO 13:9" /><verse number="10" style="v" sid="1CO 13:10" />पुण जेवी बोगवान आखो काय पुरो केरी, तेवी आरदो रेय तो मिट जाय। <verse eid="1CO 13:10" /><verse number="11" style="v" sid="1CO 13:11" />जेवी मी सोरोस ईतो तेवी मी सोरान गेत बोलतालो एने सोरान गेत मोन एतो, एने सोरान गेत सोमेज एती, पुण जेवी सोमेजदार बोण गीयो, तेवी बचपणान वातु सोड़ दिनो। <verse eid="1CO 13:11" /><verse number="12" style="v" sid="1CO 13:12" />एवी आपुह आरसा माय दुंदवाल्लोह देखाह, पुण तुलबूखे आमने सामने देखती उलबुखे मारो ईकेल आरदो हे, पुण मी तुलबूखे हास केरीन ओलखाय जाह, जिहकेरीन बोगवान उलखेल हे। <verse eid="1CO 13:12" /><verse number="13" style="v" sid="1CO 13:13" />पुण एवी बुरहो, आसा, मोंग, ज्या तीनु जागावाला हेतेस, पुण न्या आखा माय रेन मुठो मोंग हे।<verse eid="1CO 13:13" /></para>
  <chapter eid="1CO 13" />
  <chapter number="14" style="c" sid="1CO 14" />
  <para style="s">चोखाला जीवान बारा माय मोकती हिकवोण</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1" />मोंगान गेत चालनेन केरता तुमरी उखीर रेन पुरी कोसीत किरो, एने आत्मिक वरदानान दुंदी माय बी रिवो खास केरीन ज्यो काय बोगवाना फाय रेन आयेल जाणाव ने केरता। <verse eid="1CO 14:1" /><verse number="2" style="v" sid="1CO 14:2" />काहाकाय जा एंजाणल्ली बाषा माय वातु केरतेह, ता माणहा हेऱ्यो नाह पुण बोगवाना हेऱ्यो वातु किरेह, ज्यानकेरीन काय तान वातु कुण नाह सोमेजणे, काहाकाय तो चोखाला जीवान ताकेत माय बुलीह। <verse eid="1CO 14:2" /><verse number="3" style="v" sid="1CO 14:3" />पुण जा बोगवानान उगे रेन जाणाव केरतेह, आत्मिक उन्नती दिलासो एने दिर ने केरता माणहाह संबोदित किरेह। <verse eid="1CO 14:3" /><verse number="4" style="v" sid="1CO 14:4" />जा एंजाणल्ली बाषा माय वातु किरेह, तो सोतास ने वोदणेन वातु किरेह, पुण जो बोगवाना उगे रेन जाणाव लावीह, तो मोंडलीह वोदणेन किरेह।<verse eid="1CO 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 14:5" />मारी ज्यी मोरजी हे काय तुमू आखा एंजाणल्ली बाषा माय वातु केरी, पुण ज्याह रेन होवटो ज्यो होदथु काय बोगवाना फाय रेन आयेल जाणाव ने वातु किरो, काहाकाय केदी एंजाणल्ली बाषा बोलनार मोंडलीन वोदणेन केरता अनुवाद नाय केरी, ते बोगवाना फाय रेन आयेल खुबेर आपणार ताह रेन वादार हे।<verse eid="1CO 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 14:6" />ज्यानकेरीन एय बाय बोणहा, केदी मी तुमरे आहने आवीन एंजाणल्ली बाषा माय वातु केरू, ते माहु रेन तुमूह काय फायदु एय। पुण उजेड़, इकेल, एने बोगवाना फाय रेन आयेल खुबेर, एने पारचारान वातु नाय लेन आवो ते काय फायदु।<verse eid="1CO 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 14:7" />तिहेस केरीन केदी विण जीव वोस्तु बी जा माय रेन आवाज निकलेह, जीहे पावली, एने रेणथो, तो केदी वाजी नाय ते तान आवाज किहीक ओलखाय? <verse eid="1CO 14:7" /><verse number="8" style="v" sid="1CO 14:8" />केदी पावली आवाज साप निही, एय ते कुण लेड़ाय ने केरता तियारी केरी? <verse eid="1CO 14:8" /><verse number="9" style="v" sid="1CO 14:9" />इहीचकेरीन तुमू बी केदी जिबी केरीन साप साप वातु नाय किहो, ते जो काय केवाथे, ताह माणहे किहीक सोमेजती? तुमू ते वारा हेऱ्या वातु केरनारे ठेराहो। <verse eid="1CO 14:9" /><verse number="10" style="v" sid="1CO 14:10" />दुनिया माय कोलीक बी बातीन बाषा काह निहे एती, पुण ती माय रेन काल्ली बी बिगेर मतलब ने निहे एती। <verse eid="1CO 14:10" /><verse number="11" style="v" sid="1CO 14:11" />केरीन केदी मी काल्ली बी बाषान मतलब नाय सोमजु, ते बोलणारान नेजरी माय पारदेसा वालो ठेराह, एने बोलणार मारी नेजेर माय पारदेसा वालो ठेराय। <verse eid="1CO 14:11" /><verse number="12" style="v" sid="1CO 14:12" />तानकेरीन तुमू बी जुलबुखे आत्मिक वरदानान दुंदी माय रिहो, ते ओहली कोसीत किरो काय जीवान ता वरदानान द्‍वारे मोंडलीन वोड़ती एय। <figure style="fig" alt="musical instruments" file="hk00188c.tif" size="col" copy="Horace Knowles ©" ref="14:7">वाजान सामान</figure><verse eid="1CO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13" />विन्ता केरी काय चोखालो जीव एंजाणल्ली वातुन अनुवाद केर सिके। <verse eid="1CO 14:13" /><verse number="14" style="v" sid="1CO 14:14" />तानकेरीन केदी मी एंजाणल्ली बाषा माय विन्ता केरू, ते मारो जीव विन्ता किरेह पुण मारी बुद्दी काम नाह देणे। <verse eid="1CO 14:14" /><verse number="15" style="v" sid="1CO 14:15" />ते माहु केरने काय जुवे? मी जीवा केरीन बी विन्ता केरूह; एने बुद्दी केरीन बी विन्ता केरूह; मी जीवा केरीन बी गावुह, एने बुद्दी केरीन बी गावुह। <verse eid="1CO 14:15" /><verse number="16" style="v" sid="1CO 14:16" />केदी तु जीवास केरीन उपकार मानहे, ते ओवता बिगेर इकेल वाला तार उपकारा पोर आमेन किहीक केती? काहाकाय ता ते जाणेत नाह काय तु खेरीच काय किथे? <verse eid="1CO 14:16" /><verse number="17" style="v" sid="1CO 14:17" />तु ते हास केरीन उपकार मानीह, पुण दिहरान वोड़ती नाह एत।<verse eid="1CO 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18" />मी मार बोगवानान उपकार मानथु, काय मी तुमू सोबाह रेन वादार एंजाणल्ली बाषा माय बोलथु। <verse eid="1CO 14:18" /><verse number="19" style="v" sid="1CO 14:19" />पुण मोंडली माय एंजाणल्ली बाषा माय पाच वातु केणे, ताह रेन ज्यो माहु हाजो मालुम पुड़ेह, काय दिहराह हिकाड़णेन केरता बुद्दी केरीन पाचुस वातु केव।<verse eid="1CO 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20" />एय बाय बोणहा, तुमू सोमेज माय सोरा मा बुणो; गेलेत माय सोरान गेत रिवो, पुण सोमेजदारी माय मोठलान गेत बुणो। <verse eid="1CO 14:20" /><verse number="21" style="v" sid="1CO 14:21" />देरेम पुस्तेक माय लिखेल हे:</para>
  <para style="q1" vid="1CO 14:21">मालीक किथे, “मी एंजाणल्ली बाषा बोलणारान द्‍वारे</para>
  <para style="q2" vid="1CO 14:21">एने पाराया मुखान द्‍वारे</para>
  <para style="q1" vid="1CO 14:21">न्या माणहा हिऱ्यो वातु केरूह,</para>
  <para style="q2" vid="1CO 14:21">तीबी ता मारी नाय होमेलती।”<verse eid="1CO 14:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="1CO 14:22" />केरीन एंजाणल्ली बाषा बोलनेन वरदान बोरहावालान केरता नाह सोती, पुण विण बोरहावालान केरता निसाणी हे, एने बोगवाना उखीर रेन खुबेर अविश्वासीन केरता नाह सोतो, पुण बोरहावालान केरता चोमेत्कारान निसाणी हे।<verse eid="1CO 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 14:23" />केदी मोंडली एक जागे एकठी एय, एने आखान आखा एंजाणल्ली बाषा बोली, एने बाहेरवाला एने अविश्वासी माणहा माय आव लागी, ते काय ता तुमूह गांडा नाय केती? <verse eid="1CO 14:23" /><verse number="24" style="v" sid="1CO 14:24" />पुण केदी सोब बोगवाना उगे रेन आयेल जाणाव केणे बाज जाय, ते विण बोरहावालो एने बाहेरवालो माणहे माय आव लागती, ते ता सोमजी जाती काय आमु पापी हेते, एने जो ता होमलेल हेते तान द्‍वारे नियाव केराय जाय। <verse eid="1CO 14:24" /><verse number="25" style="v" sid="1CO 14:25" />एने तान मोनान मालमात देखाय जाय, एने तो मुयान बोरहे पोड़ीन बोगवानाह आथ जोड़ीन बोक्ती किरतेन केय, “खेरीच बोगवान तुमरी विची माय हे।”<verse eid="1CO 14:25" /></para>
  <para style="s">बोक्ती माय नेम</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26" />तानकेरता एय बाय बोणहा काय केरने जुवे? जुलबुखे तुमू एकठा एतेह, तुलबूखे एकेकान मोना माय गीत, एने पारचार, एने एंजाणल्ली बाषा, एने उजेड़, एने एंजाणल्ली बाषान मतलब केणेन रेणे आखो काय आत्मिक वोड़तीन केरतास एणे जुवे। <verse eid="1CO 14:26" /><verse number="27" style="v" sid="1CO 14:27" />केदी एंजाणल्ली बाषा माय वातु केरनो एय, ते दुय नाहते तीन जाणे वारी वारी माय बोली, एने एक माणुह अनुवाद केरनार रेणे जुवे। <verse eid="1CO 14:27" /><verse number="28" style="v" sid="1CO 14:28" />पुण केदी अनुवाद केरनार निहे एय ताहार एंजाणल्ली बाषा बोलनार मोंडली माय ठावकु रेय, एने सोता हिऱ्यो एने बोगवाना हिऱ्यो वातु केरी। <verse eid="1CO 14:28" /><verse number="29" style="v" sid="1CO 14:29" />एने दुय नाहते तीन जाणे बोगवानान जाणकारे रेय, एने दिहरा माणहे तान वचनाह पारखे। <verse eid="1CO 14:29" /><verse number="30" style="v" sid="1CO 14:30" />पुण केदी बोहणारा माय रेन एगदाह बोगवाना उखीर रेन काह खुबेर जुड़ने एय, ते पेल्लो ठावको एय जाय। <verse eid="1CO 14:30" /><verse number="31" style="v" sid="1CO 14:31" />काहाकाय तुमू आखा एक एक केरीन बोगवाना उखीर रेन आयेल जाणाव ने पारचार केर सेकतेह, काहाकाय आखा हिके एने आखाह दिलासो जुड़ सेकी। <verse eid="1CO 14:31" /><verse number="32" style="v" sid="1CO 14:32" />एने बोगवाना उखीर रेन जाणाव केरनारान जीवान वरदान तान ताबा माय रिथे। <verse eid="1CO 14:32" /><verse number="33" style="v" sid="1CO 14:33" />काहाकाय बोगवान कापालीन नाह, पुण सान्तीन बोगवान हे।</para>
  <para style="p" vid="1CO 14:33">ओहलोस बोगवानान चोखाला माणहान आखी मोंडल्यु माय एणे जुवे। <verse eid="1CO 14:33" /><verse number="34" style="v" sid="1CO 14:34" />बायकु मोंडलीन पोंचा माय ठावक्यु रेय, काहाकाय त्युह वातु केरनेन उकुम नाह सुतो, पुण ताबा माय रेणेन उकुम हे, जीह कायदा माय लिखेल बी हे। <verse eid="1CO 14:34" /><verse number="35" style="v" sid="1CO 14:35" />केदी त्यु काह हिकणे होद्ती एती ते गेरा माय जान तान एदम्याह फुसे, काहाकाय बायकु मोंडली माय वातु केरी ते लाज ने वात हे।<verse eid="1CO 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36" />काय बोगवानान वचन तुमूस माय रेन निकेलने? काय तुमू फाय ओलोस पुचील हे? <verse eid="1CO 14:36" /><verse number="37" style="v" sid="1CO 14:37" />केदी एगदो माणुह सोताह बोगवानान उगे रेन आवणेवाली खुबेर जाणकार एने आत्मिक जाण सुमजेह, ताहार ज्यो जाण लेय काय जी वात मी तुमूह लेखथु, तो मालीकान उकुम हे। <verse eid="1CO 14:37" /><verse number="38" style="v" sid="1CO 14:38" />पुण केदी एगदो ज्याह नाह स्वीकारीत, ते तान उखीर बी द्यान नाय देवाय जाय।<verse eid="1CO 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39" />एय बाय बोणहा, बोगवानान उगे रेन जाणाव बोलनेन केरता आसा मीलु, एने एंजाणल्ली बाषा बोलनेन केरता ताह मा रूको; <verse eid="1CO 14:39" /><verse number="40" style="v" sid="1CO 14:40" />पुण आख्‍यु वातु माय चेतरायेह एने हास केरीन रूपा माय किरो।<verse eid="1CO 14:40" /></para>
  <chapter eid="1CO 14" />
  <chapter number="15" style="c" sid="1CO 15" />
  <para style="s">यीशुन मोती माय रेन जीव उठणो</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1" />एय बाय बोणहा, एवी मी तुमूह तीच पेल होमलायेल हाजाली खुबेर इर केरावणे होद्थु, जीह तुमू मानील बी एता, एने जा माय तुमू मोजबुत बी हेते। <verse eid="1CO 15:1" /><verse number="2" style="v" sid="1CO 15:2" />ज्यी हाजाली खोबरीन द्‍वारे तुमूह सुटकारो जुड़ेल हे, ताह देरीन रेतेह; नाहते तुमरो बुरहो केरनो काईच काम नाय आवी।<verse eid="1CO 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3" />ज्यी वात माहु फाय वोर पुचील एती, तीह मी आखा रेन मोहत्वान सोमजीन तुमू माय वोर पोचाड़ दियेल हे, ती ज्यी काय देरेम पुस्तेकान गेत यीशु मसी आपणा पापान केरता मोरनु <verse eid="1CO 15:3" /><verse number="4" style="v" sid="1CO 15:4" /><note caller="+" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="MAT 12:40">मत्ती 12:40</ref>; <ref loc="ACT 2:24-32">प्रेरितान काम 2:24-32</ref></char></note>एने ताह बुज दियेल, एने चोखाली पुस्तेकान गेत तीसरे दिह जीव बी उठील, <verse eid="1CO 15:4" /><verse number="5" style="v" sid="1CO 15:5" /><note caller="+" style="x"><char style="xo" closed="false">15:5 </char><char style="xt" closed="false"><ref loc="LUK 24:34">लुका 24:34</ref>; </char><char style="xt" closed="false"><ref loc="MAT 28:16">मत्ती 28:16</ref>,<ref loc="MAT 28:17">17</ref>; <ref loc="MRK 16:14">मरकुस 16:14</ref>; <ref loc="LUK 24:36">लुका 24:36</ref>; <ref loc="JHN 20:19">योहान 20:19</ref></char></note>एने पेल पतरसाह एने पासाण बारा चेलाह देखानो। <verse eid="1CO 15:5" /><verse number="6" style="v" sid="1CO 15:6" />उवतो यीशु पाच होवाह रेन बी जादा विश्वासी बाय बोणहा एकठोस देखानो, ता माय रेन जुलूम जाणे एवी वोर जीवताला हेते, पुण थोड़ाक मोर गीयाह। <verse eid="1CO 15:6" /><verse number="7" style="v" sid="1CO 15:7" />पुशो तो याकुबाह एने आखा प्रेरिताह देखानो। <verse eid="1CO 15:7" /><verse number="8" style="v" sid="1CO 15:8" /><note caller="+" style="x"><char style="xo" closed="false">15:8 </char><char style="xt" closed="false"><ref loc="ACT 9:3-6">प्रेरितान काम 9:3-6</ref></char></note>आखान पासाण माहु बी देखानो, ज्यो सुमजो काय पायदा एणेन दिह्यान पेल पायदा इनोह।<note caller="+" style="f"><char style="fr" closed="false">15:8 </char><char style="ft" closed="false">जान जेल्मो नियमीत नाह सोतो; नाहते गेलेत टेम माय जेल्मो लियेल हे।</char></note> <verse eid="1CO 15:8" /><verse number="9" style="v" sid="1CO 15:9" /><note caller="+" style="x"><char style="xo" closed="false">15:9 </char><char style="xt" closed="false"><ref loc="ACT 8:3">प्रेरितान काम 8:3</ref></char></note>काहाकाय मी आखा चेलाम रेन आत्यो हे, एने प्रेरित केवाणेन लायेक बी नाह सुतो, काहाकाय मी बोगवानान मोंडलीह सेतायेल ईतो <verse eid="1CO 15:9" /><verse number="10" style="v" sid="1CO 15:10" />पुण मी जो काय बी हे बोगवानान किव माय हे, तान किव जो मार पोर ईयेल हे, तो उदेड़ नाह ईयेल, पुण मी ता आखाह रेन वादार मेहनेत बी किरेल तीबी ज्यो मार उगे रेन नाह एनो, पुण बोगवानान किव केरीन जी मार पोर एती। <verse eid="1CO 15:10" /><verse number="11" style="v" sid="1CO 15:11" />तानकेरता मी हे नाहते ता एती, आमु ज्योस पारचार केरतेह, एने ज्यास पोर तुमू बी बुरहो किरेल।<verse eid="1CO 15:11" /></para>
  <para style="s">आपणो पोशो जीव उठणो</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12" />ज्यानकेरीन जुलबुखे काय मसीन ज्यो पारचार केराय जाथे, काय तो मुरेल माय रेन जीव उठनो, तेवी तुमू माय रेन थोड़ाक माणहे इहकेरीन काहा केतेह काय मुरेल तान पोशो जीव उठणेच नाह सोतो? <verse eid="1CO 15:12" /><verse number="13" style="v" sid="1CO 15:13" />केदी मुरेलान पोशो जीव उठणो सोतोच नाह, ते मसी बी निहे जीव उठनो एय। <verse eid="1CO 15:13" /><verse number="14" style="v" sid="1CO 15:14" />एने केदी मसी नाय जीव उठतो, ते आमरो पारचार केरनो बी उदेड़ हे, एने तुमरो बुरहो बी उदेड़ हे। <verse eid="1CO 15:14" /><verse number="15" style="v" sid="1CO 15:15" />एने आमु बोगवानान जुठा गोवाह ठेराहो, काहाकाय आमु बोगवानान बारामाय ज्‍यु पुरावो दियेल काय तो मसीह जीवाड़ दियेल हे, एने केदी मुरेल माणहे जीवाड़ाय नाय जाते ते मसी बी जीव नाय उठतो। <verse eid="1CO 15:15" /><verse number="16" style="v" sid="1CO 15:16" />एने केदी मुरेल नाय जीव उठता, ते मसी बी नाय जीव उठतो; <verse eid="1CO 15:16" /><verse number="17" style="v" sid="1CO 15:17" />पुण केदी मसी नाय जीव उठतो, ते तुमरो बुरहो उदेड़ हे एने तुमू एवी वोर सोतान पापा माय खोवाय रेनाह। <verse eid="1CO 15:17" /><verse number="18" style="v" sid="1CO 15:18" />पुण जा मसी पोर बुरहो केरनारे मोर जायेल हेते, ता बी खेतेम ईयेल हेते। <verse eid="1CO 15:18" /><verse number="19" style="v" sid="1CO 15:19" /><note caller="+" style="f"><char style="fr" closed="false">15:19 </char><char style="ft" closed="false">मसी माय किरेल आपणी आसा फोक्‍तो न्याह रेन जीवाय ने केरता वोर हे, केदी ताह रेन होवटोह निहे एय ते; नाहते केदी ज्या जीवणा माय तान आहने फोक्‍तो मसी माय किरेल एय ते। </char></note>केदी आपु ज्या जीवणा माय ओलास मसी पोर आसा केरतेह, ते आपु सोब माणहाह रेन वादार दुखी माणहे हेते।<verse eid="1CO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20" />पुण खेरीच मसी मुरेल माय रेन जीव उठेल हे, एने जा मोर जायेल हेते ता बी जीव उठती ज्यो वातीन पुरावो हे। <verse eid="1CO 15:20" /><verse number="21" style="v" sid="1CO 15:21" />काहाकाय जुलबुखे एक माणहान उगे रेन मोत आवी, ते एक माणहास ने उगे रेन मुरेलान पोशो जीव उठणो बी आवो। <verse eid="1CO 15:21" /><verse number="22" style="v" sid="1CO 15:22" />जेवी आदम सोबा पोर मोत लायेल, तिहेस मसी जा ता पोर बुरहो केरतेह ता आखाह जीवाय आपी। <verse eid="1CO 15:22" /><verse number="23" style="v" sid="1CO 15:23" />पेल मसी जीव उठेल मोती माय रेन एने जेवी तान पोशो आवणेन दिह तान माणहे जीव उठती। <verse eid="1CO 15:23" /><verse number="24" style="v" sid="1CO 15:24" />ज्यान पासाण सेवेट एय। तुलबूखे तो आखा राज केरनाराह खाराब जीवाह, एने आखा आदिकाराह, एने मसी आखी ताकेत खेतेम केरीन राज बोगवान आबाख ने आथा माय होप देय। <verse eid="1CO 15:24" /><verse number="25" style="v" sid="1CO 15:25" />काहाकाय मसी ताह वोर राज केरी जाहाक वोर तान दुसमोनाह तान पायान तेलसा बुंदे नाय लियावी। <verse eid="1CO 15:25" /><verse number="26" style="v" sid="1CO 15:26" />आखाम रेन आखरी दुसमोन जो खेतेम केराय जाय, तो मोत हे। <verse eid="1CO 15:26" /><verse number="27" style="v" sid="1CO 15:27" />काहाकाय देरेम पुस्तेक किथे, “बोगवान आखो काय मसीन पायान तेलसा बुंदे केर दियेल हे,” पुण जुलबुखे तो किथे, आखो काय तान ताबाम केर दियेल हे तो ओंगाण हे, पुण बोगवान सोता आंगे रियेल। <verse eid="1CO 15:27" /><verse number="28" style="v" sid="1CO 15:28" />एने जुलबुखे आखो काय तान उगे एय जाय, ते बिटोख सोता बी तान ताबाम एय जाय, जो आखो काय तान ताबाम केर दियेल, काहाकाय आखा माय बोगवानुस सोब वोस्तु एने सोब वातु पोर पुरी रिती माय राज केरी।<verse eid="1CO 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29" />नाहते जा माणहे मुरेलान केरता बपतीस्मा लेतेह, ता काय केरती? केदी मुरेल जीव उठतेच नाह ते ओवता काहा तान केरता बपतीस्मा लेतेह? <verse eid="1CO 15:29" /><verse number="30" style="v" sid="1CO 15:30" />एने आपु बी काहा जाहार ताहार तेकलीत माय पोड़ रेतेह? <verse eid="1CO 15:30" /><verse number="31" style="v" sid="1CO 15:31" />एय बाय बोणहा, माहु ती मोठाय जी आपणा मसी यीशु माय मी तुमरा बारामाय केरथु, मी दाड़ीन दिह मोरथु। <verse eid="1CO 15:31" /><verse number="32" style="v" sid="1CO 15:32" />मी इफिसुस गावा माय जेंगली जेनवेरान गेत माणहे एता ता हिऱ्यो लेड़ाय किरेल, ते माहु काय फायदो ईनो? केदी मुरेल जीवता नाय एय, ते आवो आपु खाता पिता काहाकाय काल ते मोरीस जाहु। <verse eid="1CO 15:32" /><verse number="33" style="v" sid="1CO 15:33" />ठेगाहो मा, “खाराब हेंगात हाजाला सोबावाह बिगाड़ दिथे।” <verse eid="1CO 15:33" /><verse number="34" style="v" sid="1CO 15:34" />हाजो विचार केरने चालु किरो एने पाप केरने सोड़ दिवो, काहाकाय थोड़ाक ओहला हेते जा बोगवानाह नाह जाणते, मी तुमूह लाजवाड़नेन केरता ज्यो केथु।<verse eid="1CO 15:34" /></para>
  <para style="s">पोशा जीव उठणारान सेरीरे</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35" />एवी एगदो ज्यो केय, “मुरेल किहीक जीव उठतेह, एने कोहलाक सेरीरा हेऱ्या आवतेह?” <verse eid="1CO 15:35" /><verse number="36" style="v" sid="1CO 15:36" />एय बिगेर एकलीवाला जो काय तु पिरीह, जाह वोर तो नाह मुरीत ताहाक वोर जीवतालो नाह एणे। <verse eid="1CO 15:36" /><verse number="37" style="v" sid="1CO 15:37" />एने जो तु पिरीह, ज्यो तो रोप नाह सोतो जो उगणार हे, पुण निस्तो दाणो हे गोवान नाहते उंजु कायतान बी दाणा एय। <verse eid="1CO 15:37" /><verse number="38" style="v" sid="1CO 15:38" />पुण बोगवान तान आसान उगे रेन ताह सेरीर आपणे, एने एकेक बिजाह तान खाज सेरीर। <verse eid="1CO 15:38" /><verse number="39" style="v" sid="1CO 15:39" />सोब सेरीर एक हारको नाह सोतो: माणहान सेरीर आलेग हे, जेनवेरान सेरीर आलेग हे; चीड़ान सेरीर आलेग हे; मासान सेरीर आलेग हे। <verse eid="1CO 15:39" /><verse number="40" style="v" sid="1CO 15:40" />हेरगान सेरीर हे एने देरतीन सेरीर बी हे, पुण हेरगान सेरीर ने चोमेक आलेग हे, एने देरतीन आलेग। <verse eid="1CO 15:40" /><verse number="41" style="v" sid="1CO 15:41" />दिह्यान चोमेक आलेग हे, चांदान चोमेक आलेग हे, एने चांदण्यान चोमेक आलेग हे, काहाकाय एक चांदण्याह रेन दिहरा चांदण्या वोर चोमेक माय गालो हे।<verse eid="1CO 15:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42" />मुरेलान जीव उठणो बी ओहलोस हे, सेरीर खेतेम एणेन हाल माय पेराणे एने खेतेम नाय एय ओहला वेहा माय जीव उठीह। <verse eid="1CO 15:42" /><verse number="43" style="v" sid="1CO 15:43" />तो बिगेर मान पान हेऱ्यो बुजाय जाथे, एने चोमेक हेऱ्यो जीव उठणे; कोमजोरी हेऱ्यो बुजाय जाथे एने ताकेती हेऱ्यो जीव उठणे। <verse eid="1CO 15:43" /><verse number="44" style="v" sid="1CO 15:44" />सारिरीक सेरीर बुजाय जाथे, एने आत्मिक सेरीर जीव उठणे। ते सारिरीक सेरीर बी हे, एने आत्मिक सेरीर बी हे। <verse eid="1CO 15:44" /><verse number="45" style="v" sid="1CO 15:45" />ओहलोस लिखेल बी हे, “पेल्लो माणुह आदम ताह जीवतालो जेनवार बोणायेल, एने सिवल्यो आदम जीवाय आपणार जीव हे।” <verse eid="1CO 15:45" /><verse number="46" style="v" sid="1CO 15:46" />पुण पेल आत्मिक नाह पुण सारिरीक सेरीर ईतो, ज्यान पासाण आत्मिक ईनो। <verse eid="1CO 15:46" /><verse number="47" style="v" sid="1CO 15:47" />पिल्लो माणुह आदम माटड्यान एतो, दिहरो हेरगान हे। <verse eid="1CO 15:47" /><verse number="48" style="v" sid="1CO 15:48" />जोहलो तो माटड्यान एतो, तोहलास ता बी हेते जा माटड्यान हेते, एने जोहलो तु हेरगान हे तोहलास ता बी हेते जा हेरगान हेते। <verse eid="1CO 15:48" /><verse number="49" style="v" sid="1CO 15:49" /><note caller="+" style="f"><char style="fr" closed="false">15:49 </char><char style="ft" closed="false">आमु पेरहु; थोड़ाक लेख माय पेरहु लिखेल हे।</char></note>एने जीहे आपु तान सेरीर लियेल जो माटड्यान एतो, तिहेस केरीन ता आपु हेरगान सेरीर बी लेहु।<verse eid="1CO 15:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50" />एय बाय बोणहा, मी ज्यो केथु, माह एने लुय बोगवानान राज माय हिस्सेदार नाह बोण सेकते, एने खेतेम एणाराह विण खेतेमान ईसो नाय जुड़ सिकेह। <verse eid="1CO 15:50" /><verse number="51" style="v" sid="1CO 15:51" /><note caller="+" style="x"><char style="xo" closed="false">15:51 </char><char style="xt" closed="false"><ref loc="1TH 4:15-17">1 थिस्सलुनिक्यो 4:15-17</ref></char></note>मी तुमूह मालमात ने वात केथु, आपु आखा नाय मोरहु, पुण आखा बोदली जाहु, एने ज्यो एकुस ताल माय पापण्या पाड़तास सेवली पावली फुकतास एय। <verse eid="1CO 15:51" /><verse number="52" style="v" sid="1CO 15:52" />काहाकाय पावली फुकाय जाय एने मुरेल सेरीर बिगेर खेतेम एण्यी हाल माय उठ जाती, एने आपु बोदेल जाहो। <verse eid="1CO 15:52" /><verse number="53" style="v" sid="1CO 15:53" />काहाकाय जोरवरी हे, ज्यो खेतेम एण्यो सेरीर बिगेर खेतेम एण्याह पेरलेय, एने ज्यो मोरनार सेरीर बिगेर मोरनाराह पेरलेय। <verse eid="1CO 15:53" /><verse number="54" style="v" sid="1CO 15:54" />एने जुलबुखे ज्यो खेतेम एण्यो बिगेर खेतेम एण्याह पेरलेय, एने ज्यो मोरनार बिगेर मोरनाराह पेरलेय, तुलबूखे तो वचन जो लिखेल हे, पुरो एय जाय: “मोत खेतेम एय गियी, एने जीत जुड़नी!”<verse eid="1CO 15:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="1CO 15:55" />एय मोत, तारी जिक का रेनी?</para>
  <para style="p" vid="1CO 15:55">एय मोत, तारो टोचणो का रेनो? <verse eid="1CO 15:55" /><verse number="56" style="v" sid="1CO 15:56" />मोत ने टोचणो पाप हे, एने पापान ताकेत मुसान कायदो हे। <verse eid="1CO 15:56" /><verse number="57" style="v" sid="1CO 15:57" />पुण बोगवानान दन्यवाद एय जो आपणा मालीक यीशु मसीन द्‍वारे आपुह जिकाड़ीह। <verse eid="1CO 15:57" /><verse number="58" style="v" sid="1CO 15:58" />तानकेरता एय मार मोंगाल्ला बाय बोणहा, मोजबुत एने वातड़ा रिवो, एने मालीकान कामा माय कायेम वोड़ते जावो, काहाकाय ज्यो जाणतेह काय तुमरी मेहनेत मालीक माय उदेड़ नाह सोती।<verse eid="1CO 15:58" /></para>
  <chapter eid="1CO 15" />
  <chapter number="16" style="c" sid="1CO 16" />
  <para style="s">बोरहावाला माणहान केरता फालो</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16:1 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 15:25">रोमीयो 15:25</ref>,<ref loc="ROM 15:26">26</ref></char>
    </note>एवी ता फालान बारामाय जा बोगवानान माणहे यरूशलेम माय हेते तान केरता टुलो केरने जुवे, जोहलो उकुम मी गलातीयान गावाम वाली मोंडल्यीह आपेल तिहेस तुमू बी किरो। <verse eid="1CO 16:1" /><verse number="2" style="v" sid="1CO 16:2" />एप्तान पेल्ले दिह तुमरा माय रेन एकेक जाण तुमरी मोंजरीन गेत थोड़ोक तुमूस फाय मेल्या किरो काय माहु आवणे बुखेत फालो नाय केरने पोड़ी। <verse eid="1CO 16:2" /><verse number="3" style="v" sid="1CO 16:3" />एने जुलबुखे मी आवुह, तुलबूखे जाह तुमू होदतेह ताह मी चिट्ठी आपीन मोकली देह काय तुमरो दान यरूशलेम पोचाड़ देय। <verse eid="1CO 16:3" /><verse number="4" style="v" sid="1CO 16:4" />केदी मारो बी जाणो हाजो एनो ताहार ता मार हेऱ्या जाती।<verse eid="1CO 16:4" /></para>
  <para style="s">पौलुसान यात्रान कार्यक्रम</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16:5 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:21">प्रेरितान काम 19:21</ref>
      </char>
    </note>मी मकादुनियाम रेन तुमू फाय आवुह, काहाकाय माहु मकादुनियाम रेन जाणुस हे। <verse eid="1CO 16:5" /><verse number="6" style="v" sid="1CO 16:6" />पुण एय सिकेह काय तुमरे न्यास थोब जाव, एने हियालो तुमरे न्यास काडु तेवी जी उगे मारो जाणो एय तीस उगे तुमू माहु वाटी लागाड़ दिज्यो। <verse eid="1CO 16:6" /><verse number="7" style="v" sid="1CO 16:7" />काहाकाय मी एवी थोड़ीक वार ने केरता तुमूह मीलाणे नाह होद्थु, पुण माहो आसा हे, काय केदी मालीकान मोरजी एय ते थोड़ीक वार वोर तुमू हिऱ्यो रेह।<verse eid="1CO 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 16:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16:8 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:8-10">प्रेरितान काम 19:8-10</ref>
      </char>
    </note>पुण मी पिन्तेकुस्त वोर इफिसुस माय रेह, <verse eid="1CO 16:8" /><verse number="9" style="v" sid="1CO 16:9" />मार केरता ता एक मोटलो एने कामान बायणो उगेड़ रेनोह, एने विरोदी जुलूम हेते।<verse eid="1CO 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16:10 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 4:17">1 कुरिंथीयो 4:17</ref>
      </char>
    </note>केदी तीमुथीयुस आव जाय, ताहार दिखज्यो काय तो तुमरी न्या मान सम्मान माय रेय; काहाकाय तो मार गेत मालीकान काम केरने। <verse eid="1CO 16:10" /><verse number="11" style="v" sid="1CO 16:11" />तानकेरता कुण बी ताह बाक्तु मा सुमेजहो, पुण ताह हुकेह जी उगे पोचाड़ दिज्यो, काय तो माह फाय आव जाय; काहाकाय मी तान वाट जोवणे बाजरिनोह, काय तो बाय बोणहा हिऱ्यो आवी। <verse eid="1CO 16:11" /><verse number="12" style="v" sid="1CO 16:12" /><note caller="+" style="f"><char style="fr" closed="false">16:12 </char><char style="ft" closed="false">तान सेंका; नाहते ज्यी बोगवानान बिलकुर मोरजी नाह सोती। </char></note>बायाख अपुल्लोसाह मी जुलूम विन्ता किरेल हे, काय तुमू फाय बोणहा हिऱ्यो जाय, पुण तो उलबुखे जाणेन काईच आसा नाह किऱ्यो, पुण जुलबुखे टेम जुड़ी तुलबूखे आव जाय।<verse eid="1CO 16:12" /></para>
  <para style="s">सिवल्यो उकुम एने नमस्‍कार</para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13" />जाकता रिवो, बोरहा माय टिकीन रिवो, बाहदुर बुणो, एने ताकेतवाला ईवो। <verse eid="1CO 16:13" /><verse number="14" style="v" sid="1CO 16:14" />जो काय केरतेह मोंग माय किरो।<verse eid="1CO 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16:15 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 1:16">1 कुरिंथीयो 1:16</ref>
      </char>
    </note>एय बाय बोणहा, तुमू स्तिफनुसान गेराणाह जाणतेह काय ता आखायान पेल्ला विश्वासी हेते, एने बोगवानान माणहान सेवा केरनेन केरता तियार रेतेह। <verse eid="1CO 16:15" /><verse number="16" style="v" sid="1CO 16:16" />केरीन मी तुमूह विन्ता केरथु, काय ओहलान ताबा माय रिवो, जा एकेकान ज्या कामा माय मेहनेत एने मोदेक केरनारे हेते।<verse eid="1CO 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 16:17" />स्तिफनुस, फुरतूनातुस एने अखइकुस न्या आवाह केरीन मी खुस हे, काहाकाय ता तुमरी कोमीह पुरी किरेल हेते। <verse eid="1CO 16:17" /><verse number="18" style="v" sid="1CO 16:18" />ता माहु एने तुमूह हुक आपेल हेते, केरीन ओहलाह मानु।<verse eid="1CO 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16:19 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:2">प्रेरितान काम 18:2</ref>
      </char>
    </note>आसीयान मोंडलीन उगे रेन तुमूह नमस्‍कार; अक्विला एने प्रिस्‍का एने तान गेरान मोंडली बी तुमूह मालीक माय जुलूम जुलूम नमस्‍कार। <verse eid="1CO 16:19" /><verse number="20" style="v" sid="1CO 16:20" />आखा बोगवानान बाय बोणहा तुमूह नमस्‍कार। मसीन मोंग माय गीले मिलीन एका दिहराह नमस्‍कार किरो।<verse eid="1CO 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 16:21" />मी पौलुस मार आथा केरीन चिट्ठी लिखेल नमस्‍कार केरथु।<verse eid="1CO 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 16:22" />केदी एगदो मालीकाह मोंग निहे केरतेय, ते ता पोर हाय, एय आमरा मालीक आव।<verse eid="1CO 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 16:23" />मालीक यीशुन गीण तुमू पोर एती रेय।<verse eid="1CO 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 16:24" />मारो मोंग मसी यीशु माय तुमू सोबा हिऱ्यो रेय। आमेन।<verse eid="1CO 16:24" /></para>
  <chapter eid="1CO 16" />
</usx>