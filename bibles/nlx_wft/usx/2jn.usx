<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Nahali</book>
  <para style="h">2 योहान</para>
  <para style="toc3">2 योहान</para>
  <para style="toc2">2 योहान</para>
  <para style="toc1">योहान लिखेल दुसरो पोत्रो</para>
  <para style="mt2">युहन्ना ने लिखा हुआ दुसरा पत्र</para>
  <para style="mt1">योहान लिखेल दुसरो पोत्रो</para>
  <para style="imt">ओलखात</para>
  <para style="ip">दुसरा योहान ने पोत्र प्रेरित योहान द्‍वारे मसीन जेल्मान 50-100 वोरह्यान विचीम लेखाय जायेल ईतो। योहान सोताह लेखणारान रूप माय केत नाह, पुण सोताह तो डावालो किथे। योहानान गेत हाजाली खोबरीन जोड़ायेल सोवलतीन बाराबोरी माय दुसरो योहानान सोवलोत मिलतो जुलतो हे। ज्यो खास केरीन साप किरेह काय जिहकेरीन तो एका दिहराह मोंग केरनेन केरता यीशुन उकुम पोर जोर दिथे जिहकेरीन तो आपणा उकुमान पालेन केरीन यीशुह मोंग किरेह। <char style="xt"><ref loc="2JN 1:5-6">1:5-6</ref></char> <char style="xt"><ref loc="JHN 15:9-10">योहान 15:9-10</ref></char> इहकेरीन मानाय जाथे काय योहान, योहानान हाजाली खुबेर एने 1 योहान, 2 योहान, 3 योहान ने पोत्री जेवी तो इफिसीयो माय रेते लेन लिखेल हे।</para>
  <para style="ip">योहान ज्यी पोत्रीह निवाड़ेल बायकुह एने तीन सोराह किथे। तो नाहते एक मोंडलीन बाराम केणे बाजरियेल ईतो। ज्यी पोत्रीह लेखणेन योहानान केणो मोंडलीह खुस केरने एने जुठा मास्तेर्‍याह चेतावणी आपणे एतो।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. योहान ज्यो केयीन पोत्र सुरवात किरेह काय ज्यो कुणीन केरता हे एने सापड़ावेह ताह नमस्‍कार केरने। <char style="ior"><ref loc="2JN 1:1-3">1:1-3</ref></char></para>
  <para style="io1">2. ओवतो तो मोंडलीह खुस किरेह एने ताह मोटलो उकुम एर केरावेह। <char style="ior"><ref loc="2JN 1:4-6">1:4-6</ref></char></para>
  <para style="io1">3. जुठा मास्तेर्‍याह चेतावणी आपणे। <char style="ior"><ref loc="2JN 1:7-11">1:7-11</ref></char></para>
  <para style="io1">4. योहान मोंडलीन बुरहो केरनाराह नाव लावणेन खुबेर आपेल तान पोत्री पुरी किरेह जा तो रेतालो। <char style="ior"><ref loc="2JN 1:12-13">1:12-13</ref></char></para>
  <chapter number="1" style="c" sid="2JN 1" />
  <para style="s">नमस्‍कार</para>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1" />मी योहान डायलान उगे रेन</para>
  <para style="p" vid="2JN 1:1">ती निवाड़ेल बायकु एने तीन सोरान नाव, जाह मी खेरलो मोंग केरथु, एने मी ओलोस नाह पुण ता आखा बी मोंग केरतेह जा खेरलाह जाणतेह,<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">बायकु एने तीन सोरा; शायद एक मोंडली एने तान मेहमोर ने ज्यो संदर्ब एय सिकेह (वचन 4-5 देखी।)</char></note> <verse eid="2JN 1:1" /><verse number="2" style="v" sid="2JN 1:2" />काहाकाय ती खेरायीन वोजेसे जी आपु माय बोणीन रीथे, तो कायेम आपणी हेऱ्यी रेय;<verse eid="2JN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3" />तास ने केरता बोगवान आबाख ने सोरो यीशु मसीन उगे रेन किव एने गीण एने सान्ती, खेराय एने मोंगा हेऱ्यो आपणी हेऱ्यो रेय।<verse eid="2JN 1:3" /></para>
  <para style="s">खेरलो एने मोंग</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4" />आपुह आबाख फाय रेन उकुम जुड़ेल तान गेत, तार सोरा माय रेन थोड़ाक खेरायी माय चालताला माहु सापड़ेल हेते, ज्याकेरीन माहु जुलूम खुसी जुड़नीह। <verse eid="2JN 1:4" /><verse number="5" style="v" sid="2JN 1:5" /><note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="JHN 13:34">योहान 13:34</ref>; <ref loc="JHN 15:12">15:12</ref>,<ref loc="JHN 15:17">17</ref></char></note>एवी एय बाय, मी तुवाह नोवाली उकुम नाह, पुण जी आपुह सुरवाती रेन आपेल हे, ती लेखीन तुवाह विन्ता केरथु काय आपु एका दिहराह मोंग केरी। <verse eid="2JN 1:5" /><verse number="6" style="v" sid="2JN 1:6" />तो मोंग ज्यो हे काय आपु तान उकुमान गेत चाली। ज्यो तोच उकुम हे जो तुमू सुरवाती माय रेन होमलेल हेते, एने तुमूह ज्यास ने गेत चालने बी जुवे।<verse eid="2JN 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7" />काहाकाय जुलूम होवटा बोटकावणारे माणहे दुनिया माय निकेल आयेल हेते, ता ज्यो मानते नाह काय यीशु मसी सेरीर माय एन आयेल; बोटकावणारे एने मसी विरोदी ज्यास हेते। <verse eid="2JN 1:7" /><verse number="8" style="v" sid="2JN 1:8" />जो काम आमु किरेल हेते ताह तुमू फालतुक जाणे मा दिवो, पुण तान पुरो फोल जुड़ने जुवे केरीन जोगवीन रिवो।<note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="ft" closed="false">आमु; थोड़ाक लेख माय तुमू लिखेल हे।</char></note><verse eid="2JN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2JN 1:9" />जो कुण बी मसीन हिकवोण माय बोणीन नाह रेत, एने ओंगाण ओंगाण जाथे ता फाय बोगवान नाह सोतो; एने जो कुण तान हिकवोण माय बोणीन रीथे, ता फाय आबोख एने बिटोख बी हे। <verse eid="2JN 1:9" /><verse number="10" style="v" sid="2JN 1:10" />केदी एगदो तुमरी फाय आवी, एने ज्यी हिकवोण नाय आपी, ताहार ताह गेरा माय आवणे मा दिहो, “तुमूह सान्ती जुड़ी,” एने कोहलाक हेते, केरीन तो बी मा फुसहो। <verse eid="2JN 1:10" /><verse number="11" style="v" sid="2JN 1:11" />काहाकाय जो कुण ओहला माणहान नमस्‍कार किरेह, ताहार तो तान खाराब कामा माय बेलाथे।<verse eid="2JN 1:11" /></para>
  <para style="s">सेवल्यो नमस्‍कार</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12" />माहु मोकत्युस वातु तुमूह लेखणु हे, पुण कागेद एने साई केरीन लेखणे नाह होदित, पुण आसा हे काय मी तुमू फाय आवुह एने आमने सामने वातु केरहु, ज्यो केरने से आपणी खुसी पुरी एय।<verse eid="2JN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13" />
    <note caller="+" style="f">
      <char style="fr" closed="false">1:13 </char>
      <char style="ft" closed="false">तुमरी मोंगाल्ली बोणीख ने सोरा; शायद लेखणारान मोंडलीन मेहमोर ने ज्यो संदर्ब एय सिकेह।</char>
    </note> तार निवाड़ेल बोणीख ने सोरा तुवाह नमस्‍कार केरतेह।<verse eid="2JN 1:13" /></para>
  <chapter eid="2JN 1" />
</usx>