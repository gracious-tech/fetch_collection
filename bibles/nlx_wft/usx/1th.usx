<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TH" style="id">- Nahali</book>
  <para style="h">1 थिस्सलुनिक्यो</para>
  <para style="toc3">1 थिस्सलुनिक्यो</para>
  <para style="toc2">1 थिस्सलुनिक्यो</para>
  <para style="toc1">थिस्सलुनिक्यो पौलुस लिखेल पेल्लो पोत्रो</para>
  <para style="mt2">थिस्सलुनिक्यो पौलुस ने लिखा हुआ पहला पत्र</para>
  <para style="mt1">थिस्सलुनिक्यो पौलुस लिखेल पेल्लो पोत्रो</para>
  <para style="imt">ओलखात</para>
  <para style="ip">थिस्सलुनिक्योन ज्यो पेल्लो पोत्र पौलुस लिखेल ईतो <char style="xt"><ref loc="1TH 1:1">1:1</ref></char> एने ज्यो देरेम पुस्तेकीन पेल्लो ईसो बोणनो, मसीन जेल्मान 51 सालान पासाण लेखायेल हे। एने जेवी पौलुस लिखेल ईतो तेवी तो कुरिंथीयोन हेयरा माय ईतो, थिस्सलुनिक्योन मोंडलीह ज्यो पोत्र लिखेल हे। <char style="xt"><ref loc="ACT 17:1-10">प्रेरितान काम 17:1-10</ref></char> तो दुसरी वार सेवा माय जाणेन टेम माय स्थापना किऱ्यो इही केवाय जायेल हे काय ज्यी मोंडली यहुदि एने बिगेर यहुदि माणहान बुणेल एती।</para>
  <para style="ip">थिस्सलुनिक्योन मोंडलीन केरीन पासाण पौलुस थिस्सलुनिक्यो माय जादा दिह वोर नाह रेय सीकनो, तान केरता ज्यो पोत्र ताह वाचीन ईमोत आपणेन केरता ज्यी पोत्री माय जुलूम वातीन चेरचा ईयेल हे जीहे काय मसी माय कोहलो जीवणो रेणे जुवे। पौलुस मसीन पोशो आवणेन बाराम लिखेह। आंदास तानकेरता थिस्सलुनिक्यो मोंडली वाला उखलीन वाचीह ज्या बाराम होमेलनेन मोरजी एती पौलुस ज्या बाराम माय मतलब यीशुन दिहरी वारीन आवणेन बाराम लेखीन ताह ओहलो जीवणो जीवणेन केरता ईमोत आपेह ज्या माय बोगवान खुस रीथे। <char style="xt"><ref loc="1TH 5:6-8">5:6-8</ref></char></para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. मोंडलीह नमस्‍कार एने बोगवानान दन्यवाद। <char style="ior"><ref loc="1TH 1:1-10">1:1-10</ref></char></para>
  <para style="io1">2. पौलुस तान सेवान बाराम एने तीमोथी जो खुबेर लायेल ईतो तान बाराम चेरचा किरेह। <char style="ior"><ref loc="1TH 2-3">2–3</ref></char></para>
  <para style="io1">3. यीशुन दिहरी वारीन आवणेन तियारी केरनेन केरता मसी माय किहीक जीवणे जुवे। <char style="ior"><ref loc="1TH 4:1-5:15">4:1–5:15</ref></char></para>
  <para style="io1">4. पौलुसान मोंडलीह नमस्‍कार तीन मोंडलीन आखा ज्यी पोत्रीह वाचणे जुवे ज्या बाराम पौलुसान विन्ता। <char style="ior"><ref loc="1TH 5:16-28">5:16-28</ref></char></para>
  <chapter number="1" style="c" sid="1TH 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 17:1">प्रेरितान काम 17:1</ref>
      </char>
    </note>मी पौलुस सिलवानुस एने तीमुथीयुस हिऱ्यो ज्यो पोत्रो लेखथु, आमरा आबाख बोगवानान एने मालीक यीशु मसीन माणहाह थिस्सलुनिक्योन मोंडली माय हेते,</para>
  <para style="p" vid="1TH 1:1">तुमूह गीण एने सान्ती जुड़ती रेय।<verse eid="1TH 1:1" /></para>
  <para style="s">थिस्सलुनिक्योन माणहान जीवणो एने बुरहो</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2" />जेवी आमु आमरी विन्ता माय तुमूह इर केरतेह, तेवी कायेम बोगवानान दन्यवाद केरतेह। <verse eid="1TH 1:2" /><verse number="3" style="v" sid="1TH 1:3" />एने आपणा आबाख बोगवानान ओंगाण तुमरा बोरहा माय किरेल कामे, एने मोंग माय किरेल मेहनेत, एने आपणा मालीक यीशु मसी माय दिराम दिरेल आसाह जाहार ताहार इर केरतेह। <verse eid="1TH 1:3" /><verse number="4" style="v" sid="1TH 1:4" />एय आमरा बाय बोणहा, आमु जाणतेह काय बोगवान तुमूह मोंग किरेह एने तुमू तान एणेन केरता निवड़ायेल हेते। <verse eid="1TH 1:4" /><verse number="5" style="v" sid="1TH 1:5" />काहाकाय आमु आमरी हाजाली खुबेर तुमू फाय लावा सोबदान ओलीस नाह, पुण चोखाला जीवान ताकेत माय एने पुरा खेरायीन बोरहा माय तुमू फाय वोर पोचाड़ेल, तेवी आमु तुमू हेऱ्या किहीक वागेल ज्यो तुमूह मालुम हे। एने ज्यो तुमरीन केरता हाजो एतो। <verse eid="1TH 1:5" /><verse number="6" style="v" sid="1TH 1:6" /><note caller="+" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="ACT 17:5-9">प्रेरितान काम 17:5-9</ref></char></note>तुमू मोटला मुसीबत माय एता तीबी चोखाला जीवान खुसी माय वचनाह स्वीकार लेदा। आमरी एने मालीकान गेत चाल चालने बाज गीयाह। <verse eid="1TH 1:6" /><verse number="7" style="v" sid="1TH 1:7" />ओहलो केरने माय मकादुनिया एने आखायान हेयरान आखा बुरहो केरनारा माणहान केरता तुमू आदर्श बोण गीयाह। <verse eid="1TH 1:7" /><verse number="8" style="v" sid="1TH 1:8" />काहाकाय तुमरी न्या रेन मकादुनिया एने आखाया माय ओलोस मालीक ने वचन नाह होमलाय गीयो, पुण तुमरो बुरहो जो बोगवाना पोर हे, तान चेरचा आखी जागी ओहलो पोसरी गीयो काय आमुह ज्यान बारा माय कायच केणेन जोरवुत नाह सोतो। <verse eid="1TH 1:8" /><verse number="9" style="v" sid="1TH 1:9" />काहाकाय ता माणहे खुद आमरा बाराम केतेह काय जेवी आमु तुमू फाय आवा, तेवी आमरो स्वागत किहीक किरेल ता सोता गोवाह हेते। एने तुमू किहीक मुरती उगे रेन बोगवाना उगे फिरना, ताकाय जीवताला एने खेरला बोगवानान सेवा चाकरी केरी। <verse eid="1TH 1:9" /><verse number="10" style="v" sid="1TH 1:10" />एने तान बेटाख यीशु मसीह हेरगाम रेन आवणेन वाट जोवती रिवो, जाह तो मुरेल माय रेन जिवाड़ेल, जो आपुह बोगवानान आवणे वाला रागाह रेन वोचाड़ेह।<verse eid="1TH 1:10" /></para>
  <chapter eid="1TH 1" />
  <chapter number="2" style="c" sid="1TH 2" />
  <para style="s">थिस्सलुनिक्यो माय पौलुसान पारचारान काम</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1" />एय बाय बोणहा, तुमू खुद जाणतेह काय तुमू फाय आमरो आवणो वाये नाह एनो। <verse eid="1TH 2:1" /><verse number="2" style="v" sid="1TH 2:2" /><note caller="+" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="ACT 16:19-24">प्रेरितान काम 16:19-24</ref>; </char><char style="xt" closed="false"><ref loc="ACT 17:1-9">प्रेरितान काम 17:1-9</ref></char></note>पुण तुमू खुद जाणतेह काय थिस्सलुनिक्यो माय आवणेन पेल आमु फिलेपी हेयरा माय अपमान एने दुख विठेल। एने आमरो बोगवान आमुह ईमोत आपेल, काय आमु बोगवानान हाजाली खुबेर केठीण विरोद एन बी तुमूह होमलाड़ी। <verse eid="1TH 2:2" /><verse number="3" style="v" sid="1TH 2:3" />काहाकाय आमरो हिकवोण खाराब विचारा माय एने उशारी माय नाह एतो; <verse eid="1TH 2:3" /><verse number="4" style="v" sid="1TH 2:4" />पुण बोगवान आमुह लायकीन सोमजीन हाजाली खुबेर होपेल हे, एने आमु तिहेस केरीन केतेह, एने ज्या माय माणहाह नाह, पुण बोगवान जो आमरा मोनाह जाचेह, ताह खुस केरतेह। <verse eid="1TH 2:4" /><verse number="5" style="v" sid="1TH 2:5" />काहाकाय केदी बी तुमू हाजा हेते केरीन वातु केरनेन आमु नाह आवा, ज्यो तुमूह मालुम हे, एने पोयशान लोब ने केरता डोंगड़ा नाह केऱ्या, बोगवान गोवा हे; <verse eid="1TH 2:5" /><verse number="6" style="v" sid="1TH 2:6" />पुण आमु एगदा माणहा फाय रेन मान सम्मान नाह होदते, एने नाह तुमू फाय रेन होदते। <verse eid="1TH 2:6" /><verse number="7" style="v" sid="1TH 2:7" /><note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">तुमरी हेऱ्या एता तेवी आमु हास केरीन, आईख ने गेत; थोड़ाक लेख माय तुमरी हेऱ्या एता तेवी आमु सोरान गेत एता, आमु आईख ने गेत एता।</char></note>एने आमु मसीन प्रेरित एणेन नाते तुमू पोर वोजो टाक सेकताला, पुण जिहकेरीन आहख सोरान पालेन पोषण किरेह, तिहेस आमु तुमरी हेऱ्या हुवाला रेना। <verse eid="1TH 2:7" /><verse number="8" style="v" sid="1TH 2:8" />एने आमुह तुमरी कालजी एती केरीन बोगवानान हाजाली खुबेर होमलावणेन ओलीस नाह, पुण आमरा जीवणान द्‍वारे तुमूह पुरी ताकेत से मोदेक जुड़ी। काहाकाय तुमू जुलूम मोंगाल्ला एता।<verse eid="1TH 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 2:9" />काहाकाय एय बाय बोणहा, आमरी मेहनेत एने तेकलीत खेरीच तुमूह मालुम एय, काय तुमू माय रेन कुणी पोर बी आमरो वोजो नाय पोड़ने जुवे केरीन आमु रात ने दिह काम दुंदो केरीन बोगवानान हाजाली खोबरीन पारचार किरेल। <verse eid="1TH 2:9" /><verse number="10" style="v" sid="1TH 2:10" />तुमू ज्यान गोवा हेते एने बोगवान बी गोवा हे काय आमरो वेवार तुमरी विची माय चोखालो, खेरलो, एने निर्दोस एतो। <verse eid="1TH 2:10" /><verse number="11" style="v" sid="1TH 2:11" />तुमू जाणतेह काय आमु तुमरी हेऱ्या तिहेकेरीन वेवार केरतेह, जिहकेरीन आबोख तान सोरा हेऱ्यो वेवारो किरेह, एने तिहेस केरीन आमु बी तुमू माय रेन आखाह हिकाड़तेन। <verse eid="1TH 2:11" /><verse number="12" style="v" sid="1TH 2:12" />काय तुमूह उत्साहित केरीन एने दिलासो आपीन सोमजाड़तेह, एने विन्ता केरतेह काय जो तुमूह बोगवानान बोड़ाय एने तान राज माय बाग लेणेन केरता हादिल हे। ताह होबे ओहलो तुमू जीवो।<verse eid="1TH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13" />तान केरता आमु बोगवानान दन्यवाद जेलेम केरतेह काय जेवी आमरी द्‍वारे बोगवानान हाजाली खोबरीन वचन तुमरी फाय पोचनो, ते तुमू ताह माणहान नाह पुण बोगवानान वचन सोमजीन स्वीकार किरेल, एने खेरीच ज्यो ओहलोस हे। तुमू जा विश्वासी हेते बोगवान काम किरेह। <verse eid="1TH 2:13" /><verse number="14" style="v" sid="1TH 2:14" /><note caller="+" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="ACT 17:5">प्रेरितान काम 17:5</ref></char></note>एय बाय बोणहा, जी वातु यहुदिया देसाम यीशु मसी माय बोगवानान त्यु मोंडल्यु हेऱ्यो एन्युह, त्युच वातु तुमू हेऱ्यु एणे बाजरेन्युह, जिहकेरीन यहुदि माणहान आथा केरीन जो सेताव वेठतेह, तिहेस केरीन तुमू बी तुमरा माणहान आथा केरीन सेताव वेठतेह। <verse eid="1TH 2:14" /><verse number="15" style="v" sid="1TH 2:15" /><note caller="+" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="ACT 9:23">प्रेरितान काम 9:23</ref>,<ref loc="ACT 9:29">29</ref>; <ref loc="ACT 13:45">13:45</ref>,<ref loc="ACT 13:50">50</ref>; <ref loc="ACT 14:2">14:2</ref>,<ref loc="ACT 14:5">5</ref>,<ref loc="ACT 14:19">19</ref>; <ref loc="ACT 17:5">17:5</ref>,<ref loc="ACT 17:13">13</ref>; <ref loc="ACT 18:12">18:12</ref></char></note>ता यहुदि मालीक यीशुह एने जाणकाराह मार दियेल, एने आमुह सेतावीन बाहेर काड़ दियेल। एने ता बोगवानाह नाराज केरतेह, एने आखा माणहान विरोद केरतेह। <verse eid="1TH 2:15" /><verse number="16" style="v" sid="1TH 2:16" />एने ता बिगेर यहुदि माणहाह बोगवानान खुबेर होमलाड़नेन केरता आमुह रोकतेह, जो सुटकारो लाव सिकेह। काय जेलेम तान पापान माप बोराती रेय; पुण ता पोर बोगवानान राग आव लागेल हे।<verse eid="1TH 2:16" /></para>
  <para style="s">पौलुस थिस्सलुनिक्यो पोशो मिलनेन आसा केरने</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17" />एय बाय बोणहा, आमु मोनाम नाह पुण सेरीर माय तुमू फाय रेन थोड़ीक वार ने केरता आंगे एय जायेल एता, आमु तुमूह जुलूम इर किरेल एने पोशो मिलनेन कोसीत केरतेह। <verse eid="1TH 2:17" /><verse number="18" style="v" sid="1TH 2:18" />आमु तुमू फाय एक रेन होवटी वार आवणेन केरता कोसीत किरेल एने खास केरीन मी पौलुस, पुण सैतान आमुह रोक मिल्योह। <verse eid="1TH 2:18" /><verse number="19" style="v" sid="1TH 2:19" />आमरी आसा, खुसी, एने बोड़ायीन मुकूट कुण हे? काय जेवी आमरो मालीक यीशु मसी आवी तेवी तान ओंगाण तुमूच हेते ने। <verse eid="1TH 2:19" /><verse number="20" style="v" sid="1TH 2:20" />काहाकाय आमरी बोड़ाय एने खुसी तुमूच हेते।<verse eid="1TH 2:20" /></para>
  <chapter eid="1TH 2" />
  <chapter number="3" style="c" sid="1TH 3" />
  <para style="s">तीमुथीयुसाह मोकेलनु</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 17:15">प्रेरितान काम 17:15</ref>
      </char>
    </note>तान केरता आमुह उंजु नाह रेवानो, ते आमु ज्यो ठेराया काय एथेंस हेयरा माय मी एखालोच रेय जाव। <verse eid="1TH 3:1" /><verse number="2" style="v" sid="1TH 3:2" />एने आमु तीमुथीयुसाह, जो मसीन हाजाली खुबेर माय आमरो बाहख एने बोगवानान सेवक हे, ज्यानकेरता मुकलेल काय तुमूह मोजबुत केरी एने तुमरा बोरहान बाराम सोमजाड़ी। <verse eid="1TH 3:2" /><verse number="3" style="v" sid="1TH 3:3" />काय तुमू माय रेन कुण बी ज्या तेकलीत ने कारीन गाबराय नाय, काहाकाय तुमू सोता जाणतेह काय ज्यी तेकलीत बोगवानान मोरजीन ईसो हे। <verse eid="1TH 3:3" /><verse number="4" style="v" sid="1TH 3:4" />काहाकाय आमु तुमरी हेऱ्या एता तेवी तुमूह केय मीलेल एता, काय आपुह तेकलीत उखेलने पोड़न्यो हे, एने ताच ने गेत ईयेल हे, ज्यो तुमूह मालुम हे। <verse eid="1TH 3:4" /><verse number="5" style="v" sid="1TH 3:5" />ज्यानकेरता माहु उंजु नाह रेवानो, पुण तुमरा बोरहान हाल चाल फुसणेन केरता ताह मुकलेल, काय सैतान तुमरी पारेख किरेल एय, एने आमरी मेहनेत वाये एय जाय।<verse eid="1TH 3:5" /></para>
  <para style="s">तीमुथीयुसान द्‍वारे खुबेर जुड़ने</para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:6 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:5">प्रेरितान काम 18:5</ref>
      </char>
    </note>पुण एवी तीमुथीयुस, जो तुमरी फाय रेन आमरी न्या आवुह, तुमरा बोरहान एने मोंग ने खुबेर होमलायो एने ज्यो बी केय होमलायो काय तुमू जेलेम मोंग हेऱ्या आमुह इर केरतेह, एने आमुह देखणेन आसा मेलतेह, जिहकेरीन आमु तुमूह देखणेन आसा केरतेह। <verse eid="1TH 3:6" /><verse number="7" style="v" sid="1TH 3:7" />ज्यानकेरता एय बाय बोणहा, आमु तुमरा आखा दुख माय एने तेकलीत माय तुमरा बोरहा पोर रेन आमुह उत्साह जुड़नो। <verse eid="1TH 3:7" /><verse number="8" style="v" sid="1TH 3:8" />काहाकाय एवी केदी तुमू मालीक माय मोजबुत रेतेह, ते आमरा जीवाम जीव आवी। <verse eid="1TH 3:8" /><verse number="9" style="v" sid="1TH 3:9" />एने जो खुसी आमुह तुमरे वोजेसे तान ओंगाण जुड़ेल हे, आमु बोगवानान दन्यवाद केरतेह। <verse eid="1TH 3:9" /><verse number="10" style="v" sid="1TH 3:10" />आमु रात ने दिह जुलूम विन्ता केरती रेतेह काय तुमरो मुय देखी, एने तुमरा बोरहान कोमीह पुरी केरी।<verse eid="1TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11" />बोगवान आपणो आबोख खुद, एने मालीक यीशु, आमुह तुमरी फाय आवणेन केरता वाट मोकलो केरी; <verse eid="1TH 3:11" /><verse number="12" style="v" sid="1TH 3:12" />एने मालीक मालीक माय आमरो मोंग तुमू पोर हे, तिहेस केरीन तुमरो मोंग एक दिहरा माय एने आखा माणहाम वोड़ी, एने वोड़ती जाय। <verse eid="1TH 3:12" /><verse number="13" style="v" sid="1TH 3:13" />एने तो आपणा मोनाह तियार केरी। ज्यानकेरता काय जेवी आपणो मालीक यीशु तान आखा चोखाला माणहा हिऱ्यो आवी, तेवी बोगवान आबाख ने ओंगाण चोखाला एने निर्दोस ठेराणे जुवे तान केरता मोजबुत केरी।<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">जो आखो काय तान हे, नाहते तान आखा हेरोगदुत </char></note><verse eid="1TH 3:13" /></para>
  <chapter eid="1TH 3" />
  <chapter number="4" style="c" sid="1TH 4" />
  <para style="s">बोगवानाह खुस केरी ओहलो जीवणो जीवणु</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1" />तान केरता एय बाय बोणहा, आमु तुमूह विन्ता केरतेह एने मालीक यीशु माय सोमजाड़तेह काय तुमूह कोहली चाल चालीन बोगवानाह खुस केरने जुवे, एने ज्यो तुमू आमु फाय रेन हिकेल हेते, एने तुमू ताज ने गेत वागतेह, एने ताज माय वोड़ती जावु। <verse eid="1TH 4:1" /><verse number="2" style="v" sid="1TH 4:2" />काहाकाय मालीक यीशुन आदिकार माय काल्ली काल्ली हिकवोण आमु तुमूह आपेल ज्यो तुमू जाणतेह। <verse eid="1TH 4:2" /><verse number="3" style="v" sid="1TH 4:3" />बोगवानान मोरजी ज्यी हे काय तुमू समर्पित एयीन पुरा चोखा बोणी: एने सिनालाह रेन वोचीन रिवो, <verse eid="1TH 4:3" /><verse number="4" style="v" sid="1TH 4:4" /><note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">तान बायकु हेऱ्यो रेह, नाहते तीन सेरीर पोर ताबो मेल।</char></note>एने तुमू माय रेन आखा एदमी ज्यो जाणने जुवे काय तुमू तुमरी बायकु हेऱ्यो चोखालाम एने मान हेऱ्या वेवार केरने जुवे। <verse eid="1TH 4:4" /><verse number="5" style="v" sid="1TH 4:5" />एने ज्यो काम बोगवानाह नाह जाणते ता माणहान गेत मोनान मोरजीम नाह। <verse eid="1TH 4:5" /><verse number="6" style="v" sid="1TH 4:6" />काय ज्यी वातु माय कुण बी मसी मायवाला बायाख ने फायदो नाय विसी एने नाय ठेगी, काहाकाय बोगवान ज्यी आखी वातुन बुदलो लिण्यो हे; जिहकेरीन आमु पेलुच तुमूह कियेल एने इर बी केरायेल एता। <verse eid="1TH 4:6" /><verse number="7" style="v" sid="1TH 4:7" />काहाकाय बोगवान आपुह एठा एणेन केरता नाह, पुण चोखाला एणेन केरता हादिल हे। <verse eid="1TH 4:7" /><verse number="8" style="v" sid="1TH 4:8" />तान केरता जो कुण ज्या हिकवोणाह नाह मानेत, तो माणहाह नाह पुण बोगवानाह नाह मानेत, जो तान चोखाला जीवाह तुमूह आपेह।<verse eid="1TH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9" />एने बाय बोणहान मोंगान बाराम आमु तुमूह लिखज्यु ज्यान गिरेज नाह सोती, काहाकाय एका दिहराह मोंग केरी, ओहलो बोगवानुच तुमूह हिकाड़ेल हे। <verse eid="1TH 4:9" /><verse number="10" style="v" sid="1TH 4:10" />एने आखा मकादुनियान मसी माय सोब बाय बोणहा हेऱ्यो मोंग केरतेह बी। पुण एय बाय बोणहा, आमु तुमूह सोमजाड़तेह काय उंजु बी वोड़ती जावु, <verse eid="1TH 4:10" /><verse number="11" style="v" sid="1TH 4:11" />एने आमु तुमूह जिहकेरीन उकुम आपेल हेते, तिहेस केरीन सान्ती माय जीवाय जीवो, एने जान तान काम काजा उगे द्यान दिवो, एने जान तान आथा केरीन कामावणेन कोसीत किरो। <verse eid="1TH 4:11" /><verse number="12" style="v" sid="1TH 4:12" />इहकेरीन केरने से तुमू आखा बिगेर यहुदि माणहान द्‍वारे तुमूह मान सम्मान जुड़ी, एने दिहरान बोरहे रेणेन जोरवुत नाय पोड़ी। केरीन तुमूह काल्ली बी वोस्तुन कोमी पोड़ने नाय जुवे।<verse eid="1TH 4:12" /></para>
  <para style="s">यीशुन पोशो आवणो</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13" />एय बाय बोणहा, जा माणहे मोर रेनाह तान बाराम तुमू एंजाणल्या रिहो ओहली आमरी मोरजी नाह सोती; ज्यानकेरता काय जाह आसा नाह सोती ओहला माणहान गेत दुख मा मोणावहो। <verse eid="1TH 4:13" /><verse number="14" style="v" sid="1TH 4:14" />काहाकाय यीशु मोर जायेल एने पुशो जीव उठेल उहलो तुमरो बुरहो एय, ते ताज ने गेत जा यीशु पोर बुरहो केरीन मोर जायेल हेते, ताह बोगवान यीशु हिऱ्यो लावी। <verse eid="1TH 4:14" /><verse number="15" style="v" sid="1TH 4:15" /><note caller="+" style="x"><char style="xo" closed="false">4:15 </char><char style="xt" closed="false"><ref loc="1CO 15:51">1 कुरिंथीयो 15:51</ref>,<ref loc="1CO 15:52">52</ref></char></note>जो मालीक हिकाड़ेल हे तोच तुमूह आमु केतेह, काय मालीकान आवणेन एय तुलबूखे वोर आपु जा जीवतालाच वोचीन रेहु, एने जा मसी पोर बुरहो केरीन मोर जायेल हेते ताह रेन ओंगाण आपु केदी बी जाहुच नाय। <verse eid="1TH 4:15" /><verse number="16" style="v" sid="1TH 4:16" />काहाकाय मालीक खुद हेरगाम रेन उतरी; तुलबूखे ललकार, एने मुखी हेरोगदुतान बोल होमलाय, एने बोगवानान पावली फुकाय जाय; एने जा मसी माय बुरहो केरीन मोर जायेल हेते, ता पेल जीव उठती। <verse eid="1TH 4:16" /><verse number="17" style="v" sid="1TH 4:17" />तेवी आपु जा जीवताला एने वोचेल हेते, ता हेऱ्या वादला पोर उखलीन जाहु काय वाहला माय मालीकाह मीले; एने तिहेस केरीन आपु कायेम मालीक हेऱ्या रेहु। <verse eid="1TH 4:17" /><verse number="18" style="v" sid="1TH 4:18" />केरीन ज्यी वातु माय एका दिहराह दिलासो आप्या किरो।<verse eid="1TH 4:18" /></para>
  <chapter eid="1TH 4" />
  <chapter number="5" style="c" sid="1TH 5" />
  <para style="s">यीशु पोशो आपणु हे केरीन तियार रेणु</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1" />एय बाय बोणहा, टेम एने कालान बाराम तुमूह लेखणेन कायच गिरेज नाह सोती। <verse eid="1TH 5:1" /><verse number="2" style="v" sid="1TH 5:2" /><note caller="+" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="MAT 24:43">मत्ती 24:43</ref>; <ref loc="LUK 12:39">लुका 12:39</ref>; <ref loc="2PE 3:10">2 पतरस 3:10</ref></char></note>काहाकाय तुमूह पाक्को मालुम हे काय जिहकेरीन राती चोर आवीह, तिहेस केरीन मालीकान दिह आवण्यो हे। <verse eid="1TH 5:2" /><verse number="3" style="v" sid="1TH 5:3" />जेवी माणहे केती, “सान्ती एने कायच बी बिय नाह सोती,” ते जिहकेरीन पेटावाली बायकु पोर उचकाहुच पिड़ा आव पुड़ीह, तिहेस केरीन ता पोर बी उचकाहुच पिड़ा आव पोड़ी, एने ता वोच नाय सेकती। <verse eid="1TH 5:3" /><verse number="4" style="v" sid="1TH 5:4" />पुण एय बाय बोणहा, तुमू ते आदारा माय नाह सोता काय तो दिह तुमू पोर चोर जीहे आवीह तिहेस आव पोड़ी। <verse eid="1TH 5:4" /><verse number="5" style="v" sid="1TH 5:5" />काहाकाय तुमू आखा उजालान सोरा एने दिह्यान सोरा हेते; नाह आपु रातीन हेते, एने नाह आदारान। <verse eid="1TH 5:5" /><verse number="6" style="v" sid="1TH 5:6" />तान केरता आपु दिहरान गेत हुवते नाह रेता, पुण जागती एने जोगवीन रेता। <verse eid="1TH 5:6" /><verse number="7" style="v" sid="1TH 5:7" />काहाकाय जा हुवतेह ता रातीच हुवतेह, एने जा पितेह ता रातीच पिन दुंदवाय रेतेह। <verse eid="1TH 5:7" /><verse number="8" style="v" sid="1TH 5:8" /><note caller="+" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="EPH 6:13-17">इफिसीयो 6:13-17</ref></char></note>पुण आपु जा दिह्यान हेते, बोरहान एने मोंगान कवच पेरीन एने सुटकारान आसान टुपो पेरीन जोगवीन रिवो। <verse eid="1TH 5:8" /><verse number="9" style="v" sid="1TH 5:9" />काहाकाय आपु पोर बोगवानान राग आवी केरीन नाह, पुण आपणा मालीक यीशु मसीन द्‍वारे आपणो सुटकारो एय, केरीन बोगवान आपुह निमेल हे। <verse eid="1TH 5:9" /><verse number="10" style="v" sid="1TH 5:10" />यीशु आपणे केरता मुरनो, ज्यानकेरता काय आपु जीवताला रेहु नाहते मोर जाहु, जेवी यीशु पोशो आवी तेवी आखा मिलीन ताच हेऱ्या जिवी। <verse eid="1TH 5:10" /><verse number="11" style="v" sid="1TH 5:11" />तान केरता एका दिहराह तुमू दिलासो आपु एने एका दिहरान वोड़तीन कारीन बुणो, एने जिहकेरीन तुमू केरतेह बी।<verse eid="1TH 5:11" /></para>
  <para style="s">सेवली हिकवोण</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12" />एय बाय बोणहा, आमु तुमूह विन्ता केरतेह काय जा तुमू माय मेहनेत केरतेह, एने मसी जीवणाम तुमरा अगुवा हेते, एने तुमूह हिकाड़तेह, तान तुमू मान सम्मान किरो। <verse eid="1TH 5:12" /><verse number="13" style="v" sid="1TH 5:13" />एने तान कामान कारीन मोंग जुलूम केरीन तान मान सम्मान आपु, एने एका दिहरा हेऱ्या ईलीमिलीन रिवो। <verse eid="1TH 5:13" /><verse number="14" style="v" sid="1TH 5:14" />एय बाय बोणहा, आमु तुमूह सोमजाड़तेह काय जा माणहे आलह्या हेते ताह सोमजाड़, एने बितऱ्याह ईमोत आपु, कोमजोराह होमालु, आखान सेहेन किरो। <verse eid="1TH 5:14" /><verse number="15" style="v" sid="1TH 5:15" />होमालीन! कुण बी एगदाह बुरायीन बोदले बुराय नाय केरी; एने कायेम एका दिहरान एने आखान हाजो केरती रिवो। <verse eid="1TH 5:15" /><verse number="16" style="v" sid="1TH 5:16" />कायेम खुसी माय रिवो। <verse eid="1TH 5:16" /><verse number="17" style="v" sid="1TH 5:17" />कायेम विन्ता माय लागीन रिवो। <verse eid="1TH 5:17" /><verse number="18" style="v" sid="1TH 5:18" />एने आखी वातु माय बोगवानान दन्यवाद किरो; काहाकाय यीशु मसी माय तुमरो जो जीवणो हे, बोगवानान मोरजी जीज हे। <verse eid="1TH 5:18" /><verse number="19" style="v" sid="1TH 5:19" />चोखाला जीवान आक्‍ठो मा उलवो। <verse eid="1TH 5:19" /><verse number="20" style="v" sid="1TH 5:20" />बोगवानान उगे रेन आवणेवाली खोबरीह खाराब मा जाणु। <verse eid="1TH 5:20" /><verse number="21" style="v" sid="1TH 5:21" />आखी वातुह पारखो; एने जी हाजी हे तीह देरीन रिवो। <verse eid="1TH 5:21" /><verse number="22" style="v" sid="1TH 5:22" />एने आखा बातीन बुरायीह रेन वोचीन रिवो।<verse eid="1TH 5:22" /></para>
  <para style="s">सेवल्यो बोरकेत</para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23" />सान्ती आपणार बोगवान खुद तुमूह पुरो चोखो केरी; एने तुमरो चोखालो जीव एने जीवाह एने सेरीराह आपणा मालीक मसी यीशुह आवणे वोर पुरी रिते से निर्दोस एने होमालीन मेली। <verse eid="1TH 5:23" /><verse number="24" style="v" sid="1TH 5:24" />तुमूह हादणार बोरहावालो हे, एने तो ओहलोस केरी। <verse eid="1TH 5:24" /><verse number="25" style="v" sid="1TH 5:25" />एय बाय बोणहा, आमरे केरता विन्ता किरो। <verse eid="1TH 5:25" /><verse number="26" style="v" sid="1TH 5:26" />आखा बाय बोणहा बोगवानान चोखाला मोंग माय नमस्‍कार किरो। <verse eid="1TH 5:26" /><verse number="27" style="v" sid="1TH 5:27" />मी तुमूह मालीकान आदिकार माय विन्ता केरथु काय ज्यो पोत्रो आखा विश्वासीन केरता वाचाय जाय। <verse eid="1TH 5:27" /><verse number="28" style="v" sid="1TH 5:28" />आपणा मालीक मसी यीशुन गीण तुमू पोर इती रेय।<verse eid="1TH 5:28" /></para>
  <chapter eid="1TH 5" />
</usx>