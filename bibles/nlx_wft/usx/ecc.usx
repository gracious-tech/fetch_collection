<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ECC" style="id">- Nahali</book>
  <para style="h">सबोपदेशक</para>
  <para style="toc3">सबोपदेशक</para>
  <para style="toc2">सबोपदेशक</para>
  <para style="toc1">सबोपदेशक</para>
  <para style="mt2">सभोपदेशक सुलेमान ने लिखी हुई किताब</para>
  <para style="mt1">सबोपदेशक सुलेमान लिखेल पुस्तेक</para>
  <para style="imt">ओलखात</para>
  <para style="ip">सबोपदेशक एक ओहली पुस्तेक हे, जी जीवायीन केरता ईकेल हिकाड़ेह। पुस्तेक ने केरता हिब्रु विषय ने मतलब हे “तो जो माणहाह टुलो किरेह।” जुलूम बुध्दीमान माणहान मान्नो हे काय सुलेमान राजा सबोपदेशकाह लेखणार इतो, पुण दिहरा माणहे ज्या से सहमत नाह सोता। केदी ज्यो सुलेमान इतो जो पुस्तेक लिखेल इतो, ते ज्य कोमीत कोमी 970-931 यीशुन पेल लेखायेल एतो। जो काय ती टेमान वात हे जेवी तो जीवतालो इतो। दिहरा बुध्दीमान माणहान मान्नो हे काय ज्याह दिहरो लिखेल इतो, काहाकाय मोकता वारीन ज्या माय राजान सावाय सेवकान बाषान वापेर केरायेल हे, <char style="xt"><ref loc="ECC 5:8-9">सबोपदेशक 5:8-9</ref></char> ता बुध्दीमानान मान्नो हे काय सबोपदेशक ने पुस्तेक सुलेमानान टेमाम रेन जुलूम बाद लेखायेल एतो, शायद 400 एने 200 यीशुन पेल ने विचीम।</para>
  <para style="ip">सबोपदेशक ज्य केन सुरवात केरतेह काय आखो एक हांह ने गेत हे जो उतवाल्योच आरताय जाथे <char style="xt"><ref loc="ECC 1:2">1:2</ref> </char>ज्यान मतलब हे काय आपणी जीवाय एने आपणो काम अस्थायी हे एने ज्याह सोमेजणे काठो हे। ज्यान जुलूम थोड़ाक टेमान बाद विहरी जाय। ज्यान जुलूम आपणे नियंत्रण से बाहेर हे। जीवणाह जोहलो हे तोहलोच स्वीकार केरनो एने जो तुमरी फाय हे ता माय खुस एणो हाजो हे। <char style="xt"><ref loc="ECC 9:9">9:9</ref></char> जीवायीन आख्यु केठणाय एने खुसी पोर विचार केरते लेन, पुस्तेक ने निष्कर्ष बोगवानान बिय मान्नो एने तान उकुमान पालेन केरनो हे <char style="xt"><ref loc="ECC 12:13">12:13</ref></char> ज्‍यीस आखाम रेन मोहत्वान वात हे।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. पुस्तेकाह लेखणार एने तान थोड़ोक जीवणान अनुबवान ओलखात आपेल हे <char style="xt"><ref loc="ECC 1:1-11">1:1-11</ref></char>।</para>
  <para style="io1">2. जीवणान मतलब पोर चेर्चा केरायेल हे <char style="xt"><ref loc="ECC 1:12">1:12</ref>; <ref loc="ECC 6:9">6:9</ref></char></para>
  <para style="io1">3. मास्तेर ने सेला आपेल हे <char style="xt"><ref loc="ECC 6:10">6:10</ref>; <ref loc="ECC 12:8">12:8</ref></char>।</para>
  <para style="io1">4. पुस्तेकान निवेरनो केरायेल हे काय जीवणान आखो उद्देश बोगवानान बिय मान्नो एने तान उकुमान पालेन केरनो हे <char style="xt"><ref loc="ECC 12:9-14">12:9-14</ref></char>।</para>
  <chapter number="1" style="c" sid="ECC 1" />
  <para style="s">जीवाय कायच कामान नाह</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 1:1" />ज्या मास्तेऱ्यान सोबदा हेते, मास्तेर दाऊदान बिटोख इतो, एने यरूशलेम ने राजा इतो।<verse eid="ECC 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 1:2" />मास्तेर ज्य किथे, कायस कामान नाह सोतो! कायच कामान नाह आखो कायस कामान नाह। <verse eid="ECC 1:2" /><verse number="3" style="v" sid="ECC 1:3" />जी मेहनेत माणुह ज्यी <note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">दिह्यान नेचो</char></note>देरती पोर किरेह, ताह ता से काय फायदो सापड़ेह? <verse eid="ECC 1:3" /><verse number="4" style="v" sid="ECC 1:4" />एक पिढ़ी निवरी जाथे, एने दिहरी पिढ़ी आवेह, पुण देरती जिहीन तिहेच कायेम बोणीन रिथे। <verse eid="ECC 1:4" /><verse number="5" style="v" sid="ECC 1:5" />दिह उगणे, एने तो बुड़ने, एने तो उतवाल्योस ता जागा पोर जात रिथे जाहरी तो उगणे। <verse eid="ECC 1:5" /><verse number="6" style="v" sid="ECC 1:6" />वारो देक्षिण ने उगे चालने, एने फिरीन उत्तर उगे आव जाथे; तो दाड़ीन फिरते एने चालते रिथे, एने वारो जा रेन निकलेल एतो, पोशो तास जात रिथे। <verse eid="ECC 1:6" /><verse number="7" style="v" sid="ECC 1:7" />आख्‍यु नेद्यु एकुस जागान उगे जाहार ताहार वोयत्युह। त्यु आख्‍यु देरीया माय जाएन मिलात्युह, पुण तीबी देरीयो केदी नाह बोरात। <verse eid="ECC 1:7" /><verse number="8" style="v" sid="ECC 1:8" />आख्‍यु वातु थाकाड़णार हेत्यु, माणुह तान वर्णन नाह केर सिकेत; डोला देखीन संतुष्ट नाह एते, एने नाह कान होमलीन संतुष्ट एतेह। <verse eid="ECC 1:8" /><verse number="9" style="v" sid="ECC 1:9" />जी वात एय जायेल हे, ती पोशी एय; एने जो काय बोण जायेल हे तो पोशो बोणावाय जाय, एने देरती पोर काल्ली वात नोवाली नाह सोती। <verse eid="ECC 1:9" /><verse number="10" style="v" sid="ECC 1:10" />काय देरती पोर ओहली काह वात हे, जान बाराम माणहे केय सेकती काय, “दिखो, ज्यी नोवाली वात हे?” पुण ज्य ते आपुह रेन जुनाला कालाम रेन ईती आवणे बाजरेनोह। <verse eid="ECC 1:10" /><verse number="11" style="v" sid="ECC 1:11" />जुनाला कालान वातुन एर एवीन कालाम नाह रेनी, एने नाह आपणी पासाण आवणारा माणहाह ज्यु वातु एर रेती।<verse eid="ECC 1:11" /></para>
  <para style="s">बुध्दी कायच कामान नाह</para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 1:12" />मी हिकाड़णार, इस्राएल देसान राजा इतो, एने यरूशलेम हेयरा माय राज केरतालो। <verse eid="ECC 1:12" /><verse number="13" style="v" sid="ECC 1:13" />ज्यी देरती पोर जो ईथे, बुध्दी केरीन होदणेन एने तान मतलब सोमेजणेन केरता मी मारो मोन लागाड्यो; ज्यी जुलूम दुखान वात हे, जाह बोगवान माणहाह ज्यास कामा माय गुताणेन केरता होपेल हे। <verse eid="ECC 1:13" /><verse number="14" style="v" sid="ECC 1:14" />जो काय देरती पोर ईथे, तो आखो दिखेल हे; तो आखो बिगेर कामान हे।</para>
  <para style="p" vid="ECC 1:14">ज्य तोहलोच हे जोहलो काय वाराह देरनो। <verse eid="ECC 1:14" /><verse number="15" style="v" sid="ECC 1:15" />जो उगार हे तो हुतरो नाह एय सिकेत, एने जो सोतोच नाह, तो गेणाय नाह सिकेत।<verse eid="ECC 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 1:16" />मी सोताह केयो, “देख, जोला यरूशलेम माय माहु रेन पेल एता, ता आखाह रेन मी जुलूम होवटी बुध्दी सापड़ाव लियेल हे; एने माहु जुलूम बुध्दी एने ईकेल जुड़ जायेल हे।” <verse eid="ECC 1:16" /><verse number="17" style="v" sid="ECC 1:17" />मी मारा मोनाह ज्य जाणने माय लागाड्यो काय बुध्दी काय हे, गांडायपोणा एने फोगवायीह बी जाण लेव; तेवी माहु मालुम पोड़नो काय ज्य बी वाराह देरनेन गेत हे। <verse eid="ECC 1:17" /><verse number="18" style="v" sid="ECC 1:18" />काहाकाय जादा बुध्दी माय जुलूम दुख बी ईथे, एने जो तान ईकेल वोड़ावेह तो तान दुख बी वोड़ावेह।<verse eid="ECC 1:18" /></para>
  <chapter eid="ECC 1" />
  <chapter number="2" style="c" sid="ECC 2" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 2:1" />मी मारा मोनाह केयो, चाल मी तुवाह खुसीन द्वारा पारखुह काय खुसी काय हे, पुण मी ज्य बी सापड़ायो काय ज्य बी कायच कामान नाह सोतो। <verse eid="ECC 2:1" /><verse number="2" style="v" sid="ECC 2:2" />मी आहणेन बाराम केयो, “ज्य गांडायपोणा हे,” एने खुसीन बाराम, “ज्य काय कामान हे?” <verse eid="ECC 2:2" /><verse number="3" style="v" sid="ECC 2:3" />मी मोना माय सोच्यो, काय अंगुरान रोह पिणे से किहीक मारा सेरीराह खुस केरू, एने किहीक फोगायपोणाह देर रेव; जाह वोर मालुम नाय केरू काय तो हाजालो काम काल्लो हे, जाह माणुह तान जीवाय बोर केरते रेय।<verse eid="ECC 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 2:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:4 </char>
      <char style="xt" closed="false">
        <ref loc="1KI 10:23-27">1 राजा 10:23-27</ref>; <ref loc="2CH 9:22-27">2 इतिहास 9:22-27</ref></char>
    </note>मी मोट मोटला काम किऱ्यो, मी मार केरता गेर बाणायो; एने मार केरता अंगुरान मोला लागाड्यो। <verse eid="ECC 2:4" /><verse number="5" style="v" sid="ECC 2:5" />मी मार केरता मोला एने फोलान बोगीचा बाणायो, एने ता माय आखी बातीन फोलान जाड़े लागाड्यो। <verse eid="ECC 2:5" /><verse number="6" style="v" sid="ECC 2:6" />जाड़ा माय पाणी टाकणेन केरता मी तेलो बाणायो, काहाकाय तीह केरीन जेंगलान जाड़े मोठा एय सेकती। <verse eid="ECC 2:6" /><verse number="7" style="v" sid="ECC 2:7" /><note caller="+" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="1KI 4:23">1 राजा 4:23</ref></char></note>मी पावोर एने पावेरन्यु वेचातो लिदो जान मार फायच सोरा बी पायदा एना। जा राजा यरूशलेम माय माहु रेन पेल एता, ताह रेन जुलूम होवटा डोरे एने मेंड्रा बोकड्यान मालीक मी एय जायेल इतो। <verse eid="ECC 2:7" /><verse number="8" style="v" sid="ECC 2:8" /><note caller="+" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="1KI 10:10">1 राजा 10:10</ref>; <ref loc="1KI 14:22">14:22</ref></char></note>न्यान सावाय मी राजान एने देसान होनो चांदी एने मोंगाल्यु वोस्तु बी मार फाय टुलो केरीन मिलेल इतो; मी मार केरता गावणारे एदमी एने गावणाऱ्यु बायकुह मेल्यो, एने मार फाय एदम्याह खुस केरनार बायकु बी एत्यु।<verse eid="ECC 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 2:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:9 </char>
      <char style="xt" closed="false">
        <ref loc="1CH 29:25">1 इतिहास 29:25</ref>
      </char>
    </note>इह केरीन मी यरूशलेम ने पेल्ला राजाह रेन जुलूम मोठो एने मालदार एय गीयो, तीबी मारी बुध्दी माहु सात देणे नाह सोड्यी। <verse eid="ECC 2:9" /><verse number="10" style="v" sid="ECC 2:10" />ज्यु वोस्तुह देखणेन माहु आसा एनी, त्यु आख्युह देखणेन मी नाह रोकानो; मी मारा मोनाह एगदी खुसी मोणावणे से नाह रोक्यो, काहाकाय मारो मोन मारी मेहनेतीन आखा कामाम खुस एतालो; एने ज्‍यीस खुसी मारी आखी मेहनेतीन ईनाम हे। <verse eid="ECC 2:10" /><verse number="11" style="v" sid="ECC 2:11" />तेवी मी पुशो मारा आथान आखा कामाह, एने मारी आखी मेहनेतीह दिख्यो, ते काय दिख्यो, आखो कायच कामान नाह, एने वाराह देरनेन गेत हे; देरती पोर माणहान काम एने मेहनेत से काय फायदो नाह।<verse eid="ECC 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 2:12" />ओवतो मी बुध्दी, गांडायपोणा एने फोगवायी पोर विचार केरने बाज गीयो; काहाकाय जो माणुह राजान पासाण आवी, तो काय केरी? तोस जो ईते आयेल हे। <verse eid="ECC 2:12" /><verse number="13" style="v" sid="ECC 2:13" />तेवी मी दिख्यो काय उजालो आंदाराह रेन हाजो हे, तिहेच केरीन बुध्दी फोगवायीह रेन हाजी हे। <verse eid="ECC 2:13" /><verse number="14" style="v" sid="ECC 2:14" />एकलीदार माणुह काय किरेह, ज्य तान डोला देखतेह, एने तो देखीन चालेह; पुण फोगो माणुह आंदारलाम चालेह, तीबी मी जाण गीयो काय दुयून देशा एक हारकी रिथे। <verse eid="ECC 2:14" /><verse number="15" style="v" sid="ECC 2:15" />तेवी मारा मोनाम केयो, “ज्यी देशा फोगान ईथे, तीस मारी बी एय; ओवतो मी ओलो एकलीदार काहा ईनो?” एने मी मोना माय सोच्यो काय ज्य बी कायच कामान नाह सोतो। <verse eid="ECC 2:15" /><verse number="16" style="v" sid="ECC 2:16" />काहाकाय नाहते एकलीदारान एने नाह फोगान एर कायेम बोणीन रेय, पुण बोविष्या माय आखो काय विहराया जाय; एकलीदार किहीक फोगान गेत मोरेह! <verse eid="ECC 2:16" /><verse number="17" style="v" sid="ECC 2:17" />केरीन मी मारा जीवणाह सिट किऱ्यो, काहाकाय जो काम दुनियाम केराय जाथे माहु खाराब मालुम पोड़नो; काहाकाय आखो कायच कामान नाह एने वाराह देरनेन गेत हे।<verse eid="ECC 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 2:18" />मी मारा आखा मेहनेतीन फोलाह जाह मी देरती पोर किरेल इतो सिट किऱ्यो, काहाकाय जोरेवरी हे काय मी तान फोल ता माणहान केरता सोड़ जाव, जो मार पासाण आवी। <verse eid="ECC 2:18" /><verse number="19" style="v" sid="ECC 2:19" />ज्य कुण जाणेह काय तो माणुह एकलीदार रेय काय फोगो? तीबी देरती पोर जोली मेहनेत मी किऱ्यो, एने तान केरता बुध्दीन वापेर किऱ्यो ता आखान तोस आदिकार रेय, ज्य बी कायच कामान नाह। <verse eid="ECC 2:19" /><verse number="20" style="v" sid="ECC 2:20" />तेवी मी मारा मोनाम ती आखी मेहनेतीन बाराम जी मी देरती पोर किरेल इतो नाराज ईनो। <verse eid="ECC 2:20" /><verse number="21" style="v" sid="ECC 2:21" />काहाकाय एगदो ओहलो बी माणुह रीथे, जो एकलीदार ईकेल एने निपुणता से मेहनेत किरेह, तीबी ताह ओहला माणहान केरता सोड़ीन जाणे पुड़ेह, जो ता माय कायच बी मेहनेत किऱ्यो निह एय; ज्य बी कायच कामान नाह एने जुलूमच खाराब हे। <verse eid="ECC 2:21" /><verse number="22" style="v" sid="ECC 2:22" />माणुह जो देरती पोर मोन लागाड़ीन मेहनेत किरेह, ता केरीन ताह काय फायदो ईथे? <verse eid="ECC 2:22" /><verse number="23" style="v" sid="ECC 2:23" />तान आखा दिह ते दुखाम बोराय रेतेह, एने तान काम दुखा हेऱ्य रीथे; राती बी तान मोन सांती माय नाह रेत, ज्य बी कायच कामान नाह सोतो।<verse eid="ECC 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ECC 2:24" />माणहान केरता खाणे पिणे एने मेहनेत केरते लेन तान जीवाह सुखी मेलनेन सावाय उंजु कायच बी हाजो नाह, मी दिख्यो काय ज्य बी बोगवानान उगे रेन जुड़ेह; <verse eid="ECC 2:24" /><verse number="25" style="v" sid="ECC 2:25" />काहाकाय तान सावाय कुण खाय सिकेह? नाहते खुसी मोणाव सिकेह? <verse eid="ECC 2:25" /><verse number="26" style="v" sid="ECC 2:26" />काहाकाय जो माणुह बोगवानान नेजरीम हाजो हे, ताह तो बुद्दी एने ईकेल एने खुसी आपेह; पुण पापीह तो दुखाम बोरायेल कामुस आपेह, बोगवान ताह ता माणहाह आपी, जो तान नेजरी माय हाजो हे; ज्य बी कायच कामान नाह एने वाराह देरनेन गेत हे।<verse eid="ECC 2:26" /></para>
  <chapter eid="ECC 2" />
  <chapter number="3" style="c" sid="ECC 3" />
  <para style="s">आखा कामान एक ठेरायेल टेम</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 3:1" />एकेक वातीन केरता टेम ठेरायेल हे, जो देरती पोर ईथे, एक टेम हे।<verse eid="ECC 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 3:2" />जेल्मान टेम एने मोरनेन बी टेम; पेरनेन टेम</para>
  <para style="q2" vid="ECC 3:2">एने पिरेल ताह उखालनेन बी टेम हे;<verse eid="ECC 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 3:3" />मारनेन टेम एने हुदारनेन बी टेम हे;</para>
  <para style="q2" vid="ECC 3:3">ओदारनेन टेम एने बाणावणेन बी टेम हे;<verse eid="ECC 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 3:4" />रेड़नेन टेम एने आहणेन बी टेम हे; दुख माणावणेन टेम</para>
  <para style="q2" vid="ECC 3:4">एने नाचणेन बी टेम हे;<verse eid="ECC 3:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="ECC 3:5" />दिगोड़ वेरनेन टेम एने दिगोड़ टुलो केरनेन बी टेम हे; गेले लागाड़नेन टेम</para>
  <para style="q2" vid="ECC 3:5">एने गेले लागाड़ने से रोकणेन बी टेम हे;<verse eid="ECC 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 3:6" />होदणेन टेम, एने टाकणेन बी टेम हे;</para>
  <para style="q2" vid="ECC 3:6">वोचाड़ मेलनेन टेम, एने जुगार देणेन बी टेम हे;<verse eid="ECC 3:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="ECC 3:7" />फाड़नेन टेम एने हिवणेन बी टेम हे;</para>
  <para style="q2" vid="ECC 3:7">ठावको रेणेन टेम एने बोलनेन बी टेम हे;<verse eid="ECC 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 3:8" />मोंग केरनेन टेम एने दुसमोनाय मेलनेन बी टेम हे;</para>
  <para style="q2" vid="ECC 3:8">लेड़ाय ने टेम एने मेल मिलाप केरनेन बी टेम हे।<verse eid="ECC 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 3:9" />काम केरनाराह तान मेहनेत से काय फायदो ईथे? <verse eid="ECC 3:9" /><verse number="10" style="v" sid="ECC 3:10" />मी दिखेल हे काय बोगवान माणहा पोर कोलोक बार टाक्‍यो, जो बोगवान माणहान केरता ठेरायेल हे काय ता, ता माय लाग रेय। <verse eid="ECC 3:10" /><verse number="11" style="v" sid="ECC 3:11" />तो आखो ओहलो बाणायेल काय तान तान टेमा पोर ता होबाता रेतेह; ओवतो तो माणहान मोना माय कायेमान ईकेल पायदा किरेल हे, तीबी जो काम बोगवान किरेल हे, तो सुरवात रेन सेवेट वोर माणुह सोमेज नाह सिकेत। <verse eid="ECC 3:11" /><verse number="12" style="v" sid="ECC 3:12" />मी जाणथो काय माणहान केरता, खुसी मोणावणे एने जीवाय बोर बोलाय केरनेन सावाय, उंजु काय बी हाजो नाह; <verse eid="ECC 3:12" /><verse number="13" style="v" sid="ECC 3:13" />एने ज्य बी बोगवानान दान हे, काय माणुह खाय पिय एने तान आखी मेहनेत माय सुखी रेय।<verse eid="ECC 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 3:14" />मी जाणथो काय जो काय बोगवान किरेह, तो कायेम टिकीन रेय; नाह ता माय काय वोदाड़ाय जाय सिकेह, एने नाह काय गेटाड़ाय जाय सिकेह; बोगवान इहकेरीन ज्यानकेरता किरेह काय माणहे तान बिय माने। <verse eid="ECC 3:14" /><verse number="15" style="v" sid="ECC 3:15" />जो काय एनो, तो ज्यान पेल बी एय जायेल हे; जो एण्यो हे, तो एय बी जायेल हे; एने बोगवान वितेल वातुह जाहार ताहार केरने।<verse eid="ECC 3:15" /></para>
  <para style="s">दुनिया माय अन्याय</para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 3:16" />ओवतो मी दुनिया माय काय दिख्यो, काय नियावान जागा पोर खाराब काम ईथे, एने हाजा कामान जागा पोर बी खाराब काम ईथे। <verse eid="ECC 3:16" /><verse number="17" style="v" sid="ECC 3:17" />मी मोनाम केयो, “बोगवान हाजा एने खाराब माणहान दुयून नियाव केरी,” काहाकाय ता फाय एक एक वातीन एने एक एक कामान टेम हे। <verse eid="ECC 3:17" /><verse number="18" style="v" sid="ECC 3:18" />मी मोनाम केयो, “ज्य ज्यान केरता ईथे, काय बोगवान माणहाह पारखे काय ता देख सेके, काय ता जेनवेरान गेत हेते।” <verse eid="ECC 3:18" /><verse number="19" style="v" sid="ECC 3:19" />काहाकाय जोहली माणहान तोहलीच जेनवेरान बी देशा ईथे, दुयून तीस देशा ईथे, जीहे एक मोरेह तिहेच दिहरो बी मोरेह। आखान हांह एक हारकी हे, एने माणुह जेनवेराह रेन काय वोदार नाह; आखो कायच कामान नाह सोतो। <verse eid="ECC 3:19" /><verse number="20" style="v" sid="ECC 3:20" />आखा एकुस जागे जातेह, आखा माटड्या केरीन बुणेल हेते; एने आखा माटड्या माय पोशा मिलाय जातेह। <verse eid="ECC 3:20" /><verse number="21" style="v" sid="ECC 3:21" />काय माणहान जीव उपेर चिड़ेह, एने जेनवेरान जीव नेचो जाएन माटड्या माय मिलाय जाथे? ज्य कुण जाणेह? <verse eid="ECC 3:21" /><verse number="22" style="v" sid="ECC 3:22" />मी ज्य दिखेल हे, काय ज्याह रेन जादा काय हाजो नाह, काय माणुह तान कामा माय खुस रेय; काहाकाय तान ईसो ज्योस हे, काल्लो माणुह एगदान मोतीन बाद ताह पुशो लावीन त्यु वातुह देखाड़ सिकेह?<verse eid="ECC 3:22" /></para>
  <chapter eid="ECC 3" />
  <chapter number="4" style="c" sid="ECC 4" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 4:1" />तेवी मी पुशो देरती पोर ज्य दिख्यो, काय थोड़ाक माणहा हेऱ्य खाराब वेवार ईथे; मी तान आहवा दिखेल हे, एने ताह कुण दिलासो आपणार नाह! वेला केरावणारान आथाम ताकेत एती, एने ज्या माणहे जा माणहाह वेला केरावतेह, ताह दिलासो आपणार बी कुण नाह सोतो। <verse eid="ECC 4:1" /><verse number="2" style="v" sid="ECC 4:2" />केरीन मी ता जीवताला से जा एवी वोर जीवताला हेते, तान गेणती माय मी ता मुरेलाह जा मोर जायेल हेते, जादा हाजो मानुह। <verse eid="ECC 4:2" /><verse number="3" style="v" sid="ECC 4:3" />पुण ता दुयूह रेन जुलूम हाजो तो हे, जान एवी वोर पायदा नाह एनो, एने नाह ता खाराब काम दिख्यो, जा दुनिया माय एतेह।<verse eid="ECC 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 4:4" />तेवी मी आखा मेहनेतीन काम, एने आखा सफल कामाह दिख्यो जा माणहे तान आहेंल्या हेऱ्या कुयराये केरतेह; ज्य बी कायच कामान नाह एने वाराह देरनेन गेत हे।<verse eid="ECC 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ECC 4:5" />फोगो तान आथ जोड़ीन बोह रिथे एने सोतान नुकसान केर लिथे।<verse eid="ECC 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ECC 4:6" />जो काय मुठ बोर तुमरी फाय हे, ता माय खुस रेणे हाजो हे; जा हेऱ्य मेहनेत एने वाराह देरनेन गेत हे।<verse eid="ECC 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 4:7" />तेवी मी देरती पोर पुशो एक वात दिख्यो, जान काय मतलब नाह सोतो। <verse eid="ECC 4:7" /><verse number="8" style="v" sid="ECC 4:8" />एगदो माणुह एखालोच रिथे, एने तान कुण नाह सोतो; तान नाह सोरा हेते, एने नाह बाहख हेते, तीबी तान मेहनेत निवरेत नाह; एने जो काय ता फाय रिथे, ता केरीन केदी संतुष्ट नाह एत; एने नाह तो केदी किथे, “मी कुणीन केरता मेहनेत केरथु, एने मारा जीवणाह हुक नाह जुड़ेत?” ज्य बी कायच कामान नाह एने दुखाम बोरायेल काम हे।<verse eid="ECC 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 4:9" />एक माणहाह रेन दुय माणहे हाजा रेतेह, काहाकाय जा कामाम ता मेहनेत केरतेह, ता कामाम ताह हाजो फायदो जुड़ेह। <verse eid="ECC 4:9" /><verse number="10" style="v" sid="ECC 4:10" />काहाकाय केदी ताम रेन एक पोड़ जाय, ताहार दिहरो तान हातीह उठाड़ी; पुण तान केरता दुखान वात ज्यी हे जेवी तो एखालो पोड़ी, ताह उठाड़नार कुण दिहरो निह एय। <verse eid="ECC 4:10" /><verse number="11" style="v" sid="ECC 4:11" />केदी दुय जाणे एकठास हुवतेह, ताहार ता ताताला रेती, पुण एखालो हुवणार माणुह किहीक तातो एय सिकेह? <verse eid="ECC 4:11" /><verse number="12" style="v" sid="ECC 4:12" />केदी एगदो एखालाह आरीव बी सिकेह, पुण दुय तान सामनो केर सेकतेह। जी दोयड़ी तीन हुता केरीन बुणेल हे, ती उतवाली टुट नाह सिकेत।<verse eid="ECC 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 4:13" />एकलीदार जुवान गेरीब एणे से बी ओहला डावाला एने फोगा राजाह रेन जुलूम हाजो हे, जा चेतावणी नाह मानते। <verse eid="ECC 4:13" /><verse number="14" style="v" sid="ECC 4:14" />एय सिकेह काय तो जुवान जेली माय रेन निकलीन राज पोदा पोर आयेल एय, नाहते एय सिकेह काय तो तान राज माय गेरीबी माय पायदा इनो एय। <verse eid="ECC 4:14" /><verse number="15" style="v" sid="ECC 4:15" />मी देरती पोर फिरते आखा जीवताला माणहाह ता दिहरा जुवानान उगे जातालो दिख्यो, जो पेल्लान जागो लेय। <verse eid="ECC 4:15" /><verse number="16" style="v" sid="ECC 4:16" />ता आखा माणहान काय सेवोट नाह, एने नाह तान जा न्याह रेन पेल एता; एने जा बाद माय आवती, ता ता से खुस नाय एती, ज्य बी कायच कामान नाह एने वाराह देरनेन गेत हे।<verse eid="ECC 4:16" /></para>
  <chapter eid="ECC 4" />
  <chapter number="5" style="c" sid="ECC 5" />
  <para style="s">उतवाल माय मोन्नेत नाह मान्नो</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 5:1" />जेवी तु बोगवानान मोंदिर माय जाहे, ताहार तारा चालनान चोकसी किरज्ये; फोगान द्वारा चेड़ायेल बोलीह रेन, बोगवानान मोंदिर माय जाणे एने तान वचन होमेल ने हाजो हे; काहाकाय फोगो ज्य नाह जाणेत काय जो काम तो किरेह, तो खाराब हे। <verse eid="ECC 5:1" /><verse number="2" style="v" sid="ECC 5:2" />वातु केरने माय उतवाल मा किरहे, एने उतवाल माय तारी मोनान वात बोगवानान सामने मा निकालहे, काहाकाय बोगवान हेरगा माय हे, एने तु देरती पोर हे; केरीन तारा सोबदा थोड़ास रेती।<verse eid="ECC 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 5:3" />काहाकाय जीहे काम वोदार रेणे से, माणुह होपनो दिखेह, तिहेच केरीन जुलूम वातु बोलनार फोगो ठेराथे।<verse eid="ECC 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 5:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:4 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 66:13-14">बजन 66:13-14</ref>
      </char>
    </note>जेवी तु बोगवानान केरता मानता मानहे, तेवी ताह पुरो केरने माय वार मा लागाड़हे। काहाकाय बोगवान फोगा माणहा से खुस नाह एत। एने जी मोन्नेत तु मानेल हे तीह पुरी किरज्ये। <verse eid="ECC 5:4" /><verse number="5" style="v" sid="ECC 5:5" />मानता मानीन तीह पुरी नाह केरने से, मानता नाह मान्ने से हाजो हे। <verse eid="ECC 5:5" /><verse number="6" style="v" sid="ECC 5:6" />तु तारा मुया केरीन ओहला सोबदा मा निकालहे जा तुवाह पापाम फोसाड़ी, एने हेरोगदुतान सामने ज्य मा किहे काय मार से गेलती एय गियीह; बोगवान तारो बोल होमलीन काहा नाराज एय, एने तो मेहनेत से किरेल तारा कामाह नास केर देय।<verse eid="ECC 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 5:7" />जेवी माणुह जादा होपनो देखणे बाज जाथे, तेवी तान बिगेर कामान वात बी वोड़ जाथे; पुण तु बोगवानाह बिज्ये।<verse eid="ECC 5:7" /></para>
  <para style="s">जीवणो फालतु हे</para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 5:8" />केदी तु एगदा ईलाका माय गेरब्या पोर वेला केरावतालो एने नियाव बिगाड़तालो दिखहे, ताहार न्या से बोंगलाहे मा; काहाकाय एक आदिकारीन उपेर आखाम रेन मोटलो आदिकारी रिथे, एने ताह रेन बी उपेर मोटलो आदिकारी रिथे। <verse eid="ECC 5:8" /><verse number="9" style="v" sid="ECC 5:9" />पुण खेतान कामाय आखान केरता हे, पुण खेता केरीन राजान बी काम निकलेह।<verse eid="ECC 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 5:10" />जो पोयशाह मोंग किरेह, तो केदी बी पोयशा से नाय बोराय, एने नाह ओहलो माणुह, जाह मालदेनान मोंग हे; तान जुलूम फायदा से खुस ईथे, ज्य बी कायच कामान नाह।<verse eid="ECC 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 5:11" />जेवी मालदेन वोड़ जाथे, तेवी ताह खाणारे जोस्ती बी वोड़ जातेह; तेवी तान मालक्याह ता से काय फायदो ईथे? फोक्‍तो ज्योस काय तो ताह डोला केरीन उलोस देखी!<verse eid="ECC 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 5:12" />मोंजरी केरनार थोड़ोस खाय नाहते पेट बोरीन तीबी तान निंद जुलूम हाजी रीथे; पुण मालदारान माल वोड़ने से ताह निंद नाह आवेत।<verse eid="ECC 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 5:13" />मी देरती पोर जुलूम बुराय दिखेल हे, मतलब तो मालदेन जाह तान मालीक सोताहस तेकलीत देणेन केरता कामायेल इतो। <verse eid="ECC 5:13" /><verse number="14" style="v" sid="ECC 5:14" />केदी तान मालदेन एगदा खाराब कामाम जात रीथे, एने केदी तान गेराम सोरो पायदा ईथे, पुण ताह आपणेन केरता तान आथाम कायच नाह रेत। <verse eid="ECC 5:14" /><verse number="15" style="v" sid="ECC 5:15" /><note caller="+" style="x"><char style="xo" closed="false">5:15 </char><char style="xt" closed="false"><ref loc="JOB 1:21">अयुब 1:21</ref>; <ref loc="PSA 49:17">बजन 49:17</ref>; <ref loc="1TI 6:7">1 तीमुथीयुस 6:7</ref></char></note> जोहलो तो तान आईख ने पेटाम रेन पायदा ईयेल इतो, तोहलोच नांगेरलोच वोल जाय, तो तान आथाम तान मेहनेतीन फोल नाय ली जाय सेकी। <verse eid="ECC 5:15" /><verse number="16" style="v" sid="ECC 5:16" />ज्यी मोटली दुखान वात हे, माणुह जोहलो पायदा ईयेल इतो; तोहलोच मोरी, ते ताह मेहनेत केरने से काय फायदो हे? <verse eid="ECC 5:16" /><verse number="17" style="v" sid="ECC 5:17" />फोक्‍तो ज्या से काय तान जीवाय बोर चिन्ता माय खाणो खादो, एने जुलूम दुखी एने दुखाऱ्यो रिनो एने राग बी किरते रिनो।<verse eid="ECC 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 5:18" />होमलो, जी हाजी वात हे! माणुह खाय पिय एने तान मेहनेत से जो तो देरती पोर किरेह, तान आखी जीवाय बोर जो बोगवान ताह आपेल हे, हुकेह मिले; काहाकाय तान ईसो ज्योस हे। <verse eid="ECC 5:18" /><verse number="19" style="v" sid="ECC 5:19" />एक एक माणहाह बोगवान मालदेन, एने ती वोस्तुन खुसी केरनेन ताकेत आपेह, ते ता माणहाह जो काय ता फाय हे, ताह स्वीकार केरने, एने खुसी से मेहनेत केरी ज्य बोगवानान दान हे। <verse eid="ECC 5:19" /><verse number="20" style="v" sid="ECC 5:20" />माणुह तान पुरी जीवायीह कायेम ने केरता एर नाय केरी, काहाकाय बोगवान ता माणहाह ता कामा मायच लागाड़ मिलेह; जा कामाह केरने माय ता माणहाह हाजो लागेह।<verse eid="ECC 5:20" /></para>
  <chapter eid="ECC 5" />
  <chapter number="6" style="c" sid="ECC 6" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 6:1" />एक बुराय जी मी देरती पोर दिखेल हे, जीन बार से माणुह दाबायेल रिथे। <verse eid="ECC 6:1" /><verse number="2" style="v" sid="ECC 6:2" />ती बुराय ज्यी हे, बोगवान माणहाह मालदेन एने बोड़ाय ओलो आपेल हे; काय जो काय तान मोन हुदेह ताह काय बी कोमी नाह एत, तीबी बोगवान ताह ताम रेन खाणे नाह देत, एगदो दिहरोच ताह खाथे; ज्यी जुलूम दुखान वात हे। <verse eid="ECC 6:2" /><verse number="3" style="v" sid="ECC 6:3" />केदी एगदा माणहान होव सोरा पायदा एतेह, एने तो जुलूम वोरह्या वोर जीवतालो रिथे, एने तान वोय वोड़ जाय; पुण नाह केदी तान जीव खुस रेय, एने मोरनेन बाद बी सेवली किऱ्या बी तान नाय एय, ओहलो माणहाह रेन आदा मोयनान मुरेल सोरो हाजो हे। <verse eid="ECC 6:3" /><verse number="4" style="v" sid="ECC 6:4" />काहाकाय तो सोरो उदुडुस आवोह, एने आंदारलाम आरताय जाथे, एने तान नाव बी आंदारला माय लीकाय जाथे। <verse eid="ECC 6:4" /><verse number="5" style="v" sid="ECC 6:5" />माणुह खाणेन केरता मेहनेत किरेह, तीबी तान पेट नाह बोरात। <verse eid="ECC 6:5" /><verse number="6" style="v" sid="ECC 6:6" />केदी माणुह दुय एजार वोरीह जीवे, पुण केदी तो जीवायीह खुसी माय नाह जीवेत, ताहार ताह काय फायदो? काय आखा माणहे जीवायीन सेवली बुखेत एकुस जागे नाह जाते?<verse eid="ECC 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 6:7" />माणुह तान पेटान केरतास आखी मेहनेत किरेह, तीबी तान पेट केदी नाह बोरात। <verse eid="ECC 6:7" /><verse number="8" style="v" sid="ECC 6:8" />एकलीदार माणुह काल्ली वातीम फोगा माणहाह रेन हाजो हे? एने गेरीब जो ज्य जाणेह काय ज्या जीवणाम किहीक चालने जुवे, तो बी ताह रेन काल्ली वातीम हाजो हे? <verse eid="ECC 6:8" /><verse number="9" style="v" sid="ECC 6:9" />डोला केरीन देखणे मोनान आसा केरनेह रेन हाजो हे, ज्य बी कायच कामान नाह; एने वाराह देरनेन गेत हे।<verse eid="ECC 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 6:10" />जो काय बी माणुह एय, ताह तान नाव पेलुच रेन मिलेल एतो; एने माणहान बाराम देखाड़ाय जायेल एतो काय तो फोक्‍तो माटड्यच हे। एने तो ताह रेन जादा ताकेतवोर माणहा हिऱ्यो लेड़ नाह सिकेत। <verse eid="ECC 6:10" /><verse number="11" style="v" sid="ECC 6:11" />जुलूम होवट्यु ओहल्यु वातु हेत्यु, जान वोजे से जीवाय उंजु बी कायच कामान नाह रेत, ताहार ओवतो माणहाह काय फायदो? <verse eid="ECC 6:11" /><verse number="12" style="v" sid="ECC 6:12" />माणुह तान एक तालान जीवाय सावलान गेत जीवेह, कुण जाणेह काय तानकेरता ओहला जीवणाम हाजो काय हे? माणहाह कुण केय सिकेह, काय तान मोतीन बाद देरती पोर काय एय?<verse eid="ECC 6:12" /></para>
  <chapter eid="ECC 6" />
  <chapter number="7" style="c" sid="ECC 7" />
  <para style="s">जीवणान बाराम विचार</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 7:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">7:1 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 22:1">नितीवचन 22:1</ref>
      </char>
    </note>हाजो नाव मोंगाला आस्तराह रेन हाजो हे, एने मोतीन दिह पायदा एणेन दिह्याह रेन हाजो हे। <verse eid="ECC 7:1" /><verse number="2" style="v" sid="ECC 7:2" />तिवार मोणावणारान गेर जाणे से, दुख मोणावणारान गेर जाणे हाजो हे; काहाकाय मोतुस आखा माणहान सेवोट हे, एने जो जीवतालो माणुह हे, तो मोन लागाड़ीन ज्यी वाती पोर विचार केरी।<verse eid="ECC 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 7:3" />आहतायीह रेन दुख हाजो हे, काहाकाय मुयान दुख मोनान हुक हे।<verse eid="ECC 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 7:4" />एकलीदार माणहान मोन दुखी कुटूमाम लाग रीथे, पुण फोगा माणहान मोन खुसी मोणावणारान गेराम लाग रीथे।<verse eid="ECC 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ECC 7:5" />फोगान मुया केरीन गीत होमेलने से, एकलीदारान जुलनो होमेलने हाजो हे।<verse eid="ECC 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ECC 7:6" />काहाकाय फोगान आहताय, एगदा ठामलान बुंदे काटा हेलेगणेन चेड़चेड़ आवाजान गेत ईथे। ज्य बी कायच कामान नाह।<verse eid="ECC 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 7:7" />माणहाह वेला केरावीन लियेल मालदेन से एकलीदार बी फोगो बोण जाथे, एने गुस से बुद्दी नास एय जाथे।<verse eid="ECC 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 7:8" />एगदा कामान सुरवातीह रेन तान सेवोट हाजो हे, एने दिर देरनार माणुह गोमेंडीह रेन हाजो हे।<verse eid="ECC 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 7:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">7:9 </char>
      <char style="xt" closed="false">
        <ref loc="JAS 1:19">याकुब 1:19</ref>
      </char>
    </note>तारा मोना माय चालोच राग मा किरे, काहाकाय राग फोगान मोनाम रिथे।<verse eid="ECC 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 7:10" />ज्य मा किहो, काय आजीन दिह्याह रेन; गीया दिह हाजा एता? काहाकाय ज्यान बाराम तुमरो ज्य केणो ईकेल केरीन नाह सोतो।<verse eid="ECC 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 7:11" />बुद्दी मालदेन जुड़ेल ईसान गेत एक हाजाली चिज हे, एने ता माणहाह फायदो पोचाड़ेह जा दिह्याह देखतेह।<verse eid="ECC 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 7:12" />काहाकाय बुद्दीह होमालनो, मालदेनाह होमालनेन बाराबोर हे; पुण एकलीन फायदो ज्यो हे, काय बुद्दी केरीन तीन मेलनारान जीवान राखवाल ईथे।<verse eid="ECC 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 7:13" />बोगवानान कामा पोर विचार किरो, जाह बोगवान वाकड़ो बाणायेल हे, ताह कुण हुतरो केर सिकेह?<verse eid="ECC 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 7:14" />हुकान दिह्याम खुसी मोणावो, पुण दुखान दिह्याम विचार किरो, काहाकाय बोगवान हुक एने दुख दुयूह बाणायेल हे; काहाकाय माणुह ज्यी वातीह नाय सोमजी सिके काय तान बाद काय एण्यो हे।<verse eid="ECC 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 7:15" />मी मारा बिगेर कामान जीवणा माय ज्य आखो दिखेल हे, देरमी माणुह हाजो काम केरते लेन मोर जाथे; एने खाराब माणुह बुराय केरते लेन जुलूम वोरह्या जीवेह। <verse eid="ECC 7:15" /><verse number="16" style="v" sid="ECC 7:16" />जुलूम देरमी मा बुणो, एने नाह सोताह जुलूम एकलीदार बाणावो; नाहते तुमू तुमरा पाया पोर सोता कुराड़ केरीन दिहो। <verse eid="ECC 7:16" /><verse number="17" style="v" sid="ECC 7:17" />जुलूम खाराब बी मा बुणो, एने नाह फोगो; नाहते तु तारा टेमाह रेन पेलुच मोर जाहे। <verse eid="ECC 7:17" /><verse number="18" style="v" sid="ECC 7:18" />हाजो ज्य हे काय एकाह देर रेय, एने दिहराह बी तारा आथाम रेन सुटणे मा दिहे; जो माणुह बोगवानान बोक्ती किरेह, तो न्यु सोब केठीण माय रेन निकील जाय।<verse eid="ECC 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ECC 7:19" />बुध्दीस एकलीदार माणहाह हेयरान दोह आदिकारीह रेन जादा ताकेत जुड़ेह। <verse eid="ECC 7:19" /><verse number="20" style="v" sid="ECC 7:20" />खेरीच दुनिया माय ओहलो देरमी माणुह नाह सोतो, जो कायेम हाजोस किरते रेय, एने केदी पाप नाह किरेत।<verse eid="ECC 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ECC 7:21" />ज्यु वातु माणहे केतेह, त्यु आख्‍यु वातुह होमेलहे मा; नाहते तु ज्यी वात होमेलहे काय तारो पावोर तुवाहच हाराप देणे बाजरिनोह। <verse eid="ECC 7:21" /><verse number="22" style="v" sid="ECC 7:22" />काहाकाय तु सोता जाणेह, काय तु बी जुलूम वार दिहरान चिहटा किरेल हे।<verse eid="ECC 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ECC 7:23" />ज्य आखो मी बुध्दी केरीन पारखेल हे, मी सोच्यो, मी एकलीदार बोणुह; पुण बुद्दी माहु रेन सेटीच रेनी। <verse eid="ECC 7:23" /><verse number="24" style="v" sid="ECC 7:24" />बुध्दी जी हे ती सेटी हे, एने जुलूम उंडी हे एने तीह कुण सोमेज सिकेह? <verse eid="ECC 7:24" /><verse number="25" style="v" sid="ECC 7:25" />मी ज्य जाणनेन केरता मोन लागाड्यो काय बुध्दी काय हे, होद निकालु एने तान मतलब जाणु, जा केरीन माहु मालुम पोड़ जाय काय फोगवाय गुनो हे; एने फोगवाय गांडायपोणा हे।<verse eid="ECC 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ECC 7:26" />तेवी मी मोतीह रेन बी जुलूम माणी ती बायकुह सापडायो, जीन मोन फांदो एने जाल हे; एने जीन आथ आतबेड्यु हेत्यु। फोक्‍तो तोस एदमी तीह रेन वोच सिकेह, जा से बोगवान खुस रीथे, पुण पापी एदमी तीन सिकार एय जाथे। <verse eid="ECC 7:26" /><verse number="27" style="v" sid="ECC 7:27" />हिकाड़णार किथे, “दिखो, खेराय जाणनेन केरता आलेग आलेग वातु मिलावीन पारख्यो, ते ज्यी वात निकाल्यो। <verse eid="ECC 7:27" /><verse number="28" style="v" sid="ECC 7:28" />पुण मी जाह होदणे बाजरिनोह, तो माहु सापेड़नो नाह, एजार एदम्या माय रेन एक एदमी माहु सापेड़नो; पुण ता माय माहु एक बी बायकु नाह सापेड़नी। <verse eid="ECC 7:28" /><verse number="29" style="v" sid="ECC 7:29" />दिखो मी फोक्‍तो ज्यी खेराय सापड़ायेल हे, बोगवान माणहाह सिदो सादो बाणायेल हे; पुण माणुह सोता जीवणान जुलूम योजना होद काड़ेल हे।”<verse eid="ECC 7:29" /></para>
  <chapter eid="ECC 7" />
  <chapter number="8" style="c" sid="ECC 8" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 8:1" />एकलीदार माणुह कुणीन गेत हे? एने काल्लो माणुह एगदी वातीन मतलब जाणेह? माणहान बुध्दीन वोजेसे तान मुय चोमकीह, एने तान दुख सेटो एय जाथे।<verse eid="ECC 8:1" /></para>
  <para style="s">राजान उकुमान पालेन किरो</para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 8:2" />मी तुवाह सेला आपथु, काय बोगवानान सामने सुगोण खाणेन कारेण राजान उकुमान पालेन किरो। <verse eid="ECC 8:2" /><verse number="3" style="v" sid="ECC 8:3" />राजान सामने रेन जाणे उतवाल मा किरो, एने एगदा खाराब उद्देस से तान सामने उबी मा रिवो; काहाकाय तो जो हुदेह तोस एय। <verse eid="ECC 8:3" /><verse number="4" style="v" sid="ECC 8:4" />काहाकाय राजान सोबदा माय ते ताकेत रिथे राजाह कुण फुस सिकेह; तु ज्य काय केरने बाजरिनोह? <verse eid="ECC 8:4" /><verse number="5" style="v" sid="ECC 8:5" />केदी राजान उकुमान पालेन किरेह, ताहार तो वोचीन रेय, पुण एक एकलीदार माणुह उपयोगी टेम एने उपयुक्त कामान रित जाणेह, एने तो ज्य बी जाणेह काय ज्यी वात केवीह केरनु जुवे। <verse eid="ECC 8:5" /><verse number="6" style="v" sid="ECC 8:6" />काहाकाय एकेक वातीन ठिक टेम, एने नेम रिथे, काहाकाय माणहान दुख तान केरता जुलूम बारी रीथे। <verse eid="ECC 8:6" /><verse number="7" style="v" sid="ECC 8:7" />माणुह ज्य नाह जाणेत काय एण्यो हे, एने कुलबुखे एय? ज्य ताह कुण केय सिकेह? <verse eid="ECC 8:7" /><verse number="8" style="v" sid="ECC 8:8" />जीहे वाराह कुण नाह रोक सिकेत, तिहेच केरीन मोतीन दिह्या पोर कुणीन आदिकार नाह काय तीह रोक सेकी; एने लेड़ायीन बुखेत ताह सुट्टी नाह जुड़ेत, एने नाह बुराय केरनारे माणहे तान बुरायीन कारेण वोच सेकतेह।<verse eid="ECC 8:8" /></para>
  <para style="s">बाकतो एने हाजो</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 8:9" />जोला काम देरती पोर केराय जातेह ता आखाह मी हासकेरीन दिख्यो, एने ज्य बी दिख्यो काय एक माणुह दिहरा माणहान उपेर आदिकारी बोणीन तान उपेर नुकसान लावेह। <verse eid="ECC 8:9" /><verse number="10" style="v" sid="ECC 8:10" />तेवी मी खाराब माणहाह माहणा माय बुजाय जाताला दिख्यो, ता चोखाला जागाम आवताला जाताला। हेयरा माय जाहरी ता बात बातीन काम किरेल एता; तान बोड़ाय केराय जाताली, ज्य बी कायच कामान नाह। <verse eid="ECC 8:10" /><verse number="11" style="v" sid="ECC 8:11" />खाराब कामान केरता माणहाह उतवाल्यह देन्ड नाह जुड़ने, केरीन माणहान मोन खाराब काम केरने माय लागीन रिथे। <verse eid="ECC 8:11" /><verse number="12" style="v" sid="ECC 8:12" />केदी पापी माणुह होव वारीन पाप किरेह, एने ताह देन्ड नाह जुड़ेत; तो जुलूम वोरह्या वोर जीवतालो रिथे, तीबी मी ज्य जाणथो काय बोगवानाह बिणारान सेवोट हाजोच ईथे, बोगवान तान बोलो किरेह, काहाकाय ता ताह बितेह। <verse eid="ECC 8:12" /><verse number="13" style="v" sid="ECC 8:13" />पुण खाराब माणहान बोलो नाय एय, एने नाह तान जीवाय वोद सेकी; काहाकाय तो बोगवानाह नाह बित। <verse eid="ECC 8:13" /><verse number="14" style="v" sid="ECC 8:14" />एक कायच कामान नाह वात देरती पोर ईथे, मतलब ओहला देरमी हेते जान ती देशा ईथे जी खाराब माणहान एणे जुवे; केरीन मी केथु, ज्य बी कायच कामान नाह।<verse eid="ECC 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 8:15" />केरीन मी माणहाह सेला आपथु, खुसी माणावणेन सोड़ीन उंजु कायच बी हाजो नाह, काहाकाय ज्योस तान जीवाय बोर जो बोगवान तान केरता देरती पोर ठेरावी; तान मेहनेत माय ज्‍यीस खुसी बोणीन रेय।<verse eid="ECC 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 8:16" />जेवी मी बुध्दी सापड़ावणेन केरता एने देरती पोर एण्या काम वेपाराह सोमेजणेन केरता मारो मोन लागाड्यो, एने जेवी मी ज्य जाणनेन कोसीत किऱ्यो काय माणहे किहीक रात दिह जागताला रेतेह; <verse eid="ECC 8:16" /><verse number="17" style="v" sid="ECC 8:17" />तेवी मी बोगवानान आखो काम दिख्यो जो देरती पोर ईथे, केदी माणुह तान मतलब जाणनेन केरता कोलोक बी मेहनेत काहा नाय केरी, तीबी ताह जाण नाय सेकी; एने केदी इखेह एकलीदार माणुह ताह जाणनेन कोसीत केरी, तीबी तो तान पोतो नाह लागाड़ सिकेत।<verse eid="ECC 8:17" /></para>
  <chapter eid="ECC 8" />
  <chapter number="9" style="c" sid="ECC 9" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 9:1" />मी ज्यु आख्‍यु वातुह पारख्यो एने मोना केरीन हास केरीन विचार किऱ्यो, काय किहीक देरमी एने एकलीदार माणहे एने तान कामे बोगवानान आथाम हेते; माणहान ओंगाण आखी बातीन वातु हेत्यु, पुण तो नाह जाणेत काय तो मोंग हे काय दुसमोनाय। <verse eid="ECC 9:1" /><verse number="2" style="v" sid="ECC 9:2" />आख्‍यु वातु आखान केरता एक हारक्यु रेत्युह, देरमी एय नाहते बाकतो, हाजो नाहते खाराब, बोली केरनार एने बोली नाह केरनार आखान देशा एकुस रीथे; जीहे हाजाला माणहान देशा, तिहेच केरीन पापी माणहान देशा; जीह केरीन सुगोण खाणारान देशा, तिहेच केरीन सुगोण खाणेन बिथे तान। <verse eid="ECC 9:2" /><verse number="3" style="v" sid="ECC 9:3" />देरती पोर जो काय ईथे, ता माय ज्यी बुराय ईथे काय आखा माणहान एकुस देशा ईथे; एने माणहान मोना माय बुराय बोराय रेनीह, एने जाह वोर ता जीवताला रेतेह तान मोनाम गांडायपोणा रिथे, एने तान बाद ता मुरेल माणहा माय जाय मिलातेह। <verse eid="ECC 9:3" /><verse number="4" style="v" sid="ECC 9:4" />पुण जाह वोर माणुह जीवतालो रिथे, ताह आसा हे; काहाकाय जीवतालो चितो मुरेल सिंहवागाह रेन जुलूम हाजो हे। <verse eid="ECC 9:4" /><verse number="5" style="v" sid="ECC 9:5" />काहाकाय जीवताला माणहे जाणतेह काय ताह मोरनु हे, पुण मुरेल कायच बी नाह जाणेत; एने नाह तान केरता ओंगाण काह उंजु फोल जुड़ी, काहाकाय माणहे ताह विहरी जातेह। <verse eid="ECC 9:5" /><verse number="6" style="v" sid="ECC 9:6" />एगदा माणहान मोरनेन बाद तान मोंग, दुसमोनाय एने तान कोपेट खेतेम एय जाथे; एने देरती पोर जो काय केराय जाथे, ता माय एवी रेन तान ईसो नाय रेय।<verse eid="ECC 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 9:7" />एवी तु तार गेर जात रे, तारो रूटो खुसी से खा, एने खुस मोन से तारो अंगुरान रोह पी; काहाकाय बोगवान तारा कामा से खुस एय जायेल हे। <verse eid="ECC 9:7" /><verse number="8" style="v" sid="ECC 9:8" />तारा फाड़का कायेम दोवल्या रेती, एने तारे मुंडी पोर तेलान कोमी नाय एय। <verse eid="ECC 9:8" /><verse number="9" style="v" sid="ECC 9:9" />तारी बिगेर कामान जीवायी माय जो तो देरती पोर तार केरता ठेरायेल हे, तारी मोंगाल्ली बायकु हिऱ्यो जीव, काहाकाय तार जीवाय एने तार मेहनेत माय जो तु देरती पोर किरेह, तारो ज्योस ईसो हे। <verse eid="ECC 9:9" /><verse number="10" style="v" sid="ECC 9:10" />जो काम तुवाह केरने जुड़ी ताह तारी पुरी ताकेत से केर, काहाकाय नेरका माय जा तु जाण्यो हे; नाह काम, नाह योजना, नाह ईकेल एने नाह बुध्दी हे।<verse eid="ECC 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 9:11" />देरती पोर मी दिख्यो काय जोरेह दोवेड़णाराह जिक नाह जुड़ने एने नाह ताकेतवोर सिपाय लेड़ाय माय जीकणे। ईकेलवाला माणहाह रूटो नाह जुड़ने, एने नाह सोमेजदाराह मालदेन जुड़ने, एने नाह गीण हाजालाह जुड़ने; जेवी टेम आवेह ते आखा हेऱ्य खाराब वातु गेट जात्युह। <verse eid="ECC 9:11" /><verse number="12" style="v" sid="ECC 9:12" />काहाकाय माणुह तान टेम नाह जाणेत, जीहे मासा जालाम एने चिड़ा फांदा माय फोस जातेह; तिहेच केरीन माणुह दुखान टेमाम जो ता पोर उचकाहुच आव पुड़ेह, फोस जातेह।<verse eid="ECC 9:12" /></para>
  <para style="s">एकलीदार एने फोगान बापतीम विचार</para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 9:13" />मी देरती पोर ओहली बुध्दीन वात बी दिखेल हे, जी माहु जुलूम मोहत्वान लागी। <verse eid="ECC 9:13" /><verse number="14" style="v" sid="ECC 9:14" />एक आत्योच हियोर इतो, जा माय थोड़ास माणहे रेताला; एने एक दिह एगदो राजा ता हिऱ्यो लेड़ाय केरीन ताह कोंड लिदो, एने हेयरान कावदेन तान सेना लागाड़ दिनो। <verse eid="ECC 9:14" /><verse number="15" style="v" sid="ECC 9:15" />पुण ता आत्‍यास हेयराम एक गेरीब एकलीदार माणुह एतो, तो तान एकली केरीन ता हेयराह वोचाड्यो; तीबी ता गेरीब माणहाह आखा माणहे विहरी गीया। <verse eid="ECC 9:15" /><verse number="16" style="v" sid="ECC 9:16" />पुण गेरीब एदम्यान बुध्दीन कुण आदार नाह केऱ्य, तान वातु कुण नाह होमलेत तीबी मी केथु; ताकेतीह रेन बुध्दी हाजी हे। <verse eid="ECC 9:16" /><verse number="17" style="v" sid="ECC 9:17" />फोगान विचीम राजान आयेड़ने से कुवालोच एकलीदार माणहान वातु होमेलने ताह रेन जुलूम हाजो हे। <verse eid="ECC 9:17" /><verse number="18" style="v" sid="ECC 9:18" />लेड़ायीन आथ्याराह रेन बुध्दी हाजी हे, पुण एक पापी जुलूम हाजाला कामाह खेतेम केर दिथे।<verse eid="ECC 9:18" /></para>
  <chapter eid="ECC 9" />
  <chapter number="10" style="c" sid="ECC 10" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 10:1" />मुरेल माखान वोजेसे आसत्राह खाराब केर देतेह, इहीच केरीन जारीक फोगवाय बुध्दी एने मान सम्मान कोम केर दिथे।<verse eid="ECC 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 10:2" />एकलीदारान मोन हाजी वातीन उगे रिथे, पुण फोगान विचार ताह खाराब वाटी पोर ली जातेह। <verse eid="ECC 10:2" /><verse number="3" style="v" sid="ECC 10:3" />जीहे फोगो सेड़की पोर चालेह, ता माय सोमेज ने कोमी रिथे, जासे मालुम पुड़ेह तो फोगो हे।<verse eid="ECC 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 10:4" />केदी आदिकारी तार से रागारो एय, ताहार तु तारो जागो मा सोड़हे; काहाकाय दिर मोट मोटला गुनाह बी हुदार दिथे।<verse eid="ECC 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ECC 10:5" />मी एक बुराय जी देरती पोर दिख्यो, ती आदिकारीन चुकी से ईथे। <verse eid="ECC 10:5" /><verse number="6" style="v" sid="ECC 10:6" />फोगा उचाला हाजाला जागा पोर बोहाड़ाय जातेह, एने मालदार माणहे बुंदे बोहतेह। <verse eid="ECC 10:6" /><verse number="7" style="v" sid="ECC 10:7" />मी गुलाम माणहाह गोड़ा पोर बोहीन जातालो दिखेल हे, एने राज कुमार गुलामान गेत बुई पोर पाये चालताला।<verse eid="ECC 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 10:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:8 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 7:15">बजन 7:15</ref>; <ref loc="PRO 26:27">नितीवचन 26:27</ref></char>
    </note>जो दिहरा माणहान केरता खाडो खोदेह, तो सोता ता माय पोड़ी; एने जो चोरी केरनेन केरता बितड़ो तुड़ेह, ताह गेयड़ेक टोची। <verse eid="ECC 10:8" /><verse number="9" style="v" sid="ECC 10:9" />जो बितड़ान देगड़ाह सिटो किरेह, ताह दिगोड़ लागी, एने जो एद्दीन लाकड़े काटी, ताह ता से दुको रेय। <verse eid="ECC 10:9" /><verse number="10" style="v" sid="ECC 10:10" />केदी कुराड़ बोथड़ी एय, एने माणुह तीन दारीह नाय निहाणे, ताहार जादा ताकेत लागाड़ने पोड़ी; पुण काम केरनेन केरता बुध्दी कामान हे। <verse eid="ECC 10:10" /><verse number="11" style="v" sid="ECC 10:11" />केदी मोंतेर मारनेन पेल गेयड़ेक टोची, ताहार मोंतेर केरनाराह कायच फायदो नाह। <verse eid="ECC 10:11" /><verse number="12" style="v" sid="ECC 10:12" />बुध्दीमान ने मुयाम रेन निकलेल सोबदा गीणाता रेतेह, पुण फोगा तान सोबदान द्वारा खेतेम एतेह। <verse eid="ECC 10:12" /><verse number="13" style="v" sid="ECC 10:13" />तान वातुन सुरवात फोगवाय हे, एने तान सेवोट दुखान गांडायपोणा ईथे। <verse eid="ECC 10:13" /><verse number="14" style="v" sid="ECC 10:14" />फोगो माणुह जुलूम वातु वोड़ावीन किथे, तीबी</para>
  <para style="p" vid="ECC 10:14">कुण नाह जाणेत काय बोविश्याम काय एण्यो हे, एने कुण केय सिकेह काय तान बाद काय एय।<verse eid="ECC 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 10:15" />फोगान मेहनेत ताह लेवाड़ दिथे ओलीक काय तो नाह जाणेत काय, गाव किहीक जाव।<verse eid="ECC 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 10:16" />एय देस, तार पोर हाय! केदी तारो राजा सेवक हे; एने तारा आदिकारी वेगाच खाणेन सुरवात केरतेह, ते ओली खाराब देशा। <verse eid="ECC 10:16" /><verse number="17" style="v" sid="ECC 10:17" />एय देस, तु बोरकेतवालो हे, काहाकाय तारो राजो हाजी वोचीन हे; एने तारा आदिकारी ठिक टेम पोर ताकेत वोड़ावणेन केरता खाणो खातेह, साकवाला एणेन केरता नाह।<verse eid="ECC 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 10:18" />जेवी तु कोवल्या चालनेन आलहाय किरहे ताहार पाणी गेल्यी, एने गेर गेलने से तान गेर ओदरी जाय।<verse eid="ECC 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ECC 10:19" />खाणो आहताय खुसीन केरता बाणावाय जाथे, एने अंगुरान रूहा केरीन जीवणाह खुसी जुड़ेह; एने पोयशा केरीन आखो सापड़ी जाथे।<verse eid="ECC 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ECC 10:20" />तु राजाह मोना माय बी हाराप मा दिहे एने तारा गेरा माय मालदार माणहाह बी हाराप मा दिहे; काहाकाय जुगान चिड़ो तारा बोलाह लेन उड़ी, एने उड़नार चिड़ा ती वातीह देखाड़ देती।<verse eid="ECC 10:20" /></para>
  <chapter eid="ECC 10" />
  <chapter number="11" style="c" sid="ECC 11" />
  <para style="s">एकलीदार माणहान सोबाव</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 11:1" />तारो रूटो पाण्यान उपेर टाक दे, काहाकाय जुलूम दिह्यान बाद तुवाह तो पोशो जुड़ी। <verse eid="ECC 11:1" /><verse number="2" style="v" sid="ECC 11:2" />सात नाह पुण आठ माणहाह बी वाट दे, काहाकाय तु नाह जाणेत; काय ज्यी देरती पोर कुलबुखे तार पोर पिड़ा आव पोड़ी।<verse eid="ECC 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 11:3" />केदी वादला पाण्या केरीन बोराय रेनाह, ताहार ता सोता बुई पोर पाणी पाड़ती; एने जाड़ केदी देक्षिणान उगे पोड़ी नाहते उत्तर उगे पोड़ी, जाड़ जा जागा पोर पोड़ी, तो तास पोड़ रेय। <verse eid="ECC 11:3" /><verse number="4" style="v" sid="ECC 11:4" />जो किरसाण वाराह देखते रिथे, तो बिज पेर नाय सेकी; एने जो वादलाह देखते रेय, तो कामाय काट नाह सिकेत। <verse eid="ECC 11:4" /><verse number="5" style="v" sid="ECC 11:5" />जीहे वारो कारीन आवेह ज्य तुवाह मालुम नाह, एने किहीक आईख ने पेटाम सोरान सेरीर वोड़ेह; तिहेच केरीन तु बोगवानान काम नाह जाणेत, जो आखाह बाणावीह। <verse eid="ECC 11:5" /><verse number="6" style="v" sid="ECC 11:6" />वेगोच तारो बिज पेरने सुरवात केर, एने हांज पोर बी तारा आथ मा रूके; एने काम केरते रे, काहाकाय तु नाह जाणेत काय तुवाह काल्ला कामा माय फायदो जुड़ी, ज्या कामाम नाहते ता कामाम, नाहते दुयू माय।<verse eid="ECC 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 11:7" />दिह्यान उजोड़ हाजो लागेह, एने दोपाह देखणे से डोलाह हुक जुड़ेह। <verse eid="ECC 11:7" /><verse number="8" style="v" sid="ECC 11:8" />केदी माणुह जुलूम वोरह्या वोर जीवतालो रिथे, ताहार तो तान जीवायीम आखा वोरह्या माय खुस रेय; पुण तो एर मिले काय आंदारलान दिह बी कोम नाय एती। जो काय ईथे, तो कायच कामान नाह।<verse eid="ECC 11:8" /></para>
  <para style="s">जुवान्याह सेला</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 11:9" />एय जुवान, तारी जुवानी माय मोंज केर, एने तारी जुवानीन दिह्याम खुस रे; तारी मोनमानी केर, एने तारा डोलान इच्छा पारमाणे चाल। पुण तु ज्य जाण ले काय आखी वातु माय बोगवान तारी नियाव केरी।<verse eid="ECC 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 11:10" />तारा मोनाम रेन राग सिटो केर, एने बुरायीह तारा सेरीरा पोर रेन उतारीन जुगार दे; काहाकाय सोरापोणा एने जुवानी दुयू कायच कामान नाह सोती।<verse eid="ECC 11:10" /></para>
  <chapter eid="ECC 11" />
  <chapter number="12" style="c" sid="ECC 12" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 12:1" />तारी जुवानीन दिह्या माय तुवाह बाणावनाराह एर केर, न्याह रेन पेल काय पिढान दिह एने ता वोरह्या आवा, जा माय तु ज्य किहे, “न्या माय मारो मोन नाह लागेत।” <verse eid="ECC 12:1" /><verse number="2" style="v" sid="ECC 12:2" />ता दिह्याम तार केरता दिह एने उजालो, चांद एने चांदण्या आंदारला एय जाती, पाणी बोरायेल वादेल बुयी पोर पाणी पाड़ीन जात रेती। <verse eid="ECC 12:2" /><verse number="3" style="v" sid="ECC 12:3" />ता दिह्याम गेरान राखवाल्या कापणे बाज जाती एने ताकेतवोर माणहे जुकती, एने तारा दात कोम रेणे से रूटो चावणेन सोड़ देती, एने खिड़की माय रेन देखणारे डोला आंदला एय जाती। <verse eid="ECC 12:3" /><verse number="4" style="v" sid="ECC 12:4" />तेवी ती टेम माय सेड़कीन आवाज तुमरा कानाह होमलाय नाय एने देलन्यी चेकीन आवाज कोम एय जाय; तेवी माणुह चिड़ान आवाज होमलीन उठ बोही, एने आखा गीतान आवाज बोंद एय जाय। <verse eid="ECC 12:4" /><verse number="5" style="v" sid="ECC 12:5" />थोड़ीस उचाय पोर चेड़ने से तुवाह बिय आवी, एने वाटी पोर वाली वोस्तु से बिय आवी; तेवी बादामान जाड़ फुली, एने टिड्यान बी वोजेन बारो लागी एने बुख मिटाड़णार फोल पोशो काम नाय देय। काहाकाय माणुह तान कायेमान गेर जाय, एने रेड़न्या, दुख माणावणारे माणहे वाटे वाटे फिरती। <verse eid="ECC 12:5" /><verse number="6" style="v" sid="ECC 12:6" />ती टेम चांदीन तार दुय टुकड़ा एय जाय, एने होनान वाटको फुट जाय; एने जिरा हेऱ्य गुंडो फुट जाय, एने कुवा हेऱ्य फिटकिरो टुट जाय। <verse eid="ECC 12:6" /><verse number="7" style="v" sid="ECC 12:7" />तेवी माटड्यो माटड्या माय मिलाय जाय, एने जीव बोगवाना फाय जो ताह आपेल जात रेय।<verse eid="ECC 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 12:8" />मास्तेर किथे, आखो कायच कामान नाह; कायच कामान नाह, खेरीच आखो कायच कामान नाह सोतो।<verse eid="ECC 12:8" /></para>
  <para style="s">माणहान आखो काम</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 12:9" />मास्तेर जो एकलीदार इतो, तो माणहाह एकलीन वातु बी हिकाड़ते रिनो; एने तो हासकेरीन जाची पारखीन जुलूम होवटा हिक आपणारे वचन आरवेल मिलेल हे। <verse eid="ECC 12:9" /><verse number="10" style="v" sid="ECC 12:10" />मास्तेर पोटे ओहला सोबदा होद्यो, एने खेरायीन हिकवोण आपणारे वचन लिख्यो। <verse eid="ECC 12:10" /><verse number="11" style="v" sid="ECC 12:11" />एकलीदारान वातु आरीवाला डेंगान गेत रिथे, एने पोंचान मुखीन बोल हास केरीन ठुकेल खिलान गेत हे, काहाकाय न्याह हिकाड़णार एकुच गोवाल हे।<verse eid="ECC 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 12:12" />एय मारा सोरा, न्यान सावाय दिहरी हिकवोणीन बाराम चेकचिल्यो रिज्ये, जुलूम पुस्तेक लेखणेन काम निवरेत नाह; एने पुस्तेकाह जादा वाचणे बी सेरीराह लेवाड़ दिथे।<verse eid="ECC 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 12:13" />जो काय तुमू होमल्या, ती सेवली वात ज्यी हे काय तुमू बोगवानाह बिवो एने तान उकुमान पालेन किरो; काहाकाय माणहान आखो काम ज्योस हे। <verse eid="ECC 12:13" /><verse number="14" style="v" sid="ECC 12:14" />बोगवान माणहान एकेक कामाह, एने तान सोब लिकायेल वातुन, केदी त्यु हाज्यु एती नाहते बाकत्यु; नियावान दिह देखाड़ी।<verse eid="ECC 12:14" /></para>
  <chapter eid="ECC 12" />
</usx>