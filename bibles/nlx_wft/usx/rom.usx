<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ROM" style="id">- Nahali</book>
  <para style="h">रोमीयो</para>
  <para style="toc3">रोमीयो</para>
  <para style="toc2">रोमीयो</para>
  <para style="toc1">रोमीयो पौलुस लिखेल पोत्रो</para>
  <para style="mt2">रोमीयो पौलुस ने लिखा हुआ पत्र</para>
  <para style="mt1">रोमीयो पौलुस लिखेल पोत्रो</para>
  <para style="imt">ओलखात</para>
  <para style="ip">रोमीयोन पुस्तेक आंदास प्रेरित पौलुस 54-58 वोरह्यान विची माय यीशु मसीन जेल्मान पासाण लिखेल ईतो। पौलुस एवी वोर रोम माय नाह पुचेल ईतो, तान केरता तो ज्य पोत्र रोमवाला विश्वासीह खुबेर पोचाड़नेन केरता मुकलेल ईतो, यहुदि एने बिगेर यहुदि दुयून केरता कुरिंथीयो हेयराम रेन लिखेल ईतो, जा तो ती टेम माय रेतालो। पौलुस लिखेल काहाकाय आखा देस यीशु मसी <char style="xt"><ref loc="ROM 16:26">16:26</ref></char> पोर बुरहो एने पालेन केर सिके।</para>
  <para style="ip">रोमीयोन पुस्तेक आखी जागे आखी टेमीन विश्वासीन केरता खास पुस्तेक हे, काहाकाय साप सुतरो एने हास केरीन सोमजाड़ेल हे काय आपु यीशु मसीन सुटकारान बाराम केय सिकेह। पौलुस यीशु मसीन हाजाली खोबरीह जुनाला नेमा हिऱ्यो जुड़ेल हे। कोलाक जाणकारान मान्नो हे काय पुस्तेक माय गीत <char style="xt"><ref loc="ROM 1:16">1:16</ref></char> हे जो किथे, “हाजाली खुबेर होमलाड़ ने काय लाज नाय मिले,” काहाकाय ज्यो आखान सुटकारान केरता बोगवानान ताकेत हे तो मानेह: पेल यहुदिन केरता पासाण बिगेर यहुदिन केरता। रोमीयोन पेल्लो बाग <char style="xt"><ref loc="ROM 1-12">1–12</ref></char> दुसरो बाग <char style="xt"><ref loc="ROM 13-15">13–15</ref></char> माय विश्वासी जीवणान केरता जुलूम कियेल हे।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. पौलुस खास केरीन तान ओलखात आपीन तान पोत्रान सुरवात केरीन किथे काय तो ज्य पोत्र कुणीह लिखेह। <char style="ior"><ref loc="ROM 1:1-15">1:1-15</ref></char></para>
  <para style="io1">2. तान पासाण तो यीशु मसीन बाराम देखाड़ीन माणहान जातीन देशा एने सुटकारान बाराम लिखेह। <char style="ior"><ref loc="ROM 1:16-11:36">1:16–11:36</ref></char></para>
  <para style="io1">3. तान पासाण पौलुस विश्वासी जिवणो केरता हिक आपेल हे। <char style="ior"><ref loc="ROM 12:1-15:13">12:1–15:13</ref></char></para>
  <para style="io1">4. तो रोम वाली मोंडलीन माणहाह साबासकी आपीन रोमीयोन पोत्र निवरावेह। <char style="ior"><ref loc="ROM 16">16</ref></char></para>
  <chapter number="1" style="c" sid="ROM 1"/>
  <para style="s">नमस्‍कार</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1"/>पौलुसान उगे रेन जो मालीक यीशु मसीन पावोर हे, जाह बोगवान प्रेरित बोणनेन केरता हादाय जायेल हे, काहाकाय बोगवानान ती हाजाली खोबरीन पारचारान केरता आंगे केरायेल हे।<verse eid="ROM 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ROM 1:2"/>जान तो पेलुस रेन तान जाणकारान द्‍वारे चोखाली पुस्तेक माय लिखेल हे। <verse eid="ROM 1:2"/><verse number="3" style="v" sid="ROM 1:3"/>तान बिटोख आपणो मालीक यीशु मसीन बाराम वायदो किरेल ईतो, तो सेरीरान बावे से ते दाऊदान वोस माय रेन पायदा ईयेल; <verse eid="ROM 1:3"/><verse number="4" style="v" sid="ROM 1:4"/>एने चोखा पोणान जीवान बाव माय मुरेल माय रेन जीव उठणेन कारेण ताकेत हिऱ्यो बोगवानान बिटोख ठेरायेल हे। <verse eid="ROM 1:4"/><verse number="5" style="v" sid="ROM 1:5"/>तास ने द्‍वारा आपुह प्रेरिताई एने गीण जुड़नी काय आखा बिगेर यहुदि तान नावा पोर बुरहो केरीन तान उकुमान पालेन केरी। <verse eid="ROM 1:5"/><verse number="6" style="v" sid="ROM 1:6"/>जा माय तुमू बी बेचकायेल हेते, जाह बोगवान मालीक यीशु मसीन एणेन केरता हादाड़ाय जायेल हेते।<verse eid="ROM 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 1:7"/>ता सोबान केरता मी लेखथु, जा रोम माय जा बोगवानान मोंगाल्ला हेते, एने बोगवान ताह तान माणहे एणेन केरता हादाड़ाय जायेल हेते।</para>
  <para style="p" vid="ROM 1:7">आमरो आबोख बोगवान एने मालीक यीशु मसीन उगे रेन तुमूह गीण एने हुक जुड़ते रेय।<verse eid="ROM 1:7"/></para>
  <para style="s">दन्यवाद ने विन्ता</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8"/>पेल मी तुमरा आखान केरता यीशु मसीन द्‍वारा आपणा बोगवानान दन्यवाद केरथु, काहाकाय तुमरा बोरहान बोम आखी दुनिया माय एणे बाजरेनीह। <verse eid="ROM 1:8"/><verse number="9" style="v" sid="ROM 1:9"/>बोगवान जान सेवा मी मारा जीवा केरीन तान बेटाख ने हाजाली खोबरीन बाराम केरथु। तोस मारो पुरावो हे काय मी तुमूह किहीक जाहार ताहार एर किरते रिथे, <verse eid="ROM 1:9"/><verse number="10" style="v" sid="ROM 1:10"/>एने दाड़ीन मारी विन्ता माय जेलेम विन्ता केरथु काय बोगवानान मोरजी से तुमरे फाय आवणेन मारी यात्रा सफल एय। <verse eid="ROM 1:10"/><verse number="11" style="v" sid="ROM 1:11"/>काहाकाय मी तुमूह मिलनेन जुलूम आसा मेलथु, काय मी तुमूह एगदो आत्मिक बोरकेत आपु ताकेरीन तुमू मोजबुत बोणीन रिहो; <verse eid="ROM 1:11"/><verse number="12" style="v" sid="ROM 1:12"/>मतलब ज्य काय जेवी मी तुमरी विचीम रेह, ताहार आपु ता बोरहान द्‍वारा जो मार माय एने तुमरे माय हे, एका दिहराह प्रोत्साहन किरो।<verse eid="ROM 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 1:13"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:13 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:21">प्रेरितान काम 19:21</ref>
      </char>
    </note>मी आखा माणहान केर्जावालो हे, युनानीह बिगेर युनानीन एने हिकेलान एने अनपोड़ान। <verse eid="ROM 1:13"/><verse number="14" style="v" sid="ROM 1:14"/>मी आखा माणहान उदाऱ्यो हे, युनानीन एने बिगेर युनानीन, एने चेतुरान एने फोगान। <verse eid="ROM 1:14"/><verse number="15" style="v" sid="ROM 1:15"/>केरीन मी तुमूह बी जा रोम माय रेतेह, हाजाली खुबेर होमलावणेन जेलेम तियार हे।<verse eid="ROM 1:15"/></para>
  <para style="s">हाजाली खोबरीन ताकेत</para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:16 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 8:38">मरकुस 8:38</ref>
      </char>
    </note>काहाकाय मी हाजाली खोबरीह रेन नाह लाजवात; ज्यानकेरता काय तो एकेक बुरहो केरनारान केरता, पेल ते यहुदि उवतो बिगेर यहुदिन केरता सुटकारान केरता बोगवानान ताकेत हे। <verse eid="ROM 1:16"/><verse number="17" style="v" sid="ROM 1:17"/><note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="ft" closed="false">बोरहान द्‍वारे बोगवाना हेऱ्यो एक एणेन कारेण दुनियान; नाहते बोगवाना हेऱ्यो खेरो केराय जाणेन कारेण बोरहान द्‍वारे दुनिया माय ने।</char></note>काहाकाय हाजाली खुबेर ज्य देखाड़ेह काय बोगवान माणहाह तान प्रती हाजो किहीक बाणावीह ज्य सुरवात रेन सेवेट वोर बोरहान द्‍वारास हे। जिहकेरीन पुस्तेक माय लिखेल हे: “जो माणुह बोगवाना हेऱ्यो देरमी हे एने लायेक हे तो बोरहान द्‍वारा जीवतालो रेय।”<verse eid="ROM 1:17"/></para>
  <para style="s">माणहान जातीन पाप</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18"/>बोगवानान राग ते ता माणहान सोब ता माणहान पाप एने खाराब एने विण देरमीपोणा पोर हेरगाम रेन देखाह, काहाकाय जा खेरायीह अन्याय केरीन दाबीन मेलतेह। <verse eid="ROM 1:18"/><verse number="19" style="v" sid="ROM 1:19"/>ज्यानकेरता काय बोगवानान बाराम ने बुद्दी तान मोना माय देखाथे, काहाकाय बोगवान ता पोर देखाड़ेल हे। <verse eid="ROM 1:19"/><verse number="20" style="v" sid="ROM 1:20"/>जेवी रेन बोगवान दुनियान बाणावोट किऱ्यो तेवीह रेन तान बिगेर दिखेल गुण, जेलेमक्यी ताकेत, एने तान देवित्व, सोबाव ज्या दुयू पुरी रिती से साप देखातेह ता त्यु वोस्तुह जो बोगवान बाणायेल हे ताह ओलखी सेकतेह तानकेरता ता माणहा फाय काय बाहानो नाह। <verse eid="ROM 1:20"/><verse number="21" style="v" sid="ROM 1:21"/><note caller="+" style="x"><char style="xo" closed="false">1:21 </char><char style="xt" closed="false"><ref loc="EPH 4:17">इफिसीयो 4:17</ref>,<ref loc="EPH 4:18">18</ref></char></note>ता बोगवानाह जाणतेह पुण जो तान मान हे तो ताह नाह आपते, एने नाह दन्यवाद केरतेह। पुण तान जागे तान विचार पुरी रिती से एने तान ठाल्लो दिमाक आदारा माय बोराय जायेल हे। <verse eid="ROM 1:21"/><verse number="22" style="v" sid="ROM 1:22"/>ता सोताह बुद्दीवाला किन फोगा बोण गीया, <verse eid="ROM 1:22"/><verse number="23" style="v" sid="ROM 1:23"/>एने खेतेम नाह एणार बोगवानान बोड़ायीह खेतेम एणार माणुह, एने चीड़ा, एने चार पायवाला जेनवारे, एने लोलनारे जेन्तुन मुरतीन गेत बोदेल दिनो।<verse eid="ROM 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24"/>तानकेरता बोगवान ताह तान मोनान मोरजीन गेत खाराब पोणान केरता सोड़ दिनो काय ता आपसाम तान सेरीरान अपमान केरी। <verse eid="ROM 1:24"/><verse number="25" style="v" sid="ROM 1:25"/>काहाकाय ता बोगवानान खेरायीह बोदलीन जुठ बाणाव देना, एने बाणायेल चिजीन बोक्ती एने चाकरी केऱ्या, जाह बोगवान बाणायेल हे; नाह काय ता बाणावणारान जो कायेम बोरकेतवालो हे! आमेन।<verse eid="ROM 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 1:26"/>तानकेरता बोगवान ताह निच कामनान आथाम होप दिनो; न्या वोर काय तान बायकु बी हाजाला वेवाराह ता हेऱ्यो जो सोबावान विरोद हे, बोदेल देन्यु। <verse eid="ROM 1:26"/><verse number="27" style="v" sid="ROM 1:27"/>तिहेच केरीन एदमी बी बायकु हिऱ्यो हाजालो वेवार सोड़ीन आपसाम कामातुर एन एतखाणे बाज गीया, एने एदमी दिहरा एदम्या हेऱ्या खाराब काम केरीन तान गेलेत कामान फोल होद्या।<verse eid="ROM 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 1:28"/>काहाकाय जेवी ता बोगवानाह ओलेखणे नाह होद्या, ते बोगवान बी ताह तान खाराब मोना पोर सोड़ दिनो, जो ताह नाह केरनो एतो। <verse eid="ROM 1:28"/><verse number="29" style="v" sid="ROM 1:29"/>तानकेरता ता आखी बातीन गुनो, एने खाराब काम, लोब, कुयराय, खुन, राड़, एने कोपेट एने अन्याय केरीन पुरा बोराय गीया एने चुगली, <verse eid="ROM 1:29"/><verse number="30" style="v" sid="ROM 1:30"/><note caller="+" style="f"><char style="fr" closed="false">1:30 </char><char style="ft" closed="false">बोगवाना नफरत एय ओहलो; खाराब काम केरनार; नाहते बोगवानाह स्वीकार नाह केरती एने खाराब काम केरनारे हेते।</char></note>एने एका दिहरान बुराय केरनारे, बोगवानान चिहटा केरनारे, मोठलाय एने गोमेंड केरनारे, बुराय केरनेन केरता जुलूम वाटु होदणारे, एने आईख आबाख ने उकुम नाह मान्नारे, <verse eid="ROM 1:30"/><verse number="31" style="v" sid="ROM 1:31"/>विण बुद्दीवाला, बुरहो तोड़नारे, विण मोंगावाला एने विणदेया वाला एय गीया। <verse eid="ROM 1:31"/><verse number="32" style="v" sid="ROM 1:32"/>ता जाणतेह काय बोगवानान नेम काय किथे, जा माणहे ओहली वाटी पोर चालतेह ता मोतीन लायेक हेते, तीबी ता माणहे नाह फोक्‍तो ता कामाह केरतेह। पुण ओहला काम केरनारे माणहाह रेन खुस बी एतेह।<verse eid="ROM 1:32"/></para>
  <chapter eid="ROM 1"/>
  <chapter number="2" style="c" sid="ROM 2"/>
  <para style="s">बोगवानान नियाव</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">2:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:1">मत्ती 7:1</ref>; <ref loc="LUK 6:37">लुका 6:37</ref></char>
    </note>केरीन एय दोस लागाड़णारे, तु एगदो काहा नाय रेय, तु निरूत्तर हे; काहाकाय जी वातीम तु दिहरा पोर दोस लागाड़ेह तीस वाती माय सोताह बी दोसी ठेरावेह, ज्यानकेरता काय तु जो दोस लागाड़ेह सोतास तो काम किरेह। <verse eid="ROM 2:1"/><verse number="2" style="v" sid="ROM 2:2"/>काहाकाय आमु जाणतेह काय जा ओहला काम केरतेह, तान नियाव बोगवान खेरायीन गेत किरेह। <verse eid="ROM 2:2"/><verse number="3" style="v" sid="ROM 2:3"/>पुण एय माणुह, तु जो ओहला ओहला काम केरनारा पोर दोस लागाड़ेह एने खुद तास काम किरेह; काय ज्य सोमजेह काय तु बोगवानान डेंडान नियावाह रेन वोच जाहे? <verse eid="ROM 2:3"/><verse number="4" style="v" sid="ROM 2:4"/>काय तु तान मोटली गीण, एने सहनशीलता, एने दिरीह नेचो जाणेह? काय ज्य नाह सोमजेत काय बोगवानान गीण तुवाह मोन बोदेलनेन उगे ली जाथे? <verse eid="ROM 2:4"/><verse number="5" style="v" sid="ROM 2:5"/>पुण तु तारो काठोपोणा एने एकएट्या मोनान वोजेसे बोगवानान रागान दिह्यान केरता, जा माय बोगवानान खेरलो नियाव देखाय, सोतान उपेर डेंड लावेह। <verse eid="ROM 2:5"/><verse number="6" style="v" sid="ROM 2:6"/>बोगवान एकेकाह तान कामान गेत बुदलो आपी। <verse eid="ROM 2:6"/><verse number="7" style="v" sid="ROM 2:7"/>जो हाजाला कामान दुंद माय रेयीन बोड़ाय, मान एने कायेमान होदवाल्यो हे, ताह बोगवान जेलेमक्यी जीवाय आपी। <verse eid="ROM 2:7"/><verse number="8" style="v" sid="ROM 2:8"/>पुण जा माणहे स्वार्थी हेते एने खेरायीह नाह मानते, काहाकाय खाराब काम केर सेकती ओहला आखा माणहा पोर बोगवान तान राग टाकी। <verse eid="ROM 2:8"/><verse number="9" style="v" sid="ROM 2:9"/>पुण दुख एने तेकलीत ता माणहा पोर आवी जो बाकतो किरेह; पेल यहुदि पोर ओवतो बिगेर यहुदि पोर; <verse eid="ROM 2:9"/><verse number="10" style="v" sid="ROM 2:10"/>पुण बोगवान ता एकेक माणहाह जो हाजो काम किरेह, बोड़ाय मान एने सान्ती आपी, पेल यहुदिह एने ओवतो बिगेर यहुदिह। <verse eid="ROM 2:10"/><verse number="11" style="v" sid="ROM 2:11"/>काहाकाय बोगवान बिगेर बेदबाव माय आखान नियाव किरेह।<verse eid="ROM 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 2:12"/>बिगेर यहुदि फाय मुसान नेम ना सोतो, एने तान पापान नियाव बिगेर नेमान गेत एय। यहुदि फाय मुसान नेम हे एने तान किरेल पापान नियाव नेमान गेत एय; <verse eid="ROM 2:12"/><verse number="13" style="v" sid="ROM 2:13"/>काहाकाय बोगवानान सामने नेमाह होमेलनारे देरमी नाह, पुण नेमान पालेन केरनारे देरमी ठेराय जाती। <verse eid="ROM 2:13"/><verse number="14" style="v" sid="ROM 2:14"/>जेवी बिगेर यहुदि माणहा फाय नेम ना सोतो, पुण तीबी ता आपाप नेमा पोर चालतेह, ते तो सोता माय नेम हे, तीबी मुसान नेम ता फाय ना सोतो। <verse eid="ROM 2:14"/><verse number="15" style="v" sid="ROM 2:15"/>तान बोलनो चालनो देखाड़ेह काय नेम तान विवेक माय लेखायेल हे एने तान मोन बी ताह किथे काय ज्य खेरी हे एने ज्याह लेन तान विचार गुनेगार एने दोसी ठेरावेह। <verse eid="ROM 2:15"/><verse number="16" style="v" sid="ROM 2:16"/>ते दिह बोगवान मार पारचार किरेल हाजाली खोबरीन गेत यीशु मसीन द्‍वारा माणहान लिकायेल विचारान नियाव केरी।<verse eid="ROM 2:16"/></para>
  <para style="s">यहुदि एने नेम</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 2:17"/>केदी तु सोताह यहुदि किथे, एने नेमा पोर निर्बर रीथे, एने आपणा बोगवानान माहु गोमेंड हे। <verse eid="ROM 2:17"/><verse number="18" style="v" sid="ROM 2:18"/>एने तुवाह मालुम हे काय बोगवान तुवा फाय रेन काय केरावणे हुदेह, एने हाजाल्यु वातुह निवाड़ने तु नेमा केरीन हिकेल हे। <verse eid="ROM 2:18"/><verse number="19" style="v" sid="ROM 2:19"/>एने सोता पोर ज्यी वातीन बुरहो मिलेह काय मी आंदलान अगुवो, एने आदारलाम रेणारान केरता उजालो, <verse eid="ROM 2:19"/><verse number="20" style="v" sid="ROM 2:20"/>एने विण बुद्दी वालाह सोमजाड़नार, एने सोराह हिकाड़नार हे; एने तु पाको हे, एने खेरायीन नमुनो जो नेमाम हे, माहु जुड़ेल हे। <verse eid="ROM 2:20"/><verse number="21" style="v" sid="ROM 2:21"/>जो दिहराह हिकाड़ेह, तु खुद काहा नाह लागु किरेत? तु जो चोरी नाह केरनेन हिकवोण आपेह, काय खुद चोरी नाह किरेत? <verse eid="ROM 2:21"/><verse number="22" style="v" sid="ROM 2:22"/>तु जो किथे, “सिनालो मा किरहे,” काय सोतास सिनालो किरेह? तु जो मुरतीह विटोल मानेह, काय सोतास मोंदिराह नाह लुटेत? <verse eid="ROM 2:22"/><verse number="23" style="v" sid="ROM 2:23"/>तु जो बोगवानान नेमान बाराम गोमेंड किरेह, काय तु बोगवानान नेम नाह मानेन अपमान किरेह? <verse eid="ROM 2:23"/><verse number="24" style="v" sid="ROM 2:24"/>काहाकाय “तुमरे वोजेसे बोगवानान नावान चिहटा बिगेर यहुदिम केराय जाथे,” जिहकेरीन पुस्तेक माय लिखेल हे।<verse eid="ROM 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 2:25"/>काहाकाय केदी तु नेमान पालेन किरहे, ताहार खेतना केरीन फायदो ते हे, पुण केदी तु नेमाह नाय माने ताहार तारो खेतना बिगेर खेतनान एणेन गेत ठेरानो। <verse eid="ROM 2:25"/><verse number="26" style="v" sid="ROM 2:26"/>तानकेरता केदी बिगेर यहुदि जान खेतना नाह ईयेल सोतो तीबी नेमान पालेन किरेह ताहार काय तान बिगेर खेतनान एणेन बाद बी तो खेतनावालाम नाय गेणाय जाय? <verse eid="ROM 2:26"/><verse number="27" style="v" sid="ROM 2:27"/>एने तुमू यहुदिन बिगेर यहुदिन द्‍वारा दोसी ठेराय जाय, जो तुमरे फाय लेखायेल नेम एने तुमरो खेतना ईयेल हे; पुण बिगेर यहुदि नेमान पालेन केरतेह, जेवी काय सारिरीक रूप माय खेतना नाह ईयेल सोतो। <verse eid="ROM 2:27"/><verse number="28" style="v" sid="ROM 2:28"/>एक खेरलो यहुदि तो हे जान खेरीच खेतना ईयेल हे तो कुण हे? खेरलो यहुदि तो नाह जो निस्तो बाहेरल्या वेहा माय यहुदि हे, जान खेतना निस्तो सारिरीक हे। <verse eid="ROM 2:28"/><verse number="29" style="v" sid="ROM 2:29"/>पुण खेरलो यहुदि तोस हे जो माय रेन यहुदि हे; जान मोन से खेतना ईयेल हे। एने ज्य बोगवानान जीवान काम हे, नाह काय लेखायेल नेमा केरीन; ओहला माणहे बोगवानान उगे रेन बोड़ाय सापड़ावी नाह काय माणहान उगे रेन।<verse eid="ROM 2:29"/></para>
  <chapter eid="ROM 2"/>
  <chapter number="3" style="c" sid="ROM 3"/>
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1"/>तानकेरता बिगेर यहुदिन सामने तुमरो यहुदि एणेन काय बोड़ाय? एने तुमरा खेतनान काय फायदो? <verse eid="ROM 3:1"/><verse number="2" style="v" sid="ROM 3:2"/>आखी बातीन जुलूम काय। पेल्लो ते ज्य काय बोगवानान बोरहावालो वचन यहुदिह होपाय जायेल। <verse eid="ROM 3:2"/><verse number="3" style="v" sid="ROM 3:3"/>केदी थोड़ाक माणहे बुरहो नाह बी केऱ्या ते काय एनो? काय तान अविश्वास बोगवानान खेरायीह फालतुक ठेरावी? <verse eid="ROM 3:3"/><verse number="4" style="v" sid="ROM 3:4"/>केदिस नाह! पुण बोगवान खेरलो एने एकेक माणुह जुठो ठेराय, पुस्तेक माय लिखेल हे,</para>
  <para style="m" vid="ROM 3:4">“जाकेरीन तु तारी वातु माय खीरलो एने न्यायी ठेराय सिकेह,</para>
  <para style="m" vid="ROM 3:4">एने नियाव केरने बुखेत तुवाह जिक जुड़ी।”<verse eid="ROM 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 3:5"/>तानकेरता केदी आमरो खाराब काम बोगवानान देरमीपोणा ठेराव दिथे, ते आमु काय किज्यो? काय ज्य काय बोगवान जो राग किरेह अन्‍यायी हे? ज्य ते मी माणहान रितीन गेत केथु। <verse eid="ROM 3:5"/><verse number="6" style="v" sid="ROM 3:6"/>केदिस नाह! नाह ते बोगवान दुनियान नियाव किहीक केरी?<verse eid="ROM 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 3:7"/>केदी मारा जुठान वोजेसे बोगवानान खेराय तान बोड़ाय ने केरता उंजु बी वोदार देखानो, ताहार ओवतो काहा पापी माणहान गेत मी नियावान केरता ठेराय जाथु? <verse eid="ROM 3:7"/><verse number="8" style="v" sid="ROM 3:8"/>“आपु काहा बुराय नाय किरज्‍यो काय बोलाय निकले?” जीहे काय आमु पोर जुठो आरोप लागाड़ाय बी जाथे, एने थोड़ाक माणहे केतेह काय न्यान ज्योस केणो हे। पुण ओहलान आरोप लागाड़नो ठिक हे।<verse eid="ROM 3:8"/></para>
  <para style="s">कुण देरमी नाह</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">3:9 </char>
      <char style="ft" closed="false">बिगेर यहुदि माय रेन हाजी देशा माय; बिलकुर नाह! बिगेर यहुदि खाराब देशा मा; पुरो नाह।</char>
    </note>ताहार ओवतो काय एनो? काय आपु यहुदि ताह रेन हाजा हेते? केदिस नाह; काहाकाय आपु यहुदि एने बिगेर यहुदि दुयू पोर ज्यो दोस लागाड़ दियेल हेते काय ता आखान आखा पापान काबाम हेते। <verse eid="ROM 3:9"/><verse number="10" style="v" sid="ROM 3:10"/>पुस्तेक माय इहकेरीन लिखेल हे: “कुण देरमी नाह, एक बी नाह। <verse eid="ROM 3:10"/><verse number="11" style="v" sid="ROM 3:11"/>कुण ईकेलवालो नाह; कुण बोगवानाह होदणार नाह। <verse eid="ROM 3:11"/><verse number="12" style="v" sid="ROM 3:12"/>आखा बोगवानाह रेन बोटकी जायेल हेते, आखान आखा उगार बोण जायेल हेते; कुण बोलाय केरनार नाह, एक बी नाह। <verse eid="ROM 3:12"/><verse number="13" style="v" sid="ROM 3:13"/>तान गिलो उगाड़लो माहेण हे, ता तान जीब्यु केरीन कोपेट किरेल हेते, तान ओठा माय गेड़हान जेहेर हे। <verse eid="ROM 3:13"/><verse number="14" style="v" sid="ROM 3:14"/>तान मुय हाराप एने खाराबपोणा केरीन बोरायेल हे। <verse eid="ROM 3:14"/><verse number="15" style="v" sid="ROM 3:15"/>तान पाय लुय वोयाड़ने केरता उतवाल्यास एय जायेल हेते, <verse eid="ROM 3:15"/><verse number="16" style="v" sid="ROM 3:16"/>तान वाटी माय खेतेम एने पिड़ा हे। <verse eid="ROM 3:16"/><verse number="17" style="v" sid="ROM 3:17"/>ता सान्तीन वाट ओलख्या नाह। <verse eid="ROM 3:17"/><verse number="18" style="v" sid="ROM 3:18"/>तान डोलान सामने बोगवानान बिय नाह।”<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="ft" closed="false">बजन 36:1 </char></note> <verse eid="ROM 3:18"/><verse number="19" style="v" sid="ROM 3:19"/>आमु जाणतेह काय नेम जो काय किथे ताहास किथे, जो नेमान काबाम हे; ज्यानकेरता काय एकेक मुय बोंद केराय जाय एने आखी दुनिया बोगवानान नियावान लायकी ठेराय; <verse eid="ROM 3:19"/><verse number="20" style="v" sid="ROM 3:20"/><note caller="+" style="x"><char style="xo" closed="false">3:20 </char><char style="xt" closed="false"><ref loc="GAL 2:16">गलातीयो 2:16</ref></char></note>काहाकाय नेमान कामा केरीन कुण बी माणुह बोगवानान सामने देरमी नाय ठेराय, ज्यानकेरता काय नेमान द्‍वारा पापान ओलखात ईथे।<verse eid="ROM 3:20"/></para>
  <para style="s">बोरहान द्‍वारा देरमीपोणा</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21"/>पुण एवी नेमाह रेन आंगे बोगवानान तो देरमीपोणा देखायेल हे, जान गोवाय मुसान नेम एने जाणाव केरनार देतेह। <verse eid="ROM 3:21"/><verse number="22" style="v" sid="ROM 3:22"/><note caller="+" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="GAL 2:16">गलातीयो 2:16</ref></char></note>मतलब बोगवानान तो देरमीपोणा जो यीशु मसी पोर बुरहो केरनेन द्‍वारा जुड़ेह तो आखा बुरहो केरनारान केरता हे, ता माय काय फारेक नाह। <verse eid="ROM 3:22"/><verse number="23" style="v" sid="ROM 3:23"/>ज्यानकेरता काय आखा माणहे पाप किरेल हेते एने बोगवानान बोड़ायीह रेन सेटा हेते, <verse eid="ROM 3:23"/><verse number="24" style="v" sid="ROM 3:24"/>पुण तान गीणी केरीन ता सुटकारान द्‍वारा जो यीशु मसीम हे, आखान आखा फुकेट माय देरमी ठेराय जातेह। <verse eid="ROM 3:24"/><verse number="25" style="v" sid="ROM 3:25"/><note caller="+" style="f"><char style="fr" closed="false">3:25 </char><char style="ft" closed="false">तान लुय केरीन; नाहते तान सोतान अर्पण किरेल मोत से।</char></note>यीशुह बोगवान तास ने लुयीम बोरहान द्‍वारा ओहलो प्रायश्‍चित बोली ठेरायो, जो बुरहो केरने से कार्यकारी ईथे, काय जा पाप पेल केराय गीया; एने जा पोर बोगवान तान सहनशीलता माय विहराव दिनो। तान बाराम तो तान देरमी पोणाह देखाड़ी। <verse eid="ROM 3:25"/><verse number="26" style="v" sid="ROM 3:26"/>पुण ज्‍यीस टेम तान देरमीपोणा देखाय काय जाकेरीन तो सोताच देरमी ठेराय, एने जो यीशु पोर बुरहो केरी तान बी देरमी ठेरावणार जुवे।<verse eid="ROM 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 3:27"/>ताहार गोमेंड केरने काहरी हे? एने ज्यान गोमेंड केरनेन कारेण काय हे, नेमान पालेन केरने काय ज्य नाह सोतो? पुण ता पोर बुरहो केरने। <verse eid="ROM 3:27"/><verse number="28" style="v" sid="ROM 3:28"/>तानकेरता आपु ज्या परिणाम पोर पोचतेह काय माणुह बोगवाना पोर बुरहो केरनेन द्‍वारा देरमी ठेराय जाथे, नाह काय कायदो पालेन केरनेन द्‍वारा। <verse eid="ROM 3:28"/><verse number="29" style="v" sid="ROM 3:29"/>काय बोगवान फोक्‍तो यहुदिस ने हे? काय तो बिगेर यहुदिन बोगवान नाह? होव, बिगेर यहुदिन बी बोगवान हे। <verse eid="ROM 3:29"/><verse number="30" style="v" sid="ROM 3:30"/><note caller="+" style="x"><char style="xo" closed="false">3:30 </char><char style="xt" closed="false"><ref loc="GAL 3:20">गलातीयो 3:20</ref></char></note>काहाकाय बोगवान एकुस हे, एने तो यहुदिह बोरहा केरीन एने बिगेर यहुदिह बी बोरहान द्‍वारा देरमी ठेरावी। <verse eid="ROM 3:30"/><verse number="31" style="v" sid="ROM 3:31"/>ताहार ओवता काय आपु नेमाह बोरहान द्‍वारा बिगेर कामान ठेरावतेह? केदिस नाह! पुण बोरहान द्‍वारा नेमाह मोजबुत केरतेह।<verse eid="ROM 3:31"/></para>
  <chapter eid="ROM 3"/>
  <chapter number="4" style="c" sid="ROM 4"/>
  <para style="s">अब्राहामान उदारण</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1"/>तानकेरता आपु काय किज्यो? एने आपणा डावाला आबाख अब्राहामाह काय सापड़ेल? <verse eid="ROM 4:1"/><verse number="2" style="v" sid="ROM 4:2"/>काहाकाय केदी अब्राहाम कामा द्‍वारे देरमी ठेराय जातो, ताहार ताह गोमेंड केरनेन काह बाहानो रेतो, पुण बोगवानान नेजरीम नाह। <verse eid="ROM 4:2"/><verse number="3" style="v" sid="ROM 4:3"/><note caller="+" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="GAL 3:6">गलातीयो 3:6</ref></char></note>पुस्तेक काय किथे? ज्य काय “अब्राहाम बोगवाना पोर बुरहो किरेल, एने ज्य तान बोरहान कारेण ताह देरमी ठेरायेल।” <verse eid="ROM 4:3"/><verse number="4" style="v" sid="ROM 4:4"/>काम केरनाराह मोंजरी आपणे ईनाम नाह; पुण आदिकार मानाय जाथे। <verse eid="ROM 4:4"/><verse number="5" style="v" sid="ROM 4:5"/>पुण जो बोरहा पोर निर्बय रीथे नाह काय कामा माय एने बोगवाना पोर बुरहो किरेह जो नाह किरेत, पुण ता पोर बुरहो किरेह जो विणबोक्ती देरमी ठेरावेह, तान ज्योच बुरहो देरमीपोणान कारेण बोण जाथे। <verse eid="ROM 4:5"/><verse number="6" style="v" sid="ROM 4:6"/>जा माणहाह बोगवान कामा बिगेर देरमी ठेरावेह, ताह दाऊद बी बोरकेतवालो किथे: <verse eid="ROM 4:6"/><verse number="7" style="v" sid="ROM 4:7"/>“बोरकेतवाला हेते जान गुना माफ एना, एने जान पाप डापाय गीया। <verse eid="ROM 4:7"/><verse number="8" style="v" sid="ROM 4:8"/>बोरकेतवालो हे तो माणुह जान पापान ईसाब बोगवान नाय लेय।”<verse eid="ROM 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 4:9"/>जी बोरकेतवाली वात दाऊद केणे बाजरिनोह, काय ती खेतना वालान केरता ओलीस हे? नाह ती बिगेर खेतना वालान केरता बी काहाकाय आमु केतेह, “अब्राहाम बोगवाना पोर बुरहो किऱ्यो एने तान बोरहान वोजेसे बोगवान स्वीकार किऱ्यो।” <verse eid="ROM 4:9"/><verse number="10" style="v" sid="ROM 4:10"/>तो ज्यो कुलबुखे ईयेल काय तान खेतना एय जायेल तो नाह खेतान ईयेल केरीन नाह पुण किहीक गेणाय गीयो? खेतनान देशा माय काय बिगेर खेतनान देशा माय? खेतनान देशा माय नाह पुण बिगेर खेतनान देशा माय। <verse eid="ROM 4:10"/><verse number="11" style="v" sid="ROM 4:11"/>एने तान खेतनान एणेन ती एक निसाणी बोणनी काहाकाय देखाड़ सेकी, अब्राहाम आखा विश्वासीन आत्मिक आबोख बोणनो तानकेरता ता बी देरमी गेणाय जाती पोर सिक्को लाग जाय जो तान बिगेर खेतनान देशाम मीलेल ईतो, जाकेरीन तो ता आखान आबोख ठेराय जा बिगेर खेतनान देशाम बुरहो केरतेह काहाकाय ता बी देरमी ठेराती; <verse eid="ROM 4:11"/><verse number="12" style="v" sid="ROM 4:12"/>एने तो तान बी आबोख हे जान खेतना ईयेल हे, काहाकाय ता माणहे फोक्‍तो खेतनावालास नाह एता, पुण आमरा आबाख अब्राहामान बोरहान पद निसाणी पोर चालनारे एता, तो अब्राहाम जो खेतना एणेन पेल चालनो।<verse eid="ROM 4:12"/></para>
  <para style="s">बोरहान द्‍वारा बोगवानान वायदो जुड़नो</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 4:13"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:13 </char>
      <char style="xt" closed="false">
        <ref loc="GAL 3:29">गलातीयो 3:29</ref>
      </char>
    </note>जेवी बोगवान अब्राहाम एने तान वोचीह वायदो किऱ्यो काय दुनियान वारीस एती, जो वायदो नेमान पालेन केरनेन द्‍वारा नाह जुड़नो, पुण तो बुरहो किऱ्यो एने तो बोगवानान द्‍वारा देरमी ठेराय गीयो। <verse eid="ROM 4:13"/><verse number="14" style="v" sid="ROM 4:14"/><note caller="+" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="GAL 3:18">गलातीयो 3:18</ref></char></note>तानकेरता केदी तुमू मानतेह काय बोगवान आपेल वायदो जो नेमान पालेन केरनाराह जुड़नो, ताहार तुमरो बुरहो कामान नाह, एने बोगवानान वायदो बी बेकार एय जाथे। <verse eid="ROM 4:14"/><verse number="15" style="v" sid="ROM 4:15"/>नेमा केरीन बोगवानान राग देखाह, एने पायदा किरेह, एने जाहरी नेम नाह ताहरी तान टालनो बी नाह।<verse eid="ROM 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 4:16"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:16 </char>
      <char style="xt" closed="false">
        <ref loc="GAL 3:7">गलातीयो 3:7</ref>
      </char>
    </note>ज्यास ने केरता वायदो बोरहा माय आदारीत बोगवानान फुकेट बेट हे, ज्य फोक्‍तो नेमान पालेन केरनारान नाह, पुण तानकेरता बी जा बुरहो केरतेह जिहकेरीन अब्राहाम बुरहो किऱ्यो। काहाकाय अब्राहाम आपु आखान आत्मिक आबोख हे। <verse eid="ROM 4:16"/><verse number="17" style="v" sid="ROM 4:17"/>जिहकेरीन पुस्तेक माय लिखेल हे, “मी तुवाह जुलूम देसान आबोख ठेरायेल हे,” एने ज्यो वायदो बोगवानान नेजरीम हाजो हे। ज्यो तो बोगवान हे जा पोर अब्राहाम बुरहो किऱ्यो एने जो मुरेल माणहाह जीवाड़ेह, एने जो बोगवान अस्तित्वरहीत वातु तान उकुमा केरीन अस्तित्व माय लावेह। <verse eid="ROM 4:17"/><verse number="18" style="v" sid="ROM 4:18"/>जिहकेरीन वचन माय लिखेल हे तु जुलूम देसान आबोख बोणहे एने तारा वोच चांदण्यान गेत एती ज्यी वाती पोर आसा मेलनेन काय कारेण नाह एतो, तीबी अब्राहाम बुरहो एने आसा मिल्यो। अब्राहाम नाराज माय बी आसा मेलीन बुरहो किऱ्यो, ज्यानकेरता काय तान गेत जो केवाय जायेल एतो, “तारो वोस ओहलो एय,” तो जुलूम होवट्यु जातीन आबोख एय। <verse eid="ROM 4:18"/><verse number="19" style="v" sid="ROM 4:19"/>काहाकाय तो कोमीत कोमी होव वोरह्यान एय जायेल ईतो पुण तान बुरहो तान सेरीरान गेत कोमजोर नाह ईयेल ईतो जिहकेरीन तान सेरीर कोमजोर एय जायेल ईतो एने खेराय ज्यी बी हे सारा वांज एती। <verse eid="ROM 4:19"/><verse number="20" style="v" sid="ROM 4:20"/>तीबी तो तान बुरहो नाह सोड्यो एने नाह बोगवानान वायदा पोर सेंका किऱ्यो एने तान बोरहाम ताकेत माय बोरानो अविश्वासी बोणीन बोगवानान वायदा पोर सेंका नाह किऱ्यो, पुण बोरहा माय मोजबुत एन बोगवानान बोड़ाय किऱ्यो; <verse eid="ROM 4:20"/><verse number="21" style="v" sid="ROM 4:21"/>एने ताह पाको बुरहो ईतो काय बोगवान किऱ्यो काय जी वातीन बोगवान वायदो किरेल हे, तो ताह पुरो केरने माय बी ताकेतवोर हे। <verse eid="ROM 4:21"/><verse number="22" style="v" sid="ROM 4:22"/>तानकेरता बोगवान अब्राहामाह तान बोरहान द्‍वारा देरमी ठेरायो, ज्य तानकेरता देरमी पोण गेणाय गीयो। <verse eid="ROM 4:22"/><verse number="23" style="v" sid="ROM 4:23"/>एने ज्य वचन, “बोरहान द्‍वारा देरमी ठेरानो फोक्‍तो तान एखालास ने केरता नाह लेखानो।” <verse eid="ROM 4:23"/><verse number="24" style="v" sid="ROM 4:24"/>ज्य आपणी केरता बी लेखायेल जा आपु आपणी केरता बी ज्यानकेरता बुरहो देरमी पोण गेणाय जाय, मतलब आपणी केरता जा ता पोर बुरहो केरतेह जो आपणो मालीक यीशुह मुरेल माय रेन जीवाड्यो। <verse eid="ROM 4:24"/><verse number="25" style="v" sid="ROM 4:25"/>काहाकाय यीशु आपणा गुनान केरता देराय गीयो, एने आपु देरमी ठेराणेन केरता जीव बी उठनो।<verse eid="ROM 4:25"/></para>
  <chapter eid="ROM 4"/>
  <chapter number="5" style="c" sid="ROM 5"/>
  <para style="s">बोगवाना हेऱ्यो मेल</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">5:1 </char>
      <char style="ft" closed="false">आमरी फाय हे; थोड़ाक लेख माय आमुह जुड़ने दियेल।</char>
    </note>एवी जा आपु आपणा बोरहान कारेण बोगवानान नेजरीम देरमी एय जायेल हेते, ते आमरा मालीक यीशुन कारेण बोगवान आमरे विच माय सान्ती ईयेल हे, केरीन जेवी आपु बोरहा केरीन देरमी ठेराना, ते आपणा मालीक यीशु मसीन द्‍वारा बोगवाना हेऱ्या मेल राखी, <verse eid="ROM 5:1"/><verse number="2" style="v" sid="ROM 5:2"/><note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">आमु बोड़ाय केरतेह; नाहते आमु बोड़ाय केरी।</char></note>एने एवी तास ने द्‍वारे बोरहान कारेण आमु बोगवानान गीणीम जीवाय जिवतेह। एने आमु ती आसा पोर मोठलाय केरतेह जी आसा बोगवानान बोड़ाय हेऱ्या बेचकानाह। <verse eid="ROM 5:2"/><verse number="3" style="v" sid="ROM 5:3"/><note caller="+" style="f"><char style="fr" closed="false">5:3 </char><char style="ft" closed="false">आमु बी बोड़ाय केरतेह; नाहते आमु बी बोड़ाय केरी। </char></note>ओलोस नाह पुण आमु आमरी विपत्ती पोर बी मोठलाय केरतेह, काहाकाय आमुह मालुम हे आमरी विपत्ती दिरीह पायदा किरेह। <verse eid="ROM 5:3"/><verse number="4" style="v" sid="ROM 5:4"/>एने दिरी केरीन पारखायेल सोबाव खेरलो निकेलने, एने खेरला निकेलने से आसा बुणेह; <verse eid="ROM 5:4"/><verse number="5" style="v" sid="ROM 5:5"/>एने जी आसा आमुह नाराज नाह किरेत काहाकाय बोगवान तान मोंग आमरा मोनाम टाकेल हे मतलब चोखालो जीव जो बोगवानान बोकसीस आमरी केरता हे।<verse eid="ROM 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 5:6"/>काहाकाय जेवी आपु बिगेर आसान एता कोमजोरूस एता, तेवी मसी ठिक टेम पोर विणबोकत्यान केरता मोरनो। <verse eid="ROM 5:6"/><verse number="7" style="v" sid="ROM 5:7"/>एगदा देरमी माणहान केरता एगदो मोरी, ज्य ते सम्बव नाह सोतो; पुण एय सिकेह एगदा हाजाला माणहान केरता एगदो मोरनेन बी कोसीत केरी। <verse eid="ROM 5:7"/><verse number="8" style="v" sid="ROM 5:8"/>पुण बोगवान आपु पोर तान मोंगान बोलाय इहकेरीन देखाड़ेह काय जेवी आपु पापीस एता, तेवी मसी आपणी केरता मुरनो। <verse eid="ROM 5:8"/><verse number="9" style="v" sid="ROM 5:9"/><note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="ft" closed="false">तान लुय केरीन; नाहते तान सोतान अर्पण ने मोत केरीन।</char></note>केरीन जेवी काय आपु यीशुन लुयीन वोजेसे देरमी ठेराना, ताहार तान द्‍वारा बोगवानान रागाम रेन काहा नाय वोचहु? <verse eid="ROM 5:9"/><verse number="10" style="v" sid="ROM 5:10"/>जेवी आपु बोगवानान दुसमोन एता पुण बोगवान तान बेटाख ने मोतीन द्‍वारा आपणे हेऱ्यो मेल केरायो। पुण जेवी आपु बोगवानान दोस्तीदार हेते ताहार मसीन जीवायीन द्‍वारा जुलूम होवटी आपणी देखरेत केरी। <verse eid="ROM 5:10"/><verse number="11" style="v" sid="ROM 5:11"/>फोक्‍तो ज्योस नाह, पुण आपु आपणो मालीक यीशु मसीन द्‍वारा, जान द्‍वारा आमरो मेल ईयेल हे, बोगवानाम खुस एतेह।<verse eid="ROM 5:11"/></para>
  <para style="s">आदम माय मोत मसीन द्‍वारा जीवाय</para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12"/>तानकेरता जिहकेरीन एक माणहान द्‍वारा पाप दुनियाम आवो, एने पापान द्‍वारा मोत आवी। एने इहकेरीन मोत आखा माणहा माय पोसरी गियी, काहाकाय आखा पाप केऱ्या। <verse eid="ROM 5:12"/><verse number="13" style="v" sid="ROM 5:13"/>नेमाह आपाणेन पेल पाप दुनियाम ते ईतो; पुण जाहरी नेम नाह ताहरी पाप गेणाय नाह जात। <verse eid="ROM 5:13"/><verse number="14" style="v" sid="ROM 5:14"/>तीबी आदम रेन ते मुसा वोर मोत ता माणहा पोर बी राज किऱ्यो, तीबी ता माणहे आदम ने गेत उकुमान टाल्लेन नाह केऱ्या पोर पुण विची माय पायदा ईयेल माणहा पोर ता पोर जा आदम ने गुनान गेत पाप नाह किरेल एता; आदम तान निसाणी ईतो।</para>
  <para style="p" vid="ROM 5:14">जो आवण्यो ईतो। <verse eid="ROM 5:14"/><verse number="15" style="v" sid="ROM 5:15"/>पुण जोहली गुनान देशा हे, तोहली गीणीन वरदान ने नाह। काहाकाय जेवी आदम ने गुनान वोजेसे जुलूम माणहे मोरना, ते बोगवानान गीण एने तान जो वरदान एक माणहान, मतलब यीशु मसीन गीणी केरीन एनो, जुलूम होवटा माणहा पोर एकवार्‍योस एनो। <verse eid="ROM 5:15"/><verse number="16" style="v" sid="ROM 5:16"/>एने बोगवानान वरदान एने बेट ज्या दुयू माय फारेक हे पुण जुलूम होवटा पापान वोजेसे एने निर्दोस एणेन बाद तान गेत नाह, जो एक माणहान चिहटा केरनेन द्‍वारा आवो। काहाकाय एकास ने पापान वोजेसे डेंडान उकुमान फेसलो ईनो, पुण जुलूम होवटा पापान गुनान वोजेसे ओहलो वरदान बोणनो काय माणहे देरमी ठेराती। <verse eid="ROM 5:16"/><verse number="17" style="v" sid="ROM 5:17"/>काहाकाय जेवी एक माणहान पापान वोजेसे मोत एकास ने द्‍वारा राज केर्‍यी, ते जा माणहे गीण एने देरमीपोणान वरदान एकवार्‍यास सापड़ावतेह, ता एकुस यीशु मसीन द्‍वारा जेलेमकी जीवाय माय राज केरहु।<verse eid="ROM 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 5:18"/>तानकेरता जिहकेरीन एक गुनो आखा माणहान केरता डेंडान उकुमान वोजेसे एनो, तिहेच केरीन एक देरमान काम बी आखा माणहाह सोड़वेह एने जीवाय आपेह। <verse eid="ROM 5:18"/><verse number="19" style="v" sid="ROM 5:19"/>काहाकाय जिहकेरीन एक माणहाह उकुम नाह मान्ने से जुलूम माणहे पापी ठेराना, तिहेच केरीन एक माणहाह उकुम मान्ने से आखा माणहे बोगवानान सामने देरमी ठेराती।<verse eid="ROM 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 5:20"/>नेमान ओलखात ज्यानकेरता एनो काय गुनो वोदी, पुण जाहरी पाप वोदनो ताहरी बोगवानान गीण उंजु बी जादा वोदनी। <verse eid="ROM 5:20"/><verse number="21" style="v" sid="ROM 5:21"/>काय जीहे पाप मोतीम राज किऱ्यो तिहेच केरीन गीण बी देरमीपोणा केरीन जेलेमक्यी जीवायीन केरता आपणो मालीक यीशु मसीन द्‍वारा राज केरी।<verse eid="ROM 5:21"/></para>
  <chapter eid="ROM 5"/>
  <chapter number="6" style="c" sid="ROM 6"/>
  <para style="s">पापान केरता मोरीन मसी माय जीवतालो</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1"/>ते एवी आपु काय किज्यो? काय आपु पाप केरती रिज्यो काय बोगवानान गीण होवटी एय? <verse eid="ROM 6:1"/><verse number="2" style="v" sid="ROM 6:2"/>केदिस नाह! आपु जा पापान केरता मोर गीया ते ओवता ज्यान ओंगाण ता माय किहीक जीवणो जीवहु? <verse eid="ROM 6:2"/><verse number="3" style="v" sid="ROM 6:3"/>काय तुमू नाह जाणते काय आपु आखा जा मसी यीशुन बपतीस्मा लेदा, तान मोतीन बपतीस्मा लेदा। <verse eid="ROM 6:3"/><verse number="4" style="v" sid="ROM 6:4"/><note caller="+" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="COL 2:12">कुलीसियो 2:12</ref></char></note>तानकेरता आपु बपतीस्मान द्‍वारा यीशुन मोती माय बेचकाएन ता हेऱ्या बुजाय जायेल हेते, जाकेरीन काय आबाख ने बोड़ायीन द्‍वारा जीहे मसी जीवाड़ाय जायेल ईतो, तिहेच केरीन आपु बी नोवाला जीवणान चाल चाले।<verse eid="ROM 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 6:5"/>काहाकाय केदी आपु यीशु हेऱ्या तान मोतीन समानता माय एक एय जायेल हेते, ते जोरवरीस तान जीव उठणेन समानता माय बी एक एय जाहु। <verse eid="ROM 6:5"/><verse number="6" style="v" sid="ROM 6:6"/>आमु जाणतेह काय आमरो जुनालो पापान काबावालो सेरीर यीशु हेऱ्यो खुरूसखाम पोर चेड़ाय गीयो, काहाकाय आपणो पापान सेरीर काईस कामान नाह बोण जाय एने आपु ओंगाण पापान गुलाम माय नाय रिज्यो। <verse eid="ROM 6:6"/><verse number="7" style="v" sid="ROM 6:7"/>काहाकाय जो मोर गीयो, तो पापाह रेन सुटीन देरमी ठेरानो। <verse eid="ROM 6:7"/><verse number="8" style="v" sid="ROM 6:8"/>तानकेरता केदी आपु मसी हेऱ्या मोर गीया, ते आमु बुरहो केरतेह काय ता हेऱ्या जीवताला बी रेहु। <verse eid="ROM 6:8"/><verse number="9" style="v" sid="ROM 6:9"/>काहाकाय आमु ज्य जाणतेह काय मसी मुरेल माय रेन जीव उठीन पोशो मोरन्यो नाह; ता पोर पोशी मोतीन राज नाह एण्यी। <verse eid="ROM 6:9"/><verse number="10" style="v" sid="ROM 6:10"/>एने तो मोर गीयो ता पोर पापान बोंदेन नाह सोतो एने काहाकाय जेवी तो मोरनो, ते पापान केरता कायेम ने केरता मोरनो; पुण बोगवाना हेऱ्या यीशु मसीन द्‍वारा जीवताला सोमजो। <verse eid="ROM 6:10"/><verse number="11" style="v" sid="ROM 6:11"/>इहीचकेरीन केरीन तुमू बी सोताह पापान केरता ते मुरेल, पुण बोगवानान केरता मसी यीशु माय जीवताला सोमजो।<verse eid="ROM 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 6:12"/>तानकेरता पापाह तुमरा खेतेम एण्या सेरीर माय राज मा केरने दिवो, काय तुमू तान आसान काबाम रिवो; <verse eid="ROM 6:12"/><verse number="13" style="v" sid="ROM 6:13"/>एने तुमरा सेरीरान अंगाह पापान गुनाह आथ्‍यार बाणावीन पापाह होपो, पुण आपणे आपाह मुरेल माय रेन जीवतालो सोमजीन तुमरा अंगाह देरमीपोणान सादेनान रूपाम आथ्‍यार एणेन केरता बोगवानाह होप दिवो। <verse eid="ROM 6:13"/><verse number="14" style="v" sid="ROM 6:14"/>तेवी पाप तुमरे पोर राज नाय केर सेकी, काहाकाय तुमू नेमान काबाम नाह, पुण बोगवानान गीणीन काबाम हेते।<verse eid="ROM 6:14"/></para>
  <para style="s">देरमीपोणान गुलाम</para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15"/>ते ओवतो काय? आपु ज्यानकेरता पाप केरी काय आपु नेमान काबाम नाह पुण बोगवानान गीणीन काबाम हेते? केदिस नाह! <verse eid="ROM 6:15"/><verse number="16" style="v" sid="ROM 6:16"/>काय तुमू नाह जाणते काय एगदान उकुम मान्नेन केरता तुमू सोताह पावरान गेत होप देतेह, ते जान उकुम मानतेह तास ने पावोर बोण जातेह चाहे पापान, जान परिणाम मोत हे, चाहे उकुम मान्नारान, जान परिणाम देरमी पोण हे? <verse eid="ROM 6:16"/><verse number="17" style="v" sid="ROM 6:17"/>पुण बोगवानान दन्यवाद एय काय एक टेम तुमू गुलाम एता पुरा मोना केरीन ग्रहण केऱ्या जा माय खेराय जुड़ेह एय काय तुमू जा पापान गुलाम एता एवी मोना केरीन ता हिकवोणाह मान्नारे एय गीया, जान केरता तुमू होपायेल एता, <verse eid="ROM 6:17"/><verse number="18" style="v" sid="ROM 6:18"/>एने तुमू पापाह रेन सुटीन देरमीपोणान गुलाम एय जायेल हेते। <verse eid="ROM 6:18"/><verse number="19" style="v" sid="ROM 6:19"/>मी तुमरी सेरीरान कोमजोरीन वोजेसे माणहान रितीन गेत केथु। जिहकेरीन तुमू तुमरा अंगाह खाराबपोणा एने नेमाह टालनारान गुलाम केरीन होपेल ईतो, तिहेच केरीन एवी तुमरा अंगाह चोखा पोणान केरता देरमीपोणान गुलाम एणेन केरता होप दिवो।<verse eid="ROM 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 6:20"/>काहाकाय जेवी तुमू पापान गुलाम एता ते देरमीपोणान उगे रेन सुटांग एता। <verse eid="ROM 6:20"/><verse number="21" style="v" sid="ROM 6:21"/>ज्‍यु वातु केरीन एवी तुमू लाजवातेह ता हेऱ्या ती टेम पोर काय फायदो सापड़ावताला? काहाकाय तान परिणाम ते मोत हे। <verse eid="ROM 6:21"/><verse number="22" style="v" sid="ROM 6:22"/>पुण एवी पापाह रेन सुटीन एने बोगवानान गुलाम बोणीन तुमूह ज्य फोल जुड़नो जाकेरीन चोखा पोण सापड़ेह, एने तान सेवेट जेलेमक्यी जीवाय हे। <verse eid="ROM 6:22"/><verse number="23" style="v" sid="ROM 6:23"/>काहाकाय पापान मोंजरी ते मोत हे, पुण बोगवानान गीणीन वरदान आपणो मालीक मसी यीशु माय जेलेमक्यी जीवाय हे।<verse eid="ROM 6:23"/></para>
  <chapter eid="ROM 6"/>
  <chapter number="7" style="c" sid="ROM 7"/>
  <para style="s">वाराड़ावाला जीवणान किस्सो</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1"/>एय बाय बोणहा, काय तुमू नाह जाणते मी नेमाह जाणनाराह केथु काय जाह वोर माणुह जीवतालो रीथे, ताह वोर ता पोर नेमान आदिकार रीथे? <verse eid="ROM 7:1"/><verse number="2" style="v" sid="ROM 7:2"/>काहाकाय किस्सान केरता एक वाराड़ ईयेल बायकु, तीन एदम्या हेऱ्यी नेमा हेऱ्यी ताह वोर बांदायेल हे तीन केदी तीन एदमी मोर जाथे ताहार वाराड़ एदमीह जीवतालो रेणेन बुखेत नेमा केरीन बांदायेल हे; पुण केदी तीन एदमी मोर जाय, ताहार ती एदम्यान नेमाह रेन सुट गियी। <verse eid="ROM 7:2"/><verse number="3" style="v" sid="ROM 7:3"/>तानकेरता केदी ती तीन एदमीह जीवतालो रेणेन बुखेत एगदा दिहरान लाडी बोण जाय ताहार सिनाल्यी केवाय, पुण केदी तीन एदमी मोर जाय, ताहार ती ता नेमाह रेन सुट गियी, न्या वोर काय केदी एगदा दिहरा एदम्यान लाडी बोण जाय तीबी सिनाल्यी नाय केवाय। <verse eid="ROM 7:3"/><verse number="4" style="v" sid="ROM 7:4"/>तिहेच केरीन एय मारा बाय बोणहा, तुमू बी मसीन सेरीरान द्‍वारा नेमान केरता मुरेल बोण जायेल काय ता दिहरान बोण जावो, जो मुरेल माय रेन जीव उठनो: काहाकाय आपु बोगवानान केरता फोल लावे। <verse eid="ROM 7:4"/><verse number="5" style="v" sid="ROM 7:5"/>काहाकाय जेवी आपु सेरीर माय एता, ते पापान मोरजी जो नेमान द्‍वारा ईतो, मोतीन फोल पायदा केरनेन केरता आपणा अंगा माय काम केरतालो। <verse eid="ROM 7:5"/><verse number="6" style="v" sid="ROM 7:6"/>पुण एवी जा नेमाह रेन आपु बांदायेल एता तानकेरता मोरीन, ताहसे ओहला सुट जायेल हेते काय आपु लेख्यान जुनाली रिती पोर नाह, पुण चोखाला जीवान नोवाली रिती केरीन सेवा केरतेह।<verse eid="ROM 7:6"/></para>
  <para style="s">नेम एने पाप</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7"/>ताहार आपु काय किज्यो? काय नेम पाप हे? केदिस नाह! पुण नेमान बिगेर मी पापाह नाय ओलेखतो। काहाकाय केदी नेम नाय केतो, “लालुस मा केरी,” ते मी लालुसान बाराम नाय जाण सेकतो। <verse eid="ROM 7:7"/><verse number="8" style="v" sid="ROM 7:8"/>पुण पाप ज्या उकुमान द्‍वारा टेम होदिन मार माय आखी बातीन लालुस पायदा किऱ्यो, काहाकाय नेमान बिगेर पाप मुरेल हे। <verse eid="ROM 7:8"/><verse number="9" style="v" sid="ROM 7:9"/>मी ते पेल नेमा बिगेर जीवतालो ईतो, पुण एवी उकुम आवो ते पाप जीव गीयो, एने मी मोर गीयो। <verse eid="ROM 7:9"/><verse number="10" style="v" sid="ROM 7:10"/>एने तोस उकुम जो जीवणान केरता ईतो, मार केरता मोतीन कारेण बोण गीयो। <verse eid="ROM 7:10"/><verse number="11" style="v" sid="ROM 7:11"/>काहाकाय पाप टेम होदिन उकुमान द्‍वारा माहु बोटकाड्यो, एने तास ने द्‍वारा माहु मार बी टाक्‍यो।<verse eid="ROM 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 7:12"/>तानकेरता नेम चोखालो हे, एने उकुम बी खेरलो एने हाजो हे।<note caller="+" style="f"><char style="fr" closed="false">7:12 </char><char style="fq" closed="false">हे। </char><char style="ft" closed="false">जुनाला लेख माय ज्यो वचन नाह जुड़ने</char></note> <verse eid="ROM 7:12"/><verse number="13" style="v" sid="ROM 7:13"/>ते काय तो जो हाजो एतो, मार केरता मोत ठेरानो? केदिस नाह! पुण पाप ती हाजाली चिजीन द्‍वारा मार केरता मोतीह पायदा केरनार ईनो काय तान पाप एणे देखाय, एने उकुमान द्‍वारा पाप जुलूम होवटो पापा वालो बोण जाय।<verse eid="ROM 7:13"/></para>
  <para style="s">माणहान मायवाला बावनान लेड़ाय</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 7:14"/>आमु जाणतेह काय नेम ते आत्मिक हे, पुण मी सारिरीक एने पापान आथे वेचायेल हे। <verse eid="ROM 7:14"/><verse number="15" style="v" sid="ROM 7:15"/><note caller="+" style="x"><char style="xo" closed="false">7:15 </char><char style="xt" closed="false"><ref loc="GAL 5:17">गलातीयो 5:17</ref></char></note>जो मी केरथु ताह नाह जाणेत; काहाकाय जो मी होदथु तो नाह किरेत, पुण जाकेरीन माहु सीट आवीह तोस केरथु। <verse eid="ROM 7:15"/><verse number="16" style="v" sid="ROM 7:16"/>केदी जो मी नाह होदित तोस केरथु, ताहार मी मान लितो काय नेम हाजो हे। <verse eid="ROM 7:16"/><verse number="17" style="v" sid="ROM 7:17"/>ते ओहली देशा माय तान केरनार मी नाह, पुण पाप हे जो मार माय रिग रिनोह। <verse eid="ROM 7:17"/><verse number="18" style="v" sid="ROM 7:18"/>काहाकाय मी जाणथो काय मार माय मतलब मारा सेरीर माय काल्ली हाजाली चिज रिगेत नाह। मोरजी ते मार माय हे, पुण हाजालो काम मार से एत नाह। <verse eid="ROM 7:18"/><verse number="19" style="v" sid="ROM 7:19"/>काहाकाय जा हाजाला कामान मी आसा केरथु, तो ते नाह किरेत, पुण जी बुरायीन आसा नाह किरेत, तोस केऱ्या केरथु। <verse eid="ROM 7:19"/><verse number="20" style="v" sid="ROM 7:20"/>पुण केदी मी तोस केरथु जान आसा नाह किरेत, ताहार ताह केरनार मी नाह ईनो, पुण पाप जो मार माय रिग रिनोह।<verse eid="ROM 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 7:21"/>इहकेरीन मी ज्य नेम सापड़ावथो काय जेवी हाजो केरनेन आसा केरथु, ते मार फाय रेन बुरायच ईथे। <verse eid="ROM 7:21"/><verse number="22" style="v" sid="ROM 7:22"/>काहाकाय मी मायवाला माणहा से ते बोगवानान नेमा केरीन जुलूम खुस रेथु। <verse eid="ROM 7:22"/><verse number="23" style="v" sid="ROM 7:23"/>पुण माहु मारा सेरीर माय दिहरी बातीन नेम देखाह, जो मारी बुद्दीन नेमा केरीन लेड़ाह एने माहु पापान काबा माय टाकेह जो मारा सेरीर माय हे। <verse eid="ROM 7:23"/><verse number="24" style="v" sid="ROM 7:24"/>मी कोहलो दुखी माणुह हे! माहु ज्या मोतीन सेरीर से कुण सोड़वी? <verse eid="ROM 7:24"/><verse number="25" style="v" sid="ROM 7:25"/>आपणो मालीक यीशु मसीन द्‍वारा बोगवानान दन्यवाद एय। तानकेरता मी खुद बुद्दी केरीन ते बोगवानान नेमान, पुण सेरीरा केरीन पापान नेमान सेवा केरथु।<verse eid="ROM 7:25"/></para>
  <chapter eid="ROM 7"/>
  <chapter number="8" style="c" sid="ROM 8"/>
  <para style="s">चोखाला जीवान द्‍वारा जीवणो</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1"/>एवी जा यीशु मसी माय जीवाय जीवतेह, ता पोर डेंडान उकुम नाह। काहाकाय ता सेरीरान गेत नाह पुण जीवान गेत चालतेह। <verse eid="ROM 8:1"/><verse number="2" style="v" sid="ROM 8:2"/><note caller="+" style="f"><char style="fr" closed="false">8:2 </char><char style="ft" closed="false">माहु; थोड़ाक लेख माय तुवाह लिखेल हे; दिहरा लेख माय आमुह।</char></note>काहाकाय जीवणान जीवान नेम मसी यीशु माय माहु पापान उगे मोतीन नेमा केरीन मोकलो केर दिनो। <verse eid="ROM 8:2"/><verse number="3" style="v" sid="ROM 8:3"/>काहाकाय जा काम नेम सेरीरान वोजेसे कोमजोर एन नाह केर सीक्‍यो, ताह बोगवान किऱ्यो, मतलब तास ने बेटाख पापा वालो सेरीरान गेतुस एने पापान बोली एणेन केरता मोकलीन, सेरीर माय पापा पोर डेंडान उकुम आप्यो। <verse eid="ROM 8:3"/><verse number="4" style="v" sid="ROM 8:4"/>ज्यानकेरता काय नेमान मांग आपणे माय जा सेरीरान गेत नाह, पुण जीवान गेत चालतेह, पुरो एय सेकी। <verse eid="ROM 8:4"/><verse number="5" style="v" sid="ROM 8:5"/>काहाकाय सेरीर वाला माणहे सेरीरान वाती पोर मोन लागाड़तेह; पुण जा आत्मिकता माय जीवतेह तान मोनाह जीव नियंत्रण किरेह। <verse eid="ROM 8:5"/><verse number="6" style="v" sid="ROM 8:6"/>जान विचार सेरीरान गेत चालतेह तो मोत हे, पुण जीवा पोर मोन लागाड़ने जीवाय एने सान्ती हे; <verse eid="ROM 8:6"/><verse number="7" style="v" sid="ROM 8:7"/>काहाकाय सेरीर पोर मोन लागाड़ने ते बोगवाना हेऱ्यो दुसमोनाय मेलनो हे, तो नाहते बोगवानान नेमान काबाम हे एने नाह एय सिकेह। <verse eid="ROM 8:7"/><verse number="8" style="v" sid="ROM 8:8"/>एने जा पापान सोबाव माय जीवतेह ता बोगवानाह खुस नाह केर सेकते।<verse eid="ROM 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 8:9"/>पुण तुमरे माय जेवी बोगवानान जीव रिगेह, ताहार तुमू सेरीरान काबाम नाह, जीवान काबाम हेते। पुण केदी एगदा माय मसीन जीव नाय रेय ताहार तो तान ना सोतो। <verse eid="ROM 8:9"/><verse number="10" style="v" sid="ROM 8:10"/><note caller="+" style="f"><char style="fr" closed="false">8:10 </char><char style="ft" closed="false">जीव तुमरा केरता जीवाय हे; नाहते तुमरो जीव जीवतालो हे।</char></note>केदी मसी तुमरे माय हे, ताहार सेरीर पापान वोजेसे मुरेल हे; पुण जीव देरमीपोणान वोजेसे जीवतालो हे। <verse eid="ROM 8:10"/><verse number="11" style="v" sid="ROM 8:11"/><note caller="+" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="1CO 3:16">1 कुरिंथीयो 3:16</ref></char></note>केदी तास ने जीव जो यीशुह मुरेल माय रेन जीवाड्यो, तुमरे माय रिग रिनोह; ताहार जो मसीह मुरेल माय रेन जीवाड्यो, तो तुमरे मुरेल सेरीराह बी तान जीवान द्‍वारा जो तुमरे माय रिगेह, जीवाड़ी।<verse eid="ROM 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12"/>तानकेरता एय बाय बोणहा, आपु सेरीरान केर्जावाला ते हेते पुण ज्य नाह काय सेरीरान गेत जीवाय जीवे। <verse eid="ROM 8:12"/><verse number="13" style="v" sid="ROM 8:13"/>काहाकाय केदी तुमू सेरीरान गेत जीवणो जीवतेह ताहार जोरेवरी मोरहु, पुण केदी जीवान द्‍वारा सेरीरान कामाह खेतेम केरतेह ताहार तुमू जीवताला रिहो। <verse eid="ROM 8:13"/><verse number="14" style="v" sid="ROM 8:14"/>काहाकाय जोलाक माणहे बोगवानान जीवान द्‍वारा चालतेह तोलाक बोगवानान सोरा हेते। <verse eid="ROM 8:14"/><verse number="15" style="v" sid="ROM 8:15"/><note caller="+" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="MRK 14:36">मरकुस 14:36</ref>; <ref loc="GAL 4:5-7">गलातीयो 4:5-7</ref></char></note>काहाकाय तुमूह पावरान जीव नाह जुड़नो काय पोशा बिते, पुण बोगवानान सोरा एणेन जीव जुड़ेल हे, जाह आपु एय अब्बा, एय आबा केयीन आयेड़तेह। <verse eid="ROM 8:15"/><verse number="16" style="v" sid="ROM 8:16"/>जीव सोतास आपणा जीवा हिऱ्यो मिलीन गोवाय दिथे काय आपु बोगवानान सोरा हेते। <verse eid="ROM 8:16"/><verse number="17" style="v" sid="ROM 8:17"/>एने केदी सोरा हेते ताहार वारीस बी, मतलब बोगवानान वारीस, मसी हेऱ्या आरहीवाला वारीस ओहला हेते काय जेवी आपु ता हेऱ्या दुख वेठहु ताहार ता हेऱ्या बोड़ाय बी सापड़ावहु।<verse eid="ROM 8:17"/></para>
  <para style="s">आवणारा कालाम देखाण्यी बोड़ाय</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18"/>काहाकाय मी सोमेजथु काय ज्या टेमान दुख एने पिड़ा आवणारी बोड़ायीन सामने, जी आपणी केरता देखाण्यी हे, काईस ना सोतो। <verse eid="ROM 8:18"/><verse number="19" style="v" sid="ROM 8:19"/>काहाकाय केल जुलूम आसा बोरायेल नेजेर केरीन बोगवानान सोराह आवणेन वाट जोव रेनीह। <verse eid="ROM 8:19"/><verse number="20" style="v" sid="ROM 8:20"/>काहाकाय केल तीन मोरजी केरीन नाह पुण काबाम केरनारान उगे रेन, फालतुक पोणान ताबाम ज्यी आसा से केराय गियी, <verse eid="ROM 8:20"/><verse number="21" style="v" sid="ROM 8:21"/>काय केल बी सोतास खेतेमान पावराय से सुटकारो होदिन, बोगवानान सोरान बोड़ायीन स्वतंत्रता सापड़ावी। <verse eid="ROM 8:21"/><verse number="22" style="v" sid="ROM 8:22"/>काहाकाय आमु जाणतेह काय आखी केल एवी वोर मिलीन गाबरातेन एने पिड़ा माय पोड़ीन तिड़पेह; <verse eid="ROM 8:22"/><verse number="23" style="v" sid="ROM 8:23"/><note caller="+" style="x"><char style="xo" closed="false">8:23 </char><char style="xt" closed="false"><ref loc="2CO 5:2-4">2 कुरिंथीयो 5:2-4</ref></char></note><note caller="+" style="f"><char style="fr" closed="false">8:23 </char><char style="ft" closed="false">थोड़ाक लेख माय आमुह तान सोरा बोणावीह नाह लिखेल हे।</char></note>एने फोक्‍तो तोस नाह पुण आपु बी जा फाय जीवान पेल्लो फोल हे, सोता माय काहतेह; एने दत्तक बिटोख एणेन, मतलब तान सेरीरान सुटकारान वाट जोवतेह। <verse eid="ROM 8:23"/><verse number="24" style="v" sid="ROM 8:24"/>काहाकाय आसा माय आपणो सुटकारो ईयेल हे, पुण आसा ज्यी देखाह, आसा नाह; काहाकाय जो एगदी चिजीह दिखेह तो तीन आसा काहा केरी? <verse eid="ROM 8:24"/><verse number="25" style="v" sid="ROM 8:25"/>पुण जी चिजीह आपु नाह देख सेकते, केदी तीन आसा मेलतेह, ताहार दिर देरीन तीन वाट जोवतेह बी।<verse eid="ROM 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 8:26"/>इहीचकेरीन जीव बी आपणी कोमजोरी माय मोदेक किरेह; काहाकाय आपु नाह जाणते काय विन्ता किहकेरीन केरने जुवे, पुण जीव सोता ओहलो काहिन, जो उपकारा से बाहेर हे, आपणी केरता विन्ता किरेह। <verse eid="ROM 8:26"/><verse number="27" style="v" sid="ROM 8:27"/>बोगवान आपणा मोनाह जाणेह काय जीवान मोन काय हे? काहाकाय तो चोखाला माणहान केरता बोगवानान मोरजीन गेत विन्ता किरेह।<verse eid="ROM 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 8:28"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">8:28 </char>
      <char style="ft" closed="false">बोगवाना पोर मोंग केरनारा हेऱ्यो बोगवान आख्‍यु वातु माय बोलान केरता काम किरेह; थोड़ाक लेख माय बोगवाना पोर मोंग केरनारान केरता बोगवान आख्‍यु वातु माय बोलान केरता काम किरेह।</char>
    </note>एने आमु जाणतेह काय जा माणहे बोगवानाह मोंग केरतेह, तानकेरता आख्‍यु वातु मिलीन बोलायीह पायदा किरेह; मतलब तास ने केरता जा तान मोरजीन गेत हादाड़ाय जायेल हेते। <verse eid="ROM 8:28"/><verse number="29" style="v" sid="ROM 8:29"/>काहाकाय जाह तो पेलुस रेन जाण जायेल हे ताह पेलुस रेन ठेरायेल बी हे काय ता तान बेटाख ने वेहा माय एय जाय, काहाकाय तो जुलूम बाय बोणहा माय जेठालो ठेराय। <verse eid="ROM 8:29"/><verse number="30" style="v" sid="ROM 8:30"/>ओवतो जाह तो पेलुस रेन ठेरायेल, ताह हादेल बी; एने जाह हादेल, ताह देरमी बी ठेरायेल हे; एने जाह देरमी ठेरायेल, ताह बोड़ाय बी आपेल हे।<verse eid="ROM 8:30"/></para>
  <para style="s">बोगवानान मोंग</para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31"/>आपु ज्‍यु वातुन बाराम काय किज्यो? केदी बोगवान आपणी उगे हे, ताहार आपणो विरोदी कुण एय सिकेह? <verse eid="ROM 8:31"/><verse number="32" style="v" sid="ROM 8:32"/>जो तान सोतान बेटाख बी नाह सोड्यो, पुण ताह आपणे आखान केरता आप दिनो, तो ता हिऱ्यो आपुह फुकेट आखो काहा नाय आपी? <verse eid="ROM 8:32"/><verse number="33" style="v" sid="ROM 8:33"/>बोगवानान निवाड़ेल माणहा पोर कुण दोस लागाड़ी? बोगवानुस हे जो ताह देरमी ठेरावण्यो हे। <verse eid="ROM 8:33"/><verse number="34" style="v" sid="ROM 8:34"/>ओवतो कुण हे जो डेंडान उकुम आपी? मसी यीशुस हे जो मोरनो एने मुरेल माय रेन जीव बी उठनो, एने बोगवानान जीवड़े उगे हे, एने आपणी केरता निवेदन बी किरेह। <verse eid="ROM 8:34"/><verse number="35" style="v" sid="ROM 8:35"/>कुण आपुह मसीन मोंग से आलेग केरी? काय पिड़ा, नाहते केठीण टेम, नाहते सेताव, नाहते काल, नाहते गेरीबी, नाहते संकट, नाहते मोत? <verse eid="ROM 8:35"/><verse number="36" style="v" sid="ROM 8:36"/>जिहकेरीन लिखेल हे, “तार केरता आमु दिह बोर माराय जातेह; आमु माराण्या मेंड्रान गेत गेणाय जायेल हेते।” <verse eid="ROM 8:36"/><verse number="37" style="v" sid="ROM 8:37"/>पुण ज्‍यु आख्‍यु वातु माय आमु तान द्‍वारा जो आपुह मोंग किरेल हे, जिकीह रेन बी वोदार हे। <verse eid="ROM 8:37"/><verse number="38" style="v" sid="ROM 8:38"/>काहाकाय माहु पुरो बुरहो हे काय नाह मोत, नाह जीवाय, नाह हेरोगदुत, नाह आदिकारी, नाह एवीन कालान वातु, नाह आवणारा कालान वातु, नाह ताकेत, नाह उचाय, <verse eid="ROM 8:38"/><verse number="39" style="v" sid="ROM 8:39"/>नाह दुनियान उंडाय, एने नाह दुनियान उचाय एने नाह दुनियान एगदी बाणायेल चिज आपुह बोगवानान मोंग से जो आपणा मालीक मसी यीशु माय हे, आलेग केर सेकी।<verse eid="ROM 8:39"/></para>
  <chapter eid="ROM 8"/>
  <chapter number="9" style="c" sid="ROM 9"/>
  <para style="s">बोगवान एने तान निवाड़ेल माणहे</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1"/>मी मसी माय खेरीच केथु, मी जुठ नाह बुलेत एने मारो मोन बी चोखाला जीवाम गोवाय दिथे <verse eid="ROM 9:1"/><verse number="2" style="v" sid="ROM 9:2"/>काय माहु मोटलो दुख हे, एने मारो मोन जेलेम दुखते रीथे, <verse eid="ROM 9:2"/><verse number="3" style="v" sid="ROM 9:3"/>काहाकाय मी न्या वोर होदतालो काय मारा बायाख ने केरता जा सेरीरान गेत मारा गेरल्या हेते, मी सोतास मसी रेन आलेग एय जातो। <verse eid="ROM 9:3"/><verse number="4" style="v" sid="ROM 9:4"/><note caller="+" style="f"><char style="fr" closed="false">9:4 </char><char style="ft" closed="false">वायदो; थोड़ाक लेख माय वायदा।</char></note>ता इस्राएली हेते, एने बोगवानान सोरा एणेन आदिकार एने बोड़ाय एने वायदो एने नेम एने उपासना एने उकुम तास ने हे। <verse eid="ROM 9:4"/><verse number="5" style="v" sid="ROM 9:5"/><note caller="+" style="f"><char style="fr" closed="false">9:5 </char><char style="ft" closed="false">आखा पोर आदिकार केरनारा बोगवानान स्तुती कायेम एय; नाहते तान मतलब आखा पोर आदिकार मेलनारा बोगवानान स्तुती कायेम एय।</char></note> डायडाया तास ने हेते, एने मसी बी सेरीरान गेत तास माय रेन ईनो। जो आखान उपेर जेलेम बोरकेतवालो बोगवान हे। आमेन।<verse eid="ROM 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6"/>पुण ओहलो नाह काय बोगवानान वचन टेल गीयो, ज्यानकेरता काय जा इस्राएलान वोच हेते, ता आखा इस्राएली नाह; <verse eid="ROM 9:6"/><verse number="7" style="v" sid="ROM 9:7"/>एने नाह अब्राहामान वोच एणेन वोजेसे आखा तान सोरा ठेराती, पुण लिखेल हे, “इसहाक सेस तारो वोच चाली।” <verse eid="ROM 9:7"/><verse number="8" style="v" sid="ROM 9:8"/><note caller="+" style="f"><char style="fr" closed="false">9:8 </char><char style="ft" closed="false">कायेम ने केरता जेल्मो लियेल सोरा; अब्राहाम ने हाजीरा फाय रेन जेल्मो लियेल सुरो, सुरो इश्माएल ने वोस ने ज्यो संदर्ब हे। </char></note>मतलब सेरीरान सोरा ते बोगवानान सोरा ना सोता, पुण वायदान सोरा वोच गेणाय जातेह। <verse eid="ROM 9:8"/><verse number="9" style="v" sid="ROM 9:9"/><note caller="+" style="f"><char style="fr" closed="false">9:9 </char><char style="ft" closed="false">ठिक टेम पोर; नाहते ओगले वोरीह ज्यीज टेम माय।</char></note>काहाकाय वायदान वचन ज्य हे: “मी ज्‍यीस टेमी पोर आवुह, एने साराह एक बिटोख एय।”<verse eid="ROM 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 9:10"/>एने फोक्‍तो ओलोस नाह, पुण जेवी रिबीका बी एक माणुह मतलब आपणो आबोख इसहाक से पेटावाली एती, <verse eid="ROM 9:10"/><verse number="11" style="v" sid="ROM 9:11"/>पुण तान एक सोराह निवाड़नो ज्य पुरी रिती से बोगवानान सोतान उद्देशान परिणाम एतो, बोगवान ताह केयो, “मोटलो आतल्यान सेवा केरी।” ज्यी वात बोगवान तान जेल्मान पेल केरनेन केरता केयो बोगवानान पोटणो तान हादावणी पोर निर्बर हे नाह काय ता काय केऱ्या ता पोर। <verse eid="ROM 9:11"/><verse number="12" style="v" sid="ROM 9:12"/>तो केयो, “जेठालो बिटोख आतल्यान सेवा केरी।” <verse eid="ROM 9:12"/><verse number="13" style="v" sid="ROM 9:13"/>जिहकेरीन लिखेल हे, “मी याकुबाह मोंग किऱ्यो, पुण एसावाह विण मोंगाल्लो जाण्यो।”<verse eid="ROM 9:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14"/>तानकेरता आपु काय किज्यो? काय बोगवान अन्‍यायी हे? केदिस नाह। <verse eid="ROM 9:14"/><verse number="15" style="v" sid="ROM 9:15"/>काहाकाय तो मुसाह किथे, “मी जा एगदा पोर किव केरने होदु ता पोर किव केरूह, एने जा एगदा पोर गीण केरने होदु तास पोर गीण केरूह।” <verse eid="ROM 9:15"/><verse number="16" style="v" sid="ROM 9:16"/>केरीन ज्य नाहते आसा केरनारान, नाह मेहनेत केरनारा पोर पुण किव केरनार बोगवानान वात हे। <verse eid="ROM 9:16"/><verse number="17" style="v" sid="ROM 9:17"/>काहाकाय पुस्तेक माय फिरोनाह कियेल, “मी तुवाह ज्यास ने केरता उबो किरेल हे काय तार माय मारी ताकेत देखाडु, एने मारा नावान पारचार आखी देरती पोर केराय जाय।” <verse eid="ROM 9:17"/><verse number="18" style="v" sid="ROM 9:18"/>तानकेरता बोगवान जा पोर हुदेह ता पोर किव किरेह, एने जाह हुदेह ताह काठो केर दिथे।<verse eid="ROM 9:18"/></para>
  <para style="s">बोगवानान राग एने तान किव</para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19"/>पुण तुमरे माय रेन माहु इहकेरीन केय केदी ओहलो हे आमरा तेवी तु माहु किहे, “तो पोशो काहा दोस लागाड़ेह? कुण बोगवानान मोरजीन विरोद किरेह?” <verse eid="ROM 9:19"/><verse number="20" style="v" sid="ROM 9:20"/>एय माणुह, तु कुण हे जो बोगवानान विरोद माय बुलेह? काय बाणायेल चिज बाणावणाराह केय सिकेह, “तु माहु ओहलो काहा बाणायेल हे?” <verse eid="ROM 9:20"/><verse number="21" style="v" sid="ROM 9:21"/>काय कुमाराह माटड्या पोर आदिकार नाह काय एकास कुंडा माय रेन एक ठामलो आदर ने केरता, एने दिहराह बिगेर आदर ने केरता बाणावी?<verse eid="ROM 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 9:22"/>ते ज्या माय काल्ली बोंलाणेन वात हे काय बोगवान तान राग देखाड़ने एने तान ताकेत देखाड़नेन मोरजी से रागान ठामलान, जा खेतेमान केरता तियार केराय जायेल एता, जुलूम दिर खाईन वेठ्यो; <verse eid="ROM 9:22"/><verse number="23" style="v" sid="ROM 9:23"/>एने किवान ठामला पोर, जाह तो बोड़ायीन केरता पेलुस रेन तियार किऱ्यो, तान बोड़ायीन मालदेनाह देखाड़नेन आसा किऱ्यो? <verse eid="ROM 9:23"/><verse number="24" style="v" sid="ROM 9:24"/>मतलब आपुह बी, जाह तो नाह फोक्‍तो यहुदि माय रेन पुण बिगेर यहुदि माय रेन बी हादेल। <verse eid="ROM 9:24"/><verse number="25" style="v" sid="ROM 9:25"/>जिहकेरीन बोगवान होशेन पुस्तेक माय बी किथे, “जा मारा माणहे नाह एता, ताह मी मारा माणहे केह; एने जा मोंगाल्ला नाह एता, ताह मोंगाल्ला केह। <verse eid="ROM 9:25"/><verse number="26" style="v" sid="ROM 9:26"/>एने इहकेरीन एय काय, तुमू मारा माणहे नाह इहकेरीन जाहरी कियेल एतो ताहरी ताह जीवताला बोगवानान सोरा केवाती।”<verse eid="ROM 9:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 9:27"/>एने यशाया इस्राएलान बाराम आयड़ीन किथे, “केदी इस्राएल ने सोरान गेणती देरीयान रेटान बाराबोर रेय, तीबी ता माय रेन थोड़ास वोचती। <verse eid="ROM 9:27"/><verse number="28" style="v" sid="ROM 9:28"/>काहाकाय मालीक तान वचन देरती पोर पुरो केरीन, देरमीपोणा से उतवाल्योच ताह सिद्द केरी।” <verse eid="ROM 9:28"/><verse number="29" style="v" sid="ROM 9:29"/>जिहकेरीन यशाया पेल बी कियेल ईतो, “केदी सेनावोन मालीक आपणी केरता कायच वोच नाय सोड़तो, ताहार आपु सदोमान गेत एय जाता, एने अमोरान गेत ठेराय जाता।”<verse eid="ROM 9:29"/></para>
  <para style="s">इस्राएलान बुरहो नाह</para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30"/>ते ओवता आपु काय किज्यो? ज्य काय बिगेर यहुदि जा देरमीपोणान होद नाह केरताला, देरमी पोण सापड़ाया मतलब तो देरमी पोण जो बोरहा केरीन हे; <verse eid="ROM 9:30"/><verse number="31" style="v" sid="ROM 9:31"/>पुण इस्राएली, जा देरमीपोणान नेमान होद केरती लेन, ता देरमीपोणान नेम वोर नाह पोचना। <verse eid="ROM 9:31"/><verse number="32" style="v" sid="ROM 9:32"/>इहकेरीन काहा? काहाकाय ता बोरहा केरीन नाह, पुण कामा केरीन ताह होदेल एता। तान होदणो ओहलो एतो सोमजो तो कामा केरीन सापड़ेह। ता ठोकरान देगड़ा केरीन ठोकेर खादा, <verse eid="ROM 9:32"/><verse number="33" style="v" sid="ROM 9:33"/>जिहकेरीन लिखेल हे, “दिखो, मी सियोन माय एक जेठ लागणेन दिगोड़, एने ठोकरा खाणेन दिगोड़ मेलथु, एने जो ता पोर बुरहो केरी तो लाजवाय नाय।”<verse eid="ROM 9:33"/></para>
  <chapter eid="ROM 9"/>
  <chapter number="10" style="c" sid="ROM 10"/>
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1"/>एय बाय बोणहा, मारा मोनान अबिलाषा एने तान केरता बोगवाना से मारी विन्ता हे काय ताह सुटकारो जुड़ी। <verse eid="ROM 10:1"/><verse number="2" style="v" sid="ROM 10:2"/>काहाकाय मी तान गोवाय दिथो काय ताह बोगवानान बोक्ती माय रेतेह, पुण खेरला ईकेल पोर एकलीदार हेऱ्या नाह। <verse eid="ROM 10:2"/><verse number="3" style="v" sid="ROM 10:3"/>काहाकाय ता बोगवानान देरमीपोणा से एंजाणल्या बोणीन, एने सोतान देरमीपोणान स्थापना केरनेन कोसीत केरती लेन, ता सोताह बोगवानान देरमीपोणान काबाम नाह केऱ्या। <verse eid="ROM 10:3"/><verse number="4" style="v" sid="ROM 10:4"/>काहाकाय आखाह बुरहो केरनारान केरता देरमीपोणान निमीत्त मसी नेमान निवेरनो हे।<verse eid="ROM 10:4"/></para>
  <para style="s">आखान केरता सुटकारो</para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 10:5"/>काहाकाय मुसो ज्य लिखेल हे काय जा माणहे ता देरमीपोणा पोर जो नेमा केरीन हे, चालेह, तो तास केरीन जीवतालो रेय। <verse eid="ROM 10:5"/><verse number="6" style="v" sid="ROM 10:6"/>पुण जो देरमी पोण बोरहा केरीन हे, तो इहकेरीन किथे, “तु तारा मोना माय ज्य मा किहे काय हेरगा पोर कुण चेड़ी?” मतलब मसीह उतार लावणेन केरता। <verse eid="ROM 10:6"/><verse number="7" style="v" sid="ROM 10:7"/>नाहते “बुराया माय कुण उतरी?” मतलब मसीह मुरेल माय रेन जिवाड़ेन उपेर लावणेन केरता। <verse eid="ROM 10:7"/><verse number="8" style="v" sid="ROM 10:8"/>पुण ती काय किथे? “ज्य काय वचन तारे आहने हे, तारा मुया माय एने तारा मोना माय हे,” ज्य तास बोरहान वचन हे, जो आमु पारचार केरतेह, <verse eid="ROM 10:8"/><verse number="9" style="v" sid="ROM 10:9"/>काय केदी तु तारा मुया केरीन यीशुह मालीक जाणीन कबुल किरहे, एने तारा मोना केरीन बुरहो केरी काय बोगवान ताह मुरेल माय रेन जीवाड्यो, ताहार तारो सुटकारो एय। <verse eid="ROM 10:9"/><verse number="10" style="v" sid="ROM 10:10"/>काहाकाय देरमीपोणान केरता मोन से बुरहो केराय जाथे, एने सुटकारान केरता मुया केरीन कबुल केराय जाथे। <verse eid="ROM 10:10"/><verse number="11" style="v" sid="ROM 10:11"/>काहाकाय पुस्तेक ज्य किथे, “जो कुण ता पोर बुरहो केरी तो लाजवाय नाय। <verse eid="ROM 10:11"/><verse number="12" style="v" sid="ROM 10:12"/>यहुदि एने युनानी माय काय फारेक ना सोतो, ज्यानकेरता काय तो आखान मालीक हे एने तान आखाह नाव लेणारान केरता मालदार हे।” <verse eid="ROM 10:12"/><verse number="13" style="v" sid="ROM 10:13"/>काहाकाय पुस्तेक किथे, “जो कुण मालीकाह मोदेक ने केरता आयड़ेह तो वोच जाय।”<verse eid="ROM 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 10:14"/>पुण जा पोर ता बुरहोस नाह केऱ्या, ता तान नाव किहीक लेती? एने जान बाराम ता होमल्यास नाह ता पोर किहीक बुरहो केरती? एने ता पारचार केरनारा बिगेर किहीक होमेलती। <verse eid="ROM 10:14"/><verse number="15" style="v" sid="ROM 10:15"/>एने ता पारचार किहीक केरती जाह वोर काय मोकलाय नाय जाती, जिहकेरीन लिखेल हे, “हाजाल्यु वातुन हाजाली खोबरीह केणारान पाय कोहला हाजा हेते!” <verse eid="ROM 10:15"/><verse number="16" style="v" sid="ROM 10:16"/>पुण ता आखा हाजाली खोबरी पोर द्यान नाह देना: यशाया किथे, “एय मालीक, कुण आमरी खोबरी पोर बुरहो किरेल हे?”<note caller="+" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="ISA 53:1">यशाया 53:1</ref></char></note> <verse eid="ROM 10:16"/><verse number="17" style="v" sid="ROM 10:17"/>बुरहो होमेलने से एने होमेलनो मसीन वचन से ईथे।<verse eid="ROM 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 10:18"/>पुण मी केथु, काय ता नाह होमल्या? होमलेल ते खेरीच एता; काहाकाय लिखेल हे, “तान नांद आखी देरती पोर, एने तान वचन दुनियान कोपरे कोपरे वोर पोच जायेल हे।”<verse eid="ROM 10:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 10:19"/>मी पोशो केथु, काय इस्राएली नाह जाणताला? पेल ते मुसो किथे, “मी तान द्‍वारा जी जाती ना सोती, तुमरा मोनाम जलन पायदा केरूह; मी एक फोगी जातीन द्‍वारा तुमरे माय राग पायदा केरूह।” <verse eid="ROM 10:19"/><verse number="20" style="v" sid="ROM 10:20"/>ओवतो यशाया मोटली ईमोत केरीन किथे, “जा माहु नाह होदताला, ता माहु सापड़ाव लियेल हेते; एने जा मार बाराम फुसताला बी नाह, ताह मी देखानो।” <verse eid="ROM 10:20"/><verse number="21" style="v" sid="ROM 10:21"/>पुण इस्राएलान बाराम तो किथे, उकुम नाह माणनाराह एने हुम्बा बोलनारे माणहान उगे “मी आखो दिह मारा आथ पोसारेल रिनो।”<verse eid="ROM 10:21"/></para>
  <chapter eid="ROM 10"/>
  <chapter number="11" style="c" sid="ROM 11"/>
  <para style="s">इस्राएल माणहा पोर बोगवानान किव</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">11:1 </char>
      <char style="xt" closed="false">
        <ref loc="PHP 3:5">फिलेपियो 3:5</ref>
      </char>
    </note>तानकेरता मी केथु, काय बोगवान तान माणहाह टाक दियेल हे? केदिस नाह! काहाकाय मी बी इस्राएली हे; अब्राहामान वोच एने बिन्यामीन ने जातीम रेन हे। <verse eid="ROM 11:1"/><verse number="2" style="v" sid="ROM 11:2"/>बोगवान तान ता माणहाह नाह सोड्यो, जाह तो सुरवात माय निवाड्यो। काय तुमू नाह जाणते काय पुस्तेक एलियान बाराम काय किथे, काय तो इस्राएलान विरोद माय बोगवाना से विन्ता किरेह <verse eid="ROM 11:2"/><verse number="3" style="v" sid="ROM 11:3"/>“एय मालीक ता तारा जाणाव केरनाराह मार देना, ता तारी वेदीह ओदार दियेल हेते; एने मीच एखालोच वोचेल हे, एने ता मारो जीव लेणेन होदतेह।” <verse eid="ROM 11:3"/><verse number="4" style="v" sid="ROM 11:4"/>पुण बोगवाना फाय रेन ताह काय जापाप जुड़नो? “मी मार केरता हात एजार एदम्याह मेल रिनोह, जा जुठा बाल देवतान ओंगाण गुटण्या नाह टेकाड़ेल सोता।” <verse eid="ROM 11:4"/><verse number="5" style="v" sid="ROM 11:5"/>इहीचकेरीन ज्या टेमाम बी गीण से निवाड़ेल थोड़ाक माणहे बाकी हेते। <verse eid="ROM 11:5"/><verse number="6" style="v" sid="ROM 11:6"/>केदी ज्य गीण से ईयेल हे, ताहार ओवतो कामा केरीन नाह; नाहते गीणुस गीण नाह रेन्यु।<verse eid="ROM 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 11:7"/>ते काय ईनो? ज्य काय इस्राएली जान होद माय एता, तो ताह नाह सापेड़नो; पुण निवाड़ेलाह सापेड़नो, एने बाकीन माणहे कठोर केराय गीया। <verse eid="ROM 11:7"/><verse number="8" style="v" sid="ROM 11:8"/>जिहकेरीन लिखेल हे, “बोगवान तान मोनाह आजीन दिह वोर बारी निंद माय टाक मीलेल हे, देखाय नाय ओहला डोला, एने होमलाय नाय ओहला कान आप्यो।” <verse eid="ROM 11:8"/><verse number="9" style="v" sid="ROM 11:9"/>एने दाऊद किथे, “तान खाणो तानकेरता जाल एने फासा एने ठोकेर एने डेंडान कारेण एय जाय। <verse eid="ROM 11:9"/><verse number="10" style="v" sid="ROM 11:10"/>तान डोला माय आदारो सावाय जाय काय नाय देखी, एने तु कायेम तान सेरीराह वाकाड़ीन मेल।”<verse eid="ROM 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11"/>केरीन मी केथु काय ता पोड़नेन केरता ठोकेर खाईल? केदिस नाह! पुण तान पोड़नेन वोजेसे बिगेर यहुदिह सुटकारो जुड़नो, काय ताह एतखाय एय। <verse eid="ROM 11:11"/><verse number="12" style="v" sid="ROM 11:12"/>तानकेरता केदी तान पोड़नो दुनियान केरता मालदेन एने तान कोमी बिगेर यहुदिन केरता मालदेनान कारेण ठेरानो, ताहार तान बोरपुरी केरीन काय कायच नाय एय।<verse eid="ROM 11:12"/></para>
  <para style="s">बिगेर यहुदिन सुटकारो</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 11:13"/>मी तुमूह बिगेर यहुदिह जी वातु केथु। जाह वोर मी बिगेर यहुदिन केरता प्रेरित हे, ताहार मी मारी सेवान बोड़ाय केरथु। <verse eid="ROM 11:13"/><verse number="14" style="v" sid="ROM 11:14"/>काहाकाय किहीक बी केरीन मी मारा कुटूम माय एतखाय पायदा केरीन ता माय रेन मोकतान सुटकारो केरावु। <verse eid="ROM 11:14"/><verse number="15" style="v" sid="ROM 11:15"/>काहाकाय बोगवानान द्‍वारा जेवी तान नाकारनो ज्याकेरीन बोगवाना हेऱ्यो मेल मिलाप ईथे ताहार तान मेल दुनियान मेल मीलापान कारेण एनो, ताहार काय तान स्वीकार केराय जाणे ज्य तान मुरेल माय रेन जीव उठणेन बाराबोर नाय एय?<verse eid="ROM 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 11:16"/>जेवी बेटीन पेल्लो मुठ चोखालो ठेरानो, ताहार पुरो कुहणेल फिट बी चोखालो हे; एने जेवी मुल चोखालो ठेरानो, ताहार डालख्यु बी ओहल्युस हेत्यु।<verse eid="ROM 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 11:17"/>पुण केदी थोड्युक डालख्यु तोड़ाय जात्यु, एने तु जेंगली जेतुन एन ता माय साटाय गीयो, एने जेतुनान मुलान हाजाला रूहान बागी ईयेल हे, <verse eid="ROM 11:17"/><verse number="18" style="v" sid="ROM 11:18"/>ताहार डालख्यु पोर गोमेंड मा किरहे; एने केदी तु गोमेंड किरहे ताहार एर मेल काय तु मुलाह नाह पुण मुल तुवाह होमालेह। <verse eid="ROM 11:18"/><verse number="19" style="v" sid="ROM 11:19"/>उवतो तु किहे, “डालख्यु ज्यानकेरता तोड़ाय गीयो काय मी साटाय जाव।” <verse eid="ROM 11:19"/><verse number="20" style="v" sid="ROM 11:20"/>ठिक हे, ता ते बुरहो केरनेन वोजेसे तोड़ाय गीया, पुण तु बोरहा से टिकीन रीथे तानकेरता मोठलाय मा केरी, पुण बिय मानजे, <verse eid="ROM 11:20"/><verse number="21" style="v" sid="ROM 11:21"/>काहाकाय केदी बोगवान होबात्यु डालख्युह नाह सोड्यो ते तुवाह बी नाय सोड़ी। <verse eid="ROM 11:21"/><verse number="22" style="v" sid="ROM 11:22"/>तानकेरता बोगवानान गीण एने काठापोणाह दिखो! जा पोड़ गीया ता पोर काठोपोणा, पुण तार पोर गीण, केदी तु ता माय बोणीन रिहे ते ठिक हे नाह ते तु बी काटाय जाहे। <verse eid="ROM 11:22"/><verse number="23" style="v" sid="ROM 11:23"/>ता बी केदी विण बोरहा माय नाय रेती, ताहार जोड़ाय जाती; काहाकाय बोगवान ताकेतवालो हे काय ताह पोशो जोड़ सेकी। <verse eid="ROM 11:23"/><verse number="24" style="v" sid="ROM 11:24"/>काहाकाय केदी तु ता जेतुना से, जो सोबाव से जेंगली हे, काटाय गीयो एने सोबावान विरोद हाजाला जेतुनाम जोड़ाय गीयो, ताहार ज्‍यु हाजाल्यु डालख्यु हेत्यु, तास ने जेतुनाम काहा नाय जोड़ाय जाती।<verse eid="ROM 11:24"/></para>
  <para style="s">आखा इस्राएल माणहान सुटकारो</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25"/>एय बाय बोणहा, मी नाह होदित काय तुमू सोताह बुद्दीवाला सोमजीन ज्या रहस्य से एंजाणल्या रिहो काय जाह वोर बिगेर यहुदि पुरान पुरा रिग नाय जाती, ताह वोर इस्राएलान एक बाग इहीचकेरीन काठो रेय। <verse eid="ROM 11:25"/><verse number="26" style="v" sid="ROM 11:26"/>एने इहकेरीन आखा इस्राएल माणहान सुटकारो एय। जिहकेरीन लिखेल हे, “सोड़ेवणार सियोन माय रेन आवी, एने विणबोकत्याह याकुबान वोचीह रेन सेटो केरी; <verse eid="ROM 11:26"/><verse number="27" style="v" sid="ROM 11:27"/>एने ता हेऱ्यो मारो ज्योस वायदो बोणीन रेय, जेवी मी तान पापाह सेटो केर देह।” <verse eid="ROM 11:27"/><verse number="28" style="v" sid="ROM 11:28"/>काहाकाय ता हाजाली खोबरीन नाकार्‍या एने बिगेर यहुदिन वोजेसे यहुदि बोगवानान दुसमोन एना नेजरी माय ते ता तुमरी केरता बोगवानान दुसमोन हेते, पुण निवाड़ाय जाणेन वोजेसे एने तान डायडायान वोजेसे मोंगाल्ला हेते। <verse eid="ROM 11:28"/><verse number="29" style="v" sid="ROM 11:29"/>काहाकाय बोगवान केदी नाह बोदेलने एने तान चुनाव एने वरदान एने हादावणी मोजबुत हे। <verse eid="ROM 11:29"/><verse number="30" style="v" sid="ROM 11:30"/>काहाकाय जिहकेरीन तुमू पेल बोगवानान उकुम नाह मान्या, पुण एवी यहुदिन उकुम नाह माणने से तुमरी पोर किव एनी; <verse eid="ROM 11:30"/><verse number="31" style="v" sid="ROM 11:31"/><note caller="+" style="f"><char style="fr" closed="false">11:31 </char><char style="ft" closed="false">थोड़ाक लेख माय एवी नाह लिखेल हे।</char></note>तिहेच केरीन ता बी एवी उकुम नाह मान्या, काय तुमरी पोर जी किव ईथे ज्याकेरीन ता पोर बी किव एय। <verse eid="ROM 11:31"/><verse number="32" style="v" sid="ROM 11:32"/>काहाकाय बोगवान आखाह उकुम नाह मान्ने माय बोंद केरीन मीलेल हे, काहाकाय तो आखा पोर किव केरी।<verse eid="ROM 11:32"/></para>
  <para style="s">बोगवानान बोड़ाय</para>
  <para style="p">
    <verse number="33" style="v" sid="ROM 11:33"/>आहा! बोगवानान मालदेन, बुद्दी एने इकेल कोलीक गंबीर हे! तान निर्णयाह स्पष्ट विचार कोहला अथाह, एने तान वाट कोहली अगम हे! <verse eid="ROM 11:33"/><verse number="34" style="v" sid="ROM 11:34"/>चोखाली पुस्तेक ज्य किथे, “मालीकान बुद्दीह कुण ओलख्यो? एने तान मोंत्री कुण बोणनो? <verse eid="ROM 11:34"/><verse number="35" style="v" sid="ROM 11:35"/>काय एगदो बोगवानाह काह आपेल हे जाह तो पोशो आपी?” <verse eid="ROM 11:35"/><verse number="36" style="v" sid="ROM 11:36"/><note caller="+" style="x"><char style="xo" closed="false">11:36 </char><char style="xt" closed="false"><ref loc="1CO 8:6">1 कुरिंथीयो 8:6</ref></char></note>काहाकाय तास ने उगे रेन, एने तान द्‍वारा, एने तास ने केरता एने तास ने द्‍वारा बाणायेल हे तान बोड़ाय जेलेम ईती रेय आमेन।<verse eid="ROM 11:36"/></para>
  <chapter eid="ROM 11"/>
  <chapter number="12" style="c" sid="ROM 12"/>
  <para style="s">बोगवानान सेवान जीवाय</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1"/>तानकेरता एय बाय बोणहा, मी तुमूह बोगवानान किव एर केरावीन तुमूह विन्ता केरथु काय तुमरा सेरीराह जीवताला, एने चोखालो, एने बोगवानाह पोटे ओहलोह बोली केरीन चेड़ावो। ज्‍यीस तुमरी आत्मिक सेवा हे। <verse eid="ROM 12:1"/><verse number="2" style="v" sid="ROM 12:2"/>ज्यी दुनियान गेत मा बुणो; पुण तुमरा मोनान नोवाला एय जाणे से तुमरो बोलनो चालनो बी बोदेलती जाय, जाकेरीन तुमू बोगवानान हाजाली, एने पोटनार, एने सिद्द आसा अनुबव केरीन मालुम केरती रिवो।<verse eid="ROM 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 12:3"/>काहाकाय मी ती गीणीन वोजेसे जी माहु जुड़ेल हे, तुमरे माय रेन आखाह केथु काय जिहकेरीन सोमोजणु जुवे ताह रेन वोदार कुण बी सोताह नाय सोमजे; पुण जीहे बोगवान आखाह बोरहान परिणामान गेत वाट दियेल हे, तिहेच केरीन हाजाली बुद्दी हिऱ्यो सोताह सोमजे। <verse eid="ROM 12:3"/><verse number="4" style="v" sid="ROM 12:4"/><note caller="+" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="1CO 12:12">1 कुरिंथीयो 12:12</ref></char></note>काहाकाय जीहे आपणी एक सेरीर माय जुलूम होवटा अंग हेते, एने आखा अंगान एक हारको काम नाह; <verse eid="ROM 12:4"/><verse number="5" style="v" sid="ROM 12:5"/>तिहेच केरीन आपु जा जुलूम हेते, मसी माय एक सेरीर एन आपसाम एका दिहरान अंग हेते। <verse eid="ROM 12:5"/><verse number="6" style="v" sid="ROM 12:6"/><note caller="+" style="x"><char style="xo" closed="false">12:6 </char><char style="xt" closed="false"><ref loc="1CO 12:4-11">1 कुरिंथीयो 12:4-11</ref></char></note>जेवी ता गीणान गेत जो आपुह आपायेल हे, आपुह बात बातीन वरदान जुड़ेल हेते, ते जाह जाणाव केरनेन दान जुड़ेल हे, तो बोरहान परिणामान गेत जाणाव केरी; <verse eid="ROM 12:6"/><verse number="7" style="v" sid="ROM 12:7"/>केदी सेवा केरनेन दान जुड़ेल हे, ताहार सेवा माय लागेल रेय; केदी एगदो हिकाड़नार एय, तो हिकाड़ने माय लागेल रेय; <verse eid="ROM 12:7"/><verse number="8" style="v" sid="ROM 12:8"/>जो पारचार केरनार एय, तो पारचार केरने माय लागेल रेय; दान आपणार उत्साह से आपी; आदिकारी तान काम खुसी से केरी; जाह किव केरनेन दान हे तो खुसी से केरी।<verse eid="ROM 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 12:9"/>मोंग बिगेर कोपेट वालो रेय; बुराय से विरोद किरो; बोलाय माय लागेल रिवो। <verse eid="ROM 12:9"/><verse number="10" style="v" sid="ROM 12:10"/>बाय बोणहान मोंग केरीन एका दिहरा हेऱ्या मोंग मीलो; तुमू आखा जाणे दिहराह आदार से सोताह रेन हाजाह सोमजो। <verse eid="ROM 12:10"/><verse number="11" style="v" sid="ROM 12:11"/>कोसीत केरने माय आलह्या मा बोणी; आत्मिक उत्साह से बोराय रिवो; मालीकान सेवा केरती रिवो। <verse eid="ROM 12:11"/><verse number="12" style="v" sid="ROM 12:12"/>तुमरी आसा माय खुस रिवो; पिड़ाम दिर राखो; विन्ता माय कायेम लागेल रिवो। <verse eid="ROM 12:12"/><verse number="13" style="v" sid="ROM 12:13"/>मसी माणहाह जो काय जोरेवरी हे, ता माय तान मोदेक किरो; पावणाय केरने माय लागेल रिवो।<verse eid="ROM 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 12:14"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:14 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:44">मत्ती 5:44</ref>; <ref loc="LUK 6:28">लुका 6:28</ref></char>
    </note>तुमरा सेतावणाराह बोरकेत आपो; पुण बोरकेतुस आपो हाराप मा आपो। <verse eid="ROM 12:14"/><verse number="15" style="v" sid="ROM 12:15"/>खुसी केरनारा हेऱ्या खुसी किरो, एने रेड़णारा हेऱ्या रिड़ो। <verse eid="ROM 12:15"/><verse number="16" style="v" sid="ROM 12:16"/><note caller="+" style="f"><char style="fr" closed="false">12:16 </char><char style="ft" closed="false">सादारण काम आराम माय किरो; नाहते सादारण माणहा हेऱ्या दोस्ती किरो।</char></note>आपसाम एक मोन राखो; मोठलाय मा किरो, पुण गेरब्या हेऱ्या ईलीमिलीन रिवो। तुमरी नेजरी माय सोताह बुद्दीमान मा सोमजो। <verse eid="ROM 12:16"/><verse number="17" style="v" sid="ROM 12:17"/>बुरायीन बोदले कुणीन बुराय मा किरो; ज्‍यु वातु आखान केरता हाज्यु हेत्यु त्युह केरनेन कोसीत किरो। <verse eid="ROM 12:17"/><verse number="18" style="v" sid="ROM 12:18"/>जा वोर तुमूह एय सेकी, तोलो आखा माणहा हेऱ्या मेल राखो। <verse eid="ROM 12:18"/><verse number="19" style="v" sid="ROM 12:19"/>एय मोंगाल्ला, बुदलो मा लिहो, पुण बोगवानान रागाह टेम आपो, काहाकाय लिखेल हे, “बुदलो लेणे मारो काम हे, मालीक किथे मीच बुदलो लेह।” <verse eid="ROM 12:19"/><verse number="20" style="v" sid="ROM 12:20"/>काहाकाय पुस्तेक माय किथे, “केदी तारो दुसमोन बुखल्यो एय ताहार ताह खाणो खावाड़, केदी तिहल्यो एय ताहार ताह पाणी पिवाड़; काहाकाय इहकेरीन केरने से तु तान मुंडी पोर आक्‍ठान ईंगालान डेर लागाड़हे।” <verse eid="ROM 12:20"/><verse number="21" style="v" sid="ROM 12:21"/>बुराय से मा आरो, पुण बोलाय से बुरायीह जिक लिवो।<verse eid="ROM 12:21"/></para>
  <chapter eid="ROM 12"/>
  <chapter number="13" style="c" sid="ROM 13"/>
  <para style="s">आदिकारान उकुम मान्नेन बाराम सुचना</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1"/>आखा माणहे देसान आदिकारीन ताबा माय रेय, काहाकाय काल्लो आदिकारी ओहलो नाह जो बोगवानान उगे रेन नाय रेय; एने जा आदिकारी हेते, ता बोगवानान ठेरायेल हेते। <verse eid="ROM 13:1"/><verse number="2" style="v" sid="ROM 13:2"/>तानकेरता जो कुण आदिकारान विरोद किरेह, तो बोगवानान नियाव ने सामनो किरेह, एने सामनो केरनारे डेंड बोकती। <verse eid="ROM 13:2"/><verse number="3" style="v" sid="ROM 13:3"/>काहाकाय हाजाला कामाह आदिकारीन बिय रेणे इही नाह, पुण खाराब कामाह रेणे, केरीन आदिकारीन बिय नाय रेणे जुवे ओहली तारी मोरजी एय, ताहार हाजो काम केर, जासे आदिकारीन द्‍वारा तारी बोड़ाय एय। <verse eid="ROM 13:3"/><verse number="4" style="v" sid="ROM 13:4"/>काहाकाय तो तारी बोलाय ने केरता बोगवानान सेवक हे। पुण केदी तु बुराय केरी, ताहार बिजे, काहाकाय तो तालवार व्यर्थ लीय रियेल नाह; तो बोगवानान सेवक हे, जो बोगवानान रागान गेत खाराब काम केरनाराह डेंड आपणार हे। <verse eid="ROM 13:4"/><verse number="5" style="v" sid="ROM 13:5"/>केरीन तुमू आदिकारीन उकुम मानो फोक्‍तो बोगवानान डेंडान वोजेसे नाह, पुण आपणा मोनान वोजेसे मान्नु हे। <verse eid="ROM 13:5"/><verse number="6" style="v" sid="ROM 13:6"/><note caller="+" style="x"><char style="xo" closed="false">13:6 </char><char style="xt" closed="false"><ref loc="MAT 22:21">मत्ती 22:21</ref>; <ref loc="MRK 12:17">मरकुस 12:17</ref>; <ref loc="LUK 20:25">लुका 20:25</ref></char></note>तानकेरता फालो बी आपो काहाकाय आदिकारी बोगवानान सेवक हेते एने जेलेम ज्यास कामा माय लागेल रेतेह। <verse eid="ROM 13:6"/><verse number="7" style="v" sid="ROM 13:7"/>तानकेरता जाह जो आपणु हे तो ताह आपो; जाह कर जुवेह, ताह कर आपो; जाह फालो जुवे, ताह फालो आपो; जाह मान्ने जुवे, ताह मानो; जान आदार केरने जुवे, तान आदार किरो।<verse eid="ROM 13:7"/></para>
  <para style="s">बाय बोणहान मोंग</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8"/>आपसान मोंगाह सोड़ीन उंजु एगदी वाती माय काल्लान केर्जावालो मा ईहे; काहाकाय जो दिहराह मोंग किरेह, तोस नेम पुरो किरेल हे। <verse eid="ROM 13:8"/><verse number="9" style="v" sid="ROM 13:9"/>काहाकाय ज्य काय “सिनालो मा किरहे, खुन मा किरहे, चोरी मा किरहे, लालुस मा किरहे,” एने ज्युह सोड़ीन उंजु काल्लो बी उकुम एय ताहार आखान सारांश ज्यी वातीम देखाय जाथे, “तारा आहेंल्याह तार गेत मोंग केर।” <verse eid="ROM 13:9"/><verse number="10" style="v" sid="ROM 13:10"/>मोंग तान हातीन केदी बुराय नाह केरने, तानकेरता मोंग केरने नेमाह पुरो केरने हे।<verse eid="ROM 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 13:11"/>टेमाह ओलखीन इहकेरीन किरो, ज्यानकेरता काय जेवी तुमरी केरता निंद माय रेन जाग उठणेन टेम आव पुचेल हे; काहाकाय जी टेम आपु बुरहो किरेल एता, ता टेमान विचार केरीन एवी आमरो सुटकारो आहने हे। <verse eid="ROM 13:11"/><verse number="12" style="v" sid="ROM 13:12"/>रात जुलूम एय जायेल हे, एने दिह उगणे माय हे; तानकेरता आपु आदारलान कामाह सोड़ीन उजालान आथ्‍यार बांद लिज्यो। <verse eid="ROM 13:12"/><verse number="13" style="v" sid="ROM 13:13"/>जीहे दिह्या होबा दिथे, तिहेच केरीन आपु हुतरी चाल चाले, नाह काय लीलाक्रिड़ा एने दारूड्यो पोणा माय, नाह सिनालो एने लुच्‍चाय माय, एने नाह राड़ एने कुयराय माय। <verse eid="ROM 13:13"/><verse number="14" style="v" sid="ROM 13:14"/>पुण तुमू यीशु मसीह पिर लिवो, एने सेरीरान अबिलाषाह पुरो केरनेन मोन मा लागाड़ो।<verse eid="ROM 13:14"/></para>
  <chapter eid="ROM 13"/>
  <chapter number="14" style="c" sid="ROM 14"/>
  <para style="s">एका दिहरा पोर दोस मा लागाड़ो</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">14:1 </char>
      <char style="xt" closed="false">
        <ref loc="COL 2:16">कुलीसियो 2:16</ref>
      </char>
    </note>जा बोरहाम कोमजोर हेते ताह आहने किरो, पुण तान व्यक्तिगत विचारा पोर बोलचाल केरने नाह। <verse eid="ROM 14:1"/><verse number="2" style="v" sid="ROM 14:2"/>एगदान बुरहो ओहलो रीथे काय, ताह कोहलो बी खाणो चालेह; पुण जो बोरहाम कोमजोर हे तो फोक्‍तो बाजी पालोस खाथे। <verse eid="ROM 14:2"/><verse number="3" style="v" sid="ROM 14:3"/>खाणार नाय खाणाराह नेचो जाणे, एने नाह खाणार खाणारा पोर दोस लागाड़े; काहाकाय बोगवान ताह आहने केर लियेल हे। <verse eid="ROM 14:3"/><verse number="4" style="v" sid="ROM 14:4"/>तु कुण हे जो दिहरान सेवका पोर दोस लागाड़ेह? तान स्थिर रेणे नाहते पोड़ जाणे तान मालीकान सावाल हे; पुण तो मोजबुत केराय जाय, काहाकाय मालीक ताह स्थिर मेल सिकेह।<verse eid="ROM 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 14:5"/>एगदो माणुह एगदो दिह दिहरा दिह्याह रेन जादा सोमेजतेह, एने एगदो आखा दिह्याह एक हारको मानेह। एकेक माणुह तास ने मोनाम निश्चय केर लेय। <verse eid="ROM 14:5"/><verse number="6" style="v" sid="ROM 14:6"/>जो एगदा दिह्याह खाज मानेह, तो मालीकान केरता मानेह। जो कुण आखो काय खाथे, तो मालीकान केरता खाथे, काहाकाय तो बोगवानान दन्यवाद किरेह, एने जो नाह खात, तो मालीकान केरता नाह खात एने बोगवानान दन्यवाद किरेह। <verse eid="ROM 14:6"/><verse number="7" style="v" sid="ROM 14:7"/>काहाकाय आपणी माय रेन कुण सोतान केरता जीवेत नाह एने कुण सोतान केरता मुरेत नाह। <verse eid="ROM 14:7"/><verse number="8" style="v" sid="ROM 14:8"/>केदी आपु जीवताला हेते, ताहार बोगवानान केरता जीवताला हेते; एने केदी मोरतेह, ताहार बोगवानान केरता मोरतेह; केरीन आपु जीवे नाहते मोरी, आपु मालीकास ने हेते। <verse eid="ROM 14:8"/><verse number="9" style="v" sid="ROM 14:9"/>काहाकाय मसी ज्यास ने केरता मोरनो एने जीव बी उठनो काय तो मुरेलान एने जीवतालान दुयून मालीक रेय।<verse eid="ROM 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 14:10"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">14:10 </char>
      <char style="xt" closed="false">
        <ref loc="2CO 5:10">2 कुरिंथीयो 5:10</ref>
      </char>
    </note>तु तारा बायाख पोर काहा दोस लागाड़ेह? नाहते तु पोशो काहा तारा बायाख नेचो जाणेह? आपु आखान आखा बोगवानान नियाव गादिन सामने उब रेहु। <verse eid="ROM 14:10"/><verse number="11" style="v" sid="ROM 14:11"/>काहाकाय लिखेल हे, “मालीक किथे, मार जीवणान सुगोण काय एकेक जाण गुटण्या मार सामने टेकेवती, एने एकेक जिब बोगवानान बोड़ाय केरी।” <verse eid="ROM 14:11"/><verse number="12" style="v" sid="ROM 14:12"/>तानकेरता आपणे माय रेन एकेक जाण बोगवानाह तान तान ईसाब आपी।<verse eid="ROM 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13"/>केरीन ओंगाण आपु एका दिहरा पोर दोस नाय लागाड़े, पुण तुमू ज्य ठाण लिवो काय कुण आपणा बायाख ने सामने एड़चेन नाहते ठोकेर खाणेन कारेण नाय बोणी। <verse eid="ROM 14:13"/><verse number="14" style="v" sid="ROM 14:14"/>माहु मालुम हे एने मालीक यीशु माय माहु बुरहो ईयेल हे काय काल्लो खाणो सोता माय एठो नाह, पुण जो ताह एठो सोमजेह तानकेरता एठो हे। <verse eid="ROM 14:14"/><verse number="15" style="v" sid="ROM 14:15"/>केदी तारो बाहख तारा खाणान वोजेसे नाराज ईथे, ओवतो ताहार तु मोंगान रिती पोर नाह चालेत; जान केरता मसी मोरनो, ताह तु तारा खाणान द्‍वारा दुख मा पोचाड़ी। <verse eid="ROM 14:15"/><verse number="16" style="v" sid="ROM 14:16"/>केरीन जाह तुमू हाजो सोमेजतेह ताह कुणीह तुमरी केरता जो हाजो हे तान चिहटा नाय एणे जुवे। <verse eid="ROM 14:16"/><verse number="17" style="v" sid="ROM 14:17"/>काहाकाय बोगवानान राज खाणे पिणे नाह, पुण देरमी पोण मेल एने ती खुसी हे जी चोखाला जीवा केरीन ईथे। <verse eid="ROM 14:17"/><verse number="18" style="v" sid="ROM 14:18"/>जो कुण इहकेरीन मसीन सेवा किरेह, तो बोगवान स्वीकारेह एने माणहाह पुटेह। <verse eid="ROM 14:18"/><verse number="19" style="v" sid="ROM 14:19"/><note caller="+" style="f"><char style="fr" closed="false">14:19 </char><char style="ft" closed="false">कायेम ओंगाण देखती रिवो; थोड़ाक लेख माय आमु आमरो देखणो कायेम ओंगाण मेलतेह।</char></note>तानकेरता आपु त्यु वातु माय कायेम लागेल रिज्यो जा माय मेल एने एका दिहरान उन्नती एय। <verse eid="ROM 14:19"/><verse number="20" style="v" sid="ROM 14:20"/>खाणान केरता बोगवानान कामाह मा बिगाड़े। आख्‍यु चिज चोख्यु ते हेत्यु, पुण ता माणहान केरता खाराब हे जाह तान खाणा केरीन ठोकेर लागेह। <verse eid="ROM 14:20"/><verse number="21" style="v" sid="ROM 14:21"/>हाजो ते ज्य हे काय तु माह नाय खाय एने अंगुरान रूह नाय पिय, नाह उंजु ओहलो काम केरी जाकेरीन तारा बोरहावाला बायाख ठोकेर लागी। <verse eid="ROM 14:21"/><verse number="22" style="v" sid="ROM 14:22"/>तारो जो बुरहो एय, ताह बोगवानान सामने तारास मोनाम मेल। तुवाह जो काय पुटेह तान बाराम जो सोताह दोस नाह लागाड़ेत तो बोरकेतवालो हे। <verse eid="ROM 14:22"/><verse number="23" style="v" sid="ROM 14:23"/>पुण जा माणहे सेंका केरीन खाथे ताहार ता दोसी ठेराथे, काहाकाय तान खाणो बोरहा केरीन नाह; एने जो काय बोरहा केरीन नाह, तो पाप हे।<verse eid="ROM 14:23"/></para>
  <chapter eid="ROM 14"/>
  <chapter number="15" style="c" sid="ROM 15"/>
  <para style="s">दिहरान फायदो किरो</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1"/>आपु जा ताकेतवोर हेते, ता आपणा हुका उगे नाह देखता कोमजोरान कोमजोरीह वेठी। <verse eid="ROM 15:1"/><verse number="2" style="v" sid="ROM 15:2"/>आपणे माय रेन एकेक जाण आपणा आहेंल्याह तान बोलाय ने केरता खुस केरी काय तान बोरहा माय उन्नती एय। <verse eid="ROM 15:2"/><verse number="3" style="v" sid="ROM 15:3"/>काहाकाय मसी बी सोतान हुका उगे नाह दिख्यो, पुण जीहे लिखेल हे: “तार चिहटा केरनारे किरेल चिहटा मार पोर आवी।” <verse eid="ROM 15:3"/><verse number="4" style="v" sid="ROM 15:4"/>जोल्युक वातु पेलुस रेन लेखायेल, त्यु आपणीस हिक ने केरता लेखाय जायेल हे काय आपु दिर एने पुस्तेक प्रोत्साहन द्‍वारा आसा मीले। <verse eid="ROM 15:4"/><verse number="5" style="v" sid="ROM 15:5"/>एवी बोगवान जो दिर एने प्रोत्साहन आपेह, तुमूह ओहलो वरदान आपी काय तुमू यीशु मसीन गेत आपसाम एक मोन रिवो। <verse eid="ROM 15:5"/><verse number="6" style="v" sid="ROM 15:6"/>काहाकाय तुमू एक मोन एने एक सुर माय आपणो मालीक यीशु मसीह आबाख बोगवानान बोड़ाय केरी।<verse eid="ROM 15:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7"/>तानकेरता, जीहे मसी बोगवानान बोड़ायीन केरता तुमूह स्वीकार किरेल हे, तिहेस केरीन तुमू बी एका दिहराह स्वीकार किरो। <verse eid="ROM 15:7"/><verse number="8" style="v" sid="ROM 15:8"/>तानकेरता मी केथु काय जा उकुम डायडायाह आपेल एता ताह मोजबुत केरनेन केरता मसी, बोगवानान खेरायीह देखाड़नेन केरता, यहुदि माणहान सेवक बोणी। <verse eid="ROM 15:8"/><verse number="9" style="v" sid="ROM 15:9"/>एने बिगेर यहुदि बी किवीन वोजेसे बोगवानान बोड़ाय केरी; जीहे लिखेल हे, “तानकेरता मी जाती जाती माय तारो दन्यवाद केरूह, एने तारा नावान बजन गावुह।” <verse eid="ROM 15:9"/><verse number="10" style="v" sid="ROM 15:10"/>पोशो तो किथे, “एय बिगेर यहुदि माणहे, तान माणहा हेऱ्या खुसी मोणावो।” <verse eid="ROM 15:10"/><verse number="11" style="v" sid="ROM 15:11"/>एने उंजु किथे, “एय जाती जातीन आखा माणहे, मालीकान बोड़ाय किरो; एने एय राज राज ने आखा माणहे, तान बोड़ाय किरो।” <verse eid="ROM 15:11"/><verse number="12" style="v" sid="ROM 15:12"/>एने उंजु यशाया किथे, “यीशेन एक मुल देखाय, एने बिगेर यहुदिन आदिकारी बोणनेन केरता उबरेय, ता पोर बिगेर यहुदि आसा मेलती।”<verse eid="ROM 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 15:13"/>एवी आसान बोगवान तुमूह बुरहो केरने माय पुरी खुसी एने सान्ती केरीन पुरो केरी, जाकेरीन चोखाला जीवान ताकेत केरीन तुमरी आसा वोदते जाय।<verse eid="ROM 15:13"/></para>
  <para style="s">पौलुसान बिगेर यहुदि माय सेवा</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14"/>एय मारा बाय बोणहा, मी खुद तुमरी बाराम खेरीच जाणथो काय तुमू बी सोता बोलाय केरीन बोरायेल एने बोगवानान एकली केरीन पुरा हेते, एने एका दिहराह सोमजाड़ सेकतेह। <verse eid="ROM 15:14"/><verse number="15" style="v" sid="ROM 15:15"/>तीबी मी तुमूह थोड़ो थोड़ो एर केरावणेन केरता जुलूम ईमोत केरीन लिखेल हे। ज्य ता गीणान वोजेसे एनो जो बोगवान माहु आपेल हे। <verse eid="ROM 15:15"/><verse number="16" style="v" sid="ROM 15:16"/>काय मी बिगेर यहुदिन केरता मसी यीशुन सेवक बोणीन बोगवानान हाजाली खोबरीन सेवा चाकर्‍यान गेत केरू, जाकेरीन बिगेर यहुदिन चेड़ावणो, चोखाला जीवा केरीन चोखालो बोणीन समर्पित केराय जाय। <verse eid="ROM 15:16"/><verse number="17" style="v" sid="ROM 15:17"/>तानकेरता त्यु वातुन बाराम ज्‍यु बोगवाना हेऱ्यो समंद मेलत्युह, मी मसी यीशु माय बोड़ाय केर सेकथु। <verse eid="ROM 15:17"/><verse number="18" style="v" sid="ROM 15:18"/>काहाकाय त्यु वातुह सोड़ीन मी दिहरी एगदी वातीम केणेन ईमोत नाय केरू जो मसी बिगेर यहुदिन उकुम मान्नेन केरता वचन एने कामा केरीन, <verse eid="ROM 15:18"/><verse number="19" style="v" sid="ROM 15:19"/>निसाणी, एने अद्बुत कामान ताकेत केरीन, एने चोखाला जीवान ताकेत केरीन मारीस द्‍वारा किरेल; न्या वोर काय मी यरूशलेम रेन कावदेन इल्लुरीकुम वोर मसीन हाजाली खोबरीन पुरो पुरो पारचार किऱ्यो। <verse eid="ROM 15:19"/><verse number="20" style="v" sid="ROM 15:20"/>पुण मारा मोनान मोरजी ज्यी हे काय जाहरी जाहरी मसीन नाव नाह पोचनो, ताहरी हाजाली खुबेर होमलाडु ओहलो नाय एय काय दिहरान पाया पोर गेर बाणावु। <verse eid="ROM 15:20"/><verse number="21" style="v" sid="ROM 15:21"/>पुण जिहकेरीन पुस्तेक माय लिखेल हे तिहेच केरीन एय, “जाह यीशुन हाजाली खुबेर नाह पोचनो, ता देखती एने जा नाह होमल्या ता सोमेजती।”<verse eid="ROM 15:21"/></para>
  <para style="s">रोम यात्रान पौलुसान योजना</para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 15:22"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">15:22 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 1:13">रोमीयो 1:13</ref>
      </char>
    </note>तानकेरता माहु तुमरी फाय आवणेन जुलूम वारीन रोकाय रिनो। <verse eid="ROM 15:22"/><verse number="23" style="v" sid="ROM 15:23"/>पुण एवी ज्या देसा माय मारा कामान केरता जागो नाह रिनो, एने जुलूम वोरह्या रेन माहु तुमरे फाय आवणेन लालसा हे। <verse eid="ROM 15:23"/><verse number="24" style="v" sid="ROM 15:24"/>तानकेरता जेवी मी स्पेन माय जाह ताहार तुमरी फाय लागतोन जाह, काहाकाय माहु आसा हे काय ती यात्रा माय तुमू हेरी बेट एय, एने जेवी तुमरी संगती केरीन मारो जीव खुसी केरीन थोड़ोक बोराय जाय ताहार तुमू माहु थोड़ोक ओंगाण पोचाड़ दिज्यो। <verse eid="ROM 15:24"/><verse number="25" style="v" sid="ROM 15:25"/><note caller="+" style="x"><char style="xo" closed="false">15:25 </char><char style="xt" closed="false"><ref loc="1CO 16:1-4">1 कुरिंथीयो 16:1-4</ref></char></note>पुण एवी ते मी बोगवानान माणहान सेवा केरनेन केरता यरूशलेम माय जाथु। <verse eid="ROM 15:25"/><verse number="26" style="v" sid="ROM 15:26"/>काहाकाय मकादुनिया एने आखायान माणहाह ज्य हाजो लागो काय यरूशलेमान बोगवानान माणहा माय गोर गेरीबान केरता थोड़ोक फालो केरी। <verse eid="ROM 15:26"/><verse number="27" style="v" sid="ROM 15:27"/><note caller="+" style="x"><char style="xo" closed="false">15:27 </char><char style="xt" closed="false"><ref loc="1CO 9:11">1 कुरिंथीयो 9:11</ref></char></note>ताह हाजो ते लागो, पुण ता तान केर्जावाला बी हेते, काहाकाय केदी बिगेर यहुदि तान आत्मिक वातु माय बागी एना, ताहार ताह बी जोरेवरी हे काय सारिरीक वातु माय तान सेवा केरी। <verse eid="ROM 15:27"/><verse number="28" style="v" sid="ROM 15:28"/>तानकेरता मी ज्यो काम पुरो केरीन एने ताह तो फालो होपीन तुमरी फाय लागतोन स्पेन माय जाह। <verse eid="ROM 15:28"/><verse number="29" style="v" sid="ROM 15:29"/>एने मी जाणथो काय जेवी मी तुमरी फाय आवुह, ताहार मसीन पुरो बोरकेत हिऱ्यो आवुह।<verse eid="ROM 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 15:30"/>एय बाय बोणहा, आपणा मालीक यीशु मसीन उगे चोखाला जीवान मोंगान एर केरावीन मी तुमूह विन्ता केरथु, काय मार केरता बोगवाना फाय विन्ता केरने माय मार हेऱ्या मिलीन लागीन रिवो, <verse eid="ROM 15:30"/><verse number="31" style="v" sid="ROM 15:31"/>काय मी यहुदियान अविश्वासी से वोचीन रेव, एने मारी ती सेवा जी यरूशलेमान केरता हे, बोगवानान माणहाह पोटे; <verse eid="ROM 15:31"/><verse number="32" style="v" sid="ROM 15:32"/>एने मी बोगवानान मोरजी से तुमरी फाय खुसी माय आवीन तुमरी हिऱ्यो आराम सापड़ावु। <verse eid="ROM 15:32"/><verse number="33" style="v" sid="ROM 15:33"/>सान्तीन बोगवान तुमरे आखा हिऱ्यो रेय। आमेन।<verse eid="ROM 15:33"/></para>
  <chapter eid="ROM 15"/>
  <chapter number="16" style="c" sid="ROM 16"/>
  <para style="s">पौलुसान दोस्तीदाराह नमस्‍कार</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1"/>मी तुमूह आमरी बोणीख फीबेन केरता विन्ता केरथु, जी किंख्रियान मोंडलीन सेविका हे, <verse eid="ROM 16:1"/><verse number="2" style="v" sid="ROM 16:2"/>काय तुमू मालीक माय ताह इहकेरीन स्वीकार किरो जीहे चोखाला माणहाह केरतेह, एने केदी एगदा कामा माय ताह तुमरी जोरेवरी एय ताहार तान मोदेक किरो, काहाकाय ता सोता जुलूम जाणाह एने मारो बी मोदेक केरनार इहकेरीन ईयेल हे।<verse eid="ROM 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 16:3"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:3 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:2">प्रेरितान काम 18:2</ref>
      </char>
    </note>प्रिस्‍का एने अक्विलाह ज्या मसी यीशु माय मारा सहकर्मी हेते, नमस्‍कार। <verse eid="ROM 16:3"/><verse number="4" style="v" sid="ROM 16:4"/>ता मारा जीवान केरता सोतान जीव दोका माय टाक दियेल एता, एने फोक्‍तो मीच नाह, पुण बिगेर यहुदिन आखी मोंडली बी तान दन्यवाद किरेह। <verse eid="ROM 16:4"/><verse number="5" style="v" sid="ROM 16:5"/>ती मोंडलीह बी नमस्‍कार जी तान गेरा माय हे। मारा मोंगाल्ला इपेनीतुसाह, जो मसीन केरता आसीयान पेल्लो फोल हे, नमस्‍कार। <verse eid="ROM 16:5"/><verse number="6" style="v" sid="ROM 16:6"/>मरीयम, जी तुमरी केरता जुलूम मेहनेत किरेल हे, नमस्‍कार। <verse eid="ROM 16:6"/><verse number="7" style="v" sid="ROM 16:7"/><note caller="+" style="f"><char style="fr" closed="false">16:7 </char><char style="ft" closed="false">युनिया; नाहते युनियास; थोड़ाक लेख माय युलिया। </char></note>मारा गेरल्या अन्द्रनीकुस एने युनियास जा मार हेऱ्या जेली माय एता, एने प्रेरिता माय नाव लायेल हेते, एने माहु रेन पेल मसी माय एता, नमस्‍कार। <verse eid="ROM 16:7"/><verse number="8" style="v" sid="ROM 16:8"/>मालीक माय मारो मोंगाल्लो अम्पलीयातुसाह नमस्‍कार। <verse eid="ROM 16:8"/><verse number="9" style="v" sid="ROM 16:9"/>मसी माय आमरो सहकर्मी उरबानुसाह एने मारा मोंगाल्लो इस्तखुसाह नमस्‍कार। <verse eid="ROM 16:9"/><verse number="10" style="v" sid="ROM 16:10"/>अपुल्लोसाह जो मसीम खेरलो निकेलनो, नमस्‍कार। अरीस्तुबुलूसान गेराणाह नमस्‍कार। <verse eid="ROM 16:10"/><verse number="11" style="v" sid="ROM 16:11"/>मारा गेरल्‍याह हेरोदियोनाह नमस्‍कार। नरकिसुस ने गेराणान जा माणहे मालीक माय हेते, ताह नमस्‍कार। <verse eid="ROM 16:11"/><verse number="12" style="v" sid="ROM 16:12"/>मालीक माय मेहनेत केरनारी त्रुफेना एने त्रुफोसाह नमस्‍कार। मोंगाल्लो पिरसीसाह, जो मालीक माय केठीण मेहनेत किरेल हे, नमस्‍कार। <verse eid="ROM 16:12"/><verse number="13" style="v" sid="ROM 16:13"/><note caller="+" style="x"><char style="xo" closed="false">16:13 </char><char style="xt" closed="false"><ref loc="MRK 15:21">मरकुस 15:21</ref></char></note>मालीक माय निवड़ायेल रूफुसाह एने तान आईख, जी मारी बी आहख हे, नमस्‍कार। <verse eid="ROM 16:13"/><verse number="14" style="v" sid="ROM 16:14"/>असुंक्रितुस, फिलेगोन, हिरमेस, पत्रुबास, हिरमास न्याह एने ता हेऱ्या जा मसी बाहख हेते ताह नमस्‍कार। <verse eid="ROM 16:14"/><verse number="15" style="v" sid="ROM 16:15"/>फिलुलूगुस, युलिया, नेर्‍युस एने तान बोणीख उलुम्पास न्याह एने ता हेऱ्या जा बोगवानान माणहे हेते, ता आखाह नमस्‍कार। <verse eid="ROM 16:15"/><verse number="16" style="v" sid="ROM 16:16"/>गेले मिलीन एकमेकाह नमस्‍कार किरो। तुमूह मसीन आखी मोंडलीन उगे रेन नमस्‍कार।<verse eid="ROM 16:16"/></para>
  <para style="s">सेवल्यो ईसारो</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17"/>एवी एय बाय बोणहा, मी तुमूह विन्ता केरथु, काय जा माणहे ती हिकवोणीन विरोद, जी तुमू सापड़ायेल हेते, ता माय जा माणहे फुट एने ठोकेर खावाड़नेन कारेण बोणतेह, ता पोर नेजेर मीलो एने ताह रेन सेटा रिवो। <verse eid="ROM 16:17"/><verse number="18" style="v" sid="ROM 16:18"/>काहाकाय ओहला माणहे आपणा मालीक मसीन नाह, पुण सोतान पेटान सेवा केरतेह; एने मोट मोठ्यु वातु से सीदा सादा मोनान माणहाह बोटकाव देतेह। <verse eid="ROM 16:18"/><verse number="19" style="v" sid="ROM 16:19"/>तुमरे उकुम मान्नेन चेरचा आखा माणहा माय पोसीर जायेल हे, तानकेरता मी तुमरे बाराम खुसी केरथु, पुण मी ज्यो होदथु काय तुमू बोलायीन केरता एकलीदार एने बुरायीन केरता बोला बोणीन रिवो। <verse eid="ROM 16:19"/><verse number="20" style="v" sid="ROM 16:20"/><note caller="+" style="f"><char style="fr" closed="false">16:20 </char><char style="ft" closed="false">थोड़ाक लेख माय ज्यो वाक्य नाह जुड़ेत</char></note>सान्तीन बोगवान बुतड़ाह तुमरा पाया बुंद उतवाल्योच केच्‍या वालाव देय। आपणा मालीक यीशु मसीन गीण तुमरी पोर ईती रेय।<verse eid="ROM 16:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 16:21"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:21 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 16:1">प्रेरितान काम 16:1</ref>
      </char>
    </note>मारो सहकर्मी तीमुथीयुस एने मारा यहुदि गेरल्या लुकियुस, यासोन एने सोसीपत्रुसान तुमूह नमस्‍कार।<verse eid="ROM 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 16:22"/>ज्या पोत्राह लेखणार मी तीरतीयुसान, मालीक माय तुमूह नमस्‍कार।<verse eid="ROM 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 16:23"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:23 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:29">प्रेरितान काम 19:29</ref>; <ref loc="1CO 1:14">1 कुरिंथीयो 1:14</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="2TI 4:20">2 तीमुथीयुस 4:20</ref>
      </char>
    </note>गयुसान जो मारो एने मोंडलीन पावणाय केरनार हे, तान तुमूह नमस्‍कार। इरास्तुस जो हेयरान बण्‍डारी हे, एने बाहख क्वारतुसान तुमूह नमस्‍कार। <verse eid="ROM 16:23"/><verse number="24" style="v" sid="ROM 16:24"/>आपणो मालीक यीशु मसीन गीण तुमरे आखा हेऱ्यी रेय। आमेन।<note caller="+" style="f"><char style="fr" closed="false">16:24 </char><char style="ft" closed="false">दिहरा लेख माय ज्यो वचन नाह जुड़ेत; थोड़ाक लेख माय 27 ने पासाण ज्यो वचन टाकेल हे। </char></note><verse eid="ROM 16:24"/></para>
  <para style="s">बोगवानान बोड़ाय</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 16:25"/>ता बोगवानान बोड़ाय एय जो ता बोरहान गेत तुमूह मारी हाजाली खुबेर मतलब यीशु मसीन हिकवोणीन पारचारान गेत स्थिर केर सिकेह, ता बेदान उजालान गेत जो जेलेमक्योस लिकायेल ईतो। <verse eid="ROM 16:25"/><verse number="26" style="v" sid="ROM 16:26"/>पुण एवी देखीन जेलेमक्या बोगवानान उकुमा केरीन जाणकारान पुस्तेक ने द्‍वारा आख्‍यु जात्युह कियेल हे काय ता बुरहो केरीन उकुम मान्नारे एय जाय,<verse eid="ROM 16:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 16:27"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">16:27 </char>
      <char style="ft" closed="false">थोड़ाक लेख माय वचन 25-27 न्या एने 14:23 ने पासाण लिखेल हे; दिहरा लेख माय निस्तो 14:23 ने पासाण लिखेल हे; एक लेख माय 15:33 ने पासाण लिखेल हे। </char>
    </note>तास एकुस एकलीदार बोगवानान यीशु मसीन द्‍वारा जेलेम बोड़ाय ईती रेय। आमेन।<verse eid="ROM 16:27"/></para>
  <chapter eid="ROM 16"/>
</usx>
