<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MIC" style="id">- Nahali</book>
  <para style="h">मीका</para>
  <para style="toc3">मीका</para>
  <para style="toc2">मीका</para>
  <para style="toc1">मीका</para>
  <para style="mt2">मीका ने लिखी हुई किताब</para>
  <para style="mt1">मीका लिखेल पुस्तेक</para>
  <para style="imt">ओलखात</para>
  <para style="ip">निम्नलिखीत पुस्तेक माय मीकान जाणाव हे। मीका यहुदान एक हियोर मोरेशेत <char style="xt"><ref loc="MIC 1:1">1:1</ref></char> एने <char style="xt"><ref loc="JER 26:18">यिर्मया 26:18</ref></char> रेन इतो। तो यहुदान राजा योताम, आहाज एने हिजकियान राज ने कालाम जाणाव किऱ्यो। ज्यान मतलब हे काय तान सेवकाय कोमीत कोमी 750 यीशुन पेल ने विचीम एती, जी काय कोमीत कोमी तीस टेम हे जेवी यशाया एने होशे जाणाव किरेल एता। ज्य मालुम नाह सोतो काय मीका जी जाणाव लिख्यो नाहते तान एगदो चेलो तान केरता ओहलो किऱ्यो। मामलो जो बी एय, ज्य संबावना हे काय पुस्तेक 700 यीशुन पेल एने 608 यीशुन पेल ने विची माय लेखायेल एतो। काहाकाय ज्यान उल्लेख यिर्मयान पुस्तेक माय केरायेल हे।</para>
  <para style="ip">मीकान जाणाव बोगवानान नियाव एने तान सुटकारान विची माय ओंगाण पासाण एते रिथे। तो इस्राएल एने यहुदा पोर गेरब्या हिऱ्यो खाराब वेवार केरने एने लालची एणेन आरोप लागाड़ेह। <char style="xt"><ref loc="MIC 2:2">2:2</ref></char> तो तान जाणाव केरनारा पोर खाराब एणेन बी आरोप लागाड़ेह। <char style="xt"><ref loc="MIC 2:6">2:6</ref></char> केरीन, बोगवान तान हेयराह नास केर देय <char style="xt"><ref loc="MIC 1:6">1:6</ref></char> एने <char style="xt"><ref loc="MIC 3:12">3:12</ref></char> एने ताह इस्राएल से सेटो एने बाद माय यहुदा से बी बोंदी बाणावीन मोकली देय। पुण बोगवान तान वायदाह बी एर मेली एने थोड़ाक विश्वासीह वापस लावी। <char style="xt"><ref loc="MIC 4:6">4:6</ref></char> बोगवान बेथलेहेम रेन एक नेता, एक मसीहाह मोकेलनेन बी वायदो किऱ्यो, जो इस्राएल एने पुरी दुनिया पोर राज केरी। <char style="xt"><ref loc="MIC 5:4">5:4</ref></char> मीकान पुस्तेक आब्राहाम एने याकुब से बोगवानान वाचान वायदान एर केरावते लेन निवरेह। बोगवानान मोंग एने गीण तान रागाह रेन जादा ताकेतवोर हे।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. नियाव एने सुटकारान पेल्लो बाग हे। <char style="ior"><ref loc="MIC 1-2">1–2</ref></char></para>
  <para style="io1">2. नियाव एने सुटकारान दुसरो बाग हे। <char style="ior"><ref loc="MIC 3-5">3–5</ref></char></para>
  <para style="io1">3. नियाव एने सुटकारान तीसरो एने सेवल्यो बाग हे। <char style="ior"><ref loc="MIC 6-7">6–7</ref></char></para>
  <chapter number="1" style="c" sid="MIC 1" />
  <para style="p">
    <verse number="1" style="v" sid="MIC 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="2KI 15:32-38">2 राजा 15:32-38</ref>; <ref loc="2KI 16:1-20">16:1-20</ref>; <ref loc="2KI 18:1-21">18:1-21</ref>; <ref loc="2CH 27:1-7">2 इतिहास 27:1-7</ref>; <ref loc="2CH 28:1-27">28:1-27</ref>; <ref loc="2CH 29:1-33">29:1-33</ref></char>
    </note> बोगवानान वचन जो यहुदान राजा योताम, आहाज एने हिजकियान राज केरनेन दिह्याम मोरेशेत माय रेणार मीका फाय पोचनो, ज्य वचन सामरीया हियोर एने यरूशलेमान बाराम एतो ताह जुड़नो।<verse eid="MIC 1:1" /></para>
  <para style="s">सामरीया एने यरूशलेम ने केरता रेड़नो</para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 1:2" />एय देस देसान सोब माणहे, हुमलो!</para>
  <para style="q2" vid="MIC 1:2">एय देरती तु ता आखा हेऱ्यीच जा तार माय रेतेह,</para>
  <para style="q1" vid="MIC 1:2">द्यान दे! मालीक बोगवान तुमरी विरूद,</para>
  <para style="q2" vid="MIC 1:2">मतलब बोगवान तान चोखाली मोंदिर माय रेन तुमू पोर गोवाय देय।<verse eid="MIC 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 1:3" />काहाकाय बोगवान तान चोखाला जागाम रेन बाहेर निकेलने बाज रिनोह,</para>
  <para style="q2" vid="MIC 1:3">एने तो उतरीन देरतीन उचाला जागा पोर चाली।<verse eid="MIC 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 1:4" />ओवत्यु बाऱ्यु तान बुंदे रेन पिगली जाती</para>
  <para style="q2" vid="MIC 1:4">एने खोयरा ओहला फाटती,</para>
  <para style="q1" vid="MIC 1:4">जिह केरीन मेण आक्‍ठीन आसी केरीन</para>
  <para style="q2" vid="MIC 1:4">एने पाणी बारीम रेन निड़ो वुयेह।<verse eid="MIC 1:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="MIC 1:5" />ज्यो सोब याकुबान गुनान एने इस्राएलान गेराणान पापान कारेण इथे। याकुबान गुनो काय हे? काय सामरीया नाय मिले? एने यहुदान उचाला जागा काय हेते? काय यरूशलेम नाय मिले? <verse eid="MIC 1:5" /><verse number="6" style="v" sid="MIC 1:6" />केरीन बोगवान केयो, “मी सामरीयान चोवगान नास केर देह, एने अंगुरान बोगिचो बाणावुह एने मी तान देगड़ाह जोवराम उंडलाव देह, एने तान पायो उखाल देह। <verse eid="MIC 1:6" /><verse number="7" style="v" sid="MIC 1:7" />तान सोब गिड़ेल मुरत्यु बुकरा बुकरा केर देह; एने जो काय ती सिनालो केरीन कामायेल हे, तो आक्ठीम हेलगाड़ देह, तान सोब चित्राह चुरा चुरा केरूह, काहाकाय ती सिनालाच ने कामाय केरीन तो टुलो किरेल हे, एने ती सिनालान गेत कामाय बोण जाय।”<verse eid="MIC 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MIC 1:8" />तेवी मीका केयो, “मी साथी ठोकीन रेडुह एने दुख मोणावुह, मी बिगेर चाट्यान एने उगाड़लो फिऱ्या केरूह; मी कोल्यान गेत आयडुह, एने शहमुर्गान गेत रेडुह। <verse eid="MIC 1:8" /><verse number="9" style="v" sid="MIC 1:9" />काहाकाय तान जेखेम केदी नाय हुदरे; एने पिढ़ा यहुदा पोर बी आव पोड़नी, एने मारा माणहा पोर पोचीन यरूशलेमान फाटेक वोर पोच जाईल हे।”<verse eid="MIC 1:9" /></para>
  <para style="s">दुसमोनान यरूशलेम उगे वोड़नो</para>
  <para style="p">
    <verse number="10" style="v" sid="MIC 1:10" />गत हेयराम तान चेरचा मा किरो, एने मा रिड़ो; बेत आप्रा<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="fq" closed="false">बेत आप्रा </char><char style="ft" closed="false">रेजड़ावालो जागो</char></note> माय रेजड़ाम लुलो। <verse eid="MIC 1:10" /><verse number="11" style="v" sid="MIC 1:11" />एय शापीर हेयराम रेणारी उगाड़ली एन विण लाज्यीस जात रे। एय सनान हेयराम रेणारे तुमरा हेयराम रेन मा निकलो, बेतसेल हेयराम रेड़ने किकेलनेन कारेण तान आसरान जागो तुमरे माय रेन सांडाड़ाय जाय। <verse eid="MIC 1:11" /><verse number="12" style="v" sid="MIC 1:12" />काहाकाय मारोत हेयराम रेणारे ते मोदेक ने वाट जोवता जोवता गाबराय गीयाह, काहाकाय बोगवानान उगे रेन यरूशलेमान फाटेक वोर पिड़ा आव पुचेल हे। <verse eid="MIC 1:12" /><verse number="13" style="v" sid="MIC 1:13" />एय लाकीश माय रेणारी, तुमरा टांगाम जोरेस दोवेड़नारे गोड़ा जुपो; तारीच पोर रेन सियोनवाली पोरजान<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="fq" closed="false">सियोनवाली पोरजान </char><char style="ft" closed="false">सियोनान बेटी</char></note> पापान सुरवात एनी। काहाकाय इस्राएलान गुना तार माय सापेड़नाह। <verse eid="MIC 1:13" /><verse number="14" style="v" sid="MIC 1:14" />केरीन तु गत हेयरान मोरेशेताह बेट आपीन सिटो केर देय; अकजीब<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="fq" closed="false">अकजीब </char><char style="ft" closed="false">दुको</char></note> ने गेर रेन इस्राएलान राजा दुकोच खाती।<verse eid="MIC 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MIC 1:15" />एय मारेशा माय रेणारे, मी तुमरी विरूद एक एदम्याह लावुह जो तारी आखी वोस्तु सांडाड़ लेय, तेवी इस्राएलान मुखी माणहाह अदुल्लाम गुफा माय आवणे पोड़ी। <verse eid="MIC 1:15" /><verse number="16" style="v" sid="MIC 1:16" />तुमरा लाड़काला सोरान केरता लेट्या काटाड़ीन मुंड बोड़ाव, पुण तारो मुंड मोराग्यान गेत टाली केर दे, काहाकाय ता बोंदी बोणीन तार फाय रेन जात रियेल हेते।<verse eid="MIC 1:16" /></para>
  <chapter eid="MIC 1" />
  <chapter number="2" style="c" sid="MIC 2" />
  <para style="s">गेरब्या पोर अत्याचार केरनारान चिहटा</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 2:1" />हाय ता पोर जा आथरोणा माय लोटीन केल्पना केरतेह, एने खाराब कामान आसा केरतेह, एने तेगड़ा हेते केरीन वेगाच दिह उगताच ता ताह पुरा केरतेह। <verse eid="MIC 2:1" /><verse number="2" style="v" sid="MIC 2:2" />ता खेतान लालुच केरीन ताह सांडाड़ लेतेह; एने गेरान लालुच केरीन ताह बी सांडाड़ लेतेह, एने तान आहेंल्या माणहाह ठेग खातेह, एने तान डायडायान मालदेन लुट लेतेह।<verse eid="MIC 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MIC 2:3" />केरीन बोगवान इह केरीन किथे; “मी ज्या गेराणा पोर ओहली पिढ़ा टाकणे माय हे, जान बुंदे रेन तुमू वोस नाय सिकहो, एने नायते तुमरा मुंडाह उचा केरीन चाल सिकहो; काहाकाय ती पिड़ान टेम रेय। <verse eid="MIC 2:3" /><verse number="4" style="v" sid="MIC 2:4" />ती टेम माय ज्य जुलूम दुखान गीत किस्सान रिती माय गावाय जाय,”</para>
  <para style="b" vid="MIC 2:4" />
  <para style="q1" vid="MIC 2:4">आमरो आखो नुकसान एय गीयो; तो मारा माणहान बाग बिगाड़ेह, हाय,</para>
  <para style="q1" vid="MIC 2:4">तो ताह मार हिऱ्यो रेन कुलोक सिटो केर दिथे;</para>
  <para style="q1" vid="MIC 2:4">तो आमरा खेते दुको देणारान आथाम आप दिथे।<verse eid="MIC 2:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="MIC 2:5" />बोगवानान मोंडली माय चिट्ठी टाकीन एने बुई दोयड़ी केरीन मापीन वाटणार कुण नाह एनो, एने तुमूह बुयीन टुकड़ो बी नाय जुड़ी।<verse eid="MIC 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MIC 2:6" />तान जाणकार केतेह, “जाणाव मा किरो, ज्यु वातुन बाराम जाणाव मा किरो, काहाकाय एगदो आपमान वेठणे नाय पोड़ी। <verse eid="MIC 2:6" /><verse number="7" style="v" sid="MIC 2:7" />एय याकुबान गेराणा, काय ज्य केवाय जाय काय बोगवानान जीव माय दिर नाह रेनी? काय ज्य काम ताच ने किरेल हे? काय मारा वचना केरीन तान बोलो नाह ईत, जो हुतरो चालेह?”<verse eid="MIC 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MIC 2:8" />पुण कालीन वात हे काय मारी पोरजा दुसमोन बोणीन मार विरूद उठेल हे; तुमू ठावका एने बोलाबाला वाट चालु माणहान डिला पोर रेन चादरो सांडाड़ लेतेह, जा राड़ीन विचार नाह केरीन ठावकाच जात रेतेह। <verse eid="MIC 2:8" /><verse number="9" style="v" sid="MIC 2:9" />मारी पोरजान बायकुह तुमू त्युन हुकेह रेणेन गेराम रेन काड़ देतेह, एने त्युन आतल्या सोराह आपेल मारी हाजाल्यु वोस्तु, जेलेम तुमू सांडाड़ लेतेह। <verse eid="MIC 2:9" /><verse number="10" style="v" sid="MIC 2:10" />उठो जात रिवो; काहाकाय ज्यो तुमरो विहेवणेन जागो नाह सुतो; केरीन तो एठो हे जो केठीण दुखा माय तुमरो नास केरी।<verse eid="MIC 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MIC 2:11" />केदी एगदो जुठी जीव माय चालते लेन जुठी एने फालतुक वातु केय, एने केय काय मी तुमूह जेलेम अंगुरान रूह एने दारान केरता पारचार होमलाड़ती रेय, ते तोच न्या माणहान केरता जाणकार बोणी।<verse eid="MIC 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MIC 2:12" />एय याकुब, मी खेरीच तुमू सोबाह टुलो केरूह; मी इस्राएल ने वुचेल माणहाह एकठा केरूह, जीह केरीन मेंड्रा बोकड्या वाड़ाम एकठा केरनु, ता एक टोलान गेत हेते जा हाजा चारावाली बुय रेणे, ता माणहान गेरदीन कारेण कापाली केरती। <verse eid="MIC 2:12" /><verse number="13" style="v" sid="MIC 2:13" />तान ओंगाण ओंगाण वाड़ाह वेसेड़नार जाईल हे, केरीन ता बी ताह वेसड़ने बाज रेनाह, एने तान फाटकीम लागता निकेलने बाज रेनाह, तान राजा तान ओंगाण ओंगाण गीयो, मतलब बोगवाना तान अगुवा हे।<verse eid="MIC 2:13" /></para>
  <chapter eid="MIC 2" />
  <chapter number="3" style="c" sid="MIC 3" />
  <para style="s">मीकान द्वारा इस्राएल ने अगुवान चिहटा</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 3:1" />पुशो मी केयो, एय याकुबान मुखी, एय इस्राएलान गेराणान न्यायनिवाड़ो केरनारे हुमलो; न्यायनिवाड़ान लिकायेल वातु जाणने तुमरो काम नाह सोतो? <verse eid="MIC 3:1" /><verse number="2" style="v" sid="MIC 3:2" />तुमू ते बोलायीह दुसमोनी, एने बुरायीह मोंग केरतेह, सोमजो तुमू माणहा पोर रेन तान खाल, एने तान आड़ा पोर रेन तान माह लोस लेतेह; <verse eid="MIC 3:2" /><verse number="3" style="v" sid="MIC 3:3" />ओलोच नाह पुण तुमू मारा माणहान माह बी खाय लेतेह; तुमू तान आड़े तोपल्या माय चुड़ावणेन केरता चुरा चुरा केरतेह। <verse eid="MIC 3:3" /><verse number="4" style="v" sid="MIC 3:4" />ता दुख ने टेम माय बोगवानान विन्ता केरती, पुण तो तान नाय होमली, तो तान खाराब कामान केरता तान उगे रेन मुय वाल लेय।<verse eid="MIC 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 3:5" />बोगवानान ज्य वचन हे काय जा जाणकारे मारी पोरजाह बोटकाड़ देतेह, एने जुलबुखे ताह खाणेन जुड़ेह तुलबूखे सान्ती हे केरीन केतेह, एने केदी एगदो तान मुयाम काय नाय आपी ते तान विरूद लेड़ाय केरनेन केरता तियार एय जातेह। <verse eid="MIC 3:5" /><verse number="6" style="v" sid="MIC 3:6" />केरीन तुमू पोर ओहली रात आवी, काय तुमूह देरसेन नाय जुड़ी, एने तुमू ओहला आंदारा माय पुड़हो काय जाणाव नाय केर सिकहो, जाणकारान केरता दिह बुड़ जाय, एने दिह्याच ता पोर आंदारो सावाय जाय। <verse eid="MIC 3:6" /><verse number="7" style="v" sid="MIC 3:7" />देरसेन देखणारे लाजवाय जाती, एने जाणकारी हासील केरनारान मुय काला एय जाती; एने ता आखान आखा तान मुयाह ज्यान केरता डापती काय बोगवानान उगे रेन ताह काय जापाप नाह जुड़ेत।<verse eid="MIC 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MIC 3:8" />पुण मी ते बोगवानान जीवा केरीन सेक्ती एने नियाव माय बोराय जायेल हे, मी याकुबाह तान गुनो एने इस्राएलाह तान पाप एर केराव सेकुह। <verse eid="MIC 3:8" /><verse number="9" style="v" sid="MIC 3:9" />एय याकुबान गेराणान मुखी, एय इस्राएलान गेराणान न्यायनिवाड़ो केरनारे, एय न्यायनिवाड़ा पोर दुसमोनी केरनारे एने सोब हुतरी वातुह उलटी सुलटी केरनारे, ज्यी वात हुमलो। <verse eid="MIC 3:9" /><verse number="10" style="v" sid="MIC 3:10" />तुमू सियोन हेयराह, खुन केरीन एने यरूशलेमाह खाराब कामे केरीन वातड़ो केरतेह। <verse eid="MIC 3:10" /><verse number="11" style="v" sid="MIC 3:11" />तान मुखी पोयशा लेन विचार केरतेह, एने चाकऱ्या किमोत लेन नेम हिकाड़तेह, एने जाणकारे पोयशान केरता जाणाव केरतेह, तीबी ता इही केन बोगवाना पोर बुरहो मेलतेह, यहोवा आपणी विचीम हे केरीन काल्ली पिड़ा आपु पोर नाय आवी।<verse eid="MIC 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MIC 3:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:12 </char>
      <char style="xt" closed="false">
        <ref loc="JER 26:18">यिर्मया 26:18</ref>
      </char>
    </note>ज्यान केरता तुमरी कारेण सियोन एल जुपील खेतान गेत बाणावाय जाय, एने यरूशलेम डेफा डेफा एय जाय, एने जा बोयड़ा पोर गेर बुणेल हे, तो जेंगलान उचाला जागान गेत बोण जाय।<verse eid="MIC 3:12" /></para>
  <chapter eid="MIC 3" />
  <chapter number="4" style="c" sid="MIC 4" />
  <para style="s">सान्तीन राज</para>
  <para style="r">(यशाया 2:2-4 )</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 4:1" />सेवल्या दिह्याम ओहलो एय काय</para>
  <para style="q2" vid="MIC 4:1">बोगवानान गेरान बुयड़ो सोब बोयड़ाह पोर वातड़ो केराय जाय,</para>
  <para style="q2" vid="MIC 4:1">एने सोब बोयड़ाह रेन वोदार उचो केराय जाय;</para>
  <para style="q2" vid="MIC 4:1">एने आखा देसान माणहे नेदीन गेत तान उगे आवती।<verse eid="MIC 4:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="MIC 4:2" />एने आखा देसान माणहे जाती, एने आपसाम केती,</para>
  <para style="q1" vid="MIC 4:2">“आवो आपु बोगवानान बोयड़ा पोर चेढ़ीन</para>
  <para style="q2" vid="MIC 4:2">याकुबान बोगवानान गेराम जाता,</para>
  <para style="q1" vid="MIC 4:2">तेवी तो आपुह वाट देखाड़ी,</para>
  <para style="q2" vid="MIC 4:2">एने आपु तान वाटी पोर चालहू,</para>
  <para style="q1" vid="MIC 4:2">काहाकाय बोगवानान नेम सियोन रेन, एने तान वचन यरूशलेम रेन निकाली।”<verse eid="MIC 4:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="MIC 4:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:3 </char>
      <char style="xt" closed="false">
        <ref loc="JOL 3:10">योएल 3:10</ref>
      </char>
    </note>तो जुलूम देसान माणहान न्यायनिवाड़ो केरी,</para>
  <para style="q2" vid="MIC 4:3">एने सिट सिटे वोर ताकेतवोर देसान राड़ मिटाड़ी;</para>
  <para style="q1" vid="MIC 4:3">तेवी ता तान तालवाऱ्यु चेंदीन एलान कुहलो बाणावती,</para>
  <para style="q2" vid="MIC 4:3">एने तान बोरशा चेंदीन कुलपा बाणावती;</para>
  <para style="q1" vid="MIC 4:3">ती टेम माय एक देस दिहरा देसान विरूद माय</para>
  <para style="q2" vid="MIC 4:3">तालवार नाय चालाड़ती।<verse eid="MIC 4:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="MIC 4:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:4 </char>
      <char style="xt" closed="false">
        <ref loc="ZEC 3:10">जकर्‍या 3:10</ref>
      </char>
    </note>एने माणहे ओंगाण लेड़ायीन विद्या नाय हिकती,</para>
  <para style="q2" vid="MIC 4:4">पुण ता अंगुर ने वाड़ीम एने अंजीरान जाड़ा बुंदे बोह्या केरती,</para>
  <para style="q2" vid="MIC 4:4">एने कुण कुणाह नाय बिगाड़े;</para>
  <para style="q1" vid="MIC 4:4">सेनान बोगवानान ज्य वचन हे।<verse eid="MIC 4:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="MIC 4:5" />सोब देसान माणहे जिव जिवान देवतान नाव लेन चालतेह, पुण आपु आपणा बोगवानान नाव लेन जेलेम चालती रेहु।<verse eid="MIC 4:5" /></para>
  <para style="s">जेलीम रेन इस्राएलान आवणो</para>
  <para style="p">
    <verse number="6" style="v" sid="MIC 4:6" />बोगवानान ज्यो बोल हे, “ती टेम माय मी पोरजान लेंगड़ाह, एने बोलजोबरी काड़ेल ताह एने जाह मी दुख आपेल हे ताह सोबाह टुलो केरूह। <verse eid="MIC 4:6" /><verse number="7" style="v" sid="MIC 4:7" />एने लेंगड़ाह वोचाड़ीन मेलुह, एने सेटा किरेल ताह एक ताकेतवालो देस बाणाव देह; एने बोगवान ता पोर सियोन बोयड़ा पोर रेन जेलेम राज किरते रेय।”<verse eid="MIC 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MIC 4:8" />एने एय एदेरान चुटा, एय सियोनान बोयड़ी, तुवाह पेल ने गेत आदिकार जुड़ी, एने तुवाह यरूशलेमान राज जुड़ी। <verse eid="MIC 4:8" /><verse number="9" style="v" sid="MIC 4:9" />एवी तु काहा आयड़ेह? काय तार फाय काल्लो राजा नाह रिनो? काय तारो विचार केरनार खेतेम एय गीयो, केरीन फोकड़ाणार बायकुन गेत तुवाह पिड़ा इथे। <verse eid="MIC 4:9" /><verse number="10" style="v" sid="MIC 4:10" />एय सियोनान बेटी, फोकड़ाणार बायकुन गेत वेला केरीन पायदा केर; काहाकाय एवी तु किल्लाम रेन निकलीन चोवगान माय रिहे, पुण बाबेल वोर जाहे, ताहरीच तु सोड़वाय जाहे, मतलब ताहरीच बोगवान तुवाह दुसमोनान ताबाम रेन सोड़वी लेय। <verse eid="MIC 4:10" /><verse number="11" style="v" sid="MIC 4:11" />एने जुलूम देसे तारी विरूद टोलवायीन तार बाराम केती, सियोनीह एठी केर दिवो, एने आमु आमरा डोला केरीन तीह नास एतालो देखहु। <verse eid="MIC 4:11" /><verse number="12" style="v" sid="MIC 4:12" />पुण ता बोगवानान विचार नाह जाणते एने नाहते तान विचाराह सोमेजतेह, काय ताह ओहलो टुलो केर लेय, जिह केरीन खेताम रेन पुला खोलाम टुलो केराय जातेह।<verse eid="MIC 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MIC 4:13" />एय सियोन, उठ एने दुवेड़, मी तारा हिंगाह लोड़ान एने तारा खुऱ्याह पितलान बाणाव देह; एने तु जुलूम देसाह चुरा चुरा किरहे, एने तान कामाय बोगवानाह अर्पण किरहे एने तान मालदेन देरतीन मालक्याह बेट किरहे।<verse eid="MIC 4:13" /></para>
  <chapter eid="MIC 4" />
  <chapter number="5" style="c" sid="MIC 5" />
  <para style="p">
    <verse number="1" style="v" sid="MIC 5:1" />एवी एय यरूशलेम हेयरान माणहे टोल्यु इन एकठा ईवो, काहाकाय तो आमुह कोंड लियेल हे, ता इस्राएलान न्यायनिवाड़ो केरनाराह गाड़स्या पोर होटा केरीन देती।<verse eid="MIC 5:1" /></para>
  <para style="s">बेथलेहेम माय रेन एक राजान आवणेन वायदो</para>
  <para style="p">
    <verse number="2" style="v" sid="MIC 5:2" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:2 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 2:6">मत्ती 2:6</ref>; <ref loc="JHN 7:42">योहान 7:42</ref></char>
    </note>एय एप्रातान बेथलेहेम, केदी तु उहलो आत्यो हे काय यहुदान एजारो माय गेणाय नाय जातो, तीबी तार माय रेन मार केरता एक एदमी निकली, तो इस्राएल माय राज केरनार रेय; एने तान निकेलनो वेगाला कालाम रेन एने खेतेम नाह एण्या कालाम रेन इते आयेल हे।<verse eid="MIC 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MIC 5:3" />जाह वोर पेटावाली बायकु सोराह पायदा नाय केरी, ताह वोर मालीक इस्राएलीह सोड़ीन रेय। तान बाद वुचेल इस्राएली माणहे आपणा बायबांडला फाय आव लागती। <verse eid="MIC 5:3" /><verse number="4" style="v" sid="MIC 5:4" />एने तो उबरीन बोगवान आपेल ताकेत माय एने बोगवान यहोवा तान मोटला नावा माय, तान गोवाली केरी, ता होमालेल रेती। काहाकाय एवी तो देरतीन खुणे वोर मुठो ठेराय।<verse eid="MIC 5:4" /></para>
  <para style="s">सुटकारो एने देन्ड</para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 5:5" />तो हुकान थुड़ रेय। जेवी अश्शुर देसान माणहे आपणा देसा पोर चेड़ाय केरती, एने आमरा राज मेहेल माय पाय मेलती, तेवी आमु तान विरूद सात गोवाले एने आठ मुखी माणहे उबा केरहु। <verse eid="MIC 5:5" /><verse number="6" style="v" sid="MIC 5:6" /><note caller="+" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="GEN 10:8-11">उत्पत्ती 10:8-11</ref></char></note>एने ता अश्शुर देसान एने रिगणेन जागे वोर निमरोदान देसाह तालवार चालाड़ीन मार देती, एने जुलबुखे अश्शुरी देसान माणहे आपणा देसाम आवी, एने तान एद्दी माय पाय मिले, तेवी तो एदमी आपुह तान आथाम रेन वोचाड़ी।<verse eid="MIC 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MIC 5:7" />तेवी याकुबान माणहे, बोगवानान द्वारा मोकलेल ओहटो, खेड़ा पोर पोड़णार पाण्यान गेत रेती, जो कुणीन वाट नाह जुवेत एने नाह एगदा माणहान बोरहे रिथे। <verse eid="MIC 5:7" /><verse number="8" style="v" sid="MIC 5:8" />याकुबान वुचेल माणहे राज ने एने देस देसान माणहाम ओहला रेती, जीह केरीन जेंगली जेनवाराम सिंह रिथे, नाहते मेंड्रा बोकड्यान टोला माय जुवान सिंह रिथे, जुलबुखे तो तान विचीम रेन जाय, ते देरीन मारते एने वेसेड़ते जाय, एने कुण वोचाड़ नाय सिके। <verse eid="MIC 5:8" /><verse number="9" style="v" sid="MIC 5:9" />तारो आथ तारा विरोदी पोर पोड़ी, एने तारा आखा दुसमोन खेतेम एय जाती।<verse eid="MIC 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MIC 5:10" />बोगवानान ज्यो बोल हे, “ती टेम माय मी तारा गोड़ाह तार माय रेन खेतेम केरूह; एने तारा टांगाह खेतेम केरूह। <verse eid="MIC 5:10" /><verse number="11" style="v" sid="MIC 5:11" />मी तारा देसान हेयराह बी खेतेम केरूह, एने तारा किल्लाह ओदार देह। <verse eid="MIC 5:11" /><verse number="12" style="v" sid="MIC 5:12" />मी तारा जादु टोनाह खेतेम केरूह, एने तार माय जादु टोना केरनारे जीवताला नाय रेती। <verse eid="MIC 5:12" /><verse number="13" style="v" sid="MIC 5:13" />मी तुमऱ्यु मुरत्युह एने तुमरी विचीम तुमरा पुजण्या देगड़ाह नास केरूह, एने तुमू पोशा केदी तुमरा आथा केरीन बाणायेल वोस्तुन बोक्ती नाय केर सिकहो। <verse eid="MIC 5:13" /><verse number="14" style="v" sid="MIC 5:14" />मी तारी अशेरा नावान मुरतीन खांबाह तारी बुयीम रेन उखाल देह, एने तारा हेयराह नास केरूह। <verse eid="MIC 5:14" /><verse number="15" style="v" sid="MIC 5:15" />जा जा देसान माणहे मारो उकुम नाह मानते, मी ता पोर जुलूम राग केरूह एने बुदलो लेह।”<verse eid="MIC 5:15" /></para>
  <chapter eid="MIC 5" />
  <chapter number="6" style="c" sid="MIC 6" />
  <para style="s">इस्राएलान विरूद बोगवानान बोलाचाल</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 6:1" />जी वात बोगवान किथे, ती हुमलो; “उठीन बोयड़ान सोमोर बोलाचाल केर, एने बोयड्यु बी तारी होमेलने जुवे।”<verse eid="MIC 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MIC 6:2" />एय बोयड़ा, एने देरतीन पाकाला पाया, बोगवानान बोलाचाल हुमलो, काहाकाय बोगवानाह तान पोरजा पोर आरोप हे, एने तो इस्राएल हिऱ्यो बोलाचाल किरेह।<verse eid="MIC 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MIC 6:3" />एय मारी पोरजान माणहे, “मी तुमरी हिऱ्यो काय अन्याय किरेल हे, माहु किवो काय मी काल्ली वाती माय तुमूह दुख दियेल हे? <verse eid="MIC 6:3" /><verse number="4" style="v" sid="MIC 6:4" /><note caller="+" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="EXO 4:10-16">निर्गमन 4:10-16</ref>; <ref loc="EXO 12:50-51">12:50-51</ref>; <ref loc="EXO 15:20">15:20</ref></char></note>मी ते तुमूह मिस्र देसाम रेन काड़ीन लेन आवो, एने गुलामीन गेराम रेन तुमूह सोड़वी लावो; एने तुमरी आगवाय केरनेन मुसा, हारून एने मरियमीह मोकली दिनो। <verse eid="MIC 6:4" /><verse number="5" style="v" sid="MIC 6:5" /><note caller="+" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="NUM 22:2-25">गिनती 22:2-25</ref>; <ref loc="JOS 3:1">यहोशु 3:1</ref>; <ref loc="JOS 4:19">4:19</ref></char></note>एय मारी पोरजान माणहे, एर किरो, काय मोआब ने राजा बालाक तुमरी विरूद काल्लो हुमच्यो किरेल इतो? एने बोरान सोरो बिलाम काय सेला आपेल इतो, एर किरो शित्तीम रेन गीलगाल वोर काय काय गेटना इयेल एत्यु, काय बोगवानान देरमी कामाह जाण सिको।”<verse eid="MIC 6:5" /></para>
  <para style="s">बोगवान काय हुदेह</para>
  <para style="p">
    <verse number="6" style="v" sid="MIC 6:6" />मी बोगवानान ओंगाण काय लेन जाव, एने हेरगावाला बोगवानान सामने बोक्ती केरू? ते काय मी होमबोलीन केरता एक वोरह्यान वासड़ा लेन तान सोमोर जाव? <verse eid="MIC 6:6" /><verse number="7" style="v" sid="MIC 6:7" />काय बोगवानान खुसीन केरता एजारो मेंडा, नाहते जेतुन तेलान एजार नेद्यु पुऱ्यू एय जाती? काय मी मारा पापान पासतावान केरता मारा पेल्ला सोरान बोली केरू? नाहते मार पायदा इयेल एगदान बोली केरू? <verse eid="MIC 6:7" /><verse number="8" style="v" sid="MIC 6:8" />एय माणहे तो तुमूह केय दियेल हे, काय हाजो हे एने बोगवान तुमू पोर आसा किरेह, न्यायनिवाड़ान कामे किरो, एने गीणीह मोंग किरो एने गेरबोड़ाय माय चालो।<verse eid="MIC 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MIC 6:9" />बोगवानान बोल यरूशलेम हेयराह आयेड़ने बाजरिनोह, “एकलीदार माणुह बोगवानान नावाह बिथे, केरीन सेजान वातु पोर द्यान दे जा फाय देन्ड आपणेन आदिकार हे। <verse eid="MIC 6:9" /><verse number="10" style="v" sid="MIC 6:10" />काय मी पापीन गेर एवी वोर लुटीन कामायेल मालदेन, एने आतल्या मापाह विहरी जाव, जो खाराब हे? <verse eid="MIC 6:10" /><verse number="11" style="v" sid="MIC 6:11" />काय जुठो ताकड़ो एने कोपेट माय बोरायेल थेयली लेय रेणाराह मी माफ केर देव ? <verse eid="MIC 6:11" /><verse number="12" style="v" sid="MIC 6:12" />तारा मालदार माणहे अत्याचार केरतेह, एने तार माय रेणारे जुठ बोलतेह, एने तान जिब दुको देणेन वात किरेह। <verse eid="MIC 6:12" /><verse number="13" style="v" sid="MIC 6:13" />केरीन मी तुवाह दिते दितेन गायलो केरूह, एने तारा पापान कारेण तुवाह उजाड़ देह। <verse eid="MIC 6:13" /><verse number="14" style="v" sid="MIC 6:14" />तु खाहे, पुण आफेरहे नाय, एने तु बुखल्योच रिहे। एने तु तारो मालदेन लेन चालहे, पुण नाय वोचाड़ सिकहे, एने जो काय तु वोचाड़ बी लिहे, ताह मी तालवार चालाड़ीन लुटाड़ देह। <verse eid="MIC 6:14" /><verse number="15" style="v" sid="MIC 6:15" />तु पिरहे पुण काट नाय सिकहे, तु जेतुनान तेल काड़हे, पुण सोता लागाड़ नाय सिकहे, एने अंगुराह कुटहे, पुण अंगुरान रोह पिय नाय सिकहे। <verse eid="MIC 6:15" /><verse number="16" style="v" sid="MIC 6:16" />काहाकाय ता ओम्री माणहान नेमा पोर एने अहाबान गेराणान आखा कामा पोर चालतेह; एने तुमू तान होमच्या पोर चालतेह। केरीन मी तुवाह उजाड़ देह, एने ज्या हेयराम रेणारे माणहे तुमरी मोजाक उड़ावती, एने तुमू दिहरा माणहान चिहटा विठहो।”<verse eid="MIC 6:16" /></para>
  <chapter eid="MIC 6" />
  <chapter number="7" style="c" sid="MIC 7" />
  <para style="s">इस्राएलान वेवारान नास</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 7:1" />हाय मार पोर! काहाकाय मी ता माणहान गेत एय जाईल हे जो उनालाम फोल तोड़ने माय, नाहते रियेल अंगुर तोड़नेन टेमीन सेवोट आव जाय, माहु ते पाकेल अंजीरान आसा एती, पुण खाणेन केरता काल्लो गुमसो नाह रिनो। <verse eid="MIC 7:1" /><verse number="2" style="v" sid="MIC 7:2" />बोकत्या माणहे देरती पोर रेन खेतेम एय जायेल हेते, एने माणहा माय एक बी हुतरो माणुह नाह रेनो; ता आखान आखा मारनेन केरता फांदो टाकतेह, एने जाल मांडीन जीव जीवान बायाख ने सिकार केरतेह। <verse eid="MIC 7:2" /><verse number="3" style="v" sid="MIC 7:3" />तान दुयू आथा केरीन मोन लागाड़ीन बुराय केरतेह; आदिकारी पोयशा मांगेह, एने नियाव केरनार पोयशा लेणेन केरता तियार रिथे, एने मोटला माणहे तान मोनान खाराबी देखाड़ेह; इहकेरीन ता आखा मिलीन चालबाजी केरतेह।<verse eid="MIC 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MIC 7:4" />ता माय रेन जो आखाम रेन हाजो हे, तो काटाल्या जुरखेल्यान गेत पिड़ावालो हे, जो आखाम रेन हुतरो हे, तो काटावाला वाड़ाह रेन बी खाराब हे। तारा राखवाल्यान कियेल दिह, मतलब तारा देन्‍डान दिह आहने आव लागेल हे। एवी ता जेल्दीच बोटकी जाती। <verse eid="MIC 7:4" /><verse number="5" style="v" sid="MIC 7:5" />तारा आहेंल्यान बी बुरहो मा किरो, एने तारा जोड़ीदारा पोर बुरहो मा मिलो; पुण तारी बायकुह होमालीन बुलज्ये।<verse eid="MIC 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MIC 7:6" />काहाकाय बिटोख आबाख ने आपमान किरेह, एने बेटीख आईख ने, एने वोवड़ीख हाहवोक ने विरूद उठेह; माणहान दुसमोन तान गेरल्याच माणहे रेतेह।<verse eid="MIC 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MIC 7:7" />पुण मी बोगवानान उगे देखते रेह, मी मारा सोड़ेवणार बोगवानान वाट जोवती रेह; मारो बोगवान मारी होमली।<verse eid="MIC 7:7" /></para>
  <para style="s">सुटकारो बोगवाना उगेच रेन</para>
  <para style="p">
    <verse number="8" style="v" sid="MIC 7:8" />एय मारी दुसमोन, मार दुखान कारेण से खुस मा एय; काहाकाय जीहे मी पोडुह तिहेच उठुह; जीहे मी आंदारलाम पोडुह तिहेच बोगवान मार केरता उजालान काम देय। <verse eid="MIC 7:8" /><verse number="9" style="v" sid="MIC 7:9" />मी बोगवानान विरूद पाप किरेल हे, केरीन मी ती टेम वोर तान राग विठती रेह, जाह वोर काय तोच मारो मुकदमो लेड़ीन मारो फिसलो नाय केरी, ती टेम माय तो माहु उजाला माय काड़ीन लेन आवी, एने मी तान हाजाला कामाह देखुह। <verse eid="MIC 7:9" /><verse number="10" style="v" sid="MIC 7:10" />तेवी मारी दुसमोन जी माहु इही किथे, “तारो बोगवान यहोवा काहरी रिनो?” ती बी ताह देखी एने लाजवाएन तीन मुय डापी। मी मारा डोला केरीन तीह देखुह; तेवी ती वाटीन गारान गेत रोंहदलाय जाय।<verse eid="MIC 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MIC 7:11" />एय यरूशलेम जेवी तारा हेयरान बितड़ो बांदणेन दिह आवी, ते दिह तारी एद्दी वोदाड़ाय जाय। <verse eid="MIC 7:11" /><verse number="12" style="v" sid="MIC 7:12" />ते दिह अश्शुर रेन, एने मिस्र देसान हेयराम रेन, एने मिस्र एने फरात नेदीन विचीम रेन एने देरीया, देरीया एने बोयड़ा बोयड़ान विचीम रेन देसान माणहे तार फाय आवती। <verse eid="MIC 7:12" /><verse number="13" style="v" sid="MIC 7:13" />तीबी देरती पोर रेणारान कारेण एने तान खाराब कामान वोजेसे उजाड़लीच रेय।<verse eid="MIC 7:13" /></para>
  <para style="s">इस्राएल पोर बोगवानान गीण</para>
  <para style="p">
    <verse number="14" style="v" sid="MIC 7:14" />तारा माणहान राखवाली एने तारा आदिकार माय जुड़ेल मेंड्रान टोलान राखवाली तारी डेंगी केरीन किरज्ये, जी खेरबाटी बुई माय एने हाजी बुईन चारान विची माय एखाला रेतेह, ताह जुलूम पेल ने टेमान गेत बाशान एने गीलाद ने ईलाका माय चेरने दिवो।<verse eid="MIC 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MIC 7:15" />जीहे काय मिस्र देसाम रेन तारा निकलीन आवणेन दिह्याम, तिहेच केरीन एवी मी ताह मोटला कामे देखाडुह। <verse eid="MIC 7:15" /><verse number="16" style="v" sid="MIC 7:16" />दिहरा देसान माणहे देखीन तान आखा बाहदुरीन कामान बाराम लाजवाती; ता तान मुयाह आथा केरीन लिकाड़ती, एने तान काने बेयरा एय जाती। <verse eid="MIC 7:16" /><verse number="17" style="v" sid="MIC 7:17" />त्यु गेड़हान गेत माटड्यो चाटती, एने बुई पोर लोलनार जेन्तुन गेत तान देराम रेन कापतेन निकेलती; ता आपणा बोगवाना फाय थेर थेर कापतेन आवती, एने ता तुवाह बिती।<verse eid="MIC 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MIC 7:18" />तार गेत ओहलो बोगवान काहरी हे जो पापे माफ केरी, एने तान सोतान पोरजान वुचेल माणहान गुना डाप देय? तो तान राग जेलेम मेल नाह रेत, काहाकाय तो गीणी पोर मोंग मिलेह। <verse eid="MIC 7:18" /><verse number="19" style="v" sid="MIC 7:19" />तो पुशो आमु पोर गीण केरी, एने आमरा पापाह पाया बुंद रोंहदेल देय, एने आपणा गुनान कामाह उंडाला देरीया माय जुगार देय। <verse eid="MIC 7:19" /><verse number="20" style="v" sid="MIC 7:20" />तु याकुबान बाराम ती खेराय, एने अब्राहमान बाराम ती गीण पुरी केरी, ज्यान वायदो तु वेगाला कालान दिह्याम रेन एवी वोर आमरा डायडाया हिऱ्यो किरती आयेल हे।<verse eid="MIC 7:20" /></para>
  <chapter eid="MIC 7" />
</usx>