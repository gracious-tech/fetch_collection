<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JAS" style="id">- Nahali</book>
  <para style="h">याकुब</para>
  <para style="toc3">याकुब</para>
  <para style="toc2">याकुब</para>
  <para style="toc1">याकुब लिखेल पोत्रो</para>
  <para style="mt2">याकुब ने लिखा हुआ पत्र</para>
  <para style="mt1">याकुब लिखेल पोत्रो</para>
  <para style="imt">ओलखात</para>
  <para style="ip">याकुबान पुस्तेक याकुब नावान एगदा माणहान उगे रेन लेखाय जायेल एती। ज्यो एय सिकेह काय याकुब यीशु मसीन बाहख ईतो, एने यरूशलेमान सुरवातीन मोंडलीन एक अगुवा ईतो। <char style="xt"><ref loc="ACT 15:13">प्रेरितान काम 15:13</ref></char> एने पौलुस ताह मोंडलीन खाम बी कियेल हे। <char style="xt"><ref loc="GAL 2:9">गलातीयो 2:9</ref></char> डायडायान मान्नो हे काय मसीन जेल्मान 50 वोरह्या बाद याकुबान पुस्तेक लेखाय जायेल एती। काहाकाय याकुब यरूशलेम माय मोंडलीन अगुवा ईतो, तानकेरता तो ता रेते लेन नाहते पुस्तेक लिख्यो एय।</para>
  <para style="ip">याकुब तान पुस्तेकीह “बारा गेराणान बाराम” केयो जा दिहरा देसाम वेरासेर एन रेतेह। <char style="xt"><ref loc="JAS 1:1">1:1</ref></char> याकुबान पुस्तेक माय सिक्शा आखा मसी माणहा पोर लागु एतेह, पुण “बारा गेराणो” सोबदान वापेर केरीन ज्यो समंद देखाड़ेह काय याकुब हुतरो यहुदि मसी माणहाह लेखतालो। काहाकाय ज्यी पुस्तेक पाठकाह एक वेपार समुह वोर पोचाड़ने केरता एती, जो मोकता विषयाह बाराबोर किरेल हे। याकुब बुरहो एने कामान विचीम समंद पोर द्यान लागाड़ेह। खेरलो बुरहो कामा माय देखाय जाय। <char style="xt"><ref loc="JAS 2:17">2:17</ref></char> तो मालदार माणहाह <char style="xt"><ref loc="JAS 2:1-4">2:1-4</ref></char> बेदबाव केरनेन विरोद चेतावणी आपेह एने आमु जो केतेह तान बाराम जोगवीन रेणेन केरता केतेह। <char style="xt"><ref loc="JAS 3:1-12">3:1-12</ref></char></para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. याकुब तान पोत्री वाचणाराह दन्यवाद आपेह। <char style="ior"><ref loc="JAS 1:1">1:1</ref></char></para>
  <para style="io1">2. तान पासाण तो बुरहो केरनाराह वेठणेन केरता ओंगाण किरेह जेवी ता दुखी एतेह। <char style="ior"><ref loc="JAS 1:2-27">1:2-27</ref></char></para>
  <para style="io1">3. पोशो तो किथे काय बोरहाह कामा केरीन देखाणो ज्यो जोरेवरी हे। <char style="ior"><ref loc="JAS 2:1-26">2:1-26</ref></char></para>
  <para style="io1">4. तान पासाण तो किथे काय ताकेतवोर सोबदो किहीक एय सेकतेह। <char style="ior"><ref loc="JAS 3:1-12">3:1-12</ref></char></para>
  <para style="io1">5. तेवी याकुब किथे काय किहीक बोगवानान इकेल दुनियान एकलीह रेन आलेग हे। <char style="ior"><ref loc="JAS 3:13-4:10">3:13–4:10</ref></char></para>
  <para style="io1">6. तान पासाण तो तान वाचणाराह गोमेंडी एणेन विरोद चेतावणी आपेह। <char style="ior"><ref loc="JAS 4:11-5:6">4:11–5:6</ref></char></para>
  <para style="io1">7. याकुब थोड्युक होपी निसाणी आपीन तान पुस्तेक खेतेम किऱ्यो। <char style="ior"><ref loc="JAS 5:7-20">5:7-20</ref></char></para>
  <chapter number="1" style="c" sid="JAS 1"/>
  <para style="s">नमस्‍कार</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 13:55">मत्ती 13:55</ref>; <ref loc="MRK 6:3">मरकुस 6:3</ref>; <ref loc="ACT 15:13">प्रेरितान काम 15:13</ref>; <ref loc="GAL 1:19">गलातीयो 1:19</ref></char>
    </note>मी याकुब मालीक यीशु मसीन चाकर्‍यो ज्यी चिट्ठी लेखणे बाजरिनोह, जा बोगवानान इस्राएल ने बारा गेराणा वेरासेर एन रेतेह, ताह नमस्‍कार पोची।<verse eid="JAS 1:1"/></para>
  <para style="s">बुरहो एने इकेल</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2"/>एय मारा बाय बोणहा, जुलबुखे तुमू बात बातीन पारेख माय पोड़हो, ताहार ज्याह जुलूम खुसीन वात सोमजो, <verse eid="JAS 1:2"/><verse number="3" style="v" sid="JAS 1:3"/>जेवी तुमरो बुरहो ओहली पारेख माय जिक सापड़ावेह, तेवी तुमरो दिर बुणीह। <verse eid="JAS 1:3"/><verse number="4" style="v" sid="JAS 1:4"/>पुण दिरीह तान पुरो काम केरने दिवो, काय तुमू पुरा एने पाका एय जाहो, एने तुमरे माय काल्ली वातीन कोमी नाय रेय।<verse eid="JAS 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 1:5"/>पुण केदी तुमरे माय रेन कुणीह बी एकलीन कोमी एय ते बोगवाना फाय मांगो, जो आरोप नाह लागाड़ता आखाह खुसी एने गीण केरीन आपेह, एने ताह आपी। <verse eid="JAS 1:5"/><verse number="6" style="v" sid="JAS 1:6"/>पुण बिगेर सेक माय बुरहो केरीन मांगो, काहाकाय सेक केरनार देरीयान जेलखान गेत हे, जो वारा माय वोयणे एने उसेलने। <verse eid="JAS 1:6"/><verse number="7" style="v" sid="JAS 1:7"/>ओहलो माणुह ज्यो नाय सोमजे काय माहु मालीक फाय रेन काह जुड़ी, <verse eid="JAS 1:7"/><verse number="8" style="v" sid="JAS 1:8"/>तो माणुह सेक केरनार हे, एने जो काय तो वातु किरेह आखी वातु माय चेतुर हे।<verse eid="JAS 1:8"/></para>
  <para style="s">गेरीब एने मालदार</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9"/>गेरीब बाय बोणहा ज्यी वाती माय खुसी केरने जुवे, जेवी बोगवान ताह उचो पोद आपी। <verse eid="JAS 1:9"/><verse number="10" style="v" sid="JAS 1:10"/>जेवी बोगवान माणहाह गेरीबी माय लावेह, तेवी ता खुसी केरने जुवे; काहाकाय ता खेड़ान फुलान गेत खेतेम एय जाती। <verse eid="JAS 1:10"/><verse number="11" style="v" sid="JAS 1:11"/>काहाकाय दिह उगताच बोर दोप पोड़ने, एने खेड़ाह हुकाड़ देणे, एने तान फुल ओदीर जाणे एने तान होबा जात रेणे इहीचकेरीन केरीन मालदार माणुह बी तान वेपार केरती केरतीन माटड्या माय मिलाय जाय।<verse eid="JAS 1:11"/></para>
  <para style="s">पारेख एने लालुस</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12"/>बोरकेतवालो हे तो माणुह जो पारेख माय मोजबुत रीथे, काहाकाय पारेख माय खेरो निकलीन जीवाय ने तो मुकूट सापड़ावी, जान वायदो मालीक ताह मोंग केरनारा हिऱ्यो किरेल हे। <verse eid="JAS 1:12"/><verse number="13" style="v" sid="JAS 1:13"/>जेवी कुणीन बी पारेख एय, ते तो ज्यो नाय केय काय मारी पारेख बोगवानान उगे रेन ईथे; काहाकाय बोगवानाह कुण बी लालुस माय नाह टाक सिकेत, एने तो कुणीह बी खाराब वातुन लालुस माय नाह टाक सिकेत। <verse eid="JAS 1:13"/><verse number="14" style="v" sid="JAS 1:14"/>पुण एकेक माणुह ताच ने खाराब लालुस माय पोड़ी एने फोसाईन पारेख माय पोड़ने। <verse eid="JAS 1:14"/><verse number="15" style="v" sid="JAS 1:15"/>ओवती मोरजी पेठेरली एन पापाह जेल्मो देणे, एने पाप जेवी होवटो एय जाणे ते मोत पायदा केरने।<verse eid="JAS 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16"/>एय मारा मोंगाल्ला बाय बोणहा, दुको मा खावो। <verse eid="JAS 1:16"/><verse number="17" style="v" sid="JAS 1:17"/>काहाकाय एकेक हाजालो वरदान एने एकेक हाजो दान उपेर रिस ने हेते, एने उजेड़ान आबाख ने उगे रेन जुड़ेह, जा माय नाहते काह बोदेल एय सिकेह, एने नाह हेरेकणार सावलान गेत तो बोदेलने। <verse eid="JAS 1:17"/><verse number="18" style="v" sid="JAS 1:18"/>तो तास ने आसा माय आपुह खेरायीन वचनान केरीन बाणायेल, काहाकाय आपु तान बाणायेल वोस्तु माय रेन एक बातीन पेल्लो फोल रेहु।<verse eid="JAS 1:18"/></para>
  <para style="s">होमलानो एने केरनो</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19"/>एय मारा मोंगाल्ला बाय बोणहा, ज्यी वातु तुमू जाण लिवो एकेक माणुह होमेलने केरता तियार एने बोलना माय दिरो एने रागा माय बागे रेय, <verse eid="JAS 1:19"/><verse number="20" style="v" sid="JAS 1:20"/>काहाकाय माणहान राग बोगवानान खेरली वातुह सापड़ाव नाह सेकते। <verse eid="JAS 1:20"/><verse number="21" style="v" sid="JAS 1:21"/>तानकेरीन आखो गाण एने दुसमोनाय ने बोड़ती सिटो केरीन ता वचनाह गेरबोड़ाय माय लेय लिवो, जो मोना माय पेरायेल एने जो तुमरो सुटकारो केर सिकेह। <verse eid="JAS 1:21"/><verse number="22" style="v" sid="JAS 1:22"/>पुण होमेलनारे नाह, जा सोताह दुको देतेह; पुण वचना पोर चालनारे बुणो। <verse eid="JAS 1:22"/><verse number="23" style="v" sid="JAS 1:23"/>काहाकाय जो कुण वचनाह होमेलनार एय एने ता पोर चालनार निहे एय, ते तो ता माणहान गेत हे जो तान सोतान मुय आरसा माय दिखेह। <verse eid="JAS 1:23"/><verse number="24" style="v" sid="JAS 1:24"/>तो सोताह देखीन जात रेणे एने चालोच विहरी जाणे काय मी कोहलोक ईतो। <verse eid="JAS 1:24"/><verse number="25" style="v" sid="JAS 1:25"/>पुण जो माणुह सुटकारान खेरा कायदा पोर द्यान केरती रीथे, तो तान कामा माय ज्यानकेरीन बोरकेत लेय काय होमलीन विहेरने नाह पुण तोहलोस काम किरेह। <verse eid="JAS 1:25"/><verse number="26" style="v" sid="JAS 1:26"/>केदी कुण सोताह बोकत्यो सोमजेह एने तान जिबी पोर लगाम नाय देय, पुण तान मोनाह दुको देय ते तान बोक्ती वायेस हे। <verse eid="JAS 1:26"/><verse number="27" style="v" sid="JAS 1:27"/>आपणा बोगवानान एने आबाख ने सामने चोखी एने हुवाली बोक्ती ज्यी हे काय विखावालान एने रांडायेल ने दुखा माय तान कालजी लेय, एने सोताह दुनियाह रेन निष्कलंक मेली।<verse eid="JAS 1:27"/></para>
  <chapter eid="JAS 1"/>
  <chapter number="2" style="c" sid="JAS 2"/>
  <para style="s">बेदबावान विरोद चेकचेल्या</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1"/>एय मारा बाय बोणहा, आपणा बोक्ती वाला मालीक यीशु मसी पोर तुमरो बुरहो बेदबाव माय नाय रेय। <verse eid="JAS 2:1"/><verse number="2" style="v" sid="JAS 2:2"/>काहाकाय केदी एगदो माणुह होनान मुंदी एने हाजाला फाड़का पेरीन तुमरी मोंडली माय आवी, एने एक गेरीब बी खाराब फाड़का पेरीन आवी, <verse eid="JAS 2:2"/><verse number="3" style="v" sid="JAS 2:3"/>एने तुमू ता हाजाला फाड़का पेरनारान मुय देखीन किहो, “तु ता हाजाली जागे बोह,” एने ता गेरब्याह किहो, “तु न्या उबरी” नाहते “मार पाया हिऱ्यो बोह जा।” <verse eid="JAS 2:3"/><verse number="4" style="v" sid="JAS 2:4"/>ते काय तुमू एका दिहरा माय बेदबाव नाह केऱ्या, एने खाराब वातु माय नियाव केरनारे नाह ठेराना? <verse eid="JAS 2:4"/><verse number="5" style="v" sid="JAS 2:5"/>एय मारा मोंगाल्ला बाय बोणहा, हुमलो काय बोगवान दुनियान नेजरीम जा गेरीब हेते ताह निवाड्यो काय बोरहा माय मालदार एने ता राज ने आदिकारी एय, जान वायदो तो ता हिऱ्यो किरेल हे जा ता पोर मोंग केरतेह? <verse eid="JAS 2:5"/><verse number="6" style="v" sid="JAS 2:6"/>पुण तुमू ता गेरब्यान ईजुत वेरतेह, एने ता कुण हेते जा तुमूह बोलने नाह देते एने कोरटा माय खेच खेचीन ली जातेह, ता मालदार माणहे नाह सोता? <verse eid="JAS 2:6"/><verse number="7" style="v" sid="JAS 2:7"/>जा हाजाला नावान केरता तुमूह नाव सापड़ेल हे, तान ता चिहटा केरती नाह काय? <verse eid="JAS 2:7"/><verse number="8" style="v" sid="JAS 2:8"/>तीबी केदी तुमू चोखाली पुस्तेकीन ज्या वचनान गेत, “तु तार आहेंल्या हिऱ्यो तार होस मोंग केर,” खेरीच ता राज कायदाह पुरो केरतेह, ते हाजोस केरतेह। <verse eid="JAS 2:8"/><verse number="9" style="v" sid="JAS 2:9"/>पुण केदी तुमू माणहाह देखीन वेवारो केरतेह, ताहार पाप केरतेह; एने कायदो तुमूह नेम तोड़नार ठेरावेह। <verse eid="JAS 2:9"/><verse number="10" style="v" sid="JAS 2:10"/>काहाकाय जो कुण आखा कायदाह मानेह पुण एकुस वाती माय चुक जाय ते तो सोब वातु माय गुनेगार ठेराय गीयोह। <verse eid="JAS 2:10"/><verse number="11" style="v" sid="JAS 2:11"/>तानकेरता जो ज्यो केयो, “तु सिनालो मा किरहे,” तोस ज्यो बी किथे, “तु खुन मा किरहे,” तानकेरता केदी तु सिनालो ते निहे किऱ्यो एय, पुण खुन किऱ्यो एय तीबी तु कायदाह नाह मान्नार ठेरानो। <verse eid="JAS 2:11"/><verse number="12" style="v" sid="JAS 2:12"/>तुमू ता माणहान गेत वचन बोलो एने काम बी किरो, जान नियाव ता नेमान गेत एय जो आपुह सुटकारो आपेह। <verse eid="JAS 2:12"/><verse number="13" style="v" sid="JAS 2:13"/>तानकेरता जो किव केरनार नाह सोतो: तानकेरता बोगवानान नियाव बी बिगेर किवास ने रेय, काहाकाय किव नियाव पोर जिक हे।<verse eid="JAS 2:13"/></para>
  <para style="s">बुरहो एने काम</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14"/>एय मारा बाय बोणहा, केदी कुण केय माहु बुरहो हे पुण तो काम निहे केरतेय, ते ज्या माय काय फायदो? काय ओहलो बुरहो केदी तान सुटकारो केर सिकेह? <verse eid="JAS 2:14"/><verse number="15" style="v" sid="JAS 2:15"/>केदी एगदो बाहख बोणीख उगाड़ला एती, एने ताह दाड़ीन दिह खाणान कोमी एय, <verse eid="JAS 2:15"/><verse number="16" style="v" sid="JAS 2:16"/>एने तुमरे माय रेन ईखेह ताह केय, “तुमरी देखरेत किरज्‍यो, तुमू ताताला एने आफरीन रिवो,” पुण ज्‍यु वोस्तु सेरीरान केरता जोरेवरी हे ती ताह नाय आपी ते काय फायदो? <verse eid="JAS 2:16"/><verse number="17" style="v" sid="JAS 2:17"/>तिहेस केरीन बुरहो बी केदी कामा हिऱ्यो निहे एय, ते आपणा सोबाव माय मुरेल हे।<verse eid="JAS 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18"/>एगदो केय सिकेह, “तुवाह बुरहो हे एने मी काम केरथु,” तु तारो बुरहो माहु कामा बिगेर ते देखाड़; एने मी मारो बुरहो मारा कामान द्‍वारे तुवाह देखाडुह। <verse eid="JAS 2:18"/><verse number="19" style="v" sid="JAS 2:19"/>तुवाह बुरहो हे; काय एकुस बोगवान हे? तु हाजो किरेह। बुतड़ा बी बुरहो केरतेह एने थेर थेर कापतेह। <verse eid="JAS 2:19"/><verse number="20" style="v" sid="JAS 2:20"/>पुण एय विणकाम्या माणहा, काय तु ज्यो बी नाह जाणेत काय कामान बिगेर बुरहो वाये हे?<note caller="+" style="f"><char style="fr" closed="false">2:20 </char><char style="ft" closed="false">बिगेर कामान; थोड़ाक लेख माय मुरेल लिखेल हे।</char></note> <verse eid="JAS 2:20"/><verse number="21" style="v" sid="JAS 2:21"/>जुलबुखे आपणो आबोख अब्राहाम तान बेटाख इसहाकाह वेदी पोर चेड़ायेल, ते काय तो कामा माय देरमी नाह ठेरायेल ईतो। <verse eid="JAS 2:21"/><verse number="22" style="v" sid="JAS 2:22"/>तु देख लीदोह काय बुरहो तान कामा हिऱ्यो मिलीन जोर दियेल हे, एने कामा केरीन बुरहो खेरो ईनो, <verse eid="JAS 2:22"/><verse number="23" style="v" sid="JAS 2:23"/>एने चोखाली पुस्तेकीन वचन पुरो एनो, “अब्राहाम बोगवाना पोर बुरहो किऱ्यो एने ज्यो तानकेरता तो सिदो ठेरानो,” एने तो बोगवानान जोड़ीदार ठेरानो<note caller="+" style="x"><char style="xo" closed="false">2:23 </char><char style="xq" closed="false">तो बोगवानान जोड़ीदार ठेरानो </char><char style="xt" closed="false"><ref loc="ISA 41:1">यशाया 41:1</ref></char></note>। <verse eid="JAS 2:23"/><verse number="24" style="v" sid="JAS 2:24"/>इहीचकेरीन तुमू देख लेदा काय माणुह बुरहो ओलोस नाह, पुण कामा केरीन बी, सिदो बुणीह। <verse eid="JAS 2:24"/><verse number="25" style="v" sid="JAS 2:25"/>तिहेस केरीन राहाब वेश्या बी, जेवी ती दुताह तीन गेरा माय रेणे देनी एने दिहरी वाटी रेन मोकेल देनी, ते काय ती कामा माय देरमी नाह ठेरानी? <verse eid="JAS 2:25"/><verse number="26" style="v" sid="JAS 2:26"/>जिहकेरीन सेरीर जीवा बिगेर मुरेल हे तिहेस केरीन बुरहो बी कामा बिगेर मुरेल हे।<verse eid="JAS 2:26"/></para>
  <chapter eid="JAS 2"/>
  <chapter number="3" style="c" sid="JAS 3"/>
  <para style="s">जिबीह ताबाम केरने</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1"/>एय मारा बाय बोणहा, तुमरे माय रेन जुलूम हिक आपणारे नाय बोणी काहाकाय तुमूह मालुम हे काय हिक आपणारेस होवटाह दोसी ठेराती। <verse eid="JAS 3:1"/><verse number="2" style="v" sid="JAS 3:2"/>ज्यानकेरीन आपु आखा जुलूम वार चुक जातेह; जो कुण वचना माय नाह चुकेत, तोस ते सीदो माणुह हे एने आखा सेरीराह ताबाम केर सिकेह। <verse eid="JAS 3:2"/><verse number="3" style="v" sid="JAS 3:3"/>जेवी आपु आपणा ताबाम केरनेन केरता गोड़ान मुया माय लगाम लागाड़तेह, तेवी आपु ताह जाहरी ताहरी फिरीव सेकतेह। <verse eid="JAS 3:3"/><verse number="4" style="v" sid="JAS 3:4"/>सोचो, जारीक काय डोंडह्या कोलाक मोटला रेतेह एने जाल्ला वारा माय चालतेह तीबी एक आत्यीस पतवारी केरीन चालाड़नारान मोरजी पोर फिरने। <verse eid="JAS 3:4"/><verse number="5" style="v" sid="JAS 3:5"/>तिहेस जिब बी एक आत्योच आंग हे, एने ती मोट मोठ्यु वातु केरतास, सोचो काय एक आत्‍यास जीगाल्या केरीन कोलाक मोठा जेंगला माय दावाड़ो लागाड़ सिकेह। <verse eid="JAS 3:5"/><verse number="6" style="v" sid="JAS 3:6"/>जिब बी एक आक्‍ठो हे, जिब आपणा आंगा माय बिगेर खेरायीन एक आस हे; एने आखा सेरीर पोर डाग लागाड़ने, एने जीवाणान जोरा माय आक्‍ठो लागाड़ दिथे, एने नेरगान कुंडान आक्‍ठा केरीन हेलेगते रीथे। <verse eid="JAS 3:6"/><verse number="7" style="v" sid="JAS 3:7"/>काहाकाय एकेक बातीन जेंगली जेनवारे, चीड़ा, एने लोलनारे जेन्तु एने पाण्या मायवाला मासा, ते माणहान ताबा माय एय सेकतेह; एने एय बी गीयाह। <verse eid="JAS 3:7"/><verse number="8" style="v" sid="JAS 3:8"/>पुण जिबीह माणहा माय रेन कुणूस ताबाम नाह केर सेकते, ती एक ओहली चिज हे ज्यी केदी रोकाणेस नाह, ती जीव खेतेम केरन्या जेहेर माय बोरायेल हे। <verse eid="JAS 3:8"/><verse number="9" style="v" sid="JAS 3:9"/>जी केरीन आपु मालीकान एने आबाख ने बोड़ाय केरतेह, एने माणहाह जा बोगवानान वेहा माय बोणेल हेते, हाराप देतेह। <verse eid="JAS 3:9"/><verse number="10" style="v" sid="JAS 3:10"/>एकुस मुया केरीन दन्यवाद एने हाराप दुयू निकेलतेह, एय मारा बाय बोणहा ओहलो नाय एणे जुवे। <verse eid="JAS 3:10"/><verse number="11" style="v" sid="JAS 3:11"/>एने पाण्यान एकुस जीराम रेन मीठालो एने खारलो पाणी दुयू निकेलने काय? <verse eid="JAS 3:11"/><verse number="12" style="v" sid="JAS 3:12"/>एय मारा बाय बोणहा, काय अंजीरान जाड़ा पोर जेतुन, एने अंगुर ने वेलाम रेन अंजीर लाग सेकतेह? तिहेस केरीन खारला जिरा माय मीठालो पाणी नाह निकेल सिकेत। <figure style="fig" alt="Rider on a horse" file="lb00035c.tif" size="col" copy="Horace Knowles ©" ref="3:3">गोड़ा पोर बोहणार</figure><verse eid="JAS 3:12"/></para>
  <para style="s">हेरगावालो इकेल</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13"/>तुमरे माय ईकेलवालो एने सोमेजदार माणुह कुण हे? जो ओहलो एय तो तान कामाह हाजाला बोलना चालना माय एने ती गेरबोड़ाय हिऱ्यो देखाड़ी, जी इकेल माय बोणने। <verse eid="JAS 3:13"/><verse number="14" style="v" sid="JAS 3:14"/>पुण केदी तुमू आपणा आपणा मोना माय कोपेट, कुयराय एने विरोद मेलते एती, एने तुमरी एकली पोर मोठाय केरीन खेरायीन विरोद माय पाप मा किरहो। <verse eid="JAS 3:14"/><verse number="15" style="v" sid="JAS 3:15"/>ज्यी इकेल ती नाह सोती जी हेरगाम रेन उतेरने पुण दुनियान, एने सेरीरावाली, एने सैतानी हे। <verse eid="JAS 3:15"/><verse number="16" style="v" sid="JAS 3:16"/>काहाकाय जाहरी कुयराय एने सोतान जीवान विचारे ओहलो ईथे, ताहरी नेमान एने आखी बातीन खाराब वातु ईथे। <verse eid="JAS 3:16"/><verse number="17" style="v" sid="JAS 3:17"/>पुण ज्यी इकेल उपेर रेन आवीह ती पेल ते चोखाली रीथे ओवतो मीलनसार, हुवालो, एने सान्ती वाली एने किव, एने हाजा फोला केरीन बोरायेल बेदबाव एने बिगेर कोपेटान रीथे। <verse eid="JAS 3:17"/><verse number="18" style="v" sid="JAS 3:18"/>जा माणहे मेल केरावणारे हेते, सान्ती हेऱ्या बिज पेरतेह एने नियावान फोल सान्ती माय काटती।<verse eid="JAS 3:18"/></para>
  <chapter eid="JAS 3"/>
  <chapter number="4" style="c" sid="JAS 4"/>
  <para style="s">देरती हेऱ्यी दोस्ती</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1"/>तुमरी विची माय लेड़ाय एने राड़ का रेन आवीह? काय तुमरा मोनान मोरजी से नाह आवीत जो तुमरे माय राड़ जीगड़ो केरतेह? <verse eid="JAS 4:1"/><verse number="2" style="v" sid="JAS 4:2"/>तुमू लालुस केरतेह एने तुमूह जुड़ेत नाह; ज्यानकेरीन तुमू खुन केरतेह। तुमू जुलूम आसा केरतेह, एने कायच नाह जुड़ेत, ज्यानकेरता तुमू लेड़ाते एने बाथे पोड़तेह। एने तुमू जो होदतेह तो तुमूह ज्यानकेरीन नाह जुड़ेत, काहाकाय तुमू बोगवाना फाय मांगते नाह। <verse eid="JAS 4:2"/><verse number="3" style="v" sid="JAS 4:3"/>तुमू मांगतेह पुण जुड़ेत नाह ज्यानकेरीन काय खाराब आसा केरीन मांगतेह, काय तुमरा मोज मोचती माय उड़ाव दिहो। <verse eid="JAS 4:3"/><verse number="4" style="v" sid="JAS 4:4"/>एय बुरहो नाह केरनार काय तुमू नाह जाणते काय जेगा हेऱ्या दोस्ती केरनो ते बोगवाना हेऱ्यो दुसमोनाय केरनो हे? जो कुण जेगान जोड़ीदार बोणने हुदेह तो सोताह बोगवानान दुसमोन बाणावीह। <verse eid="JAS 4:4"/><verse number="5" style="v" sid="JAS 4:5"/>काय तुमू ज्यो सोमेजतेह काय चोखाली पुस्तेक उदेड़ किथे, “जो जीव आमरे माय हे, काय तो लालुस किरेह जान फोल कुयराय हे।”<note caller="+" style="f"><char style="fr" closed="false">4:5 </char><char style="ft" closed="false">जीव उत्साहित मोरजी; नाहते आमरे माय बोगवान जो जीव मिलेल हे, तान बाराम ती मोरजी से लालुस केरथु।</char></note> <verse eid="JAS 4:5"/><verse number="6" style="v" sid="JAS 4:6"/><note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false">माणहे तुवाह जापाप नाह आपते; नाहते माणहे। काय बोगवान तुवाह जापाप नाय आपी। </char></note>तो ते उंजु बी गीण आपेह; ज्यानकेरता ज्यो लिखेल हे, “बोगवान मोठाय केरनारान विरोद केरने, पुण गेरब्या पोर किव केरने।”<verse eid="JAS 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7"/>केरीन बोगवानान उगे एय जावो। एने सैताना हेऱ्या लेड़ो, ताहार तो तुमरे आहने रेन नाह जाय। <verse eid="JAS 4:7"/><verse number="8" style="v" sid="JAS 4:8"/>बोगवानान आहने आवो ते तो बी तुमरे आहने आवी। एय पापी माणहा, तुमरा आथे चोखाला किरो; एने एय कोपट्या माणहे, तुमरो मोन चोखालो किरो। <verse eid="JAS 4:8"/><verse number="9" style="v" sid="JAS 4:9"/>नाराज ईवो, एने दुख किरो, एने रिड़ो। तुमरो आहणो दुख माय एने तुमरी खुसी नाराजी माय बोदेल जाय। <verse eid="JAS 4:9"/><verse number="10" style="v" sid="JAS 4:10"/>मालीकान ओंगाण देरमी बुणो ताहार तो तुमूह उचो केरी।<verse eid="JAS 4:10"/></para>
  <para style="s">बाय बोणहा पोर गुनो लागाड़ने</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11"/>एय बाय बोणहा, एका दिहरान विरोद माय वातु मा किरो। जो आपणा बाय बोणहान विरोद माय बुलीह ताहार नेमान विरोद नियाव किरेह, एने तु नेमा पोर चालनार नाह, पुण ता पोर आदिकारी ठेरानो। <verse eid="JAS 4:11"/><verse number="12" style="v" sid="JAS 4:12"/>कायदो आपणार एने आदिकारी ते एकुस हे, जो वोचाड़नेन एने खेतेम केरनेन ताकेत हे। पुण तु कुण हे, जो तारा आहेंल्यान नियाव किरेह?<verse eid="JAS 4:12"/></para>
  <para style="s">मोठवायीन विरोद चेकचेल्या</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13"/>मारी हुमलो तुमू जाज्यो केतेह, “आज नाहते काल आपु दिहरा गावाम जाईन एक वोरह्यो रेहु, एने काम केरीन फायदो कामावहु।” <verse eid="JAS 4:13"/><verse number="14" style="v" sid="JAS 4:14"/>एने ज्यो नाह जाणते काय हेकाले काय एण्यो हे। होमली ते लिवो, तुमरी जीवाय हेच काय? तुमू ते वाफ ने गेत हेते, जो थोड़ीक वार वोर देखाणे ओवतो आरताय जाणे। <verse eid="JAS 4:14"/><verse number="15" style="v" sid="JAS 4:15"/>ज्याह रेन दिहरो तुमूह ज्यो केणे जुवे, “केदी मालीक हुदे ते आपु जीवताला रेहु, एने ज्यो नाहते तो काम बी केरहु।” <verse eid="JAS 4:15"/><verse number="16" style="v" sid="JAS 4:16"/>पुण तुमू एवी तुमरी मोंज पोर मोठवाय केरतेह; पुण ओहलो सोब मोठवाय खाराब हे। <figure style="fig" alt="Customer, merchant with his wares" file="hk00172c.tif" size="col" copy="Horace Knowles ©" ref="4:13">खेरीदि केरनार एने वेपारी तान वोस्तु हेऱ्या</figure><verse eid="JAS 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 4:17"/>ज्यानकेरीन जो कुण हाजो केरने सोमजेह एने नाह किरेत, तान केरता तो पापान दोसी हे।<verse eid="JAS 4:17"/></para>
  <chapter eid="JAS 4"/>
  <chapter number="5" style="c" sid="JAS 5"/>
  <para style="s">मालदार माणहा चेकचेल्या रिवो</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1"/>एय मालदार माणहा, होमली लिवो, तुमू तुमरा आवणारा सेतावा पोर आयड़ी आयड़ीन रिड़ो। <verse eid="JAS 5:1"/><verse number="2" style="v" sid="JAS 5:2"/><note caller="+" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="MAT 6:19">मत्ती 6:19</ref></char></note>तुमरो माल बिगेड़ जायेल हे, एने तुमरा फाड़काह किड़ा खाय जायेल हेते। <verse eid="JAS 5:2"/><verse number="3" style="v" sid="JAS 5:3"/>तुमरा होना चांदी माय जेंग लाग जायेल हे; एने ती जेंग पोर गोवाय देय, एने आक्‍ठान गेत तुमरो माह खाय जाय। तुमू सेवेटल्या काला माय माल टुलो किरेल हेते। <verse eid="JAS 5:3"/><verse number="4" style="v" sid="JAS 5:4"/>हुमलो, जा मोंजर्‍या तुमरा खेता माय काम केऱ्या, एने कामाय काटेल हेते, तान ती मोंजरी जी तुमू ठेगीन मेल लियेल हेते आयेड़ने बाजरेनीह, एने मोंजऱ्यान बोल सेनावोन मालीकान काने वोर पोच जायेल हे। <verse eid="JAS 5:4"/><verse number="5" style="v" sid="JAS 5:5"/>तुमू देरती पोर तोपशा माय लाग रिहो एने मोठोह हुक बोगना; तुमू ज्या बोलीन दिह्यान केरता तुमरा मोनान चाकरी केरीन ताह मोटलो एने ताबालो केऱ्या। <verse eid="JAS 5:5"/><verse number="6" style="v" sid="JAS 5:6"/>तुमू सिदा माणहाह गुनेगार ठेरावीन मार देना, तो तुमरे सामनो नाह किरेत।<verse eid="JAS 5:6"/></para>
  <para style="s">दिर एने विन्ता</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7"/>ज्यानकेरीन एय बाय बोणहा, मालीक आवी ताह वोर दिर दिरो। हुमलो, किरसाण देरतीन मोंगाली कामाईन आसा मेलतेन पेल्लो एने सेवल्यो पाणी आवी ताह वोर दिर देरने। <verse eid="JAS 5:7"/><verse number="8" style="v" sid="JAS 5:8"/>तुमू बी दिर दिरो; एने तुमरा मोनाह मोजबुत किरो, काहाकाय मालीकान आवणो आहने हे। <verse eid="JAS 5:8"/><verse number="9" style="v" sid="JAS 5:9"/>एय बाय बोणहा, एका दिहरा पोर गुनो मा लागाड़ो, काय तुमू दोसी नाय ठेराहो; हुमलो, आदिकारी बायणा पोर उबरिनोह। <verse eid="JAS 5:9"/><verse number="10" style="v" sid="JAS 5:10"/>एय बाय बोणहा, जा जाणकारे मालीकान नावा माय वातु किरेल हेते, ताह दुख विसणेन एने दिर देरनेन एक सादेन सोमजो। <verse eid="JAS 5:10"/><verse number="11" style="v" sid="JAS 5:11"/>हुमलो, आमु दिर देरनाराह बोरकेतवाला केतेह। तुमू आयुबान दिर ने बाराम होमलेल हेते, एने मालीकान उगे रेन जो तान फोल एनो ताह बी जाण लियेल हेते, ता माय मालीकान मोटली किव एने देया देखाथे।<verse eid="JAS 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">5:12 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:34-37">मत्ती 5:34-37</ref>
      </char>
    </note>पुण एय मारा बाय बोणहा, आखाम रेन हाजी वात ज्यी हे, काय सुगोण मा खाहो, नाह हेरगान, नाह देरतीन, नाह काल्ली चिजीन; पुण तुमरी वातु होव ते होव, एने नाह ते नाह रेय काय तुमू डेंडान लायेक नाय ठेराहो।<verse eid="JAS 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13"/>केदी तुमरे माय कुण दुखी एय, ताहार तो विन्ता केरी। केदी खुस एय ताहार तो बोड़ायीन गीत गावी। <verse eid="JAS 5:13"/><verse number="14" style="v" sid="JAS 5:14"/><note caller="+" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="MRK 6:13">मरकुस 6:13</ref></char></note>केदी तुमरे माय कुण दुखाऱ्यो हे, ते मोंडलीन डायला माणहाह हादि, एने ता मालीकान नावा माय ता पोर तेल चोपड़ीन तान केरता विन्ता केरी, <verse eid="JAS 5:14"/><verse number="15" style="v" sid="JAS 5:15"/>एने बोरहान विन्ता द्‍वारे दुखाऱ्यो वोच जाय एने मालीक ताह विसीन उबराखाड़ देय; एने केदी तो पाप बी किरेल एय, ते तान बी माफी जुड़ जाय। <verse eid="JAS 5:15"/><verse number="16" style="v" sid="JAS 5:16"/>ज्यानकेरीन तुमू सोता माय एका दिहरान ओंगाण आपणा आपणा पापाह मान लिवो, एने एका दिहरान केरता विन्ता किरो, ताकेरीन हुदरी जाहो, देरमी जाणान विन्तान फारेक माय जुलूम काय एय सिकेह। <verse eid="JAS 5:16"/><verse number="17" style="v" sid="JAS 5:17"/>जाणाव केरनार एलिया बी ते आपणी गेत दुख हुक बोगणार माणुह एतो; एने तो रेड़ रेड़ीन विन्ता किऱ्यो काय पाणी नाय पोड़ी; एने साड़े तीन वोरह्या वोर बुय पोर पाणी नाह आवो। <verse eid="JAS 5:17"/><verse number="18" style="v" sid="JAS 5:18"/>पोशो तो विन्ता किऱ्यो ते जुगा माय रेन पाणी पोड़नो, एने बुय फोलावाली एय गियी।<verse eid="JAS 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19"/>एय मारा बाय बोणहा, केदी तुमरे माय कुण बोरहाम रेन बोटकी जायेल हे ताहार ताह पोशो बोरहा माय लावी, <verse eid="JAS 5:19"/><verse number="20" style="v" sid="JAS 5:20"/><note caller="+" style="x"><char style="xo" closed="false">5:20 </char><char style="xt" closed="false"><ref loc="1PE 4:8">1 पतरस 4:8</ref></char></note>ते तो ज्यो जाण लेय काय जो कुण एगदा विश्वास माय रेन बोटकेल पापीह पोशो बोरहा माय लावी, एने तो एक जीवाह मोतीम रेन वोचाड़ी एने जुलूम पापा पोर पुड़दो टाकी।<note caller="+" style="f"><char style="fr" closed="false">5:20 </char><char style="ft" closed="false">ता पापी माणहा जीव; नाहते तान खुद ने जीव।</char></note><verse eid="JAS 5:20"/></para>
  <chapter eid="JAS 5"/>
</usx>
