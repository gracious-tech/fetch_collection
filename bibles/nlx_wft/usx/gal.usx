<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GAL" style="id">- Nahali</book>
  <para style="h">गलातीयो</para>
  <para style="toc3">गलातीयो</para>
  <para style="toc2">गलातीयो</para>
  <para style="toc1">गलातीयो पौलुस लिखेल पोत्रो</para>
  <para style="mt2">गलातीयो पौलुस ने लिखा हुआ पत्र</para>
  <para style="mt1">गलातीयो पौलुस लिखेल पोत्रो</para>
  <para style="imt">ओलखात</para>
  <para style="ip">गलातीयान पुस्तेकीह प्रेरित पौलुस <char style="xt"><ref loc="GAL 1:1">1:1</ref></char> लिखेल ईतो। ज्यो एक पोत्र एतो जो पौलुस यीशु मसीन जेल्मान 48-57 वोरह्यान विची माय लिखेल ईतो। गलातीया माय रेणारे रोमन ईलाकान गलातीयो माय रेणारे माणहे एता। जाणकाराह मालुम नाह सोतो काय जेवी पौलुस पोत्र लिखेल ईतो तेवी तो काहरी ईतो, पुण इफिसुस एने कुरिंथीयो ज्या दुय हेयरान आंदासान जागो हे।</para>
  <para style="ip">पौलुस विश्वासी एने बिगेर यहुदि दुयूह हिकाड़नेन केरता गलातीयोन मोंडलीन बारा माय लिखेल हे, तो खास केरीन गेलेत सिक्शान सामनो केरनेन केरता लिखेल ईतो, जा माय कियेल ईतो काय विश्वासीह जुनाला नेम माय यहुदि कायदाह पालने जोरवरी नाय मिले, खास केरीन खेतना। जुड़ाइजर नावान विश्वासीन विची माय माणहान एक टुलो ईतो, जाह बिगेर यहुदि विश्वासीह खेतना केरनेन गिरेज एती। ता पौलुसान एपोस्टोलिक प्रदाकारणाह बी सावाल माय कियेल हे। पौलुस तान थोड़ीक वातु <char style="xt"><ref loc="GAL 1:11-2:14">1:11–2:14</ref></char> माय किन तान देरमाह वोचाड़ेल हे, एने तो ज्यो सोमजाड़ीन हाजाली खोबरीह वोचाड़ेल हे काय सुटकारो यीशु मसी हे। <char style="xt"><ref loc="GAL 2:16">2:16</ref></char></para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. पौलुस तान पोत्रान सुरवात गलातीयोन मोंडलीह केरीन किरेल हे। <char style="ior"><ref loc="GAL 1:1-5">1:1-5</ref></char></para>
  <para style="io1">2. तेवी पौलुस हिकाड़नेन तान आदिकारान राखवाली केरने एने देखाड़नेन केरता सोतान देशान बारा माय कियेल हे तो कायदा लेन जीवणेन कोसीत किरेल ईतो पुण तो काम नाह केरतालो। <char style="ior"><ref loc="GAL 1:6-2:21">1:6–2:21</ref></char></para>
  <para style="io1">3. ओंगाण तो सुटकारो एने कायदो एने दया बुमिकान व्याख्या किरेह। <char style="ior"><ref loc="GAL 3-4">3–4</ref></char></para>
  <para style="io1">4. ओवतो तो एक हाजो मसीह जीवणो जीवणेन केरता थोड़ीक वातु किथे। <char style="ior"><ref loc="GAL 5:1-6:10">5:1–6:10</ref></char></para>
  <para style="io1">5. पौलुस तान पोत्राह एक आबिवादन एने आखरी वातु किन निवरावेह काय ज्यो एर मेलनेन केरता काय बोगवानान उगे रेन नोवाला माणहाह बोदेलने जुलूम जोरवरी हे, बाहेरल्या नेम जो काय खेतना केराय जाणो। <char style="ior"><ref loc="GAL 6:11-18">6:11-18</ref></char></para>
  <chapter number="1" style="c" sid="GAL 1" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1" />मी पौलुसान उगे रेन प्रेरित जो नाह माणहान उगे रेन एने नाह माणहान द्‍वारा निवोड़नो, पुण यीशु मसी एने आबोख बोगवानान द्‍वारा जो यीशुह मुरेल माय रेन जीवाड्यो। <verse eid="GAL 1:1" /><verse number="2" style="v" sid="GAL 1:2" />एने आखा बायाख ने उगे रेन जा मार हेऱ्या हेते, गलातीयान मोंडलीह नमस्‍कार मोकेलतेह।<verse eid="GAL 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3" />आपणो आबोख बोगवान एने मालीक यीशु मसीन उगे रेन तुमूह गीण एने सान्ती जुड़ते रेय।<verse eid="GAL 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 1:4" />जो आपणा पापान केरता सोताह आप दिनो, काहाकाय आपणो बोगवान एने आबाख ने मोरजीन गेत आपुह ज्यी एवीन खाराब दुनिया से सोड़वे। <verse eid="GAL 1:4" /><verse number="5" style="v" sid="GAL 1:5" />तान बोड़ाय जेलेम एते रेय। आमेन।<verse eid="GAL 1:5" /></para>
  <para style="s">काल्ली दिहरी हाजाली खुबेर नाह</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6" />माहु आश्‍चर्य ईथे काय जो तुमूह मसीन गीण माय हाद्यो ताह तुमू ओला उतवाल्या एगदी दिहरीस हाजाली खोबरीन केरता बोटेकणे बाजरेनाह।<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">मसीन गीण से; थोड़ाक लेख माय तान गीण से लिखेल हे।</char></note> <verse eid="GAL 1:6" /><verse number="7" style="v" sid="GAL 1:7" />पुण “दिहरी हाजाली खुबेर सोतीस नाह,” पुण वात ज्यी हे काय थोड़ाक माणहे ओहला हेते जा तुमूह गाबराव देतेह, एने मसीन हाजाली खोबरीह बिगाड़ ने होदतेह। <verse eid="GAL 1:7" /><verse number="8" style="v" sid="GAL 1:8" />पुण केदी आमु, नाहते हेरोगदुत बी ती हाजाली खोबरीह सोड़ीन जी आमु तुमूह होमलाड़ेल हेते, एगदी दिहरी हाजाली खुबेर तुमूह होमलाड़े ताहार हाराप एय। <verse eid="GAL 1:8" /><verse number="9" style="v" sid="GAL 1:9" />जीहे आमु पेल कियेल हेते, तिहेच केरीन मी एवी उंजु केथु काय ती हाजाली खोबरीह सोड़ीन जीह तुमू स्वीकार किरेल हेते, केदी एगदी दिहरी हाजाली खुबेर होमलाड़ेह, ताहार हाराप एय!<verse eid="GAL 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10" />काय ज्याकेरीन ओहलो लागेह काय मी माणहाह मानथु काय बोगवानाह? काय मी माणहाह खुस केरनेन कोसीत केरने कोसीत केरथु? केदी मी माणहास खुस किरतो, ताहार मी मसीन सेवक नाय बोण सेकतो।<verse eid="GAL 1:10" /></para>
  <para style="s">पौलुस किहीक प्रेरित बोणेल</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11" />एय बाय बोणहा, मी तुमूह केय दिथो काय जी हाजाली खुबेर मी होमलाड़ेल हे ती माणहान उगे रेन नाह। <verse eid="GAL 1:11" /><verse number="12" style="v" sid="GAL 1:12" />काहाकाय ती माहु काल्ला माणहान उगे रेन नाह पोचनी, एने नाह माहु एगदो हिकाड़ेल, पुण यीशु मसीन द्‍वारा देखानी।<verse eid="GAL 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:13 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 8:3">प्रेरितान काम 8:3</ref>; <ref loc="ACT 22:4">22:4</ref>,<ref loc="ACT 22:5">5</ref>; <ref loc="ACT 26:9-11">26:9-11</ref></char>
    </note>यहुदि देरमा माय जो पेल मारो बोलनो चालनो एतो, तान बाराम तुमू होमेल लियेल हेते काय मी बोगवानान मोंडलीह जुलूम वेला केरायेल एने खेतेम केरतालो। <verse eid="GAL 1:13" /><verse number="14" style="v" sid="GAL 1:14" /><note caller="+" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="ACT 22:3">प्रेरितान काम 22:3</ref></char></note>मारा जुलूम होवटा जातीवालाह जा मारी वोयावाला एता, यहुदि देरमा माय जुलूम वोदते जाताला एने मारा डायडायान रितीन केरता उत्साही ईतो।<verse eid="GAL 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 1:15" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:15 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 9:3-6">प्रेरितान काम 9:3-6</ref>; <ref loc="ACT 22:6-10">22:6-10</ref>; <ref loc="ACT 26:13-18">26:13-18</ref></char>
    </note>पुण बोगवान तान गीणीन द्‍वारा माहु मारी आईख ने पेटास माय रेन निवाड़ लिदो, एने हाद्यो काहाकाय मी तान सेवा केर सेकु, <verse eid="GAL 1:15" /><verse number="16" style="v" sid="GAL 1:16" />जेवी तो निर्णय लिदो काय तान सोराह मार माय देखाड़ी काय मी बिगेर यहुदि माय तान हाजाली खुबेर होमलाडु, ते मी काल्ला माणहान मोदेक नाह लिदो। <verse eid="GAL 1:16" /><verse number="17" style="v" sid="GAL 1:17" />एने नाह मी ता फाय गीयो जा माहु रेन पेल यरूशलेम माय प्रेरित निवड़ायेल एता, पुण मी अरब माय जात रिनो, एने ता रेन पोशो दमिश्‍क माय वोलीन आवतरनो।<verse eid="GAL 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 1:18" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:18 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 9:26-30">प्रेरितान काम 9:26-30</ref>
      </char>
    </note>ओवतो तीन वोरह्या बाद मी पतरसा हिऱ्यो मिलनेन केरता यरूशलेम गीयो, एने ता फाय पोंदरा दिह वोर रिनो। <verse eid="GAL 1:18" /><verse number="19" style="v" sid="GAL 1:19" /><note caller="+" style="f"><char style="fr" closed="false">1:19 </char><char style="ft" closed="false">याकुबाह सोड़ीन दिहरो काल्लो बी प्रेरित; नाहते काल्लो बी प्रेरित नाह, जा दिहरा एदम्याह मी दिखेल ईतो तो याकुब ईतो।</char></note>पुण मालीकान बाहख याकुबाह सोड़ीन काल्ला दिहरा प्रेरिताह नाह मिलनो। <verse eid="GAL 1:19" /><verse number="20" style="v" sid="GAL 1:20" />बोगवान मारो गोवा हे काय ज्‍यु वातु मी तुमूह लेखथु, त्यु जुठ्यु नाह। <verse eid="GAL 1:20" /><verse number="21" style="v" sid="GAL 1:21" />तान बाद मी सीरीया एने किलीकीयान फोलाम आवो। <verse eid="GAL 1:21" /><verse number="22" style="v" sid="GAL 1:22" />पुण यहुदियान मोंडली जा मसीन बोरहाम हेते, माहु व्यक्तिगत रूप से केदी नाह मीलना; <verse eid="GAL 1:22" /><verse number="23" style="v" sid="GAL 1:23" />पुण मार बाराम जाणताला काय जो आपुह पेल वेला केरावतालो, “तो एवी तास बोरहान हाजाली खुबेर होमलाड़ेह जीह पेल खेतेम केरतालो।” <verse eid="GAL 1:23" /><verse number="24" style="v" sid="GAL 1:24" />एने ता मार बाराम बोगवानान बोड़ाय केरताला।<verse eid="GAL 1:24" /></para>
  <chapter eid="GAL 1" />
  <chapter number="2" style="c" sid="GAL 2" />
  <para style="s">दिहरा प्रेरितान द्‍वारा पौलुसाह मान्यता</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 11:30">प्रेरितान काम 11:30</ref>; <ref loc="ACT 15:2">15:2</ref></char>
    </note>चोवदा वोरह्या बाद मी बरनबासा हिऱ्यो पोशो यरूशलेम माय गीयो, एने तीतुसाह बी आरही ली गीयो। <verse eid="GAL 2:1" /><verse number="2" style="v" sid="GAL 2:2" />बोगवानान मारो जाणो बोगवानान गेत एनो, एने जी हाजाली खुबेर मी बिगेर यहुदि माय पारचार केरथु, तीह मी ताह केय दिनो, पुण कुवालोच ताह जा मोटला सोमजाय जाताला, काहाकाय इही नाय एय काय मारी ज्यी टेमीन नाहते पासाणली दोवेड़ फालतुक ठेराय। <verse eid="GAL 2:2" /><verse number="3" style="v" sid="GAL 2:3" />पुण तीतुसाह बी जो मारो मोदेक केरनार हे, एने जा बिगेर यहुदि हेते, खेतना केरावणेन ता पोर दाबाव नाह टाक्‍यो। <verse eid="GAL 2:3" /><verse number="4" style="v" sid="GAL 2:4" />एने ज्यो ता जुठा बायह्याख ने वोजेसे एनो जा लिकाएन रिग जायेल एता, काय आपणी ती स्वतंत्रान जा मसी यीशु माय आपुह जुड़ेल हे, जाणकारी लेन आपुह गुलाम बाणावी। <verse eid="GAL 2:4" /><verse number="5" style="v" sid="GAL 2:5" />आमु तान आदिन ता माय गुटण्या नाह टेक्या, ज्यानकेरता काय हाजाली खोबरीन खेराय तुमरे माय बोणीन रेय। <verse eid="GAL 2:5" /><verse number="6" style="v" sid="GAL 2:6" />पुण जा माणहे खाज लागतेह ता कोहलाक बी एता माहो ताहसे काय फारेक नाह फुड़ीत बोगवान कुणी बाहेरल्यो रूप देखीन कुणी नियाव नाह केरने ता से जा आपणे आपणा खाज केवाताला ता से माहु काय फायदो नाह ईनो। <verse eid="GAL 2:6" /><verse number="7" style="v" sid="GAL 2:7" />पुण ज्यान उलटो जिहकेरीन यहुदि माणहाह हाजाली खुबेर केणेन काम पतरसाह होपायेल, तिहेच केरीन बिगेर यहुदि माणहान केरता माहु हाजाली खुबेर होमलावणेन होपायेल हे। <verse eid="GAL 2:7" /><verse number="8" style="v" sid="GAL 2:8" />काहाकाय जो पतरस खेतना वालान माणहाह प्रेरिताईन काम मोटलो प्रबावा बेल केरायो, तोस माहु बी बिगेर यहुदि माय प्रबावशाली काम केरायो, <verse eid="GAL 2:8" /><verse number="9" style="v" sid="GAL 2:9" />एने जेवी ता ती गीण माहो बोगवाना फाय रेन जुड़ेल एती, ओलख्या जी माहु ते याकुब, केफा एने योहान जा मोंडलीन खाम सोमजाय जाताला, माहु एने बरनबासाह सेंगेतीन जीवड्यो आथ आप्या काय आमु बिगेर यहुदि माय एने, ता खेतनावाला माय काम केरी। <verse eid="GAL 2:9" /><verse number="10" style="v" sid="GAL 2:10" /><note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="ft" closed="false">आहने हे; नाहते आहने ईतो।</char></note>फोक्‍तो आमु जाह जोरवुत हे ताह आपणो, ओहली तान मोरजी एती; एने ज्यास कामाह केरनेन मी खुद कोसीत केरतालो।<verse eid="GAL 2:10" /></para>
  <para style="s">पौलुसान द्‍वारा पतरसान विरोद</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11" />पुण जेवी पतरस अन्ताकियाम आवो, ते मी आखान सामने तान विरोद किऱ्यो, काहाकाय तान गेलती साप साप एती। <verse eid="GAL 2:11" /><verse number="12" style="v" sid="GAL 2:12" />काहाकाय याकुबान द्‍वारे मोकलायेल थोड़ाक माणहे न्या आवणेन पेल पतरस बिगेर यहुदि बुरहो केरनारा हिऱ्यो खाणो खाया केरतालो, पुण जेवी ता माणहे आवा पतरस बिगेर यहुदि बुरहो केरनारा हिऱ्यो रेन सिटो ईनो एने ता हिऱ्यो खाणे पिणेन सोड़ दिनो ज्यो तु ता माणहान बिय माय किरेल काय ता होदताला बिगेर यहुदिन खेतना एणे जुवे। <verse eid="GAL 2:12" /><verse number="13" style="v" sid="GAL 2:13" />दिहरा यहुदि माणहे बी ज्या कोपेट माय पतरसान साथ देना, न्या वोर काय बरनबास बी ता माणहान कोपेट ने कारेण बोटेक गीयो। <verse eid="GAL 2:13" /><verse number="14" style="v" sid="GAL 2:14" />पुण जेवी मी दिख्यो काय ता हाजाली खोबरीन खेराय पोर हुतरा नाह चालते, ते मी आखान सामने पतरसाह केयो, “जेवी तु यहुदि एन बिगेर यहुदिन गेत जीवनो जिवेह यहुदिन गेत नाह ताहार तु बिगेर यहुदिह यहुदिन गेत चालनेन काहा किथे?”<verse eid="GAL 2:14" /></para>
  <para style="s">बोरहान द्‍वारा देरमी ठेराणो</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15" />आमु ते पायदा सेस यहुदि हेते, एने पापी बिगेर यहुदि माय रेन नाह। <verse eid="GAL 2:15" /><verse number="16" style="v" sid="GAL 2:16" /><note caller="+" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="ROM 3:20">रोमीयो 3:20</ref>; </char><char style="xt" closed="false"><ref loc="ROM 3:22">रोमीयो 3:22</ref></char></note>आमु जाणतेह काय माणुह नेमान कामा केरीन नाह पुण मसी यीशु पोर बुरहो केरनेन द्‍वारा देरमी ठेराथे, आमु खुद मसी यीशु पोर बुरहो केऱ्या काय आमु नेमान कामा केरीन नाह, पुण मसी पोर बुरहो केरने से देरमी ठेराय; ज्यानकेरता काय नेमान कामा केरीन काल्लो बी माणुह देरमी नाय ठेराय जाय। <verse eid="GAL 2:16" /><verse number="17" style="v" sid="GAL 2:17" />आपु जा मसी माय देरमी ठेराणे होदतेह, केदी सोतास बिगेर यहुदिन गेत पापी निकल्या ते काय मसी पापान सेवक हे? केदिस नाह! <verse eid="GAL 2:17" /><verse number="18" style="v" sid="GAL 2:18" />काहाकाय जो काय मी पाड़ दिनो केदी ताहास पोशो बाणावथो, ताहार सोताह गुनेगार ठेरावथो। <verse eid="GAL 2:18" /><verse number="19" style="v" sid="GAL 2:19" />काहाकाय मी ते नेमान द्‍वारा नेमान केरता मोर गीयो काय बोगवानान केरता जीवो। मी मसी हिऱ्यो खुरूसखाम पोर चेड़ावाय जायेल हे, <verse eid="GAL 2:19" /><verse number="20" style="v" sid="GAL 2:20" />एने एवी मी जीवतालो नाह रिनो, पुण मसी मार माय जीवतालो हे; एने मी सेरीर माय एवी जो जीवतालो हे, ते फोक्‍तो ता बोरहा केरीन जीवतालो हे जो बोगवानान बेटाख पोर हे, जो माहु मोंग किऱ्यो एने मार केरता सोताह आप दिनो। <verse eid="GAL 2:20" /><verse number="21" style="v" sid="GAL 2:21" />मी बोगवानान गीणीह नाह नाकारणे। पुण केदी काल्लो माणुह नेमान द्‍वारा देरमी रेतो, ते ज्यान मतलब ज्यो हे काय मसीन मोरनो व्यर्थ रेतो।<verse eid="GAL 2:21" /></para>
  <chapter eid="GAL 2" />
  <chapter number="3" style="c" sid="GAL 3" />
  <para style="s">नेम एने बुरहो</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1" />एय विणएकल्या गलातीयावाला, कुण तुमूह मोह लियेल हे? तुमरे डोलान सामने यीशु मसी ते खुरूसखाम पोर हुतरोच देखाड़ाय जायेल ईतो। <verse eid="GAL 3:1" /><verse number="2" style="v" sid="GAL 3:2" />मी तुमरे फाय रेन फोक्‍तो एक वात जाणने होदथु काय तुमू जीवाह काय नेमान कामा केरीन, काय हाजाली खुबेर होमेलने से एने बुरहो केरने से जुड़नो? <verse eid="GAL 3:2" /><verse number="3" style="v" sid="GAL 3:3" />काय तुमू ओला विणएकल्या किहीक बोणतेह! बोगवानान जीवान द्‍वारा सुरवात केरतेह; एने एवी तुमरी ताकेती केरीन पुरा केरने होदतेह? <verse eid="GAL 3:3" /><verse number="4" style="v" sid="GAL 3:4" />काय तुमू ओलो दुख बिगेर कामान वेठ्या? पुण खेरीच बिगेर कामान नाह। <verse eid="GAL 3:4" /><verse number="5" style="v" sid="GAL 3:5" />जो बोगवान तुमूह जीव आपेह एने तुमरे माय ताकेतीन काम किरेह, तो काय ज्यानकेरता किरेह काय तुमू नेमाह पालतेह, काय ज्यानकेरता काय तुमू हाजाली खोबरी पोर बुरहो केरतेह?<verse eid="GAL 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:6 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 4:3">रोमीयो 4:3</ref>
      </char>
    </note>“जीहे अब्राहामान अनुबवान बाराम पुस्तेक माय लिखेल हे तो बोगवाना पोर बुरहो किऱ्यो एने ज्यो तानकेरता देरमी ठेरानो।” <verse eid="GAL 3:6" /><verse number="7" style="v" sid="GAL 3:7" /><note caller="+" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="ROM 4:16">रोमीयो 4:16</ref></char></note>केरीन जाज्यो सोमजी लिवो काय जा बुरहो केरतेह, तास अब्राहाम ने सोरा हेते। <verse eid="GAL 3:7" /><verse number="8" style="v" sid="GAL 3:8" />एने चोखाली पुस्तेक पेलुस ज्यो जाणीन काय बोगवान बोरहान द्‍वारा बिगेर यहुदिह देरमी ठेरावी। पुस्तेक माय पेलुस रेन अब्राहामाह ज्यी हाजाली खोबरीन गोसणा केर दिनो: “काय तार माय जुलूम माणहाह बोरकेत जुड़ी।” <verse eid="GAL 3:8" /><verse number="9" style="v" sid="GAL 3:9" />तानकेरता जोला माणहे बुरहो केरतेह, ता विश्वासी अब्राहामा हेऱ्या बोरकेत सापड़ावतेह।<verse eid="GAL 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10" />पुण जोलाक माणहे नेमान पालेन केरीन जीवतेह, ता आखा हारापान काबाम हेते। काहाकाय पुस्तेक माय लिखेल हे, “जो कुण नेमान पुस्तेक माय लेखायेल आख्‍यु वातु पालेन केरने माय स्थिर नाह रेत, तो बोगवानान हारापान ताबाम हे। <verse eid="GAL 3:10" /><verse number="11" style="v" sid="GAL 3:11" />केरीन ज्यो साप हे काय नेमान द्‍वारा बोगवानान नेजरी माय कुण देरमी नाह ठेरात काहाकाय पुस्तेक किथे देरमी माणुह बोरहा केरीन जीवतालो रेय।<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="ft" closed="false">बोरहान द्‍वारे बोगवाना हेऱ्यो एक एणेन कारेण दुनिया माय ने; नाहते बोगवाना हेऱ्यो खेरो केराय जाणेन कारेण बोरहान द्‍वारे दुनिया माय ने।</char></note> <verse eid="GAL 3:11" /><verse number="12" style="v" sid="GAL 3:12" />पुण नेमान बोरहा हेऱ्यो काय नातो नाह। पुण जो ताह मानी, तो तान साहारे जीवतालो रेय।” <verse eid="GAL 3:12" /><verse number="13" style="v" sid="GAL 3:13" />मसी आपणी केरता हाराप वालो बोणनो, काहाकाय आपुह वेचातो लेन नेमान हारापाह रेन सोड़व्यो काहाकाय पुस्तेक माय लिखेल हे, “जो कुण जाड़ा पोर लेटकाड़ाय जाथे तो हाराप वालो हे।” <verse eid="GAL 3:13" /><verse number="14" style="v" sid="GAL 3:14" />ज्यो ज्यानकेरता एनो काय अब्राहाम ने बोरकेत मसी यीशु माय बिगेर यहुदि वोर पोची एने आपु बोरहान द्‍वारा ता जीवाह सापड़ावे जान वायदो बोगवान किरेल हे।<verse eid="GAL 3:14" /></para>
  <para style="s">नेम एने वाचा</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15" />एय बाय बोणहा, एवी मी तुमूह देयनदिन एक किस्सो आपणे जाणे बाजरिनोह जिहकेरीन एगदा दुय माणहा द्‍वारा एगदो वायदो केराणे पोर नाह ते ताह बोंद केराय जाथे, एने नाह ता माय गेटाड़ाय जाय सिकेह एने नाह काह वोदाड़ाय जाय सिकेह। <verse eid="GAL 3:15" /><verse number="16" style="v" sid="GAL 3:16" />केरीन बोगवान अब्राहाम एने तान वोचीह वायदान बाराम आपेल। तो ज्यो नाह केत, “वोचीह,” जीहे जुलूम जाणान बाराम केयो, पुण ज्यान बोदले एकास ने उगे “तारे वोचीह” एने तो एक मसी हे। <verse eid="GAL 3:16" /><verse number="17" style="v" sid="GAL 3:17" />पुण मी ज्यो केथु जो वायदो बोगवान पेलुस रेन पाकी किरेल एती, तीह नेम चार होव तीस वोरह्यान बाद आवणार नेम नाह बोदेल सिकेत काय वायदो बिगेर कामान ठेराय। <verse eid="GAL 3:17" /><verse number="18" style="v" sid="GAL 3:18" /><note caller="+" style="x"><char style="xo" closed="false">3:18 </char><char style="xt" closed="false"><ref loc="ROM 4:14">रोमीयो 4:14</ref></char></note>काहाकाय बोगवानान उत्तर आदिकारान नेमा पोर रेन सापड़ेल हे ताहार ओवतो वायदो केरीन नाह, पुण बोगवान अब्राहामाह वायदान द्‍वारा आप दियेल हे।<verse eid="GAL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19" />ताहार ओवतो नेमान उद्देश काय ईतो? तो ते गुनेगारान वोजेसे बाद माय आपानो काय ती वोचीह आवणे वोर रेय, जाह वायदो आपायेल एतो; एने नेम हेरोगदुतान द्‍वारा एक मद्यस्थान वेहा माय मुसान मोदेकी केरीन आथे ठेराय गीयो। <verse eid="GAL 3:19" /><verse number="20" style="v" sid="GAL 3:20" />मद्यस्थ ते दुयान विचीम रीथे, पुण बोगवान एकुस हे।<note caller="+" style="f"><char style="fr" closed="false">3:20 </char><char style="ft" closed="false">एने बोगवान एक हे; नाहते एने बोगवान एखालोच काम किरेह।</char></note><verse eid="GAL 3:20" /></para>
  <para style="s">नेम ने उद्देश</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21" />ताहार काय नेम बोगवानान वायदान विरोद माय हे? केदिस नाह! काहाकाय केदी ओहलो नेम आपाय जातो जो जीवणो आप सिकेह, ताहार खेरीच देरमी पोण नेमा केरीन रेती। <verse eid="GAL 3:21" /><verse number="22" style="v" sid="GAL 3:22" />पुण चोखाली पुस्तेक आखाह पापान ताबाम केर दिनो, काहाकाय तो वायदो जो बोरहान द्‍वारा यीशु मसीम हे, बुरहो केरनारान केरता पुरी एय जाय।<verse eid="GAL 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23" />पुण बोरहाह आवणेन पेल नेमान काबा माय आपणी देखरेत एताली, एने ता बोरहाह आवणे वोर जो देखाण्यो ईतो, आपु तास ने बोंदेन माय रेहु। <verse eid="GAL 3:23" /><verse number="24" style="v" sid="GAL 3:24" />तानकेरता नेम मसी वोर पोचाड़नेन केरता आपणो मास्तेर ईयेल हे काय आपु बोरहा केरीन देरमी ठेराहु। <verse eid="GAL 3:24" /><verse number="25" style="v" sid="GAL 3:25" />पुण जेवी बुरहो आव लागो, ताहार आमु एवी नेमान काबाम नाय रिज्यो। <verse eid="GAL 3:25" /><verse number="26" style="v" sid="GAL 3:26" />काहाकाय तुमू आखा ता बोरहान द्‍वारा जो मसी यीशु पोर हे, बोगवानान सोरा हेते। <verse eid="GAL 3:26" /><verse number="27" style="v" sid="GAL 3:27" />एने तुमरे माय रेन जोलाक मसी माय बपतीस्मा लियेल हेते, ता आखा मसी माय एक एय जायेल हेते। <verse eid="GAL 3:27" /><verse number="28" style="v" sid="GAL 3:28" />एवी नाह कुण यहुदि हे एने नाह बिगेर यहुदि, नाह कुण गुलाम हे एने नाह स्वतंत्र, नाह कुण एदमी हे एने नाह बायकु, काहाकाय तुमू आखा मसी यीशु माय एक हेते। <verse eid="GAL 3:28" /><verse number="29" style="v" sid="GAL 3:29" /><note caller="+" style="x"><char style="xo" closed="false">3:29 </char><char style="xt" closed="false"><ref loc="ROM 4:13">रोमीयो 4:13</ref></char></note>एने केदी तुमू मसीन हेते ताहार अब्राहाम ने वोच एने वायदान गेत वारीस बी हेते।<verse eid="GAL 3:29" /></para>
  <chapter eid="GAL 3" />
  <chapter number="4" style="c" sid="GAL 4" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1" />मी ज्यो केथु काय वारीस जाह वोर सोरो हे, पुण आखी चिजीन मालीक हे, तीबी ता माय एने गुलाम माय काय फारेक नाह रेणे। <verse eid="GAL 4:1" /><verse number="2" style="v" sid="GAL 4:2" />पुण आबोख ठेरायेल टेम वोर तो राखवाली केरनारे एने कारबारीन ताबाम रीथे। <verse eid="GAL 4:2" /><verse number="3" style="v" sid="GAL 4:3" />तिहेच केरीन आपु बी, जेवी सोरा एता, ते दुनियान पेल हिकवोणान काबाम एन गुलाम बोण रियेल एता। <verse eid="GAL 4:3" /><verse number="4" style="v" sid="GAL 4:4" />पुण जेवी टेम पुरो एनो, ते बोगवान तान बेटाख मोकल्यो जो बायकु से पायदा ईनो, एने तो नेमान काबाम जीवतालो, <verse eid="GAL 4:4" /><verse number="5" style="v" sid="GAL 4:5" /><note caller="+" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="ROM 8:15-17">रोमीयो 8:15-17</ref></char></note>काहाकाय जा माणहे नेमान काबाम हेते ताह सोड़वे जाकेरीन आपु बोगवानान सोरा बोण सिके। <verse eid="GAL 4:5" /><verse number="6" style="v" sid="GAL 4:6" /><note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false">तुमू हेते ज्यो देखाड़नेन केरता; नाहते तुमू हेते केरीन।</char></note>एने तुमू जा सोरा हेते, तानकेरता बोगवान तान बेटाख ने जीवाह, जा “एय आबा, एय आबा केयीन आयेड़तेह,” आपणे मोना माय मोकलेल हे। <verse eid="GAL 4:6" /><verse number="7" style="v" sid="GAL 4:7" />केरीन तु एवी रेन गुलाम नाह, पुण बिटोख हे; एने बिटोख हे, ताहार बोगवानान द्‍वारा वारीस बी हे।<verse eid="GAL 4:7" /></para>
  <para style="s">गलातीयान बाराम पौलुसान चिन्ता</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8" />पुण पेल ते तुमू बोगवानाह नाह ओलेखताला एने ता बोगवानान गुलाम एता जो खेरीच बोगवान नाह सोतो, <verse eid="GAL 4:8" /><verse number="9" style="v" sid="GAL 4:9" />पुण एवी जा तुमू बोगवानाह ओलखी लियेल हेते एने बोगवान तुमूह ओलख्यो, ते ती कोमजोर एने बिगेर कामान पेल्‍ली हिकवोणान वातुन उगे काहा फिरतेह, जान तुमू पोशा गुलाम बोणने होदतेह? <verse eid="GAL 4:9" /><verse number="10" style="v" sid="GAL 4:10" />तुमू खास दिह्याह, एने मोयनाह, मोसमाह एने वोरह्याह मानतेह। <verse eid="GAL 4:10" /><verse number="11" style="v" sid="GAL 4:11" />मी तुमरे बाराम बिथु, इही नाय एय काय जी मेहनेत मी तुमरे केरता किरेल हे ती बिगेर कामान ठेराय।<verse eid="GAL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12" />एय बाय बोणहा, मी तुमूह विन्ता केरथु, तुमू मार गेत एय जावो; काहाकाय मी बी तुमरे गेत एय जायेल हे; तुमू मारो काय नुकसान केऱ्या नाह। <verse eid="GAL 4:12" /><verse number="13" style="v" sid="GAL 4:13" />पुण तुमू जाणतेह काय पेल्‍ली वार मी सेरीरान कोमजोरीन वोजेसे तुमूह हाजाली खुबेर होमलाड्यो। <verse eid="GAL 4:13" /><verse number="14" style="v" sid="GAL 4:14" />एने तुमू मारी सारिरीक देशाह जी तुमरी पारेख ने कारेण एती, खाराब नाह जाण्यो; नाह ताह सीट केऱ्या; पुण तुमू माहु बोगवानान हेरोगदुत खुद यीशु मसीन गेत माहु स्वीकार केऱ्या। <verse eid="GAL 4:14" /><verse number="15" style="v" sid="GAL 4:15" />ते ती तुमरी खुसी मोणावणो काहरी गीयो? मी तुमरो गोवा हे काय केदी एय सेकतो ते तुमू तुमरा डोला बी निकालीन माहु आप देता। <verse eid="GAL 4:15" /><verse number="16" style="v" sid="GAL 4:16" />ताहार काय तुमूह खेरी बोलनेन वोजेसे मी तुमरो दुसमोन बोण जायेल हे? <verse eid="GAL 4:16" /><verse number="17" style="v" sid="GAL 4:17" />ता तुमूह दोस्ती बाणावणे ते होदतेह, पुण हाजाला उद्देश केरीन नाह; ता तुमूह माहु रेन आंगे केरने होदतेह काय तुमू ताहास दोस्ती बाणाव लिवो। <verse eid="GAL 4:17" /><verse number="18" style="v" sid="GAL 4:18" />पुण ज्यो बी हाजो हे काय हाजाली वाती माय आखी टेम दोस्ती बाणावणेन कोसीत केराय जाय, फोक्‍तो तीस टेम नाह जेवी मी तुमरे हिऱ्यो रेथु। <verse eid="GAL 4:18" /><verse number="19" style="v" sid="GAL 4:19" />एय मारा सोरा, जाह वोर तुमरे माय मसीन रूप नाय बोण जाय, ताह वोर मी तुमरी केरता पोशो प्रसवान गेत पिड़ा वेठथु। <verse eid="GAL 4:19" /><verse number="20" style="v" sid="GAL 4:20" />मोरजी ते ज्यी ईथे काय एवी तुमरी फाय आवीन उंजु हास केरीन बोलु, काहाकाय मी तुमरी केरता दुविदा माय हे।<verse eid="GAL 4:20" /></para>
  <para style="s">सारा एने हाजीरान उदारण</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21" />तुमू जा नेमान काबाम एणे होदतेह, माहु किवो, काय तुमू नेमान नाह होमेलते? <verse eid="GAL 4:21" /><verse number="22" style="v" sid="GAL 4:22" />ज्यो लिखेल हे काय अब्राहाम ने दुय सोरा एना; एक पावेरनी केरीन एने एक स्वतंत्र बायकु केरीन। <verse eid="GAL 4:22" /><verse number="23" style="v" sid="GAL 4:23" />पुण जो सोरो पावेरनी केरीन पायदा एनो तो सारिरीक रिती केरीन पायदा एनो, एने जो सोरो स्वतंत्र बायकु केरीन एनो तो वायदान गेत पायदा एनो। <verse eid="GAL 4:23" /><verse number="24" style="v" sid="GAL 4:24" />न्या माय एक किस्सो हे: ज्‍यु बायकु दुय वायदो हेत्यु, एक ते सिनाय बोयड़ान जी केरीन फोक्‍तो गुलामुस पायदा एतेह एने ती हाजीरा हे। <verse eid="GAL 4:24" /><verse number="25" style="v" sid="GAL 4:25" /><note caller="+" style="f"><char style="fr" closed="false">4:25 </char><char style="ft" closed="false">हाजीरा हे, थोड़ाक लेख माय सिनाय ज्यो अरब देसान एक बुयड़ो हे; एने तो।</char></note>एने हाजीरा अरब ने सिनाय बुयड़ो हे, जो एवीवालो यरूशलेमान गेत हे, काहाकाय तो तान सोरा बेल गुलाम माय हे। <verse eid="GAL 4:25" /><verse number="26" style="v" sid="GAL 4:26" />पुण उपेर वालो यरूशलेम स्वतंत्र हे, एने ती आपणी आहख हे। <verse eid="GAL 4:26" /><verse number="27" style="v" sid="GAL 4:27" />काहाकाय पुस्तेक माय लिखेल हे:</para>
  <para style="q1" vid="GAL 4:27">“एय वांज! तु जी नाह जिणेत मालीक माय खुसी मोणाम!</para>
  <para style="q2" vid="GAL 4:27">तु जी प्रसव पिड़ा नाह जाणेत, गिलो काड़ीन जय जयकार केर!</para>
  <para style="q1" vid="GAL 4:27">काहाकाय जीन एदमी हे तीन सोराह रेन</para>
  <para style="q2" vid="GAL 4:27">आसा सोड़ेल बायकुन सोरा जादा हेते।”<verse eid="GAL 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28" />एय बाय बोणहा, आपु इसहाक ने गेत वायदान सोरा हेते। <verse eid="GAL 4:28" /><verse number="29" style="v" sid="GAL 4:29" />एने जिहकेरीन ती टेम सेरीरान गेत पायदा ईयेल जीवान गेत पायदा ईयेलाह वेला केरावतालो, तिहेस केरीन एवी बी ईथे। <verse eid="GAL 4:29" /><verse number="30" style="v" sid="GAL 4:30" />पुण चोखाली पुस्तेक माय काय लिखेल हे? “पावेरनी एने तीन सोराह निकाल दिवो, काहाकाय पावेरनीन सोरो स्वतंत्र बायकुन सोरा हेऱ्यो वारीस नाय एय।” <verse eid="GAL 4:30" /><verse number="31" style="v" sid="GAL 4:31" />तानकेरता एय बाय बोणहा, आपु पावेरनीन नाह पुण स्वतंत्र बायकुन सोरा हेते।<verse eid="GAL 4:31" /></para>
  <chapter eid="GAL 4" />
  <chapter number="5" style="c" sid="GAL 5" />
  <para style="s">मसी माय स्वतंत्रा</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1" />मसी स्वतंत्रान केरता आपुह स्वतंत्र किरेल हे, तानकेरता मोजबुत रिवो एने गुलाम ने जुवाला माय पोशा मा सापड़ो।<verse eid="GAL 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2" />हुमलो, मी पौलुस तुमूह केथु काय केदी खेतना केरावहो, तुमू मसीन उगे से तुमूह काय फायदो नाय एय। <verse eid="GAL 5:2" /><verse number="3" style="v" sid="GAL 5:3" />तीबी मी आखा खेतना केरावणाराह केय दिथो काय ताह आखो नेम मान्ने पोड़ी। <verse eid="GAL 5:3" /><verse number="4" style="v" sid="GAL 5:4" />तुमू जा नेमान द्‍वारा न्यायी ठेराणे होदतेह, मसी रेन आंगे एने गीणीह रेन पोड़ जायेल हेते। <verse eid="GAL 5:4" /><verse number="5" style="v" sid="GAL 5:5" />काहाकाय जीवान वोजेसे आमु बोरहा केरीन, आसा किरेल देरमीपोणान वाट जोवतेह। <verse eid="GAL 5:5" /><verse number="6" style="v" sid="GAL 5:6" />जेवी मसी यीशु माय एक एतेह, तेवी नाह खेतनान काह काम हे, एने नाह बिगेर खेतनान एणेन; पुण फोक्‍तो बोरहान जो मोंगान द्‍वारा ईथे। <verse eid="GAL 5:6" /><verse number="7" style="v" sid="GAL 5:7" />तुमू ते हास केरीन दोवेड़ताला। एवी कुण तुमूह रोक देनो काय खेरायीह नाय माने। <verse eid="GAL 5:7" /><verse number="8" style="v" sid="GAL 5:8" />ओहली हिक तुमूह हादणारा बोगवानान उगे रेन नाह। <verse eid="GAL 5:8" /><verse number="9" style="v" sid="GAL 5:9" /><note caller="+" style="x"><char style="xo" closed="false">5:9 </char><char style="xt" closed="false"><ref loc="1CO 5:6">1 कुरिंथीयो 5:6</ref></char></note>थोड़ोक खमीर कुहणेल पुरा फिटाह खमीर केर दिथे। <verse eid="GAL 5:9" /><verse number="10" style="v" sid="GAL 5:10" />माहु मालीक माय तुमरी पोर बुरहो हे काय तुमरो एगदो दिहरो विचार नाय रेय; पुण जो तुमूह बिवाड़ दिथे, तो एगदो काहा नाय रेय डेंड बोगी।<verse eid="GAL 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 5:11" />पुण एय बाय बोणहा, केदी मी आज बी जीहे काय थोड़ाक माणहे सोमेजतेह खेतनान ज्यो पारचार केरथु ते माहो एवी वोर काहा सेतावेह? तेवी मसीन खुरूसखाम ने कारीन पायदा ईयेल सोब बादा खेतेम एय जाणे जुवे। <verse eid="GAL 5:11" /><verse number="12" style="v" sid="GAL 5:12" />हाजो रेतो काय जा तुमूह दुखी केरतेह ता सोता तास ने सेरीर काट देता।<verse eid="GAL 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13" />एय बाय बोणहा, तुमू स्वतंत्र एणेन केरता हादाड़ाय जायेल हेते; ज्यी स्वतंत्राह सारिरीक कामान केरता सादेन मा बाणावो, पुण मोंग से एका दिहरान सेवा किरो। <verse eid="GAL 5:13" /><verse number="14" style="v" sid="GAL 5:14" />काहाकाय आखो नेम ज्यी एकुस वाती माय पुरी एय जाथे, “तु तारा आहेंल्या हिऱ्यो तार गेत मोंग केर।” <verse eid="GAL 5:14" /><verse number="15" style="v" sid="GAL 5:15" />पुण केदी तुमू एका दिहराह दुख एने पोचाड़तेह दाता केरीन चावतेह एने फाड़ खातेह, ते चेकचेल्या रिवो काय एका दिहरान खेतेम नाय केर दिहो।<verse eid="GAL 5:15" /></para>
  <para style="s">चोखाला जीवान द्‍वारा जीवाय</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16" />पुण मी केथु, चोखाला जीवान गेत चालो ताहार तुमू सेरीरान लालुस काल्ली बी रिती से पुरी नाय किरहो। <verse eid="GAL 5:16" /><verse number="17" style="v" sid="GAL 5:17" /><note caller="+" style="x"><char style="xo" closed="false">5:17 </char><char style="xt" closed="false"><ref loc="ROM 7:15-23">रोमीयो 7:15-23</ref></char></note>काहाकाय सेरीर ते जीवान विरोद माय एने जीव सेरीरान विरोद माय लालुस किरेह, एने ज्या एका दिहरान विरोदी हेते; ज्यानकेरता काय जो तुमू केरने होदतेह ताह नाय केर सिकहो। <verse eid="GAL 5:17" /><verse number="18" style="v" sid="GAL 5:18" />पुण केदी तुमू जीवान चालाड़ेल चालतेह, ताहार नेमान काबाम नाह रेना। <verse eid="GAL 5:18" /><verse number="19" style="v" sid="GAL 5:19" />सेरीरान काम ते देखातेह, मतलब सिनालो, खाराब पोण, बोगविलास, <verse eid="GAL 5:19" /><verse number="20" style="v" sid="GAL 5:20" />मुरती पुजा, जादुटोणा, दुसमोनाय, राड़, कुयराणे, राग, स्वार्थीपोण, फुट, विदर्म, <verse eid="GAL 5:20" /><verse number="21" style="v" sid="GAL 5:21" />दारकुट्यो, लीलाक्रिड़ा एने इहकेरीन दिहरा उंजु कामे हेते, जान बाराम मी तुमूह पेलुस रेन केय दिथो जिहकेरीन पेल केय बी दियेल हे, काय ओहला ओहला काम केरनारे बोगवानान राज ने वारीस नाय रेती। <verse eid="GAL 5:21" /><verse number="22" style="v" sid="GAL 5:22" />पुण जीवान फोल मोंग, खुसी, सान्ती, दिर, गीण, बोलाय, बुरहो, <verse eid="GAL 5:22" /><verse number="23" style="v" sid="GAL 5:23" />गेरबोड़ाय, एने संयम हे; ओहला ओहला कामान विरोद माय काल्लो बी नेम नाह। <verse eid="GAL 5:23" /><verse number="24" style="v" sid="GAL 5:24" />एने जा मसी यीशुन हेते, ता सेरीराह तान आसा एने अबिलाषा बेल खुरूसखाम पोर चेड़ाव दियेल हे। <verse eid="GAL 5:24" /><verse number="25" style="v" sid="GAL 5:25" />केदी आपु जीवान द्‍वारा जीवताला हेते, ताहार जीवान गेत चाले बी। <verse eid="GAL 5:25" /><verse number="26" style="v" sid="GAL 5:26" />आपु गोमेंडी नाय बोणी एने एका दिहराह नाय विताड़े, एने नाय एका दिहरा हेऱ्या कुयराय केरी।<verse eid="GAL 5:26" /></para>
  <chapter eid="GAL 5" />
  <chapter number="6" style="c" sid="GAL 6" />
  <para style="s">एका दिहरान मोदेक किरो</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1" />एय बाय बोणहा, केदी एगदो माणुह एगदा गुना माय देराय बी जाय ताहार तुमू जा आत्मिक हेते, गेरबोड़ायी हेऱ्या ताह होमालो, एने तुमरी बी चोकसी मीलो काय तुमू बी पारेख माय नाय पोड़हो। <verse eid="GAL 6:1" /><verse number="2" style="v" sid="GAL 6:2" />तुमू एका दिहराह मोदेक किरो, एने इहकेरीन मसीन नेमाह पुरा किरो।<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="ft" closed="false">तुमू उकुमान पालेन किरहो; थोड़ाक लेख माय उकुम ने पालेन किरो।</char></note> <verse eid="GAL 6:2" /><verse number="3" style="v" sid="GAL 6:3" />काहाकाय केदी एगदो माणुह कायच नाह एणेन बाद बी सोताह काह सोमजेह, ताहार सोताह दुको दिथे। <verse eid="GAL 6:3" /><verse number="4" style="v" sid="GAL 6:4" />पुण एकेक माणुह तान कामाह पारखी, तेवी ताह दिहरान बाराम नाह, पुण तास ने बाराम गोमेंड केरनेन टेम जुड़ी। <verse eid="GAL 6:4" /><verse number="5" style="v" sid="GAL 6:5" />काहाकाय एकेक माणुह तास ने बार विसणे जुवे।<verse eid="GAL 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6" />जो वचनान हिक सापड़ावेह, तो आखी हाजी चिज माय हिकाड़णाराह गोवांद्यो बाणावी।<verse eid="GAL 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 6:7" />आपणे आपाह दुको मा आपो बोगवान फुगो नाह सुतो, तुमू तोच काटहो जो तुमू पिरहो। <verse eid="GAL 6:7" /><verse number="8" style="v" sid="GAL 6:8" />केदी तुमू तुमरी सोबावीक आसान ईलाका माय पेरतेह, ते तुमू मोतीन पाक टुलो किरहो; केदी तुमू जीवान ईलाका माय पेरतेह, ते तुमू जीवा केरीन जेलेमक्यो जीवाय ने फोल काटी। <verse eid="GAL 6:8" /><verse number="9" style="v" sid="GAL 6:9" />आपु हाजालो काम केरने माय आलह्याय नाय केरी, काहाकाय केदी आपु आरवाहो नाय, ताहार ठिक टेम पोर काटणी काटहु। <verse eid="GAL 6:9" /><verse number="10" style="v" sid="GAL 6:10" />तानकेरता जाह वोर टेम जुड़ी आपु आखा हेऱ्या हाजो केरी, खास केरीन विश्वासी परीवार वाला बाय बोणहा हेऱ्या।<verse eid="GAL 6:10" /></para>
  <para style="s">सेवली चेतावणी एने नमस्‍कार</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11" />दिखो, मी कोहला मोटला मोटला अक्‍सरा माय तुमूह मारा आथा केरीन लिखेल हे। <verse eid="GAL 6:11" /><verse number="12" style="v" sid="GAL 6:12" />जा माणहे सारिरीक दिखलावो होदतेह तास तुमरो खेतना केरावणेन केरता दाबाव टाकतेह, फोक्‍तो ज्यानकेरता काय ता मसीन खुरूसखाम ने वोजेसे वेला नाय एणे जुवे। <verse eid="GAL 6:12" /><verse number="13" style="v" sid="GAL 6:13" />काहाकाय खेतना केरावणारे सोता ते नेम पोर नाह चालते, पुण तुमरो खेतना ज्यानकेरता केरावणे होदतेह काय तुमरी सारिरीक देशा पोर मोठलाय केरी। <verse eid="GAL 6:13" /><verse number="14" style="v" sid="GAL 6:14" />पुण ओहलो नाय एय काय मी दिहरी एगदी वातीन मोठलाय केरू, फोक्‍तो आपणो मालीक यीशु मसीन खुरूसखाम ने, जान द्‍वारा दुनिया मार नेजरी माय एने मी दुनियान नेजरी माय खुरूसखाम पोर चेड़ावाय जायेल हे। <verse eid="GAL 6:14" /><verse number="15" style="v" sid="GAL 6:15" />काहाकाय नाह खेतना महत्व हे एने नाह विण खेतनान केदी महत्व हे, ते तो विण खेतनान। <verse eid="GAL 6:15" /><verse number="16" style="v" sid="GAL 6:16" />जोला ज्या नेमा पोर चालती ता पोर, एने इस्राएल ने माणहा पोर बोगवानान सान्ती एने गीण ईती रेय।<verse eid="GAL 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17" />एवी रेन माहु कुण तारास नाय देय, काहाकाय मारा सेरीर माय जो जेखेम हे, तो देखाड़ीह काय मी यीशुन पावोर हे।<verse eid="GAL 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18" />एय बाय बोणहा, आपणो मालीक यीशु मसीन गीण तुमरा जीवा हिऱ्यो बोणीन रेय। आमेन।<verse eid="GAL 6:18" /></para>
  <chapter eid="GAL 6" />
</usx>