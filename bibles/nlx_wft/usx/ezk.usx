<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EZK" style="id">- Nahali</book>
  <para style="h">यहेजकेल</para>
  <para style="toc3">यहेजकेल</para>
  <para style="toc2">यहेजकेल</para>
  <para style="toc1">यहेजकेल</para>
  <para style="mt2">यहेजकेल भविष्यवक्ता कि किताब</para>
  <para style="mt1">यहेजकेल जाणकारान पुस्तेक</para>
  <para style="imt">ओलखात</para>
  <para style="ip">यहेजकेलान पुस्तेक इस्राएल ने पोड़ने एने तान पोशो बाणावणेन बाराम जाणाव ने एक पुस्तेक हे। जाणाव केरनार यहेजकेल ने बाराम जी काय बी जाणकारी जुड़ी ती पुस्तेक माय रेन जुड़ेह। तान जाणाव केरनेन सेवा 22 वोरह्या वोर चालनी, 7 यीशुन पेल 586 माय यरूशलेमाह पोड़नेन पेल एने 15 वोरह्यान बाद। तान देरसेनान जापाप माय, यहेजकेलाह जुलूम वोस्तुह केरनेन गिरेज एती जी इस्राएल हेऱ्यी एय। एक उदारेण अध्याय 5 माय जुड़ेह, जा ताह तान दाढ़ी काटणे एने लेट्याह तीन बागा <char style="xt"><ref loc="EZK 5:1">5:1</ref></char> माय आलेग आलेग केरनेन केरता कियेल एतो, जा माय देखाड़ेल एतो काय यरूशलेम ने काय एय।</para>
  <para style="ip">यहेजकेल ने पुस्तेक मुखी तीन बागाम वाटेल हे; इस्राएल ने नियाव, आस पास ने देसान नियाव, एने इस्राएलाह पोशो बाणावणे। न्या तीनु बागाम एक मुखी विषय ज्य हे काय कोहल्यु वोस्तु आपुह बोगवानाह जाणनेन केरता उत्साहित केरी। यहेजकेल 60 रेन बी जादा वार ज्य वाक्य लिखेल हे, “तेवी ता सोमेजती काय मी बोगवान हे।” केदी बोगवान नियाव केरने बाजरिनो एय नाहते पुशो बाणावणे बाजरिनो एय, आपु तान बाराम एने तो आपु फाय रेन काय हुदेह, तो हिक सेकतेह।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. इस्राएल पोर बोगवानान नियावान वर्णन हे <char style="xt"><ref loc="EZK 1:1">1:1</ref>; <ref loc="EZK 24:27">24:27</ref></char>।</para>
  <para style="io1">2. अध्याय 25 रेन 32 माय बोगवान आस पास ने देसान नियाव किरेह <char style="xt"><ref loc="EZK 25:1">25:1</ref>; <ref loc="EZK 32:32">32:32</ref></char>।</para>
  <para style="io1">3. यहेजकेल इस्राएलाह पोशो बोणनेन बाराम जाणाव किरेह <char style="xt"><ref loc="EZK 33:1">33:1</ref>; <ref loc="EZK 48:35">48:35</ref></char>।</para>
  <chapter number="1" style="c" sid="EZK 1" />
  <para style="s">यहेजकेलाह बोगवाना उगे रेन पेल्लो देरसेन</para>
  <para style="r">(<ref loc="EZK 1:1">यहेजकेल 1:1</ref>; <ref loc="EZK 7:27">7:27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 1:1" />तीसवा वोरह्यान चौथा मोयनान पाचवे दिह, जेवी मी ठेरायेल बोंदिन विचीम कबार नेदीन मीरे इतो, तेवी ओहलो एनो काय हेरोग उगड़ेल एने मी बोगवानान देरसेन दिख्यो। <verse eid="EZK 1:1" /><verse number="2" style="v" sid="EZK 1:2" /><note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="1KI 4:10-16">1 राजा 4:10-16</ref>; <ref loc="2CH 9:10">2 इतिहास 9:10</ref></char></note> गुलामीन विचीम कसदीन देसाम, यहोयाकीम राजान राज ने पाचवा वोरह्या माय ताच मोयनान पाचवे दिह। <verse eid="EZK 1:2" /><verse number="3" style="v" sid="EZK 1:3" />बोगवानान ज्य वचन बूजीन बेटाख यहेजकेल चाकऱ्या फाय कबार नेदीन मीरे पोचनो, एने ताहरी देखानो एने बोगवानान ताकेत ताहरी ता पोर एती।<verse eid="EZK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 1:4" />जेवी मी देखणे बाज गीयो, ते मी उत्तेर उगे रेन एक बुत्यो आवतालो दिख्यो। एने मोटलो वादेल चारो उगे उजोड़ एने आक्‍ठान विचीम चोमेकतालो पितलान काह आवतालो देखानो।<verse eid="EZK 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 1:5" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:5 </char>
      <char style="xt" closed="false">
        <ref loc="REV 4:6">प्रकाशितवाक्य 4:6</ref>
      </char>
    </note>तान माय जिवताला जेनवेरान गेत चार साप एता, तान वेह माणहान गेत एतो। <verse eid="EZK 1:5" /><verse number="6" style="v" sid="EZK 1:6" />ता माय रेन आखान चार चार मुख एने चार चार फाके एता।<verse eid="EZK 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 1:7" />तान खुऱ्या हुतरा एने वासड़ान खुऱ्यान गेत एता, एने ता चोमकाड़ेल पितलान गेत चोमेकताला। <verse eid="EZK 1:7" /><verse number="8" style="v" sid="EZK 1:8" />तान कावदेन फाका बुंदे माणहान गेत आथ एता एने ता चारून मुख एने फाके इह केरीन एता। <verse eid="EZK 1:8" /><verse number="9" style="v" sid="EZK 1:9" />तान फाके एका दिहरा हेऱ्या जोड़ाईल एता, एने चालने बुखेत तान फाके वोलताला नाह; एने आखा जिव जिवान सोमोर हुतरा चालताला पुण नाह वोलताला।<verse eid="EZK 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 1:10" />तान मुख इह केरीन देखातालो; चार माय रेन आखान एक एक मुख माणहान गेत एतो, एने डाखरी उगे सिंहान गेत, एने जिवड़ी उगे एक एक मुख बोयलान गेत, एने चारून मुय गुवड़ान गेत एतो चालने बुखेत नाह वोलताला। <verse eid="EZK 1:10" /><verse number="11" style="v" sid="EZK 1:11" />तान मुये ओहला एता। एने तान मुख एने फाके उपेर उगे आंग आंगे एता; आखा जीवान दुय दुय फाके एता, जा एक दिहरान फाका हेऱ्या जोड़ाय रियेल एता, एने दुय दुय फाका केरीन तान सेरीर डापायेल एतो। <verse eid="EZK 1:11" /><verse number="12" style="v" sid="EZK 1:12" />आखान आखा ओंगाण हुतरा जाताला, जाहरी काहरी बी जीव जातालो, एने ता चालने बुखेत नाह वोलताला।<verse eid="EZK 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 1:13" />ता जीवताला जीवान वेह आक्‍ठान हेलेगताला कोल्यान गेत देखातालो, एने तो आक्‍ठो जीवान विचीम इही तिहे हेरकी तालो; तो आक्‍ठो उजोड़ पाड़तालो; एने ता आक्‍ठा केरीन विजली निकेलताली। <verse eid="EZK 1:13" /><verse number="14" style="v" sid="EZK 1:14" />जीवान चालनो फिरनो विजलीन गेत जोरेस एतो।<verse eid="EZK 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 1:15" />जेवी मी ता जीवाह देखणेच बाज रियेल एतो, ते काय दिख्यो काय बुई पोर ता फाय चारू मुखान गेणती माय, एक-एक चाकारा एता। <note caller="+" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="EZK 10:9-13">यहेजकेल 10:9-13</ref></char></note> <verse eid="EZK 1:15" /><verse number="16" style="v" sid="EZK 1:16" />ता चाकारान वेह एने बाणावोट इह केरीन एती, ता होनान मोणीन गेत पिपेलताला, एने चारू एक हारका देखाताला, एने आखा चाकारा इह केरीन बाणायेल एता, काय एक चाकारान विचीम दिहरो चाकारो रेय। <verse eid="EZK 1:16" /><verse number="17" style="v" sid="EZK 1:17" />चालने बुखेत ता तान चार चोमखेर चाल सेकताला, एने चालने बुखेत नाह वोलताला। <verse eid="EZK 1:17" /><verse number="18" style="v" sid="EZK 1:18" /><note caller="+" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="REV 4:8">प्रकाशितवाक्य 4:8</ref></char></note> ता चाकारान गोलाव जुलूम मोठा एने बिय आवी ओहला एता, एने ता चारू चाकारान गोलावा माय डोलाच डोला एता। <verse eid="EZK 1:18" /><verse number="19" style="v" sid="EZK 1:19" />जेवी ता जीव चालताला, केदी ता जीव उपेर हवा माय उखलाताला, ते चाकारा बी ता हेऱ्या उखलाताला। <verse eid="EZK 1:19" /><verse number="20" style="v" sid="EZK 1:20" />ता ताहरीच जाताला, जाहरी जीव ताह लिजाणे हुदे, एने चाकारा बी ता हेऱ्या उपेर उखलाताला, काहाकाय ता जीवान जीव ता चाकारा माय एती। <verse eid="EZK 1:20" /><verse number="21" style="v" sid="EZK 1:21" />केरीन केदी जीव चालताला, ते चाकारा बी चालताला; केदी ता जीव उबरी जाताला ते चाकारा बी उबरी जाताला; केदी केदी ता जीव उपेर हवा जाताला ते चाकारा बी उपेर जाताला, काहाकाय तान जीव चाकारा माय इतो।<verse eid="EZK 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 1:22" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:22 </char>
      <char style="xt" closed="false">
        <ref loc="REV 4:6">प्रकाशितवाक्य 4:6</ref>
      </char>
    </note>ता जीवान मुंडा पोर जोगणान गेत काह एतो जो ओहटान गेत बिवाड़े ओहलो चोमेकतालो, एने तो तान मुंडा पोर पोसरी रियेल एतो। <verse eid="EZK 1:22" /><verse number="23" style="v" sid="EZK 1:23" />ज्या जुगमोन्डेल बुंदे आखा जीवान हुतरा फाके एता, एने आखा जीवान दुय दुय फाके एता जा केरीन तान सेरील डापायेल एतो। <verse eid="EZK 1:23" /><verse number="24" style="v" sid="EZK 1:24" /><note caller="+" style="x"><char style="xo" closed="false">1:24 </char><char style="xt" closed="false"><ref loc="REV 1:4-15">प्रकाशितवाक्य 1:4-15</ref>; <ref loc="REV 19:6">19:6</ref></char></note> जेवी ता जीव चालताला, ते तान फाकान फोड़फोड़ आवाज माहु देरीयान पाण्यान खेकलो हारको, एने आखी ताकेतवाला आवाजा हारको, सेनान फड़फड़ान हारको आवाज आवतालो, जेवी ता उबरेताला, ते ता तान फाके नेड़ा केर लेताला। <verse eid="EZK 1:24" /><verse number="25" style="v" sid="EZK 1:25" />जेवी ता उबरियेल एता एने तान फाके बुंदे वाल लेताला, तेवी तान मुंडा पोर जो जुगमोन्डोल इतो, ता पोर रेन एक आवाज होमलातालो। एने जेवी ता उबरेताला तेवी तान फाके नेड़ा केर लेताला।<verse eid="EZK 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EZK 1:26" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:26 </char>
      <char style="xt" closed="false">
        <ref loc="EZK 10:1">यहेजकेल 10:1</ref>; <ref loc="REV 4:2-3">प्रकाशितवाक्य 4:2-3</ref></char>
    </note> तान मुंडी पोर जो जुगमोन्डोल इतो जो एक निलमोणीन राजगादिन गेत देखातालो, एने ज्यी उचाली राजगादी पोर माणहा हारको एगदो देखातालो। <verse eid="EZK 1:26" /><verse number="27" style="v" sid="EZK 1:27" />मी तान कोमरान उपेर दिख्यो। काय चोमेकताला पितलान गेत देखातालो, ओहलो लागतालो काय आक्‍ठा माय बोरायेल एय, मी पुशो तान कोमरान बुंदे दिख्यो ते आक्‍ठान गेत देखातालो, एने तो चोमेकतालो उजेड़ ने गेत दिप पोड़तालो।<verse eid="EZK 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 1:28" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:28 </char>
      <char style="xt" closed="false">
        <ref loc="EZK 8:2">यहेजकेल 8:2</ref>
      </char>
    </note> जिह केरीन जेठवड़ीन दिह्या माय वादला माय बांड देखाह, तिहेच केरीन तान चार चोमखेर बोड़ाय देखातालो, बोगवानान ताकेत ओहलीच इतो, एने ताह देखीन, मी मुयान बोरहे जाय पुड़नो, तेवी मी एक सोबदो हुमल्यो जिह एगदो वातु किरेह।<verse eid="EZK 1:28" /></para>
  <chapter eid="EZK 1" />
  <chapter number="2" style="c" sid="EZK 2" />
  <para style="s">जाणाव केरनारान वेहाम यहेजकेलान हादावणी</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 2:1" />तो माहु केयो, “एय माणहान सोरा उबरेय जा, मी तार हिऱ्यो वातु केरूह।”<verse eid="EZK 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EZK 2:2" />जीहे तो मार हिऱ्यो वातु किऱ्यो, तिहेच जीव मार माय रिग गीयो एने माहु पायान बोरहे उबो केर दिनो; एने जो मार हिऱ्यो वातु केरतालो तान वातु हुमल्यो। <verse eid="EZK 2:2" /><verse number="3" style="v" sid="EZK 2:3" />तो माहु केयो, “एय माणहान सोरा, मी तुवाह इस्राएली माणहा फाय मोकेलथु, जो मारी वातीह नाकार केरनार देस हे; एने ता मारा उकुमाह तुड़ेल हेते; ता एने तान डायडाया आज वोर मारा उकुमाह तोड़ते आयेल हेते। <verse eid="EZK 2:3" /><verse number="4" style="v" sid="EZK 2:4" />जा माणहा फाय मी तुवाह मोकेलने बाज रिनोह, तान पिढीन माणहे विणलाज्या एने एकएट्या हेते। <verse eid="EZK 2:4" /><verse number="5" style="v" sid="EZK 2:5" />एने तु ताह किज्ये, मालीक बोगवान इही केरीन किथे, ता माय जा लेड़ाय केरनारा गेराणान हेते, ता होमली नाहते ते नाय होमली, तीबी ता ओलोक सोमजी लेती काय आपणी विचीम एक जाणकार आयेल हे।”<verse eid="EZK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 2:6" />“एय माणहान सोरा, तु ताह नाहते तान वातीह बिहे मा; ज्‍य खेरो हे काय ता तार विरूद एय जाती एने तुवाह दुख देणे होद्ती, ता काटाल्या जुरखेल्या एने विचान विचीम बी रेणे पोड़ी, पुण ता जो काय केती, त्यु वातुह मा बिहे, तान मुय देखीन तारो मोनाह कमजोर मा किरहे। <verse eid="EZK 2:6" /><verse number="7" style="v" sid="EZK 2:7" />तु ताह मारी वातु जोरूर किज्ये, ता होमली नाहते नाय होमली, काहाकाय ता ते राड़कुट्या हेते।”<verse eid="EZK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 2:8" />“पुण एय माणहान सोरा, जो मी तुवाह केथु, तो होमली ले, ता राड़कुट्या माणहान गेत मा किरहे; एने जो मी तुवाह आपथु, ताह मुय उगाड़ीन खाय ले।” <verse eid="EZK 2:8" /><verse number="9" style="v" sid="EZK 2:9" /><note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="REV 5:1">प्रकाशितवाक्य 5:1</ref></char></note> तेवी मी निजेर टाकीन दिख्यो, काय मार उगे एक आथ आवणे बाज रिनोह एने ता माय एक पुस्तेक हे।<note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="ft" closed="false">चामड़ान पोत्र</char></note><verse eid="EZK 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 2:10" />जाह तो मार सोमोर उगाड्यो, ती पुस्तेकीन दुयू उगे काहणो, रेड़नो, एने दुखान वातु लेखायेल एत्यु।<verse eid="EZK 2:10" /></para>
  <chapter eid="EZK 2" />
  <chapter number="3" style="c" sid="EZK 3" />
  <para style="p">
    <verse number="1" style="v" sid="EZK 3:1" />एने तो माहु केयो, “एय माणहान सोरा, जो तार सोमोर हे, ताह खा, मतलब ज्यी पुस्तेकीह खा; एने जाईन इस्राएल वाला माणहा हिऱ्यो वातु केर।”<verse eid="EZK 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EZK 3:2" />केरीन मी मारो मुय उगाड्यो, एने तो खाणेन माहु पुस्तेक आप्यो, <verse eid="EZK 3:2" /><verse number="3" style="v" sid="EZK 3:3" />तेवी तो माहु केयो, “एय माणहान सोरा, जी पुस्तेक मी तुवाह आपथु, तीह खा एने तारो पेट बोर।” तेवी मी तीह खाय लिदो, एने मारा मुया माय ती मोवालान गेत गुली लागनी।<verse eid="EZK 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 3:4" />तेवी तो माहु केयो, “एय माणहान सोरा, एवी इस्राएली माणहा फाय जा एने ताह मारी वातु होमलाड़। <verse eid="EZK 3:4" /><verse number="5" style="v" sid="EZK 3:5" />काहाकाय तु एगदी एनजाणी बोली नाहते केठीण बाषावाली फाय नाह मोकलाय जाथे, पुण इस्राएलान गेराणा फाय मोकलाय जाथे। <verse eid="EZK 3:5" /><verse number="6" style="v" sid="EZK 3:6" />मी तुमूह एगदा एनजाण्या देसा माय नाह मोकेलने बाज रिनोह, जाहरी माणहे ओहली बाषा बोलतेह काय तुमू सोमजी नाह सेकते। केदी तुमू ता माणहा फाय जाहो एने ता हेऱ्या वातु किरहो; ते ता तुमरी होमेलती। पुण तुमूह ती केठीण बाषाह सोमेजणु नाय मिले। <verse eid="EZK 3:6" /><verse number="7" style="v" sid="EZK 3:7" />पुण इस्राएल वाला माणहे तुमरी वातु होमेलने नाह होदते, काहाकाय ता मारी वातुह होमेलने नाह होदते; आखा इस्राएली तान मोनाह वातड़ो एने जिव जिवाह एकएट्या बाणाव लियेल हेते। <verse eid="EZK 3:7" /><verse number="8" style="v" sid="EZK 3:8" />पुण मी तुमूह तान गेत मुंड नेड़ा केरनार नाह पुण वातड़ो बाणाव देह। <verse eid="EZK 3:8" /><verse number="9" style="v" sid="EZK 3:9" />मी तुमरा मोनाह जुलूम वातड़ो बाणाव देह, चोमेकण्या देगड़ाह रेन बी वोदार वातड़ो बाणाव देह, तुमू ताह मा बिहो एने गाबराहो मा, तुमू ता माणहाह नाय बिहो जा जेलेम मार विरूद उठ जातेह।”<verse eid="EZK 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 3:10" />पुशो बोगवान माहु केयो, “एय माणहान सोरा, ज्यु वातु मी तुवाह केथु, त्युह द्यान लागाड़ीन हुमेल एने तारा मोना माय मेल। <verse eid="EZK 3:10" /><verse number="11" style="v" sid="EZK 3:11" />एने ता बोंदी फाय जा, तारा जाती हेगा हेते, ताह के, मालीक बोगवान ज्यी वात किथे; ता होमली नाहते नाय होमली।”<verse eid="EZK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 3:12" />तेवी बोगवानान जीव माहु उपेर उखल्यो, एने मी मार पासाण गेगड़नेन आवाज हुमल्यो, तो केयो, “बोगवानान बोड़ाय बोरकेत वाली हे।” <verse eid="EZK 3:12" /><verse number="13" style="v" sid="EZK 3:13" />एने ता हेऱ्योच ता जेनवेरान फाखान आवाज जा एका दिहरा हेऱ्या लागताला, ता आरहीन चाकारान आवाज एक मोटलीच गड़गड़ाट होमलाय पोड़नी। <verse eid="EZK 3:13" /><verse number="14" style="v" sid="EZK 3:14" />तेवी जीव माहु उपेर उखल्यो एने सिटो लेन गीयो, एने मारो मोन कोड़वो एने रागा माय बोराय गीयो, एने बोगवानान मोजबुत आथ मार पोर इतो। <verse eid="EZK 3:14" /><verse number="15" style="v" sid="EZK 3:15" />मी देरायेल ता माणहा फाय आवो, जा कबार नेदीन मीरे तेलाबीब हेयरा माय रेताला, ताहरी मी जुलूम दुखी एन ता हिऱ्यो सात दिह वोर बोह रिनो।<verse eid="EZK 3:15" /></para>
  <para style="s">राखवाल्यान रूप माय यहेजकेलान निवोड़</para>
  <para style="r">(<ref loc="EZK 33:1-9">यहेजकेल 33:1-9</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 3:16" />सात दिह एय गीया, तेवी बोगवानान ज्य वचन मार फाय पोचनो। <verse eid="EZK 3:16" /><verse number="17" style="v" sid="EZK 3:17" />“एय माणहान सोरा, मी तुवाह इस्राएलान माणहान केरता एक राखवाल्यो ठेरायेल हे; केरीन जी वातु मी केथु, तिह हुमेल एने ताह मार उगे रेन चेतावणी आप। <verse eid="EZK 3:17" /><verse number="18" style="v" sid="EZK 3:18" />जेवी मी एक पापी माणहाह केव, तु जोरूर मुरहे, एने केदी तु ताह चेतावणी नाय आपहे, एने पापीह ओहली वात नाय किहे, ता माय काय तो चेकचिल्यो रेय, एने तान खाराब वाट सोड़ीन जिवतालो रेय, ते तो पापी तान पापाम फोसीन मोरी, पुण तान खुनान लेख्यो मी तार फाय लेह। <verse eid="EZK 3:18" /><verse number="19" style="v" sid="EZK 3:19" />पुण केदी तु ता पापी माणहाह चेतावणी आपेह, एने तो तान पाप नाहते खाराब कामाह नाह सुड़ेत; ते तो तान पापा माय फोसीन मोरी, पुण तु सोताह वोचाड़ लिहे।”<verse eid="EZK 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 3:20" />“इह केरीन जेवी एगदो देरमी माणुह तान देरेमने काम सोड़ीन खाराब कामे केरने बाज जाय एने मी तान सोमोर रोकणार वोस्तु मेलु, ते तो मोर जाय, काहाकाय तु ताह नाह रूक्यो, केरीन तो तान पापाम फोसीन मोर जाय, एने जो देरमीन काम तो माणुह केऱ्यो एय, तो एर नाय केराय जाय, एने मी तुवाह तान खुनान जापापदार ठेरावुह। <verse eid="EZK 3:20" /><verse number="21" style="v" sid="EZK 3:21" />पुण केदी तु ता देरमी माणहाह पाप नाय केरनेन चेतावणी आपेह एने तो पाप नाह किरेत, तेवी तो जोरूर जिवतालो रेय, काहाकाय तो चेतावणी पोर द्यान देनो एने तु सोताह वोचाड़ लिहे।”<verse eid="EZK 3:21" /></para>
  <para style="s">यहेजकेल बोलने माय असफल</para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 3:22" />ताहरी बोगवानान ताकेत मार पोर आवी, एने तो माहु केयो, “उठीन चोवगाना माय जा एने ताहरी मी तार हिऱ्यो वातु केरूह।”<verse eid="EZK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 3:23" />केरीन मी उठनो एने बाहेर मोयदाना माय जात रिनो, मी दिख्यो काय बोगवानान उजोड़ ताहरी इतो; तो उजोड़ तोहलोच एतो, जोहलो मी कबार नेदीन मीरे दिखेल इतो, एने मी मुयान बोरहे जाय पुड़नो। <verse eid="EZK 3:23" /><verse number="24" style="v" sid="EZK 3:24" />पुण बोगवानान जिव मार माय आवो, एने माहु पाया पोर उबो केर दिनो, एने तो माहु केणे बाज गीयो, “जा एने सोताह तारा गेरा माय कोंड ले। <verse eid="EZK 3:24" /><verse number="25" style="v" sid="EZK 3:25" />एय माणहान सोरा, ता माणहे तुवाह राही केरीन बांद देती, काय तु बाहेर माणहा हिऱ्यो नाय जाय सिके। <verse eid="EZK 3:25" /><verse number="26" style="v" sid="EZK 3:26" />मी तारी जिबीह तारा तालवा हिऱ्यो लेटकाड़ देह काय तु ठावको रिहे एने ताह जुल नाय सिकहे, काहाकाय ता राड़कुट्या माणहे हेते। <verse eid="EZK 3:26" /><verse number="27" style="v" sid="EZK 3:27" />पुण जेवी मी तार हिऱ्यो वातु केरूह, तेवी मी तारो मुय उगाड़ देह एने तु ताह किज्ये, बोगवान यहोवान ज्य केणो हे, जो कुण होमेलतेय, तो होमली लेय, एने जो कुण निह होमेलतेय तो नाय होमली, काहाकाय ता राड़कुट केरनार गेराणान माणहे हेते।”<verse eid="EZK 3:27" /></para>
  <chapter eid="EZK 3" />
  <chapter number="4" style="c" sid="EZK 4" />
  <para style="s">यरूशलेमान कोंडाणेन देखाड़ाय जाणो</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 4:1" />बोगवान केयो, “एय माणहान सोरा, तु एक माटड्यान ईटड़ो विस, एने ताह तार सोमोर मेल, एने ता पोर यरूशलेम हेयरान चित्रो बाणाव। <verse eid="EZK 4:1" /><verse number="2" style="v" sid="EZK 4:2" />तेवी ताह तु कोंड, मतलब तान विरूद किल्लो बाणाव, ता पोर एक एक उतेरती बाणाव, एने तान विरूद सेनान पालथी उबो केर, तान चार चोमखेर लेड़ाईन आथ्यारे लागाड़। <verse eid="EZK 4:2" /><verse number="3" style="v" sid="EZK 4:3" />एने तु लोड़ान तावो लावीन ताह लोड़ान बितड़ो सोमजीन तारा ता हेयरान विचीम उबो केर; एने तारो मुय तान सोमोर केरीन ताह कोंड, इह केरीन तु ताह कोंड मिलज्ये, ज्य इस्राएलान गेराणान केरता निसाणी बोणी।”<verse eid="EZK 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 4:4" />“एवी तु जिवड़ी उगे करवट लेन लोट, एने इस्राएलान गेराणान पापान बार तार पोर उखेल ले, जोला दिह तु डाखरी उगे फिरहे, तोलाक दिह वोर तान पापान बार तुवाह वेठणे पोड़ी। <verse eid="EZK 4:4" /><verse number="5" style="v" sid="EZK 4:5" />तु इहीच केरीन इस्राएल गेराणान पापाह तीन होव नोव्वद दिह वोर विठहे, इह केरीन तु इस्राएलान गेराणान पापान बार वेठती रे। <verse eid="EZK 4:5" /><verse number="6" style="v" sid="EZK 4:6" />ज्या कामाह पुरो केरीन पासाण, तु पुशो डाखरी उगे चालीह दिह वोर केड़ी वोलीन लोट रिज्ये ज्यी टेम माय यहुदान पापाह चालीह वोरह्या वोर विठहे, एक दिह एक वोरह्यान रेय, मी तुवाह केथु काय यहुदा कोलाक वोरह्या वोर देन्ड माय रेय।”<verse eid="EZK 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 4:7" />तु यरूशलेमाह कोंडणेन केरता आथ पोसरावीन तारो मुय यरूशलेम हेयरान उगे केरीन तान विरूद जाणाव किरज्ये। <verse eid="EZK 4:7" /><verse number="8" style="v" sid="EZK 4:8" />मी तुवाह राही केरीन बांद देह, काय दिहरी उगे फिर नाय सिकहे, जाह वोर काय तु तारी कोंडाणेन दिह पुरा नाय केर लेय।<verse eid="EZK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 4:9" />“तु गोव, जुवार, मसुर, बाजरा, एने काठ्या गोव लेन, एक खिवड्या माय मेलीन तान रोटा रांद्या किरज्ये। जोलाक दिह तु खांदान बोरहे बिगेर केड़ी वोलीन लोट रिहे, मतलब तीन होव नव्वद दिह वोर ताह खाया किरज्ये। <verse eid="EZK 4:9" /><verse number="10" style="v" sid="EZK 4:10" />जो खाणो तु खाहे, ताह तु तोलीन खाज्ये मतलब दाड़ीन दुय होव पाचाह ग्रामान खाणो, तु दिह्याम निस्तो एक वार खाज्ये।<note caller="+" style="f"><char style="fr" closed="false">4:10 </char><char style="ft" closed="false">विह शेकेल</char></note> <verse eid="EZK 4:10" /><verse number="11" style="v" sid="EZK 4:11" />तु पाणी बी मापीन पिज्ये, मतलब दुय गिलास<note caller="+" style="f"><char style="fr" closed="false">4:11 </char><char style="ft" closed="false">कोमीत कोमी सोव होव लिटर</char></note> पाणी दिह्यान एक वार पिज्ये। <verse eid="EZK 4:11" /><verse number="12" style="v" sid="EZK 4:12" />जुवारीन एक रूटो रांदीन खाज्ये; ज्याह माणहान देखता रांदज्ये, एने माणहान आग्या पोर हिकज्ये।”<verse eid="EZK 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 4:13" />ओवतो बोगवान केयो, “इह केरीन इस्राएल वाला माणहे ता माणहान सोमोर एठालो खाणो खाती, जाहरी मी ताह बोलजोबरी पोचाडुह।”<verse eid="EZK 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 4:14" />तेवी मी केयो, “हाय, बोगवान यहोवा देख, मारो मोन केदी एठो नाह एनो, एने मी नाह आत्योच रेन एवी वोर तान मोती माय मुरेल एने मारायेल जेनवेरान माह खादो। एने नाह काल्ली बातीन खाराब माह मारा मुया माय केदी जायेल हे।”<verse eid="EZK 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 4:15" />तेवी बोगवान माहु केयो, “हाजो हे! मी तुवाह माणहान आग्यान बोदले गायीन साणा पोर रूटो हेकणेन पारवांगी आपथु।”<verse eid="EZK 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 4:16" />ओवतो बोगवान माहु केयो, “एय माणहान सोरा, मी यरूशलेमान खाणो पाणी बोंद किरन्यु हे, माणहे दाड़ीन दिह्यान खाणो चिन्ता केरीन खाती एने दाड़ीन पाणी दुखी एन पिती। <verse eid="EZK 4:16" /><verse number="17" style="v" sid="EZK 4:17" />काहाकाय ता माणहान केरता पुरतो खाणो एने पाणी नाय रेय। माणहे एका दिहराह देखीन बिती काहाकाय ता तान पापान केरता एका दिहराह खेतेम एताला देखती।”<verse eid="EZK 4:17" /></para>
  <chapter eid="EZK 4" />
  <chapter number="5" style="c" sid="EZK 5" />
  <para style="s">लेट्या बोड़ीन तान द्‍वारे यरूशलेमान खेतेम देखाड़ाय जाणो</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 5:1" />बोगवान केयो, “एय माणहान सोरा, एक दाराल्ली तालवार ले, एने तीह नावटान वोस्तरान गेत काम लागाड़ीन तारा मुंडान लेट्या एने दाड़ीन लेट्या बोड़ ले, तेवी तोलनेन ताकड़ा माय तोलीन तान तीन ईसा केर। <verse eid="EZK 5:1" /><verse number="2" style="v" sid="EZK 5:2" />जेवी हेयरान ओदेरनेन दिह पुरा एती, तेवी हेयरा माय लेट्यान एक ईसो हेयरा माय आक्ठाम हेलगाड़ दिज्ये, एने दुसरा ईसाह हेयरान चार चोमखेर तालवारी केरीन टुकड़ा टुकड़ा केर दिज्ये। वुचेल तिसरो ईसो वारा माय उड़ाव दिज्ये एने मी तालवार खेचीन तान पासाण चालाडुह। <verse eid="EZK 5:2" /><verse number="3" style="v" sid="EZK 5:3" />पुण थोड़ाक लेट्या काटीन ताह तारा डेगलान सेवड़े बांद लिज्ये। <verse eid="EZK 5:3" /><verse number="4" style="v" sid="EZK 5:4" />पुशो ता माय रेन थोड़ाक लेट्या लेन आक्‍ठान विचीम टाकज्ये काय ता आक्‍ठा माय हेलगी जाय; तेवी ताच माय रेन एक आस बोड़कीन इस्राएलान आखा गेराणा माय पोसरी जाय।”<verse eid="EZK 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 5:5" />तेवी मारो मालीक बोगवान माहु केयो, “तो इटड़ो यरूशलेम हे, मी ज्या यरूशलेम हेयराह दिहरा देसान विचीम मिलेल हे, ज्यी टेम माय इस्राएलान चार चोमखेर दिहरा देस हेते। <verse eid="EZK 5:5" /><verse number="6" style="v" sid="EZK 5:6" />तो मारा नेमान विरूद काम केरीन दिहरा देसाह रेन वोदार खाराब कामे किऱ्यो, एने मारी नेमान विरूद चार चोमखेर ने देसान माणहाह रेन वोदार बुराय किरेल हे; काहाकाय ता मारा नेम कोम जाण्या, एने मारी नेमा पोर नाह चालना। <verse eid="EZK 5:6" /><verse number="7" style="v" sid="EZK 5:7" />केरीन मारो मालीक बोगवानान ज्य केणो हे; तुमरा चार चोमखेर ने देसाह रेन वोदार दिंगो किरेल हेते, एने मारी विद्यु पोर चालते नाह, एने मारा नेमाह नाह मानते एने तुमरा चार चोमखेर ने देसान नेमान गेत बी नाह केऱ्या।” <verse eid="EZK 5:7" /><verse number="8" style="v" sid="EZK 5:8" />केरीन मारो मालीक बोगवान किथे, “केरीन मी बी तुमरी विरूद हे, मी तुमूह इह केरीन देन्ड आपु ता माय दिहरा माणहे बी देख सेकती। <verse eid="EZK 5:8" /><verse number="9" style="v" sid="EZK 5:9" />तुमरा खाराब कामान केरता, मी तुमरी विचीम तो केरूह, जो मी पेल केदी नाह किरेल सुतो एने नाय केदी आवता दिह्याम पुशो केदी ओहलो केरूह। <verse eid="EZK 5:9" /><verse number="10" style="v" sid="EZK 5:10" />केरीन तुमरीच विचीम आहख आबोख तान जिवाच ने सोराह खाती, एने सोरा जिवाच ने आईख आबाख खाय जाती, मी तुमूह देन्ड आपुह एने जा माणहे वोच जाती, ताह मी चार चोमखेर खोवली देह।”<verse eid="EZK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 5:11" />केरीन मालीक बोगवान गोसणा किरेह, मी मारा जीवणान सुगोण खाईन केथु, काहाकाय तुमू तुमऱ्यु सोब खाराब मुरत्युन एने खाराब कामा केरीन मारा चोखाला जागाह एठो किरेल हेते, मी सोता तुमूह होल टाकुह; मी तुमू पोर गीण नाय केरू एने नायते वोचाडु। <verse eid="EZK 5:11" /><verse number="12" style="v" sid="EZK 5:12" />तुमरा वोहणारा माय रेन तीनुम रेन एक ईसान माणहे हेयरा माय दुखाऱ्या एने बुखल्या मोरती एने तुमरा माणहान तीन ईसा माणहाह मी तालवार काड़ीन तान पासाण पोडुह।<verse eid="EZK 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 5:13" />“तेवी मारो राग ओलाय, एने तान विरूद मारो हेलगणो ता पोर पुरो बोड़कावीन ठावको रेह; एने जेवी मारो राग ओलाय जाय, तेवी ता जाण जाती काय बोगवान रागाईन ज्य कियेल हे। <verse eid="EZK 5:13" /><verse number="14" style="v" sid="EZK 5:14" />मी तुवाह तारा चार चोमखेर ने देसान विचीम, सोब आवणे जाणारान देखताच उजाडुह, एने तारी चिहटा केरावुह।”<verse eid="EZK 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 5:15" />“जेवी मी तुमरी पोर राग केरूह एने तुमूह देन्ड आपुह, तेवी तुमरा चार चोमखेर ने माणहे तुमरो मोजाक उड़ावती, काहाकाय मी बोगवान तुमूह कियेल इतो, काय मी काय केरूह। <verse eid="EZK 5:15" /><verse number="16" style="v" sid="EZK 5:16" />ज्य ती टेम माय एय, जेवी मी ता माणहाह खेतेम केरनेन केरता तुमू पोर कालान मारनारे बेलखा विंदीन, तुमरी विचीम मोंगाय वोदाडुह, एने तारा रोटान आदार सिटो केर देह। <verse eid="EZK 5:16" /><verse number="17" style="v" sid="EZK 5:17" />मी तुमरी विचीम जेंगली जेनवारे एने काल मोकलुह। ता तारा सोराह खाय जाती। महामारी एने खुनान सावला तारा बायणा पोर लागता सेरेकती, एय यरूशलेम माय रेणारे, मी तुमरो मालीक, तुमू पोर दुसमोनान तालवार चालाडुह।” मी बोगवान ज्य कियेल हे।<verse eid="EZK 5:17" /></para>
  <chapter eid="EZK 5" />
  <chapter number="6" style="c" sid="EZK 6" />
  <para style="s">बोगवानान उगे रेन मुरती पुजान चिहटा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 6:1" />पोशो बोगवानान ज्य वचन मार फाय पोचनो। <verse eid="EZK 6:1" /><verse number="2" style="v" sid="EZK 6:2" />“एय माणहान सोरा, तु तारो मुय इस्राएलान बोयड़ा उगे केरीन तान विरूद जाणाव केर, <verse eid="EZK 6:2" /><verse number="3" style="v" sid="EZK 6:3" />एने के, एय इस्राएलान बोयड़ा, मालीक बोगवानान वचन हुमलो! मालीक बोगवान बोयड़ाह एने बोयड्युह एने खोदरा एने चारान चोवगानाह इह किथे, दिखो, मी तुमू पोर तालवार चालाडुह, एने तुमरा पुजान उचाला जागाह खेतेम केरूह। <verse eid="EZK 6:3" /><verse number="4" style="v" sid="EZK 6:4" />तुमरी वेद्यु उजड़ी जाती एने तुमरा दिह्यान मुरती तोड़ाय जाती; एने मी तुमरे माय रेन मारेल ताह मुरतान ओंगाण टाक देह। <verse eid="EZK 6:4" /><verse number="5" style="v" sid="EZK 6:5" />मी इस्राएली माणहान देड़ाह तान मुरतान ओंगाण मेलुह, एने तान आड़ाह तुमरी वेद्युन आहने पाहने वेर देह। <verse eid="EZK 6:5" /><verse number="6" style="v" sid="EZK 6:6" />तुमरा जोला बाणायेल हियोर हेते, ता सोब उजाड़ एय जाती, तुमरी वेद्यु उजेड़ती, एने ओदाराय जाती, तुमरी मुरत्यु जात रेती एने तुमरा दिह्यान मुरता काटाय जाती, एने आखी कारागिरी मिटाड़ाय जाय। <verse eid="EZK 6:6" /><verse number="7" style="v" sid="EZK 6:7" />तुमरी विचीम मारायेल तान देड़ान डिगे लाग रेती, एने तुमू जाण जाहो काय मी बोगवान हे। <verse eid="EZK 6:7" /><verse number="8" style="v" sid="EZK 6:8" />तीबी मी थोड़ाक जाणाह वोचाड़ मेलुह। केरीन जेवी तुमू देसा देसाम खोवलाय जाहो, तेवी जाती जातीन विचीम तुमरा थोड़ाक माणहे तालवारी केरीन वोच जाती। <verse eid="EZK 6:8" /><verse number="9" style="v" sid="EZK 6:9" />ता वुचेल माणहे, त्यु जात्युन विचीम, ज्यु माय ता देराय रेती, एने माहु एर केरती एने ज्य बी काय आमरो सिनाल्यो मोन बोगवाना हेऱ्यो रेन किहीक सेटो एय जायेल हे, सिनाल्या माणहान गेत आमरी देशा आमरा डोला मुरता पोर किहीक लाग रेनाह, जा माय बोगवानान मोन टुटेल हे। इह केरीन त्यु खाराबीन केरता, जा ता खाराब कामे किरेल हेते, ता तान नेजरी माय खाराब गेणाती। <verse eid="EZK 6:9" /><verse number="10" style="v" sid="EZK 6:10" />तेवी ता जाण लेती मी बोगवान हे, एने तान आखी नुकसानी केरनेन मी ज्य कियेल हे, ताह वायबार नाह केयो।”<verse eid="EZK 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 6:11" />मालीक बोगवान ज्य किथे; काय तारो आथ फोकड़ीन एने तारो पाय जेटकीन के, इस्राएलान गेराणान आखा खाराब कामा पोर हाय, हाय, काहाकाय ता तालवार, बुख, एने बेमारी माय खेतेम एय जाती। <verse eid="EZK 6:11" /><verse number="12" style="v" sid="EZK 6:12" />जा सेटा एती ता बेमारी माय मोरती, एने जा आहने रेती ता तालवार केरीन माराय जाती; एने जा वोचीन हेयरा माय रेतालान कोंडाय जाती, ता बुखल्या मोरती। इह केरीन मी मारो राग ता पोर हास केरीन उतारूह। <verse eid="EZK 6:12" /><verse number="13" style="v" sid="EZK 6:13" />जेवी आख्‍यु उचाल्यु बोयड्यु एने बोयड़ान आख्‍यु चुट्यु पोर एने आखा निल्ला जाड़ान बुंदे एने आखा जाड़ला वांज नावान मोटला जाड़ान सावला माय, जाहरी जाहरी तान सोब मुरताह गेंदाण्यो तेल चेड़ावतेह, ताहरी तान मारायेल माणहे तान वेद्युन आहने पाहने तान मुरतान विचीम पोड़ रेती; तेवी तुमू जाण जाहो काय मी बोगवान हे। <verse eid="EZK 6:13" /><verse number="14" style="v" sid="EZK 6:14" />मी मारो आथ तान विरूद ओंगाण केरीन ता देसान आखा गेरा हेऱ्योच जेंगलाम रेन रिबला हियोर वोर उजाडुच उजाड़ केर देह। तेवी ता जाण लेती काय मी बोगवान हे।<verse eid="EZK 6:14" /></para>
  <chapter eid="EZK 6" />
  <chapter number="7" style="c" sid="EZK 7" />
  <para style="s">इस्राएलान देन्ड आहने हे</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 7:1" />पोशो बोगवानान ज्य वचन मार फाय पोचनो, <verse eid="EZK 7:1" /><verse number="2" style="v" sid="EZK 7:2" />“एय माणहान सोरा, मालीक बोगवान इस्राएलान बुईन बाराम इह किथे; काय सेवोट आवो; चार कोपरा हेऱ्या देसान सेवोट आव लागेल हे।”<verse eid="EZK 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 7:3" />“तारो सेवोट बी आव लागेल हे, एने मी मारो राग तार पोर बोड़कावीन तारी चाल चलन ने गेत तुवाह देन्ड आपु; एने आखा खाराब कामान फोल तुवाह आपुह। <verse eid="EZK 7:3" /><verse number="4" style="v" sid="EZK 7:4" />मी तार पोर गिण नाय केरू; मी तुवाह नाय सोडु, मी जोरूर तारा चाल चलनान एने तारी विचीम खाराब कामान तार हिऱ्यो बुदलो लेह, तेवी तु जाण जाहे काय मी बोगवान हे।”<verse eid="EZK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 7:5" />मारो मालीक बोगवान ज्यी वातु कियेल हे, एकान पासाण एक पिढ़ा आवती। <verse eid="EZK 7:5" /><verse number="6" style="v" sid="EZK 7:6" />सेवोट आवणे बाज रिनोह एने जुलूम उतवाल्यो आव लागी। <verse eid="EZK 7:6" /><verse number="7" style="v" sid="EZK 7:7" />एय इस्राएल वाला माणहे, काय तुमू सेटा नाह होमलेल सोता, दुसमोन आवणे बाज रिनोह, ता देन्‍डान टेम उतवाल्योह आवणे बाज रिनोह! दुसमोनान राग बोयड़ा पोर वोदार वोदार वोदते जाणे बाज रिनोह। <verse eid="EZK 7:7" /><verse number="8" style="v" sid="EZK 7:8" />मी चालोच देखाड़ देह काय मी कोलोक रागा माय हे, मी तुमरी विरूद मारा पुरा रागाह, मी ता खाराब कामान केरता देन्ड आपुह जा तुमू किरेल हेते, मी ता सोब बिवाड़नार कामान तुमूह बुगताण केरावुह जा तुमू किरेल हेते। <verse eid="EZK 7:8" /><verse number="9" style="v" sid="EZK 7:9" />मी तुमू पोर जारीक बी गिण नाय केरू मी तुमरी केरता पाचतावो नाय केरू, मी तुमूह खाराब कामान केरता देन्ड आपणे बाज रिनोह। तुमरा खाराब कामान बुदलो लेह, तेवी तुमू जाणहो काय ज्यो मी बोगवान हे, जो तुमू देन्ड बी आपथु।<verse eid="EZK 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 7:10" />दिखो, ता दिह्याह दिखो, तो आवेह! चेक्रो फिर चुकनो, अन्याय ने डेंगी फुल गियी, एने तारी मोठाय वोद जायेल हे। <verse eid="EZK 7:10" /><verse number="11" style="v" sid="EZK 7:11" />सेताव वोदते वोदते पापान देन्ड बोण गीयो; ता माय रेन कुण बी नाय वोची, एने नाय तान बिड़ बाड़, नाय मालदेना माय रेन काय बी रेय; एने नाय ता माय रेन कुणीन केरता रेड़नो होमलाय। <verse eid="EZK 7:11" /><verse number="12" style="v" sid="EZK 7:12" />टेम आव लागो, दिह आहने आव लागेल हे; नाय ते वेचातो लेणार मोज केरी एने नाय वेचणार नाराज एय, काहाकाय तान आखी बिड़ पोर राग बोड़की उठेल हे। <verse eid="EZK 7:12" /><verse number="13" style="v" sid="EZK 7:13" />ता जीवताला रेती, तीबी वेचणार काल्ली बी वोस्तुन जागे केदी नाय फिरीन आव सेकी; काहाकाय रागान ज्यी वात देसान आखी बिड़ी पोर गेटी, कुण नाय फिरीन आवी; काल्लो बी माणुह जो पापा माय जीवतालो रिथे, ताकेत नाय देर सिके।<verse eid="EZK 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 7:14" />ता बिरो फुक्या एने आखो काय तियार केर देना; पुण लेड़ाय माय कुण नाह जात काहाकाय देसान आखी बिड़ी पोर मारो राग बोड़केल हे।<verse eid="EZK 7:14" /></para>
  <para style="s">इस्राएलान पापान देन्ड</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 7:15" />बाहेर तालवार एने माय मोंगाय एने बेमारी हे; जो मोयदाना माय रेय, तो तालवारी केरीन मोरी एने जो हेयरा माय रेय, तो बुख एने बेमारी माय माराय जाय। <verse eid="EZK 7:15" /><verse number="16" style="v" sid="EZK 7:16" />ता माय रेन जो वोच जाय, ता वोचती ते खोरा पुण जिव जिवान पापा माय फासाय खोयरा माय रेणारे पेरवान गेत बोयड़ा पोर रेड़ती रेती। <verse eid="EZK 7:16" /><verse number="17" style="v" sid="EZK 7:17" />आखान आथ डिल्ला एने मांडा जुलूम कमजोर एय जाती। <verse eid="EZK 7:17" /><verse number="18" style="v" sid="EZK 7:18" />ता तान कोमरा माय गोंटान फाड़का पेरती, एने ता बिन कापणे बाज जाती, आखान मुय हुक जाती, एने सोब मुंडे वोल जाती। <verse eid="EZK 7:18" /><verse number="19" style="v" sid="EZK 7:19" />ता तान चांदी सेड़की पोर टाक देती, एने तान होनो एठी वोस्तु बोण जाय; बोगवानान रागान दिह तान होनो चांदी ताह वोचाड़ नाय सेकी, नाय ता पोर जिव राजी रेय, नाय तान पेटे बोराती। काहाकाय ता तान गुनान ठोकरान कारेण ईयेल हे। <verse eid="EZK 7:19" /><verse number="20" style="v" sid="EZK 7:20" />ता तान हाजाला गेयणा पोर मोठाय किरेल हेते, एने तान वापेर खाराब मुरता बाणावणेन केरता किरेल हेते, ता केरीन ता विण कामान मुरत्यु बाणायेल हेते; केरीन मी तान केरता एठी वोस्तु बाणाव देह। <verse eid="EZK 7:20" /><verse number="21" style="v" sid="EZK 7:21" />मी तान होनो चांदी पाराया देसावाला माणहाह लुट लेणेन केरता आपुह, आखी देरतीन माणहे लुट लेती एने होनो चांदीन मुरत्युह एठी केर देती। <verse eid="EZK 7:21" /><verse number="22" style="v" sid="EZK 7:22" />मी तान उगे रेन मारो मुय फिराव लेह, एने लुटारा मारा चोखाला जागाह एठो केरती, ता माणहे ताम रिगती एने एठो केर टाकती।<verse eid="EZK 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 7:23" />ता ताह ठाल्लो केर देती, आखो देस एने यरूशलेम हियोर लुयाल्लो एने देंगान कामा माय बोराय जाईल हे। <verse eid="EZK 7:23" /><verse number="24" style="v" sid="EZK 7:24" />मी दिहरा देसान खाराब माणहाह लावुह, जा तान गेरान मालीक बोण जाती; एने ताकेत वालान मोठाय तोड़ देह एने तान चोखाला जागा एठाला केराय जाती। <verse eid="EZK 7:24" /><verse number="25" style="v" sid="EZK 7:25" />दुख पिढ़ा आवणे बुखेत, तुमूह हुक जुड़ीन बी हुक नाय सापड़ी।<verse eid="EZK 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EZK 7:26" />पिढ़ा पोर पिढ़ा आवती उड़ताली चेरचा पोर चेरचा होमलाय जाय; एने माणहे जाणकारा फाय देरसेनान वातु फुसती, पुण चाकऱ्या फाय नेम, एने डायडाया फाय रेन सेला आपणेन ताकेत नाय रेय। <verse eid="EZK 7:26" /><verse number="27" style="v" sid="EZK 7:27" />राजा ते दुखा माय रेती, एने मुखी माणहे नाराज ने फाड़का पेरती, एने देसान माणहान आथ डिल्ला पोड़ती, मी तान चाल चलनान गेत ता हिऱ्यो वेवार केरूह, एने तान कामाईन गेत ताह देन्ड आपुह; तेवी ता जाण लेती मी बोगवान हे।<verse eid="EZK 7:27" /></para>
  <chapter eid="EZK 7" />
  <chapter number="8" style="c" sid="EZK 8" />
  <para style="ms">बोगवानान बाराम यहेजकेलान दुसरो देरसेन</para>
  <para style="r">(<ref loc="EZK 1:10-22">यहेजकेल 1:10-22</ref>)</para>
  <para style="s">इस्राएलान मुरती पुजा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 8:1" />पुशो सोव्वा वोरह्यान सोव्वा मोयनान पाचवे हिह्याह जेवी मी मारा गेरा माय बोह रियेल इतो, एने यहुदिन डायडाया मार सामने बोह रियेल एता, तेवी मालीक बोगवानान सेक्ती मार पोर आवी। <verse eid="EZK 8:1" /><verse number="2" style="v" sid="EZK 8:2" /><note caller="+" style="x"><char style="xo" closed="false">8:2 </char><char style="xt" closed="false"><ref loc="EZK 1:27">यहेजकेल 1:27</ref></char></note> एने मी दिख्यो काय आक्‍ठान गेत वेह देखातालो; तान कोमरान नेड़ली उगे आक्‍ठो हे, एने कोमरान उपेरल्यो बाग चोमेकतालो एने पितलाह चोमेकतालो हारको काह देखातालो <verse eid="EZK 8:2" /><verse number="3" style="v" sid="EZK 8:3" />तो तान आथा सारकी काह वोस्तु ओंगाण केरीन मारा मुंडान लेट्याह देर लेदो, तेवी बोगवानान जिव माहु देरती एने जुगान विचीम विस लेदो एने बोगवानान देरसेन माय माहु यरूशलेम मायवाली खोलीन उत्तर वाला बायणाम रिगणेन जागे लेन गीयो, जाहरी एतखाय केरावणार मुरती एती। <verse eid="EZK 8:3" /><verse number="4" style="v" sid="EZK 8:4" /><note caller="+" style="x"><char style="xo" closed="false">8:4 </char><char style="xt" closed="false"><ref loc="EZK 1:28">यहेजकेल 1:28</ref></char></note> पुण इस्राएलान बोगवानान उजोड़ ताहरी इतो, तो उजालो तोहलोच देखातालो जोहलो देरसेन मी मोयदानान मीरे कबार नेदीन जागे दिखेल इतो।<verse eid="EZK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 8:5" />तेवी बोगवान माहु केयो, “एय माणहान सोरा, उत्तर दिशा उगे देख।” तेवी मी निजेर टाक्‍यो, एने वेदीन बायणान उत्तेर उगे रिगणेन जागा माय मी एतखाय पायदा केरनार ती मुरतीह दिख्यो।<verse eid="EZK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 8:6" />तेवी बोगवान माहु केयो, “एय माणहान सोरा तु काय देखणे बाज रिनोह काय ज्या माणहे काय केरने बाज रेनाह? इस्राएलान गेराणो काय मोटला खाराब काम न्याहरू किरेह, काय मी मारा चोखाला जागाम रेन सिटो एय जाव; पुण तु ज्याह रेन बी वोदार खाराब काम दिखहे।”<verse eid="EZK 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 8:7" />तेवी तो माहु बायणान रिगणेन जागा पोर लेन आवो, ताहरी मी दिख्यो काय बितड़ा माय एक डुसो इतो। <verse eid="EZK 8:7" /><verse number="8" style="v" sid="EZK 8:8" />तेवी बोगवान माहु केयो, “एय माणहान सोरा! ता बितड़ान डोसा माय रिग।” केरीन मी बितड़ान डोसाम लागतो गीयो एने ताहरी मी एक बायणो दिख्यो। <verse eid="EZK 8:8" /><verse number="9" style="v" sid="EZK 8:9" />तेवी बोगवान माहु केयो, “माय रिग एने ता जा, खाराब कामे न्याहरी केरने बाज रेनाह, ताह देख।” <verse eid="EZK 8:9" /><verse number="10" style="v" sid="EZK 8:10" />केरीन मी माय गीयो, एने दिख्यो काय बितड़ा पोर आखी उखीर आखी बातीन लोलनारे जेन्तु एने एठाला जेनवारे एने इस्राएलान आख्‍यु मुरत्युन चित्रा बाणायेल हेते। <verse eid="EZK 8:10" /><verse number="11" style="v" sid="EZK 8:11" />एने इस्राएलान गेराणान डायडाया माय रेन सेत्तेर एदमी जान विचीम शापानान सुरो याजन्या बी हे, ता चित्रान सामने उबरिनोह, एने आखा एदमी आप आपणा आथा माय दुणी लेय रेनाह; एने दुणीन दुवाड़ो उपेर उड़ने बाज रिनोह। <verse eid="EZK 8:11" /><verse number="12" style="v" sid="EZK 8:12" />तेवी बोगवान माहु केयो, “एय माणहान सोरा, तु काय दिखेल हे काय इस्राएलान डायडाया आंदारा माय आथा केरीन बाणायेल चित्रान जागे काय केरने बाज रेनाह? ता केतेह, ‘बोगवान आमुह नाह दिखेत, बोगवान आपणा देसाह सोड़ दियेल हे।’ ”<verse eid="EZK 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 8:13" />पुशो तो माहु केयो, “तु ज्याह रेन बी वोदार खाराब काम दिखहे जा ता केरतेह।” <verse eid="EZK 8:13" /><verse number="14" style="v" sid="EZK 8:14" />तेवी तो माहु बोगवानान मोंदिरान ता फाटेक ने जागे लेन गीयो, जी उत्तेर उगे एती, एने ताहरी बायकु बोहीन तम्मुज<note caller="+" style="f"><char style="fr" closed="false">8:14 </char><char style="ft" closed="false">तम्मुज देवता</char></note> देवतान केरता रेड़ने बाज रियेल एत्यु।<verse eid="EZK 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 8:15" />तेवी तो माहु केयो, “एय माणहान सोरा, काय तु ज्य दिखेल हे? पुशो तु न्याह रेन बी वोदार खाराब काम दिखहे।” <verse eid="EZK 8:15" /><verse number="16" style="v" sid="EZK 8:16" />तेवी तो माहु बोगवानान मोंदिरान मायवाली खोली माय लेन गीयो; एने ताहरी बोगवानान मोंदिरान बायणान जागे ताहरी मी पोचीह एदमी दिख्यो, जा बायणान सोमोर मांडवा एने वेदीन विचीम उब रियेल एता। तान डिल बोगवानान मोंदिरान उगे एतो, एने ता पुर्व दिशा माय दिह्यान पुजा केरने बाज रियेल एता।<verse eid="EZK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 8:17" />तेवी तो माहु केयो, एय माणहान सोरा, तु ज्य काय दिख्यो? काय यहुदान गेराणान केरता खाराब कामे केरनो, जो ता न्याहरी केरतेह आतीच वात हे? ता तान देसाह देंगा माय बोर देना, एने पोशा न्याहरी आवीन मानो ता मुय फुगाड़ीन राग लागाड़तेह, पुण ता डालीह तान नाकान ओंगाण लेय रेतेह। <verse eid="EZK 8:17" /><verse number="18" style="v" sid="EZK 8:18" />केरीन मी ता पोर राग केरूह; मी ता पोर गिण नाय केरू ता मारी नेजरी माय रेन लिक नाय सेकती, ता माहु मोठेस आयेड़ते तीबी मी तान विन्ता नाय होमलु।<verse eid="EZK 8:18" /></para>
  <chapter eid="EZK 8" />
  <chapter number="9" style="c" sid="EZK 9" />
  <para style="s">यरूशलेमाह देन्ड आपणो</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 9:1" />तो मोठेस आवाजा माय केयो, “हुमलो, ताह मार फाय लावो, जाह हेयरान माणहे न्यायनिवाड़ो केरनेन केरता बाणायेल हेते, एने ता माय रेन आखान आथाम आथ्यारे लेन मार फाय आहने आवो।” <verse eid="EZK 9:1" /><verse number="2" style="v" sid="EZK 9:2" />एने मी दिख्यो काय उत्तर उगे उगेड़नार उपेरल्या बायणान दिशा उगे सोव एदमी आवणे बाज रेनाह, एने ता माय रेन एक एका फाय दाराल्या आथ्यारे हेते, ता माय रेन एक माणुह हुवाल्ला फाड़का पेर रियेल इतो, जान एक उगे लेखणेन वोस्तु एक जोलनो एतो, ता माय आवा एने पितलान वेदीन आहने उबरेय गीया।<verse eid="EZK 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 9:3" />एने इस्राएलान बोगवानान बोड़ाय फाकावाला जीवा पोर रेन, जा पोर तो रेतालो, मोंदिरान पावत्री पोर आव लागो, तेवी बोगवान हुवाल्ला फाड़का पिरेल ता माणहाह आयड्यो, जान कोमराम लेखणेन वोस्तुन जोलनो एतो। <verse eid="EZK 9:3" /><verse number="4" style="v" sid="EZK 9:4" /><note caller="+" style="x"><char style="xo" closed="false">9:4 </char><char style="xt" closed="false"><ref loc="REV 14:1">प्रकाशितवाक्य 14:1</ref>; <ref loc="REV 9:4">9:4</ref></char></note> बोगवान ताह केयो, पुरा यरूशलेम हेयरा माय जावो एने ता सोबा निंडाला पोर एक निसाणी लागाड़ो, जा हेयरा माय एणार खाराब कामा देखीन नाराज हेते एने दुख माणावतेह। <verse eid="EZK 9:4" /><verse number="5" style="v" sid="EZK 9:5" />तेवी मी बोगवानाह दिहरा माणहाह केतालो होमल्यो, “तान पासाण पासाण पुरा हेयरा माय जावो; एने ता पोर गिण मा किरहो। एक माणुह बी तुमरी नेजरी माय रेन वोचीन नाहणे नाय जुवे। <verse eid="EZK 9:5" /><verse number="6" style="v" sid="EZK 9:6" />डावाला, जुवान सोरा, एने जुवान सोऱ्यु, आहख एने सोरा आखाह मार टाकज्यो, पुण काल्ला ओहला माणहाह मा सापेलहो, जान निंडाला पोर निसाणी लागानी एय, मारा चोखाले जागे रेन सुरू किरज्‍यो।” तेवी ता डावाला माणहा पोर रेन सुरू केऱ्या, जा गेरान सामने एता। <verse eid="EZK 9:6" /><verse number="7" style="v" sid="EZK 9:7" />तेवी तो केयो, “गेराह एठो केर दिज्यो, एने माराय जायेल माणहान देड़ा केरीन खोलीह बोर दिज्यो, जावो!” तेवी ता बाहेर निकेलना एने हेयरा माय पुरा माणहाह मारने बाज गीया।<verse eid="EZK 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 9:8" />जेवी ता मारने बाज रियेल एता एने मी एखालो रेय गीयो, तेवी मी मुयान बोरहे पुड़नो एने आयड़ीन केयो, “एय मालीक यहोवा, हाय! काय तु यरूशलेमा पोर तारा रागान आक्‍ठो रोचवीन काय इस्राएलान वुचेल वोस बी खेतेम केर दिहे?”<verse eid="EZK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 9:9" />तेवी तो माहु केयो, “इस्राएल एने यहुदान गेराणान पाप जुलूम होवटा हेते, ओलाक वोर काय देस खुना माय एने हियोर पापा माय बोराय जायेल हे; काहाकाय ता केतेह काय बोगवान देरतीह सोड़ दियेल हे एने बोगवान कायच नाह दिखेत। <verse eid="EZK 9:9" /><verse number="10" style="v" sid="EZK 9:10" />केरीन मी ता पोर गीण नाय केरू नाहते ताह नाय सोडु, पुण मी तान कामाह ताच पोर टाक देह।”<verse eid="EZK 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 9:11" />तेवी तो माणुह, जो हुवाल्ला फाड़का पेर रियेल एने तान कोमराम लेखणेन वोस्तु बांद रियेल एतो, तो फिरीन आवीन केयो, “तु जीह केरीन कियेल इतो, मी तिहेच केरीन केर दिनो।”<verse eid="EZK 9:11" /></para>
  <chapter eid="EZK 9" />
  <chapter number="10" style="c" sid="EZK 10" />
  <para style="s">बोगवानान बोड़ाय यरूशलेम मोंदिर माय रेन निकेल जाणो</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 10:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:1 </char>
      <char style="xt" closed="false">
        <ref loc="REV 4:2">प्रकाशितवाक्य 4:2</ref>; <ref loc="EZK 1:26">यहेजकेल 1:26</ref></char>
    </note> मी दिख्यो काय फाकावाला जीवान मुंडा पोर जो जुगमोन्डोल हे, एने ज्या जुगमोन्डोला माय एक निल्ला रेंगान मोंगालो देगड़ान राजगादिन गेत काह देखातालो। <verse eid="EZK 10:1" /><verse number="2" style="v" sid="EZK 10:2" /><note caller="+" style="x"><char style="xo" closed="false">10:2 </char><char style="xt" closed="false"><ref loc="REV 8:5">प्रकाशितवाक्य 8:5</ref></char></note> जो माणुह हुवाल्ला फाड़का पेर रियेल एतो, ताह बोगवान केयो, “फाकावाला जीवान नेड़ा चाकारा फिरतेह, तान विचीम जा, एने कुरबोन, विचीम रेन दुयू मुठी माय हेलेगताला इंगाल विस लाव, एने ताह यरूशलेम हेयरा पोर खोवली दे।”</para>
  <para style="p" vid="EZK 10:2">तो मार डोलान सामने तान विचीम गीयो। <verse eid="EZK 10:2" /><verse number="3" style="v" sid="EZK 10:3" />जेवी तो माणुह माय गीयो, तेवी फाकावाला जीवे मोंदिरान डाखरी उगे उबरियेल एता, एने माय वाली खोली एक वादला माय बोराय गियी। <verse eid="EZK 10:3" /><verse number="4" style="v" sid="EZK 10:4" />तुलेचबुखे बोगवानान उजालो करूब ने उपेर रेन गेरान ओटला पोर आव लागो, गेर वादला माय बोराय रियेल एतो एने खोली बोगवानान बोड़ाय माय बोराय रियेल एती। <verse eid="EZK 10:4" /><verse number="5" style="v" sid="EZK 10:5" />फाकावाला जीवान फाकान आवाज बाहेरली खोलीम वोर ओहलो होमलातालो, काय जोहलो ताकेतवाला बोगवानान आवाजान गेत होमलाह, जेवी ता बोलताला।<verse eid="EZK 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 10:6" />जेवी बोगवान हुवाल्ला फाड़का पेर रियेल माणहाह उकुम आप्यो, “फाकावाला जीवान नेड़ा फिरनार चाकारान विचीम रेन आक्‍ठो लेय ले,” तो माणुह गीयो एने एक चाकरान उगे उबरेय गीयो। <verse eid="EZK 10:6" /><verse number="7" style="v" sid="EZK 10:7" />तेवी फाकावाला जीवा माय रेन एक तान विचीम वाली आक्‍ठीन उगे तान आथ ओंगाण केरीन ता माय रेन थोड़ीक आक्ठी लेन हुवाल्ला फाड़का पिरेल माणहान आथाम मेल दिनो, तो ताह लेन बाहेर जात रिनो।<verse eid="EZK 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 10:8" />फाकावाला जीवान फाका बुंदे माणहान आथा हारको काह देखातालो। <verse eid="EZK 10:8" /><verse number="9" style="v" sid="EZK 10:9" />मी दिख्यो फाकावाला जीवान एक उगे चार चाकारा, एक एक फाकावाला जीवान उगे एकेक चाकारा हेते; ता चाकारान वेह मोंगाला चोमेकताला देगड़ान गेत चोमकिण्यो इतो। <verse eid="EZK 10:9" /><verse number="10" style="v" sid="EZK 10:10" />ता चार चाकारान आकार एक हारको एतो; एने ओहलो लागतालो, काय ता एका दिहरा माय होमाय रेना एती। <verse eid="EZK 10:10" /><verse number="11" style="v" sid="EZK 10:11" /><note caller="+" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="REV 4:8">प्रकाशितवाक्य 4:8</ref></char></note> जेवी ता ओंगाण जाताला, ते चारो दिशा माय रेन ती दिशा उगे जाताला, जी उगे फाकावाला जीवान मुय रेतालो; जेवी करूब चालताला, ते चाकारा बिगेर इही तिहे वोलेल तिच दिशा उगे जाताला, करूब बिगेर इही तिहे वोलेल तिच दिशा माय जाताला, जी उगे तान मुय रेतालो। <verse eid="EZK 10:11" /><verse number="12" style="v" sid="EZK 10:12" />मी दिख्यो काय फाकावाला जीवान आखो डिला माय एने फाका माय एने आहने वाला चाकारा माय बी आखी उगे डोलाच डोला हेते। <verse eid="EZK 10:12" /><verse number="13" style="v" sid="EZK 10:13" />मी हुमल्यो काय ता चाकाराह फिरनारे चाकारा केवाय गीया। <verse eid="EZK 10:13" /><verse number="14" style="v" sid="EZK 10:14" /><note caller="+" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="REV 4:7">प्रकाशितवाक्य 4:7</ref>; <ref loc="EZK 1:10">यहेजकेल 1:10</ref></char></note> एक एक फाकावाला जीवान चार चार मुये एता, एक मुय फाकावाला हारको, दुसरो माणहा हारको, तीसरो सिंहा हारको एने चौथो मुय गुवड़ान हारको एतो।<verse eid="EZK 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 10:15" />तेवी करूब उपेर उखला ताला, ता ताच जीवताला जीव एता, जाह मी कबार नेदीन मीरे दिखेल इतो। <verse eid="EZK 10:15" /><verse number="16" style="v" sid="EZK 10:16" />जेवी फाकावाला जीव चालताला, ते तान उखेरल्या चाकारा बी चालताला; एने जेवी करूब बुई पोर रेन उपेर उड़नेन केरता तान फाके पोसरावताला, तेवी चाकारा तान उगे जाणे नाह वोलताला। <verse eid="EZK 10:16" /><verse number="17" style="v" sid="EZK 10:17" />जेवी ता उबरेताला तेवी ता बी उबरेय जाताला; एने जेवी ता उठताला तेवी ज्या बी ता हेऱ्या उठताला; काहाकाय जीवदारीन जिव ज्याच माय रेताली।<verse eid="EZK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 10:18" />तेवी बोगवानान उजालो गेरान ओटली पोर रेन जात रिनो एने फाकावाला जीवा पोर थोब गीयो। <verse eid="EZK 10:18" /><verse number="19" style="v" sid="EZK 10:19" />तेवी फाकावाला जीव तान फाके पोसराया एने हवा माय उड़ गीया, मी ताह मोंदिराह सोड़ताला दिख्यो! चाकारा बी ता हेऱ्या गीया, तेवी बोगवानान मोंदिरान दिह उगता बायणा पोर थोबना, इस्राएलान बोगवानान उजालो ता पोर एतो।<verse eid="EZK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 10:20" />ज्या ताच जीवताला जीव एता, जाह मी कबार नेदीन जागे इस्राएलान बोगवानान निड़ो दिखेल इतो, एने मी सोमजी गीयो काय ता हेरोग दुत एता। <verse eid="EZK 10:20" /><verse number="21" style="v" sid="EZK 10:21" />एक एकान चार चार मुये एने चार चार फाके एता एने तान फाका बुंदे माणहान आथा हारको काह देखातालो। <verse eid="EZK 10:21" /><verse number="22" style="v" sid="EZK 10:22" />तान मुयान वेह तोहलाच एता, जोहला मी कबार नेदीन जागे दिखेल इतो, ता हुतरा जिव जिवान तान आखा डिले तोहलाच एता, आखा तान जिव जिवान हुतराच चालताला।<verse eid="EZK 10:22" /></para>
  <chapter eid="EZK 10" />
  <chapter number="11" style="c" sid="EZK 11" />
  <para style="s">यरूशलेम ने चिहटा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 11:1" />तेवी जीव माहु विसीन बोगवानान मोंदिरान ता बायणा पोर लेन आवो, जान मुय पुर्व दिशान उगे हे, मी दिख्यो काय ताहरी बायणाम रिगणेन जागा पोर पोचीह माणहे एता, तान विचीम मी अज्जूरान सोरा यात्सानिया एने बेनायान सोरा पेलायाह दिख्यो, जा पोरजान मुखी एता। <verse eid="EZK 11:1" /><verse number="2" style="v" sid="EZK 11:2" />तेवी बोगवान माहु केयो, “एय माणहान सोरा, ज्या ता माणहे हेते, जा हेयरा माय खाराब काम केरनेन केरता नोवाली नोवाली योजना सोचतेह, एने ज्या माणहाह गेलेत सेला देतेह। <verse eid="EZK 11:2" /><verse number="3" style="v" sid="EZK 11:3" />ज्या माणहे केतेह, ‘गेरे बाणावणेन टेम आहने नाय मिले, ज्यो हियोर डेचको एने आमु ज्याम वाला माह हेते।’ <verse eid="EZK 11:3" /><verse number="4" style="v" sid="EZK 11:4" />केरीन एय माणहान सोरा, न्यान विरूद जाणाव केर, जाणाव केर।”<verse eid="EZK 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 11:5" />तेवी बोगवानान जीव मार पोर उतेरनो, एने माहु केयो, “बोगवान इही किथे, एय इस्राएलान गेराणा तुमू ओहलोच किरेल हेते; जो काय तुमरा मोनाम आवेह, ताह मी जाणथो। <verse eid="EZK 11:5" /><verse number="6" style="v" sid="EZK 11:6" />तुमू ते ज्या हेयरा माय जुलूम जाणाह मार टाक्या पुण तान सेड़क्युह देड़ा माय बोर दियेल हेते। <verse eid="EZK 11:6" /><verse number="7" style="v" sid="EZK 11:7" />केरीन बोगवान यहोवा इही किथे, काय जा माणहाह तुमू ज्या हेयरा माय मार टाकेल हेते, तान देड़ेच ज्या हेयरान वेहान डेसका वालो माह हे; एने तुमू ज्यान विचीम रेन काड़ाय जाहो। <verse eid="EZK 11:7" /><verse number="8" style="v" sid="EZK 11:8" />तुमू तालवारीह बितेह, एने मी तुमू पोर तालवारीच ने वापेर तुमरी विरूद केरूह, ज्यो बोगवान यहोवान बोल हे। <verse eid="EZK 11:8" /><verse number="9" style="v" sid="EZK 11:9" />मी तुमूह ज्या हेयरा माय रेन काढ़ीन पाराया देसान माणहान आथाम केर देह, एने तुमूह देन्ड आपाडुह। <verse eid="EZK 11:9" /><verse number="10" style="v" sid="EZK 11:10" />तुमू तालवारी केरीन माराय जाहो, एने मी तुमूह इस्राएलान हिली पोर देन्ड आपुह, तेवी तुमू जाण जाहो काय मी यहोवा बोगवान हे। <verse eid="EZK 11:10" /><verse number="11" style="v" sid="EZK 11:11" />ज्यो हियोर तुमरी केरता डेचको नाय बोणी, एने नाय तुमू ज्यान माह बोणहो; मी तुमूह इस्राएलान हिली पोर देन्ड आपुह। <verse eid="EZK 11:11" /><verse number="12" style="v" sid="EZK 11:12" />एने तुमू जाण जाहो काय मी बोगवान हे, काहाकाय तुमू मारा नेम एने कायदाह नाह मानेल सोता, पुण तुमू तुमरा चार उगेन देसान नेमा पोर चालते रेना।” <verse eid="EZK 11:12" /><verse number="13" style="v" sid="EZK 11:13" />जेवी मी जाणाव केरनेच बाज रियेल इतो काय बेनायान सोरो पालत्याह मोर गीयो, तेवी मी मुयान बोरहे पोड़ीन जोरेस आयेड़नो एने केयो, “हाय मालीक यहोवा, काय तु इस्राएल वाला वुचेल माणहाह बी खेतेम केर दिहे।”<verse eid="EZK 11:13" /></para>
  <para style="s">जेलीम जायेल माणहाह बोगवानान वायदो</para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 11:14" />पुण बोगवानान ज्य वचन मार फाय आवो। <verse eid="EZK 11:14" /><verse number="15" style="v" sid="EZK 11:15" />“एय माणहान सोरा, तुमरी हेऱ्या देरायेल माणहे एने दिहरा इस्राएली माणहान बाराम इस्राएलान आखा गेराणाह बी कियेल हे काय तुमू बोगवाना हेऱ्या रेन सेटा जावो; ज्य देस आमराच आदिकार माय आपाय जायेल हे। <verse eid="EZK 11:15" /><verse number="16" style="v" sid="EZK 11:16" />केरीन तु ताह के, मालीक बोगवान इही किथे; तीबी मी तुमूह तुमरा देसाम रेन काड़ीन दिहरा देसा माय वोहाड़ेल हे, तुमूह दिहरा देसा माय खोवली दियेल हे, तीबी तुमू दिहऱ्यु जात्यु माय रिते लेन बी थोड़ीक टेमीन केरता मारी बोक्ती केर सेकतेह। <verse eid="EZK 11:16" /><verse number="17" style="v" sid="EZK 11:17" />केरीन ता माणहाह के, मालीक बोगवान इही किथे, काय मी जाती जातीन माणहान विचीम रेन टुलो केरूह, एने जा देसा माय खोवलाय जायेल हेते, ता माय रेन तुमूह टुलो केरूह, एने तुमूह इस्राएल वाली बुय आपुह। <verse eid="EZK 11:17" /><verse number="18" style="v" sid="EZK 11:18" />जेवी ता तान देसा माय आवती, तेवी ता ताहरी रेन खाराब मुरत्युह सेटा केर देती, एने तान आखा खाराब कामाह बी सोड़ देती। <verse eid="EZK 11:18" /><verse number="19" style="v" sid="EZK 11:19" /><note caller="+" style="x"><char style="xo" closed="false">11:19 </char><char style="xt" closed="false"><ref loc="EZK 36:26-28">यहेजकेल 36:26-28</ref></char></note> एने मी तान मोनाह एक केर देह; एने ता माय नोवालो जीव पायदा केरूह एने तान डिला माय रेन देगड़ान गेत मोन काड़ीन ताह माहान मोन आपुह। <verse eid="EZK 11:19" /><verse number="20" style="v" sid="EZK 11:20" />तेवी ता मारा नेमाह मानती एने द्यान दिन मारा कायदा पोर चालती, एने ता मारी पोरजा बोणती, एने मी तान बोगवान बोणुह। <verse eid="EZK 11:20" /><verse number="21" style="v" sid="EZK 11:21" />पुण ता माणहे तान मुरता एने खाराब कामा माय मोन लागाड़ीन चालती रेतेह, ताह मी ओहलो केरूह तान चाल ताच ने मुंडा पोर पोड़ी।” मालीक बोगवानान ज्यो बोल हे।<verse eid="EZK 11:21" /></para>
  <para style="s">बोगवानान बोड़ाय यरूशलेम रेन सिटो एणे</para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 11:22" />
    <note caller="+" style="x">
      <char style="xo" closed="false">11:22 </char>
      <char style="xt" closed="false">
        <ref loc="EZK 43:2-3">यहेजकेल 43:2-3</ref>
      </char>
    </note> हेरोगदुत तान फाके पोसराया, एने चाकारा तान उगे एता, एने इस्राएलान बोगवानान उजालो ता पोर इतो। <verse eid="EZK 11:22" /><verse number="23" style="v" sid="EZK 11:23" />तेवी बोगवानान उजोड़ उपेर हवा माय आवो, एने तो यरूशलेम हेयराह सोड़ दिनो, एने एक तालान केरता यरूशलेमान पुर्व उगेन बोयड़ा पोर थोबनो। <verse eid="EZK 11:23" /><verse number="24" style="v" sid="EZK 11:24" />ओवतो जीव माहु उपेर उखल्यो, एने बोगवानान जीवान देरसेन माय माहु कसदिन देसाम देरायेल ता माणहा फाय पोचाड़ दिनो, एने जो देरसेन मी दिखेल इतो तो आरताय गीयो। <verse eid="EZK 11:24" /><verse number="25" style="v" sid="EZK 11:25" />एने बोगवान माहु देरसेन माय जो देखाड़ेल इतो, त्यु सोब वातु मी देरायेल ताह केय दिनो।<verse eid="EZK 11:25" /></para>
  <chapter eid="EZK 11" />
  <chapter number="12" style="c" sid="EZK 12" />
  <para style="s">जाणकारान जेलीम जाणेन निशाणी</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 12:1" />ओवतो यहोवान ज्य वचन मार फाय पोचनो, <verse eid="EZK 12:1" /><verse number="2" style="v" sid="EZK 12:2" />“एय माणहान सोरा, तु दिंगो केरनार गेराणान विचीम रिथे, जान देखणेन केरता डोला ते हेते, पुण देख नाह सेकते; एने होमेलनेन केरता कान ते हेते पुण होमेलते नाह; काहाकाय ता दिंगो केरनार गेराणान हेते।”<verse eid="EZK 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 12:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:3 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 6:9-10">यशाया 6:9-10</ref>; <ref loc="JER 5:31">यिर्मया 5:31</ref>; <ref loc="MRK 8:18">मरकुस 8:18</ref></char>
    </note> “केरीन एय माणहान सोरा, तु तारो सोमान तियार केरीन तान देखताच तारो जागो सोड़ीन दिहरी जागे जात रिज्ये, ता दिंगो केरनार गेराणान हेते, तीबी एय सिकेह काय ता द्यान देय। <verse eid="EZK 12:3" /><verse number="4" style="v" sid="EZK 12:4" />दिह्यान टेम माय तु तारो सोमान इह केरीन बाहेर लेन जाज्ये काय माणहे तुवाह देखती रेय, एने हांज पोर ओहलो देखाड़ने होदज्ये, काय तुमू सेटाला देसाम एक देरायेल तान गेत जाणे बाज रिनोह <verse eid="EZK 12:4" /><verse number="5" style="v" sid="EZK 12:5" />तान देखताच बितड़ो तोड़ीन एने ताम रेन निकील जाज्ये। <verse eid="EZK 12:5" /><verse number="6" style="v" sid="EZK 12:6" />तान देखताच ताह तारा खांदा पोर उखलीन आंदारलाम काढ़ज्ये, एने तारो मुय ढापीन मिलज्ये काय बुय बी तुवाह देखाय नाय; काहाकाय मी तुवाह इस्राएलान गेराणान केरता एक निसाणी ठेरायेल हे।”<verse eid="EZK 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 12:7" />ता उकुमान गेत मी तिहेच केरीन किऱ्यो, दिह्या मी मारो सोमान देरायेल तान गेत काड्यो, एने हांज पोर मारा आथा केरीन बितड़ो फुड्यो; ओवतो आंदारला माय सोमानाह काढ़ीन, तान देखताच मारा खांदा पोर उखलीन जात रिनो।<verse eid="EZK 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 12:8" />वेगोच बोगवानान ज्य वचन माहु जुड़नो, मालीक माहु केयो, <verse eid="EZK 12:8" /><verse number="9" style="v" sid="EZK 12:9" />“एय माणहान सोरा, तु नाह दिख्यो काय इस्राएलान गेराणो, ता राड़कुट्यो गेराणो तुवाह ज्य बी नाह फुशा काय तु काय केरने बाज रिनोह? <verse eid="EZK 12:9" /><verse number="10" style="v" sid="EZK 12:10" />जा ताह ज्य के, मालीक बोगवान इह केरीन किथे, यरूशलेम हेयरावाला राज केरनारे एने रेणारे सोब इस्राएली माणहान बाराम बोगवानान ज्य चेतावणी वालो वचन हे। <verse eid="EZK 12:10" /><verse number="11" style="v" sid="EZK 12:11" />एय माणहान सोरा, तु ताह इह किज्ये, मी यहेजकेल तुमरी केरता एक निसाणी हे, जोहलो मी किरेल हे तोहलो तुमरी हेऱ्यो केराय जाय, तुमू तुमरा हियोर एने देसाम रेन काड़ाय जाहो, एने देराईन दिहरा देसाम जाहो। <verse eid="EZK 12:11" /><verse number="12" style="v" sid="EZK 12:12" />तुमू पोर राज केरनार आंदारला माय तान खांदा पोर तान सोमान उखली एने जात रेय, तुमू बितड़ाह तुड़हो एने तो ता माय रेन निकली जाय, तान डोला पोर पाटा बांदाय जाय काय तो तान देसाह देख नाय सिके। <verse eid="EZK 12:12" /><verse number="13" style="v" sid="EZK 12:13" /><note caller="+" style="x"><char style="xo" closed="false">12:13 </char><char style="xt" closed="false"><ref loc="2KI 25:7">2 राजा 25:7</ref>; <ref loc="JER 52:11">यिर्मया 52:11</ref></char></note> मी ता पोर मारी जाला टाकुह, एने तो मारा फासा माय फोस जाय, मी ताह कसदी देसान राजदानी बाबिलोन हेयरा माय लावुह, पुण तो ताह देख नाय सेकी काहाकाय तो आंदलो केराय जाय, एने तो मोर जाय। <verse eid="EZK 12:13" /><verse number="14" style="v" sid="EZK 12:14" />मी ताह एने तान आदिकारीह एने तान सेनाह आखी उखीर खोवली देह, एने तालवार खेचीन तान वाह लागुह <verse eid="EZK 12:14" /><verse number="15" style="v" sid="EZK 12:15" />जेवी मी ताह देसा देसाम जोथ तोथा केरूह, एने देसाम खोवली देह; तेवी ता जाण जाती काय मीच बोगवान हे। <verse eid="EZK 12:15" /><verse number="16" style="v" sid="EZK 12:16" />पुशो मी ता माय रेन थोड़ाक माणहाह तालवार, काल बेमारी माय रेन वोचाड़ीन मेलुह; एने ता तान खाराब कामान बाराम देसाह केय होमलाड़ती जान विचीम ता पोचती; तेवी ता जाण लेती काय मी यहोवा हे।”<verse eid="EZK 12:16" /></para>
  <para style="s">कापणार जाणकारान निसाणी</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 12:17" />पोशो बोगवानान वचन माहु जुड़नो, मालीक माहु केयो, <verse eid="EZK 12:17" /><verse number="18" style="v" sid="EZK 12:18" />एय माणहान सोरा तु बिन कापती लेन रूटो खाज्ये, एने बिन थुर-थुर कापती लेन पाणी पिज्ये<verse eid="EZK 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 12:19" />तेवी तु तारा देसाम रेणाराह इह किज्ये, इस्राएल देसान राजदानी यरूशलेम माय रेणारान बाराम मालीक बोगवान इह किथे, तुमू आखा हेयराम देंगान कामे केरतेह, केरीन तुमरो देस उजाड़ एय जाय, एने बिन कापती लेन रूटो खाहो, एने पाणी पिहो <verse eid="EZK 12:19" /><verse number="20" style="v" sid="EZK 12:20" />वोहेल हियोर उजड़ी जाती, एने देस बी उजाड़ एय जाय, तेवी तुमू जाण लिहो काय मी यहोवा बोगवान हे।<verse eid="EZK 12:20" /></para>
  <para style="s">खेतेम आहने हे</para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 12:21" />पोशो बोगवानान ज्य वचन मार फाय पोचनो, <verse eid="EZK 12:21" /><verse number="22" style="v" sid="EZK 12:22" />एय माणहान सोरा, इस्राएल देसा माय ज्यी पोड़ काहा केय होमलाड़तेह; “पिढ़ा सेटकीह नाय आवी, एने देरसेनान काल्ली वात केदी पुरी नाय एय? <verse eid="EZK 12:22" /><verse number="23" style="v" sid="EZK 12:23" />केरीन ताह के, मालीक बोगवान इही किथे, मी ज्यी पोड़ बोंद केर देह; एने ज्यी पोड़ इस्राएल पोर पोशी नाय चाली। एने तु ताह के काय तो दिह आहने आव लागेल हे, एने देरसेनान आख्‍यु वातु पुऱ्यू एय जाती।”<verse eid="EZK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 12:24" />काहाकाय एवी रेन काल्लो बी माणुह जुठो देरसेन एने तान मोनाम हाजो बाकता हुगोणान विचार नाय केरी। <verse eid="EZK 12:24" /><verse number="25" style="v" sid="EZK 12:25" />काहाकाय मी बोगवान हे, जुलबुखे मी बोलुह एने जो वचन मी केव, तो पुरो एय, ता माय वार नाय लागे, पुण राड़ केरनार गेराणे, तुमरीच टेम माय मी मारो वचन केह एने तो पुरो एय जाय, मालीक बोगवानान ज्यो बोल हे।<verse eid="EZK 12:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EZK 12:26" />बोगवानान वचन माहु पोशो जुड़नो, बोगवान माहु केयो, <verse eid="EZK 12:26" /><verse number="27" style="v" sid="EZK 12:27" />“एय माणहान सोरा, देख, इस्राएली गेराणान माणहे इह केतेह, जो देरसेन जाणकार दिखेह, तान वातु जुलूम दिह्याम पुरी एती। तान जाणाव सेटाला बोविष्यान केरता हे। <verse eid="EZK 12:27" /><verse number="28" style="v" sid="EZK 12:28" />केरीन तु ताह इह के, मालीक बोगवान इह केरीन किथे, मारा वचनाह पुरो एणेन वार नाय लागे, जो मी केथु, तो जोरूर पुरो एय, मालीक बोगवान ज्य किथे।”<verse eid="EZK 12:28" /></para>
  <chapter eid="EZK 12" />
  <chapter number="13" style="c" sid="EZK 13" />
  <para style="s">जुठा जाणकारान विरूद जाणाव</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 13:1" />बोगवानान ज्य वचन मार फाय पोचनो, <verse eid="EZK 13:1" /><verse number="2" style="v" sid="EZK 13:2" />एय माणहान सोरा, “इस्राएल देसान जा जाणकार तान मोनाम जाणाव केरतेह तान विरूद जाणाव केरीन के, बोगवानान वचन हुमलो।” <verse eid="EZK 13:2" /><verse number="3" style="v" sid="EZK 13:3" />मुखी बोगवान यहोवा इह केरीन किथे, “हाय हे ता फोगा जाणकारा पोर, जा तान मोनाह पुटे तिहे चालतेह, मी ताह मारो देरसेन केदी नाह दिनो। <verse eid="EZK 13:3" /><verse number="4" style="v" sid="EZK 13:4" />एय इस्राएल, तुमरा जाणकार उजाड़ गेराम रेणार कोल्यान गेत हेते। <verse eid="EZK 13:4" /><verse number="5" style="v" sid="EZK 13:5" />तुमू इस्राएली माणहान केरता बितड़ान डोसाह हुदारनेन केरता उपेर नाह जायेल सोता काय बोगवानान दिह लेड़ाय माय मोजबुत बोणीन रेय। <verse eid="EZK 13:5" /><verse number="6" style="v" sid="EZK 13:6" />एय जाणकारे, तुमू जुठी जाणाव केऱ्या, एने तुमू जुठा हुगोणान विचार किरते रेना, केदी मी तुमूह मुकलेल नाह इतो, काय तुमू मार पोर आसा केरतेह काय मी तुमरी जुठी जाणावाह पुरो केरू? <verse eid="EZK 13:6" /><verse number="7" style="v" sid="EZK 13:7" />काय तुमू जुठो देरसेन नाह देख्या, एने मी तुमूह काल्ली खुबेर नाह आप्यो तीबी तुमू जुठी बविष्यवाणी केरीन बोगवान इह केरीन किथे केतेह!”<verse eid="EZK 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 13:8" />केरीन बोगवान यहोवा इह केरीन किथे, तुमऱ्यु जुठ्यु वातु एने जुठा देरसेनान केरता, मी तुमरी विरूद हे, मालीक बोगवानान ज्यो बोल हे। <verse eid="EZK 13:8" /><verse number="9" style="v" sid="EZK 13:9" />मारो आथ ता जुठा जाणकारान विरूद उठी, जा जुठा देरसेन देखतेह एने जुठी जाणाव केरतेह, ता मारी पोरजा इस्राएलान टोली माय नाय रेती एने तान नाव इस्राएलान गेराणा माय नाय लेखाय जाय, एने ता इस्राएल देसाम रिग नाय सेकती, तेवी तुमू जाण लिहो मी मालीक बोगवान हे। <verse eid="EZK 13:9" /><verse number="10" style="v" sid="EZK 13:10" /><note caller="+" style="x"><char style="xo" closed="false">13:10 </char><char style="xt" closed="false"><ref loc="JER 6:14">यिर्मया 6:14</ref>; <ref loc="JER 8:11">8:11</ref></char></note>काहाकाय ता मारी पोरजान माणहाह इही केन बोटकाड़तेह, आखो हाजोस हे, पुण सान्ती नाय मिले। एने ता कोमजोर बितड़ो उबो केरीन ता पोर चुनो निप देतेह। <verse eid="EZK 13:10" /><verse number="11" style="v" sid="EZK 13:11" />एय माणहान सोरा, निपणार थाबणार जुठा जाणकाराह केय दे काय बितड़ो ओदरी जाय; काहाकाय जेल्दीच मुहेलदाऱ्यो पाणी पोड़ी, एने मोठ मोठा गारा बी पोड़ती, एने मोटलो वादोण ताह ओदारी। <verse eid="EZK 13:11" /><verse number="12" style="v" sid="EZK 13:12" />जेवी बितड़ो ओदरी जाय, तेवी काय तुमूह माणहे ज्य नाय फुसती, “तुमू जो निपेल थाबेल एता तो बितड़ो काहरी गीयो?”<verse eid="EZK 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 13:13" />केरीन मालीक बोगवान तुमूह इह केरीन किथे, “मी राग केरीन मुटलो वादोण मोकलुह, एने मारा रागान कारेण से मुहोलदाऱ्यो पाणी पोड़ी, एने मारा रागा माय मोठ मोठा गारा पाडुह, एने ताह खेतेम केर देह। <verse eid="EZK 13:13" /><verse number="14" style="v" sid="EZK 13:14" />मी ता बितड़ाह तोड़ देह, जा पोर तुमू चुनो निपेल हेते, ताह मी ओदार देह, एने तान पायो रिकामो पोड़ रेय, जेवी तो ओदरी जाय, ते तुमू बी ता हेऱ्या खेतेम एय जाहो; तेवी तुमू जाण लिहो काय मी बोगवान हे।”<verse eid="EZK 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 13:15" />इह केरीन मी बितड़ा पोर एने ताह निपणार जाणकारा पोर मारो राग उतारूह, तेवी मी तुमूह फुसूह, “का गीयो तुमरो बितड़ो, एने का गीया ताह निपणारे <verse eid="EZK 13:15" /><verse number="16" style="v" sid="EZK 13:16" />ज्यो आखो इस्राएलान जुठा जाणकारान केरता रेय। ज्या यरूशलेमान सान्तीन देरसेन देखताला, पुण ताहरी सान्ती एतीच नाह मालीक बोगवानान ज्यो बोल हे।”<verse eid="EZK 13:16" /></para>
  <para style="s">जुठी बायकु जाणाव केरनारीन विरूद जाणाव</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 13:17" />एय माणहान सोरा, एवी तु तारो मुय तारा माणहान बायकुन विरूद उगाड़, ज्यु सोताच ने मोना केरीन जाणाव केरत्युह, तु त्युन विरूद जाणाव केरीन के, <verse eid="EZK 13:17" /><verse number="18" style="v" sid="EZK 13:18" />मालीक बोगवान किथे, ज्यु बायकु त्युन आथाम जादून तावीज बांदिन माणहाह फासाड़नेन केरता एने त्युन मुंडाह डापणेन केरता लांबाला गुंगटा केरत्युह, हाय हे त्यु पोर काय तुमू मारी पोरजान माणहान जीव दोका माय टाकहो एने सोताह वोचाड़ीन मिलहो? <verse eid="EZK 13:18" /><verse number="19" style="v" sid="EZK 13:19" />तुमू ते मुठ बोर जुवार एने रोटान टुकड़ान बोदले मारी पोरजान नेजरीम एठो ठेरावीन, तुमरी त्यु वातु केरीन, जा मारी पोरजान माणहे तुमू फाय रेन होमेलतेह, जा खेतेम एणेन लायकीन नाह एता, ताह मार टाक्या; एने जा वोचणेन लायकीन नाह एता तान जीवाह वोचाड़ लेदा।<verse eid="EZK 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 13:20" />केरीन बोगवान यहोवा तुमूह इही किथे; दिखो, “मी तुमरा ता उहत्यान विरूद हे, जा केरीन तुमू जीवान सिकार केरत्युह, जाह तुमू सिकार केरीन उड़ावत्युह ताह मी तुमरा खोलाम सांडाड़ीन ताह सोड़वी लेह। <verse eid="EZK 13:20" /><verse number="21" style="v" sid="EZK 13:21" />मी तुमरा मुंडान गुंगटाह फाड़ीन मारी पोरजान माणहाह तुमरा आथाम रेन सोड़वुह, एने ओंगाण ता तुमरा ताबाम नाय रेती काय तुमू तान सिकार केर सिको; तेवी तुमू जाण लिहो काय मी बोगवान हे।”<verse eid="EZK 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 13:22" />तुमू ज्यु जुठ मेलीन देरमीन मोनाह नाराज केरने नाह होद्यु, एने खाराब माणहाह ईमोत देरायेल हेत्यु, काय तो तान खाराब वाटीन उगे रेन नाय वोले एने जीवतालो रेय। <verse eid="EZK 13:22" /><verse number="23" style="v" sid="EZK 13:23" />केरीन तु पोशी नाय ते जुठा देरसेन दिखहे, एने नाय बोड़वाय किरहे, काहाकाय मी मारी पोरजाह तारा आथाम रेन सोड़वुह, तेवी तुमू जाण जाहो काय मी यहोवा हे।<verse eid="EZK 13:23" /></para>
  <chapter eid="EZK 13" />
  <chapter number="14" style="c" sid="EZK 14" />
  <para style="s">बोगवाना उगे रेन मुरती पुजान चिहटा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 14:1" />एक दिह इस्राएलान थोड़ाक डायडाया मार फाय आवीन मार सामने बोह गीया। <verse eid="EZK 14:1" /><verse number="2" style="v" sid="EZK 14:2" />तेवी बोगवानान ज्य वचन मार फाय पोचनो। <verse eid="EZK 14:2" /><verse number="3" style="v" sid="EZK 14:3" />एय माणहान सोरा, ज्या माणहे न्यान जीवा माय मुरताह बोहाड़ीन मिलेल हेते एने सोतान मुयान सामने खाराबीन ठोकरान दिगोड़ मेल रेनाह। काय मी न्याह मार फाय जाणकारी लेणेन पारवांगी आपु? <verse eid="EZK 14:3" /><verse number="4" style="v" sid="EZK 14:4" />केरीन ता हिऱ्यो वातु केर एने ताह के, मालीक बोगवान इही किथे, जेवी एगदो इस्राएली तान मोनाम मुरताह बोहाड़ेह एने तान मुयान सामने खाराबीन ठोकरान दिगोड़ मिलेह एने तेवी तो जाणकारा फाय जाथे, ते मी सोता तान मुरती पुजान वातुह एर मेलीन ताह जापाप आपुह। <verse eid="EZK 14:4" /><verse number="5" style="v" sid="EZK 14:5" />मी ज्यान केरता ओहलो केरूह काय मी ता इस्राएली माणहान मोनाह पुशो मार उगे केर सेकु, जा तान मुरतान केरता माहु सोड़ दियेल हेते।<verse eid="EZK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 14:6" />केरीन इस्राएलान माणहाह के, “मालीक बोगवान इही किथे, एय इस्राएली गेराणा! पाचतावो किरो तुमऱ्यु मुरत्युह रेन सेटा एन तुमरा सोब खाराब कामाह सोड़ दिवो।”<verse eid="EZK 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 14:7" />“काहाकाय इस्राएलान गेराणाम रेन एने तान विचीम रेणारे दिहरा देसावाला माय रेन बी एगदो काह नाह रेय, जो मार पासाण चालने सोड़ीन तान मुरता तान मोनाम बाणावी, एने तान पापान ठोकेर तान सामने मिले, एने तेवी मार फाय तान एगदी वात फुसणेन केरता जाणकारा फाय आवी, ते ताह, मी यहोवा सोताच जापाप आपुह। <verse eid="EZK 14:7" /><verse number="8" style="v" sid="EZK 14:8" />एने मी ता माणहान विरूद एन तान नाकार केरूह, एने एक निसाणी ठेरावुह; एने तान ज्यी केवाय चालाडुह एने ताह मारी पोरजा माय रेन खेतेम केरूह; तेवी तुमू जाण लिहो काय मी यहोवा हे।”<verse eid="EZK 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 14:9" />“एने केदी जाणकार दुको खाएन एगदो वचन केयो एय, ते जाण जाहो काय बोगवान ता जाणकाराह दुको दियेल हे; एने मी मारो आथ तान विरूद ओंगाण केरीन ताह मारी पोरजा इस्राएल माय रेन खेतेम केर देह। <verse eid="EZK 14:9" /><verse number="10" style="v" sid="EZK 14:10" />ता सोब माणहे तान पापान वोजो विसती मतलब जिह केरीन जाणकाराह फुसणारान पाप ठेराय, तिहेच केरीन जाणकारान बी पाप ठेराय। <verse eid="EZK 14:10" /><verse number="11" style="v" sid="EZK 14:11" />काहाकाय इस्राएलान गेराणो पोशो मार पासाण चालने नाय सुड़े एने नाय बात बातीन पापे केरीन ओंगाण पोशा ता एठा बुणे; पुण ता मारी पोरजा बुणे एने मी तान बोगवान ठेराव।” बोगवान यहोवान ज्यो बोल हे।<verse eid="EZK 14:11" /></para>
  <para style="s">नुह, दानिएल एने अय्युब</para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 14:12" />एने बोगवानान ज्य वचन मार फाय पोचनो, <verse eid="EZK 14:12" /><verse number="13" style="v" sid="EZK 14:13" />“एय माणहान सोरा, जेवी एगदा देसान माणहे मार हेऱ्या बुरहो तोड़ीन पापी बोण जाय, एने मी मारो आथ तान विरूद ओंगाण केरीन तान एनान आदार सिटो केरूह, एने ता माय काल पाड़ीन ता माय रेन माणहाह एने जेनवेराह दुयाह खेतेम केरूह, <verse eid="EZK 14:13" /><verse number="14" style="v" sid="EZK 14:14" />तेवी निह ते ता माय नुह, दानिएल एने अयुब ज्या तीन माणहे रेती, तीबी ता तान देरेम ने कामा केरीन निस्ता सोताच ने जीवाह वोचाड़ सेकती; बोगवान यहोवान ज्यो बोल हे।”<verse eid="EZK 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 14:15" />“केदी मी एगदा देसाम खाराब जेनवार मोकलु जो ताह हुनालो केरीन उजाड़ केर टाके, एने जेन्तुन कारेण कुण ता माय लागतो नाय जाए, <verse eid="EZK 14:15" /><verse number="16" style="v" sid="EZK 14:16" />ते निह ते ता तीनु माणहे बी रेती, तीबी बोगवान यहोवान ज्यो बोल हे, मारा जीवणान सुगोण, नाय ता सोरा पोऱ्याह वोचाड़ सेकती; पुण ता एखालाच वोचती; पुण देस उजाड़ एय जाय।”<verse eid="EZK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 14:17" />“एने केदी मी ता देसा पोर तालवार खेचीन केव, एय तालवार ता देसाम चालाड़ीन; एने इहीच केरीन मी ता माय रेन माणहाह एने जेनवेराह दुयाह बी खेतेम केरूह, <verse eid="EZK 14:17" /><verse number="18" style="v" sid="EZK 14:18" />निहते ता तीन माणहे बी रेती, तीबी बोगवान यहोवान ज्यो बोल हे, मारा जीवणान सुगोण नाहते ता बेटाख एने बेटह्युख वोचाड़ सेकती, ताच एखालाच वोचती।”<verse eid="EZK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 14:19" />“केदी मी ता देसाम बेमारी पोसरावु एने ता पोर मारो राग बोड़कावीन तान खुन ओहलो वोयाडु काय ताहरी वाला माणहे एने जेनवारे दुयू खेतेम एती, <verse eid="EZK 14:19" /><verse number="20" style="v" sid="EZK 14:20" />ते निहते नुह, दानिएल, एने अयुब बी ता माय रेती, तीबी बोगवान यहोवान ज्यो बोल हे, मारा जीवणान सुगोण, ता नायते सोरा एने सोऱ्युह वोचाड़ सेकती, तान देरेमने कामान कारेण ता निस्ता सोताच ने जीवाह वोचाड़ सेकती।”<verse eid="EZK 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 14:21" />काहाकाय बोगवान यहोवा इही किथे, “मी यरूशलेम पोर मारो चारू देन्ड पोचाडुह, मतलब तालवार, काल, खाराब जेन्तु एने बेमारी, ता माय माणुह एने जेनवार सोब ता माय रेन खेतेम एय जाती। <verse eid="EZK 14:21" /><verse number="22" style="v" sid="EZK 14:22" />तीबी ता माय थोड़ाच सोरा सोऱ्यु वोचती जा ताहरी रेन निकलीन तुमू फाय पोचाड़ाय जाती, एने तुमू तान चाल चलन एने कामाह देखीन ती पिड़ान बाराम जो यरूशलेम पोर टाकुह, पुण जोल्यु पिढ़ा मी ता पोर टाकुह, ता सोबान बाराम हुक सापड़ावहो; <verse eid="EZK 14:22" /><verse number="23" style="v" sid="EZK 14:23" />जेवी तुमू तान चाल चलन एने कामाह दिखो, ते ता तुमरी सान्तीन कारेण बोणती; एने तुमू जाण लिहो काय मी यरूशलेम माय जो काय केऱ्यो, तो बिगेर कारेण नाह किऱ्यो।” ज्यो बोगवान यहोवान बोल हे।<verse eid="EZK 14:23" /></para>
  <chapter eid="EZK 14" />
  <chapter number="15" style="c" sid="EZK 15" />
  <para style="s">अंगुरान वेलान किस्सो</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 15:1" />बोगवानान ज्य वचन मार फाय पोचनो एने मालीक माहु केयो, <verse eid="EZK 15:1" /><verse number="2" style="v" sid="EZK 15:2" />“एय माणहान सोरा माहु के, एक अंगुरान वेलान लाकोड़ उजाड़ बुईन काल्ला जाड़ान लाकड़ाह रेन हाजो रेणे? <verse eid="EZK 15:2" /><verse number="3" style="v" sid="EZK 15:3" />काय केदी ज्यान लाकड़ाह लेन एगदी वापेरनेन वोस्तु बाणावाय जायेल हे? काय माणहे वोस्तुह टांगणेन केरता ज्यान खुटो बाणावतेह? <verse eid="EZK 15:3" /><verse number="4" style="v" sid="EZK 15:4" />नाह माणहान सोरा अंगुरान वेलान लाकुड़ निस्तो आक्‍ठा माय हेलगाड़नेन काम आवेह। एने तान दुयू सेंडा आक्‍ठा माय हेलगी जातेह एने तान विचीम वालो बाग दुंगड़ाय जाथे, तेवी काय तो कायतान कामान रेय जाथे? <verse eid="EZK 15:4" /><verse number="5" style="v" sid="EZK 15:5" />जेवी ज्यी तान पुरा आकारा माय एती, तेवी ज्यो काय कामान नाह एती, ते ओवतो ज्यान काय वापेर एय सिकेह जेवी ज्यो आक्‍ठा माय हेलगी गीयो एने दुंगड़ाय गीयो?”<verse eid="EZK 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 15:6" />जिह केरीन “मी अंगुरान वेलान लाकड़ाह उजाड़ बुईन जाड़ान विचीम आक्‍ठान केरता आपेल हे, तिहेच केरीन मी यरूशलेम माय रेणारा हिऱ्यो वेवारो केरूह। <verse eid="EZK 15:6" /><verse number="7" style="v" sid="EZK 15:7" />मी तान उगे रेन मारो मुय फिराव लेह, तीबी ता आक्‍ठा माय रेन वोचीन निकलीन आयेल हेते, तीबी आक्ठोच ताह हेलगाड़ीन खेतेम केर देय, एने जेवी मी मारो मुय तान उगे रेन फिराव लेह, तेवी तुमू जाण लिहो काय मीच बोगवान हे। <verse eid="EZK 15:7" /><verse number="8" style="v" sid="EZK 15:8" />मी देसाह उजाड़ देह, काहाकाय ता मार बाराम बुरहो तुड़ेल हेते।” ज्यो मालीक बोगवानान बोल हे।<verse eid="EZK 15:8" /></para>
  <chapter eid="EZK 15" />
  <chapter number="16" style="c" sid="EZK 16" />
  <para style="s">सिनाली यरूशलेम</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 16:1" />पोशो बोगवानान ज्य वचन मार फाय पोचनो। <verse eid="EZK 16:1" /><verse number="2" style="v" sid="EZK 16:2" />“एय माणहान सोरा, यरूशलेमाह तान सोब खाराब कामे जा तो किरेल हे किय दे।” <verse eid="EZK 16:2" /><verse number="3" style="v" sid="EZK 16:3" />तु ताह के, एय यरूशलेम, मालीक बोगवान तुवाह इही किथे,</para>
  <para style="p" vid="EZK 16:3">“तारो जेल्मो कनान देसाम एनो; एने तारो आबोख एक एमोरी जातीन एने तारी आहख एक हित्ती जातीन एती। <verse eid="EZK 16:3" /><verse number="4" style="v" sid="EZK 16:4" />यरूशलेम, जेदिह तु पायदा एनी, तारो नाल काटणार कुण नाह एतो, एने कुण तार पोर मिठ नाह टाक्‍यो एने तुवाह चोखो केरनेन केरता उंगलायो नाह, कुणूस तुवाह फाड़काम नाह चोंडाल्यो। <verse eid="EZK 16:4" /><verse number="5" style="v" sid="EZK 16:5" />तुवा पोर कुण किव नाह केऱ्यो, एने नाह तार बाराम गिण केरीन तारो नाल काट्यो। तुवाह चोखो केरनेन केरता पाण्या केरीन नाह उंगलायो, एने तुवाह मिठा केरीन नाह चोल्यो, एने नाह तुवाह फाड़काम चोंडाल्यो, तु तेदिह, जेदिह तु पायदा एनी, तुवाह खाराब वोस्तु सोमजीन खेताम जुगाराय गीयो।”<verse eid="EZK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 16:6" />जेवी मी तार हिऱ्यो रेन सिरीकनो, तेवी मी तुवाह लुयीम लोथपोत दिख्यो, तेवी मी केयो, “एय लुयीम लोलनार! जीवताली रे, <verse eid="EZK 16:6" /><verse number="7" style="v" sid="EZK 16:7" />ओवतो मी तुवाह खेतावाला टोटालान गेत वोदाड्यो, एने तु पोहाएन जुवान एय गियी, एने तारी सात्यु मोठ्यु एन्यु एने तारा लेट्या लांबा एय गीया, तीबी तु उगाड़लीच एती।”<verse eid="EZK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 16:8" />“मी तार पोर निजेर टाकीन दिख्यो, काय तु मोंगीन केरता तियार एती, केरीन मी मारा फाड़का टाक्‍यो एने तारा सेरीराह डाप्यो, एने तार हिऱ्यो वाराड़ केरनेन वचन आप्यो, मी तार हिऱ्यो वाचा बांद्यो, एने तु मारी बोण गियी, मालीक बोगवानान ज्यो बोल हे।”<verse eid="EZK 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 16:9" />तेवी मी तुवाह पाण्या केरीन उंगलावीन तार पोर रेन लुय दोव दिनो, एने तारा डिला पोर तेल चुपड्यो। <verse eid="EZK 16:9" /><verse number="10" style="v" sid="EZK 16:10" />मी तुवाह एक हाजालो पेरावोट एने हुवाला चामड़ान चाट्या पेरायो, एने मी तुवाह हुवाला एने जामण्या फाड़का पेरायो। <verse eid="EZK 16:10" /><verse number="11" style="v" sid="EZK 16:11" />तेवी मी तुवाह गेयणो आप्यो, एने तारा आथाम बांगड्यु एने गेलाम हार पेरायो। <verse eid="EZK 16:11" /><verse number="12" style="v" sid="EZK 16:12" />ओवतो मी तारा नाकाम नाथनी एने तारा कानाम कानावाला पेरायो, एने तारा मुंडा पोर होबातो मुकूट पेरनेन केरता आप्यो। <verse eid="EZK 16:12" /><verse number="13" style="v" sid="EZK 16:13" />मी तुवाह होना चांदीन गेयणा केरीन हिंगार दिनो, एने तारा फाड़का सुती हुवाला रेशमान एता, जा सितरायेल एता, तु मोयदान रूटो, एने मोवाल एने तेलाम चुड़ेल खाणो खाताली, तु जुलूम हाजी एती एने तु राणी बोणनी। <verse eid="EZK 16:13" /><verse number="14" style="v" sid="EZK 16:14" />एने तारी होबायीन कारेण तारी बोम जाती जातीन माणहाम पोसरी गियी, काहाकाय मी तुवाह जी होबा मारी उगे रेन आपेल इतो, तु जुलूम गाटाली एती, मालीक बोगवानान ज्य वचन हे।<verse eid="EZK 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 16:15" />“पुण तु तारी होबाय एने बोम ने कारेण फायदो विसीन तार हेऱ्या आवणारे आखा माणहा हेरी सिनालो केरी। <verse eid="EZK 16:15" /><verse number="16" style="v" sid="EZK 16:16" />तु तारा फाड़का केरीन रेंगी बिरेंगी उचाला जागा बाणाव लेदा, एने ता पोर सिनालो केरी, ओहला खाराब कामे केरी जा केदी नाह एना एने नाय एती। <verse eid="EZK 16:16" /><verse number="17" style="v" sid="EZK 16:17" />जो होनो चांदीन हाजालो गेयणो मी तुवाह आपेल एता, तु ताकेरीन माणहान चित्रा बाणायी, एने ता चित्रा हेरी खाराब कामे केरी। <verse eid="EZK 16:17" /><verse number="18" style="v" sid="EZK 16:18" />एने तारा सितरायेल फाड़का लावीन ताह पेराया, एने मारो तेल एने दुणी तान सोमोर चेड़ायी <verse eid="EZK 16:18" /><verse number="19" style="v" sid="EZK 16:19" />एने जो खाणो बी मी तुवाह खाणेन केरता आपेल इतो, फिट, जेतुन तेल एने मोवाल तु ज्याह तान सामने एक गेंदाणी दुणीन गेत चेड़ायी।” बोगवानान ज्यो बोल हे, ओहलोच ईयेल हे।<verse eid="EZK 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 16:20" />“पोशी तु तारा सोरा सोऱ्युह जाह तु मार केरता जेल्मो दियेल एती, लावीन मुरताह बोली केरीन चेड़ायी, काय तारो सिनालो ओहली आतीच वात एती? <verse eid="EZK 16:20" /><verse number="21" style="v" sid="EZK 16:21" />काय तु मारा सोरा पोऱ्याह ता मुरतान ओंगाण आक्ठाम चेड़ावीन मारेल हे? <verse eid="EZK 16:21" /><verse number="22" style="v" sid="EZK 16:22" />एने तारा सोब खाराब कामाम एने सिनालो किरते लेन, तारा सोरा पोणान दिह्याह केदी एर नाह केऱ्यी, जेवी काय तु उगाड़लीच तारी लुयीम लोलताली।”<verse eid="EZK 16:22" /></para>
  <para style="s">यरूशलेमान जीवणो एक वेश्यान गेत</para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 16:23" />मालीक बोगवानान ज्यो बोल हे, “हाय, तार पोर हाय! तारी ती सोब खाराबीन पासाण काय एनो? <verse eid="EZK 16:23" /><verse number="24" style="v" sid="EZK 16:24" />तु तार केरता एक चुटो बाणाव लेदी, एने आखा चौकाम एक उचालो जागो बाणाव मांगी; <verse eid="EZK 16:24" /><verse number="25" style="v" sid="EZK 16:25" />एने आखी गेल्ल्युन कोपराम तु पुजान जागो बाणावीन ताहरी लागता जाणार माणहान तारी होबा देखाड़ीन रांडीन गेत बोण गियी। <verse eid="EZK 16:25" /><verse number="26" style="v" sid="EZK 16:26" />तु तारा आहनेवाला मिस्र देसान माणहा हेरी बी सिनालो केरी, एने इही तारा जुलूम होवटा सिनालान कामा केरीन मारा रागाह बोड़कायी।” <verse eid="EZK 16:26" /><verse number="27" style="v" sid="EZK 16:27" />“केरीन देख, मी तार पोर आथ उठावीन तुवाह देन्ड आप्यो, तारो खास हेक से सिटो किर दिनो एने तारी दुसमोन पलिश्‍ती बायकु ज्यु तारा मोटला पापान चाल देखीन लाजवात्युह, त्युन मोरजी पोर मी तुवाह सोड़ दियेल हे।”<verse eid="EZK 16:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 16:28" />“तु अश्शुरी माणहा हेरी बी सिनालो केरी, पुण तु ता हेरी सिनालो केरीन बी तारी बुख नाह ओलानी। <verse eid="EZK 16:28" /><verse number="29" style="v" sid="EZK 16:29" />ओवती तु लेणो देणो केरनार देसाम बी सिनालो किरती किरतीन कसदिन देसाम वोर पोचनी, एने ताहरी बी तारी बुख नाह ओलानी।”<verse eid="EZK 16:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 16:30" />मालीक बोगवानान ज्यो बोल हे, “जेवी तु इह केरीन एक विणलाजी रांडीन गेत काम किरेह, ते मी रागाम बोराय जाथु। <verse eid="EZK 16:30" /><verse number="31" style="v" sid="EZK 16:31" />तु आख्‍यु सेड़क्युन कोपरा माय जो तारा चुटा, एने आखा चौका माय उचाला जागा बाणवायेल हे, काय तु वेश्यान गेत नाह बोणनी? काहाकाय तु ओहली कामाय पोर आहेह। <verse eid="EZK 16:31" /><verse number="32" style="v" sid="EZK 16:32" />तु सिनाली बायकु हे! तु तारा सोतान एदम्यान बोदले पाराया एदम्याह वोदार पसंद किरेह। <verse eid="EZK 16:32" /><verse number="33" style="v" sid="EZK 16:33" />आख्‍यु वेश्या ते पोयशा लेत्युह, पुण तु ते सोता तारा हातीह पोयशा आपीन, लालुच देखाड़ीन पाराया एदम्याह हादाड़ेल हे, काय कावदेन आवीन तार हेऱ्या सिनालो केरी। <verse eid="EZK 16:33" /><verse number="34" style="v" sid="EZK 16:34" />इह केरीन तारो सिनालो दिहरा सिनाल्याह रेन उलटो हे, तारो पासाण काल्लो सिनाल्यो नाह चालेत, एने तु कुणी फाय किमोत नाह लेत, पुण सोताच पोयशा आपेह; केरीन तु उलटी हे।”<verse eid="EZK 16:34" /></para>
  <para style="s">यरूशलेमाह बोगवानान देन्ड</para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 16:35" />केरीन ओ वेश्या, बोगवानान वचन हुमेल,<verse eid="EZK 16:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="EZK 16:36" />मालीक बोगवान इह केरीन किथे, “काय तु जी सिनाला माय जुलूम विणलाजी बोणीन, तारो सेरीर तारा हातीह देखाड़ी, एने तारा मुरता हेरी खाराब कामे केरी, एने तारा सोरा पोऱ्यान लुय वोयाड़ीन ताह बोली चेड़ायेल हे। <verse eid="EZK 16:36" /><verse number="37" style="v" sid="EZK 16:37" />केरीन मी तारा ता सोब हातीह टुलो किरन्यो हे, जा हेरी तुवाह खुसी जुड़नी, जाह तु मोंग किरेल हे, एने जाह तु खाराब जाणेल हे, मी ताह चारो उगे रेन तार विरूद टुलो केरूह एने तान सोमोर तारा फाड़का काडुह एने ता तारो उगाड़लो डिल देखती। <verse eid="EZK 16:37" /><verse number="38" style="v" sid="EZK 16:38" />जो देन्ड सिनाली बायकु एने खुनी बायकुह आपाय जाथे, तोच देन्ड मी तुवाह आपुह, मी राग एने एतखाय माय तारी लुय वोयाडुह। <verse eid="EZK 16:38" /><verse number="39" style="v" sid="EZK 16:39" />इह केरीन मी तुवाह तान ताबाम केर देह, एने तारा चुटाह ओदार देह, एने तारा उचाला जागाह तोड़ देती; ता तारा फाड़काह काड़ती, एने तारा होबाता गेयणाह लुट लेती एने तुवाह उगाड़ली केरीन सोड़ देती।”<verse eid="EZK 16:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="EZK 16:40" />“ता तान होवटाली सेना लेन तार पोर चेड़ाय केरती, ता तुवाह देगड़ा केरीन देती एने तालवारी केरीन तुकड़ा तुकड़ा केरती। <verse eid="EZK 16:40" /><verse number="41" style="v" sid="EZK 16:41" />ता तारा गेराह हेलगाड़ देती, एने तुवाह जुलूम बायकुन देखताच देन्ड आपती; एने मी तारो सिनालो बोंद केरावुह, एने तु पोशी सिनालान केरता किमोत नाय आपहे। <verse eid="EZK 16:41" /><verse number="42" style="v" sid="EZK 16:42" />तेवी तार विरूद मारो राग ओलाय जाय एने तार पोर मारी एतखायीन राग जात रेय; मी ठावको एय जाह एने पुशो राग नाय केरू। <verse eid="EZK 16:42" /><verse number="43" style="v" sid="EZK 16:43" />तु जा तारा सोरा पोणान दिह एर नाह मेल्या, पुण ज्यु सोब वातु केरीन माहु खिज लागाड़ी; केरीन मी तारो चालचलन तारी मुंडी पोर टाकुह एने तु तारा पासाणल्या सोब खाराब कामाह रेन पोशी वोदार मोटला पाप नाय किरहे।” मालीक बोगवानान ज्यो बोल हे।<verse eid="EZK 16:43" /></para>
  <para style="s">जोहली आहख तोहली बेटीख</para>
  <para style="p">
    <verse number="44" style="v" sid="EZK 16:44" />तेवी बोगवान केयो, “तार बाराम वातु केरनारे सोब माणहा फाय एक पोशी केणेन केरता रेय, ता केती, जोहली आहख तोहली बेटीख। <verse eid="EZK 16:44" /><verse number="45" style="v" sid="EZK 16:45" />तु तारी आईख ने सोरी हे, तु तारा एदमी नाहते ते सोराह इरेत नाह, तु हुतरी तार बोणीख ने गेत हे, तुमू दुयू तुमरा एदम्याह एने सोराह नफरत केऱ्यु, तु हुतरी तारा आईख आबाख ने गेत हे, तारी आहख हित्ती एने तारो आबोख एमोरी इतो।”<verse eid="EZK 16:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="EZK 16:46" />“तारी बोणीख शोमरोन हे, जी तीन सोऱ्यु हेरी तारी जिवड़े उगे रिथे, एने तारी आतली बोणीख, जी तारी डाखरी उगे रिथे, ती सोऱ्यु हेरी सदोम हियोर हे। <verse eid="EZK 16:46" /><verse number="47" style="v" sid="EZK 16:47" />तु निस्ती तान पायान निसाणी पोर चालीन तान खाराब कामान नेकेल केरी, पुण उतवालीच तु तारा सोब कामा माय ताह रेन बी वोदार एठी एय गियी।”<verse eid="EZK 16:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="EZK 16:48" />मालीक बोगवानान ज्यो बोल हे, “मारा जीवणान सुगोण, तारी बोणीख सदोम तीन सोऱ्यु हेरी तारी एने ताऱ्यु सोऱ्युन गेत काम नाह केऱ्यु। <verse eid="EZK 16:48" /><verse number="49" style="v" sid="EZK 16:49" />देख, तारी बोणीख सदोम ने पाप ज्यो इतो, काय ती तीन सोऱ्यु हेरी मोठाय केरताली, एने पेट बोरीन खाताली एने हुकेह रेताली; एने गेरीब माणहाह नाह होमालताली। <verse eid="EZK 16:49" /><verse number="50" style="v" sid="EZK 16:50" />एने ती मोठाय केरीन मार सामने खाराब कामे केरने बाज गियी, एने ज्य देखीन मी त्युह सिटो केर दिनो। <verse eid="EZK 16:50" /><verse number="51" style="v" sid="EZK 16:51" />पोशी शोमरोन तारा पापान आदा बी पाप नाह केऱ्यी, तु ते तीह रेन वोदार खाराब काम केऱ्या, एने तारा खाराब कामा द्वारा तारी तुलना माय तारी बोणीख निर्दोस ठेरायेल हे। <verse eid="EZK 16:51" /><verse number="52" style="v" sid="EZK 16:52" />केरीन तु तारी बोणह्युख ने न्यायनिवाड़ो केऱ्यी, केरीन लाजवाय, काहाकाय तु त्युह रेन वोदार खाराब पाप किरेल हे; केरीन त्यु तुवाह रेन कोम गुनेगार बोणन्यु। केरीन तु ज्यी वातुन केरता लाज केर एने लाजवाते रे, काहाकाय तु तारी बोणह्युख कोम गुनेगार ठेरायेल हे।”<verse eid="EZK 16:52" /></para>
  <para style="s">सदोम एने शोमरोनान पोशो बाणवाय जाणो</para>
  <para style="p">
    <verse number="53" style="v" sid="EZK 16:53" />तेवी बोगवान यरूशलेमाह केयो, “मी सदोम एने त्युन बेट्युख जीवन, एने शोमरोन एने त्युन बेट्युख ने जीवणो एने ता हेऱ्योच तारो जीवणो बी बोदलुह। <verse eid="EZK 16:53" /><verse number="54" style="v" sid="EZK 16:54" />जा से तारी मोठाय टुट जाय, एने तारा आखा कामाह देखीन लाजवाय; काहाकाय तु तान सांतीन कारेण बुणेल हे। <verse eid="EZK 16:54" /><verse number="55" style="v" sid="EZK 16:55" />इह केरीन तु एने तारी बोणह्युख पोशु बाणवाय जाती, सदोम एने त्युन चार उगेन हियोर, शोमरोन एने तान चार उगेन हियोर एने तु एने तारी चार उगेन हियोर पोशा बाणवाय जाती। <verse eid="EZK 16:55" /><verse number="56" style="v" sid="EZK 16:56" />तारा मोठायीन दिह्याम, जेवी तारा पापे नाह देखायेल एता, तेवी तु तारी बोणीख सदोमान नाव वोर नाह लेणे होदताली। <verse eid="EZK 16:56" /><verse number="57" style="v" sid="EZK 16:57" />तिहेच केरी, एवी तु एदोमान बेट्युख एने त्युन आहनेवाल्यु एने पलिश्तीन बेट्युख ने एने तारी चार उगेन माणहान उगे रेन खाराब सोमजाय जाथे। <verse eid="EZK 16:57" /><verse number="58" style="v" sid="EZK 16:58" />पुण एवी तुवाह तारा मोटला पापान केरता पिढ़ा उखेलने पोड़ी, जा तु केरी।” बोगवानान ज्यो बोल हे।<verse eid="EZK 16:58" /></para>
  <para style="s">एक वाचा जी जेलेमकी ठेराय</para>
  <para style="p">
    <verse number="59" style="v" sid="EZK 16:59" />मालीक बोगवान ज्य किथे, “मी तार हिऱ्यो ओहलोच वेवार केरूह, जोहलो तु किरेल हे, काहाकाय तु ते वाचा तोड़ीन मारो सुगोणान मान नाह मेली। <verse eid="EZK 16:59" /><verse number="60" style="v" sid="EZK 16:60" />तीबी मी तारा सोरा पोणान दिह्यान मारी वाचा एर केरूह, एने तार हिऱ्यो जेलेमक्यी वाचा बांदुह। <verse eid="EZK 16:60" /><verse number="61" style="v" sid="EZK 16:61" />मी तारी बोणह्युख तार फाय लावुह एने मी त्युह तारी बेटह्युख बाणावुह, ज्य आपणी वाचाम नाह एतो, पुण मी तार केरता केरूह, तेवी तु ता मोटला पापाह जाह तु किरेल एर केरीन लाजवाहे बी। <verse eid="EZK 16:61" /><verse number="62" style="v" sid="EZK 16:62" />इही केरीन मी तार हिऱ्यो मारी वाचा बांदुह, एने तुमू जाणहो काय मी बोगवान हे, <verse eid="EZK 16:62" /><verse number="63" style="v" sid="EZK 16:63" />तेवी मी तारा खाराब कामाह माफ केरूह, तेवी तु एर किरहे एने लाजवाहे एने लाजीन माऱ्यी मुय बी नाय उगाड़हे, ज्य ती टेम माय एय, जेवी मी तारा सोब पापाह डापुह।” मालीक बोगवानान ज्यो बोल हे।<verse eid="EZK 16:63" /></para>
  <chapter eid="EZK 16" />
  <chapter number="17" style="c" sid="EZK 17" />
  <para style="s">गुवड़ान एने अंगुरान वेलान किस्सो</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 17:1" />बोगवानान ज्य वचन मार फाय पोचनो, <verse eid="EZK 17:1" /><verse number="2" style="v" sid="EZK 17:2" />“एय माणहान सोरा, इस्राएलान गेराणाह ज्यी वार्ता एने किस्सो के; <verse eid="EZK 17:2" /><verse number="3" style="v" sid="EZK 17:3" />मालीक बोगवान इही किथे, एक मुटलो गुवड़ो मोटला फाकावालो लबानोन माय आवो, तो देवदार जाड़ान सिगी पोर बोह गीयो, ता गुवड़ान काबऱ्या लांबाला फाके एता। <verse eid="EZK 17:3" /><verse number="4" style="v" sid="EZK 17:4" />तो आखान उपेरली कोवली डालीह तोड़ लेदो एने तीह वेपारान एक देसाम लेन गीयो, एने एक वेपारीन हेयराम ठाण दिनो <verse eid="EZK 17:4" /><verse number="5" style="v" sid="EZK 17:5" />तेवी तो गुवड़ो इस्राएल देसान थोड़ाक बिजा लियावीन एक पाकणार खेताम पेर दिनो, तो ता बिजाह पाणी बोरायेल जागाम मजनून गेत पिऱ्यो। <verse eid="EZK 17:5" /><verse number="6" style="v" sid="EZK 17:6" />एने तो उगीन आतली पोसेरनार अंगुरान वेलाम बोदलाय गियी वेलान डाल्यु गुवड़ा उगे डोंगानी, पुण तान मुले ताहरीच रेना, जाहरी बिजो ठाणाय जायेल एतो, एने तो अंगुर वेल बोण गीयो, एने तान डालख्यु फुटन्यु एने पाला वोलना।”<verse eid="EZK 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 17:7" />“पोशो ताहरी एक लांबाला फाकावालो एक गुवड़ो एतो; एने तो अंगुरान वेल ता जागाम रेन जाहरी तो ठाणायेल एतो, ता दिहरा गुवड़ा उगे तान मुले पोसरावणे एने डालख्यु डोंगाणे बाज गीयु काय तो ताह पाणी वाल्या केरी। <verse eid="EZK 17:7" /><verse number="8" style="v" sid="EZK 17:8" />ता वेलाह हाजाला बुई माय होवटाला पाण्यावाला जागाम लागाड़ाय जायेल एतो, काय ता माय डालख्यु निकले; ता माय फोल लागे, एने ती जुलूम हाजी अंगुरान विलो बुणे।”<verse eid="EZK 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 17:9" />पुण मालीक बोगवान किथे, “काय ज्य वेल ताहरी वोदी जाहरी ठाणाय जायेल हे, नाह, ताताली जाव चाली एने वेल हुक जाय एने मोर जाय; ज्यी तीच बुयीम हुक जाय, जाहरी ती उगेल एती। <verse eid="EZK 17:9" /><verse number="10" style="v" sid="EZK 17:10" />केदी ताह उखालीन दिहरा जागाम ठाणे, ते काय ता माय पोशा फुले लाग सेकती? नाह! जेवी पूर्वान वादोण आवी, तेवी तान जापोट से तो आखो हुक जाय।”<verse eid="EZK 17:10" /></para>
  <para style="s">किस्सान मतलब</para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 17:11" />पोशो बोगवानान ज्य वचन मार फाय पोचनो, <verse eid="EZK 17:11" /><verse number="12" style="v" sid="EZK 17:12" />“ता दिंगो केरनार माणहाह के, काय तुमू ज्यु वातुन मतलब नाह सोमेजते? पुशो ताह के, बाबिलोन ने राजा यरूशलेम गीयो एने तान राजा एने मुखी माणहाह तान आरही लेन पुशो बाबेल लेन आवो। <verse eid="EZK 17:12" /><verse number="13" style="v" sid="EZK 17:13" />तेवी राजान वोसीम रेन एक एदम्याह लेन ता हेऱ्यो वाचा बांद्यो, एने ताह ताबाम रेणेन सुगोण खावाड्यो, एने देसान मुखी माणहाह देरीन लेन गीयो। <verse eid="EZK 17:13" /><verse number="14" style="v" sid="EZK 17:14" />काय तो राज कोमजोर एय जाए एने पोशो वोद नाय सिके, पुण वाचा पालनेन स्थिर रेय। <verse eid="EZK 17:14" /><verse number="15" style="v" sid="EZK 17:15" />पुण ता राज ने राजा तान खोबर्‍याह गोड़ा एने मोटली सेना लावणेन केरता मिस्र देसाम मुकल्यो एने इह केरीन बाबेलान राजा हिऱ्यो राड़ किऱ्यो, काय तो जिक सेकी? काय तो वाचाह तोड़नेन ओहलो काम केरीन देन्डाह रेन वोच सेकी!”<verse eid="EZK 17:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 17:16" />मालीक बोगवान किथे, “मारा जीवणान सुगोण, जा देसान राजा ताह राजा बाणायेल इतो, एने ताच देसान राजान वचनाह कोम सुमजेह, एने तान वाचाह तो तुड़ेल हे, ताच राजान देस बाबिलोन माय तो मोरी। <verse eid="EZK 17:16" /><verse number="17" style="v" sid="EZK 17:17" />जुलबुखे आड़खा बाणाया एने माणहाह मारनेन केरता कोंडणेन काम केराय जाय, ते फिरोन एने तान मोटली सेना एने तान लेड़ाय केरनार टुलो बी लेड़ाय माय तान काय काम नाय पोड़ी। <verse eid="EZK 17:17" /><verse number="18" style="v" sid="EZK 17:18" />काहाकाय तो सुगोणाह कोम जाण्यो, एने वाचाह तोड्यो; तो वचन आपीन बी ओहला कामे किरेल हेते, केरीन तो वोच नाय सेकी।”<verse eid="EZK 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 17:19" />मालीक बोगवान इही किथे, “मारा जीवणान सुगोण, तो मारा सुगोणाह कोम सुमज्यो, एने मारी वाचाह तुड़ेल हे; ज्यो पाप ताच ने मुंडी पोर टाकुह। <verse eid="EZK 17:19" /><verse number="20" style="v" sid="EZK 17:20" />एने मी तान केरता मारी जाल ता पोर पोसरावुह, एने तो मारा फासाम फोसी; एने मी ताह बाबुल माय पोचाड़ीन ताहरी ताह देन्ड आपुह, काहाकाय तो मारो बुरहो तुड़ेल हे। <verse eid="EZK 17:20" /><verse number="21" style="v" sid="EZK 17:21" />तान आखी सेनाह तालवारी केरीन माराय जाती, एने वुचेल माणहे चार चोमखेर जोथ तोथा खोवलाय जाती, तेवी तुमू जाण जाहो काय मी यहोवा ओहलो कियेल हे।”<verse eid="EZK 17:21" /></para>
  <para style="s">बोगवानान वायदो</para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 17:22" />पुशो मालीक बोगवान किथे,</para>
  <para style="q1" vid="EZK 17:22">“मी देवदार जाड़ान उचाले डालीम रेन एक डाल लेन</para>
  <para style="q2" vid="EZK 17:22">एने मी तीह बुयीम ठाणुह, एने तान आखाम रेन उचाली डाल तोडुह,</para>
  <para style="q1" vid="EZK 17:22">तीह एक जुलूम उचा बोयड़ा पोर लागाडुह।<verse eid="EZK 17:22" /></para>
  <para style="q2">
    <verse number="23" style="v" sid="EZK 17:23" />मतलब मी ताह इस्राएलान बोयड़ान चुटा पोर ठाणुह,</para>
  <para style="q1" vid="EZK 17:23">ता माय डालख्यु फुटीन निकेलती एने फोले लागती</para>
  <para style="q2" vid="EZK 17:23">एने तो एक जुलूम हाजो देवदार जाड़ रेय,</para>
  <para style="q1" vid="EZK 17:23">आखा बातीन चिड़ा ता माय पांजरा बाणावती;</para>
  <para style="q2" vid="EZK 17:23">एने तान डालख्युम वोहती केरती।<verse eid="EZK 17:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="EZK 17:24" />उजाड़ बुईवाला आखा जाड़े जाण लेती</para>
  <para style="q2" vid="EZK 17:24">काय मी यहोवा उचाला जाड़ाह नेचा केर देथु,</para>
  <para style="q2" vid="EZK 17:24">एने आतल्या जाड़ाह वोदाड़ीन उचा केरथु,</para>
  <para style="q1" vid="EZK 17:24">मी निलागार जाड़ाह हुखवी देथु,</para>
  <para style="q2" vid="EZK 17:24">एने हुकेल जाड़ाह निलागार केरीन वोदाड़थो,</para>
  <para style="m" vid="EZK 17:24">मी यहोवा कियेल हे, मी ज्याह पुरो केरूह।”<verse eid="EZK 17:24" /></para>
  <chapter eid="EZK 17" />
  <chapter number="18" style="c" sid="EZK 18" />
  <para style="s">सोतान जापापदारी</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 18:1" />पोशो बोगवानान ज्य वचन मार फाय पोचनो, <verse eid="EZK 18:1" /><verse number="2" style="v" sid="EZK 18:2" />तुमू जा इस्राएल देसान बाराम ज्य काणी केतेह,</para>
  <para style="q1" vid="EZK 18:2">खाटाला अंगुर खादा ते आबहेख,</para>
  <para style="q1" vid="EZK 18:2">पुण दात खाटाना, सोरान ज्यान काय मतलब हे?<verse eid="EZK 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 18:3" />मालीक बोगवान किथे काय मारा जीवणान सुगोण, तुमूह इस्राएल देसाम पोशी ज्यी काणी केणेन टेम नाय जुड़ी। <verse eid="EZK 18:3" /><verse number="4" style="v" sid="EZK 18:4" />दिखो, आखान जीव ते मारा हेते; आईख आबाख ने हेऱ्योच सोरान बी जीव हे; दुयू माराच हेते, केरीन जो माणुह पाप किरेह, तो मोर जाय।<verse eid="EZK 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 18:5" />जो एगदो देरमी रेय, एने न्यायनिवाड़ान एने देरेम काम केरी, <verse eid="EZK 18:5" /><verse number="6" style="v" sid="EZK 18:6" />एने नाय ते बोयड़ा पोर वाला पुजान जागाम खादो एय, एने नाह इस्राएलान गेराणान मुरता उगे निजेर टाक्‍यो एय; एने नाह पारायी बायकु हिऱ्यो फाड़को आवणे बुखेत ती हिऱ्यो पाप सोवचार किऱ्यो एय। <verse eid="EZK 18:6" /><verse number="7" style="v" sid="EZK 18:7" />तो कुणीन ठेगीन नाह खात पुण, गिरवी मिलेल वोस्तु केर्जावालाह फिराव दिथे, तो चोरी नाह किरेत, पुण बुखल्याह तान रूटो आपेह, एने उगाड़लाह फाड़का पेरावेह। <verse eid="EZK 18:7" /><verse number="8" style="v" sid="EZK 18:8" />तो बिगेर वियाजान पोयशा उदारे आपेह, एने ता फाय रेन फायदो नाह विसेत, तो खाराब काम केरनेन तान आथ रोक मिलेह, एने माणहान विचीम खेरो न्यायनिवाड़ो किऱ्यो एय। <verse eid="EZK 18:8" /><verse number="9" style="v" sid="EZK 18:9" />तो मारी नेमा पोर चालेह एने मार नेमाह मानते लेन खेराईम काम केऱ्यो एय, ओहलो माणुह देरमी हे, तो खेरीच जिवतालो रेय, ज्यो मालीक बोगवानान बोल हे।<verse eid="EZK 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 18:10" />“पुण केदी तान बिटोख डाकु, खुनी, नाहते उपेर कियेल पापाम रेन काल्लो बी पाप केरतेय, <verse eid="EZK 18:10" /><verse number="11" style="v" sid="EZK 18:11" />तीबी तान आबोख ज्याम रेन काल्लो बी काम निह केरतेय, एने बोयड़ावाला पुजान जागाम खाणो खादो एय, पारायी बायकुह दिऱ्यो एय। <verse eid="EZK 18:11" /><verse number="12" style="v" sid="EZK 18:12" />गेरब्याह ठेगीन खादो एय, एने दिहराह लुट्यो एय, गिरवी मिलेल वोस्तु निह फिरावतेय, मुरता पोर निजेर टाक्‍यो एय, खाराब कामे किऱ्यो एय। <verse eid="EZK 18:12" /><verse number="13" style="v" sid="EZK 18:13" />तो वियाजा पोर उदार पोयशा आपेह एने फायदो कामावेह, काय ओहलो माणुह जीवतालो रेय? तो जीवतालो नाय रेय! काहाकाय तो ज्या आखा खाराब कामे किरेल हे, तो जोरूर मार टाकाय जाय; तान खुनान गुनो ताच पोर रेय।”<verse eid="EZK 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 18:14" />“पुण केदी, ज्या बेटाख ने बिटोख हे, जो तान आबाख ने उगे रेन किरेल आखा पापाह दिखेह, एने तीबी तो ता पापाह दिखेह, पुण तो ओहलो काल्लो पाप नाह किरेत। <verse eid="EZK 18:14" /><verse number="15" style="v" sid="EZK 18:15" />तो बोयड़ा पोर वाला वेदीन सामने बोली किरेल जेनवेरान माह नाह खात, एने इस्राएली गेराणान उगे रेन मानेल मुरता उगे मोदेक ने केरता निजेर नाह टाकेत, तो तान आहने रेणारान बायकुह एठी नाह किरेत। <verse eid="EZK 18:15" /><verse number="16" style="v" sid="EZK 18:16" />तो कुणीह ठेगीन नाह खात, केरजो आपणेन केरता काल्ली वोस्तु गिरवी नाह लेत, तो चोरी नाह किरेत, पुण सोतान रूटो बुखल्याह आपेह एने उगाड़लाह फाड़का पेरावेह। <verse eid="EZK 18:16" /><verse number="17" style="v" sid="EZK 18:17" />तो गेरब्याह सेतावणेन तान आथाह रोक मिलेह, एने ता फाय रेन वियाजान फायदो नाह विसेत, तो मारा नेमान पालेन किरेह, एने मारा नेमा पोर चालेह, तो तान पापान कारेण नाय मोरी; तो जोरूर जीवतालो रेय। <verse eid="EZK 18:17" /><verse number="18" style="v" sid="EZK 18:18" />पुण तान आबोख तान सोतान पापान कारेण मोरी, काहाकाय तो तान हेगा बाय बोणहाह लुट्यो, एने तो काम किऱ्यो जो तान गेरल्यान माणहान विचीम खाराब हे।”<verse eid="EZK 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 18:19" />तीबी तुमू फुसतेह, “बिटोख तान आबाख ने गुनान देन्ड काहा नाय बोगी? जेवी बिटोख तो काम किऱ्यो जो हाजो एने खेरो हे, एने हासकेरीन मारा नेमाह मानेल हे, ते तो जोरूर जीवतालो रेय। <verse eid="EZK 18:19" /><verse number="20" style="v" sid="EZK 18:20" />जो पाप केरी, मोरी बी तोच, पापान फोल बिटोख केदी बी नाय बोगी, एने नायते बेटाख ने पापान फोल आबाख बोगेतणे पोड़ी, पुण देरमी माणहाह तान देरमान फोल एने पापीह तान पापान फोल जुड़ी।”<verse eid="EZK 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 18:21" />“पुण केदी पापी माणुह तान सोब पापाह सोड़ दिथे, एने मारा नेमान पालेन किरेह, केदी तो माणुह नियाव एने देरमान काम केरने बाज जाय, ताहार तो नाय मोरी; पुण जीवतालो रेय। <verse eid="EZK 18:21" /><verse number="22" style="v" sid="EZK 18:22" />तो जा बी पापे किरेल हे, नियाव ने दिह तान गुनान लेखो नाय लेवाय जाय, पुण तो तान देरमान कामान कारेण जीवतालो रेय। <verse eid="EZK 18:22" /><verse number="23" style="v" sid="EZK 18:23" />काय मी एगदा पापीन मोती माय खुस एथु? नाह, जेवी एगदो पापी माणुह तान खाराब कामाह सोड़ दिथे एने जीवतालो रिथे, तेवी माहु खुसी इथे, ज्य मी बोगवान यहोवान वचन हे।”<verse eid="EZK 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 18:24" />“पुण एगदो देरमी माणुह तान देरेमने कामाह सोड़ीन खाराब कामे केरने बाज जाथे, ते काय ओहलो माणुह जीवतालो रेय? नाह, पुण न्यायनिवाड़ान दिह तान देरेम ने कामान एर नाय केराय जाय, काहाकाय तो मारो बुरहो तुड़ेल हे, केरीन तो गुनेगार हे, एने तो पाप किरेल हे; केरीन तो जोरूर मोरी।”<verse eid="EZK 18:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 18:25" />तीबी तुमू केतेह, “मालक्यान नेती हाजी नाय मिले; एय इस्राएली होमलो, काय मारी नेती हाजी नाय मिले? तान उलटा, तुमू खाराब कामाह देरेम ने काम केतेह, पुण काय तुमरी नेती खाराब हेत्यु ज्यु न्यायनिवाड़ान बाराबोर नाय मिले। <verse eid="EZK 18:25" /><verse number="26" style="v" sid="EZK 18:26" />केदी एगदो देरमी माणुह तान देरेम ने कामाह सोड़ीन खाराब काम किरेह, ते तो तान खाराब कामान कारेण मोरी; जो पाप किरेह, तान फोल मोत हे। <verse eid="EZK 18:26" /><verse number="27" style="v" sid="EZK 18:27" />पुण केदी पापी माणुह तान खाराब कामाह सोड़ दिथे, एने तो काम किरेह जो हाजो एने खेरो हे, ते तो तान जिवाह वोचाड़ी। <verse eid="EZK 18:27" /><verse number="28" style="v" sid="EZK 18:28" />काहाकाय तो तान केराय जायेल सोब पापान पाचतावो किऱ्यो एने ताह सोड़ दिनो, केरीन तो माणुह जोरूर जीवतालो रेय; तो नाय मोरी। <verse eid="EZK 18:28" /><verse number="29" style="v" sid="EZK 18:29" />तीबी इस्राएली केतेह, मालक्यान वेवारो हाजो नाय मिले; एय इस्राएलान माणहे, काय मारो वेवारो हाजो नाह सोतो? काय जो तुमरो वेवारो नाह, ज्यो हाजो नाय मिले।”<verse eid="EZK 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 18:30" />“केरीन एय इस्राएली, मी तुमरे माय रेन आखान न्यायनिवाड़ो ताच ने सोबावान गेत केरूह, ज्य मारो यहोवा बोगवानान वचन हे, पाचतावो किरो, तुमरा सोब पापाह सोड़ दिवो; तेवीस तुमरो पाप तुमरे ठोकेर खाणेन कारेण नाय बोणी। <verse eid="EZK 18:30" /><verse number="31" style="v" sid="EZK 18:31" />तुमू मार विरूद जुलूम पापे किरेल हेते, ता सोबाह तुमू हेऱ्या रेन सेटा किरो; एक नोवालो मोन एने एक नोवाली जीव पेर लिवो, हे, इस्राएलान माणहे तुमू मोरने काहा होदतेह? <verse eid="EZK 18:31" /><verse number="32" style="v" sid="EZK 18:32" />काहाकाय मी एगदा पापी माणहान मोतीम खुस नाह एत, केरीन तुमू पासतावो केरीन फिरीन आवो, एने जेलेम जीवताला रिवो।” मालीक बोगवानान ज्य वचन हे।<verse eid="EZK 18:32" /></para>
  <chapter eid="EZK 18" />
  <chapter number="19" style="c" sid="EZK 19" />
  <para style="s">दुखान एक गीत</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 19:1" />एय माणहान सोरा, तु इस्राएली मुखीन बाराम ज्य दुखान गीत गाव;<verse eid="EZK 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="EZK 19:2" />“ओ इस्राएलान मुखी, तुमरी आहख सिंहान विचीम एक सिंहणी एती।</para>
  <para style="q1" vid="EZK 19:2">ती जुवान सिंहान विचीम कोंडाय रेताली, एने तीन पिलाह पोह्या केरताली।<verse eid="EZK 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="EZK 19:3" />तारा पिलाम रेन एक पिलाह ती मोठो केऱ्यी,</para>
  <para style="q2" vid="EZK 19:3">एने तो जुवान सिंह बोण गीयो, तो सिकार केरने हिक लिदो,</para>
  <para style="q2" vid="EZK 19:3">तो माणहान सिकार केरने बाज गीयो।<verse eid="EZK 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 19:4" />आस पास ने देसे तान बाराम होमलीन चेकचेल्या एय गीया,</para>
  <para style="q2" vid="EZK 19:4">ता तान विरूद जाल पोसराया एने तो तान खाडाम फोस गीयो,</para>
  <para style="q1" vid="EZK 19:4">एने ता तान नाकाम नाथ पेरावीन ताह मिस्र देसाम लेन गीया।<verse eid="EZK 19:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 19:5" />जेवी सिंहणी देखी काय तीन आसा पुरी नाह एनी, एने तीन आसा जात रेनी,</para>
  <para style="q1" vid="EZK 19:5">ते ती तीन एक पिलाह लेदी</para>
  <para style="q2" vid="EZK 19:5">एने ताह एक तेगड़ो सिंहो बाणायो।<verse eid="EZK 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="EZK 19:6" />तो दिहरा सिंहा हिऱ्यो चालने फिरने बाज गीयो, काहाकाय एवी तो एक</para>
  <para style="q2" vid="EZK 19:6">तेगड़ो सिंहो बोण जायेल एतो, तो सिकार केरने हिक गीयो; एने</para>
  <para style="q1" vid="EZK 19:6">तो माणहान सिकार केरने बाज गीयो।<verse eid="EZK 19:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 19:7" />तो तान आहने वाला देसान किल्‍ला उजाड़ देना;</para>
  <para style="q1" vid="EZK 19:7">तान हियोर हुनाला केर देना, तान डांगार होमलीन आखो देस</para>
  <para style="q2" vid="EZK 19:7">एने ता माय रेणारे माणहे बियीन काप उठना।<verse eid="EZK 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 19:8" />तेवी आहनेवाला देस चार चोमखेर</para>
  <para style="q2" vid="EZK 19:8">ताह देरनेन केरता जाल पोसराया;</para>
  <para style="q1" vid="EZK 19:8">ता ता पोर फासो टाक्या;</para>
  <para style="q2" vid="EZK 19:8">एने तो तान खाडाम फोस गीयो।<verse eid="EZK 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 19:9" />ता नाथ टाकीन ताह उपेर खेच्या एने ताह एक पिंजरा माय टाक देना</para>
  <para style="q2" vid="EZK 19:9">एने ताह बाबेलान राजा फाय लेन गीया,</para>
  <para style="q1" vid="EZK 19:9">ता ताह कोंडीन मेल्या, ता माय</para>
  <para style="q2" vid="EZK 19:9">तान डांगार</para>
  <para style="q2" vid="EZK 19:9">इस्राएल देसान बोयड़ा पोर पोशी केदी नाह होमलानो।”<verse eid="EZK 19:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="EZK 19:10" />तुमरी आहख पाण्यान मीरे ठाणेल अंगुरान वाड़ीन एक</para>
  <para style="q2" vid="EZK 19:10">वेलान गेत एती;</para>
  <para style="q1" vid="EZK 19:10">पाणी जुलूम जुड़नो केरीन ता माय फोल लागताला, एने</para>
  <para style="q2" vid="EZK 19:10">ती डाल्यु एने फोलाम लादायेल एत्यु।<verse eid="EZK 19:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="EZK 19:11" />तीन डाल्यु मोजबुत एत्यु,</para>
  <para style="q2" vid="EZK 19:11">एने राजान राजदेन्डान केरता लायकीन एती,</para>
  <para style="q1" vid="EZK 19:11">ती ओली उची एती, काय जुगाह टेकणे बाज गियी,</para>
  <para style="q2" vid="EZK 19:11">तीन उचाय एने जुलूम डाल्युन कारेण ज्यी खास एती।<verse eid="EZK 19:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZK 19:12" />पुण तीन दुसमोन रागाईन तीह उखाल दिनो,</para>
  <para style="q2" vid="EZK 19:12">एने बुई पोर टाक दिनो, ताताली जाव तीह हुकाड़ देनी,</para>
  <para style="q1" vid="EZK 19:12">तीन फोल ओदरी गीया;</para>
  <para style="q1" vid="EZK 19:12">तीन मोजबुत डाल्यु हुख गीयु</para>
  <para style="q2" vid="EZK 19:12">एने आक्ठाम ती टाकाय गीयु।<verse eid="EZK 19:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="EZK 19:13" />एवी तीह हुनाले जागे,</para>
  <para style="q2" vid="EZK 19:13">एने हुकेल बुयीम ठाणाय जायेल हे।<verse eid="EZK 19:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="EZK 19:14" />पुण तीन मुखी</para>
  <para style="q2" vid="EZK 19:14">डालीम रेन आक्‍ठो निकेलनो एने तीन फोलाह हेलगाड़ीन खेतेम केर दिनो,</para>
  <para style="q1" vid="EZK 19:14">तीम काल्ली पाकाली</para>
  <para style="q2" vid="EZK 19:14">डाल नाह वोचनी, जो राजान वापेर ने केरता राजदेन्ड बोण सेकी, ज्य एक दुखान गीत हे, एने सोमाज माय एक दुखान गीतान गेत वापेर केरनु हे।<verse eid="EZK 19:14" /></para>
  <chapter eid="EZK 19" />
  <chapter number="20" style="c" sid="EZK 20" />
  <para style="s">बोगवानान मोरजी एने माणहान चेतावणी</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 20:1" />सातवा वोरह्यान पाचवा मोयनान दोहवे दिह, इस्राएलान थोड़ाक मुखी बोगवानान मोरजी जाणनेन केरता आवा; एने ता मार सामने बोह गीया। <verse eid="EZK 20:1" /><verse number="2" style="v" sid="EZK 20:2" />तेवी बोगवानान ज्य वचन मार फाय पोचनो, <verse eid="EZK 20:2" /><verse number="3" style="v" sid="EZK 20:3" />एय माणहान सोरा, इस्राएलान मुखी हिऱ्यो वात केर एने ताह के, “मालीक बोगवान इही किथे, काय तुमू मारी मोरजी जाणनेन केरता आवाह? मी मारा जीवणान सुगोण खाएन केथु, तुमू मारी मोरजी केदी नाय जाण सिकहो।”<verse eid="EZK 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 20:4" />“एय माणहान सोरा, तुच तान नियाव केर एने सोता फिसलो केर, काय कुण गुनेगार हे, न्यान डायडाया जा खाराब कामे किरेल हेते, ता न्याह केय होमलाव। <verse eid="EZK 20:4" /><verse number="5" style="v" sid="EZK 20:5" />एने ताह के, मालीक बोगवान किथे, जेदिह मी इस्राएलाह निवाड़ेल इतो, ते दिह मी याकुबान वोसी हिऱ्यो सुगोण खादो एने मिस्र देसाम सोताह देखाड़ेल इतो, एने सुगोण खाएन कियेल इतो, मी तुमरो बोगवान यहोवा हे। <verse eid="EZK 20:5" /><verse number="6" style="v" sid="EZK 20:6" />ते दिह मी सुगोण खादो काय मी न्याह मिस्र देसाम रेन काड़ीन एक ओहला देसाम लेन आवुह, जाह मी तान केरता हुदेल इतो, एक ओहलो देस जा माय दुद एने मोवालान दार वुयेह, एने जो आखा देसाह रेन हाजो हे। <verse eid="EZK 20:6" /><verse number="7" style="v" sid="EZK 20:7" />एने मी न्याह कियेल इतो, मिस्र देसान खाराब मुरत्युह टाक दिवो, ज्यु पोर तुमरी नेजेर लाग रिथे, सोताह एठा मा किरो; काहाकाय मीच तुमरो बोगवान यहोवा हे। <verse eid="EZK 20:7" /><verse number="8" style="v" sid="EZK 20:8" />पुण ता मार विरूद राड़ केऱ्या, एने मारी वातु नाह होमल्या; ता मिस्र देसान खाराब मुरत्युह सोता हेऱ्या रेन सेटा नाह केऱ्या, जी पोर तान नेजेर लाग रियेल एती, पुण ता मिस्रान मुरत्युह नाह सोड्या, तेवी मी फिसलो किऱ्यो काय मी मिस्र देसाम तान विरूद मारो राग देखाडुह। <verse eid="EZK 20:8" /><verse number="9" style="v" sid="EZK 20:9" />पुण मारा नावा बोदेल मी ताह मिस्र देसाम रेन काड़ीन लावो, मी ओहलो ज्यान केरता किऱ्यो काय मारो नाव ता देसान नेजरीम एठो नाय ठेराय, जा माणहान विचीम ता रेताला एने जान देखताच मी सोताह इस्राएली माणहा पोर देखाड़ेल इतो।”<verse eid="EZK 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 20:10" />“केरीन मी ताह मिस्र देसाम रेन काड़ीन उजाड़ ईलाका माय लेन गीयो। <verse eid="EZK 20:10" /><verse number="11" style="v" sid="EZK 20:11" />मी ताह मारा नेम आप्यो एने ताह मारो कायदो केयो, जान केदी एगदो माणुह पालेन किरेह, ते तो जीवतालो रेय। <verse eid="EZK 20:11" /><verse number="12" style="v" sid="EZK 20:12" />मी तान केरता विहेवणेन दिह बी आप्यो, जो मारो एने तान विचीम एक निसाणी रेय, काय ताह मालुम पुड़े काय मी बोगवान ताह चोखाला बाणावथो। <verse eid="EZK 20:12" /><verse number="13" style="v" sid="EZK 20:13" />तीबी इस्राएली माणहे हुनाला ईलाका माय मार विरूद राड़ केऱ्या, ता मारा नेमा पोर नाह चालना एने मारा कायदाह नाह मान्या, जाह केदी एगदो माणुह पालेन किरेह, ते तो जीवतालो रेय, एने ता जाण जोवीन मारा विहेवणेन दिह्याह एठो केऱ्या, केरीन मी केयो, काय मी ता पोर मारो राग केरूह एने हुनाला ईलाकाम ताह खेतेम केर देह। <verse eid="EZK 20:13" /><verse number="14" style="v" sid="EZK 20:14" />पुण मारा नावा बोदेल मी तो किऱ्यो जा माय मारो नाव ता देसान नेजरीम एठो नाय एणे जुवे, जान देखता मी ताह काड़ीन लायेल इतो। <verse eid="EZK 20:14" /><verse number="15" style="v" sid="EZK 20:15" />मारो आथ ओंगाण केरीन हुनाला ईलाकाम मी सुगोण खादो काय मी ताह ता देसाम नाय लावु, जो देस मी ताह आपेल इतो, एक ओहलो देस जाहरी दुद एने मोवालान दार वोयेह, जो आखा देसाह रेन हाजो हे। <verse eid="EZK 20:15" /><verse number="16" style="v" sid="EZK 20:16" />ज्यान कारेण ज्य एतो काय ता मारा कायदाह नाह मान्या एने मारा नेमा पोर नाह चालना, एने मारा विहेवणेन दिह्याह एठा केऱ्या, काहाकाय तान मोन मुरत्यु पोर लाग रियेल एतो।”<verse eid="EZK 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 20:17" />“तीबी मी ता पोर गीण किऱ्यो, एने ताह खेतेम नाह किऱ्यो; एने हुनाला ईलाकाम ताह नाह माऱ्यो। <verse eid="EZK 20:17" /><verse number="18" style="v" sid="EZK 20:18" />मी ती पिढीन सोराह केयो, तुमरा आहख आबोख जा खाराब कामे केरतेह तो मा किऱ्यो, तान खाराब कायदा पोर मा चालो, तान खाराब नेमाह मा मानो, तान मुरत्यु हेऱ्या रेन सोताह चोखा किरो। <verse eid="EZK 20:18" /><verse number="19" style="v" sid="EZK 20:19" />मी यहोवा तुमरो बोगवान हे; मारा नेमा पोर चालो, एने हाज केरीन मारा कायदान पालेन किरते रिवो। <verse eid="EZK 20:19" /><verse number="20" style="v" sid="EZK 20:20" />एने मारा विहेवणेन दिह्याह चोखालो मानो, काय ता मारी एने तुमरी विचीम एक निसाणी रेय, तेवी तुमू जाणहो काय मी यहोवा तुमरो बोगवान हे।”<verse eid="EZK 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 20:21" />“पुण इस्राएलान नोवाली पिढ़ी बी मार विरूद राड़ केऱ्या, ता मारा नेमा पोर नाह चालना, ता मारा कायदान पालेन केरनेन होमाल नाह केऱ्या, जान बाराम मी कियेल इतो, जो माणुह तान पालेन केरी, तो जीवतालो रेय, एने ता मारा विहेवणेन दिह्यान एठा केऱ्या, केरीन मी केयो, मी ता पोर मारो राग रोचवुह एने हुनाला ईलाकाम ताह मारो राग देखाडुह। <verse eid="EZK 20:21" /><verse number="22" style="v" sid="EZK 20:22" />पुण मी मारा आथाह रोक मिल्यो, एने मारा नावा बोदेल मी तो किऱ्यो, जा माय मारो नाव ता देसान नेजरीम एठो नाय ठेराय, जान देखता, मी ताह काड़ीन लायेल इतो। <verse eid="EZK 20:22" /><verse number="23" style="v" sid="EZK 20:23" /><note caller="+" style="x"><char style="xo" closed="false">20:23 </char><char style="xt" closed="false"><ref loc="LEV 26:33">लेव्यवस्था 26:33</ref></char></note> हुनाला ईलाकाम मी मारो आथ ओंगाण केरीन तान सुगोण खादो काय मी ताह देसा देसान माणहान विचीम वेर देह, एने दुनियान देसाम ताह खोवली देह। <verse eid="EZK 20:23" /><verse number="24" style="v" sid="EZK 20:24" />काहाकाय ता मारा कायदान पालेन नाह केऱ्या एने मारा नेमान नाकार केऱ्या एने मारा विहेवणेन दिह्याह एठा केऱ्या, एने तान डोला तान आईख आबाख ने मुरत्यु पोर लाग रेना।”<verse eid="EZK 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 20:25" />“केरीन मी ताह दिहरा नेम आप्यो जा हाजा नाह एता, एने ताह ओहला कायदा आप्यो जाह पालेन केरीन जीवताला नाह रेय सेकताला। <verse eid="EZK 20:25" /><verse number="26" style="v" sid="EZK 20:26" />मी ताह ईरे चेड़ायो काय ता तान पेल्ला सोराह, आक्‍ठान बोली चेड़ावे; मी तान ज्यी बोलीन वोजेसे ताह खाराब जाती बाणाव दिनो। मी ज्य सोब काम ज्यान केरता किऱ्यो, काय ता जाणे मी यहोवा हे।”<verse eid="EZK 20:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EZK 20:27" />“केरीन एय माणहान सोरा, इस्राएलान माणहा हिऱ्यो वातु केर एने ताह के, यहोवा बोगवान इही किथे, ज्या पोर बी तुमरा डायडाया मारो बुरहो तोड़ीन मारी चिहटा किरेल एता। <verse eid="EZK 20:27" /><verse number="28" style="v" sid="EZK 20:28" />जेवी मी ताह ता देसाम लेन आवो, जाह मी आपणेन सुगोण खायेल इतो, तीबी ता एगदी उचालो बुयड़ो नाहते एगदो पालावालो जाड़ाह देखीन, ताहरी बोली चेड़ावणे एने पुजा केरने बाज गीया, एने तान गेंदाण्यो तेलान दुणी हेलगाड़ीन पिणेन बोली रोचवणे बाज गीया ता माय मारो राग बोड़कनो। <verse eid="EZK 20:28" /><verse number="29" style="v" sid="EZK 20:29" />तेवी मी ताह फुशो, जा बोयड़ा पोर तुमू जातेह, तो काय हे? जा तुमू ताहरी जातेह <verse eid="EZK 20:29" /><verse number="30" style="v" sid="EZK 20:30" />केरीन इस्राएली माणहाह के, बोगवान यहोवान ज्य केणो हे, काय तुमू तुमरा डायडायान गेत सोताह एठा किरहो एने तान खाराब मुरत्युन पासाण दोवेड़हो? <verse eid="EZK 20:30" /><verse number="31" style="v" sid="EZK 20:31" />जुलबुखे तुमू तुमरी बेट ज्यु मुरत्युन सामने बोली चेड़ावतेह एने जेवी तुमू तुमरा सोरान आक्‍ठान बोली चेड़ावतेह, ते ओहलो केरीन तुमू आज वोर सोताह मुरती पुजा केरीन एठा केरतेह, ओहलो खाराब काम केरीन तुमू आसा केरतेह काय मी तुमरा सावालान जापाप आपीन तुमूह मारी मोरजी देखाडु? मी मारा जीवणान सुगोण खाएन केथु, तुमू मारी मोरजी नाय जाण सिकहो, यहोवा बोगवानान ज्यो बोल हे। <verse eid="EZK 20:31" /><verse number="32" style="v" sid="EZK 20:32" />तुमरा मोनाम ज्यी आसा इथे, आवो आपु बी दिहरा देसान गेत आलेग आलेग देसान जातीन गेत देगड़ान एने लाकड़ान मुरत्युन सेवा केरता, पुण तुमरा मोनाम जो हे, तो केदी पुरो नाय एय।”<verse eid="EZK 20:32" /></para>
  <para style="s">बोगवान देन्ड बी आपणे एने माफी बी आपणे</para>
  <para style="p">
    <verse number="33" style="v" sid="EZK 20:33" />“मी यहोवा केथु, मारा जीवणान सुगोण मी ताकेतवालो आथ एने वोदाड़ेल खांदा एने बोड़केल रागाम तुमरी पोर राज केरूह। <verse eid="EZK 20:33" /><verse number="34" style="v" sid="EZK 20:34" />मी तुमूह जाती जातीन माणहाम एने देसाम रेन लावीन टुलो केरूह, जाहरी तुमू खोवलायेल हेते, मी तुमूह ताकेतवोर आथ एने वोदाड़ेल खांदो एने बोड़केल रागाम टुलो केरूह। <verse eid="EZK 20:34" /><verse number="35" style="v" sid="EZK 20:35" />मी तुमूह ता रेन काड़ीन हुनाला ईलाकाम लेन आवुह एने ताहरी आमने सामने तुमरो न्यायनिवाड़ो केरूह। <verse eid="EZK 20:35" /><verse number="36" style="v" sid="EZK 20:36" />जोहलो काय मी मिस्र देसान हुनाला ईलाकाम तुमरा डायडायान न्यायनिवाड़ो किरेल इतो, तोहलोच मी तुमरो न्यायनिवाड़ो केरूह।” बोगवान यहोवान ज्य वचन हे।<verse eid="EZK 20:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="EZK 20:37" />“तुमू मारी डेंगीन ताबाम चालहो, ते मारो द्यान तुमू पोर रेय, एने मी तुमूह वाचान बोंदेन माय बांदुह। <verse eid="EZK 20:37" /><verse number="38" style="v" sid="EZK 20:38" />मी तुमूह ता माय रेन सेटा केरीन चोखा केरूह, जा मार विरूद राड़ एने पाप केरतेह, तीबी मी ताह ता देसाम रेन काड़ीन लावुह, जाहरी ता रेणे बाज रेनाह, तीबी ता इस्राएल देसाम रिग नाय सेकती, तेवी तुमू जाणहो काय मी बोगवान हे।”<verse eid="EZK 20:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="EZK 20:39" />मी मालीक बोगवान केथु, “केदी तुमू, एय इस्राएलान वोस, मारी वात होमेलने नाह होदते, एने मुरती पुजा केरने होदतेह, ते जावो, एने आप आपण्यु मुरत्युन सेवा किरो, पुण पासाण तुमू जोरूर मारी होमेलहो एने पोशा मारा चोखाला नावाह एठा नाय केर सिकहो। <verse eid="EZK 20:39" /><verse number="40" style="v" sid="EZK 20:40" />काहाकाय बोगवान यहोवान ज्य वचन हे, काय इस्राएलान आखो गेराणो तान देसाम, मारा चोखाला बोयड़ा पोर, इस्राएलान उचाला बोयड़ा पोर, आखा माणहे मारी बोक्ती केरी; एने मी ताहरी तुमरी बोक्ती सेवा, एने हाजाली बेटीन वोस्तु, तुमरा बोलीदान हेऱ्योच स्वीकार केरूह। <verse eid="EZK 20:40" /><verse number="41" style="v" sid="EZK 20:41" />जेवी मी तुमूह देस देसान माणहाम रेन आंगे केरूह, एने ता देसाम रेन जाहरी रेन तुमू खोवलाय रेनाह, मी ताहरी तुमूह टुलो केरूह, तेवी मी तुमूह हाजी गेंदीन दुणीन रूप माय स्वीकार केरूह, एने मी देसा देसान माणहाम नेजरीम तुमरी उगे रेन चोखालो ठेराय जाह। <verse eid="EZK 20:41" /><verse number="42" style="v" sid="EZK 20:42" />जेवी मी तुमूह इस्राएल देसाम लावुह, जाह आपणेन वायदो मी तुमरा डायडाया हिऱ्यो किरेल इतो, तेवी तुमू जाणहो काय मी तुमरो मालीक यहोवा हे। <verse eid="EZK 20:42" /><verse number="43" style="v" sid="EZK 20:43" />ताहरी तुमू पासाणल्यो चालचलन एने ता सोब कामाह एर किरहो, जा तुमू केरीन सोताह एठा किरेल हेते, तेवी तुमू सोता पाचतावो किरहो काय आमु ओहला खाराब कामे किरेल एता। <verse eid="EZK 20:43" /><verse number="44" style="v" sid="EZK 20:44" />एय इस्राएल गेराणान माणहे, तुमू जुलूम खाराब कामे केऱ्या, एने मी तुमूह तुमरा खाराब कामान कारेण खेतेम केर देणो जोवतालो, पुण मारा गीणाता नावा बोदेल मी ओहलो नाय केरू, तेवी तुमू जाण लिहो काय मीच बोगवान हे।” मालीक यहोवान ज्यो बोल हे।<verse eid="EZK 20:44" /></para>
  <para style="s">देक्षिण माय आक्‍ठो</para>
  <para style="p">
    <verse number="45" style="v" sid="EZK 20:45" />तेवी बोगवानान ज्य वचन मार फाय पोचनो; <verse eid="EZK 20:45" /><verse number="46" style="v" sid="EZK 20:46" />“एय माणहान सोरा, तारो मुय देक्षिण उगे केर, एने दक्षिणान विरूद पारचार केर, एने देक्षिण देसान उजाड़ बुयीन विरूद जाणाव केर। <verse eid="EZK 20:46" /><verse number="47" style="v" sid="EZK 20:47" />एने देक्षिण देसान जेंगलाह के; बोगवानान ज्य वचन होमेल, मालीक बोगवान इही किथे, मी तार माय आक्‍ठो हेलगाड़न्यो हे, जो तारा निल्‍ला एने हुकेल सोब जाड़ाह हेलगाड़ीन खेतेम केर देय, तान आस केदी नाय ओलाय, केरीन देक्षिण रेन उत्तर वोर आखो देस आक्ठाम हेलगी जाय। <verse eid="EZK 20:47" /><verse number="48" style="v" sid="EZK 20:48" />तेवी आखा माणहे जाण लेती काय ज्य आक्‍ठो मालीक यहोवा लागाड़ेल हे; एने तो केदी नाय ओलाय।”<verse eid="EZK 20:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="EZK 20:49" />तेवी मी केयो, “हाय बोगवान यहोवा! ता माणहे ते मार बाराम केती काय मी ताह वार्ता केणे बाज रिनोह।”<verse eid="EZK 20:49" /></para>
  <chapter eid="EZK 20" />
  <chapter number="21" style="c" sid="EZK 21" />
  <para style="s">बोगवानान नियावान तालवार</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 21:1" />बोगवानान ज्य वचन मार फाय पोचनो, <verse eid="EZK 21:1" /><verse number="2" style="v" sid="EZK 21:2" />एय माणहान सोरा तारो मुय यरूशलेम उगे केर एने चोखाला जागान विरूद पारचार केर, एने इस्राएल देसान विरूद जाणाव केर। <verse eid="EZK 21:2" /><verse number="3" style="v" sid="EZK 21:3" />मालीक बोगवान किथे, देख, मी तार विरूद हे, एने मारी तालवार म्यान माय रेन खेचीन तार माय रेणार देरमी एने पापी दुयूह खेतेम केरूह। <verse eid="EZK 21:3" /><verse number="4" style="v" sid="EZK 21:4" />काहाकाय मी देरमी एने पापी दुयाह मार टाकण्यो हे, केरीन मारी तालवार म्यान माय रेन निकलीन देक्षिण लागती उत्तर वोर आखा माणहान विरूद उठी। <verse eid="EZK 21:4" /><verse number="5" style="v" sid="EZK 21:5" />तेवी आखा माणहे जाण लेती काय बोगवान म्यान माय रेन तान तालवार बाहेर काड़ेल हे; एने ती पोशी म्यान माय नाय मेलाय जाय।<verse eid="EZK 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 21:6" />केरीन एय माणहान सोरा, तु काह! इस्राएलान माणहान सामने जुलूम पासतावो केरीन नाराज एन तान सामने काह। <verse eid="EZK 21:6" /><verse number="7" style="v" sid="EZK 21:7" />जेवी ता तुवाह फुसे, काय काहा काहेह? ते किज्ये, “ती खोबरीन केरता, काहाकाय ओहली गेटना एणी हे काय आखान मोन टुट जाती एने आखान आथे डिला पोड़ती, आखान जीव दुखी एने आखा मांडा कोमजोर एय जाती, दिखो, ओहली गेटना एणी हे, एने ती जोरूर पुरी एय।” बोगवानान ज्य वचन हे।<verse eid="EZK 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 21:8" />पोशो बोगवानान वचन मार फाय पोचनो,<verse eid="EZK 21:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 21:9" />“एय माणहान सोरा, जाणाव केरीन के, बोगवान यहोवा इही किथे,</para>
  <para style="q1" vid="EZK 21:9">देख, जेजेलन्यी तालवार एने दाराल्ली तालवार।<verse eid="EZK 21:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="EZK 21:10" />ती ज्यान केरता गेड़ाय गियी काय ती केरीन माराय जाय,</para>
  <para style="q2" vid="EZK 21:10">केरीन दाराल्ली केराय गियी काय विजलीन गेत चोमके! ते काय आपु खुस इज्यो?</para>
  <para style="q1" vid="EZK 21:10">तो ते बोगवानान</para>
  <para style="q2" vid="EZK 21:10">सोरान राजदन्ड हे एने आखा जाड़ाह नेचा सोमजेह।<verse eid="EZK 21:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="EZK 21:11" />केरीन तालवारीह चोमकाड़ाय गियी,</para>
  <para style="q2" vid="EZK 21:11">काय ती आथाम देराय सिके, मारनारान आथाम आपणेन केरता</para>
  <para style="q1" vid="EZK 21:11">तीह दाराल्ली केराय गियी; एने चोमकाड़ाय गियी।<verse eid="EZK 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZK 21:12" />एय माणहान सोरा,</para>
  <para style="q2" vid="EZK 21:12">आयेड़, एने हाय, हाय केर! काहाकाय ती तालवार मारी पोरजा पोर चाली,</para>
  <para style="q2" vid="EZK 21:12">एने ती इस्राएलान आखा मुखी पोर चाली;</para>
  <para style="q1" vid="EZK 21:12">मारी पोरजा हेऱ्या ता बी तालवारीन ताबाम आव लागा,</para>
  <para style="q1" vid="EZK 21:12">केरीन तु साती ठोकीन रेड़।<verse eid="EZK 21:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="EZK 21:13" />काहाकाय खेरीच तान पारेख इयेल हे,</para>
  <para style="q2" vid="EZK 21:13">एने केदी तीह कोम जाणनार राजदन्ड बी नाय रेय,</para>
  <para style="q2" vid="EZK 21:13">ते काय एय? बोगवान यहोवान ज्यो बोल हे।”<verse eid="EZK 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 21:14" />“केरीन एय माणहान सोरा, जाणाव केर, एने थापड्या वाजाड़ी वाजाड़ीन तालवारीन वार दुय नाह तीन वार एणे दे। ज्यी तालवार तान केरता हे जान खुन एण्यो हे, ज्यी मारनेन तालवार हे, जा मोटकी माय लिकाईन बोह रेनाह, ता बी तीन मार से वोच नाह सेकते। <verse eid="EZK 21:14" /><verse number="15" style="v" sid="EZK 21:15" />मी मारनी तालवार तान सोब फाटक्युन विरूद चालाड़ेल हे काय माणहान मोन टुट जाय, एने ता जुलूम ठोकरा खाय, हाय! हाय! ती ते विजलीन गेत बाणावाय गियी, एने मारनेन केरता तीह चोमकाड़ेल हे। <verse eid="EZK 21:15" /><verse number="16" style="v" sid="EZK 21:16" />एय तालवार, तारी डाखरी उगे काट, तेवी तीन जिवड़ी उगे, जाहरी बी तारी दार वोलेह, ताहरी काट <verse eid="EZK 21:16" /><verse number="17" style="v" sid="EZK 21:17" />मी बी थापड्या वाजाडुह एने मारो राग ओलाडुह ज्य मी यहोवा केथु।”<verse eid="EZK 21:17" /></para>
  <para style="s">बाबिलोन ने राजान तालवार</para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 21:18" />पोशो बोगवानान ज्य वचन मार फाय पोचनो, <verse eid="EZK 21:18" /><verse number="19" style="v" sid="EZK 21:19" />“एय माणहान सोरा, दुय वाट ठेराव ले काय बाबिलोन ने राजान तालवार आवी; दुय वाट एकुच देसाम निकले, ओवतो एक निसाणी केर, मतलब हेयराम पोचणार सेड़की पोर एक निसाणी बाणाव। <verse eid="EZK 21:19" /><verse number="20" style="v" sid="EZK 21:20" />एक वाट ठेराव काय तालवार अम्मोनीन रब्बा हेयरा पोर, एने यहुदा देसान किल्‍ला वालो हियोर यरूशलेम पोर बी चाले। <verse eid="EZK 21:20" /><verse number="21" style="v" sid="EZK 21:21" />काहाकाय बाबेलान राजा ज्यु दुय वाटीन चोक मतलब वाट निकेलनेन जागा पोर हुगोण देखणेन केरता उब रिनोह; तो बेलखाह आलाड़ दिनो, एने गेरान देवताह सावाल फुसेह; तो कालजाह दिखेह। <verse eid="EZK 21:21" /><verse number="22" style="v" sid="EZK 21:22" />तान डाखऱ्या आथाम यरूशलेमान नावा पोर चिट्ठी निकलेल हे, तो गीलो काड़ीन आयड़ेह, तो जुलूम जोरे उकुम आपेह काय रिगणेन बायणा पोर लेड़ायीन आथ्यारे मिलो, एने देगड़ान कोट बाणावो किथे। <verse eid="EZK 21:22" /><verse number="23" style="v" sid="EZK 21:23" />पुण यरूशलेमान माणहाह ज्यो हुगोण जुठो लागेह, ता सुगोण खायेल हेते; केरीन तो तान पापान एर केरावीन ताह देर लेय। <verse eid="EZK 21:23" /><verse number="24" style="v" sid="EZK 21:24" />केरीन मालीक बोगवान इही किथे, ज्यानकेरता काय तुमरा पापे तुमूह एर आवो, एने तुमरा पापे देखाय गीया, तुमरा पाप देखाना; काहाकाय तुमरा आखा कामाम पापुच पाप देखायेल हे, केरीन तुमू ताच माय देराय जाहो।”<verse eid="EZK 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 21:25" />“एय इस्राएलान पापी मुखी, तारा पापान देन्ड आपणेन टेम आहने आव लागेल हे। <verse eid="EZK 21:25" /><verse number="26" style="v" sid="EZK 21:26" />बोगवान यहोवा तार बाराम इही किथे, तारा मुंडा पोर रेन मुकूट एने पागड़ी बी उतार दे; तु पेल हारको आदिकारी नाह रिनो, जा नेचा हेते ताह उचा केर; एने जा उचा हेते, ताह नेचा केर। <verse eid="EZK 21:26" /><verse number="27" style="v" sid="EZK 21:27" />मी ज्या हेयराह खेतेम केर देह, पुण ज्य ताह वोर नाय एय, जाह वोर लायकीन नोवालो राजा नाह आवीत; ताह वोर मी ज्याह बाबेलान राजाह हेयरा पोर आदिकार केरने देह।”<verse eid="EZK 21:27" /></para>
  <para style="s">अम्मोनियोन विरूद तालवार</para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 21:28" />“एय माणहान सोरा, मालीक बोगवान अम्मोनीन माणहान बाराम इही किथे; काहाकाय ता मालक्यान चिहटा किरेल एता,”</para>
  <para style="q1" vid="EZK 21:28">नास केरनार गेड़ायेल तालवार म्यान माय रेन बाहेर निकेलनी</para>
  <para style="q1" vid="EZK 21:28">ती जुलूम चोमेकताली, ती विजलीन गेत चोमेकताली।<verse eid="EZK 21:28" /></para>
  <para style="m">
    <verse number="29" style="v" sid="EZK 21:29" />जाह वोर काय ता तार बाराम जुठा देरसेन देखतेह, एने जुठ्यु वातु तुवाह केतेह। एय तालवार, तु ता मोटला खाराब काम केरनारान गेला पोर चाल! तान सेवोट आव जायेल हे, तान सेवल्यो देन्ड ने टेम आव लागेल हे।<verse eid="EZK 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 21:30" />एवी तु म्यान माय फिरीन आव, जा जागाम तु बाणावाय गियी एने जा देसाम तारी बाणावोट एनी, ताच माय तारो न्यायनिवाड़ो केरूह। <verse eid="EZK 21:30" /><verse number="31" style="v" sid="EZK 21:31" />एने मी तार पोर मारो राग बोड़कावुह एने तार पोर मारी हेलेगणार आक्‍ठो हेलगाड़ देह; एने तुवाह जेनवेरान गेत माणहान आथाम केर देह, जा खेतेम केरनेम उशार हेते। <verse eid="EZK 21:31" /><verse number="32" style="v" sid="EZK 21:32" />तु आक्‍ठान केरता लाकोड़ बोणहे; तारो खुन देसाम वोयाड़ाय जाय, एने तुवाह कुण एर नाय केरी। काहाकाय मी बोगवानान ज्यो बोल हे।<verse eid="EZK 21:32" /></para>
  <chapter eid="EZK 21" />
  <chapter number="22" style="c" sid="EZK 22" />
  <para style="s">यरूशलेम ने गुनान नियाव</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 22:1" />एने बोगवानान ज्य वचन मार फाय पोचनो, <verse eid="EZK 22:1" /><verse number="2" style="v" sid="EZK 22:2" />“एय माणहान सोरा, काय तु ता खुनी हेयरान न्यायनिवाड़ो किरहे? ताह तान खाराब काम केय दे, <verse eid="EZK 22:2" /><verse number="3" style="v" sid="EZK 22:3" />एने के, बोगवान यहोवा इही किथे, एय हियोर तु तार विचीम खुन किरेह जा माय तारी टेम आवी, एने तारो नुकसान केरने एने एठो एणेन केरता मुरता बाणावीह। <verse eid="EZK 22:3" /><verse number="4" style="v" sid="EZK 22:4" />जा खुन तु किरेल हे, तु गुनेगार ठेरानी, एने जा मुरता तु बाणायेल हे, तान कारेण तु एठी एय जायेल हे; तु तारा सेवल्या दिह्याह आहने केर लेदी, एने तारा पासाणल्या वोरह्या वोर पोच गियी, केरीन मी तुवाह जाती जातीन नावदारीन एने सोब देसान आहतायीन कारेण केर दियेल हे। <verse eid="EZK 22:4" /><verse number="5" style="v" sid="EZK 22:5" />एय, बदनाम हियोर! एय गेगदा माय बोरायेल हियोर! जो देस तारी आहने हे, एने जा देस तुवाह रेन सेटा हेते, ता सोब तारी मोजाक उड़ावती। <verse eid="EZK 22:5" /><verse number="6" style="v" sid="EZK 22:6" />देख, इस्राएलान मुखी माणहे जिव जिवान ताकतीन गेत तार माय खुन केरनारे बुणेल हेते। <verse eid="EZK 22:6" /><verse number="7" style="v" sid="EZK 22:7" /><note caller="+" style="x"><char style="xo" closed="false">22:7 </char><char style="xt" closed="false"><ref loc="EXO 20:12">निर्गमन 20:12</ref>; <ref loc="EXO 22:21">22:21</ref>; <ref loc="DEU 5:16">व्यवस्था 5:16</ref>; <ref loc="DEU 24:17">24:17</ref></char></note> तार माय आहख आबोख खाराब सोमजाय गीया; तार विचीम दिहरा देसावाला पोर अत्याचार इथे, एने विखावाला एने रांडायेल बायकु तार माय देलाय जायेल हेत्यु। <verse eid="EZK 22:7" /><verse number="8" style="v" sid="EZK 22:8" />तु मारी चोखाली वोस्तुह खाराब जाण्यो, एने मारा विहेवणेन दिह्याह एठो किरेल हे। <verse eid="EZK 22:8" /><verse number="9" style="v" sid="EZK 22:9" />तार माय लुच्चा माणहे खुन केरनेन तियार एना, एने तारा माणहे बोयड़ा पोर खाणो खायेल हेते; तारा विचीम मोटला पाप केराय जायेल हे। <verse eid="EZK 22:9" /><verse number="10" style="v" sid="EZK 22:10" /><note caller="+" style="x"><char style="xo" closed="false">22:10 </char><char style="xt" closed="false"><ref loc="LEV 18:7-20">लेव्यवस्था 18:7-20</ref></char></note>तार माय आबाख ने बायकु हेऱ्या सिनालो केरतेह, एने तार मार फाड़को आयेल बायकु हेऱ्या सिनालो केराय जायेल हे। <verse eid="EZK 22:10" /><verse number="11" style="v" sid="EZK 22:11" />एगदो तार माय आहने रेणार बायकु हेऱ्यो खाराब काम केऱ्यो; एने एगदो तान वोवड़ीख बिगाड़ीन मोटलो पाप किरेल हे, एने एगदो तान खाज बोणीख एठी किरेल हे। <verse eid="EZK 22:11" /><verse number="12" style="v" sid="EZK 22:12" />तार माय ओहला माणहे हेते, जा ता खाराब काम केरीन पोयशा कामावतेह, जा वियाज लेतेह एने गेरब्याह लुटतेह, एने आहने रेणाराह जोर केरीन सांडाड़ीन लुटणेन कामाय केरतेह, एने ता विहरी जातेह, ज्यो बोगवान यहोवान बोल हे।”<verse eid="EZK 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 22:13" />“तुमू लुच्‍चाय केरीन जी कामाय किरेल हेते एने तुमू तुमरी विचीम जो लुय वोयाड़ेल हे, ता पोर मी मारा दुयू आथ एक्ठाच उठावुह। <verse eid="EZK 22:13" /><verse number="14" style="v" sid="EZK 22:14" />ते दिह काय तुमरे माय ईमोत रेय, नाहते तुमरा आथ मोजबुत रेती; जुलबुखे मी तुमू फाय लेखो लेह? मी यहोवा कियेल हे एने मी ज्य केरीच ने रेह। <verse eid="EZK 22:14" /><verse number="15" style="v" sid="EZK 22:15" />मी तुमूह राज्य राज ने माणहान विचीम पुरी रिती से खोवली देह एने बाती बातीन देसाम पोसराव देह; एने मी तुमरी एठायीह खेतेम केर देह। <verse eid="EZK 22:15" /><verse number="16" style="v" sid="EZK 22:16" />जुलबुखे तुमू राज्या राज ने माणहान नेजरीम एठा एय जाहो, तुमू जाणहो काय मी यहोवा हे।”<verse eid="EZK 22:16" /></para>
  <para style="s">बोगवानान राग</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 22:17" />तेवी बोगवानान ज्य वचन मार फाय पोचनो, <verse eid="EZK 22:17" /><verse number="18" style="v" sid="EZK 22:18" />“एय माणहान सोरा, इस्राएलान माणहे मार केरता सिकल्यो बोण जायेल हेते, ता सोब बाठी माय टाकायेल तांबो, पितेल, चांदी, सिसो एने लोड़ा हेते, ता पोर सिकल्यो जोम जायेल हे। <verse eid="EZK 22:18" /><verse number="19" style="v" sid="EZK 22:19" />केरीन बोगवान यहोवा इही किथे, काहाकाय तुमू सोब सिकल्यो बोण जायेल हेते, केरीन मी तुमूह यरूशलेम माय टुलो केरूह। <verse eid="EZK 22:19" /><verse number="20" style="v" sid="EZK 22:20" />जीह केरीन होनार चांदी, पितेल, लोड़ो, एने जेरमेन, सिसान टुकड़ा बाठी माय टुलो केरीन देदेकताली आक्ठीम पिगालाय जाथे; तिहेच केरीन मी तुमूह मारो राग केरीन टुलो केरूह एने तुमूह हेयरा माय टाकीन पिगलाडुह। <verse eid="EZK 22:20" /><verse number="21" style="v" sid="EZK 22:21" />मी तुमूह टुलो केरूह एने तुमू पोर मारा मोटला रागाम आवीन फुकूह, एने तुमू हेयराम पिगली जाहो। <verse eid="EZK 22:21" /><verse number="22" style="v" sid="EZK 22:22" />जीह केरीन चांदी बाठा माय पिगली जाथे, तिहेच केरीन तुमू ता माय पिगली जाहो, एने तेवी तुमू जाणहो काय मी यहोवा तुमू पोर मारो राग बोड़कायेल हे।”<verse eid="EZK 22:22" /></para>
  <para style="s">इस्राएलान मुखीन पाप</para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 22:23" />बोगवान यहोवान ज्य वचन पोशो मार फाय पोचनो, <verse eid="EZK 22:23" /><verse number="24" style="v" sid="EZK 22:24" />“एय माणहान सोरा, यरूशलेमाह इही के, तु एक ओहलो देस हे, जो चोखो नाह इनो नाहते जा पोर रागान दिह पाणी नाह पुड़ेल सुतो। <verse eid="EZK 22:24" /><verse number="25" style="v" sid="EZK 22:25" />जीह केरीन सिंहो तान सिकाराह वेसड़ी दिथे, तिहेच केरीन यरूशलेमान मुखीन, एक हुमच्यो हे; ता माणहाह मार टाकतेह, एने तान मालदेन एने मोंगाल्यु वोस्तुह राख लेतेह; एने यरूशलेम माय जुलूम वाराड़ावाल्यु बायकुह रांडायेल बाणाव देतेह। <verse eid="EZK 22:25" /><verse number="26" style="v" sid="EZK 22:26" />एने ता देसान चाकऱ्या मारो कायदो तोड़तेह एने मारी चोखाली वोस्तुह एठा केरतेह; ता चोखाल्यु एने साद्यु वोस्तुन विचीम काय फारेक नाह केरते; ता हिकाड़तेह काय चोखो एने एठा माय काय फारेक नाय मिले; ता मारा विहेवणेन दिह्याह माणनेन ओग्या पोशा एतेह, केरीन मी तान विचीम एठो सोमजाय जायेल हे। <verse eid="EZK 22:26" /><verse number="27" style="v" sid="EZK 22:27" />एने ता मायवाला मुखी तान सिकाराह वेसड़ी खाणार कोलवान गेत हेते; ता लुच्चायीन फायदान केरता लुय वोयाड़तेह एने खुन केरतेह। <verse eid="EZK 22:27" /><verse number="28" style="v" sid="EZK 22:28" />तान जाणकार जुठा देरसेन एने हुगोणा केरीन तान केरता ज्या कामा पोर निप्या थाब्या केरतेह, ता केतेह, बोगवान यहोवान ज्य केणो हे, पुण मी ताह काय केतुच नाह। <verse eid="EZK 22:28" /><verse number="29" style="v" sid="EZK 22:29" />देसान माणहे जोर केरीन सांडाड़तेह एने डाको टाकतेह; ता गेरीब एने गिरेजवाला माणहाह ठेगीन खातेह एने पाराया देसान माणहा बी ठेन खायीन ता हेऱ्या खाराब वेवारो केरतेह। <verse eid="EZK 22:29" /><verse number="30" style="v" sid="EZK 22:30" />मी तान विचीम ओहला माणहाह होदणे बाज रियेल इतो, जो, बितड़ो बाणावी एने ता देसान उगे रेन डोसाम मार सामने उबरेय, काय मी ताह खेतेम नाय केरू, पुण माहु ओहलो काल्लो बी माणुह नाह जुड़नो। <verse eid="EZK 22:30" /><verse number="31" style="v" sid="EZK 22:31" />केरीन मी ता पोर मारो राग टाकुह एने जुलूम रागाम हेलगाड़ीन खेतेम केर देह, एने तान सोब केराय जायेल काम ताच ने मुंडा पोर टाक देह।” बोगवान यहोवान ज्यो बोल हे।<verse eid="EZK 22:31" /></para>
  <chapter eid="EZK 22" />
  <chapter number="23" style="c" sid="EZK 23" />
  <para style="s">दुय सिनाल्यु बोण्युख</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 23:1" />बोगवानान ज्य वचन मार फाय पोचनो, <verse eid="EZK 23:1" /><verse number="2" style="v" sid="EZK 23:2" />“एय माणहान सोरा, दुय बायकु एत्यु, ज्यु एकुच आईख ने बेट्युख एत्यु। <verse eid="EZK 23:2" /><verse number="3" style="v" sid="EZK 23:3" />त्यु आत्युच ने वेश्यान काम मिस्र देसाम केरने बाज गीयु; त्युन सात्यु, कुवार पोणाम पेलुच ने दाबाय गीयु। त्युन कुवारला पेटा पोर आथ टाकाना। <verse eid="EZK 23:3" /><verse number="4" style="v" sid="EZK 23:4" />त्यु सोऱ्युम रेन मोटलीन नाव ओहोला एने तीन बोणीख ने नाव ओहोलीबा एतो। ती मारी बोण गियी, त्युन सोरा सोऱ्यु पायदा एन्यु, त्युन नावा माय रेन ओहोला ते शोमरोन, एने ओहोलीबा यरूशलेम हे। <verse eid="EZK 23:4" /><verse number="5" style="v" sid="EZK 23:5" />ओहोलीबा जेवी मारी एती, तेवीच सिनाली बोणीन तीन हाती पोर मोन लागाड़ ने बाज गियी जा आहने वाला अश्शुरी बाहदुर एता। <verse eid="EZK 23:5" /><verse number="6" style="v" sid="EZK 23:6" />राज्यपाल एने सेनापती एता, ज्या सोब ने सोब होबाता जुवान एता, एने गोड़ा पोर बोहीन फिरताला। <verse eid="EZK 23:6" /><verse number="7" style="v" sid="EZK 23:7" />ते ती ताच हेरी सिनालो केरी जा आखाम रेन हाजा अश्शुरी एता; एने जा कुणी पोर मोनवाय गियी, एने तान मुरत्यु केरीन सोताह एठी केर लेदी। <verse eid="EZK 23:7" /><verse number="8" style="v" sid="EZK 23:8" />जो सिनालो ती मिस्र देसाम हिकेल एती, ताह बी ती नाह सोड़ी; काहाकाय सोरा पोणाम माणहे ती हेऱ्या खाराब कामे केऱ्या, एने तीन सात्यु पोर आथ टाक्या, एने मोन लागाड़ीन ती हेऱ्या सिनालो किरेल एता। <verse eid="EZK 23:8" /><verse number="9" style="v" sid="EZK 23:9" />केरीन मी तीह ताच अश्शुरी हातीन आथाम केर दिनो, जा पोर ती मोनवाय जायेल एती। <verse eid="EZK 23:9" /><verse number="10" style="v" sid="EZK 23:10" />ता तीह उगाड़ली केऱ्या; तीन सोरा सोऱ्युह सांडाड़ीन ताह तालवारी केरीन माऱ्या; इह केरीन तान आथा केरीन देन्ड सापड़ावीन ती बायकु माय गाज गियी।”<verse eid="EZK 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 23:11" />“तीन बोणीख ओहोलीबा ज्य देखी, तीबी ती मोनवाएन सिनालो केरनेम तीन बोणीख रेन बी वोदार एय गीयी। <verse eid="EZK 23:11" /><verse number="12" style="v" sid="EZK 23:12" />ती तीन अश्शुरी आहने रेणारा पोर मोनवाताली, आखान आखा जुलूम हाजा फाड़का पेरनारे एने गोड़ा दोवड़ावणारे जुलूम हाजा, जुवान मुखी एने आखी बातीन मुखी एता। <verse eid="EZK 23:12" /><verse number="13" style="v" sid="EZK 23:13" />तेवी मी दिख्यो काय ती बी एठी एय जायेल हे; त्यु दुयू बोणह्युख ने एक सोबाव इतो।”<verse eid="EZK 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 23:14" />“पुण ओहोलीबा वोदार सिनालो किरते गीयी; ते जेवी ती बितड़ा पोर एदम्यान चित्रो देखी, जा माय बाबिलोन ने रातला रेंगाम बाणायेल एता। <verse eid="EZK 23:14" /><verse number="15" style="v" sid="EZK 23:15" />एदम्यान कोमराम पुट्टो बांदेल इतो एने तान मुंडी पोर आलताली पागड़ी एती; ता सोब चित्रा बाबिलोन माय रेणारान एता, जा करात देसान आदिकारीन गेत लागताला। <verse eid="EZK 23:15" /><verse number="16" style="v" sid="EZK 23:16" />ओहोलीबा ताह देखी, एने ती ता पोर मोनवाय गीयी, ती बाबिलोन देसाम तीन खोबर्‍याह मोकली। <verse eid="EZK 23:16" /><verse number="17" style="v" sid="EZK 23:17" />एने बाबिलोन वाला माणहे ती फाय खाटला पोर आवा, एने ती हेऱ्या सिनालो केरीन तीह एठी केऱ्या; एने जेवी ती एठी एय गियी, तेवी तान मोन तीन उगे रेन सेटो एय गीयो। <verse eid="EZK 23:17" /><verse number="18" style="v" sid="EZK 23:18" />तीबी जेवी ती डिल उगाड़ताली एने सिनालो किरते गियी, तेवी मारो मोन तीन बोणीख ने उगे रेन सेटो एय जायेल एतो, तिहेच केरीन तीन उगे रेन बी सेटो एय गीयो। <verse eid="EZK 23:18" /><verse number="19" style="v" sid="EZK 23:19" />तीबी ती दाड़ीन सिनालो किरते रेनी, ती तीन मिस्र देसान सोरा पोणान दिह्याह एर केरीन वेशान काम केरताली, एने वोदार सिनालो किरते गीयी; <verse eid="EZK 23:19" /><verse number="20" style="v" sid="EZK 23:20" />ताहरी ती ओहला जोड़ीदारा पोर मोनवानी, जान माह गेदड़ान गेत, एने उमेरपाणी गोड़ा हारको एतो।” <verse eid="EZK 23:20" /><verse number="21" style="v" sid="EZK 23:21" />तु इह केरीन सोरा पोणान टेमान, ता मोटला पापाह एर केरावेह; जेवी मिस्री माणहे तारी सात्युह दाबताला।<verse eid="EZK 23:21" /></para>
  <para style="s">आतली बोणीख बोगवाना उगे रेन देन्ड</para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 23:22" />केरीन एय ओहोलीबा, बोगवान यहोवा तुवाह इही किथे, “देख मी तारा जोड़ीदाराह तार विरूद बोड़कावुह, जाह तु नफरत किरते लेन सेटी एय जायेल एती, एने मी ताह चार चोमखेर रेन तार विरूद लावुह। <verse eid="EZK 23:22" /><verse number="23" style="v" sid="EZK 23:23" />मतलब बाबेलोनी एने सोब कसदी, एने पेकोद, शोआ एने कोआन एदमी, एने ता हेऱ्या सोब अश्शुरी, जुवान्याह तार विरूद लावुह, ता माय सोबान राज्यपाल एने सेनापती, आदिकारी एने मुखी माणहे, आखान गोड़ा पोर बोहणारे हेते। <verse eid="EZK 23:23" /><verse number="24" style="v" sid="EZK 23:24" />माणहे आथ्‍यार, टांगा, वाहेन एने देस देसान माणहान टोल्यु लेन तार पोर चेड़ाय केरती; ढाल एने टोपा पेरीन तार विरूद कावदेन पालथी बांदती; एने मी तान आथाम न्यायनिवाड़ान काम होपुह, एने ता तान नेमान गेत तारो न्यायनिवाड़ो केरती। <verse eid="EZK 23:24" /><verse number="25" style="v" sid="EZK 23:25" />एने मी तार पोर मारो राग देखाडुह, एने तुमरी बोदेल तान वेवारो जुलूम रागाम रेय, ता तुमरा नाक एने कान काट टाकती, एने तुमरे माय जा वोच जाती, ता तालवारी केरीन माराय जाती; ता तुमरा बेटा एने बेट्युख राख लेती, एने तुमरे माय जा वोच जाती, ता आक्ठाम हेलगीन खेतेम एय जाती। <verse eid="EZK 23:25" /><verse number="26" style="v" sid="EZK 23:26" />ता तारा फाड़का बी काड़ लेती, एने हाज हाजा गेयणो सांडाड़ लेती। <verse eid="EZK 23:26" /><verse number="27" style="v" sid="EZK 23:27" />इह केरीन मी तारो मुटलो पाप एने वेश्यान काम तु मिस्र देसाम हिकेल एती, तुवाह ता माय रेन बी सोड़वुह, ओलोक काय तु पोशी तारा डोला तान उगे नाय लागाड़हे एने मिस्र देसाह पोशी एर नाय किरहे।”<verse eid="EZK 23:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 23:28" />काहाकाय बोगवान यहोवा तुवाह इही किथे, “देख, मी तुवाह तान आथाम होप देह, जा पोर तु दुसमोनाय मिलेह, एने जा से तारो मोन सेटो एय जायेल हे। <verse eid="EZK 23:28" /><verse number="29" style="v" sid="EZK 23:29" />एने ता तार हेऱ्या दुसमोनायीन वेवारो केरती, एने तारी आखी कामायीह विस लेती, एने तुवाह उगाड़ली सोड़ देती, एने तारा डिल उगड़ी जाय ता माय तारो सिनालो एने मुटलो पाप देखाय जाय।”<verse eid="EZK 23:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 23:30" />ज्य सोब तार पोर एनो, काहाकाय तु देस देसान माणहान पासाण वेश्यान गेत पोड़ गियी, एने तान मुरत्युह पुजीन तु सोताह एठी किरेल हे। <verse eid="EZK 23:30" /><verse number="31" style="v" sid="EZK 23:31" />तु तारी बोणीख ने वाटी पोर चालेल हे; केरीन मी तीन वाटको तारा आथाम केर देह।<verse eid="EZK 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 23:32" />बोगवान यहोवान ज्य केणो हे,</para>
  <para style="q1" vid="EZK 23:32">“तुवाह तारी बोणीख ने वाटका माय पिणे पोड़ी,</para>
  <para style="q1" vid="EZK 23:32">जो मुठो एने उंडालो हे;</para>
  <para style="q1" vid="EZK 23:32">केरीन तु आहणेन एने चिहटान कारेण बुणहे,</para>
  <para style="q2" vid="EZK 23:32">काहाकाय ता माय जुलूम होवटो होमाथे।<verse eid="EZK 23:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="EZK 23:33" />तु साकवाली एने दुखाम बोराय जाहे,</para>
  <para style="q2" vid="EZK 23:33">ज्य खेतेम एने उजाड़ एणेन वाटको हे,</para>
  <para style="q2" vid="EZK 23:33">ज्यो तारी बोणीख सामरीयान वाटको हे।<verse eid="EZK 23:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="EZK 23:34" />तु ज्याह पिन ठाल्लो केर दिहे,</para>
  <para style="q2" vid="EZK 23:34">एने ज्यान तुकड़ाह चावहे</para>
  <para style="q2" vid="EZK 23:34">एने ताऱ्यु सात्युह जेखमी किरहे, ज्य बोगवान यहोवान बोल हे।”<verse eid="EZK 23:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 23:35" />“तु जो माहु विहराव दियेल हे, एने तारो मुय मार हेऱ्यो रेन फिराव लियेल हे, केरीन तु सोताच तारा मोटला पाप एने सिनालान बार विस।” बोगवान यहोवान ज्य वचन हे।<verse eid="EZK 23:35" /></para>
  <para style="s">दुयू बोण्युख बोगवाना उगे रेन देन्ड</para>
  <para style="p">
    <verse number="36" style="v" sid="EZK 23:36" />बोगवान माहु केयो, “एय माणहान सोरा, काय तु ओहोला एने ओहोलीबान न्यायनिवाड़ो किरहे? ते ओवतो त्युन खाराब काम त्युह केय दे। <verse eid="EZK 23:36" /><verse number="37" style="v" sid="EZK 23:37" />काहाकाय त्यु सिनालो किरेल हेत्यु, एने त्युन आथाम खुन चोपड़ाय रेनोह; ता तान मुरत्यु हेऱ्या सिनालो केऱ्या, एने तान सोरा पोऱ्या जा पायदा इयेल एता, ता मुरतान ओंगाण खेतेम एणेन केरता चेड़ायेल हेते। <verse eid="EZK 23:37" /><verse number="38" style="v" sid="EZK 23:38" />ओवता ता मार हेऱ्या ओहलो वेवारो केऱ्या काय ताच हेऱ्या मारा चोखाला जागाह बी एठो केऱ्या एने मारा विहेवणेन दिह्याह एठो किरेल हेते। <verse eid="EZK 23:38" /><verse number="39" style="v" sid="EZK 23:39" />जे दिह ता तान सोरा पोऱ्याह तान मुरतान सामने बोली चेड़ावीन, ते दिहच मारा चोखाला जागाम रिगना एने ताह एठो केऱ्या, ता मारा मोंदिर माय ज्योच किरेल हेते।”<verse eid="EZK 23:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="EZK 23:40" />“उंजु पोशा ता खोबऱ्या मोकलीन जुलूम सिटे रेन माणहाह हादाड्या, एने जेवी ता आव लागा, ते तुमू तान केरता तुमरा उंगलेल पांगलेल, डोलान हिंगार केऱ्या एने तुमरा गेयणाह पेऱ्या। <verse eid="EZK 23:40" /><verse number="41" style="v" sid="EZK 23:41" />तेवी तु एक हाजाला सोफा पोर बोह गियी, जान सामने एक पाटलो मिलेल एतो, जा पोर तु दुणी एने जेतुनान तेल मिलेल एतो, जो मारो एतो। <verse eid="EZK 23:41" /><verse number="42" style="v" sid="EZK 23:42" />तेवी ता हेऱ्या लापारवाय माणहान बिड़ीन गेगदो होमलातालो; ता सादा माणहा फाय जेंगलाम रेन हादाड़ेल दारूड्या माणहे बी एता; ता त्यु दुय बोण्युख ने आथाम बांगड्यु पेराया, एने त्युन मुंडी पोर होबाता मुकूट मेल्या। <verse eid="EZK 23:42" /><verse number="43" style="v" sid="EZK 23:43" />तेवी जी सिनालो किरते किरतेन डायी एय जायेल एती, तीन बाराम बोलने बाज गीयो, एवी ते तीच हेऱ्या सिनालो केरहु। <verse eid="EZK 23:43" /><verse number="44" style="v" sid="EZK 23:44" />काहाकाय ता ती फाय ओहला गीया जीह केरीन माणहे वेश्या फाय जातेह, तिहेच केरीन ओहोला एने ओहोलीबा नावान मोटल्यु पापी बायकु फाय गीया। <verse eid="EZK 23:44" /><verse number="45" style="v" sid="EZK 23:45" />ते देरमी माणहे सिनाल्या एने खुनीन लायकीन त्युन न्यायनिवाड़ो केरी; काहाकाय त्यु सिनाल्यु हेत्यु, एने त्युन आथाम खुन चोपड़ायेल हे।”<verse eid="EZK 23:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="EZK 23:46" />केरीन बोगवान यहोवा इही किथे, “एक मोटली गेरदीन माणहान उगे रेन ता पोर चेडाय केरावीन त्युह ओहलो केरूह काय त्यु मोऱ्यु मोऱ्यु फिरती एने लुटाय जाती। <verse eid="EZK 23:46" /><verse number="47" style="v" sid="EZK 23:47" />एने बिड़ीन माणहे त्युह देगड़ाठीन तान तालवारी केरीन काट टाकती, तेवी ता त्युन सोरा पोऱ्याह मारती, एने त्युन गेराम आक्‍ठो हेलगाड़ देती। <verse eid="EZK 23:47" /><verse number="48" style="v" sid="EZK 23:48" />इह केरीन मी मोटला पापाह देसाम रेन सिटो केरूह, एने आख्‍यु बायकु हिक सापड़ावीन तुमरी गेत मुटलो पाप केरने से वोचीन रेती। <verse eid="EZK 23:48" /><verse number="49" style="v" sid="EZK 23:49" />तुमरो मुटलो पाप तुमरी मुंडी पोड़ी; एने तुमू जोरूर तुमरा मुरती पुजान पापान बार उखेलहो; एने तुमू जाण लिहो काय मी बोगवान यहोवा हे।”<verse eid="EZK 23:49" /></para>
  <chapter eid="EZK 23" />
  <chapter number="24" style="c" sid="EZK 24" />
  <para style="s">डेसकान किस्सो</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 24:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">24:1 </char>
      <char style="xt" closed="false">
        <ref loc="2KI 25:1">2 राजा 25:1</ref>; <ref loc="JER 52:4">यिर्मया 52:4</ref></char>
    </note> नोव्वा वोरह्यान, दोहवा मोयनान दोहवे दिह, बोगवानान ज्य वचन मार फाय पोचनो, <verse eid="EZK 24:1" /><verse number="2" style="v" sid="EZK 24:2" />“एय माणहान सोरा, आजीन दिह्याह लेखीन मेल, काहाकाय आजीन दिह्याह, बाबेलान राजा यरूशलेमाह कोंडीन मिलेल हे। <verse eid="EZK 24:2" /><verse number="3" style="v" sid="EZK 24:3" />ज्या राड़कुटा गेराणाह ज्यो किस्सो के, बोगवान यहोवा इही किथे,</para>
  <para style="q1" vid="EZK 24:3">“डेचक्याह आक्‍ठा पोर मेल दिवो;</para>
  <para style="q2" vid="EZK 24:3">एने ता माय पाणी टाक दिवो।<verse eid="EZK 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 24:4" />ता माय माहान हाज हाजा बुथा टाको,</para>
  <para style="q2" vid="EZK 24:4">जांग एने खांदा हाज हाजा डेचक्या माय बोर दिवो।<verse eid="EZK 24:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 24:5" />टोला माय रेन आखाम रेन हाजा जेनवेराह लेन</para>
  <para style="q2" vid="EZK 24:5">ता आड़ाह डेचक्यान बुंदे डिग किरो,</para>
  <para style="q1" vid="EZK 24:5">एने ताह हास केरीन चुड़ावो काय माय वाला</para>
  <para style="q2" vid="EZK 24:5">आड़े बी चुड़ जाती।”<verse eid="EZK 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 24:6" />केरीन बोगवान यहोवा इही किथे, “हाय ता खुनी हेयरा पोर! हाय ता डेचक्या पोर जान माह ता माय बुणेल हे एने सुटनो नाह; ता माय रेन बुथा बुथा केरीन काड़ लिवो, ता पोर चिट्ठी नाय टाकाय जाय। <verse eid="EZK 24:6" /><verse number="7" style="v" sid="EZK 24:7" />काहाकाय ता हेयराम केरायेल खुन ता माय हे; तो ताह बुई पोर टाकीन रेजड़ा केरीन नाह डाप्यो, पुण उगाड़ला सापरा पोर मेल दिनो। <verse eid="EZK 24:7" /><verse number="8" style="v" sid="EZK 24:8" />केरीन मी बी तान खुन उगाड़ला सापरा पोर मिलेल हे काय तो डापाय नाय सेकी पोशो काय बुदलो लेणेन राग बुड़के।”<verse eid="EZK 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 24:9" />बोगवान यहोवा किथे, “हाय, ता खुनी हेयरा पोर! मी बी डिगाह मुठो केरूह। <verse eid="EZK 24:9" /><verse number="10" style="v" sid="EZK 24:10" />चुला माय पोशा लाकड़े टाक दिवो, पोशो आक्‍ठो देदगावो, माहाह उंजु चुड़ावो, ता माय मासालो बुंजो, आड़े बी गाल दिवो। <verse eid="EZK 24:10" /><verse number="11" style="v" sid="EZK 24:11" />तेवी डेचक्याह ठाल्लो केरीन ईंगाला पोर मेल दिवो, ता माय तो ओलो तातो एणे दिवो; काय तान डाग पिगली जाय एने जेंग खेतेम एय जाय एने तो चोमेकणे बाज जाय। <verse eid="EZK 24:11" /><verse number="12" style="v" sid="EZK 24:12" />यरूशलेम तान डागाह दोवणेन जुलूम कोसीत केर सिकेह, पुण ती जेंग सेटी नाय एय! तान जेंग आक्ठी केरीन बी निकली नाह सिकेत। <verse eid="EZK 24:12" /><verse number="13" style="v" sid="EZK 24:13" />एय यरूशलेम हियोर तारी एठाय मोटला पापान हे, मी ते तुवाह चोखो केरने होदतालो, पुण तु चोखो नाह इनो, तान केरता जाह वोर मी मारो राग तार पोर नाय ओलाड़ लेव, ताह वोर तु चोखो नाय केराय जाए। <verse eid="EZK 24:13" /><verse number="14" style="v" sid="EZK 24:14" />मी यहोवा ज्य कियेल; एने तो एय जाय, मी ओहलोच केरूह, मी तुवाह नाय सोडु, एने तुवा पोर गीण नाय केरू एने पासताव बी नाय; तारो चाल चलन एने कामान गेत तारो न्यायनिवाड़ो केराय जाय।” बोगवान यहोवान ज्यो बोल हे।<verse eid="EZK 24:14" /></para>
  <para style="s">यहेजकेलान बायकुन मोत</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 24:15" />पोशो बोगवानान ज्य वचन मार फाय पोचनो। <verse eid="EZK 24:15" /><verse number="16" style="v" sid="EZK 24:16" />“एय माणहान सोरा, देख, मी तारा डोलान मोंगाल्लाह मारीन तार फाय रेन लेणे माय हे; पुण तु रेड़हे मा, एने आहवा मा गालहे। <verse eid="EZK 24:16" /><verse number="17" style="v" sid="EZK 24:17" />मोठेह हाह ते ले, पुण ती होमलाय नाय; मुरेल तान केरता रेड़हे मा, मुंडी माय पागड़ी बांदिन एने पायाम खाहड़ा पेरीन रिज्ये, एने तु तारा मुयाह मा डापहे, एने दुखान रूटो मा खाहे।”<verse eid="EZK 24:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 24:18" />तेवी मी विगोच माणहाह केयो, “हांजु मारी बायकु मोर गियी, एने उठ्यान मी बोगवानान उकुमान गेत किऱ्यो। <verse eid="EZK 24:18" /><verse number="19" style="v" sid="EZK 24:19" />तेवी माणहे माहु केणे बाज गीया, ‘काय तु आमुह नाय किहे काय ज्य जो तु किरेह, ज्यान आमरी केरता काय मतलब हे?’ ”<verse eid="EZK 24:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 24:20" />मी ताह जापाप आप्यो, बोगवानान ज्य वचन मार फाय पोचनो, <verse eid="EZK 24:20" /><verse number="21" style="v" sid="EZK 24:21" />तु इस्राएलान गेराणाह के, बोगवान यहोवा इही किथे, “दिखो मी मारा चोखाला जागाह जाह किल्लो हे केरीन तुमूह मोठाय केरतेह, जो तुमरा डोलाह पोटनो, तोच तुमरा मोनाह पुटेह, ताह मी एठो केरने माय हे; एने तुमरा जा बेटा बेट्यु तुमू इस्राएल माय सोड़ीन आवाह, ता तालवारी केरीन माराय जाती। <verse eid="EZK 24:21" /><verse number="22" style="v" sid="EZK 24:22" />एने जोहलो मी किरेल हे तोहलोच तुमू बी किरहो, तुमू बी तुमरा मुयाह नाय डापहो, एने नाय दुखान रोटा खाहो। <verse eid="EZK 24:22" /><verse number="23" style="v" sid="EZK 24:23" />तुमू मुंडा पोर पागड़ी बांदिन एने पायाम खाहड़ा पेरीन रिहो, एने नाय रिड़हो एने नाय साती ठुकहो, पुण तुमरा पापान कामाम फुसते लेन पिगलती जाहो एने एक दिहरान उगे काहते रिहो। <verse eid="EZK 24:23" /><verse number="24" style="v" sid="EZK 24:24" />इही केरीन यहेजकेल तुमरी केरता निसाणी बोणी; जोहलो तो किऱ्यो, हुतरा तोहलोच तुमू बी किरहो, एने जुलबुखे ज्य एय जाय, तेवी तुमू जाण लिहो काय मी बोगवान यहोवा हे।”<verse eid="EZK 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 24:25" />एने बोगवान केयो, “एय माणहान सोरा, काय ज्य खेरो नाय मिले, काय जेदिह मी तान वातड़ो किल्लो, एने तान होबा, तान डोलान खुसी, एने डोलाह पुटेह, ताह मी ता फाय रेन लेय लेह, <verse eid="EZK 24:25" /><verse number="26" style="v" sid="EZK 24:26" />ते दिह नाहीन वोची, तो तार फाय आवीन तुवाह खुबेर होमलाड़ी। <verse eid="EZK 24:26" /><verse number="27" style="v" sid="EZK 24:27" />ते दिह तारो मुय उगड़ी, एने तु पुशो ठावको नाय रिहे, पुण तु ता वुचेला हिऱ्यो वातु किरहे, ते तु ता माणहान केरता निसाणी बुणहे; एने ज्या जाण लेती काय मी यहोवा हे।”<verse eid="EZK 24:27" /></para>
  <chapter eid="EZK 24" />
  <chapter number="25" style="c" sid="EZK 25" />
  <para style="s">अम्मोनान विरूद जाणाव</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 25:1" />बोगवानान ज्य वचन मार फाय पोचनो, <verse eid="EZK 25:1" /><verse number="2" style="v" sid="EZK 25:2" />एय माणहान सोरा, अम्मोनी माणहान उगे मुय केरीन तान बाराम जाणाव केर। <verse eid="EZK 25:2" /><verse number="3" style="v" sid="EZK 25:3" />ताह के, एय अम्मोनी, बोगवान यहोवान वचन हुमलो, बोगवान यहोवा किथे काय तुमू जा मारा चोखाला जागान बाराम जेवी तो एठो केराय गीयो, एने यहुदान गेराणान बाराम जेवी ता जेलीम गीया, अहा, अहा, केयो! <verse eid="EZK 25:3" /><verse number="4" style="v" sid="EZK 25:4" />केरीन दिखो मी, तुमूह पुर्व देस ने ताबाम केरने माय हे; एने ता तार विचीम तान पाड़ावो टाकती एने तान गेरे बाणावती; ता तारो फोल खाती एने तारो दुद पिती। <verse eid="EZK 25:4" /><verse number="5" style="v" sid="EZK 25:5" />एने रब्बा हियोर उटड़ाह रेणेन एने अम्मोनीयोन देसाह मेंड्रा बोकड्याह बोहणेन जागो बाणाव देह; तेवी तुमू जाण लिहो काय मी यहोवा हे।<verse eid="EZK 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 25:6" />काहाकाय बोगवान इही किथे, “तुमू जा इस्राएल देसान कारेण थापड्या वाजाड्या एने नाचना, एने तुमरा आखा मोना केरीन मोठाय केरीन मोज केऱ्या, <verse eid="EZK 25:6" /><verse number="7" style="v" sid="EZK 25:7" />केरीन देख, मी मारो आथ तार उगे किरेल हे; एने तुवाह जाती जातीन लुट बाणाव देह, एने देसा देसान माणहाम रेन तुवाह निकाल देह; एने तुवाह देसा देसान माणहाम रेन खेतेम केरूह, एने मी तारो सत्यानास केर देह; तेवी तु जाण लिहे काय मी यहोवा हे।”<verse eid="EZK 25:7" /></para>
  <para style="s">मोआब ने विरूद जाणाव</para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 25:8" />बोगवान यहोवा इही किथे, “मोआब एने सेईर जा केतेह, यहुदान गेराणो एने दिहरा देसान गेत बोण जायेल हे। <verse eid="EZK 25:8" /><verse number="9" style="v" sid="EZK 25:9" />केरीन देख, मोआब देसान मिरेन हेयराह बेथशीमोत, बालमोन, एने किर्यातेम। मी ज्या हेयरान एद्दी दुसमोनान केरता उगाड़ देह। <verse eid="EZK 25:9" /><verse number="10" style="v" sid="EZK 25:10" />ताह पुर्व देस ने ताबाम ओहलो केर देह काय ता अम्‍मोनी पोर चेड़ाय केरी; एने अम्मोनीह ओलो वोर तान आदिकार माय केर देह, काय देसा देसान माणहान विचीम तान एर पोशो नाय रेय। <verse eid="EZK 25:10" /><verse number="11" style="v" sid="EZK 25:11" />एने मोआबाह बी देन्ड आपुह, एने ता जाण लेती काय मी यहोवा हे।”<verse eid="EZK 25:11" /></para>
  <para style="s">एदोमान विरूद जाणाव</para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 25:12" />बोगवान यहोवा इही बी किथे, “एदोम जो यहुदान गेराणा हिऱ्यो बुदलो लिदो, एने ता हिऱ्यो बुदलो लेन मोटलो गुनेगार बोण जायेल हे, <verse eid="EZK 25:12" /><verse number="13" style="v" sid="EZK 25:13" />केरीन बोगवान यहोवा किथे, मी एदोमान देसान विरूद मारो आथ तान उगे केरीन ता माय रेन माणहा एने जेनवेराह दुयाह खेतेम केरूह; एने तेमान हियोर रेन ते ददान हियोर वोर, ताह उजाड़ केर देह; एने ता तालवारी केरीन माराय जाती। <verse eid="EZK 25:13" /><verse number="14" style="v" sid="EZK 25:14" />मी मारी पोरजा इस्राएल उगे रेन एदोमा पोर बुदलो लेह; एने ता, ता देसाम मारो रागा पारमाणे ता हेऱ्या वेवारो केरती। तेवी एदोमान माणहे जाणती काय मी बुदलो लेणार बोगवान हे।” बोगवान यहोवान ज्यो बोल हे।<verse eid="EZK 25:14" /></para>
  <para style="s">पलिश्तीन विरूद जाणाव</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 25:15" />
    <note caller="+" style="x">
      <char style="xo" closed="false">25:15 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 14:29-31">यशाया 14:29-31</ref>
      </char>
    </note> बोगवान यहोवा इह केरीन किथे, “काहाकाय पलिश्‍ती माणहे बुदलो लेदा, पुण ता काला कालान दुसमोनीन कारेण तान मोना केरीन मोठाय केरीन बुदलो लेदा काय खेतेम केरी, <verse eid="EZK 25:15" /><verse number="16" style="v" sid="EZK 25:16" />केरीन बोगवान यहोवा किथे, देख, मी पलिश्‍ती माणहान विरूद मारो आथ ओंगाण केरने माय हे, एने करेतीयोह खेतेम केर देह; एने देरीयान मिरेन वुचेल रेणाराह खेतेम केरूह। <verse eid="EZK 25:16" /><verse number="17" style="v" sid="EZK 25:17" />मी ताह मुठलो देन्ड आपुह, एने रागा माय ता हिऱ्यो बुदलो लेह, तेवी ताह मालुम पोड़ी काय मीच बोगवान हे।”<verse eid="EZK 25:17" /></para>
  <chapter eid="EZK 25" />
  <chapter number="26" style="c" sid="EZK 26" />
  <para style="s">सोर हेयरान विरूद जाणाव</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 26:1" />इग्यारवा वोरह्या पेल्ला मोयनान पेल्ला दिह्याह बोगवानान ज्य वचन मार फाय पोचनो, <verse eid="EZK 26:1" /><verse number="2" style="v" sid="EZK 26:2" />“एय माणहान सोरा, सोर हियोर जो यरूशलेमान बाराम कियेल हे, अहा, अहा, जो देस देसान माणहान फाटेक ने गेत एतो, तो खेतेम एय गीयो।”<verse eid="EZK 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 26:3" />“ती उजड़ी जाणे से मी बोरपुर एय जाह! केरीन यहोवा बोगवान किथे, एय सोर, देख, मी तार विरूद हे; एने मी ओहलो केरूह काय जुलूम देस तार विरूद इह केरीन उठती जीह केरीन देरीयान लाटा उठतेह। <verse eid="EZK 26:3" /><verse number="4" style="v" sid="EZK 26:4" />एने ता सोर ने बितड़ाह ओदारती, एने तान चुटाह तोड़ टाकती; एने मी ता पोर रेन तान माटड्यो खुरपीन ताह उगाड़लो केर देह। <verse eid="EZK 26:4" /><verse number="5" style="v" sid="EZK 26:5" />तो देरीयान विचीम जाल पोसरावणेन जागो बोण जाय; काहाकाय बोगवान यहोवान ज्यो बोल हे; एने तो देसा देसान उगे रेन लुटाय जाय। <verse eid="EZK 26:5" /><verse number="6" style="v" sid="EZK 26:6" />एने तान ज्यु सोऱ्यु मोयदानाम हेत्यु, त्यु तालवारी केरीन माराय जाती, तेवी ता जाण लेती काय मी यहोवा हे।”<verse eid="EZK 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 26:7" />काहाकाय बोगवान यहोवा इही किथे, देख, मी सोर ने विरूद मोटला राजा बाबुलान राजा नबुकदनेस्सराह गोड़ा, टांगा, बोहणारे, होवटाली गेरदी, एने टोल्यु हिऱ्योस उत्तर दिशाम रेन लेन आवुह। <verse eid="EZK 26:7" /><verse number="8" style="v" sid="EZK 26:8" />एने ताऱ्यु ज्यु सोऱ्यु मोयदानाम रेती, त्युह तो तालवारी केरीन मारी, एने तारी विरूद कोट बाणवाड़ी एने उतेरती बांदी; एने डाल विसी। <verse eid="EZK 26:8" /><verse number="9" style="v" sid="EZK 26:9" />एने तो तारा बितड़ान विरूद लेड़ायीन आथ्‍यार चालाड़ी एने तारा चुटाह आथ्यारा केरीन ओदार देय। <verse eid="EZK 26:9" /><verse number="10" style="v" sid="EZK 26:10" />एने तान सेना माय ओला गोड़ा रेती, काय तान रेजड़ा माय आखो हियोर डापाय जाय। एने जेवी बाबिलोन ने राजा तारी फाटक्यु माय ओहलो रिगी जीह केरीन माणहे नाकावाला हेयराम रिगतेह, तेवी बितड़ो, बोहणारे, चाकारा एने टांगान आवाज माय काप उठती। <verse eid="EZK 26:10" /><verse number="11" style="v" sid="EZK 26:11" />तो तान गोड़ान मांगा केरीन तारी सोब सेड़क्युह बुराव देय, एने तार माय रेणार माणहाह तालवारी केरीन मार टाकी, एने तारी ताकेतीन खांमे बुई पोर पाड़ाय जाती। <verse eid="EZK 26:11" /><verse number="12" style="v" sid="EZK 26:12" />एने माणहे तारो मालदेन लुटती एने तारा वेपारान वोस्तु सांडाड़ लेती; ता तारा बितड़ाह ओदार देती एने तारा पुटे ओहला गेरे तोड़ देती; तारा दिगोड़ एने लाकड़े, एने तारो माटड्यो ता पाण्याम टाक देती। <verse eid="EZK 26:12" /><verse number="13" style="v" sid="EZK 26:13" />एने मी तारा गीतान सुरताल बोंद केरूह, एने तारा रेणथान दुंद पोशी केदी नाय होमलाय। <verse eid="EZK 26:13" /><verse number="14" style="v" sid="EZK 26:14" />मी तुवाह उगाड़ला सापरान गेत केर देह; तु जाल पोसरावणेन जागो बोण जाहे; एने पुशो वोहाड़ाय नाय जाहे; काहाकाय मी यहोवा ज्य कियेल हे, बोगवान यहोवान ज्यो बोल हे।<verse eid="EZK 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 26:15" />बोगवान यहोवा सोराह इही किथे, “तारो पोड़नेन बोल होमलीन जेवी जेखमी माणहे काहती एने तार माय खुनेच खुने एती, तेवी काय देरीयान दिड़ेवाला देस नाय काप उठती? <verse eid="EZK 26:15" /><verse number="16" style="v" sid="EZK 26:16" />तेवी देरीयान मीरे वाला सोब मुखी माणहे जीव जीवान गादी पोर रेन उतेरती, एने तान चोगा एने सितरायेल फाड़का काड़ीन बिते कापते लेन दुखान फाड़का पेरती, एने बुई पोर बोहीन थेर थेर कापती; एने तारा पोड़ना पोर बोंगलाय जाती। <verse eid="EZK 26:16" /><verse number="17" style="v" sid="EZK 26:17" />एने ता तार बाराम दुखान गीत बाणावीन तुवाह केती,</para>
  <para style="q1" vid="EZK 26:17">“हाय! मल्लाहोन वोहाड़ेल हाय!</para>
  <para style="q1" vid="EZK 26:17">नाव लायेल हियोर जो ताकेतवोर रिनो,</para>
  <para style="q1" vid="EZK 26:17">एने सोब रेणाराह बिवाड़नार हियोर इतो,</para>
  <para style="q1" vid="EZK 26:17">तु किहीक खेतेम इयेल हे?<verse eid="EZK 26:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="EZK 26:18" />तारे पोड़नेन दिह,</para>
  <para style="q1" vid="EZK 26:18">देरीयान दिड़ेवाला टापु काप उठती।</para>
  <para style="q1" vid="EZK 26:18">एने तारो खेतेम एणेन कारेण देरीयान सोब टापु गाबराय जाती।”<verse eid="EZK 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 26:19" />काहाकाय बोगवान यहोवा इही किथे, जेवी मी तुवाह हुनाला हेयरान गेत उजाड़ केरूह एने तार पोर मुटलो देरीयो चेड़ावुह, एने तु उंडाला पाण्याम बुड़ जाहे, <verse eid="EZK 26:19" /><verse number="20" style="v" sid="EZK 26:20" />जेवी तुवाह आंदारकेली माय पोड़नारा हिऱ्यो तुवाह बी वेगाला माणहा माय उतार देह; आंदारकेली एने ती माय पोड़नारा माणहा हिऱ्यो तुवाह बी मेलीन वेगाला कालान उजाड़ेल जागान गेत केर देह; उलोक काय तु पुशो नाय वुहहे एने जीवताला माणहा माय काल्लो जागो नाय सापड़ाव सिकहे। <verse eid="EZK 26:20" /><verse number="21" style="v" sid="EZK 26:21" />मी तुवाह गाबराणेन कारेण केर देह, एने तु ओंगाण पुशो नाय रिहे, पुण होदीन बी तारो पुतो नाय लागी, बोगवान यहोवान ज्यो बोल हे।<verse eid="EZK 26:21" /></para>
  <chapter eid="EZK 26" />
  <chapter number="27" style="c" sid="EZK 27" />
  <para style="s">सोर ने केरता दुखान गीत</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 27:1" />बोगवानान ज्य वचन मार फाय पोचनो, <verse eid="EZK 27:1" /><verse number="2" style="v" sid="EZK 27:2" />“एय माणहान सोरा, सोर ने बाराम एक दुखान गीत बाणावीन ता इही के, <verse eid="EZK 27:2" /><verse number="3" style="v" sid="EZK 27:3" />एय देरिया पोर बोहणार, एय जुलूम होवटा टापुन केरता देस देसान माणहा हिऱ्यो वेपार केरनार।” बोगवान यहोवा इही किथे,</para>
  <para style="q1" vid="EZK 27:3">“एय सोर तु कियेल हे, काय मी पुरो होबातो हे।<verse eid="EZK 27:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 27:4" />तारी एद्दी देरीयान विचीम हे;</para>
  <para style="q1" vid="EZK 27:4">तुवाह बाणावणार तुवाह पुरो होबातो बाणायो।<verse eid="EZK 27:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 27:5" />तारा सोब पाटड्या सनीर बोयड़ान सनोवर जाड़ान लाकड़ान बुणेल हेते;</para>
  <para style="q1" vid="EZK 27:5">तारा खुटान केरता लबानोन ने देवदार लेवाय जायेल हे।<verse eid="EZK 27:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="EZK 27:6" />तारा डांड बाशान ने वाहण्यान जाड़ान बोणना;</para>
  <para style="q1" vid="EZK 27:6">तारा डोंडह्यान पतवार बाणावणेन केरता</para>
  <para style="q1" vid="EZK 27:6">ता सनोवरान आथीन दातान जुड़ेल लाकड़ान बोणना।<verse eid="EZK 27:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 27:7" />तारा पालान केरता</para>
  <para style="q1" vid="EZK 27:7">ता मिस्र माय बुणेल</para>
  <para style="q1" vid="EZK 27:7">रेंगीत सुती फाड़कान बाणावाय गीयो,</para>
  <para style="q1" vid="EZK 27:7">काय तारा जेंडान काम देय;</para>
  <para style="q1" vid="EZK 27:7">तारी खोलीन केरता पोड़दा निल्ला जामण्या एता, ता एलीशा टापु माय रेन आवताला।<verse eid="EZK 27:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 27:8" />तुवाह जेफाड़नार सीदोन एने अर्बद माय रेणारे एता;</para>
  <para style="q1" vid="EZK 27:8">एय सोर, तार विचीम एकलीदार माणहे तुवाह चालाड़णार एता।<verse eid="EZK 27:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 27:9" />तारा कारागीर</para>
  <para style="q1" vid="EZK 27:9">जोड़ाय केरनार गबल हेयरान,</para>
  <para style="q1" vid="EZK 27:9">डायडाया एने एकलीदार माणहे एता;</para>
  <para style="q1" vid="EZK 27:9">तार माय वेपार केरनेन केरता डोंडह्या चालाड़णारा हेऱ्या देरीया पोर वाला सोब डोंडह्या तार फाय आवतेह।”<verse eid="EZK 27:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 27:10" />तारी सेना माय फारसी, लुदी, एने पुती देसान सेना लेड़ाय ने केरता बोरती इयेल एता; ता तार माय ढाल, एने टोपी टांग्या; एने ताच ने कारेण तारो जोर चिड़ेल इतो। <verse eid="EZK 27:10" /><verse number="11" style="v" sid="EZK 27:11" />तारा बितड़ा पोर तारी सेना हेऱ्या अर्बदान माणहे कावदेन एता, एने तारा चुटा पोर गम्मद हेयरान बाहदुर उबरियेल एता; ता तान ढाले तार कावदेन बितड़ा पोर टांगेल एता; तारी होबा तान द्वारा पुरी इयेल एती।<verse eid="EZK 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 27:12" />तारी सोब बातीन मालदेनान वोड़तीन कारेण तर्शिश माणहे तारा वेपारी एता; ता चांदी, लोड़ा रांगा एने सिसा आपीन तारो माल वेचाता लेदा। <verse eid="EZK 27:12" /><verse number="13" style="v" sid="EZK 27:13" />यावान, तुबल, एने मेशेकान माणहे तारा मालान बोदले पावोर पावेरनी एने पितलीन ठामला तार हेऱ्या वेपार केरताला। <verse eid="EZK 27:13" /><verse number="14" style="v" sid="EZK 27:14" />तोगर्मान गेराणान माणहे तारो मालदेन लेन सोवारीन गोड़ा, लेड़ाय ने गोड़ा, एने गेदड़ा आप्या। <verse eid="EZK 27:14" /><verse number="15" style="v" sid="EZK 27:15" />ददानी तारा वेपारी एता; जुलूम होवटा टापु तारा आट बुणेल एता; ता तार फाय आथी दातान हिंग एने आबुनास ने लाकड़े वेपार माय लावताला। <verse eid="EZK 27:15" /><verse number="16" style="v" sid="EZK 27:16" />तारी जुलूम कारागिरीन कारेण अराम तारो वेपारी इतो; मरकत, जामण्या रेंगान सितरायेल फाड़का, होण, मोणी एने लालड़ी आपीन ता तारो माल लेताला। <verse eid="EZK 27:16" /><verse number="17" style="v" sid="EZK 27:17" />यहुदा एने इस्राएल बी तारा वेपारी एता; ता मिन्नीत ने गोव, मिठाय, एने मोवाल, तेल, एने मासालो आपीन तारो माल लेदा। <verse eid="EZK 27:17" /><verse number="18" style="v" sid="EZK 27:18" />तार माय जुलूम कारागिरी एनी एने सोब बातीन मालदेन टुलो एनो, केरीन दमिश्क तारो वेपारी बोणनो; तार फाय हेलबोन ने अंगुरान रूह एने दोवल्या रोचका पोचाड़ाय गीया। <verse eid="EZK 27:18" /><verse number="19" style="v" sid="EZK 27:19" />यावान एने वदान तारा मालान बोदले हुत आप्या; एने तान कारेण लोखंडो, दालचिनी एने हेलड़ा माय बी तारो वेपारी बोणनो। <verse eid="EZK 27:19" /><verse number="20" style="v" sid="EZK 27:20" />ददान हेयरान वेपारी तार हेऱ्या गोड़ान लाकड़ान केरता वेपार केरताला। <verse eid="EZK 27:20" /><verse number="21" style="v" sid="EZK 27:21" />अरब एने केदारान सोब मुखी तारा वेपारी बोणना; ता बोकड्या, मेंडा, एने गिदल्या लावीन तार हेऱ्या लेणो देणो केऱ्या। <verse eid="EZK 27:21" /><verse number="22" style="v" sid="EZK 27:22" />शेबा एने रामान वेपारी तारा वेपारी बोणना; ता हाज हाजी जातीन सोब बातीन मासाला, एने आखी बातीन मोणी, एने होनो आपीन तारो माल लेदा। <verse eid="EZK 27:22" /><verse number="23" style="v" sid="EZK 27:23" />हारान, कन्ने, एदेन, शेबान वेपारी एने अश्शुर एने कलमद, ज्या सोब तारा वेपारी बोणना। <verse eid="EZK 27:23" /><verse number="24" style="v" sid="EZK 27:24" />ता हाज हाज्यु वोस्तु मतलब पांगरनेन निल्ला सितरायेल फाड़का एने दोयड़ी केरीन बांदिल एने देवदारान बुणेल जुदाच फाड़कान पेट्यु लावीन तार हेऱ्या लेणो देणो केऱ्या।<verse eid="EZK 27:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="EZK 27:25" />तर्शिश डोंडह्यान वेपारी माल लावणारे बोणना,</para>
  <para style="q1" vid="EZK 27:25">तान उगे रेन तु देरीयान विचीम रेन जुलूम मालदार एने जोरवार बोण जायेल इतो।<verse eid="EZK 27:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="EZK 27:26" />तारा जेफणारे तुवाह उंडाला देरीयाम पोचाड़ दियेल हेते,</para>
  <para style="q1" vid="EZK 27:26">एने वारो तुवाह देरीयान विचीम तोड़ दियेल हे।<verse eid="EZK 27:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="EZK 27:27" />जे दिह तु बुड़हे,</para>
  <para style="q1" vid="EZK 27:27">ते दिह तारो मालदेन वेपार</para>
  <para style="q1" vid="EZK 27:27">डोंडह्यो चालाड़नारे, जोड़नेन काम केरनारे वेपारी माणहे,</para>
  <para style="q1" vid="EZK 27:27">एने तार माय जोला सिपाय हेते,</para>
  <para style="q1" vid="EZK 27:27">एने तारी आखी बिड़ बाड़ देरीयान विचीम पोड़ जाय।<verse eid="EZK 27:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="EZK 27:28" />तारा डोंडह्यो चालाड़णारान आयेड़नो होमलीन</para>
  <para style="q1" vid="EZK 27:28">तारा आस पास ने माणहे काप उठती।<verse eid="EZK 27:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="EZK 27:29" />एने सोब जेफणारे एने डोंडह्याह चालाड़णारे,</para>
  <para style="q1" vid="EZK 27:29">एने देरीयाम जोला डोंडह्यो चालाड़नारे रेतेह, ता जीव जीवान डोंडह्या पोर रेन उतेरती,<verse eid="EZK 27:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="EZK 27:30" />एने बुई पोर उबरीन तार बाराम जोरेस उहकी उहकीन रेड़ती,</para>
  <para style="q1" vid="EZK 27:30">ता सोतान मुंडा पोर रेजड़ो उड़ावीन रोखड़ा माय वोलती;<verse eid="EZK 27:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="EZK 27:31" />एने तारा दुखाम तान मुंड बोड़ लेती,</para>
  <para style="q1" vid="EZK 27:31">एने कोमराम गोंटो बांदिन</para>
  <para style="q1" vid="EZK 27:31">तान मोनाम जुलूम दुखाम तार बाराम रेड़ती एने साती ठोकती।<verse eid="EZK 27:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="EZK 27:32" />ता दुख किरते लेन तारा बाराम दुखान ज्य गीत बाणावीन गावती,</para>
  <para style="q1" vid="EZK 27:32">सोर जो एवी देरीयान विचीम ठावकोच पोड़ रिनोह, तान बाराबोर काल्लो हियोर हे?<verse eid="EZK 27:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="EZK 27:33" />जेवी तारो माल देरीया पोर रेन निकेलतालो,</para>
  <para style="q1" vid="EZK 27:33">तेवी जुलूम देसान माणहे आफरी जाताला;</para>
  <para style="q1" vid="EZK 27:33">तारो मालदेन एने वेपारान माल जुलूम एतो</para>
  <para style="q1" vid="EZK 27:33">केरीन देरतीन राजा मालदार एय जाताला।<verse eid="EZK 27:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="EZK 27:34" />जी टेम माय तु उंडाला देरीयान लाटा केरीन टुटनो,</para>
  <para style="q1" vid="EZK 27:34">ती टेम माय तारा वेपारान माल,</para>
  <para style="q1" vid="EZK 27:34">एने तार माय रेणारे बी,</para>
  <para style="q1" vid="EZK 27:34">तार माय रेन खेतेम एय गीया।<verse eid="EZK 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 27:35" />टापु माय सोब रेणारे तार केरता दुखी एना; एने तान सोब राजान रोचकान काटा चेड़ गीया, एने तान मुये नाराज देखाणे बाज गीया। <verse eid="EZK 27:35" /><verse number="36" style="v" sid="EZK 27:36" />देस देसान वेपारी तारो तिरस्कार केरने बाज रेनाह; तु बिन कारेण बोण जायेल हे एने पोशी उबरेय नाय सिकहे।<verse eid="EZK 27:36" /></para>
  <chapter eid="EZK 27" />
  <chapter number="28" style="c" sid="EZK 28" />
  <para style="s">सोर ने राजान विरूद जाणाव</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 28:1" />बोगवानान ज्य वचन मार फाय पोचनो, <verse eid="EZK 28:1" /><verse number="2" style="v" sid="EZK 28:2" />“एय माणहान सोरा, सोर ने मुखीह के,” बोगवान यहोवा इही किथे, तु तारा मोनाम मोठाय केरीन ज्य कियेल हे, “मी बोगवान हे, मी देरीयान विचीम बोगवानान गादी पोर बोह रिनोह, पुण तु सोताह बोगवानान गेत देखाड़ेह, तीबी तु बोगवान नाह, माणुह हे। <verse eid="EZK 28:2" /><verse number="3" style="v" sid="EZK 28:3" />तु दानिएलाह रेन वोदार एकलीदार ते, हे; काल्ली वात तार हेरी रेन लिकानी निह एय। <verse eid="EZK 28:3" /><verse number="4" style="v" sid="EZK 28:4" />तु तारी इकेल एने उशारी केरीन मालदेन टुलो किरेल हे, एने तारा गोडामा माय होनो चांदी मिलेल हे; <verse eid="EZK 28:4" /><verse number="5" style="v" sid="EZK 28:5" />तु मोटली इकेल केरीन लेणो देणो केऱ्यो केरीन तारो मालदेन वोदनो, एने मालदेनान कारेण तारा मोनाम मोठाय रिग गियी।”<verse eid="EZK 28:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 28:6" />केरीन बोगवान यहोवा इही किथे; “तु जो तारो मोन बोगवानान गेत देखाड़ेह, <verse eid="EZK 28:6" /><verse number="7" style="v" sid="EZK 28:7" />केरीन देख, मी तार पोर ओहला पाराया उगे रेन चेड़ाय केरावुह, जा आखा देसाह रेन वोदार सिनाल्या हेते; ता तारी एकलीन होबाह एने देसान होबाह बिगाड़नेन केरता तालवार चालाड़ती। <verse eid="EZK 28:7" /><verse number="8" style="v" sid="EZK 28:8" />ता तुवाह मोतीन खाडाम टाक देती; ता तालवारी केरीन तुवाह मार देती, एने तारो देड़ देरीयान विचीम पोड़ रेय। <verse eid="EZK 28:8" /><verse number="9" style="v" sid="EZK 28:9" />तेवी, काय तु तुवाह मारनारान सामने किते रिहे, मी बोगवान हे? नाह, जेवी तु खुनीन आथाम पोड़ जाहे, तेवी तान नेजरीम बोगवान नाह, पुण माणुहच ठेराहे। <verse eid="EZK 28:9" /><verse number="10" style="v" sid="EZK 28:10" />तु पाराया देसावालान आथाम बिगेर खेतना वालान गेत माराय जाहे; काहाकाय देख, मीच तुवाह ज्य कियेल हे, एने मी मारा वचनाह जोरूर पुरो केरूह, ज्यो बोगवान यहोवान बोल हे।”<verse eid="EZK 28:10" /></para>
  <para style="s">सोर राजान पोड़नो</para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 28:11" />पोशो बोगवानान ज्य वचन मार फाय पोचनो, <verse eid="EZK 28:11" /><verse number="12" style="v" sid="EZK 28:12" />एय माणहान सोरा, सोरान राजान बाराम दुखान गीत बाणावीन ताह के; बोगवान यहोवा इही किथे, “तु ते हाजाम रेन हाजो हे; इकेल माय बोरपुर एने हुतरा राजान निसाणी हे। <verse eid="EZK 28:12" /><verse number="13" style="v" sid="EZK 28:13" />तु बोगवानान अदन नावान बोगीचा माय रेतालो; तार फाय पेरनेन फाड़का, माणिक्य, पदराग, हिरा, फिरोजा, मोणी, यशब, निलमोणी, मरकद एने आख्‍यु बातीन रातल्यु मोण्यु एने होनान चेड़ायेल फाड़का पेरनेन एता, तारी डोलगी एने पावल्यु तार मायच बाणवाय जायेल एत्यु; जे दिह तु बाणवाय गीयो, ते दिह त्यु बी तियार केराय जायेल एत्यु। <verse eid="EZK 28:13" /><verse number="14" style="v" sid="EZK 28:14" />तु एक चोमेकणार अबीशिक्त हेरोगदुत इतो, मी तुवाह ओहलो ठेरायो काय तु बोगवानान बोयड़ा पोर रेतालो; तु आक्‍ठान गेत चोमेकणार मोण्युन विचीम चालते फिरतालो। <verse eid="EZK 28:14" /><verse number="15" style="v" sid="EZK 28:15" />तारो आचरण, तारा जेल्मान दिह्याह रेन ते, ते दिह वोर निर्दोस एतो, जाह वोर तारा जीवणाम पाप रिगेल नाह इतो। <verse eid="EZK 28:15" /><verse number="16" style="v" sid="EZK 28:16" />जेवी तारो वेपार जुलूम वोद गीयो, तेवी तु देंगाम बोरायीन पापी बोण गीयो; केरीन मी तुवाह एठो जाणीन बोगवानान बोयड़ा पोर रेन उतार दिनो, एने एय, उजेड़वाला हेरोगदुत मी तुवाह आक्‍ठान गेत चोमेकणार मोण्युन विचीम रेन खेतेम किरेल हे। <verse eid="EZK 28:16" /><verse number="17" style="v" sid="EZK 28:17" />तारी होबायीन कारेण तुवाह मोठाय एती; एने मालदेन ने कारेण तारी इकेल बिगड़ी जायेल एती, मी तुवाह बुई पोर आचटी दिनो; एने राजान ओंगाण मिल्यो काय ता तुवाह देखी। <verse eid="EZK 28:17" /><verse number="18" style="v" sid="EZK 28:18" />तारा पापान वोदार माय एने वेपार माय दुको किरेल इतो, एने तारो चोखालो जागो एठो एय गीयो; केरीन मी तुवाह तार केरता एक ओहली आक्‍ठो पायदा किऱ्यो, जी केरीन तु खेतेम एय गीयो, एने मी तुवाह देखणारान सामने बुई पोर खेतेम केर दिनो। <verse eid="EZK 28:18" /><verse number="19" style="v" sid="EZK 28:19" />देस देसान माणहा माय रेन जोला तुवाह जाणतेह, ता सोब तार खाराब कामान वोजेसे नाराज एय गीया; बिवाड़े ओहलो खेतेम एनो, एने तु कायेम ने केरता आरताय जाहे।”<verse eid="EZK 28:19" /></para>
  <para style="s">सीदोन ने विरूद जाणाव</para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 28:20" />बोगवानान ज्य वचन मार फाय पोचनो, <verse eid="EZK 28:20" /><verse number="21" style="v" sid="EZK 28:21" />“एय माणहान सोरा, तारो मुय सीदोन उगे केरीन तान विरूद जाणाव के। <verse eid="EZK 28:21" /><verse number="22" style="v" sid="EZK 28:22" />एने तु ताह के, बोगवान यहोवा इही किथे, एय सीदोन, मी तार विरूद हे, मी तार विचीम मारी बोड़ाय केरावुह, जेवी मी तान विचीम देन्ड आपुह एने ता माय सोताह चोखालो ठेरावुह, तेवी तुमू जाण लिहो काय मी बोगवान हे। <verse eid="EZK 28:22" /><verse number="23" style="v" sid="EZK 28:23" />मी ता माय बेमारी पोसरावुह, एने तान सेड़क्यु माय लुय वोयाडुह; एने तान कावदेन तालवार चाली; तान विचीम गायला माणहे पोड़ती, एने ता जाण लेती काय मी बोगवान हे।”<verse eid="EZK 28:23" /></para>
  <para style="s">इस्राएलाह बोरकेत जुड़नो</para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 28:24" />बोगवान केयो, “इस्राएल देसान कावदेन वोहणारे देस सोमजो, डोसेलणारे काटा एता, नाहते गुहेपणार बोरशा पोशा नाय ठेराती, तेवी ता जाण लेती काय मी बोगवान यहोवा हे।”<verse eid="EZK 28:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 28:25" />बोगवान यहोवा इही किथे, “इस्राएलान गेराणाह ता सोब माणहाम रेन टुलो केरूह, जान विचीम ता खोवलाय रेनाह, एने देस देसान माणहान सामने तान उगे रेन चोखालो ठेराह, तेवी ता, ता देसाम वोहती जो मी मारा सेवक याकुबाह आपेल इतो। <verse eid="EZK 28:25" /><verse number="26" style="v" sid="EZK 28:26" />ता, ता माय बिगेर बिन वोह रेती; ता गेरे बाणावीन एने अंगुरान वाड्यु लागाड़ती, एने बिगेर बिन रेती; तेवी मी तान कावदेन दुसमोन देसाह देन्ड आपुह, जा इस्राएल पोर मोठाय केरीन दुसमोनीन वेवारो केरतेह, तेवी ता जाण लेती काय तान बोगवान यहोवाच हे।”<verse eid="EZK 28:26" /></para>
  <chapter eid="EZK 28" />
  <chapter number="29" style="c" sid="EZK 29" />
  <para style="s">मिस्र देसान राजान विरूद जाणाव</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 29:1" />दोहवा वोरह्यान बारावे दिह्याह बोगवानान ज्य वचन मार फाय पोचनो, <verse eid="EZK 29:1" /><verse number="2" style="v" sid="EZK 29:2" />“एय माणहान सोरा, तारो मुय मिस्र देसान राजा फिरोनान उगे केरीन तान एने आखा मिस्री माणहान विरूद जाणाव केर; <verse eid="EZK 29:2" /><verse number="3" style="v" sid="EZK 29:3" />इही केरीन के, बोगवान यहोवा किथे, एय मिस्र देसान राजा फिरोन, मी तार विरूद हे, एय मोटला मुगोर, तु तारी नेदीन विचीम पोड़ रिथे, जो किथे, ज्यी नेदी मारी सोतान हे, एने मीच ज्यीह मार केरता बाणायेल हे। <verse eid="EZK 29:3" /><verse number="4" style="v" sid="EZK 29:4" />मी तारा जोबाड्या माय आकड़ा टाकुह, एने तारी नेद्युवाला मासाह तारी खाल माय चिटकाडुह, एने तारी खालीम चिटकेल तारी नेद्युन मासा हेऱ्योच तुवाह तारी नेद्युम रेन काडुह। <verse eid="EZK 29:4" /><verse number="5" style="v" sid="EZK 29:5" />तेवी मी तारी नेद्युन आखा मासा हिऱ्योच जेंगलाम काड़ देह, एने तु मोयदानाम पोड़ रेय; किहीक बी केरीन तारी एर नाय केराय जाय, मी तुवाह जेंगली जेनवेरान एने जुगावाला चिड़ान खाणो बाणाव देह। <verse eid="EZK 29:5" /><verse number="6" style="v" sid="EZK 29:6" />तेवी मिस्र देसाम रेणारे जाण लेती काय मी यहोवा हे।”</para>
  <para style="p" vid="EZK 29:6">ता ते इस्राएलान गेराणान केरता नेरकान टेक बुणेल एता। <verse eid="EZK 29:6" /><verse number="7" style="v" sid="EZK 29:7" />जेवी ता तुवाह आथा केरीन देऱ्या ते तु टुट गीयो, एने ता जाय पोड़ना, एने तान खांदे जेखमी एय गीया, एने तान कोमरान नेहु हुज गीयु। <verse eid="EZK 29:7" /><verse number="8" style="v" sid="EZK 29:8" />केरीन बोगवान यहोवा इही किथे, देख, मी तार पोर तालवार चालाड़ीन, तारा माणहे एने जेनवार, सोबाह खेतेम केरूह। <verse eid="EZK 29:8" /><verse number="9" style="v" sid="EZK 29:9" />तेवी मिस्र देस उजाडुच उजाड़ रेय; एने ता जाण लेती काय मी बोगवान हे,</para>
  <para style="p" vid="EZK 29:9">काहाकाय तु कियेल हे, “मारी नेदी मारी सोताच ने हे, एने मीच त्युह बाणायेल हे। <verse eid="EZK 29:9" /><verse number="10" style="v" sid="EZK 29:10" />केरीन देख, मी तार एने तारी नेद्युन विरूद हे, एने मिस्र देसाह मिग्दोल रेन सेवेने वोर पुण कुश देसान एद्दी वोर उजाडुच उजाड़ केर देह। <verse eid="EZK 29:10" /><verse number="11" style="v" sid="EZK 29:11" />काल्लो माणुह नाहते जेनवार ता माय चालीह वोरह्या वोर पाय बी नाय मेलती, एने नाय ता माय वोहती। <verse eid="EZK 29:11" /><verse number="12" style="v" sid="EZK 29:12" />चालीह वोरह्या वोर मी मिस्र देसाह उजड़ेल देसान विचीम उजाड़ केर मेलुह; एने तान हियोर उजाड़ हेयरान गेत उजाड़ एय जाती, एने मी मिस्री माणहाह देसा देसाम आंग आंगे केर देह, एने देसा देसाम खोवली देह।”<verse eid="EZK 29:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 29:13" />बोगवान यहोवा इही किथे, “चालीह वोरह्या एय जाती तेवी मी मिस्री माणहाह ता देसान विचीम टुलो केरूह, जा माय ता खोवलाय जायेल एता। <verse eid="EZK 29:13" /><verse number="14" style="v" sid="EZK 29:14" />एने मिस्री माणहाह जेलीम रेन सोड़वीन पत्रोस देसाम, जी तान जेल्मो बुय हे, ताहरी पुशो पोचाडुह; एने ताहरी तान आत्योच राज बोण जाय। <verse eid="EZK 29:14" /><verse number="15" style="v" sid="EZK 29:15" />तो आखा राज्याम आत्यो रेय, एने पुशो तान मुंड दिहरा देसान सोमोर उचो नाय केर सेकी, काहाकाय मी मिस्री माणहाह ओहलो आरतावु काय ता देसा देसा पोर राज केर नाय सेकती। <verse eid="EZK 29:15" /><verse number="16" style="v" sid="EZK 29:16" />तो पोशो इस्राएलान गेराणान बुरहो नाह केरनेन वोजेसे नाय रेय, काहाकाय जेवी ता तान उगे देखणे बाज जाती, तेवी ता तान पापाह एर केरती, तेवी ता जाण लेती काय मी बोगवान यहोवा हे।”<verse eid="EZK 29:16" /></para>
  <para style="s">राजा नबूकदनेस्सर राजा मिस्र देसाह आरावी</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 29:17" />पोशो सत्ताविसवा वोरह्यान पेल्ला मोयनान पेल्ला दिह्याह बोगवानान ज्य वचन मार फाय पोचनो। <verse eid="EZK 29:17" /><verse number="18" style="v" sid="EZK 29:18" />“एय माणहान सोरा, बाबिलोन ने राजा नबुकदनेस्‍सर सोर हेयराह कोंडणेन तान सेनाह जुलूम मेहनेत केरायो; आखान मुंडे चापड़ा एय गीया, एने आखान खांदान चामड़ा होलाय गीया; तीबी ताह सोर हेयरा माय रेन नाह ते काय मोंजरी जुड़नी, एने नाह तान सेनाह। <verse eid="EZK 29:18" /><verse number="19" style="v" sid="EZK 29:19" />केरीन बोगवान यहोवा इही किथे, देख मी बाबिलोन ने राजा नबुकदनेस्सराह मिस्र देस आपुह, एने तो तान बिड़ीह लेन जाय, एने तान मालदेन लुटीन तान केर लेय; तेवी ज्यी मोंजरी तान सेनाह जुड़ी। <verse eid="EZK 29:19" /><verse number="20" style="v" sid="EZK 29:20" />मी तान केचटान बोदला माय ताह मिस्र देस केरीन आपेल हे काय ता माणहे मार केरता काम किरेल एता, बोगवान यहोवान ज्यो बोल हे।”<verse eid="EZK 29:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 29:21" />“ते दिहच मी इस्राएलान गेराणा माय एक ताकेतीन हिंग बाणावुह, एने तान विचीम तारो मुय उगाडुह, तेवी ता जाण लेती काय मी बोगवान हे।”<verse eid="EZK 29:21" /></para>
  <chapter eid="EZK 29" />
  <chapter number="30" style="c" sid="EZK 30" />
  <para style="s">मिस्र देसान राजान विरूद जाणाव</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 30:1" />पोशो बोगवानान वचन मार फाय पोचनो; <verse eid="EZK 30:1" /><verse number="2" style="v" sid="EZK 30:2" />“एय माणहान सोरा, जाणाव केरीन के, बोगवान यहोवा इही किथे,</para>
  <para style="q1" vid="EZK 30:2">“हाय, हाय, किरो ता दिह्या पोर!<verse eid="EZK 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="EZK 30:3" />काहाकाय तो दिह मतलब बोगवानान दिह आहने हे;</para>
  <para style="q1" vid="EZK 30:3">तो वादलान दिह, एने देसान केरता तो देन्‍डान टेम रेय।<verse eid="EZK 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 30:4" />मिस्र देसाम तालवार चाली,</para>
  <para style="q1" vid="EZK 30:4">एने मिस्र देसान माणहे मारायीन जाय पोड़ती,</para>
  <para style="q1" vid="EZK 30:4">तेवी कुश देसाम बी पिढ़ा आव पोड़ी,</para>
  <para style="q1" vid="EZK 30:4">माणहे मिस्राह लुटीन लेन जाती,</para>
  <para style="q1" vid="EZK 30:4">एने तान पाया ओदाराय जाय।”<verse eid="EZK 30:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 30:5" />“कुश, पुत, लुद एने सोब दुय बात्या, एने कुब देसान माणहे, एने वाचा बांदायेल देसाम रेणारे, मिस्र देसान माणहा हेऱ्या तालवारी केरीन माराय जाती।”<verse eid="EZK 30:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 30:6" />बोगवान इह केरीन किथे, “मिस्र देसाह होमालनारे जाय पोड़ती, जा मिस्री माणहे तान ताकेत पोर मोठाय केरतेह, ती टुट जाय; मिग्दोल रेन ते सेवेनेवाला सोब माणहे तालवारी केरीन माराय जाती; ज्य बोगवानान वचन हे। <verse eid="EZK 30:6" /><verse number="7" style="v" sid="EZK 30:7" />ता उजड़ेल देसान विचीम उजड़ ठेराती, तान हियोर उजाड़ पुड़ेल हेयराम गेणाय जाती। <verse eid="EZK 30:7" /><verse number="8" style="v" sid="EZK 30:8" />जेवी मी मिस्र देसाम आक्‍ठो लागाडुह एने तान सोब मोदेक केरनारे खेतेम एय जाती, तेवी ता जाण लेती काय मी बोगवान हे।<verse eid="EZK 30:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 30:9" />“ते दिह मार खोबऱ्या बिगेर बिन डोंडह्याम बोहीन जाती, एने कुश देसान माणहाह बिवाड़ती; जोहलो काय मिस्र देसान देन्‍डान टेम इयेल एतो; काहाकाय तो दिह आवणे बाज रिनोह।”<verse eid="EZK 30:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 30:10" />बोगवान यहोवा इही किथे, “मी बाबिलोन ने राजा नबुकदनेस्‍सरान आथा केरीन मिस्र देसान माणहान बिड़ीह माराव देह। <verse eid="EZK 30:10" /><verse number="11" style="v" sid="EZK 30:11" />नबूकदनेस्सर एने तान पोरजा बेल जो सोब देसाह बिवाड़ेह तो मिस्र देसाह खेतेम केरनेन पोचाड़ाय जाय एने ता मिस्र देसान विरूद तालवार काड़ीन देसाह मुरेल माणहाम बोर देती। <verse eid="EZK 30:11" /><verse number="12" style="v" sid="EZK 30:12" />मी नेद्युह हुकाड़ देह, एने देसाह खाराब माणहान ताबाम केर देह; एने मी पाराया माणहान उगे रेन देसाह, जो काय ता माय हे, उजाड़ केराव देह; मी यहोवा ज्य कियेल हे।”<verse eid="EZK 30:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 30:13" />बोगवान यहोवा इही किथे, मी नोप माय रेन मुरताह खेतेम केरूह एने ता माय वाला मुरताह रेणे नाय देव; पोशो काल्लो मुखी मिस्र देसाम नाय उठी; एने मी मिस्र देसाम बिय पायदा केरूह। <verse eid="EZK 30:13" /><verse number="14" style="v" sid="EZK 30:14" />मी पत्रोसाह उजाड़ देह, एने सोआन माय आक्‍ठो लागाडुह, एने नो गावाह देन्ड आपुह। <verse eid="EZK 30:14" /><verse number="15" style="v" sid="EZK 30:15" />सीन जो मिस्र देसान वातड़ो जागो हे, ता पोर मी मारो राग बोड़कावुह, एने नोन गावान बिड़ीह खेतेम केर देह। <verse eid="EZK 30:15" /><verse number="16" style="v" sid="EZK 30:16" />मी मिस्र देसाम आक्‍ठो लागाडुह; एने सीन जुलूम थेर थेर कापी; एने नो गाव फाड़ाय जाय, एने नोप दिह डोवले उठी। <verse eid="EZK 30:16" /><verse number="17" style="v" sid="EZK 30:17" />आवेन एने पिवेसेत ने जुवान तालवारी केरीन पोड़ती, एने ज्या हियोर जेलीम जात रेती। <verse eid="EZK 30:17" /><verse number="18" style="v" sid="EZK 30:18" />जुलबुखे मी मिस्र देसान माणहान जुवालाह तहपन्हेस माय तोडुह, तेवी ता माय दिह आंदारो एय जाय, एने तान ताकेत जा पोर तो मोठाय किरेह, ती खेतेम एय जाय; ता पोर वादेल सावाय जाय एने तान बेट्युख जेलीम जात रेती। <verse eid="EZK 30:18" /><verse number="19" style="v" sid="EZK 30:19" />इह केरीन मी मिस्र देसान माणहाह देन्ड आपुह, तेवी ता जाण लेती काय मी यहोवा हे।<verse eid="EZK 30:19" /></para>
  <para style="s">मिस्र राजान टुटेल सेक्ती</para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 30:20" />ओवतो इग्यारवा मोयनान सातवे दिह्याह बोगवानान ज्य वचन मार फाय पोचनो। <verse eid="EZK 30:20" /><verse number="21" style="v" sid="EZK 30:21" />“एय माणहान सोरा, मी मिस्र देसान राजा फिरोनान खांद तोड़ दियेल हे; एने देख नाह ते जोड़ाय गीयो, नाह ता पोर दावो लागाड़ीन पोट्टी बांदाय गियी, काय तो बांदिन तालवार देरनेन लायेक बोण सेकी। <verse eid="EZK 30:21" /><verse number="22" style="v" sid="EZK 30:22" />केरीन मालीक बोगवान इही किथे, देख मी मिस्र देसान राजा फिरोनान विरूद हे, एने तान हाजाला एने टुटेल दुयू खांदा तोड़ देह; एने तालवारीह तान आथाम रेन पाडुह। <verse eid="EZK 30:22" /><verse number="23" style="v" sid="EZK 30:23" />मिस्री माणहाह जाती जातीम वेरासेर केरूह, एने देसा देसाम खोवलुह। <verse eid="EZK 30:23" /><verse number="24" style="v" sid="EZK 30:24" />मी बाबिलोन ने राजान खांदाह ताकेत आपीन मारी तालवार तान आथाम आपुह; पुण फिरोनान खांदा तोडुह, एने तो तान सामने ओहलो काही जीहे काय मोरनार गायलो काहेह। <verse eid="EZK 30:24" /><verse number="25" style="v" sid="EZK 30:25" />मी बाबिलोन ने राजान खांदा होमालुह, एने फिरोनान खांदाह डिल्ला पोड़ती, तेवी ता जाणती काय मी बोगवान हे, जेवी मी बाबिलोन ने राजान आथाम मारी तालवार आपुह, तेवी तो तीह मिस्र देसा पोर चालाड़ी; <verse eid="EZK 30:25" /><verse number="26" style="v" sid="EZK 30:26" />एने मी मिस्री माणहाह जाती जातीम खोवलुह, एने देसा देसाम वेरूह, तेवी ता जाण लेती काय मी बोगवान हे।”<verse eid="EZK 30:26" /></para>
  <chapter eid="EZK 30" />
  <chapter number="31" style="c" sid="EZK 31" />
  <para style="s">मिस्रान गेणती देवदार जाड़ा हेऱ्यो</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 31:1" />इग्यारवा वोरह्यान तीसरा मोयनान पेल्ले दिह बोगवानान ज्य वचन मार फाय पोचनो। <verse eid="EZK 31:1" /><verse number="2" style="v" sid="EZK 31:2" />एय माणहान सोरा, मिस्र देसान राजा फिरोन एने तान बिड़ीन माणहाह के,</para>
  <para style="q1" vid="EZK 31:2">“तारी बोड़ाय माय तु कुणीन गेत हे।<verse eid="EZK 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="EZK 31:3" />देख, अश्शुर लबानोन ने देवदार इतो</para>
  <para style="q1" vid="EZK 31:3">ज्यान होबात्यु होबात्यु डाल्यु, मोटलो सावलो आपतालो एने जुलूम उच्यु एत्यु;</para>
  <para style="q1" vid="EZK 31:3">एने तान डाल वादलाम वोर पुचेल एती।<verse eid="EZK 31:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 31:4" />पाणी तीह वोदाड्यो,</para>
  <para style="q1" vid="EZK 31:4">एने उंडाला पाण्यान कारेण तो उचो वोदनो।</para>
  <para style="q1" vid="EZK 31:4">ता माय नेद्यु तान जागे रेन कावदेन वोयताल्यु;</para>
  <para style="q1" vid="EZK 31:4">एने तान खोदऱ्यु निकलीन मोयदानान आखा जाड़ा फाय पोचताल्यु।<verse eid="EZK 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 31:5" />केरीन तान उचाय मोयदानान आखा जाड़ाह रेन जुलूम वोदार एनी,</para>
  <para style="q1" vid="EZK 31:5">तान डालख्यु जुलूम एन्यु,</para>
  <para style="q1" vid="EZK 31:5">एने तान डाल्यु लांब्यु एय गीयु, काहाकाय जेवी त्यु निकेलन्यु तेवी त्युह जुलूम पाणी जुड़नो।<verse eid="EZK 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="EZK 31:6" />तान डाल्यु माय जुगावाला आखी बातीन चिड़ा वोहती केरताला,</para>
  <para style="q1" vid="EZK 31:6">एने तान डालख्यु बुंदे मोयदानान आखी बातीन जेनवारे एता;</para>
  <para style="q1" vid="EZK 31:6">एने तान सावलाम मोटल्‍यु जात्यु रेताल्यु।<verse eid="EZK 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 31:7" />तो तान बोड़ाय एने</para>
  <para style="q1" vid="EZK 31:7">तान डालख्युन लांबायीन कारेण होबातो इनो;</para>
  <para style="q1" vid="EZK 31:7">काहाकाय तान मुले जुलूम होवटा पाण्यान आहने एता।<verse eid="EZK 31:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 31:8" />बोगवानान वाड़ान देवदार बी ताह नाह लिकाड़ सेकताला,</para>
  <para style="q1" vid="EZK 31:8">सनोवर तान डालख्युन गेत बी नाह एता, एने नाह अर्मोन जाड़ तान डालख्युन बाराबोर एता,</para>
  <para style="q1" vid="EZK 31:8">बोगवानान वाड़ान बी काल्लो जाड़ होबाय माय तान बाराबोर नाह इतो।<verse eid="EZK 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 31:9" />मी ताह डालख्युन जुलूम होबातो बाणायेल इतो,</para>
  <para style="q1" vid="EZK 31:9">ओलो वोर काय एदेनान आखा जाड़े जा बोगवानान वाड़ाम एता, ताह एतखाताला।”<verse eid="EZK 31:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="EZK 31:10" />केरीन बोगवान यहोवा इही कियेल हे, “तान लांबाय जी वोद गियी, एने तान डाल जी वादलाम वोर पुचेल हे, एने तान उचायीन कारेण तान मोन फुल उठेल हे, <verse eid="EZK 31:10" /><verse number="11" style="v" sid="EZK 31:11" />केरीन देसाम जो ताकेतवालो हे, मी ताच ने आथाम ताह होप देह, एने तो जोरूर ता हिऱ्यो खाराब वेवारो केरी, तान खाराब कामान वोजेसे मी ताह काड़ दियेल हे। <verse eid="EZK 31:11" /><verse number="12" style="v" sid="EZK 31:12" />पाराया जो देसाम बिवाड़े ओहला माणहे हेते, ता ताह काटीन सोड़ देती, तान डालख्यु बोयड़ा पोर, एने सोब खोयरा माय पाड़ाय जाती, एने तान डाल्यु देसान सोब खोदराम टुटीन पोड़ रेती, एने देसा देसान आखा माणहे तान सावलाह सोड़ीन जात रेती। <verse eid="EZK 31:12" /><verse number="13" style="v" sid="EZK 31:13" />ता पुड़ेल जाड़ा पोर जुगावाला सोब चिड़ा वोहती केरतेह, एने तान डालख्युन उपेर मोयदानान सोब जेनवारे चेड़ सेकतेह। <verse eid="EZK 31:13" /><verse number="14" style="v" sid="EZK 31:14" />ज्य ज्यानकेरता एनो, काय पाण्यान जागे वाला सोब जाड़ाम रेन काल्लो तान उचाय नाय वोदाड़े, एने नाय तान डाल वादलाम वोर पोचाड़ी, ता माय रेन जोला पाणी सापड़ावीन मोजबुत एय जायेल हेते, ता उचा एता ता माय मुंड उचो नाह केऱ्या; काहाकाय ता आखान आखा माहणाम बुजायेल माणहान गेत मोतीन ताबाम केरायीन आंदारकेली माय टाकाय जाती।”<verse eid="EZK 31:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 31:15" />बोगवान यहोवा इही किथे, जे दिह तो आंदारकेली माय उतरी गीयो, ते दिह मी रेड़ायो एने उन्डाला देरीयाह डाप दिनो, एने नेद्युन जुलूम होवटो पाणी रोकाय गीयो; एने तान केरता मी लबानोन पोर नाराजगी साव दिनो, एने मोयदानान आखा जाड़े हुक गीया। <verse eid="EZK 31:15" /><verse number="16" style="v" sid="EZK 31:16" />जेवी मी ताह माहणाम बुजायेल माणहान जागे आंदारकेली माय टाक दिनो, तेवी तान पोड़नेन आवाज होमलीन देस देसान माणहे बिय गीया, एने अदनान सोब जाड़े मतलब लबानोन ने हाज हाजा जाड़े, जोला ता माय पाणी सापड़ावतेह, ता सोबाह आंदारकेली माय हुक जुड़नो। <verse eid="EZK 31:16" /><verse number="17" style="v" sid="EZK 31:17" />ता बी ता हेऱ्या तालवारी केरीन मारायेल माणहा फाय आंदारकेली माय उतरी गीया, मतलब ता जा तान खांद एता, एने देसा देसान विचीम तान सावला माय रेताला।<verse eid="EZK 31:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 31:18" />केरीन बोड़ाय एने मोठायीन बाराम एदेनान जाड़ाम रेन तु कुणीन गेत हे? तु ते एदेनान बाकीन जाड़ा हिऱ्यो आंदारकेली माय उताराय जाहे, एने बिगेर खेतनान माणहान विचीम तालवारी केरीन मारायेल माणहा हिऱ्यो पोड़ रिहे, फिरोन एने तान आखी बिड़ी हेऱ्यो ओहलोच एय, बोगवान यहोवान ज्योच बोल हे।<verse eid="EZK 31:18" /></para>
  <chapter eid="EZK 31" />
  <chapter number="32" style="c" sid="EZK 32" />
  <para style="s">मिस्र राजान तुलना मोगरा हेऱ्यी</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 32:1" />बारावा वोरह्यान बारावा मोयनान पेल्ले दिह बोगवानान ज्य वचन मार फाय पोचनो, <verse eid="EZK 32:1" /><verse number="2" style="v" sid="EZK 32:2" />“एय माणहान सोरा, मिस्र देसान राजा फिरोनान बाराम दुखान गीत बाणावीन ताह होमलाड़, देसा देसाम तारी गेणती जुवान सिंहा हेरी आपाय जायेल एती, पुण तु देरीयान मोगरान गेत हे; तु तारी नेद्यु माय टुटीन पोड़नो, एने तान पाण्याह पाया केरीन डोलसीन डुवलो केर दिनो। <verse eid="EZK 32:2" /><verse number="3" style="v" sid="EZK 32:3" />बोगवान यहोवा इही किथे, मी जुलूम देसान पोंचान द्वारा तार पोर जाल पोसरावुह, एने ता तुवाह मारी मोटली जालीम खेच लेती। <verse eid="EZK 32:3" /><verse number="4" style="v" sid="EZK 32:4" />तेवी मी तुवाह बुई पोर सोडुह, एने मोयदाम टाकीन जुगावाला चिड़ाह तार पोर बोहाडुह एने तारो माह खावाड़ीन आखी देरतीन जेनवेराह आफरावुह। <verse eid="EZK 32:4" /><verse number="5" style="v" sid="EZK 32:5" />मी तारा माहाह बोयड़ा पोर मेलुह, एने खोयराह तारी उचायीम बोर देह। <verse eid="EZK 32:5" /><verse number="6" style="v" sid="EZK 32:6" />जा देसाम तु जिफेह, ताह बोयड़े वोर मी तारी लुय पाडुह; एने तान खोदरे तारी लुयीम बोराय जाती। <verse eid="EZK 32:6" /><verse number="7" style="v" sid="EZK 32:7" />जी टेम माय मी तुवाह आरतावणे बाज जाव, ती टेम माय मी जुगाह डापुह एने ताराह आंदाराला केर देह; मी दिह्याह वादलाम लिकाडुह, एने चांद तान उजेड़ नाय आपी। <verse eid="EZK 32:7" /><verse number="8" style="v" sid="EZK 32:8" />जुगा माय जोला उजालो आपणार दिवा हेते, ता सोबाह तारी कारेण आंदरला केर देह, एने तारा देसाम आंदारो केर देह, बोगवान यहोवान ज्यो बोल हे।”<verse eid="EZK 32:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 32:9" />“जेवी मी तारा खेतेमान खुबेर जाती जातीम एने एंजाण्या देसाम पोसरावुह, तेवी मोठ मोठा देसान माणहान मोनाम राग पायदा केरूह। <verse eid="EZK 32:9" /><verse number="10" style="v" sid="EZK 32:10" />मी जुलूम देसाह तार कारेण बोंगलाड़ देह, एने जेवी मी तान राजान सोमोर मारी तालवार मोकलुह, तेवी तार कारेण ता बिन कापणे बाज जाती, एने तारो पोड़नेन दिह ता जान तान जिवान केरता कापती रेती।”<verse eid="EZK 32:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 32:11" />काहाकाय बोगवान यहोवा इही किथे, “बाबिलोन ने राजान तालवार तार पोर चाली। <verse eid="EZK 32:11" /><verse number="12" style="v" sid="EZK 32:12" />मी तारी बिड़ीन माणहाह ओहला बाहदेरान तालवारी केरीन पाड़ावुह जा सोब देसाम रेन बिवाड़े ओहला हेते, ता मिस्र देसान मोठायीह तोड़ती, एने तान आखी बिड़ीन माणहाह खेतेम केर देती। <verse eid="EZK 32:12" /><verse number="13" style="v" sid="EZK 32:13" />मी तान आखा जेनवेराह, नेदी खोदरान मीरे रेणार जीवजेन्तुह खेतेम केर देह, तेवी आवता दिह्याम ता नाय ते माणहान पाया केरीन एने नाय ते जेनवेरान खुऱ्या केरीन डुवलो केराय जाती। <verse eid="EZK 32:13" /><verse number="14" style="v" sid="EZK 32:14" />तेवी मी तान पाण्याह आसो केर देह, एने तान नेद्यु तेलान गेत वोयती, बोगवान यहोवान ज्यो बोल हे। <verse eid="EZK 32:14" /><verse number="15" style="v" sid="EZK 32:15" />जेवी मी मिस्र देसाह उजाड़ केर देह एने जा मालदेनाम तो बोरपुर हे, ताह ठाल्लो केर देह, एने जेवी मी ता माय रेणार सोबाह मारूह, तेवी ता जाण लेती काय मी बोगवान हे। <verse eid="EZK 32:15" /><verse number="16" style="v" sid="EZK 32:16" />माणहान रेड़नेन केरता दुखान गीत ज्योच हे; देसा देसान बायकु ज्याह गावती; मिस्री एने तान आखी बिड़ीन माणहान बाराम त्यु ज्योच दुखान गीत गावती, एने बोगवान यहोवान ज्योच बोल हे।”<verse eid="EZK 32:16" /></para>
  <para style="s">मुरेलान दुनिया</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 32:17" />पोशो बारावा वोरह्यान पेल्ला मोयनान पोंदरावे दिह्याह बोगवानान ज्य वचन मार फाय पोचनो, <verse eid="EZK 32:17" /><verse number="18" style="v" sid="EZK 32:18" />“एय माणहान सोरा, मिस्र देसान होवटाली पोरजान केरता रेड़, मिस्र देस एने ताकेतवाला देसान सोऱ्यु हेऱ्युच माहणाम बुजायेल फाय आंदारकेली माय उतार देय।” <verse eid="EZK 32:18" /><verse number="19" style="v" sid="EZK 32:19" />ताह के;</para>
  <para style="q1" vid="EZK 32:19">“एय मिस्र देस तु कुणाह रेन मुठो हे?</para>
  <para style="q2" vid="EZK 32:19">तु उतरीन बिगेर खेतनावाला हिऱ्यो पोड़ रिनो।”<verse eid="EZK 32:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 32:20" />“ता तालवारी केरीन मारायेल मुरदान विचीम पोड़ती, एने ता हेरीच तान होवटाली पोरजा बी मोरीन पोड़ रेय। <verse eid="EZK 32:20" /><verse number="21" style="v" sid="EZK 32:21" />सेनापती बाहदुर ता हेऱ्या एने तान मोदेक केरनारा हेऱ्यो आंदारकेलीम वातु केरती; ता बिगेर खेतनान माणहे ताहरी तालवारी केरीन मारायीन पोड़ रेनाह।”<verse eid="EZK 32:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 32:22" />तान आखा पोंचा हेऱ्योच अश्शुर बी ताहरी हेते, तान माहणे तान कावदेन हेते; आखान आखा तालवारी केरीन माराय गीया। <verse eid="EZK 32:22" /><verse number="23" style="v" sid="EZK 32:23" />तान माहणे खाडान कोपराम बुणेल हेते, एने तान माहणान कावदेन तान सेना हे, ज्या सोब तालवारी केरीन माराय जायेल हेते, तान खुन तालवारी केरीन इयेल हे, ज्या जीवताला माणहाम दिंगो पोसरावताला।<verse eid="EZK 32:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 32:24" />“दिखो न्याहरी एलाम बी पोड़ रिनोह, तान माहणान कावदेन तान पोरजा हे, ज्या सोब तालवारी केरीन माराय जायेल हेते, तान खुन तालवारी केरीन इयेल हे, एने ज्या जीवताला माणहाम दिंगो पोसरावताला, एने एवी बिगेर खेतनान देशाम आंदारकेली माय पोड़ रेनाह, ज्या माहणाम जाणारा हेऱ्या ओबरून बार उखेल रेनाह। <verse eid="EZK 32:24" /><verse number="25" style="v" sid="EZK 32:25" />एलाम एने तान आखी सेनाह मारायेल तान विचीम हुवाड़ दियेल हे, कावदेन तान माहणे हेते, ज्या सोब बिगेर खेतनान हेते एने तालवारी केरीन माराय जायेल हेते, ता जीवताला माणहाम दिंगो पोसराव मिलेल एता, एने एवी माहणाम जाणारा हेऱ्या आपमानान बार उखेलने बाज रेनाह। ताह मारायेल तान विचीम जागो जुड़ेल हे।”<verse eid="EZK 32:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EZK 32:26" />ताहरी मेशेक एने तुबल बी हेते, एने ता हेरी तान होवटाली सेना बी हे, कावदेन तान माहणे हेते, ता बिगेर खेतनान हेते, एने तालवारी केरीन माराय जायेल हेते, ता जीवताला माणहाम दिंगो पोसराव मिलेल एता। <verse eid="EZK 32:26" /><verse number="27" style="v" sid="EZK 32:27" />ता पुड़ेल बिगेर खेतनान बाहदुरा हेऱ्या पोड़ नाय रेती, जा जीव जीवान लेड़ायीन आथ्‍यार लेन आंदारकेलीम उतरी जायेल हेते, ताहरी तान तालवार तान मुंडी बुंदे मिलेल हेत्यु; एने तान पापान काम तान आड़ाम मिलेल हे; काहाकाय जीवताला माणहाम तान दिंगो पोसरी रियेल इतो।<verse eid="EZK 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 32:28" />केरीन तु बी बिगेर खेतनावाला हिऱ्यो नांगोन बुंगो बोणीन तालवारी केरीन मारायेल ता हिऱ्यो पोड़ रिहे।<verse eid="EZK 32:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EZK 32:29" />ताहरी एदोम एने तान राजा एने तान आखा मुखी हेते, जा बाहदुर एता तीबी तालवारी केरीन मारायेल ता हेऱ्या मेलाय जायेल हेते; खाडाम गाड़ाय जायेल बिगेर खेतनावाला माणहा हेऱ्या ता बी पोड़ रेती।<verse eid="EZK 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 32:30" />ताहरी उत्तर दिशान आखा मुखी एने आखा सीदोनी माणहे बी हेते जा मुरेल ता हेऱ्या उतरी गीया; ता तान बाहदुरी केरीन बिय पायदा किरेल हेते, पुण एवी ता लाजवाना एने तालवारी केरीन एने मुरेल ता हेऱ्या, ता बी बिगेर खेतनान पोड़ रेनाह; माहणाम दिहरा गाड़ायेल ता हेऱ्या आपमानान बार विसणे बाज रेनाह।<verse eid="EZK 32:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EZK 32:31" />“ताह देखीन फिरोन बी तान होवटाली सेनान केरता हुक जुड़ी, तान एने तान होवटाली सेनान बी तालवारी केरीन खुन एय, ज्यो बोगवान यहोवान बोल हे।”<verse eid="EZK 32:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 32:32" />“काहाकाय मी तान वोजेसे जीवताला माणहाम बिय पायदा किरेल इतो; केरीन तो, ता माणहाम बुजाय जाय, जा तालवारी केरीन माराय जायेल हेते, फिरोन एने ता हेऱ्यो तान होवटाली पोरजा बिगेर खेतनान माणहान विचीम बुजाय जाती।” ज्यो बोगवान यहोवान बोल हे।<verse eid="EZK 32:32" /></para>
  <chapter eid="EZK 32" />
  <chapter number="33" style="c" sid="EZK 33" />
  <para style="s">यहेजकेल इस्राएलान राखवाल्यो</para>
  <para style="r">(<ref loc="EZK 3:16-21">यहेजकेल 3:16-21</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 33:1" />बोगवानान ज्य वचन मार फाय पोचनो, <verse eid="EZK 33:1" /><verse number="2" style="v" sid="EZK 33:2" />“एय माणहान सोरा, तारा माणहाह के, जेवी मी एगदा देसा पोर तालवार चालाड़ने बाजु एने ता देसान माणहे एगदाह तान राखवाल्यो केरीन मिले। <verse eid="EZK 33:2" /><verse number="3" style="v" sid="EZK 33:3" />तेवी ज्य देखीन काय ज्या देसा पोर तालवार चालनी हे, तेवी बिरा वाजाड़ीन माणहाह चेकचेल्या केर देय। <verse eid="EZK 33:3" /><verse number="4" style="v" sid="EZK 33:4" />ते जो कुण बिरान आवाज होमल्यो, पुण चेकचिल्यो नाह रेनो, एने तालवार केरीन माराय जाय, ते तान खुनान गुनो ताच पोर रेय। <verse eid="EZK 33:4" /><verse number="5" style="v" sid="EZK 33:5" />तो बिरान आवाज ते होमल्यो, पुण चेकचिल्यो नाह रिनो, केरीन तान खुन ताहच लागी, पुण केदी चेकचिल्यो एय जातो ते तान जीव वोचाड़ लितो। <verse eid="EZK 33:5" /><verse number="6" style="v" sid="EZK 33:6" />पुण राखवाल्यो ज्य देखीन काय तालवार चालन्यी हे एने बिरो वाजाड़ीन माणहा खुबेर नाय देय, एने तालवार चालने से ता माय रेन एगदो मोर जाय, ते तो माणुह ते तान पापाम फोसीन मोर जाय पुण तान खुनान लेखो राखवाल्यास फाय लेह।”<verse eid="EZK 33:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 33:7" />केरीन, “एय माणहान सोरा, मी तुवाह इस्राएलान गेराणान राखवाल्यो ठेराव दियेल हे; तु मारा मुयान वचन होमली होमलीन ताह मार उगे रेन चेकचेल्या केर दे। <verse eid="EZK 33:7" /><verse number="8" style="v" sid="EZK 33:8" />केदी मी पापीह केव, एय पापी तु जोरूर मुरहे; तेवी केदी तु पापीह तान वाटीन बाराम नाय चितावहे, ते तो पापी तान पापाम फोसीन मोरी, पुण तान खुनान लेखो मी तुवाच फाय लेह। <verse eid="EZK 33:8" /><verse number="9" style="v" sid="EZK 33:9" />पुण केदी तु पापीह नाय तान खाराब चालान बाराम चेतावणी आपहे काय तो सोड़ देय, पुण तो तारी चेतावणी पोर द्यान नाय देय, एने खाराब वाटी रेन मुय नाय फिरावे, ते तो जोरूर तान पापाम फोसीन मोर जाए, पुण तारो जीव वोच जाय।”<verse eid="EZK 33:9" /></para>
  <para style="s">सोतान जिमेदारी</para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 33:10" />पुशो एय माणहान सोरा, इस्राएलान गेराणाह इही के, “तुमू केतेह, आमरा गुनान एने पापान बार आमरी उपेर लादायेल हे, एने आपु तान कारेण खेतेम इते जातेह; आमु किहीक जीवताला रेहु? <verse eid="EZK 33:10" /><verse number="11" style="v" sid="EZK 33:11" />केरीन तु ताह इही के, बोगवानान ज्यो बोल हे, मारा जीवणान सुगोण, मी पापी माणहान मोरनेम खुस नाह एत, पुण ता माय काय पापी तान खाराब वाटे से फिरीन जीवतालो रेय; एय इस्राएलान गेराणे, तुमू तुमरी खाराब वाटे रेन फिर जाहो ते काहा मोरहु?”<verse eid="EZK 33:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 33:12" />एय माणहान सोरा तारा माणहाह इही के, “जेवी देरमी माणुह गुनो केरी तेवी तान देरेम ने काम ताह वोचाड़ नाय सिके, एने पापीन खाराबी बी जी एय, जेवी तो ता माय रेन फिर जाय, ते तान कारेण तो नाय पोड़ी; एने देरमी माणुह केदी पाप केरी, तेवी तान देरेम ने कामान वोजेसे जीवतालो नाय रेय। <verse eid="EZK 33:12" /><verse number="13" style="v" sid="EZK 33:13" />केदी देरमीह केव काय तु जोरूर जीवतालो रिहे, एने तो तान देरेमने कामा पोर बुरहो केरीन खाराब कामे केरने बाज जाय, तेवी तान देरेमने कामाम रेन काल्लाच एर नाय केराय जाय; जा खाराब कामे तो किऱ्यो एय, तो ताच माय फोसीन मोरी। <verse eid="EZK 33:13" /><verse number="14" style="v" sid="EZK 33:14" />पुशो मी पापी माणहाह केव, तु जोरूर मुरहे, एने तो तान पापाम रेन फिरीन नियाव एने देरेम ने काम केरने बाज जाय, <verse eid="EZK 33:14" /><verse number="15" style="v" sid="EZK 33:15" />एने गिरवीन वोस्तु फिराव देय, तान लुटेल वोस्तु बोर देय, एने बिगेर खाराब कामे किरेल जीवणान विद्यु पोर चालने बाज जाय, ते, तो जोरूर नाय मोरी पुण जीवतालो रेय। <verse eid="EZK 33:15" /><verse number="16" style="v" sid="EZK 33:16" />तो जोला खाराब कामे किरेल हे, मी ताह एर नाय केरू, एने ताह देन्ड नाय आपु, तो नियाव एने देरेम ने काम किरेल हे जोरूर जीवतालो रेय।”<verse eid="EZK 33:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 33:17" />तीबी तुमरा माणहे केतेह, “मालक्यान वेवारो हाजो नाय मिले; पुण ताच ने चाल हाजी नाय मिले। <verse eid="EZK 33:17" /><verse number="18" style="v" sid="EZK 33:18" />केदी एगदो देरमी माणुह नियाव एने देरेम ने कामे सोड़ीन खाराब कामे केरी, ताहार तो जोरूर मोरी। <verse eid="EZK 33:18" /><verse number="19" style="v" sid="EZK 33:19" />पुण केदी पापी तान खाराब कामे सोड़ीन नियाव एने देरेम ने काम केरने बाज जाय, ते तो तान वोजेसे जिवतालो रेय।” <verse eid="EZK 33:19" /><verse number="20" style="v" sid="EZK 33:20" />तीबी तुमू केतेह, “मालीक वेवारो हाजो नाय मिले? एय इस्राएलान गेराणे, मी आखा माणहान न्यायनिवाड़ो तान चालीन गेत केरूह।”</para>
  <para style="s" vid="EZK 33:20">यरूशलेमान पोड़नेन खुबेर</para>
  <para style="p" vid="EZK 33:20">
    <note caller="+" style="x">
      <char style="xo" closed="false">33:20 </char>
      <char style="xt" closed="false">
        <ref loc="2KI 25:3-10">2 राजा 25:3-10</ref>; <ref loc="JER 39:14">यिर्मया 39:14</ref></char>
    </note> <verse eid="EZK 33:20" /><verse number="21" style="v" sid="EZK 33:21" />पोशो देरायेल तान इग्यारवा वोरह्यान दोहवा मोयनान पाचवे दिह, एक माणुह जो यरूशलेम माय रेन नाहीन वोच जायेल एतो, मार फाय आवीन केणे बाज गीयो, यरूशलेम हियोर खेतेम एय गीयो। <verse eid="EZK 33:21" /><verse number="22" style="v" sid="EZK 33:22" />जे दिह यरूशलेम रेन नाहेल माणुह मार फाय आवो, तान पेल्‍ली हांजीन बुखेत बोगवानान सेक्ती मार पोर आयेल एती, एने तो माणुह हांज पोर माहु मिलानो, तेवी बोगवान तुलीस बुखे मारो मुय उगाड़ दिनो। बोगवानान ताकेत माय मारो मुय उगड़ी गीयो, एने मी पुशो मुको नाह रिनो।<verse eid="EZK 33:22" /></para>
  <para style="s">माणहान पाप</para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 33:23" />तेवी बोगवानान ज्य वचन मार फाय पोचनो, <verse eid="EZK 33:23" /><verse number="24" style="v" sid="EZK 33:24" />“एय माणहान सोरा, इस्राएल देसान उजड़ेल ईलाकाम रेणारे एवी वोर इही केणे बाज रेनाह, ‘आमरो डावालो आबोख अब्राहाम ते एखालो एदमी इतो, तीबी तो आखा कनान देसा पोर ताबो केर लियेल इतो, आपु ते मोकता हेते, ज्यो देस जोरूर आपणे आदिकार माय आपाय जायेल हे।’ ”<verse eid="EZK 33:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 33:25" />केरीन तु ताह के, बोगवान यहोवा इही किथे, “तुमू माह लुय हेऱ्या खातेह एने तुमरा मुरतान उगे निजेर टाकतेह, एने खुन केरतेह; ओवता काय ता देसान आदिकारी बोण सिकहो? <verse eid="EZK 33:25" /><verse number="26" style="v" sid="EZK 33:26" />तुमूह मार पोर बुरहो नाह, पुण तुमरी तालवारी पोर बुरहो हे; तुमू तुमरा आहने रेणारान बायकुन ईजुत लुटतेह, तीबी तुमू सोचतेह काय तुमू इस्राएल देसा पोर आदिकार केर सेकहु?”<verse eid="EZK 33:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EZK 33:27" />तु ताह के, “बोगवान यहोवा इही किथे, मारा जीवणान सुगोण, इस्राएल देसान उजाड़ ईलाकाम रेणारे जोरूर तालवारी केरीन माराय जाती, जो एदमी खेताम रेय, ताह मी जेंगली जेनवेरान मुयाम टाक देह, एने तो ताह खाय जाय, एने जा किल्लाम एने देराम रेतेह, ता बेमारी माय मोरती। <verse eid="EZK 33:27" /><verse number="28" style="v" sid="EZK 33:28" />मी ता देसाह उजाडुच उजाड़ केर देह; एने तान जोरान मोठाय जात रेय; एने इस्राएलान बोयड़ा ओहला उजेड़ती काय ता माय लागतो कुण नाय जाय। <verse eid="EZK 33:28" /><verse number="29" style="v" sid="EZK 33:29" />जेवी मी ता वुचेल इस्राएली माणहान खाराब कामान केरता तान देसाह हुनालो एने उजाड़ केर देह, तेवी ताह मालुम पोड़ी काय मीच बोगवान यहोवा हे।”<verse eid="EZK 33:29" /></para>
  <para style="s">जाणकारान खोबरीन परिणाम</para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 33:30" />“एय माणहान सोरा, तारा माणहे बितड़ान जागे एने गेरान बायणा पोर तार बाराम वातु केरतेह, एने एक दिहराह केतेह, ‘आवो, हुमलो, काय बोगवानान उगे रेन काल्लो वचन निकलेह।’ <verse eid="EZK 33:30" /><verse number="31" style="v" sid="EZK 33:31" />ता टोलान टोला तार फाय आवतेह, एने मारी पोरजा बोणीन तार सामने बोहीन तारो वचन होमेलतेह, पुण ता, ता पोर नाह चालते; मुया केरीन ते ता जुलूम मोंग देखाड़तेह, पुण तान मोन लालुच माय लाग रिथे। <verse eid="EZK 33:31" /><verse number="32" style="v" sid="EZK 33:32" />तु तान नेजरीम मोंगान गीते गावणार एने हाजालो वाजवालीन गेत बुणेल हे, काहाकाय ता तारो वचन होमेलतेह ते खोरा, पुण ता पोर नाह चालते। <verse eid="EZK 33:32" /><verse number="33" style="v" sid="EZK 33:33" />केरीन जुलबुखे मारी वात पुरी एय ते जोरूर पुरी एय! तेवी ता जाण लेती काय आमरी विचीम एक जाणकार आयेल इतो।”<verse eid="EZK 33:33" /></para>
  <chapter eid="EZK 33" />
  <chapter number="34" style="c" sid="EZK 34" />
  <para style="s">इस्राएल ने गोवाले</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 34:1" />बोगवान यहोवान ज्य वचन मार फाय पोचनो, <verse eid="EZK 34:1" /><verse number="2" style="v" sid="EZK 34:2" />एय माणहान सोरा, इस्राएल देसान गोवाल्यान विरूद जाणाव केरीन ता गोवाल्याह के, बोगवान यहोवा इही किथे, “हाय इस्राएलान गोवाल्या पोर जा जीव जीवान पेट बोरतेह! काय गोवाल्याह मेंड्रा बोकड्यान पेटे नाय बोरने जुवे? <verse eid="EZK 34:2" /><verse number="3" style="v" sid="EZK 34:3" />तुमू चेरबी खातेह, एने रोचका पेरतेह एने मात माता पालन्या जेनवेरान माह खातेह; पुण मेंड्रा बोकड्याह तुमू नाह चारते। <verse eid="EZK 34:3" /><verse number="4" style="v" sid="EZK 34:4" />तुमू दुखाऱ्याह टेणका नाह केऱ्या, एने नाह दुखाऱ्याह हुदाऱ्या, एने नाह गायलान गायाह बांद्या, एने बोटकेल मेंड्राह वालीन नाह लावा, एने नाह टाकायेल ताह होद्या, पुण तुमू जोर एने जोबेर जोस्ती केरीन आदिकार चालाड्या। <verse eid="EZK 34:4" /><verse number="5" style="v" sid="EZK 34:5" /><note caller="+" style="x"><char style="xo" closed="false">34:5 </char><char style="xt" closed="false"><ref loc="NUM 27:17">गिनती 27:17</ref>; <ref loc="1KI 22:17">1 राजा 22:17</ref>; <ref loc="MAT 9:36">मत्ती 9:36</ref>; <ref loc="MRK 9:36">मरकुस 9:36</ref></char></note> ता गोवाल्या नाह एता केरीन खोवलाय गीया; एने आखा जेंगली जेनवेरान सिकार बोण गीया। <verse eid="EZK 34:5" /><verse number="6" style="v" sid="EZK 34:6" />मारा मेंड्रा बोकड्या खोवलाय जायेल हेते; ता आखा उच उचा बोयड़ा पोर बोटेकताला; मारा मेंड्रा बोकड्या आखी देरती पोर खोवलाय गीया; एने नाह ते कुण एर केरतालो, एने नाह कुण होदतालो।”<verse eid="EZK 34:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 34:7" />“केरीन, एय गोवाल्या, बोगवानान वचन हुमलो। <verse eid="EZK 34:7" /><verse number="8" style="v" sid="EZK 34:8" />बोगवान यहोवान ज्यो बोल हे, मारा जीवणान सुगोण, मारा मेंड्रा बोकड्या जा गोवाल्या नाह एता, केरीन सोब जेंगली जेनवेरान सिकार बोण गीया; ता माय काय मारा गोवाल्या मारा मेंड्रा बोकड्यान एर नाह केऱ्‍या, एने मारा मेंड्रा बोकड्यान पेट नाह पुण सोतान पेट बोऱ्या। <verse eid="EZK 34:8" /><verse number="9" style="v" sid="EZK 34:9" />केरीन एय गोवाल्या, बोगवानान वचन हुमलो, <verse eid="EZK 34:9" /><verse number="10" style="v" sid="EZK 34:10" />बोगवान यहोवा इही किथे, दिखो, मी गोवाल्यान विरूद हे; एने मी ता फाय मारा मेंड्रा बोकड्यान लेखो लेह, एने ताह पुशो ताह चारने नाय देव; ता पोशा जीव जीवान पेटे बोर नाय सेकती, मी मारा मेंड्रा बोकड्या तान मुयाम रेन सोड़वुह काय ओंगाण तान सिकार नाय बुणे।”<verse eid="EZK 34:10" /></para>
  <para style="s">हाजालो गोवाल</para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 34:11" />काहाकाय बोगवान यहोवा इही किथे, “दिखो, मी सोताच मारा मेंड्रा बोकड्यान एर केरूह, एने ताह होदुह। <verse eid="EZK 34:11" /><verse number="12" style="v" sid="EZK 34:12" />जीह केरीन गोवाल तान मेंड्रा बोकड्या माय रेन टाकायेल ताह पुशो तान टोल्युम हुदेह, तिहेच केरीन मी बी, मारा मेंड्रा बोकड्याह टुलो केरूह; मी ताह ता सोब जागाम रेन काड़ लेन आवुह, जाहरी जाहरी ता वादेल एने जुलूम आंदारलान दिह खोवलाय गीया एती। <verse eid="EZK 34:12" /><verse number="13" style="v" sid="EZK 34:13" />मी ताह देस देसान माणहाम रेन काडुह, एने देस देसाम रेन टुलो केरूह, एने ताच ने सोतान बुयीम लेन आवुह; एने इस्राएलान बोयड़ा पोर एने खोदराम एने ता देसान सोब वुहेल जागाम चारूह। <verse eid="EZK 34:13" /><verse number="14" style="v" sid="EZK 34:14" />मी ताह हाजाला चाराम चारूह, एने इस्राएलान उच उचा बोयड़ा पोर ताह चारो जुड़ी; ताहरी ता हाजाला निलागार चारा माय बोह्या केरती, एने इस्राएलान बोयड़ा पोर हाज हाजो चारो चेरती। <verse eid="EZK 34:14" /><verse number="15" style="v" sid="EZK 34:15" />मी सोताच मारा मेंड्रा बोकड्यान गोवाल रेह, एने मी सोताच ताह बोहाडुह, बोगवान यहोवान ज्यो बोल हे।”<verse eid="EZK 34:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 34:16" />मी टाकायेल ताह होदुह, एने बोटकेल मेंड्रान गाया पोर पाटो बांदुह। एने दुखाऱ्याह टेणको केरूह, एने जा माताला एने ताकेतवाला हेते, ताह मी खेतेम केरूह; मी तान चाराय नियाव केरीन केरूह।<verse eid="EZK 34:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 34:17" />एने एय मारा टोला, मी तुमूह बोगवान यहोवा केथु, दिखो, मी मेंड्रा मेंड्रान विचीम एने मेंडा एने बोकड्यान विचीम न्यायनिवाड़ो केरथु। <verse eid="EZK 34:17" /><verse number="18" style="v" sid="EZK 34:18" />काय तुमूह आतीच वात मालुम पुड़ेह काय तुमू हाजालो चारो चेर लिवो, एने वुचेल चारो तुमरा पाया केरीन रोहंदिलो; पोशी काय तुमूह ज्यी आतीच वात लागेह काय तुमू आसालो पाणी पिय लिवो, एने बाकीन पाण्याह तुमरा पाया केरीन डुवलो किरो? <verse eid="EZK 34:18" /><verse number="19" style="v" sid="EZK 34:19" />काय मारा मेंड्रा बोकड्याह तुमरा पाया केरीन रोहंदलायेल चारो चारज्यो, एने तुमरा पाया केरीन डुवलो केरायेल ताह पिणे पोड़ी?<verse eid="EZK 34:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 34:20" />केरीन बोगवान यहोवा ताह इही किथे, “दिखो, मी सोता माताला एने लोकड़ायेल मेंड्रा बोकड्यान विचीम न्यायनिवाड़ो केरूह <verse eid="EZK 34:20" /><verse number="21" style="v" sid="EZK 34:21" />तुमू जा दुखाऱ्याह खुणी एने खांदा केरीन ओलाक वोर देखेलतेह एने हिंगा केरीन ओला वोर देतेह काय ता खोवलाय जातेह। <verse eid="EZK 34:21" /><verse number="22" style="v" sid="EZK 34:22" />केरीन मी मारा मेंड्रा बोकड्याह सोड़वुह एने ता पोशा नाय लुटाती, एने मेंड्रा मेंड्रान एने बोकड्यु बोकड्युन विचीम न्यायनिवाड़ो केरूह। <verse eid="EZK 34:22" /><verse number="23" style="v" sid="EZK 34:23" />मी ता पोर एक ओहलो गोवाल बाणावुह, जो तान गोवाली केरी, तो मारो पावोर दाऊद रेय, तोच ताह चारी, एने तोच तान गोवाल रेय। <verse eid="EZK 34:23" /><verse number="24" style="v" sid="EZK 34:24" />एने मी यहोवा, तान बोगवान ठेराह, एने मारो पावोर दाऊद तान विचीम मुखी रेय; मी यहोवाच ज्य कियेल हे। <verse eid="EZK 34:24" /><verse number="25" style="v" sid="EZK 34:25" />मी ता हिऱ्यो सांतीन वाचा बांदुह, एने खाराब जेन्तुह देसाम रेणे नाय देव; तेवी ता जेंगलाम बिगेर बिन रेती, एने जेंगलाम हुवती।”<verse eid="EZK 34:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EZK 34:26" />मी ताह एने मारी बोयड़ीन आस पासान जागाह बोरकेतीन कारेण बाणाव देह; एने पाण्याह मी ठिक टेमी माय पाड्या केरूह; एने ती बोरकेतीन जेठ रेय। <verse eid="EZK 34:26" /><verse number="27" style="v" sid="EZK 34:27" />एने मोयदानान जाड़े फोलती एने खेतान पाक उपजाड़ी, एने ता तान देसाम बिगेर बिन रेती; जेवी मी तान जुवालाह तोड़ीन ता माणहान आथाम रेन सोड़वुह जा ताह सेवा केरावतेह, तेवी ता जाण लेती काय मी यहोवा हे। <verse eid="EZK 34:27" /><verse number="28" style="v" sid="EZK 34:28" />ता पोशा देसा देसा उगे रेन लुटाय नाय जाती, एने जेंगली जेनवार ताह वेसड़ीन नाय खाती; ता बिगेर बिन रेती, एने ताह कुण नाय बिगाड़े। <verse eid="EZK 34:28" /><verse number="29" style="v" sid="EZK 34:29" />मी तान केरता उपजाड़नार वाड़ी उपजाडुह, एने ता देसाम पोशा बुखल्या नाय मोरती, एने नाय देसा देसान माणहे पोशा तान चिहटा केरती। <verse eid="EZK 34:29" /><verse number="30" style="v" sid="EZK 34:30" />एने ता जाणती काय मी बोगवान यहोवा तान आरही हे, एने ता जा इस्राएलान गेराणो हे, ता मारी पोरजा हेते, मार यहोवान ज्यो बोल हे। <verse eid="EZK 34:30" /><verse number="31" style="v" sid="EZK 34:31" />तुमू ते मारा मेंड्रा बोकड्या, मारा मोयदानान मेंड्रा बोकड्या हेते, तुमू ते मारा माणहे हेते, एने मी तुमरो बोगवान यहोवा हे, बोगवान यहोवान ज्यो बोल हे।<verse eid="EZK 34:31" /></para>
  <chapter eid="EZK 34" />
  <chapter number="35" style="c" sid="EZK 35" />
  <para style="s">एदोमाह बोगवानान देन्ड</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 35:1" />बोगवानान ज्य वचन मार फाय पोचनो; <verse eid="EZK 35:1" /><verse number="2" style="v" sid="EZK 35:2" />“एय माणहान सोरा,” तारो मुय सेईर बोयड़ान उगे केरीन तान विरूद जाणाव केर, <verse eid="EZK 35:2" /><verse number="3" style="v" sid="EZK 35:3" />एने ताह के, बोगवान यहोवा इही किथे,</para>
  <para style="q1" vid="EZK 35:3">“एय सेईर बोयड़ा,</para>
  <para style="q1" vid="EZK 35:3">मी तार विरूद हे; एने मारो आथ तार विरूद ओंगाण केरीन तुवाह उजाडुच उजाड़ केर देह।<verse eid="EZK 35:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 35:4" />मी तारा हेयराह हुनाला केर देह,</para>
  <para style="q1" vid="EZK 35:4">एने तु उजाड़ एय जाहे;</para>
  <para style="q1" vid="EZK 35:4">तेवी तु जाण लिहे काय मी यहोवा हे।”<verse eid="EZK 35:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 35:5" />काहाकाय तु इस्राएली माणहा हिऱ्यो जेलेम जेलेम ने दुसमोन मेलतालो, एने तान दुखान बुखेत जेवी तान पापान देन्‍डान टेम पोचनो, तेवी ताह तालवारी केरीन माराय जाणेन केरता आप दिनो। <verse eid="EZK 35:5" /><verse number="6" style="v" sid="EZK 35:6" />केरीन बोगवान यहोवान ज्यो बोल हे, मारा जीवणान सुगोण, मी तुवाह खुन केराय जाणेन केरता तियार केरूह एने खुनान पाप तार पासाण पोड़ी; तु खुन किरेल हे, एने दोसी ठेरायेल हे; केरीन खुनान पाप तार पासाण पोड़ी। <verse eid="EZK 35:6" /><verse number="7" style="v" sid="EZK 35:7" />इही केरीन मी सेईर बोयड़ाह उजाडुच उजाड़ केर देह, एने जो ता माय आवतेय जातेय, मी ताह खेतेम केरूह। <verse eid="EZK 35:7" /><verse number="8" style="v" sid="EZK 35:8" />एने मी तान बोयड़ाह मुरेल देड़ा केरीन बोरूह; तारा चुटा, खोयरा एने सोब खोदराम तालवारी केरीन मारायेल ता पोड़ती। <verse eid="EZK 35:8" /><verse number="9" style="v" sid="EZK 35:9" />मी तुवाह जेलेम जेलेम ने केरता उजाड़ केर देह, एने तारा हियोर पोशा नाय वोहती, तेवी तुमू जाणहो काय मी यहोवा हे।<verse eid="EZK 35:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 35:10" />काहाकाय तु कियेल हे, “ज्या दुय राज्य एने दुय देस मारा एय जाती; एने आमुच तान मालीक बोण जाहु, तेवी ता बोगवान ताहरी इतो। <verse eid="EZK 35:10" /><verse number="11" style="v" sid="EZK 35:11" />केरीन बोगवान यहोवान ज्यो बोल हे, मारा जीवणान सुगोण, तारा रागान गेत, एने तान बोदेल रागान बुखेत, तु जो राग देखाड्यो, तान गेत मी तुमरी हिऱ्यो वेवारो केरूह एने तुमरो न्यायनिवाड़ो केरूह, तेवी मी सोताह तान विचीम देखाडुह। <verse eid="EZK 35:11" /><verse number="12" style="v" sid="EZK 35:12" />तु जाणहे, काय मी यहोवा तारी सोब नाकारान वातु हुमलेल हे, जो तु इस्राएलान बोयड़ान बाराम केयो, ता ते उजड़ी गीया, ता आमुहच आपाय जायेल हेते, काय आमु ताह खाय टाके। <verse eid="EZK 35:12" /><verse number="13" style="v" sid="EZK 35:13" />तु तारा मुया केरीन मार विरूद बोड़ाय माऱ्यो, एने मार विरूद जुलूम वातु किरेल हे; तीह मी हुमलेल हे।”<verse eid="EZK 35:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 35:14" />बोगवान यहोवा इही किथे, “जेवी देरती बोर खुसी रेय, तेवी मी तुवाह उजाड़ देह। <verse eid="EZK 35:14" /><verse number="15" style="v" sid="EZK 35:15" />तु इस्राएलान गेराणन सोतान बागान उजेड़ जाणेन कारेण खुस इनो, केरीन मी बी तार हिऱ्यो तोहलोच केरूह; एय सेईर बोयड़ा, एय एदोमान आखा देस, तु उजाड़ एय जाहे, तेवी ता जाण लेती काय मी यहोवा हे।”<verse eid="EZK 35:15" /></para>
  <chapter eid="EZK 35" />
  <chapter number="36" style="c" sid="EZK 36" />
  <para style="s">इस्राएल पोर बोगवानान बोरकेत</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 36:1" />पुशो एय माणहान सोरा, “तु इस्राएलान बोयड़ाह जाणाव केरीन के, एय इस्राएलान बोयड़ा, यहोवान वचन हुमलो। <verse eid="EZK 36:1" /><verse number="2" style="v" sid="EZK 36:2" />बोगवान यहोवा इही किथे, दुसमोन ते तुमरा बाराम कियेल हे, ‘आहा! वेगाला कालान उचाला जागा, एवी आमरा आदिकार माय आव लागा।’ ”<verse eid="EZK 36:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 36:3" />केरीन जाणाव केरीन के, “बोगवान यहोवा इही किथे, जा माणहे तुमूह उजाड्या एने कावदेन रेन तुमूह ओहला गील लेदा काय तुमू वुचेल देसान आदिकारी बोण जावो, एने विरोदी तुमरी चेरचा केरतेह एने सादा माणहे तुमरी चिहटा केरतेह; <verse eid="EZK 36:3" /><verse number="4" style="v" sid="EZK 36:4" />केरीन एय, इस्राएलान बोयड़ा, बोगवान यहोवान वचन हुमलो, बोगवान यहोवा तुमूह इही किथे, मतलब बोयड़ा बोयड्युह एने खोदराह, एने खोयराह उजड़ेल जागाह एने हुनाला हेयराह जा कावदेन वुचेल देसा हेऱ्या लुटाय गीया एने मोजाक ने कारेण बोण जायेल हेते।”<verse eid="EZK 36:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 36:5" />बोगवान यहोवा इही किथे, “जोरूर मी मारो हेलगेणेन आक्‍ठा माय वुचेल देसान एने आखा एदोमान विरूद माय कियेल हे, काय ता मारा देसाह तान मोनान पुरी खुसी से मारा देसाह आदिकार माय किरेल हे, काय तो पारायो एन लुटाय जाय।”<verse eid="EZK 36:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 36:6" />केरीन इस्राएल देसान बाराम जाणाव केरीन बोयड़ा बोयड्यु, खुदोर, एने खोयराह के, बोगवान यहोवा इही किथे, “दिखो तुमू दिहरा देसान चिहटा विठेल हेते, केरीन मी मारा मोटला आक्‍ठान रागा केरीन बोड़ेक उठेल हे, एने ज्य केणे बाजरिनोह। <verse eid="EZK 36:6" /><verse number="7" style="v" sid="EZK 36:7" />बोगवान यहोवा ज्य किथे, मी ज्यो सुगोण खायेल हे काय जोरूर तुमरा कावदेन जा देस हेते, ताह तान चिहटा सोताच वेठणे पोड़ी। <verse eid="EZK 36:7" /><verse number="8" style="v" sid="EZK 36:8" />पुण एय, इस्राएलान बोयड़ा, तुमू पोर डालख्यु वोलती एने तान फोले मारी पोरजा इस्राएलान केरता लागती; काहाकाय तान फिरीन आवणो आहने हे। <verse eid="EZK 36:8" /><verse number="9" style="v" sid="EZK 36:9" />दिखो, मी तुमरी उगे हे, एने तुमरी उगे गीण केरूह, तुमरी बुई पोर खेत केराय जाय, तो पोशो पेराय जाय। <verse eid="EZK 36:9" /><verse number="10" style="v" sid="EZK 36:10" />एने दिखो, मी तार पोर जुलूम माणहे मतलब इस्राएलान आखा गेराणाह वोहाडुह; एने हियोर पोशा वोहाड़ाय जाती एने खण्डहर पोशा बाणावाय जाती। <verse eid="EZK 36:10" /><verse number="11" style="v" sid="EZK 36:11" />एने मी तुमू पोर माणहे एने जेनवार दुयाह जुलूम वोड़ावुह; एने ता वोदती एने फोलती; एने मी तुमूह वेगाला कालान गेत वोहाडुह, एने पेल रेन वोदार तुमरी बोलाय केरूह, तेवी तुमू जाण लिहो काय मी यहोवा हे। <verse eid="EZK 36:11" /><verse number="12" style="v" sid="EZK 36:12" />एने मी ओहलो केरूह काय माणुह मतलब मारी पोरजा इस्राएल तुमू पोर चालती फिरती; एने ता तुमरा मालीक रेती, एने तुमू तान सोतान ईसा रिहो, एने ता तुमरी कारेण बिगेर सोरान नाय रेती।”<verse eid="EZK 36:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 36:13" />बोगवान यहोवा इही किथे, “जा माणहे तुवाह केया केरताला, तु माणहाह खाणार हे, एने आपणी पोर वुहेल देसाह बिगेर सोरान केर दिथे। <verse eid="EZK 36:13" /><verse number="14" style="v" sid="EZK 36:14" />केरीन पुशो तु माणहाह नाय खाहे, एने नाय आपणी पोर वुहेल देसाह बिगेर सोरान किरहे, बोगवान यहोवान ज्यो बोल हे। <verse eid="EZK 36:14" /><verse number="15" style="v" sid="EZK 36:15" />मी पुशो राज राज ने माणहाह तारी चिहटा नाय होमलावाडु, एने तुवाह देसा देसान उगे रेन पोशी चिहटा वेठणे नाय पोड़ी, एने तार पोर वुहेल देसाह तु ठोकेर नाय खावाड़हे, बोगवान यहोवान ज्यो बोल हे।”<verse eid="EZK 36:15" /></para>
  <para style="s">इस्राएलीन नोवालो जीवणो</para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 36:16" />पोशो बोगवानान ज्य वचन मार फाय पोचनो, <verse eid="EZK 36:16" /><verse number="17" style="v" sid="EZK 36:17" />“एय माणहान सोरा, जुलबुखे इस्राएलान गेराणो तान देसाम रेतालो, तेवी तान चाल चलन एने कामा केरीन ता एठा केरताला; तान चाल चलन माहु बायकुन फाड़को आवणेन एठापोणान गेत मालुम पोड़तालो। <verse eid="EZK 36:17" /><verse number="18" style="v" sid="EZK 36:18" />केरीन जो खुन ता देसाम केऱ्या, एने देसाह तान मुरता केरीन एठा केऱ्या, तान कारेण मी ता पोर मारो राग बोड़कायो। <verse eid="EZK 36:18" /><verse number="19" style="v" sid="EZK 36:19" />मी ताह देस देसाम खोवल्या किऱ्यो, एने ता आलेग आलेग देसाम वेराय गीया; तान चाल चलन एने वेवारान गेत मी ताह देन्ड आप्यो। <verse eid="EZK 36:19" /><verse number="20" style="v" sid="EZK 36:20" />ता जा जा देसाम गीया, ताहरी बी ता मारा चोखाला नावाह एठो केऱ्या; काहाकाय माणहे तान बाराम इही केणे बाज गीया, ता देसान माणहे तान बाराम ज्य केताला, ज्या बोगवानान खाज माणहे हेते, तीबी तान देसाम रेन ताह निकालाय गीयो। <verse eid="EZK 36:20" /><verse number="21" style="v" sid="EZK 36:21" />पुण मी मारा चोखाला नावाह एर मिल्यो, जाह इस्राएलान गेराणो ता देसान विचीम एठो ठेरायेल एता, जाहरी ता जायेल एता।”<verse eid="EZK 36:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 36:22" />केरीन तु इस्राएलान गेराणाह के, “बोगवान यहोवा इही किथे, एय इस्राएलान गेराणा, मी ज्याह तुमरी बोदेल नाह, पुण मारा चोखाला नावान बोदेल केरथु जाह तुमू ता देसाम एठो ठेराया, जाहरी तुमू जायेल एता। <verse eid="EZK 36:22" /><verse number="23" style="v" sid="EZK 36:23" />मी मारा मोटला नावाह चोखालो ठेरावुह, जो राज माय एठो ठेरावाय गीयो, जाह तुमू तान विचीम एठो केऱ्या; एने जेवी मी तान नेजरीम तुमरी विचीम चोखालो ठेराह, तेवी ता देसे जाण लेती काय मी यहोवा हे, बोगवान यहोवान ज्यो बोल हे। <verse eid="EZK 36:23" /><verse number="24" style="v" sid="EZK 36:24" />मी तुमूह देसा माय रेन लेय लेह, एने देसा माय रेन टुलो केरूह; एने तुमूह तुमरा सोतान देसाम पोचाड़ देह। <verse eid="EZK 36:24" /><verse number="25" style="v" sid="EZK 36:25" />एने मी तुमू पोर चोखालो पाणी हिपडुह, एने तुमू चोखा एय जाहो; एने मी तुमूह तुमरी आखी एठाय एने मुरताम रेन चोखो केरूह। <verse eid="EZK 36:25" /><verse number="26" style="v" sid="EZK 36:26" />मी तुमूह नोवालो मोन आपुह, एने तुमरे माय नोवालो जीव पायदा केरूह, एने तुमरा सेरीर माय रेन देगड़ान मोन काड़ीन तुमूह माहान मोन आपुह। <verse eid="EZK 36:26" /><verse number="27" style="v" sid="EZK 36:27" />मी मारो जीव तुमरी माय आपीन ओहलो केरूह काय तुमू माऱ्यु विद्यु पोर चालहो एने मारा नेमाह मानीन तान गेत किरहो। <verse eid="EZK 36:27" /><verse number="28" style="v" sid="EZK 36:28" />तुमू ता देसाम वोहहो जो मी तुमरा डायडायाह आपेल इतो; तुमू मारा खाज माणहे ठेराहो, एने मी तुमरो बोगवान ठेराह। <verse eid="EZK 36:28" /><verse number="29" style="v" sid="EZK 36:29" />मी तुमूह तुमरी आखी खाराबी माय रेन सोड़वुह, एने एन उगाडुह उकुम आपीन, ताह वोदाडुह एने तुमरा देसाम काल नाय पाड़ने देव। <verse eid="EZK 36:29" /><verse number="30" style="v" sid="EZK 36:30" />मी जाड़ान फोले एने खेतान पाक वोदाडुह, काय देसाम कालान कारेण पोशी तुमरी चिहटा नाय एय। <verse eid="EZK 36:30" /><verse number="31" style="v" sid="EZK 36:31" />तेवी तुमू तुमरा खाराब चाल चलन एने तुमरा कामाह जा हाजा नाह एता, एर केरीन तुमरा पाप एने खाराब कामान कारेण सोताह नफरत किरहो। <verse eid="EZK 36:31" /><verse number="32" style="v" sid="EZK 36:32" />बोगवान यहोवान ज्यो बोल हे, तुमू जाण लिवो, ज्यी वातीह हास केरीन सोमजी लिवो, काय मी ज्य सोब काम, तुमरी वोजेसे नाय केरू। एय इस्राएल ने गेराणा तारा चालचलन ने बाराम लाज केर, लाजवा।”<verse eid="EZK 36:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EZK 36:33" />बोगवान यहोवा इही किथे, “जेवी मी तुमरा सोब पापान कामाम रेन चोखो केरूह, तेवी तुमरा हेयराह वोहाडुह; एने तुमरा खण्डहर पोशा बाणावाय जाती। <verse eid="EZK 36:33" /><verse number="34" style="v" sid="EZK 36:34" />तुमरो देस जो सोब आवणे जाणारान सामने उजाड़ हे, तो उजाड़ एणेन बोदले जुपाय पेराय जाय। <verse eid="EZK 36:34" /><verse number="35" style="v" sid="EZK 36:35" />एने माणहे केया केरती, ज्यो देस जो उजाड़ इतो, तो अदन बोगीचान गेत बोण गीयो, एने जो हियोर खण्डहर एने उजाड़ इयेल एने ओदाराय जायेल एता, ता किल्‍ला वाला एय गीया, एने वोहाड़ाय जायेल हेते। <verse eid="EZK 36:35" /><verse number="36" style="v" sid="EZK 36:36" />तेवी जा देसे तुमरी आस पास वोच रेती, ता जाण लेती काय बोगवान ओदाराय जायेल ताह पुशो बाणायो, एने उजाड़ी माय जाड़े ठाणेल हे, मी यहोवा ज्य केयो, एने ओहलोच केरूह।”<verse eid="EZK 36:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="EZK 36:37" />बोगवान यहोवा इही किथे, “इस्राएलान गेराणा माय पोशो मार फाय विन्ता केराय जाय, काय मी तान केरता ज्य केरू; मतलब मी ता माय माणहान गेणती मेंड्रा बोकड्यान गेत वोदाडुह। <verse eid="EZK 36:37" /><verse number="38" style="v" sid="EZK 36:38" />जीहे चोखाला टेमान मेंड्रा बोकड्या, मतलब ठेरायेल तिवारान टेम माय, यरूशलेमान मेंड्रा बोकड्या गेणाय नाय ओलाक रेतेह, तिहेच जा हियोर एवी उजाड़ हेते, ता गेणाय नाय ओलाक माणहान टोल्यु माय बोराय जाती; तेवी ता जाण लेती काय मी यहोवा हे।”<verse eid="EZK 36:38" /></para>
  <chapter eid="EZK 36" />
  <chapter number="37" style="c" sid="EZK 37" />
  <para style="s">हुकेल आड़ान बारी</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 37:1" />बोगवानान सेक्ती मार पोर आवी, एने तो मार माय तान जीव होमाड़ीन बाहेर लेन गीयो एने माहु खोयरान विचीम उबो केर दिनो; तो खोयरो आड़ा माय बोरायेल एतो। <verse eid="EZK 37:1" /><verse number="2" style="v" sid="EZK 37:2" />तेवी तो माहु तान कावदेन फिरायो, एने खोयरान टोका पोर जुलूमच आड़े एता; एने ता जुलूम हुकेल एता। <verse eid="EZK 37:2" /><verse number="3" style="v" sid="EZK 37:3" />तेवी तो माहु फुशो, “एय माणहान सोरा, काय ज्या आड़े जीव सेकतेह?”</para>
  <para style="p" vid="EZK 37:3">मी केयो, “एय बोगवान यहोवा, तुवाहच मालुम हे।”<verse eid="EZK 37:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 37:4" />तेवी तो माहु केयो, “न्या आड़ाह जाणाव केरीन के, एय हुकेल आड़े, यहोवान वचन हुमलो। <verse eid="EZK 37:4" /><verse number="5" style="v" sid="EZK 37:5" />बोगवान यहोवा तुमू आड़ाह इही किथे, दिखो मी सोता तुमरे माय हाह बोरूह, एने तुमू जीव उठहो। <verse eid="EZK 37:5" /><verse number="6" style="v" sid="EZK 37:6" />मी तुमरा नेहे उपजाड़ीन माह चेड़ावुह, एने तुमूह चामड़ा केरीन डापुह; एने तुमरे माय माह होमाडुह एने तुमू जीव जाहो; एने तुमू जाण लिहो काय मी बोगवान हे।”<verse eid="EZK 37:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 37:7" />ज्या उकुमान गेत मी जाणाव केरने बाज गीयो; एने मी जाणाव केरनेच बाज रियेल इतो, काय, एक आवाज आवो, एने बुकंप एनो, एने ता आड़े एकठा एन आड़ाह आड़ जोड़ाय गीया। <verse eid="EZK 37:7" /><verse number="8" style="v" sid="EZK 37:8" />मी देखती रिनो, काय ता माय नेहे बोणना एने माह चेड़नो, एने तो चामड़ा केरीन डापाय गीयो; पुण ता माय हाह नाह कायच नाह एती।<verse eid="EZK 37:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 37:9" />तेवी तो माहु केयो, “एय माणहान सोरा हाहीह जाणाव केर, एने हाहीह जाणाव केरीन के, एय हाह, बोगवान यहोवा किथे, काय कावदेन रेन आवीन ज्या मारायेल माय रिग जा काय ज्या जीव उठे।”<verse eid="EZK 37:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 37:10" />तान उकुमान गेत मी जाणाव किऱ्यो, तेवी हाह ता माय आव लागी, एने ता जिवीन तान पायान बोरहे उबेरय गीया; एने एक मोटली सेना बोण गियी।<verse eid="EZK 37:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 37:11" />पुशो तो माहु केयो, एय माणहान सोरा, ज्या आड़े इस्राएलान आखा गेराणान वोच हे। ता केतेह, आमरा आड़े हुक गीया, एने आमरी आसा जात रेनी; एने आमु हास केरीन काटाय जायेल हेते। <verse eid="EZK 37:11" /><verse number="12" style="v" sid="EZK 37:12" />केरीन जाणाव केरीन ताह के, बोगवान यहोवा इही किथे, “एय मारी पोरजान माणहे, दिखो, मी तुमरा माहणे उगाड़ीन तुमूह ता माय रेन काडुह, एने इस्राएलान देसाम पोचाड़ देह। <verse eid="EZK 37:12" /><verse number="13" style="v" sid="EZK 37:13" />केरीन जेवी मी तुमरा माहणे उगाडुह, एने तुमूह ता माय रेन काडुह, तेवी ता मारी पोरजान माणहे, तुमू जाण लिहो काय मी यहोवा हे। <verse eid="EZK 37:13" /><verse number="14" style="v" sid="EZK 37:14" />मी तुमरे माय मारो जीव रिगाडुह, एने तुमू जीवहो, एने तुमूह तुमरा सोतान देसाम वोहाडुह; तेवी तुमू जाण लिहो काय मी यहोवा ज्य कियेल हे, एने किरेल बी हे। बोगवानान ज्यो बोल हे।”<verse eid="EZK 37:14" /></para>
  <para style="s">यहुदा एने इस्राएल एकुस राज्य</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 37:15" />पोशो बोगवानान ज्य वचन मार फाय पोचनो, <verse eid="EZK 37:15" /><verse number="16" style="v" sid="EZK 37:16" />“एय माणहान सोरा, एक लाकोड़ लेन ता पोर लेख, यहुदा एने तान हाती इस्राएली माणहान; तेवी दिहरो लाकोड़ लेन ता पोर लेख, ‘युसूफान मतलब एप्रेमान,’ एने तान हाती इस्राएलीन लाकड़े। <verse eid="EZK 37:16" /><verse number="17" style="v" sid="EZK 37:17" />पुशो ता लाकड़ाह दिहराह जोड़ीन एक किर ले काय तारा आथाम एकुच लाकोड़ बोण जाय। <verse eid="EZK 37:17" /><verse number="18" style="v" sid="EZK 37:18" />जेवी तारा माणहे तुवाह फुसे, काय तु आमुह नाय किहे काय ज्यान तारो काय मतलब हे? <verse eid="EZK 37:18" /><verse number="19" style="v" sid="EZK 37:19" />तेवी ताह किज्ये, बोगवान यहोवा इही किथे, दिखो, मी युसूफान लाकड़ाह जो एप्रेमान आथाम हे, एने इस्राएल ने गेराणो तान हाती हे, ताह लेन यहुदान लाकड़ाह जोड़ीन ता हिऱ्यो एकुच लाकोड़ केर देह; एने दुयू मारा आथाम एक लाकोड़ बोणी।”<verse eid="EZK 37:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 37:20" />“जा लाकड़ा पोर तु ओहलो लिखहे, ता तान सामने तारा आथाम रेय। <verse eid="EZK 37:20" /><verse number="21" style="v" sid="EZK 37:21" />तेवी तु ता माणहाह के, बोगवान यहोवा इही किथे, दिखो, मी इस्राएली माणहाह ता देसाम रेन लेन जा माय ता जात रियेल हेते, चार उगेन देसाम रेन टुलो केरूह; एने तान सोतान देसाम पोचाडुह। <verse eid="EZK 37:21" /><verse number="22" style="v" sid="EZK 37:22" />मी ताह तो देस मतलब, इस्राएलान बोयड़ा पोर एकुच देस केर देह; एने ता सोबान एकुच राजा रेय, एने ता पोशा दुय नाय रेती एने दुय राज माय केदी नाय वाटाती। <verse eid="EZK 37:22" /><verse number="23" style="v" sid="EZK 37:23" />ता पोशा तान मुरताह, एने खाराब कामाह एने तान काल्ली बातीन पापे केरीन एठो नाय केरती; पुण मी ताह त्यु सोब वोहत्युम रेन, जाहरी ता पाप केरताला, काड़ीन चोखो केरूह, एने ता मारी पोरजा रेती, एने मी तान बोगवान रेह। <verse eid="EZK 37:23" /><verse number="24" style="v" sid="EZK 37:24" />मारो पावोर दाऊद तान राजा रेय, एने ता सोबान एकुच गोवाल रेय, ता मारा नेमा पोर चालती एने माऱ्यु विद्युह मानीन तान गेत चालती। <verse eid="EZK 37:24" /><verse number="25" style="v" sid="EZK 37:25" />ता ता देसाम रेती, जाह मी मारा पावोर याकुबाह आपेल इतो, जा माय तुमरा डायडाया रेताला, ताच माय ता एने तान सोरा नातण्याक कायेम वोह रेती; एने मारो पावोर दाऊद कायेम तान मुखी रेय। <verse eid="EZK 37:25" /><verse number="26" style="v" sid="EZK 37:26" />मी ता हिऱ्यो सान्तीन वाचा बांदुह; ती जेलेम ने वाचा ठेराय; एने मी ताह जागो आपीन गेणती माय वोदाडुह, एने तान विचीम मारो चोखालो जागो कायेम बाणाव मेलुह। <verse eid="EZK 37:26" /><verse number="27" style="v" sid="EZK 37:27" />मारो रेणेन तोम्बु तान उपेर रेय; एने मी तान बोगवान रेह, एने ता मारी पोरजा रेती। <verse eid="EZK 37:27" /><verse number="28" style="v" sid="EZK 37:28" />जेवी मारो चोखालो जागो तान विचीम जेलेम ने केरता रेय, तेवी आखा देस जाण लेती काय मी यहोवा इस्राएलान चोखालो केरनार हे।”<verse eid="EZK 37:28" /></para>
  <chapter eid="EZK 37" />
  <chapter number="38" style="c" sid="EZK 38" />
  <para style="s">गोग देसान बाराम जाणाव</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 38:1" />पोशो बोगवानान ज्य वचन मार फाय पोचनो, <verse eid="EZK 38:1" /><verse number="2" style="v" sid="EZK 38:2" />“एय माणहान सोरा, तारो मुय मागोग देस गोग उगे केरीन, जो रोश, मेशेक एने तुबल ने मुखी हे, तान विरूद जाणाव केर। <verse eid="EZK 38:2" /><verse number="3" style="v" sid="EZK 38:3" />एने इही के, एय गोग, एय रोश, मेशेक, एने तुबल ने मुखी, बोगवान यहोवा इही किथे, देख मी तार विरूद हे। <verse eid="EZK 38:3" /><verse number="4" style="v" sid="EZK 38:4" />मी तुवाह फिराव लेन आवुह, एने तारा जोबाड्या माय नाथ पेरावीन तुवाह काडुह; एने तारी सेनाह बी, मतलब, गोड़ा एने बोहणाराह जा आखान आखा कवच पेरीन एक होवटाली बिड़ हे, जा फरी एने ढाल लेन आखान आखा तालवार चालाड़नारे रेती; <verse eid="EZK 38:4" /><verse number="5" style="v" sid="EZK 38:5" />एने तान आरही फारस, कुश एने पुताह, जा आखान आखा ढाल लेन एने टोपा लागाड़ीन रेती; <verse eid="EZK 38:5" /><verse number="6" style="v" sid="EZK 38:6" />एने गोमेर एने आखा सेनान टोलाह, एने उत्तर दिशान सेट सेटाला देसान तोगर्मान गेराणो, एने तान आख्‍यु टोल्युह काडुह; तार हिऱ्यो जुलूम देसान माणहे रेती। <verse eid="EZK 38:6" /><verse number="7" style="v" sid="EZK 38:7" />केरीन तु तियार एय जा; तु एने जोली बिड़ तार फाय टुलो रेय, तियार रिज्ये, एने तु तान मुखी बुणज्ये। <verse eid="EZK 38:7" /><verse number="8" style="v" sid="EZK 38:8" />जुलूम दिह एय जाती तेवी तारी एर केराय जाय; एने सेवली वोरह्या माय तु ता देसाम आवहे, जो तालवारीन ताबाम रेन सुटनो एय, एने जा माय रेणारे जुलूम देसाम रेन टुलो एती; मतलब तु इस्राएलान बोयड़ा पोर आवहे जा लागातार उजाड़ने बाज रेनाह; पुण ता देस देसान माणहान ताबाम रेन सोड़वाय जाएन आखान आखा बिगेर बिन रेती। <verse eid="EZK 38:8" /><verse number="9" style="v" sid="EZK 38:9" />तु चेड़ाय किरहे, एने वादणान गेत आवहे, एने तारा आखा टोला एने देसान माणहा हिऱ्यो वादलान गेत देसा पोर सावाय जाहे।”<verse eid="EZK 38:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 38:10" />बोगवान यहोवा इही किथे, “ते दिह मारा मोनाम ओहल्यु ओहल्यु वातु आवती काय तु एक खाराब हुमच्यो काड़हे; <verse eid="EZK 38:10" /><verse number="11" style="v" sid="EZK 38:11" />एने तु किहे काय मी बिगेर बितड़ान गावान देसा पोर चेड़ाय केरूह; मी ता माणहा फाय जाह जा हुकेह रेतेह; ता सोमेजतेह काय ता सुरक्षित हेते, तान राखवालीन केरता तान हेयराम कावदेन काल्लो बितड़ो नाह सोतो। तान किवाड़ा माय ताला नाह सोता; तान किवाड़ा बी नाह सोता। <verse eid="EZK 38:11" /><verse number="12" style="v" sid="EZK 38:12" />काय सांडाड़ीन तु एने तारो आथ ता खण्डहरा पोर वोदाड़े जा पोशा जा वाहाड़ाय गीया, एने ता माणहान विरूद एय जाय जा देसाम रेन टुलो इयेल एता एने देरतीन बोमी पोर वुहेल जेनवार एने दिहरो मालदेन मेलतेह। <verse eid="EZK 38:12" /><verse number="13" style="v" sid="EZK 38:13" />शेबा एने ददानान माणहे एने तर्शिशान वेपारी तान देसान सोब जुवान सिंहा हिऱ्यो तुवाह केती, ‘काय तु लुटणेन आवेह? काय तु मालदेन सांडाड़ ने, होनो चांदी विसणे, जेनवार एने मालदेन लेन जाणे, एने होवटाली लुट लेणेन केरता तान बिड़ टुलो किरेल हे?’ ”<verse eid="EZK 38:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 38:14" />केरीन, एय माणहान सोरा, जाणाव केरीन गोगाह के, बोगवान यहोवा इही किथे, “जी टेम माय मारी पोरजा इस्राएल बिगेर बिन रेय, काय माहु ज्यान खुबेर नाय जुड़ी? <verse eid="EZK 38:14" /><verse number="15" style="v" sid="EZK 38:15" />तु उत्तर दिशान सिट सिटेन जागे रेन आवहे; तु एने तार हेऱ्या जुलूम देसान माणहे, जा आखान आखा गोड़ा पोर बोहीन रेती, मतलब एक होवटाली बिड़ एने तेगड़ी सेना। <verse eid="EZK 38:15" /><verse number="16" style="v" sid="EZK 38:16" />जीहे वादेल बुई पोर सावाय जाथे, तिहेच केरीन तु मारी पोरजा इस्राएल देसा पोर ओहलो चेड़ाय किरहे, केरीन एय गोग, सेवल्या दिह्याम ओहलोच एय, काय मी तुवाह मारा देसा पोर ज्यान केरता चेड़ाय केरावुह, काय जेवी मी देसान देखता तार उगे रेन सोताह चोखालो ठेरावु, तेवी ता माहु ओलखी लेती।”<verse eid="EZK 38:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 38:17" />बोगवान यहोवा इही किथे, “काय तु तोच नाय मिले जान चेरचा मी वेगाला कालाम तारा पावरान मतलब इस्राएलान ता जाणकारा उगे रेन किरेल इतो, जो ता दिह्या माय वोरह्या वोर जाणाव किरते गीया, काय यहोवा गोग पोर इस्राएल पोर चेड़ाय केरावहे?”<verse eid="EZK 38:17" /></para>
  <para style="s">बोगवान गोगाह देन्ड आपेह</para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 38:18" />जे दिह इस्राएलान देसा पोर गोग चेड़ाय केरी, ते दिह मारो राग मारा मुया पोर रेन देखाय, बोगवान यहोवान ज्यो बोल हे। <verse eid="EZK 38:18" /><verse number="19" style="v" sid="EZK 38:19" />मी हेलगणे एने रागान आक्ठाम केयो, काय “जोरूर ते दिह इस्राएलान देसाम मुटलो बुकंप एय। <verse eid="EZK 38:19" /><verse number="20" style="v" sid="EZK 38:20" />एने मारा देरसेना माय देरीयान मासा एने जुगावाला चिड़ा, जेंगली जेनवार एने बुई पोर जोला जीवजेन्तु लोलतेह, एने बुई पोर जोला माणहे रेतेह, सोब काप उठती; एने बोयड़ा ओदाराय जाती; एने उतेरत्यु खेतेम एती, एने आखा बितड़ा ओदरीन माटड्याम बेचकाय जाती। <verse eid="EZK 38:20" /><verse number="21" style="v" sid="EZK 38:21" />बोगवान यहोवान ज्यो बोल हे, काय मी तान विरूद तालवार चालाड़नेन केरता मारा आखा बोयड़ाह आयडुह एने आखान तालवार तान बायाख ने विरूद उठी। <verse eid="EZK 38:21" /><verse number="22" style="v" sid="EZK 38:22" />मी बेमारी एने खुना केरीन तान न्यायनिवाड़ो केरूह; एने ता पोर एने तान टोली पोर, एने ता जुलूम देसा पोर जा ता फाय रेती, मी मोटली जेड़ लागाडुह, एने गारा एने आक्‍ठो एने गन्दक पाडुह। <verse eid="EZK 38:22" /><verse number="23" style="v" sid="EZK 38:23" />इह केरीन मी सोताह मुठो एने चोखालो ठेरावुह एने जुलूम होवटा देसान सामने सोताह देखाडुह, तेवी ता जाण लेती काय मी यहोवा हे।”<verse eid="EZK 38:23" /></para>
  <chapter eid="EZK 38" />
  <chapter number="39" style="c" sid="EZK 39" />
  <para style="s">गोग राजान आर</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 39:1" />ओवतो एय माणहान सोरा, गोग ने विरूद जाणाव केरीन इही के, “एय गोग, एय रोश, मेशेक एने तुबल ने मुखी, बोगवान यहोवा इही किथे, मी तार विरूद हे। <verse eid="EZK 39:1" /><verse number="2" style="v" sid="EZK 39:2" />मी तुवाह फिराव लावुह, एने उत्तर दिशान सेट सेटा देसाम रेन चेड़ाव लेन आवुह, एने इस्राएलान बोयड़ा पोर पोचाडुह। <verse eid="EZK 39:2" /><verse number="3" style="v" sid="EZK 39:3" />ताहरी तारी दोंदली तारा जेवड्या आथाम रेन पाडुह, एने तारा बेलखाह तारा डाखऱ्‍या आथाम रेन नेचो पाड़ देह। <verse eid="EZK 39:3" /><verse number="4" style="v" sid="EZK 39:4" />तु तारा आख्‍यु टोल्यु हिऱ्यो एने तार आरहीवाल्यु आख्‍यु जात्यु हिऱ्योच इस्राएलान बोयड़ा पोर मार टाकाय जाहे; मी तुवाह बात बातीन चिड़ान एने जेंगली जेनवेरान खाणो बाणाव देह। <verse eid="EZK 39:4" /><verse number="5" style="v" sid="EZK 39:5" />तु खेताम पुड़हे, काहाकाय मी ओहलो कियेल हे, बोगवान यहोवान ज्यो बोल हे। <verse eid="EZK 39:5" /><verse number="6" style="v" sid="EZK 39:6" />मी मागोग माय एने देरीयान दिड़ेवाला हेयराम बिगेर बिन रेणारान विचीम आक्‍ठो हेलगाडुह; एने ता जाण लेती काय मी यहोवा हे। <verse eid="EZK 39:6" /><verse number="7" style="v" sid="EZK 39:7" />मी मारी पोरजा इस्राएलान विचीम मारो नाव देखाडुह; एने मारो चोखाला नावाह पुशो एठो एणे नाय देव; तेवी देसा देसान माणहे जाण लेती काय मी यहोवा इस्राएलान चोखालो हे।”<verse eid="EZK 39:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 39:8" />ज्यी गेटना एणी हे एने ती एय जाय, बोगवान यहोवान ज्‍यो बोल हे, “ज्यो तोच दिह हे जान चेरचा मी किरेल हे। <verse eid="EZK 39:8" /><verse number="9" style="v" sid="EZK 39:9" />तेवी इस्राएलान हेयराम रेणारे निकेलती एने आथ्यारे आक्ठाम हेलगाड़ देती, ढाल, एने फरी, दोंदली, एने बेलखा, डेंगा, बोरशा, सोबाह सात वोरह्या वोर हेलगाड़ती रेती। <verse eid="EZK 39:9" /><verse number="10" style="v" sid="EZK 39:10" />केरीन ता मोयदाना माय लाकड़े नाय होद्ती, एने नाय जेंगला माय काटती, काहाकाय ता आथ्याराहच हेलगाड्या केरती; तान लुटणाराह लुटती सांडाड़नारा फाय रेन सांडाड़ती।” बोगवान यहोवान ज्यो बोल हे।<verse eid="EZK 39:10" /></para>
  <para style="s">गोग राजाह बुजणो</para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 39:11" />ती टेम माय मी गोगाह इस्राएल देसाम माहेण आपुह, तो देरीयान पुर्व उगे रेय; तो आवणार जाणारान खोयरो केवाय, एने आवणे जाणाराह ताहरी रोकाणे पोड़ी; ताहरी आखी गेरदी हेऱ्योच बुजाय जाय, एने ता जागान नाव गोगान बिड़ीन खोयरो पोड़ी। <verse eid="EZK 39:11" /><verse number="12" style="v" sid="EZK 39:12" />इस्राएलान गेराणो ताह सात मोयना वोर बुजती रेय काय तान देसाह चोखो केरी। <verse eid="EZK 39:12" /><verse number="13" style="v" sid="EZK 39:13" />देसान आखा माणहे मिलीन ताह बुजती; एने जी टेम माय मारी बोड़ाय एय, ती टेम माय तान बी नाव मोठो रेय, बोगवान यहोवान ज्यो बोल हे। <verse eid="EZK 39:13" /><verse number="14" style="v" sid="EZK 39:14" />तेवी ता माणहाह ठेरावती, जा लागातार ताच कामाम लाग रेतेह, मतलब देसाम फिरीन आवणे जाणारा हिऱ्यो आरही मिलीन देसाह चोखो केरनेन केरता ताह जा बुई पोर पोड़ रेना एती, बुजती; सात वोरह्या एता वोर ता होद होदीन ज्य काम किरते रेती। <verse eid="EZK 39:14" /><verse number="15" style="v" sid="EZK 39:15" />देसाम आवणे जाणाराम रेन जेवी एगदा माणहान आड़े देखी, तेवी ता फाय एक निसाणी उबो केरी, ज्यो ती टेम वोर बोणीन रेय जाह वोर बुजणार ताह गोगान बिड़ीन खोयराम बुज नाय देय। <verse eid="EZK 39:15" /><verse number="16" style="v" sid="EZK 39:16" />ताहरी वाला हेयरान नाव बी हमोना हे, इह केरीन देस चोखो केराय जाय।<verse eid="EZK 39:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 39:17" />पुशो एय माणहान सोरा, “बोगवान यहोवा इही किथे, बाती बातीन आखा चिड़ाह एने सोब जेंगली जेनवेराह उकुम आप, एकठा एन आवो, मारा मोटला खाणा माय जो तुमरी केरता इस्राएलान बोयड़ा पोर केरथु, आखा दिशाम रेन एकठा ईवो, काय तुमू माह खावो एने लुय पिवो। <verse eid="EZK 39:17" /><verse number="18" style="v" sid="EZK 39:18" />तुमू शुरवीरान माह खाहो, एने देरतीन मुखीन लुय पिहो। ज्या बाशान देसान मोटला माताला मेंड्रा, गिदल्या, बुकोड़ एने बुयोल हेते। <verse eid="EZK 39:18" /><verse number="19" style="v" sid="EZK 39:19" />मारा ता खाणान चेरबी केरीन जो मी तुमरी केरता केरथु, तुमू खाएन आफरी जाहो, एने लुय पिन साक जाहो। <verse eid="EZK 39:19" /><verse number="20" style="v" sid="EZK 39:20" /><note caller="+" style="x"><char style="xo" closed="false">39:20 </char><char style="xt" closed="false"><ref loc="REV 19:17-18">प्रकाशितवाक्य 19:17-18</ref></char></note> तुमू मारा पाटला पोर गोड़ा, बोहणारे, बाहदुर, एने आखी बातीन बाहदेरान माह खाएन आफरी जाहो, बोगवान यहोवान ज्यो बोल हे।”<verse eid="EZK 39:20" /></para>
  <para style="s">इस्राएल ने पोशो बाणावणो</para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 39:21" />मी देस देसान विचीम मारी बोड़ाय देखाडुह, एने देसा देसान सोब माणहा माय मारा न्यायनिवाड़ान काम जो मी केरूह, एने मारो आथ जो ता पोर पोड़ी, देख लेती। <verse eid="EZK 39:21" /><verse number="22" style="v" sid="EZK 39:22" />ते दिह रेन ओंगाण इस्राएलान गेराणो जाण लेय काय यहोवा आमरो बोगवान हे। <verse eid="EZK 39:22" /><verse number="23" style="v" sid="EZK 39:23" />देसा देसान माणहे बी जाण लेती काय इस्राएलान गेराणो तान पापान कारेण जेली माय जायेल एतो; काहाकाय ता मार हेऱ्या ओहला बुरहो तोड्या काय मी मारो मुय फिराव लिदो एने तान दुसमोनान ताबाम केर दिनो, एने ता सोब तालवारी केरीन माराय गीया। <verse eid="EZK 39:23" /><verse number="24" style="v" sid="EZK 39:24" />मी तान एठाय एने पापान गेत ता हिऱ्यो वेवारो केरीन ता हिऱ्यो मारो मुय फिराव लिदो।<verse eid="EZK 39:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 39:25" />केरीन बोगवान यहोवा इही किथे, “एवी मी याकुबाह जेली माय रेन फिराव लावुह, एने इस्राएलान आखा गेराणा पोर गीण केरूह; एने मारा चोखाला नावान केरता माहु एतखाय एय। <verse eid="EZK 39:25" /><verse number="26" style="v" sid="EZK 39:26" />तेवी ता आखा बुरहो तोड़नेन कारेण जा ता मार विरूद केऱ्या ता लाजवाती; एने तान देसाम बिगेर बिन रेती; एने कुण ताह नाय बिगाड़े। <verse eid="EZK 39:26" /><verse number="27" style="v" sid="EZK 39:27" />जेवी मी ताह देसा देसान विचीम रेन फिराव लावुह, एने ता दुसमोनान देसाम रेन टुलो केरूह, तेवी जुलूम देसान नेजरी माय तान उगे रेन चोखालो ठेराह। <verse eid="EZK 39:27" /><verse number="28" style="v" sid="EZK 39:28" />तेवी ता जाण लेती काय यहोवा आमरो बोगवान हे, काहाकाय मी ताह देसा देसाम देरीन पुशो तान सोतान देसाम टुलो किरेल हे, मी ता माय रेन कुणीह पुशो पाराया देसाम नाय सोडु, <verse eid="EZK 39:28" /><verse number="29" style="v" sid="EZK 39:29" />एने तान उगे रेन मारो मुय पुशो केदी नाय फिरावो, काहाकाय मी इस्राएलान गेराणा पोर मारो जीव रोचवेल हे, बोगवान यहोवान ज्यो बोल हे।”<verse eid="EZK 39:29" /></para>
  <chapter eid="EZK 39" />
  <chapter number="40" style="c" sid="EZK 40" />
  <para style="s">जाणाव मोंदिरान देरसेन</para>
  <para style="r">(<ref loc="EZK 40:1">यहेजकेल 40:1</ref>; <ref loc="EZK 48:35">48:35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 40:1" />आमरो कोंडाणेन पोचीहवा वोरीह मतलब यरूशलेम हेयराह लेवाय जाणेन पासाण, चौदावा वोरह्यान पेल्ला मोयनान दोहवे दिह्याह, बोगवानान सेक्ती मार पोर आवी, एने तो माहु ताहरी पोचाड्यो। <verse eid="EZK 40:1" /><verse number="2" style="v" sid="EZK 40:2" />तान देरसेन माय बोगवान माहु इस्राएल देसाम पोचाड्यो, एने ताहरी एक जुलूम उचा बोयड़ा पोर उब राख्यो, जा पोर देक्षिण उगेन एगदा हेयरान गेत आकार इतो। <verse eid="EZK 40:2" /><verse number="3" style="v" sid="EZK 40:3" />जेवी जीव माहु ताहरी लेन गीयो ते मी काय देख्यो काय पितलान वेह दिरेल एने आथाम होणीन हुत एने मापणेन वाहण्यो लेय रियेल एक एदमी रिगण्या बायणा पोर उबरिनोह।<verse eid="EZK 40:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 40:4" />तो एदमी माहु केयो, “एय माणहान सोरा, तारा डोला केरीन देख, एने तारा काना केरीन हुमेल; एने जो काय मी तुवाह देखाडुह ता पोर द्यान दे, काहाकाय तु ज्यान केरता पोचाड़ाय जायेल हे काय मी तुवाह ज्यु वात देखाडु; एने जो काय तु दिखेह तो इस्राएल ने गेराणाह केय।”<verse eid="EZK 40:4" /></para>
  <para style="s">दिह उगतान फाटेक</para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 40:5" />
    <note caller="+" style="x">
      <char style="xo" closed="false">40:5 </char>
      <char style="xt" closed="false">
        <ref loc="1KI 6:1-38">1 राजा 6:1-38</ref>; <ref loc="2CH 3:1-9">2 इतिहास 3:1-9</ref></char>
    </note>एने दिखो, गेरान कावदेन एक बितड़ो एतो, मापणेन केरता वाहण्यो एतो, जान चोवड़ाय एने लांबाय तीन तीन मिटर एती, एने बितड़ान उचाय बी तीन मिटर एती। <verse eid="EZK 40:5" /><verse number="6" style="v" sid="EZK 40:6" />तेवी ती फाटेक ने जागे जान मुय पुर्व उगे एतो, तान निहणा पोर चेड़ीन फाटेक ने दुय ओटलान चोवड़ाय मापीन एक एक वाहण्यो बोर सापेड़नो। <verse eid="EZK 40:6" /><verse number="7" style="v" sid="EZK 40:7" />एक राखवाल्या खोल्यु वाहण्यो बोर लांबाय एने वाहण्यो बोर चोवड़ाय एती; एने दुय दुय खोल्युन गालो पाच आथान एतो; एने फाटेक ने ओटलो जो फाटेक ने ओसारान जागे गेरान उगे एती, तो बी वाहण्यो बोर एतो। <verse eid="EZK 40:7" /><verse number="8" style="v" sid="EZK 40:8" />तेवी तो फाटेक ने तो ओटलो जो गेरान सामने इतो, मापीन वाहण्यो बोर सापेड़नो। <verse eid="EZK 40:8" /><verse number="9" style="v" sid="EZK 40:9" />तो फाटेक ने ओटलो मापीन आठ आथ जुड़नो, एने तान खांबे दुय दुय आथ एता, एने फाटेक ने ओटला गेरान सामने एता। <verse eid="EZK 40:9" /><verse number="10" style="v" sid="EZK 40:10" />पुर्व फाटेक ने दुयू उगे तीन-तीन राखवाल्यु खोल्यु एत्यु ज्यु सोब एकुच मापान एत्यु, एने दुय उगेन खांब बी एकुच मापान एता।<verse eid="EZK 40:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 40:11" />ओवतो तो फाटेक ने बायणान चौड़ाय माप्या ते दोह आथ निकेलनी; एने फाटेक ने लांबाय माप्या ते तेरा आथ एती। <verse eid="EZK 40:11" /><verse number="12" style="v" sid="EZK 40:12" />दुयू उगेन राखवाल्यु खोल्युन ओंगाण आथ बोर जागो इतो एने दुयू उगे खोल्यु सोव सोव आथान एत्यु। <verse eid="EZK 40:12" /><verse number="13" style="v" sid="EZK 40:13" />ओवतो तो फाटेकीह एक उगेन राखवाली खोलीन साजा पोर रेन दिहरी उगेन राखवाली खोलीन साजा पोर वोर मापीन पोचीह आथान सेटी निकेलनी, एने बायणा आमने सामने एता। <verse eid="EZK 40:13" /><verse number="14" style="v" sid="EZK 40:14" />ओवतो तो साठ आथ खांबे माप्यो, एने खोलीन, फाटेकीन आस पास, खांबे वोर एतो। <verse eid="EZK 40:14" /><verse number="15" style="v" sid="EZK 40:15" />फाटेकीन बाहेरल्या बायणान ओंगाण लागतो तान माय वाला ओटलान ओंगाण वोर पाचाह आथ गालो एतो। <verse eid="EZK 40:15" /><verse number="16" style="v" sid="EZK 40:16" />राखवाली खोल्यु माय, एने फाटेकीन माय कावदेन खोल्युन विचीवाला खांबान विच विचीम जारावाल्यु खिड़क्यु एत्यु, एने खांबान ओटला माय बी तोहलाच एता, एने फाटेक माय कावदेन खिड़क्यु एत्यु; एने आखा खांबा पोर खजुरान जाड़े सितरायेल एता।<verse eid="EZK 40:16" /></para>
  <para style="s">बाहेरवाली खोली</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 40:17" />तेवी तो माहु बाहेरली खोलीम लेन गीयो; एने ती खोलीन कावदेन खोल्यु एत्यु; एने ताहरी एक फोरची बुणेल एती; जा पोर तीस खोल्यु बुणेल एत्यु। <verse eid="EZK 40:17" /><verse number="18" style="v" sid="EZK 40:18" />ज्यी फोरची मतलब बुंदेवाली फोरची फाटेक हेऱ्यो लिटकेल एतो एने तान लांबायीन गेत एतो।<verse eid="EZK 40:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 40:19" />ओवतो तो बुंदल्या फाटेक ने ओंगाण लागतो मायवाली खोलीन बाहेरली खोलीन ओंगाण वोर मापीन होव आथ निकेलनो; एने तो पुर्व एने उत्तर दुयू उगे ओहलोच एतो।<verse eid="EZK 40:19" /></para>
  <para style="s">उत्तेरवालो फाटेक</para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 40:20" />तेवी बाहेरली खोलीन उत्तरमुखी फाटेक ने लांबाय एने चोवड़ाय तो माप्यो। <verse eid="EZK 40:20" /><verse number="21" style="v" sid="EZK 40:21" />तान दुयू उगे तीन तीन राखवाल्यु खोल्यु एत्यु एने तान बी खांबान ओटलान माप पेल्ला फाटेक ने गेत एतो; तान लांबाय पाचाह एने चोवड़ाय पोचीह आथ एतो। <verse eid="EZK 40:21" /><verse number="22" style="v" sid="EZK 40:22" />तान बी खिड़क्यु एने खांबान ओटला एने खजुरान माप पुर्वमुखी फाटेक ने गेत एतो; एने ज्या पोर चेड़नेन सात पावत्र्यु एत्यु; एने तान ओंगाण तान ओटला एता। <verse eid="EZK 40:22" /><verse number="23" style="v" sid="EZK 40:23" />मायवाली खोलीन उत्तर एने पुर्वान उगे दिहरा फाटेक ने सामने फाटेक एता, एने तो फाटेक ने लांबाय मापीन देख्यो ते होव आथ निकेलनी।<verse eid="EZK 40:23" /></para>
  <para style="s">दक्षिणी फाटेक</para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 40:24" />पुशो तो माहु देक्षिण उगे लेन गीयो, एने देक्षिण उगे एक फाटेक इतो; एने तो तान खांबे एने खांबान ओटला बाणावीन मापीन दिख्यो ते तान माप तोहलाच एता। <verse eid="EZK 40:24" /><verse number="25" style="v" sid="EZK 40:25" />त्यु खिड़क्युन गेत तान एने तान खांबान ओटलान कावदेन बी खिड़क्यु एत्यु; तान लांबाय पाचाह एने चोवड़ाय पोचीह आथ एती। <verse eid="EZK 40:25" /><verse number="26" style="v" sid="EZK 40:26" />ता माय बी चेड़नेन केरता सात पावत्र्यु एत्यु एने तान सामने खांबान ओटला एता; एने तान दुयू उगेन खांबा पोर खजुरान जाड़े सितरायेल एता। <verse eid="EZK 40:26" /><verse number="27" style="v" sid="EZK 40:27" />देक्षिणान उगे बी मायवाली खोलीन एक फाटेक एतो, एने देक्षिण उगे दुयू फाटेक ने लांबाय माप्या ते होव आथ निकेलनी।<verse eid="EZK 40:27" /></para>
  <para style="s">मायवाली खोली एने देक्षिणी फाटेक</para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 40:28" />तेवी तो देक्षिण फाटेक लागतो माहु मायवाली खोलीम लेन गीयो, एने तो देक्षिण फाटेकाह माप्यो ते तोलोच निकेलनो। <verse eid="EZK 40:28" /><verse number="29" style="v" sid="EZK 40:29" />मतलब तान बी राखवाली खोल्यु, एने खांबान ओटला, सोब तोहलाच एता; एने तान खांबान ओटलान कावदेन बी खिड़क्यु एत्यु, एने त्युन लांबाय पाचाह आथ एने चोवड़ाय पोचीह आथान एती। <verse eid="EZK 40:29" /><verse number="30" style="v" sid="EZK 40:30" />तान कावदेन खांबान ओटला बी पोचीह आथ लांबा, एने पाचाह आथ चोवड़ा एता। <verse eid="EZK 40:30" /><verse number="31" style="v" sid="EZK 40:31" />तान खांबान ओटलो बाहेरल्या खोलीन उगे इतो, एने तान खांबा पोर बी खजुरान जाड़ान सितरायेल एता, ता पोर चेड़नेन आठ पावत्र्यु एत्यु।<verse eid="EZK 40:31" /></para>
  <para style="s">मायवाली खोली : दिह उगतान फाटेक</para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 40:32" />ओवतो तो एदमी माहु पुर्व उगे माय वाली खोलीम लेन गीयो, एने ती उगेन फाटेकाह माप्यो ते तोलोच निकेलनो। <verse eid="EZK 40:32" /><verse number="33" style="v" sid="EZK 40:33" />तान राखवाली खोल्यु एने खांबे एने खांबान ओटला, सोब तोहलाच एता; एने तान एने तान खांबान ओसारान कावदेन बी खिड़क्यु एत्यु; त्युन लांबाय पाचाह एने चोवड़ाय पोचीह आथ एती। <verse eid="EZK 40:33" /><verse number="34" style="v" sid="EZK 40:34" />ज्यान ओटलो बी बाहेरली खोलीन उगे इतो, तान दुयू उगेन खांबा पोर खजुरान जाड़े सितरायेल एता; एने ज्या पोर बी चेड़नेन आठ पावत्र्यु एत्यु।<verse eid="EZK 40:34" /></para>
  <para style="s">मायवाली खोली एने उत्तरवालो फाटेक</para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 40:35" />ओवतो तो एदमी माहु उत्तर वाली फाटेक ने जागे ली जाएन ताह माप्यो, एने तान बी माप तोलोच एतो। <verse eid="EZK 40:35" /><verse number="36" style="v" sid="EZK 40:36" />तान बी राखवाली खोल्यु एने खांबे एने तान ओटलो इतो; एने तान बी कावदेन खिड़क्यु एत्यु; त्युन लांबाय पाचाह आथ एने चौड़ाय पोचीह आथ एती। <verse eid="EZK 40:36" /><verse number="37" style="v" sid="EZK 40:37" />तान खांब बाहेरली खोलीन उगे एता, एने ता पोर बी दुयू उगे खजुरान जाड़े सितरायेल एता; एने ता माय चेड़नेन आठ पावत्र्यु एत्यु।<verse eid="EZK 40:37" /></para>
  <para style="s">उत्तेर फाटेक हेऱ्या खोल्यु</para>
  <para style="p">
    <verse number="38" style="v" sid="EZK 40:38" />पोशो फाटेक ने जागे खांबान आहने बायणा हेऱ्योच खोपड़ी एती, जाहरी होमबोली दोवाय जातालो। <verse eid="EZK 40:38" /><verse number="39" style="v" sid="EZK 40:39" />होमबोली पापबोली, एने दोसबोलीन जेनवेराह मारनेन केरता फाटेक ने ओसारान जागे तान दुयू उगे दुय दुय पाटला एता। <verse eid="EZK 40:39" /><verse number="40" style="v" sid="EZK 40:40" />उत्तेर फाटेक ने रिगण्या बायणा पोर, ओटलान बाहेर तान दुयू उगे, दुय दुय पाटला मिलेल एता। <verse eid="EZK 40:40" /><verse number="41" style="v" sid="EZK 40:41" />फाटेक ने दुयू उगे चार चार पाटला एता, आखा मिलीन आठ पाटला एता, जा जेनवार बोली मारनेन केरता एता। <verse eid="EZK 40:41" /><verse number="42" style="v" sid="EZK 40:42" />पोशो होमबोलीन केरता गिड़ेल देगड़ान चार पाटला एता, जा डेढ़ आथ लांबा एने डेढ़ आथ चोवड़ा, एने आथ बोर उचा एता, ता पोर होमबोली एने मेल मिलाप बोलीन जेनवेराह मारनेन आथ्‍यार मेलाय जाताला। <verse eid="EZK 40:42" /><verse number="43" style="v" sid="EZK 40:43" />माय कावदेन आकड़ा लागेल एता, एने पाटला पोर चेड़ावान माह मिलेल एतो,<verse eid="EZK 40:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="EZK 40:44" />मायवाली खोलीन उत्तरी फाटेक ने बाहेर गावणारान खोल्यु एत्यु जान बायणा देक्षिण उगे एता; एने पुर्वी फाटेक ने उगे एक खोली एती, जीन बायणो उत्तर उगे एतो। <verse eid="EZK 40:44" /><verse number="45" style="v" sid="EZK 40:45" />तो माहु केयो, ज्यी खोली, जान बायणो देक्षिण उगे हे, ता चाकऱ्यान केरता जा गेरान चोकसी केरतेह। <verse eid="EZK 40:45" /><verse number="46" style="v" sid="EZK 40:46" />एने जी खोलीन बायणो उत्तर उगे हे, तो ता चाकऱ्यान केरता हे जा वेदीन चोकसी केरतेह; ज्या सादोकान सोरा हेते, एने लेवीम रेन यहोवान सेवा केरनेन केरता फोक्ता ज्याच तान आहने जातेह।<verse eid="EZK 40:46" /></para>
  <para style="s">मायवाली खोली एने मोंदिरान गेर</para>
  <para style="p">
    <verse number="47" style="v" sid="EZK 40:47" />पोशो तो खोलीह मापीन चार खुण्यो मतलब होव आथ लांबो एने होव आथ चोवड़ो एतो; एने गेरान सामने वेदी एती। <verse eid="EZK 40:47" /><verse number="48" style="v" sid="EZK 40:48" />ओवतो तो माहु गेरान ओटला पोर लेन गीयो, एने ओटलान दुयू उगे खांबाह मापीन पाच पाच आथ आवो; एने दुयू फाटेक ने चोवड़ाय तीन तीन आथ एती। <verse eid="EZK 40:48" /><verse number="49" style="v" sid="EZK 40:49" />ओटलान लांबाय विह आथ एने चोवड़ाय इग्यार आथ एती; एने ता पोर चेड़नेन पावत्र्यु एत्यु; एने दुयू उगेन खांबान जागे पिलोर एता।<verse eid="EZK 40:49" /></para>
  <chapter eid="EZK 40" />
  <chapter number="41" style="c" sid="EZK 41" />
  <para style="p">
    <verse number="1" style="v" sid="EZK 41:1" />ओवतो तो एदमी माहु मोंदिरान जागे ली गीयो, एने तान दुयू उगेन खांबाह मापीन सोव सोव आथ काड्या, ज्यी ते तोम्बुन चोवड़ाय एती। <verse eid="EZK 41:1" /><verse number="2" style="v" sid="EZK 41:2" />बायणान चोवड़ाय दोह आथान एती, एने बायणान दुयू उगे बितड़ान चोवड़ाय पाच पाच आथान एती; तो माहु मोंदिरीन लांबाय मापीन चालीह आथान एने तान चौड़ाय विह आथान एती। <verse eid="EZK 41:2" /><verse number="3" style="v" sid="EZK 41:3" />तेवी तो माय जाएन, बायणान खांबाह माप्यो, एने दुय दुय आथान एतो; एने बायणो सोव आथान एतो; एने बायणान चोवड़ाय सात आथान एतो। <verse eid="EZK 41:3" /><verse number="4" style="v" sid="EZK 41:4" />तेवी तो मायवाला गेरान लांबाय एने चोवड़ाय विह विह आथ निकेलनी; एने तो माहु केयो, “ज्यो ते जुलूम चोखालो जागो हे।”<verse eid="EZK 41:4" /></para>
  <para style="s">मोंदिरान खोल्यु</para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 41:5" />पुशो तो गेरान बितड़ाह मापीन सोव आथ निकेलनो, एने गेरान आहने पाहने चार चार आथ चोवड़ी बाहेरली खोल्यु एत्यु। <verse eid="EZK 41:5" /><verse number="6" style="v" sid="EZK 41:6" />ज्यु बाहेरल्यु खोल्यु तीन ताल्यु एत्यु; एने एक एक मेहलाम तीस तीस खोल्यु एत्यु। गेरान आहने पाहने बितड़ो ज्यान केरता एतो काय बाहेरली खोल्यु तान आसरे रेय; ताच माय खोल्युन केड्यु बोहाड़ेल एत्यु एने गेरान बितड़ान आसरे नाह एती। <verse eid="EZK 41:6" /><verse number="7" style="v" sid="EZK 41:7" />गेरान आहने पाहने ज्यु खोल्यु बाहेर एत्यु, त्यु माय रेन ज्यु उपेर एत्यु, त्यु जुलूम चोवड्यु एत्यु; मतलब गेरान आहने पाहने जो काय बुणेल एतो, जीहे जीहे उपेरली उगे चिड़ते गीयो तिहे तिहे चोवड़ो इते गीयो; इही केरीन, ज्या गेरान चोवड़ाय उपेरली उगे वोदेल एती, एने माणहे नेचली तालीन विचीम रेन उपेरली ताली माय चेड़ सेकताला। <verse eid="EZK 41:7" /><verse number="8" style="v" sid="EZK 41:8" />पुशो मी गेरान आहने पाहने उचाली बुय दिख्यो, एने बाहेरल्यु खोल्युन उचाय जोड़ वोर सोव आथान वाहण्यान एती। <verse eid="EZK 41:8" /><verse number="9" style="v" sid="EZK 41:9" />बाहेरल्यु खोल्युन केरता जो बितड़ो एतो, तो पाच आथ जाड़ो एतो, एने जो जागो ठाल्लो रेय जायेल इतो, तो गेरान बाहेरल्यु खोल्युन जागो इतो। <verse eid="EZK 41:9" /><verse number="10" style="v" sid="EZK 41:10" />बाहेरल्यु खोल्युन विच विचीम गेरान आस पास विह आथान गालो एतो। <verse eid="EZK 41:10" /><verse number="11" style="v" sid="EZK 41:11" />बाहेरल्यु खोल्युन जागो ता जागा उगे इतो, जो ठाल्लो इतो, मतलब एक बायणो उत्तर उगे एने दिहरो देक्षिण उगे एतो; एने जो जागो रेय गीयो, तान चोवड़ाय कावदेन पाच पाच आथान एतो।<verse eid="EZK 41:11" /></para>
  <para style="s">बुड़ता उगेवालो गेर</para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 41:12" />पोशो जो गेर मोंदिरान पश्‍चिम उगे खोलीन सामने इतो, तो सेत्तेर आथ चोवड़ो इतो; एने गेरान आस पास ने बितड़ो पाच आथ जाड़ा एतो, एने तान लांबाय नोव्वद आथान एती।<verse eid="EZK 41:12" /></para>
  <para style="s">मोंदिरान पुरो माप</para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 41:13" />तेवी तो गेरान लांबाय मापीन होव आथ वोर किऱ्‍यो, एने बितड़ा हेऱ्योच खोलीन बी लांबाय माप्यो ते होव आथ एती। <verse eid="EZK 41:13" /><verse number="14" style="v" sid="EZK 41:14" />मोंदिरान सामनेवालो पुर्वी ईसो एने तान खोली होव आथ चोवड़ी एती। <verse eid="EZK 41:14" /><verse number="15" style="v" sid="EZK 41:15" />पोशो तो पासाणल्यी खोलीन सामनेवालो बितड़ान लांबाय जान उगे दुयू उगे साजा एता, माप्यो होव आथान काड्यो; एने मायवालो गेर एने खोलीन ओटलाह बी माप्यो।<verse eid="EZK 41:15" /></para>
  <para style="s">मोंदिरीन हिंगार</para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 41:16" />तेवी तो ओटला एने जालीवाली खिड़क्युन, एने आहने पाहनेन तीन तालीन साजाह माप्यो जो ओटलान सामने एतो, एने कावदेन तान चोवकट बांदायेल एता; एने बुई रेन खिड़क्यु वोर एने खिड़क्युन आहने पाहने सोब चोवकट बांद मिलेल एतो। <verse eid="EZK 41:16" /><verse number="17" style="v" sid="EZK 41:17" />ओवतो तो बायणान उपेरल्यो जागो मायवाला गेराम वोर तान बाहेर बी एने आहने पाहनेन आखा बितड़ा माय एने बाहेर बी माप्यो। <verse eid="EZK 41:17" /><verse number="18" style="v" sid="EZK 41:18" />ता माय करूब एने खजुरान जाड़ ओहला सितरायेल एता, काय दुय दुय करूबान विचीम एक एक खजुरान जाड़ एतो; एने करूबान दुय दुय मुख एता। <verse eid="EZK 41:18" /><verse number="19" style="v" sid="EZK 41:19" />इह केरीन एक एक खजुरान एक उगे माणहान मुख बाणायेल एतो, एने दिहरी उगे जुवान सिंहान मुख बाणायेल एतो, इह केरीन आखा गेरान कावदेन बुणेल एतो। <verse eid="EZK 41:19" /><verse number="20" style="v" sid="EZK 41:20" />बुई रेन ते बायणा पोर वोर करूब एने खजुरान जाड़ सितरायेल एता, मोंदिरान बितड़ो इह केरीन बुणेल एतो।<verse eid="EZK 41:20" /></para>
  <para style="s">लाकड़ान वेदी</para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 41:21" />गेरान बायणान खांब चोवकेण्या एता, एने चोखाला जागान सामने वेदीन गेत काह एतो। <verse eid="EZK 41:21" /><verse number="22" style="v" sid="EZK 41:22" />तो लाकड़ान वेदीन गेत एतो, एने तान उचाय तीन आथ, एने लांबाय दुय आथ एती; एने तान कोपरा एने तान आखो पाट एने अलंग बी लाकड़ान एता, एने तो माहु केयो, “ज्य ते यहोवान सामनेवालो पाटलो हे।”<verse eid="EZK 41:22" /></para>
  <para style="s">चोखाला जागान बायणो</para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 41:23" />मोंदिर एने चोखाला जागान बायणान दुय दुय किवाड़ा एता। <verse eid="EZK 41:23" /><verse number="24" style="v" sid="EZK 41:24" />एने आखा किवाड़ाम दुय दुय वोलनारे पेल्ले एता, आखा किवाड़ान केरता दुय दुय पेल्ले। <verse eid="EZK 41:24" /><verse number="25" style="v" sid="EZK 41:25" />जीहे मोंदिरान बितड़ा माय करूब एने खजुरान जाड़े सितरायेल एता, तिहेच केरीन किवाड़ा माय बी एता, एने ओटलान बाहेरली उगे लाकड़ान जाड़ जाड्यु देरने एता। <verse eid="EZK 41:25" /><verse number="26" style="v" sid="EZK 41:26" />ओटलान दुयू उगे जालीवाली खिड़क्यु एत्यु एने खजुरान जाड़े सितरायेल एता; एने गेरान बाहेरल्यु खोल्यु एने जाड़ जाड्यु देरने बी एता।<verse eid="EZK 41:26" /></para>
  <chapter eid="EZK 41" />
  <chapter number="42" style="c" sid="EZK 42" />
  <para style="s">मोंदिरान आहने दुय खोल्यु</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 42:1" />पुशो तो एदमी माहु बाहेरली खोली माय उत्तर उगे लेन गीयो, एने माहु त्यु खोल्युन जागे लावो जो गेरान खोलीन सामने एने उत्तर उगे एती। <verse eid="EZK 42:1" /><verse number="2" style="v" sid="EZK 42:2" />होव आथान लांबाय पोर बायणो एतो, एने चोवड़ाय पाचाह आथान एती। <verse eid="EZK 42:2" /><verse number="3" style="v" sid="EZK 42:3" />मायवाली खोलीन विह आथ सामने एने बाहेर खोलीन फोरचीन सामने तीन मेहलाम साजा एता। <verse eid="EZK 42:3" /><verse number="4" style="v" sid="EZK 42:4" />खोल्युन सामने माय उगे जाणार दोह आथ चोवड़ी एक वाट एती; एने आथ बोरीन एक उंजु वाट एती; एने खोल्युन बायणा उत्तर उगे एता। <verse eid="EZK 42:4" /><verse number="5" style="v" sid="EZK 42:5" />उपेरली खोल्यु आत्यु एत्यु, मतलब, साजान कारेण नेचली एने विचीमवाली खोल्युह रेन आत्यु एत्यु। <verse eid="EZK 42:5" /><verse number="6" style="v" sid="EZK 42:6" />काहाकाय त्यु तीन ताल्यु एत्यु, एने खोल्युन गेत तान खांबे नाह एता; केरीन उपेरली खोल्यु नेचल्यु एने विचीमवाल्यु खोल्युह रेन आत्यु एत्यु। <verse eid="EZK 42:6" /><verse number="7" style="v" sid="EZK 42:7" />जा बितड़ा खोल्युन बाहेर तान आहने पाहने एत्यु मतलब खोल्युन सामने बाहेरल्यु खोलीन उगे एती, तान लांबाय पाचाह आथान एती। <verse eid="EZK 42:7" /><verse number="8" style="v" sid="EZK 42:8" />काहाकाय बाहेरली खोलीन खोल्यु पाचाह आथ लांबी एने मोंदिरान सामनेवालो अलंग होव आथान एती। <verse eid="EZK 42:8" /><verse number="9" style="v" sid="EZK 42:9" />ज्य खोल्युन बुंदे पुर्व उगे वाट एती, जाहरी माणहे बाहेरली खोलीम रेन ता माय जाताला। <verse eid="EZK 42:9" /><verse number="10" style="v" sid="EZK 42:10" />खोलीन बितड़ान चोवड़ाय माय पुर्व उगेन आंगे जागो एने गेर दुयून सामने खोल्यु एत्यु। <verse eid="EZK 42:10" /><verse number="11" style="v" sid="EZK 42:11" />तान सामनेन वाट उत्तरी खोल्युन वाटीन गेत एतो; तान लांबाय चोवड़ाय बाराबोर एती एने बाणावोट एने बाणावोट तान बायणान गेत एती। <verse eid="EZK 42:11" /><verse number="12" style="v" sid="EZK 42:12" />देक्षिण खोल्युन बायणान गेत वाटी कोपरा पोर बायणो एतो, मतलब पुर्व उगेन बितड़ान सामने, जा रेन माणहे ता माय रिगताला।<verse eid="EZK 42:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 42:13" />ओवतो तो माहु केयो, “ज्या उत्तरी एने देक्षिण खोल्यु जो खोल्युन सामने हेत्यु, त्युच चोखाल्यु खोल्युह जा माय बोगवान आहने जाणार चाकऱ्या जेलेम चोखाला वोस्तु खाया केरती, ता आखाम रेन हाज्यु वोस्तु, एने एनबोली, एने पापबोली, एने दोसबोली, ताच मेलती; काहाकाय तो चोखालो जागो हे <verse eid="EZK 42:13" /><verse number="14" style="v" sid="EZK 42:14" />जेवी जेवी चाकऱ्या माणहे माय जाती, तेवी निकेलने बुखेत ता चोखाला जागाम रेन बाहेर खोली माय ओहलाच निकेलती, मतलब ता पेल तान सेवा केरनेन फाड़का चोखाला जागाम मेल देती; काहाकाय ज्यु खोल्यु चोखाल्यु हेत्यु, तेवी ता दिहरा फाड़का पेरीन सादा माणहान जागे जाती।”<verse eid="EZK 42:14" /></para>
  <para style="s">मोंदिर वाला जागान माप</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 42:15" />जेवी तो मायवाला गेराह माप लिदो, तेवी माहु पुर्व दिशान फाटेक ने वाटे रेन बाहेर ली जाएन बाहेर ले जागे कावदेन मापणे बाज गीयो। <verse eid="EZK 42:15" /><verse number="16" style="v" sid="EZK 42:16" />तो पूर्वी उगेन मापणेन वाहण्या केरीन मापीन पाच होव वाहण्यो एतो। <verse eid="EZK 42:16" /><verse number="17" style="v" sid="EZK 42:17" />तेवी तो उत्तर उगेन मापणेन वाहण्या केरीन मापीन पाच होव वाहण्यो काड्यो। <verse eid="EZK 42:17" /><verse number="18" style="v" sid="EZK 42:18" />तेवी तो देक्षिण उगेन मापणेन वाहण्या केरीन मापीन पाच होव वाहण्यो काड्यो। <verse eid="EZK 42:18" /><verse number="19" style="v" sid="EZK 42:19" />एने पश्चिम उगे फिरीन तो मापणेन वाहण्या केरीन मापीन ताह पाच होव वाहण्यो काड्यो। <verse eid="EZK 42:19" /><verse number="20" style="v" sid="EZK 42:20" />तो ता जागान चारू एद्दी माप्यो, एने तान कावदेन एक बितड़ो एतो, तो पाच होव वाहण्यो लांबो एने पाच होव वाहण्यो चोवड़ो एतो; एने ज्यान केरता बुणेल एती काय चोखालो एने आखो सादाह आंगे आंगे केरी।<verse eid="EZK 42:20" /></para>
  <chapter eid="EZK 42" />
  <chapter number="43" style="c" sid="EZK 43" />
  <para style="s">मोंदिर माय बोगवानान उजाला</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 43:1" />ओवतो तो एदमी माहु ता फाटेक ने जागे ली गीयो जो पुर्वमुखी एतो। <verse eid="EZK 43:1" /><verse number="2" style="v" sid="EZK 43:2" />तेवी इस्राएलान बोगवानान उजालो पुर्व दिशा उगे रेन आवो; एने तान बोल जुलूम होवटा पाण्यान खेकलान गेत एनो; एने तान उजाला माय देरती पोर उजालो एनो। <verse eid="EZK 43:2" /><verse number="3" style="v" sid="EZK 43:3" />ज्यो देरसेन तान गेत एतो, जो मी ता हेयराह खेतेम केरनेन टेम माय आवतालो दिखेल इतो; एने ता देरसेनान गेत, जो मी कबार नेदीन मीरे दिखेल इतो; एने मी मुयान बोरहे जाय पुड़नो। <verse eid="EZK 43:3" /><verse number="4" style="v" sid="EZK 43:4" />तेवी बोगवानान उजालो ता फाटेक माय लागतो जो पुर्वमुखी एतो, गेराम आव लागो। <verse eid="EZK 43:4" /><verse number="5" style="v" sid="EZK 43:5" />तेवी बोगवानान जीव माहु उठाड़ीन माय खोली माय पोचाड्यो; एने बोगवानान उजालो गेराम बोराय रियेल एतो। <verse eid="EZK 43:5" /><verse number="6" style="v" sid="EZK 43:6" />तेवी मी एक जाणान बोल हुमल्यो, जो गेराम रेन मार हिऱ्यो वातु केरने बाज रियेल एतो, एने तो माणुह मार आहने उबरियेल एतो। <verse eid="EZK 43:6" /><verse number="7" style="v" sid="EZK 43:7" />तो माहु केयो, “एय माणहान सोरा, बोगवानान ज्यो बोल हे, ज्यो मार राजगादिन जागो हे एने मारो पाय मेलनेन जागो हे, जाहरी मी इस्राएल हिऱ्यो जेलेम रेह, एने नाय ते इस्राएलान गेराणो एने नाय तान राजा सिनाल से तान उचाला जागाम तान राजान देड़ान द्वारा मारो चोखाला नावाह पोशा एठो ठेरावती। <verse eid="EZK 43:7" /><verse number="8" style="v" sid="EZK 43:8" />ता तान ओटलो मार ओटलान जागे, एने तान बायणान खांबे मारा बायणान खांबान आहने बाणावताला, एने मारो एने तान विचीम निस्तो बितड़ोच एतो, एने ता तान खाराब कामा केरीन मारा चोखाला नावाह एठो ठेरायेल एता; केरीन मी राग केरीन ताह खेतेम किऱ्यो। <verse eid="EZK 43:8" /><verse number="9" style="v" sid="EZK 43:9" />एवी ता तान सिनालो एने तान राजान देड़े मार हेऱ्या रेन सेटा केर देय, तेवी मी तान विचीम जेलेम रेया केरूह।”<verse eid="EZK 43:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 43:10" />एय माणहान सोरा, तु इस्राएल ने गेराणाह मार गेरान नमुनो एने बाणावोट देखाड़ दे, ज्यान वोजेसे ता तान एदेरमान केरता लाजवाती, <verse eid="EZK 43:10" /><verse number="11" style="v" sid="EZK 43:11" />केदी ता तान आखा कामाह लाजवाय, ते ताह ज्या गेरान आकार एने वेह, एने ज्यान बाहेर माय आवणे जाणेन वाट, एने ज्यान सोब आकार एने विद्यु, नेम किज्यो, एने तान सामने लेख मिलज्यो ता माय ज्यान आकार एने ज्यान सोब विद्यु एर केरीन तान गेत केरी <verse eid="EZK 43:11" /><verse number="12" style="v" sid="EZK 43:12" />गेरान नेम ज्यो हे काय बोयड़ान चुटान कावदेन पुरो बाग जेलेम चोखो हे, देख गेरान नेम ज्योच हे।<verse eid="EZK 43:12" /></para>
  <para style="s">वेदीन बाणावोट</para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 43:13" />ओहला आथा केरीन जो सादा आथाह रेन चार आंगल्या वोदार रेय, वेदीन माप ज्यो, मतलब तान आदार एक आथान, एने चोवड़ाय एक आथान, एने तान कावदेन सेवड़ा पोर ली पोट्टी चारान। एने वेदीन उचाय ज्यी हे। <verse eid="EZK 43:13" /><verse number="14" style="v" sid="EZK 43:14" />बुई पोर देराईल आदार रेन नेचली कुड़ची वोर दुय आथ बोर उचाय रेय, एने तान चोवड़ाय आथ बोर जुवे; एने आतली कुड़ची रेन मोटली कुड़ची वोर चार आथान रेय, एने तान चोवड़ाय आथ बोर रेय। <verse eid="EZK 43:14" /><verse number="15" style="v" sid="EZK 43:15" />एने उपेरल्यो बाग चार आथ उचो रेय; एने वेदी पोर हेलगाड़नेन जागान चार हिंगे उपेरली उगे निकलेल रेय। <verse eid="EZK 43:15" /><verse number="16" style="v" sid="EZK 43:16" />वेदी पोर हेलगाड़नेन जागो चोवकोण्यो मतलब बारा आथ लांबो एने बारा आथ चोवड़ो रेय। <verse eid="EZK 43:16" /><verse number="17" style="v" sid="EZK 43:17" />नेचली कुड़ची चोवदा आथ लांबी एने चोवदा आथ चोवड़ी, एने तान कावदेन पोट्टी आदा आथान रेय, एने तान आदार कावदेन आथ बोर रेय। तान निहणो तान पुर्व उगे रेय।<verse eid="EZK 43:17" /></para>
  <para style="s">वेदीन अर्पण</para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 43:18" />ओवतो तो माहु केयो, “एय माणहान सोरा, बोगवान यहोवा इही किथे, जे दिह होमबोली चेड़ावणे एने लुय हिपड़नेन केरता वेदी बाणवाय जाय, ते दिह ने दिह्यान विद्यु ज्यु ठेराती। <verse eid="EZK 43:18" /><verse number="19" style="v" sid="EZK 43:19" />मतलब लेवी चाकऱ्या माणहे, जा सादोकान सोरा हेते, एने मारी सेवा केरनेन मार आहने रेतेह, ताह तु पापबोलीन केरता एक वासड़ो आपज्ये, बोगवान यहोवान ज्यो बोल हे। <verse eid="EZK 43:19" /><verse number="20" style="v" sid="EZK 43:20" />तेवी तु तान लुयीम रेन थोड़ोक लेन वेदीन चारू हिंगे एने कुड़चीन चारू कोपरा एने कावदेन पोट्टयु पोर लागाड़ज्ये; इह केरीन तान केरता पाचतावो केरीन ताह चोखो किरज्ये। <verse eid="EZK 43:20" /><verse number="21" style="v" sid="EZK 43:21" />तेवी पापबोलीन वासड़ाह लेन, गेरान चोखाला जागान बाहेर ठेरायेल जागे हेलगाड़ दिज्ये। <verse eid="EZK 43:21" /><verse number="22" style="v" sid="EZK 43:22" />दिहरी दिह एक निर्दोस बुकोड़ पापबोली केरीन चेड़ावज्ये; एने जीहे वासड़ा केरीन वेदी चोखी केराय जाय, तिहेच केरीन ज्या बोकड़ा केरीन बी चोखी केराय जाय। <verse eid="EZK 43:22" /><verse number="23" style="v" sid="EZK 43:23" />जेवी तु ताह चोखो केर लिहे, तेवी एक निर्दोस वासड़ो एने निर्दोस मेंडो चेड़ावज्ये। <verse eid="EZK 43:23" /><verse number="24" style="v" sid="EZK 43:24" />तु ताह बोगवानान सामने ली यावज्ये, एने चाकऱ्या माणहे ता पोर मिठ टाकीन ताह बोगवानान केरता होमबोली केरीन चेड़ावे। <verse eid="EZK 43:24" /><verse number="25" style="v" sid="EZK 43:25" />सात दिह वोर दाड़ीन पापबोलीन केरता बुकोड़ तियार किरज्ये, एने निर्दोस वासड़ो एने मेंड्रा माय रेन निर्दोस मेंडो बी तियार केराय जाय। <verse eid="EZK 43:25" /><verse number="26" style="v" sid="EZK 43:26" />सात दिह वोर चाकऱ्या माणहे वेदीन केरता पाचतावो केरीन ताह चोखो किरते रेय; इह केरीन तान संस्कार रेय। <verse eid="EZK 43:26" /><verse number="27" style="v" sid="EZK 43:27" />जेवी ता दिह निवरी जाती, तेवी आठवा दिह्यान पासाण चाकऱ्या माणहे तुमरा होमबोली एने मेल मिलाप बोली वेदी पोर चेड़ाया केरी; तेवी मी तुमू पोर खुस एह, बोगवान यहोवान ज्यो बोल हे।”<verse eid="EZK 43:27" /></para>
  <chapter eid="EZK 43" />
  <chapter number="44" style="c" sid="EZK 44" />
  <para style="s">पुर्वी बायणान वापेर</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 44:1" />पुशो तो एदमी माहु चोखाला जागान ता बाहेरल्या फाटेक ने जागे फिराव ली गीयो, जो पुर्वमुखी हे; एने तो बोंद एतो। <verse eid="EZK 44:1" /><verse number="2" style="v" sid="EZK 44:2" />तेवी यहोवा माहु केयो, “ज्य फाटेक बोंद रेय एने उगाड़ाय नाय जाय; कुण ज्याम लागतो माय जाणे नाय जुवे; काहाकाय इस्राएलान बोगवान यहोवा ता माय लागतो माय आयेल हे; केरीन ज्य बोंद रेय। <verse eid="EZK 44:2" /><verse number="3" style="v" sid="EZK 44:3" />फोक्ता मुखीच मुखी रेणेन कारेण बोगवानान सामने खाणो खाणेन ताहरी बोही; तो फाटेक ने ओटला पोर लागतो माय जाय, एने ताच माय लागतो निकले।”<verse eid="EZK 44:3" /></para>
  <para style="s">मोंदिराम रिगणेन नेम</para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 44:4" />ओवतो तो उत्तरी फाटेक ने जागे लागतो माहु गेरान सामने ली गीयो; तेवी मी दिख्यो काय यहोवान गेर यहोवान ताकेत माय बोराय जायेल हे; एने मी मुयान बोरहे जाय पोड़नो। <verse eid="EZK 44:4" /><verse number="5" style="v" sid="EZK 44:5" />तेवी बोगवान माहु केयो, “एय माणहान सोरा, हास केरीन तारा डोला केरीन देख, एने जो काय मी तुवाह मारा गेरान सोब विद्यु एने नेमान बाराम केव, तो सोब तारा काना केरीन हुमेल एने गेरान रिगणो एने चोखाला जागान सोब वातु पोर द्यान दे।”<verse eid="EZK 44:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 44:6" />एने ता विरोदी मतलब इस्राएलान गेराणाह किज्ये, बोगवान यहोवा इही किथे, “एय इस्राएलान गेराणा तुमरा सोब खाराब कामाम रेन एवी आथ सेटा किरो। <verse eid="EZK 44:6" /><verse number="7" style="v" sid="EZK 44:7" />जेवी तुमू मारो खाणो मतलब चेरबी एने लुय चेड़ावताला, तेवी तुमू बिराने माणहाह जा मोन एने डिल दुयान बिगेर खेतनान एता, मारा चोखाला जागाम आवणे देताला काय ता मारा गेराह एठो केरी; एने ता मारी वाचाह तोड़ देना ता माय तुमरा सोब खाराब काम वोदते गीया। <verse eid="EZK 44:7" /><verse number="8" style="v" sid="EZK 44:8" />तुमू मारी चोखाली वोस्तुन होमाल नाह केऱ्या, पुण तुमू तुमराच मोना केरीन दिहरा माणहाह मारा चोखाला जागाम मारी वोस्तुन होमाल केरनारे ठेराया।”<verse eid="EZK 44:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 44:9" />केरीन बोगवान यहोवा इही किथे, “इस्राएली माणहान विचीम जोला दिहरा माणहे एती, जा मोन एने डिल दुयान बिगेर खेतनान हेते, ता माय रेन कुण मारा चोखाला जागाम आवणे नाय जुवे।”<verse eid="EZK 44:9" /></para>
  <para style="s">लेवी चाकऱ्यान पोद ने केरता आंगे केराना</para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 44:10" />“पुण लेवी माणहे जा ती टेम माय मार हेऱ्या रेन सेटा एय जायेल एता, जेवी इस्राएली माणहे माहु सोड़ीन तान मुरतान पासाण बोटेक जायेल एता, ता तान पापान बार विसती। <verse eid="EZK 44:10" /><verse number="11" style="v" sid="EZK 44:11" />पुण ता मारा चोखाला जागाम फिरनारे बोणीन गेरान फाटेक ने पेहरो देणारे एने गेराम सेवान काम केरती; होमबोली एने मेल मिलाप बोलीन जेनवार माणहान केरता मारे, एने तान सेवा केरनेन तान सामने उब रेया केरी। <verse eid="EZK 44:11" /><verse number="12" style="v" sid="EZK 44:12" />काहाकाय इस्राएलान गेराणान सेवा केरनो ता तान मुरतान ओंगाण केरताला, एने तान ठुकोर खाणे एने पापाम फोसणेन कारेण बोण जायेल एता; केरीन मी तान बाराम सुगोण खायेल हे, काय ता तान पापान बार विसे, बोगवान यहोवान ज्यो बोल हे। <verse eid="EZK 44:12" /><verse number="13" style="v" sid="EZK 44:13" />ता मार आहने आवणे नाय जुवे, एने नाह मार केरता चाकऱ्यान काम केरी; एने नाह मारी एगदी चोखाली वोस्तुह नाहते एगदी जुलूम चोखाली वोस्तुह आथेलने जुवे; ता तान लाजीन एने जा खाराब कामे ता केऱ्या तान बी बार विसे। <verse eid="EZK 44:13" /><verse number="14" style="v" sid="EZK 44:14" />तीबी मी ताह गेरामवाली होपायेल वोस्तुन होमालनार ठेरावुह; ता माय सेवान जोलो काम एय, एने जो काय ता माय केरनो एय, ताह केरनारे ताच रेती।”<verse eid="EZK 44:14" /></para>
  <para style="s">चाकऱ्यो</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 44:15" />ओवता लेवी चाकऱ्या जा सादोकान सोरा हेते, एने जा ती टेम मारा चोखाला जागान होमाल केऱ्या, जेवी इस्राएली मार हेऱ्या रेन बोटकी जायेल एता, ता मारी सेवा केरनेन मारी आहने आया केरी, एने माहु चेरबी एने लुय चेड़ावणेन केरता मार आहने उब रेया केरी; बोगवान यहोवान ज्यो बोल हे। <verse eid="EZK 44:15" /><verse number="16" style="v" sid="EZK 44:16" />ता मारा चोखाला जागाम आया केरी, एने मारा पाटलान जागे मारी सेवा केरनेन आवी एने मारी वोस्तुन होमाल केरी। <verse eid="EZK 44:16" /><verse number="17" style="v" sid="EZK 44:17" />जेवी ता माय खोलीन फाटेक लागता जाया केरी, तेवी होणान फाड़का पेरीन जाय, एने जेवी ता माय खोलीम फाटेक माय नाहते ता माय सेवा केरतेती, तुलबूखे कुण रोचकान फाड़का नाय पिरे। <verse eid="EZK 44:17" /><verse number="18" style="v" sid="EZK 44:18" />ता मुंडी पोर होणान होबात्यु टोप्यु पेरीन एने कोमराम होणान खोचटो पिरेल रेय; काल्ला ओहला फाड़का केरीन ता कोमेर नाय बांदे जा केरीन उबारो निकलेह। <verse eid="EZK 44:18" /><verse number="19" style="v" sid="EZK 44:19" />जेवी ता बाहेर खोलीम माणहा फाय आवी, तेवी जा फाड़का पेरीन सेवा केरताला, ताह काड़ीन एने चोखाल्यु खोल्युम मेलीन दिहरा फाड़का पिरे, जा माय माणहे तान फाड़कान कारेण चोखाला नाय बुणे।<verse eid="EZK 44:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 44:20" />नाय ते ता मुंड बोड़ावे, एने नाय लेट्या लांबा एणे नाय दे; ता फोक्‍तो तान लेट्या काटाड़े। <verse eid="EZK 44:20" /><verse number="21" style="v" sid="EZK 44:21" />मायवाली खोलीम जाणेन बुखेत एगदो चाकऱ्यो अंगुरान रोह नाय पिय। <verse eid="EZK 44:21" /><verse number="22" style="v" sid="EZK 44:22" />ता रांडायेल बायकुह नाहते सुड़ेल बायकुह वाराड़ नाय केर लेय; फोक्‍तो इस्राएल गेराणान वोसी माय रेन कुवारली नाहते ओहली रांडायेल बायकु वाराड़ केर ले, जी एगदी चाकऱ्यान बायकु बोणनी एय।<verse eid="EZK 44:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 44:23" />ता मारी पोरजाह चोखाला एठायीन वात हिकाड्या केरी, एने चोखो एठान फारेख केय, <verse eid="EZK 44:23" /><verse number="24" style="v" sid="EZK 44:24" />एने जेवी एगदो फिसलो एय, तेवी न्यायनिवाड़ो केरनेन बी ताच बोही; एने मारा नेमान गेत न्यायनिवाड़ो केरी, मारा सोब ठेरायेल तिवारान बाराम बी ता मारा कायदाह एने विद्युह पालते रेय, एने मारा विहेवणेन दिह्याह चोखालो माने।<verse eid="EZK 44:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 44:25" />ता एगदा माणहान देड़ान जागे नाय जाय; फोक्‍तो आहख आबोख, बाहख एने ओहली बोणीख ने देड़ान कारेण जान वाराड़ निह एनो एय, ता सोताह एठो केर सेकतेह। <verse eid="EZK 44:25" /><verse number="26" style="v" sid="EZK 44:26" />जेवी ता एठा एय जाती, तेवी तान केरता सात दिह गेणाय जाय, एने तेवी ता चोखा बुणे। <verse eid="EZK 44:26" /><verse number="27" style="v" sid="EZK 44:27" />एने जे दिह ता चोखालो जागो मतलब मायवाली खोलीम सेवा केरनेन पोशा रिगी, ते दिहच सोतान केरता पापबोली चेड़ावे, बोगवान यहोवान ज्यो बोल हे।<verse eid="EZK 44:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 44:28" />“तान एकुच सोतान ईसो रेय, मतलब तान बाग मीच हे; तुमू ताह इस्राएलान विचीम काह ओहली बुय नाय आपी, ज्यी तान सोतान बुणे; तान सोतान बुय मीच हे। <verse eid="EZK 44:28" /><verse number="29" style="v" sid="EZK 44:29" />ता एन बेट, पापबोली एने दोसबोली खाया केरी; एने इस्राएल माय जी वोस्तु चेड़ावाय जाय, ती ताह जुड्या केरी। <verse eid="EZK 44:29" /><verse number="30" style="v" sid="EZK 44:30" />एने आखी बातीन आखान पेल्‍ली पाक एने सोब बातीन विसेल वोस्तु जी तुमू विसीन बेट चेड़ावो, चाकऱ्याह जुड्या केरी; एने नोवालो एनान पेल्लो कुहणेल फिट बी चाकऱ्याह आप्या किरज्‍यो, जा से तुमरा गेराम बोरकेत रेय। <verse eid="EZK 44:30" /><verse number="31" style="v" sid="EZK 44:31" />जो काय जीवेच मुरे नाहते फाड़ाय गीयो एय, नाहते चिड़ो नाहते जेनवार तान माह चाकऱ्यो नाय खाय।”<verse eid="EZK 44:31" /></para>
  <chapter eid="EZK 44" />
  <chapter number="45" style="c" sid="EZK 45" />
  <para style="s">देसान बुई माय बोगवानान ईसो</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 45:1" />जेवी तुमू चिट्ठी टाकीन देसाह वाटहो, तेवी देसा माय रेन एक बाग चोखालो सोमजीन बोगवानाह अर्पण किरज्‍यो; तान लांबाय पोचीह एजार वाहण्यान चोवड़ाय दोह एजार वाहण्यान रेय; तो बाग सोतान कावदेन एद्दी वोर चोखालो ठेराय। <verse eid="EZK 45:1" /><verse number="2" style="v" sid="EZK 45:2" />ता माय रेन चोखाला जागान केरता पाच होव वाहण्यो चौड़ो चोवकेणी बुय रेय, एने तान कावदेन पाचाह पाचाह आथ चोवड़ी बुय सुटांग पोड़ रेय। <verse eid="EZK 45:2" /><verse number="3" style="v" sid="EZK 45:3" />ता चोखाला बागाम तुमू पोचीह एजार वाहण्यो लांबो एने दोह एजार वाहण्यो चौड़ी बुईह मापज्यो, एने तीच माय चोखालो जागो बाणावज्यो, जो जेलेम चोखालो ठेराय। <verse eid="EZK 45:3" /><verse number="4" style="v" sid="EZK 45:4" />जो चाकऱ्यो चोखाला जागान सेवा केरी एने बोगवानान सेवा केरनेन केरता आहने आवी, तो तान केरता रेय; ताहरी तान गेरान केरता जागो रेय एने चोखाला जागान केरता चोखो ठेराय। <verse eid="EZK 45:4" /><verse number="5" style="v" sid="EZK 45:5" />पोशो पोचीह एजार वाहण्यो चोवड़ो एक बाग, गेरान सेवा केरनारे लेवीन विह खोल्युन केरता रेय।<verse eid="EZK 45:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 45:6" />पोशो हेयरान केरता, चेड़ायेल चोखाला बागान जागे, तुमू पाच एजार वाहण्यो चोवड़ो एने पोचीह एजार वाहण्यो लांबो, खास बुय ठेरावज्ये; ती इस्राएलान आखा गेराणान केरता रेय।<verse eid="EZK 45:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 45:7" />मुखीन सोतान बाग चोखालो बेट चेड़ायेल बाग एने हेयरान खास बुईन दुयू उगे मतलब दुयान पश्चिम एने पुर्व दिशा माय दुयू बागान सामने रेय; एने तान लांबाय पश्चिम रेन लागतो पुर्व वोर दुयू बागाम रेन काल्लो बी एक एकान बाराबोर रेय। <verse eid="EZK 45:7" /><verse number="8" style="v" sid="EZK 45:8" />इस्राएलान देसाम मुखीन ज्यीच सोतान बुय रेय, एने मारा ठेरायेल मुखी मारी पोरजाह पोशा वेला नाय पाड़ी; पुण इस्राएलान गेराणाह तान वोसीन गेत देस जुड़ी।<verse eid="EZK 45:8" /></para>
  <para style="s">मुखीन केरता नेम</para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 45:9" />बोगवान यहोवा इही किथे, “एय इस्राएलान मुखी! बास किरो, अत्याचार एने वेला पाड़नेह सेटा किरो, नियाव एने देरेमने काम केऱ्या किरो; मारी पोरजान माणहाह निकालनो सोड़ दिवो, बोगवान यहोवान ज्यो बोल हे।”<verse eid="EZK 45:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 45:10" />तुमरी फाय खेरलो ताकड़ो, खेरलो एपा, एने खेरलो बत रेय।<verse eid="EZK 45:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 45:11" />एपा एने बत दुयू एकुच मापान रेय, मतलब दुयू माय होमेरान दोहवो ईसो होमाय; दुयान माप होमेरान ईसाब माय रेय।<verse eid="EZK 45:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 45:12" />शेकेल विह गेरान रेय; एने तुमरो माना विह पोचीह, नाहते पोंदरा शेकेल रेय।<verse eid="EZK 45:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 45:13" />तुमरी विसेल बेट ज्य रेय, मतलब गोवान होमेरान एपान सोव्वो बाग, एने जोवान होमेर माय रेन एपा सोव्वो बाग आपज्यो। <verse eid="EZK 45:13" /><verse number="14" style="v" sid="EZK 45:14" />तेलान बाग जेलेम कोर माय रेन बत ने दोहवो ईसो रेय। कोर ते दोह बत मतलब एक होमेरान बाराबोर हे, काहाकाय होमेर दोह बत ने रिथे। <verse eid="EZK 45:14" /><verse number="15" style="v" sid="EZK 45:15" />इस्राएलान हाज हाजी चाराय माय रेन दुय दुय होव मेंड्रा बोकड्याम रेन एक मेंड्रो नाहते बोकड्यो आपाय जाय, ज्यु सोब वोस्तु होमबोली, मेल मिलाप बोलीन केरता आपाय जाय जा माय तान केरता पाचतावो केराय जाय, बोगवान यहोवान ज्यो बोल हे। <verse eid="EZK 45:15" /><verse number="16" style="v" sid="EZK 45:16" />इस्राएलान मुखीन केरता देसान सोब माणहे ज्यी बेट आपी। <verse eid="EZK 45:16" /><verse number="17" style="v" sid="EZK 45:17" />तिवार नोवाला चांदान दिह्याम, विहेवणेन दिह्याम एने इस्राएलान गेराणान सोब ठेरायेल टेम माय होमबोली, एन बेट, एने पिणी बोली आपज्ये मुखीच ने काम हे। पाचतावो केरनेन तो पापबोली, एन बेट, होमबोली, एने मेल मिलाप बोली तियार केरी।<verse eid="EZK 45:17" /></para>
  <para style="s">फसहान तिवार</para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 45:18" />बोगवान यहोवा इही किथे, पेल्ला मोयनान पेल्ले दिह्याह तु एक निर्दोस वासड़ो लेन चोखाला जागाह चोखो किरज्ये। <verse eid="EZK 45:18" /><verse number="19" style="v" sid="EZK 45:19" />ज्या पापबोलीन लुय माय रेन चाकऱ्यो थोड़ोक लेन गेरान चोवकटान खांबा पोर, एने वेदीन कुड़चीन चारू खुणाम, एने मायवाली खोलीन फाटेक ने खांबा पोर लागाड़े। <verse eid="EZK 45:19" /><verse number="20" style="v" sid="EZK 45:20" />पोशो मोयनान सातवा दिह्याह सोब बुल माय पुड़ेल एने बोलान केरता ज्य बी किरज्‍यो; इह केरीन गेरान केरता पासतावो किरज्‍यो।<verse eid="EZK 45:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 45:21" />पेल्ला मोयनान चोवदावे दिह्याह तुमरो फसह ने तिवार एया केरी, तो सात दिह्यान तिवार रेय एने ता माय बिगेर खमीरान रूटो खावाय जाय। <verse eid="EZK 45:21" /><verse number="22" style="v" sid="EZK 45:22" />ते दिह मुखी तान एने पोरजान आखा माणहान केरता एक वासड़ो पापबोलीन केरता तियार केरी। <verse eid="EZK 45:22" /><verse number="23" style="v" sid="EZK 45:23" />तिवारान सातु दिह तो बोगवानान केरता होमबोली तियार केरी, मतलब दाड़ीन सात सात निर्दोस वासड़ा एने सात सात निर्दोस मेंडा एने दाड़ीन एक एक वार पापबोलीन केरता तियार केरी। <verse eid="EZK 45:23" /><verse number="24" style="v" sid="EZK 45:24" />आखा वासड़ा एने मेंडा हेऱ्या तो एपा बोर अन्नबोली, एने एपान पासाण साड़े सात लिटेर तेल तियार केरी। <verse eid="EZK 45:24" /><verse number="25" style="v" sid="EZK 45:25" />सातवा मोयनान पोंदरावे दिह रेन सात दिह वोर मतलब तिवारान दिह्या माय तो पापबोली, होमबोली, एनबोली, एने तेल विदीन गेत केऱ्या केरी।<verse eid="EZK 45:25" /></para>
  <chapter eid="EZK 45" />
  <chapter number="46" style="c" sid="EZK 46" />
  <para style="s">मुखी एने तिवार</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 46:1" />बोगवान यहोवा इही किथे, मायवाली खोलीन पुर्वमुखी फाटेक कामा काजान सोव दिह बोंद रेय, पुण विहेवणेन दिह्याह उगाड़लो रेय। एने नोवाला चांदान दिह बी उगड़े <verse eid="EZK 46:1" /><verse number="2" style="v" sid="EZK 46:2" />मुखी बाहेर रेन फाटेक ने एक खांबान जागे उबरेय जाय, एने चाकऱ्यो तान होमबोली एने मेल मिलाप बोली तियार केरी; एने तो फाटेक ने ओटलान वाटे आवीन फाटेक ने एक खांबान जागे उबो रेय जाय, एने चाकऱ्यो तान होमबोली तियार किरे : एने फाटेक ने ओटला पोर वुंदे; तेवी तो बाहेर जाय, एने फाटेक हांजीन पेल बोंद नाय एय। <verse eid="EZK 46:2" /><verse number="3" style="v" sid="EZK 46:3" />माणहे विहेवणेन एने नोवाला चांदान दिह्या माय ती फाटेक ने बायणा माय बोगवानाह वुंदे। <verse eid="EZK 46:3" /><verse number="4" style="v" sid="EZK 46:4" />विहेवणेन दिह्याम जो होमबोली मुखी बोगवानान सामने चेड़ावे, तो मेंड्रान सोव निर्दोस पिला एने एक निर्दोस मेंडान रेय। <verse eid="EZK 46:4" /><verse number="5" style="v" sid="EZK 46:5" />अन्नबोली ज्यी रेय, मेंडा हेऱ्यो एपा बोर एन एने मेंडान पिला हेऱ्यो अन्नबोली एने एपान पासाण साड़े सात लिटेर तेल। <verse eid="EZK 46:5" /><verse number="6" style="v" sid="EZK 46:6" />नोवाला चांदान दिह तो एक निर्दोस वासड़ो एने सोव मेंड्रान पिला एने एक मेंढो चेड़ावे; ज्या सोब निर्दोस रेती। <verse eid="EZK 46:6" /><verse number="7" style="v" sid="EZK 46:7" />वासड़ा एने मेंडा दुया हेऱ्यो तो एक एक एपा अन्नबोली तियार केरी, एने मेंड्रान पिला हेऱ्यो यथाशक्ती एन, एने एपान पासाण साड़े सात लिटेर तेल। <verse eid="EZK 46:7" /><verse number="8" style="v" sid="EZK 46:8" />जेवी मुखी माय जाय तेवी तो फाटेक ने ओटला पोर लागतो जाय, एने तीच वाटे निकली जाय।<verse eid="EZK 46:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 46:9" />जेवी सादा माणहे ठेरायेल टेम माय बोगवानान सामने वोंदणे आवी, तेवी जो उत्तरी फाटेक लागतो वोंदणेन माय आवी, तो देक्षिण फाटेक रेन लागतो माय आवी, काहाकाय तो तीच फाटेक लागतो नाय निकले, पुण तान सामने रेन निकेल जाय। <verse eid="EZK 46:9" /><verse number="10" style="v" sid="EZK 46:10" />जेवी तो माय आवी तेवी मुखी तान विचीम लागतो आवी, एने जेवी तो निकले, तेवी ता आरहीच निकले। <verse eid="EZK 46:10" /><verse number="11" style="v" sid="EZK 46:11" />तिवारान एने दिहरा ठेरायेल टेमान अन्नबोली वासड़ान पासाण एपा बोर, एने मेंडान पासाण एपा बोरीन रेय; एने मेंड्रान पिला हेऱ्यो यथाशक्ती एन एने एपान पासाण साड़े सात लिटेर तेल।<verse eid="EZK 46:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 46:12" />पोशो जेवी मुखी होमबोली नाहते मेलबोलीह आसान बोली केरीन बोगवानान केरता तियार केरी, तेवी पुर्वमुखी फाटेक तान केरता उगाड़ाय जाय, एने तो तान होमबोली नाहते मेल मिलाप बोली तिहेच तियार केरी जीहे तो विहेवणेन दिह्याह किरेह; तेवी तो निकले, एने तान निकेलनेन पासाण फाटेक बोंद केराय जाय।<verse eid="EZK 46:12" /></para>
  <para style="s">दाड़ीन दिह ने बेट</para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 46:13" />दाड़ीन तु एक वोरह्यान निर्दोस मेंड्रान पिलो बोगवानान होमबोलीन केरता तियार किरज्ये, ज्य दाड़ीन वेगोच तियार केराय जाय। <verse eid="EZK 46:13" /><verse number="14" style="v" sid="EZK 46:14" />दाड़ीन ता हेऱ्यो एक अन्नबोली तियार किरज्ये, मतलब एपान साहवो ईसो एने मोयदाम बेचकेणेन केरता हीन बोर तेलान पाव बाग बोगवानान केरता कायेम अन्नबोली जेलेम वेदीन गेत चेड़ावाय जाय। <verse eid="EZK 46:14" /><verse number="15" style="v" sid="EZK 46:15" />मेंड्रान पिलो अन्नबोली एने तेल, दाड़ीन वेगोच होमबोली केरीन चेड़ावाय जाय।<verse eid="EZK 46:15" /></para>
  <para style="s">मुखी एने खेतान ईसो</para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 46:16" />बोगवान यहोवा इही किथे, केदी मुखी तान एगदा सोराह काह आपी, ते तो तान सोतान ईसो एन तान नातण्याक बी जुड़ी; ईसान नेमान गेत तो तान सोतान मालदेन बोणी। <verse eid="EZK 46:16" /><verse number="17" style="v" sid="EZK 46:17" />पुण केदी तो तान ईसा माय रेन तान एगदा काम केरनाराह काह आपी, ते स्वतंत्रान वोरह्या वोर ते तो ताच ने रेय, पुण तान पासाण मुखीह फिराव देय, एने तान सोतान ईसोच तान सोराह सापड़े। <verse eid="EZK 46:17" /><verse number="18" style="v" sid="EZK 46:18" />पोरजान ओहलो ईसो मुखी नाय लेय, जो ठेगीन तान सोतान खेताम रेन सांडाड्यो एय; तान सोराह ताच ने सोतान खेताम रेन आपी ओहलो नाय एय काय मारा पोरजान माणहे जोथ तोथा खोवलाय जाय।<verse eid="EZK 46:18" /></para>
  <para style="s">मोंदिरान रांदणेन खोली</para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 46:19" />ओवतो तो माहु फाटेक ने एक उगेन बायणाम लागतो चाकऱ्यान उत्तरमुखी चोखाल्यु खोल्यु माय ली गीयो; पश्चिम उगेन कोपरावालो एक जागो इतो। <verse eid="EZK 46:19" /><verse number="20" style="v" sid="EZK 46:20" />तेवी तो माहु केयो, “ज्यो तो जागो हे जा माय चाकऱ्या माणहे दोसबोली एने पापबोलीन माह रांदे एने अन्नबोलीह रांदे, ओहलो नाय एय काय ताह बाहेरली खोलीम ली जाणे माय सादा माणहे चोखाला एय जाती।”<verse eid="EZK 46:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 46:21" />तेवी तो माहु बाहेरली खोलीम ली जाएन ती खोलीन चारू कोपराम फिरायो, एने खोलीन आखा कोपराम एक एक ओटलो बुणेल इतो। <verse eid="EZK 46:21" /><verse number="22" style="v" sid="EZK 46:22" />मतलब खोलीन चारू कोपराम चालीह आथ लांबा एने तीस आथ चोवड़ा ओटला एता; चारू कोपरान ओटलान माप एकुच एती। <verse eid="EZK 46:22" /><verse number="23" style="v" sid="EZK 46:23" />माय कावदेन बितड़ो एतो, एने बितड़ान बुंदे रांदणेन चुला बुणेल एता। <verse eid="EZK 46:23" /><verse number="24" style="v" sid="EZK 46:24" />तेवी तो माहु केयो, “रांदणेन केरता गेर, जाहरी गेरान फिरनारे माणहान बलिदानाह रांदेल, ता ज्याच हेते।”<verse eid="EZK 46:24" /></para>
  <chapter eid="EZK 46" />
  <chapter number="47" style="c" sid="EZK 47" />
  <para style="s">मोंदिर माय रेन वोयतालो जिर</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 47:1" />ओवतो तो एदमी माहु गेरान बायणा पोर फिरावीन ली गीयो; एने गेरान ओटला बुंदे रेन एक जिर निकलीन पुर्व उगे वोयतालो। एने गेरान बायणो ते पुर्व उगे एतो। एने जिर गेरान पुर्व उगे वेदीन देक्षिण उगे बुंदे निकेलतालो। <verse eid="EZK 47:1" /><verse number="2" style="v" sid="EZK 47:2" />तेवी तो माहु उत्तर उगेन फाटेक लागतो बाहेर ली गीयो, एने बाहेर बाहेरूच फिरावीन बाहेर पुर्व उगे वाला फाटेक उगे पोचाड़ दिनो; एने देक्षिण उगे पाणी जेरफीन वोयतालो। <verse eid="EZK 47:2" /><verse number="3" style="v" sid="EZK 47:3" />जेवी तो एदमी आथाम मापणेन दोयड़ी लेन पुर्व उगे निकेलनो, तेवी तो गेराम लागतो एजार आथ वोर जिराह माप्यो, एने माहु पाण्याम चालाड्यो एने तो पाणी गुटण्याम वोर एतो। <verse eid="EZK 47:3" /><verse number="4" style="v" sid="EZK 47:4" />तो पुशो एजार आथ मापीन माहु पाण्याम चालाड्यो, एने पाणी मांडाम वोर एतो, पुशो एजार आथ मापीन माहु पाण्याम चालाड्यो, एने पाणी कोमेर वोर एतो। <verse eid="EZK 47:4" /><verse number="5" style="v" sid="EZK 47:5" />तेवी पुशो तो एजार आथ माप्यो एने ओहली नेदी बोण गियी जीन पार मी नाह जाय सिक्यो, काहाकाय पाणी वोदीन जेफणे हारको एय गीयो, एने ती ओहली नेदी एती जीन पार कुण जाय नाह सेकतालो। <verse eid="EZK 47:5" /><verse number="6" style="v" sid="EZK 47:6" />तेवी तो माहु फुशो, “एय माणहान सोरा, काय तु ज्य दिखेल हे?”</para>
  <para style="p" vid="EZK 47:6">पुशो तो माहु नेदीन मीरे मीरे फिरावीन पोचाड़ दिनो। <verse eid="EZK 47:6" /><verse number="7" style="v" sid="EZK 47:7" />फिरीन मी दिख्यो काय, नेदीन दुयू मेरा पोर जुलूम जाड़े हेते। <verse eid="EZK 47:7" /><verse number="8" style="v" sid="EZK 47:8" />तेवी तो माहु केयो, “ज्यो जिर पुर्व देसान उगे वोयणे बाज रिनोह, एने अराबा माय उतरीन तालान उगे वोयी; एने ज्य गेराम रेन निकलीन हुतरो ताल माय मिलाय जाय; एने तान पाणी मिठो एय जाय। <verse eid="EZK 47:8" /><verse number="9" style="v" sid="EZK 47:9" />जाहरी जाहरी ज्यी नेदी वोयी, ता ता सोब बातीन इंडा मेलनारे जीवजेन्तु जीवती एने मासा बी जुलूम एय जाती; काहाकाय ज्या जिरान पाणी ताहरी पुचेल हे, एने तालान पाणी मिठो एय जाय; एने जा का ज्यी नेदी पोची ताहरी सोब जेन्तु जीवती। <verse eid="EZK 47:9" /><verse number="10" style="v" sid="EZK 47:10" />तेलान मीरे मासऱ्या उब रेती, एने एनगदी रेन एनएगलेम वोर ता जाल पोसरावती जाती, एने ताह मोटला देरीयान गेत बात बातीन गेणाय नाय ओलाक मासा सापेड़ती। <verse eid="EZK 47:10" /><verse number="11" style="v" sid="EZK 47:11" />पुण तेलान आहने जो गारो एने खाडा हेते, तान पाणी मिठो नाय रेय; ता खारलाच रेती। <verse eid="EZK 47:11" /><verse number="12" style="v" sid="EZK 47:12" />नेदीन दुयू मीरे बात बातीन खाणेन लायकीन फोलावाला जाड़े उगती, जान पाला नाय कोमाती एने तान फोलनो बी केदी बोंद नाय एय, काहाकाय नेदीन पाणी चोखाला जागाम रेन निकलेल हे। ता माय मोयना मोयना, नोव नोवा फोले लागती, एने तान फोले ते खाणेन, एने पाला दावान काम लागती।”<verse eid="EZK 47:12" /></para>
  <para style="s">देसान एद्दयु</para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 47:13" />बोगवान यहोवा इही किथे, “जी एद्दी माय तुमूह ज्यो देस तुमरा बारा गेराणान गेत वाटणे पोड़ी, तो ज्य हे : युसूपाह दुय ईसा जुड़ी। <verse eid="EZK 47:13" /><verse number="14" style="v" sid="EZK 47:14" />ताह तुमू एक दिहरान हारको सोतान ईसो सापड़ावहो, काहाकाय मी सुगोण खादो काय ताह मी तुमरा डायडायाह आपुह, केरीन ज्यो देस तुमरो सोतान ईसो बोणी।”<verse eid="EZK 47:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 47:15" />देसान एद्दी ज्यी रेय, मतलब उत्तर उगेन एद्दी मोटला देरीयाम लागतो हेतलोन ने जागे रेन सदादान गाटे वोर पुचे, <verse eid="EZK 47:15" /><verse number="16" style="v" sid="EZK 47:16" />एने ती एद्दीन जागे हमात बेरोत एने सिब्रेम जो दमिश्क एने हमात ने एद्दीन विचीम हे, एने हसर्हत्तीकोन वोर, जी होरान एद्दी पोर हे। <verse eid="EZK 47:16" /><verse number="17" style="v" sid="EZK 47:17" />ज्यी एद्दी देरीयाम रेन लागती दमिश्क ने एद्दीन जागेवाला हसरेनोन वोर पुचे; एने तान उत्तर उगे हमात रेय, उत्तरवाली एद्दी ज्यीच हे।<verse eid="EZK 47:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 47:18" />पुर्वान एद्दी जीन एक उगे होरान दमिश्क; एने यरदन ने उगे गीलाद एने इस्राएलान देस रेय; उत्तरवाली एद्दी रेन लागतो पुर्वी ताल वोर तीह मापज्ये, पुर्वी एद्दी ते ज्यीच हे। <verse eid="EZK 47:18" /><verse number="19" style="v" sid="EZK 47:19" />देक्षिणी एद्दी तामार रेन लागतो मरीबा कादेश नावान जिर वोर मतलब मिस्रान खुदेर वोर, एने मोटला देरीयाम वोर पुचे, दक्षिणी एद्दी ज्यीच रेय। <verse eid="EZK 47:19" /><verse number="20" style="v" sid="EZK 47:20" />पश्चिमी एद्दी देक्षिणी एद्दी रेन लागती हमात ने गाटान सामने वोर वाला मोटला देरीयान वोर रेय, पश्चिमी एद्दी ज्यीच रेय। <verse eid="EZK 47:20" /><verse number="21" style="v" sid="EZK 47:21" />इह केरीन इस्राएलान गेराणान गेत वाट लिज्यो। <verse eid="EZK 47:21" /><verse number="22" style="v" sid="EZK 47:22" />ज्याह आपसाम एने ता पाराया देसावाला हेऱ्या वाट लिज्यो, जा तुमरी विचीम रिते लेन सोरा पायदा केरी, ता तुमरी नेजरीम देसावाला इस्राएली माणहान हारका गेणाय, एने तुमरा गेराणान विचीम जीव जीवान ईसो सापड़ावे। <verse eid="EZK 47:22" /><verse number="23" style="v" sid="EZK 47:23" />जा पाराया देसावालो जा गेराणान देसाम रेतेय, ताह तोच ईसो आपज्यो, बोगवान यहोवान ज्यो बोल हे।<verse eid="EZK 47:23" /></para>
  <chapter eid="EZK 47" />
  <chapter number="48" style="c" sid="EZK 48" />
  <para style="s">गेराणा माय बुईन वाटणो</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 48:1" />गेराणान ईसा ज्या रेय : उत्तरी एद्दी हेऱ्यो लागेल हेतलोन ने वाटीन जागे रेन हमात गाट वोर, एने दमिश्क ने एद्दीन जागेवाला हसरेनान रेन उत्तर वालो हमातान जागे वोर एक ईसो दानान रेय; एने पुर्वी पश्चिमी एद्दी बी रेय। <verse eid="EZK 48:1" /><verse number="2" style="v" sid="EZK 48:2" />दानान एद्दीह लागेल, पुर्व रेन पश्चिम वोर आशेरान एक ईसो रेय। <verse eid="EZK 48:2" /><verse number="3" style="v" sid="EZK 48:3" />आशेरान एद्दीह लागेल, पुर्व रेन पश्चिम वोर नप्तालीन एक ईसो रेय। <verse eid="EZK 48:3" /><verse number="4" style="v" sid="EZK 48:4" />नप्तालीन एद्दीह लागेल पुर्व रेन पश्चिम वोर मनश्शेन एक ईसो रेय। <verse eid="EZK 48:4" /><verse number="5" style="v" sid="EZK 48:5" />मनश्शेन एद्दीह लागेल पुर्व रेन पश्चिम वोर एप्रेमान एक ईसो रेय। <verse eid="EZK 48:5" /><verse number="6" style="v" sid="EZK 48:6" />एप्रेमान एद्दीह लागेल, पुर्व रेन पश्चिम वोर रूबेन ने एक ईसो रेय। <verse eid="EZK 48:6" /><verse number="7" style="v" sid="EZK 48:7" />एने रूबेन ने एद्दीह लागेल, पुर्व रेन पश्चिम वोर यहुदान एक ईसो रेय।<verse eid="EZK 48:7" /></para>
  <para style="s">देसान विचीम बुईन खास ईसो</para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 48:8" />यहुदान एद्दीह लागेल पुर्व रेन पश्चिम वोर अर्पण किरेल ईसो रेय, जाह तुमूह अर्पण केरने पोड़ी, तो पोचीह एजार आथ चोवड़ो एने पुर्व रेन पश्चिम वोर एगदा एक गेराणान ईसान बाराबोर लांबो रेय, तान विचीम चोखालो जागो रेय। <verse eid="EZK 48:8" /><verse number="9" style="v" sid="EZK 48:9" />जो ईसो तुमूह बोगवानाह अर्पण केरने पोड़ी, तान लांबाय पोचीह एजार आथ एने चोवड़ाय दोह एजार आथान रेय। <verse eid="EZK 48:9" /><verse number="10" style="v" sid="EZK 48:10" />ज्यो अर्पण किरेल ईसो चाकऱ्याह जुड़ी; तो उत्तर उगे पोचीह एजार आथ लांबो, पश्चिम उगे दोह एजार आथ चोवड़ो, पुर्व उगे दोह एजार आथ लांबो रेय; देक्षिण उगे साड़े बारा एजार आथ लांबो रेय, एने तान बोर बोर विचालाम बोगवानान चोखालो जागो रेय। <verse eid="EZK 48:10" /><verse number="11" style="v" sid="EZK 48:11" />ज्यो खाज चोखालो ईसो सादोकान सोरान ता चाकऱ्यान रेय जा मारो उकुम मानते रेना, एने इस्राएली माणहान बोटकीन जाणेन टेम माय लेवीन गेत नाह बोटकेल एता। <verse eid="EZK 48:11" /><verse number="12" style="v" sid="EZK 48:12" />इस्राएल देसान अर्पण किरेल ईसाम रेन ज्य तान केरता अर्पण किरेल ईसो, मतलब जेलेम चोखालो देस ठेरी; लेवीन एद्दी हेऱ्यो लागीन रेय।<verse eid="EZK 48:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 48:13" />चाकऱ्यान एद्दी हेऱ्यो लागेल लेवीन ईसो रेय, तो पोचीह एजार आथ लांबो एने दोह एजार आथ लांबो रेय। <verse eid="EZK 48:13" /><verse number="14" style="v" sid="EZK 48:14" />ता ता माय रेन काय विचे नाय, एने नाय दिहरी बुई हेऱ्यो अदला बोदली केरती; एने बुईन पेल्‍ली पाक दिहराह आपाय जाय, काहाकाय तो बोगवानान केरता चोखालो हे।<verse eid="EZK 48:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 48:15" />चोवड़ाय पोचीह एजार आथान सामने जी पाच एजार वुचेल रेय, तो हियोर एने वोहती एने चारान केरता सादो ईसो रेय; एने हियोर तान विचीम रेय। <verse eid="EZK 48:15" /><verse number="16" style="v" sid="EZK 48:16" />हेयरान माप ज्य रेय, मतलब उत्तर देक्षिण, पुर्व पश्चिम ने उगे साड़े चार चार एजार आथ। <verse eid="EZK 48:16" /><verse number="17" style="v" sid="EZK 48:17" />हेयरान जागे उत्तर देक्षिण, पुर्व पश्चिम, चारनेन जागे रेय, जो एड़ी एड़ी होव आथ चोवड़ी रेय। <verse eid="EZK 48:17" /><verse number="18" style="v" sid="EZK 48:18" />अर्पण किरेल ईसान जागेन लांबाय माय जो काय वुचे, मतलब पुर्व एने पश्चिम दुयू उगे दोह दोह आथ अर्पण किरेल ईसान दोह दोह आथ अर्पण किरेल ईसान पाक हेयराम मेहनेत केरनारान केरता खाणेन केरता रेय। <verse eid="EZK 48:18" /><verse number="19" style="v" sid="EZK 48:19" />इस्राएलान आखा गेराणा माय रेन जो हेयराम मेहनेत केरी, ता तान खेत केऱ्या केरी।<verse eid="EZK 48:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 48:20" />आखो अर्पण किरेल ईसो पोचीह एजार आथ चोवड़ो रेय; तुमूह चार ईसा अर्पण केरने पोड़ी जा माय हेयरान खाज बुय रेय। <verse eid="EZK 48:20" /><verse number="21" style="v" sid="EZK 48:21" />जो ईसो रेय जाय, तो मुखीह जुड़ी, चोखालो अर्पण किरेल ईसान, एने हेयरान खाज बुईन दुयू उगे मतलब तान पुर्व एने पश्चिम ने उगेन पोचीह पोचीह एजार आथ चोवड़ाएन जागे, जो बाकीन गेराणान ईसान जागे रेय, तो मुखीह जुड़ी, अर्पण किरेल चोखालो ईसो एने गेरान चोखालो जागो तान विचीम रेय।<verse eid="EZK 48:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 48:22" />जो मुखीन ईसो रेय, तो लेवीन विचीम हेयरान खास बुय रेय, मुखीन ईसो यहुदा एने बिन्यामीन ने एद्दीन विचीम रेय।<verse eid="EZK 48:22" /></para>
  <para style="s">दिहरा गेराणान ईसो</para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 48:23" />दिहरा गेराणान ईसा इह केरीन रेय, पुर्व रेन पश्चिम वोर बिन्यामीन ने एक ईसो रेय। <verse eid="EZK 48:23" /><verse number="24" style="v" sid="EZK 48:24" />बिन्यामीन ने एद्दी हेऱ्यो लागेल पुर्व रेन पश्चिम वोर शिमोनान एक ईसो। <verse eid="EZK 48:24" /><verse number="25" style="v" sid="EZK 48:25" />शिमोनान एद्दी हेऱ्यो लागेल पुर्व पश्चिम वोर इस्साकार ने एक ईसो। <verse eid="EZK 48:25" /><verse number="26" style="v" sid="EZK 48:26" />इस्साकार ने एद्दीन हेऱ्यो लागेल पुर्व पश्चिम वोर जबुलून ने एक ईसो। <verse eid="EZK 48:26" /><verse number="27" style="v" sid="EZK 48:27" />जबुलून ने एद्दी हेऱ्यो लागेल पुर्व रेन पश्चिम वोर गादान एक ईसो।<verse eid="EZK 48:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 48:28" />एने गादान एद्दीन जागे देक्षिण उगेन एद्दी तामार रेन लागतो मरीबा कादेश नावान जिरे वोर, एने मिस्रान खुदेर एने मोटला देरीयाम वोर पुचे। <verse eid="EZK 48:28" /><verse number="29" style="v" sid="EZK 48:29" />जो देस तुमूह इस्राएलान गेराणाह वाटणे पोड़ी तो ज्योच हे, एने तान ईसा बी ज्याच हेते, बोगवान यहोवान ज्यो बोल हे।<verse eid="EZK 48:29" /></para>
  <para style="s">यरूशलेम ने फाटेक</para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 48:30" />हेयरान आकार ज्यो रेय, मतलब उत्तर उगे जान लांबाय चार एजार पाच होव आथान रेय। <verse eid="EZK 48:30" /><verse number="31" style="v" sid="EZK 48:31" />ता माय तीन फाटेक रेय, मतलब एक रूबेन ने फाटेक, एक यहुदान फाटेक, एने एक लेवीन फाटेक रेय; काहाकाय हेयरान फाटक्युन नाव इस्राएल गेराणान नावा पोर मेलने पोड़ती। <verse eid="EZK 48:31" /><verse number="32" style="v" sid="EZK 48:32" />पुर्व उगेन एद्दी चार एजार पाच होव आथ लांबी रेय, ता माय तीन फाटेक रेय; मतलब एक युसूफान फाटेक, एक बिन्यामीनान फाटेक, एने एक दानान फाटेक रेय। <verse eid="EZK 48:32" /><verse number="33" style="v" sid="EZK 48:33" />देक्षिणान उगे एद्दी चार एजार पाच होव आथ लांबी रेय, एने ता माय तीन फाटेक रेय, मतलब एक शिमोनान फाटेक, एक इस्साकारान फाटेक, एने एक जबुलूनान फाटेक रेय। <verse eid="EZK 48:33" /><verse number="34" style="v" sid="EZK 48:34" />एने पश्चिम उगेन एद्दी चार एजार पाच होव आथ लांबी रेय, एने ता माय तीन फाटेक रेय; मतलब एक गादान फाटेक, एक आशेरान फाटेक, एने एक नप्तालीन फाटेक रेय। <verse eid="EZK 48:34" /><verse number="35" style="v" sid="EZK 48:35" />हेयरान कावदेन कोठ आठरा एजार आथान रेय, एने ते दिह रेन ओंगाण रेन हेयरान नाव <note caller="+" style="f"><char style="fr" closed="false">48:35 </char><char style="ft" closed="false">मालीक न्या हे</char></note>यहोवा शाम्मा रेय।<verse eid="EZK 48:35" /></para>
  <chapter eid="EZK 48" />
</usx>