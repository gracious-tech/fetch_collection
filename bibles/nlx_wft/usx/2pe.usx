<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2PE" style="id">- Nahali</book>
  <para style="h">2 पतरस</para>
  <para style="toc3">2 पतरस</para>
  <para style="toc2">2 पतरस</para>
  <para style="toc1">पतरस लिखेल दुसरो पोत्रो</para>
  <para style="mt2">पतरस लिखा हुआ दुसरा पत्र</para>
  <para style="mt1">पतरस लिखेल दुसरो पोत्रो</para>
  <para style="imt">ओलखात</para>
  <para style="ip">दुसरी पतरस ने पोत्री माय कियेल हे काय ज्यी प्रेरित पतरसान उगे रेन लेखाय जायेल एती। पुण आज ने कोलाक एकलीवालाह माणहाह ज्यो नाह लागेत काय ज्यो खेरी हे। ज्यो एय सिकेह काय एगदो दिहरो पतरसान उगे रेन लिखेल एय। लेखणार किथे काय तो यीशुन जीवणान एने खास केरीन वेह बोदेलने बुखेत खुद दिखेल इतो। <char style="xt"><ref loc="2PE 1:17-18">1:17-18</ref></char> केदी पतरस पोत्र लिखेल इतो ते एय सिकेह काय तो रोम माय रेन 65-69 यीशुन जेल्मान पासाण एने मोरनेन पासाण लिखेल हे ज्यानकेरता काय ज्यी पोत्री पेल्‍ली पोत्रीन पासाण लेखायेल हे। <char style="xt"><ref loc="2PE 3:1">3:1</ref></char> एने पतरस आखा बुरहो केरनारा माणहाह पोत्र लेखीन किथे।</para>
  <para style="ip">पतरस ज्यी पोत्रीह हाजो जीवणो जीवणेन केरता ओंगाण केरने एने जुठा मास्तेर्‍यान पालेन नाह केरनेन केरता एने चेतावणी आपणे केरता लिखेल इतो। <char style="xt"><ref loc="2PE 2">2</ref></char> पतरस ता माणहाह नाह दिखेल केरनेन केरता खुस किऱ्यो जा केतेह काय यीशु पोशो आवणेन जुलूम लाम्बो टेम लेणे बाजरिनोह। तान सावाय पतरस केयो काय बोगवान दिऱ्यो नाह सोतो पुण आखाह वोचाड़ने हुदेह। <char style="xt"><ref loc="2PE 3:8-9">2 पतरस 3:8-9</ref></char> ज्यो एक हाजालो जीवणो जीवणेन केरता एक कारेण हे। <char style="xt"><ref loc="2PE 3:14">3:14</ref></char></para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. पतरस सोतान ओलखात वाचणारान देखाड़ेह। <char style="ior"><ref loc="2PE 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. ओवतो तो हाजो जीवणो जीवणेन केरता एर केरावेह काहाकाय बोगवान आपणी हिऱ्यो हे। <char style="ior"><ref loc="2PE 1:3-21">1:3-21</ref></char></para>
  <para style="io1">3. तान पासाण पतरस जुठा मास्तेर्‍यान विरोद चेतावणी आपेह एने किथे काय सेवली बुखेत जुठा मास्तेर्‍या हेऱ्यो काय एय। <char style="ior"><ref loc="2PE 2:1-22">2:1-22</ref></char></para>
  <para style="io1">4. तान पासाण पतरस यीशुह पोशो आवणेन केरता तियार एणेन केरता हाजो जीवणो जीवणेन केरता बुरहो केरनाराह खुस किऱ्यो। <char style="ior"><ref loc="2PE 3:1-17">3:1-17</ref></char></para>
  <chapter number="1" style="c" sid="2PE 1" />
  <para style="s">नमस्‍कार</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 1:1" />शिमोन पतरसान उगे रेन, जो यीशु मसीन प्रेरित एने पावोर हे,</para>
  <para style="p" vid="2PE 1:1">ता माणहान नावे जा आमरो बोगवान एने सोड़ेवणार यीशु मसीन नियावान उगे रेन आमरी गेत किमतीदार बुरहो सापेड़नो।<verse eid="2PE 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2PE 1:2" />बोगवान एने आपणो मालीक यीशुन ओलखातीन उगे रेन गीण एने सान्ती तुमरे माय जुलूम होवटी वोड़ते जाय।<verse eid="2PE 1:2" /></para>
  <para style="s">मसीह हादावणी एने निवोड़</para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 1:3" />
    <note caller="+" style="f">
      <char style="fr" closed="false">1:3 </char>
      <char style="ft" closed="false">तान खुद ने बागी एती; थोड़ाक लेख माय तान द्‍वारा लिखेल हे।</char>
    </note>काहाकाय बोगवानान ताकेत आखो काय जो जीवणा एने बोक्ति हेऱ्यो नातो मिलेह, आपुह तास ने ओलखातीन उगे रेन आपेल हे, जो आपुह तास ने बोड़ाय एने हाजा गुणान गेत हादेल हे। <verse eid="2PE 1:3" /><verse number="4" style="v" sid="2PE 1:4" />काहाकाय यीशु न्यास ने वोजेसे आपुह तान किमतीदार एने जुलूम मोटलो वायदो आपेल हे: ज्यानकेरता काय तान द्‍वारे तुमू ती बुरायीह रेन सुटीन, जी दुनिया माय खाराब मोरजी केरीन ईथे, बोगवानान सोबावाम बेलाय जावो। <verse eid="2PE 1:4" /><verse number="5" style="v" sid="2PE 1:5" />ज्यानकेरता तुमूह एय तोलीक कोसीत केरीन आपणा बोरहाम हाजा गुणाह जोड़ो; एने हाजा गुणाम सोमेजाह, <verse eid="2PE 1:5" /><verse number="6" style="v" sid="2PE 1:6" />एने सोमेज माय वेठणो, एने वेठणा माय दिर, एने दिर माय बोक्ती। <verse eid="2PE 1:6" /><verse number="7" style="v" sid="2PE 1:7" />एने तुमरी बोगवानान बोक्ती माय बायबांडलाह एने मसी बायबांडला माय मोंगाह जोड़ो। <verse eid="2PE 1:7" /><verse number="8" style="v" sid="2PE 1:8" />काहाकाय ज्या आखा गुणान जोरेवरी हे, एने केदी ज्‍यु वातु तुमरे माय जुलूम काय जुलूम हेत्यु ताहार ज्यो तुमूह आपणा मालीक यीशु मसीन इकेल माय काम केरनार एने फारेकवाला बाणावी। <verse eid="2PE 1:8" /><verse number="9" style="v" sid="2PE 1:9" />काहाकाय जा माय ज्या गुण नाह सोता, तो आंदलो हे एने जींजवालोह दिखेह, एने तुमू विहरी जायेल हेते काय तुमरा पेल्ला पाप दोवाय जायेल हेते।<verse eid="2PE 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 1:10" />तानकेरता एय बाय बोणहा, तुमरी हादावणीन एने तुमरी निवोड़ मोजबुत केरनेन उंजु जादा कोसीत केरती जावो, काहाकाय केदी इहकेरीन किरहो ताहार केदी बी ठोकेर नाय खाहो।<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">तुमरो बुरहो नाह सोड़ने; नाहते पाप माय नाह पोड़ने।</char></note> <verse eid="2PE 1:10" /><verse number="11" style="v" sid="2PE 1:11" />एने इहीचकेरीन केरीन आपणो मालीक एने सोड़ेवणार यीशु मसीन जेलेमक्यो राज माय मोटलो मान सम्मान एते लेन तुमरो रिगणो रेय।<verse eid="2PE 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2PE 1:12" />तानकेरीन ज्‍यु वातु तुमूह मालुम हेत्यु, एने जो खेरायीन वचन तुमूह जुड़ेल हे ता माय बोणीन रेतेह, तीबी मी तुमूह ज्‍यु वातुन एर केरावणेन केरता कायेम तियार रेह। <verse eid="2PE 1:12" /><verse number="13" style="v" sid="2PE 1:13" />जाह वोर मी ज्या सेरीर माय जीवतालो हे ताह वोर तुमूह एर केरावीन जागताला मेलने, ज्यो माहु हाजो लागेह। <verse eid="2PE 1:13" /><verse number="14" style="v" sid="2PE 1:14" />काहाकाय मी जाणथो काय मी मारो खेतेम एणार सेरीर सोड़न्यो हे, जीहे काय आपणो मालीक यीशु मसी माहु ज्यो कियेल इतो। <verse eid="2PE 1:14" /><verse number="15" style="v" sid="2PE 1:15" />तानकेरता मार उगे रेन मी पुरी कोसीत केरूह, काय माहु मोरनेन पासाण बी तुमू ज्‍यु आख्‍यु वातुन कायेम एर केर सिकहो।<verse eid="2PE 1:15" /></para>
  <para style="s">मसीन बोड़ायीन डोलान सामने गोवा</para>
  <para style="p">
    <verse number="16" style="v" sid="2PE 1:16" />काहाकाय जेवी आमु तुमूह आपणा मालीक यीशु मसीन ताकेतीन एने आवणेन खुबेर किरेल एता, ते आमु चेतराय केरीन ईयेल काहणीन आसरो नाह लेदा। काहाकाय आमु खुद तान बोड़ाय दिखेल एता। <verse eid="2PE 1:16" /><verse number="17" style="v" sid="2PE 1:17" /><note caller="+" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="MAT 17:1-5">मत्ती 17:1-5</ref>; <ref loc="MRK 9:2-7">मरकुस 9:2-7</ref>; <ref loc="LUK 9:28-35">लुका 9:28-35</ref></char></note>काहाकाय जेवी यीशु आबाख बोगवाना फाय रेन मान एने बोड़ाय सापड़ायो, एने ता उजाला माय रेन ज्यो बोल होमलानो, “ज्यो मारो मोंगाल्लो बिटोख हे, ज्या पोर मी जुलूम खुस हे।” <verse eid="2PE 1:17" /><verse number="18" style="v" sid="2PE 1:18" />एने जेवी आमु यीशु हेऱ्या चोखाला बोयड़ा पोर एता, ते खुद आमु हेरगाम रेन ज्योस बोल होमल्या। <verse eid="2PE 1:18" /><verse number="19" style="v" sid="2PE 1:19" />आमरी फाय जो जाणकारान वचन हे, तो ज्यी गेटना पोर मोजबुत ठेरानो। तुमू ज्यो हाजो केरतेह जो ज्यो सोमजीन ता पोर नेजेर टाकतेह काय तो एक दिवो हे, जो आदारला जागाम तुलबूखे वोर उजालो किरेह, जाह वोर काय उजालो नाह एत, एने उजालान तारो तुमरा मोनाम चोमके नाय उठी। <verse eid="2PE 1:19" /><verse number="20" style="v" sid="2PE 1:20" />पुण पेल ज्यो सोमजी लिवो काय चोखाली पुस्तेकीन काल्ली बी खुबेर एगदा जाणाव केरनारान विचारा पोर निकलेत नाह। <verse eid="2PE 1:20" /><verse number="21" style="v" sid="2PE 1:21" />काहाकाय काल्ली बी बोगवानान उगे रेन आयेल खुबेर माणहान मोरजी पोर केदी नाह एनो, पुण माणहे चोखाला जीवाम बोरायीन बोगवानान उगे रेन बोलताला।<verse eid="2PE 1:21" /></para>
  <chapter eid="2PE 1" />
  <chapter number="2" style="c" sid="2PE 2" />
  <para style="s">जुठा हिकाड़नारे</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 2:1" />जिहकेरीन पेल्ला कालाम माणहान विची माय जुठा जाणकार आयेल एता, तिहेच केरीन तुमरे माय बी जुठा हिकाड़नारे आवती। एने ता बोटेकणार जुठ्यु वातुह लावती, एने ता मालीकाह जो ताह सोड़ेव लियेल इतो, एने इहकेरीन ता उतवाल्याह तान नासाह नेवता आपती। <verse eid="2PE 2:1" /><verse number="2" style="v" sid="2PE 2:2" />तीबी जुलूम होवटा माणहे तान गेत लुच्‍चाय केरतीन तान वाटी पोर चालती, काहाकाय जो ता केरतेह तान वोजेसे दिहरा माणहे खाराब वातुह खेरायीन बोदले केती। <verse eid="2PE 2:2" /><verse number="3" style="v" sid="2PE 2:3" />ता लोबा माय आवीन ज्युठ्यु वातु बाणावती। एने तुमरे फाय रेन गेलेत फायदो विसती, डेंड ने उकुम ते ता पोर पेलुस रेन एय जायेल हे, एने तान खेतेम एणे जोरेवरी हे।<verse eid="2PE 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2PE 2:4" />
    <note caller="+" style="f">
      <char style="fr" closed="false">2:4 </char>
      <char style="ft" closed="false">आदारान बोंदेन माय; थोड़ाक लेख माय आंदारला खाडाम लिखेल हे।</char>
    </note>काहाकाय जा हेरोगदुत पाप किरेल एता ताह बोगवान सोड्यो नाह, पुण ताह नेरगाम टाक दिनो, काहाकाय नियावान दिह्यान केरता आंदारला खाडाम हाकली केरीन बांदिन मिलेल हे; <verse eid="2PE 2:4" /><verse number="5" style="v" sid="2PE 2:5" />एने ता जुनाला कालान दुनियाह बी नाह सोड्यो, पुण विणबोकत्यान दुनिया पोर मुहेल दार्‍यो पाणी मोकल्यो; पुण खेरापोणान पारचार केरनार नुहा बेल आठ माणहाह वोचाड़ लिदो। <verse eid="2PE 2:5" /><verse number="6" style="v" sid="2PE 2:6" />एने सदोम एने अमोरान हेयराह गुनेगार ठेरावीन डेंड आप्यो, एने ताह आक्‍ठा केरीन हेलगाड़ीन रोखड़ा माय बेल दिनो; काहाकाय ता आवणारे विणबोकत्या माणहान हिकवोणान केरता एक किस्सो ठेराय, <verse eid="2PE 2:6" /><verse number="7" style="v" sid="2PE 2:7" />एने खेरला लुताह, जो विणखेरला खाराब बोलना चालना पोर जुलूम दुखी इतो, सुटकारो आप्यो। <verse eid="2PE 2:7" /><verse number="8" style="v" sid="2PE 2:8" />काहाकाय तो सिदो माणुह तान विची माय रेते लेन एने तान कायदान विरोद किरेल खाराब कामाह देख देखीन, एने होम होमलीन दाड़ीन तान मोनाम दुखी एतालो <verse eid="2PE 2:8" /><verse number="9" style="v" sid="2PE 2:9" />ते मालीक बोकत्याह पारेख माय रेन निकालने एने खाराब माणहाह नियावान दिह्या वोर डेंडान केरता मेलने बी जाणेह, <verse eid="2PE 2:9" /><verse number="10" style="v" sid="2PE 2:10" />खास केरीन ताह जा खाराब विचारान पासाण सेरीरा ने गेत चालतेह एने मालीकाह नेचा जाणतेह।</para>
  <para style="p" vid="2PE 2:10">ता डिठाला, एने एकएट्या हेते, एने उचाला पोदवालाह हाजो बाकतो केणेन नाह बिते, <verse eid="2PE 2:10" /><verse number="11" style="v" sid="2PE 2:11" />तीबी हेरोगदुत जा ताकेत एने सेकती माय जुठा मास्तेर्‍याह रेन मोटला हेते, मालीकान सामने ताह हाजो बाकतो केयीन दोस नाह लागाड़ती। <verse eid="2PE 2:11" /><verse number="12" style="v" sid="2PE 2:12" />पुण ज्या माणहे विणएकल्या जेनवेरान गेतुस हेते, जा देराणे एने खेतेम एणेन केरता पायदा ईयेल हेते; एने ज्‍यु वातु जाणते बी नाह तान बाराम दिहराह हाजो बाकतो केतेह, ता तान खाराबी माय सोतास सेड़ जाती। <verse eid="2PE 2:12" /><verse number="13" style="v" sid="2PE 2:13" />दिहरान नुकसान केरनेन बोदले तास ने नुकसान एय। ताह दिह्या हिराणे मोज मोचती केरने हाजो लागेह। जो लाज आवी ओहलो एने ईजुत विरे ओहलो हे; जेवी ता तुमरी हेऱ्या खाते पितेह, ताहार तान उगे रेन मोंगाल्लो खाणो खाईन मोज मोचती केरतेह। <verse eid="2PE 2:13" /><verse number="14" style="v" sid="2PE 2:14" />न्यान डोला सिनाला माय बोराय रेनाह, एने ता पाप केऱ्या बिगेर रोकाय नाह सेकते। ता कोमजोर मोना वालाह पोटाड़ लेतेह। तान मोनाह लोब केरनेन आदेत लाग जायेल हे; ता पोर बोगवानान हाराप हे। <verse eid="2PE 2:14" /><verse number="15" style="v" sid="2PE 2:15" />ता हुतरी वाटीह सोड़ीन बोटकी जायेल हेते, एने बोओर ने बिटोख बिलाम ने<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="fq" closed="false">बिलाम ने </char><char style="ft" closed="false">गीन 22:21-41</char></note> वाटी पोर चाल पुड़ेल हेते, जो खाराब कामान मोंजरीह मोंगाल्ली जाणेल इतो। <verse eid="2PE 2:15" /><verse number="16" style="v" sid="2PE 2:16" />पुण तान पापान बाराम हिकवोण जुड़नी, न्या वोर काय एक मुकी गेदड़ी माणहान बोली माय बोलीन ता जाणाव केरनारान गांडा पोणाह रोकी।<verse eid="2PE 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 2:17" />ता माणहे हुकाला कुवान गेत हेते, एने वादोण उड़ायेल दुवरान गेत हेते; तानकेरता जेलेमक्यो आंदारो ठेराय जायेल हे। <verse eid="2PE 2:17" /><verse number="18" style="v" sid="2PE 2:18" />ता फालतुक गोमेंड ने वातु केर केरीन लुच्‍चाय ने कामान द्‍वारा ता माणहान सेरीरान लालचाय माय फोसाड़ लेतेह, जा एवी एवीच बोटकेल माय रेन निकलेल हेते। <verse eid="2PE 2:18" /><verse number="19" style="v" sid="2PE 2:19" />ता ताह सोड़ेवणेन केरता वायदो ते केतेह, पुण सोताच खाराब पोणान गुलाम हेते; काहाकाय जो माणुह जासे आर जाथे, तो तास ने गुलाम बोण जाथे। <verse eid="2PE 2:19" /><verse number="20" style="v" sid="2PE 2:20" />जेवी ता मालीक एने सोड़ेवणार यीशु मसीन ओलखातीन द्‍वारा दुनियान बात बातीन खाराबपोणा रेन वोच निकेलनेन पासाण, एने उंजु ता माय फोसीन आरवाय गीया ताहार, तान पासाणली हाल पेल्लीह रेन बी खाराब एय जायेल हे। <verse eid="2PE 2:20" /><verse number="21" style="v" sid="2PE 2:21" />काहाकाय देरमीपोणान वाटीह नाह सोमेजणे तान केरता ज्यासे हाजो रेतो काय ताह जाणीन, ता चोखाला उकुमाह रेन वोल जाता जो ताह होपायेल एतो। <verse eid="2PE 2:21" /><verse number="22" style="v" sid="2PE 2:22" />ता पोर ज्यी वार्ता खेरी बुहेह, जिहकेरीन चितो तान डिखेल ताह चाटणे, एने हुवर्‍याह कोलोक बी उंगलावी तो पोणा माय पोशो जात रेणे, तोहलास ज्या माणहे हेते।<verse eid="2PE 2:22" /></para>
  <chapter eid="2PE 2" />
  <chapter number="3" style="c" sid="2PE 3" />
  <para style="s">मालीकान पोशो आवणेन वायदो</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 3:1" />एय मोंगाल्ला, एवी मी तुमूह ज्यी दिहरी चिट्ठी लेखथु मी तुमूह एर केरावतेन तुमरा चोखाला मोनाह जागतो केरथु, <verse eid="2PE 3:1" /><verse number="2" style="v" sid="2PE 3:2" />काय तुमू ता वचनाह जा चोखाला बोगवानान जाणकार पेलुस रेन कियेल हेते, मालीक एने सोड़ेवणारान ता उकुमाह एर किरो जो तुमरा प्रेरितान द्‍वारा आपायेल इतो। <verse eid="2PE 3:2" /><verse number="3" style="v" sid="2PE 3:3" /><note caller="+" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="JUD 1:18">यहुदा 1:18</ref></char></note>पेल ज्यो सोमजी लिवो, काय सेवेटल्या दिह्याम मोजाक उड़ावणारे मोजाक उड़ावतेन आवती, जा सोतान मोरजी पोर चालती। <verse eid="2PE 3:3" /><verse number="4" style="v" sid="2PE 3:4" />एने ता फुसती, “यीशुन आवणेन वचन कियेल एतो एवी का हे? काहाकाय डायडाया गोमाना, जेवी रेन आखी दुनिया बोणेल हे आख्‍यु वातु तिहेच केरीन चालतेन आवणे बाजरेन्युह।” <verse eid="2PE 3:4" /><verse number="5" style="v" sid="2PE 3:5" />ता ते जाण बुजीन ज्यो विहरी गीया काय बोगवान आपेल उकुमा केरीन जुग एने देरती बोणेल हे, एने देरती पाण्या केरीन बोणनी एने पाण्याम एक जागे हे, <verse eid="2PE 3:5" /><verse number="6" style="v" sid="2PE 3:6" />ज्यानकेरता ती टेम ने दुनिया पाण्या माय बुड़ीन खेतेम एय गियी। <verse eid="2PE 3:6" /><verse number="7" style="v" sid="2PE 3:7" />पुण ज्यो जुग एने देरती आज टिकेन हे, बोगवानान उकुमान द्‍वारे आक्‍ठा केरीन खेतेम एणेन केरता होमालीन मेलाय जायेल हेते। ताह ता दिह्यान केरता मेलाय जाथे जेवी गेलेत माणहान नियाव एय एने ता खेतेम केराय जाती।<verse eid="2PE 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2PE 3:8" />एय मोंगाल्ला, ज्यो मा विहरो, काहाकाय बोगवानान नेजरी माय एक दिह एने एजार वोरह्या कायच फारेक नाह सोतो; तानकेरता दुयू हारका हेते। <verse eid="2PE 3:8" /><verse number="9" style="v" sid="2PE 3:9" />मालीक तान वचनाह पुरो केरनेन वार नाह लागाड़ेत, जोहली वार थोड़ाक माणहे सोमेजतेह; पुण तुमरे बाराम दिर दिरेह, एने एगदान नास एय नाय ओहली तान मोरजी हे, पुण ज्यो काय आखाह पासतावो केरनेन टेम जुड़ी।<verse eid="2PE 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 3:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:10 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:43">मत्ती 24:43</ref>; <ref loc="LUK 12:39">लुका 12:39</ref>; <ref loc="1TH 5:2">1 थिस्सलुनिक्यो 5:2</ref>; <ref loc="REV 16:15">प्रकाशितवाक्य 16:15</ref></char>
    </note>
    <note caller="+" style="f">
      <char style="fr" closed="false">3:10 </char>
      <char style="ft" closed="false">गायेब ईयेल; थोड़ाक लेख माय जुड़ेल लिखेल हे; दिहरा थोड़ाक लेख माय हेलगाड़ील लिखेल हे; एक लेख माय खेतेम किरेल लिखेल हे।</char>
    </note>पुण मालीकान दिह चोरान गेत आवी, ते दिह जुग मोटला गाजणा हेऱ्यो आरताय जाय, एने जुगान आख्‍यु वोस्तु हेलगीन खेतेम एय जाती, देरती एने ती माय वाल्यु आख्‍यु वातु आरताय जाती। <verse eid="2PE 3:10" /><verse number="11" style="v" sid="2PE 3:11" />ते ज्यी आखी चिज इहकेरीन खेतेम एणी हे, ताहार तुमू कोहली बातीन माणहे रेणे जुवे? तुमरो जीवणो चोखालो एने बोगवानान उगे हुपेल रेणे जुवे। <verse eid="2PE 3:11" /><verse number="12" style="v" sid="2PE 3:12" />एने बोगवानान ता दिह्यान वाट किहकेरीन जोवणे जुवे, एने ताह उतवाल्योच आवणेन केरता किहीक कोसीत केरने जुवे, जान केरता जुग आक्‍ठा केरीन खेतेम केराय जाय, एने जुगान आख्‍यु वोस्तु ताताला केरीन पिगील जाती। <verse eid="2PE 3:12" /><verse number="13" style="v" sid="2PE 3:13" /><note caller="+" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="REV 21:1">प्रकाशितवाक्य 21:1</ref></char></note>पुण तान वायदान गेत आपु एक नोवालो जुग एने नोवाली देरतीन वाट जोवतेह जा माय सिदा माणहे रिकती।<verse eid="2PE 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2PE 3:14" />तानकेरता, एय मोंगाल्ला, ज्‍यु वातुन वाट जोवतेह ताहार, कोसीत किरो काय तुमू सान्ती माय बोगवानान सामने विणढाग्या एने निर्दोस ठेराहो, <verse eid="2PE 3:14" /><verse number="15" style="v" sid="2PE 3:15" />एने आपणा मालीकान दिर जो आपुह आपेल हे सुटकारान टेम सोमजो, जीहे आपणो मोंगाल्लो बाहख पौलुस बी ती एकलीन केरीन जो बोगवान ताह आपेल इतो, तान वापेर केरीन लिखेल इतो। <verse eid="2PE 3:15" /><verse number="16" style="v" sid="2PE 3:16" />तिहेच केरीन तो तान आख्‍यु चिटठ्यु माय बी ज्‍यु वातुह लिखेल हे, जा माय थोड्युक वातु ओहल्यु हेत्यु ज्युह सोमेजणे केठीण हे, एने बिगेर हिकेल एने एक जागे नाह रेणारे माणहे दिहरी चोखाली पुस्तेकीन जिहकेरीन उलटो मतलब निकालतेह तिहेच केरीन तान बी निकालतेह, इहकेरीन ता सोतास ने खेतेम ने कारेण बाणावतेह। <verse eid="2PE 3:16" /><verse number="17" style="v" sid="2PE 3:17" />तानकेरता एय मोंगाल्ला, तुमू पेलुस रेन ज्‍यु वातुह सोमजीन चेकचेल्या रिवो, काहाकाय एदेरमी माणहान बुल माय पोड़ीन बोहकी मा जाहो जा माय तुमरी थोबीन रेणो आथाम रेन जावाड़ नाय दिहो। <verse eid="2PE 3:17" /><verse number="18" style="v" sid="2PE 3:18" />पुण आपणो सोड़ेवणार मालीक यीशु मसीन गीण एने इकेल माय वोड़ते जावो। तास ने बोड़ाय एवी बी एय, एने कायेम ईती रेय। आमेन।<verse eid="2PE 3:18" /></para>
  <chapter eid="2PE 3" />
</usx>