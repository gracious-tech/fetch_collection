<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="TIT" style="id">- Nahali</book>
  <para style="h">तीतुस</para>
  <para style="toc3">तीतुस</para>
  <para style="toc2">तीतुस</para>
  <para style="toc1">तीतुस पौलुस लिखेल पोत्रो</para>
  <para style="mt2">तीतुस पौलुस ने लिखा हुआ पत्र</para>
  <para style="mt1">तीतुस पौलुस लिखेल पोत्रो</para>
  <para style="imt">ओलखात</para>
  <para style="ip">तीतुसान पुस्तेक पौलुसान चार पुस्तेक माय रेन एक हे, जाह मोंडलीन केरता लेखणे रेन देन एगदा माणहान बाराम किथे। दिहऱ्यु तीन पोत्र्यु 1 तीमुथीयुस, 2 तीमुथीयुस एने फिलेमोन हे। पौलुस तीतुसाह लेखणे बाजरियेल ईतो, पुण तो ज्यो बी लिखेल ईतो काय पोत्र एक मोकेलनाराह दिरेह, ज्यो तीतुस पेलुस रेन जाणतालो। पौलुस शायद मसीन जेल्मान बाद 63-65 वोरह्यान विचीम ज्या पोत्राह लिखेल ईतो। एने ज्यी पोत्री आखी मोंडलीन माणहान केरता जोरेस वाचाय जाणे जुवे, आपु ज्याह जाण सेकतेह। काहाकाय तो तान योग्यता किथे।</para>
  <para style="ip">पौलुस तीतुसाह क्रेते हेयरान मोंडलीन देखरेत केरनेन केरता उकुम आपेल ईतो। पौलुस मोंडलीन डायलाह हिकवोण आपणेन केरता ज्यी पोत्री लिखेल ईतो। पौलुस तीमुथीयुसाह तान पोत्रा माय एक हारको चेतावणी आप्यो। तान पोत्री माय कियेल हे काय मोंडली माय अगुवाह ठेराय जाणे जुवे। मोंडलीन अगुवाह आज ज्यो जोरेवरी माणहाह होमालीन देखरेत केरने जुवे।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. पौलुस डायलाह ठेराणेन केरता तीतुसाह चेतावणी आप्यो। <char style="ior"><ref loc="TIT 1:1-16">1:1-16</ref></char></para>
  <para style="io1">2. माणहाह बोगवानान जीवाय जीवणेन केरता हिक जाय केरीन चेतावणी आपेह। <char style="ior"><ref loc="TIT 2:1-3:11">2:1–3:11</ref></char></para>
  <para style="io1">3. पौलुस तान काह योजनाह सोमजाड्यो एने शाबास केयीन निवरावेह। <char style="ior"><ref loc="TIT 3:12-15">3:12-15</ref></char></para>
  <chapter number="1" style="c" sid="TIT 1" />
  <para style="s">नमस्‍कार</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 1:1" />पौलुसान उगे रेन जो बोगवानान पावोर एने यीशु मसीन प्रेरित हे, बोगवानान निवाड़ेल माणहाह तान बोरहा माय मोदेक केरनेन केरता एने आमरा देरमान खेरली एकलीन इही वोदाड़नेन केरता मोकलायेल हे। <verse eid="TIT 1:1" /><verse number="2" style="v" sid="TIT 1:2" />तो जेलेमक्यो जीवणान आसा जान वायदो बोगवान कायेम किरेल हे, तो केदी बी जुठ नाह बोलने। <verse eid="TIT 1:2" /><verse number="3" style="v" sid="TIT 1:3" />पुण ठिख टेम माय तान वचनान पारचारान द्‍वारे देखाड़ेल हे, जो आपणा सुटकारो आपणारा बोगवानान उकुमान गेत माहु होपाय गीयो, एने मी पारचार बी किरेल ईतो।<verse eid="TIT 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="TIT 1:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:4 </char>
      <char style="xt" closed="false">
        <ref loc="2CO 8:23">2 कुरिंथीयो 8:23</ref>; <ref loc="GAL 2:3">गलातीयो 2:3</ref>; <ref loc="2TI 4:10">2 तीमुथीयुस 4:10</ref></char>
    </note>तीतुसान नावाम, जो बोरहान मेल मिलाप ने विचारा माय मारो खीरलो बिटोख हे:</para>
  <para style="p" vid="TIT 1:4">बोगवान आबोख एने आपुह सुटकारो आपणार यीशु मसीन उगे रेन तुवाह गीण एने सान्ती जुड़ती रेय।<verse eid="TIT 1:4" /></para>
  <para style="s">क्रेते माय तीतुसान काम</para>
  <para style="p">
    <verse number="5" style="v" sid="TIT 1:5" />मी तुवाह क्रेते माय ज्यानकेरता मेलीन आयेल काय ज्‍यु वातु बाकी हेत्यु त्युह हुदारी, एने मार उकुमान गेत एक एक गावा माय डायडाया माणहाह निवाड़ेन मेली, <verse eid="TIT 1:5" /><verse number="6" style="v" sid="TIT 1:6" /><note caller="+" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="1TI 3:2-7">1 तीमुथीयुस 3:2-7</ref></char></note>जाह तु निवाड़ हे तो निर्दोस एय, एने तान एकुच बायकु रेणे जुवे, एने तान सोरा बुरहो केरनारे रेणे जुवे, एने ता माय सिनालो केरनार एने कानुनाह तोड़नारे नाय जुवे।<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">फोक्‍तो एकुस बायकु रेय; नाहते फोक्‍तो एकुस वार वाराड़ एय।</char></note> <verse eid="TIT 1:6" /><verse number="7" style="v" sid="TIT 1:7" />काहाकाय पुडारीह बोगवानान कारबारी एणेन कारेण निर्दोस रेणे जुवे, एने नाह एकइट्यो, नाह राग केरनार, नाह दारूड्यो, नाह राड़ कुट्यो, एने नाह लुटीन कामायेल कामाईन लोबी, <verse eid="TIT 1:7" /><verse number="8" style="v" sid="TIT 1:8" />पुण पावणाय केरनार, एने जो हाजो हे ताह मोंग केरनार, संयमी, नियाव केरनार, चोखालो एने सोमेजदार एय। <verse eid="TIT 1:8" /><verse number="9" style="v" sid="TIT 1:9" />एने तो विश्वासयोग्य वचना पोर जो देरमान पारचारान गेत हे, मोजबुत रेय काय उत्साहित एन खेरलो हिकवोण माय पारचार केर सिके, एने जा विरोद केरतेह तान मुय बोंद केर सिके।<verse eid="TIT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="TIT 1:10" />काहाकाय कानुन तोड़नारे, फालतुक वातु बोलनारे एने ठेगणारे जुलूम माणहे हेते, खास केरीन खेतना ईयेल माय रेन। <verse eid="TIT 1:10" /><verse number="11" style="v" sid="TIT 1:11" />तान मुय बोंद केरने जुवे, एने ज्या माणहे ठेगीन कामावणेन केरता जी वातु हिकाड़ने नाय जुवे, ओहल्यु वातु हिकाड़ीन गेराणान आखा माणहाह बिगाड़ देतेह। <verse eid="TIT 1:11" /><verse number="12" style="v" sid="TIT 1:12" />क्रेतीन माणहाम रेन एक जाणाव केरनार तान माणहान बाराम खुद कियेल हे जो तास ने हे, कियेल हे, “क्रेतीन माणहे कायेम जुठ बोलतेह, खाराब जेनवार, एने आलह्या खादाड़ हेते।” <verse eid="TIT 1:12" /><verse number="13" style="v" sid="TIT 1:13" />ज्यी गोवाय खेरली हे, तानकेरता ताह दोपकावीन चेतावणी आप्या केर काय ता बोरहाम मोजबुत एय जाती। <verse eid="TIT 1:13" /><verse number="14" style="v" sid="TIT 1:14" />एने यहुदिन वार्ता पोर एने ता माणहान उकुमा पोर द्यान नाय देय, जा खेरायीह नाकार केर देतेह। <verse eid="TIT 1:14" /><verse number="15" style="v" sid="TIT 1:15" />चोखाला माणहान केरता आखी वोस्तु चोखी हे, पुण एठा एने अविश्वासी माणहान केरीन कायच बी चोखो नाह सोतो, काहाकाय तान इकेल एने मोन दुयू एठा हेते। <verse eid="TIT 1:15" /><verse number="16" style="v" sid="TIT 1:16" />आमु बोगवानाह ओलेखतेह केरीन ता केयीन देखाड़तेह, पुण कामा माय ताह नाकारतेह, काहाकाय ता खाराब एने उकुम नाह माणनारे हेते, एने काल्ला बी हाजा कामान लायकीन नाय मीले।<verse eid="TIT 1:16" /></para>
  <chapter eid="TIT 1" />
  <chapter number="2" style="c" sid="TIT 2" />
  <para style="s">मसीन चेलाह होबाय ओहलो चालनो</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 2:1" />पुण तु ओहल्यु खेरल्यु वातु हिकाड्या केर ज्‍यु लायकीन हेत्यु। <verse eid="TIT 2:1" /><verse number="2" style="v" sid="TIT 2:2" />मोंडलीन डावाला एदमी सोता पोर काबु केर सिके, सम्माननिय एने सोमेजदार एय, एने तान बुरहो एने मोंग एने दिर पाको एय। <verse eid="TIT 2:2" /><verse number="3" style="v" sid="TIT 2:3" />तिहेस केरीन मोंडलीन डावाल्यु बायकुन बोलनो चालनो चोखाला माणहान गेत रेणे जुवे; ती आरोप लागाड़नार एने दारूड्यी नाह, पुण हाजी वातु हिकाड़नार रेणे जुवे। <verse eid="TIT 2:3" /><verse number="4" style="v" sid="TIT 2:4" />काहाकाय त्यु जुवान बायकुह चेतावणी आपी काय त्यु तान एदमाह एने सोरा पोर मोंग केरी। <verse eid="TIT 2:4" /><verse number="5" style="v" sid="TIT 2:5" />एने त्यु सोमेजदार, चोखाली, एने गेरान कारबार केरनार हाजी, गीण केरनार एने त्युन त्युन एदम्यान ताबाम रेणार जुवे काय बोगवानान वचनान चिहटा नाय एय।<verse eid="TIT 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="TIT 2:6" />इहीचकेरीन जुवान एदम्याह सोमजाड्या केर काय सोता पोर काबु केरनार बोणी। <verse eid="TIT 2:6" /><verse number="7" style="v" sid="TIT 2:7" />आखी वातु माय सोताह हाजा कामान नमुनो बोणाव। एने तार हिकवोण माय साप साप एने गम्बीरता, <verse eid="TIT 2:7" /><verse number="8" style="v" sid="TIT 2:8" />एने ओहली खेराय एय काय कुण बी ताह खाराब नाय केय सिके, ज्यो देखीन विरोद केरनाराह आपु पोर काल्लो बी आरोप लागाड़नेन टेम नाय जुड़ी पुण लाजवाणे जुवे।<verse eid="TIT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 2:9" />पावराह सोमजाड़ते रे काय आप आपणा मालीकान ताबाम रेती, एने आखी वातु माय ताह खुस केरी, पुण पोशो उलटो जापाप नाय आपी। <verse eid="TIT 2:9" /><verse number="10" style="v" sid="TIT 2:10" />चोरी चालाकी नाय केरी, पुण आखी बातीन वातु माय हाजी एने ईमानदार रेय, ज्यानकेरता काय आमरा सुटकारो आपणारा बोगवानान हिकवोणान होबा वोड़ावी।<verse eid="TIT 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="TIT 2:11" />काहाकाय आखा माणहान सुटकारान केरता बोगवानान गीण देखायेल हे। <verse eid="TIT 2:11" /><verse number="12" style="v" sid="TIT 2:12" />एने ती गीण आमुह हिकाड़ेह काय आमु बिगेर देरमान जीवणो एने दुनियान वोस्तुन मोरजीह सोड़ दे, एने सोता पोर काबु केरनार, चोखालो एने बोक्‍तीम जीवणो ज्यी दुनिया माय जीवे; <verse eid="TIT 2:12" /><verse number="13" style="v" sid="TIT 2:13" />एने ती बोरकेतवाली आसान मतलब आपणो मुठलो बोगवान एने सुटकारो केरन्या यीशु मसीन बोड़ाय ने आवणेन वाट जोवते रेतेह।<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false">आमरो महान बोगवान एने सुटकारो केरनार यीशु मसी; नाहते तो महान बोगवान एने सुटकारो आपणार मसी यीशु।</char></note> <verse eid="TIT 2:13" /><verse number="14" style="v" sid="TIT 2:14" /><note caller="+" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="1PE 2:9">1 पतरस 2:9</ref></char></note>जो सोताह आपणे केरता आप दियेल काय आपुह आखी बातीन खाराब माय रेन सोड़वे, एने आपुह तास ने चोखाला माणहे बाणावी हाजाला कामान केरता, केरीन कायेम तियार रिवो।<verse eid="TIT 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 2:15" />पुरा आदिकार माय ज्‍यु वातुह हिकाड़, जिहकेरीन तु विरोदीह दोपकावेह एने उत्साहित किरेह, ज्या माय कुण बी तुवाह नेचो सोमेजणे नाय जुवे।<verse eid="TIT 2:15" /></para>
  <chapter eid="TIT 2" />
  <chapter number="3" style="c" sid="TIT 3" />
  <para style="s">मसी बोलनो चालनो कोहलो जुवे</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 3:1" />माणहाह एर केराव काय सारकार एने आदिकारीन ताबाम रेती, एने तान उकुम मानी, एने आखा हाजो काम केरनेन केरता तियार रेती, <verse eid="TIT 3:1" /><verse number="2" style="v" sid="TIT 3:2" />कुणीन बी ईजुत नाय वेरी, लेड़ाणार नाय रेणे जुवे; पुण हुवाला सोबावान रेणे जुवे, एने आखा माणहा हेऱ्यो मोटली गेरबोड़ाय हेऱ्यो रेय। <verse eid="TIT 3:2" /><verse number="3" style="v" sid="TIT 3:3" />काहाकाय आपु बी पेल विणएकल्या, एने उकुम नाह माणनारे, ब्रम माय पोड़ीन आलेग आलेग बातीन अबिलाषाम एने हुकान पावराय माय एता, एने बेदबाव, एने कुयराय केरनेम जीवन जीवताला, एने खाराब एता, एने एका दिहरा हेऱ्या दुसमोनाय केरताला। <verse eid="TIT 3:3" /><verse number="4" style="v" sid="TIT 3:4" />पुण जेवी आपणो सुटकारो आपणार बोगवानान गीण एने माणहा माय तान मोंग आवो, <verse eid="TIT 3:4" /><verse number="5" style="v" sid="TIT 3:5" />ते तो आपुह सुटकारो आप्यो; एने ज्या देरमान कामान कारीन नाह जा आमु केऱ्या, पुण तान गीणान गेत नोवाला जेल्मान उंगेलनेन नेम एने चोखालो जीव आपुह नोवालो बाणावणेन द्‍वारा एनोह। <verse eid="TIT 3:5" /><verse number="6" style="v" sid="TIT 3:6" />बोगवान आपु पोर चोखालो जीवाह सुटकारो आपणार यीशु मसीन द्‍वारा आपु पोर बोरपुर माय रोचवेल हे। <verse eid="TIT 3:6" /><verse number="7" style="v" sid="TIT 3:7" />काय तान गीण ने द्‍वारा आपु देरमी ठेरायेन जेलेमक्यो जीवणान आसान गेत वोस बोणी।<verse eid="TIT 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="TIT 3:8" />ज्‍यु वातु खेरल्यु हेत्यु, एने ज्‍यु वातुन बाराम तु मोजबुत माय बोली ओहली मार मोरजी हे, ज्यानकेरता काय जा बोगवाना पोर बुरहो किरेल हेते, ता हाज हाजा कामे केरनेम द्यान देय। ज्‍यु वातु हाजी एने माणहान फायदान हेत्यु। <verse eid="TIT 3:8" /><verse number="9" style="v" sid="TIT 3:9" />पुण फोगान बोलाचाल, एने वोस ने, एने विरोद एने राड़ जा कायदान बाराम हेते, वोचीन रे; काहाकाय ता विणफोल एने फालतुक हेते। <verse eid="TIT 3:9" /><verse number="10" style="v" sid="TIT 3:10" />फुट पाड़णार माणहाह एक दुय वारीन सोमजाड़ीन ताह रेन आलेग रे। <verse eid="TIT 3:10" /><verse number="11" style="v" sid="TIT 3:11" />ज्यो जाणीन काय ओहलो माणुह खाराब एय गीयोह, एने सोताह दोसी ठेरावीन पाप केरती रीथे।<verse eid="TIT 3:11" /></para>
  <para style="s">सेवली खुबेर</para>
  <para style="p">
    <verse number="12" style="v" sid="TIT 3:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:12 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 20:4">प्रेरितान काम 20:4</ref>; <ref loc="EPH 6:21">इफिसीयो 6:21</ref>,<ref loc="EPH 6:22">22</ref>; <ref loc="COL 4:7">कुलीसियो 4:7</ref>,<ref loc="COL 4:8">8</ref>; <ref loc="2TI 4:12">2 तीमुथीयुस 4:12</ref></char>
    </note>जेवी मी तार फाय अरतिमासाह नाहते तुखीकुसाह मोकलुह, ते मार फाय निकुपुलीस वोर आवणेन कोसीत किरजे, काहाकाय ता मी हियालाम रेणेन निर्णय लियेल हे। <verse eid="TIT 3:12" /><verse number="13" style="v" sid="TIT 3:13" /><note caller="+" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="ACT 18:24">प्रेरितान काम 18:24</ref>; <ref loc="1CO 16:12">1 कुरिंथीयो 16:12</ref></char></note>जेनास देरेमगुरूह एने अपुल्लोसाह कोसीत केरीन ओंगाण पोचाड़ दे, एने देख काय ताह काल्ली बी वोस्तुन कोमी नाय पोड़ने जुवे। <verse eid="TIT 3:13" /><verse number="14" style="v" sid="TIT 3:14" />आपणा माणहे बी जोरवतीह पुरी केरनेन केरता हाजा कामाम लागीन रेणे हिके काय फालतुक जीवाय नाय जीवे।<verse eid="TIT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 3:15" />मारा आखा हातीन उगे रेन तुवाह नमस्‍कार। जा बोरहान वोजेसे आमुह मोंग केरतेह, ताह नमस्‍कार।</para>
  <para style="p" vid="TIT 3:15">तुमू आखा पोर बोगवानान गीण एती रेय।<verse eid="TIT 3:15" /></para>
  <chapter eid="TIT 3" />
</usx>