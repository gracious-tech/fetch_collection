<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="COL" style="id">- Nahali</book>
  <para style="h">कुलीसियो</para>
  <para style="toc3">कुलीसियो</para>
  <para style="toc2">कुलीसियो</para>
  <para style="toc1">कुलीसियो पौलुस लिखेल पोत्रो</para>
  <para style="mt2">कुलीसियो पौलुस ने लिखा हुआ पत्र</para>
  <para style="mt1">कुलीसियो पौलुस लिखेल पोत्रो</para>
  <para style="imt">ओलखात</para>
  <para style="ip">कुलीसियोन पोत्री प्रेरित पौलुसान <char style="xt"><ref loc="COL 1:1">1:1</ref></char> उगे रेन मोंडलीह लेखायेल एतो, तो ज्यो पोत्र तेवी लिखेल ईतो जुलबुखे तो जेली माय ईतो, एने रोम माय मसीन जेल्मान पासाण कोमीत कोमी 60 सालान पासाण कुलीसियो एने फिलिमोन ने केरता ज्यो पोत्र पौलुस जेली माय रेन लिखेल ईतो ता माय ज्याह जेल पोत्र केवाय जाथे। तो ज्यो पोत्र कुलीसियो हेयरान मोंडलीह लिखेल ईतो। पौलुस कुलीसियो माय मोंडली चालु नाह किरेल ईतो काहाकाय तो <char style="xt"><ref loc="COL 2:1">2:1</ref></char> माय देखाड़ेल हे। पुण तान केरता थोड़ीक जिमेदारी जाणेल ईतो, ज्यो आंदास हे काय एपाफ्रास मोंडली बाणायेल ईतो, काहाकाय तो कुलीसियो वालो ईतो।</para>
  <para style="ip">पौलुस कुलीसियोन मोंडली माय गेलेत सिक्शा हेऱ्यो समंद एतो तो देखाड़ेल हे, तो पोत्र लेणेन केरता जुलूम खीरचो किरेल ईतो। एय सिकेह काय यहुदि विश्वासीन एक टुलो ईतो, जुनाला नेमा माय यहुदि कायदान पालेन केरनेन केरता दिहरा विश्वासी बायाख मोजबुर केरने बाजरियेल एता, खास केरीन खेतना। पौलुस खास केरीन लिखेह काय मसीह बोगवानाह <char style="xt"><ref loc="COL 1:15-20">1:15-20</ref></char> मान्ने सिवाय मसीन सिवाय कायच नाह, एने कायताच ने गिरेज नाय मिले एने माणहान मोना पोर हिकाड़ेल सिक्शा बेकार हे। <char style="xt"><ref loc="COL 2:8">2:8</ref></char></para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. पौलुस कुलीसियोन मोंडलीह नमस्‍कार केरीन पोत्रान सुरवात किरेल हे। <char style="ior"><ref loc="COL 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. ओवतो तो मसीन महानता बारा माय लिखेह खास केरीन कुलीसियो माय जुठी सिक्शान बारा माय लिखेह। <char style="ior"><ref loc="COL 1:3-3:4">1:3–3:4</ref></char></para>
  <para style="io1">3. पौलुसान जुलूम पोत्रा माय तो पोत्रान व्यातीत किरेह जा हाजाला विश्वासी जीवणो जीवणे खाज निर्देश आपेह। <char style="ior"><ref loc="COL 3:5-4:6">3:5–4:6</ref></char></para>
  <para style="io1">4. पौलुस दिहरी मोंडलीह जोरेस वाचाय जाणार पोत्रान केरता साबासकी एने निर्देश आपेह। <char style="ior"><ref loc="COL 4:7-18">4:7-18</ref></char></para>
  <chapter number="1" style="c" sid="COL 1"/>
  <para style="p">
    <verse number="1" style="v" sid="COL 1:1"/>कुलीसियोन मोंडली वाला मसी यीशु पोर बुरहो केरनारे बाय बोणहाह, बोगवानान प्रेरित पौलुस एने बाहख तीमुथीयुस ने उगे रेन, <verse eid="COL 1:1"/><verse number="2" style="v" sid="COL 1:2"/>कुलीसियो माय रेणारे बोगवानान ता बोरहावाला बायाख ने जा मसी माय एक हेते,</para>
  <para style="p" vid="COL 1:2">आपणा आबाख बोगवानान उगे रेन तुमूह गीण एने सान्ती जुड़ी,<verse eid="COL 1:2"/></para>
  <para style="s">दन्यवाद ने विन्ता</para>
  <para style="p">
    <verse number="3" style="v" sid="COL 1:3"/>जेवी बी आमु तुमरी केरता कायेम विन्ता केरीन आमु आपणा मालीक यीशु मसीन आबोख बोगवानान दन्यवाद केरतेह। <verse eid="COL 1:3"/><verse number="4" style="v" sid="COL 1:4"/>काहाकाय आमु मसी यीशु माय तुमरो बुरहो एने आखा बोगवानान माणहान बाराम तुमरा मोंगान बाराम होमलेल हेते; <verse eid="COL 1:4"/><verse number="5" style="v" sid="COL 1:5"/>जेवी खेरली खुबेर, हाजाली खुबेर, पेल्‍ली वार तुमरी फाय आवो, तेवी तुमू ज्यी आसान बाराम होमल्या जो ज्यी आसा पोर आदारीत हे तानकेरता तुमरो मोंग ती हाजाली खोबरी पोर आदारीत हे, जो तुमरी केरता हेरगा माय हास केरीन मेलायेल हे। <verse eid="COL 1:5"/><verse number="6" style="v" sid="COL 1:6"/>हाजाली खुबेर बोरकेत लावेह एने पुरी दुनिया माय पोसेरते जाथे, तिहेस केरीन जिहकेरीन तुमरे विचीम ते दिह रेन हे, जेवी तुमू पेल्‍ली वार बोगवानान गीणीन बाराम होमल्या एने मालुम पोड़नो काय ज्यो खेरीच हे। <verse eid="COL 1:6"/><verse number="7" style="v" sid="COL 1:7"/><note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="COL 4:12">कुलीसियो 4:12</ref>; <ref loc="PHM 1:23">फिलेमोन 1:23</ref></char></note><note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false">आमरो; थोड़ाक लेख माय तुमरो लिखेल हे। </char></note>बोगवानान गीणीह तुमू आमरा मोंगाल्ला हाती सेवक इपफ्रास फाय रेन हिकेल हेते, जो आमरी उगे रेन मसीन बोरहावालो काम केरनार हे। <verse eid="COL 1:7"/><verse number="8" style="v" sid="COL 1:8"/>तोच तुमरा मोंगाह जो जीवा माय तुमरो मोंग हे ताच माय आपुह बाणायेल हे।<verse eid="COL 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="COL 1:9"/>तानकेरता जेवी रेन आमु तुमरे बाराम होमलेल हेते ते दिह रेन आमु तुमरी केरता कायेम विन्ता किरेल हेते। काय तो पुरी आत्मिक बुद्दी एने सोमेज जो तान जीव आपेह तान मोरजीन इकेल केरीन तुमूह बोर देय। <verse eid="COL 1:9"/><verse number="10" style="v" sid="COL 1:10"/>तानकेरता काय तुमरो बोलनो चालनो मालीकाह पोटे, जो ताह आखी बातीन खुस केरनार एय एने तुमरी जीवायी केरीन हाजा कामाह देखाड़ सीको, एने तुमू बोगवानान एकली माय वोदते जावो। <verse eid="COL 1:10"/><verse number="11" style="v" sid="COL 1:11"/><note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="ft" closed="false">दिर देरीन; एने खुसी माय, आबार मानु; नाहते दिर एने खुसी माय। एने दिहरान आबार मानु।</char></note>एने बोगवानान बोड़ायीन ताकेत केरीन जी ताकेत जुड़ेह तीम मोजबुत एते जावो, काहाकाय तुमू दिर हेऱ्या आखो वेठणेन लायेक बोणी। एने खुसी माय आबाख दन्यवाद किरो <verse eid="COL 1:11"/><verse number="12" style="v" sid="COL 1:12"/>जो तुमूह ज्यान लायेक बाणायो काय बोगवानान ता माणहा हेऱ्यो, जो तो तानकेरता पेलुस हास केरीन मेलायेल उजालान राज माय तुमू आदिकार सापड़ावणे माय बागी एय सीको। <verse eid="COL 1:12"/><verse number="13" style="v" sid="COL 1:13"/>एने तो आपुह आदारलान आदिकार माय रेन सोड़व्यो, एने तान मोंगाल्ला बेटाख ने राज माय होमालीन लायेल हे। <verse eid="COL 1:13"/><verse number="14" style="v" sid="COL 1:14"/><note caller="+" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="EPH 1:7">इफिसीयो 1:7</ref></char></note>एने तान द्‍वारा आपु आजाद केराय गीया, मतलब आपुह आपणा पापान माफी जुड़नी।<verse eid="COL 1:14"/></para>
  <para style="s">मसीन काम एने व्यक्तित्व</para>
  <para style="p">
    <verse number="15" style="v" sid="COL 1:15"/>नाह देखाणार बोगवानान वेह रूप हे मसी एने तो आखी बाणायेल चिजी माय रेन पेल्लो पायदा ईयेल बिटोख हे। <verse eid="COL 1:15"/><verse number="16" style="v" sid="COL 1:16"/>काहाकाय बोगवान तान द्‍वारा आखी चिजीह बाणायो हेरगावाल्यु एय नाहते देरती पोर वाल्यु, देखाणार चिज एने नाह देखाणार चिज, राजगादि, मालीक, आदिकारी, आदिकार। आख्‍यु चिज ताच ने द्‍वारा एने तास ने केरता बाणायेल हे। <verse eid="COL 1:16"/><verse number="17" style="v" sid="COL 1:17"/>आखी चिजीन पेल मसी अस्‍तित्‍वा माय ईतो, एने तान एकता माय आखी चिज त्युन ठिक जागा पोर टिकीन रीथे। <verse eid="COL 1:17"/><verse number="18" style="v" sid="COL 1:18"/><note caller="+" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="EPH 1:22">इफिसीयो 1:22</ref>,<ref loc="EPH 1:23">23</ref></char></note>तोच सेरीर, मतलब मोंडलीन मुंड हे; तोच सुरवात हे, एने मुरेल माय रेन जीव उठणारा माय रेन पेल्लो हे, काय आखी जागे तोच पेल्लो ठेराय। <verse eid="COL 1:18"/><verse number="19" style="v" sid="COL 1:19"/>काहाकाय हेरगावाला आबाख ने खुसी ज्याच माय हे एने ताम आखी पुराय वोहे। <verse eid="COL 1:19"/><verse number="20" style="v" sid="COL 1:20"/><note caller="+" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="EPH 2:16">इफिसीयो 2:16</ref></char></note><note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="ft" closed="false">तान सोरान लुय केरीन; नाहते तान सोरान अर्पण किरेल मोत केरीन।</char></note>बेटाख ने माद्यम केरीन एने तान बोगवान खुरूसखाम पोर तान सोरान लुयीन माद्यमा केरीन सान्ती बाणायो एने ज्यानकेरता देरती पोर वोयेल लुयी केरीन मेल केरीन, सोब चिजीह ताच ने द्‍वारा आपणे हेऱ्या मेल केर लिवो, त्यु देरती पोर वाल्यु एती, नाहते हेरगावाल्यु।<verse eid="COL 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 1:21"/>एक टेम ईतो जेवी तुमू बोगवाना हेऱ्या रेन सेटा एता, एने आपणा मोन ने विचार एने खाराब कामा केरीन बोगवानान दुसमोन एता। <verse eid="COL 1:21"/><verse number="22" style="v" sid="COL 1:22"/>तो एवी सारिरीक सेरीर माय मोतीन द्‍वारे तुमू बोगवाना हेऱ्यो दोस्ती बाणाव लिदो, काहाकाय तुमूह तान सामने चोखाला एने बिगेर पापान, एने निर्दोस बाणावीन उबराखे। <verse eid="COL 1:22"/><verse number="23" style="v" sid="COL 1:23"/>केदी तुमू बोरहान आदार पोर मोजबुत बोणीन रिहो, एने ती हाजाली खोबरीन आसाह जीह तुमू होमलेल हेते मा सोड़ो, जान पारचार जुगान नेचली आखी बाणावोट माय केराय गीयो, एने जान मी पौलुस सेवक बोणेल हे।<verse eid="COL 1:23"/></para>
  <para style="s">पौलुसान मोंडली माय सेवकान काम</para>
  <para style="p">
    <verse number="24" style="v" sid="COL 1:24"/>एवी मी ता दुखान वोजेसे खुस मोणावथो, जो तुमरी केरता विसथो, एने मसीन पिड़ान गेटी तान सेरीरान केरता, मतलब मोंडलीन केरता, मारा सेरीर माय पुरो केरथु। <verse eid="COL 1:24"/><verse number="25" style="v" sid="COL 1:25"/>एने मी बोगवानान द्‍वारा मोंडलीन सेवक बाणावाय गीयो, जो माहु तुमरी बोलाय केरनेन केरता काम होप्यो। एने ज्यो काम तान खोबरीन पुरो पुरो पारचार किरेह। <verse eid="COL 1:25"/><verse number="26" style="v" sid="COL 1:26"/>ज्यी खुबेर लिकायेल मतलब त्यु लिकायेल वातुह ज्‍यु टेमान एने पिढीन पिढी लिकायेल एतो, पुण एवी तान बोगवानान माणहा पोर देखाड़ेल हे। <verse eid="COL 1:26"/><verse number="27" style="v" sid="COL 1:27"/>बोगवानान ज्यी योजना एती काय तान माणहा पोर जी लिकायेल वात देखाड़ी काय ज्यो लिकायेल कोलीक बोड़ाय मोंगी हे, जी तान माणहान केरता हे। एने ज्यी लिकायेल वात ज्यी हे काय मसी तुमरे माय हे मतलब तुमू बोगवानान बोड़ाय ने आसा माय बागी एय सेकतेह। <verse eid="COL 1:27"/><verse number="28" style="v" sid="COL 1:28"/>केरीन आमु मसीन पारचार आखाह केरतेह। एने जो आपुह इकेल हे ती आखी बुद्दीन वापेर केरती लेन आमु आखाह निर्दोस एने हिक आपतेह काहाकाय आपु ताह मसी माय एक व्यक्तिगत एक पुरो माणुह बाणावीन बोगवानान सामने उबराखे। <verse eid="COL 1:28"/><verse number="29" style="v" sid="COL 1:29"/>एने ज्याह पुरो केरनेन केरता मी मसीन मोटली ताकेत जी माहु जुड़ेह एने जी मार माय काम किरेह तीन वापेर केरती लेन मी केठीण मेहनेत एने संगर्ष केरथु।<verse eid="COL 1:29"/></para>
  <chapter eid="COL 1"/>
  <chapter number="2" style="c" sid="COL 2"/>
  <para style="p">
    <verse number="1" style="v" sid="COL 2:1"/>मी होदथु काय तुमूह ज्यी वातीन मालुम पोड़ जाय काय, मी तुमरी केरता एने लोदिकिया माणहा माय रेणारान केरता, एने ता आखान केरता जा व्यक्तिगत रूप माय नाह मीलेल सोता, ता आखान केरता मी कोलोक केठीण मेहनेत केरथु। <verse eid="COL 2:1"/><verse number="2" style="v" sid="COL 2:2"/><note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="ft" closed="false">बोगवानान लिकायेल वातु, जो खुद मसी हे; थोड़ाक लेख माय बोगवानान लिकायेल वात; दिहरा थोड़ाक लेख माय जो मालीक ने आबोख ता बोगवानान लिकायेल वातु; दिहरा थोड़ाक लेख माय बोगवान एने आबोख ज्यान, एने मसीन लिकायेल वात।</char></note>काहाकाय तान मोनाह उत्साह जुड़ी एने ता मोंगा माय एक एय जाय, एने तो पुरो देन जो खेरला सोमेज केरीन सापड़ेह ताह जुड़ जाय। इहकेरीन ताह आबोख बोगवानान बेदान मालुम पोड़ जाय, जो मसी खुद हे। <verse eid="COL 2:2"/><verse number="3" style="v" sid="COL 2:3"/>जा माय बोगवानान बुद्दीन एकलीन कुचीन बण्‍डार लिकायेल हे। <verse eid="COL 2:3"/><verse number="4" style="v" sid="COL 2:4"/>ज्यो मी ज्यानकेरता केथु, काय काल्लो बी माणुह हाजाला सोबाव केरीन तुमूह दुको नाय देय। <verse eid="COL 2:4"/><verse number="5" style="v" sid="COL 2:5"/>काहाकाय मी तुमूह रेन सेरीरा माय सिटो हे, पुण जीवाम तुमरी आहने हे, एने तुमरा हास केरीन जीवायीह एने तुमरा बोरहान, जो मसी माय हे, मोजबुत देखीन खुस एथु।<verse eid="COL 2:5"/></para>
  <para style="s">मसी माय जीवायीन बोरपुरी</para>
  <para style="p">
    <verse number="6" style="v" sid="COL 2:6"/>तानकेरता जिहकेरीन तुमू मसी यीशुह मालीक हे केरीन मान लेदाह, तिहेच केरीन तास माय एक बोणीन जीवो। <verse eid="COL 2:6"/><verse number="7" style="v" sid="COL 2:7"/>एने तास माय मुले गाड़ीन वोदते जावो, एने जिहकेरीन तुमू हिकेल हेते, तिहेच केरीन बोरहाम मोजबुत एते जावो, एने जुलूम काय जुलूम दन्यवाद किरते रिवो।<verse eid="COL 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 2:8"/>चेकचेल्या रिवो, काय कुण बी तुमूह ता माणहान एकलीन फालतुक वातु केरीन दुको नाय देय एने गुलाम नाय बाणाव लेय, जा माणहान रिती एने दुनियान पेल्‍ली हिकवोणान गेत हे, पुण मसीन गेत नाह। <verse eid="COL 2:8"/><verse number="9" style="v" sid="COL 2:9"/>काहाकाय ता माय बोगवानान सोबाव जेलेम मसीन सेरीर माय वोहेह। <verse eid="COL 2:9"/><verse number="10" style="v" sid="COL 2:10"/>एने तुमूह मसीन एकता माय पुरी जीवाय आपेल हे। ता माय बोरपुर एय जायेल हेते जो आखी प्रदानता एने आदिकारान मुखी हे। <verse eid="COL 2:10"/><verse number="11" style="v" sid="COL 2:11"/>मसीन एकता माय तुमरो खेतान केरायेल एतो नाह काय माणहान द्‍वारा केराय जाणार खेतना हेऱ्यो, पुण जो आथा केरीन नाह एत, पुण मसीन खेतान एनो, जाकेरीन सारिरीक सेरीर उताराय जाथे। <verse eid="COL 2:11"/><verse number="12" style="v" sid="COL 2:12"/><note caller="+" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="ROM 6:4">रोमीयो 6:4</ref></char></note>जेवी तुमू बपतीस्मा लियेल एता ते तुमूह मसी हेऱ्या बुजाय जायेल एता, एने ताच माय बोगवानान ताकेती पोर बुरहो केरीन, जो ताह मुरेल माय रेन जीवाड्यो, ता हेऱ्या जीव बी उठना। <verse eid="COL 2:12"/><verse number="13" style="v" sid="COL 2:13"/><note caller="+" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="EPH 2:1-5">इफिसीयो 2:1-5</ref></char></note>एक टेम तुमू बी आत्मिकता माय मुरेल एता काहाकाय तुमू पापी, एने बिगेर यहुदि बिगेर नेमान एता। पुण एवी बोगवान तुमूह मसी हेऱ्यो जीवाय माय लायेल हे। बोगवान आपणा आखा पापान माफ किरेल हे। <verse eid="COL 2:13"/><verse number="14" style="v" sid="COL 2:14"/><note caller="+" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="EPH 2:15">इफिसीयो 2:15</ref></char></note>बोगवान आपणा खाराब कामान लेखाह आपणे विचीम रेन सेटो केर दिनो, जा माय ता नेमान उल्लेख केरायेल एतो, जो आपणे विरोद एतो तो ताह खुरूसखाम पोर खीला केरीन ठोकाएन मीटाड़ दियेल हे। <verse eid="COL 2:14"/><verse number="15" style="v" sid="COL 2:15"/><note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false">मसी खुद आत्मिक आदिकारी एने आदिकारीन ताकेत से सोड़वेल; नाहते मसी खुद आत्मिक आदिकारी एने आदिकारी तान ताकेत निकाल लिदो।</char></note>मसी खुरूसखामान द्‍वारा आद्यात्मिक आदिकारी एने तो मुखी एने आदिकारीह तान उपेर रेन उतारीन तान उदाह तामाशो बाणायो एने तान जिकेल अबियान माय खुरूसखामान वोजेसे ता पोर जय जयकारान दुन होमलाड्यो।<verse eid="COL 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 2:16"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">2:16 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 14:1-6">रोमीयो 14:1-6</ref>
      </char>
    </note>तानकेरता काल्लो बी माणुह तुमरा खाणा पिणान नाहते नोवाला चांदान तिवार एने विहेवणेन दिह्यान बाराम तुमरो कुण नियाव नाय केरी। <verse eid="COL 2:16"/><verse number="17" style="v" sid="COL 2:17"/>काहाकाय ज्‍यु सोब आवणारी बविष्‍यान वातीन सावलो हे, पुण खेराय मसी मायच जुड़ी। <verse eid="COL 2:17"/><verse number="18" style="v" sid="COL 2:18"/>काल्ला बी माणहान द्‍वारा तान चिहटा एणेन पारवांगी नाय आपी, जीवा माय गेरबोड़ो एने हेरोगदुतान पुजा केरावीन तुमूह दोवेड़नेन फोला हेऱ्या रेन सेटा नाय केरी। ओहलो माणुह दिखेल वातु माय लाग रीथे एने तान सारिरीक सोमेज माय वायबार मोठाय किरेह। <verse eid="COL 2:18"/><verse number="19" style="v" sid="COL 2:19"/><note caller="+" style="x"><char style="xo" closed="false">2:19 </char><char style="xt" closed="false"><ref loc="EPH 4:16">इफिसीयो 4:16</ref></char></note>एने मसीह देरीन रेणे सोड़ दियेल हेते, एने तो मसी जो सेरीरान मुंड हे। मसीन ताबाम आखो सेरीर हे जो जोड़ा एने नेहा केरीन एकठोस जोड़ायेल हे, एने बोगवान जीहे वोदाड़ ने हुदेह तिहेच केरीन वोदते जाथे।<verse eid="COL 2:19"/></para>
  <para style="s">मसी हेऱ्या जीवणे एने मोरने</para>
  <para style="p">
    <verse number="20" style="v" sid="COL 2:20"/>काहाकाय तुमू मसीह हेऱ्या मोर जायेल हेते एने ब्रमांड माय राज केरनारी जीवाह रेन सोड़वेल हेते। ओवता काहा तान गेत जा दुनियाम जीवाय जीवतेह एने तुमू ओहली विदीन ताबाम काहा रेतेह। <verse eid="COL 2:20"/><verse number="21" style="v" sid="COL 2:21"/>काय “ज्यो नाह आथेलनु, एने ताह नाह साकणु, एने ताह आथ नाह लागाड़नु।” <verse eid="COL 2:21"/><verse number="22" style="v" sid="COL 2:22"/>काहाकाय ज्‍यु आख्‍यु चिज कामे लागाड़ता लागाड़ता खेतेम एय जाती, काहाकाय ज्‍यु माणहान उकुमान एने हिकवोणान गेत हे। <verse eid="COL 2:22"/><verse number="23" style="v" sid="COL 2:23"/>खेरीच ओहला सोब नेम हेरोगदुतान ताकेती हेऱ्या ज्या नेमा माय आपणी मोरजीन गेत हेरोगदुतान बोक्‍तीन रिती, एने जीवान गेरबोड़ाय, सारिरीक सराव ने बाव से एकलीन नाव ते हे, पुण सारिरीक लालचायीह रोकणे माय न्या फाय रेन काय फायदो नाह।<verse eid="COL 2:23"/></para>
  <chapter eid="COL 2"/>
  <chapter number="3" style="c" sid="COL 3"/>
  <para style="p">
    <verse number="1" style="v" sid="COL 3:1"/>जेवी तुमू मसी हेऱ्या जीवाड़ाय गीया, ते आपणा मोनाह हेरगावाली वोस्तुन होद माय रिवो जाहरी मसी हे, एने बोगवानान जीवड़े उगे बोह रियेल हे। <verse eid="COL 3:1"/><verse number="2" style="v" sid="COL 3:2"/>देरती पोर वाली नाह पुण हेरगावाली वोस्तु पोर आपणो मोन लागाड़ो। <verse eid="COL 3:2"/><verse number="3" style="v" sid="COL 3:3"/>काहाकाय तुमू ते मोर जायेल हेते एने तुमरी जीवाय मसी हेऱ्यी बोगवाना माय लीकाय रेनीह। <verse eid="COL 3:3"/><verse number="4" style="v" sid="COL 3:4"/>जेवी मसी जो आमरी खेरली जीवाय मसी हे, देखाय, तेवी तुमू बी ता हेऱ्या बोड़ाय हेऱ्या देखाड़ाय जाहो।<verse eid="COL 3:4"/></para>
  <para style="s">जुनाली एने नोवाली जीवाय</para>
  <para style="p">
    <verse number="5" style="v" sid="COL 3:5"/>तानकेरता आपणा ता जेगान मोरजीह मार टाको, जी तुमू माय काम किरेह, मतलब सिनालो, एठोपोणा, खाराबपोणा, खाराब लालचाय एने लोबाह जो मुरती पुजान बाराबोर हे। <verse eid="COL 3:5"/><verse number="6" style="v" sid="COL 3:6"/>काहाकाय ज्‍यु वातीन वोजेसे जा बोगवानान वातु नाह मानतेह ता पोर बोगवानान राग आवी।<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="ft" closed="false">थोड़ाक लेख माय जो कुण तान उकुम ने पालेन नाह किरेत ता पोर नाह लिखेल सोतो।</char></note> <verse eid="COL 3:6"/><verse number="7" style="v" sid="COL 3:7"/>एने एक टेम एतो, तेवी तुमू बी ओहली आसा माय जीवताला, एने तुमरो जिवणो ताच ने आदिकार माय एतो। <verse eid="COL 3:7"/><verse number="8" style="v" sid="COL 3:8"/>पुण एवी तुमू बी जी आखी वातुह आखाह मतलब राग, लालसा, बेदबाव, चिहटा, एने तुमरा मुया केरीन जुलने ज्यो आखो तुमरी हेऱ्या रेन सेटा किरो। <verse eid="COL 3:8"/><verse number="9" style="v" sid="COL 3:9"/><note caller="+" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="EPH 4:22">इफिसीयो 4:22</ref></char></note>एकमेकाह जुठ मा बोलो, काहाकाय तुमू जुनाला तान आदेत निकाल दियेल हेते। <verse eid="COL 3:9"/><verse number="10" style="v" sid="COL 3:10"/><note caller="+" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="EPH 4:24">इफिसीयो 4:24</ref></char></note>एने जो नोवालो माणुह, आपुह बाणावणारान वेह रूपान गेत पुरी एकली माय नोवालो इती जाथे, ताह तुमू पिर लियेल हेते। <verse eid="COL 3:10"/><verse number="11" style="v" sid="COL 3:11"/>एने ज्यान परिणाम ज्यो हे काय तो यहुदि एने बिगेर यहुदि माय काय फारेक नाह रेत, एने नाह तो काल्ला खेतान किरेल माय नाह खेतना रहित माय एने नाहते सब्य नाहते असब्य माय। नाह गुलाम नाह सुटेल माणहा माय, पुण मसीच आखो हे, एने आखा माय तान वास हे।<verse eid="COL 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 3:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:12 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 4:2">इफिसीयो 4:2</ref>
      </char>
    </note>एने तुमू बोगवानान माणहे हेते; तो तुमूह मोंग किरेह एने तान आपणा बोणनेन केरता निवाड़ेल हे, ते ओवतो मोटली गीण, बोलाय, गेरबोड़ाय, नम्रता एने दिराह पिरो। <verse eid="COL 3:12"/><verse number="13" style="v" sid="COL 3:13"/><note caller="+" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="EPH 4:32">इफिसीयो 4:32</ref></char></note>एकमेकान सेहेन किरो, एने एगदान एगदा हेऱ्यी राड़ एय ताहार एकमेकान माफ किरो; मालीक तुमरा गुना माफ किऱ्यो, तिहेच केरीन तुमू बी एकमेकाह माफ किरो। <verse eid="COL 3:13"/><verse number="14" style="v" sid="COL 3:14"/>एने जी वातुन अतिरीक्त मोंगाह पिरो, मोंगुस आखाह आपसाम बांदणे एने परिपुर्ण केरने। <verse eid="COL 3:14"/><verse number="15" style="v" sid="COL 3:15"/>तुमरा लेणारा निर्णय पोर मसी फाय रेन जुड़णार सान्तीन मार्गदर्शन रेय, ज्यास ने केरता तुमूह बोगवान एकठोस ती सान्ती माय एक सेरीर बोणनेन केरता हादिल हे। <verse eid="COL 3:15"/><verse number="16" style="v" sid="COL 3:16"/><note caller="+" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="EPH 5:19">इफिसीयो 5:19</ref>,<ref loc="EPH 5:20">20</ref></char></note>मसीन वचनाह तुमरा मोना माय मोकतोस रेणे दिवो, एने तुमू आखी बुद्दी माय एका दिहरा हिक एने चेतावणी दिते रिवो, बजन, स्तुती एने चोखाला गीते गावतीन आपणा मोना माय बोगवानाह दन्यवाद दिते रिवो। <verse eid="COL 3:16"/><verse number="17" style="v" sid="COL 3:17"/>जो काय बी तुमू किरो नाहते किवो, तो आखो मालीक यीशुन नावा केरीन किरो, एने तान द्‍वारे आबाख बोगवानान दन्यवाद किरो।<verse eid="COL 3:17"/></para>
  <para style="s">नोवाली जीवायीन कुटूमान नेम</para>
  <para style="p">
    <verse number="18" style="v" sid="COL 3:18"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:18 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 5:22">इफिसीयो 5:22</ref>; <ref loc="1PE 3:1">1 पतरस 3:1</ref></char>
    </note>एय बोणह्युख, जिहकेरीन मसी माय अनुयायीह होबीह, तिहेच केरीन आप आपणा एदम्यान ताबाम रिवो। <verse eid="COL 3:18"/><verse number="19" style="v" sid="COL 3:19"/><note caller="+" style="x"><char style="xo" closed="false">3:19 </char><char style="xt" closed="false"><ref loc="EPH 5:25">इफिसीयो 5:25</ref>; <ref loc="1PE 3:7">1 पतरस 3:7</ref></char></note>एय एदमी, आप आपणी बायकुह मोंग किरो, एने ती हेऱ्या खाराब वेवार मा किरो। <verse eid="COL 3:19"/><verse number="20" style="v" sid="COL 3:20"/><note caller="+" style="x"><char style="xo" closed="false">3:20 </char><char style="xt" closed="false"><ref loc="EPH 6:1">इफिसीयो 6:1</ref></char></note>एय सोरा, तुमू आखी वातुम कायेम आपणा आईख आबाख ने उकुम मानो, काहाकाय मसीह अनुयायीन ज्या व्यवहारा से बोगवान खुस एणे। <verse eid="COL 3:20"/><verse number="21" style="v" sid="COL 3:21"/><note caller="+" style="x"><char style="xo" closed="false">3:21 </char><char style="xt" closed="false"><ref loc="EPH 6:4">इफिसीयो 6:4</ref></char></note>एय आहख आबाख तुमरा सोराह राग मा लागाड़ो, इही नाय एय काय तान ईमोत तुट जाय। <verse eid="COL 3:21"/><verse number="22" style="v" sid="COL 3:22"/><note caller="+" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="EPH 6:5-8">इफिसीयो 6:5-8</ref></char></note>एय सेवक, माणहाह खुस केरनेन गेत देखाड़नेन केरता नाह पुण बोगवानाह बिते लेन मोनान खेराय केरीन तान आखी वातु माय उकुम मानो जो देरती पोर तुमरा मालीक हेते। <verse eid="COL 3:22"/><verse number="23" style="v" sid="COL 3:23"/>जो काय काम तुमू केरतेह तो आपणा पुरा मोना केरीन किरो, ज्योस सोमजीन काय तुमू माणहान नाह, पुण मालीक ने काम केरतेह। <verse eid="COL 3:23"/><verse number="24" style="v" sid="COL 3:24"/>एर मिलो काय ज्यान फोल तुमूह मालीक आपी, काहाकाय मसीच खीरलो मालीक जा सेवा तुमू केरतेह। ज्यो जाणते लेन काय तुमूह मालीक से फोल जुड़ी। तुमू आपणो मालीक मसीन सेवा केरती रिवो। <verse eid="COL 3:24"/><verse number="25" style="v" sid="COL 3:25"/><note caller="+" style="x"><char style="xo" closed="false">3:25 </char><char style="xt" closed="false"><ref loc="EPH 6:9">इफिसीयो 6:9</ref></char></note>काहाकाय जो बुराय किरेह, तो तान बुरायीन फोल सापड़ावी; काहाकाय बोगवान कुणीन बी नुकसान नाह केरने।<verse eid="COL 3:25"/></para>
  <chapter eid="COL 3"/>
  <chapter number="4" style="c" sid="COL 4"/>
  <para style="p">
    <verse number="1" style="v" sid="COL 4:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:1 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 6:9">इफिसीयो 6:9</ref>
      </char>
    </note>एय मालीक, तुमू आपणा सेवकाह तान कामान गेत हाजो वेवारो ताह हेऱ्या किरो। एर मिलो काय हेरगा माय बी तुमरो एक मालीक हे।<verse eid="COL 4:1"/></para>
  <para style="s">विन्ता एने दाड़ीन ने वेवार</para>
  <para style="p">
    <verse number="2" style="v" sid="COL 4:2"/>विन्ता माय लागीन रिवो, एने बोगवानाह दन्यवाद केरती लेन ता माय जागताला रिवो। <verse eid="COL 4:2"/><verse number="3" style="v" sid="COL 4:3"/>एने ज्या हेऱ्याच आमरी केरता बी विन्ता केरती रिवो, काय बोगवान आमरी केरता वचन होमलावनेन ओहलो बायणो उगाड़ देय, काय आपु मसीन ता बेदान खोबरीन पारचार केर सेकी ओहलो हाजो टेम आपी काहाकाय ज्यास ने कारेण मी बोंदी हे। <verse eid="COL 4:3"/><verse number="4" style="v" sid="COL 4:4"/>विन्ता किरो काय मी ज्याह ओहलो स्पष्टता हेऱ्यो केय सेकु जिहकेरीन माहु केणे जुवे। <verse eid="COL 4:4"/><verse number="5" style="v" sid="COL 4:5"/><note caller="+" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="EPH 5:16">इफिसीयो 5:16</ref></char></note>टेमान पुरो पुरो काम माय लावो एने विण बोरहा वालाह एकलीदार माय वेवार किरो। <verse eid="COL 4:5"/><verse number="6" style="v" sid="COL 4:6"/>तुमरो बोलनो कायेम गीणा माय बोरायीन एने माणहाह पुटी ओहली एय काय तुमू जाण लिवो काय तुमू माणहाह किहीक जापाप आप सीको।<verse eid="COL 4:6"/></para>
  <para style="s">सेवल्यो नमस्‍कार</para>
  <para style="p">
    <verse number="7" style="v" sid="COL 4:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:7 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 20:4">प्रेरितान काम 20:4</ref>; <ref loc="2TI 4:12">2 तीमुथीयुस 4:12</ref></char>
    </note>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:7 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 6:21">इफिसीयो 6:21</ref>,<ref loc="EPH 6:22">22</ref></char>
    </note>मोंगाल्लो बाहख एने बोरहावालो सेवक, तुखीकुस जो मालीक माय मारो मोदेक केरनार हे, मारी आखी खुबेर तुमूह केय देय। <verse eid="COL 4:7"/><verse number="8" style="v" sid="COL 4:8"/>ताह मी ज्यानकेरता तुमरी फाय मोकलेल हे, काय तुमूह आमरी देशा मालुम एय जाय एने तो तुमरा मोनाह उत्साहित केरी। <verse eid="COL 4:8"/><verse number="9" style="v" sid="COL 4:9"/><note caller="+" style="x"><char style="xo" closed="false">4:9 </char><char style="xt" closed="false"><ref loc="PHM 1:10-12">फिलेमोन 1:10-12</ref></char></note>एने ता हिऱ्यो उनेसीमुसाह मोकलेल हे; जो बोरहावालो एने मोंगाल्लो बाहख एने तुमरे मायच रेन हे, तो तुमूह न्या जो एय, तो न्यावाली आखी वात केय देय। <verse eid="COL 4:9"/><verse number="10" style="v" sid="COL 4:10"/><note caller="+" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="ACT 19:29">प्रेरितान काम 19:29</ref>; <ref loc="ACT 27:2">27:2</ref>; <ref loc="PHM 1:24">फिलेमोन 1:24</ref>; </char><char style="xt" closed="false"><ref loc="ACT 12:12">प्रेरितान काम 12:12</ref>,<ref loc="ACT 12:25">25</ref>; <ref loc="ACT 13:13">13:13</ref>; <ref loc="ACT 15:37-39">15:37-39</ref></char></note>अरीस्तर्खुस जो बोंदी माय मार हेऱ्यो हे, एने बरनबासान तुमूह नमस्‍कार मरकुस ने बारामाय तुमूह उकुम जुड़ेल हे, तो केदी तुमू फाय ते तुमू तान स्वागत किरज्‍यो। <verse eid="COL 4:10"/><verse number="11" style="v" sid="COL 4:11"/>एने यूसतुस केवाणार यीशुन बी तुमूह नमस्‍कार पुची। खेतना किरेल माणहा माय रेन ओलास ज्या बोगवानान राज ने काम माय मार हाती हेते, जा मार केरता उत्साह ने कारेण बुणेल हेते। <verse eid="COL 4:11"/><verse number="12" style="v" sid="COL 4:12"/><note caller="+" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="COL 1:7">कुलीसियो 1:7</ref>; <ref loc="PHM 1:23">फिलेमोन 1:23</ref></char></note>यीशु मसीन सेवक इपफ्रास जो तुमरे माय रेन हे, तुमूह नमस्‍कार किथे। एने कायेम तुमरी केरता जीव तोड़ीन विन्ता किरेह, काहाकाय तुमू सिद्द एन पुरा बोरहा हेऱ्या बोगवानान मोरजी पोर टिकीन रिवो। <verse eid="COL 4:12"/><verse number="13" style="v" sid="COL 4:13"/>मी माणहान रिती माय तुमरी केरता एने जा लोदिकियाम हियरापुलीस माय हेते तानकेरता तो जुलूम मेहनेत किरेह, ओहली तान बाराम मी गोवाय दिथो। <verse eid="COL 4:13"/><verse number="14" style="v" sid="COL 4:14"/><note caller="+" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="2TI 4:11">2 तीमुथीयुस 4:11</ref>; <ref loc="PHM 1:24">फिलेमोन 1:24</ref>; </char><char style="xt" closed="false"><ref loc="2TI 4:10">2 तीमुथीयुस 4:10</ref>; <ref loc="PHM 1:24">फिलेमोन 1:24</ref></char></note>आमरो मोंगाल्लो दाकतेर लुका एने देमास ज्या तुमूह नमस्‍कार केतेह। <verse eid="COL 4:14"/><verse number="15" style="v" sid="COL 4:15"/>लोदिकियान बायाख एने नुमफास एने तान गेर चालनार मोंडलीह नमस्‍कार किज्यो।<note caller="+" style="f"><char style="fr" closed="false">4:15 </char><char style="ft" closed="false">नुमफा; थोड़ाक लेख माय नुमफास लिखेल हे।</char></note> <verse eid="COL 4:15"/><verse number="16" style="v" sid="COL 4:16"/>एने तुलेचबूखी तो पोत्र तुमरे माय वाचाय जाय, ताहार इहकेरीन किरज्‍यो काय लोदिकियान मोंडली माय बी वाचाय जाणे जुवे, एने लोदिकिया वालो पोत्र तुमू बी वासज्यो। <verse eid="COL 4:16"/><verse number="17" style="v" sid="COL 4:17"/><note caller="+" style="x"><char style="xo" closed="false">4:17 </char><char style="xt" closed="false"><ref loc="PHM 1:2">फिलेमोन 1:2</ref></char></note>एने अरखीपुसाह किज्यो, “जी सेवा मालीक माय तुवाह होपायेल हे, तीह पुरी केरनेन केरता कालजी ले।”<verse eid="COL 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="COL 4:18"/>मी पौलुस सोता मारा आथा केरीन तुवाह नमस्‍कार लेखणे बाजरिनोह एने एर मिलज्यो काय मी बोंदी माय हे, बोगवानान गीण तुमू हेऱ्यो बोणीन रेय।<verse eid="COL 4:18"/></para>
  <chapter eid="COL 4"/>
</usx>
