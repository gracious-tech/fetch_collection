<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TI" style="id">- Nahali</book>
  <para style="h">1 तीमुथीयुस</para>
  <para style="toc3">1 तीमुथीयुस</para>
  <para style="toc2">1 तीमुथीयुस</para>
  <para style="toc1">तीमुथीयुस पौलुस लिखेल पेल्लो पोत्रो</para>
  <para style="mt2">तीमुथीयुस पौलुस ने लिखा हुआ पहला पत्र</para>
  <para style="mt1">तीमुथीयुस पौलुस लिखेल पेल्लो पोत्रो</para>
  <para style="imt">ओलखात</para>
  <para style="ip">पेल्लो तीमुथीयुसान पुस्तेक प्रेरित पौलुसान उगे रेन तान चेलो तीमुथीयुसाह लेखाय जायेल पोत्र हे। तीमुथीयुस शायद मसीन जेल्मान 62-64 वोरह्या बाद लेखाय जायेल एतो। ज्यो पौलुसान जीवणान सेवले टेम माय एय। पौलुस तीमुथीयुसा हिऱ्यो मोजबुत समंद मेली एने ताह कोलीक वार सोरान रूप माय लिखेल हे। <char style="xt"><ref loc="PHP 2:22">फिलेपियो 2:22</ref></char>, <char style="xt"><ref loc="1TI 1:2-18">1 तीमुथीयुस 1:2–1:18</ref></char></para>
  <para style="ip">ज्यो पौलुसान चार पोत्राम रेन एक हे जाह मोंडली केणेन रेणदेन एगदा माणहाह संबोदित केराय जाथे। दिहरा तीन पोत्रा 2 तीमुथीयुस, तीतुस एने फिलेमोन। 1 तीमुथीयुस माय मोंडलीन पुजा <char style="xt"><ref loc="1TI 2:1-15">2:1-15</ref></char> मोंडलीन अगुवान योग्यता, <char style="xt"><ref loc="1TI 3:1-13">3:1-13</ref></char> एने जुठा मास्तेर्‍यान विरोद चेतावणी। <char style="xt"><ref loc="1TI 1:3-11">1:3-11</ref>; <ref loc="1TI 4:1-5">4:1-5</ref>; <ref loc="1TI 6:2-5">6:2-5</ref></char> ज्यो देखाड़ेह काय किहीक पौलुस तीमुथीयुसाह मोंडलीन विचीम अगुवा बोणनेन हिकवोण आपणे बाजरियेल ईतो। 1 तीमुथीयुस माय कोलाक सिदान्त हेते जा आपणी मोंडली माय स्थानिय मोंडलीन सेवा केरने माय मोदेक केर सेकतेह।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. पौलुस तीमुथीयुसाह नमस्‍कार केरीन सुरवात किरेह। <char style="ior"><ref loc="1TI 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. पौलुस जुठा मास्तेर्‍यान विरोद चेतावणी आपेह। <char style="ior"><ref loc="1TI 1:3-11">1:3-11</ref></char></para>
  <para style="io1">3. पौलुस यीशु मसीन केरता कोलोक आबारी ईतो तो केणे। <char style="ior"><ref loc="1TI 1:12-19">1:12-19</ref></char></para>
  <para style="io1">4. ओंगाण तो तीमुथीयुसाह मुरती पुजा एने मोंडलीन अगुवान बाराम किथे। <char style="ior"><ref loc="1TI 2-3">2–3</ref></char></para>
  <para style="io1">5. पौलुस तीमुथीयुस ने केरता व्यक्तिगत निर्देश हेऱ्यो पोत्री निवरावेह। <char style="ior"><ref loc="1TI 4-6">4–6</ref></char></para>
  <chapter number="1" style="c" sid="1TI 1" />
  <para style="s">नमस्‍कार</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1" />मसी यीशुन प्रेरित पौलुसान उगे रेन जो आमरो सुटकारो केरनार बोगवान, एने आमरी आसान आदार मसी यीशुन उकुमान गेत, <verse eid="1TI 1:1" /><verse number="2" style="v" sid="1TI 1:2" /><note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="ACT 16:1">प्रेरितान काम 16:1</ref></char></note>तीमुथीयुस ने नाव जो बोरहा माय मारो खीरलो बिटोख हे:</para>
  <para style="p" vid="1TI 1:2">बोगवान आबोख, एने आमरा मसी यीशुन उगे रेन तुवाह गीण एने सान्ती एने किव जुड़ते रेय।<verse eid="1TI 1:2" /></para>
  <para style="s">जुठा मास्तेरान विरोद चेतावणी</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3" />जिहकेरीन मी मकादुनिया माय जाणेन बुखेत तुवाह सोमजाड़ेल ईतो, काय इफिसुस माय रेन थोड़ाक माणहाह उकुम आप काय जुठी हिकवोण बोंद केरी। <verse eid="1TI 1:3" /><verse number="4" style="v" sid="1TI 1:4" />ताह तुमू इहकेरीन किवो काय जुठी वार्ता एने जेलेम ने वंसावली पोर मोन नाय लागाड़े, जाकेरीन बोलाचाल एतेह एने बोगवानान ती योजनान गेत नाह, जो बोरहा पोर आदारीत हे। <verse eid="1TI 1:4" /><verse number="5" style="v" sid="1TI 1:5" />उकुम केणेन उद्देश ज्यो हे काय चोखालो मोन एने हाजो मोन बिना कोपेट बोरहा से मोंग पायदा एय। <verse eid="1TI 1:5" /><verse number="6" style="v" sid="1TI 1:6" />थोड़ाक माणहे ते जी वातु से बोटकीन फालतुक वातु माय फोस जायेल हेते। <verse eid="1TI 1:6" /><verse number="7" style="v" sid="1TI 1:7" />ता नियमान मास्तेर्‍या बोणने ते होद्तेह, पुण ज्‍यु वातु केतेह ताह एने नाह त्यु वातुह सोमेजतेह, जाह ता ईमोत हेऱ्या बोलतेह।<verse eid="1TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8" />पुण आमु जाणतेह काय केदी एगदो नियमाह हास केरीन उपयोग केरी ते नेम हाजो हे। <verse eid="1TI 1:8" /><verse number="9" style="v" sid="1TI 1:9" />आमु ज्यो बी जाणतेह काय कायदो देरमी जाणान केरता नाह, पुण एदेरमी, मोन मोरजी माय जीवणारे, विणबोकत्या, पापी, बिगेर चोखालो एने एठा माणहा, आईख आबाख मारनारे, खुनी, <verse eid="1TI 1:9" /><verse number="10" style="v" sid="1TI 1:10" />सिनालो केरनारे, एदम्या हेऱ्यो सिनालो केरनारे, गुलामाह वेचणारे, जुठ बोलनारे, एने जुठी गोवाय देणारे, एने दिहऱ्यु सोब वातुन केरता बाणायेल हे जो ती खेरली हिकवोणान विरोद माय हेते। <verse eid="1TI 1:10" /><verse number="11" style="v" sid="1TI 1:11" />ज्योस बोरकेतवाला बोगवानान बोड़ाय ने ती हाजाली खोबरीन गेत हे, जो माहु होपेल हे।<verse eid="1TI 1:11" /></para>
  <para style="s">पौलुसा पोर बोगवानान गीण</para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12" />मी आपणा मालीक यीशु मसीन दन्यवाद केरथु जो माहु ताकेत आपेल हे, काहाकाय तो माहु बोरहावालो सोमजीन तान सेवा केरनेन केरता माहु निवाड़ लिदो। <verse eid="1TI 1:12" /><verse number="13" style="v" sid="1TI 1:13" /><note caller="+" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="ACT 8:3">प्रेरितान काम 8:3</ref>; <ref loc="ACT 9:4">9:4</ref>,<ref loc="ACT 9:5">5</ref></char></note>मी ते पेल तान चिहटा केरनार, एने सेतावणार, एने बुराय केरनार एदमी ईतो, तीबी माहु पोर गीण एनी, काहाकाय मी अविश्वासीन देशा माय बिगेर सोमजीन ज्यो काम किरेल ईतो। <verse eid="1TI 1:13" /><verse number="14" style="v" sid="1TI 1:14" />एने आमरा बोगवानान गीण ता बोरहा एने मोंगा हेऱ्यो मसी यीशु माय हे, जुलूम जुड़नो। <verse eid="1TI 1:14" /><verse number="15" style="v" sid="1TI 1:15" />ज्यी वात खेरीच एने आखी बातीन माणनेन बाराबोर हे काय मसी यीशु पापी माणहान सुटकारो केरनेन केरता दुनिया माय आयेल, एने ता माय रेन आखा पापीह रेन बी खाराब पापी मी हे, <verse eid="1TI 1:15" /><verse number="16" style="v" sid="1TI 1:16" />पुण माहु पोर ज्यानकेरता गीण एनी काय मी आखाम रेन मोटला पापी पोर मसी यीशु तान आखी सहनशीलता देखाड़ी, काय जा माणहे यीशु पोर पासाण रेन बुरहो केरती एने ता जेलेमक्यो जीवाय सापड़ावती तान केरता मी एक आदर्श बोणु। <verse eid="1TI 1:16" /><verse number="17" style="v" sid="1TI 1:17" />जो कायेम ने राजा हे, एने कायेम खेतेम एण्यो नाह सोतो, एने नाह दिखेल ता एकुच बोगवानान मान एने बोड़ाय कायेम ने कायेम एती रेय। आमेन।<verse eid="1TI 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18" />एय मारा सोरा तीमुथीयुस, जा वचनान तार बाराम जाणाव पेलुस ईयेल एती, मी ज्यो उकुम होपथु काय तु तान आथ्‍यारान गेत वापेर केरीन हाजाली लेड़ाय लेड़ते रे। <verse eid="1TI 1:18" /><verse number="19" style="v" sid="1TI 1:19" />बोरहाह एने ता हाजा मोनाह होमालीन मेल, काहाकाय ज्याह सेटो केरनेन कारेण कोलाक माणहान बोरहान डोंडह्यो बुड़ गीयोह। <verse eid="1TI 1:19" /><verse number="20" style="v" sid="1TI 1:20" />ता माय रेन हुमीनयुस एने आलेकजांडर न्या हेते, जाह मी सैतानाह होप दियेल हे काय ता हिके काय दिहरान चिहटा केरने बोंद केरी।<verse eid="1TI 1:20" /></para>
  <chapter eid="1TI 1" />
  <chapter number="2" style="c" sid="1TI 2" />
  <para style="s">विन्तान बाबतीम सुचना</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1" />एवी मी आखान पेल ज्यी खास वात केथु काय आखा माणहान केरता विन्ता, एने विन्ता, एने निवेदन एने दन्यवाद केराय जाय। <verse eid="1TI 2:1" /><verse number="2" style="v" sid="1TI 2:2" />खास केरीन राजा एने उचा पोदवालान केरता, काहाकाय आपु हुकेह एने सान्ती माय एने बोगवानाह मान मेलतेन चोखाली जीवाय जीवे। <verse eid="1TI 2:2" /><verse number="3" style="v" sid="1TI 2:3" />ज्यो हाजो हे, काहाकाय आपणो सुटकारो आपणार बोगवानाह स्वीकारनेन लायकीन हे। <verse eid="1TI 2:3" /><verse number="4" style="v" sid="1TI 2:4" />तान ओहली मोरजी हे काय आखा माणहान सुटकारो एय, एने ता खेरायीह हास केरीन जाण लेय। <verse eid="1TI 2:4" /><verse number="5" style="v" sid="1TI 2:5" />काहाकाय एकुच बोगवान हे, बोगवान एने माणहान विचीम एकुच वातार हे मसी यीशु जो माणुह हे। <verse eid="1TI 2:5" /><verse number="6" style="v" sid="1TI 2:6" />जो आखान सुटकारान केरता सोताह किमोत ने रूप माय आप दिनो, एने तान गोवाय ठिक टेम पोर आपानी। <verse eid="1TI 2:6" /><verse number="7" style="v" sid="1TI 2:7" /><note caller="+" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="2TI 1:11">2 तीमुथीयुस 1:11</ref></char></note>मी खेरी केथु, जुठ नाह बुलीत, काय मी ज्यास उद्देश माय पारचार केरनार एने प्रेरित एने बिगेर यहुदिन केरता बोरहान एने खेरायीह हिकाड़नार ठेराय गीयो।<verse eid="1TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8" />मोंडली माय मी होदथु काय माणहे बोगवानाह होपाय एने बिगेर राग केरीन आपणा आथाह उचा केरीन विन्ता केरी। <verse eid="1TI 2:8" /><verse number="9" style="v" sid="1TI 2:9" /><note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="1PE 3:3">1 पतरस 3:3</ref></char></note>मी ज्यो बी होदथु काय बायकु बी त्युन फाड़काह होबाता हेऱ्यो पेरी नाह काय आपणा लेट्याह गुथणे, एने होनो चांदीन गेयणो पेरनेन उगे द्यान नाय देय। <verse eid="1TI 2:9" /><verse number="10" style="v" sid="1TI 2:10" />पुण हाजा कामा केरीन होबाड़े, काहाकाय बोगवानान बोक्ती केरनार्‍यु बायकुन केरता ज्यो हाजो हे। <verse eid="1TI 2:10" /><verse number="11" style="v" sid="1TI 2:11" />बायकुह ठावकी रेन पुरा ताबा माय रेन हिकणे जुवे। <verse eid="1TI 2:11" /><verse number="12" style="v" sid="1TI 2:12" />मी परवांगी नाह आपेत काय बायकु हिकाड़े एने एदम्या पोर आदिकार चालाड़ी, पुण ठावकीच रेय। <verse eid="1TI 2:12" /><verse number="13" style="v" sid="1TI 2:13" />काहाकाय आदम पेल बोणेल हे, तान पासाण हवाह बाणायेल। <verse eid="1TI 2:13" /><verse number="14" style="v" sid="1TI 2:14" />एने आदम फासायेल नाह, पुण बायकु फासानी एने बोगवानान नेमाह तोड़ देनी। <verse eid="1TI 2:14" /><verse number="15" style="v" sid="1TI 2:15" /><note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false">सोराह पायदा केरीन सुटकारो सापड़ावी; नाहते पायदा केरनेन द्‍वारे होमालीन मेलाय जाय।</char></note>तीबी बायकुह सोरा जेणनेन द्‍वारे सुटकारो जुड़ी, केदी ती होबाता हेऱ्यो बुरहो, मोंग, एने चोखाला माय मोजबुत रेय ताहार।<verse eid="1TI 2:15" /></para>
  <chapter eid="1TI 2" />
  <chapter number="3" style="c" sid="1TI 3" />
  <para style="s">मोंडली माय मुखी</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1" />जी वात खेरली हे काय जो कुण मुखी बोणने हुदेह, तो हाजाला कामान आसा किरेह। <verse eid="1TI 3:1" /><verse number="2" style="v" sid="1TI 3:2" /><note caller="+" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="TIT 1:6-9">तीतुस 1:6-9</ref></char></note><note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">फोक्‍तो एकुस बायकु रेय; नाहते फोक्‍तो एकुस वार वाराड़ एय।</char></note>ज्यो जोरवरी हे काय मोंडलीन मुखी निर्दोस रेणे जुवे, एने एकुच बायकुन एदमी, संयमी, सोमेजदार, सम्माननिय, पावणाय केरनार, एने हिकाड़ने माय उशार एणे जुवे। <verse eid="1TI 3:2" /><verse number="3" style="v" sid="1TI 3:3" />तो दारूड्यो एने राड़कुट केरनार नाय रेणे जुवे, पुण गेरबोड़ो रेणे जुवे, एने लेड़ाणार, एने मालदेनान लोबी नाय रेणे जुवे। <verse eid="1TI 3:3" /><verse number="4" style="v" sid="1TI 3:4" />तान गेरान तो हाजी व्यवस्ता केरनार जुवे, एने तान सोराह इहकेरीन ताबाम मिलेह काय ता तान मान मेलती। <verse eid="1TI 3:4" /><verse number="5" style="v" sid="1TI 3:5" />जाह सोतान गेरान हाजी व्यवस्ता केरनेन नाह ओवड़ेत, ते बोगवानान मोंडलीह किहीक होमाली। <verse eid="1TI 3:5" /><verse number="6" style="v" sid="1TI 3:6" />तो बोरहा माय मोजबुत रेणे जुवे, ओहलो नाय एय काय गोमेंड माय आवीन सैतानान गेत डेंड ने बागी एय जाय। <verse eid="1TI 3:6" /><verse number="7" style="v" sid="1TI 3:7" />मोंडलीन बाहेर ने माणहाम बी तान हाजी गोवाय रेय, ओहलो नाय एय काय बदनाम एन सैतानान फासा माय फोस जाय।<verse eid="1TI 3:7" /></para>
  <para style="s">मोंडली माय मोदेक केरनार</para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8" />तिहेस केरीन पावोर बी हाजा सोबावान रेणे जुवे, दुय मुंड्यो एने दारूड्यो, एने ठेगीन पोयशा कामावणार नाय रेणे जुवे। <verse eid="1TI 3:8" /><verse number="9" style="v" sid="1TI 3:9" />पुण बोरहान खेरलो चोखो मोनाह होमालीन मेली। <verse eid="1TI 3:9" /><verse number="10" style="v" sid="1TI 3:10" />एने ज्या बी पेल पारखाय जाणे जुवे, केदी निर्दोस निकली ते पावोरान ने काम केरी। <verse eid="1TI 3:10" /><verse number="11" style="v" sid="1TI 3:11" /><note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="ft" closed="false">तान बायकु; नाहते मोदेक केरनार्‍यु बायकु। </char></note>तिहेस केरीन बायकु बी हास केरीन रेणे जुवे, आरोप लागाड़नार नाय जुवे, पुण हाजा सोबाव वाली एने आखी वातु माय विश्वासयोग्य रेय। <verse eid="1TI 3:11" /><verse number="12" style="v" sid="1TI 3:12" /><note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">फोक्‍तो एकुस बायकु रेय; नाहते फोक्‍तो एकुस वार वाराड़ एय। </char></note>मोंडलीन मोदेक केरनारान एकुस लाडी रेणे जुवे, एने तान सोराह एने गेरबार हास केरीन चालाड़णार जुवे। <verse eid="1TI 3:12" /><verse number="13" style="v" sid="1TI 3:13" />काहाकाय जा पावोरान काम हास केरीन केर सेकतेह, ता तान केरता हाजो पोद एने ता पोर जो मसी यीशु पोर बुरहो हे, पाका बोणती जाय।<verse eid="1TI 3:13" /></para>
  <para style="s">मोटलो मालमात</para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14" />मी ज्यी चिट्ठी लेखथु काय माहु तार फाय उतवाल्योह आवणेन आसा हे। <verse eid="1TI 3:14" /><verse number="15" style="v" sid="1TI 3:15" />केदी माहु हे आवणे माय वार एय जाय, ते तु ज्यी चिट्ठीन द्‍वारे जाणहे काय बोगवानान गेराणा माय जी जीवताला बोगवानान मोंडली हे, एने जो खेरायीन खाम्बो एने पायो हे, तारो वेवारो माणहा हेऱ्यो किहीक रेणे जुवे। <verse eid="1TI 3:15" /><verse number="16" style="v" sid="1TI 3:16" />ज्या माय संका नाह सोतो काय बोक्‍तीन मालमात ते मोठो हे;</para>
  <para style="q1" vid="1TI 3:16">तो सेरीर माय एन आवो,</para>
  <para style="q2" vid="1TI 3:16">चोखाला जीवा माय देरमी ठेरानो,<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="ft" closed="false">जीव खेरलो ठेरायेल; नाहते आत्मिक रूप माय खीरलो ठिरेल।</char></note></para>
  <para style="q1" vid="1TI 3:16">हेरोगदुताह देखानो,</para>
  <para style="q2" vid="1TI 3:16">एने दिहरा देसा माय तान पारचार एनो,</para>
  <para style="q1" vid="1TI 3:16">दुनिया माय ता पोर बुरहो केराय गीयो,</para>
  <para style="q2" vid="1TI 3:16">एने बोड़ाय माय हेरगाम उखलाय गीयो।<verse eid="1TI 3:16" /></para>
  <chapter eid="1TI 3" />
  <chapter number="4" style="c" sid="1TI 4" />
  <para style="s">जुठा मास्तेर्‍या</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1" />चोखालो जीव साप साप किथे काय ओंगाणल्या काला माय बोटकाड़नार खाराब जीवान हिकवोण पोर मोन लागाड़ीन थोड़ाक माणहे बोरहाम रेन बोटेक जाती। <verse eid="1TI 4:1" /><verse number="2" style="v" sid="1TI 4:2" />ज्यो ता जुठा माणहान कोपेट ने कारेण एय, जान मोन मोर जायेल हे जीहे काय हेलेगताला लोखंडा केरीन डाग दियेल ने गीत हे। <verse eid="1TI 4:2" /><verse number="3" style="v" sid="1TI 4:3" />ता वाराड़ मा किरो इहकेरीन हिकाड़ते एने खाणान थोड्युक वोस्तु हेऱ्यो रेन सेटा रेणेन हिकवोण आपती, ताह बोगवान ज्यानकेरता बाणायेल काय बुरहो केरनारे एने खेरायीह ओलेखणारे ताह दन्यवाद केरीन खाती। <verse eid="1TI 4:3" /><verse number="4" style="v" sid="1TI 4:4" />काहाकाय बोगवानान द्‍वारा बाणायेल आखी चिज हाजी हे, एने काल्ली बी चिज नाकार केरनेन केरता बाणायेल नाह सोत्यु। <verse eid="1TI 4:4" /><verse number="5" style="v" sid="1TI 4:5" />काहाकाय बोगवानान वचन एने विन्ता केरीन बोगवानाह समर्पित एय जाथे।<verse eid="1TI 4:5" /></para>
  <para style="s">मसी यीशुन हाजालो सेवक</para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6" />केदी तु बायह्याह ज्यी वातु एर केराव रिहे, ताहार मसी यीशुन हाजालो सेवक ठेराहे; एने बोरहान वातु एने ती खेरली हिकवोणाह जीह तु मानतेन आयेल हे, तारो पोहणो ईती रेय। <verse eid="1TI 4:6" /><verse number="7" style="v" sid="1TI 4:7" />पुण बोगवानाह नाह जाणते त्यु डोकर्‍युन वार्ताह रेन सेटा रिवो; एने बोक्‍तीन मेहनेत केर। <verse eid="1TI 4:7" /><verse number="8" style="v" sid="1TI 4:8" />काहाकाय सेरीरान मेहनेत कोम फायदान हे, पुण बोक्ती केरने आखी वातुन केरता फायदो हे, काहाकाय ताह एवीन एने आवता जीवणान बाराम वायदो जुड़ेल हे। <verse eid="1TI 4:8" /><verse number="9" style="v" sid="1TI 4:9" />ज्यी वात खेरीच एने आखी बातीन पुरो मान्नेन एने बुरहो केरनेन बाराबोर हे। <verse eid="1TI 4:9" /><verse number="10" style="v" sid="1TI 4:10" /><note caller="+" style="f"><char style="fr" closed="false">4:10 </char><char style="ft" closed="false">मेहनेत किरेल; थोड़ाक लेख माय चिहटा सेहेन किरेल लिखेल हे।</char></note>काहाकाय आमु मेहनेत एने कोसीत ज्यास ने केरता केरतेह काय आमरी आसा ता जीवताला बोगवाना पोर हे, जो आखा माणहाह एने खास केरीन बुरहो केरनारान केरता सुटकारो आपणार हे।<verse eid="1TI 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11" />ज्‍यु वातुन उकुम आप एने हिकाड़ते रे। <verse eid="1TI 4:11" /><verse number="12" style="v" sid="1TI 4:12" />कुण बी तारी जुवानीह खाराब जाणने नाय जुवे; पुण तु वचना माय, एने व्यवहारा माय, एने मोंग माय, एने बोरहा माय एने चोखाला माय आखा बुरहो केरनारान केरता एक हाजो हिक बोण जा। <verse eid="1TI 4:12" /><verse number="13" style="v" sid="1TI 4:13" />जाह वोर मी नाय आवो, ताह वोर चोखाली पुस्तेक वाचीन होमलाड़नेन, एने पारचार किरते एने हिकाड़ने माय खुस रे। <verse eid="1TI 4:13" /><verse number="14" style="v" sid="1TI 4:14" />तुवा पोर डावाला माणहे आथ मेलनेन बुखेत जाणकारान द्‍वारा जो वरदान तुवाह आपायेल हे, दिहरी उगे द्यान मा लागाड़े। <verse eid="1TI 4:14" /><verse number="15" style="v" sid="1TI 4:15" />ज्यी वातुह सोचते रे एने ज्यास माय तारो द्यान लागाड़ मेल, काहाकाय तार वोड़ती आखा देखाय। <verse eid="1TI 4:15" /><verse number="16" style="v" sid="1TI 4:16" />तार उगे एने तारा हिकाड़नेन उगे हास केरीन द्यान मेल, ज्यी वातु पोर मोजबुत रे; काहाकाय केदी तु ओहलो केरती रिहे ताहार तारो एने तार होमेलनारान केरता सुटकारान कारेण बोणहे।<verse eid="1TI 4:16" /></para>
  <chapter eid="1TI 4" />
  <chapter number="5" style="c" sid="1TI 5" />
  <para style="s">मोंडलीन प्रती जापापदार</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1" />काल्ला बी डावाला माणहाह दोपकावीन मा बुलहो, पुण ताह आबोख जाणीन सोमजाड़ दे, एने जुवान्याह बाहख सोमजीन ता हिऱ्यो वेवार केर। <verse eid="1TI 5:1" /><verse number="2" style="v" sid="1TI 5:2" />डावाली बायकुह आहख जाणीन; एने जुवान बायकुह पुरो चोखो मोन केरीन बोणीख जाणीन सोमजाड़ दे।<verse eid="1TI 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3" />त्यु रांडायेल बायकुन मान मेल, ज्‍यु खेरीच रांडायेल हेत्यु। <verse eid="1TI 5:3" /><verse number="4" style="v" sid="1TI 5:4" />केदी एगदी रांडायेल बायकुन सोरा निहते नाते पोणत्या एती, ते आखान पेल ता तान गेराणा हेऱ्या बोक्‍तीन वेवारो केरती, एने तान आईख आबाख हुक आपणेन हिके, काहाकाय ज्यो बोगवानाह पुटीह। <verse eid="1TI 5:4" /><verse number="5" style="v" sid="1TI 5:5" />ज्यी खेरीच रांडायेल हे एने तीन कुणूस नाह सोतो, ती आपणी आसा बोगवाना पोर मेल मिलेह, एने ती रात ने दिह विन्ता एने विन्ता किरते रीथे। <verse eid="1TI 5:5" /><verse number="6" style="v" sid="1TI 5:6" />पुण ज्यी सेरीरान मोरजी पुरी केरने माय पोड़ गियीह, ती जीवताली ते हे पुण मुरेल बाराबोर हे। <verse eid="1TI 5:6" /><verse number="7" style="v" sid="1TI 5:7" />ज्यी वातुन बी उकुम आप काहाकाय ती निर्दोस रेय। <verse eid="1TI 5:7" /><verse number="8" style="v" sid="1TI 5:8" />एने खास केरीन तान गेराणान माणहान कालजी नाह किरेत, ताहार तो बोरहाम रेन बोटकी जायेल हे, एने अविश्वासी माणहाह रेन बी होवटोह खाराब बोण जायेल हे।<verse eid="1TI 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9" />तीस रांडायेल बायकुन नाव लिखजे जी साठ वोरह्याह रेन कोम निहे एय, एने एकुच एदम्यान लाडी रेनी एय।<note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="ft" closed="false">एक वारीन वाराड़ किरेल; नाहते तीन एदम्या हेऱ्यी ईमानदार।</char></note> <verse eid="1TI 5:9" /><verse number="10" style="v" sid="1TI 5:10" />एने हाजाला कामान केरता नाव गाजेल एय, एने जी सोरान पोहणो केरेय; पावणाय केरेय, चोखाला माणहान पाय दुयेल एय, एने दुखाऱ्या माणहान सेवा चाकरी किरेल एय, एने आखा हाजा कामा माय मोन लागाड़ेल एय। <verse eid="1TI 5:10" /><verse number="11" style="v" sid="1TI 5:11" />पुण जुवान रांडायेल बायकुन नाव मा लिखहे, काहाकाय ती पोशी वाराड़ केरने हुदेह एने सेरीरान मोरजी पुरी केरनेन केरता मसी रेन सेटी एय जाथे। <verse eid="1TI 5:11" /><verse number="12" style="v" sid="1TI 5:12" />एने गुनेगार ठेराथी, काहाकाय त्यु वायदो तोड़ देन्युह। <verse eid="1TI 5:12" /><verse number="13" style="v" sid="1TI 5:13" />ओवती ती गेर गेर फिरीन आलही एणेन हिकेह, एने आलही एणेन ओलीस नाह पुण बकबक केरती रीथे, एने दिहरान कामाम आथ टाकेह एने होबाय नाय ओहल्यु वातु किरेह। <verse eid="1TI 5:13" /><verse number="14" style="v" sid="1TI 5:14" />तान केरता मी ज्यो होद्थु काय जुवान रांडायेल बायकु वाराड़ केरी, एने गेरबार होमाली एने सोराह पायदा केरी, एने विरोद केरनाराह बदनाम केरने टेम नाय आपी। <verse eid="1TI 5:14" /><verse number="15" style="v" sid="1TI 5:15" />काहाकाय मोकत्युस बोटकीन सैतानान पासाण चाल दियेल हेत्यु। <verse eid="1TI 5:15" /><verse number="16" style="v" sid="1TI 5:16" />केदी बुरहो केरनार्‍यु बायकुन गेर रांडायेल बायकु एय ताहार, तीन मोदेक तीच केरी एने मोंडली पोर वोजो नाय बोणी, काहाकाय जी खेरीच रांडायेल हे तीन मोदेक मोंडली केर सेकी।<verse eid="1TI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17" />जा डायडाया तान आदिकार हास केरीन चालाड़तेह, ताह दुय गुणा मोंजरी जुड़ने जुवे, एने खास केरीन ता जा वचन होमलाड़ ने एने हिकाड़नेन मेहनेत केरतेह। <verse eid="1TI 5:17" /><verse number="18" style="v" sid="1TI 5:18" /><note caller="+" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="MAT 10:10">मत्ती 10:10</ref>; <ref loc="LUK 10:7">लुका 10:7</ref></char></note>काहाकाय चोखाली पुस्तेक किथे, “वेगेलताला बोयलान मुयाह मोहको मा बांदही,” काहाकाय “मोंजऱ्यो तान मोंजरीन हकदार हे।” <verse eid="1TI 5:18" /><verse number="19" style="v" sid="1TI 5:19" />दुय नाहते तीन गोवा रेती, तेवीच काल्ला बी डायडाया पोर गुनो लागाड़जे। <verse eid="1TI 5:19" /><verse number="20" style="v" sid="1TI 5:20" />एने पाप केरनाराह आखा माणहान ओंगाण सोमजाड़ दे, काहाकाय दिहरा माणहे बिते एने पाप नाय केरती। <verse eid="1TI 5:20" /><verse number="21" style="v" sid="1TI 5:21" />बोगवान, मसी यीशु एने निवाड़ेल हेरोगदुताह आहने जाणीन मी तुवाह चेतावणी आपीन केथु काय तु मोन खोलीन ज्यी वातुह मान्या केर, एने बेदबाव माय काल्लो बी काम मा किरहे। <verse eid="1TI 5:21" /><verse number="22" style="v" sid="1TI 5:22" />उतवाल्यो एन कुणी पोर बी आथ मा मिलहे, एने दिहरान पापाम बागी मा इही; आपणे आपाह चोखो बोणावीन मेल।<verse eid="1TI 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23" />एवी रेन ओंगाण पाणी ओलोस पिय मा, पुण पेटान केरता एने जाहार ताहार एण्या दुखान केरता थोड़ोक अंगुरान रूह बी पिया केर।<verse eid="1TI 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24" />थोड़ाक माणहान पापे ते उगड़ीन नियाव ने केरता पेलुच पोच जातेह, पुण थोड़ाक पासाण रेन जातेह। <verse eid="1TI 5:24" /><verse number="25" style="v" sid="1TI 5:25" />तिहेस केरीन थोड़ाक हाजाला कामे उगाड़ला हेते, एने जा ओहला ना सोता, ता बी लीकाय नाह सेकते।<verse eid="1TI 5:25" /></para>
  <chapter eid="1TI 5" />
  <chapter number="6" style="c" sid="1TI 6" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1" />जोला बी माणहे पावोर ने जुवाला माय जोपाय रियेल हेते, ता तान मालक्याह आखी बातीन मान मेलनेन बाराबोर जाणे, काहाकाय बोगवानान नाव एने हिकवोणान चिहटा नाय एणे जुवे। <verse eid="1TI 6:1" /><verse number="2" style="v" sid="1TI 6:2" />एने जान मालीक बुरहो केरनार हे ताह ता बाहख हे केरीन तान ईजुत उड़ावणे नाय जुवे, पुण तान होवटीह सेवा चाकरी केरी, काहाकाय जा तान फायदो उखेलतेह ता बुरहो केरनारे एने मोंगाल्ला माणहे हेते, ज्यी वातुह हिकाड़ते एने सोमजाड़ते रे।<verse eid="1TI 6:2" /></para>
  <para style="s">जुठी हिकवोण एने मालदेनान लोब</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 6:3" />केदी एगदो दिहरी बातीन हिकवोण आपी, एने आपणा मालीक यीशु मसीन खेरली वातुह एने जो हाजाली बोगवानान हिकवोणान गेत, <verse eid="1TI 6:3" /><verse number="4" style="v" sid="1TI 6:4" />ताहार तो गोमेंड केरनार बोण जायेल हे, ताह खेरली बोक्‍तीन बाराम कायच बी नाह मालुम सोतो एने तो सोबदा पोर बोलाचाल केरनार कुयराय, राड़ चिहटा एने गेलेत सेंका केरनार बोण जायेल हे। <verse eid="1TI 6:4" /><verse number="5" style="v" sid="1TI 6:5" />एने ता माणहा माय फालतुक राड़ एत्युह, तान बुद्दी बिगेड़ जायेल हे, एने ता खेरायीह रेन सेटा एय गीयाह, जा सोमेजतेह काय बोक्ती कामाईन वाट हे। <verse eid="1TI 6:5" /><verse number="6" style="v" sid="1TI 6:6" />पुण खुसी माय बोक्ती केरने माय ने आखाम रेन मोटली कामाय हे। <verse eid="1TI 6:6" /><verse number="7" style="v" sid="1TI 6:7" />काहाकाय आपु नाह दुनिया माय काह लावाला, एने नाह काय ली जाय सेकतेह। <verse eid="1TI 6:7" /><verse number="8" style="v" sid="1TI 6:8" />केदी आपणी फाय खाणेन केरता रूटो एने पेरनेन केरता फाड़का एय, ते ज्यास पोर खुस रेणे जुवे। <verse eid="1TI 6:8" /><verse number="9" style="v" sid="1TI 6:9" />पुण जा देनी बोणनेन आसा केरतेह, ता पारेख माय, एने फासा माय एने मोकत्युस फालतुक नुकसान एय ओहली लालुस माय फोस जातेह, जो माणहाह बिगाड़ दिथे एने नासान देरीयाम बुड़ाव दिथे। <verse eid="1TI 6:9" /><verse number="10" style="v" sid="1TI 6:10" />काहाकाय पोयशान लोब ते आखी बातीन बुरायीन मुल हे, तान पासाण लागणारे कोलाक बुरहो केरनारे माणहे बोरहाम रेन बोटेक जायेल हेते, एने आखी बातीन बेमारी माय फोस रेनाह।<verse eid="1TI 6:10" /></para>
  <para style="s">तीमुथीयुसाह व्यक्तिगत निर्देश</para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11" />पुण एय बोगवानान बोकत्या तु ज्‍यु वातु से नाह, एने देरेम, बोक्ती, बुरहो, मोंग, दिर, एने गेरबोड़ायीन पासाण लाग। <verse eid="1TI 6:11" /><verse number="12" style="v" sid="1TI 6:12" />बोरहान एक हाजी दोवेड़; एने ता जेलेमक्या जीवणाह दिरले, जान केरता तुवाह बोगवान हादेल एतो एने मोकतास गोवान सामने हास केरीन मानेल ईतो। <verse eid="1TI 6:12" /><verse number="13" style="v" sid="1TI 6:13" /><note caller="+" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="JHN 18:37">योहान 18:37</ref></char></note>मी आखाह जीवाय आपणारा बोगवानाह एने मसी यीशुह आहने जाणीन, जो पुन्तियुस पिलातुसान ओंगाण हास केरीन मानेल ईतो, ज्यो उकुम आपथु। <verse eid="1TI 6:13" /><verse number="14" style="v" sid="1TI 6:14" />काय आपणो मसी यीशुन पोशो आवणे वोर ज्या उकुमाह निष्कलंक एने निर्दोस मेल। <verse eid="1TI 6:14" /><verse number="15" style="v" sid="1TI 6:15" />बोगवान ताह ठिख टेम पोर देखाड़ी, जो बोरकेतवालो एने एकुच आदिकारी एने राजान राजा एने मालीकान मालीक हे, <verse eid="1TI 6:15" /><verse number="16" style="v" sid="1TI 6:16" />एने जेलेमक्यो तास ने हे, एने जेलेमक्या उजाला माय रीथे, एने ताह नाह माणुह देख्यो एने नाय केदी देख सेकी। तास ने मान एने राज जेलेमक्यो रेय। आमेन।<verse eid="1TI 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17" />ज्या दुनियान देनी माणहाह उकुम आप काय गोमेंडी नाय बोणी एने चंचल देना पोर आसा नाय मेली, पुण बोगवाना पोर आसा मेली, जो आमरे हुकान केरता आखो मोकतोस आपेह। <verse eid="1TI 6:17" /><verse number="18" style="v" sid="1TI 6:18" />ताह उकुम आप काय हाजा काम केरी, एने बोलायीन कामा माय देनी बोणी, एने उसन्यो आपणे, एने दिहरा माणहान मोदेक केरनेम कायेम तियार रेय। <verse eid="1TI 6:18" /><verse number="19" style="v" sid="1TI 6:19" />एने ओंगाण ने केरता एक हाजो पायो बांद मेली काय खेरला जीवणाह काबाम केर लेय।<verse eid="1TI 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20" />एय तीमुथीयुस, ज्यी हिकवोण मी तुवाह आपेल तान राखवाली केर; जाह थोड़ाक माणहे इकेल केतेह, तान खाराब बोलाचाल एने विरोद केरनारी वातुह रेन सिटो रे। <verse eid="1TI 6:20" /><verse number="21" style="v" sid="1TI 6:21" />थोड़ाक माणहे पाको किरेल हेते काय ज्यी इकेल हे, तीबी ता बोरहाम रेन बोटकी जायेल हेते।</para>
  <para style="q1" vid="1TI 6:21">तुमू पोर बोगवानान गीण एती रेय।<verse eid="1TI 6:21" /></para>
  <chapter eid="1TI 6" />
</usx>