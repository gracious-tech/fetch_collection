<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JOS" style="id">यहोशु - Nahali</book>
  <para style="h">यहोशु</para>
  <para style="toc3">यहोशु</para>
  <para style="toc2">यहोशु</para>
  <para style="toc1">यहोशु</para>
  <para style="mt2">यहोशु कि किताब</para>
  <para style="mt1">यहोशुन पुस्तेक</para>
  <para style="imt">ओलखात</para>
  <para style="ip">यहोशुन पुस्तेक इस्राएल राज ने काणीह ओंगाण वोड़ावेह जाहरी नेम निवरी जाथे। इस्राएल ने माणहे यरदन नेदीन पुर्व उगे मेराम रेन सुरू ईथे। यहोशुन पुस्तेक किथे काय किहीक ता यरदन नेदीह पार केऱ्या एने मुसान आदिकार माय, यहोशुन आगवाय माय कनान देसा पोर जिक हासील केऱ्या। ता ओहलो ज्यान केरता केऱ्या काहाकाय बोगवान ताह उकुम आपेल इतो इह केरीन बोगवान अब्राहाम ने वोसीन कनान देस आपणेन तान वायदो पुरो केरने बाजरियेल इतो उत्पत्ती <char style="xt"><ref loc="JOS 12:7">12:7</ref></char>।</para>
  <para style="ip">ज्य मालुम नाह सोतो काय यहोशुन पुस्तेक कुण लिखेल एने कुण बाणायेल हे। जुलूम वार लेखणार इह केरीन किथे, जीहे काय तो ती गेटनान विच माय उबरियेल इतो, जो एणे बाजरियेल एतो। उदारण ने केरता यहोशु <char style="xt"><ref loc="JOS 5:1-6">5:1-6</ref></char>। ज्यान केरता मोकतास बुध्दीमान माणहान मान्नो हे काय यहोशु पुस्तेक ने जास्ती बाग खुद लिखेल हे। पुण ज्य साप हे काय यहोशुन बिगेर एगदो दिहरो थोड़ोक बाग लिखेल हे, जीह केरीन काय यहोशुन वोगे लागाड़नेन वर्णन यहोशु <char style="xt"><ref loc="JOS 24:29">24:29</ref></char>। दिहरा बुध्दीमान माणहान मान्नो हे काय गेटनाह गेटणेन कोमीत कोमी 800 वोरह्या बाद लेखायेल एती। यहोशुन पुस्तेक माय गेटना एणेन 1250 यीशुन पेल आहने पाहने इयेल एती, जो मिस्र माय रामसेस ने राज ने 40 वोरह्यान बाद ने रेनी एय। रामसेस तो राजा हे जान बाराम मानाय जाथे काय तो मिस्र रेन इस्राएल माणहान जाणेन टेम माय राज किरेल इतो। निर्गमन <char style="xt"><ref loc="JOS 1:11">1:11</ref></char>।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. किहीक इस्राएली यरदन नेदी पार केरीन कनान देसा माय रिगना। <char style="ior"><ref loc="JOS 1:1">1:1</ref>; <ref loc="JOS 5:12">5:12</ref></char></para>
  <para style="io">2. इस्राएल द्वारा कनान देसा पोर जिकीन बाराम कियेल हे। <char style="ior"><ref loc="JOS 5:13">5:13</ref>; <ref loc="JOS 12:1-24">12:1-24</ref></char></para>
  <para style="io1">3. कनान देसाह इस्राएल ने गेराणा माय किहीक वाटाय गीयो। <char style="ior"><ref loc="JOS 13:1-33">13:1-33</ref>; <ref loc="JOS 21:1-45">21:1-45</ref></char></para>
  <para style="io1">4. थोड्युक दिहऱ्यु जातीन माणहे यरदन नेदीन पुर्व उगेन मेराम वोलीन आव लागा, यहोशुन वोलावणो, एने वोगे लागाड़नो, एने किहीक बोगवाना हेऱ्यो इस्राएल ने वाचान नोवाय एनो। <char style="ior"><ref loc="JOS 22:1-34">22:1-34</ref>; <ref loc="JOS 24:1-33">24:1-33</ref></char></para>
  <chapter number="1" style="c" sid="JOS 1" />
  <para style="s">बोगवान यहोशुह उकुम</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 1:1" />बोगवानान पावोर मुसान मोतीन पासाण बोगवान तान सेवक यहोशुह जो नुन ने बिटोख इतो केयो, <verse eid="JOS 1:1" /><verse number="2" style="v" sid="JOS 1:2" />“मारो पावोर मुसो मोर जायेल हे; केरीन एवी तु उठ एने ज्या आखा माणहा हिऱ्यो तु ज्यी यरदन नेदीह पार केरीन ता देसाम जा जाह मी ताह मतलब इस्राएल ने माणहाह आपथु। <verse eid="JOS 1:2" /><verse number="3" style="v" sid="JOS 1:3" /><note caller="+" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="DEU 11:24-25">व्यवस्था 11:24-25</ref></char></note> जीह केरीन मी मुसाह कियेल इतो, जा जा जागा पोर तुमू पाय मिलहो, तो तुमूह आप दियेल हे। <verse eid="JOS 1:3" /><verse number="4" style="v" sid="JOS 1:4" />जिंगोल एने ता लबानोन रेन फरात मोठली नेदी वोर, एने दिह बुड़तान उगे मोटला देरिया वोर हित्ती जातीन माणहान आखो देस तुमरो ईसो ठेराय। <verse eid="JOS 1:4" /><verse number="5" style="v" sid="JOS 1:5" /><note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="EXO 3:12">निर्गमन 3:12</ref>; <ref loc="DEU 32:6-8">व्यवस्था 32:6-8</ref>; <ref loc="HEB 13:5">इब्रानियो 13:5</ref></char></note> तारी जीवाय बोर तुमूह कुण बी माणुह रोकणे माय ताकेतवोर नाय रेय; जीहे मी मुसान आरही रिनो तिहेच केरीन तार आरही बी रेह; एने नाह ते मी तुवाह दुको देह, एने नाय तुवाह सोडुह। <verse eid="JOS 1:5" /><verse number="6" style="v" sid="JOS 1:6" /><note caller="+" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="DEU 32:6">व्यवस्था 32:6</ref>; <ref loc="DEU 7:23">7:23</ref></char></note> केरीन ईमोत बांद एने मोजबुत बोण, काहाकाय ज्या माणहाह तुस ता देसा पोर आदिकार आपाड़हे जाह न्याह आपणेन सुगोण मी न्यान डायडाया हिऱ्यो खायेल इतो। <verse eid="JOS 1:6" /><verse number="7" style="v" sid="JOS 1:7" />निस्तो तु मोजबुत बोण एने जुलूम ईमोत बांद, एने मारो सेवक मुसो तुवाह आपेल नेमान गेत आखो पालेन केर; तो सोड़ीन जीवड़े डाखरे उगे वोलहे मा, एने जाहरी जाहरी तु जाहे ताहरी तारो काम पुरो एय। <verse eid="JOS 1:7" /><verse number="8" style="v" sid="JOS 1:8" />ता नेमान पुस्तेक माय लेखायेल वातुह कायेम एर मीलो, तुमू ता पुस्तेकान रात ने दिह द्यान किरो; तेवीस तुमू ताम लेखायेल नेमान पालनेन बाराम बोरहावाला रेय सेकतेह, केदी तुमू ज्‍य किरहो, ते तुमू इकेलदार बोणहो एने जो काय किरहो ताम पुरा ईहो। <verse eid="JOS 1:8" /><verse number="9" style="v" sid="JOS 1:9" />एर मेल, काय मी तुवाह ईमोत बांदिन मोजबुत बोणीन रेणेन उकुम आपेल हे, केरीन केदी बिहे मा; काहाकाय तुमरो बोगवान यहोवा तुमरी हिऱ्यो जाहरी तुमू जाहो आखी जागे रेय।”<verse eid="JOS 1:9" /></para>
  <para style="s">यहोशु डायलाह उकुम आपणे</para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 1:10" />उवतो यहोशु माणहान मुखीह ज्‍यो उकुम आप्यो, <verse eid="JOS 1:10" /><verse number="11" style="v" sid="JOS 1:11" />पाड़ावा माय जाएन माणहाह ज्‍यो उकुम आपो, “काय आप आपणे केरता खाणो तियार केर मीलो; काहाकाय तीन दिह्या माय तुमूह ज्यी यरदन नेदीह पार उतरीन ता देसाह आपणे आदिकार माय लेणेन केरता जाणो हे जाह तुमरो बोगवान यहोवा तुमरे आदिकार माय आपण्‍यो हे।” <verse eid="JOS 1:11" /><verse number="12" style="v" sid="JOS 1:12" /><note caller="+" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="NUM 32:28-32">गिनती 32:28-32</ref>; <ref loc="DEU 3:18-20">व्यवस्था 3:18-20</ref></char></note> ओवतो यहोशु रूबेन ने वोस ने गादी एने मनश्शेन वोस ने थोड़ाक माणहाह केयो, <verse eid="JOS 1:12" /><verse number="13" style="v" sid="JOS 1:13" />बोगवानान सेवक मुसो तुमूह जी वातीन उकुम आपेल इतो ताह एर किरो, तो तुमूह कियेल इतो काय, तुमूह आराम जुड़ी केरीन तुमरो बोगवान ज्‍यो देस तुमूह आपण्‍यो हे। <verse eid="JOS 1:13" /><verse number="14" style="v" sid="JOS 1:14" />तुमरी बायकु, सोरा, एने पालन्या जेनवारे ते ज्या देसाम रेती जो मुसो यरदन नेदीन दिह उगता आपेल हे, पुण तुमू जा शुरवीर हेते तियार एन तुमरा बायह्याख ने ओंगाण ओंगाण नेदीन ती पार उतेर जावो, एने तान मुदेक किरो। <verse eid="JOS 1:14" /><verse number="15" style="v" sid="JOS 1:15" />बोगवान तुमूह आराम केरनेन जागो आपेल हे, एने तो तुमरा बायह्याख ने केरता बी तिहेच केरीन केरी, पुण तुमूह तुमरा बायह्याख ने मोदेक ताह वोर केरने जुवे, जाह वोर ता ता देसाह नाह लेय लेते जाह बोगवान यहोवा ताह आपणे बाजरिनोह। तेवी तुमू यरदन नेदीन दिह उगता तुमरा देसाम वोल सेकतेह तोस तो देस हे जाह यहोवान सेवक मुसो तुमूह आपेल हे। <verse eid="JOS 1:15" /><verse number="16" style="v" sid="JOS 1:16" />तेवी माणहे यहोशुह जापाप आप्या, “जो काय केरनेन तु आमुह उकुम आपेल हे तो आखो आमु केरहु, एने जा का तु आमुह मुकेलहे ताहरी आमु जाहु। <verse eid="JOS 1:16" /><verse number="17" style="v" sid="JOS 1:17" />जीहे आमु आखी वातु माय मुसान मानताला तिहेच केरीन तारे बी मान्या केरहु; फोक्‍तो तारो बोगवान यहोवा जीहे मुसान आरही रेतालो तिहेच केरीन तार हिऱ्यो बी रेय। <verse eid="JOS 1:17" /><verse number="18" style="v" sid="JOS 1:18" />केदी इखेह माणुह तारो उकुम नाह मानेत नाहते एखेह माणुह तार विरूद उब रिथे, तो माराय जाय। पुण तु ईमोत बांद एने मोजबुत बोण।”<verse eid="JOS 1:18" /></para>
  <chapter eid="JOS 1" />
  <chapter number="2" style="c" sid="JOS 2" />
  <para style="s">यरीहो गावाम मालमात केरने मोकेलने</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 2:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:1 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 11:31">इब्रानियो 11:31</ref>
      </char>
    </note>तेवी नुन ने बिटोख यहोशु थोड़ाक इस्राएली एदम्याह पोतो लागाड़नेन केरता शित्‍तीम रेन चोराये ज्‍य केन मुकल्यो, “जावो, एने ता देसाह, खास केरीन यरीहोह हाच केरीन दिखो।” केरीन ता गीया एने राहाब नावान वेश्‍यान गेर पोचीन तास रोकाना। <verse eid="JOS 2:1" /><verse number="2" style="v" sid="JOS 2:2" />तेवी एखेह यरीहोन राजाह खुबेर केऱ्यो काय थोड़ाक इस्राएली माणहे, देसान जाणकारी काड़नेन केरता आज राती न्या आव रेनाह। <verse eid="JOS 2:2" /><verse number="3" style="v" sid="JOS 2:3" />तेवी यरीहोन राजा राहाबाह खोबेर केन मोकल्‍यो काय, “जा एदमी तार फाय आवीन तारा गेराम थोब रेनाह ताह बाहेर लेन आव, काहाकाय ता आखा देसान जाणकारी काड़नेन केरता आयेल हेते!”<verse eid="JOS 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOS 2:4" />ती बायकु ता दुय एदम्याह लिकाड़ मेली एने केयी, “मार फाय जुलूम एदमी आयेल ते एता, पुण माहु नाह मालुम काय ता कावाला एता; <verse eid="JOS 2:4" /><verse number="5" style="v" sid="JOS 2:5" />एने जेवी आंदारो एनो, एने गावान बायणा बोंद एणेन बुखेत ता माणहे जात रेना; माहु नाह मालुम काय ता का गीया, पुण केदी तुमू उतवाल्‍याह जाहो, ताहार ताह देर लिहो।” <verse eid="JOS 2:5" /><verse number="6" style="v" sid="JOS 2:6" />राहाब ताह गेरान साजा पोर चेड़ावीन होण माय ताह लिकाड़ दियेल एती, जान डिग ती साजा पोर हिसाड़ेन मेल रियेल एती। <verse eid="JOS 2:6" /><verse number="7" style="v" sid="JOS 2:7" />तानकेरता ता एदम्यान होदवाल्‍या राजान माणहे जात रेना, राजान माणहे गावाम रेन निकेलनेन बाद गावान बायणा बोंद केराय गीया; ता एदमी ता जागा पोर गीया जा रेन माणहे यरदन नेदीह पार केरताला।<verse eid="JOS 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 2:8" />एने दुयू एदमी राती हुवणेन तियारी माय एता, पुण राहाब साजा पोर गियी; <verse eid="JOS 2:8" /><verse number="9" style="v" sid="JOS 2:9" />एने ताह केयी, “माहु मालुम हे काय ज्‍यो देस बोगवान तुमरा माणहाह आपेल हे, तुमू आमुह बिवाड़तेह, ज्या देसाम रेणारे आखा माणहे तुमूह बितेह। <verse eid="JOS 2:9" /><verse number="10" style="v" sid="JOS 2:10" /><note caller="+" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="EXO 14:21">निर्गमन 14:21</ref>; <ref loc="NUM 21:21-35">गिनती 21:21-35</ref></char></note> काहाकाय आमु होमलेल हेते काय जेवी तुमू मिस्र देसाम रेन बाहेर निकलीन आवणेन बुखेत, बोगवान तुमरे सामने रातला देरीयान पाणी आटाड़ दिनो। एने तुमू सीहोन एने ओग नावान यरदन नेदीन दिह उगता रेणारे एमोरीन दुयू राजाह किहीक खेतेम केऱ्या। <verse eid="JOS 2:10" /><verse number="11" style="v" sid="JOS 2:11" />एने त्यु गेटनाह होमेलतास आमु जुलूम बिय गीयाह, एने एवी आमरे माय रेन काल्लो माणुह ओलो ईमोतवालो नाह काय तुमरी हिऱ्यो लेड़ाय सेकी; काहाकाय तुमरो बोगवान यहोवा उपेरवाला हेरगान एने बुंदेवाली देरतीन बोगवान हे। <verse eid="JOS 2:11" /><verse number="12" style="v" sid="JOS 2:12" />मी तुमरी पोर गीण किरेल हे, केरीन एवी मार सामने बोगवानान सुगोण खावो काय, तुमू बी मारा आबाख ने गेराणा पोर गीण किरहो; एने तान खेरली निसाणी माहु आपो, <verse eid="JOS 2:12" /><verse number="13" style="v" sid="JOS 2:13" />काय तुमू मारा आईख आबाख, बायह्याख एने बोणह्युख, एने जो काय तान हे ता आखाह बी जीवताला सोड़ दिज्यो, एने आमरे आखान जीवाह मोरने से वोचाड़ लिहो।”<verse eid="JOS 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 2:14" />तेवी ता एदमी तीह केया, “तु आमरी ज्यी वात कुणीह केयी नाह, ते तुमरी केरता आमु आमरो जीव देहु, एने बोगवान आमुह ज्‍यो देस आपी, तेवी आमु तार हेऱ्या गीण एने खेराय केरीन वेवार केरहु।”<verse eid="JOS 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 2:15" />तेवी राहाब जीन गेर गावान बितड़ा हेऱ्योच एतो, एने ती तास रेताली, ती ताह खिड़की माय रेन दोयड़ी केरीन उतारीन गावान बाहेर केर देनी। <verse eid="JOS 2:15" /><verse number="16" style="v" sid="JOS 2:16" />एने ती ताह केयी, “बोयड़ा माय जात रिवो, इही नाय एय काय होदणारे तुमूह सापड़ावे। केरीन जाह वोर तुमूह होदणारे वोलीन नाय आवती रेती ताह वोर मतलब तीन दिह ताच लिकीन रिज्‍यो, तान बाद तुमरे वाटे जाज्यो।”<verse eid="JOS 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JOS 2:17" />ता एदमी तीह केया, “जो सुगोण तु आमुह खावाड़ेल हे तान बाराम आमु ते निर्दोस रेहु। <verse eid="JOS 2:17" /><verse number="18" style="v" sid="JOS 2:18" />हुमेल, जेवी आमु ज्या देसाम आवहु, तेवी जी खिड़की माय रेन तु आमुह उतारेल हे ती माय रातला रेंगान दोयड़ी बांद दिज्‍ये; एने तारा आहख आबोख, बाहख, एने तारा आबाख ने आखा गेराणाह ज्यास गेराम तार फाय एकठा केरीन मिलज्ये। <verse eid="JOS 2:18" /><verse number="19" style="v" sid="JOS 2:19" />तेवी जो कुण तारा गेराम रेन बाहेर निकली, तान खुनान दोस तास ने मुंडी पोर पोड़ी, आमरी पोर तान दोस आवी नाय; पुण गेराम तार हेऱ्या जा रेती ता पोर एखेह आत टाकी ताहार तान खुनान दोस आमरी मुंडी पोर पोड़ी। <verse eid="JOS 2:19" /><verse number="20" style="v" sid="JOS 2:20" />केदी तु ज्यी वात एगदाह किहे काय आमु काय केरन्या हेते, ताहार जो सुगोण तु आमुह खावाड़ेल हे ता माय रेन आमु सुट जाहु।” <verse eid="JOS 2:20" /><verse number="21" style="v" sid="JOS 2:21" />ती केयी, “तुमरा केणान गेत एय।” तेवी ती ताह मोकल्यी, एने ता जात रेना; एने ती रातला रेंगान दोयड़ी खिड़कीह बांद देनी।<verse eid="JOS 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 2:22" />एने ता तीन गेराह सोड़ीन बोयड़ाम जात रेना, ताहरी ता तीन दिह रेना; राजान माणहे आखी वाटे ताह होद्या, पुण ता ताह सापेड़ना नाह। <verse eid="JOS 2:22" /><verse number="23" style="v" sid="JOS 2:23" />तेवी ता दुयू एदमी बोयड़ाम रेन उतेरना, एने नेदीह पार केरीन नुन ने बिटोख यहोशु फाय पोचना एने जो काय ता हेर्‍य ईयेल एतो। <verse eid="JOS 2:23" /><verse number="24" style="v" sid="JOS 2:24" />ता यहोशुह केया, “बोगवान खेरीच आखो देस आपुह आप दियेल हे, ता देसान आखा माणहे आपुह बिय रेनाह।”<verse eid="JOS 2:24" /></para>
  <chapter eid="JOS 2" />
  <chapter number="3" style="c" sid="JOS 3" />
  <para style="s">इस्राएली माणहान यरदन नेदीह पार केरनो</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 3:1" />यहोशु दिहरे दिह वेगोस उठनो, एने आखा इस्राएलीह आरही लेन शित्‍तीमाह सोड़ीन यरदन नेदीन देड़े आवा; एने ता पार केरनेन पेल यरदन नेदीन हेऱ्याच पाड़ावो टाक्या। <verse eid="JOS 3:1" /><verse number="2" style="v" sid="JOS 3:2" />तीन दिह्यान बाद डायला माणहे पाड़ावान विचीम जाईन <verse eid="JOS 3:2" /><verse number="3" style="v" sid="JOS 3:3" />एने माणहाह ज्‍यो उकुम आप्या, “जेवी तुमूह चाकऱ्यो यहोवा बोगवानान वाचान पेटी <note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="fq" closed="false">पेटी </char><char style="ft" closed="false">जा माय दोह उकुमान पाट्यु मेलाय जाताल्यु।</char></note>उखलीन देखाय, तेवी तुमरा जागाह सोड़ीन तान पासाण पासाण चालज्‍यो। <verse eid="JOS 3:3" /><verse number="4" style="v" sid="JOS 3:4" />पुण पेटीन एने तुमरे विचीम दुय एजार आथान कोमीत कोमी सेटो रेय; तुमू पेटीन आहने मा जाहो। काहाकाय तुमू देख सीको, काय काल्ली वाटे तुमूह चालनु हे, काहाकाय ज्यान पेल ज्यी वाटी पोर रेन तुमू केदी चाल्‍या नाह।”<verse eid="JOS 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JOS 3:5" />उवतो यहोशु माणहाह केयो, “तुमू आपणे आपाह चोखा किरो; काहाकाय हेकाले बोगवान तुमरे विचीम चोमेत्कार किरन्‍यो हे।” <verse eid="JOS 3:5" /><verse number="6" style="v" sid="JOS 3:6" />बाद माय यहोशु चाकऱ्याह केयो, “वाचान पेटी उखलीन माणहान ओंगाण ओंगाण चालो।” तेवी ता वाचान पेटी उखलीन ओंगाण ओंगाण चालना।<verse eid="JOS 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 3:7" />तेवी बोगवान यहोशुह केयो, “आज रेन मी आखा इस्राएलीन सामने तारी बोड़ाय केरने सुरवात केरूह, तेवी माणहे जाणती काय जीहे मी मुसा हिऱ्यो रेतालो तिहेच केरीन मी तार हिऱ्यो बी हे। <verse eid="JOS 3:7" /><verse number="8" style="v" sid="JOS 3:8" />एने तु वाचान पेटीह उखेलनारे चाकऱ्याह ज्‍यो उकुम आप, जेवी तुमू यरदन नेदीन देड़े पोचहो, तेवी यरदन माय उब रिज्यो।”<verse eid="JOS 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 3:9" />उवतो यहोशु इस्राएल ने माणहाह केयो, “आहने आवीन तुमरा बोगवान यहोवान वचन हुमलो।” <verse eid="JOS 3:9" /><verse number="10" style="v" sid="JOS 3:10" />एने यहोशु केणे बाज गीयो, “ज्या केरीन तुमू जाण जाहो काय जीवतालो बोगवान तुमरे विचीम हे, एने तो तुमरे सामने रेन कनानी, हित्ती, हिववी, परिज्जी, गिर्गाशी, एमोरी, एने यबूसी न्याह तान देसाम रेन निकाल देय। <verse eid="JOS 3:10" /><verse number="11" style="v" sid="JOS 3:11" />होमलो, आखी दुनियान बोगवानान वाचान पेटी तुमरे ओंगाण ओंगाण यरदन माय जाण्‍यी हे। <verse eid="JOS 3:11" /><verse number="12" style="v" sid="JOS 3:12" />केरीन एवी तुमू इस्राएल ने गेराणा माय रेन बारा एदमी निवाड़ लिवो, एक एक गेराणा माय रेन एक एक। <verse eid="JOS 3:12" /><verse number="13" style="v" sid="JOS 3:13" />चाकऱ्या आखी दुनियान मालीक ने पेटीह लेन चालती। एने जेवी ता ती पेटीह तुमरे सामने यरदन नेदी माय ली जाती, जेवी ता पाण्या माय जाती; ते यरदन नेदीन पाणी वोयणो बोंद एय जाय, एने बांदान गेत थोब रेय।”<verse eid="JOS 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 3:14" />जेवी माणहे यरदन नेदी पार केरनेन केरता तान तोम्बुह सोड्या, एने चाकऱ्या वाचान पेटी उखलीन ओंगाण ओंगाण चालताला,<verse eid="JOS 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 3:15" />एने पेटीह उखेलनारे यरदन नेदीन मीरे पोचना, एने पेटीह उखेलनारे चाकऱ्या पाण्या माय पाय मेल्या। यरदन नेदी काटणेन टेम आखा दिह वोर पुरी बोरायीन वुयेह। <verse eid="JOS 3:15" /><verse number="16" style="v" sid="JOS 3:16" />तेवी जो पाणी उपेरली उगे रेन वोयतेन आवतालो तो जुलूम सेटो, मतलब आदम गावान आहने जो सारतान हेयरान आहने हे रोकायेन बांदान गेत उबरी गीयो, एने बितड़ान गेत उबरीनो, आराबान देरीयो, जो खाऱ्यो देरीयो बी केवाथे तान उगे वोयतालो, तो आखो हुक गीयो; एने माणहे यरीहोन सामने पार उतेर गीया। <verse eid="JOS 3:16" /><verse number="17" style="v" sid="JOS 3:17" />ता जागावाली बुय हुक गियी एने चाकऱ्या बोगवानान वाचान पेटीह नेदीन विचीम ली जाएन उब रेना, एने आखा इस्राएली हुकेल बुय पोर चालीन ती पार उतेरते रेना, सेवल्‍यी बुखेत ता आखा माणहे यरदन नेदी पार एय गीया।<verse eid="JOS 3:17" /></para>
  <chapter eid="JOS 3" />
  <chapter number="4" style="c" sid="JOS 4" />
  <para style="s">एरीन बारा दिगोड़</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 4:1" />जेवी आखा माणहे यरदन नेदीह पार केर लेदा, तेवी बोगवान यहोशुह केयो, <verse eid="JOS 4:1" /><verse number="2" style="v" sid="JOS 4:2" />“माणहाम रेन बारा एदमी निवाड़ो, एक एक वोस माय रेन एक एक एदमी निवाड़ो, <verse eid="JOS 4:2" /><verse number="3" style="v" sid="JOS 4:3" />एने माणहाह किवो काय तुमू यरदन नेदीन विचीम, जाहरी चाकऱ्या उबरियेल एता ता रेन बारा दिगोड़ विसीन आपणी हेऱ्या ती पार ली चालो, एने जाहरी आज राती पाड़ावो रेय ताहरी ताह मेल दिज्यो।”<verse eid="JOS 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOS 4:4" />तेवी यहोशु ता बारा एदम्याह जाह तो इस्राएलीन एक एक वोस माय रेन साटीन निवाड़ मिलेल इतो, ताह हाद्यो, <verse eid="JOS 4:4" /><verse number="5" style="v" sid="JOS 4:5" />यहोशु केयो, “तुमू आपणो बोगवान यहोवान पेटीन ओंगाण यरदन नेदीन विचीम जाएन इस्राएल माणहान गेणतीन गेत एक एक दिगोड़ विसीन आप आपणा खांदा पोर मिलो, <verse eid="JOS 4:5" /><verse number="6" style="v" sid="JOS 4:6" />ज्या दिगोड़ तुमरे विचीम निसाणी ठेराती, एने ओंगाणल्‍या दिह्याम जेवी तुमरा सोरा ज्‍य फुसती, ‘ज्या देगड़ान काय मतलब हे?’ <verse eid="JOS 4:6" /><verse number="7" style="v" sid="JOS 4:7" />तेवी तुमू ताह किज्यो काय, यरदन नेदीन पाणी यहोवान वाचान पेटीन सामने दुय बाग एय जायेल एतो; काहाकाय जेवी पेटी यरदन नेदीन ती पार जाणे बुखेत यरदन नेदीन पाणी दुय बाग एय गीयो। इहकेरीन ज्या दिगोड़ इस्राएल माणहान केरता कायेम ने केरता एर केरावणारे ठेराती।”<verse eid="JOS 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 4:8" />यहोशुन ज्या उकुमान गेत इस्राएल माणहे केऱ्या, जीहे बोगवान यहोशुह कियेल इतो, तिहेच केरीन ता इस्राएली माणहान गेणतीन गेत बारा दिगोड़ यरदन नेदीन विचीम रेन विस लेदा; एने ता देगड़ाह आपणे आरही ली जाएन पाड़ावा माय मेल देना। <verse eid="JOS 4:8" /><verse number="9" style="v" sid="JOS 4:9" />एने यरदन नेदीन विचीम, जाहरी चाकऱ्या वाचान पेटीह उखलीन उबरियेल एता ताहरी यहोशु बारा दिगोड़ उबराखाड्यो; ता आज वोर तास हेते। <verse eid="JOS 4:9" /><verse number="10" style="v" sid="JOS 4:10" />एने चाकऱ्या पेटी उखलीन तुलबुखे वोर यरदन नेदीन विचीम उब रेना, जाह वोर त्यु आख्‍यु वातु पुऱ्यू नाह एन्यु, ज्‍युह बोगवान यहोशुह माणहाह केणेन उकुम आपेल इतो। ओवता आखा माणहे उतवाल केरीन ती पार उतेर गीया। <verse eid="JOS 4:10" /><verse number="11" style="v" sid="JOS 4:11" />एने जेवी आखा माणहे नेदीह पार केर लेदा, तेवी चाकऱ्या बोगवानान पेटी लेन माणहान सामने पार एना। <verse eid="JOS 4:11" /><verse number="12" style="v" sid="JOS 4:12" />जीह केरीन मुसो कियेल इतो तिहेच केरीन रूबेनी, एने गाद, एने मनश्शेन वोसीन आदा माणहे आथ्‍यार बांदिन इस्राएली माणहान सामने ती पार गीया; <verse eid="JOS 4:12" /><verse number="13" style="v" sid="JOS 4:13" />लेड़ानेन केरता ता चालीह एजार एदमी बोगवानान सामने नेदी उतरीन यरीहोन आहने मोयदाना माय पोचना। <verse eid="JOS 4:13" /><verse number="14" style="v" sid="JOS 4:14" />ते दिह बोगवान इस्राएल ने आखा माणहान नेजरीम यहोशुह एक महान माणुह बाणाव दिनो। तेवीह रेन माणहे यहोशुन बिय एने आदार केरने बाज गीया, ता यहोशुन आदार जीवाय बोर केरने बाज गीया जीह केरीन मुसान आदार केरताला।<verse eid="JOS 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 4:15" />ओवतो बोगवान यहोशुह केयो, <verse eid="JOS 4:15" /><verse number="16" style="v" sid="JOS 4:16" />“वाचान पेटी उखेलनारे चाकऱ्याह यरदन नेदीम रेन बाहेर निकील आवणेन उकुम आप।” <verse eid="JOS 4:16" /><verse number="17" style="v" sid="JOS 4:17" />तेवी यहोशु चाकऱ्याह उकुम आप्यो, “यरदन नेदीम रेन बाहेर निकील आवो।” <verse eid="JOS 4:17" /><verse number="18" style="v" sid="JOS 4:18" />एने इह केरीन एनो काय बोगवानान पेटी विसणारे चाकऱ्या यरदन नेदीन विचीम रेन जेवी बाहेर निकील आवा, एने तान पाय जीहे मेराम मेल्या, तिहे यरदन नेदीन पाणी पोशो तान जागा पोर आवो, एने पेल ने गेतुस बोरायीन वोयणे बाज गीयो।<verse eid="JOS 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JOS 4:19" />इस्राएली माणहे पेल्ला मोयनान दोहवे दिह यरदन नेदीम रेन निकलेल एता, एने यरीहोन दिह उगतान एद्‍दी पोर गीलगाल माय पाड़ावो टाक्या। <verse eid="JOS 4:19" /><verse number="20" style="v" sid="JOS 4:20" />एने जा बारा दिगोड़ यरदन नेदीम रेन निकालेल एता, ताह यहोशु गीलगाल माय उब राखाड्यो। <verse eid="JOS 4:20" /><verse number="21" style="v" sid="JOS 4:21" />तेवी यहोशु इस्राएल ने माणहाह केयो, “ओंगाणल्‍या दिह्याम जेवी तुमरा सोरा आप आपणा आबाख ज्‍य फुसे, ज्या देगड़ान काय मतलब हे? <verse eid="JOS 4:21" /><verse number="22" style="v" sid="JOS 4:22" />तेवी तुमू तुमरा सोराह किज्यो, इस्राएली माणहे हुकेल बुयी पोर चालीन ज्यी यरदन नेदीह पार किरेल एता। <verse eid="JOS 4:22" /><verse number="23" style="v" sid="JOS 4:23" />काहाकाय तुमरो बोगवान यहोवा नेदीन पाणीह वोयणे रोक दिनो, नेदी ताह वोर आट रेनी जाह वोर माणहे नेदीह पार नाह केर लेदा; बोगवान यरदन नेदी पोर माणहान केरता तोस किऱ्यो, जो तो माणहान केरता रातला देरीया पोर किरेल इतो, एर किरो काय यहोवा रातला देरीयान पाणी वोयणे ज्यान केरता रूकेल इतो काय माणहे पार केर सेके। <verse eid="JOS 4:23" /><verse number="24" style="v" sid="JOS 4:24" />ज्यान केरता काय देरतीन आखा देसान माणहे जाण लेय काय बोगवानान आथ ताकेतवोर हे; एने तुमू जेलेम तुमरो बोगवान यहोवान बिय मानते रिवो।”<verse eid="JOS 4:24" /></para>
  <chapter eid="JOS 4" />
  <chapter number="5" style="c" sid="JOS 5" />
  <para style="s">इस्राएल माणहान खेतान एणो एने फसह मान्नो</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 5:1" />जेवी यरदन ने दिह उगता निही रेणारे एमोरीन आखा राजा, एने देरीयान आहने रेणारे कनानीन आखा राजा ज्‍य होमल्या, काय यहोवा इस्राएली माणहे पार एणे वोर तान सामने रेन यरदन नेदीन पाणी सेटो केरीन आटिव मिल्योह। तेवी इस्राएल माणहान बियीन वोजेसे तान मोन गाबराय गीयो, एने ताम काय ईमोत रेनी नाह।<verse eid="JOS 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JOS 5:2" />तुलबुखे बोगवान यहोशुह केयो, “तु गारान देगड़ान सुरी बाणावीन इस्राएल माणहान पोशो एकवार खेतान केर।” <verse eid="JOS 5:2" /><verse number="3" style="v" sid="JOS 5:3" />केरीन यहोशु गारान देगड़ान सुरी बाणावीन यहोशु इस्राएल माणहान खेतान नावान बोयड़ा माय खेतना केरायो। <verse eid="JOS 5:3" /><verse number="4" style="v" sid="JOS 5:4" />एने यहोशु जो खेतना केरायो, ज्यान कारेण ज्‍य हे काय जोला लेड़ायीन लायकी एदमी मिस्र देसाम रेन निकलेल एता ता आखा मिस्र रेन निकेलने बाद जेंगलाम वाटे मोर जायेल एता। <verse eid="JOS 5:4" /><verse number="5" style="v" sid="JOS 5:5" />जा एदमी मिस्र देसाम रेन निकलेल एता ता आखान ते खेतना एय जायेल एतो, पुण मिस्र देसाम रेन बाहेर निकेलने बाद जेंगलाम वाटे जा पायदा ईयेल एता, तान खेतना ईयेल नाह एतो। <verse eid="JOS 5:5" /><verse number="6" style="v" sid="JOS 5:6" /><note caller="+" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="NUM 14:28-35">गिनती 14:28-35</ref></char></note>काहाकाय इस्राएली माणहे चालीह वोरह्या वोर जेंगलाम फिरती रेना, जाह वोर ती आखी जातीन माणहे, मतलब जोला लेड़ानेन लायकी माणहे मिस्र देसाम रेन निकलेल एता ता खेतेम एय गीया; काहाकाय ता बोगवानान वात नाह मानेल एता; केरीन बोगवान सुगोण खाएन ताह कियेल इतो; काय जो देस मी तुमरा डायडाया हिऱ्यो सुगोण खाईन तुमूह आपणेन कियेल इतो, एने ताम दुद एने मोवालान दार वुयेह, तो देस मी तुमूह नाय देखाडु। <verse eid="JOS 5:6" /><verse number="7" style="v" sid="JOS 5:7" />ते ता माणहान सोरा जान बोगवान तान जागा पोर पायदा किरेल इतो, तान खेतान यहोशु फाय केरायो, काहाकाय वाटे तान खेतान नाह ईयेल एतो; ता बिगेर खेतनावाला एता।<verse eid="JOS 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 5:8" />ओवतो यहोशु आखा एदम्यान खेतना पुरो किऱ्यो, ता ताह वोर आप आपणे जागे तोम्बुम रेना, जाह वोर हुदेरना नाह। <verse eid="JOS 5:8" /><verse number="9" style="v" sid="JOS 5:9" />ओवतो बोगवान यहोशुह केयो, मिस्री माणहे “तुमरी चिहटा केरताला तो आज मी तुमरी फाय रेन सेटो किरेल हे।” केरीन ता जागान नाव आजीन दिह वोर गीलगाल <note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="fq" closed="false">गीलगाल </char><char style="ft" closed="false">उंडेलने, नाहते सेटो केरने</char></note>पुड़ेल हे।<verse eid="JOS 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 5:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:10 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:1-13">निर्गमन 12:1-13</ref>
      </char>
    </note>जुलबुखे इस्राएली माणहे यरीहोन चोवगानाम गीलगाल ने जागे पाड़ावो टाकेल एता, ता फसह तिवार मोणावताला। ज्‍य मोयनान चोवदावे दिह्यान हांजीन टेम एतो। <verse eid="JOS 5:10" /><verse number="11" style="v" sid="JOS 5:11" />एने फसहान दिहरे दिह ता देसान कामाय माय रेन अखमीरी रूटो एने तेदिस रेन बुंजेल दाणा बी खाणे बाज गीया। <verse eid="JOS 5:11" /><verse number="12" style="v" sid="JOS 5:12" /><note caller="+" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="EXO 16:35">निर्गमन 16:35</ref></char></note> एने जे दिह ता देसान कामाय माय रेन खाणे बाज गीया, तेदिस वेगोस मन्ना बोंद एय गीयो; एने इस्राएली माणहाह मन्ना पोशो जुड़नो नाह, पुण ती वोरीह ता कनान देसावाली कामाय खादा।<verse eid="JOS 5:12" /></para>
  <para style="s">यहोशु एने तालवार लेन एक एदमी</para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 5:13" />जेवी यहोशु यरीहोन आहने इतो तेवी दिख्यो काय आथाम तालवार लेन एक एदमी सामने उबरिनोह; एने यहोशु ता फाय जाईन फुशो, “काय तु आमरी उगेन हे, काय आमरा दुसमोनान उगेन?”<verse eid="JOS 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 5:14" />तो जापाप आप्यो, “नाह; मी बोगवानान सेनान मुखी हे।”</para>
  <para style="p" vid="JOS 5:14">तेवी यहोशु बुय पोर मुंड नेचो केरीन वोंद्‍यो एने ताह केयो, “तारा दासान केरता मारा मालीक ने काय उकुम हे?”<verse eid="JOS 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 5:15" />बोगवानान सेनान मुखी यहोशुह केयो, “तारा खाहड़ा पायाम रेन काड़ दे; काहाकाय जा जागा पोर तु उबरिनोह तो चोखालो हे।” तेवी यहोशु तिहेच केरीन किऱ्यो।<verse eid="JOS 5:15" /></para>
  <chapter eid="JOS 5" />
  <chapter number="6" style="c" sid="JOS 6" />
  <para style="s">यरीहो गावान खेतेम एणो</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 6:1" />यरीहोन आखा फाटेक इस्राएलीन बियीन वोजेसे दाड़ीन बोंद रेना, एने कुण बाहेर आव जाव नाह केर सेकतालो। <verse eid="JOS 6:1" /><verse number="2" style="v" sid="JOS 6:2" />उवतो बोगवान यहोशुह केयो, “हुमेल, मी यरीहोह तान राजा एने सेना बेल तारा ताबाम केर देथु। <verse eid="JOS 6:2" /><verse number="3" style="v" sid="JOS 6:3" />एने तुमू माय जोला सिपाय हेते गावाह कोंड लिवो, एने ता गावान कावदिन एक वार फिरीन आवो। एने सोव दिह वोर इहीच केरीन केऱ्या किरज्‍यो। <verse eid="JOS 6:3" /><verse number="4" style="v" sid="JOS 6:4" />एने हात चाकऱ्या पेटीन ओंगाण ओंगाण मेंडान हिंगान हात बिरा लेन चाले; ओवता हातवे दिह तुमू गावान कावदिन हात वार फिरज्‍यो, एने चाकऱ्या बी बिरा वाजाड़तेन चाले। <verse eid="JOS 6:4" /><verse number="5" style="v" sid="JOS 6:5" />एने जेवी ता मेंडान हिंगान बिरा जुलूम वार वोर वाजाड़ते रेय, तेवी आखा माणहे बिरान बोल होमेलतास जोरेस बोड़ाय केरी; जेवी तुमू इहकेरीन किरहो ताहार गावान बितड़ा ओदीर जाती, एने आखा माणहे हुतरा गावाम जाती।”<verse eid="JOS 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 6:6" />केरीन नुन ने बिटोख यहोशु चाकऱ्याह हादिन केयो, “वाचान पेटीह उखेल लिवो, एने हात चाकऱ्या यहोवान पेटीन ओंगाण ओंगाण मेंडान हिंगान हात बिरा लेन चाले।” <verse eid="JOS 6:6" /><verse number="7" style="v" sid="JOS 6:7" />उवतो यहोशु माणहाह उकुम आप्यो, ओंगाण जाएन गावान कावदेन फिरीन आवो; एने आथ्‍यारावाला एदमी यहोवान पेटीन ओंगाण ओंगाण चाले।<verse eid="JOS 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 6:8" />एने जेवी यहोशु ज्‍यु वातु माणहाह केय दिनो, ते ता हात चाकऱ्या जा बोगवानान सामने हात बिरा लियरियेल एता, बिरा वाजाड़तेन चाले, एने बोगवान ने वाचान पेटीह लेन चालनारे चाकऱ्या तान पासाण पासाण चाले।<verse eid="JOS 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 6:9" />एने आथ्‍यारावाला एदमी बिरा फुकणारे चाकर्‍यान ओंगाण ओंगाण चाले, एने पासाणल्‍या पेटीन पासाण पासाण चाले, एने चाकऱ्या बिरा वाजाड़तेन चाले। <verse eid="JOS 6:9" /><verse number="10" style="v" sid="JOS 6:10" />एने यहोशु माणहाह उकुम आप्यो, “जाह वोर मी तुमूह बोड़ाय केरनेन उकुम नाय आपु, ताह वोर बोड़ाय मा किरहो, एने नाह तुमरो एगदो सोबदो होमेलनाम आवी, नाह एगदी वात तुमरे मुयाम रेन निकेलने जुवे; पुण उकुम एतास बोड़ाय किरज्‍यो।” <verse eid="JOS 6:10" /><verse number="11" style="v" sid="JOS 6:11" />केरीन यहोशु बोगवानान पेटीह एक वार गावान कावदेन फिराव्यो; तान बाद ता पाड़ावाम आवीन ताहरी रात निकाल्या।<verse eid="JOS 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 6:12" />यहोशु वेगोस उठनो, एने चाकऱ्या पोशा बोगवानान पेटीह उखलीन चालना।<verse eid="JOS 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 6:13" />एने ता हात चाकऱ्या मेंडान हिंगान हात बिरा लेन एने बोगवानान पेटीन ओंगाण ओंगाण वाजाड़तेन चाले; एने तान ओंगाण आथ्‍यारावाला एदमी चाले, एने पासाणल्‍या बोगवानान पेटीन पासाण पासाण चाले, एने चाकऱ्या बिरा वाजाड़तेन जात रेना। <verse eid="JOS 6:13" /><verse number="14" style="v" sid="JOS 6:14" />इहकेरीन ता दिहरे दिह बी एक वार गावान कावदेन फिरीन पाड़ावाम पोशा आवा; एने इहीच केरीन ता सोव दिह वोर केऱ्या।<verse eid="JOS 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 6:15" />ओवता हातवे दिह ता उठ्यान वेगास उठीन तिहेच केरीन गावान कावदिन हात वार फिरीन आवा; तेदिस ता हात वार फिरना। <verse eid="JOS 6:15" /><verse number="16" style="v" sid="JOS 6:16" />तेवी हातवी वार जेवी चाकऱ्या बिरा वाजाड़ताला, तेवी यहोशु माणहाह केयो, “जय जयकार किरो; काहाकाय बोगवान ज्‍य गाव तुमूह आप दियेल हे। <verse eid="JOS 6:16" /><verse number="17" style="v" sid="JOS 6:17" />गाव एने जो काय वोस्तु ज्या माय हे तो सोब बोगवानाह बेट ने रूप माय आखी चिज खेतेम केराय जाय; फोक्‍तो राहाब वेश्‍याह एने जा कुण ती हेऱ्या तीन गेर रेती ता जीवताला सोड़ाय जाती, काहाकाय ती आमु मुकलेल माणहाह लीकाड़ मिलेल एती। <verse eid="JOS 6:17" /><verse number="18" style="v" sid="JOS 6:18" />पुण तुमू अर्पण किरेल वोस्तु माय रेन कायच मा मिलो जो खेतेम एण्यो हे, केदी तुमू ज्यु वोस्तु माय रेन काह लेतेह, ताहार इस्राएलीन पाड़ावा पोर हाराप लावीन ताह तेकलीताम टाकहो। <verse eid="JOS 6:18" /><verse number="19" style="v" sid="JOS 6:19" />सोब होनो, चांदी, एने जा ठामला पितलान एने लोड़ान हेते, ता यहोवान केरता चोखाला हेते, ता बोगवानान बांडाराम मेलाय जाय।”<verse eid="JOS 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JOS 6:20" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:20 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 11:30">इब्रानियो 11:30</ref>
      </char>
    </note>तेवी माणहे जय जयकार केऱ्या, एने चाकऱ्या बिरा वाजाड़ते रेना। एने जेवी माणहे बिरान सोबदो होमल्या ते उंजु मोठेस ता जय जयकार केऱ्या, तेवी बितड़ो ओदीर पोड़नो, एने माणहे हुतरा गावा माय दोवेड़ पोड़ना, इहकेरीन इस्राएल ने माणहे हेयराह आरवीन लेय लेदा। <verse eid="JOS 6:20" /><verse number="21" style="v" sid="JOS 6:21" />ता हेयरावाला एदमी, बायकु, जुवाने, डावाला एने गाय बुयेल, मेंड्रा बोकड्या, गेदड़ा एने जोला हेयरा माय एता, ता आखाह ता बेट किरेल चिज सोमजीन तालवार केरीन मार टाक्या।<verse eid="JOS 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 6:22" />तेवी जा दुय एदमी ता देसान बाराम पुतो लागाड़नेन केरता जायेल एता, ताह यहोशु केयो, “तुमरा सुगोणान गेत ती वेश्‍यान गेराम जाईन तीह एने तीन जो कुण एती ताह बाहेर निकाल लियावो।” <verse eid="JOS 6:22" /><verse number="23" style="v" sid="JOS 6:23" />तेवी ता दुय एदमी गेराम गीया एने राहाबाह, एने तीन आईख आबाख, बायह्याख, एने आखाह जा ती फाय रेताला, तीन सोब गेराणाह निकाल लावा, एने इस्राएल ने पाड़ावे रेन बाहेर लावीन मेल्या। <verse eid="JOS 6:23" /><verse number="24" style="v" sid="JOS 6:24" />ओवता ता हेयराह, एने जो काय ता माय एतो, आखाह आक्‍ठो लागाड़ीन हेलगाड़ देना; फोक्‍तो होनो, चांदी, एने जा ठामला पितलान एने लोड़ान एता, ताह ता यहोवान गेरान बांडार माय मेल देना। <verse eid="JOS 6:24" /><verse number="25" style="v" sid="JOS 6:25" /><note caller="+" style="x"><char style="xo" closed="false">6:25 </char><char style="xt" closed="false"><ref loc="HEB 11:31">इब्रानियो 11:31</ref></char></note>एने यहोशु राहाब वेश्‍या एने तीन आबाख ने गेराणाह, एने तीन आखा माणहाह जीवताला सोड़ दिनो; एने आज वोर तीन वोच इस्राएल ने माणहान विचीम रीथे, काहाकाय जा माणहे यरीहोन पुतो लागाड़नेन मोकलेल एता, ताह ती लीकाड़ मिलेल एती।<verse eid="JOS 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JOS 6:26" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:26 </char>
      <char style="xt" closed="false">
        <ref loc="1KI 16:34">1 राजा 16:34</ref>
      </char>
    </note> ओवतो तुलेचबुखे यहोशु इह केरीन हाराप आप्यो, “जो माणुह यरीहो हेयराह पोशो बाणावी ताहार ताह बोगवानान हाराप लागी। जेवी तो तान पायो बाणावी, तेवी तान जेठालो बिटोख मोरी, एने जेवी तो तान बायणा बोहाड़ी तेवी तान आतल्‍यो बिटोख मोर जाय।”<verse eid="JOS 6:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JOS 6:27" />एने बोगवान यहोशु हिऱ्यो रिनो; एने यहोशुन किर्ती ता आखा देसाम पोसीर गियी।<verse eid="JOS 6:27" /></para>
  <chapter eid="JOS 6" />
  <chapter number="7" style="c" sid="JOS 7" />
  <para style="s">आकानान पाप</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 7:1" />पुण इस्राएल ने माणहे बेट केरनेन वोस्तुन बाराम बोगवानान बुहरो तोड़ देना; मतलब यहुदान वोचीन आकान, जो जेरह वोचीन जब्दीन बोतोरजोहख एने कर्मीन बिटोख इतो, तो बेट किरेल चिजीम रेन थोड़ोक लेय लिदो; केरीन इस्राएल ने माणहा पोर बोगवानान राग बोड़ेक उठनो।<verse eid="JOS 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JOS 7:2" />जेवी ता यरीहोह आरवी देना, तेवी यहोशु थोड़ाक माणहाह आई नावान हेयरान आहने, जो बेतावेन रेन लागीन बेतेलान पुर्व निही, थोड़ाक माणहाह ज्‍य केन मोकल्‍यो, “जाएन देसान पुतो लागाड़ीन आवो।” एने ता माणहे जाएन आई गावान पुतो लागाड्या। <verse eid="JOS 7:2" /><verse number="3" style="v" sid="JOS 7:3" />बाद माय ता माणहे यहोशु फाय पोशा आवीन केया, “आखा माणहे ताहरी नाय जाय, फोक्‍ता दुय तीन एजार एदमी जाएन आई हेयराह जिक सेकतेह; आखा माणहाह ताहरी जाणेन तेकलीत मा आपी, काहाकाय ता थोड़ास हेते।” <verse eid="JOS 7:3" /><verse number="4" style="v" sid="JOS 7:4" />केरीन कोमीत कोमी तीन एजार एदमी ताहरी गीया; पुण आई हेयराम रेणारा माणहान सामने रेन ता नाहीन आवतरना। <verse eid="JOS 7:4" /><verse number="5" style="v" sid="JOS 7:5" />तेवी आई हेयराम रेणारे ताम रेन कोमीत कोमी सेत्‍तीस एदमी मार टाक्या, एने तान बायणे रेन ते देगड़ान बोयड़े वोर तान पासाण पोड़ीन वोर ताह मारते गीया; केरीन माणहान मोन पिगलीन पाण्यान गेत बोण गीयो।<verse eid="JOS 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 7:6" />तेवी यहोशु तान फाड़का फाड्यो, एने तो एने इस्राएल ने डायडाया माणहे बोगवानान पेटीन सामने बुय पोर हांज पोर वोर लोट रेना; एने ता आप आपणी मुंडी पोर रेजड़ो टाक्या। <verse eid="JOS 7:6" /><verse number="7" style="v" sid="JOS 7:7" />एने यहोशु केयो, “हाय, मालीक बोगवान, तु तारा न्या माणहाह यरदन नेदीन ज्यी पार काहा लियावो? काय आमुह एमोरी वोसीन ताबाम केरीन खेतेम केरनेन केरता ली आयेल हे? हाजो रेतो काय आमु खुस एन यरदन नेदीन ती पार रेय जाता! <verse eid="JOS 7:7" /><verse number="8" style="v" sid="JOS 7:8" />एय मालीक, इस्राएली तान दुसमोनाह डील देखाड़ेल हेते; एवी मी काय केव <verse eid="JOS 7:8" /><verse number="9" style="v" sid="JOS 7:9" />काहाकाय कनानी एने ज्या देसान आखा माणहे ज्‍य होमलीन आमुह कोंड लेती, एने आमरो नाव देरती पोर रेन मिटाड़ देती; ओवतो तु तारा मोटला नावान केरता काय किरहे?”<verse eid="JOS 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 7:10" />तेवी बोगवान यहोशुह केयो, “उबरी जावो! तुमू काहा बुय पोर पोड़ रेनाह? <verse eid="JOS 7:10" /><verse number="11" style="v" sid="JOS 7:11" />इस्राएल ने माणहे मार विरूद पाप किरेल हेते; एने जी वाचा मी ताह मार हिऱ्यो बांदाड़ेल इतो तीह ता तोड़ दियेल हेते, ता बेट केरनेन वोस्तु माय रेन लेय लेदा, एने चोरी बी किरेल हेते, एने ती चिज तान सोमानाम मेल लियेल हेते। <verse eid="JOS 7:11" /><verse number="12" style="v" sid="JOS 7:12" />केरीन इस्राएली माणहे तान दुसमोनान सामने टिकते नाह; ता तान दुसमोनाह डील देखाड़तेह, काहाकाय ता सोता बेट किरेल चिज बोण जायेल हेते। एने केदी तुमू तुमरे विचीम रेन बेट केरनेन वोस्तुह खेतेम केऱ्या सावाय, न्या रेन ओंगाण मी तुमरी हिऱ्यो रेव नाय।” <verse eid="JOS 7:12" /><verse number="13" style="v" sid="JOS 7:13" />उठ, माणहाह चोखो केर एने ताह के; “हेकालेन केरता तुमू सोताह चोखा केरीन मीलो;” काहाकाय इस्राएल ने बोगवान यहोवा ज्‍य किथे, “एय इस्राएल तार विचीम बेट केरनेन वोस्तु हे; केरीन जाह वोर तु बेट केरनेन वोस्तुह तुमरे विची माय रेन सेटी नाय केरी ताह वोर तु तारा दुसमोनान सामने टिकहे नाय। <verse eid="JOS 7:13" /><verse number="14" style="v" sid="JOS 7:14" />केरीन वेगास तुमू आखाह यहोवान सामने उबरेणे पोड़ी; एने जा कुटूमाह यहोवा देरी तो एक एक वोच आहने आवी; एने जी वोचीह यहोवा देरी ता कुटूम कुटूम आहने आवी; ओवतो जा कुटूमाह यहोवा देरी ता एक एक एदमी आहने आवी। <verse eid="JOS 7:14" /><verse number="15" style="v" sid="JOS 7:15" />तेवी जो एदमी बेट किरेल चिज मेल रियेल देराय जाय, तो एने जो काय तान एय आखो आक्‍ठाम टाकीन हेलगाड़ाय जाय; काहाकाय तो बोगवानान वाचाह तुड़ेल हे, एने इस्राएल माय खाराब काम किरेल हे।”<verse eid="JOS 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 7:16" />यहोशु उठ्यान विगोस उठीन इस्राएल ने आखा माणहाह बोगवानान सामने ली गीयो, आखा कुटूमे बोगवानान सामने उबरी गीया; तेवी यहुदान कुटूम देराय गीयो। <verse eid="JOS 7:16" /><verse number="17" style="v" sid="JOS 7:17" />तेवी यहोशु यहुदान कुटूमाह सामने लावो, तेवी जेरह वोचीन कुटूम देराय गीयो; ओवतो जेरह वोचीन कुटूमान एक एक एदम्याह सामने लावो, तेवी जब्दीन कुटूम देराय गीयो; <verse eid="JOS 7:17" /><verse number="18" style="v" sid="JOS 7:18" />तेवी यहोशु तान कुटूमान एक एक एदम्याह सामने लावो, तेवी यहुदान वोचीन आकान, जो जेरह वोचीन जब्दीन नातण्‍योख एने कर्मीन बिटोख इतो, देराय गीयो। <verse eid="JOS 7:18" /><verse number="19" style="v" sid="JOS 7:19" />तेवी यहोशु आकानाह केयो, “एय मारा बेटा, इस्राएल ने बोगवान यहोवान आदार केर, एने तान ओंगाण कबुल केर; एने जो काय तु किरेल हे तो माहु केय दे, एने माहु से काय मा लिकाड़े।”<verse eid="JOS 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JOS 7:20" />आकान यहोशुह जापाप आप्यो, “खेरीच मी इस्राएल ने बोगवान यहोवान विरूद पाप किरेल हे, एने इहकेरीन मी किरेल हे, <verse eid="JOS 7:20" /><verse number="21" style="v" sid="JOS 7:21" />काय जेवी माहु लुटी माय शिनार देसान एक जुलूम हाजा फाड़का, एने दुय किलो चांदी, एने आदो किलो होनान एक ईटड़ो देखानो, तेवी मी तान लालेच केरीन ताह मेल लिदो; ता मारा तोम्बु माय बुयी माय गाड़ेल हेते, एने आखान बुंदे चांदी हे।”<verse eid="JOS 7:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 7:22" />तेवी यहोशु थोड़ाक माणहाह तोम्बु माय मोकल्‍यो, एने ता दोवड़ीन पोचना एने त्यु चिजुह तोम्बु माय गाड़ेल देख्या, एने आखान बुंदे चांदी हे। <verse eid="JOS 7:22" /><verse number="23" style="v" sid="JOS 7:23" />त्युह ता तोम्बुम रेन निकालीन यहोशु एने इस्राएल ने आखा माणहा फाय लावीन बोगवानान सामने मेल देना। <verse eid="JOS 7:23" /><verse number="24" style="v" sid="JOS 7:24" />तेवी यहोशु एने आखा माणहे जेरहान बिटोख आकानाह एने ता हेऱ्या ती चांदी एने फाड़का एने होनान ईटड़ाह, एने तान बेटा बेट्युह, एने तान बुयेल, गेदड़ा एने मेंड्रा बोकड्याह, एने तान तोम्बुह, एने जो काय तान एतो ता आखाह आकोर नावान गाटाम ली गीया। <verse eid="JOS 7:24" /><verse number="25" style="v" sid="JOS 7:25" />तेवी यहोशु आकानाह केयो, “तु आमुह काहा तेकलीत आपेल हे? आजीन दिह बोगवान तुवाह तेकलीत आपी।” तेवी आखा इस्राएली माणहे ताह देगड़ाठ्या; एने ताह आक्‍ठाम टाकीन हेलगाड्या, एने तान उपेर दिगोड़ टाक देना। <verse eid="JOS 7:25" /><verse number="26" style="v" sid="JOS 7:26" />एने ता तान उपेर देगड़ान मोटलो डिग लागाड़ देना जो आज वोर बोणेल हे; तेवी बोगवानान बोड़केल राग ओलाय गीयो।</para>
  <para style="p" vid="JOS 7:26">केरीन ता जागान नाव आज वोर आकोर <note caller="+" style="f"><char style="fr" closed="false">7:26 </char><char style="fq" closed="false">आकोर </char><char style="ft" closed="false">दुख आपणार गाट</char></note>गाट पुड़ेल हे।<verse eid="JOS 7:26" /></para>
  <chapter eid="JOS 7" />
  <chapter number="8" style="c" sid="JOS 8" />
  <para style="s">आई गावा पोर ताबो एने खेतेम केरने</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 8:1" />तेवी बोगवान यहोशुह केयो, “मा बिय, ईमोत मा सोड़ो, तुमरा आखा सिपायाह आई गावा माय ली जा; मी आईन राजाह आरेवणे माय तुमरी मोदेक केरूह। मी तान माणहाह, एने तान हेयराह एने तान देसा बेल तार ताबाम केर दिनोह। <verse eid="JOS 8:1" /><verse number="2" style="v" sid="JOS 8:2" />एने जीहे तु यरीहो एने तान राजा हिऱ्यो किरेल तिहेच केरीन आय गाव एने तान राजा हिऱ्यो बी किरज्ये; फोक्‍ता तुमू जेनवारा बेल तान लुट ते तुमरी केरता लेय सिकहो; केरीन तुमू तुमरा थोड़ाक एदम्याह हेयरान पासाण लिकणेन उकुम आपो।”<verse eid="JOS 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JOS 8:3" />केरीन यहोशु तान पुरी सेना बेल आय पोर चेड़ाय केरनेन तियारी किऱ्यो; एने यहोशु हाजाला तीस एजार सिपाय निवाड़ीन रातीस उकुम आपीन मोकल्‍यो। <verse eid="JOS 8:3" /><verse number="4" style="v" sid="JOS 8:4" />एने ताह उकुम आप्यो, “हुमलो, तुमू हेयरान पासाणले उगे जाएन चेड़ाय केरनेन केरता लीकाय रिज्यो; हेयराह रेन जुलूम सेटा मा जाहो, एने आखान आखा तियार रिज्यो; <verse eid="JOS 8:4" /><verse number="5" style="v" sid="JOS 8:5" />एने मी मारा आखा हाती हिऱ्यो ता हेयरान आहने जाह। एने जेवी ता पेलुन गेत आमरी पोर चेड़ाय केरनेन आवती, तेवी आमु तान सामने रेन दोवेड़ने बाज जाहु; <verse eid="JOS 8:5" /><verse number="6" style="v" sid="JOS 8:6" />तेवी ता ज्‍य सोचीन काय ता पेलुन गेत आपणे सामने रेन नाहणे बाजरेनाह, आमरी पासाण पोड़ती; इहकेरीन आमु तान सामने रेन नाहीन ताह हेयराम रेन सेटा निकाल ली जाहु; <verse eid="JOS 8:6" /><verse number="7" style="v" sid="JOS 8:7" />तेवी तुमू तुमरे लिकणेन जागे रेन उठीन गावाह तुमरे आदिकार माय केर लिज्यो; काहाकाय तुमरो बोगवान यहोवा ताह तुमरा आथाम केर देय। <verse eid="JOS 8:7" /><verse number="8" style="v" sid="JOS 8:8" />एने जेवी हेयराह तुमरे ताबाम केर लिहो, ताहार हेयराम आक्‍ठो लागाड़ दिज्यो, तुमू बोगवानान वचनान गेत इहीच केरीन किरज्‍यो; मी तुमूह उकुम आपेल हे।” <verse eid="JOS 8:8" /><verse number="9" style="v" sid="JOS 8:9" />तेवी यहोशु ता सैनिकाह तान लिकणेन जागा पोर मोकील दिनो एने वाट जोवणे बाज गीयो, ता बेतेला निही आईन विचीवालो एक जागे गीया, ज्‍यो जागो आईन पश्‍चिम माय इतो।<verse eid="JOS 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 8:10" />यहोशु वेगोस उठीन माणहाह एकठा किऱ्यो, एने इस्राएल ने मुखी सिपाया हिऱ्यो ओंगाण ओंगाण आई हेयरान उगे निकल्‍या। <verse eid="JOS 8:10" /><verse number="11" style="v" sid="JOS 8:11" />यहोशुन आखा सिपाय आई हेयरा पोर चेड़ाय केऱ्या, एने आई हेयरान आहने पोचीन तान सामने उत्तर उगे पाड़ावो टाक देना, तान एने आईन विचीम एक खोय एती। <verse eid="JOS 8:11" /><verse number="12" style="v" sid="JOS 8:12" />तेवी यहोशु कोमीत कोमी पाच एजार सैनिकाह निवाड़ीन बेतेल एने आईन विचीम हेयरान पश्‍चिम उगे लिकणेन केरता मोकील दिनो। <verse eid="JOS 8:12" /><verse number="13" style="v" sid="JOS 8:13" />इहकेरीन यहोशु सैनिकाह लेड़ाय ने केरता तियार किरेल इतो, मुखी पाड़ावो हेयरान उत्तर माय इतो; दिहरा सिपाय पश्‍चिम माय लीक रियेल एता, तेवी यहोशु तीस राती खोयरान विचीम रात निकाल्यो। <verse eid="JOS 8:13" /><verse number="14" style="v" sid="JOS 8:14" />जेवी आईन राजा ज्‍य देख्यो, तेवी तो एने तान हेयरावाला आखा माणहे वेगास उतवाल्‍याह उठीन इस्राएल ने सिपाया हिऱ्यो लेड़ानेन केरता यरदन मोयदाना उगे जो अराबान सामने हे गीया। पुण ताह मालुम नाह एतो काय हेयरान पासाण माणहे लेड़ाणेन केरता लीक रेनाह। <verse eid="JOS 8:14" /><verse number="15" style="v" sid="JOS 8:15" />तेवी यहोशु एने आखा इस्राएली ताह रेन आरवाय गीयाह, ज्‍य बाहानो केरीन उजाड़ीन वाट देरीन नाहणे बाज गीया। <verse eid="JOS 8:15" /><verse number="16" style="v" sid="JOS 8:16" />तेवी हेयरान आखा माणहे इस्राएलीन पासाण पोड़नेन केरता आयड़ीन हादाय गीया; एने ता यहोशुन पासाण पुड़ते लेन हेयराह रेन सेटा निकील गीया। <verse eid="JOS 8:16" /><verse number="17" style="v" sid="JOS 8:17" />एने आई हेयरा माय एने बेतेल हेयरा माय काल्लोस एदमी नाह रिनो, जो इस्राएली माणहान पासाण पोड़ने नाह गीयो एय; ता हेयराह हुनालो सोड़ीन इस्राएलीन पासाण पोड़ना।<verse eid="JOS 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JOS 8:18" />तेवी यहोवा यहोशुह केयो, “तारा आथावालो बोरशो आई हेयरान उगे केर; काहाकाय मी ताह तार आथाम केर देह।” एने यहोशु तान आथावालो बोरशाह हेयरान उगे किऱ्यो। <verse eid="JOS 8:18" /><verse number="19" style="v" sid="JOS 8:19" />यहोशुन आथ ओंगाण केरतास जा माणहे लेड़ाणेन केरता लीक रियेल एता, ता उतवाल्‍याह तान जागे रेन उठना; एने दोवड़ीन हेयराम रिगना एने ताह तान आदिकार माय केर लेदा; एने चालोस हेयराम आक्‍ठो लागाड़ देना। <verse eid="JOS 8:19" /><verse number="20" style="v" sid="JOS 8:20" />जेवी आई हेयरान एदमी पासाण फिरीन देख्या, काय हेयरान दुवाड़ो जुगाम जातालो ताह देखानो, तेवी ताह नाह ओरो नाहणेन ताकेत रेनी, एने नाह पोरो नाहणेन, एने जा माणहे जेंगला निही नाहताला ता फिरीन तान पासाण पोड़नारा पोर टुट पोड़ना। <verse eid="JOS 8:20" /><verse number="21" style="v" sid="JOS 8:21" />जेवी यहोशु एने तान सिपाय देख्या काय तान सेना हेयरा पोर आदिकार केर लियेल हेते, तान हेयराम रेन दुवाड़ो उपेर जातालो देख्या; तुलबुखे ता दोवेड़ने बोंद केर देना, एने पासाण फिरीन आई हेयरान एदम्याह मारने बाज गीया। <verse eid="JOS 8:21" /><verse number="22" style="v" sid="JOS 8:22" />तेवी ता सिपाय जा लिकायेल एता, लेड़ाय केरनेन केरता हेयराम रेन बाहेर निकील आवा; आई हेयरान सैनिकान ओंगाण एने पासाण इस्राएल ने सिपाय एता, आईन सिपाय फोस जायेल एता, इस्राएल ताह आरीव देना, ता ताह वोर लेड़ाते रेना जाह वोर आईन एक बी एदमी जीवतालो नाह रिनो, ताम रेन कुण नाहीन गीयो नाह। <verse eid="JOS 8:22" /><verse number="23" style="v" sid="JOS 8:23" />एने आई हेयरान राजाह ता जीवतालो देरीन यहोशु फाय लेन आवा।<verse eid="JOS 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 8:24" />एने जेवी इस्राएली आईन आखा माणहाह चोवगानाम, मतलब ता जेंगलाम जाहरी ता तान पासाण पुड़ेल एता, मारनेन काम पुरो केऱ्या, एने ता आखान आखा तालवार केरीन माराय गीया; तेवी इस्राएल ने आखा सिपाय आई हेयराम वोलीन आवा, तेवी सिपाय ता माणहाह जा हेयराम जीवताला एता, मार देना। <verse eid="JOS 8:24" /><verse number="25" style="v" sid="JOS 8:25" />एने बायकु एदमी, आखा मिलीन जा ते दिह माराय जायेल ता बारा एजार एता, एने आई हेयरान आखा बायकु एदमी ओलास एता। <verse eid="JOS 8:25" /><verse number="26" style="v" sid="JOS 8:26" />काहाकाय जाह वोर यहोशु आई हेयरान माणहाह खेतेम नाह केर दिनो ताह वोर तो तान आथ, जा केरीन बोरशो ओंगाण किरेल इतो, पोशो पासाण नाह किऱ्यो। <verse eid="JOS 8:26" /><verse number="27" style="v" sid="JOS 8:27" />बोगवानान ता उकुमान गेत जो तो यहोशुह आपेल इतो, इस्राएली ता हेयरावाला पालन्या जेनवार सोब हेयरान लुट सोतान केरता लेय लेदा। <verse eid="JOS 8:27" /><verse number="28" style="v" sid="JOS 8:28" />तेवी यहोशु आई हेयराह हेलगाड़ दिनो, तो हियोर हुनाला देगड़ान डिग बोण गीयो; जो आज बी उजाडुस हे। <verse eid="JOS 8:28" /><verse number="29" style="v" sid="JOS 8:29" />यहोशु आईन राजाह एक जाड़ा पोर फासी लागाड़ीन टांग दिनो, तो ताह हांज पोर वोर जाड़ा पोर टांग मिल्यो; एने दिह बुड़ता बुड़ता यहोशुन उकुम से तान देड़ जाड़ा पोर रेन उतारीन हेयरान फाटेक ने सामने जुगार देना, एने ता पोर देगड़ान मोटलो डिग वाल देना, जो आज वोर ताहरी हे।<verse eid="JOS 8:29" /></para>
  <para style="s">एबाल बोयड़ा पोर नेम वाचीन होमलाड़ ने</para>
  <para style="p">
    <verse number="30" style="v" sid="JOS 8:30" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8:30 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 27:2-8">व्यवस्था 27:2-8</ref>
      </char>
    </note>तेवी यहोशु इस्राएल ने बोगवान यहोवान केरता एबाल बोयड़ा पोर एक वेदी बाणायो, <verse eid="JOS 8:30" /><verse number="31" style="v" sid="JOS 8:31" /><note caller="+" style="x"><char style="xo" closed="false">8:31 </char><char style="xt" closed="false"><ref loc="EXO 20:25">निर्गमन 20:25</ref></char></note> जिहकेरीन बोगवानान सेवक मुसो इस्राएल ने माणहाह कियेल इतो काय वेदी किहीक बाणावी, केरीन यहोशु वेदीह तिहेच केरीन बाणायो जीह केरीन मुसान नेमान पुस्तेक माय सोमजाड़ेल एतो काय, वेदी बिगेर काटायेल देगड़ा केरीन बोणेल एती। ता देगड़ा पोर केदी एगदा आथ्‍यारान वापेर नाह ईयेल, ता ती वेदी पोर बोगवानाह होमबोली एने मेल मिलाप बोली चेड़ाया। <verse eid="JOS 8:31" /><verse number="32" style="v" sid="JOS 8:32" />ता जागा पोर यहोशु मुसान नेमाह देगड़ा पोर तो ज्‍य इस्राएल ने आखा माणहाह देखणेन केरता किऱ्यो। <verse eid="JOS 8:32" /><verse number="33" style="v" sid="JOS 8:33" />एने ता काय देसावाला काय पाराया देसावाला, आखा इस्राएली तान डावाला माणहे, आदिकारी एने नियाव केरनारा बेल यहोवान वाचान पेटी विसणारे लेवीय चाकऱ्यान सामने ता पेटीन जीवड़े उगे एने डाखऱ्ये उगे उब रेना, मतलब थोड़ाक माणहे ते गिरीजीम बोयड़ान सामने एने थोड़ाक एबाल बोयड़ान सामने उब रेना, जीह केरीन यहोवान सेवक मुसा पेल उकुम आपेल इतो, काय इस्राएली माणहाह बोरकेत आपीन जाय। <verse eid="JOS 8:33" /><verse number="34" style="v" sid="JOS 8:34" />तान बाद यहोशु बोरकेत एने हारापान नेमान आखा वचन, जीहे-जीहे नेमान पुस्तेक माय लेखायेल हेते, तिहे-तिहे वास वाचीन होमलाड़ दिनो, <verse eid="JOS 8:34" /><verse number="35" style="v" sid="JOS 8:35" />जोल्‍युक वातुन मुसो उकुम आपेल इतो, ताम रेन काल्ली ओहली वात नाह रेय गियी जो यहोशु इस्राएल ने आखी सोबा, एने बायकु एने सोरा, एने ता हेऱ्या रेणारे दिहरा देसावाला माणहान सामने बी वाचीन होमलाड्यो।<verse eid="JOS 8:35" /></para>
  <chapter eid="JOS 8" />
  <chapter number="9" style="c" sid="JOS 9" />
  <para style="s">गिबोनीन यहोशुह दुको देणे</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 9:1" />यरदन नेदीन पश्‍चिम वाला एक एक राजा ज्यी गेटनान बाराम होमल्या, ज्या हित्ती, एमोरी, कनानी, परिज्जी, हिववी, एने यबूसी माणहान राजा एता; ता बोयड़ावाला देसाम एने चोवगानाम रेताला, एने लबानोन ने देरीयान देड़े रेताला। <verse eid="JOS 9:1" /><verse number="2" style="v" sid="JOS 9:2" />ता आखा राजा एकठा टोलवाना, ता यहोशु एने इस्राएल ने माणहा हेऱ्या लेड़ाणेन योजना बाणाया।<verse eid="JOS 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JOS 9:3" />जेवी गीबोन ने माणहे ती गेटनान बाराम होमल्या काय यहोशु यरीहो एने आई हेयरा हिऱ्यो काय काय किरेल इतो। <verse eid="JOS 9:3" /><verse number="4" style="v" sid="JOS 9:4" />केरीन ता इस्राएल ने माणहाह दुको देणेन ठेराया, ता वाटीन केरता रूटो तियार केर लेदा, एने राजदुतान वेह बाणावीन तान गेदड़ा पोर जुनाला गोंटा, एने जुनाला फाटील एने ठिगला लागाड़ेल अंगुरान बाटल्यु लाद्या; <verse eid="JOS 9:4" /><verse number="5" style="v" sid="JOS 9:5" />एने ता तान पायाम थिगला लागेल जुनाला खाहड़ा पेर लेदा, एने डिला पोर जुनाला फाड़का पेर लेदा; एने तान खाणेन केरता हुकेल बुरठायेल रोटा लेय लेदा। <verse eid="JOS 9:5" /><verse number="6" style="v" sid="JOS 9:6" />तेवी ता गीलगाल ने पाड़ावा माय यहोशु फाय जाएन ताह एने इस्राएली एदम्याह केया, “आमु सेटाले देस रेन आयेल हेते; केरीन एवी तुमू आमरी हेऱ्या वाचा बांदो।”<verse eid="JOS 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 9:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">9:7 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 23:32">निर्गमन 23:32</ref>; <ref loc="EXO 34:12">34:12</ref>; <ref loc="DEU 7:2">व्यवस्था 7:2</ref></char>
    </note> इस्राएली एदमी ता हिववीह केया, “काय जाणु तुमू आमरे विची मायच रेतेती; ओवता आमु तुमरी हेऱ्या वाचा किहीक बांदे?”<verse eid="JOS 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 9:8" />हिव्‍वी माणहे यहोशुह केया, “आमु तारा सेवेक हेते।” तेवी यहोशु ताह केयो, “तुमू कुण हेते?”<verse eid="JOS 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 9:9" />ता यहोशुह केया, “आमु तारा सेवेक हेते, आमु एक जुलूम सेटाला देस रेन आयेल हेते; आमु ज्यानकेरता आयेल काय आमु तुमरा बोगवान यहोवान मोटली ताकेतीन बाराम होमलेल हेते। आमु तो आखो होमलेल हेते, जो तो मिस्र माय किरेल। <verse eid="JOS 9:9" /><verse number="10" style="v" sid="JOS 9:10" /><note caller="+" style="x"><char style="xo" closed="false">9:10 </char><char style="xt" closed="false"><ref loc="NUM 21:21-35">गिनती 21:21-35</ref></char></note>एने आमु ज्‍य बी होमल्या काय तो यरदन नेदीन ती पार पुर्व दिशा माय दुय एमोरी माणहान राजाह आरव्‍यो, हेशबोन ने राजा सीहोन एने अशतारोतान देसाम बाशान ने राजा ओग एता। <verse eid="JOS 9:10" /><verse number="11" style="v" sid="JOS 9:11" />तेवी आमरा डायडाया माणहे एने आमरा देसाम रेणारे आखा माणहे आमुह केया, वाटीन केरता तुमरी हेऱ्या खाणो लेन ताह मिलने जावो, एने ताह किज्यो काय आमु तुमरा सेवक हेते; केरीन एवी तुमू आमु हेऱ्या वाचा बांदो। <verse eid="JOS 9:11" /><verse number="12" style="v" sid="JOS 9:12" />आमरा रोटा दिखो! आमु गेर रेन तुमरी फाय आवणेन निकल्‍या तेवी ज्या ताताला एने ताबाला एता; पुण एवी दिखो, आज ज्या हुक जायेल हेते, एने न्या माय बुरठी लाग जायेल हे। <verse eid="JOS 9:12" /><verse number="13" style="v" sid="JOS 9:13" />एने जा अंगुर ने रूहान बाटल्यु आमु बोर लियेल एता, तेवी त्यु नोवाल्‍यु एत्यु, पुण एवी त्यु फाट जायेल हेत्यु; एने आमरा ज्या फाड़का एने खाहड़ा जुलूम लांब यात्रान वोजेसे जुनाला एय जायेल हेते।”<verse eid="JOS 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 9:14" />तेवी इस्राएल ने माणहे बोगवानाह बिगेर फुसीन खाणा माय रेन थोड़ोक लेय लेदा। <verse eid="JOS 9:14" /><verse number="15" style="v" sid="JOS 9:15" />तेवी यहोशु ता हिऱ्यो मेल केरीन ताह जीवतालो सोड़ देणेन वाचा बांद्यो एने मोंडलीन मुखी माणहे यहोशु से सुगोण खादा।<verse eid="JOS 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 9:16" />एने ता हेऱ्यी वाचा बांदणेन तीन दिह्यान बाद इस्राएल ने माणहाह मालुम पोड़नो काय, ज्या आपणे आहेंल्या एन आपणे विचीम रेणारे हेते। <verse eid="JOS 9:16" /><verse number="17" style="v" sid="JOS 9:17" />केरीन इस्राएल ने माणहे तीसरे दिह ताहरी गीया, जाहरी ता माणहे रेताला, इस्राएल ने माणहे गीबोन, कपीरा, बेरोत एने किर्यत्यारीम हेयराम आवा। <verse eid="JOS 9:17" /><verse number="18" style="v" sid="JOS 9:18" />पुण इस्राएल ने माणहे ताह नाह माऱ्या, काहाकाय मोंडलीन मुखी माणहे इस्राएल ने बोगवान यहोवान सुगोण खायेल एता। तेवी आखी मोंडलीन माणहे मुखी माणहान विरूद कुरकुर केरने बाज गीया। <verse eid="JOS 9:18" /><verse number="19" style="v" sid="JOS 9:19" />तेवी आखा मुखी माणहे आखी मोंडलीह केया, “आमु तान सामने इस्राएल ने बोगवान यहोवान सुगोण खायेल हेते, केरीन एवी ताह सापेल नाह सेकते। <verse eid="JOS 9:19" /><verse number="20" style="v" sid="JOS 9:20" />आपु ता हेऱ्या ज्‍योस केरहु काय ताह जीवताला सोड़ देहु, केदी ओहलो नाय एय काय ता खायेल सुगोणान वोजेसे आमु पोर बोगवानान राग बोड़ेक उठे।” <verse eid="JOS 9:20" /><verse number="21" style="v" sid="JOS 9:21" />मुखी ताह उंजु केया, “केरीन ताह जीवताला रेणे दिवो, ता आपणी केरता लाकड़े काटती एने आपणे आखान केरता पाणी बोरती।”<verse eid="JOS 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 9:22" />यहोशु ताह हादिन केयो, “तुमू आमरे विचीम रेते लेन आमु जुलूम सेटाला हेते, इहकेरीन केन आमुह काहा ठिगेल? <verse eid="JOS 9:22" /><verse number="23" style="v" sid="JOS 9:23" />केरीन एवी तुमूह इहकेरीन हाराप हे, एने तुमरे माय रेन ओहलो कुण नाय रेय जो सेवक, मतलब मारा बोगवानान गेरान केरता लाकड़ा तोड़णारे एने पाणी बोरणारे रेती।”<verse eid="JOS 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 9:24" />गीबोनी माणहे यहोशुह जापाप आप्या, “आमु तुवाह जुठ बोल्या काहाकाय आमुह बिय एती काय तु आमुह ते नाय मार देय, आमु होमलेल काय बोगवान तान सेवक मुसाह ज्‍यो उकुम आपेल इतो काय ता तुमूह ज्‍यो आखो देस आप देय, एने बोगवान तुमूह ता देसाम रेणाराह आखा माणहाह मारनेन कियेल; केरीन आमु तुवाह ठिगेल। <verse eid="JOS 9:24" /><verse number="25" style="v" sid="JOS 9:25" />एने एवी आमु तारा ताबाम हेते, जोहलो वेवार तुवाह ठिक लागे, तोहलोच वेवार आमरी हिऱ्यो केर।” <verse eid="JOS 9:25" /><verse number="26" style="v" sid="JOS 9:26" />केरीन गीबोन ने माणहे सेवक बोण गीया, पुण यहोशु तान जीवाय वोचाड्यो; यहोशु इस्राएल ने माणहाह ताह मारने नाह दिनो। <verse eid="JOS 9:26" /><verse number="27" style="v" sid="JOS 9:27" />पुण यहोशु ते दिहस मोंडलीन केरता, एने जो जागो यहोवा निवाड़ लेय ताम तान वेदीन केरता, लाकड़े काटणारे एने पाणी बोरनारे निवाड़ केर दिनो, जीहे आज वोर हे।<verse eid="JOS 9:27" /></para>
  <chapter eid="JOS 9" />
  <chapter number="10" style="c" sid="JOS 10" />
  <para style="s">एमोरी पोर जिक</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 10:1" />जेवी यरूशलेम ने राजा अदोनीसेदेक होमल्यो काय यहोशु आई हेयराह जिक लियेल हे, एने ताह खेतेम केर दियेल हे, एने जीहे तो यरीहो एने तान राजा हिऱ्यो किरेल इतो, तिहेच केरीन आई हेयराह एने तान राजा हिऱ्यो बी किरेल हे, एने ज्‍य बी होमल्यो काय गीबोन माय रेणारे, इस्राएल हेऱ्या मेल केरीन तान विचीम रेणे बाजरेनाह। <verse eid="JOS 10:1" /><verse number="2" style="v" sid="JOS 10:2" />तेवी अदोनिसीदेकाह जुलूम बिय गीयो, काहाकाय गीबोन ज्‍यो मोटलो हियोर एन एगदा राजवाड़ान गेत एने आई हेयराह रेन मोठो एतो, एने ताम आखा रेणारे एदमी ताकेतवोर एता। <verse eid="JOS 10:2" /><verse number="3" style="v" sid="JOS 10:3" />केरीन यरूशलेम ने राजा अदोनीसेदेक हेब्रोन ने राजा होहाम, यर्मुत ने राजा पिराम, लाकीश ने राजा यापी, एने एग्लोन ने राजा दबीर फाय ज्‍य केय मोकल्‍यो, <verse eid="JOS 10:3" /><verse number="4" style="v" sid="JOS 10:4" />“मार फाय आवीन मारी मुदेक किरो! आपु मिलीन गीबोनाह आरवहु, काहाकाय तो यहोशु एने इस्राएली हिऱ्यो मेल केर लियेल हे।” <verse eid="JOS 10:4" /><verse number="5" style="v" sid="JOS 10:5" />केरीन एमोरीन पाच राजा मतलब यरूशलेम, हेब्रोन, यर्मुत, लाकीश एने एग्लोनान राजा एकठा एन एने आप आपणी सेना हेऱ्या गीबोन ने आहने पाड़ावो टाकीन ता हेऱ्या लेड़ाणे बाज गीया।<verse eid="JOS 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 10:6" />तेवी गीबोन ने माणहे गीलगाल ने पाड़ावाम यहोशुह खोबेर केय मोकल्या, “आमु तारा सेवक हेते! आमुह एखालास मा सोड़े; आमरी फाय उतवाल्‍युह आवीन आमुह वोचाड़ ले, एने आमरी मोदेक केर; काहाकाय बोयड़ा पोर रेणारे एमोरीन आखा राजा आमरे विरूद एकठा एय जायेल हेते।”<verse eid="JOS 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 10:7" />तेवी यहोशु तान आखा सिपाय एने आखा हाजाला सैनिकाह लेन लेड़ाणेन केरता गीलगाल रेन चाल पोड़नो। <verse eid="JOS 10:7" /><verse number="8" style="v" sid="JOS 10:8" />एने बोगवान यहोशुह केयो, “ताह बिय मा; काहाकाय मी ताह तार आथाम केर दियेल हे; ताम रेन एक एदमी बी तार सामने टिक नाय सेकी।” <verse eid="JOS 10:8" /><verse number="9" style="v" sid="JOS 10:9" />तेवी यहोशु गीलगाल रेन रात बोर चालीन उचकाहुस ता पोर हामलो किर दिनो। <verse eid="JOS 10:9" /><verse number="10" style="v" sid="JOS 10:10" />एने बोगवान ती सेनाह, इस्राएली सेनान द्वारा ताह आरवीन मोटली जिक आप्यो, एने तो गीबोन ने आहने जुलूम जाणाह मारीन बेथोरोनान चेड़ाव पोर तान पासाण पोड़ीन अजेका एने मक्केदा वोर ताह मारते गीया। <verse eid="JOS 10:10" /><verse number="11" style="v" sid="JOS 10:11" />ओवता जेवी ता इस्राएलीन सामने रेन नाहीन बेथोरोन ने उतेरती पोर आवा, तेवी अजेका पोचणे वोर बोगवान जुगाम रेन मोट-मोटला गारा ता पोर पाड्यो, एने ता मोर गीया; जा गारा केरीन माराय गीया, तान गेणती इस्राएल माणहे तालवारी केरीन मारेल ताह रेन वोदार एती।<verse eid="JOS 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 10:12" />बोगवान एमोरीह इस्राएल माणहान ताबाम केर दिनो, केरीन यहोशु इस्राएलीन सामने यहोवाह केयो,</para>
  <para style="p" vid="JOS 10:12">“एय दिह, तु गीबोन पोर, एने एय चांद, तु अयालोन ने गाटान उपेर उब रे।”<verse eid="JOS 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 10:13" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:13 </char>
      <char style="xt" closed="false">
        <ref loc="2SA 1:18">2 शमुएल 1:18</ref>
      </char>
    </note>एने दिह तुलबुखे वोर थोब रिनो; एने चांद तुलबुखे वोर थोब रिनो, जाह वोर ती जातीन माणहे तान दुसमोना हेऱ्या बोदलो नाह लेदा। काय ज्यी वात याशार नावान पुस्तेक माय नाह लिखेल सोती? काय दिह जुगान विचीम थोब रिनो, एने कोमीत कोमी पुरो दिह थोब रिनो। <verse eid="JOS 10:13" /><verse number="14" style="v" sid="JOS 10:14" />ओहलो दिह तान पेल नाहते तान पासाण आवो नाह; ते दिह बोगवान माणहान विन्ता होमल्यो, काहाकाय बोगवान इस्राएल ने माणहान केरता लेड़तालो।<verse eid="JOS 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 10:15" />ओवतो यहोशु आखा इस्राएली माणहा हिऱ्यो गीलगाल वाला पाड़ावाम पोशो आवतरनो।<verse eid="JOS 10:15" /></para>
  <para style="s">एमोरीन पाच राजाह बोंदी बाणावाय जाणो</para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 10:16" />लेड़ाय ने बुखेत पाचु राजा नाहीन ता मक्केदान आहनेवाली गुफा माय लीकाय गीया। <verse eid="JOS 10:16" /><verse number="17" style="v" sid="JOS 10:17" />तेवी यहोशुह ज्यी खोबेर जुड़नी, पाचु राजा मक्केदान आहनेवाली गुफा माय लिकायेल आमुह जुड़नाह। <verse eid="JOS 10:17" /><verse number="18" style="v" sid="JOS 10:18" />यहोशु केयो, “गुफान मुयाला पोर मोट मोटला दिगोड़ देन, थोड़ाक एदम्याह गुफान राखवालीन केरता ताहरी मीलो। <verse eid="JOS 10:18" /><verse number="19" style="v" sid="JOS 10:19" />पुण तुमू ताहरी मा थोबो, तुमरा दुसमोनान पासाण पोड़ीन ताम रेन जा जा पासाण रेय जायेल हेते ताह मार दिवो, ताह तान हेयराम पोचणे मा दिवो; काहाकाय तुमरो बोगवान यहोवा ताह तुमरा आथाम केर दियेल हे।” <verse eid="JOS 10:19" /><verse number="20" style="v" sid="JOS 10:20" />इहकेरीन यहोशु एने इस्राएल ने माणहे पुरा दुसमोनाह मार देना; एने ताम रेन जा वोच गीया ता आप आपणा किल्लावाला हेयराम जाएन लीक गीया। <verse eid="JOS 10:20" /><verse number="21" style="v" sid="JOS 10:21" />तेवी आखा माणहे मक्केदान पाड़ावाम हाजे हुके यहोशु फाय आवतरना; एने इस्राएल माणहान विरूद कुण काय नाह केयो।<verse eid="JOS 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 10:22" />तेवी यहोशु केयो, “गुफान मुयालो उगाड़ीन ता पाच राजाह ता रेन मार फाय लेन आवो।” <verse eid="JOS 10:22" /><verse number="23" style="v" sid="JOS 10:23" />केरीन यहोशुन माणहे पाचु राजाह गुफाम रेन बाहेर लावा, ज्या पाचु यरूशलेम, हेब्रोन, यर्मुत, लाकीश, एने एग्लोनान राजा एता। <verse eid="JOS 10:23" /><verse number="24" style="v" sid="JOS 10:24" />जेवी ता राजाह यहोशु फाय लेन आवा, तेवी यहोशु इस्राएल ने आखा एदम्याह हाद्यो, एने यहोशु सेनान आदिकारीह केयो, “न्या आवो! न्या राजान बोची पोर तुमरा पाय मीलो।” केरीन यहोशुन सेनान आदिकारी आहने आवा; ता राजान बोची पोर तान पाय मेल्या। <verse eid="JOS 10:24" /><verse number="25" style="v" sid="JOS 10:25" />तेवी यहोशु तान सैनिकाह केयो, “मोजबुत एने ईमोत किरो! बिवो मा, काहाकाय जा हेऱ्या तुमू लेड़ाहो ता तुमरा आखा दुसमोनान बोगवान इहीच केरीन केरी।” <verse eid="JOS 10:25" /><verse number="26" style="v" sid="JOS 10:26" />तेवी यहोशु पाचु राजाह मारावीन पाच जाड़ा पोर ताह टांग दिनो, एने ता हांज पोर वोर ता जाड़ा पोर टांगायेल रेना। <verse eid="JOS 10:26" /><verse number="27" style="v" sid="JOS 10:27" />दिह बुड़ता-बुड़ता यहोशु तान माणहाह देड़ाह जाड़ा पोर रेन उतारनेन केयो, ता उतारीन तीस गुफाम जाहरी ता लीक जायेल एता टाक देना, एने ती गुफान मुयाला पोर मोट-मोटला दिगोड़ मेल देना, ता आज वोर तास मेलायेल हेते।<verse eid="JOS 10:27" /></para>
  <para style="s">यहोशुन एमोरी राज्या पोर जिक</para>
  <para style="p">
    <verse number="28" style="v" sid="JOS 10:28" />ते दिह यहोशु मक्केदाह आरव्‍यो, यहोशु राजाह एने ता हेयरान माणहाह तालवार केरीन मार दिनो; तो कुणीह बी जीवतालो नाह मिल्यो, यहोशु मक्केदान राजा हिऱ्यो बी तोस किऱ्यो जो तो यरीहोन राजा हिऱ्यो किरेल इतो।<verse eid="JOS 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JOS 10:29" />तेवी यहोशु आखा इस्राएलीह आरही लेन मक्केदा रेन चालीन लीबना गावा माय गीयो, एने लीबना हिऱ्यो लेड़ानो; <verse eid="JOS 10:29" /><verse number="30" style="v" sid="JOS 10:30" />यहोवा इस्राएल ने माणहाह तो हियोर एने तान राजाह आरेवणे दिनो, इस्राएल ने माणहे ता हेयरान एक एक माणहाह तालवार केरीन मार दिनो; ताहरी कुणाह बी जीवतालो नाह मिल्यो, एने माणहे राजा हेऱ्या तोस केऱ्या जा ता यरीहोन राजा हेऱ्या किरेल एता।<verse eid="JOS 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JOS 10:31" />ओवतो यहोशु एने आखा इस्राएली माणहे लीबना गावाम रेन चालीन लाकीश गीया, एने तान आहने पाड़ावो टाकीन ता हेऱ्या लेड़ाना। <verse eid="JOS 10:31" /><verse number="32" style="v" sid="JOS 10:32" />एने यहोवा लाकीशाह इस्राएल ने आथाम केर दिनो, दिहरे दिह तो ता हेयराह आरीव दिनो; इस्राएल ने माणहे लीबनान माणहाह तालवार केरीन मारेल, तिहेच केरीन लाकीश हेयरान एक एक माणहाह तालवार केरीन मार दिनो। <verse eid="JOS 10:32" /><verse number="33" style="v" sid="JOS 10:33" />तेवी गेजेर गावान राजा होराम लाकीशान मोदेक केरनेन आवो, पुण यहोशु ताह एने तान सेनाह ओलो माऱ्यो काय तामवालो एक बी जीवतालो रिनो नाह।<verse eid="JOS 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JOS 10:34" />तेवी यहोशु एने इस्राएल ने आखा माणहे लाकीश गावाम रेन एग्लोन गावा माय गीया, ता एग्‍लोनान कावदेन पाड़ावो टाक्या एने ता पोर चेड़ाय केऱ्या। <verse eid="JOS 10:34" /><verse number="35" style="v" sid="JOS 10:35" />एने तेदिस ता हेयरा पोर आदिकार केर लेदा, एने हेयरान आखा माणहाह मार देना; जीहे ता लाकीश ने माणहाह तालवार केरीन मारेल तिहेच केरीन एग्‍लोनान माणहाह माऱ्या;<verse eid="JOS 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JOS 10:36" />ओवतो यहोशु एने इस्राएल ने आखा माणहे एग्लोन रेन हेब्रोन गावा माय गीया, एने ता हेब्रोन ने विरूद बी लेड़ाय केऱ्या। <verse eid="JOS 10:36" /><verse number="37" style="v" sid="JOS 10:37" />ता हेयराह एने हेब्रोन ने आहनेवाला आखा आतल्या गावा पोर आदिकार केर लिदो, इस्राएल ने माणहे राजाह एने गावान ता माय वाला आखा जेनवेराह तालवार केरीन मार दिनो; जीह केरीन यहोशु एग्लोना हिऱ्यो किरेल इतो, तिहेच केरीन तो हेब्रोन माय बी कुणीह जीवतालो नाह सोड्यो; ता हेब्रोन ने एने तामवाला आखा माणहाह मार देना।<verse eid="JOS 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JOS 10:38" />तेवी यहोशु एने इस्राएल ने आखा माणहे पासाण फिरीन दबीर माय गीया, एने ता हेयरा पोर चेड़ाय किऱ्यो। <verse eid="JOS 10:38" /><verse number="39" style="v" sid="JOS 10:39" />ता तो हियोर, तान राजा एने दबीरान आहनेवाला आखा गावाह जिक लेदा; एने ता तामवाला आखा माणहाह तालवार केरीन मार देना; कुणीह जीवताला नाह मेल्या, जीहे यहोशु हेब्रोन एने लीबना एने तान राजा हिऱ्यो किरेल इतो, तिहेच केरीन ता दबीर एने तान राजा हेऱ्या बी केऱ्या।<verse eid="JOS 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JOS 10:40" />इह केरीन यहोशु ता आखा देसाह, मतलब बोयड़ावालो देस, देक्षिण देस ने नेचला एने आड़वायावाला देसान राजाह आरीव दिनो; एने इस्राएल ने बोगवान यहोवा उकुम आपेल तिहकेरीन कुणीह नाह सोड्यो, आखा माणहाह मार दिनो। <verse eid="JOS 10:40" /><verse number="41" style="v" sid="JOS 10:41" />यहोशु कादेशबर्ने रेन गाजा पोर वाला आखा हेयरा पोर आदिकार केर लिदो, तो मिस्र माय गोशेनान देरती रेन गीबोन पोर वाला आखा हेयरा पोर कोब्‍जा केर लिदो। <verse eid="JOS 10:41" /><verse number="42" style="v" sid="JOS 10:42" />न्या आखा राजाह तान देसा बेल यहोशु एकास टेमाम जिक लिदो, काहाकाय इस्राएल ने बोगवान यहोवा इस्राएलीन उगे रेन लेड़तालो। <verse eid="JOS 10:42" /><verse number="43" style="v" sid="JOS 10:43" />तेवी यहोशु एने इस्राएल ने आखा माणहे गीलगालान तान पाड़ावा माय आवतरना।<verse eid="JOS 10:43" /></para>
  <chapter eid="JOS 10" />
  <chapter number="11" style="c" sid="JOS 11" />
  <para style="s">राजा याबीन एने तान मोदेक केरनार यहोशुन द्‍वारा आरवाय जाणो</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 11:1" />हासोरान राजा, याबीन जो काय एनो तान बाराम होमल्यो, केरीन तो मोकता राजान सेनाह एकठोस हादणेन निर्णय लिदो, याबीन मादोन ने राजा योबाब, शिम्रोनान राजा, एने अक्षापान राजाह, <verse eid="JOS 11:1" /><verse number="2" style="v" sid="JOS 11:2" />एने जा जा राजा उत्तर निही बोयड़ावाला देसाम, एने किन्नेरेतान देक्षिण ने अराबा माय, एने नेचाला देसाम, एने पश्‍चिमा निही दोरान उचाला देसाम रेताला, ताह खोबेर मोकल्‍यो, <verse eid="JOS 11:2" /><verse number="3" style="v" sid="JOS 11:3" />एने पुर्व पश्‍चिम दुयू उगेवाला रेणारे कनानी, एमोरी, हित्ती, परिज्जी, एने बोयड़ावाला यबूसी, एने मिस्पा देसाम हेर्मोन बोयड़ान नेचा रेणारे हिववी माणहाह बी खोबेर मोकल्‍यो। <verse eid="JOS 11:3" /><verse number="4" style="v" sid="JOS 11:4" />केरीन ज्या आखा राजान सेना रेटान गेत एती, एकठीस आवी, एने ता हेर्‍य जुलूम होवटा गोड़ा एने टांगा बी एता। <verse eid="JOS 11:4" /><verse number="5" style="v" sid="JOS 11:5" />ता आखा राजा आतली नेदी मेरोम नावान तेलान आहने एकठा एना, एने तान सेनाह एक पाड़ावाम एकठा केऱ्या; ता इस्राएल ने विरूद लेड़ाणेन योजना बाणाया।<verse eid="JOS 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 11:6" />तेवी यहोवा यहोशुह केयो, “ती सेनाह मा बिवो, काहाकाय काल ज्‍यीस टेमाम मी तुमूह ताह आरेवणे देह, तुमू ता आखाह मार टाकहो; तुमू गोड़ान नेह काट दिज्यो, एने तान आखा टांगाह हेलगाड़ दिहो।” <verse eid="JOS 11:6" /><verse number="7" style="v" sid="JOS 11:7" />केरीन यहोशु एने तान पुरी सेना, मेरोम नावान तेला हेऱ्या उचकाहुच आवीन ता पोर चेड़ाय केऱ्या। <verse eid="JOS 11:7" /><verse number="8" style="v" sid="JOS 11:8" />एने यहोवा ताह इस्राएलीन आथाम केर दिनो, केरीन इस्राएल ने सेना ताह आरीव देना, एने मोटला हियोर सीदोन एने मिस्रपोतेम वोर एने पुर्व निही मीस्पेन गाटे वोर तान पासाण पोड़ना; एने ताह ओला माऱ्या काय ताम रेन कुणीह जीवताला नाह सोड्या। <verse eid="JOS 11:8" /><verse number="9" style="v" sid="JOS 11:9" />तेवी यहोशु तोस किऱ्यो जो यहोवा कियेल इतो, मतलब यहोशु तान गोड़ान पायान नेह काटाड़ दिनो एने तान टांगाह हेलगाड्यो।<verse eid="JOS 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 11:10" />तेवी यहोशु आवो, एने हासोर हेयराह जो पेल ता आखा राज्‍याम मुखी हियोर इतो आदिकार माय केर लिदो, एने तान राजाह तालवार केरीन मार टाक्‍यो। <verse eid="JOS 11:10" /><verse number="11" style="v" sid="JOS 11:11" />एने इस्राएल ने सेना ता हेयरान एक एक माणहाह तालवार केरीन मार देना, कुण बी जीवतालो नाह रिनो; एने हासोर हेयराह यहोशु आक्‍ठो पेटाड़ीन हेलगाड़ दिनो।<verse eid="JOS 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 11:12" />यहोशु ज्या आखा हेयरा पोर आदिकार किऱ्यो, एने तो तान आखा राजाह मार दिनो, यहोशु ज्या हेयरान एक एक चिजीह खेतेम केर दिनो; एने बोगवानान सेवक मुसाह जीह केरीन उकुम आपेल इतो तिहेच केरीन तालवार केरीन खेतेम किऱ्यो। <verse eid="JOS 11:12" /><verse number="13" style="v" sid="JOS 11:13" />पुण इस्राएल ने सेना काल्ला बी ओहला हेयराह नाह हेलगाड्या जा बोयड़ा पोर बोणेल एता, ता बोयड़ा पोर बोणेल एखालास हासोर हेयरास हेलगाड्या; ज्‍यो तो हियोर इतो, जाह यहोशु हेलगाड्यो। <verse eid="JOS 11:13" /><verse number="14" style="v" sid="JOS 11:14" />एने ज्या हेयरान पालन्या जेनवार एने न्यान आखी चिजुह इस्राएल ने माणहे लुट ली गीया, पुण माणहाह ता तालवार केरीन मार टाक्या, एक बी माणुह जीवताला मेल्या नाह। <verse eid="JOS 11:14" /><verse number="15" style="v" sid="JOS 11:15" />जो उकुम यहोवा तान सेवक मुसाह आपेल इतो, तास ने गेत मुसो यहोशुह उकुम आपेल, एने तिहेच केरीन यहोशु किऱ्यो, एने जो जो उकुम यहोवा मुसाह आपेल इतो ताम रेन एकाह बी यहोशु पुरो केऱ्या सावाय नाह सोड्यो।<verse eid="JOS 11:15" /></para>
  <para style="s">यहोशुन द्‍वारा जिकेल देस</para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 11:16" />इह केरीन यहोशु ज्या पुरा देसान आखा माणहाह आरीव दिनो, बोयड़ावालो देस, एने आखा देक्षिण देस, एने आखो गोशेन देस, एने नेचाला देस, अराबा एने इस्राएल ने बोयड़ावाला देस, एने तान नेचाला देस, <verse eid="JOS 11:16" /><verse number="17" style="v" sid="JOS 11:17" />यहोशुन आदिकार सेईर ने आहने हालाक नावान बोयड़े रेन, हेर्मोन बोयड़ान निड़ो लबानोन ने गाटाम बालगाद वोर, आखा देसा पोर एय गीयो एने ता हेयरान आखा राजाह देरीन मार टाक्‍यो। <verse eid="JOS 11:17" /><verse number="18" style="v" sid="JOS 11:18" />यहोशु ता आखा राजा हिऱ्यो जुलूम वोरीह लेड़ानो। <verse eid="JOS 11:18" /><verse number="19" style="v" sid="JOS 11:19" />गीबोन माय रेणारे हिववीह सोड़ीन दिहरो एगदो हियोर इस्राएल ने माणहा हिऱ्यो मेल नाह किऱ्यो, एने आखा हेयराह ता लेड़ लेड़ीन जिक लेदा। <verse eid="JOS 11:19" /><verse number="20" style="v" sid="JOS 11:20" /><note caller="+" style="x"><char style="xo" closed="false">11:20 </char><char style="xt" closed="false"><ref loc="DEU 7:16">व्यवस्था 7:16</ref></char></note>काहाकाय यहोवा होदतालो काय तान ता उकुमान गेत जो तो मुसाह आपेल इतो, ता पोर कायच बी गीण नाय केरी; पुण खेतेम केर देय, केरीन तो तान मोन ओहलो कठोर केर दिनो काय ता इस्राएलीन चेड़ाय केरीन ता हेऱ्या लेड़ाना।<verse eid="JOS 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 11:21" />तुलबुखे यहोशु बोयड़ावाला देसाम आवीन हेब्रोन, दबीर, अनाब, एने यहुदा एने इस्राएल दुयून आखा बोयड़ावाला देसाम रेणारे अनाकीह खेतेम किऱ्यो; यहोशु हेयरा बेल ताह खेतेम केर दिनो। <verse eid="JOS 11:21" /><verse number="22" style="v" sid="JOS 11:22" />इस्राएल माणहान देसाम एक बी अनाकी जीवतालो रिनो नाह; फोक्‍तो गाजा, गत, एने अश्दोद गावा माय थोड़ाक जीवताला रेय गीया।<verse eid="JOS 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JOS 11:23" />जीहे यहोवा मुसाह कियेल इतो, तिहेच केरीन यहोशु तो आखो देस आदिकार माय केर लिदो; एने ताह इस्राएल ने गेराणा एने वोचीन गेत वाटीन ताह आप दिनो। तेवी देसाह लेड़ाने से सान्ती जुड़नी।<verse eid="JOS 11:23" /></para>
  <chapter eid="JOS 11" />
  <chapter number="12" style="c" sid="JOS 12" />
  <para style="s">मुसा राजा आरवेल</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 12:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:1 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 21:21-35">गिनती 21:21-35</ref>; <ref loc="DEU 2:26">व्यवस्था 2:26</ref>; <ref loc="DEU 3:11">3:11</ref></char>
    </note>इस्राएल ने माणहे यरदन ने ती पार पुर्व उगे, मतलब अर्नोन गाटे रेन हेर्मोन बोयड़े पोर वाला देस, एने आखा पुर्व अराबान जा राजाह इस्राएल ने माणहे मारीन तान देसाह तान आदिकार माय केर लियेल एता ता ज्या हेते; <verse eid="JOS 12:1" /><verse number="2" style="v" sid="JOS 12:2" />हेशबोन हेयराम रेणार एमोरी माणहान राजा सीहोन, जो अर्नोन गाटान देड़े अरोएर रेन, एने ता गाटान विचीवाला हेयराह सोड़ीन यब्बोक नेदी वोर, जी अम्मोनीन एद्दी हे, आदा गीलाद पोर आदिकार चालाड़तालो। <verse eid="JOS 12:2" /><verse number="3" style="v" sid="JOS 12:3" />तो किन्नेरेत रेन खारा देरीया वोर यरदन ने पुर्व उगेन देसा पोर बी आदिकार चालाड़तालो एने बेथशीमोत रेन अराबा देरीये वोर देक्षिण पिसगान आड़वायान नेचो वोर आदिकार चालाड़तालो।<verse eid="JOS 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOS 12:4" />बाशान ने राजा ओगान राज वोचेल रपाई माणहाम रेन इतो, ओग राजा अशतारोत एने एद्रेई माय आदिकार चालाड़तालो। <verse eid="JOS 12:4" /><verse number="5" style="v" sid="JOS 12:5" />एने तो हेर्मोन बुयड़ो सल्‍का, गशुरी, माकीन न्यान एद्दी वोर आखो बाशान एने हेशबोन ने राजा सीहोन ज्यान राज्‍यान एद्‍दी वोर आदा गीलादा पोर राज केरतालो।<verse eid="JOS 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 12:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:6 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 32:33">गिनती 32:33</ref>; <ref loc="DEU 3:12">व्यवस्था 3:12</ref></char>
    </note> यहोवान सेवक मुसा एने इस्राएल ने माणहे ज्या आखा राजाह आरीव देना, एने यहोवान सेवक मुसा तान देस रूबेनी, गादी एने मनश्शेन आदा टोलान माणहाह सोतान ईसो बोणनेन केरता आप दिनो।<verse eid="JOS 12:6" /></para>
  <para style="s">यहोशुन द्‍वारा राजाह आरेवणे</para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 12:7" />इस्राएल ने माणहे ता देसान राजाह बी आरीव दिनो, जो यरदन नेदीन पश्‍चिम माय इतो; यहोशु माणहाह ज्या देसाम ली गीयो, यहोशु माणहाह ज्‍यो देस आप्यो एने ज्याह बारा कुटूमाम वाट दिनो, ज्‍यो तो देस इतो जो ताह आपणेन केरता यहोवा वचन आपेल इतो; ज्‍यो देस लबानोन ने गाटाम बालगाद एने सेईर ने आहने हालाक बोयड़ान विचीम इतो। <verse eid="JOS 12:7" /><verse number="8" style="v" sid="JOS 12:8" />ज्‍याम हित्ती, एमोरी, कनानी, परिज्जी, हिववी, एने यबूसी, जा बोयड़ावाला देसाम एने नेचावाला देसाम, एने अराबा माय, एने आड़वायान देसाम एने जेंगलाम, एने देक्षिण देसाम रेताला। <verse eid="JOS 12:8" /><verse number="9" style="v" sid="JOS 12:9" />यरीहोन राजा, बेतेल ने आहने आईन राजा; <verse eid="JOS 12:9" /><verse number="10" style="v" sid="JOS 12:10" />यरूशलेम ने राजा, हेब्रोन ने राजा; <verse eid="JOS 12:10" /><verse number="11" style="v" sid="JOS 12:11" />यर्मुत ने राजा, लाकीशान राजा; <verse eid="JOS 12:11" /><verse number="12" style="v" sid="JOS 12:12" />एग्लोनान राजा, गेजेरान राजा; <verse eid="JOS 12:12" /><verse number="13" style="v" sid="JOS 12:13" />दबीरान राजा, गेदेर ने राजा; <verse eid="JOS 12:13" /><verse number="14" style="v" sid="JOS 12:14" />होर्मान राजा, अरादान राजा; <verse eid="JOS 12:14" /><verse number="15" style="v" sid="JOS 12:15" />लीबनान राजा, अदुल्लाम ने राजा; <verse eid="JOS 12:15" /><verse number="16" style="v" sid="JOS 12:16" />मक्केदान राजा, बेतेलान राजा; <verse eid="JOS 12:16" /><verse number="17" style="v" sid="JOS 12:17" />तप्पुहान राजा, हेपेरान राजा; <verse eid="JOS 12:17" /><verse number="18" style="v" sid="JOS 12:18" />अपेक ने राजा, लशारोनान राजा; <verse eid="JOS 12:18" /><verse number="19" style="v" sid="JOS 12:19" />मादोन ने राजा, हासोरान राजा; <verse eid="JOS 12:19" /><verse number="20" style="v" sid="JOS 12:20" />शिम्रोन मरोन ने राजा; अक्षापान राजा <verse eid="JOS 12:20" /><verse number="21" style="v" sid="JOS 12:21" />तानाकान राजा, मगीद्दोन राजा; <verse eid="JOS 12:21" /><verse number="22" style="v" sid="JOS 12:22" />केदेशान राजा, कर्मेल माय योकनाम ने राजा; <verse eid="JOS 12:22" /><verse number="23" style="v" sid="JOS 12:23" />दोर नावान उचाला देसान दोरान राजा, गीलगाल माय गोयीमान राजा; <verse eid="JOS 12:23" /><verse number="24" style="v" sid="JOS 12:24" />तीर्सान राजा, आखा मिलीन एकतीस राजा एता।<verse eid="JOS 12:24" /></para>
  <chapter eid="JOS 12" />
  <chapter number="13" style="c" sid="JOS 13" />
  <para style="s">बुय एवी उंजु बी लेणु हे</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 13:1" />जेवी यहोशु जुलूम डुहो एय गीयो, ते यहोवा ताह केयो, “तु डुहो एने जुलूम वोयान एय जायेल हे, एने जुलूम देस रेय जायेल हेते, जा इस्राएल ने आदिकार माय उंजु वोर नाह आवा। <verse eid="JOS 13:1" /><verse number="2" style="v" sid="JOS 13:2" />ज्या देस रेय जायेल हेते, मतलब पलिश्तीन आखो जागो, एने गशुरी माणहान आखो जागो। <verse eid="JOS 13:2" /><verse number="3" style="v" sid="JOS 13:3" />तुमू मिस्र देसान एद्दी पोर शीहोर नेदी रेन उत्तर माय एक्रोनान एद्दी वालो जागो नाह लियेल सोता, तो एवी वोर कनानी माणहान हे; तुमूह राजा, अशदोद अशकलोन, गत, एने एक्रोन पाचु पलिश्तीन मुखीह, एने ता अव्वी माणहाह आरेवणु हे। <verse eid="JOS 13:3" /><verse number="4" style="v" sid="JOS 13:4" />ओवतो अपेक एने एमोरीन एद्दी वोर कनानीन आखो देस, एने सीदोनीन मारा नावान देस, <verse eid="JOS 13:4" /><verse number="5" style="v" sid="JOS 13:5" />ओवतो गबालीन देस, एने पुर्व उगेवालो हेर्मोन बोयड़ान नेचा बालगाद रेन हमात ने गाटे वोर आखो लबानोन ईलाको, <verse eid="JOS 13:5" /><verse number="6" style="v" sid="JOS 13:6" /><note caller="+" style="x"><char style="xo" closed="false">13:6 </char><char style="xt" closed="false"><ref loc="NUM 33:54">गिनती 33:54</ref></char></note>ओवता लबानोन रेन मिस्रपोतेम वोर बोयड़ाम रेणारे, आखा सीदोनी, न्याह मी इस्राएली माणहान सामने रेन निकाल देह; तु फोक्‍तो मारा उकुमान गेत चिट्‍ठी टाक टाकीन तान देस इस्राएलीह वाट दे। <verse eid="JOS 13:6" /><verse number="7" style="v" sid="JOS 13:7" />केरीन तु एवी ज्या देसाह नोव कुटूमाम एने मनश्शेन आदा कुटूमाम वाट दे।”<verse eid="JOS 13:7" /></para>
  <para style="s">यरदन ने पुर्व बागान वाटणो</para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 13:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">13:8 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 32:33">गिनती 32:33</ref>; <ref loc="DEU 3:12">व्यवस्था 3:12</ref></char>
    </note>रूबेनी एने गादीह ते तो ईसो जुड़ जायेल इतो, जो मुसा ताह यरदन ने पुर्व निही आपेल इतो, काहाकाय यहोवान सेवक मुसा ताहास आपेल इतो, <verse eid="JOS 13:8" /><verse number="9" style="v" sid="JOS 13:9" />मतलब अर्नोन नावान गाटान देड़ेवाला अरोएर रेन, एने तास गाटान विचीवाला हेयराह सोड़ीन दिबोन वोर मेदबान आहनेवालो आखो सापाट देस; <verse eid="JOS 13:9" /><verse number="10" style="v" sid="JOS 13:10" />एने अम्मोनीन राजा सीहोन जो हेशबोन माय राज किऱ्यो, तान एमोरी माणहान एद्‍दी वोर आखा हियोर; <verse eid="JOS 13:10" /><verse number="11" style="v" sid="JOS 13:11" />एने गीलाद देस, एने गशुरी एने माका माणहान एद्‍दी, एने आखो हेर्मोन बुयड़ो, एने सल्‍का गाव वोर आखो बाशान ईलाको। <verse eid="JOS 13:11" /><verse number="12" style="v" sid="JOS 13:12" />बाशान माय ओगानान पुरो राज, जो अशतारोत एने एद्रेई माय राज केरतालो, वोचेल रपाई माय फोक्‍तो तोस रेय जायेल एतो, काहाकाय मुसा ताह मारीन तान देसाम रेन निकाल दियेल इतो। <verse eid="JOS 13:12" /><verse number="13" style="v" sid="JOS 13:13" />पुण इस्राएली गशुरी एने माकीह तान देसाम रेन नाह निकाल्यो; केरीन गशुरी एने माकी इस्राएलीन विचीम आज वोर रेतेह।<verse eid="JOS 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 13:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">13:14 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 18:1">व्यवस्था 18:1</ref>
      </char>
    </note>एने लेवीन गेराणाह तो काल्लो ईसो नाह आप्यो; काहाकाय इस्राएल ने बोगवान यहोवान वचनान गेत तास ने बेट तानकेरता ईसो ठेराय।<verse eid="JOS 13:14" /></para>
  <para style="s">रूबेन ने गेराणाह आपेल ईस्‍सो</para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 13:15" />मुसा बुईन ईसो रूबेन ने वोसीन कुटूमाह तान सोतान ईसो हे केरीन वाट दियेल इतो। <verse eid="JOS 13:15" /><verse number="16" style="v" sid="JOS 13:16" />मतलब अर्नोन नावान हाकड़ा गाटान देड़ेन अरोएर रेन एने तास गाटान विचीवाला हेयराह सोड़ीन मेदबान आहनेवालो आखो सापाट देस; <verse eid="JOS 13:16" /><verse number="17" style="v" sid="JOS 13:17" />उवतो हेशबोन एने सापाटीवाला आखा हियोर, मतलब दिबोन, बामोतबाल, बेतबालमोन; <verse eid="JOS 13:17" /><verse number="18" style="v" sid="JOS 13:18" />यहस, कदेमोत, मेपात, <verse eid="JOS 13:18" /><verse number="19" style="v" sid="JOS 13:19" />किर्यातेम, सीबमा, एने गाटामवालो बोयड़ा पोर वालो सेरेथशहर, <verse eid="JOS 13:19" /><verse number="20" style="v" sid="JOS 13:20" />बेतपोर, पिसगान आड़वाया एने बेथशीमोत एता। <verse eid="JOS 13:20" /><verse number="21" style="v" sid="JOS 13:21" />एने सापाटीवाला आखा हियोर एने एमोरी माणहान राजा सीहोन जा पोर राज किरेल इतो, तो ईलाको इतो, पुण मुसा ताह एने मिद्यानी माणहाह आरायेल इतो। मुसा एवी, रेकेम, सुर, हुर, एने रेबा नावान मिद्यान ने मुखीह बी मार दियेल इतो, जा सीहोनान ठेरायेल आखा मुखी तास देसाम रेताला। <verse eid="JOS 13:21" /><verse number="22" style="v" sid="JOS 13:22" />एने इस्राएल ने माणहे दिहरा माणहा हेऱ्या बोरान बिटोख बिलामाह बी जो जाणाव केरतालो तालवार केरीन मार टाक्या। <verse eid="JOS 13:22" /><verse number="23" style="v" sid="JOS 13:23" />एने रूबेनीन बुयीन एद्दी यरदन नेदी एती, रूबेनीन ईसो तान वोचीन पारमाणे हियोर एने गावा बेल ज्‍योस ठेरानो।<verse eid="JOS 13:23" /></para>
  <para style="s">गादान गेराणाह आपेल ईस्‍सो</para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 13:24" />ओवतो मुसा गादान कुटूमाह बी वोचीन पारमाणे तान सोतान ईसो केरीन वाट दिनो। <verse eid="JOS 13:24" /><verse number="25" style="v" sid="JOS 13:25" />याजेरान एने गीलादान आखा हियोर, मुसा ताह अम्मोनी माणहान बुयीन आदो ईसो रब्बान आहने अरोएर वोर आपेल इतो। <verse eid="JOS 13:25" /><verse number="26" style="v" sid="JOS 13:26" />एने हेशबोन रेन रामत-मीस्पे एने बेतोनीम वोर, एने महनेम रेन दबीर ने एद्दी वोर, <verse eid="JOS 13:26" /><verse number="27" style="v" sid="JOS 13:27" />एने गाटाम बेतहारम, बेतनिम्रा, सुक्कोत एने सापोन एने यरदन नेदीह एद्दी मानीन हेशबोन ने राजा सीहोनान राज्‍यान वोचेल ईसो, जो यरदन नेदीन पुर्व माय किन्नेरेत देरीयान सेवटे वोर पोसरेल हे। <verse eid="JOS 13:27" /><verse number="28" style="v" sid="JOS 13:28" />गादी माणहान ईसो तान वोस एने गेराणान पारमाणे हियोर एने गावा बेल ज्यास ठेराना।<verse eid="JOS 13:28" /></para>
  <para style="s">पुर्व उगे मनश्शेन आदा गेराणाह आपेल ईस्‍सो</para>
  <para style="p">
    <verse number="29" style="v" sid="JOS 13:29" />ओवतो मुसा मनश्शेन आदा गेराणाह बी तान सोतान ईसो केर दिनो; तो मनश्शेन आदा गेराणान सोतान ईसो तान वोचीन पारमाणे ठेरानो। <verse eid="JOS 13:29" /><verse number="30" style="v" sid="JOS 13:30" />तान ईसो ज्‍यो इतो, महनेम रेन आखो बाशान मतलब बाशान ने राजा ओगान आखो राज्य, एने बाशान माय याईरान साठ हियोर, <verse eid="JOS 13:30" /><verse number="31" style="v" sid="JOS 13:31" />एने गीलादान आदो ईसो, एने बाशान माय ओगान राज्‍याम वोहेल अशतारोत एने एद्रेई हियोर, ज्‍यो ईसो मनश्शेन बिटोख माकिरान वोस ने केरता मतलब माकीरा आदि वोचीन सोतान ईसो तान वोचीन पारमाणे ठेराय। <verse eid="JOS 13:31" /><verse number="32" style="v" sid="JOS 13:32" />जो जागो मुसा मोआब ने मोयदाना माय यरीहोन आहने यरदन नेदीन पुर्व उगे वाट दिनो ता ज्यास हेते। <verse eid="JOS 13:32" /><verse number="33" style="v" sid="JOS 13:33" /><note caller="+" style="x"><char style="xo" closed="false">13:33 </char><char style="xt" closed="false"><ref loc="NUM 18:20">गिनती 18:20</ref>; <ref loc="DEU 18:2">व्यवस्था 18:2</ref></char></note>पुण लेवीन गेराणाह मुसा काल्लो जागो नाह आप्यो; इस्राएल ने बोगवान यहोवास तान वचनान गेत तान ईसो ठेरानो।<verse eid="JOS 13:33" /></para>
  <chapter eid="JOS 13" />
  <chapter number="14" style="c" sid="JOS 14" />
  <para style="s">यरदन ने पश्चिम बागान वाटणो</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 14:1" />जो जो जागो इस्राएली कनान देसाम सापड़ायेल, ताह एलीआजर चाकऱ्यो, एने नुन ने बिटोख यहोशु, एने इस्राएली गेराणान डायडायान गेराणान मुखी मुखी एदमी ताह आपेल तो ज्‍यो हे। <verse eid="JOS 14:1" /><verse number="2" style="v" sid="JOS 14:2" /><note caller="+" style="x"><char style="xo" closed="false">14:2 </char><char style="xt" closed="false"><ref loc="NUM 26:52-56">गिनती 26:52-56</ref>; <ref loc="NUM 34:13">34:13</ref></char></note>जो उकुम बोगवान मुसाह साड़े नोव गेराणान केरता आपेल इतो, तास ने गेत तान ईसा चिट्ठी टाकीन आपाय गीया। <verse eid="JOS 14:2" /><verse number="3" style="v" sid="JOS 14:3" />मुसा एड़ी कुटूमाह तान जागो ताह यरदन नेदीन ती पार आपेल इतो; पुण लेवीन कुटूमाह दिहरा माणहान गेत काल्लो जागो नाह जुड़नो। <verse eid="JOS 14:3" /><verse number="4" style="v" sid="JOS 14:4" /><note caller="+" style="x"><char style="xo" closed="false">14:4 </char><char style="xt" closed="false"><ref loc="NUM 32:33">गिनती 32:33</ref>; <ref loc="NUM 34:14-15">34:14-15</ref>; <ref loc="DEU 3:12-17">व्यवस्था 3:12-17</ref></char></note>युसूफान वोचीन दुय कुटूम एय जायेल एता, मतलब मनश्शे एने एप्रेम; पुण लेवीन कुटूमान माणहाह काल्लो जागो नाह आपानो, पुण ताह रेणेन केरता थोड़ाक हियोर एने तान पालन्या जेनवेरान चारान केरता खेत जुड़ना। <verse eid="JOS 14:4" /><verse number="5" style="v" sid="JOS 14:5" />जो उकुम यहोवा मुसाह आपेल इतो तान गेत इस्राएली केऱ्या; एने ता देसाह वाट देना।<verse eid="JOS 14:5" /></para>
  <para style="s">कालेबाह हेब्रोन आपणो</para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 14:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">14:6 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 14:30">गिनती 14:30</ref>
      </char>
    </note>तेवी यहुदि यहोशु फाय गीलगाल माय आवा; एने कनजी यपुन्नेन बिटोख कालेब ताह केयो, “तु जाणतेय काय बोगवानान सेवक मुसाह कादेशबर्ने माय मारे एने तारे बाराम काय कियेल इतो। <verse eid="JOS 14:6" /><verse number="7" style="v" sid="JOS 14:7" /><note caller="+" style="x"><char style="xo" closed="false">14:7 </char><char style="xt" closed="false"><ref loc="NUM 13:1-30">गिनती 13:1-30</ref></char></note>बोगवानान सेवक मुसा जेवी माहु कादेशबर्ने रेन देसान पोतो लागाड़नेन केरता मोकलेल इतो, तेवी मी चालीह वोरह्यान इतो, एने मी खेरी मोना केरीन ता फाय खोबेर लावो। <verse eid="JOS 14:7" /><verse number="8" style="v" sid="JOS 14:8" />एने मारा हाती जा मार हेऱ्या जायेल एता, ता ते माणहान मोनाम बिय रिगाड़ दियेल एता; पुण मी पुरी रिती से आपणो बोगवान यहोवान वात मान्यो। <verse eid="JOS 14:8" /><verse number="9" style="v" sid="JOS 14:9" /><note caller="+" style="x"><char style="xo" closed="false">14:9 </char><char style="xt" closed="false"><ref loc="NUM 14:24">गिनती 14:24</ref></char></note>तेवी ते दिह मुसा सुगोण खाएन माहु केयो, ‘तु पुरी रिती से मारो बोगवान यहोवान वात मानेल हे, केरीन जी बुयी पोर तु तारा पाय मिलेल हे ती कायेम ने केरता तारी एने तारा सोरान ईसो एय जाय।’ <verse eid="JOS 14:9" /><verse number="10" style="v" sid="JOS 14:10" />एने एवी देख, ज्यी वात यहोवा मुसाह तुलबुखे कियेल एती, जेवी इस्राएली माणहे जेंगलाम बोटेकते फिरताला; तुलबुखे रेन ज्या चालीह ने पाच वोरह्या वोर बोगवान तान वचनान गेत माहु जीवतालो मिलेल हे। <verse eid="JOS 14:10" /><verse number="11" style="v" sid="JOS 14:11" />मी एवी बी तोलोस ताकेतवोर हे, जोलोक ताकेतवोर मी तुलबुखे इतो, जेवी मुसा माहु जाणकारी लेणेन केरता मोकलेल इतो, मी ता दिह्यान गेत एवी बी लेड़ाणेन तियार हे। <verse eid="JOS 14:11" /><verse number="12" style="v" sid="JOS 14:12" />केरीन तो बोयड़ावालो ईलाको माहु आप दिवो, जाह यहोवा जुलूम वेगोन ते दिह माहु आपणेन वचन आपेल इतो; तुलबुखे तुमूह मालुम पुड़ेल एतो काय ताहरी ताकेतवोर अनाकी माणहे रेतेह एने हियोर जुलूम मोठा एने बांदाबोस माय हेते; एय सिकेह काय यहोवा मार हिऱ्यो रेय एने यहोवान वचनान गेत मी ताह निकाल नाहाडु।”<verse eid="JOS 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 14:13" />यहोशु यपुन्नेन बिटोख कालेबाह बोरकेत आप्यो, एने यहोशु हेब्रोन हेयराह तान सोतान ईसो केर दिनो। <verse eid="JOS 14:13" /><verse number="14" style="v" sid="JOS 14:14" />एने हेब्रोन हियोर एवी बी कनजी यपुन्नेन बिटोख कालेब ने कुटूमान ईसो हे, काहाकाय तो इस्राएल ने बोगवान यहोवान उकुम खेराय माय मान्यो एने ता पोर पुरो बुरहो किऱ्यो। <verse eid="JOS 14:14" /><verse number="15" style="v" sid="JOS 14:15" />हेब्रोन हेयरान नाव पेल किर्यतर्बा एतो, काहाकाय अर्बा अनाकी माणहाम रेन आखाम रेन मोठो एदमी इतो; तान बाद देसाह सान्ती जुड़नी।<verse eid="JOS 14:15" /></para>
  <chapter eid="JOS 14" />
  <chapter number="15" style="c" sid="JOS 15" />
  <para style="s">यहुदान गेराणाह आपेल ईस्‍सो</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 15:1" />यहुदिन गेराणान ईसो तान वोचीन पारमाणे चिट्ठी टाकणे से एदोमान एद्दी वोर, एने देक्षिणान उगे सीनान जेंगलाम वोर जो देक्षिणान एद्दी पोर हे ठेरानो। <verse eid="JOS 15:1" /><verse number="2" style="v" sid="JOS 15:2" />तान ईसान देक्षिण ने एद्‍दी खारा देरीयान देक्षिण ने सेवटे रेन सुरवात एताली। <verse eid="JOS 15:2" /><verse number="3" style="v" sid="JOS 15:3" />ज्यी एद्दी देक्षिणान उगे अक्रब्बीम ने चेड़ती रेन निकलीन सीन लागती कादेशबर्नेन देक्षिण वोर जायेल एती, ओवती हेस्रोन ने उगे जायीन अद्दार वोर पोचनी एने कर्कान उगे वोल गीयी। <verse eid="JOS 15:3" /><verse number="4" style="v" sid="JOS 15:4" />ता रेन अम्मोन लागती मिस्र देसान खोदरे वोर पोच गीयी, एने ती एद्दीन सेवेट देरीयान मीरे वोर एनी ज्यी तुमरी देक्षिण ने एद्दी रेय।<verse eid="JOS 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JOS 15:5" />ओवती पेल्‍ली एद्दी खारा देरीयान देड़े रेन ता ईलाकाम वोर एती, जाहरी यरदन नेदी देरीयाम मिलाताली।</para>
  <para style="p" vid="JOS 15:5">उत्तर ने एद्दी ता ईलाकाम रेन सुरवात एताली जाहरी यरदन नेदी खारा देरीयाम मिलाताली, <verse eid="JOS 15:5" /><verse number="6" style="v" sid="JOS 15:6" />तेवी उत्तर ने एद्दी बेथोगला रेन लागती एने बेतराबा वोर जात रियेल एती, ज्यी एद्दी रूबेन ने बिटोख बोहन नावान देगड़े वोर जायेल एती। <verse eid="JOS 15:6" /><verse number="7" style="v" sid="JOS 15:7" />एने तीस एद्दी आकोरान गाटे लागती दबीर वोर जायेल एती, ताहरी एद्दी उत्तर उगे वोलताली एने गीलगाल वोर जाताली; जी अदुम्मिम बोयड़ान सामने हे ती एद्दी देक्षिण उगे हे; ओवती ती एद्दी एनशेमेश नावान कुवान आहने पोचीन एनरोगेल माय निवरी गियी। <verse eid="JOS 15:7" /><verse number="8" style="v" sid="JOS 15:8" />ओवती ती एद्दी यबूसी हेयरान देक्षिणान उगे रेन बेन हिन्‍नोम बोयड़े रेन लागती जायेल एती, तो यबूसी हियोर यरूशलेम केवाय जातालो तान देक्षिणान उगे रेन वोड़ते लेन ता बोयड़ान चुटा पोर पोचनी, जी पश्‍चिमान उगे हिन्‍नोमान गाटान सामने एने रपाईम ने गाटान उत्तरवाला सेवटे हे; <verse eid="JOS 15:8" /><verse number="9" style="v" sid="JOS 15:9" />ओवती ती जागे रेन एद्दी नेप्तोहान पाण्यान जिरा हेऱ्यी जाताली, एने एद्दी एप्रोन बोयड़ान आहनेवाला हेयराम वोर जाताली, एने ता रेन बाला जो किर्यत्यारीम बी केवाथे पोचनी; <verse eid="JOS 15:9" /><verse number="10" style="v" sid="JOS 15:10" />ओवती बाला रेन एद्दी पश्‍चिन उगे वोलीन सेईर बोयड़े वोर एने उत्तर उगे यारीम बोयड़ान उतेरती मतलब कसालोन वोर पोचनी, ओवती बेतशेमेशान उगे उत्तर उगे तिम्ना लागती निकील गीयी। <verse eid="JOS 15:10" /><verse number="11" style="v" sid="JOS 15:11" />ओवती एद्‍दी एक्रोनान उत्तर लागती शिक्करोन ने उगे वोल गियी, एने बाला बोयड़े लागती यबनेल पोचनी एने एद्दी देरीयान दिड़े निवरी गियी। <verse eid="JOS 15:11" /><verse number="12" style="v" sid="JOS 15:12" />एने पश्‍चिम ने एद्‍दी मोटला देरीयान मिरो ठेरानो, यहुदा वोसीह जा ईसा तान गेराणान पारमाणे जुड़ना तान कावदेन वाली एद्दी ज्‍यीस एनी।<verse eid="JOS 15:12" /></para>
  <para style="s">कालेबान हेब्रोन एने दबीरा पोर जिक</para>
  <para style="r">(<ref loc="JDG 1:11-15">न्यायियो 1:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 15:13" />
    <note caller="+" style="x">
      <char style="xo" closed="false">15:13 </char>
      <char style="xt" closed="false">
        <ref loc="JDG 1:20">न्यायियो 1:20</ref>
      </char>
    </note>यहोवा यहोशुह उकुम आपेल इतो काय तो यपुन्नेन बिटोख कालेबाह यहुदान जागाम रेन ईसो आपी, केरीन यहोशु कालेबाह तो हियोर आप्यो जान केरता बोगवान उकुम आपेल इतो, यहोशु ताह किर्यतर्बान हियोर आप्यो, जो हेब्रोन बी केवाथे। अर्बा अनाकान आबोख इतो। <verse eid="JOS 15:13" /><verse number="14" style="v" sid="JOS 15:14" />एने कालेब ता रेन शेशे, अहीमन, एने तल्मे नावान अनाकान तीनु सोराह निकाल दिनो। <verse eid="JOS 15:14" /><verse number="15" style="v" sid="JOS 15:15" />ओवतो ता रेन कालेब दबीर माय रेणारे माणहा हिऱ्यो लेड़ानो, पेल दबीरान नाव किर्यत्‍सेपेर एतो। <verse eid="JOS 15:15" /><verse number="16" style="v" sid="JOS 15:16" />एने कालेब केयो, “जो किर्यत्‍सेपेराह आरवी देय, ता हिऱ्यो मी मारी बेटीख अकसान वाराड़ केर देह।” <verse eid="JOS 15:16" /><verse number="17" style="v" sid="JOS 15:17" />तेवी कालेबान बाहख कनजीन बिटोख ओत्नीएल ता हेयराह आरीव दिनो; केरीन कालेब तान बेटीख अकसाह वाराड़ केर दिनो। <verse eid="JOS 15:17" /><verse number="18" style="v" sid="JOS 15:18" />जेवी ओत्‍नीएल अकसाह केयो काय तीन आबाख फाय थोड़ीक वोदार जागो मांगे, अकसा तीन आबाख फाय गियी; जेवी ती तीन गेदड़ा पोर रेन उतेरनी, तेवी कालेब तीह फुशो, “तुवाह काय जुवे?” <verse eid="JOS 15:18" /><verse number="19" style="v" sid="JOS 15:19" />अकसा केयी, “माहु बोरकेत आप; माहु पाण्‍यावालो जागो जुवे, जो जागो आमुह तु नेगेब माय आपेल हे, ती जुलूम हुकेल हे, केरीन माहु ओहलो जागो आप जा माय पाण्यान कुवा एती।” तेवी कालेब उपेरल्‍या एने नेचाला कुवा बेल जागो आप्यो।<verse eid="JOS 15:19" /></para>
  <para style="s">यहुदा गेराणान गाव</para>
  <para style="p">
    <verse number="20" style="v" sid="JOS 15:20" />यहुदान कुटूमान ईसो तान वोचीन पारमाणे ज्‍योस इतो। <verse eid="JOS 15:20" /><verse number="21" style="v" sid="JOS 15:21" />यहुदा गेराणान देड़ेवाला जा हियोर देक्षिण देसाम एदोमान एद्दीन उगे एता, ता ज्या हेते, कबसेल, एदेर, यागुर, <verse eid="JOS 15:21" /><verse number="22" style="v" sid="JOS 15:22" />किना, दिमोना, अदादा, <verse eid="JOS 15:22" /><verse number="23" style="v" sid="JOS 15:23" />केदेश, हासोर, यित्नान, <verse eid="JOS 15:23" /><verse number="24" style="v" sid="JOS 15:24" />जीप, तेलेम, बालोत, <verse eid="JOS 15:24" /><verse number="25" style="v" sid="JOS 15:25" />हासोरहदत्‍ता, करियोत हेस्रोन मतलब हासोर, <verse eid="JOS 15:25" /><verse number="26" style="v" sid="JOS 15:26" />एने अमाम, शेमा, मोलादा, <verse eid="JOS 15:26" /><verse number="27" style="v" sid="JOS 15:27" />हसरगद्‍दा, हेशमोन, बेत्‍पालेत, <verse eid="JOS 15:27" /><verse number="28" style="v" sid="JOS 15:28" />हसरशुआल, बेर्शेबा, बिज्योत्या, <verse eid="JOS 15:28" /><verse number="29" style="v" sid="JOS 15:29" />बाला, इय्यीम, एसेम, <verse eid="JOS 15:29" /><verse number="30" style="v" sid="JOS 15:30" />एलतोलद, कसील, होर्मा, <verse eid="JOS 15:30" /><verse number="31" style="v" sid="JOS 15:31" />सीकलग, मदमन्ना, सनसन्ना, <verse eid="JOS 15:31" /><verse number="32" style="v" sid="JOS 15:32" />लबाओत, शिल्हीम, ऐन, एने रिम्‍मोन; ज्या आखा हियोर एकोनतीस हेते, एने तान गाव बी हे।<verse eid="JOS 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JOS 15:33" />बुंदेवाला देसाम ज्या हेते, मतलब एश्ताओल, सोरा, अशना, <verse eid="JOS 15:33" /><verse number="34" style="v" sid="JOS 15:34" />जानोह, एनगन्नीम, तप्‍पुह, एनाम, <verse eid="JOS 15:34" /><verse number="35" style="v" sid="JOS 15:35" />यर्मुत, अदुल्लाम, सोको, अजेका, <verse eid="JOS 15:35" /><verse number="36" style="v" sid="JOS 15:36" />शारेम, अदितेम, गदेरा, एने गदेरोतेम; ज्या आखा चोवदा हियोर हेते, एने तान गाव बी हेते।<verse eid="JOS 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JOS 15:37" />ओवतो सनान, हदाशा, मिगदलगाद, <verse eid="JOS 15:37" /><verse number="38" style="v" sid="JOS 15:38" />दिलान, मीस्पे, योक्तेल, <verse eid="JOS 15:38" /><verse number="39" style="v" sid="JOS 15:39" />लाकीश, बोस्‍कत, एग्लोन, <verse eid="JOS 15:39" /><verse number="40" style="v" sid="JOS 15:40" />कब्बोन, लहमास, कितलीश, <verse eid="JOS 15:40" /><verse number="41" style="v" sid="JOS 15:41" />गेदेरोत, बेतदागोन, नामाह, एने मक्केदा; ज्या सोला हियोर हेते, एने तान गाव बी हेते।<verse eid="JOS 15:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JOS 15:42" />ओवतो, लीबना, एतेर, आशान, <verse eid="JOS 15:42" /><verse number="43" style="v" sid="JOS 15:43" />यिप्ताह, अशना, नसीब, <verse eid="JOS 15:43" /><verse number="44" style="v" sid="JOS 15:44" />किला, अकजीब एने मारेशा; ज्या नोव हियोर हेते, एने तान गाव बी हेते।<verse eid="JOS 15:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="JOS 15:45" />ओवतो हेयरे एने गावा बेल एक्रोन, <verse eid="JOS 15:45" /><verse number="46" style="v" sid="JOS 15:46" />ता एक्रोन ने आहनेवाला एने पश्‍चिमान अश्दोद ने उगेवाला हियोर बी सापड़ाया।<verse eid="JOS 15:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JOS 15:47" />ओवता आप आपणा हियोर एने गावा बेल अश्दोद एने गाजा, एने मिस्रान खोदरे वोर एने मोटला देरीयान देड़े वोर जोला हियोर हेते।<verse eid="JOS 15:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JOS 15:48" />यहुदान माणहाह बोयड़ावाला देसाम बी हियोर आपाना, मतलब शामीर, यत्तीर, सोको, <verse eid="JOS 15:48" /><verse number="49" style="v" sid="JOS 15:49" />दन्ना, किर्यत्सन्ना, जाह दबीर बी केतेह, <verse eid="JOS 15:49" /><verse number="50" style="v" sid="JOS 15:50" />अनाब, एशतमो, आनीम, <verse eid="JOS 15:50" /><verse number="51" style="v" sid="JOS 15:51" />गोशेन, होलोन एने गीलो; आखा मिलीन ईग्यार हियोर एने तान गाव बी हेते।<verse eid="JOS 15:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JOS 15:52" />यहुदान माणहाह ज्या हियोर बी आपायेल एता; अराब, दुमा, एशान, <verse eid="JOS 15:52" /><verse number="53" style="v" sid="JOS 15:53" />यानीम, बेत्‍तप्‍पुह, अपेका, <verse eid="JOS 15:53" /><verse number="54" style="v" sid="JOS 15:54" />हुमता, किर्यतर्बा, जो हेब्रोन बी केवाथे, एने सीओर; ज्या नोव हियोर हेते, ज्या नोव हियोर हेते, एने तान गाव बी हेते।<verse eid="JOS 15:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JOS 15:55" />यहुदान माणहाह ज्या हियोर बी आपायेल एता; माओन, कर्मेल, जीप, युत्ता, <verse eid="JOS 15:55" /><verse number="56" style="v" sid="JOS 15:56" />यिज्रेल, योकदाम, जानोह, <verse eid="JOS 15:56" /><verse number="57" style="v" sid="JOS 15:57" />केन, गीबा, एने तिम्ना; ज्या आखा दोह हियोर एने तान गाव बी हेते।<verse eid="JOS 15:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="JOS 15:58" />हलहुल, बेतसुर, गदोर, <verse eid="JOS 15:58" /><verse number="59" style="v" sid="JOS 15:59" />मरात, बेतनोत एने एलतकोन; ज्या आखा सोव हियोर एने तान गाव बी एता।<verse eid="JOS 15:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="JOS 15:60" />यहुदान माणहान दुय हियोर रब्बा एने किर्यतबाल, ज्याह किर्यत्‍यारीम बी केताला आपायेल एता।<verse eid="JOS 15:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="JOS 15:61" />जेंगलाम ज्या हियोर हेते बेतराबा, मिद्दीन, सकाका; <verse eid="JOS 15:61" /><verse number="62" style="v" sid="JOS 15:62" />निबशान, मिठान हियोर एने एनगदी, आखा मिलीन सोव हियोर एने तान आखा गाव एता।<verse eid="JOS 15:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="JOS 15:63" />
    <note caller="+" style="x">
      <char style="xo" closed="false">15:63 </char>
      <char style="xt" closed="false">
        <ref loc="JDG 1:21">न्यायियो 1:21</ref>; <ref loc="2SA 5:6">2 शमुएल 5:6</ref>; <ref loc="1CH 11:4">1 इतिहास 11:4</ref></char>
    </note>यहुदान सेना यरूशलेम माय रेणारे यबूसी माणहाह निकाल नाह सेक्‍या; केरीन आज वोर यबूसी माणहे यरूशलेम माय यहुदा माणहान विचीम रेतेह।<verse eid="JOS 15:63" /></para>
  <chapter eid="JOS 15" />
  <chapter number="16" style="c" sid="JOS 16" />
  <para style="s">एप्रेम एने मनश्शे गेराणाह आपेल ईस्‍सो</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 16:1" />ओवतो चिट्ठी टाकणेन द्वारा युसूफान सोरान ईसान एद्दी यरीहो गावान आहनेवाली यरदन जिर रेन यरीहोन पुर्वान पाण्या केरीन सुरवात एन ता जेंगला निही एने यरीहो रेन बोयड़ावाला देसाम लागती, बेतेल वोर पोचनी; <verse eid="JOS 16:1" /><verse number="2" style="v" sid="JOS 16:2" />ओवती बेतेल गाव रेन ती लुज ने एद्दी वोर पोचनी, एने ओंगाण वोड़तेन अरकी जातीन एद्‍दी लागती अतारोत ने उगे जाय निकेलनी; <verse eid="JOS 16:2" /><verse number="3" style="v" sid="JOS 16:3" />एने पश्‍चिम ने उगे यपलेती जातीन एद्दी रेन उतरीन, पोशी बुंदेवाला बेथोरोनान एद्दी लागती गेजेर पोचनी, एने देरीयान दिड़े निवरी गियी।<verse eid="JOS 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOS 16:4" />तेवी मनश्शे एने एप्रेम नावान युसूफान दुयू सोरान सोरा आप आपणो ईसो लेदा।<verse eid="JOS 16:4" /></para>
  <para style="s">एप्रेमान ईस्‍सो</para>
  <para style="p">
    <verse number="5" style="v" sid="JOS 16:5" />एप्रेमान एद्दी तान गेराणान पारमाणे ज्यी ठेरानी; मतलब तान ईसान एद्दी पुर्व रेन सुरवात एन अत्रोतदार लागती उपेरल्‍या बेथोरोन वोर पोचनी; <verse eid="JOS 16:5" /><verse number="6" style="v" sid="JOS 16:6" />एने उत्‍तरवाली एद्दी पश्‍चिमान उगेवाला मीकमतात रेन सुरवात एन पुर्वान उगे वोलीन तानतशीलो पोचनी, एने तान आहने लागती यानोह गाव वोर पोचनी; <verse eid="JOS 16:6" /><verse number="7" style="v" sid="JOS 16:7" />पोशी यानोह रेन ती अतारोत एने नाराम उतेरते लेन यरीहो माय पोचणे एने यरदन नेदीम जाथे। <verse eid="JOS 16:7" /><verse number="8" style="v" sid="JOS 16:8" />ओवती तीस एद्दी तप्‍पुह रेन पश्‍चिमान उगे जाएन कानान खुदेर लागती देरीयाम निकेलनी; एप्रेमी माणहान गेराणान ईसो तान गेराणान पारमाणे ज्‍योस ठेरानो। <verse eid="JOS 16:8" /><verse number="9" style="v" sid="JOS 16:9" />एने ज्या हेऱ्या मनश्शेन ईसान विचीम एप्रेमी माणहान केरता आप आपणा गावा बेल थोड़ाक हियोर आलेग केराय गीया। <verse eid="JOS 16:9" /><verse number="10" style="v" sid="JOS 16:10" /><note caller="+" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="JDG 1:29">न्यायियो 1:29</ref></char></note>पुण ता गेजेर माय रेणाराह कनानीह नाह निकाल्या, केरीन कनानी माणहे एप्रेमीन विचीम आज वोर रेणे बाजरेनाह, एने मोंजरीन काम केरतेह।<verse eid="JOS 16:10" /></para>
  <chapter eid="JOS 16" />
  <chapter number="17" style="c" sid="JOS 17" />
  <para style="s">पश्चिम माय मनश्शे गेराणान ईस्‍सो</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 17:1" />मनश्शे ते युसूफान पेल्लो बिटोख इतो, केरीन तान गेराणान ईसो चिट्ठी टाकीन ज्‍यो जागो आप्या। मनश्शेन पेल्लो बिटोख गीलादान आबोख माकिर सिपाय इतो, केरीन तान वोसीह गीलाद एने बाशान ने ईसो जुड़नो। <verse eid="JOS 17:1" /><verse number="2" style="v" sid="JOS 17:2" />मनश्शेन कुटूमान दिहरा कुटूमाह बी जागो आप्या, ता कुटूम अबीएजेर, हेलेक, अस्रीएल, शकेम, हेपेर एने शमीदा एता; ज्या आखा मनश्शेन दिहरा सोरा एता, जो युसूफान बिटोख इतो, न्या माणहान कुटूमे थोड़ोक जागो सापड़ाया। <verse eid="JOS 17:2" /><verse number="3" style="v" sid="JOS 17:3" />पुण सलोफाद हेपेरान बिटोख इतो, हेपेर गीलादान बिटोख इतो, गीलाद माकिरान बिटोख इतो, एने माकीर मनश्शेन बिटोख इतो, पुण सलोफादान बेटहेख नाह एता; तान पाच बेटह्युख एत्यु, बेटह्युख ने नाव महला, नोवा, होगला, मिल्का, एने तीर्सा हे। <verse eid="JOS 17:3" /><verse number="4" style="v" sid="JOS 17:4" /><note caller="+" style="x"><char style="xo" closed="false">17:4 </char><char style="xt" closed="false"><ref loc="NUM 27:1-7">गिनती 27:1-7</ref></char></note> तेवी त्यु एलीआजर चाकऱ्यो एने नुन ने बिटोख यहोशु, एने आखा मुखी फाय जाएन केणे बाज गीयो, यहोवा मुसाह उकुम आपेल इतो काय, तो आमुह आमरा बायह्याख ने विचीम ईसो आपी; ते यहोशु यहोवान उकुम मानीन त्युह त्युन आजालाख ने विचीम ईसो आप्यो। <verse eid="JOS 17:4" /><verse number="5" style="v" sid="JOS 17:5" />इह केरीन यरदन नेदीन ती पार गीलाद एने बाशान देसाह सोड़ीन मनश्शेन कुटूमान ईसा माय दोह ईसा उंजु जुड़ना। <verse eid="JOS 17:5" /><verse number="6" style="v" sid="JOS 17:6" />काहाकाय मनश्शेन विचीम मनश्शेन वोसीन सोरीह बी ईसो जुड़नो, एने मनश्शेन दिहरा सोराह गीलाद देस जुड़नो।<verse eid="JOS 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 17:7" />मनश्शेन जागो आशेर एने मीकमतात ने ईलाकान विचीम इतो, ज्‍यो शेकेमान आहने हे; ज्यान एद्दी देक्षिण माय एन तप्‍पुह ने माणहे रेतेह ता वोर जाताली। <verse eid="JOS 17:7" /><verse number="8" style="v" sid="JOS 17:8" />तप्‍पुह गाव ते मनश्शेन एतो, पुण तप्‍पुह हियोर जो मनश्शेन एद्दी पोर एती, एप्रेमीन इतो। <verse eid="JOS 17:8" /><verse number="9" style="v" sid="JOS 17:9" />ओवती तारेन ती एद्‍दी कानान खोदरे वोर पोचीन तान देक्षिण ने उगे वोल गीयी, पुण मनश्शेन हेयरान विची माय एता तीबी एप्रेमान ठेराना; एने मनश्शेन एद्दी खोदरान उत्तर ने उगे एती जी देरीये वोर जात रियेल एती। <verse eid="JOS 17:9" /><verse number="10" style="v" sid="JOS 17:10" />देक्षिण ने उगेवालो देस एप्रेमाह एने उत्तर उगेवालो मनश्शेह जुड़नो, एने तान एद्दी देरीयो ठेरानो; ती उत्तर माय आशेरान उगे पुर्व माय इस्साकार ने एद्दी हेऱ्यी लागेल एती। <verse eid="JOS 17:10" /><verse number="11" style="v" sid="JOS 17:11" />इस्साकार एने आशेरान एद्दी माय मनश्शेह ज्या हियोर जुड़ना, बेतशान एने तान आखा हियोर, बेतशान, यीबलाम एने तान आखा हियोर, दोर माय रेणारे माणहा बेल तान आखा हियोर, तानाक माय रेणारे माणहा बेल, तान आखा हियोर एने मगीद्दो माय रेणारे माणहा बेल तान आखा हियोर, तीसरो ते नापेत बी केवाथे। <verse eid="JOS 17:11" /><verse number="12" style="v" sid="JOS 17:12" /><note caller="+" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="JDG 1:27-28">न्यायियो 1:27-28</ref></char></note>पुण मनश्शेन माणहे ता हेयराह नाह आरीव सेक्‍या, केरीन कनानी माणहे ताहरी रेते रेना। <verse eid="JOS 17:12" /><verse number="13" style="v" sid="JOS 17:13" />पुण इस्राएली माणहे ताकेतवोर एय गीया, तेवी ता कनानवाला माणहाह काम केरावणे बाज गीया, पुण ता कनानी माणहाह बाहेर नाह निकाल सेक्‍या।<verse eid="JOS 17:13" /></para>
  <para style="s">एप्रेम एने मनश्शे गेराणान द्वारा वोदार जागान मांग</para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 17:14" />युसूफान सोरा यहोशुह केणे बाज गीया, “तु आमुह चिट्ठी टाकीन बुयीन फोक्‍तो एक ईलाको आप्यो, पुण आमु जुलूम होवटा माणहे हेते; तु आमुह ता देसान एक ईसोस काहा आप्यो, काहाकाय मालीक आमुह बोरकेत आपेल हे।”<verse eid="JOS 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 17:15" />यहोशु ताह केयो, “केदी तुमू गेणती माय जुलूम एती, एने एप्रेमान बोयड़ावालो देस तुमरी केरता आत्यो एय, ते परिज्जीन एने रपायीन देस जो जेंगलाम हे, ता माय जाएन जाड़ाह काटीन तुमरे रेणेन केरता जागो बाणावो।”<verse eid="JOS 17:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 17:16" />ता यहोशुह जापाप आप्या, “तो बोयड़ावालो देस आमरी केरता आत्यो हे; एने बेतशान एने तान हेयराम रेणारे, एने यिज्रेल ने गाटाम रेणारे, जोला कनानी नेचाला देसाम रेतेह, ता आखा फाय लोड़ान टांगा एता।”<verse eid="JOS 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JOS 17:17" />ओवतो यहोशु एप्रेम, एने मनश्शेन एने युसूफान आखा गेराणान माणहाह केयो, “होव तुमू गेणती माय जुलूम हेते, एने तुमरी ताकेत बी मोठी हे, केरीन तुमूह वोदार बुय जुड़ने जुवे। <verse eid="JOS 17:17" /><verse number="18" style="v" sid="JOS 17:18" />बोयड़ावालो देस बी तुमरो एय जाय; काहाकाय तो जिंगोल ते हे, पुण तान जाड़े काट टाकहो, तेवी तान आहने पाहनेन देस बी तुमरो एय जाय; काहाकाय केदी कनानी माणहे ताकेतवाला रेती, एने ता फाय लोड़ान टांगा बी रेती, तीबी तुमू ताह ता रेन निकाल सिकहो।”<verse eid="JOS 17:18" /></para>
  <chapter eid="JOS 17" />
  <chapter number="18" style="c" sid="JOS 18" />
  <para style="s">वुचेल बुईन वाटणो</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 18:1" />ओवती इस्राएलीन आखी मोंडली शिलो गावा माय एकठी एन ताहरी मिलापवाला तोम्बुह<note caller="+" style="f"><char style="fr" closed="false">18:1 </char><char style="fq" closed="false">मिलापवाला तोम्बुह </char><char style="ft" closed="false">जाहरी बोगवानान उपस्तिथी रेणे </char></note> उब राखाड्या; काहाकाय देस तान ताबाम आव जायेल इतो। <verse eid="JOS 18:1" /><verse number="2" style="v" sid="JOS 18:2" />पुण तुलबुखे बी इस्राएल ने हात कुटूमे ओहला एता, जाह बोगवानान द्‍वारा वचन आपाणेन पोर बी ताह आपेल जागो नाह जुड़नो। <verse eid="JOS 18:2" /><verse number="3" style="v" sid="JOS 18:3" />केरीन यहोशु इस्राएल ने माणहाह केयो, “जो देस तुमरा डायडायान बोगवान यहोवा तुमूह आपेल हे, ताह तुमरे आदिकार माय केर लेणेम तुमू केवीह वोर डिल्लाय केरते रिहो? <verse eid="JOS 18:3" /><verse number="4" style="v" sid="JOS 18:4" />एवी एक एक कुटूमाम रेन तीन माणहे निवाड़ो जाह मी मोकलु काय ता देसान एक एक ईलाकाम जाय जाएन देखी, एने तान ईसान पारमाणे तान हाल लेख लेखीन मार फाय आवी। <verse eid="JOS 18:4" /><verse number="5" style="v" sid="JOS 18:5" />ता देसाह हात ईसाम वाट लेय, यहुदान माणहे देक्षिण उगे तान ईसाम रेती एने युसूफ ने गेराणान माणहे उत्तर उगे तान ईसाम रेती। <verse eid="JOS 18:5" /><verse number="6" style="v" sid="JOS 18:6" />एने तुमू देसान हात ईलाकान जाणकारी लेखीन मार फाय लेन आवो; एने मी न्‍याहरी तुमरी केरता आपणो बोगवान यहोवान सामने चिट्ठी टाकुह। <verse eid="JOS 18:6" /><verse number="7" style="v" sid="JOS 18:7" />एने लेवीन तुमरे विचीम काल्लो ईसो नाय रेय, काहाकाय यहोवान आपेल चाकर्‍यान पोदुस तान ईसो हे; एने गाद, रूबेन, एने मनश्शेन आदा गेराणान माणहे बी यरदन ने पुर्व उगे यहोवान सेवक मुसान आपेल तान तान ईसो सापड़ाव लियेल हेते।”<verse eid="JOS 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 18:8" />तेवी ता एदमी उठीन चाल देना एने जा ता देसान हाल लेखणेन जाताला, ताह यहोशु ज्‍यो उकुम आप्यो, “देसान एक कोपरे रेन दिहरे कोपरे वोर जाय जाएन तान हाल लिखो; ओवता मार फाय पोशा आवज्‍यो; एने मी न्‍याहरी शिलो माय यहोवान सामने तुमरी केरता चिट्ठी टाकुह।” <verse eid="JOS 18:8" /><verse number="9" style="v" sid="JOS 18:9" />तेवी ता एदमी देसान एक कोपरे रेन दिहरे कोपरे वोर फिरना, एने तान हेयरान हात ईसा केरीन तान हाल पुस्तेक माय लेखीन शिलोन पाड़ावाम यहोशु फाय आवा। <verse eid="JOS 18:9" /><verse number="10" style="v" sid="JOS 18:10" />तेवी यहोशु शिलो माय यहोवान सामने तान केरता चिट्ठ्यु टाक्‍यो; एने यहोशु ताहरी इस्राएल ने माणहाह तान ईसा पारमाणे देस वाट दिनो।<verse eid="JOS 18:10" /></para>
  <para style="s">बिन्यामीन गेराणाह आपेल ईस्‍सो</para>
  <para style="p">
    <verse number="11" style="v" sid="JOS 18:11" />बिन्यामीन कुटूमान चिट्ठी तान गेराणान पारमाणे निकल्यी, एने चिट्ठीन पारमाणे तान ईसो यहुदान वोसीन एने युसूफ वोसीन ईसान विचीम पोड़नो। <verse eid="JOS 18:11" /><verse number="12" style="v" sid="JOS 18:12" />एने तान उत्तर उगेवाली एद्दी यरदन रेन सुरवात एनी, एने यरीहोन उत्तर उगे रेन चेड़तेन पश्‍चिम ने उगे बोयड़ावाला देसाम लागती बेतावेन ने जेंगलाम निकेलनी; <verse eid="JOS 18:12" /><verse number="13" style="v" sid="JOS 18:13" />तारेन एद्दी लुज ने देक्षिण उगे मतलब बेतेल पोचनी, ओवती ता बोयड़ान आहने अत्रोतदार पोर उतेरनी जो नेचाला बेथोरोनान देक्षिण माय हे। <verse eid="JOS 18:13" /><verse number="14" style="v" sid="JOS 18:14" />ओवती पश्‍चिम उगेवाली एद्दी वोलीन बेथोरोनान सामने एने तान देक्षिण उगेवाला बोयड़े लागती, किर्यतबाल मतलब किर्यत्‍यारीम नावान यहुदान एक हेयराम निकल्यी; पश्‍चिम ने एद्दी ज्‍यीस एती। <verse eid="JOS 18:14" /><verse number="15" style="v" sid="JOS 18:15" />ओवती देक्षिण ने उगेवाली एद्दी पश्‍चिम रेन सुरवात एन किर्यत्यारीम ने सेवटे रेन निकलीन नेप्तोह ने पाण्यान जिरा पोर पोचनी; <verse eid="JOS 18:15" /><verse number="16" style="v" sid="JOS 18:16" />एने ता बोयड़ान सेवटा पोर उतेरनी, जी हिन्‍नोमान बेटाख ने गाटान सामने एने रपाईम नावान गाटान उत्तर उगे हे; ता रेन ती हिन्‍नोमान गाटाम, मतलब यबूसीन देक्षिण उगे लागती एनरोगेल जिर वोर जात रेनी। <verse eid="JOS 18:16" /><verse number="17" style="v" sid="JOS 18:17" />ता रेन ती उत्तर उगे वोलीन एनशेमेश रेन निकलीन ता गलीलोत ने उगे गियी, जी अदुम्मिम चेड़तीन सामने हे, ओवती ता रेन ती रूबेन ने बिटोख बोहन ने देगड़े वोर उतेर गियी; <verse eid="JOS 18:17" /><verse number="18" style="v" sid="JOS 18:18" />एने ता रेन ती उत्तर उगे जाएन यरदन नेदीन सामनेवालो बोयड़ान उगे लागती अराबा माय उतेरनी; <verse eid="JOS 18:18" /><verse number="19" style="v" sid="JOS 18:19" />तेवी ज्यी एद्दी बेथोगलान उत्तर ईसाम जाएन खारा देरीयान उत्तर ने खाड़ी पोर, मतलब यरदन नेदीन देक्षिण ने मुयाला पोर निवरी गियी, देक्षिण ने एद्दी ज्‍यीस एती। <verse eid="JOS 18:19" /><verse number="20" style="v" sid="JOS 18:20" />एने पुर्व उगे यरदन नेदीन एद्दी एती, इहकेरीन ज्यी बुय एती जी बिन्यामीन ने कुटूमाह आपेल; ज्‍यु कावदेन वाल्यु एद्दयु एत्यु।<verse eid="JOS 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 18:21" />बिन्यामीन ने कुटूमाह तान वोचीन पारमाणे ज्या हियोर जुड़ना, यरीहो, बेथोगला, एने एमेक्कसीस, <verse eid="JOS 18:21" /><verse number="22" style="v" sid="JOS 18:22" />बेतराबा, समारेम, बेतेल, <verse eid="JOS 18:22" /><verse number="23" style="v" sid="JOS 18:23" />अव्वीम, पारा, ओप्रा, <verse eid="JOS 18:23" /><verse number="24" style="v" sid="JOS 18:24" />कपरम्मोनी, ओफनी एने गेबा; ज्या बारा हियोर एने तावाला गाव जुड़ना। <verse eid="JOS 18:24" /><verse number="25" style="v" sid="JOS 18:25" />ओवतो गीबोन, रामाह, बेरोत, <verse eid="JOS 18:25" /><verse number="26" style="v" sid="JOS 18:26" />मीस्पा, कपीरा, मोसा, <verse eid="JOS 18:26" /><verse number="27" style="v" sid="JOS 18:27" />रेकेम, यिर्पेल, तरला, <verse eid="JOS 18:27" /><verse number="28" style="v" sid="JOS 18:28" />सेला, एलेप, यबूस मतलब यरूशलेम, गीबा एने किर्यत; ज्या चोवदा हियोर एने तावाला आखा गाव, बिन्यामीन ने ईसो तान कुटूमा पारमाणे ज्‍योस एतो।<verse eid="JOS 18:28" /></para>
  <chapter eid="JOS 18" />
  <chapter number="19" style="c" sid="JOS 19" />
  <para style="s">शिमोन गेराणाह आपेल ईस्‍सो</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 19:1" />दिहरी चिट्ठी शिमोनान नावा पोर, मतलब शीमोनान गेराणान नावा पोर तान वोची पारमाणे निकल्यी, एने तान ईसो यहुदान ईसान विचीम ठेरानो। <verse eid="JOS 19:1" /><verse number="2" style="v" sid="JOS 19:2" /><note caller="+" style="x"><char style="xo" closed="false">19:2 </char><char style="xt" closed="false"><ref loc="1CH 4:28-33">1 इतिहास 4:28-33</ref></char></note>तान ईसाम ज्या हियोर हेते, बेर्शेबा मतलब शेबा, मोलादा, <verse eid="JOS 19:2" /><verse number="3" style="v" sid="JOS 19:3" />हसरशुआल, बाला, एसेम, <verse eid="JOS 19:3" /><verse number="4" style="v" sid="JOS 19:4" />एलतोलद, बतुल, होर्मा, <verse eid="JOS 19:4" /><verse number="5" style="v" sid="JOS 19:5" />सीकलग, बेत्‍मर्काबोत, हसेर्शुसा, <verse eid="JOS 19:5" /><verse number="6" style="v" sid="JOS 19:6" />बेतलबाओत, एने शारूहेन; ज्या तेरा हियोर एने तावाला गाव ताह जुड़ना।<verse eid="JOS 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 19:7" />ताह ऐन, रिम्मोन, एतेर, एने आशान ज्या चार हियोर एने तावाला गाव जुड़ना; <verse eid="JOS 19:7" /><verse number="8" style="v" sid="JOS 19:8" />एने बालत्बेर मतलब नेगेब ने रामा वोर ज्या हेयरान कावदेन आखा गाव बी न्याह जुड़ना, शिमोनीन गेराणान ईसो तान वोची पारमाणे ज्‍योस ठेरानो। <verse eid="JOS 19:8" /><verse number="9" style="v" sid="JOS 19:9" />शिमोनी माणहान ईसो यहुदा वोचीन ईसाम रेन आपानो; काहाकाय यहुदान ईसो तानकेरता जुलूम इतो, केरीन शीमोनी माणहान ईसो तास ने ईसान विचीम ठेरानो।<verse eid="JOS 19:9" /></para>
  <para style="s">जबुलून गेराणाह आपेल ईस्‍सो</para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 19:10" />तिसरी चिट्ठी जबुलून ने वोची पारमाणे तान कुटूमान नावा पोर निकल्यी, एने तान ईसान एद्‍दी सारीद जागे वोर पोचनी। <verse eid="JOS 19:10" /><verse number="11" style="v" sid="JOS 19:11" />एने तान एद्दी पश्‍चिम उगे मरला जागे लागती दब्‍बेशेत माय पोचनी; एने योकनाम ने सामने खोदेर वोर पोचनी। <verse eid="JOS 19:11" /><verse number="12" style="v" sid="JOS 19:12" />पोशी सारीद रेन ती पुर्व उगे वोलीन किसलोत्तारोबान एद्दी वोर पोचनी, एने तारेन ओंगाण जाएन दाबरत माय एने यापी उगे जात रेनी <verse eid="JOS 19:12" /><verse number="13" style="v" sid="JOS 19:13" />ता रेन ती पुर्व उगे ओंगाण जाएन गथेपेर एने इत्कासीन गीयी, एने ता रिम्मोन माय निकल्यी जो नेआ वोर पोसीर रेनीह; <verse eid="JOS 19:13" /><verse number="14" style="v" sid="JOS 19:14" />तारेन ती एद्दी तान उत्तर उगे वोलीन हन्‍नातोन वोर पोचनी, एने यिप्‍तहेलान गाटाम जाय निकेलनी; <verse eid="JOS 19:14" /><verse number="15" style="v" sid="JOS 19:15" />कत्तात, नहलाल, शिम्रोन, यिदला, एने बेथलेहेम; ज्या बारा हियोर एने तावाला गाव तास ईसान ठेराना। <verse eid="JOS 19:15" /><verse number="16" style="v" sid="JOS 19:16" />जबुलून माणहान ईसो तान वोची पारमाणे ज्‍योस ठेरानो; एने ताम तान तान गावा बेल ज्यास हियोर हेते।<verse eid="JOS 19:16" /></para>
  <para style="s">इस्‍साकार गेराणाह आपेल ईस्‍सो</para>
  <para style="p">
    <verse number="17" style="v" sid="JOS 19:17" />चोवथी चिट्ठी इस्साकार ने वोसी पारमाणे तान नावा पोर निकेलनी। <verse eid="JOS 19:17" /><verse number="18" style="v" sid="JOS 19:18" />एने तान एद्दी यिज्रेल, कसुल्लोत, शुनेम <verse eid="JOS 19:18" /><verse number="19" style="v" sid="JOS 19:19" />हपारेम, शीओन, अनाहरत, <verse eid="JOS 19:19" /><verse number="20" style="v" sid="JOS 19:20" />रब्बीत, किश्‍योन, एबेस, <verse eid="JOS 19:20" /><verse number="21" style="v" sid="JOS 19:21" />रेमेत, एनगन्नीम, एनहद्दा, एने बेत्‍पस्‍सेस वोर पोचनी। <verse eid="JOS 19:21" /><verse number="22" style="v" sid="JOS 19:22" />ओवती ती एद्दी ताबोर, शहसुमा एने बेतशेमेश वोर पोचनी, एने तान एद्दी यरदन नेदी वोर जाय निकेलनी; इहकेरीन ताह सोला हियोर तावाला गावा बेल जुड़ना। <verse eid="JOS 19:22" /><verse number="23" style="v" sid="JOS 19:23" />इस्साकार ने गेराणान ईसो तान वोसी पारमाणे हियोर एने गावा बेल ज्‍योस ठेरानो।<verse eid="JOS 19:23" /></para>
  <para style="s">आशेर गेराणाह आपेल ईस्‍सो</para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 19:24" />पाचवी चिट्ठी आशेरीन गेराणान वोची पारमाणे तान नावा पोर निकेलनी। <verse eid="JOS 19:24" /><verse number="25" style="v" sid="JOS 19:25" />तान एद्दीम हेलकात, हली, बेतेन, अक्षाप, <verse eid="JOS 19:25" /><verse number="26" style="v" sid="JOS 19:26" />अलाम्‍मेलेक, अमाद, एने मीशाल एता; एने ती पश्‍चिम उगे कर्मेल वोर एने शीहोरलीबनात वोर पोचनी। <verse eid="JOS 19:26" /><verse number="27" style="v" sid="JOS 19:27" />ओवती एद्दी पुर्व उगे वोलीन बेतदागोन गियी, एने जबुलूनान ईसा वोर, एने यिप्‍तहेलान गाटाम उत्तर उगे लागती बेतेमेक एने नीएल वोर पोचनी एने उत्तर उगे जाएन काबुल वोर निकेलनी, <verse eid="JOS 19:27" /><verse number="28" style="v" sid="JOS 19:28" />एने ती एब्रोन, रहोब, हम्‍मोन, एने काना लागती मोटला सीदोन पोचनी; <verse eid="JOS 19:28" /><verse number="29" style="v" sid="JOS 19:29" />ता रेन ती एद्दी वोलीन रामाह लागती सोर <note caller="+" style="f"><char style="fr" closed="false">19:29 </char><char style="fq" closed="false">सोर </char><char style="ft" closed="false">तिरस</char></note>नावान किल्‍लावाला हियोर वोर जात रेनी; ओवती एद्दी होसान उगे वोलीन महलाब अकजीबान आहनेवाला देसाम लागती देरीयो वोर जाय निकेलनी, <verse eid="JOS 19:29" /><verse number="30" style="v" sid="JOS 19:30" />उम्मा, अपेक, एने रहोब बी तान ईसाम ठेराय; इहकेरीन बावीस हियोर तान तान गावा बेल ताह जुड़ना। <verse eid="JOS 19:30" /><verse number="31" style="v" sid="JOS 19:31" />आशेरीन वोसी पारमाणे तान ईसा हियोर एने गावा बेल ज्यास जुड़ना।<verse eid="JOS 19:31" /></para>
  <para style="s">नप्ताली गेराणाह आपेल ईस्‍सो</para>
  <para style="p">
    <verse number="32" style="v" sid="JOS 19:32" />सोव्‍वी चिट्ठी नप्तालीन वोची पारमाणे तान नावा पोर निकेलनी। <verse eid="JOS 19:32" /><verse number="33" style="v" sid="JOS 19:33" />एने तान एद्दी हेलेप रेन, एने सान्नीम ने वांज जाड़े रेन, अदामीनेकेब एने यबनेल लागती लक्कुम वोर जात रेनी, एने यरदन नेदी माय निवरी जाताली। <verse eid="JOS 19:33" /><verse number="34" style="v" sid="JOS 19:34" />ता रेन ती एद्दी पश्‍चिम उगे वोलीन अजनोत्तबोर, एने ता रेन हुकोक पोचनी, एने देक्षिण, एने जबुलूनान ईसा वोर, एने पश्‍चिम उगे आशेरान ईसा वोर, एने पुर्व उगे यहुदान ईसान आहनेवाली यरदन नेदी पोर पोचनी। <verse eid="JOS 19:34" /><verse number="35" style="v" sid="JOS 19:35" />एने तान किल्‍लावाला हियोर ज्या हेते, मतलब सीद्दीम, सेर, हम्‍मत, रक्कत, किन्नेरेत, <verse eid="JOS 19:35" /><verse number="36" style="v" sid="JOS 19:36" />अदामा, रामाह, हासोर, <verse eid="JOS 19:36" /><verse number="37" style="v" sid="JOS 19:37" />केदेश, एद्रेई, एन्हासोर, <verse eid="JOS 19:37" /><verse number="38" style="v" sid="JOS 19:38" />यीरोन, मीगदलेल, होरेम, बेतनात, एने बेतशेमेश; ज्या उगणीह हियोर गावा बेल ताह जुड़ना। <verse eid="JOS 19:38" /><verse number="39" style="v" sid="JOS 19:39" />नप्ताली गेराणान ईसा तान वोची पारमाणे हियोर एने तान गावा बेल ज्‍योस जुड़नो।<verse eid="JOS 19:39" /></para>
  <para style="s">दान गेराणाह आपेल ईस्‍सो</para>
  <para style="p">
    <verse number="40" style="v" sid="JOS 19:40" />हातवी चिट्ठी वोची पारमाणे दान ने गेराणान नावा पोर निकेलनी। <verse eid="JOS 19:40" /><verse number="41" style="v" sid="JOS 19:41" />एने तान ईसान एद्दी माय सोरा, एश्ताओल, ईरशेमेश, <verse eid="JOS 19:41" /><verse number="42" style="v" sid="JOS 19:42" />शालब्बीन, अयालोन, यीतला, <verse eid="JOS 19:42" /><verse number="43" style="v" sid="JOS 19:43" />एलोन, तिम्नाह, एक्रोन, <verse eid="JOS 19:43" /><verse number="44" style="v" sid="JOS 19:44" />एलतके, गीब्‍बतोन, बालात, <verse eid="JOS 19:44" /><verse number="45" style="v" sid="JOS 19:45" />यहुद, बनेबराक, गत्रीम्‍मोन, <verse eid="JOS 19:45" /><verse number="46" style="v" sid="JOS 19:46" />मेयर्कोन, एने रक्कोन ठेराय, एने याफान सामनेवाली एद्दी बी तान एती। <verse eid="JOS 19:46" /><verse number="47" style="v" sid="JOS 19:47" /><note caller="+" style="x"><char style="xo" closed="false">19:47 </char><char style="xt" closed="false"><ref loc="JDG 18:27-29">न्यायियो 18:27-29</ref></char></note> एने दानान ईसो उंजु वोदार एय गीयो, काहाकाय दानी लेशम पोर चेड़ाय केरीन ताह जिक लेदा, एने ताह तालवार केरीन मारीन ताह तान ताबाम केरीन ताम रेणे बाज गीया, एने तान डायडायान नावा पोर लेमेशान नाव दान मेल्या। <verse eid="JOS 19:47" /><verse number="48" style="v" sid="JOS 19:48" />वोसी पारमाणे दान ने गेराणान ईसो हियोर एने गावा बेल ज्‍योस ठेरानो।<verse eid="JOS 19:48" /></para>
  <para style="s">यहोशुह बी जागो जुड़नो</para>
  <para style="p">
    <verse number="49" style="v" sid="JOS 19:49" />जेवी देसान वाटणो एद्‍दीन पारमाणे पुरो एय गीयो, तेवी इस्राएली नुन ने बिटोख यहोशुह बी तान विचीम एक ईसो आप्या। <verse eid="JOS 19:49" /><verse number="50" style="v" sid="JOS 19:50" />यहोवान केणेन गेत ता ताह तान मांगेल हियोर आप्या, ज्‍यो एप्रेमान बोयड़ावाला देसावालो तीम्‍नातसेरह हे; एने तो ता हेयराह पोशो वोहाड़ीन ताम रेणे बाज गीयो।<verse eid="JOS 19:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="JOS 19:51" />जा जा ईसा एलीआजर चाकऱ्यो, एने नुन ने बिटोख यहोशु, एने इस्राएलीन गेराणान डायडायान मुखी मुखी एदमी शिलो माय, मिलापवाला तोम्बुन बायणा पोर यहोवान सामने चिट्ठी टाक टाकीन वाट दियेल ता ज्यास हेते; इहकेरीन ता देसाह वाटणेन काम पुरो केऱ्या।<verse eid="JOS 19:51" /></para>
  <chapter eid="JOS 19" />
  <chapter number="20" style="c" sid="JOS 20" />
  <para style="s">आसरान हेयरान ठेरावणो</para>
  <para style="r">(<ref loc="NUM 35:9-34">गिनती 35:9-34</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 20:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">20:1 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 35:9-34">गिनती 35:9-34</ref>; <ref loc="DEU 4:41-43">व्यवस्था 4:41-43</ref>; <ref loc="DEU 19:1-13">19:1-13</ref></char>
    </note>उवतो बोगवान यहोशुह केयो, <verse eid="JOS 20:1" /><verse number="2" style="v" sid="JOS 20:2" />इस्राएल माणहाह ज्‍य के, “तुमू तुमरी केरता आसरान हेयरान चेरचा किरेल इतो तान पारमाणे ताह निवाड़ीन मीलो, <verse eid="JOS 20:2" /><verse number="3" style="v" sid="JOS 20:3" />केदी एखेह माणुह एगदा माणहाह बुलचूक माय मार देय, तो ता हेयराम नाह जाय, एने ता खुनान बोदलो लेणारे माणहाह रेन वोचणेन केरता तुमरा आसरान हियोर ठेराती। <verse eid="JOS 20:3" /><verse number="4" style="v" sid="JOS 20:4" />तो माणुह ता गावाम रेन एगदा हेयराम नाह जाय, एने ता हेयरान बायणा पोर उबरीन ता गावान डायडायान सामने तान काम केय होमलावे; तेवी ता ताह गावाम तान विचीम रेणेन केरता जागो आपी, जा माय तो ता हिऱ्यो रेय। <verse eid="JOS 20:4" /><verse number="5" style="v" sid="JOS 20:5" />एने केदी खुनान बोदलो लेणार तान पासाण लागीन तान पासाण आवी, ताहार ता खुनीह तान आथाम नाय हुपे, काहाकाय तो तान आहेंल्‍याह बुलचूक माय एने पेल ता हिऱ्यो बिगेर दुसमोनाय मेलीन माऱ्यो। <verse eid="JOS 20:5" /><verse number="6" style="v" sid="JOS 20:6" />एने जाह वोर तो मोंडलीन सामने नियावान केरता उबी नाय रेय, एने जाह वोर ता दिह्यान मुखी चाकऱ्यो नाय मोर जाय, ताह वोर तो तास हेयराम रेय; तान बाद तो खुनी तान गावाम जाएन तान गेरा माय पोशो रेय।”<verse eid="JOS 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 20:7" />केरीन इस्राएल ने माणहे नप्तालीन बोयड़ावाला देसाम गेलील ने केदेशाह, एने एप्रेमान बोयड़ावाला देसाम शेकेमाह, एने यहुदान बोयड़ावाला देसाम किर्यतर्बा, जो हेब्रोन बी केवाथे, आसरान जागो चोखालो ठेरायो। <verse eid="JOS 20:7" /><verse number="8" style="v" sid="JOS 20:8" />एने यरीहोन आहने यरदन नेदीन पुर्व उगे रूबेन ने गेराणान ईसाम बेसेराह, जो जेंगलाम सापाट जागा पोर वोह रिनोह, एने गादान गेराणान ईसाम गीलादान रामोताह, एने मनश्शेन गेराणान ईसाम बाशान ने गोलान गावाह ठेराया। <verse eid="JOS 20:8" /><verse number="9" style="v" sid="JOS 20:9" />आखा इस्राएलीन केरता, एने तान विचीम रेणारे पाराया देसावालान केरता बी, जा गावे ठेराय गीया, काय जो कुण एगदा माणहाह बुलचूक माय मार देय तो ताम रेन एगदा गावाम नाह जाय, एने मोंडलीन सामने उब रेणेन पेल खुनान बोदलो लेणारान आथा केरीन नाय माराय।<verse eid="JOS 20:9" /></para>
  <chapter eid="JOS 20" />
  <chapter number="21" style="c" sid="JOS 21" />
  <para style="s">लेवीह हियोर आपणो</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 21:1" />तेवी लेवीन डायडायान गेराणान मुखी मुखी एदमी एलीआजर चाकऱ्यो, एने नुन ने बिटोख यहोशु, एने इस्राएली गेराणान डायडायान गेराणान मुखी मुखी एदम्या फाय आवीन <verse eid="JOS 21:1" /><verse number="2" style="v" sid="JOS 21:2" /><note caller="+" style="x"><char style="xo" closed="false">21:2 </char><char style="xt" closed="false"><ref loc="NUM 35:1-8">गिनती 35:1-8</ref></char></note>कनान देसान शिलो गावाम केणे बाज गीया, “यहोवा मुसाह उकुम आपेल इतो काय तुमू आमुह रेणेन केरता गाव आपी, एने तुमू आमुह चोवगानान जागो आपी जा माय आमरा जेनवार चेर सेकती।” <verse eid="JOS 21:2" /><verse number="3" style="v" sid="JOS 21:3" />तेवी इस्राएली माणहे यहोवान ता उकुमाह मान्या, ता आप आपणा ईसाम रेन लेवीह चारायीन जागा बेल ज्या गावे आप्या।<verse eid="JOS 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOS 21:4" />तेवी कहातीन कुटूमान नावा पोर चिट्ठी निकल्यी, केरीन लेवी माय रेन हारून चाकऱ्यान सोराह यहुदा, शिमोन एने बिन्यामीन ने गेराणान ईसाम रेन तेरा गावे जुड़ना। <verse eid="JOS 21:4" /><verse number="5" style="v" sid="JOS 21:5" />बाकीन काहातीह चिट्ठी टाकीन दोह गावे आपेल एता, ज्या दोह गावे एप्रेम, दान एने मनश्शेन कुटूमान आदा गेराणान ईसाम रेन एता।<verse eid="JOS 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 21:6" />गेर्शोन कुटूमान माणहाह तेरा गावे चिट्ठी टाकीन आपेल एता, ज्या गावे इस्साकार, आशेर, नप्ताली एने बाशान माय मनश्शेन आदा कुटूमान एता।<verse eid="JOS 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 21:7" />ओवतो वोसीन गेत मरारी कुटूमान माणहाह रूबेन, गाद, एने जबुलूनान गेराणान ईसाम रेन बारा गावे आपाना।<verse eid="JOS 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 21:8" />जो उकुम यहोवा मुसान द्‍वारा आपेल इतो, तान गेत इस्राएल ने माणहे लेवीह चारायीन जागा बेल ज्या गावे चिट्ठी टाक टाकीन आप्या।<verse eid="JOS 21:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="JOS 21:9" />ता यहुदा एने शिमोनीन गेराणान ईसाम रेन ज्या गावे जान नाव लिखेल हे आप्या; <verse eid="JOS 21:9" /><verse number="10" style="v" sid="JOS 21:10" />ज्या गावे लेवी कहाती कुटूमाम रेन हारूनान सोरान केरता एता; काहाकाय पेल्‍ली चिट्ठी तास ने नावा पोर निकलेल एती।<verse eid="JOS 21:10" /></para>
  <para style="pi">
    <verse number="11" style="v" sid="JOS 21:11" />ता ताह यहुदान बोयड़ावाला देसाम कावदेन चारायीन जागा बेल किर्यतर्बा गाव आप देना, जो अनाकान आबोख अर्बान नावा पोर केवानो एने हेब्रोन बी केवाथे। <verse eid="JOS 21:11" /><verse number="12" style="v" sid="JOS 21:12" />पुण ता हेयरान खेत एने तान गाव ता यपुन्नेन बिटोख कालेबाह तान सोतान बुय केरीन आप देना।<verse eid="JOS 21:12" /></para>
  <para style="pi">
    <verse number="13" style="v" sid="JOS 21:13" />तेवी ता हारून चाकऱ्यान सोराह चारायीन बेल खुनीन आसरान गाव हेब्रोन, एने आप आपणा चारायीन जागा बेल लीबना, <verse eid="JOS 21:13" /><verse number="14" style="v" sid="JOS 21:14" />यत्तीर, एश्‍तमो, <verse eid="JOS 21:14" /><verse number="15" style="v" sid="JOS 21:15" />होलोन, दबीर, <verse eid="JOS 21:15" /><verse number="16" style="v" sid="JOS 21:16" />ऐन, युत्ता एने बेतशेमेश आप्या; इहकेरीन ता दुयू गेराणान ईसाम रेन नोव गावे आपाना।<verse eid="JOS 21:16" /></para>
  <para style="pi">
    <verse number="17" style="v" sid="JOS 21:17" />एने बिन्यामीन ने कुटूमान ईसाम रेन तान तान चारायीन जागा बेल ज्या चार गावे आपाना, मतलब गीबोन, गेबा, <verse eid="JOS 21:17" /><verse number="18" style="v" sid="JOS 21:18" />अनातोत एने अल्मोन, चारायीन जागा बेल चार गावे। <verse eid="JOS 21:18" /><verse number="19" style="v" sid="JOS 21:19" />इह केरीन हारून वोचीन चाकऱ्याह तेरा गावे एने तान चारायीन जागा जुड़ना।<verse eid="JOS 21:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="JOS 21:20" />ओवता बाकीन कहाती लेवीन गेराणान ईसान गावे चिट्ठी टाक टाकीन एप्रेमान गेराणान ईसाम रेन आप्या।<verse eid="JOS 21:20" /></para>
  <para style="pi">
    <verse number="21" style="v" sid="JOS 21:21" />मतलब ताह चारायीन जागा बेल एप्रेमान बोयड़ावाला देसाम खुनीन आसरो लेणेन शेकेम गाव आपानो, ओवता आप आपणो चारायीन जागा बेल गेजेर, <verse eid="JOS 21:21" /><verse number="22" style="v" sid="JOS 21:22" />किबसेम, एने बेथोरोन; ज्या चार गावे आपाना।<verse eid="JOS 21:22" /></para>
  <para style="pi">
    <verse number="23" style="v" sid="JOS 21:23" />एने दानान गेराणान ईसाम रेन आप आपणो चारायीन जागा बेल, एलतके, गीब्‍बतोन, <verse eid="JOS 21:23" /><verse number="24" style="v" sid="JOS 21:24" />अयालोन, एने गत्रीम्‍मोन; ज्या चार गावे आपाना।<verse eid="JOS 21:24" /></para>
  <para style="pi">
    <verse number="25" style="v" sid="JOS 21:25" />एने मनश्शेन आदा गेराणान ईसाम रेन आप आपणो चारीन जागा बेल तानाक एने गत्रीम्‍मोन; ज्या दुय गाव आपाना।<verse eid="JOS 21:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="JOS 21:26" />इहकेरीन बाकी कहातीन गेराणान आखा गावे चारायीन जागा बेल दोह ठेराना।<verse eid="JOS 21:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="JOS 21:27" />ओवतो लेवीन गेराणामवाला गेर्शोन मनश्शेन आदा गेराणान ईसाम रेन, आप आपणो चारायीन जागा बेल खुनीन आसरान गाव बाशान ने गोलान एने बेशतरा, ज्या दुय गावे आपाना।<verse eid="JOS 21:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="JOS 21:28" />एने इस्साकार ने गेराणान ईसाम रेन आप आपणा चारायीन जागा बेल किश्‍योन, दाबरत, <verse eid="JOS 21:28" /><verse number="29" style="v" sid="JOS 21:29" />यर्मुत, एने एनगन्नीम, ज्या चार गावे आपाना।<verse eid="JOS 21:29" /></para>
  <para style="m">
    <verse number="30" style="v" sid="JOS 21:30" />एने आशेरान गेराणान ईसाम रेन आप आपणा चारायी बेल मीशाल, अब्दोन, <verse eid="JOS 21:30" /><verse number="31" style="v" sid="JOS 21:31" />हेलकात, एने रहोब; ज्या चार गावे आपाना।<verse eid="JOS 21:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="JOS 21:32" />एने नप्तालीन गेराणान ईसाम रेन आप आपणा चारायीन जागा बेल खुनीन आसरान गाव गेलील ने केदेश, हम्‍मोतदोर, एने कर्तान; ज्या तीन गावे आप्या। <verse eid="JOS 21:32" /><verse number="33" style="v" sid="JOS 21:33" />गेर्शोनीह तान गेराणान गेत चारायीन जागा बेल आखास तेरा गावे जुड़ना।<verse eid="JOS 21:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="JOS 21:34" />ओवता बाकी लेवीह, मतलब मरारीन गेराणाह जबुलूनान गेराणान ईसाम रेन आप आपणा चारायीन जागा बेल योकनाम, कर्ता, <verse eid="JOS 21:34" /><verse number="35" style="v" sid="JOS 21:35" />दिम्ना एने नहलाल; ज्या चार गावे आप्या।<verse eid="JOS 21:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="JOS 21:36" />एने रूबेन ने गेराणान ईसाम रेन आप आपणा चारायीन जागा बेल बेसेर, यहस, <verse eid="JOS 21:36" /><verse number="37" style="v" sid="JOS 21:37" />कदेमोत, एने मेपात; ज्या चार गावे आप्या।<verse eid="JOS 21:37" /></para>
  <para style="m">
    <verse number="38" style="v" sid="JOS 21:38" />एने गादान गेराणान ईसाम रेन आप आपणा चारायीन जागा बेल खुनीन आसरान गाव गीलादवालो रामोत, ओवतो महनेम, <verse eid="JOS 21:38" /><verse number="39" style="v" sid="JOS 21:39" />हेशबोन, एने याजेर, जो आखा मिलावीन चार गावे हेते आप्या।<verse eid="JOS 21:39" /></para>
  <para style="m">
    <verse number="40" style="v" sid="JOS 21:40" />लेवीन बाकी गेराणा मतलब मरारीन गेराणान गेत तान आखा गावे ज्यास ठेराना, इह केरीन ताह बारा गावे चिट्ठी टाक टाकीन आप्या।<verse eid="JOS 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JOS 21:41" />इस्राएलीन सोतान जागान विचीम लेवीन आखा गाव आप आपणा चारायीन जागा बेल आट्‍ठेचाड़ीस ठेराना।<verse eid="JOS 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JOS 21:42" />ज्या आखा गाव आप आपणा कावदेन वाला चारायीन जागा हेऱ्या ठेराना; ज्या आखा गावान ज्‍यीस देशा एती।<verse eid="JOS 21:42" /></para>
  <para style="s">इस्राएली माणहान कनान देसा पोर पुरो आदिकार</para>
  <para style="p">
    <verse number="43" style="v" sid="JOS 21:43" />इहकेरीन यहोवा इस्राएलीह तो आखो देस आप्या, जाह तो तान डायडाया हिऱ्यो सुगोण खाएन आपणेन कियेल इतो; एने ता तान आदिकारी एन ताम रेणे बाज गीया। <verse eid="JOS 21:43" /><verse number="44" style="v" sid="JOS 21:44" />एने यहोवा त्यु आख्‍यु वातुन गेत, जो तो तान डायडाया हिऱ्यो सुगोण खाएन कियेल इतो, ताह कावदेन आराम आप्यो; एने तान दुसमोना माय रेन कुण बी तान सामने टिक नाह सीकनो; काहाकाय यहोवा ता आखाह तान ताबाम केर दिनो। <verse eid="JOS 21:44" /><verse number="45" style="v" sid="JOS 21:45" />जोली बोलायीन वातु यहोवा इस्राएल ने गेराणाह कियेल इतो ताम रेन काल्ली बी वात नाह सुटनी; आखीन आखी पुरी एनी।<verse eid="JOS 21:45" /></para>
  <chapter eid="JOS 21" />
  <chapter number="22" style="c" sid="JOS 22" />
  <para style="s">यहोशुन पुर्व माय रेणारे गेराणाह तान गेर जाणेन पारवांगी</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 22:1" />तेवी यहोशु रूबेन, गादी, एने मनश्शेन आदा गेराणान माणहाह हादिन केयो, <verse eid="JOS 22:1" /><verse number="2" style="v" sid="JOS 22:2" /><note caller="+" style="x"><char style="xo" closed="false">22:2 </char><char style="xt" closed="false"><ref loc="NUM 32:20-32">गिनती 32:20-32</ref>; <ref loc="JOS 1:12-15">यहोशु 1:12-15</ref></char></note>“जो जो उकुम यहोवान सेवक मुसा तुमूह आपेल इतो ता आखा तुमू मानेन हेते, एने जो जो उकुम मी तुमूह आपेल हे ता आखाह तुमू मानेन हेते; <verse eid="JOS 22:2" /><verse number="3" style="v" sid="JOS 22:3" />तुमू तुमरा बायह्याख ओलाक दिह्याम आजीन दिह वोर मोदेक केऱ्या, पुण तुमरो बोगवान यहोवान उकुम तुमू पालेन किरेल हेते। <verse eid="JOS 22:3" /><verse number="4" style="v" sid="JOS 22:4" />एने एवी तुमरो बोगवान यहोवा तुमरा बायह्याख तान वचनान गेत आराम आपेल हे; केरीन एवी तुमू वोलीन आप आपणा पाड़ावाह, एने आप आपणा जागाम, जाह यहोवान सेवक मुसा यरदन नेदीन पार तुमूह आपेल हे जात रिवो। <verse eid="JOS 22:4" /><verse number="5" style="v" sid="JOS 22:5" />पुण ज्यी वातीन पुरी चोकसी किरज्‍यो काय जो जो उकुम एने नेम यहोवान सेवक मुसा तुमूह आपेल हे, ताह मानीन आपणो बोगवान यहोवाह मोंग किरो, तान आखी वाटी पोर चालो, तान उकुम मानो, तान बोक्‍तीम जोड़ाय रिवो, एने तुमरो पुरो मोन एने पुरा जीवा केरीन तान सेवा किरो।” <verse eid="JOS 22:5" /><verse number="6" style="v" sid="JOS 22:6" />तेवी यहोशु ताह बोरकेत आपीन वोलाव दिनो; एने ता तान तान पाड़ावाम जात रेना। <verse eid="JOS 22:6" /><verse number="7" style="v" sid="JOS 22:7" />मनश्शेन आदा गेराणाह मुसा बाशान माय ईसो आपेल इतो; पुण दिहरा आदा गेराणाह यहोशु तान बायाख ने विचीम यरदन नेदीन पश्‍चिमान उगे ईसो आप्यो, जेवी ताह यहोशु बोरकेत आपीन वोलाव्‍यो काय तान तान पाड़ावे जाय,<verse eid="JOS 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 22:8" />तेवी ताह बी बोरकेत आपीन केयो, “जुलूम होवटा पालन्या जेनवार, एने होनो, चांदी, पितलो, लोड़ो, एने जुलूम होवटा फाड़का एने जुलूम मालदेन लेन तुमरे तुमरे पाड़ावाम वोल आवो; एने तुमरा दुसमोनान लुटीन मालदेनाह तुमरा बायह्याख हेऱ्या वाट लिज्यो।”<verse eid="JOS 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 22:9" />तेवी रूबेनी, गादि, एने मनश्शेन आदो गेराणो इस्राएली फाय रेन, मतलब कनान देसान शिलो गावाम रेन, तान गीलाद सोतान जागाम, जो मुसान द्‍वारा आपानो, यहोवान उकुमान गेत तान सोतान जागो एय जायेल इतो, ता जाणेन वोल गीया।<verse eid="JOS 22:9" /></para>
  <para style="s">यरदन ने दिड़े वेदीन स्‍थापना</para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 22:10" />एने जेवी रूबेनी, गादि, एने मनश्शेन आदो गेराणो यरदन नेदीन मीरे पोचना जो कनान देसाम हे, तेवी ता ताहरी देखणेन लायेक एक मोटली वेदी बाणाया। <verse eid="JOS 22:10" /><verse number="11" style="v" sid="JOS 22:11" />तेवी इस्राएल ने माणहे ज्यी खुबेर होमल्या, “दिखो, रूबेनी, गादि एने मनश्शेन आदा गेराणान माणहे कनान देसान एद्‍दी पोर यरदन नेदीन मीरे ता गलीलोत माय एक वेदी बाणायेल हे, जो इस्राएलीन ईसाम हे।” <verse eid="JOS 22:11" /><verse number="12" style="v" sid="JOS 22:12" />जेवी इस्राएली माणहे ज्‍य होमल्या, तेवी इस्राएलीन आखी मोंडली ता हेऱ्यी लेड़ाणेन केरता चेड़ाय केरनेन शिलो माय एकठी एनी।<verse eid="JOS 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 22:13" />तेवी इस्राएल ने माणहे थोड़ाक माणहाह रूबेन, गाद एने मनश्शेन आदा गेराणान माणहा हेऱ्या वातु केरनेन केरता गीलाद देस माय मोकल्‍यो, न्यान मुखी चाकऱ्यो एलीआजर ने बिटोख पिनहास इतो। <verse eid="JOS 22:13" /><verse number="14" style="v" sid="JOS 22:14" />एने पिनहास हिऱ्यो दोह मुखीह, मतलब इस्राएल ने एक एक गेराणाम रेन डायडायान गेराणान एक एक मुखीह मोकल्‍यो, एने ता इस्राएल ने एजाराम आप आपणा डायडायान गेराणान मुखी एदमी एता। <verse eid="JOS 22:14" /><verse number="15" style="v" sid="JOS 22:15" />ता गीलाद देसाम रूबेनी, गादि, एने मनश्शेन आदा गेराणान माणहा फाय जाईन केणे बाज गीया, <verse eid="JOS 22:15" /><verse number="16" style="v" sid="JOS 22:16" /><note caller="+" style="x"><char style="xo" closed="false">22:16 </char><char style="xt" closed="false"><ref loc="DEU 12:13-14">व्यवस्था 12:13-14</ref></char></note>इस्राएल ने आखा माणहे तुमूह फुसतेह, “तु इस्राएल ने बोगवानान विरूद ज्‍य काहा किऱ्यो? तुमू यहोवान विरूद किहीक एय गीया? तुमू तुमरी केरता वेदी काहा बाणाया? तुमू जाणतेह काय ज्‍य बोगवानान हिकवोणीन विरूद हे। <verse eid="JOS 22:16" /><verse number="17" style="v" sid="JOS 22:17" /><note caller="+" style="x"><char style="xo" closed="false">22:17 </char><char style="xt" closed="false"><ref loc="NUM 25:1-9">गिनती 25:1-9</ref></char></note>एने पोअर <note caller="+" style="f"><char style="fr" closed="false">22:17 </char><char style="fq" closed="false">पोअर </char><char style="ft" closed="false">मोवाबी </char></note>नावान जागाह एर किरो, आपु ता पापान वोजेसे एवी बी तेकलीत वेठतेह; ज्या मोटला पापान केरता बोगवान इस्राएल ने जुलूम होवटा माणहाह नाहाजो दुखाऱ्यो केर दियेल इतो, एने आपु एवी बी ती बेमारीन वोजेसे तेकलीत वेठणे बाजरेनाह। <verse eid="JOS 22:17" /><verse number="18" style="v" sid="JOS 22:18" />एने आज बी तुमू यहोवान पासाण चालने सोड़ दियेल हेते? केरीन ओहलो एय काय केदी तुमू जो केरने बाजरेनाह, बोंद नाह केरते ताहार यहोवा इस्राएल ने एक एक माणहा पोर राग केरी। <verse eid="JOS 22:18" /><verse number="19" style="v" sid="JOS 22:19" />पुण केदी तुमरी सोतान बुय एठी एय ताहार ज्यी पार यहोवान सोतान बुयीम आव जावो जाहरी यहोवान तोम्बु उबरिनोह, एने तुमरी केरता आमरे विचीम एक सोतान ईसो लेय लिवो। <verse eid="JOS 22:19" /><verse number="20" style="v" sid="JOS 22:20" /><note caller="+" style="x"><char style="xo" closed="false">22:20 </char><char style="xt" closed="false"><ref loc="JOS 7:1-26">यहोशु 7:1-26</ref></char></note>जेरहान बेटाख आकानाह एर किरो, आकान बेट किरेल चिजीन बाराम बुरहो तुड्यो, जाह खेतेम केरनो एतो, आकानाह एखालो नाह मोरने पोड़नो, पुण बोगवानान नेम तोड़ीन पाप केरनेन कारेण से इस्राएल ने आखी मोंडलीह देन्ड जुड़नो।”<verse eid="JOS 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 22:21" />तेवी रूबेनी, गादि, एने मनश्शेन आदा गेराणान माणहे इस्राएल ने एजार एजार माणहा पोर जा जा मुखी एदम्याह ज्‍यो जापाप आप्या, <verse eid="JOS 22:21" /><verse number="22" style="v" sid="JOS 22:22" />“यहोवा जो, बोगवानान बोगवान हे! एने बोगवान जाणेह काय आमु ज्‍य काहा किरेल? एवी तुमू बी इस्राएल माय ज्यो जाण लिवो, तुमू तान निर्णय केर सेकतेह, जो आमु किरेल हेते; केदी तुमूह ज्‍यो बुरहो हे काय आमु पाप किरेल हेते, ताहार तुमू आमुह एवी मार सेकतेह। <verse eid="JOS 22:22" /><verse number="23" style="v" sid="JOS 22:23" />केदी आमु बोगवानान नेमाह तुड़ेल हेते ताहार आमु केहु काय यहोवा सोता आमुह देन्ड आपी, काय तुमू ज्‍य सोचतेह काय आमु ज्यी वेदीह बोली चेड़ावणे एने दानबोली एने मेल मिलाप बोली चेड़ावणेन केरता बाणायेल हे? <verse eid="JOS 22:23" /><verse number="24" style="v" sid="JOS 22:24" />पुण आमु खेरीच ज्या विचार से ज्‍य किरेल हेते काय केदी ओंगाणल्‍यी पिढ़ीम तुमरा सोरा आमरा सोराह ज्‍य केणे नाय जुवे काय तुमूह इस्राएल ने बोगवान यहोवा हेऱ्या काय काम? <verse eid="JOS 22:24" /><verse number="25" style="v" sid="JOS 22:25" />काहाकाय एय रूबेनी, एय गादि, यहोवा आमरे एने तुमरे विचीम यरदन नेदीह एद्दी ठेराव दियेल हे, केरीन तुमूह बोगवानान उगे रेन काल्लो ईसो नाह सोतो, इह केरीन केन तुमरा सोरा आमरा सोराह यहोवान बोक्ती एने बिय केरने से रोक देती। <verse eid="JOS 22:25" /><verse number="26" style="v" sid="JOS 22:26" />केरीन आमु केया, ‘आवो, आपु आपणी केरता एक वेदी बाणाव लेता, ती होमबोली नाहते मेल मिलाप बोलीन केरता नाह, <verse eid="JOS 22:26" /><verse number="27" style="v" sid="JOS 22:27" />पुण ज्यानकेरता काय आमरे एने तुमरे, एने आमरे बाद आमरे एने तुमरे सोरान विचीम गोवायीन काम देय; ज्यानकेरता काय आपु होमबोली, मेल मिलाप बोली, एने बोली चेड़ावीन यहोवान सामने तान बोक्ती केरी; एने ओंगाणल्‍यी पिढ़ीम तुमरा सोरा आमरा सोराह ज्‍य नाय केणे जुवे, काय बोगवानान उगे रेन तुमरो काल्लो ईसो नाह सोतो।’ <verse eid="JOS 22:27" /><verse number="28" style="v" sid="JOS 22:28" />केरीन आमु केया, ‘जेवी ता माणहे ओंगाणल्‍यी पिढ़ीम आमुह नाहते आमरा सोराह ज्‍य केणे बाज जाती, तेवी आमु ताह केहु, काय यहोवान वेदीन नमुना पोर बोणेल ज्यी वेदीह दिखो, जाह आमरा डायडाया होमबोली नाहते मेल मिलाप बोलीन केरता नाह बाणाया; पुण ज्यानकेरता बाणायेल एता काय आमरे एने तुमरे विचीम गोवायीन काम देय।’ ” <verse eid="JOS 22:28" /><verse number="29" style="v" sid="JOS 22:29" />“खेरी ते ज्‍य हे काय आमु यहोवान विरूद नाह एणे होदते, आमु जाणतेह काय एकुस खेरली वेदी तीस हे जी चोखाला तोम्बुन सामने हे; होमबोली, एने दानबोली, नाहते मेल मिलाप बोलीन केरता दिहरी वेदी बाणावी।”<verse eid="JOS 22:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JOS 22:30" />जेवी पिनहास चाकऱ्यो एने मोंडलीन मुखी, जा इस्राएलीन एजार माणहा माय मुखी एदमी, रूबेनी, गादि एने मनश्शेन आदा गेराणान माणहान वातु होमल्या तेवी ता जुलूम खुस एना। <verse eid="JOS 22:30" /><verse number="31" style="v" sid="JOS 22:31" />एने एलीआजर चाकऱ्यान बिटोख पिनहास रूबेनी, गादि, एने मनश्शेह केया, “आज आमु जाणतेह काय यहोवा आपणे विचीम हे, काहाकाय तुमू यहोवान ओहलो बुरहो नाह तुड़ेल सोता, एने तुमू इस्राएलीह यहोवान आथा केरीन वोचाड़ लियेल हेते।”<verse eid="JOS 22:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JOS 22:32" />तेवी एलीआजर चाकऱ्यान बिटोख पिनहास मुखी एदम्या बेल रूबेनी एने गादि हिऱ्यो रेन गीलाद लागतो कनान देसाम इस्राएली फाय वोलीन खुबेर आप्यो। <verse eid="JOS 22:32" /><verse number="33" style="v" sid="JOS 22:33" />ज्यी खुबेर होमलीन इस्राएली खुस एना एने ता बोगवानान बोड़ाय केऱ्या एने रूबेनी एने गादि पोर चेड़ाय केरीन तान देसाह खेतेम केरनेन पोशी चेरचा नाह केऱ्या।<verse eid="JOS 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JOS 22:34" />तेवी रूबेन एने गादि ने माणहे ज्‍य केन, “ती वेदीन नाव एद <note caller="+" style="f"><char style="fr" closed="false">22:34 </char><char style="fq" closed="false">एद </char><char style="ft" closed="false">गोवाह</char></note>मेल्या : ज्यी ते आपणे विचीम ज्यी वातीन गोवा हे काय यहोवास बोगवान हे।”<verse eid="JOS 22:34" /></para>
  <chapter eid="JOS 22" />
  <chapter number="23" style="c" sid="JOS 23" />
  <para style="s">यहोशुन सेवल्यो हिकवोण</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 23:1" />जुलूम दिह्यान पासाण, जेवी यहोवा इस्राएलीह तान कावदेन वाला दुसमोना से आराम आप्यो, एने यहोशु डायो एने जुलूम वोयान एय गीयो, <verse eid="JOS 23:1" /><verse number="2" style="v" sid="JOS 23:2" />तेवी यहोशु आखा इस्राएलीह, मतलब डायडाया, मुखी एदमी, एने आदिकारीह हादिन केणे बाज गीयो, “मी ते एवी डायो एने जुलूम वोयान एय जायेल हे; <verse eid="JOS 23:2" /><verse number="3" style="v" sid="JOS 23:3" />एने तुमू दिखेल हेते काय तुमरो बोगवान यहोवा तुमरे वोजेसे ज्‍यु आख्‍यु जात्‍यु हिऱ्यो काय काय किरेल हे, काहाकाय जो तुमरी उगे रेन लेड़तेन आयेल हे तो तुमरो बोगवान यहोवा हे। <verse eid="JOS 23:3" /><verse number="4" style="v" sid="JOS 23:4" />दिखो, मी ज्‍यु वोचेल जात्युन चिट्‍ठी टाक टाकीन तुमरा गेराणान ईसो केर दियेल हे; एने यरदन रेन पश्‍चिम उगेवालो मोटला देरीया वोर रेणार्‍यु त्यु आख्‍यु जात्‍युह बी ओहलोच आपेल हे, जाह मी काट दियेल हे। <verse eid="JOS 23:4" /><verse number="5" style="v" sid="JOS 23:5" />एने तुमरो बोगवान यहोवा ताह तुमरे सामने रेन तान देसाम रेन निकाल देय; एने तुमू तुमरो बोगवान यहोवान वचनान गेत तान देसान आदिकारी एय जाहो। <verse eid="JOS 23:5" /><verse number="6" style="v" sid="JOS 23:6" />केरीन जुलूम ईमोत बांदिन, जो काय मुसान नेमान पुस्तेक माय लिखेल हे ताह मानो एने पालेन किरो ताह रेन नाहते जीवड़े एने डाखरे उगे वोलज्‍यो। <verse eid="JOS 23:6" /><verse number="7" style="v" sid="JOS 23:7" />एने ज्‍यु जात्‍यु तुमरे विचीम रेय जायेल हेत्यु तान विचीम मा जाहो, एने तान देवतान नाव मा लिहो, एने तान नावान सुगोण मा खाहो, एने तान बोक्ती मा किरहो, एने तान पाया मा पोड़हो। <verse eid="JOS 23:7" /><verse number="8" style="v" sid="JOS 23:8" />पुण जीहे आजीन दिह वोर तुमू तुमरो बोगवान यहोवान बोक्ती माय लाग रेतेह, तिहेच केरीन रेया किरज्‍यो। <verse eid="JOS 23:8" /><verse number="9" style="v" sid="JOS 23:9" />काहाकाय यहोवा मोटली एने ताकेतवोर जात्‍युह तुमरे सामने रेन निकाल नाहाड़ेल हे; एने तुमरे सामने आज वोर कुण टिकनो नाह। <verse eid="JOS 23:9" /><verse number="10" style="v" sid="JOS 23:10" /><note caller="+" style="x"><char style="xo" closed="false">23:10 </char><char style="xt" closed="false"><ref loc="DEU 3:22">व्यवस्था 3:22</ref>; <ref loc="DEU 32:30">32:30</ref></char></note>तुमरे माय रेन एक माणुह एजार माणहाह नाहाड़ देय, काहाकाय तुमरो बोगवान यहोवा तान वचनान गेत तुमरी उगे रेन लेड़ाह। <verse eid="JOS 23:10" /><verse number="11" style="v" sid="JOS 23:11" />केरीन तुमूह तुमरो बोगवान यहोवान बोक्ती केरते रिज्यो, एने तुमरा पुरा जीवा केरीन मोंग किरज्‍यो। <verse eid="JOS 23:11" /><verse number="12" style="v" sid="JOS 23:12" />काहाकाय केदी तुमू वोलीन तुमरे विचीम वोचेल ज्‍यु जात्‍युह रेन मिलाय जाहो, एने ता हेऱ्या वाराड़ केरीन ता हेऱ्या मिलाहो, <verse eid="JOS 23:12" /><verse number="13" style="v" sid="JOS 23:13" />ते खेरीच जाण जावो काय ओंगाण तुमरो बोगवान यहोवा ज्‍यु जात्‍युह तुमरे सामने रेन नाय निकाली; पुण तुमरी केरता जाल एने फांदा, डिलान केरता कोड़ा एने तुमरा डोलान केरता काटा बोण जाती, एने सेवल्‍यी बुखेत तुमू ज्यी हाजाली बुई पोर रेन जो तुमरो बोगवान यहोवा तुमूह आपेल हे खेतेम एय जाहो।<verse eid="JOS 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 23:14" />“हुमलो, आज ते मी तीस वाटे रेन जाण्‍यो हे जी आखी दुनियान हे, एने तुमू आखा आप आपणा मोनाम जाणतेह काय तुमरो बोगवान यहोवा तुमरे बाराम जोली बोलायीन वात्यु केयो, त्युम रेन एक बी बिगेर पुरी ईयेल नाह रेनी, त्यु आख्‍यु तुमरी केरता पुऱ्यू एय जायेल हेत्यु; त्युम रेन एक बी बिगेर पुरी ईयेल नाह रेनी। <verse eid="JOS 23:14" /><verse number="15" style="v" sid="JOS 23:15" />एने जीह केरीन तुमरो बोगवान यहोवान कियेल बोलायीन वातु आख्‍यु तुमरी केरता पुऱ्यू ईयेल हेत्यु, तिहेच केरीन त्यु आख्‍यु तेकलीत बी तुमरी पोर लावी; एने जी हाजाली बुय तुमरो बोगवान यहोवा तुमूह आपेल हे, ती पोर रेन खेतेम केर देय। <verse eid="JOS 23:15" /><verse number="16" style="v" sid="JOS 23:16" />जेवी तुमू ती वाचान जीह तुमरो बोगवान यहोवा तुमूह उकुम आपीन ता हिऱ्यो बांदाड़ेल हे तीह तोड़ीन पाराया देवतान बोक्ती किरहो एने तान पाया पोड़हो तेवी यहोवान राग तुमरी पोर बोड़ेक उठी, एने तुमू ज्या हाजाला देसाम रेन, जो तुमूह आपेल हे, उतवाल्‍याह खेतेम एय जाहो।”<verse eid="JOS 23:16" /></para>
  <chapter eid="JOS 23" />
  <chapter number="24" style="c" sid="JOS 24" />
  <para style="s">यहोशुन शकेम माणहान केरता सेवली हिकवोण</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 24:1" />उवतो यहोशु इस्राएल ने आखा कुटूमाह शेकेम माय एकठा किऱ्यो, एने इस्राएल ने डावाला माणहे, एने मुखी एदमी, एने नियाव केरनारे, एने आदिकारीह हादाड्यो; एने ता बोगवानान सामने उब रेना। <verse eid="JOS 24:1" /><verse number="2" style="v" sid="JOS 24:2" /><note caller="+" style="x"><char style="xo" closed="false">24:2 </char><char style="xt" closed="false"><ref loc="GEN 11:27">उत्पत्ती 11:27</ref></char></note>तेवी यहोशु ता आखा माणहाह केयो, “इस्राएल ने बोगवान यहोवा इहकेरीन किथे, जुनाला कालाम अब्राहाम एने नाहोरान आबोख तेरह आखा, तुमरा डायडाया फरात नेदीन ती पार रेते लेन दिहरा देवतान पुजा केरताला। <verse eid="JOS 24:2" /><verse number="3" style="v" sid="JOS 24:3" /><note caller="+" style="x"><char style="xo" closed="false">24:3 </char><char style="xt" closed="false"><ref loc="GEN 12:1-9">उत्पत्ती 12:1-9</ref>; <ref loc="GEN 21:1-3">21:1-3</ref></char></note>एने मी तुमरो पेल्लो एदमी अब्राहामाह फरात नेदीन ती पार रेन लियावीन कनान देसान आखा जागाम फिरायो, एने तान वोच वोड़ायो। एने ताह इसाहाकाह आप्यो; <verse eid="JOS 24:3" /><verse number="4" style="v" sid="JOS 24:4" /><note caller="+" style="x"><char style="xo" closed="false">24:4 </char><char style="xt" closed="false"><ref loc="GEN 25:24-26">उत्पत्ती 25:24-26</ref>; <ref loc="GEN 36:8">36:8</ref>; <ref loc="GEN 46:1-7">46:1-7</ref>; <ref loc="DEU 2:5">व्यवस्था 2:5</ref> </char></note>ओवतो मी इसाहाकाह याकुब एने एसाव आप्यो। एने एसावाह मी सेईर नावान बोयड़ावालो ईलाको आप्यो काय तो तान आदिकारी एय जाय, पुण याकुब एने तान सोरा मिस्र देसाम जात रेना। <verse eid="JOS 24:4" /><verse number="5" style="v" sid="JOS 24:5" /><note caller="+" style="x"><char style="xo" closed="false">24:5 </char><char style="xt" closed="false"><ref loc="EXO 3:1">निर्गमन 3:1</ref>; <ref loc="EXO 12:42">12:42</ref></char></note>ओवतो मी मुसा एने हारूनाह मुकल्यो, एने मिस्र माय मारा कामान द्‍वारा मिस्री माणहा पोर पिड़ा टाक्‍यो। बाद माय मी तुमूह तारेन निकाल लावो। <verse eid="JOS 24:5" /><verse number="6" style="v" sid="JOS 24:6" /><note caller="+" style="x"><char style="xo" closed="false">24:6 </char><char style="xt" closed="false"><ref loc="EXO 14:1-31">निर्गमन 14:1-31</ref></char></note>इह केरीन मी तुमरा डायडायाह मिस्र देसाम रेन बाहेर निकाल लावो, ता देरीयान आहने पोचना; तेवी मिस्री माणहे टांगा एने गोड़ाह लेन रातला देरीये वोर तुमरा डायडायान पासाण पोड़ना। <verse eid="JOS 24:6" /><verse number="7" style="v" sid="JOS 24:7" />एने जेवी तुमू यहोवाह विन्ता केऱ्या तेवी तो तुमरे एने मिस्रीन विचीम आंदारो केर दिनो, एने ता पोर देरीयाह वोयाड़ीन ताह बुड़ाव दिनो; एने जो काय मी मिस्र देसाम किऱ्यो ताह तुमू तुमरा डोला केरीन देख्या।”</para>
  <para style="p" vid="JOS 24:7">“ओवता तुमू जुलूम दिह वोर जेंगलाम रेना। <verse eid="JOS 24:7" /><verse number="8" style="v" sid="JOS 24:8" /><note caller="+" style="x"><char style="xo" closed="false">24:8 </char><char style="xt" closed="false"><ref loc="NUM 21:21-35">गिनती 21:21-35</ref></char></note>तेवी मी तुमूह ता एमोरीन देसाम लेन आवो, जा यरदन नेदीन ती पार रेताला; एने ता तुमू हेऱ्या लेड़ाना एने मी ताह तुमरे ताबाम केर दिनो, एने तुमू तान देसान आदिकारी एय गीया, एने मी ताह तुमरे सामने खेतेम केर दिनो। <verse eid="JOS 24:8" /><verse number="9" style="v" sid="JOS 24:9" /><note caller="+" style="x"><char style="xo" closed="false">24:9 </char><char style="xt" closed="false"><ref loc="NUM 22:1">गिनती 22:1</ref>; <ref loc="NUM 24:25">24:25</ref></char></note>ओवतो मोआब ने राजा सीप्पोर ने बिटोख बालाक उठीन इस्राएल हिऱ्यो लेड़ानो; एने तुमूह हाराप आपणेन केरता बोरान बिटोख बिलामाह हादाड्या। <verse eid="JOS 24:9" /><verse number="10" style="v" sid="JOS 24:10" />पुण मी बिलाम ने नाह होमल्यो; तो तुमूह बोरकेत ने बोरकेत देते गीयो; इहकेरीन मी तुमूह तान आथाम रेन वोचाड्यो। <verse eid="JOS 24:10" /><verse number="11" style="v" sid="JOS 24:11" /><note caller="+" style="x"><char style="xo" closed="false">24:11 </char><char style="xt" closed="false"><ref loc="JOS 3:14-17">यहोशु 3:14-17</ref>; <ref loc="JOS 6:1-21">6:1-21</ref></char></note>ओवता तुमू यरदन नेदी पार केरीन यरीहोम आवा, एने जेवी यरीहोन माणहे, एमोरी, परिज्जी, कनानी, हित्ती, गिर्गाशी, हिववी, एने यबूसी तुमरी हेऱ्या लेड़ाना, तेवी मी ताह तुमरे ताबाम केर दिनो। <verse eid="JOS 24:11" /><verse number="12" style="v" sid="JOS 24:12" /><note caller="+" style="x"><char style="xo" closed="false">24:12 </char><char style="xt" closed="false"><ref loc="EXO 23:28">निर्गमन 23:28</ref>; <ref loc="DEU 7:20">व्यवस्था 7:20</ref></char></note>जेवी तुमरी सेना ओंगाण वोड़नी ते मी तान ओंगाण गेंडरा मुकल्यो, ज्या गेंड्रान टोला एमोरीन दुयू राजाह तुमरे सामने रेन नाहाड़ देना; केरीन तुमू तुमर्‍यु तालवार्‍यु एने दोंदल्युन वापेर केऱ्या बिगेर तान उपेर आदिकार केर लेदा। <verse eid="JOS 24:12" /><verse number="13" style="v" sid="JOS 24:13" /><note caller="+" style="x"><char style="xo" closed="false">24:13 </char><char style="xt" closed="false"><ref loc="DEU 6:10-11">व्यवस्था 6:10-11</ref></char></note>ओवतो मी तुमूह ओहलो देस आप्यो जा माय तुमू मेहनेत नाह किरेल एता, एने ओहला गावे बी आपेल हे जाह तुमूह बाणावणे नाह पोड़नो, एवी तुमू ता देसाम एने ता गावाम रेतेह; एने जा अंगुरान रूह एने जेतुनान बोगीचान फोल तुमू खातेह ताह तुमू नाह लागाड्या।”<verse eid="JOS 24:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 24:14" />“केरीन, एवी यहोवान बिय मानो, एने तान सेवा पुरी रिती से एने खेराय माय किरो; एने जा देवतान सेवा तुमरा डायडाया मोठली नेदीन ती पार एने मिस्र माय केरताला, ताह सेटा केरीन यहोवान सेवा किरो। <verse eid="JOS 24:14" /><verse number="15" style="v" sid="JOS 24:15" />एने केदी यहोवान सेवा केरने तुमूह खाराब लागे, ताहार आज निवाड़ लिवो काय तुमू कुणीन सेवा किरहो, ता देवतान जान सेवा तुमरा डायडाया मोठली नेदीन ती पार केरताला, नाहते एमोरीन देवतान जान देसाम तुमू रेतेह, पुण मी एने मारा गेरान माणहे आमु बोगवानान सेवा केरहु।”<verse eid="JOS 24:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 24:16" />तेवी माणहे जापाप आप्या, “ओहलो केदी नाय एय काय आमु बोगवानाह सोड़ीन दिहरा देवतान सेवा केरी; <verse eid="JOS 24:16" /><verse number="17" style="v" sid="JOS 24:17" />काहाकाय आपणो बोगवान यहोवा तोस हे, जो आपुह एने आपणा डायडायाह गुलामीन गेराम रेन बाहेर निकाल लावो, मतलब मिस्र देसाम रेन निकाल लावो, एने जो आपणे देखता मोटला मोटला चोमेत्कार किऱ्यो; एने जी वाटी पोर एने जा जा माणहान देसाम लागता निकल्‍या ताम आपणी राखवाल किऱ्यो। <verse eid="JOS 24:17" /><verse number="18" style="v" sid="JOS 24:18" />एने आमरे सामने रेन ज्या देसाम रेणार एमोरी आख्‍यु जात्‍युह निकाल दियेल हे; केरीन आमु बी यहोवान सेवा केरहु, काहाकाय आपणो बोगवान तोस हे।”<verse eid="JOS 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JOS 24:19" />यहोशु माणहाह केयो, “तुमूह यहोवान सेवा नाय एय सेकी; काहाकाय तो चोखालो बोगवान हे; तो राग केरनार बोगवान हे; तो तुमरा गुना एने पाप माफ नाय केरी। <verse eid="JOS 24:19" /><verse number="20" style="v" sid="JOS 24:20" />केदी तुमू यहोवाह सोड़ीन दिहरा देवतान सेवा केरने बाज जाहो, ताहार तो तुमरो हाजो केरते आयेल हे तीबी तो फिरीन तुमरो बाकतो केरी एने तुमूह खेतेम बी केर देय।”<verse eid="JOS 24:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 24:21" />माणहे यहोशुह केया, “नाह; आमु बोगवानास ने सेवा केरहु।”<verse eid="JOS 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 24:22" />यहोशु माणहाह केयो, “तुमू सोतास तुमरा गोवा हेते काय तुमू बोगवानान सेवा केरने निवाड़ लियेल हेते।”</para>
  <para style="p" vid="JOS 24:22">माणहे केया, “होव, आमु गोवा हेते।”<verse eid="JOS 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JOS 24:23" />तेवी यहोशु केयो, “तुमरे विचीम रेन दिहरा देवताह सेटा केरीन आप आपणो मोन इस्राएल ने बोगवान यहोवान उगे लागाड़ो।”<verse eid="JOS 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 24:24" />तेवी माणहे यहोशुह केया, “आमु ते आपणो बोगवान यहोवास ने सेवा केरहु, एने तास ने वात मानहु।”<verse eid="JOS 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JOS 24:25" />तेवी यहोशु ते दिहस माणहा हिऱ्यो वाचा बांदाड्यो, एने शेकेम माय तानकेरता नेम ठेरायो। <verse eid="JOS 24:25" /><verse number="26" style="v" sid="JOS 24:26" />एने यहोशु न्या वचनाह बोगवानान नेमान पुस्तेक माय लेख दिनो, एने एक मोटलो दिगोड़ लेन ता वांज जाड़ान<note caller="+" style="f"><char style="fr" closed="false">24:26 </char><char style="fq" closed="false">वांज जाड़ान </char><char style="ft" closed="false">ओक नावान जाड़</char></note> बुंदे उब राखाड्यो जो यहोवान चोखाला जागाम इतो। <verse eid="JOS 24:26" /><verse number="27" style="v" sid="JOS 24:27" />तेवी यहोशु आखा माणहाह केयो, “हुमलो, ज्‍यो दिगोड़ आपणो गोवा रेय, काहाकाय जोला वचन यहोवा आपुह कियेल हे ताह ज्‍यो होमलेल हे; केरीन ज्‍यो तुमरो गोवा रेय, काय तुमू तुमरा बोगवानान बाराम लाबाड़ी नाय केरी।” <verse eid="JOS 24:27" /><verse number="28" style="v" sid="JOS 24:28" />तेवी यहोशु माणहाह आप आपणा सोतान ईसा पोर जाणेन केरता वाटे लागाड्यो।<verse eid="JOS 24:28" /></para>
  <para style="s">यहोशु एने एलीआजर ने मोरनो</para>
  <para style="p">
    <verse number="29" style="v" sid="JOS 24:29" />ज्‍यु वातुन बाद यहोवान सेवक, नुन ने बिटोख यहोशु, एक होव दोह वोरह्यान एन मोर गीयो। <verse eid="JOS 24:29" /><verse number="30" style="v" sid="JOS 24:30" /><note caller="+" style="x"><char style="xo" closed="false">24:30 </char><char style="xt" closed="false"><ref loc="JOS 19:49-50">यहोशु 19:49-50</ref></char></note>तेवी यहोशुह तीम्‍नातसेरह माय, जो एप्रेमान बोयड़ावाला देसाम गाश नावान बोयड़ान उत्तर माय हे, तास ने ईसाम बुज्या।<verse eid="JOS 24:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JOS 24:31" />एने यहोशुन जीवाय बोर, एने जा डावाला माणहे यहोशुन मोरनेन बाद जीवताला रेना एने जाणताला काय यहोवा इस्राएल ने केरता कोहला कोहला काम किरेल इतो, तान बी जीवाय बोर इस्राएल ने माणहे यहोवास ने सेवा किरते रेना।<verse eid="JOS 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JOS 24:32" />
    <note caller="+" style="x">
      <char style="xo" closed="false">24:32 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 33:19">उत्पत्ती 33:19</ref>; <ref loc="GEN 50:24-25">50:24-25</ref>; <ref loc="EXO 13:19">निर्गमन 13:19</ref>; <ref loc="JHN 4:5">योहान 4:5</ref>; <ref loc="ACT 7:16">प्रेरितान काम 7:16</ref></char>
    </note>ओवता युसूफान आड़े जाह इस्राएली मिस्र रेन लेन आयेल एता ता शेकेमान बुयीन ता ईसाम गाड़ाय गीया, जाह याकुब शेकेमान आबोख हमोरान बेटाख फाय रेन एक होव चांदीन सिक्‍काम वेचातो लियेल इतो; केरीन तो युसूफान सोरान सोतान ईसो एय गीयो।<verse eid="JOS 24:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JOS 24:33" />एने हारूनान बिटोख एलीआजर बी मोर गीयो; एने ताह एप्रेमान बोयड़ावाला देस गिबा गावाम बुज्या, जो तान बेटाख पिनहासाह आपायेल एतो।<verse eid="JOS 24:33" /></para>
  <chapter eid="JOS 24" />
</usx>