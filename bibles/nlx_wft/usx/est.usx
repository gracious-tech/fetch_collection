<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EST" style="id">- Nahali</book>
  <para style="h">एस्तेर</para>
  <para style="toc3">एस्तेर</para>
  <para style="toc2">एस्तेर</para>
  <para style="toc1">एस्तेर</para>
  <para style="mt2">एस्तेर कि किताब</para>
  <para style="mt1">एस्तेर ने पुस्तेक</para>
  <para style="imt">ओलखात</para>
  <para style="ip">एस्तेर ने पुस्तेक देखाड़ेह काय किहीक फारस माय बोंदी बाणायेल इस्राएली माणहाह ओहला दुसमोनाह रेन वोचाड़ाय गीयो, जो ताह खेतेम केरने योजना बाणावणे बाजरियेल इतो। पुण एस्तेर ने पुस्तेक माय बोगवानान नाव नाह जुड़ेत, पुण ज्य साप हे काय बोगवान ताह ता आखाह मारनेन जी योजना से वोचाड्यो। कुण नाह जाणेत काय एस्तेर ने पुस्तेक कुण लिखेल हे। वापेर किरेल हिब्रु बाषान आदार पोर, जुलूम बुध्दीमान माणहे केतेह काय एस्तेर ने पुस्तेक कोमीत कोमी 400 यीशुन पेल लेखायेल एती।</para>
  <para style="ip">एस्तेर ने पुस्तेक माय इयेल गेटना देखाड़ेह काय यहुदी पुरीम ने तिवाराह किहीक मोणावतेह। हामान नावान एक अमालेकी यहुदी माणहाह खेतेम केरने योजना बाणायेल। इस्राएली एने अमालेकी माणहे तेवीह रेन दुसमोन एता, जेवीह रेन इस्राएलीन उजाड़ी माय रेन ता देसा माय पुचेल एता, जान वायदो बोगवान किरेल इतो<char style="xt"><ref loc="EXO 17:8-16">निर्गमन 17:8-16</ref></char>। तुलेचबूखे जेवी हामान यहुदी माणहाह खेतेम केरने योजना बाणावणे बाजरियेल इतो, एस्तेर, जी एक यहुदी एती, फारस ने राणी बोण गीयी। तीन गेरल्यो मोर्दकेन सेला से, एस्तेर हामान ने योजना रोकणेन केरता तियार एती। यहुदी माणहान द्‍वारे तान दुसमोना पोर जिक सापड़ावणेन बाद, <char style="xt"><ref loc="EST 9:20-22">9:20-22</ref></char> मोर्देके ताह ज्यी जिकीन खुसी मोणावणे केयो। इहकेरीन यहुदी माणहे पुरीम ने तिवार मोणावणे सुरू केऱ्या।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. एस्तेर फारस ने राणी किहीक बोणनी। <char style="ior"><ref loc="EST 1:1-22">1:1-22</ref>; <ref loc="EST 2:1-23">2:1-23</ref> </char></para>
  <para style="io1">2. किहीक हामान यहुदिह खेतेम केरनेन योजना बाणायेल एने ओहलो केरनेन कारेण ताह मार देना। <char style="ior"><ref loc="EST 3:1-15">3:1-15</ref>; <ref loc="EST 7:1-10">7:1-10</ref></char></para>
  <para style="io1">3. यहुदी तान दुसमोनाह किहीक आरवेल एने पुरीम ने तिवार किहीक सुरू केऱ्या। <char style="ior"><ref loc="EST 8:1-17">8:1-17</ref>; <ref loc="EST 10:1-3">10:1-3</ref></char></para>
  <chapter number="1" style="c" sid="EST 1" />
  <para style="s">वशती राणी राजान वात नाह मानने</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 1:1" />क्षयर्ष नावान राजान काला माय ज्यु वातु एन्यु: ज्यो तोच क्षयर्ष हे, जो एक होव सत्तावीस ईलाका पोर, मतलब भारत रेन कुश देस<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="fq" closed="false">कुश देस </char><char style="ft" closed="false">ज्‍यो कुश देस आज ने इथोपिया देस हे</char></note> वोर राज केरतालो। <verse eid="EST 1:1" /><verse number="2" style="v" sid="EST 1:2" /><note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="EZR 4:6">एज्रा 4:6</ref></char></note> राजा क्षयर्ष ने राज कालान राजदानी शूशन किल्‍लो इतो, एने ता राजगादी पोर बोहीन राज केरतालो।<verse eid="EST 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EST 1:3" />ताहरी तो तान राज ने कालाम तीसरा वोरह्या माय तान सोब आदिकारीह एने काम केरनाराह नेवता आप्यो। फारस एने मादे देसान सेनापोती एने ईलाका ईलाकान मुखी एने आदिकारी तान सोमोर उपस्थित एता। <verse eid="EST 1:3" /><verse number="4" style="v" sid="EST 1:4" />तो ताह सोव मोयना वोर तान राज ने हाजालो मालदेन एने हाज हाज्यु मोंगाल्यु वोस्तु देखाड़ती रिनो।<verse eid="EST 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 1:5" />ता दिह्याह जाणेन पासाण राजा आखा आतल्या मोटला माणहाह बी जा शूशन नावान राज किल्‍ला माय टोलवाईल एता, एने राजवाड़ान बोगीचा माय सात दिह वोर खाणो आप्यो। <verse eid="EST 1:5" /><verse number="6" style="v" sid="EST 1:6" />ताहरी वाला पोड़दा दोवल्या एने निल्ला हुतान एता, एने होण एने जामण्या रेंगान दोयड्यु केरीन चांदीन सेल्ल्या माय संगमरमर देगड़ान खांबाह लागाड़ मिलेल एता; एने ताहरी वाला पाटला होना चांदीन एता; रातला एने दोवल्या एने पेल्ला एने काल्ला संगमरमर बुणेल फोरची पोर मिलेल एती। <verse eid="EST 1:6" /><verse number="7" style="v" sid="EST 1:7" />ता खाणा माय राजान लायकीन अंगुरान रूह बात बातीन होनान ठामला माय टाकीन पिवाड़ाय जातालो। <verse eid="EST 1:7" /><verse number="8" style="v" sid="EST 1:8" />पिणे ते नेमान पारमाणे एतालो, काहाकाय राजा ते तान गेरान सोब काम केरनाराह उकुम आपेल इतो, काय जा पावणान जोहली मोरजी तोहलीच चाकरी किरज्‍यो।<verse eid="EST 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EST 1:9" />राणी वशती बी राजा क्षयर्षान गेरा माय बायकुह खाणो आपी।<verse eid="EST 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 1:10" />सातवे दिह, जेवी राजान मोन अंगुरान रूहा माय लागीन एतो, तेवी तो महूमान, बिजता, हर्बोना, बिगता, अबगता, जेतेर एने कर्कश नावान सातो मुखी खोजाह जा क्षयर्ष राजान सेवा केऱ्या केरताला, उकुम आप्यो, <verse eid="EST 1:10" /><verse number="11" style="v" sid="EST 1:11" />काय राणी वशतीह राजमुकुट पेरावीन राजान सोमोर लेन आवो; जा माय काय देस देसान माणहे एने आदिकारी पोर तीन सुंदरता देखाय पुड़े; काहाकाय ती देखणे माय गाटाली एती। <verse eid="EST 1:11" /><verse number="12" style="v" sid="EST 1:12" />मुखी खोजान उगे रेन राजान ज्यो उकुम लेन राणी वशती आवणेन नाकार केरी। केरीन राजा जुलूम रागा माय बोराय गीयो।<verse eid="EST 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EST 1:13" />तेवी राजा टेमा टेमान वात जाणनारे कागल्याह फुशो राजा ते निती एने न्यायनिवाड़ान सोब ईकेलवाला हिऱ्यो ओहलोच केऱ्या केरतालो। <verse eid="EST 1:13" /><verse number="14" style="v" sid="EST 1:14" />ता फाय कर्शना, शेतार, अदमाता, तर्शीश, मेरेश, मर्सना, एने ममूकान नावान फारस एने मादे देसान सात मुखी एता, जा राजान देरसेन केरताला, एने राज्या माय मुखी मुखी पोदा पोर बोहाड़ाय जायेल एता। <verse eid="EST 1:14" /><verse number="15" style="v" sid="EST 1:15" />राजा फुशो, “राणी वशती राजा क्षयर्षान मुखी खोजा उगे रेन आपाय जाईल उकुमाह तोड़ी, ते कायदान गेत ती हेऱ्यो काय केराय जाय?”<verse eid="EST 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EST 1:16" />तेवी ममूकान राजाह एने आदिकारीन एजुरी माय जापाप आप्यो, “राणी वशती जो खाराब काम किरेल हे, तो नाह निस्तो राजा हेऱ्योच, पुण सोब देसान माणहा हेऱ्यो बी जा राजा क्षयर्षान सोब ईलाका माय रेतेह।”<verse eid="EST 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EST 1:17" />काहाकाय राणीन ज्या कामान चेरचा सोब बायकु माय एय, एने जेवी ज्य केवाय जाय, “राजा क्षयर्ष राणी वशतीह तान सोमोर लेन आवणेन उकुम आप्यो पुण ती नाह आवी, तेवी त्यु बी जिव जिवान एदम्याह खाराब सोमेजणे बाज जाती। <verse eid="EST 1:17" /><verse number="18" style="v" sid="EST 1:18" />आजीन दिह फारस एने मादि देसान आदिकारीन बायकु, त्यु राणीन ज्यी वातीन बाराम होमेलती, तेवी त्यु बी राजान आदिकाऱ्या हेऱ्यु इहीच केरीन केणे बाज जाती; इह केरीन जुलूमच नफरत एने राग आवी। <verse eid="EST 1:18" /><verse number="19" style="v" sid="EST 1:19" />केदी राजाह पुटे ते, ज्यो उकुम काड़े, एने फारसी एने मादि देसान कानुन माय लेखाय बी जाय, जा माय केदी बोदली नाय सिके, काय राणी वशती राजा क्षयर्षान सोमोर पोशी केदी आवणे नाय जुवे, एने राजा पटराणीन पोद एगदी दिहरीह आप देय ज्यी तिह रेन हाजी रेय। <verse eid="EST 1:19" /><verse number="20" style="v" sid="EST 1:20" />जेवी राजान ज्यो उकुम तान आखा राज माय होमलाड़ाय जाय, तेवी बायकु जान तान एदम्यान मान मेलती, केदी तो गेरीब एय नाहते मालदार।”<verse eid="EST 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EST 1:21" />ज्यी सेला राजाह एने आदिकारीह पोटनी एने राजा ममूकान ने वात मान लिदो एने तान राज माय, <verse eid="EST 1:21" /><verse number="22" style="v" sid="EST 1:22" />मतलब आखा ईलाकान आक्षर माय आखी जातीन बाषा माय चिट्ठयु मोकल्यो, काय आखा एदमी जान तान गेरा माय आदिकार चालाड़ी, एने तान जातीन बाषा बोल्या केरी।<verse eid="EST 1:22" /></para>
  <chapter eid="EST 1" />
  <chapter number="2" style="c" sid="EST 2" />
  <para style="s">एस्तेरीन राणी बाणावाय जाणो</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 2:1" />ज्यु वातुन पासाण जेवी राजा क्षयर्षान राग ओलाय गीयो, तेवी तो राणी वशतीन एने जो गेलती ती किरेल एती, एने जो तीन बारामाय उकुम निकलेल इतो ताह बी इर किऱ्यो। <verse eid="EST 2:1" /><verse number="2" style="v" sid="EST 2:2" />तेवी राजान सेवक जा तान चाकरी केरताला, ता केणे बाज गीया, “राजान केरता गाटाली एने जुवान कुवारल्यु होदाय जाए। <verse eid="EST 2:2" /><verse number="3" style="v" sid="EST 2:3" />एने राजा तान राज ने आखा ईलाकान माणहा केरीन मुकले काय ता सोब कुवारल्यु सोऱ्युह शूशन गेड़ान रनवास माय टुलो केरी एने बायकुह होदणार हेगाह जो राजान मुखी खोजा इतो होप देय; एने हिंगार केरनेन वोस्तु त्युह आपाय जाय। <verse eid="EST 2:3" /><verse number="4" style="v" sid="EST 2:4" />तेवी त्यु माय रेन जी कुवारली राजान नेजरी माय हाजी देखाय, ती राणी वशतीन जागा पोर राणी बाणावाय जाय।”</para>
  <para style="p" vid="EST 2:4">ज्यी वात राजाह पोटनी एने तो इहीच केरीन किऱ्यो।<verse eid="EST 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 2:5" />शूशन गेढ़ा माय मोर्देक नावान एक यहूदी रेतालो, जो किश नावान एक बिन्यामीन ने पुतण्योक, शिमीन नातण्योक एने याईरान सोरो इतो। <verse eid="EST 2:5" /><verse number="6" style="v" sid="EST 2:6" /><note caller="+" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="2KI 24:10-16">2 राजा 24:10-16</ref>; <ref loc="2CH 36:10">2 इतिहास 36:10</ref></char></note>एने मोर्देक ता दिह्या माय देराणारा हिऱ्यो यरूशलेम रेन जेली माय जाईल इतो, जाह बाबिलोन ने राजा नबुकदनेस्‍सर, यहुदान राजा यकोन्या हिऱ्यो बोन्दी बाणावीन लेन जायेल इतो। <verse eid="EST 2:6" /><verse number="7" style="v" sid="EST 2:7" />तो हदास्सा नावान काकहाणी बोणीख, जी एस्तेर केवाताली, तिह पुहेल इतो; काहाकाय तीन आहख ने आबोख कोणीच नाह एतो, एने ती हाजाली सोरी एने गाटाली एती, एने तीन आहख ने आबोख मोर जाईल एता, तेवी मोर्देक तिह बेटीख केरीन पुह्यो।<verse eid="EST 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EST 2:8" />जेवी राजान उकुम एने नेम होमलाड़ाय गीयो, तेवी जुलूम सोऱ्यु, शूशन गेढ़ा माय हेगेन आदिकारा माय टोलवाय गियु, तेवी एस्तेर बी राजवाड़ा माय बायकुह होदणार हेगेन आदिकारा माय होपाय गियी। <verse eid="EST 2:8" /><verse number="9" style="v" sid="EST 2:9" />ती सोरी तान नेजरी माय हाजी लागी; एने राजा ती पोर खुस इनो, तेवी तो बिगेर वार लागाड़ेल तिह राजवाड़ा माय हिंगार केरनेन वोस्तु, एने तीन खाणो, एने तीन केरता निवाड़ेल सात हाती बी आप्यो, एने तिह एने तीन हातीह बी रनवास माय आखा माय रेन हाजो रेणेन जागो आप्यो।<verse eid="EST 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 2:10" />एस्तेर नाह ते तीन माणहान बाराम कियेल एती, एने नाह तीन गेराणो, काहाकाय मोर्देक तिह उकुम आपेल इतो काय ताह मा किहे। <verse eid="EST 2:10" /><verse number="11" style="v" sid="EST 2:11" />मोर्देक ते दाड़ीन रनवास ने खोलीन सोमोर फिरतालो, काहाकाय एस्तेर ने हालचाल जाण सिके एने ती हेऱ्यो काय एय?<verse eid="EST 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 2:12" />जेवी एक एक सोरीन वारी आवी काय ती क्षयर्ष राजा फाय जाय, एने ज्य ती टेम माय एनो जेवी ती हेऱ्यो बायकुन केरता ठेरायेल नेमान गेत बारा मोयना वोर वेवारो केराय जाईल एतो; मतलब तान हिंगार केरनेन दिह इह केरीन निकली गीया, काय सोव मोयना वोर गेंदाण्यो तेल, एने बायकुह हिंगार केरनेन दिहरो सोमान लागाड़ाय जातालो। <verse eid="EST 2:12" /><verse number="13" style="v" sid="EST 2:13" />इह केरीन ती सोरी जेवी राजा फाय जाताली, तेवी जो काय ती होदताली काय रनवास रेन राजवाड़ा माय लेन जाय, तो तिह आपाय जातालो। <verse eid="EST 2:13" /><verse number="14" style="v" sid="EST 2:14" />हांज पोर ते ती जाताली, एने उठ्यान ती फिरीन रनवास ने दिहरा गेरा माय जाईन, पावेरन्युह होदणार राजान मुखी खोजा शाशगज ने आदिकारा माय एय जाताली, एने राजा फाय पोशी नाह जाताली। केदी राजा ती पोर खुस एय जातालो, तेवी ती नाव लेन हादाड़ाय जाताली।<verse eid="EST 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 2:15" />जेवी मोर्देकान काकोख अबीहेलान बेटीख एस्तेर, जिह मोर्देक बेटीख मानीन मिलेल इतो, तीन वारी आवी काय राजा फाय जाय, तेवी बायकुह होदणार राजान मुखी सेवक हेगे जो तान केरता ठेरायेल इतो, ता फाय वोदार तो काय नाह मांग्‍यो। जोला एस्तेरीह देख्या, ता सोब ती पोर खुस एना। <verse eid="EST 2:15" /><verse number="16" style="v" sid="EST 2:16" />तेवी एस्तेर राजवाड़ा माय राजा क्षयर्षा फाय तान राज ने सातवा वोरह्यान तेबेत नावान दोहवा मोयना माय पोचाड़ाय गियी। <verse eid="EST 2:16" /><verse number="17" style="v" sid="EST 2:17" />राजा एस्तेरीह आख्‍यु बायकुह रेन वोदार मोंग किऱ्यो, एने दिहऱ्यु सोब कुवारल्युह रेन वोदार गीण एने देया ती पोर एनी, केरीन तो तीन मुंडा पोर राजमुकुट मिल्यो एने तिह वशतीन जागा पोर राणी बाणायो। <verse eid="EST 2:17" /><verse number="18" style="v" sid="EST 2:18" />तेवी राजा तान आदिकारीह एने काम केरनाराह एक मोटला खाणान नेवता आप्यो, एने ताह एस्तेरी खाणो केयो, एने ईलाका माय सुट्टी आपाड्यो, एने तान आपणेन लायकीन ईनाम बी वाट्यो।<verse eid="EST 2:18" /></para>
  <para style="s">मोर्देके राजान जीवाह वोचाड़ने</para>
  <para style="p">
    <verse number="19" style="v" sid="EST 2:19" />एवी वोर राजा मोर्देकेह तान प्रशासकिय सेवा माय नियुक्‍त किरेल इतो। <verse eid="EST 2:19" /><verse number="20" style="v" sid="EST 2:20" />एस्तेर तीन माणहान एने गेराणान बाराम कियेल नाह एती, काहाकाय मोर्देके तिह ओहलो उकुम आपेल इतो काय नाय केय; एने एस्तेर मोर्देकान वात मान्यी जिहकेरीन आत्यीस एतीन मानताली।<verse eid="EST 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EST 2:21" />ता दिह्या माय जेवी मोर्देक राजान राजवाड़ान फाटेकीन जागे बोह्या केरतालो, तेवी राजान मुखी सेवक माय रेन जा राखवाल्या बी एता, ता माय रेन बिगतान एने तेरेश नावान दुय जाणे राजा क्षयर्षा पोर रागाईन ताह मारनेन हुमच्यो केऱ्या। <verse eid="EST 2:21" /><verse number="22" style="v" sid="EST 2:22" />ज्यी वात मोर्देकाह मालुम एनी, एने तो एस्तेर राणीह ज्यी वात केयी, एने एस्तेर मोर्देकान नाव लेन राजाह चेतावनी आपी। <verse eid="EST 2:22" /><verse number="23" style="v" sid="EST 2:23" />तेवी तापास एनी तेवी ज्यी वात खेरी निकेलनी एने ता दुयूह जाड़ा पोर टांगाड़ाय गीयो, एने ज्यी वातीन पासाण राजान सोमोर इतिहासान पुस्तेक माय लेख लेवाय गीयो।<verse eid="EST 2:23" /></para>
  <chapter eid="EST 2" />
  <chapter number="3" style="c" sid="EST 3" />
  <para style="s">यहुदिह खेतेम केरनेन केरता हामान ने योजना</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 3:1" />थोड़ाक दिह्या बाद राजा क्षयर्ष अगागी हम्मदात ने सोरो हामानाह पोरदान मोंत्री बाणायो, एने तान हाती हिऱ्यो ताह राजगादी बी आप्यो। <verse eid="EST 3:1" /><verse number="2" style="v" sid="EST 3:2" />राजान सोब काम केरनारे जा राजवाड़ान फाटेक पोर रेया केरताला, ता हामानान सोमोर नेचा इन वोंद्या केरताला काहाकाय राजा तान बारा माय ओहलोच उकुम आपेल इतो; पुण मोर्देक नाह ते निचो एतालो एने नाहते ताह वोन्दतालो। <verse eid="EST 3:2" /><verse number="3" style="v" sid="EST 3:3" />तेवी राजान काम केरनारे जा राजवाड़ान फाटेक पोर रेया केरताला, ता मोर्देकाह फुशा, “तु राजान उकुमाह काहा तुड़ेह?” <verse eid="EST 3:3" /><verse number="4" style="v" sid="EST 3:4" />जेवी ता ताह दाड़ीन इहीच केरीन किते रेना, एने तो तान एक बी वात नाह हुमल्यो, तेवी ता ज्य देखणेन मोरजी माय काय मोर्देकान ज्यी वात चाली काय नाय, हामानाह केय दियेल एता; तो ताह केय दियेल इतो, “काय मी यहूदी हे।” <verse eid="EST 3:4" /><verse number="5" style="v" sid="EST 3:5" />जेवी हामान दिख्यो काय मोर्देके निचो नाह वुलेद, एने नाह माहु वुन्देत, तेवी हामान जुलूम रागानो। <verse eid="EST 3:5" /><verse number="6" style="v" sid="EST 3:6" />तो निस्तो मोर्देकाह देणे काईच नाह सुमज्यो। काहाकाय ता हामानाह ज्य किय दियेल एता काय मोर्देक काल्ली जातीन हे, केरीन हामान क्षयर्षान राज माय रेणारे आखा यहुदिह बी मोर्देकान जात जाणीन खेतेम केर देणेन हुमच्यो किऱ्यो।<verse eid="EST 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EST 3:7" />राजा क्षयर्षान बारावा वोरह्या माय नीसान नावान पेल्ला मोयना माय, हामान अदार नावान मोयने वोर वाला एक एक दिह एने एक एक मोयनान केरता पुर मतलब चिट्ठी आमने सामने काड़ायो।<verse eid="EST 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EST 3:8" />तेवी हामान राजा क्षयर्षाह केयो, “तारा राज ने सोब ईलाका माय रेणारे देस देसान माणहान विचीम आलेग आलेग जागे टाकायेल माणहे हेते, जीन नेम एने सोब माणहाह नेमाह रेन आलेग हे; एने ता राजान कानुना पोर नाह चालते, केरीन ताह रेणे देणे राजाह फायदो नाय मिले। <verse eid="EST 3:8" /><verse number="9" style="v" sid="EST 3:9" />केदी राजाह पोटतेय ते ताह खेतेम केरनेन उकुम लेखाय जाय, एने मी राजान सेवक ने आथा माय राजबान्डारा माय पोचाड़नेन केरता, दोह एजार चांदीन सिक्का आपुह।”<verse eid="EST 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 3:10" />तेवी राजा तान मुहर वाली मुंदी तान आथा माय रेन काड़ीन अगागी हम्मदात ने सोरो हामानाह, जो यहुदिन दुसमोन इतो आप दिनो। <verse eid="EST 3:10" /><verse number="11" style="v" sid="EST 3:11" />एने राजा हामानाह केयो, “ती चांदी तुवाह आपाय जाईल हे, एने ता माणहे बी काय तु ता हिऱ्यो जीहे तारा मोनाह पुटे तिहेच वेवारो केर।”<verse eid="EST 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 3:12" />ओवतो ताच मोयनान तेरावी दिह्याह राजान लेखणारे हादाड़ाय गीया, एने हामानान उकुमीन गेत राजान सोब आदिकारीह, एने सोब ईलाकान मुखी, एने देस देसान माणहान आदिकारीन केरता चिट्ठयु, एक एक ईलाकान अक्शोरा माय, एने एक एक देसान माणहान बाषा माय राजा क्षयर्षान नावा माय लेखाय गियी; एने त्यु माय राजान मुंदीन साप लागाड़ाय गियी। <verse eid="EST 3:12" /><verse number="13" style="v" sid="EST 3:13" />राज ने आखा ईलाका माय राजान उगे रेन ज्यी आसान चिट्ठयु आखा टोपाल्या उगे रेन मोकलाय गियी काय एकुच दिह्या माय, मतलब अदार नावान बारावा मोयनान तेरावी दिह्याह, काय जुवान, काय डावाला, काय बायकु, काय सोरा, सोब यहूदी माराय एने खेतेम केराय जाय; एने तान मालदेन लुट लेवाय जाय। <verse eid="EST 3:13" /><verse number="14" style="v" sid="EST 3:14" />ता उकुमान लेख्यान नेकेल आखा ईलाका माय उगाड़लोच मोकलाय गीयो काय सोब देसान माणहे ता दिह्यान केरता तियार एय जाय।<verse eid="EST 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 3:15" />ज्यो उकुम शूशन गेढ़ माय आपाय गीयो, एने टोपाल्या राजान उकुमा माय चालुच निकली गीया। राजा एने हामान ते अंगुरान रूह पिणे बोह गीया, पुण शूशन हेयरा माय बिय पोसरी गियी।<verse eid="EST 3:15" /></para>
  <chapter eid="EST 3" />
  <chapter number="4" style="c" sid="EST 4" />
  <para style="s">मोर्देकान एस्तेर फाय रेन मुदेक मांगणो</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 4:1" />जेवी मोर्देके सोमजी लिदो काय काय काय केराय जाईल हे, तेवी मोर्देक तान फाड़का फाड़ीन गोन्‍टा पिर्‍यो, एने रोखड़ो टाकीन हेयरान विचीम जाईन मोठेच दुखा माय आयेड़ने बाज गीयो, <verse eid="EST 4:1" /><verse number="2" style="v" sid="EST 4:2" />एने तो राजवाड़ान फाटेकीन सोमोर पुचनो, पुण गोंटो पेरीन राजवाड़ान फाटकी माय कुणीह जाणेन उकुम नाह इतो। <verse eid="EST 4:2" /><verse number="3" style="v" sid="EST 4:3" />एकेक ईलाका माय, जाहरी जाहरी राजान उकुम एने नेम पोचनो, ताहरी ताहरी यहूदी मोटलो दुख केरने एने उपास केरने एने रेड़ने किकेलने बाज गीया; पुण जुलूम जाणे गोंटो पेरीन एने रोखड़ो टाकीन पोड़ रेना।<verse eid="EST 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EST 4:4" />तेवी एस्तेर राणीन पावेरन्यु एने मुखी खोजा जाईन तिह केय देना, तेवी राणी दुखा माय बोराय गियी; एने मोर्देक फाय फाड़का मोकलीन ज्य केवाड़ी काय गोंटो काड़ीन ज्या फाड़का पेर लेय, पुण तो नाह पिऱ्यो। <verse eid="EST 4:4" /><verse number="5" style="v" sid="EST 4:5" />तेवी एस्तेर राजान मुखी खोजा माय रेन हताकाह जाह राजा ती फाय रेणेन ठेरायेल इतो, हादाड़ीन उकुम आपी काय मोर्देक फाय जाईन मालुम केर ले, काय काय वात हे, एने तान काय कारेण हे। <verse eid="EST 4:5" /><verse number="6" style="v" sid="EST 4:6" />तेवी हताक हेयरान ती चोवकी माय जी राजवाड़ान फाटेक ने सोमोर एती, मोर्देक फाय जात रिनो। <verse eid="EST 4:6" /><verse number="7" style="v" sid="EST 4:7" />मोर्देके ताह आखो काय केय दिनो काय मार पोर काय काय वितेल हे, एने हामान यहुदिह खेतेम केरनेन पारवांगी सापड़ावणेन केरता राजबान्डारा माय कोलीक चांदी बोर देणेन वचन आपेल हे, ज्य बी हास केरीन केय दिनो। <verse eid="EST 4:7" /><verse number="8" style="v" sid="EST 4:8" />पुशो यहुदिह खेतेम केरनेन उकुम शूशन गेढ़ माय आपाय जाईल इतो, तान एक नेकेल बी हताकान आथा माय, एस्तेरीह देखाड़नेन केरता आप्यो, एने तिह आखी हाल केणे एने ज्यो उकुम आपणेन केयो, काय माय राजा फाय जाईन आपणा माणहान केरता आथ जोड़ीन विन्ता केरी। <verse eid="EST 4:8" /><verse number="9" style="v" sid="EST 4:9" />तेवी हताक एस्तेर फाय जाईन मोर्देकान वातु केय होमलायो। <verse eid="EST 4:9" /><verse number="10" style="v" sid="EST 4:10" />तेवी एस्तेर हताकाह मोर्देकाह ज्य केणेन उकुम आपी, <verse eid="EST 4:10" /><verse number="11" style="v" sid="EST 4:11" />“राजान आखा काम केरनाराह, पुण राजा ईलाकान सोब माणहाह बी मालुम हे, काय एदमी, काय बायकु, कुण बी काहा नाह रेय, जा उकुम बिगेर सापड़ायेल माय खोली माय राजा फाय जाय ताह मार टाकणेन उकुम हे; निस्तो जा उगे राजा होनान राज डिंगो हुंबो केरी तोच वुचेह। पुण मी एवी तीस दिह वोर राजा फाय नाह हादाड़ायेल जाईल हे।”<verse eid="EST 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 4:12" />एस्तेरीन ज्यी वातु मोर्देकाह होमलाड़ाय गियी। <verse eid="EST 4:12" /><verse number="13" style="v" sid="EST 4:13" />तेवी मोर्देक एस्तेर फाय ज्य केय मुकल्यो, “तु मोना-मोनाच माय ज्य विचार मा केरी काय मी राजवाड़ा माय रेथु, केरीन सोब यहूदी माय रेन वोचीन रेह। <verse eid="EST 4:13" /><verse number="14" style="v" sid="EST 4:14" />काहाकाय तु ज्यी टेम माय ठावकी रिहे, ते उंजु काल्लीन काल्ली उपाय माय यहुदिन मुदेक एने सुटकारो एय जाय, पुण तु तारा आबाख ने गेराणा हेरीच खेतेम एय जाहे। काय जाणु तुवाह इहीच केठीण टेमीन केरता राजपद सापड़ी गीयो एय!”<verse eid="EST 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 4:15" />तेवी एस्तेर मोर्देक फाय ज्य केय मोकली, <verse eid="EST 4:15" /><verse number="16" style="v" sid="EST 4:16" />“तु जाईन शूशन वाला आखा यहुदिह टुलो केर, एने तुमू सोब मिलीन मार केरता उपास किरो, तीन दिह एने राती काय मा खाहो, एने काय मा पिवो। मी बी माऱ्यु पावेरन्यु हेरी इहीच केरीन उपास केरूह; एने ओहलीच देशा माय मी नेमान विरूद राजा फाय माय जाह; एने केदी मोरूह ते मोरूह।”<verse eid="EST 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EST 4:17" />तेवी मोर्देके जात रिनो एने एस्तेर ने उकुमान गेत तो आखो काय किऱ्यो।<verse eid="EST 4:17" /></para>
  <chapter eid="EST 4" />
  <chapter number="5" style="c" sid="EST 5" />
  <para style="s">एस्तेर राजा एने हामानाह खाणान नेवता आपणे</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 5:1" />तिसरी दिह एस्तेर तीन राणीन फाड़का पेरीन राजवाड़ान माय खोली माय जाईन, राजवाड़ान सोमोर उबरेय गियी। राजा ते राजवाड़ा माय राजगादी पोर गेरान बायणान सोमोर बोह रियेल इतो; <verse eid="EST 5:1" /><verse number="2" style="v" sid="EST 5:2" />एने जेवी राजा एस्तेर राणीह खोली माय उबरियेल दिख्यो, तेवी तो ती पोर खुस इन राजदेन्डाह जो तान आथा माय एतो, ती उगे ओंगाण किऱ्यो। तेवी एस्तेर आहने आवीन राजदेन्डीन टोक सापली। <verse eid="EST 5:2" /><verse number="3" style="v" sid="EST 5:3" />तेवी राजा तिह फुशो, “एय एस्तेर राणी, तुवाह काय जुवे? एने तु काय मांगेह? मांग एने तुवाह आदो राज वोर आपाय जाय।”<verse eid="EST 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EST 5:4" />एस्तेर केयी, “केदी राजाह पुटे, ते आज हामानाह आरही लेन ता खाणा माय आवी, जो मी राजान केरता तियार किरेल हे।”<verse eid="EST 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 5:5" />तेवी राजा उकुम आप्यो, “हामानाह जेल्दीच लेन आवो, काय एस्तेरीन नेवता मान लेवाय जाय।” तेवी राजा एने हामान एस्तेर तियार किरेल खाणा माय आवा। <verse eid="EST 5:5" /><verse number="6" style="v" sid="EST 5:6" />खाणेन टेम माय जेवी अंगुरान रूह पिवाय जाणे बाज रियेल एतो, तेवी राजा एस्तेरीह केयो, “तारी काय विन्ता हे? तु काय मांगेह? मांग एने आदो राज वोर तुवाह आपाय जाय।”<verse eid="EST 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EST 5:7" />एस्तेर जापाप आपी, “मारी विन्ता एने जो मी मांगथु तो ज्य हे, <verse eid="EST 5:7" /><verse number="8" style="v" sid="EST 5:8" />केदी राजा मार पोर खुस हे, ते मारी विन्ता हुमेलज्ये एने जी मांग मी मांगुह तोच आपज्ये राजाह स्वीकार एय, ते राजा एने हामान हेकाले ता खाणा माय आवी जाह मी तान केरता तियार केरूह, एने हेकाले मी राजान ज्या वचनान गेत केरूह।”<verse eid="EST 5:8" /></para>
  <para style="s">हामान मोर्देकाह मारनेन हुमच्यो केरने</para>
  <para style="p">
    <verse number="9" style="v" sid="EST 5:9" />ते दिह हामान खुस एने मोना माय खुस इन बाहेर गीयो। पुण जेवी तो मोर्देकाह राजवाड़ान फाटेक पोर दिख्यो, काय तो तान सोमोर नाह ते उबरिनो, एने नाह ते सिटो इनो, तेवी तो मोर्देकान विरूद रागा माय बोराय गीयो। <verse eid="EST 5:9" /><verse number="10" style="v" sid="EST 5:10" />तीबी हामान सोताह रोकीन तान गेर गीयो; एने तान जोड़ीदाराह एने तान बायकु जेरेशाह हादाड्यो। <verse eid="EST 5:10" /><verse number="11" style="v" sid="EST 5:11" />तेवी हामान ताह तान मालदेनान होवटाय, एने तान बाल बोचान वोड़ती एने राजा ताह किहीक किहीक वोदाड्यो, एने दिहरा सोब आदिकाऱ्याह एने तान सोब काम केरनाराह रेन उचो पोद आपेल इतो, त्यु सोब वात्यु किय होमलायो। <verse eid="EST 5:11" /><verse number="12" style="v" sid="EST 5:12" />हामान ज्य बी केयो, “एस्तेर राणी माहु सोड़ीन पोशी कुणीह राजान आरही, तीन तियार किरेल खाणा माय आवणे नाह देनी; एने हेकालेन केरता राजा हेरी ती माहु नेवता आपेल हे। <verse eid="EST 5:12" /><verse number="13" style="v" sid="EST 5:13" />काहाकाय जेवी जेवी माहु तो यहूदी मोर्देके राजवाड़ान फाटेक पोर बोह रियेल देखाह, तेवी ज्य सोब आदार सम्‍मान मारी नेजरी माय वायबार लागेह।”<verse eid="EST 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EST 5:14" />तान बायकु जेरेश एने तान आखा जोड़ीदार ताह केया, “पाचाह आथ उचो फासीन एक खांब बाणावाय जाय, एने उठ्यान राजाह किज्ये काय ता पोर मोर्देकाह टांगाड़ाय जाय; तेवी राजा हिऱ्यो खुसी माय खाणा माय जाज्ये।”</para>
  <para style="p" vid="EST 5:14">ज्यी वाती पोर खुस इन हामान तोहलोच फासीन एक खांब बाणवाड्यो।<verse eid="EST 5:14" /></para>
  <chapter eid="EST 5" />
  <chapter number="6" style="c" sid="EST 6" />
  <para style="s">राजा उगे रेन मोर्देकान सम्मान</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 6:1" />ती राती राजाह निंद नाह आवी, केरीन तान उकुमा माय इतिहासान पुस्तेक लावाय गियी, एने वाचीन राजाह होमलाड़ाय गियी। <verse eid="EST 6:1" /><verse number="2" style="v" sid="EST 6:2" /><note caller="+" style="x"><char style="xo" closed="false">6:2 </char><char style="xt" closed="false"><ref loc="EST 2:21-22">एस्तेर 2:21-22</ref></char></note>ती माय ज्य लेखायेल सापेड़नो, काय जेवी राजा क्षयर्षान आदिकारी जा राखवाल्या बी एता, ता माय रेन बिगतान एने तेरेश नावान दुय जाणे ताह मारनेन हुमच्यो किरेल एता, ताह मोर्देक देखाड़ेल इतो। <verse eid="EST 6:2" /><verse number="3" style="v" sid="EST 6:3" />तेवी राजा फुशो, “ज्यान बोदले मोर्देकान काय सुविदा एने बोड़ाय केराय गियी?” राजान जा सेवक तान सेवा केऱ्या केरताला, ता ताह जापाप आप्या, “तान केरता काईच नाह केराय गीयो।”<verse eid="EST 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EST 6:4" />राजा फुशो, “खोली माय कुण हे?”</para>
  <para style="p" vid="EST 6:4">तिच टेम माय हामान राजान गेरान बाहेरली खोली माय ज्यी आसा माय आयेल इतो काय जो खांब मोर्देकान केरता तियार केरायेल इतो, ता पोर ताह टांगाड़ देणेन वातु राजा हिऱ्यो केरी। <verse eid="EST 6:4" /><verse number="5" style="v" sid="EST 6:5" />तेवी राजान सेवक ताह केया, “खोली माय ते हामान उबरिनोह।”</para>
  <para style="p" vid="EST 6:5">राजा केयो, “ताह माय हाद लावो।” <verse eid="EST 6:5" /><verse number="6" style="v" sid="EST 6:6" />जेवी हामान माय आवो, तेवी राजा ताह फुशो, “जा माणहान बोड़ाय राजा केरने होदतेय, ते तान केरता काय केरने हाजो रेय?”</para>
  <para style="p" vid="EST 6:6">हामान ज्य सोचीन, “काय माहु रेन वोदार राजा कुणीन बोड़ाय केरने होदतेय?”<verse eid="EST 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EST 6:7" />तेवी हामान राजाह जापाप आप्यो, “जा माणहान पोद राजा वोदाड़ने हुदे।”<verse eid="EST 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EST 6:8" />तान केरता राजान फाड़का लावाय जाय, जा राजा पिरेह, एने एक गुड़ो बी जा पोर राजा बुहेह, एने तान मुंडी पोर जो राजकीय मुकूट पेरावाय जाथे, तो बी लावाय जाय। <verse eid="EST 6:8" /><verse number="9" style="v" sid="EST 6:9" />पोशो ता फाड़का, एने तो गुड़ो राजान एगदा मोटला आदिकारीह होपाय जाय; एने जान राजा मान मेलने हुदेह, ताह ता फाड़का पेरावाय जाय, एने ता गोड़ा पोर बोहीन हेयरान चोवकी माय ताह फिरवाय जाय; एने तान ओंगाण ओंगाण ज्य पारचार केराय जाय, “जान बोड़ाय राजा केरने हुदेह, ता हेऱ्यो ओहलोच केराय जाय।”<verse eid="EST 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 6:10" />राजा हामानाह केयो, “तावणी केरीन कियेल तिहे ता फाड़का एने ता गोड़ाह लियाव, ता यहूदी मोर्देक हेऱ्या जो राजवाड़ान फाटेक पोर बोह्या किरेह, तिहेच केर। जीहे तु कियेल हे, ता माय काय बी कोमी एणे नाय जुवे।”<verse eid="EST 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EST 6:11" />तेवी हामान ता फाड़का, मोर्देकाह पेरायो, एने ताह ता गोड़ा पोर बोहाड़ीन हेयरान चोवकी माय इह केरीन आयेड़ते लेन फिरायो, “जान बोड़ाय राजा केरने हुदेह ता हेऱ्यो ओहलोच केराय जाय।”<verse eid="EST 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 6:12" />तेवी मोर्देके ते राजवाड़ान फाटेक पोर जात रिनो, पुण हामान दुखी इन एने मुंड डापीन जेल्दीच तान गेर गीयो। <verse eid="EST 6:12" /><verse number="13" style="v" sid="EST 6:13" />हामान तान बायकु जेरेश एने तान सोब जोड़ीदाराह जो काय इयेल तो आखो काय केय दिनो। तेवी तान उशार जोड़ीदार एने तान बायकु जेरेश ताह केयो, “मोर्देके जाह तु निचो देखाड़ने हुदेह, केदी तो यहुदिन वोसी माय वालो हे, ते तु ताह जिक नाय सिकहे ताह रेन निचोच रिहे।”<verse eid="EST 6:13" /></para>
  <para style="s">हामानान मोत</para>
  <para style="p">
    <verse number="14" style="v" sid="EST 6:14" />ता ता हेऱ्या वातु केरनेच बाज रियेल एता काय राजान मुखी सेवक आवीन हामानाह एस्तेरीन खाणा माय जेल्दीच हाद ली गीया।<verse eid="EST 6:14" /></para>
  <chapter eid="EST 6" />
  <chapter number="7" style="c" sid="EST 7" />
  <para style="p">
    <verse number="1" style="v" sid="EST 7:1" />तेवी राजा एने हामान एस्तेर राणीन खाणा माय आव लागा। <verse eid="EST 7:1" /><verse number="2" style="v" sid="EST 7:2" />राजा दिहरी दिह अंगुरान रूह पित पितोच एस्तेरीह पुशो फुशो, “एय एस्तेर राणी! तारी काय विन्ता हे? ती पुरी केराय जाय। तु काय मांगेह? मांग, एने आदो राज वोर तुवाह आपाय जाय।”<verse eid="EST 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EST 7:3" />एस्तेर राणी जापाप आपी, “एय राजा! केदी तु मार पोर खुस हे, एने राजाह ज्य मोंजुर एय, ते मारी विन्ता केरीन माहु, एने मारो मांगणे माय मारा माणहाह जिवनदान जुड़ी। <verse eid="EST 7:3" /><verse number="4" style="v" sid="EST 7:4" />काहाकाय मी एने मारा माणहे वेचाय जायेल हेते, एने आमु सोब माराय एने खेतेम केराय जाण्या हेते। केदी आमु निस्ता पावोर पावेरनी बोणनेन केरता वेचाय जाता, ते मी ठावकी रेती; ती देशा माय बी तो विरोदी राजान नुकसानी बोर नाय सिकतो।”<verse eid="EST 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 7:5" />तेवी राजा क्षयर्ष एस्तेर राणीह फुशो, “तो कुण हे? एने का हे, जो ओहलो केरनेन ईमोत किरेल हे?”<verse eid="EST 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EST 7:6" />एस्तेर जापाप आपी, “तो विरोदी एने दुसमोन ज्योच पापी हामान हे!”</para>
  <para style="p" vid="EST 7:6">तेवी हामान राजा राणीन सोमोर जुलूम बिय गीयो। <verse eid="EST 7:6" /><verse number="7" style="v" sid="EST 7:7" />राजा रागा माय बोराय गीयो, अंगुरान रूह पिणे सोड़ीन राजवाड़ान वाड़ी माय निकली गीयो; एने हामान ज्य देखीन काय राजा मारी नुकसानी ठेराव लिदो एय, एने एस्तेर राणी फाय जिवनदान मांगणेन उबरिनो। <verse eid="EST 7:7" /><verse number="8" style="v" sid="EST 7:8" />जेवी राजा राजवाड़ान बोगीचा माय रेन अंगुरान रूह पिणेन जागे फिरीन आवो, तेवी काय दिख्यो काय हामान तान पाटला पोर जा पोर एस्तेर बोह रेनीह एने निचो एन माफी मांगणे बाज रिनोह; एने राजा केयो, “काय ज्याच गेराच माय मार सुमोरच राणी हिऱ्यो जोर जबरजोस्ती केरने हुदेह?”</para>
  <para style="p" vid="EST 7:8">राजान मुया माय रेन ज्यो बोल निकलेल एतोच, काय पावोर हामानान मुय डाप देना। <verse eid="EST 7:8" /><verse number="9" style="v" sid="EST 7:9" />तेवी राजान सोमोर एजुर रेणारे मुखी सेवक माय रेन हर्बोना नावान एक जाण राजाह केयो, “हामाना फाय पाचाह आथ उचो फासीन एक खांब उबो हे, जो मोर्देकान केरता बाणवायेल हे, जो राजान केरता हाजी वातु कियेल इतो!”</para>
  <para style="p" vid="EST 7:9">तेवी राजा केयो, “ज्याह ताच पोर टांग दिवो।”<verse eid="EST 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 7:10" />तेवी हामान ताच खांबा पोर जो तो मोर्देकान केरता तियार केरायेल इतो, टांगाड़ देवाय गीयो। ज्या पोर राजान राग ओलाय गीयो।<verse eid="EST 7:10" /></para>
  <chapter eid="EST 7" />
  <chapter number="8" style="c" sid="EST 8" />
  <para style="s">यहुदि माणहाह वोचणेन आदिकार सापड़नो</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 8:1" />यहुदिह राजा क्षयर्ष यहुदिन विरोदी हामानान गेरबार एस्तेर राणीह आप दिनो। मोर्देके राजान सोमोर आवो, काहाकाय एस्तेर राजा कियेल एती, काय ता हेऱ्यो तीन काय नातो एतो। <verse eid="EST 8:1" /><verse number="2" style="v" sid="EST 8:2" />तेवी राजा तान ती मुंदी ज्यी तो हामान फाय रेन मांग लियेल इतो, काढ़ीन मोर्देकाह आप दिनो। एने एस्तेर मोर्देकाह हामानान गेरबारा पोर आदिकारी बाणाव देनी।<verse eid="EST 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EST 8:3" />पोशी एस्तेर दिहरी वार राजाह केयी; एने तान पाया पोड़ीन आहवा गाली गालीन ताह रावण्या केरीन विन्ता केरी काय अगागी वोसीन हामानान बुराय एने यहुदिन नुकसानीन हुमच्यो रेद केराय जाय। <verse eid="EST 8:3" /><verse number="4" style="v" sid="EST 8:4" />तेवी राजा एस्तेर उगे होनान राजदेन्ड ओंगाण किऱ्यो तेवी एस्तेर उठीन राजान सोमोर उबरेनी, <verse eid="EST 8:4" /><verse number="5" style="v" sid="EST 8:5" />एने केणे बाज गियी, “केदी राजाह मोंजुर एय एने मार पोर खुस हे एने ज्यी वात ताह हाजी लागे, एने मी बी ताह हाजी लागथो, ते ज्यु चिट्ठयु हम्मदात अगागीन सोरो हामान राजान आखा ईलाकान यहुदिह खेतेम केरनेन हुमच्यो केरीन लेखाड़ेल इतो, त्युह रेद केरनेन केरता लेखाय जाए।” <verse eid="EST 8:5" /><verse number="6" style="v" sid="EST 8:6" />काहाकाय मी मारा माणहे एने मारा गेराणा पोर पोड़नार ती पिढ़ाह किहीक देख सेकुह?<verse eid="EST 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EST 8:7" />तेवी राजा क्षयर्ष एस्तेर राणीह एने यहूदी मोर्देकाह केयो, “मी हामानान गेरबार ते एस्तेरीह आप दियेल हे, एने हामान फासीन खांबा पोर टांग दियेल हे, केरीन काय तो यहुदिह मारनेन केरता आथ विसेल इतो। <verse eid="EST 8:7" /><verse number="8" style="v" sid="EST 8:8" />तेवी तुमू तुमरी एकलीन गेत राजान नावा पोर यहुदिन बाराम लिख्‍यो, एने राजान मुंदीन साप बी लागाड़ो; काहाकाय चिट्ठी राजान नावा पोर लेखाय जाय, एने ती पोर मुंदीन साप लागाड़ाय जाय, तिह कुण बी रेद नाह किर सिकेत।”<verse eid="EST 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EST 8:9" />तीच टेम माय मतलब सीवान नावान तीसरा मोयनान तेवीसवा दिह्याह राजान लेखणार हादाड़ाय गीया, एने जी जी वातीन उकुम मोर्देके ताह आपेल इतो, ताह यहुदि एने आदिकारी एने भारत लागतो कुश देस वोर, जो एक होव सत्तावीस ईलाका हेते, ता सोबान मुखी एने आदिकाऱ्याह एक एक ईलाकान आक्षर माय एक एक देसान माणहान बाषा माय, लेखाय गियी। <verse eid="EST 8:9" /><verse number="10" style="v" sid="EST 8:10" />मोर्देके राजा क्षयर्षान नावा माय चिट्ठयु लेखाड़ीन, एने ता पोर राजान साप लागाड़ीन जोरेस दोवेड़नारे सारकारी गोड़ा पोर बुहेल एता, तान आथा माय मोकली दिनो।<verse eid="EST 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EST 8:11" />त्यु चिट्ठयु माय सोब हेयरान यहुदिह राजा उगे रेन पारवांगी आपाय गियी, काय ता टोलवाय एने जिव जिवान जीव वोचाड़नेन केरता तियार इन, जी जातीन नाहते ईलाकान माणहे बुराय केरीन ताह नाहते तान बायकु एने बाल बोचाह दुख देणे हुदे, नाहते मारे एने खेतेम केरी, एने तान मालदेन लुट लेय।<verse eid="EST 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 8:12" />एने ज्य राजा क्षयर्षान सोब ईलाका माय एकुच दिह्या माय केराय जाय, मतलब अदार नावान बारावा मोयनान तेरावा दिह्याह। <verse eid="EST 8:12" /><verse number="13" style="v" sid="EST 8:13" />ज्या उकुमान लेख्यान नेकल्यु, आखा ईलाका माय सोब देसान माणहा फाय उगड़ेल मोकलाय जाय; काय यहूदी ते दिह तान दुसमोना हेऱ्या बुदलो लेणेन तियार रेय। <verse eid="EST 8:13" /><verse number="14" style="v" sid="EST 8:14" />तेवी सारकारी गोड़ा पोर बोहणारे, राजान उकुम केरीन तावणी केरीन जेल्दी जात रेना, एने ज्यो उकुम शूशन गेड़ान राजदानी माय आपाय जाईल एती।<verse eid="EST 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 8:15" />तेवी मोर्देक निल्ला एने दोवल्या रेंगान राजान फाड़का पेरीन एने मुंडा माय होनान मुकूट पेरीन हुवाल्ला जामण्या रेंगान चोगो पेरीन राजान सोमोर रेन निकेलनो, एने शूशन हेयरान माणहे खुसी माय बोफखार उठना। <verse eid="EST 8:15" /><verse number="16" style="v" sid="EST 8:16" />यहुदिन खुसी एने मोंज एनी एने तान मोठली बोड़ाय एनी। <verse eid="EST 8:16" /><verse number="17" style="v" sid="EST 8:17" />एने जा जा ईलाका, एने जा जा हेयरा माय, जाहरी का राजान उकुम एने नेम पुचनो, ताहरी ताहरी यहुदिन खुसी एने मोंज एनी, एने ता खाणो खाईन ता दिह्याह खुसीन दिह मान्या। एने ता देसान माणहा माय रेन जुलूम माणहे यहूदी बोण गीया, काहाकाय तान मोना माय यहुदि माणहान बिय रिग जाईल इतो।<verse eid="EST 8:17" /></para>
  <chapter eid="EST 8" />
  <chapter number="9" style="c" sid="EST 9" />
  <para style="s">यहूदी माणहान तान दुसमोनाह खेतेम केरनो</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 9:1" />अदार नावान बारावा मोयनान तेरावी दिह्याह, जेदिह राजान उकुम एने नेम पुरा एणेन एतो, एने यहुदिन दुसमोन ताह जिकणेन आसा मेलताला, पुण तान उल्टा यहूदी तान दुसमोनाह जिक गीया। <verse eid="EST 9:1" /><verse number="2" style="v" sid="EST 9:2" />ते दिह यहूदी माणहे राजा क्षयर्षान आखा ईलाका माय जिव जिवान हेयरा माय टोलवाना, काय जा तान नुकसानी केरनेन कोसीत केरी, ता पोर आथ विसे। कुण तान सामनो नाह केर सेकनो, काहाकाय तान बिय देस देसान माणहान मोना माय रिग जाईल इतो।<verse eid="EST 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EST 9:3" />पुण ईलाकान सोब आदिकारी एने डायडाया, एने मुखी एने राजान काम केरनारे यहुदिन मुदेक केऱ्या, काहाकाय तान मोना माय मोर्देकान बिय रिग जाईल इतो। <verse eid="EST 9:3" /><verse number="4" style="v" sid="EST 9:4" />मोर्देके ते राजा फाय जुलूम नाव गाजेल इतो, एने तान बाहदुरी आखा ईलाका माय पोसरी गियी; पुण ता एदमी मोर्देकान बोड़ाय वोड़ती गियी। <verse eid="EST 9:4" /><verse number="5" style="v" sid="EST 9:5" />केरीन यहूदी तान सोब दुसमोनाह तालवारी केरीन मारीन खेतेम केर टाक्या, एने तान दुसमोनाह तान मोरजी पारमाणे वेवारो केऱ्या।<verse eid="EST 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EST 9:6" />शूशन राजगेढ़ा माय यहूदी पाच होव माणहाह मारीन खेतेम केर देना। <verse eid="EST 9:6" /><verse number="7" style="v" sid="EST 9:7" />ता पर्शन्दाता, दल्पोन, अस्पाता, <verse eid="EST 9:7" /><verse number="8" style="v" sid="EST 9:8" />पोराता, अदल्या, अरीदाता, <verse eid="EST 9:8" /><verse number="9" style="v" sid="EST 9:9" />पर्मशता, अरीसे, अरीदे, एने वेजाता, <verse eid="EST 9:9" /><verse number="10" style="v" sid="EST 9:10" />मतलब हम्मदात ने सोरो यहुदिन विरोदी हामानान दोह सोराह बी माऱ्या; पुण तान मालदेनाह नाह लुट्या।<verse eid="EST 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EST 9:11" />ते दिह शूशन गेढ़ माय मारायेल तान गेणती राजाह होमलाड़ाय गियी। <verse eid="EST 9:11" /><verse number="12" style="v" sid="EST 9:12" />तेवी राजा एस्तेर राणीह केयो, “यहूदी शूशन राजगेढ़ाच माय पाच होव माणहाह एने हामानान दोह सोराह मारीन खेतेम किरेल हेते; पोशा राज ने दिहरा ईलाका माय ता काय जाणू काय काय केऱ्या एती! एवी ज्याह रेन वोदार तारी विन्ता काय हे? तो बी पुरो केराय जाय। तु काय मांगेह? तो बी तुवाह आपाय जाय।”<verse eid="EST 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EST 9:13" />एस्तेर केयी, “केदी राजान मोरजी एय ते शूशन गेड़ान यहुदिह आजीन गेत हेकाले बी केरनेन उकुम आपाय जाय, एने हामानान दोह सोराह फासीन खांबा पोर टांगाड़ाय जाय।” <verse eid="EST 9:13" /><verse number="14" style="v" sid="EST 9:14" />राजा केयो, “ओहलोच केराय जाय;” ज्यो उकुम शूशन गेढ़ा माय आपाय गियी, एने हामानान दोह सोरा टांगाड़ाय गीया। <verse eid="EST 9:14" /><verse number="15" style="v" sid="EST 9:15" />शूशन वाला यहूदी अदार मोयनान चौदावा दिह्याह बी एकठा टोलवायीन शूशन माय तीन होव एदम्याह माऱ्या एने मालदेन नाह लुट्या।<verse eid="EST 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EST 9:16" />राज ने दिहरा ईलाकान यहुदि एकठा टोलवायीन जान तान जीव वोचाड़नेन केरता उब रेना, एने तान दुसमोना माय रेन पंच्याहत्तर एजार माणहाह मारीन तान दुसमोना हेऱ्या रेन आराम सापड़ाया, पुण मालदेन नाह लुट्या। <verse eid="EST 9:16" /><verse number="17" style="v" sid="EST 9:17" />ज्य अदार मोयनान तेरावा दिह्या माय केराय गीयो, एने चौदावा दिह्या माय ता आराम केरीन खाणो खादा एने खुसीन दिह ठेराया। <verse eid="EST 9:17" /><verse number="18" style="v" sid="EST 9:18" />पुण शूशन हेयरान यहुदि अदार मोयनान तेरावा दिह्याह एने ताच मोयनान चौदावे दिह्याह एकठा एना, एने ताच मोयनान पोन्दरावा दिह्याह ता आराम केरीन खाणान एने खुसीन दिह ठेराया। <verse eid="EST 9:18" /><verse number="19" style="v" sid="EST 9:19" />केरीन गावावाला यहुदि जा बिगेर बितड़ान वोहती माय रेताला, ता अदार मोयनान चोवदावा दिह्याह खुसी, खाणो, सुट्‍टी एने आपसाम खाणेन वोस्तु मोकेलनेन दिह ठेरावीन मानतेह।<verse eid="EST 9:19" /></para>
  <para style="s">पुरीम नावान तिवार ठेरवाय जाणो</para>
  <para style="p">
    <verse number="20" style="v" sid="EST 9:20" />ज्यु वात्यु लेखीन मोर्देके राजा क्षयर्षान आखा ईलाका माय, काय आहने काय सेटा रेणारे आखा यहूदी फाय चिट्ठयु मोकल्यु, <verse eid="EST 9:20" /><verse number="21" style="v" sid="EST 9:21" />एने ज्यो उकुम आप्यो, काय अदार मोयनान चौदावा एने ताच मोयनान पोन्दरावा दिह्याह देर वोरीह तिवार मोणाया केरी। <verse eid="EST 9:21" /><verse number="22" style="v" sid="EST 9:22" />जा माय यहूदी तान दुसमोना हेऱ्या रेन आराम सापड़ाया, एने ज्य मोयनो जा माय दुख खुसी माय एने रेड़नो खुसी माय बोदली गीयो; मान्या केरी एने ताह खाणो एने खुसी एने एक दिहरा फाय खाणेन वोस्तु मोकेलने एने गेरब्याह दान आपणेन दिह माने। <verse eid="EST 9:22" /><verse number="23" style="v" sid="EST 9:23" />तेवी यहूदी जिह केरीन सुरवात किरेल एता, एने जीहे मोर्देके ताह लिख्यो, तिहेच चालु मेलनेन हुमच्यो केर लेदा।<verse eid="EST 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EST 9:24" />
    <note caller="+" style="x">
      <char style="xo" closed="false">9:24 </char>
      <char style="xt" closed="false">
        <ref loc="EST 3:7">एस्तेर 3:7</ref>
      </char>
    </note>काहाकाय हम्मदात अगागीन सुरो हामान जो सोब यहुदिन विरोदी इतो, तो यहुदिह खेतेम केरनेन हुमच्यो किऱ्यो, एने ताह मिटाड़ टाकणेन पुरीम मतलब चिट्ठ्यु निकालेल इतो। <verse eid="EST 9:24" /><verse number="25" style="v" sid="EST 9:25" />पुण जेवी राजा ज्य जाण लिदो, तेवी तो उकुम आप्यो एने लेखाय किऱ्यो ज्यो खाराब हुमच्यो हामान यहुदिन विरूद किरेल इतो, तो ताच ने मुंडी पोर पोलटी आवो, तेवी तो एने तान सोरो फासीन खांबा पोर टांगाड़ाय गीयो। <verse eid="EST 9:25" /><verse number="26" style="v" sid="EST 9:26" />तान कारेण ता दिह्यान नाव पुर सोब्दा पोर रेन पुरीम मेलाय गीयो। ज्यी चिट्‍ठयुन सोब वातुन केरता, एने काय ता ज्या बारा माय देख्या एने जो काय ता पोर वितेल एतो, तान कारेण बी। <verse eid="EST 9:26" /><verse number="27" style="v" sid="EST 9:27" />यहूदी जान तान केरता एने तान सोरान केरता, एने ता सोबान केरता बी जा ता माय बेचकाय जाईल एता, ज्य नाह टेलनार वायदो केऱ्या, काय ता लेखान गेत देर वोरीह तान ठेरायेल टेम माय ज्या दुय दिह माने; <verse eid="EST 9:27" /><verse number="28" style="v" sid="EST 9:28" />एने पिढ़ी पिढ़ी, गेराणा गेराणान, ईलाका ईलाकान, हेयरा हेयरा माय ज्या दिह इर केऱ्या एने मानाय जाती, एने पुरीम नावान दिह यहूदी माय केदी नाय खेतेम एय, एने तान नाव एर तान वोसी माय रेन नाय जाय।<verse eid="EST 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EST 9:29" />पोशी अबीहेलान सोरी एस्तेर राणी, एने मोर्देक यहूदी, पुरीमान बारा माय ज्यी दुसरी चिट्ठी मोटला आदिकार माय लेखी। <verse eid="EST 9:29" /><verse number="30" style="v" sid="EST 9:30" />ज्यान नेकेल मोर्देके क्षयर्षान राज ने एक होव सत्तावीस ईलाकान सोब यहूदी फाय सान्ती आपणार एने खेरली वातु हेरी ज्यी आसा माय चिट्ठयु ले मोकली, <verse eid="EST 9:30" /><verse number="31" style="v" sid="EST 9:31" />काय पुरीमान ता दिह्यान खास ठेरायेल टेमी माय मोर्देक यहूदी एने एस्तेर राणीन उकुमान गेत, एने जा यहूदी तान एने तान सोरान केरता ठाण लियेल एता, तान गेत बी उपास एने दुख केराय जाय। <verse eid="EST 9:31" /><verse number="32" style="v" sid="EST 9:32" />पुरीमान बारा माय ज्यो नेम एस्तेरीन उकुमा माय उबो केराय गीयो, एने तान चेरचा पुस्तेक माय लेखाय गियी।<verse eid="EST 9:32" /></para>
  <chapter eid="EST 9" />
  <chapter number="10" style="c" sid="EST 10" />
  <para style="s">राजा क्षयर्ष एने मोर्देकान बाहदुरी</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 10:1" />राजा क्षयर्ष देस एने देरीयान आहनेवाला टापु दुयू पोर फालो लेणेन चालु किऱ्यो। <verse eid="EST 10:1" /><verse number="2" style="v" sid="EST 10:2" />तान बोड़ाय एने बाहदुरीन कामे, एने मोर्देकान ती बोड़ायीन पुरी वातु, जो राजा तान किरेल इतो, काय तो मादे एने फारस ने राजान इतिहासान पुस्तेक माय नाह लेखायेल सोतो? <verse eid="EST 10:2" /><verse number="3" style="v" sid="EST 10:3" />यहूदी मोर्देके, क्षयर्ष राजान पासाण इतो, एने यहुदिन नेजरी माय मुठो इतो, एने तान सोब बाहख ता पोर खुस एता, काहाकाय तो तान माणहान बोलायीन केरता काम किरेल इतो; एने तान सोब माणहा हिऱ्यो सान्तीन बाराम बोलतालो।<verse eid="EST 10:3" /></para>
  <chapter eid="EST 10" />
</usx>