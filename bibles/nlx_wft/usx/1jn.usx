<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1JN" style="id">- Nahali</book>
  <para style="h">1 योहान</para>
  <para style="toc3">1 योहान</para>
  <para style="toc2">1 योहान</para>
  <para style="toc1">योहान लिखेल पेल्लो पोत्रो</para>
  <para style="mt2">युहन्ना ने लिखा हुआ पहला पत्र</para>
  <para style="mt1">योहान लिखेल पेल्लो पोत्रो</para>
  <para style="imt">ओलखात</para>
  <para style="ip">पेल्लो योहान ने पोत्र प्रेरित योहान द्‍वारे मसीन जेल्मान 50-100 वोरह्यान विचीम लेखाय जायेल ईतो। योहान सोताह लेखणारान रूप माय नाह केत, पुण पेल्लो बाग देखाड़ेह काय तो यीशुन जीवणो एने जीव उठणेन केरता एक गोवा हे। <char style="xt"><ref loc="1JN 1:1-3">1:1-3</ref></char> पेल्लो योहान ने लेखणेन तरीको योहानान हाजाली खोबरीम लिखेल हे तोहलोस ज्यी पोत्री माय लेखणेन तरीको हे। ओहलो केवाह काय योहान योहानान गेत जो हाजाली खुबेर लिखेल ईतो एने इफिसुस माय रेतेन तीन पोत्रु 1 योहान, 2 योहान, 3 योहान हेते।</para>
  <para style="ip">योहान ज्या पोत्राह आखा बुरहो केरनार बाय बोणहान केरता लिखेल ईतो जेवी मोंडलीह “एकलीवाला” नावान माणहान समुह फाय रेन तेकलीत एणे बाजरियेल एती। न्या माणहान मान्नु एतो काय यीशु पुरी रिती से बोगवान ईतो पुण हासलीन माह एने लुयान सेरीरा हिऱ्यो माणुह नाह ईतो देरती पोर। ज्यास कारेण से योहान यीशुन जीवणान होस आमने-सामने एणेन बाराम लिखेल एने कियेल काय तान आथा केरीन यीशुह सापलेल। <char style="xt"><ref loc="1JN 1:1-3">1:1-3</ref></char> ज्या पोत्राह लेखणेन योहान केणो तान खुसी पुरी केरने एतो। <char style="xt"><ref loc="1JN 1:4">1:4</ref></char> बुरहो केरनारा माणहान पाप केरने रोकणेन केरता, <char style="xt"><ref loc="1JN 2:1">2:1</ref></char> जुठी हिकवोणाह रेन बुरहो केरनारा माणहाह होमालनेन केरता, <char style="xt"><ref loc="1JN 2:26">2:26</ref></char> एने आसवासन आपणे काय बुरहो केरनारे वोच जायेल हेते। <char style="xt"><ref loc="1JN 5:13">5:13</ref></char></para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. योहान ओलखात केरने तान पोत्री एने लेखणेन कारेण केणे। <char style="ior"><ref loc="1JN 1:1-4">1:1-4</ref></char></para>
  <para style="io1">2. ओवतो तो किथे काय बोगवान उजालो हे एने आपुह तास रूप माय जीवणे जुवे। <char style="ior"><ref loc="1JN 1:5-3:10">1:5–3:10</ref></char></para>
  <para style="io1">3. तान पासाण तो आपुह एका दिहराह मोंग केरनेन उकुम एर केरावेह। <char style="ior"><ref loc="1JN 3:11-5:12">3:11–5:12</ref></char></para>
  <para style="io1">4. योहान तान पोत्री निवराव्यो। <char style="ior"><ref loc="1JN 5:13-21">5:13-21</ref></char></para>
  <chapter number="1" style="c" sid="1JN 1"/>
  <para style="s">जीवणान वचन</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 1:1">योहान 1:1</ref>
      </char>
    </note>ता जीवणान वचनान बाराम जो केलीन सुरवातीम रेन एतो। जाह आमु होमल्या, एने आमु ताह आमरा डोला केरीन देख्या; एने आथा केरीन सापलेल। <verse eid="1JN 1:1"/><verse number="2" style="v" sid="1JN 1:2"/><note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="JHN 1:14">योहान 1:14</ref></char></note>तो जीवाय आमुह देखानो, एने ताह आमु देख्या, एने तान गोवाय देतेह; एने ता जेलेमक्या जीवणान खुबेर तुमूह आपतेह तो आबाख हेऱ्यो एतो एने एवी आमरी विचीम आवो। <verse eid="1JN 1:2"/><verse number="3" style="v" sid="1JN 1:3"/>एने जो काय आमु देख्या एने होमलेल हेते, तान पुकार पाड़तेह काय तुमू बी आमरा हाती बोणी, एने आपणी मेल ते आबाख हेऱ्यी एने तान बेटाख यीशु मसी हेऱ्यो हे। <verse eid="1JN 1:3"/><verse number="4" style="v" sid="1JN 1:4"/><note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">आमरो; थोड़ाक लेख माय तुमरो हे।</char></note>तुमरी एने आमरी खुसी पुरी एय केरीन आमु ज्यो लेखतेह।<verse eid="1JN 1:4"/></para>
  <para style="s">उजाला माय चालनु</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5"/>ज्यी खुबेर आमु तान बेटाख फाय रेन होमलेल हेते, एने तोस तुमूह होमलावतेह, तो ज्योस काय बोगवान उजालो हे, एने ता माय कायच बी आदारो नाह सोतो। <verse eid="1JN 1:5"/><verse number="6" style="v" sid="1JN 1:6"/>केदी ता हेऱ्यी आपणी मेल हे ओहलो आपु केतेह, एने आंदारा माय चालतेह, ते आपु जुठ बोलतेह एने खेरायी पोर नाह चालते। <verse eid="1JN 1:6"/><verse number="7" style="v" sid="1JN 1:7"/>पुण तो जिहकेरीन उजाला माय हे, केदी आपु बी तिहेस केरीन उजाला माय चालहु, ते आपणी एका दिहरा हेऱ्यी मेल एय जाथे, एने तान बिटोख जो यीशु हे तान लुय आपणा आखा पापा माय रेन चोखो किरेह।<verse eid="1JN 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8"/>केदी आपु केहु माहु माय कायच बी पाप नाह सोतो, ते सोताह दुको देतेह, एने आपु माय खेराय नाह सोती। <verse eid="1JN 1:8"/><verse number="9" style="v" sid="1JN 1:9"/>केदी आपु आपणा पापाह मान लेय, ताहार बोगवान आपणा पापाह माफ केरने एने आपुह आखा पापाम रेन चोखो केरने माय बोरहावालो एने खीरलो हे। <verse eid="1JN 1:9"/><verse number="10" style="v" sid="1JN 1:10"/>एने केदी आपु केहु आमु पाप नाह केऱ्या, ते आपु बोगवानाह जुठो ठेरावतेह, एने तान वचन आपु माय नाह सोतो।<verse eid="1JN 1:10"/></para>
  <chapter eid="1JN 1"/>
  <chapter number="2" style="c" sid="1JN 2"/>
  <para style="s">मसी आमरो मोदेक केरनार</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1"/>एय मारा सोरा, तुमू पाप नाय केरने जुवे केरीन मी ज्यो तुमूह लेखथु; एने केदी एगदो पाप केरी, ते आबाख फाय आपणो एक मोदेक केरनार हे, मतलब सिदो यीशु मसी। <verse eid="1JN 2:1"/><verse number="2" style="v" sid="1JN 2:2"/>एने तोस आपणा पापाह माफ किरेह, एने आपणा ओलाच नाह पुण आखी दुनियान माणहान पापाह बी माफ किरेह। <verse eid="1JN 2:2"/><verse number="3" style="v" sid="1JN 2:3"/>केदी आपु तान उकुमाह मानहो, ते ज्या माय आपु जाण जाहु काय आपु बोगवानाह सोमजी गीयाह। <verse eid="1JN 2:3"/><verse number="4" style="v" sid="1JN 2:4"/>एने जो कुण ज्यो किथे, “मी ताह जाण गीयोह,” एने तान उकुमाह नाह मानेत, तो जुठो हे एने ता माय खेराय नाह सोती। <verse eid="1JN 2:4"/><verse number="5" style="v" sid="1JN 2:5"/>पुण जो कुण तान उकुमाह मानेह, ता माय खेरीच बोगवानान मोंग पुरो एनोह। ज्यासकेरीन आपु जाणतेह काय आपु बोगवानान मेल माय एक हेते; <verse eid="1JN 2:5"/><verse number="6" style="v" sid="1JN 2:6"/>जो कुण इही किथे काय मी ता माय बोणीन रेथु, ताह ज्यो जुवे काय जिहकेरीन मसी यीशु चालेल ईतो तिहेस केरीन तुमू बी चालने जुवे।<verse eid="1JN 2:6"/></para>
  <para style="s">नोवालो उकुम</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">2:7 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 13:34">योहान 13:34</ref>
      </char>
    </note>एय मोंगाल्ला बाय बोणहा, मी तुमूह काल्लो बी नोवालो उकुम नाह लेखथु, पुण तोस जुनालो उकुम जो सुरवाती माय रेन तुमूह जुड़ेल हे, ज्यो जुनालो उकुम तो वचन हे जाह तुमू होमलेल हेते। <verse eid="1JN 2:7"/><verse number="8" style="v" sid="1JN 2:8"/>तीबी मी तुमूह नोवालो उकुम लेखथु, एने जो मसी माय एने तुमरी माय खेरलो ठेराथे; काहाकाय आदारलो खेतेम ईती जाथे एने खेरायीन उजालो एवी चोमेकणे बाजरिनोह। <verse eid="1JN 2:8"/><verse number="9" style="v" sid="1JN 2:9"/>जो कुण इही किथे काय मी उजाला माय हे, एने तान बायाख हेऱ्यो दुसमोनाय किरेह, तो एवी वोर आंदारा मायच हे। <verse eid="1JN 2:9"/><verse number="10" style="v" sid="1JN 2:10"/><note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="ft" closed="false">दिहरो कुण; नाहते ताह।</char></note>जो कुण तान बायाख मोंग किरेह तो उजाला माय रीथे, एने कुणीन ठोकरान कारेण नाह बोण सिकेत। <verse eid="1JN 2:10"/><verse number="11" style="v" sid="1JN 2:11"/>पुण जो कुण तान बायाख हेऱ्यो दुसमोनाय किरेह, तो एवी वोर आंदारला माय हे एने आदारो तान डोलाह आंदलो केर दियेल हे।<verse eid="1JN 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 2:12"/>एय मारा सोरा, मी तुमूह ज्यो ज्यानकेरता लेखथु काय तान नाव केरीन तुमरा पाप माफ एनाह। <verse eid="1JN 2:12"/><verse number="13" style="v" sid="1JN 2:13"/>एय डायडाया, मी तुमूह ज्यानकेरता लेखथु काय जो सुरवाती रेन हे ताह तुमू जाणतेह। एय जुवान्या, मी तुमूह ज्यानकेरता लेखथु काय तुमू ता खाराबाह जिकेल हेते। <verse eid="1JN 2:13"/><verse number="14" style="v" sid="1JN 2:14"/>एय सोरा, मी तुमूह ज्यानकेरता लिखेल हे काय आबाख तुमू जाण गीयाह। एय डायडाया, मी तुमूह ज्यानकेरता लिखेल हे काय जो सुरवाती रेन हे ताह तुमू जाण गीयाह। एय जुवान्या, मी तुमूह ज्यानकेरता लिखेल हे काय तुमू ताकेतवाला हेते, बोगवानान वचन तुमरे माय बोणीन रीथे, एने तुमू ता खाराबाह जिक लियेल हेते।<verse eid="1JN 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15"/>तुमू दुनियाह एने दुनियान चिजीह मोंग मा किरो। केदी एगदो दुनियाह मोंग किरेह, ते ता माय आबाख ने मोंग नाह सोतो। <verse eid="1JN 2:15"/><verse number="16" style="v" sid="1JN 2:16"/>काहाकाय जो काय दुनिया माय हे, मतलब सेरीरान मोरजी एने डोलान मोरजी एने जीविकान गोमेंड, तो आबाख ने उगे रेन नाह; पुण दुनियास ने उगे रेन हे। <verse eid="1JN 2:16"/><verse number="17" style="v" sid="1JN 2:17"/>दुनिया एने तान मोरजी दुयू खेतेम एते जाथे, पुण जो बोगवानान मोरजी पोर चालेह तो जेलेम बोणीन रेय।<verse eid="1JN 2:17"/></para>
  <para style="s">मसीन विरोदी</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18"/>एय मारा सोरा, ज्यो सेवल्यो टेम हे; एने मसीन विरोद केरनार आवण्यो हे ज्यो तुमू जाण लियेल हेते तिहेस केरीन एवी बी मोकतास मसीन विरोद केरनारे बोण गीयाह; ज्या पोर रेन आपुह सोमजाह काय एवी सेवल्यो टेम हे। <verse eid="1JN 2:18"/><verse number="19" style="v" sid="1JN 2:19"/>ता आमरे माय रेन निकलेल, पुण आमरा हाती नाह एता; ता केदी आपणा रेता ते आपणी हेऱ्या रेता। ता माय रेन आपणो कुण नाय मीले ज्यो देखाड़नेन केरता निकेलना। <verse eid="1JN 2:19"/><verse number="20" style="v" sid="1JN 2:20"/>चोखाला जीवा केरीन तुमरो निवोड़ एनोह, एने एवी आखो काय तुमू जाणतेह। <verse eid="1JN 2:20"/><verse number="21" style="v" sid="1JN 2:21"/>तुमूह खेरलो मालुम नाह सोतो केरीन मी ज्यो एवी नाह लिख्यो, पुण ज्यानकेरता काय तुमू ताह जाणतेह, एने ज्यानकेरता काल्लो बी जुठ खेरलान उगे रेन नाह सोतो। <verse eid="1JN 2:21"/><verse number="22" style="v" sid="1JN 2:22"/>जुठो कुण हे? तोच जो यीशुह मसी ना सोतो केरीन नाकारेह; एने मसीन विरोद केरनार तोच हे जो आबाख एने सोराह नाकारेह। <verse eid="1JN 2:22"/><verse number="23" style="v" sid="1JN 2:23"/>जो सोराह नाकारेह ता फाय आबोख बी नाह सुतो; एने जो सोराह मान लिथे, ता माणहा फाय आबोख बी हे। <verse eid="1JN 2:23"/><verse number="24" style="v" sid="1JN 2:24"/>जो हिकवोण सुरवाती रेन तुमू होमलेल हेते, तोच तुमरी माय बोणीन रेय; जो सुरवाती रेन तुमू होमलेल हेते; केदी तो तुमरी माय बोणीन रेय ताहार तुमू बी बेटाख माय एने आबाख माय बोणीन रिहो। <verse eid="1JN 2:24"/><verse number="25" style="v" sid="1JN 2:25"/>एने जान वायदो तो आपणी हिऱ्यो किरेल हे तो जेलेमक्यी जीवाय हे।<verse eid="1JN 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26"/>मी तुमूह ता माणहान बाराम लिखेल ईतो, जा तुमूह बोटकाड़तेह। <verse eid="1JN 2:26"/><verse number="27" style="v" sid="1JN 2:27"/>पुण तुमरो तो चोखालो जीव जो तान उगे रेन ईयेल हे, तुमरे माय बोणीन रीथे; एने तुमूह कुण बी हिकाड़ी तान गिरेज नाह सोती, तान चोखालो जीव तुमूह आखान बाराम हिकाड़ेह, एने तो खेरलो हे जुठो नाह सोतो; जिहकेरीन तो तुमूह हिकाड़ेल हे तिहेस केरीन तुमरे माय बोणीन रीथे।<verse eid="1JN 2:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28"/>एवी एय सोरा, ता माय एक बोणीन रिवो, ज्यानकेरता काय जेवी तो आवी तेवी आपुह ईमोत रेणे जुवे, एने आपुह तान आवणेन टेम माय तान सामने लाजवाणे नाय पोड़ी। <verse eid="1JN 2:28"/><verse number="29" style="v" sid="1JN 2:29"/>तो सिदो हे ज्यो तुमू एवी जाणतेह, ते जो कुण खेरला काम किरेह, तो बोगवाना फाय रेन पायदा एनोह।<verse eid="1JN 2:29"/></para>
  <chapter eid="1JN 2"/>
  <chapter number="3" style="c" sid="1JN 3"/>
  <para style="s">बोगवानान सोरा</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:1 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 1:12">योहान 1:12</ref>
      </char>
    </note>दिखो, आबोख आपुह कोहलोक मोंग किऱ्यो काय आपु बोगवानान सोरा केवाती; एने आपु हेते बी। तान केरता दुनियान माणहे आपुह नाह जाणते, ता ताह बी नाह जाणते। <verse eid="1JN 3:1"/><verse number="2" style="v" sid="1JN 3:2"/>एय मोंगाल्ला बाय बोणहा, एवी आपु बोगवानान सोरा हेते, एने ओंगाण आपु काय बोणहु ज्यो उंजु मालुम नाह पोड़नो! पुण ज्यो मालुम हे काय जेवी तो आवी, तेवी आपु तान गेत एहु; काहाकाय जोहलो तो हे तोहलोस आपुह देखाय। <verse eid="1JN 3:2"/><verse number="3" style="v" sid="1JN 3:3"/>एने जो कुण ज्यी आसा मिलेह, तो सोताह तीह केरीन चोखो किरेह जिहकेरीन यीशु चोखालो हे।<verse eid="1JN 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4"/>जो कुण पाप किरेह, तो बोगवानान नेमान विरोद किरेह; एने पाप ते नेमान विरोदी हे। <verse eid="1JN 3:4"/><verse number="5" style="v" sid="1JN 3:5"/><note caller="+" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="JHN 1:29">योहान 1:29</ref></char></note><note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">पाप; थोड़ाक लेख माय आमरा पाप लिखेल हे।</char></note>एवी तुमू ज्यो जाणतेह काय तो ज्यानकेरता आवो काय पापाह उखलीन ली जाय; एने ता माय कायच बी पाप नाह सोतो। <verse eid="1JN 3:5"/><verse number="6" style="v" sid="1JN 3:6"/>जो कुण मसी माय एक एन रीथे तो पाप नाह किरेत; पुण जो कुण पाप किरेह तो ताह दिखेल नाह सोतो एने नाह जाणेत। <verse eid="1JN 3:6"/><verse number="7" style="v" sid="1JN 3:7"/>एय मारा सोरा, कुणीन बी वातु माय फासाहो मा। जा माणहे खेरायीपोणान काम केरतेह ताच माणहे तान गेत सिदा हेते। <verse eid="1JN 3:7"/><verse number="8" style="v" sid="1JN 3:8"/>जा माणहे पाप केरतेह ता सैतानान उगे रेन हेते, काहाकाय सैतान सुरवाती रेन पाप केरती आयेल हे। एने सैतानान कामाह खेतेम केरनेन केरता बोगवानान बिटोख आयेल।<verse eid="1JN 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 3:9"/>जा माणहे बोगवाना फाय रेन पायदा ईयेल हेते ता पाप नाह केर सेकते; काहाकाय तान सोबाव ता माणहा माय बोणीन रीथे, एने ता माणहे पाप केरीच नाह सेकते काहाकाय ता बोगवाना फाय रेन पायदा ईयेल हेते। <verse eid="1JN 3:9"/><verse number="10" style="v" sid="1JN 3:10"/>ज्या पोर रेन बोगवानान सोरा एने सैतानान सोरा जाणाय जातेह; जा माणहे खेरायीपोणान काम नाह केरते ता बोगवाना फाय रेन नाह सोता, एने नाह ता जा सोतान बायाख मोंग नाह केरती।<verse eid="1JN 3:10"/></para>
  <para style="s">एका दिहराह मोंग किरो</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:11 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 13:34">योहान 13:34</ref>
      </char>
    </note>काहाकाय जी खुबेर तुमू सुरवाती माय रेन होमलेल हेते: ती ज्यीच काय एका दिहराह मोंग किरो। <verse eid="1JN 3:11"/><verse number="12" style="v" sid="1JN 3:12"/>एने केनान गेत मा बुणो जो ता बुतड़ाम रेन ईतो, एने सोतान बायाख मार दियेल ईतो। एने ताह काहा मारील काय? तान कामे खाराब एता, एने तान बाहख हाबीलान कामे हाजा एता।<verse eid="1JN 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13"/>एय बाय बोणहा, केदी ज्यी दुनियान माणहे तुमू हेऱ्या दुसमोनाय मेलतेती ताहार बोंगलाहो मा। <verse eid="1JN 3:13"/><verse number="14" style="v" sid="1JN 3:14"/><note caller="+" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="JHN 5:24">योहान 5:24</ref></char></note>आमु बायाख मोंग केरतेह ज्या पोर रेन आमुह एवी सोमजेह काय आमु मुरेल माय रेन जीवणाम आयेल हेते, जा माणहे मोंग नाह केरती ता मुरेलान गेत हेते। <verse eid="1JN 3:14"/><verse number="15" style="v" sid="1JN 3:15"/>जो कुण सोतान बायाख हेऱ्यो दुसमोनाय मिलेह, तो खुनी हे; एने एवी तुमू जाणतेह काय काल्ला बी खुनी माय जेलेमक्यी जीवाय नाह रेत। <verse eid="1JN 3:15"/><verse number="16" style="v" sid="1JN 3:16"/>आपु मोंग ज्याकेरीन जाणेल काय मसी आपणे केरता सोतान जीव आप दियेल; एने आपुह बी बायाख ने केरता जीव आपणे जुवे। <verse eid="1JN 3:16"/><verse number="17" style="v" sid="1JN 3:17"/>पुण जा फाय बी ज्यी दुनियान मालदेन एय एने सोतान बायाख ने गिरेज देखीन ता पोर किव केरने नाय होदि, ते ता माय बोगवानान मोंग किहीक बोणीन रेय सिकेह। <verse eid="1JN 3:17"/><verse number="18" style="v" sid="1JN 3:18"/>एय मारा सोरा, आपु बोल एने जिबी केरीन ओलोस नाह, पुण काम एने खेरायीन द्‍वारे बी मोंग किरो।<verse eid="1JN 3:18"/></para>
  <para style="s">बोगवानान सामने ईमोत</para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19"/>ज्याकेरीन आपु जाणहु काय आपु खेरायीन हेते; तान बाराम आपु तान सामने आप आपणा मोनाह ईमोत आप सेकहु; <verse eid="1JN 3:19"/><verse number="20" style="v" sid="1JN 3:20"/>जेवी केदी आमरो मोन आमु पोर दोस लागाड़ती रिथे, काहाकाय बोगवान आपणा मोनाह रेन मुठो हे, एने आखो काय जाणेह। <verse eid="1JN 3:20"/><verse number="21" style="v" sid="1JN 3:21"/>एय मोंगाल्ला, केदी आपणो मोन आपुह दोस नाह देतो, ते आपुह बोगवानान ओंगाण ईमोत ईथे। <verse eid="1JN 3:21"/><verse number="22" style="v" sid="1JN 3:22"/>एने जो काय आपु मांगतेह, तो आपुह ता फाय रेन जुड़ेह, काहाकाय आपु तान उकुमाह मानतेह एने जो काय तान नेजरी माय हाजो हे तोच केरतेह। <verse eid="1JN 3:22"/><verse number="23" style="v" sid="1JN 3:23"/><note caller="+" style="x"><char style="xo" closed="false">3:23 </char><char style="xt" closed="false"><ref loc="JHN 13:34">योहान 13:34</ref>; <ref loc="JHN 15:12">15:12</ref>,<ref loc="JHN 15:17">17</ref></char></note>तान उकुम ज्योच हे काय आपु तान सोरा यीशु मसीन नावा पोर बुरहो केरी, एने जिहकेरीन यीशु आपुह उकुम आपेल हे तिहेच केरीन एका दिहरा हेऱ्या मोंग किरो। <verse eid="1JN 3:23"/><verse number="24" style="v" sid="1JN 3:24"/>जा माणहे बोगवानान उकुमाह मानतेह, ता ता माय एने तो ता माय बोणीन रिथे; एने तो जो जीव आपुह आपेल हे, ता पोर रेन आपुह मालुम पुड़ीह काय तो आपु माय बोणीन रिथे।<verse eid="1JN 3:24"/></para>
  <chapter eid="1JN 3"/>
  <chapter number="4" style="c" sid="1JN 4"/>
  <para style="s">जीवाह उलखो</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1"/>एय मोंगाल्ला, एक एक जीवा पोर बुरहो मा किरहो, पुण ता जीव बोगवानान उगे रेन हेते काय नाह तान पारेख किरज्‍यो; काहाकाय मोकतास जुठा जाणकार दुनिया माय फिरने बाजरेनाह। <verse eid="1JN 4:1"/><verse number="2" style="v" sid="1JN 4:2"/>बोगवानान जीवाह तुमू इहकेरीन ओलेख सेकतेह: जो जीव मान लिथे काय यीशु मसी सेरीर माय एन आवोह एने तो बोगवानान उगे रेन हे, <verse eid="1JN 4:2"/><verse number="3" style="v" sid="1JN 4:3"/>एने जो जीव यीशुह नाह मानेत, तो बोगवानान उगे रेन नाह सोतो; पुण तो जीव मसी विरोदीन जीव हे, जान बाराम तुमू होमेल लियेल हेते काय तो आवण्यो हे, एने एवी बी दुनिया माय हे। <verse eid="1JN 4:3"/><verse number="4" style="v" sid="1JN 4:4"/>एय मारा सोरा, तुमू बोगवानान हेते, एने जुठा जाणकाराह तुमू जिक लियेल हेते; काहाकाय जो बोगवान तुमू माय हे ताह रेन मुठो हे जो दुनिया माय हे। <verse eid="1JN 4:4"/><verse number="5" style="v" sid="1JN 4:5"/>ता दुनियान हेते, केरीन ता दुनियान वातु केरतेह, एने दुनिया तान हुमलेह। <verse eid="1JN 4:5"/><verse number="6" style="v" sid="1JN 4:6"/>आपु बोगवानान हेते, एने जा माणहे बोगवानाह जाणतेह, ता माणहे आपणी होमेलतेह; एने जा माणहे बोगवानाह नाह जाणते ता माणहे आपणी नाह होमेलते। इहकेरीन आपु खेरायीन जीवाह एने जुठा जीवाह ओलखी लेतेह।<verse eid="1JN 4:6"/></para>
  <para style="s">बोगवान मोंग हे</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7"/>एय मोंगाल्ला बाय बोणहा, तुमू आखा एका दिहराह मोंग किरो; काहाकाय मोंग बोगवाना फाय रेन हे। एने जो कुण मोंग किरेह तो बोगवाना फाय रेन पायदा ईयेल हे, एने तो बोगवानाह ओलखेह। <verse eid="1JN 4:7"/><verse number="8" style="v" sid="1JN 4:8"/>जो कुण मोंग नाह किरेत तो बोगवानाह नाह ओलखेत, काहाकाय बोगवान मोंग हे। <verse eid="1JN 4:8"/><verse number="9" style="v" sid="1JN 4:9"/>जो मोंग बोगवान आपुह किरेह, तो ज्या माय देखानो काय बोगवान तान एकुस सोराह दुनिया माय मोकलेल काय आपुह तान द्‍वारे जीवणो जुड़ी। <verse eid="1JN 4:9"/><verse number="10" style="v" sid="1JN 4:10"/>मोंग ज्या माय नाह काय आपु बोगवानाह मोंग केऱ्या, पुण ज्या माय हे काय तो आपुह मोंग किऱ्यो एने आपणा पापान माफीन ओहली बोलीन केरता तान सोराह मुकल्यो। <verse eid="1JN 4:10"/><verse number="11" style="v" sid="1JN 4:11"/>एय मोंगाल्ला, जेवी बोगवान आपणी पोर इहकेरीन मोंग किऱ्यो, ते आपुह बी एका दिहरा पोर मोंग केरने जुवे। <verse eid="1JN 4:11"/><verse number="12" style="v" sid="1JN 4:12"/><note caller="+" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="JHN 1:18">योहान 1:18</ref></char></note>बोगवानाह केदी बी कुण नाह देख्यो केदी आपु एका दिहराह मोंग केरहु, ते बोगवान आपणे माय बोणीन रीथे एने तान मोंग आपणे माय पुरो ईथे।<verse eid="1JN 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13"/>आपु ता माय एने तो आपणे माय रीथे, तो आपुह ज्या पोर रेन सोमजाथे काय बोगवान सोतान जीव आपुह आपेल हे। <verse eid="1JN 4:13"/><verse number="14" style="v" sid="1JN 4:14"/>आमु देख बी लियेल एने गोवाही देतेह काय आबोख सोराह दुनियान सुटकारो केरनेन केरीन मोकलेल हे। <verse eid="1JN 4:14"/><verse number="15" style="v" sid="1JN 4:15"/>यीशु बोगवानान बिटोख हे, इहकेरीन जो कुण कबुल किरेह, बोगवान ता माय बोणीन रीथे, एने तो बोगवाना माय रीथे। <verse eid="1JN 4:15"/><verse number="16" style="v" sid="1JN 4:16"/>जो मोंग बोगवान आपुह किरेह, ताह आपु जाण गीयाह एने आपुह ता पोर बुरहो हे। बोगवान मोंग हे, एने जो कुण बी मोंग माय बोणीन रीथे तो बोगवाना माय बोणीन रीथे, एने बोगवान ता माय बोणीन रीथे। <verse eid="1JN 4:16"/><verse number="17" style="v" sid="1JN 4:17"/>इहकेरीन मोंग पुरो ईथे काय आपुह नियाव ने दिह ईमोत एय; काहाकाय जिहकेरीन तो हे तिहेस केरीन ज्यी दुनिया माय आपु बी हेते। <verse eid="1JN 4:17"/><verse number="18" style="v" sid="1JN 4:18"/>मोंग माय बिय नाह रेणे, ज्योलोस नाह ते पुरो मोंग बियाह सेटो किर दिथे; काहाकाय बिय माय नियाव ईथे, एने जो बिथे तो मोंग माय पुरो नाह एनो। <verse eid="1JN 4:18"/><verse number="19" style="v" sid="1JN 4:19"/>आमु ज्यानकेरता मोंग केरतेह काय बोगवान पेल आमुह मोंग किऱ्यो। <verse eid="1JN 4:19"/><verse number="20" style="v" sid="1JN 4:20"/>मी बोगवानाह मोंग केरथु, इहकेरीन केयीन एगदो तान बायाख हेऱ्यो दुसमोनाय किरेह ते तो जुठो हे, काहाकाय तान बायाख तो जो दिखेल हे मोंग नाह किरेत, एने तो जो बोगवानाह नाह दिखेल हे मोंग नाह किर सिकेत। <verse eid="1JN 4:20"/><verse number="21" style="v" sid="1JN 4:21"/>जो बोगवानाह मोंग किरेह तो तान बायाख बी मोंग केरी, ज्यो उकुम आमु ता फाय रेन जुड़ेल हे।<verse eid="1JN 4:21"/></para>
  <chapter eid="1JN 4"/>
  <chapter number="5" style="c" sid="1JN 5"/>
  <para style="s">दुनिया पोर जिक</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1"/>यीशु मसी हे केरीन जो कुण बुरहो किरेह, तो माणुह बोगवाना फाय रेन पायदा ईयेल हे; एने जो कुण पायदा केरनाराह मोंग किरेह, ते तो ताह बी मोंग केरी जा फाय रेन तो पायदा एनोह। <verse eid="1JN 5:1"/><verse number="2" style="v" sid="1JN 5:2"/>आपु बोगवानाह मोंग केरतेह एने तान उकुमाह पालतेह, ते आपुह ज्यास पोर रेन सोमजाथे काय बोगवानान सोराह आपु मोंग केरतेह। <verse eid="1JN 5:2"/><verse number="3" style="v" sid="1JN 5:3"/><note caller="+" style="x"><char style="xo" closed="false">5:3 </char><char style="xt" closed="false"><ref loc="JHN 14:15">योहान 14:15</ref></char></note>काहाकाय बोगवानाह मोंग केरने ज्योस हे काय आपु तान उकुमाह मानने जुवे, एने तान उकुम केठीण नाह सोता। <verse eid="1JN 5:3"/><verse number="4" style="v" sid="1JN 5:4"/>काहाकाय जो काय बोगवाना फाय रेन पायदा ईयेल हे तो दुनियाह जिक लिथे, एने जो दुनियाह जिकेल हे तो ज्योस आपणो बुरहो हे। <verse eid="1JN 5:4"/><verse number="5" style="v" sid="1JN 5:5"/>यीशु बोगवानान बिटोख हे केरीन जो कुण बुरहो किरेह, ता सावाय कुण दुनियाह जिक सेकी?<verse eid="1JN 5:5"/></para>
  <para style="s">यीशु मसीन बाराम गोवाय</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6"/>जो पाण्यान द्‍वारे एने लुयीन द्‍वारे आयेल तो ज्योच, मतलब यीशु मसी। तो पाण्या केरीन ओलोस नाह। पुण पाण्या एने लुयी केरीन बी आयेल ईतो, तान गोवाह चोखालो जीव हे। काहाकाय चोखालो जीव खेरलो हे। <verse eid="1JN 5:6"/><verse number="7" style="v" sid="1JN 5:7"/>एने जो गोवाय दिथे, तो चोखालो जीव हे; काहाकाय जीव खेरलो हे। <verse eid="1JN 5:7"/><verse number="8" style="v" sid="1JN 5:8"/>गोवाय देणारे तीन हेते, जीव, पाणी एने लुय; एने एकुच वातु माय बेलातेह। <verse eid="1JN 5:8"/><verse number="9" style="v" sid="1JN 5:9"/>जेवी आपु माणहान गोवाय मान लेतेह, एने बोगवानान गोवाय ते ताह रेन मोठी हे; एने बोगवानान गोवाय ज्यीच हे काय तान सोरान बाराम तो गोवाय दियेल। <verse eid="1JN 5:9"/><verse number="10" style="v" sid="1JN 5:10"/>जो बोगवानान सोरा पोर बुरहो किरेह तो तान मोना माय गोवाय मिलेह। एने जो बोगवाना पोर बुरहो नाह केऱ्यो तो ताह जुठो ठेरावेह, काहाकाय बोगवान तान सोरान बाराम ज्यी गोवाय दियेल ती गोवाय पोर ता बुरहो नाह केऱ्या। <verse eid="1JN 5:10"/><verse number="11" style="v" sid="1JN 5:11"/><note caller="+" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="JHN 3:36">योहान 3:36</ref></char></note>एने ती गोवाय ज्यीच हे काय बोगवान आपुह जेलेमक्यी जीवाय आपेल हे, एने ज्यी जीवाय तान सोरा माय हे। <verse eid="1JN 5:11"/><verse number="12" style="v" sid="1JN 5:12"/>जा फाय बिटोख हे, ता फाय जीवाय हे; एने जा फाय बोगवानान बिटोख नाह सुतो, ता फाय जीवाय बी नाह सोती।<verse eid="1JN 5:12"/></para>
  <para style="s">जेलेमकी जीवाय</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13"/>जेलेमक्यो जीवाय तुमरो हे एवी ज्यो तुमूह मालुम एय जायेल हे, केरीन बोगवानान बेटाख ने नावा पोर बुरहो मेलनारे तुमूह मी ज्यो लेखथु। <verse eid="1JN 5:13"/><verse number="14" style="v" sid="1JN 5:14"/>तान बाराम आपुह ज्यो बुरहो हे, तो ज्योस काय आपु तान मोरजीन गेत काय बी मांगहु, ते आपणी तो होमली। <verse eid="1JN 5:14"/><verse number="15" style="v" sid="1JN 5:15"/>आपु जाणतेह काय जेवी आपु ता फाय रेन मांगतेह तेवी तो आपणी होमलेह, एने एवी आपु ज्यो जाणतेह काय ज्यी वात खेरी हे, आपु ज्यो बी जाणतेह आपु जो काय ता फाय मांगतेह ताह आपेह।<verse eid="1JN 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16"/>केदी एगदो तान बाय बोणहाह ओहलो पाप केरतालो देखीन जान फोल मोत नाय एय, ते विन्ती केरी, एने बोगवान तान तानकेरता जा ओहलो पाप किरेल हेते जान फोल मोत नाह सोती, जीवाय आपी। पाप ओहलो बी जान फोल मोत हे; तान बाराम मी विन्ती केरनेन केरता नाह केत। <verse eid="1JN 5:16"/><verse number="17" style="v" sid="1JN 5:17"/>आखी बातीन गेलेत ते पाप हे, पुण ओहलो पाप बी हे जान फोल मोत ना सोती।<verse eid="1JN 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18"/>बोगवानान सोरा पाप नाह केरनु, ज्यो एवी आपुह मालुम हे; एने जो बोगवाना फाय रेन पायदा ईयेल हे, तो ताह वोचाड़ीन मेल रीथे, एने तो खाराब ताह सापेल नाह सिकेत।<verse eid="1JN 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 5:19"/>आपु बोगवाना फाय रेन हेते ज्यो एवी आपु जाणतेह, एने आखी दुनिया ता खाराबान काबाम पोड़ रेनीह।<verse eid="1JN 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 5:20"/>एवी आपुह मालुम हे काय बोगवानान बिटोख आव लागेल हे, एने तो आपणा मोना माय सोमेज आपेल हे काय आपु ता खेरलाह ओलखी; एने आपु ता माय जो खेरलो हे, मतलब तान सोरा यीशु मसी माय रेतेह। खीरलो बोगवान एने जेलेमक्यी जीवाय ज्‍यीस हे। <verse eid="1JN 5:20"/><verse number="21" style="v" sid="1JN 5:21"/>एय मारा सोरा, सोताह मुरतीह रेन वोचाड़ीन मीलो।<verse eid="1JN 5:21"/></para>
  <chapter eid="1JN 5"/>
</usx>
