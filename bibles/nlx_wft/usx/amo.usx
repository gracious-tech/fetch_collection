<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="AMO" style="id">- Nahali</book>
  <para style="h">अमोस</para>
  <para style="toc3">अमोस</para>
  <para style="toc2">अमोस</para>
  <para style="toc1">अमोस</para>
  <para style="mt2">आमोस ने लिखी हुई किताब</para>
  <para style="mt1">आमोस लिखेल पुस्तेक</para>
  <para style="imt">ओलखात</para>
  <para style="ip">आमोस ज्या पुस्तेक माय आमोस ने बोविष्यान बाराम खुबेर हे। आमोस एक गोवाल इतो।<char style="xt"><ref loc="AMO 1:1">1:1</ref></char> एने एक किरसाण <char style="xt"><ref loc="AMO 7:14">7:14</ref></char> तेवी बोगवान ताह तान जाणकार बोणनेन केरता हाद्यो। आमोस तकोआ हेयरान इतो, जो यहुदा देक्षिण राज्या माय एतो, पुण तान मोकतीस खुबेर उत्तर ने इस्राएल ने केरता एतो। आमोस तेवी जाणाव किऱ्यो काय जेवी उजीया यहुदान राजा इतो एने यारोबाम दुसरो इस्राएल ने राजा इतो। ज्य कोमीत कोमी 750 यीशुन पेल ने वात हे।</para>
  <para style="ip">आमोस पेल्ला दुय अध्याय माय जुलूम देसान विरूद नियाव ने जाणाव किऱ्यो, पुण तान मोकतीस खुबेर इस्राएल ने केरता एती। ज्य इस्राएल ने केरता खुसालीन टेम एतो। ती खुसालीन वाराम ता बोगवानाह विहरी गीया एने गेरीब माणहा हेऱ्या खाराब वेवार केऱ्या।<char style="xt"><ref loc="AMO 2:6">2:6</ref></char> तान केरता बोगवानान नियाव ताह बोंदी बाणावीन ली जाणु एतो। <char style="xt"><ref loc="AMO 7:17">7:17</ref></char> तीबी बोगवान वायदो किऱ्यो काय तो इस्राएल ने माणहाह, ता दिहरा आखा देसा पोर पोशो जिक सापड़ावणेन मोदेक केरी जा पोर ता पेल राज किरेल एता। <char style="xt"><ref loc="AMO 9:12">9:12</ref></char></para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. आमोस तान ओलखात आपेह। <char style="ior"><ref loc="AMO 1:1">1:1</ref></char></para>
  <para style="io1">2. मोकतास देसा पोर फेसलो होमलावणे। <char style="ior"><ref loc="AMO 1:2">1:2</ref>; <ref loc="AMO 2:1-16">2:1-16</ref> </char></para>
  <para style="io1">3. इस्राएल नियाव एने बोंदीम जाणेन बाराम वात किरेह। <char style="ior"><ref loc="AMO 3:1">3:1</ref>; <ref loc="AMO 9:1-11">9:1-11</ref></char></para>
  <para style="io1">4. बोगवान वुचेल विश्वासीह इस्राएल माय पोशो लावणेन वायदो किरेह। <char style="ior"><ref loc="AMO 9:12-15">9:12-15</ref> </char></para>
  <chapter number="1" style="c" sid="AMO 1" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1" />आमोस तकोआ गावान एक गोवाल इतो। तान ज्य वचन हे, बुकेम एणेन दुय वोरह्या पेल तो इस्राएल देसान बाराम देरसेन दिखेल इतो, जेवी यहुदा पोर उजीयान एने इस्राएल पोर यहोआशान बिटोख यारोबाम ने राज इतो।<verse eid="AMO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="AMO 1:2" />तो केयो,</para>
  <para style="q1" vid="AMO 1:2">“बोगवान सियोन पोर रेन गाजी,</para>
  <para style="q2" vid="AMO 1:2">एने यरूशलेम रेन तान बोल होमलाड़ी;</para>
  <para style="q1" vid="AMO 1:2">तेवी गोवालान चाराय दुख मोणावी,</para>
  <para style="q2" vid="AMO 1:2">एने कर्मेल बोयड़ान चुटो हुक जाय।”<verse eid="AMO 1:2" /></para>
  <para style="s1">इस्राएल ने आहेंल्या देसान नियाव</para>
  <para style="s2">सिराया</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3" />बोगवान इहकेरीन किथे, “दमिश्क ने जाहार ताहार गुनान वोजेसे तान देन्ड नाय सोडु; काहाकाय ता गीलाद गावाह, मोलन्या लोड़ान आथ्यारा केरीन मोहंदेलेल हेते। <verse eid="AMO 1:3" /><verse number="4" style="v" sid="AMO 1:4" />केरीन मी राजा हजाएल ने राज गेराणाम आक्‍ठो पेटाडुह, आक्‍ठो तान सोरान बेन्हद्द ने राज किल्‍ला बी हेलगी जाती। <verse eid="AMO 1:4" /><verse number="5" style="v" sid="AMO 1:5" />मी दमिश्क ने रिगण्या बायणाह तोड़ देह, एने आवेन नावान गाटाम रेणाराह, एने बेतएदेन ने गेराम रेणारा आदिकार केरनाराह खेतेम केरूह; एने सिरीया देसान माणहे आरापी बोणीन कीर गावा माय जाती, बोगवानान ज्योस वचन हे।”<verse eid="AMO 1:5" /></para>
  <para style="s2">पलिश्‍ती</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 1:6" />बोगवान इह केरीन किथे, “मी गाजा हेयरान एजार ताहार किरेल गुनान वोजेसे मी तान देन्ड नाय सोडु; काहाकाय ता आखा माणहाह बोंदी बाणावीन ली गीया काय ताह एदोम देसान ताबाम केर देय। <verse eid="AMO 1:6" /><verse number="7" style="v" sid="AMO 1:7" />मी गाजा हेयरान बितड़ा पोर आक्‍ठो पेटाडुह, तान वोजेसे तान किल्‍ला हेलगी जाती। <verse eid="AMO 1:7" /><verse number="8" style="v" sid="AMO 1:8" />मी अश्दोद हेयराम रेणारा माणहाह एने अश्कलोन हेयरान राज आदिकाराह खेतेम केर देह, मी मारो आथ एक्रोन राज्या पोर विसुह; एने वोचेल पलिश्‍ती माणहे बी खेतेम एय जाती,” बोगवानान ज्योस वचन हे।<verse eid="AMO 1:8" /></para>
  <para style="s2">सोर</para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9" />बोगवान इह केरीन किथे : “मी सोर हेयरान एजार ताहार गुनान वोजेसे मी तान देन्ड नाय सोडु; काहाकाय ता आखा माणहाह बोंदी बाणावीन एदोम राज ने आथाम होपेल एता; एने बायह्याख ने वाचाह विहरी जायेल एता। <verse eid="AMO 1:9" /><verse number="10" style="v" sid="AMO 1:10" />केरीन मी सोर हेयरान बितड़ा पोर आक्‍ठो पेटाडुह, तान वोजेसे तान किल्‍ला बी हेलगी जाती।”<verse eid="AMO 1:10" /></para>
  <para style="s2">एदोम</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11" />बोगवान इह केरीन किथे : “एदोम राज ने एजार ताहार गुनान वोजेसे मी तान देन्ड नाय सोडु; काहाकाय तो आथाम तालवार लेन तान बायाख ने पासाण पुड़ेल इतो, एने कायच किव नाह किऱ्यो, पुण राग केरीन ताह कायेम फाड़तेस रिनो, एने तान रागाह ओलाणे नाह दिनो। <verse eid="AMO 1:11" /><verse number="12" style="v" sid="AMO 1:12" />केरीन मी तेमान हेयरा पोर आक्‍ठो पेटाडुह, एने तान वोजेसे बोस्रा हेयरान किल्‍ला हेलगी जाती।”<verse eid="AMO 1:12" /></para>
  <para style="s2">अम्मोन</para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13" />बोगवान इह केरीन किथे : “मी अम्मोन देसान एजार ताहार गुनान वोजेसे मी तान देन्ड नाय सोडु; काहाकाय तो गीलाद ईलाकाम वोर तान राज ने एद्दी वोड़ावणेन केरता लेड़ाय माय पेटावाल्यु बायकुन पेट चिरेल इतो। <verse eid="AMO 1:13" /><verse number="14" style="v" sid="AMO 1:14" />केरीन मी तान राजदानी रब्बान बितड़ा पोर आक्‍ठो पेटाडुह, एने तान वोजेसे बोस्रा हेयरान किल्‍ला हेलगी जाती। ता लेड़ायीन दिह्या माय बोबखारनो एय, ता वादोण एने बुत्यान दिह रेती। <verse eid="AMO 1:14" /><verse number="15" style="v" sid="AMO 1:15" />तान राजा एने तान आदिकारी बी बोंदी माय जाती,” बोगवानान ज्योस वचन हे।<verse eid="AMO 1:15" /></para>
  <chapter eid="AMO 1" />
  <chapter number="2" style="c" sid="AMO 2" />
  <para style="s2">मोआब</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1" />बोगवान इह केरीन किथे, “मी मोआब देसान जाहार ताहार गुनान वोजेसे मी तान देन्ड नाय सोडु; काहाकाय तो एदोम राज ने राजान आड़ाह हेलगाड़ीन रोखड़ो केर दियेल इतो। <verse eid="AMO 2:1" /><verse number="2" style="v" sid="AMO 2:2" />केरीन मी मोआब देसा पोर आक्‍ठो पेटाडुह, तान वोजेसे करियोत हेयरान किल्‍ला हेलगी जाती; एने मोआब देस लेड़ायीन गेगदा माय एने बोबखार माय एने बिरान आवाजा माय खेतेम एय जाय। <verse eid="AMO 2:2" /><verse number="3" style="v" sid="AMO 2:3" />मी तान विचीम रेन नियाव केरणाराह खेतेम केरूह, एने ता हेऱ्योच आखा आदिकारीह बी मारूह।” बोगवानान ज्योस वचन हे।<verse eid="AMO 2:3" /></para>
  <para style="s2">यहुदा</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4" />बोगवान इह केरीन किथे, “मी यहुदा देसान जाहार ताहार गुनान वोजेसे मी तान देन्ड नाय सोडु; काहाकाय ता बोगवानान नेमाह ठुकराव देना, एने मारा नेमाह नाह मान्या; जीहे तान डायडाया जुठा देवतान पासाण चालताला, ता बी तिहेच केरीन केऱ्या, एने तान जुठा देवता ताह बोटकाड़ देना! <verse eid="AMO 2:4" /><verse number="5" style="v" sid="AMO 2:5" />केरीन मी यहुदा देसा पोर आक्‍ठो पेटाडुह, एने तान वोजेसे यरूशलेम ने किल्‍ला हेलगी जाती।”<verse eid="AMO 2:5" /></para>
  <para style="s1">इस्राएल ने नियाव</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6" />बोगवान इह केरीन किथे, “इस्राएल ने एजार ताहार गुनान वोजेसे मी तान देन्ड नाय सोडु; काहाकाय ता निर्दोस माणहाह पोयशान केरता, एने गेरीब माणहाह एक जोड़ खाहड़ान केरता वेच देतेह! <verse eid="AMO 2:6" /><verse number="7" style="v" sid="AMO 2:7" />ता कोमजोर एने गेरीब माणहाह बुयीन रेजड़ान गेत चेंद देतेह, एने गेरबोड़ा माणहाह तान वाटी पोर रेन सेटा केर देतेह; एने आबोख बिटोख दुयू एकुस बायकु हेऱ्या हुवतेह, ता मारा चोखाला नावाह एठो केर दियेल हेते। <verse eid="AMO 2:7" /><verse number="8" style="v" sid="AMO 2:8" />ता एकेक वेदी हेऱ्या गीरवी मिलेल फाड़का पोर आथरीन लोटतेह, एने तान देवतान मोंदिर माय दिंडेल पोयशान अंगुरान रोह पितेह।”<verse eid="AMO 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 2:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:9 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 3:8-11">व्यवस्था 3:8-11</ref>
      </char>
    </note> मी तान सामने एमोरीह खेतेम किरेल इतो, जान लांबाय देवदार उचाला जाड़ान गेत मोजबुत एती; जो वाहण्यान जाड़ान गेत मोजबुत एतो, तीबी मी उपेर रेन तान फोल, एने बुंदे रेन तान मुलाह खेतेम किऱ्यो। <verse eid="AMO 2:9" /><verse number="10" style="v" sid="AMO 2:10" />मी तुमूह मिस्र देसाम रेन निकाल लावो, एने हुनाला जागा माय चालीह वोरह्या वोर लेन फिरते रिनो, काय तुमू एमोरीन देसान आदिकारी बोण जाहो। <verse eid="AMO 2:10" /><verse number="11" style="v" sid="AMO 2:11" /><note caller="+" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="NUM 6:1-8">गिनती 6:1-8</ref></char></note> मी तारा थोड़ाक सोराह जाणाव केरनार बाणायो, तारा थोड़ाक जुवान सोराह नाजीर<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="fq" closed="false">नाजीर </char><char style="ft" closed="false">बोगवानान केरता निवाड़ेल</char></note> बोणनेन टेम आप्यो। एय इस्राएली, बोगवानान ज्यो बोल हे काय ज्य सोब खेरो नाह सोतो? <verse eid="AMO 2:11" /><verse number="12" style="v" sid="AMO 2:12" />पुण तु नाजीराह अंगुरान रोह पिवाड्यो, जाह अंगुरान रोह पिणु नाह एतो, एने जाणाव केरनाराह उकुम आप्यो काय जाणाव मा किरे। <verse eid="AMO 2:12" /><verse number="13" style="v" sid="AMO 2:13" />दिखो, मी तुमूह ओहलो दाबुह, जीहे पुला केरीन बोरायेल गाड़ो नेचो दाबाय जाथे। <verse eid="AMO 2:13" /><verse number="14" style="v" sid="AMO 2:14" />केरीन जोरेह दोवेड़णाराह बी वोचणेन केरता जागो नाय जुड़ी; एने ताकेतवालान ताकेत बी तान काम नाय आवी; एने लेड़ाणार बी तान जीवाह वोचाड़ नाय सेकी; <verse eid="AMO 2:14" /><verse number="15" style="v" sid="AMO 2:15" />विंदणार नाय उबरेय सेकी, एने उतवाल्योह दोवेड़नार नाय वोची; गोड़ा पोर बोहणारे बी तान जीव नाय वोचाड़ सेकी; <verse eid="AMO 2:15" /><verse number="16" style="v" sid="AMO 2:16" />ते दिह जो सुरविराम ताकेतवोर एय, तेगड़ा सिपाय बी तान जीव वोचाड़नेन केरता आथ्‍यार सोड़ीन नाह जाय। बोगवानान ज्योस बोल हे।<verse eid="AMO 2:16" /></para>
  <chapter eid="AMO 2" />
  <chapter number="3" style="c" sid="AMO 3" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1" />एय इस्राएली, ज्य वचन होमलो जो बोगवान तुमरे बाराम मतलब ता आखा गेराणान बाराम कियेल हे; जाह मी मिस्र देसा माय रेन लायेल हे। <verse eid="AMO 3:1" /><verse number="2" style="v" sid="AMO 3:2" />“देरतीन आखा गेराणाम रेन मी फोक्‍तो तार पोरच मोन लागाड़ेल हे, केरीन मी तुमरा आखा गुनान देन्ड आपुह।”<verse eid="AMO 3:2" /></para>
  <para style="s">जाणाव केरनारान काम</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 3:3" />केदी दुय एदमी पेलुच सहमत नाय एती; काय ता एकठास चाल सेकती?<verse eid="AMO 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 3:4" />काय सिंहवाग सिकार सापड्या सावाय जेंगला माय डांगारी? काय पाटड़ो सिंहवाग बुखले पेटे देराम रेन गुंगरेह?<verse eid="AMO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="AMO 3:5" />काय चिड़ा बिगेर फांदो लागाड़ेल फोसती? काय बिगेर काह फुसेल सिरजाल बुयी पोर उचेकणे?<verse eid="AMO 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 3:6" />काय एगदा गावाम बिरो वाजाड़े एने माणहे नाय थुर थुर कापती? काय बोगवान मोकल्या सावाय एगदा गावाम एगदी पिड़ा आव सिकेह?<verse eid="AMO 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 3:7" />इहीच केरीन मालीक बोगवान तान सेवक जाणाव केरनारा पोर, तान लिकायेल वातु देखाड्या सावाय काय काम नाह किरेत।<verse eid="AMO 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 3:8" />जेवी सिंहवाग डांगारी, कुण नाय बिय? मालीक बोगवान केयो, कुण हे, जो जाणाव नाय केरी?<verse eid="AMO 3:8" /></para>
  <para style="s1">सामरीयान नास</para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 3:9" />अश्दोद देसान किल्लाम एने मिस्र देसान किल्लाम ज्य पारचार किरो : “सामरीन बोयड़ा पोर एकठा टोलवाएन दिखो, एने सामरी राज ने मायता कोहली गेरबेड़ एने अत्याचार एणे बाजरेनाह!”<verse eid="AMO 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 3:10" />बोगवानान ज्यो बोल हे, “जा माणहे तान गेराम तेकलीत देन एने लुटेल मालदेन टुलो केरीन मेल रेतेह, ता हास केरीन काम केरने जाणतेस नाह। <verse eid="AMO 3:10" /><verse number="11" style="v" sid="AMO 3:11" />केरीन बोगवान किथे, दुसमोन ज्या देसाह कोंड लेय; एने तो तारी ताकेतीह तोड़ी, एने तारा किल्‍ला लुटाय जाती।”<verse eid="AMO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12" />बोगवान इह केरीन किथे, “जीह केरीन गोवाल सिंहवागान मुयाम रेन तान मेंड्रान दुय पाय, नाहते कानान एक टुकड़ो ओलोस वोचाड़ सिकेह, तीहीच केरीन मालीक सामरी राज्याम रेणारे फोक्ता थोड़ाक इस्राएली माणहे इह केरीन वोचाड़ाय जाती, जीह केरीन पोलांगान कोपरो एने आथरोणान एक टुकड़ो।” <verse eid="AMO 3:12" /><verse number="13" style="v" sid="AMO 3:13" />यहोवा बोगवान, मालीक बोगवान इह केरीन किथे, “होमलो, एने याकुब ने गेराणान विरूद गोवाय दिवो। <verse eid="AMO 3:13" /><verse number="14" style="v" sid="AMO 3:14" /><note caller="+" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="2KI 23:15">2 राजा 23:15</ref></char></note>जे दिह मी इस्राएलाह तान गुनान देन्ड आपुह, ते दिह मी बेतेल ने वेद्युह बी देन्ड आपुह; एने मी वेद्युन चुटाह तोड़ीन बुई पोर टाक देह। <verse eid="AMO 3:14" /><verse number="15" style="v" sid="AMO 3:15" />मी सामरी गावान हियालान गेराह एने उनालान गेराह, दुयूह ओदारूह; एने आथीन दाता केरीन होबाड़ेल गेराह बी ओदार देह, एने मोट मोटला गेरे बी नास एय जाती।” बोगवान ज्यु वातु कियेल हे।<verse eid="AMO 3:15" /></para>
  <chapter eid="AMO 3" />
  <chapter number="4" style="c" sid="AMO 4" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 4:1" />एय सामरी राज ने मालदार बायकु<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="fq" closed="false">मालदार बायकु </char><char style="ft" closed="false">मुखी बाग माय बाशान ने गायु हे</char></note>, एय सामरी बोयड़ान बायकु! ज्य वचन होमलो; तुमू गेरब्याह अत्याचार, एने गेरब्याह चेंदत्युह, तुमू तुमरा एदम्याह उकुम आपत्युह, न्या लाव, काहाकाय आपु पिहु! <verse eid="AMO 4:1" /><verse number="2" style="v" sid="AMO 4:2" />बोगवान तान चोखापोणान सुगोण खाएन किथे, “तुमरा ओहला दिह आवती, काय तुमूह काटा केरीन एने तुमरा सोराह, मासान गेली माय एटकाड़ीन ली जाती। <verse eid="AMO 4:2" /><verse number="3" style="v" sid="AMO 4:3" />तुमरे माय रेन एकेक फाटेल बितड़ा माय रेन हुतरा निकील जाहो, एने हर्मोन बोयड़ा पोर टाकाहो, इह केरीन बोगवान किथे।”<verse eid="AMO 4:3" /></para>
  <para style="s1">इस्राएल हुदेर ने माय असफल</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 4:4" />बेतेल माय जाएन गुनो किरो, एने गीलगाल माय आवीन जुलूम गुना किरो; तुमू दाड़ीन वेगाच तुमरी बेटीह, एने तुमरा दोहवा ईसाह देर तीसरे दिह लाया किरो। <verse eid="AMO 4:4" /><verse number="5" style="v" sid="AMO 4:5" />दन्यवाद ने बेट खमीर बेचकीन चेड़ावो, एने सोतान मोर्जीन बेट ने बाराम आखाह किवो; काहाकाय एय इस्राएल देस, तुवाह ज्योस ते पुटेह। इह केरीन बोगवान किथे।<verse eid="AMO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 4:6" />“मी तुमरा गावाम काल मोकल्यो; एने तुमरा आखा जागाम खाणान कोमी किऱ्यो, तीबी तुमू मार उगे वोलीन नाह आवा,” इह केरीन बोगवान किथे। <verse eid="AMO 4:6" /><verse number="7" style="v" sid="AMO 4:7" />जेवी मेर काटणेन तीन मोयना बाकी एता, तेवी मी तुमरी केरता पाणी नाह पाड्यो; मी एक गावा माय पाणी पाड्यो, पुण दिहरा गावाह हुकाड़ दिनो, एक खेताम पाणी पोड़नो, एने दिहरो खेत जा माय पाणी नाह पोड़नो, तो हुक गीयो। <verse eid="AMO 4:7" /><verse number="8" style="v" sid="AMO 4:8" />केरीन माणहे बोटेकतेन पाण्यान होदवाल्या एक जागे रेन दिहरे जागे फिरना, पुण ताह पिणेन केरता जुवे तोलोक पाणी नाह जुड़नो, तीबी तुमू मार उगे नाह वोलना, इह केरीन बोगवान किथे।<verse eid="AMO 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 4:9" />“मी तुमरा खेताह जाव एने किड़ा केरीन नुकसान किऱ्यो, एने जेवी तुमरा बोगीचा एने अंगुरान मोला, अंजीर एने जेतुनान जाड़े जुलूम एय गीया, तेवी टिड्या ताह खाय गीया; तीबी तुमू मार उगे वोलना नाह।” इह केरीन बोगवान किथे।<verse eid="AMO 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 4:10" />“मी जीह केरीन मिस्र देसाम मोटली पिड़ा मुकलेल इतो, तीहीच केरीन तुमरी पोर बी मुकल्यो; मी तुमरा गोड़ाह लुटाड़ीन तुमरा जुवान्याह तालवार केरीन माराव दिनो, मी तुमरा पाड़ावान देड़ान खाराब गेंदी केरीन तुमरा नाकाह बोर दिनो, तीबी तुमू मार उगे नाह वोलना।” इह केरीन बोगवान किथे।<verse eid="AMO 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 4:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:11 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 19:24">उत्पत्ती 19:24</ref>
      </char>
    </note>“जीह केरीन मी सदोम एने अमोरा गावाह नास किऱ्यो, तिहेच केरीन तुमरा थोड़ाक गावाह नास किऱ्यो। आक्ठाम रेन चालोच काड़ेल बोलन्या लाकड़ान गेत तुमरी स्थिती एती, तीबी तुमू मार उगे नाह वोलना।” इह केरीन बोगवान किथे। <verse eid="AMO 4:11" /><verse number="12" style="v" sid="AMO 4:12" />“केरीन एय इस्राएल, मी तार हिऱ्यो इहीच केरीन केरूह, काहाकाय मी तार हिऱ्यो ज्य काम केरन्यो हे, केरीन एय इस्राएल तारा बोगवानान सामने आवणेन केरता तियार एय जा!”<verse eid="AMO 4:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="AMO 4:13" />दिखो, बोयड़ाह बाणावणार</para>
  <para style="q2" vid="AMO 4:13">एने वाराह बाणावणार,</para>
  <para style="q1" vid="AMO 4:13">एने माणहान तान मोनान विचार केणार,</para>
  <para style="q2" vid="AMO 4:13">जो उजालो एने आंदाराह बाणावीह,</para>
  <para style="q2" vid="AMO 4:13">एने जो देरतीन उचाले जागे चालेह,</para>
  <para style="q1" vid="AMO 4:13">तास ने नाव ताकेतवोर बोगवान हे।<verse eid="AMO 4:13" /></para>
  <chapter eid="AMO 4" />
  <chapter number="5" style="c" sid="AMO 5" />
  <para style="s1">पासतावान पुकार</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1" />एय इस्राएल ने गेराणा, ज्या विखान गीतान बोल होमलो; जो मी तुमरे बाराम केथु।<verse eid="AMO 5:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="AMO 5:2" />“इस्राएल देस एक कुवारली सोरी हे, जी पोड़ गियी,</para>
  <para style="q1" vid="AMO 5:2">ती पोशी केदी नाय उठी;</para>
  <para style="q1" vid="AMO 5:2">ती तीस ने बुई पोर आसटाय जायेल हे,</para>
  <para style="q1" vid="AMO 5:2">तीह उठाड़नार कुण नाह सोतो।”<verse eid="AMO 5:2" /></para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" sid="AMO 5:3" />काहाकाय बोगवान इस्राएलीह इह केरीन किथे, “जा हेयराम रेन एजार निकल्या, केदी जा गावाम रेन एजार निकेलतेह, ता माय रेन एकुस होव वोचती, केदी एक होव लिन निकली, ता माय रेन दोहुस वोचती।”<verse eid="AMO 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4" />बोगवान इस्राएल ने गेराणाह इह केरीन किथे, “माहु हुदो, तेवी तुमू जीवताला रिहो। <verse eid="AMO 5:4" /><verse number="5" style="v" sid="AMO 5:5" />पुण तुमू बेतेल ने वेदीह मा हुदो, एने गीलगाल माय मा जावो; एने एद्यी उणखीन बेर्शेबा माय मा जावो; काहाकाय गीलगालान माणहाह गुलामी बाणावीन ली जाती, एने बेतेल उजाड़ बोणी।”<verse eid="AMO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 5:6" />बोगवानाह हुदो, तेवी तुमू जीवताला रिहो; नाह ते तो युसूफ ने गेराणा पोर आक्‍ठान गेत बोड़की, एने आक्‍ठो तुमूह हेलगाड़ देय, एने बेतेल माय ताह ओलाड़णार कुण नाय रेय। <verse eid="AMO 5:6" /><verse number="7" style="v" sid="AMO 5:7" />एय नियावाह कड़वाहट माय बोदेलनारे, एने खेरायीह माटड्याम मिलावणारे माणहे!<verse eid="AMO 5:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="AMO 5:8" />जो कचपचिया एने मुगशिराह बाणावणार हे,</para>
  <para style="q2" vid="AMO 5:8">जो मोतीन सावलाह उठ्यान ने उजालाम बोदलेह;</para>
  <para style="q1" vid="AMO 5:8">जो दिह्याह आंदारो केरीन रात बाणाव दिथे,</para>
  <para style="q1" vid="AMO 5:8">जो देरीयान पाण्याह वाफाम बोदलेह</para>
  <para style="q2" vid="AMO 5:8">एने देरती पोर पाणी पाड़ेह,</para>
  <para style="q1" vid="AMO 5:8">तान नाव बोगवान हे।<verse eid="AMO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 5:9" />तो चालोच ताकेतवालाह नास केर दिथे, एने तान किल्लाह बी नास केर दिथे।<verse eid="AMO 5:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="AMO 5:10" />जो माणुह नियाव कोरटाम खेराय से नियाव किरेह, ता से तुमू दुसमोनाय मेलतेह; एने जो खेरी बुलेह, ताह नफरत केरतेह। <verse eid="AMO 5:10" /><verse number="11" style="v" sid="AMO 5:11" />तुमू गेरब्याह चेंदतेह, एने बेट हे केरीन तान एना पोर फालो लागाड़तेह; केरीन जो गेर तुमू गिड़ेल देगड़ान बाणायेल हेते, पुण तुमू ता गेराम रेय नाय सिकहो; एने तुमू अंगुर ने वाड़ी लागाड़ेल हेते, पुण तुमू तान अंगुरान रोह पिय नाय सिकहो। <verse eid="AMO 5:11" /><verse number="12" style="v" sid="AMO 5:12" />मी जाणथो काय तुमू कोलाक गुना किरेल हेते, एने तुमू खेरीच जुलूम खाराब काम किरेल हेते; तुमू हाजा काम केरनारे माणहाह दुख देतेह एने ता फाय गुस लेतेह, एने कोरटाम गेरब्यान नियाव बिगाड़तेह। <verse eid="AMO 5:12" /><verse number="13" style="v" sid="AMO 5:13" />केरीन एकलीदार माणुह ओहला टेमा माय ठावको रेय, काहाकाय टेम खाराब हे!<verse eid="AMO 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 5:14" />एय माणहे, बुरायीह नाह, पुण बोलायीह हुदो! तेवी तुमू जीवताला रिहो; सेनान यहोवा बोगवान खेरीच तुमरी हिऱ्योच रेय, जीह केरीन तुमू केतेह। <verse eid="AMO 5:14" /><verse number="15" style="v" sid="AMO 5:15" />बुरायी हेऱ्या दुसमोनाय मिलो, पुण बोलायीह मोंग किरो, कोरटाम नियावाह स्थिर किरो; तेवी एय सेकी सेनान यहोवा बोगवान तुमू युसूफान वोचेल वोची पोर किव केरी।<verse eid="AMO 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 5:16" />सेनान यहोवा बोगवान इह केरीन किथे, “आख्‍यु चोवफुली पोर रेड़नो रेय; एने आख्‍यु गेल्ली माय हाय हाय केरती! ता बाड़ा पोर किरसाणाह दुख माणावणेन केरता एने जा माणहे दुख मोणावणे माय चेतुर हेते, ताह रेड़नेन हादती।”<verse eid="AMO 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="AMO 5:17" />अंगुर ने वाड़ी माय माणहे रेड़ती रेती, काहाकाय मी तुमरी विचीम लागतो जाह। इह केरीन बोगवान किथे।<verse eid="AMO 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="AMO 5:18" />तुमरी पोर हाय हे, जा बोगवानान दिह्यान इच्छा मेलतेह, तुमूह बोगवानान दिह काहा जुवे? मालीकान दिह उजालान नाह, आंदारान दिह हे।<verse eid="AMO 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="AMO 5:19" />जीहे इखेह सिंहवागान सामने रेन इखेह नाही एने ताह रिसड़ो मिलाय, नाहते जेवी तो गेराम रिगी, एने बितड़ा पोर तान आथ टेकाड़ी ते गेयड़ेक ताह चाव देय। <verse eid="AMO 5:19" /><verse number="20" style="v" sid="AMO 5:20" />काय ज्य खेरी नाह सोतो, काय बोगवानान दिह उजालान नाह, पुण आंदारलाच ने रेय? होव, ओहलो जुलूम आंदारान जा माय जाराक बी उजालो नाय रेय।<verse eid="AMO 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="AMO 5:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:21 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 1:11-14">यशाया 1:11-14</ref>
      </char>
    </note>“मी तुमरा तिवाराह दुसमोनाय मेलथु, माहु तो पोटेत नाह; एने तुमरा मोटला पोंचा केरीन मी खुस नाह। <verse eid="AMO 5:21" /><verse number="22" style="v" sid="AMO 5:22" />तुमू मार केरता होमबोली एने दानबोली चेड़ावतेह, पुण मी तीह स्वीकार नाय केरू; एने तुमरा पालेल माताला जेनवारान मेल मिलाप बोलीन उगे देखु बी नाय। <verse eid="AMO 5:22" /><verse number="23" style="v" sid="AMO 5:23" />माहु तुमरो गीत मा होमलाड़ो, ताह मार हेऱ्या रेन सेटा मिलो; मी तुमरा रेणथान आवाज नाय होमलु। <verse eid="AMO 5:23" /><verse number="24" style="v" sid="AMO 5:24" />पुण नियावाह नेदीन गेत, एने खेरायीह कायेम वोयण्या खोदरान गेत वोयणे दिवो।<verse eid="AMO 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="AMO 5:25" />“एय इस्राएल ने गेराणा, काय तुमरा डायडाया चालीह वोरह्या वोर सुनसान जागा माय जेनवारान बोली एने दानबोली चेड़ायेल एता? <verse eid="AMO 5:25" /><verse number="26" style="v" sid="AMO 5:26" />तुमू ते तुमरा राजान तोम्बु, एने तुमऱ्यु मुरत्युन पाटलो; एने तुमरा देवतान तारो लेन फिरते रेना। <verse eid="AMO 5:26" /><verse number="27" style="v" sid="AMO 5:27" />केरीन मी तुमूह दमिश्क ने ती पार बोंदी माय केर देह, सेनान यहोवा बोगवानान ज्योस वचन हे।<verse eid="AMO 5:27" /></para>
  <chapter eid="AMO 5" />
  <chapter number="6" style="c" sid="AMO 6" />
  <para style="s">इस्राएल ने नास</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 6:1" />“हाय ता पोर जा सियोन माय हुकेह रेतेह, एने ता पोर जा सामरीयान बोयड़ा पोर बी फिकऱ्या रेतेह; ता जा देसा माय नावगाज्या हेते, जा फाय इस्राएल ने गेराणो आवेह! <verse eid="AMO 6:1" /><verse number="2" style="v" sid="AMO 6:2" />कलने हेयराम जाएन दिखो, एने ता रेन हमात नावान मोटला हेयराम जावो; ओवता पलिश्तीन गत गावाम जावो, काय ज्या दुय राज्या, तुमरा राज्याह रेन हाजा हेते काय? काय तान एद्दी तुमरी एद्दीह रेन मोठी हे काय?”<verse eid="AMO 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 6:3" />तुमू खाराब दिह्याह सेटा केर देतेह, एने राड़ीन गादीह आहने लावतेह।<verse eid="AMO 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 6:4" />तुमू आथीन दातान पोलांगा पोर लोटतेह, एने तुमरा आथरोणा पोर पाय पोसारीन हुवतेह; तुमू पुटे ओहला मेंड्रा एने माताला वासड़ाह खातेह।<verse eid="AMO 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="AMO 6:5" />तुमू रेणथा हेऱ्या गीत गावतेह, एने दाऊदान गेत बात बातीन वाजो वाजाड़तेह। <verse eid="AMO 6:5" /><verse number="6" style="v" sid="AMO 6:6" />तुमू गीलासा पोर गीलास अंगुरान रोह पितेह, हाज हाजो तेल लागाड़तेह; पुण युसूफा पोर आवण्यी पिड़ान हाल होमलीन दुखी नाह एते। <verse eid="AMO 6:6" /><verse number="7" style="v" sid="AMO 6:7" />केरीन ता आखान पेल तान देसा माय रेन निकालाय जाती, एने जा पाय पोसारीन खाराब काम केरताला; तान खाराब काम केरनो बोंद एय जाय।<verse eid="AMO 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8" />सेनान यहोवा बोगवान इह केरीन किथे, बोगवान सोताच ने सुगोण खाएन कियेल हे, “जा पोर याकुब मोठाय किरेह, ताह मी नफरत केरथु; एने तान किल्लाह दुसमोनाय मेलथु, मी सामरी गाव एने तान आखो काय दुसमोनान आथाम होप देह।”<verse eid="AMO 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9" />केदी एगदा कुटूमा माय दोह एदमी वोच रेती, तीबी ता मोर जाती। <verse eid="AMO 6:9" /><verse number="10" style="v" sid="AMO 6:10" />मोरनार एदम्यान काकोख जो ताह हेलगाड़न्यो हे, तान देड़ाह गेराम रेन बाहेर निकालनेन केरता उखली; एने बुजणेन केरता गेरान बाहेर ली जाती। ता गेरान सिवण्याम लिकायेल माणहाह फुसती, “काय तार हेऱ्यो इखेह उंजु हे?” तेवी तो केय, “कुण नाह,”</para>
  <para style="p" vid="AMO 6:10">तेवी तो केय, “ठावको रे! आपुह बोगवानान नाव नाय लेणे जुवे।”<verse eid="AMO 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 6:11" />काहाकाय बोगवानान उकुमा केरीन मोटला गेरान टुकड़ा, एने आतल्या गेरान चिह पोड़ जाय। <verse eid="AMO 6:11" /><verse number="12" style="v" sid="AMO 6:12" />काय गोड़ा देगड़ा पोर दोवेड़नु? काय बोयला केरीन देरीया पोर एल जुपतेह? पुण तुमू नियावाह जेहेर, एने नियावान फोलाह कोड़वो बाणाव दियेल हेते।<verse eid="AMO 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 6:13" />तुमू ओहली वोस्तुन वोजेसे खुस हेते, एने रागाम बोरायीन ज्य केणे बाजरेनाह; “आमु आमरी ताकेत केरीन कारनाईम गाव जिकेल हेते।”<verse eid="AMO 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 6:14" />केरीन सेनान यहोवा बोगवान इह केरीन किथे, “एय इस्राएल ने गेराणा, देख, मी तार विरूद एक देसाह उबो केरूह, जो हमात गाटाम रेन अराबान नेदी वोर तुमूह विताड़ी।”<verse eid="AMO 6:14" /></para>
  <chapter eid="AMO 6" />
  <chapter number="7" style="c" sid="AMO 7" />
  <para style="s">नास ने तीन देरसेन</para>
  <para style="s">टिड्या</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1" />बोगवान माहु ज्य देखाड्यो, एने मी काय देखथु काय तो पासाणल्यो खेड़ उगणेन पेल टिड्या पायदा किऱ्यो; एने तो राजान कामाय काटणेन बाद पासाणल्यो खेड़ एतो। <verse eid="AMO 7:1" /><verse number="2" style="v" sid="AMO 7:2" />जेवी ता बुयीन आखो खेड़ खाय गीया, तेवी मी केयो, “एय बोगवान, माफ केर! ज्यान बाद याकुब किहीक उब रेय सेकी? तो आतल्यो एने कोमजोर हे।”<verse eid="AMO 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 7:3" />तेवी बोगवान ज्यान बाराम तान विचाराह बोदेल दिनो, एने तो केयो, “एवी ओहलो नाय एय।”<verse eid="AMO 7:3" /></para>
  <para style="s1">आक्‍ठान देरसेन</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4" />बोगवान माहु ज्य देखाड्यो, मी दिख्यो काय मालीक नियाव केरनेन केरता आक्ठाह हादणे बाजरिनोह; एने ता आक्‍ठा केरीन मोटलो देरीयो हुक गीयो, एने बुयीह बी खेतेम केरने बाज गीयो। <verse eid="AMO 7:4" /><verse number="5" style="v" sid="AMO 7:5" />तेवी मी केयो, “एय बोगवान, देन्ड आपणेन बोंद केर! ज्यान बाद याकुब किहीक उब रेय सेकी? तो जुलूम आतल्यो एने कोमजोर हे।”<verse eid="AMO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 7:6" />तेवी बोगवान ज्यान बाराम तान विचाराह बोदेल दिनो, एने तो केयो, “ओहली वात पोशी नाय एय।”<verse eid="AMO 7:6" /></para>
  <para style="s">वोड़ांबान देरसेन</para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7" />मालीक माहु ज्य बी देखाड्यो, मी दिख्यो काय बोगवान एक उचाच बितड़ा पोर तान आथाम वोडांबो लेन उबरिनोह। <verse eid="AMO 7:7" /><verse number="8" style="v" sid="AMO 7:8" />बोगवान माहु केयो, “एय आमोस, तुवाह काय देखाह?” मी केयो, “एक वोडांबो।” तेवी बोगवान केयो, “देख, मी मारा सोतान माणहे इस्राएल ने विचीम वोडांबो लागाडुह। एवी मी ताह देन्ड देया सावाय नाय सोडु। <verse eid="AMO 7:8" /><verse number="9" style="v" sid="AMO 7:9" />इसहाक ने उचालो जागो उजाड़ एय जाय, एने इस्राएल ने चोखाला जागा सुनसान एय जाती; एने मी आथाम तालवार लेन यारोबाम ने गेराणान विरूद उब रेह।”<verse eid="AMO 7:9" /></para>
  <para style="s">आमोस एने अमस्या</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10" />बेतेल ने चाकऱ्यो अमस्या, इस्राएल ने राजा यारोबाम फाय ज्यी खुबेर ली मुकल्यो, “आमोस तार विरूद इस्राएल ने गेराणान विचीम किदेर काड़ने बाजरिनोह, एवी देस तान सोबदाह उंजु वोदार वेठ नाह सिकेत। <verse eid="AMO 7:10" /><verse number="11" style="v" sid="AMO 7:11" />काहाकाय आमोस इह केरीन किथे, ‘यारोबाम तालवार केरीन माराय जाय, एने इस्राएली माणहे तान देसाम रेन खेरीच निकालाय जाती।’ ”<verse eid="AMO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12" />तेवी अमस्या आमोसाह केयो, “एय देरसेन देखणार, तारो जीव वोचाड़ीन यहुदा देसाम नाह जा, एने तास रूटो खाज्ये एने तास जाणाव किरज्ये। <verse eid="AMO 7:12" /><verse number="13" style="v" sid="AMO 7:13" />पुण बेतेल माय पुशो केदी जाणाव मा किरहे, काहाकाय ज्यो राजान चोखालो जागो एने राज हियोर हे।”<verse eid="AMO 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14" />आमोस अमस्या ज्य जापाप आप्यो, “मी नाहते जाणाव केरनार इतो, एने नाह जाणाव केरनारान बिटोख; मी फोक्‍तो गोवाल इतो, एने उमरान जाड़ान राखवाल इतो। <verse eid="AMO 7:14" /><verse number="15" style="v" sid="AMO 7:15" />पुण बोगवान माहु मेंड्रा बोकड्यान पासाण पासाण चालतालोन हादिन केयो, ‘जा, मारा माणहे इस्राएलीन केरता जाणाव केर।’ ” <verse eid="AMO 7:15" /><verse number="16" style="v" sid="AMO 7:16" />केरीन एवी तु बोगवानान वचन होमेल, तु किथे, “इस्राएल ने विरूद जाणाव मा किरे; एने इसहाक ने गेराणान विरूद जाहार ताहार वचन मा होमलाड़े।” <verse eid="AMO 7:16" /><verse number="17" style="v" sid="AMO 7:17" />केरीन बोगवान इह केरीन किथे, “तारी बायकु ज्या गावाम वेश्या बोण जाय, एने तारा सोरा सोऱ्यु तालवार केरीन माराय जाती, एने तारा जागाह दोयड़ी केरीन मापीन आपसाम वाटाय जाय; एने तु सोता एठा देसाम मोरहे, एने इस्राएल माणहे तान देसाम रेन खेरीच निकालाय जाती।”<verse eid="AMO 7:17" /></para>
  <chapter eid="AMO 7" />
  <chapter number="8" style="c" sid="AMO 8" />
  <para style="s">फोला केरीन बोरायेल टोपलीन देरसेन</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1" />तेवी बोगवान माहु ज्य देरसेन देखाड्यो, काय उनालान फोला केरीन बोरायेल एक टोपली हे। <verse eid="AMO 8:1" /><verse number="2" style="v" sid="AMO 8:2" />बोगवान माहु केयो, “एय आमोस, तुवाह काय देखाह?”</para>
  <para style="p" vid="AMO 8:2">मी केयो, “उनालान फोला केरीन बोरायेल एक टोपली।”</para>
  <para style="p" vid="AMO 8:2">तेवी बोगवान माहु केयो, “मारा माणहे इस्राएल ने सेवोट आव जायेल हे; एवी मी देन्ड आप्या सावाय नाय सोडु। <verse eid="AMO 8:2" /><verse number="3" style="v" sid="AMO 8:3" />बोगवान इह केरीन किथे, ते दिह मोंदिर वाला बोड़ायीन गीते दुखान गीताम बोदलाय जाती। एने देड़ान मोटलो डिग लागी; एने आखी जागे ता ठावकास टाकाय जाती।”<verse eid="AMO 8:3" /></para>
  <para style="s">इस्राएल ने नास</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 8:4" />एय बिगेर साहारा वालाह चेंदणारे, एने देसान माणहाह गेरब्याह खेतेम केरनेन होदतेह, ज्य होमलो। <verse eid="AMO 8:4" /><verse number="5" style="v" sid="AMO 8:5" />तुमू केतेह, “नोवाला चांदान तिवार केवीह निवरी? काय आपु दाणा वेच सेकहु? एने विहेवणेन दिह केवीह विती, जासे आपु आपणा गोव वेचणेन केरता लाव सेकहु, आपु ताकड़ाह ओहलो बाणाव देहु काय माणहाह ठेग सिके। <verse eid="AMO 8:5" /><verse number="6" style="v" sid="AMO 8:6" />तुमू गेरब्याह पोयशा केरीन एने गेरब्याह एक जोड़ी खाहड़ान किमोत पोर वेचाता लेतेह, एने खाराब गोव बी वेचतेह।”<verse eid="AMO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7" />यहोवा बोगवान, याकुबान मोठाय, तो तान सुगोण खाएन किथे, “मी तुमरा काल्ला कामाह केदी नाय विहरू। <verse eid="AMO 8:7" /><verse number="8" style="v" sid="AMO 8:8" />काय ज्यान वोजेसे बुई नाय कापी? काय ता मायवाला आखा रेणारे दुख नाय मोणावे? ज्यो देस आखो मिस्रन निल नेदीन गेत एय, जी वुड़ेह, एने कोम एय जाथे।” <verse eid="AMO 8:8" /><verse number="9" style="v" sid="AMO 8:9" />बोगवान इह केरीन किथे, “ते दिह ओहलो एय काय मी दिह्याह हिराण पोरच बुड़ाव देह, एने ज्या देसाह दिह्याच आंदारो केर देह। <verse eid="AMO 8:9" /><verse number="10" style="v" sid="AMO 8:10" />मी तुमरा तिवाराह दुखाम एने तुमरा आखा गीताह दुखान गीता माय बोदेल देह, मी आखाह दुखान फाड़का पेरावुह; एने तुमरा आखान मुंडान टाली केरावुह, एने ओहलो दुख केरावुह जीहे एखालाच ने केरता ईथे; एने तान सेवोट केठीण दुखान दिह्यान गेत एय।”<verse eid="AMO 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 8:11" />बोगवान इह केरीन किथे, “दिखो, ओहला दिह आवणे बाजरेनाह, जेवी मी ज्या देसाम काल मोकलुह; माणहे बुखल्या रेती पुण रोटान केरता नाह, माणहे तिहल्या रेती पुण पाण्यान केरता नाह, पुण बोगवानान वचनान होमेलनेन बुख तीह रेय। <verse eid="AMO 8:11" /><verse number="12" style="v" sid="AMO 8:12" />माणहे बोगवानान वचनान होदवाल्या एक देरीये रेन दिहरे देरीये वोर, एने उत्तर रेन देक्षिण वोर मोऱ्या मोऱ्या बोटेकती; पुण ताह नाय सापड़ावती। <verse eid="AMO 8:12" /><verse number="13" style="v" sid="AMO 8:13" />ते दिह होबात्यु सोऱ्यु एने जुवान एदमी तीहीन वोजेसे बेसुद एय जाती। <verse eid="AMO 8:13" /><verse number="14" style="v" sid="AMO 8:14" />पुण ता जा सामरीयान मुरतीन सुगोण खातेह, एने जा केतेह, ‘जा माणहे सामरीया, दान एने बेर्शेबान सुगोण खातेह, ता आखा ओदरी जाती, ता पोशा नाय उठती।’ ”<verse eid="AMO 8:14" /></para>
  <chapter eid="AMO 8" />
  <chapter number="9" style="c" sid="AMO 9" />
  <para style="s">बोगवानान नियाव</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1" />मी मालीकाह वेदीन आहने उबरियेल दिख्यो, एने तो केयो, “खांबान चुटा पोर दे, जा केरीन ओटला आलती, एने ताह आखा माणहान मुंडा पोर पाड़ीन टुकड़ा टुकड़ा केर; एने जा नास एणे से वोचती, ताह मी तालवार केरीन मारूह; ताम रेन एक बी नाहीन नाय जाय, एने जो सोताह वोचाड़ी, तो वोची नाय। <verse eid="AMO 9:1" /><verse number="2" style="v" sid="AMO 9:2" />केदी ता खोदीन आंदारकेली माय लिकाती, ते मी मारो आथ लांबो केरीन ताह ता रेन खेच काडुह; केदी ता जुगाम चेड़ती, ताहार मी ताह देरीन देरती पोर उतार देह। <verse eid="AMO 9:2" /><verse number="3" style="v" sid="AMO 9:3" />केदी ता कर्मेल बोयड़ान चुटा पोर लिकती, पुण ता बी मी ताह होदिन देर लेह; केदी ता मारा डोलान आड़ावे लिकीन देरीयान बुंद्याम जात रेती, ताहार मी गेड़हाह उकुम आपुह, एने तो ताह चाव देय। <verse eid="AMO 9:3" /><verse number="4" style="v" sid="AMO 9:4" />केदी दुसमोन ताह जेली माय ली जाती, ताहरी बी मी उकुम आपीन तालवार केरीन ताह मारावुह; एने मी ता पोर बोलाय केरनेन नाह, पुण नुकसान केरनेन केरता नेजेर टाकुह।”<verse eid="AMO 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 9:5" />बोगवानान आथेल ने से देरती पिगलेह,</para>
  <para style="q2" vid="AMO 9:5">एने ती पोर रेणारे आखा दुख मोणावतेह;</para>
  <para style="q2" vid="AMO 9:5">एने ती आखीन आखी मिस्रन नेदीन गेत एय जाथे,</para>
  <para style="q1" vid="AMO 9:5">जी वोड़ेह एने कोम एय जाथे।<verse eid="AMO 9:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="AMO 9:6" />जो जुगाम तान गेर बाणावेह, एने तान जुगामवालो पायो देरती पोर टाकेह, एने देरीयान पाण्याह उकुम आपीन देरती पोर वोयाड़ दिथे, तास ने नाव यहोवा हे।<verse eid="AMO 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 9:7" />इह केरीन बोगवान किथे, एय इस्राएली, “तुमू मार केरता कुशी माणहान गेत हेते, काय मी इस्राएलाह मिस्र देसाम रेन एने पलिश्तीह कप्तोर ईलाकाम रेन एने अरामीह कीर देसाम रेन नाह निकाल्यो?” <verse eid="AMO 9:7" /><verse number="8" style="v" sid="AMO 9:8" />यहोवा इह केरीन किथे, “दिखो, बोगवानान नेजेर ज्या पापावाला राज्या पोर लाग रेनीह, एने मी ज्याह देरती पोर रेन नास केरूह; पुण मी पुरो याकुबान गेराणाह नास नाय केरू,”<verse eid="AMO 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 9:9" />“मारा उकुमा केरीन इस्राएल ने गेराणो आखा देसाम चालाय जाय, जीहे दाणा चालनी माय चालाय जातेह, पुण ताम रेन एक बी दाणो बुई पोर नाय पोड़ी। <verse eid="AMO 9:9" /><verse number="10" style="v" sid="AMO 9:10" />मारा माणहाम रेन पापी जा इह केरीन केतेह, ‘पिड़ा आमरी पोर नाय आवी, एने नाय आमुह कोंडी,’ ता आखा तालवारी केरीन माराय जाती।”<verse eid="AMO 9:10" /></para>
  <para style="s1">इस्राएलाह पोशो बाणावणो</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 9:11" />“ते दिह मी दाऊदान उदरेल खोपड़ीह उबो केरूह, एने तान बितड़ान डोसाह बुजूह, एने जो खाराब एय रेनोह, तो मी पोशो बाणावुह, एने जोहलो तो जुनाला कालाम एतो, ताह तोहलोच बाणाव देह; <verse eid="AMO 9:11" /><verse number="12" style="v" sid="AMO 9:12" />तेवी जा वोचेल एदोम वोसी पोर, एने आखा देसा पोर जा मारा केवातेह आदिकार केरती; बोगवान जो ज्य किरेह,” तो इह केरीन किथे।<verse eid="AMO 9:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 9:13" />मालीक ज्य किथे,</para>
  <para style="q2" vid="AMO 9:13">“दिखो, ओहला दिह आवतेह,</para>
  <para style="q2" vid="AMO 9:13">काय कामाय काटणार काटाय निवराव बी नाय सेकी काय एल जुपणार ओंगाण निकील जाय;</para>
  <para style="q2" vid="AMO 9:13">बिज पेरनारान पेरनो पुरो बी नाय एय काय,</para>
  <para style="q2" vid="AMO 9:13">अंगुर तोड़नार ओंगाण निकील जाय,</para>
  <para style="q1" vid="AMO 9:13">बोयड़ाम रेन मिठाला अंगुरान रोह गेली;</para>
  <para style="q2" vid="AMO 9:13">एने आखा बोयड़ा ताम डुब जाती।<verse eid="AMO 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 9:14" />मी मारा माणहाह, इस्राएलीह जेली माय रेन सोड़वीन पोशो लावुह,</para>
  <para style="q2" vid="AMO 9:14">ता उजड़ेल गावाह हुदारीन ताम वोहती;</para>
  <para style="q2" vid="AMO 9:14">ता अंगुरान मोला लागाड़ीन अंगुरान रोह पिती,</para>
  <para style="q2" vid="AMO 9:14">एने बोगीचा लागाड़ीन तान फोल खाती।<verse eid="AMO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 9:15" />मी ताह तास ने बुयीम पोशो पेरूह, जो देस मी ताह आपेल हे;</para>
  <para style="q2" vid="AMO 9:15">ताह ता रेन पोशो केदी नाय उखालु।”</para>
  <para style="q1" vid="AMO 9:15">तुमरो मालीक बोगवान ज्य कियेल हे।<verse eid="AMO 9:15" /></para>
  <chapter eid="AMO 9" />
</usx>