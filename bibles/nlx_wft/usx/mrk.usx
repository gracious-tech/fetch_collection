<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- Nahali</book>
  <para style="h">मरकुस</para>
  <para style="toc3">मरकुस</para>
  <para style="toc2">मरकुस</para>
  <para style="toc1">मरकुस लिखेल यीशु मसीन हाजाली खुबेर</para>
  <para style="mt2">मरकुस रचीत यीशु मसीह का सुसमाचार</para>
  <para style="mt1">मरकुस लिखेल यीशु मसीन हाजाली खुबेर</para>
  <para style="imt">ओलखात</para>
  <para style="ip">यीशुन जीवणान बाराम देखाड़नारान नोवाला नेम माय चार पुस्तेका माय रेन एक पुस्तेक हे मरकुस ने लिखेल हाजाली खुबेर हे, न्या चार पुस्तेकाह हाजाली खुबेर कियेल हे, ज्यी चार हाजाली खुबेर यीशुन जीवणान बाराम केत्युह।</para>
  <para style="ip">यीशुन मोरनेन पासाण ज्यी चार हाजाली खुबेर एकान पासाण एक मत्ती, मरकुस, लुका, योहान ज्या लिखेल हेते, एने न्या चार माय रेन मरकुस ने हाजाली खुबेर आखाह रेन आतली पुस्तेक हे, मरकुस ने हाजाली खुबेर आखा रेन पेल लेखायेल हे, एने यीशुन जेल्मान कोमीत कोमी 65 रेन ते 70 सालान पासाण रोम हेयरा माय रेन लेखायेल हे काय मसी मोंडलीन बुरहो वोड़ावणेन केरता, एने ईमोत आवणे जुवे तानकेरता ज्यी हाजाली खुबेर लेखायेल हे।</para>
  <para style="ip">एने इही केतेह काय ज्यो मरकुस कुण हे? प्रेरित पौलुसान एने बरनबास ने जो जुवान हाती योहान मरकुस हे, जो तान पेल्‍ली मिश्नरी यात्रा माय जाणेन टेम मा आरदे वाटी रेन सोड़ीन नाह जायेल ईतो, मरकुस ओहलो किरेल तान केरता तान जीवाह दुको पोचनो <char style="xt"><ref loc="ACT 13:13">प्रेरितान काम 13:13</ref></char> पासाण जोच मरकुस बरनबासा हिऱ्यो मील जायेल ईतो, <char style="xt"><ref loc="ACT 15:37-39">प्रेरितान काम 15:37-39</ref></char>, <char style="xt"><ref loc="1PE 5:13">1 पतरस 5:13</ref></char> ने गेत मरकुस पतरसान आरहीन हाती ईतो, जाणकारान मान्नो हे काय मरकुस यीशुन जीवणो एने सेवान काम डोला केरीन दिखेल नाह ईतो, तीबी पतरसान पुरावान आदारा पोर तो ज्यी हाजाली खुबेर लिखेल हे, ज्यो मरकुसान हाजाली खोबरीन आदार हे।</para>
  <para style="ip">मरकुस हाजाली खुबेर ने पुस्तेक माय मुख्य दुय वातुन बाराम हे, यीशुन चेला किहीक बोणनु, एने आखरी टेम ने बाराम यीशुन हिकवोण।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. बपतीस्मा केरनार योहान एने यीशुन बपतीस्मा। <char style="ior"><ref loc="MRK 1:1-13">1:1-13</ref></char></para>
  <para style="io1">2. यीशुन द्‍वारे गेलील ईलाकाम यीशु किरेल चोमेत्कार। <char style="ior"><ref loc="MRK 1:14-9:50">1:14–9:50</ref></char></para>
  <para style="io1">3. गेलील माय रेन यरूशलेम वोर यीशुन यात्रा एने मोंदिर माय जाणो। <char style="ior"><ref loc="MRK 10:1-12:44">10:1–12:44</ref></char></para>
  <para style="io1">4. यीशुन द्‍वारे बविष्‍यान बाराम आपेल हिकवोण। <char style="ior"><ref loc="MRK 13:1-37">13:1-37</ref></char></para>
  <para style="io1">5. यीशुन मोरने एने जीव उठणो एने मोटलो उकुम। <char style="ior"><ref loc="MRK 14:1-16:1">14:1–16:1-20</ref></char></para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s">योहान बपतीस्मा केरनारान पारचार</para>
  <para style="r">(<ref loc="MAT 3:1-12">मत्ती 3:1-12</ref>; <ref loc="LUK 3:1-18">लुका 3:1-18</ref>; <ref loc="JHN 1:19-28">योहान 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />ज्य बोगवानान बेटाख यीशु मसीन, हाजाली खोबरीन सुरवात हे।<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">थोड़ाक लेख माय बोगवानान बिटोख नाह लिखेल हे।</char></note> <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />जिहकेरीन यशाया जाणकारान पुस्तेक माय लिखेल हे:</para>
  <para style="q1" vid="MRK 1:2">बोगवान केयो, “देख, ‘मी तार ओंगाण मार खोबर्‍याह मोकेलथु।’<verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />उजाड़ी माय एक आयेड़नारान आवाज होमलानो,</para>
  <para style="q2" vid="MRK 1:3">‘बोगवानान वाट तियार किरो;</para>
  <para style="q2" vid="MRK 1:3">एने तान वाट हुतरी किरो!’”<verse eid="MRK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4" />
    <note caller="+" style="f">
      <char style="fr" closed="false">1:4 </char>
      <char style="ft" closed="false">थोड़ाक लेख माय बपतीस्मा केरनार योहान पारचार किरतेन जेंगला माय देखाय दिनो। </char>
    </note>तानकेरता बपतीस्मा केरनार योहान उजाड़ी माय आवीन बपतीस्मा, एने पारचार केरतालो देखानो। एने माणहाह केयो, “पाप केरने सोड़ो एने बपतीस्मा लिवो, काय बोगवान तुमरा पाप माफ केरी।” <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />यहुदिया देसान ईलाका माय रेणारे आखा माणहे, एने यरूशलेम हेयराम रेणारे माणहे योहान फाय आवा, एने वचन होमलीन जान तान पापान माफी मांगीन यरदन नेदी माय योहान फाय रेन बपतीस्मा लेदा।<verse eid="MRK 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6" />योहान उटड़ान रोचकान फाड़का पेर रियेल ईतो, एने कोमरा माय चामड़ान पुट्टो बांद रियेल ईतो, एने तान खाणो टिड्या एने जेंगली मोवाल एतो। <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />योहान इहकेरीन पारचार केरतालो, “जो एदमी मार पासाण आवण्यो हे, तो माहु रेन जादा ताकेतवालो हे। तान खाहड़ान दोयड़ी सोड़नेन वोर मार माय लायकी नाय मीले। <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />मी ते तुमूह पाण्या केरीन बपतीस्मा केरथु, पुण तो तुमूह चोखाला जीवा केरीन बपतीस्मा केरी।”<verse eid="MRK 1:8" /></para>
  <para style="s">यीशुन बपतीस्मा एने पारेख</para>
  <para style="r">(<ref loc="MAT 3:13-4:11">मत्ती 3:13–4:11</ref>; <ref loc="LUK 3:21">लुका 3:21</ref>,<ref loc="LUK 3:22">22</ref>; <ref loc="LUK 4:1-13">4:1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />ता दिह्याम ओहलो एनो काय यीशु गेलील ने नासरत गावाम रेन आवो, एने यरदन नेदी माय योहान फाय रेन बपतीस्मा लिदो। <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />जेवी यीशु बपतीस्मा लेन पाण्या माय रेन उपेर आवो, तुलेचबूखे यीशु हेरोग उगेड़तालो एने चोखाला जीवाह पेरवान गेत ता पोर उतेरतालो दिख्यो। <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" /><note caller="+" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="MAT 3:17">मत्ती 3:17</ref>; <ref loc="MAT 12:18">12:18</ref>; <ref loc="MRK 9:7">मरकुस 9:7</ref>; <ref loc="LUK 3:22">लुका 3:22</ref></char></note>एने हेरगा माय रेन ज्यो आवाज होमलानो, “तु मारो मोंगाल्लो बिटोख हे, एने मी तार पोर जुलूम खुस हे।”<verse eid="MRK 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />तेवी चोखालो जीव यीशुह उजाड़ी माय ली गीयो, <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />एने उजाड़ी माय चालीह दिह वोर सैतान यीशुन पारेख किरते रिनो; एने यीशु जेंगली जेनवेरा हिऱ्यो रिनो, पुण हेरोगदुत आवीन तान सेवा चाकरी केऱ्या।<verse eid="MRK 1:13" /></para>
  <para style="s">यीशुन सेवान सुरवात</para>
  <para style="r">(<ref loc="MAT 4:12-17">मत्ती 4:12-17</ref>; <ref loc="LUK 4:14">लुका 4:14</ref>,<ref loc="LUK 4:15">15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />बपतीस्मा केरनार योहान देराय जाणेन पासाण यीशु गेलील माय आवो, एने बोगवानान राज ने हाजाली खोबरीन पारचार किरते रिनो। <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" /><note caller="+" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="MAT 3:2">मत्ती 3:2</ref></char></note>एने यीशु इही किन पारचार केरतालो, “टेम पुरो एय जायेल हे, एने बोगवानान राज आहने आव लागेल हे; तुमरा पापाम रेन मोन फिरावो एने हाजाली खोबरी पोर बुरहो किरो!”<verse eid="MRK 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />जेवी यीशु गेलील ने देरीयान दिड़े दिड़े जाणे बाजरियेल ईतो, तेवी तो शमोन एने तान बाहख अन्द्रियासाह देरीयाम जाल टाकताला दिख्यो, काहाकाय ता मासऱ्या एता। <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />तेवी यीशु ताह केयो, “मार पासाण आवो मी तुमूह हिकाडुह काय माणहाह बोगवाना फाय किहीक लावणु हे।” <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />ता यीशुन वात होमलीन जालीह जागेस सोड़ीन तान पासाण चाल देना।<verse eid="MRK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19" />यीशु थोड़ोक ओंगाण चालीन गीयो, तेवी जब्दीन सोरा याकुब एने योहान ज्या दुय बाहख डोंडह्या पोर जाल हुदारताला ताह देखाना। <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />जेवी यीशु ताह दिख्यो, तुलेचबूखे ताह हाद्यो; एने ता तान आबाख जब्दीह मोंजर्‍या हिऱ्यो डोंडह्या पोर सोड़ीन यीशुन पासाण चाल देना।<verse eid="MRK 1:20" /></para>
  <para style="s">यीशु बुतड़ो लागेल माणहा हुदारने</para>
  <para style="r">(<ref loc="LUK 4:31-37">लुका 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />तेवी यीशु एने तान चेला गेलील देसान कफरनहूम हेयरा माय आवा, एने यीशु विहेवणेन दिह यहुदिन बोक्ती केरन्या गेरा माय जाईन हिकाड़ने बाज गीयो। <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" /><note caller="+" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="MAT 7:28">मत्ती 7:28</ref>,<ref loc="MAT 7:29">29</ref></char></note>एने माणहे यीशुन हिकवोण होमलीन बोंगलाय जाताला, काहाकाय यीशु ताह देरेमगुरून गेत नाह; पुण आदिकार हिऱ्यो हिकाड़तालो।<verse eid="MRK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23" />तुलेचबूखे बोक्ती केरन्या गेरा माय एक बुतड़ो लागेल माणुह एतो, तो आयड़ीन केयो, <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />“एय यीशु नासरी आमुह तुवा हेऱ्यो काय काम? काय तु आमुह खेतेम केरने आयेल हे? मी तुवाह जाणथु, तु बोगवानान चोखालो खुबर्‍यो हे!”<verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />पुण यीशु ताह दोपकाड़ीन केयो, “ठावको रे, एने ज्या एदम्यान सेरीर माय रेन निकेल जा!”<verse eid="MRK 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26" />तेवी बुतड़ो ताह मोहदेलीन मोठेस आयेड़नो, एने तान सेरीर माय रेन निकेल गीयो। <verse eid="MRK 1:26" /><verse number="27" style="v" sid="MRK 1:27" />तो देखीन आखा माणहे ओला बोंगलाय गीया एने एका दिहराह केया, “ज्य काय हे? काय ज्यी नोवाली हिकवोण हे? ज्या एदम्या फाय बुतड़ाह उकुम आपणेन आदिकार हे, एने तो तान उकुम मानेह!”<verse eid="MRK 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28" />एने यीशुन बाराम खुबेर गेलील ईलाकान आहने पाहने आखी जागे पोसीर गीयो।<verse eid="MRK 1:28" /></para>
  <para style="s">यीशु जुलूम दुखाऱ्या माणहाह हुदारने</para>
  <para style="r">(<ref loc="MAT 8:14-17">मत्ती 8:14-17</ref>; <ref loc="LUK 4:38-41">लुका 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />यीशु एने तान चेला यहुदिन बोक्ती केरन्या गेरा माय रेन निकेल गीया, एने याकुब एने योहान हिऱ्यो शमोन एने अन्द्रियास ने गेर आवो। <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />शमोनान हाहवोक हेरी माय दुखारी खाटला पोर लोट रियेल एती, जेवी यीशु ता पुचनो, तीन बाराम ताह केया। <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />तेवी यीशु जाईन तीन आथ दिऱ्यो, एने तुलेचबूखे तीन हेरी उतेर गीयो, एने ती उठीन यीशु एने तान चेलान सेवा चाकरी केरने बाज गियी।<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />हांजीन टेम माय दिह बुड़ गीयो, तेवी माणहे आखा दुखाऱ्याह एने जा माय बुतड़ा एता ताह यीशु फाय लावा। <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />एने आखा गावान माणहे गेरान ओंगाण टोलवाय गीया। <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />एने यीशु जुलूम जाणे जा बात बातीन दुखा माय एता ताह हुदाऱ्यो। एने जुलूम बुतड़ाह काड्यो एने ताह कायच बोलने नाह दिनो, काहाकाय बुतड़ा यीशुह ओलेखताला।<verse eid="MRK 1:34" /></para>
  <para style="s">उजाड़ी माय यीशुन विन्ता</para>
  <para style="r">(<ref loc="LUK 4:42-44">लुका 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />उठ्यान विगोस दिह उगणेन पेल यीशु उठीन गेरा माय रेन निकलीन एक उजाड़ जागे गीयो, एने ता विन्ता केरने बाज गीयो। <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />पुण शमोन एने तान हाती यीशुह होदणे गीया। <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />जेवी यीशु ताह सापड़ी गीयो, तेवी ता यीशुह केया, “आखा माणहे तुवाह होदतेह।”<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />यीशु ताह जापाप आप्यो, “चाला आपु आस पास ने गावा माय जाता। माहु ता बी पारचार केरनु हे, काहाकाय मी ज्यान केरताच आयेल हे।”<verse eid="MRK 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 1:39" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:39 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:23">मत्ती 4:23</ref>; <ref loc="MAT 9:35">9:35</ref></char>
    </note>तानकेरता ता गेलील माय गीया, एने यीशु यहुदिन बोक्ती केरन्या गेरा माय जाईन पारचार किऱ्यो एने बुतड़ाह बाहेर काड़ते रिनो।<verse eid="MRK 1:39" /></para>
  <para style="s">यीशु कोढी माणहाह हुदारने</para>
  <para style="r">(<ref loc="MAT 8:1-4">मत्ती 8:1-4</ref>; <ref loc="LUK 5:12-16">लुका 5:12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />एक कोढी यीशु फाय आवीन तान पाया पोड़ीन विन्ता केरीन केयो, “केदी तारी मोरजी एय, ते तु माहु हुदार सिकेह।”<note caller="+" style="f"><char style="fr" closed="false">1:40 </char><char style="ft" closed="false">माहु चोखो किर, ज्यी बेमारी माणहा देरमान नेम प्रती खाराब किरेह।</char></note><verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />
    <note caller="+" style="f">
      <char style="fr" closed="false">1:41 </char>
      <char style="ft" closed="false">गीण, थोड़ाक लेख माय राग लिखेल हे</char>
    </note>यीशु ता पोर गीण केरीन आथ ओंगाण केरीन ताह सापलीन केयो, “मारी मोरजी हे काय तु हुदेर जाय!” <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />एने तुलेचबूखे कोढ ने बेमारी ताह एदम्याह सोड़ देनी, एने तो हुदरी गीयो। <verse eid="MRK 1:42" /><verse number="43" style="v" sid="MRK 1:43" />तेवी यीशु ताह सोमजाड़ीन चालोच मुकेल दिनो। <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />एने ताह केयो, “होमेल, कुणीह मा किहे। पुण जाईन चाकऱ्याह देखाड़जे एने ताह तार पारेख केरने दे, एने आपणे हुदेर जाणेन बाराम जो मुसो नेम ठेरायेल हे, ताह बेट चेड़ावजे काय ता पोर पुरावो एय।”<verse eid="MRK 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45" />पुण तो बाहेर जाईन ज्यी वातीन जुलूम पारचार केरने बाज गीयो, एने जुलूम पोसराव दिनो काय यीशु उदाह हेयरा माय नाह जाय सीकनो। पुण बाहेर उजाड़ी माय रिनो, एने आखी जागे रेन माणहे यीशु फाय आवती रेना।<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s">लोखवान बेमारी वाला माणहाह हुदारने</para>
  <para style="r">(<ref loc="MAT 9:1-8">मत्ती 9:1-8</ref>; <ref loc="LUK 5:17-26">लुका 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />थोड़ाह दिह्यान पासाण यीशु पुशो कफरनहूम हेयरा माय आवो, एने ज्यी खुबेर पोसरी गियी काय तो गेरा माय हे। <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />एने ओला होवटा माणहे एकठा टोलवाय गीया काय गेराम जागो नाह रिनो, एने बायणा हेऱ्यो बी जागो नाह ईतो। यीशु ताह वचन होमलाड़ ने बाजरियेल ईतो। <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />तेवी माणहे एक लोखवान दुखाऱ्याह यीशु फाय लावा, एने ताह चार एदमी उखलीन लायेल एता। <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />काहाकाय ताहरी जुलूम गेरदी एती केरीन यीशुन आहने ताह नाह पोचानो, ता गेरान साजाह जान निड़ो यीशु ईतो, ताहरूह उगाड़ देना, एने जेवी ताह वेसड़ी देना। तेवी ता खाटलाह जा पोर लोखवान दुखाऱ्यो लुट रियेल एतो, ताह उतार देना। <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />यीशु ता माणहान बुरहो देखीन लोखवान दुखाऱ्याह केयो, “एय मार बेटा, तारा पाप माफ एय गीया।”<verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />तेवी मोकतास देरेमगुरू ताहरी बोह रियेल एता, ता आप आपणा मोना माय विचार केरने बाज गीया, <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />“ज्यो माणुह काहा इहकेरीन किथे? ज्यो ते बोगवानान चिहटा किरेह! बोगवानाह सोड़ीन कुण पाप माफ केर सिकेह!”<verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />यीशु तुलेचबूखे तान जीवा माय जाण लिदो काय ता आप आपणा मोना माय कोहलो विचार केरने बाजरेनाह, एने ताह केयो, “तुमू काहा तुमरा मोना माय ज्यो विचार केरने बाजरेनाह? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />काय ज्या लोखवान दुखाऱ्याह ज्य केणे होपो हे, ‘तारा पाप माफ एय गीयाह,’ काय ज्य केणे, ‘उठ, तारो खाटलो उखलीन चाल?’ <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />मी ज्यो साबीत केर सेकथु काय माणहान बेटाख ज्यी देरती पोर पाप माफ केरनेन आदिकार हे।” केरीन यीशु ता लोखवान दुखाऱ्याह केयो, <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />“मी तुवाह केथु, उठ, तारो खाटलो उखेल, एने गेर जातरे!”<verse eid="MRK 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12" />तुलेचबूखे तो माणुह उठनो, एने खाटलो उखलीन आखा माणहान देखतास बाहेर जात रिनो। ज्यो देखीन आखा बोंगलाय गीया, एने बोगवानान बोड़ाय केरतीन केया, “ओहलो ते आमु केदीच नाह देख्या!”<verse eid="MRK 2:12" /></para>
  <para style="s">यीशु लेवीह हादणे</para>
  <para style="r">(<ref loc="MAT 9:9-13">मत्ती 9:9-13</ref>; <ref loc="LUK 5:27-32">लुका 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />तेवी यीशु गेलील ने देरीयान दिड़े पुशो गीयो, एने माणहान गेरदी तान आहने आवी, एने तो ताह हिकाड़नेन सुरवात केर दिनो। <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />जाणे बुखेत यीशु हलफाईन बेटाख लेवीह, फालो उकालन्या चोवकी पोर बोह रियेल दिख्यो, एने ताह केयो, “मार पासाण आव लाग।” तेवी लेवी उठीन तान पासाण चाल दिनो।<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />
    <note caller="+" style="f">
      <char style="fr" closed="false">2:15 </char>
      <char style="ft" closed="false">लेवीन गेरा माय, नाहते तान गेर यीशुन गेरा माय</char>
    </note>जेवी यीशु लेवीन गेरा माय रूटो खाणेन केरता बोह रियेल ईतो, तेवी जुलूम फालो उकालनारे एने दिहरा पापी माणहे बी तान पासाण आव लागेल एता, ता आखा यीशु एने तान चेला हेऱ्या रूटो खाणेन केरता पाटला पोर बोह रियेल एता। <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />थोड़ाक देरेमगुरू जा फरिसी माय रेन एता, ताह पापी एने फालो उकालनार माणहा हिऱ्यो रूटो खातालो देख्या, केरीन तान चेलाह केया, “ज्यो फालो उकालनारा एने पापी माणहा हिऱ्यो काहा खाते पिते?”<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />यीशु ज्य होमलीन ताह जापाप आप्यो, “हाजाला माणहाह वोंसीन गिरेज नाह, पुण दुखाऱ्याह हे। मी देरमीह नाह, पुण पापी माणहाह हादणेन आयेल हे।”<verse eid="MRK 2:17" /></para>
  <para style="s">उपासान सावाल</para>
  <para style="r">(<ref loc="MAT 9:14-17">मत्ती 9:14-17</ref>; <ref loc="LUK 5:33-39">लुका 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />तेवी बपतीस्मा केरनार योहानान चेला एने फरिसीन चेला उपास देरताला। एने थोड़ाक माणहे आवीन यीशुह केणे बाज गीया, “योहानान चेला एने फरिसीन चेला ते उपास देरतेह, पुण तारा चेला काहा उपास नाह देरते?”<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />यीशु ताह जापाप आप्यो, “काय तुमू आसा केरतेह काय एक वाराड़ा माय पावणा बुखल्यास जातेह? केदी बी नाह! जाह वोर वोवड़ो ता हिऱ्यो हे, ता इहकेरीन नाय केरती।” <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />पुण ता दिह आवती जेवी वोवड़ो ता हिऱ्यो रेन आलेग केराय जाय, ते दिह रेन ता उपास देरती।<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />कुण बी नोवाला फाड़कान ठिगलो जुनाला फाड़का पोर नाह लागाड़ने, नाहते तो ताम रेन थोड़ोक खेचलेय, एने नोवालो जुनालाह रेन पेल एतो, ताह रेन बी होवटो फाट जाय। <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />नोवाला अंगुरान रूहाह जुनाला चामड़ान थेयला माय कुण नाह मेलने, नाहते अंगुरान रोह चामड़ान थेयलाह फाड़ देय, एने अंगुरान रोह एने चामड़ान थेयली दुयू बी खेतेम एय जाती; केरीन नोवाला अंगुर ने रूहाह नोवालाच चामड़ान थेयला माय मेलनु। <figure style="fig" alt="Wineskin bag" file="lb00145c.tif" size="col" copy="Horace Knowles ©" ref="2:22">अंगुर मेलनेन थियलो</figure><verse eid="MRK 2:22" /></para>
  <para style="s">विहेवणेन दिह्यान सावाल</para>
  <para style="r">(<ref loc="MAT 12:1-8">मत्ती 12:1-8</ref>; <ref loc="LUK 6:1-5">लुका 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />इहकेरीन एनो काय यीशु एने तान चेला विहेवणेन दिह खेता मायतास जाणे बाजरियेल एता, तेवी तान चेला वाटे चालते जाईन उंब्या तोड़ने बाज गीया। <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />केरीन फरिसी यीशुह केया, “देख, ज्या ओहलोह काम काहा केरतेह? जो विहेवणेन दिह केरने कायदान विरोद हे!”<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />तेवी यीशु ताह जापाप आप्यो, “काय तुमू केदी ज्य नाह वाशा, जेवी दाऊदाह एने तान हातीह बुख लागी एने गिरेज पोड़नी? तेवी दाऊद काय किरेल ईतो। <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />केरीन तो बोगवानान गेरा माय गीयो एने बोगवानाह बेट चेड़ायेल रूटो खादो, ज्य तुलबूखे एनो जेवी अबियाजर मुखी चाकर्‍यो ईतो। आपणा नियमान गेत ता रोटाह चाकऱ्या ओलास खाय सेकताला, पुण दाऊद ज्या रोटाह खादो एने तान माणहाह बी आप्यो।”<verse eid="MRK 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />तेवी यीशु ताह केयो, “विहेवणेन दिह माणहान केरता बाणायेल हे, नाह काय माणुह विहेवणेन दिह्यान केरता। <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />तानकेरता मी माणहान बिटोख विहेवणेन दिह्यान बी मालीक हे।”<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s">यीशु आथ पांगला माणहाह हुदारने</para>
  <para style="r">(<ref loc="MAT 12:9-14">मत्ती 12:9-14</ref>; <ref loc="LUK 6:6-11">लुका 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />एने यीशु पुशो यहुदिन बोक्ती केरन्या गेरा माय गीयो, ता एक माणुह एतो जान आथ पांगलो ईतो। <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />थोड़ाक माणहे वाट जोवणे बाजरियेल एता काय यीशु विहेवणेन दिह ता आथ पांगा माणहाह हुदारी; काय ता यीशु पोर गुनो लागाड़ सेकी।<verse eid="MRK 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 3:3" />यीशु ता आथ पांगा माणहाह केयो, “न्या आखान ओंगाण आवीन उबरी।”<verse eid="MRK 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 3:4" />यीशु माणहाह फुशो, “काय विहेवणेन दिह हाजो केरने कायदान विरोद हे? काय बाकतो केरने, जीवाह वोचाड़ने काय मारने, ज्याम रेन काल्लो हाजो हे?”</para>
  <para style="p" vid="MRK 3:4">पुण ता ठावकाच रेय गीया। <verse eid="MRK 3:4" /><verse number="5" style="v" sid="MRK 3:5" />यीशु कावदेन ताह रागा माय बोरायीन दिख्यो, एने तान मोनान वातड़ाय देखीन जुलूम नाराज एय गीयो। ओवतो यीशु ता माणहाह केयो, “तार आथ ओंगाण किर।” तो आथ ओंगाण केऱ्यो, एने तान आथ पेल ने गेत हुदेर गीयो। <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />केरीन फरिसी बाहेर निकलीन जात रेना, एने यीशुन विरोद माय हेरोदेस ने टोलीन माणहा हेऱ्या एक वारीन मिलीन वात केरने बाज गीया, काय किहीक यीशुह खेतेम केरहु।<verse eid="MRK 3:6" /></para>
  <para style="s">माणहान गेरदी यीशुन पासाण आवणे</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />यीशु एने तान चेला बाहेर निकलीन गेलील देरीयान उगे गीया, तेवी गेलील एने यहुदिया गावाम रेन एक होवटाली माणहान गेरदी तान पासाण चाल देनी, <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />एने यरूशलेम, एने इदूमिया, एने यरदन नेदीन ती पार सुर एने सेदान देसान आहने पाहने रेन बी माणहान एक होवटाली गेरदी यीशुन चोमेत्कार ने कामान बाराम होमलीन ता फाय आवी। <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" /><note caller="+" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="MRK 4:1">मरकुस 4:1</ref>; <ref loc="LUK 5:1-3">लुका 5:1-3</ref></char></note>यीशु तान चेलाह केयो काय गेरदी जुलूम हे केरीन मार केरता एक डोंडह्यो तियार केर मीलो, काहाकाय माणहे माहु दाब नाय सेकी। <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />काहाकाय यीशु मोकतास दुखाऱ्या माणहाह हुदारेल ईतो, तानकेरीन जोला बी दुखाऱ्या माणहे एता, तोला ताह सापेलनेन केरता तान आहने आवताला। <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />एने जेवी बुतड़ा लागेल माणहे ताह देखताला, ते तान ओंगाण पोड़ जाताला एने जोरेस आयड़ीन केताला, “तु बोगवानान बिटोख हे!”<verse eid="MRK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12" />यीशु बुतड़ाह उकुम आप्यो काय मार बाराम दिहरा कुणीह नाय केय।<verse eid="MRK 3:12" /></para>
  <para style="s">यीशु बारा चेलाह निवाड़ने</para>
  <para style="r">(<ref loc="MAT 10:1-4">मत्ती 10:1-4</ref>; <ref loc="LUK 6:12-16">लुका 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />ओवतो यीशु एक बोयड़ा पोर जात रिनो एने जा माणहे ताह पोटना ताह हाद्यो। एने ता यीशु फाय आवा। <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />एने यीशु ताम रेन बारा जाणाह निवाड्यो, एने तान नाव प्रेरित मिल्यो। तो ताह केयो, “मी तुमूह मार आरही रेणेन केरता निवाड़ेल हे, एने मी तुमूह पारचार केरनेन केरता बी मोकलुह, <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />एने तुमूह बुतड़ाह काड़नेन आदिकार रेय।”<verse eid="MRK 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16" />यीशु जा बारा जाणाह निवाड़ेल तान नावे ज्या हेते: शमोन जान नाव तो पतरस मिल्यो; <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />जब्दीन बिटोख याकुब एने तान बाहख योहान जान नाव यीशु बुअनरगिस, मतलब “गाजणारान बिटोख मिल्यो।” <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />अन्द्रियास, फिलीपुस, बरतुल्मे, मत्ती, थोमा, हलफाईन बिटोख याकुब, तद्दे, शमोन कनानी जो रोमी सारकारान विरोदी ईतो। <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />एने यहुदा इस्‍कोरिती, जो यीशुह दुको देन देराव दियेल ईतो।<verse eid="MRK 3:19" /></para>
  <para style="s">यीशु एने बुतड़ान मुखी बालजबुल</para>
  <para style="r">(<ref loc="MAT 12:22-32">मत्ती 12:22-32</ref>; <ref loc="LUK 11:14-23">लुका 11:14-23</ref>; <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />तेवी यीशु गेर जात रिनो। एने पोशी माणहान ओली होवटाली गेरदी टुलो एय गियी काय यीशु एने तान चेलाह खाणेन केरता बी टेम नाह जुड़नो। <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />जेवी यीशुन गेरल्या ज्यान बाराम खुबेर होमल्या, ते ता यीशुह गेर ली जाणेन केरता आवा, काहाकाय माणहान केणो एतो, “तान दिमाक ठिकाणा पोर नाय मीले!”<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:22 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 9:34">मत्ती 9:34</ref>; <ref loc="MAT 10:25">10:25</ref></char>
    </note>तेवी थोड़ाक देरेमगुरू जा यरूशलेम माय रेन आयेल एता, ता ज्य केताला, “ज्या माय बालजबुल हे, एने ज्यो ता बुतड़ान आदिकारीन मोदेक लेन बुतड़ाह बाहेर काड़ेह।”<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />केरीन यीशु ताह आहने हाद्यो एने किस्सा माय केयो, “सैतान किहीक सैतानाह काड़ सिकेह? <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />केदी राज ने माणहा माय फुट पोड़ी, ताहार ता राज ने माणहे किहीक एकठा रेय सेकतेह, <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />एने केदी एगदा गेरान माणहा माय फुट पोड़ी, ताहार ता गेरान माणहे किहीक एकठा रेय सेकतेह। <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />तानकेरता केदी सैतान ताच ने राज ने विरोदी एन ताज माय फुट पाड़ी, ताहार तो किहीक बोणीन रेय सिकेह? तो खेतेमुस एय जाथे।<verse eid="MRK 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27" />“काल्लो बी माणुह एगदा तेगड़ा माणहान गेराम रिगीन तान माल नाह लुट सिकेत, जाह वोर काय तो ता तेगड़ा माणहाह बांद नाह देत; ओवतो तान गेराह लुट सिकेह।”<verse eid="MRK 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28" />
    <note caller="+" style="f">
      <char style="fr" closed="false">3:28 </char>
      <char style="ft" closed="false">शायद ता जो केतेह खाराब वातु हे</char>
    </note>“मी तुमूह खेरीच केथु काय माणहान आखा पाप एने चिहटा जा ता केरतेह माफ एय जाती। <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" /><note caller="+" style="x"><char style="xo" closed="false">3:29 </char><char style="xt" closed="false"><ref loc="LUK 12:10">लुका 12:10</ref></char></note>पुण जो कुण चोखाला जीवान विरोद माय खाराब चिहटा किरेह, ताह केदी बी माफी नाय जुड़ी, काहाकाय तो माणुह जेलेमक्या पापान गुनेगार हे।” <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />यीशु ज्य ज्यानकेरता कियेल ईतो, काहाकाय थोड़ाक माणहे ज्य केताला, “ज्या माय बुतड़ो हे।”<verse eid="MRK 3:30" /></para>
  <para style="s">यीशु एने तान गेरल्या</para>
  <para style="r">(<ref loc="MAT 12:46-50">मत्ती 12:46-50</ref>; <ref loc="LUK 8:19-21">लुका 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />तेवी यीशुन आहख एने बाहख आवा। ता गेरान बाहेर उबरियेल एता, एने खुबेर ली मोकल्या काय बाहेर आवी। <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />यीशुन ओंगाण एक मोटली माणहान गेरदी बोह रियेल एती, ता यीशुह केया, “देख, तारी आहख एने तारा बाहख बोणीख बाहेर हेते, एने ता तुवाह बाहेर हादणे बाजरेनाह।”<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />यीशु ताह जापाप आप्यो, “मार आहख एने मार बाहख कुण हेते?” <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />एने तान आहने जा बोह रियेल एता ता माणहा उगे देखीन केयो, “दिखो! न्या मार आहख एने मार बाहख बोणीख हेते! <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />काहाकाय जो कुण बोगवानान मोरजी पोर चाली, तोस मार बाहख, मार बोणीख एने मार आहख हे।”<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">दाणा पेरनारान बाराम किस्सो</para>
  <para style="r">(<ref loc="MAT 13:1-9">मत्ती 13:1-9</ref>; <ref loc="LUK 8:4-8">लुका 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:1 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 5:1-3">लुका 5:1-3</ref>
      </char>
    </note>यीशु पुशो गेलीलान देरीयान मीरे हिकाड़ने बाज गीयो। एने ओली होवटाली माणहान गेरदी तान जागे टोलवाय गियी केरीन तो देरीया माय एक डोंडह्या पोर चेड़ीन बोह गीयो। एने माणहान गेरदी बुई पोर मेराम उबरियेल एती। <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />एने यीशु ताह किस्सा माय जुलूम वातु हिकाड़ने बाज गीयो, एने ताह केयो,<verse eid="MRK 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 4:3" />“हासकेरीन हुमलो! एक एदमी ईतो जो दाणा पेरनेन केरता गीयो। <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />एने पेरनेन टेम माय थोड़ाक दाणा वाटीन दिड़े पोड़ना, तेवी चीड़ा आवीन ताह खाय गीया। <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />एने थोड़ाक दाणा सापराट्या जागा माय पोड़ना, ताहरी दाणाह होवटो माटड्यो नाह जुड़नो, केरीन दाणा तुरुत उग गीया, <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />जेवी दिह उगीन दोप लागो, तेवी हुका हेलगी गीया; काहाकाय मुल उपरूस एता, केरीन हुक गीया। <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />थोड़ाक दाणा काटाल्या जुरखील्या माय पोड़ना, एने जुरखील्या वोदीन ताह दाब देना, एने ताह फोल नाह लागा। <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />पुण थोड़ाक दाणा हाजाली बुई माय पोड़ना, एने ता उगना एने वोदीन फोलना: काल्लाह तीस मोण, काल्लाह साठ मोण, एने काल्लाह होव मोण कामाय पाकनी।”<verse eid="MRK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9" />एने यीशु केयो, “जा फाय होमेलनेन केरता कान एती, ता होमली लेय!”<verse eid="MRK 4:9" /></para>
  <para style="s">किस्सान मतलब</para>
  <para style="r">(<ref loc="MAT 13:10-17">मत्ती 13:10-17</ref>; <ref loc="LUK 8:9">लुका 8:9</ref>,<ref loc="LUK 8:10">10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />जेवी यीशु एखालोच रेय गीयो, तेवी तान हाती एने ता बारा जाणे मिलीन यीशुह ज्या किस्सान बाराम फुशा। <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />यीशु ताह जापाप आप्यो, “तुमूह ते बोगवानान राज ने मालमात ने सोमेज आपेल हे, पुण बाहेरवाला माणहाह सोब वातु किस्सा माय ईथे, <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />काहाकाय,</para>
  <para style="q1" vid="MRK 4:12">“ता देखतेह ते खोरा,</para>
  <para style="q2" vid="MRK 4:12">पुण ताह कायच नाह देखात;</para>
  <para style="q1" vid="MRK 4:12">एने ता होमेलतेह ते खोरा,</para>
  <para style="q2" vid="MRK 4:12">पुण कायच सोमेजते नाह,</para>
  <para style="q1" vid="MRK 4:12">केदी ता ओहलो केरता, ते बोगवानान उगे वोलता,</para>
  <para style="q2" vid="MRK 4:12">एने तो ताह माफ केर दितो।”<verse eid="MRK 4:12" /></para>
  <para style="s">दाणा पेरनारान किस्सान मतलब</para>
  <para style="r">(<ref loc="MAT 13:18-23">मत्ती 13:18-23</ref>; <ref loc="LUK 8:11-15">लुका 8:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />यीशु ताह फुशो, “काय तुमू ज्या किस्साह नाह सोमेजते? ते ओवता तुमू न्या आखा किस्साह किहीक सोमेजहो? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />पेरनार बोगवानान वचन पिरेह। <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />थोड़ाक माणहे वाटी पोर पुड़ेल दाणान गेत हेते; ता वचन ते होमेलतेह, पुण सैतान आवीन ता माय जो पेरायेल वचन एतो, ताह निकाल लिथे। <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />थोड़ाक माणहे सापऱ्याटी बुई पोर पुड़ेल दाणान गेत हेते। जा वचन होमेलताच खुसी माय वचन मान लेतेह। <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />पुण ता माय मुल नाह रेणेन कारेण ता थोड़ास दिह्यान केरता रेतेह। जेवी ता पोर वचनान कारेण दुख एने तेकलीत आवीह, तेवी ता चालोच पासाण एय जातेह। <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />थोड़ाक माणहे काटाल्या जुरखील्या माय पेरायेल दाणान गेत हेते। जा वचनाह होमेलतेह, <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />पुण ज्यी दुनियान बाराम चिन्ता, मालदेनाह मोंग केरने, एने दिहऱ्यु वोस्तुन लालुच ता माय रिगीन वोदता वचनाह दाब लिथे, एने तो विणफोल्योस रेय जाथे। <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />पुण थोड़ाक माणहे हाजाली बुई माय पुड़ेल दाणान गेत हेते। ता वचन होमलीन स्वीकार लेतेह एने फोल लावतेह: काल्लाह तीस मोण, काल्लाह साठ मोण, एने काल्लाह होव मोण लावतेह।”<verse eid="MRK 4:20" /></para>
  <para style="s1">दिवान बाराम किस्सो</para>
  <para style="r">(<ref loc="LUK 8:16-18">लुका 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:21 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:15">मत्ती 5:15</ref>; <ref loc="LUK 11:33">लुका 11:33</ref></char>
    </note>यीशु ताह केयो, “काय दिवाह पायला एने खाटलान बुंदे मेलनेन केरता पेटाड़नु नाह? पुण दिवाह कोठी पोर मेलनेन केरता पेटाड़नु? <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" /><note caller="+" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="MAT 10:26">मत्ती 10:26</ref>; <ref loc="LUK 12:2">लुका 12:2</ref></char></note>काहाकाय बोगवानान राज तुमूह लिकायेल लागेह, पुण ज्यानकेरता हे काय आखो उगड़ी जाय; एने काईस बी लिकायेल नाह सोतो, जो उजाला माय नाय आवी। <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />जान होमेलनेन केरता कान एती, ता होमली लिवो!”<verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:24 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:2">मत्ती 7:2</ref>; <ref loc="LUK 6:38">लुका 6:38</ref></char>
    </note>पुशो यीशु ताह केयो, “तुमू जो होमेलतेह ता पोर खास केरीन द्यान मीलो! जिहकेरीन तुमू दिहरा हेऱ्या वेवारो केरतेह, तिहेस केरीन बोगवान बी तुमरे हिऱ्यो वेवार केरी, पुण ताह रेन बी वोदार केरी। <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" /><note caller="+" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="MAT 13:12">मत्ती 13:12</ref>; <ref loc="MAT 25:29">25:29</ref>; <ref loc="LUK 19:26">लुका 19:26</ref></char></note>काहाकाय जा फाय काह हे ताह उंजु आपाय जाय, एने जा फाय काय नाह सोतो, ता फाय जो काय थोड़ोक हे, तो बी लेवाय जाय।”<verse eid="MRK 4:25" /></para>
  <para style="s">उगणारा दाणान बाराम किस्सो</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />यीशु पुशो केयो, “बोगवानान राज ता माणहान गेत हे, जो तान खेता माय दाणा पिरेह। <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />तो राती जाईन हुव गीयो, एने विगोस जाग जाथे, जेवी दाणा फुटीन हुका निकेलना एने वोदेह। तीबी तो माणुह नाह जाणेत काय ज्य किहीक ईथे। <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />बुय आपाप फोल आपेह पेल हुका उगणु; एने ओवता केणहे आवणु, एने तान पासाण केणहा माय बोरायेल दाणा। <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />जेवी दाणा पाक जातेह, तेवी तो माणुह दातला केरीन काटणेन सुरवात किर दिथे, काहाकाय काटणेन टेम आव लागेल हे।”<verse eid="MRK 4:29" /></para>
  <para style="s">राईन दाणान किस्सो</para>
  <para style="r">(<ref loc="MAT 13:31">मत्ती 13:31</ref>,<ref loc="MAT 13:32">32</ref>,<ref loc="MAT 13:34">34</ref>; <ref loc="LUK 13:18">लुका 13:18</ref>,<ref loc="LUK 13:19">19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />यीशु फुशो, “आपु बोगवानान राज ने गेणती कायता हेऱ्या केरने, एने काल्ला किस्सा हेऱ्या तान तोल केरने? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />बोगवानान राज राईन दाणान गेत हे, जो पेराणे तुलबूखे तो बुईन आखा दाणाह रेन आत्यो रीथे। <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />थोड़ीक वार माय तो उगीन मोठो एय जाथे एने बाजी पालाह रेन मोठो एय जाथे। एने ताह ओहला मोट मोटला डालख्यु फुटणु काय चीड़ा बी तान डालीन सावला माय पांजरो बाणावीन रेय सेकतेह।”<verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />यीशु न्यान गेत जुलूम दिहरा किस्सान वापेर केरीन माणहाह वचन होमलाड्यो, तो ताह तोलोस केयो जोला ता सोमेज सेकताला। <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />एने यीशु बिगेर किस्सान वापेर केरीन ताह कायच नाह हिकाड़तालो, पुण जेवी तो चेला हिऱ्यो एखालोच रेतालो, तेवी आखी वातुन मतलब तान खास चेलाह केय आपतालो।<verse eid="MRK 4:34" /></para>
  <para style="s1">यीशु वादोणाह ठावको केरने</para>
  <para style="r">(<ref loc="MAT 8:23-27">मत्ती 8:23-27</ref>; <ref loc="LUK 8:22-25">लुका 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />तेदिस हांज पोर यीशु तान चेलाह केयो, “चाला आपु देरीयान ती मीरे जाता।” <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />केरीन ता गेरदीह सोड़ देना; एने जा डोंडह्या माय यीशु बोह रियेल ईतो, चेला बी ता डोंडह्या माय बोहीन ताह ली गीया। एने ता हेऱ्या दिहरा जुलूम होवटा डोंडह्या बी एता। <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />तेवी उचकाहुच एक मोटलो वादोण आवो, एने जेलखा डोंडह्या हेऱ्या ठोकाणे बाज गीया, न्या वोर काय पाणी डोंडह्या माय बोराणे बाज गीयो। <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />एने यीशु डोंडह्यान पासाणल्या पुड़ाम उहत्या पोर मुंड मेलीन हुवणे बाजरियेल ईतो। एने ता जाईन यीशुह जागाड्या एने केया, “एय गुरू, काय तुवाह फिकेर नाह सोती आमु मोरने पोर हेते?”<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />तेवी यीशु उठीन वादोणाह उकुम आप्यो, एने जेलखाह केयो, “ठावको रे! एने थोब जा!” ओवतो वारो थोब गीयो, एने आखी उगे ठावको एय गीयो।<verse eid="MRK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 4:40" />तेवी यीशु चेलाह केयो, “तुमू काहा ओला बितेह? काय तुमूह एवी वोर बुरहो नाय मीले?”<verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />पुण ता जुलूम बिय गीया एने एका दिहराह केणे बाज गीया, “ज्यो एदमी कुण हे? वादोण एने जेलखा बी ज्यान उकुम मान्तेह!”<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s">यीशु एक बुतड़ो लागेल माणहाह हुदारने</para>
  <para style="r">(<ref loc="MAT 8:28-34">मत्ती 8:28-34</ref>; <ref loc="LUK 8:26-39">लुका 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />यीशु एने ता चेला गेलीलान देरीयान दिहरे उगे गिरासेनियान एद्दीम आवा। <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />एने जेवी यीशु डोंडह्या माय रेन उतेरनो, तेवी बुतड़ो लागेल एक माणुह ताह मिलनो। जो माहणान उगे रेन आयेल एतो। <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />एने तो माहणा माय रेतालो। कुण बी ताह हाकुल केरीन बांदिन नाह मेल सेकताला; <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />काहाकाय ताह जुलूम वारीन आथा पायाम बेड्या एने हाकुल केरीन बांदिल एता, पुण तो हाकलीह तोड़ देतालो एने बेड्यान टुकड़ा टुकड़ा केर देतालो। ताह ताबाम केरनेन ताकेत कुणास फाय नाह एती। <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />तो रात ने दिह माहणा एने डोंगरा माय आयेड़तीन फिरतालो, एने देगड़ा केरीन सोतान सेरीराह देन जेखमी केरतालो।<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />जेवी तो सिटेच रेन यीशुह देख्यो; केरीन तो दोवड़ीन ता फाय आवो, एने तान पाया पोड़ीन वोंद्यो, <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />एने मोठेस आयड़ीन केयो, “एय मोटला बोगवानान सोरा यीशु! मारो तार हेऱ्यो काय लेन देन नाह? मी तुवाह बोगवानान सुगोण आपथु, माहु डेंड मा आपी!” <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />तो ज्यानकेरता इहकेरीन केयो, काहाकाय यीशु ता बुतड़ाह कियेल ईतो, “एय बुतड़ा, ज्या माणहा माय रेन बाहेर निकेल जा।”<verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />यीशु ताह फुशो, “तारो नाव काय हे?”</para>
  <para style="p" vid="MRK 5:9">तो माणुह जापाप आप्यो, “मारो नाव ‘फोज हे,’ काहाकाय आमु जुलूम हेते!” <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />एने तो यीशुह जुलूम विन्ता केरीन केयो काय आमुह ज्या ईलाका माय रेन बाहेर नाय मोकली।<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />ताहरी बोयड़ान आड़वाया माय हुवऱ्यान एक मोटलो टुलो चेरने बाजरियेल ईतो। <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />केरीन बुतड़ो यीशुह विन्ता केरीन केयो, “आमुह ओया हुवऱ्या माय मुकेल दे, एने आमु हुवऱ्या माय रिग जाहु।” <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />ओवतो यीशु ताह मुकेल दिनो, एने बुतड़ा ता माणहा माय रेन निकलीन हुवऱ्या माय रिग गीया। एने हुवऱ्यान टुलो जा दुय एजार एता, आड़वाया माय रेन दोवड़ीन पाण्या माय जाय पोड़ना एने बुड़ीन मोर गीया।<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />ज्य देखीन हुवऱ्यान गोवाल्या दोवड़ीन हेयराम एने गावाम गीया, एने ज्यी गेटनान बाराम केणे बाज गीया। एने जो काय ईयेल एतो तो देखणेन केरता माणहे आवा, <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />एने जेवी माणहे यीशु फाय आवा, तेवी ता माणहाह जा माय बुतड़ान टुलो ईतो। ताह फाड़का पेरीन एने सुद्दी माय बोह रियेल देखीन बिय गीया। <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />जा माणहे ज्य आखो तान डोला केरीन पेल दिखेल एता, ता हेयराम रेन आयेल माणहाह केया काय बुतड़ा लागेल माणहा हेऱ्यो काय ईयेल एने हुवऱ्यान बाराम।<verse eid="MRK 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 5:17" />केरीन ता माणहे यीशुह विन्ता केरीन केया काय आमरा एद्दी माय रेन जात रेय।<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />जेवी यीशु डोंडह्या पोर चेड़ने बाजरियेल ईतो, तेवी तो माणुह जाह पेल बुतड़ा लागेल एता, तो इहकेरीन विन्ता केरीन केयो, “माहु बी तार हेऱ्यो आवणे दे!”<verse eid="MRK 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 5:19" />यीशु ताह आवणे नाह दिनो। पुण ताह केयो, “तार गेर जाईन तारा गेरल्या माणहाह के काय बोगवान माहु पोर कोलीक मोठी गीण किरेल हे।”<verse eid="MRK 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 5:20" />केरीन तो माणुह दिकापुलिस दोह गावान एक हियोर हे, एने ता जाईन तो ज्यी वातुन बाराम माणहाह केयो काय यीशु मार केरता कोलोक मोठो काम किरेल हे। एने आखा माणहे तान वातु होमलीन बोंगलाय गीया।<verse eid="MRK 5:20" /></para>
  <para style="s">एक मुरेल सोरी एने दुखारी बायकु</para>
  <para style="r">(<ref loc="MAT 9:18-26">मत्ती 9:18-26</ref>; <ref loc="LUK 8:40-56">लुका 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />जेवी यीशु डोंडह्या माय बोहीन पुशो देरीयान ती उगे गीयो। तेवी माणहान एक होवटाली गेरदी यीशु हेरी टुलो एय गियी, एने तो देरीयान मीरेच ईतो। <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />तेवी यहुदिन बोक्‍तीन गेरान आदिकारी माय रेन याईर नावान एक माणुह आवो, एने यीशुह देखीन तान पाया पुड़नो। <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />एने याईर आथ जोड़ीन यीशुह विन्ता केरीन केयो, “मार आतली सोरी जुलूम दुखारी हे। केरीन तु मार गेर चाल एने ती पोर आथ मील काय ती हुदरी जाय, एने जीवताली रेय!”<verse eid="MRK 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24" />ओवतो यीशु ता हिऱ्यो गीयो, एने होवटाली माणहान गेरदी बी तान पासाण चाल देनी, एने माणहे ओला होवटा एता काय ता हेऱ्या ठोकातेन चालताला।<verse eid="MRK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25" />ता माय एक बायकु एती, जीह बारा वोरह्या रेन लुय वोयणेन बेमारी एती, <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />ती जुलूम तेकलीत माय एती, एने मोकतास वोंसीन आथा केरीन जुलूम दुख विठेल एती। एने ती फाय जोलो मालदेन एतो तो आखो खेरची दियेल एती तीबी तीह कायच गुण नाह दिनो। पुण उंजु होवटीह दुखार्‍यी एय जायेल एती। <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />ती यीशुन बाराम होमलेल एती, केरीन गेरदी माय रेन तान पासाण आवी एने तान फाड़काह सापेल लेदी, <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />काहाकाय ती केताली, “केदी मी तान फाड़काह ओलीच सापेल लेह, तीबी मी हुदेर जाह।”<verse eid="MRK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29" />एने ती यीशुन फाड़काह सापेलतास तीन लुय वोयणे बोंद एय गियी, एने ती तीन सेरीर माय ज्य जाण लेदी काय मी ता दुखा माय रेन हुदेर गियीह। <verse eid="MRK 5:29" /><verse number="30" style="v" sid="MRK 5:30" />तुलेचबूखे यीशु ज्य जाण लिदो काय मार माय रेन ताकेत निकलेल हे, केरीन तो गेरदी माय पासाण फिरीन फुशो, “मार फाड़काह कुण सापलेल?”<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />तान चेला जापाप आप्या, “तु ते देखीच रिनोह काय माणहे तार हेऱ्या ठोकातेन चालतेह; एने तु किथे काय कुण माहु सापलेल हे?”<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />पुण यीशु कावदेन देखणे बाज गीयो काय माहु कुण सापलेल एतो। <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />ती बायकुह ज्यो मालुम एय जायेल एतो काय ती हेऱ्यो काय ईयेल एतो, केरीन ती बितेन एने कापतेन आवी, एने यीशुन ओंगाण पाया पोड़ीन आखो खेर खेरीच केय देनी। <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />यीशु तीह केयो, “बेटी, तारो बुरहो तुवाह हुदार दियेल हे, हुकेह जा, एने ज्यी बेमारीह रेन हुदरीन रे।”<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />जेवी यीशु ज्य केणे बाजरियेल ईतो, तेवी थोड़ाक माणहे याईर आदिकारीन गेर रेन खुबेर लेन आवा एने ताह केया, “तार सोरी मोर जायेल हे। एवी गुरूह तेकलीत काहा देता।”<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />
    <note caller="+" style="f">
      <char style="fr" closed="false">5:36 </char>
      <char style="ft" closed="false">बिलकुर द्यान नाह दिनो, नाहते एंजाणल्या माय होमलेल</char>
    </note>पुण यीशु तान वातु होमलीन बी द्यान नाह देनो, एने आदिकारीह केयो, “बिय मा, बुरहो उलोस मेल।” <verse eid="MRK 5:36" /><verse number="37" style="v" sid="MRK 5:37" />तेवी यीशु पतरस, याकुब एने तान बाहख योहानाह सोड़ीन दिहराह कुणीह बी ता हिऱ्यो आवणे नाह दिनो। <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />जेवी ता आदिकारीन गेर आवा, तेवी यीशु माणहाह चिल्लाटा देन रेड़ताला एने जोरेस आयेड़ताला दिख्यो। <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />तो माय जाईन ताह केयो, “तुमू काहा आयेड़तेह एने रेड़तेह? सोरी मुरेल नाह सोती, पुण हुवणे बाजरेनीह!”<verse eid="MRK 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40" />ता माणहे ज्य होमलीन यीशुन मोजाक उड़ाया, पुण तो ताह आखाह बाहेर काड़ दिनो, एने सोरीन आईख आबाख एने तान तीन चेलाह आरही लेदो, एने सोरी एती ती खोली माय गीयो। <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />एने तो सोरीन आथ देरीन तीह केयो, “तलीता कुमी,” तान मतलब हे, “एय आतली सोरी, मी तुवाह केथु उठ!”<verse eid="MRK 5:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42" />ती सोरी तुलेचबूखे उठीन चालने फिरने बाज गियी। काहाकाय ती बारा वोरह्यान एती, तेवी ता माणहे जुलूम बोंगलाय गीया। <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />पुण यीशु ताह उकुम आपीन केयो, “ज्यी वात कुणीह मालुम पोड़णे नाय जुवे, एने सोरीह काह खाणेन आपो।”<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s1">नासरत गावा माय यीशुन अपमान</para>
  <para style="r">(<ref loc="MAT 13:53-58">मत्ती 13:53-58</ref>; <ref loc="LUK 4:16-30">लुका 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />यीशु याईर ने गेराम रेन निकलीन तान गावाम आवो, एने तान चेला बी पासाण आवा। <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />विहेवणेन दिह यीशु बोक्ती केरन्या गेरा माय जाईन पारचार केरने बाज गीयो, एने तान वातु होमलीन जुलूम माणहे होमलीन बोंगलाय गीया एने केया, “ज्याह ज्यी वातु कारीन जुड़ेल हे? ज्या फाय काल्ली इकेल हे जो ताह आपेल हे? एने ज्यान आथाम रेन ओहला मोटला चोमेत्कार ने काम किहीक एतेह? <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />काय ज्यो तो हुतार नाह सुतो, जो मरीयम ने बिटोख एने याकुब, योसेस, यहुदा एने शमोन ने बाहख नाह सुतो? एने काय ज्यान बोणह्युख न्या आपणी विचीम नाह रेत्यु?” तानकेरता माणहे यीशुह नाकार देना।<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:4 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 4:44">योहान 4:44</ref>
      </char>
    </note>यीशु ताह केयो, “काल्ला बी जाणकाराह तान गेर एने तान जाती माय एने तान गावाम मान पान नाह जुड़ेत, पुण दिहरी जागे ताह मान पान जुड़ने।”<verse eid="MRK 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 6:5" />यीशु ताहरी काल्लोस चोमेत्कार ने काम नाह केर सीकनो, पुण थोड़ास दुखाऱ्या माणहा पोर आथ मेलीन ताह हुदारेल।<verse eid="MRK 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 6:6" />एने यीशुह तान अविश्वासाह देखीन जुदोच लागो।</para>
  <para style="s" vid="MRK 6:6">यीशु बारा चेलाह पारचार केरनेन मोकेलने</para>
  <para style="r" vid="MRK 6:6">(<ref loc="MAT 10:5-15">मत्ती 10:5-15</ref>; <ref loc="LUK 9:1-6">लुका 9:1-6</ref>)</para>
  <para style="p" vid="MRK 6:6">उवतो यीशु ता रेन निकलीन चार चोमखीर ने गावा माय जाईन माणहाह हिक दितेन फिरनो। <verse eid="MRK 6:6" /><verse number="7" style="v" sid="MRK 6:7" />तेवी यीशु बारा चेलाह आहने हाद्यो, एने ताह बुतड़ा पोर आदिकार आपीन दुय दुय केरीन मुकल्यो। <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />उंजु ताह उकुम आप्यो, “वाटीन केरता डेंगा सोड़ीन दिहरो कायच मा लिहो, नाह रूटो, नाह थेयलो एने नाह पोयशा। <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />खाहड़ा पिरो, पुण दुय जोड़ डेगला मा लिहो।” <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />एने उंजु ताह केयो, “जा गेरान माणहे तुमरो स्वागत केरती, तुमू ताच गेरा माय रिवो जाह वोर काय तुमू ता रेन नाह जाते। <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" /><note caller="+" style="x"><char style="xo" closed="false">6:11 </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">लुका 10:4-11</ref>; <ref loc="ACT 13:51">प्रेरितान काम 13:51</ref></char></note>एने ज्यी जागेन माणहे तुमरी वातु नाय होमेलती ताहार ता रेन चाल दिज्यो, एने तुमरा पायाम लेटकेल रेजड़ो जिटेक दिज्यो, काय तान केरता चेतावणी रेय!”<verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />केरीन चेला गावा गावा माय जाईन पारचार केरने बाज गीया काय पापाह सोड़ीन बोगवाना उगे वोली। <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" /><note caller="+" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="JAS 5:14">याकुब 5:14</ref></char></note>ता जुलूम माणहा माय रेन बुतड़ा निकाल्या, एने जुलूम दुखाऱ्या माणहा पोर तेल चोपड़ीन ताह हुदाऱ्या।<verse eid="MRK 6:13" /></para>
  <para style="s">योहान बपतीस्मा केरनारान खुन</para>
  <para style="r">(<ref loc="MAT 14:1-12">मत्ती 14:1-12</ref>; <ref loc="LUK 9:7-9">लुका 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:14 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:14">मत्ती 16:14</ref>; <ref loc="MRK 8:28">मरकुस 8:28</ref>; <ref loc="LUK 9:19">लुका 9:19</ref></char>
    </note>
    <note caller="+" style="f">
      <char style="fr" closed="false">6:14 </char>
      <char style="ft" closed="false">हेरोदेस राजा, हेरोदेस अंतीपास, गेलील ईलाकान आदिकारी</char>
    </note>हेरोदेस राजा बी यीशुन बाराम ज्य होमल्यो, काहाकाय तान नाव आखी जागे पोसरी जायेल एतो, एने माणहे केताला, “योहान बपतीस्मा केरनार मुरेल माय रेन जीव उठेल हे! तानकेरता ज्या फाय रेन ओहला मोटला चोमेत्कार ने काम एतेह।”<verse eid="MRK 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15" />दिहरा माणहे केया, “ज्यो एलिया हे,”</para>
  <para style="p" vid="MRK 6:15">पुण थोड़ाक जाणे उंजु केया, “जुनाला जाणकारा माय रेन एक हे।”<verse eid="MRK 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16" />ज्य होमलीन हेरोदेस राजा केयो, “जो बपतीस्मा केरनार योहान हे! जान मुंड मी काटाड़ दियेल ईतो, पुण तोच जीव उठेल हे!” <verse eid="MRK 6:16" /><verse number="17" style="v" sid="MRK 6:17" /><note caller="+" style="x"><char style="xo" closed="false">6:17 </char><char style="xt" closed="false"><ref loc="LUK 3:19">लुका 3:19</ref>,<ref loc="LUK 3:20">20</ref></char></note>हेरोदेस राजा तान सिपायाह मोकलीन योहानाह हाकुल केरीन बांदिन जेली माय कोंडाड़ दियेल ईतो। काहाकाय तो ओहलो काहा किरेल काय राजा तान बाहख फिलीपुस ने बायकु हेरोदियाह राख लियेल ईतो। <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />बपतीस्मा केरनार योहान जाहार ताहार हेरोदेसाह कियेल ईतो, “तार बाहख ने बायकुह राखणे तार केरता हाजो नाह सोतो!”<verse eid="MRK 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19" />केरीन हेरोदियास योहाना हेऱ्यी दुसमोनाय केरताली एने ताह मारावणेन तीन विचार एतो। पुण हेरोदेस ने कारेण ती ओहलो नाह केर सेकी। <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />हेरोदेस योहानाह देरमी एने चोखालो एदमी जाणीन ताह बितालो, एने ताह वोचाड़ीन मील रियेल ईतो। एने हेरोदेस योहानान वातु होमलीन जुलूम गाबराय जातालो, पुण खुसी से होमेलतालो।<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />एक दिह हेरोदियाह मुको जुड़ गीयो। जेवी हेरोदेस राजान जेल्मो दिह आवो, तेवी राजा सरकारी आदिकारीह एने सेनापोती, एने गेलील देसान आखा मालदार माणहाह खाणेन केरता हादेल ईतो। <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" /><note caller="+" style="f"><char style="fr" closed="false">6:22 </char><char style="ft" closed="false">हेरोदियास ने सोरी; थोड़ाक लेख माय तान सोरी हेरोदियास लिखेल हे</char></note>तुलबूखे हेरोदियास ने सोरी माय आवीन नाचनी, एने हेरोदेसाह एने ता हेऱ्या बोहणारा आखा पावणाह खुस केरी, तेवी राजा सोरीह केयो, “तुवाह जो जुवे तो माहु फाय मांग मी तुवाह आपुह।” <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />एने राजा वायदो केरीन केयो “जो काय तु माहु फाय मांगहे, तो मी तुवाह आपुह, तो मारो आदो राज काहा नाय रेय!”<verse eid="MRK 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24" />केरीन ती बाहेर जाईन तीन आईख फुशी, “मी काय मांगु?”</para>
  <para style="p" vid="MRK 6:24">तीन आहख केयी, “योहान बपतीस्मा केरनारान मुंड मांग।”<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />ती सोरी तुलेचबूखे दोवड़ीन माय आवीन राजाह केयी, “मारी मोरजी हे काय तु योहान बपतीस्मा केरनारान मुंड काटाड़ीन एक पाराती माय मेलीन मार केरता मांगाड़ दे!”<verse eid="MRK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26" />तेवी राजा ज्यी वात होमलीन जुलूम नाराज एय गीयो, पुण राजा तान आखा पावणान ओंगाण जो वायदो किरेल ईतो, केरीन तीन वात टाल नाह सीक्‍यो। <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />तानकेरता राजा एक सिपायाह योहानान मुंड काटीन लावणेन केरता उकुम आपीन मुकल्यो। सिपाय गीयो, एने योहानान मुंड काट दिनो; <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />एने एक पाराती माय मेलीन लावो एने सोरीह आप दिनो, एने सोरी तीन आईख आप देनी। <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />ज्यी खुबेर योहानान चेला फाय पोचनी, तेवी योहानान चेला आवीन तान देड़ाह ली गीया, एने माहणा माय ठिकाणे लागाड़ देना।<verse eid="MRK 6:29" /></para>
  <para style="s">यीशु पाच एजार माणहाह रूटो खावड़ावणे</para>
  <para style="r">(<ref loc="MAT 14:13-21">मत्ती 14:13-21</ref>; <ref loc="LUK 9:10-17">लुका 9:10-17</ref>; <ref loc="JHN 6:1-14">योहान 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />तेवी प्रेरित वोलीन यीशुन जागे टोलवाना, एने जो काय ता किरेल एने जो काय हिकाड़ेल तो आखो ताह केय देना। <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />तेवी यीशु ताह केयो, “तुमू ओलास आखा मार पासाण हुनाला जागाम चालो एने एकताल आराम किरो।” काहाकाय जुलूम माणहे आवती जाते रेताला एने ताह रूटो खाणेन बी टेम नाह जुड़तालो। <verse eid="MRK 6:31" /><verse number="32" style="v" sid="MRK 6:32" />तानकेरता ता आखा डोंडह्या माय बोहीन आंगेच हुनाला जागाम जात रेना।<verse eid="MRK 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33" />मोकतास माणहे ताह जाताला देख लेदा एने ज्य बी ओलखी लेदा काय ता कुण हेते; केरीन आस पास ने गावान आखा माणहे एकठा एन ताहरी पायेच दोवड़ना, एने यीशु एने तान चेलाह रेन पेल जाय पोचना। <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" /><note caller="+" style="x"><char style="xo" closed="false">6:34 </char><char style="xt" closed="false"><ref loc="MAT 9:36">मत्ती 9:36</ref></char></note>जेवी यीशु डोंडह्या माय रेन उतरनो, तो माणहान एक होवटाली गेरदी दिख्यो, ते ता माणहा पोर किव आवी, काहाकाय ता बिगेर गोवाल ने मेंड्रान गेत एता। केरीन तो ताह जुलूम वातु हिकाड़ने बाज गीयो।<verse eid="MRK 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 6:35" />जेवी दिह डेल गीयो, तेवी तान चेला आहने आवीन केया, “ज्यो हुनालो जागो हे, एने दिह जुलूम डेल जायेल हे। <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />एवी न्या माणहाह मुकेल दे, एने ज्या आस पास ने गावा माय एने वोहती माय जाईन तान केरता काह खाणेन लेती।”<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />
    <note caller="+" style="f">
      <char style="fr" closed="false">6:37 </char>
      <char style="ft" closed="false">चांदीन सिक्‍का, चांदीन एक सिक्को मतलब गावा माय एक मोंजऱ्यान मोंजरी हे। देखी मत्ती 20:2</char>
    </note>पुण यीशु ताह जापाप आप्यो, “तुमूच न्याह खाणेन आपो।”</para>
  <para style="p" vid="MRK 6:37">चेला यीशुह फुशा, “ओला माणहाह खावड़ावणेन केरता कोम से कोम दुय होव दिह्यान मोंजरीन पोयशा लागती। तार काय मोरजी हे काय आमु जाईन न्यान केरता रोटा ली आवज्यो?”<verse eid="MRK 6:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38" />यीशु ताह फुशो, “कोलाक रोटा हेते न्या? जावो एने दिखो।”</para>
  <para style="p" vid="MRK 6:38">ता मालुम केरीन केया, “पाच रोटा एने दुय मासा हेते।”<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />तेवी यीशु चेलाह उकुम आप्यो काय आखा माणहाह निल्ला खेड़ा पोर पोंगेत पोंगेत बोहाड़ दिवो। <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />ता माणहे होव होव, एने पाचाह पाचाह केरीन पोंगेत माय बोह गीया। <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />यीशु ता पाच रोटा एने दुय मासाह आथाम देरीन हेरगान उगे देख्यो, एने बोगवानान दन्यवाद किऱ्यो। तो रोटा मुड़ीन चेलाह आपते गीयो काय माणहाह वाटती। एने ता दुय मासा बी तिहेस केरीन वाट देना। <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />जेवी आखा माणहे खाईन आफरी गीया। <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />तेवी चेला उगरेल रोटान टुकड़ा बारा टोपला बोरीन विशा, एने थोड़ाक मासा बी। <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />एने रोटा खाणारा माय पाच एजार एदमीच एता।<verse eid="MRK 6:44" /></para>
  <para style="s">यीशु देरीया पोर चालने</para>
  <para style="r">(<ref loc="MAT 14:22-33">मत्ती 14:22-33</ref>; <ref loc="JHN 6:15-21">योहान 6:15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />तेवी यीशु चेलाह डोंडह्या पोर चेड़ीन बोहणेन केरता मोजबुर किऱ्यो काय तान पेल ती पार बेतसेदा गावा माय जात रेती, जाह वोर काय तो माणहाह मोकलेत नाह। <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />यीशु माणहाह मोकली देन बोयड़ा पोर विन्ता केरनेन केरता गीयो। <verse eid="MRK 6:46" /><verse number="47" style="v" sid="MRK 6:47" />जेवी हांज एय गियी तेवी डोंडह्यो देरीयान विचीम एतो, एने यीशु एखालोच बुई पोर ईतो। <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />यीशु दिख्यो काय चेला जुलूम मेहनेत केरीन डोंडह्यो चालाड़ने बाजरेनाह एने जुलूम गाबराय जायेल हेते, काहाकाय वादोण वारो तान हुम्बो एतो, तेवी यीशु उजालो एणेन पेल पाण्या पोर चालतेन तान आहने आवो। तो ताह रेन ओंगाण जाणेन होदतालो,<note caller="+" style="f"><char style="fr" closed="false">6:48 </char><char style="ft" closed="false">तान आहने रेन जाणे बाजरियेल ईतो, नाहते ता हिऱ्यो जाणे बाजरियेल ईतो।</char></note> <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />पुण ता यीशुह पाण्या पोर चालतालो देखीन सोमेजना काय “ज्‍यु बुत हे!” एने आयेड़ने बाज गीया। <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />काहाकाय ता आखा यीशुह देखीन बिय जायेल एता।</para>
  <para style="p" vid="MRK 6:50">पुण यीशु ता हिऱ्यो वातु केरीन केयो, “ईमोत किरो, मी हे, बिवो मा!” <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />तेवी यीशु ता हिऱ्यो डोंडह्या माय आवो, एने वादोण वारो थोब गीयो। ज्य देखीन चेला जुलूम बोंगलाय गीया, <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />एने ता पाच एजार माणहा खावड़ायेल तान बाराम चेला नाह सोमजेल एता; काहाकाय तान मोन ता वातड़ो केर लियेल एता।<verse eid="MRK 6:52" /></para>
  <para style="s">गन्नेसरत गावा माय दुखाऱ्या माणहाह हुदारने</para>
  <para style="r">(<ref loc="MAT 14:34-36">मत्ती 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />ओवता ता देरीयाह पार केरीन गन्नेसरत गावा माय पोचना, एने मीरे उतरीन डोंडह्याह बांद देना। <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />जेवी ता डोंडह्या माय रेन उतेरना, तेवी माणहे ताह चालोच ओलखी लेदा। <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />एने ता माणहे आहने पाहने वाला आखा गावा माय दोवेड़ते फिरना; एने दुखाऱ्या माणहाह खाटला पोर उखलीन जा जा यीशु हे, ओहली वात होमलानी ता ली फिरना। <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />एने यीशु काल्ला बी गाव एने वोहती जातालो, माणहे दुखाऱ्याह बाजारा माय मेलीन यीशुह विन्ता केरताला काय दुखाऱ्याह तान फाड़काह सापेलने देय; एने जोला बी दुखाऱ्या माणहे तान फाड़काह सापेलताला ता आखा हुदेर जाताला।<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s">डायडायान रिती पालनेन बारामाय सावाल</para>
  <para style="r">(<ref loc="MAT 15:1-9">मत्ती 15:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />तेवी फरिसी एने थोड़ाक देरेमगुरू जा यरूशलेम हेयराम रेन आयेल एता, यीशुन कावदेन टोलवाय गीया। <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />एने ता यीशुन थोड़ाक चेलाह बिगेर आथ दुयेल रूटो खाताला देख्या, केरीन ता चेलाह एठा मान्या।<verse eid="MRK 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3" />काहाकाय फरिसी एने आखा यहुदि माणहे, डायला माणहान रितीन पालेन केरताला: काहाकाय जाह वोर हास केरीन आथ दोव नाह लेणु ताह वोर रूटो नाह खाताला; <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />एने ता आटा माय रेन जी काय बी चिज लावतेह ताह पेल हास केरीन दोव नाह लेते, ताह वोर नाह खाते। एने जुलूम ओहली रितीन पालेन केरतेह, जिहकेरीन वाटको, कुलह्यो एने तांबान ठामलाह चोलनु एने दोवणु।<note caller="+" style="f"><char style="fr" closed="false">7:4 </char><char style="ft" closed="false">बाजार माय रेन लायेल काह सामान पेल दोवी नाय; नाहते जो काय, जो बाजार माय रेन लावणेन पासाण खुद दोव नाय लेय</char></note><verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />केरीन फरिसी एने देरेमगुरू यीशुह फुशा, “तारा चेला काहा नाह डावाला माणहान हिकवोणीह मान्तेह, एने बिगेर आथ दुयेल रूटो खातेह।”<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />यीशु ताह केयो, “यशाया जाणकार तुमरो कोपटीन बाराम हास केरीन जाणाव किरेल हे, जिहकेरीन लिखेल हे:</para>
  <para style="q1" vid="MRK 7:6">“न्या माणहे ओठा केरीन ते मारो मान मेलतेह,</para>
  <para style="q2" vid="MRK 7:6">पुण न्यान मोन मार हेऱ्यो रेन जुलूम सेटो रीथे।<verse eid="MRK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7" />न्या उदेड़ मार नावान बोक्ती केरतेह,</para>
  <para style="q2" vid="MRK 7:7">एने सोतान नियमाह बोगवानान नेम हे</para>
  <para style="q2" vid="MRK 7:7">केरीन माणहाह हिकाड़तेह!”<verse eid="MRK 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8" />“काहाकाय तुमू बोगवानान उकुमाह टालीन माणहान हिकवोणीह मान्तेह।”<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />यीशु ताह ज्य बी केयो, “बोगवानान उकुमाह टालनेन केरता तुमू जुलूम चेतुर हेते, पुण सोतान बाणायेल हिकवोणीह मान्तेह।” <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />काहाकाय मुसो कियेल हे, “आपणी आईख आबाख ने मान मिलज्यो,” एने जो कुण आईख आबाख ने बाराम बुरो केय, “तो खेरीच माराय जाय।” <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />पुण तुमू केतेह काय जो आईख आबाख आपण्यो एतो, “तो मी नाह आप सिकेत।” काहाकाय तो मी बोगवानाह बेट चेड़ाव दियेल हे, <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />केरीन तुमूह तुमरे आईख आबाख ने चाकरी नाह केरनेन बाहानो जुड़ जाथे। <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />इहकेरीन तुमू बोगवानान वचनाह टाल देतेह। पुण तुमू ठेरायेल ता नेमाह मान्तेह, एने ओहलाच जुलूम काम तुमू केरतेह।<verse eid="MRK 7:13" /></para>
  <para style="s">माणहाह एठी केरनार चिज</para>
  <para style="r">(<ref loc="MAT 15:10-20">मत्ती 15:10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />उवतो यीशु माणहाह आहने हादिन केयो, “तुमू आखा मारी हुमलो, एने सुमजो। <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />ओहली काल्लीस वोस्तु नाह सोती जी माणहाह बाहेर रेन माय जाईन ताह एठी केरी। पुण जी चिज माणहान माय रेन निकलेह, तीस माणहाह एठी किरेह।” <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />जान होमेलनेन कान एती, ता होमली लेय।<note caller="+" style="f"><char style="fr" closed="false">7:16 </char><char style="ft" closed="false">ज्यो वचन थोड़ाक लेख माय नाह जुड़ेत। देखी 4:23</char></note><verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />जेवी यीशु गेरदीह सोड़ीन गेराम गीयो, तेवी तान चेला ज्या किस्सान बाराम फुशा। <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />यीशु ताह केयो, “काय तुमू बी नासमज हेते? काय तुमू नाह सोमेजते काय जी चिज बाहेर रेन माणहान माय जाथे? ती चिज ताह एठी नाह किरेत, <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />काहाकाय ती चिज तान मोनाम नाह जात, पुण पेटाम जाथे एने आगणेन द्‍वारे बाहेर निकेल जाथे।” ज्य किन यीशु आखी खाणेन चिज चोखो ठेराव दिनो।<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />यीशु पुशो ताह केयो, “जो माणहान माय रेन निकलेह तोच माणहाह एठो किरेह। <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />काहाकाय माणहान मोना माय रेन खाराब विचार आवतेह, जो ताह चोरी, खुन, सिनालो, <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />लोब, खाराब काम, खाराब देखणु, जुठ, चिहटा, मोठलाय, कोपेट एने फोगान गेत वातु केरावणे। <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />ज्‍यु आख्‍यु खाराब वातु माणहा माय रेन निकेलनु, एने माणहाह एठो केरने।”<verse eid="MRK 7:23" /></para>
  <para style="s">बिगेर यहुदि बायकुन बुरहो</para>
  <para style="r">(<ref loc="MAT 15:21-28">मत्ती 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />उवतो यीशु ता रेन निकलीन सुर हेयराम आवो, एने एक गेराम गीयो। तो ज्य नाह होदतालो काय कुण बी ताह ओलखी, पुण यीशु लीकाय नाह सीकनो। <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />एक कनानी जातीन बायकु यीशुन बाराम होमलीन ताह मिलनेन आवी, ज्यीन आतली सोरी माय बुतड़ो रिग रियेल ईतो, एने ती गेराम आवीन तान पाया हेरी पोड़ गियी। <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />ती बायकु बिगेर यहुदि एती, एने सीरीयान फीनीके माय पायदा ईयेल एती। ती यीशुह विन्ता केरी काय मार सोरी माय रेन बुतड़ाह निकाल दे। <verse eid="MRK 7:26" /><verse number="27" style="v" sid="MRK 7:27" />यीशु तीह जापाप आप्यो, “पेल सोराह आफेरने दे। काहाकाय सोरान रूटो लेन चितान ओंगाण टाकणे हाजो नाह सोतो।”<verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />ती यीशुह जापाप आप्यी, “ज्य खेरीच हे मालीक, पुण सोरान उस्टालो रूटो पाटला पोर रेन पुड़ेल चिता खाणु ते खोरा!”<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />यीशु ती बायकुह केयो, “तु ज्य कियेल हे केरीन हुकेह गेर जातरे, काहाकाय बुतड़ो तार सोरी माय रेन निकेल जायेल हे!”<verse eid="MRK 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30" />ती गेर पोचीन तीन सोरीह खाटला पोर हुवताली देखी; एने बुतड़ो ती माय रेन निकेल जायेल ईतो।<verse eid="MRK 7:30" /></para>
  <para style="s">बेयरा एने बोबड्या माणहाह यीशु हुदारने</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />उवतो यीशु सुर ने ईलाका माय रेन निकलीन सेदान ईलाका माय लागतोस गेलील ने देरीया हिऱ्यो आवो, एने दोह गावान हियोर दिकापुलिस माय गीयो। <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />थोड़ाक माणहे ता फाय एक बेयरा माणहाह लावा जो बोबड्यो बी एतो, माणहे ता एदमी पोर आथ मेलनेन केरता यीशुह विन्ता केऱ्या। <verse eid="MRK 7:32" /><verse number="33" style="v" sid="MRK 7:33" />यीशु ताह गेरदी माय रेन आंगेच ली गीयो, एने यीशु तान आंगल्या बेयरान काना पोर मिल्यो, एने तान आंगल्या पोर थुपीन तान जिबी पोर मिल्यो। <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />एने हेरगान उगे देखीन हाह लिदो, एने ताह केयो, “इप्फत्तह!” मतलब “उगड़ीजा!”<verse eid="MRK 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 7:35" />ता माणहान कान उगड़ी गीया, एने तान जिबीन गाठ बी जात रेनी, एने तो हास केरीन बोलने बाज गीयो। <verse eid="MRK 7:35" /><verse number="36" style="v" sid="MRK 7:36" />तेवी यीशु ताह उकुम आप्यो काय ज्य कुणीह मा किहो; पुण ताह जोलो सोमजाड़ेल ईतो, तोला ता माणहाह केया। <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />तान वातु होमलीन बोंगलाय गीया एने केया, “ज्यो कोलोक हास केरीन आखो काय केर लिथे, तो बेयराह होमेलने एने मुकाह बोलनेन ताकेत आपेह!”<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">यीशु चार एजार माणहाह रूटो खावड़ावणे</para>
  <para style="r">(<ref loc="MAT 15:32-39">मत्ती 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />ता दिह्याम माणहान होवटाली गेरदी यीशुन जागे टोलवाय गियी। एने ता फाय खाणेन केरता कायच नाह एतो, तेवी यीशु तान चेलाह आहने हादिन केयो, <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />“माहु न्या माणहा पोर किव आवीह, काहाकाय न्या तीन दिह वोर एक सारका मार हेऱ्या हेते एने न्या फाय खाणेन केरता कायच नाह सोतो। <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />केदी मी न्याह बुखल्योच गेर मोकेल देह, ते न्या वाटेच लेवायीन पोड़ जाती, काहाकाय न्या माय रेन थोड़ाक सीटे रेन आयेल हेते।”<verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />तान चेला ताह फुशा, “ज्यी उजाड़ी माय ओला होवटा रोटा कुण लावी काय न्या आखा माणहे खाईन आफरी जाती?”<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />यीशु तान चेलाह फुशो, “तुमू फाय कोलाक रोटा हेते?” ता जापाप आप्या, “हात।”<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />तेवी यीशु माणहाह बुई पोर बोहणेन केरता उकुम आप्यो। उवतो ता हात रोटा मांग लिदो, एने बोगवानाह दन्यवाद केरीन मुड्यो, एने तान चेलाह आपती गीयो काय ता माणहाह वाटती; एने चेला माणहाह वाट देना। <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />ता फाय थोड़ाक आतल्या मासा बी एता। यीशु ताह बी बोगवानान दन्यवाद केरीन माणहाम वाटणेन केरता चेलाह आप दिनो। <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />एने आखा माणहे खायलीन आफरी गीया, एने चेला उगरेल रोटा हात टोपला बोरीन विशा। <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />एने ताहरी चार एजार माणहे एता। उवतो यीशु ताह मोकली दिनो। <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />तेवी यीशु डोंडह्या माय बुठो एने तान चेला हिऱ्यो देल्मनुता हेयरा माय जात रिनो।<verse eid="MRK 8:10" /></para>
  <para style="s">फरिसी यीशुह चोमेत्कार केरने कियेल</para>
  <para style="r">(<ref loc="MAT 12:38-42">मत्ती 12:38-42</ref>; <ref loc="MAT 16:1-4">16:1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8:11 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:38">मत्ती 12:38</ref>; <ref loc="LUK 11:16">लुका 11:16</ref></char>
    </note>ओवता फरिसी आवीन यीशु हेऱ्या बोलचाल केरने बाज गीया। ता ज्य पारेखणेन केरता काय यीशु बोगवानान उगे रेन हे काय माणहान उगे रेन, हेरगान निसाणी मांग्‍या। <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" /><note caller="+" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="MAT 12:39">मत्ती 12:39</ref>; <ref loc="LUK 11:29">लुका 11:29</ref></char></note>यीशु तान जीवा माय हाह बोरीन केयो, “ज्यी टेमीन माणहे काहा निसाणी मांगतेह? मी तुमूह खेरीच केथु! काय ज्यी टेमीन माणहाह काल्लीस निसाणी नाय आपाय!”<verse eid="MRK 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 8:13" />उवतो यीशु ताह सोड़ दिनो, एने पुशो डोंडह्या माय बोहीन ती पार जात रिनो।<verse eid="MRK 8:13" /></para>
  <para style="s">फरिसी एने हेरोदेसान हिकवोणीन खमीर</para>
  <para style="r">(<ref loc="MAT 16:5-12">मत्ती 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />चेला रूटो ली जाणे विहरी जायेल एता एने डोंडह्या माय ता फाय एकुस रूटो ईतो। <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" /><note caller="+" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="LUK 12:1">लुका 12:1</ref></char></note>यीशु चेलाह सोमजाड़ीन केयो, “फरिसीन खमीर एने हेरोदेसान खमीर रेन उशारी माय रिज्यो।”<verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />ज्य होमलीन चेला आपसाम वातु केरने बाज गीया, “तो ज्य ज्यानकेरता किथे, काहाकाय आपु फाय रोटा नाह सोता।”<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />यीशु ज्य जाणीन ताह केयो, “आपु फाय रोटा नाह सोता इहकेरीन आपसाम बोलचाल काहा केरतेह? काय तुमूह एवी बी सोमेज माय नाह आवीत? काय तुमरो मोन वातड़ो एय जायेल हे? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" /><note caller="+" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="MRK 4:12">मरकुस 4:12</ref></char></note>डोला हेते तीबी तुमूह काय देखात नाह? एने कान हेते तीबी कायच नाह होमेलते? एने तुमूह कायच बी एर नाह सोतो <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />जेवी मी पाच एजार माणहान केरता पाच रोटा मुड़ेल ईतो, तेवी तुमू उगरेल रोटा कोलाक टोपला बोरीन विसेल एता?”</para>
  <para style="p" vid="MRK 8:19">चेला केया, “बारा टोपला।”<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />यीशु ताह फुशो, “जेवी मी चार एजार माणहान केरता हात रोटा मुड़ेल ईतो, तेवी तुमू उगरेल रोटा कोलाक टोपला बोरीन विसेल एता?”</para>
  <para style="p" vid="MRK 8:20">चेला ताह जापाप आप्या, “हात टोपला।”<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />यीशु चेलाह फुशो, “काय तुमू एवी वोर नाह सोमेजते?”<verse eid="MRK 8:21" /></para>
  <para style="s">यीशु बेतसेदा गावाम एक आंदला माणहाह हुदारने</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />ता आखा बेतसेदा गावाम आवा, एने थोड़ाक माणहे एक आंदलाह यीशु फाय लेन आवा एने ताह विन्ता केऱ्या काय आंदलाह सापली। <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />यीशु ता आंदला माणहान आथ देरीन गावान बाहेर ली गीयो। ओवतो तान डोला पोर थुप्यो एने आथ मेलीन ताह फुशो, “काय तुवाह काह देखाह?”<verse eid="MRK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24" />तो उपेर नेजेर केरतीन केयो, “होव मी माणहाह देख सेकथु, पुण ता माहु चालताला जाड़ान गेत देखातेह।”<verse eid="MRK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25" />यीशु पुशो एक वार तान डोला पोर आथ मिल्यो। एने तो हासकेरीन देख्यो, एने तो हुदरी गीयो, एने साप साप देखणे बाज गीयो।<verse eid="MRK 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 8:26" />यीशु ताह ज्य केयीन गेर मुकेल दिनो, “ज्या गावा माय पुशो जाहे मा।”<verse eid="MRK 8:26" /></para>
  <para style="s">यीशु बोगवानान द्‍वारे निवाड़ेल सोड़वणार हे</para>
  <para style="r">(<ref loc="MAT 16:13-20">मत्ती 16:13-20</ref>; <ref loc="LUK 9:18-21">लुका 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />उवतो यीशु एने तान चेला केसरीया फिलेपीन गावान आहने गीया। तेवी वाटे यीशु तान चेलाह फुशो, “मी कुण हे, ज्यान बाराम माणहे माहु काय केतेह?”<verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8:28 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 6:14">मरकुस 6:14</ref>,<ref loc="MRK 6:15">15</ref>; <ref loc="LUK 9:7">लुका 9:7</ref>,<ref loc="LUK 9:8">8</ref></char>
    </note>चेला जापाप आप्या, “काल्ला केतेह तु योहान बपतीस्मा केरनार हे; पुण थोड़ाक जाणे केतेह तु एलिया हे, एने थोड़ाक केतेह तु जाणकारा माय रेन एक हे।”<verse eid="MRK 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8:29 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 6:68">योहान 6:68</ref>,<ref loc="JHN 6:69">69</ref></char>
    </note>यीशु तान चेलाह फुशो, “पुण मी कुण हे ज्यान बाराम तुमू काय केतेह?”</para>
  <para style="p" vid="MRK 8:29">पतरस यीशुह जापाप आप्यो, “तु मसी हे।”<verse eid="MRK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30" />यीशु ताह उकुम आप्यो, “मार बाराम ज्य कुणीह मा किहे।”<verse eid="MRK 8:30" /></para>
  <para style="s">यीशु तान मोत एने पोशो जीव उठणेन बाराम जाणाव</para>
  <para style="r">(<ref loc="MAT 16:21-28">मत्ती 16:21-28</ref>; <ref loc="LUK 9:22-27">लुका 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />उवतो यीशु तान चेलाह हिकाड़ने बाज गीयो, “माणहान बेटाख ने केरता ज्यो जोरवरी हे काय मी जुलूम दुख वेठु, एने डावाला माणहे एने बोगवानान मुखी चाकऱ्या, एने देरेमगुरून द्‍वारे नेचो गेणाय जाह एने माराय जाह। पुण मी तीन दिह्यान पासाण पुशो जीव उठुह।” <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />यीशु ज्यी वात ताह हुतरी हेट केय दिनो। केरीन ज्य केतास पतरस यीशुह कुवालोच ली जाईन दोपकावणे बाज गीयो। <verse eid="MRK 8:32" /><verse number="33" style="v" sid="MRK 8:33" />पुण यीशु तान चेलान उगे देखीन पतरसाह दोपकावीन केयो, “एय सैतान, मार हिऱ्यो रेन सिटो एय जा, काहाकाय तु बोगवानान वाती पोर नाह। पुण माणहान वाती पोर मोन लागाड़ने!”<verse eid="MRK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8:34 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:38">मत्ती 10:38</ref>; <ref loc="LUK 14:27">लुका 14:27</ref></char>
    </note>बाद माय यीशु माणहाह एने तान चेला आहने हादिन केयो, “जो कुण मार पासाण आवणे हुदेह, ताहार तो आपणे आपाह नाकारी, एने तान खुरूसखाम उखलीन मार पासाण चाल देय। <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" /><note caller="+" style="x"><char style="xo" closed="false">8:35 </char><char style="xt" closed="false"><ref loc="MAT 10:39">मत्ती 10:39</ref>; <ref loc="LUK 17:33">लुका 17:33</ref>; <ref loc="JHN 12:25">योहान 12:25</ref></char></note>काहाकाय जो कुण बी तान जीवाह वोचाड़ने हुदेह तो ताह गोमाड़ देय; पुण जो कुण मार केरता एने मार हाजाली खोबरीन केरता जीव गोमाड़ी, तो ताह वोचाड़ लेय। <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />केदी माणुह आखी केलीन चिजीह काबाम केर लेय एने तान जीवाह दुको एय, ताहार ताह काय फायदो एय? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />दुनियान काल्ली बी चिज केरीन माणुह तान जीवाह लेय नाह सिकेत? <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />एने जो कुण ज्यी सिनाली एने पापी जातीन विचीम मार हेऱ्या एने मारी वातीह रेन लाजवाती, जेवी मी माणहान बिटोख बी मार चोखाला हेरोगदुता हिऱ्यो एने मार आबाख ने बोड़ाय हिऱ्यो आवुह, तेवी ता हिऱ्यो बी लाजवाह।”<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />एने यीशु ताह केयो, “मी तुमूह खेरीच केथु, जा न्याहरूह उब रेनाह ता माय रेन थोड़ाक माणहे ओहला हेते काय जाह वोर बोगवानान राजाह ताकेत हेऱ्यो आयेल नाय देख लेती, ताह वोर नाय मोरती।”<verse eid="MRK 9:1" /></para>
  <para style="s">यीशुन वेह बोदेलने</para>
  <para style="r">(<ref loc="MAT 17:1-3">मत्ती 17:1-3</ref>; <ref loc="LUK 9:28-36">लुका 9:28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />
    <note caller="+" style="x">
      <char style="xo" closed="false">9:2 </char>
      <char style="xt" closed="false">
        <ref loc="2PE 1:17">2 पतरस 1:17</ref>,<ref loc="2PE 1:18">18</ref></char>
    </note>यीशु सोव दिह्यान पासाण पतरस, याकुब एने योहानाह तान आरही लेन, कुवालोच एक उचाच बोयड़ा पोर गीयो, ताहरी तान सामने यीशुन वेह बोदेल गीयो, <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />एने यीशुन फाड़का ओहला चोमेकणे बाज गीया। ओहला चोमेकताला काय देरती पोर काल्लो बी दोबी दोवल्या नाय केर सेकी। <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />तेवी चेलाह एलिया एने मुसा देखाना, एने ता दुयू यीशु हेऱ्या वातु केरताला। <verse eid="MRK 9:4" /><verse number="5" style="v" sid="MRK 9:5" />पतरस यीशुह केयो, “एय गुरू, आपुह न्या रेणे हाजो हे! ताहार आमु तीन तोम्बु बाणावहु, एक तार केरता, एक मुसान केरता, एने एक एलियान केरता।” <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />पतरसाह मालुम नाह एतो काय तो काय केणे बाजरिनोह, काहाकाय ता जुलूम बिय जायेल एता।<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">9:7 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 3:17">मत्ती 3:17</ref>; <ref loc="MRK 1:11">मरकुस 1:11</ref>; <ref loc="LUK 3:22">लुका 3:22</ref></char>
    </note>तेवी एक वादेल ताह साव लेदो, एने वादलाम रेन ज्यो बोल होमलानो, “ज्यो मारो मोंगाल्लो बिटोख हे, ज्यान वातु हुमलो।” <verse eid="MRK 9:7" /><verse number="8" style="v" sid="MRK 9:8" />तेवी ता एकाणावणेच कावदेन नेजेर टाक्या; एने यीशुह सोड़ीन ता कुणीच नाह देख्या।<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />बोयड़ा पोर रेन उतरने बुखेत यीशु चेलाह उकुम आप्यो, “जाह वोर मी माणहान बिटोख मोरीन जीव नाय उठु, ताह वोर जो काय तुमू दिखेल हेते तो कुणीह मा किहो।”<verse eid="MRK 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10" />ता यीशुन उकुम मान लेदा, पुण एका दिहरा हेऱ्या वातु केरने बाज गीया, “मुरेल माय रेन जीव उठणेन काय मतलब हे?” <verse eid="MRK 9:10" /><verse number="11" style="v" sid="MRK 9:11" /><note caller="+" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="MAT 11:14">मत्ती 11:14</ref></char></note>एने चेला यीशुह फुशा, “देरेमगुरू इही काहा केतेह काय एलियान पेल आवणो जोरवरी हे?”<verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />यीशु चेलाह जापाप आप्यो, “एलिया आखो हुदारनेन केरता पेल आवी। पुण माणहान बेटाख ने बाराम ज्य काहा लिखेल हे काय तो जुलूम दुख वेठी एने नेचो गेणाय जाय? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />पुण मी तुमूह केथु काय एलिया ते आव लागेल हे, जीह केरीन तान बाराम बोगवानान वचना माय लिखेल हे, तिहेस केरीन जो काय माणहे होदताला ता हेऱ्या केऱ्या।”<verse eid="MRK 9:13" /></para>
  <para style="s">यीशु बुतड़ो लागेल सोराह हुदारने</para>
  <para style="r">(<ref loc="MAT 17:14-21">मत्ती 17:14-21</ref>; <ref loc="LUK 9:37-43">लुका 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />जेवी यीशु चेला फाय आवो, ते दिख्यो काय तान कावदेन जुलूम गेरदी टोलवाय रेनीह, एने देरेमगुरू चेला हेऱ्या बोलचाल केरने बाजरेनाह। <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />जेवी माणहे यीशुह देख्या, तेवी आखा बोंगलाय गीया, एने नमस्‍कार केरनेन केरता तान उगे आखा दोवड़ना। <verse eid="MRK 9:15" /><verse number="16" style="v" sid="MRK 9:16" />यीशु तान चेलाह फुशो, “तुमू न्या हेऱ्या काहा बोलचाल केरतेह?”<verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />गेरदी माय रेन एक जाण यीशुह जापाप आप्यो, “एय गुरू, मी मार सोराह तुवा फाय लावोह, काहाकाय ता माय मुको बुत रिग रिनोह एने तो बोल नाह सिकेत। <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />जेवी ज्यो बुतड़ो ता पोर हमलो किरेह, ताह बुई पोर आचटी दिथे, एने तान मुया माय रेन फेचे निकेलने बाज जाथे, एने दात केकड़ावेह, एने हुकते जाथे। मी तारा चेलाह कियेल काय तुमू ताह काड़ दिवो, पुण ता बुतड़ाह काड़ नाह सेक्‍या।”<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />ज्यो होमलीन यीशु चेलाह केयो, “एय अविश्वासी माणहे! मी केवीह वोर तुमू हिऱ्यो रेह? एने तुमरी वेठुह? सोराह मार फाय लावो!” <verse eid="MRK 9:19" /><verse number="20" style="v" sid="MRK 9:20" />तेवी ता सोराह यीशु फाय लावा।</para>
  <para style="p" vid="MRK 9:20">जेवी यीशुह ताह दिख्यो ते बुतड़ो चालोच मोंहदेलीन सोराह बुई पोर आचटी दिनो, एने तान मुया माय रेन फेचे वोयणे बाज गीया, एने तो लोलने बाज गीयो।<verse eid="MRK 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 9:21" />यीशु तान आबाख फुशो, “ज्यान ज्यी देशा केवीह रेन हे?”</para>
  <para style="p" vid="MRK 9:21">तो यीशुह जापाप आप्यो, “आत्योच रेन हे।” <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />“एने ज्याह मारनेन केरता केदी आक्‍ठा माय ते केदी पाण्याम पाड़ीह। पुण केदी तु काह केर सिकेह ते आमु पोर गीण केरीन आमरी मोदेक केर!”<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />यीशु ताह केयो, “तु केर सिकेह! ज्यी काय वात हे? बुरहो केरनारान केरता आखो एय सिकेह।”<verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />सोरान आबोख रेड़ीन केयो, “मी बुरहो केरथु, पुण पुरो नाह सुतो। मार बुरहो वोड़नेन केरता मार मोदेक किर!”<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />जेवी यीशु दिख्यो काय गेरदी जुलूम एय गियीह, केरीन ता बुतड़ाह दोपकाड़ीन केयो, “मुका बुतड़ा, मी तुवाह उकुम आपथु, ज्या माय रेन निकेल जा, एने पुशो केदी मा रिगहे!”<verse eid="MRK 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26" />तेवी बुतड़ो आयड़ीन ताह जुलूम मोहदेलीन निकेल गीयो, एने तो सोरो मुरेल ने गेत एय गीयो, एने आखा माणहे केया, “सोरो मोर जायेल हे!” <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />पुण यीशु ताह आथ देरीन उब रेणेन मोदेक किऱ्यो, एने तो उबरी गीयो।<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />जेवी यीशु गेराम आवो, तेवी चेला कुवालाच जाईन ताह फुशा, “आमु बुतड़ाह बाहेर काहा नाह काड़ सेक्‍या?”<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />यीशु चेलाह केयो, “ज्यी जात विन्ता केऱ्या बिगेर नाह निकेलने।”<verse eid="MRK 9:29" /></para>
  <para style="s">यीशु तान मोतीन बाराम पुशो जाणाव केरने</para>
  <para style="r">(<ref loc="MAT 17:22">मत्ती 17:22</ref>,<ref loc="MAT 17:23">23</ref>; <ref loc="LUK 9:43-45">लुका 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />यीशु एने तान चेला ता रेन निकलीन गेलील माय लागतोस जाणे बाजरियेल ईतो। यीशु ज्य नाह होदतालो काय कुणीह बी ज्यी यात्रान बाराम मालुम पोड़ी, <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />काहाकाय यीशु तान चेलाह हिकाड़तालो एने ताह केतालो, “माणहान बिटोख मी, माणहान आथाम देराय जाह, ता माहु मार टाकती। एने मी मोरीन तीन दिह्यान पासाण पुशो जीव जाह।”<verse eid="MRK 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 9:32" />पुण ताह सोमेज माय नाह आवो काय ज्या हिकवोणान मतलब काय हे, एने ता यीशुह फुसणेन बिताला।<verse eid="MRK 9:32" /></para>
  <para style="s">आखाम रेन मोठो कुण?</para>
  <para style="r">(<ref loc="MAT 18:1-5">मत्ती 18:1-5</ref>; <ref loc="LUK 9:46-48">लुका 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />ओवता ता कफरनहूम माय आवा, एने गेरान माय जाणेन बाद यीशु तान चेलाह फुशो, “वाटे तुमू काल्ली वाती पोर बोलचाल केरताला?”<verse eid="MRK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 9:34" />
    <note caller="+" style="x">
      <char style="xo" closed="false">9:34 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 22:24">लुका 22:24</ref>
      </char>
    </note>पुण चेला ठावकाच रेना, काहाकाय वाटे ता ज्यो बोलचाल केरताला काय आपु माय रेन मोठो कुण हे। <verse eid="MRK 9:34" /><verse number="35" style="v" sid="MRK 9:35" /><note caller="+" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="MAT 20:26">मत्ती 20:26</ref>,<ref loc="MAT 20:27">27</ref>; <ref loc="MAT 23:11">23:11</ref>; <ref loc="MRK 10:43">मरकुस 10:43</ref>,<ref loc="MRK 10:44">44</ref>; <ref loc="LUK 22:26">लुका 22:26</ref></char></note>तेवी यीशु बारा चेलाह हादिन केयो, “जो कुण मोठो बोणने हुदेह, तो पेल आत्यो एने आखान पावोर बोणी।” <verse eid="MRK 9:35" /><verse number="36" style="v" sid="MRK 9:36" />एने यीशु एक सोराह हादिन तान विची माय उबो किऱ्यो, एने तान खोलाम लेन ताह केयो, <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" /><note caller="+" style="x"><char style="xo" closed="false">9:37 </char><char style="xt" closed="false"><ref loc="MAT 10:40">मत्ती 10:40</ref>; <ref loc="LUK 10:16">लुका 10:16</ref>; <ref loc="JHN 13:20">योहान 13:20</ref></char></note>“जो कुण ओहला सोराह मार नावाम स्वीकार किरेह; तो माहु स्वीकार किरेह, एने जो कुण माहु स्वीकार किरेह, तो माहु मोकेलनाराह स्वीकार किरेह।”<verse eid="MRK 9:37" /></para>
  <para style="s">जो विरोद माय नाह सोतो तो आपणे उगे हे</para>
  <para style="r">(<ref loc="LUK 9:49-50">लुका 9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />योहान यीशुह केयो, “एय गुरू, आमु एक माणहाह तारो नाव लेन बुतड़ाह काड़तालो देखीन रोक्‍या, काहाकाय तो आपणो हाती नाह ईतो।”<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />यीशु ताह केयो, “ताह मा रूको, काहाकाय जो कुण बी मार नावान चोमेत्कार ने काम नाय केरी, तो चालोच मार बाराम खाराब वातु केय सिकेह।” <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" /><note caller="+" style="x"><char style="xo" closed="false">9:40 </char><char style="xt" closed="false"><ref loc="MAT 12:30">मत्ती 12:30</ref>; <ref loc="LUK 11:23">लुका 11:23</ref></char></note>काहाकाय तो माणुह आपणे विरोद माय नाह सोतो, पुण आपणो हाती हे। <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" /><note caller="+" style="x"><char style="xo" closed="false">9:41 </char><char style="xt" closed="false"><ref loc="MAT 10:42">मत्ती 10:42</ref></char></note>जो कुण तुमूह मसी हेते केरीन एक कुलह्यो पाणी पिवाड़ी, ते मी तुमूह खेरीच केथु काय तान फोल केदी वाये नाय जाय।<verse eid="MRK 9:41" /></para>
  <para style="s">ठोकर ने कारेण बोणने</para>
  <para style="r">(<ref loc="MAT 18:6-9">मत्ती 18:6-9</ref>; <ref loc="LUK 17:1-2">लुका 17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />एने जो कुण न्या आत्याम रेन जा मार पोर बुरहो केरतेह, ता एगदाह ठोकरा खावाड़ी ते, तानकेरता हाजो ज्य हे काय एक मोटली गेरटीन पुड़ तान गेला माय बांदिन तो देरीयाम टाकाय जाय। <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" /><note caller="+" style="x"><char style="xo" closed="false">9:43 </char><char style="xt" closed="false"><ref loc="MAT 5:30">मत्ती 5:30</ref></char></note>केदी तारो आथ तुवाह पाप केरावतेय, ते ताह तोड़ दे। हाजो ज्य हे काय आथ पांगो एन हेरगाम जाणे तार केरता हाजो हे काय दुय आथ एन बी नेरगान आक्‍ठा माय टाकाय जाय, जाहरी आक्‍ठो केदी नाह ओलाणे। <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />जाहरी किड़ा नाह मोरनु, एने आक्‍ठो केदी नाह ओलाणे।<note caller="+" style="f"><char style="fr" closed="false">9:44 </char><char style="ft" closed="false">थोड़ाक लेख माय ज्यो वचन नाह जुड़ेत।</char></note> <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />केदी तारो पाय तुवाह पाप केरावतेय, ते ताह तोड़ दे! लेंगड़ो एन हेरगाम जाणे तार केरता हाजो ज्य हे काय दुय पाय एन बी नेरगान आक्‍ठो माय टाकाय जाय। <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />जा किड़ा नाह मोरनु, एने आक्‍ठो केदी नाह ओलाणे।<note caller="+" style="f"><char style="fr" closed="false">9:46 </char><char style="ft" closed="false">थोड़ाक लेख माय ज्यो वचन नाह जुड़ेत </char></note> <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" /><note caller="+" style="x"><char style="xo" closed="false">9:47 </char><char style="xt" closed="false"><ref loc="MAT 5:29">मत्ती 5:29</ref></char></note>केदी तारा डोला तुवाह पाप केरावतेय, ते ताह काड़ दे! बाडालो एन बी बोगवानान राज माय जाणे हाजो हे काय दुय डोला लेन बी तु नेरगान आक्‍ठा माय टाकाय जाय। <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />जाहरी तान किड़ा केदी नाह मोरनु, एने आक्‍ठो केदी नाह ओलाणे।<verse eid="MRK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49" />काहाकाय आखा माणहे आक्‍ठा केरीन चोखा केराय जाती, जीह केरीन बोलीह मीठा केरीन खारलो केरनु।<verse eid="MRK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50" />
    <note caller="+" style="x">
      <char style="xo" closed="false">9:50 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:13">मत्ती 5:13</ref>; <ref loc="LUK 14:34">लुका 14:34</ref>,<ref loc="LUK 14:35">35</ref></char>
    </note>“मीठ हाजो हे, पुण केदी मीठान खारलो होवाद जात रेय, ते ताह कायता केरीन पोशा खारलो किरहो? तुमरो जीवणो चोखो मीलो, एने एका दिहरा हेऱ्या सान्ती माय रिवो।”<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s">बायकुह सोड़नेन बाराम यीशुन हिक</para>
  <para style="r">(<ref loc="MAT 19:1-12">मत्ती 19:1-12</ref>; <ref loc="LUK 16:18">लुका 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />यीशु यहुदियान एद्दी सोड़ीन यरदन नेदीन पार आवो। एने गेरदी पोशी यीशुन जागे टोलवाय गियी। एने तान रितीन गेत ताह पुशो हिकाड़ने बाज गीयो।<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />तेवी थोड़ाक फरिसी यीशुह वातु माय फासाड़नेन केरता आवीन ताह फुशा, “आमुह के काय आपणो नेम एक एदम्याह तान बायकुह तलाक आपणेन पारवांगी आपेह?”<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />यीशु ताह जापाप आप्यो, “मुसो तुमूह काल्लो कायदो आपेल हे?”<verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:4 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:31">मत्ती 5:31</ref>
      </char>
    </note>ता यीशुह जापाप आप्या, “मुसो तलाक पोत्रो लेखीन बायकुह सोड़नेन पारवांगी आपेल हे।”<verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />पुण यीशु ताह केयो, “मुसो ज्‍यु कायदो तुमरी केरता लिखेल हे, काहाकाय तुमूह हिकाड़ने जुलूम केठीण हे। <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />पुण केलीन सुरवात रेन जिहकेरीन वचन माय लिखेल हे, ‘बोगवान एदमी एने बायकु केरीन माणहाह बाणायेल हे।’ <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" /><note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="ft" closed="false">थोड़ाक लेख माय तान बायकु हेऱ्यो जोड़ाय जाय जोड़ो हे</char></note>तानकेरता एदमी तान आईख आबाख सोड़ीन आंगेच तान बायकु हिऱ्यो रेय, <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />एने एवी ता दुय एक सेरीर एय जाती। केरीन ता एवी दुय नाह सोता, पुण एक हेते। <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />केरीन जाह बोगवान खुद जुड़ेल हे, ताह माणहे आंगे नाय केरी।”<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />जेवी ता पोशा गेरा माय गीया, तेवी चेला ज्यान बाराम यीशुह पोशा फुशा। <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" /><note caller="+" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="MAT 5:32">मत्ती 5:32</ref>; <ref loc="1CO 7:10">1 कुरिंथीयो 7:10</ref>,<ref loc="1CO 7:11">11</ref></char></note>यीशु चेलाह केयो, “जो कुण तान पेल्‍ली बायकुह सोड़ीन दिहरी बायकु हिऱ्यो वाराड़ किरेह, तो तान पेल्‍ली बायकुन विरोद माय सिनालो किरेह। <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />एने केदी बायकु तीन पेल्ला एदम्याह सोड़ीन दिहरा एदम्या हेरी वाराड़ किरेह, ताहार तीबी पेल्ला एदम्यान विरोद सिनालो किरेह।”<verse eid="MRK 10:12" /></para>
  <para style="s">सोराह बोरकेत आपणे</para>
  <para style="r">(<ref loc="MAT 19:13-15">मत्ती 19:13-15</ref>; <ref loc="LUK 18:15-17">लुका 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />थोड़ाक माणहे सोराह यीशु फाय लावा काय ताह बोरकेत आपी, पुण चेला माणहाह दोपकावणे बाज गीया। <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />यीशु ज्य देखीन रागा माय चेलाह केयो, “सोराह मार फाय आवणे दिवो, ताह मा रूको, काहाकाय बोगवानान राज ओहलाच ने केरता हे। <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" /><note caller="+" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 18:3">मत्ती 18:3</ref></char></note>मी तुमूह खेरीच केथु काय जो कुण बोगवानान राजाह सोरान गेत स्वीकार नाह किरेत, तो बोगवानान राज माय केदी नाय रिग सेकी।” <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />तेवी यीशु सोराह खोलाम लिदो, एने आखा पोर आथ मेलीन ताह बोरकेत आप्यो।<verse eid="MRK 10:16" /></para>
  <para style="s">मालदार जुवान</para>
  <para style="r">(<ref loc="MAT 19:16-30">मत्ती 19:16-30</ref>; <ref loc="LUK 18:18-30">लुका 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />जेवी यीशु ता रेन निकलीन वाटे जाणे बाजरियेल ईतो, तेवी एक माणुह ता फाय दोवड़तीन आवो, एने तान ओंगाण मांड्या पोड़ीन फुशो, “एय हाजाला गुरू, जेलेमक्यो जीवाय सापड़ावणेन केरता मी काय केरू?”<verse eid="MRK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18" />यीशु ताह फुशो, “तु माहु हाजो काहा किथे? बोगवानाह सोड़ीन कुणीच हाजो नाय मीले। <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />तु बोगवानान कायदाह जाणेह: खुन मा किरहे; सिनालो मा किरहे; चोरी मा किरहे; कुणी पोर जुठो आरोप मा लागाड़हे; दुको मा दिहे; आईख आबाख ने मान मिलजे।”<verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />तो यीशुह केयो, “एय गुरू, ज्य सोब मी आत्योच रेन मान्तेन आयेल हे।”<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />यीशु ताह मोंग माय देखीन केयो, “तुवाह एक वातीन जोरेवरी हे। जा एने जो काय तुवा फाय हे ताह वेचीन पोयशा गेरब्याह वाट दे, एने तुवाह हेरगाम मालदेन जुड़ी; उवतो वोलीन आवीन मार पासाण चाल।” <verse eid="MRK 10:21" /><verse number="22" style="v" sid="MRK 10:22" />ज्यी वात होमलीन तो नाराज एय गीयो, एने तो दुखी एन जात रेनो, काहाकाय तो जुलूम मालदार एतो।<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />यीशु कावदेन देखीन तान चेलाह केयो, “मालदार माणहाह बोगवानान राज माय जाणेन केरता जुलूम केठीण हे!”<verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />चेला यीशुन वातु होमलीन जुलूम बोंगलाय गीया, पुण यीशु उंजु ताह केयो, “एय मार सोरा, जा मालदेन पोर बुरहो मेलतेह, तान केरता बोगवानान राज माय जाणेन जुलूम केठीण हे?” <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />बोगवानान राज माय मालमात्याह जाणे रेन उटड़ाह हुईन डोसाम रेन सेरकी जाणे होपो हे। <figure style="fig" alt="Merchant leading a camel outside a city wall and gate" file="hk00041c.tif" size="col" copy="Horace Knowles ©" ref="10:25">हेयरान बितड़ो एने बायणान बाहेर वेपारी उटड़ान आगवाय केरने</figure><verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />चेला ज्य होमलीन जुलूम बोंगलाय गीया एने एका दिहराह फुसणे बाज गीया, “ते ओवतो कुणीन सुटकारो एय सिकेह?”<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />यीशु चेलान उगे सीदो देख्यो एने जापाप आप्यो, “ज्यो माणहान केरता जुलूम केठीण हे, पुण बोगवानान केरता नाह; काहाकाय बोगवानान केरता आखो केठीण नाय मीले।”<verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />पतरस यीशुह केयो, “देख, आमु ते आखो काय सोड़ीन तार पासाण आव लागेल हेते।”<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />यीशु केयो, “मी तुमूह खेरीच केथु काय ओहलो कुण नाह सोतो जो मार एने मारी हाजाली खोबरीन पारचार केरनेन केरता गेर एने बाहख बोणह्युख एने आईख आबाख सोरा पोऱ्याह एने खेतीवाड़ीह सोड़ देनो एय, <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />एने ताह ज्यी दुनिया माय एक होव माप नाय जुड़ी। पुण गेरे, बाहख, बोणह्युख, आयह्युक, सोरा पोऱ्या एने खेतीवाड़ी एने दुख; एने सेताव हेऱ्यो आवता टेम माय जेलेमक्यी जीवाय ताह जुड़ी। <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" /><note caller="+" style="x"><char style="xo" closed="false">10:31 </char><char style="xt" closed="false"><ref loc="MAT 20:16">मत्ती 20:16</ref>; <ref loc="LUK 13:30">लुका 13:30</ref></char></note>पुण जुलूम जा पेल्ला हेते, ता पासाण एय जात, एने जा पासाण हेते ता ओंगाण एय जाती।”<verse eid="MRK 10:31" /></para>
  <para style="s">यीशु तान मोतीन बाराम तिसरी वार जाणाव केरने</para>
  <para style="r">(<ref loc="MAT 20:17-19">मत्ती 20:17-19</ref>; <ref loc="LUK 18:31-34">लुका 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />यीशु एने तान चेला यरूशलेम जाणेन वाटे लाग रियेल एता। एने यीशु चेलान ओंगाण चालने बाजरियेल ईतो, चेला बोंगलाय रियेल एता; एने जा माणहे तान पासाण चालताला ता बियेल एता। एक वारीन यीशु पुशो ता बारा चेलाह आंगेच ली गीयो एने ताह त्यु वातु केणे बाज गीयो, जी ता पोर आवणी एती, <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />“हुमलो, आपु यरूशलेम माय जातेह, एने माहु माणहान बेटाख मुखी चाकऱ्या एने देरेमगुरून आथाम होप देती। ता माहु मारनेन ठेरावती एने बिगेर यहुदिन आथाम होपती। <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />ता आखा मारी ईजुत लेती, माहु पोर थुपती, माहु चापका केरीन देती, एने माहु मारती; पुण मी तीन दिह्यान पासाण जीव उठुह।”<verse eid="MRK 10:34" /></para>
  <para style="s">याकुब एने योहानान विन्ता</para>
  <para style="r">(<ref loc="MAT 20:20-28">मत्ती 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />तेवी जब्दीन सोरा याकुब एने योहान यीशु फाय आवीन केया, “एय गुरू, आमरी मोरजी ज्यी हे काय जो आमु तुवा फाय मांगहु, तो तु आमरी केरता केर।”<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />यीशु ताह फुशो, “तुमूह काय जुवे काय मी तुमरी केरता केरू?”<verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />ता यीशुह जापाप आप्या, “आमरी ज्यी मोरजी हे काय जेवी तारी बोड़ाय एणेन टेम माय आमु माय रेन एक तारे डाखरे उगे एने एक तारे जीवड़े उगे बोह सेकी।”<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:38 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 12:50">लुका 12:50</ref>
      </char>
    </note>यीशु ताह केयो, “तुमूह ज्य मालुम नाह सोतो काय तुमू काय मांगतेह। जो दुखान वाटको मी पिण्यो हे काय तुमू पिय सिकहो? एने जो मोतीन बपतीस्मा मी लिण्यो हे काय तुमू लेय सेकतेह?”<verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />ता यीशुह जापाप आप्या, “आमु लेय सेकतेह।”</para>
  <para style="p" vid="MRK 10:39">यीशु ताह केयो, “जो दुखान पियालो मी पिण्यो हे तुमूह बी पिणे पोड़ी; एने जो बपतीस्मा मी लिण्यो हे, तो तुमूह बी लेणे पोड़ी। <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />पुण कुणीह बी मार डाखरे एने जीवड़े उगे बोहाड़नेन मार आदिकार नाय मीले, ज्य तान केरता होमालीन मीलेल हे, जाह बोगवान निवाड़ेन तियार किरेल हे।”<verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />जेवी बाकीन दोह चेला ज्यी वात होमल्या, ते ता याकुब एने योहान पोर रागाय गीया। <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" /><note caller="+" style="x"><char style="xo" closed="false">10:42 </char><char style="xt" closed="false"><ref loc="LUK 22:25">लुका 22:25</ref>,<ref loc="LUK 22:26">26</ref></char></note>केरीन यीशु आखा चेलाह आहने हादिन केयो, “तुमू जाणतेह काय जा बिगेर यहुदिन आदिकारी सोमजाय जातेह, ता फाय ताकेत हे, एने आदिकारीह ता पोर पुरो आदिकार हे। <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" /><note caller="+" style="x"><char style="xo" closed="false">10:43 </char><char style="xt" closed="false"><ref loc="MAT 23:11">मत्ती 23:11</ref>; <ref loc="MRK 9:35">मरकुस 9:35</ref>; <ref loc="LUK 22:26">लुका 22:26</ref></char></note>पुण तुमरे माय ओहलो नाह सोतो, जो कुण तुमरे माय मोठो बोणने हुदेह, तो तुमरो आखान पावोर बोणी; <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />एने जो कुण तुमरे माय मुखी बोणने होदि, तो आखान पावोर बोणी। <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />काहाकाय मी माणहान बिटोख ज्यानकेरता नाह आवो काय मारी सेवा चाकरी केरावु; पुण ज्यानकेरता आयेल हे काय मी दिहरान चाकरी केरू एने जुलूम जाणाह सोड़ेवणेन केरता मारो जीव आपु।”<verse eid="MRK 10:45" /></para>
  <para style="s">आंदला बरतीमाईह देखतो केरने</para>
  <para style="r">(<ref loc="MAT 20:29-34">मत्ती 20:29-34</ref>; <ref loc="LUK 18:35-43">लुका 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />ज्यान पासाण ता यरीहो गावा माय पोचना, जेवी यीशु तान चेला एने एक माणहान होवटाली गेरदी हेऱ्यो यरीहो रेन बाहेर जाणे बाजरियेल ईतो, तेवी ताह वाटीन मीरे बोह रियेल एक आंदलो बिखारी मिलनो, तान नाव बरतीमाई एने तान आबोख तीमाई ईतो। <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />जेवी ताह ज्य मालुम एनो काय यीशु नासरी हे, तो आयड़ीन केयो, “एय दाऊदान सोरा यीशु! मार पोर गीण केर!”<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />जुलूम माणहे ताह जोर केऱ्या काय ठावको रेय। पुण तो उंजु जोरेस आयेड़ने बाज गीयो, “एय दाऊदान सोरा, मार पोर गीण केर!”<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />तेवी यीशु उबरीन केयो, “ओयाह माहु फाय लियावो।”</para>
  <para style="p" vid="MRK 10:49">केरीन माणहे आंदलाह हादिन केया, “ईमोत मेल! उठ, तो तुवाह हादिह।”<verse eid="MRK 10:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 10:50" />आंदलो माणुह तान फाड़का टाकीन कुदिन उबरेय गीयो, एने यीशु फाय आवो।<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />एने यीशु आंदलाह फुशो, “तुवाह मार फाय रेन काय जुवे?”</para>
  <para style="p" vid="MRK 10:51">आंदलो यीशुह जापाप आप्यो, “एय गुरू, मी पुशो देखणे बाज जाव।”<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />यीशु आंदलाह केयो, “जातरे, तारो बुरहो तुवाह हुदार दियेल हे।”</para>
  <para style="p" vid="MRK 10:52">आंदलो चालोच देखणे बाज गीयो एने वाटे यीशुन पासाण चाल पोड़नो।<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">यरूशलेम माय जिकीन रिगणो</para>
  <para style="r">(<ref loc="MAT 21:1-11">मत्ती 21:1-11</ref>; <ref loc="LUK 19:28-40">लुका 19:28-40</ref>; <ref loc="JHN 12:12-19">योहान 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />जेवी ता यरूशलेम ने आहने, जेतुन नावान बोयड़ा पोर बेथफगे एने बेतनिया गावान आहने आवा। ते यीशु तान चेला माय रेन दुय जाणाह ज्य सोमजाड़ीन मुकेल दिनो, <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />“तुमू सोमोरल्या गावा माय जावो, एने ता पोचताच तुमूह एक गेदड़ान पिलो बांद मिलेन जुड़ी, ता पोर एवी वोर कुणूस बुहील नाह सोतो। ताह सोड़ीन मार फाय लीयावज्यो। <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" /><note caller="+" style="f"><char style="fr" closed="false">11:3 </char><char style="ft" closed="false">मालीक; नाहते तान मालीक</char></note>केदी तुमूह ईखेह फुसी, ज्याह काहा सोड़तेह? ताहार तुमू ताह ज्य किज्यो, मालीकाह ज्यान गिरेज हे, एने तो चालोच ज्याह न्या लीयावणे देय।”<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />केरीन चेला जाईन गेदड़ान पिलाह बाहेर बायणा हेऱ्या खोली माय बांदिल देख्या, एने चेला ताह सोड़ने बाज गीया। <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />ताहरी उबरियेल थोड़ाक माणहे ज्य देखीन फुशा, “ज्या गेदड़ान पिलाह काहा सोड़तेह?”<verse eid="MRK 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 11:6" />जिहकेरीन यीशु कियेल ईतो, चेला तिहेच केरीन ताह केय देना, तेवी माणहे पिलाह ली जाणे देना। <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />चेला गेदड़ान पिलाह यीशु फाय लीयावा, ता पोर तान फाड़का टाक देना, एने यीशु ता पोर बोह गीयो। <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />तेवी जुलूम होवटा माणहे तान फाड़का वाटे आथरी देना, एने थोड़ाक माणहे खेताम रेन जाड़ान डालख्यु काटीन वाटी पोर पोसराव देना। <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />आखा माणहे जा यीशुन ओंगाण ओंगाण एने पासाण पासाण चालताला ता आयेड़ने बाज गीया, “बोगवानान बोड़ाय किरो! बोगवान ताह बोरकेत आपी जो मालीक ने नाव लेन आवीह! <verse eid="MRK 11:9" /><verse number="10" style="v" sid="MRK 11:10" />बोगवान आमरो आबोख! दाऊद ने आवणार राजाह बोरकेत आपी, बोगवानान बोड़ाय एय!”<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />यीशु यरूशलेम माय पोचनो एने मोंदिर माय आवो, एने ताहरी कावदेन आखा सोमानाह हास केरीन दिख्यो। पुण हांज एय जायेल एती केरीन बारा चेला हिऱ्यो बेतनिया गावाम जात रिनो।<verse eid="MRK 11:11" /></para>
  <para style="s">यीशु अंजीरान जाड़ाह हाराप देणो</para>
  <para style="r">(<ref loc="MAT 21:18">मत्ती 21:18</ref>,<ref loc="MAT 21:19">19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />दिहरे दिह जेवी ता बेतनिया माय रेन वोलना, तेवी यीशुह बुख लागी। <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />यीशु सिटोच रेन अंजीरान एक निलोगार जाड़ देखीन आहने आवो काय काह जुड़ जाय। पुण पाला सावाय कायच नाह जुड़नो, काहाकाय फोल लागणेन टेम नाह एतो।<verse eid="MRK 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 11:14" />तेवी यीशु जाड़ाह केयो, “एवी रेन कुणीच बी तारो फोल केदीच नाय खाय!”</para>
  <para style="p" vid="MRK 11:14">एने तान चेला ज्य होमेलने बाजरियेल एता।<verse eid="MRK 11:14" /></para>
  <para style="s">मोंदिर माय रेन वेपार केरनाराह निकालनो</para>
  <para style="r">(<ref loc="MAT 21:12-17">मत्ती 21:12-17</ref>; <ref loc="LUK 19:45-48">लुका 19:45-48</ref>; <ref loc="JHN 2:13-22">योहान 2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />जेवी ता यरूशलेम माय आवा, यीशु मोंदिर माय जाईन ता आखा माणहाह बाहेर काड़ने बाज गीयो जा लेन देन केरताला। तो पोयशा बोदेलनारान एने पेरवा वेचणारान पाटलाह उलटाव दिनो, <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />एने कुणीह बी मोंदिर माय रेन सोमान लेन आवणे जाणे नाह दिनो। <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />तो माणहाह हिकाड़तेन केयो, “वचन माय ज्य नाह लिखेल सोतो, ‘मार मोंदिर आखी जातीन माणहान केरता विन्तान गेर रेय।’ पुण तुमू ज्याह डाकुन पाड़ावो बाणाव मेल्याह!”<verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />ज्य होमलीन बोगवानान मुखी चाकऱ्या एने देरेमगुरू यीशुह मारनेन टेम होदणे बाज गीया। ता यीशुह बिताला, काहाकाय आखा माणहे यीशुन हिकवोण होमलीन बोंगलाय जाताला।<verse eid="MRK 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19" />जेवी हांज एनी, यीशु एने तान चेला हेयराम रेन बाहेर जात रेना।<verse eid="MRK 11:19" /></para>
  <para style="s">हुकेल अंजीरान जाड़ा पोर रेन हिकवोण</para>
  <para style="r">(<ref loc="MAT 21:20-22">मत्ती 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />उठ्यान वेगाच, जेवी ता ता रेन आवणे बाजरियेल एता, तेवी चेला अंजीरान जाड़ाह उपेर रेन ते मुलाम वोर हुकेल देख्या। <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />पतरसाह ती वात एर आवी, एने तो यीशुह केयो, “एय गुरू, देख! ज्यो अंजीरान जाड़ जाह तु हाराप दियेल ईतो, हुक जायेल हे!”<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />यीशु ताह जापाप आप्यो, “बोगवाना पोर बुरहो मीलो। <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" /><note caller="+" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="MAT 17:20">मत्ती 17:20</ref>; <ref loc="1CO 13:2">1 कुरिंथीयो 13:2</ref></char></note>मी तुमूह खेरीच केथु काय जो कुण बिगेर सेंका माय ज्या बोयड़ाह केय, तु उखील जा, एने देरीया माय जाय पोड़, पुण जो आपणा मोना माय बुरहो केरी एय जाय, ताहार तान केरता तो एय जाय। <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />केरीन मी तुमूह केथु, ‘जेवी तुमू विन्ता केरतेह एने काह मांगतेह, बुरहो किर लिवो काय तुमूह तो जुड़ जायेल हे, एने जो बी तुमू मांगतेह, तो तुमरी केरता एय जाय। <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" /><note caller="+" style="x"><char style="xo" closed="false">11:25 </char><char style="xt" closed="false"><ref loc="MAT 6:14">मत्ती 6:14</ref>,<ref loc="MAT 6:15">15</ref></char></note>एने जेवी तुमू उबरीन विन्ता किरहो ते केदी तुमरे मोना माय एगदान बाराम काह खोट एय ते माफ किरो, तानकेरता काय तुमरो हेरगावालो आबोख बोगवान बी तुमरो गुनो माफ केरी। <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />एने केदी तुमू माप नाय किरहो, ते तुमरो आबोख बी जो हेरगा माय हे, तुमरो गुनो माफ नाय केरी।’”<note caller="+" style="f"><char style="fr" closed="false">11:26 </char><char style="fq" closed="false">एने केदी तुमू माप नाय किरहो, ते तुमरो आबोख बी जो हेरगा माय हे, तुमरो गुनो माफ नाय केरी। </char><char style="ft" closed="false">थोड़ाक पुस्तेक माय ज्यो वचन जुड़ेल हे।</char></note><verse eid="MRK 11:26" /></para>
  <para style="s">यीशुन आदिकारा पोर सावाल</para>
  <para style="r">(<ref loc="MAT 21:23-27">मत्ती 21:23-27</ref>; <ref loc="LUK 20:1-8">लुका 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />ता यरूशलेम माय पोशा एक वारीन आवा। जेवी यीशु मोंदिर माय फिरने बाजरियेल ईतो, तेवी मुखी चाकर्‍यो, देरेमगुरू, एने डायला यीशु फाय आवा, <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />एने फुसणे बाज गीया, “तुवाह ज्य काम केरनेन काय आदिकार हे? ज्यो आदिकार तुवाह कुण आपेल हे?”<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />यीशु ताह जापाप आप्यो, “मी बी तुमूह एक सावाल फुसथो, माहु जापाप आप सिकहो, ते मी तुमूह केय देह काय ज्यो काम काल्ला आदिकार माय केरथु। <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />योहानाह बपतीस्मा केरनेन आदिकार कुणी उगे रेन एतो: बोगवानान उगे रेन काय माणहान उगे रेन एतो? माहु जापाप आपो।”<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />ता आपसाम विचार केरने बाज गीया: “आपु काय केहु? केदी आपु केहु, ‘बोगवानान उगे रेन एतो, ताहार केय, तुमू योहान पोर बुरहो काहा नाह केऱ्या?’ <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />केदी आपु ज्य केहु, ‘माणहान उगे रेन एतो।’” ता माणहाह बिताला, काहाकाय माणहाह मालुम एतो काय योहान खेरीच जाणकार हे।<verse eid="MRK 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 11:33" />ता यीशुह जापाप आप्या, “आमुह नाह मालुम,”</para>
  <para style="p" vid="MRK 11:33">यीशु ताह केयो, “मी बी तुमूह नाह केत काय ज्य काम मी काल्ला आदिकार माय केरथु।”<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">अंगुरान खेतान किस्सो</para>
  <para style="r">(<ref loc="MAT 21:33-46">मत्ती 21:33-46</ref>; <ref loc="LUK 20:9-19">लुका 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />ओवतो यीशु ताह किस्सो केयीन हिकाड़ने बाज गीयो: “एक माणुह अंगुरान खेत केऱ्यो, कावदेन वाड़ बांद्यो एने रोहान केरता कुडो बाणायो। एने मालो बाणावीन किरसाणाह खेतान ठिको आपीन दिहरा देसाम जात रिनो। <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />जेवी अंगुरान फोलान टेम आव लागो, तेवी मालीक फोलान ईसो लेणेन केरता एक पावराह किरसाण फाय मुकल्यो। <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />पुण किरसाण ता पावराह देर लेदा, एने जुलूम देना, एने ठाल्ले आथे वोलाव देना। <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />ओवतो मालीक पुशो एक पावराह मुकल्यो; किरसाण तान मुंड फोड़ देना एने तान ईजुत लेदा। <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />मालीक पुशो एका पावराह मुकल्यो, ता ताह मार देना एने इहीचकेरीन दिहरा मोकतास जाणाह मुकल्यो; ता माय रेन थोड़ाक जाणाह देना, एने थोड़ाक मार देना। <verse eid="MRK 12:5" /><verse number="6" style="v" sid="MRK 12:6" />एवी मोकेलनेन केरता मालीक्या फाय एकुच रेय जायेल ईतो, तान मोंगाल्लो बिटोख ईतो। सेवली बुखेत ताह बी ता फाय मोकेल दिनो। तान ज्यो विचार एतो, ‘मार सोरान ता मान मेलती।’ <verse eid="MRK 12:6" /><verse number="7" style="v" sid="MRK 12:7" />पुण किरसाण एका दिहराह केया, ‘ज्यो ते मालीक ने बिटोख हे। केदी आपु ज्याह मार देहु, ताहार ज्य मालदेन आपणोच एय जाय!’ <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />केरीन किरसाण ताह देरीन मार देना, एने अंगुर ने खेतान बाहेर तान देड़ टाक देना।”<verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />यीशु ताह फुशो, “एवी अंगुरान खेतान मालीक काय केरी?” तो आवीन ता किरसाणाह मारी एने अंगुरान खेत दिहराह आप देय। <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />काय तुमू पुस्तेक माय ज्यो बाग नाह वाशा:</para>
  <para style="q1" vid="MRK 12:10">“जा देगड़ाह मिस्तऱ्या कामान नाह जाण्या,</para>
  <para style="q2" vid="MRK 12:10">तोच दिगोड़ कोपरान मुखी बोण गीयो।<verse eid="MRK 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11" />ज्य मालीक ने उगे रेन ईयेल हे;</para>
  <para style="q2" vid="MRK 12:11">एने आपणी नेजेर माय जुलूम मोठो हे!”<verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />तेवी यहुदि नेता यीशुह देरनेन केरता कोसीत केऱ्या, काहाकाय ता सोमजी जायेल एता काय आमरी बाराम ज्यो किस्सो कियेल हे। पुण ता माणहान गेरदीह बिताला, केरीन ता यीशुह सोड़ीन जात रेना।<verse eid="MRK 12:12" /></para>
  <para style="s">फालो आपणेन बाराम सावाल</para>
  <para style="r">(<ref loc="MAT 22:15-22">मत्ती 22:15-22</ref>; <ref loc="LUK 20:20-26">लुका 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />तेवी यीशुह वातु माय फासाड़नेन केरता फरिसी एने राजा हेरोदेसान टोलीन थोड़ाक माणहाह ता फाय मोकल्या। <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />ता यीशु फाय आवीन केया, एय गुरू, आमु जाणतेह काय तु खीरलो हे, एने कुणीन पारवाय नाह केरने। काहाकाय तु माणहान मुय देखीन वातु नाह केरने, पुण बोगवानान वाट खेराय माय हिकाड़ेह। आमुह ज्य कि रोम ने राजाह फालो आपणे नेम ने गेत हे काय नाह? आमु फालो आपज्यो काय नाय?<verse eid="MRK 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 12:15" />पुण यीशु तान कोपेट जाणीन जापाप आप्यो, “तुमू माहु काहा फासाड़नेन कोसीत केरतेह? एक चांदीन सिक्को माहु फाय लावो, एने माहु ताह देखणे दिवो।”<verse eid="MRK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 12:16" />ता यीशु फाय एक सिक्काह लेन आवा, एने यीशु ताह केयो, “ज्या पोर साप एने नाव कुणीन हे?”</para>
  <para style="p" vid="MRK 12:16">ता जापाप आप्या, “रोम ने राजान हे।”<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />यीशु ताह केयो, “जो रोम ने राजान हे तो रोम ने राजाह, एने जो बोगवानान हे तो बोगवानाह आपो।” एने ता ज्य होमलीन बोंगलाय गीया।<verse eid="MRK 12:17" /></para>
  <para style="s">मुरेल माय रेन जीव उठणेन बाराम सावाल</para>
  <para style="r">(<ref loc="MAT 22:23-33">मत्ती 22:23-33</ref>; <ref loc="LUK 20:27-40">लुका 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:18 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 23:8">प्रेरितान काम 23:8</ref>
      </char>
    </note>थोड़ाक सदुकी यीशु फाय आवा, तान मान्ने ज्य एतो काय मुरेल माणहान जीव उठणो नाह सोतो, ता यीशुह फुशा, <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />“एय गुरू, मुसा आपणी केरता नेम आपेल हे: ‘केदी कुणीन बी बाहख बिगेर सोरान मोर जाय, एने तान बायकु रेय जाय, ते तान बाहख ती बायकु हिऱ्यो वाराड़ केर लेय एने बायाख ने केरता वोच पायदा केरी।’ <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />हात बाहख एता; तेवी पेल्ला बायाख ने वाराड़ एय गीयो एने बिगेर सोरान मोर गीयो। <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />तेवी दुसरो बाहख बी ती बायकु हिऱ्यो वाराड़ किऱ्यो, एने बिगेर सोराच ने मोर गीयो। तीसरो बाहख बी इहीचकेरीन किऱ्यो। <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />इहकेरीन हातु बाहख बी बिगेर सोरान मोर गीया। तान पासाण ती बायकु बी मोर गियी। <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />पोशो जीव उठणेन बाद ती कुणीन लाडी रेय? काहाकाय ती हेऱ्या हातु बी वाराड़ किरेल एता।”<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />यीशु ताह जापाप आप्यो, “तुमू जुलूम बुल माय पोड़ रेनाह! एने तुमू काय जाणतेह? तुमू नाह वचनाह जाणतेह, एने नाह बोगवानान ताकेतीह। <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />जेवी माणहे मुरेल माय रेन जीव उठती, तेवी ता हेरगा माय हेरोगदुतान गेत रेती एने वाराड़ नाय केरती। <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />एवी, मुरेल माणहान जीव उठणेन बाराम काय तुमू मुसान पुस्तेक माय हेलगीताला जाड़ान बाराम नाह वाशा? बोगवान मुसाह कियेल, ‘मी अब्राहाम ने बोगवान, इसहाक ने बोगवान, एने याकुब ने बोगवान हे।’ <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />बोगवान मुरेल माणहान नाह, पुण जीवतालान बोगवान हे। तुमू जुलूम चुक रेनाह!”<verse eid="MRK 12:27" /></para>
  <para style="s">आखाम रेन मुखी कायदो</para>
  <para style="r">(<ref loc="MAT 22:34-40">मत्ती 22:34-40</ref>; <ref loc="LUK 10:25-28">लुका 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />तुलेचबूखे एक देरेमगुरू ता रेन जाणे बाजरियेल ईतो एने ताह बोलचाल केरताला होमल्यो। तो ज्यो जाणीन काय यीशु ताह हास केरीन जापाप आपेल हे, केरीन तो आवीन यीशुह सावाल फुशो, “आखाम रेन मुखी कायदो काल्लो हे?”<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />
    <note caller="+" style="f">
      <char style="fr" closed="false">12:29 </char>
      <char style="ft" closed="false">आमरो मालीक जो आमरो बोगवान हे तोस एकमेल मालीक हे; नाहते मालीक ओलोस आमरो बोगवान हे, फोक्‍तो मालीक ओलोस।</char>
    </note>यीशु ताह जापाप आप्यो, “आखाम रेन मुखी कायदो ज्यो हे: ‘एय इस्राएल ने माणहे हुमलो! मालीक तारो बोगवान एकुच हे। <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />एने तु मालीक तारा बोगवानाह तारो आखो मोन लागाड़ीन, एने तारो आखो जीव लागाड़ीन, एने तारी आखी इकेल केरीन, एने तारी आखी ताकेत केरीन मोंग किरजे।’ <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />एने दिहरो मोहत्वान उकुम ज्यो हे: ‘तु तारा आहने रेणाराह मोंग किरजे।’ ज्या दुय कायदाह रेन दिहरो काल्लोस कायदो मुखी नाय मीले।”<verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />तो देरेमगुरू यीशुह केयो, “एय गुरू, जुलूम हाजो! तार केणो कायेम खेरीच हे, तो एकुच बोगवान हे, एने ताह सोड़ीन दिहरो काल्लोस नाय मीले। <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />एने बोगवानाह तारो आखो मोन एने तारी आखी इकेल एने तारी आखी ताकेत केरीन मोंग किरजे, एने आपणा आहने रेणाराह आपणे हारको मोंग केरने आखी बेटीह रेन एने बोलीह रेन वोदार हे।”<verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:34 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:25-28">लुका 10:25-28</ref>
      </char>
    </note>तेवी यीशु दिख्यो काय तो सोमजीन जापाप आपेल हे, केरीन ताह केयो, “तु बोगवानान राजाह रेन सिटो नाय मीले।”</para>
  <para style="p" vid="MRK 12:34">एने कुणीह पोशो ताह काय फुसणेन ईमोत नाह एनी।<verse eid="MRK 12:34" /></para>
  <para style="s">मसीन बाराम सावाल</para>
  <para style="r">(<ref loc="MAT 22:41-46">मत्ती 22:41-46</ref>; <ref loc="LUK 20:41-44">लुका 20:41-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />उवतो यीशु मोंदिर माय हिकाड़ते लेन तान ओंगाण ज्यो सावाल मिल्यो, “देरेमगुरू ज्य काहा केतेह काय मसी दाऊद ने वोस हे? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />काहाकाय दाऊद खुद चोखाला जीवा माय बोरायीन कियेल हे:</para>
  <para style="q1" vid="MRK 12:36">“मालीक बोगवान मार मालीकाह केयो,</para>
  <para style="q2" vid="MRK 12:36">मार जीवड़े उगे बोह</para>
  <para style="q2" vid="MRK 12:36">जाह वोर काय मी तार दुसमोनाह तारा पाया बुंदे नाय केर देव।”<verse eid="MRK 12:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 12:37" />दाऊद ते खुद ताह मालीक किथे; ते मसी तान वोस किहीक एय सिकेह?</para>
  <para style="s" vid="MRK 12:37">देरेमगुरूह रेन जोगवीन रिज्यो</para>
  <para style="r" vid="MRK 12:37">(<ref loc="MAT 23:1-36">मत्ती 23:1-36</ref>; <ref loc="LUK 20:45-47">लुका 20:45-47</ref>)</para>
  <para style="p" vid="MRK 12:37">एने माणहान गेरदी यीशुन वातु खुसी माय होमेलताला। <verse eid="MRK 12:37" /><verse number="38" style="v" sid="MRK 12:38" />यीशु माणहाह हिकाड़ते लेन केयो, “देरेमगुरू हेऱ्या रेन जोगवीन रिज्यो, जा लाम्बा लाम्बा चोगा पेरीन आटा माय फिरनु काय माणहे ताह नमस्‍कार केरी एने तान मान मेली। <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />एने ता बोक्ती केरन्या गेरा माय मुखी जागे एने पोंगेत माय हाजो जागो बी होदतेह। <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />ता रांडायेल बायकुन गेराह ठेगीन लुट लेतेह, एने देखाड़नेन केरता जुलूम वार वोर विन्ता केरती रेतेह। ता होवटो डेंड बोकती!”<verse eid="MRK 12:40" /></para>
  <para style="s">गेरीब रांडायेल बायकुन बेट</para>
  <para style="r">(<ref loc="LUK 21:1-4">लुका 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />यीशु मोंदिर ने बेट केरनेन जागे बोहीन देखणे बाजरियेल ईतो काय माणहे मोंदिर ने दान पेटीम किहीक पोयशा टाकतेह। मोकतास मालदार माणहे जुलूम होवटा पोयशा टाक्या; <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />तेवी एक गेरीब रांडायेल बायकु बी आवीन दुय आना टाक्यी, जान किमोत जुलूम कोमी एती। <verse eid="MRK 12:42" /><verse number="43" style="v" sid="MRK 12:43" />तेवी यीशु तान चेलाह आहने हादिन केयो, “मी तुमूह खेरीच केथु काय मोंदिर ने बेट माय दान पेटीम टाकणाराह रेन ज्यी गेरीब रांडायेल बायकु आखाम रेन वोदार टाकेल हे। <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />काहाकाय मालदार तान वोदार माय रेन थोड़ोक टाकेल हेते; पुण ज्यी तीन गेरबी माय रेन आखो टाक दियेल हे, जो ती फाय एतो।”<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">मोंदिरान ओदेरनेन बाराम जाणाव</para>
  <para style="r">(<ref loc="MAT 24:1">मत्ती 24:1</ref>,<ref loc="MAT 24:2">2</ref>; <ref loc="LUK 21:5">लुका 21:5</ref>,<ref loc="LUK 21:6">6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />जेवी यीशु मोंदिर माय रेन निकेलतालो, तेवी तान चेला माय रेन एक ताह केयो, “एय गुरू! देख, कोहला जुलूम मोटला दिगोड़ एने मोटला आवाल्या हेते!”<verse eid="MRK 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2" />यीशु ताह जापाप आप्यो, “तुमूह ज्या मोटला आवाल्या लागतेह? खेरी ते ज्य हे काय न्या आवाल्यान एक बी दिगोड़ तान जागे नाय रेय; आखा दिगोड़ ओदरी जाती।”<verse eid="MRK 13:2" /></para>
  <para style="s">तेकलीत एने दुख</para>
  <para style="r">(<ref loc="MAT 24:3-14">मत्ती 24:3-14</ref>; <ref loc="LUK 21:7-19">लुका 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />जेवी यीशु जेतुन बोयड़ा पोर रेन मोंदिराह देखणे बाजरियेल ईतो, तेवी पतरस, याकुब, योहान, एने अन्द्रियास ज्या कुवालाच जाईन ताह फुशा। <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />“आमुह के काय ज्‍यु वातु केवीह एती, एने जेवी ज्‍यु आखी वातु पुऱ्यू एणेन आवरेय ती टेम माय काल्ली निसाणी रेय।”<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />तेवी यीशु चेलाह केणे बाज गीयो, “तुमूह कुण बी बोड़कावे नाय केरीन जोगवीन रिवो। <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />जुलूम जाणे मार नाव लेन आवीन केती, ‘मी मसी हे!’ एने जुलूम जाणाह बोड़कावती। <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />जेवी तुमू लेड़ाय एने लेड़ाय ने बाराम होमेलहो, ते मा बिहो। काहाकाय ज्य एणेन जोरेवरी हे, पुण ज्यान मतलब ज्य नाह सोतो काय सेवल्यो टेम आव लागेल हे। <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />देसा हेऱ्या देस लेड़ाती; एने राज ने विरोद राज उठती। जा ता बुकम्प एती, एने काल पोड़ी। जेवी ज्य एय तेवी पिड़ान सुरवात एय जाय।”<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">13:9 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:17-20">मत्ती 10:17-20</ref>; <ref loc="LUK 12:11">लुका 12:11</ref>,<ref loc="LUK 12:12">12</ref></char>
    </note>पुण तुमू जोगवीन रिज्यो। काहाकाय माणहे तुमूह देरीन कोरटा माय ली जाईन होप देती। माणहे तुमूह पोंचा माय देती; तुमूह मार हाजाली खोबरीन केरता राजान एने आदिकारीन ओंगाण उबा केरती काय तान केरता पुरावो रेय। <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />पुण सेवल्यो टेम आवणेन पेल, हाजाली खुबेर आखा देसा माय पारचार केराय जाय। <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />जेवी चोकसी केरनेन केरता तुमूह माणहे देरीन कोरटा माय होपती। तेवी पेलुच चिन्ता मा किरहो काय आमु काय केहु; पुण जो काय तुलबूखे तुमूह केवाय जाय तोच किज्यो। काहाकाय बोलनारे तुमू नाह सोता, पुण चोखालो जीव हे। <verse eid="MRK 13:11" /><verse number="12" style="v" sid="MRK 13:12" />बाहख बायाख मार देय, एने आबोख बेटाख हिऱ्यो बी इहीचकेरीन केरी। सोरा आईख आबाख ने विरोद एय जाती एने ताह माराव देती। <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" /><note caller="+" style="x"><char style="xo" closed="false">13:13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">मत्ती 10:22</ref></char></note>एने तुमू मार पोर बुरहो किरेल हेते, केरीन आखा माणहे तुमू हेऱ्या दुसमोनाय केरती। पुण जो आखरी वोर दिर देरीन मार पोर बुरहो केरी, ताच ने सुटकारो एय।<verse eid="MRK 13:13" /></para>
  <para style="s">मोटली पिड़ा</para>
  <para style="r">(<ref loc="MAT 24:15-28">मत्ती 24:15-28</ref>; <ref loc="LUK 21:20-24">लुका 21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />पुण जेवी तुमू ता उजाड़नार खाराब चिजीह जा हाजो नाह ता उबरियेल दिखहो, “वाचणार सोमजी लेय,” ते जा यहुदिया माय एती ता बोयड़ा पोर नाह जाय; <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" /><note caller="+" style="x"><char style="xo" closed="false">13:15 </char><char style="xt" closed="false"><ref loc="LUK 17:31">लुका 17:31</ref></char></note>जो गेरा पोर एय तो नेचो उतेरनेन केरता टेम नाय गोमाड़ी; <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />एने जो खेताम एय, तो तान फाड़का लेणेन केरता पासाण नाय जाय। <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />ता दिह्या माय जी पेटावाली एने आतल्या सोराह बुजो खावाड़तेय, त्युन केरता हाय, हाय! <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />एने बोगवाना फाय विन्ता किरो काय ज्य हियालान दिह्याम नाय रेय। <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" /><note caller="+" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="REV 7:14">प्रकाशितवाक्य 7:14</ref></char></note>काहाकाय ता दिह ओहला पिड़ान रेती काय दुनियान सुरवात रेन जो बोगवान बाणायेल हे, एवी वोर नाह ते ईयेल एतो एने नाय उंजु केदी एय। <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />केदी बोगवान ता दिह्याह नाय गेटेवतो, ते काल्लोस जेनवार नाय वोचतो; काहाकाय निवाड़ेल माणहान केरता, तो पिड़ान दिह्याह गेटाड़ेल हे।<verse eid="MRK 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21" />ती टेम माय कुण बी तुमूह केय, दिखो, मसी न्या हे, एने दिखो, ता हे, ते बुरहो मा किरहो; <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />काहाकाय जुठा मसी एने जुठा जाणकार उठीन उबरी जाती, एने निसाणी एने सोमेज ने बाहेर चोमेत्कारान काम देखाड़ती काय केदी एय सेकी ते निवाड़ेल हेते ताह बी बोड़काव देती। <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />पुण तुमू जोगवीन रिवो; दिखो, मी तुमूह आखी वातु पेलुच रेन केय दियेल हे।<verse eid="MRK 13:23" /></para>
  <para style="s">माणहान बिटोख यीशु तान पोशो देरती पोर आवणो</para>
  <para style="r">(<ref loc="MAT 24:29-31">मत्ती 24:29-31</ref>; <ref loc="LUK 21:25-28">लुका 21:25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />
    <note caller="+" style="x">
      <char style="xo" closed="false">13:24 </char>
      <char style="xt" closed="false">
        <ref loc="REV 6:12">प्रकाशितवाक्य 6:12</ref>
      </char>
    </note>ता दिह्या माय ती पिड़ान पासाण दिह आदारलो एय जाय, एने चांद उजालो नाय आपी; <verse eid="MRK 13:24" /><verse number="25" style="v" sid="MRK 13:25" /><note caller="+" style="x"><char style="xo" closed="false">13:25 </char><char style="xt" closed="false"><ref loc="REV 6:13">प्रकाशितवाक्य 6:13</ref></char></note>एने जुगाम रेन तारा पोड़ने बाज जाती; एने जुगान ताकेत आलाड़ाय जाय। <verse eid="MRK 13:25" /><verse number="26" style="v" sid="MRK 13:26" /><note caller="+" style="x"><char style="xo" closed="false">13:26 </char><char style="xt" closed="false"><ref loc="REV 1:7">प्रकाशितवाक्य 1:7</ref></char></note>तेवी माणहे माणहान बेटाख मोटली ताकेत एने बोड़ाय हिऱ्यो वादला माय आवतालो देखती। <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />ती टेम तो तान हेरोगदुताह मोकली, एने देरतीन एक कोपरे रेन ते दिहरे कोपरे वोर, कावदेन रेन बोगवानान निवाड़ेल माणहाह एकठा केरी।<verse eid="MRK 13:27" /></para>
  <para style="s">अंजीरान जाड़ान किस्सो</para>
  <para style="r">(<ref loc="MAT 24:32-35">मत्ती 24:32-35</ref>; <ref loc="LUK 21:29-33">लुका 21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />अंजीरान जाड़ाह देखीन ज्यी वात हिको। जेवी तान डाल हुवाली एय जाथे, एने पाला फुटणे बाज जातेह; ते तुमू जाण जातेह काय उनालो आहनेच हे। <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />तिहेच केरीन जेवी तुमू ज्‍यु वातुह एताल्यु दिखहो, ते जाण जाज्यो काय टेम आहनेच हे। <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />मी तुमूह खेरीच केथु जाह वोर ज्‍यु आख्‍यु वातु पुरी नाय एय जाती, ज्यी पिढी खेतेम नाय एय। <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />जुग एने देरती टेल जाय, पुण मार वचन केदी नाय टेली।<verse eid="MRK 13:31" /></para>
  <para style="s">जोगवीन रिवो</para>
  <para style="r">(<ref loc="MAT 24:36-44">मत्ती 24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />
    <note caller="+" style="x">
      <char style="xo" closed="false">13:32 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:36">मत्ती 24:36</ref>
      </char>
    </note>ता दिह्यान एने ती गेड़ीन बाराम कुण नाह जाणेत, नाह हेरगान हेरोगदुत एने नाह बोगवानान बिटोख; पुण आबोख बोगवान ओलोच जाणेह। <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />दिखो, जागताला एने जोगवीन रिवो, काहाकाय तुमू नाह जाणते काय तो टेम केवीह आवी। <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" /><note caller="+" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="LUK 12:36-38">लुका 12:36-38</ref></char></note>ज्य ता माणहान गेत हे जो दिहरा देसाम जाणे बुखेत, तान पावराह गेरान आदिकार आप्यो एने आखाह तान काम केय देन होपीन जागल्याह जागतालो रेणेन उकुम आप्यो। <verse eid="MRK 13:34" /><verse number="35" style="v" sid="MRK 13:35" />तानकेरता जाकता रिवो, काहाकाय तुमू नाह जाणते काय गेरान मालीक कुलबुखे आवी, हांज पोर नाहते आदि राती, नाहते कुकड़ा वाहणेन टेम, नाहते दिह उगणेन पेल। <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />इहकेरीन नाय एणे जुवे काय तो उचकाहुच आवीन तुमूह हुवताला आत केरी। <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />एने जो मी तुमूह केथु तोच आखाह केथु: जागते रिवो।<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">यीशुन विरोद माय चाल</para>
  <para style="r">(<ref loc="MAT 26:5">मत्ती 26:5</ref>; <ref loc="LUK 22:1-2">लुका 22:1-2</ref>; <ref loc="JHN 11:45-53">योहान 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />फसह नावान एने अखमीरी रोटान तिवाराह दुय दिह बाकी रेय जायेल एता; मुखी चाकऱ्या एने देरेमगुरू यीशुह देरावणेन गालो काड़ताला काय ताह किहीक देरहु एने मारहु; <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />पुण ता केताला काय, “तिवारान दिह ओहलो नाय एणे जुवे काय माणहा माय देंग्गो एय जाय।”<verse eid="MRK 14:2" /></para>
  <para style="s">बेतनियाह माय यीशुन संस्‍कार</para>
  <para style="r">(<ref loc="MAT 26:6-13">मत्ती 26:6-13</ref>; <ref loc="JHN 12:1-8">योहान 12:1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">14:3 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 7:37">लुका 7:37</ref>,<ref loc="LUK 7:38">38</ref></char>
    </note>जेवी यीशु बेतनियाह माय शमोन ने गेर रूटो खाणेन बुहेल ईतो जाह पेल कोढ एतो, तेवी एक बायकु दोवल्या देगड़ान सिसी माय चोखो जटामासीन गेंदाण्यो तेल लेन आवी; एने सिसी उगाड़ीन तेल यीशुन मुंडा पोर रोचीव देनी। <verse eid="MRK 14:3" /><verse number="4" style="v" sid="MRK 14:4" />पुण थोड़ाक माणहे नाराज एय गीया एने केया, “ज्य गेंदाण्यो तेल काहा विरखावेह? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" /><note caller="+" style="f"><char style="fr" closed="false">14:5 </char><char style="ft" closed="false">चांदीन सिक्‍का, देखी 6:37।</char></note>काहाकाय ज्याह एक वोरह्या रेन होवटी मोंजरीन किमोत माय वेचीन गेरब्याह वाट देती।” एने ता जुलने बाज गीया। <figure style="fig" alt="Jars with spikenard" file="hk00117c.tif" size="col" copy="Horace Knowles ©" ref="14:3">सिसी माय जटामासीन तेल</figure><verse eid="MRK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6" />यीशु ताह केयो, तीह रेणे दिवो; तीह काहा तारास देतेह? ती मार पोर बोलो किरेल हे। <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />गेरीब जेलेमक्या तुमरी हेऱ्या रेती, एने जेवी तुमू हुदहो ते दिह तुमू ता हेऱ्या बोलो केर सिकहो, पुण मी तुमरी हिऱ्यो जेलेमक्यो नाय रेव। <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />जोलो ती केर सेकताली तो ती किरेल हे, ती माहु बुजणेन पेल मार सेरीर पोर गेंदाण्यो तेल लागाड़ीन तियार किरेल हे। <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />मी तुमूह खेरीच केथु, “आखी केली माय जा का हाजाली खोबरीन पारचार एय, ता ज्यीन ज्या कामान बाराम बी ज्यीन एर केराय जाय।”<verse eid="MRK 14:9" /></para>
  <para style="s">यहुदा यीशुह फरिसीन आथाम होपणे</para>
  <para style="r">(<ref loc="MAT 26:14-16">मत्ती 26:14-16</ref>; <ref loc="LUK 22:3-6">लुका 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />यहुदा इस्‍कोरिती बारा चेलाम रेन एक ईतो, मुखी चाकऱ्या फाय गीयो काय, तान केरता काय तो यीशुह तान आथाम होप सेकी। <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />ता ज्यो होमलीन खुस एय गीया, एने पोयशा आपणेन वायदो केऱ्या, एने यहुदा गालो होदतालो काय यीशुह देराव देव।<verse eid="MRK 14:11" /></para>
  <para style="s">चेला हिऱ्यो यीशु फसह तिवारान सेवल्यो खाणो</para>
  <para style="r">(<ref loc="MAT 26:17-25">मत्ती 26:17-25</ref>; <ref loc="LUK 22:7-14">लुका 22:7-14</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">योहान 13:21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />अखमीरी रोटान तिवारान पेल्ले दिह, जा माय ता मेंड्रान पिलाह फसह केरीन बोली चेड़ावताला, यीशुन चेला ताह फुशा, “तु का हुदेह काय आमु जाईन तार केरता तिवार खाणेन तियारी केरहु?”<verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />यीशु तान चेलाम रेन दुय जाणाह ज्यो केयीन मुकल्यो, “गावाम जावो, एने एक माणुह पाण्यान गुंडो उखलीन तुमूह जुड़ी, तान पासाण जाज्यो; <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />एने तो जा गेराम जाय, ता गेरान मालक्याह किज्यो, गुरू फुसे मार चेला हिऱ्यो फसह तिवारान खाणो खाणेन खोली काहरी हे? <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />तो तुमूह उपेर हिंगारेल एक मोटली खोली देखाड़ देय, एने ताच आखो आपणी केरता तियार किरज्‍यो।”<verse eid="MRK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16" />तेवी चेला ता रेन निकलीन गावाम आवा, एने जिहकेरीन यीशु चेलाह कियेल ईतो, तोहलो देख्या; एने फसह ने तिवारान खाणो तियारी केऱ्या।<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />जेवी हांज पोड़ गियी, तेवी यीशु बारा चेला हिऱ्यो आवो। <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />जेवी ता खाणेन बोह रियेल एता, तेवी यीशु चेलाह केयो, “मी तुमूह खेरीच केथु काय तुमरे माय रेन एक जाण जो मार हिऱ्यो रूटो खाते, तो मार दुसमोनान आथाम होप देय।”<verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />एने चेला नाराज एय गीया एने ता एक एक जाण यीशुह केया, “काय तो मी हे?”<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />यीशु चेलाह जापाप आप्यो, “तुमू बारा जाणाम रेन एक हे, जो मार हिऱ्यो तेलीम आथ टाकेह। <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />काहाकाय मी माणहान बेटाख ने बाराम जिहकेरीन लिखेल हे, तिहेच केरीन ईथे; पुण ता माणहा पोर हाय जान आथा केरीन मी माणहान बिटोख मार दुसमोनाह होपाय जाय। केदी ता माणहान जेल्मोच नाय एतो ते तान केरता हाजो रेतो।”<verse eid="MRK 14:21" /></para>
  <para style="s">मालीकान खाणो</para>
  <para style="r">(<ref loc="MAT 26:30">मत्ती 26:30</ref>; <ref loc="LUK 22:14-20">लुका 22:14-20</ref>; <ref loc="1CO 11:23-25">1 कुरिंथीयो 11:23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />जेवी ता रूटो खाताला, तेवी यीशु रूटो उखलीन बोगवानान दन्यवाद किऱ्यो, एने रूटो मुड़ीन चेलाह आप्यो एने ताह केयो, “लिवो, ज्यो मारो सेरीर हे।”<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />ओवतो यीशु वाटको विसीन दन्यवाद किऱ्यो, एने चेलाह आप्यो; एने आखा चेला तो पिय लेदा। <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" />तेवी यीशु चेलाह केयो, “बोगवानान एने माणहान विचीम नोवाली वायदो देखाड़नेन जी मारी लुय हे, जी जुलूम जाणान केरता वोयाड़ाय जाथे। <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />मी तुमूह खेरीच केथु, ‘अंगुरान रोह ते दिह वोर केदी नाय पिव, जाह वोर बोगवानान राज माय नोवाला अंगुरान रोह नाय पिय लेव।’”<verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />ता गीत गावीन बोगवानान बोड़ाय केऱ्या, ओवता ता बाहेर जेतुन नावान बोयड़ा पोर गीया।<verse eid="MRK 14:26" /></para>
  <para style="s">पतरसान नाकारनेन जाणाव</para>
  <para style="r">(<ref loc="MAT 26:31-35">मत्ती 26:31-35</ref>; <ref loc="LUK 22:31-34">लुका 22:31-34</ref>; <ref loc="JHN 13:36-38">योहान 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />तेवी यीशु चेलाह केयो, “तुमू आखा माहु सोड़ीन नाह जाहो, काहाकाय वचन इहकेरीन किथे, ‘मी गोवालाह मारूह, एने मेंड्रान टुलो जोत तोथा वेराय जाती।’ <verse eid="MRK 14:27" /><verse number="28" style="v" sid="MRK 14:28" /><note caller="+" style="x"><char style="xo" closed="false">14:28 </char><char style="xt" closed="false"><ref loc="MAT 28:16">मत्ती 28:16</ref></char></note>पुण मी जीव उठुह एने ओवतो तुमूह रेन पेल गेलील माय जाह।”<verse eid="MRK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29" />पतरस यीशुह केयो, “केदी आखा तुवाह सोड़ देती, पुण मी तुवाह नाय सोडु।”<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />यीशु पतरसाह जापाप आप्यो, “मी तुवाह खेरीच केथु काय आज रातीच कुकड़ो दुय वारीन वाह देणेन पेल, तु तीन वारीन माहु नाकार हे।”<verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />पुण पतरस उंजु बी पाको बुरहो आपीन केयो, “केदी माहु तार हेऱ्यो मोरने बी पोड़ी, तीबी मी तुवाह नाय नाकारू।” इहीचकेरीन आखा चेला बी केया।<verse eid="MRK 14:31" /></para>
  <para style="s">गतसमनी बोगीचा माय यीशुन विन्ता</para>
  <para style="r">(<ref loc="MAT 26:36-46">मत्ती 26:36-46</ref>; <ref loc="LUK 22:39-46">लुका 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />ओवता ता गतसमनी नावान बोगीचा माय आवा, एने यीशु तान चेलाह केयो, “मी विन्ता केरथु ताह वोर न्या बोह रिवो।” <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />उवतो यीशु पतरस, याकुब एने योहानाह आरही ली गीयो; एने यीशु नाराज एने मोंदड़ालोह एय गीयो, <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />एने यीशु ताह केयो, “मारो मोन जुलूम नाराज हे, न्या वोर काय मी मोरने माय हे: तुमू न्याच रिवो, एने जागताला रिवो।”<verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />ओवतो यीशु थोड़ोक ओंगाण गीयो एने बुई पोर पोड़ीन विन्ता केरने बाज गीयो काय केदी एय सेकी ते ज्यी गेड़ी माहु पोर रेन टेल जाय, <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />एने केणे बाज गीयो, “एय अब्बा, एय आबा, तुवाह आखो काय एय सिकेह; ज्यी पिड़ा माहु पोर रेन सिटो केर दे: तीबी मी होदथु तोहलो नाह, पुण जो तु हुदेह तोच एय।”<verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />जेवी यीशु पुशो आवो, तेवी तीन चेलाह हुवताला देखीन पतरसाह केयो, “एय शमोन तु हुवेह? काय तु एकताल बी जागतालो नाह रेय सिकेत।” <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />तुमू आखा जागताला रिवो एने विन्ता किरते रिवो काय तुमू पारेख माय नाय पुड़हो। जीव ते तियार हे, पुण सेरीर कोमजोर हे।<verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />एने यीशु पुशो जात रिनो, तेवी यीशु तोच बोल बोलीन विन्ता केरने बाज गीयो। <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />पुशो यीशु आवीन ताह हुवताला दिख्यो, काहाकाय ता निंद माय गाराय रियेल एता; एने नाह जाणताला काय, ताह काय जापाप आपज्यो।<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />पुशो यीशु तिसरी वार आवीन ताह केयो, “काय तुमू एवी वोर निरहा हुवतेह? बास ती गेड़ी आव लागीह; दिखो एवी मी माणहान बिटोख पापी माणहान आथाम होपाय जाह।” <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />उठो! चालो एने दिखो, माहु मारनेन केरता देरनार आहने आव पुचील हे।<verse eid="MRK 14:42" /></para>
  <para style="s">यीशुह बुल माय देरीन होप देणु</para>
  <para style="r">(<ref loc="MAT 26:47-56">मत्ती 26:47-56</ref>; <ref loc="LUK 22:47-53">लुका 22:47-53</ref>; <ref loc="JHN 18:3-12">योहान 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />यीशु ता हिऱ्यो वातु केरने बाजरियेल ईतो, तोलाक माय यहुदा जो बारा चेलाम रेन एक ईतो, यहुदा मुखी चाकऱ्या एने देरेमगुरू एने डायडाया उगे रेन एक होवटाली गेरदी लेन चालोच आव पोचनो, जा तालवार्‍यु एने डेंगा लेय रियेल एता। <verse eid="MRK 14:43" /><verse number="44" style="v" sid="MRK 14:44" />यीशुह होपणार ताह जो पुतो आपेल ईतो, “जा एदम्याह मी गुल्‍या देह ताह तुमू देरीन हाकली केरीन बांदिन ली जाज्यो।”<verse eid="MRK 14:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45" />यहुदा आवो एने चालोच यीशुन आहने आवीन केयो, “एय गुरू केयीन यीशुह गुल्‍या दिनो।” <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />तेवी ता आहने आवीन यीशु पोर आथ टाक्या एने ताह देर लेदा। <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />चेलाम रेन जा आहने उबरियेल एता, एक जाण तालवार काड़ीन मुखी चाकर्‍यान पावराह दिनो एने तान कान तोड़ दिनो। <verse eid="MRK 14:47" /><verse number="48" style="v" sid="MRK 14:48" />यीशु गेरदीह केयो, “काय तुमू माहु गुनेगार सोमजीन देरनेन केरता तालवार्‍यु एने डेंगा लेन आवाह? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" /><note caller="+" style="x"><char style="xo" closed="false">14:49 </char><char style="xt" closed="false"><ref loc="LUK 19:47">लुका 19:47</ref>; <ref loc="LUK 21:37">21:37</ref></char></note>मी दाड़ीन दिह मोंदिर माय तुमरी हिऱ्यो रेतालो एने हिकाड़तालो तेवी तुमू माहु नाह देऱ्या, पुण ज्य ज्यानकेरता ईयेल हे काय पुस्तेक ने वातु पुरी एय।”<verse eid="MRK 14:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50" />ज्य होमलीन आखा चेला यीशुह सोड़ीन नाह गीया।<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />एक जुवान उगाड़ला सेरीर पोर डाठी पांगरीन यीशुन पासाण आवो, एने ता माणहे ताह देरनेन कोसीत केऱ्या। <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />पुण तो डाठीह सोड़ीन उगाड़लोच नाह गीयो।<verse eid="MRK 14:52" /></para>
  <para style="s">यीशुह यहुदिन मोटला पोंचान सोमोर ली जाणु</para>
  <para style="r">(<ref loc="MAT 26:57-68">मत्ती 26:57-68</ref>; <ref loc="LUK 22:54">लुका 22:54</ref>,<ref loc="LUK 22:55">55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13">योहान 18:13</ref>,<ref loc="JHN 18:14">14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />ता यीशुह मुखी चाकऱ्या फाय ली गीया; एने आखा मुखी चाकऱ्या एने देरेमगुरू एने डायला ता फाय टोलवाय गीया। <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />पतरस सीट सिटोच यीशुन पासाण पासाण मुखी चाकर्‍यान वाड़ान खोलीम वोर आवो, एने सिपाया हिऱ्यो बोहीन आक्‍ठो तापणे बाज गीयो। <verse eid="MRK 14:54" /><verse number="55" style="v" sid="MRK 14:55" />तेवी यहुदिन मोटला पोंचा माय मुखी चाकऱ्या यीशुह मारनेन केरता तान विरोद माय पुरावो होदताला, पुण नाह जुड़नो। <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />थोड़ाक माणहे यीशुन विरोद माय जुठो पुरावो देताला, पुण तान पुरावो एक हारको नाह ईतो।<verse eid="MRK 14:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57" />तेवी थोड़ाक माणहे उबरीन यीशुन विरोद माय इहकेरीन पुरावो देना, <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" /><note caller="+" style="x"><char style="xo" closed="false">14:58 </char><char style="xt" closed="false"><ref loc="JHN 2:19">योहान 2:19</ref></char></note>“आमु ज्याह इहकेरीन केतालो होमलेल हेते, काय आथा केरीन बादेल मोंदिराह मी ओदार देह, एने तीन दिह्या माय दिहरो उबो केरूह, एने तो आथा केरीन बादेल नाय रेय।” <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />पुण तान ज्यो पुरावो बी एक हारको नाह ईतो।<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />तेवी मुखी चाकर्‍यो विची माय उबरीन यीशुह फुशो, “ज्या माणहे तारे विरोद माय काय पुरावो देतेह, तु कायच जापाप नाह आपेत?”<verse eid="MRK 14:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="MRK 14:61" />पुण यीशु ठावकोच रिनो, एने काय जापाप नाह आप्यो। पुशो मुखी चाकर्‍यो यीशुह फुशो, “काय तु ता बोरकेतवाला बोगवानान बिटोख मसी हे?”<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />तेवी यीशु जापाप आप्यो, “होव मी हे,” एने तुमू माणहान बेटाख ताकेतवाला बोगवानान जीवड़े उगे बोहीन, एने जुगाम वादला पोर आवतालो दिखहो।<verse eid="MRK 14:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63" />तेवी ज्य होमलीन मुखी चाकर्‍यो तान फाड़का फाड़ीन केयो, “एवी आमुह उंजु काल्ला पुरावान गिरेज नाय मीले?”<verse eid="MRK 14:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MRK 14:64" />तुमू ज्यी चिहटा होमेल लियेल हेते, ज्या पोर तुमरो काय विचार हे? ओवता ता आखा केया ज्यो मारनेन डेंडान बाराबोर हे।<verse eid="MRK 14:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65" />तेवी थोड़ाक यीशु पोर थुपणे बाज गीया, एने यीशु पोर फाड़को टाकीन एने यीशुह केताला, “जाणाव केरीन के काय तुवाह कुण देनोह, एने राखवाल्या यीशुह देरीन थापोड़ देताला।”<verse eid="MRK 14:65" /></para>
  <para style="s">पतरस यीशुह नाकारने</para>
  <para style="r">(<ref loc="MAT 26:69-75">मत्ती 26:69-75</ref>; <ref loc="LUK 22:56-62">लुका 22:56-62</ref>; <ref loc="JHN 18:15-18">योहान 18:15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />जेवी पतरस निड़ो खोलीम बोह रियेल ईतो, ते मुखी चाकर्‍यान पावेरनी माय रेन एक ता आवी, <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />एने पतरसाह आक्‍ठो तापतालो देखीन एने तान उगे नेजेर टाकीन केयी, “तु बी ते ता यीशु नासरी हिऱ्यो ईतो।”<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />पतरस तीन वात टाल दिनो, एने केयो, “मी नाह जाणेत एने नाह सोमजेत तु काय किथे,” ओवतो तो फाटेक उगे गीयो; एने कुकड़ो वाह दिनो।<note caller="+" style="f"><char style="fr" closed="false">14:68 </char><char style="ft" closed="false">थोड़ाक लेख माय तोलाक माय एक कुकड़ो वाह दिनो नाह लिखेल हे।</char></note><verse eid="MRK 14:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69" />ती पावेरनी पतरसाह देखीन ता माय जा आहने उबरियेल एता, ताह केणे बाज गियी, “ज्यो ताम रेन एक हे।”<verse eid="MRK 14:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MRK 14:70" />पुण पतरस पुशो नाकार किऱ्यो। थोड़ीक वार माय जा आहने उबरियेल एता पतरसाह केया, “खेरीच तु ता माय रेन एक हे; काहाकाय तु बी गेलील वालो हे।”<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />पुण पतरस ताह केयो, माहु बोगवान खेतेम केरी, मी सुगोण खाईन खेरीच केथु, “मी ता माणहाह जान वातु तुमू केरतेह मी नाह जाणेत।”<verse eid="MRK 14:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72" />तेवी चालोच दिहरी वार कुकड़ो वाह दिनो। तेवी पतरसाह ती वात जी यीशु ताह कियेल ईतो एर आवी: “कुकड़ो दुय वार वाहणेन पेल तु तीन वार माहु नाकार हे।” एने पतरस रेड़ने बाज गीयो।<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">पिलातुसान सोमोर यीशु</para>
  <para style="r">(<ref loc="MAT 27:1">मत्ती 27:1</ref>,<ref loc="MAT 27:2">2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="LUK 23:1-5">लुका 23:1-5</ref>; <ref loc="JHN 18:28-38">योहान 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />उजालो एताच चालोच मुखी चाकऱ्या डायडाया, एने देरेमगुरू मिलीन यहुदिन मोटला पोंचा माय राय काड्या एने यीशुह बांदिन ली गीया, एने ताह पिलातुसान आथाम होप देना।<verse eid="MRK 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 15:2" />पिलातुस यीशुह फुशो, “काय तु यहुदिन राजा हे?” यीशु ताह जापाप आप्यो, “होव जिहकेरीन तु खुद केणे बाजरिनोह।”<verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />तेवी मुखी चाकऱ्या यीशु पोर जुलूम वातुन गुनो लागाड़ताला। <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />पिलातुस यीशुह उंजु फुशो, “काय तु कायच जापाप नाह आपेत? देख ज्या तुवा पोर जुलूम वातुन गुनो लागाड़तेह।”<verse eid="MRK 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5" />पुण यीशु कायच बी जापाप नाह आप्यो; तेवी पिलातुस जुलूम बोंगलाय गीयो।<verse eid="MRK 15:5" /></para>
  <para style="s">यीशुह मोत डेंड ने उकुम आपणु</para>
  <para style="r">(<ref loc="MAT 27:15-26">मत्ती 27:15-26</ref>; <ref loc="LUK 23:13-25">लुका 23:13-25</ref>; <ref loc="JHN 18:39-19:16">योहान 18:39–19:16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />देर वोरीह फसह ने तिवारान टेम माय यहुदि माणहे एक काल्ला बी आरापीह सोड़नेन मांग केरताला, ताह पिलातुस सोड़ देतालो। <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />बरअब्बा नावान एक एदमी ईतो, जो रोमन सारकारान विरोद माय काम केरनारा हिऱ्यो जेली माय ईतो, जा रोमन सारकारान विरोद माय खुन किरेल एता। <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />एने गेरदी उपेर जाईन पिलातुसाह विन्ता केरने बाज गियी, काय जिहकेरीन तु कायेम आमरी केरता किरते आयेल हे तिहेच केर। <verse eid="MRK 15:8" /><verse number="9" style="v" sid="MRK 15:9" />पिलातुस ताह जापाप आप्यो, “काय तुमरी मोरजी हे काय मी तुमरी केरता यहुदियान राजाह सोड़ देव?” <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />पिलातुस जाणतालो काय मुखी चाकऱ्या यीशुह कुयराये होपेल हेते।<verse eid="MRK 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11" />मुखी चाकऱ्या माणहाह ईरेचेड़ाया काय पिलातुस बरअब्बाह आमरी केरता सोड़ देय। <verse eid="MRK 15:11" /><verse number="12" style="v" sid="MRK 15:12" />ज्य होमलीन पिलातुस ताह उंजु फुशो, “ते जाह तुमू यहुदियान राजा केतेह, ताह मी काय केरू?”<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />माणहे उंजु आयेड़ने बाज गीया, “ओयाह खुरूसखाम पोर खीला ठोकीन चेड़ाव दे।”<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />पिलातुस ताह केयो, “काहा, ज्यो काय गुनो किरेल हे?” पुण ता उंजु जोरेस आयड़ीन केणे बाज गीया, “ओयाह खुरूसखाम पोर खीला ठोकीन चेड़ाव दे।”<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />तेवी पिलातुस गेरदीह खुस केरनेन केरता, बरअब्बाह तान केरता सोड़ दिनो, एने यीशुह चापका देवाड़ीन सिपायड़ाह होप दिनो काय खुरूसखाम पोर खीला ठोकीन चेड़ाव देती।<verse eid="MRK 15:15" /></para>
  <para style="s">सिपायड़ा यीशुन ईजुत उड़ाया</para>
  <para style="r">(<ref loc="MAT 27:27-31">मत्ती 27:27-31</ref>; <ref loc="JHN 19:2">योहान 19:2</ref>,<ref loc="JHN 19:3">3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />ज्यान पासाण सिपायड़ा यीशुह प्रिटोरीयुम राज्यपाल ने राजवाड़ान ओंगाण खोली माय ली गीया, एने ता आखा रोमी सिपायड़ान टोलीह हादिन एकठा केऱ्या। <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />तेवी ता यीशुह जामण्या फाड़का पेराया, एने काटान मुकूट गुथीन यीशुन मुंडा पोर पेराया, <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />एने इही केयीन यीशुह नमस्‍कार केरने बाज गीया, “एय यहुदियान राजा, तारी जय एय।” <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />ता यीशुन मुंडी पोर होटा केरीन देना, एने ता पोर थुप्या, एने मांड्या वोलीन ताह वोंदते रेना। <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />जेवी ता यीशुन ईजुत उड़ाव लेदा, तेवी यीशुन सेरीरा पोर रेन जामण्या फाड़का काड़ीन ताच ने फाड़का पेराव देना; एने यीशुह खुरूसखाम पोर चेड़ावणेन केरता बाहेर ली गीया।<verse eid="MRK 15:20" /></para>
  <para style="s">यीशुह खुरूसखाम पोर चेड़ावणो</para>
  <para style="r">(<ref loc="MAT 27:32-44">मत्ती 27:32-44</ref>; <ref loc="LUK 23:26-43">लुका 23:26-43</ref>; <ref loc="JHN 19:17-27">योहान 19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">15:21 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 16:13">रोमीयो 16:13</ref>
      </char>
    </note>आलेकजांडर एने रुफुस ने आबोख शिमोन कुरेनी गावाम रेन आवतालो, ताह बोलजोबरी देऱ्या काय यीशुन खुरूसखाम उखलीन ली चाली। <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />एने ता गुलगुता नावान जागा पोर लावा, जान मतलब हे, “खोपड़ीन जागो।” <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />एने ता यीशुह माणली दावा बेचकीन अंगुरान रूह पिवाड़ ने होदताला; पुण यीशु नाह पिदो। <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />तेवी ता यीशुह खुरूसखाम पोर खीला ठोकीन चेड़ाव देना, एने यीशुन फाड़कान केरता चिट्ठी टाक्या एने जाह जो जुड़नो तो वाट लेदा। <verse eid="MRK 15:24" /><verse number="25" style="v" sid="MRK 15:25" />जेवी ता यीशुह खुरूसखाम पोर खीला ठोकीन चेड़ाया तुलबूखे वेगाच ने नोव वाज जायेल एता। <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />यीशुन गुनान चिट्ठी लेखीन खुरूसखामा पोर लागाड़ देना, “ज्यो यहुदियान राजा हे।” <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />ता यीशु हेऱ्या दुय डाकुह एक तान जीवड़े उगे एने दिहराह तान डाखरे उगे खुरूसखाम पोर खीला ठोकीन चेड़ायेल एता। <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" /><note caller="+" style="f"><char style="fr" closed="false">15:28 </char><char style="ft" closed="false">थोड़ाक लेख माय वचन 28 जोड़ाय जायेल हे। देखी लुका 22:37।</char></note>तेवी वचन माय जो लिखेल हे, “तो गुनेगारा हिऱ्यो गेणाय गीयो, तो पुरो एनो।”<verse eid="MRK 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29" />
    <note caller="+" style="x">
      <char style="xo" closed="false">15:29 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 14:58">मरकुस 14:58</ref>; <ref loc="JHN 2:19">योहान 2:19</ref></char>
    </note>आवणे जाणारे यीशुन चिहटा केरती लेन केताला, एय मोंदिराह ओदारनार एने तीन दिह्याम बाणावणार, <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />खुरूसखाम पोर रेन उतरीन आपणे आपाह वोचाड़ ली।<verse eid="MRK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31" />इहीचकेरीन मुखी चाकऱ्या बी देरेमगुरू हेऱ्या मिलीन ता आखा यीशुन ईजुत उड़ावीन इहकेरीन केताला, ज्यो दिहराह वोचाड्यो; पुण ताहाच नाह वोचाड़ सिकेत।<verse eid="MRK 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 15:32" />इस्राएल ने राजा मसी, एवी खुरूसखाम पोर रेन उतेर आवी काय आमु देखीन बुरहो केरहु। एने जा दुय डाकु यीशु हेऱ्या खुरूसखाम पोर खीला ठोकीन चेड़ाय जायेल एता, ता बी इहीचकेरीन केरीन यीशुन चिहटा केरताला।<verse eid="MRK 15:32" /></para>
  <para style="s">यीशुन जीव सोड़नो</para>
  <para style="r">(<ref loc="MAT 27:45-56">मत्ती 27:45-56</ref>; <ref loc="LUK 23:44-49">लुका 23:44-49</ref>; <ref loc="JHN 19:28-30">योहान 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />जेवी दिह्यान बारा वाज गीया, ते आखा देसा माय आदारो सावाय गीयो, एने तीन वाजता वोर आदारोच रेनो। <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />दिह्यान तीन वाजता यीशु मोठेच आयड़ीन केयो, “इलोई, इलोई लमा शबक्तनी?” ज्यान मतलब हे, “एय मार बोगवान, एय मार बोगवान, तु माहु काहा सोड़ दिनोह?”<verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />जा आहने उबरियेल एता ता माय रेन थोड़ाक ज्य होमलीन केया, “दिखो, ज्‍यु ते एलियाह आयड़ेह।” <verse eid="MRK 15:35" /><verse number="36" style="v" sid="MRK 15:36" />एने एक जाण दोवड़ीन स्पंजाह अंगुरान माणला रूहा माय बुड़ावीन ताह टोकरा माय विलगाड़ीन यीशुह चुहाड्यो एने केयो, “उबरी जावो, देखता एलिया ज्याह खुरूसखाम पोर रेन उतारनेन केरता आवीह काय नाह।”<verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />तेवी यीशु जोरेस आयड़ीन जीव सोड़ दिनो।<verse eid="MRK 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38" />एने मोंदिरान पुड़दो उपेर रेन बुंदे वोर फाटीन दुय टुकड़ा एय गीयो। <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />आदिकारी जो यीशुन आहने उबरियेल ईतो, जेवी ताह इहकेरीन आयड़ीन जीव सोड़तालो दिख्यो।<note caller="+" style="f"><char style="fr" closed="false">15:39 </char><char style="ft" closed="false">थोड़ाक लेख माय जोरेस आयड़ेल एने मोर गीयो लिखेल हे।</char></note> ते तो केयो, “खेरीच ज्यो माणुह बोगवानान बिटोख ईतो।”<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />
    <note caller="+" style="x">
      <char style="xo" closed="false">15:40 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 8:2">लुका 8:2</ref>,<ref loc="LUK 8:3">3</ref></char>
    </note>मोकत्यु बायकु बी सेट्युच रेन देखताल्यु: ता माय मरीयम मगदलीनी, आतल्यो याकुब एने योसेस ने आहख मरीयम, एने सलोमी एत्यु। <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />जेवी यीशु गेलील माय ईतो, तेवी त्यु तान पासाण आयेल एत्यु एने यीशुन सेवा चाकरी केरताल्यु, उंजु दिहऱ्यु जुलूम बायकु बी एत्यु; ज्यु ता हेऱ्यु यरूशलेम माय आयेल एत्यु।<verse eid="MRK 15:41" /></para>
  <para style="s">यीशुह बुजणो</para>
  <para style="r">(<ref loc="MAT 27:57-61">मत्ती 27:57-61</ref>; <ref loc="LUK 23:50-56">लुका 23:50-56</ref>; <ref loc="JHN 19:38-42">योहान 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />ज्यो दिह यहुदियान विहेवणेन दिह्यान पेल्लो दिह ईतो, जो तिवारान दिह केवातालो, एने हांज पोड़ जायेल एती, <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />अरीमतीया गावाम रेणार युसूफ आवो, तो यहुदिन मोटला पोंचान एक आदिकारी ईतो। तो बोगवानान राज ने वाट जोवतालो। युसूफ ईमोत केरीन पिलातुस फाय जाईन यीशुन देड़ मांग्‍यो। <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />पिलातुस बोंगलाय जायेल ईतो काय यीशु ओलो उतवाल्यो काहा मोर गीयो। एने तो आदिकारीह हादिन फुशो, “काय यीशु मोर जायेल हे?” <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />ओवतो तो आदिकारी फाय मालुम केरीन युसूफाह यीशुन देड़ आप दिनो। <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />तेवी युसूफ एक डाठी वेचाती लिदो, एने यीशुन देड़ाह खुरूसखाम पोर रेन उतारीन ती डाठी माय गुंडालीन एक माहणा माय जो देगड़ाह कोरीन बाणायेल ईतो, ता मेल्‍यो एने बायणा पोर एक मोटलो हिलो टेकाड़ दिनो। <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />मरीयम मगदलीनी एने योसेस ने आहख मरीयम ताह काहरीक मेलतेह तो देखताल्यु।<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">यीशुन जीव उठणो</para>
  <para style="r">(<ref loc="MAT 28:1-8">मत्ती 28:1-8</ref>; <ref loc="LUK 24:1-12">लुका 24:1-12</ref>; <ref loc="JHN 20:1-10">योहान 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />विहेवणेन दिह जात रिनो, तेवी मरीयम मगदलीनी, एने याकुबान आहख मरीयम, एने सलोमी, मोग मोग गेंदाणार तेल वेचाती लेद्यु काय जाईन यीशुन देड़ा पोर लागाड़े। <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />एप्तान पेल्ले दिह उठ्यान वेग्युच दिह उगताच, त्यु माहणा माय आव्यु। <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />एने त्यु तीन तीन केताल्यु, “आपणी केरता माहणान बायणा पोर रेन दिगोड़ कुण हेरकावी?” <verse eid="MRK 16:3" /><verse number="4" style="v" sid="MRK 16:4" />दिगोड़ जुलूम मुठो ईतो, पुण जेवी त्यु देख्यु ते दिगोड़ हेरकी जायेल हे, तेवी त्यु केयु, “देगड़ाह कुण हेरकायो एय।” <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />माहणा माय रिगताच, त्यु एक जुवानाह दोवल्या फाड़का पिरेल ईतो, ताह जीवड़े उगे बुहेल देखीन त्यु जुलूम बिय गीयु। <verse eid="MRK 16:5" /><verse number="6" style="v" sid="MRK 16:6" />हेरोगदुत त्युह केयो, “बोंगलाहो मा नासरत वालो यीशु जाह खुरूसखाम पोर खीला ठोकीन चेड़ायेल एता, ताह तुमू होदत्युह। दिखो, ज्यो तो जागो हे, जा ताह मीलेल एता तो न्या नाह सुतो; तो जीव उठेल हे।” <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" /><note caller="+" style="x"><char style="xo" closed="false">16:7 </char><char style="xt" closed="false"><ref loc="MAT 26:32">मत्ती 26:32</ref>; <ref loc="MRK 14:28">मरकुस 14:28</ref></char></note>पुण तुमू जावो, तान चेलाह एने पतरसाह किज्यो काय यीशु तुमूह रेन पेल गेलील माय जाय। तुमूह यीशु कियेल ईतो, तिहेच केरीन गेलील माय यीशुह दिखहो।<verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />ओवत्यु त्यु माहणा माय रेन निकलीन दोवड़ी पोड़न्यु; एने त्यु माय थुतरी बोराय जायेल एती एने त्यु गाबराय जायेल एत्यु; त्यु कुणाह खेरीच कायच नाह केयु, काहाकाय त्यु बिय रियेल एत्यु।<note caller="+" style="f"><char style="fr" closed="false">16:8 </char><char style="ft" closed="false">जुनाला अनुवाद माय ज्यी खोबरीन आखरी माय ज्यो लेख नाह जुड़ेल हे। 9-20 वचन।</char></note><verse eid="MRK 16:8" /></para>
  <para style="s">मरीयम मगदलीनीह यीशु देखाणे</para>
  <para style="r">(<ref loc="MAT 28:9">मत्ती 28:9</ref>,<ref loc="MAT 28:10">10</ref>; <ref loc="JHN 20:11-18">योहान 20:11-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />एप्तान पेल्ले दिह उजालो एताच यीशु जीव उठनो, एने आखान पेल मरीयम मगदलीनी जीन सेरीर माय रेन यीशु पेल हात बुतड़ाह काड़ेल ईतो, तीह देखानो। <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />ती जाईन यीशुन हातीह जा दुखाम बोराय रियेल एता एने रेड़ताला, ताह खुबेर केरी। <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />ता ज्य होमलीन काय यीशु जीवतालो हे, एने मरीयम यीशुह दिखेल हे, तीबी ता ती पोर बुरहो नाह केऱ्या।<verse eid="MRK 16:11" /></para>
  <para style="s">यीशु दुय चेलाह देखाणे</para>
  <para style="r">(<ref loc="LUK 24:13-35">लुका 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />तान पासाण यीशु पुशो दिहरा वेहाम ता माय रेन दुयाह जेवी ता गावा उगे जाताला, देखानो। <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />ता बी जाईन दिहराह हातीह खुबेर केऱ्या, पुण ता तान वातु पोर बी बुरहो नाह केऱ्या।<verse eid="MRK 16:13" /></para>
  <para style="s">यीशु ईग्यार चेलाह देखाणे</para>
  <para style="r">(<ref loc="MAT 28:16-20">मत्ती 28:16-20</ref>; <ref loc="LUK 24:36-49">लुका 24:36-49</ref>; <ref loc="JHN 20:19-23">योहान 20:19-23</ref>; <ref loc="ACT 1:6-8">प्रेरितान काम 1:6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />पासाण यीशु ता ईग्यार चेलाह बी, जेवी ता रूटो खाणेन बोह रियेल एता, ताह देखानो, एने तान अविश्वास एने मोनान कठोरता देखीन दोपकाड्यो, काहाकाय जा माणहे यीशुह जीव उठणेन पेल दिखेल एता, ता पोर बुरहो नाह केऱ्या। <verse eid="MRK 16:14" /><verse number="15" style="v" sid="MRK 16:15" /><note caller="+" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="ACT 1:8">प्रेरितान काम 1:8</ref></char></note>उवतो यीशु चेलाह केयो, “तुमू आखी केलीम जाईन आखी केलीन माणहाह हाजाली खोबरीन पारचार किरो। <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />जो बुरहो केरी एने बपतीस्मा लेय ताच ने सुटकारो एय, पुण जो बुरहो नाय केरी तान नियाव एय, एने तो गुनेगार गेणाय जाय; <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />बुरहो केरनारा माय जी निसाणी रेय काय ता मार नावा केरीन बुतड़ाह निकालती, एने ता नोवाली नोवाली बाषा बोलती, <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />केदी ता गेड़हाह उखलीन लेती, एने जीव लेण्यो जेहेर बी पिय लेती तीबी तान कायच नुसकान नाय एय; ता दुखाऱ्या पोर आथ मेलती, एने ता हुदेर जाती।”<verse eid="MRK 16:18" /></para>
  <para style="s">यीशुन हेरगाम जाणो</para>
  <para style="r">(<ref loc="LUK 24:50-53">लुका 24:50-53</ref>; <ref loc="ACT 1:9-11">प्रेरितान काम 1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16:19 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 1:9-11">प्रेरितान काम 1:9-11</ref>
      </char>
    </note>मालीक यीशु ता हिऱ्यो वातु केरनेन पासाण हेरगा माय विसाय गीयो, एने बोगवानान जीवड़े उगे बोह गीयो। <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />एने चेला जाईन आखी जागे पारचार केऱ्या, एने बोगवान ता हिऱ्यो काम किरते रिनो, एने त्यु निसाण्यु केरीन ज्यु ता हेर्‍यु एताल्यु। बोगवान वचनाह मोजबुत किरते रिनो। आमेन।<note caller="+" style="f"><char style="fr" closed="false">16:20 </char><char style="ft" closed="false">थोड़ाक लेख माय एने जुनाला अनुवाद माय, ज्यी खोबरीन आखरी माय विस्तार से निवरावणेन सिवाय ज्यो थोड़ाक माय निवरनो जुड़ेल हे। 9-20 वचन।</char></note><verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>