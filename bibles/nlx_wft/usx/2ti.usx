<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- Nahali</book>
  <para style="h">2 तीमुथीयुस</para>
  <para style="toc3">2 तीमुथीयुस</para>
  <para style="toc2">2 तीमुथीयुस</para>
  <para style="toc1">तीमुथीयुस पौलुस लिखेल दुसरो पोत्रो</para>
  <para style="mt2">तीमुथीयुस पौलुस ने लिखा हुआ दुसरा पत्र</para>
  <para style="mt1">तीमुथीयुस पौलुस लिखेल दुसरो पोत्रो</para>
  <para style="imt">ओलखात</para>
  <para style="ip">दुसरा तीमुथीयुस ने पुस्तेक प्रेरित पौलुसान चेलो तीमुथीयुस ने केरता दुसरो पोत्र हे। 2 तीमुथीयुस पौलुसान जीवणान सेवली टेम माय लेखाय जायेल एतो। <char style="xt"><ref loc="2TI 1:16">1:16</ref></char> ज्यी टेम रोम माय ताह जेल माय कोंड दियेल एता। पौलुस तीमुथीयुसा हिऱ्यो मोजबुत समंद मेलीन एने कायेम ताह एक पोत्र निर्देश किरेल हे। <char style="xt"><ref loc="PHP 2:22">फिलेपियो 2:22</ref></char>, <char style="xt"><ref loc="1TI 1:2-18">1 तीमुथीयुस 1:2–1:18</ref></char></para>
  <para style="ip">ज्यो पौलुसान चार पोत्राम रेन एक हे जाह मोंडली केणेन रेणदेन एगदा माणहाह संबोदित केराय जाथे। दिहऱ्यु तीन ओहल्यु पोत्रु 1 तीमुथीयुस, तीतुस एने फिलेमोन हेत्यु। ता टेमान दोवरान 2 तीमुथीयुस ने पोत्री लेखाय जायेल एती, जुलबुखे रोमन देसान विश्वासी माणहाह सेतावणे बाजरियेल एता। शायद ज्योस कारेण एतो काय पौलुस जेल माय ईतो एने तीमुथीयुसाह परिशानिन सामनो केरनेन केरता निर्देश आपतालो। 1 तीमुथीयुस ने रूप माय पौलुस तीमुथीयुसाह जुठा मास्तेर्‍यान बाराम चेतावणी आपेल। <char style="xt"><ref loc="1TI 1:16-18">1 तीमुथीयुस 1:16-18</ref></char> एने तो तीमुथीयुसाह बी केणे काय ओंगाण केठीण टेम रेय। <char style="xt"><ref loc="2TI 3:1">3:1</ref></char></para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. पौलुस तीमुथीयुसाह शाबास आपेह एने पुशो ताह प्रोत्साहित किरेह। <char style="ior"><ref loc="2TI 1:1-18">1:1-18</ref></char></para>
  <para style="io1">2. तो तीमुथीयुसाह ओंगाण जाणेन केरता चुनोती आपेह। <char style="ior"><ref loc="2TI 2:1-13">2:1-13</ref></char></para>
  <para style="io1">3. तो ताह थोड़ाक सामान्य निर्देश आपेह। <char style="ior"><ref loc="2TI 2:14-26">2:14-26</ref></char></para>
  <para style="io1">4. ओवतो तो ताह बविष्‍यान गेटनान एने जापाप आपणेन खेरलो तरीको किथे। <char style="ior"><ref loc="2TI 3:1-4:8">3:1–4:8</ref></char></para>
  <para style="io1">5. पौलुस तीमुथीयुस ने केरता थोड्युक व्यक्तिगत टिप्‍पणि हिऱ्यो खेतेम किरेह। <char style="ior"><ref loc="2TI 4:9-22">4:9-22</ref></char></para>
  <chapter number="1" style="c" sid="2TI 1" />
  <para style="s">नमस्‍कार</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1" />पौलुस ने उगे रेन मसी यीशु माय जो जेलेमक्यो जीवाय ने वायदो हे, तान बाराम गोसणा केरनेन केरता बोगवानान मोरजीन गेत प्रेरित हे, <verse eid="2TI 1:1" /><verse number="2" style="v" sid="2TI 1:2" /><note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="ACT 16:1">प्रेरितान काम 16:1</ref></char></note>मोंगाल्ला सोरा तीमुथीयुस ने नाव:</para>
  <para style="p" vid="2TI 1:2">आबोख बोगवान एने मसी यीशुन उगे रेन तुवाह किव एने गीण एने सान्ती जुड़ते रेय।<verse eid="2TI 1:2" /></para>
  <para style="s">दन्यवाद एने उत्साहित केरने</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3" />मी मारी विन्ता माय रात दिह तुवाह एर केरीन बोगवानान दन्यवाद केरथु, जान सेवा मी मारा डायडायान रिती पोर चोखाला मोना केरीन केरथु, <verse eid="2TI 1:3" /><verse number="4" style="v" sid="2TI 1:4" />एने तार आहवान एर केरीन तुवाह मिलनेन जुलूम आसा केरथु, काय तुवाह देखीन खुसी माय बोराय जाव। <verse eid="2TI 1:4" /><verse number="5" style="v" sid="2TI 1:5" /><note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="ACT 16:1">प्रेरितान काम 16:1</ref></char></note>माहु तारा ता बिगेर कोपेट बोरहान एर आवीह, जो पेल तारी डावाली आहख लोइस एने तार आहख यूनीके माय एत्यु, माहु बुरहो हे काय तोस बुरहो तार माय बी हे। <verse eid="2TI 1:5" /><verse number="6" style="v" sid="2TI 1:6" />ज्यानकेरता मी तुवाह एर केरावथो काय तु ता वरदानाह जीवतालो मेल जो तार उपेर मार आथ मेलनेन द्‍वारा बोगवान तुवाह आपेल हे। <verse eid="2TI 1:6" /><verse number="7" style="v" sid="2TI 1:7" />काहाकाय बोगवान आमुह बिय ने नाह पुण ताकेत ने, मोंग ने एने दिरान जीव आपेल हे।<verse eid="2TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 1:8" />तानकेरता आमरा मालीकान हाजाली खोबरीन गोवाय केरीन, एने माहु रेन जो मसीन केयदी हे लाजवाहे मा, पुण ती ताकेत जी बोगवान तुवाह आपेल हे, तान गेत मार हिऱ्यो दुख उखलीन। <verse eid="2TI 1:8" /><verse number="9" style="v" sid="2TI 1:9" />तो आमरा कामान वोजेसे नाह, पुण तान योजना एने गीण माय आमुह सुटकारो आप्यो एने चोखाली हादावणी माय हाद्यो, ज्यी गीण मसी यीशु फाय आवणे माय आमु पोर ईयेल एती। <verse eid="2TI 1:9" /><verse number="10" style="v" sid="2TI 1:10" />पुण एवी आमरा सुटकारो केरन्या यीशु मसीन आवणेन द्‍वारे देखानो, जो मोतीन ताकेतीह खेतेम किऱ्यो एने जेलेमक्या जीवणान हाजाली खोबरीन द्‍वारा देखाड्यो। <verse eid="2TI 1:10" /><verse number="11" style="v" sid="2TI 1:11" /><note caller="+" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="1TI 2:7">1 तीमुथीयुस 2:7</ref></char></note>तानकेरता मी हाजाली खोबरीन गोसणा केरनेन केरता बोगवान माहु प्रेरित, एने मास्तेर ठेरायेल हे। <verse eid="2TI 1:11" /><verse number="12" style="v" sid="2TI 1:12" />ज्यानकेरता ज्यो दुख मी वेठथु, तीबी लाजवात नाह, काहाकाय मी जा पोर बुरहो किरेल हे, ताह मी जाणथो; एने माहु बुरहो हे काय तो मार ईसाह ते दिह वोर राखवाली केर सिकेह।<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="ft" closed="false">तो माहु बोरहा केरीन सुरो बाणायो; नाहते मी तान बोरहा केरीन सुरो बोणनु। </char></note> <verse eid="2TI 1:12" /><verse number="13" style="v" sid="2TI 1:13" />जीहे काय तु मार फाय रेन होमलेल हे काय मालीक यीशु मसीन बुरहो, मोंग एने हाजाली हिकवोणान नमुनो बाणाव। <verse eid="2TI 1:13" /><verse number="14" style="v" sid="2TI 1:14" />एने चोखाला जीवान द्‍वारे जो आमु माय बोह रेनोह, ज्यी हाजाल्यु वातुन राखवाली केर।<verse eid="2TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15" />जा बुरहो केरनारे माणहे आसीया खेड़ा माय हेते, ता मार हेऱ्या रेन सेटा एय गीयाह, ज्यो तुवाह मालुम हे; जा माय फुगीलुस एने हिरमुगीनेस न्या हेते। <verse eid="2TI 1:15" /><verse number="16" style="v" sid="2TI 1:16" />उनेसीफुरूसान गेराणा पोर मालीक गीण केरी, काहाकाय तो जुलूम वार माहु हुक पोचाड़ेल एने ताह मार बेड्या एने हाकुल माय बांदायेन लाज नाह आवीत। <verse eid="2TI 1:16" /><verse number="17" style="v" sid="2TI 1:17" />पुण जेवी तो रोम माय आवो, ते जुलूम मेहनेत केरीन होदिन मार हिऱ्यो मिलानो। <verse eid="2TI 1:17" /><verse number="18" style="v" sid="2TI 1:18" />ते दिह मालीक फाय रेन ताह गीण जुड़ी, ओहलो मालीक केरी; एने इफिसुस माय जो जो सेवान काम किरेल हे तु हास केरीन जाणेह।<verse eid="2TI 1:18" /></para>
  <chapter eid="2TI 1" />
  <chapter number="2" style="c" sid="2TI 2" />
  <para style="s">मसी यीशुन हाजो सिपाय</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1" />तान केरता एय मार सोरा, तु ता गीणा माय जो मसी यीशु माय एकतान द्‍वारा हे, ताकेतवान एय जा। <verse eid="2TI 2:1" /><verse number="2" style="v" sid="2TI 2:2" />एने ती हिकवोण जीह तु मोकतास गोवान सामने मार फाय रेन होमलेल हे, ती हिकवोणाह विश्वासयोग्य माणहाह होप दे जा दिहराह हिकाड़नेन लायकीन एती। <verse eid="2TI 2:2" /><verse number="3" style="v" sid="2TI 2:3" />मसी यीशुन हाजाला सिपायान गेत मार हिऱ्यो दुख वेठ। <verse eid="2TI 2:3" /><verse number="4" style="v" sid="2TI 2:4" />काल्लो बी सिपाय लेड़ाणेन केरता जाथे, ते ज्यानकेरता काय ताह बोरती केरनाराह खुस केरी, एने आपणा आपाह दुनियान कामाम नाह फोसाड़ेत। <verse eid="2TI 2:4" /><verse number="5" style="v" sid="2TI 2:5" />एने केदी दोवेड़नार नेमान गेत नाय दोवड़ी ताहार ताह ईनाम नाय जुड़ी। <verse eid="2TI 2:5" /><verse number="6" style="v" sid="2TI 2:6" />एने जो किरसाण जुलूम मेहनेत किरेह, फोलान पेल्लो ईसो ताह जुड़ने जुवे। <verse eid="2TI 2:6" /><verse number="7" style="v" sid="2TI 2:7" />जो मी केथु त्यु आख्‍यु वातु पोर द्यान दे, एने मालीक तुवाह आखी वातुन सोमेज आपी। <verse eid="2TI 2:7" /><verse number="8" style="v" sid="2TI 2:8" />यीशु मसीह एर मेल, जो दाऊदान वोसीन पायदा ईनो एने मुरेल माय रेन जीव उठनो एने मारी हाजाली खोबरीन गेत मुरेल माय रेन जीव उठनो, ज्यो मारी हाजाली खोबरीन गेत हे। <verse eid="2TI 2:8" /><verse number="9" style="v" sid="2TI 2:9" />ज्यानकेरता मी गुनेगारान गेत दुख वेठथु, न्या वोर काय मी जेली माय कोंडाय रिनोह, पुण बोगवानान वचन कोंडायेल नाह सोतो। <verse eid="2TI 2:9" /><verse number="10" style="v" sid="2TI 2:10" />ज्यानकेरता मी निवाड़ेल माणहान केरता आखो काय वेठथु, काय ता बी ता सुटकाराह जो मसी यीशु माय हे जेलेमक्यो बोड़ाय हेऱ्यो जुड़ी। <verse eid="2TI 2:10" /><verse number="11" style="v" sid="2TI 2:11" />ज्यी वात खेरली हे,</para>
  <para style="q1" vid="2TI 2:11">केदी आपु ता हेऱ्या मोर गीयाह,</para>
  <para style="q2" vid="2TI 2:11">ते ता हेऱ्या जीवहु बी;<verse eid="2TI 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2TI 2:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:12 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:33">मत्ती 10:33</ref>; <ref loc="LUK 12:9">लुका 12:9</ref></char>
    </note>एने केदी आपु दिर देरीन आखो वेठते रेहु, ते ता हेऱ्या राज बी केरहु;</para>
  <para style="q1" vid="2TI 2:12">एने केदी आपु ताह नाकार हु, ताहार तो बी आपुह नाकार देय;<verse eid="2TI 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TI 2:13" />केदी आपु अविश्वासी एय जाहु,</para>
  <para style="q2" vid="2TI 2:13">तीबी तो विश्वासयोग्य बोणीन रीथे,</para>
  <para style="q1" vid="2TI 2:13">काहाकाय तो सोतान नाकार नाह केर सिकेत।<verse eid="2TI 2:13" /></para>
  <para style="s">हाजो कारागीर</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14" />तु ज्यी वातुन ताह एर केराव, एने मालीकान सामने ताह चेतावणी आप काय सोबदान बाराम बोलाचाल नाय केरी, जाकेरीन कायच फायदो नाह एत पुण होमेलनारे बिगेड़ जातेह। <verse eid="2TI 2:14" /><verse number="15" style="v" sid="2TI 2:15" />तु खेरायीन वचनाह हास केरीन बोलनार, एने लाज आवणेन काल्लो बी कारेण नाय एय, बोगवानाह पोटी ओहलो काम केरनेन कोसीत केर। <verse eid="2TI 2:15" /><verse number="16" style="v" sid="2TI 2:16" />पुण एठी वातीह रेन वोचीन रे, काहाकाय ओहला माणहे होवटाह विणबोक्ती माय वोड़ते जातेह। <verse eid="2TI 2:16" /><verse number="17" style="v" sid="2TI 2:17" />एने तान वचन हिड़ेल गायीन गेत वोड़ती जाय। हुमीनयुस एने फिलेतुस ताच माय रेन हेते। <verse eid="2TI 2:17" /><verse number="18" style="v" sid="2TI 2:18" />जा माणहे खेरायीह रेन बोटेक जायेल हेते, एने केतेह काय आमरो पोशो जीव उठणो एय गीयोह एने थोड़ाक माणहान बोरहाह खेतेम केर देतेह। <verse eid="2TI 2:18" /><verse number="19" style="v" sid="2TI 2:19" />तीबी बोगवान बाणायेल पाको पायो बोणीन रीथे, एने ता पोर सिक्को बी लागाड़ेल हे: “मालीक तान जा माणहे हेते ताह ओलखेह,” एने “जो कुण मालीकान नाव लिथे, तो अन्याय केरने से वोचीन रेय।”<verse eid="2TI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20" />मोटला गेराम होनो चांदीन ठामला ओलास नाह, पुण लाकड़ान एने माटड्यान बी रेणु; काल्ला काल्ला मान सम्मान ने केरता, एने काल्ला काल्ला ओवला कामान केरता। <verse eid="2TI 2:20" /><verse number="21" style="v" sid="2TI 2:21" />केदी एगदो सोताह न्या माय रेन चोखो केरी, ते तो मान सम्मान केरनेन ठामलो एने चोखालो ठेराय; काहाकाय तो समर्पित एयीन मालीकान काम आवी, एने आखा हाजा कामान केरता तियार एय। <verse eid="2TI 2:21" /><verse number="22" style="v" sid="2TI 2:22" />जुवानीन मोरजीह रेन सिटो नाह, एने चोखो मोन से मालीकान नाव लेणारा हिऱ्यो देरेम, बुरहो, एने मोंग, एने ईलीमिलीन रेणारान पासाण लाग। <verse eid="2TI 2:22" /><verse number="23" style="v" sid="2TI 2:23" />पुण फोगापोणाह रेन एने मालुम नाह ओहला बोलाचालाह रेन सिटो रिजे, काहाकाय तु जाणेह काय जाकेरीन जेगड़ा एतेह। <verse eid="2TI 2:23" /><verse number="24" style="v" sid="2TI 2:24" />मालीक ने पावोर जीगड़ो केरनार नाय रेणे जुवे, पुण तो आखा हिऱ्यो नेरमाय माय एने हिकाड़ने माय लायकीन, एने आखो काय वेठणार एय। <verse eid="2TI 2:24" /><verse number="25" style="v" sid="2TI 2:25" />एने विरोद केरनाराह गेरबोड़ाय माय सोमजाड़नार रेणे जुवे, काय जाणे बोगवान ताह पापाम रेन मोन फिरावणेन मोन आपी काय खेरायीह ओलखी। <verse eid="2TI 2:25" /><verse number="26" style="v" sid="2TI 2:26" />एने ता सुद्दी माय आवीन सैतानान फासाम रेन सुट जाय, जो ताह तान मोरजी पुरी केरनेन केरता बोंदी बाणायेल ईतो।<verse eid="2TI 2:26" /></para>
  <chapter eid="2TI 2" />
  <chapter number="3" style="c" sid="2TI 3" />
  <para style="s">सेवले दिह</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1" />पुण सेवल्या कालाम केठीण दिह आवती ज्यो तु सोमजी ले। <verse eid="2TI 3:1" /><verse number="2" style="v" sid="2TI 3:2" />काहाकाय माणहे कोपटी, लोबी, मोठलाय केरनारे, मोठाय, चिहटा केरनारे, आईख आबाख ने मान नाह मेलनारे, उपकाराह एर नाह केरनारे, एठा, <verse eid="2TI 3:2" /><verse number="3" style="v" sid="2TI 3:3" />गीण नाह केरनारे, माफ नाह केरनारे, चुगली केरनारे, सोता पोर काबु नाह केरनारे, विरोदी, हाजालान दुसमोन, <verse eid="2TI 3:3" /><verse number="4" style="v" sid="2TI 3:4" />बुरहो तोड़नारे, पिटारा, मोठाय माय फुलनारे, एने बोगवानाह मोंग केरनारे नाह पुण मोज मोचती होदणारे रेती। <verse eid="2TI 3:4" /><verse number="5" style="v" sid="2TI 3:5" />ता बोक्‍तीन वेह ते देरती, पुण तान सेक्तीह नाय मानती; ओहला माणहा हेऱ्या रेन सेटा रिज्यो। <verse eid="2TI 3:5" /><verse number="6" style="v" sid="2TI 3:6" />ताम रेन कोलाक ओहला माणहे हेते जा गेरा माय मोनेस रिग जातेह, एने पापान दोसाम दाबायील, एने आलेग आलेग बातीन लोब लालुस माय फोस रेन्युह, ता ओहल्यु कोमजोर बायकुह ताबाम केरतेह, <verse eid="2TI 3:6" /><verse number="7" style="v" sid="2TI 3:7" />ज्‍यु कायेम हिकते ते रेत्युह, पुण खेरायीन ओलखात वोर नाह पोचत्यु। <verse eid="2TI 3:7" /><verse number="8" style="v" sid="2TI 3:8" />जिहकेरीन यन्नेस एने यम्ब्रेस न्या मुसान विरोद किरेल एता, तिहेस केरीन ज्या बी खेरायीन विरोद केरतेह; ता ओहला माणहे हेते, जान बुद्दी बिगेड़ गियीह, एने ता बोरहान बाराम आरवाय जातेह। <verse eid="2TI 3:8" /><verse number="9" style="v" sid="2TI 3:9" />पुण ता ज्याह रेन ओंगाण नाह वोड़ सेकते, काहाकाय आखा माणहे तान फोगवायीह देखती काय ता कोलाक फोगा हेते। तिहेस केरीन जीहे यन्नेस एने यम्ब्रेसा हिऱ्यो एनो।<verse eid="2TI 3:9" /></para>
  <para style="s">संकटाम रेन वोचणो</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10" />पुण तु मार हिकवोण, चाल चलन, मोरजी, बुरहो, वेठणेन, मोंग, दिर, एने सताव एणेम एने दुख उखेलनेन टेम माय मार सात दिनो। <verse eid="2TI 3:10" /><verse number="11" style="v" sid="2TI 3:11" /><note caller="+" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="ACT 13:14-52">प्रेरितान काम 13:14-52</ref>; </char><char style="xt" closed="false"><ref loc="ACT 14:1-7">प्रेरितान काम 14:1-7</ref>; </char><char style="xt" closed="false"><ref loc="ACT 14:8-20">प्रेरितान काम 14:8-20</ref></char></note>एने माहु पोर जो दुख अन्‍ताकिया माय इकुनियुम माय एने लुस्रा माय पुड़ेल एतो, एने जो काय मी सेहेन किरेल तो तु जाणेह, पुण मालीक माहु ताम रेन सोड़ीव लियेल। <verse eid="2TI 3:11" /><verse number="12" style="v" sid="2TI 3:12" />पुण जोला बी माणहे मसी यीशु हेऱ्या बोक्ती माय जीवणे होद्तेह, ता आखा वेला केरावाय जाती। <verse eid="2TI 3:12" /><verse number="13" style="v" sid="2TI 3:13" />पुण खाराब एने बोटकावणारे माणहे दिहराह ठेगती, एने खुद बी ठेगायेन खाराब कामा माय होवटाह बिगेड़ते जाती। <verse eid="2TI 3:13" /><verse number="14" style="v" sid="2TI 3:14" />पुण ज्यी खेरल्यु वातुह तु हिकेल एने बुरहो किरेल हे, एने जान बाराम तुवाह जाणीव एय जायेल हे, त्युह तु देर रे। <verse eid="2TI 3:14" /><verse number="15" style="v" sid="2TI 3:15" />एने तु आत्योच रेन चोखाली पुस्तेक माय जो लिखेल हे तो जाणेह, जो तुवाह इकेल आपेह काय तु यीशु मसीन बोरहान द्‍वारे सुटकारो वोर पोची। <verse eid="2TI 3:15" /><verse number="16" style="v" sid="2TI 3:16" /><note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="ft" closed="false">आखो पुस्तेक बोगवान प्रेरित किरेल हे एने वापेर माय; नाहते बोगवान प्रेरित किरेल ओहलो एकेक पुस्तेक वापेरनेन बाराबोर हे।</char></note>आखी चोखाली पुस्तेक बोगवानान योजनान द्‍वारे बोणाय गियीह, एने हिकाड़नेन, एने सोमजाड़ ने, एने हुदारने, एने देरमान हिकवोणान केरता फायदावाली हे, <verse eid="2TI 3:16" /><verse number="17" style="v" sid="2TI 3:17" />ज्यानकेरता काय बोगवानान बक्त पुरो एन आखा हाजा कामान केरता तियार एय जाय।<verse eid="2TI 3:17" /></para>
  <chapter eid="2TI 3" />
  <chapter number="4" style="c" sid="2TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1" />बोगवानाह एने मसी यीशुन उपस्थिती माय जो जीवतालान एने मुरेलान दुयून नियाव केरी, एने राजा बोणीन राज केरने आवी गोवा मानेन मी विन्ती केरथु। <verse eid="2TI 4:1" /><verse number="2" style="v" sid="2TI 4:2" />काय तु वचनान पारचार केर, टेम माय एने बिगेर टेम माय तियार रे, आखी बातीन सेहणे माय एने हिकवोण हेऱ्यो उत्साह आपीन जोर दे, एने दोपकाव एने सोमजाड़। <verse eid="2TI 4:2" /><verse number="3" style="v" sid="2TI 4:3" />काहाकाय ओहलो टेम आवी जेवी माणहे खेरलो हिकवोण नाय वेठ सेकती ता फोक्‍तो सोताह समादान जुड़ी ओहल्यु वातु काना केरीन होमेलनेन केरता आपणा लोब लालुसान गेत आपणी केरता जुलूम होवटा मास्तेर्‍याह टोलीव लेती। <verse eid="2TI 4:3" /><verse number="4" style="v" sid="2TI 4:4" />एने तान कान खेरायीन उगे रेन फेरवीन काल्पनीक वार्ता पोर लागाड़तेह। <verse eid="2TI 4:4" /><verse number="5" style="v" sid="2TI 4:5" />पुण तु आखी परीस्थिती माय सोताह ताबाम मेल दुख विस, हाजाली खोबरीन पारचार ने काम केर, एने तारी सेवाह पुरी केर।<verse eid="2TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6" />काहाकाय एवी मारो अर्पण ईथे, एने माहु ज्यो जीवणो सोड़ीन जाणेन टेम आव लागेल हे। <verse eid="2TI 4:6" /><verse number="7" style="v" sid="2TI 4:7" />मी हाजी दोवोड़ दोवेड़ लीदोह, मारो दोवड़नो मी पुरो केर लियेल हे, एने बोरहान राखवाली मी किरेल हे।<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false">बोरहावालो रियेल हे; नाहते किरेल वायदा पोर खीरलो रिनोह। </char></note> <verse eid="2TI 4:7" /><verse number="8" style="v" sid="2TI 4:8" />एवी ओंगाण मार केरता नियाव तो मुकूट मेल रिनोह, मालीक जो देरमी एने नियाव केरनार हे, ते दिह माहु आपी, एने माहु ओलोस नाह, पुण ता आखान केरता जा तान आवणेन मोंगाल्लो जाणतेह।<verse eid="2TI 4:8" /></para>
  <para style="s">व्यक्तिगत खुबेर</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9" />तुवाह एय तोलोक उतवाल्योह मार फाय आवणेन कोसीत केर। <verse eid="2TI 4:9" /><verse number="10" style="v" sid="2TI 4:10" /><note caller="+" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="COL 4:14">कुलीसियो 4:14</ref>; <ref loc="PHM 1:24">फिलेमोन 1:24</ref>; </char><char style="xt" closed="false"><ref loc="2CO 8:23">2 कुरिंथीयो 8:23</ref>; <ref loc="GAL 2:3">गलातीयो 2:3</ref>; <ref loc="TIT 1:4">तीतुस 1:4</ref></char></note>काहाकाय देमास ज्यी दुनियाह मोंगाल्ली जाणीन माहु सोड़ दिनोह, एने थिस्सलुनिक्यो माय जात रिनोह। क्रेसकेंस गलातीयाम एने तीतुस दलमतीया माय जात रिनोह। <verse eid="2TI 4:10" /><verse number="11" style="v" sid="2TI 4:11" /><note caller="+" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="COL 4:14">कुलीसियो 4:14</ref>; <ref loc="PHM 1:24">फिलेमोन 1:24</ref>; </char><char style="xt" closed="false"><ref loc="ACT 12:12">प्रेरितान काम 12:12</ref>,<ref loc="ACT 12:25">25</ref>; <ref loc="ACT 13:13">13:13</ref>; <ref loc="ACT 15:37-39">15:37-39</ref>; <ref loc="COL 4:10">कुलीसियो 4:10</ref>; <ref loc="PHM 1:24">फिलेमोन 1:24</ref></char></note>लुका ओलोस मार हिऱ्यो हे। मरकुसाह लेन आवती रे; काहाकाय सेवान केरीन तो मार केरता जुलूम मोदेक केरनार हे। <verse eid="2TI 4:11" /><verse number="12" style="v" sid="2TI 4:12" /><note caller="+" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ACT 20:4">प्रेरितान काम 20:4</ref>; <ref loc="EPH 6:21">इफिसीयो 6:21</ref>,<ref loc="EPH 6:22">22</ref>; <ref loc="COL 4:7">कुलीसियो 4:7</ref>,<ref loc="COL 4:8">8</ref></char></note>तुखीकुसाह मी इफिसुस माय मुकलेल हे। <verse eid="2TI 4:12" /><verse number="13" style="v" sid="2TI 4:13" /><note caller="+" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="ACT 20:6">प्रेरितान काम 20:6</ref></char></note>जेवी तु आवहे तेवी मार डेगलो जो मी त्रोआसाम करपुस फाय मेलीन आयेल हे, ताह एने पुस्तेक खास केरीन लेखणेन केरता चामड़ान पोत्रो लीयावजे। <figure style="fig" alt="Scrolls standing by ink well" file="hk00153c.tif" size="col" copy="Scrolls standing by ink well" ref="4:13">हाजाली स्याई केरीन लिखेल उबरियेल पोत्रा </figure><verse eid="2TI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:14 </char>
      <char style="xt" closed="false">
        <ref loc="1TI 1:20">1 तीमुथीयुस 1:20</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="ROM 2:6">रोमीयो 2:6</ref>
      </char>
    </note>आलेकजांडर ताम्रकार माहु जुलूम नुकसान पोचाड़ेल हे, मालीक तान कामान गेत ताह बुदलो आपी। <verse eid="2TI 4:14" /><verse number="15" style="v" sid="2TI 4:15" />तु बी ताह रेन जोगवीन रे, काहाकाय तो आमरी वातुन जुलूम विरोद किरेल हे।<verse eid="2TI 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16" />पेल्‍ली वार मार जापाप आपणेन टेम माय मार उगे कुणूस नाह एतो, पुण आखा माहु सोड़ दियेल एता। हाजो एय काय ताह ज्यान लेखो आपणे नाय पोड़ी। <verse eid="2TI 4:16" /><verse number="17" style="v" sid="2TI 4:17" />पुण मालीक मार मोदेक ने केरता मार हिऱ्यो उब रिनो, काहाकाय मार द्‍वारे पुरो पुरो पारचार एय एने आखा देसान माणहे होमेल लेय केरीन तो माहु ताकेत आप्यो। एने माहु मोतीन डेंडाह रेन सोड़वेल। <verse eid="2TI 4:17" /><verse number="18" style="v" sid="2TI 4:18" />मालीक माहु आखा खाराब कामाह रेन सोड़ीव लेय, एने तान हेरगान राज माय होमालीन पोचाड़ी। तान जेलेम बोड़ाय एते रेय। आमेन।<verse eid="2TI 4:18" /></para>
  <para style="s">बोरकेत</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:19 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:2">प्रेरितान काम 18:2</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="2TI 1:16">2 तीमुथीयुस 1:16</ref>,<ref loc="2TI 1:17">17</ref></char>
    </note>प्रिस्‍का एने अक्विलाह एने उनेसीफुरूसान गेराणान माणहाह नमस्‍कार। <verse eid="2TI 4:19" /><verse number="20" style="v" sid="2TI 4:20" /><note caller="+" style="x"><char style="xo" closed="false">4:20 </char><char style="xt" closed="false"><ref loc="ACT 19:22">प्रेरितान काम 19:22</ref>; <ref loc="ROM 16:23">रोमीयो 16:23</ref>; </char><char style="xt" closed="false"><ref loc="ACT 20:4">प्रेरितान काम 20:4</ref>; <ref loc="ACT 21:29">21:29</ref></char></note>इरास्तुस कुरिंथीयो माय रेय गीयोह, एने त्रुफिमुस दुखाऱ्यो एय गीयोह ताह मी मीलेतुस माय मेलीन आवोह। <verse eid="2TI 4:20" /><verse number="21" style="v" sid="2TI 4:21" />ईवालो आवणेन पेल मार फाय आवणेन कोसीत केर। युबूल एने पुदेस, एने लीनुस एने क्लोदिया, एने आखा विश्वासी बायाख नमस्‍कार।<verse eid="2TI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22" />मालीक तार जीवा हिऱ्यो रेय। एने तुमू पोर बोगवानान गीण एती रेय।<verse eid="2TI 4:22" /></para>
  <chapter eid="2TI 4" />
</usx>