<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Nahali</book>
  <para style="h">फिलेमोन</para>
  <para style="toc3">फिलेमोन</para>
  <para style="toc2">फिलेमोन</para>
  <para style="toc1">फिलेमोन पौलुस लिखेल पोत्रो</para>
  <para style="mt2">फिलेमोन पौलुस ने लिखा हुआ पत्र</para>
  <para style="mt1">फिलेमोन पौलुस लिखेल पोत्रो</para>
  <para style="imt">ओलखात</para>
  <para style="ip">फिलेमोनान आतली पुस्तेक प्रेरित पौलुसान द्‍वारे लेखाय जायेल एती। <char style="xt"><ref loc="PHM 1:1">1:1</ref></char> जेवी पौलुस ज्यी पोत्री लिखेल तेवी जेली माय एतो, ज्यान मतलब ज्यो हे काय पौलुस शायद रोम माय रेन ज्यीह लेखणे बाजरियेल ईतो। तो केदी रोम माय ईतो ते ज्यो मसीन जेल्मान 61 वोरह्या बाद लिखेल ईतो, ज्यो तो टेम हे जेवी पौलुस कुलीसियोन पोत्री लिखेल एय।</para>
  <para style="ip">तो ज्यी पोत्रीह फिलेमोन नावान एक माणहाह लिखेल ईतो। फिलेमोन मोंडलीन मेहमोर एने एक पावोरान मालीक ईतो, पौलुस ताह केणे काय तार पावोर ओनेसीमुसाह डेंड मा आपी। जो फिलेमोना फाय रेन नाह जायेल ईतो। रोमन कानुन द्‍वारा फिलेमोना फाय ओनेसीमुसाह मोतीन डेंड आपणेन आदिकार ईतो। पौलुस फिलेमोनाह एक मसी बायाख ने गेत ओनेसीमुसाह आहने केरने एने प्रोत्साहित केर। एने ज्यी बी राय आपेह काय ओनेसीमुसाह पौलुसा हिऱ्यो सेवा केरनेन केरता परवांगी आपी। <char style="xt"><ref loc="PHM 1:13-14">1:13-14</ref></char></para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. पौलुस फिलेमोनाह नमस्‍कार केरने। <char style="ior"><ref loc="PHM 1:1-3">1:1-3</ref></char></para>
  <para style="io1">2. तेवी पौलुस ओनेसीमुसान उगे रेन फुसेह काय फिलेमोन ताह एक विश्वासी बायाख ने रूप माय स्वीकार केरी। <char style="ior"><ref loc="PHM 1:4-21">1:4-21</ref></char></para>
  <para style="io1">3. पौलुस यात्रा केरनेन केरता साबासकी आपेह एने निवरावेह। <char style="ior"><ref loc="PHM 1:22-25">1:22-25</ref></char></para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="s">नमस्‍कार</para>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1" />तीमुथीयुस एने मी पौलुसान उगे रेन जो मसी यीशुन केरता बोंदी हे, आमरो मोंगाल्लो हाती फिलेमोन, <verse eid="PHM 1:1" /><verse number="2" style="v" sid="PHM 1:2" /><note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="COL 4:17">कुलीसियो 4:17</ref></char></note>एने बोणीख अफफिया, एने आमरा हाती बाहदुर अरखीपुस एने फिलेमोनान गेरान मोंडलीन नाव:<verse eid="PHM 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3" />आमरो आबोख बोगवान एने मालीक यीशु मसीन उगे रेन गीण एने हुक तुमूह जुड़ते रेय।<verse eid="PHM 1:3" /></para>
  <para style="s">फिलेमोनान मोंग एने बुरहो</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />बाहख फिलेमोन, जेलेम बोगवानान दन्यवाद केरथु, एने मारी विन्ता माय बी तुवाह एर केरथु, <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />काहाकाय मी बोगवानान माणहान प्रती तुमरो मोंग एने यीशु मसीम तुमरा बोरहान बाराम होमेलते रेथु। <verse eid="PHM 1:5" /><verse number="6" style="v" sid="PHM 1:6" />मी विन्ता केरथु काय तुमू तुमरा बोरहाह वाटणेन कायेम तियार रिवो, जिहकेरीन यीशु मसीन एकीन द्‍वारा आमरा जीवणान हाजाल्यु वातुन तुमूह हास केरीन इकेल रेणे जुवे। <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />काहाकाय एय बाहख, माहु तारा मोंगा केरीन जुलूम खुसी एने उत्साह जुड़नो, ज्यानकेरता काय तार उगे रेन बोगवानान माणहान मोने खुस एय जायेल हेते।<verse eid="PHM 1:7" /></para>
  <para style="s">उनेसीमुस ने केरता विन्ता</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />तानकेरता माहु मसी माय मोटलो दिर हे काय जी वात ठिक हे, तान उकुम तुवाह आपु। <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />तीबी माहु डावाला पौलुसाह जो एवी मसी यीशुन केरता बोंदी हे, ज्यो उंजु बी हाजो मालुम पोड़नो काय मोंगा माय विन्ता केरू।<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false">यीशु मसीन राजदुत, एने तान केरता बांदायेल; नाहते एक डावालो माणुह, एने एवी मसी यीशुन केरता बांदायेल।</char></note> <verse eid="PHM 1:9" /><verse number="10" style="v" sid="PHM 1:10" /><note caller="+" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="COL 4:9">कुलीसियो 4:9</ref></char></note>ते मी उनेसीमुस ने उगे रेन तुवाह विन्ता केरथु, जो मसी माय मार बिटोख हे, एने जेवी मी जेलीम ईतो ती टेम माय तान आत्मिक आबोख बोणनो। <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />तो ते पेल तारा काय कामान नाह ईतो, पुण एवी तार केरता एने मार केरता दुयान केरता मोटला कामान हे।<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="ft" closed="false">उनेसीमुस ज्या ग्रीक नावान मतलब, “जुलूम कामान” हे।</char></note> <verse eid="PHM 1:11" /><verse number="12" style="v" sid="PHM 1:12" />ताह जो एवी मारो कालजान टुकड़ो हे, मी तुमू फाय पुशो मुकेल ने बाजरिनोह। <verse eid="PHM 1:12" /><verse number="13" style="v" sid="PHM 1:13" />ताह मी माहुस फाय मेलन्यो ईतो काय तो तार उगे रेन ज्यी बोंदी माय जो हाजाली खोबरीन कारेण हे, मारी सेवा चाकरी केरी। <verse eid="PHM 1:13" /><verse number="14" style="v" sid="PHM 1:14" />पुण मी तारी मोरजीन बिगेर कायच नाह केरने हुद्यो काय तारी ज्यी गीण दाबाव केरीन नाह, पुण खुसी केरीन एय।<verse eid="PHM 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15" />शायद तो ज्यानकेरता तुवा हिऱ्यो रेन थोड़ाक दिह्यान केरता आलेग ईनो काय कायेम तार हिऱ्यो रेय। <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />पुण एवी रेन पावरान गेत नाह; पुण पावराह रेन बी हाजो मतलब तो माहु ते मोंगाल्लो हे, पुण तो माणुह एने एक मसी बाहख बोणनेन नाते माहु रेन वोदार ताह मोंग केर। <verse eid="PHM 1:16" /><verse number="17" style="v" sid="PHM 1:17" />केदी तु माहु तार हाती सोमजेह ते, ताह इहकेरीन लेय लीजे जीहे माहु। <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />केदी तो तारो काह नुकसान केऱ्यो एय, एने ता पोर तारो काह केरजो एय, ते मार नाव पोर लेख ले। <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />मी पौलुस मार आथा केरीन लेखथु काय मी सोता बोर देह; एने ज्यान केणेन कायच गिरेज नाह सोती काय मारो केरजो जो तार पोर हे तो तुस हे। <verse eid="PHM 1:19" /><verse number="20" style="v" sid="PHM 1:20" />एय बाहख, जी खुसी माहु मालीक माय तार उगे रेन जुड़ी मसी माय मारा जीवाह आराम आप।<verse eid="PHM 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21" />मी तारो उकुम माणनार एणेन बुरहो मेलीन तुवाह लेखथु एने ज्यो सोमेजथु काय जो काय मी केथु तु ताह रेन जादा किरहे। <verse eid="PHM 1:21" /><verse number="22" style="v" sid="PHM 1:22" />एने ज्यो बी काय मार केरता रोकाणेन गेर तियार मेल माहु आसा हे काय तुमरी विन्तान द्‍वारे मी तुमूह आपाय जाह।<verse eid="PHM 1:22" /></para>
  <para style="s">सेवल्यो नमस्‍कार</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:23 </char>
      <char style="xt" closed="false">
        <ref loc="COL 1:7">कुलीसियो 1:7</ref>; <ref loc="COL 4:12">4:12</ref></char>
    </note>इपफ्रास, जो यीशु मसीन केरता मार हिऱ्यो जेल माय बोंदी हे, <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" /><note caller="+" style="x"><char style="xo" closed="false">1:24 </char><char style="xt" closed="false"><ref loc="ACT 12:12">प्रेरितान काम 12:12</ref>,<ref loc="ACT 12:25">25</ref>; <ref loc="ACT 13:13">13:13</ref>; <ref loc="ACT 15:37-39">15:37-39</ref>; <ref loc="COL 4:10">कुलीसियो 4:10</ref>; </char><char style="xt" closed="false"><ref loc="ACT 19:29">प्रेरितान काम 19:29</ref>; <ref loc="ACT 27:2">27:2</ref>; <ref loc="COL 4:10">कुलीसियो 4:10</ref>; </char><char style="xt" closed="false"><ref loc="COL 4:14">कुलीसियो 4:14</ref>; <ref loc="2TI 4:10">2 तीमुथीयुस 4:10</ref>; </char><char style="xt" closed="false"><ref loc="COL 4:14">कुलीसियो 4:14</ref>; <ref loc="2TI 4:11">2 तीमुथीयुस 4:11</ref></char></note>एने मरकुस एने अरीस्तर्खुस एने देमास एने लुका जो माहु मोदेक केरनार हे न्यान तुवाह नमस्‍कार।<verse eid="PHM 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25" />आमरा मालीक यीशु मसीन किव तुमरा जीवा पोर ईती रेय। आमेन।<verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>