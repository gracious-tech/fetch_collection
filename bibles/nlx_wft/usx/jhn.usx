<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- Nahali</book>
  <para style="h">योहान</para>
  <para style="toc3">योहान</para>
  <para style="toc2">योहान</para>
  <para style="toc1">योहान लिखेल यीशु मसीन हाजाली खुबेर</para>
  <para style="mt2">यहुन्ना रचीत यीशु मसीह का सुसमाचार</para>
  <para style="mt1">योहान लिखेल यीशु मसीन हाजाली खुबेर</para>
  <para style="imt">ओलखात</para>
  <para style="ip">ज्यी योहानान हाजाली खुबेर ने पुस्तेक नोवाला नेम ने चार हाजाली खुबेर ने पुस्तेक माय रेन एक हे, जो यीशु मसीन जीवणान वर्णन किरेह। मत्ती, मरकुस, लुका एने योहान ज्या चार पुस्तेकाह हाजाली खुबेर केतेह। मसी यीशुन जेल्मान 90 सालान पासाण ज्यी हाजाली खुबेर प्रेरित योहान लिखेल ईतो। ज्या पुस्तेक माय लिखेल नाह सोतो काय ज्यो पुस्तेक योहान लिखेल हे। तीबी लेखणेन तरीको 1, 2, 3 योहानान पोत्रा लिखेल ता हेऱ्यो मेल खाते, योहान इफिसीयो हेयरा माय रेन ज्या पुस्तेकाह लिख्यो एय।</para>
  <para style="ip">योहान ज्या पुस्तेकान उद्देश साप साप किथे काय यीशु मसी जीवताला बोगवानान बिटोख हे <char style="xt"><ref loc="JHN 20:31">20:31</ref></char> ओहलो बुरहो केरनेन मोदेक किरेह। ता पोर बुरहो केरने से आपु तान नावा माय जीवाय जीव सेकतेह, ज्यो पुस्तेक यहुदि एने बिगेर यहुदि वाचणारान केरता लेखाय जायेल हे। योहानान हाजाली खुबेर बाकी तीन हाजाली खुबेर माय रेन थोड्युक वातु आलेग हेत्यु; एने यीशु किरेल चोमेत्कारा पोर तो द्यान लागाड़ेल हे, एने तान किस्सान बाराम जुलूम काय लिखेल नाह सुतो। यीशु मसीन बपतीस्मा एने उजाड़ी माय पारेख, न्युन गेत जुलूम खास गेटनान बाराम कियेल नाह सोतो।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. योहान हाजाली खुबेर ने सुरवात केरने। <char style="ior"><ref loc="JHN 1:1-18">1:1-18</ref></char></para>
  <para style="io1">2. पासाण तो ता थोड़ाक चोमेत्कार ने बाराम लिखेह जो यीशु किरेल। <char style="ior"><ref loc="JHN 1:19-12:50">1:19–12:50</ref></char></para>
  <para style="io1">3. तो यीशुन थोड़ीक गेटनान वर्णन किरेह जो ताह मोती हेऱ्यो ली जाथे। <char style="ior"><ref loc="JHN 13:1-20:31">13:1–20:31</ref></char></para>
  <para style="io1">4. योहान एक विस अद्याय माय निवरावेह जा माय यीशु मुरेल माय रेन जिवीन माणहान ओंगाण आवीह एने आखरी माय पुस्तेक लेखणेन उद्देश केणे। <char style="ior"><ref loc="JHN 21">21</ref></char></para>
  <chapter number="1" style="c" sid="JHN 1"/>
  <para style="s">जीवणान सोबदो</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1"/>सुरवात माय सोबदो एतो; एने सोबदो बोगवाना हेऱ्यो एतो, एने सोबदो बोगवान ईतो। <verse eid="JHN 1:1"/><verse number="2" style="v" sid="JHN 1:2"/>ज्योस सोबदो सुरवात माय रेन बोगवाना हेऱ्यो एतो। <verse eid="JHN 1:2"/><verse number="3" style="v" sid="JHN 1:3"/>एने आखो तास ने उगे रेन बोणनो, एने जो काय बुणेल हे ताम रेन काल्ली बी चिज तान बिगेर नाह बुणेल सोती। <verse eid="JHN 1:3"/><verse number="4" style="v" sid="JHN 1:4"/><note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">ता माय सोबदो जीवायीन मुल एतो; नाहते सोबदान समंद ने कारेण जो काय बाणायेल एतो ता माय जीवाय एतो।</char></note>सोबदा माय जीवाय एतो, एने तो जीवाय माणहान केरता उजालो लावो। <verse eid="JHN 1:4"/><verse number="5" style="v" sid="JHN 1:5"/>उजालो आंदारलाम चोमकीह, एने आंदारो ताह केदी बी जिक नाह सिकेत।<verse eid="JHN 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:6 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 3:1">मत्ती 3:1</ref>; <ref loc="MRK 1:4">मरकुस 1:4</ref>; <ref loc="LUK 3:1">लुका 3:1</ref>,<ref loc="LUK 3:2">2</ref></char>
    </note>बोगवान एक खोबर्‍याह मुकल्यो, एने तान नाव योहान एतो, <verse eid="JHN 1:6"/><verse number="7" style="v" sid="JHN 1:7"/>तो उजालान गोवाय केणेन केरता आवो, एने आखा माणहे तान खुबेर होमलीन बोगवाना पोर बुरहो मेलती। <verse eid="JHN 1:7"/><verse number="8" style="v" sid="JHN 1:8"/>तो सोता ते उजालो नाह ईतो; पुण ता उजालान गोवाय केणेन केरता आयेल ईतो। <verse eid="JHN 1:8"/><verse number="9" style="v" sid="JHN 1:9"/>खेरलो उजालो ज्योस हे जो दुनियाम आवण्यो ईतो एने आखा माणहा पोर उजेड़ किरेह।<verse eid="JHN 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 1:10"/>तो सोबदो दुनियाम एतो, एने बोगवान तान द्‍वारा दुनियाह बाणायेल, तीबी दुनियान माणहे ताह नाह ओलख्या। <verse eid="JHN 1:10"/><verse number="11" style="v" sid="JHN 1:11"/>तो तान माणहा फाय आवो, पुण तान माणहे ताह नाह मान्या। <verse eid="JHN 1:11"/><verse number="12" style="v" sid="JHN 1:12"/>पुण जोलाक ताह मान लेदा, मतलब जोला बी माणहे तान नावा पोर बुरहो केरतेह; तो ताह बोगवानान सोरा बोणनेन आदिकार आप्यो। <verse eid="JHN 1:12"/><verse number="13" style="v" sid="JHN 1:13"/>ता नाहते लुय केरीन नाहते सेरीरान आसा माय ता माणहान आसा माय, पुण बोगवानान उगे रेन पायदा ईयेल हेते।<verse eid="JHN 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14"/>एने सोबदो माणहान सेरीर बोणीन आवो, एने गीण एने खेराय माय पाको एन आमरी विचीम रिनो। एने आमु तान ओहली बोड़ाय देख्या, जिहकेरीन आबाख ने एकुस बेटाख ने बोड़ाय।<verse eid="JHN 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15"/>योहान यीशुन बाराम गोवाय दिनो एने आयड़ीन केयो, “ज्यो तोस हे जान बाराम मी कियेल, ‘जो मार पासाण आवणे बाजरिनोह,’ तो माहु रेन मुठो हे, काहाकाय तो माहु रेन पेल ईतो।”<verse eid="JHN 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 1:16"/>काहाकाय तान गीणान बोरपुरी माय रेन आमु आखाह बोरकेत पोर बोरकेत आपीन बोगवान होवटो केर दिनो। <verse eid="JHN 1:16"/><verse number="17" style="v" sid="JHN 1:17"/>तानकेरता कायदो ते मुसान उगे रेन आपेल हे, पुण गीण एने खेराय यीशु मसीन उगे रेन आवी। <verse eid="JHN 1:17"/><verse number="18" style="v" sid="JHN 1:18"/>बोगवानाह कुण केदी नाह देख्यो। एकुस बिटोख जो आबाख ने बाराबोर हे, एने बोगवाना हेऱ्यो बोह रिनोह, ताच ने उगे रेन बोगवान सोताह देखाड़ेल हे।<verse eid="JHN 1:18"/></para>
  <para style="s">बपतीस्मा केरनार योहानान खुबेर</para>
  <para style="r">(<ref loc="MAT 3:1-12">मत्ती 3:1-12</ref>; <ref loc="MRK 1:1-8">मरकुस 1:1-8</ref>; <ref loc="LUK 3:1-18">लुका 3:1-18</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19"/>बपतीस्मा केरनार योहानान गोवाय ज्यी हे काय जेवी यहुदि आदिकारी यरूशलेम हेयरा माय रेन चाकऱ्या एने लेवीह योहाना फाय ज्यो फुसणेन केरता मोकल्या, “तु कुण हे?”<verse eid="JHN 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 1:20"/>तेवी योहान जापाप आपणेन केरता नाह नाकाऱ्यो, पुण तो हुतरो मान लिदो: “मी मसी नाह सुतो।”<verse eid="JHN 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21"/>तेवी ता योहानाह फुशा, “उवतो तु कुण हे? काय तु एलिया हे?” योहान केयो, “मी नाह सुतो,” एने ता पोशा केया, “ते काय तु जाणकार हे?”<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="ft" closed="false">जाणकार जो आवीन मसीन आवणेन बाराम गोसणा केरनेवालो ईतो। </char></note> योहान जापाप आप्यो, “नाह।”<verse eid="JHN 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22"/>तेवी ता पोशा योहानाह फुशा, “ते उवतो तु हे कुण? आमुह के काहाकाय जो आमुह मुकलेल हे। ताह आमु जापाप आप सेकहु काय तु सोतान बाराम काय किथे?”<verse eid="JHN 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23"/>योहान केयो, जिहकेरीन यशाया जाणकार कियेल हे:</para>
  <para style="q1" vid="JHN 1:23">“मी उजाड़ी माय एक आयेड़नारान बोल हे:</para>
  <para style="q2" vid="JHN 1:23">काय तुमू बोगवानान वाट हुतरी किरो!”<verse eid="JHN 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24"/>ता खोबऱ्या, जा फरिसीन उगे रेन मोकलायेल एता, <verse eid="JHN 1:24"/><verse number="25" style="v" sid="JHN 1:25"/><note caller="+" style="f"><char style="fr" closed="false">1:25 </char><char style="ft" closed="false">फरिसी मुकलेल खुबेर लेणारे; 25 ज्यान पासाण, नाहते जाह मुकलेल ता फरिसी एता।</char></note>ता योहानाह ज्यो सावाल फुशा, “तु नाह मसी हे नाह एलिया एने नाह जाणकार हे, ते उवतो बपतीस्मा काहा किरेह?”<verse eid="JHN 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26"/>योहान ताह जापाप आप्यो, “मी ते पाण्या केरीन बपतीस्मा केरथु, पुण तुमरी विच माय एक माणुह उबरिनोह ताह तुमू नाह ओलेखते। <verse eid="JHN 1:26"/><verse number="27" style="v" sid="JHN 1:27"/>मतलब मार पासाण आवण्यो हे, मी तान खाहड़ान दोयड़ी सोड़नेन बी लायेक नाह सुतो।”<verse eid="JHN 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28"/>ज्‍यु वातु यरदन नेदीन ती मीरे बेतनिया गावाम एन्यु, जाहरी योहान बपतीस्मा केरतालो।<verse eid="JHN 1:28"/></para>
  <para style="s">बोगवानान मेंड्रो</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29"/>दिहरे दिह बपतीस्मा केरनार योहान यीशुह तान उगे आवतालो देखीन केयो, “दिखो, ज्य बोगवानान गीदल्यो हे, जो दुनियान पाप उखलीन ली जाथे। <verse eid="JHN 1:29"/><verse number="30" style="v" sid="JHN 1:30"/>ज्यो तोस हे जान बाराम मी कियेल ईतो, ‘एक एदमी मार पासाण आवीह, तो माहु रेन मुठो हे, काहाकाय तो माहु रेन पेल ईतो।’ <verse eid="JHN 1:30"/><verse number="31" style="v" sid="JHN 1:31"/>माहु मालुम नाह एतो काय तो कुण हे, पुण मी पाण्या केरीन बपतीस्मा ज्यानकेरता केरतीन आवोह काय इस्राएल ने माणहे ताह जाण लेती।”<verse eid="JHN 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32"/>एने योहान इहकेरीन गोवाय दिनो: “मी चोखाला जीवाह पेरवान वेहा माय हेरगा माय रेन उतेरतालो दिखेल हे, एने तो यीशु पोर थोब गीयो। <verse eid="JHN 1:32"/><verse number="33" style="v" sid="JHN 1:33"/>मी ते ताह उंजु वोर नाह उलखेल ईतो, पुण बोगवान जो माहु पाण्या केरीन बपतीस्मा केरनेन केरता मुकलेल हे, तोस माहु कियेल, ‘जा पोर तु चोखाला जीवाह उतेरतालो एने थोबतालो दिखहे; तोस चोखाला जीवा केरीन बपतीस्मा केरनार हे।’ <verse eid="JHN 1:33"/><verse number="34" style="v" sid="JHN 1:34"/>एने मी दिख्यो,” एने ज्यो केथु काय “बोगवानान बिटोख ज्योस हे।”<verse eid="JHN 1:34"/></para>
  <para style="s">यीशुन पेल्ला चेला</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35"/>दिहरे दिह पोशा योहान एने तान चेलाम रेन दुय जाणे उबरियेल एता, <verse eid="JHN 1:35"/><verse number="36" style="v" sid="JHN 1:36"/>तेवी योहान यीशुह जातालो देखीन केयो, “दिखो, ज्यो बोगवानान गीदल्यो हे!”<verse eid="JHN 1:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37"/>तेवी ता दुय चेला योहानान ज्यी वात होमलीन यीशुन पासाण चाल देना। <verse eid="JHN 1:37"/><verse number="38" style="v" sid="JHN 1:38"/>यीशु पिलकीन ताह पासाण आवताला दिख्यो, एने ताह केयो, “तुमू कुणीह होदतेह?”</para>
  <para style="p" vid="JHN 1:38">ता यीशुह केया, “एय रब्बी तु का रीथे?” मतलब एय, “गुरू।”<verse eid="JHN 1:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39"/>यीशु योहानान चेलाह केयो, “आवहो, ते देख लिहो।” तेवी ता जाईन यीशु रेतालो तो जागो देख्या, एने ते दिह ता यीशु हेऱ्याच रेना। तो टेम हांज पोर ने कोम से कोम चार वाजतान एतो।<verse eid="JHN 1:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40"/>ता दुया माय रेन जा योहानान वात होमलीन यीशुन पासाण आयेल एता, ताम रेन एक शमोन पतरसान बाहख अन्द्रियास ईतो। <verse eid="JHN 1:40"/><verse number="41" style="v" sid="JHN 1:41"/>तो पेल तान खाज बायाख शमोनाह मिलीन केयो, “आमुह मसी, मतलब ख्रिस्त जुड़ जायेल हे।” <verse eid="JHN 1:41"/><verse number="42" style="v" sid="JHN 1:42"/>एने तो ताह यीशु फाय लावो।</para>
  <para style="p" vid="JHN 1:42">एने यीशु ताह देखीन केयो, “तु योहानान बिटोख शमोन हे, तु केफा केवाही तान मतलब पतरस एने सापोर हे।”<verse eid="JHN 1:42"/></para>
  <para style="s">यीशु फिलीपुसाह एने नथनेलाह हाद्यो</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43"/>दिहरे दिह यीशु गेलील माय जाणेन केरता ठेरायो। तो फिलीपुसाह मिलनो एने ताह केयो, “मार पासाण आव लाग!” <verse eid="JHN 1:43"/><verse number="44" style="v" sid="JHN 1:44"/>फिलीपुस, अन्द्रियास एने पतरसान हियोर बेतसेदा गावान रेणार ईतो। <verse eid="JHN 1:44"/><verse number="45" style="v" sid="JHN 1:45"/>फिलीपुस नथनेलाह मिलनो एने ताह केयो, “जान बाराम मुसान कायदा माय एने जाणकारे लिखेल हेते, तो आमुह जुड़ जाईल हे; तो युसूफान बिटोख, यीशु नासरी हे।”<verse eid="JHN 1:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46"/>नथनेल ताह केयो, “काय ईखेह हाजी चिज नासरत हेयरा माय रेन निकील सिकेह?” फिलीपुस ताह केयो, “आवीन देख ले।”<verse eid="JHN 1:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47"/>यीशु नथनेलाह तान उगे आवातालो देखीन तान बाराम केयो, “दिखो, ज्यो खेरीच इस्राएली हे; ज्याम कोपेट नाह सोती!”<verse eid="JHN 1:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48"/>नथनेल ताह केयो, “तु माहु किहीक काय उलखेह?”</para>
  <para style="p" vid="JHN 1:48">यीशु ताह जापाप आप्यो, “फिलीपुस तुवाह हादणेन पेल जेवी तु अंजीरान जाड़ा बुंदे ईतो, तेवी मी तुवाह दिखेल ईतो।”<verse eid="JHN 1:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49"/>नथनेल ताह जापाप आप्यो, “एय गुरू, तु बोगवानान बिटोख हे, तु इस्राएलान मुठलो राजा हे!”<verse eid="JHN 1:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50"/>यीशु ताह जापाप आप्यो, “मी जो तुवाह केयो काय मी तुवाह अंजीरान जाड़ा बुंदे दिखेल, केथु केरीन बुरहो किरेह? तु ज्याह रेन बी मोठ मोठा कामे दिखहे!” <verse eid="JHN 1:50"/><verse number="51" style="v" sid="JHN 1:51"/>उवतो यीशु ताह केयो, “मी तुमूह खेरीच केथु काय तुमू हेरोग उगड़ील एने बोगवानान हेरोगदुताह एने माणहान बेटाख उपेर उतेरताला एने उपेर जातालो दिखहो।”<verse eid="JHN 1:51"/></para>
  <chapter eid="JHN 1"/>
  <chapter number="2" style="c" sid="JHN 2"/>
  <para style="s">गेलीलान काना गावा माय वाराड़</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1"/>तीसरे दिह गेलीलान काना गावा माय एक वाराड़ एतो। एने यीशुन आहख बी ता एती, <verse eid="JHN 2:1"/><verse number="2" style="v" sid="JHN 2:2"/>यीशु एने तान चेला बी ता वाराड़ा माय हादेल एता। <verse eid="JHN 2:2"/><verse number="3" style="v" sid="JHN 2:3"/>जेवी अंगुरान रूह निवरी गीयो, तेवी यीशुन आहख ताह केयी, “न्या फाय अंगुरान रूह नाह सुतो।”<verse eid="JHN 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4"/>यीशु तीह जापाप आप्यो, “एय बाय, माहु काय केरनु हे तो माहु मा केय, काहाकाय एवी मारो टेम नाह आयेल सुतो।”<verse eid="JHN 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5"/>यीशुन आहख पावराह केयी, “जो काय तो तुमूह केय तोस किरज्‍यो।”<verse eid="JHN 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6"/>ताहरी यहुदि माणहान चोखो एणेन रितीन गेत आथ पाय दोवणेन देगड़ान सोव डोसरा एता, जा माय दुय दुय तीन तीन मोण पाणी होमातालो। <verse eid="JHN 2:6"/><verse number="7" style="v" sid="JHN 2:7"/>यीशु पावराह केयो, “डोसरा माय पाणी बोर दिवो।” ता डोसराह टाकाटाक बोर देना। <verse eid="JHN 2:7"/><verse number="8" style="v" sid="JHN 2:8"/>तेवी यीशु ताह केयो, “एवी पाणी काड़ीन खाणान मुखी फाय ली जावो।” तेवी ता ली गीया, <verse eid="JHN 2:8"/><verse number="9" style="v" sid="JHN 2:9"/>जेवी खाणान मुखी तो पाणी साक्यो, जो अंगुरान रूह बोण जायेल एतो, एने नाह जाणतालो काय ज्यो अंगुरान रूह कारीन आयेल हे, पुण जा पावोर पाणी काड़ेल एता ता जाणताला; ते खाणान मुखी वोवड़ाह हाद्यो <verse eid="JHN 2:9"/><verse number="10" style="v" sid="JHN 2:10"/>एने केयो, “काल्लो बी माणुह पेल हाजालो अंगुरान रूह आपणे, एने जेवी माणहे पिन साक जातेह, तेवी तोलो हाजो नाह आपणे। पुण तु ते हाजालो अंगुरान रूह एवी वोर मेल रिनोह!” <figure style="fig" alt="Filling water in the stone jars" file="lb00135c.tif" size="col" copy="Filling water in the stone jars" ref="2:7">देगड़ान ठामला माय पाणी बोरने</figure><verse eid="JHN 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11"/>यीशु गेलीलान काना गावा माय तान ज्यो पेल्लो चोमेत्कार देखाड़ीन तान बोड़ाय देखाड्यो; एने यीशुन चेला ता पोर बुरहो केऱ्या।<verse eid="JHN 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">2:12 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:13">मत्ती 4:13</ref>
      </char>
    </note>तान पासाण यीशु एने तान आहख, तान बाहख, एने तान चेला कफरनहूम हेयरा माय गीया, एने ताहरी थोड़ाह दिह रेना।<verse eid="JHN 2:12"/></para>
  <para style="s">यीशुन मोंदिर माय जाणो</para>
  <para style="r">(<ref loc="MAT 21:12-13">मत्ती 21:12-13</ref>; <ref loc="MRK 11:15-17">मरकुस 11:15-17</ref>; <ref loc="LUK 19:45-46">लुका 19:45-46</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13"/>यहुदि माणहान फसहान तिवार आहने ईतो, एने यीशु यरूशलेम माय गीयो। <verse eid="JHN 2:13"/><verse number="14" style="v" sid="JHN 2:14"/>तो मोंदिर माय बोयलाह, मेंड्राह, एने पेरवाह वेचणारे, एने पोयशा बोदेलनाराह पाटला हेऱ्यो बोहीन वेपार केरतालो दिख्यो। <verse eid="JHN 2:14"/><verse number="15" style="v" sid="JHN 2:15"/>तेवी यीशु दोयड्युन हापाटो बाणावीन आखा मेंड्राह, एने बोयलाह मोंदिर माय रेन काड़ दिनो; एने पोयशा बोदेलनारान पोयशा फाकरी दिनो एने पाटलाह उलटाव दिनो; <verse eid="JHN 2:15"/><verse number="16" style="v" sid="JHN 2:16"/>एने पेरवाह वेचणाराह केयो, “न्याह न्या रेन ली जावो! मारा आबाख ने गेराह बाजारान गेर मा बाणावो!” <verse eid="JHN 2:16"/><verse number="17" style="v" sid="JHN 2:17"/>तेवी यीशुन चेलाह एर आवी काय पुस्तेक माय लिखेल हे, “तार गेरान बोक्ती माहु आक्‍ठान गेत हेलगाड़ देय<note caller="+" style="x"><char style="xo" closed="false">2:17 </char><char style="xq" closed="false">तेवी यीशुन चेलाह एर आवी काय पुस्तेक माय लिखेल हे, “तार गेरान बोक्ती माहु आक्‍ठान गेत हेलगाड़ देय </char><char style="xt" closed="false"><ref loc="PSA 69:9">बजन 69:9</ref></char></note>।”<verse eid="JHN 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18"/>ता पोर रेन यहुदि आदिकारी यीशुह सावाल फुशा, “तु आमुह ओहलो काल्लो चोमेत्कार देखाड़ सिकेह, जाकेरीन चोमेत्कार केरनेन आदिकार पाको किरेह?”<verse eid="JHN 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">2:19 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 26:61">मत्ती 26:61</ref>; <ref loc="MAT 27:40">27:40</ref>; <ref loc="MRK 14:58">मरकुस 14:58</ref>; <ref loc="MRK 15:29">15:29</ref></char>
    </note>यीशु ताह जापाप आप्यो, “ज्या मोंदिराह तुमू ओदार दिवो, एने मी ज्याह तीन दिह्याम पुशो उबो केर देह?”<verse eid="JHN 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20"/>यहुदि आदिकारी यीशुह केया, “ज्या मोंदिराह बाणावणेन चालीह ने सोव वोरह्या लागेल हेते। एने काय तु ज्याह तीन दिह्या माय खेरीच पुशो उबो केर दिहे?”<verse eid="JHN 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 2:21"/>पुण यीशु तान सेरीरान मोंदिरान बाराम कियेल ईतो। <verse eid="JHN 2:21"/><verse number="22" style="v" sid="JHN 2:22"/>जेवी यीशु मुरेल माय रेन जीव उठनो, तेवी तान चेलाह एर आवी काय यीशु ज्यो कियेल ईतो, एने ता चोखाली पुस्तेक एने जो यीशु जो कियेल ईतो, ता सोबदा पोर बुरहो केऱ्या।<verse eid="JHN 2:22"/></para>
  <para style="s">यीशु माणहान मोनाह जाणेह</para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23"/>जेवी यीशु यरूशलेम माय फसहान नावान तिवारान टेम ईतो, ते जुलूम माणहे ता चोमेत्कार जा तो देखाड़तालो, तो देखीन तान नावा पोर बुरहो केऱ्या। <verse eid="JHN 2:23"/><verse number="24" style="v" sid="JHN 2:24"/>पुण यीशु सोताह तान बोरहा पोर नाह सोड्यो, काहाकाय तो आखाह जाणतालो। <verse eid="JHN 2:24"/><verse number="25" style="v" sid="JHN 2:25"/>एने ताह गिरेज नाह एती काय माणहान बाराम ईखेह गोवाय देय, काहाकाय यीशु सोताच जाणतालो काय माणहान मोनाम काय हे।<verse eid="JHN 2:25"/></para>
  <chapter eid="JHN 2"/>
  <chapter number="3" style="c" sid="JHN 3"/>
  <para style="s">यीशु एने नीकुदेमुस</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1"/>फरिसी माय नीकुदेमुस नावान एक माणुह एतो, तो यहुदिन आदिकारी ईतो। <verse eid="JHN 3:1"/><verse number="2" style="v" sid="JHN 3:2"/>तो एक राती यीशु फाय आवीन केयो, “एय रब्बी, आमुह मालुम हे काय तु बोगवानान उगे रेन आयेल हे। काहाकाय कुण बी ज्या चोमेत्काराह जा तु देखाड़ेह, केदी बोगवान ता हिऱ्यो नाय रेय ते देखाड़ नाह सिकेत।”<verse eid="JHN 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3"/>यीशु ताह जापाप आप्यो, “मी तुवाह खेरीच केथु, केदी एगदान नोवालो जेल्मो एया सावाय तो बोगवानान राज नाय देख सेकी।”<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">पोशो; नाहते उपेर रेन।</char></note><verse eid="JHN 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4"/>नीकुदेमुस यीशुह केयो, “माणुह जेवी डावालो एय जाय, ताहार पोशो किहीक पायदा एय सिकेह? काय तो तान आईख ने पेटाम पोशो जाईन पायदा एय सिकेह!”<verse eid="JHN 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5"/>यीशु जापाप आप्यो, “मी तुवाह खेरीच केथु, जाह वोर काल्लोस बी माणुह पाणी एने चोखाला जीवाम रेन पायदा नाय एय ताह वोर तो बोगवानान राज माय रिग नाय सेकी। <verse eid="JHN 3:5"/><verse number="6" style="v" sid="JHN 3:6"/>काहाकाय माणुह आहख आबाख फाय रेन सेरीर माय जेल्मो लिथे, पुण जो जीवान उगे रेन जेल्मो लियेल हे तो जीव हे। <verse eid="JHN 3:6"/><verse number="7" style="v" sid="JHN 3:7"/>बोंगलाय मा काय मी तुवाह केयोह, तुवाह पोशो नोवीन जेल्मो लेणे जोरवरी हे। <verse eid="JHN 3:7"/><verse number="8" style="v" sid="JHN 3:8"/>वारो जा मोन लागी ता जाणे; एने तु तान आवाज होमलेह, पुण नाह जाणेत काय तो का रेन आवीह एने का जाथे। जो कुण जीवाम रेन जेल्मो लियेल हे तो ओहलोच हे।”<verse eid="JHN 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9"/>नीकुदेमुस यीशुह सावाल फुशो, “ज्‍यु वातु किहीक एय सेकत्युह?”<verse eid="JHN 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10"/>ज्यो होमलीन यीशु ताह जापाप आप्यो, “तु इस्राएलान गुरू हे तीबी ज्‍यु वातुह नाह सुमजेत? <verse eid="JHN 3:10"/><verse number="11" style="v" sid="JHN 3:11"/>मी तुवाह खेरीच केथु काय आमुह जो मालुम हे तो केतेह, एने जो आमु दिखेल हेते तान गोवाय देतेह, एने तुमू आमरी गोवाय नाह मानते। <verse eid="JHN 3:11"/><verse number="12" style="v" sid="JHN 3:12"/>जेवी मी तुमूह दुनियान वातु कियेल; एने तुमू बुरहो नाह केरते, ते केदी मी तुमूह हेरगान वातु केह, ते ओवता किहीक बुरहो किरहो? <verse eid="JHN 3:12"/><verse number="13" style="v" sid="JHN 3:13"/>यीशु मसीन बिगेर काल्लोस माणुह हेरगा माय नाह गीयो, तो एकुस जो हेरगाम रेन उतरेल हे एने तो माणहान बिटोख हे।”<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">वचन 21 वोर ज्यो सावाल किरेल सोबदा चालु रेय सेकतेह।</char></note><verse eid="JHN 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 3:14"/>एने जिहकेरीन मुसा उजाड़ी माय पितलान गेड़हाह खाम्बा पोर उपेर चेड़ायेल ईतो, तिहेस केरीन जोरवरी हे काय माणहान बेटाख बी उपेर चेड़ावे, <verse eid="JHN 3:14"/><verse number="15" style="v" sid="JHN 3:15"/>केरीन जो कुण ता पोर बुरहो केरी ताह जेलेमक्यो जीवाय जुड़ी। <verse eid="JHN 3:15"/><verse number="16" style="v" sid="JHN 3:16"/>काहाकाय बोगवान दुनियाह ओहलो मोंग किऱ्यो काय तो तान एकुस मोंगाल्ला बेटाख आप दिनो, काहाकाय जो कुण ता पोर बुरहो केरी तो खेतेम नाय एय, पुण जेलेमक्यो जीवाय सापड़ावी। <verse eid="JHN 3:16"/><verse number="17" style="v" sid="JHN 3:17"/>बोगवान तान बेटाख दुनिया माय ज्यानकेरता नाह मुकल्यो काय दुनियान नियाव केरी, पुण ज्यानकेरता काय दुनियाह तान उगे रेन सुटकारो जुड़ी।<verse eid="JHN 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 3:18"/>जो ता पोर बुरहो किरेह तान नियाव नाय एय; पुण जो ता पोर बुरहो नाह किरेत तो दोसी ठेराय गीयो, ज्यानकेरता काय तो बोगवानान एकुस मोंगाल्ला बेटाख ने नावा पोर बुरहो नाह केऱ्यो। <verse eid="JHN 3:18"/><verse number="19" style="v" sid="JHN 3:19"/>एने आरोपी ठेराणेन कारेण ज्यो हे काय उजालो दुनियाम आवोह: पुण माणहे आंदाराह उजालाह रेन जादा मोंगाल्लो सोमज्या, काहाकाय तान कामे खाराब एता। <verse eid="JHN 3:19"/><verse number="20" style="v" sid="JHN 3:20"/>काहाकाय जो कुण खाराब काम किरेह, तो उजालाह हेऱ्यो रेन सेटो हे, एने उजालान आहने नाह आवीत, काहाकाय तान खाराब कामे उदाह एय जाती। <verse eid="JHN 3:20"/><verse number="21" style="v" sid="JHN 3:21"/>पुण जो खेरायीन वाटी पोर चालेह तो उजालान आहने आवीह, काहाकाय तान काम देखाती काय ता बोगवानान उगे रेन केराय जाईल हेते।<verse eid="JHN 3:21"/></para>
  <para style="s">यीशु एने योहान</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22"/>तान पासाण यीशु एने तान चेला यहुदिया ईलाका माय आवा, एने यीशु ता हिऱ्यो रेन बपतीस्मा केरने बाज गीयो। <verse eid="JHN 3:22"/><verse number="23" style="v" sid="JHN 3:23"/>योहान बी शालेम हेयरान आहने एनोन नेदी एती ती माय बपतीस्मा केरतालो, काहाकाय ताहरी जुलूम पाणी एतो। एने माणहे ता फाय आवताला, एने तो बपतीस्मा केरतालो। <verse eid="JHN 3:23"/><verse number="24" style="v" sid="JHN 3:24"/><note caller="+" style="x"><char style="xo" closed="false">3:24 </char><char style="xt" closed="false"><ref loc="MAT 14:3">मत्ती 14:3</ref>; <ref loc="MRK 6:17">मरकुस 6:17</ref>; <ref loc="LUK 3:19">लुका 3:19</ref>,<ref loc="LUK 3:20">20</ref></char></note>योहान ती टेम माय जेलीम कोंडायेल नाह ईतो।<verse eid="JHN 3:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 3:25"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">3:25 </char>
      <char style="ft" closed="false">यहुदि; थोड़ाक लेख माय थोड़ाक यहुदि माणहे लिखेल हे।</char>
    </note>ताहरी योहानान चेलान एक यहुदि माणहा हेऱ्यो चोखो एणेन रितीन बाराम बोलाचाल एनी। <verse eid="JHN 3:25"/><verse number="26" style="v" sid="JHN 3:26"/>एने ता योहाना फाय जाईन ताह केया, “एय गुरू, जो माणुह यरदन नेदीन ती पार तार हिऱ्यो ईतो, एने जान बाराम तु कियेल ईतो? देख, तो बपतीस्मा किरेह, एने आखा ता फाय जातेह!”<verse eid="JHN 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27"/>योहान ताह जापाप आप्यो, “जाह वोर माणहाह बोगवाना फाय रेन आपाय नाह जात, ताह वोर ताह काईच नाह जुड़ सिकेत। <verse eid="JHN 3:27"/><verse number="28" style="v" sid="JHN 3:28"/><note caller="+" style="x"><char style="xo" closed="false">3:28 </char><char style="xt" closed="false"><ref loc="JHN 1:20">योहान 1:20</ref></char></note>मी मसी ना सुतो, पुण तान ओंगाण मोकलायेल हे, इहकेरीन मी कियेल हे तान तुमू पुरावो हेते। <verse eid="JHN 3:28"/><verse number="29" style="v" sid="JHN 3:29"/>जान वोवड़ी हे, तोस वोवड़ो हे; एने उबरीन तान वातु हुमलेह, तो वोवड़ान हाती हे, एने तो वोवड़ान आवाज होमलीन खुस ईथे। तिहेस केरीन एवी मारी ज्यी खुसी पुरी एनीह। <verse eid="JHN 3:29"/><verse number="30" style="v" sid="JHN 3:30"/>जोरवरी हे काय मी गेटु एने तो वोदी।”<verse eid="JHN 3:30"/></para>
  <para style="s">हेरगाम रेन आवणार तो कुण हे</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31"/>जो उपेर रेन आवीह तो आखाम रेन हाजो हे। जो देरती पोर रेन आवीह तो देरतीन हे एने देरतीस ने वातु किथे, पुण जो हेरगाम रेन आवीह तो आखाह रेन उचो हे। <verse eid="JHN 3:31"/><verse number="32" style="v" sid="JHN 3:32"/>पुण जो काय तो दिखेल एने हुमलेल हे, तास ने बाराम तो गोवाय दिथे एने तान गोवायीह कुण मानेत नाह। <verse eid="JHN 3:32"/><verse number="33" style="v" sid="JHN 3:33"/>जो यीशुन गोवायीह मान लियेल हे तो ज्यी वाती पोर पाको केर दियेल हे काय बोगवान खीरलो हे। <verse eid="JHN 3:33"/><verse number="34" style="v" sid="JHN 3:34"/>काहाकाय जाह बोगवान मुकलेल हे तो बोगवानान वातु किथे, काहाकाय तो जीव माप मापीन नाह आपेत। <verse eid="JHN 3:34"/><verse number="35" style="v" sid="JHN 3:35"/><note caller="+" style="x"><char style="xo" closed="false">3:35 </char><char style="xt" closed="false"><ref loc="MAT 11:27">मत्ती 11:27</ref>; <ref loc="LUK 10:22">लुका 10:22</ref></char></note>आबोख बेटाख मोंग किरेह एने तो आखो काय तान आथाम आप दियेल हे। <verse eid="JHN 3:35"/><verse number="36" style="v" sid="JHN 3:36"/>जो बेटाख पोर बुरहो किरेह, जेलेमक्यो जीवाय तास ने हे; पुण जो बेटाख ने उकुम नाह मानेत तो जीवायीह नाय देखी, पुण बोगवानान राग ता पोर रिथे।<verse eid="JHN 3:36"/></para>
  <chapter eid="JHN 3"/>
  <chapter number="4" style="c" sid="JHN 4"/>
  <para style="s">यीशु एने सामरी बायकु</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1"/>जेवी फरिसी होमल्या काय यीशु योहानाह रेन होवटा चेला बाणावीह एने ताह बपतीस्मा दिथे। <verse eid="JHN 4:1"/><verse number="2" style="v" sid="JHN 4:2"/>पुण यीशु सोता बपतीस्मा नाह देतालो; पुण तान चेला बपतीस्मा देताला। <verse eid="JHN 4:2"/><verse number="3" style="v" sid="JHN 4:3"/>जेवी यीशु होमल्यो काय फरिसी ओहली वातु केरने बाजरेनाह, तेवी यीशु यहुदियाह सोड़ीन पुशो गेलील माय जात रिनो। <verse eid="JHN 4:3"/><verse number="4" style="v" sid="JHN 4:4"/>एने यीशुह सामरीया लागतो गेलील माय जाणे जोरवरी एतो।<verse eid="JHN 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 4:5"/>यीशु सामरीयान सुखार नावान एक हेयरा माय आवो, जो ता खेतान आहने हे जाह याकुब तान बेटाख युसूफाह आपेल ईतो। <verse eid="JHN 4:5"/><verse number="6" style="v" sid="JHN 4:6"/>ताहरी याकुबान वावड़ी एती, एने यीशु चाली चालीन लेवाय जायेल ईतो, केरीन ती वावड़ी हेऱ्यो बोह गीयो। ज्यी वात हिराणेन टेम माय एवी।<verse eid="JHN 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7"/>तुलेचबूखे ता एक सामरी बायकु पाणी बोरने आवी, एने यीशु तीह केयो, “माहु पाणी पिणेन केरता आप।” <verse eid="JHN 4:7"/><verse number="8" style="v" sid="JHN 4:8"/>काहाकाय यीशुन चेला ते हेयराम रूटो वेचातो लेणेन केरता जाय रियेल एता।<verse eid="JHN 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9"/>ती सामरी बायकु यीशुह केयी, “तु यहुदि हे एने मी सामरी जातीन हे, तीबी तु मार फाय पाणी काहा मांगेह?” काहाकाय यहुदि माणहे सामरी माणहा हेऱ्या काल्लोस वेवारो नाह मेलताला।<note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="ft" closed="false">काहाकाय यहुदि माणहे सामरी जातीन माणहे वापरेल ठामलान वापेर नाह केरताला; एने यहुदि एने सामरी माय काय मेल जोल नाह। </char></note><verse eid="JHN 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10"/>यीशु तीह जापाप आप्यो, “केदी तु बोगवानान दानाह जाणती, एने ज्यो बी जाणती काय ज्यो कुण हे जो माहु पाणी पिवाड़ केणार, ते तु ता फाय मांगती एने तो तुवाह जीवायीन पाणी आपतो।”<verse eid="JHN 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11"/>ती बायकु यीशुह केयी, “एय मालीक, तुवा फाय पाणी काड़नेन केरता ते बादल्यो नाह सोतो, एने वावड़ी उंडी हे। ते उवतो तो जीवायीन पाणी तुवा फाय कारीन आवो? <verse eid="JHN 4:11"/><verse number="12" style="v" sid="JHN 4:12"/>आमरो आबोख याकुब ज्यी वावड़ी आमुह आपेल हे; तो सोता एने तान सोरा। एने तान जेनवारे ज्योस पाणी पिताला, एने ताह रेन तु मुठो हे काय?”<verse eid="JHN 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13"/>यीशु तीह जापाप आप्यो, “जो कुण बी ज्यो पाणी पिय तो पोशो तीहल्योच रेय, <verse eid="JHN 4:13"/><verse number="14" style="v" sid="JHN 4:14"/>पुण मी जो जीवाणान पाणी आपुह तो पाणी जो कुण बी पिय, ताह केदी तीह नाय लागी। तो पाणी तान जीवाय माय एक वोयतो जिर बोण जाय जो जेलेमक्यो जीवाय ने केरता वोयते रेय।”<verse eid="JHN 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15"/>ती बायकु यीशुह केयी, “एय मालीक, माहु तीह नाय लागी एने दाड़ीन दिह पाणी बोरने न्या आवणे नाय पोड़ी केरीन तो पाणी माहु आप दे।”<verse eid="JHN 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16"/>यीशु तीह केयो, “तु जाईन तार एदम्याह न्या हादिन लाव।”<verse eid="JHN 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17"/>ती यीशुह केयी, “मारो एदमी ना सोतो।”</para>
  <para style="p" vid="JHN 4:17">यीशु तीह जापाप आप्यो, “तु खेरीच किथे, तारो एदमी नाह सुतो। <verse eid="JHN 4:17"/><verse number="18" style="v" sid="JHN 4:18"/>काहाकाय तु पाच एदमी किरेल हे, एने जा फाय तु एवी रीथे तो बी तारो एदमी नाय मीले। ज्यो तु खेरीच कियेल हे।”<verse eid="JHN 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19"/>ती बायकु यीशुह केयी, “एय मालीक, माहु लागेह काय तु जाणाव केरनार हे। <verse eid="JHN 4:19"/><verse number="20" style="v" sid="JHN 4:20"/>आमरा डायडाया सामरी ज्यास बोयड़ा पोर बोगवानान बोक्ती किरेल एता, पुण तु यहुदि किथे काय जो ज्यी बोक्ती केरने जुवे तो जागो यरूशलेम माय हे।”<verse eid="JHN 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21"/>यीशु तीह केयो, “एय बाय, मारी वाती पोर बुरहो केर, ओहली टेम आवीह काय तुमू हेरगावाला आबाख ने बोक्ती नाह ज्या बोयड़ा पोर नाह यरूशलेम माय किरहो। <verse eid="JHN 4:21"/><verse number="22" style="v" sid="JHN 4:22"/>तुमरा सामरी माणहे जाह नाह जाणते तान बोक्ती केरतेह; पुण आमु यहुदि जाणतेह काय कुणीन बोक्ती केरनु हे, काहाकाय सुटकारो यहुदि माय रेन हे। <verse eid="JHN 4:22"/><verse number="23" style="v" sid="JHN 4:23"/>पुण तो टेम आवीह, पुण एवी बी हे, जा माय खेरला बोक्ती केरनारे हेरगावाला आबाख ने बोक्ती जीव एने खेराय माय केरती, काहाकाय हेरगावालो आबोख तान केरता ओहलाच बोक्ती केरनाराह हुदेह। <verse eid="JHN 4:23"/><verse number="24" style="v" sid="JHN 4:24"/>बोगवान जीव हे, एने जोरवरी हे काय तान बोक्ती केरनारे जीव एने खेराय माय बोक्ती केरी।”<verse eid="JHN 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25"/>ती बायकु यीशुह केयी, “माहु मालुम हे मसी जाह ख्रिस्त केतेह तो आवण्यो हे, जेवी तो आवी, तेवी तो आमुह आखी वातु केय देय।”<verse eid="JHN 4:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26"/>यीशु तीह जापाप आप्यो, “जो तुवा हिऱ्यो वातु केरने बाजरिनोह, तो मीच हे।”<verse eid="JHN 4:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27"/>तुलेचबूखे यीशुन चेला आव लागा, एने बोंगलाणे बाज गीया काय यीशु ती बायकु हिऱ्यो वातु केरने बाजरिनोह। तीबी ता कुणूस तीह नाह फुशा, “तुवाह काय जुवेह?” एने नाह यीशुह फुशा, “काय तु काहा जी हिऱ्यो वातु किरेह?”<verse eid="JHN 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28"/>तेवी ती बायकु तीन डोसरो ताच सोड़ीन हेयराम जाईन माणहाह केयी, <verse eid="JHN 4:28"/><verse number="29" style="v" sid="JHN 4:29"/>“चालो, एक माणहाह दिखो, जो मी किरेल एती तो आखो केय दियेल, तोस मसी ते ना सुतो।” <verse eid="JHN 4:29"/><verse number="30" style="v" sid="JHN 4:30"/>तेवी माणहे हेयराम रेन निकलीन यीशु फाय आवणे बाज गीया।<verse eid="JHN 4:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31"/>चेला यीशुह केया, “एय गुरू, रूटो खायले!”<verse eid="JHN 4:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32"/>पुण यीशु चेलाह केयो, “मार फाय खाणेन केरता ओहलो खाणो हे जाह तुमू नाह जाणते।”<verse eid="JHN 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33"/>तेवी चेला एका दिहराह केया, “काय एगदो ज्यानकेरता काह खाणेन लावो एय?”<verse eid="JHN 4:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34"/>यीशु चेलाह केयो, “मारो खाणो ज्यो हे काय जो माहु मुकलेल हे, ताह पुटे तिहे चालु एने तान काम जो माहु हुपेल हे तो पुरो केरू। <verse eid="JHN 4:34"/><verse number="35" style="v" sid="JHN 4:35"/>काय तुमू नाह जाणते, ‘काटणेन केरता उंजु चार मोयना बाकी हेते?’ मी तुमूह केथु; तुमरी नेजेर टाकीन खेताह दिखो, ता काटणेन केरता पाक जायेल हेते। <verse eid="JHN 4:35"/><verse number="36" style="v" sid="JHN 4:36"/>काटणार मोंजरी सापड़ावणे एने जेलेमक्यो जीवाय ने केरता पाक टुलो किरेह; काहाकाय पेरनार एने काटणार दुयू मिलीन मोंज केरी। <verse eid="JHN 4:36"/><verse number="37" style="v" sid="JHN 4:37"/>काहाकाय न्याहरीह ज्यी केवायीन वात खेरीच बुहेह, ‘पेरनार दिहरो हे, एने काटणार दिहरो।’ <verse eid="JHN 4:37"/><verse number="38" style="v" sid="JHN 4:38"/>मी तुमूह ता खेताम पाक काटणेन केरता मोकेलथु जा माय तुमू मेहनेत नाह किरेल सोता; पुण दिहरा मेहनेत केऱ्या एने तुमू तान मेहनेत ने पाक माय जोड़ाय गीया।”<verse eid="JHN 4:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39"/>ता हेयरान जुलूम होवटा सामरी माणहे ती बायकुन केणा पोर रेन यीशु पोर बुरहो केऱ्या, काहाकाय ती ज्यी गोवाय दियेल एती, “तो आखो जो मी किरेल एती माहु केय दियेल ईतो।” <verse eid="JHN 4:39"/><verse number="40" style="v" sid="JHN 4:40"/>केरीन सामरी माणहे यीशु फाय आवीन केया, आमु फाय रे, तेवी यीशु ता दुय दिह वोर रिनो।<verse eid="JHN 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 4:41"/>यीशुन वचन होमलीन उंजु बी जुलूम होवटा माणहे बुरहो केऱ्या। <verse eid="JHN 4:41"/><verse number="42" style="v" sid="JHN 4:42"/>एने ता माणहे ती बायकुह केया, “एवी तु किथे केरीस ने आमु बुरहो नाह केरते, काहाकाय आमु सोता होमली लियेल हेते, एने जाणतेह काय ज्योस खेरीच दुनियाह सुटकारो आपणार हे।”<verse eid="JHN 4:42"/></para>
  <para style="s">यीशु आदिकारीन सोराह हुदारने</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43"/>यीशु दुय दिह ता रिनो, उवतो ता रेन गेलील माय गीयो, <verse eid="JHN 4:43"/><verse number="44" style="v" sid="JHN 4:44"/><note caller="+" style="x"><char style="xo" closed="false">4:44 </char><char style="xt" closed="false"><ref loc="MAT 13:57">मत्ती 13:57</ref>; <ref loc="MRK 6:4">मरकुस 6:4</ref>; <ref loc="LUK 4:24">लुका 4:24</ref></char></note>काहाकाय यीशु सोता गोवाय दियेल ईतो, “जाणकाराह तान देसाम मान पान नाह जुड़ने।” <verse eid="JHN 4:44"/><verse number="45" style="v" sid="JHN 4:45"/><note caller="+" style="x"><char style="xo" closed="false">4:45 </char><char style="xt" closed="false"><ref loc="JHN 2:23">योहान 2:23</ref></char></note>जेवी यीशु गेलील माय आवो, तेवी गेलील वाला माणहे तान स्वागत केऱ्या, काहाकाय यरूशलेम माय तिवारान टेम माय जोला चोमेत्कार यीशु किरेल ईतो आखाह ता दिखेल एता, काहाकाय ता माणहे बी तिवाराम जायेल एता।<verse eid="JHN 4:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:46 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 2:1-11">योहान 2:1-11</ref>
      </char>
    </note>तेवी यीशु गेलील ने काना गावा माय पुशो आवो, जाहरी तो पाण्यान अंगुरान रूह बाणायेल ईतो। एने ताहरी राजान एक रोमन आदिकारी ईतो, तान बिटोख कफरनहूम हेयरा माय दुखाऱ्यो ईतो। <verse eid="JHN 4:46"/><verse number="47" style="v" sid="JHN 4:47"/>तेवी यीशुह यहुदिया माय रेन गेलील माय आव रिनोह ज्यो होमलीन तो यीशु फाय जाईन रावण्या केरीन केयो, कफरनहूम चाल मारा सोराह हुदार दे, काहाकाय तान सोरो मोरने केरतालो। <verse eid="JHN 4:47"/><verse number="48" style="v" sid="JHN 4:48"/>यीशु ताह केयो, “जाह वोर तुमू निसाणी एने चोमेत्कारान कामाह नाय दिखहो ताह वोर केदी बुरहो नाय किरहो।”<verse eid="JHN 4:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49"/>राजान आदिकारी यीशुह केयो, “एय मालीक, मार सोराह मोरनेन पेल चाल।”<verse eid="JHN 4:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50"/>यीशु ताह केयो, “जा; तारो बिटोख जीवतालोच हे!”</para>
  <para style="p" vid="JHN 4:50">तो माणुह यीशुन वाती पोर बुरहो केरीन जात रिनो। <verse eid="JHN 4:50"/><verse number="51" style="v" sid="JHN 4:51"/>तो जाणे बाजरियेल ईतो तेवी तान पावरे वाटे आव मिलना एने ताह केया, “तारो बिटोख वोच जायेल हे!”<verse eid="JHN 4:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 4:52"/>तो ताह फुशो, “कुलबुखे हाजो एवालो?” पावरे ताह केया, “काल हिराण एक वाजता तान हेरी उतेर जायेल।” <verse eid="JHN 4:52"/><verse number="53" style="v" sid="JHN 4:53"/>तेवी तान आबोख सोमजी गीयो काय ज्यो तुलबूखे एनो जुलबुखे यीशु ताह कियेल ईतो, “तारो बिटोख जीवतालो हे।” तो एने तान आखो गेराणो यीशु पोर बुरहो केऱ्या।<verse eid="JHN 4:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54"/>ज्यो दिहरो चोमेत्कार एतो, जो यीशु यहुदिया ईलाका माय रेन गेलील गावाम आवीन देखाड़ेल ईतो।<verse eid="JHN 4:54"/></para>
  <chapter eid="JHN 4"/>
  <chapter number="5" style="c" sid="JHN 5"/>
  <para style="s">तेला हेऱ्यो हुदारने</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1"/>तान पासाण यहुदिन एक तिवार ईनो, केरीन यीशु यरूशलेम माय गीयो। <verse eid="JHN 5:1"/><verse number="2" style="v" sid="JHN 5:2"/><note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">मेंड्रान बायणा हेऱ्यो एक कुंड; नाहते मेंड्रान कुंड हेऱ्यो एक जागो बेतसेदा; थोड़ाक लेख माय बेथसदा लिखेल हे।</char></note>यरूशलेम माय मेंड्रान बायणा हेऱ्यो कुंड हे, ताह इब्रानी बाषाम बेतसेदा केताला; तान आहने पाच माला एता। <verse eid="JHN 5:2"/><verse number="3" style="v" sid="JHN 5:3"/><note caller="+" style="f"><char style="fr" closed="false">5:3 </char><char style="ft" closed="false">थोड़ाक लेख माय वचन 3-4 जुड़ेल हे।</char></note>ता माय जुलूम होवटा दुखाऱ्या आंदला, लेंगड़ा, एने पांगला पाणी आलनेन आसा माय ता लोट रेताला। <verse eid="JHN 5:3"/><verse number="4" style="v" sid="JHN 5:4"/>काहाकाय एक खास टेम हेरोगदुत तेला माय उतरीन पाण्याह आलाड्या केरताला, पाणी आलताच जो बी पेल कुदतालो तो हुदरी जातालो ताह काल्ली बी बेमारी काहा नाय रेय ती हुदरी जाताली।<note caller="+" style="f"><char style="fr" closed="false">5:4 </char><char style="ft" closed="false">ज्यो वचन मुल लेख माय नाह सोतो।</char></note> <verse eid="JHN 5:4"/><verse number="5" style="v" sid="JHN 5:5"/>ताहरी आड़तीस वोरह्यान एक दुखाऱ्यो माणुह एतो। <verse eid="JHN 5:5"/><verse number="6" style="v" sid="JHN 5:6"/>यीशु ताह लुट रियेल देखीन जाण गीयो काय ज्यो जुलूम दिह्यान दुखाऱ्यो ज्यी देशा माय पोड़ रियेल हे, एने यीशु ताह फुशो, “काय तु हुदेरने हुदेह?”<verse eid="JHN 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7"/>तो दुखाऱ्यो माणुह यीशुह जापाप आप्यो, “एय मालीक, पाणी आलाड़ाय जाणे बुखेत माहु पाण्याम उतारनार काल्लोस माणुह नाह सोतो; एने माहु पोचता पोचता माहु रेन पेलुस दिहरो उतेर जाथे।”<verse eid="JHN 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8"/>यीशु ताह केयो, “उठ, तारो खाटलो उखलीन चालने बाज्जा।” <verse eid="JHN 5:8"/><verse number="9" style="v" sid="JHN 5:9"/>तो माणुह चालोच हुदरी गीयो, एने तान खाटलो उखलीन चालने बाज गीयो।</para>
  <para style="p" vid="JHN 5:9">ज्यो आखो ईयेल एतो तो विहेवणेन दिह ईतो। <verse eid="JHN 5:9"/><verse number="10" style="v" sid="JHN 5:10"/>केरीन यहुदि माणहे पेल जो दुखाऱ्यो एतो, पुण एवी हुदरी जायेल एतो, ता माणहाह केया, “आज ते विहेवणेन दिह हे, एने खाटलो उखलीन चालने आपणा नियमान विरोद हे।”<verse eid="JHN 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11"/>तो माणुह ताह जापाप आप्यो, “जो माहु हुदारेल हे, तोस माहु कियेल, तारो खाटलो उखलीन चालने बाज्जा।”<verse eid="JHN 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12"/>ता यीशुह फुशा, “तारो खाटलो उखलीन चाल इही केणार तो काल्लो माणुह हे?”<verse eid="JHN 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13"/>पुण जो हुदरी जायेल एतो, तो माणुह नाह जाणतालो तो कुण हे, काहाकाय बिड़ जुलूम एती केरीन यीशु ता रेन निकलीन जात रियेल ईतो।<verse eid="JHN 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14"/>तान बाद तो माणुह यीशुह मोंदिर माय मिलानो तेवी यीशु ताह केयो, “देख, तु हुदरी जायेल हे; एवी रेन पुशो पाप मा किरहे, नाह ते तार पोर ताह रेन होवटीह पिढ़ा आव पोड़ी।”<verse eid="JHN 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 5:15"/>तो माणुह जाईन यहुदि आदिकारीह केयो, “जो माहु हुदारेल हे तो यीशु हे।” <verse eid="JHN 5:15"/><verse number="16" style="v" sid="JHN 5:16"/>केरीन यहुदि आदिकारी यीशुह विताड़ने बाज गीया, काहाकाय तो ओहला काम विहेवणेन दिह्या केरतालो। <verse eid="JHN 5:16"/><verse number="17" style="v" sid="JHN 5:17"/>यीशु ताह जापाप आप्यो, “मारो आबोख आज वोर काम किरते रीथे, एने माहु बी काम किरतेच रेणे जुवे।”<verse eid="JHN 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 5:18"/>तानकेरता यहुदि आदिकारी यीशुह मारावणेन उंजु बी होवटाह कोसीत केरने बाज गीया; काहाकाय तो विहेवणेन दिह्यान नेमाह तोड़तालो, एने इही ओलोच नाह पुण बोगवानाह मारो आबोख किन सोताह बोगवानान बाराबोर बाणावतालो।<verse eid="JHN 5:18"/></para>
  <para style="s">बेटाख ने आदिकार</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19"/>तानकेरता यीशु ताह जापाप आप्यो, “मी तुमूह खेरी खेरीच केथु: बिटोख सोता तान मोरजी माय काय नाह केर सिकेत; पुण जा जा कामे आबाख केरतालो दिखेह। ताह बिटोख बी किरेह। <verse eid="JHN 5:19"/><verse number="20" style="v" sid="JHN 5:20"/>काहाकाय आबोख बेटाख मोंग किरेह, एने जा जा कामे तो सोता किरेह, तो आखा ताह देखाड़ेह। तुमू बोंगलाहो केरीन तो न्याह रेन बी मोटला काम ताह देखाड़ी। <verse eid="JHN 5:20"/><verse number="21" style="v" sid="JHN 5:21"/>जीहे आबोख मुरेल ताह उठाड़ीन जीवतालो किरेह, तिहेच बिटोख बी जाह जीवाड़ ने हुदेह ताह जीवाड़ेह। <verse eid="JHN 5:21"/><verse number="22" style="v" sid="JHN 5:22"/>आबोख कुणीन बी नियाव नाह केरने। पुण नियाव केरनेन सोब काम बेटाख आप दियेल हे, <verse eid="JHN 5:22"/><verse number="23" style="v" sid="JHN 5:23"/>ज्यानकेरता काय आखा माणहे जीहे आबाख ने मान मेलतेह, तिहेच केरीन बेटाख ने बी मान मेलतेह। जो बेटाख ने मान नाह मिलेत तो आबाख ने जो ताह मोकलेल हे तान मान नाह मिलेत।”<verse eid="JHN 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24"/>मी तुमूह खेरीच केथु, “जो मारो वचन होमलीन माहु मोकेलनारा पोर बुरहो किरेह: ताह जेलेमक्यो जीवाय जुड़ेह। एने ता पोर डेंडान उकुम नाह रेत, पुण तो मोतीह पार केरीन जीवणाम रिग जायेल हे। <verse eid="JHN 5:24"/><verse number="25" style="v" sid="JHN 5:25"/>मी तुमूह खेरीच केथु, मुरेल माणहाह बोगवानान बेटाख ने बोल होमेलनेन टेम आवी, एवी तो टेम आव लागेल हे एने जा तान बोल होमेलती, ता जीवताला एय जाती। <verse eid="JHN 5:25"/><verse number="26" style="v" sid="JHN 5:26"/>काहाकाय जिहकेरीन आबोख सोता माय जीवणान जिर हे, तिहेच केरीन तो बेटाख बी ज्यो आदिकार आपेल हे काय सोता माय जीवायीन जिर मेली। <verse eid="JHN 5:26"/><verse number="27" style="v" sid="JHN 5:27"/>एने तो माणहान बिटोख हे, केरीन नियाव केरनेन ताह आदिकार बी आपेल हे। <verse eid="JHN 5:27"/><verse number="28" style="v" sid="JHN 5:28"/>केरीन बोंगलाहो मा; काहाकाय टेम आवणे बाजरिनोह काय मुरेल बी तान बोल होमेलती <verse eid="JHN 5:28"/><verse number="29" style="v" sid="JHN 5:29"/>जा हाजा कामे किरेल हेते: ता जेलेमक्यो जीवाय ने केरता जीव उठती, एने जा खाराब कामे किरेल हेते ता डेंड बोगेतणेन केरता जीव उठती।”<verse eid="JHN 5:29"/></para>
  <para style="s">यीशुन बाराम गोवाय</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 5:30"/>मी सोतान मोरजी माय काय नाह केर सिकेत; एने मी नियाव किरेत नाह, पुण बोगवान कियेल हे तिहे नियाव केरथु, एने मारो नियाव खेरलो हे, काहाकाय मी मारी मोरजी नाह पुण माहु मोकेलनारान मोरजी होदथु।<verse eid="JHN 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31"/>केदी मी सोतास मारीस गोवाय देह, ताहार मारी गोवाय खेरली नाय मिले। <verse eid="JHN 5:31"/><verse number="32" style="v" sid="JHN 5:32"/>मार बाराम गोवाय देणार दिहरो हे, एने जी गोवाय तो मार बाराम दिथे ती खेरली हे, ज्यो मी जाणथु। <verse eid="JHN 5:32"/><verse number="33" style="v" sid="JHN 5:33"/><note caller="+" style="x"><char style="xo" closed="false">5:33 </char><char style="xt" closed="false"><ref loc="JHN 1:19-27">योहान 1:19-27</ref>; <ref loc="JHN 3:27-30">3:27-30</ref></char></note>तुमू योहान बपतीस्मा केरनारा फाय मोकलीन फुसाड्या, एने तो खेरायीन बाराम गोवाय दियेल हे। <verse eid="JHN 5:33"/><verse number="34" style="v" sid="JHN 5:34"/>पुण मी मार बाराम माणहान गोवाय नाह होदित; तीबी मी ज्‍यु वातु ज्यानकेरता केथु काय तुमूह सुटकारो जुड़ी। <verse eid="JHN 5:34"/><verse number="35" style="v" sid="JHN 5:35"/>योहान ते पेटतालो एने उजालो आपणार दिवो ईतो, एने तुमूह थोड़ीक टेम वोर तान उजालाम खुस एणेन हाजो लागो। <verse eid="JHN 5:35"/><verse number="36" style="v" sid="JHN 5:36"/>पुण मार फाय जी गोवाय हे ती योहानान गोवायीह रेन मोठी हे: काहाकाय जो काम आबोख माहु पुरो केरनेन हुपेल हे, मतलब जो काम मी केरथु, ज्यास काम मार बाराम गोवाय देतेह काय आबोख माहु मोकलेल हे। <verse eid="JHN 5:36"/><verse number="37" style="v" sid="JHN 5:37"/><note caller="+" style="x"><char style="xo" closed="false">5:37 </char><char style="xt" closed="false"><ref loc="MAT 3:17">मत्ती 3:17</ref>; <ref loc="MRK 1:11">मरकुस 1:11</ref>; <ref loc="LUK 3:22">लुका 3:22</ref></char></note>एने आबोख जो माहु मोकलेल हे, तोस मार बाराम गोवाय दियेल हे। तुमू तान आवाज केदिस होमल्या नाह एने तान वेह बी दिखेल नाह सोता, <verse eid="JHN 5:37"/><verse number="38" style="v" sid="JHN 5:38"/>एने तान वचन तुमरा मोना माय मोजबुत नाह मेलते, काहाकाय जाह तो मोकलेल हे तान तुमू बुरहो नाह केरती। <verse eid="JHN 5:38"/><verse number="39" style="v" sid="JHN 5:39"/>तुमू पुस्तेक माय होदतेह, काहाकाय तान द्‍वारा तुमूह जेलेमक्यो जीवाय जुड़ी इही तुमूह लागेह। एने ज्यो तोस हे जो मार बाराम गोवाय दिथे! <verse eid="JHN 5:39"/><verse number="40" style="v" sid="JHN 5:40"/>तीबी तुमू जीवाय होदणेन केरता मार फाय आवणे नाह होदते।<verse eid="JHN 5:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41"/>“मी माणहा फाय रेन बोड़ाय नाह होदित। <verse eid="JHN 5:41"/><verse number="42" style="v" sid="JHN 5:42"/>पुण मी तुमूह जाणथु काय तुमू काल्ली बातीन माणहे हेते, एने ज्यो बी जाणथु काय बोगवानान मोंग तुमरे मोना माय ना सोतो। <verse eid="JHN 5:42"/><verse number="43" style="v" sid="JHN 5:43"/>मी मारा आबोख बोगवानान नाव से आयेल हे, एने तुमू माहु नाह मानते; केदी दिहरा सोतान नाव लेन आवती, ताहार तुमू तान मान लिहो। <verse eid="JHN 5:43"/><verse number="44" style="v" sid="JHN 5:44"/>एकुस बोगवान फाय रेन आवणार मानाह तुमू नाह होदते, पुण तुमू एका दिहरा फाय रेन मान होदतेह, ते तुमू किहीक मार पोर बुरहो केर सेकतेह? <verse eid="JHN 5:44"/><verse number="45" style="v" sid="JHN 5:45"/>मी आबाख ने सामने तुमू पोर गुनो लागाडुह इहकेरीन सुमजो मा, जा पोर तुमू बुरहो मीलेल हेते, तो मुसो तुमरे पोर गुनो लागाड़न्यो हे। <verse eid="JHN 5:45"/><verse number="46" style="v" sid="JHN 5:46"/>काहाकाय केदी तुमू मुसान नेम बुरहो केरता, ते मारो बी बुरहो केरता, ज्यानकेरता काय तो मार बाराम लिखेल हे। <verse eid="JHN 5:46"/><verse number="47" style="v" sid="JHN 5:47"/>पुण केदी तुमू तान लिखेल वातु पोर बुरहो नाह केरती, ते मारा वचना पोर बुरहो किहीक किरहो?”<verse eid="JHN 5:47"/></para>
  <chapter eid="JHN 5"/>
  <chapter number="6" style="c" sid="JHN 6"/>
  <para style="s">यीशु पाच एजार माणहाह खावाड़ ने</para>
  <para style="r">(<ref loc="MAT 14:13-21">मत्ती 14:13-21</ref>; <ref loc="MRK 6:30-44">मरकुस 6:30-44</ref>; <ref loc="LUK 9:10-17">लुका 9:10-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1"/>ज्‍यु वातुन पासाण यीशु गेलील देरीयान, मतलब तीबीरीयास हेयरान देरीयान ती मीरे गीयो। <verse eid="JHN 6:1"/><verse number="2" style="v" sid="JHN 6:2"/>एने माणहान होवटाली गेरदी यीशुन पासाण चाल पोड़नी, काहाकाय दुखाऱ्या माणहान केरता जो चोमेत्कार यीशु केरतालो ता ताह दिखेल एता। <verse eid="JHN 6:2"/><verse number="3" style="v" sid="JHN 6:3"/>तेवी यीशु बोयड़ा पोर चेड़ीन तान चेला हिऱ्यो ताहरी बोह गीयो। <verse eid="JHN 6:3"/><verse number="4" style="v" sid="JHN 6:4"/>एने यहुदिन फसहान तिवार आहने एतो। <verse eid="JHN 6:4"/><verse number="5" style="v" sid="JHN 6:5"/>जेवी यीशु उपेर नेजेर केरीन माणहान होवटाली गेरदीह ता फाय आवतालो दिख्यो, ते फिलीपुसाह केयो, “न्या आखाह खाणेन केरता आपु रोटा कारीन वेचाता लावहु?” <verse eid="JHN 6:5"/><verse number="6" style="v" sid="JHN 6:6"/>यीशु ज्यी वात ताह पारेखणेन केरता कियेल, काहाकाय तो सोता जाणतालो काय तो काय किरन्यो ईतो।<verse eid="JHN 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">6:7 </char>
      <char style="ft" closed="false">चांदीन सिक्को; चांदीन एक सिक्को मतलब गावा माय मोंजरी केरनारान एक दिह्यान कामाय हे (देखी मत्ती 20:2।)</char>
    </note>फिलीपुस यीशुह जापाप आप्यो, “न्या माय रेन एक एक जाण थोड़ो थोड़ो खाती, तीबी दुय होव रूपियान<note caller="+" style="f"><char style="fr" closed="false">6:7 </char><char style="ft" closed="false">दुय होव रूपियान ज्यान किमोत आज ने जोमानाम सेचाड़ीस एजार हे।</char></note> रोटा पुरती नाय।” <verse eid="JHN 6:7"/><verse number="8" style="v" sid="JHN 6:8"/>तान चेला माय रेन शमोन पतरसान बाहख अन्द्रियास यीशुह केयो, <verse eid="JHN 6:8"/><verse number="9" style="v" sid="JHN 6:9"/>“न्याहरी एक आत्योच सोरो हे, ता फाय जुवारीन पाच रोटा एने दुय मासा हेते। पुण ता ओला माणहान केरता किहीक पुरती?”<verse eid="JHN 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10"/>यीशु केयो, “माणहाह बोहाड़ दिवो।” ता जागाम जुलूम खेड़ एतो। तेवी ताहरी एदम्यान गेणती कोमीत कोमी पाच एजारान एती; ता आखा बोह गीया। <verse eid="JHN 6:10"/><verse number="11" style="v" sid="JHN 6:11"/>तेवी यीशु रोटा आथाम देरीन बोगवानान दन्यवाद केरीन बोह रियेल माणहाह वाट दिनो। एने तिहेच केरीन मासाह बी जोलोक ताह जोवतालो, तोलोक वाट दिनो। <verse eid="JHN 6:11"/><verse number="12" style="v" sid="JHN 6:12"/>जेवी ता पेट बोरीन खाईन आफरी गीया, तेवी यीशु तान चेलाह केयो, “रोटान उगरेल टुकड़ा टुलो केर लिवो काय बी विरेखणे नाय जुवे।” <verse eid="JHN 6:12"/><verse number="13" style="v" sid="JHN 6:13"/>ओवता ता टुलो केऱ्या एने ता जुवारीन पाच रोटान टुकड़ा माय रेन जा आखा खायलीन पासाण उगरेल एता, ता बारा टोपला बोरीन टुलो केऱ्या।<verse eid="JHN 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">6:14 </char>
      <char style="ft" closed="false">जाणकार (देखी 1:21।)</char>
    </note>यीशु फाय रेन ज्यो चोमेत्काराह देखीन माणहे केणे बाज गीया, “दुनियाम जो जाणाव केरनार आवण्यो ईतो तो खेरीच ज्योस हे!” <verse eid="JHN 6:14"/><verse number="15" style="v" sid="JHN 6:15"/>यीशु ज्य जाण गीयो काय ता माहु राजा बाणावणेन केरता देरने होदतेह; तानकेरता यीशु बोयड़ा पोर एखालोच जात रिनो।<verse eid="JHN 6:15"/></para>
  <para style="s">यीशुन पाण्या पोर चालनो</para>
  <para style="r">(<ref loc="MAT 14:22-33">मत्ती 14:22-33</ref>; <ref loc="MRK 6:45-52">मरकुस 6:45-52</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16"/>जेवी हांज पोड़ गियी, तेवी यीशुन चेला देरीयान दिड़े गीया, <verse eid="JHN 6:16"/><verse number="17" style="v" sid="JHN 6:17"/>ता रेन एक डोंडह्या माय बोहीन देरीयान ती मीरे कफरनहूम हेयरान उगे जाणे बाज गीया। तुलबूखे आंदारो पोड़ जायेल एतो, एने ताहुक वोर यीशु ता फाय आयेल नाह ईतो। <verse eid="JHN 6:17"/><verse number="18" style="v" sid="JHN 6:18"/>तेवी वादोणान वोजेसे देरीया माय लाटा आवणे बाज गीया, काहाकाय वारो जोरेस आवणे बाजरियेल एतो। <verse eid="JHN 6:18"/><verse number="19" style="v" sid="JHN 6:19"/>जेवी चेला डोंडह्याह चालाड़ी चालाड़ीन कोमीत कोमी पाच सोव किलो मिटर सेटी जात रेना, ते ता यीशुह पाण्या पोर चालीन डोंडह्या उगे आवतालो देखीन जुलूम बिय गीया। <verse eid="JHN 6:19"/><verse number="20" style="v" sid="JHN 6:20"/>पुण यीशु चेलाह केयो, “मी हे, बिवो मा!” <verse eid="JHN 6:20"/><verse number="21" style="v" sid="JHN 6:21"/>तेवी ता यीशुह डोंडह्या माय बोहाड़नेन केरता राजी एना, एने तुलेचबूखे डोंडह्यो ता ईलाका माय पोच गीयो, जाहरी ताह पोचणो एतो।<verse eid="JHN 6:21"/></para>
  <para style="s">माणहे यीशुह होदणु</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22"/>दिहरे दिह जा माणहे देरीयान ती मीरे एता, ताह ज्यो मालुम पोड़नो काय एक आत्योच डोंडह्यो ताहरी एतो, एने ज्य बी काय यीशु तान चेला हिऱ्यो डोंडह्या माय नाह ईतो, पुण निस्ता यीशुन चेला ओलाच जायेल एता। <verse eid="JHN 6:22"/><verse number="23" style="v" sid="JHN 6:23"/>जाहरी मालक्यान दन्यवाद केरीन ओवता ता रोटा खाईल, ती जागान आहने तीबीरीयास हेयराम रेन दिहरा डोंडह्या आवीन थोबना। <verse eid="JHN 6:23"/><verse number="24" style="v" sid="JHN 6:24"/>तेवी माणहे देख्या काय ताहरी यीशु एने तान चेला नाह सोता, तेवी ता आत आत्‍यास डोंडह्या माय बोहीन यीशुह होदतीन कफरनहूम गावाम पोचना।<verse eid="JHN 6:24"/></para>
  <para style="s">यीशु जीवायीन रूटो</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25"/>देरीयान ती मीरे ता यीशुह मीलना ते केया, “एय गुरू, तु न्या कुलबुखे आवो?”<verse eid="JHN 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26"/>यीशु ताह जापाप आप्यो, “मी तुमूह खेरीच केथु, तुमू चोमेत्कार दिखेल केरीन नाह, पुण पेट बोरीन रूटो खाईल केरीन माहु होदतेह। <verse eid="JHN 6:26"/><verse number="27" style="v" sid="JHN 6:27"/>खेतेम एण्या खाणान केरता मेहनेत मा किरो; पुण ता खाणान केरता जो जेलेमक्यो जीवाय वोर टिकीन रीथे, जाह माणहान बिटोख तुमूह आपेह। काहाकाय आबोख, मतलब बोगवान तास पोर साप लागाड़ेल हे।”<verse eid="JHN 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28"/>ओवता ता यीशुह केया, “बोगवान जो हुदेह तो काम केरनेन केरता आमु काय किरज्‍यो?”<verse eid="JHN 6:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29"/>यीशु ताह जापाप आप्यो, “बोगवानान काम ज्योस हे काय माहु जो मुकलेल हे ता पोर तुमू बुरहो किरो।”<verse eid="JHN 6:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30"/>तेवी माणहे यीशुह केया, “उवतो तु काल्ली निसाणी देखाड़ेह काय आमु तीह देखीन तार पोर बुरहो किरज्‍यो? एने एवी तु ओंगाण काय किरहे? <verse eid="JHN 6:30"/><verse number="31" style="v" sid="JHN 6:31"/>आमरा बाप दादा उजाड़ी माय मन्ना खाईल एता, जिहकेरीन पुस्तेक माय लिखेल हे, ‘तो ताह हेरगाम रेन रूटो खाणेन आपेल ईतो।’”<verse eid="JHN 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">6:32 </char>
      <char style="ft" closed="false">जो मुसो आपेल तो नाह; नाहते जाह तो तुमूह आपेल तो मुसा नाह ईतो।</char>
    </note>यीशु ताह केयो, “मी तुमूह खेरीच केथु। तो रूटो मुसो तुमूह हेरगाम रेन नाह आपेल ईतो; पुण मारो आबोख तुमूह हेरगाम रेन खीरलो रूटो आपेह। <verse eid="JHN 6:32"/><verse number="33" style="v" sid="JHN 6:33"/>काहाकाय बोगवानान रूटो तोस हे जो हेरगाम रेन उतरीन दुनियाह जीवाय आपेह।”<verse eid="JHN 6:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34"/>तेवी माणहे यीशुह केया, “एय मालीक, ज्यो रूटो आमुह जेलेम आप्या केर।”<verse eid="JHN 6:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35"/>यीशु ताह केयो, “जीवायीन रूटो मी हे, जो मार फाय आवीह तो केदी बुखल्यो नाय रेय। एने जो मार पोर बुरहो मिलेह, तो केदी तिहल्यो नाय रेय। <verse eid="JHN 6:35"/><verse number="36" style="v" sid="JHN 6:36"/>पुण मी तुमूह कियेल ईतो काय तुमू माहु देख बी लियेल हेते, तीबी तुमू मार पोर बुरहो नाह केरते। <verse eid="JHN 6:36"/><verse number="37" style="v" sid="JHN 6:37"/>जो काय आबोख माहु आपेह तो आखो मार फाय आवी। एने जो कुण मार फाय आवी ताह मी केदी नाय काडु, <verse eid="JHN 6:37"/><verse number="38" style="v" sid="JHN 6:38"/>काहाकाय मी सोतान मारी मोरजी पुरी केरने नाह, पुण माहु मोकेलनारान मोरजी पुरी केरनेन केरता हेरगाम रेन उतरेल हे। <verse eid="JHN 6:38"/><verse number="39" style="v" sid="JHN 6:39"/>एने माहु मोकेलनारान मोरजी ज्‍यीस हे काय जो काय तो माहु आपेल हे ता माय रेन मी कुणीह बी नाय टाकु, पुण सेवले दिह ता आखाह पुशो जीवता केर देह। <verse eid="JHN 6:39"/><verse number="40" style="v" sid="JHN 6:40"/>काहाकाय मारा आबाख ने मोरजी ज्‍यीस हे काय जो बेटाख देखीन ता पोर बुरहो किरेह, तो जेलेमक्यो जीवाय सापड़ावी। एने मी ताह सेवले दिह पुशो जीवतो केरूह।”<verse eid="JHN 6:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41"/>“मी हेरगाम रेन उतरेल रूटो हे,” इहकेरीन यीशु कियेल केरीन यहुदि यीशुन बाराम कुरकुर केरने बाज गीया। <verse eid="JHN 6:41"/><verse number="42" style="v" sid="JHN 6:42"/>एने ता केया, “ज्यो ते युसूफान बिटोख यीशु हे, ज्यान आईख आबाख आपु ओलेखतेह। ते ज्यो किहीक केय सिकेह काय मी हेरगाम रेन उतरेल हे?”<verse eid="JHN 6:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43"/>यीशु ताह जापाप आप्यो, “तुमू आपसाम कुरकुर मा किरो।” <verse eid="JHN 6:43"/><verse number="44" style="v" sid="JHN 6:44"/>कुण बी मार फाय नाह आव सिकेत जाह वोर आबोख जो माहु मुकलेल हे ताह खेच नाय लेय; एने सेवले दिह मी ताह पुशो जीवतो केरूह। <verse eid="JHN 6:44"/><verse number="45" style="v" sid="JHN 6:45"/>जाणाव केरनारान पुस्तेक माय इहकेरीन लिखेल हे, “ता आखा बोगवानान उगे रेन हिकाड़ेल रेती।”<note caller="+" style="x"><char style="xo" closed="false">6:45 </char><char style="xt" closed="false"><ref loc="ISA 54:13">यशाया 54:13</ref></char></note> जो कुण आबाख ने होमलीन हिकेल हे, तो मार फाय आवीह। <verse eid="JHN 6:45"/><verse number="46" style="v" sid="JHN 6:46"/>जो बोगवानान उगे रेन हे तोस आबाख दिखेल हे; ताह सोड़ीन दिहरो कुण आबाख नाह दिखेल सोतो। <verse eid="JHN 6:46"/><verse number="47" style="v" sid="JHN 6:47"/>मी तुमूह खेरीच केथु काय जो मार पोर बुरहो किरेह: ताह जेलेमक्यो जीवाय जुड़ेह। <verse eid="JHN 6:47"/><verse number="48" style="v" sid="JHN 6:48"/>जीवायीन रूटो मी हे। <verse eid="JHN 6:48"/><verse number="49" style="v" sid="JHN 6:49"/>तुमरा बाप दादा उजाड़ी माय मन्ना खाईल तीबी ता मोर गीया। <verse eid="JHN 6:49"/><verse number="50" style="v" sid="JHN 6:50"/>हेरगाम रेन उतेरनार रूटो ओहलो हे काय जो कुण ताह खाय तो मोरी नाय। <verse eid="JHN 6:50"/><verse number="51" style="v" sid="JHN 6:51"/>हेरगाम रेन उतरेल जीवणान रूटो मी हे। ज्या रोटाह खाणारे जेलेम जीवताला रेती। एने जो रूटो मी दुनियान माणहान जीवायीन केरता आपुह, तो मारो सेरीर हे।<verse eid="JHN 6:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52"/>तेवी यहुदि तान तान लेड़ाणे बाज गीया, “ज्यो माणुह किहीक आमुह तान सेरीर खाणेन केरता आप सिकेह?”<verse eid="JHN 6:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53"/>यीशु ताह केयो, “मी तुमूह खेरीच केथु जाह वोर तुमू माणहान बेटाख ने सेरीर नाय खाहो, एने तान लुय नाय पिहो, ताहार तुमरे माय जीवाय नाह सोतो। <verse eid="JHN 6:53"/><verse number="54" style="v" sid="JHN 6:54"/>जो मारो सेरीर खातेह एने मारी लुय पिथे, जेलेमक्यो जीवाय तास ने हे एने सेवले दिह मी ताह जीवतो केरूह। <verse eid="JHN 6:54"/><verse number="55" style="v" sid="JHN 6:55"/>काहाकाय मारो सेरीर खेरलो खाणो हे; एने मारी लुय पिणेन खेरली चिज हे। <verse eid="JHN 6:55"/><verse number="56" style="v" sid="JHN 6:56"/>जो मारो सेरीर खातेह एने मारी लुय पिथे तो मार माय रीथे, एने मी ता माय रिथे। <verse eid="JHN 6:56"/><verse number="57" style="v" sid="JHN 6:57"/>जिहकेरीन जीवतालो आबोख माहु मुकलेल हे, एने मी आबाख ने वोजेसे जीवतालो हे। तिहेच केरीन जो बी माहु खाय तो मार वोजेसे जीवतालो रेय। <verse eid="JHN 6:57"/><verse number="58" style="v" sid="JHN 6:58"/>जो रूटो हेरगाम रेन उतरेल तो ज्योस हे, तुमरा बाप दादा मन्ना खाईल तीबी ता मोर गीया। तोहलो नाह, जो बी ज्या रोटाह खाय, तो जेलेम जीवतालो रेय।”<verse eid="JHN 6:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 6:59"/>ज्‍यु वातु यीशु कफरनहूम गावान एक बोक्ती केरन्या गेरा माय हिकवोण आपणेन टेम माय केयो।<verse eid="JHN 6:59"/></para>
  <para style="s">जेलेमक्यी जीवायीन वचन</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60"/>तानकेरता यीशुन चेलाम रेन जुलूम जाणे ज्यो होमलीन केया, “ज्‍यु वातु केठीण हेत्यु। ज्यीह कुण मान सिकेह?”<verse eid="JHN 6:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61"/>यीशु तान मोना माय ज्यो जाणीन काय मारा चेला तान ताच ने ज्यी वाती पोर कुड़कुड़ावतेह, ताह फुशो, “काय मार कियेल वातुम तुमूह ठुकोर लागेह? <verse eid="JHN 6:61"/><verse number="62" style="v" sid="JHN 6:62"/>एने केदी तुमू माणहान बेटाख जाहरी तो पेल ईतो, ताहरी उपेर जातालो दिखहो, ताहार काय एय? <verse eid="JHN 6:62"/><verse number="63" style="v" sid="JHN 6:63"/>बोगवानान जीव हे; एने माणहान ताकेत काल्लास बी कामान नाह। जो मी तुमूह कियेल हे तो बोगवानान जीव हे एने तोस जीवाय आपेह। <verse eid="JHN 6:63"/><verse number="64" style="v" sid="JHN 6:64"/>पुण तुमू माय थोड़ाक ओहला हेते जा बुरहो नाह केरते।” काहाकाय यीशुह पेलुच रेन मालुम एतो काय जा बुरहो नाह केरते, ता कुण हेते एने कुण माहु दुको देय। <verse eid="JHN 6:64"/><verse number="65" style="v" sid="JHN 6:65"/>एने यीशु केयो, “मार फाय कुण नाह आव सिकेत जाहुक वोर मारो हेरगावालो आबोख ताह मार फाय आवणेन पारवांगी नाह आपेत।”<verse eid="JHN 6:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66"/>तेवी यीशुन चेलाम रेन जुलूम चेला पासाण पोलटी गीया, एने तान बाद ता हेऱ्या नाह रेना। <verse eid="JHN 6:66"/><verse number="67" style="v" sid="JHN 6:67"/>तेवी यीशु ता बारा चेलाह केयो, “काय तुमू बी जाणे होदतेह?”<verse eid="JHN 6:67"/></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:68 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:16">मत्ती 16:16</ref>; <ref loc="MRK 8:29">मरकुस 8:29</ref>; <ref loc="LUK 9:20">लुका 9:20</ref></char>
    </note>शिमोन पतरस यीशुह जापाप आप्यो, “एय मालीक, आमु कुणी फाय जाज्यो? काहाकाय जेलेमक्यो जीवायीन वातु तारीस फाय हेत्यु। <verse eid="JHN 6:68"/><verse number="69" style="v" sid="JHN 6:69"/>एने आमु बुरहो केऱ्या, एने जाण जायेल हेते काय बोगवानान चोखालो एक तुस हे।”<verse eid="JHN 6:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70"/>यीशु ताह जापाप आप्यो, “काय मी तुमूह बारा जाणाह नाह निवाड्यो? तीबी तुमरे माय रेन एक माणुह सैतान हे!” <verse eid="JHN 6:70"/><verse number="71" style="v" sid="JHN 6:71"/>इहकेरीन यीशु शिमोन इस्‍कोरितीन बिटोख यहुदान बाराम केयो। काहाकाय तोस जो ता बाराम रेन एक ईतो, यीशुह देरावण्यो ईतो।<verse eid="JHN 6:71"/></para>
  <chapter eid="JHN 6"/>
  <chapter number="7" style="c" sid="JHN 7"/>
  <para style="s">यीशु एने तान बाहख</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1"/>ज्‍यु वातुन पासाण यीशु गेलील माय फिरतो रिनो; काहाकाय यहुदि ताह मार टाकणेन कोसीत केरने बाजरियेल एता, तानकेरता तो यहुदिया माय फिरने नाह होदतालो। <verse eid="JHN 7:1"/><verse number="2" style="v" sid="JHN 7:2"/>यहुदिन तोम्बुन तिवार आहने ईतो, <verse eid="JHN 7:2"/><verse number="3" style="v" sid="JHN 7:3"/>तानकेरता यीशुन बाहख ताह केया, “न्या रेन यहुदिया माय जातरे, काहाकाय जो काम तु किरेह ता कामाह तारा चेला बी ता देख सिके। <verse eid="JHN 7:3"/><verse number="4" style="v" sid="JHN 7:4"/>काहाकाय जो कुण सोताह माणहा माय देखाड़ने हुदेह, तो लिकाईन काम नाह किरेत। केदी तु ज्या कामे किरेह, ते आखी दुनियाम आपणे आपाह देखाड़ दे!” <verse eid="JHN 7:4"/><verse number="5" style="v" sid="JHN 7:5"/>काहाकाय यीशुन बाहख बी ता पोर बुरहो नाह केरताला।<verse eid="JHN 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6"/>तेवी यीशु ताह केयो, “मारो टेम एवी वोर नाह आवो। पुण तुमरी केरता सोब टेम ठिख हे। <verse eid="JHN 7:6"/><verse number="7" style="v" sid="JHN 7:7"/>ज्यी दुनियान माणहे तुमू हेऱ्या दुसमोनाय नाह केर सेकते, पुण ता मार हेऱ्या दुसमोनाय केरतेह, काहाकाय मी तान विरोद माय ज्यी गोवाय देथु काय तान काम खाराब हेते। <verse eid="JHN 7:7"/><verse number="8" style="v" sid="JHN 7:8"/><note caller="+" style="f"><char style="fr" closed="false">7:8 </char><char style="ft" closed="false">मी नाह जात; थोड़ाक लेख माय मी एवी नाह जाणे बाजरिनोह।</char></note>तुमू तिवारा माय जावो। मी ज्या तिवारा माय एवी नाह जात, काहाकाय मारो टेम उंजु नाह आयेल सुतो।” <verse eid="JHN 7:8"/><verse number="9" style="v" sid="JHN 7:9"/>इहकेरीन ताह किन यीशु गेलील मायच रेय गीयो।<verse eid="JHN 7:9"/></para>
  <para style="s">तोम्बुन तिवारा माय यीशु</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10"/>पुण जेवी यीशुन बाहख तिवार माय जात रेना, तेवी यीशु बी गीयो; तो उदाह नाह, पुण मोनेस तिवाराम गीयो। <verse eid="JHN 7:10"/><verse number="11" style="v" sid="JHN 7:11"/>यहुदि तिवाराम यीशु “काहरी हे?” इहकेरीन केयीन होदणे बाज गीया।<verse eid="JHN 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12"/>एने माणहा माय यीशुन बाराम मोन मोने मोकत्यु वातु एन्यु। थोड़ाक माणहे केताला, “ज्यो हाजो माणुह हे।” एने थोड़ाक माणहे केताला, “नाह, तो माणहाह बोड़कावेह।” <verse eid="JHN 7:12"/><verse number="13" style="v" sid="JHN 7:13"/>तीबी यहुदिन बिताला केरीन काल्लो बी माणुह यीशुन बाराम हास केरीन वात नाह केरतालो।<verse eid="JHN 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14"/>एने जेवी आदो तिवार आपटाणेन पासाण यीशु मोंदिर माय जाईन हिकवोण आपणे बाज गीयो। <verse eid="JHN 7:14"/><verse number="15" style="v" sid="JHN 7:15"/>तेवी यहुदि बोंगलायीन केया, “ज्याह बिगेर हिकेल विद्या किहीक आव लागी?”<verse eid="JHN 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16"/>यीशु ताह जापाप आप्यो, “मारो हिकवोण मारो नाह, पुण माहु मोकेलनारान हे। <verse eid="JHN 7:16"/><verse number="17" style="v" sid="JHN 7:17"/>जो कुण बोगवानान मोरजी पोर चालने होदि, ताहार तो ज्या हिकवोणान बाराम जाण जाय काय ज्यो बोगवानान उगे रेन हे, तो काय मी मार उगे रेन बाणावीन केथु। <verse eid="JHN 7:17"/><verse number="18" style="v" sid="JHN 7:18"/>जो तान उगे रेन बाणावीन काह किथे, तो तास ने बोड़ाय हुदेह। पुण जो ताह मोकेलनारान बोड़ाय हुदेह तोस खीरलो हे, एने ता माय काय अन्याय नाह। <verse eid="JHN 7:18"/><verse number="19" style="v" sid="JHN 7:19"/>मुसो तुमूह नेम नाह आप्यो काय? पुण तुमू माय रेन कुणूस बी नेम पोर नाह चालेत। तुमू काहा माहु मारावणे होदतेह?”<verse eid="JHN 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20"/>माणहे यीशुह जापाप आप्या, “तार माय बुतड़ो हे! कुण तुवाह मारावणे हुदेह?”<verse eid="JHN 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21"/>यीशु ताह जापाप आप्यो, “मी एक काम किऱ्यो, एने केरीन तुमू आखा बोंगलातेह। <verse eid="JHN 7:21"/><verse number="22" style="v" sid="JHN 7:22"/>ज्यास ने वोजेसे मुसो तुमूह खेतनान उकुम आपेल हे ज्यो उकुम मुसान उगे रेन नाह, पुण बाप दादा रेन चालते आवीह, एने तुमू विहेवणेन दिह सोरान खेतना केरतेह। <verse eid="JHN 7:22"/><verse number="23" style="v" sid="JHN 7:23"/><note caller="+" style="x"><char style="xo" closed="false">7:23 </char><char style="xt" closed="false"><ref loc="JHN 5:9">योहान 5:9</ref></char></note>मुसान नेम नाय तुटे केरीन सोरान खेतना विहेवणेन दिह्या केराय जाथे, इही ताहार विहेवणेन दिह एक माणहाह हास केरीन हुदार दिनो केरीन तुमू काहा मार पोर राग केरतेह। <verse eid="JHN 7:23"/><verse number="24" style="v" sid="JHN 7:24"/>बाहेर देखाणार वातुन नियाव मा किरो, पुण मोनान खेरलो नियाव किरो।”<verse eid="JHN 7:24"/></para>
  <para style="s">काय यीशुस मसी हे?</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25"/>तेवी यरूशलेम हेयरा मायवाला थोड़ाक माणहे केया, “काय ज्यो तो एदमी नाह सोतो जाह यहुदि आदिकारी मारावणेन कोसीत केरने बाजरेनाह? <verse eid="JHN 7:25"/><verse number="26" style="v" sid="JHN 7:26"/>पुण दिखो, ज्यो ते उदाह वातु किरेह एने कुण ज्याह काईच नाह केत! ज्योस मसी हे, इहकेरीन यहुदि आदिकारी खेरीच ओलखी लियेल हेते काय? <verse eid="JHN 7:26"/><verse number="27" style="v" sid="JHN 7:27"/>पुण आमु जाणतेह काय ज्यो एदमी कारीन आयेल हे, जेवी मसी आवी। तेवी कुण बी जाण नाय सेकी काय तो कावालो हे।”<verse eid="JHN 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28"/>तेवी यीशु मोंदिर माय हिकवोण आपणे बुखेत आयड़ीन केयो, “काय तुमू माहु खेरीच ओलेखतेह? एने ज्यो बी जाणतेह काय मी कारीन आयेल हे, मी खुद ते नाह आवो। पुण माहु मोकेलनार खीरलो हे, ताह तुमू नाह जाणते, <verse eid="JHN 7:28"/><verse number="29" style="v" sid="JHN 7:29"/>पुण मी ताह जाणथु, काहाकाय मी तान उगे रेन हे एने तोस माहु मोकलेल हे।”<verse eid="JHN 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30"/>ज्या पोर रेन ता यीशुह देरने होद्या, तीबी कुण बी ता पोर आत नाह टाक्‍यो, काहाकाय तान टेम एवी वोर नाह आयेल ईतो। <verse eid="JHN 7:30"/><verse number="31" style="v" sid="JHN 7:31"/>तेवी गेरदी माय रेन जुलूम माणहे ता पोर बुरहो केऱ्या, एने केणे बाज गीया, “जेवी मसी आवी, तेवी ज्याह रेन बी वोदार चोमेत्कार देखाड़ी जाज्यो देखाड्यो?”<verse eid="JHN 7:31"/></para>
  <para style="s">यीशुह देरनेन कोसीत</para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32"/>फरिसी माणहाह मोन मोने यीशुन बाराम वात केरताला होमल्या, एने मुखी चाकऱ्या एने फरिसी ताह देरनेन केरता सिपाय मोकल्या। <verse eid="JHN 7:32"/><verse number="33" style="v" sid="JHN 7:33"/>तेवी यीशु ताह केयो, “मी थोड़ीक वार वोर उंजु तुमरी हिऱ्यो हे, उवतो जो माहु मुकलेल हे ता फाय पुशो जात रेह। <verse eid="JHN 7:33"/><verse number="34" style="v" sid="JHN 7:34"/>तुमू माहु हुदहो, पुण मी तुमूह नाय सापडु, एने जाहरी मी रेह, ताहरी तुमू आव नाह सेकते।”<verse eid="JHN 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35"/>तानकेरता यहुदि एका दिहरा हेऱ्या वातु केरने बाज गीया, “ज्यो काहरी जाय काय आपु ज्याह होद नाय सेकज्यो? काय ज्यो ता फाय जाय जाहरी आपणा यहुदि युनानी माणहाम वेरासेर एन रेतेह, एने ता माणहाह बी हिकाड़ी? <verse eid="JHN 7:35"/><verse number="36" style="v" sid="JHN 7:36"/>तुमू माहु हुदहो, पुण मी तुमूह नाय सापडु, एने जाहरी मी रेह ताहरी तुमू नाय आव सिकहो। तो इहकेरीन कियेल तान मतलब काय हे?”<verse eid="JHN 7:36"/></para>
  <para style="s">जीवायीन पाण्यान खुदोर</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37"/>तिवारान सेवली खास दिह्या यीशु उठनो एने आयड़ीन केयो, “केदी एगदो तिहल्यो एय ताहार मार फाय आवीन पिय, <verse eid="JHN 7:37"/><verse number="38" style="v" sid="JHN 7:38"/><note caller="+" style="f"><char style="fr" closed="false">7:38 </char><char style="ft" closed="false">वचन 37-38 ने अनुवाद, “जो कुण तिहल्यो एय, तो मार फाय आवीन पिय,” 38 जिहकेरीन पुस्तेक किथे, “जो कुण मार पोर बुरहो केरी, जीवाय आपणार जीवताला पाण्यान खोदऱ्यु ता माय रेन वोयती।” </char></note> एने जो मार पोर बुरहो केरी। जिहकेरीन पुस्तेक माय लिखेल हे, ‘जीवाय आपणार जीवताला पाण्यान खोदऱ्यु,’ ता माय रेन वोयती।” <verse eid="JHN 7:38"/><verse number="39" style="v" sid="JHN 7:39"/>यीशु ज्यी वात चोखाला जीवान बाराम केयो, जा ता पोर बुरहो केरतेह ताह जुड़न्यो एतो। काहाकाय जीव एवी वोर नाह उतरेल एतो, काहाकाय यीशुन एवी वोर बोड़ाय ईयेल नाह एती।<verse eid="JHN 7:39"/></para>
  <para style="s">माणहा माय फुट</para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40"/>तेवी गेरदी माय रेन थोड़ाक माणहे ज्‍यु वातुह होमलीन केया, “ज्यो माणुह खेरीच जाणाव केरनार हे!”<note caller="+" style="f"><char style="fr" closed="false">7:40 </char><char style="ft" closed="false">जाणकार (देखी 1:21।)</char></note><verse eid="JHN 7:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41"/>दिहरा केया, “ज्यो मसी हे!”</para>
  <para style="p" vid="JHN 7:41">पुण थोड़ाक केया, “काहा मसी गेलील माय रेन आवी! <verse eid="JHN 7:41"/><verse number="42" style="v" sid="JHN 7:42"/>दाऊद राजान खानदान एने जा बेथलेहेम माय दाऊद ईतो, ता गावाम रेन मसी आवी, इहकेरीन पुस्तेक माय कियेल नाह काय?” <verse eid="JHN 7:42"/><verse number="43" style="v" sid="JHN 7:43"/>केरीन यीशुन वोजेसे माणहान विची माय फुट पोड़ गियी। <verse eid="JHN 7:43"/><verse number="44" style="v" sid="JHN 7:44"/>ता माय रेन थोड़ाक यीशुह देरने होदताला, पुण कुण ताह आथ नाह लागाड्या।<verse eid="JHN 7:44"/></para>
  <para style="s">यहुदि आदिकारीन यीशु पोर बुरहो नाह केरनो</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45"/>जेवी सिपाय एने मुखी चाकऱ्या फरिसी फाय वोलीन आवतरना, ता ताह केया, “तुमू ताह काहा नाह लावा?”<verse eid="JHN 7:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46"/>सिपाय जापाप आप्या, “काल्लो माणुह केदी ओहल्यु वातु नाह केऱ्यो, जिहकेरीन ज्यो किरेह!”<verse eid="JHN 7:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47"/>ते फरिसी ताह जापाप आप्या, “तुमूह बी तो फोसाड़ दियेल हे काय? <verse eid="JHN 7:47"/><verse number="48" style="v" sid="JHN 7:48"/>तुमू जाणतेह काय यहुदि आदिकारी माय रेन एने फरिसी माय रेन कुण बी ता पोर बुरहो केरतेह? <verse eid="JHN 7:48"/><verse number="49" style="v" sid="JHN 7:49"/>पुण जा माणहे मुसान नेम नाह जाणते, ता पोर हाराप पुड़ेह।”<verse eid="JHN 7:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">7:50 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 3:1">योहान 3:1</ref>,<ref loc="JHN 3:2">2</ref></char>
    </note>नीकुदेमुस जो पेल ता फाय आयेल ईतो, एने ता माय रेन एक फरिसी ईतो। तो ताह केयो, <verse eid="JHN 7:50"/><verse number="51" style="v" sid="JHN 7:51"/>“आपणो नेम इहकेरीन किथे, एक माणुह काह गुनो किरेल हे, एने तान बाराम पुसतास केरीन जाणनेन पेल ताह गुनेगार नाह ठेराव सिकेत।”<verse eid="JHN 7:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">7:52 </char>
      <char style="ft" closed="false">काल्लोस जाणकार नाह आवीत: थोड़ाक लेख माय जाणकार नाय आवी लिखेल हे।</char>
    </note>ता नीकुदेमुसाह जापाप आप्या, “तु बी गेलील वालो हे काय? पुस्तेक माय पुतो लागाड़ काय गेलील माय रेन एगदो जाणाव केरनार देखाय नाय।” <verse eid="JHN 7:52"/><verse number="53" style="v" sid="JHN 7:53"/>ओवता ता आखा माणहे जान तान गेर जात रेना।<note caller="+" style="f"><char style="fr" closed="false">7:53 </char><char style="fq" closed="false">ओवता ता आखा माणहे जान तान गेर जात रेना। </char><char style="ft" closed="false">ज्यो वचन दिहरा लेख माय नाह जुड़ेत।</char></note><verse eid="JHN 7:53"/></para>
  <chapter eid="JHN 7"/>
  <chapter number="8" style="c" sid="JHN 8"/>
  <para style="s">सिनालो केरनार बायकुह माफी</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1"/>पुण यीशु जेतुनान बोयड़ा पोर गीयो। <verse eid="JHN 8:1"/><verse number="2" style="v" sid="JHN 8:2"/>पासाण पुशो विगोच तो मोंदिर माय आवो। तेवी आखा माणहे यीशु फाय आवा, एने तो बोहीन ताह हिकाड़ने बाज गीयो। <verse eid="JHN 8:2"/><verse number="3" style="v" sid="JHN 8:3"/>तेवी देरेमगुरू एने फरिसी एक बायकुह यीशु फाय लावा जी सिनालो केरतालीन देरायेल एती, एने तीह विची माय उबी केर देना। <verse eid="JHN 8:3"/><verse number="4" style="v" sid="JHN 8:4"/>एने यीशुह केया, “एय गुरू, ज्यी बायकु सिनालो केरतालीन देरायेल हे। <verse eid="JHN 8:4"/><verse number="5" style="v" sid="JHN 8:5"/>मुसो नेम माय आमुह ओहलो उकुम आपेल हे, ओहल्यु बायकुह देगड़ाठीन मार। पुण तु ज्यी बायकुन बाराम काय किथे?” <verse eid="JHN 8:5"/><verse number="6" style="v" sid="JHN 8:6"/>ता यीशुह फासाड़नेन केरता इहकेरीन केणे बाज गीया, काहाकाय ता पोर गुनो लागाड़नेन केरता ताह एगदी वात जुड़ जाय। पुण यीशु निड़ो डोंगो वोलीन आंगली केरीन बुय पोर लेखणे बाज गीयो। <verse eid="JHN 8:6"/><verse number="7" style="v" sid="JHN 8:7"/>जेवी ता यीशुह फुसतेस रेना, ते यीशु हुतरोच उबरेन ताह केयो, “तुमू माय रेन जो पापी नाह सोतो, तोस पेल ज्यी बायकुह देगड़ा केरीन देय।” <verse eid="JHN 8:7"/><verse number="8" style="v" sid="JHN 8:8"/>यीशु पुशो निड़ो डोंगो वोलीन बुय पोर आंगली केरीन लेखणे बाज गीयो। <verse eid="JHN 8:8"/><verse number="9" style="v" sid="JHN 8:9"/>पुण ता इहकेरीन होमलीन डावाला रेन ते आतल्या वोर आखा एकान पासाण एक निकलीन जात रेना। यीशु एखालोच रेय गीयो, एने ती बायकु विची माय ताहरीस उबरियेल एती। <verse eid="JHN 8:9"/><verse number="10" style="v" sid="JHN 8:10"/>यीशु हुतरो एन तीह केयो, “एय बाय, ता काहरी जात रेना? तुवाह कुण डेंडान उकुम नाह आप्या काय?”<verse eid="JHN 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11"/>ती केयी, “एय मालीक, कुणीस नाह।”</para>
  <para style="p" vid="JHN 8:11">यीशु केयो, “मी बी तुवाह डेंडान उकुम नाह आपेत।” जा, एने पोशी पाप मा किरहे।<note caller="+" style="f"><char style="fr" closed="false">8:11 </char><char style="ft" closed="false">थोड़ाक लेख माय एने जुनाला अनुवाद माय ज्यो वचन नाह सापड़ेत: 8:1-11; बाकीन थोड़ाक लेख माय ज्योस बाग लुका 21:24 ने पासाण टाकेल हे; एक लेख माय योहान 7:36 ने पासाण लिखेल हे।</char></note><verse eid="JHN 8:11"/></para>
  <para style="s">यीशु दुनियान उजालो</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">8:12 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:14">मत्ती 5:14</ref>; <ref loc="JHN 9:5">योहान 9:5</ref></char>
    </note>यीशु उंजु माणहाह केयो, “दुनियान उजालो मी हे, जो मार पासाण आवी। तो आंदारलाम नाय चाली, पुण ताह फाय जीवणान उजालो रेय।”<verse eid="JHN 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">8:13 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 5:31">योहान 5:31</ref>
      </char>
    </note>फरिसी यीशुह जापाप आप्या, “तारीस गोवाय तुस देणे बाजरिनोह; तारी गोवाय खेरली नाह नाय मिल।”<verse eid="JHN 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14"/>यीशु ताह जापाप आप्यो, “मी सोतान बाराम गोवाय दिनो, तीबी मारी गोवाय खेरली हे, काहाकाय मी कारीन आयेल हे एने काहरी जाथु ज्य माहु मालुम हे। पुण मी कारीन आवथु एने का जाथु ज्यो तुमूह मालुम नाह नाय सोतो। <verse eid="JHN 8:14"/><verse number="15" style="v" sid="JHN 8:15"/>तुमू माणहान रितीन गेत नियाव केरतेह; पुण मी कुणान नियाव नाह किरेत। <verse eid="JHN 8:15"/><verse number="16" style="v" sid="JHN 8:16"/>एने केदी मी एगदान नियाव केरूह बी, ते मारो नियाव खेरलो हे, काहाकाय मी एखालो नाह सुतो; पुण मी हे एने आबोख हे, जो माहु मुकलेल हे। <verse eid="JHN 8:16"/><verse number="17" style="v" sid="JHN 8:17"/>एने तुमरा नेम माय बी लिखेल हे, दुय जाणान गोवाय मिलीन खेरीच मानाय जाथे, <verse eid="JHN 8:17"/><verse number="18" style="v" sid="JHN 8:18"/>एक ते मी सोता मारी गोवाय देथु, एने दिहरी आबोख मारी गोवाय दिथे जो माहु मुकलेल हे।”<verse eid="JHN 8:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19"/>ता यीशुह केया, “तारो आबोख काहरी हे?”</para>
  <para style="p" vid="JHN 8:19">यीशु जापाप आप्यो, “नाह तुमू माहु ओलेखते, एने नाह मार आबाख ओलेखते, केदी तुमू माहु ओलेखता ते मारा आबाख बी ओलेखता।”<verse eid="JHN 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 8:20"/>ज्‍यु वातु यीशु मोंदिर ने दान पेटी हिऱ्यो हिकाड़तालोन केयो, एने ताह कुण देऱ्या नाह। काहाकाय ताह वोर तान टेम आयेल नाह एतो।<verse eid="JHN 8:20"/></para>
  <para style="s">जा मी जाथु ता तुमू जाय नाह सेकते</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21"/>यीशु ताह पुशो केयो, “जा मी जाणे बाजरिनोह, एने तुमू माहु हुदहो एने तुमू तुमरा पापाम मुरहो; जाहरी मी जाथु। ताहरी तुमू नाह आव सेकते।”<verse eid="JHN 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22"/>ज्या पोर यहुदि आदिकारी केया, “काय ज्यो सोताह मार देय? काहाकाय तो किथे, जाहरी मी जाथु ताहरी तुमू नाह आव सेकते?”<verse eid="JHN 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23"/>यीशु ताह केयो, “तुमू नेचाला हेते, मी उपेर वालो हे, तुमू दुनियान हेते। पुण मी दुनियान नाह सोतो। <verse eid="JHN 8:23"/><verse number="24" style="v" sid="JHN 8:24"/>केरीन मी तुमूह कियेल काय तुमू तुमरा पापाम मुरहो। काहाकाय मी जो हे तोस हे ओहलो बुरहो तुमू नाय किरहो, ताहार तुमू तुमरा पापाम मुरहो।”<verse eid="JHN 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25"/>ता यीशुह केया, “तु कुण हे?”</para>
  <para style="p" vid="JHN 8:25">यीशु ताह जापाप आप्यो, “जिहकेरीन काय मी पेलुच रेन तुमूह किते आयेल हे, मी तोस हे।<note caller="+" style="f"><char style="fr" closed="false">8:25 </char><char style="ft" closed="false">जो मी पेल तुमूह कियेल ईतो; नाहते तुमरी हिऱ्यो मी काहा वातु केरू?</char></note> <verse eid="JHN 8:25"/><verse number="26" style="v" sid="JHN 8:26"/>माहु तुमरे बाराम जुलूम वातु केणु हे, एने हुमचो केरनु हे। पुण जो माहु मुकलेल हे, तो खीरलो हे, एने ज्‍यु वातु मी ता फाय रेन हुमलेल हे, त्यु मी दुनियाह केथु।”<verse eid="JHN 8:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27"/>आबाख ने बाराम किथे, ज्यो ताह सोमजानो नाह। <verse eid="JHN 8:27"/><verse number="28" style="v" sid="JHN 8:28"/>तेवी यीशु ताह केयो, “जेवी तुमू माणहान बेटाख उचा किरहो, तेवी तुमू जाणहो काय मी जो हे तोस हे; एने मी सोताच काय नाह किरेत, पुण जिहकेरीन मारो आबोख माहु हिकाड़ेल हे तिहेच केरीन ज्‍यु वातु केथु। <verse eid="JHN 8:28"/><verse number="29" style="v" sid="JHN 8:29"/>एने माहु मोकेलनार मार हिऱ्यो हे; तो माहु एखालो नाह सोड्यो, काहाकाय मी जेलेम मार आबाख पुटीह ओहलो काम केरथु।”<verse eid="JHN 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 8:30"/>तेवी जुलूम होवटा माणहे यीशुन वात होमलीन ता पोर बुरहो केऱ्या।<verse eid="JHN 8:30"/></para>
  <para style="s">खेराय तुमूह सोड़वी</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31"/>जा यहुदि यीशु पोर बुरहो किरेल एता, ताह यीशु केयो, “केदी तुमू मारा हिकवोणान पालेन किरहो, ते खेरीच मारा चेला केवाहो। <verse eid="JHN 8:31"/><verse number="32" style="v" sid="JHN 8:32"/>तुमू खेरायीह जाणहो, एने खेराय तुमूह सोड़वी।”<verse eid="JHN 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">8:33 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 3:9">मत्ती 3:9</ref>; <ref loc="LUK 3:8">लुका 3:8</ref></char>
    </note>ता यीशुह जापाप आप्या, “आमु ते अब्राहामान वोसीन हेते, एने आमु केदी बी कुणीन पावोर नाह बोणना। उवतो तु किहीक केय सिकेह काय तुमू सोड़वाय जाहो?”<verse eid="JHN 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34"/>यीशु ताह जापाप आप्यो, “मी तुमूह खेरीच केथु काय जो कुण पाप किरेह तो पापान पावोर हे। <verse eid="JHN 8:34"/><verse number="35" style="v" sid="JHN 8:35"/>एने पावोर जेलेम कुटूमा हिऱ्यो नाह रेणे, पुण गेरावालो बिटोख जेलेम गेरा माय रीथे। <verse eid="JHN 8:35"/><verse number="36" style="v" sid="JHN 8:36"/>केरीन केदी बिटोख तुमूह सोड़वी, ताहार खेरीच तुमू सोड़वाय जाहो। <verse eid="JHN 8:36"/><verse number="37" style="v" sid="JHN 8:37"/>माहु मालुम हे काय तुमू अब्राहाम ने वोसीन हेते। तीबी तुमू मार वचनाह स्वीकार केरती नाह, केरीन तुमू माहु मारावणे होदतेह। <verse eid="JHN 8:37"/><verse number="38" style="v" sid="JHN 8:38"/>मी आबाख फाय जो दिखेल हे तोस तुमूह केथु, तिहेच केरीन तुमू आबाख फाय रेन जो हुमलेल हेते तोस केरतेह।”<verse eid="JHN 8:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">8:39 </char>
      <char style="ft" closed="false">केदी तुमू खेरीच तुमू ज्यो किरेल एता: थोड़ाक लेख माय, केदी तुमू एय ते किरो</char>
    </note>ता यीशुह जापाप आप्या, “आमरो आबोख ते अब्राहाम हे।”</para>
  <para style="p" vid="JHN 8:39">यीशु ताह केयो, “केदी तुमू अब्राहाम ने सोरा रेता, ते अब्राहाम ने गेत काम केरता। <verse eid="JHN 8:39"/><verse number="40" style="v" sid="JHN 8:40"/>पुण मी ते तुमूह बोगवाना फाय रेन हुमलेल तो खेरायीन वचन केथु, तीबी तुमू माहु मारावणे होदतेह। पुण अब्राहाम ते इहकेरीन नाह किऱ्यो। <verse eid="JHN 8:40"/><verse number="41" style="v" sid="JHN 8:41"/>तुमू तुमरा आबाख ने गेत काम केरतेह।”</para>
  <para style="p" vid="JHN 8:41">ता यीशुह केया, “आमरो एकुस आबोख हे, तो सोता बोगवान हे, एने आमु तान सोरा हेते।”<verse eid="JHN 8:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42"/>यीशु ताह केयो, “केदी बोगवान तुमरो आबोख रितो, ताहार तुमू माहु मोंग केरता, काहाकाय मी बोगवानान उगे रेन आयेल हे। मी सोतान मोरजीम नाह आवो, पुण तोस माहु मुकलेल हे। <verse eid="JHN 8:42"/><verse number="43" style="v" sid="JHN 8:43"/>तुमू मारी वात काहा नाह सोमेजते? काहाकाय तुमू मारा वचनाह होमेल नाह सेकते। <verse eid="JHN 8:43"/><verse number="44" style="v" sid="JHN 8:44"/>तुमू तुमरा आबाख बुतड़ान हेते, एने तुमू तान मोरजीह पुरी केरने होदतेह। तो ते सुरवात रेन खुनी हे एने तो खेराय पोर टिकनो नाह, काहाकाय ता माय खेराय सोतीस नाह। जेवी तो जुठ बोलने, ते तान सोबाव केरीन बुलेह, काहाकाय तो जुठो हे एने जुठान आबोख हे। <verse eid="JHN 8:44"/><verse number="45" style="v" sid="JHN 8:45"/>पुण मी तुमूह खेरीच केथु, केरीन तुमू मार पोर बुरहो नाह केरते। <verse eid="JHN 8:45"/><verse number="46" style="v" sid="JHN 8:46"/>तुमू माय रेन कुण माहु पापी ठेरावेह? मी खेरीच केथु, तीबी मार पोर बुरहो काहा नाह केरते? <verse eid="JHN 8:46"/><verse number="47" style="v" sid="JHN 8:47"/>जो बोगवानान उगे रेन हे, तो बोगवानान वातु हुमलेह। एने तुमू बोगवानान उगे रेन नाह सोता, केरीन तुमू होमेलते नाह।”<verse eid="JHN 8:47"/></para>
  <para style="s">यीशु एने अब्राहाम</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48"/>ज्यो होमलीन यहुदि आदिकारी यीशुह सावाल फुशा, “तु सामरी हे, एने तार माय बुतड़ो हे, आमु जो केतेह तो बाराबोर हे काय नाह?”<verse eid="JHN 8:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49"/>यीशु जापाप आप्यो, “माहु माय बुतड़ो नाह नाय मिले, पुण मी मारा आबाख ने मान मेलथु, एने तुमू मारी ओबरू वेरतेह। <verse eid="JHN 8:49"/><verse number="50" style="v" sid="JHN 8:50"/>मी सोता मारी बोड़ाय नाह हुदेत। पुण एक हे जो मारी बोड़ाय हुदेह एने तो माहु नियाव केरनार ठेरावीह। <verse eid="JHN 8:50"/><verse number="51" style="v" sid="JHN 8:51"/>मी तुमूह खेरीच केथु: जो मार हिकवोणीह पालेह, तो मोतीह केदी नाय देखी।”<verse eid="JHN 8:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52"/>यहुदि यीशुह केया, “एवी आमु सोमजी गीया काय तार माय बुतड़ो हे! अब्राहाम मोर गीयो, एने जाणाव केरनार बी मोर गीया एने तु किथे, जो मार हिकवोणीह पालेह, तो मोतीह केदी नाय देखी। <verse eid="JHN 8:52"/><verse number="53" style="v" sid="JHN 8:53"/>आमरो आबोख अब्राहाम ते मोर गीयो; काय तु ताह रेन मुठो हे? एने जाणाव केरनार बी मोर गीया। तुवाह काय लागेह काय तु कुण हे?”<verse eid="JHN 8:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54"/>यीशु ताह जापाप आप्यो, “मी सोता मारी बोड़ाय केरूह ताहार मारी बोड़ाय काईच नाह सोती, पुण मारी बोड़ाय केरनार मारो आबोख हे। जाह तुमू केतेह काय आमरो बोगवान हे। <verse eid="JHN 8:54"/><verse number="55" style="v" sid="JHN 8:55"/>तीबी तुमू ताह ओलख्या नाह, पुण मी ताह ओलेखथु। एने मी ताह ओलखेत नाह, इहकेरीन केदी मी केह ताहार मी तुमरी गेत जुठो बोणुह। पुण मी ताह ओलेखथु, एने तान हिकवोणान पालेन केरथु। <verse eid="JHN 8:55"/><verse number="56" style="v" sid="JHN 8:56"/>तुमरो आबोख अब्राहाम मारो दिह देखणेन आसा केरीन जुलूम खुस ईतो; एने तो देख्यो एने खुसी माणायो।”<verse eid="JHN 8:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57"/>तेवी यहुदि आदिकारी यीशुह केया, “एवी वोर तु पाचाह वोरह्यान नाह ईनो, ते तु अब्राहामाह किहीक दिखेल हे?”<note caller="+" style="f"><char style="fr" closed="false">8:57 </char><char style="ft" closed="false">काय तुमू अब्राहामाह दिखेल हेते? थोड़ाक लेख माय काय अब्राहाम तुमूह दिखेल हे? लिखेल हे।</char></note><verse eid="JHN 8:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58"/>यीशु ताह केयो, “मी तुमूह खेरीच केथु, अब्राहाम पायदा एणेन पेलुच रेन मी हे।”<verse eid="JHN 8:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 8:59"/>तेवी ता यीशुह देणेन केरता दिगोड़ विशा, पुण यीशु लीकीन मोंदिर माय रेन बाहेर निकील गीयो।<verse eid="JHN 8:59"/></para>
  <chapter eid="JHN 8"/>
  <chapter number="9" style="c" sid="JHN 9"/>
  <para style="s">पायदास रेन आंदलाह यीशु देखतो केरनो</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1"/>जाणे बुखेत यीशु एक माणहाह दिख्यो, जो जेल्माम रेच ने आंदलो एतो। <verse eid="JHN 9:1"/><verse number="2" style="v" sid="JHN 9:2"/>तेवी यीशुन चेला ताह फुशा, “एय गुरू, कुणीन पापान वोजेसे ज्यो ओहलो आंदलो पायदा ईयेल हे; ज्यान काय ज्यान आईख आबाख ने?”<verse eid="JHN 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3"/>यीशु ताह जापाप आप्यो, “नाह ते ज्यो पाप किरेल ईतो, नाह ज्यान आहख आबोख। पुण ज्यो ज्यानकेरता आंदलो पायदा ईयेल हे काय बोगवानान काम ता माय देखाय। <verse eid="JHN 9:3"/><verse number="4" style="v" sid="JHN 9:4"/>जो माहु मुकलेल हे, तान काम दिह हे ताह वोर आपुह केरने जोरेवरी हे; काहाकाय रात आवणी हे ती माय कुणीह बी काम केरता नाय आवी। <verse eid="JHN 9:4"/><verse number="5" style="v" sid="JHN 9:5"/><note caller="+" style="x"><char style="xo" closed="false">9:5 </char><char style="xt" closed="false"><ref loc="MAT 5:14">मत्ती 5:14</ref>; <ref loc="JHN 8:12">योहान 8:12</ref></char></note>मी जाह वोर दुनियाम हे, ताह वोर मी दुनियान उजालो हे।”<verse eid="JHN 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6"/>इहकेरीन केयीन यीशु बुय पोर थुप्यो, एने थुपा केरीन माटड्यो बिजाड़ीन; एने तो माटड्यो ता आंदलान डोला पोर लागाड़ीन <verse eid="JHN 9:6"/><verse number="7" style="v" sid="JHN 9:7"/>ताह केयो, “जा, शिलोम मतलब मुकलेल। नावान कुंडाम दोव ले।” तो आंदलो जाईन दोव लेदो, एने देखतीन आवो।<verse eid="JHN 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8"/>तेवी तान आहने रेणारे, एने जा ताह पेल बिख मांगतालो दिखेल एता ता केया, “बोहीन बिख मांग्‍या केरतालो ज्यो तोस हे काय?”<verse eid="JHN 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 9:9"/>थोड़ाक माणहे केया, “ज्यो तोस हे,” पुण दिहरा केया, “नाह; ज्यो ते तान गेत देखाह।”</para>
  <para style="p" vid="JHN 9:9">एने तो केयो, “मी तोस हे।”<verse eid="JHN 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10"/>तेवी ता ताह फुसणे बाज गीया, “तारा डोला किहीक उगड़ी गीया?”<verse eid="JHN 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11"/>तो जापाप आप्यो, “यीशु नावान एक माणुह माटड्यो बिजाड़ीन मारा डोला पोर लागाड़ेल,” एने माहु केयो, “शिलोम नावान कुंडाम जाईन दोव ले। ते मी तान वात होमलीन जाईन दुयो, एने देखणे बाज गीयो।”<verse eid="JHN 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12"/>तेवी ता ताह फुशा, “तो का हे?”</para>
  <para style="p" vid="JHN 9:12">तो जापाप आप्यो, “माहु नाह मालुम।”<verse eid="JHN 9:12"/></para>
  <para style="s">फरिसीन द्‍वारा हुदारनेन जाच</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13"/>जो पेल आंदलो एतो, ताह माणहे फरिसी फाय ली गीया। <verse eid="JHN 9:13"/><verse number="14" style="v" sid="JHN 9:14"/>जेदिह यीशु माटड्यो बिजाड़ीन तान डोला उगड़ील ईतो तो विहेवणेन दिह ईतो। <verse eid="JHN 9:14"/><verse number="15" style="v" sid="JHN 9:15"/>ओवता फरिसी ताह उंजु फुशा, तु किहीक देखणे बाज गीयो। तो केयो, “तो मारा डोला पोर माटड्यो लागाड्यो; उवतो मी दोव लियेल, एने एवी मी देखथु।”<verse eid="JHN 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16"/>तेवी थोड़ाक फरिसी केणे बाज गीया, “ज्यो माणुह बोगवानान उगे रेन नाह सोतो, काहाकाय ज्यो विहेवणेन दिह नाह मानेत।”</para>
  <para style="p" vid="JHN 9:16">दिहरा केया, “पापी माणुह ओहली ताकेतीन काम किहीक देखाड़ सेकी?” केरीन ता माय फुट पोड़ गियी।<verse eid="JHN 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17"/>फरिसी ता आंदलाह पोशा केया, “जो तारा डोला उगड़ील हे। तान बाराम तु काय किथे?”</para>
  <para style="p" vid="JHN 9:17">तो केयो, “तो जाणाव केरनार हे।”<verse eid="JHN 9:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18"/>पुण यहुदि आदिकारीह बुरहो नाह ईनो, ज्यो आंदलो एतो एने एवी दिखेह, केरीन तान आईख आबाख हादाड़ीन <verse eid="JHN 9:18"/><verse number="19" style="v" sid="JHN 9:19"/>ताह फुशा, “तुमरो ज्यो बिटोख आंदलो पायदा ईयेल इहकेरीन केतेह, तो ज्योस हे काय? ते उवतो ज्यो एवी किहीक देखणे बाज गीयो?”<verse eid="JHN 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20"/>तान आहख आबोख जापाप आप्या, “ज्यो आमरो बिटोख हे, एने आंदलोच पायदा ईयेल ईतो, ज्यो आमुह मालुम हे। <verse eid="JHN 9:20"/><verse number="21" style="v" sid="JHN 9:21"/>पुण आमु ज्यो नाह मालुम सोतो काय एवी किहीक देखणे बाज गीयो, एने आमुह ज्यो बी नाह जाणते काय तान डोला कुण उगाड़ेल हे। ज्यो सोमेजदार हे, ज्या फुस लिवो; ज्यो केय देय!” <verse eid="JHN 9:21"/><verse number="22" style="v" sid="JHN 9:22"/>ज्‍यु वातु तान आहख आबोख ज्यानकेरता केया, काहाकाय ता यहुदि आदिकारीह बिताला, काहाकाय यहुदि एकमेल एय जायेल एता काय केदी ईखेह केय काय तो मसी हे, ते बोक्‍तीन गेराम रेन काड़ देती। <verse eid="JHN 9:22"/><verse number="23" style="v" sid="JHN 9:23"/>ता माय तान आहख आबोख केया, “ज्यो सोमेजदार हे; ज्या फुस लिवो!”<verse eid="JHN 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24"/>तेवी यहुदि आदिकारी ता आंदला माणहाह दिहरी वार उंजु हादिन केया, “बोगवानान सामने वायदो केर काय तु खेरीच बुलेह! पुण आमु जाणतेह काय जो माणुह तुवाह हुदारेल हे, तो पापी हे।”<verse eid="JHN 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25"/>तो आंदलो माणुह जापाप आप्यो, “तो पापी हे काय नाह ज्यो माहु मालुम नाह सोतो। पुण माहु एक वात मालुम हे: काय मी पेल आंदलो ईतो, एने एवी देखथु।”<verse eid="JHN 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26"/>ता यहुदि आदिकारी ताह उंजु केया, “तार हिऱ्यो तो काय किरेल? एने किहीक तारा डोला उगड़ील?”<verse eid="JHN 9:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27"/>तो आंदलो माणुह ताह जापाप आप्यो, “मी ते तुमूह केय दिनो, एने तुमू नाह होमल्या। पोशा होमेलनेन आसा काहा केरतेह? काय तुमू बी तान चेला बोणने होदतेह?”<verse eid="JHN 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28"/>तेवी ता हाजो बाकतो केयीन ताह केया, “तुस तान चेलो एय; पुण आमु ते मुसान चेला हेते। <verse eid="JHN 9:28"/><verse number="29" style="v" sid="JHN 9:29"/>आमु जाणतेह काय बोगवान मुसा हिऱ्यो वातु किरेल ईतो; पुण ता माणहाह नाह जाणते काय तो कारीन आयेल हे!”<verse eid="JHN 9:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30"/>तो माणुह ताह जापाप आप्यो, “ज्यी ते बोंगलाणेन वात हे, ज्यो तुमूह नाह मालुम सोतो काय तो कारीन आयेल हे! पुण तो ते मारा डोला उगाड़ेल हे! <verse eid="JHN 9:30"/><verse number="31" style="v" sid="JHN 9:31"/>आमु जाणतेह काय बोगवान पापी माणहान वात नाह होमलेत; पुण जा बोगवानान बोक्ती केरतेह एने तान मोरजी पोर चालेह, तान वात होमलेह। <verse eid="JHN 9:31"/><verse number="32" style="v" sid="JHN 9:32"/>जेल्माम रेच ने आंदलान माणहान डोला एगदो उगाड़ेल ओहली वात दुनियान सुरवात रेन केदी होमेलनाम आवी नाह। <verse eid="JHN 9:32"/><verse number="33" style="v" sid="JHN 9:33"/>केदी ज्यो माणुह बोगवानान उगे रेन नाय रेतो, ते कायच नाय केर सेकतो।”<verse eid="JHN 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34"/>ता ताह जापाप आप्या, “तु ते खेरीच पापाम पायदा ईयेल हे, आमुह तु काय हिकाड़ेह?” इहकेरीन केयीन ता ताह बोक्ती केरन्या गेरा माय रेन बाहेर काड़ देना।<verse eid="JHN 9:34"/></para>
  <para style="s">आत्मिक आंदलाय</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35"/>जेवी यीशु हुमल्यो काय ता ताह बोक्ती केरन्या गेरा माय रेन बाहेर काड़ दियेल हेते, एने जेवी तो यीशुह मिलानो ते केयो, “तु बोगवानान बेटाख पोर बुरहो किरेह काय?”<verse eid="JHN 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36"/>तो माणुह जापाप आप्यो, “एय मालीक, तो कुण हे? जा पोर मी बुरहो केरू!”<verse eid="JHN 9:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37"/>यीशु ताह केयो, “ताह तु दिखेल हे, एने जो तार हिऱ्यो वातु केरने बाजरिनोह तोस तो हे।”<verse eid="JHN 9:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38"/>तो केयो, “एय मालीक! मी बुरहो केरथु।” एने तो पाया पोड़ीन यीशुह वोंद्यो।<verse eid="JHN 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39"/>तेवी यीशु केयो, “मी ज्यी दुनिया माय नियाव ने केरता आयेल हे, ज्यानकेरता काय जाह देखात नाह ताह देखाय, एने जाह देखाह ता आंदला एय जाती।”<verse eid="JHN 9:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40"/>जा फरिसी ता हेऱ्या एता, ता ज्यी वात होमलीन यीशुह केया, “ते आमु बी आंदला हेते काय?”<verse eid="JHN 9:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41"/>यीशु ताह जापाप आप्यो, “केदी तुमू आंदला रेता, ते पापी नाय ठेराता; पुण आमुह देखाह इहकेरीन तुमू एवी केतेह, केरीन तुमरा पापान गुनो बोणीन रीथे।”<verse eid="JHN 9:41"/></para>
  <chapter eid="JHN 9"/>
  <chapter number="10" style="c" sid="JHN 10"/>
  <para style="s">गोवालान किस्सो</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1"/>यीशु केयो, “मी तुमूह खेरीच खेरीच केथु: ‘जो बी बायणाम रेन मेंड्रान कोठाम नाह रिगेत, पुण दिहरी उगे रेन चेड़ीन जाथे, तो चोर एने डाकु हे।’ <verse eid="JHN 10:1"/><verse number="2" style="v" sid="JHN 10:2"/>पुण जो बायणाम रेन रिगेह तो मेंड्रान गोवाल हे। <verse eid="JHN 10:2"/><verse number="3" style="v" sid="JHN 10:3"/>तानकेरता बायणान राखवाल्यो बायणो उगाड़ दिथे, एने मेंड्रा तान आवाज होमेलतेह, तो तान मेंड्राह नाव लेन हादेह, एने ताह बाहेर ली जाथे। <verse eid="JHN 10:3"/><verse number="4" style="v" sid="JHN 10:4"/>एने जेवी तो तान आखा मेंड्राह बाहेर काड़ दिथे, तेवी तो तान ओंगाण ओंगाण चालेह, एने मेंड्रा तान पासाण पासाण चाल पोड़तेह, काहाकाय ता तान बोली ओलेखतेह। <verse eid="JHN 10:4"/><verse number="5" style="v" sid="JHN 10:5"/>एने ता केदी बी पारायान पासाण नाह जाते; पुण ताह देखीन नाहती, काहाकाय ता पारायान बोली नाह ओलेखते।”<verse eid="JHN 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 10:6"/>ज्यो किस्सो यीशु ताह केयो, तीबी ता ज्‍यु वातुह नाह सोमेजना काय यीशु काय केणे बाजरिनोह।<verse eid="JHN 10:6"/></para>
  <para style="s">यीशु हाजालो गोवाल हे</para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7"/>तेवी यीशु ताह पुशो केयो, “मी तुमूह खेर खेरीच केथु: मेंड्रान बायणो मी हे। <verse eid="JHN 10:7"/><verse number="8" style="v" sid="JHN 10:8"/>जोला माहु रेन पेल आयेल ता आखा चोर एने डाकु हेते, पुण मेंड्रा तान उकुम नाह मान्या। <verse eid="JHN 10:8"/><verse number="9" style="v" sid="JHN 10:9"/>बायणो मी हे। मार द्‍वारा एगदो माय रिगी ताहार तो वोचाड़ाय जाय; एने मायतो बाहेर आव जाव केरी एने ताह चारो जुड़ी। <verse eid="JHN 10:9"/><verse number="10" style="v" sid="JHN 10:10"/>चोर ते चोरी केरने, मारने, एने खेतेम केरनेन उलोस आवेह। पुण मी ज्यानकेरता आवो काय ताह जुलूम होवटी जीवाय जुड़ी। <figure style="fig" alt="Shepherd with his sheep in sheepfold" file="lb00014c.tif" size="span" copy="Horace Knowles ©" ref="10:7">गोवाल तान मेंड्राह कोठा माय मेलीन राखवाली केरने</figure><verse eid="JHN 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11"/>“मीच हाजालो गोवाल हे, हाजालो गोवाल मेंड्रान केरता तान जीव आपेह। <verse eid="JHN 10:11"/><verse number="12" style="v" sid="JHN 10:12"/>मोजुर गोवाल एने मेंड्रान मालीक नाय मीले, तानकेरता तो कोलवाह आवतालो देखीन मेंड्राह सोड़ीन नाह जाथे; एने कोलवो ताह दिरेह एने ताह वेरासेर केर दिथे। <verse eid="JHN 10:12"/><verse number="13" style="v" sid="JHN 10:13"/>तो माणुह वेचातो लायेल मोंजऱ्यो हे, तानकेरता तो नाह जाथे, एने ताह मेंड्रान कालजी नाह। <verse eid="JHN 10:13"/><verse number="14" style="v" sid="JHN 10:14"/><note caller="+" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="MAT 11:27">मत्ती 11:27</ref>; <ref loc="LUK 10:22">लुका 10:22</ref></char></note>हाजालो गोवाल मी हे; मी मारा मेंड्राह जाणथु, एने मारा मेंड्रा माहु जाणतेह। <verse eid="JHN 10:14"/><verse number="15" style="v" sid="JHN 10:15"/>जिहकेरीन आबोख माहु जाणेह एने मी आबाख जाणथु, एने मी मेंड्रान केरता मार जीव आपथु। <verse eid="JHN 10:15"/><verse number="16" style="v" sid="JHN 10:16"/><note caller="+" style="f"><char style="fr" closed="false">10:16 </char><char style="ft" closed="false">ता बोणती; थोड़ाक लेख माय एती लिखेल हे।</char></note>मारा दिहरा उंजु बी मेंड्रा हेते, ता ज्या कोठामवाला नाह सोता। पुण माहु ताह बी लावणे जोरवरी हे; काय ता मार बोली होमेलती, तेवी तान एकुस टुलो एने एकुस गोवाल रेय।<verse eid="JHN 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 10:17"/>“मी मारो जीव पुशो मांगणेन केरता आपथु, केरीन आबोख माहु मोंग किरेह। <verse eid="JHN 10:17"/><verse number="18" style="v" sid="JHN 10:18"/>कुण बी मारा जीवाह मार फाय रेन सांडाड़ेत नाह। पुण मी सोता मारा जीवाह आपथु, माहु ताह आपणेन आदिकार हे, एने ताह पुशो मांगणेन बी आदिकार हे। ज्यो उकुम माहु आबाख फाय रेन जुड़ेल हे।”<verse eid="JHN 10:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19"/>ज्यी वातीन वोजेसे यहुदि माणहा माय पोशी फुट पोड़ गियी। <verse eid="JHN 10:19"/><verse number="20" style="v" sid="JHN 10:20"/>ताम रेन मोकतास माणहे केणे बाज गीया, “ज्या माय बुतड़ो हे! एने ज्यो गांडो हे! तान वातु तुमू काहा होमेलतेह?”<verse eid="JHN 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21"/>दिहरा माणहे केया, “ज्‍यो वातु बुतड़ो लागेल माणहान नाह रेय सिकेत! काय बुतड़ो आंदला माणहान डोला उगाड़ सिकेह?”<verse eid="JHN 10:21"/></para>
  <para style="s">यहुदि यीशुह नाकारनो</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22"/>यरूशलेम माय मोंदिरान समर्पणान तिवार मानावणे बाजरियेल एता, तेवी हियालान दिह एता। <verse eid="JHN 10:22"/><verse number="23" style="v" sid="JHN 10:23"/>एने यीशु मोंदिर माय सुलेमानान खोली माय फिरने बाजरियेल ईतो, <verse eid="JHN 10:23"/><verse number="24" style="v" sid="JHN 10:24"/>तेवी यहुदि ताह कोंडीन केया, “तु आमरा मोनाह केवीह वोर सेंका माय मिलहे? केदी तु मसी एय ते आमुह खेर खेरीच केय दे।”<verse eid="JHN 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25"/>यीशु ताह जापाप आप्यो, “मी तुमूह केय दिनो, पुण तुमू बुरहो केरतेस नाह। जो काम मी मारा आबाख ने नावाम केरथु तास मारा गोवा हेते; <verse eid="JHN 10:25"/><verse number="26" style="v" sid="JHN 10:26"/>पुण तुमू ज्यानकेरता मार पोर बुरहो नाह केरती, काहाकाय तुमू मारा मेंड्रा नाह सोता। <verse eid="JHN 10:26"/><verse number="27" style="v" sid="JHN 10:27"/>मारा मेंड्रा मारो आवाज होमेलतेह; मी ताह जाणथु, एने ता मार पासाण पासाण चालतेह। <verse eid="JHN 10:27"/><verse number="28" style="v" sid="JHN 10:28"/>मी ताह जेलेमक्यो जीवाय आपथु, ता केदी बी मोरती नाय। एने ताह कुण बी मार फाय रेन सांडाड़ नाय सेकी। <verse eid="JHN 10:28"/><verse number="29" style="v" sid="JHN 10:29"/><note caller="+" style="f"><char style="fr" closed="false">10:29 </char><char style="ft" closed="false">मारो आबोख जाह माहु आपेल हे तो आखाम रेन मोठो हे, थोड़ाक लेख माय माहु आपेल तो मार आबोख मुठो।</char></note>मारो आबोख जाह माहु आपेल हे तो आखाम रेन मोठो हे, एने आबाख फाय रेन ताह कुण सांडाड़ नाह सिकेत। <verse eid="JHN 10:29"/><verse number="30" style="v" sid="JHN 10:30"/>मी एने मारो आबोख एकुस हेते।”<verse eid="JHN 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31"/>तेवी यहुदि माणहे यीशुह देगड़ाठणेन केरता पोशा दिगोड़ विशा। <verse eid="JHN 10:31"/><verse number="32" style="v" sid="JHN 10:32"/>यीशु ताह केयो, “मी तुमूह मारा आबाख ने उगे रेन जुलूम होवटा हाजा काम देखाड़ेल हे; ताम रेन काल्ला कामान केरता तुमू माहु देगड़ाठणे होदतेह?”<verse eid="JHN 10:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33"/>यहुदि यीशुह जापाप आप्या, “हाजाला कामान केरता आमु तुवाह देगड़ाठते नाह, पुण बोगवानान चिहटा किरेह केरीन! काहाकाय तु माणुह एन सोताह बोगवान किथे!”<verse eid="JHN 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34"/>यीशु ताह जापाप आप्यो, “ज्यो तुमरा नेम माय लिखेल हे बोगवान कियेल, ‘तुमू देवता हेते।’ <verse eid="JHN 10:34"/><verse number="35" style="v" sid="JHN 10:35"/>जा माणहाह बोगवानान वचन जुड़नो; ताह तो देवता किथे, एने पुस्तेकीन वात जुठी नाह एय सिकेत। <verse eid="JHN 10:35"/><verse number="36" style="v" sid="JHN 10:36"/>ते जाह आबोख निवाड़ेन दुनियाम मुकलेल हे। तुमू ताह केतेह, तु चिहटा किरेह, ज्यानकेरता काय मी केयो, मी बोगवानान बिटोख हे? <verse eid="JHN 10:36"/><verse number="37" style="v" sid="JHN 10:37"/>केदी मारा आबाख ने काम मी निहे केरतेय, ताहार मार पोर बुरहो मा किरो। <verse eid="JHN 10:37"/><verse number="38" style="v" sid="JHN 10:38"/>पुण केदी मी केरथु, ते मारो बुरहो नाय बी किरो, पुण ता कामाह देखीन ते बुरहो किरो, काहाकाय तुमू जाणो काय आबोख मार माय हे एने मी आबाख माय हे।”<verse eid="JHN 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 10:39"/>तेवी ता पोशा यीशुह देरनेन कोसीत केऱ्या, पुण तो तान आथाम रेन निकली गीयो।<verse eid="JHN 10:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:40 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 1:28">योहान 1:28</ref>
      </char>
    </note>उवतो यीशु यरदन नेदीन ती मीरे जा पेल योहान बपतीस्मा देया केरतालो ता जागाम गीयो, एने ताहरी रिनो।<verse eid="JHN 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 10:41"/>एने जुलूम माणहे यीशु फाय आवीन केया, “योहान ते काल्ली निसाणी नाह देखाड्यो, पुण जो काय योहान तार बाराम कियेल ईतो, तो सोब खेरलो हे।” <verse eid="JHN 10:41"/><verse number="42" style="v" sid="JHN 10:42"/>एने ताहरी जुलूम माणहे यीशु पोर बुरहो केऱ्या।<verse eid="JHN 10:42"/></para>
  <chapter eid="JHN 10"/>
  <chapter number="11" style="c" sid="JHN 11"/>
  <para style="s">लाजरान मोत</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">11:1 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:38">लुका 10:38</ref>,<ref loc="LUK 10:39">39</ref></char>
    </note>बेतनिया गावा माय मरीयम एने मार्था दुय बोणीख रेताल्यु, एने त्युन लाजर नावान बाहख दुखाऱ्यो ईतो।<note caller="+" style="x"><char style="xo" closed="false">11:1 </char><char style="xt" closed="false"><ref loc="LUK 10:38-39">लुका 10:38-39</ref></char></note> <verse eid="JHN 11:1"/><verse number="2" style="v" sid="JHN 11:2"/><note caller="+" style="x"><char style="xo" closed="false">11:2 </char><char style="xt" closed="false"><ref loc="JHN 12:3">योहान 12:3</ref></char></note>ज्यी तीस मरीयम हे जी मालीकान पाया पोर मोग मोग गेंदाण्यो तेल रोचवीन लेट्या केरीन नुसेल एती; तिच ने बाहख लाजर दुखाऱ्यो ईतो।<note caller="+" style="x"><char style="xo" closed="false">11:2 </char><char style="xt" closed="false"><ref loc="JHN 12:3">योहान 12:3</ref></char></note> <verse eid="JHN 11:2"/><verse number="3" style="v" sid="JHN 11:3"/>ओवत्यु लाजरान बोणह्युख यीशु फाय इहकेरीन खुबेर केय मोकल्यु, “एय मालीक, जाह तु मोंग किरेह, तो दुखाऱ्यो हे।”<verse eid="JHN 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4"/>ज्यो होमलीन यीशु केयो, “ज्यी बेमारीन आखरी परिणाम लाजरान मोत नाय मीले; पुण बोगवानान बोड़ायीन केरता हे, काय तान द्‍वारा बोगवानान बेटाख ने बोड़ाय एय।”<verse eid="JHN 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 11:5"/>यीशु मार्था एने तीन बोणीख मरयमीह एने लाजराह मोंग केरतालो। <verse eid="JHN 11:5"/><verse number="6" style="v" sid="JHN 11:6"/>तीबी लाजर दुखाऱ्यो हे इहकेरीन यीशु होमल्यो, तेवी यीशु ता उंजु दुय दिह थुबनो, एने ताच रिनो। <verse eid="JHN 11:6"/><verse number="7" style="v" sid="JHN 11:7"/>तान पासाण यीशु तान चेलाह केयो, “चालो, आपु पोशा यहुदिया गावाम जाहु।”<verse eid="JHN 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8"/>चेला यीशुह केया, “एय गुरू, यहुदि माणहे थोड़ाक दिह्यान पेल तुवाह देगड़ाठणे होदताला, एने काय तु पुशो ता जाणे हुदेह?”<verse eid="JHN 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9"/>यीशु जापाप आप्यो, “दिह्यान बारा गेंटा नाह रेते काय? केदी एगदो माणुह दिह्या चाली ते जेठवाय नाय, काहाकाय तो ज्यी दुनियान उजालो दिखेह। <verse eid="JHN 11:9"/><verse number="10" style="v" sid="JHN 11:10"/>पुण एगदो माणुह राती चाली ते जेठवाय, काहाकाय ता फाय उजालो नाह रेत।” <verse eid="JHN 11:10"/><verse number="11" style="v" sid="JHN 11:11"/>यीशु ज्यी वातु किन पासाण ताह केयो, “मारो जोड़ीदार लाजर हुव जायेल हे, पुण मी ताह जागाड़ने जाथु।”<verse eid="JHN 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12"/>तेवी चेला यीशुह केया, “एय मालीक, तो हुव गीयोह, ते वोच जाय।”<verse eid="JHN 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 11:13"/>यीशु लाजरान मोतीन बाराम कियेल ईतो, पुण चेला सोमेजना काय यीशु निंदी माय हुवणे बाराम किथे। <verse eid="JHN 11:13"/><verse number="14" style="v" sid="JHN 11:14"/>तेवी यीशु ताह साप साप केय दिनो, “लाजर मोर जायेल हे, <verse eid="JHN 11:14"/><verse number="15" style="v" sid="JHN 11:15"/>एने मी तुमरे वोजेसे खुस हे काय मी ता नाह ईतो, काहाकाय तुमू मार पोर बुरहो केर सीको। चालो, एवी आपु ता फाय जाहु।”<verse eid="JHN 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16"/>तेवी थोमा जो दिदुमूस केवातालो, तान हाती चेलाह केयो, “चालो, आपु बी ता हेऱ्या मोरनेन जाता!”<verse eid="JHN 11:16"/></para>
  <para style="s">यीशु पुशो जीव उठणो एने जीवाय हे</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17"/>जेवी यीशु ता पोच गीयो, ते ताह मालुम पोड़नो काय लाजराह माहणा माय मिलेल चार दिह एय जायेल हेते। <verse eid="JHN 11:17"/><verse number="18" style="v" sid="JHN 11:18"/>बेतनिया गाव यरूशलेम रेन कोमीत कोमी तीन किलो मिटर सेटो एतो, <verse eid="JHN 11:18"/><verse number="19" style="v" sid="JHN 11:19"/>जुलूम होवटा यहुदि माणहे मार्था एने मरीयम ने बाहख लाजरान मोतीन वोजेसे दिलासो आपणेन केरता आयेल एता।<verse eid="JHN 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 11:20"/>जेवी मार्था यीशु आवणे बाजरिनोह ज्यी खुबेर होमलीन ती यीशुह मिलने गियी, पुण मरीयम गेरूस रेनी। <verse eid="JHN 11:20"/><verse number="21" style="v" sid="JHN 11:21"/>मार्था यीशुह केयी, “एय मालीक, केदी तु न्या रेतो ते, मारो बाहख नाय मुरतो! <verse eid="JHN 11:21"/><verse number="22" style="v" sid="JHN 11:22"/>पुण एवी बी माहु मालुम हे, जो काय तु बोगवाना फाय मांगहे, तो बोगवान तुवाह आपी।”<verse eid="JHN 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23"/>यीशु तीह केयो, “तारो बाहख पुशो जीवतो एय जाय।”<verse eid="JHN 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24"/>मार्था यीशुह केयी, “होव माहु मालुम हे, काय सेवले दिह जा मुरेल हेते ता जीव उठणेन टेम माय तो जीवतालो एय जाय।”<verse eid="JHN 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25"/>यीशु तीह केयो, “पोशो जीव उठणो एने जीवाय मीच हे। मार पोर बुरहो केरनार मोरी बी जाय, तीबी जीवतालो एय जाय; <verse eid="JHN 11:25"/><verse number="26" style="v" sid="JHN 11:26"/>जो कुण जीवतालोच ने मार पोर बुरहो किरेह, तो केदिस नाय मोरी। काय तु ज्यी वाती पोर बुरहो किरेह?”<verse eid="JHN 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27"/>मार्था यीशुह केयी, “होव मालीक! मी बुरहो केरथु काय बोगवानान बिटोख मसी, जो ज्यी दुनिया माय आवण्यो ईतो, तो तुस हे।”<verse eid="JHN 11:27"/></para>
  <para style="s">यीशु रेड़नो</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28"/>उलोक केयीन मार्था ता रेन जात रेनी, एने तीन बोणीख मरयमीह आंगेच हादिन केयी, “गुरू न्यास हे, एने तुवाह हादेह।” <verse eid="JHN 11:28"/><verse number="29" style="v" sid="JHN 11:29"/>ज्यो होमेलतास मरीयम चालोच उठीन यीशुह मिलने आवी। <verse eid="JHN 11:29"/><verse number="30" style="v" sid="JHN 11:30"/>यीशु एवी वोर गावा माय नाह आयेल ईतो, पुण जाहरी मार्था यीशुह मिलायेल एती तो ताच जागाम ईतो। <verse eid="JHN 11:30"/><verse number="31" style="v" sid="JHN 11:31"/>तेवी जा यहुदि माणहे मरीयम हेऱ्या गेरा माय एता, एने तीह दिलासो आपणे बाजरियेल एता, ता मरयमीह चालोच उठीन बाहेर जाताली देख्या। ता इहकेरीन सोमज्या काय ज्यी माहणाम रेड़ने जाणे बाजरेनीह, तीन पासाण चाल देना।<verse eid="JHN 11:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32"/>जेवी मरीयम यीशु ईतो ता जागाम पोच गियी, ते यीशुन पाया पोड़ीन केयी, “एय मालीक, केदी तु न्याच रितो ते मारो बाहख नाय मुरतो!”<verse eid="JHN 11:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33"/>जेवी यीशु मरयमीह एने ती हेऱ्या आयेल यहुदि माणहाह रेड़ताला दिख्यो; तेवी जीवा माय जुलूम उदास, एने दुखी ईनो, <verse eid="JHN 11:33"/><verse number="34" style="v" sid="JHN 11:34"/>एने केयो, “तुमू ताह काहरी मीलेल हेते?”</para>
  <para style="p" vid="JHN 11:34">ता यीशुह केया, “एय मालीक, आवीन देख ले।”<verse eid="JHN 11:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35"/>यीशु रिड़नो। <verse eid="JHN 11:35"/><verse number="36" style="v" sid="JHN 11:36"/>तेवी यहुदि केया, “दिखो! ज्यो लाजराह कुलोक मोंग केरतालो।”<verse eid="JHN 11:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37"/>पुण ता माय रेन थोड़ाक इह केताला, “ज्यो ते आंदलाह देखता किरेल ईतो, एने लाजराह मुरेल माय रेन नाह वोचाड़ सेकतालो काय?”<verse eid="JHN 11:37"/></para>
  <para style="s">यीशु लाजराह जीवतो केरने</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38"/>यीशु मोना माय जुलूम दुखी एन माहणा माय आवो, तो माहेण एक गुफा एती, एने एक दिगोड़ मुयाला पोर मीलेल एता। <verse eid="JHN 11:38"/><verse number="39" style="v" sid="JHN 11:39"/>यीशु उकुम आप्यो, “दिगोड़ हेरकावो।”</para>
  <para style="p" vid="JHN 11:39">ता मुरेल तान बोणीख मार्था यीशुह केयी, “एय मालीक, ता माय रेन ते एवी गेंद आवीह। काहाकाय ताह मोरीन चार दिह एय जायेल हेते!”<verse eid="JHN 11:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40"/>यीशु तीह केयो, “तु बुरहो किरहे, ताहार बोगवानान बोड़ायीह दिखहे, इहकेरीन मी तुवाह नाह केयो काय?” <verse eid="JHN 11:40"/><verse number="41" style="v" sid="JHN 11:41"/>तेवी ता देगड़ाह हेरकाव देना, उवतो यीशु उपेर देखीन केयो, “एय आबा, मी तारो दन्यवाद केरथु, काय तु मारी होमेल लियेल हे। <verse eid="JHN 11:41"/><verse number="42" style="v" sid="JHN 11:42"/>एने मी जाणथु काय तु जेलेम मारी होमेलने, पुण मी न्याहरी टोलवाय रेनाह, ता माणहान वोजेसे मी इहकेरीन कियेल, काय ता बुरहो केरी काय माहु तु मुकलेल हे।” <verse eid="JHN 11:42"/><verse number="43" style="v" sid="JHN 11:43"/>ज्यो केयीन यीशु जोरेस आयड़ीन केयो, “एय लाजर बाहेर निकील आव!” <verse eid="JHN 11:43"/><verse number="44" style="v" sid="JHN 11:44"/>ते मुरेल माणुह माहणा माय रेन निकलीन बाहेर आव लागो, तान आथ पाय पोतड्यान पाटा केरीन, एने तान मुय बी पाटा केरीन बांद मीलेल एतो। यीशु माणहाह केयो, “ज्यान पाटा सोड़ दिवो, एने जाणे दिवो।”<verse eid="JHN 11:44"/></para>
  <para style="s">यीशुह मारनेन विचार केरनो</para>
  <para style="r">(<ref loc="MAT 26:1-15">मत्ती 26:1-15</ref>; <ref loc="MRK 14:1-2">मरकुस 14:1-2</ref>; <ref loc="LUK 22:1-2">लुका 22:1-2</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45"/>तेवी मरीयम हेऱ्या आयेल यहुदि माणहे ज्या कामाह दिखेल एता, ता माय रेन जुलूम जाणे यीशु पोर बुरहो केऱ्या। <verse eid="JHN 11:45"/><verse number="46" style="v" sid="JHN 11:46"/>पुण ता माय रेन थोड़ाक जाणे फरिसी फाय जाईन यीशुन कामान बाराम ताह केय देना। <verse eid="JHN 11:46"/><verse number="47" style="v" sid="JHN 11:47"/>तेवी मुखी चाकऱ्या एने फरिसी यहुदि माणहान मुठलो पुंचो बोहाड्या, एने केया, “ज्य माणुह ते जुलूम चोमेत्कारान काम देखाड़ने बाजरिनोह, आपु काय किरज्‍यो? <verse eid="JHN 11:47"/><verse number="48" style="v" sid="JHN 11:48"/>केदी आपु ज्याह इहीचकेरीन सोड़ देहु, ते आखा ज्या पोर बुरहो केरने बाज जाती, एने रोमी आवीन आपणो जागो एने राज दुया पोर आदिकार केर लेती!”<verse eid="JHN 11:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49"/>पुण ती वोरीह ने मुखी चाकऱ्या केफा ताह केयो, “तुमू कायच नाह जाणते! <verse eid="JHN 11:49"/><verse number="50" style="v" sid="JHN 11:50"/>आखा माणहान केरता एक माणुह मोरने जुवे, नाह ते आखी दुनिया खेतेम एय जाय, ज्यो आपणे केरता हाजो हे, ज्यो तुमूह सोमेजते नाह काय?” <verse eid="JHN 11:50"/><verse number="51" style="v" sid="JHN 11:51"/>ज्यी वात तो तान उगे रेन नाह केयो, पुण ती वोरीह ने मुखी चाकर्‍यो ईतो, एने तो जाणाव किऱ्यो काय यीशु यहुदि माणहान केरता मोरी। <verse eid="JHN 11:51"/><verse number="52" style="v" sid="JHN 11:52"/>एने यहुदि माणहान केरता ओलोच नाह, पुण ज्यानकेरता काय जाहरी ताहरी वेरायेल बोगवानान माणहाह टुलो केरनेन केरता मोरी।<verse eid="JHN 11:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 11:53"/>ते दिह रेन यहुदि आदिकारी यीशुह मारनेन विचार केरने बाज गीया। <verse eid="JHN 11:53"/><verse number="54" style="v" sid="JHN 11:54"/>तानकेरता यीशु उदाह यहुदि माणहान विची माय नाह गीयो, पुण ता रेन निकलीन हुनाला जागान आहने एप्रेम नावान गावा माय गीयो, तान चेला हिऱ्यो ता रेणे बाज गीयो।<verse eid="JHN 11:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55"/>यहुदि माणहान फसहान तिवार आहनेच एतो, एने जुलूम होवटा माणहे फसह तिवाराह रेन पेल सोताह चोखा केरनेन केरता यरूशलेम माय गीया। <verse eid="JHN 11:55"/><verse number="56" style="v" sid="JHN 11:56"/>ता यीशुह होदणे बाज गीया, एने मोंदिर माय उबरीन एका दिहराह केणे बाज गीया, “तुमू काय सोमेजतेह? काय यीशु तिवारा माय नाय आवी?” <verse eid="JHN 11:56"/><verse number="57" style="v" sid="JHN 11:57"/>एने मुखी चाकऱ्या एने फरिसी बी उकुम आप मीलेल एता काय यीशु का बी एय, तान बाराम कुणीह बी मालुम पोड़ जाय, ते आमुह केय, काहाकाय ता ताह देर सिके।<verse eid="JHN 11:57"/></para>
  <chapter eid="JHN 11"/>
  <chapter number="12" style="c" sid="JHN 12"/>
  <para style="s">यीशुन बेतनिया गावाम अबिषेक</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1"/>फसह ने तिवाराह रेन सोव दिह्या पेल यीशु बेतनिया माय आवो, जा लाजर रेतालो, एने ताह यीशु मुरेल माय रेन जीवतो किरेल ईतो। <verse eid="JHN 12:1"/><verse number="2" style="v" sid="JHN 12:2"/>ताहरी ता यीशुन केरता खाणो तियार केऱ्या; एने मार्था खाणो वाटणे बाजरियेल एती, एने यीशु हिऱ्यो खाणो खाणाराम रेन लाजर बी पाटला हिऱ्यो बोह रियेल ईतो। <verse eid="JHN 12:2"/><verse number="3" style="v" sid="JHN 12:3"/><note caller="+" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="LUK 7:37">लुका 7:37</ref>,<ref loc="LUK 7:38">38</ref></char></note>तेवी मरीयम जटामासीन आदो लीटर मोंगालो एने चोखो मोग मोग गेंदाण्यो तेल लेन आवी, एने यीशुन पाया पोर रोचीव देनी, एने तीन लेट्या केरीन यीशुन पायाह नुसी; एने तेलान गेंद ने वोजेसे आखो गेर जुलूम हाजो गेंदाणे बाज गीयो। <verse eid="JHN 12:3"/><verse number="4" style="v" sid="JHN 12:4"/>पुण यीशुन चेलाम रेन एक यहुदा इस्‍कोरिती ईतो, जो यीशुह देरावणार ईतो, तो केयो, <verse eid="JHN 12:4"/><verse number="5" style="v" sid="JHN 12:5"/><note caller="+" style="f"><char style="fr" closed="false">12:5 </char><char style="ft" closed="false">चांदीन सिक्‍का; देखी 6:7</char></note>“ज्या गेंदाण्यो तेलाह तीन होव चांदीन सिक्‍का माय वेचीन, गेरब्याह काहा नाह वाट देनी?” <verse eid="JHN 12:5"/><verse number="6" style="v" sid="JHN 12:6"/>तो गेरब्यान फिकेर केरीन ज्यी वात नाह केयो पुण तो चोर ईतो। एने पोयशान थेयली बी तास फाय रेताली एने थेयली माय जो बी टाकताला, तो काड़ लेतालो। <figure style="fig" alt="Alabaster jars" file="hk00142c.tif" size="col" copy="Horace Knowles ©" ref="12:3">संगमरमरान ठामलो </figure><verse eid="JHN 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7"/>यीशु केयो, “ओयीह रेन दिवो! ज्यी ते माहु बुजणेन तियारीम ज्यो आखो किरेल हे। <verse eid="JHN 12:7"/><verse number="8" style="v" sid="JHN 12:8"/>काहाकाय गेरीब माणहे ते जेलेम तुमरी हेऱ्या रेतेह, पुण मी तुमरी हिऱ्यो जेलेम नाय रेव।”<note caller="+" style="x"><char style="xo" closed="false">12:8 </char><char style="xt" closed="false"><ref loc="EXO 15:11">निर्गमन 15:11</ref></char></note><verse eid="JHN 12:8"/></para>
  <para style="s">लाजराह मारनेन विचार केरनो</para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9"/>जेवी यहुदि माणहाह मालुम पोड़नो काय यीशु बेतनियाम हे, ते ता यीशुह ओलास नाह, पुण लाजराह बी देखणे आयेल एता, काहाकाय ताह यीशु मुरेल माय रेन जीवतो किरेल ईतो। <verse eid="JHN 12:9"/><verse number="10" style="v" sid="JHN 12:10"/>तेवी मुखी चाकऱ्या लाजराह बी मारनेन विचार केऱ्या, <verse eid="JHN 12:10"/><verse number="11" style="v" sid="JHN 12:11"/>काहाकाय तान वोजेसे जुलूम होवटा यहुदि माणहे जात रेना, एने यीशु पोर बुरहो केऱ्या।<verse eid="JHN 12:11"/></para>
  <para style="s">जिकेल राज ने गेत यीशुन यरूशलेम माय रिगणो</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12"/>दिहरे दिह तिवाराम आयेल जुलूम होवटा माणहे होमल्या काय यीशु यरूशलेम माय आवणे बाजरिनोह। <verse eid="JHN 12:12"/><verse number="13" style="v" sid="JHN 12:13"/>तानकेरता माणहे खजुरान डालखा लेन यीशुह मिलने चाल पोड़ना एने ता आयड़ीन केणे बाज गीया, “होसन्‍ना! बोरकेतवालो हे इस्राएल ने राजा, जो मालक्यान नाव से आवेह!”<note caller="+" style="x"><char style="xo" closed="false">12:13 </char><char style="xt" closed="false"><ref loc="PSA 118:25">बजन 118:25</ref>,<ref loc="PSA 118:26">26</ref></char></note><verse eid="JHN 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 12:14"/>जेवी यीशुह एक गेदड़ान पिलो जुड़नो तेवी यीशु ता पोर बोह गीयो, जिहकेरीन पुस्तेक माय लिखेल हे,<verse eid="JHN 12:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15"/>“एय सियोन ने बेटी, मा बिय!<note caller="+" style="x"><char style="xo" closed="false">12:15 </char><char style="xt" closed="false"><ref loc="ZEC 9:9">जकर्‍या 9:9</ref></char></note></para>
  <para style="q1" vid="JHN 12:15">देख, तार राजा गेदड़ान पिला पोर बोहीन,</para>
  <para style="q2" vid="JHN 12:15">तार फाय आवणे बाजरिनोह।”<verse eid="JHN 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16"/>यीशुन चेला पेल ज्यी वातीह नाह सुमजेल एता, पुण जेवी यीशुन बोड़ाय एनी ते ताह एर आवी काय ज्यी वात ज्यास ने बाराम लेख मीलेल एती, एने माणहे बी ता हेऱ्या ओहलोच वेवार किरेल एता।<verse eid="JHN 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17"/>यीशु हेऱ्या एता ता माणहे इहकेरीन गोवाय देना, तो लाजराह माहणाम रेन हादिन मुरेल माय रेन जीवतो किरेल ईतो। <verse eid="JHN 12:17"/><verse number="18" style="v" sid="JHN 12:18"/>ज्यास ने वोजेसे माणहे यीशुह मिलने आयेल एता, काहाकाय ता हुमलेल एता काय यीशु ज्यो चोमेत्कार देखाड़ेल हे। <verse eid="JHN 12:18"/><verse number="19" style="v" sid="JHN 12:19"/>तेवी फरिसी एका दिहराह केणे बाज गीया, “तुमू नाह सोमज्या काय जो बी तुमू केरने बाजरेनाह, तो काय कामान नाह सोतो! दिखो, आखी दुनिया तान पासाण जात रेनीह!”<verse eid="JHN 12:19"/></para>
  <para style="s">युनानी माणहे यीशुह होदणो</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20"/>जा माणहे ता फसहान तिवारा माय बोक्ती केरने आयेल एता ताम रेन थोड़ाक युनानी एता। <verse eid="JHN 12:20"/><verse number="21" style="v" sid="JHN 12:21"/>ता गेलीलान बेतसेदान गावान रेणार फिलीपुस फाय आवीन ताह विन्ता केऱ्या, “गुरू, आमु यीशुह मिलने होदतेह।”<verse eid="JHN 12:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 12:22"/>ज्यी वात फिलीपुस आवीन अन्द्रियासाह केयो, तेवी ता दुयू जाईन यीशुह केया। <verse eid="JHN 12:22"/><verse number="23" style="v" sid="JHN 12:23"/>यीशु ताह जापाप आप्यो, “माणहान बेटाख ने बोड़ाय एणेन टेम आव लागेल हे। <verse eid="JHN 12:23"/><verse number="24" style="v" sid="JHN 12:24"/>मी तुमूह खेरीच केथु: जाह वोर गोवान दाणो बुई माय पोड़ीन मोरी नाह जात, ताह वोर तो एखालोच रीथे। पुण जेवी तो मोर जाथे, ते जुलूम पाकीह। <verse eid="JHN 12:24"/><verse number="25" style="v" sid="JHN 12:25"/><note caller="+" style="x"><char style="xo" closed="false">12:25 </char><char style="xt" closed="false"><ref loc="MAT 10:39">मत्ती 10:39</ref>; <ref loc="MAT 16:25">16:25</ref>; <ref loc="MRK 8:35">मरकुस 8:35</ref>; <ref loc="LUK 9:24">लुका 9:24</ref>; <ref loc="LUK 17:33">17:33</ref></char></note>जो तान जीवाह मोंगाल्लो जाणेह, तो ताह गोमाड़ देय; पुण ज्यी दुनिया माय जो तान जीवाह मोंग नाय केरी, तो ताह जेलेमक्यो जीवायीन केरता होमालीन मेली। <verse eid="JHN 12:25"/><verse number="26" style="v" sid="JHN 12:26"/>केदी एगदो मारी सेवा केरी, ते मार पासाण चाल पोड़ी, एने जाहरी मी हे ता मारो सेवक बी रेय। केदी एगदो मारी सेवा केरी, ताहार मारो आबोख तान मान मेली।<verse eid="JHN 12:26"/></para>
  <para style="s">यीशु खुद ने मोरनेन बाराम केणे</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27"/>“एवी मारो जीव गाबराणे बाजरिनोह। केरीन एवी मी काय केरू? ‘एय आबा, ज्या दुखा रेन माहु वोचाड़?’ काहाकाय ज्या टेमान केरता मी आयेल हे। <verse eid="JHN 12:27"/><verse number="28" style="v" sid="JHN 12:28"/>एय आबा, तार नावान बोड़ाय एणे दे!”</para>
  <para style="p" vid="JHN 12:28">तेवी हेरगाम रेन ओहलो बोल होमलानो, “मी तान बोड़ाय किरेल हे, उंजु बी केरूह।”<verse eid="JHN 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 12:29"/>तेवी जा माणहे उबरीन होमेलताला ता केया, वादेल गाजनोह, एने दिहरा केया, “एगदो हेरोगदुत ताह हिऱ्यो वातु किरेल हे।”<verse eid="JHN 12:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30"/>पुण यीशु केयो, “ज्यो आवाज मार केरता नाह, पुण तुमरी केरता ईयेल हे। <verse eid="JHN 12:30"/><verse number="31" style="v" sid="JHN 12:31"/>एवी ज्यी दुनियान नियाव केरनेन टेम आव लागेल हे; एवी ज्यी दुनिया पोर राज केरनार आदिकारी काड़ाय जाय। <verse eid="JHN 12:31"/><verse number="32" style="v" sid="JHN 12:32"/>एने मी केदी देरती पोर रेन उपेर चेड़ावाय जाह, ताहार आखा माणहाह मार फाय खेचुह।” <verse eid="JHN 12:32"/><verse number="33" style="v" sid="JHN 12:33"/>एने यीशु किहीक मुरन्यो हे, तो देखाड़नेन केरता इहकेरीन केणे बाजरियेल ईतो।<verse eid="JHN 12:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34"/>तेवी माणहे यीशुह केया, “आमु ते नेमान ज्यी वात होमलेल हेते काय मसी जेलेमक्‍योच रेय। ओवतो तु काहा किथे काय माणहान बेटाख उपेर चेड़ावाय जाणो जोरेवरी हे? ज्यो माणहान बिटोख कुण हे?”<note caller="+" style="x"><char style="xo" closed="false">12:34 </char><char style="xt" closed="false"><ref loc="PSA 110:4">बजन 110:4</ref>; <ref loc="ISA 9:7">यशाया 9:7</ref>; <ref loc="EZK 37:25">यहेजकेल 37:25</ref>; <ref loc="DAN 7:14">दानिएल 7:14</ref></char></note><verse eid="JHN 12:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35"/>यीशु ताह केयो, “एवी उजालो थोड़ीक वार वोर तुमरी विची माय हे, जाह वोर उजालो तुमरे हेऱ्यो हे, ताह वोर चालते रिवो, इही नाय एय काय आंदारो तुमूह कोंड लेय; काहाकाय आंदारलाम चालनाराह मालुम नाह काय तो का जाणे बाजरिनोह। <verse eid="JHN 12:35"/><verse number="36" style="v" sid="JHN 12:36"/>जाह वोर उजालो तुमरी हेऱ्यो हे, उजाला पोर बुरहो किरो, काहाकाय तुमू उजालान माणहे बोणी।”</para>
  <para style="p" vid="JHN 12:36">ज्‍यु वातु केयीन यीशु जात रिनो एने ताह रेन लिकीन रिनो।<verse eid="JHN 12:36"/></para>
  <para style="s">यीशु पोर माणहान बुरहो नाह केरनो</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37"/>यीशु माणहान ओंगाण जुलूम मोटला चोमेत्कार देखाड्यो, तीबी ता यीशु पोर बुरहो नाह केऱ्या। <verse eid="JHN 12:37"/><verse number="38" style="v" sid="JHN 12:38"/>काहाकाय यशायान जाणाव केरनारान वचन पुरो एय:<note caller="+" style="x"><char style="xo" closed="false">12:38 </char><char style="xt" closed="false"><ref loc="ISA 53:1">यशाया 53:1</ref></char></note></para>
  <para style="q1" vid="JHN 12:38">जो तो केयो, “एय मालीक, कुण आमरी खोबरी पोर बुरहो किरेल हे?</para>
  <para style="q2" vid="JHN 12:38">एने मालीकान ताकेत कुणी पोर देखाड़ेल हे?”<verse eid="JHN 12:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 12:39"/>ज्यानकेरता ता बुरहो नाह केर सेक्‍या, काहाकाय यशाया इही बी कियेल हे:<verse eid="JHN 12:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40"/>“बोगवान तान डोला आंदला,<note caller="+" style="x"><char style="xo" closed="false">12:40 </char><char style="xt" closed="false"><ref loc="ISA 6:10">यशाया 6:10</ref></char></note> एने</para>
  <para style="q2" vid="JHN 12:40">तान मोन वातड़ो केर दियेल हे,</para>
  <para style="q1" vid="JHN 12:40">काहाकाय ता डोला केरीन नाय देखी,</para>
  <para style="q2" vid="JHN 12:40">एने मोना केरीन नाय सोमजे,</para>
  <para style="q2" vid="JHN 12:40">ओहलो नाय एय ता मार उगे वोली,</para>
  <para style="q2" vid="JHN 12:40">एने ताह मी हुदारू।”<verse eid="JHN 12:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 12:41"/>यशाया ज्यो ज्यानकेरता कियेल काय तो यीशुन बोड़ायीह दिखेल ईतो।<verse eid="JHN 12:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42"/>तीबी यहुदि आदिकारी माय रेन जुलूम होवटा यीशु पोर बुरहो केऱ्या; पुण ता फरिसीन दाके आखान ओंगाण नाह मानताला, काहाकाय ताह बिय एती काय फरिसी ताह मोंदिर माय रेन निकाल देती। <verse eid="JHN 12:42"/><verse number="43" style="v" sid="JHN 12:43"/>काहाकाय ताह बोगवानान बोड़ाय रेन माणहान बोड़ाय जुलूम हाजो लागेह।<verse eid="JHN 12:43"/></para>
  <para style="s">यीशुन वचना केरीन माणहान नियाव एय</para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44"/>यीशु आयड़ीन केयो, “जो मार पोर बुरहो किरेह, तो मार पोर नाह, पुण माहु मोकेलनारा पोर बुरहो किरेह। <verse eid="JHN 12:44"/><verse number="45" style="v" sid="JHN 12:45"/>एने जो माहु दिखेह, तो माहु मोकेलनाराह दिखेह। <verse eid="JHN 12:45"/><verse number="46" style="v" sid="JHN 12:46"/>मी ज्यी दुनिया माय उजालो बोणीन आयेल हे, काहाकाय जो बी मार पोर बुरहो केरी तो आदारलाम नाय रेय। <verse eid="JHN 12:46"/><verse number="47" style="v" sid="JHN 12:47"/>जो मार वात होमलीन नाह मानेत, ताह मी गुनेगार नाह ठेरावेत। काहाकाय मी दुनियाह गुनेगार ठेरावणे नाह आयेल सोतो, पुण दुनियान सुटकारो केरनेन केरता आयेल हे। <verse eid="JHN 12:47"/><verse number="48" style="v" sid="JHN 12:48"/>जो बी मारो नाकारो केरीन मारो वचन नाय माने, तान नियाव केरनार एक हे एने जो वचन मी केथु, ‘तोच सेवले दिहे ताह गुनेगार ठेरावी।’ <verse eid="JHN 12:48"/><verse number="49" style="v" sid="JHN 12:49"/>काहाकाय मी मार उगे रेन वातु नाह किऱ्यो, पुण आबोख जो माहु मोकलेल हे तोच माहु उकुम आपेल हे, का काय काय केव एने काय काय बोलु। <verse eid="JHN 12:49"/><verse number="50" style="v" sid="JHN 12:50"/>एने मी जाणथु काय तान उकुम जेलेमक्यी जीवाय लावेह। तानकेरता जीहे आबोख माहु कियेल हे तिहेच मी तुमूह केथु।”<verse eid="JHN 12:50"/></para>
  <chapter eid="JHN 12"/>
  <chapter number="13" style="c" sid="JHN 13"/>
  <para style="s">यीशु चेलान पाय दोवणो</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1"/>यीशु जाण गीयो काय फसहान तिवारान पेल। माहु ज्यी दुनियाह सोड़ीन आबाख फाय जाणेन टेम आव लागेल हे। ते जीहे यीशु दुनियाम तान माणहा हिऱ्यो मोंग केरतालो, तिहेच केरीन ताह सेवली बुखेत वोर मोंग किरते रिनो।<verse eid="JHN 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">13:2 </char>
      <char style="ft" closed="false">सैतान यीशुह दुको दिन देरावणेन टेम; नाहते सैतान पेलुस निर्णय लियेल ईतो काय शिमोन ने सुरो यहुदा यीशुह दुको दिन देरावण्यो हे। </char>
    </note>यीशु एने तान चेला हांजीन खाणो खाणे बाजरियेल एता। पुण शिमोन ने बिटोख यहुदा इस्‍कोरितीन मोना माय पेलुच ने बुतड़ो यीशुह देरावणेन वात टाक मीलेल ईतो। <verse eid="JHN 13:2"/><verse number="3" style="v" sid="JHN 13:3"/>यीशुह मालुम एतो काय आबोख आखो काय मार आथाम आप दियेल हे, एने मी बोगवाना फाय रेन आयेल हे; एने बोगवाना फाय जाथु। <verse eid="JHN 13:3"/><verse number="4" style="v" sid="JHN 13:4"/>तानकेरता यीशु खाणो खाणेन पासाण तान फाड़का काड्यो, एने एक पोटको लेन तान कोमेर बांद्यो। <verse eid="JHN 13:4"/><verse number="5" style="v" sid="JHN 13:5"/>तेवी ठामला माय पाणी बोरीन चेलान पाय दोवणे बाज गीयो एने जा पोटका केरीन कोमेर बांद रियेल ईतो, तास केरीन पाय नुसणे बाज गीयो। <verse eid="JHN 13:5"/><verse number="6" style="v" sid="JHN 13:6"/>जेवी यीशु शिमोन पतरस फाय आवो, तेवी पतरस केयो, “एय मालीक, तु मार पाय दुवेह काय?”<verse eid="JHN 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7"/>यीशु पतरसाह जापाप आप्यो, “जो मी केरथु, एवी तु ताह नाह जाणेत, पुण ज्यान पासाण सोमजेह।”<verse eid="JHN 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8"/>पतरस यीशुह केयो, “तु मार पायाह मा दुवे!”</para>
  <para style="p" vid="JHN 13:8">ज्यो होमलीन यीशु पतरसाह केयो, “केदी मी तारा पायाह नाय दोवु, ताहार मार हेऱ्यो तारो कायच बी बाग नाह।”<verse eid="JHN 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9"/>शिमोन पतरस यीशुह केयो, “एय मालीक, मार पाय ओलाच नाह! पुण मार आथ एने मुंड बी दोव दे!”<verse eid="JHN 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 13:10"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">13:10 </char>
      <char style="ft" closed="false">थोड़ाक लेख माय तान पायान सिवाय नाह लिखेल सोतो।</char>
    </note>यीशु पतरसाह केयो, “जो उंगील लेदोह, ताह तान पायाह सोड़ीन उंजु काह दोवणेन जोरेवरी नाह, पुण तो पुरो चोखो हे। तुमू चोखाला हेते, पुण आखान आखान चोखाला नाह।” <verse eid="JHN 13:10"/><verse number="11" style="v" sid="JHN 13:11"/>यीशु तान देरावणाराह जाणतालो तानकेरता यीशु केयो, “तुमरे माय आखान आखान चोखाला नाह।”<verse eid="JHN 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">13:12 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 22:27">लुका 22:27</ref>
      </char>
    </note>जेवी यीशु आखान पाय दोव दिनो, एने तान फाड़का पेरीन पुशो बोह गीयो। ते चेलाह केयो, “तुमू सोमज्या काय मी तुमरी हिऱ्यो काय किरेल हे? <verse eid="JHN 13:12"/><verse number="13" style="v" sid="JHN 13:13"/>माहु तुमू गुरू एने मालीक केतेह, ज्यो ठिकुच केतेह, काहाकाय मी तोच हे। <verse eid="JHN 13:13"/><verse number="14" style="v" sid="JHN 13:14"/>मी ज्‍यु गुरू, एने मालीक एन तुमरा पाय दुयेल हे। ते तुमूह बी एका दिहरान पाय दोवणे जुवे। <verse eid="JHN 13:14"/><verse number="15" style="v" sid="JHN 13:15"/>काहाकाय मी ज्यो तुमूह एक नमुनो देखाड़ दियेल हे काय जिहकेरीन मी तुमरी हिऱ्यो किरेल हे, तिहेच केरीन तुमू बी दिहरा हेऱ्या केऱ्या किरो। <verse eid="JHN 13:15"/><verse number="16" style="v" sid="JHN 13:16"/><note caller="+" style="x"><char style="xo" closed="false">13:16 </char><char style="xt" closed="false"><ref loc="MAT 10:24">मत्ती 10:24</ref>; <ref loc="LUK 6:40">लुका 6:40</ref>; <ref loc="JHN 15:20">योहान 15:20</ref></char></note>मी तुमूह खेरीच केथु, ‘पावोर तान मालक्याह रेन मुठो नाह, एने मोकलायेल तान मोकेलनाराह रेन मुठो नाह।’ <verse eid="JHN 13:16"/><verse number="17" style="v" sid="JHN 13:17"/>ज्यी वात तुमू जाणतेह, एने केदी ती पोर चालहो ते बोरकेतवाला हेते!”<verse eid="JHN 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18"/>मी तुमरे आखान बाराम नाह केणे बाजरिनोह; एने मी जाह निवाड़ रिनोह। ताह मी ओलेखथु; पुण ज्यो ज्यानकेरता हे काय पुस्तेक ने ज्यी वात पुरी एणे जुवे, “जो मार रूटो खाते, तोच माहु दुको दियेल हे।<note caller="+" style="x"><char style="xo" closed="false">13:18 </char><char style="xt" closed="false"><ref loc="PSA 41:9">बजन 41:9</ref></char></note> <verse eid="JHN 13:18"/><verse number="19" style="v" sid="JHN 13:19"/>एवी मी ज्यी गेटना एणेन पेल तुमूह केय देथु, काहाकाय जेवी ज्यी गेटना एय जाय, तेवी तुमू बुरहो किरो काय ‘मी तोच हे।’” <verse eid="JHN 13:19"/><verse number="20" style="v" sid="JHN 13:20"/><note caller="+" style="x"><char style="xo" closed="false">13:20 </char><char style="xt" closed="false"><ref loc="MAT 10:40">मत्ती 10:40</ref>; <ref loc="MRK 9:37">मरकुस 9:37</ref>; <ref loc="LUK 9:48">लुका 9:48</ref>; <ref loc="LUK 10:16">10:16</ref></char></note>मी तुमूह खेरीच केथु: “जो मार मोकेलनाराह स्वीकार किरेह तो माहु स्वीकारेह; एने जो माहु स्वीकारेह तो मार मोकेलनाराह स्वीकारेह।”<verse eid="JHN 13:20"/></para>
  <para style="s">यीशु तान बुरहो तोड़नाराह देखाड़ेह</para>
  <para style="r">(<ref loc="MAT 26:20-25">मत्ती 26:20-25</ref>; <ref loc="MRK 14:17-21">मरकुस 14:17-21</ref>; <ref loc="LUK 22:21-23">लुका 22:21-23</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21"/>जेवी यीशु ज्‍यु वातु केय दिनो, तेवी यीशु जीवा माय जुलूम दुखी ईनो, एने ज्यी गोवाय दिनो, “मी तुमूह खेरीच केथु, तुमरे माय रेन एक माहु देरावी।”<verse eid="JHN 13:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22"/>ते चेला सेंका केरीन एका दिहरान उगे देखणे बाज गीया, एने केया, “ज्यो कुणीन बाराम केणे बाजरिनोह?” <verse eid="JHN 13:22"/><verse number="23" style="v" sid="JHN 13:23"/>तान चेलाम रेन एक जाह यीशु मोंग केरतालो, यीशु हिऱ्यो निड़ो वोलीन बुहेल ईतो। <verse eid="JHN 13:23"/><verse number="24" style="v" sid="JHN 13:24"/>तेवी शिमोन पतरस ताह ईसारो केरीन फुशो, “यीशुह फुस कुणीन बाराम किथे?”<verse eid="JHN 13:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25"/>तेवी तो तिहेच केरीन यीशुन साती निही डोंगो वोलीन यीशुह फुशो, “एय मालीक, तो कुण हे?”<verse eid="JHN 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26"/>यीशु जापाप आप्यो, “जाह मी रोटान टुकड़ो अंगुरान रोह माय बुड़ावीन आपुह, एने शिमोन इस्‍कोरितीन सोराह यहुदाह आप्यो।” <verse eid="JHN 13:26"/><verse number="27" style="v" sid="JHN 13:27"/>एने टुकड़ो लेताच ता माय बुतड़ो रिग गीयो। तेवी यीशु ताह केयो, “जो तु केरने हुदेह, तो उतवाल्युह केर!” <verse eid="JHN 13:27"/><verse number="28" style="v" sid="JHN 13:28"/>यीशु काहा इहकेरीन केयो ज्यान बाराम पाटला हेऱ्या बोह रियेल एकाह बी ज्यी वात सोमेज माय नाह आवी। <verse eid="JHN 13:28"/><verse number="29" style="v" sid="JHN 13:29"/>पोयशान थेयली यहुदा फाय रेताली, केरीन थोड़ाक ज्यो सोमेजना काय यीशु तिवारान केरता जोरेवरी सोमान वेचातो लावणे किथे, एने ज्यो काय गेरब्याह काह आपणेन किथे।<verse eid="JHN 13:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 13:30"/>तेवी यहुदा रोटान टुकड़ो लेन चालोच बाहेर जात रिनो। एने ज्यी रातीन टेम एती।<verse eid="JHN 13:30"/></para>
  <para style="s">एक नोवालो उकुम</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31"/>जेवी यहुदाह बाहेर जात रेणेन बाद यीशु केयो, “एवी माणहान बेटाख ने बोड़ाय ईयेल हे, एने बोगवानान बोड़ाय ता माय ईयेल हे। <verse eid="JHN 13:31"/><verse number="32" style="v" sid="JHN 13:32"/>केदी बोगवानान बोड़ाय तान द्‍वारा ईयेल हे, ते बोगवान बी खुद तान बोड़ाय केरी, एने चालोच केरी। <verse eid="JHN 13:32"/><verse number="33" style="v" sid="JHN 13:33"/><note caller="+" style="x"><char style="xo" closed="false">13:33 </char><char style="xt" closed="false"><ref loc="JHN 7:34">योहान 7:34</ref></char></note>एय मार सोरा, मी उंजु थोड़ीक वार तुमरी हिऱ्यो हे ओवता तुमू माहु हुदहो। पुण जा मी जाथु ता तुमू नाह आव सेकते; इहकेरीन मी यहुदि आदिकारीह कियेल ईतो, ‘एने एवी मी तिहेच केरीन तुमूह बी केथु।’ <verse eid="JHN 13:33"/><verse number="34" style="v" sid="JHN 13:34"/><note caller="+" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="JHN 15:12">योहान 15:12</ref>,<ref loc="JHN 15:17">17</ref>; <ref loc="1JN 3:23">1 योहान 3:23</ref>; <ref loc="2JN 1:5">2 योहान 1:5</ref></char></note>एने मी तुमूह एक नोवालो उकुम आपथु, ‘तुमू एका दिहरा पोर मोंग किरो। जिहकेरीन मी तुमरी हिऱ्यो मोंग किरेल हे, तिहेच केरीन तुमू बी एका दिहरा हेऱ्या मोंग किरो।’ <verse eid="JHN 13:34"/><verse number="35" style="v" sid="JHN 13:35"/>केदी तुमू एका दिहरा हेऱ्या मोंग किरहो, ते आखा माणहे जाण जाती काय तुमू मारा चेला हेते।”<verse eid="JHN 13:35"/></para>
  <para style="s">पतरस माहु नाकारी ज्यान बाराम यीशु केणे</para>
  <para style="r">(<ref loc="MAT 26:31-35">मत्ती 26:31-35</ref>; <ref loc="MRK 14:27-31">मरकुस 14:27-31</ref>; <ref loc="LUK 22:31-34">लुका 22:31-34</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36"/>शिमोन पतरस यीशुह फुशो, “एय मालीक, तु का जाथे?”</para>
  <para style="p" vid="JHN 13:36">यीशु जापाप आप्यो, “जा मी जाथु ता मार पासाण एवी तु नाह आव सिकेत; पुण बाद माय मार पासाण आवहे।”<verse eid="JHN 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37"/>पतरस यीशुह केयो, “एय मालीक, मी तार पासाण एवी काहा नाह आव सेकथु? तार केरता मी मार जीवाह बी आप देह!”<verse eid="JHN 13:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38"/>यीशु पतरसाह जापाप आप्यो, “तु मार केरता तारा जीवाह आप दिहे काय? मी तुवाह खेरीच केथु, ‘कुकड़ो वाहणेन पेल तु तीन वारीन माहु नाकार हे।’”<verse eid="JHN 13:38"/></para>
  <chapter eid="JHN 13"/>
  <chapter number="14" style="c" sid="JHN 14"/>
  <para style="s">बोगवाना फाय वोर पोचणेन वाट</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">14:1 </char>
      <char style="ft" closed="false">बुरहो किरो; नाहते तुमू बुरहो मिलो।</char>
    </note>यीशु तान चेलाह केयो, “तुमरो मोन दुखी नाय एय। बोगवाना पोर बुरहो किरो एने मार पोर बी बुरहो किरो। <verse eid="JHN 14:1"/><verse number="2" style="v" sid="JHN 14:2"/><note caller="+" style="f"><char style="fr" closed="false">14:2 </char><char style="ft" closed="false">केदी नाय एता ते; मार आबाख ने गेरा माय रेणेन केरता जुलूम जागो हे, एने केदी जागो नाय रितो, ते मी तुमूह केतालो काय मी जागु तियार केरने जाथु।</char></note>मार आबाख ने गेरा माय रेणेन केरता जुलूम जागो हे, एने केदी जागो नाय रितो, ते मी तुमूह केय दितो। काहाकाय मी तुमरी केरता जागो तियार केरनेन केरता जाथु। <verse eid="JHN 14:2"/><verse number="3" style="v" sid="JHN 14:3"/>एने तुमरी केरता जागो तियार केरनेन बाद, मी पुशो आवीन तुमूह मार फाय ली जाह काहाकाय जा मी रेथु ताहरी तुमू बी रिहो। <verse eid="JHN 14:3"/><verse number="4" style="v" sid="JHN 14:4"/>एने जाहरी मी जाथु, ताहरीवाली वाट तुमूह मालुम हे।”<verse eid="JHN 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5"/>थोमा यीशुह केयो, “एय मालीक, आमु नाह जाणते काय, तु का जाणे बाजरिनोह; ते आमु ता जाणेन वाट किहीक जाणज्यु?”<verse eid="JHN 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6"/>यीशु थोमाह केयो, “वाट एने खेराय एने जीवाय मीच हे; मार बिगेर कुण बी आबाख फाय नाय जाय सेकी। <verse eid="JHN 14:6"/><verse number="7" style="v" sid="JHN 14:7"/><note caller="+" style="f"><char style="fr" closed="false">14:7 </char><char style="ft" closed="false">एवी तुमू माहु ओलेखतेह, तुमूह मालुम एय जाय; थोड़ाक लेख माय केदी तुमू माहु जाण लेता ते माहु ओलेखता।</char></note>केदी तुमू माहु जाण लेता, ते तुमू मार आबाख बी जाणता; एने एवी ते तुमू ताह जाणतेह, एने देखी बी लियेल हेते।”<verse eid="JHN 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8"/>फिलीपुस यीशुह केयो, “एय मालीक, हेरगान आबोख आमुह देखाड़ दे; ज्योस आमरी केरता जुलूम हे।”<verse eid="JHN 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9"/>यीशु ताह केयो, “एय फिलीपुस, मी ओला दिह वोर तुमरी हिऱ्यो हे, तु माहु नाह जाणेत काय? जो कुण माहु दिखेल हे, तो मार आबाख दिखेल हे।” ते तु काहा किथे, “आमुह आबोख देखाड़?” <verse eid="JHN 14:9"/><verse number="10" style="v" sid="JHN 14:10"/>काय तु बुरहो नाह किरेत काय मी आबाख माय हे एने आबोख मार माय? जी वात मी तुमूह केथु, “ती वात मी खुद नाह केत। पुण हेरगावालो आबोख मार माय रेन तान काम किरेह। <verse eid="JHN 14:10"/><verse number="11" style="v" sid="JHN 14:11"/>तुमू मार पोर बुरहो किरो काय मी आबाख माय हे, एने आबोख मार माय हे। नाहते ता कामाह देखीन बुरहो किरो जा मी केरथु। <verse eid="JHN 14:11"/><verse number="12" style="v" sid="JHN 14:12"/>मी तुमूह खेरीच केथु: मार पोर बुरहो केरनारे जा काम मी केरथु, ताह रेन बी मोटला काम किरहो, काहाकाय मी आबाख फाय जाथु। <verse eid="JHN 14:12"/><verse number="13" style="v" sid="JHN 14:13"/>एने जो बी तुमू मार नावा केरीन मांगहो तो मी आपुह, काहाकाय बेटाख पोर रेन आबाख ने बोड़ाय एय। <verse eid="JHN 14:13"/><verse number="14" style="v" sid="JHN 14:14"/><note caller="+" style="f"><char style="fr" closed="false">14:14 </char><char style="ft" closed="false">थोड़ाक लेख माय तुमू नाह लिखेल हे।</char></note>केदी तुमू जो बी मार नावा केरीन मांगहो, ते मी ताह आपुह।”<verse eid="JHN 14:14"/></para>
  <para style="s">चोखाला जीवान वायदो</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15"/>केदी तुमू माहु मोंग केरतेह, ते मारा उकुमाह मानतेह। <verse eid="JHN 14:15"/><verse number="16" style="v" sid="JHN 14:16"/>एने मी आबाख फाय विन्ता केरूह, तेवी तो तुमरी हिऱ्यो जेलेमक्‍योच रेणेन केरता दिहरो एक मोदेक केरनार तुमूह आपी। <verse eid="JHN 14:16"/><verse number="17" style="v" sid="JHN 14:17"/><note caller="+" style="f"><char style="fr" closed="false">14:17 </char><char style="ft" closed="false">हे; थोड़ाक लेख माय एय लिखेल हे।</char></note>तो जीव जो बोगवानान खेरायीह देखाड़ीह। दुनिया ताह स्वीकार नाह किरेत, काहाकाय ता ताह नाह देख सेकते, एने नाह ताह जाणेल हेते। पुण तुमू ताह जाणतेह, काहाकाय तो तुमरी हिऱ्यो रीथे एने तुमरी माय हे।<verse eid="JHN 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 14:18"/>मी तुमूह विखावाला नाय सोडु; पुण मी पुशो तुमरी फाय आवथु। <verse eid="JHN 14:18"/><verse number="19" style="v" sid="JHN 14:19"/>एने थोड़ीक वार ने पासाण दुनिया माहु नाय देखी, पुण तुमू माहु दिखहो; काहाकाय मी जीवतालो हे, एने तुमू बी जीवताला रिहो। <verse eid="JHN 14:19"/><verse number="20" style="v" sid="JHN 14:20"/>ते दिह तुमू जाणहो काय मी मार आबाख माय हे, एने तुमू मार माय हेते, एने मी तुमरी माय हे।<verse eid="JHN 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 14:21"/>“जो कुण मार उकुमाह स्वीकार किरेह एने मानीह तोच माहु मोंग किरेह। एने जो माहु मोंग किरेह ताह मार आबोख मोंग किरेह; एने मी बी ताह मोंग केरूह एने सोताह ताह देखाडुह।”<verse eid="JHN 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22"/>तो यहुदा जो यहुदा इस्‍कोरिती नाह ईतो, ताह केयो, “एय मालीक, ज्यान काय कारेण हे काय तु सोताह आमुह देखाड़ने हुदेह पुण दुनियाह नाह?”<verse eid="JHN 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23"/>यीशु ताह जापाप आप्यो, “जो बी माहु मोंग केरी तो मारी हिकवोणाह मानी। एने मारो आबोख ताह मोंग केरी, ते मी एने मार आबोख ता फाय आवहु एने ता हेऱ्या रेहु। <verse eid="JHN 14:23"/><verse number="24" style="v" sid="JHN 14:24"/>जो माहु मोंग नाह किरेत, तो मार हिकवोण पोर नाह चालते; एने ज्यी हिकवोण तुमू होमेलतेह तो मारी नाह सोती, पुण माहु मोकेलनार आबाख ने हे।”<verse eid="JHN 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25"/>मी ज्‍यु वातु तुमूह तुलेचबूखी कियेल जेवी मी तुमरी हिऱ्यो ईतो। <verse eid="JHN 14:25"/><verse number="26" style="v" sid="JHN 14:26"/>मारो आबोख मार नावा केरीन एक मोदेक केरनार मोकली, चोखालो जीव तो तुमूह आखी वात हिकाड़ी, एने मी जो बी तुमूह कियेल हे, तो सोब एर केरावी।<verse eid="JHN 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 14:27"/>मी तुमरी केरता मार सान्ती सोड़ीन जाथु, ज्यी मारी खुद ने सान्ती तुमूह आपथु; जिहकेरीन दुनिया तुमूह सान्ती आपेह, तिहकेरीन मी नाह आपेत: तुमरो मोन नाय गाबराय एने नाय बिय। <verse eid="JHN 14:27"/><verse number="28" style="v" sid="JHN 14:28"/>तुमू माहु केतालो होमलेल हेते, “मी जाथु, एने पुशो तुमरी फाय आवुह, तुमू माहु मोंग केरता ताहार ज्यी वातीह रेन खुस एय जाता काय मी आबाख फाय जाथु। काहाकाय आबोख माहु रेन मुठो हे।” <verse eid="JHN 14:28"/><verse number="29" style="v" sid="JHN 14:29"/>एने मी ज्‍यु वातु एणेन पेल तुमूह केय दियेल हे, काहाकाय जेवी ज्‍यु वातु पुऱ्यू एत्यु, तेवी तुमू बुरहो केर सीको। <verse eid="JHN 14:29"/><verse number="30" style="v" sid="JHN 14:30"/>मी एवी तुमरी हिऱ्यो उंजु जादा वात नाय केरू, काहाकाय ज्यी दुनिया पोर राज केरनार आवीह। मार पोर तान काय आदिकार नाह। <verse eid="JHN 14:30"/><verse number="31" style="v" sid="JHN 14:31"/>पुण ज्यी वात ज्यानकेरता एणे बाजरेनीह काय दुनिया जाणे काय मी आबाख मोंग केरथु; एने आबोख जीहे उकुम माहु आपेल हे तिहेच केरीन मी केरथु।</para>
  <para style="p" vid="JHN 14:31">“एवी उठो, न्या रेन जाता।”<verse eid="JHN 14:31"/></para>
  <chapter eid="JHN 14"/>
  <chapter number="15" style="c" sid="JHN 15"/>
  <para style="s">यीशु खीरलो अंगुरान वेल</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1"/>खीरलो अंगुर ने वेल मी हे, एने मारो आबोख माली हे। <verse eid="JHN 15:1"/><verse number="2" style="v" sid="JHN 15:2"/>जी डाल मार माय रेन फोल नाह आपेत, तीह तो काट दिथे, पुण जी डाल फुलेह, तीह तो साटेह काहाकाय ती उंजु वोदार फोली। <verse eid="JHN 15:2"/><verse number="3" style="v" sid="JHN 15:3"/>जी हिकवोण मी तुमूह होमलाड़ेल हे तान वोजेसे पेलुच रेन तुमू चोखाला हेते। <verse eid="JHN 15:3"/><verse number="4" style="v" sid="JHN 15:4"/>तुमू मार माय बोणीन रिवो, एने मी तुमरे माय बोणीन रेह। एने जी डाल अंगुर ने वेलाम नाह रेत; ती तीन तीन नाह फोल सिकेत। तिहेच केरीन तुमू बी मार माय बोणीन रेया बिगेर फोल नाय लाव सिकहो।<verse eid="JHN 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5"/>अंगुर ने विलो मी हे, तुमू डाल्यु हेते। जो माहु माय बोणीन रीथे ता माय मी बोणीन रेथु, तेवी तो जुलूम फुलेह; काहाकाय मार बिगेर तुमू काय नाय केर सिकहो। <verse eid="JHN 15:5"/><verse number="6" style="v" sid="JHN 15:6"/>जो मार माय बोणीन नाह रेत, तो टुटेल डालीन गेत जुगाराय जाथे, एने ती हुक जाथे; तेवी माणहे त्युह टुलो केरीन आक्‍ठा माय हेलगाड़ देतेह। <verse eid="JHN 15:6"/><verse number="7" style="v" sid="JHN 15:7"/>केदी तुमू मार माय रिहो एने मार हिकवोण तुमरे माय रेय, ते तुमूह जो बी जुवेह तो मांगहो, तो तुमरी केरता एय जाय। <verse eid="JHN 15:7"/><verse number="8" style="v" sid="JHN 15:8"/>मारा आबाख ने बोड़ाय ज्यासकेरीन ईथे काय तुमू जुलूम होवटो फोल लावे; इहीचकेरीन तुमू मारा चेला ठेराहो। <verse eid="JHN 15:8"/><verse number="9" style="v" sid="JHN 15:9"/>जिहकेरीन आबोख माहु मोंग किऱ्यो, तिहेच केरीन मी तुमूह मोंग किऱ्यो; तुमू मारा मोंग माय बोणीन रिवो। <verse eid="JHN 15:9"/><verse number="10" style="v" sid="JHN 15:10"/>जीहे मी आबाख ने उकुमाह मानेन तान मोंगा माय बोणीन रियेल हे, तिहेच केरीन तुमू मारा उकुमाह मानहो, ताहार मारा मोंगा माय बोणीन रिहो।<verse eid="JHN 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 15:11"/>मी ज्‍यु वातु तुमूह ज्यानकेरता केथु, काय मारी खुसी तुमरे माय बोणीन रेय, एने तुमरी खुसी पुरी एय जाय।<verse eid="JHN 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 15:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">15:12 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 13:34">योहान 13:34</ref>; <ref loc="JHN 15:17">15:17</ref>; <ref loc="1JN 3:23">1 योहान 3:23</ref>; <ref loc="2JN 1:5">2 योहान 1:5</ref></char>
    </note>जीहे मी तुमूह मोंग किऱ्यो, तिहेच केरीन तुमू बी एका दिहरा हेऱ्या मोंग किरो, ज्यो मारो उकुम हे।<note caller="+" style="x"><char style="xo" closed="false">15:12 </char><char style="xt" closed="false"><ref loc="JHN 13:34-15:17">योहान 13:34–15:17</ref>; <ref loc="1JN 3:23">1 योहान 3:23</ref>; <ref loc="2JN 1:5">2 योहान 1:5</ref></char></note> <verse eid="JHN 15:12"/><verse number="13" style="v" sid="JHN 15:13"/>केदी एगदो माणुह तान जोड़ीदारान केरता सोतान जीव आप देय, तान मोंगाह रेन मोठो काल्लो मोंग नाह। <verse eid="JHN 15:13"/><verse number="14" style="v" sid="JHN 15:14"/>जो उकुम मी तुमूह आपथु, केदी ताह मानहो ते तुमू मारा जोड़ीदार हेते। <verse eid="JHN 15:14"/><verse number="15" style="v" sid="JHN 15:15"/>मी एवी रेन तुमूह पावोर नाय केव, काहाकाय पावोर नाह जाणेत काय तान मालीक काय किरेह। पुण मी तुमूह जोड़ीदार केथु, काहाकाय मी जी बी वात मारा आबाख फाय रेन होमलेन हे, ती आखी तुमूह केय देनीह। <verse eid="JHN 15:15"/><verse number="16" style="v" sid="JHN 15:16"/>तुमू माहु नाह निवाड्या; पुण मी तुमूह निवाड़ेल हे एने तुमू जाईन फोल लावो, एने तुमरो फोल जेलेम बोणीन रेय इहकेरीन मी तुमूह ठेरायेल हे। एने जो बी तुमू आबाख फाय मार नाव लेन मांगहो, ताहार बोगवान तुमूह आपी। <verse eid="JHN 15:16"/><verse number="17" style="v" sid="JHN 15:17"/>मी तुमूह ज्यो उकुम ज्यानकेरता आपेल हे काय तुमू एका दिहरा हेऱ्या मोंग किरो।<verse eid="JHN 15:17"/></para>
  <para style="s">दुनियान दुसमोनाय</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18"/>केदी दुनियान माणहे तुमू हेऱ्या दुसमोनाय मेलतेह, ते तुमू एर मिलज्यु काय तुमूह रेन पेल मार हेऱ्या ता दुसमोनाय मेल्या। <verse eid="JHN 15:18"/><verse number="19" style="v" sid="JHN 15:19"/>केदी तुमू ज्यी दुनियान रेता, ते दुनिया तुमूह तान गेत मोंग केरती। पुण तुमू दुनियान नाह सोता, काहाकाय मी तुमूह दुनियाम रेन निवाड़ लियेल हे, केरीन दुनिया तुमू हेरी दुसमोनाय मिलेह। <verse eid="JHN 15:19"/><verse number="20" style="v" sid="JHN 15:20"/><note caller="+" style="x"><char style="xo" closed="false">15:20 </char><char style="xt" closed="false"><ref loc="MAT 10:24">मत्ती 10:24</ref>; <ref loc="LUK 6:40">लुका 6:40</ref>; <ref loc="JHN 13:16">योहान 13:16</ref></char></note>मी तुमूह कियेल ईतो ती वातीह एर किरो: “पावोर तान मालक्याह रेन मुठो नाह सुतो,” ता माहु वेला केराया, तुमूह बी वेला केरावती; केदी ता मारी हिकवोणाह मानती, ताहार तुमरी बी हिकवोण मानती।<note caller="+" style="x"><char style="xo" closed="false">15:20 </char><char style="xt" closed="false"><ref loc="MAT 10:24">मत्ती 10:24</ref>; <ref loc="LUK 6:40">लुका 6:40</ref>; <ref loc="JHN 13:16">योहान 13:16</ref></char></note> <verse eid="JHN 15:20"/><verse number="21" style="v" sid="JHN 15:21"/>पुण ता तुमूह वेला केरावती काहाकाय तुमू मारा हेते; एने माहु मोकेलनाराह ता नाह जाणते। <verse eid="JHN 15:21"/><verse number="22" style="v" sid="JHN 15:22"/>मी आवीन तुमरी हिऱ्यो वात नाय किरतो, ताहार ता पापान दोसी नाय ठेराता; पुण एवी ता फाय तान पापान केरता काल्लो बी बाहानो नाह सोतो। <verse eid="JHN 15:22"/><verse number="23" style="v" sid="JHN 15:23"/>जो मार हिऱ्यो दुसमोनाय मिलेह, तो मार आबाख हिऱ्यो बी दुसमोनाय मिलेह। <verse eid="JHN 15:23"/><verse number="24" style="v" sid="JHN 15:24"/>केदी मी तान विची माय तो काम जो दिहरा केदिस नाह केऱ्या, ता नाय किरतो, ताहार ता पापान दोसी नाय ठेराता; पुण ता माहु एने मारा आबाख दुयाह बी देख्या एने दुयू हेऱ्या दुसमोनाय केऱ्या। <verse eid="JHN 15:24"/><verse number="25" style="v" sid="JHN 15:25"/>“ता बिगेर कामान मार हेऱ्या दुसमोनाय केऱ्या।”<note caller="+" style="x"><char style="xo" closed="false">15:25 </char><char style="xt" closed="false"><ref loc="PSA 35:19">बजन 35:19</ref>; <ref loc="PSA 69:4">69:4</ref></char></note> ज्यो वचन जो तान नेम माय लिखेल हे, तो खेरलो एय जाय: ज्यानकेरता ज्यो एनो।<verse eid="JHN 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26"/>पुण जेवी तो मोदेक केरनार आवी, जाह मी तुमरी फाय आबाख फाय रेन मोकलुह, मतलब खेरायीन जीव जो आबाख फाय रेन निकलेह, ते तो मारी गोवाय देय; <verse eid="JHN 15:26"/><verse number="27" style="v" sid="JHN 15:27"/>एने तुमू बी मारा गोवा हेते, काहाकाय सुरवात माय रेन तुमू मार हेऱ्या रियेल हेते।<verse eid="JHN 15:27"/></para>
  <chapter eid="JHN 15"/>
  <chapter number="16" style="c" sid="JHN 16"/>
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1"/>ज्‍यु वातु मी तुमूह ज्यानकेरता केयो काय तुमू तुमरा बोरहाह सोड़ नाय दिहो। <verse eid="JHN 16:1"/><verse number="2" style="v" sid="JHN 16:2"/>ता तुमूह बोक्‍तीन गेरा माय रेन निकाल देती, एने ओहलो टेम आवणे बाजरिनोह काय ता तुमूह मार टाकती एने ओहलो सोमेजती काय आमु बोगवानान सेवा केरतेह। <verse eid="JHN 16:2"/><verse number="3" style="v" sid="JHN 16:3"/>ता इहकेरीन ज्यानकेरता केरती काहाकाय ता नाहते आबाख जाणतेह एने नाह माहु। <verse eid="JHN 16:3"/><verse number="4" style="v" sid="JHN 16:4"/>पुण मी ज्‍यु वातु ज्यानकेरता तुमूह केथु, जेवी न्यान पुरो एणेन टेम आवी ताहार तुमूह एर आव जाय काय मी तुमूह पेलुच केय दियेल ईतो। मी ज्‍यु वातु पेल तुमूह नाह केयो, काहाकाय मी तुमरी हिऱ्यो ईतो।<verse eid="JHN 16:4"/></para>
  <para style="s">चोखाला जीवान काम</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 16:5"/>पुण एवी मी माहु मोकेलनारा फाय जाथु, एने “तु का जाथे” इहकेरीन तुमरे माय रेन कुण माहु फुसेत नाह। <verse eid="JHN 16:5"/><verse number="6" style="v" sid="JHN 16:6"/>पुण मी जो ज्‍यु वातु तुमूह कियेल हे, केरीन तुमरो मोन दुखाम बोराय जायेल हे। <verse eid="JHN 16:6"/><verse number="7" style="v" sid="JHN 16:7"/>तीबी मी तुमूह खेरीच केथु: मारो जाणो तुमरी केरता हाजो हे, काहाकाय मी नाय जाव ते मोदेक केरनार तुमरी फाय नाय आवी। पुण मी जाह तेवीच ताह तुमरी फाय मोकलुह। <verse eid="JHN 16:7"/><verse number="8" style="v" sid="JHN 16:8"/>एने जेवी तो आवी, तेवी दुनियान माणहाह तान पाप ने बारा माय एने देरमीपोणान बारा माय एने बोगवानान नियाव ने बारा माय स्पष्ट केरी। <verse eid="JHN 16:8"/><verse number="9" style="v" sid="JHN 16:9"/>तान पाप ने बारा माय ज्यानकेरता, काहाकाय ता मार पोर बुरहो नाह केरती; <verse eid="JHN 16:9"/><verse number="10" style="v" sid="JHN 16:10"/>एने तान देरमीपोणान बारा माय ज्यानकेरता, काहाकाय मी आबाख फाय जाथु एने तुमू माहु पोशा नाय दिखहो; <verse eid="JHN 16:10"/><verse number="11" style="v" sid="JHN 16:11"/>ता नियाव ने बाराम गेलेत हेते, काहाकाय ज्या दुनिया पोर राज केरनार आदिकारी पेलुस दोसी ठेराय जायेल हे।<verse eid="JHN 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12"/>माहु तुमूह उंजु बी जुलूम होवट्यु वातु केणु हे, पुण एवी तुमू त्युह वेठ नाह सेकते। <verse eid="JHN 16:12"/><verse number="13" style="v" sid="JHN 16:13"/>पुण जेवी जीव आवी, जो बोगवानान खेरायीह देखाड़ीह, तो तुमूह खेरायीन वाटी पोर ली जाय। काहाकाय तो तान खुद ने आदिकार से नाय केय, पुण जो काय होमली तोस केय, एने एणार्‍यु वातु तुमूह केय। <verse eid="JHN 16:13"/><verse number="14" style="v" sid="JHN 16:14"/>तो माहु बोड़ाय आपी, काहाकाय जो मी ताह केह ताह लेन तुमूह केय। <verse eid="JHN 16:14"/><verse number="15" style="v" sid="JHN 16:15"/>जो काय आबाख ने हे तो आखो मारो हे; केरीन जो काय मी जीवाह केह तो मार वातु माय रेन लेन तुमूह केय।<verse eid="JHN 16:15"/></para>
  <para style="s">दुख सुख माय बोदली जाय</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16"/>“थोड़ीक टेम ने पासाण तुमू माहु ओंगाण दिखहो नाय, एने थोड़ीक टेम ने पासाण तुमू माहु ओंगाण पोशा दिखहो।”<verse eid="JHN 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17"/>तेवी तान थोड़ाक चेला एका दिहराह केया, “ज्यो काय हे?” जो तो आपुह किथे, “थोड़ीक टेम ने पासाण तुमू माहु ओंगाण नाय दिखहो, एने थोड़ीक टेम ने पासाण तुमू माहु ओंगाण पोशा दिखहो,” एने ज्यो ज्यानकेरता काय मी आबाख फाय जाथु? <verse eid="JHN 16:17"/><verse number="18" style="v" sid="JHN 16:18"/>तेवी ता केया, “तो जो थोड़ीक टेम पासाण इहकेरीन जो ज्यो किथे ज्यान मतलब काय? तो काय किथे ज्यो आमुह सोमजेत नाह!”<verse eid="JHN 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19"/>यीशु सोमजी गीयो काय ता माहु सावाल फुसणे होदतेह, ते ताह केयो, “थोड़ीक टेम ने पासाण मी तुमूह ओंगाण देखाव नाय, एने थोड़ीक टेम ने पासाण तुमू माहु ओंगाण पोशा दिखहो, ज्यो मी तुमूह कियेल तान बाराम तुमू एका दिहराह फुसतेह काय? <verse eid="JHN 16:19"/><verse number="20" style="v" sid="JHN 16:20"/>मी तुमूह खेरीच केथु: ‘तुमू रिड़हो एने दुखी ईहो, पुण दुनिया खुसी मोणावी; तुमूह दुख एय, पुण तुमरो दुख खुसी माय बोदली जाय। <verse eid="JHN 16:20"/><verse number="21" style="v" sid="JHN 16:21"/>जिहकेरीन सोरो पायदा एणेन टेम माय बायकुह जुलूम तेकलीत ईथे, काहाकाय तो तीन दुख ने टेम हे, पुण जेवी ती सोराह पायदा केर दिथे, ताहार खुस एन ती दुखाह विहरी जाथे, काहाकाय एक सोरो दुनिया माय पायदा ईयेल हे। <verse eid="JHN 16:21"/><verse number="22" style="v" sid="JHN 16:22"/>तिहेच केरीन तुमूह एवी दुख ईयेल हे, पुण मी तुमूह पुशो मीलुह एने तुमरो मोन खुसी माय बोराय जाय, एने तुमरी खुसी तुमू फाय रेन कुण बी सांडाड़ नाय सेकी।’”<verse eid="JHN 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 16:23"/>ते दिह तुमू माहु काय सावाल नाय किरहो, एने मी ज्यो तुमूह खेरीच केथु: “केदी तुमू आबाख फाय रेन काय बी मांगहो, तो तुमूह मार नावा माय आप देय।<note caller="+" style="f"><char style="fr" closed="false">16:23 </char><char style="ft" closed="false">केदी तुमू आबाख फाय रेन काय बी मांगहो, तो तुमूह मार नावा माय आप देय; थोड़ाक लेख माय तुमू आबाख फाय जो काय मांगहो, तो मार नावा माय ती वात तुमूह आप देय।</char></note> <verse eid="JHN 16:23"/><verse number="24" style="v" sid="JHN 16:24"/>एवी वोर तुमू मारा नावा माय आबाख फाय रेन काय बी नाह मांग्‍या; मांगहो ते तुमू जुड़ी, काहाकाय तुमरी खुसी पुरी एय जाय।”<verse eid="JHN 16:24"/></para>
  <para style="s">दुनिया पोर जिक</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25"/>“मी ज्‍यु वातुह तुमूह किस्सा माय कियेल हे। पुण ओहलो टेम आवीह काय मी तुमूह पुशो किस्सा माय नाय केव, पुण आखान ओंगाण तुमूह आबाख ने बाराम केह। <verse eid="JHN 16:25"/><verse number="26" style="v" sid="JHN 16:26"/>जेवी तो दिह आवी, तेवी तुमू मारा नावा माय मांगहो; एने मी तुमरी केरता आबाख फाय विन्ता केरूह, मी इहकेरीन तुमूह नाह केत; <verse eid="JHN 16:26"/><verse number="27" style="v" sid="JHN 16:27"/>काहाकाय आबोख खुद तुमूह मोंग किरेह। ज्यानकेरता काय तुमू माहु मोंग किरेल हेते एने ज्यो बी बुरहो किरेल हेते काय मी बोगवान ने उगे रेन आयेल हे। <verse eid="JHN 16:27"/><verse number="28" style="v" sid="JHN 16:28"/>मी आबाख ने उगे रेन दुनिया माय आयेल हे; मी एवी पुशो दुनियाह सोड़ीन आबाख फाय जाथु।”<verse eid="JHN 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29"/>तेवी चेला यीशुह केया, “होमेल, एवी ते तु किस्सो केया बिगेर उदाह आखी वातु किथे। <verse eid="JHN 16:29"/><verse number="30" style="v" sid="JHN 16:30"/>एवी आमु सोमजी गीया काय तु आखी वात जाणेह; एने एवी एगदाह तुवाह सावाल फुसणेन जोरेवरी नाह सोती। काहाकाय आमु बुरहो केरतेह काय तु बोगवानान उगे रेन आयेल हे।”<verse eid="JHN 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31"/>इहकेरीन होमलीन यीशु ताह जापाप आप्यो, “काय तुमू एवी बुरहो केरतेह? <verse eid="JHN 16:31"/><verse number="32" style="v" sid="JHN 16:32"/>हुमलो, ओहलो टेम आवीह, पुण आव लागेल हे काय तुमू आखा वेरासेर एय जाहो, एने आप आपणी गेर जात रिहो, एने माहु एखालोच सोड़ दिहो। तीबी मी एखालोच नाह, काहाकाय आबोख मार हिऱ्यो हे। <verse eid="JHN 16:32"/><verse number="33" style="v" sid="JHN 16:33"/>मी ज्‍यु वातु ज्यानकेरता केयो काय तुमूह मार माय सान्ती जुड़ी। ज्यी दुनिया तुमूह तेकलीत आपी। पुण ईमोत मीलो! मी दुनियाह जिक लियेल हे!”<verse eid="JHN 16:33"/></para>
  <chapter eid="JHN 16"/>
  <chapter number="17" style="c" sid="JHN 17"/>
  <para style="s">चेलान केरता यीशुन विन्ता</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1"/>यीशु इहकेरीन केणेन पासाण हेरगान उगे देखीन केयो, “एय आबा, तो टेम आव लागेल हे। तारा बेटाख ने बोड़ाय केर काय बिटोख बी तार बोड़ाय केर सेकी। <verse eid="JHN 17:1"/><verse number="2" style="v" sid="JHN 17:2"/>काहाकाय तु ताह आखा माणहा पोर आदिकार आपेल हे, तो जेलेमक्यी जीवाय जो ताह आपेल हे तो आखाह आप सेकी। <verse eid="JHN 17:2"/><verse number="3" style="v" sid="JHN 17:3"/>एने जेलेमक्यी जीवाय ज्यी हे काय ता तुवाह एकुच खेरला बोगवानाह, एने यीशु मसी जाह तु मुकलेल हे, जाणे। <verse eid="JHN 17:3"/><verse number="4" style="v" sid="JHN 17:4"/>जो काम तु माहु केरनेन केरता आपेल ईतो; ताह मी पुरो केरीन देरती पोर तारी बोड़ाय देखाड़ेल हे। <verse eid="JHN 17:4"/><verse number="5" style="v" sid="JHN 17:5"/>एने एवी एय आबा! तु तार हिऱ्यो मार बोड़ाय ती बोड़ाय से देखाड़, जी दुनिया बाणावणेन पेल किरेल ईतो।”<verse eid="JHN 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6"/>दुनियाम रेन जाह तु माहु आपेल। मी ताह तारा नावान बाराम देखाड़ेल हे। ता तारा एता पुण ताह तु माहु आपेल हे, एने ता तारा वचनाह मान लियेल हेते। <verse eid="JHN 17:6"/><verse number="7" style="v" sid="JHN 17:7"/>एवी ताह मालुम एय जायेल हे काय जो काय तु माहु आपेल हे, तो आखो तार उगे रेन हे। <verse eid="JHN 17:7"/><verse number="8" style="v" sid="JHN 17:8"/>काहाकाय जी खुबेर तु माहु आपेल, तीच खुबेर मी ताह आप दियेल हे; एने ता ताह स्वीकार किर लियेल हेते, एने ता खेरीच जाण जायेल हेते काय मी तार फाय रेन आयेल हे, एने बुरहो केर लियेल हेते काय तुच माहु मुकलेल हे।<verse eid="JHN 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 17:9"/>मी तान केरता विन्ता केरथु। पुण दुनियान केरता विन्ता नाह किरेत पुण जाह तु माहु आपेल हे तान केरता विन्ता केरथु, काहाकाय ता तारा हेते। <verse eid="JHN 17:9"/><verse number="10" style="v" sid="JHN 17:10"/>एने जो काय मारो हे तो आखो तारोच हे, एने जो तारो हे तो मारो हे; एने न्यान द्‍वारा माहु बोड़ाय जुड़ेल हे। <verse eid="JHN 17:10"/><verse number="11" style="v" sid="JHN 17:11"/><note caller="+" style="f"><char style="fr" closed="false">17:11 </char><char style="ft" closed="false">तार नावान ताकेत केरीन ताह होमाल, तो नाव जो तु माहु आपेल हे; थोड़ाक लेख माय जाह तु माहु आपेल ताह तार नावान ताकेत केरीन होमाल। </char></note>मी एवी ज्यी दुनिया माय नाय रेव, पुण ज्या ज्यी दुनिया माय रेती, एने एवी मी तार फाय आवथु। एय चोखाला आबा! तु ता नावान ताकेत केरीन ताह होमाल, जो तु माहु आपेल हे, काहाकाय जिहकेरीन तु एने मी एक हेते, तिहेच केरीन ता बी एक एय जाती। <verse eid="JHN 17:11"/><verse number="12" style="v" sid="JHN 17:12"/><note caller="+" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="JHN 13:18">योहान 13:18</ref></char></note>जेवी मी ता हिऱ्यो ईतो, ते मी तारा ता नावा केरीन जो तु माहु आपेल हे, तान राखवाली केऱ्यो। मी तान चोकसी किऱ्यो, एने खेतेम एणारा सोराह सोड़ीन ता माय रेन कुण खेतेम नाह एनो, ज्यानकेरता काय चोखाली पुस्तेक माय जो कियेल हे तो पुरो एय।<note caller="+" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="PSA 41:9">बजन 41:9</ref>; <ref loc="JHN 13:18">योहान 13:18</ref></char></note> <verse eid="JHN 17:12"/><verse number="13" style="v" sid="JHN 17:13"/>एवी मी तार फाय आवथु, पुण ज्यी वातु मी दुनिया माय रेणेन बुखेत केणे बाजरिनोह काय ता तान मोना माय मार पुरी खुसीह होद सेकी। <verse eid="JHN 17:13"/><verse number="14" style="v" sid="JHN 17:14"/>मी तारी खुबेर ताह होमलाड़ दियेल हे; पुण दुनियान माणहे तान दुसमोनाय केऱ्या, काहाकाय जिहकेरीन मी दुनियान नाह, तिहेच केरीन ता बी दुनियान नाह सोता। <verse eid="JHN 17:14"/><verse number="15" style="v" sid="JHN 17:15"/>मी इहकेरीन विन्ता नाह किरेत काय तु ताह दुनिया माय रेन लेय ले, पुण एक खाराबाह रेन ताह वोचाड़ीन मील। <verse eid="JHN 17:15"/><verse number="16" style="v" sid="JHN 17:16"/>जिहकेरीन मी दुनियान नाह, तिहेच केरीन ता बी दुनियान नाह सोता। <verse eid="JHN 17:16"/><verse number="17" style="v" sid="JHN 17:17"/>खेराय केरीन ताह निवाड़; तारो वचन खेरलो हे। <verse eid="JHN 17:17"/><verse number="18" style="v" sid="JHN 17:18"/>जिहकेरीन तु माहु ज्यी दुनिया माय मुकलेल हे, तिहेच केरीन मी बी ताह दुनिया माय मुकलेल हे। <verse eid="JHN 17:18"/><verse number="19" style="v" sid="JHN 17:19"/>एने मी तान केरता खुद तुवाह समर्पित केरथु, काहाकाय इहीचकेरीन ता बी खेराय केरीन सोताह तार केरता समर्पित केर सेकी।<verse eid="JHN 17:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20"/>मी न्यान केरता ओलोच विन्ता नाह किरेत, पुण ता माणहान केरता बी जा न्यान वचना पोर रेन मार पोर बुरहो केरतेह ता आखान केरता मी विन्ता केरथु। <verse eid="JHN 17:20"/><verse number="21" style="v" sid="JHN 17:21"/>काहाकाय ता आखा एक एणे जुवे। एय आबा मी इहकेरीन विन्ता केरथु काय जिहकेरीन तु मार माय, एने मी तार माय हे, तिहेच केरीन ता बी आपणेम एक एणे जुवे, ता पोर रेन दुनियान माणहे बुरहो केरी काय तुस माहु मोकलेल हे। <verse eid="JHN 17:21"/><verse number="22" style="v" sid="JHN 17:22"/>जी बोड़ाय तु माहु आपेल हे, ती मी ताह आपेल हे, काहाकाय ता बी आपणे गेत एक एय जाती। <verse eid="JHN 17:22"/><verse number="23" style="v" sid="JHN 17:23"/>मी ता माय एने तु मार माय, काय ता माहु माय पुरी रिती से एक एय जाय, एने दुनिया जाणे काय माहु तुस मुकलेल हे, एने जिहकेरीन तु माहु मोंग किरेल हे तिहेच केरीन ताह बी मोंग किर।<verse eid="JHN 17:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 17:24"/>“एय आबा! मार मोरजी ज्यी काय जाह तु माहु आपेल हे, ता मार हेऱ्या ताच रेती जा मी रेह, ज्यानकेरता काय तु माहु आपेल ती बोड़ायीह देख सिके, काहाकाय दुनियाह बाणावणेन पेल तु मार पोर मोंग किरेल हे। <verse eid="JHN 17:24"/><verse number="25" style="v" sid="JHN 17:25"/>एय देरमी आबा! दुनियान माणहे तुवाह नाह जाणते, पुण मी एवी तुवाह जाण लियेल हे; एने मार चेला बी एवी जाण गीयाह काय माहु तुच मुकलेल हे। <verse eid="JHN 17:25"/><verse number="26" style="v" sid="JHN 17:26"/>एने एवी तारो नाव मी ताह केयो एने कितेच रेह, काहाकाय तु जो मोंग मार पोर किऱ्यो, तोच मोंग ता माय बी रेय, काय मी ता माय रेव।”<verse eid="JHN 17:26"/></para>
  <chapter eid="JHN 17"/>
  <chapter number="18" style="c" sid="JHN 18"/>
  <para style="s">यीशुन देराणो</para>
  <para style="r">(<ref loc="MAT 26:47-56">मत्ती 26:47-56</ref>; <ref loc="MRK 14:43-50">मरकुस 14:43-50</ref>; <ref loc="LUK 22:47-53">लुका 22:47-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1"/>यीशु ज्यी विन्ता केरनेन पासाण, तान चेला हिऱ्यो किद्रोन नावान खोदरान ती मीरे गीयो। ताहरी एक बोगीच्‍यो एतो, जा माय यीशु एने तान चेला गीया। <verse eid="JHN 18:1"/><verse number="2" style="v" sid="JHN 18:2"/>एने यीशुह दुको देणार यहुदा बी ता जागान बाराम जाणतालो, काहाकाय यीशु तान चेलाह कायेम ती जागे मिलने जाया केरतालो। <verse eid="JHN 18:2"/><verse number="3" style="v" sid="JHN 18:3"/>तेवी यहुदा रोमी सिपायान एक टुलो लेन, एने थोड़ाक मुखी चाकर्‍यान एने फरिसीन द्‍वारा मोकलायेल थोड़ाक मोंदिर ने राखवाल्या हिऱ्यो दिवा बुलो एने आथ्‍यार लेन ताहरी आवो। <verse eid="JHN 18:3"/><verse number="4" style="v" sid="JHN 18:4"/>तेवी यीशुह मालुम एतो काय ता हेऱ्यो जो काय एण्यो एतो, तानकेरता ओंगाण आवो, एने ताह फुशो, “तुमू कुणीह होदणे बाजरेनाह?”<verse eid="JHN 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5"/>ता ताह जापाप आप्या, “यीशु नासरीह।” यीशु ताह केयो, “मी तोच हे।”</para>
  <para style="p" vid="JHN 18:5">यीशुह दुको देणार यहुदा बी ता हिऱ्यो उबरियेल ईतो। <verse eid="JHN 18:5"/><verse number="6" style="v" sid="JHN 18:6"/>जेवी यीशु केयो, “मी तोच हे,” ता पासाण हेरकीन बुय पोर जाय पोड़ना। <verse eid="JHN 18:6"/><verse number="7" style="v" sid="JHN 18:7"/>तेवी यीशु ताह उंजु फुशो, “तुमू कुणीह होदणे बाजरेनाह?”</para>
  <para style="p" vid="JHN 18:7">ता केया, “यीशु नासरीह।”<verse eid="JHN 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8"/>यीशु ताह जापाप आप्यो, “मी ते तुमूह पेलुस केय दिनो काय मी तोच हे, केदी तुमू माहु होदणे बाजरेनाह, ताहार न्याह दिहराह जाणे दिवो।” <verse eid="JHN 18:8"/><verse number="9" style="v" sid="JHN 18:9"/>ज्यो ज्यानकेरता एनो काय तो वचन जो पेल कियेल ईतो तो खेरीच पुरो एय जाय: “एय आबा जाह तु माहु आपेल हे, ता माय रेन मी एकाह बी नाह टाक्‍यो।”<verse eid="JHN 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10"/>तेवी शिमोन पतरसान आथाम तालवार एती, एने तो म्यान माय रेन तालवार काड़ीन मुखी चाकर्‍यान एक पावराह दिनो, एने तान जीवड्यो कान काट दिनो। ता पावरान नाव मलखुस एतो। <verse eid="JHN 18:10"/><verse number="11" style="v" sid="JHN 18:11"/><note caller="+" style="x"><char style="xo" closed="false">18:11 </char><char style="xt" closed="false"><ref loc="MAT 26:39">मत्ती 26:39</ref>; <ref loc="MRK 14:36">मरकुस 14:36</ref>; <ref loc="LUK 22:42">लुका 22:42</ref></char></note>तेवी यीशु पतरसाह केयो, “तारी तालवार म्यान माय मेल! काय मी तो दुखान पियालो नाय पिव जो आबोख माहु आपेल हे?”<verse eid="JHN 18:11"/></para>
  <para style="s">हन्नान ओंगाण यीशु</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12"/>तेवी रोमी सिपाय ने टुलो, एने तान आदिकारी एने यहुदिन मोंदिरान राखवाल्या यीशुह देरीन बांद लेदा। <verse eid="JHN 18:12"/><verse number="13" style="v" sid="JHN 18:13"/>एने पेल ताह हन्ना फाय ली गीया, काहाकाय हन्ना ता वोरह्यान मुखी चाकऱ्या केफान हाहरोख ईतो। <verse eid="JHN 18:13"/><verse number="14" style="v" sid="JHN 18:14"/><note caller="+" style="x"><char style="xo" closed="false">18:14 </char><char style="xt" closed="false"><ref loc="JHN 11:49">योहान 11:49</ref>,<ref loc="JHN 11:50">50</ref></char></note>ज्यो तोस केफा ईतो, जो यहुदि आदिकारीह सलाह आपेल ईतो काय आपणा आखा माणहान केरता एक एदमीह मोरने हाजो हे।<verse eid="JHN 18:14"/></para>
  <para style="s">पतरस यीशुह नाकारनो</para>
  <para style="r">(<ref loc="MAT 26:69-70">मत्ती 26:69-70</ref>; <ref loc="MRK 14:66-68">मरकुस 14:66-68</ref>; <ref loc="LUK 22:55-57">लुका 22:55-57</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15"/>शिमोन पतरस एने दिहरो एक चेलो बी यीशुन पासाण चाल पोड़ना। तो चेलो मुखी चाकर्‍यान ओलखातीन ईतो, केरीन तो बी एवी यीशु हिऱ्यो मुखी चाकर्‍यान खोली माय गीयो, <verse eid="JHN 18:15"/><verse number="16" style="v" sid="JHN 18:16"/>पुण पतरस बाहेर बायणा पोर उबरियेल ईतो। तेवी तो दिहरो चेलो पुशो बाहेर आवो, एने बायणान राखवाल केरनार सोरी हिऱ्यो वात किऱ्यो, एने पतरसाह मायतो लावो। <verse eid="JHN 18:16"/><verse number="17" style="v" sid="JHN 18:17"/>तेवी एक पावेरनी जी बायणान राखवालनी एती, पतरसाह केयी, “तु बी ज्या माणहान चेलाम रेन हे काय?”</para>
  <para style="p" vid="JHN 18:17">पतरस केयो, “मी ना सोतो।” <verse eid="JHN 18:17"/><verse number="18" style="v" sid="JHN 18:18"/>ईवालो एतो केरीन पावोर एने सिपाय कोल्यान आक्‍ठो पेटाड़ीन तापतेन कावदेन उबरियेल एता, एने ता हिऱ्यो पतरस बी तापतेन उबरियेल ईतो।<verse eid="JHN 18:18"/></para>
  <para style="s">मुखी चाकर्‍यान द्‍वारा यीशुन पुसतास</para>
  <para style="r">(<ref loc="MAT 26:59-66">मत्ती 26:59-66</ref>; <ref loc="MRK 14:55-64">मरकुस 14:55-64</ref>; <ref loc="LUK 22:66-71">लुका 22:66-71</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19"/>तेवी मुखी चाकर्‍यो यीशुह तान चेलान एने तान हिकवोणान बाराम पुसतास किऱ्यो। <verse eid="JHN 18:19"/><verse number="20" style="v" sid="JHN 18:20"/>यीशु ताह जापाप आप्यो, “मी कायेम आखान सामने उदाह वातु किरेल हे; मारो आखो हिकवोण बोक्‍तीन गेरा माय एने मोंदिर माय किरेल हे, जाहरी आखा यहुदि टोलवातेह। एने मी केदी बी लिकाएन काईस नाह केयो। <verse eid="JHN 18:20"/><verse number="21" style="v" sid="JHN 18:21"/>तु माहु काहा सावाल फुसीह? ता माणहाह सावाल फुस जा मार हिकवोण होमलेल हेते। ताह मालुम हे काय मी काय कियेल ईतो!”<verse eid="JHN 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22"/>जेवी यीशु इहकेरीन केयो, ते सिपाया माय रेन एक जो आहने उबरियेल ईतो, यीशुह थापोड़ देन केयो, “काय तु मुखी चाकऱ्याह इहकेरीन जापाप आपणेन ईमोत किरेह!”<verse eid="JHN 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23"/>यीशु ताह जापाप आप्यो, “केदी मी बाकतो केयो एय, ते न्याहरो आखाह के काय ज्यो काय एतो। पुण मी ठिख कियेल हे, ते तु माहु काहा दिथे?”<verse eid="JHN 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 18:24"/>तेवी हन्ना यीशुह बांदायेल मुखी चाकऱ्या केफा फाय मोकली दिनो।<verse eid="JHN 18:24"/></para>
  <para style="s">पतरस पुशो यीशुह नाकारनो</para>
  <para style="r">(<ref loc="MAT 26:71-75">मत्ती 26:71-75</ref>; <ref loc="MRK 14:69-72">मरकुस 14:69-72</ref>; <ref loc="LUK 22:58-62">लुका 22:58-62</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25"/>पतरस आक्‍ठो तापतेन ताहरी उबरियेल ईतो। तेवी दिहरा ताह केया, “काय तु बी तान चेला माय रेन एक जाण हे?”</para>
  <para style="p" vid="JHN 18:25">पुण शमोन पतरस नाकार केरीन केयो, “नाह, मी नाह सुतो।” <verse eid="JHN 18:25"/><verse number="26" style="v" sid="JHN 18:26"/>जान कान पतरस काट टाकेल ईतो, तान एक गेरल्यो मुखी चाकर्‍यान पावोर माय रेन ईतो। तो पतरसाह केयो, “काय मी तुवाह यीशु हिऱ्यो बोगीचा माय नाह दिखेल ईतो?” <verse eid="JHN 18:26"/><verse number="27" style="v" sid="JHN 18:27"/>पतरस पोशो नाकार किऱ्यो, एने चालोच कुकड़ो वाह दिनो।<verse eid="JHN 18:27"/></para>
  <para style="s">पिलातुसान सामने यीशु</para>
  <para style="r">(<ref loc="MAT 27:1-2">मत्ती 27:1-2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="MRK 15:1-5">मरकुस 15:1-5</ref>; <ref loc="LUK 23:1-5">लुका 23:1-5</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28"/>ओवता ता वेगोच ने टेम माय यीशुह केफान गेर रेन रोमी राजवाड़ा माय ली गीया। पुण यहुदि आदिकारी राजवाड़ा माय नाह गीया, काहाकाय ता फसहान तिवार खाणेन पेल रिती रिवाजान गेत सोताह एठो एने नाह होदताला। <verse eid="JHN 18:28"/><verse number="29" style="v" sid="JHN 18:29"/>तानकेरता पिलातुस ता फाय बाहेर आवीन फुशो, “तुमू ज्या माणहा पोर काल्ली वातीन गुनो लागाड़तेह?”<verse eid="JHN 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30"/>ता पिलातुसाह जापाप आप्या, “केदी ज्यो माणुह गुनेगार नाय रितो ताहार आमु ज्याह तार फाय काहा लावता।”<verse eid="JHN 18:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31"/>पिलातुस ताह केयो, “तुमूस ज्याह ली जाईन तुमरा नेमान गेत तान नियाव किरो।”</para>
  <para style="p" vid="JHN 18:31">यहुदि ताह जापाप आप्या, “आमुह कुणीन बी जीव लेणेन पारवांगी नाह सोती।” <verse eid="JHN 18:31"/><verse number="32" style="v" sid="JHN 18:32"/><note caller="+" style="x"><char style="xo" closed="false">18:32 </char><char style="xt" closed="false"><ref loc="JHN 3:14">योहान 3:14</ref>; <ref loc="JHN 12:32">12:32</ref></char></note>ज्यो ज्यानकेरता एनो काय यीशुन ती वात पुरी एय, जी तो ईसारो किरते लेन कियेल ईतो काय तान मोत किहीक एय।<verse eid="JHN 18:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33"/>तेवी पिलातुस पुशो राजवाड़ा माय गीयो, एने यीशुह हादिन फुशो, “काय तु यहुदिन राजा हे?”<verse eid="JHN 18:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34"/>यीशु ताह जापाप आप्यो, “काय तु ज्यो सावाल खुद केणे बाजरिनोह, नाहते दिहरा मार बाराम तुवाह ज्यो कियेल हेते?”<verse eid="JHN 18:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35"/>पिलातुस ताह जापाप आप्यो, “काय तुवाह लागीह काय मी एक यहुदि हे? तारीस जातीन माणहे एने मुखी चाकऱ्या तुवाह माहु हुप दियेल हेते। माहु कि, तु ओहलो काय किरेल हे?”<verse eid="JHN 18:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36"/>यीशु ताह जापाप आप्यो, “मारो राज ज्यी दुनियान नाह सोतो; केदी मारो राज ज्यी दुनियान रेतो, ते मार सेवक माहु यहुदि आदिकारीन आथाम होपाय जाणेन विरोद माय लेड़ाय केरता। पुण मारो राज न्यावालो नाह!”<verse eid="JHN 18:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37"/>पिलातुस यीशुह फुशो, “ते काय तु राजा हे?”</para>
  <para style="p" vid="JHN 18:37">यीशु जापाप आप्यो, “तु ठिख किथे काय मी राजा हे। मारो जेल्मो लेणेन कारेण ज्योस हे काय मी दुनिया माय खेरायीन बाराम गोवाय देव। जो कुण बी खेरायी हेऱ्यो समंद मिलेह, तो मारो होमलेह।”<verse eid="JHN 18:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38"/>पिलातुस यीशुह केयो, “खेराय काय हे?”</para>
  <para style="s" vid="JHN 18:38">यीशुह मोत डेंडान उकुम</para>
  <para style="r" vid="JHN 18:38">(<ref loc="MAT 27:15-31">मत्ती 27:15-31</ref>; <ref loc="MRK 15:6-20">मरकुस 15:6-20</ref>; <ref loc="LUK 23:13-25">लुका 23:13-25</ref>)</para>
  <para style="p" vid="JHN 18:38">तेवी पिलातुस पुशो यहुदि माणहा फाय बाहेर जाईन केयो, “माहु ज्या माय काय गुनो नाह देखात। <verse eid="JHN 18:38"/><verse number="39" style="v" sid="JHN 18:39"/>पुण तुमरी ज्यी रिती रिवाज हे काय मी फसह ने तिवारा माय तुमरी केरता एक आरापीह सोड़ देव। तुमू काय होदतेह, काय मी तुमरी केरता यहुदिन राजाह सोड़ देव?”<verse eid="JHN 18:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40"/>तेवी ता पोशा आयड़ीन जापाप आप्या, “ज्याह नाह, पुण आमरी केरता बरअब्बाह सोड़ दे!” बरअब्बा जो एक डाकु ईतो।<verse eid="JHN 18:40"/></para>
  <chapter eid="JHN 18"/>
  <chapter number="19" style="c" sid="JHN 19"/>
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1"/>तेवी पिलातुस यीशुह ली जाईन चापका देवाड्यो। <verse eid="JHN 19:1"/><verse number="2" style="v" sid="JHN 19:2"/>सिपायड़ा काटान डालखीन मुकूट गुथीन यीशुन मुंडा माय पेराव देना; एने ताह जामण्या रेंगान फाड़का पेराव देना। <verse eid="JHN 19:2"/><verse number="3" style="v" sid="JHN 19:3"/>एने ता फाय आवीन केया, “एय यहुदिन राजा! तु जुलूम जीवहे इहकेरीन केयीन ताह थाफड़ाठणे बाज गीया।”<verse eid="JHN 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4"/>तेवी पिलातुस पुशो बाहेर आवीन यहुदिन गेरदीह केयो, “हुमलो! मी ताह तुमू फाय लावथु, काहाकाय माहु ता माय कायच गुनो नाह देखात।” <verse eid="JHN 19:4"/><verse number="5" style="v" sid="JHN 19:5"/>तेवी यीशु काटान मुकूट एने जामण्या फाड़का पेरील बाहेर आवो, तेवी पिलातुस ताह केयो, “दिखो! ज्यो तोच एदमी हे।”<verse eid="JHN 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6"/>तेवी मुखी चाकऱ्या एने मोंदिरान राखवाल्या यीशुह देख्या, ते आयड़ीन केया, “ज्याह खुरूसखाम पोर चेड़ावो! खुरूसखाम पोर!”</para>
  <para style="p" vid="JHN 19:6">पिलातुस ताह केयो, “तुमूच ज्याह ली जाईन खुरूसखाम पोर चेड़ावो; काहाकाय माहु ज्या माय कायच गुनो नाह देखानो।”<verse eid="JHN 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7"/>यहुदि ताह केया, “आमरा नेमा माय लिखेल तान गेत ज्यो मोरनेन लायकीन हे, काहाकाय ज्यो सोता बोगवान बोणने होदेल हे।”<verse eid="JHN 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8"/>ताह इहकेरीन केताला होमलीन पिलातुस उंजु बी जुलूम बिय गीयो। <verse eid="JHN 19:8"/><verse number="9" style="v" sid="JHN 19:9"/>तेवी तो पुशो राजवाड़ा मायतो जाईन यीशुह केयो, “तु का रेन आयेल हे?”</para>
  <para style="p" vid="JHN 19:9">पुण यीशु ताह कायच जापाप नाह आप्यो। <verse eid="JHN 19:9"/><verse number="10" style="v" sid="JHN 19:10"/>तेवी पिलातुस यीशुह केयो, “तु माहु काहा वातु नाह किरेत? तु नाह जाणेत काय तुवाह सोड़ देणेन एने खुरूसखाम पोर चेड़ावणेन आदिकार मार फाय हे।”<verse eid="JHN 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11"/>यीशु ताह जापाप आप्यो, “तुवाह मार पोर ज्यानकेरता आदिकार हे काहाकाय ज्यो तुवाह बोगवान आपेल हे। केरीन जो माणुह माहु तुवाह होपेल हे। तान पाप जुलूम हे।”<verse eid="JHN 19:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12"/>ज्यो होमलीन पिलातुस ताह सोड़नेन कोसीत केरने होदतालो, पुण यहुदि आयड़ी आयड़ीन केया, “केदी तु ज्याह सोड़ दिहे, ताहार तु केसरान जोड़ीदार नाह सुतो! पुण जो कुण सोताह राजा बाणावीह तो केसर राजान विरोद किरेह।”<verse eid="JHN 19:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13"/>ज्‍यु वातु होमलीन पिलातुस यीशुह राजवाड़ा माय रेन बाहेर ली आवो, एने तो “देगड़ान ओटलान उपेर राजगादि” एती, ती पोर बोह गीयो। इब्रानी बाषा माय तान नाव “गब्बता हे।” <verse eid="JHN 19:13"/><verse number="14" style="v" sid="JHN 19:14"/>ज्यो फसह तिवारान पेल्ला दिह्यान वातु हे, एने तुलबूखे बारा वाजणेन आव रियेल एता। तेवी पिलातुस यहुदि माणहाह केयो, “दिखो! ज्योस तुमरो राजा हे!”<verse eid="JHN 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15"/>ज्या पोर रेन ता पोशा आयेड़ने बाज गीया, “ज्याह मार दिवो! मार दिवो! एने ज्याह खुरूसखाम पोर चेड़ाव दिवो!”</para>
  <para style="p" vid="JHN 19:15">तेवी पिलातुस ताह फुशो, “तुमरी मोरजी ज्यी हे काय मी तुमरा राजाह खुरूसखाम पोर चेड़ावो?”</para>
  <para style="p" vid="JHN 19:15">तेवी मुखी चाकऱ्या जापाप आप्या, “केसर राजाह सोड़ीन दिहरो काल्लोस आमरो राजा नाय मीले!”<verse eid="JHN 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 19:16"/>तेवी पिलातुस यीशुह खुरूसखाम पोर चेड़ावणेन केरता तान आथाम होप दिनो।</para>
  <para style="s" vid="JHN 19:16">यीशुह खुरूसखाम पोर चेड़ावणो</para>
  <para style="r" vid="JHN 19:16">(<ref loc="MAT 27:32-44">मत्ती 27:32-44</ref>; <ref loc="MRK 15:21-32">मरकुस 15:21-32</ref>; <ref loc="LUK 23:26-43">लुका 23:26-43</ref>)</para>
  <para style="p" vid="JHN 19:16">एने ता यीशुह तान ताबाम लेदा।<verse eid="JHN 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 19:17"/>तेवी ता यीशुह ली गीया, एने तो तान खुरूसखाम उखलीन “खोपड़ी केवातालो ती जागे आवो,” इब्रानी बाषाम ता जागाह “गुलगुता” केताला। <verse eid="JHN 19:17"/><verse number="18" style="v" sid="JHN 19:18"/>ताहरी ता यीशुह खुरूसखाम पोर चेड़ाया; एने ता हेऱ्या दिहरा दुय माणहाह बी खुरूसखाम पोर चेड़ाया, एकाह तान जीवड़े उगे एने एकाह डाखरे उगे, एने यीशुह विची माय। <verse eid="JHN 19:18"/><verse number="19" style="v" sid="JHN 19:19"/>पिलातुस एक गुनान चिट्ठी लेखीन खुरूसखाम पोर लागाड़ दिनो। ता पोर इहकेरीन लिखेल एतो, “यीशु नासरी, यहुदिन राजा हे।” <verse eid="JHN 19:19"/><verse number="20" style="v" sid="JHN 19:20"/>जुलूम यहुदि माणहे तो वाशा, काहाकाय यीशुह खुरूसखाम पोर चेड़ायेल तो जागो हेयरान आहनेच ईतो। एने गुनान चिट्ठी इब्रानी, लेटीन, एने युनानी बाषाम लिखेल एतो। <verse eid="JHN 19:20"/><verse number="21" style="v" sid="JHN 19:21"/>तेवी मुखी चाकऱ्या पिलातुसाह केया, “यहुदिन राजा मा लिखे,” पुण ज्यो केतालो तो लिख, “मी यहुदिन राजा हे।”<verse eid="JHN 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22"/>पिलातुस जापाप आप्यो, “मी जो लेख दिनो, तो लेख दिनो।”<verse eid="JHN 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23"/>जेवी सिपायड़ा यीशुह खुरूसखाम पोर चेड़ाव देना, ओवता सिपायड़ा तान फाड़काह चार ईसा पाड़ीन एक एक ईसो वाट लेदा। एने डेगलो बी काड़ लेदा, पुण डेगलो बिगेर हिवाय ने उपेर रेन नेचो वोर बुणेल एतो। <verse eid="JHN 19:23"/><verse number="24" style="v" sid="JHN 19:24"/>केरीन ता एकमेकाह केया, “आपु ज्याह नाह फाड़ते; पुण चिट्ठी टाकीन देखता काय ज्यो कुणीह जुड़ी।” ज्यो ज्यानकेरता एनो काय पुस्तेक माय जो कियेल एतो तो पुरो एय:</para>
  <para style="q1" vid="JHN 19:24">“ता मार फाड़का आपसाम वाट लेदा</para>
  <para style="q2" vid="JHN 19:24">एने मारा फाड़का पोर चिट्ठी टाक्या।”</para>
  <para style="p" vid="JHN 19:24">एने ज्यीच वातुह सिपाय पुरी केऱ्या।<verse eid="JHN 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25"/>यीशुन खुरूसखाम ने आहने तान आहख, एने तान जिजीक, एने क्‍लोपास ने बायकु मरीयम, एने मरीयम मगदलीनी उबरियेल एत्यु। <verse eid="JHN 19:25"/><verse number="26" style="v" sid="JHN 19:26"/>जेवी यीशु तान आईख एने जा चेलाह तो मोंग केरतालो; ताह आहने उबरियेल देखीन तान आईख केयो, “एय बाय, ज्यो तारो बिटोख हे।”<verse eid="JHN 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 19:27"/>ओवतो यीशु ता चेलाह केयो, “देख ज्यी तारी आहख हे।” एने तुलेचबूखी रेन चेलो तीह तान गेर रेणेन केरता ली गीयो।<verse eid="JHN 19:27"/></para>
  <para style="s">यीशुन मोत</para>
  <para style="r">(<ref loc="MAT 27:45-56">मत्ती 27:45-56</ref>; <ref loc="MRK 15:33-41">मरकुस 15:33-41</ref>; <ref loc="LUK 23:44-49">लुका 23:44-49</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28"/>यीशु जाणतालो काय एवी वोर आखो पुरो एय जायेल हे; एने पुस्तेक माय जो कियेल एतो तो पुरो एय, केयो, “मी तिहल्यो हे।” <verse eid="JHN 19:28"/><verse number="29" style="v" sid="JHN 19:29"/>ताहरी अंगुरान रोह केरीन बोरायेल एक ठामलो मीलेल ईतो, केरीन ता सीरका माय बिजाड़ेल स्पंजाह टोकरा माय विलगाड़ीन यीशुन मुये लागाड्या। <verse eid="JHN 19:29"/><verse number="30" style="v" sid="JHN 19:30"/>जेवी यीशु ता अंगुरान सीरकाह लेन केयो, “पुरो एय गीयो।”</para>
  <para style="p" vid="JHN 19:30">एने मुंड नेचो केरीन जीव सोड़ दिनो।<verse eid="JHN 19:30"/></para>
  <para style="s">यीशुन खुकीम बोरशो गुहुपणो</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31"/>तो फसहान तियारीन दिह ईतो केरीन यहुदि पिलातुस फाय विन्ता केऱ्या काय तान पाय तोड़ीन नेचा उतार दे, काहाकाय विहेवणेन दिहे ता खुरूसखाम पोर नाय रेणु जुवे काहाकाय तो विहेवणेन दिह खास दिह ईतो। <verse eid="JHN 19:31"/><verse number="32" style="v" sid="JHN 19:32"/>ओवता सिपाय आवीन यीशु हेऱ्या खुरूसखाम पोर चेड़ायेल दुय एदम्यान पाय तोड़ देना। <verse eid="JHN 19:32"/><verse number="33" style="v" sid="JHN 19:33"/>पुण जेवी ता यीशु फाय आवीन देख्या काय तो पेलुस मोर जायेल हे, केरीन तान पाय नाह तोड्या। <verse eid="JHN 19:33"/><verse number="34" style="v" sid="JHN 19:34"/>पुण सिपाय माय रेन एक जाण यीशुन खुकीम बोरशो गुहप्यो, एने चालोच लुय एने पाणी बाहेर निकेलनो। <verse eid="JHN 19:34"/><verse number="35" style="v" sid="JHN 19:35"/><note caller="+" style="f"><char style="fr" closed="false">19:35 </char><char style="ft" closed="false">बुरहो किरो; थोड़ाक लेख माय बुरहो मेलती रिवो।</char></note>जो ज्यो दिखेल हे, तोस गोवाय दियेल हे, एने तान गोवाय खेरली हे। एने तो ज्यो ज्यानकेरता केयो काय तुमू बी बुरहो किरो। <verse eid="JHN 19:35"/><verse number="36" style="v" sid="JHN 19:36"/>पुस्तेक माय ज्यो वचन पुरो एणेन केरता ज्‍यु वातु एन्यु: तान एक बी आड़ तोड़ाय नाय जाय। <verse eid="JHN 19:36"/><verse number="37" style="v" sid="JHN 19:37"/><note caller="+" style="x"><char style="xo" closed="false">19:37 </char><char style="xt" closed="false"><ref loc="REV 1:7">प्रकाशितवाक्य 1:7</ref></char></note>उंजु एक दिहरा बागा माय ज्यो लिखेल हे, “जा यीशुह बोरशा केरीन गुहपेल हेते, तान उगे ता देखती।”<verse eid="JHN 19:37"/></para>
  <para style="s">यीशुन बुजणो</para>
  <para style="r">(<ref loc="MAT 27:57-61">मत्ती 27:57-61</ref>; <ref loc="MRK 15:42-47">मरकुस 15:42-47</ref>; <ref loc="LUK 23:50-56">लुका 23:50-56</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38"/>ज्यी वातीन पासाण अरीमतीया गावान युसूफ यीशुन एक चेलो ईतो, पुण यहुदि आदिकारीन बियीन वोजेसे ज्यी वातीह लिकाड़ीन मेलतालो। तो यीशुन देड़ाह ली जाणेन केरता पिलातुसा फाय विन्ता किऱ्यो, पिलातुस तान विन्ताह होमल्यो, एने तो आवीन यीशुन देड़ाह ली गीयो। <verse eid="JHN 19:38"/><verse number="39" style="v" sid="JHN 19:39"/><note caller="+" style="x"><char style="xo" closed="false">19:39 </char><char style="xt" closed="false"><ref loc="JHN 3:1">योहान 3:1</ref>,<ref loc="JHN 3:2">2</ref></char></note>नीकुदेमुस जो पेल यीशु फाय राती जायेल ईतो, तो बी ता हेऱ्यो तीस किलो बेचकील गंदरस एने लोबान लेन गीयो। <verse eid="JHN 19:39"/><verse number="40" style="v" sid="JHN 19:40"/>तेवी तो यीशुन देड़ाह लिदो, एने यहुदिन बुजणेन रितीन गेत यीशुह गेंदाणार चिज हेऱ्यो फाड़का माय गुंडाल्या। <verse eid="JHN 19:40"/><verse number="41" style="v" sid="JHN 19:41"/>जाहरी यीशुह खुरूसखाम पोर चेड़ायेल ताहरी एक बोगीच्‍यो एतो, एने ता बोगीचा माय एक नोवालो माहेण एतो जा माय केदी कुण नाह मेलायेल एतो। <verse eid="JHN 19:41"/><verse number="42" style="v" sid="JHN 19:42"/>तो यहुदिन तियारीन पिल्लो दिह ईतो, केरीन ता यीशुह ताहरी मेल्या, काहाकाय तो माहेण आहने एतो।<verse eid="JHN 19:42"/></para>
  <chapter eid="JHN 19"/>
  <chapter number="20" style="c" sid="JHN 20"/>
  <para style="s">ठाल्लो माहेण</para>
  <para style="r">(<ref loc="MAT 28:1-8">मत्ती 28:1-8</ref>; <ref loc="MRK 16:1-8">मरकुस 16:1-8</ref>; <ref loc="LUK 24:1-12">लुका 24:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1"/>एप्तान पेल्ले दिह वेगोच आंदार लेस, मरीयम मगदलीनी माहणा माय आवी, एने माहणान बायणा पोर रेन दिगोड़ हेरकायेल देखी। <verse eid="JHN 20:1"/><verse number="2" style="v" sid="JHN 20:2"/>तेवी ती दोवड़तीन शिमोन पतरस एने ता चेला फाय गियी, जाह यीशु मोंग केरतालो, एने ताह केयी, “ता मालीकाह माहणा माय रेन निकाल ली जायेल हेते, एने ताह काहरी मीलेल हेते, ज्यो आमुह मालुम नाह!”<verse eid="JHN 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3"/>तेवी पतरस एने तो दुसरो चेलो माहणा उगे गीया। <verse eid="JHN 20:3"/><verse number="4" style="v" sid="JHN 20:4"/>एने ता दुयू एकठास दोवेड़ने बाजरियेल एता, पुण दुसरो चेलो पतरसाह रेन ओंगाण एन माहणा माय पेल पुचनो। <verse eid="JHN 20:4"/><verse number="5" style="v" sid="JHN 20:5"/>एने तो माहणा माय निवड़ीन फाड़का ओलाच पोड़ रियेल दिख्यो, पुण तो माय नाह रिगनो। <verse eid="JHN 20:5"/><verse number="6" style="v" sid="JHN 20:6"/>तेवी शिमोन पतरस बी तान पासाण आव पुचनो, एने माहणा माय रिगनो। एने फाड़का पुड़ रियेल दिख्यो <verse eid="JHN 20:6"/><verse number="7" style="v" sid="JHN 20:7"/>एने जो रूमाल यीशुन मुंडे बांदिल ईतो तो फाड़का हिऱ्यो पुड़ेल नाह। पुण आंगेच एक जागे गुंडालीन मीलेल दिख्यो। <verse eid="JHN 20:7"/><verse number="8" style="v" sid="JHN 20:8"/>तेवी दुसरो चेलो बी जो माहणा माय पेल पुचील ईतो, माय गीयो; एने देखीन बुरहो किऱ्यो। <verse eid="JHN 20:8"/><verse number="9" style="v" sid="JHN 20:9"/>ता एवी वोर पुस्तेक ने ती वात सोमजेल नाह एता, काहाकाय यीशुह मुरेल माय रेन पुशो जीव उठणे जोरेवरी हे। <verse eid="JHN 20:9"/><verse number="10" style="v" sid="JHN 20:10"/>तेवी चेला तान गेर पोशा जात रेना।<verse eid="JHN 20:10"/></para>
  <para style="s">मरीयम मगदलीनीह यीशु देखाणे</para>
  <para style="r">(<ref loc="MAT 28:9-10">मत्ती 28:9-10</ref>; <ref loc="MRK 16:9-11">मरकुस 16:9-11</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11"/>पुण मरीयम रेड़ती लेन माहणा हेऱ्यी बाहेर उबरियेल एती, एने ती रेड़ती जाईन माहणा माय निवड़ीन देखी। <verse eid="JHN 20:11"/><verse number="12" style="v" sid="JHN 20:12"/>एने जाहरी यीशुन देड़ मीलेल एतो, ताहरी दोवल्या फाड़का पिरील दुय हेरोगदुत एक मुंडान उहत्ये, एने दिहरो पायता बोह रियेल तीह देखाना। <verse eid="JHN 20:12"/><verse number="13" style="v" sid="JHN 20:13"/>हेरोगदुत तीह फुशा, “एय बाय, तु काहा रिड़ेह?”</para>
  <para style="p" vid="JHN 20:13">ती ताह जापाप आपी, “ता मार मालीकाह उखलीन ली गीया, एने माहु ज्यो नाह मालुम काय ताह काहरी मीलेल हेते!”<verse eid="JHN 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 20:14"/>इहकेरीन केयीन ती पासाण फिरनी एने यीशुह उबरियेल देखी; पुण तो यीशु हे ज्यो ती ओलख्यी नाह। <verse eid="JHN 20:14"/><verse number="15" style="v" sid="JHN 20:15"/>यीशु तीह फुशो, “एय बाय, तु काहा रिड़ेह? एने तु कुणीह हुदेह?”</para>
  <para style="p" vid="JHN 20:15">ती माली सोमजीन यीशुह केयी, “दादा केदी तु ताह न्या रेन उखलीन ली गीयो एय, ताहार ताह काहरी मीलेल हे माहु कि, एने मी ताह ली जाह।”<verse eid="JHN 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16"/>यीशु तीह केयो, “मरीयम!”</para>
  <para style="p" vid="JHN 20:16">ती तान उगे फिरीन इब्रानी बाषाम ताह केयी, “रब्बुनी!” मतलब “एय गुरू।”<verse eid="JHN 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17"/>यीशु तीह केयो, “माहु मा सापली, काहाकाय मी एवी वोर आबाख फाय उंजु गीयो नाह। पुण मार बायाख फाय जाईन किय दे काय जो मार आबोख एने तान आबोख हे ता फाय मी पुशो जाणे बाजरिनोह, तो मार बोगवान एने तान बोगवान हे।”<verse eid="JHN 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18"/>केरीन मरीयम मगदलीनी जाईन चेलाह केयी, “मी मालीकाह दिखेल हे, एने तो माहु ज्‍यु वातु कियेल हे।”<verse eid="JHN 20:18"/></para>
  <para style="s">यीशु चेलाह देखाणे</para>
  <para style="r">(<ref loc="MAT 28:16-20">मत्ती 28:16-20</ref>; <ref loc="MRK 16:14-18">मरकुस 16:14-18</ref>; <ref loc="LUK 24:36-49">लुका 24:36-49</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19"/>एप्तान पेल्ले दिह हांज पोर जाहरी चेला एता, काहाकाय तावाला बायणा यहुदि आदिकारीन बिय ने वोजेसे बोंद एता, तेवी तान विची माय यीशु आवीन उबरीन ताह केयो, “तुमूह सान्ती जुड़ी।” <verse eid="JHN 20:19"/><verse number="20" style="v" sid="JHN 20:20"/>इहकेरीन यीशु केयीन तान आथ एने तान खुकी चेलाह देखाड्यो। तेवी मालीकाह देखीन चेला खुस एना। <verse eid="JHN 20:20"/><verse number="21" style="v" sid="JHN 20:21"/>यीशु पुशो ताह केयो, “तुमूह सान्ती जुड़ी, जिहकेरीन आबोख माहु मुकलेल हे। तिहेच केरीन मी बी तुमूह मोकेलथु।” <verse eid="JHN 20:21"/><verse number="22" style="v" sid="JHN 20:22"/>इहकेरीन केयीन यीशु चेला पोर फुक्यो एने ताह केयो, “चोखालो जीव लिवो। <verse eid="JHN 20:22"/><verse number="23" style="v" sid="JHN 20:23"/><note caller="+" style="x"><char style="xo" closed="false">20:23 </char><char style="xt" closed="false"><ref loc="MAT 16:19">मत्ती 16:19</ref>; <ref loc="MAT 18:18">18:18</ref></char></note>केदी तुमू माणहान पाप माफ किरहो, ते तान पाप माफ एय जातेह; केदी तुमू ताह माफ नाह केरती, ते तुमरा पाप माफ नाह एते।”<verse eid="JHN 20:23"/></para>
  <para style="s">यीशु एने थोमा</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24"/>जेवी यीशु आयेल तेवी बारा चेला माय रेन एक मतलब दिदुमूस जुवल्यो केवाणार थोमा, ज्यो चेला हिऱ्यो नाह ईतो। <verse eid="JHN 20:24"/><verse number="25" style="v" sid="JHN 20:25"/>केरीन दिहरा चेला ताह केया, “आमु मालीकाह दिखेल हेते!”</para>
  <para style="p" vid="JHN 20:25">पुण थोमो ताह केयो, “जाह वोर मी यीशुन आथाम खीलान डोसा देख नाय लेव, एने खीलान डोसाम मारी आंगली रिगाड़ नाय लेव, एने तान खुकी माय मारो आथ नाय रिगाड़ लेव, ताह वोर मी बुरहो नाय केरू।”<verse eid="JHN 20:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26"/>आठ दिह्यान बाद यीशुन चेला उंजु गेरा माय एता, एने थोमा ता हिऱ्यो ईतो, एने बायणो बोंद एतो। तेवी यीशु आवो एने तान विचीम उबरीन केयो, “तुमूह सान्ती जुड़ी।” <verse eid="JHN 20:26"/><verse number="27" style="v" sid="JHN 20:27"/>ओवतो यीशु थोमाह केयो, “तु तारी आंगली ओरी केरीन मारा आथाह देख; एने तारो आथ ओंगाण केरीन मारा खुकी माय रिगाड़। अविश्वास केरने सोड़ दे, एने मार पोर बुरहो किर!”<verse eid="JHN 20:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28"/>इहकेरीन होमलीन थोमा जापाप आप्यो, “एय मारा मालीक, एय मारा बोगवान!”<verse eid="JHN 20:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29"/>यीशु थोमाह केयो, “काय तु माहु देखणेन पासाण मार पोर बुरहो किरेह, पुण जा माहु देख्या बिगेर बुरहो केरतेह, ता बोरकेतवाला हेते!”<verse eid="JHN 20:29"/></para>
  <para style="s">ज्यी पुस्तेकीन उद्देश</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30"/>यीशु दिहरा उंजु बी जुलूम होवटा चोमेत्कार तान चेलान ओंगाण देखाड़ेल, जा ज्यी पुस्तेक माय लेखायेल ना सोता। <verse eid="JHN 20:30"/><verse number="31" style="v" sid="JHN 20:31"/><note caller="+" style="f"><char style="fr" closed="false">20:31 </char><char style="ft" closed="false">मी बुरहो मेलथु; थोड़ाक लेख माय मी बुरहो मेलती रेथु लिखेल हे।</char></note>पुण ज्यो ज्यानकेरता लेखायेल हे, तुमू बुरहो केरी काय यीशुस बोगवानान बिटोख मसी हे, एने ता पोर बुरहो केरनेन द्‍वारा तुमू जीवाय सापड़ावहो।<verse eid="JHN 20:31"/></para>
  <chapter eid="JHN 20"/>
  <chapter number="21" style="c" sid="JHN 21"/>
  <para style="s">यीशु हात चेलाह देखाणे</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1"/>तान पासाण यीशु तीबीरीयास देरीया दिड़े चेलाह पुशो देखानो एने ज्यो इहकेरीन एनो: <verse eid="JHN 21:1"/><verse number="2" style="v" sid="JHN 21:2"/>शिमोन पतरस, थोमा जो दिदुमूस जुवल्यो केवाथे, गेलील ने काना गावान नथनेल, जब्दीन सोरा एने यीशुन चेला माय रेन दुय जाणे ताहरी टोलवाय रियेल एता। <verse eid="JHN 21:2"/><verse number="3" style="v" sid="JHN 21:3"/><note caller="+" style="x"><char style="xo" closed="false">21:3 </char><char style="xt" closed="false"><ref loc="LUK 5:5">लुका 5:5</ref></char></note>शिमोन पतरस ताह केयो, “मी मासा देरने जाणे बाजरिनोह।”</para>
  <para style="p" vid="JHN 21:3">ता पतरसाह केया, “आमु बी तार हेऱ्या आवतेह।” एने ता बी पतरसा हेऱ्या डोंडह्या माय बोहीन चाल पोड़ना, पुण ती राती ता कायच नाह देऱ्या।<verse eid="JHN 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 21:4"/>उजालो एताच यीशु देरीयान दिड़े आवीन उबरेय गीयो, पुण यीशु हे इहकेरीन चेला ताह ओलख्या नाह। <verse eid="JHN 21:4"/><verse number="5" style="v" sid="JHN 21:5"/>तेवी यीशु ताह फुशो, “एय जुवान्या, तुमू फाय खाणेन केरता काह मासा हेते काय?”</para>
  <para style="p" vid="JHN 21:5">ता जापाप आप्या, “नाह।”<verse eid="JHN 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">21:6 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 5:6">लुका 5:6</ref>
      </char>
    </note>यीशु ताह केयो, “डोंडह्यान जीवड़े उगे जाल टाको, ताहार तुमूह मासा सापड़ती।” ज्यो होमलीन ता जाल टाक्या, एने खेचाय नाय ओलाक मासा जाली माय फोस गीया।<verse eid="JHN 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7"/>जा चेलाह यीशु मोंग केरतालो, तो पतरसाह केयो, “ज्यो ते मालीक हे!” जेवी शिमोन पतरस मालीक हे इहकेरीन होमल्यो, तेवी शाल केरीन कोमेर बांदिन देरीया माय कुद पुड़नो, काहाकाय तो नांगरलोस ईतो। <verse eid="JHN 21:7"/><verse number="8" style="v" sid="JHN 21:8"/>पुण दिहरा चेला मासा माय बोरायेल जाल खेचती लेन डोंडह्या माय मीरे आवा, काहाकाय ता मेराह रेन जादा सेटा नाह एता, पुण कोमीत कोमी एक होव मिटर सेटा एता। <verse eid="JHN 21:8"/><verse number="9" style="v" sid="JHN 21:9"/>जेवी ता मेरा माय उतेरना, तेवी ता ईंगाला पोर मासो मीलेल एने रूटो देख्या। <verse eid="JHN 21:9"/><verse number="10" style="v" sid="JHN 21:10"/>यीशु ताह केयो, “जा मासा तुमू एवी दिरेल हेते, ता माय रेन थोड़ाक लावो।”<verse eid="JHN 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 21:11"/>शिमोन पतरस डोंडह्या माय चेड़ीन एक होव त्रेपन मोटला मासा माय बोरायेल जाल मेरा माय खेच लावो, एने ओला मासा एता, तीबी जाल फाटनी नाह। <verse eid="JHN 21:11"/><verse number="12" style="v" sid="JHN 21:12"/>यीशु ताह केयो, “आवो, खाणो खावो।” एने चेला माय रेन एकाह बी इहकेरीन फुसणेन ईमोत नाह एनी, “तु कुण हे?” काहाकाय ता जाणताला काय ज्यो मालीक हे। <verse eid="JHN 21:12"/><verse number="13" style="v" sid="JHN 21:13"/>यीशु आवीन रूटो विशो, एने ताह आप्यो; एने तिहेच केरीन मासा बी आप दिनो।<verse eid="JHN 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 21:14"/>यीशु मुरेल माय रेन जीव उठीन पासाण, तिसरी वार चेलाह देखानो।<verse eid="JHN 21:14"/></para>
  <para style="s">यीशु एने पतरस</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15"/>जेवी खाणो खायलीन पासाण यीशु शिमोन पतरसाह केयो, “एय शिमोन योहानान बेटाख, काय तु न्याह रेन वोदार माहु मोंग किरेह?”</para>
  <para style="p" vid="JHN 21:15">पतरस यीशुह केयो, “होव, मालीक, तु ते जाणेह काय मी तुवाह मोंग केरथु।”</para>
  <para style="p" vid="JHN 21:15">यीशु ताह केयो, “मारा मेंड्राह चार।” <verse eid="JHN 21:15"/><verse number="16" style="v" sid="JHN 21:16"/>यीशु दिहरी वार पुशो पतरसाह केयो, “एय शिमोन योहानान बेटाख, काय तु माहु मोंग किरेह?”</para>
  <para style="p" vid="JHN 21:16">पतरस ताह जापाप आप्यो, “होव, मालीक, तु जाणेह काय मी तुवाह मोंग केरथु।”</para>
  <para style="p" vid="JHN 21:16">यीशु ताह केयो, “मारा मेंड्रान राखवाल केर।” <verse eid="JHN 21:16"/><verse number="17" style="v" sid="JHN 21:17"/>यीशु तिसरी वार पुशो पतरसाह केयो, “एय शिमोन योहानान बेटाख, काय तु माहु मोंग किरेह?”</para>
  <para style="p" vid="JHN 21:17">तेवी पतरस दुखी एय गीयो काहाकाय यीशु तिसरी वार ताह इहकेरीन फुशो, “काय तु माहु मोंग किरेह?” तेवी पतरस यीशुह केयो, “एय मालीक, तु आखो जाणेह; तु ज्यो बी जाणेह काय मी तुवाह मोंग केरथु!”</para>
  <para style="p" vid="JHN 21:17">यीशु ताह केयो, “मारा मेंड्राह चार।” <verse eid="JHN 21:17"/><verse number="18" style="v" sid="JHN 21:18"/>मी तुवाह खेरीच केथु, “जेवी तु जुवान ईतो, तु खुद कोमेर बांदिन तुवाह जाहरी पोटतालो ताहरी फिरतालो; पुण जेवी तु डायो एय जाहे, तेवी तारा आथ लाम्बा किरहे एने दिहरो तुवाह बांदिन ताहरी ली जाय जाहरी तु जाणे नाह हुदीत।” <verse eid="JHN 21:18"/><verse number="19" style="v" sid="JHN 21:19"/>यीशु ज्यानकेरता इहकेरीन केयो काय पतरस किहकेरीन मोर जाय, एने बोगवानान बोड़ाय केरी। ओवतो यीशु ताह केयो, “मार पासाण आव!”<verse eid="JHN 21:19"/></para>
  <para style="s">यीशु एने दिहरो चेलो</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">21:20 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 13:25">योहान 13:25</ref>
      </char>
    </note>पतरस पासाण फिरीन ता चेलाह पासाण आवतालो दिख्यो, जाह यीशु मोंग केरतालो, एने जो खाणे बुखेत यीशुन साती निही डोंगो वोलीन फुसेल ईतो, “एय मालीक, तुवाह देरावणार कुण हे?” <verse eid="JHN 21:20"/><verse number="21" style="v" sid="JHN 21:21"/>पतरस ता चेलाह देखीन यीशुह केयो, “एय मालीक, ज्यान काय हाल एय?”<verse eid="JHN 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22"/>यीशु पतरसाह जापाप आप्यो, “मी आवो ताह वोर तो जीवतालो रेय, ओहली मारी मोरजी रेय ताहार तुवाह ज्यासे काय? तु मार पासाण आव!”<verse eid="JHN 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 21:23"/>तानकेरता यीशुन अनुयायी बाहख माय ज्यी वात पोसरी गियी काय ज्यो चेलो नाय मोरी। तीबी तो मोरी नाय इहकेरीन यीशु ताह कियेल नाह ईतो; पुण ज्यो केयो, “मी आवुह ताह वोर तो जीवतालो रेय। ओहली मारी मोरजी रेय ताहार तुवाह ज्यासे काय?”<verse eid="JHN 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24"/>ज्‍यु तोच चेलो हे जो ज्यी वातुह कियेल हे, एने ज्यी वातुह लिखेल हे; एने आमु जाणतेह काय तो जो कियेल हे तो खेरो हे।<verse eid="JHN 21:24"/></para>
  <para style="s">निवेरनो</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25"/>एवी, यीशु उंजु बी दिहरा जुलूम होवटा काम किरेल हे, केदी ता एक एक केरीन लेखाय जाता, ते मी सोमेजथु काय पुस्तेक जी लेखाय जात्यु, त्यु ज्यी दुनिया माय नाय होमात्यु।<verse eid="JHN 21:25"/></para>
  <chapter eid="JHN 21"/>
</usx>
