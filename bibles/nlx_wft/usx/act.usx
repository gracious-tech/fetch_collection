<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ACT" style="id">- Nahali</book>
  <para style="h">प्रेरितान काम</para>
  <para style="toc3">प्रेरितान काम</para>
  <para style="toc2">प्रेरितान काम</para>
  <para style="toc1">प्रेरितान काम</para>
  <para style="mt2">प्रेरितो के काम</para>
  <para style="mt1">प्रेरितान काम</para>
  <para style="imt">ओलखात</para>
  <para style="ip">प्रेरितान पुस्तेक सुरवातीन मोंडलीन बारा माय हे, ज्यी यरूशलेम रेन आखा यहुदिया, सामरीया देस एने ताह रेन ओंगाण किहीक पोसरती गियी। जिहकेरीन यीशु हेरगाम जाणेन पेल तान चेलाह कियेल ईतो। <char style="xt"><ref loc="ACT 1:8">1:8</ref></char> ज्या पुस्तेकाह लुका लिखेल हे जो लुकान हाजाली खुबेर लिखेल ईतो। लुका एक वोंसी एने आखी वातुन ईसाब मेलनार ईतो। लुका तान हाजाली खोबरीह एने प्रेरितान कामान पुस्तेक थियुफिलुस नावान एक ग्रीक एदम्यान केरता लिखेल हे, पुण पुस्तेक लेखणेन उद्देश ज्यो हे काय ईसाई समुह जा माय यहुदि एने बिगेर यहुदि दुयू सामील हेते। <char style="xt"><ref loc="ACT 1:1">1:1</ref></char></para>
  <para style="ip">प्रेरितान पुस्तेक यीशु मसीन जेल्मान पासाण कोम से कोम 60-64 सालान विची माय लेखायेल एती, काहाकाय ज्यी पुस्तेक पौलुसान जेल माय रेन सुटणेन पेल निवरी जाथे। लुका प्रेरित पौलुस हिऱ्यो यात्रा किरेल एने शायद अन्‍ताकिया हेयरा माय रेन ज्यी पुस्तेकीह लिख्यो एय।</para>
  <para style="ip">प्रेरितान पुस्तेक आमरे केरता सुरवातीन मोंडलीन उदारण प्रदान किरेह, एने यीशु मसी माय बुरहो केरीन किहीक जीवणु हे तो देखाड़ेह। एने प्रेरितान उदारण आमुह देखाड़ेह काय हाजाली खुबेर दिहराह केणेन केरता चोखाला जीवान ताकेत पोर बुरहो किहीक केरनु हे।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. चोखाला जीवान उतेरनो एने मोंडलीन वोड़ती। <char style="ior"><ref loc="ACT 1:1-8:1">1:1–8:1</ref></char></para>
  <para style="io1">2. मोंडली पोर सेताव एने यरूशलेम माय रेन हाजाली खुबेर पोसेरने। <char style="ior"><ref loc="ACT 8:2-12:23">8:2–12:23</ref></char></para>
  <para style="io1">3. पौलुस ने पेल्‍ली मिश्नरी यात्रा। <char style="ior"><ref loc="ACT 12:24-14:28">12:24–14:28</ref></char></para>
  <para style="io1">4. यरूशलेम ने गेरीब विश्वासीन जोरवुत ने बाराम। <char style="ior"><ref loc="ACT 15:1-35">15:1-35</ref></char></para>
  <para style="io1">5. पौलुस ने दुसरी मिश्नरी यात्रा। <char style="ior"><ref loc="ACT 15:36-18:22">15:36–18:22</ref></char></para>
  <para style="io1">6. पौलुस ने तिसरी मिश्नरी यात्रा। <char style="ior"><ref loc="ACT 18:23-20:38">18:23–20:38</ref></char></para>
  <para style="io1">7. पौलुसाह यरूशलेम माय बोंदी बाणावणो। <char style="ior"><ref loc="ACT 21-26">21–26</ref></char></para>
  <para style="io1">8. पौलुसाह रोम माय ली जाणो। <char style="ior"><ref loc="ACT 27-28">27–28</ref></char></para>
  <chapter number="1" style="c" sid="ACT 1" />
  <para style="s">ओलखात</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 1:1-4">लुका 1:1-4</ref>
      </char>
    </note>एय मोंगाल्ला थियुफिलुस: मी पेल्‍ली पुस्तेक त्यु सोब वातीन बाराम लिख्यो जो यीशु सुरवातीच रेन किरते एने हिकाड़ते रिनो, <verse eid="ACT 1:1" /><verse number="2" style="v" sid="ACT 1:2" />तो उपेर हेरगाम विसाय नाह गीयो, ताह वोर तान निवाड़ेल प्रेरिताह चोखाला जीवान द्‍वारे उकुम आपीन हिकाड़ते रिनो। <verse eid="ACT 1:2" /><verse number="3" style="v" sid="ACT 1:3" />तो मोरीन पासाण जुलूम पाका पुरावा हिऱ्यो सोताह जीवतालो देखाड्यो, एने चालीह दिह वोर तो ताह देखाती रिनो। एने बोगवानान राज ने वातु किरते रिनो। <verse eid="ACT 1:3" /><verse number="4" style="v" sid="ACT 1:4" /><note caller="+" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="LUK 24:49">लुका 24:49</ref></char></note><note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">जेवी ता एकठा टोलवाया केरता; नाहते जाह वोर तो ता हिऱ्यो रेतालो; नाहते तो ता हिऱ्यो खाणो खाया केरता रेतालो। </char></note>एने ता हिऱ्यो मिलीन ताह उकुम आप्यो, “यरूशलेम सोड़ीन जाहो मा: पुण मार आबाख ने ता वायदाह पुरो एणेन वाट जोवते रिवो, जान बाराम मी तुमूह कियेल ईतो। <verse eid="ACT 1:4" /><verse number="5" style="v" sid="ACT 1:5" /><note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="MAT 3:11">मत्ती 3:11</ref>; <ref loc="MRK 1:8">मरकुस 1:8</ref>; <ref loc="LUK 3:16">लुका 3:16</ref>; <ref loc="JHN 1:33">योहान 1:33</ref></char></note>काहाकाय योहान पाण्या केरीन बपतीस्मा आपेल, पुण थोड़ाक दिह्यान पासाण तुमू चोखाला जीवा केरीन बपतीस्मा सापड़ावहो।”<verse eid="ACT 1:5" /></para>
  <para style="s">यीशुन हेरगाम जाणो</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6" />ओवता ता एक जागे टोलवाय रियेल एता तेवी ता यीशुह फुशा, “एय मालीक, ज्याच कालाम इस्राएलान राज पोशो लाव दिहे काय?”<verse eid="ACT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 1:7" />यीशु ताह केयो, “ता टेमाह एने कालाह जाणने जाह आबोख ताच ने आदिकार माय मीलेल हे, तो तुमरो काम नाह सोतो। <verse eid="ACT 1:7" /><verse number="8" style="v" sid="ACT 1:8" /><note caller="+" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="MAT 28:19">मत्ती 28:19</ref>; <ref loc="MRK 16:15">मरकुस 16:15</ref>; <ref loc="LUK 24:47">लुका 24:47</ref>,<ref loc="LUK 24:48">48</ref></char></note>पुण जेवी चोखालो जीव तुमू पोर आवी तेवी तुमूह ताकेत जुड़ी, एने यरूशलेम एने आखा यहुदिया माय, एने सामरीया माय एने देरतीन कोपरे वोर तुमू मार गोवा रिहो।” <verse eid="ACT 1:8" /><verse number="9" style="v" sid="ACT 1:9" /><note caller="+" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="MRK 16:19">मरकुस 16:19</ref>; <ref loc="LUK 24:50">लुका 24:50</ref>,<ref loc="LUK 24:51">51</ref></char></note>ज्यो केयीन यीशु तान देखता देखता उपेर हेरगा माय विसाय गीयो, एने वादेल ताह तान डोलान सामने रेन लीकाड़ लेदो।<verse eid="ACT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 1:10" />जेवी ता यीशुह जुगाम जातालो तालताल देखणे बाजरियेल एता, तेवी दिखो, दुय माणहे दोवल्या फाड़का पिरील तान आहने आवीन उबरेय गीया। <verse eid="ACT 1:10" /><verse number="11" style="v" sid="ACT 1:11" />एने ताह केया, “एय गेलील वाला माणहे तुमू जुगान उगे देखतीन काहा उब रेनाह? ज्योच यीशु तुमू हिऱ्यो रेन उपेर हेरगा माय विसाय जायेल हे, जीह केरीन तुमू ताह हेरगाम जातालो देख्या तिहेच केरीन तो पोशो आवी।”<verse eid="ACT 1:11" /></para>
  <para style="s">यहुदान जागे मत्तीयान निवोड़</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12" />तेवी प्रेरित जेतुन नावान बोयड़ा पोर रेन उतेरना जो यरूशलेम ने आहने एक किलो मिटर सेटो एतो, ता यरूशलेम हेयरा माय पोशा आवा। <verse eid="ACT 1:12" /><verse number="13" style="v" sid="ACT 1:13" /><note caller="+" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="MAT 10:2-4">मत्ती 10:2-4</ref>; <ref loc="MRK 3:16-19">मरकुस 3:16-19</ref>; <ref loc="LUK 6:14-16">लुका 6:14-16</ref></char></note>एने ता आवा तेवी उपेरली खोलीम गीया, ताहरी पतरस, योहान, याकुब एने अन्द्रियास, फिलीपुस एने थोमा, बरतुल्मे एने मत्ती, हलफाईन बिटोख याकुब एने देस बक्त शमोन, एने याकुबान बिटोख यहुदा न्या रेताला। <verse eid="ACT 1:13" /><verse number="14" style="v" sid="ACT 1:14" />न्या ओलाक जाणे, एने ता हेऱ्यु मोकत्युच बायकु एने यीशुन आहख मरीयम एने यीशुन बायाख हेऱ्यो मिलीन एक मोन केरीन विन्ता केरताला।<verse eid="ACT 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15" />थोड़ाक दिह्यान पासाण विश्वासी माणहान मिटींग एती, ती टेम माय कोम से कोम एक होव विह माणहे एता, बायाख ने विची माय रेन पतरस उबरीन केणे बाज गीयो, <verse eid="ACT 1:15" /><verse number="16" style="v" sid="ACT 1:16" />“एय मारा बाय बोणहा, यीशुह बोंदी बाणावणार अगुवा यहुदान बाराम चोखाली पुस्तेक ने लेख माय दाऊदान मुया केरीन चोखालो जीव पेलुच रेन कियेल ईतो, ताह पुरो एणे जोरेवरी एतो।” <verse eid="ACT 1:16" /><verse number="17" style="v" sid="ACT 1:17" />काहाकाय यहुदा आपणी विचीम रेन एक ईतो, एने ज्या कामाह केरनेन केरता ताह निवाड़ेल एतो।<verse eid="ACT 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 1:18" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:18 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:3-8">मत्ती 27:3-8</ref>
      </char>
    </note>(ज्यो माणुह अन्याय ने कामा माय रेन एक खेत वेचातो लेदो, एने मुंडान बोरहे पोड़नो; एने तान पेट फुट गीयो एने तान आखा आतड्या बाहेर निकेल गीया। <verse eid="ACT 1:18" /><verse number="19" style="v" sid="ACT 1:19" />एने ज्यी वातीह यरूशलेम हेयरा मायवाला आखा माणहे जाण गीया, तानकेरता तान बाषा माय ता खेतान नाव हकलदमा मतलब लुयीन खेत पोड़ गीयो।)<verse eid="ACT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20" />बजन पुस्तेक माय इहकेरीन लिखेल हे:</para>
  <para style="q1" vid="ACT 1:20">तान गेर उजेड़ जाय;</para>
  <para style="q2" vid="ACT 1:20">एने ता माय कुणीच नाय रेय,</para>
  <para style="q1" vid="ACT 1:20">एने तान पोद एगदो दिहरो लेय लेय।<note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="fq" closed="false">तान गेर उजेड़ जाय; एने ता माय कुणीच नाय रेय, एने तान पोद एगदो दिहरो लेय लेय। </char><char style="ft" closed="false">बजन 69:25–109:8</char></note><verse eid="ACT 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 1:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:21 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 3:16">मत्ती 3:16</ref>; <ref loc="MRK 1:9">मरकुस 1:9</ref>; <ref loc="LUK 3:21">लुका 3:21</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="MRK 16:19">मरकुस 16:19</ref>; <ref loc="LUK 24:51">लुका 24:51</ref></char>
    </note>
    <note caller="+" style="f">
      <char style="fr" closed="false">1:21 </char>
      <char style="ft" closed="false">योहान तान बपतीस्मान खुबेर होमलाड्यो; नाहते योहान तान बपतीस्मा किऱ्यो।</char>
    </note>“केरीन ज्यो जोरवरी हे काय एक ओहला एदम्याह निवाड़ लेता, जो मालीक यीशुन कामान आखी टेम ने गोवाह हे। <verse eid="ACT 1:21" /><verse number="22" style="v" sid="ACT 1:22" />यीशु मसी योहान ने द्‍वारा बपतीस्मा आपाय जाणेन टेम माय रेन ते यीशुन उपेर विसाय जाता वोर जा माणहे बाराबोर आमरी हेऱ्या रेना। हाजो ज्यो हे काय ता माय रेन एक माणुह आपु हेऱ्यो यीशुन पोशो जीव उठणेन गोवा एय जाय।”<verse eid="ACT 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23" />तेवी ता दुय जाणाह उब राख्या ता माय रेन एक युसूफाह जो बरसबा केवातालो, तान दिहरो नाव यूसतुस एतो एने दिहरो मत्तीया। <verse eid="ACT 1:23" /><verse number="24" style="v" sid="ACT 1:24" />तेवी ता ज्यी विन्ता केऱ्या, “एय मालीक, तु जो आखान मोन जाणेह ज्यो देखाड़ काय न्या दुयाम रेन तु कुणीह निवाड़ेल हे <verse eid="ACT 1:24" /><verse number="25" style="v" sid="ACT 1:25" />काय तो ज्यी सेवकाय एने प्रेरितान पोद लेय, जाह यहुदा सोड़ीन तान जागे जात रियेल हे।” <verse eid="ACT 1:25" /><verse number="26" style="v" sid="ACT 1:26" />तेवी ता तान बाराम चिटठ्यु टाक्या एने चिट्ठी मत्तीयान नावे निकेलनी, एने तो ता ईग्यार प्रेरिता माय गेणाय गीयो।<verse eid="ACT 1:26" /></para>
  <chapter eid="ACT 1" />
  <chapter number="2" style="c" sid="ACT 2" />
  <para style="s">चोखाला जीवान उतेरनो</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1" />जेवी पेन्टीकोस्ट ने दिह मतलब फसह तिवाराह निवेरनेन पासाण पाचाहवो दिह आवो, ते आखा विश्वासी एकुच जागे टोलवाय रियेल एता। <verse eid="ACT 2:1" /><verse number="2" style="v" sid="ACT 2:2" />तेवी उचकाहुच मोटला वादोणान गेत आवाज होमलानो, एने ता माय आखो गेर जाहरी ता बोह रियेल एता तो जागो बोराय गीयो। <verse eid="ACT 2:2" /><verse number="3" style="v" sid="ACT 2:3" />एने ताह आक्‍ठीन गेत जीब्यु फाटताल्यु एने पोसेरताली देखान्यु, एने ता माय रेन आखा पोर उतेरनो। <verse eid="ACT 2:3" /><verse number="4" style="v" sid="ACT 2:4" />तेवी ता आखा चोखाला जीवा माय बोराय गीया, एने चोखालो जीव ताह बोलनेन ताकेत आप्यो, तिहे ता बात बातीन बाषा बोलने बाज गीया।<verse eid="ACT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5" />जुगान नेड़ा रेन आयेल आखा देसान माणहे बात बातीन बाषा बोलनारे यहुदि माणहे यरूशलेम माय रेताला। <verse eid="ACT 2:5" /><verse number="6" style="v" sid="ACT 2:6" />जुलबुखे ज्यो आवाज होमलानो, तेवी माणहान बिड़ टोलवाय गियी। एने माणहे बोंगलाय गीया, काहाकाय आखाह ज्योच होमलातालो काय ज्या आमरीस बाषा माय बोलने बाजरेनाह। <verse eid="ACT 2:6" /><verse number="7" style="v" sid="ACT 2:7" />ते ता आखा बोंगलायीन केणे बाज गीया, “हुमलो, ज्या आखा बोलनारे गेलील वाला ना सोता काय? <verse eid="ACT 2:7" /><verse number="8" style="v" sid="ACT 2:8" />तेवी ज्यी कोहली वात हे काय आपणे माय रेन आखा आप आपणी बाषा बोलताला होमेलतेह? <verse eid="ACT 2:8" /><verse number="9" style="v" sid="ACT 2:9" />आमु जा पारथी, मेदि, एलामी; एने मेसोपोटामीया, एने यहुदिया एने कप्‍पदुकिया; एने पुन्तुस एने आसीया, <verse eid="ACT 2:9" /><verse number="10" style="v" sid="ACT 2:10" />एने फ्रुगीया पंफुलीया, एने मीस्र एने लीबिया देस जो कुरेन गावान आहने पाहने हे, ज्या आखा देसान रेणारे एने रोमी पोरवासी, <verse eid="ACT 2:10" /><verse number="11" style="v" sid="ACT 2:11" />यहुदि एने बिगेर यहुदि दुयू यहुदि देरमा माय परिवर्तन एय गीया, एने आमु माय रेन थोड़ाक माणहे क्रेते एने अरब माय रेणारे हेते, तीबी आमु ताह फाय रेन आप आपणी बाषा माय ता ताकेत ने काम ने बाराम बोलताला होमेलतेह, जो बोगवान बाणायील हे!” <verse eid="ACT 2:11" /><verse number="12" style="v" sid="ACT 2:12" />एने ता आखा बोंगलाय गीया एने गाबराएन एका दिहराह केणे बाज गीया, “ज्यो काय एणे बाजरिनोह?”<verse eid="ACT 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 2:13" />पुण थोड़ाक माणहे चिहटा केरीन केया, “ज्या माणहे पिन साकवाला एय रेनाह!”<verse eid="ACT 2:13" /></para>
  <para style="s">पतरसान बासेण</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14" />पुण पतरस ता ईग्यार जाणा हिऱ्यो उबरीन मोठेच हिकाड़ने बाज गीयो, “एय यहुदि एने यरूशलेम माय रेणारे आखा माणहे तुमू ज्यो जाण लिवो, एने मारी वातु हास केरीन कान लागाड़ीन हुमलो। <verse eid="ACT 2:14" /><verse number="15" style="v" sid="ACT 2:15" />जो तुमू सोमेजतेह, ज्या माणहे नेशा माय ना सोता; काहाकाय एवी ते वेगाच ने नोव वाज रेनाह। <verse eid="ACT 2:15" /><verse number="16" style="v" sid="ACT 2:16" />पुण बोगवानान जाणकार योएल जी वात कियेल ईतो, ती ज्यी हे:<verse eid="ACT 2:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="ACT 2:17" />बोगवान किथे, ‘सेवेटल्या दिह्या माय ओहलो एय काय मी मार चोखाला जीवाह उतारूह।</para>
  <para style="m" vid="ACT 2:17">तेवी तुमरा सोरा एने सोर्‍यु बोगवानान उगे रेन जाणाव केती;</para>
  <para style="q2" vid="ACT 2:17">एने तुमरा जुवान्या देरसेन देखती,</para>
  <para style="q2" vid="ACT 2:17">एने तुमरा डावाला माणहे होपनो देखती।<verse eid="ACT 2:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="ACT 2:18" />एने मी मार पावोर एने पावेरन्यु पोर चोखाला जीवाह उतारूह, एने ता जाणाव केरती।<verse eid="ACT 2:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="ACT 2:19" />एने मी जुगाम मोटला कामे एने निड़ो देरती पोर निसाणी,</para>
  <para style="m" vid="ACT 2:19">मतलब लुय एने आक्‍ठो एने दुवाड़ान वादेल देखाडुह;<verse eid="ACT 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ACT 2:20" />बोगवानान मोटला</para>
  <para style="q2" vid="ACT 2:20">एने उजालान दिह आवणेन पेल दिह आंदारलो,</para>
  <para style="q1" vid="ACT 2:20">एने चांद लुयीन गेत रातलो एय जाय। <verse eid="ACT 2:20" /><verse number="21" style="v" sid="ACT 2:21" />एने जो कुण मालीकान नाव लेन विन्ता केरी, ताच ने सुटकारो एय।’”<verse eid="ACT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22" />एय इस्राएली माणहे, “ज्‍यु वातु हुमलो, यीशु नासरी जो बोगवानान उगे रेन जा मोटला कामे एने निसाणी तुमूह देखाड्यो। ता पोर रेन बोगवान तुमरी केरता मोकलेल ओहलो माणुह एतो, ज्यो तुमूह मालुम हे। <verse eid="ACT 2:22" /><verse number="23" style="v" sid="ACT 2:23" /><note caller="+" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="MAT 27:35">मत्ती 27:35</ref>; <ref loc="MRK 15:24">मरकुस 15:24</ref>; <ref loc="LUK 23:33">लुका 23:33</ref>; <ref loc="JHN 19:18">योहान 19:18</ref></char></note>तास यीशुह, जी बोगवानान ठेरायेल योजना एने पेल्‍ली बुद्दीन गेत देराय गीयो, तुमू पापीन आथाम देरावीन खुरूसखाम पोर चेड़ावीन मार टाक्या। <verse eid="ACT 2:23" /><verse number="24" style="v" sid="ACT 2:24" /><note caller="+" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="MAT 28:5">मत्ती 28:5</ref>,<ref loc="MAT 28:6">6</ref>; <ref loc="MRK 16:6">मरकुस 16:6</ref>; <ref loc="LUK 24:5">लुका 24:5</ref></char></note>पुण ताह बोगवान मोतीन बोंदेन माय रेन सोड़वीन जीवाड्यो, काहाकाय ज्यो एय बी नाय ओहलो एतो, काय तो तान ताबाम रेतो। <verse eid="ACT 2:24" /><verse number="25" style="v" sid="ACT 2:25" /><note caller="+" style="f"><char style="fr" closed="false">2:25 </char><char style="ft" closed="false">बजन 16:8-11</char></note>काहाकाय दाऊद तान बाराम किथे,</para>
  <para style="q1" vid="ACT 2:25">“मी मालीकाह जेलेम मार सामने देखते रिनो;</para>
  <para style="q2" vid="ACT 2:25">काहाकाय तो मार जीवड़े उगे हे, काय मी पोड़ नाय जाव।<verse eid="ACT 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 2:26" />तानकेरता मारो मोन खुस हे,</para>
  <para style="q2" vid="ACT 2:26">एने मारी जिब मगन एय गियी;</para>
  <para style="q1" vid="ACT 2:26">एने मारा सेरीराह बी आसा माय आराम जुड़ी।<verse eid="ACT 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 2:27" />काहाकाय तु मार जीवाह आंदारकेली माय नाय सोड़हे,</para>
  <para style="q2" vid="ACT 2:27">एने तारा चोखाला जाणाह माहणा माय जिर ने नाय दिहे।<verse eid="ACT 2:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ACT 2:28" />तु माहु जीवणान वाट देखाड्यो,</para>
  <para style="q2" vid="ACT 2:28">तु माहु तारा देरसेनान खुसी माय बोर दिहे।”<verse eid="ACT 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29" />एय बाहख, मी आमरो डायलो दाऊद ने बाराम मी तुमरी हिऱ्यो दिर माय केथु काय तो ते मोर गीयो, एने बुजाय बी गीयो। एने तान माहेण आज वोर आमरे विचीम हे। <verse eid="ACT 2:29" /><verse number="30" style="v" sid="ACT 2:30" />तो जाणाव केरनार<note caller="+" style="f"><char style="fr" closed="false">2:30 </char><char style="fq" closed="false">जाणाव केरनार </char><char style="ft" closed="false">बोगवाना फाय रेन खुबेर लावणार</char></note> ईतो, तो जाणतालो काय बोगवान माहु फाय रेन सुगोण खाईल हे, मी तारा वोस माय रेन एक जाणाह तारी राजगादि पोर बोहाडुह। <verse eid="ACT 2:30" /><verse number="31" style="v" sid="ACT 2:31" />दाऊद ज्यी एणी एती, ती वातीह पेलुच रेन देखीन मसीन जीव उठणेन बाराम जाणाव किऱ्यो,</para>
  <para style="q1" vid="ACT 2:31">“नाह ते तान जीव आंदारकेली माय सोड़ाय गीयो,</para>
  <para style="q2" vid="ACT 2:31">एने नाह तान सेरीर जीरनो।”<verse eid="ACT 2:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 2:32" />ज्यास यीशुह बोगवान मुरेल माय रेन जीवाड्यो, एने तान गोवा आमु सोब हेते। <verse eid="ACT 2:32" /><verse number="33" style="v" sid="ACT 2:33" />तानकेरीन बोगवान ताह तान जीवड्या आथान उगे बोहाड़ेल हे, ताह चोखाला जीवान बाराम वायदो आबाख फाय रेन जुड़ेल हे, एने तुमू ज्यो देखतेह एने होमेलतेह ताहाच तो रोचवेल हे। <verse eid="ACT 2:33" /><verse number="34" style="v" sid="ACT 2:34" />काहाकाय दाऊद ते हेरगा माय नाह चेड्यो; पुण तो खुद किथे,</para>
  <para style="q1" vid="ACT 2:34">“मालीक मार मालीकाह केयो,</para>
  <para style="q2" vid="ACT 2:34">‘मार जीवड़े उगे बोह।<verse eid="ACT 2:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ACT 2:35" />मी तारा दुसमोनाह तारा पायान बुंदे आथरोण नाय केर देव,</para>
  <para style="q2" vid="ACT 2:35">ताह वोर मार जीवड़े उगे बोह।’”<verse eid="ACT 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36" />केरीन एवी इस्राएल ने आखो गेराणो हास केरीन जाण लेय, काय बोगवान तास यीशुह जाह तुमू खुरूसखाम पोर खीला ठोकीन मार्‍या, ताह बोगवान मालीक एने मसी बी ठेरायो!<verse eid="ACT 2:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37" />तेवी होमेलनारान मोन टुट गीयो, एने ता पतरसाह एने दिहरा प्रेरिताह फुशा, “एय बाहख, आमु काय किरज्‍यो?”<verse eid="ACT 2:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 2:38" />पतरस ताह केयो, “पासतावो किरो, एने तुमरे माय रेन एक एक जाण आप आपणा पापान माफीन केरता यीशु मसीन नावाम बपतीस्मा लिवो; तेवी तुमूह चोखाला जीवान दान जुड़ी। <verse eid="ACT 2:38" /><verse number="39" style="v" sid="ACT 2:39" />काहाकाय ज्यो वचन तुमूह एने तुमरा सोराह, एने ता आखा सेट सेटाला माणहान केरता बी हे, जाह मालीक आपणो बोगवान ता फाय हादि।”<verse eid="ACT 2:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40" />उंजु पतरस दिहऱ्यु जुलूम वातुन गोवाय केय किन सोमजाड़ीन विन्ता किऱ्यो, “सोताह ज्यी वाकेड़ली जाती हेऱ्या रेन वोचाड़ो!” <verse eid="ACT 2:40" /><verse number="41" style="v" sid="ACT 2:41" />एने जा तान वचन होमल्या ता बपतीस्मा लेदा; एने ते दिह तीन एजार माणहे ता हेऱ्या मिलाय गीया। <verse eid="ACT 2:41" /><verse number="42" style="v" sid="ACT 2:42" />एने ता प्रेरिता फाय रेन हिकवोण लेणे, एने सेंगेती केरने, एने खाणो खाणे, एने विन्ता केरने माय लागीस रेना।<verse eid="ACT 2:42" /></para>
  <para style="s">विश्वासीन जीवाय</para>
  <para style="p">
    <verse number="43" style="v" sid="ACT 2:43" />तेवी आखा माणहा माय बिय आवी, काहाकाय प्रेरितान आथा केरीन जुलूम होवटा चोमेत्कारान कामे एने निसाण्यु एताल्यु। <verse eid="ACT 2:43" /><verse number="44" style="v" sid="ACT 2:44" /><note caller="+" style="x"><char style="xo" closed="false">2:44 </char><char style="xt" closed="false"><ref loc="ACT 4:32-35">प्रेरितान काम 4:32-35</ref></char></note>एने आखा बुरहो केरनारे एकठा रेताला, एने तान आखी चिज पोर एक हारको आदिकार ईतो। <verse eid="ACT 2:44" /><verse number="45" style="v" sid="ACT 2:45" />ता तान तान मालदेन एने सोमान वेच वेचीन जाह जान गिरेज रेताली वाट देया केरताला। <verse eid="ACT 2:45" /><verse number="46" style="v" sid="ACT 2:46" />ता दाड़ीन एक मोन एन मोंदिर माय टोलवाताला, एने गेरा गेरा रूटो खाताला, एने खुसी माय एने हाजा मोना केरीन खाणो खाया केरताला, <verse eid="ACT 2:46" /><verse number="47" style="v" sid="ACT 2:47" />एने बोगवानान बोड़ाय केरताला, एने आखा माणहे ता पोर जुलूम खुस एता एने जा सुटकारो सापड़ावताला, ताह मालीक दाड़ीन ता माय मीलाव देतालो।<verse eid="ACT 2:47" /></para>
  <chapter eid="ACT 2" />
  <chapter number="3" style="c" sid="ACT 3" />
  <para style="s">लेंगड़ा बिखारीन हुदारनो</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1" />एक दिह पतरस एने योहान हिराणेन तीन वाजता विन्ता केरनेन टेम माय उपेर मोंदिराम जाणे बाजरियेल एता। <verse eid="ACT 3:1" /><verse number="2" style="v" sid="ACT 3:2" />तेवी पायदासीर एक लेंगड़ो माणुह सुंदर नावान बायणा हेऱ्यो बोह रियेल एतो। एने ताह ता दाड़ीन मोंदिरान बायणा पोर बोहाड़ देताला काय तो मोंदिर माय जाणारा फाय बिख मांगे <verse eid="ACT 3:2" /><verse number="3" style="v" sid="ACT 3:3" />जेवी तो पतरस एने योहानाह मोंदिराम जाताला दिख्यो, तेवी ता फाय बिख मांग्‍यो। <verse eid="ACT 3:3" /><verse number="4" style="v" sid="ACT 3:4" />तेवी पतरस एने योहान ताह हास केरीन देख्या, एने पतरस केयो, “आमरी उगे देख!” <verse eid="ACT 3:4" /><verse number="5" style="v" sid="ACT 3:5" />तेवी तो ता फाय काय तीबी जुड़ी केरीन आसा केरीन तान उगे देखणे बाज गीयो।<verse eid="ACT 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 3:6" />पुण पतरस ताह केयो, “होनो चांदी ते मार फाय नाह सोतो, पुण जो मार फाय हे तो तुवाह आपथु: यीशु मसी नासरीन नावाम चाल फिर!” <verse eid="ACT 3:6" /><verse number="7" style="v" sid="ACT 3:7" />एने पतरस तान जीवड्यो आथ देरीन उठाड्यो। एने चालोच तान पाय एने मांडा माय ताकेत आव गियी; <verse eid="ACT 3:7" /><verse number="8" style="v" sid="ACT 3:8" />तेवी तो उसलीन उबरेय गीयो, एने चालने फिरने बाज गीयो, एने चालते कुदतेन बोगवानान बोड़ाय केरतीन ता हिऱ्यो मोंदिराम गीयो। <verse eid="ACT 3:8" /><verse number="9" style="v" sid="ACT 3:9" />आखा माणहे ताह चालतालो फिरतालो एने बोगवानान बोड़ाय केरतालो देखीन, <verse eid="ACT 3:9" /><verse number="10" style="v" sid="ACT 3:10" />ताह ओलखी लेदा काय ज्यो ते तोस हे जो मोंदिर ने सुंदर नावान फाटेक पोर बोहीन बिख मांग्‍या केरतालो, जी गेटना ता हेरी ईयेल एती ता जुलूम बोंगलायीन एने ताह जुदोच लागो।<verse eid="ACT 3:10" /></para>
  <para style="s">मोंदिर माय पतरसान हिकवोण</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11" />जेवी तो पतरस एने योहानाह देर रियेल ईतो, तेवी आखा माणहे बोंगलातेन ता सुलेमानान खोली केवातालो, ता दोवड़ीन आवा। <verse eid="ACT 3:11" /><verse number="12" style="v" sid="ACT 3:12" />ज्यो देखीन पतरस माणहाह केयो, “एय इस्राएली माणहे, तुमू ज्या माणहाह देखीन काहा बोंगलातेह? एने आमरी उगे इही केरीन काहा देखतेह? जीहे काय आमुच आमरी ताकेत केरीन एने बोक्ती केरीन ज्याह चालने फिरनेन बाराबोर बाणाव देना। <verse eid="ACT 3:12" /><verse number="13" style="v" sid="ACT 3:13" />अब्राहाम, इसहाक, एने याकुबान एने आपणा बाप दादान बोगवान तान चाकऱ्या यीशुन बोड़ाय केऱ्या। जाह तुमू देराव देना, एने पिलातुस ताह सोड़ देणेन विचार केरतालो, तेवी तुमू तान सामने तान नाकार केऱ्या। <verse eid="ACT 3:13" /><verse number="14" style="v" sid="ACT 3:14" /><note caller="+" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="MAT 27:15-23">मत्ती 27:15-23</ref>; <ref loc="MRK 15:6-14">मरकुस 15:6-14</ref>; <ref loc="LUK 23:13-23">लुका 23:13-23</ref>; <ref loc="JHN 19:12-15">योहान 19:12-15</ref></char></note>तुमू ता चोखाला एने देरमीह नाकार केऱ्या, एने विन्ता केऱ्या काय एक खुनीह तुमरी केरता सोड़ाय जाय। <verse eid="ACT 3:14" /><verse number="15" style="v" sid="ACT 3:15" />एने तुमू जीवाय आपणारा अगुवाह मार टाक्या, पुण ताह बोगवान मुरेल माय रेन जीव उठाड्यो एने ज्यी वातीन आमु गोवा हेते। <verse eid="ACT 3:15" /><verse number="16" style="v" sid="ACT 3:16" />एने तास ने नाव, ता बुरहो केरीन जो तान नावा माय हे; ज्या माणहाह तुमू देखतेह एने जाणतेह बी, ताह यीशुन नावाम ज्यी ताकेत आपेल हे।<verse eid="ACT 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17" />“एवी एय बाय बोणहा, मी जाणथो काय ज्यो काम तुमू बिगेर जाणीन केऱ्या, एने तिहेच केरीन तुमरा आदिकारी बी किरेल हेते। <verse eid="ACT 3:17" /><verse number="18" style="v" sid="ACT 3:18" />पुण ज्‍यु वातुह बोगवान आखा बोगवानान उगे रेन बोलनारान मुया केरीन पेलुच केय दियेल ईतो, काय तान मसी दुख वेठी, एने ताह तो इहकेरीन पुरो किऱ्यो। <verse eid="ACT 3:18" /><verse number="19" style="v" sid="ACT 3:19" />तानकेरता मोन बुदलो एने पाप केरनेन सोड़ो, काय तुमरा पाप मिट जाती, <verse eid="ACT 3:19" /><verse number="20" style="v" sid="ACT 3:20" />काहाकाय आत्मिक सान्तीन टेम मालीक फाय रेन आवी, एने तो यीशुह मोकली, जो तुमरी केरता पेलुच रेन मसी ठेराय जायेल हे। <verse eid="ACT 3:20" /><verse number="21" style="v" sid="ACT 3:21" />जोरेवरी हे काय हेरगा माय ती टेम वोर रेय, जाह वोर तो आखी वातुह पेल ने गेत नाय केर लेय, जान चेरचा जुनाला कालाम रेन बोगवान तान चोखाला जाणकारान मुया केरीन कियेल हे। <verse eid="ACT 3:21" /><verse number="22" style="v" sid="ACT 3:22" /><note caller="+" style="f"><char style="fr" closed="false">3:22 </char><char style="ft" closed="false">तो माहु जिहकेरीन मुकलेल हे; नाहते मार गेत।</char></note>जिहकेरीन मुसो कियेल हे, ‘मालीक बोगवान तुमरा बायाख माय रेन तुमरी केरता मार गेत एक जाणाव केरन्याह उबो केरी। जो काय तो तुमूह केय, तान तुमू होमेलज्यो। <verse eid="ACT 3:22" /><verse number="23" style="v" sid="ACT 3:23" />जो बी जाणाव केरनारान नाय होमली, तो बोगवानान माणहाम रेन खेतेम केराय जाय।’ <verse eid="ACT 3:23" /><verse number="24" style="v" sid="ACT 3:24" />पोशो शमुएल वोर रेन ते तान पासाण वोर जोला जाणाव केरनार बुलील एता, ता आखा ज्या दिह्यान बाराम खुबेर देना। <verse eid="ACT 3:24" /><verse number="25" style="v" sid="ACT 3:25" />तुमू जाणकारान सोरा एने ता वायदान बागी हेते, जो बोगवान तुमरा बाप दादा हिऱ्यो बांदिल ईतो, अब्राहामाह केयो, ‘तारा वोसी केरीन देरतीन आखा गेराणान माणहाह बोरकेत जुड़ी।’ <verse eid="ACT 3:25" /><verse number="26" style="v" sid="ACT 3:26" />बोगवान तान चाकऱ्याह मुरेल माय रेन जिवाड़ेन पेल तुमू फाय मोकलेल हे, काय एकेक आखाह खाराबी माय रेन फिरावीन बोरकेत आपी।”<verse eid="ACT 3:26" /></para>
  <chapter eid="ACT 3" />
  <chapter number="4" style="c" sid="ACT 4" />
  <para style="s">मोटला पोंचान सामने पतरस एने योहान</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1" />
    <note caller="+" style="f">
      <char style="fr" closed="false">4:1 </char>
      <char style="ft" closed="false">चाकर्‍यो; थोड़ाक लेख माय मुखी चाकर्‍यो लिखेल हे।</char>
    </note>जेवी पतरस एने योहान माणहाह इहकेरीन केताला, तेवी चाकऱ्या एने मोंदिर ने सिपायान आदिकारी, एने सदुकी ता पोर खीजवाय गीया। <verse eid="ACT 4:1" /><verse number="2" style="v" sid="ACT 4:2" />ता ज्यानकेरता खीजवाय रियेल एता, काहाकाय पतरस एने योहान यीशुन मुरेलान जीव उठणेन पारचार केरताला, एने माणहाह हिकाड़ताला। <verse eid="ACT 4:2" /><verse number="3" style="v" sid="ACT 4:3" />ता पतरस एने योहानाह दिहरे दिह वोर चोवकी माय मेल्या, काहाकाय हांज एय जायेल एती। <verse eid="ACT 4:3" /><verse number="4" style="v" sid="ACT 4:4" />पुण वचन होमेलनाराम रेन जुलूम होवटा बुरहो केऱ्या, एने ओहला एदम्यान गेणती पाच एजार कोम से कोम एय गियी।<verse eid="ACT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5" />दिहरे दिह यहुदिन राजा, डायला एने देरेमगुरू यरूशलेम माय टोलवाना। <verse eid="ACT 4:5" /><verse number="6" style="v" sid="ACT 4:6" />एने मुखी चाकर्‍यो हन्ना एने केफा एने योहान एने आलेकजांडर एने जोला मुखी चाकर्‍यान गेराणान एता, आखा यरूशलेम हेयरा माय टोलवाना। <verse eid="ACT 4:6" /><verse number="7" style="v" sid="ACT 4:7" />ता पतरस एने योहानाह विची माय उबराखीन फुसणे बाज गीया, “तुमू ज्यो काम काल्ली ताकेत केरीन एने काल्ला नावा केरीन किरेल हेते?”<verse eid="ACT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 4:8" />तेवी पतरस चोखाला जीवा माय बोरायीन ताह केयो, एय माणहान आदिकारी एने डायडाया: <verse eid="ACT 4:8" /><verse number="9" style="v" sid="ACT 4:9" />ज्या लेंगड़ा माणहा हेऱ्यो जो बोलो ईयेल हे, केदी आज आमु फाय रेन तान बाराम चोकसी केराय जाथे काय तो किहीक हाजो ईनो, <verse eid="ACT 4:9" /><verse number="10" style="v" sid="ACT 4:10" />ते तुमू आखा एने आखा इस्राएली माणहाह, ज्यो मालुम पोड़ी काय जा मसी यीशुह तुमू खुरूसखाम पोर खीला ठोकीन मारील, जाह बोगवान मुरेल माय रेन जीवाड्यो, ता यीशु नासरीन नावा माय ज्यी ताकेत हे, ता नावा माय ज्यो माणुह हुदरीन तुमरी ओंगाण उबरियेल हे। <verse eid="ACT 4:10" /><verse number="11" style="v" sid="ACT 4:11" />पुस्तेक माय लिखेल हे,</para>
  <para style="q1" vid="ACT 4:11">“ज्यो यीशु तोच दिगोड़ हे जाह तुमू मिस्तऱ्या नेचो सोमज्या,</para>
  <para style="q2" vid="ACT 4:11">एने तोच कोपरान मुखी दिगोड़ बोण गीयो।”<verse eid="ACT 4:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ACT 4:12" />काल्ला दिहरान द्‍वारा सुटकारो नाह; काहाकाय हेरगान नेचो माणहा माय उंजु काल्लो दिहरो नाव नाह आपेल सोतो, जान द्‍वारा आपणो सुटकारो एय सेकी।<verse eid="ACT 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13" />जेवी ता पतरस एने योहानान बुरहो देख्या, एने ज्यो जाण्या काय ज्या अनपोड़ एने सादा माणहे हेते, ते बोंगलाय गीया। ओवता ताह ओलख्या काय ज्या यीशु हेऱ्या रियेल हेते। <verse eid="ACT 4:13" /><verse number="14" style="v" sid="ACT 4:14" />ता माणहाह जो ठिख ईयेल ईतो, पतरस एने योहाना हिऱ्यो उबरियेल देखीन तान विरोद माय कायच नाह केय सेक्‍या। <verse eid="ACT 4:14" /><verse number="15" style="v" sid="ACT 4:15" />पुण ताह पोंचान बाहेर जाणेन उकुम आपीन ता आपसाम विचार केरने बाज गीया, <verse eid="ACT 4:15" /><verse number="16" style="v" sid="ACT 4:16" />“ज्या माणहा हेऱ्या आपु काय किरज्‍यो? काहाकाय ता फाय रेन खेरीच नाव गाज्यो चोमेत्कार ईयेल हे, ज्यो आखा यरूशलेम वालाह मालुम पोड़ जायेल हे, तेवी तो आपुह नाकारता आवीत नाह। <verse eid="ACT 4:16" /><verse number="17" style="v" sid="ACT 4:17" />पुण ज्यानकेरता काय ज्यी वात माणहा माय उंजु पोसेरने नाय जुवे, केरीन आपु ताह दोपकावता काय यीशुन नावा केरीन उंजु काल्ला माणहा हेऱ्या वातु नाय केरी।”<verse eid="ACT 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 4:18" />तेवी ता पतरस एने योहानाह हाद्या, एने उकुम आपीन ज्यो केया, “यीशुन नावा माय काय बी मा बुलहो एने मा हिकाड़हो।” <verse eid="ACT 4:18" /><verse number="19" style="v" sid="ACT 4:19" />पुण पतरस एने योहान ताह जापाप आप्या, “तुमूच नियाव किरो; ज्यो बोगवानान नेजरी माय हाजो हे काय आमु बोगवानान वातीह रेन वोदार तुमरी वातु माने। <verse eid="ACT 4:19" /><verse number="20" style="v" sid="ACT 4:20" />काहाकाय ज्यो ते आमुह एय नाह सिकेत काय जो आमु देख्या एने होमलेल हेते, तो नाय किज्यो।” <verse eid="ACT 4:20" /><verse number="21" style="v" sid="ACT 4:21" />तेवी ता ताह उंजु दोपकावीन सोड़ देना, काहाकाय ताह किहीक डेंड आपी सोमजातालो नाह, ज्यानकेरता काय जी गेटना ईयेल एती तान वोजेसे आखा माणहे बोगवानान बोड़ाय केरताला। <verse eid="ACT 4:21" /><verse number="22" style="v" sid="ACT 4:22" />हुदेरनेन जो चोमेत्कार जा लेंगड़ा माणहा पोर ईयेल एतो, तो माणुह चालीह वोरह्या रेन वोदार वोयान ईतो।<verse eid="ACT 4:22" /></para>
  <para style="s">विश्वासीन ईमोतीन केरता विन्ता</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23" />पतरस एने योहान सुटीन तान हाती फाय आवा, एने जो काय मुखी चाकऱ्या एने डायडाया ताह कियेल एता, ताह होमलाव देना। <verse eid="ACT 4:23" /><verse number="24" style="v" sid="ACT 4:24" />ज्यो होमलीन विश्वासी एक मोन एन मोठेस आयड़ीन बोगवानाह केया, “एय मालीक, तु तोच हे जो हेरोग एने देरती एने देरीयो एने जो काय ता माय हे बाणायो।” <verse eid="ACT 4:24" /><verse number="25" style="v" sid="ACT 4:25" />तु चोखाला जीवा माय तारो पावोर आमरो डायलो दाऊदान मुया केरीन केयो,</para>
  <para style="q1" vid="ACT 4:25">“बिगेर यहुदि गेगदो काहा केऱ्या;</para>
  <para style="q2" vid="ACT 4:25">एने देसा देसान माणहे काहा बिगेर कामान वातु सोचा?<verse eid="ACT 4:25" /></para>
  <para style="q2">
    <verse number="26" style="v" sid="ACT 4:26" />मालीक एने तान मसीन विरोद माय देरतीन राजा उबरी गीया,</para>
  <para style="q2" vid="ACT 4:26">एने आदिकारी एकठास टोलवाय गीया।”<verse eid="ACT 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 4:27" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:27 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 23:7-11">लुका 23:7-11</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:1">मत्ती 27:1</ref>,<ref loc="MAT 27:2">2</ref>; <ref loc="MRK 15:1">मरकुस 15:1</ref>; <ref loc="LUK 23:1">लुका 23:1</ref>; <ref loc="JHN 18:28">योहान 18:28</ref>,<ref loc="JHN 18:29">29</ref></char>
    </note>काहाकाय खेरीच तार चोखालो पावोर यीशुन विरोद माय जान तु निवाड़ किऱ्यो, हेरोदेस एने पुन्तियुस पिलातुस बी बिगेर यहुदि एने इस्राएली हेऱ्या ज्या गावा माय एकठा एना। <verse eid="ACT 4:27" /><verse number="28" style="v" sid="ACT 4:28" />ता एकठा एना काहाकाय तारी ताकेत एने मोरजीन गेत जो काय पेलुच रेन ठेरायेल एतो, तो पुरो एय। <verse eid="ACT 4:28" /><verse number="29" style="v" sid="ACT 4:29" />एवी एय मालीक, तान दोमक्‍युह देख; एने तारा पावराह ज्यी पारवांगी आप काय तारो वचन मोजबुत ईमोत माय होमलावे। <verse eid="ACT 4:29" /><verse number="30" style="v" sid="ACT 4:30" />हुदारनेन केरता तु तारो आथ ओंगाण केर काय चोमेत्कार एने निसाणी तारो चोखालो पावोर यीशु मसीन नावाम केराय जाय।<verse eid="ACT 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 4:31" />जेवी ता विन्ता केर लेदा, ते तो जागो जाहरी ता एकठा एता आल गीयो, एने ता आखा चोखाला जीवाम बोराय गीया, एने बोगवानान वचन ईमोत केरीन होमलावते रेना।<verse eid="ACT 4:31" /></para>
  <para style="s">विश्वासीन सामुहिक जीवाय</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:32 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 2:44">प्रेरितान काम 2:44</ref>,<ref loc="ACT 2:45">45</ref></char>
    </note>बुरहो केरनारान मोंडेली एक मोन एने एक जीव ईतो। ता माय रेन कुण बी तान मालदेनाह मारो नाह केताला, पुण तान आखो काय गोवांद्यो एतो। <verse eid="ACT 4:32" /><verse number="33" style="v" sid="ACT 4:33" />एने प्रेरित मोटली ताकेत माय मालीक यीशुन जीव उठणेन गोवाय देताला, एने ता आखा पोर मोटली गीण एती। <verse eid="ACT 4:33" /><verse number="34" style="v" sid="ACT 4:34" />ता माय रेन कुण बी गेरीब नाह एतो; काहाकाय जा फाय जागो नाहते गेरे एता, ता ताह वेच देताला। <verse eid="ACT 4:34" /><verse number="35" style="v" sid="ACT 4:35" />एने वेचायेल चिजीन किमोत लावीन प्रेरितान पायान थुड़ाम मेल देताला; जिहकेरीन जान गिरेज रेताली, तान पारमाणे आखाह वाट देया केरताला।<verse eid="ACT 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36" />युसूफ नावान साइप्रसान एक लेवी ईतो जान नाव प्रेरित न्या बरनबास मतलब उत्साह आपणार मीलेल एता। <verse eid="ACT 4:36" /><verse number="37" style="v" sid="ACT 4:37" />ता फाय तान थोड़ोक जागो ईतो, ताह तो वेचो एने तान पोयशा लावीन प्रेरितान पायान थुड़ाम मेल दिनो।<verse eid="ACT 4:37" /></para>
  <chapter eid="ACT 4" />
  <chapter number="5" style="c" sid="ACT 5" />
  <para style="s">हनन्या एने सपीरा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1" />हनन्या नावान एक माणुह ईतो, एने तो तान बायकु सपीरा हेऱ्यो तान थोड़ोक जागो वेचा। <verse eid="ACT 5:1" /><verse number="2" style="v" sid="ACT 5:2" />एने तान किमोत माय रेन थोड़ोक तान केरता मेल लेदा, एने ज्यी वात तान बायकु बी जाणताली, एने वोचेल एक वाटो लावीन प्रेरितान ओंगाण मेल देना। <verse eid="ACT 5:2" /><verse number="3" style="v" sid="ACT 5:3" />तेवी पतरस ताह केयो, “एय हनन्या, तु बुतड़ाह तारा मोना माय ज्यी वात किहीक टाकणे दिनो? काय तु चोखाला जीवाह जुठ बोली एने जागान किमोत माय रेन थोड़ोक वोचाड़ीन मेल लेय। <verse eid="ACT 5:3" /><verse number="4" style="v" sid="ACT 5:4" />जाह वोर जागो नाह वेचानो तेवी तारो जागो नाह ईतो; जुलबुखे वेचाय गीयो ते तारा आदिकार माय किमोत नाह एतो। तु तारा मोना माय इहकेरीन केरने काहा विचार किऱ्यो? तु माणहाह नाह, पुण बोगवानाह जुठ बुलील हे!” <verse eid="ACT 5:4" /><verse number="5" style="v" sid="ACT 5:5" />ज्यी वातु होमेलताच हनन्या बुई पोर पोड़ीन जीव सोड़ दिनो, एने आखा होमेलनाराम जुलूम बिय आव लागी। <verse eid="ACT 5:5" /><verse number="6" style="v" sid="ACT 5:6" />तेवी जुवान्या उठीन तान देड़ाह फाड़का माय गुंडालीन बाहेर ली जाईन ताह बुज देना।<verse eid="ACT 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7" />कोमीत कोमी तीन गेंटान पासाण तान बायकु ती गेटनान बाराम नाह जाणताली, ती माय आवी। <verse eid="ACT 5:7" /><verse number="8" style="v" sid="ACT 5:8" />तेवी पतरस तीह केयो, “माहु के काय तुमू तो जागो ओलाच माय विचेल एता?”</para>
  <para style="q1" vid="ACT 5:8">ती केयी, “होव ओलाच माय।”<verse eid="ACT 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 5:9" />तेवी पतरस तीह केयो, “ज्यी काय वात हे काय तुमू दुयू मिलीन मालीकान जीवान पारेख ने केरता एकी केऱ्या? देख तारा एदम्याह बुजणारे बायणा पोरच उब रेनाह, एने तुवाह बी बाहेर ली जाती!” <verse eid="ACT 5:9" /><verse number="10" style="v" sid="ACT 5:10" />तेवी ती चालोच पतरसान पाया हेऱ्यी जाय पोड़नी एने जीव सोड़ देनी, एने जुवान्या मायता आवीन तीह मुरेल देख्या, एने बाहेर ली जाईन तीन एदम्या हेऱ्याच बुज देना। <verse eid="ACT 5:10" /><verse number="11" style="v" sid="ACT 5:11" />आखी मोंडली पोर एने ज्‍यु वातुह होमेलनाराह आखाह जुलूम बिय आवी।<verse eid="ACT 5:11" /></para>
  <para style="s">चोमेत्कार एने मोटला काम</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12" />प्रेरितान आथा केरीन जुलूम मोटला कामे एने चोमेत्कारान काम माणहान विची माय देखाड़ाय जाताला, एने ता आखा एक मोन केरीन सुलेमानान खोली माय टोलवाताला। <verse eid="ACT 5:12" /><verse number="13" style="v" sid="ACT 5:13" />पुण थोड़ाक माणहाह ता माय जोड़ाणेन ईमोत नाह आवताली, तीबी माणहे तान जुलूम बोड़ाय केरताला। <verse eid="ACT 5:13" /><verse number="14" style="v" sid="ACT 5:14" />एने मालीक पोर बुरहो केरनारे जुलूम होवटा एदमी एने बायकु विश्वासीन मोंडली माय उंजु बी होवटाह आवीन बेचकाते रेना। <verse eid="ACT 5:14" /><verse number="15" style="v" sid="ACT 5:15" />न्या वोर काय माणहे दुखाऱ्याह सेड़की पोर लाव लावीन खाटला एने पोलांगा पोर लोटाड़ देया केरताला काय जेवी पतरस आवी, ते तान सावलो ओलोच ता माय रेन एगदा पोर पोड़ जाय। <verse eid="ACT 5:15" /><verse number="16" style="v" sid="ACT 5:16" />एने यरूशलेम हेयरान आहने पाहने गावाम रेन बी जुलूम माणहे दुखाऱ्याह, एने बुतड़ा लागेल माणहाह लाव लावीन एकठा एताला, एने आखा हुदाराय जाताला।<verse eid="ACT 5:16" /></para>
  <para style="s">प्रेरितान देराणो एने सुटणो</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17" />तेवी मुखी चाकर्‍यो एने तान आखा हाती, जा सदुकीन टोलान एता; कुयराना। <verse eid="ACT 5:17" /><verse number="18" style="v" sid="ACT 5:18" />एने ता प्रेरिताह देरीन जेली माय कोंड देना। <verse eid="ACT 5:18" /><verse number="19" style="v" sid="ACT 5:19" />पुण राती मालीकान एक हेरोगदुत जेलीन बायणो उगाड़ीन ताह बाहेर काड़ीन केयो, <verse eid="ACT 5:19" /><verse number="20" style="v" sid="ACT 5:20" />“जावो, मोंदिर माय उबरीन ज्या जीवणान आखी वातु माणहाह होमलाड़ो।” <verse eid="ACT 5:20" /><verse number="21" style="v" sid="ACT 5:21" />ता ज्यो होमलीन उजालो एताच मोंदिर माय जाईन हिकवोण देणे बाज गीया।</para>
  <para style="p" vid="ACT 5:21">पुण जेवी मुखी चाकर्‍यो एने तान हाती आवीन इस्राएलान डायलान आखा मोटला पोंचाह हादिन एकठा केऱ्या; एने जेली माय केय मोकल्या काय ताह लावे। <verse eid="ACT 5:21" /><verse number="22" style="v" sid="ACT 5:22" />एने आदिकारी ताहरी गीया, पुण प्रेरित ताह जेली माय नाह सापेड़ना, केरीन ता पोशा आवीन केया, <verse eid="ACT 5:22" /><verse number="23" style="v" sid="ACT 5:23" />“आमु ती जेलीह हास केरीन जोगवीन बोंद किरेल, एने देखरेत केरनारा सिपायाह बाहेर बायणा पोर उबरियेल देख्या; पुण जेवी आमु उगाड्या, ते माय कुण नाह सापेड़नो।” <verse eid="ACT 5:23" /><verse number="24" style="v" sid="ACT 5:24" />जेवी मोंदिरान आदिकारी एने मुखी चाकऱ्या ज्यी वातु होमल्या, ते ताह सोमेज माय नाह आवो काय प्रेरितान काय एनो, एने एवी ओंगाण काय एय। <verse eid="ACT 5:24" /><verse number="25" style="v" sid="ACT 5:25" />पुण कुण तीबी आवीन ताह केयो, “हुमलो! जा माणहाह तुमू जेलीम कोंडील एता, ता मोंदिर माय उबरीन माणहाह हिक देणे बाजरेनाह!” <verse eid="ACT 5:25" /><verse number="26" style="v" sid="ACT 5:26" />तेवी मुखी तान आदिकारी हिऱ्यो जाईन ताह लेन आवो, पुण ताकेत लागाड़ीन नाह, काहाकाय ता माणहाह बिताला काय आपुह देगड़ा केरीन नेवी नाय देती।<verse eid="ACT 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 5:27" />ता प्रेरिताह लावीन मोटला पोंचान सामने उबा केर देना, तेवी मुखी चाकर्‍यो ताह सावाल फुशो, <verse eid="ACT 5:27" /><verse number="28" style="v" sid="ACT 5:28" /><note caller="+" style="x"><char style="xo" closed="false">5:28 </char><char style="xt" closed="false"><ref loc="MAT 27:25">मत्ती 27:25</ref></char></note>“आमु तुमूह केड़ेक उकुम आपेल एता काय तुमू ज्या नावा केरीन हिकवोण मा दिहो; तीबी दिखो, तुमू आखा यरूशलेमाह तुमरी हिकवोण केरीन बोर दियेल हेते! एने ता माणहान लुय आमरे गेला पोर लावणे होदतेह।”<verse eid="ACT 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 5:29" />तेवी पतरस एने दिहरा प्रेरित जापाप आप्या, माणहान उकुमाह रेन जादा बोगवानान उकुमान पालेन केरनेच ने आमुह जोरेवरी हे। <verse eid="ACT 5:29" /><verse number="30" style="v" sid="ACT 5:30" />आमरा डायडायान बोगवान मुरेल माय रेन यीशुह जीव उठाड्यो, जाह तुमू खुरूसखाम पोर लेटकाड़ीन मार टाकेल एता। <verse eid="ACT 5:30" /><verse number="31" style="v" sid="ACT 5:31" />ताहाच बोगवान तान जीवड्या आथा पोर जुलूम उचो केरीन मालीक एने सोड़ेवणार ठेरायो काय तो इस्राएलाह मोन बोदेलने एने पापान माफी आपी। <verse eid="ACT 5:31" /><verse number="32" style="v" sid="ACT 5:32" />आमु ज्यी आखी वातुन गोवा हेते, एने तिहेच केरीन चोखालो जीव बी जाह बोगवान तान उकुमान पालेन केरनाराह आपेल हे।<verse eid="ACT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33" />ज्यो होमलीन ता जुलूम किचवाय गीया, एने प्रेरिताह मार टाकणेन विचार केऱ्या। <verse eid="ACT 5:33" /><verse number="34" style="v" sid="ACT 5:34" />पुण गमलीएल नावान एक फरिसी जो कायदान मास्तेर, एने आखा माणहा माय ईजुतदार ईतो। मोटला पोंचा माय उबरीन प्रेरिताह थोड़ीक टेमीन केरता बाहेर केर देणेन उकुम आप्यो, <verse eid="ACT 5:34" /><verse number="35" style="v" sid="ACT 5:35" />तेवी तो केयो, “एय इस्राएल, तुमू जो काय न्या माणहा हेऱ्या केरने होदतेह, सोच सोमजीन किरज्‍यो। <verse eid="ACT 5:35" /><verse number="36" style="v" sid="ACT 5:36" />काहाकाय ज्या दिह्याह रेन पेल थियूदास ज्यो किते लेन आवो काय मी बी काह हे। एने कोम से कोम चार होव माणहे तान पासाण चाल पोड़ना, पुण तो माराय गीयो एने जोलाक माणहे ताह मानताला, आखा वेरासेर एय गीया, एने खेतेम एय गीया। <verse eid="ACT 5:36" /><verse number="37" style="v" sid="ACT 5:37" />तान पासाण माणहान गेणतीन दिह्या माय यहुदा नावान एक गेलीली माणुह आवो, एने तो थोड़ाक माणहाह तान उगे केर लिदो; तो बी खेतेम एय गीयो, एने जोलाक माणहे ताह मानताला, आखा वेरासेर एय गीया। <verse eid="ACT 5:37" /><verse number="38" style="v" sid="ACT 5:38" />तानकेरता एवी मी तुमूह केथु, न्या माणहाह रेन सेटाच रिवो एने न्या हेऱ्या काय समंद मा मीलो; पुण ताह जाणे दिवो। काहाकाय केदी ज्यो उद्देश एने काम माणहान उगे रेन एय ताहार ते मिट जाय; <verse eid="ACT 5:38" /><verse number="39" style="v" sid="ACT 5:39" />पुण केदी बोगवानान उगे रेन हे, ते तुमू ताह केदिस खेतेम नाय केर सिकहो। इही नाय एय काय तुमू बोगवाना हेऱ्या बी लेड़ाणारे ठेराहो!”</para>
  <para style="p" vid="ACT 5:39">तेवी पोंचान माणहे गमलीएल ने वात मान लेदा। <verse eid="ACT 5:39" /><verse number="40" style="v" sid="ACT 5:40" />एने प्रेरिताह हादिन ताह देना; एने ज्यो उकुम आपीन सोड़ देना काय यीशुन नावा केरीन उंजु काह वात मा किरहो। <verse eid="ACT 5:40" /><verse number="41" style="v" sid="ACT 5:41" />प्रेरित ज्यी वातीह रेन खुस एन ज्यो कितेन मोटला पोंचान सामने रेन जात रेना, काय आपु यीशुन नावान केरता अपमान वेठणेन लायेक ते ठेराना। <verse eid="ACT 5:41" /><verse number="42" style="v" sid="ACT 5:42" />तान पासाण ता दाड़ीन मोंदिर माय एने गेरा गेरा माय जाईन हिकाड़ने, एने ज्यी वातीन हाजाली खुबेर होमलावणेन केरता नाह रोकाना काय यीशुच मसी हे।<verse eid="ACT 5:42" /></para>
  <chapter eid="ACT 5" />
  <chapter number="6" style="c" sid="ACT 6" />
  <para style="s">हात सेवक</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1" />ता दिह्या माय जेवी चेलान गेणती जुलूम वोदणे बाज गियी, तेवी युनानी बाषा बोलनारे यहुदि इब्रानी बाषा बोलनारा यहुदि पोर कुरकुर केरने बाज गीया, काय दाड़ीन दान माय तान रांडायेल बायकुन एर नाह केराय जात। <verse eid="ACT 6:1" /><verse number="2" style="v" sid="ACT 6:2" />तेवी ता बारा प्रेरित विश्वासीन मोंडलीह ता फाय हादिन केया, “ज्यो ठिक नाह सोतो काय आपु बोगवानान वचन सोड़ीन खावाड़ ने पिवाड़नेन सेवा केरी। <verse eid="ACT 6:2" /><verse number="3" style="v" sid="ACT 6:3" />तानकेरता एय बाय बोणहा, तुमरे माय रेन हात हाजाह एदम्याह जा चोखाला जीवा केरीन एने इकेल माय पुरा हेते, निवाड़ लिवो काय आपु ताह ज्या कामा पोर ठेराव देहु। <verse eid="ACT 6:3" /><verse number="4" style="v" sid="ACT 6:4" />पुण आमु ते विन्ता एने वचनान सेवा माय लागीन रेहु।”<verse eid="ACT 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 6:5" />ज्यी वात आखी मोंडलीह हाजी लागी, एने ता स्तिफनुस नावान एक एदम्याह जो बोरहाम एने चोखाला जीवा माय पुरो ईतो, एने फिलीपुस, प्रुखुरूस, नीकानोर, तीमोन, परमीनास एने अन्‍ताकियान नीकुलाउसाह जो यहुदिन बोरहा माय आव जायेल ईतो, निवाड़ लेदा। <verse eid="ACT 6:5" /><verse number="6" style="v" sid="ACT 6:6" />ता न्याह प्रेरितान सामने लेन आवा, एने ता विन्ता केरीन ता पोर आथ मेल्या।<verse eid="ACT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7" />बोगवानान वचन पोसेरते गीयो। एने यरूशलेम माय चेलान गेणती जुलूम वोदते गियी, एने चाकर्‍यान एक मोटलो सोमाज ज्या बोरहाह मान्नार बोण गीयो।<verse eid="ACT 6:7" /></para>
  <para style="s">स्तिफनुसान देराणो</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8" />स्तिफनुस गीण एने ताकेत माय पुरो एन माणहान विची माय मोट मोटला बोंगलाय ओहला काम एने चोमेत्कार देखाड्या केरतालो। <verse eid="ACT 6:8" /><verse number="9" style="v" sid="ACT 6:9" /><note caller="+" style="f"><char style="fr" closed="false">6:9 </char><char style="ft" closed="false">आजाद पोंथवाला; जा यहुदि पेल गुलाम एता पुण ता तान आजादी लेय लेदा, नाहते आजाद केराय गीया एती; ओहला ज्या माणहे एता। </char></note>तेवी ता बोक्ती केरन्या गेरा माय रेन जो लिबीरतीन केवाताली, एने कुरेनी एने आलेकजांडरीया एने किलीकीया एने आसीयान माणहाम रेन थोड़ाक माणहे उठीन स्तिफनुसा हेऱ्या बोलचाल केरने बाज गीया। <verse eid="ACT 6:9" /><verse number="10" style="v" sid="ACT 6:10" />पुण स्तिफनुस ओहली इकेल एने जीवा माय बोलतालो काय ता तान सामनो नाह केर सेक्‍या। <verse eid="ACT 6:10" /><verse number="11" style="v" sid="ACT 6:11" />तेवी ता थोड़ाक माणहाह ज्यो केणेन केरता ईरेचेड़ाया, “आमु ज्याह मुसान एने बोगवानान विरोद माय चिहटान वातु केरतालो होमलेल हेते!” <verse eid="ACT 6:11" /><verse number="12" style="v" sid="ACT 6:12" />एने माणहाह एने डायडायाह एने देरेमगुरूह ईरेचेड़ाया, एने ताह देरीन मोटला पोंचाम लेन आवा। <verse eid="ACT 6:12" /><verse number="13" style="v" sid="ACT 6:13" />एने जुठा गोवाह सामने लावा जा केया, “ज्यो माणुह ज्या चोखाला मोंदिर एने मुसान नेमान विरोद माय तालताल बोलते रीथे। <verse eid="ACT 6:13" /><verse number="14" style="v" sid="ACT 6:14" />काहाकाय आमु ज्याह ज्यो कितेन होमलेल हेते काय ज्योच यीशु नासरी ज्या मोंदिराह तोड़ देय, एने ती रितीह बोदेल देय जो मुसो आपुह होपेल हे।” <verse eid="ACT 6:14" /><verse number="15" style="v" sid="ACT 6:15" />तेवी आखा माणहे जा मोटला पोंचा माय बोह रियेल एता, स्तिफनुसा पोर हास केरीन नेजेर टाक्या, ते तान मुय हेरोगदुतान गेत देख्या।<verse eid="ACT 6:15" /></para>
  <chapter eid="ACT 6" />
  <chapter number="7" style="c" sid="ACT 7" />
  <para style="s">स्तिफनुसान बासेण</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1" />तेवी मुखी चाकर्‍यो स्तिफनुसाह केयो, “ज्यी खेरी वात हे काय?”<verse eid="ACT 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 7:2" />स्तिफनुस केयो, एय बाहख, एने डायडाया हुमलो! आमरो आबोख अब्राहाम हारान माय जाईन रेणेन पेल जेवी मेसोपोटामीया माय ईतो; ते बोड़ाय ने बोगवान ताह देरसेन आप्यो, <verse eid="ACT 7:2" /><verse number="3" style="v" sid="ACT 7:3" />एने अब्राहामाह केयो, “तु तारो कुटूम एने तारा देसा माय रेन निकलीन ता देसा माय जा, जो मी तुवाह देखाडुह।” <verse eid="ACT 7:3" /><verse number="4" style="v" sid="ACT 7:4" />तेवी अब्राहाम कसदियान देसाम रेन निकलीन हारान माय जाईन रेणे बाज गीयो। एने आबोख गोमाणेन पासाण बोगवान अब्राहामाह ता रेन ज्या देसा माय लावीन रेवाड्यो, जा माय एवी तुमू रेतेह। <verse eid="ACT 7:4" /><verse number="5" style="v" sid="ACT 7:5" />एने बोगवान ता अब्राहामाह काय मालदेन नाह आप्यो, न्या वोर काय पाय मेलनेन बी जागो नाह आप्यो, ताह सोरा नाह एता तीबी ज्यो देस तारे एने तार पासाण तारा सोरान आथाम जेलेमक्‍योच केरनेन वायदो बोगवान ताह आप्यो। <verse eid="ACT 7:5" /><verse number="6" style="v" sid="ACT 7:6" />एने बोगवान इहकेरीन केयो, “तारा सोरान माणहे पाराया देसाम पाराया रेती, एने ता ताह पावोर बाणावती एने चार होव वोरह्या वोर सेतावती।” <verse eid="ACT 7:6" /><verse number="7" style="v" sid="ACT 7:7" />ओवतो बोगवान केयो, “जा देसान ता पावोर रेती, ताह मी डेंड आपुह, ओवता तान पासाण ता निकलीन जीच जागे मारी चाकरी केरती।” <verse eid="ACT 7:7" /><verse number="8" style="v" sid="ACT 7:8" />एने बोगवान ता हिऱ्यो खेतनान वायदो बांद्यो; तानकेरता जेवी अब्राहाम रेन इसहाक पायदा ईनो, तेवी आठवे दिह इसहाकान खेतना किऱ्यो; एने इसहाक रेन याकुब पायदा ईनो, एने तान खेतान इसहाक किऱ्यो, एने याकुब रेन बारा सोरा पायदा एना, एने तान खेतना याकुब किऱ्यो, जा आमरा डायला हेते।<verse eid="ACT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9" />एने युसूफान बाहख ता हेऱ्या कुयराय केरीन ताह मीस्र देसाम जाणारान आथाम वेच देना। पुण बोगवान युसूफ हिऱ्यो ईतो, <verse eid="ACT 7:9" /><verse number="10" style="v" sid="ACT 7:10" />बोगवान युसूफाह आखा दुखाह रेन सोड़वीन मीस्र देसान राजा फिरोनान नेजरी माय गीण एने इकेल आप्यो, तेवी राजा मीस्र देस एने तान आखा गेराणा पोर आदिकारी ठेरायो। <verse eid="ACT 7:10" /><verse number="11" style="v" sid="ACT 7:11" />तेवी मीस्र देसाम एने आखा कनान देसाम काल पोड़नो एने मोटली पिड़ा आवी, एने आमरा बाप दादाह एन नाह जुड़तालो। <verse eid="ACT 7:11" /><verse number="12" style="v" sid="ACT 7:12" />पुण याकुब ज्यो होमलीन काय मीस्र माय दाणा हेते, आमरा बाप दादाह पेल्‍ली वार मोकल्यो। <verse eid="ACT 7:12" /><verse number="13" style="v" sid="ACT 7:13" />एने दिहरी वार युसूफ सोताह तान बायाख ने ओंगाण देखाड्यो, एने युसूफान जात फिरोनाह मालुम एय गियी। <verse eid="ACT 7:13" /><verse number="14" style="v" sid="ACT 7:14" />तेवी युसूफ तान आबोख याकुब एने तान आखा कुटूमाह, जा पंच्‍याहत्तर माणहे एता, ताह हादाड्यो काय ता मीस्र देसाम आवीन रेती। <verse eid="ACT 7:14" /><verse number="15" style="v" sid="ACT 7:15" />तेवी याकुब मीस्र देसाम निचो गीयो; एने ताहरी याकुब एने तान सोरा बी मोर गीया। <verse eid="ACT 7:15" /><verse number="16" style="v" sid="ACT 7:16" />याकुबान देड़ शकेम माय पोचाड़ीन ता माहणा माय मेल्या, जाह अब्राहाम पोयशा आपीन शकेम माय हमोरान सोरा फाय रेन वेचातो लियेल ईतो।<verse eid="ACT 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17" />पुण जेवी ता वायदान पुरो एणेन टेम आहने आवो, जो बोगवान अब्राहाम हिऱ्यो किरेल ईतो, ते मीस्र देसा माय ता माणहे वोड़ गीया एने जुलूम एय गीया। <verse eid="ACT 7:17" /><verse number="18" style="v" sid="ACT 7:18" />तेवी मीस्र देसाम दिहरो राजा बोणनो जो युसूफाह नाह ओलेखतालो। <verse eid="ACT 7:18" /><verse number="19" style="v" sid="ACT 7:19" />तो आमरी जाती हिऱ्यो चालाकी केरीन आमरा बाप दादा हिऱ्यो न्या वोर खाराब वेवार किऱ्यो, एने ताह तान सोराह टाकणेन केरता मोजबुर किऱ्यो काय ता जीवताला नाय रेय। <verse eid="ACT 7:19" /><verse number="20" style="v" sid="ACT 7:20" />ती टेम माय मुसो पायदा ईनो, तो बोगवानान नेजरी माय जुलूम हाजो ईतो। तो तीन मोयना वोर तान आबाख ने गेरा माय पोहानो, <verse eid="ACT 7:20" /><verse number="21" style="v" sid="ACT 7:21" />जेवी तो बाहेर जुगाराय गीयो, ते फिरोन ने बेटीख ताह विसीन ली गियी एने तीन बिटोख बाणावीन पोही। <verse eid="ACT 7:21" /><verse number="22" style="v" sid="ACT 7:22" />एने मुसाह मीस्री माणहान आखी विद्यान हिकवोण आप्या, एने तो बोलने एने काम दुयाम ताकेतवोर ईतो।<verse eid="ACT 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 7:23" />जेवी मुसो चालीह वोरह्यान ईनो, ते तान मोना माय आवो काय मी मारा इस्राएली बायाख हिऱ्यो मीलाव। <verse eid="ACT 7:23" /><verse number="24" style="v" sid="ACT 7:24" />तो एक माणहा पोर खाराब वेवार एतालो देखीन ताह वोचाड्यो, एने मीस्री माणहाह मारीन नुकसान किरेल तान बुदलो लिदो। <verse eid="ACT 7:24" /><verse number="25" style="v" sid="ACT 7:25" />मुसो सुचो काय तान माणहे सोमजेती काय बोगवान मार आथा केरीन तान सुटकारो केरी, पुण ता नाह सोमज्या। <verse eid="ACT 7:25" /><verse number="26" style="v" sid="ACT 7:26" />दिहरे दिह जेवी ता आपसाम लेड़ाताला, ते मुसो ताहरी जाय पोचनो; एने ज्यो केयीन ताह मेल केरनेन केरता सोमजाड्यो, एने केयो, “एय एदमी, तुमू ते बाहख बाहख हेते, एका दिहरा हेऱ्या काहा लेड़ातेह?” <verse eid="ACT 7:26" /><verse number="27" style="v" sid="ACT 7:27" />पुण जो तान आहने रेणारा हिऱ्यो लेड़ातालो तो मुसाह देखलीन केयो, “तुवाह आमु पोर आदिकार केरनार एने नियाव केरनार कुण ठेरायेल हे? <verse eid="ACT 7:27" /><verse number="28" style="v" sid="ACT 7:28" />काल तु जिहकेरीन मीस्री माणहाह मारील, तिहेच केरीन माहु बी मारने हुदेह काय?” <verse eid="ACT 7:28" /><verse number="29" style="v" sid="ACT 7:29" />ज्यी वात होमलीन मुसो नाह गीयो, एने मिद्यान देसा माय परायो एन रेणे बाज गीयो, एने ताहरी मुसान दुय सोरा पायदा एना।<verse eid="ACT 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30" />जेवी पुरा चालीह वोरह्या वित गीया, ते एक हेरोगदुत सिनाय बोयड़ान उजाड़ी माय मुसाह हेलेगताला जाड़ान आसी माय देरसेन दिनो। <verse eid="ACT 7:30" /><verse number="31" style="v" sid="ACT 7:31" />मुसो जेवी जाड़ाह दिख्यो ते बोंगलाय गीयो, एने जेवी तो ताह हास केरीन देखणेन केरता आहने गीयो। ते मालीकान ज्यो बोल होमलानो। <verse eid="ACT 7:31" /><verse number="32" style="v" sid="ACT 7:32" />मी तारा बाप दादा, अब्राहाम, इसहाक, एने याकुबान बोगवान हे, तेवी मुसो काप उठनो, एने देखणेन ताह ईमोत नाह रेनी। <verse eid="ACT 7:32" /><verse number="33" style="v" sid="ACT 7:33" />तेवी मालीक मुसाह केयो, “तारा पायाम रेन खाहड़ा काड़ दे, काहाकाय जी जागे तु उबरियेल हे, तो चोखालो जागो हे। <verse eid="ACT 7:33" /><verse number="34" style="v" sid="ACT 7:34" />मी खेरीच मीस्र देसा माय मार माणहान तेकलीत दिखेल हे; एने तान आयेड़नो एने तान रेड़नो होमलेल हे; केरीन ताह सोड़ेवणेन केरता उतेर आयेल हे। एवी आव, मी तुवाह मीस्र देसाम मोकलुह।”<verse eid="ACT 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35" />जा मुसाह ता ज्यो केयीन नाकारेल एता, “तुवाह कुण आमु पोर आदिकारी एने नियाव केरनार ठेरायेल हे?” ताहास बोगवान आदिकारी एने सोड़ेवणार ठेरावीन ता हेरोगदुतान द्‍वारे मोकल्यो, जो ताह जाड़ा माय देरसेन दियेल ईतो। <verse eid="ACT 7:35" /><verse number="36" style="v" sid="ACT 7:36" />ज्योच माणुह मीस्र देसा माय रातलो देरीयो, एने उजाड़ी माय चालीह वोरह्या वोर चोमेत्कार एने निसाणी देखाड़ते लेन ताह निकाल लावो। <verse eid="ACT 7:36" /><verse number="37" style="v" sid="ACT 7:37" /><note caller="+" style="f"><char style="fr" closed="false">7:37 </char><char style="ft" closed="false">तो माहु जिहकेरीन मुकलेल हे तिहकेरीन; नाहते मार गेत।</char></note>ज्यो तोच मुसो हे, जो इस्राएलाह कियेल, “बोगवान तुमरी केरता तुमरा बायाख माय रेन मार होच एक जाणाव केरनाराह उबो केरी।” <verse eid="ACT 7:37" /><verse number="38" style="v" sid="ACT 7:38" />ज्यो तोच हे, जो उजाड़ी माय मोंडलीन विची माय ता हेरोगदुता हिऱ्यो सिनाय बोयड़ा पोर मुसा हिऱ्यो वातु किऱ्यो; एने आमरा बाप दादा हिऱ्यो, ताहच जीवतालो वचन जुड़नो काय आपु फाय वोर पोचाड़ी।<verse eid="ACT 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 7:39" />पुण आमरा बाप दादा तान मानने नाह होद्या, पुण ता ताह ठोकरावीन तान मोनाह मीस्र देसान निही फिराया, <verse eid="ACT 7:39" /><verse number="40" style="v" sid="ACT 7:40" />एने हारूनाह केया, “आमरी केरता ओहलो देवताह बाणाव, जो आमरे ओंगाण ओंगाण चाले, काहाकाय आमु नाह जाणते काय ता मुसान काय एनो? जो आमुह मीस्र देस रेन निकालीन लायेल ईतो।” <verse eid="ACT 7:40" /><verse number="41" style="v" sid="ACT 7:41" />तेवी ता एक वासड़ान एक मुरती बाणावीन तान ओंगाण बोली चेड़ाया, एने तान आथान कामा माय खुसी मोणाव्या एने पावणाय केऱ्या। <verse eid="ACT 7:41" /><verse number="42" style="v" sid="ACT 7:42" /><note caller="+" style="f"><char style="fr" closed="false">7:42 </char><char style="ft" closed="false">अमोस 5:25-27</char></note>ज्यानकेरता बोगवान मुय फिरावीन ताह सोड़ दिनो, काय जुगाह पुजे, जिहकेरीन जाणाव केरनारान पुस्तेक माय लिखेल हे,</para>
  <para style="q1" vid="ACT 7:42">“एय इस्राएल ने गेराणा! काय तुमू उजाड़ी माय</para>
  <para style="q2" vid="ACT 7:42">चालीह वोरह्या वोर जेनवेराह मारीन बोली चेड़ावती रेना?<verse eid="ACT 7:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="ACT 7:43" />एने तुमू मोलेक ने तोम्बु एने रिफान देवतान ताराह लेन फिरताला,</para>
  <para style="q2" vid="ACT 7:43">मतलब त्यु मुरत्युह ज्युह तुमू पुजणेन केरता बाणायेल एत्यु।</para>
  <para style="q1" vid="ACT 7:43">केरीन मी तुमूह बाबिलोन ने ती उगे ली जाईन बोहाडुह।”<verse eid="ACT 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44" />आमरा बाप दादा फाय बोगवानान पुरावान तोम्बु एतो, जिहकेरीन बोगवान मुसाह कियेल तिहेच केरीन मुसो बाणायेल, तो ता नमुनान गेत एतो, जो मुसाह देखाड़ेल एतो। <verse eid="ACT 7:44" /><verse number="45" style="v" sid="ACT 7:45" />ताच तोम्बुह आमरा बाप दादा जुनाला कालाम होदिन यहोशु हेऱ्या न्याहरी लेन आवा; ती टेम काय ता ती दिहरी जाती पोर आदिकार जुड़नो, जाह बोगवान आमरा बाप दादान सामने रेन निकाल देनो, एने तो तोम्बु दाऊदान टेम वोर रेनो। <verse eid="ACT 7:45" /><verse number="46" style="v" sid="ACT 7:46" /><note caller="+" style="f"><char style="fr" closed="false">7:46 </char><char style="ft" closed="false">याकुब ने बोगवान; थोड़ाक लेख माय इस्राएल ने माणहे।</char></note>दाऊद पोर बोगवान गीण किऱ्यो; केरीन तो विन्ता किऱ्यो काय तो याकुब ने बोगवानाह रेणेन केरता तोम्बु बाणावी। <verse eid="ACT 7:46" /><verse number="47" style="v" sid="ACT 7:47" />पुण सुलेमान बोगवानान केरता गेर बाणायो।<verse eid="ACT 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 7:48" />पुण आखाह रेन मोटलो बोगवान आथा केरीन बाणायेल गेरा माय नाह रेणे, जिहकेरीन काय जाणाव केरनारे केया,<verse eid="ACT 7:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="ACT 7:49" />
    <note caller="+" style="f">
      <char style="fr" closed="false">7:49 </char>
      <char style="ft" closed="false">यशाया 66:1-2</char>
    </note>“मालीक किथे, हेरोग मारी राजगादि एने देरती मार पाय मेलनेन जागो हे,</para>
  <para style="q1" vid="ACT 7:49">तुमू मार केरता कोहलो गेर बाणावहु?</para>
  <para style="q2" vid="ACT 7:49">एने मारो विहेवणेन काल्लो जागो रेय?<verse eid="ACT 7:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="ACT 7:50" />काय ज्‍यु सोब चिज मार आथा केरीन बाणायेल नाह?”<verse eid="ACT 7:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51" />एय एकएट्या माणहे, “तुमरो मोन एने कान बिगेर खेतनान हे, तुमू जेलेम चोखाला जीवान विरोद केरतेह: जीहे तुमरा बाप दादा केरताला, तिहेच केरीन तुमू बी केरतेह। <verse eid="ACT 7:51" /><verse number="52" style="v" sid="ACT 7:52" />जाणाव केरनाराम रेन कुणीह तुमरा बाप दादा नाह वेला केराया? एने तुमरा बाप दादा ता देरमीह आवणेन पेलुच रेन खुबेर केरनाराह मार टाक्या; एने एवी तुमू बी ता देरमीह देरावणारे एने मार टाकणारे एना। <verse eid="ACT 7:52" /><verse number="53" style="v" sid="ACT 7:53" />तुमू हेरोगदुतान द्‍वारे पोचाड़ेल नेम ते सापड़ाया, पुण तान पालेन नाह केऱ्या!”<verse eid="ACT 7:53" /></para>
  <para style="s">स्तिफनुसान देगड़ाठणे से मोत</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54" />ज्‍यु वातु होमलीन ता खीजवाय गीया, एने स्तिफनुसा पोर दात केकड़ावणे बाज गीया। <verse eid="ACT 7:54" /><verse number="55" style="v" sid="ACT 7:55" />पुण स्तिफनुस चोखाला जीवा माय पुरो एन हेरगान उगे दिख्यो, एने बोगवानान बोड़ायीह एने यीशुह बोगवानान जीवड़े उगे उबरियेल देखीन। <verse eid="ACT 7:55" /><verse number="56" style="v" sid="ACT 7:56" />केयो, “दिखो, मी हेरगाह उगड़ील, एने माणहान बेटाख<note caller="+" style="x"><char style="xo" closed="false">7:56 </char><char style="xq" closed="false">माणहान बेटाख </char><char style="xt" closed="false"><ref loc="DAN 7:13">दानिएल 7:13</ref></char></note> बोगवानान जीवड़े उगे उबरियेल देखथु!”<verse eid="ACT 7:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="ACT 7:57" />तेवी ता मोठेस आयड़ीन कान बोंद केर लेदा। एने पोंचान आखा मेहमोर मिलीन एकठास स्तिफनुसा पोर तुट पोड़ना, <verse eid="ACT 7:57" /><verse number="58" style="v" sid="ACT 7:58" />एने ता स्तिफनुसाह गावान बाहेर निकालीन देगड़ाठणे बाज गीया। एने गोवा माणहे तान फाड़का शाऊल नावान एक जुवानान पाया हेऱ्या काड़ीन मेल देना। <verse eid="ACT 7:58" /><verse number="59" style="v" sid="ACT 7:59" />एने जेवी ता स्तिफनुसाह देगड़ाठते रेना, तेवी स्तिफनुस ज्यो केयीन विन्ता केरती रिनो, “एय मालीक यीशु, मार जीवाह स्वीकार ले!” <verse eid="ACT 7:59" /><verse number="60" style="v" sid="ACT 7:60" />ओवतो मांड्या वोलीन स्तिफनुस मोठेस आयेड़नो, “एय मालीक, ज्यो पाप न्या पोर मा लागाड़े!” एने इहकेरीन केयीन स्तिफनुस मोर गीयो।<verse eid="ACT 7:60" /></para>
  <chapter eid="ACT 7" />
  <chapter number="8" style="c" sid="ACT 8" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1" />शाऊल स्तिफनुसान मोतीम बेचकायेल ईतो,</para>
  <para style="s" vid="ACT 8:1">शाऊल मोंडलीन सताव केरने</para>
  <para style="p" vid="ACT 8:1">तेदिस रेन यरूशलेम वाली मोंडली पोर जुलूम सेताव आवो। तानकेरीन प्रेरिताह सोड़ीन आखा विश्वासी यहुदिया एने सामरीया देसा माय खोवलाय गीया। <verse eid="ACT 8:1" /><verse number="2" style="v" sid="ACT 8:2" />एने थोड़ाक जा बोक्ती केरनारे एता ता स्तिफनुसाह माहणा माय मेल्या एने तानकेरता जुलूम रेड़ना।<verse eid="ACT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 8:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8:3 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 22:4">प्रेरितान काम 22:4</ref>,<ref loc="ACT 22:5">5</ref>; <ref loc="ACT 26:9-11">26:9-11</ref></char>
    </note>पुण शाऊल मोंडलीह उजाड़तालो; एने गेरा गेरा माय रिगीन विश्वासी एदम्याह, एने बायकुह गीहली गीहलीन जेली माय कोंडतालो।<verse eid="ACT 8:3" /></para>
  <para style="s">सामरीया माय फिलीपुसान पारचार</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4" />जा विश्वासी माणहे खोवलाय जायेल एता, एने जाहरी बी गीया ताहरी ता हाजाली खुबेर होमलाड़तेन फिरना। <verse eid="ACT 8:4" /><verse number="5" style="v" sid="ACT 8:5" /><note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="ft" closed="false">मुखी हियोर; थोड़ाक लेख माय एक हियोर।</char></note>एने फिलीपुस नेचो सामरीया हेयरा माय जाईन माणहा माय मसीन पारचार केरने बाज गीयो। <verse eid="ACT 8:5" /><verse number="6" style="v" sid="ACT 8:6" />तेवी ता फिलीपुसान वातु होमलीन एने जा चोमेत्कार तो देखाड़तालो, ताह देखीन एक एन वचना पोर मोन लागाड्या। <verse eid="ACT 8:6" /><verse number="7" style="v" sid="ACT 8:7" />काहाकाय जुलूम माणहा माय रेन बुतड़ा जोरेस आयड़ीन बाहेर निकील गीया, एने जा लोखवा वाला एने पांगला माणहे एता, ता माय रेन जुलूम माणहे हुदरी गीया। <verse eid="ACT 8:7" /><verse number="8" style="v" sid="ACT 8:8" />एने ता हेयराम जुलूम खुसी एनी।<verse eid="ACT 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9" />मोकतास दिह्यान पेल ता हेयरा माय शिमोन नावान एक माणुह एतो, तो जादु केरीन सामरीयान माणहाह बोंगलाड्या केरतालो। एने सोताह मोटलो माणुह सोमेजतालो। <verse eid="ACT 8:9" /><verse number="10" style="v" sid="ACT 8:10" />आतल्या रेन डावाला वोर तान मान मेलीन केताला, “ज्यी माणहान ताकेत नाह बोगवानान ताकेत हे जी मोठी केवाथे।” <verse eid="ACT 8:10" /><verse number="11" style="v" sid="ACT 8:11" />तो ताह मोकता दिह्यान तान जादु केरीन बोंगलाड़ मीलेल ईतो, केरीन ता ताह जुलूम मानताला। <verse eid="ACT 8:11" /><verse number="12" style="v" sid="ACT 8:12" />पुण जेवी ता फिलीपुसान खुबेर पोर बुरहो केऱ्या जो बोगवानान राज ने एने यीशु मसीन नावा माय हाजाली खुबेर होमलाड़तालो, ते एदमी एने बायकु बपतीस्मा लेणे बाज गीया। <verse eid="ACT 8:12" /><verse number="13" style="v" sid="ACT 8:13" />तेवी शिमोन बी बुरहो केरीन बपतीस्मा लेन फिलीपुस हिऱ्यो रेणे बाज गीयो, तो मोट मोटली निसाणी एने चोमेत्कार ने काम एताला देखीन बोंगलाय जातालो।<verse eid="ACT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14" />जेवी यरूशलेम माय रेणारे प्रेरित होमल्या काय सामरी माणहे बोगवानान वचन मान लेदाह तेवी ता फाय पतरस एने योहानाह मोकल्या। <verse eid="ACT 8:14" /><verse number="15" style="v" sid="ACT 8:15" />पतरस एने योहान ताहरी आवीन विश्वासीह चोखालो जीव जुड़ी केरीन विन्ता केऱ्या। <verse eid="ACT 8:15" /><verse number="16" style="v" sid="ACT 8:16" />काहाकाय ताह वोर चोखालो जीव ताम रेन कुणा पोर बी उतरेल नाह एतो, ता ते फोक्‍तो मालीक यीशुन नावा माय बपतीस्मा लियेल एता। <verse eid="ACT 8:16" /><verse number="17" style="v" sid="ACT 8:17" />तेवी पतरस एने योहान ता पोर आथ मेल्या, एने ताह चोखालो जीव जुड़नो।<verse eid="ACT 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18" />जेवी प्रेरितान आथ मेलताच चोखालो जीव जुड़ेह। ज्यो देखीन शिमोन ता फाय पोयशा लावीन केयो, <verse eid="ACT 8:18" /><verse number="19" style="v" sid="ACT 8:19" />“जा पोर बी मी आथ मेलु ताह चोखालो जीव जुड़ी ओहलो आदिकार माहु बी आपो।”<verse eid="ACT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 8:20" />तेवी पतरस ताह केयो, “तारा पोयशा तार हेऱ्याच खेतेम एय, काहाकाय तु बोगवानान दानाह पोयशा आपीन वेचातो लेणेन विचार किरेल हे! <verse eid="ACT 8:20" /><verse number="21" style="v" sid="ACT 8:21" />ज्यी वातीन नाह तारो ईसो हे नाह वाटो, काहाकाय तारो मोन बोगवानान ओंगाण हुतरो नाह। <verse eid="ACT 8:21" /><verse number="22" style="v" sid="ACT 8:22" />तानकेरता तारी ज्यी खाराबी माय रेन मोन बोदलीन मालीका फाय विन्ता केर, एय सेकी ते तारा मोनान विचार माफ केराय जाती। <verse eid="ACT 8:22" /><verse number="23" style="v" sid="ACT 8:23" />काहाकाय माहु मालुम हे काय तारो मोन माणायीन अन्याय माय फोस रेनोह।”<verse eid="ACT 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 8:24" />तेवी शिमोन ताह केयो, “तुमू कियेल त्यु वातुम रेन काल्ली बी वातु माहु पोर नाय आवणे जुवे, केरीन मार केरता बोगवाना फाय विन्ता किरो।”<verse eid="ACT 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 8:25" />ओवता पतरस एने योहान पुरावो दितेन एने मालीकान वचन होमलाड़ीन, यरूशलेम माय आव लागा, एने आवणे बुखेत सामरीयान जुलूम होवटा गावा माय हाजाली खुबेर होमलाड़ते गीया।<verse eid="ACT 8:25" /></para>
  <para style="s">फिलीपुस एने कुस देसान आदिकारी</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26" />ओवतो बोगवानान एक हेरोगदुत फिलीपुसाह केयो, “दक्शिण उखेरली वाटे जा ज्यी यरूशलेम लागती गाजा माय जाथे, ती रेटान वाट हे।”<note caller="+" style="f"><char style="fr" closed="false">8:26 </char><char style="ft" closed="false">दक्शिण; नाहते ठिक हिराण पोर ज्यी वाट आज काल वापेर नाह ईत; ज्यी उजाड़ीन वाट हे।</char></note> <verse eid="ACT 8:26" /><verse number="27" style="v" sid="ACT 8:27" />ओवतो फिलीपुस उठीन चाल दिनो, एने तेवी कुश देसान एक माणुह आवणे बाजरियेल ईतो, जो खोज्या एने कुशीन राणी कन्दाकेन मोंत्री एने खजानान मालीक ईतो, तो बोक्ती केरनेन केरता यरूशलेम आयेल ईतो। <verse eid="ACT 8:27" /><verse number="28" style="v" sid="ACT 8:28" />एने तो तान तांगा माय बोहीन यशाया जाणाव केरनारान पुस्तेक वाचतेन जाणे बाजरियेल ईतो। <verse eid="ACT 8:28" /><verse number="29" style="v" sid="ACT 8:29" />तेवी चोखालो जीव फिलीपुसाह केयो, “जा तांगा वाला हिऱ्यो चाल पोड़।” <verse eid="ACT 8:29" /><verse number="30" style="v" sid="ACT 8:30" />फिलीपुस तान उगे दोवड़ीन गीयो। एने ताह यशाया जाणाव केरनारान पुस्तेक वाचतालो होमलीन ताह केयो, “जो तु वाचेह तो तुवाह सोमजेह काय?”<verse eid="ACT 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 8:31" />मोंत्री ताह केयो, “जाह वोर कुण बी माहु सोमजाड़ नाय देय ताह वोर मी किहीक सोमजु?” एने तो फिलीपुसाह विन्ता किऱ्यो काय चेड़ीन ता हिऱ्यो बोही। <verse eid="ACT 8:31" /><verse number="32" style="v" sid="ACT 8:32" /><note caller="+" style="f"><char style="fr" closed="false">8:32 </char><char style="ft" closed="false">यशाया 53:7-8</char></note>चोखाली पुस्तेक माय जो वचन वाचणे बाजरियेल ईतो, तो ज्यो एतो:</para>
  <para style="q1" vid="ACT 8:32">“ताह मेंड्रान गेत मारनेन केरता ली गीया,</para>
  <para style="q2" vid="ACT 8:32">एने जिहकेरीन गीदल्यो तान रोचका कातरनारान सामने ठावकोच रीथे।</para>
  <para style="q2" vid="ACT 8:32">तिहेच केरीन तो बी तान मुय नाह उगाड्यो।”<verse eid="ACT 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="ACT 8:33" />तान गेरबोड़ाय माय तान नियाव नाह ईनो,</para>
  <para style="q2" vid="ACT 8:33">एने तान कालान माणहान बाराम वातु कुण केरी?</para>
  <para style="q2" vid="ACT 8:33">काहाकाय देरती पोर रेन तान जीवाय विसाय जाथे।<verse eid="ACT 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34" />ज्यी वाती पोर रेन खोज्या फिलीपुसाह फुशो, “मी तुवाह विन्ता केरथु, तु माहु सोमजाड़ ज्यी वातु जाणाव केरनार कुणीन बाराम किथे, सोतान काय दिहरान बाराम?” <verse eid="ACT 8:34" /><verse number="35" style="v" sid="ACT 8:35" />तेवी फिलीपुस ज्‍यीस पुस्तेकीन बागा माय रेन सुरवात केरीन ताह यीशुन हाजाली खुबेर होमलाड्यो। <verse eid="ACT 8:35" /><verse number="36" style="v" sid="ACT 8:36" />ता वाटे जाता जाता एक पाण्यान जागे पोचना, तेवी खोज्या ताह केयो, “देख, न्या पाणी हे, एवी माहु बपतीस्मा लेणेन केरता काय रोक हे?” <verse eid="ACT 8:36" /><verse number="37" style="v" sid="ACT 8:37" />फिलीपुस ताह केयो, “केदी तु पुरा मोना केरीन बुरहो किरेह ताहार लेय सिकेह,” तो ताह केयो, “मी बुरहो केरथु काय यीशु मसी बोगवानान बिटोख हे।”<note caller="+" style="f"><char style="fr" closed="false">8:37 </char><char style="ft" closed="false">ज्यो वचन थोड़ाक हस्त लेख माय नाह जुड़ेत</char></note><verse eid="ACT 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 8:38" />तेवी आदिकारी तांगो उबराखाड़ ने केयो, फिलीपुस एने खोज्या दुय पाण्याम गीया, एने फिलीपुस ताह बपतीस्मा आप्यो। <verse eid="ACT 8:38" /><verse number="39" style="v" sid="ACT 8:39" />जेवी ता पाण्याम रेन निकलीन बाहेर आवा, तेवी मालीकान जीव फिलीपुसाह विस ली गीयो, एने खोज्या ताह पोशो नाह दिख्यो, एने तो मोंज केरतीन तान वाटे जात रिनो। <verse eid="ACT 8:39" /><verse number="40" style="v" sid="ACT 8:40" />पुण फिलीपुस देख्यो काय मी अशदोद माय हे, एने जाह वोर केसरीया माय नाह पोचनो, ताह वोर एकेक हेयरा हेयराम हाजाली खुबेर होमलाड़ते गीयो।<verse eid="ACT 8:40" /></para>
  <chapter eid="ACT 8" />
  <chapter number="9" style="c" sid="ACT 9" />
  <para style="s">शाऊलान मोन बोदेलने</para>
  <para style="r">(<ref loc="ACT 22:6-16">प्रेरितान काम 22:6-16</ref>; <ref loc="ACT 26:12-18">26:12-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1" />शाऊल जो एवी वोर मालीकान चेलाह दोमकी देणे एने मारनेन दुंद माय ईतो, मुखी चाकऱ्या फाय गीयो। <verse eid="ACT 9:1" /><verse number="2" style="v" sid="ACT 9:2" />एने तो दमिश्‍क ने बोक्ती केरन्या गेरान नावा पोर ओहली चिट्ठी मांग्‍यो काय एदमी काय बायकु, कुण बी ताह सापड़ी, ताह बांदिन यरूशलेम माय लावे।<verse eid="ACT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 9:3" />पुण चालते चालते जेवी शाऊल दमिश्‍क ने आहने पोचनो, ते उचकाहुच जुगाम रेन तान कावदेन उजालो चोमेकनो। <verse eid="ACT 9:3" /><verse number="4" style="v" sid="ACT 9:4" />एने शाऊल बुई पोर जाय पोड़नो एने ज्यो आवाज होमल्यो, “एय शाऊल, एय शाऊल, तु माहु काहा वेला केरावेह?”<verse eid="ACT 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 9:5" />शाऊल फुशो, “एय मालीक, तु कुण हे?” तो केयो, “मी यीशु हे, जाह तु वेला केरावेह। <verse eid="ACT 9:5" /><verse number="6" style="v" sid="ACT 9:6" />पुण एवी उठीन हेयरा माय जा, एने जो तुवाह केरनु हे तो तुवाह केवाय जाय।”<verse eid="ACT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 9:7" />जा माणहे शाऊल हेऱ्या एता, ता ठावकाच रेय गीया; काहाकाय आवाज ते होमेलताला, पुण ताह कुणीस देखानो नाह। <verse eid="ACT 9:7" /><verse number="8" style="v" sid="ACT 9:8" />तेवी शाऊल बुई पोर रेन उठनो, पुण जेवी डोला उगाड्यो ते ताह कायच देखानो नाह, एने तान हाती शाऊलान आथ देरीन दमिश्‍क माय ली गीया। <verse eid="ACT 9:8" /><verse number="9" style="v" sid="ACT 9:9" />एने ताहरी शाऊल तीन दिह वोर देख नाह सीक्‍यो, एने नाह खादो एने नाह पिदो।<verse eid="ACT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10" />दमिश्‍क माय हनन्या नावान एक विश्वासी ईतो, ताह मालीक देरसेन माय केयो, “एय हनन्या!”</para>
  <para style="p" vid="ACT 9:10">तो जापाप आप्यो, “मी हाजीर हे, मालीक।”<verse eid="ACT 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 9:11" />तेवी मालीक हनन्याह केयो, “उठीन ती गेली माय जा, ‘जी हुतरी केवाथे,’ एने यहुदान गेरा माय शाऊल नावान एक तरसुस माय रेणाराह फुस; काहाकाय देख, तो विन्ता केरने बाजरिनोह, <verse eid="ACT 9:11" /><verse number="12" style="v" sid="ACT 9:12" />एने शाऊल देरसेन माय हनन्या नावान एक एदम्याह माय आवतालो एने तान उपेर आथ मेलतालो दिख्यो काय पोशो देखणे बाज जाय।”<verse eid="ACT 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13" />हनन्या जापाप आप्यो, “एय मालीक, मी ज्या एदम्यान बाराम मोकता जाणा फाय रेन होमलेल हे काय ज्यो यरूशलेम माय तारा चोखाला माणहा हिऱ्यो मोट मोटल्यु बुराय किरेल हे। <verse eid="ACT 9:13" /><verse number="14" style="v" sid="ACT 9:14" />एने न्याहरी बी तारो नाव लेणाराह आखाह बांदुह ओहलो मुखी चाकऱ्या फाय रेन शाऊलाह आदिकार जुड़ेल हे।”<verse eid="ACT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 9:15" />पुण मालीक हनन्याह केयो, “तु जा; काहाकाय तो ते बिगेर यहुदि एने राजान एने इस्राएलान सामने मारो नाव देखाड़नेन केरता मारो निवाड़ेल ठामलो हे। <verse eid="ACT 9:15" /><verse number="16" style="v" sid="ACT 9:16" />एने मी ताह केह काय मार नावान केरता ताह कोहला कोहला दुख वेठणे पोड़ी।”<verse eid="ACT 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17" />तेवी हनन्या उठीन ता गेरा माय गीयो, एने ता पोर तान आथ मेलीन केयो, “एय बाहख शाऊल, मालीक मतलब यीशु, जो ती वाटे माय जा रेन तु आवो तुवाह देखायेल ईतो, तोस माहु मोकलेल हे काय तु उंजु देखणे बाज जाय एने चोखाला जीवा केरीन पुरो बोराय जाय।” <verse eid="ACT 9:17" /><verse number="18" style="v" sid="ACT 9:18" />एने चालोच तान डोलाम रेन खोलच्‍यान गेत पोड़नो एने शाऊल देखणे बाज गीयो, एने उठीन बपतीस्मा लिदो; <verse eid="ACT 9:18" /><verse number="19" style="v" sid="ACT 9:19" />एने जेवी शाऊल खाणो खादो, तेवी ताह पोशी ताकेत जुड़नी।</para>
  <para style="s" vid="ACT 9:19">दमिश्‍क माय शाऊलान पारचार</para>
  <para style="p" vid="ACT 9:19">शाऊल मोकता दिह वोर ता विश्वासी हिऱ्यो रिनो जा दमिश्‍क माय एता। <verse eid="ACT 9:19" /><verse number="20" style="v" sid="ACT 9:20" />एने शाऊल चालोच यहुदिन बोक्ती केरन्या गेरा माय यीशुन पारचार केरने बाज गीयो काय तो बोगवानान बिटोख हे।<verse eid="ACT 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 9:21" />एने आखा होमेलनारे बोंगलायीन केणे बाज गीया, “काय ज्यो तोस माणुह नाह सुतो जो यरूशलेम माय ताह जा यीशुन बोक्ती केरताला, ताह खेतेम केरतालो; एने न्या बी ज्यानकेरता आयेल ईतो काय ताह बांदिन मुखी चाकऱ्या फाय ली जाय?”<verse eid="ACT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 9:22" />पुण शाऊल उंजु बी ताकेतवोर बोणती गीयो, एने यीशुस मसी हे इहकेरीन पुरावो आपीन दमिश्‍क माय रेणारे यहुदि माणहाह बोंगलाड़ दिनो।<verse eid="ACT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23" />
    <note caller="+" style="x">
      <char style="xo" closed="false">9:23 </char>
      <char style="xt" closed="false">
        <ref loc="2CO 11:32">2 कुरिंथीयो 11:32</ref>,<ref loc="2CO 11:33">33</ref></char>
    </note>जेवी जुलूम दिह वित गीया, ते यहुदि मिलीन शाऊलाह मारनेन होमच्‍यो केऱ्या, <verse eid="ACT 9:23" /><verse number="24" style="v" sid="ACT 9:24" />पुण तान होमच्‍यो शाऊलाह मालुम एय गीयो। ता ते शाऊलाह मार टाकणेन केरता रात दिह हेयरान फाटेक पोर तियारी माय रेताला। <verse eid="ACT 9:24" /><verse number="25" style="v" sid="ACT 9:25" />पुण तान चेला रातीन वेला ताह एक टोपला माय बोहाड़ीन बितड़ान खिड़की माय रेन बुंदे उतार देना।<verse eid="ACT 9:25" /></para>
  <para style="s">यरूशलेम माय शाऊल</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26" />ओवतो शाऊल यरूशलेम माय आवो एने चेला हिऱ्यो बेचकाणेन कोसीत किऱ्यो। पुण आखा ताह बिताला, काहाकाय ताह बुरहो नाह एतालो काय ज्यो बी यीशुन चेलो हे। <verse eid="ACT 9:26" /><verse number="27" style="v" sid="ACT 9:27" />पुण बरनबास नावान चेलो शाऊलाह ता हिऱ्यो प्रेरिता फाय ली गीयो। एने ताह केयो काय ज्यो किहकेरीन दमिश्‍क ने वाटे मालीकाह दिख्यो, एने तो ज्या हिऱ्यो वातु किऱ्यो; एने यीशुन नावा माय दमिश्‍क माय ज्यो किहीक ईमोत केरीन पारचार किऱ्यो। <verse eid="ACT 9:27" /><verse number="28" style="v" sid="ACT 9:28" />एने शाऊल ता हिऱ्यो रिनो, एने यरूशलेम माय आवती जाते बिंदास एन मालीकान नावा माय पारचार केरने बाज गीयो। <verse eid="ACT 9:28" /><verse number="29" style="v" sid="ACT 9:29" />एने युनानी बाषा बोलनारे यहुदि हिऱ्यो वातु एने बोलचाल केरती रिनो; पुण ता शाऊलाह मार टाकणेन कोसीत केरने बाज गीया। <verse eid="ACT 9:29" /><verse number="30" style="v" sid="ACT 9:30" />ज्यो जाणीन विश्वासी बाहख ताह केसरीया माय लेन आवा, एने तरसुस माय मोकेल दिनो।<verse eid="ACT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31" />इहकेरीन आखा यहुदिया, एने गेलील एने सामरीया माय मोंडलीह सान्ती जुड़नी। एने तान उन्नती एते गियी, एने ती मालीकान बिय एने चोखाला जीवान उत्साह माय चालते एने वोदते गियी।<verse eid="ACT 9:31" /></para>
  <para style="s">लुद्दा एने याफा माय पतरस</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32" />एने इहकेरीन एनो काय पतरस आखी जागे फिरते लेन, ता बोगवानान माणहा फाय बी पोचनो, जा लुद्दा गावा माय रेताला। <verse eid="ACT 9:32" /><verse number="33" style="v" sid="ACT 9:33" />ताहरी ताह एनियास नावान लोखवान एक दुखाऱ्यो माणुह मिलनो, जो आठ वोरह्या रेन खाटला माय पोड़ रियेल ईतो। <verse eid="ACT 9:33" /><verse number="34" style="v" sid="ACT 9:34" />पतरस ताह केयो, “एय एनियास, यीशु मसी तुवाह हुदारेह। उठ, तारो आथरोण गुंडाल,” ओवतो तो चालुस उबरेय गीयो। <verse eid="ACT 9:34" /><verse number="35" style="v" sid="ACT 9:35" />तेवी लुद्दा एने शारोन गावा माय आखा रेणारे माणहे ताह देखीन मालीकान उगे वोलना।<verse eid="ACT 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36" />याफा माय तबीता नावान एक विश्वासी बायकु रेताली, जीन नाव ग्रीक माय दोरकास जान मतलब “मेंदड़ो।” ती जुलूम हाजा हाजा काम एने बेट केऱ्या केरताली। <verse eid="ACT 9:36" /><verse number="37" style="v" sid="ACT 9:37" />तास दिह्या माय ती दुखार्‍यी पोड़ीन मोर गियी; तेवी ता तीह उंगलावीन उपेरली खोलीम मेल देना। <verse eid="ACT 9:37" /><verse number="38" style="v" sid="ACT 9:38" />ज्यानकेरता काय लुद्दा गाव याफान आहने एतो, पतरस ताहरी हे इहकेरीन जुलबुखे विश्वासी होमल्या, तुलबूखे ता दुय जाणाह मोकलीन ताह विन्ता केऱ्या, “काय आमरी फाय आवणेन वार मा लागाड़े।” <verse eid="ACT 9:38" /><verse number="39" style="v" sid="ACT 9:39" />तेवी पतरस ता हिऱ्यो गीयो, पतरस ताहरी पोचतास ता ताह उपेरली खोलीम ली गीया। ता हेऱ्यो सोब रांडायेल बायकु रेड़तेन उब रेन्यु, एने जा चोगा एने फाड़का दोरकास ती हेऱ्यी रेते लेन बाणायेल एती, देखाड़ने बाज गियी। <verse eid="ACT 9:39" /><verse number="40" style="v" sid="ACT 9:40" />तेवी पतरस आखाह बाहेर निकाल दिनो, एने मांड्या वालीन विन्ता किऱ्यो एने देड़ान उगे देखीन केयो, “एय तबीता, उठ।” तेवी ती तीन डोला उगाड़ देनी; एने पतरसाह देखीन उठ बोहनी। <verse eid="ACT 9:40" /><verse number="41" style="v" sid="ACT 9:41" />ओवतो पतरस तीह ओंगाण आथ केरीन उठाड्यो, एने विश्वासी माणहाह एने रांडायल्युह हादिन त्युन सामने तीह जीवताली देखाड़ दिनो। <verse eid="ACT 9:41" /><verse number="42" style="v" sid="ACT 9:42" />ज्यी वात आखी याफा माय मालुम एय गियी; एने जुलूम जाणे मालीक पोर बुरहो केऱ्या। <verse eid="ACT 9:42" /><verse number="43" style="v" sid="ACT 9:43" />एने पतरस याफा माय शमोन नावान एक चामड़ान दोन्दो केरनारा फाय जुलूम दिह वोर रिनो।<verse eid="ACT 9:43" /></para>
  <chapter eid="ACT 9" />
  <chapter number="10" style="c" sid="ACT 10" />
  <para style="s">पतरस एने कुरनेलीयुस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1" />केसरीया गावा माय कुरनेलीयुस नावान एक माणुह एतो, “जो इटालीयन नावान सिपाय टोलान आदिकारी ईतो।” <verse eid="ACT 10:1" /><verse number="2" style="v" sid="ACT 10:2" />तो बोगवानाह बिणार बोक्त माणुह ईतो; तो एने तान आखा गेराणान माणहे बोगवानान बोक्ती केरताला। एने यहुदि माणहाह जुलूम दान आपतालो, एने लागातार बोगवानाह विन्ता केरतालो। <verse eid="ACT 10:2" /><verse number="3" style="v" sid="ACT 10:3" />तो दिह्या तीन वाचता हास केरीन देरसेन माय दिख्यो, काय बोगवानान एक हेरोगदुत ता फाय माय आवीन केयो, “एय कुरनेलीयुस!”<verse eid="ACT 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 10:4" />कुरनेलीयुस हेरोगदुताह हास केरीन दिख्यो, एने बियीन केयो, “एय मालीक काय हे?”</para>
  <para style="p" vid="ACT 10:4">हेरोगदुत ताह जापाप आप्यो, “तारी विन्ता एने दान देरेम तुवाह जापाप आपणेन केरता बोगवानान सामने पुचील हे। <verse eid="ACT 10:4" /><verse number="5" style="v" sid="ACT 10:5" />एने एवी याफा हेयरा माय माणहाह मोकलीन शमोनाह, जो पतरस केवाथे, ताह हादाड़ ले। <verse eid="ACT 10:5" /><verse number="6" style="v" sid="ACT 10:6" />तो चामड़ान दोन्दो केरनार शमोन फाय पावणो हे, तान गेर देरीयान दिड़े हे।” <verse eid="ACT 10:6" /><verse number="7" style="v" sid="ACT 10:7" />जेवी हेरोगदुत ता हिऱ्यो वातु केरीन जात रिनो, तेवी तो तान दुय चाकऱ्या जा तान आरही रेया केरताला, ताम रेन एक सिपायाह हाद्यो। <verse eid="ACT 10:7" /><verse number="8" style="v" sid="ACT 10:8" />एने ताह ज्‍यु सोब वातु केयीन याफा माय मुकल्यो।<verse eid="ACT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9" />दिहरे दिह जेवी ता चालते चालतेन याफा हेयरान आहने पोचना, तेवी पतरस बारा वाचता विन्ता केरनेन केरता गेरान साजा पोर चेड़नो। <verse eid="ACT 10:9" /><verse number="10" style="v" sid="ACT 10:10" />तुलबूखे पतरसाह बुख लागी एने तो काह खाणे होदतालो; पुण जेवी खाणो बोणने बाजरियेल एतो, तेवी पतरसाह देरसेन जुड़नो। <verse eid="ACT 10:10" /><verse number="11" style="v" sid="ACT 10:11" />तेवी पतरस दिख्यो काय जुग उगड़ी गीयो, एने एक चादरो मोटला ठामलान गेत चार कोपराम लेटकेल देरतीन उगे उतेरने बाजरिनोह। <verse eid="ACT 10:11" /><verse number="12" style="v" sid="ACT 10:12" />ता माय देरती पोर वाला आखी बातीन चार पायावाला जेनवारे, एने लोलनारे जेन्तु, एने जुगाम उड़नारे चीड़ा एता। <verse eid="ACT 10:12" /><verse number="13" style="v" sid="ACT 10:13" />एने ताह एक ओहलो आवाज होमलानो, “एय पतरस उठ; एने मारीन खा!”<verse eid="ACT 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 10:14" />पुण पतरस केयो, “नाह मालीक! केदिस नाह, काहाकाय मी केदी बी एगदी एठी एने खाराब चिज नाह खाईल सोतो।”<verse eid="ACT 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 10:15" />पोशो दिहरी वारीन पतरसाह आवाज होमलानो, “जाह बोगवान चोखो ठेरायेल हे, ताह तु एठो मा मानहे।” <verse eid="ACT 10:15" /><verse number="16" style="v" sid="ACT 10:16" />ओहलो तीन वार वोर एनो, तेवी चालोच तो चादरो जुगाम विसाय गीयो।<verse eid="ACT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17" />जेवी पतरस देरसेन दिख्यो तान बाराम आपणा मोनाम विचार केरने बाजरियेल ईतो काय ज्यान मतलब काय एय सिकेह, तेवी ता माणहे जाह कुरनेलीयुस मोकलेल एतो, शमोनान गेरान पुतो लागाड़ीन बायणा पोर आवीन उबरी गीया। <verse eid="ACT 10:17" /><verse number="18" style="v" sid="ACT 10:18" />एने आयड़ीन फुशा, “शमोन पतरस केतेह तो न्या पावणो ईतो, तो हे काय?”<verse eid="ACT 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 10:19" />
    <note caller="+" style="f">
      <char style="fr" closed="false">10:19 </char>
      <char style="ft" closed="false">तीन; थोड़ाक लेख माय थोड़ाक; थोड़ाक लेख माय दुय।</char>
    </note>पतरस ता देरसेनान बाराम विचार केरतालो तेवी चोखालो जीव ताह केयो, “देख, तीन माणहे तुवाह होदतेह। <verse eid="ACT 10:19" /><verse number="20" style="v" sid="ACT 10:20" />उठीन बुंदे उतेर, एने बिंदास ता हिऱ्यो जातरे, काहाकाय मीच ताह मोकलेल हे।” <verse eid="ACT 10:20" /><verse number="21" style="v" sid="ACT 10:21" />तेवी पतरस बुंदे उतरीन ता माणहाह केयो, “दिखो, जाह तुमू होदणे बाजरेनाह, तो मीच हे, तुमू न्या काय कामे आवाह?”<verse eid="ACT 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 10:22" />ता केया, “कुरनेलीयुस आदिकारी आमुह मोकलेल हे, जो देरमी एने बोगवानान बोक्ती केरनार माणुह हे, एने आखा यहुदि माणहाम रेन एने बोगवानान हेरोगदुता से खुबेर सापड़ायेल हे, काय तुवाह गेर हादिन ज्यी खुबेर होमले।” <verse eid="ACT 10:22" /><verse number="23" style="v" sid="ACT 10:23" />तेवी पतरस ताह गेरा माय हादिन पावणाय किऱ्यो।</para>
  <para style="p" vid="ACT 10:23">एने दिहरे दिह पतरस ता हिऱ्यो गीयो; एने याफा हेयरावाला बायाख माय रेन थोड़ाक विश्वासी ता हेऱ्या गीया।<verse eid="ACT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 10:24" />दिहरे दिह ता केसरीया माय पोचना, तेवी कुरनेलीयुस एने तान गेरल्या, एने तान आहेंल्या हाती टोलवाएन तान वाट जोवणे बाजरियेल एता। <verse eid="ACT 10:24" /><verse number="25" style="v" sid="ACT 10:25" />जेवी पतरस गेरा माय आवणे बाजरियेल ईतो, तेवी कुरनेलीयुस तान हुम्बो गीयो, एने पतरसान पाया पोड़ीन ताह वोंद्यो। <verse eid="ACT 10:25" /><verse number="26" style="v" sid="ACT 10:26" />पुण पतरस ताह उठाड़ीन केयो, “उबरी, मी बी ते माणुहच हे।” <verse eid="ACT 10:26" /><verse number="27" style="v" sid="ACT 10:27" />ओवतो पतरस कुरनेलीयुस हिऱ्यो वातु केरती लेन गेरा माय गीयो, एने पतरस जुलूम होवटा माणहाह टोलवायेल वाट जोवताला देखीन, <verse eid="ACT 10:27" /><verse number="28" style="v" sid="ACT 10:28" />ताह केयो, “तुमू जाणतेह काय बिगेर यहुदि माणहा हेऱ्या ओलखात मेलने, एने ता फाय जाणे यहुदि माणहान केरता पाप हे। पुण बोगवान माहु कियेल हे काय काल्ला बी माणहाह एठो एने खाराब मा किहे। <verse eid="ACT 10:28" /><verse number="29" style="v" sid="ACT 10:29" />केरीन माहु हादाड़ता बाराबोर मी कायच नाह फुसता, एने मी न्या आव लागो, एवी मी फुसथो काय माहु काय कामे हादाड्या?”<verse eid="ACT 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 10:30" />
    <note caller="+" style="f">
      <char style="fr" closed="false">10:30 </char>
      <char style="ft" closed="false">विन्ता; थोड़ाक लेख माय उपास एने विन्ता हे। </char>
    </note>तेवी कुरनेलीयुस ताह केयो, “आज रेन तीन दिह्यान पेल, मी मार गेर हिराणान तीन वाचता विन्ता केरने बाजरियेल ईतो, तेवी चोमेकण्या फाड़का पिरील एक माणुह मार सामने आवीन उबरेय गीयो। एने माहु केयो, <verse eid="ACT 10:30" /><verse number="31" style="v" sid="ACT 10:31" />‘एय कुरनेलीयुस! तारी विन्ता बोगवान होमेल लियेल हे, एने तु जो गेरब्याह दान देरेम किरेल तो एर केराय जायेल हे। <verse eid="ACT 10:31" /><verse number="32" style="v" sid="ACT 10:32" />तानकेरता याफा माय कुणीह बी मोकलीन शमोन जाह पतरस केतेह ताह हादिन लाव तो देरीयान दिड़े चामड़ान दोन्दो केरनार शिमोन चामारान गेर पावणो हे।’ <verse eid="ACT 10:32" /><verse number="33" style="v" sid="ACT 10:33" />तेवी चालोच मी तुवाह हादणे मुकल्यो, एने हाजो केऱ्यो तु आव लागो। एने एवी बोगवान जो तुवाह बोलनेन केरता कियेल हे, तो होमेलनेन केरता आखा न्या बोगवानान सामने आव रेनाह।”<verse eid="ACT 10:33" /></para>
  <para style="s">पतरसान हिकवोण</para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34" />तेवी पतरस केयो, “एवी माहु खेरीच मालुम एय गीयो काय बोगवान कुणीन बी बेदबाव नाह केरने। <verse eid="ACT 10:34" /><verse number="35" style="v" sid="ACT 10:35" />पुण आखा देसान माणहा माय रेन जो कुण बोगवानाह बिथे, एने हाजो काम केरतेह, तो ताह पुटीह। <verse eid="ACT 10:35" /><verse number="36" style="v" sid="ACT 10:36" />जो वचन तो इस्राएल माणहा फाय मुकल्यो, यीशु मसी जो आखान मालीक हे, तान द्‍वारे सान्तीन हाजाली खुबेर होमलाड्यो। <verse eid="ACT 10:36" /><verse number="37" style="v" sid="ACT 10:37" />तुमू ती मोटली गेटनाह जाणतेह, जी आखा इस्राएलान बुई पोर गेटेल एती, ती गेलील माय सुरवात एन योहानान द्‍वारे बपतीस्मा आपणेन पासाण रेन जान पारचार केराय जायेल एतो। <verse eid="ACT 10:37" /><verse number="38" style="v" sid="ACT 10:38" />तुमू यीशु नासरीन बाराम जाणतेह बोगवान चोखाला जीवान ताकेत रोचवेल ईतो, एने यीशु हाजाला कामे केरतीन एने ता आखाह जा सैतानान ताबा माय एता ताह हुदारतेन चार चोमखीर किहीक फिरतालो, काहाकाय बोगवान ता हिऱ्यो ईतो। <verse eid="ACT 10:38" /><verse number="39" style="v" sid="ACT 10:39" />एने आमु ता आखा कामान गोवा हेते, जो यीशु इस्राएल देसा माय एने यरूशलेम माय बी किऱ्यो, एने ता ताह खुरूसखाम पोर टागीन मार टाक्या। <verse eid="ACT 10:39" /><verse number="40" style="v" sid="ACT 10:40" />पुण बोगवान ताह तीसरे दिह जीवाड्यो, एने देखाड़ी बी दिनो। <verse eid="ACT 10:40" /><verse number="41" style="v" sid="ACT 10:41" />आखा माणहाह नाह, पुण ता गोवाह जाह बोगवान पेलुच रेन निवाड़ लियेल ईतो, मतलब आमुह जा तान मुरेल माय रेन जीव उठणेन पासाण ता हेऱ्या खाईल पियेल हेते। <verse eid="ACT 10:41" /><verse number="42" style="v" sid="ACT 10:42" />एने तो आमुह उकुम आपेल हे काय माणहा माय पारचार किरो, एने गोवाय दिवो काय ज्यो तोच हे, जाह बोगवान जीवताला एने मुरेल माणहान नियाव केरनार ठेरायेल हे। <verse eid="ACT 10:42" /><verse number="43" style="v" sid="ACT 10:43" />तान बाराम आखा जाणाव केरनार गोवाय देतेह काय जो कुण बी ता पोर बुरहो केरी, ताह यीशु नावान ताकेत माय पापान माफी जुड़ी।”<verse eid="ACT 10:43" /></para>
  <para style="s">बिगेर यहुदि माणहा पोर चोखालो जीव उतेरने</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44" />पतरस ज्यी वातु केताच, चोखालो जीव वचन होमेलनारा आखा पोर उतेरनो। <verse eid="ACT 10:44" /><verse number="45" style="v" sid="ACT 10:45" />एने जोला याफा माय रेन यहुदि विश्वासी माणहे पतरस हेऱ्या आयेल एता, ता बिगेर यहुदि माणहाह बी चोखाला जीवान दान ता पोर रोचवाय जायेल हे, ज्यो देखीन ता आखा बोंगलाय गीया। <verse eid="ACT 10:45" /><verse number="46" style="v" sid="ACT 10:46" />काहाकाय ता आखा माणहाह बात बातीन बाषा बोलताला एने बोगवानान बोक्ती केरताला होमल्या। तेवी पतरस केयो, <verse eid="ACT 10:46" /><verse number="47" style="v" sid="ACT 10:47" />“आपुह जिहकेरीन चोखालो जीव जुड़ेल एतो, तिहेच केरीन न्याह बी जुड़ेल हे, ते काय न्याह पाण्या केरीन बपतीस्मा लेणेन केरता एगदो रोक सेकी?” <verse eid="ACT 10:47" /><verse number="48" style="v" sid="ACT 10:48" />एने तो उकुम आप्यो काय ताह यीशु मसीन नावा माय बपतीस्मा आपाय जाय। तेवी ता पतरसाह केया आमु हिऱ्यो उंजु थोड़ाक दिह रे।<verse eid="ACT 10:48" /></para>
  <chapter eid="ACT 10" />
  <chapter number="11" style="c" sid="ACT 11" />
  <para style="s">पतरस यरूशलेम ने मोंडलीह तान कामान बाराम केणे</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1" />ओवता प्रेरित एने विश्वासी बाहख जा यहुदिया माय एता, होमल्या काय बिगेर यहुदि बी बोगवानान वचन मान लियेल हेते। <verse eid="ACT 11:1" /><verse number="2" style="v" sid="ACT 11:2" />एने जेवी पतरस यरूशलेम माय आवो, ते खेतना केरायेल यहुदि विश्वासी माणहे तान चिहटा केरने बाज गीया, <verse eid="ACT 11:2" /><verse number="3" style="v" sid="ACT 11:3" />“तु खेतना नाह ईयेल बिगेर यहुदि माणहान गेर जाईन ता हिऱ्यो रिनो, एने खादो पिदो।” <verse eid="ACT 11:3" /><verse number="4" style="v" sid="ACT 11:4" />तेवी पतरस ताह सुरवात रेन जो जो ईयेल तो आखो आरवेल केय होमलाव्यो।<verse eid="ACT 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 11:5" />“मी याफा हेयरा माय विन्ता केरतालो, एने देरसेन दिख्यो काय एक चादरो मोटला ठामलान गेत चार खुणे रेन लेटकेल जुगाम रेन उतरीन मार फाय आवो। <verse eid="ACT 11:5" /><verse number="6" style="v" sid="ACT 11:6" />एने जेवी मी ताह हास केरीन दिख्यो, ते ता माय पालनारे देरतीन चार पायावाला जेनवारे एने जेंगली जेनवारे एने लोलनारे जेन्तु, एने जुगान चीड़ाह दिख्यो। <verse eid="ACT 11:6" /><verse number="7" style="v" sid="ACT 11:7" />एने मी इहकेरीन आवाज मार हिऱ्यो बोलतालो होमल्यो, ‘पतरस, उठ; मारीन खा!’ <verse eid="ACT 11:7" /><verse number="8" style="v" sid="ACT 11:8" />पुण मी केयो, ‘नाह मालीक, नाह; काहाकाय काल्ली बी एठी एने खाराब चिज मार मुया माय केदी नाह गियी।’ <verse eid="ACT 11:8" /><verse number="9" style="v" sid="ACT 11:9" />पुण दिहरी वार जुगाम रेन एक आवाज होमलानो, ‘जाह बोगवान चोखो ठेरायेल हे, ताह एठो मा मानहे।’ <verse eid="ACT 11:9" /><verse number="10" style="v" sid="ACT 11:10" />तीन वार ओहलोच एनो; तेवी आखो काय पोशो जुगा माय खेचाय गीयो। <verse eid="ACT 11:10" /><verse number="11" style="v" sid="ACT 11:11" /><note caller="+" style="f"><char style="fr" closed="false">11:11 </char><char style="ft" closed="false">मी ईतो; थोड़ाक लेख माय आमु एता लिखेल हे।</char></note>एने दिखो, जा गेराम आमु एता ता गेरान ओंगाण केसरीया रेन मार फाय मोकलायेल तीन माणहे आवीन उबरियेल एता। <verse eid="ACT 11:11" /><verse number="12" style="v" sid="ACT 11:12" />तेवी जीव माहु केयो काय कायच विचार नाह केरता ता हिऱ्यो जा। ओवता ज्या सोव विश्वासी बाहख बी मार हेऱ्या आवा, एने आमु ता कुरनेलीयुस माणहान गेर जायेल। <verse eid="ACT 11:12" /><verse number="13" style="v" sid="ACT 11:13" />एने कुरनेलीयुस केयो काय मी मार गेरा माय एक हेरोगदुत उबरियेल दिख्यो, तो माहु केयो, ‘याफा हेयरा माय एगदाह मोकलीन शिमोनाह जो पतरस केवाथे, हादाड़ ले। <verse eid="ACT 11:13" /><verse number="14" style="v" sid="ACT 11:14" />तो तुवाह ओहल्यु वातु केय जान द्‍वारा तारो एने तारा आखा कुटूमान सुटकारो एय।’ <verse eid="ACT 11:14" /><verse number="15" style="v" sid="ACT 11:15" />जेवी मी वातु केरने बाज गीयो, ते चोखालो जीव ता पोर तिहेच केरीन उतेरनो, जिहकेरीन सुरवात माय आपु पोर उतरेल एतो। <verse eid="ACT 11:15" /><verse number="16" style="v" sid="ACT 11:16" /><note caller="+" style="x"><char style="xo" closed="false">11:16 </char><char style="xt" closed="false"><ref loc="ACT 1:5">प्रेरितान काम 1:5</ref></char></note>तेवी मालीक कियेल वात माहु एर आवी; ती इहकेरीन काय, ‘योहान ते पाण्या केरीन बपतीस्मा केरी ज्यो खेरी हे; पुण तुमरो बपतीस्मा चोखाला जीवा केरीन एय।’ <verse eid="ACT 11:16" /><verse number="17" style="v" sid="ACT 11:17" />जेवी बोगवान बिगेर यहुदिह बी तोच दान आप्यो, जो आमुह मालीक यीशु मसी पोर बुरहो केरने से जुड़ेल ईतो; ते मी कुण ईतो जो बोगवानाह रोक सेकतालो!”<verse eid="ACT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 11:18" />ज्यो होमलीन ता आखा चिहटा केरनेन केरता बोंद केरीन बोगवानान बोड़ाय केरतीन केया, “ताहार ते बोगवान बिगेर यहुदिह बी जीवाय जुड़ी केरीन मोन बोदेलनेन इकेल आपेल हे!”<verse eid="ACT 11:18" /></para>
  <para style="s">अन्‍ताकियान मोंडली</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">11:19 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 8:1-4">प्रेरितान काम 8:1-4</ref>
      </char>
    </note>विश्वासी माय रेन थोड़ाक माणहे ती तेकलीत ने वोजेसे जी स्तिफनुसान मोतीन वोजेसे ईयेल एती, जोत तोथा वेराय जायेल एता, ता फिरते फिरतेन फीनीके एने साइप्रस, एने अन्‍ताकिया माय पोचना, पुण यहुदि माणहाह सोड़ीन दिहरा कुणीह बी वचन नाह केताला। <verse eid="ACT 11:19" /><verse number="20" style="v" sid="ACT 11:20" />पुण ता माय रेन थोड़ाक माणहे साइप्रसवाला एने कुरेनी एता, जा अन्‍ताकिया माय आवीन बिगेर यहुदिह<note caller="+" style="f"><char style="fr" closed="false">11:20 </char><char style="fq" closed="false">बिगेर यहुदिह </char><char style="ft" closed="false">थोड़ाक लेख माय युनानी बाषा बोलनारे यहुदि माणहे</char></note> बी मालीक यीशुन हाजाली खोबरीन वातु केणे बाज गीया। <verse eid="ACT 11:20" /><verse number="21" style="v" sid="ACT 11:21" />तेवी मालीकान ताकेत ता हेऱ्यी एती, एने जुलूम माणहे बुरहो केरीन मालीका निही वोलना।<verse eid="ACT 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 11:22" />जेवी तान चेरचा यरूशलेमान मोंडलीह होमलाणेम आवी, ते ता बरनबासाह अन्‍ताकिया माय मोकल्या। <verse eid="ACT 11:22" /><verse number="23" style="v" sid="ACT 11:23" />जेवी बरनबास ताहरी पोचीन माणहाह दिख्यो काय बोगवान ताह किहीक गीण आपेल हे खुस एय गीयो, एने आखाह विन्ता किऱ्यो काय तुमरा पुरा मोना केरीन खेरलाम एने मालीका हेऱ्या विश्वासयोग्य रिवो। <verse eid="ACT 11:23" /><verse number="24" style="v" sid="ACT 11:24" />काहाकाय बरनबास एक हाजो माणुह ईतो, एने चोखाला जीवा केरीन एने बोरहा माय पाको ईतो; एने दिहरा जुलूम होवटा माणहे मालीकान बोरहाम आव मिलना।<verse eid="ACT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25" />तेवी बरनबास शाऊलाह होदणेन केरता तरसुस हेयरा माय जात रिनो। <verse eid="ACT 11:25" /><verse number="26" style="v" sid="ACT 11:26" />एने जेवी बरनबास शाऊलाह मिलनो ते ताह अन्‍ताकिया माय लावो, एने इहकेरीन एनो काय ता दुयू ताहरी एक वोरीह वोर मोंडली माय ईलीमिलीन जुलूम होवटा माणहाह हिकाड्या, एने चेलाह मसी ज्यो नाव पेल्‍ली वार अन्ताकियाम जुड़नो।<verse eid="ACT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27" />तास दिह्या माय यरूशलेम रेन थोड़ाक जाणाव केरनारे अन्ताकियाम आवा। <verse eid="ACT 11:27" /><verse number="28" style="v" sid="ACT 11:28" /><note caller="+" style="x"><char style="xo" closed="false">11:28 </char><char style="xt" closed="false"><ref loc="ACT 21:10">प्रेरितान काम 21:10</ref></char></note>तेवी ता माय रेन अगबुस नावान एक माणुह उठीन जीवान ताकेत माय ज्यो जाणाव किऱ्यो काय आखी दुनिया माय मोटलो काल पोड़न्यो हे। ज्यो काल क्‍लोदियास ने राज केरनेन टेम माय पोड़नो। <verse eid="ACT 11:28" /><verse number="29" style="v" sid="ACT 11:29" />तेवी चेला निर्णय केऱ्या काय यहुदिया माय रेणारे विश्वासी बायाख ने मोदेक ने केरता आपुह पुरवाय तोलो दान मोकली। <verse eid="ACT 11:29" /><verse number="30" style="v" sid="ACT 11:30" />एने ता तिहेच केरीन केऱ्या, एने बरनबास एने शाऊलान आथाम यरूशलेम ने मोंडलीन डायडाया फाय ता पोयशा मोकली देना।<verse eid="ACT 11:30" /></para>
  <chapter eid="ACT 11" />
  <chapter number="12" style="c" sid="ACT 12" />
  <para style="s">होवटी तेकलीत</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1" />
    <note caller="+" style="f">
      <char style="fr" closed="false">12:1 </char>
      <char style="ft" closed="false">हेरोदेस राजा, अग्रीपा; आखा फलिस्तीन देसान आदिकारी।</char>
    </note>ती टेम हेरोद राजा मोंडलीन थोड़ाक मेहमेराह सेतावणेन सुरवात किऱ्यो। <verse eid="ACT 12:1" /><verse number="2" style="v" sid="ACT 12:2" />तो योहानान बाहख याकुबाह तालवार केरीन माराव टाक्‍यो। <verse eid="ACT 12:2" /><verse number="3" style="v" sid="ACT 12:3" />जेवी हेरोद दिख्यो काय यहुदि माणहे इहकेरीन खुस एतेह, ते तो पतरसाह बी देर लिदो। एने ता दिह बिगेर खमीर रोटान तिवारान दिह एता। <verse eid="ACT 12:3" /><verse number="4" style="v" sid="ACT 12:4" />एने तो पतरसाह देरीन जेली माय टाक दिनो, एने राखवाली केरनेन केरता चार चार सिपायड़ान चार टोला बाणावीन मिल्यो, ज्यी विचार से काय फसहान पासाण पतरसाह माणहान सामने लावे। <verse eid="ACT 12:4" /><verse number="5" style="v" sid="ACT 12:5" />जेली माय पतरस कोंडायेल ईतो, पुण मोंडलीन माणहे तान केरता एक एयीन बोगवानाह विन्ता केरताला।<verse eid="ACT 12:5" /></para>
  <para style="s">पतरसान जेली माय रेन सुटणो</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6" />एने जेवी हेरोद पतरसाह माणहान सामने लावण्यो ईतो, तीस राती पतरस दुय हाकुल केरीन बांदायेल दुय सिपायड़ान विची माय हुवतालो। एने देखरेत केरनारे बायणान सामने जेलीन राखवाली केरताला। <verse eid="ACT 12:6" /><verse number="7" style="v" sid="ACT 12:7" />ते दिखो, मालीकान एक हेरोगदुत पतरसा हिऱ्यो आवीन उबरी गीयो, एने खोलीम उजेड़ चोमेकनो, एने तो पतरसान पाहली पोर आथ ठोकीन ताह जागाड्यो एने केयो, “उठ, उतवाल केर!” एने पतरसान आथाम रेन हाकुल निकलीन जाय पोड़नी। <verse eid="ACT 12:7" /><verse number="8" style="v" sid="ACT 12:8" />तेवी हेरोगदुत पतरसाह केयो, “कोमेर बांद एने तारा खाहड़ा पायाम पिर ले।” तो तिहेच किऱ्यो। पोशो तो केयो, “तु तारा फाड़का पेरीन मार पासाण आव।” <verse eid="ACT 12:8" /><verse number="9" style="v" sid="ACT 12:9" />पतरस जेलीम रेन निकलीन तान पासाण बाहेर आवो, पुण ज्यो नाह जाणतालो काय जो काय हेरोगदुत केरने बाजरिनोह तो खेरी हे, पुण ज्यो सोमज्यो काय मी देरसेन देखणे बाजरिनोह। <verse eid="ACT 12:9" /><verse number="10" style="v" sid="ACT 12:10" />एने जेवी ता पेल्लो एने दिहरो पाहरे रेन निकलीन लोड़ान ता फाटेक पोर आवा, जो हेयरान निही जाथे, ते फाटेक तान केरता आप आप उगेड़ गीयो। एने ता बाहेर निकलीन एक गेली माय रेन जाणे बाजरियेल एता, तेवी चालोच हेरोगदुत पतरसाह सोड़ीन जात रिनो। <figure style="fig" alt="Chains embedded in prison wall" file="hk00204c.tif" size="col" copy="Horace Knowles ©" ref="12:7">जेलीन बितड़ा पोर हाकोल ठोकेल</figure><verse eid="ACT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11" />तेवी पतरस बोंगलायीन केयो, “एवी मी खेरीच जाण जायेल हे काय मालीक तान हेरोगदुत मोकलीन माहु हेरोद राजान ताकेत माय रेन, एने यहुदि माणहे जो बी होदताला, तान आसा से सोड़ीव लिदो।”<verse eid="ACT 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 12:12" />जेवी पतरसाह ज्यी वात सोमेज माय आव गियी, तेवी पतरस योहानान आहख मरीयम ने गेर आवो, जो मरकुस बी केवाथे, ताहरी जुलूम माणहे एकठा टोलवाएन विन्ता केरने बाजरियेल एता। <verse eid="ACT 12:12" /><verse number="13" style="v" sid="ACT 12:13" />जेवी पतरस बाहेर ने बायणान केड़ीह ठोक्‍यो, ते रूदा नावान एक पावेरनी बायणो उगाड़नेन केरता आवी। <verse eid="ACT 12:13" /><verse number="14" style="v" sid="ACT 12:14" />एने ती पतरसान आवाज ओलखी लेदी, पुण तीह जुलूम खुसी लागनी केरीन बायणो नाह उगाड़ी, एने माय दोवेड़ते जाईन ती केयी काय पतरस बायणा हिऱ्यो उबरिनोह। <verse eid="ACT 12:14" /><verse number="15" style="v" sid="ACT 12:15" />ता तीह केया, “तु गांडी हे।” पुण ती ईमोत केरीन केयी काय इहीचकेरीन केरीन हे। तेवी ता केया, “तान हेरोगदुत एय।”<verse eid="ACT 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 12:16" />पुण पतरस ठोकतेस रिनो एने जेवी ता बायणो उगाड्या, ते ताह देखीन बोंगलाय गीया। <verse eid="ACT 12:16" /><verse number="17" style="v" sid="ACT 12:17" />तेवी पतरस ताह आथा केरीन ईसारो किऱ्यो काय ठावका रिवो, एने ताह केयो काय मालीक किहकेरीन माहु जेलीम रेन बाहेर निकलील। एने पोशो पतरस ताह केयो, “याकुब एने बायाख ज्यी आखी वात केय दिज्यो।” तेवी तो गेराम रेन निकलीन दिहरे जागे जात रिनो।<verse eid="ACT 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18" />ज्यो वेगोच एनो, सिपाया माय मोटली उकात उड़नी काय पतरस गीयो ते का गीयो? <verse eid="ACT 12:18" /><verse number="19" style="v" sid="ACT 12:19" />जेवी हेरोदेस राजा पतरसाह होदणेन आदेस आप्यो, एने नाह ताह सापेड़नो। तानकेरता तो देखरेत केरनारान चोकसी केरीन ताह मार टाकणेन उकुम आप्यो।</para>
  <para style="p" vid="ACT 12:19">एने तो यहुदियाह सोड़ीन केसरीया माय जाईन थोड़ाक दिह वोर रिनो।<verse eid="ACT 12:19" /></para>
  <para style="s">हेरोदेसान मोरनो</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20" />हेरोद राजा सुर एने सेदान माणहा हिऱ्यो जुलूम ना खुस ईतो। तानकेरता ता एकी केरीन ता फाय आवा, एने बलास्तुसाह जो राजान किल्लान मुखी ईतो, पोटाड़ीन बेचकेणे होद्या काय तान मोदेक केरी, एने राजा फाय जाईन सान्तीन मेल केरी। काहाकाय राजान देसाम रेन तान देसाह खाणेन वोस्तु आपाय जाताली।<verse eid="ACT 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 12:21" />ठेरायेल दिह हेरोद राजान फाड़का पेरीन राजगादि पोर बुठो, एने टोलवायेल माणहान ओंगाण बासेण देणे बाज गीयो। <verse eid="ACT 12:21" /><verse number="22" style="v" sid="ACT 12:22" />तेवी माणहे आयड़ी उठना, “ज्यो ते माणहान नाह, पुण बोगवानान आवाज हे।” <verse eid="ACT 12:22" /><verse number="23" style="v" sid="ACT 12:23" />पुण तुलेचबूखी मालीकान एक हेरोगदुत हेरोदेस राजाह दिनो, काहाकाय तो बोगवानान बोड़ाय नाह किऱ्यो। एने तान सेरीर माय किड़ा पोड़ीन ताह खाणे बाज गीया, एने तो मोर गीयो।<verse eid="ACT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24" />पुण बोगवानान वचन वोदते एने पोसेरते गीयो।<verse eid="ACT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 12:25" />
    <note caller="+" style="f">
      <char style="fr" closed="false">12:25 </char>
      <char style="ft" closed="false">रेन; थोड़ाक लेख माय ने</char>
    </note>जेवी बरनबास एने शाऊल यरूशलेम माय तान सेवा पुरी केरीन अन्‍ताकिया माय पोशा वोलीन योहान जो मरकुस केवाथे लेन आवा।<verse eid="ACT 12:25" /></para>
  <chapter eid="ACT 12" />
  <chapter number="13" style="c" sid="ACT 13" />
  <para style="s">बरनबास एने शाऊलाह निवाड़नो एने मोकेलनो</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1" />
    <note caller="+" style="f">
      <char style="fr" closed="false">13:1 </char>
      <char style="ft" closed="false">हेरोदेस; हेरोदेस अंतीपास; गेलील देसान आदिकारी (देखी लुका 3:1।)</char>
    </note>अन्‍ताकियान मोंडली माय थोड़ाक जाणाव केरनार एने मास्तेर्‍या एता: जिहकेरीन बरनबास, शिमोन जाह नीगर केताला; एने लुकियुस जो कुरेनी मायवालो हे, एने मनाहेम जान पालेन पोषण राजा हेरोद हेऱ्यो ईयेल एतो, एने शाऊल। <verse eid="ACT 13:1" /><verse number="2" style="v" sid="ACT 13:2" />जेवी ता उपास देरीन मालीकान सेवा केरने बाजरियेल एता, तेवी चोखालो जीव केयो, “मार केरता बरनबास एने शाऊलाह ता कामान केरता आलेग किऱ्यो ज्यानकेरता मी ताह हादेल हे।”<verse eid="ACT 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 13:3" />तेवी ता उपास एने विन्ता केरीन एने ता पोर आथ मेलीन ताह वोलाव देना।<verse eid="ACT 13:3" /></para>
  <para style="s">साइप्रस माय बरनबास एने शाऊल</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4" />चोखाला जीवान द्‍वारे तान वोलावणो एणेन बाद बरनबास एने शाऊल सीलुकीया माय गीया, एने ता रेन डोंडह्या माय बोहीन साइप्रस गीया। <verse eid="ACT 13:4" /><verse number="5" style="v" sid="ACT 13:5" />एने सलमीस माय पोचीन, ता यहुदिन बोक्ती केरन्या गेरा माय बोगवानान वचनान पारचार केरने सुरवात केऱ्या। एने योहान मरकुस तान मोदेक ने रूप माय ईतो। <figure style="fig" alt="Front view of a synagogue" file="lb00246c.tif" size="col" copy="Horace Knowles ©" ref="13:5">यहुदिन बोक्ती केरनेन गेर</figure><verse eid="ACT 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6" />एने जेवी ता आखा टापु माय रेन चालीन पाफुस वोर पोचना, ताहरी ताह बार यीशु नावान एक यहुदि जादुगार जुठो जाणकार मिलानो। <verse eid="ACT 13:6" /><verse number="7" style="v" sid="ACT 13:7" />तो आदिकारी सीरगीयुस पौलुसान जोड़ीदार ईतो, जो एकेलदार एदमी ईतो। आदिकारी बरनबास एने शाऊलाह ता फाय हादिन बोगवानान वचन होमेलने होद्यो। <verse eid="ACT 13:7" /><verse number="8" style="v" sid="ACT 13:8" />पुण एलीमास जादुगार (तान नावान मतलब ग्रीक माय ज्योच हे।) तान विरोद केरीन आदिकारीह बुरहो केरने से रोकणे होद्यो। <verse eid="ACT 13:8" /><verse number="9" style="v" sid="ACT 13:9" />तेवी शाऊल जो पौलुस बी केवाथे; तो चोखाला जीवा केरीन पुरो एन एलीमास जादुगर ने उगे हास केरीन देखते लेन केयो, <verse eid="ACT 13:9" /><verse number="10" style="v" sid="ACT 13:10" />“एय आखा कोपेट एने आखी लुच्‍चाय माय बोरायेल बुतड़ान सोरा! तु जो आखा देरमान दुसमोन। एने मालीकान खेरायीह वाकड़ी केरनेन नाय सोड़हे! <verse eid="ACT 13:10" /><verse number="11" style="v" sid="ACT 13:11" />एवी देख, मालीकान आथ तार विरोद माय हे; एने तु थोड़ीक टेम वोर आंदलो रिहे एने दिह्यान उजालाह नाय दिखहे।”</para>
  <para style="p" vid="ACT 13:11">तेवी चालोच आदारी एने आदारो तान डोला पोर सावाय गीयो, एने तो न्या पोला सापेलने बाज गीयो काय एगदो तान आथ देरीन ली चाली। <verse eid="ACT 13:11" /><verse number="12" style="v" sid="ACT 13:12" />तेवी जो काय ईयेल एतो तो देखीन आदिकारी मालीकान हिकवोण पोर रेन बोंगलायीन बुरहो किऱ्यो।<verse eid="ACT 13:12" /></para>
  <para style="s">पिसीदियान अन्‍ताकिया माय पौलुसान पारचार</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13" />पौलुस एने तान हाती पाफुस रेन डोंडह्या माय बोहीन पंफुलीयान पिरगा हेयरा माय आवा, एने योहान ताह सोड़ीन यरूशलेम माय जात रिनो। <verse eid="ACT 13:13" /><verse number="14" style="v" sid="ACT 13:14" />ओवता ता पिरगा हेयरा माय रेन निकलीन फिरते फिरतेन पिसीदियान अन्‍ताकिया माय पोचना, एने विहेवणेन दिह यहुदिन बोक्ती केरन्या गेरा माय जाईन बोह गीया। <verse eid="ACT 13:14" /><verse number="15" style="v" sid="ACT 13:15" />मुसान नेम एने जाणाव केरनारान पुस्तेक माय रेन वाचणेन पासाण यहुदिन बोक्ती केरन्या गेरान आदिकारी ता फाय केय मोकल्या, “एय बाहख, आमु ज्यो होदतेह काय केदी तुमरी फाय माणहाह उत्साह केरनेन केरता काह वात एय ते किवो।” <verse eid="ACT 13:15" /><verse number="16" style="v" sid="ACT 13:16" />तेवी पौलुस उबरीन एने आथा केरीन इसारो केरीन केयो,</para>
  <para style="p" vid="ACT 13:16">“एय इस्राएली एने आखा बिगेर यहुदि बोगवानान बोक्ती केरनारे, मार हुमलो! <verse eid="ACT 13:16" /><verse number="17" style="v" sid="ACT 13:17" />ज्या इस्राएल माणहान बोगवान आमरा डायडायाह निवाड़ लिदो, एने जेवी ता माणहे मीस्र देसा माय पाराया बोणीन रेताला, तेवी तान बोड़ती किऱ्यो। एने मोटली ताकेत केरीन ताह मीस्र देसा माय रेन निकाल लावो, <verse eid="ACT 13:17" /><verse number="18" style="v" sid="ACT 13:18" /><note caller="+" style="f"><char style="fr" closed="false">13:18 </char><char style="ft" closed="false">तो वेठती रिनो; थोड़ाक लेख माय तो खुद ने देख बाल किऱ्यो।</char></note>एने तो कोमीत कोमी चालीह वोरह्या वोर उजाड़ी माय तान वेठते रिनो। <verse eid="ACT 13:18" /><verse number="19" style="v" sid="ACT 13:19" />एने कनान देसा माय तो हात राष्ट्राह खेतेम केर दिनो, तेवी बोगवान ती बुयीह इस्राएलान माणहाह तान आदिकार माय वाट दिनो। <verse eid="ACT 13:19" /><verse number="20" style="v" sid="ACT 13:20" /><note caller="+" style="f"><char style="fr" closed="false">13:20 </char><char style="ft" closed="false">ज्यो सोब एणेन केरीन कोम से कोम 450 वोरह्या लागाह; ज्यान पासाण; नाहते कोमीत कोमी 450 वोरह्यान पासाण </char></note>एने ज्यो आखो केरने माय कोमीत कोमी साड़े चार होव वोरह्या लागा।”</para>
  <para style="p" vid="ACT 13:20">तान बाद तो शमुएल जाणाव केरनारान टेम वोर ता माय नियाव केरनार ठेरावीन आप्यो। <verse eid="ACT 13:20" /><verse number="21" style="v" sid="ACT 13:21" />ओवता ता एक राजान मांग केऱ्या, तेवी बोगवान बिन्यामीन वोच माय रेन किशान बिटोख शाऊलाह चालीह वोरह्या वोर तान राजा ठेरायो। <verse eid="ACT 13:21" /><verse number="22" style="v" sid="ACT 13:22" />ओवता ताह आलेग केरीन दाऊदाह तान राजा बाणायो; जान बाराम बोगवान गोवाय दिनो, “माहु एक माणुह यीशेन बिटोख दाऊद मार मोनान गेत जुड़ जायेल हे; तोच मारी आखी मोरजी पुरी केरी।” <verse eid="ACT 13:22" /><verse number="23" style="v" sid="ACT 13:23" />एने दाऊदान वोच माय रेन बोगवान तान वायदान गेत इस्राएल फाय एक सोड़ेवणार, मतलब यीशुह मोकल्यो। <verse eid="ACT 13:23" /><verse number="24" style="v" sid="ACT 13:24" /><note caller="+" style="x"><char style="xo" closed="false">13:24 </char><char style="xt" closed="false"><ref loc="MRK 1:4">मरकुस 1:4</ref>; <ref loc="LUK 3:3">लुका 3:3</ref></char></note>यीशु तान कामाह सुरवात केरनेन पेल, योहान बपतीस्मा आपणार इस्राएलान आखा माणहान केरता पापा माय रेन मोन फिरावणेन केरता बपतीस्मान पारचार किऱ्यो। <verse eid="ACT 13:24" /><verse number="25" style="v" sid="ACT 13:25" /><note caller="+" style="x"><char style="xo" closed="false">13:25 </char><char style="xt" closed="false"><ref loc="JHN 1:20">योहान 1:20</ref>; </char><char style="xt" closed="false"><ref loc="MAT 3:11">मत्ती 3:11</ref>; <ref loc="MRK 1:7">मरकुस 1:7</ref>; <ref loc="LUK 3:16">लुका 3:16</ref>; <ref loc="JHN 1:27">योहान 1:27</ref></char></note>जेवी योहान तान सेवा पुरी केरने पोर ईतो, तेवी योहान माणहाह केयो, “तुमू माहु काय सोमेजतेह? मी तो नाह सुतो जान तुमू वाट जोवतेह! पुण दिखो, मार पासाण एक आवण्यो हे, मी ज्यी लायकीन नाह सुतो काय तान पायान खाहड़ाह काडु।”<verse eid="ACT 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26" />एय मारा इस्राएली बाहख, तुमू जा अब्राहामान सोरा हेते; एने आखा बिगेर यहुदि जा बोगवानान बोक्ती केरतेह, आपणी फाय ज्या सुटकारान वचन मोकलाय जायेल हे। <verse eid="ACT 13:26" /><verse number="27" style="v" sid="ACT 13:27" />काहाकाय यरूशलेम माय रेणारे एने तान आदिकारी, नाह ता सुटकारो आपणाराह ओलख्या एने नाह जाणाव केरनारान वातु, ज्यी देर विहेवणेन दिह वाचाय जाथे तीह सोमज्या। एने यीशुह गुनेगार ठेरावणेन द्‍वारा जाणकारान वातुह खेरो साबीत केऱ्या। <verse eid="ACT 13:27" /><verse number="28" style="v" sid="ACT 13:28" /><note caller="+" style="x"><char style="xo" closed="false">13:28 </char><char style="xt" closed="false"><ref loc="MAT 27:22">मत्ती 27:22</ref>,<ref loc="MAT 27:23">23</ref>; <ref loc="MRK 15:13">मरकुस 15:13</ref>,<ref loc="MRK 15:14">14</ref>; <ref loc="LUK 23:21-23">लुका 23:21-23</ref>; <ref loc="JHN 19:15">योहान 19:15</ref></char></note>ता यीशुह मार टाकणेन केरता कायच गुनो ता माय नाह सापोड़नो, तीबी पिलातुसाह मांग केऱ्या काय तो माराय जाय। <verse eid="ACT 13:28" /><verse number="29" style="v" sid="ACT 13:29" /><note caller="+" style="x"><char style="xo" closed="false">13:29 </char><char style="xt" closed="false"><ref loc="MAT 27:57-61">मत्ती 27:57-61</ref>; <ref loc="MRK 15:42-47">मरकुस 15:42-47</ref>; <ref loc="LUK 23:50-56">लुका 23:50-56</ref>; <ref loc="JHN 19:38-42">योहान 19:38-42</ref></char></note>एने जेवी ता पुस्तेक माय लिखेल यीशुन बाराम आख्‍यु वातु पुऱ्यू केऱ्या, ते ताह खुरूसखाम पोर रेन उतारीन माहणा माय मेल देना। <verse eid="ACT 13:29" /><verse number="30" style="v" sid="ACT 13:30" />पुण बोगवान ताह मुरेल माय रेन जीवाड्यो, <verse eid="ACT 13:30" /><verse number="31" style="v" sid="ACT 13:31" /><note caller="+" style="x"><char style="xo" closed="false">13:31 </char><char style="xt" closed="false"><ref loc="ACT 1:3">प्रेरितान काम 1:3</ref></char></note>ता हेऱ्या जा गेलील माय रेन यरूशलेम आयेल एता, तान नेजरीम जुलूम दिह वोर देखाती रिनो। इस्राएल माणहान सामने एवी ताच तान गोवा हेते। <verse eid="ACT 13:31" /><verse number="32" style="v" sid="ACT 13:32" />एने ता वायदान बाराम जो आपणा बाप दादाह आपेल एतो, तान हाजाली खुबेर आमु तुमूह केतेह। <verse eid="ACT 13:32" /><verse number="33" style="v" sid="ACT 13:33" />काय बोगवान यीशुह जिवाड़ेन, तोस वायदो आपणा सोरान केरता पुरो किरेल हे; जिहकेरीन बजन माय बी लिखेल हे,</para>
  <para style="q1" vid="ACT 13:33">“तु मारो बिटोख हे;</para>
  <para style="q2" vid="ACT 13:33">आज मी तुवाह पायदा किरेल हे।”<verse eid="ACT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 13:34" />एने बोगवान यीशुह मुरेल माय रेन जीवतो केरीन उठाड्यो काय सेड़नेन केरता माहणा माय पोड़ीन नाय रेय, तानकेरीन तो इहकेरीन कियेल हे:</para>
  <para style="q1" vid="ACT 13:34">“मी तुवाह चोखाली एने नाह टेलनार बोरकेत आपुह,</para>
  <para style="q2" vid="ACT 13:34">जी मी दाऊदा हिऱ्यो वायदो किरेल हे।” <note caller="+" style="f"><char style="fr" closed="false">13:34 </char><char style="ft" closed="false">यशाया 55:3, बजन 89:3-5, 2 शमुएल 7:11-16</char></note><verse eid="ACT 13:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 13:35" />तानकेरता तो उंजु एक बजन माय बी किथे,</para>
  <para style="q1" vid="ACT 13:35">“तु तारा विश्वासयोग्य पावराह सेड़ने नाय दिहे।”<verse eid="ACT 13:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 13:36" />काहाकाय दाऊद ते बोगवानान मोरजीन गेत तान टेमाम माणहान सेवा पुरी केरीन मोर गीयो, एने तान बाप दादान विचीम माहणा माय बुजाय गीयो, एने तान सेरीर माहणा माय सेड़ गीयो। <verse eid="ACT 13:36" /><verse number="37" style="v" sid="ACT 13:37" />पुण जाह बोगवान मुरेल माय जीवाड्यो, तो माहणा माय सेड़नो नाह। <verse eid="ACT 13:37" /><verse number="38" style="v" sid="ACT 13:38" />तानकेरता एय मारा इस्राएली बाय बोणहा, तुमू ज्यो जाण जावो काय यीशुन द्‍वारा पापान माफीन खुबेर तुमूह होमलावाय जाथे; <verse eid="ACT 13:38" /><verse number="39" style="v" sid="ACT 13:39" />मुसान नेम तुमूह तुमरा पापा से सोड़ेव नाह सेकतालो, पुण जा माणहे यीशु पोर बुरहो केरतेह, ता आखा तान द्‍वारा पापा माय रेन सोड़वाय जाती। <verse eid="ACT 13:39" /><verse number="40" style="v" sid="ACT 13:40" /><note caller="+" style="f"><char style="fr" closed="false">13:40 </char><char style="ft" closed="false">थोड़ाक लेख माय तुमूह नाह।</char></note>तानकेरता चेकचेल्या रिवो, जिहकेरीन जाणाव केरनारान पुस्तेक माय जो कियेल हे, तो तुमरी पोर बी नाय गेट जाय:<verse eid="ACT 13:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="ACT 13:41" />“एय चिहटा केरनारे! दिखो, एने बोंगलायीन मोर जावो!</para>
  <para style="q1" vid="ACT 13:41">काहाकाय मी तुमरे दिह्या माय एक काम केरथु,</para>
  <para style="q2" vid="ACT 13:41">ओहलो काम काय केदी एगदो तुमू हेऱ्यो तान चेरचा केरी,</para>
  <para style="q2" vid="ACT 13:41">ते तुमू केदी बुरहो नाय किरहो!”<verse eid="ACT 13:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42" />जेवी पौलुस एने बरनबास यहुदिन बोक्‍तीन गेरा माय रेन बाहेर निकेलने बाजरियेल एता, तेवी माणहे ताह विन्ता केऱ्या काय आमुह ओंगाणल्या विहेवणेन दिह्या आमुह ज्‍यु वातु उंजु किज्यो। <verse eid="ACT 13:42" /><verse number="43" style="v" sid="ACT 13:43" />एने जेवी सोबा खेतेम एय गियी ते जुलूम यहुदि एने बिगेर यहुदिन राय माय आयेल बोकत्या माय रेन जुलूम माणहे पौलुस एने बरनबासान पासाण चाल पोड़ना; एने प्रेरित ताह जुलूम वातु केरीन सोमजाड्या काय बोगवानान गीण माय जीवाय बाणावीन मीलो।<verse eid="ACT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44" />ओंगाणल्या विहेवणेन दिह्या गावान आखा माणहे मालीकान वचन होमेलनेन केरता टोलवाय गीया। <verse eid="ACT 13:44" /><verse number="45" style="v" sid="ACT 13:45" />पुण यहुदि गेरदीह देखीन रागा माय बोराय गीया, एने चिहटा केरती लेन पौलुसान वातीन विरोद माय बोलने बाज गीया। <verse eid="ACT 13:45" /><verse number="46" style="v" sid="ACT 13:46" />तेवी पौलुस एने बरनबास पाका बोरहाम केया, बोगवानान वचन पेल तुमूह केणेन जोरेवरी एतो; पुण जेवी तुमू ताह नाकारतेह, एने सोताह जेलेमक्यो जीवायीन हाजा नाह ठेरावते, ताहार एवी आमु बिगेर यहुदिन उगे वोलतेह। <verse eid="ACT 13:46" /><verse number="47" style="v" sid="ACT 13:47" />काहाकाय मालीक आमुह ज्यो उकुम आपेल हे,</para>
  <para style="q1" vid="ACT 13:47">“मी तुवाह बिगेर यहुदिन केरता उजालो ठेरायेल हे,</para>
  <para style="q2" vid="ACT 13:47">काय आखी देरती वोचाड़ाय जाय।”<verse eid="ACT 13:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48" />ज्यो होमलीन बिगेर यहुदि माणहे खुस एना, एने बोगवानान वचनान बोड़ाय केरने बाज गीया; एने जोला जेलेमक्यो जीवायीन केरता ठेराय जायेल एता, ता बुरहो केऱ्या।<verse eid="ACT 13:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="ACT 13:49" />तेवी बोगवानान वचन ता आखा देसा माय पोसेरने बाज गीयो। <verse eid="ACT 13:49" /><verse number="50" style="v" sid="ACT 13:50" />पुण यहुदि बोगवानान बोक्ती केरनार्‍यु बिगेर यहुदि मुखी बायकुह, एने गावान मुखी माणहाह बोड़काया। एने पौलुस एने बरनबासान विरोद केरीन ताह तान एद्दीन बाहेर निकाल देना। <verse eid="ACT 13:50" /><verse number="51" style="v" sid="ACT 13:51" /><note caller="+" style="x"><char style="xo" closed="false">13:51 </char><char style="xt" closed="false"><ref loc="MAT 10:14">मत्ती 10:14</ref>; <ref loc="MRK 6:11">मरकुस 6:11</ref>; <ref loc="LUK 9:5">लुका 9:5</ref>; <ref loc="LUK 10:11">10:11</ref></char></note>तेवी प्रेरित ता माणहान विरोद माय आपणा पायान रेजड़ो जेटकीन इकुनियुम हेयरा माय जात रेना। <verse eid="ACT 13:51" /><verse number="52" style="v" sid="ACT 13:52" />एने अन्‍ताकियान विश्वासी खुसी माय एने चोखाला जीवा केरीन पुरा एना।<verse eid="ACT 13:52" /></para>
  <chapter eid="ACT 13" />
  <chapter number="14" style="c" sid="ACT 14" />
  <para style="s">इकुनियुम माय पौलुस एने बरनबास</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1" />इकुनियुम माय इहकेरीन एनो काय पौलुस एने बरनबास यहुदिन बोक्ती केरन्या गेरा माय आरही आरही गीया, एने ओहल्यु वातु केऱ्या काय यहुदि एने बिगेर यहुदि दुयाम रेन मोकतास माणहे बुरहो केऱ्या। <verse eid="ACT 14:1" /><verse number="2" style="v" sid="ACT 14:2" />पुण बुरहो नाह केरनारे यहुदि बिगेर यहुदि माणहान मोना माय विश्वासी बायाख ने विरोद ईरेचेड़ाया, एने तान मोन माय जेहेर बोर देना। <verse eid="ACT 14:2" /><verse number="3" style="v" sid="ACT 14:3" />बरनबास एने पौलुस जुलूम दिह वोर ता थोब रेना, एने मालीक पोर बुरहो मेलते लेन ईमोत हेऱ्या पारचार केरती रेना, एने मालीक तान द्‍वारे बोंगलाय ओहला काम निसाणी एने चोमेत्कार केरावीन तान गीणान खोबरीह खेराय माय देखाड़ते रिनो। <verse eid="ACT 14:3" /><verse number="4" style="v" sid="ACT 14:4" />पुण हेयरान माणहा माय फुट पोड़ गियी: थोड़ाक माणहे ते यहुदिन उगे, एने थोड़ाक माणहे प्रेरितान उगे एय गीया।<verse eid="ACT 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 14:5" />तेवी थोड़ाक बिगेर यहुदि एने यहुदि तान आदिकारी हेऱ्या मिलीन प्रेरिता हेऱ्या खाराब वेवार केरने, एने ताह देगड़ाठणेन चाल चाल्या। <verse eid="ACT 14:5" /><verse number="6" style="v" sid="ACT 14:6" />जेवी बरनबास एने पौलुस ज्यी वातीह जाण गीया, एने लुकाउनिया, लुस्रा, एने दिरबे हेयरा माय एने तान आहने पाहनेन देसा माय नाह गीया। <verse eid="ACT 14:6" /><verse number="7" style="v" sid="ACT 14:7" />एने ताहरी जाईन ता हाजाली खुबेर होमलावते रेना।<verse eid="ACT 14:7" /></para>
  <para style="s">लुस्रा एने दिरबे माय पौलुस एने बरनबास</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8" />लुस्रा माय एक माणुह बोह रियेल एतो जो पायान पांगलो एतो। तो पायदा सेस लेंगड़ो एतो, एने केदिस नाह चालेल एतो। <verse eid="ACT 14:8" /><verse number="9" style="v" sid="ACT 14:9" />तो पौलुसाह वातु केरतालो होमेलने बाजरियेल एतो। एने पौलुस तान उगे हास केरीन दिख्यो, काय ज्याह हुदेरनेन बुरहो हे, <verse eid="ACT 14:9" /><verse number="10" style="v" sid="ACT 14:10" />एने मोठेस केयो, “तु तारा पाया पोर हुतरो उब रे!” तेवी तो कुदिन उठनो एने चालने फिरने बाज गीयो। <verse eid="ACT 14:10" /><verse number="11" style="v" sid="ACT 14:11" />माणहान गेरदी पौलुसान ज्यो काम देखीन लुकाउनियान बाषा माय मोठेस आयड़ीन केया, “देव माणहान वेहा माय आमरी फाय उतेर आयेल हे!” <verse eid="ACT 14:11" /><verse number="12" style="v" sid="ACT 14:12" />एने ता बरनबासाह ज्युस, एने पौलुसाह हिरमेस केया, काहाकाय पौलुस वातु केरने माय मुखी ईतो। <verse eid="ACT 14:12" /><verse number="13" style="v" sid="ACT 14:13" />एने ज्युस ने मोंदिर ने चाकर्‍यो जो तान हेयरान सामने ईतो, बुयेल एने फुलान हार बायणा पोर लावो, एने माणहा हिऱ्यो बोली केरने होदतालो।<verse eid="ACT 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 14:14" />पुण प्रेरित बरनबास एने पौलुस जेवी ज्यो होमल्या, ते तान फाड़का फाड़ देना, एने माणहान गेरदी माय रिगीन आयड़ीन केया, <verse eid="ACT 14:14" /><verse number="15" style="v" sid="ACT 14:15" />“एय माणहे, तुमू ज्यो काहा केरतेह? आमु बी तुमरी गेत माणहे हेते! एने तुमूह बोगवानान हाजाली खुबेर होमलावणेन केरता आमु न्या आयेल हेते, एने तुमू ज्‍यु उदड्यु चिजीह रेन आलेग एन जीवताला बोगवानान उगे वोलो, जो हेरोग, देरती, देरीयो एने जो काय ता माय हे, बाणायो। <verse eid="ACT 14:15" /><verse number="16" style="v" sid="ACT 14:16" />तो गीया टेमा माय आखा देसान माणहाह तान तान वाटे चालने दिनो। <verse eid="ACT 14:16" /><verse number="17" style="v" sid="ACT 14:17" />पुण तो जेलेम बोलायीन काम केरनेन द्‍वारे तान अस्तित्वाह प्रमाणीत केऱ्यो, तो तुमूह जुगाम रेन पाणी आप्यो एने रूतून गेत कामाय आप्यो तो तुमूह खाणो आपेह एने तुमरा मोनाह खुसी माय बोर दिथे।” <verse eid="ACT 14:17" /><verse number="18" style="v" sid="ACT 14:18" />इहकेरीन केयीन प्रेरित ता माणहाह जेमतेम रोक्‍या काय आमरी केरता बोली नाय केरी।<verse eid="ACT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19" />पुण थोड़ाक यहुदि फिसीदियान अन्‍ताकिया एने इकुनियुम रेन आवीन माणहाह तान उगे केर लेदा; एने पौलुसाह देगड़ाठ्या, एने तो मोर गीयोह सोमजीन ताह हेयरान बाहेर गीहलीन टाक देना। <verse eid="ACT 14:19" /><verse number="20" style="v" sid="ACT 14:20" />पुण जेवी विश्वासी तान कावदेन आवीन उबरेय गीया, ते पौलुस उठनो एने पुशो हेयरा माय गीयो। ओवतो दिहरे दिह बरनबासा हिऱ्यो दिरबे माय जात रिनो।<verse eid="ACT 14:20" /></para>
  <para style="s">सीरीयान अन्ताकियाम वोलनो</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21" />पौलुस एने बरनबास दिरबे गावान माणहाह हाजाली खुबेर होमलावीन जुलूम होवटा चेला बाणाया। एने लुस्रा, इकुनियुम एने फिसीदियान अन्‍ताकिया गावा माय ता पोशा आवा, <verse eid="ACT 14:21" /><verse number="22" style="v" sid="ACT 14:22" />एने विश्वासीन मोनाह मोजबुत किरते रेना, एने ज्यो उत्साह किरते रेना काय बोरहान खेरायी माय टिकीन रिवो। एने ज्यो हिकवोण आपताला, “आमुह मोटलो दुख वेठीन बोगवानान राज माय रिगणे पोड़ी।” <verse eid="ACT 14:22" /><verse number="23" style="v" sid="ACT 14:23" />एने ता एक एक मोंडली माय तान केरता अगुवा निवाड़ेन नियुक्त केऱ्या, एने उपास एने विन्ता केरीन ताह मालीकान आथा माय होप्या जा पोर ता बुरहो किरेल एता।<verse eid="ACT 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 14:24" />तेवी प्रेरित पिसीदिया माय रेन पंफुलीया माय आवा। <verse eid="ACT 14:24" /><verse number="25" style="v" sid="ACT 14:25" />एने पिरगा माय वचन होमलावीन फिसीदियान अन्‍ताकिया माय आवा, <verse eid="ACT 14:25" /><verse number="26" style="v" sid="ACT 14:26" />एने ता रेन ता सीरीयान अन्‍ताकिया माय जाणेन डोंडह्या माय बोहीन निकेलना, जाहरी ता ता कामान केरता जा ता पुरो किरेल एता, बोगवानान गीणा माय होपाय जायेल एता।<verse eid="ACT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 14:27" />एने जेवी ता अन्‍ताकिया माय पोचना ते मोंडलीह टुलो केऱ्या, एने जो बोगवान ता हिऱ्यो रेन किरेल तो केय होमलाया, एने बिगेर यहुदिह बुरहो केरनेन केरता किहीक बायणो उगाड़ दिनो। <verse eid="ACT 14:27" /><verse number="28" style="v" sid="ACT 14:28" />एने ता विश्वासी हेऱ्या जुलूम दिह वोर रेना।<verse eid="ACT 14:28" /></para>
  <chapter eid="ACT 14" />
  <chapter number="15" style="c" sid="ACT 15" />
  <para style="s">यरूशलेमान सोबा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1" />ओवता थोड़ाक माणहे यहुदिया रेन अन्‍ताकिया माय आवीन विश्वासीह हिकाड़ने बाज गीया, “केदी मुसान नेमान गेत तुमरो खेतना नाय एय ताहार तुमरो सुटकारो नाह एय सिकेत।” <verse eid="ACT 15:1" /><verse number="2" style="v" sid="ACT 15:2" />ज्यान बाराम जेवी पौलुस एने बरनबास ता हेऱ्या सहमत नाह एता केरीन ता हेऱ्यो जुलूम बोलचाल एनो, तेवी इहकेरीन ठेराया काय पौलुस एने बरनबास एने तान थोड़ाक हाती ज्यी समस्यान समादान ने केरता प्रेरित एने मोंडलीन डायडाया फाय यरूशलेम माय जाय।<verse eid="ACT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 15:3" />ओवती मोंडली ताह आदेक वोर पोचाड़ देनी; तेवी ता फीनीके एने सामरीया माय रेन गीया, एने ता ज्यी जाणकारी कितेन गीया काय बिगेर यहुदि माणहे किहीक बोगवाना फाय आवा; ज्यो होमलीन आखा विश्वासी जुलूम खुस एय गीया। <verse eid="ACT 15:3" /><verse number="4" style="v" sid="ACT 15:4" />जेवी ता यरूशलेम पोचना ते प्रेरित एने मोंडलीन डावाला तान स्वागत केऱ्या, तेवी तो आखो काय केय होमलाया जो बोगवान ता हिऱ्यो किरेल ईतो। <verse eid="ACT 15:4" /><verse number="5" style="v" sid="ACT 15:5" />पुण फरिसीन टोलान थोड़ाक माणहे जा विश्वास माय आव जायेल एता उबरीन केया, “बिगेर यहुदिह खेतना केरने जोरेवरी हे, एने ताह मुसान नेमान पालेन केरने जुवे।”<verse eid="ACT 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6" />तेवी प्रेरित एने मोंडलीन डावाला ज्यी वातीन बाराम विचार केरनेन केरता टुलो एना। <verse eid="ACT 15:6" /><verse number="7" style="v" sid="ACT 15:7" /><note caller="+" style="x"><char style="xo" closed="false">15:7 </char><char style="xt" closed="false"><ref loc="ACT 10:1-43">प्रेरितान काम 10:1-43</ref></char></note>तेवी जुलूम बोलचाल एणेन बाद पतरस उबरीन ताह केयो, “एय बाहख, तुमू जाणतेह काय जुलूम दिह पेल बोगवान तुमरे माय रेन माहु निवाड़ लिदो काय मार मुया केरीन बिगेर यहुदि हाजाली खुबेर होमलावु, ज्यानकेरता काय ता होमलीन बुरहो केरी। <verse eid="ACT 15:7" /><verse number="8" style="v" sid="ACT 15:8" /><note caller="+" style="x"><char style="xo" closed="false">15:8 </char><char style="xt" closed="false"><ref loc="ACT 10:44">प्रेरितान काम 10:44</ref>; <ref loc="ACT 2:4">2:4</ref></char></note>एने आखान मोनाह जाणनार बोगवान आपणे गेत ताह बी चोखालो जीव आपेल हे, एने तान बाराम गोवाय दिनो। <verse eid="ACT 15:8" /><verse number="9" style="v" sid="ACT 15:9" />एने तान विश्वासान द्‍वारा तान पापाह माफ केर दिनो; ता माय एने आपणे विची माय काय फारेक नाह मेल्‍यो। <verse eid="ACT 15:9" /><verse number="10" style="v" sid="ACT 15:10" />ते एवी तुमू काहा बोगवानान पारेख केरतेह काय विश्वासीन बोची पोर ओहलो वोजो मीलो, जाह नाहते आमरा बाप दादा विस सिकेल एता एने नाह आमु विस सेकतेह? <verse eid="ACT 15:10" /><verse number="11" style="v" sid="ACT 15:11" />नाह, आमरो ज्यो बुरहो हे काय जिहकेरीन आमरो मालीक यीशुन गीणी माय सुटकारो ईयेल हे; तिहेस तान बी ईयेल हे।”<verse eid="ACT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12" />तेवी आखी बिड़ ठावकीस बरनबास एने पौलुसान होमेलने बाज गियी, काय बोगवान तान द्‍वारा बिगेर यहुदि माय कोहला मोट मोटला चोमेत्कार, एने मोटला काम देखाड़ेल हे। <verse eid="ACT 15:12" /><verse number="13" style="v" sid="ACT 15:13" />जेवी ता ठावका एना ते याकुब केयो: “एय बाहख, मारी हुमलो! <verse eid="ACT 15:13" /><verse number="14" style="v" sid="ACT 15:14" />शिमोन केयो काय बोगवान पेलुस रेन बिगेर यहुदि पोर किहीक गीण किरेल हे ता माय रेन तान नावान केरता आखाह एक बाणाव लेय। <verse eid="ACT 15:14" /><verse number="15" style="v" sid="ACT 15:15" />ज्यी वाती से जाणाव केरनारान वातु बी मीलात्युह,” जिहकेरीन पुस्तेक माय लिखेल हे,<verse eid="ACT 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ACT 15:16" />“तान पासाण मी पोशो आवुह,</para>
  <para style="q2" vid="ACT 15:16">एने दाऊदान पुड़ेल तोम्बु पुशो हुदारूह,</para>
  <para style="q1" vid="ACT 15:16">तान टुटेल बितड़ाह पोशो बांदुह</para>
  <para style="q2" vid="ACT 15:16">एने मोजबुत केरूह।<verse eid="ACT 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 15:17" />ज्यानकेरता काय बाकी माणहे बी एने आखा बिगेर यहुदि बी जा मार नावान केवातेह,</para>
  <para style="q2" vid="ACT 15:17">मालीकाह होदि।<verse eid="ACT 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 15:18" />ज्यो तोस मालीक किथे, जो दुनियान सुरवात रेन ज्यी वातीन खुबेर जाणेह देखाड़तीन आयेल हे।”<verse eid="ACT 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19" />तानकेरता मारो विचार ज्यो हे काय बिगेर यहुदि माय रेन जा माणहे बोगवानान उगे आवतेह, ताह दुख नाय देणे जुवे। <verse eid="ACT 15:19" /><verse number="20" style="v" sid="ACT 15:20" />पुण आमुह ते ता फाय चिट्ठी लेखीन मोकेलने जुवे; काय ता ओहलो खाणो नाय खाणे जुवे जो रितीन गेत एठो हे काय मुरती पोर चेड़ायेल हे, सिनाला हेऱ्या रेन ता सेटा रेय एने गिलो टिबलीन मारील काल्ला बी जेनवेरान माह एने लुय नाय खाय। <verse eid="ACT 15:20" /><verse number="21" style="v" sid="ACT 15:21" />काहाकाय जुनाला कालाम रेन गावा गावा माय मुसान नेमान पारचार केरनारे ईती आयेल हेते, एने तो देर विहेवणेन दिह्या बोक्ती केरन्या गेरा माय वाचाय जाथे।<verse eid="ACT 15:21" /></para>
  <para style="s">बिगेर यहुदि विश्वासीह चिट्ठी</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22" />तेवी प्रेरित, डायडाया एने आखी मोंडलीन राय काड़ीन ताहरी रेन थोड़ाक माणहाह निवाड़ लेदा, एने पौलुस एने बरनबास हेऱ्यो अन्‍ताकिया मोकेलनेन फिसलो केऱ्या। जा माय यहुदा जो बरसबा केवाथे, एने सिलास जो बायाख माय मुखी ईतो। <verse eid="ACT 15:22" /><verse number="23" style="v" sid="ACT 15:23" />एने तान आथा माय ता इहकेरीन चिट्ठी लेखीन लेय मोकल्या: “अन्‍ताकिया एने सीरीया एने किलीकीयाम रेणारे बायह्याख जा बिगेर यहुदि माय रेन हेते, ताह प्रेरित एने मोंडलीन डायडायान उगे रेन बायाख नमस्‍कार। <verse eid="ACT 15:23" /><verse number="24" style="v" sid="ACT 15:24" />आमु ज्यो होमलेल हेते काय आमु माय रेन काल्लो आदेस लेया बिगेरच थोड़ाक माणहे जाईन तान सोबदा केरीन तुमूह दुख पोचाड्या एती। <verse eid="ACT 15:24" /><verse number="25" style="v" sid="ACT 15:25" />तानकेरता आखा आमु एकी केरीन मोंगाल्ला, बरनबास एने पौलुसा हेऱ्या थोड़ाक माणहाह निवाड़ेन तुमरी फाय मोकलेल हेते। <verse eid="ACT 15:25" /><verse number="26" style="v" sid="ACT 15:26" />ज्या ता माणहे हेते जा तान जीव आपणा मालीक यीशु मसीन कामान केरता दोका माय टाकेल हेते। <verse eid="ACT 15:26" /><verse number="27" style="v" sid="ACT 15:27" />तानकेरता आमु यहुदा एने सिलासाह मोकलेल हेते, जा तान मुया केरीन बी लिखेल हे, त्यु वातु केय देती। <verse eid="ACT 15:27" /><verse number="28" style="v" sid="ACT 15:28" />काहाकाय चोखाला जीवाह एने आमुह ज्योस ठिख लागो काय जोरेवरी वाती सावाय तुमरी पोर जादा बार नाय टाके, <verse eid="ACT 15:28" /><verse number="29" style="v" sid="ACT 15:29" />एने मुरतीन सामने चेड़ायेल चिज, एने लुयीह रेन एने गिलो दाबीन मारील जेनवेरान माहाह रेन एने सिनालाह रेन सेटा रिवो। केदी तुमू न्याह रेन सेटा रिहो ते तुमरो हाजो एय। ओंगाण आमरे उगे रेन हाजो।”<verse eid="ACT 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30" />ताह मोकेल देन पासाण ता अन्ताकियाम गीया, एने ता आखा विश्वासीह टुलो केरीन ती चिट्ठी ताह आप देना। <verse eid="ACT 15:30" /><verse number="31" style="v" sid="ACT 15:31" />जेवी ती चिट्ठी मोठेस वाचाय गियी, तेवी ता मायवालो उत्साह खुबेर होमलीन जुलूम खुस एय गीया, एने ईमोत जुड़नो। <verse eid="ACT 15:31" /><verse number="32" style="v" sid="ACT 15:32" />यहुदा एने सिलास ज्या खुद जाणाव केरनार एता, केरीन ता जुलूम वातु से विश्वासीह हिकवोण आप्या, एने दिलासो आपीन मोजबुत केऱ्या। <verse eid="ACT 15:32" /><verse number="33" style="v" sid="ACT 15:33" />ताहरी ता थोड़ाक दिह रेना एने जा ताह मोकलेल एता, ता फाय पोशो जाणेन केरता विश्वासी ताह सान्ती से मोकेल देना। <verse eid="ACT 15:33" /><verse number="34" style="v" sid="ACT 15:34" />पुण सिलासाह ताहरी रेणे हाजो लागो।<note caller="+" style="f"><char style="fr" closed="false">15:34 </char><char style="ft" closed="false">थोड़ाक लेख माय ज्यो वचन नाह जुड़ेत।</char></note><verse eid="ACT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 15:35" />पुण पौलुस एने बरनबास बी अन्ताकियाम रोकाय गीया, एने दिहरा जुलूम माणहा हेऱ्या बी मालीकान वचन होमलावते एने हिकाड़ते रेना।<verse eid="ACT 15:35" /></para>
  <para style="s">पौलुस एने बरनबासान आलेग एणे</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36" />थोड़ाक दिह्यान बाद पौलुस बरनबासाह केयो, “चाला, ता गावा माय जाता, जा आपु मालीकान वचन होमलायेल एता, ताहरी पोशा जाईन आपणा विश्वासी बायाख मिलीन देखता काय ता कोहलाक हेते।” <verse eid="ACT 15:36" /><verse number="37" style="v" sid="ACT 15:37" />पुण बरनबास ज्यो ईरादो केर लियेल ईतो काय योहान जाह मरकुस बी केतेह आपणी आरही ली जाणेन होद्यो। <verse eid="ACT 15:37" /><verse number="38" style="v" sid="ACT 15:38" /><note caller="+" style="x"><char style="xo" closed="false">15:38 </char><char style="xt" closed="false"><ref loc="ACT 13:13">प्रेरितान काम 13:13</ref></char></note>पुण पौलुसाह लागो काय पंफुलीया माय रेन जो आपुह सोड़ीन जात रियेल ईतो, एने आपु हिऱ्यो काम पुरो एणे वोर नाह रिनो, ताह आरही ली जाणे हाजो नाह सोमज्यो। <verse eid="ACT 15:38" /><verse number="39" style="v" sid="ACT 15:39" />ज्या पोर रेन तान विची माय ओहलो मोटलो बोलचाल उठनो काय ता एका दिहरा हेऱ्या रेन आलेग एय गीया, एने बरनबास मरकुसाह लेन डोंडह्‍याम बोहीन साइप्रस जात रिनो। <verse eid="ACT 15:39" /><verse number="40" style="v" sid="ACT 15:40" />पुण पौलुस सिलासाह निवाड़ लिदो, एने विश्वासीह ता दुयूह मालीकान गीणी माय होप देना एने पौलुस ता रेन जात रिनो। <verse eid="ACT 15:40" /><verse number="41" style="v" sid="ACT 15:41" />एने सीरीया, एने किलीकीया माय फिरतेन मोंडलीह मोजबुत किरतेन गीया।<verse eid="ACT 15:41" /></para>
  <chapter eid="ACT 15" />
  <chapter number="16" style="c" sid="ACT 16" />
  <para style="s">पौलुस तीमुथीयुस एने सिलास हिऱ्यो जाणे</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1" />ओवतो पौलुस दिरबे एने लुस्रा माय गीयो। एने ताहरी तीमुथीयुस नावान एक विश्वासी ईतो, तान आहख यहुदि विश्वासी एती, पुण तान आबोख बिगेर यहुदि ईतो। <verse eid="ACT 16:1" /><verse number="2" style="v" sid="ACT 16:2" />तो लुस्रा एने इकुनियुम ने विश्वासी बायाख माय हाजो एदमी ईतो। <verse eid="ACT 16:2" /><verse number="3" style="v" sid="ACT 16:3" />पौलुस तीमुथीयुसाह आपणे हिऱ्यो ली जाणे होदतालो, केरीन तान खेतना किऱ्यो। काहाकाय तीमुथीयुसान आबोख बिगेर यहुदि हे, ज्यो आखाह मालुम एतो। <verse eid="ACT 16:3" /><verse number="4" style="v" sid="ACT 16:4" />एने ता हेयरा हेयराम जाईन ता नेमाह जा यरूशलेम वाली मोंडलीन प्रेरित एने डायला जो ठेरायेल एता, तो ताह मान्नेन केरता होप देना। <verse eid="ACT 16:4" /><verse number="5" style="v" sid="ACT 16:5" />इहकेरीन मोंडली बोरहा माय मोजबुत ईती गियी, एने दाड़ीन तान गेणती वोदते गियी।<verse eid="ACT 16:5" /></para>
  <para style="s">त्रोआस माय पौलुसान देरसेन</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6" />ता फ्रुगीया एने गलातीया देसा माय रेन गीया, काहाकाय चोखालो जीव ताह आसीया माय वचन केणेन केरता मोना किरेल एतो। <verse eid="ACT 16:6" /><verse number="7" style="v" sid="ACT 16:7" />एने जेवी ता मुसीया गावान ईलाका माय पोचना, ते ता बेतनिया माय जाणेन केरता कोसीत केऱ्या, पुण यीशुन जीव ताह जाणे नाह देनो। <verse eid="ACT 16:7" /><verse number="8" style="v" sid="ACT 16:8" /><note caller="+" style="f"><char style="fr" closed="false">16:8 </char><char style="ft" closed="false">नाह रोकातीन यात्रा केऱ्या; आहने रेन निकेल गीया।</char></note>ओवता ता मुसीया माय रेन त्रोआस माय आवा। <verse eid="ACT 16:8" /><verse number="9" style="v" sid="ACT 16:9" />ताहरी राती पौलुस एक देरसेन दिख्यो काय मकादुनियान एक एदमी उबरीन ताह विन्ता केरीन किथे, “न्याहरी मकादुनिया माय आवीन आमरी मोदेक केर!” <verse eid="ACT 16:9" /><verse number="10" style="v" sid="ACT 16:10" />जेवी पौलुस ज्यो देरसेन दिख्यो ते ज्यो सोमेजते लेन काय बोगवान आपुह ता माणहा माय हाजाली खुबेर केणेन केरता हादेल हे, आमु चालोच मकादुनिया जाणेन विचार केऱ्या।<verse eid="ACT 16:10" /></para>
  <para style="s">फिलेपी माय लुदियान मोन बोदेलने</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11" />तेवी आमु त्रोआस रेन डोंडह्या माय बोहीन हुतरा सुमात्राके गीया, एने दिहरे दिह नियापुलीस माय आवा। <verse eid="ACT 16:11" /><verse number="12" style="v" sid="ACT 16:12" /><note caller="+" style="f"><char style="fr" closed="false">16:12 </char><char style="ft" closed="false">मकादुनिया माय ने पेल्ला जिलान हियोर; थोड़ाक लेख माय मकादुनिया माय ने ता जिलान महत्वपुर्ण हियोर।</char></note>ता रेन आमु फिलेपी पोचना, जो मकादुनिया देसान पेल्लो जिलो एने रोमीन वोहती हे; एने आमु ता गावा माय थोड़ाक दिह वोर रेना। <verse eid="ACT 16:12" /><verse number="13" style="v" sid="ACT 16:13" />ओवता विहेवणेन दिहे आमु गावान फाटेक ने बाहेर नेदीन दिड़े ज्यो सोमजीन गीया काय ताहरी विन्ता केरनेन जागो एय, एने ज्‍यु बायकु ताहरी टोलवायेन बोह रियेल एत्यु, त्यु हेऱ्या वातु केरने बाज गीया। <verse eid="ACT 16:13" /><verse number="14" style="v" sid="ACT 16:14" />एने लुदिया नावान थुआतीरा गावान जामण्या फाड़का वेचणार एती, एने ती बोगवानान बोक्ती केरनार एती। मालीक तीन मोन खोल्यो काय ती पौलुसान वाती पोर मोन लागाड़े। <verse eid="ACT 16:14" /><verse number="15" style="v" sid="ACT 16:15" />जेवी लुदिया एने तीन गेराणान माणहे बपतीस्मा लेदा, एने ती आमुह इहकेरीन विन्ता केर्‍यी, “केदी तुमू माहु मालीक ने विश्वासी सोमेजतेह, ताहार आवीन मार गेरा माय रिवो,” एने ती आमुह मानाड़ीन ली गियी।<verse eid="ACT 16:15" /></para>
  <para style="s">पौलुस एने सिलास जेली माय</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16" />एक दिह जेवी आमु विन्ता केरनेन जागे जाणे बाजरियेल एता, तेवी आमुह एक जुवान पावेरनी मीलानी जीन सेरीर माय जाणाव केणार बुतड़ान जीव ईतो। एने जाणाव केणे से तीन मालक्यान केरता जुलूम पोयशा कामाव लेताली। <verse eid="ACT 16:16" /><verse number="17" style="v" sid="ACT 16:17" />ती पौलुसान एने आमरी पासाण आवीन आयेड़ने बाज गियी, “ज्या माणहे आखा रेन मोटला बोगवानान सेवक हेते! जा आपुह सुटकारान वाटीन खुबेर केतेह!” <verse eid="ACT 16:17" /><verse number="18" style="v" sid="ACT 16:18" />ती जुलूम दिह वोर इहीचकेरीन किरते रेनी; पुण पौलुस जुलूम परेशान एय गीयो, एने पासाण फिरीन तो ता जीवाह केयो, “मी तुवाह यीशु मसीन नावा माय उकुम आपथु काय तु ज्यीन सेरीर माय रेन निकील जा!” एने तो तुलेचबूखी निकील गीयो।<verse eid="ACT 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 16:19" />जेवी सोरीन मालक्या देख्या काय आमरी कामाईन आसा खेतेम एय जायेल हे, तेवी ता पौलुस एने सिलासाह देरीन गीहलीन माणहान चोवकी माय आदिकारीन सामने ली गीया। <verse eid="ACT 16:19" /><verse number="20" style="v" sid="ACT 16:20" />एने ताह रोमन आदिकारीन सामने उबा केरीन केया, “ज्या माणहे यहुदि एन आमरा गावा माय मोटली असान्ती पोसरावणे बाजरेनाह। <verse eid="ACT 16:20" /><verse number="21" style="v" sid="ACT 16:21" />एने ओहल्यु रिती रिवाज हिकाड़तेह जी आमरा नेमान विरोद हे, आमु रोमन नागरीक्त वाला माणहान केरता मान्ने बाराबोर नाय मीले आमु मानी नाह सेकते।” <verse eid="ACT 16:21" /><verse number="22" style="v" sid="ACT 16:22" />तेवी गेरदीन माणहे टुलो एन पौलुस एने सिलासान विरोद माय चेड़ गीया।</para>
  <para style="p" vid="ACT 16:22">एने आदिकारी तान फाड़का फाड़ीन काड़ देना, एने ताह चापका केरीन देणेन उकुम आप्यो। <verse eid="ACT 16:22" /><verse number="23" style="v" sid="ACT 16:23" />एने चापका केरीन जुलूम दिन ताह जेली माय कोंड दिनो, एने सिपायाह उकुम आप्यो काय ताह केड़ेक चोकसी माय मेली। <verse eid="ACT 16:23" /><verse number="24" style="v" sid="ACT 16:24" />तेवी सिपायाह ओहलो उकुम जुड़नेन बाद तो ताह मायवाली खोली माय मिल्यो, एने तान पाय काठा माय ठोक दिनो।<verse eid="ACT 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25" />आदि रातीन टेम पौलुस एने सिलास विन्ता केरती लेन, एने गीते गावीन बोगवानान बोड़ाय केरताला, एने केयदी तान होमेलने बाजरियेल एता। <verse eid="ACT 16:25" /><verse number="26" style="v" sid="ACT 16:26" />तेवी उचकाहुच देरती फाटनी न्या वोर काय जेलीन पायो आल गीयो, एने चालोच आखा बायणा उगड़ी गीया, एने आखान आथा माय बांदिल बेड्यु उगड़ी गीयो। <verse eid="ACT 16:26" /><verse number="27" style="v" sid="ACT 16:27" />सिपाय जाग उठनो, एने जेलीन बायणा उगाड़लास देखीन सोमज्यो काय केयदी नाह जायेल हेते; ते तो तान तालवार खेचीन काड़ लिदो, एने सोताह मारने होद्यो। <verse eid="ACT 16:27" /><verse number="28" style="v" sid="ACT 16:28" />पुण पौलुस जोरेस आयड़ीन केयो, “तु सोताह काय दुको मा पोचाड़ी! काहाकाय आमु आखा न्यास हेते!”<verse eid="ACT 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29" />तेवी सिपाय केंदिल मांगाड़ीन माय दोवड़तीन गीयो, एने कापते लेन पौलुस एने सिलासान ओंगाण जाय पोड़नो। <verse eid="ACT 16:29" /><verse number="30" style="v" sid="ACT 16:30" />एने ताह बाहेर निकालीन केयो, “एय मालीक, मारो सुटकारो एणे जुवे केरीन माहु काय केरने पोड़ी?”<verse eid="ACT 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 16:31" />ता केया, “मालीक यीशु पोर बुरहो केर, ते तु एने तारा गेराणान सुटकारो एय।” <verse eid="ACT 16:31" /><verse number="32" style="v" sid="ACT 16:32" />एने ता सिपायाह एने तान गेरान आखा माणहाह मालीकान वचन होमलाया। <verse eid="ACT 16:32" /><verse number="33" style="v" sid="ACT 16:33" />एने तुलेचबूखी राती ताह ली जाईन सिपाय तान जेखेम दोयो, एने चालोच सिपाय एने तान गेराणो बपतीस्मा लेदा। <verse eid="ACT 16:33" /><verse number="34" style="v" sid="ACT 16:34" />एने ताह तान गेर लावीन तान केरता खाणो वाट्यो। एने आखो गेराणो मिलीन बोगवाना पोर बुरहो केरीन खुसी केऱ्या।<verse eid="ACT 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35" />जेवी दिह उगनो तेवी रोमन आदिकारी ज्यो केयीन सिपायान आदिकारीह मोकल्या, “ता माणहाह सोड़ दे।”<verse eid="ACT 16:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 16:36" />तेवी जेलीन सिपाय आवीन ज्‍यु वातु पौलुसाह केयो, “रोमन आदिकारी तुमूह सोड़ देणेन केरता केय मोकलेल हे। तानकेरता एवी निकलीन सान्ती से जात रिवो।”<verse eid="ACT 16:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37" />पुण पौलुस सिपायान आदिकारीह केयो, “ता आमुह जा आमु रोमी नागरीक माणहे एन बी बिगेर गुनेगार ठेरायेल आखान सामने देना, एने जेली माय कोंड्या। काय ता एवी आमुह मोनेस बाहेर निकालतेह? इहकेरीन नाय चाले; पुण ता खुद आवीन आमुह बाहेर निकाले।”<verse eid="ACT 16:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 16:38" />सिपायान आदिकारी जाईन ज्‍यु वातुन जाणकारी रोमन आदिकारीह आप्यो; एने जेवी ता होमल्या काय पौलुस एने सिलास रोमी हेते, तेवी ता बिय गीया। <verse eid="ACT 16:38" /><verse number="39" style="v" sid="ACT 16:39" />तेवी रोमन आदिकारी जेलीम आवीन ताह मानाड्या; एने ताह जेलीम रेन बाहेर ली जाईन विन्ता केऱ्या काय गावा माय रेन जात रिवो। <verse eid="ACT 16:39" /><verse number="40" style="v" sid="ACT 16:40" />पौलुस एने सिलास जेली माय रेन निकलीन लुदियान गेर गीया, एने ताहरी विश्वासी बायाख मिलीन ताह उत्साह ने वातु केया, एने जात रेना।<verse eid="ACT 16:40" /></para>
  <chapter eid="ACT 16" />
  <chapter number="17" style="c" sid="ACT 17" />
  <para style="s">थिस्सलुनिक्योन गावाम पौलुस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1" />ओवता पौलुस एने सिलास अम्‍फिपुलीस एने अपुल्लोनिया माय रेन थिस्सलुनिक्यो माय आवा, ताहरी यहुदिन एक बोक्ती केरन्यो गेर एतो। <verse eid="ACT 17:1" /><verse number="2" style="v" sid="ACT 17:2" />पौलुस तान रितीन गेत बोक्‍तीन गेरा माय गीयो, एने तीन विहेवणेन दिह वोर चोखाली पुस्तेक माय रेन ता हिऱ्यो बोलचाल किरते रिनो। <verse eid="ACT 17:2" /><verse number="3" style="v" sid="ACT 17:3" />एने ज्यी वातीन मतलब खोली खोलीन सोमजाड़तालो काय मसीह दुख वेठणेन एने मुरेल माय रेन जीव उठणे, जोरेवरी एतो। एने “ज्यो तोस यीशु हे, जान बाराम मी तुमूह पारचार केरथु, मसी हे।” <verse eid="ACT 17:3" /><verse number="4" style="v" sid="ACT 17:4" />ता माय रेन थोड़ाक माणहे सहमत एन पौलुस एने सिलासा हेऱ्या बेचकाय गीया; बोगवानान बोक्ती केरनारे जुलूम होवटा बिगेर यहुदि बी ता माय बेचकाय गीया, न्या माय महत्वपुर्ण मुखी बायकु बी बेचकायेल एत्यु।<verse eid="ACT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5" />पुण यहुदि कुयराय माय बोराय गीया, एने आटा माय रेन थोड़ाक खाराब माणहाह आरही लेदा। एने गेरदी एकठी केरीन गावा माय देंगो केरने बाज गीया, एने यासोनान गेर पोर चेड़ाय केरीन कोसीत केऱ्या काय पौलुस एने सिलासाह माणहान सामने लावे। <verse eid="ACT 17:5" /><verse number="6" style="v" sid="ACT 17:6" />पुण जेवी ताहरी ताह नाह सापोड़नो, तेवी ता यासोन एने थोड़ाक विश्वासी बायाख गावान आदिकारी फाय गीहलीन ली गीया एने आयड़ीन केणे बाज गीया, “ज्या माणहे आखी जागे तेकलीत पायदा केर दियेल हेते! एने न्या बी आव लागेल हेते, <verse eid="ACT 17:6" /><verse number="7" style="v" sid="ACT 17:7" />एने यासोन ताह तान गेरा माय थोबाड़ेल हे। एने ता आखान आखा केसर ने उकुमान ज्यो केयीन विरोद केरतेह काय यीशु नावान काल्लो दिहरो राजा हे।” <verse eid="ACT 17:7" /><verse number="8" style="v" sid="ACT 17:8" />ता माणहाह एने गावान आदिकारीह ज्यो होमलावीन बोड़काव देना। <verse eid="ACT 17:8" /><verse number="9" style="v" sid="ACT 17:9" />तानकेरता ता यासोनान एने बाकी माणहाफ रेन जामीन लेएन ताह सोड़ देना।<verse eid="ACT 17:9" /></para>
  <para style="s">बिरीया गावा माय पौलुस एने सिलास</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10" />विश्वासी बाहख चालोच रातीम रात पौलुस एने सिलासाह बिरीया माय मोकेल देना; एने ता ताहरी पोचीन यहुदिन बोक्ती केरन्या गेरा माय गीया। <verse eid="ACT 17:10" /><verse number="11" style="v" sid="ACT 17:11" />ज्या माणहे थिस्सलुनिक्योन यहुदिह रेन मोकला मोनान एता। काहाकाय ता मोटली खुसी माय वचनाह मान लेदा, एने दाड़ीन चोखाली पुस्तेक माय द्यान देन चोकसी केरती रेना काय ज्यी वातु पौलुस कियेल हे, ती खेरी हे काय नाह। <verse eid="ACT 17:11" /><verse number="12" style="v" sid="ACT 17:12" />ज्यान परिणाम माय रेन जुलूम जाणे; एने ता हेऱ्या जुलूम बिगेर यहुदि बायकु एने एदमी बी बुरहो केऱ्या। <verse eid="ACT 17:12" /><verse number="13" style="v" sid="ACT 17:13" />पुण जेवी थिस्सलुनिक्योन यहुदिह मालुम एनो काय बिरीया माय बी पौलुस बोगवानान वचन केणे बाजरिनोह, तेवी ता ताहरी बी जाईन माणहाह बोड़कावणे एने देंगो केरने बाज गीया। <verse eid="ACT 17:13" /><verse number="14" style="v" sid="ACT 17:14" />तेवी विश्वासी बाहख पौलुसाह देरीया निही जाणेन केरता चालोच मोकेल देना, पुण सिलास एने तीमुथीयुस ताहरीच रेय गीया। <verse eid="ACT 17:14" /><verse number="15" style="v" sid="ACT 17:15" />पौलुसाह विश्वासी बाहख एथेंस वोर ली गीया; एने सिलास एने तीमुथीयुस ने केरता ता पौलुस फाय रेन ज्यो उकुम लेन वोलना काय बेरीया माय ताह जेल्दी मोकेल दिज्यो।<verse eid="ACT 17:15" /></para>
  <para style="s">एथेंस गावा माय पौलुस</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16" />जेवी पौलुस एथेंस माय सिलास एने तीमुथीयुस ने वाट जोवणे बाजरियेल ईतो, ते एथेंस गावाह मुरती माय बोराय रेनोह देखीन नाराज एय गीयो। <verse eid="ACT 17:16" /><verse number="17" style="v" sid="ACT 17:17" />तानकेरता पौलुस यहुदिन बोक्ती केरन्या गेरा माय यहुदि हिऱ्यो एने बिगेर यहुदि जा बोगवानान आरादना केरताला, एने आटा माय आवती जाते जा माणहे ताह मीलताला ता हिऱ्यो दाड़ीन दिह बोलचाल केऱ्या केरताला। <verse eid="ACT 17:17" /><verse number="18" style="v" sid="ACT 17:18" />एने थोड़ाक मास्तेर्‍या इपीकुरी स्तोईकीन टोला माय रेन थोड़ाक पौलुसा हेऱ्या बोलचाल केरने बाज गीया, एने थोड़ाक केया, “ज्यो विणएकल्यो काय केणे हुदेह?”</para>
  <para style="p" vid="ACT 17:18">पुण दिहरा केया, “ज्यो दिहरा देवान पारचार केरनार देखाह।” काहाकाय पौलुस यीशुन पोशो जीव उठणेन पारचार केरतालो।<note caller="+" style="f"><char style="fr" closed="false">17:18 </char><char style="ft" closed="false">यीशु एने पोशो जीव उठणो; युनानी बाषा माय “पोशो जीव उठणो” ज्यो स्त्री लिंग ने संग्या एगदी देवीन नाव सोमजाय जाय सिकेह।</char></note> <verse eid="ACT 17:18" /><verse number="19" style="v" sid="ACT 17:19" />तेवी ता पौलुसाह ता हेऱ्या हेयरान अरीयुपगुसान पोंचा माय ली गीया, एने फुसणे बाज गीया, “आमु जाण सेकतेह काय जो नोवालो हिकवोण तु किथे, काय हे। <verse eid="ACT 17:19" /><verse number="20" style="v" sid="ACT 17:20" />काहाकाय आमु होमलेल नाह ओहल्यु वातु तु होमलावेह, तानकेरता आमु जाणने होदतेह काय ज्‍यु वातुन मतलब काय हे।” <verse eid="ACT 17:20" /><verse number="21" style="v" sid="ACT 17:21" />(काहाकाय आखा एथेंस माय रेणारे माणहे एने ताहरी रेणारे दिहरा देसान माणहे, आखा तान नोवाल्यु नोवाल्यु वातु होमेलने एने केणे माय टेम जावाड़ताला।)<verse eid="ACT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22" />तेवी पौलुस हेयरान अरीयुपगुस पोंचान विची माय उबरीन केयो, “एय एथेंस माय रेणारे माणहे, मी देखणे बाजरिनोह काय तुमू आखी बातीन देरमी हेते। <verse eid="ACT 17:22" /><verse number="23" style="v" sid="ACT 17:23" />काहाकाय जेवी मी हेयरा माय फिरते लेन तुमरे बोक्ती केरनेन जागो देखणे बाजरियेल ईतो, तेवी एक ओहली वेदी बी दिखेल, जी पोर ज्यो लिखेल एतो, ‘एंजाण्या बोगवानान केरता।’ तानकेरता जान तुमू बिगेर देखीन बोक्ती केरतेह, तास ने खुबेर मी तुमूह होमलावथु। <verse eid="ACT 17:23" /><verse number="24" style="v" sid="ACT 17:24" /><note caller="+" style="x"><char style="xo" closed="false">17:24 </char><char style="xt" closed="false"><ref loc="ACT 7:48">प्रेरितान काम 7:48</ref></char></note>जो बोगवान देरती एने ता मायवाली आखी चिजीह बाणायो, तोस हेरोग एने देरतीन मालीक हे, एने तो आथा केरीन बाणायेल मोंदिर माय नाह रेणे। <verse eid="ACT 17:24" /><verse number="25" style="v" sid="ACT 17:25" />एने नाह एगदी चिजीन गिरेज ने वोजेसे माणहान आथान चाकरी लिथे, काहाकाय तो खुद आखाह जीवाय एने हाह एने आखो काय आपेह। <verse eid="ACT 17:25" /><verse number="26" style="v" sid="ACT 17:26" />काहाकाय बोगवान एकास माणहान द्‍वारा आखा माणहाह बाणायो एने आखी देरती पोर रेणेन केरता बाणायेल हे। एने तो पेलुस रेन माणहान टेम ठेराव दिनो एने तान जागान जा ता रेतेह तान एद्दीह बांद दियेल हे। <verse eid="ACT 17:26" /><verse number="27" style="v" sid="ACT 17:27" />ज्यो ज्यानकेरता किऱ्यो काय माणहे बोगवानाह होदि, एय सिकेह काय ता ता फाय पोचीन सापड़ाव लेय। तीबी तो आपणे माय रेन कुणीह रेन सिटो नाह; <verse eid="ACT 17:27" /><verse number="28" style="v" sid="ACT 17:28" />जिहकेरीन कुण ते बी कियेल हे, ‘आमु तास माय जीवताला रेतेह एने चालते फिरतेह, एने तास माय आमरो अस्तित्व हे।’ इहीचकेरीन तुमरा कोलाक कवी बी कियेल हेते, ‘आमु बी ते तास ने वोस हेते।’ <verse eid="ACT 17:28" /><verse number="29" style="v" sid="ACT 17:29" />बोगवानान वोस एन आपुह ज्यो केदीच नाय सोमेजणे जुवे काय बोगवान होनो, चांदी एने देगड़ान गेत हे, जो माणहान केला एने विचारा से बाणाय जायेल हे। <verse eid="ACT 17:29" /><verse number="30" style="v" sid="ACT 17:30" />तानकेरता बोगवान जेवी माणहे ताह नाह जाणताला ता टेम पोर द्यान नाह दिनो, पुण एवी आखी जागेन आखा माणहाह पापा माय रेन पोसतावो केरनेन केरता उकुम आपेह। <verse eid="ACT 17:30" /><verse number="31" style="v" sid="ACT 17:31" />काहाकाय बोगवान एक दिह ठेरायेल हे, ते दिह तो तान निवाड़ेल एक माणहान द्‍वारा खेराय से दुनियान नियाव केरी। एने ज्यी वातीन प्रमाण तो ता माणहाह मुरेल माय रेन जिवाड़ेन एकेकाह आप दियेल हे।”<verse eid="ACT 17:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32" />मुरेलान पोशो जीवतो एणेन ज्यी वातीह होमलीन माणहे पौलुसान टिंगेल केरने बाज गीया, पुण थोड़ाक माणहे केया, “ज्यी वात आमु तुवा फाय रेन पोशा होमेलने होदतेह।” <verse eid="ACT 17:32" /><verse number="33" style="v" sid="ACT 17:33" />उलोक एणेन बाद पौलुस तान विची माय रेन निकलीन जात रिनो। <verse eid="ACT 17:33" /><verse number="34" style="v" sid="ACT 17:34" />पुण थोड़ाक माणहे ता हेऱ्या बेचकाय गीया, एने बुरहो केऱ्या; जा माय दियुनुसीयुस जो पोंचान सदस्य ईतो, एने दमरीस नावान एक बायकु एती, एने ता हेऱ्या उंजु बी थोड़ाक माणहे एता।<verse eid="ACT 17:34" /></para>
  <chapter eid="ACT 17" />
  <chapter number="18" style="c" sid="ACT 18" />
  <para style="s">कुरिंथीयो माय पौलुस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1" />तान पासाण पौलुस एथेंस सोड़ीन कुरिंथीयो माय आवो। <verse eid="ACT 18:1" /><verse number="2" style="v" sid="ACT 18:2" />एने ताहरी पौलुसाह अक्विला नावान एक यहुदि मिलनो तान जेल्मो पुन्तुस माय ईयेल एतो, तो तान बायकु प्रिस्‍का हेऱ्या इटली रेन एवी एवीच आयेल ईतो, काहाकाय आखा यहुदिह रोम हियोर सोड़ीन जावो इहकेरीन क्‍लोदियास उकुम आपेल ईतो केरीन तो ता जायेल ईतो। <verse eid="ACT 18:2" /><verse number="3" style="v" sid="ACT 18:3" />ता एकठास रेताला तान काम एकुच एतो ता तान कामाईन केरता तोम्बु बाणावणेन काम केरताला। <verse eid="ACT 18:3" /><verse number="4" style="v" sid="ACT 18:4" />पौलुस देर विहेवणेन दिह बोक्ती केरन्या गेरा माय बोलचाल केरीन यहुदिह, एने बिगेर यहुदि माणहाह सोमजाड़नेन कोसीत केरतालो।<verse eid="ACT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5" />जेवी सिलास एने तीमुथीयुस मकादुनिया रेन आवा, ते पौलुस वचन होमलावणेन दुंद माय यहुदिह गोवाय देणे बाज गीयो काय यीशुस मसी हे। <verse eid="ACT 18:5" /><verse number="6" style="v" sid="ACT 18:6" />पुण जेवी यहुदि माणहे विरोद एने चिहटा केरने बाज गीया, ते पौलुस खुद ने फाड़का जेटकीन ताह केयो, “तुमरा मोतीन कारेण तुमू खुद हेते! मी ज्या माय निर्दोस हे। एवी रेन मी बिगेर यहुदि फाय जाह।” <verse eid="ACT 18:6" /><verse number="7" style="v" sid="ACT 18:7" />ओवतो ता रेन निकलीन पौलुस तीतुस यूसतुस नावान बिगेर यहुदि बोगवानान बोक्ती केरन्या गेरा माय गीयो; जान गेर बोक्ती केरन्या गेरा हेऱ्यो टेकीन एतो। <verse eid="ACT 18:7" /><verse number="8" style="v" sid="ACT 18:8" />तेवी बोक्ती केरन्या गेरान आदिकारी क्रिस्पुस तान आखो गेराणो मिलीन मालीक पोर बुरहो केऱ्या; एने जुलूम होवटा कुरिंथीयो माय रेणारे जेवी ज्यो होमल्या, ते बुरहो केऱ्या, एने बपतीस्मा लेदा।<verse eid="ACT 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9" />एने मालीक एक राती देरसेनान द्‍वारा पौलुसाह केयो, “मा बिय, पारचार किरते जा एने ठावको मा रेय, <verse eid="ACT 18:9" /><verse number="10" style="v" sid="ACT 18:10" />काहाकाय मी तार हिऱ्यो हे, एने कुण बी तुवा पोर चेड़ाय केरीन तारो दुको नाय केरी। काहाकाय ज्या गावा माय मारा जुलूम होवटा माणहे हेते।” <verse eid="ACT 18:10" /><verse number="11" style="v" sid="ACT 18:11" />तानकेरता पौलुस तान विची माय बोगवानान वचन हिकाड़ते लेन डेड़ वोरीह वोर रिनो।<verse eid="ACT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12" />जेवी गल्लीयो आखाया देसान आदिकारी बोणनो, तेवी यहुदि माणहे एकी केरीन पौलुसान विरोद उबरी गीया, एने ताह कोरटान सामने लावा। <verse eid="ACT 18:12" /><verse number="13" style="v" sid="ACT 18:13" />एने ज्यो केणे बाज गीया, “ज्यो माणुह आपणा नेमान विरोद बोगवानान उपासना केरनेन केरता माणहाह हिकाड़ेह!”<verse eid="ACT 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 18:14" />जेवी पौलुस बोलनेस केरतालो, तेवी गल्लीयो यहुदिह केयो, “एय यहुदि, केदी ज्यो काह अन्याय एने गुनान वात रेती, ते हाजो एतो काय मी तुमरी होमेलतो। <verse eid="ACT 18:14" /><verse number="15" style="v" sid="ACT 18:15" />पुण केदी ज्यो बोलचाल सोबदा, एने नावान एने तुमरेस नेमान बाराम हे, ते तुमूच मीटाड़ो; काहाकाय मी ज्यी वातीन नियाव केरनार नाह बोणने होदित!” <verse eid="ACT 18:15" /><verse number="16" style="v" sid="ACT 18:16" />एने आदिकारी पौलुसाह कोरटान सामने रेन निकालाव दिनो। <verse eid="ACT 18:16" /><verse number="17" style="v" sid="ACT 18:17" />पुण आखा माणहे बोक्‍तीन गेरान आदिकारी सोस्थिनेसाह देरीन कोरटान सामने देना। पुण गल्लीयो ज्यी वातीन उगे कायच द्यान नाह दिनो।<verse eid="ACT 18:17" /></para>
  <para style="s">पौलुसान अन्‍ताकिया आवणो</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18" />
    <note caller="+" style="f">
      <char style="fr" closed="false">18:18 </char>
      <char style="ft" closed="false">तो किरेल मन्नत: ज्यान मतलब मन्नत पुरो केरनेन मुंडान लेट्या काटाड़नेन यहुदि रिती</char>
    </note>पौलुस जुलूम दिह वोर कुरिंथीयो माय रिनो ओवतो विश्वासी बायाख ने खुबेर लेन डोंडह्या माय बोहीन सीरीया देसाम गीयो एने ता हेऱ्या प्रिस्‍का एने अक्विला ज्या गीया। तान बाद्या एती, केरीन तो किंख्रिया माय तान मुंडान टाली केरायो। <verse eid="ACT 18:18" /><verse number="19" style="v" sid="ACT 18:19" />ओवता इफिसुस माय आवा ते पौलुस प्रिस्‍का एने अक्विला ताहरी उताऱ्यो, एने खुद बोक्ती केरन्या गेरा माय जाईन यहुदि हिऱ्यो बोलचाल केरने बाज गीयो। <verse eid="ACT 18:19" /><verse number="20" style="v" sid="ACT 18:20" />जेवी तावाला माणहे पौलुसाह थोड़ाक दिह उंजु रेणेन केरता केया, पुण पौलुस नाह मान्यो। <verse eid="ACT 18:20" /><verse number="21" style="v" sid="ACT 18:21" />पुण ज्यो केयीन, “केदी बोगवानान मोरजी एय ते तुमरी फाय मी पोशो आवुह।” इहकेरीन केयीन पौलुस डोंडह्या माय बोहीन इफिसुस माय रेन निकेलनो;<verse eid="ACT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 18:22" />जेवी पौलुस केसरीया माय पोचनो, तेवी उपेर चेड़ीन यरूशलेमान मोंडलीह मिलानो, एने ओवतो नेचो उतरीन अन्‍ताकिया माय जात रिनो। <verse eid="ACT 18:22" /><verse number="23" style="v" sid="ACT 18:23" />ओवतो अन्‍ताकिया माय थोड़ाक दिह रेन पौलुस गलातीया एने फ्रुगीया ईलाका माय लागतो निकेलनो, एने आखा चेलाह विश्वास माय मोजबुत केरती फिरनो।<verse eid="ACT 18:23" /></para>
  <para style="s">इफिसुस गाव माय अपुल्लोस</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24" />अपुल्लोस नावान एक यहुदि, जान जेल्मो आलेकजांडरीया माय ईयेल एतो, जो मोटलो वोक्‍ता ईतो। एने चोखाली पुस्तेकीह हास केरीन जाणतालो, इफिसुस माय आवो। <verse eid="ACT 18:24" /><verse number="25" style="v" sid="ACT 18:25" />ताह मालीकान वाटीन हिकवोण जुड़ेल एती, एने मोन लागाड़ीन उत्साह से यीशुन बाराम वात हुतरो केयीन हिकाड़तालो, पुण तो फोक्‍तो योहान बपतीस्मान बाराम जाणतालो। <verse eid="ACT 18:25" /><verse number="26" style="v" sid="ACT 18:26" />पौलुस बोक्ती केरन्या गेरा माय ईमोत केरीन केणे बाज गीयो, पुण जेवी प्रिस्‍का एने अक्विला तान वातु होमल्या ते ताह आपणी हेऱ्या ली गीया, एने बोगवानान वाटीन बाराम उंजु बी हास केरीन सोमजाड्यो। <verse eid="ACT 18:26" /><verse number="27" style="v" sid="ACT 18:27" />जेवी अपुल्लोस ती पार आखाया जाणेन ठेरायो, तेवी इफिसुस ने विश्वासी बाहख तान ईमोत वोड़ाया, एने आखायान विश्वासी ज्यो लेख्यो काय ता ताह हास केरीन मीले; एने तो ताहरी पोचीन जा बोगवानान गीणान द्‍वारे विश्वास किरेल एता, ता माणहान तो जुलूम मोदेक किऱ्यो। <verse eid="ACT 18:27" /><verse number="28" style="v" sid="ACT 18:28" />काहाकाय यीशुस मसी हे, इहकेरीन चोखाली पुस्तेक पोर रेन देखाड़ीन अपुल्लोस जुलूम जोरदार से यहुदिह आखान सामने बोलती बोंद केरती रिनो।<verse eid="ACT 18:28" /></para>
  <chapter eid="ACT 18" />
  <chapter number="19" style="c" sid="ACT 19" />
  <para style="s">इफिसुस हेयरा माय पौलुस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1" />जेवी अपुल्लोस कुरिंथीयो माय ईतो, तेवी पौलुस मायवाला आखा देसा माय फिरीन इफिसुस माय आवो। एने ताहरी ताह थोड़ाक विश्वासी सापेड़ना <verse eid="ACT 19:1" /><verse number="2" style="v" sid="ACT 19:2" />तेवी पौलुस ताह फुशो, “तुमूह बुरहो केरने बुखेत चोखालो जीव जुड़ेल एतो काय?”</para>
  <para style="p" vid="ACT 19:2">ता पौलुसाह जापाप आप्या, “आमु ते चोखाला जीवान बाराम होमल्या बी नाह।”<verse eid="ACT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 19:3" />पौलुस ताह केयो, “ओवता तुमू कुणीन बपतीस्मा लेदाला?”</para>
  <para style="p" vid="ACT 19:3">एने ता जापाप आप्या, “योहानान बपतीस्मा।”<verse eid="ACT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 19:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">19:4 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 3:11">मत्ती 3:11</ref>; <ref loc="MRK 1:4">मरकुस 1:4</ref>,<ref loc="MRK 1:7">7</ref>,<ref loc="MRK 1:8">8</ref>; <ref loc="LUK 3:4">लुका 3:4</ref>,<ref loc="LUK 3:16">16</ref>; <ref loc="JHN 1:26">योहान 1:26</ref>,<ref loc="JHN 1:27">27</ref></char>
    </note>पौलुस ताह केयो, “योहान ता माणहाह बपतीस्मा आपेल जा माणहे तान पापा माय रेन फिरेल एता; एने इहकेरीन केयो काय जो मार पासाण आवण्यो हे, यीशु पोर बुरहो किरो।”<verse eid="ACT 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 19:5" />ज्यो होमलीन ता मालीक यीशु मसीन नावा माय बपतीस्मा लेदा। <verse eid="ACT 19:5" /><verse number="6" style="v" sid="ACT 19:6" />एने जेवी पौलुस ता पोर आथ मेल्‍यो, ते ता माय चोखालो जीव आवो; एने ता बात बातीन बाषा बोलने एने जाणाव केरने बाज गीया। <verse eid="ACT 19:6" /><verse number="7" style="v" sid="ACT 19:7" />एने ता कोम से कोम आखा बारा एदमी एता।<verse eid="ACT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8" />पौलुस यहुदि बोक्ती केरन्या गेरा माय जाईन तीन मोयना वोर बिगेर बियेल बोगवानान राज ने बाराम बोलचाल किरते, एने ताह सोमजाड़ते रिनो। <verse eid="ACT 19:8" /><verse number="9" style="v" sid="ACT 19:9" /><note caller="+" style="f"><char style="fr" closed="false">19:9 </char><char style="ft" closed="false">थोड़ाक लेख माय वेगोच ने 11 वाजणे से हांज पोर ने 4 वाजणेन पोर जुड़ेल हे</char></note>पुण थोड़ाक माणहे वातड़ा बोणीन तान वातु पोर बुरहो नाह केऱ्या, एने माणहान सामने जाईन यीशुन नावान बेजेती बी केऱ्या। केरीन पौलुस ताह सोड़ दिनो, एने चेलाह आंगे केर लिदो एने तो दाड़ीन तुरत्रुसान साला माय जाईन बोलचाल केऱ्या केरतालो। <verse eid="ACT 19:9" /><verse number="10" style="v" sid="ACT 19:10" />दुय वोरह्या वोर इहीचकेरीन ईती रेनो, ता माय आसीया एद्दी माय रेणारे आखा यहुदि, एने बिगेर यहुदि सोब माणहे मालीकान वचन होमेल लेदा।<verse eid="ACT 19:10" /></para>
  <para style="s">केवान सोरा</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11" />एने बोगवान पौलुसान आथा केरीन बोंगलाय ओहला चोमेत्कारान काम देखाड़तालो। <verse eid="ACT 19:11" /><verse number="12" style="v" sid="ACT 19:12" />एने न्या वोर काय जेवी पौलुस रूमाल नाह ते फाड़को तान सेरीर पोर रेन दुखाऱ्या माणहा पोर टाकतालो, तेवी तान बेमारी हुदरी जाताली, एने बुतड़ा बी निकेल जाताला। <verse eid="ACT 19:12" /><verse number="13" style="v" sid="ACT 19:13" />पुण थोड़ाक यहुदि जा बुतड़ाह निकालनारे न्या ता फिरताला, ता मालीक यीशुन नाव वापेर केरनेन केरता कोसीत केरने बाज गीया। एने ता बुतड़ाह केताला, “आमु तुवाह पौलुस जा यीशुन पारचार किरेह, ता यीशुन नावा माय उकुम आपतेह काय ता माय रेन निकेल जा।” <verse eid="ACT 19:13" /><verse number="14" style="v" sid="ACT 19:14" />एने केवा नावान एक यहुदि मुखी चाकर्‍यान हात सोरा एता, जा ओहलो केरताला।<verse eid="ACT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 19:15" />पुण बुतड़ो ताह केयो, “मी यीशुह जाणथो एने पौलुसाह बी ओलेखथु; पुण तुमू कुण हेते?”<verse eid="ACT 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 19:16" />जा माणहान सेरीर माय बुतड़ो एतो, ताह कोंडीन जाफाट्यो एने ता गायला एय गीया। एने ता नांगान बोंगा एन गेरा माय रेन निकलीन नाठा। <verse eid="ACT 19:16" /><verse number="17" style="v" sid="ACT 19:17" />एने ज्यी वात इफिसुस वाला यहुदि एने बिगेर यहुदि आखा माणहाह ज्यो मालुम पोड़नो; तेवी ता जुलूम बिय गीया, एने मालीक यीशुन नावान बोड़ाय केऱ्या। <verse eid="ACT 19:17" /><verse number="18" style="v" sid="ACT 19:18" />एने जा बुरहो किरेल एता, ता तान बाकता कामे जा ता किरेल एता, ता मान्या। <verse eid="ACT 19:18" /><verse number="19" style="v" sid="ACT 19:19" /><note caller="+" style="f"><char style="fr" closed="false">19:19 </char><char style="ft" closed="false">चांदीन सिक्‍का; चांदीन एक सिक्को मतलब गावा माय मोंजर्‍या एक दिह्यान कामाई (देखी मत्ती 20:2।) </char></note>एने जादु केरनाराम रेन जुलूम जाणे आवीन जान तान पोती टुलो केरीन आखान सामने हेलगाड़ देना, एने तान ईसाब केरताला ते तान किमोत कोमीत कोमी पाचाह एजार चांदीन सिक्‍कान बाराबोर निकेलनो। <verse eid="ACT 19:19" /><verse number="20" style="v" sid="ACT 19:20" /><note caller="+" style="f"><char style="fr" closed="false">19:20 </char><char style="ft" closed="false">ज्या माय मालीक; नाहते एने ज्यानकेरता, मालीक ने ताकेत से, ज्यी खुबेर।</char></note>इहकेरीन मालीकान वचन एने ताकेतीन काम पोसेरते एने मोजबुत ईती गीयो।<verse eid="ACT 19:20" /></para>
  <para style="s">इफिसुस माय देंगो</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21" />
    <note caller="+" style="f">
      <char style="fr" closed="false">19:21 </char>
      <char style="ft" closed="false">पौलुस निश्चय किऱ्यो; नाहते जीवान प्रेरणा से पौलुस निश्चय किऱ्यो</char>
    </note> एने जेवी ज्‍यु वातु एय गीयो, तेवी पौलुस मकादुनिया एने आखाया लागतोस यरूशलेम माय जाव ज्यो विचार तान मोनाम केरीन केयो, “ताहरी जाणेन बाद माहु रोम हेयराह बी देखणेन जोरेवरी हे।” <verse eid="ACT 19:21" /><verse number="22" style="v" sid="ACT 19:22" />तानकेरता सेवा केरनाराम रेन तीमुथीयुस, इरास्तुस, न्या दुय जाणाह मकादुनिया माय मोकलीन तो सोता थोड़ाक दिह आसीया रेय गीयो।<verse eid="ACT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23" />इफिसुस माय ती टेम मालीक यीशुन बाराम जुलूम देंगो ईनो। <verse eid="ACT 19:23" /><verse number="24" style="v" sid="ACT 19:24" />ता दिमेत्रयुस नावान एक होनार ईतो, एने तो अरतीमीस देवीन केरता चांदीन मोंदिर बाणाया केरतालो, एने जुलूम कामाव लावतालो। <verse eid="ACT 19:24" /><verse number="25" style="v" sid="ACT 19:25" />एने तो ओहला केरनारा कारागीराह टोलवीन केयो, “एय बाहख, दोन्दा माय आपुह पोयशा जुड़तेह ज्यो तुमूह मालुम हे। <verse eid="ACT 19:25" /><verse number="26" style="v" sid="ACT 19:26" />एने तुमू देखतेह एने होमेलतेह काय आथा केरीन बाणायेल ज्यो बोगवान नाय मीले, ज्यो पौलुस इफिसुस माय ओलोच नाह, पुण आखा आसीयान माणहाह इहकेरीन किन जुलूम माणहाह सोमजाड़ेल एने मानाड़ लियेल हे। <verse eid="ACT 19:26" /><verse number="27" style="v" sid="ACT 19:27" />ता माय आपणा दोन्दान बदनाम एणेन दुको हे, ज्यो ओलोच नाह। पुण ज्यी मोटली अरतीमीस देवीन पुजा आखो आसीया, एने आखी दुनियान माणहे केरतेह, तीन मान सम्मान कोम एय जाय!”<verse eid="ACT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28" />ज्यो होमलीन माणहान गेरदी खीजवाय गियी, एने आयड़ी आयड़ीन केणे बाज गीया, “इफिसुस ने अरतीमीस देवी मोठी हे।” <verse eid="ACT 19:28" /><verse number="29" style="v" sid="ACT 19:29" />ओलाच माय आखा हेयराम देंगो एय गीयो। एने पौलुसान हाती गयुस एने अरीस्तर्खुस, जा मकादुनिया माय रेन आयेल एता, ताह देऱ्या एने एकठास दोवड़ावीन सोंग केरन्या गेरा माय ली गीया। <verse eid="ACT 19:29" /><verse number="30" style="v" sid="ACT 19:30" />जेवी पौलुस ता माय जाणेन होदतालो, पुण विश्वासी ताह जाणे नाह देना। <verse eid="ACT 19:30" /><verse number="31" style="v" sid="ACT 19:31" />आसीयान जा आदिकारी एता, एने ता माय रेन थोड़ाक तान हाती एता, ता ज्यो केय मोकल्या काय सोंग केरन्या गेरा माय जाईन दोकाम मा पुड़ेह। <verse eid="ACT 19:31" /><verse number="32" style="v" sid="ACT 19:32" />तेवी थोड़ाक माणहे आयेड़ने बाज गीया, एने थोड़ाक कायच केरताला एने ओहली मोटली गेरबेड़ एणे बाजरियेल एती, एने ताहरी आपु काहा टोलवानाह ज्यो जुलूम माणहाह मालुम नाह पोड़नो। <verse eid="ACT 19:32" /><verse number="33" style="v" sid="ACT 19:33" />ओवता आलेकजांडराह यहुदि माणहे गेरदी माय रेन बाहेर काड्या। तेवी आलेकजांडर आथा केरीन ईसारो केरीन सोतान बाराम माणहाह सोमजाड्यो। <verse eid="ACT 19:33" /><verse number="34" style="v" sid="ACT 19:34" />जेवी ताह मालुम पोड़नो काय तो यहुदि हे, तेवी ता आखान आखा दुय गेंटा वोर इहकेरीन केयीन आयेड़तेच रेना: “इफिसुस ने अरतीमीस देवी मोठी हे!”<verse eid="ACT 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35" />तेवी हेयरान मोंत्री माणहाह ठावका केरीन केयो, “एय इफिसुस वाला माणहे! काय दुनिया माय ओहलो एगदो माणुह हे जो नाह जाणेत काय इफिसुस ने हेयरान मोटली देवी अरतीमीस ने, एने जुगाम रेन पोड़नार चोखाला देगड़ान राखवाल केरनार हे। <verse eid="ACT 19:35" /><verse number="36" style="v" sid="ACT 19:36" />जेवी ज्‍यु वातु नाकारता नाह आवीत। तानकेरीन हाजो हे काय तुमू आखा ठावका रिवो, एने बिगेर सोच सोमजीन काय मा किरो। <verse eid="ACT 19:36" /><verse number="37" style="v" sid="ACT 19:37" />काहाकाय जा माणहाह तुमू लाव रेनाह ता नाह मोंदिरीह लुटणारे हेते, एने नाह आमरी देवीन बाराम खाराब केतेह। <verse eid="ACT 19:37" /><verse number="38" style="v" sid="ACT 19:38" />तानकेरता दिमेत्रयुस एने तान हाती कारागीरा हेऱ्यी काह शिकायत एय ते कोरटो उगाड़लोच हे, एने नियाव केरनारे आदिकारी हेतेच; तान ओंगाण किवो। <verse eid="ACT 19:38" /><verse number="39" style="v" sid="ACT 19:39" />पुण एगदा कायदान वातीन बाराम काह फुसणे होदतेती, ते पोंचाम फेसलो एय सिकेह। <verse eid="ACT 19:39" /><verse number="40" style="v" sid="ACT 19:40" />काहाकाय आज ज्या देंगान काय कारेण हे, ज्यो जापाप आपुह आपता ओवड़ी ओहलो नाह सोतो। एने जी ईयेल हे, ती वाती पोर रेन आपुह बिय हे।” <verse eid="ACT 19:40" /><verse number="41" style="v" sid="ACT 19:41" />इहकेरीन केयीन पोंचाह बोंद केर दिनो।<verse eid="ACT 19:41" /></para>
  <chapter eid="ACT 19" />
  <chapter number="20" style="c" sid="ACT 20" />
  <para style="s">मकादुनिया एने अखाया माय पौलुस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1" />जेवी देंगो थोब गीयो, तेवी पौलुस विश्वासीह हादिन उत्साह वोड़ायो। एने तान खुबेर लेन तो मकादुनियाम जात रेनो। <verse eid="ACT 20:1" /><verse number="2" style="v" sid="ACT 20:2" />पौलुस ता आखा देसा माय जाणेन बुखेत, तावाला माणहाह जुलूम उत्साहित केरती लेन अखाया माय पोचनो। <verse eid="ACT 20:2" /><verse number="3" style="v" sid="ACT 20:3" />पौलुस ताहरी तीन मोयना वोर रिनो, एने जेवी तो डोंडह्‍याम बोहीन सीरीया देसाम जाण्यो ईतो, तेवी यहुदि माणहे ताह मारनेन केरता योजना बाणावणे बाजरियेल एता, तानकेरता पौलुस मकादुनियाम रेन पोशो वोलीन जाणेन निर्णय किऱ्यो। <verse eid="ACT 20:3" /><verse number="4" style="v" sid="ACT 20:4" />बिरीयान पुरूर्स ने बिटोख सोपत्रुस, थिस्सलुनिक्यो माय रेन अरीस्तर्खुस एने सीकुन्दुस; दिरबेन गयुस; एने आसीया ईलाकान तुखीकुस एने त्रुफिमुस; एने तीमुथीयुस ज्या आखा पौलुसा हेऱ्या एता। <verse eid="ACT 20:4" /><verse number="5" style="v" sid="ACT 20:5" />पुण ता ओंगाण जात रेना एने त्रोआस माय आमरी वाट जोवते रेना। <verse eid="ACT 20:5" /><verse number="6" style="v" sid="ACT 20:6" />एने अखमीरी रोटान तिवार निवेरनेन पासाण आमु फिलेपी रेन डोंडह्‍याम बोहीन पाच दिह्यान पासाण त्रोआस माय ता फाय पोच गीया, एने आमु ताहरी हात दिह वोर रेना।<verse eid="ACT 20:6" /></para>
  <para style="s">पौलुसान त्रोआस माय सेवली वार बेट केरनो</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7" />
    <note caller="+" style="f">
      <char style="fr" closed="false">20:7 </char>
      <char style="ft" closed="false">सेनिवार नाहते दितवार</char>
    </note>जेवी आमु एप्तान पेल्ले दिह हांज पोर रूटो खाणेन केरता एकठा एना। तेवी पौलुस ता हिऱ्यो आदि रात वोर ता हिऱ्यो वातु किरते रिनो, काहाकाय दिहरे दिह जाण्यो ईतो केरीन पौलुस आदि रात वोर हिकवोण दिते रिनो। <verse eid="ACT 20:7" /><verse number="8" style="v" sid="ACT 20:8" />जी उपेरली खोली माय आमु टोलवायेल एता, ताहरी जुलूम होवटा दिवा हेलेगताला। <verse eid="ACT 20:8" /><verse number="9" style="v" sid="ACT 20:9" />एने युतूखुस नावान एक जुवान खिड़की हिऱ्यो बोहीन बारी निंद से डोलाणे बाजरियेल ईतो, जेवी पौलुस जुलूम वार वोर बोलते रिनो, ते ताह निंद आव लागी, एने तो तिसरी खोली पोर रेन जाय पोड़नो। एने जेवी ताह उगाड्या, तेवी तो मुरेल ईतो। <verse eid="ACT 20:9" /><verse number="10" style="v" sid="ACT 20:10" />पुण पौलुस बुंदे उतरीन ता हिऱ्यो विलगी गीयो, एने गेले मिलीन केयो, “बिवो मा; काहाकाय ज्यो उंजु जीवतालोच हे।” <verse eid="ACT 20:10" /><verse number="11" style="v" sid="ACT 20:11" />ओवतो पौलुस उपेर गीयो रूटो मुड़ीन खादो, एने ता हिऱ्यो उठ्यान वेगोच वोर वातु किरते रिनो, ओवतो ता रेन पौलुस जात रिनो। <verse eid="ACT 20:11" /><verse number="12" style="v" sid="ACT 20:12" />एने ता जुवानाह ता जीवतालो लावा एने ताह जुलूम उत्साह जुड़नो।<verse eid="ACT 20:12" /></para>
  <para style="s">त्रोआस माय रेन मीलेतुस माय जाणो</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13" />आमु पेलुच जाईन डोंडह्या माय बोहीन अस्सुस निही ज्यी विचार से ओंगाण गीया, काय ता रेन आमु पौलुसाह बोहाड़ लेहु। काहाकाय तो खुद ठेरायेल ईतो काय पाय पाये आवुह। <verse eid="ACT 20:13" /><verse number="14" style="v" sid="ACT 20:14" />जेवी पौलुस अस्सुस माय आमुह मिलनो ते आमु ताह डोंडह्या माय बोहाड़ लेदा, एने मीतुलेन गाव माय जात रेना। <verse eid="ACT 20:14" /><verse number="15" style="v" sid="ACT 20:15" />ता रेन डोंडह्या माय आमु दिहरे दिह खीयुस हेयरान सामने आवा। एने तान ओगले दिह सामुस गाव माय पोचना, ओवता ओगले दिह मीलेतुस गावा माय आवा। <verse eid="ACT 20:15" /><verse number="16" style="v" sid="ACT 20:16" />माहु आसीया माय जुलूम दिह रेणे नाय पोड़ी, केरीन इफिसुसाह टेलीन जाणेन पौलुस ठेरायेल ईतो। काहाकाय किहीक बी केरीन पिन्तेकुस्त ने दिह्या तिवारा माय मी यरूशलेम माय रेणे जुवे, ज्यानकेरता तो उतवाल केरतालो।<verse eid="ACT 20:16" /></para>
  <para style="s">पौलुस इफिसुस ने डावालाह आखरी वार पारचार केरनो</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17" />ओवतो पौलुस मीलेतुस गाव रेन इफिसुस माय खुबेर लेय मुकल्यो, एने मोंडलीन डायडायाह हादाड़ लिदो। <verse eid="ACT 20:17" /><verse number="18" style="v" sid="ACT 20:18" />एने जेवी ता पौलुसा फाय आवा, ते ताह केयो, “तुमू खुद जाणतेह काय जेवी मी आसीया माय पेल्लेच दिह रेन पाय मिल्यो, किहकेरीन मी तुमरी हिऱ्यो पुरी टेम रेन रिनो। <verse eid="ACT 20:18" /><verse number="19" style="v" sid="ACT 20:19" />मतलब जुलूम गेरबोड़ाय से, एने आहवा गेलावी गेलावीन एने त्यु पारेख माय बी, जो यहुदिन योजनान वोजेसे जी मार पोर आव पुड़ेल एती, मी मालीकान सेवा किरतेच रिनो। <verse eid="ACT 20:19" /><verse number="20" style="v" sid="ACT 20:20" />एने ज्‍यु ज्‍यु वातु तुमरी बोलायीन केरता एत्यु, त्युह केणेन एने माणहान सामने एने गेरा गेरा हिकाड़नेन केसर नाह सोड्यो। <verse eid="ACT 20:20" /><verse number="21" style="v" sid="ACT 20:21" />पुण पापा माय रेन मोन फिरावीन बोगवानान उगे वोलो, एने आपणा मालीक यीशु मसी पोर बुरहो केरने ज्यान बाराम यहुदि एने बिगेर यहुदि न्याह मी गोवाय देतालो। <verse eid="ACT 20:21" /><verse number="22" style="v" sid="ACT 20:22" />पुण एवी दिखो, मी चोखाला जीवान उकुमान गेत यरूशलेम माय जाथु, एने ताहरी माहु काय काय एय तो मालुम नाह। <verse eid="ACT 20:22" /><verse number="23" style="v" sid="ACT 20:23" />मी ओलोस जाणथो काय एकेक गावा माय माहु चोखालो जीव चेतावणी आपेह, काय जेल एने तेकलीत मारी वाट जोवतेह। <verse eid="ACT 20:23" /><verse number="24" style="v" sid="ACT 20:24" /><note caller="+" style="x"><char style="xo" closed="false">20:24 </char><char style="xt" closed="false"><ref loc="2TI 4:7">2 तीमुथीयुस 4:7</ref></char></note>पुण मी मार जीवणान काय किमोत नाह सोमजेत; पुण मी ओलोस होदथु काय मालीक यीशुन होपेल कामाह पुरो केरू, तो काम ज्यो हे काय बोगवानान गीणीन हाजाली खोबरीन गोसणा केरू।”<verse eid="ACT 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25" />एने एवी दिखो, मी जाणथो, तुमू आखा जा माय मी बोगवानान राज ने पारचार किरते फिरेल ईतो। पुण माहु तुमू पोशा नाय दिखहो। <verse eid="ACT 20:25" /><verse number="26" style="v" sid="ACT 20:26" />तानकेरता मी आजीन दिह तुमूह गोसणा केरथु, “केदी तुमरे माय रेन एगदो खेतेम एय जाय, ते मी तान जिम्मेदार नाह सोतो। <verse eid="ACT 20:26" /><verse number="27" style="v" sid="ACT 20:27" />काहाकाय मी बोगवानान आखी योजनाह तुमरी केरता हे तुमूह केणेन केसर नाह सोड्यो। <verse eid="ACT 20:27" /><verse number="28" style="v" sid="ACT 20:28" /><note caller="+" style="f"><char style="fr" closed="false">20:28 </char><char style="ft" closed="false">बोगवान; थोड़ाक लेख माय मालीक लिखेल हे। तान बेटाख ने लुय केरीन; नाहते तान बेटाख ने खुद अर्पण किरेल मोत केरीन।</char></note>तुमरो एने तुमरा आखा टोलान राखवाली किरते रिवो। चोखालो जीव ताम रेन तुमूह कालजी केरनार ठेरायेल हे काय तुमू बोगवानान ती मोंडलीन राखवाली किरो, जीह बोगवान तान लुयी केरीन वेचातो लियेल हे। <verse eid="ACT 20:28" /><verse number="29" style="v" sid="ACT 20:29" />मी जाणथो काय मार जाणेन पासाण फाड़ खाणारे कोलवा तुमरी विची माय आवती, एने ता बोला टोलाह नाय सोड़ती। <verse eid="ACT 20:29" /><verse number="30" style="v" sid="ACT 20:30" />एने ओहली टेम आवी काय तुमरा खुद ने टोला माय रेन ओहला माणहे उठती, जा विश्वासीह तान पासाण खेचणेन केरता जुठी वातु केती। <verse eid="ACT 20:30" /><verse number="31" style="v" sid="ACT 20:31" />तानकेरता जोगवीन रिवो, एने एर किरो काय मी तीन वोरह्या वोर रात दिह आहवा गाली गालीन एका एकाह हिकाड़ेल हे।”<verse eid="ACT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32" />“एने एवी मी तुमूह बोगवान एने तान गीणीन खोबरीन आथाम चोखो केरीन होप देथु, तोस तुमूह बांद सिकेह एने बोगवानान आखा माणहा हेऱ्यो तुमूह बोरकेत आपाड़ सिकेह। <verse eid="ACT 20:32" /><verse number="33" style="v" sid="ACT 20:33" />मी कुणीन बी होना चांदीन एने फाड़कान लोब नाह किऱ्यो। <verse eid="ACT 20:33" /><verse number="34" style="v" sid="ACT 20:34" />तुमू खुद जाणतेह काय माहु एने मार हातीन गिरेज पुरी केरनेन केरता मी मार आथा केरीन काम किरेल हे। <verse eid="ACT 20:34" /><verse number="35" style="v" sid="ACT 20:35" />मी तुमूह आखो काय केरीन देखाड़ेल हे काय तुमू बी इहीचकेरीन केरीन केठीण मेहनेत केरीन कोमजोराह होमालो, एने मालीक यीशुन त्यु वातुह एर मीलो जो तो खुद कियेल हे, ‘लेणेह रेन आपणे हाजो हे।’”<verse eid="ACT 20:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36" />इहकेरीन केयीन पौलुस ता हिऱ्यो मांड्या वोलीन आखा विन्ता केऱ्या। <verse eid="ACT 20:36" /><verse number="37" style="v" sid="ACT 20:37" />तेवी ता आखा जुलूम रेड़ना एने पौलुसान गेले लागीन ताह जुलूम गुल्‍या दिन मोकेल देना। <verse eid="ACT 20:37" /><verse number="38" style="v" sid="ACT 20:38" />ता खास केरीन ज्यी वातीन केरता दुखी एता, जीह पौलुस कियेल ईतो काय तुमू मारो मुय पोशा नाय दिखहो, एने ता पौलुसाह डोंडह्या हेऱ्या वोर पोचाड़ देना।<verse eid="ACT 20:38" /></para>
  <chapter eid="ACT 20" />
  <chapter number="21" style="c" sid="ACT 21" />
  <para style="s">पौलुसान यरूशलेम माय जाणे</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1" />जेवी ज्यो कार्यक्रम खेतेम एय गीयो, तेवी आमु ता हेऱ्या रेन आलेग एन डोंडह्या माय निकेलना, ते आमु हुतरा कोस हेयरा माय पोच गीया; एने दिहरे दिह रूदुस माय एने ता रेन पतरा माय गीया। <verse eid="ACT 21:1" /><verse number="2" style="v" sid="ACT 21:2" />ताहरी फीनीके माय जाणार एक डोंडह्यो मिलनो, आमु ता माय बोहीन चाल पोड़ना। <verse eid="ACT 21:2" /><verse number="3" style="v" sid="ACT 21:3" />जेवी आमुह साइप्रस देखानो, तेवी ताह डाखरे उगे टाकीन सीरीया निही जाईन सुर माय उतेरना। काहाकाय ताहरी डोंडह्यान सामान उतारनु एतो। <verse eid="ACT 21:3" /><verse number="4" style="v" sid="ACT 21:4" />ताहरी आमु थोड़ाक विश्वासी जुड़ना, एने आमु ता हेऱ्या एक एप्तो वोर रेना। चोखाला जीवाम बोरायीन पौलुसाह केया तु यरूशलेम माय मा जाहे। <verse eid="ACT 21:4" /><verse number="5" style="v" sid="ACT 21:5" />जेवी ताहरी आमरो रेणेन टेम पुरो एय गीयो, ते आमु ता रेन चाल देना। एने आखान बायकु एने सोरा बेल आमुह गावान बाहेर देरीयान दिड़े वोर पोचाड़ने आवा, एने आमु आखा मांड्या वोलीन विन्ता केऱ्या। <verse eid="ACT 21:5" /><verse number="6" style="v" sid="ACT 21:6" />एने एका दिहरा हेऱ्या रेन आंगे एन आमु डोंडह्या माय बोह गीया, एने ता आप आपणे गेर पोशा वोलीन जात रेना।<verse eid="ACT 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7" />तेवी आमु सुर रेन पाण्याम जाणो पुरो केरीन पतुलीमयीस माय पोचना, एने विश्वासी बायाख मिलीन आमु ता हेऱ्या एक दिह रेना। <verse eid="ACT 21:7" /><verse number="8" style="v" sid="ACT 21:8" /><note caller="+" style="x"><char style="xo" closed="false">21:8 </char><char style="xt" closed="false"><ref loc="ACT 6:5">प्रेरितान काम 6:5</ref>; <ref loc="ACT 8:5">8:5</ref></char></note>ओवता दिहरे दिह आमु ता रेन निकलीन केसरीया माय आवा। एने हाजाली खोबरीन पारचार केरनारान फिलीपुसान गेर जाईन ता फाय थोबना, जो हात माय रेन एक ईतो। <verse eid="ACT 21:8" /><verse number="9" style="v" sid="ACT 21:9" />तान चार कुवाऱ्यु सोर्‍यु एत्यु ज्‍यु बोगवाना फाय रेन आवणार जाणाव ने पारचार केरताल्यु। <verse eid="ACT 21:9" /><verse number="10" style="v" sid="ACT 21:10" /><note caller="+" style="x"><char style="xo" closed="false">21:10 </char><char style="xt" closed="false"><ref loc="ACT 11:28">प्रेरितान काम 11:28</ref></char></note>जेवी आमुह ताहरी रेतालान मोकता दिह एय गीया, ते यहुदिया रेन अगबुस नावान एक जाणाव केरनार ताहरी आवो। <verse eid="ACT 21:10" /><verse number="11" style="v" sid="ACT 21:11" />तो आमरी फाय आवीन एने पौलुसान पोट्टो लिदो, एने तान आथ पाय बांदिन केयो, “चोखालो जीव इहकेरीन किथे काय ज्यो पुट्टो जा माणहान हे ताह यरूशलेम माय यहुदि माणहे इहकेरीन बांदती, एने बिगेर यहुदिन आथा माय होपती।”<verse eid="ACT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12" />जेवी आमु ज्‍यु वातु होमल्या ते आमु एने ताहरी वाला माणहे बी पौलुसाह यरूशलेम जाय मा, इहकेरीन विन्ता केऱ्या। <verse eid="ACT 21:12" /><verse number="13" style="v" sid="ACT 21:13" />पुण पौलुस जापाप आप्यो, “तुमू ज्यो काय केरतेह काय रेड़ रेड़ीन मारा मोनाह तोड़तेह? मी ते मालीक यीशुन नावान केरता यरूशलेम माय नाह निस्तो बांदाणे ओलोस पुण मोरनेन केरता बी तियार हे।”<verse eid="ACT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 21:14" />जेवी पौलुस नाह मान्यो, ते आमु ज्यो केयीन ठावका एय गीया, “मालीकान मोरजी पुरी एय।”<verse eid="ACT 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15" />थोड़ाक दिह काड़नेन बाद, आमु आमरी तियारी केरीन यरूशलेमान उगे चाल देना। <verse eid="ACT 21:15" /><verse number="16" style="v" sid="ACT 21:16" /><note caller="+" style="f"><char style="fr" closed="false">21:16 </char><char style="ft" closed="false">एने जान गीर आमु रेण्या एता तान गीर आमुह ली गीया; नाहते जान गेरा माय आमु रेण्या एता ता माणहाह आमरी हेऱ्या ली आवा।</char></note>केसरीया माय रेन बी थोड़ाक चेला आमरी हेऱ्या चाल देना, एने आमुह साइप्रसान मनासोन नावान एक जुनाला विश्वासी फाय ली गीया, काय आमु ता फाय रेहु।<verse eid="ACT 21:16" /></para>
  <para style="s">पौलुस याकुबाह मीलाणे</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17" />जेवी आमु यरूशलेम माय पोचना, ते विश्वासी बाहख जुलूम खुसी माय आमरो स्वागत केऱ्या। <verse eid="ACT 21:17" /><verse number="18" style="v" sid="ACT 21:18" />तेवी दिहरे दिह पौलुस आमुह लेन याकुब फाय गीयो, जाहरी आखा मोंडलीन डावाला टोलवाय रियेल एता। <verse eid="ACT 21:18" /><verse number="19" style="v" sid="ACT 21:19" />तेवी पौलुस ताह नमस्‍कार केरीन जो जो काम बोगवान तान सेवान द्‍वारा बिगेर यहुदि माय किरेल ईतो, एक एक केरीन आखो केयो। <verse eid="ACT 21:19" /><verse number="20" style="v" sid="ACT 21:20" />ज्यो होमलीन ता बोगवानान बोड़ाय केऱ्या, एने पौलुसाह केया, “एय बाहख, तु ते दिखेह काय यहुदि माय रेन एजार माणहे बुरहो किरेल हेते, ता आखा नेमान बाराम उत्साही रेणारे हेते। <verse eid="ACT 21:20" /><verse number="21" style="v" sid="ACT 21:21" />एने ताह तारे बाराम कियेल हेते काय तु बिगेर यहुदि माय रेणाराह यहुदिह ज्यो हिकाड़ेह काय मुसान नेमाह सोड़ देणेन हिकाड़ेह, एने किथे काय तुमरा सोरान खेतना मा केरावो, एने रित्यु पोर मा चालो। <verse eid="ACT 21:21" /><verse number="22" style="v" sid="ACT 21:22" />ते ओवतो काय किरज्‍यो? माणहे जोरेवरी ज्यो होमेलती काय तु आयेल हे। <verse eid="ACT 21:22" /><verse number="23" style="v" sid="ACT 21:23" />केरीन आमु तुवाह जो केतेह तो केर, जा मन्नत मानेन हेते, ओहला आमरे माय चार जाणे हेते। <verse eid="ACT 21:23" /><verse number="24" style="v" sid="ACT 21:24" /><note caller="+" style="f"><char style="fr" closed="false">21:24 </char><char style="ft" closed="false">ता आखा टाली केऱ्या। देखी 18:18 </char></note>ताह लेन ता हिऱ्यो जाईन चोखो केरनाराम बेचकाय जा, एने ताह खीरचो आप काय ता तान मुंड बोड़ावे। तेवी आखा माणहे जाण जाती काय ज्‍यु वातु तार बाराम ताह कियेल एत्यु त्यु ते खेरी नाह, पुण ज्यो काय तु खुद बी मुसान नेमाह पालेन केरती लेन तान गेत चालेह। <verse eid="ACT 21:24" /><verse number="25" style="v" sid="ACT 21:25" /><note caller="+" style="x"><char style="xo" closed="false">21:25 </char><char style="xt" closed="false"><ref loc="ACT 15:29">प्रेरितान काम 15:29</ref></char></note>पुण ता बिगेर यहुदिन बाराम जा बुरहो किरेल हेते, आमु ज्यी राय केरीन चिट्ठी लेख मोकलेल हेते काय मुरतीन सामने बोली किरेल माह एने लुयीह रेन, गिलो दाबीन मारील जेनवेरान माहाह रेन, एने सिनालाह रेन वोचीन रिवो।”<verse eid="ACT 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26" />तेवी पौलुस ता माणहाह लेन दिहरे दिह ता हिऱ्यो चोखो एन मोंदिर माय गीयो, एने ताहरी केय दिनो काय चोखो एणेन दिह केवीह पुरा एती, आपणे माय रेन आखान केरता बोली केवीह चेड़ावाय जाय।<verse eid="ACT 21:26" /></para>
  <para style="s">मोंदिर माय पौलुसान देराणो</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27" />जेवी ता हात दिह पुरा एणेन एता, तेवी आसीया ईलाकान यहुदि पौलुसाह मोंदिर माय देखीन आखा माणहाह बोड़काव देना एने पौलुसाह देर लेदा। <verse eid="ACT 21:27" /><verse number="28" style="v" sid="ACT 21:28" />एने ता आयड़ीन केया, “एय इस्राएली! आमरी मोदेक किरो! ज्यो तोस एदमी हे, जो इस्राएली माणहान, एने मुसान नेमान, एने ज्या मोंदिरान विरोद माय आखी जागे आखा माणहाह हिकाड़ेह, न्या वोर काय बिगेर यहुदिह बी मोंदिर माय लावीन ज्या चोखाला मोंदिराह विटाल दियेल हे!” <verse eid="ACT 21:28" /><verse number="29" style="v" sid="ACT 21:29" /><note caller="+" style="x"><char style="xo" closed="false">21:29 </char><char style="xt" closed="false"><ref loc="ACT 20:4">प्रेरितान काम 20:4</ref></char></note>ता ज्यो ज्यानकेरता कियेल, काहाकाय ज्यान पेल त्रुफिमुस नावान इफीसीह पौलुस हिऱ्यो हेयरा माय दिखेल एता, एने ज्यो सोमज्या काय पौलुस ओयाह मोंदिर माय लेन आयेल हे।<verse eid="ACT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30" />तेवी आखा हेयरान माणहे बोड़ेक उठना, एने आखा माणहे दोवड़ीन टोलवाय गीया, एने ता पौलुसाह देरीन मोंदिर माय रेन बाहेर गीहलीन लावा, एने चालोच बायणो बोंद केर देना। <verse eid="ACT 21:30" /><verse number="31" style="v" sid="ACT 21:31" />जेवी माणहान गेरदी पौलुसाह मार टाकणे होदताला, तेवी रोमी टोलान सेनापोती फाय ज्यी खुबेर पोचनी काय आखा यरूशलेम माय देंगो एय जायेल हे। <verse eid="ACT 21:31" /><verse number="32" style="v" sid="ACT 21:32" />तेवी तो चालोच सिपायाह एने आदिकारीह लेन माणहान उगे दोवेड़ पोड़नो, एने जेवी माणहे सेनापोती एने सिपायाह देख्या, ते पौलुसाह देणेन बोंद केर देना। <verse eid="ACT 21:32" /><verse number="33" style="v" sid="ACT 21:33" />तेवी सेनापोती पौलुसान आहने आवो, बोंदी बाणाव लिदो; एने दुय हाकुल केरीन बांदणेन उकुम आपीन फुसणे बाज गीयो, “ज्यो कुण हे, एने ज्यो काय किरेल हे?” <verse eid="ACT 21:33" /><verse number="34" style="v" sid="ACT 21:34" />पुण गेरदी माय रेन कुण काय एने कुण काय आयेड़ते रेना, एने ता देंगान वोजेसे जेवी तो खेरी वात नाह सोमेज सेकनो, ते पौलुसाह किल्‍ला माय ली जाणेन उकुम आप्यो। <verse eid="ACT 21:34" /><verse number="35" style="v" sid="ACT 21:35" />जेवी पावतीरी पोर पोचना ते बिड़ माय पुसरेल हिंसान केरता पौलुसान रेकशान ईसाब माय सिपाय पौलुसाह उखलीन ली जाणे पोड़नो। <verse eid="ACT 21:35" /><verse number="36" style="v" sid="ACT 21:36" />काहाकाय माणहान गेरदी इहकेरीन आयेड़ते लेन तान पासाण पुड़ेल एती, “ज्याह खेतेम केर दिवो।”<verse eid="ACT 21:36" /></para>
  <para style="s">पौलुस खुद ने बचाव केरने</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37" />जेवी सिपाय पौलुसाह किल्‍ला माय ली जाणे केरताला, तेवी पौलुस सेनापोतीह फुशो, “मी तुवाह काह केय सेकथु?” तेवी तो पौलुसाह फुशो, “काय तु युनानी बाषा जाणेह? <verse eid="ACT 21:37" /><verse number="38" style="v" sid="ACT 21:38" />काय तु मीस्री माणुह ते नाह, जो थोड़ाक दिह्यान पेल विद्रोह सुरू केरायेल ईतो, एने चार एजार आथ्‍यारबंद आतंगवादी माणहाह जेंगला माय आगवाय केरने बाजरियेल ईतो?” <verse eid="ACT 21:38" /><verse number="39" style="v" sid="ACT 21:39" />पुण पौलुस केयो, “मी ते तरसुस ने यहुदि माणुह हे, किलीकीयान नाव लायेल हेयरा माय रेणार हे। मी तुवाह विन्ता केरथु काय माहु माणहा हिऱ्यो वातु केरने दे।” <verse eid="ACT 21:39" /><verse number="40" style="v" sid="ACT 21:40" />जेवी सेनापोती उकुम आप्यो, ते पौलुस पावतीरी पोर उबरीन माणहाह आथा केरीन ठावका किऱ्यो। जेवी ता ठावका एय गीया, तेवी पौलुस इब्रानी बाषा माय बोलने बाज गीयो।<verse eid="ACT 21:40" /></para>
  <chapter eid="ACT 21" />
  <chapter number="22" style="c" sid="ACT 22" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1" />पौलुस केयो, “एय मारा यहुदि बाहख एने आबहेख, बाराबोर मारा माणहा मारा वोचाव माय जो काय केणे होदथु तो हुमलो।” <verse eid="ACT 22:1" /><verse number="2" style="v" sid="ACT 22:2" />ता ज्यो होमलीन काय तो आमु हिऱ्यो इब्रानी बाषा माय बुलीह, उंजु बी ठावका एय गीया। तेवी पौलुस केयो:<verse eid="ACT 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 22:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">22:3 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 5:34-39">प्रेरितान काम 5:34-39</ref>
      </char>
    </note>“मी एक यहुदि माणुह हे, किलीकीयान तरसुस माय मारो जेल्मो ईयेल एतो, एने ज्या यरूशलेम गावा माय पोहायेल एने गमलीएलान पाया हेऱ्यो बोहीन बाप दादान केठीण नियमाह आत किरेल, एने बोगवानान केरता मी जुलूम समर्पित ईतो, जिहकेरीन तुमू आज हेते। <verse eid="ACT 22:3" /><verse number="4" style="v" sid="ACT 22:4" /><note caller="+" style="x"><char style="xo" closed="false">22:4 </char><char style="xt" closed="false"><ref loc="ACT 8:3">प्रेरितान काम 8:3</ref>; <ref loc="ACT 26:9-11">26:9-11</ref></char></note>मी एदमी एने बायकु दुयूह आरोपी बाणावीन जेली माय देरीन टाकेल ईतो, एने ज्या पंथाह न्या वोर वेला केरायेल काय ताह माराव बी दियेल। <verse eid="ACT 22:4" /><verse number="5" style="v" sid="ACT 22:5" />मुखी चाकऱ्या एने आखा डायडाया मी तुमूह खेरी केथु ज्यी वातीन पुरावो हे मी दमिश्‍क माय यहुदि बायाख ने नावा पोर चिट्ठी बी लियेल ईतो। दमिश्‍क माय जाणेन केरता जा माणहे ज्यी वाटे चालतेह ताह बांदिन यरूशलेम माय लेन आवो काय ताह डेंड आपाड़ सेकु।”<verse eid="ACT 22:5" /></para>
  <para style="s">पौलुस तान मोन बोदेलनेन बाराम केणे</para>
  <para style="r">(<ref loc="ACT 9:1-19">प्रेरितान काम 9:1-19</ref>; <ref loc="ACT 26:12-18">26:12-18</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6" />जेवी मी यात्रा किरतेन दमिश्‍क ने आहने पोचनो, ते उचकाहुच ओहलो एनो काय हिराणने बुखेत जुगाम रेन एक मोटलो उजालो मार कावदेन चोमेकनो। <verse eid="ACT 22:6" /><verse number="7" style="v" sid="ACT 22:7" />एने जेवी मी बुय पोर जाय पोड़नो, ते ज्यो आवाज होमल्यो, “एय शाऊल, एय शाऊल! तु माहु काहा वेला केरावेह?” <verse eid="ACT 22:7" /><verse number="8" style="v" sid="ACT 22:8" />मी जापाप आप्यो, “एय मालीक, तु कुण हे?” तो माहु केयो, “मी यीशु नासरी हे, जाह तु वेला केरावेह।” <verse eid="ACT 22:8" /><verse number="9" style="v" sid="ACT 22:9" />एने मार हाती उजालो ते देख्या, पुण जो मार हिऱ्यो बोलतालो तान आवाज नाह होमल्या। <verse eid="ACT 22:9" /><verse number="10" style="v" sid="ACT 22:10" />तेवी मी केयो, “एय मालीक मी काय केरू?” मालीक माहु केयो, “उठीन दमिश्‍क माय जा, एने जो काय तुवाह केरनेन केरता ठेरायेल हे ता तुवाह आखो केवाय जाय।” <verse eid="ACT 22:10" /><verse number="11" style="v" sid="ACT 22:11" />तानकेरता मार हाती मार आथ देरीन दमिश्‍क माय पोचाड़ देना, काहाकाय ता उजालान वोजेसे माहु आंदलो केर दियेल ईतो।<verse eid="ACT 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12" />तेवी हनन्या नावान नेम ने गेत एक बोकत्यो माणुह, जो ताहरी रेणारान आखा यहुदिया माय हाजो नाव एतो, मार फाय आवो, <verse eid="ACT 22:12" /><verse number="13" style="v" sid="ACT 22:13" />एने उबरीन माहु केयो, “एय बाहख शाऊल, पोशो देखणे बाज्जा।” तुलेचबूखी मार डोला उगड़ी गीया, एने मी ताह दिख्यो। <verse eid="ACT 22:13" /><verse number="14" style="v" sid="ACT 22:14" />तेवी तो माहु केयो, “आपणा बाप दादान बोगवान तुवाह ज्यानकेरता ठेरायेल हे काय तु बोगवानान मोरजीह जाणे, एने ता न्यायी सेवकाह देखी, एने तान मुया केरीन वातु होमले। <verse eid="ACT 22:14" /><verse number="15" style="v" sid="ACT 22:15" />मुखी चाकऱ्या एने डायला खेरीच केथु ज्यी वातीन गोवा हे; काय ता माय रेन मी यहुदि बायाख नावा पोर चिट्ठी बी लियेल तु तान उगे रेन आखा माणहान सामने त्यु वातुन गोवा रिहे, ज्‍यु तु दिखेल एने होमलेल हे। <verse eid="ACT 22:15" /><verse number="16" style="v" sid="ACT 22:16" />एवी काहा वार लागाड़ेह? उठ, बपतीस्मा ले, एने बोगवानान नाव लेन तारा पापाह दोव टाक।”<verse eid="ACT 22:16" /></para>
  <para style="s">पौलुसाह बिगेर यहुदिम पारचार केरनेन हादावणी</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17" />जेवी मी पोशो वोलीन यरूशलेम माय जाईन, एने मोंदिर माय जाईन विन्ता केरने बाजरियेल ईतो, तेवी मी एक देरसेन दिख्यो, <verse eid="ACT 22:17" /><verse number="18" style="v" sid="ACT 22:18" />एने मी ताह दिख्यो काय मालीक माहु काय किथे, “उतवाल्युह यरूशलेम रेन निकेल जा, काहाकाय ता माणहे मार बाराम तारी गोवाय नाय मानती।” <verse eid="ACT 22:18" /><verse number="19" style="v" sid="ACT 22:19" />मी केयो, “एय मालीक, ता खुद जाणतेह काय मी तुवा पोर बुरहो केरनाराह जेली माय टाकतालो, एने आखा यहुदि बोक्ती केरन्या गेरा माय देतालो।” <verse eid="ACT 22:19" /><verse number="20" style="v" sid="ACT 22:20" /><note caller="+" style="x"><char style="xo" closed="false">22:20 </char><char style="xt" closed="false"><ref loc="ACT 7:58">प्रेरितान काम 7:58</ref></char></note>एने जेवी तारो गोवा स्तिफनुसान लुय वोवाड़ाय जाताली, तेवी मी बी ता उबरियेल ईतो एने ज्यी वाती माय मिलाय रियेल ईतो, एने ताह मारनारान फाड़कान राखवाली केरतालो। <verse eid="ACT 22:20" /><verse number="21" style="v" sid="ACT 22:21" />एने मालीक माहु केयो, “जातरे, काहाकाय मी तुवाह बिगेर यहुदि फाय सेटो सेटो मोकलुह।”<verse eid="ACT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22" />ता माणहे ज्यी वात पोर तान होमेलते रेना, तेवी मोठेस आयेड़ना, “ओहला माणहाह खेतेम किरो, ताह जी देरती पोर जीवतालो रेणेन लायकी नाह!” <verse eid="ACT 22:22" /><verse number="23" style="v" sid="ACT 22:23" />जेवी ता आयेड़ते एने फाड़का टाकती, एने वारा माय रेजड़ो उड़ावताला। <verse eid="ACT 22:23" /><verse number="24" style="v" sid="ACT 22:24" />तेवी सिपायान आदिकारी केयो, “ज्याह किल्‍ला माय ली जावो, एने कोड़ा दिन बोकरावो काय मी जाणुह काय यहुदि माणहे कायतान वोजेसे ज्यान विरोद माय ओहला आयेड़ने बाजरेनाह।” <verse eid="ACT 22:24" /><verse number="25" style="v" sid="ACT 22:25" />जेवी ता पौलुसाह बांदणे बाजरियेल एता, तेवी पौलुस ता आदिकारीह जो आहने उबरियेल ईतो, केयो, “काय ज्यो लायकी हे काय तुमू एक रोमी माणहाह, एने तो बी बिगेर गुनो ठेरायेल, कोड़ा लागाड़ो?”<verse eid="ACT 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 22:26" />आदिकारी ज्यो होमलीन पलटनान आदिकारी फाय जाईन केयो, “तु ज्यो काय किरेह? ज्यो ते रोमी माणुह हे।”<verse eid="ACT 22:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 22:27" />तेवी पलटनान आदिकारी पौलुस फाय आवीन केयो, “माहु के, काय तु रोमी हे?” पौलुस केयो, “होव।”<verse eid="ACT 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 22:28" />ज्यो होमलीन पलटनान आदिकारी केयो, “माहु रोमी बोणनेन केरता जुलूम होवटा पोयशा आपणे पुड़ेल हे।” पुण पौलुस ताह जापाप आप्यो, “मी ते पायदास रेन रोमी हे।”<verse eid="ACT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 22:29" />तेवी जा माणहे पौलुस फाय रेन जापाप लेणारे एता, ता चालोच पौलुसा हेऱ्या रेन सेटा एय गीया; एने पलटनान आदिकारी बी ज्यो जाणीन काय ज्यो रोमी रेवासी हे एने मी ज्याह बांदिल हे, बिय गीयो।<verse eid="ACT 22:29" /></para>
  <para style="s">मोटला पोंचान सामने पौलुस</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30" />दिहरे दिह तो हास केरीन पारेखणेन मोरजी से काय यहुदि पौलुसा पोर काहा गुनो लागाड़तेह, तान आतबेड्यु खोल देना; एने मुखी चाकऱ्या एने आखा मोटला पोंचाह एकठा टोलवाणेन उकुम आप्यो, एने पौलुसाह बुंदे ली जाईन तान सामने उबो केर देना।<verse eid="ACT 22:30" /></para>
  <chapter eid="ACT 22" />
  <chapter number="23" style="c" sid="ACT 23" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1" />पौलुस मोटला पोंचान उगे एक नेजेर टाकीन देखीन केयो, “एय इस्राएली बाहख! मी आज वोर बोगवानान केरता बिलकुर हाजा मोना केरीन जीवाय जियेल हे।” <verse eid="ACT 23:1" /><verse number="2" style="v" sid="ACT 23:2" />ज्या पोर हनन्या मुखी चाकर्‍यो ताह जो तान आहने उबरियेल एता, पौलुसान कानफाट्याम देणेन उकुम आप्यो। <verse eid="ACT 23:2" /><verse number="3" style="v" sid="ACT 23:3" /><note caller="+" style="x"><char style="xo" closed="false">23:3 </char><char style="xt" closed="false"><ref loc="MAT 23:27">मत्ती 23:27</ref>,<ref loc="MAT 23:28">28</ref></char></note>तेवी पौलुस ताह केयो, “एय चुनो लागाड़ेल बितड़ा, बोगवान तुवाह मारी! तु नेमान गेत मारो नियाव केरने बुहेल हे, पुण तु खुद नेमाह तोड़ीन माहु देणेन ताह उकुम आपेह!”<verse eid="ACT 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4" />जा माणहे पौलुसान आहने उबरियेल एता ता पौलुसाह केया, “तु बोगवानान मुखी चाकऱ्याह हाजो बाकतो किथे!”<verse eid="ACT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 23:5" />पौलुस ताह जापाप आप्यो, “एय इस्राएली बाहख, ज्यो मुखी चाकर्‍यो हे, ज्यो माहु मालुम नाह एतो! काहाकाय पुस्तेक माय लिखेल हे: तु आपणा माणहान आदिकारीन विरोद बाकतो मा किहे।”<verse eid="ACT 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">23:6 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 26:5">प्रेरितान काम 26:5</ref>; <ref loc="PHP 3:5">फिलेपियो 3:5</ref></char>
    </note>तेवी पौलुस ज्यो जाणीन काय एक टुलो सदुकीन एने दिहरो टुलो फरिसीन हे, मोटला पोंचाम आयड़ीन केयो, “एय इस्राएली बाहख! मी फरिसी एने फरिसीन वोचीन हे। मुरेल ने आसा एने मुरेल माय रेन पोशो जीव उठणेन बाराम मारी चोकसी एणे बाजरेनीह।”<verse eid="ACT 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 23:7" />जेवी पौलुस ज्यी वात केयो, तेवी फरिसी एने सदुकी माय राड़ एणे बाज गीयो, एने पोंचाम फुट पोड़ गियी। <verse eid="ACT 23:7" /><verse number="8" style="v" sid="ACT 23:8" /><note caller="+" style="x"><char style="xo" closed="false">23:8 </char><char style="xt" closed="false"><ref loc="MAT 22:23">मत्ती 22:23</ref>; <ref loc="MRK 12:18">मरकुस 12:18</ref>; <ref loc="LUK 20:27">लुका 20:27</ref></char></note>काहाकाय सदुकी ते ज्यो केतेह काय मुरेल माय रेन पोशो जीव उठणो ना सोतो, नाह हेरोगदुत एने नाह जीव सोतो; पुण फरिसी ज्या आखाह मानतेह। <verse eid="ACT 23:8" /><verse number="9" style="v" sid="ACT 23:9" />तेवी मोटलो गेगदो ईनो, एने थोड़ाक मुसान नेम हिकाड़नारे मास्तेर्‍या जा फरिसीन टोलान एता, उठीन उबरी गीया एने ज्यो केयीन लेड़ाणे बाज गीया: “आमु ज्या माणहा माय काय बाकतो नाह देखते! एने केदी एगदो जीव नाहते हेरोगदुत ताह कियेल हे, ते ओवतो काय!”<verse eid="ACT 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 23:10" />जेवी जुलूम राड़ एनी, तेवी पलटनान आदिकारी ज्यो बियीन काय ता पौलुसाह मार नाय देती। तानकेरता पलटनाह उकुम आप्यो काय उतरीन ताह तान विची माय रेन जोबराण निकालो, एने किल्‍ला माय ली जावो।<verse eid="ACT 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 23:11" />तीस राती मालीक पौलुसान आहने उबरीन केयो, “एय पौलुस, ईमोत मेल! काहाकाय जिहकेरीन तु यरूशलेम माय मारी गोवाय दियेल, तिहेच केरीन तुवाह रोम माय बी गोवाय देणे पोड़ी।”<verse eid="ACT 23:11" /></para>
  <para style="s">पौलुसान मोतीन षड़यंत्र</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12" />जेवी दिह उगनो ते थोड़ाक यहुदि एकठा टोलवायेन होमच्‍यो केऱ्या। एने सुगोण खादा जाह वोर आपु पौलुसाह मार नाय टाकहो, ताह वोर खाणो नाय खाहु। <verse eid="ACT 23:12" /><verse number="13" style="v" sid="ACT 23:13" />जा आपसाम ज्यो सुगोण खाईल एता, ता चालीह जाणाह रेन वोदार एता। <verse eid="ACT 23:13" /><verse number="14" style="v" sid="ACT 23:14" />ता मुखी चाकऱ्या एने डायडाया हेऱ्या जाईन केया, “आमु ज्यो ठाण लियेल हेते काय जाह वोर पौलुसाह मार नाय टाकहो, ताह वोर आमु कायच खाहु नाय। <verse eid="ACT 23:14" /><verse number="15" style="v" sid="ACT 23:15" />पोशा ता यहुदि केणे बाज गीया तानकेरता एवी तुमू मोटला पोंचान बेल पलटनान आदिकारीह सोमजाड़ो काय पौलुसाह तुमरी फाय लावी, एने ओहलो देखाड़ो काय तुमू ताह उंजु बी हास केरीन पारेखणे होदतेह। एने आमु ताह पोचणेन पेलुच पौलुसाह मार टाकणेन केरता तियार रेहु।”<verse eid="ACT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16" />जेवी पौलुस ने बोणीख ने सोरो ज्यो होमल्यो काय ताह मारनेन ताकाव रेनाह; ते किल्‍ला माय जाईन पौलुसाह खुबेर किऱ्यो। <verse eid="ACT 23:16" /><verse number="17" style="v" sid="ACT 23:17" />पौलुस सिपाया माय रेन एकाह तान आहने हादिन केयो, “ज्या जुवानाह पलटनान आदिकारी फाय ली जावो; ज्यो ताह काह केणे हुदेह।” <verse eid="ACT 23:17" /><verse number="18" style="v" sid="ACT 23:18" />तानकेरता सिपाय ताह पलटनान आदिकारी फाय ली जाईन केयो, “कोंडायेल पौलुस माहु हादिन विन्ता किऱ्यो काय ज्यो जुवान पलटनान आदिकारीह काह केणे हुदेह; ज्याह ता फाय ली जा।”<verse eid="ACT 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 23:19" />तेवी पलटनान आदिकारी तान आथ देरीन एने आलेग ली जाईन फुशो, “तु माहु काय केणे हुदेह?”<verse eid="ACT 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20" />तो केयो, “यहुदि होमच्‍यो किरेल हेते काय तुवाह विन्ता केरी काय हेकाले पौलुसाह मोटला पोंचाम लावे, ता ओहलो देखाड़ती काय उंजु हास केरीन ताह पारेख केरने होदतेह। <verse eid="ACT 23:20" /><verse number="21" style="v" sid="ACT 23:21" />पुण तान मा मानहे, काहाकाय ता माय रेन चालीह रेन होवटा माणहे पौलुसाह मारनेन पासाण पोड़ रेनाह। जाज्यो ठाण लियेल हेते काय जाह वोर ता पौलुसाह मार नाय टाकती, ताह वोर नाय खाती एने नाय पिते। एवी ता तियार हेते एने तारा निर्णयान वाट जोवणे बाजरेनाह।”<verse eid="ACT 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 23:22" />तेवी पलटनान आदिकारी जुवानाह ज्यो उकुम आपीन वोलाव दिनो, “कुणीह मा किहे काय तु माहु ज्‍यु वातु कियेल हे।”<verse eid="ACT 23:22" /></para>
  <para style="s">पौलुसाह फेलीक्‍स राज्यपाल फाय मोकेलनो</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23" />तेवी पलटनान मुखी दुय आदिकारीह हादिन केयो, “दुय होव सिपाय, सेत्तेर गोड़ सवार, एने दुय होव बोरशा लेन केसरीया माय जाणेन केरता तियार केर मीलो, तुमू रातीन नोव वासता निकेल ज्यो। <verse eid="ACT 23:23" /><verse number="24" style="v" sid="ACT 23:24" />एने पौलुसान जाणेन केरता गोड़ा तियार मीलो, काय ताह फेलीक्‍स आदिकारी फाय हाजे हुके पोचाड़ देय।” <verse eid="ACT 23:24" /><verse number="25" style="v" sid="ACT 23:25" />तो इहकेरीन चिट्ठी बी लिख्यो:<verse eid="ACT 23:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 23:26" />“महामहिम फेलीक्‍स आदिकारीह क्‍लोदियास लुसीयासाह नमस्‍कार। <verse eid="ACT 23:26" /><verse number="27" style="v" sid="ACT 23:27" />ज्या एदम्याह यहुदि देरीन मार टाकणे होद्या, पुण जेवी मी जाण्यो काय तो रोमी हे, ते सिपाय लेएन सोड़ीव लावो। <verse eid="ACT 23:27" /><verse number="28" style="v" sid="ACT 23:28" />मी जाणने होदतालो काय ता पौलुसा पोर कायतान वोजेसे दोस लागाड़तेह, तानकेरता पौलुसाह निचो तान मोटला पोंचाम ली गीयो। <verse eid="ACT 23:28" /><verse number="29" style="v" sid="ACT 23:29" />तेवी मी जाण लिदो काय ता तान नेमान बोलचालान बाराम पौलुसा पोर दोस लागाड़तेह, पुण मार टाकणेन एने बांदाय जाणेन लायेक ता माय काय दोस नाह। <verse eid="ACT 23:29" /><verse number="30" style="v" sid="ACT 23:30" />एने जेवी माहु कियेल काय ता ज्या माणहाह मारनेन ताकाव रेनाह, तेवी मी चालोच पौलुसाह तार फाय मोकली दिनो। एने आरोप लागाड़नाराह बी उकुम आप्यो काय तान लागाड़ील आरोप ता तार सामने मेली।”<verse eid="ACT 23:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31" />एने जोहली सिपायाह उकुम आपेल ईतो, तिहेस केरीन पौलुसाह रातीम रात अन्तीपत्रीस फाय ली गीया। <verse eid="ACT 23:31" /><verse number="32" style="v" sid="ACT 23:32" />दिहरे दिह गोड़ सवाराह पौलुस हेऱ्यो ओंगाण जाणेन केरता पाये चालनारे सिपाय सोड़ देना, एने वोलीन किल्‍ला माय आव गीया। <verse eid="ACT 23:32" /><verse number="33" style="v" sid="ACT 23:33" />ता केसरीया पोचीन आदिकारीह चिट्ठी आप्या, एने पौलुसाह बी तान सामने उबो केऱ्या। <verse eid="ACT 23:33" /><verse number="34" style="v" sid="ACT 23:34" />तो आदिकारी चिट्ठी वाचीन फुशो, “ज्यो काल्ला ईलाकान हे?” एने जेवी जाण गीयो काय किलीकीयान हे। <verse eid="ACT 23:34" /><verse number="35" style="v" sid="ACT 23:35" />तेवी तो केयो, “जेवी तारा विरोदी बी आवती, ते मी तारो होमेलहो।” एने तो ताह आदिकारीन राजवाड़ा माय देखरेत माय मेलनेन केरता उकुम आप्यो।<verse eid="ACT 23:35" /></para>
  <chapter eid="ACT 23" />
  <chapter number="24" style="c" sid="ACT 24" />
  <para style="s">पौलुसान विरोद माय आरोप लागाड़नो</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1" />पाच दिह्यान पासाण हनन्या मुखी चाकर्‍यो थोड़ाक डायडायाह एने तीरतुल्लुस नावान वोकीलाह आरही लेन केसरीया माय आवा। एने ता फेलीक्‍स ने सामने पौलुस पोर आरोप लागाड्या। <verse eid="ACT 24:1" /><verse number="2" style="v" sid="ACT 24:2" />जेवी पौलुसाह हादाड्या, तेवी तीरतुल्लुस पौलुसा पोर गुनो लागाड़ीन केयो,</para>
  <para style="p" vid="ACT 24:2">“एय महामहिम फेलीक्‍स! तार आगवाय माय आमु जुलूम टेम रेन मोटली सान्ती हेऱ्या रेणे बाजरेनाह, एने तार वोजेसे देसा माय जुलूम हाजो हुदारना ईयेल हे। <verse eid="ACT 24:2" /><verse number="3" style="v" sid="ACT 24:3" />ज्यीह आमु एकेक जागे एने एकेक बातीन ज्यान स्वागत केरतेह, एने आमु तार जुलूम उपकार मानतेह। <verse eid="ACT 24:3" /><verse number="4" style="v" sid="ACT 24:4" />मी नाह होदित काय तारो जास्ती टेम लेव, पुण मी तुवाह विन्ता केरथु काय तु थोड़ाक माय आमरी होमली लेय। <verse eid="ACT 24:4" /><verse number="5" style="v" sid="ACT 24:5" />काहाकाय आमु ज्या माणहाह पिड़ा आपणार एने केलीन आखा यहुदि माणहाम दिंग्गो केरावणार; एने नासरत टोलान पुडारी हे। <verse eid="ACT 24:5" /><verse number="6" style="v" sid="ACT 24:6" />ज्यो मोंदिराह एठो केरने होदतालो, पुण आमु ज्याह देर लियेल। <verse eid="ACT 24:6" /><verse number="7" style="v" sid="ACT 24:7" />पुण आदिकारी लुसीयास आवीन ताह जोबेर जोस्ती आमरा आथाम रेन सांडाड़ लिदो।<note caller="+" style="f"><char style="fr" closed="false">24:7 </char><char style="ft" closed="false">ज्यो वचन थोड़ाक लेख माय नाह जुड़ेत।</char></note> <verse eid="ACT 24:7" /><verse number="8" style="v" sid="ACT 24:8" />ज्यी आखी वातीन जीन बाराम आमु ज्या पोर गुनो लागाड़तेह, तु खुद ताह चोकसी केरीन जाण लिहे।” <verse eid="ACT 24:8" /><verse number="9" style="v" sid="ACT 24:9" />यहुदि माणहे बी तान साथ देन मोजबुत केया काय ज्‍यु वातु खेरीच हेत्यु।<verse eid="ACT 24:9" /></para>
  <para style="s">फेलीक्‍सान सामने पौलुसान वोचणो</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10" />जेवी आदिकारी पौलुसाह बोलनेन ईसारो किऱ्यो तेवी पौलुस जापाप आप्यो, “मी ज्यो जाणथु काय तु जुलूम वोरह्या रेन ज्या देसान नियाव किरेह, केरीन मी खुसी माय मार बोचावने केरता थोड्युक वातु मी तार सामने मेलने होदथु। <verse eid="ACT 24:10" /><verse number="11" style="v" sid="ACT 24:11" />तु खुद पुतो लागाड़ सिकेह काय मी यरूशलेम माय बोक्ती केरनेन केरता आवोह, एने माहु बारा दिह्यान उपेर नाह एना। <verse eid="ACT 24:11" /><verse number="12" style="v" sid="ACT 24:12" />यहुदि माहु नाह कुणी हेऱ्यो बोलचाल किरते मोंदिर माय देख्या, एने नाह यहुदि बोक्‍तीन गेरा माय एने नाह हेयरा माय माणहाह टुलो केरीन दिंग्गो केरतालो देख्या। <verse eid="ACT 24:12" /><verse number="13" style="v" sid="ACT 24:13" />एने नाह त्यु वातुह जान बाराम ता एवी मार पोर गुनो लागाड़तेह, तारे सामने ताह खेराय प्रमाणीत केर सेकतेह। <verse eid="ACT 24:13" /><verse number="14" style="v" sid="ACT 24:14" />पुण मी ज्यो तार सामने मान लेथु: एने जी वाटीह ता जुठो केतेह, तास ने रिती पोर मी आपणा बाप दादान बोगवानान बोक्ती केरथु। पुण मी ज्यो बी बुरहो केरथु, ज्‍यु वातु मुसान नेम माय एने जाणाव केरनारान पुस्तेक माय लिखेल हे। <verse eid="ACT 24:14" /><verse number="15" style="v" sid="ACT 24:15" />एने मी बोगवाना पोर तिहेस केरीन बुरहो मेलथु जिहकेरीन ज्या मेलतेह, देरमी एने एदेरमी पोशो जीव उठती तीच आसा मी बोगवाना पोर केरथु। <verse eid="ACT 24:15" /><verse number="16" style="v" sid="ACT 24:16" />ता माय मी सोता कोसीत केरथु काय बोगवानान एने माणहा माय मारो मोन चोखो रेय।”<verse eid="ACT 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17" />
    <note caller="+" style="x">
      <char style="xo" closed="false">24:17 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 21:17-28">प्रेरितान काम 21:17-28</ref>
      </char>
    </note>जुलूम वोरह्यान पासाण मी यरूशलेम माय गेरीब माणहाह दान आपणे, एने बोली चेड़ावणे आयेल हे। <verse eid="ACT 24:17" /><verse number="18" style="v" sid="ACT 24:18" />एने जेवी मी मोंदिर माय चोखो एणेन रिती पुरी केरने बाजरियेल ईतो, तेवी नाह मार वोजेसे माणहान गेरदी टुलो एनी। एने नाह असान्ती पोसरायेल एती, तेवी माहु ज्या दिरेल। <verse eid="ACT 24:18" /><verse number="19" style="v" sid="ACT 24:19" />पुण ता आसीया ईलाकान थोड़ाक यहुदि एता; केदी मार विरोद माय ता फाय काह वात एती ते न्या तार सामने आवीन मार पोर गुनो लागाड़ता। <verse eid="ACT 24:19" /><verse number="20" style="v" sid="ACT 24:20" />एने न्या खुद केय काय जेवी मी मोटला पोंचान सामने उबरियेल ईतो, ते ता मार पोर काल्लो गुनो देखल्या? <verse eid="ACT 24:20" /><verse number="21" style="v" sid="ACT 24:21" /><note caller="+" style="x"><char style="xo" closed="false">24:21 </char><char style="xt" closed="false"><ref loc="ACT 23:6">प्रेरितान काम 23:6</ref></char></note>जेवी मी तान विची माय उबरीन आयड़ीन कियेल ईतो, “मुरेलान पोशो जीव उठणेन बारा माय मार बोरहान कारेण आज तुमरे सामने नियाव एणे बाजरेनीह।”<verse eid="ACT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22" />फेलीक्‍साह ज्यी रितीन बाराम हास केरीन मालुम एतो, ताह इहकेरीन केयीन टाल दिनो, “जेवी पलटनान आदिकारी लुसीयास आवी, तेवी ज्यी वातीन बाराम फेसलो केरूह।” <verse eid="ACT 24:22" /><verse number="23" style="v" sid="ACT 24:23" />एने आदिकारी उकुम आप्यो काय पौलुसाह थोड़ोक सुट आपीन तान राखवाली किरज्‍यो, एने तान हाती माय रेन कुणीह बी तान चाकरी केरनेन मा रोकहो।<verse eid="ACT 24:23" /></para>
  <para style="s">फेलीक्‍स एने दुरसीलान ओंगाण पौलुस</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24" />ओवतो थोड़ाक दिह्यान बाद फेलीक्‍स तान यहुदि बायकु दुरसीलाह आरही लेन आवो, एने पौलुसाह हादाड़ीन ता बोरहान बाराम जो यीशु मसी पोर हे, ता फाय रेन होमल्यो। <verse eid="ACT 24:24" /><verse number="25" style="v" sid="ACT 24:25" />जेवी पौलुस हाजाल्यु वातु एने दिर, एने आवणार नियाव ने दिह्यान वातु केरतालो, तेवी फेलीक्‍स बिन जापाप आप्यो, “एवी तु जा; टेम जुड़ी ते मी पुशो तुवाह हादुह।” <verse eid="ACT 24:25" /><verse number="26" style="v" sid="ACT 24:26" />ताह पौलुसा पोर आसा एती काय पोयशा जुड़ती; तानकेरता पौलुसाह जाहार ताहार हादिन ताह हिऱ्यो वातु केऱ्या केरतालो।<verse eid="ACT 24:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 24:27" />दुय वोरह्यान बाद फेलीक्‍सान जागा पोर पोर्कियास फेस्तुस नोवालो आदिकारी आवो, एने फेलीक्‍स यहुदि माणहाह खुस केरनेन केरता पौलुसाह जेली माय मेलीन गीयो।<verse eid="ACT 24:27" /></para>
  <chapter eid="ACT 24" />
  <chapter number="25" style="c" sid="ACT 25" />
  <para style="s">पौलुस रोमी सम्राजान अपील केरने</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1" />फेस्तुस ता ईलाका माय पोचनो, एने तीन दिह्या बाद केसरीया रेन यरूशलेम माय गीयो। <verse eid="ACT 25:1" /><verse number="2" style="v" sid="ACT 25:2" />तेवी मुखी चाकऱ्या एने यहुदिन मुखी माणहे तान सामने पौलुसा पोर गुनो लागाड्या। ता फेस्तुस माय विन्ता केऱ्या। <verse eid="ACT 25:2" /><verse number="3" style="v" sid="ACT 25:3" />एने ता मुखी चाकऱ्या एने यहुदिन मुखी फेस्तुस फाय विन्ता केरने बाजरियेल एता काय पौलुसाह यरूशलेम माय हादाड़े, काहाकाय ता पौलुसाह वाटेच मार टाकणेन ताक माय एता। <verse eid="ACT 25:3" /><verse number="4" style="v" sid="ACT 25:4" />तेवी फेस्तुस जापाप आप्यो, “पौलुस केसरीया माय कोंडायेल हे, एने मी खुद उतवाल्योच ताहरी जाह।” <verse eid="ACT 25:4" /><verse number="5" style="v" sid="ACT 25:5" />पुशो केयो, “तुमू माय रेन थोड़ाक आदिकारी मार हेऱ्या केसरीया माय आवी, एने केदी ज्यो माणुह काह खाराब काम किरेल हे, ते ता पोर गुनो लागाड़े।”<verse eid="ACT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6" />फेस्तुस तान विची माय आठ दोह दिह रेयीन केसरीया जात रिनो। एने दिहरे दिह नियावान गादि पोर बोहीन पौलुसाह लावणेन उकुम आप्यो। <verse eid="ACT 25:6" /><verse number="7" style="v" sid="ACT 25:7" />जेवी पौलुस आवो, ते जा यहुदिन मुखी यरूशलेम रेन आयेल एता, ता तान कावदेन उबरी गीया एने पौलुसा पोर जुलूम मुठो गुनो लागाड़ने बाज गीया, जान पुरावो ताह देता नाह ओवोड़नो। <verse eid="ACT 25:7" /><verse number="8" style="v" sid="ACT 25:8" />पुण पौलुस खुदाह वोचाड़णेन केरता ज्यो जापाप आप्यो: “मी नाहते यहुदिन नेमान एने नाह मोंदिरान एने नाह रोमन आदिकारी केसरान विरोद काल्लो पाप किरेल हे।”<verse eid="ACT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9" />तेवी फेस्तुस यहुदिह खुस केरनेन मोरजी से पौलुसाह केयो, “यरूशलेम जाईन ताहरी मार सामने ज्यी वातीन बाराम तारो नियाव एय ओहली तारी मोरजी हे काय?”<verse eid="ACT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 25:10" />पुण पौलुस केयो, “मी केसरान नियावान गादिन सामने उबरिनोह, मारो नियाव न्यास एणे जुवे। मी यहुदिन काय बी नुकसान नाह किऱ्यो, ज्यो तु बी हास केरीन जाणेह। <verse eid="ACT 25:10" /><verse number="11" style="v" sid="ACT 25:11" />केदी मी गुनेगार हे एने माराय जाणेन लायेक एगदो काम किरेल हे, ते मोरने रेन नाकार नाह किरेत। पुण ज्‍यु वातुन ज्या मार पोर दोस लागाड़तेह, केदी ता माय रेन काल्ली बी वात खेरी नाय निकले, ते कुण बी माहु न्यान आथाम नाह होप सिकेत। ओहली मी केसरा फाय विन्ता केरथु।”<verse eid="ACT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 25:12" />तेवी फेस्तुस सलाकारान सला लेणेन बाद जापाप आप्यो, “तु केसर फाय नियाव मांगील हे, ते तु केसरास फाय जाहे।”<verse eid="ACT 25:12" /></para>
  <para style="s">राजा अग्रीपा एने बिरनीकेन सामने पौलुस</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13" />ओवता थोड़ाक दिह वितणेन बाद अग्रीपा राजा एने बिरनीके ज्या दुयू केसरीया माय आवीन फेस्तुसाह मीलना। <verse eid="ACT 25:13" /><verse number="14" style="v" sid="ACT 25:14" />ताहरी ता थोड़ाक दिह रेना, तेवी फेस्तुस पौलुसान बाराम राजाह केयो: “न्याहरी एक माणुह हे, जाह फेलीक्‍स जेली माय सोड़ीन जात रियेल हे; <verse eid="ACT 25:14" /><verse number="15" style="v" sid="ACT 25:15" />जेवी मी यरूशलेम माय जायेल ईतो, ते मुखी चाकऱ्या एने यहुदिन डायडाया ता पोर गुनो लागाड्या एने विन्ता केऱ्या काय मी ताह गुनेगार ठेराव सेकु। <verse eid="ACT 25:15" /><verse number="16" style="v" sid="ACT 25:16" />पुण मी ताह जापाप आप्यो काय रोमीन ज्यी रित नाह सोती काय कुणीन बी आथाम एगदाह माणहाह डेंड आपणेन केरता होप देय, जाह वोर आरापीह एने दोस लागाड़णारान आमने सामने उबरीन दोसान जापाप आपणेन टेम नाय जुड़ी। <verse eid="ACT 25:16" /><verse number="17" style="v" sid="ACT 25:17" />एने जेवी ता मार फाय न्या आवा, ते मी कायच वार नाह लागाड्यो, पुण दिहरेच दिह राजगादि पोर बोहीन ता माणहाह लावणेन उकुम आप्यो। <verse eid="ACT 25:17" /><verse number="18" style="v" sid="ACT 25:18" />जेवी गुनो लागाड़णारे उब रेना, ते ता ओहल्यु खाराब वातुन दोस नाह लागाड्या जिहकेरीन मी होदतालो। <verse eid="ACT 25:18" /><verse number="19" style="v" sid="ACT 25:19" />पुण तान सोतान यहुदिन रितीन बाराम एने यीशु नावान काल्ला माणहान बाराम, जो मोर जायेल ईतो एने पौलुस ताह जीवतालो कियेल ईतो; बोलचाल केरताला। <verse eid="ACT 25:19" /><verse number="20" style="v" sid="ACT 25:20" />तेवी ज्यान चोकसी किहीक केरने ज्यो माहु नाह सोमेजतालो केरीन मी पौलुसाह फुशो, ‘यरूशलेम माय जाईन ताहरी ज्यी वातीन बाराम तारो नियाव एय इहकेरीन तारी मोरजी हे काय।’ <verse eid="ACT 25:20" /><verse number="21" style="v" sid="ACT 25:21" />पुण जेवी पौलुस ज्यी विन्ता किऱ्यो काय राजान राजा द्‍वाराच मारो फेसलो एणे जुवे। ते मी उकुम आप्यो काय जाह वोर ताह केसरा फाय नाय मोकलु; तान राखवाली केरी।”<verse eid="ACT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22" />तेवी अग्रीपा राजा फेस्तुसाह केयो, “मी बी ता माणहान होमेलने होदथु।” एने तो जापाप आप्यो, “तु हेकाले होमेल लिहे।”<verse eid="ACT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23" />दिहरे दिह जेवी अग्रीपा एने बिरनीके जुलूम दुमदाम माय आवा एने सेनापोती एने गावान डायला माणहा हेऱ्या ता सबान गेरा माय पोचना, तेवी फेस्तुस उकुम आप्यो काय सिपाय पौलुसाह लेन आवी। <verse eid="ACT 25:23" /><verse number="24" style="v" sid="ACT 25:24" />फेस्तुस केयो, “एय राजा अग्रीपा: एने एय आखा माणहे, ज्या माणहाह दिखो, जान बाराम आखो यहुदि सोमाज यरूशलेम माय एने न्याहरी बी आयड़ी आयड़ीन माहु विन्ता केऱ्या काय ज्याह एवी जीवतालो रेणे ठिख नाह। <verse eid="ACT 25:24" /><verse number="25" style="v" sid="ACT 25:25" />पुण मी जाण गीयो काय तो ओहलो काय नाह किऱ्यो काय माराय जाय। एने जेवी पौलुस सोता केसर फाय नियाव मांगील हे, केरीन ताह मोकेलनेन मी निर्णय किऱ्यो। <verse eid="ACT 25:25" /><verse number="26" style="v" sid="ACT 25:26" />पुण मार फाय ज्यान बाराम केसराह लेखणेन केरता मार फाय काल्ली निश्‍चित वात ना सोती। तानकेरता मी ताह तुमरे आखान सामने, एने खास केरीन एय राजा अग्रीपा, तार सामने लायेल हे काय चोकसी खेतेम एणेन बाद माहु काह लेखणेन केरता जुड़ जाय। <verse eid="ACT 25:26" /><verse number="27" style="v" sid="ACT 25:27" />काहाकाय कोंडायेलाह मोकेलनेन एने जो दोस ता पोर लागाड़ाय जायेल, ताह स्पष्ट रूप से नाह केणे, माहु हाजो नाह देखात।”<verse eid="ACT 25:27" /></para>
  <chapter eid="ACT 25" />
  <chapter number="26" style="c" sid="ACT 26" />
  <para style="s">अग्रीपान सामने पौलुस सोताह वोचाड़ेन बासेण केणे</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1" />अग्रीपा पौलुसाह केयो, “तुवाह तारा बाराम बोलने उकुम हे।” तेवी पौलुस आथ ओंगाण केरीन जापाप देणे बाज गीयो,<verse eid="ACT 26:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 26:2" />“एय राजा अग्रीपा! जोल्युक वातुन यहुदि मार पोर दोस लागाड़तेह, आज तार सामने तान जापाप देणे माय मी तुवाह हाजो सोमेजथु, <verse eid="ACT 26:2" /><verse number="3" style="v" sid="ACT 26:3" />खास केरीन ज्यानकेरता काय तु यहुदिन रिती रिवाज एने बोलचालाह जाणेह।” एने मी तुवाह विन्ता केरथु काय दिर देरीन मारी होमली ले।<verse eid="ACT 26:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4" />“जोहलो मारो बोलनो चालनो एने जीवाय आत्योच रेन मार माणहान विचीम एने यरूशलेम माय कोहलोक एतो, ज्यो आखा यहुदिह मालुम हे। <verse eid="ACT 26:4" /><verse number="5" style="v" sid="ACT 26:5" /><note caller="+" style="x"><char style="xo" closed="false">26:5 </char><char style="xt" closed="false"><ref loc="ACT 23:6">प्रेरितान काम 23:6</ref>; <ref loc="PHP 3:5">फिलेपियो 3:5</ref></char></note>ता माहु जुलूम वेगान जाणतेह, एने केदी ता होद्ती ते ज्यी वातीन पुरावो देय सेकतेह, मी आमरी रितीन आखाह रेन केठीण फरिसी टोलान एक मेहमोर ने रूप माय जीवाय जियेल हे। <verse eid="ACT 26:5" /><verse number="6" style="v" sid="ACT 26:6" />पुण एवी ता वायदा माय आसान कारेण जो बोगवान आमरा डायडाया हिऱ्यो किरेल ईतो, ती आसा देरनेन वोजेसे मारो नियाव एणे बाजरिनोह। <verse eid="ACT 26:6" /><verse number="7" style="v" sid="ACT 26:7" />तास वायदान पुरो एणेन आसा लागाड़ेल, आमरा बारा वोस तान आखो मोन लागाड़ीन रात दिह बोगवानान सेवा किरते आयेल हेते। एय राजा, ज्‍यीस आसान बाराम यहुदि मार पोर दोस लागाड़तेह! <verse eid="ACT 26:7" /><verse number="8" style="v" sid="ACT 26:8" />जेवी बोगवान मुरेलाह जीवतालो किरेह, ज्यो तुमरे माय रेन जुलूम जाणाह बुरहो काहा नाह ईत?”<verse eid="ACT 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">26:9 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 8:3">प्रेरितान काम 8:3</ref>; <ref loc="ACT 22:4">22:4</ref>,<ref loc="ACT 22:5">5</ref></char>
    </note>“मी जुलूम सुचेल ईतो काय यीशु नासरीन नावा माय जुलूम काय केरू। <verse eid="ACT 26:9" /><verse number="10" style="v" sid="ACT 26:10" />एने मी यरूशलेम माय इहीचकेरीन केरीन किरेल बी। एने मुखी चाकऱ्या फाय रेन आदिकार लेएन जुलूम होवटा बोगवानान माणहाह जेली माय कोंड्यो, एने जेवी ता माराय जाताला, तेवी मी बी तान विरोद माय मिलायेल ईतो। <verse eid="ACT 26:10" /><verse number="11" style="v" sid="ACT 26:11" />एने एकेक यहुदि बोक्ती केरन्या गेरा माय मी ताह जुलूम वार सेजा आप आपीन यीशु पोर ने बोरहाह नाकार केरनेन केरता केतालो। एने तान विरोद जुलूम राग ईतो काय ताह वेला केरावणेन केरता न्या वोर काय मी दिहरा हेयरा माय बी गीयो।”<verse eid="ACT 26:11" /></para>
  <para style="s">पौलुसान मोन बोदेलनेन वर्णन</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12" />“ज्यास उद्देशाह लेन जेवी मी मुखी चाकऱ्या फाय रेन आदिकार एने उकुम पोत्र मांगीन दमिश्‍क निही जातालो।” <verse eid="ACT 26:12" /><verse number="13" style="v" sid="ACT 26:13" />तेवी एय राजा, वाटे दोपान टेम माय जाणे बुखेत, मी जुगाम रेन मोटली उजेड़ एक उजेड़ मार एने मार हेऱ्या जाणारान कावदेन चोमेकतालो दिख्यो। <verse eid="ACT 26:13" /><verse number="14" style="v" sid="ACT 26:14" />तेवी आमु आखा बुई पोर जाय पोड़ना, ते मी इब्रानी बाषा माय एक आवाज होमल्यो, “एय शाऊल, एय शाऊल! तु माहु काहा वेला केरावेह? तु ओहलो केरीन सोता दुख पोचाड़ने बाजरिनोह, जिहकेरीन बुयेल तान लात आरीन दारी पोर लात देणे बाजरिनोह।” <verse eid="ACT 26:14" /><verse number="15" style="v" sid="ACT 26:15" />मी केयो, “एय मालीक, तु कुण हे?” एने मालीक जापाप आप्यो, “मी यीशु हे, जाह तु वेला केरावेह। <verse eid="ACT 26:15" /><verse number="16" style="v" sid="ACT 26:16" /><note caller="+" style="f"><char style="fr" closed="false">26:16 </char><char style="ft" closed="false">थोड़ाक लेख माय मारो नाह लिखेल हे।</char></note>पुण तु उठ एने तारा पाया केरीन उब रे। काहाकाय मी तुवाह ज्यानकेरता देरसेन आपेल हे काय तुवाह त्यु वातुन बी सेवक एने गोवा ठेरावु, ज्‍यु तु आज दिखेल हे। एने तानकेरता बी जो मी तुवाह बविष्या माय केह। <verse eid="ACT 26:16" /><verse number="17" style="v" sid="ACT 26:17" />एने मी तुवाह तार यहुदि माणहाह एने बिगेर यहुदि रेन बी वोचाड़ते रेह, जा फाय तुवाह मोकेलने बाजरिनोह। <verse eid="ACT 26:17" /><verse number="18" style="v" sid="ACT 26:18" />तान डोला उगाड़ने एने ताह आदारा माय रेन उजाला माय लावणे, एने सैतान ने आदिकार माय रेन बोगवानान उगे फिरनेन केरता, तुवाह मोकेलने बाजरिनोह। ताहसे तुवाह होमालीन मेलुह, ज्याह से ता पापान माफी सापड़ावती एने ता माणहान जागो सापड़ावती जो मार माय बोरहान कारेण चोखा ईयेल हेते।”<verse eid="ACT 26:18" /></para>
  <para style="s">पौलुस तान कामान बाराम केणे</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19" />केरीन एय राजा अग्रीपा, मी ता हेरगावाला देरसेनान उकुमाह नाह टाल्यो, <verse eid="ACT 26:19" /><verse number="20" style="v" sid="ACT 26:20" /><note caller="+" style="x"><char style="xo" closed="false">26:20 </char><char style="xt" closed="false"><ref loc="ACT 9:20">प्रेरितान काम 9:20</ref>,<ref loc="ACT 9:28">28</ref>,<ref loc="ACT 9:29">29</ref></char></note>पुण पेल दमिश्‍क माय ओवतो यरूशलेम माय एने यहुदियान आखा देसान रेणाराह एने बिगेर यहुदिह सोमजाड़ते रिनो, पासतावो केरीन पापा माय रेन फिरीन बोगवाना उगे वोलीन आवो, एने मोन बोदेलनेन लायेक काम केरी। <verse eid="ACT 26:20" /><verse number="21" style="v" sid="ACT 26:21" />ज्यास ने वोजेसे यहुदि माहु मोंदिर माय देर लेदा, एने मारनेन कोसीत केरने बाजरियेल एता। <verse eid="ACT 26:21" /><verse number="22" style="v" sid="ACT 26:22" />पुण बोगवानान मोदेक से मी आज वोर टिक रिनोह, एने आतल्या मोटला आखान सामने न्या उबरीन गोवाय देथु। एने ज्‍यु वातु जाणाव केरनारे एने मुसो कियेल हे काय ज्‍यु एण्यु हेत्यु, त्युह सोड़ीन काय नाह केत। <verse eid="ACT 26:22" /><verse number="23" style="v" sid="ACT 26:23" /><note caller="+" style="x"><char style="xo" closed="false">26:23 </char><char style="xt" closed="false"><ref loc="1CO 15:20">1 कुरिंथीयो 15:20</ref></char></note>काय मसीह दुख वेठणे पोड़ी, एने तोस आखान पेल मुरेल माय रेन जीव उठीन, यहुदि एने बिगेर यहुदि माय सुटकारान उजालान खुबेर पोचाड़ी।<verse eid="ACT 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24" />जेवी पौलुस सोताह वाचाड़नेन बाराम इहकेरीन जापाप आपतालो, तेवी फेस्तुस मोटला सोबदाम केयो, “एय पौलुस! तु गांडो हे। तार जुलूम इकेल तुवाह गांडो बाणाव दियेल हे।”<verse eid="ACT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 26:25" />पुण पौलुस केयो, “एय ईकेलवाला फेस्तुस, मी गांडो नाह सोतो, पुण खेरली एने सोमेजणेन वातु केथु। <verse eid="ACT 26:25" /><verse number="26" style="v" sid="ACT 26:26" />खुद राजा अग्रीपा ज्‍यु वातुह जाणेह, एने मी पुरा ईमोत हिऱ्यो ज्‍यु वातु ताह केणे बाजरिनोह। काहाकाय मी पाको जाणथु काय न्यु माय रेन काल्ली बी ताह मालुम हे ओहलो नाह, मी ज्यानकेरता केणे बाजरिनोह काय ज्यी वात काल्ला कोपरा माय नाह गेटनी। <verse eid="ACT 26:26" /><verse number="27" style="v" sid="ACT 26:27" />एय राजा अग्रीपा, तु बोगवाना फाय रेन खुबेर लावतेह ता पोर बुरहो किरेह काय? होव, मी जाणथु काय तु बुरहो किरेह!”<verse eid="ACT 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 26:28" />तेवी अग्रीपा राजा पौलुसाह केयो, “काय तु ज्यो सोचेह काय थोड़ाक टेम माय तु माहु मसी बाणाव सिकेह?”<verse eid="ACT 26:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 26:29" />पौलुस जापाप आप्यो, “कोम टेम माय काय जुलूम टेम माय, बोगवाना फाय मारी विन्ता हे काय तु होमलेह तुहलोस एय जाय जोहलो मी हे, पुण सिवाय ज्‍यु आतबेड्युन।”<verse eid="ACT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30" />तेवी राजा एने आदिकारी, बिरनीके एने ता हेऱ्या बोहणारे माणहे बी उठीन उबरी गीया; <verse eid="ACT 26:30" /><verse number="31" style="v" sid="ACT 26:31" />एने आलेग जाईन आपसाम केणे बाज गीया, “ज्यो माणुह ते ओहलो कायच नाह किरेत, मोतीन डेंड एने जेली माय कोंडाय जाणेन बाराबोर एय।” <verse eid="ACT 26:31" /><verse number="32" style="v" sid="ACT 26:32" />तेवी अग्रीपा फेस्तुसाह केयो, “केदी ज्यो माणुह केसरा फाय नियाव नाय मांगतो, ताहार ज्याह सोड़ देताम आवतो।”<verse eid="ACT 26:32" /></para>
  <chapter eid="ACT 26" />
  <chapter number="27" style="c" sid="ACT 27" />
  <para style="s">पौलुसान रोम माय जाणो</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1" />जेवी ज्यो ठेराव लेदा काय आमु डोंडह्या माय बोहीन इटली जाहु, ते ता पौलुसाह एने थोड़ाक दिहरा आरापीह बी युलीयुस नावान ओगुस्तुस रोमी पलटनान एक आदिकारीन आथा माय होप दिनो। <verse eid="ACT 27:1" /><verse number="2" style="v" sid="ACT 27:2" />जेवी आमु आसीया ईलाकान दिड़े जा एक अद्रमुत्तियुम ने एक डोंडह्यो दिड़े बेटा माय जाण्यो एतो, आमु डोंडह्या माय चेड़ना एने बोहीन निकली गीया। एने अरीस्तर्खुस नावान थिस्सलुनिक्योन एक मकिदुनि एदमी बी आमरी हिऱ्यो ईतो। <verse eid="ACT 27:2" /><verse number="3" style="v" sid="ACT 27:3" />दिहरे दिह आमु सेदान हेयरा माय पोचीन डोंडह्‍याम रेन उतेरना, तेवी युलीयुस पौलुसा पोर गीण केरीन पौलुसान जोड़ीदार फाय जाणे दिनो। काय ताह लागणार जोरवुत ने वोस्तु ता आप सेकी। <verse eid="ACT 27:3" /><verse number="4" style="v" sid="ACT 27:4" />ता रेन आमु देरीयान वाटे पोशा चाल पोड़ना, काहाकाय वारो आमरो हुम्बो एतो, केरीन आमु डोंडह्याह साइप्रसान आड़ावे निकेलना। <verse eid="ACT 27:4" /><verse number="5" style="v" sid="ACT 27:5" />एने जेवी आमु किलीकीया एने पंफुलीयान देरीयान दिड़े रेन निकेलना, ते लुसीयान मुरा माय उतेरना। <verse eid="ACT 27:5" /><verse number="6" style="v" sid="ACT 27:6" />ताहरी आदिकारीह आलेकजांडरीयान एक डोंडह्यो इटली जातालोन मिलनो, एने तो आमुह ता माय बोहाड़ दिनो।<verse eid="ACT 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 27:7" />जेवी आमु जुलूम दिह वोर बागे बागे जाईन जुलूम केठीण माय रेन कनिदुस ने सामने पोचना, ते ज्यानकेरता काय वारो आमुह ओंगाण जाणे नाह देतालो, केरीन आमु क्रेते टापुन आड़ावे सलमोन ने सामने गीया। <verse eid="ACT 27:7" /><verse number="8" style="v" sid="ACT 27:8" />ओवता आमु जुलूम केठीण माय रेन तान दिड़े दिड़े सुरक्शीत टापु नावान जागे पोचना, ता रेन लसया गाव जुलूम आहने एतो।<verse eid="ACT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9" />
    <note caller="+" style="f">
      <char style="fr" closed="false">27:9 </char>
      <char style="ft" closed="false">पासतावान दिह; ज्यो दिह सप्टेम्बर मोयनान आखरी आखरी माय मोणाव ताला; नाहते अक्टुम्बर ने सुरवात माय, न्या दिह्या माय मोसम हाजो रेणेन कारेण देरीया माय पारवास केरने खेतेरनाक एतालो।</char>
    </note>एने आमु ता जुलूम दिह रेना, एने तोलास माय उपासान दिह बी पुरा एय जायेल एता, केरीन ती टेम माय देरीया पोर रेन जाणे तेकलीतान एतो, केरीन पौलुस ताह ज्यो चेतावणी देयीन केयो, <verse eid="ACT 27:9" /><verse number="10" style="v" sid="ACT 27:10" />“एय एदमी, माहु ओहलो मालुम पुड़ेह काय ज्या देरीयाम जाणे माय माल एने डोंडह्यान ओलोस नाह, पुण आपणा जीवाह बी दुको एण्यो हे।” <verse eid="ACT 27:10" /><verse number="11" style="v" sid="ACT 27:11" />पुण आदिकारी पौलुसान वातीह रेन डोंडह्यान मालक्यान एने डोंडह्यो चालाड़नारान वातीह जादा मान्यो। <verse eid="ACT 27:11" /><verse number="12" style="v" sid="ACT 27:12" />ज्यो टापु हियालान दिह काड़णेन केरता हाजो नाह एतो; तानकेरता मोकता जाणान विचार ईनो काय ता रेन निकले, एने एय सेकी ते फीनिक्‍स ने क्रेतान टापु माय जाईन हियालो काड़े, जान मुय दक्शिण पुर्व एने उत्तर पश्‍चिम ने उगे हे।<note caller="+" style="f"><char style="fr" closed="false">27:12 </char><char style="ft" closed="false">दक्शिण पश्‍चिम एने उत्तर पश्‍चिम नाहते उत्तर पुर्व एने दक्शिण पुर्व</char></note><verse eid="ACT 27:12" /></para>
  <para style="s">देरीया माय वादोण वारो</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13" />जेवी दक्शिण उगे वारो आवो ते क्रेतान दिड़े रेन डोंडह्याह ओंगाण ओंगाण हेरकावणे बाज गीया। <verse eid="ACT 27:13" /><verse number="14" style="v" sid="ACT 27:14" />पुण थोड़ीक टेम माय बुईन उगे रेन एक मोटलो “उत्तर पुर्व” नावान वादोण वारो आवो। <verse eid="ACT 27:14" /><verse number="15" style="v" sid="ACT 27:15" />जेवी वादोण डोंडह्या हेऱ्यो ठोकाय गीयो, तेवी वादोणान कारेण डोंडह्यो ओंगाण नाह जातालो ते आमु कोसीत केरने सोड़ देना एने डोंडह्याह वारा हेऱ्या जा जाय ता जाणे देना। <verse eid="ACT 27:15" /><verse number="16" style="v" sid="ACT 27:16" />तेवी कोदा नावान एक आत्‍यास बेटान आड़ाव माय रेन वोयते वोयते, आमु केठीण माय रेन जीवणान डोंडह्याह काबा माय केर सेकना। <verse eid="ACT 27:16" /><verse number="17" style="v" sid="ACT 27:17" />ओवता डोंडह्या चालाड़नारे आतल्या डोंडह्याह विशा एने डोंडह्याह बुंदे रेन उपेर वोर राही केरीन वेटालीन बांद देना। एने लीबिया रेटा माय फोस जाणेन बिय से पाल एने सोमान उतारीन वोयाड़तेन जात रेना। <verse eid="ACT 27:17" /><verse number="18" style="v" sid="ACT 27:18" />जेवी वादोणान वोजेसे आमरो जुलूम बुरो हाल एणे बाज गीयो, ते दिहरे दिह ता डोंडह्या माय रेन थोड़ोक माल टाकणे बाज गीया, <verse eid="ACT 27:18" /><verse number="19" style="v" sid="ACT 27:19" />एने तीसरे दिह ता तान आथा केरीन डोंडह्यान सोमान बी टाक देना। <verse eid="ACT 27:19" /><verse number="20" style="v" sid="ACT 27:20" />जेवी जुलूम दिह वोर दिह्या दिह नाह उगनो एने नाह ते राती चांदण्या देखाना, एने मोटलो वादोण वारो चालते रिनो। ते सेवली बुखेत आमरे वोचणेन आखी आसा जाणे बाज गियी। <figure style="fig" alt="Ship being wrecked in a storm" file="lb00219c.tif" size="col" copy="Horace Knowles ©" ref="27:18">वादोण माय डोंडह्यो खेतेम एय गीयो</figure><verse eid="ACT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21" />जोला डोंडह्या माय जाणे बाजरियेल एता, ता आखा जुलूम दिह वोर बुखल्यास रेना। तेवी पौलुस तान विची माय उबरीन केयो, “एय माणहे, क्रेते रेन नाह आवणेन सला मान लेता; ते तुमू नुकसान से वोच जाता।” <verse eid="ACT 27:21" /><verse number="22" style="v" sid="ACT 27:22" />पुण मी एवी तुमूह विन्ता केरथु, “वातड़ी साती मीलो; काहाकाय तुमू माय रेन कुणीन बी जीव खेतेम नाय एय, पुण डोंडह्यान ओलोच नुकसान एय। <verse eid="ACT 27:22" /><verse number="23" style="v" sid="ACT 27:23" />काहाकाय जा बोगवानान मी सेवक हे एने जान मी बोक्ती केरथु, ता बोगवानान एक हेरोगदुत आज राती मार फाय आवो, <verse eid="ACT 27:23" /><verse number="24" style="v" sid="ACT 27:24" />एने केयो, ‘एय पौलुस बिय मा! काहाकाय तुवाह रोमान राजान ओंगाण उबरेणु हे। देख बोगवान तान गीण माय तुवाह एने जा तार हेऱ्या डोंडह्‍याम हेते ता सोबान जीवाय वोचाड़नु हे।’ <verse eid="ACT 27:24" /><verse number="25" style="v" sid="ACT 27:25" />तानकेरता एय बाहख! वातड़ी साती मीलो; काहाकाय मी बोगवाना पोर बुरहो केरथु जिहकेरीन माहु केय मीलेल हे, तिहेच केरीन एय। <verse eid="ACT 27:25" /><verse number="26" style="v" sid="ACT 27:26" />पुण आपुह डोंडह्याह बेटान मीरे ली जाणे पोड़ी।”<verse eid="ACT 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27" />जेवी चोवदावी रात आवी, एने बुमद्य देरीया माय बोटकेते फिरने बाजरियेल एता। तेवी डोंडह्याह चालाड़नारे ज्यो अनुमान लागाड़ लेदा काय आपु एगदा मेरान आहने जाय पुचील हेते। <verse eid="ACT 27:27" /><verse number="28" style="v" sid="ACT 27:28" />ता देरीयान उंडवाय माप्या ते चार विह आथ निकेलनो, एने थोड़ोक उंजु ओंगाण जाईन पोशा पाण्यान उंडवाय माप्या; तेवी तीन विह आथ निकेलनो। <verse eid="ACT 27:28" /><verse number="29" style="v" sid="ACT 27:29" />तेवी दिगोड़ ठोकाय जाय केरीन बियीन ता डोंडह्याह उब राखाड़नेन केरता डोंडह्यान पासाण चार लंगर टाक देना, एने उजालो एणेन केरता विन्ता केरने बाजरियेल एता। <verse eid="ACT 27:29" /><verse number="30" style="v" sid="ACT 27:30" />तेवी डोंडह्यो चालाड़नारे ता रेन नाह जाणे होदताला, एने डोंडह्यान ओंगाण लंगर टाकणेन बाहानो केरीन आतल्या डोंडह्याह देरीयाम उतार देना। <verse eid="ACT 27:30" /><verse number="31" style="v" sid="ACT 27:31" />पुण पौलुस सिपायड़ान आदिकारीह एने सिपायड़ाह केयो, “केदी ज्या डोंडह्या पोर नाय रोकाती, ते तुमू बी वोच नाह सिकहो।” <verse eid="ACT 27:31" /><verse number="32" style="v" sid="ACT 27:32" />तेवी सिपायड़ा राह्यु तोड़ीन आतल्या डोंडह्याह पाड़ देना।<verse eid="ACT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33" />जेवी उजालो एण्योच एतो तेवी पौलुस विन्ता केरीन आखाह रूटो खाणेन केरता सोमजाड्यो, “आज चोवदा दिह एय गीयाह, तुमू आसा देखते देखतीन बुखल्या रेना, एने काय खाणो नाह खादा। <verse eid="ACT 27:33" /><verse number="34" style="v" sid="ACT 27:34" />मी तुमूह रूटो खाणेन ज्यानकेरता विन्ता केरथु काय तुमूह जीवतालो रेणु हे। काहाकाय तुमरे माय रेन कुणीन बी मुंडान एक लेट्यो बी नाय उखली सेकी।” <verse eid="ACT 27:34" /><verse number="35" style="v" sid="ACT 27:35" />एने इहकेरीन केयीन पौलुस रूटो लेन ता आखान ओंगाण बोगवानाह दन्यवाद केरीन खाणे बाज गीयो। <verse eid="ACT 27:35" /><verse number="36" style="v" sid="ACT 27:36" />तेवी ता माय ईमोत आवी, एने रूटो खाणे बाज गीया। <verse eid="ACT 27:36" /><verse number="37" style="v" sid="ACT 27:37" /><note caller="+" style="f"><char style="fr" closed="false">27:37 </char><char style="ft" closed="false">थोड़ाक लेख माय 275 लिखेल हे; दिहरा थोड़ाक लेख माय 76 लिखेल हे। </char></note>आमु आखा मिलीन डोंडह्या माय दुय होव शाहत्तर जाणे एता। <verse eid="ACT 27:37" /><verse number="38" style="v" sid="ACT 27:38" />जेवी ता पेट बोरीन रूटो खादा, ओवता गोवाह दाने देरीया माय टाकीन डोंडह्याह ओलवो केरने बाज गीया।<verse eid="ACT 27:38" /></para>
  <para style="s">डोंडह्यान टुटणो</para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39" />जेवी दिह उगनो, तेवी ता आखा ता देसाह नाह ओलख्या, पुण देरीयान एक मिरो देखानो, तो चार खुणान ईतो, ता विचार केऱ्या काय ज्या पोर डोंडह्याह उबराखाड़ देता। <verse eid="ACT 27:39" /><verse number="40" style="v" sid="ACT 27:40" />तेवी ता लंगराह सोड़ीन देरीया माय सोड़ देना, एने तुलेचबूखी पतवारान बोंदेन सोड़ देना, एने डोंडह्यान सामनेन पाल सोड़ देना काय आपु मेरान उगे चाल पोड़ी। <verse eid="ACT 27:40" /><verse number="41" style="v" sid="ACT 27:41" />पुण डोंडह्यो दुय देरीयान मेलान रेटा माय ठोकानो; एने डोंडह्यान ओंगाणल्यो खुणो पुरो गाड़ाय गीयो, एने पासाणल्यो ईसो वारान जेलखान जोराम टुटणे लाग गीयो।<verse eid="ACT 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42" />तेवी सिपायड़ा आरापीह मारनेन विचार केऱ्या, काय ताम रेन कुण बी जेफीन बाहेर नाय निकेलने जुवे। <verse eid="ACT 27:42" /><verse number="43" style="v" sid="ACT 27:43" />पुण सिपायान आदिकारी पौलुसाह वोचाड़ने होदतालो, तो ताह इहकेरीन केरने नाह दिनो एने ज्यो केयो। जाह जेफता ओवेड़तेय ता जेफीन बाहेर निकील जावो; <verse eid="ACT 27:43" /><verse number="44" style="v" sid="ACT 27:44" />बाकी माणहे पाटड्या एने डोंडह्यान दिहऱ्यु वोस्तुन साहारे निकली जावो, इहकेरीन आखा माणहे वोचीन मीरे निकली गीया।<verse eid="ACT 27:44" /></para>
  <chapter eid="ACT 27" />
  <chapter number="28" style="c" sid="ACT 28" />
  <para style="s">माल्‍टा माय पौलुस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1" />जेवी आमु मेराम हाजेस केरीन वोच निकेलना, ते आमुह मालुम पोड़नो काय ज्यो टापु माल्‍टान हे। <verse eid="ACT 28:1" /><verse number="2" style="v" sid="ACT 28:2" />एने तावाला माणहे आमु पोर जुलूम गीण केऱ्या। काहाकाय पाणी पोड़नेन वोजेसे जुलूम ईवालो एतो, तानकेरता ता आक्‍ठो हेलगाड़ीन आमु आखाह थोबाड्या। <verse eid="ACT 28:2" /><verse number="3" style="v" sid="ACT 28:3" />तेवी पौलुस लाकड़ान बारो लावीन आक्‍ठा पोर मिल्यो, ते गेरमास एनी केरीन एक गेयड़ेक बाहेर निकेलनो, एने तान आथा हिऱ्यो विलगी गीयो। <verse eid="ACT 28:3" /><verse number="4" style="v" sid="ACT 28:4" />जेवी ता माणहे गेड़हाह पौलुसान आथा हिऱ्यो विलगी रियेल देख्या, ते एकमेकाह केया, “खेरीच ज्यो माणुह खुनी हे, ज्यो देरीयाम रेन वोच गीयो, तीबी नियाव ज्याह नाह सोड्यो।” <verse eid="ACT 28:4" /><verse number="5" style="v" sid="ACT 28:5" />पुण पौलुस गेड़हाह आक्‍ठा माय जेटकी दिनो, एने ताह काय दुको नाह पोचनो। <verse eid="ACT 28:5" /><verse number="6" style="v" sid="ACT 28:6" />पुण माणहे वाट जोवताला काय तान सेरीर हुज जाय एने पोड़ीन मोर जाय, पुण जेवी ता जुलूम वार वोर वाट जोवते रेना एने देख्या काय ताह कायच नाह एनो, ते तान विचार बोदलीन केणे बाज गीया, “ज्यो ते एगदो देव हे।”<verse eid="ACT 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7" />ता जागान आहने पाहने ता बेटान मुखी पुबलीयुसान जागो ईतो, तो आमुह तान गेर ली जाईन तीन दिह वोर दोस्तीदार से स्वागत किऱ्यो। <verse eid="ACT 28:7" /><verse number="8" style="v" sid="ACT 28:8" />तेवी इहकेरीन एनो काय पुबलीयुसान आबोख हेरी एने बारथी माय दुखाऱ्यो पोड़ रियेल ईतो। ता फाय गेरा माय जाईन पौलुस विन्ता किऱ्यो, एने ता पोर आथ मेलीन ताह हुदाऱ्यो। <verse eid="ACT 28:8" /><verse number="9" style="v" sid="ACT 28:9" />ज्यी गेटनान बाद ता बेटा माय जा दिहरा माणहे दुखाऱ्या एता, ता बी पौलुस फाय आवा एने हुदरी गीया। <verse eid="ACT 28:9" /><verse number="10" style="v" sid="ACT 28:10" />ता आमरो जुलूम एने आखी बातीन आदार केऱ्या, एने जेवी आमु ती जागे रेन जाण्या एता, तेवी ता आमरे गेरजीन आखी चिज डोंडह्या माय मेल देना।<verse eid="ACT 28:10" /></para>
  <para style="s">माल्‍टा माय रेन रोम माय जाणो</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11" />तीन मोयना पासाण आमु आलेकजांडरीया रेन एक डोंडह्या माय बोहीन चाल पोड़ना, एने हिवालो काड़नेन केरता जा टापु हेऱ्या रोकाय रियेल एता, ता जागाह जोवल्या देवता केताला। <verse eid="ACT 28:11" /><verse number="12" style="v" sid="ACT 28:12" />ता ओवता आमु सुरकुस माय पोचना एने तीन दिह थोब रेना। <verse eid="ACT 28:12" /><verse number="13" style="v" sid="ACT 28:13" />दिहरी दिह दक्शिणान उगे रेन वारो सुटनो, तेवी आमु दुय दिह्यान पासाण रेगुयम गाव लागतास पुतीयुली गावा माय आवा। <verse eid="ACT 28:13" /><verse number="14" style="v" sid="ACT 28:14" />ताहरी आमुह थोड़ाक विश्वासी बाहख मीलना, ता आमुह हात दिह वोर ता फाय रेणेन केरता विन्ता केऱ्या। इहकेरीन आमु रोम हेयराम आवा। <verse eid="ACT 28:14" /><verse number="15" style="v" sid="ACT 28:15" />जेवी रोम मायवाला विश्वासी बाहख आमरा बाराम होमेलना, ते अप्‍पीयुस ने बाजार एने तीन सराय वोर आमुह मिलने आवा, ताह देखीन पौलुस उत्साहित ईनो, एने बोगवानाह दन्यवाद दिनो।<verse eid="ACT 28:15" /></para>
  <para style="s">रोम माय पौलुस</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 28:16" />जेवी आमु रोम हेयराम पोचना, ते पौलुसाह एक सिपाया हिऱ्यो जो पौलुसान देखरेत केरतालो, एखालोच रेणेन उकुम जुड़ गीयो। <figure style="fig" alt="Street scene of The Roman city" file="hk00242c.tif" size="span" copy="Horace Knowles ©" ref="28:16">रोमन हेयरान सेड़कीन दृश्य</figure><verse eid="ACT 28:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17" />तीन दिह्यान पासाण पौलुस यहुदिन मुखी माणहाह हादाड्यो, एने जेवी ता एकठा टोलवाना ते ताह केयो, “एय मारा इस्राएली बाहख, मी आपणा माणहान एने डायडाया फाय रेन जुड़ेल रिती रिवाजान विरोद माय काय बी नाह किऱ्यो, तीबी माहु यरूशलेम माय आरापी बाणावीन रोमी माणहान आथाम होपाय गीयो। <verse eid="ACT 28:17" /><verse number="18" style="v" sid="ACT 28:18" />ता माहु चोकसी केरीन सोड़ देणे होद्या, काहाकाय मार माय मोतीन डेंड आपणेन काय दोस नाह ईतो। <verse eid="ACT 28:18" /><verse number="19" style="v" sid="ACT 28:19" /><note caller="+" style="x"><char style="xo" closed="false">28:19 </char><char style="xt" closed="false"><ref loc="ACT 25:11">प्रेरितान काम 25:11</ref></char></note>पुण यहुदि ज्यी वातुन विरोद केऱ्या, ते माहु मोजबुरी माय केसरा फाय रेन नियाव मांगणेन विन्ता केरने पोड़नो; ज्यानकेरता नाह काय माहु आपणा माणहा पोर एगदो दोस लागाड़नु एतो। <verse eid="ACT 28:19" /><verse number="20" style="v" sid="ACT 28:20" />केरीन मी तुमूह विन्ता केरीन हादेल हे काय तुमूह मीलु एने वातु केरू। काहाकाय मी ता माणहान केरता ज्यी हाकली से बांदायेल हे, जान इस्राएली माणहे आसा केरतेह।”<verse eid="ACT 28:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21" />ता पौलुसाह केया, “नाह आमु तार बाराम यहुदिया फाय रेन चिट्ठी जुड़नी, एने नाह आमरा माणहा माय रेन एगदो आवीन तार बाराम काह बातनी केया, एने नाह बाकतो केया। <verse eid="ACT 28:21" /><verse number="22" style="v" sid="ACT 28:22" />पुण तारो विचार काय हे? तोस आमु तुवा फाय रेन होमेलने होदतेह, काहाकाय आमु जाणतेह काय तु जा समुह माय रेन आवीह ता समुहान विरोद आखी जागे केरतेह।”<verse eid="ACT 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23" />तेवी ता पौलुसान केरता एक दिह ठेराया, एने जुलूम होवटा माणहे पौलुस ने गेर टोलवाना, एने तो बोगवानान राज ने गोवाय देती लेन, एने मुसान नेम एने जाणाव केरनारान पुस्तेक माय रेन यीशुन बाराम सोमजाड़ी सोमजाड़ीन वेगोच रेन हांज पोर वोर वर्णन किरते रिनो। <verse eid="ACT 28:23" /><verse number="24" style="v" sid="ACT 28:24" />तेवी थोड़ाक माणहे त्यु वातुह मान लेदा, पुण थोड़ाक बुरहो नाह केऱ्या। <verse eid="ACT 28:24" /><verse number="25" style="v" sid="ACT 28:25" />जेवी तान आपसाम एकमेल नाह एनो, केरीन ता उठीन जाणे बाज गीया। तेवी पौलुस ताह एक वचन केयो, चोखालो जीव यशाया जाणाव केरनारान द्‍वारा तुमरा डायडायाह। <verse eid="ACT 28:25" /><verse number="26" style="v" sid="ACT 28:26" />केयो,</para>
  <para style="q1" vid="ACT 28:26">“ज्या माणहा फाय जाईन के काय तुमू होमोलहो ते खोरा:</para>
  <para style="q1" vid="ACT 28:26">पुण तुमूह सोमजाय नाय,</para>
  <para style="q2" vid="ACT 28:26">एने दिखहो ते खोरा, पुण तुमूह देखाय नाय;<verse eid="ACT 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 28:27" />काहाकाय न्या माणहान मोन वातड़ा एय जायेल हे,</para>
  <para style="q2" vid="ACT 28:27">एने ता तान कान बोंद किर लियेल हेते,</para>
  <para style="q2" vid="ACT 28:27">एने ता तान डोला मीच लियेल हेते,</para>
  <para style="q1" vid="ACT 28:27">इहकेरीन नाय एय काय ता केदी डोला केरीन देखी,</para>
  <para style="q2" vid="ACT 28:27">एने काना केरीन होमले, एने मोना केरीन सोमजे एने वोली, एने मी ताह हुदारू।”<note caller="+" style="f"><char style="fr" closed="false">28:27 </char><char style="ft" closed="false">यशाया 6:9-10</char></note><verse eid="ACT 28:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 28:28" />केरीन तुमू जाणे काय बोगवानान ज्यो सुटकारो बिगेर यहुदि फाय मोकलाय जायेल हे, एने ता होमेलती। <verse eid="ACT 28:28" /><verse number="29" style="v" sid="ACT 28:29" />जेवी पौलुस इहकेरीन केयो ते यहुदि आपसाम जुलूम बोलचाल केरती लेन ता रेन जात रेना।<note caller="+" style="f"><char style="fr" closed="false">28:29 </char><char style="ft" closed="false">थोड़ाक लेख माय ज्यो वचन नाह जुड़ेत।</char></note><verse eid="ACT 28:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30" />पौलुस तान बाड़ेन गेरा माय पुरा दुय वोरह्या वोर रिनो; एने जा ता फाय आवताला, ता आखा हिऱ्यो मीलते रिनो। <verse eid="ACT 28:30" /><verse number="31" style="v" sid="ACT 28:31" />एने तो बिना रूकावट से जुलूम निडर एन बोगवानान राज ने पारचार केरतीन, एने मालीक यीशु मसीन बाराम वातु हिकाड़ते रिनो।<verse eid="ACT 28:31" /></para>
  <chapter eid="ACT 28" />
</usx>