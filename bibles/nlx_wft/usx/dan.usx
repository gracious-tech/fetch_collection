<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="DAN" style="id">- Nahali</book>
  <para style="h">दानिएल</para>
  <para style="toc3">दानिएल</para>
  <para style="toc2">दानिएल</para>
  <para style="toc1">दानिएल</para>
  <para style="mt2">दानिएल कि किताब</para>
  <para style="mt1">दानिएल ने पुस्तेक</para>
  <para style="imt">ओलखात</para>
  <para style="ip">दानिएल ने पुस्तेक बाबिलोन माय इस्राएली माणहान बोंदी एणेन टेम माय जाणकार दानिएल ने जीवन एने बविष्या काय एय तान देरसेन हेऱ्यो समंद हे। ज्यो दानिएल एने तान जोस्तीन ईमानदारी हेऱ्यो देस एने दुनिया से समंदित जाणाव ने बाराम किथे। ज्यो पुस्तेक 605 से कोमीत कोमी 535 यीशुन पेल ने टेम माय लेखायेल हे, जाहरी दानिएल बाबिलोन ने चार आलेग आलेग राजान राज माय सेवा किरेल इतो। माणहान मान्नु ज्यो हे काय दानिएल खुद ज्यी माय बाबिलोन माय ज्यो पुस्तेक लिखेल इतो, पुण थोड़ाक आज ने जाणकार माणहान मान्नु हे काय ज्यो बाद माय यीशुन पेल दुसरी पिढीन टेम माय इस्राएल माय लेखाय जायेल एती। दिहरान मान्नु हे काय पुस्तेक ने थोड़ोक बाग आलेग आलेग टेम माय लेखाय जायेल एतो।</para>
  <para style="ip">दानिएल ने पुस्तेक बोंदी माय रेणारे इस्राएली माणहा हेऱ्यो काठो टेम आवणे पोर आवणारी पिढ़ीह आसा आपणेन केरता लेखाय जायेल एती। दानिएल ने जीवणान गेटना एने बविष्या हेऱ्यो समंदित जाणाव ने माद्यम से, बोगवान राजाह एने देस देसा पोर तान ताकेत देखाड़ने। बायबल ने संदर्ब माय, ज्यो नोवाला नियम माय बोगवानान राज्याह सोमेजणे माय मुदेक किरेह। <char style="xt"><ref loc="DAN 7:13-14">7:13-14</ref></char> यीशु मसीन जाणाव किरेल हे। सेवली बुखे दानिएल ने देरसेन ने बाराम यीशुन द्‍वारे उल्लेख किरेल हे। <char style="xt"><ref loc="MAT 24:15">मत्ती 24:15</ref>; <ref loc="MRK 13:14">मरकुस 13:14</ref></char> एने योहान ने रहस्या से समंदित। दानिएल यिर्मयान जाणाव पोर बी विचार किरेह <char style="xt"><ref loc="DAN 9:1-3">9:1-3</ref></char>।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. नबुकदनेस्‍सर ने राज ने काल माय दानिएल एने तान जोस्तीन बाराम। <char style="ior"><ref loc="DAN 1-4">1–4</ref></char></para>
  <para style="io1">2. राजा बेलशस्सर ने देरसेन ने बाराम दानिएल ने व्याख्या। <char style="ior"><ref loc="DAN 5:1-31">5:1-31</ref></char></para>
  <para style="io1">3. दारा राजान राज ने टेम माय दानिएल सिंहान गुफा माय। <char style="ior"><ref loc="DAN 6:1-28">6:1-28</ref></char></para>
  <para style="io1">4. बविष्‍यान गेटनान बाराम बोगवान दानिएल वोर आखो खुलासो हे। <char style="ior"><ref loc="DAN 7-12">7–12</ref></char></para>
  <para style="io1">5. दानिएल बविष्‍यान बाराम दुय देरसेन एने तान व्याख्यान वर्णन किरेह। <char style="ior"><ref loc="DAN 7-8">7–8</ref></char></para>
  <para style="io1">6. दानिएल तान माणहान केरता विन्ता केरने एने हेरोगदुत जिब्राएल द्‍वारे तान जापाप जुड़ने। <char style="ior"><ref loc="DAN 9:1-27">9:1-27</ref></char></para>
  <para style="io1">7. जिब्राएल हेरोगदुत सेवल्यो टेम हेऱ्यो बविष्‍यान गेटनान खुलासो किरेह। <char style="ior"><ref loc="DAN 10-12">10–12</ref></char></para>
  <chapter number="1" style="c" sid="DAN 1" />
  <para style="s">दानिएल एने तान दोस्ती</para>
  <para style="r">(<ref loc="DAN 1:1">1:1</ref>; <ref loc="DAN 6:28">6:28</ref>)</para>
  <para style="s">चार जुवान नबुकदनेस्‍सरान राज वाड़ाम</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="2KI 24:1">2 राजा 24:1</ref>; <ref loc="2CH 36:5-7">2 इतिहास 36:5-7</ref> </char>
    </note> यहुदान राजा यहोयाकीम ने राज्‍यान तीसरा वोरह्या माय बाबेलान राजा नबुकदनेस्‍सर यरूशलेम पोर चेड़ाय केरीन ताह कोंड लिदो। <verse eid="DAN 1:1" /><verse number="2" style="v" sid="DAN 1:2" /><note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="2KI 20:17-18">2 राजा 20:17-18</ref>; <ref loc="2KI 24:10-16">24:10-16</ref>; <ref loc="2CH 36:10">2 इतिहास 36:10</ref>; <ref loc="ISA 39:7-8">यशाया 39:7-8</ref></char></note> तेवी बोगवान यहुदान राजा यहोयाकीमाह होप दिनो। नबुकदनेस्‍सर तान देवतान मोंदिर माय रेन ठामला एने दिहरा सामानाह बी तान आथाम केर लिदो; एने तो ता सामानाह शिनार देसाम ली जाएन, तान देवतान मोंदिर माय मेल दिनो।<verse eid="DAN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="DAN 1:3" />तेवी नबुकदनेस्‍सर राजा तान मुखी खोजाह अशपनजाह उकुम आप्यो। जावो एने इस्राएलान मुखी गेराणाम रेन एने इस्राएल राजान कुटूमान थोड़ाक यहुदि एदम्याह लियावो। <verse eid="DAN 1:3" /><verse number="4" style="v" sid="DAN 1:4" />जा निर्दोस, देखाणेम हाजा एने हट्टा कट्ठा एने आखी बातीन इकेल माय सोमेजदार, एने इकेल माय निपुण एने एकलीदार एने राजवाड़ाम उब रेणेन लायेक एय; एने ताह कसदी माणहान बाषा लेखणे वाचणेन हिकवोण आपी। <verse eid="DAN 1:4" /><verse number="5" style="v" sid="DAN 1:5" />एने राजा उकुम आप्यो काय तान खाणो एने पिणेन अंगुरान माणला रूहा माय रेन ताह दाड़ीन खाणे पिणेन आपी। इहकेरीन तीन वोरीह वोर तान पालेन पोषण ईती रेय; तेवी तान बाद ता राजान सामने लियावो। <verse eid="DAN 1:5" /><verse number="6" style="v" sid="DAN 1:6" />ताम रेन यहुदान कुटूमाम दानिएल, हनन्‍याह, मीशाएल, एने अजर्या नावान यहुदि एता। <verse eid="DAN 1:6" /><verse number="7" style="v" sid="DAN 1:7" />एने मुखी खोजा अशपनज तान दिहरा नावे मिल्यो; मतलब दानिएल ने नाव तो बेलतशस्सर, हनन्‍याहान शद्रक, मीशाएल ने मेशेक, एने अजर्यान नाव अबेदनगो मेल्यो।<verse eid="DAN 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 1:8" />पुण दानिएल तान मोनाम ठाण लिदो काय तो राजान खाणो खाएन एने अंगुरान रूह पियेन सोताह एठो नाय एणे देय; केरीन तो सोताह एठो एणे से वोचाड़णेन केरता मुखी अशपनजाह विन्ती किऱ्यो। <verse eid="DAN 1:8" /><verse number="9" style="v" sid="DAN 1:9" />बोगवान मुखी अशपनजाह ओहलो बाणाव दिनो काय तो दानिएल ने केरता गीण एने देया बोर दिनो। <verse eid="DAN 1:9" /><verse number="10" style="v" sid="DAN 1:10" />पुण मुखी अशपनज दानिएलाह केयो, “मी मारा मालीक, राजाह बिथो, काहाकाय तुमरो खाणो पिणो तोस ठेरायेल हे, केदी तु ज्या खाणाह नाह खात, ताहार तु तारा वोयावाला दिहरा जुवानाह रेन कोमजोर एने दुखाऱ्यो देखाणे बाज जाहे। जेवी राजा तुमरो मुय उतरेल देखी, ताहार मार पोर राग केरी एने मारो मुंड उड़ाव देय।”<verse eid="DAN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 1:11" />तेवी मुखी खोजा अशपनज दानिएल, हनन्‍याह, मीशाएल एने अजर्यान उपेर देखरेत केरनेन केरता निवाड़ेल इतो। दानिएल ताह केयो, <verse eid="DAN 1:11" /><verse number="12" style="v" sid="DAN 1:12" />“मी तुवाह विन्ता केरथु काय तु दोह दिह वोर तार पावराह पारेख, एने खाणेन फोक्‍तो बाजी पालो एने पिणेन केरता पाणी आप। <verse eid="DAN 1:12" /><verse number="13" style="v" sid="DAN 1:13" />उवतो दोह दिह्यान पासाण आमरा मुय एने जा जुवान राजान खाणो खातेह, तान मुयाह देख; एने जोहलो तुवाह देखाय, तिहेच केरीन तारा सेवका हिऱ्यो वेवार किरज्ये।”<verse eid="DAN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 1:14" />तेवी तो देखरेत केरनार ज्यी विन्ती मान लिदो, एने दोह दिह वोर ताह पारेखते रिनो। <verse eid="DAN 1:14" /><verse number="15" style="v" sid="DAN 1:15" />दोह दिह्यान बाद, तान मुय राजान खाणो खाणारे आखा जुवानाह रेन जुलूम हाजा, एने माताला देखाणे बाज गीया। <verse eid="DAN 1:15" /><verse number="16" style="v" sid="DAN 1:16" />तेवी खाणान व्‍यवस्‍था केरनार मुखी, ताह राजान तो खास खाणो एने अंगुरान रूह आपणे बोंद केर दिनो, एने ताह खाणान जागा पोर बाजी पालान बाजी आपते रिनो।<verse eid="DAN 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 1:17" />एने बोगवान ता चार जुवानाह बात बातीन लेखणे वाचणेन एने आखी बातीन विद्या सोमेजणेन केरता इकेल, एने चेतराय आप्यो। एने दानिएल ते आखी बातीन देरसेन, एने होपनान बी मतलब सोमेजणे बाज गीयो।<verse eid="DAN 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 1:18" />राजा नबुकदनेस्‍सर ज्‍यो उकुम आपेल इतो काय इस्राएली जाती माय रेन आखा जुवान तीन वोरह्यान पासाण तान ओंगाण राजवाड़ा माय उब राखाड़ाय जाय। जेवी ज्‍यो टेम पुरो एनो, तेवी मुखी अशपनज ताह राजवाड़ाम ली गीयो। तो ताह राजान सामने उबो किऱ्यो। <verse eid="DAN 1:18" /><verse number="19" style="v" sid="DAN 1:19" />राजा ता हिऱ्यो वातु केरने बाज गीयो, एने दानिएल, हनन्‍याह, मीशाएल एने अजर्या ज्या चारूम रेन ओलोक कुण बी एकलीदार नाह एतो। केरीन ता चारू जुवानाह राजान सेवक बोणनेन केरता निवाड्यो। <verse eid="DAN 1:19" /><verse number="20" style="v" sid="DAN 1:20" />जेवी केदी राजा इकेल एने सोमेज ने बाराम ताह एगदो सावाल फुसतालो, तेवी राजाह तान जापाप होमलीन ज्‍य अनुबव एतालो काय ता चारू तान राज्‍यान आखा बोड़वा एने एकलीदार माणहाह रेन दोह गुणा उशार हेते। <verse eid="DAN 1:20" /><verse number="21" style="v" sid="DAN 1:21" />एने दानिएल बाबिलोन ने राजवाड़ाम, राजा कुस्रु राजान कालान पेल्ले वोरीह वोर रिनो।<verse eid="DAN 1:21" /></para>
  <chapter eid="DAN 1" />
  <chapter number="2" style="c" sid="DAN 2" />
  <para style="s">नबुकदनेस्‍सर राजान होपनो</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 2:1" />राजा नबुकदनेस्‍सर तान राज ने दिहरा वोरह्या माय एक होपनो दिख्यो, ता होपनान वोजेसे तान मोन जुलूम चिन्ता माय पोड़ गीयो एने तो हुव नाह सीकनो। <verse eid="DAN 2:1" /><verse number="2" style="v" sid="DAN 2:2" />केरीन राजा उकुम आप्यो काय जाणकार, पुजारा, जादुगेर एने कसदी कागेल पांड्याह हादाड्यो काय ता आवीन तान होपनान मतलब सोमजाड़े। जेवी ता राजान ओंगाण आवीन उब रेना। <verse eid="DAN 2:2" /><verse number="3" style="v" sid="DAN 2:3" />तेवी राजा ता माणहाह केयो, “मी एक होपनो दिखेल हे, ता माय मारो मोनाम दुखी हे, मी ज्‍य जाणने होदथु काय ता होपनान मतलब काय हे?”<verse eid="DAN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 2:4" />तेवी कसदी राजाह अरामी बाषा माय केया, “एय राजा तु कायेम जीवतालो रिहे! आमु तारा सेवक हेते, तु तारो होपनो आमुह के, ओवता आमु तान मतलब केहु।”<verse eid="DAN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 2:5" />तेवी नबुकदनेस्‍सर राजा ता कसदी पुजाराह केयो, “नाह! तो होपनो एने तान आर्थो काय एतो, ज्‍य बी तुमूस केणु हे, एने केदी तुमू ज्‍य केया नाह, ताहार मी तुमरे टुकड़ा केरनेन उकुम आपुह। एने तुमरा गेरे उजाड़ाय जाती। <verse eid="DAN 2:5" /><verse number="6" style="v" sid="DAN 2:6" />पुण केदी तुमू होपनो एने तान मतलब केय दिहो, ताहार मी तुमूह बात बातीन बेट एने ईनाम आपुह; तुमरो मान मेलुह। केरीन तुमू एवी मारो होपनो एने तान मतलब किवो।”<verse eid="DAN 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 2:7" />ता माणहे पोशा राजाह केया, “एय राजा होपनो तारा सेवकाह के, एने आमु तान मतलब सोमजाड़ देहु।”<verse eid="DAN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 2:8" />राजा जापाप आप्यो, “माहु पाको मालुम एय जायेल हे, काय तुमू टेमाह टालनेन कोसीत केरने बाजरेनाह, काहाकाय तुमू ज्‍य जाण जायेल हेते काय, मी ज्‍यो उकुम आपेल हे। <verse eid="DAN 2:8" /><verse number="9" style="v" sid="DAN 2:9" />तुमू ज्‍य जाणतेह काय केदी तुमू माहु मारा होपनान बाराम नाय किहो ताहार देन्ड जुड़ी, ज्‍य तुमूह मालुच हे। तुमू आखा मिलीन माहु जुठ मेलतेह। केरीन तुमू माहु होपनो किवो, तेवी मी जाणुह काय तुमू होपनान मतलब बी सोमजाड़ सेकतेह।”<verse eid="DAN 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 2:10" />कसदी राजाह जापाप आप्या, “देरती पोर ओहलो काल्लो माणुह नाह जो राजान ज्यी वात केय सिके एने नाह एगदो ओहलो राजो, नाहते मुखी, नाहते आदिकारी ईयेल हे जो एगदा कागेल पांड्या, जादुगेर माणहाप नाहते कसदी फाय केदी ओहली वात फुसेल एय। <verse eid="DAN 2:10" /><verse number="11" style="v" sid="DAN 2:11" />जी वात राजा आमु फाय रेन जाणने हुदेह, ती केठीण हे, एने देवता ओलास राजान होपनो केय सेकतेह, पुण देवता ते माणहान विचीम नाह रेणु।”<verse eid="DAN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="DAN 2:12" />जेवी राजा ज्‍य होमल्यो ते तो जुलूम खीजवाय गीयो, एने तो बाबेलान आखा एकलीदार माणहाह मार टाकणेन उकुम आप्यो। <verse eid="DAN 2:12" /><verse number="13" style="v" sid="DAN 2:13" />केरीन राजान उकुम निकेलनो काय आखा एकलीदार माणहाह मारनु एतो, केरीन दानिएल एने तान जोस्तीह बी माराव देणेन केरता ताह होदणेन राजान माणहे गीया।<verse eid="DAN 2:13" /></para>
  <para style="s">बोगवानान द्‍वारा दानिएल पोर मतलब देखाड़नो</para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 2:14" />अर्योक ज्यो राजान राखवाल्‍यान मुखी इतो। तो बाबेलान एकलीदार माणहाह मारनेन केरता जाणे बाजरियेल इतो, पुण दानिएल अर्योक हिऱ्यो सोच सोमजीन एने हासकेरीन वातु किऱ्यो। <verse eid="DAN 2:14" /><verse number="15" style="v" sid="DAN 2:15" />दानिएल अर्योकाह फुशो, “राजा ओलो काठो देन्ड आपणेन उकुम काहा आपेल हे?” ओवतो अर्योक राजान होपनावाली वातीन बाराम केयो, ओवतो दानिएल आखो सोमजी गीयो।<verse eid="DAN 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 2:16" />दानिएल जेवी ज्यी वात होमल्यो, ते तो नबुकदनेस्‍सर राजा फाय जाईन राजाह विन्ता केरीन थोड़ोक टेम उंजु मांग्‍यो, ओवतो तो राजाह तान होपनो एने ता होपनान मतलब किण्‍यो इतो।<verse eid="DAN 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 2:17" />ओवतो दानिएल तान गेर जाईन, तान दोस्ती हनन्‍याह, मीशाएल एने अजर्याह ती आखी वात केय होमलायो। <verse eid="DAN 2:17" /><verse number="18" style="v" sid="DAN 2:18" />दानिएल तान जोस्तीह हेरगावाला बोगवानान देयान केरता विन्ता केरनेन केयो, काहाकाय बोगवान ता पोर गीण केरी, एने ज्यी वातीह सोमेजणे माय मोदेक केरी, काय बाबेलान एने आखा एकलीदार माणहा हेऱ्या, दानिएल एने तान हाती बी खेतेम नाय केराय जाय। <verse eid="DAN 2:18" /><verse number="19" style="v" sid="DAN 2:19" />राती बोगवान दानिएलाह देरसेनान द्‍वारा, ती आखी वात सोमजाड़ दिनो। तेवी दानिएल हेरगावाला बोगवानान दन्यवाद किऱ्यो,<verse eid="DAN 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="DAN 2:20" />एने दानिएल केयो, “बोगवानान नावान कायेम बोड़ाय किरो;</para>
  <para style="q2" vid="DAN 2:20">काहाकाय ईकेल एने ताकेत तास ने हे।<verse eid="DAN 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="DAN 2:21" />तोस टेम एने वोरह्यान ऋतुह एने राजा बी बोदलेह;</para>
  <para style="q2" vid="DAN 2:21">सेत्‍ता आपणे एने तोस तान सेत्‍ता सांडाड़ लिथे; तोस बुद्दी आपेह एने माणहे बुद्दीमान बोण जातेह,</para>
  <para style="q2" vid="DAN 2:21">तोस माणहाह ईकेल आपेह एने माणहे एकलीदार बोण जातेह।<verse eid="DAN 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="DAN 2:22" />तोस केठीण एने लिकायेल वातुह देखाड़ेह;</para>
  <para style="q2" vid="DAN 2:22">उजालो कायेम रेणेन वोजेसे, आंदारलाम एने लिकायेल जागाम काय हे,</para>
  <para style="q2" vid="DAN 2:22">ज्‍य तो जाणेह।<verse eid="DAN 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="DAN 2:23" />एय मारा डायडायान बोगवान, मी तारो दन्यवाद एने बोड़ाय केरथु,</para>
  <para style="q1" vid="DAN 2:23">तुस माहु ईकेल एने ताकेत आप्यो।</para>
  <para style="q2" vid="DAN 2:23">ज्‍यु वातु आमु फुसेल एता, त्युन बाराम तु आमुह केयो!</para>
  <para style="q2" vid="DAN 2:23">तु आमुह राजान होपनान बाराम केयो।”<verse eid="DAN 2:23" /></para>
  <para style="s1">राजाह होपनो एने तान मतलब केणो</para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 2:24" />ओवतो दानिएल अर्योक फाय गीयो, जाह नबुकदनेस्‍सर राजा बाबिलोन ने एकलीदार माणहाह खेतेम केरनेन केरता ठेरायेल इतो। दानिएल ताह केयो, “बाबेलवाला एकलीदार माणहाह मारे मा! माहु राजा फाय ली जा, मी राजाह तान होपनो एने होपनान मतलब केह।”<verse eid="DAN 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 2:25" />ओवतो अर्योक चालोच दानिएलाह राजा फाय ली गीयो, एने राजाह केयो, “यहुदान आरापी माय मी एक ओहलो एदमी होद लियेल हे, जो राजाह होपनान मतलब केय।”<verse eid="DAN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 2:26" />तेवी राजा दानिएलाह जो बेलतशस्सर केवातालो फुशो, “काय तु माहु मारा होपनो एने तान मतलब केय सिकेह काय?”<verse eid="DAN 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="DAN 2:27" />दानिएल राजाह जापाप आप्यो, “एय नबुकदनेस्‍सर राजा, तु फुसेल लिकायेल वातु एकलीदार, जादुगेर नाहते कसदी नाय केय सेकती, <verse eid="DAN 2:27" /><verse number="28" style="v" sid="DAN 2:28" />पुण हेरगा माय ओहलो बोगवान हे जो लिकायेल वातुह देखाड़ेह, तोस नबुकदनेस्‍सर राजाह होपना माय देखाड़ेल हे काय बोविष्याम काय काय एण्यो हे। तारा आथरोणा माय हुवते लेन तु होपना माय ज्‍यु वातु दिखेल एत्यु, त्यु ज्‍यु हेत्यु।”<verse eid="DAN 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 2:29" />एय राजा, जेवी तु तारा पोलांगा पोर लोटीन सोचणे बाज गीयो काय भविष्‍य माय काय काय एण्‍य हे। तेवी बोगवान लिकायेल वातुह देखाड़णार, आवणार्‍यु वातुह तुवाह देखाड़ दियेल हे।<verse eid="DAN 2:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="DAN 2:30" />बोगवान त्यु लिकायेल वातु माहु बी केय दियेल हे। ओहलो ज्यान वोजेसे नाह एनो काय मार फाय दिहरा माणहाह रेन जादा ईकेल हे, पुण माहु बोगवान ज्यी वातीह, ज्यानकेरता कियेल हे काय राजाह तान होपनान मतलब मालुम पोड़ जाय, एने तु तारा मोनान विचाराह सोमजी सिके।<verse eid="DAN 2:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="DAN 2:31" />एय राजा, जेवी तु देखणे बाजरियेल इतो, तेवी एक मोटली मुरती देखानी, एने ती मुरती जी तार सामने उबरियेल एती, ती लांबी चौड़ी एती; तीन चोमेक जुलूम एती, एने ती देखाणे माय बियावे ओहली एती। <verse eid="DAN 2:31" /><verse number="32" style="v" sid="DAN 2:32" />ती मुरतीन मुंड ते चोखाला होनान एतो, साती एने आथ चांदीन एता, पेट एने जांगु पितलान एत्यु, <verse eid="DAN 2:32" /><verse number="33" style="v" sid="DAN 2:33" />ती मुरतीन पायान नेचलो बाग लोड़ान एतो, एने ती मुरतीन पाय थोड़ाक लोड़ान, एने थोड़ाक माटड्यान एता। <verse eid="DAN 2:33" /><verse number="34" style="v" sid="DAN 2:34" />जेवी तु मुरतीन उगे देखणे बाजरियेल इतो, तेवी एक दिगोड़ बिगेर एगदान उखालेल, आप आप उखलीन ती मुरतीन लोड़ा एने माटड्या केरीन बुणेल पाया पोर जाय पोड़नो, एने ताह चुरावाल दिनो। <verse eid="DAN 2:34" /><verse number="35" style="v" sid="DAN 2:35" />तेवी लोड़ो, माटड्यो, पितलो, चांदी एने होनो बी, आखो चुरा चुरा एय गीयो, एने उनालाम खोलान बुहटान गेत वारा केरीन ओहला उड़ गीया, काय तान कायच पुतो नाह रिनो; एने तो दिगोड़ जो मुर्ती पोर पुड़ेल इतो, तो मोटलो बुयड़ो बोणीन आखी देरती पोर पोसरी गीयो।<verse eid="DAN 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 2:36" />“ज्‍य तारो होपनो हे; एने एवी आमु तान मतलब तुवाह सोमजाड़ देतेह। <verse eid="DAN 2:36" /><verse number="37" style="v" sid="DAN 2:37" />राजा तु आखाम रेन मोटलो राजो हे, काहाकाय हेरगावालो बोगवान तुवाह राज, सेत्‍ता, ताकेत एने बोड़ाय आपेल हे। <verse eid="DAN 2:37" /><verse number="38" style="v" sid="DAN 2:38" />एने जा का माणहे देखातेह, ताहरी तो ता आखाह, एने चोवगान जीव जेन्‍तु, एने जुगान चिड़ाह बी तारा ताबाम केर दियेल हेते; एने तुवाह ता आखान आदिकारी ठेरायेल हे, ज्‍य होनान मुंड तुस हे। <verse eid="DAN 2:38" /><verse number="39" style="v" sid="DAN 2:39" />तार पासाण एक राज आवी, जो तारा राज्‍याह रेन, आत्यो रेय; ओवतो एक उंजु तीसरो राज पितलान गेत राज रेय, जो आखी देरती पोर राज केरी। <verse eid="DAN 2:39" /><verse number="40" style="v" sid="DAN 2:40" />एने चोवथो राज, लोड़ान गेत मोजबुत रेय; जीहे लोड़ो आखी वोस्तुह टुकड़ा केरने, एने चुरा केरने, तिहेच केरीन ता चोवथा राज्या केरीन, ता आखा राज्‍यान चुरा चुरा केर देय। <verse eid="DAN 2:40" /><verse number="41" style="v" sid="DAN 2:41" />एने तु जो मुरतीन पाय एने तीन आंगल्‍याह दिख्यो, जा थोड़ाक कुमारान माटड्यान एने थोड़ाक लोड़ान एता, न्या माय तो चोवथो राज वाटायेल रेय; जिहकेरीन तु लोड़ो माटड्याम बेचकायेल दिख्यो, तिहेच केरीन ता माय बी लोड़ान गेत मोजबुती रेय। <verse eid="DAN 2:41" /><verse number="42" style="v" sid="DAN 2:42" />जिहकेरीन पायान आंगल्‍या थोड़ाक ते लोड़ान एने थोड़ाक माटड्यान एता, ज्यान मतलब ज्‍य हे काय, तो राज्य थोड़ोक ते मोजबुत एने थोड़ोक कोमजोर रेय। <verse eid="DAN 2:42" /><verse number="43" style="v" sid="DAN 2:43" />एने तु जो लोड़ाह कुमारान माटड्या हिऱ्यो बेचकायेल दिख्यो, ज्यान मतलब ज्‍य हे काय, ता राज्‍यान माणहे एका दिहरा माणहा हेऱ्या ईली मिलीन ते रेती, पुण जीहे लोड़ो माटड्या हेर्‍य मेल नाह खात, तिहेच केरीन तान एकी एय नाय। <verse eid="DAN 2:43" /><verse number="44" style="v" sid="DAN 2:44" />एने ता राजान राज केरनेन टेमाम हेरगावालो बोगवान, एक ओहलो राज लावी, जो कायेम रेय, तान केदी बी खेतेम नाय एय, एने नाह तो एगदी दिहरी जातीन आथाम केराय जाय। पुण तो राज्य आखा राज्‍याह चुरा चुरा केरी, एने ताह खेतेम केर देय; पुण तो राज्य कायेम टिकीन रेय। <verse eid="DAN 2:44" /><verse number="45" style="v" sid="DAN 2:45" />जीह केरीन तु दिखेल काय एक दिगोड़ एगदा माणहान आथा केरीन खोद्‍या बिगेर बोयड़ाम रेन उखल्‍यो, एने तो दिगोड़ लोड़ो, पितलो, माटड्यो, चांदी, एने होनाह चुरा चुरा किऱ्यो, इहीच केरीन मोटलो बोगवान राजाह देखाड़ेल हे काय ज्यान बाद काय काय एण्‍य हे। होपनो खेरो हे, एने तान मतलब माय काय सेंका नाह।”<verse eid="DAN 2:45" /></para>
  <para style="s">राजान द्‍वारा दानिएल ने मान</para>
  <para style="p">
    <verse number="46" style="v" sid="DAN 2:46" />ओलोक होमलीन नबुकदनेस्‍सर राजा मांड्या वोलीन दानिएलाह वोंद्‍यो, एने उकुम आप्यो काय ताह बेट चेड़ावो, एने तान सामने सुगन्‍द वोस्तु पेटाड़ो। <verse eid="DAN 2:46" /><verse number="47" style="v" sid="DAN 2:47" />ओवतो राजा दानिएलाह केयो, “खेरी ते ज्‍य हे काय तुमरो बोगवान, आखा बोगवानान बोगवान, राजान राजो हे, तोस आख्‍यु लिकायेल वातुह उगाड़णार हे, केरीन तु ज्यी लिकायेल वातु उगड्यु केर सीक्‍यो।” <verse eid="DAN 2:47" /><verse number="48" style="v" sid="DAN 2:48" />तेवी राजा दानिएल ने पोद मोठो किऱ्यो, एने ताह जुलूम मोटला मोटला दान आप्यो; एने ज्‍यो उकुम आप्यो काय तो बाबेलान आखा राज्या पोर आदिकारी एने बाबेलान आखा एकलीदार माणहान मुखी बोणी। <verse eid="DAN 2:48" /><verse number="49" style="v" sid="DAN 2:49" />तेवी दानिएल ने केणे से राजा शद्रक, मेशेक एने अबेदनगोह बाबेलान आखा राज्‍यान कामान उपेर मुखी आदिकारी केरीन निवाड़ केर दिनो; पुण दानिएल सोता राजान राजवाड़ाम रिनो।<verse eid="DAN 2:49" /></para>
  <chapter eid="DAN 2" />
  <chapter number="3" style="c" sid="DAN 3" />
  <para style="s">होनान मुरतीह वोंदणेन उकुम</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 3:1" />नबुकदनेस्‍सर राजा होनान एक मुरती बाणवाड्यो, जीन उचाय साठ आथ, एने चोवड़ाय सोव आथान एती, एने राजा मुरतीह बाबेल देसान दुरा नावान चोवगानाम उब राखाड्यो। <verse eid="DAN 3:1" /><verse number="2" style="v" sid="DAN 3:2" />तेवी नबुकदनेस्‍सर राजा आदिकारीन आदिकारी, आदिकारी, राज्‍यान आदिकारी, जेज, खेजानान आदिकारी, नियाव केरनारे, जिलान आदिकारी एने दिहरा आखा आदिकारीह, तान राज माय टोलवाणेन केरता हादाड्यो। राजा होदतालो काय ता आखा माणहे मुरतीन उसगाटेण ने केरता आवी। <verse eid="DAN 3:2" /><verse number="3" style="v" sid="DAN 3:3" />तेवी आदिकारीन आदिकारी, आदिकारी, राज्‍यान आदिकारी, जेज, खेजानान आदिकारी नबुकदनेस्‍सर राजान उब राखाड़ेल मुरतीन उसगाटेणान केरता एकठा एना, एने ती मुरतीन सामने उब रेना। <verse eid="DAN 3:3" /><verse number="4" style="v" sid="DAN 3:4" />तेवी कामदार मोठेस आयड़ीन केयो, “एय देसा देसान एने राज्या राज्‍यान माणहे, एने बात बातीन बाषा बोलनारे, तुमूह ज्‍यो उकुम होमलावाय जाथे काय, <verse eid="DAN 3:4" /><verse number="5" style="v" sid="DAN 3:5" />जुलबुखे तुमू बिरा, पावली, विणा, सारंगी, सितार, शहनाई आखी बातीन वाजान सोबदा होमेलहो, तुलेच बुखे तुमू डोंगा वोलीन नबुकदनेस्‍सर राजान उब राखाड़ेल होनान मुरतीह वोंदो। <verse eid="DAN 3:5" /><verse number="6" style="v" sid="DAN 3:6" />एने जो कुण डोंगो वोलीन होनान मुरतीह वोंदे नाय, ताहार ता माणहाह चालोच देदमीताला आक्‍ठान बाठाम टाकाय जाय।” <verse eid="DAN 3:6" /><verse number="7" style="v" sid="DAN 3:7" />केरीन जीहे ता आखा राज्‍यान माणहाह बिरो, पावली, विणा, सारंगी, सितार शहनाई एने आखी बातीन वाजान बोल होमलानो, तेवी आखा राज्‍यान माणहे एने बात बातीन बाषा बोलनारे डोंगा वोलीन ती होनान मुरतीह, जी नबुकदनेस्‍सर राजा उब राखाड़ेल इतो, वोंद्या।<verse eid="DAN 3:7" /></para>
  <para style="s">दानिएल ने तीनु हाती पोर उकुम टालनेन आरोप</para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 3:8" />तान पासाण, थोड़ाक कसदी पुजारा राजा फाय आवा, एने यहुदिन चुगली केऱ्या। <verse eid="DAN 3:8" /><verse number="9" style="v" sid="DAN 3:9" />ता नबुकदनेस्‍सर राजाह केया, “एय राजा, तु कायेम जीवतालो रिहे! <verse eid="DAN 3:9" /><verse number="10" style="v" sid="DAN 3:10" />एय राजा, तु ते ज्‍यो उकुम आपेल हे काय, जो माणुह बिरो, पावली, विणा, सारंगी, सितार, शहनाई आखी बातीन वाजान सोबदो होमले, तो डोंगो वोलीन ती होनान मुरतीह वोंदे, <verse eid="DAN 3:10" /><verse number="11" style="v" sid="DAN 3:11" />एने जो कुण डोंगो वोलीन वोंदे नाय तो देदमीताला आक्‍ठान बाठाम टाकाय जाय। <verse eid="DAN 3:11" /><verse number="12" style="v" sid="DAN 3:12" />पुण थोड़ाक यहुदि हेते, जाह तु बाबेल देसान कामान केरता निवोड़ किरेल हे, मतलब शद्रक, मेशेक एने अबेदनगो। एय राजा, ज्या तारा उकुमाह नाह मानेल सोता, ता नाहते तारा देवतान बोक्ती केरतेह एने जी होनान मुरती तु उब राखाड़ेल हे, तीह वोंदते नाह।”<verse eid="DAN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 3:13" />ज्‍य होमेलतास नबुकदनेस्सराह राग आवो। तो शद्रक, मेशेक एने अबेदनगोह हादणे मोकल्‍यो। सिपाय तीनु माणहाह राजान सामने लावा। <verse eid="DAN 3:13" /><verse number="14" style="v" sid="DAN 3:14" />नबुकदनेस्‍सर ताह फुशो, “एय शद्रक, मेशेक एने अबेदनगो, काय ज्‍य खेरीच हे काय मार देवतान बोक्ती नाह केरते, ते काय तुमू जाण बुजीन ओहलो केरतेह? <verse eid="DAN 3:14" /><verse number="15" style="v" sid="DAN 3:15" />केदी तुमू एवी तियार एती ताहार, जेवी बिरा, पावली, विणा, सारंगी, सितार, शहनाई आखी बातीन वाजान सोब्दो होमेलहो, एने तुलेचबुखे डोंगा वोलीन मारे बाणायेल मुरतीह वोंदहो, ताहार वोचहो; एने केदी तुमू वोंदहो नाय ताहार तुमूह चालोच देदमीताला आक्‍ठान बाठाम टाकाय जाहो; ओवतो ओहलो काल्लो देवता हे, जो तुमूह मारा आथाम रेन सोड़ीव सेकी?”<verse eid="DAN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 3:16" />शद्रक, मेशेक एने अबेदनगो राजाह केया, “एय नबुकदनेस्‍सर राजा, ज्यी वातीन बाराम आमुह तार सामने सोताह वोचाड़नेन गिरेज नाह सोती। <verse eid="DAN 3:16" /><verse number="17" style="v" sid="DAN 3:17" />केदी तु आमुह देदमीताला आक्‍ठान बाठाम टाकहे, ताहार आमरो बोगवान जान आमु सेवा केरतेह, आमुह आक्‍ठान बाठाम रेन वोचाड़नेन ताकेतवोर हे, एने एय राजा, तो आमुह तारा आथाम रेन बी वोचाड़ी। <verse eid="DAN 3:17" /><verse number="18" style="v" sid="DAN 3:18" />पुण केदी बोगवान आमुह नाय बी वोचाड़ी, तीबी एय राजा, आमु तुवाह केतेह काय आमु तारा देवतान बोक्ती नाय केरहु, एने नाह तारी उब राखाड़ेल मुरतीह वोंदहु।”<verse eid="DAN 3:18" /></para>
  <para style="s">दानिएल ने तीनु हातीह बाठाम टाकाय जाणो</para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 3:19" />तेवी नबुकदनेस्‍सर राजाह जुलूम राग आवो, तो शद्रक, मेशेक एने अबेदनगोन उगे रागाम दिख्यो। एने तो उकुम आप्यो काय, आक्‍ठान बाठाह हात गुणा वोदार देदमाड़ दिवो। <verse eid="DAN 3:19" /><verse number="20" style="v" sid="DAN 3:20" />ओवतो राजा तान सेनाम रेन, थोड़ाक ताकेतवोर सिपायाह उकुम आप्यो, काय शद्रक, मेशेक एने अबेदनगोह बांदिन देदमीताला आक्‍ठान बाठाम टाक दिवो। <verse eid="DAN 3:20" /><verse number="21" style="v" sid="DAN 3:21" />तेवी ता माणहे तीनु जाणाह तान पिरेल मोज्‍या, डेगला, टोप्या एने दिहरा फाड़का बेल बांदिन ता देदमीताला आक्‍ठान बाठाम टाक देना। <verse eid="DAN 3:21" /><verse number="22" style="v" sid="DAN 3:22" />तो आक्‍ठान बाठो ते राजान मोजबुत उकुमान वोजेसे जुलूम देदमावाय जायेल एतो, केरीन जा माणहे शद्रक, मेशेक एने अबेदनगोह उखल्‍या तास आक्‍ठान आसी केरीन हेलगीन मोर गीया। <verse eid="DAN 3:22" /><verse number="23" style="v" sid="DAN 3:23" />पुण ज्या तीनु मतलब शद्रक, मेशेक एने अबेदनगो देदमीताला आक्‍ठान बाठीन विचीम बांदायेल जाय पोड़ना।<verse eid="DAN 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 3:24" />तेवी नबुकदनेस्‍सर राजा बोंगलानो एने बियीन उबरी गीयो। एने तान मोंत्रीह फुशो, “काय आपु ता आक्‍ठान विचीम तीनुस एदमी बांदायेल नाह टाक्या?” ता राजाह जापाप आप्या, “होव राजा खेरी वात हे।”<verse eid="DAN 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 3:25" />ओवतो राजा केयो, “दिखो, माहु ते आक्‍ठान मायतो, न्या पोला फिरते लेन चार माणहे देखाणे बाजरेनाह; ता बांदायेल नाह सोता एने आक्‍ठो न्यान कायच नाह बिगाड़ सीकेल हे। दिखो, तो चोवथो एदमी ते बोगवानान सोरान होस देखाणे बाजरिनोह!”<verse eid="DAN 3:25" /></para>
  <para style="s">दानिएल ने तीनु हातीन मान</para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 3:26" />ओवतो नबुकदनेस्‍सर ता देदमीताला आक्‍ठान बाठान बायणा हिऱ्यो जाएन केणे बाज गीयो, “एय शद्रक, मेशेक एने अबेदनगो, एय मोटला बोगवानान सेवक निकलीन बाहेर आवो!” ज्‍य होमलीन शद्रक, मेशेक एने अबेदनगो आक्‍ठान विचीम रेन निकील आवा। <verse eid="DAN 3:26" /><verse number="27" style="v" sid="DAN 3:27" />जेवी ता बाहेर आवा ते आदिकारीन आदिकारी, आदिकारी, राज्‍यान आदिकारी, एने राजान मोंत्री एकठा एना, एने आक्‍ठा केरीन शद्रक, मेशेक एने अबेदनगो हेलग्‍या नाह, ज्‍य ता माणहे दिखेल एता। तान लेट्या एने फाड़का कायच हेलगेल नाह एता। ओलोस नाह पुण ता आक्‍ठाम एता तीबी तान सेरीर हेलगेल ओहलोह गेंदातालो नाह।<verse eid="DAN 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 3:28" />ओवतो नबुकदनेस्‍सर केयो, “शद्रक, मेशेक एने अबेदनगोन बोगवानान बोड़ाय किरो। तान बोगवान तान हेरोगदुताह मोकलीन, तान न्या सेवकाह ज्यानकेरता वोचाड्यो, काहाकाय न्या राजान उकुम नाह मानीन, तास पोर बुरहो मेल्या, एने ज्‍य सोचीन तान सेरीर बी आप देना काय, आमु आमरा बोगवानाह सोड़ीन एगदा देवताह वोंदहु नाय।”<verse eid="DAN 3:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 3:29" />“केरीन एवी मी ज्‍यो उकुम आपथु काय, काल्ला बी राज्‍यान एने काल्ली बी बाषा बोलनार, एगदो माणुह केदी शद्रक, मेशेक एने अबेदनगोन बोगवानान काह चिहटा केरी, ताहार तान टुकड़ा टुकड़ा केराय जाय, एने तान गेर रोखड़ान डेर बाणावाय जाय; काहाकाय ओहलो काल्लो उंजु देव नाह जो इहकेरीन वोचाड़ सिके।”<verse eid="DAN 3:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="DAN 3:30" />तेवी राजा शद्रक, मेशेक, एने अबेदनगोह बाबेल देसाम उंजु बी उचो पोद आप्यो।<verse eid="DAN 3:30" /></para>
  <chapter eid="DAN 3" />
  <chapter number="4" style="c" sid="DAN 4" />
  <para style="s">नबुकदनेस्‍सरान दिहरो होपनो</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 4:1" />नबुकदनेस्‍सर राजान उगे रेन देसा देसान एने राज्या राज्‍यान माणहाह, एने बात बातीन बाषा बोलनारे जा आखी दुनिया माय वोह रियेल एता, ज्‍य पोत्र मोकल्‍यो, “तुमूह जुलूम सान्ती जुड़ी।” <verse eid="DAN 4:1" /><verse number="2" style="v" sid="DAN 4:2" />माहु ज्‍य हाजो लागो, काय आखाम रेन मोटलो बोगवान, माहु जी जी निसाणी एने चोमेत्कार देखाड़ेल हे, ताह देखाडु।<verse eid="DAN 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="DAN 4:3" />“बोगवान बोंगलाय ओहलोह चोमेत्कार किरेल हे!</para>
  <para style="q1" vid="DAN 4:3">बोगवानान राज कायेम टिकीन रीथे;</para>
  <para style="q1" vid="DAN 4:3">एने तान राज पिढीन पिढ़ी वोर बोणीन रीथे।”<verse eid="DAN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 4:4" />“मी नबुकदनेस्‍सर मारा गेराम हुकेह एने मारा राजवाड़ाम खुसी माय रेतालो। <verse eid="DAN 4:4" /><verse number="5" style="v" sid="DAN 4:5" />मी एक होपनो देखीन बिय गीयो; मी मारा आथरोणाम हुवणे बाजरियेल इतो, एने जा विचार मारा मोनाम आवा, एने ज्‍यु वातु मी दिख्यो, तान वोजेसे मी बिय जायेल इतो। <verse eid="DAN 4:5" /><verse number="6" style="v" sid="DAN 4:6" />केरीन मी उकुम आप्यो, काय बाबेल ने आखा एकलीदार माणहे, मारा होपनान मतलब केणेन केरता मार फाय हादिन लावे। <verse eid="DAN 4:6" /><verse number="7" style="v" sid="DAN 4:7" />जेवी जादुगेर एने कसदी माणहे मार फाय आवा, ते मी ताह मारा होपनान बाराम केयो, पुण ता माणहे माहु मारा होपनान मतलब नाह केय सेक्‍या। <verse eid="DAN 4:7" /><verse number="8" style="v" sid="DAN 4:8" />सेवली बुखेत दानिएल मार फाय आवो, मी मारा देवताह मान आपणेन केरता दानिएलाह बेलतशस्सर नाव आपेल इतो, एने जा माय चोखाला बोगवानान जीव रीथे; एने मी ताह मारो होपनो केय होमलायो। <verse eid="DAN 4:8" /><verse number="9" style="v" sid="DAN 4:9" />मी ताह केयो, एय बेलतशस्सर, तु ते आखा जादुगेरान मुखी हे, माहु मालुम हे काय तार माय चोखाला बोगवानान जीव रीथे, मी जाणथो काय काल्ली बी लिकायेल वातुह सोमेजणे तार केरता केठीण नाह सोतो; केरीन जो होपनो मी दिखेल हे ताह मतलबा बेल माहु केन सोमजाड़ दे।”<verse eid="DAN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 4:10" />“जो देरसेन मी मारा पोलांगा पोर हुवतालोन दिखेल तो ज्‍य हे : मी दिख्यो, काय देरतीन विचीम एक जाड़ उब रेनोह; तो जाड़ जुलूम उचो हे। <verse eid="DAN 4:10" /><verse number="11" style="v" sid="DAN 4:11" />तो जाड़ मोठो एन मोजबुत एय गीयो, एने तान उचाय जुगाम वोर पोचनी, एने तो जाड़ देरती पोर काहरी रेन बी देखातालो। <verse eid="DAN 4:11" /><verse number="12" style="v" sid="DAN 4:12" />तान पाला होबाता, एने ता जाड़ा पोर जुलूम फोले लाग रियेल एता, एने ता जाड़ा पोर आखान केरता बोरपुर खाणो जुड़तालो। जाड़ान बुंदे आखा जेंगली जेनवेराह सावलो जुड़तालो, एने जाड़ान डालख्‍यु पोर चिड़ा रेताला, एने आखा चिड़ा, जेनवेराह ता जाड़ा सेस खाणो जुड़तालो।”<verse eid="DAN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 4:13" />जेवी मी पोलांगा पोर लोट लोट्‍यो देरसेन माय त्यु चिजुह देखणे बाजरियेल इतो, तेवी एक चोखालो हेरोगदुताह हेरगाम रेन नेचो उतेरतालो दिख्यो। <verse eid="DAN 4:13" /><verse number="14" style="v" sid="DAN 4:14" />तो मोठेस केयो, “जाड़ाह काट दिवो, तान डालख्युह साट दिवो, तान पाला आबड़ी दिवो, एने तान फोलाह कावदेन फाकेर दिवो; ज्या जाड़ान बुंदे आसरो सापड़ायेल जेनवार जुलूम सेटा नाह जाती, ज्यान डालख्‍यु पोर बुहेल चिड़ा सेटा उड़ जाती। <verse eid="DAN 4:14" /><verse number="15" style="v" sid="DAN 4:15" />पुण ज्यान थुड़ाह मुला बेल बुयी माय रेणे दिवो, एने कावदेन लोड़ान एने पितलान जाला लागाड़ो।”</para>
  <para style="p" vid="DAN 4:15">“तान आहने पाहने उगेल खेड़ा हेर्‍य ज्यान थुड़ एने ज्यान मुल बुयी माय रेय। तो जुगान ओहटा केरीन बिज्‍या केरी एने बुयीन खेड़ खाणे माय चोवगानान जेनवारा हेर्‍य बागी एय। <verse eid="DAN 4:15" /><verse number="16" style="v" sid="DAN 4:16" />तान मोन बोदले एने माणहान गेत नाय रेय, पुण जेनवेरान गेत बोण जाय; इहकेरीन ताह सात वोरीह काड़ने पोड़ी। <verse eid="DAN 4:16" /><verse number="17" style="v" sid="DAN 4:17" />ज्‍यो उकुम चोखालो हेरोगदुत ज्या देन्‍डान गोसणा मोठेस होमलायो, काहाकाय जा जीवताला हेते ता जाण जाय काय आखाम रेन मोटलो बोगवान माणहान राज्‍याम राज किरेह, बोगवान तान मोरजी पारमाणे ज्या राज्‍याह ताह पोटी ता माणहान आथाम हुपेह। ता राज्या पोर राज केरनेन केरता तो आत्याम रेन आत्‍या माणहाह आदिकारी ठेराव दिथे।”<verse eid="DAN 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 4:18" />मी नबुकदनेस्‍सर राजा होपना माय ज्‍योस दिखेल हे। केरीन “एय बेलतशस्सर, तु ज्यान मतलब के, काहाकाय मारा राज्‍यान काल्लो बी एकलीदार माणुह ज्या होपनान मतलब माहु सोमजाड़ नाह सिक्‍यो, पुण तार माय ते चोखाला बोगवानान जीव रीथे, केरीन तु होपनो केय सिकेह।”<verse eid="DAN 4:18" /></para>
  <para style="s">दानिएल ने द्‍वारा होपनान मतलब केणो</para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 4:19" />तेवी दानिएल जान नाव बेलतशस्सर बी एतो, थोड़ीक वार ने केरता एकदोम ठावकोस एय गीयो। तो ज्‍यु वातुन तान मोनाम विचार किरते रिनो तो देखीन राजा केयो, “बेलतशस्सर माहु होपनान मतलब केणे बुखेत बिय मा।”</para>
  <para style="p" vid="DAN 4:19">ओवतो बेलतशस्सर राजाह केयो, “एय मारा मालीक, ज्‍य होपनो तारा दुसमोना पोर पोड़ी, एने ज्यान फोल, जा तारा विरोदी हेते, ताह जुड़ी!” <verse eid="DAN 4:19" /><verse number="20" style="v" sid="DAN 4:20" />जा जाड़ाह तु दिखेल, तो मोठो एन मोजबुत एय गीयो, जा जाड़ान सिगो जुगाह टेकतालो, एने जाह आखी देरती पोर रेन देख सेकताला। <verse eid="DAN 4:20" /><verse number="21" style="v" sid="DAN 4:21" />जान पाला होबाता एने फोले जुलूम एता, एने जा माय आखान केरता खाणो एतो; जान नेचा जेंगलान आखा जेनवारे रेताला, एने जान डालख्‍यु पोर जुगान आखा चिड़ा बोह्या केरताला,<verse eid="DAN 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="DAN 4:22" />“एय राजा, तो जाड़ तुस हे। तु मोठो एन ताकेतवोर बोण जायेल हे, तारी बोड़ाय जुगाम वोर पुचेल हे, एने तारो राज देरतीन काने कोपरे वोर पोसरेल हे। <verse eid="DAN 4:22" /><verse number="23" style="v" sid="DAN 4:23" />एने एय राजा, तु जो एक चोखाला हेरोगदुताह हेरगाम रेन उतेरतालो एने ज्‍य केतालो दिख्यो काय जाड़ाह काट दिवो एने ताह खेतेम केर दिवो, पुण थुड़ एने मुले रेणे दिवो। तान कावदेन लोड़ो एने पितलान जाल बांदिन ताह निल्‍ला खेड़ान विचीम रेणे दिवो; तो जुगान ओहटा केरीन बिज्‍या केरी, एने ताह चोवगानान जेनवारा हेऱ्याच ईसो जुड़ी; एने जाह वोर सात वोरह्या ता पोर विते नाय, ताह वोर तान ओहलीस देशा रेय।<verse eid="DAN 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 4:24" />“एय राजा, ज्यान मतलब एने जो उकुम आखाम रेन मोटलो बोगवान राजान केरता ठेरायेल हे, तो ज्‍य हे, <verse eid="DAN 4:24" /><verse number="25" style="v" sid="DAN 4:25" />एय नबुकदनेस्‍सर राजा तुवाह माणहान विचीम रेन सेटो जाणु पोड़ी, एने तु जेंगली जेनवारा हिऱ्यो रिहे; डोरान गेत तुवाह चारो खाणे पोड़ी; एने जुगान ओहटा केरीन बिज्‍या किरहे, एने सात वोरह्या वोर तारी ज्‍यीस देशा रेय, जाह वोर काय तु जाण नाय जाहे काय माणहान राज्या माय बोगवानुस आदिकार मिलेह, एने तो जाह पसन किरेह ताह आप दिथे। <verse eid="DAN 4:25" /><verse number="26" style="v" sid="DAN 4:26" />एने ता जाड़ान थुड़ाह मुला बेल बुयीम सोड़नेन उकुमान मतलब ज्‍य हे काय तारो राज्य तुवाह पोशो जुड़ जाय; पुण ज्‍य तुलबुखे एय, जेवी तु ज्‍य जाण जाहे काय तारा राज्या पोर बोगवानास ने आदिकार हे। <verse eid="DAN 4:26" /><verse number="27" style="v" sid="DAN 4:27" />केरीन एय राजा, मारे होमेल पाप केरनेन सोड़ दे, एने जो हाजो तोस केर; खाराब काम मा केरी, गेरब्‍या पोर गीण केर। तेवीस तु सफल बोणीन रेय सिकहे।”<verse eid="DAN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 4:28" />ज्‍यु आख्‍यु वातु नबुकदनेस्‍सर राजा हेर्‍यु एन्यु। <verse eid="DAN 4:28" /><verse number="29" style="v" sid="DAN 4:29" />बारा मोयना वितणेन बाद जेवी नबुकदनेस्‍सर राजा बाबेल माय तान किल्‍लान साजा पोर फिरने बाजरियेल इतो, तेवी तो केणे बाज गीयो, <verse eid="DAN 4:29" /><verse number="30" style="v" sid="DAN 4:30" />“बाबेलाह दिखो! ज्या मोटला हेयरान बाणावोट मी किरेल हे। ज्‍य किल्‍लो मारो हे! मी मारी ताकेत केरीन ज्यी मोटली राजदानीन बाणावोट किरेल हे। ज्या जागान बाणावोट मी ज्‍य देखाड़नेन केरता किरेल हे काय मी कोलोक मोठो हे।”<verse eid="DAN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="DAN 4:31" />राजा ज्यी वात केणेस बाजरियेल इतो, तेवी हेरगाम रेन आवाज आवो, “एय राजा नबुकदनेस्‍सर, तार बाराम ज्‍यो उकुम निकलेह काय राज तारा आथाम रेन निकली गीयो, <verse eid="DAN 4:31" /><verse number="32" style="v" sid="DAN 4:32" />एने तु माणहान विचीम रेन निकालाय जाहे, एने जेंगली जेनवारा हिऱ्यो रिहे; एने डोरान गेत खेड़ खाहे। एने सात वोरीह तार पोर वित्‍ती, जाह वोर तु ज्‍य नाय जाण जाहे काय माणहान राज्‍याम बोगवान आदिकार मिलेह, एने तो तान मोरजी पारमाणे माणहान आथाम राज हुपेह!”<verse eid="DAN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="DAN 4:33" />एने नबुकदनेस्‍सर ने बाराम कियेल वचन चालोच पुरो एनो। नबुकदनेस्सराह माणहाह रेन सेटो जाणे पोड़नो, ताह डोरान गेत खेड़ खाणे पोड़नो तो ओहटाम बिजनो। तान लेट्या मोराग्यान फिसान गेत तान लेट्या लांबा वोद गीया, एने नेखे चिड़ान नेखान गेत वोद गीया।<verse eid="DAN 4:33" /></para>
  <para style="s">नबुकदनेस्‍सरान द्‍वारा बोगवानान बोड़ाय केरनो</para>
  <para style="p">
    <verse number="34" style="v" sid="DAN 4:34" />“हात वोरह्या वितणे बाद,” मी नबुकदनेस्‍सर उपेर हेरगान उगे दिख्यो, ओवतो मी हास केरीन सोच विचार केरने बाज गीयो; तेवी मी आखाम रेन मोठो बोगवानान बोड़ाय किऱ्यो जो जेलेम जीवतालो हे तान बोड़ाय ज्‍य केन केरने बाज गीयो :</para>
  <para style="q1" vid="DAN 4:34">“बोगवानान राज कायेम ने हे,</para>
  <para style="q2" vid="DAN 4:34">एने तान राज पिढीन पिढ़ी वोर रेणार हे।<verse eid="DAN 4:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="DAN 4:35" />ज्यी देरतीन आखा रेणारे माणहे खेरीच मोहत्वान नाह सोता,</para>
  <para style="q2" vid="DAN 4:35">एने तो हेरगान सेना एने देरती पोर वाला</para>
  <para style="q2" vid="DAN 4:35">माणहान विचीम तान मोरजी पारमाणे काम किरेह;</para>
  <para style="q1" vid="DAN 4:35">एने कुण ताह रोकीन ताह नाह केन सिकेत,</para>
  <para style="q2" vid="DAN 4:35">तु ज्‍य काय किरेल हे?”<verse eid="DAN 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 4:36" />तुलेच बुखे, बोगवान माहु मारी ईकेल पोशी आप देनी; एने तो एक राजान वेहाम मारो मान एने ताकेत बी पोशी आप दिनो। मारा मोंत्री एने मारा राजवाड़ान माणहे पोशा मार फाय आवणे बाज गीया, मी पुशो राजा बोण गीयो। मी पेल रेन बी जुलूम मोटलो एने ताकेतवोर एय जायेल इतो।<verse eid="DAN 4:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="DAN 4:37" />“एवी मी नबुकदनेस्‍सर हेरगावाला राजान बोड़ाय केरथु, ताह मान एने बोड़ाय आपथु। तो जो काय किरेह, ठिक किरेह, एने तान आखा वेवार नियावान हेते; एने गोमेंडी माणहाह गेरबोड़ा केरनेन ताकेतवोर हे।”<verse eid="DAN 4:37" /></para>
  <chapter eid="DAN 4" />
  <chapter number="5" style="c" sid="DAN 5" />
  <para style="s">बितड़ा पोर लेखायेल लेख्‍य</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 5:1" />एक दिह बेलशस्सर नावान राजा तान एक एजार मुखी माणहान केरता एक मोटलो बांडारो किऱ्यो, एने ता हिऱ्यो अंगुरान रोह पिदो। <verse eid="DAN 5:1" /><verse number="2" style="v" sid="DAN 5:2" />अंगुरान रूह पितो पितो बेलशस्सर उकुम आप्यो काय, होना चांदीन जा ठामला मारो आबोख नबुकदनेस्‍सर यरूशलेम ने मोंदिर माय रेन लुटीन लायेल इतो, ताह लियावो काय राजा तान मुखी, राण्यु, एने पावेरन्‍यु बेल ता माय पिय। <verse eid="DAN 5:2" /><verse number="3" style="v" sid="DAN 5:3" />तेवी जा होनान ठामला यरूशलेम माय बोगवानान मोंदिर माय रेन लुटीन लायेल एता, ता लावा; एने राजा तान मुखी, एने राण्यु, पावेरन्‍यु बेल ता ठामला माय पिय लेदा। <verse eid="DAN 5:3" /><verse number="4" style="v" sid="DAN 5:4" />ता अंगुरान रोह पिन होना, चांदी, पितलान, लोड़ान, लाकड़ान एने देगड़ान मुरतीन बोड़ाय केरताला।<verse eid="DAN 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 5:5" />तुलेच बुखे उचकाहुस माणहान आथ बितड़ा पोर लेखतालो देखाणे बाज गीयो, दिवान सामने राजवाड़ान बितड़ा पोर आथा केरीन लेखातालो राजा दिख्यो। <verse eid="DAN 5:5" /><verse number="6" style="v" sid="DAN 5:6" />ताह देखीन बेलतशस्सर राजा जुलूम बिय गीयो, तान मुय बियीन वोजेसे पेलो पोड़ गीयो एने तान आथ पाय थेर थेर कापणे बाज गीया, तान पाय लेरबोड़ाय पोड़ना काय तो उबी बी नाह रेय सेकतालो। <verse eid="DAN 5:6" /><verse number="7" style="v" sid="DAN 5:7" />तेवी राजा मोठेस आयड़ीन उकुम आप्यो काय जादुगेर एने कसदी पुजारा एने बोड़वा ता फाय आवी। एने राजा बाबेल ने न्या इकेलवाह केयो, “जो कुण ज्या लेख्‍याह वाचीन ज्यान मतलब माहु सोमजाड़े, मी ताह जामण्या रेंगान डेगलो एने तान गेलाम होनान हार पेरावुह, एने मी ताह मारा राज्‍यान तीसरो आदिकारी बाणाव देह।” <verse eid="DAN 5:7" /><verse number="8" style="v" sid="DAN 5:8" />ओवता राजान आखा एकलीदार माणहे माय आवा, पुण ताह लेख्‍य वाचता ओवेड़नो नाह; एने राजाह तान मतलब सोमजाड़ नाह सेक्‍या। <verse eid="DAN 5:8" /><verse number="9" style="v" sid="DAN 5:9" />तेवी बेलशस्सर राजा जुलूम बिय गीयो, तान मुय उंजु बी उतेर गीयो; एने तान मुखी बी जुलूम बिय गीया।<verse eid="DAN 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 5:10" />तेवी राजान एने मुखीन वातुह होमलीन राजान डावाली आहख राणी, रांदण्या गेराम आवीन केयी, “एय राजा तु जेलेम जेलेम जीवतालो रिहे, तार मोनाम मा बिय एने चिन्ता मा केरी। <verse eid="DAN 5:10" /><verse number="11" style="v" sid="DAN 5:11" />तारा राज्‍याम एक ओहलो माणुह हे, जा माय चोखाला बोगवानान जीव रीथे, तारा आबाख ने राज कालाम ज्‍यो माणुह ताह लिकायेल वातु सोमेजत्‍युह ज्‍य देखाड़ दियेल इतो काय तो जुलूम चालाक एने एकलीदार हे। तो ज्‍य देखाड़ दियेल इतो काय ज्‍यु वातु माय तो बोगवानान गेत हे। तारो डावालो आबोख नबुकदनेस्‍सर राजा ज्या एदम्याह आखा एकलीदार एदम्या पोर मुखी निवोड़ किरेल इतो। तो आखा कसदी जादुगेर माणहा पोर आदिकार चालाड़तालो। <verse eid="DAN 5:11" /><verse number="12" style="v" sid="DAN 5:12" />मी जा माणहान बाराम वातु केणे बाजरेनीह, तान नाव दानिएल हे। पुण राजा तान नाव बेलतशस्सर नाव मिलेल हे। दानिएल जुलूम चालाक हे, एने जुलूम वातु जाणेह तो होपनान मतलब केय सिकेह, वार्ताह सोमजाड़ सिकेह केठीण सावालान जापाप आपणेन ता फाय ताकेत हे; केरीन तु दानिएलाह हादाड़ ले, बितड़ा पोर जो लिखेल हे; तान मतलब तुवाह तोस केय।”<verse eid="DAN 5:12" /></para>
  <para style="s">लेख्यान मतलब केणो</para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 5:13" />ओवता दानिएलाह राजान सामने लावा एने ताह फुशो, “तारो नाव दानिएल हे काय? जो मारो आबोख नबुकदनेस्‍सर राजा यहुदा देसाम रेन लायेल इतो। <verse eid="DAN 5:13" /><verse number="14" style="v" sid="DAN 5:14" />मी होमलेल हे, काय बोगवानान जीव तार माय रिथे एने मी ज्‍य बी होमलेल हे, काय तु लिकायेल वातुह सोमजेह, तु जुलूम चेतुर एने एकलीदार हे। <verse eid="DAN 5:14" /><verse number="15" style="v" sid="DAN 5:15" />बितड़ा पोर वालो ज्‍य लेख्‍य वाचणेन केरता, जादुगेर एने एकलीदार माणहे न्‍याहरी आवा काय ज्‍य लिखेल वाचे, एने तान मतलब माहु सोमजाड़े, ओहली मारी मोरजी एती; पुण ताह ता लेख्यान मतलब सोमजाड़ता नाह ओवड़नो। <verse eid="DAN 5:15" /><verse number="16" style="v" sid="DAN 5:16" />मी तार बाराम होमलेल हे, तुवाह वातुन मतलब केता ओवड़ेह लिकाईल वातु तु केय सिकेह। केरीन केदी तु बितड़ा पोर वालो लेख्‍य वाचीन तान मतलब माहु सोमजाड़हे, ताहार मी तुवाह जामण्या रेंगान फाड़का आपुह, एने तारा गेलाम होनान हार पेरावुह, एने राज्‍याम तीसरो तुस राज किरहे।”<verse eid="DAN 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 5:17" />ओवतो दानिएल राजाह केयो, “तारो दान तारेस फाय मेल; नाहते दिहराह आप दे; माहु काय नाय जुवे। मी तुवाह बितड़ा पोर वालो लेख्‍य वाचीन तान मतलब सोमजाडुह।”<verse eid="DAN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 5:18" />“एय राजा, मुखी बोगवान तारा आबाख नबुकदनेस्सराह, एक मोटलो ताकेतवोर राजा बाणायेल इतो। बोगवान ताह बोड़ाय एने आदार एने बाहदुर बाणायेल इतो। <verse eid="DAN 5:18" /><verse number="19" style="v" sid="DAN 5:19" />जुलूम देसान, माणहे एने बात बातीन बाषा बोलनारे माणहे नबुकदनेस्सराह बिया केरताला, काहाकाय मोटलो बोगवान ताह एक जुलूम मोठो राजा बाणायेल इतो। केदी नबुकदनेस्‍सर एगदाह मारने होदतालो, ताहार ताह मार देतालो एने एखेह माणुह जीवतालो रेय इहकेरीन ताह लागनो ताहार ताह जीवतालो रेणे देतालो। केदी तो माणहाह मोठो बाणावणे होदतालो, ताहार तो ताह मोठो बाणाव देतालो, एने जाह नेचो पाड़ने होदतालो ताह नेचो पाड़ देतालो। <verse eid="DAN 5:19" /><verse number="20" style="v" sid="DAN 5:20" />पुण जेवी नबुकदनेस्‍सरान मोन मोठाय केरने बाज गीयो, एने तो एकएट्‍यो बोण गीयो, केरीन ताह राजगादि सोड़ने पोड़नी; एने तान बोड़ाय ता फाय रेन सांडाड़ाय गियी। <verse eid="DAN 5:20" /><verse number="21" style="v" sid="DAN 5:21" />नबुकदनेस्‍सर माणहान विचीम रेन निकालाय गीयो, तान मोन जेनवेरान गेत एय गीयो, तो जेंगली गेदड़ा हिऱ्यो रिनो; एने तो बोयलान गेत चारो खातालो, एने तो ओहटा माय बिजनो, जाह वोर काय तो सोमजी नाह गीयो काय आखाम रेन मोटलो बोगवान माणहान राज्या माय राज किरेह एने जाह हुदेह ताहास ता पोर आदिकारी ठेरावेह।”<verse eid="DAN 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="DAN 5:22" />“पुण एय बेलशस्सर, तुवाह ज्‍य आखो मालुम हे, तु नबुकदनेस्‍सरान बिटोख हे, पुण तु गेरबोड़ो एनो नाह। <verse eid="DAN 5:22" /><verse number="23" style="v" sid="DAN 5:23" />पुण तु गेरबोड़ो एनो नाह, एने उलटो हेरगावाला मालक्यान विरूद एय गीयो। तु बोगवानान मोंदिरीन ठामलाह तार फाय मांगाड़ीन तारा आदिकारी, ताऱ्यु बायकु एने पावेरन्‍यु बेल तु ता माय अंगुरान रूह पिदो; एने होनो, चांदी, पितलो, लोड़ो, एने दिगोड़ न्या केरीन बाणायेल देवतान तु बोड़ाय किऱ्यो। ता खेरला देव नाह सोता। ता देख नाह सेकते, होमेल नाह सेकते, एने ता काय सोमेज बी नाह सेकते तान ते बोड़ाय किऱ्यो, पुण जा बोगवानान आथाम तारो जीव हे, एने जान ताबाम तारो आखो चालनो फिरनो हे, तान तु बोड़ाय नाह किऱ्यो। <verse eid="DAN 5:23" /><verse number="24" style="v" sid="DAN 5:24" />केरीन बोगवानान उगे रेन ज्‍यो आथ मोकलानो एने ज्‍य लेख्‍य लेखानो।”<verse eid="DAN 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 5:25" />“बितड़ा पोर जा सोब्‍दा लेखायेल ता ज्या हेते, मने, मने, तकेल, उपर्सीन।” <verse eid="DAN 5:25" /><verse number="26" style="v" sid="DAN 5:26" />“ज्या सोब्‍दान मतलब ज्‍य हे, ‘मने’ मतलब बोगवान तारा राज्‍यान दिह गेणीन तान खेतेम केर दियेल हे। <verse eid="DAN 5:26" /><verse number="27" style="v" sid="DAN 5:27" />तकेल तान आर्थो तु ताकड़ा माय तोलाय गीयो, एने ओलवो निकेलनो। <verse eid="DAN 5:27" /><verse number="28" style="v" sid="DAN 5:28" />‘उपर्सीन’ मतलब तुवा फाय रेन तारो राज्य सांडाड़ाय जाणे बाजरेनोह, एने तान वाटो पोड़ने बाजरिनोह। ज्‍य राज्य मादि एने फारसीन माणहाह आपाय जाय।”<verse eid="DAN 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 5:29" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:29 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 41:42">उत्पत्ती 41:42</ref>
      </char>
    </note>ओवतो बेलशस्सर उकुम आप्यो, एने दानिएलाह जामण्या रेंगान फाड़का एने तान गेलाम होनान हाकेल पेरावाय गियी; एने ज्यी गोसणा केरानी काय राज्‍याम राज ने तीसरो जागो दानिएलास ने रेय। <verse eid="DAN 5:29" /><verse number="30" style="v" sid="DAN 5:30" />तीस राती कसदीन राजा बेलशस्सर माराय गीयो। <verse eid="DAN 5:30" /><verse number="31" style="v" sid="DAN 5:31" />मादि माय रेणार एक एदमी जान नाव दारा एतो, एने जान वोय बाहसाठ वोरह्या एता, तावालो नोवालो राजा बोणनो।<verse eid="DAN 5:31" /></para>
  <chapter eid="DAN 5" />
  <chapter number="6" style="c" sid="DAN 6" />
  <para style="s">दानिएल सिंहान खाडा माय</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 6:1" />दारा राजाह हाजो लागो, केदी एक होव विह ओहला आदिकारी ठेरावे, जा पुरा राज्या माय आदिकार मिले। <verse eid="DAN 6:1" /><verse number="2" style="v" sid="DAN 6:2" />एने ज्या एक होव विह आदिकारी पोर देखरेत केरनेन केरता, तो जा तीन जाणे निवाड़ेल, ताम रेन एक दानिएल इतो। कुण राजाह इसाब किताब आपी, एने राज्‍यान कायच नुकसान नाय एय केरीन दारा तीनुन निवोड़ किऱ्यो। <verse eid="DAN 6:2" /><verse number="3" style="v" sid="DAN 6:3" />दानिएल ज्‍य दिख्यो, काय तो दिहरा अध्‍यक्ष एने आदिकारीह रेन जुलूम हाजो हे। एने राजा दानिएलाह आखा राज्‍यान उपेर निवाड़ केरनेन विचार किऱ्यो। <verse eid="DAN 6:3" /><verse number="4" style="v" sid="DAN 6:4" />पुण जेवी दिहरा अध्‍यक्ष एने आदिकारी ज्यान बाराम होमल्या ते ता दानिएल ने विरूद दोस होदणे बाज गीया; पुण दानिएल विश्‍वासयोग्‍य इतो, एने तान कामाम काय बुल नाहते दोस नाह निकल्यो, एने ता ओहलो एगदो गुनो नाहते दोस नाह देख सेक्‍या। <verse eid="DAN 6:4" /><verse number="5" style="v" sid="DAN 6:5" />तेवी ता माणहे केणे बाज गीया, “आपु ता दानिएल ने बोगवानान नेमाह सोड़ीन, उंजु काल्‍लान बाराम तान विरूद काल्लो दोस सापड़ाव नाय सेकहु।”<verse eid="DAN 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="DAN 6:6" />तेवी ता अध्‍यक्ष एने आदिकारी राजा फाय आवा, एने ताह केया, “एय राजा दारा, तु जेलेम जेलेम जीवतालो रिहे। <verse eid="DAN 6:6" /><verse number="7" style="v" sid="DAN 6:7" />आपु आखा अध्‍यक्ष, आदिकारी, मोटला आदिकारी, नियाव केरनारे, एने राज्‍यान आदिकारी, न्यान एकी एय जायेल हे। राजा ओहलो उकुम आपी एने ओहलो केठीण उकुम निकाले काय तीस दिह वोर जो कुण, एय राजा, तुवाह सोड़ीन दिहरा देवतान नाहते माणहान विन्ता केरी, तो सिंहवागान पिंजराम टाकाय जाय। <verse eid="DAN 6:7" /><verse number="8" style="v" sid="DAN 6:8" />केरीन एवी एय राजा, जा कागदा पोर ज्‍य नेम लिखेल हे, तु ता पोर सेय केर दे। इहकेरीन ज्‍य नेम केदी बोदलाय नाय जाय सेकी। काहाकाय मादि एने फारसीन न्यान कायदो रद्द एय नाह सेकते, एने बोदेल बी नाह सेकते।”<verse eid="DAN 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 6:9" />तेवी दारा राजा ता उकुम पोत्रा पोर सेय केर दिनो। <verse eid="DAN 6:9" /><verse number="10" style="v" sid="DAN 6:10" />जेवी दानिएलाह मालुम एनो, काय ता पोत्रा पोर सेय केराय जायेल हे, तेवी तो तान गेराम गीयो; जान उपेरली खोलीन खिड़क्‍यु यरूशलेमान उगे उगाड़ल्‍यु रेताल्यु, एने तान रिती पारमाणे जीहे तो दिह्या माय तीन वार तान बोगवानान सामने मांड्या वोलीन विन्ता एने दन्यवाद केरतालो, तिहेच केरीन तेवी बी केरते रिनो।<verse eid="DAN 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 6:11" />ओवता ता माणहे टुलो बाणावीन दानिएल फाय जाय पोचना। ताहरी ता दानिएलाह तान बोगवानान सामने विन्ता एने विन्ती केरतालो सापड़ाया। <verse eid="DAN 6:11" /><verse number="12" style="v" sid="DAN 6:12" />ओवता ता माणहे राजा फाय गीया, एने ता राजा हेऱ्या ता कायदान बाराम वात केऱ्या, जो तो बाणायेल इतो। ता केया, “एय दारा राजा, तु एक कायदो बाणायेल हे, जा पारमाणे ओंगाणल्‍या तीस दिह वोर केदी एगदो माणुह, तुवाह सोड़ीन एगदा माणहान नाहते देवतान विन्ता केरी, ताहार तो सिंहान खाडाम टाकाय जाय। के, काय तु ज्या नेमा पोर सेय नाह किरेल इतो?”</para>
  <para style="p" vid="DAN 6:12">राजा जापाप आप्यो, “होव, मी ता नेमा पोर सेय किरेल इतो मादि एने फारसी न्यान नेम रद्द नाह एय सेकते एने ताम बोदेल नाह एय सिकेत।”<verse eid="DAN 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 6:13" />तेवी ता माणहे राजाह केया, “दानिएल नावान एक माणुह तारी वाती पोर द्यान नाह देणे बाजरिनोह। दानिएल यहुदान बोंदी माय रेन एक हे, जा नेमा पोर तु सेय किरेल हे, दानिएल ता पोर द्यान नाह देणे बाजरिनोह। दानिएल एवी बी दाड़ीन दिह्याम तीन वार तान बोगवानाह विन्ता किरेह।”<verse eid="DAN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 6:14" />ज्‍य होमलीन राजा जुलूम उदास ईनो, एने दानिएलाह वोचाड़णेन उपाय सोचणे बाज गीयो; एने दिह बुड़े वोर ताह वोचाड़णेन कोसीत किरते रिनो। <verse eid="DAN 6:14" /><verse number="15" style="v" sid="DAN 6:15" />ओवता ता माणहे एकठा टोलवाएन राजा फाय गीया एने राजाह केया, “एय राजा, ज्‍य सोमजी ले काय मादि एने फारसीन कायदान गेत जा कायदा पोर राजा सेय केर देय, ता बोदेल नाह सेकते।”<verse eid="DAN 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 6:16" />तेवी राजा उकुम आप्यो, ओवता ता माणहे दानिएलाह देर लावा, एने ताह सिंहवागान खाडाम टाक देना। तुलबुखे राजा दानिएलाह केयो, “माहु आसा हे काय तु जा बोगवानान बोक्ती किरेह, तोस तुवाह वोचाड़ी।” <verse eid="DAN 6:16" /><verse number="17" style="v" sid="DAN 6:17" />तेवी एक मोटलो हिलो लावीन सिंहान खाडान मुयाला पोर मेल देना, एने राजा ता पोर तान मुंदी एने तान आदिकारीन मुंदी केरीन मुंदीन साप लागाड़ दिनो। ज्यान मतलब ज्‍य एतो, काय कुण बी हिलो हेरकावीन दानिएलाह सिंहान खाडाम रेन काड़ नाह सेकतालो।<verse eid="DAN 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 6:18" />तान बाद दारा राजा तान मेहेल माय जात रिनो, एने ती रात तो रूटो नाह खादो। एने खुसी माणावणेन काय सादेन ता फाय नाह पोचाड़ाय गीयो, एने राजा आखी रात नाह हुवनो।<verse eid="DAN 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 6:19" />दिहरे दिह उठ्यान विगोच दारा राजा उठनो, एने सिंहान बुयारान निही जेल्दीच जात रिनो। <verse eid="DAN 6:19" /><verse number="20" style="v" sid="DAN 6:20" />राजा जुलूम चिन्‍ताम इतो, राजा जेवी सिंहान खाडान आहने गीयो, तेवी दुखी एन दानिएलाह जोरेस आयड़ीन केयो, “एय दानिएल, एय जीवताला बोगवानान सेवक, काय तारो बोगवान जान तु कायेम बोक्ती किरेह, तुवाह सिंहवागाह रेन वोचाड़ेल हे काय?”<verse eid="DAN 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="DAN 6:21" />तेवी दानिएल राजाह केयो, “एय राजा, तु जेलेम जेलेम जीवतालो रेय! <verse eid="DAN 6:21" /><verse number="22" style="v" sid="DAN 6:22" />मारो बोगवान माहु वोचाड़नेन केरता, तान हेरोगदुत मोकलीन सिंहवागान मुयाह ओहलो बोंद केर मिल्यो, काय ता मारी कायच नुकसान नाह केऱ्या; ज्यान कारेण ज्‍य हे, काय मी बोगवानान सामने निर्दोस ठेरानो; एने एय राजा, तार सामने बी मी काय बुरो नाह किरेल सोतो।”<verse eid="DAN 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 6:23" />तेवी राजा जुलूम खुस एन दानिएलाह, बुयारा माय रेन निकालनेन उकुम आप्यो। जेवी दानिएलाह सिंहान खाडाम रेन बाहेर निकाल्या, तेवी तान सेरीरा पोर एक बी जेखेम नाह एती। वाग दानिएलाह काय नुकसान नाह पोचाड़ेल एता, काहाकाय दानिएलाह तान बोगवाना पोर बुरहो इतो। <verse eid="DAN 6:23" /><verse number="24" style="v" sid="DAN 6:24" />तेवी राजा उकुम आप्यो काय जा एदमी दानिएल ने चाड़ी किरेल एता, ता तान सोरा पोऱ्या एने बायकुह लावीन सिंहान बुयारा माय टाकाय जाय; एने ता पिंजरान बुई पोर पोड़नेन पेलुच सिंहवाग ताह दिऱ्यो एने खाय गीयो।<verse eid="DAN 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 6:25" />तेवी दारा राजा आखी देरतीम रेणारे देस देस एने राज्या राज्‍यान आखा माणहे, एने बात बातीन बाषा बोलनारा फाय ज्‍य पोत्र मोकल्‍यो, “तुमरो जुलूम हाजो एय! <verse eid="DAN 6:25" /><verse number="26" style="v" sid="DAN 6:26" />मी ज्‍यो उकुम आपथु काय जाहरी जाहरी मार राज्‍यान आदिकार हे, तावाला माणहे दानिएल ने बोगवानाह बिणे जुवे, एने तान मान मेलने जुवे।</para>
  <para style="q1" vid="DAN 6:26">“दानिएल ने बोगवान जीवतालो,</para>
  <para style="q2" vid="DAN 6:26">एने जेलेम जेलेम वोर रेणार बोगवान तोस हे;</para>
  <para style="q1" vid="DAN 6:26">तान राज्य केदी निवरी नाय;</para>
  <para style="q2" vid="DAN 6:26">तान राज ने सेवोट केदी नाय एय।<verse eid="DAN 6:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="DAN 6:27" />जो दानिएलाह सिंहवागाह रेन वोचाड़ेल हे,</para>
  <para style="q2" vid="DAN 6:27">तोस वोचाड़णार एने सोड़ेवणार हे;</para>
  <para style="q2" vid="DAN 6:27">हेरगा माय एने देरती पोर निसाण्‍यु</para>
  <para style="q1" vid="DAN 6:27">एने चोमेत्‍काराह देखाड़णार हे।”<verse eid="DAN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 6:28" />इहकेरीन दानिएल, दारा राजान राज माय एने फारसीन राजा कुस्रून राज माय हाजे हुके रिनो।<verse eid="DAN 6:28" /></para>
  <chapter eid="DAN 6" />
  <chapter number="7" style="c" sid="DAN 7" />
  <para style="s">दानिएल ने द्‍वारा होपनान वर्णन</para>
  <para style="r">(<ref loc="DAN 7:1">7:1</ref>; <ref loc="DAN 12:13">12:13</ref>)</para>
  <para style="s">चार जेनवेरान बाराम दानिएल ने देरसेन</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 7:1" />बाबेलान राजा बेलशस्सरान राज्‍यान पेल्ला वोरह्याम, दानिएल तान आथरोणा पोर लोट लोट्‍यो एक होपनो दिख्यो एने ता माय देरसेन दिख्यो। तेवी तो होपनान आर्थो लेखीन मिल्यो एने केयो। <verse eid="DAN 7:1" /><verse number="2" style="v" sid="DAN 7:2" />दानिएल केयो, “मी राती ज्‍य होपनो दिख्यो काय देरीया पोर कावदेन वारो चालने बाज गीयो। <verse eid="DAN 7:2" /><verse number="3" style="v" sid="DAN 7:3" /><note caller="+" style="x"><char style="xo" closed="false">7:3 </char><char style="xt" closed="false"><ref loc="REV 13:1">प्रकाशितवाक्य 13:1</ref>; <ref loc="REV 17:8">17:8</ref></char></note>तेवी देरीयाम रेन चार मोट मोटला जेनवार बाहेर आवताला देखाना। जा एका दिहराह रेन आलेग एता। <verse eid="DAN 7:3" /><verse number="4" style="v" sid="DAN 7:4" /><note caller="+" style="x"><char style="xo" closed="false">7:4 </char><char style="xt" closed="false"><ref loc="REV 13:2">प्रकाशितवाक्य 13:2</ref></char></note> पेल्लो जेनवार सिंहवागान गेत देखातालो एने तान फाके मोराग्यान गेत एता। एने मार देखता देखता तान फाकान फिसे लोचीन टाकाय गीया एने तो बुई पोर रेन विसीन, माणहान गेत पायान बोरहे उबरी गीयो; ज्या सिंहवागाह माणहान गेत दिमाग आपायेल एतो।”<verse eid="DAN 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 7:5" />उंजु मी एक जेनवार दिख्यो जो रिसड़ान गेत एतो, एने पासाणल्या दुयू पायान बोरहे उब रियेल इतो, एने तान मुयाम दातान विचीम तीन पाहल्यु एत्यु; एने माणहे ताह केया, “उठ जोलोक जुवे तोलोक माह खा।”<verse eid="DAN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="DAN 7:6" />ज्यान पासाण मी दिख्यो काय खेड्यान गेत मार सामने एक उंजु जेनवार उब रिनोह। तान डिला पोर चिड़ान चार फाके एता; एने ता जेनवेरान चार मुंड एता; एने ताह राज केरनेन आदिकार आपेल एतो।<verse eid="DAN 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 7:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">7:7 </char>
      <char style="xt" closed="false">
        <ref loc="REV 12:3">प्रकाशितवाक्य 12:3</ref>; <ref loc="REV 13:1">13:1</ref></char>
    </note>तान बाद, होपना माय राती मी दिख्यो काय मार सामने एक उंजु चोवथो जेनवार उबरिनोह। तो जुलूम बियावे ओहलो देखातालो एने जुलूम ताकेतवोर इतो, एने तान लोड़ान लांबाला दात एता; ज्‍यो जेनवार तान सिकारीह केच्‍या वालीन खाय टाकतालो, एने जो उगरी जातालो, ताह पाया केरीन केच्‍या वालतालो। ज्‍यो चोवथो जेनवार मी दिखेल आखा जेनवेराह रेन आलेग इतो; तान दोह हिंग एता। <verse eid="DAN 7:7" /><verse number="8" style="v" sid="DAN 7:8" /><note caller="+" style="x"><char style="xo" closed="false">7:8 </char><char style="xt" closed="false"><ref loc="REV 13:5-6">प्रकाशितवाक्य 13:5-6</ref></char></note>मी ता हिंगान बाराम विचार केरतालोन, ता हिंगाम उंजु एक हिंग उग आवो। ज्‍य हिंग जुलूम आत्यो एतो, ता हिंगा पोर माणहान डोलान गेत डोला एने मुय एतो। एने तो सोतान बोड़ाय केरतालो, ज्‍यो आतल्‍यो हिंग दिहरा तीन हिंग उखाल टाक्‍यो।<verse eid="DAN 7:8" /></para>
  <para style="s">कायेम वोर रेणारान होपनो</para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 7:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">7:9 </char>
      <char style="xt" closed="false">
        <ref loc="REV 20:4">प्रकाशितवाक्य 20:4</ref>; <ref loc="REV 1:14">1:14</ref></char>
    </note>“मार देखता देखता, तान जागा पोर राजगादि मेलाय गीयु, एने तो कायेम ने राजा राजगादि पोर बुठो; तान फाड़का बोर्फान गेत दोवल्या, एने मुंडीन लेट्या कापाहान गेत दोवल्या एता; तान राजगादि आक्‍ठो एती एने तान चाकारा आक्‍ठान गेत एता। <verse eid="DAN 7:9" /><verse number="10" style="v" sid="DAN 7:10" /><note caller="+" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="REV 5:11">प्रकाशितवाक्य 5:11</ref>; <ref loc="REV 20:12">20:12</ref></char></note> ता वेगाला कालान माणहान ओंगाण एक आक्‍ठान नेदी वोयताली; एजारो माणहे तान सेवा केरताला, लाखो माणहे तान सामने उबरियेल एता; ओवता नियाव केरनारे बोह गीया, एने पुस्‍तेक्‍यु उगाड़ाय गीयु।<verse eid="DAN 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 7:11" />“ता हिंगान मोठाय ने वातु होमलीन मी देखते रिनो एने मार देखते देखते तो चोवथो जेनवार माराय गीयो, एने तान सेरीर देदमीताला आक्‍ठाम टाकीन खेतेम केराय गीयो। <verse eid="DAN 7:11" /><verse number="12" style="v" sid="DAN 7:12" />दिहरा जेनवेरान ताकेत एने आदिकार ता फाय रेन सांडाड़ाय गीयो, पुण तान जीव थोड़ीक टेमीन केरता ताह पारवांगी आपानी।”<verse eid="DAN 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 7:13" />
    <note caller="+" style="x">
      <char style="xo" closed="false">7:13 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:30">मत्ती 24:30</ref>; <ref loc="MAT 26:64">26:64</ref>; <ref loc="MRK 13:26">मरकुस 13:26</ref>; <ref loc="MRK 14:62">14:62</ref>; <ref loc="LUK 21:27">लुका 21:27</ref>; <ref loc="REV 1:7-13">प्रकाशितवाक्य 1:7-13</ref>; <ref loc="REV 14:14">14:14</ref></char>
    </note>मी राती देरसेन माय ज्य दिख्यो काय मार सामने एखेह उबरिनोह, जो माणहान बेटाख ने गेत देखातालो। तो जुगाम वादला पोर आवणे बाजरियेल इतो, एने तो जुलूम वेगाला फाय आवो; एने ताह राजान सामने लावा। <verse eid="DAN 7:13" /><verse number="14" style="v" sid="DAN 7:14" /><note caller="+" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="REV 11:15">प्रकाशितवाक्य 11:15</ref></char></note> तेवी ताह ओहलो आदिकार, बोड़ाय एने आखो राज केरनेन आदिकार होपानो; आखा माणहे, एने राज्या राज्‍यान माणहे एने बात बातीन बाषा बोलनारे आखा तान सेवा केरनारे एता; तान राज्य कायेम ने एतो, तान राज्य कायेम बोणीन रेय, तो केदी खेतेम नाय एय।<verse eid="DAN 7:14" /></para>
  <para style="s">देरसेनान आर्थो</para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 7:15" />मी, दानिएल, जुलूम दुखी एने चिन्‍ताम इतो। ता देरसेन जा मी दिखेल इतो, तान वोजेसे मी गाबराय गीयो। <verse eid="DAN 7:15" /><verse number="16" style="v" sid="DAN 7:16" />तेवी जा मार आहने उबरियेल एता ता माय रेन एका फाय जाएन मी ताह ज्या आखान मतलब फुशो, “देरसेनान मतलब काय हे?” ओवतो तो माहु केयो, <verse eid="DAN 7:16" /><verse number="17" style="v" sid="DAN 7:17" />“ता चार मोटला जेनवारे, चार राजा हेते, ता चारू राजा देरती पोर रेन निकेलती। <verse eid="DAN 7:17" /><verse number="18" style="v" sid="DAN 7:18" /><note caller="+" style="x"><char style="xo" closed="false">7:18 </char><char style="xt" closed="false"><ref loc="REV 22:5">प्रकाशितवाक्य 22:5</ref></char></note>पुण बोगवानान चोखाला माणहे ता राज्‍याह सापड़ावती, एने कायेम तान आदिकारी बोणीन रेती।”<verse eid="DAN 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 7:19" />तेवी मारा मोनाम ज्यी आसा एनी काय ता चोवथा जेनवेरान मतलब बी जाण लेव, जो दिहरा तीनुह रेन आलेग एने जुलूम बियावे ओहलो इतो, एने तान दात लोड़ान एने नेखे पितलान एता; ज्‍यो तो जेनवार इतो, जो तान सिकारीह केच्‍या वालीन हासकेरीन खाय जायेल इतो, एने तान सिकारीह खाणेन बाद जो काय वोचेल एतो, ताह तो तान पाया बुंदे रोहदेल दियेल इतो। <verse eid="DAN 7:19" /><verse number="20" style="v" sid="DAN 7:20" />पोशो तान मुंडाम दोह हिंगान लिकाईल वातु, एने जा नोवाला हिंगान निकेलने माय तीन हिंग ओदरी गीया, मतलब जा हिंगान डोला एने मोटला बोल बोलनार मुय एने दिहरा हिंगाह रेन वोदार बिवाड़े ओहलो एतो, तान बी लिकाईल वातु जाणनेन मारी आसा एनी।<verse eid="DAN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="DAN 7:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">7:21 </char>
      <char style="xt" closed="false">
        <ref loc="REV 13:7">प्रकाशितवाक्य 13:7</ref>
      </char>
    </note>ओवतो मी दिख्यो काय, तो हिंग चोखाला माणहा हिऱ्यो लेड़ाने बाजरियेल इतो, एने ताह, ताह वोर आरेवते रिनो। <verse eid="DAN 7:21" /><verse number="22" style="v" sid="DAN 7:22" />जाह वोर जुलूम वेगालो माणुह नाह आवो, एने आखाम रेन मोटला बोगवानान चोखाला माणहे नियाव केरनारे नाह ठेराना, एने ता चोखाला माणहान राज्‍यान आदिकारी बोणनेन टेम आव नाह पोचनो।<verse eid="DAN 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 7:23" />तो केयो, “ता चोवथा जेनवेरान मतलब, देरती पोर आवणार चोवथो राज्य हे, तो दिहरा राज्‍याह रेन आलेग रेय, तो आखा देरती पोर वाला माणहान नास केरी, तो दुनियान आखा देसाह तान पायान बुंदे रोहंदेली एने तान टुकड़ा टुकड़ा केर देय। <verse eid="DAN 7:23" /><verse number="24" style="v" sid="DAN 7:24" /><note caller="+" style="x"><char style="xo" closed="false">7:24 </char><char style="xt" closed="false"><ref loc="REV 17:12">प्रकाशितवाक्य 17:12</ref></char></note>एने ता दोह हिंगान मतलब ज्‍य हे, काय ता चोवथा राज्‍यान दोह राजा हेते। न्या दोह राजा बाद उंजु एक राजा आवी, तान पेल राज केरनारे राजाह रेन आलेग रेय। तो तीन राजाह आरीव देय। <verse eid="DAN 7:24" /><verse number="25" style="v" sid="DAN 7:25" /><note caller="+" style="x"><char style="xo" closed="false">7:25 </char><char style="xt" closed="false"><ref loc="REV 12:14">प्रकाशितवाक्य 12:14</ref>; <ref loc="REV 13:5-6">13:5-6</ref></char></note>ज्‍यो राजा आखाम रेन मोटला बोगवानान विरूद वातु केरी, एने बोगवानान चोखाला माणहाह दुख पोचाड़ी एने ताह मारी, पेल्ला कायदा एने तिवाराह बोदेलनेन कोसीत केरी। बोगवानान चोखाला माणहे साड़े तीन वोरह्या वोर ता राजान ताकेतीन ताबाम रेती। <verse eid="DAN 7:25" /><verse number="26" style="v" sid="DAN 7:26" />पुण जो काय एण्‍य हे, तान निर्णय कोरटो केरी, एने ता राजा फाय रेन तान ताकेत सांडाड़ाय जाय; एने तो नास केराय जाय। <verse eid="DAN 7:26" /><verse number="27" style="v" sid="DAN 7:27" /><note caller="+" style="x"><char style="xo" closed="false">7:27 </char><char style="xt" closed="false"><ref loc="REV 20:4">प्रकाशितवाक्य 20:4</ref>; <ref loc="REV 22:5">22:5</ref></char></note> राज एने राज, आखा जुगान नेचा देरतीन आखा राज्‍यान बोड़ाय, आखाम रेन मोटला बोगवानान चोखाला माणहास आपाय जाय। तान राज कायेमान राज रेय; देरतीन आखा राज केरनारे तान सेवा केरती, ता तान उकुमान पालेन केरती।”<verse eid="DAN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 7:28" />“इहकेरीन तो होपनो निवरनो, मी दानिएल जुलूम बिय जायेल इतो, एने बियीन वोजेसे मारो मुय उतरी गीयो, मी ज्‍यु वातु दिखेल इतो एने होमलेल इतो, मी त्युन बाराम दिहरा माणहाह नाह केयो।”<verse eid="DAN 7:28" /></para>
  <chapter eid="DAN 7" />
  <chapter number="8" style="c" sid="DAN 8" />
  <para style="s">मेंड्रो एने बोकड़ान बाराम दानिएल ने देरसेन</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 8:1" />बेलशस्सर राजान राज्‍यान तीसरे वोरीह, ता पेल्ला देरसेनान बाद एक उंजु वात माहु दानिएलाह देरसेनान द्‍वारा देखाड़ाय गियी। <verse eid="DAN 8:1" /><verse number="2" style="v" sid="DAN 8:2" />मी दिख्यो काय मी शूशन नावान किल्‍ला माय रेतालो। शुशन ज्यी एलाम ईलाकान राजदानी एती। मी उले नेदीन मेराम उबरियेल इतो। <verse eid="DAN 8:2" /><verse number="3" style="v" sid="DAN 8:3" />मी उपेर दिख्यो ते माहु एक मेंड्रो ती नेदीन मीरे उबरियेल देखानो, ता मेंड्रान दुय मोटला हिंगे एता; पुण एक हिंगाह रेन एक हिंग जुलूम लांबो एतो। लांबालो हिंग आतल्या हिंगान बाद उगेल एतो। <verse eid="DAN 8:3" /><verse number="4" style="v" sid="DAN 8:4" />मी ता मेंड्राह दिख्यो काय तो पश्‍चिम, उत्तर एने देक्षिणान उगे हिंगा केरीन ठोकेह, ता मेंड्राह काल्लो बी जेनवार ताह रोक नाह सेकतालो; एने नाह ता फाय रेन एगदो दिहरा जेनवेराह वोचाड़ सिकेह; मेंड्रो तान मोना पारमाणे काम केरतालो, तो जुलूम ताकेतवोर एय जायेल इतो।<verse eid="DAN 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 8:5" />मी मेंड्रान बाराम सोचतालोच काय पश्‍चिम ने उगे रेन एक बोकड़ाह आवतालो दिख्यो, तो आखी देरती पोर दोवेड़तालो। पुण ता बोकड़ान पाय देरती पोर टेकना बी नाह, ज्या बोकड़ान एक लांबालो हिंग एतो। जो साप साप देखातालो, तो हिंग बोकड़ान दुयू डोलान विचीम एतो। <verse eid="DAN 8:5" /><verse number="6" style="v" sid="DAN 8:6" />तो ता दुय हिंगावाला मेंड्रान आहने आवो, ज्‍यो तोस मेंड्रो एतो, जाह मी ऊले नेदीन मीरे उबरियेल दिखेल इतो; तो बुकोड़ रागाम बोराय रियेल इतो, तो मेंड्रा हिऱ्यो लेड़ानो। <verse eid="DAN 8:6" /><verse number="7" style="v" sid="DAN 8:7" />बोकड़ाह ता मेंड्रान उगे दोवेड़तालोन मी दिख्यो, तो बुकोड़ जुलूम रागाम इतो, तो मेंड्रान दुयू हिंग मुड़ टाक्‍यो; मेंड्रो बोकड़ाह रोक नाह सेक्‍यो; तेवी बुकोड़ मेंड्राह बुई पोर पाड़ दिनो, एने ओवतो तो बुकोड़ ता मेंड्राह पाया बुंदे केच्‍यावाल दिनो। ताहरी ता मेंड्राह बोकड़ाह रेन वोचाड़णार कुण नाह एतो।<verse eid="DAN 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 8:8" />तेवी बुकोड़ जुलूम ताकेतवोर एय गीयो, पुण तो ताकेतवोर एताच तान लांबालो हिंग टुट गीयो, एने तान जागे चार हिंग उंजु उग आवा। ता चारू हिंग साप साप देखाताला, ता चार हिंग आलेग आलेग जुगान चार दिशान उगे वोड़ने बाज गीया। <verse eid="DAN 8:8" /><verse number="9" style="v" sid="DAN 8:9" />ओवता ता चार हिंगाम रेन एक हिंगाम एक आत्‍योस हिंग उंजु उग आवो, तो आत्‍योस हिंग वोदणे बाज गीयो एने वोदते वोदतेन जुलूम मोठो एय गीयो। ज्‍य हिंग देक्षिण पुर्वान उगे सुंदर देरतीन उगे वोदनो। <verse eid="DAN 8:9" /><verse number="10" style="v" sid="DAN 8:10" /><note caller="+" style="x"><char style="xo" closed="false">8:10 </char><char style="xt" closed="false"><ref loc="REV 12:4">प्रकाशितवाक्य 12:4</ref></char></note>ओवतो ता चार हिंगाम रेन एक हिंगा माय एक आतल्‍यो हिंग उंजु उग आवो। तो आतल्‍यो हिंग वोदणे बाज गीयो एने वोदते वोदते जुलूम मोठो एय गीयो, ज्‍य हिंग देक्षिण पुर्व उगे वोदनो बाज गीयो, एने ज्‍य हिंग सुंदर देरतीन उगे ओंगाण जाणे बाज गीयो। <verse eid="DAN 8:10" /><verse number="11" style="v" sid="DAN 8:11" />तो आतल्‍यो हिंग जुलूम मोजबुत एय गीयो, ओवतो तो तारान आदिकारीह बोगवानान विरूद एय गीयो; तो आतल्‍यो हिंग ता आदिकारी बोगवानाह दाड़ीन बेट एण्यु बोल्युह बोंद केर दिनो; एने जाहरी माणहे बोगवानान बोक्ती केरताला एने तान चोखाला जागाह उजाड़ दिनो। <verse eid="DAN 8:11" /><verse number="12" style="v" sid="DAN 8:12" />एने माणहान पापान वोजेसे दाड़ीन बोली केरनेन काम बोंद एनो, तान सेनाह बी आरीव दिनो, एने तो आतल्‍यो हिंग खेरायीह माटड्याम मिलाव दिनो; तो आतल्‍यो हिंग जो काय किऱ्यो ता आखाम जिक गीयो।<verse eid="DAN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 8:13" />ओवतो मी एक चोखाला माणहाह बोलतालो होमल्यो; ताह दिहरो हेरोगदुत जापाप आप्यो, “ज्‍य देरसेन देखाड़ेह काय दाड़ीन दिह ने बोलीन काय एय? ज्‍य ता मोटला पापान बाराम हे जो खेतेम केर दिथे। मतलब चोखाला जागान एने सेनान दुयून नास एणो केवीह वोर ईती रेय?”<verse eid="DAN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 8:14" />दिहरो माणुह माहु केयो, “जाह वोर वेगोस एने हांज दुय एजार तीन होव वार नाय एय, ताह वोर तो ईती रेय; तेवी चोखालो जागो चोखो केराय जाय।”<verse eid="DAN 8:14" /></para>
  <para style="s">गब्रिएल हेरोगदुतान द्‍वारा होपनान मतलब केणो</para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 8:15" />ज्यी वात देरसेन माय देखीन, मी दानिएल, तान मतलब सोमेजणेन कोसीत किऱ्यो; मी ज्या देरसेनान बाराम विचार केरतालोच ने एक माणहान गेत देखाणार उचकाहुच आवीन मार सामने उबरी गीयो। <verse eid="DAN 8:15" /><verse number="16" style="v" sid="DAN 8:16" /><note caller="+" style="x"><char style="xo" closed="false">8:16 </char><char style="xt" closed="false"><ref loc="LUK 1:19">लुका 1:19</ref>,<ref loc="LUK 1:26">26</ref></char></note>ओवतो माहु उले नेदीन विचीम रेन एक माणहान बोल होमलानो, जो आयड़ीन केयो, “एय गब्रिएल, ज्या माणहाह ज्यान देरसेनान मतलब सोमजाड़ दे।” <verse eid="DAN 8:16" /><verse number="17" style="v" sid="DAN 8:17" />तेवी माणहान गेत देखाणार गब्रिएल हेरोगदुत जाहरी मी उबरियेल इतो, ताहरी मार आहने आवो; जेवी तो मार आहने आवो ते मी जुलूम बिय गीयो; मी बुई पोर जाय पोड़नो। तेवी गब्रिएल हेरोगदुत माहु केयो, “एय माणुह, सोमजी ले काय ज्‍य देरसेन सेवेटल्‍या टेमान बाराम हे।” <verse eid="DAN 8:17" /><verse number="18" style="v" sid="DAN 8:18" />जेवी गब्रिएल हेरोगदुत मार हिऱ्यो वातु केरतालो, तेवी मी बुई निही मुय केरीन निंदीम गाराय गीयो; पुण तो माहु सापलीन हुतरो उबो केर दिनो। <verse eid="DAN 8:18" /><verse number="19" style="v" sid="DAN 8:19" />गब्रिएल केयो, “देख, मी तुवाह एवी, ता देरसेनाह सोमजाड़थो; काहाकाय बोगवानान रागान टेमाम तो आखो पुरो एय जाय।<verse eid="DAN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 8:20" />“तु दुय हिंगावालो मेंड्रो दिखेल हे, तान मतलब मादि एने फारस ने दुय राज्या हेते। <verse eid="DAN 8:20" /><verse number="21" style="v" sid="DAN 8:21" />तो लांबाला रोसकावालो बुकोड़ युनान ने राजा हे, एने तान डोलान विचीम जो लांबालो हिंग, तो पेल्लो राजा हे। <verse eid="DAN 8:21" /><verse number="22" style="v" sid="DAN 8:22" />एने तो हिंग जो मुड़ जायेल, एने तान जागे जा चार हिंग उगेल; ता चार हिंग चार राज्य हेते, ता पेल्ला राजान राज्‍याम रेन चार राज्य बोणती; पुण पेल्ला राजान ओलाक ता ताकेतवोर नाय रेती।<verse eid="DAN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 8:23" />“ज्या चार राज्‍यान सेवेटल्‍या दिह्याम, जेवी तान पाप जुलूम एय जाती, तेवी एक राजा आवी, तो जुलूम एकएट्‍यो एने खाराब सोबाव एने लाबाड़ राजा रेय। <verse eid="DAN 8:23" /><verse number="24" style="v" sid="DAN 8:24" />ज्‍यो राजा जुलूम ताकेतवोर रेय, पुण ता पेल्ला राजान गेत नाह; एने तो माणहाह खेतेम केरी, तो जो काय केरी ता माय ताह जिक जुड़ी; तो ताकेतवोर माणहाह एने बोगवानान चोखाला माणहाह बी खेतेम केरी। <verse eid="DAN 8:24" /><verse number="25" style="v" sid="DAN 8:25" />ज्‍यो राजा जुलूम चालाक एने लाबाड़ रेय, तो गोमेंड माय बोरायीन जुलूम माणहाह खेतेम केरी जा सान्ती से रेतेह। तो बोगवानान विरूद बी लेड़ाणेन कोसीत केरी; पुण ता लाबाड़ राजान ताकेत खेतेम एय, पुण तान खेतेम एगदा माणहान आथे नाय एय। <verse eid="DAN 8:25" /><verse number="26" style="v" sid="DAN 8:26" />वेगोच एने हांज पोर ने बाराम जो तु दिखेल एने होमलेल हे तो खेरी हे, पुण जो काय तु देरसेन माय दिखेल हे ताह लीकाड़ मेल; काहाकाय तो जुलूम दिह्या बाद पुरो एय।”<verse eid="DAN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="DAN 8:27" />ता देरसेनान बाद मी दानिएल, जुलूम कोमजोर एय गीयो, एने जुलूम दिह वोर दुखाऱ्यो पोड़ रिनो; ओवतो मी बेमारीम रेन हुदरीन राजान काम पुशो केरने बाज गीयो; पुण जो काय मी दिखेल इतो, तो देखीन मी बोंगलाय रिनो; काहाकाय मी ता देरसेनान मतलब सोमजेल नाह इतो।<verse eid="DAN 8:27" /></para>
  <chapter eid="DAN 8" />
  <chapter number="9" style="c" sid="DAN 9" />
  <para style="s">दानिएल ने तान माणहान केरता विन्ता केरनो</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 9:1" />दारा राजान राज ने पेल्ले वोरीह ज्‍यु वातु एन्यु, दारा क्षयर्ष नावान माणहान बिटोख इतो; दारा मादि वोच माय रेन इतो, तो बाबेलान राजा बोणनो। <verse eid="DAN 9:1" /><verse number="2" style="v" sid="DAN 9:2" /><note caller="+" style="x"><char style="xo" closed="false">9:2 </char><char style="xt" closed="false"><ref loc="JER 25:11">यिर्मया 25:11</ref>; <ref loc="JER 29:10">29:10</ref></char></note>दारा राजान पेल्ले वोरीह, मी दानिएल थोड़ाक पुस्तेक सोमेज लियेल काय इतो, ती चोखाली पुस्तेक माय इहकेरीन लेख मिलेल एतो, काय बोगवान यिर्मया जाणकाराह केयो, “सत्‍तर वोरह्या बाद यरूशलेम पुशो वोही। <verse eid="DAN 9:2" /><verse number="3" style="v" sid="DAN 9:3" />तेवी मी मारो मुय बोगवानान उगे केरीन विन्ता केरते लेन मोदेक मांग्‍यो, एने उपास केरीन गोंटा पांगरीन, रोखड़ा माय बोहीन विन्‍ती केरने बाज गीयो।” <verse eid="DAN 9:3" /><verse number="4" style="v" sid="DAN 9:4" />मी मारो बोगवान यहोवाह इहकेरीन विन्ता किऱ्यो एने पापान कबुल किऱ्यो,</para>
  <para style="p" vid="DAN 9:4">“एय मालीक, तु मुठो एने बिणेन लायेक बोगवान हे, जो तार पोर मोंग केरनारा माणहा पोर एने उकुम मान्नारा हिऱ्यो तारी वाचाह पुरो किरेह एने किव किरते रिथे।”<verse eid="DAN 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 9:5" />“पुण एय बोगवान, आमु पापी हेते, आमु खाराब काम किरेल हेते; आमु तारो विरोद किरेल हेते, एने तारा उकुम एने नेमाह तोड़ दियेल हेते। <verse eid="DAN 9:5" /><verse number="6" style="v" sid="DAN 9:6" />एने तारा सेवक जा जाणाव केरनारे एता, आमरा राजा, आदिकारी, डायडाया एने आखा सादा माणहाम रेन तार नाव से वातु केरताला; तान आमु नाह होमल्या। <verse eid="DAN 9:6" /><verse number="7" style="v" sid="DAN 9:7" />एय मालीक, तु देरमी हे, पुण आज आमु लाजवायेल हेते; यरूशलेम एने यहुदान माणहे लाजवायेल हेते, इस्राएल ने आखा माणहे लाजवायेल हेते, ता माणहे जा आहने हेते एने जा माणहे जा जुलूम सेटा हेते; एय बोगवान! तु ता माणहाह जुलूम देसाम वेरा सेर केर दियेल हे, ता आखा देसाम वोहेल इस्राएल माणहाह लाज आवणे जुवे; एय बोगवान, त्यु आख्‍यु खाराब वातुन केरता, जा तार बुरहो तुड़ेल हेते, ताह लाज आवणे जुवे। <verse eid="DAN 9:7" /><verse number="8" style="v" sid="DAN 9:8" />एय बोगवान, आमरा राजा, आदिकारी एने डायडाया तार विरूद पाप किरेल हेते, केरीन आमुह लाज आवेह। <verse eid="DAN 9:8" /><verse number="9" style="v" sid="DAN 9:9" />पुण एय बोगवान यहोवा, तु किववालो हे, माणहे खाराब काम केऱ्या तीबी तु ताह, माफ केर दिथे; आमु खेरीच तार विरूद चालना। <verse eid="DAN 9:9" /><verse number="10" style="v" sid="DAN 9:10" />आमु ते आमरा बोगवान यहोवान हिकवोण होमलीन बी ती पोर नाह चालना, बोगवान तान सेवकान एने जाणाव केरनारान द्‍वारा आमुह नेम केयो पुण आमु ता नेमान पालेन नाह केऱ्या। <verse eid="DAN 9:10" /><verse number="11" style="v" sid="DAN 9:11" />इस्राएल ने काल्लो बी माणुह तारी हिकवोणी पोर नाह चाल्‍या, ता आखा बोटकी जायेल एता; ता तारा उकुमान पालेन नाह केऱ्या, केरीन जा हारापान चेरचा बोगवानान सेवक मुसान नेमाम लिखेल हे, तो हाराप आमु पोर ईनो, काहाकाय आमु बोगवानान विरूद पाप किरेल हेते। <verse eid="DAN 9:11" /><verse number="12" style="v" sid="DAN 9:12" />बोगवान कियेल इतो काय आमरी हिऱ्यो एने आमरा न्यायनिवाड़ो केरनारान बाराम जो वचन कियेल इतो, ताह आमु पोर ज्यी मोटली पिड़ा टाकीन पुरो किरेल हे; न्या वोर काय जोहली पिड़ा यरूशलेम पोर आयेल एती, तोहली आखी देरती पोर उंजु काहरी नाह आवी। <verse eid="DAN 9:12" /><verse number="13" style="v" sid="DAN 9:13" />जीहे मुसान नेमाम लिखेल हे, तिहेच केरीन ज्यी आखी पिड़ा आमरी पोर आव पुड़ेल, पुण उंजु बी आमु बोगवाना फाय साहारो नाह मांगेल सोता! आमु एवी वोर पाप केरने नाह सोड़ेल सोता, एय बोगवान उंजु बी आमु तार खेरायीन उगे द्यान नाह दियेल सोता। <verse eid="DAN 9:13" /><verse number="14" style="v" sid="DAN 9:14" />केरीन बोगवान सोच विचार केरीन आमरी पोर पिढ़ा टाकेल हे; काहाकाय आमरो बोगवान इहकेरीन ज्यानकेरता किरेल इतो काय तो ते जो काय बी किरेह खेरलो हे, एने नियावुस किरेह, पुण उंजु बी आपु बोगवानान नाह होमेलते।”<verse eid="DAN 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 9:15" />“एय आमरा बोगवान, एय मालीक, तु तारी ताकेतीन वापेर केरीन आमुह मिस्र देसाम रेन बाहेर निकालीन तारो ओहलो मोठो नाव किऱ्यो, जो आज वोर हे, आमु ते तारा माणहे हेते; पुण आमु पाप किरेल हेते एने खाराब काम किरेल हेते। <verse eid="DAN 9:15" /><verse number="16" style="v" sid="DAN 9:16" />एय बोगवान, यरूशलेम पोर राग केरने सोड़ दे, यरूशलेम हियोर ज्‍यो तारो चोखालो बुयड़ो हे, एने आमरे आहने पाहने वाला माणहे आमरो आपमान केरतेह एने तारा माणहान चिहटा केरतेह; ज्यान कारेण आमु एने आमरा डायडाया तार विरूद पाप किरेल एता, केरीन ज्‍य एणे बाजरिनोह। <verse eid="DAN 9:16" /><verse number="17" style="v" sid="DAN 9:17" />एवी, एय बोगवान, तु मारी विन्ता होमली ले, मी तारो सेवक हे, मोदेक ने केरता मारी विन्ती होमेल, तारा चोखाला जागान केरता तु हाज्यु वातु केर, तारो चोखालो जागो उजाड़ पोड़ रियेल इतो; पुण मालीक, तार हाजान केरता ज्‍यु हाज्यु वातु केर। <verse eid="DAN 9:17" /><verse number="18" style="v" sid="DAN 9:18" />एय मारा बोगवान, मार विन्ता होमेल! डोला उगाड़ीन आमरी पोर आयेल सेंकेट एने ता हेयराह बी देख जो तारो केवाथे; काय देशा एय जायेल हे, आमु हाजा हेते, इहकेरीन मी केत नाह, तु किववालो हे ज्‍य माहु मालुम हे केरीन तार फाय ज्‍य मांगणे बाजरिनोह। <verse eid="DAN 9:18" /><verse number="19" style="v" sid="DAN 9:19" />एय बोगवान, मार होमेल आमुह माफ केर! एय बोगवान, आमु पोर द्यान दे, एने आमरी केरता काय तीबी केर, एवी वाट मा जुवे! एवीच काय तीबी केर; तार हाजान केरता काय तीबी केर! एय बोगवान, एवी ते तार हियोर एने तार माणहान केरता काय तीबी एवीच केर।”<verse eid="DAN 9:19" /></para>
  <para style="s">गब्रिएलान जाणावाह सोमजाड़नो</para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 9:20" />मी बोगवाना फाय ज्यी विन्ता केरतालो, मी मारा एने इस्राएल ने माणहान पापाह स्वीकार केतालो, आपणा बोगवानान आहने चोखाली मोंदिरीन केरता विन्ता केरतालो। <verse eid="DAN 9:20" /><verse number="21" style="v" sid="DAN 9:21" />जेवी मी विन्ता केरतालोच ने, गब्रिएल हेरोगदुत मार फाय आवो, गब्रिएल तोस हेरोगदुत इतो जाह मी देरसेन माय दिखेल इतो, गब्रिएल उतवाल्‍युह उड़तेन हांज पोर ने बोलीन टेमान बुखेत आवो मार फाय आवो; एने माहु सोमजाड़ीन मार हिऱ्यो वातु केरने बाज गीयो। <verse eid="DAN 9:21" /><verse number="22" style="v" sid="DAN 9:22" />तो माहु केयो, “एय दानिएल, मी तुवाह बुद्दी आपणेन एने सोमजाड़ीन केणेन केरता आयेल हे। <verse eid="DAN 9:22" /><verse number="23" style="v" sid="DAN 9:23" />जेवी तु पेल विन्ता केरने सुरवात किरेल इतो, माहु तेवी उकुम जुड़ेल इतो, केरीन मी तुवाह केणे आवोह, बोगवान तुवाह जुलूम मोंग किरेह! केरीन ज्‍यो उकुम तार सोमेज माय आव जाय, एने तु ता देरसेनान मतलब जाण जाहे।”<verse eid="DAN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 9:24" />“तारा माणहान एने तारा चोखाला हेयरान केरता सेत्तेर एप्‍तान ज्‍यो उकुम ज्यानकेरता आपायेल हे काय खाराब वातु एने पाप केरनेन सोड़ दिवो, आखा माणहाह चोखा किरो, कायेम रेणार देरमीपोणा लावे, देरसेनान वाती पोर एने जाणकारा पोर साप लागाड़ाय जाय, एने चोखाला जागाह अबिषेक केराय जाय। <verse eid="DAN 9:24" /><verse number="25" style="v" sid="DAN 9:25" />दानिएल, तु ज्‍यु वातुह हिकीन सोमजी ले, पोशो जा एने यरूशलेम वोहाड़ो, ज्‍यो उकुम जुड़ेल तुलबूखेन निवड़ेल राजा आवी, ताह वोर ने टेम सात एप्‍तान रेय। ओवतो यरूशलेम पोशो वोहाड़ाय जाय, यरूशलेम माय पोशो माणहाह एकठा टोलवाणेन केरता जागा पोशा बाणावाय जाती; हेयरान देखरेत केरनेन केरता हेयरान कावदेन खोय बी रेय, ओवता बाहसाठ एप्‍ता वोर यरूशलेमाह वोहाड़ती, पुण तुलबुखे जुलूम पिड़ा आवती। <verse eid="DAN 9:25" /><verse number="26" style="v" sid="DAN 9:26" />बाहसाठ एप्‍तान बाद निवाड़ेल माणुह माराय जाय, एने तान काय नाय वोची, ओवता बोणनारा नेतान माणहे हियोर एने चोखाला जागाह खेतेम ते केरती, पुण ता मुखीन नास ओहलो एय जीहे बाड़ आवेह; तीबी आखरी वोर लेड़ाय ईती रेय; काहाकाय ता जागाह आखो नास केरनेन उकुम बोगवान आपेल हे। <verse eid="DAN 9:26" /><verse number="27" style="v" sid="DAN 9:27" />एने तो मुखी एक एप्‍तान केरता जुलूम जाणा हिऱ्यो मोजबुत वाचा बांदी, ती वाचा एक एप्‍तो वोर चाली; बेट एने बोल्यु आदो एप्‍तो वोर रोकाय रेय एने ओवतो एक खेतेम केरनार आवी खाराब काम केरी पुण, बोगवानुस ताह आखो खेतेमान उकुम आपेल हे।”<verse eid="DAN 9:27" /></para>
  <chapter eid="DAN 9" />
  <chapter number="10" style="c" sid="DAN 10" />
  <para style="s">दानिएलाह नेदीन दिड़े देखाएल देरसेन</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 10:1" />फारस देसान कुस्रु राजान राज्‍यान तीसरे वोरीह दानिएल पोर, जो बेलतशस्सर बी केवाथे, ओंगाणली वातुन बाराम मालुम पोड़नो। एने ती वात खेरी एती एने मोट मोटली लेड़ायीन बाराम एती। दानिएल त्यु वातुह सोमजी गीयो। त्यु वातु दानिएलाह देरसेन माय सोमजाड़ीन कियेल एत्यु।<verse eid="DAN 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="DAN 10:2" />दानिएल किथे, “ती टेम, मी दानिएल, तीन एप्‍ता वोर जुलूम दुखी रिनो। <verse eid="DAN 10:2" /><verse number="3" style="v" sid="DAN 10:3" />ता तीन एप्‍ता पुरा एता वोर, मी पुटे तोहलो खाणो नाह खादो एने माह केदिस नाह खादो, एने अंगुरान रूह नाह पिदो, एने सेरीर पोर तेल नाह लागाड्यो।”<verse eid="DAN 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 10:4" />वोरह्यान पेल्ला मोयनान चोवविसवे दिहे मी हिद्देकेल नावान मोटली नेदीन दिड़े उब रियेल इतो। <verse eid="DAN 10:4" /><verse number="5" style="v" sid="DAN 10:5" />ताहरी उब उबोस जेवी मी उपेर दिख्यो, ते ताहरी मी एक एदम्याह होणीन फाड़का पेर रियेल, एने ऊफाज देसान कुन्दन केरीन तान कोमराम चोखाला होनान पुट्टो बांद रियेल इतो। <verse eid="DAN 10:5" /><verse number="6" style="v" sid="DAN 10:6" />तान सेरीर फिरोजा पिपेलन्या देगड़ान गेत एता, तान मुय हेलेगताला दिवान गेत एतो, तान आथ पाय चोमकाड़ेल पितलान गेत एता, एने तान बोल माणहान बिड़ीन गेत इतो।<verse eid="DAN 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 10:7" />ज्‍य देरसेन देखणार, मी दानिएल एखालोच इतो, जा माणहे मार हेऱ्या हेते, ता माणहे ता देरसेनाह नाह देख सेक्‍या; पुण तीबी ता ओला बिय गीया काय सेटा दोवड़ीन जाएन लिकाय गीया। <verse eid="DAN 10:7" /><verse number="8" style="v" sid="DAN 10:8" />ओवतो मी एखालोच रेय गीयो, तेवी मी एक देरसेन दिख्यो, पुण देरसेन देखणेन बाद मार माय ताकेत नाह रेनी; मारो मुरेल ने गेत मुय बिय ने कारेण हुक गीयो, एने मी कोमजोर एय गीयो। <verse eid="DAN 10:8" /><verse number="9" style="v" sid="DAN 10:9" />ओवतो मी देरसेन माय ता माणहाह वातु केरतालो होमल्यो, मी तान बोलाह होमेलताच बुई पोर जाय पोड़नो एने निंदीम गारायीन बुई पोर पोड़ रिनो। <verse eid="DAN 10:9" /><verse number="10" style="v" sid="DAN 10:10" />एगदान एक आथ माहु आथल्‍यो, एने माहु उठाड़ीन मांडान एने तेलसान साहारे थेर थेर केरावतेन बोहाड़ दिनो।<verse eid="DAN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 10:11" />तेवी हेरोगदुत माहु केयो, “एय दानिएल, तु बोगवानान जुलूम मोंगाल्लो हे, जो वचन मी तुवाह केथु, ताह सोमजी ले; एने हुतरो उबरी, काहाकाय माहु तार फाय मोकलेल हे।” तो इहकेरीन केताच मी उबरी गीयो पुण मी एवी बी कापणे बाजरियेल इतो, काहाकाय मी बिय रियेल इतो।<verse eid="DAN 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="DAN 10:12" />ओवतो तो माहु केयो, “एय दानिएल, मा बिय, जे दिह रेन तु बोगवानान सामने सोताह गेरबोड़ो बाणावीन सोमेजणेन मोन लागाड्यो, ते दिह रेन बोगवान तारी विन्ता होमेलते रियेल हे, तु विन्ता केरते रियेल हे, केरीन मी तार फाय आयेल हे। <verse eid="DAN 10:12" /><verse number="13" style="v" sid="DAN 10:13" />पुण फारस ने राज्‍यान हेरोगदुत एकविस दिह वोर मार हिऱ्यो लेड़ाते रिनो, एने माहु तारास दिते रिनो; पुण हेरोगदुता माय रेन मिखाएल जो मुखी हेरोगदुताम रेन हे, तो मारी मोदेक ने केरता आवो, केरीन मी फारस ने राजा फाय रिनो। <verse eid="DAN 10:13" /><verse number="14" style="v" sid="DAN 10:14" />एय दानिएल, एवी मी तार फाय तुवाह तो सोमजाड़ ने आयेल हे, काय सेवेटल्‍या दिह्याम तार माणहान देशा काय एय; काहाकाय जो देरसेन तु दिखेल हे, तो थोड़ाक दिह्यान बाद पुरो एय।”<verse eid="DAN 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 10:15" />जेवी तो माणुह मार हिऱ्यो बोलतालोन, मी डोंगो वोलीन बुई पोर मुंड टेकाड्यो; एने मी बोल नाह सेकतालो। <verse eid="DAN 10:15" /><verse number="16" style="v" sid="DAN 10:16" />तेवी माणहान गेत देखाणार हेरोगदुत मार ओठाह सापल्‍यो, ओवतो मी मुय उगाड़ीन बोलने बाज गीयो। एने जो मार सामने उबरियेल इतो, ताह मी केयो, “एय मारा मालीक, मी देरसेन माय जो दिखेल इतो, तासे मी दुखी एने बिय जायेल हे, एने मार माय काय ताकेत नाह रेनी। <verse eid="DAN 10:16" /><verse number="17" style="v" sid="DAN 10:17" />मी तारो सेवक दानिएल हे, मी तुवा हिऱ्यो किहीक वातु केर सेकथु? काहाकाय मार माय नाह ताकेत रेनी, एने हांह लेणे बी माहु केठीण हे।”<verse eid="DAN 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 10:18" />तेवी माणहान गेत देखाणार माहु पुशो सापलीन ताकेत आप्यो। <verse eid="DAN 10:18" /><verse number="19" style="v" sid="DAN 10:19" />ओवतो तो केयो, “दानिएल बिय मा, बोगवान तुवाह जुलूम मोंग किरेह; तुवाह सान्ती जुड़ी! मोजबुत एन ईमोत बांद।”</para>
  <para style="p" vid="DAN 10:19">तो ज्‍य केतास माहु ताकेत जुड़नी एने मी केयो, “एय मार मालीक, बोल, काहाकाय तु माहु ताकेत आपेल हे।”<verse eid="DAN 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 10:20" />तेवी तो केयो, “दानिएल, मी तार फाय काहा आवो, तुवाह मालुम हे काय? एवी मी फारस ने हेरोगदुता हिऱ्यो लेड़ाणेन केरता माहु पोशो जाणु हे; जेवी मी जाह, तेवी ग्रीसान हेरोगदुत आवी। <verse eid="DAN 10:20" /><verse number="21" style="v" sid="DAN 10:21" />पुण दानिएल, मार जाणेन पेल तुवाह आखान पेल माहु ज्‍य केणु हे काय खेरायीन पुस्तेक माय काय लिखेल हे; ता खाराब हेरोगदुतान विरूद माय मिखाएल हेरोगदुताह सोड़ीन मार हिऱ्यो कुण नाह उबरेत, मिखाएल तारा माणहा पोर राज केरनार हेरोगदुत हे।<verse eid="DAN 10:21" /></para>
  <chapter eid="DAN 10" />
  <chapter number="11" style="c" sid="DAN 11" />
  <para style="p">
    <verse number="1" style="v" sid="DAN 11:1" />“दारा नावान मादि राजान राज्‍यान पेल्ले वोरीह ताह ईमोत आपणे एने ताकेत आपणेन केरता मी उबरी गीयो।”<verse eid="DAN 11:1" /></para>
  <para style="s">मिस्र एने सीरीयान राज्य</para>
  <para style="p">
    <verse number="2" style="v" sid="DAN 11:2" />एवी दानिएल, मी तुवाह खेरी वात केथु, “फारस ने राज्या माय उंजु तीन राजा बोणती; एने न्यान बाद एक चोवथो राजा आवी, ज्‍यो राजा फारस ने पेल्ला राजाह रेन जुलूम मालदार रेय; राज सापड़ावणेन केरता तो मालदेनान वापेर केरी, तो एकेकाह ग्रीसान विरूद जाणेन केय।”<verse eid="DAN 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="DAN 11:3" />“तान बाद एक जुलूम ताकेतवोर राजा आवी, एने मोटला आदिकार माय तो राज केरी; तान जी मोरजी एय तीस केरी। <verse eid="DAN 11:3" /><verse number="4" style="v" sid="DAN 11:4" />तो आवताच तान राज्य टुटी एने दुनियान चार बागाम वाटाएन आलेग आलेग एय जाय; तान राज्य तान सोरा एने नातण्‍याख ने विचीम नाय वाटाय; काहाकाय तान राज केरनेन आदिकार सांडाड़ीन दिहरा माणहाह आपाय जाय।”<verse eid="DAN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 11:5" />“देक्षिणान मिस्र देसान राजा ताकेतवोर एय जाय, पुण ताच ने एक सेनापोती ताह रेन बी जादा ताकेतवोर एय जाय; सेनापती राज्य केरने बाज जाय एने तान राज्य जुलूम ताकेतवोर रेय। <verse eid="DAN 11:5" /><verse number="6" style="v" sid="DAN 11:6" />जुलूम वोरह्या वितणेन बाद, देक्षिणान राजान सोरी उत्तर देसान राजान सोरी हेऱ्यी वाराड़ केरी; सान्ती लावणेन केरता ती ओहलो केरी। पुण ती एने देक्षिणान राजा पुरा ताकेतवोर नाय रेती, ओवता माणहे तीन एने ता माणहान जो तीह ता देसाम लायेल इतो विरूद एय जाती, एने ता माणहे तीन सोरान एने ती बायकुन एदम्यान बी विरूद एय जाती। <verse eid="DAN 11:6" /><verse number="7" style="v" sid="DAN 11:7" />पुण तीस ने कुटूमाम रेन एक माणुह देक्षिणवाला राजान जागा पोर बोही; एने तान सेना पोर चेड़ाय केरीन उत्तरवाला राजान किल्‍ला माय रिगी, तो ता हिऱ्यो लेड़ाय केरीन जिक जाय। <verse eid="DAN 11:7" /><verse number="8" style="v" sid="DAN 11:8" />तेवी तो तान देवतान मुरतीह, एने होना चांदीन किमती वोस्तुह सांडाड़ीन तो मिस्र माय ली जाय; ओवतो थोड़ाक वोरह्या वोर उत्तरवाला राजाह पोर चेड़ाय नाय केरी। <verse eid="DAN 11:8" /><verse number="9" style="v" sid="DAN 11:9" />उत्तरवालो राजा देक्षिणान राज्या पोर चेड़ाय केरने आवो, पुण आरवाणेन विचार केरीन तो पुशो तान देसाम जात रिनो।”<verse eid="DAN 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 11:10" />“उत्तरवाला राजान सोरा मोट मोटला टोला टुलो केरीन लेड़ाय केरती, एने ता माय रेन एक टुलो लेड़ाय केरते लेन जिक जाय, एने सेनाह मारतेन तान किल्ले वोर लेड़ातेन जात रेय। <verse eid="DAN 11:10" /><verse number="11" style="v" sid="DAN 11:11" />तेवी देक्षिणान राजा रागाम बोरायीन निकली, एने उत्तरवाला राजा हिऱ्यो लेड़ाय केरी, पुण ता फाय जुलूम सेना एन बी तो आरवाय जाय। <verse eid="DAN 11:11" /><verse number="12" style="v" sid="DAN 11:12" />उत्तरवाला सेना आरवाय जाय, एने ता सेनाह देरीन ली जाती, एने देक्षिणान राजा जुलूम मोठाय केरी; एने तो लाखो माणहाह माराव देय, पुण तान जिक जादा दिह वोर नाय टिकी।”<verse eid="DAN 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 11:13" />“सिरीयान राजा दिहरा सिपाय टुलो केरी; जुलूम वोरह्या बाद तो चेड़ाय केरी, ती सेना जुलूम रेय एने ता फाय जुलूम आथ्‍यार रेती; ती सेना लेड़ाय केरनेन तियार रेय। <verse eid="DAN 11:13" /><verse number="14" style="v" sid="DAN 11:14" />ता दिह्याम जुलूम माणहे देक्षिणवाला राजान विरूद माय एय जाती; पुण तारा माणहाम रेन बी लेड़ाणारे माणहे उठ बोहती, ता जिकती नाय, पुण इहकेरीन केरने से ज्या देरसेनान वात पुरी एय जाय। <verse eid="DAN 11:14" /><verse number="15" style="v" sid="DAN 11:15" />ओवतो न्यान बाद उत्तर देसान राजा आवीन किल्‍लो बांदिन मोजबुत हियोर ताबाम लेय लेय। एने देक्षिणवाला राजान सेना लेड़ायीन जापाप नाय आप सेकी; न्या वोर काय देक्षिणवाला सेनान आखाम रेन हाजाला सिपाय बी ओला ताकेतवोर नाय रेती काय ता उत्तरवाला सेनाह रोक सेकी। <verse eid="DAN 11:15" /><verse number="16" style="v" sid="DAN 11:16" />उत्तरवाला राजान जोहलो मोरजी एय, तोहलोस केरी; ताह कुण बी रोक नाय सेकी, हाजा देसान राज एने नियंत्रण तान आथाम आवी, ताह आखा देसा पोर तान आदिकार एय जाय।”<verse eid="DAN 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 11:17" />“ओवतो उत्तरवालो राजा देक्षिणवाला राजा हिऱ्यो लेड़ाणेन केरता तान आखी ताकेतीन वापेर केरनेन निश्‍चय केरी, तो तान एक सोरीन वाराड़ देक्षिणवाला राजा हिऱ्यो केर देय; देक्षिणवाला राजाह आरेवणेन केरता तो इहकेरीन केरी, पुण तान योजना पुरी नाय एय, ज्या योजना केरीन ताह काय फायदो नाय एय। <verse eid="DAN 11:17" /><verse number="18" style="v" sid="DAN 11:18" />तेवी तो उत्तरवाला राजा बुमद्‍य देरीयान दिड़ेवाला देसान उगे वोली, तो जुलूम देसाह आरवीन जिक लेय, पुण एक सेनापोती उत्तरवाला राजान गोमेंडाह खेतेम केरी; तो सेनापोती ता उत्तरवाला राजाह लाजवाड़ी। <verse eid="DAN 11:18" /><verse number="19" style="v" sid="DAN 11:19" />तान बाद उत्तरवालो राजा सोतान देसावालो मोजबुत किल्लाम पोशो जात रेय, पुण तो कोमजोर एन पोड़ी, एने तो खेतेम एय जाय।”<verse eid="DAN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 11:20" />“ओवतो उत्तरवाला राजान बाद नोवालो राजा आवी, तो मोज माय जीवाय जीवणेन केरता पोयशा टुलो केरनेन केरता तो उकालनाराह मोकली; पुण थोड़ास वोरह्याम तो बिगेर लेड़ाय किरेल मोर जाय।”<verse eid="DAN 11:20" /></para>
  <para style="s">सीरीयान खाराब राजा</para>
  <para style="p">
    <verse number="21" style="v" sid="DAN 11:21" />“तान जागा पोर एक खाराब माणुह आवी, ता माणहाह राज बोड़ाय एणेन लायकी नाय रेय; तो चालाकी से राजा बोणी। पुण तो सान्‍तीन टेमाम आवीन राज्या पोर चेड़ाय केरी, एने ता पोर कोबजा केर लेय। <verse eid="DAN 11:21" /><verse number="22" style="v" sid="DAN 11:22" />तो मोटली ताकेतवोर सेनाह आरीव देय, तो नेतान वाचान मोदेक से आरीव देय। <verse eid="DAN 11:22" /><verse number="23" style="v" sid="DAN 11:23" />काहाकाय ज्या खाराब राजा हेऱ्या जुलूम देस वाचा बांदती पुण तो जुठ बोली एने ताह फोसाड़ी, पुण जुलूम कोम माणहाह आरही लेन चेड़ाय केरीन जिकनो। <verse eid="DAN 11:23" /><verse number="24" style="v" sid="DAN 11:24" />जेवी मालदार देसाह हाजे हुके हेते ओहलो लागी, तेवीच तो खाराब राजा ता पोर चेड़ाय केरी; तो ठिक टेम पोर चेड़ाय केरी, एने जो काम नाह ता तान डायडाया एने नाह तान डायडायान डायडाया केरताला, ताह तो केरी; आरवायेल देसान मालदेन लुटीन तान माणहाह आपी। तो मोजबुत हेयराह आरेवणेन योजना बाणावी, ताह जिक जुड़ी; पुण थोड़ास टेमान केरता।”<verse eid="DAN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 11:25" />“तेवी तो देक्षिण देसान राजान विरूद मोटली सेना लेन तान ताकेत एने ईमोताह वोड़ावी, एने देक्षिण देसान राजा जुलूम ताकेतवोर सेनाह लेन लेड़ाय ते केरी, पुण तान विरूद किरेल योजनान वोजेसे देक्षिणवाला राजा आरवाय जाय। <verse eid="DAN 11:25" /><verse number="26" style="v" sid="DAN 11:26" />ता राजान हाजाला दोस्ती सोमजाय जाणारेच, ताह आरेवणेन कोसीत केरती; तान सेना आरवाय जाय, लेड़ाय माय तान जुलूम सेना माराय जाती। <verse eid="DAN 11:26" /><verse number="27" style="v" sid="DAN 11:27" />तेवी ता दुयू राजान मोन बुराय केरने माय लागी, ता एकास टेबला पोर बोहीन एकमेकाह जुठ बोलती; पुण इहकेरीन केरीन ता दुयाम रेन कुणाच ने फायदो नाय एय, काहाकाय बोगवान तान खेतेम एणेन टेम निश्‍चित किरेल हे। <verse eid="DAN 11:27" /><verse number="28" style="v" sid="DAN 11:28" />जुलूम मालदेन लेन उत्तरवालो राजा तान देसाम पोशो जात रेय, ओवतो चोखाला वाचान विरूद खाराब काम केरनेन तो ठेरावी; तो तान योजना पारमाणे आखो काम केरी ओवतो तान देसाम पोशो जात रेय।”<verse eid="DAN 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 11:29" />“ठिक टेम आवतास पोशो, उत्तरवालो राजा, देक्षिणवाला राजा पोर चेड़ाय केरी, पुण एवी पेल ने गेत, तो जिकी नाय। <verse eid="DAN 11:29" /><verse number="30" style="v" sid="DAN 11:30" />पश्‍चिम रेन कित्तीम ने डोंडह्या आवती एने उत्तरवाला राजान विरूद लेड़ाय केरती।”</para>
  <para style="p" vid="DAN 11:30">“ओवतो तो ता डोंडह्याह आवताला देखीन बिय जाय; एने तो नाराज एन वोल जाय, एने चोखाला वाचा पोर तो तान राग उतारी। तो जा माणहे चोखाला वाचा पोर चालने सोड़ दियेल एता, ताह मोदेक केरी। <verse eid="DAN 11:30" /><verse number="31" style="v" sid="DAN 11:31" />उवतो उत्तरवालो राजा यरूशलेमान चोखालो जागाह एने किल्लाह एठो केरनेन केरता तान सेना मोकली, ती सेना माणहाह कायेम बोली केरने नाय देती; एने ता खाराब वोस्तुह उबा केरती एने जा उजाड देती। <verse eid="DAN 11:31" /><verse number="32" style="v" sid="DAN 11:32" />चोखाला वाचा पोर चालने सोड़ दियेल माणहाह उत्‍तरवालो राजा जुठ बोलीन फोसाड़ी; पुण जा माणहे बोगवानाह जाणतेह, एने तान उकुम मानतेह, ता मोजबुत एय जाती एने पोलटीन लेड़ाय केरती। <verse eid="DAN 11:32" /><verse number="33" style="v" sid="DAN 11:33" />एने माणहा माय रेन जा सोमेजदार हेते ता जुलूम जाणाह हिकाड़ती, तीबी ताह पिढ़ा वेठणे पोड़ी; जुलूम दिह वोर ताम रेन थोड़ाक माणहे तालवार केरीन माराय जाती एने थोड़ाक आक्‍ठाम टाकाय जाती; एने जेली माय टाकाय जाती, थोड़ाक जाणान गेर बार एने मालदेन सांडाड़ाय जाय। <verse eid="DAN 11:33" /><verse number="34" style="v" sid="DAN 11:34" />एने जेवी ज्यी पिढ़ा आवी तेवी ताह थोड़ीक मोदेक जुड़ी, एने जा माणहे मोदेक केरती, जुलूम जाणे देखाड़ने पुरता रेती। <verse eid="DAN 11:34" /><verse number="35" style="v" sid="DAN 11:35" />एने थोड़ाक सोमेजदार माराय जाती, ओहलो ज्यानकेरता एय काय ता उंजु मोजबुत बोणी, चोखा बोणी एने सेवेटल्‍या दिह्यान टेम आवता वोर निर्दोस रेय; ओवतो ठिक टेम पोर नास एणेन टेम आव लागी।”<verse eid="DAN 11:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 11:36" />तेवी तो राजा तान मोरजीन गेत काम केरी, एने सोताह आखा देवताह रेन उचो एने मोठो ठेरावी; एने आखा देवतान बोगवानान विरूद चिहटान वातु केय। एने जाह वोर त्यु आख्‍यु खाराब वातु एय नाह जात्‍यु, ताह वोर ता राजान काम पुरो ईती रेय; काहाकाय जो बोगवान ठेरायेल हे तो पुरो एण्‍योस हे। <verse eid="DAN 11:36" /><verse number="37" style="v" sid="DAN 11:37" />तो राजा तान डायडाया मान्नु ता देवताह, एने बायकु मान्नु ता देवताह, तो काल्लास देवताह नाय मानी; पुण तो सोतान बोड़ाय किरते लेय, एने सोताह आखा देवताह रेन मोठो मानी। <verse eid="DAN 11:37" /><verse number="38" style="v" sid="DAN 11:38" />तो राजा काल्‍लास देवतान पुजा नाय केरी, पुण तो किल्लावाला देवतान पुजा केरी; तो होनो, चांदी, जुलूम किमती हिरा एने किमती वोस्तु चेड़ावीन ओहला देवतान पुजा केरी जाह तान डायडाया जाणताला वोर नाह। <verse eid="DAN 11:38" /><verse number="39" style="v" sid="DAN 11:39" />ता पाराया देवतान मोदेक से तो राजा मोजबुत किल्‍ला पोर चेड़ाय केरी, ताह सात देणारे पाराया राजाह तो जुलूम आदार केरते लेन ताह जुलूम जाणा पोर मुखी ठेरावी; एने तान फायदान केरता तान देसान बुयीह वाट देय, तान बोदले तो ता फाय रेन पोयशा वसुल केरी।<verse eid="DAN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="DAN 11:40" />“सेवेटल्‍या दिह्याम देक्षिण देसान राजा उत्तरवाला राजा हिऱ्यो लेड़ाय केरी, पुण उत्‍तरवालो राजा टांगा, गोड़ा एने मोट मोटला डोंडह्याह लेन आवी एने चेड़ाय केरी; इहकेरीन तो जुलूम देसा पोर चेड़ाय केरी, एने ताह बाड़ ने गेत गीलीन ओंगाण चाल पोड़ी। <verse eid="DAN 11:40" /><verse number="41" style="v" sid="DAN 11:41" />राजा वायदो किरेल देरती पोर चेड़ाय केरी, तो जुलूम देसाह आरीव देय; पुण एदोम, मोआब, एने मुखी मुखी अम्मोनी जातीन देस तान आथे वोच जाती। <verse eid="DAN 11:41" /><verse number="42" style="v" sid="DAN 11:42" />जुलूम देसाह तो तान ताकेत देखाड़ी। मिस्र देसाह बी तान ताकेतीन बाराम मालुम पोड़ जाय। <verse eid="DAN 11:42" /><verse number="43" style="v" sid="DAN 11:43" />तो मिस्र देसान होना चांदीन खेजानो एने आखा मालदेनान मालीक बोण जाय; लुबी एने कुशी माणहे बी तान ताबाम एय जाती। <verse eid="DAN 11:43" /><verse number="44" style="v" sid="DAN 11:44" />पुण उत्तरवाला ता राजाह पुर्व एने उत्तर उगे रेन एक खोबेर होमलीन बिय जाय, एने जुलूम रागाम आवीन जुलूम जाणाह खेतेम केरनेन केरता निकली। <verse eid="DAN 11:44" /><verse number="45" style="v" sid="DAN 11:45" />तो तान तोम्बु देरीयो एने चोखाला बोयड़ान विचीम उबो केरी, पुण आखरी तो खाराब राजा मोरी, तुलबुखे ताह मोदेक केरनेन ता हेर्‍य कुण नाय रेय।”<verse eid="DAN 11:45" /></para>
  <chapter eid="DAN 11" />
  <chapter number="12" style="c" sid="DAN 12" />
  <para style="s">सेवल्‍यो टेम</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 12:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:1 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:1">निर्गमन 12:1</ref>; <ref loc="MAT 24:21">मत्ती 24:21</ref>; <ref loc="MRK 13:19">मरकुस 13:19</ref>; <ref loc="JUD 1:9">यहुदा 1:9</ref>; <ref loc="REV 7:14">प्रकाशितवाक्य 7:14</ref>; <ref loc="REV 12:7">12:7</ref></char>
    </note> तुलेचबूखे देरसेन वालो माणुह केयो, “एय दानिएल, तुलबुखे मिखाएल नावान एक मुखी हेरोगदुत उब रेय, मिखाएल तुमरा यहुदि माणहान राखवाल्‍यो हे; ओवतो जुलूम तेकलीतान टेम आवी, देरती पोर देस बोणेल तुलबूखीन ओहलो टेम केदी आवो निह, पुण दानिएल, तुलबुखे तारा माणहाम रेन जान नाव बोगवानान पुस्तेक माय लिखेल हेते, ता आखा वोच जाती। <verse eid="DAN 12:1" /><verse number="2" style="v" sid="DAN 12:2" />देरतीन जुलूम होवटा माणहे जा मोर जायेल हेते एने जाह बुज दियेल हेते, पोशा जीव जाती; एने ताम रेन थोड़ाक जेलेमक्यी जीवाय जीवणेन केरता जीव उठती, पुण थोड़ाक ज्यानकेरता जीव उठती काय कायेम ने लाज एने खाराब ठेराणेन केरता। <verse eid="DAN 12:2" /><verse number="3" style="v" sid="DAN 12:3" />सोमेजदार माणहे जुगावाला उजेड़ान गेत चोमेकती, जा सोमेजदार माणहे दिहराह हाजाली जीवायीन वाट देखाड़ेल एता; ता कायेम ने केरता तारान गेत चोमेकती।”<verse eid="DAN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 12:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:4 </char>
      <char style="xt" closed="false">
        <ref loc="REV 22:10">प्रकाशितवाक्य 22:10</ref>
      </char>
    </note>पुण एय दानिएल! तु ज्या पुस्तेक पोर साप लागाड़ीन ज्या वचनाह सेवल्‍या टेमान बुखेत वोर लिकाड़ीन मेल। जुलूम माणहे न्या पोला खेरली बुद्दीन होद केरती, एने बुद्दी जुलूम वोड़ जाय।<verse eid="DAN 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 12:5" />ओवतो मी दानिएलाह, दुय दिहरा माणहे देखाना, ताम रेन एक नेदीन दिड़े मार हिऱ्यो उबरियेल इतो, एने दिहरो माणुह नेदीन ती दिड़े उबरियेल इतो। <verse eid="DAN 12:5" /><verse number="6" style="v" sid="DAN 12:6" />तेवी जो हेरोगदुत जो हुवाल्ला फाड़का पिरेल नेदीन पाण्या पोर उबरियेल इतो, ता दुयाम रेन एक जाण ताह फुशो, “ज्‍यु बोंगलाय ओहल्‍यु वातु खेरी एणेन कोलोक टेम लागी?”<verse eid="DAN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 12:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:7 </char>
      <char style="xt" closed="false">
        <ref loc="REV 10:5">प्रकाशितवाक्य 10:5</ref>; <ref loc="REV 12:14">12:14</ref></char>
    </note>तेवी जो हेरोगदुत हुवाल्ला फाड़का पिरेल नेदीन पाण्या पोर उबरियेल इतो, तो तान जीवड्यो एने डाखऱ्यो दुयू आथ हेरगान उगे उचा केरीन, कायेम जीवतालो रेणार बोगवानान सुगोण खाएन केयो, “ज्यी देशा साड़े तीन वोरह्या वोर रेय; एने जेवी चोखाला माणहान ताकेत कोम ईती ईती निवरी जाय, तेवी ज्‍यु आख्‍यु वातु पुऱ्यू एती।”<verse eid="DAN 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 12:8" />ज्यी वात मी होमलेल ते इतो, पुण माहु तान मतलब नाह सोमेजनो। तेवी मी फुशो, “एय मारा मालीक, ज्‍यु सेवल्या दिह्याम काय एय?”<verse eid="DAN 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 12:9" />तो केयो, “एय दानिएल, तु तारा जीवणान उगे द्यान दे; ज्‍यु वातु आठावे हेत्यु एने जाह वोर सेवल्‍यो टेम नाय आवी, ज्‍यु वातु सिक्को लागाड़ीन बोंद किरेल हे। <verse eid="DAN 12:9" /><verse number="10" style="v" sid="DAN 12:10" />जुलूम माणहे चोखा केराय जाती, ता माणहे खुद सोताह चोखा केरती पुण खाराब माणहे, खाराबुस बोणीन रेती एने ता खाराब माणहे ज्‍यु वातुह नाय सोमेजती; पुण सोमेजदार आखो सोमजी।<verse eid="DAN 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 12:11" />“जेवीह रेन कायेम ने बोली केरने बोंद एय जाय, तेवीह रेन एवी वोर, बियावे ओहल्‍यु नास केरनार वातु एता वोर, टेम बारा होव नोव्वद दिह्यान रेय। <verse eid="DAN 12:11" /><verse number="12" style="v" sid="DAN 12:12" />जो वाट जोवी, एने तेरा होव पोस्तीस दिह्यान सेवेट वोर पोची, तो जुलूम सुखी रेय।<verse eid="DAN 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 12:13" />“एय दानिएल, जा, एने आखरी वोर तार जीवाय जीव, तुवाह आराम जुड़ी; एने आखरी तु मुरेल माणहाम रेन जीव उठहे एने तुवाह तारो ईसो जुड़ी।”<verse eid="DAN 12:13" /></para>
  <chapter eid="DAN 12" />
</usx>