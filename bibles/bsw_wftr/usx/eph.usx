<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="EPH" style="id">- Bayso New Testament</book>
  <para style="h">Efesooni</para>
  <para style="toc1">Kafaramero P'awuloosakkoki Handdaa Kaɂefesooni Ibaaddo Tos</para>
  <para style="toc2">Efesooni</para>
  <para style="toc3">Efe.</para>
  <para style="mt2">Kafaramero P'awuloosakkoki Handdaa</para>
  <para style="mt1">Kaɂefesooni Ibaaddo Tos</para>
  <para style="imt">Tabano</para>
  <para style="ip">P'awuloosa Kaɂefesooni ibaaddon kas'aafera handdaa dubbaankkona hore kinttib kakkosisara «Halchcha kawaa goggolleeroo daruurnna uliinna kagira met't'ajjool dubba isiɂaatire koo kakiristoosa odonnati hegelii tagirraan arri kakkogeete gorataayya» (1:10) taɂamatto k'ofaayiya. Adena Yesuusa Kiristoosane wota koo liigureen sannii taɂibaaddo dubba too goggolleeto hikka kaɂatii halchcha felooyi goggohayisiraanun gosa kashaadisaroyya.</para>
  <para style="ip">Handdaa kaɂefesoonii tahoraarjjee banɂee s'aafiti raattonatikokki gara tahaggabero metetti k'ofa balɂaasaa, Waa odo gosakkeessa misii assaabatero, erekkeessa Yesuusa Kiristoosaa c'ubbokkisoowun haheso amamano helateeren misii iso balchchanɂi leeraan, kaɂatii kaɂabddii haafura kawaa Ayyaana K'ulluukkokki garane misii addeesamero tusara, tallami banɂee ade s'aafiti onabbabaraan raattokki girikisooyi Kiristoosaayi kaɂabaan raattonati karrummii goggolleeroo iso misii girin dootisaro shaadisara.</para>
  <para style="ip">Ibaaddo Kiristoosane wota taɂabo esella misii raattonati abo kalekaleekki lefikko bee kaɂayeesamaro ayeesii mutera, min kawaa maar malee golleero Kiristoosa ade maarkokki mete maleeya, min kawaa gimbbe aani golleero Kiristoosa ade minuun mina afarruun metekki eɂemoyya, min kawaa oori malee golleero Kiristoosa ade entterya, s'aafiti gara kakiristoosane tamuttetto sino tawaa aaloo saadisaa kakkoɂayeesiro goorata golate kagiro ayees tusara, ayees dubba usu kakkodeyaara takiristoosa geelanjjee, jaarsso laanokkeessa, haheso amano, sinonna nogoddakokki garaneya</para>
  <para style="iot">Raattoo Hikki Mas'aafa Kaɂabera</para>
  <para style="io1">Tabano <char style="ior"><ref loc="EPH 1:1-2">1:1-2</ref> </char></para>
  <para style="io1">Kiristoosana min kawaanna <char style="ior"><ref loc="EPH 1:3-3:21">1:3—3:21</ref> </char></para>
  <para style="io1">Kiristoosaa kahelamaro giri kaɂusub <char style="ior"><ref loc="EPH 4:1-6:20">4:1—6:20</ref> </char></para>
  <para style="io1">Gudisano <char style="ior"><ref loc="EPH 6:21-24">6:21-24</ref> </char></para>
  <chapter number="1" style="c" sid="EPH 1"/>
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1"/>Feɂi tawaayi Yesuusa Kiristoosayi kafaramero P'awuloosakko, Yesuusa Kiristoosaa oɂabddameeraan,<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="ACT 18:19-21">Ofa. Fe. 18:19-21</ref>.</char></note></para>
  <para style="p" vid="EPH 1:1">Taɂefesooni katamaayi ogiraan k'ullooleewun,<verse eid="EPH 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EPH 1:2"/>Waa Aabbokkaani Goottaa Yesuusa Kiristoosakkotti sinonna nogodda isinuun halleeto.<verse eid="EPH 1:2"/></para>
  <para style="s1">Kiristoosaa ohelamaraan somma oɂayyaana</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3"/>Daruurii ogiraan somma oɂayyaana dubbaa Kiristoosaa no kasommaasatera Goottakkaanikki Yesuusa Kiristoosakkokki Hedona odo kalleera Waa hagalataamo. <verse eid="EPH 1:3"/><verse number="4" style="v" sid="EPH 1:4"/>K'ulluunɂina tuffi kallayinɂi linne geelanjjee usu hore goggomunttoo alami hamet'amoon giraan horaarjje Kiristoosa no assaabe. <verse eid="EPH 1:4"/><verse number="5" style="v" sid="EPH 1:5"/>Feɂi tawaa taɂidan leetedde Yesuusa Kiristoosan yiis goggolleennon t'aye murttessee. <verse eid="EPH 1:5"/><verse number="6" style="v" sid="EPH 1:6"/>Hikkina kageelaamero erekeessakki garane dannabaa noon tasisero takabajaanttetto sino goggosommaasanttoya. <verse eid="EPH 1:6"/><verse number="7" style="v" sid="EPH 1:7"/>Sino tawaakokki ammagamanokko kakkeeyi erekkeessakki iigi wodoo leenenne c'ubbokkaanikkona haheso amamano helanne.<note caller="-" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="COL 1:14">K'ol. 1:14</ref>.</char></note> <verse eid="EPH 1:7"/><verse number="8" style="v" sid="EPH 1:8"/>Sinotteessa k'arummana malabano dubba jiinase noon sise. <verse eid="EPH 1:8"/><verse number="9" style="v" sid="EPH 1:9"/>Waa anjjirettessaa Kiristoosakokki garane t'aye goggohalchcherokki malee feɂitteessatti hool goggoɂaddeensso yele. <verse eid="EPH 1:9"/><verse number="10" style="v" sid="EPH 1:10"/>Goorata goggee Waa felo gutii kahaayisinara halchcha daruurnna ulii taggitta met't'a dubba raattoo koo kakiristoosa odonnati hegelii goggogirttonya.<verse eid="EPH 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 1:11"/>Ayees dubbana feɂitteessa kafelara Waa t'aye goggohedero malee kakiristoosakokki garane unatteessa goggolleennon no assaabera. <verse eid="EPH 1:11"/><verse number="12" style="v" sid="EPH 1:12"/>Hikkina kakkonlleera Kiristoosa abddi yelataa ohoree olleenenna kabaja tawaa galataanooyi goggotunssonya.<verse eid="EPH 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EPH 1:13"/>Isinna fayyinnakkisinkotti odu taɂidan kalleero haafura karrummii kakkomaaltteen gooratta Kiristoosa ammantteettaan, adena, usu isinuun sisin abddi goggosiseroo Ayyaana K'ulluukki attamantteettan. <verse eid="EPH 1:13"/><verse number="14" style="v" sid="EPH 1:14"/>Hikkina ayyaana kabajatessaawun galata goggogeeron Waa oottessa olleeraan dubbaan taa wodoo leeroo helayiin taginno rittittaaniwun k'abdoottaaniya.<verse eid="EPH 1:14"/></para>
  <para style="s1">P'awuloosa ibaaddo kaɂefesoonin ebaate</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15"/>Haanssun Goottaa Yesuusaa isin kaɂabttan ammanona k'ulloolee dubbaawunna taɂabttaan geelenjje takkomaale arrikko haggaɂabere, <verse eid="EPH 1:15"/><verse number="16" style="v" sid="EPH 1:16"/>Ani isin ebii shaada isin maraan Waawun galata sisano lakkoɂiisero. <verse eid="EPH 1:16"/><verse number="17" style="v" sid="EPH 1:17"/>Kabajja kakkoondootisaro Goottakkaani kayesuusa Kiristoosakokki Hedo kalleero Waa aaloo goggoɂaddeessanun Ayyaana kawaakko talleetetto k'arummana muteen isinuun goggosisiroo ani ebaatara. <verse eid="EPH 1:17"/><verse number="18" style="v" sid="EPH 1:18"/>Isin misitti abddii uumantteettaanna k'ullooleel taɂeelinnara takabajjaa rittii eeggitatti tammooggantto isin goggoɂaddeessanun wodanatisinkkonɂi ilɂo goggodeenddenawun ani ebaatara. <verse eid="EPH 1:18"/><verse number="19" style="v" sid="EPH 1:19"/>No Waa oɂammanannoon dubbaankko kaɂatii kalleero hunnakkessa goggomalabttaanun ani ebaatara, hikki hunnana usu aani kaɂatii ataankkeessakki felooyi,<note caller="-" style="x"><char style="xo" closed="false">1:19 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Mez. 110:1</ref>.</char></note> <verse eid="EPH 1:19"/><verse number="20" style="v" sid="EPH 1:20"/>Kiristoosaa goyikko keesere tadaruuree banɂee mina tamerggee hamas'isaa mutera. <verse eid="EPH 1:20"/><verse number="21" style="v" sid="EPH 1:21"/>Waa odo Kiristoosa daruurii merggetteessayi kahamas'iisera maamisikki k'alaadakkona odonnati hunnakkona Goottanatikko usumaleenna hikka kagiddanee gees kaalaal anlleennon kaɂemeeyinaro geesii golleenna mege dubbakko karooraro kakkabajaame mege sisanooyiya. <verse eid="EPH 1:21"/><verse number="22" style="v" sid="EPH 1:22"/>Waa ayees dubba odonnatikkeessa hegelii bariise, min kaɂebinna dubbaankko karooraro goggolleeroo mete yele shuume.<note caller="-" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="PSA 8:6">Mez. 8:6</ref>.</char></note> <verse eid="EPH 1:22"/><verse number="23" style="v" sid="EPH 1:23"/>Min kaɂebi kakiristoosa maarya, Kiristoosana min kaɂebiinna banɂe dubbaa kameen dubba kaɂammagaro ammagamanokkeessaya.<note caller="-" style="x"><char style="xo" closed="false">1:23 </char><char style="xt" closed="false"><ref loc="COL 1:18">K'ol. 1:18</ref>.</char></note><verse eid="EPH 1:23"/></para>
  <chapter eid="EPH 1"/>
  <chapter number="2" style="c" sid="EPH 2"/>
  <para style="s1">Kiristoosaayi arddonɂi laano</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1"/>Isin baasikkisininna c'ubbokkisinkkotti aalanttii gootteen gitteen. <verse eid="EPH 2:1"/><verse number="2" style="v" sid="EPH 2:2"/>Usu goorata hikka alamikkokki raa kameellan sesseetaa gitteen, usumaleenna ambbali gutii ogiraan ayyaanajjol kameellankokki hunnajjool kabariisaroon ajajaama gitteen, usuna kaɂajajaamon ibaaddo gutii kafelaro battiikki ayyaanaya. <verse eid="EPH 2:2"/><verse number="3" style="v" sid="EPH 2:3"/>Noo dubbana hittakko horeene iso t'eɂee feɂi tasooyetinna sammuuttanikokki yaada debee sesseetaa halchchakkaani kasooyeti ginne, noonna kakkalee aani met't'ataani engge tawaa hegelii ginne.<verse eid="EPH 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 2:4"/>Ayesuun goɂameen shaagakkessaa dureessa kalleera Waa noon taɂabo taɂatii geelanjjekko kakkeeyi, <verse eid="EPH 2:4"/><verse number="5" style="v" sid="EPH 2:5"/>Baasikkanii ogoone leenne giraan, Waa Kiristoosa arddonɂi yele; isin kakkofayyiteettan sinotteessayiya.<note caller="-" style="x"><char style="xo" closed="false">2:5 </char><char style="xt" closed="false"><ref loc="COL 2:14">K'ol. 2:14</ref>.</char></note> <verse eid="EPH 2:5"/><verse number="6" style="v" sid="EPH 2:6"/>Waa kiristoosane wota no goyikko keesera; Kiristoosa Yesuusaa banɂe tadaruureti no usuneta hamas'iisera. <verse eid="EPH 2:6"/><verse number="7" style="v" sid="EPH 2:7"/>Hikkina kaɂemeetaro geesii Kiristoosa Yesuusaa noon tattusero meessa kallayitti sinokotti durumma tusinya. <verse eid="EPH 2:7"/><verse number="8" style="v" sid="EPH 2:8"/>Isin kakkofayyiteettan kaɂammano garane sinooyiya, hikkina ilabo kawaayya kuwaarre isinkko lakkoyo. <verse eid="EPH 2:8"/><verse number="9" style="v" sid="EPH 2:9"/>Maayyona goggot'aadanonkko taffayyinna sino kakkohelanttetta felooyi lakkoyo; <verse eid="EPH 2:9"/><verse number="10" style="v" sid="EPH 2:10"/>Aalanttina, Waa t'aye noon oɂekkaasero felo oɂidan goggofelnno Kiristoosa Yesuusaa omet't'aaminenno met't'a tawaanna.<verse eid="EPH 2:10"/></para>
  <para style="s1">Kiristoosa koo laano</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11"/>Haanssun isin t'ayteen alattaanii Ayizaab olleeteettan, Ayihuudi gene taɂibaaddoyi hamas'iisamanoo dhaadataa isin ohamas'iisamoongittan amaa isin habaaraa kagireen shaada. <verse eid="EPH 2:11"/><verse number="12" style="v" sid="EPH 2:12"/>Usu geesii Kiristoosakko kalebeeteddeen, Isiraɂeelne wota unallaanakko fakkintteeddeen taɂammattoo abiddiin allagggatteen; alami gutii abddi kallayinna Waa kallayi goggogitten shaada. <verse eid="EPH 2:12"/><verse number="13" style="v" sid="EPH 2:13"/>Gidda goɂameen isin hitakko horeene fakkintteen ogitteen Yesuusa Kiristoosa leeteddeen iigikkeessa gabbalantteettan.<verse eid="EPH 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 2:14"/>Ayihuudina Ayizaabna koo kayelara, kalekalee yeltte tagitte taɂenggee gimoo<note caller="+" style="f"><char style="fr" closed="false">2:14 </char><char style="ft" closed="false">Taɂenggee gimoo kaɂamara haafura katusara Ayihuudina Ayizaab t'eɂee kagire ammanokokki kaleenna tusara. </char></note> kadiigera nogoddakkaani usuya. <verse eid="EPH 2:14"/><verse number="15" style="v" sid="EPH 2:15"/>Ajaja kaseera wogane wota sooɂootteessa tire. Yaadakkeesana gosa lamakko koo kaɂusubkki ibaaddoti issii met't'ire nogodda kayiinya. <verse eid="EPH 2:15"/><verse number="16" style="v" sid="EPH 2:16"/>Masik'alii gutii gowaanoyinna diinannati tire, lama dubbana maar koo yelere Waanneta wogarise.<note caller="-" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="COL 1:20">K'ol. 1:20</ref>.</char></note> <verse eid="EPH 2:16"/><verse number="17" style="v" sid="EPH 2:17"/>Emeetegure fakkintteen ogitteen isinuunna, gabbalame kagire Ayihuudin kanogoddaa wongala lallabee.<note caller="-" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="ISA 57:19">Isa. 57:19</ref>.</char></note> <verse eid="EPH 2:17"/><verse number="18" style="v" sid="EPH 2:18"/>Noo dubbana garakkeessne ayyaanakkooyi odo tos gabbalamiin daanddeenenna.<verse eid="EPH 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19"/>Hikkakko kakkeey isin k'ulloolee wota ul kookki ibaaddottan, Waawun kaminee ibaaddottan kuwaarre, goortta hittakko danbbeebaan ul kaɂibaaddokokki ibaaddona martti lakkottaan. <verse eid="EPH 2:19"/><verse number="20" style="v" sid="EPH 2:20"/>Ofarameeraaniinna kahegeroolkokki ukumii dhaabbattettaan. Mina afarruun libe kalleera Kiristoosa Yesuusaya. <verse eid="EPH 2:20"/><verse number="21" style="v" sid="EPH 2:21"/>Libeenna min dubba raattoo iinsseɂabayire kagootta k'ulluukki min kawaa liin jiinatara. <verse eid="EPH 2:21"/><verse number="22" style="v" sid="EPH 2:22"/>Isin addeen Waa ayyaanakkeessayi kakkobaraaro min liin raattoo Kiristoosa gimbbamattan.<verse eid="EPH 2:22"/></para>
  <chapter eid="EPH 2"/>
  <chapter number="3" style="c" sid="EPH 3"/>
  <para style="s1">Ayizaabn kafarame P'awuloosa</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1"/>Hitta aalanttii ani p'awuloosa Yesuusa Kiristoosan kashaame kakkoonlleera isin Ayizaabn maraanya. <verse eid="EPH 3:1"/><verse number="2" style="v" sid="EPH 3:2"/>Laɂo tattisin maraan iin tasisantetto sino tawaa handdaanokkee ogiraan maaltteettan. <verse eid="EPH 3:2"/><verse number="3" style="v" sid="EPH 3:3"/>T'aye gabaabbinnaa ani goggos'aaferoo; Waa hooltteessa addeesise raagaayi iin tusera. <verse eid="EPH 3:3"/><verse number="4" style="v" sid="EPH 3:4"/>Goortta isin hikka nabbabbaa giraan, takiristoosa hool ani misiɂmisii shaadaro addeesin daanddaattan. <verse eid="EPH 3:4"/><verse number="5" style="v" sid="EPH 3:5"/>Hitti hool k'ulloolee ofarameeraawunna kahegeroolun gidda kamutero gitakki kahorkkoo ibaaddon lakkomutere. <verse eid="EPH 3:5"/><verse number="6" style="v" sid="EPH 3:6"/>Hitti hool, Ayizaab gara kawongalane Isiraɂeelne wota raattoo oɂeelinaraan, maar kookki mikitaal liireen usumaleenna Yesuusa Kiristoosa talleetetto abddii raattoo ohedeedamaraan laanoyiya.<note caller="-" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="COL 1:26-27">K'ol. 1:26-27</ref>.</char></note><verse eid="EPH 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 3:7"/>Waa hunnakkeesanɂi felooyi iin kasisero kasinoo ilabo aninna hikka wongalaan kahandaaro leera. <verse eid="EPH 3:7"/><verse number="8" style="v" sid="EPH 3:8"/>Maamisiinna ani ade k'ullooleel dubbakko kayeraataro goleenna, tak'ok'k'oramoon durumma takiristoosa Ayizaabn goggolallabiroon hitti sino iin sisantte. <verse eid="EPH 3:8"/><verse number="9" style="v" sid="EPH 3:9"/>Usumaleenna dubba kamet't'eero Waayi karoorero geesijjool siyameen ogiraan hinɂa felo konɂi hool dubbaan goggotusiroo iin sisame. <verse eid="EPH 3:9"/><verse number="10" style="v" sid="EPH 3:10"/>Yaadakkeessana gees kaɂarkkaneetii min kawaakokki garane middi tammooggan taɂabtto k'arumma tawaa banɂe tadaruureti ogiraan woyichchaalunna odonnati oɂabaawun goggoɂaddeesanttoonya. <verse eid="EPH 3:10"/><verse number="11" style="v" sid="EPH 3:11"/>Hikkina Yesuusaa Kiristoosa Goottakkaani kafelero jiruu jiroommakki halchcha maleeya. <verse eid="EPH 3:11"/><verse number="12" style="v" sid="EPH 3:12"/>Usuna usuu gutii kagiro ammanokokki garane, balchchummana jabuu taɂabtto wodanaa Waa tos gabbalamiin daanddaanna. <verse eid="EPH 3:12"/><verse number="13" style="v" sid="EPH 3:13"/>Haanssun kabajjattisin kalleero isin maraan in tageetetto rakkooyi abddi goggogoosannonkko hadara amara.<verse eid="EPH 3:13"/></para>
  <para style="s1">Ul kaɂefesoonikki amaniilun kaɂebaamero ebi</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14"/>Goortta ani Waa Odo horee gilbkkeeyi gilbbisere kakkoonɂebaatara hitta aalanttiinya. <verse eid="EPH 3:14"/><verse number="15" style="v" sid="EPH 3:15"/>Daruurnna ulii kagira min kookki ibaaddo mete metee Waakko mege helayinara. <verse eid="EPH 3:15"/><verse number="16" style="v" sid="EPH 3:16"/>Maar kaɂorroo kakkisinii goggoɂataattaanun, ayyaanakkeessakkokki garane kabajatteessatti durummana hunna isinuun goggosisiroo ebaatara. <verse eid="EPH 3:16"/><verse number="17" style="v" sid="EPH 3:17"/>Hikkina ammanoo Kiristoosa wodanattisinii goggobarirooya. Adena hidiid dagisideene geelanjjee dhaabbayiddeene, <verse eid="EPH 3:17"/><verse number="18" style="v" sid="EPH 3:18"/>Takiristoosa geelanjje balɂaanna, eeraanna, t'ok'k'imanona boollana eeggitakkiyo k'ulloolee dubbane wota kakkoɂaddeesankokki hunna goggohelataawunya. <verse eid="EPH 3:18"/><verse number="19" style="v" sid="EPH 3:19"/>Hikka malabano kaɂibaaddokko taroorttetto geelanjje takiristoosa goggoɂaddeessawun ammagamano kawaayi ammagamiin goggoɂekkaattaawun ani ebaatara.<verse eid="EPH 3:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20"/>Goortta no orroo goggofelaroo hunnakkeessakokki jilbbaa malee kaɂebaatannokko goorttun kahedatanno dubbakko aaloo roorisi felin kadaanddaro, <verse eid="EPH 3:20"/><verse number="21" style="v" sid="EPH 3:21"/>Min kawaa orroo usumaleenna Yesuusa Kiristoosaayi, geesjjool dubbaa jiruu jiroommakko taa jiruu jiroomma geeroon kabaja usuun halleeto hamiinɂi.<verse eid="EPH 3:21"/></para>
  <chapter eid="EPH 3"/>
  <chapter number="4" style="c" sid="EPH 4"/>
  <para style="s1">Kiristoosaayi maar koo laano</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1"/>Goortta Goottawun handdaanoyi kashaame kalleera ani, isin takkoɂuumantteettan uumitii kadootisaro giri goggogirttaanun ani isin ebaatara. <verse eid="EPH 4:1"/><verse number="2" style="v" sid="EPH 4:2"/>Geelanjjee isiɂisirroo obssaa arggetto fayyankkanɂina oɂidan laa; geelanjjee isiɂisirroo daanddaano gira.<note caller="-" style="x"><char style="xo" closed="false">4:2 </char><char style="xt" closed="false"><ref loc="COL 3:12-13">K'ol. 3:12-13</ref>.</char></note> <verse eid="EPH 4:2"/><verse number="3" style="v" sid="EPH 4:3"/>Kanogoddaa shiyaamano ayyaanakkokki raattonati oorayin ataayeen. <verse eid="EPH 4:3"/><verse number="4" style="v" sid="EPH 4:4"/>Kakkoɂuumantteetten goorata abddi toowun goggoɂuumanttettaan malee maar koonna Ayyaana kooyya kagira. <verse eid="EPH 4:4"/><verse number="5" style="v" sid="EPH 4:5"/>Usumalee Goottaa koo, ammano koonna t'ink'ata kooyya kagira. <verse eid="EPH 4:5"/><verse number="6" style="v" sid="EPH 4:6"/>Adena dubbaankko karoorara, dubbaa gutii kafelara, dubbaa gutii kagira, dubbaan Odo kalleera, Hedo kooyya kagira.<verse eid="EPH 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7"/>Ayesuun goɂameen Kiristoosa sisin goggomurttesserokokki jilbbaa mete metee sino noon sisanttetta. <verse eid="EPH 4:7"/><verse number="8" style="v" sid="EPH 4:8"/>Haanssun,</para>
  <para style="q1" vid="EPH 4:8">«Eleddee kakkobeere goorata, obojaameeraan boojee,</para>
  <para style="q2" vid="EPH 4:8">ibaaddowunna ilabo sise» goggoɂamamerooya.<note caller="-" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="PSA 68:18">Mez. 68:18</ref>.</char></note><verse eid="EPH 4:8"/></para>
  <para style="m">
    <verse number="9" style="v" sid="EPH 4:9"/>Hayya hikki, «Eleddee beera» amano ade ul tos hegelddee dagera amano gollee kuwaarre kakkalee me amanoya? <verse eid="EPH 4:9"/><verse number="10" style="v" sid="EPH 4:10"/>Hegelddee kadagera, met't'a dubba alamii goggoɂammaganttoo ele daruurkko kaɂemeetera usu usuwaya. <verse eid="EPH 4:10"/><verse number="11" style="v" sid="EPH 4:11"/>Usuna kookkoo ofarameeraan, kookkoo hegerool, kookkoonna wongala olallabaraan, kakkalee ade ibaaddo kawaa ofoofaraanna oɂagaalssisaran goggolleerawun ilabool kasisera usuya. <verse eid="EPH 4:11"/><verse number="12" style="v" sid="EPH 4:12"/>Hikkina kakiristoosa una kalleere min kawaa goggodhaabbaro, ibaaddo kawaa handdaa kawaatuun ekkaasinya. <verse eid="EPH 4:12"/><verse number="13" style="v" sid="EPH 4:13"/>Hikkina kakkoonllinnara, no dubbana ere kawaa ammananonna malabanon kahelamaro raattonati tos emeetanona kanjjinkki ibaaddo laano, Kiristoosaa kahelamaro ammagamano tos taageennoonya. <verse eid="EPH 4:13"/><verse number="14" style="v" sid="EPH 4:14"/>Goortta taɂibaaddo miiggeeyi shirsanona sobaanjee kaɂekkaatero kashirisaro agaalssisii ambbal iriggadoyi hasserraa hittarraa shafamere kaɂiyaaro yiis aani lakkolleenno. <verse eid="EPH 4:14"/><verse number="15" style="v" sid="EPH 4:15"/>Haa kallaarokko rummi geelanjeeyi ayeesaa kaɂameen dubbaan mete kalleero Kiristoosa tos jiinayinanna. <verse eid="EPH 4:15"/><verse number="16" style="v" sid="EPH 4:16"/>Kalekaleekki kamaaree mikitajjool kakkoɂeselara Kiristoosaya; maar dubba kakkoɂabamera mikitaalkeessayiya; haanssun mete metee kamaaree mikita usuun osisameeraan felo gofello maar dubba jiinatara; geelanjjeenna dhaabbatara.<note caller="-" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="COL 2:19">K'ol. 2:19</ref>.</char></note><verse eid="EPH 4:16"/></para>
  <para style="s1">Kiristoosa kahelamaro kaɂusubkki giri</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17"/>Goortta yaadakiso addakki kalleero Ayizaab aani aroogirtten ame mege kagoottayi seerara; <verse eid="EPH 4:17"/><verse number="18" style="v" sid="EPH 4:18"/>Sammuutiso duuddetta; malabanowaattinna t'iibbettisookotti aalanttii Waa kasisaro girikko fakkimeraan. <verse eid="EPH 4:18"/><verse number="19" style="v" sid="EPH 4:19"/>Iso mulla mankkowaaten maraan battiikki ayees dubba felin isiɂoottisoo halchcha kasooyetun roorissateen sisateen.<verse eid="EPH 4:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 4:20"/>Isin goɂameen Kiristoosa kakkoɂaddeesseettan hikka aankkikki raadii lakkoyo. <verse eid="EPH 4:20"/><verse number="21" style="v" sid="EPH 4:21"/>Ogiraan garakkeessa maaltteettan; Yesuusa tagitto rummina usukko agaalsattettaan. <verse eid="EPH 4:21"/><verse number="22" style="v" sid="EPH 4:22"/>Haanssun sobere c'ubbo tos kageesaro halchcha kameellan t'ayteen kakkogitteen, tadoɂantti met't'akotti yadalii tira.<note caller="-" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="COL 3:9">K'ol. 3:9</ref>. </char></note> <verse eid="EPH 4:22"/><verse number="23" style="v" sid="EPH 4:23"/>Sammutisinna wodanattisin haɂusubaatto. <verse eid="EPH 4:23"/><verse number="24" style="v" sid="EPH 4:24"/>Karrummii muc'c'iɂamanona k'ullummaa masuussa kawaayi kamet't'aamero kaɂusubkki maar sarssayeene.<note caller="-" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="GEN 1:26">Met'. 1:26</ref>; <ref loc="COL 3:10">K'ol. 3:10</ref>.</char></note><verse eid="EPH 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25"/>Haanssun t'ara arooɂayeesseen; no dubbana maarkokki mikitaal mankkolleeren maraan isiɂisiɂorroo rummi ayeenssa.<note caller="-" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="ZEC 8:16">Zak. 8:16</ref>.</char></note> <verse eid="EPH 4:25"/><verse number="26" style="v" sid="EPH 4:26"/>Hadisa! Ayesuun goɂameen, «C'ubbo aroofeltteen» goggoɂamameroo, isin iɂootteen giraan arriti arooɂiinno.<note caller="-" style="x"><char style="xo" closed="false">4:26 </char><char style="xt" closed="false"><ref loc="PSA 4:4">Mez. 4:4</ref>.</char></note> <verse eid="EPH 4:26"/><verse number="27" style="v" sid="EPH 4:27"/>Durrisa kakkotabiro banɂe aroossisseen. <verse eid="EPH 4:27"/><verse number="28" style="v" sid="EPH 4:28"/>Hetaa kagire hittakko horenbbaan arooheto; haa kallaarokko karrakkatewun sisin maragade goggowaattamonkko genetteessa kaɂidankki ayees hafele. <verse eid="EPH 4:28"/><verse number="29" style="v" sid="EPH 4:29"/>Hiɂittisinkko kameellan ayees duuddo aroobbeenno; ayesuun goɂameen omaalaraawun kageggelaayisirona muc'c'isin kagarggaarro ibaaddowunna kadootisaro haafura ayeesaa. <verse eid="EPH 4:29"/><verse number="30" style="v" sid="EPH 4:30"/>Wodoo takkobeyaattan arrii ato isinuun goggolleeroo kakkoɂattamantteettan Ayyaana kawaa arook'uk'amisseen. <verse eid="EPH 4:30"/><verse number="31" style="v" sid="EPH 4:31"/>Okokonjjee, amaraan, iɂoo, iyya, habaarnna, maamisitti meellanena dubba isinkko fakki haɂantto. <verse eid="EPH 4:31"/><verse number="32" style="v" sid="EPH 4:32"/>Haa kallarokko isin isisiɂorroo oɂidanɂina shugonɂi onenɂeeyisaattan laa; Waa Kiristoosaa haheso isin goggoɂamiroo isinna isiɂisiɂorroo haheso ama.<note caller="-" style="x"><char style="xo" closed="false">4:32 </char><char style="xt" closed="false"><ref loc="COL 3:13">K'ol. 3:13</ref>.</char></note><verse eid="EPH 4:32"/></para>
  <chapter eid="EPH 4"/>
  <chapter number="5" style="c" sid="EPH 5"/>
  <para style="s1">Ifaa orroo girano</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1"/>Goortta kageelaamero yiis aani isinna masuussa kawaayi sesseen. <verse eid="EPH 5:1"/><verse number="2" style="v" sid="EPH 5:2"/>Kiristoosa no goggogeelateroo Waa kageeggelayisiro taɂidantti urit kaɂabo meebaanna jaarsso yele girikeessa no maraan roorisate goggosisateroo isinna geelanjjee gira.<note caller="-" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="EXO 29:18">Biy. 29:18</ref>; <ref loc="PSA 40:6">Mez. 40:6</ref>.</char></note><verse eid="EPH 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3"/>Hikka aankkikki ayees k'ullooleewun mankkodootisoon maraan sharmmut'umma goorttun maamisikki kabattoye kookona goorttun gap'igap'aano duuddo isin dollee aroomaalssamo. <verse eid="EPH 5:3"/><verse number="4" style="v" sid="EPH 5:4"/>Haa kallaattankko Waawun galata sisa kuwaarre kak'uk'amisirona kagowummaa ayees, goorttun kak'oos ayees ayeesano lakkodootisaro; hikka aankkikki ayees isinuun lakkodootisaro. <verse eid="EPH 5:4"/><verse number="5" style="v" sid="EPH 5:5"/>Sharmmut'umma golleetena, maamisikki battiikki ayees kafelero gollee, goorttun tolchcha hedoyisatanona gap'igap'aano gollee, Kiristoosaanna wononnati kawaayi rittii kahelannon laano addeesa.<verse eid="EPH 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 5:6"/>Hikka ayeeskkotti aalanttii kaɂajajaamon ibaaddo gutii engge tawaa mankkoɂemeeyinatto maraan maayona kamaaddinon ayeesii isin aroosobo. <verse eid="EPH 5:6"/><verse number="7" style="v" sid="EPH 5:7"/>Haanssun hikka kaɂajajaamon ibaaddone wota aroo leeteen. <verse eid="EPH 5:7"/><verse number="8" style="v" sid="EPH 5:8"/>T'ayteen isin mugudii gitteen; gidda goɂameen ogootta mankkolleeten maraan ifattaan; Haanssun ifaa kagiro ibaaddo aani sesseeyene. <verse eid="EPH 5:8"/><verse number="9" style="v" sid="EPH 5:9"/>Taɂifa il idanee, k'ullummanna rummii dubba dollee gitta. <verse eid="EPH 5:9"/><verse number="10" style="v" sid="EPH 5:10"/>Haanssun Goottaa kageggelaayisira ayees meyyo k'ok'k'ora. <verse eid="EPH 5:10"/><verse number="11" style="v" sid="EPH 5:11"/>Ifa tos beesaddeen tusa kuwaarre il kallayinɂi omugudi felone wota maamisitti esellana aroogginno. <verse eid="EPH 5:11"/><verse number="12" style="v" sid="EPH 5:12"/>Mugudii kagira ibaaddo siyame kafelaro ayees ayeesin mullaara. <verse eid="EPH 5:12"/><verse number="13" style="v" sid="EPH 5:13"/>Kaɂameen dubba ifaa tos gobeero tarummi middi diidaa bee mutatta. <verse eid="EPH 5:13"/><verse number="14" style="v" sid="EPH 5:14"/>Aalanttina ayees dubba goggomutiroo kayelara ifaya; haanssun,</para>
  <para style="q1" vid="EPH 5:14">«Ati kahudduratta nabbaadina!</para>
  <para style="q2" vid="EPH 5:14">Goyikko ki Kiristoosa kuun haank'ayisinara» amamera.<verse eid="EPH 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15"/>Goortta misii girnnattaan isiɂoorayeen shaada; k'arumma kaɂabo aani kuwaarre gowolee aani aroogirtten. <verse eid="EPH 5:15"/><verse number="16" style="v" sid="EPH 5:16"/>Hikki gees kameellankki mankkollee maraan maagoreenna taɂeselatto esellaa laɂo biyaa.<note caller="-" style="x"><char style="xo" closed="false">5:16 </char><char style="xt" closed="false"><ref loc="COL 4:5">K'ol. 4:5</ref>.</char></note> <verse eid="EPH 5:16"/><verse number="17" style="v" sid="EPH 5:17"/>Haanssun feɂi tawaa metto shaada kuwaarre gowolee aroolleeten.<verse eid="EPH 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EPH 5:18"/>Ayyaanaa ammagama kuwaarre t'amo kawooyiniiti aroosetiteen, hikkina darɂaatanoya. <verse eid="EPH 5:18"/><verse number="19" style="v" sid="EPH 5:19"/>Mazamurinna hedoyisatanoo, kaɂayyaana yaaye isi isiɂorroo ayeesaa; wodanattisinii Goottaa galataa. <verse eid="EPH 5:19"/><verse number="20" style="v" sid="EPH 5:20"/>Goottakkaani Yesuusa Kiristoosakokki megee kaɂameen dubbaawun Waa odo arggetto sommaasayeen.<note caller="-" style="x"><char style="xo" closed="false">5:20 </char><char style="xt" closed="false"><ref loc="COL 3:16-17">K'ol. 3:16-17</ref>.</char></note><verse eid="EPH 5:20"/></para>
  <para style="s1">Kaɂoorinna kaɂenttereekokki gara</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21"/>Takirisitoosa kabajaan amaddeene isiɂisi orroo koo kakkaleetun ajajaama.<verse eid="EPH 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22"/>Isin oorijool! Goottaa Yesuusaan goggoɂajajaamattaan malee entterjjoolkkisinunna ajajaama.<note caller="-" style="x"><char style="xo" closed="false">5:22 </char><char style="xt" closed="false"><ref loc="COL 3:18">K'ol. 3:18</ref>; <ref loc="1PE 3:1">1 P'et. 3:1</ref>.</char></note> <verse eid="EPH 5:22"/><verse number="23" style="v" sid="EPH 5:23"/>Kiristoosa min kawaa mete goggolleeroo entternna ooriwun meteya; adena Kiristoosan maar kakkoleeron min kawaakokki fayyinnaya. <verse eid="EPH 5:23"/><verse number="24" style="v" sid="EPH 5:24"/>Min kawaa Kiristoosan goggoɂajajaamaroo usumalee oorijool kaɂameen dubbaa entterjjolun haɂajajaame.<verse eid="EPH 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25"/>Isin entterjjolnna! Kiristoosa min kawaa goggogeelateronna isiɂoottessa roorisate goggosisateroo isinna oorijoolkisin geelayene.<note caller="-" style="x"><char style="xo" closed="false">5:25 </char><char style="xt" closed="false"><ref loc="COL 3:19">K'ol. 3:19</ref>; <ref loc="1PE 3:7">1 P'et. 3:7</ref>.</char></note> <verse eid="EPH 5:25"/><verse number="26" style="v" sid="EPH 5:26"/>Kiristoosa hikka kakkoonyelera min kawaa muc'c'isin dootereyya; kakkomuc'c'iserana gara kahaafurane bekeeyi aalisereya. <verse eid="EPH 5:26"/><verse number="27" style="v" sid="EPH 5:27"/>Hikka garaayi min kawaa t'ork'k'e goorttun hore meelilisano goorttun hikka aankkikki kakkalee kameellan ayees hamutooni k'ulluutti, koonna ayees kallayittina taɂidantti yelate isi tos gabbalatara. <verse eid="EPH 5:27"/><verse number="28" style="v" sid="EPH 5:28"/>Usumaleenna entterjjol isiɂoottisoo goggogeelatarankki malee oorijoolkisoo geelatano dootisara; ooritteessa kageelaatara isiɂoottessa geelaatara. <verse eid="EPH 5:28"/><verse number="29" style="v" sid="EPH 5:29"/>Maarkkeessa kadiidara maayona laagiro; duuddowa Kiristoosa min kawaatun goggoyelarokki malee isiɂoottessa aamisatara; karkkaraatara. <verse eid="EPH 5:29"/><verse number="30" style="v" sid="EPH 5:30"/>Noonna kakiristoosa maarkokki mikitajjoolnna. <verse eid="EPH 5:30"/><verse number="31" style="v" sid="EPH 5:31"/>Haanssun ibaaddo Aabbokkeessana Aayetteessana iisere, oorine wota k'urannaamaran; lama dubbana maar koo laaran.<note caller="-" style="x"><char style="xo" closed="false">5:31 </char><char style="xt" closed="false"><ref loc="GEN 2:24">Met'. 2:24</ref>.</char></note> <verse eid="EPH 5:31"/><verse number="32" style="v" sid="EPH 5:32"/>Hitti hool taɂatii hooltta; hikkana kaɂamara Kiristoosa maraanna min kaɂebi maraan masuussa yelereya. <verse eid="EPH 5:32"/><verse number="33" style="v" sid="EPH 5:33"/>Ayesuun goɂameen hikki ayees isinna fakkaatara; haanssun entter oori isiɂoottessa aani yelayire hageelaato; oorina entterkisee hakabajiito.<verse eid="EPH 5:33"/></para>
  <chapter eid="EPH 5"/>
  <chapter number="6" style="c" sid="EPH 6"/>
  <para style="s1">Oɂumuleeraanna yiiskokki gara</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1"/>Yiiso! Isin oɂumuleeraawun Goottaayi ajajaama; hikki kadootisaroya.<note caller="-" style="x"><char style="xo" closed="false">6:1 </char><char style="xt" closed="false"><ref loc="COL 3:20">K'ol. 3:20</ref>.</char></note> <verse eid="EPH 6:1"/><verse number="2" style="v" sid="EPH 6:2"/>«Aabbokkaanna Aayettanna kabajiina» kaɂamara ajaja kaɂabddii haafura kakkogira kahoraarjjee ajajaya. <verse eid="EPH 6:2"/><verse number="3" style="v" sid="EPH 6:3"/>Hikka kaɂabddii haafurana, «Kaɂameen dubba ekkaarowa; hikka uliinna geeskakka eeraarowa» kaɂamaroya.<note caller="-" style="x"><char style="xo" closed="false">6:3 </char><char style="xt" closed="false"><ref loc="EXO 20:12">Biy. 20:12</ref>; <ref loc="DEU 5:16">Ada. 5:16</ref>.</char></note><verse eid="EPH 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 6:4"/>Oɂumultteettaanna! Isinna Goottaa Yesuusaa woga agaalssisanoyi, tukkul umisaanna hadisaa jiinasa kuwaarre yiiskisin iɂooyi aroomararisseen.<note caller="-" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="COL 3:22-25">K'ol. 3:22-25</ref>.</char></note><verse eid="EPH 6:4"/></para>
  <para style="s1">Goottajjoolnna diyyijjoolkokki gara</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5"/>Isin diyyijjool! Kiristoosan goggoɂajajaamattaani ulii goottolee olleeraanun kabajaayinna abssii, wodana tukkulttii ajajaama. <verse eid="EPH 6:5"/><verse number="6" style="v" sid="EPH 6:6"/>Isitusayinna isoo dollee saadamiin alleenon giraan kakiristoosa diyyijjool aani feɂi tawaa wodanakko felin ajajaama. <verse eid="EPH 6:6"/><verse number="7" style="v" sid="EPH 6:7"/>Ibaaddo anlleennon giraan Goottawun kahandaattan laano addeesaddeen feɂittisinii wodanakko handdaa; <verse eid="EPH 6:7"/><verse number="8" style="v" sid="EPH 6:8"/>Aalanttina, diyyina leere balchchakki ibaaddo kafelaro kaɂidankki ayees dubba barɂaara Goottakko kaɂatayinnaro laano kassanwa.<verse eid="EPH 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9"/>Isin goottolee! Ibaaddo hore kaɂululisoon kakkisinna kakkiso Goottaa daruurii kagiro shaadaa; abissiisano iisaddeene diyyiilkisinun idane fela.<note caller="-" style="x"><char style="xo" closed="false">6:9 </char><char style="xt" closed="false"><ref loc="DEU 10:17">Ada. 10:17</ref>; <ref loc="COL 3:25">K'ol. 3:25</ref>; <ref loc="COL 4:1">4:1</ref>.</char></note><verse eid="EPH 6:9"/></para>
  <para style="s1">Kawaa huu kajereene</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10"/>Goortta kagootta kaɂatii hunnaa ataayeen. <verse eid="EPH 6:10"/><verse number="11" style="v" sid="EPH 6:11"/>Odurrisa felo omiiggee neebaayin goggodanddeetawun kawaa huu kajereene dubba sarssayeene. <verse eid="EPH 6:11"/><verse number="12" style="v" sid="EPH 6:12"/>No jereen kanneshafayinanna ibaaddone wota anlleennon giraan hikka kamugudi geesii ofelaraan mootijjolnnee, odonnati oɂabaannena hikka alamikokki hunnajjoolnne goorttun hikka amano daruurii ogiraan battiikki ayyaanajjolnne wotaya. <verse eid="EPH 6:12"/><verse number="13" style="v" sid="EPH 6:13"/>Haanssun tameellan arri hunna kadiina awodayiin goggodanddeetanunna kaɂameen dubbana gudisiddeene ataayi aallin goggodanddeetanun kawaa huu kajereene dubba abayeen.<verse eid="EPH 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 6:14"/>Goortta rummi zinnaara aani mooɂootisin mowayeeddeene, k'ullumma laala aani sarssayenddeene,<note caller="-" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="ISA 11:5">Isa. 11:5</ref>; <ref loc="ISA 59:17">59:17</ref>.</char></note> <verse eid="EPH 6:14"/><verse number="15" style="v" sid="EPH 6:15"/>kanogoddaa wongala keferro aani luk'k'aɂoottisinii tabssayeenddeen ekkaasayen aallaa.<note caller="-" style="x"><char style="xo" closed="false">6:15 </char><char style="xt" closed="false"><ref loc="ISA 52:7">Isa. 52:7</ref>.</char></note> <verse eid="EPH 6:15"/><verse number="16" style="v" sid="EPH 6:16"/>Hikka dubbakkona eleen aani baldabalda taɂamatto tadurrisa dukutto dubba baasin kakkodaanddetaan ammano wontte aani k'eenffayeen. <verse eid="EPH 6:16"/><verse number="17" style="v" sid="EPH 6:17"/>Fayyinna tamete gulle aani metekisinii kaayen; usumaleenna Ayyaana K'ulluukikko kahelamaro shiifa usuna haafura kawaa abayeen.<note caller="-" style="x"><char style="xo" closed="false">6:17 </char><char style="xt" closed="false"><ref loc="ISA 59:17">Isa. 59:17</ref>.</char></note> <verse eid="EPH 6:17"/><verse number="18" style="v" sid="EPH 6:18"/>Arggetto Ayyaana K'ulluukki k'ajeelaa ebina galata sisa. Hikka garaayinna Waa kak'ullooyisero ibaaddo maraan nabbaadaddeenna ataayeenddeen ebaayen. <verse eid="EPH 6:18"/><verse number="19" style="v" sid="EPH 6:19"/>Hool tawongala abissi kallayi goggofurroo, kakkoɂayeesaro gooratana kadootamara haafura goggosisamiroo iinna ebaayen. <verse eid="EPH 6:19"/><verse number="20" style="v" sid="EPH 6:20"/>Giddanna sanssalataa shiyaamere ani hikka kawongala handdaa kageggeyisaroya. Haanssun iin goggodootisaroo abissi kallayi goggoɂayeesiroo iin ebaayen.<verse eid="EPH 6:20"/></para>
  <para style="s1">Gudiskotti nogodda</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21"/>Meyii orroo girona me ani felaro goggoɂaddeessawun kageelaamera abbikkaanina Goottaayi kaɂabddamera kahandaaro kalleera Tikik'oosa kaɂameen dubba isinuun segirowa.<note caller="-" style="x"><char style="xo" closed="false">6:21 </char><char style="xt" closed="false"><ref loc="ACT 20:4">Ofa. Fe. 20:4</ref>; <ref loc="2TI 4:12">2 T'im. 4:12</ref>.</char></note> <verse eid="EPH 6:21"/><verse number="22" style="v" sid="EPH 6:22"/>Haanssun no misii ginno goggomalabttanunna isinna goggoɂataayisiroon amere usu isin tos ani farera.<note caller="-" style="x"><char style="xo" closed="false">6:22 </char><char style="xt" closed="false"><ref loc="COL 4:7-8">K'ol. 4:7-8</ref>.</char></note><verse eid="EPH 6:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23"/>Waa odokkona Goottaa Yesuusa Kiristoosakko nogoddana, geelanjje, ammanone wota abbilaalun halleeto. <verse eid="EPH 6:23"/><verse number="24" style="v" sid="EPH 6:24"/>Tanbbaanon geelanjjee Goottakkaani Yesuusa Kiristoosa ogeelaataraawun dubbaan sino isoon halleeto.<verse eid="EPH 6:24"/></para>
  <chapter eid="EPH 6"/>
</usx>
