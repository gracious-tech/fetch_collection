<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Bayso New Testament</book>
  <para style="h">Matoosa</para>
  <para style="toc1">Matoosa kas'aafero Goottaakkaanki kayesuusa Kiristoosa wongala</para>
  <para style="toc2">Matoosa</para>
  <para style="toc3">Mat.</para>
  <para style="mt1">Matoosa Kas'aafero</para>
  <para style="mt2">Goottaakkaanki Kayesuusa Kiristoosa Wongala</para>
  <para style="imt">Tabano</para>
  <para style="ip">Kamatoosa wongala, tayesuusa emeetokotti abddi t'aye kasegaamera usu kafayyisaro laanona Waa ammato ot'awooyi gosakkeessaan kasisero kaɂabddii haafura kakkofelera garakkeessane laano kasegaaro kageggeloo haafuraya. Hikki kageggeloo haafurana Yesuusa isoo orroo alatere kakkojiinatero Ayihuudi kaalaalun anlleennon giraan alami dubbaawunna adereya.</para>
  <para style="ip">Kamatoosa wongala iide diyaame kaɂekkaatero mas'aafaya; tayesuusa alattankko haggaɂabere t'ammak'amano kakkeessakoki garana c'aafamanokkeessakoki gara sessegee abbaabatere Galiilaayi usu kalallabeero lallabaano, agaalssisanona fayyiisanokokki handdaano sessegaara. Hassukko abbaabatere ade Yesuusa kagaliila ulkko Iyyerusaalemikotti katamaa tos tasesseetero sesseettanna hikka alamii kakkoɂadallaatero geeskokki kagachchoo almmaayi kalleero ayees sessegaara; hikki ayeenssa suwaamanokkeessa, goyikkeessana goyikko kiyaanokkeessa wota raattoo abara.</para>
  <para style="ip">Hikki wongala Yesuusa seera kawaa fureen sisin odonnati kaɂabo laanona wononnati kawaakokki gara kaɂagaalssisaro kanjjinkki yele tusara. Agaalssisikkeessakko gama kahori raa kamoogganii kaɂekkaatera banɂe kennii tootaamara;</para>
  <para style="ip">1. Wononnati kawaakki ibaaddokotti yadalii, feloo, feɂi, hunnominna tagachchoo it'aa kaɂagaalssisaro kawodamii lallabaano, (foolssi 5-7).</para>
  <para style="ip">2. Tomonkko lama Yesuusakko oɂagaalssatareen kawongala lallabaanoon kakkofaramareen goorata isoon kasisamere seeral, (foolssi 10).</para>
  <para style="ip">3. Wononnati kawaakokki garaan kasegaamero kalekaleekki masuussajjool; (foolssi 13).</para>
  <para style="ip">4. Yesuusakko oɂagaalssataran laanokotti fureen kasegaaro agaalssis, (foolssi 18).</para>
  <para style="ip">5. Gees kagiddaneekotti gachchona wononnati kawaa emeetokokki garaan kasisamero agaalssis; (foolssi 24-25).</para>
  <para style="iot">Raattoo Hikki Mas'aafa Kaɂabera</para>
  <para style="io1">Yesuusa Kiristoosakokki kasanni hididinna alattaan <char style="ior"><ref loc="MAT 1:1-2:23">1:1—2:23</ref> </char></para>
  <para style="io1">Kat'ammak'aaro Yaannisakokki handdaano <char style="ior"><ref loc="MAT 3:1-12">3:1-12</ref> </char></para>
  <para style="io1">Yesuusakokki t'ammak'amanona c'aafamano <char style="ior"><ref loc="MAT 3:13-4:11">3:13—4:11</ref> </char></para>
  <para style="io1">Yesuusa feloɂootteessa Galiilaayi haggaɂabano <char style="ior"><ref loc="MAT 4:12-18:35">4:12—18:35</ref> </char></para>
  <para style="io1">Galiilakko Iyyerusaalemi tos <char style="ior"><ref loc="MAT 19:1-20:34">19:1—20:34</ref> </char></para>
  <para style="io1">Kagachchoo almmaayi Iyyerusaalemiinna gobobikiseeyi <char style="ior"><ref loc="MAT 21:1-27:66">21:1—27:66</ref> </char></para>
  <para style="io1">Goottakkaanikki goyikko kiyaanona usukko oɂagaalssatarawun mutano <char style="ior"><ref loc="MAT 28:1-20">28:1-20</ref> </char></para>
  <chapter number="1" style="c" sid="MAT 1"/>
  <para style="s1">Tayesuusa Kiristoosa alattaankokki hidiid</para>
  <para style="r">(<ref loc="MAT 1:1-17">Mat. 1:1-17</ref>; <ref loc="LUK 3:23-38">Luk'. 3:23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1"/>Tadaawutena taɂabraame sannii kalleero kayesuusa Kiristoosa alattankkokki hididi haaya; <verse eid="MAT 1:1"/><verse number="2" style="v" sid="MAT 1:2"/>Abraame Yissaak'a umule, Yissaak'a Yayik'ooba umule, Yayik'ooba Yihuudana abbilaal umule, <verse eid="MAT 1:2"/><verse number="3" style="v" sid="MAT 1:3"/>Yihuudana Tiɂimaarkko Faaresina Zaara umule, Faaresi Esiroomi umule, Esiroomina Araam umule, <verse eid="MAT 1:3"/><verse number="4" style="v" sid="MAT 1:4"/>Araamina Aminadaabi umule, Aminadaabina Neɂasooni umule, Neɂasoonina Selemooni umule, <verse eid="MAT 1:4"/><verse number="5" style="v" sid="MAT 1:5"/>Selmoonina Reɂaabkko Boɂeezi umule, Boɂeezina Ruutikko Iyobed umule, Iyobdina Isseyi umule, <verse eid="MAT 1:5"/><verse number="6" style="v" sid="MAT 1:6"/>Isseyi wono Daawute umule,<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="RUT 4:18-22">Uru. 4:18-22</ref>; <ref loc="1CH 2:13-15">1 Od. 2:13-15</ref>.</char></note> Daawutenna taɂooryo oorikko Solomooni umule, <verse eid="MAT 1:6"/><verse number="7" style="v" sid="MAT 1:7"/>Solomoonina Robiɂami umule, Robiɂamina Abiya umule, Abiyanna Aasafi umule, <verse eid="MAT 1:7"/><verse number="8" style="v" sid="MAT 1:8"/>Aasafina Iyosafit'i umule, Iyosafit'ina Iyohorami umule, Iyohoramina Oziyaani umule, <verse eid="MAT 1:8"/><verse number="9" style="v" sid="MAT 1:9"/>Oziyaanina Iyoɂataami umule, Iyoɂataamina Akkaazi umule, Akkaazi Hizk'iyaasa umule, <verse eid="MAT 1:9"/><verse number="10" style="v" sid="MAT 1:10"/>Hizik'iyaasa Minaase umule, Minaase Amoos'i umule, Amoos'ina Iyosiyaasi umule, <verse eid="MAT 1:10"/><verse number="11" style="v" sid="MAT 1:11"/>Iyosiyaasi gosa kaɂisiraɂeel Baabloni tos kakkobojaamere goorata Ikkoniyaanina Abbilaal umule.<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="2KI 24:14-15">2 Won. 24:14-15</ref>; <ref loc="2CH 36:10">2 Od. 36:10</ref>; <ref loc="JER 27:20">Erm. 27:20</ref>.</char></note><verse eid="MAT 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12"/>Kabbabilooni boojaamanokko abbaabatere Ikkoniyaan Selaatiyaali umule, Selaatiyaanina Zurbbaabeela umule, <verse eid="MAT 1:12"/><verse number="13" style="v" sid="MAT 1:13"/>Zurbbaabeela Abiyuudi umule, Abiyuudina Elyaak'emi umule, Elyaak'emina Azaari umule, <verse eid="MAT 1:13"/><verse number="14" style="v" sid="MAT 1:14"/>Azaari Sadook'i umule, Sadook'i Akiim umule, Akiimina Elyuud umule, <verse eid="MAT 1:14"/><verse number="15" style="v" sid="MAT 1:15"/>Elyuud Alaazari umule, Alaazari Maatani umule, Maatani Yayik'ooba umule, <verse eid="MAT 1:15"/><verse number="16" style="v" sid="MAT 1:16"/>Yayik'ooba Yoosefa umule, Yoosefana kafayyisaro Kiristoosa Yesuusakotti Aaye Mayiraame kaɂeerateroye.<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false">Mesihi, </char><char style="ft" closed="false">Kiristoosa amano Mesihi goorttun kashigidame amanoya. </char></note><verse eid="MAT 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17"/>Goortta Abraamekko taa Daawute geeron alattaan tomonkko afartta, Daawutekko taa kabbaabilooni boojaamano geeron alattaan tomonkko afartta; kabbaabilooni boojaanokko taa takiristoosa alattaan geeron alattaan tomonkko afartta.<verse eid="MAT 1:17"/></para>
  <para style="s1">Alattaan tayesuusa Kiristoosa</para>
  <para style="r">(<ref loc="MAT 1:18-25">Mat. 1:18-25</ref>; <ref loc="LUK 2:1-7">Luk'. 2:1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18"/>Tayesuusa Kiristoosa alattankkotti jirtti hikkamaleetta, Aayetteessa Mayiraame Yoosefaan eeraanttegudde haɂeseloon Ayyaana K'ulluukkii fato tootaatte mutte.<note caller="-" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="LUK 2:1-7">Luk'. 2:1-7</ref>.</char></note> <verse eid="MAT 1:18"/><verse number="19" style="v" sid="MAT 1:19"/>Ese kaɂeeraatera Yoosefa k'ajeelakki ibaaddoti mankkolleero maraan Mayiraame ibaaddo horee fanchoyisiin mankkodooton maraan haɂaddeesisoon iisin murtteesse.<verse eid="MAT 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20"/>Usu goɂameen hikka k'oppaa giraan kagootta erggichcha hisillooyi usuun mute, haanna ame, «Sannii tadaawute kalleetetta Yoosefa, taɂeerattetto Mayiraame atayi oori yelayiin arooɂabssatte aalanttina ese kakkottotaatetta k'ulluukki ayyaanakkoyya. <verse eid="MAT 1:20"/><verse number="21" style="v" sid="MAT 1:21"/>Babbaartitinna umulnatta, megekkeessana Yesuusa<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="ft" closed="false">Heɂi taɂibrayist'ii «Yesuusa» amano kafayyisaro Goottaa amanoya. </char></note> ami uumnatta; aalanttina usu gosakkeessa c'ubbokkisookko mankkohaasinaro maraanya.»<note caller="-" style="x"><char style="xo" closed="false">1:21 </char><char style="xt" closed="false"><ref loc="LUK 1:3">Luk'. 1:3</ref>.</char></note><verse eid="MAT 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22"/>Goottaa gara kahegeroonne haa ame kaɂayeesera felooyi goggohayiroon amegure hikki dubba lee. <verse eid="MAT 1:22"/><verse number="23" style="v" sid="MAT 1:23"/>«Hikkina, deeleeltiti fato tootaayinatta babbaartitina umulnatta megekkeessana amanuɂeeli amaminnara,» fureeninna «Waa noonne wota gira amanoyya.»<note caller="-" style="x"><char style="xo" closed="false">1:23 </char><char style="xt" closed="false"><ref loc="ISA 7:14">Isa. 7:14</ref>.</char></note><verse eid="MAT 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24"/>Yoosefana huddurokko nabbaade, esekkona kagootta erggichcha goggosegeeroyi Mayiraame oori yelayiin minkkeessa tos atate seete. <verse eid="MAT 1:24"/><verse number="25" style="v" sid="MAT 1:25"/>Halleewo kuwaarre erekkisee taaɂumulttooyi esene wota lakkohuddurero kaɂalatero yiittitina Yesuusa ame uume.<note caller="-" style="x"><char style="xo" closed="false">1:25 </char><char style="xt" closed="false"><ref loc="LUK 2:21">Luk'. 2:21</ref>.</char></note><verse eid="MAT 1:25"/></para>
  <chapter eid="MAT 1"/>
  <chapter number="2" style="c" sid="MAT 2"/>
  <para style="s1">Mina tabiyaankko oɂemeeteran barraajja ok'ok'k'oraraan</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1"/>Wono Herodoosa reede kakkogire geesii; Yesuusa tabeteleemi katamaayi kayihuuda ulii kakkoɂalatare goorata barraajja ok'ok'k'orareen mina tabiyaankko Iyyerusaalemi tos emetengureen, <verse eid="MAT 2:1"/><verse number="2" style="v" sid="MAT 2:2"/>Kayihuuda wono liin kaɂalatera yiittiti haggee gira? Mina tabiyaaninne bakkaala deennegunne usuun sagadin emeennenna ameen hoosaten.<note caller="-" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="JER 23:5">Erm. 23:5</ref>; <ref loc="ZEC 9:9">Zak. 9:9</ref>; <ref loc="NUM 24:17">To. 24:17</ref>.</char></note><verse eid="MAT 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3"/>Wono Herodoosa hikka ayees kakkomaalare goorata nee. Usumaleenna kaɂiyyerusaalemi ibaaddo dubba nee. <verse eid="MAT 2:3"/><verse number="4" style="v" sid="MAT 2:4"/>Usu katuuk'aamol woyichchaalnna seera kaɂayihuudi oɂagaalssisaran dubba kukkuyisere Kiristoosa haggee alayinaro hoosate.<verse eid="MAT 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5"/>Isona, «Kayihuuda ulii tagitto tabeteleemi katamaayiya;» kahegerooyi haa amame s'aafamera;<verse eid="MAT 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6"/>« ‹Ul kayihudaayi tagitta ati Beteleemi!</para>
  <para style="q2" vid="MAT 2:6">Kakkalee tayihuuda katamaalkko duuddo lakkoyeraatatto,</para>
  <para style="q2" vid="MAT 2:6">Gosakkee Isiraɂeel kafoofinara mootii kukko binnara ameen.› »<note caller="-" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="MIC 5:2">Mik. 5:2</ref>.</char></note><verse eid="MAT 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7"/>Esekkona Herodoosa barraajja ok'ok'k'orareen golise uumsegure ayeesisaa bakkaala kakkomutero likkiikki goorata hoosate maale. <verse eid="MAT 2:7"/><verse number="8" style="v" sid="MAT 2:8"/>Barraajja ok'ok'k'orareenna Beteleemi tos faregure «Seeyenguddeen yiittiti malaa doota, aninna adi seeyigure usuun goggosagadiroon usu goggoheltteeni in tos abbaabayiddeen eetii giro iin segaa» ame.<verse eid="MAT 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9"/>Barraajja ok'ok'k'orareenna wono kaɂamero maaleen abbaabatengureen sesseettan horeddeen. Hikkina mina tabiyaaninne kaddeeraan bakkaala raa k'ajeelisaa yiittiti mankkogiro banɂe geere aallee. <verse eid="MAT 2:9"/><verse number="10" style="v" sid="MAT 2:10"/>Bakkaalana kakkodiyaaren goorata aaloo geggelaaten. <verse eid="MAT 2:10"/><verse number="11" style="v" sid="MAT 2:11"/>Min orro kakkotabareen goorata yiittitina Aayetteessa Mayiraamene wota kagiro deen, gilbbisengureen sagadeen. Saat'inekisonna banatengureen work'k'ii, it'aanane, urit taɂidan kaɂabo k'ibaati siseen.<verse eid="MAT 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 2:12"/>Isona Herodoosa tos goggoɂabbaabanonkko Waa hisillooyi ataayise isoon mankkosegeero maraan raa iggilissateen ulkkisoo tos abbaabateen.<verse eid="MAT 2:12"/></para>
  <para style="s1">Gibs's'i tos bak'atano</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13"/>Barraajja ok'ok'k'orareen seeteen kakkobuwaaren goorata erggichcha kawaa Yoosefaan mutegure ki ati takkoɂabbaabatto arri ani kuun taa segiroon yiittiti Aayetteessane wota aati Gibs's'i tos bak'agudde esee giri. «Herodoosa yiittiti lagadin dootara» ame. <verse eid="MAT 2:13"/><verse number="14" style="v" sid="MAT 2:14"/>Haanssun usuna keegure yiittitina Aayetteessana aategure hemeen Gibs's'i tos seete. <verse eid="MAT 2:14"/><verse number="15" style="v" sid="MAT 2:15"/>Eseenna Herodoosa taaggooroo adallaate. Hikkaniinna «Erekkeena ul kagibs's'ikko uumaye» amaa Goottaa kahegerookotti hiɂii kaɂayeesera haafura feloo haye.<note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="HOS 11:1">Hos. 11:1</ref>.</char></note><verse eid="MAT 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16"/>Herodoosa barraajja ok'ok'k'orareen usu sobano addeesegure aaloo amaraate, barraajja ok'ok'k'orareen barraajja kakkomutero goorata goggosegeerankki malee gees lamana esekko hegelbbaan kalleero Beteleeminna usu gobobii kagiro maamanjolkokki babbaar yiis dubba kukkuyisere fare lagadisise. <verse eid="MAT 2:16"/><verse number="17" style="v" sid="MAT 2:17"/>Hassu goorata kahegeroo Ermaasaa haa amame kasegaamera feloo haye.<verse eid="MAT 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18"/>Kaɂoottaneenna kaɂatii iyyakkotti yaaye Ramaayi malssantte.</para>
  <para style="q2" vid="MAT 2:18">«Raheelinna Yiiskkisee maraan ootte,</para>
  <para style="q2" vid="MAT 2:18">Goggoɂinna yelayin lakkodaanddeete, aalanttina Yiiskkise mankkogoye maraanya.»<note caller="-" style="x"><char style="xo" closed="false">2:18 </char><char style="xt" closed="false"><ref loc="JER 31:15">Erm. 31:15</ref>.</char></note><verse eid="MAT 2:18"/></para>
  <para style="s1">Gibs's'ikko Naazireti tos abbaabatano</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19"/>Goyi kaherodoosakko abbaabatere kagootta erggichcha Yoosefaan hisillooyi mutegure, <verse eid="MAT 2:19"/><verse number="20" style="v" sid="MAT 2:20"/>«Kingudde yiittitina Aayetteessa aatigudde ul kaɂisiraɂeel abbaaba, yiittiti lagadin odootareen goyeeran» ame. <verse eid="MAT 2:20"/><verse number="21" style="v" sid="MAT 2:21"/>Yoosefana keegure yiittitina Aayetteessa aategure ul kaɂisraɂeel tos abbaabate. <verse eid="MAT 2:21"/><verse number="22" style="v" sid="MAT 2:22"/>Ayesuun goɂameen Arkkiloosa Aabbokkeessa Herodoosakkotti banɂee ul kayihudaa wono lee reedano kakkomaalare goorata Yoosefa eserraa seeyin abssate. Hisillooyi usuun kakkosegaamare goorata tagaliila awuraajjaa tos seete. <verse eid="MAT 2:22"/><verse number="23" style="v" sid="MAT 2:23"/>Naazireti taɂamamatto katamaa tos seetegure hamas's'ee. Hikkaniinna kahegerooli, «Kanaazireti amaminnara» amameen osegaameraan hegero felooyi hayeen.<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="ISA 11:1">Isa. 11:1</ref>; <ref loc="MRK 1:24">Mar. 1:24</ref>; <ref loc="LUK 2:39">Luk'. 2:39</ref>; <ref loc="JHN 1:45">Yan. 1:45</ref>.</char></note><verse eid="MAT 2:23"/></para>
  <chapter eid="MAT 2"/>
  <chapter number="3" style="c" sid="MAT 3"/>
  <para style="s1">Kat'ammak'aaro Yaannisakokki lallabaano</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mat. 3:1-12</ref>; <ref loc="MRK 1:1-8">Mar. 1:1-8</ref>; <ref loc="LUK 3:1-18">Luk'. 3:1-18</ref>; <ref loc="JHN 1:19-28">Yan. 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1"/>Usu goorata kat'ammak'aara Yaannisa kayihuuda k'alullattokki ulii lallabaa emete. <verse eid="MAT 3:1"/><verse number="2" style="v" sid="MAT 3:2"/>Lallabaanokkeessana, «Wononnati kadaruure gabbalamera c'ubbokko gula gala» kaɂamaroya.<note caller="-" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="MAT 4:17">Mat. 4:17</ref>; <ref loc="MRK 1:15">Mar. 1:15</ref>.</char></note><verse eid="MAT 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 3:3"/>Kahegeroo Isiyaasayi haa amame kasegaamera usuya,</para>
  <para style="q2" vid="MAT 3:3">«K'alullattokki ulii ‹Raa kawaanna ekkaasa bobbana tukkul umisa› amaa taɂokkaatto yaaye.»<note caller="-" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">Isa. 40:3</ref>.</char></note><verse eid="MAT 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4"/>Kayaannisa sarssina ogorro ogaalakko kafelamero golleero mooɂootteesayina gii mowatare. Babokkeesana kenttefarrona kagaado malabye.<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="2KI 1:8">2 Won. 1:8</ref>; <ref loc="ZEC 13:4">Zak. 13:4</ref>; <ref loc="LEV 11:22">Woy. 11:22</ref>.</char></note> <verse eid="MAT 3:4"/><verse number="5" style="v" sid="MAT 3:5"/>Iyyerusaalemikko, kayihuuda ul dubbakkona laga kayorddaanosi gobobii kagiro ulkko ibaaddo dubba Yaannisa tos guuramare. <verse eid="MAT 3:5"/><verse number="6" style="v" sid="MAT 3:6"/>C'ubbokkisokkona gula galaa laga kayorddaanosii genetteessaayi t'ammak'amaa gireen.<verse eid="MAT 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7"/>Farasaawilkkona Sodok'aawilkko kamooggan ibaaddo usu takkot'ammak'are banɂe kaɂemeetaro kakkodiyaare goorata haa ame, «Isin yiis kahabeessa taɂemaatto engge tawaakko goggohessaanun ayyoya isin kagorssee?<note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="MAT 12:34">Mat. 12:34</ref>; <ref loc="MAT 23:33">23:33</ref>.</char></note> <verse eid="MAT 3:7"/><verse number="8" style="v" sid="MAT 3:8"/>Goorttanun c'ubbokko gula galanokkisin otusaraan felo fela. <verse eid="MAT 3:8"/><verse number="9" style="v" sid="MAT 3:9"/>‹Abraame Aabbokkaaniya› taɂamattaan k'ofaayi isiɂoottisin aroosobatteen; Waa hikka eɂemoolkko Abraamen yiis keesin daanddaara.<note caller="-" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="JHN 8:33">Yan. 8:33</ref>.</char></note> <verse eid="MAT 3:9"/><verse number="10" style="v" sid="MAT 3:10"/>Goortta masaar kagaaddol hidiid goosin ekkaattetta, il taɂidan kadubamoon gaa dubba goosaminara; eleen orrona shafaminara.<note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="MAT 7:19">Mat. 7:19</ref>.</char></note><verse eid="MAT 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11"/>«Ani isin c'ubbokko gula mankko galtteettaan maraan bekeeyi t'ammak'inara, ayesuun goɂameen keferro oottessana sidin ani kadootisoon, inkko karooraro hunna kaɂaba inkko haarre emeetara. Usuna k'ulluukki ayyaanayinna eleenii isin t'ammak'inara. <verse eid="MAT 3:11"/><verse number="12" style="v" sid="MAT 3:12"/>Kakkobbanp'araanna genetteessaayi gira, addummaa basamigudde banp'aaminatta, darggammaanna gootaraayi kibaminatta, galabaa adde tabaanon eleenii gubaminnatta.»<verse eid="MAT 3:12"/></para>
  <para style="s1">T'ammak'amano kayesuusa</para>
  <para style="r">(<ref loc="MRK 1:9-11">Mar. 1:9-11</ref>; <ref loc="LUK 3:21-22">Luk'. 3:21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13"/>Hassu goorata Yesuusa gene tayaannisaa t'ammak'amin Galiilakko laga kayorddaanosi tos emete. <verse eid="MAT 3:13"/><verse number="14" style="v" sid="MAT 3:14"/>Yaannisa goɂameen, «Hikki haa liin lakkodaanddaaro, ani genettaayi t'ammak'amin dootisaa giraan ati misii in tos emaatta?» ame isi tirate.<verse eid="MAT 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15"/>Yesuusana, «Koonna lakkogiro ati ii ami, hikka felanooyi ok'ullumma felo dubba felano noon dootisara» ame. Yaannisana ayesuun ii ame.<verse eid="MAT 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16"/>Yesuusana goorsewa t'ammak'ame bekekko goggobeeyi daruurnna bananttegudde Ayyaana kawaa arabe aani usu gutii dagaa giraan dee. <verse eid="MAT 3:16"/><verse number="17" style="v" sid="MAT 3:17"/>Usu goorata, «Ani kakkogeggelayinara, ani kageelaatara erekki hikkaya» taɂamatta yaaye daruurkko maalssantte.<note caller="-" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="MAT 22:2">Mat. 22:2</ref>; <ref loc="PSA 2:7">Mez. 2:7</ref>; <ref loc="ISA 42:1">Isa. 42:1</ref>; <ref loc="MAT 12:18">Mat. 12:18</ref>; <ref loc="MAT 17:5">17:5</ref>; <ref loc="MRK 1:11">Mar. 1:11</ref>; <ref loc="LUK 9:35">Luk'. 9:35</ref>.</char></note><verse eid="MAT 3:17"/></para>
  <chapter eid="MAT 3"/>
  <chapter number="4" style="c" sid="MAT 4"/>
  <para style="s1">C'aafamano kayesuusa</para>
  <para style="r">(<ref loc="MRK 1:12-13">Mar. 1:12-13</ref>; <ref loc="LUK 4:1-13">Luk'. 4:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1"/>Hikkakko abbaabatere Ayyaana k'ulluukki Yesuusa durrisaa goggoc'aafamiro k'alullattokki ul tos aate bee.<note caller="-" style="x"><char style="xo" closed="false">4:1 </char><char style="xt" closed="false"><ref loc="HEB 2:18">Ibr. 2:18</ref>; <ref loc="HEB 4:15">4:15</ref>.</char></note> <verse eid="MAT 4:1"/><verse number="2" style="v" sid="MAT 4:2"/>Hemeen afarttamnna arri afarttam agabuukko abbaabatere uuɂee.<note caller="-" style="x"><char style="xo" closed="false">4:2 </char><char style="xt" closed="false"><ref loc="EXO 34:28">Biy. 34:28</ref>; <ref loc="1KI 19:8">1 Won. 19:8</ref>.</char></note> <verse eid="MAT 4:2"/><verse number="3" style="v" sid="MAT 4:3"/>Kac'aafarekkina Yesuusa tos gabbalamere «Ati ere kawaa golleete hikka eɂemool babo goggolleeroo ajajii» ame.<verse eid="MAT 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4"/>Yesuusana, «Ibaaddo hiɂi tawaakko kabiyaaro haafura dubbaa kuwaarre babo kaalaalii lakkogiraro amame mas'aafaa k'ulluukkii s'aafamera» ame abbaabe.<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="DEU 8:3">Ada. 8:3</ref>.</char></note><verse eid="MAT 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5"/>Adena durrisa Yesuusa k'ulluutti katamaa Iyyerusaalemi tos aate seetegure k'ulluukki min kawaayi birt'ee aate beegure,<note caller="-" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="NEH 11:1">Neh. 11:1</ref>; <ref loc="DAN 9:24">Dan. 9:24</ref>.</char></note><verse eid="MAT 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 4:6"/>«Ati ere kawaa golleete» «hegelddee issii firimi,</para>
  <para style="q2" vid="MAT 4:6">luk'aɂootta eɂemooyi goggohanduddufannonkko iso genettisooyi goggokeesinawun erggichchaal ku maraan ajajinara amame mas'aafa k'ulluukkii s'aafamera ame.»<note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PSA 91:11-12">Mez. 91:11-12</ref>.</char></note><verse eid="MAT 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7"/>Yesuusana, abbaabere, «Goottaa Hedokkaa arooc'aafite amame ade mas'aafa k'ulluukkii s'aafamera» ame abbaabe.<note caller="-" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="DEU 6:16">Ada. 6:16</ref>.</char></note><verse eid="MAT 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8"/>Adena, durrisa Yesuusa aaloo t'ok'k'i taɂantte wodamii korisegure alamikokki wonolaal kabajjatisoonne wota usuun tusegure, <verse eid="MAT 4:8"/><verse number="9" style="v" sid="MAT 4:9"/>«Ati in horee iigudde gilbbisi gosagadde hikka dubba ani kuun sisinnara ame.»<verse eid="MAT 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10"/>Yesuusana, «Ati s'alaye in horekko fakkiɂami! ‹Waa Hedokkaawun sagadi; usu kaalaalnna hedoyisa› amame mas'aafa k'ulluukkii s'aafamera» ame.<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="DEU 6:13">Ada. 6:13</ref>.</char></note><verse eid="MAT 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11"/>Esekkona durrisa iise seete; erggichchaalnna emeetegure usuun handdaye.<verse eid="MAT 4:11"/></para>
  <para style="s1">Yesuusa handdaano Galiilaa haggaɂabe</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12"/>Yesuusa shaamano kayaannisa maalere ul kagaliila tos abbaabate seete.<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="MAT 14:3">Mat. 14:3</ref>; <ref loc="MRK 6:17">Mar. 6:17</ref>; <ref loc="LUK 3:19-20">Luk'. 3:19-20</ref>.</char></note> <verse eid="MAT 4:12"/><verse number="13" style="v" sid="MAT 4:13"/>Tanaazireti katamaa iisegure; Zaabllooninna Nifittaaleemikotti awuraajjaayi tagaliila labu giridii tagitto tak'ifirenaahoomi katamaayi girano haggaɂabe.<note caller="-" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="JHN 2:12">Yan. 2:12</ref>.</char></note><verse eid="MAT 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 4:14"/>Hikkaniinna kahegeroo Isiyaasayi haa amameen osegaameran hegero feloo hayeen.<verse eid="MAT 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15"/>«Ul kazaabllooninna ul kanifittaaleemi, Yorddaanoskko gama</para>
  <para style="q2" vid="MAT 4:15">labu girii kagiro raa dollee kagaliila Ayizaab,<verse eid="MAT 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16"/>Mugudii kagire gosa</para>
  <para style="q2" vid="MAT 4:16">kaɂatii ifa dee;</para>
  <para style="q1" vid="MAT 4:16">Hoos tagoyii kagire ibaaddoonna</para>
  <para style="q2" vid="MAT 4:16">ifa bee.»<note caller="-" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="ISA 9:1-2">Isa. 9:1-2</ref>.</char></note><verse eid="MAT 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17"/>Hassu gooratakko haggaɂabere Yesuusa, «Wononnati kadaruuree gabbalamera c'ubbokko gula gala» ame lallabaano haggaɂabe.<note caller="-" style="x"><char style="xo" closed="false">4:17 </char><char style="xt" closed="false"><ref loc="MAT 3:2">Mat. 3:2</ref>.</char></note><verse eid="MAT 4:17"/></para>
  <para style="s1">Yesuusa kunɂub kaɂabatare ibaaddo afar uumano</para>
  <para style="r">(<ref loc="MRK 1:16-20">Mar. 1:16-20</ref>; <ref loc="LUK 5:1-11">Luk'. 5:1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18"/>Yesuusa tagaliila labu girndde rooraa giraan abbilaal lama P'et'iroosa kaɂamamaro Simoonanne abbikkeessa Indiraasane dee. Kunɂub oɂabatareen mankkoleen maraan maarrabitisoo bekerro lugudataa gireen. <verse eid="MAT 4:18"/><verse number="19" style="v" sid="MAT 4:19"/>Yesuusana «Koyeen indebee sesseeyeen» Ibaaddo wononnati kawaa tos goggokeenttanun ani isin yelnnara ame. <verse eid="MAT 4:19"/><verse number="20" style="v" sid="MAT 4:20"/>Goorsewa maarrabitisoo iiseengureen usuu debee sesseeteen.<verse eid="MAT 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21"/>Esekko goggorooreyi takkalee abbilaal lama ere kazabddoosa Yayik'oobana abbikkeessa Yaannisane dee. Aabbokkisoo Zabddoosane wota wolabo orroo maarrabitisoo ekkaasataa gireen; Yesuusana iso uume; <verse eid="MAT 4:21"/><verse number="22" style="v" sid="MAT 4:22"/>Goorsewa iso wolabottisonna Aabbokkisoo iiseen Yesuusa debee sesseeteen.<verse eid="MAT 4:22"/></para>
  <para style="s1">Yesuusa ibaaddo kamooggan agaalssisanona fayyiisano</para>
  <para style="r">(<ref loc="LUK 6:17-19">Luk'. 6:17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23"/>Yesuusana Ayihuudikokki min kaɂebii wononnati kawaakokki kageggeloo haafura agaalssisaanna lallabaa; gosa orroo kagiro maamisikki hawɂaamikkona maarii gutii tagitto rakkoo tamooggankko fayyiisaa kagaliila ul dubbaa maraamuraa gire.<note caller="-" style="x"><char style="xo" closed="false">4:23 </char><char style="xt" closed="false"><ref loc="MAT 9:35">Mat. 9:35</ref>; <ref loc="MRK 1:39">Mar. 1:39</ref>.</char></note><note caller="+" style="f"><char style="fr" closed="false">4:23 </char><char style="fqa" closed="false">Mikurabochi, </char><char style="ft" closed="false">amano ibaaddo takkokukkumaro banɂe golleeto, Ayihuudikokki min kaɂebi Mikuraab amamara. </char></note> <verse eid="MAT 4:23"/><verse number="24" style="v" sid="MAT 4:24"/>Hikkakko kakkeeyi ataankkeessa kasooriya ul dubbaa maalssame; gosana kalekaleekki hawɂaami hawɂaamaa kagirena; maar orrookki hawɂaami kameellanii abboosamaren; durrisa gutii kakkogirena kagaggadduu hawɂaami oɂabanaayen; naafaleessaal dubba usu tos keenen; usuna iso fayyiise. <verse eid="MAT 4:24"/><verse number="25" style="v" sid="MAT 4:25"/>Hikkakko kakkeeyi; Galiilakkona, katamaa tomonkko Iyyerusaalemikko, Yihuudakona, laga kayorddaanosi gamakko kaɂemeetera kamooggan ibaaddo Yesuusaa debee sesseete.<note caller="+" style="f"><char style="fr" closed="false">4:25 </char><char style="fqa" closed="false">Katamaal tomon, </char><char style="ft" closed="false">heɂi tagirikkii oɂayeesaranna Ayihuudi kalleenoon gosa raattoo takkogiro banɂe katamaal tomon amamatta. Hikki katamaal gama kahori kakkogiraan ogaliila bekekko mina tabiyaannenna taɂiyaan biyaanneya. </char></note><verse eid="MAT 4:25"/></para>
  <chapter eid="MAT 4"/>
  <chapter number="5" style="c" sid="MAT 5"/>
  <para style="s1">Yesuusa wodamii gutii lallabaano</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1"/>Yesuusa gosa kakkodiyaare goorata wodami tos beegure hamas's'ee; usukko oɂagaalssatareen usu tos emeten. <verse eid="MAT 5:1"/><verse number="2" style="v" sid="MAT 5:2"/>Haa amaa agaalssisano haggaɂabe.<verse eid="MAT 5:2"/></para>
  <para style="s1">Kasommaasame ibaaddo</para>
  <para style="r">(<ref loc="LUK 6:20-23">Luk'. 6:20-23</ref>)</para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3"/>«Ayyaanakkisooyi Waa odootataraan osommaasameenyan;</para>
  <para style="q2" vid="MAT 5:3">wononnati kadaruure kakkisooyya.<verse eid="MAT 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4"/>Ogaddaaran osommaasameenyan;</para>
  <para style="q2" vid="MAT 5:4">Waakko goggoɂinna helayinaraan.<note caller="-" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="PSA 24:3-4">Mez. 24:3-4</ref>.</char></note><verse eid="MAT 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5"/>Fayyankkanɂi osommaasameenyan; ulnna eelinaran.<note caller="-" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="PSA 37:11">Mez. 37:11</ref>.</char></note><verse eid="MAT 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6"/>K'ullumma oɂuɂaaranna osugubaataraan</para>
  <para style="q2" vid="MAT 5:6">osommaasameenyan bararraanwa.<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="ISA 55:1-2">Isa. 55:1-2</ref>.</char></note><verse eid="MAT 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7"/>Shaaga oyelaraan osommaasameenyan; Waakko shaaga helayinnaraan.<verse eid="MAT 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8"/>Wodana k'ulluu okkonlleetetta osommaasameenyan; Waa dinnaraan.<note caller="-" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="PSA 24:3-4">Mez. 24:3-4</ref>.</char></note><verse eid="MAT 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9"/>Owogarisaraan osommaasameenyan yiis kawaa amami uumaminaraan.<verse eid="MAT 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10"/>K'ullumma maraan ameerene ohorooramaraan osommaasameenyan;</para>
  <para style="q2" vid="MAT 5:10">Wononnati kadaruure kakkisooyya.<note caller="-" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="1PE 3:14">1 P'et. 3:14</ref>.</char></note><verse eid="MAT 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11"/>«Ibaaddo aalantti teeyi isin gohabaare gohoroorena, meellane dubba isin gutii goɂayeese osommaasantteettan.<note caller="-" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="1PE 4:14">1 P'et. 4:14</ref>.</char></note> <verse eid="MAT 5:11"/><verse number="12" style="v" sid="MAT 5:12"/>Daruurii isin taɂatayinnattaan muraa taɂatii mankkolleete maraan geggelaayen; geggeloo tusa. Isinkko horeene ogireen ohegerool hikkamalee horooreraan.»<note caller="-" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="2CH 36:16">2 Od. 36:16</ref>; <ref loc="ACT 7:52">Ofa. Fe. 7:52</ref>.</char></note><verse eid="MAT 5:12"/></para>
  <para style="s1">Ifana Essebo</para>
  <para style="r">(<ref loc="MRK 9:50">Mar. 9:50</ref>; <ref loc="LUK 14:34-35">Luk'. 14:34-35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13"/>«Isin taɂulee essebottaan. Essebo taɂesseboo onɂomoonje gowaatte abbaabayi onɂomoonje yelayin daanddaata? Sar shafamidde luki taɂibaaddoyi daddaramin kuwaarre laɂo lakkoɂabtto.<note caller="-" style="x"><char style="xo" closed="false">5:13 </char><char style="xt" closed="false"><ref loc="LUK 14:34-35">Luk'. 14:34-35</ref>.</char></note><verse eid="MAT 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14"/>«Isin kaɂalami ifattaan. Wodami gutii tagitta katamaa siyamin lakkodaanddeeto.<note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="JHN 8:12">Yan. 8:12</ref>; <ref loc="JHN 9:5">9:5</ref>.</char></note> <verse eid="MAT 5:14"/><verse number="15" style="v" sid="MAT 5:15"/>Dab hank'k'ayisatere daachcho hegelii golssate kakaatara ibaaddo lakkogiro. Min orroo kagiro dubbaan goggohank'ayiro bollanssoo gutii kayin kuwaarre.<note caller="-" style="x"><char style="xo" closed="false">5:15 </char><char style="xt" closed="false"><ref loc="MRK 4:21">Mar. 4:21</ref>; <ref loc="LUK 8:16">Luk'. 8:16</ref>; <ref loc="LUK 11:33">11:33</ref>.</char></note> <verse eid="MAT 5:15"/><verse number="16" style="v" sid="MAT 5:16"/>Hikkamaleenna ibaaddo oɂidan feloɂoottisin diigure daruurii kagiro Aabbokkisin goggokabajiron ifakkisin ibaaddo horee hahank'awo.»<note caller="-" style="x"><char style="xo" closed="false">5:16 </char><char style="xt" closed="false"><ref loc="1PE 2:12">1 P'et. 2:12</ref>.</char></note><verse eid="MAT 5:16"/></para>
  <para style="s1">Seera kaɂooriti feloo haano</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17"/>«Ani seera kamusena kahegeroo iggilisin kaɂemeeyero aani isinuun aroolleeno; feloo hayisin kuwaarre iggilisin lakkoɂemeeyero. <verse eid="MAT 5:17"/><verse number="18" style="v" sid="MAT 5:18"/>Ani rumminaa isinuun amara, ulnna daruurinna taa roorraanii seera dubba feloo hayinara kuwaarre seerakko fidale too goorttun eeggano koo duuddo lakkoɂiggilssamiro.<note caller="-" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="LUK 16:17">Luk'. 16:17</ref>.</char></note> <verse eid="MAT 5:18"/><verse number="19" style="v" sid="MAT 5:19"/>Haanssun maayyona hikka ajaja dubbakko kic'c'arkki gobbaase kakkaleenna goggobaasiro goɂagaalssise wononnati kadaruureyi dubbaankko kic'c'arkki amami uumaminara. Ayesuun goɂameen hikka ajajaal feloo hayisaa okkaleenna felooyi goggohayisinawun kaɂagaalssisara hassu wononnati kadaruureeti kanjiinkki amaminnara. <verse eid="MAT 5:19"/><verse number="20" style="v" sid="MAT 5:20"/>K'ullummattisin tafarasaawilkkonna seera kamuse oɂagaalssisaraankkotti k'ullummakko roori gomutoon wononnati kadaruure tos ijjii tabin lakkodaandaattan ani amara.»<verse eid="MAT 5:20"/></para>
  <para style="s1">Yesuusakko engge maraan kasisamero agaalssisi</para>
  <para style="r">(<ref loc="LUK 12:58-59">Luk'. 12:58-59</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21"/>«Kahoree ibaaddone ‹Ibaaddo aroolagaaddeen kaɂamamero isin maaltteettan; ibaaddo kalagadara firddaaminara kaɂamamero maaltteettan.›<note caller="-" style="x"><char style="xo" closed="false">5:21 </char><char style="xt" closed="false"><ref loc="EXO 20:13">Biy. 20:13</ref>; <ref loc="DEU 5:17">Ada. 5:17</ref>; <ref loc="DEU 16:18">16:18</ref>.</char></note> <verse eid="MAT 5:21"/><verse number="22" style="v" sid="MAT 5:22"/>Ani goɂameen haa amara; abbikkeessa raakkallii kaɂinggaamara dubba firddaaminara; goorttun abbikkeessa ‹Kamaaddinoon› kaɂamara taɂayihuudi shonggoyi hoosaminara; ‹Taatowaa› kaɂamara ade tagaannemi eleenkokki firdda usu ooratara.<note caller="+" style="f"><char style="fr" closed="false">5:22 </char><char style="fqa" closed="false">Abbikkeessa kahabaarara</char><char style="ft" closed="false">kookkoo kahorkkoo mas'aafaali, «Adda» kaɂamaro haafura adara. </char></note><verse eid="MAT 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23"/>«Haanssun jaarssokkaa banɂe tafalaa gutii kayitedde Waawun kakkosisato goorata abbikka ku kakkok'uk'amera ayees kuun k'alli goɂame, <verse eid="MAT 5:23"/><verse number="24" style="v" sid="MAT 5:24"/>Jaarssokkaa ese banɂe tafalaa horee isaagigudde horaarjje seegudde abbikkaanne wota wogari; Esekko abbaabadde jaarssokkaa Waawun sisi.<verse eid="MAT 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25"/>«Ku kamootara baragarakka ku goggofirddisonkko, daannanna kashaaron roorisi ku goggosisoonkkona min kashaano goggotabisoonkko raadii giraan saami baragaraakkaanne wota wogari. <verse eid="MAT 5:25"/><verse number="26" style="v" sid="MAT 5:26"/>Ani kuun rumminaa amara, usu ku gofirddise adi maragade dubba ati muri taagudissoo esekkona lakkobinnatto.»<verse eid="MAT 5:26"/></para>
  <para style="s1">Sharmmut'ummakokki gara kasisamero agaalssisi</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27"/>«Aroosharmut'iteen kaɂamamero maaltteettan.<note caller="-" style="x"><char style="xo" closed="false">5:27 </char><char style="xt" closed="false"><ref loc="EXO 20:14">Biy. 20:14</ref>; <ref loc="DEU 5:18">Ada. 5:18</ref>.</char></note> <verse eid="MAT 5:27"/><verse number="28" style="v" sid="MAT 5:28"/>Ani goɂameen isinne haa amara; heleel tahalchcha ilii kadiyaara dubba wodanatteesayi esene wota sharmmut'eera amanoyya. <verse eid="MAT 5:28"/><verse number="29" style="v" sid="MAT 5:29"/>Tamergge iltatta c'ubboon aalantti golleete goorsewa beesi shafi, maarkka dubba tagaannemi eleen tos shafamanakko maarkkaakko banɂe too waatanoya horekki.<note caller="-" style="x"><char style="xo" closed="false">5:29 </char><char style="xt" closed="false"><ref loc="MAT 18:9">Mat. 18:9</ref>; <ref loc="MRK 9:47">Mar. 9:47</ref>.</char></note> <verse eid="MAT 5:29"/><verse number="30" style="v" sid="MAT 5:30"/>Gene tamerggetatta c'ubboon aalantti golleete goosigudde shafi! Maarkka dubba gaannemi tos shafamanakko; maarkkaakko banɂe too waatano horekki.»<note caller="-" style="x"><char style="xo" closed="false">5:30 </char><char style="xt" closed="false"><ref loc="MAT 18:8">Mat. 18:8</ref>; <ref loc="MRK 9:43">Mar. 9:43</ref>.</char></note><verse eid="MAT 5:30"/></para>
  <para style="s1">Keelkki amamanokokki gara</para>
  <para style="r">(<ref loc="MAT 19:9">Mat. 19:9</ref>; <ref loc="MRK 10:11-12">Mar. 10:11-12</ref>; <ref loc="LUK 16:18">Luk'. 16:18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31"/>« ‹Ooritteessa keelkki ame kabeesara dubba keelkki kakkoɂamero worak'ata eseen sisano dootisara amamera.›<note caller="-" style="x"><char style="xo" closed="false">5:31 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">Ada. 24:1-4</ref>; <ref loc="MAT 19:7">Mat. 19:7</ref>; <ref loc="MRK 10:4">Mar. 10:4</ref>.</char></note> <verse eid="MAT 5:31"/><verse number="32" style="v" sid="MAT 5:32"/>Ani goɂameen isinne haa amara; ese kakkaleenne wota sharmmut'aa giraan gutii goɂabe kuwaarre; ooritteessa keelkki ame kabeesara dubba ese kakkaleenne wota goggoshaarmut'ito kayelaroya. Hikka garaayi keelkki amantte tabeetetto heleelttiti kaɂatatarana kasharmmut'aaro aani tootaamara.»<note caller="-" style="x"><char style="xo" closed="false">5:32 </char><char style="xt" closed="false"><ref loc="MAT 19:9">Mat. 19:9</ref>; <ref loc="MRK 10:11-12">Mar. 10:11-12</ref>; <ref loc="LUK 16:18">Luk'. 16:18</ref>; <ref loc="1CO 7:10-11">1 K'or. 7:10-11</ref>.</char></note><verse eid="MAT 5:32"/></para>
  <para style="s1">Gara kaɂammatoo</para>
  <para style="r">(<ref loc="MAT 5:32-38">Mat. 5:32-38</ref>; <ref loc="LEV 19:12">Woy. 19:12</ref>; <ref loc="JAS 5:12">Yay. 5:12</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33"/>Kahoree ibaaddon, «T'araa arooɂammatteen; ayesuun goɂameen Waayi horee kaɂammattetto oora» kaɂamamero maaltteettan.<note caller="-" style="x"><char style="xo" closed="false">5:33 </char><char style="xt" closed="false"><ref loc="LEV 19:12">Woy. 19:12</ref>; <ref loc="NUM 30:2">To. 30:2</ref>; <ref loc="DEU 23:21">Ada. 23:21</ref>.</char></note> <verse eid="MAT 5:33"/><verse number="34" style="v" sid="MAT 5:34"/>Ani goɂameen isinne; «Suure arooɂammatteen» amara. Daruurii golleenna arooɂammatteen, korffinjje kawaatta.<note caller="-" style="x"><char style="xo" closed="false">5:34 </char><char style="xt" closed="false"><ref loc="JAS 5:12">Yay. 5:12</ref>; <ref loc="ISA 66:1">Isa. 66:1</ref>; <ref loc="MAT 23:22">Mat. 23:22</ref>.</char></note> <verse eid="MAT 5:34"/><verse number="35" style="v" sid="MAT 5:35"/>Ulii golleenna arooɂammatteen; luki tawaa takkofoolssaattoya; Iyyerusaalemiinna arooɂammatteen tanjiintti tawono katamaatta.<note caller="-" style="x"><char style="xo" closed="false">5:35 </char><char style="xt" closed="false"><ref loc="ISA 66:1">Isa. 66:1</ref>; <ref loc="PSA 48:2">Mez. 48:2</ref>.</char></note> <verse eid="MAT 5:35"/><verse number="36" style="v" sid="MAT 5:36"/>Isiɂoottayi golleenna arooɂammatte; metekaakki fiit'a koo gumaara goorttun gambballa yelin lakkodaanddaatto. <verse eid="MAT 5:36"/><verse number="37" style="v" sid="MAT 5:37"/>Haanssun ayeesaa giraan ayeeskkisin goɂiimanaa «iɂii» ade gollaaɂamanaa «laa» halleewo. Hikkakko kakkalee dubba kameellankko kaɂemeetaroya.<note caller="-" style="x"><char style="xo" closed="false">5:37 </char><char style="xt" closed="false"><ref loc="LEV 19:12">Woy. 19:12</ref>; <ref loc="NUM 30:2">To. 30:2</ref>; <ref loc="DEU 23:21">Ada. 23:21</ref>.</char></note><verse eid="MAT 5:37"/></para>
  <para style="s1">Halo biin lakkodootisaro</para>
  <para style="r">(<ref loc="MAT 5:38-42">Mat. 5:38-42</ref>; <ref loc="LUK 6:29-30">Luk'. 6:29-30</ref>; <ref loc="LEV 19:13-18">Woy. 19:13-18</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38"/>«Il maraan il, ilkko maraan ilkkoo,» kaɂamamero isin maaltteettan.<note caller="-" style="x"><char style="xo" closed="false">5:38 </char><char style="xt" closed="false"><ref loc="EXO 21:24">Biy. 21:24</ref>; <ref loc="LEV 24:20">Woy. 24:20</ref>; <ref loc="DEU 19:21">Ada. 19:21</ref>.</char></note> <verse eid="MAT 5:38"/><verse number="39" style="v" sid="MAT 5:39"/>Ani goɂameen isinne haa amara; tameellan kafelaro ibaaddoti arooneebatteen; ayesuun goɂameen hangorooc'c'akkaa kamerggee kabasaroon kakkalee hangorooc'c'a kabbete adi tusa. <verse eid="MAT 5:39"/><verse number="40" style="v" sid="MAT 5:40"/>Ibaaddoti koo k'olokkaa atayin ku gomootee sarssi kaabbaanne adigudde usuun sisi. <verse eid="MAT 5:40"/><verse number="41" style="v" sid="MAT 5:41"/>Ibaaddoti koo kuunne banɂe too seenna ami ku gutii gohunnoome usu raakokki ambba usune wota see. <verse eid="MAT 5:41"/><verse number="42" style="v" sid="MAT 5:42"/>Kukko kaɂebaataron sisi; amɂaayin kadootatarokkonna arootiratte.<note caller="-" style="x"><char style="xo" closed="false">5:42 </char><char style="xt" closed="false"><ref loc="DEU 15:8">Ada. 15:8</ref>; <ref loc="PRO 24:29">Mas. 24:29</ref>.</char></note><verse eid="MAT 5:42"/></para>
  <para style="s1">Diina geelatano</para>
  <para style="r">(<ref loc="LUK 6:27-36">Luk'. 6:27-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43"/>«Ollaattaa geelaa diinakkaa diidi kaɂamamero maaltteettaan.»<note caller="-" style="x"><char style="xo" closed="false">5:43 </char><char style="xt" closed="false"><ref loc="LEV 19:18">Woy. 19:18</ref>.</char></note> <verse eid="MAT 5:43"/><verse number="44" style="v" sid="MAT 5:44"/>Ani goɂameen diinajjoolkisinna geelayen, isin ohorooraraawunna ebaayen amara.<note caller="-" style="x"><char style="xo" closed="false">5:44 </char><char style="xt" closed="false"><ref loc="PRO 25:21-22">Mas. 25:21-22</ref>.</char></note> <verse eid="MAT 5:44"/><verse number="45" style="v" sid="MAT 5:45"/>Hikkamalee mankko yelattaan marantinuun daruurii kagiro Aabbokkisinuun yiisaas linnattaan. Usu kaɂidanuunna kameellanuun dubbaan ariti beesara; idaamona c'ubbaalessaluunna k'ullooleewun ubsisara. <verse eid="MAT 5:45"/><verse number="46" style="v" sid="MAT 5:46"/>Kageelaataro kaalaal ogeelaatattaan golleeten me muraa helayinattaan? K'arat'a okukkuyisaraanna laa usumalee yelaa giraanna? <verse eid="MAT 5:46"/><verse number="47" style="v" sid="MAT 5:47"/>Abbilaalttisin taalaalnne nogodda oɂaatattaan golleeten okkaleekko meyii iidattaan? Ayizaablnna la hikka yelaa giraanna? <verse eid="MAT 5:47"/><verse number="48" style="v" sid="MAT 5:48"/>Haanssun kadaruure Aabbokkisin k'ulluukki goggolleeroyi isinna k'ulluunɂi laa.<note caller="-" style="x"><char style="xo" closed="false">5:48 </char><char style="xt" closed="false"><ref loc="LEV 19:2-18">Woy. 19:2-18</ref>; <ref loc="DEU 18:13">Ada. 18:13</ref>.</char></note><verse eid="MAT 5:48"/></para>
  <chapter eid="MAT 5"/>
  <chapter number="6" style="c" sid="MAT 6"/>
  <para style="s1">Hiyyeessan sisanokokki gara</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1"/>«Ibaaddo isin goggoddeero amiddeen ‹Oɂidan felo oottisin› ibaaddo horee felatanakko isi oottisin oorayeen; usumalee gofeltteen kadaruure Aabbokkisinkko muraa lakkohelattaan.<note caller="-" style="x"><char style="xo" closed="false">6:1 </char><char style="xt" closed="false"><ref loc="MAT 23:5">Mat. 23:5</ref>.</char></note><verse eid="MAT 6:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2"/>«Ifissaaddoleel ibaaddo horee kabajjaamin ameengureen raadiinna banɂe taɂebii goggosisanaankki malee ati hiyyeessan kooko kakkosisso goorata hamuto amidde arooɂawwaajjite; ani rumminaa amara; hikamalee ollaaran muraattisoo dubba atateeran. <verse eid="MAT 6:2"/><verse number="3" style="v" sid="MAT 6:3"/>Isin goɂameen hiyyeessan sisaagiraan gene tamerggettisin kasisatto gene tabbete arooɂaddeeso. <verse eid="MAT 6:3"/><verse number="4" style="v" sid="MAT 6:4"/>Hiyyeessan sisaagiraan gollataa halleewo; gollataa kafelamero kadiyaara Aabbokkisin muraattisinna murrowa.»<verse eid="MAT 6:4"/></para>
  <para style="s1">Gara kaɂebi</para>
  <para style="r">(<ref loc="LUK 11:2-4">Luk'. 11:2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5"/>«Ebaataa giraan ifissaaddolee aani aroolleeten; iso ibaaddon mutin ameengureen banɂe taɂebiinna raadii k'ark'aarayi aalli ebaatano geelaatanan. Ani rumminaa amara; muraattisoo dubbana atateeran.<note caller="-" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="LUK 18:10-14">Luk'. 18:10-14</ref>.</char></note> <verse eid="MAT 6:5"/><verse number="6" style="v" sid="MAT 6:6"/>Ati goɂameen ebaayin goɂantte; kifilii tos tabi, ufana c'ufagudde gollataa kagiro Aabbokkaa tos ebaa, gollataa kafelamero kadiyaara Aabbokka muraattaa gachchoomurra. <verse eid="MAT 6:6"/><verse number="7" style="v" sid="MAT 6:7"/>Isin ebaataa giraan kamaaddinoon haafuraayi abbaab abbaab ebaatanoyi ebi kamaalssamaro aani kalaaro Ayizaab aani ayees jiinasataa arooɂeraasatten.<note caller="-" style="x"><char style="xo" closed="false">6:7 </char><char style="xt" closed="false"><ref loc="1KI 18:25-29">1 Won. 18:25-29</ref>.</char></note> <verse eid="MAT 6:7"/><verse number="8" style="v" sid="MAT 6:8"/>Iso aani aroolleeten, Aabbokkisin isin haɂebaannoon giraan horennewa isinuun me dootisaro kasowa.<verse eid="MAT 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9"/>«Isin goɂameen haa ama ebaayen;</para>
  <para style="q1" vid="MAT 6:9">«Daruurii kagitta Aabbokkaani!</para>
  <para style="q2" vid="MAT 6:9">k'ulluukki megekka hakabajaame;<verse eid="MAT 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10"/>Wononnatikka haɂemeeto;</para>
  <para style="q2" vid="MAT 6:10">Feɂitta daruurii goggolleetettoyi</para>
  <para style="q2" vid="MAT 6:10">Usumalee uliinna halleeto;<verse eid="MAT 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11"/>Kahittaaritee babokkaani hittaari noon sisi.<verse eid="MAT 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12"/>Noonna no kamiirɂero haheso goggoɂamannoo;</para>
  <para style="q2" vid="MAT 6:12">Baaskkaani haheso amina;<verse eid="MAT 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13"/>Kameellankko haasi kuwaarre; c'aafiti orro no arootabsse;</para>
  <para style="q1" vid="MAT 6:13">[Wononnati kakkaayya, hunnana kabajana</para>
  <para style="q2" vid="MAT 6:13">Jiruu jiroomman kakkaayya;</para>
  <para style="q2" vid="MAT 6:13">Hamiinɂi.]<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">Kat'awoo mas'aafal hitta banɂe lakkoɂadaro. </char></note><verse eid="MAT 6:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 6:14"/>Isin baas kaɂibaaddo haheso goɂantteen kadaruure Aabbokkisin ade isinuun haheso amirowa. <verse eid="MAT 6:14"/><verse number="15" style="v" sid="MAT 6:15"/>Ayesuun goɂameen isin c'ubbo kaɂibaaddoo haheso kaɂamoon golleeten Aabbokkisinna c'ubbokkisin haheso lakkoɂamiro.»<note caller="-" style="x"><char style="xo" closed="false">6:15 </char><char style="xt" closed="false"><ref loc="MAT 11:25-26">Mat. 11:25-26</ref>.</char></note><verse eid="MAT 6:15"/></para>
  <para style="s1">Gara kaɂagabuu</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16"/>«Ebi kaɂagaabuuyi ifissaaddolee ibaaddo aani aroohinggigiddeen; isona ebi kaɂagaabuuyi goggoɂaddeesamirowun ameengureen bebbeedtisooyi gutii gaddakokki maalaata tusataraan. Ani rumminaa amara, hikkamalee ollaaran muraattisoo dubba atateeran.<note caller="-" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="ISA 58:5">Isa. 58:5</ref>.</char></note> <verse eid="MAT 6:16"/><verse number="17" style="v" sid="MAT 6:17"/>Ati goɂameen kakkoɂagabuuyite goorata; bebbeedttaa aali, metekkaanna shigida. <verse eid="MAT 6:17"/><verse number="18" style="v" sid="MAT 6:18"/>Hikkaniinna agabuwanokkaa gollataa kagiro Aabbokkaa kaalaalya kakkasa, ibaaddokko goɂameen kagolate laara; gollataa kafelamero kadiyaara Aabbokka muraattaa kuun murrowa.»<verse eid="MAT 6:18"/></para>
  <para style="s1">Durumma tadaruuree</para>
  <para style="r">(<ref loc="LUK 12:33-34">Luk'. 12:33-34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19"/>«K'ook'anna kaɂaamaron; marc'c'o taɂududootte aani kabaaron; hetona oshi hetin kadanddeeto, hikka ulii gutii isi oottisinuun durumma arookukkuyisatteen.<note caller="-" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="JAS 5:2-3">Yay. 5:2-3</ref>.</char></note> <verse eid="MAT 6:19"/><verse number="20" style="v" sid="MAT 6:20"/>Ayesuun goɂameen k'ook'anna kaɂaamoon, marc'c'o taɂududootte aani kabbaannon, hetonna oshi hetin kadanddeenon, ele daruurii isi oottisinuun durumma kukkuɂisayeen. <verse eid="MAT 6:20"/><verse number="21" style="v" sid="MAT 6:21"/>Durummatta mankkogittoo wodanattana esee gitta.»<verse eid="MAT 6:21"/></para>
  <para style="s1">Ifa kamaaree</para>
  <para style="r">(<ref loc="LUK 11:34-36">Luk'. 11:34-36</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22"/>«Iilɂo maarun ifayyaan; haanssun Iilɂo fayyaaleessa golleen maarkka dubbana ifaayi kaɂammagame laara. <verse eid="MAT 6:22"/><verse number="23" style="v" sid="MAT 6:23"/>Iilɂo ootta ohawɂaaran golleen ade maarkka dubbana mugud laara. Goorttanun ku orroo kagira ifa mugud gollee; mugud ade misimisii t'illinggakki mugud laara!»<verse eid="MAT 6:23"/></para>
  <para style="s1">Waawunna maragadenna</para>
  <para style="s1">(Luk'. 16:13; 12:22-31)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24"/>«Ibaaddoti koo Goottaa lamaan handdayin lakkodaanddaaro, koo diidegure kakkalee geelaatara, goorttun koo kabajjeegure kakkalee tuffatara, Waawunna maragadeen raattoo handdayin lakkodaanddaamaro.<verse eid="MAT 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25"/>«Haanssun ani isinne haa amara; barsano oottisin maraan me aaminna? Me t'aminna? Me sarssayinanna? Amaa arooc'annak'antteen; neefo babokko, maar ade sarssikko lakkorooraroyya? <verse eid="MAT 6:25"/><verse number="26" style="v" sid="MAT 6:26"/>Alla kimbir diyaa; lakkowut'atanaan, lakkokukkuyisataraan, gootarayinna lakkokibataraan, ayesuun goɂameen kadaruure Aabbokkisinna iso aamisara. Isin isokko aaloo lakkoroorattaanya? <verse eid="MAT 6:26"/><verse number="27" style="v" sid="MAT 6:27"/>Golleenna isin orrokko c'annak'amegure geeskeessa gutii arri too adin kadaanddaara giro?<note caller="+" style="f"><char style="fr" closed="false">6:27 </char><char style="fqa" closed="false">Geeskkeessa gutii arri too, </char><char style="ft" closed="false">banɂe banɂeeyi, «Jifuttessaa gutii hisil koo» kaɂamara gira. </char></note><note caller="-" style="x"><char style="xo" closed="false">6:27 </char><char style="xt" closed="false"><ref loc="PSA 39:5-7">Mez. 39:5-7</ref>.</char></note><verse eid="MAT 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28"/>«Adena sarssi maraan muun c'annak'aamattan? Alla tadiida daraara misimisii jiinatto diyaa; lakkodaafuranan, goorttun lakkosuk'k'aataran; <verse eid="MAT 6:28"/><verse number="29" style="v" sid="MAT 6:29"/>Ayesuun goɂameen ani isinne haa amara; hasse gitatti kabajja kaɂabanaaye wono Solomooni golleenna hitta daraaralkko too aani lakkosarssatero.<note caller="-" style="x"><char style="xo" closed="false">6:29 </char><char style="xt" closed="false"><ref loc="1KI 10:4-7">1 Won. 10:4-7</ref>; <ref loc="2CH 9:3-6">2 Od. 9:3-6</ref>.</char></note> <verse eid="MAT 6:29"/><verse number="30" style="v" sid="MAT 6:30"/>Isin ammano okkoonhank'atera Waa hittaari mutegure geebbari eleen orro kashafamaro ees kadiida hikkamalee gosarssisiro isin ade misii roorisi sarssisana waatara? <verse eid="MAT 6:30"/><verse number="31" style="v" sid="MAT 6:31"/>Haanssun ‹Me aaminna?› ‹Me t'aminna?› ‹Me sarssanna?› ami arooc'annak'antteen. <verse eid="MAT 6:31"/><verse number="32" style="v" sid="MAT 6:32"/>Ayizaab hikka ayees dubba helayin c'annak'aamara; kadaruure Aabbokkisinna hikki dubba isinuun kadootisaro laano kasowa. <verse eid="MAT 6:32"/><verse number="33" style="v" sid="MAT 6:33"/>Kameen dubbakko t'aa wononnati kawaanna k'ullummateessa dootayeen; kahese dubbana gachchoo adamira. <verse eid="MAT 6:33"/><verse number="34" style="v" sid="MAT 6:34"/>Haanssun geebbartun arooc'annak'antten; geebbartun c'annak'aamano geebbaritun habbaroo; arri metemeteeyi tattisee talleete rakkoo abtta.»<verse eid="MAT 6:34"/></para>
  <chapter eid="MAT 6"/>
  <chapter number="7" style="c" sid="MAT 7"/>
  <para style="s1">Kakkalee gutii firddaanawaatti</para>
  <para style="r">(<ref loc="LUK 6:37-42">Luk'. 6:37-42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1"/>«Isini gutii goggofirddaamonkko maayyo gutiinna aroofirdditeen, <verse eid="MAT 7:1"/><verse number="2" style="v" sid="MAT 7:2"/>Isin goggofirddaattaankki malee firddaaminara; kakkoɂekkaasattaan huuyi isinuun ekkaasaminara.<note caller="-" style="x"><char style="xo" closed="false">7:2 </char><char style="xt" closed="false"><ref loc="MRK 4:24">Mar. 4:24</ref>.</char></note><verse eid="MAT 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3"/>«Ilttaayi orroo kagiro gaa hadiyaannoni abbikkaa kotti il orroo kagiro huura muun diyaatta? <verse eid="MAT 7:3"/><verse number="4" style="v" sid="MAT 7:4"/>Ilttaayi gaa giraan abbikkaakotti il orroo kagiro huura kuun ani beesiro amin misii daanddaatta? <verse eid="MAT 7:4"/><verse number="5" style="v" sid="MAT 7:5"/>Ati ifissaaddaa t'ayi ilttaayi orroo kagiro gaa beesa, esekko abbikkaakotti ilii orroo kagiro huura beesin madaari din daanddaatta.<verse eid="MAT 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6"/>«Luk'k'a oottisooyi goggodaddaronkko abbaabayi ilkkoo abayi goggotatarshinnonkko kasommaasame kooko keroorun aroossisseen; awɂallokki kooko booyyee horee arooluguddeen.»<verse eid="MAT 7:6"/></para>
  <para style="s1">Ebaayen, dootayeen, babbasayen</para>
  <para style="r">(<ref loc="LUK 11:9-13">Luk'. 11:9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7"/>«Ebaayen sisamirowa, dootayeen helattaanwa, babbasayen ufana banamirowa; <verse eid="MAT 7:7"/><verse number="8" style="v" sid="MAT 7:8"/>Kaɂebaatara dubba atatara, kadootatarana helatara, kababbasataroonna ufa banamirowa.<verse eid="MAT 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9"/>«Isin orrokko erekkeessa babo goɂebaate eɂemo kasisira odo giro? <verse eid="MAT 7:9"/><verse number="10" style="v" sid="MAT 7:10"/>Goorttun kunɂub goɂebaate habeessa kasisara giro? <verse eid="MAT 7:10"/><verse number="11" style="v" sid="MAT 7:11"/>Hayya isin omeellan leeteen giraan yiis kakkisinuun kaɂidan kooko sisano gomalabtteen kadaruure Aabbokkisin isin kaɂebaatattaan kooko kaɂidan misii roorisi isinuun sisanawaatara? <verse eid="MAT 7:11"/><verse number="12" style="v" sid="MAT 7:12"/>Kakkalee ibaaddo isinuun goggofelloon kadootattaan kooko isinna fela; seerana kahegeroolkokki agaalssisi hikkawaya.»<verse eid="MAT 7:12"/></para>
  <para style="s1">Gooc'a kaɂuubaanna kabalɂaan</para>
  <para style="r">(<ref loc="LUK 13:24">Luk'. 13:24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13"/>«Gooc'a kaɂuubaankkine taba; baas tos kageesara raa kanjiinkkinna gooc'ana kabalɂaanya, usuu otaberaanna omoogganyaan. <verse eid="MAT 7:13"/><verse number="14" style="v" sid="MAT 7:14"/>Giri kaneefoo tos kageesara raa goɂameen kac'imiinkki gooc'ana kaɂuubaanya; otabaraanna uc'c'arri olaalyaan.»<note caller="-" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="JER 21:8">Erm. 21:8</ref>; <ref loc="DEU 30:19">Ada. 30:19</ref>.</char></note><verse eid="MAT 7:14"/></para>
  <para style="s1">Kat'araa kahegerol</para>
  <para style="r">(<ref loc="LUK 6:43-44">Luk'. 6:43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15"/>«C'ala taɂidaad sarssate kaɂemeetaro orroɂootiso goɂameen hiyyeeyi aani basi aatin kaɂemeetaro kat'araa kahegeroolkko isi oorayeen.<note caller="-" style="x"><char style="xo" closed="false">7:15 </char><char style="xt" closed="false"><ref loc="EZK 22:27">Hiz. 22:27</ref>.</char></note> <verse eid="MAT 7:15"/><verse number="16" style="v" sid="MAT 7:16"/>Felo oottisokko iso addeesin daanddaattan. Illanjjikko woyinii, k'iinc'c'okko bellesi taɂamamatto il abaabanan? <verse eid="MAT 7:16"/><verse number="17" style="v" sid="MAT 7:17"/>Usumaleenna gaa kaɂidan dubba il taɂidan, gaa kameellan ade il tameellan dubamara. <verse eid="MAT 7:17"/><verse number="18" style="v" sid="MAT 7:18"/>Gaa kaɂidan il tameellan, gaa kameellanna il taɂidan dubamin lakkodaanddaaro. <verse eid="MAT 7:18"/><verse number="19" style="v" sid="MAT 7:19"/>Il taɂidan kadubamoon gaa dubbana goosamara, eleen orroddeenna shafamara.<note caller="-" style="x"><char style="xo" closed="false">7:19 </char><char style="xt" closed="false"><ref loc="MAT 3:10">Mat. 3:10</ref>; <ref loc="LUK 3:9">Luk'. 3:9</ref>; <ref loc="MAT 12:33">Mat. 12:33</ref>.</char></note> <verse eid="MAT 7:19"/><verse number="20" style="v" sid="MAT 7:20"/>Haanssun kat'araa kahegerool felo oottisooyi addeesinattaan.<verse eid="MAT 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21"/>«Daruurii kagiro Aabbokkee kotti feɂi anfeloon giraan ‹Gootta, Goottaa› In kaɂamara dubba wononnati kadaruure lakkotabaro. <verse eid="MAT 7:21"/><verse number="22" style="v" sid="MAT 7:22"/>Kagachchoo firddakotti arrii omooggan ‹Gootta, Goottaa, megekkaayi hegero la ayeenssella?› Megekkaayi durrisa labbeenssella? Megekkaayi kamooggan baasa noo lafelnnella? Aminaraan. <verse eid="MAT 7:22"/><verse number="23" style="v" sid="MAT 7:23"/>Hassu goorata ‹Ani duuddo isin laakkaso, isin tameellan ofelattaan inkko fakki ama› ami addeesisi seginara.<note caller="-" style="x"><char style="xo" closed="false">7:23 </char><char style="xt" closed="false"><ref loc="PSA 6:8">Mez. 6:8</ref>.</char></note><verse eid="MAT 7:23"/></para>
  <para style="s1">K'arookkina gowwaakokki min madaaratano</para>
  <para style="r">(<ref loc="LUK 6:47-49">Luk'. 6:47-49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24"/>«Goorttanun hikka haafurakkee maalegure feloo kahayisara dubba; min eɂemo gutii kamadaaratero k'arookki ibaaddoti aani laara. <verse eid="MAT 7:24"/><verse number="25" style="v" sid="MAT 7:25"/>Idaamo kaɂatiina ubate, daadnna dage, ambbalnna keetegudde usu min shafitte, eɂemo gutii mankko madaaramero maraantinu lakkoɂiyyero. <verse eid="MAT 7:25"/><verse number="26" style="v" sid="MAT 7:26"/>Hikka haafurakkee maalegure feloo kahayisoon ade; c'eekalee gutii min kamadaaratero gowwakki ibbaaddoti aani laara. <verse eid="MAT 7:26"/><verse number="27" style="v" sid="MAT 7:27"/>Idaamo kaɂatiinna ubate, daadnna dage, ambbalnna keetegudde usu min shafitte, minna iyye, iyaanona gomeellan lee.»<verse eid="MAT 7:27"/></para>
  <para style="s1">Odonnati kayesuusa</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28"/>Yesuusa hikka ayees ayeese kakkogudisare goorata gosana agaalssiskeessaa saade. <verse eid="MAT 7:28"/><verse number="29" style="v" sid="MAT 7:29"/>Aalanttina Ayihuudikokki seera kaɂagaalssisaro aani halleennoni giraan odonnati kaɂabo aani agaalssisaa mankkogire maraanya.<note caller="-" style="x"><char style="xo" closed="false">7:29 </char><char style="xt" closed="false"><ref loc="MRK 1:22">Mar. 1:22</ref>; <ref loc="LUK 4:32">Luk'. 4:32</ref>.</char></note><verse eid="MAT 7:29"/></para>
  <chapter eid="MAT 7"/>
  <chapter number="8" style="c" sid="MAT 8"/>
  <para style="s1">Yesuusana maarii bar kaɂabanaaye ibaaddoti</para>
  <para style="r">(<ref loc="MRK 1:40-45">Mar. 1:40-45</ref>; <ref loc="LUK 5:12-16">Luk'. 5:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1"/>Yesuusa wodamikko kakkodagare goorata gosa kamooggan usuu debee sesseete. <verse eid="MAT 8:1"/><verse number="2" style="v" sid="MAT 8:2"/>Hassu goorata maarii bar kaɂabanaaye ibaaddoti koo Yesuusa tos emeetegure horee gilbbise sagadaa, «Goottaa! Feɂitaa golleete in muc'c'isin daanddaatta» ame.<verse eid="MAT 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3"/>Yesuusana genetteessa diriirssategure dinddinaa, «Ani kuun feɂi sisera! Muc'c'imi!» ame. Ibaaddotina goorsewa barkko muc'c'ime. <verse eid="MAT 8:3"/><verse number="4" style="v" sid="MAT 8:4"/>Esekkona Yesuusa, «Fayyaanokkaa maayyonna aroosegite; ayesuun goɂameen seegudde isiɂoottaa tuuk'aamon tusa, Muse kuun kaɂajajeero meebaa sisi hikkina isoon ato leera» ame.<verse eid="MAT 8:4"/></para>
  <para style="s1">Kabooloo woyichchatikokki ammano</para>
  <para style="r">(<ref loc="LUK 7:1-10">Luk'. 7:1-10</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5"/>Yesuusa K'ifirenaahoomi tos goggotabee, kabooloo woyichchati kalleere koo usu tos gabbalamere; haa ame ebaate. <verse eid="MAT 8:5"/><verse number="6" style="v" sid="MAT 8:6"/>«Goottaa, iin kahandaarekki naafaleessa leegure aaloo abboosa diyaa minkkeeyi huddure gira» ame.<verse eid="MAT 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7"/>Yesuusana, «Ani emeeyigure usu fayyisinnara» ame.<verse eid="MAT 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8"/>Kabooloo woyichchatina abbaabere, «Goottaa, ati minkkee tos tabin ani lakkokadootisaroyyo; ayesuun goɂameen hittanii giraan haafura koo kaalaal ayeesina; iyyeen kahandaarekkina fayyirowa. <verse eid="MAT 8:8"/><verse number="9" style="v" sid="MAT 8:9"/>Ani metekkeewun kakkaleetun kahandaaro woyichchaya, aninna inkko hegelle iyyeen ohandaaran aba; isokko koonne see ani goɂamiro seetara, kakkaleenna koyya goɂamiro emeetara, iin kahandaarone hikka feli goɂamiro felara.»<verse eid="MAT 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10"/>Yesuusana abbaabkeessaa saadegure, debee sesseetaa ogireenne haa ame, «Ani rumminaa amara, ul kaɂisiraɂeel orrokko hikka aankikki ammano kaɂabo ibaaddo koonna ani lakkohelero. <verse eid="MAT 8:10"/><verse number="11" style="v" sid="MAT 8:11"/>Omoogganna mina tabiyaankkona mina taɂiyaankko emeeyinnaran wononnati kadaruureyi babo aamin Abraamene, Yissaak'ane, Yayik'oobanee raattoo hamas'innaraan.<note caller="-" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="LUK 13:29">Luk'. 13:29</ref>.</char></note> <verse eid="MAT 8:11"/><verse number="12" style="v" sid="MAT 8:12"/>Wononnati kadaruure ekkaate okkongire ade sarddi t'illinggakki mugud tos shafaminnaran, esee isoon oottanna ilkko fooc'ano leera.»<verse eid="MAT 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13"/>Yesuusana kabooloo woyichchatine, «See ammanokkaa malee kuun halleewo» ame. Kahandaarekkeessana goorsewa fayyee.<verse eid="MAT 8:13"/></para>
  <para style="s1">Yesuusa ibaaddo kamooggan hawɂaamikko fayyiisano</para>
  <para style="r">(<ref loc="MRK 1:29-34">Mar. 1:29-34</ref>; <ref loc="LUK 4:38-41">Luk'. 4:38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14"/>Yesuusa minkka P'et'iroosa tos kakkotabare goorata soddo tap'et'iroosa maar gube hawɂaamaa tahuddurttetto dee. <verse eid="MAT 8:14"/><verse number="15" style="v" sid="MAT 8:15"/>Usuna genettisee kakkodinddinare goorata, maar kagubarena gafare; keetegudde usuun handdayite.<verse eid="MAT 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16"/>Hemeen laa kakkoseetare goorata durrisaa kaɂabamero kamooggan ibaaddo Yesuusa tos keenen, usuna battiikki ayyaanajjol haafurakeessaa beese; dhukkubaleessaal dubbana fayyiise. <verse eid="MAT 8:16"/><verse number="17" style="v" sid="MAT 8:17"/>Hikkaniinna kahegeroo Isiyaasa haa ame oɂayyeesere hegero, «Usu maar orrookki dhukkubakaani atate haranokaanina sidate» oɂamameeren hegero feloo hayeen.<verse eid="MAT 8:17"/></para>
  <para style="s1">Yesuusaa debee kasesseetaro liin murtti dootisara</para>
  <para style="r">(<ref loc="LUK 9:57-62">Luk'. 9:57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18"/>Yesuusa, kamooggan ibaaddo usu maraamure kukku kaɂamero kakkodiyaare goorata bekekko gama goggonak'inawun ajajee. <verse eid="MAT 8:18"/><verse number="19" style="v" sid="MAT 8:19"/>Hassu goorata seera kamuse kaɂagaalssisara usu tos emeetegure; «Kaɂagaalssisatto! Ati mankko siyaatto dubba ani ku debee sesseeyinara» ame.<verse eid="MAT 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20"/>Yesuusana, «Geedalajjool gumbbi aba, kabuubara kimbbirna min aba, ere kaɂibaaddo ade isiɂoottessa takkofoolssisaro banɂe lakkoɂabo» ame abbaabe.<verse eid="MAT 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21"/>Yesuusakko kaɂagaalsataro kalleera kakkalee ibaaddoti koo ade, «Goottaa! T'ayi seeyire ani Aabbokkee goggok'amalaron iin feɂi sisi» ame.<note caller="+" style="f"><char style="fr" closed="false">8:21</char><char style="fqa" closed="false">Goggok'amalloo, </char><char style="ft" closed="false">Aabbokkeessa taa gooroo oorayi k'amalayin taɂabo feɂi katusaro aani laara. </char></note><verse eid="MAT 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22"/>Yesuusa ade, ogoyinaraan reeskkisoo hak'amaleen; «Ati goɂameen iin debee sessee» ame.<verse eid="MAT 8:22"/></para>
  <para style="s1">Yesuusa gaashimallo c'alɂise</para>
  <para style="r">(<ref loc="MRK 4:35-41">Mar. 4:35-41</ref>; <ref loc="LUK 8:22-25">Luk'. 8:22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23"/>Esekko Yesuusa wolabo orro tabe, usukko oɂagaalssatareenna usuu debee tabeen seeten. <verse eid="MAT 8:23"/><verse number="24" style="v" sid="MAT 8:24"/>Derɂa kaɂatii irggado keegure gaashimallo wolabo taa lichisiroo shalagaame, hassu goorata Yesuusa ade huddure gire. <verse eid="MAT 8:24"/><verse number="25" style="v" sid="MAT 8:25"/>Usukko oɂagaalssatareenna gabbalameen usu nabbaadisen gureen, «Goottaa! Baannewa, no haasi» ameen.<verse eid="MAT 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26"/>Yesuusana, «Isin ammano okkoonhank'atera! Muun hikkamalee abssaattaan?» ame. Esekko keegure irggadona gaashimallo hadise, goorsewa beke k'ooden.<verse eid="MAT 8:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27"/>Ibaaddona, «Hikki irggadona gaashimallona kakkoon ajajaamaraan misikki ibaaddotiyya?» amaa saaden.<verse eid="MAT 8:27"/></para>
  <para style="s1">Yesuusa battiikki ayyaanayi oɂabameeren ibaaddojja lama fayyiisano</para>
  <para style="r">(<ref loc="MRK 5:1-20">Mar. 5:1-20</ref>; <ref loc="LUK 8:26-39">Luk'. 8:26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28"/>Yesuusa bekekko gama nak'egure, Gerggesino kaɂamaraan ul goggogeeyi battiikki ayyaanayi oɂabameeren ibaaddojja lama takkogireen banɂe tahiyyeelkko beengureen usune wota eseleen; ibaaddona usu raanne roorin taawaaroo giin aaloo omeellanyen. <verse eid="MAT 8:28"/><verse number="29" style="v" sid="MAT 8:29"/>Isona, «Ati ere kawaa! Noonne wota haajaa tammee abtta? Goorata haggeennoni giraan no abboosisin emeette?» ameen okkeen.<note caller="-" style="x"><char style="xo" closed="false">8:29 </char><char style="xt" closed="false"><ref loc="JDG 1:12">Da. 1:12</ref>; <ref loc="2SA 16:10">2 Sam. 16:10</ref>.</char></note><verse eid="MAT 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30"/>Isokko abaraan fakkintte tamooggan booyyee bobbayite gitte. <verse eid="MAT 8:30"/><verse number="31" style="v" sid="MAT 8:31"/>Durrisana Yesuusane; «No kabeesinatto golleete tamooggan booyyee orroddi goggotabnno no gafarina» ameen ebaaten.<verse eid="MAT 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32"/>Yesuusana «Seyeen!» ame. Durrisana ibaaddojjakko beegure booyyee orroddee tabe, booyyeel dubbana laga k'ark'arakko hegelddeete ganggalatte beke orroddeete ubattedde ennegantte goote. <verse eid="MAT 8:32"/><verse number="33" style="v" sid="MAT 8:33"/>Booyyeel ofoofareenna bak'ateen katamaa tos seeteengureen kalleero ayeenssa durrisaayi abameen ogireen ibaaddojjaa gutii kafelamero ayees dubba sessegeen. <verse eid="MAT 8:33"/><verse number="34" style="v" sid="MAT 8:34"/>Hikka garaayinna kakkatamaa ibaaddo dubba Yesuusane wota eselin bee, usu kakkodiyaaren goorata ulkkisoo gafar goggobeeron ebaaten.<verse eid="MAT 8:34"/></para>
  <chapter eid="MAT 8"/>
  <chapter number="9" style="c" sid="MAT 9"/>
  <para style="s1">Naafaleessati ibaaddotikokki fayyaano</para>
  <para style="r">(<ref loc="MRK 2:1-12">Mar. 2:1-12</ref>; <ref loc="LUK 5:17-26">Luk'. 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1"/>Esekko abbaabatere Yesuusa wolabooyi tabe bekekko gama nak'e katamaatteessa tos emeete. <verse eid="MAT 9:1"/><verse number="2" style="v" sid="MAT 9:2"/>Esekko ibaaddo naafaleessati koo alggaayi sideengureen usu tos aateen emeteen. Yesuusana ammanokkisoo deegure naafaleessatine «Ko allamandde! C'ubbokka haheso amamera» ame. <verse eid="MAT 9:2"/><verse number="3" style="v" sid="MAT 9:3"/>Hassu goorata seera kamuse kaɂagaalssisara, «Hikki Waa habaaranoyya» amaa wodanattisooyi gumggumeen.<verse eid="MAT 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4"/>Yesuusa k'ofattisoo addeesegure haa ame; «Kameellan ayees wodanattisinii muun k'oppaattan? <verse eid="MAT 9:4"/><verse number="5" style="v" sid="MAT 9:5"/>Afo, ‹C'ubbokka haheso amamera amanokkona› ‹Kingudde sessee amanokko eekiya ene kallaara›? <verse eid="MAT 9:5"/><verse number="6" style="v" sid="MAT 9:6"/>Ayesuun goɂameen ere kaɂibaaddo ul gutii c'ubbo haheso kakkoɂamiro odonnati kaɂabo laano goggoɂaddeessanunya» amegure; naafaleessatine «Ki alggaattaa sidadde min gali» ame. <verse eid="MAT 9:6"/><verse number="7" style="v" sid="MAT 9:7"/>Naafaleesaatina keegure minkkeessa gale. <verse eid="MAT 9:7"/><verse number="8" style="v" sid="MAT 9:8"/>Gosana hikka kakkodiyaare goorata saade, abssiinna ammagameengureen hikka aankkikki odonnati ibaaddon kasisero Waa galateen.<verse eid="MAT 9:8"/></para>
  <para style="s1">Uumamano kamatoosa</para>
  <para style="r">(<ref loc="MRK 2:13-17">Mar. 2:13-17</ref>; <ref loc="LUK 5:27-32">Luk'. 5:27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9"/>Yesuusa esekko keegure seetaa giraan Matoosa kaɂamamare ibaaddoti koo k'arat'a takkomuraneen banɂee kahamas'eero deegure «In debee sessee» ame; usuna keegure Yesuusa debee sesseete.<verse eid="MAT 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10"/>Yesuusa min kamatoosaa aamo gutii giraan omooggan k'arat'a okukkuyisareenna c'ubbaaleeyil emetengureen usune wotana usukko oɂagaalssataranne wota babo aamin hamas's'een. <verse eid="MAT 9:10"/><verse number="11" style="v" sid="MAT 9:11"/>Kafarasaawi ibaaddona hikka kakkodiyaaren goorata Yesuusakko oɂagaalssatareenne, «Isin kaɂagaalssisara k'arat'a okukkuyisaraanena c'ubbaaleyilnne wota misii aamara?» ameen hoosaten.<note caller="-" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="MAT 15:1-2">Mat. 15:1-2</ref>.</char></note><verse eid="MAT 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12"/>Yesuusana iso kaɂayeesaran maalegure haa ame, akimii kakkondootisara dhukkubaleessalunya kuwaarre fayyaaleessan lakkoyo. <verse eid="MAT 9:12"/><verse number="13" style="v" sid="MAT 9:13"/>Seeyenguddeen, «Ani jaarsokko roorise shaaga geelaatara kaɂamamero haafurakokki fureen agaalssayen. Ani kakkoonɂemeeyera c'ubbaalesalun kuwaarre k'ulluukki uumn lakkoɂemeeyero» amame mas'aafaa k'ulluukki mankkos'aafamero maraanya ame.<note caller="-" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="HOS 6:6">Hos. 6:6</ref>; <ref loc="MAT 12:7">Mat. 12:7</ref>.</char></note><verse eid="MAT 9:13"/></para>
  <para style="s1">Yesuusakko oɂagaalssataran agabuwaana waattikotti aalantti</para>
  <para style="r">(<ref loc="MRK 2:18-22">Mar. 2:18-22</ref>; <ref loc="LUK 5:33-39">Luk'. 5:33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14"/>Hassu goorata kat'ammak'aaro Yaannisakko oɂagaalssataran Yesuusa tos emetengureen «Noonna Farasaawiilnna arggetto goɂagabuyinno kukko oɂagaalssataran adeen muun agabuwana waataraan?» ameen Yesuusa hoosaten.<verse eid="MAT 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15"/>Yesuusana, «Kamashaashee isone wota giraan haassinoon taɂemettetta martti misii gaddin daanddaatta? Kamashaashee isokko kakkoɂataminara goorata emeetara; hassu goorata agabuyinaraan ame.<verse eid="MAT 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16"/>«Sarssi kaddoɂan gutii taɂusubtti erbbe kakkaatara ibaaddo lakkogiro, kakkaate gollee adi taɂusubtti erbbe kaddoɂan sarssi guukko tattarshitegudde butto ittuu balɂatara. <verse eid="MAT 9:16"/><verse number="17" style="v" sid="MAT 9:17"/>Kaddoɂan dinbbitoo kaɂusub t'amo kawoyinii maayyona lakkokibataro, gokkibate ade dinbbito ebara, t'amo kawoyiniinna ubatara, dinbbitona laɂo lakkoɂabo, ayesuun goɂameen kaɂusub t'amo kawoyinii kaɂusub dinbbitoo yelamara, hikka garaayi t'amo kawoyiniinna dinbbitona goɂidan isiɂoore adallaatara.»<verse eid="MAT 9:17"/></para>
  <para style="s1">Goyikko takeetetto unnutina iigi takkoɂubatare heleelttitikokki fayyaano</para>
  <para style="r">(<ref loc="MRK 5:21-43">Mar. 5:21-43</ref>; <ref loc="LUK 8:40-56">Luk'. 8:40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18"/>Yesuusa ibaaddo ayeesisaa giraan, Ayihuudikokki woyichchati koo usu horee gilbbisegure, «Unnutti gidda gootetta neefone goggohessoo emeedde genettaa esee gutii kayi» ame. <verse eid="MAT 9:18"/><verse number="19" style="v" sid="MAT 9:19"/>Yesuusana keegure woyichchatine wota seete, Yesuusakko oɂagaalssatareenna usu debee keen.<verse eid="MAT 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20"/>Esekko gees tomonkko lama dubba iigi ubataa abboosa diyaa tagitte heleelttiti too haarre emeettegudde sarssikkeessa dintte.<note caller="-" style="x"><char style="xo" closed="false">9:20 </char><char style="xt" closed="false"><ref loc="NUM 15:38">To. 15:38</ref>; <ref loc="DEU 22:12">Ada. 22:12</ref>.</char></note> <verse eid="MAT 9:20"/><verse number="21" style="v" sid="MAT 9:21"/>Esena wodanattiseeyi, «Sarssikkeessa godine suure fayyinnara» amaa gitte.<verse eid="MAT 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22"/>Yesuusana haar abbaabate heleelttiti deegure, «Allamandde unnutti! Ammanokka ku fayyiisera» ame. Heleelttitina goorsewa fayyiite.<verse eid="MAT 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23"/>Yesuusana min woyichchati tos goggogeeyi malakata ufuufaa, ootaanna oyisaa kagire gosa deegure, <verse eid="MAT 9:23"/><verse number="24" style="v" sid="MAT 9:24"/>«Dubbana hittakko biyaa! Unnu huddurttetta kuwaarre lakkogootetto» ame. Iso goɂameen k'ac'c'ifataa osoleen. <verse eid="MAT 9:24"/><verse number="25" style="v" sid="MAT 9:25"/>Ibaaddo min orrokko kakkobiyaare goorata min orroddee tabegure genettisee abe, unnuna keete. <verse eid="MAT 9:25"/><verse number="26" style="v" sid="MAT 9:26"/>Oduna usu ul dubbaa darɂaantte.<verse eid="MAT 9:26"/></para>
  <para style="s1">Yesuusa iilɂoo kadiyaannon ibaaddo lama fayyiise</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27"/>Yesuusana esekko bee seetaa giraan iilɂo kadiyaannon ibaaddo lama, «Ere kadaawute! Maari» amaa iyyaa usuu debee sesseeteen.<verse eid="MAT 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28"/>Iilɂo odiyaannonna Yesuusa katabero min tos debee tabeen; Yesuusana, «Ani iilɂoɂoottisin denddeesin kadaanddaaro laano ammanattaan?» ame iso hoosate. Isona «Iɂii Goottaa» ameen abbaabeen.<verse eid="MAT 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29"/>Esekkona Yesuusa iilɂoɂoottisoo dinddinegure, «Ammanokkisinkki malee halleewo» ame. <verse eid="MAT 9:29"/><verse number="30" style="v" sid="MAT 9:30"/>Iilɂoɂoottisona deenddeen; Yesuusana, «Hikka maayyona arooɂaddeeso» ame ataayise segee. <verse eid="MAT 9:30"/><verse number="31" style="v" sid="MAT 9:31"/>Iso goɂameen esekko beengureen usu ulii kagiro ibaaddo dubbaan gara kayesuusa ayeeseen.<verse eid="MAT 9:31"/></para>
  <para style="s1">Yesuusa hiɂi kaɂayeeson ibaaddoti fayyiise</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32"/>Iilɂo okkonbanameeran ibaaddojja esekko biyaa giraan battiikki ayyaanaa kaɂabamere hiɂii kaɂayeeson ibaaddoti koo Yesuusa tos keenen. <verse eid="MAT 9:32"/><verse number="33" style="v" sid="MAT 9:33"/>Battiikki ayyaanana kakkobiyaare goorata hiɂi kaɂayeeson ayeesano haggaɂabe; gosana saadegure, «Hikka aankkikki ayees ul kaɂisiraɂeel mute laakkaso» ame.<verse eid="MAT 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34"/>Kafarasaawil ibaaddo ade, «Usu durrisa kakkobeesara kaddurrisa woyichchaayiya» ameen.<note caller="-" style="x"><char style="xo" closed="false">9:34 </char><char style="xt" closed="false"><ref loc="MAT 10:25">Mat. 10:25</ref>; <ref loc="MAT 12:34">12:34</ref>; <ref loc="MRK 3:22">Mar. 3:22</ref>; <ref loc="LUK 11:15">Luk'. 11:15</ref>.</char></note><verse eid="MAT 9:34"/></para>
  <para style="s1">Nenɂeyisatano kayesuusa</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35"/>Yesuusa kaɂayihuudi min kaɂebi agaalssisaa giraan, wononnati kawaakokki geggeloo lallabaa giraan, adena maar orrookki dhukkubaa kahawɂamaro dubba fayyiisaa, katamaaliinna maamanjoolii maraamure.<note caller="-" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="MAT 4:23">Mat. 4:23</ref>; <ref loc="MRK 1:39">Mar. 1:39</ref>; <ref loc="LUK 4:44">Luk'. 4:44</ref>.</char></note> <verse eid="MAT 9:35"/><verse number="36" style="v" sid="MAT 9:36"/>Gosana kafoofiro kawaate idaad aani yaadaanna kaddeero kaliikki leen ogiraan kakkodiyaare goorata nenɂeyisate.<note caller="-" style="x"><char style="xo" closed="false">9:36 </char><char style="xt" closed="false"><ref loc="NUM 27:17">To. 27:17</ref>; <ref loc="1KI 22:17">1 Won. 22:17</ref>; <ref loc="2CH 18:16">2 Od. 18:16</ref>; <ref loc="EZK 34:5">Hiz. 34:5</ref>; <ref loc="ZEC 10:2">Zak. 10:2</ref>; <ref loc="MRK 6:34">Mar. 6:34</ref>.</char></note> <verse eid="MAT 9:36"/><verse number="37" style="v" sid="MAT 9:37"/>Yesuusana usukko oɂagaalssataranne haa ame, «Kakukkuɂaminara kaami kamoogganya, ofelinnaraan goɂameen uc'c'arriyaan, <verse eid="MAT 9:37"/><verse number="38" style="v" sid="MAT 9:38"/>Haanssun kakukkuminnaro kaamikokki Goottaa ofelaraan kakukkuɂamaro kaami tos goggofarroon ebaayen» ame.<note caller="-" style="x"><char style="xo" closed="false">9:38 </char><char style="xt" closed="false"><ref loc="LUK 10:2">Luk'. 10:2</ref>.</char></note><verse eid="MAT 9:38"/></para>
  <chapter eid="MAT 9"/>
  <chapter number="10" style="c" sid="MAT 10"/>
  <para style="s1">Tomonkko lama Yesuusakko oɂagaalssataran</para>
  <para style="r">(<ref loc="MRK 3:13-19">Mar. 3:13-19</ref>; <ref loc="LUK 6:12-16">Luk'. 6:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1"/>Yesuusa usukko oɂagaalssataran isi tos uumegure battiikki ayyaanajjol goggobeesinawunna maar orrookki dhukkubana hawɂaami dubba goggofayyisinawun isoon odonnati sise.<verse eid="MAT 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 10:2"/>Tomonkko lama ofarameeraankonɂi megekkiso hikkaya; isona [P'et'iroosa kaɂamamero] Simoonana abbikkeessa Indiraasa, yiis kazabddoosa Yayik'oobana abbikkeessa Yaannisa, <verse eid="MAT 10:2"/><verse number="3" style="v" sid="MAT 10:3"/>Filp'oosana Berttelomeewosa, Toomaasana k'arat'a kakukkuyisare Matoosa, yiis kaɂilfoosa, Yayik'oobana Tadiyoosa kaɂamamaro Libdiyoosa, <verse eid="MAT 10:3"/><verse number="4" style="v" sid="MAT 10:4"/>ulkkeessan kawudittaamaro Simoona,<note caller="+" style="f"><char style="fr" closed="false">10:4</char><char style="fqa" closed="false">K'enaɂi Simoona, </char><char style="ft" closed="false">hikka Simoonan kallami kasisamera mege, banɂe banɂeeyi fureen min kawaawun kawudittaamaroyya goɂamiro, kakkalee ade balchchumma tabeesatto unakko kooyya amaraan. </char></note> haarre Yesuusa roorise kasisero kaɂask'orotu Yihuuda.<verse eid="MAT 10:4"/></para>
  <para style="s1">Ofarameeraan tomonkko lama agaalssisin faramano</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5"/>Yesuusa hinɂa ofarameeraan tomonkko lama haa kaɂamaro handdaane wota iso fare, «Ayizaab tos arooseetteen; maaɂeeti tasamaarya katamaa tonssa arootabtteen; <verse eid="MAT 10:5"/><verse number="6" style="v" sid="MAT 10:6"/>Seeto gohesoon idaad aani min kaɂisiraɂeelkko kabbayero gosa tos seeyen. <verse eid="MAT 10:6"/><verse number="7" style="v" sid="MAT 10:7"/>Seeyenguddeen ‹Wononnati kadaruure gabbalamera› ama lallabaa.<note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="LUK 10:4-12">Luk'. 10:4-12</ref>.</char></note> <verse eid="MAT 10:7"/><verse number="8" style="v" sid="MAT 10:8"/>Dhukkubaaleessalnna fayyiisa, kagoyero ibaaddona keesa, maarii bar kaɂabona barkko muc'c'isa, durrisana beesa, adda kaɂatatteettaanna adda sisa. <verse eid="MAT 10:8"/><verse number="9" style="v" sid="MAT 10:9"/>Kiisiitisini work'k'ii leere bir taɂamamatto marc'c'okko goorttun medaabkko kafelamero maragade arooɂabatteen. <verse eid="MAT 10:9"/><verse number="10" style="v" sid="MAT 10:10"/>Raakkisinunna shile, k'olo lama, goorttun keferroo goorttun dama arooɂabatteen; aalanttina kafelaroon babo sisamin dootisara.<note caller="-" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="1CO 9:14">1 K'or. 9:14</ref>; <ref loc="1TI 5:18">1 T'im. 5:18</ref>.</char></note><verse eid="MAT 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11"/>«Katamaa goorttun maaman koo tos gotabtteen isin k'op'ayin feɂi kaɂabo ibaaddoti dootaguddeen usu minii foolssayeen; taabeetaani esee adallaayen. <verse eid="MAT 10:11"/><verse number="12" style="v" sid="MAT 10:12"/>Min kamaakkayyona gotabtteen nogodda aata. <verse eid="MAT 10:12"/><verse number="13" style="v" sid="MAT 10:13"/>Isin kak'op'ataraan gollee, nogoddatisin usu min halleeto, isin kak'op'annon gollee adi, nogoddatisin isinuun haɂabbaabatto. <verse eid="MAT 10:13"/><verse number="14" style="v" sid="MAT 10:14"/>Maamisikki ibaaddotina isin k'op'atana gowaate goorttun isin kaɂayeesattaan maalana gowaate hassu minkko goorttun hasse katamaakko biyaa giraan isoon seerisano goggolleeroon luk'k'aɂoottisinkko gorra hurgufayenddeen biyaa.<note caller="-" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="ACT 13:51">Ofa. Fe. 13:51</ref>.</char></note> <verse eid="MAT 10:14"/><verse number="15" style="v" sid="MAT 10:15"/>Ani rumminaa amara, tafirdda arri hasse katamaayi taginnatto murrookko Sodoomina Gomoraayi taginnatta murroo tafuffudaatte leeta.»<note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 11:24">Mat. 11:24</ref>.</char></note><verse eid="MAT 10:15"/></para>
  <para style="s1">Emeeyin tagitto rakkoo</para>
  <para style="r">(<ref loc="MRK 13:3-13">Mar. 13:3-13</ref>; <ref loc="LUK 21:12-17">Luk'. 21:12-17</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16"/>«Idaad aani hiyyeeyi orroo ani isin farnnara, haanssun habeessa aani k'aroolee, arabe aani fayyankkanɂi laa.»<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="LUK 10:3">Luk'. 10:3</ref>.</char></note><verse eid="MAT 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 10:17"/>«Ibaaddona isin abigure firddaawun shonggoo tos geesinnaran; Ayihuudikokki min kaɂebinna isin boc'c'innaraan, haanssun isokko isiɂoorayeen.<note caller="-" style="x"><char style="xo" closed="false">10:17 </char><char style="xt" closed="false"><ref loc="MRK 13:9-11">Mar. 13:9-11</ref>; <ref loc="LUK 12:11-12">Luk'. 12:11-12</ref>; <ref loc="LUK 21:12-15">21:12-15</ref>.</char></note> <verse eid="MAT 10:17"/><verse number="18" style="v" sid="MAT 10:18"/>Aalantti teeyi mootijjol tonssa wonolaal tos firddaan isin geesinaran; iso horeenna Ayizaab horee iin ato linnattan. <verse eid="MAT 10:18"/><verse number="19" style="v" sid="MAT 10:19"/>Firddaan shonggoo tos isin kakkogeeseen goorata memi ayeenssa? Me ami abbaabinna? Ami arooyyaddeen, hassu goorata taɂami ayeessaan isinuun sisanttowa. <verse eid="MAT 10:19"/><verse number="20" style="v" sid="MAT 10:20"/>Isinii kaɂayeesinnara kadaruure Aabbokkisinkki Ayyaana kawaayya kuwaarre lakkoɂisinttaan.»<note caller="-" style="x"><char style="xo" closed="false">10:20 </char><char style="xt" closed="false"><ref loc="MRK 13:12">Mar. 13:12</ref>; <ref loc="LUK 21:16">Luk'. 21:16</ref>.</char></note><verse eid="MAT 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21"/>«Abbi abbikkeessa goyin roorisi sisinnara, odona erekkeessa, yiinssa iso oɂumuleeraan gutii kiinnaraan, lagadisinnaraan. <verse eid="MAT 10:21"/><verse number="22" style="v" sid="MAT 10:22"/>Aalantti teeyi ibaaddo dubba isin diidinara; ayesuun goɂameen taagachcho geeroo kaɂataate usu fayyinara.<note caller="-" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="MAT 24:9">Mat. 24:9</ref>,<ref loc="MAT 24:13">13</ref>; <ref loc="MRK 13:13">Mar. 13:13</ref>; <ref loc="LUK 21:17">Luk'. 21:17</ref>.</char></note> <verse eid="MAT 10:22"/><verse number="23" style="v" sid="MAT 10:23"/>Banɂe tookko gohorooreen banɂe takkalee tos bak'ayeen; ani rumminaa amara, isin taɂisiraɂeeli katamaali feloɂoottisin feli angussannon giraan ere kaɂibaaddo emeeyinara.»<verse eid="MAT 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24"/>«Kaɂagaalssatara, kaɂagaalssisarokko kahandaara goottakkeessakko lakkorooraro.<note caller="-" style="x"><char style="xo" closed="false">10:24 </char><char style="xt" closed="false"><ref loc="LUK 6:40">Luk'. 6:40</ref>; <ref loc="JHN 13:16">Yan. 13:16</ref>; <ref loc="JHN 15:20">15:20</ref>.</char></note> <verse eid="MAT 10:24"/><verse number="25" style="v" sid="MAT 10:25"/>Kaɂagaalsatara kaɂagaalssisaro aani, kahandaarana goottaakkeessa aani gollee leera. Odomineekkisoo ‹Biɂeelzebuli› ami goɂuume, kaminee ibaaddo hikkakko karoore kameellan megee misii uumin waataran?» <note caller="-" style="x"><char style="xo" closed="false">10:25 </char><char style="xt" closed="false"><ref loc="MAT 9:34">Mat. 9:34</ref>; <ref loc="MAT 12:24">12:24</ref>; <ref loc="MRK 3:2">Mar. 3:2</ref>; <ref loc="LUK 11:15">Luk'. 11:15</ref>.</char></note><verse eid="MAT 10:25"/></para>
  <para style="s1">Ayyo abssayin dootisaro</para>
  <para style="r">(<ref loc="LUK 12:4-7">Luk'. 12:4-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26"/>«Haanssun ibaaddo arooɂabssatteen, golate kagira diidaa habeenoni, siyame kagira hamutoni lakkohesiro.<note caller="-" style="x"><char style="xo" closed="false">10:26 </char><char style="xt" closed="false"><ref loc="MRK 4:22">Mar. 4:22</ref>; <ref loc="LUK 8:17">Luk'. 8:17</ref>.</char></note> <verse eid="MAT 10:26"/><verse number="27" style="v" sid="MAT 10:27"/>Haanssun ani isinuun mugudii kasegeero ifaayi ayeesa, nebettisinii kamaaltteettan diidaa beesa awwaajjaa. <verse eid="MAT 10:27"/><verse number="28" style="v" sid="MAT 10:28"/>Soo lagadin kuwaarre neefo lagadin kadanddeennon ibaaddokko arooɂabssatteen; hassukko neefona soonna tabbaanon eleenii baasin kadaanddaaro Waa abssayeen. <verse eid="MAT 10:28"/><verse number="29" style="v" sid="MAT 10:29"/>Dolchchii tooyi kadaddalamaro kimbir lamakko toonna kadaruure Aabbokkisinkkotti feɂi kallayi ulii ii lakkohesso. <verse eid="MAT 10:29"/><verse number="30" style="v" sid="MAT 10:30"/>Metekkisinkki binaanakko duuddo koonna hahesooni dubba katootaameya. <verse eid="MAT 10:30"/><verse number="31" style="v" sid="MAT 10:31"/>Haanssun arooɂabssatteen, kamooggan kimbirjolkko muraattisin takabajaanttetta.»<verse eid="MAT 10:31"/></para>
  <para style="s1">Ibaaddo horee Kiristoosa atotaano</para>
  <para style="r">(<ref loc="LUK 12:8-9">Luk'. 12:8-9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32"/>«Ani kakiristoosayya ame garakkee ibaaddo horee kaɂatotaaron aninna daruurii kagiro Aabbokkee horee atotinara. <verse eid="MAT 10:32"/><verse number="33" style="v" sid="MAT 10:33"/>Ayesuun goɂameen ibaaddoyi horee in kakkakataroon aninna daruurii kagiro Aabbokkeeyi horee usu kakayinnara.» <note caller="-" style="x"><char style="xo" closed="false">10:33 </char><char style="xt" closed="false"><ref loc="2TI 2:12">2 T'im. 2:12</ref>.</char></note><verse eid="MAT 10:33"/></para>
  <para style="s1">Nogodda anlleennon giraan kalekalee biyaano</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34"/>«Ani kakkoonɂemeeyera uluun nogodda keenin lakkoyo; kalekalee beesin kuwarre nogodda keeniin kaɂemeeyero aani isinuun aroolleeno. <verse eid="MAT 10:34"/><verse number="35" style="v" sid="MAT 10:35"/>Ani kakkoonɂemeeyera, ere odokkeessakko, deeleeltiti Aayettiseekko, ooriɂerena soddotisekko iskko darɂiinya. <verse eid="MAT 10:35"/><verse number="36" style="v" sid="MAT 10:36"/>Ibaaddoon diina kallaara kakkeessa kaminee ibaaddowayya.» <note caller="-" style="x"><char style="xo" closed="false">10:36 </char><char style="xt" closed="false"><ref loc="MIC 7:6">Mik. 7:6</ref>.</char></note><verse eid="MAT 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37"/>«Inkko roorise Aabokkeessa goorttun Aayetteessa kageelaatara kakkee liin lakkodootisaro, inkko roorise babbaartiti goorttun deeleeltiti kageelaatara kakkee liin lakkodootisaro. <verse eid="MAT 10:37"/><verse number="38" style="v" sid="MAT 10:38"/>Mask'alittessa sidayire taagooron iin debee kasessennon kakkee liin lakkodootisaro.<note caller="-" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="MAT 16:24">Mat. 16:24</ref>; <ref loc="MRK 8:34">Mar. 8:34</ref>; <ref loc="LUK 9:23">Luk'. 9:23</ref>.</char></note> <verse eid="MAT 10:38"/><verse number="39" style="v" sid="MAT 10:39"/>Isiɂoottessa fayyiisayin kadootatara baasatara, Isiɂootteessa in maraan roorissayi sisayin kadootatara ade fayyisatara.<note caller="-" style="x"><char style="xo" closed="false">10:39 </char><char style="xt" closed="false"><ref loc="MAT 16:25">Mat. 16:25</ref>; <ref loc="MRK 8:35">Mar. 8:35</ref>; <ref loc="LUK 9:24">Luk'. 9:24</ref>; <ref loc="LUK 17:33">17:33</ref>; <ref loc="JHN 12:25">Yan. 12:25</ref>.</char></note><verse eid="MAT 10:39"/></para>
  <para style="s1">Gara kabarɂaara</para>
  <para style="r">(<ref loc="MRK 9:41">Mar. 9:41</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40"/>«Isin kaɂatatara in atatara, inna kaɂatatara ade in kafarero odo atatara.<note caller="-" style="x"><char style="xo" closed="false">10:40 </char><char style="xt" closed="false"><ref loc="MRK 9:37">Mar. 9:37</ref>; <ref loc="LUK 9:48">Luk'. 9:48</ref>; <ref loc="LUK 10:16">10:16</ref>; <ref loc="JHN 13:20">Yan. 13:20</ref>.</char></note> <verse eid="MAT 10:40"/><verse number="41" style="v" sid="MAT 10:41"/>Kahegeroonna kahegerookokki megeeyi kaɂatatara kahegerookotti muraa helatara, k'ulluukkina k'ullummakkokki megee kak'op'atara k'ullummakkotti muraa helatara. <verse eid="MAT 10:41"/><verse number="42" style="v" sid="MAT 10:42"/>Haanssun ani rumminaa amara; maamisikki ibaaddona hinɂa otitiic'c'arkko koo inkko kaɂagaalssataron k'uldubbo too beke ambbalnɂi kasise usu muraa lakkowaaro.»<verse eid="MAT 10:42"/></para>
  <chapter eid="MAT 10"/>
  <chapter number="11" style="c" sid="MAT 11"/>
  <para style="s1">Kat'ammak'aara Yaannisa Yesuusa tos tafarero hoosiin</para>
  <para style="r">(<ref loc="LUK 7:18-35">Luk'. 7:18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1"/>Yesuusa usukko oɂagaalssataran tomonkko lamaan ajaja sise abbaabatere, agaalssisinna lallabin katamaalttisoo tos seete.<verse eid="MAT 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2"/>Kat'ammak'aare Yaannisa min kashaanoo giraan Kiristoosa felaa ogiro felo kakkomaalare goorata usukko oɂagaalssataran usu tos faregure, <verse eid="MAT 11:2"/><verse number="3" style="v" sid="MAT 11:3"/>«Emeetara amamatte kaɂooramatte Kiristoosa atitta? Muu kakkalee ooranna?» ameen hoosaten.<verse eid="MAT 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4"/>Yesuusana abbaabere; «Seeyenguddeen kamaalattanna kadiyaattan Yaannisaan segaa. <verse eid="MAT 11:4"/><verse number="5" style="v" sid="MAT 11:5"/>Iilɂo odiyaannonna dinnaraan, naafaleessalnna sesseeyinnara, maarii bar oɂabaanna muc'c'iɂaminaran, nebee omaaloonna maalinnaraan, ogoyeraanna kinnaraan, hiyyeessalunna kageggeloo wongala lallabaaminara;<note caller="-" style="x"><char style="xo" closed="false">11:5 </char><char style="xt" closed="false"><ref loc="ISA 35:5-6">Isa. 35:5-6</ref>; <ref loc="ISA 61:1">61:1</ref>.</char></note> <verse eid="MAT 11:5"/><verse number="6" style="v" sid="MAT 11:6"/>In kahedannon kasommaasameya» ame.<verse eid="MAT 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7"/>Yaannisakko oɂagaalssataran seeten kakkobuwareen goorata; Yesuusa gara kayaannisa gosaan haa ame ayeese, k'alullattokki ul tos me din beeten? Ambbal kaɂaaɂisatto fiik'e diinyya? <verse eid="MAT 11:7"/><verse number="8" style="v" sid="MAT 11:8"/>Hayya me din beeten? Sarssi kaɂiidaro kasarsatero ibaaddoyya? Sarssi kaɂidan sarssateen oɂiidaraan min kawonolaali giraanwa. <verse eid="MAT 11:8"/><verse number="9" style="v" sid="MAT 11:9"/>Hayya me din beeten? Kahegeroo diinyya? Ii duuddowa kahegerookkona karooreya. <verse eid="MAT 11:9"/><verse number="10" style="v" sid="MAT 11:10"/>Haa amame mas'aafaa k'ulluukkii kakkoons'aafamera usuya, ‹Raakkaa goggoɂekkaasiroon erggichcha kukko horene farnnara.›<note caller="-" style="x"><char style="xo" closed="false">11:10 </char><char style="xt" closed="false"><ref loc="MAL 3:1">Mil. 3:1</ref>.</char></note><verse eid="MAT 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 11:11"/>«Ani rumminaa amara heleelkko kaɂalatero orrokko kat'ammak'aaro Yaannisa aankkikki lakkogiro. Ayesuun goɂame wononnati kadaruureyi dubbaankko kayeraatara usu jiinaatara. <verse eid="MAT 11:11"/><verse number="12" style="v" sid="MAT 11:12"/>Yaannisa kakkot'ammak'are geeskko haggaɂabere hittaari taageeroo wononnati kadaruure kamooggani diidaminara, aaloo ataateen odootataraan helayinaraan, <verse eid="MAT 11:12"/><verse number="13" style="v" sid="MAT 11:13"/>Agaalssisi kahegerool dubbana seera kamuse taa kat'ammak'aare Yaannisa geeranii hegeroo ayeeseran.<note caller="-" style="x"><char style="xo" closed="false">11:13 </char><char style="xt" closed="false"><ref loc="LUK 16:16">Luk'. 16:16</ref>.</char></note> <verse eid="MAT 11:13"/><verse number="14" style="v" sid="MAT 11:14"/>Goortta iso kaɂayeesenan atayin godootatteen usuna emeeyinara kaɂamamere Eelaasa hikka Yaannisaya.<note caller="-" style="x"><char style="xo" closed="false">11:14 </char><char style="xt" closed="false"><ref loc="MAL 4:5">Mil. 4:5</ref>; <ref loc="MAT 17:10-13">Mat. 17:10-13</ref>; <ref loc="MRK 9:11-13">Mar. 9:11-13</ref>.</char></note> <verse eid="MAT 11:14"/><verse number="15" style="v" sid="MAT 11:15"/>Nebe kaɂaba hamaalo!<verse eid="MAT 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16"/>«Hitta alattaan menne wota herreegisira? Giyaayi hamas's'eengureen haa amaa isi isi kaɂuumataro yiis aani laaran.» <verse eid="MAT 11:16"/><verse number="17" style="v" sid="MAT 11:17"/>« ‹Sussullee ufuufinne lakkoduddurttettaan, boochcho bochchinnewa lakkoɂootteen›<verse eid="MAT 11:17"/></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 11:18"/>Yaannisa aamokkona t'amokko isiɂoorate mankkoɂemeete maraan ‹Usu battiikki ayyaanajjol aba!› ameen. <verse eid="MAT 11:18"/><verse number="19" style="v" sid="MAT 11:19"/>Ere kaɂibaaddo aamaanna t'amaa emeete, isona usu ‹Kaɂaamarona kat'amaroya! Usumalee, k'arat'a okukkuyisaraanna «C'ubbaaleyijjool» › kageelaataroyya ameen. K'arumma goɂameen feloɂoottiseeyi addeesante.»<verse eid="MAT 11:19"/></para>
  <para style="s1">C'ubbokko gula galanawaattii kawok'asaamero katamaal</para>
  <para style="r">(<ref loc="MAT 11:20-24">Mat. 11:20-24</ref>; <ref loc="LUK 10:13-15">Luk'. 10:13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20"/>Esekkona Yesuusa kamooggan baasa takkofelero katamaal c'ubbokko mankko gula galanawaaten maraan haa ame wok'asee, <verse eid="MAT 11:20"/><verse number="21" style="v" sid="MAT 11:21"/>«Aanne Koraazi! Aanne Beetesayida! Isinii kafelamera baasa T'iroosiinna Sidoonayi kafelamero lii girewa, horkkowa sarssi gambballakki sarssayi buluulo maarii kikibayi c'ubbokko gula gali girareenwa.<note caller="-" style="x"><char style="xo" closed="false">11:21 </char><char style="xt" closed="false"><ref loc="ISA 23:18">Isa. 23:18</ref>; <ref loc="EZK 26:1">Hiz. 26:1</ref>; <ref loc="EZK 28:26">28:26</ref>; <ref loc="JOL 3:4-8">Iyu. 3:4-8</ref>; <ref loc="AMO 1:9-10">Amo. 1:9-10</ref>; <ref loc="ZEC 9:2-4">Zak. 9:2-4</ref>.</char></note> <verse eid="MAT 11:21"/><verse number="22" style="v" sid="MAT 11:22"/>Haanssun ani isinne haa amara, tafirdda arri isinkko roori T'iroosiwunna Sidoonawun murro suure fuffudaayinaraan. <verse eid="MAT 11:22"/><verse number="23" style="v" sid="MAT 11:23"/>Ati K'ifirenaahoomi daruur tos t'ok'k'i t'ok'k'i amiin dootatte? Ayesuun goɂameen bowwa orroddi innatta! Kuyee kafelamera baasa Sodomiinna felami girewa hittaari gin ese katamaa girattewa.<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="ISA 14:13-15">Isa. 14:13-15</ref>.</char></note> <verse eid="MAT 11:23"/><verse number="24" style="v" sid="MAT 11:24"/>Haanssun ani rumminaa kuun haa amara, tafirdda arri taginnatta murroo tattaakko roori Sodoomiin fuffudaayinnatta!»<note caller="-" style="x"><char style="xo" closed="false">11:24 </char><char style="xt" closed="false"><ref loc="MAT 10:15">Mat. 10:15</ref>; <ref loc="LUK 10:12">Luk'. 10:12</ref>.</char></note><verse eid="MAT 11:24"/></para>
  <para style="s1">Kiristoosa tasisaro foolssi</para>
  <para style="r">(<ref loc="LUK 10:21-22">Luk'. 10:21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25"/>Hassu goorata Yesuusa, «Kadaruurenna kaɂulee Goottaa Aabbo! Hikka k'arooleelkona okasaankko goliisedde yiisun mankkotusse maraan ani ku galataara, ame. <verse eid="MAT 11:25"/><verse number="26" style="v" sid="MAT 11:26"/>Ii Aabbokki! Hikki ku horee feɂi taɂidan leete kuun mutte.<verse eid="MAT 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27"/>«Aabbokki kameen dubba iin sisera, odokko kakkalee ere kakkasa maayyona lakkogiro. Usumaleenna erekko kakkalee odo kamalabira lakkogiro, ere ogeelaateron gotuse kuwaarre odo addeesin kadaanddaara maayyona laagiro.<note caller="-" style="x"><char style="xo" closed="false">11:27 </char><char style="xt" closed="false"><ref loc="JHN 3:35">Yan. 3:35</ref>; <ref loc="JHN 1:18">1:18</ref>; <ref loc="JHN 10:5">10:5</ref>.</char></note><verse eid="MAT 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28"/>«Isin sidane kakkoonɂisilaattetta! Ohartteettan dubba in tos koyeen! Aninna foolssi sisinara. <verse eid="MAT 11:28"/><verse number="29" style="v" sid="MAT 11:29"/>Hark'k'ootakkeenna sidayeen, inkkona agaalssayeen, ani wodanatteeyi fayyankkana kaɂobssaroya, neefottisinunna foolssi helayinattaan.<note caller="-" style="x"><char style="xo" closed="false">11:29 </char><char style="xt" closed="false"><ref loc="JER 6:16">Erm. 6:16</ref>.</char></note> <verse eid="MAT 11:29"/><verse number="30" style="v" sid="MAT 11:30"/>Hark'k'ootakki kaɂisilaannoon sidanettina tafuffuditta.»<verse eid="MAT 11:30"/></para>
  <chapter eid="MAT 11"/>
  <chapter number="12" style="c" sid="MAT 12"/>
  <para style="s1">Tafoolssi arri kabajaanokokki gara</para>
  <para style="r">(<ref loc="MAT 12:1-14">Mat. 12:1-14</ref>; <ref loc="MRK 2:23-28">Mar. 2:23-28</ref>; <ref loc="LUK 6:1-5">Luk'. 6:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1"/>Esekko abbaabatere Yesuusa tafoolssi arri wut'a orromare roore, usukko oɂagaalssataranna mankkoɂuɂeereen marantinuu shawuyeekko ebssateen aateen aamano haggaɂabeen.<note caller="-" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="DEU 23:25">Ada. 23:25</ref>.</char></note> <verse eid="MAT 12:1"/><verse number="2" style="v" sid="MAT 12:2"/>Farasaawiilnna hikka deengureen; «Hikka dee! Kukko oɂagaalssataran tafoolssi arri felamiin odootison felo felaa giraan» ameen.<verse eid="MAT 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3"/>Yesuusana, «Daawutena usune wota kagire ibaaddo kakkoɂuɂeere goorata Daawute kayelero lakkonabbabteettanya?<note caller="-" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1 Sam. 21:1-6</ref>.</char></note> <verse eid="MAT 12:3"/><verse number="4" style="v" sid="MAT 12:4"/>Min kawaa tabe, tuuk'aamolun kuwaarre usuumna leere wota ogireetun aamin feɂi kasisamoon giro kasommaasame babo aame.<note caller="-" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="LEV 24:9">Woy. 24:9</ref>.</char></note> <verse eid="MAT 12:4"/><verse number="5" style="v" sid="MAT 12:5"/>Adena tuuk'aamolun tafoolssi arri iggilisenguren k'ulluukki min kawaa orroo felo gofeleen c'ubbo laanawaatti seera kamuse lakkonabbabtteettanya?<note caller="-" style="x"><char style="xo" closed="false">12:5 </char><char style="xt" closed="false"><ref loc="NUM 28:9-10">To. 28:9-10</ref>.</char></note> <verse eid="MAT 12:5"/><verse number="6" style="v" sid="MAT 12:6"/>Ayesuun goɂameen ani haa amara; k'ulluukki min kawaakko karoorara hittanii gira. <verse eid="MAT 12:6"/><verse number="7" style="v" sid="MAT 12:7"/>Ani ‹Jaarsokko suure shaaga geelaatara› kaɂamamaro haafura me amanoyyo oɂaddesattan leeteenwa k'ulluunɂi gutii lakkofirddaatteen.<note caller="-" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="MAT 9:13">Mat. 9:13</ref>; <ref loc="HOS 6:6">Hos. 6:6</ref>.</char></note> <verse eid="MAT 12:7"/><verse number="8" style="v" sid="MAT 12:8"/>Ere kaɂibaaddo tafoolssi arriwuun Goottayya.»<verse eid="MAT 12:8"/></para>
  <para style="s1">Yesuusa gene kakkonaafattetto ibaaddoti fayyiise</para>
  <para style="r">(<ref loc="MRK 3:1-6">Mar. 3:1-6</ref>; <ref loc="LUK 6:6-11">Luk'. 6:6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9"/>Yesuusa ese banɂekko roore seetegure, Ayihuudikokki min kaɂebi tabe, <verse eid="MAT 12:9"/><verse number="10" style="v" sid="MAT 12:10"/>Eseenna gene kakkonaafattette ibaaddoti koo gire; Yesuusa mootin dootengureen, «Ayihuudin tafoolssi arri ibaaddo fayyiisin feɂi sisanttetta?» ameen hoosaten.<verse eid="MAT 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11"/>Yesuusana, «Isin orrokko ibaaddoti kookkotti idaado Ayihuudin tafoolssi arri gumbbi orroddi goɂiite, idaado kakkoɂiitetto gumbbi orrokko natti isin lakkobeessanya?<note caller="-" style="x"><char style="xo" closed="false">12:11 </char><char style="xt" closed="false"><ref loc="LUK 14:5">Luk'. 14:5</ref>.</char></note> <verse eid="MAT 12:11"/><verse number="12" style="v" sid="MAT 12:12"/>Hayya, ibaaddo idaadokko lakkorooraroya? Haanssun tafoolssi arri taɂidan felin feɂi sisanttetta» ame.<verse eid="MAT 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13"/>Esekkona Yesuusa ibaaddotine, «Genettaa diriirssa» ame, ibaaddotina genetteessa diriirssate, aantti gene taɂidantti aani leete. <verse eid="MAT 12:13"/><verse number="14" style="v" sid="MAT 12:14"/>Farasaawiil goɂameen esekko beengureen Yesuusa misimisii lagadinaan malaɂoyeen.<verse eid="MAT 12:14"/></para>
  <para style="s1">Waawun handdayin kaɂassaabame</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15"/>Yesuusa k'ofattisoo addeesere esekko fakki ame. Gosa kamoogganna usu debee sesseete, kahawɂamare dubba fayyiise. <verse eid="MAT 12:15"/><verse number="16" style="v" sid="MAT 12:16"/>Isiɂoottessa maayyonna goggoseginonkko ataayise isoon segee; <verse eid="MAT 12:16"/><verse number="17" style="v" sid="MAT 12:17"/>Hikki kakkoonleera kahegeroo Isiyaasayi haa amameen oseegaameraan hegero feloo goggohayirawunya.<verse eid="MAT 12:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18"/>«Hikkima! Ani kaɂassaabayeerana ani kageelaatara usuya,</para>
  <para style="q2" vid="MAT 12:18">usu ani kageelaatarona kakkogeggelaataroyya,</para>
  <para style="q2" vid="MAT 12:18">ayyaanakkee usuu gutii kayinnara.</para>
  <para style="q2" vid="MAT 12:18">usuna gosaan karrummii firdda awwaajinara.<verse eid="MAT 12:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19"/>Usu lakkodogaminaro lakkonaɂokkinaro;</para>
  <para style="q2" vid="MAT 12:19">raadiina yaayetteessa kamaalla lakkogiro.<verse eid="MAT 12:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20"/>Karrummii firdda taaɂawoddon geegin;</para>
  <para style="q2" vid="MAT 12:20">kac'anc'c'aname fiik'ena lakkoɂebisiro.</para>
  <para style="q2" vid="MAT 12:20">Kaɂiiyyootaro kamuk'k'ade shalonna lakkobaasiro.<verse eid="MAT 12:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="MAT 12:21"/>Ayizaabna megekkeessayi abddi yelarowa.»<note caller="-" style="x"><char style="xo" closed="false">12:21 </char><char style="xt" closed="false"><ref loc="ISA 42:1-4">Isa. 42:1-4</ref>.</char></note><verse eid="MAT 12:21"/></para>
  <para style="s1">Yesuusana durrisakokki woyichcha</para>
  <para style="r">(<ref loc="MRK 3:20-30">Mar. 3:20-30</ref>; <ref loc="LUK 11:14-23">Luk'. 11:14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22"/>Esekko abbaabatere battiikki ayyaanayi abamanoyi iilɂoo diyaayinna hiɂi ayeesin kawaatero ibaaddoti koo Yesuusa tos aateen emeeten, Yesuusana usu fayyiise, ibaaddotina diinna ayeesin daanddee. <verse eid="MAT 12:22"/><verse number="23" style="v" sid="MAT 12:23"/>Gosa dubba saadegure, «Hikki ibaaddoti ere kadaawute leewuna?» ame.<verse eid="MAT 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24"/>Ayesuun goɂameen Farasaawiil hikka kakkomaalare goorata «Hikki ibaaddoti durrisa kakkobeesara kaddurrisa woyichcha kalleero Biɂeelzebulikkokki hunnaayya» ameen.<note caller="-" style="x"><char style="xo" closed="false">12:24 </char><char style="xt" closed="false"><ref loc="MAT 9:34">Mat. 9:34</ref>; <ref loc="MAT 10:25">10:25</ref>.</char></note><verse eid="MAT 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25"/>Yesuusana k'ofattisoo addeesegure «Isiorroo kalekalee kabiyaara wononnati dubba iinnara. Isisiɂorroo kalekalee tabeete katamaa goorttun min ataayi girin lakkodaanddeero ame. <verse eid="MAT 12:25"/><verse number="26" style="v" sid="MAT 12:26"/>S'alayena s'alaye kabeesatto golleete; isisiɂorroo kalekalee beeran amanoyya; haa gollee ade wononnati misimisii ataayi aallin daanddaara? <verse eid="MAT 12:26"/><verse number="27" style="v" sid="MAT 12:27"/>Ani durrisa kakobeesara durrisakokki woyichchaa gollee; isin debee osessetaran ade meyii beesinnaran? Haanssun yiiskkisinwa isin gutii firddinara. <verse eid="MAT 12:27"/><verse number="28" style="v" sid="MAT 12:28"/>Ani goɂameen durrisa kakkobeesara Ayyaana kawaayi gollee goortta wononnati kawaa isin tos emeetera amanoya.<verse eid="MAT 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29"/>«Goorttun ibaaddoti koo kaɂatii ibaaddotikokki min tabigure urrawoɂoottessa saamiin godoote, t'ayi hassu kaɂatii ibaaddoti anshiinnon giraan misii usuun ekkaatta? Usu shii goɂabbaabate urrawoɂoottessa saamiin daanddaara.<verse eid="MAT 12:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30"/>«Iinne wota kalleenoon dubba in kaneebaataroya, iinne wota kakukkuysannoon dubba darɂaatara. <verse eid="MAT 12:30"/><verse number="31" style="v" sid="MAT 12:31"/>Haanssun ani haa amara, c'ubbo felanona ibaaddo habaarano dubba ibaaddon haheso amaminnara, ayesuun goɂameen Ayyaana K'ulluukki kahabaararoon ade c'ubbo haheso lakkoɂamamaro. <verse eid="MAT 12:31"/><verse number="32" style="v" sid="MAT 12:32"/>Maayyona ere kaɂibaaddo gutii ayees kameellan kaɂayeesaro dubbaan haheso amamara, Ayyaana K'ulluukki gutii ayees kameellan kaɂayeesaron ade hikka alamiinna leere kaɂemeetaro alamii c'ubbo suure haheso lakkoɂamamiro.<note caller="-" style="x"><char style="xo" closed="false">12:32 </char><char style="xt" closed="false"><ref loc="LUK 12:10">Luk'. 12:10</ref>.</char></note><verse eid="MAT 12:32"/></para>
  <para style="s1">Gaa kaɂidan iltteessaa addeesamara</para>
  <para style="r">(<ref loc="LUK 6:43-45">Luk'. 6:43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33"/>«Gaa dubba iltteessaa mankkoɂaddeesamaro maraan il taɂidan goggohelattaanun gaa kaɂidan isinuun hangire; gaa kameellan isinuun gogire ade il tameellan helayinattaan.<note caller="-" style="x"><char style="xo" closed="false">12:33 </char><char style="xt" closed="false"><ref loc="MAT 7:20">Mat. 7:20</ref>; <ref loc="LUK 6:44">Luk'. 6:44</ref>.</char></note> <verse eid="MAT 12:33"/><verse number="34" style="v" sid="MAT 12:34"/>Isin yiis kahabeessa, isin omeellan golleetan kaɂidan ayees ayeesin misii daanddaattan? Ibaaddo wodanatteessaa orroo kaɂammagamero hiɂii ayeesara.<note caller="-" style="x"><char style="xo" closed="false">12:34 </char><char style="xt" closed="false"><ref loc="MAT 3:7">Mat. 3:7</ref>; <ref loc="MAT 23:33">23:33</ref>; <ref loc="MAT 15:18">15:18</ref>; <ref loc="LUK 3:7">Luk'. 3:7</ref>; <ref loc="LUK 6:45">6:45</ref>.</char></note> <verse eid="MAT 12:34"/><verse number="35" style="v" sid="MAT 12:35"/>Kaɂidankki ibaaddo wodanatteessayi kaɂamagamero kaɂidan ayeeskkeessakko taɂidan beesatara, kameellankki ibaaddona wodanatteessayi kaɂamagamero kameellan ayeeskko tameellan beesatara. <verse eid="MAT 12:35"/><verse number="36" style="v" sid="MAT 12:36"/>Ayesuun goɂameen ani haa amara; ibaaddo kaɂayeesaro kamaadinoon ayees dubba marantinuu tafirdda arri hoosaminara. <verse eid="MAT 12:36"/><verse number="37" style="v" sid="MAT 12:37"/>Aalanttina ayeeskkaakko kakkeeyi k'ulloyinnatta, ayeeskkaakko kakkeeyi ati firddaaminatta.»<verse eid="MAT 12:37"/></para>
  <para style="s1">Baasakki malaata diin dootano</para>
  <para style="r">(<ref loc="MRK 8:11-12">Mar. 8:11-12</ref>; <ref loc="LUK 11:29-32">Luk'. 11:29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38"/>Esekkona seera kamuse oɂagaalssisaraankkona Farasaawilkko kookkoo Yesuusane, «Kaɂagaalssisatto! Noo kukko baasakki malaata diin dootanna» ameen.<note caller="-" style="x"><char style="xo" closed="false">12:38 </char><char style="xt" closed="false"><ref loc="MAT 16:1">Mat. 16:1</ref>; <ref loc="MRK 8:11">Mar. 8:11</ref>; <ref loc="LUK 11:16">Luk'. 11:16</ref>.</char></note><verse eid="MAT 12:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39"/>Usu ade abbaabegure isone, «Tameellanna taɂammanoon alattaan malaata diin dootatta; ayesuun goɂameen kahegeroo kayoonasa malaata kuwaarre kakkalee malaata lakkosisaminaro.<note caller="-" style="x"><char style="xo" closed="false">12:39 </char><char style="xt" closed="false"><ref loc="MAT 16:4">Mat. 16:4</ref>; <ref loc="MRK 8:12">Mar. 8:12</ref>.</char></note> <verse eid="MAT 12:39"/><verse number="40" style="v" sid="MAT 12:40"/>Yoonasa arri seendda hemeen seed kanjjiinkki kunɂubkokki bogi orroo goggoɂadallaateroyi, Ere kaɂibaaddo usumalee arri seendda hemeen seed erree orroo k'amalami adallayinnara.<note caller="-" style="x"><char style="xo" closed="false">12:40 </char><char style="xt" closed="false"><ref loc="JON 1:17">Yon. 1:17</ref>.</char></note> <verse eid="MAT 12:40"/><verse number="41" style="v" sid="MAT 12:41"/>Kanennewe ibaaddo tamurtti arri hitta alattaanne wota kiigureen usu gutii firddinara, kanennewe ibaaddo kayoonaasa lallabaano maaleengureen c'ubbokko ogula galeeran, gidda goɂameen Yoonasakko karoorara hittanii gira.<note caller="-" style="x"><char style="xo" closed="false">12:41 </char><char style="xt" closed="false"><ref loc="JON 3:5">Yon. 3:5</ref>.</char></note> <verse eid="MAT 12:41"/><verse number="42" style="v" sid="MAT 12:42"/>Tafirdda arri oori wono Saaba hitta alattaanne wota kiigudde usu gutii firddinatta, tasolomooni k'arumma maalin ulkotti gachchokko emeettetta, gidda goɂameen Solomoonikko karoorara hittanii gira» ame.<note caller="-" style="x"><char style="xo" closed="false">12:42 </char><char style="xt" closed="false"><ref loc="1KI 10:1-10">1 Won. 10:1-10</ref>; <ref loc="2CH 9:1-12">2 Od. 9:1-12</ref>.</char></note><verse eid="MAT 12:42"/></para>
  <para style="s1">Battiikki ayyaana ibaaddo orro abbaabayi tabano</para>
  <para style="r">(<ref loc="LUK 11:24-26">Luk'. 11:24-26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43"/>«Battiikki ayyaana ibaaddotikko kakkobiyaare goorata takkofoolssaro kallayi taɂangayidde banɂe beke dootataa kafafare, tadootatare foolssi ade lakkohelate. <verse eid="MAT 12:43"/><verse number="44" style="v" sid="MAT 12:44"/>Esekkona ‹Kakkogire min tos abbaabayi seewu› amara, abbaabayi kakkoseero goorata min halaal lee, shakaarame kamuc'c'imerona kaɂekkaatero helayinara. <verse eid="MAT 12:44"/><verse number="45" style="v" sid="MAT 12:45"/>Esekko seetegure usukko karoore kakkalee todoba battiikki ayyaanajjol kameellan atayire emeeyinara. Isona ibaaddoti orro tabigureen girnnaraan. Hassu ibaaddotiwunna giri kahoreekko giri kahaaree kameellan linnara. Hitta tameellan alattaan gutii hikkamalee linnara.»<verse eid="MAT 12:45"/></para>
  <para style="s1">Aaye tayesuusana abbilaal</para>
  <para style="r">(<ref loc="MRK 3:31-35">Mar. 3:31-35</ref>; <ref loc="LUK 8:19-21">Luk'. 8:19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46"/>Yesuusa gosaan ayeesaa giraan; Aayetteessana abbilaaltteessa usune eselin dootengureen sarre aalleen gireen. <verse eid="MAT 12:46"/><verse number="47" style="v" sid="MAT 12:47"/>Ibaaddoti koo Yesuusane, «Aayettanna abbilaaltta kuunne wota ayeesin dootengureen sarre aalleenan» ame.<note caller="+" style="f"><char style="fr" closed="false">12:47 </char><char style="ft" closed="false">Kookkoo kabirranna mas'aafal tooto 47 lakkoɂadaro. </char></note><verse eid="MAT 12:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48"/>Yesuusana, «Aayetti ayyotta? Abbilaalttinna ayyoosyyaan?» ame abbaabe. <verse eid="MAT 12:48"/><verse number="49" style="v" sid="MAT 12:49"/>Genettessanna usukko oɂagaalssataran tos tusaa «Aayettina abbilaaltti hinɂayaan; <verse eid="MAT 12:49"/><verse number="50" style="v" sid="MAT 12:50"/>Daruurii kagiro Aabbokkeekkotti feɂi kafelara dubba, abbilaalttee abbalaaltteenna Aac'c'olaaltteenneyyaan.»<verse eid="MAT 12:50"/></para>
  <chapter eid="MAT 12"/>
  <chapter number="13" style="c" sid="MAT 13"/>
  <para style="s1">Kawut'atarokkotti masuussa</para>
  <para style="r">(<ref loc="MRK 4:1-9">Mar. 4:1-9</ref>; <ref loc="LUK 8:4-8">Luk'. 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1"/>Ese arriiwa Yesuusa minkko beegure labu giridii hamas's'ee. <verse eid="MAT 13:1"/><verse number="2" style="v" sid="MAT 13:2"/>Kamooggan gosana kukkuɂamanokko kakkeeyi usu mare mankkoɂabere maraan iso bagaa iisegure wolabooyi tabe hamas's'ee.<note caller="-" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="LUK 5:1-3">Luk'. 5:1-3</ref>.</char></note> <verse eid="MAT 13:2"/><verse number="3" style="v" sid="MAT 13:3"/>Kamooggan ayeenssa masuussayi haa ame segeera, «Otate kabaraare ibaaddoti koo wut'a wut'ayin bee. <verse eid="MAT 13:3"/><verse number="4" style="v" sid="MAT 13:4"/>Wut'ataa giraanna wut'a gamisa raa giridii iyye, kimbirnna emeetegure abaabate aame. <verse eid="MAT 13:4"/><verse number="5" style="v" sid="MAT 13:5"/>Gamisa wut'a tafufudi shak'umooltti erree iyye, errena tafufudi mankkoleetette maraan wut'a saame alate. <verse eid="MAT 13:5"/><verse number="6" style="v" sid="MAT 13:6"/>Ayesuun goɂameen ariti kakkobiyaatte goorata k'oore hidiid aaloo dagisanawattikko kakkeeyi angage. <verse eid="MAT 13:6"/><verse number="7" style="v" sid="MAT 13:7"/>Gamisa wut'ana eɂeen kaɂabo huura orroo iyye, eɂeeninna jiinaattegudde kaɂalatero wut'a marggisse orroo haasse. <verse eid="MAT 13:7"/><verse number="8" style="v" sid="MAT 13:8"/>Kakkalee wut'a ade taɂidan erree gutii iyye, alategure il yelate, koo bool, koo lootam, koonna sonddom il sise. <verse eid="MAT 13:8"/><verse number="9" style="v" sid="MAT 13:9"/>Nebe kaɂaba hamaalo!»<verse eid="MAT 13:9"/></para>
  <para style="s1">Yesuusa masuussaa kakkoonɂayeesero aalantti</para>
  <para style="r">(<ref loc="MRK 4:10-12">Mar. 4:10-12</ref>; <ref loc="LUK 8:9-10">Luk'. 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10"/>Esekko Yesuusakko oɂagaalssataranna usu tos gabbalameengureen, «Mewuun gosaan masuussa ayeesatta?» ameen.<verse eid="MAT 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11"/>Yesuusa abbaabere, «Isinuun wononnati kadaruurekkotti hool malabano sisamera, isoon goɂameen lakkosisamero. <verse eid="MAT 13:11"/><verse number="12" style="v" sid="MAT 13:12"/>Kakkogiroon adamara, mooggaatara, kallayikkikko goɂameen hassu kagirawa suure usukko atamara» ame.<note caller="-" style="x"><char style="xo" closed="false">13:12 </char><char style="xt" closed="false"><ref loc="MAT 25:29">Mat. 25:29</ref>; <ref loc="MRK 4:25">Mar. 4:25</ref>; <ref loc="LUK 8:18">Luk'. 8:18</ref>; <ref loc="LUK 19:26">19:26</ref>.</char></note> <verse eid="MAT 13:12"/><verse number="13" style="v" sid="MAT 13:13"/>Haanssun haa amaa ani masuussayi kakkoon segeera hikkanunya, diyaa giraan odeennon mankkolleen maraan, maalaa giraan omaaloon mankkoleen maraan, goorttun shaadana mankkowaateen maaranya. <verse eid="MAT 13:13"/><verse number="14" style="v" sid="MAT 13:14"/>Kahegeroo Isiyaasayi kasegaamera,</para>
  <para style="q1" vid="MAT 13:14">«Maalano maalinnattan, ayesuun goɂameen lakkoshaadinnattan,</para>
  <para style="q2" vid="MAT 13:14">Diyaanona dinnattaan, ayesuun goɂameen wodanaa lakkoɂabaattaan, haa amame kas'aafamera isoo gutii feloo hayinara;<verse eid="MAT 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15"/>Hikka gosakotti wodanana duuddetta;</para>
  <para style="q2" vid="MAT 13:15">nebetisona lakkomaalatto, goggodeenonkko iilɂoɂoottiso t'ip'imeeraan,</para>
  <para style="q2" vid="MAT 13:15">haa lii waatewa iilɂoɂoottisooyi diigureen,</para>
  <para style="q2" vid="MAT 13:15">nebetisooyi maaligureen,</para>
  <para style="q2" vid="MAT 13:15">wodanattisooyinna shaadigureen,</para>
  <para style="q2" vid="MAT 13:15">in tos abbaabatenwa ani iso fayyiisarewa.»<note caller="-" style="x"><char style="xo" closed="false">13:15 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">Isa. 6:9-10</ref>.</char></note><verse eid="MAT 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16"/>Iilɂoɂoottisin mankkodiyaaran maraan, nebetisinna mankkomaalatto maraan ade osommaasantteettan. <verse eid="MAT 13:16"/><verse number="17" style="v" sid="MAT 13:17"/>Ani rumminaa amara, ohegeroolnna kamooggan k'ulluukki ibaaddo, isin kadiyaattaan diin, isin kamaaltteettaan maalin halchchareen, ayesuun goɂameen isoon lakkoɂekkaatte.<verse eid="MAT 13:17"/></para>
  <para style="s1">Kawut'ataro masuussakotti fureen</para>
  <para style="r">(<ref loc="MRK 4:13-20">Mar. 4:13-20</ref>; <ref loc="LUK 8:11-15">Luk'. 8:11-15</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18"/>«Goorttanun isin wut'a kawut'ataro ibaaddotikotti masuussa maala, <verse eid="MAT 13:18"/><verse number="19" style="v" sid="MAT 13:19"/>Wononnati kawaakkokki haafura maalegure kashaadoon maattaayyotti wodana orrokko kameellan emeeyigure kawut'amero wut'a aatinara. Goortta hikki raa giridii kaɂiyyero wut'aya. <verse eid="MAT 13:19"/><verse number="20" style="v" sid="MAT 13:20"/>Shak'umooltti erree gutii kaɂiyera ade; haafura maalegure goorsewa geggelooyi kaɂatataro ibaaddo aani laara. <verse eid="MAT 13:20"/><verse number="21" style="v" sid="MAT 13:21"/>Ayesuun goɂameen hididi aaloo dagisin mankkowate tanjiin lakkoɂadallaataro; haafurakkokki aalanttii rakkoo goorttun bak'atano goɂemeero goorsewa saame handudufatara. <verse eid="MAT 13:21"/><verse number="22" style="v" sid="MAT 13:22"/>Eɂeen huura orroo kaɂiyyera wut'a haafura maalegure hikka alamii yaadanoyinna durummakkotti k'ofaayi sobamaa marggate il kasisoon wut'a aani laara. <verse eid="MAT 13:22"/><verse number="23" style="v" sid="MAT 13:23"/>Erre taɂidan gutii kawut'amera wut'a goɂameen haafura kawaa maalegure kashaadaro ibaaddo aani laara, hassuna il yelatara, koo bool, koo lootam, koonna sonddom sisinnara.»<verse eid="MAT 13:23"/></para>
  <para style="s1">Sharafakkotti masuussa</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24"/>Yesuusa kakkalee masuussa haa ame segee, «Wononnati kadaruure iraayi wut'a kaɂidan kawut'atero ibaaddoti aani laara. <verse eid="MAT 13:24"/><verse number="25" style="v" sid="MAT 13:25"/>Ayesuun goɂameen ibaaddo dubba huddure giraan diinakkeessa emetegure darggamaatteessa orroo sharafa wut'e seete. <verse eid="MAT 13:25"/><verse number="26" style="v" sid="MAT 13:26"/>Darggamaanna alattedde il yelatano kakkohaggaɂabatte goorata sharafana wota mute.<verse eid="MAT 13:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27"/>«Odo iraan ofelaraan usu tos emetengureen ‹Gootta! Iraa orroo laa wut'a kaɂidan wunt't'ennella? Hayya sharafa haggekko emete?› ameen.<verse eid="MAT 13:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28"/>« ‹Usuna, hinɂi felo odiinayaan› ame.</para>
  <para style="p" vid="MAT 13:28">«Ohandaareenna ‹Seeyigunne sharafa goggotattaginnon dootatta?› ameen hoosaten.<verse eid="MAT 13:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29"/>« ‹Usu goɂameen laa› ame, ‹Aalanttina isin sharafa tataganna amaa darggammaa wota tatayiddaanwa; <verse eid="MAT 13:29"/><verse number="30" style="v" sid="MAT 13:30"/>Isaaga, kaami kukku takkoɂamaro arri taageeron raattoo hajiinaate, eserri omat'aranaanne t'aa sharafa tataga, eleenii goggogubamiro kabal kabalii shaa, darggammaa goɂameen kukkuyisaguddeen gootaraatteeyi kiba ani aminara ame.› »<verse eid="MAT 13:30"/></para>
  <para style="s1">Tasinafic'c'i ilnna irshookkotti masuussa</para>
  <para style="r">(<ref loc="MRK 4:30-32">Mar. 4:30-32</ref>; <ref loc="LUK 13:18-21">Luk'. 13:18-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31"/>Yesuusa kakkalee masuussa, «Wononnati kadaruure ibaaddoti koo aatere irakkeessayi tawut'atero tic'c'artti tasinafic'c'i il aani laatta. <verse eid="MAT 13:31"/><verse number="32" style="v" sid="MAT 13:32"/>Sinafic'c'ikotti il kakkalee wut'ajjool dubbakko tayeraatatto il golleetena, alayidde gojiinaatto adde gaajjol dubbakko muyitegudde, guuntte kabuubara kimbirjol emeetegure ballaal gutii min kakkomadaararo gaa aani laara» ame.<verse eid="MAT 13:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33"/>Giddanna Yesuusa kakkalee masuussaa, «Wononnati kadaruure heleelttiti too t'aamme seed galtte ekkaasse aattedde rigidde talelleddetto irshoo aani laatta» ame.<verse eid="MAT 13:33"/></para>
  <para style="s1">Yesuusa muun gosa agaalssisero</para>
  <para style="r">(<ref loc="MRK 4:33-34">Mar. 4:33-34</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34"/>Yesuusa goɂameen hikka dubba gosaan masuussayi ayeese, masuussa kallayi kaɂayeesamera ayees koonna lakkogire. <verse eid="MAT 13:34"/><verse number="35" style="v" sid="MAT 13:35"/>Hikkina kahegerooyi haa amame kaɂayeesamere feloo haye.</para>
  <para style="q1" vid="MAT 13:35">Hikkina, «Hiɂittee masuussayi banayinnara;</para>
  <para style="q2" vid="MAT 13:35">alami takkomet'amerokko haggaɂabere siyame kagiro ayeesinara.»<note caller="-" style="x"><char style="xo" closed="false">13:35 </char><char style="xt" closed="false"><ref loc="PSA 78:2">Mez. 78:2</ref>.</char></note><verse eid="MAT 13:35"/></para>
  <para style="s1">Tasharafa masuussakkotti fureen</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36"/>Esekko Yesuusa gosa iisegure min tabe; usukko oɂagaalssatareenna usu tos gabbalamengureen «Iraa orroo kagiro sharafa maraan kaɂayeesetto masuussakkotti fureen noon segiina» ameen.<verse eid="MAT 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37"/>Yesuusana, «Kaɂidan wut'a kawut'atera ere kaɂibaaddoyya; <verse eid="MAT 13:37"/><verse number="38" style="v" sid="MAT 13:38"/>Irana hikka alamiyya, kaɂidankki wut'ana wononnati kadaruurekokki ibaaddo tusara, sharafana kas'alaye ibaaddokokki gara tusara; <verse eid="MAT 13:38"/><verse number="39" style="v" sid="MAT 13:39"/>Wut't'egudde taseettetta diina s'alayeetta; wut'a takkokukkuɂaminarana alamikkokki gachcho golleero omat'arinaraanna adeen erggichchalyyan.<verse eid="MAT 13:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40"/>«Sharafana tatagamegure eleenii goggogubamaroo alamikkotti gachcho hikkamalee linatta. <verse eid="MAT 13:40"/><verse number="41" style="v" sid="MAT 13:41"/>Ere kaɂibaaddo erggichchakkeessa farnnara, isona c'ubboon aalantti olleeraanna tameellan ofelaraan dubba abaabigure wononnatikkeessakko beesinnara. <verse eid="MAT 13:41"/><verse number="42" style="v" sid="MAT 13:42"/>Ottanna ilkko fooc'ano mankkogiro tabbeebatto eleenii orroddeesi iso lugudinnara. <verse eid="MAT 13:42"/><verse number="43" style="v" sid="MAT 13:43"/>Hassu goorata k'ulloolee Aabbokkisookki wononnati ariti aani hank'k'ayinnaran. Nebe kaɂaba hamaalo.<verse eid="MAT 13:43"/></para>
  <para style="s1">Siyyameen ogiraan urrawona ink'uukotti masuussa</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44"/>«Wononnati kadaruure iraa orro osiyyaameeraan urrawo aani laara. Ibaaddoti koo ohelatero hinɂa urrawo abbaabe siyyanssate, geggelaatanokko kakkeeyi kaɂabo dubba daddalategure ese taɂira banɂe iminate.<verse eid="MAT 13:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45"/>«Usumaleenna wononnati kadaruure kaɂidankki ink'uu iminayin kadootataro nagaadeti aani laara. <verse eid="MAT 13:45"/><verse number="46" style="v" sid="MAT 13:46"/>Aaloo awɂallokki ink'uu kakkohelatare goorata seetegure kaɂabo dubba daddalategure usu ink'uu iminate.<verse eid="MAT 13:46"/></para>
  <para style="s1">Maarrabikkotti masuussa</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47"/>«Adena wononnati kadaruure beke orroo golugudiraan sannii kamooggan kunɂub taɂabatto maarrabi aani laara. <verse eid="MAT 13:47"/><verse number="48" style="v" sid="MAT 13:48"/>Kunɂub oɂabataraanna kunɂub maarraabi kakkoɂamagamare goorata giiteen baga tos beesen, esekko hamas's'eengureen kaɂidan kaɂidan assaabeen daachchool orroddeeseen kibeen; kameellan kameellanna goɂameen beesen shafeen. <verse eid="MAT 13:48"/><verse number="49" style="v" sid="MAT 13:49"/>Kagachchoo geesnna hikkamalee linnara, irggichchana emeeyigure c'ubbaaleyi k'ullooleekko assaabigure; <verse eid="MAT 13:49"/><verse number="50" style="v" sid="MAT 13:50"/>Oottaninna ilkko fooc'ano mankkogiro tabaanoon eleen tos lugudaminnara.»<verse eid="MAT 13:50"/></para>
  <para style="s1">Kaɂusubkkina kaddoɂankki mazggabakokki gara</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51"/>Yesuusana, «Hikki dubba isinuun tabera?» ame. Isona «Ii» ameen.<verse eid="MAT 13:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52"/>Yesuusa haa ame abbaabe, «Hikki haa amano mete metee seera kamuse kaɂagaalssisara usuna wononnati kadaruure usukko kaɂagaalssataro kalleera kaɂusubkkina kaddoɂankki gootaraakko kabeesaro odo aani laara» ame.<verse eid="MAT 13:52"/></para>
  <para style="s1">Yesuusa tanazireet katamaayi diidamano</para>
  <para style="r">(<ref loc="MRK 6:1-6">Mar. 6:1-6</ref>; <ref loc="LUK 4:16-30">Luk'. 4:16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53"/>Yesuusa hinɂa masuussajjool ayeese goggogudiseeyi ese banɂekko keegure seete. <verse eid="MAT 13:53"/><verse number="54" style="v" sid="MAT 13:54"/>Ulkkeessa tos emetegure Ayihuudikokki min kaɂebii orroo gosa agaalssisano haggaɂabe, isona mamaa haa ameen, «Hikki ibaaddoti hitta k'arummana hikka baasa kakkofello hunna hayekko helatera?» <verse eid="MAT 13:54"/><verse number="55" style="v" sid="MAT 13:55"/>«Hikki laɂere kaɂanaat'iitiyolla? Aayetteessakki mege la Mayiraame amaraanna? Abbilaaltteessa adde Yayik'ooba, Yoosefa, Simoonane Yihuudanneeyaanna? <verse eid="MAT 13:55"/><verse number="56" style="v" sid="MAT 13:56"/>Abbalaalttessanna dubba la noonne wota giraanna? Hayya hikki ibaaddoti hikka dubba hayekko helate?» <verse eid="MAT 13:56"/><verse number="57" style="v" sid="MAT 13:57"/>Haanssun usu haɂatannooni heseen. Yesuusa goɂameen «Kahegeroo kakkokabajaamon ulkkeessayinna minkkeessa kaalaaliya» ame.<note caller="-" style="x"><char style="xo" closed="false">13:57 </char><char style="xt" closed="false"><ref loc="JHN 4:44">Yan. 4:44</ref>.</char></note><verse eid="MAT 13:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58"/>Iso ammananawaattikkotti aalanttii kamooggan baasa esee lakkofele.<verse eid="MAT 13:58"/></para>
  <chapter eid="MAT 13"/>
  <chapter number="14" style="c" sid="MAT 14"/>
  <para style="s1">Kat'ammak'aaro Yaannisakokki goyi</para>
  <para style="r">(<ref loc="MRK 6:14-29">Mar. 6:14-29</ref>; <ref loc="LUK 9:7-9">Luk'. 9:7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1"/>Usu goorata kagaliila ul k'alaadakkeessaa kabariisare mooti Herodoosa, ataan kayesuusakokki gara maale, <verse eid="MAT 14:1"/><verse number="2" style="v" sid="MAT 14:2"/>Usuun ohandaareenne; «Hikki haa gollee kat'ammak'aara Yaannisa goyikko keegure emeetera amanoyya, hikki kasaadamara baasa dubba kakkofelamera usuuyya» ame.<verse eid="MAT 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3"/>T'aye Herodoosa abbikkeessa Filp'oosakkotti oori Herodiyaadakotti aalanttii Yaannisa absisegure minkashaano tabsere.<note caller="-" style="x"><char style="xo" closed="false">14:3 </char><char style="xt" closed="false"><ref loc="LUK 3:19-20">Luk'. 3:19-20</ref>.</char></note> <verse eid="MAT 14:3"/><verse number="4" style="v" sid="MAT 14:4"/>Aalanttina Yaannisa Herodoosane; «Abbikkaatti oori goggoɂatattoo seera feɂi lakkosisaro amaa gire.»<note caller="-" style="x"><char style="xo" closed="false">14:4 </char><char style="xt" closed="false"><ref loc="LEV 18:16">Woy. 18:16</ref>; <ref loc="LEV 20:21">20:21</ref>.</char></note> <verse eid="MAT 14:4"/><verse number="5" style="v" sid="MAT 14:5"/>Haanssun Herodoosa Yaannisa lagadin dootegure gosana usu kahegeroo aani mankkodiyaaro maraantinuu abssate.<verse eid="MAT 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6"/>Herodoosa usu takkoɂalatero arri kabajaataa giraan taherodiyaada ere emeettedde martti horee madarri kaduddurooyi mankkogeggelaayisse maraan, <verse eid="MAT 14:6"/><verse number="7" style="v" sid="MAT 14:7"/>Ese kahoosatte dubba eseen sisin ammato tabe. <verse eid="MAT 14:7"/><verse number="8" style="v" sid="MAT 14:8"/>Unnutina Aayettiseetti markka atattedde, «Kat'ammak'aaro Yaannisakokki mete yaalɂaayi gutii kayigudde iin sisi» antte. <verse eid="MAT 14:8"/><verse number="9" style="v" sid="MAT 14:9"/>Hassu goorata wonona gaddee, halleewo kuwaarre ammatoɂoottessa maraanna usune wota tagitte martti maraan hoosinttisee goggoɂabbaabattoo ajajee. <verse eid="MAT 14:9"/><verse number="10" style="v" sid="MAT 14:10"/>Minkashaano tos ibaaddo faregure kayaannisa mete margikko goosise. <verse eid="MAT 14:10"/><verse number="11" style="v" sid="MAT 14:11"/>Kagoosamero metena yaalɂaayi kayegure unnutiin sise, unnutina aattegudde Aayettiseewun sise. <verse eid="MAT 14:11"/><verse number="12" style="v" sid="MAT 14:12"/>Yaannisakko oɂagaalssatareenna rees atateengureen k'amaleen; esekkona seetengureen kalleerona Yesuusaan segeen.<verse eid="MAT 14:12"/></para>
  <para style="s1">Yesuusa ibaaddo kuma ken aamise</para>
  <para style="r">(<ref loc="MRK 6:30-44">Mar. 6:30-44</ref>; <ref loc="LUK 9:10-17">Luk'. 9:10-17</ref>; <ref loc="JHN 6:1-14">Yan. 6:1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13"/>Yesuusana kalleero ayees kakkomaalare goorata takkogirekko keegure kaletti banɂe too tos wolabooyi tabe seete. Gosana hikka maalegure katamaalkko lukii usu debee sesseeteen. <verse eid="MAT 14:13"/><verse number="14" style="v" sid="MAT 14:14"/>Yesuusana wolabokko dagaagiran kamooggan gosa deegure nenɂeyisate; dhukkubaalkkisokkona fayyiise.<verse eid="MAT 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15"/>Ul hemeen laa kakkoseetare goorata Yesuusakko oɂagaalssatareenna usu tos gabbalameengureen «Hitti banɂe koonna takkoginnoon k'alullattokki ulya; gooratana hemeen mankkollaaro maraan; maamanjoolkko seeyigureen kaɂaamiraan babo goggoɂiminaraawun gosa gafarina» ameen.<verse eid="MAT 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16"/>Yesuusa goɂameen «Iso seeyin lakkodootisaro, iso kaɂaamiraan isinwa sisa» ame.<verse eid="MAT 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17"/>Isona, «Noo hittanii kaɂabnna babo bit'e kenna kunɂub lama kaalaal abnna» ameen.<verse eid="MAT 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18"/>Yesuusana, «Alla kaɂabttaan in tos keena» ame. <verse eid="MAT 14:18"/><verse number="19" style="v" sid="MAT 14:19"/>Esekkona gosa ees gutii goggohamas'iron ajaja sise; babo bit'e kenna kunɂub lamana aategure elddee daruurii tos diyaa galateere babokko ibise aategure usukko oɂagaalssatareenun sise, isona gosaan siseen. <verse eid="MAT 14:19"/><verse number="20" style="v" sid="MAT 14:20"/>Dubbana aameen barareen, esekkona usukko oɂagaalssatareenna tahessetto hanbba dugud tomonkko lama mig keeseen. <verse eid="MAT 14:20"/><verse number="21" style="v" sid="MAT 14:21"/>Kaɂaamere ibaaddo heleelnna yiis kallayi kuma ken kalleero babbaarye.<verse eid="MAT 14:21"/></para>
  <para style="s1">Yesuusa bekee gutii sesseetano</para>
  <para style="r">(<ref loc="MRK 6:45-52">Mar. 6:45-52</ref>; <ref loc="JHN 6:15-21">Yan. 6:15-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22"/>Goorsewa usukko oɂagaalssatareen wolabooyi korayigureen usukko t'ayi bekekko gama goggonak'inawun ajajeegure, ussun ade gosa galisin haar hese. <verse eid="MAT 14:22"/><verse number="23" style="v" sid="MAT 14:23"/>Yesuusa gosa galise abbaabatere ebaayin kee wodami tos bee. Ul taamugud leeron kalekalee esee gire. <verse eid="MAT 14:23"/><verse number="24" style="v" sid="MAT 14:24"/>Hassu goorata wolabona bagakko fakki antte goosse seetaa giraan ambbal keetegudde gaashimallona hore haar shafano haggaɂabe.<verse eid="MAT 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25"/>Hemeenkko saatii saagaalkko abbaabatere Yesuusa bekee gutii sesseetaa usukko oɂagaalssatareen tos emeete. <verse eid="MAT 14:25"/><verse number="26" style="v" sid="MAT 14:26"/>Usukko oɂagaalssatareenna usu bekee gutii sesseetaa kaɂemeetaro kakkodiyaaren goorata absatenguren, «Hitti gaaritta» amaa okkeen.<verse eid="MAT 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27"/>Goorsewa Yesuusa isone, «Allamandde! Aniyya. Arooɂabssatteen» ame.<verse eid="MAT 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28"/>P'et'iroosana, «Goottaa! Goɂatitto ani bekee gutii sesseetaa ku tos goggoɂemeeroon in ajajii» ame.<verse eid="MAT 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29"/>Usuna, «Koyya» ame. P'et'iroosana wolabokko dagegure bekee gutii sesseetaa Yesuusa tos emeetano haggaɂabe.<verse eid="MAT 14:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 14:30"/>Ayesuun goɂameen ambbalkokki hunna kakkodiyaare goorata abssate; bekeeyi ennegamano kakkohaggaɂabare goorata «Goottaa! In haasi» ame okkee.<verse eid="MAT 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31"/>Yesuusa saame genetteessa diriirssate usu abegure, «Ati ammano kakoonhank'atera! Muun hedatte?» ame.<verse eid="MAT 14:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32"/>Yesuusana P'et'iroosa wolaboo gutii korataawa ambbal c'alɂi antte. <verse eid="MAT 14:32"/><verse number="33" style="v" sid="MAT 14:33"/>Wolabooyi orroo ogireen, «Rumminaa ati ere kawaatta» amengureen gilbbiseen usuun sagadeen.<verse eid="MAT 14:33"/></para>
  <para style="s1">Yesuusa kagenssaaret'i ulii kahawɂaamare ibaaddo fayyiise</para>
  <para style="r">(<ref loc="MRK 6:53-56">Mar. 6:53-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34"/>Yesuusana usukko oɂagaalsatareen bekekko gama nak'eengureen Genssaaret'i taɂamamatto banɂe tos geen. <verse eid="MAT 14:34"/><verse number="35" style="v" sid="MAT 14:35"/>Usu ulkki ibaaddo Yesuusa laano kakkoɂaddeesare goorata gobobii kagiro maamanjool dubbaan handdaa fareen; kahawɂamaro ibaaddo dubba usu tos keensiseen. <verse eid="MAT 14:35"/><verse number="36" style="v" sid="MAT 14:36"/>Ohawɂaamareenna sarssikkeessakkotti sharffi taalaal dinin feɂi goggosisiroon ebaaten. Usu odineen dubba duuddo fayyeen.<verse eid="MAT 14:36"/></para>
  <chapter eid="MAT 14"/>
  <chapter number="15" style="c" sid="MAT 15"/>
  <para style="s1">Woga kafarasaawi</para>
  <para style="r">(<ref loc="MRK 7:1-13">Mar. 7:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1"/>Esekkona Iyyerusaalemikko oɂemeeteran Farasaawiilnna seera kamuse oɂagaalssisaran Yesuusa tos gabbalamengureen, <verse eid="MAT 15:1"/><verse number="2" style="v" sid="MAT 15:2"/>«Kukko oɂagaalssataran woga kaɂodolaal kakkoɂiggilissaraan mewuunya? Babo aamin genettisoo lakkoɂaalaran» ame.<verse eid="MAT 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3"/>Yesuusana haa ame abbaabe; «Isinna wogakkisinuun antteengudden ajaja kawaa muun iggilissattaan? <verse eid="MAT 15:3"/><verse number="4" style="v" sid="MAT 15:4"/>Waa, ‹Aabbokkaanna Aayettaa kabajii,› ‹Maayyona Aabbokkeessa goorttun Aayetteessa gutii kameellan haafura kaɂenggee kaɂayeesara hagoye ami ajaja gosisiro,›<note caller="-" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="EXO 20:12">Biy. 20:12</ref>; <ref loc="EXO 21:17">21:17</ref>; <ref loc="DEU 5:16">Ada. 5:16</ref>; <ref loc="LEV 20:9">Woy. 20:9</ref>.</char></note> <verse eid="MAT 15:4"/><verse number="5" style="v" sid="MAT 15:5"/>Isin goɂameen Aabbokkeessa goorttun Aayetteessa, ‹Ani isinuun sisin kadootisaro gargaarssa Waawun jaarsso yele ani sisera› goɂame, <verse eid="MAT 15:5"/><verse number="6" style="v" sid="MAT 15:6"/>hassu ibaaddoti ‹Aabbokkeessa goorttun Aayetteessa kabajin lakkodootisaro› amattaan; haanssun wogakisinuun antteengudden haafura kawaa iggilissattaan.<note caller="+" style="f"><char style="fr" closed="false">15:6 </char><char style="fqa" closed="false">Aabbokkeessa; </char><char style="ft" closed="false">kookkoo kagalbbaa mas'aafajjool, «Aabbokkeessa goorttun Aayetteessa» amara. </char></note> <verse eid="MAT 15:6"/><verse number="7" style="v" sid="MAT 15:7"/>Isin ifissaaddolee Isiyaasa isin maraan hegero kaɂayeesera rummiya.<verse eid="MAT 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8"/>« ‹Hikki gosa in hiɂii kabajaara;</para>
  <para style="q2" vid="MAT 15:8">Wodanattiso goɂameen inkko fakki taɂanttetta;<verse eid="MAT 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9"/>Iso in adda hedooyisataran;</para>
  <para style="q2" vid="MAT 15:9">Agaalssiskisona woga kaɂibaaddoo maleeya.› »<note caller="-" style="x"><char style="xo" closed="false">15:9 </char><char style="xt" closed="false"><ref loc="ISA 29:13">Isa. 29:13</ref>.</char></note><verse eid="MAT 15:9"/></para>
  <para style="s1">Ibaaddo kabattoyisaro kooko</para>
  <para style="r">(<ref loc="MRK 7:14-23">Mar. 7:14-23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10"/>Yesuusa gosa isi tos uumegure haa ame, «Maala! Shaada! <verse eid="MAT 15:10"/><verse number="11" style="v" sid="MAT 15:11"/>Ibaaddo kabbattoyisara hiɂikko kabeyaaro kuwaarre hiɂi orroddee katabaro lakkoyo!»<verse eid="MAT 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12"/>Esekkona usukko oɂagaalssatareen usu tos gabbalameengureen «Farasaawiil ati kaɂanttetto maalengureen goggoɂamarateeran deete?» ameen.<verse eid="MAT 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13"/>Yesuusa goɂameen, «Kadaruure Aabbokki kaɂabbaroon alat dubba tagaminara. <verse eid="MAT 15:13"/><verse number="14" style="v" sid="MAT 15:14"/>Isaaga, iilɂo odiyaannon ok'ajeelisaraan iso ussun ilɂo odeyaannonyaan. Iilɂo kadiyaannon iilɂo kadiyaannon gogeggeesiro iso lama raattoo isi abateen laga orroddeen iyaaran.»<note caller="-" style="x"><char style="xo" closed="false">15:14 </char><char style="xt" closed="false"><ref loc="LUK 6:39">Luk'. 6:39</ref>.</char></note><verse eid="MAT 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15"/>P'et'iroosana Yesuusane, «Masuussakotti fureen noon addeesisi» ame.<verse eid="MAT 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16"/>Yesuusana haa ame, «Isin gidda gin lakkoshaaddeettan amanoyya?» <verse eid="MAT 15:16"/><verse number="17" style="v" sid="MAT 15:17"/>«Hiɂine katabara dubbana bogi orroddee tabegure esekkona sarddee kabeyaaro lakkokassaanya? <verse eid="MAT 15:17"/><verse number="18" style="v" sid="MAT 15:18"/>Hiɂikko kabeyaara goɂameen wodanakko kabeyaaroyya, ibaaddona ‹kabbattoyisara› usuya.<note caller="-" style="x"><char style="xo" closed="false">15:18 </char><char style="xt" closed="false"><ref loc="MAT 12:34">Mat. 12:34</ref>.</char></note> <verse eid="MAT 15:18"/><verse number="19" style="v" sid="MAT 15:19"/>Tameellan k'ofa, neefo lagadano, layimano, sharmmut'aano, hetano, t'ara atotaanona mege baasano hikki dubba wodanakko kiyaara. <verse eid="MAT 15:19"/><verse number="20" style="v" sid="MAT 15:20"/>Ibaaddo ‹kabbattoyisara› hikkaya kuwaarre genenno haɂaalooni babo aamano ibaaddo lakko battooyisaro.»<verse eid="MAT 15:20"/></para>
  <para style="s1">Takanaɂaani heleelttitikkokki ammano</para>
  <para style="r">(<ref loc="MRK 7:24-30">Mar. 7:24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21"/>Yesuusana esekko beegure T'iroosi tonssa Sidoona kaɂamamaro kakkatamaa gobob tos seete. <verse eid="MAT 15:21"/><verse number="22" style="v" sid="MAT 15:22"/>Kakkanaɂaan ulkkotti heleelttiti too usu maamankko beetegudde Yesuusa tos emeettedde «Goottaa! Ere kadaawute iin nenɂeyisana, eretti battiikki ayyaanayi abanttegudde aaloo abboosaatta antte okkiite.»<verse eid="MAT 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23"/>Yesuusa goɂameen haafura koonna lakkoɂabbaabe, hassu goorata Yesuusakko oɂagaalssatareen usu tos emetengureen «Hitti heleelttiti noo debee sesseetaa iyyaatta ese galissewaɂiis?» ameen hoosaten.<verse eid="MAT 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24"/>Yesuusana abbaabere, «Ani kakkonfaramera min kaɂisiraɂeelkko kabayero idaadjjool kaalaalunyya» ame.<verse eid="MAT 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25"/>Heleelttitina lukitteessa gutii iitegudde «Goottaa in gargaarna!» antte.<verse eid="MAT 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26"/>Yesuusana abbaabere, «Babo kayiis aatigureen keroorun shafano lakko dootisaro» ame.<verse eid="MAT 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27"/>Esena, «Ii Goottaa!» «Keroornna odokkeessati dugudkko taɂiitetto orroontti aamara» antte.<verse eid="MAT 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28"/>Hassu goorata Yesuusa, «Ati heleelttiti ammanokka kaɂatiiya! Halchchakkaakki malee kuun halleewo» ame. Unnutina hassu gooratakko haggaɂabttedde fayyiite.<verse eid="MAT 15:28"/></para>
  <para style="s1">Yesuusa baasayi dhukkubaaleessaal fayyiise</para>
  <para style="r">(<ref loc="MRK 7:31-37">Mar. 7:31-37</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29"/>Yesuusa esekko keegure tagaliila labu girii taggitto banɂe seetegure wodami tos bee esee hamas's'ee. <verse eid="MAT 15:29"/><verse number="30" style="v" sid="MAT 15:30"/>Tootooyi kamooggan kallee gosana kaɂeesare, iilɂo kadiyaannon, naafaleessaal, hiɂi oɂayyeesoon, usumaleenna kakkaleekki kamooggan dhukkubaleessaal abeen usu tos keenenguren luk'k'aɂoottessa hegelii hamas'iseen; usuna fayyiise. <verse eid="MAT 15:30"/><verse number="31" style="v" sid="MAT 15:31"/>Gosana hiɂi kaɂayeesoonna ayeesano, naafaleessaalnna iidano, kaɂeesarena tukkul aalli sesseetano, ilɂo kadiyaannonna diyaano, kakkodeyaaren goorata, kaɂisiraɂeel Hedo galateen.<verse eid="MAT 15:31"/></para>
  <para style="s1">Yesuusa ibaaddo kuma afar babo aamisano</para>
  <para style="r">(<ref loc="MRK 8:1-10">Mar. 8:1-10</ref>; <ref loc="MAT 14:13-21">Mat. 14:13-21</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32"/>Yesuusa usukko oɂagaalssataran uumegure «Gosa iinne wota arri seed mankkohayero maraan kaɂaamiraan mankkowaatenaan maraan ani isoon nenɂeyisatara, raadii uuɂigureen ul goggoɂiinnoonkko uɂine gafarin ani feɂi lakkosisinaro» ame.<verse eid="MAT 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33"/>Usukko oɂagaalssatareenna «Hikka koonna kallayikki k'alullattokki uli, hikka gosa dubbaan kalleero babo aamisin no hayekko helnanna?» ameen.<verse eid="MAT 15:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34"/>Yesuusana, «Golleenna isin babo bit'e miyyaa abttaan?» ame hoosate. Isona; babo bit'e titiic'c'ar «Todobana» «kunɂubja otitiic'c'ar abnna» ameen.<verse eid="MAT 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35"/>Usuna gosa ul goggohamas'iroon feɂi sise; <verse eid="MAT 15:35"/><verse number="36" style="v" sid="MAT 15:36"/>Babo bit'e todobanna kunɂubja abegure Waa sommaasate abbaabategure babo eɂebise usukko oɂagaalssatareenun sise, isona gosaan hedeeden. <verse eid="MAT 15:36"/><verse number="37" style="v" sid="MAT 15:37"/>Dubbana aameen barareen, usukko oɂagaalssatareenna tahessetto hanbba dugud todoba mig keeseen. <verse eid="MAT 15:37"/><verse number="38" style="v" sid="MAT 15:38"/>Kaɂaamere ibaaddona heleelnna yiinssa antootamonii kuma afar babbaarye. <verse eid="MAT 15:38"/><verse number="39" style="v" sid="MAT 15:39"/>Yesuusa gosa galse abbaabatere wolabooyi tabere kamegedooli ul tos seete.<verse eid="MAT 15:39"/></para>
  <chapter eid="MAT 15"/>
  <chapter number="16" style="c" sid="MAT 16"/>
  <para style="s1">Waakko malaata din tahoosanttetto hoosin</para>
  <para style="r">(<ref loc="MRK 8:11-13">Mar. 8:11-13</ref>; <ref loc="LUK 12:54-56">Luk'. 12:54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1"/>Farasaawiilnna Sodok'aawil Yesuusa tos gabbalameengureen c'aafin dootengureen, «Waakko malaata noon tusi» ameen hoosaten.<note caller="-" style="x"><char style="xo" closed="false">16:1 </char><char style="xt" closed="false"><ref loc="MAT 12:8">Mat. 12:8</ref>; <ref loc="LUK 11:16">Luk'. 11:16</ref>.</char></note><verse eid="MAT 16:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 16:2"/>Usuna abbaabere, «Hemeen ‹Daruur heela golleeto c'aaminnara› amattaan. <verse eid="MAT 16:2"/><verse number="3" style="v" sid="MAT 16:3"/>Babbarnssa ‹Daruur gambballa leete isilaattetta, haanssun idaamo ubayinara› amattaan, tadaruure middi malabiin daanddaattan, ayesuun goɂameen geeskokki malaata addeesin lakkodaanddaattan.<note caller="+" style="f"><char style="fr" closed="false">16:3</char><char style="ft" closed="false">Kookkoo tagalbbaa s'uufil tooto 2nna 3 kagiro kayesuusa ayees lakkoɂadaraan. </char></note> <verse eid="MAT 16:3"/><verse number="4" style="v" sid="MAT 16:4"/>Tameellanna tasharmut'aatta alattaan malaata dootatta, ayesuun goɂameen kayoonasa malaata kuwaarre kakkalee malaata lakkosisamaro» esekko Yesuusa iso iise seete.<note caller="-" style="x"><char style="xo" closed="false">16:4 </char><char style="xt" closed="false"><ref loc="MAT 12:39">Mat. 12:39</ref>; <ref loc="LUK 11:29">Luk'. 11:29</ref>.</char></note><verse eid="MAT 16:4"/></para>
  <para style="s1">Kafarasaawilnna kasodok'aawil agaalssisi kameellan</para>
  <para style="r">(<ref loc="MAT 16:5-12">Mat. 16:5-12</ref>; <ref loc="MRK 8:14-21">Mar. 8:14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5"/>Yesuusakko oɂagaalssatareen bekekko gama kakkonak'areen goorata babo abatano illootereen. <verse eid="MAT 16:5"/><verse number="6" style="v" sid="MAT 16:6"/>Yesuusana, «Isiɂoorayeen» «Tafarasaawilnna tasodok'aawilkkotti meellanekko isiɂoottisin oorayeen» ame.<note caller="-" style="x"><char style="xo" closed="false">16:6 </char><char style="xt" closed="false"><ref loc="LUK 12:1">Luk'. 12:1</ref>.</char></note><verse eid="MAT 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7"/>Isona isiɂisiɂorroo, «Noo babo haɂabannoonii mankkogginno maraan leera» ameen.<verse eid="MAT 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8"/>Yesuusana k'ofattisoo addeesere, «Isin ammano okkoonhank'atera! Isin isiɂisirroo babo abatanawaatti muun ayeesattan? <verse eid="MAT 16:8"/><verse number="9" style="v" sid="MAT 16:9"/>Babo bit'e kenno kuma ken ibaaddon leegure dugud miyyaa falayite kakkeessettaan lakkoshaadattaanya?<note caller="-" style="x"><char style="xo" closed="false">16:9 </char><char style="xt" closed="false"><ref loc="MAT 14:17-21">Mat. 14:17-21</ref>.</char></note> <verse eid="MAT 16:9"/><verse number="10" style="v" sid="MAT 16:10"/>Usumaleenna babo bit'e todoba kuma afar ibaaddon leegure kafalayero dugud miyyaa horekko keessettaan wodanaayi lakkoɂabattettaan amanoyya?<note caller="-" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="MAT 15:34-38">Mat. 15:34-38</ref>.</char></note> <verse eid="MAT 16:10"/><verse number="11" style="v" sid="MAT 16:11"/>Hayya ani isinuun kasegeera gara kababoo laanawaatti misii shaadanawaattan? Giddanna tafarasaawilkkona tasodok'aawil meellanekko isiɂoorayeen.» <verse eid="MAT 16:11"/><verse number="12" style="v" sid="MAT 16:12"/>Usu isone isiɂoorayeen kakkoonɂamera kaamii takibamatto irshoo anlleennon giraan; Farasaawilkkokkina Sodok'aawilkokki agaalssisikko isiɂooraayeen kaɂamaro laano isoon addeesame.<verse eid="MAT 16:12"/></para>
  <para style="s1">P'et'iroosa gara kayesuusa Kiristoosa ayeesano</para>
  <para style="r">(<ref loc="MRK 8:27-30">Mar. 8:27-30</ref>; <ref loc="LUK 9:18-21">Luk'. 9:18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13"/>Yesuusa ul kafilip'isiyoosa K'isaariya kaɂamamaro ul kakkogiyaare goorata usukko oɂagaalssatareenne, «Ibaaddo ere kaɂibaaddo ayyoyya amara?» ame hoosate.<verse eid="MAT 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14"/>Isona, «Kookkoo kat'ammak'aaro Yaannisayya, kakkalee ade Eelaasaya, kuukina ade Ermaasaya, goorttun kahegeroolkko kooyya» amaraan ameen.<note caller="-" style="x"><char style="xo" closed="false">16:14 </char><char style="xt" closed="false"><ref loc="MAT 14:1-2">Mat. 14:1-2</ref>; <ref loc="MRK 6:14-15">Mar. 6:14-15</ref>; <ref loc="LUK 9:7-8">Luk'. 9:7-8</ref>.</char></note><verse eid="MAT 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15"/>Yesuusana, «Isin addeen in ayyoyya amattaan?» ame.<verse eid="MAT 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16"/>Simoona kaɂamamara P'et'iroosana, «Ati arddokki ere kawaa Kiristoosatta» ame abbaabe.<verse eid="MAT 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17"/>Yesuusana haa ame «Ere kayoona Simoona! Ati kasommaasanttetta, hikka kuun katusera daruurii kagiro Aabbokkee kuwaarre ibaaddo lakkoyo. <verse eid="MAT 16:17"/><verse number="18" style="v" sid="MAT 16:18"/>Ati P'et'iroosatta, hikka eɂemo gutii amaniil kakkokukkuɂamiro min ani madaarinnara, tabaanoon eleenkokki hunnana usu min lakkoɂawodiro. <verse eid="MAT 16:18"/><verse number="19" style="v" sid="MAT 16:19"/>Wononnati kadaruure kakkobanaraan k'ulffi ani kuun sisinnara; ati ulii kashiite daruurii kashaame linnara; ati ulii kafurttena daruurii kafurame linnara.»<note caller="-" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="MAT 18:18">Mat. 18:18</ref>; <ref loc="JHN 20:23">Yan. 20:23</ref>.</char></note> <verse eid="MAT 16:19"/><verse number="20" style="v" sid="MAT 16:20"/>Esekko abbaabatere usu Kiristoosa laanokkeessa maayyoonna goggoɂayeesonkko usukko oɂagaalssatareenun ataayise segee.<verse eid="MAT 16:20"/></para>
  <para style="s1">Yesuusa gowaanona goyikko kiyaanokokki gara ayeese</para>
  <para style="r">(<ref loc="MRK 8:31-33">Mar. 8:31-33</ref>; <ref loc="LUK 9:22-27">Luk'. 9:22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21"/>Yesuusa hassu gooratakko haggaɂabegure «Iyyerusaalemi tos seeyigure eseenna gene tajaarssoleeyi, tuuk'aamolkokki woyichchaalnna seera kamuse oɂagaalssisaraankkotti geneyi rakkoo atayire kagoyinnarona arri taseedi goyikko kiyaano» kadootisaro laano usukko oɂagaalssatareenun segaano haggaɂabe.<verse eid="MAT 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22"/>P'et'iroosana Yesuusa kale aate beegure; «Goottaa! Hikka aankkikki ayees ijjii ku aroogeenno» amaa hadisano haggaɂabe.<verse eid="MAT 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23"/>Yesuusana P'et'iroosa tos kambbal amere, «Ati s'alaye hittakko buuyi! K'ofa taɂibaaddo kuwaarre k'ofa tawaa addeesin mankkodaanddeenon maraan ati iin handuddufo laatta ame.»<verse eid="MAT 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24"/>Esekkona Yesuusa usukko oɂagaalssatareenne, «Iin debee sesseyiin kageelaatara isiɂoottessa hakakato, rakkoowunna goyiin isiɂootteessa roorssayi sisayire iin debee hasesseeto ame.<note caller="-" style="x"><char style="xo" closed="false">16:24 </char><char style="xt" closed="false"><ref loc="MAT 10:38">Mat. 10:38</ref>; <ref loc="LUK 14:27">Luk'. 14:27</ref>.</char></note> <verse eid="MAT 16:24"/><verse number="25" style="v" sid="MAT 16:25"/>Neefotteessa haasayiin kadootatara dubba baasatara, ayesuun goɂameen neefotteessa in maraan kabaasatara dubba helatara.<note caller="-" style="x"><char style="xo" closed="false">16:25 </char><char style="xt" closed="false"><ref loc="MAT 10:39">Mat. 10:39</ref>; <ref loc="LUK 17:33">Luk'. 17:33</ref>; <ref loc="JHN 12:25">Yan. 12:25</ref>.</char></note> <verse eid="MAT 16:25"/><verse number="26" style="v" sid="MAT 16:26"/>Ibaaddo alami dubbakko worɂe gohelate, neefo goɂameen gowaate me laɂo helatara? Goorttun neefokkotti banɂee me mura helayinara? <verse eid="MAT 16:26"/><verse number="27" style="v" sid="MAT 16:27"/>Ere kaɂibaaddo Aabbokkeessakkotti kabajaayi erggichchane wota emeeyinnara; ibaaddoon metemeteeyi feloɂootteessakki malee muraa murinnara.<note caller="-" style="x"><char style="xo" closed="false">16:27 </char><char style="xt" closed="false"><ref loc="MAT 25:31">Mat. 25:31</ref>; <ref loc="PSA 62:12">Mez. 62:12</ref>; <ref loc="ROM 2:6">Rom. 2:6</ref>.</char></note> <verse eid="MAT 16:27"/><verse number="28" style="v" sid="MAT 16:28"/>Ani rumminaa amara; hittanii kagiro ibaaddokko ere kaɂibaaddo wono lee emeetaa giraan taa deeroon kagoonoon ibaaddo gira.» ame.<verse eid="MAT 16:28"/></para>
  <chapter eid="MAT 16"/>
  <chapter number="17" style="c" sid="MAT 17"/>
  <para style="s1">Yesuusakotti middi iggilissamano</para>
  <para style="r">(<ref loc="MRK 9:2-13">Mar. 9:2-13</ref>; <ref loc="LUK 9:28-36">Luk'. 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1"/>Arri lekko abbaabatere Yesuusa P'et'iroosanee, Yayik'oobanee, usumalee kayayik'ooba abbi Yaannisanee wodami too tanjiintti t'ok'k'i taɂantte tos kale aate bee.<note caller="-" style="x"><char style="xo" closed="false">17:1 </char><char style="xt" closed="false"><ref loc="2PE 1:17">2 P'et. 1:17</ref>.</char></note> <verse eid="MAT 17:1"/><verse number="2" style="v" sid="MAT 17:2"/>Esee isoo horee midditteessana iggilissantte, horetteessa ariti aani hank'k'ayite, sarssikkeessana ifa aani wola ame hank'k'aye. <verse eid="MAT 17:2"/><verse number="3" style="v" sid="MAT 17:3"/>Esekkona Musena Eelaasana Yesuusane wota ayeesaa giraan muteen.<verse eid="MAT 17:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4"/>P'et'iroosana Yesuusane, «Goottaa! Noo hittanii girnnewa noyeen kaɂidanyya; feɂittaa golleete daase too kuyeen, too Museen, too Eelaasan daase seed ani madaarro» ame.<verse eid="MAT 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5"/>Usuna ayeesaa giraan kahank'k'aara duumanchcha kagumaari iso hogoogisere duumanchchaayi orroo, «Ani usuuyi kakkogeggelaayinnarana ani kageelaatara erekki hikkaya, usuna maala» taɂamatta yaaye maalssantte.<note caller="-" style="x"><char style="xo" closed="false">17:5 </char><char style="xt" closed="false"><ref loc="GEN 22:2">Met'. 22:2</ref>; <ref loc="DEU 18:15">Ada. 18:15</ref>; <ref loc="PSA 2:7">Mez. 2:7</ref>; <ref loc="ISA 42:1">Isa. 42:1</ref>; <ref loc="MAT 3:17">Mat. 3:17</ref>; <ref loc="MAT 12:8">12:8</ref>; <ref loc="MRK 1:11">Mar. 1:11</ref>; <ref loc="LUK 3:22">Luk'. 3:22</ref>.</char></note><verse eid="MAT 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6"/>Usukko oɂagaalssatareenna hikka kakkomaalareen goorata neenguren hore hore ul iyyeen. <verse eid="MAT 17:6"/><verse number="7" style="v" sid="MAT 17:7"/>Yesuusana iso tos gabbalamere dinddinegure, «Kiyaa, arooɂabssatteen» ame. <verse eid="MAT 17:7"/><verse number="8" style="v" sid="MAT 17:8"/>Iso t'ok'k'i ami godeeran Yesuusa kuwaarre kakkalee maayyona lakkodeeran.<verse eid="MAT 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9"/>Wodami guukko dagaagiran Yesuusa, «Ere kaɂibaaddo goyikko taakeeroo gin kaddeetettaan maayyonna arooɂayeesseen» ame ajajee.<verse eid="MAT 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10"/>Usukko oɂagaalssatareenna, «Hayya seera kamuse oɂagaalssisaran Eelaasa t'ayi emeetano dootisara kakkoɂamaraan muunya?» ameen Yesuusa hoosaten.<note caller="-" style="x"><char style="xo" closed="false">17:10 </char><char style="xt" closed="false"><ref loc="MAL 4:5">Mil. 4:5</ref>.</char></note><verse eid="MAT 17:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11"/>Usuna isoon abbaabere, «Ogiraan Eelaasa emeeyigure kaɂameen dubbana gachchooɂekkaasira; <verse eid="MAT 17:11"/><verse number="12" style="v" sid="MAT 17:12"/>Ayesuun goɂameen ani haa amara, Eelaasa t'aye emeetera, golleenna kadootateran ayees felateeran kuwaarre lakkoɂaddeeseran; usumaleenna ere kaɂibaaddo genetisooyi rakkoo atayinara.»<note caller="-" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="MAT 11:14">Mat. 11:14</ref>.</char></note> <verse eid="MAT 17:12"/><verse number="13" style="v" sid="MAT 17:13"/>Hassu goorata Yesuusakko oɂagaalssatareen usu kaɂayeesera ayees kat'ammak'aaro Yaannisakokki gara laano addeesen.<verse eid="MAT 17:13"/></para>
  <para style="s1">Yesuusa kagaggadduu hawɂaami kahawɂamare unnu fayyiise</para>
  <para style="r">(<ref loc="MAT 17:14-23">Mat. 17:14-23</ref>; <ref loc="MRK 9:14-29">Mar. 9:14-29</ref>; <ref loc="LUK 9:37-43">Luk'. 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14"/>Yesuusana seeddo usukko oɂagaalssatareen gosa tos kakkoɂabbaabateeren goorata ibaaddoti koo Yesuusa tos gabbalame horee gilbbisere haa ame; <verse eid="MAT 17:14"/><verse number="15" style="v" sid="MAT 17:15"/>«Goottaa! Maganne unnukkeewun nenɂeyisa,» usu «Kagaggadduu hawɂaamii abboosara; gama kahori eleen orroddee iyaanna beke orroddee tabara. <verse eid="MAT 17:15"/><verse number="16" style="v" sid="MAT 17:16"/>Kukko oɂagaalssataran tonssa ani keenera ayesuun goɂameen iso fayyiisin lakkodaanddeeran.»<verse eid="MAT 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17"/>Yesuusana, «Isin oɂammanoonna tawoc'ac'c'aantte alattaan ani hagge taageeroon isinne wota girinnara? Hagge taageeroon obssinara? Unnu hittarraa in tos keena» ame. <verse eid="MAT 17:17"/><verse number="18" style="v" sid="MAT 17:18"/>Esekkona Yesuusa battiikki ayyaana hadisegure beese. Unnuna hassu gooratakko haggaɂabere fayyee.<verse eid="MAT 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19"/>Usukko oɂagaalssatareen kale been Yesuusa tos gabbalamengureen, «Noo battiikki ayyaana unnukko beesin kakkowannenna mewuunya?» ameen hoosaten.<verse eid="MAT 17:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20"/>Yesuusana, «Ammanokkisin mankkohank'k'atero maraanya. Ani rumminaa amara, tasinafic'c'i il gitakki ammano isinuun girewa, hitta wodami, ‹Hittakko kingudde toladdee see!› Goɂantteen seetattewa, isinuun kalleenon kooko lakkogiro.<note caller="-" style="x"><char style="xo" closed="false">17:20 </char><char style="xt" closed="false"><ref loc="MAT 21:21">Mat. 21:21</ref>; <ref loc="MAT 11:23">Mat. 11:23</ref>; <ref loc="1CO 13:2">1 K'or. 13:2</ref>.</char></note> [<verse eid="MAT 17:20"/><verse number="21" style="v" sid="MAT 17:21"/>Hikka aankkikki goɂameen ebina kaɂagaabuuyi gollee kuwaarre lakkobeero] ame.»<note caller="+" style="f"><char style="fr" closed="false">17:21 </char><char style="ft" closed="false">Kookkoo tagalbbaa s'uufiil tooto 21 adaraan; haafurana Mar. 9:28 kagiro aani laara. </char></note><verse eid="MAT 17:21"/></para>
  <para style="s1">Yesuusa goyikeessana goyikko kiyaanokeessakoki gara kallami ayeese</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22"/>Ul kagaliilaayi usukko oɂagaalssataran kukkumeen giraan Yesuusa isone haa ame, «Ere kaɂibaaddo gene taɂibaaddoyi roori sisaminara; <verse eid="MAT 17:22"/><verse number="23" style="v" sid="MAT 17:23"/>Lagadinnaran, usuna taseedi arri goyikko kinnara» usukko oɂagaalssatareenna aaloo gaddeen.<verse eid="MAT 17:23"/></para>
  <para style="s1">K'ulluukki min Waa maraan giira murano</para>
  <para style="r">(<ref loc="EXO 30:13">Biy. 30:13</ref>; <ref loc="MAT 22:17-21">Mat. 22:17-21</ref>; <ref loc="ROM 13:7">Rom. 13:7</ref>; <ref loc="JHN 6:61">Yan. 6:61</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24"/>Yesuusana usukko oɂagaalssatareen K'ifirenaahoomi tos kakkogiyaaren goorata k'ulluukki min kawaakkokki giira oɂabaabareen P'et'iroosa tos gabbalameengureen, «Kaɂagaalssisarakkisin k'ulluukki min kawaakkokki giira lakkomuraroya?» ameen.<note caller="-" style="x"><char style="xo" closed="false">17:24 </char><char style="xt" closed="false"><ref loc="EXO 30:13">Biy. 30:13</ref>; <ref loc="EXO 38:26">38:26</ref>.</char></note><verse eid="MAT 17:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25"/>P'et'iroosana, «Ii murara» ame. P'et'iroosa min orroddee goggotabeeyi, Yesuusa horaarjje, «Simoona! Kaɂulee wonojjoolkokki giira goorttun k'arat'a kakkoɂaatinnaraan kaɂulee ibaaddokkoya muu kakkaleekko aani laara?» ame.<verse eid="MAT 17:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26"/>P'et'iroosana, «Kakkaleekkoyya kakkoɂatamara» ame. Yesuusana, «Goorttanun yiisaaskkisin tagiira muraakko hesera.<verse eid="MAT 17:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 17:27"/>«Golleenna noo isoon handuddufo goggolleenoonkko labu tos dagiggudde mant'ak'k'oo luguda, horaarjje kaɂabato kunɂub aatigudde hiɂi goggobantteeyi maragade helnnatta, hassu aatigudde in marantinuuna megekkaa maraan muri» ame.<verse eid="MAT 17:27"/></para>
  <chapter eid="MAT 17"/>
  <chapter number="18" style="c" sid="MAT 18"/>
  <para style="s1">Wononnati kadaruureyi dubbaankko karoorara ayyoyya?</para>
  <para style="r">(<ref loc="MRK 9:33-37">Mar. 9:33-37</ref>; <ref loc="LUK 9:46-48">Luk'. 9:46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1"/>Hassu goorata Yesuusakko oɂagaalssatareen Yesuusa tos gabbalameengureen, «Wononnati kadaruureyi dubbaankko karoorara ayyoyya?» ameen hoosaten.<note caller="-" style="x"><char style="xo" closed="false">18:1 </char><char style="xt" closed="false"><ref loc="LUK 22:24">Luk'. 22:24</ref>.</char></note><verse eid="MAT 18:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2"/>Yesuusana yiittiti koo uumegure isoo t'eɂee aallisere, <verse eid="MAT 18:2"/><verse number="3" style="v" sid="MAT 18:3"/>«Ani rumminaa amara; goɂiggilssamoonna yiisaas aani golleennoon wononnati kadaruure tos suure lakkotabttaan.<note caller="-" style="x"><char style="xo" closed="false">18:3 </char><char style="xt" closed="false"><ref loc="LUK 22:24">Luk'. 22:24</ref>.</char></note> <verse eid="MAT 18:3"/><verse number="4" style="v" sid="MAT 18:4"/>Haanssun wononnati kadaruureyi dubbaankko karoorara hikka yiittiti aani isiɂoottessa kahussisataroyya.<verse eid="MAT 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 18:5"/>«Hikkamaleekki yiittiti megekkeeyi kaɂatatara inna atatera.»<verse eid="MAT 18:5"/></para>
  <para style="s1">Ibaaddoon handdudufo laanakko isiɂooratano</para>
  <para style="r">(<ref loc="MRK 9:42-48">Mar. 9:42-48</ref>; <ref loc="LUK 17:1-2">Luk'. 17:1-2</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6"/>Ayesuun goɂameen iyyee oɂammanaraan hinɂa otitic'c'arkko koo c'ubbo orddeese katabsara kanjiinkki eɂemo kariimee marggittessaa shaamigure beke badi t'eɂee shafami lichchi goɂame iidare.<verse eid="MAT 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7"/>«Hikki alami c'ubboon aalantti mankkolleero maraan aanne usuun! C'ubbo orddeese katabsara emeetano lakkohesiro; ayesuun goɂameen c'ubboon aalantti kalaaro ibaaddoon aanne! <verse eid="MAT 18:7"/><verse number="8" style="v" sid="MAT 18:8"/>Genetta goorttun lukitta kuun c'ubboon aalantti golleete goosi shafi. Gene lama goorttun luk'k'a lama kuun girigureen jiruu jiroomman tabaanon tagaannemi eleen tos shafamanakko kaɂeesatto goorttun naafaleessa liigudde jiruu jiroommakki giri tos tabano kaɂidankkiya.<note caller="-" style="x"><char style="xo" closed="false">18:8 </char><char style="xt" closed="false"><ref loc="MAT 5:30">Mat. 5:30</ref>.</char></note> <verse eid="MAT 18:8"/><verse number="9" style="v" sid="MAT 18:9"/>Usumalee iltta c'ubboon aalantti golleete beesi shafi, ilɂo lama kuun girigureen tagaannemi eleen tos kashafamattokko il too kuun giridde jiruu jiroommakki giri tos tabano kaɂidankkiya.» <note caller="-" style="x"><char style="xo" closed="false">18:9 </char><char style="xt" closed="false"><ref loc="MAT 5:29">Mat. 5:29</ref>.</char></note><verse eid="MAT 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10"/>Daruurii kagira erggichchalkkiso arggetto daruurii kagiro Aabbokkee horee mankkogiraan hinɂa kic'iic'c'akko koonna goggotuffannonkko isiɂoorayeen. [<verse eid="MAT 18:10"/><verse number="11" style="v" sid="MAT 18:11"/>Ere kaɂibaaddo obbayeeraan haasin emeetera.]<note caller="+" style="f"><char style="fr" closed="false">18:11 </char><char style="ft" closed="false">Toottoo tagalbbaa s'uufil tooto 11 adaraan; haafurana Luk'. 10 kagiro aani laara. </char></note><note caller="-" style="x"><char style="xo" closed="false">18:11 </char><char style="xt" closed="false"><ref loc="LUK 19:10">Luk'. 19:10</ref>.</char></note><verse eid="MAT 18:11"/></para>
  <para style="s1">Kabbayero idaadokokki masuussa</para>
  <para style="r">(<ref loc="LUK 15:3-7">Luk'. 15:3-7</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12"/>Yesuusana ade, «Alla iin segaa; ibaaddoti koo idaad bool kaɂabo gollee, iso orrokko koo gobbaye saagaalttamkko saagaal wodamii gutii iisegure kabbayero koo dootayiin lakkoseetaroya? <verse eid="MAT 18:12"/><verse number="13" style="v" sid="MAT 18:13"/>Ani rumminaa amara, kabbayero idaado gohelaro ogiraan saagaalttamkko saagaal idaadkko suure hassu kahelameroon geggelaatara. <verse eid="MAT 18:13"/><verse number="14" style="v" sid="MAT 18:14"/>Usumaleenna hikka kic'iic'ar orrokko koo goggobaaron daruurii kagiro Aabbokkisintti feɂi lakkotto.<verse eid="MAT 18:14"/></para>
  <para style="s1">Isiɂorroo k'uk'amanokokki gara</para>
  <para style="r">(<ref loc="LUK 17:3">Luk'. 17:3</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15"/>«Abbikka ku miirɂi gogire seegudde usune wota lamaa laaddeen baaskkeessa segii, ku gomaale abbaabattedde abbikkaa yelatta.<note caller="-" style="x"><char style="xo" closed="false">18:15 </char><char style="xt" closed="false"><ref loc="LUK 17:3">Luk'. 17:3</ref>.</char></note> <verse eid="MAT 18:15"/><verse number="16" style="v" sid="MAT 18:16"/>Maalana gowaatte ade ibaaddo lama goorttun seed kaɂatoteera ayees dubba mankkoɂataataro maraan ibaaddo koo goorttun lama aati seegudde gaafachchisi.<note caller="-" style="x"><char style="xo" closed="false">18:16 </char><char style="xt" closed="false"><ref loc="DEU 19:15">Ada. 19:15</ref>.</char></note> <verse eid="MAT 18:16"/><verse number="17" style="v" sid="MAT 18:17"/>Isona maalana gowaate min kawaakki ibaaddon segii, min kawaakki ibaaddo kamaaloon gollee Ayizaab aaninna k'arat'a kakukkuyisaro aani tootii.<verse eid="MAT 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18"/>«Ani rumminaa amara, isin ul kashiiten dubba daruurii kashaame laara, isin ul kafurtteen dubba daruurnna kafurame laara.<note caller="-" style="x"><char style="xo" closed="false">18:18 </char><char style="xt" closed="false"><ref loc="MAT 16:19">Mat. 16:19</ref>; <ref loc="JHN 20:23">Yan. 20:23</ref>.</char></note><verse eid="MAT 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19"/>«Adena ani rumminaa amara, ul gutii lamaa liiddeen maamisikki ayeenssa wota isiɂaati Waa goɂebaatteen daruurii kagira Aabbokki maalire isoon fellowa. <verse eid="MAT 18:19"/><verse number="20" style="v" sid="MAT 18:20"/>Lama goorttun seed liigureen megekkeeyi takkokukkuɂamaraan banɂeeyi ani isoo orroo mutinnara.»<verse eid="MAT 18:20"/></para>
  <para style="s1">Haheso amanokokki gara</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21"/>Hassu goorata P'et'iroosa Yesuusa tos gabbalamere «Goottaa! Abbikki in gomiirɂe miyyaa gali usuun haheso amira? Taa todoba geeroyiya?» ame hoosate.<note caller="-" style="x"><char style="xo" closed="false">18:21 </char><char style="xt" closed="false"><ref loc="LUK 17:3-4">Luk'. 17:3-4</ref>.</char></note><verse eid="MAT 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22"/>Yesuusana, «Todobaatam gali todoba kuwaarre todoba gali kaalaal ani lakkoɂamaro» ame.<note caller="-" style="x"><char style="xo" closed="false">18:22 </char><char style="xt" closed="false"><ref loc="GEN 4:24">Met'. 4:24</ref>.</char></note><verse eid="MAT 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23"/>«Haanssun wononnati kadaruuree usuun ohandaaraankotti genee kagiro maragade tooti din kadootataro wono aani laara. <verse eid="MAT 18:23"/><verse number="24" style="v" sid="MAT 18:24"/>Wonona maragadekkeessa tootaayin kakkohaggaɂabare goorata kuma kamoogganii katootamiro maragade anza kaɂabo ibaaddoti koo usu tos aateen emeeten. <verse eid="MAT 18:24"/><verse number="25" style="v" sid="MAT 18:25"/>Hikki kahandaarekkina anza murin mankkowaatero maraan usunnee, ooritteessane, yiiskkeessaane, urrawoɂootteesane dubba daddalami anza goggomurantto goottaa ajajee.<verse eid="MAT 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26"/>«Hassu goorata kahandaarekkina goottakkessakkotti lukii iyyegure obssii; taɂabo anza dubba gachoo kuun ani murra ame ebaate. <verse eid="MAT 18:26"/><verse number="27" style="v" sid="MAT 18:27"/>Goottakkeessana nenɂeyisategure usu gafare, anzattessana isaage.<verse eid="MAT 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28"/>«Hassu kahandaarekkina goottaa horekko goggobeeyi maragadekkeessa t'agaraa kaɂabo anza kaɂabanaaye usune wota kafelare unatteessa kalleera ibaaddoti koo helegure c'uulɂee abere taɂabtto anza hittanii iin muri!» ame.<note caller="+" style="f"><char style="fr" closed="false">18:28 </char><char style="fqa" closed="false">Diinari; </char><char style="ft" closed="false">felo kafelaro ibaaddoti kookokki arri toowun kamuramaro daamoozaya. </char></note><verse eid="MAT 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29"/>«Hassu saatikkeessana usuu horee iyyegure, ‹Maganne obssi ani kuun murrowa› ame ebaate.<verse eid="MAT 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30"/>«Ayesuun goɂameen taɂabo anza usu muri taagudisirooyi obssaana waatere minkashaano usu tabise. <verse eid="MAT 18:30"/><verse number="31" style="v" sid="MAT 18:31"/>Kalleero ayees kaddeera kakkalee kafeloo ibaaddona nenɂeyisate, kalleero dubbana seeteengureen goottakkisowun segeen.<verse eid="MAT 18:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32"/>«Usu goorata goottanna hassu kahandaaro uumsisegure haa ame, ‹Ati kameellan kahandaatta!› ‹Ati iin mankkoɂebaattette maraan hasse anza dubba ani kuun iisere; <verse eid="MAT 18:32"/><verse number="33" style="v" sid="MAT 18:33"/>Ani kuun goggoɂiiseroo atina kageelaatattokkaawun nenɂeyisayin lakkodootisareye?› <verse eid="MAT 18:33"/><verse number="34" style="v" sid="MAT 18:34"/>Iɂootere taɂabo anza dubba muri taagudisiroon kashaaronna kamurrisaroon roorise usu sise.<verse eid="MAT 18:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35"/>«Haanssun isin mete metee abbilaalttisinuun wodanakko haheso goɂamoon kadaruure Aabbokkisin isinna hikkamalee yelinnara.»<verse eid="MAT 18:35"/></para>
  <chapter eid="MAT 18"/>
  <chapter number="19" style="c" sid="MAT 19"/>
  <para style="s1">Keelkki ami beesanokkotti hoosin</para>
  <para style="r">(<ref loc="MRK 10:1-12">Mar. 10:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1"/>Yesuusa hikka ayeese gudisegure ul kagaliilakko keegure laga kayorddaanosikko gamaa kagiro ul kayihuuda seete. <verse eid="MAT 19:1"/><verse number="2" style="v" sid="MAT 19:2"/>Gosa kamoogganna usuu debee sesseete, eseenna iso fayyiise.<verse eid="MAT 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3"/>Farasaawiilnna Yesuusa c'aafin dooteen usu tos gabbalameenreen, «Ibaaddoti koo maamisitti aalanttiinna ooritteessa keelkki ami beesin feɂi sisanttetta?» ameen hoosaten.<verse eid="MAT 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4"/>Yesuusana isoon abbaabere, «Iso kamet't'eera Waa horaarjje babbaarnna heleel yele kamet't'eero Lakkonabbabtteettanya?<note caller="-" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="GEN 1:27">Met'. 1:27</ref>; <ref loc="GEN 5:2">5:2</ref>.</char></note> <verse eid="MAT 19:4"/><verse number="5" style="v" sid="MAT 19:5"/>Haanssun, ‹Ibaaddo Aabbokkeessana Aayetteessa iisegure ooritteessane wota k'urannaamara, iso lamana maar koo laaran kaɂamamera la hikkakkotti aalanttiyyolla›?<note caller="-" style="x"><char style="xo" closed="false">19:5 </char><char style="xt" closed="false"><ref loc="GEN 2:24">Met'. 2:24</ref>.</char></note> <verse eid="MAT 19:5"/><verse number="6" style="v" sid="MAT 19:6"/>Goorttanu maar kooyyaan kuwaarre lakkolamayyaan. Haanssun Waa kak'uranneero ibaaddo lakkofurro.»<verse eid="MAT 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7"/>Farasaawiilnna, «Hayya Muse babbaartiti koo ooritteessa keelkki amanoon kalleero worak'ata sisi ooritteessa goggogafarroon ‹Muun ajajee?› ameen.»<note caller="-" style="x"><char style="xo" closed="false">19:7 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">Ada. 24:1-4</ref>; <ref loc="MAT 5:31">Mat. 5:31</ref>.</char></note><verse eid="MAT 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8"/>Yesuusana, «Muse wodanattisinkokki ataan deegure oorijoolkisin keelkki goggoɂanttaanun feɂi sisera kuwaarre t'aye lakkohaayye. <verse eid="MAT 19:8"/><verse number="9" style="v" sid="MAT 19:9"/>Ani goɂameen haa amara, entterkkise giraan kakkaleenne wota sharmmut'aa gomutte kuwaarre ooritteessa keelkki ame gafaregure takkalee heleelttiti oori kayelatara dubba kasharmmut'aaroya» ame.<note caller="-" style="x"><char style="xo" closed="false">19:9 </char><char style="xt" closed="false"><ref loc="MAT 5:32">Mat. 5:32</ref>; <ref loc="1CO 7:10-11">1 K'or. 7:10-11</ref>.</char></note><verse eid="MAT 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10"/>Yesuusakko oɂagaalssatareenna; «Taɂenttereenna taɂoorii haajaa hikkamalee golleete oori atatano isaagano horekki» ameen.<verse eid="MAT 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11"/>Yesuusa goɂameen, «Hikki Waakko kasisame gollee kuwaarre hikka ayees maayyona atayin lakkodaanddaaro. <verse eid="MAT 19:11"/><verse number="12" style="v" sid="MAT 19:12"/>Aalanttina kookkoo alataa sangoome kaɂalatara gira, kakkalee gene taɂibaaddootii goosame kassangisamara gira, adena wononnati kadaruurewun ameengureen oori haɂatannoon ogiraan giraan, hikka atayin kadootatara haɂatato» ame.<verse eid="MAT 19:12"/></para>
  <para style="s1">Yesuusa yiisaas sommaasate</para>
  <para style="r">(<ref loc="MRK 10:13-16">Mar. 10:13-16</ref>; <ref loc="LUK 18:15-17">Luk'. 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13"/>Esekkona genetteessa isoo gutii kayigure goggoɂebaaroon ibaaddo yiisaas Yesuusa tos keen; usukko oɂagaalssatareenna adeen yiisaas kakkeenaro ibaaddo hadiseen.<verse eid="MAT 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 19:14"/>Yesuusana, «Iisa yiis in tos haɂemeeto arootirtteen, wononnati kadaruure iso aankkikkinya.» <verse eid="MAT 19:14"/><verse number="15" style="v" sid="MAT 19:15"/>Genettessanna iso gutii kaye abbaabatere ese banɂekko keegure seete.<verse eid="MAT 19:15"/></para>
  <para style="s1">Dureessakki ibaaddotikotti hoosin</para>
  <para style="r">(<ref loc="MRK 10:17-31">Mar. 10:17-31</ref>; <ref loc="LUK 18:18-30">Luk'. 18:18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16"/>Esekkona ibaaddoti koo Yesuusa tos emeetegure, «Kaɂagaalssisatto! Jiruu jiroommakki giri helayiin me kaɂidankki ayees fella?» ame hoosate.<verse eid="MAT 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17"/>Yesuusana, «Kaɂidan ayeeskkokki gara in muun hoosatta? Kaɂidankki kalleera ayees koo kaalaalyya, jiruu jiroommakki giri tos tabin godootatte adi ajajakkee oora,» ame.<verse eid="MAT 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18"/>Wodallaatina, «Eeki ajaja?» haa ame hoosate. Yesuusana, «Aroolagadde, aroosharmuut'ite, aroohette, t'ara arooɂatotiite, ame.<note caller="-" style="x"><char style="xo" closed="false">19:18 </char><char style="xt" closed="false"><ref loc="EXO 20:13-16">Biy. 20:13-16</ref>.</char></note> <verse eid="MAT 19:18"/><verse number="19" style="v" sid="MAT 19:19"/>Aabbokkaanna Aayettaa kabajiina, ollaattaanna isiɂoottaa aani geelaa» ame.<note caller="-" style="x"><char style="xo" closed="false">19:19 </char><char style="xt" closed="false"><ref loc="EXO 20:12">Biy. 20:12</ref>; <ref loc="DEU 5:16">Ada. 5:16</ref>; <ref loc="LEV 19:18">Woy. 19:18</ref>.</char></note><verse eid="MAT 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20"/>Wodallaatina, «Hikka dubba oorayeera,» hikkakko kakkalee «Kahank'atera meyya kagira?» ame.<verse eid="MAT 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21"/>Yesuusana, «K'ulluu liin godootatte seegudde oɂabtto urrawoɂoottaa dubba daddalidde maragade hiyyeessan sisi; daruurii urrawo helayinnatta. Esekkona emeegudde iin debee sessee» ame.<verse eid="MAT 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22"/>Hikki wodallaati hikka kakkomaalare goorata urrawo omooggan mankkoɂabo maraan yaadaa iise seete.<verse eid="MAT 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23"/>Yesuusana usukko oɂagaalssatareenne, «Ani rumminaa amara; dureessa wononnati kadaruure tos tabano aaloo k'arrayya. <verse eid="MAT 19:23"/><verse number="24" style="v" sid="MAT 19:24"/>Adena ani amara, dureessa wononnati kadaruure tabanokko gaala butto kamarffi tabanoyya ene kalleera» ame.<verse eid="MAT 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25"/>Yesuusakko oɂagaalssatareen hikka maaleengureen aaloo mamaa, «Hayya ayyoya fayyiin kadanddeera?» ameen hoosaten.<verse eid="MAT 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26"/>Yesuusana iso tos deyaa, «Hikki ibaaddo dollee lakkodaanddaamiro, Waayi dollee goɂameen ayees dubba daanddaamara ame.»<verse eid="MAT 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27"/>P'et'iroosana abbaabere, «Noo kameen dubba iinssegunne ku debee sesseetanna, hayya noo me helayinanna?» ame.<verse eid="MAT 19:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28"/>Yesuusana, «Ani rumminaa amara; kaɂemeeyinaro kaɂusub alami ere kaɂibaaddo kakkabajaa korffinjjee gutii kakkohamas's'ee goorata iin odebee osesseyaattan isinna tomonkko lama korffinjjee gutii hamas's'iiguddeen tomonkko lama taɂisiraɂeeli aani gutii firddinattaan.<note caller="-" style="x"><char style="xo" closed="false">19:28 </char><char style="xt" closed="false"><ref loc="MAT 25:31">Mat. 25:31</ref>; <ref loc="LUK 22:30">Luk'. 22:30</ref>.</char></note> <verse eid="MAT 19:28"/><verse number="29" style="v" sid="MAT 19:29"/>Megekkee maraan amire minjjool, goorttun abbilaal, goorttun abbalaal, goorttun Aabbo, goorttun Aaye, goorttun yiis, goorttun ira kaɂiisara dubba boolkokki ambbaa atayinara, jiruu jiroommakki girina eelnnaran. <verse eid="MAT 19:29"/><verse number="30" style="v" sid="MAT 19:30"/>Ayesuun goɂameen kamooggan kahoree kahaaree linnaraan; kamooggan kahaareenna kahoree linnaraan» ame.<verse eid="MAT 19:30"/></para>
  <chapter eid="MAT 19"/>
  <chapter number="20" style="c" sid="MAT 20"/>
  <para style="s1">Kawoyinii iraa ofelaraankokki masuussa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1"/>«Wononnati kadaruure woyinnikotti banɂee kafelaro kafeloo ibaaddoon felo sisin bari bullane kee kabeero kawoyinii akaakilttekkokki odo aani laara. <verse eid="MAT 20:1"/><verse number="2" style="v" sid="MAT 20:2"/>Usuna ofelaraawun arri tooyi t'agaraa too too murin ekkaategure kafeloo ibaaddo tawoyinii banɂe tos tabse.<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="fqa" closed="false">T'agaraa: </char><char style="ft" closed="false">felo kafelaro ibaaddotin arri toowun kamuramaro daamoozaya. </char></note><verse eid="MAT 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3"/>«Barkko saatii seeddinna beegure felo waateen taggiyyaa banɂee kaɂaalleero kakkalee ibaaddo helegure; <verse eid="MAT 20:3"/><verse number="4" style="v" sid="MAT 20:4"/>Isinna ‹Seyeenguddeen kawoyinii irakkeeyi felo fela, tadootisatto muraa isinuun ani gachchoomurra› ame. <verse eid="MAT 20:4"/><verse number="5" style="v" sid="MAT 20:5"/>Isona seeteen,</para>
  <para style="p" vid="MAT 20:5">«Arriikko saatii leyinna saatii saagaali emetere kakkalee felate kabbaraaro ibaaddon amalekkoonɂi felo sise. <verse eid="MAT 20:5"/><verse number="6" style="v" sid="MAT 20:6"/>Meeriti saatii tomonkko kookki goorata beegure aallee kagiro kakkalee ibaaddo helegure ‹Arri duuddo felo kallayi hittanii muun aalliteettan?› ame hoosate.<verse eid="MAT 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7"/>« ‹Isona, noon felo kasisiro ibaaddo mankkowaannenno maraanya› ameen.</para>
  <para style="p" vid="MAT 20:7">«Usuna ‹Isinna seyeenguddeen kawoyinii irakkeeyi fela› ame.<verse eid="MAT 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8"/>«Ul hemeen kakkolaare goorata kawoyinii akaakilttekkokki odo usuun ofelaraan odonnatii kaddeero ibaaddotin sisegure, ‹Danbbenne kaɂemeeterokko haggaɂabdde horaarjje kaɂemeetero taageeroo kagiro kafeloo ibaaddo dubba uumigudde daamoozakkisoo muri› ame.<note caller="-" style="x"><char style="xo" closed="false">20:8 </char><char style="xt" closed="false"><ref loc="LEV 19:13">Woy. 19:13</ref>; <ref loc="DEU 24:15">Ada. 24:15</ref>.</char></note><verse eid="MAT 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9"/>«Saatii tomonkko kooyi feloon otabeeran emetengureen mete metee t'agaraa toottoo atateen. <verse eid="MAT 20:9"/><verse number="10" style="v" sid="MAT 20:10"/>Horaarjje feloon otabeereen emetengureen t'agaraa onjii muraa ohelayinaraan aani isoon leere; ayesuun goɂameen isoonna mete metee t'agaraa toottoo murantte. <verse eid="MAT 20:10"/><verse number="11" style="v" sid="MAT 20:11"/>Muraa atataagiraan kawoyinii akaakilttekokki odoo gutii gumggumeen. <verse eid="MAT 20:11"/><verse number="12" style="v" sid="MAT 20:12"/>Hinɂi danbbenne feloon otabeeren saatii too taalaal gofellaan; arri duuddo felooyi haraanna arritii gubataa ohayinenno noonne wota misii amalekkooyi muratta? Ameen hoosaten.<verse eid="MAT 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13"/>«Usuna felate kabbaraaro koonne haa ame, ‹Kageelaatarokkee! Ani kuun miirɂa lakkogeegisero; t'agaraa tooyi felin ati iinne wota lakkoɂekkatteya? <verse eid="MAT 20:13"/><verse number="14" style="v" sid="MAT 20:14"/>Ku kageyaaro atagudde see, kuun kasisero gitakki danbbenne kaɂemeetero ibaaddotina sisin dootisara. <verse eid="MAT 20:14"/><verse number="15" style="v" sid="MAT 20:15"/>Hayya maragaddekkeeyi kageelaye felayin ani lakkodaanddaaroya? Goorttun ani kaɂidan mankkofelero maraan miigge tameellan ku abtte?›<verse eid="MAT 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16"/>«Haanssun Yesuusa, kahaaree kalleera kahoree, kahoreenna kahaaree linnara ame.»<note caller="-" style="x"><char style="xo" closed="false">20:16 </char><char style="xt" closed="false"><ref loc="MAT 19:30">Mat. 19:30</ref>; <ref loc="MRK 10:31">Mar. 10:31</ref>; <ref loc="LUK 13:30">Luk'. 13:30</ref>.</char></note><verse eid="MAT 20:16"/></para>
  <para style="s1">Yesuusa goyikkeessana goyikko keyaanokkeessa kaseedi ayeesano</para>
  <para style="r">(<ref loc="MRK 10:32-34">Mar. 10:32-34</ref>; <ref loc="LUK 18:31-34">Luk'. 18:31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17"/>Yesuusa Iyyerusaalemi tos seetaa giraan, tomonkko lama usukko oɂagaalssatareen kale aate beegure, <verse eid="MAT 20:17"/><verse number="18" style="v" sid="MAT 20:18"/>«Goorttanu noon Iyyerusaalemi tos biyaanoya, ere kaɂibaaddo tuuk'aamolkokki woyichchaalunna seera kamuse oɂagaalssisaraanun roori sisaminara, isona usu goggogooron firddinnaraan. <verse eid="MAT 20:18"/><verse number="19" style="v" sid="MAT 20:19"/>Goggok'ac'ifarawun, goggoboc'irawunna goggosuyiraawun Ayizaabwun roorisi sisinaraan, usuna taseedi arrii goyikko kiinnara» ame.<verse eid="MAT 20:19"/></para>
  <para style="s1">Kagootta wononnati orroo t'ok'k'i taɂantte banɂe helatanokkokki hoosiin</para>
  <para style="r">(<ref loc="MRK 10:35-45">Mar. 10:35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20"/>Esekkona yiis kazabddoosakkotti Aawo yiiskkiseenne wota Yesuusa tos emeettedde horee gilbbiisse sagadaa ayees koo usu eseen goggofelloo ebaatte.<verse eid="MAT 20:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21"/>Yesuusana esene, «Me dootaatta?» ame. Esena; «Hikka yiiskkee lama wononnatikkaayi koo merggettaayi, koo bettettaayi goggohamas'iirawun feɂi sisi» antte.<verse eid="MAT 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22"/>Yesuusana, «Isin kaɂebaattan lakkokassaan,» «Ani tat'aminnaro tarrakkoo t'ugga isin t'amin daanddeetane?» Ame hoosate. Isona «Iɂii daanddeennowa!» ameen.<verse eid="MAT 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23"/>Usuna, «Tarrakkoo t'uggatteekko golleenna t'anttaanwa, ayesuun goɂameen merggetteeyinna betetteeyi hamas's'aano goɂameen Aabbokki kakkoonɂekkaseroonyya kuwaarre ani feɂi kasisaro ayees lakkoyo» ame.<verse eid="MAT 20:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24"/>Yesuusakko oɂagaalssatareen tomonnonna hikka kakkomaalaren goorata abbilaal lamaa gutii amaraateen. <verse eid="MAT 20:24"/><verse number="25" style="v" sid="MAT 20:25"/>Yesuusana iso dubba uumegure, «Ayizaabkokki mootijjol gosakkisoo gutii mooti goggolleerawun odonnati obariisaraanna hunnaayi kabbarisaraan laano kassanwa. <verse eid="MAT 20:25"/><verse number="26" style="v" sid="MAT 20:26"/>Isin orroo ade hikkamalee laano lakkodootisaro. Ayesuun goɂameen isinii orroo kanjiinkki liin kadootatara isinuun kahandaaro halleewo.<note caller="-" style="x"><char style="xo" closed="false">20:26 </char><char style="xt" closed="false"><ref loc="LUK 22:25-26">Luk'. 22:25-26</ref>.</char></note> <verse eid="MAT 20:26"/><verse number="27" style="v" sid="MAT 20:27"/>Isinkko mete liin kadootatarana isinuun diyyii halleewo.<note caller="-" style="x"><char style="xo" closed="false">20:27 </char><char style="xt" closed="false"><ref loc="MAT 23:11">Mat. 23:11</ref>; <ref loc="MRK 9:35">Mar. 9:35</ref>; <ref loc="LUK 22:26">Luk'. 22:26</ref>.</char></note> <verse eid="MAT 20:27"/><verse number="28" style="v" sid="MAT 20:28"/>Ere kaɂibaaddo kakkoonɂemeetera noo usuun goggohanddayinnoon anlleennon giraan handdayinna neefotteessa kamoogganun wodoo yelayi sisayin emeetera» ame.<verse eid="MAT 20:28"/></para>
  <para style="s1">Yesuusa Iilɂo oddeyaannon ibaaddojja lama fayyiisano</para>
  <para style="r">(<ref loc="MRK 10:46-52">Mar. 10:46-52</ref>; <ref loc="LUK 18:35-43">Luk'. 18:35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29"/>Yesuusana usukko oɂagaalssatareen Iyaarkokko been seetaa giraan gosa kamooggan usuu debee sesseete. <verse eid="MAT 20:29"/><verse number="30" style="v" sid="MAT 20:30"/>Eseenna ilɂo odeyaannon ibaaddojja lama raadii hamas's'een gireen, Yesuusa esene roorano kakkomaalareen goorata; «Goottaa! Ere kadaawute; noon nenɂeyisana» amaa iyyeen.<verse eid="MAT 20:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31"/>Gosana iso c'alɂi goggoɂamirawun hadise, iso goɂameen, «Goottaa ere kadaawute maganne noon nenɂeyisana» amaa aaloo iyyeen.<verse eid="MAT 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32"/>Yesuusana takki ame aallee iso uume «Ani isinuun me goggoyelloo dootaattan?» ame.<verse eid="MAT 20:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33"/>Isona «Goottaa!» «Noo Iilɂoɂoottaani goggodeerawun dootatanna ameen.»<verse eid="MAT 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34"/>Yesuusana isoon nenɂeyisategure Iilɂoɂoottiso dinddinegure goorsewa Iilɂoɂoottiso deenddeen, isona usu debee sesseeteen.<verse eid="MAT 20:34"/></para>
  <chapter eid="MAT 20"/>
  <chapter number="21" style="c" sid="MAT 21"/>
  <para style="s1">Yesuusa kabaja taɂatiiyi Iyyerusaalemi tos tabano</para>
  <para style="r">(<ref loc="MRK 11:1-11">Mar. 11:1-11</ref>; <ref loc="LUK 19:28-40">Luk'. 19:28-40</ref>; <ref loc="JHN 12:12-19">Yan. 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1"/>Iyyerusaalemi tos gabbalamaa zayitii kabeyaara gaa takkoɂalataro wodami gutii kagiro maaman kafaage taɂamamatto banɂe goggogeeyi Yesuusa usukko oɂagaalssatareenkko lama fare. <verse eid="MAT 21:1"/><verse number="2" style="v" sid="MAT 21:2"/>Haanna ame, «Isin hore kagiro maaman tos seeyeen, goggogeeteeni demeertiti too darmmeenne wota tashaanttetto isin helnnattaan, furaddeene in tos aata koyeen. <verse eid="MAT 21:2"/><verse number="3" style="v" sid="MAT 21:3"/>Maayyona isinne haa muun yelattaan goɂame, ‹Gootta dootatara› ama. Goorsewa gafarranwa.»<verse eid="MAT 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4"/>Hikki kakkoonlleera kahegerooyi haa amame kasegaamera goggogudaroonya.<verse eid="MAT 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5"/>«S'iyooni taɂamamatto taɂiyyerusaalemi katamaawun haa ami,</para>
  <para style="q2" vid="MAT 21:5">‹hikkima wonokka fayyankka leegure,</para>
  <para style="q2" vid="MAT 21:5">demeertitinna darmmeeti gutii hamas's'eegure ku tos emeetara› amaddeen eseen segaa.»<note caller="-" style="x"><char style="xo" closed="false">21:5 </char><char style="xt" closed="false"><ref loc="ZEC 9:9">Zak. 9:9</ref>.</char></note><verse eid="MAT 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6"/>Usukko oɂagaalssatareenna seetengureen Yesuusa ajaja isoon goggosiserokki malee yeleen. <verse eid="MAT 21:6"/><verse number="7" style="v" sid="MAT 21:7"/>Demeertitinna darmmeeti keenenguren sarssikisoo kademeeree bagadi gutii kayeen; Yesuusana esee gutii hamas's'ee. <verse eid="MAT 21:7"/><verse number="8" style="v" sid="MAT 21:8"/>Gosakkona gamisa sarssikkisoo raadii yayeen; kakkaleenna ade ballaal tattarsheen aateen raadii lullugudeen. <verse eid="MAT 21:8"/><verse number="9" style="v" sid="MAT 21:9"/>Horehaye kasessetarena haarre usuu debee sesseetaa kagire gosana,</para>
  <para style="q1" vid="MAT 21:9">«Hoosaɂina ere kadaawute!»</para>
  <para style="q1" vid="MAT 21:9">«Mege kawaayi kaɂemeetara usu kasommaasameya,»</para>
  <para style="q1" vid="MAT 21:9">«Hoosaɂina ele daruurii haa amaa iyyaaren.»<note caller="+" style="f"><char style="fr" closed="false">21:9 </char><char style="fqa" closed="false">Hoosaɂina </char><char style="ft" closed="false">amano taɂibrayist'i hiɂii fayyinna, Waaye no fayyisina amanoyya. </char></note><note caller="-" style="x"><char style="xo" closed="false">21:9 </char><char style="xt" closed="false"><ref loc="PSA 118:25-26">Mez. 118:25-26</ref>.</char></note><verse eid="MAT 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10"/>Iyyerusaalemi tonssa kakkotabare goorata kakkatamaa ibaaddo dubba, «Hikki ayyoyya?» amaa shalagaame. <verse eid="MAT 21:10"/><verse number="11" style="v" sid="MAT 21:11"/>Gosana, «Hikki Galiilaayi tagitto tanazireet katamaakko kaɂemeetero kahegeroo Yesuusaya» ameen.<verse eid="MAT 21:11"/></para>
  <para style="s1">Yesuusa k'ulluukki min kawaayi orroo odadalatareen deegure horoore</para>
  <para style="r">(<ref loc="MRK 11:15-19">Mar. 11:15-19</ref>; <ref loc="LUK 19:45-48">Luk'. 19:45-48</ref>; <ref loc="JHN 2:13-22">Yan. 2:13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12"/>Esekko Yesuusa k'ulluukki min kawaa tabegure k'ulluukki min kawaayi orroo iminataanna daddalataa ogireen beese horoore, maragade oɂiggilssatarenkkokki t'arap'eezzalnna arabe odaddalataren kakkohamas's'eeran borbboono mina mina abbaabe lugudere.<verse eid="MAT 21:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 21:13"/>«Min kakki kaɂebi min amamara amame mas'aafa k'ulluukkii s'aafamera, isin addeen kakkosamaraan laga kashittaa yelttettaan» ame.<note caller="-" style="x"><char style="xo" closed="false">21:13 </char><char style="xt" closed="false"><ref loc="ISA 56:7">Isa. 56:7</ref>; <ref loc="JER 7:11">Erm. 7:11</ref>.</char></note> <verse eid="MAT 21:13"/><verse number="14" style="v" sid="MAT 21:14"/>K'ulluukki min kawaayi orroo Iilɂo odiyaannonna naafaleessaal usu tos emeeten, usuna fayyiise. <verse eid="MAT 21:14"/><verse number="15" style="v" sid="MAT 21:15"/>Ayesuun goɂameen tuuk'aamolkokki woyichchaalnna seera oɂagaalssisaran Yesuusaa kafelamero baasanna, «Hoosaɂina ere kadaawuteen» amaa k'ulluukki min kawaa orroo kaɂiyyaare yiis kakkodeyaaren goorata aaloo amaraateen.<verse eid="MAT 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 21:16"/>Isona Yesuusane «Hikki yiis taɂamaro maalatta?» ameen. Yesuusana:</para>
  <para style="p" vid="MAT 21:16">«Iɂii» maalara ame,</para>
  <para style="q1" vid="MAT 21:16">« ‹Yiiskona naasi kaɂiilataro yiiskotti hiɂikko</para>
  <para style="q2" vid="MAT 21:16">galata ekkaase kaɂamaro suure lakkonabbabtteettanya›?» ame.<note caller="-" style="x"><char style="xo" closed="false">21:16 </char><char style="xt" closed="false"><ref loc="PSA 8:2">Mez. 8:2</ref>.</char></note><verse eid="MAT 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17"/>Katamaakko iise beegure Bitaanya kaɂamaraan maamanii seete esee baree.<verse eid="MAT 21:17"/></para>
  <para style="s1">Il kallayikki gaa kabalasi</para>
  <para style="r">(<ref loc="MRK 11:12-14">Mar. 11:12-14</ref>,<ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18"/>Yesuusa bari bullane katamaa tos abbaabate setaa giraan uuɂee; <verse eid="MAT 21:18"/><verse number="19" style="v" sid="MAT 21:19"/>Raadii giridii kagire gaa kabalasi koo deegure kakkoseero goorata baalallo kuwaarre il toonna helayiin waategure; «Goortta jiroomman kuun il aroogginno!» ame. Gaa kabalasina goorsewa angage.<verse eid="MAT 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20"/>Usukko oɂagaalssatareenna kalleero deeguren saadeen, «Gaa kabalasi misii kooyikkii angagin daanddee?» ameen.<verse eid="MAT 21:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21"/>Yesuusana, «Ani rumminaa amara; ammano isinuun girewa lakkohedatatteen; gaa kabalasi gutii kalleero aani felano kaalaal anlleennon giraan hitta wodami hittakko, ‹Tagamigudde beke orroddee tabi› goɂantteen isinuun laarewa.<note caller="-" style="x"><char style="xo" closed="false">21:21 </char><char style="xt" closed="false"><ref loc="MAT 17:20">Mat. 17:20</ref>; <ref loc="1CO 13:2">1 K'or. 13:2</ref>.</char></note> <verse eid="MAT 21:21"/><verse number="22" style="v" sid="MAT 21:22"/>Ammanatteeddeen ebii kaɂebaattan dubba atayinattaan.»<verse eid="MAT 21:22"/></para>
  <para style="s1">Odonnati kayesuusa gutii taɂemettetto hoosiin</para>
  <para style="r">(<ref loc="MRK 11:27-33">Mar. 11:27-33</ref>; <ref loc="LUK 20:1-8">Luk'. 20:1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23"/>Yesuusa k'ulluukki min kaɂebi tos tabegure agaalssisaa giraan tuuk'aamolkokki woyichchaalnna kagosa jaarsolee emetengureen, «Hikka ayees dubba kakkofelatta eeki odonnatiya? Odonnatina kuyeen kasisera ayyoyya?» ameen hoosaten.<verse eid="MAT 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24"/>Yesuusana, «Aninna hoosiin too isin hoosayinnara, abbaabi iin gosegiiteen aninna hikka ayees eeki odonnati ani felaro isinuun seginnara. <verse eid="MAT 21:24"/><verse number="25" style="v" sid="MAT 21:25"/>Kayaannisa t'ink'ata haggekko emeetera? Daruurkkoyya muu ibaaddokkoya?» ame hoosate.</para>
  <para style="p" vid="MAT 21:25">Isona isi isi orro ayeesaa, «Noo ‹Daruurkkoyya› goɂaminne hayya ‹Muun ammanana waattettaan?› aminara. <verse eid="MAT 21:25"/><verse number="26" style="v" sid="MAT 21:26"/>‹Ibaaddokkoyya› goɂaminne ade gosana Yaannisa kahegeroo ame mankkoɂammanaro maraan noo gosa abssatanna» ameen.<verse eid="MAT 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27"/>Haanssun «Noo lakkokansso» ameen Yesuusaan abbaabeen.</para>
  <para style="p" vid="MAT 21:27">Usuna, aninna hikka ayees eeki odonnati ani felaro lakkoseginaro ame.<verse eid="MAT 21:27"/></para>
  <para style="s1">Yiis lamakokki masuussa</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28"/>Yesuusana, «Me aani laara? Babbaar lama kaɂaba ibaaddoti koo gire; kahoree ere tos seetegure, ‹Unnukkee! Hittaari tawoyinii taɂakaakiltte banɂe tos seegudde felo felina ame.›<verse eid="MAT 21:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 21:29"/>« ‹Unnuna, lakkodaginaro› ame. Baaskkeessa malabatere abbaabate seete.<verse eid="MAT 21:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 21:30"/>«Ade kallamikki ere tos seetegure hikkamaleewa ame, unnukkeessana, ‹Ii Aabbokki! Seerowa› ame. Ayesuun goɂameen haseennooni hese.<verse eid="MAT 21:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31"/>«Iso lama orrokko taɂodoo feɂi kaɂammagera eekiya?»</para>
  <para style="p" vid="MAT 21:31">Isona «Kahoree unnuya» ameen. Yesuusana, «Ani rumminaa amara k'arat'a okukkuyisaraanna osharmut'araan wononnati kawaa tos tabin isinkko t'ayinaraan. <verse eid="MAT 21:31"/><verse number="32" style="v" sid="MAT 21:32"/>Kat'ammak'aara Yaannisa k'ulluukki raa tusin isin tos emeetera. Isin addeen lakkoɂammantteettaan, k'arat'a okukkuyisareenna osharmut'araan goɂameen ammaneraan. Isin hikka deeten giraan duuddo c'ubbokko gula galtteen lakkoɂammantteettaan ame.<verse eid="MAT 21:32"/></para>
  <para style="s1">Kawoyinii ira otateen obaraarankotti masuussa</para>
  <para style="r">(<ref loc="MAT 21:33-46">Mat. 21:33-46</ref>; <ref loc="MRK 12:1-12">Mar. 12:1-12</ref>; <ref loc="LUK 20:9-19">Luk'. 20:9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33"/>«Kakkalee masuussa maala; kawoyinii irakkokki odo koo gire, iraa maraamurise ooti kaate, woyinnii kakkomiic'iraan gumbbina oshate, woyinnii oɂoorarawuun deeri madaare, esekko irakkeessa otateen obaraarawun kirayii sisegure ul kakkalee iise seete.<note caller="-" style="x"><char style="xo" closed="false">21:33 </char><char style="xt" closed="false"><ref loc="ISA 5:1-2">Isa. 5:1-2</ref>.</char></note> <verse eid="MAT 21:33"/><verse number="34" style="v" sid="MAT 21:34"/>Kaami takkokukkuyisataraan diginni kakkogiyaatte goorata tadubanttetto ilkko k'oobakkeessa atayin usuun ohandaareen otateen obaraaran tos fare.<verse eid="MAT 21:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 21:35"/>«Otateen obaraaranna usuun ohandaaran abeenguren koo boc'een, koo lagadeen, koo adeen eɂemooyi eeggeen. <verse eid="MAT 21:35"/><verse number="36" style="v" sid="MAT 21:36"/>Usuna ohoreekko tootooyi orooraraan okkalee ohandaaran fare, otateen obaraaranna giddana usumaleewwa yeleen. <verse eid="MAT 21:36"/><verse number="37" style="v" sid="MAT 21:37"/>Goorttanu ‹Iso adi unnukkee lakabajiiranna,› amere danbbenne unnukkeessa fare.<verse eid="MAT 21:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38"/>«Ayesuun goɂameen otateen obaraaranna usu unnukkeessa kakkodiyaaren goorata hikki kaɂeelnaroya, koyeen lagadigunne rittiitteessa eelinna» ameen isiɂorroo ayeeseen. <verse eid="MAT 21:38"/><verse number="39" style="v" sid="MAT 21:39"/>Abeenguren kawoyinii irakko sar beesengureen usu lagadeen.<verse eid="MAT 21:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40"/>«Hayya kawoyinii irakkokki odo kakkoɂemeete goorata hanɂu otateen obaraaran usu misi kayelnnaro aani isinuun laara?»<verse eid="MAT 21:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41"/>Isona «Hanɂu omeellan akamalee lagadigure kawoyinii irakko tadootisatto ilkko k'ooba goorataayi oɂabbaabarawuun okkalee otateen obaraarawun kirayii sisinnara» ameen.<verse eid="MAT 21:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42"/>Yesuusana,</para>
  <para style="q1" vid="MAT 21:42">«Oginbbaraan kattuffateen eɂemo,</para>
  <para style="q2" vid="MAT 21:42">minuun mina afarruun kadootisaro lee,</para>
  <para style="q1" vid="MAT 21:42">Hikkana kayelera Waayya,</para>
  <para style="q2" vid="MAT 21:42">ilɂoɂoottaanuun baasaya;</para>
  <para style="m" vid="MAT 21:42">amame k'ulluukki mas'aafaali kas'aafamero lakkonabbabteettanya?» ame.<note caller="-" style="x"><char style="xo" closed="false">21:42 </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">Mez. 118:22-23</ref>.</char></note><verse eid="MAT 21:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43"/>«Haanssun ani haa amara; wononnati kawaa isinkko atamigure il kayelataro gosaan sisaminara. <verse eid="MAT 21:43"/><verse number="44" style="v" sid="MAT 21:44"/>Hikka eɂemoo gutii kaɂiyaara eɂebara; eɂemona iso gutii kakkoɂiyaara ibaaddo ade bututinnara.»<note caller="+" style="f"><char style="fr" closed="false">21:44 </char><char style="ft" closed="false">Toottoo tagalbbaa s'uufil tooto 44 adaraan; usu haafurana Luk'. 20:18 kagiro aani laara. </char></note><verse eid="MAT 21:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45"/>Tuuk'aamolkokki woyichchaalnna Farasaawiil, hikka masuussajjool kakkomaalaren goorata Yesuusa kaɂayeesara garakkisoo laano addeesen. <verse eid="MAT 21:45"/><verse number="46" style="v" sid="MAT 21:46"/>Ayesuun goɂameen abi shiin godooteenna gosa ade Yesuusa kahegeroo aani mankkodiyaare maraan abssateen.<verse eid="MAT 21:46"/></para>
  <chapter eid="MAT 21"/>
  <chapter number="22" style="c" sid="MAT 22"/>
  <para style="s1">Kahaassinoo aamokkokki masuussa</para>
  <para style="r">(<ref loc="LUK 14:15-24">Luk'. 14:15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1"/>Yesuusa ade masuussayi ibaaddon segaano haggaɂabe, <verse eid="MAT 22:1"/><verse number="2" style="v" sid="MAT 22:2"/>Wononnati kadaruure erekkeessatti haassinoon aamo kaɂekkaasatero wono aani laara, <verse eid="MAT 22:2"/><verse number="3" style="v" sid="MAT 22:3"/>Wonona haassinoon kakkoonsegaatero ibaaddo kekkeesiin ohandaareen handdaa farate, ibaaddo goɂameen lakkoɂemeeyinnanno ame.<verse eid="MAT 22:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4"/>«Adena okkalee ohandaaran faregure oɂuumameraanne goortta aaraarinna kak'aabaan ‹Giddikkee enɂaayegure ekkaasayera kameen dubba mankkoɂekkaatero maraan haassinoon koyeen, amara ama segaa.›<verse eid="MAT 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5"/>«Oɂuumameeran goɂameen uumit diidengureen; koo ira tos, kakkalee dookki daddalayin seete, <verse eid="MAT 22:5"/><verse number="6" style="v" sid="MAT 22:6"/>Oheseeran adeen ohandaaran abeenguren abboosiseen lagadeen. <verse eid="MAT 22:6"/><verse number="7" style="v" sid="MAT 22:7"/>Wonona amaraategure wotaadara faregure hanɂu olagadeeraan lagadssise; katamaattisoonna eleenii gube.<verse eid="MAT 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 22:8"/>«Esekkona ohandaareenne haa ame, ‹Kahaassinoo aamo ekkaatera, ayesuun goɂameen oɂuumameeranna aamoon odootisaraan leen mankkomutanawaateran maraan; <verse eid="MAT 22:8"/><verse number="9" style="v" sid="MAT 22:9"/>Kakkosesseetaran raadii biyaagudden kaheltteen ibaaddo dubba kajila aamo tos uuma› ame. <verse eid="MAT 22:9"/><verse number="10" style="v" sid="MAT 22:10"/>Ohandaaranna raadii beengureen kaheleen ibaaddo kaɂidanna kameellan dubba kukkuyisenguren kahaassinoo min martti ammageen.<verse eid="MAT 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11"/>«Wonona taɂuumanttetto martti din min orddi gotabro ibaaddoti koo kahaassinoo sarssi hasarssannoni kagiro dee. <verse eid="MAT 22:11"/><verse number="12" style="v" sid="MAT 22:12"/>Haanna ame; ‹Ani kageelaataro!› kahaassinoo sarssi hasarissannooni misii hittarraa tabin daanddeete? Ibaaddotina goɂameen taɂamiɂabbaabro waate.<verse eid="MAT 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13"/>«Wonona ohandaaranne; ‹Genena luk'k'ana shiyaagudden sarre kagiro t'illinggakki mugud tos beesaddeen usu shafa, eseenna ottanna ilkko fooc'ano linnara› ame.<note caller="-" style="x"><char style="xo" closed="false">22:13 </char><char style="xt" closed="false"><ref loc="MAT 8:12">Mat. 8:12</ref>; <ref loc="MAT 25:30">25:30</ref>; <ref loc="LUK 13:28">Luk'. 13:28</ref>.</char></note><verse eid="MAT 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14"/>Esekko Yesuusa, «Oɂuumameeranna omoogganiyyaan, oɂassaabameeraan goɂameen huc'c'arriyyaan» ame.<verse eid="MAT 22:14"/></para>
  <para style="s1">Giira muranokokki gara</para>
  <para style="r">(<ref loc="MRK 12:13-17">Mar. 12:13-17</ref>; <ref loc="LUK 20:20-26">Luk'. 20:20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15"/>Esekko Farasaawiil been seetaa giraan misimisii Yesuusa ayeeskkessayi t'oyi taɂami abinaraan makkareen. <verse eid="MAT 22:15"/><verse number="16" style="v" sid="MAT 22:16"/>Isokko oɂagaalssatareenna taherodoosa unane wota Yesuusa tos fareengureen, «Kaɂagaalssisatto!» «Ati karrummii laanona raa kawaa rummii kaɂagaalssisatto laano, ibaaddo abssataa kaɂululisoon dubbana il tooyi kadiyaatto laano noo kanssowa. <verse eid="MAT 22:16"/><verse number="17" style="v" sid="MAT 22:17"/>Karoomi wonolaalkokki wonowuun giira murano dootisara muu lakkodootisaroya alla noon segii? Ameen hoosaten.»<verse eid="MAT 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18"/>Yesuusana miiggettisoo addeesere, «Isin ifissaaddolee mewuun ayeesii in c'aafin dootaattan? <verse eid="MAT 22:18"/><verse number="19" style="v" sid="MAT 22:19"/>Giira tamurattaan maragade alla iin tusa?» isona t'agaraa too keneen. <verse eid="MAT 22:19"/><verse number="20" style="v" sid="MAT 22:20"/>Usuna, «Hitta maragadeeyi gutii tamutatta middi taayyotta? S'uufinna ade taayyotta?» ame.<verse eid="MAT 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21"/>Isona abbaabeen «Karoomi wonoyya» ameen. Usuna abbaabere «Karoomi wonokokki karoomi wonoon, kawaanna Waawuun sisa» ame.<verse eid="MAT 22:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22"/>Isona hikka maalengureen ayeeskkeessaa saadaa iiseen seeteen.<verse eid="MAT 22:22"/></para>
  <para style="s1">Goyikko kiyaanokokki gara tahoosanttetto hoosiin</para>
  <para style="r">(<ref loc="MRK 12:18-27">Mar. 12:18-27</ref>; <ref loc="LUK 20:27-40">Luk'. 20:27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23"/>Ese arrii goyikko kiyaano laagiro ame kaɂammanara kasodok'awil ibaaddo Yesuusa tos emeetengure haa ame hoosate;<note caller="-" style="x"><char style="xo" closed="false">22:23 </char><char style="xt" closed="false"><ref loc="ACT 23:8">Ofa. Fe. 23:8</ref>.</char></note> <verse eid="MAT 22:23"/><verse number="24" style="v" sid="MAT 22:24"/>«Kaɂagaalssisatto!» Muse; «Ibaaddoti koo ooritteessakko yiis haɂumuloon goggoye, kagooyero abbikkeessakkotti oori abbikkeessa atayigure usuun sannii hakkaye amera.<note caller="-" style="x"><char style="xo" closed="false">22:24 </char><char style="xt" closed="false"><ref loc="DEU 25:5">Ada. 25:5</ref>.</char></note> <verse eid="MAT 22:24"/><verse number="25" style="v" sid="MAT 22:25"/>Abbilaal todoba no dollee gitta, kahoree oori atategure yiis haɂumuloon kakkogowaare goorata abbikkessana oori yelate; <verse eid="MAT 22:25"/><verse number="26" style="v" sid="MAT 22:26"/>Hikkamalee ade kaseedikko taa todoba geeroo hikkamalee goyeen. <verse eid="MAT 22:26"/><verse number="27" style="v" sid="MAT 22:27"/>Dubbaankko haarre heleelttitina goote. <verse eid="MAT 22:27"/><verse number="28" style="v" sid="MAT 22:28"/>Haanssun ese dubbaan mankkokeesantetto maraan goyikko takkiyaano arri iso abbilaal todoba orrokko ekiin oori linnatta?»<verse eid="MAT 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29"/>Yesuusana isoon abbaabere, «Isin k'ulluukki mas'aafajjolnna hunna kawaa mankkoɂaddeesanawattettan maraan shir amattaan. <verse eid="MAT 22:29"/><verse number="30" style="v" sid="MAT 22:30"/>Ogoyeraan goyikko kii goɂabbaabateen daruurii kagiro erggichchaal aani linnaraan kuwaarre lakkoɂatayinaraan; lakkonakeesaminaran. <verse eid="MAT 22:30"/><verse number="31" style="v" sid="MAT 22:31"/>Ogoyeraan goyikko kiyaanokkokki gara Waa isinuun kaɂayeesero lakkonabbabtteettanya? <verse eid="MAT 22:31"/><verse number="32" style="v" sid="MAT 22:32"/>‹Ani kaɂabraame Hedo, kayissaak'a Hedo, kayayik'ooba Hedoya,› Haanssun Waa arddokki Hedoya kuwaarre lakkokagoyi Hedoyyo.»<note caller="-" style="x"><char style="xo" closed="false">22:32 </char><char style="xt" closed="false"><ref loc="EXO 3:6">Biy. 3:6</ref>.</char></note><verse eid="MAT 22:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33"/>Gosana hikka kakkomaalare goorata agaalssiskkeessaa saadeen.<verse eid="MAT 22:33"/></para>
  <para style="s1">Dubbaankko karooraro ajaja</para>
  <para style="r">(<ref loc="MRK 12:28-34">Mar. 12:28-34</ref>; <ref loc="LUK 10:25-28">Luk'. 10:25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34"/>Yesuusa Sodok'aawil abbaab tiri c'alɂisano kakkomaalareen goorata Farasaawiil raattoo kukkuɂameen. <verse eid="MAT 22:34"/><verse number="35" style="v" sid="MAT 22:35"/>Isokko koo seera kamuse kaɂagaalssisare Yesuusa c'aafin dootegure haa ame:<note caller="-" style="x"><char style="xo" closed="false">22:35 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">Luk'. 10:25-28</ref>.</char></note><verse eid="MAT 22:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 22:36"/>«Kaɂagaalssisatto! Seeral kamuse dubbakko karoorara eeki ajajaya?» <verse eid="MAT 22:36"/><verse number="37" style="v" sid="MAT 22:37"/>Yesuusana isoon abbaabere, « ‹Goottaa Hedokkaa migitti wodanaayi, migitti neefooyi, migitti k'ofaayi geelaa›.<note caller="-" style="x"><char style="xo" closed="false">22:37 </char><char style="xt" closed="false"><ref loc="DEU 6:5">Ada. 6:5</ref>.</char></note> <verse eid="MAT 22:37"/><verse number="38" style="v" sid="MAT 22:38"/>Hikki ajaja kahoraarjjeenna dubbaankko karooraro ajajaya. <verse eid="MAT 22:38"/><verse number="39" style="v" sid="MAT 22:39"/>Kallami ajajana hikka aani laara; hikkina ‹Ollaattaa isiɂoottaa aani geelaa› kaɂamaroya.<note caller="-" style="x"><char style="xo" closed="false">22:39 </char><char style="xt" closed="false"><ref loc="LEV 19:18">Woy. 19:18</ref>.</char></note> <verse eid="MAT 22:39"/><verse number="40" style="v" sid="MAT 22:40"/>Seera kamusena kahegeroolkokki agaalssis dubba hikka ajaja lamaa gutii dhaabbateen giraan ame.»<verse eid="MAT 22:40"/></para>
  <para style="s1">Kiristoosa sannii taayyoya?</para>
  <para style="r">(<ref loc="MRK 12:35-37">Mar. 12:35-37</ref>; <ref loc="LUK 20:41-44">Luk'. 20:41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41"/>Farasaawiil kukkuɂameengureen Yesuusa haa ame iso hoosate, <verse eid="MAT 22:41"/><verse number="42" style="v" sid="MAT 22:42"/>«Gara kakiristoosa me aani laara? Sannii taayyoya?» ame iso hoosate.</para>
  <para style="p" vid="MAT 22:42">«Isona sannii tadaawuteyya» ameen.<verse eid="MAT 22:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43"/>Yesuusana, «Hayya daawute Ayyaana K'ulluukkinna hunnaayi muun usu, ‹Goottaa!› amara? Ame.<verse eid="MAT 22:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44"/>« ‹Gootta Goottakkeewun!</para>
  <para style="q2" vid="MAT 22:44">Diinakkaa lukittaa hegelii taadaddaramiroo;</para>
  <para style="q2" vid="MAT 22:44">«Merggetteeyi hamas's'ii amera.» ›<note caller="-" style="x"><char style="xo" closed="false">22:44 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Mez. 110:1</ref>.</char></note><verse eid="MAT 22:44"/></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45"/>Haannuun Daawute, ‹Goottaa!› Ami goɂuumiro hayya Kiristoosa misii sanniitteessa liin daanddaara?» <verse eid="MAT 22:45"/><verse number="46" style="v" sid="MAT 22:46"/>Haafura koonna abbaabin kadanddeera goorttun ese arrikko haggaɂabere hoosayin kajabaate maayyona laagiro.<verse eid="MAT 22:46"/></para>
  <chapter eid="MAT 22"/>
  <chapter number="23" style="c" sid="MAT 23"/>
  <para style="s1">Yesuusa Farasaawiilnna seera kamuse oɂagaalssisaran tuffatano</para>
  <para style="r">(<ref loc="MRK 12:38-39">Mar. 12:38-39</ref>; <ref loc="LUK 11:43-46">Luk'. 11:43-46</ref>; <ref loc="LUK 20:45-46">20:45-46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1"/>Esekko Yesuusa gosanenna usukko oɂagaalssatareenne haa ame ayeese, <verse eid="MAT 23:1"/><verse number="2" style="v" sid="MAT 23:2"/>«Seera kamuse oɂagaalssisaranna Farasaawiil Muse aani seera goggoɂagaalssisirawun odonnati isoon sisamera. <verse eid="MAT 23:2"/><verse number="3" style="v" sid="MAT 23:3"/>Haannuun iso isinuun kasegaaran dubba fela, oorayeen, ayesuun goɂameen goggoɂayeesarankki malee lakkofelaraan, iso ofelaraan felo aroofeltteen. <verse eid="MAT 23:3"/><verse number="4" style="v" sid="MAT 23:4"/>Adena sidamiin tadanddaamoon sidane taɂatii shiyeenguren haan kaɂibaaddoo gutii kaaran; iso goɂameen feriinna duuddo diniin lakkodootaran.<verse eid="MAT 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5"/>«Ibaaddon mutin ameengureen feloɂoottisoo ibaaddo horee tusayin ameereene, shaashii aani bebbeedttisooyi shaataraan, malddiya aani genettisooyi shaataraan,<note caller="+" style="f"><char style="fr" closed="false">23:5 </char><char style="fqa" closed="false">Ashenkita amano, </char><char style="ft" closed="false">kallachcha aani bebbeediinna hisilii kashaamaroya. </char></note> gashekotti sharffinna eeraasataran;<note caller="-" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="NUM 15:38">To. 15:38</ref>; <ref loc="DEU 6:8">Ada. 6:8</ref>.</char></note> <verse eid="MAT 23:5"/><verse number="6" style="v" sid="MAT 23:6"/>Taɂaamo banɂe, takabajjaantte banɂe, Ayihuudikokki min kaɂebi kahoraarjjee barc'uma hamas's'iin geelataran. <verse eid="MAT 23:6"/><verse number="7" style="v" sid="MAT 23:7"/>Usumaleenna giyaa orroo nogodda aatanona hiɂi taɂibaaddokko ‹Kaɂagaalssisatto!› amami uumamin dootataraan.<verse eid="MAT 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8"/>«Isin goɂameen ‹Kaɂagaalssisatto!› Amami lakkoɂuumaminattan, isin kaɂagaalssisara koo kaalaalya, isin dubbana abbilaalttan. <verse eid="MAT 23:8"/><verse number="9" style="v" sid="MAT 23:9"/>Daruurii kagiro Aabbo koo mankkoɂabttaan maraan ulii maayyona ‹Aabbo› ami arooɂuuntteen. <verse eid="MAT 23:9"/><verse number="10" style="v" sid="MAT 23:10"/>Isinuun baalliikkisin Kiristoosa mankkolleero maraan ‹Baallii› amami arooɂuumantteen. <verse eid="MAT 23:10"/><verse number="11" style="v" sid="MAT 23:11"/>Isin orrokko dubbaankko kanjjinkki kalleera isinuun kahandaaro linnara.<note caller="-" style="x"><char style="xo" closed="false">23:11 </char><char style="xt" closed="false"><ref loc="MAT 20:26-27">Mat. 20:26-27</ref>; <ref loc="MRK 9:35">Mar. 9:35</ref>; <ref loc="MRK 10:43-44">10:43-44</ref>; <ref loc="LUK 22:26">Luk'. 22:26</ref>.</char></note> <verse eid="MAT 23:11"/><verse number="12" style="v" sid="MAT 23:12"/>Isiɂootteessa t'ok'k'i t'ok'k'isatara yeraatara isiɂoottessa kayeraasatara ade kabajjaamara.<note caller="-" style="x"><char style="xo" closed="false">23:12 </char><char style="xt" closed="false"><ref loc="LUK 14:11">Luk'. 14:11</ref>; <ref loc="LUK 18:14">18:14</ref>.</char></note><verse eid="MAT 23:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13"/>«Isin ifissaaddolee seera oɂagaalssisattaanna Farasaawiil wononnati kadaruure tos ibaaddo goggotaboonkko ufa mankkoc'ufattan maraan aanne isinuun! Isin metekkisinuun lakkotabttaan; tabin kadootatarona lakkotabsattaan. [<verse eid="MAT 23:13"/><verse number="14" style="v" sid="MAT 23:14"/>Isin ifissaaddolee seera oɂagaalssisattaanna Farasaawiil aanne isinuun! Min kagalttanttel hawɂayi yelaa, ibaaddon mutin ebi eeraassen mankkoɂebaattan maraan kameellan firdda isin atayinattaan.]<note caller="+" style="f"><char style="fr" closed="false">23:14 </char><char style="ft" closed="false">Toottoo tagalbbaa s'uufil tooto 14 adaraan; usu haafurana Mar. 12:40 kagiro aani laara. </char></note><verse eid="MAT 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15"/>«Isin ifissaaddolee seera kamuse oɂagaalssisattaanna Farasaawiil, isin ibaaddoti koo isinkko kaɂagaalssataro yelin bekeeyinna ul gutii mankkomaraamurattan maraan iso kakkotabsseen goorata isinkko ambbaa karoore tagaannemi eleenii goggoɂiiroon mankkoyelattan maraan aanne isinuun!.<verse eid="MAT 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16"/>«Isin jaamassi jaamassi hore hayiteen ogeggeesattan; aanne isinuun! ‹Maayyona k'ulluukki min kawaayi goɂammate koonna lakkoyo; ayesuun goɂameen k'ulluukki min kawaa orroo kagiro work'k'ii gutii goɂammatte ade ammato giyaaran› amattaan. <verse eid="MAT 23:16"/><verse number="17" style="v" sid="MAT 23:17"/>Isin jaamassiilnna gowoolee work'k'iikona work'k'ii kak'ullooyisaro k'ulluukki minkkona eekiya karoorara? <verse eid="MAT 23:17"/><verse number="18" style="v" sid="MAT 23:18"/>Usumaleenna tafala banɂee kaɂammataro ibaaddon koonna lakkogiro, ayesuun goɂameen tafala banɂee kagiro jaarssoyi gutii goɂammatiraan ammatto hanɂu giyaaran amattaan. <verse eid="MAT 23:18"/><verse number="19" style="v" sid="MAT 23:19"/>Isin jaamaleessa falakkona tak'ullooyisatto tafala banɂekko eekiya karoorara? <verse eid="MAT 23:19"/><verse number="20" style="v" sid="MAT 23:20"/>Haannuun tafala banɂeeyi kaɂammatera kakkofalatarani gutii kagiro dubbaayi ammatara.<note caller="+" style="f"><char style="fr" closed="false">23:20 </char><char style="fqa" closed="false">Meebaa </char><char style="ft" closed="false">ibaaddo Hedokkeessawun kasisara kaɂameen dubba meebaa amamara. </char></note> <verse eid="MAT 23:20"/><verse number="21" style="v" sid="MAT 23:21"/>Usumaleenna k'ulluukki min kawaayi kaɂammate k'ulluukki min kawaayi orroo kagiroonna ammatara. <verse eid="MAT 23:21"/><verse number="22" style="v" sid="MAT 23:22"/>Daruurii kaɂammate korffinjje kawaayi gutii kahamas'eeroyinna ammatara.<note caller="-" style="x"><char style="xo" closed="false">23:22 </char><char style="xt" closed="false"><ref loc="ISA 66:1">Isa. 66:1</ref>; <ref loc="MAT 5:34">Mat. 5:34</ref>.</char></note><verse eid="MAT 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23"/>«Isin ifissaaddolee seera kamuse oɂagaalssisattaanna Farasaawiil aanne isinuun! Anuugakko, deebbokkona okashekko kahoraarjjee hora Waawuun sisattan, seera orroo kagiro metekki ayees kalleero; firdda karrummii, shaagana, abddamano addeen tuffattettaan. Aanɂi haɂiisooni hinɂana feltteenwa kaɂidanye.<note caller="-" style="x"><char style="xo" closed="false">23:23 </char><char style="xt" closed="false"><ref loc="LEV 27:30">Woy. 27:30</ref>.</char></note> <verse eid="MAT 23:23"/><verse number="24" style="v" sid="MAT 23:24"/>Isin jaamaleessa jaamaleessa hore hayiteen ogeggeesattan! Biinɂi aani kalaaro ayees assaabtteen shafattan; gaala aani kaleyaaro ayees addeen ennegattan.<verse eid="MAT 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25"/>«Isin ifissaaddolee seera oɂagaalssisattaanna Farasaawiil; aanne isinuun! Kafala yaalɂana kat'ugga huu mina tasaree taalaal shashakaarattan; orroɂoottiso goɂameen saamanoyinna isiɂawodayiwaattii ammagamera. <verse eid="MAT 23:25"/><verse number="26" style="v" sid="MAT 23:26"/>Ati jaamakki Farasaawiti t'ayi huu kafala yaalɂana kat'ugga huu orro muc'c'isi; esekko guutikkisona kamuc'c'ime leera.<verse eid="MAT 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27"/>«Isin ifissaaddolee seera oɂagaalssisattaanna Farasaawiil guutikkiso barssaa t'alalame kaɂiidaro, orroɂoottiso goɂameen kagoye ibaaddokokki lefaalinna battiikki ayees dubbaa kaɂammagame hiyyeel aani mankkolaattan maraan aanne isinuun.<note caller="-" style="x"><char style="xo" closed="false">23:27 </char><char style="xt" closed="false"><ref loc="ACT 23:3">Ofa. Fe. 23:3</ref>.</char></note> <verse eid="MAT 23:27"/><verse number="28" style="v" sid="MAT 23:28"/>Isinna sarre ibaaddon k'ulluukki aani laattan, orroɂoottisin goɂameen ifissaaddayinna meellaneeyi oɂammagameenyyaan.<verse eid="MAT 23:28"/></para>
  <para style="s1">Seera kamuse oɂagaalssisaranna kafarasaawil murrisamano</para>
  <para style="r">(<ref loc="LUK 11:47-51">Luk'. 11:47-51</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29"/>«Isin ifissaaddolee, seera kamuse oɂagaalssisattaanna Farasaawiil aanne isinuun! Kahegeroolkokki k'amal gimbbaa kak'ulloolee k'amal issaadisaa, <verse eid="MAT 23:29"/><verse number="30" style="v" sid="MAT 23:30"/>‹Kat'awoo Odolaalkkaanikki geesii kaginne leenewa, kahegeroolkokki iigi ubanooyi isone wota lakkolaanne› amattaan. <verse eid="MAT 23:30"/><verse number="31" style="v" sid="MAT 23:31"/>Hikkaniinna kahegerool lagadeen ogireen odolaalkaaniwun sannii laanokisin isi oottisin gutii atotinattaan. <verse eid="MAT 23:31"/><verse number="32" style="v" sid="MAT 23:32"/>Goorttanun odolaalkisin felin ohaggaɂabeeren felo gudisa.<verse eid="MAT 23:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33"/>«Isin habeessal! Yiis kajaarɂa tabaanon tagaannemi eleenkotti murittikko misii hesiin daanddeetan?<note caller="-" style="x"><char style="xo" closed="false">23:33 </char><char style="xt" closed="false"><ref loc="MAT 3:7">Mat. 3:7</ref>; <ref loc="MAT 12:34">12:34</ref>; <ref loc="LUK 3:7">Luk'. 3:7</ref>.</char></note> <verse eid="MAT 23:33"/><verse number="34" style="v" sid="MAT 23:34"/>Haannuun kahegeroo, k'arooleelnna seera oɂagaalssisaran farnnara, hinɂakko kookkoo lagadinnattan, kookkoonna suyinnattaan, kakkaleenna Ayihuudikokki min kaɂebi orroo boc'c'innattaan. Katamaa tookko katamaa takkalee tos isin iso horoornnattan. <verse eid="MAT 23:34"/><verse number="35" style="v" sid="MAT 23:35"/>Haannuun k'ulluukki kaɂaabeela iigikko haggaɂabere k'ulluukki miniinna fala mankkofelatarani t'eɂee kalagaddeettan ere kaberaakiyukko taa kazakkiraasa iigi geeroo ulii gutii kaɂubatero k'ulluukki iigi dubbaan isin ohoosamattanttaan.<note caller="-" style="x"><char style="xo" closed="false">23:35 </char><char style="xt" closed="false"><ref loc="GEN 4:8">Met'. 4:8</ref>; <ref loc="2CH 24:20-21">2 Od. 24:20-21</ref>.</char></note> <verse eid="MAT 23:35"/><verse number="36" style="v" sid="MAT 23:36"/>Ani rumminaa amara karoorero ayees dubbaan hitti alattaan hoosamatta.<verse eid="MAT 23:36"/></para>
  <para style="s1">Yesuusa Iyyerusaalemi maraan ootano</para>
  <para style="r">(<ref loc="LUK 13:34-35">Luk'. 13:34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37"/>«Ati Iyyerusaalemi, kahegeroo talagadatta, ku tos ofarameeraanna eɂemooyi taɂeeggatta ati Iyyerusaalemi lukkale c'uc'uutekkisee baalkkise hegelii goggokukkuyisattoyi, ibaaddokkaa kukkuyisin miyyaa gale ani doote, isin goɂameen ii lakkoɂanttettaan. <verse eid="MAT 23:37"/><verse number="38" style="v" sid="MAT 23:38"/>Goortta k'ulluukki min kaɂebikakkisin ona lii hesinnara.<note caller="-" style="x"><char style="xo" closed="false">23:38 </char><char style="xt" closed="false"><ref loc="JER 22:5">Erm. 22:5</ref>.</char></note> <verse eid="MAT 23:38"/><verse number="39" style="v" sid="MAT 23:39"/>Haanssun, ‹Kagootta megee kaɂemeetara kasommaasameya› taa anttaanii gin hikka gooratakko haggaɂabre isin kallami in lakkodeetan.»<note caller="-" style="x"><char style="xo" closed="false">23:39 </char><char style="xt" closed="false"><ref loc="PSA 118:26">Mez. 118:26</ref>.</char></note><verse eid="MAT 23:39"/></para>
  <chapter eid="MAT 23"/>
  <chapter number="24" style="c" sid="MAT 24"/>
  <para style="s1">Kagachchoo alamikokki malaataal</para>
  <para style="r">(<ref loc="MRK 13:1-2">Mar. 13:1-2</ref>; <ref loc="LUK 21:5-6">Luk'. 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1"/>Yesuusa k'ulluukki min kawaakko beegure seetaa giraan usukko oɂagaalssatareen k'ulluukki minkkokki gimbbe tusin usu tos emeeten. <verse eid="MAT 24:1"/><verse number="2" style="v" sid="MAT 24:2"/>Usu goɂameen, «Hikka dubba diyaattaan?» «Ani rumminaa amara eɂemo eɂemoo gutii kaginbamera goggodiyaattanii hadarɂaamooni hikkamalee goggogirooyi kahesira eɂemo koonna laagiro» ame.<verse eid="MAT 24:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3"/>Yesuusa zayitii kabeyaara gaa takkoɂalataro wodami gutii hamas's'ee giraan; usukko oɂagaalssatareen kale been usu tos seeteengureen «Alla noon segiilla» «Hikki ati kaɂamatta dubbaa goree linnara? Emeetottana alamikkotti gachchoon malaata meyya?» ameen. <verse eid="MAT 24:3"/><verse number="4" style="v" sid="MAT 24:4"/>Yesuusana abbaabere haa ame; «Maayyoona isin goggosoboonkko isiɂoorayeen.» <verse eid="MAT 24:4"/><verse number="5" style="v" sid="MAT 24:5"/>Kamoogganna ani Kiristoosaya amaa megekkeeyi emeeyinnara kamoogganna shirsinaraan. <verse eid="MAT 24:5"/><verse number="6" style="v" sid="MAT 24:6"/>Jereenna gara kajereene taɂayeesamatto odu isin maalinnattan; hikki ayees laano kahesooniya, halleewo kuwaarre gachcho ganaa mankkolleete maraan hikkanii isin goggoneyinokko isiɂoorayeen. <verse eid="MAT 24:6"/><verse number="7" style="v" sid="MAT 24:7"/>Gosa gosaayi gutii, wononna wonoo gutii kiinnara, banɂe banɂeeyi uɂina ulkokki aaɂaano linnara. <verse eid="MAT 24:7"/><verse number="8" style="v" sid="MAT 24:8"/>Hikki dubba goɂameen k'aniin kaɂummullakkotti rakkookko tahoraarijjeetta.<verse eid="MAT 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9"/>«Hassu goorata ibaaddo isin rakkoowun roorisi sisinnara, lagadinnaran; megekkeekkotti aalanttii gosa dubbaa dollee odiidantteen linnattaan.<note caller="-" style="x"><char style="xo" closed="false">24:9 </char><char style="xt" closed="false"><ref loc="MAT 10:22">Mat. 10:22</ref>.</char></note> <verse eid="MAT 24:9"/><verse number="10" style="v" sid="MAT 24:10"/>Hassu goorata kamooggan ammanokkisoo iisinara, koo kakkalee roorisi sisinnara; isi isiɂorroonna kookkoo diidinnaraan. <verse eid="MAT 24:10"/><verse number="11" style="v" sid="MAT 24:11"/>Kamooggan kat'araa kahegerool kiinnara, kamoogganna sossoyisinaraan. <verse eid="MAT 24:11"/><verse number="12" style="v" sid="MAT 24:12"/>Tamooggan meellanekko kakkeeyi kamooggan ibaaddokkotti geelanjje ambbal linnatta. <verse eid="MAT 24:12"/><verse number="13" style="v" sid="MAT 24:13"/>Tagachchoo arri taageeroon kaɂataate hassu fayyinara. <verse eid="MAT 24:13"/><verse number="14" style="v" sid="MAT 24:14"/>Gosa dubbaan ato goggolleeroon hikki wononnati kawaakokki wongala alami dubbaayi lallabaaminnara, esekkona tagachchoo arri emeeyinnatta.<verse eid="MAT 24:14"/></para>
  <para style="s1">Bayi kakkeenaro battiikki kooko</para>
  <para style="r">(<ref loc="MRK 13:14-23">Mar. 13:14-23</ref>; <ref loc="LUK 21:20-24">Luk'. 21:20-24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15"/>«Goortanun kahegeroo Daanelan goggosegaamerokki malee, ‹Kabattoyisira kameellan ayees tak'ulloyitetto banɂee kaɂaalleero kakkodeeten goorata kannabbabara hashaado!›<note caller="-" style="x"><char style="xo" closed="false">24:15 </char><char style="xt" closed="false"><ref loc="DAN 9:27">Dan. 9:27</ref>; <ref loc="DAN 11:31">11:31</ref>; <ref loc="DAN 12:11">12:11</ref>.</char></note> <verse eid="MAT 24:15"/><verse number="16" style="v" sid="MAT 24:16"/>Hassu goorata ul kayihuudayi kagirana wodami tos habak'ato, <verse eid="MAT 24:16"/><verse number="17" style="v" sid="MAT 24:17"/>Minii fook'ii gutii kagira maamisikki ibaaddona huu minkko atayin arooddago,<note caller="-" style="x"><char style="xo" closed="false">24:17 </char><char style="xt" closed="false"><ref loc="LUK 17:31">Luk'. 17:31</ref>.</char></note> <verse eid="MAT 24:17"/><verse number="18" style="v" sid="MAT 24:18"/>Iraa kagira ibaaddotina sarssikkeessa atayin arooɂabbaabanno. <verse eid="MAT 24:18"/><verse number="19" style="v" sid="MAT 24:19"/>Ese arri heleel kafatowunna kaɂiilisaroon rakkoo taɂatii leeta. <verse eid="MAT 24:19"/><verse number="20" style="v" sid="MAT 24:20"/>Goorttanu bak'atanokkisin bat't'eessayi goorttun Ayihuudin tafoolssi arri goggolleenoonkko ebaayen. <verse eid="MAT 24:20"/><verse number="21" style="v" sid="MAT 24:21"/>Hassu goorata alami takkomet'amero arrikko haggaɂabere taa hittaari geeroo lii kakkasoon esekkona horenbbaan ese rakkoonne wota kakkoɂekkaaro kallayitti rakkoo taɂatii linnatta. <verse eid="MAT 24:21"/><verse number="22" style="v" sid="MAT 24:22"/>Hassu arriil gabaabbayi waatenna ibaaddo dubba lakkohesare. Kaɂassaabamero maraan goɂameen hanɂu arrija gabaabbateen. <verse eid="MAT 24:22"/><verse number="23" style="v" sid="MAT 24:23"/>Hassu goorata maayyonna hikkima Kiristoosa hittanii gira goorttun hassee gira goɂameenna arooɂabddatteen. <verse eid="MAT 24:23"/><verse number="24" style="v" sid="MAT 24:24"/>Kat'araa Kiristoosalnna kat'araa hegerool kiinnaraan, isoon goɂekkaate kaɂassaabamerona shirsiin amireene kaɂatii baasakki malaataalnna tusinaraan.<note caller="-" style="x"><char style="xo" closed="false">24:24 </char><char style="xt" closed="false"><ref loc="DAN 12:1">Dan. 12:1</ref>; <ref loc="REV 7:14">Rag. 7:14</ref>.</char></note> <verse eid="MAT 24:24"/><verse number="25" style="v" sid="MAT 24:25"/>Goortta ani isinuun t'aye segaara:<verse eid="MAT 24:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26"/>«Haanssun ‹Aankkima gaa orroo gira,› goɂameenna eserraa aroobbeeten, Hikkima min orroo giridii gira goɂameen arooɂabddatteen.<note caller="-" style="x"><char style="xo" closed="false">24:26 </char><char style="xt" closed="false"><ref loc="LUK 17:23-24">Luk'. 17:23-24</ref>.</char></note> <verse eid="MAT 24:26"/><verse number="27" style="v" sid="MAT 24:27"/>Hank'k'a mina tabiyaankko beegure mina taɂiyaan tos taageero goggohank'aaroo ere kaɂibaaddokkotti emeeto hikkamalee linnatta. <verse eid="MAT 24:27"/><verse number="28" style="v" sid="MAT 24:28"/>Rak'a takkogiro banɂe dubbaa allaattil kukkuɂamara.<note caller="-" style="x"><char style="xo" closed="false">24:28 </char><char style="xt" closed="false"><ref loc="LUK 17:37">Luk'. 17:37</ref>.</char></note><verse eid="MAT 24:28"/></para>
  <para style="s1">Ere kaɂibaaddokkotti tallami emeeto</para>
  <para style="r">(<ref loc="MRK 13:24-27">Mar. 13:24-27</ref>; <ref loc="LUK 21:25-28">Luk'. 21:25-28</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29"/>«Hanɂu tarrakkoo arrijjakko abbaabayire goorsewa</para>
  <para style="q1" vid="MAT 24:29">« ‹Arriti mugud linnatta,</para>
  <para style="q2" vid="MAT 24:29">diginninna ifakkisee tiraynnatta,</para>
  <para style="q1" vid="MAT 24:29">Barraajjana daruurkko ubayinara,</para>
  <para style="q2" vid="MAT 24:29">kadaruuree hunnana shalagaaminara.›<note caller="-" style="x"><char style="xo" closed="false">24:29 </char><char style="xt" closed="false"><ref loc="ISA 13:10">Isa. 13:10</ref>; <ref loc="ISA 34:4">34:4</ref>; <ref loc="EZK 32:7">Hiz. 32:7</ref>; <ref loc="JOL 2:10">Iyu. 2:10</ref>,<ref loc="JOL 2:31">31</ref>; <ref loc="JOL 3:15">3:15</ref>; <ref loc="REV 6:12-13">Rag. 6:12-13</ref>; <ref loc="DAN 7:13">Dan. 7:13</ref>; <ref loc="ZEC 12:10-14">Zak. 12:10-14</ref>; <ref loc="REV 1:7">Rag. 1:7</ref>.</char></note><verse eid="MAT 24:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30"/>«Hassu goorata ere kaɂibaaddoo malaata daruurii gutii mutinnara, hassu goorata ulii tagitta aani dubbana woo woo ami ooyinnara. Ere kaɂibaaddona kadaruure duumanchchaayi orroo hunnaayinna taɂatii kabajaayi emeetaa giraan dinnaraan. <verse eid="MAT 24:30"/><verse number="31" style="v" sid="MAT 24:31"/>Erggichchalna taɂatii tamalakata yaayene wota faraminnara, isona oɂassabaameraan alamii mina afarkko daruurkkotti gachchokko taa daruurkkotti gachcho geeroo ibaaddo kukkuyisinaran.<verse eid="MAT 24:31"/></para>
  <para style="s1">Kabalasi gaakokki masuussa</para>
  <para style="r">(<ref loc="MRK 13:28-31">Mar. 13:28-31</ref>; <ref loc="LUK 21:29-33">Luk'. 21:29-33</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32"/>«Kabalasi gaakko hikka agaalssis agaalssayeen, ballaal gohurisiro baalallo goc'ariidiraan hassu goorata bat't'eessa gabbalamano addeesattaan.<note caller="+" style="f"><char style="fr" closed="false">24:32 </char><char style="fqa" closed="false">Giilaal </char><char style="ft" closed="false">hikki segaano katusara ulkkisooyi gaa kakkohurisarana baalallo kakkoc'ariidaraan giilaal goggabbalamiro mankkollee maraanya. </char></note> <verse eid="MAT 24:32"/><verse number="33" style="v" sid="MAT 24:33"/>Hikkamaleenna hikka dubba goddeeten ese arri goc'atii gabbalamano addeesa. <verse eid="MAT 24:33"/><verse number="34" style="v" sid="MAT 24:34"/>Ani rumminaa amara hikki dubba taagudaroo hitti alattaan lakkoroortto. <verse eid="MAT 24:34"/><verse number="35" style="v" sid="MAT 24:35"/>Ulnna daruurnna roorraanwa haafurakki goɂameen suure lakkoroorro.<verse eid="MAT 24:35"/></para>
  <para style="s1">Goottaa takkoɂemeeyinnara arri addeesamana waatti</para>
  <para style="r">(<ref loc="MRK 13:32-37">Mar. 13:32-37</ref>; <ref loc="LUK 17:26-30">Luk'. 17:26-30</ref>,<ref loc="LUK 17:34-36">34-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36"/>«Hasse arrina hasse saatii goɂameen odo kuwaarre kadaruure erggichchaal golleenna, Ere golleenna koonna laakkaso. <verse eid="MAT 24:36"/><verse number="37" style="v" sid="MAT 24:37"/>Kanohe geesii goggolleeroyi Ere kaɂibaaddokkotti emeeto usumalee linnatta.<note caller="-" style="x"><char style="xo" closed="false">24:37 </char><char style="xt" closed="false"><ref loc="GEN 6:5-8">Met'. 6:5-8</ref>.</char></note> <verse eid="MAT 24:37"/><verse number="38" style="v" sid="MAT 24:38"/>Usu geesii beke miirɂa geegisanakko horeene Nohe markkafa tos takkotabinaro arri taageeroon ibaaddo aamaanna t'amaanna, oori atataanna keesataa goggogireenkki malee, <verse eid="MAT 24:38"/><verse number="39" style="v" sid="MAT 24:39"/>Hasse arri taageeto me emeeyinnaro haɂaddeesooni miirɂa tabekeeyi goggoɂennegamerani ere kaɂibaaddokkotti emeeto usumalee linnatta. <verse eid="MAT 24:39"/><verse number="40" style="v" sid="MAT 24:40"/>Usu goorata ibaaddojja lama iraa hayinnaraan, koo ataminara koo hesinnara, <verse eid="MAT 24:40"/><verse number="41" style="v" sid="MAT 24:41"/>Heleel lama riim kooyi riitayinaraan too ataminatta, takkalee hesinnatta.<verse eid="MAT 24:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42"/>«Goorttanu Goottakkisin takkoɂemeeyinnaro arri isin mankkokasoon maraan nabbaada oorayeen, <verse eid="MAT 24:42"/><verse number="43" style="v" sid="MAT 24:43"/>Hikka wodanaa abayeen, odo minee heto hemeen maagorata emeeyinnatto addeesi girewa nabbaadi min goggosaamamonkko ooratarewa. <verse eid="MAT 24:43"/><verse number="44" style="v" sid="MAT 24:44"/>Ere kaɂibaaddonna isin kakkoshaadon goorata mankoɂemeeyinnaro maraan, isinna isiɂekkaasayeen oora.<note caller="-" style="x"><char style="xo" closed="false">24:44 </char><char style="xt" closed="false"><ref loc="LUK 12:39-40">Luk'. 12:39-40</ref>.</char></note><verse eid="MAT 24:44"/></para>
  <para style="s1">Kaɂabddamena kaɂabddamoon kahandaarokokki masuussa</para>
  <para style="r">(<ref loc="LUK 12:41-48">Luk'. 12:41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45"/>«Babokkisoo isoon kakkodootisaro goorata goggosisiroo goottaa minkkeessakki ibaaddo gutii kashuumatera kaɂabdamena k'arookki kahandaara ayyoyya? <verse eid="MAT 24:45"/><verse number="46" style="v" sid="MAT 24:46"/>Goottaakkeessa abbaabayi kakkoɂemeero goorata tasisanttetto hadara fele gudise giraan kahelnnara hassu kahandaara kasommaasameya. <verse eid="MAT 24:46"/><verse number="47" style="v" sid="MAT 24:47"/>Ani rumminaa amara ogiraan urrawo dubbaayi gutii usu shoomiinnara. <verse eid="MAT 24:47"/><verse number="48" style="v" sid="MAT 24:48"/>Ayesuun goɂameen kahandaara hassu ibaaddoti kameellan golleenna usu metekkeessan, ‹goottaa adallaayinara› amaa, <verse eid="MAT 24:48"/><verse number="49" style="v" sid="MAT 24:49"/>Kiigure kakkalee kahandaaro jaleettessa boc'aano gohaggaɂabe t'ameen osetaaraanne wota goɂaamenna got'ame, <verse eid="MAT 24:49"/><verse number="50" style="v" sid="MAT 24:50"/>Hassu kahandaarokkokki goottaa usu taɂoorannon arriinna takkoshaadon saatii emeeyigure, <verse eid="MAT 24:50"/><verse number="51" style="v" sid="MAT 24:51"/>Hassu kahandaarokki goottaakkeessa murrisinnara, it'aattessana ifissaaddoleenne wota yelinnara, ese banɂee oottanna ilkko fooc'ano linnara.<verse eid="MAT 24:51"/></para>
  <chapter eid="MAT 24"/>
  <chapter number="25" style="c" sid="MAT 25"/>
  <para style="s1">Deeleeljja tomonkokki masuussa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1"/>«Hassu goorata wononnati kadaruure dab abateenguren mashaashe k'op'ayin obeeraan deeleeljja tomon aani laara.<note caller="-" style="x"><char style="xo" closed="false">25:1 </char><char style="xt" closed="false"><ref loc="LUK 12:35">Luk'. 12:35</ref>.</char></note> <verse eid="MAT 25:1"/><verse number="2" style="v" sid="MAT 25:2"/>Iso orrokko deeleeljja kenno gowwaa, deeleeljja kenno adeen k'arooleeyyen. <verse eid="MAT 25:2"/><verse number="3" style="v" sid="MAT 25:3"/>Gowoolee dab abateenguren lanbbaa minjja lakkoɂabateeren, <verse eid="MAT 25:3"/><verse number="4" style="v" sid="MAT 25:4"/>K'aroolee goɂameen dabkkisoonne wota lanbbaa minjja t'armmusiyi abateen gireen. <verse eid="MAT 25:4"/><verse number="5" style="v" sid="MAT 25:5"/>Kamashaashee kakkoɂadallaatere goorata dubbana hudduro kakkodutisatte goorata huddureen.<verse eid="MAT 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6"/>«Ul hemeen t'eɂe kakkolaare goorata ‹Kamaashaashee emeetara biyaa k'op'ayeen taɂamatta uumit maalssantte.›<verse eid="MAT 25:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7"/>«Hassu goorata deeleeljja dubba keengureen dabkkisoo hank'k'ayisaten ekkaasateen. <verse eid="MAT 25:7"/><verse number="8" style="v" sid="MAT 25:8"/>Gowoolee k'arooleenne ‹Dabkkaani bayinara laanbbaatisinkko noon sisa,› ameen.<verse eid="MAT 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9"/>«K'arooleenɂi deeleeljja goɂameen abbaabenguren no taɂabnna laanbbaa ‹Noyeenna isinuunna laanawaayin daanddaatta, seyeenddeene laanbbaa kadaddalatarokko ussun iminayeen› ameen.<verse eid="MAT 25:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10"/>«Laanbbaa iminayin kakkobiyaaren goorata kamashaashee emeete, ekkaasateen ogireen deeleeljjana kahaassinoo aamo takkoɂekkaatero banɂe usune wota tabeen, ufana c'ufame.<verse eid="MAT 25:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11"/>«Adallaaten oɂemeeteran okkalee deeleeljja, ‹Goottaa! Goottaa!› maganne ‹Noon ufa banina› ameen.<verse eid="MAT 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12"/>«Usu goɂameen, ‹Ani rumminaa amara ani isin laakkaso› ame isoon abbaabe.<note caller="-" style="x"><char style="xo" closed="false">25:12 </char><char style="xt" closed="false"><ref loc="LUK 13:25">Luk'. 13:25</ref>.</char></note><verse eid="MAT 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13"/>«Goorttanu isin arri goorttun saatii mankkokasoon maraan isiɂekkaasayeen oora.<verse eid="MAT 25:13"/></para>
  <para style="s1">Ohandaaran seedkokki masuussa</para>
  <para style="r">(<ref loc="LUK 19:11-27">Luk'. 19:11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14"/>«Wononnati kadaruuree ibaaddoti koo usuun ohandaareen isi tos uumegure oɂabo urrawoɂoottessa hadara sisegure ul kakkalee seeyin kakkeero ibaaddoti aani laara.<note caller="-" style="x"><char style="xo" closed="false">25:14 </char><char style="xt" closed="false"><ref loc="LUK 19:11-27">Luk'. 19:11-27</ref>.</char></note> <verse eid="MAT 25:14"/><verse number="15" style="v" sid="MAT 25:15"/>Odo odoo feloɂoottisokki malee koowun t'agaraa ken, koowun lama, koowun ade t'agaraa too sisegure goorsewa ul kakkalee iise seete. <verse eid="MAT 25:15"/><verse number="16" style="v" sid="MAT 25:16"/>T'agaraa ken kaɂatatera ibaaddoti goorsewa daddalatano haggaɂabere takkalee t'agaraa ken worɂe helate. <verse eid="MAT 25:16"/><verse number="17" style="v" sid="MAT 25:17"/>Usumaleenna t'agaraa lama kaɂataterena t'agaraa lama worɂe helate. <verse eid="MAT 25:17"/><verse number="18" style="v" sid="MAT 25:18"/>T'agaraa too kaɂatatera goɂameen ul oshegure maragade kagoottaa k'amale.<verse eid="MAT 25:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19"/>«Ohandaaraankokki goottaa mankkoseeteroo tanjjiin adallaate emetere tasisero t'agaraa tootaayi din haggaɂabe. <verse eid="MAT 25:19"/><verse number="20" style="v" sid="MAT 25:20"/>T'agaraa ken kaɂatatere takkalee t'agaraa ken worɂe helate aate emeetegure, ‹goottaa!› Ati iin t'agaraa ken sissette, hikkima takkalee t'agaraa ken worɂe helera ame.<verse eid="MAT 25:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21"/>«Goottakkeessana ‹Goɂidan felttetta, ati kaɂidankki kaɂabddantte, kic'c'arkki ayeesii kaɂabddantte mankkolleete maraan kamooggan ayeesii ani ku shuuminara, goottakkaanɂi geggeloo tos tabi› ame.<verse eid="MAT 25:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22"/>«Usumaleenna t'agaraa lama kaɂatatera kahandaara emeetegure ‹goottaa!› ati iin t'agaraa lama sissette, hikkima t'agaraa lama daddalegure takkalee t'agaraa lama worɂe helera ame.<verse eid="MAT 25:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23"/>«Goottakkeessana ‹Goɂidan felttetta, ati kaɂidankkina kaɂabddantte kahandaatta kic'c'arkkiin kaɂabddantte mankkolleete maraan kamooggan ayees gutii ani ku shuuminara, goottakkaanɂi geggeloo tos tabi› ame.<verse eid="MAT 25:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24"/>«T'agaraa too kaɂatatere kahandaarokkina emeetegure ‹gootta!› Ati kawut'annon gitto kamat'aratto, kadarɂinnon gitto kakukkuyisaatto bogikaɂatii ibaaddoti laano kasowa, <verse eid="MAT 25:24"/><verse number="25" style="v" sid="MAT 25:25"/>Haannuun abssayere, ‹T'agaraattaa erree k'amalera, hikkima maragadekka› ame.<verse eid="MAT 25:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26"/>«Goottakkeessana abbaabere, ‹Ati kameellankkina boozzakki kahandaatta, kawut'annon giro kamat'aratarona, kadarɂinnon giro kakukkuyisataro laanokkee kasso? <verse eid="MAT 25:26"/><verse number="27" style="v" sid="MAT 25:27"/>Hayya ani kakkoɂabbaabataro goorata t'agarattee worɂene wota goggoɂataroo odaddalatarawun sisano dootisare.<verse eid="MAT 25:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 25:28"/>« ‹Goorittanuu t'agaraa aatagudden t'agaraa tomon kaɂaboon sisa, <verse eid="MAT 25:28"/><verse number="29" style="v" sid="MAT 25:29"/>kaɂaboon adamara, moggaatara, kallayiikkikko goɂameen hassu kagirawa atamara.<note caller="-" style="x"><char style="xo" closed="false">25:29 </char><char style="xt" closed="false"><ref loc="MAT 13:12">Mat. 13:12</ref>; <ref loc="MRK 4:25">Mar. 4:25</ref>; <ref loc="LUK 8:18">Luk'. 8:18</ref>.</char></note> <verse eid="MAT 25:29"/><verse number="30" style="v" sid="MAT 25:30"/>Hikka laɂo kallayiikki kahandaaro oottanna ilkko fooc'ano mankkogiro sarre kagiro t'illinggakki mugud tos beesa shafa› ame.<note caller="-" style="x"><char style="xo" closed="false">25:30 </char><char style="xt" closed="false"><ref loc="MAT 8:12">Mat. 8:12</ref>; <ref loc="MAT 22:13">22:13</ref>; <ref loc="LUK 13:28">Luk'. 13:28</ref>.</char></note><verse eid="MAT 25:30"/></para>
  <para style="s1">Alamikokki kagachchoo firdda</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31"/>«Ere kaɂibaaddo erggichchalkkeessa dubbane wota kabajaa goɂemeete kakkabajaa korffinjjeeyi gutii hamas'iinnara.<note caller="-" style="x"><char style="xo" closed="false">25:31 </char><char style="xt" closed="false"><ref loc="MAT 16:27">Mat. 16:27</ref>; <ref loc="MAT 19:28">19:28</ref>.</char></note> <verse eid="MAT 25:31"/><verse number="32" style="v" sid="MAT 25:32"/>Gosa dubba usuu horee kukkuminnara, usuna, kafoofee idaad oreenkko goggoɂassaabarooyi, gosa koo kakkaleekko assaabinara. <verse eid="MAT 25:32"/><verse number="33" style="v" sid="MAT 25:33"/>Idaad mina tamerggenne oreen mina tabetene aalliisinnara.<verse eid="MAT 25:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34"/>«Hassu goorata wono mina tamerggenne ogiraanne haa aminara, ‹Isin Aabbokki osommaasatera koyeen alami takkomet'amerokko haggaɂabere isinuun kaɂekkaatero wononnati eela. <verse eid="MAT 25:34"/><verse number="35" style="v" sid="MAT 25:35"/>Aalanttina ani uuɂee aamisseettan, sugubaaye t'amissettan, ani martti lee goɂemeeye k'op'atteettan, <verse eid="MAT 25:35"/><verse number="36" style="v" sid="MAT 25:36"/>Ani hawɂayi gollee sarssisseettan, ani hawɂaame deetettan, shaame gollee in tos emeetteen hoosattettaan.›<verse eid="MAT 25:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37"/>«K'ullooleenna abbaabeen haa ameen, ‹Gootta! Ati uuɂite deenne goree no ku aaminsse? Goorttun sugubaatte deenne goree no ku t'aminsse? <verse eid="MAT 25:37"/><verse number="38" style="v" sid="MAT 25:38"/>Martti leete deenne goree no ku k'op'anne? Goorttun hawɂayi leete deenne goree sarssinsse? <verse eid="MAT 25:38"/><verse number="39" style="v" sid="MAT 25:39"/>Usumaleenna hawɂaantte goorttun shaantte goree seenne no ku hoosanne?›<verse eid="MAT 25:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40"/>«Wonona abbaabere, ‹Ani rumminaa amara hinɂa huc'c'arri olleeraan abbilaaltteekko koowun kayeltteettan iin feltteettaan aaniya› ame abbaabe.<verse eid="MAT 25:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41"/>«Esekkona mina tabetene ogiraanne ade haa aminara, ‹Isin ok'angaanttettaan, durrisanna erggichchakeessawun taɂekkaattetto jiruu jiroomman eleen tos inkko kale biyaadden seeyeen. <verse eid="MAT 25:41"/><verse number="42" style="v" sid="MAT 25:42"/>Aalanttina ani uuɂee lakkoɂaamisseettan, ani sugubaaye lakkot'amissettaan, <verse eid="MAT 25:42"/><verse number="43" style="v" sid="MAT 25:43"/>Ani martti lee goɂemeeye lakkok'op'attettaan hawɂayi lee lakkosarssissettaan, ani hawɂaamena shaame gollee in tos emeetteen lakkohoosatteettan.›<verse eid="MAT 25:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44"/>«Isona abbaabereen, ‹Gootta! Ati uuɂite goorttun sugubaatte, ati martti leete goorttun hawɂayi leete, hawɂaantte goorttun shaantte deennenne goree gargaarana waanne?›<verse eid="MAT 25:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45"/>«Hassu goorata wono abbaabere, ‹Ani rumminaa amara hinɂa huc'c'arri olleeraankko koowun felana waattii iinna lakkofelttettaan› aminara.<verse eid="MAT 25:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46"/>«Hinɂa Jiruu jiroommatti murro tos, k'ulloolee adeen jiruu jiroommakki giri tos seeyinnaraan.»<note caller="-" style="x"><char style="xo" closed="false">25:46 </char><char style="xt" closed="false"><ref loc="DAN 12:2">Dan. 12:2</ref>.</char></note><verse eid="MAT 25:46"/></para>
  <chapter eid="MAT 25"/>
  <chapter number="26" style="c" sid="MAT 26"/>
  <para style="s1">Ayihuudil Yesuusa lagadin t'oyeen</para>
  <para style="r">(<ref loc="MRK 14:1-2">Mar. 14:1-2</ref>; <ref loc="LUK 22:1-2">Luk'. 22:1-2</ref>; <ref loc="JHN 11:45-53">Yan. 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1"/>Yesuusa hikka ayees dubba ayeese kakkogudisare goorata, usukko oɂagaalssatareenne, <verse eid="MAT 26:1"/><verse number="2" style="v" sid="MAT 26:2"/>«Arri lamakko abbaabayire kafaasikkaa baala kakkabajaaminaro laano kassaanwa, ere kaɂibaaddona suwaamiin roori sisaminara» ame.<note caller="-" style="x"><char style="xo" closed="false">26:2 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">Biy. 12:1-27</ref>.</char></note><verse eid="MAT 26:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3"/>Esekko abbaabatere katuuk'aamol woyichchaalnna jaarssa kaɂulee K'eyaafa kaɂamamaro tuuk'aamolun odonnati kaɂabokkokki awudii orroo kukkuɂameenguren, <verse eid="MAT 26:3"/><verse number="4" style="v" sid="MAT 26:4"/>Miiggeeyi Yesuusa abiinna lagadisisin makkareen. <verse eid="MAT 26:4"/><verse number="5" style="v" sid="MAT 26:5"/>«Ayesuun goɂameen gosaa orroo shalago goggokeennoonkko tabaala arri aroolleeno» ameen hiɂi too leen.<verse eid="MAT 26:5"/></para>
  <para style="s1">Yesuusaa gutii shittoo takibttetto heleelttiti</para>
  <para style="r">(<ref loc="MRK 14:3-9">Mar. 14:3-9</ref>; <ref loc="JHN 12:1-8">Yan. 12:1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6"/>Yesuusa Bitaanyaayi maarii bar kaɂabo Simoonakokki minii giraan, <verse eid="MAT 26:6"/><verse number="7" style="v" sid="MAT 26:7"/>Heleelttiti too dookki aaloo awɂallo talleetetto shittoo kaɂalbbast'iroosi bilk'aade kooyi aatte Yesuusa tos gabbalantte, babo aamaa hamas's'ee giraan metekkeessa gutii shittoo kikibtte.<verse eid="MAT 26:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8"/>Usukko oɂagaalssatareen hikka kakkodiyaaren goorata amaraateen haa ameen, «Hikki dubba darɂaano muunya?» <verse eid="MAT 26:8"/><verse number="9" style="v" sid="MAT 26:9"/>«Hitti shittoo kamooggan maragadeeyi daddalamigudde hiyyeessan sisamin dootisatte» ameen.<verse eid="MAT 26:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10"/>Yesuusana iso kaɂameeraan addeesere, «Hitta heleelttiti muun rakkisattan? Ese iin felo oɂidan felttetta ame. <verse eid="MAT 26:10"/><verse number="11" style="v" sid="MAT 26:11"/>Hiyyeessal maagoreenna isinne wota giraan, ani goɂameen arggetto isinne wota lakkogirnnaro, <verse eid="MAT 26:11"/><verse number="12" style="v" sid="MAT 26:12"/>Ese hitta shittoo maarkkeeyi gutii kikibano in k'amalkkeewun ekkaasanoyya. <verse eid="MAT 26:12"/><verse number="13" style="v" sid="MAT 26:13"/>Ani rumminaa amara hikki wongala mankkolallabaamaro alami dubbaa, maraamuri maaɂeeti banɂeenna ese iin kafelttetta ese shaadano lii segaaminara» ame.<verse eid="MAT 26:13"/></para>
  <para style="s1">Yihuuda Yesuusa roorisi sisin ekkaate</para>
  <para style="r">(<ref loc="MRK 14:10-11">Mar. 14:10-11</ref>; <ref loc="LUK 22:3-6">Luk'. 22:3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14"/>Hassu goorata tomonkko lamakko koo kalleera kaɂask'orotu Yihuuda kaɂamamara katuuk'aamol woyichchaal tos seetegure, <verse eid="MAT 26:14"/><verse number="15" style="v" sid="MAT 26:15"/>«Ani Yesuusa isinuun roorisi gosise isin addeen iin me sisinnattaan?» ame, isona bir sonddom usuun tooteen siseen. <verse eid="MAT 26:15"/><verse number="16" style="v" sid="MAT 26:16"/>Hassu gooratakko haggaɂabere Yihuuda Yesuusa roorisi kakkosisiro kaɂekkaaro goorata dootaa gire.<verse eid="MAT 26:16"/></para>
  <para style="s1">Yesuusa kafaasikkaa kita ofarameeraanne wota aamano</para>
  <para style="r">(<ref loc="MRK 14:12-21">Mar. 14:12-21</ref>; <ref loc="LUK 22:7-14">Luk'. 22:7-14</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Yan. 13:21-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17"/>Kababoo baalan tahoraarjjee arri Yesuusakko oɂagaalssatareen usu tos emetengureen «Ati kafaasikkaa kita kahemeene goggoɂaanttoon eetii no goggoɂekkaansson dootaatta?» ameen.<verse eid="MAT 26:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18"/>Usuna, «Katamaa tos seeyenguddeen isinne kaɂesele ibaaddoti koonne, ‹Kaɂagaalssisara gooratakki gabbalamera inkko oɂagaalssataranne wota kafaasikkaa baala minkkaayi kabajaayinnara amara ama ame.› » <verse eid="MAT 26:18"/><verse number="19" style="v" sid="MAT 26:19"/>Yesuusakko oɂagaalssataranna usu goggoɂajajeerokki malee kafaasikkaa baalakkokki kita ekkaasen.<verse eid="MAT 26:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20"/>Ul hemeen kakkolaare goorata Yesuusa tomonkko lama ofarameeraanne wota babo aamin hamas's'ee. <verse eid="MAT 26:20"/><verse number="21" style="v" sid="MAT 26:21"/>Yesuusa aamo gutii giraan, «Ani rumminaa amara isin orrokko koo in roorisi sisinnara» ame.<verse eid="MAT 26:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22"/>Isona aaloo yaadengureen toottoolli «Goottaa! Ani leewuna?» ameen.<verse eid="MAT 26:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23"/>Yesuusana abbaabere, «In roorisi kasisinara iinne wota yaalɂaayi gene kadagissateroya. <verse eid="MAT 26:23"/><verse number="24" style="v" sid="MAT 26:24"/>Ere kaɂibaaddo usu maraan goggos'aafameroyi goyinara, ayesuun goɂameen ere kaɂibaaddo roorise kasisaroon hassu ibaaddotin aanne! Usu ibaaddoti haɂalannooni hesi girewa kaɂidanye» ame.<verse eid="MAT 26:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25"/>Roorisi kasisinara Yihuudana, «Kaɂagaalssisatto! Ani leewuna?» ame, Yesuusana, «Ati kaɂamatta» ame.<verse eid="MAT 26:25"/></para>
  <para style="s1">K'ulluukki babo kawaakki woga</para>
  <para style="r">(<ref loc="MRK 14:22-26">Mar. 14:22-26</ref>; <ref loc="LUK 22:14-20">Luk'. 22:14-20</ref>; <ref loc="1CO 11:23-25">1 K'or. 11:23-25</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26"/>Iso aamaa giraanna Yesuusa babo keesegure sommaasate ibise aategure usukko oɂagaalssatarawun sisaa, «Ahɂaay atayeen aama, hinɂi sooɂootteyaan» ame.<verse eid="MAT 26:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27"/>Esekko t'ugga keese Waa galategure, usukko oɂagaalssatareewun sisaa haa ame, «Isin dubbana hitta t'uggakko t'ama, <verse eid="MAT 26:27"/><verse number="28" style="v" sid="MAT 26:28"/>Kamooggankokki c'ubboon shaaga maraan kaɂubayinara ammato oɂusubi kaɂaddeesisara iigikki hikkaya. <verse eid="MAT 26:28"/><verse number="29" style="v" sid="MAT 26:29"/>Ani goɂameen haa amara Aabbokkeekki wononnatii isinne wota hikka kaɂusub kawoyinii t'amo takkot'aminaro arri taageeroo hitta t'uggakko horenbbaan kawoyinii t'amo lakkot'aminaro.»<verse eid="MAT 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30"/>Mazamuri zammareen abbaabateenguren zayitii kabeyaara gaa takkoɂalataro wodami tos been.<verse eid="MAT 26:30"/></para>
  <para style="s1">Yesuusa P'et'iroosakokki kakatano t'aye ayeese</para>
  <para style="r">(<ref loc="MRK 14:27-31">Mar. 14:27-31</ref>; <ref loc="LUK 22:31-34">Luk'. 22:31-34</ref>; <ref loc="JHN 13:36-38">Yan. 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31"/>Yesuusa ade, «Hitta hemeen isin dubba in kakayinnattaan, ‹Ani kafoofee basinnara kafoofamara idaandda darɂaaminnara amame k'ulluukki mas'aafaa s'aafamera.›<verse eid="MAT 26:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 26:32"/>«Ayesuun goɂameen ani goyikko kakkokkee goorata isinkko t'ayi Galiila tos seeyinnara.»<verse eid="MAT 26:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33"/>P'et'iroosana abbaabere, «Kakkalee dubba aalanttittaayi ku iisi goseetena ani goɂameen duuddo ku iisi lakkoseero» ame. <verse eid="MAT 26:33"/><verse number="34" style="v" sid="MAT 26:34"/>Yesuusana P'et'iroosane, «Ani rumminaa amara hittameen lukkale haɂoyinon giraan ati in seed gali kakayinnatta» ame. <verse eid="MAT 26:34"/><verse number="35" style="v" sid="MAT 26:35"/>P'et'iroosa goɂameen «Ani kuunne wota goyin kadootisaro golleenna suure ani ku lakkokakayinaro» ame. Kuunɂi usukko oɂagaalssatareen dubbana usumaleewwa ameen.<verse eid="MAT 26:35"/></para>
  <para style="s1">Yesuusa Geetesemanii ebaatano</para>
  <para style="r">(<ref loc="MRK 14:32-42">Mar. 14:32-42</ref>; <ref loc="LUK 22:39-46">Luk'. 22:39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36"/>Esekko abbaabatere Yesuusa usukko oɂagaalssatareenne wota Geetesemanii taɂamamatto banɂe too seete, isone «Ani aarraa seeyigure taa ebaaroyi isin hittanii gira» ame. <verse eid="MAT 26:36"/><verse number="37" style="v" sid="MAT 26:37"/>Seetaa giraan P'et'iroosana yiis kazabddoosa lama wota aate seete, gaddanna c'annak'aamano haggaɂabe. <verse eid="MAT 26:37"/><verse number="38" style="v" sid="MAT 26:38"/>Esekkona «Ani taaggooroo aaloo c'annak'aamera, inne wota nabbaada hittanii gira» ame.<verse eid="MAT 26:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39"/>Abaraanttii ship'p'imegure hore hore bebbeedii ul oyere «Aabbokkee! Hitti tarrakkoo t'ugga inkko habuyito, ayesuun goɂameen feɂittee malee halleennoni giraan feɂittaa malee halleewo» ame ebaate.<verse eid="MAT 26:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40"/>Esekko abbaabategure usukko oɂagaalssataran tos goɂemeero ohuddureeraan deegure P'et'iroosane, «Duuddo iinne wota saatii toonna nabbaadi girana waatteen?» <verse eid="MAT 26:40"/><verse number="41" style="v" sid="MAT 26:41"/>«C'aafiti orroddi goggotaboonkko nabbaada ebaayen, ayyaana ekkaate gira, soo goɂameen hararaan» ame.<verse eid="MAT 26:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42"/>Ade kallami seetegure «Aabbokkee! Hitti tarrakkoo t'ugga ani hat't'amoon giraan tarooron golleete feɂittaakki malee halleeto» ame ebaate.<verse eid="MAT 26:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43"/>Kallami abbaabayi kakkoɂemeero goorata hudduro mankkogeetette maraan huddureen ogiraan dee. <verse eid="MAT 26:43"/><verse number="44" style="v" sid="MAT 26:44"/>Giddanna iso iisegure ade kaseedi seetegure hore kaɂebaatere ebi ade ebaate.<verse eid="MAT 26:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45"/>Esekkona usukko oɂagaalssatareen tos abbaabate emetere, «Giddanna haraffintteen huddurtteettaan? Hittima saatii gabbalanttetta, ere kaɂibaaddo c'ubbaaleyikkotti geneyi roori sisaminara. <verse eid="MAT 26:45"/><verse number="46" style="v" sid="MAT 26:46"/>Kiyaa seenno, roorisi kasisinara emeetaa gira!» ame.<verse eid="MAT 26:46"/></para>
  <para style="s1">Abamano kayesuusa</para>
  <para style="r">(<ref loc="MRK 14:43-50">Mar. 14:43-50</ref>; <ref loc="LUK 22:47-53">Luk'. 22:47-53</ref>; <ref loc="JHN 18:3-12">Yan. 18:3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47"/>Yesuusa ayeesaa giraan tomonkko lamakko koo kalleera Yihuuda katuuk'aamol woyichchaalnna taɂulee jaarsoleekko ofarameeraan shiifana duullaa kaɂabera ibaaddo kamoogganna wota gire. <verse eid="MAT 26:47"/><verse number="48" style="v" sid="MAT 26:48"/>Yesuusa roorise kasisera Yihuudana, «Ani kaɂangatara usuya aba» ame malaata sise mankkogire maraan, <verse eid="MAT 26:48"/><verse number="49" style="v" sid="MAT 26:49"/>Goorsewa Yesuusa tos seetegure, «Kaɂagaalssisatto! Nogodda iiddegitto» ame usu angate.<verse eid="MAT 26:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50"/>Yesuusana, «Ani kageelataro! Takkoonɂemettetto haajaa gussa» ame, hassu goorata ibaaddo gabbalamegure Yesuusa abe shiye.<verse eid="MAT 26:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 26:51"/>Yesuusanne wota kagirekko koo gene keesegure shiifayi tuuk'aamolkokki woyichchatiin kahandaarekotti nebe goose.<verse eid="MAT 26:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52"/>Yesuusana, «Shiifakkaa kofoo orro tabisi,» «Shiifa kamiɂatara shiifaayi gowaara, <verse eid="MAT 26:52"/><verse number="53" style="v" sid="MAT 26:53"/>Godootise ani Aabbokkee goɂebaaye kuma kamooggani katootamiro erggichchaal iin kafaroon aani laara? <verse eid="MAT 26:53"/><verse number="54" style="v" sid="MAT 26:54"/>Hikki haa gollee ade k'ulluukki mas'aafaa linnara amame kas'aafamera misii gudatara?» ame.<verse eid="MAT 26:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55"/>Hassu goorata Yesuusa gosane, «Shittaa abin kaɂemeetaro ibaaddo aani shiifaalnna duullaal abtteendden in abin emeetteen? Arggetto k'ulluukki min kaɂebii hamas's'ee ani isin goɂagaalssisare lakkoɂabttetteen. <verse eid="MAT 26:55"/><verse number="56" style="v" sid="MAT 26:56"/>Ayesuun goɂameen hikki dubba kakkonlleera k'ulluukki kahegeroolkokki mas'aafayi kas'aafamera goggogudaroonya» hassu goorata usukko oɂagaalssatareen dubba usu iiseen bak'ateen.<verse eid="MAT 26:56"/></para>
  <para style="s1">Yesuusa Ayihuudikkotti shonggooyi horee aallano</para>
  <para style="r">(<ref loc="MRK 14:53-65">Mar. 14:53-65</ref>; <ref loc="LUK 22:54-55">Luk'. 22:54-55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">Yan. 18:13-14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57"/>Hassu goorata Yesuusa kaɂabera ibaaddo seera kamuse oɂagaalssisaranna jaarssa kaɂulee kukkume takkogire tuuk'aamolkokki woyichchati K'eyaafa tos usu geesen. <verse eid="MAT 26:57"/><verse number="58" style="v" sid="MAT 26:58"/>Ayesuun goɂameen P'et'iroosa fakkimegure katuuk'aamol woyichchaatikokki awud taageeroo usu debee sesseetaa gire, orroddee tabegure ayees talinnaro din oɂooraneenne wota hamas's'ee.<verse eid="MAT 26:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59"/>Hassu goorata tuuk'aamolkokki woyichchatina kaɂayihuudi shonggoo dubba Yesuusa lagadisisin kat'araa ato dootaa gireen, <verse eid="MAT 26:59"/><verse number="60" style="v" sid="MAT 26:60"/>Kamooggan kat'araa atojool goɂemeetena ato kalleero lakkohelateeran, danbbenne goɂameen ibaaddo lama gabbalamere, <verse eid="MAT 26:60"/><verse number="61" style="v" sid="MAT 26:61"/>«Hikki ibaaddoti k'ulluukki ‹Min kaɂebi basigure arri seed orroo abbaab madaarin daanddaara› amera» amaa ayeeseen.<verse eid="MAT 26:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62"/>Hassu goorata tuuk'aamolkokki woyichchati kee aalleegure, «Hikki ibaaddo kaɂatoteero dubbaan koonna abbaab lakkoɂabbaabattoya?» ame. <verse eid="MAT 26:62"/><verse number="63" style="v" sid="MAT 26:63"/>Yesuusana goɂameen c'alɂi ame. Tuuk'aamolkokki woyichchati Yesuusane, «Ani ku Arddokki mege kawaayi abera, ati Kiristoosa ere kawaa golleete noon segii?» ame.<verse eid="MAT 26:63"/></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64"/>Yesuusana, «Atiwa issii anttetta, ayesuun goɂameen isin dubbana segiiro hittakko horenbbaan ere kaɂibaaddo hunna kawaakkotti merggee hamas'iire kadaruure dumanchaayi orroo emeetaa giraan dinnattaan» ame.<verse eid="MAT 26:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65"/>Hassu goorata tuuk'aamolkokki woyichchati sarssikkeessa fiilegure, «Hikki Waa habaarera; hikkakko kakkalee misikki ato dootisara? Usu Waa habaaraa ayeesano isinwa maaltteettan ame. <verse eid="MAT 26:65"/><verse number="66" style="v" sid="MAT 26:66"/>Me aani isinuun laara?» ame.</para>
  <para style="p" vid="MAT 26:66">«Isona goyin dootisara» ameen abbaabeen.<verse eid="MAT 26:66"/></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67"/>Hassu goorata bebbeedtteessaa hanc'c'ufe tufaa balabaanjjoo basaa, <verse eid="MAT 26:67"/><verse number="68" style="v" sid="MAT 26:68"/>«Kiristoosa! Ayyoyya ku kabase? Alla hegero ayeesi» ameen.<verse eid="MAT 26:68"/></para>
  <para style="s1">P'et'iroosa Yesuusa kakate</para>
  <para style="r">(<ref loc="MRK 14:66-72">Mar. 14:66-72</ref>; <ref loc="LUK 22:56-62">Luk'. 22:56-62</ref>; <ref loc="JHN 18:15-18">Yan. 18:15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69"/>Esekko abbaabatere P'et'iroosa katuuk'aamol woyichchaatikokki awudii orroo hamas's'ee giraan diyyiti too usu tos gabbalanttegudde «Ati kagaliila Yesuusane wota gittewa» antte.<verse eid="MAT 26:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70"/>Usu goɂameen, «Ati maamme amatto ani laakkaso amaa dubbaayi horee kakate.»<verse eid="MAT 26:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71"/>Awudkko kakkobeyaaran karrane bin seetaa giraan takkalee diyyiti P'et'iroosa deetegudde esee kagire ibaaddowun «Hikki ibaaddoti kanaazireti Yesuusane wota gire» antte.<verse eid="MAT 26:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72"/>P'et'iroosaan kaɂammatoo haafuraayi «Hikka ibaaddoti ani laakkaso» amaa kallami kakate.<verse eid="MAT 26:72"/></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73"/>Abaraan gac'c'imegure esee aallee kagire ibaaddo P'et'iroosa tos gabbalameengureen, «Ayeeskkawa addeesisara, ogiraan atina isokko kootta» ameen.<verse eid="MAT 26:73"/></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74"/>Usuna ammataanna k'angaa «Ani usu ibaaddoti lakkokaso» ame. Hassu goorata lukkalena oye.<verse eid="MAT 26:74"/></para>
  <para style="p">
    <verse number="75" style="v" sid="MAT 26:75"/>Goorsewa, P'et'iroosa «Lukkale haɂoyinon giraan seed gali ati in kakayiinnatta» ame. Yesuusa kaɂayeesera haafura usuun k'alli ame. P'et'iroosana sarddee beegure yururu ame oote.<verse eid="MAT 26:75"/></para>
  <chapter eid="MAT 26"/>
  <chapter number="27" style="c" sid="MAT 27"/>
  <para style="s1">Yesuusa P'ilaat'oosa tos geesano</para>
  <para style="r">(<ref loc="MRK 15:1">Mar. 15:1</ref>; <ref loc="LUK 23:1-2">Luk'. 23:1-2</ref>; <ref loc="JHN 18:28-32">Yan. 18:28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1"/>Bari babbaris katuuk'aamol woyichchaalnna jaarssa kaɂulee dubba Yesuusa tayeli lagadiraan makkareen. <verse eid="MAT 27:1"/><verse number="2" style="v" sid="MAT 27:2"/>Yesuusa shiyeen geesenguren karoomi mooti P'ilaat'oosaan rooriseen siseen.<verse eid="MAT 27:2"/></para>
  <para style="s1">Yihuuda isiɂootteessa suwaate</para>
  <para style="r">(<ref loc="ACT 1:18-19">Ofa. Fe. 1:18-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3"/>Roorise kasisera Yihuudana Yesuusa goyin firddaamano kakkodiyaare goorata gaabbee. Bir sonddom katuuk'aamol woyichchaalunna taɂulee jaarsoleewun abbaabe sisegure, <verse eid="MAT 27:3"/><verse number="4" style="v" sid="MAT 27:4"/>«Ani k'ulluukki ibaaddoti goyiin roorise mankkosisero maraan baasera» ame.</para>
  <para style="p" vid="MAT 27:4">Isona «Hayya noo me katabisara, hassu yaadakkaayya» ameen.<verse eid="MAT 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5"/>Haannuun Yihuuda bir k'ulluukki min kaɂebii orroo shafe iise beegure isi sullaate goye.<verse eid="MAT 27:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6"/>Katuuk'aamol woyichchaalnna ese bir aateenguren, «Hitti bir dookki kaɂiigeekkotti mankkoleetetto maraan min kawaawun lugudin seerakkaani feɂi lakkosisaro» ameen. <verse eid="MAT 27:6"/><verse number="7" style="v" sid="MAT 27:7"/>Makkarenguren martti takkok'amallaan tak'amal banɂe goggolleeton usu maragadee errekko huu kamet't'arokkotti banɂe imineen. <verse eid="MAT 27:7"/><verse number="8" style="v" sid="MAT 27:8"/>Haannuun hasse banɂe hittaari taageetoyi, «Ul kaɂiigee» amamatte uumamatta.<note caller="-" style="x"><char style="xo" closed="false">27:8 </char><char style="xt" closed="false"><ref loc="ACT 1:18-19">Ofa. Fe. 1:18-19</ref>.</char></note> <verse eid="MAT 27:8"/><verse number="9" style="v" sid="MAT 27:9"/>Hikka garaayi kahegeroo Ermaasayi, Yihuudaan muraa goggolleeto,</para>
  <para style="p" vid="MAT 27:9">Gosa kaɂisiraɂeel taherregero «Bir sonddom atateen. <verse eid="MAT 27:9"/><verse number="10" style="v" sid="MAT 27:10"/>Goottanna iin goggoɂajajeerokki malee errekko huu kamet't'arokkotti banɂeen mureen» amame kasegaamera gudate.<note caller="-" style="x"><char style="xo" closed="false">27:10 </char><char style="xt" closed="false"><ref loc="ZEC 11:12-13">Zak. 11:12-13</ref>.</char></note><verse eid="MAT 27:10"/></para>
  <para style="s1">Yesuusa P'ilaat'oosa horee</para>
  <para style="r">(<ref loc="MRK 15:2-5">Mar. 15:2-5</ref>; <ref loc="LUK 23:3-5">Luk'. 23:3-5</ref>; <ref loc="JHN 18:33-38">Yan. 18:33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11"/>Hassu goorata Yesuusa karoomi mooti P'ilaat'oosa horee aallee, karoomi mootinna «Ati kaɂayihuudi Wonotta?» ame hoosate, Yesuusana «Ati goggoɂamattooya» ame abbaabe.<verse eid="MAT 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12"/>Katuuk'aamol woyichchaalnna jaarsolee gomootenna usu ade koonna abbaab lakkosise. <verse eid="MAT 27:12"/><verse number="13" style="v" sid="MAT 27:13"/>Hassu goorata P'ilaat'oosa «Miyyaa ato keenen atoteeran lakkomaalattoya?» ame. <verse eid="MAT 27:13"/><verse number="14" style="v" sid="MAT 27:14"/>Yesuusa goɂameen karoomi mootinna aaloo taa mamiron kamootamero mooton haafura koonna suure lakkoɂabbaabe.<verse eid="MAT 27:14"/></para>
  <para style="s1">Yesuusa kagoyi firdda firddaamano</para>
  <para style="r">(<ref loc="MRK 15:6-15">Mar. 15:6-15</ref>; <ref loc="LUK 23:13-25">Luk'. 23:13-25</ref>; <ref loc="JHN 18:39">Yan. 18:39</ref>; <ref loc="JHN 19:16">19:16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15"/>Karoomi mootinna gosa kafaasikkaa tabaala arrii goggofuramiroon kadootataro odo koo shaanokko kakkofuraro woga abanaaye. <verse eid="MAT 27:15"/><verse number="16" style="v" sid="MAT 27:16"/>Hassu goorata baasi felanooyi kaɂaddeesamere Barbaane kaɂamamara kashaamere koo gire. <verse eid="MAT 27:16"/><verse number="17" style="v" sid="MAT 27:17"/>Gosa kukku kakkoɂamare goorata P'ilaat'oosa, «Barbaanekkona, Kiristoosa kaɂamamaro Yesuusakko, ayyo ani goggofurroon dootaattan?» ame. <verse eid="MAT 27:17"/><verse number="18" style="v" sid="MAT 27:18"/>P'ilaat'oosana hikka kakkoonɂamera iso k'anaateen rooriseen kasiseraan mankkoɂaddeesare maraanya.<verse eid="MAT 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19"/>P'ilaat'oosa kafirdda arjjaata gutii hamas's'ee giraan ooritteessa, «Aalantti teessaa hemeenkka hisillooyi rakkoo tameellan ani mankkodeero maraan hassu k'ulluukki ibaaddoti gutii koonna ayees goggoyelonkko kaɂamaro handdaa usuun fartte.»<verse eid="MAT 27:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20"/>Ayesuun goɂameen katuuk'aamol woyichchaalnna taɂulee jaarsoleel Barbaane goggofuramiroo Yesuusa adi goggogooron gosa P'ilaat'oosa goggohoosaroon kekkeesaa gireen.<verse eid="MAT 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21"/>Karoomi mootinna, «Iso lamakko ayyo ani goggofurroo dootaattan?» ame kallami hoosate.</para>
  <para style="p" vid="MAT 27:21">Isona, «Barbaane» ameen abbaabeen.<verse eid="MAT 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22"/>P'ilaat'oosana, «Hayya Kiristoosa kaɂamamaro Yesuusa misi yella?» ame.</para>
  <para style="p" vid="MAT 27:22">Iso dubbana «Hasuwaamo» ameen.<verse eid="MAT 27:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23"/>P'ilaat'oosana, «Muun? Me tameellan felera?» ame hoosate.</para>
  <para style="p" vid="MAT 27:23">Isona adeen aaloo okkaa, «Hasuwaamo» ameen.<verse eid="MAT 27:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24"/>P'ilaat'oosana okko adamano kuwaarre koonna ayees kagarggaaroon laano deegure «Ani hikka ibaaddotikkokki iigikko balchchaya,» isin isiɂoottisin oorayeen, «Goorttanu odonnati kakkisiniya» amegure beke keensisegure gosa horee genennoɂootteessa aale.<verse eid="MAT 27:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25"/>Gosa dubbana, «Iigikkeessa noyenna yiiskkaani gutii halleewo» ame abbaabe.<verse eid="MAT 27:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26"/>Hassu goorata Barbaane fure gafarere, Yesuusa ade boc'iisere goggosuwaamiro roorise sise.<verse eid="MAT 27:26"/></para>
  <para style="s1">Karroomi wotaadaral Yesuusa gutii k'ac'c'ifatano</para>
  <para style="r">(<ref loc="MRK 15:16-20">Mar. 15:16-20</ref>; <ref loc="JHN 19:2-3">Yan. 19:2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27"/>Esekko karoomi mootiikokki wotaadara Yesuusa kamootiti awud tos geesen, wotaadaral dubba Yesuusa maraamuri goggoɂaalliroon kukkuyise. <verse eid="MAT 27:27"/><verse number="28" style="v" sid="MAT 27:28"/>Sarssikkeessana k'aarengureen heelatti kaabbaa sarssiseen, <verse eid="MAT 27:28"/><verse number="29" style="v" sid="MAT 27:29"/>Eɂeen mammaren kallachcha feleengureen metekkeessayi gutii kayeen, taleemma dama gene tamerggeeyi absiseen horee gilbbisengureen «Ayihuudikokki Wono! Nogodda kuun halleeto» amaa k'ac'c'ifataren. <verse eid="MAT 27:29"/><verse number="30" style="v" sid="MAT 27:30"/>Hanc'c'ufe usuu gutii tufaa talleemma dama genekko aatenguren talleemma damaayi metekkeessa abbaabeen abbaabeen baseen, <verse eid="MAT 27:30"/><verse number="31" style="v" sid="MAT 27:31"/>K'ac'c'ifateen abbaabateenguren heelatti kaabbaa k'aarengureen kahoree sarssikkeessa aateen sarssiseen, suyiinna abeen seeteen.<verse eid="MAT 27:31"/></para>
  <para style="s1">Suwaamano kayesuusa</para>
  <para style="r">(<ref loc="MRK 15:21-32">Mar. 15:21-32</ref>; <ref loc="LUK 23:26-43">Luk'. 23:26-43</ref>; <ref loc="JHN 19:17-27">Yan. 19:17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32"/>Abeen seetaa giraan Simoona kaɂamamare kak'ereena ulkokki ibaaddoti heleengureen, masik'alii goggosidiroo hunnoomen. <verse eid="MAT 27:32"/><verse number="33" style="v" sid="MAT 27:33"/>Fureenna, [Buk'k'e tamete] talleetetto Golggottaa taɂamantetto banɂe kakkogiyaaren goorata, <verse eid="MAT 27:33"/><verse number="34" style="v" sid="MAT 27:34"/>Kaɂokokootaro kookone wota kaledamero kawoyinii t'amo usu goggot'amiro siseen, usu goɂameen hiɂii abe deere t'amin lakkodoote.<note caller="-" style="x"><char style="xo" closed="false">27:34 </char><char style="xt" closed="false"><ref loc="PSA 69:21">Mez. 69:21</ref>.</char></note> <verse eid="MAT 27:34"/><verse number="35" style="v" sid="MAT 27:35"/>Yesuusa suyeen abbaabateenguren it'aa beesaten sarssilkkeessana hedeedameen,<note caller="-" style="x"><char style="xo" closed="false">27:35 </char><char style="xt" closed="false"><ref loc="PSA 22:18">Mez. 22:18</ref>.</char></note> <verse eid="MAT 27:35"/><verse number="36" style="v" sid="MAT 27:36"/>Eseenna hamas's'een ooraa gireen. <verse eid="MAT 27:36"/><verse number="37" style="v" sid="MAT 27:37"/>«HIKKI KAɁAYIHUUDI WONO YESUUSAYA» taɂamatto tamooto s'uufii metekkeessakko guntte kayeen. <verse eid="MAT 27:37"/><verse number="38" style="v" sid="MAT 27:38"/>Shittoolee lama koo mina tamerggenne, koo mina tabetene usune wota suyeen. <verse eid="MAT 27:38"/><verse number="39" style="v" sid="MAT 27:39"/>Raanne karoorara ibaaddo aaloo usu habaaraa k'ac'c'ifataa,<note caller="-" style="x"><char style="xo" closed="false">27:39 </char><char style="xt" closed="false"><ref loc="PSA 22:7">Mez. 22:7</ref>; <ref loc="PSA 109:25">109:25</ref>.</char></note> <verse eid="MAT 27:39"/><verse number="40" style="v" sid="MAT 27:40"/>«K'ulluukki min kaɂebi basigudde arri seed orroo kamadaarinnatta, alla isiɂoottaa haasa? Ere kawaa golleete alla masik'alii guukko dagi» amaa gireen.<note caller="-" style="x"><char style="xo" closed="false">27:40 </char><char style="xt" closed="false"><ref loc="MAT 26:6">Mat. 26:6</ref>; <ref loc="JHN 2:19">Yan. 2:19</ref>.</char></note><verse eid="MAT 27:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41"/>Usumaleenna tuuk'aamolkokki woyichchaal, seera oɂagaalssisaranna jaarsoleenne wota leenguren k'ac'c'ifataa haa amaa gireen, <verse eid="MAT 27:41"/><verse number="42" style="v" sid="MAT 27:42"/>«Kakkalee fayyisara» isiɂoottessa ade fayyiisayin lakkodaanddaaro, usu kaɂisiraɂeel wono gollee gidda mask'aliikko hadage, noonna ammaninanna. <verse eid="MAT 27:42"/><verse number="43" style="v" sid="MAT 27:43"/>Usu Waayi ammanatara ani ere kawaayya amaa mankkogire maraan, alla Waa usu kageelaataro gollee gidda hahaaso.<note caller="-" style="x"><char style="xo" closed="false">27:43 </char><char style="xt" closed="false"><ref loc="PSA 22:8">Mez. 22:8</ref>.</char></note> <verse eid="MAT 27:43"/><verse number="44" style="v" sid="MAT 27:44"/>Usune wota osuwaameereen shittooleenna usumaleewwa habaar kamooggan habaararen.<verse eid="MAT 27:44"/></para>
  <para style="s1">Goyi kayesuusa</para>
  <para style="r">(<ref loc="MRK 15:33-41">Mar. 15:33-41</ref>; <ref loc="LUK 23:44-49">Luk'. 23:44-49</ref>; <ref loc="JHN 19:28-30">Yan. 19:28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45"/>Saatii lekko haggaɂabere taa saatii saagaal geeroo ul dubbaa gutii mugud lee. <verse eid="MAT 27:45"/><verse number="46" style="v" sid="MAT 27:46"/>Saatii saagalli Yesuusa yaayetteessa t'ok'k'isere «Elohe Elohe laammasebek'etaani?» amaa okkee. Fureenna «Hedokkee! Hedokkee! In muun iisse?» amanoyya.<note caller="-" style="x"><char style="xo" closed="false">27:46 </char><char style="xt" closed="false"><ref loc="PSA 22:1">Mez. 22:1</ref>.</char></note><verse eid="MAT 27:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47"/>Esee aalleen ogiraankko kookkoo maalengureen «Eelaasa uumara» ameen.<verse eid="MAT 27:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 27:48"/>Goorsewa iso orrokko koo tiyaa emeetegure isfoonji aategure kaɂokokootaro t'amo kawoyinii orroddeese nakkaregure isfoonji leemma birt'ee kayegure Yesuusa goggot'amiro sise.<note caller="-" style="x"><char style="xo" closed="false">27:48 </char><char style="xt" closed="false"><ref loc="PSA 69:21">Mez. 69:21</ref>.</char></note> <verse eid="MAT 27:48"/><verse number="49" style="v" sid="MAT 27:49"/>Okkaleenna adeen «Isaaga alla Eelaasa emeeyigure usu gohaasinnaro dinnanna» ameen.<verse eid="MAT 27:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50"/>Yesuusa ade kallami yaaye t'ok'k'ise okkeegure neefo beete.<verse eid="MAT 27:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51"/>Hassu goorata k'ulluukki min kawaakkotti goggolo elekko taa hegel geeroo banɂe lama bee fiilame, ulnna shalagaame, eɂemoolnna bebelɂee,<note caller="-" style="x"><char style="xo" closed="false">27:51 </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">Biy. 26:31-33</ref>.</char></note> <verse eid="MAT 27:51"/><verse number="52" style="v" sid="MAT 27:52"/>Hiyeelnna baname, goye kagire kamooggan k'ullooleenna keen, <verse eid="MAT 27:52"/><verse number="53" style="v" sid="MAT 27:53"/>Hiyeelkko beeguren goyikko kiyaano kayesuusakko abbaabatere k'ulluutti katamaa Iyyerusaalemi tos tabeenguren kamooggan ibaaddon muteen.<verse eid="MAT 27:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54"/>Kabooloo woyichchaalnna usune wota Yesuusa ooraa kagire wotaadaral ul shalagaamanona kalleero ayees dubba kakkodiyaaren goorata aaloo abssateenguren, «Hikki ogiraan ere kawaayye» ameen.<verse eid="MAT 27:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55"/>Galiilakko oɂemeeteraanna Yesuusaan kadootisaro ayees handdayin debee kasessetare heleel kamooggan ayees tallinnaro diyaa fakkimeen usu gobobii gireen. <verse eid="MAT 27:55"/><verse number="56" style="v" sid="MAT 27:56"/>Iso orrokko kamegidella ulkotti Mayiraamene tayayik'oobanna tayoosefa Aaye Mayiraamenee gireen. Usumaleenna oori tazabddoosanneyeen.<note caller="-" style="x"><char style="xo" closed="false">27:56 </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">Luk'. 8:2-3</ref>.</char></note><verse eid="MAT 27:56"/></para>
  <para style="s1">K'amalamano kayesuusa</para>
  <para style="r">(<ref loc="MRK 15:42-47">Mar. 15:42-47</ref>; <ref loc="LUK 23:50-56">Luk'. 23:50-56</ref>; <ref loc="JHN 19:38-42">Yan. 19:38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57"/>Ul hemeen kakkolaare goorata Yoosefa kaɂamamara dureessati Armaatiyasi taɂamanaa katamaakko emeete, usuna ade Yesuusakko kaɂagaalsatareye, <verse eid="MAT 27:57"/><verse number="58" style="v" sid="MAT 27:58"/>Usuna P'ilaat'oosa tos seetegure rees kayesuusa ebaate, P'ilaat'oosana usuun goggosisirawun ajajee. <verse eid="MAT 27:58"/><verse number="59" style="v" sid="MAT 27:59"/>Yoosefana rees aategure gashe taɂusubii mare iidise. <verse eid="MAT 27:59"/><verse number="60" style="v" sid="MAT 27:60"/>Eɂemokko k'orame kaɂoshamere gumbbi orroo k'amale, esekkona eɂemo kanjiinkki otottoolisegure kak'amal gumbbikkotti hiɂi duudise seete. <verse eid="MAT 27:60"/><verse number="61" style="v" sid="MAT 27:61"/>Hassu goorata kamegidella ulkotti Mayiraamena takkalee Mayiraame k'amali horee hamas's'een gireen.<verse eid="MAT 27:61"/></para>
  <para style="s1">K'amal kayesuusakokki ooramano</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62"/>Tallami arri tayaasuma mankkolleete maraan katuuk'aamol woyichchaalnna Farasaawilne raattoo P'ilaat'oosa tos seetengureen haa ameen, <verse eid="MAT 27:62"/><verse number="63" style="v" sid="MAT 27:63"/>«Goottaa! Hassu kasossoyisara t'aye neefone giraan ‹Taseedi arri goyikko kiinnara› kaɂamara noon k'alli amera.<note caller="-" style="x"><char style="xo" closed="false">27:63 </char><char style="xt" closed="false"><ref loc="MAT 16:21">Mat. 16:21</ref>; <ref loc="MAT 17:23">17:23</ref>; <ref loc="MAT 20:19">20:19</ref>; <ref loc="MRK 8:31">Mar. 8:31</ref>; <ref loc="MRK 9:31">9:31</ref>; <ref loc="MRK 10:33-34">10:33-34</ref>; <ref loc="LUK 9:22">Luk'. 9:22</ref>; <ref loc="LUK 8:31">8:31</ref>; <ref loc="LUK 18:31-33">18:31-33</ref>.</char></note> <verse eid="MAT 27:63"/><verse number="64" style="v" sid="MAT 27:64"/>Haannuun Yesuusakko oɂagaalssatareen rees heti aatiguren gosane, goyikko keera ami goggoɂayeesonko k'amalkkeessa taa arri seed geeroo goggoɂooramiro ajajii, goorttun kahaaree sossowaano kahoreekko karoore leera.»<verse eid="MAT 27:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65"/>P'ilaat'oosana, «Kaɂoorro isin abttaanwa seeyenguddeen kakkassaan raadii oorissisayeen» ame. <verse eid="MAT 27:65"/><verse number="66" style="v" sid="MAT 27:66"/>Isona seetengureen k'amal gutii maatama kayeengureen kaɂoorro aalliseen.<verse eid="MAT 27:66"/></para>
  <chapter eid="MAT 27"/>
  <chapter number="28" style="c" sid="MAT 28"/>
  <para style="s1">Goyikko kiyaano kayesuusa</para>
  <para style="r">(<ref loc="MAT 28:1-10">Mat. 28:1-10</ref>; <ref loc="MRK 16:1-10">Mar. 16:1-10</ref>; <ref loc="LUK 24:1-12">Luk'. 24:1-12</ref>; <ref loc="JHN 20:1-10">Yan. 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1"/>Ayihuudin tafoolssi arrikko abbaabatere tawoggaa arri bari bullane kamegidella ulkotti Mayiraamena takkalee Mayiraame k'amal din seeteen.<note caller="+" style="f"><char style="fr" closed="false">28:1 </char><char style="ft" closed="false">Ayihuudin tafoolssi arri kaɂamara: tak'eera arri amanoya. Mas'aafa orroo «Senbbeti» amara. Fureenna tafoolssi arri amanoya </char></note><verse eid="MAT 28:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2"/>Derɂa kaɂatii ulkokki aaɂaano lee, kagootta erggichchatina daruurkko dagegure k'amal tos seete eɂemo otottoolisegure gutii hamas's'ee. <verse eid="MAT 28:2"/><verse number="3" style="v" sid="MAT 28:3"/>Taɂerggichcha bebbeedtteessana hank'k'a aani tahank'aatto, sarssikkeessana beleetti aani gumaarakkiye. <verse eid="MAT 28:3"/><verse number="4" style="v" sid="MAT 28:4"/>Oɂooraneenna erggichchati absatanakko kakkeeyi harɂeen kagoyero ibaaddo aani leen.<verse eid="MAT 28:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5"/>Erggichchatina heleeljane haa ame, «Isin arooɂabsatteen isin kasuwamere Yesuusa kadootattaan ani kasowa, <verse eid="MAT 28:5"/><verse number="6" style="v" sid="MAT 28:6"/>Haannuun hittanii lakkogiro, goggoɂayeeseroyi keera, koyeen usu takkok'amalamere banɂe diyaa. <verse eid="MAT 28:6"/><verse number="7" style="v" sid="MAT 28:7"/>Gidda saama seeyenguddeen usukko oɂagaalssatareewun Yesuusa goyikko keera, isinkko t'ayi Galiila tos seeyinnara goorttanun ani segeera.»<verse eid="MAT 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8"/>Heleeljana abssiinna geggelooyi ammagameengureen Yesuusakko oɂagaalssatarawun segin aaloo tiyaa tak'amal banɂekko iiseen seeteen. <verse eid="MAT 28:8"/><verse number="9" style="v" sid="MAT 28:9"/>Goorsewa Yesuusa iso helegure, «Nogoddaa gittaane» ame. Isona Yesuusa tos gabbalameengureen lukitteessa abateen sagadeen. <verse eid="MAT 28:9"/><verse number="10" style="v" sid="MAT 28:10"/>Yesuusana «Arooɂabsatteen seeyenguddeen Galiila tos goggoseerawun abbilaaltteewun segaa, esee in dinnattaan» ame.<verse eid="MAT 28:10"/></para>
  <para style="s1">Oɂooranankokki atotaano</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11"/>Heleeljana raadii seeto gutii giraan oɂooraneenkko kookkoo katamaa tos beengureen kalleero dubba katuuk'aamol woyichchaalun segeen. <verse eid="MAT 28:11"/><verse number="12" style="v" sid="MAT 28:12"/>Katuuk'aamol woyichchaalnna jaarsoleenne wota kukkuɂameen makkarenguren wotaadaran maragade kamooggan isoo sisaa haa ameen; <verse eid="MAT 28:12"/><verse number="13" style="v" sid="MAT 28:13"/>«Noo huddurnne giraan ‹Usukko oɂagaalssatareen hemeen emetengureen nookko heteen ama ameen.› <verse eid="MAT 28:13"/><verse number="14" style="v" sid="MAT 28:14"/>Hitti odu mootii dollee gomaalssanttena suure noo gachoo addeesinssa, koonna kameellan ayees isin goggogeennonkko yelnnowa» ameen. <verse eid="MAT 28:14"/><verse number="15" style="v" sid="MAT 28:15"/>Wotaadaralna maragade atateengureen goggoɂajajaameran malee yeleen, hitti jirtti hittaari gin Ayihuudi dollee gambbantte darɂaantte.<verse eid="MAT 28:15"/></para>
  <para style="s1">Yesuusa usukko oɂagalssataraawun mutano</para>
  <para style="r">(<ref loc="MRK 16:14-18">Mar. 16:14-18</ref>; <ref loc="LUK 24:36-49">Luk'. 24:36-49</ref>; <ref loc="JHN 20:19-23">Yan. 20:19-23</ref>; <ref loc="ACT 1:6-8">Ofa. Fe. 1:6-8</ref>; <ref loc="1CO 15:3-8">1 K'or. 15:3-8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16"/>Esekkona tomonkko koo Yesuusakko oɂagaalssatareen Galiilaayi taggitto Yesuusa isoon tatusero wodami tos seeteen.<note caller="-" style="x"><char style="xo" closed="false">28:16 </char><char style="xt" closed="false"><ref loc="MAT 26:32">Mat. 26:32</ref>; <ref loc="MRK 14:28">Mar. 14:28</ref>.</char></note> <verse eid="MAT 28:16"/><verse number="17" style="v" sid="MAT 28:17"/>Usu kakkodiyaaren goorata sagadeen, kookkoo adeen hedateen.<verse eid="MAT 28:17"/></para>
  <para style="s1">Kanjjiinkki ajaja</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 28:18"/>Yesuusana usukko oɂagaalssatareen mankkogireen tos emeetegure, «Odonnati dubba daruurnna ulii iin sisamera, <verse eid="MAT 28:18"/><verse number="19" style="v" sid="MAT 28:19"/>Haannuun seeyeenddeen gosa dubba Odooyi, Ereyinna Ayyaana K'ulluukkokki megeeyi t'ammak'aa inkko oɂagaalssataran yela.<note caller="-" style="x"><char style="xo" closed="false">28:19 </char><char style="xt" closed="false"><ref loc="ACT 1:8">Ofa. Fe. 1:8</ref>.</char></note> <verse eid="MAT 28:19"/><verse number="20" style="v" sid="MAT 28:20"/>Ani isinuun kasisero ajaja dubba goggoɂooranawun agaalssisa, aninna alamikkotti gachcho taageeroo arggetto isinne wota gira» ame.<verse eid="MAT 28:20"/></para>
  <chapter eid="MAT 28"/>
</usx>
