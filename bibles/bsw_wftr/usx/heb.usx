<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HEB" style="id">- Bayso New Testament</book>
  <para style="h">Ibraawwii</para>
  <para style="toc1">Kaɂibirawwii Ibaaddo Tos Kafaramero Handdaa</para>
  <para style="toc2">Ibraawwii</para>
  <para style="toc3">Ibr.</para>
  <para style="mt1">Kaɂibirawwii Ibaaddo Tos Kafaramero Handdaa</para>
  <para style="imt">Tabano</para>
  <para style="ip">Hikki handdaa kakkons'aafamera ibaaddo iso godiide ammanokkisoo iisin kagabbalamero amaniiluwunye; s'aafiiti Ibirawijjoluun kaɂaddeesisera Yesuusa Kiristoosa karrummiinna kagachchoo mutano kawaa laano tusinya. Hikki amaniil ammanokkisooyi goggoɂarɂarawun ataayisara; hikka kakkofele goorata rummi seed addeesise tusara,</para>
  <para style="ili1">1. Taɂatatero rakkookotti garane karrummii odoon kaɂajajaamaro kalleera Yesuusa jiruu jiroommakki ere kawaayya; Ere kawaa laanoyi ammato ohorkkokki kahegeroolkko, Musekkona erggichchalkko aaloo karooreya.</para>
  <para style="ili1">2. Yesuusa ammato ohorkkookokki tuuk'aamolkko aaloo karoore jiruu jiroommakki tuuk'aamo laano Waa issii ayeesera.</para>
  <para style="ili1">3. Gara kayesuusane amaniil c'ubbokko, abssikkona goyikko fayyinnara; Yesuusa tuuk'aamolkokki woyichcha laanoyi kaɂibirawwii ibaaddokokki ammano seerana kagiddi jaarsso hoos aani mutaa kagire fayyinna rummi goggolleeroon yelera.</para>
  <para style="ip">S'aafiti taɂisiraɂeeli jirtti kaɂaddeesame ibaaddokokki ammano masuussa yelatereyya, (Foolssi. 11) onabbabaraan ammanokkisooyi goggoɂataarawun addeesisara; usumaleenna (Foolssi. 12) ammana Iilɂoɂoottisoo Yesuusaa gutii kaanoyi ammanokkisooyi goggoɂataarawunna maamisitti rakkoonna abboosa goggeenna goggoɂobssiraawun gorssaara, gudisaanna kagorssa haafura sisaa gudisara.</para>
  <para style="iot">Raattoo Hikki Mas'aafa Kaɂabera</para>
  <para style="io1">Tabano, Waa Kiristoosaayi mutano <char style="ior"><ref loc="HEB 1:1-3">1:1-3</ref> </char></para>
  <para style="io1">Kiristoosa erggichchakko karooran laano <char style="ior"><ref loc="HEB 1:4-2:18">1:4—2:18</ref> </char></para>
  <para style="io1">Kiristoosa Musekkona Iyyaasukko karoore laano <char style="ior"><ref loc="HEB 3:1-4:13">3:1—4:13</ref> </char></para>
  <para style="io1">Tuuk'aamo laano kakiristoosa dubbaankko karooraro laano <char style="ior"><ref loc="HEB 4:14-7:28">4:14—7:28</ref> </char></para>
  <para style="io1">Kakiristoosa haafura ammatokko karooraro laano <char style="ior"><ref loc="HEB 8:1-9:22">8:1—9:22</ref> </char></para>
  <para style="io1">Kakiristoosa jaarssamanokokki jiinaan <char style="ior"><ref loc="HEB 9:23-10:39">9:23—10:39</ref> </char></para>
  <para style="io1">Ammanokokki jiinaan <char style="ior"><ref loc="HEB 11:1-12:29">11:1—12:29</ref> </char></para>
  <para style="io1">Waa geggelaayisano <char style="ior"><ref loc="HEB 13:1-19">13:1-19</ref> </char></para>
  <para style="io1">Kac'ufano ebi <char style="ior"><ref loc="HEB 13:20-21">13:20-21</ref> </char></para>
  <para style="io1">Gudisano <char style="ior"><ref loc="HEB 13:22-25">13:22-25</ref> </char></para>
  <chapter number="1" style="c" sid="HEB 1"/>
  <para style="s1">Waa Erekkeessakokki garane ayeesano</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1"/>Horkkooskko kayere Waa raa kamoogganinna goorata kamoogganii gara kahegeroolnne odojoolkkaanuun ayeesere; <verse eid="HEB 1:1"/><verse number="2" style="v" sid="HEB 1:2"/>gidda goɂameen kagachchoo geesii kameen dubba goggoɂeelloon kayelero erekkeessakokki garane noon ayeesera; alami dubba kakkomet't'eera usuuya. <verse eid="HEB 1:2"/><verse number="3" style="v" sid="HEB 1:3"/>Usu kabaja tawaa hank'k'ayise katusaroya; yadaliitteessana Waanne wota taɂekkaattotta, haafurakokki hunnaayi alami dubba isikkise abera, ibaaddo c'ubbokko k'ullooyise abbaabatere daruurii kaɂatii Waakotti merggee hamas's'ee.<verse eid="HEB 1:3"/></para>
  <para style="s1">Ere kawaa erggichchalkko karooraro laano</para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4"/>Usuun kabeera mege kaɂerggichcha megekko karooraro mankkollee maraan, ere kawaa erggichchakko aaloo karooraroya.<verse eid="HEB 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HEB 1:5"/>Waa duuddo erggichchaal orroo,</para>
  <para style="q1" vid="HEB 1:5">«Ati erekkeetta, ani ku hittaari umulera»</para>
  <para style="q2" vid="HEB 1:5">goorttun</para>
  <para style="q1" vid="HEB 1:5">«Ani odo leerowa, usuna erekkee linnara»</para>
  <para style="q2" vid="HEB 1:5">kakkoonɂamere maayyona laagire.<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="PSA 2:7">Mez. 2:7</ref>; <ref loc="2SA 7:14">2 Sam. 7:14</ref>; <ref loc="1CH 17:13">1 Od. 17:13</ref>.</char></note><verse eid="HEB 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 1:6"/>Waa barkki erekkeessa alami tos kakkofarare goorata,</para>
  <para style="q1" vid="HEB 1:6">«Erggichcha kawaa dubba usuun hasagade» amera.<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="DEU 32:43">Ada. 32:43</ref>.</char></note><verse eid="HEB 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 1:7"/>Erggichchakokki gara,</para>
  <para style="q1" vid="HEB 1:7">«Erggichchaalnna ambbal aani,</para>
  <para style="q2" vid="HEB 1:7">ohandaaranna lac'a kaɂeleenee aani yelinnara» amara.<note caller="-" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="PSA 104:4">Mez. 104:4</ref>.</char></note><verse eid="HEB 1:7"/></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 1:8"/>Erekkeessakokki gara ade;</para>
  <para style="q1" vid="HEB 1:8">«Hedo! Korffinjekka jiruu jiroommakko taa jiruujiroomma geeroon girnnara;</para>
  <para style="q2" vid="HEB 1:8">wononatikkaanna rummii bariisatta;<verse eid="HEB 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9"/>Ati k'ullumma geelatta; meellaneenna diidatta;</para>
  <para style="q2" vid="HEB 1:9">Hikkakkotti aalanttii Waa Hedokka ku assaabate;</para>
  <para style="q2" vid="HEB 1:9">Saatilaalttaakko roorise geggeloo tasisatto zayitii kuun shigide» amara.<note caller="-" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="PSA 45:6-7">Mez. 45:6-7</ref>.</char></note><verse eid="HEB 1:9"/></para>
  <para style="m">
    <verse number="10" style="v" sid="HEB 1:10"/>Usumaleenna,</para>
  <para style="q2" vid="HEB 1:10">Goottakkee! «Ati horaarjje ul met't'iite;</para>
  <para style="q1" vid="HEB 1:10">Daruurjjolnna genettaayi met't'iite;<verse eid="HEB 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11"/>Iso dubba bayinnaraan;</para>
  <para style="q1" vid="HEB 1:11">Ati adde girnnatta;</para>
  <para style="q2" vid="HEB 1:11">Iso dubba sarssi aani doɂayinnaran.<verse eid="HEB 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12"/>Gashe aaninna ati duubinnatta;</para>
  <para style="q2" vid="HEB 1:12">Isona sarssi kaddoɂan sarssi kaɂusubii goggoɂiggilssamaro malee iggilissaminaran.</para>
  <para style="q1" vid="HEB 1:12">Ati arggetto atitta,</para>
  <para style="q2" vid="HEB 1:12">Geeskkaawun gachcho laagitto» amara.<note caller="-" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="PSA 102:25-27">Mez. 102:25-27</ref>.</char></note><verse eid="HEB 1:12"/></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13"/>Waa erggichchaal orroo;</para>
  <para style="q2" vid="HEB 1:13">«Diinakkaa odonnatikkaa hegelii taa yellooyi</para>
  <para style="q1" vid="HEB 1:13">Merggetteeyi hamas's'ii» kakkoonɂamera maayyona laagiro.<note caller="-" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Mez. 110:1</ref>.</char></note><verse eid="HEB 1:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="HEB 1:14"/>Erggichchaal dubba Waa ammani kafayyinnaro ibaaddon handdayin ofaramaraan Waawun ohandaaran ayyaanalyyaan.<verse eid="HEB 1:14"/></para>
  <chapter eid="HEB 1"/>
  <chapter number="2" style="c" sid="HEB 2"/>
  <para style="s1">Kaɂatii fayyinna</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1"/>Haannuun kamaalnnenno ayeeskko fallaaddayinne goggoɂiinnoonkko kamaalnnenno ayesuun aaloo isiɂooratano dootisara. <verse eid="HEB 2:1"/><verse number="2" style="v" sid="HEB 2:2"/>Erggichchalkokki garane kasegaamera haafura rummi leera; hikka haafurakko kashirmarana hikka haafuraan kaɂajajaamon tadootisatto murroo atatara. <verse eid="HEB 2:2"/><verse number="3" style="v" sid="HEB 2:3"/>Hayya noo hikka kaɂatii fayyinnaan donnaa ollaanno golleene, misii hesiin daanddaanna? Hikka fayyinna noon kasisera Goottaa issiiyya; usukkona kamaalera ibaaddo hikkawa addeesisera. <verse eid="HEB 2:3"/><verse number="4" style="v" sid="HEB 2:4"/>Waa isoon ade malaataal, kasaadisiro ayees, kamooggan baasa felanoyiinna feɂitteessakki malee oddannabameraan Ayyaana K'ulluukki ilaboolkokki garane atotaanokkisoo ataayisera.<verse eid="HEB 2:4"/></para>
  <para style="s1">Yesuusa kafayyinna sooressa laano</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5"/>Waa horenbbaan kaɂemeeyinnaron, hikka gidda noo kakkoɂayeesanno alami erggichcha odonnati goggobarisiroo lakkoyelero. <verse eid="HEB 2:5"/><verse number="6" style="v" sid="HEB 2:6"/>Usumaleenna k'ulluukki mas'aafajjool banɂe tooyi haa amara;</para>
  <para style="q1" vid="HEB 2:6">«Ati goggok'offitoon ibaaddo meya?</para>
  <para style="q2" vid="HEB 2:6">Ati usuun goggomararttoo ere kaɂibaaddo meya?<verse eid="HEB 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7"/>Abaraan erggichchalkko yeraasse,</para>
  <para style="q2" vid="HEB 2:7">Kakkabajjaanna kasommaa kallachcha usu gutii kayite;</para>
  <para style="q2" vid="HEB 2:7">Genetta ofelttetto felo gutii shuumiite;<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">Fureen toottooyi «genettaakonɂi felooyi shuumite» kaɂamaro lakkoɂadaraan. </char></note><verse eid="HEB 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 2:8"/>Dubbana odonnatikkeessa hegelii kayite.»<note caller="-" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="PSA 8:4-6">Mez. 8:4-6</ref>.</char></note></para>
  <para style="m" vid="HEB 2:8">Kameen dubba odonatikkeessakko hegelle kakkokkayite goorata, odonatikkeessakko hegelii ankkayinooni ati kahaassetta ayees koonna laagiro. Ayesuun goɂameen gidda goggogirooyi kameen dubba odonnatikkeessa hegelii kagiro ganaa lakkodeenenne. <verse eid="HEB 2:8"/><verse number="9" style="v" sid="HEB 2:9"/>Gidda ade erggichchalkko goorata kic'c'arun hussintte tagitte, tagoyi rakkoo atatanokotti aalanttii kakkabajjaanna kasommaa kallachcha kakkaatero Yesuusa dinnanna; usuna sino tawaayi no maraan goyera. <verse eid="HEB 2:9"/><verse number="10" style="v" sid="HEB 2:10"/>Kameen dubba usuuyina usuun kamet't'aamera Waa yiis kamooggan kabaja tos keeniin fayyinnakisookki sooressa kalleero Yesuusa rakkoo orromarise roorsanoyi duuddokki goggolleeroon hikki ayees kadootisaro mankkollee maraan Waa felera.<verse eid="HEB 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 2:11"/>Ibaaddo Waawuun kak'ullooyisarana garakkeessane Yesuusaa ok'ullowaaraan odo kookki yiisyaan; hikkakkotti aalanttii usu iso, «Abbilaalttee» ami uumn lakkomullaaro. <verse eid="HEB 2:11"/><verse number="12" style="v" sid="HEB 2:12"/>Haannuun k'ulluukki mas'aafajjool</para>
  <para style="q1" vid="HEB 2:12">«Megekkaa abbilaaltteewun segiinnara,</para>
  <para style="q2" vid="HEB 2:12">gosa kawaa orroo hiɂitteeyi galatinnara» amara,<note caller="-" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="PSA 22:22">Mez. 22:22</ref>.</char></note><verse eid="HEB 2:12"/></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13"/>Usumaleenna, «Abdditteenna usuu gutii kayinnara» amara,</para>
  <para style="m" vid="HEB 2:13">Adena, «Hikkima aninna Waa iin kasisera yiinssa hittanii ginna» amara.<verse eid="HEB 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14"/>Haanssun yiiskkeessa soonna iigi kaɂabo ibaaddo mankkoleeraan maraan Yesuusana iso aani ibaaddo lee, hikka kakkoonyelera goyikokki garane goyi gutii odonnati kaɂabo durrisa baasinya; <verse eid="HEB 2:14"/><verse number="15" style="v" sid="HEB 2:15"/>Usumaleenna goyi abssatanokkotti aalanttii ulii kakkogiraan gees dubbaayi diyyummaa iminameen ogireenun wodoo liinya. <verse eid="HEB 2:15"/><verse number="16" style="v" sid="HEB 2:16"/>Ogiraan Yesuusa kakkoonɂemetera erggichcha gargaarin anlleennon giraan taɂabraame sannii gargaarinya; <verse eid="HEB 2:16"/><verse number="17" style="v" sid="HEB 2:17"/>Haannuun kameen dubbaayi abbilaal aani laano mankkodootisaro maraan abbilaal aani lee; hikka kakkoonyelera c'ubbo kaɂibaaddo haheso amin amere Waawun handdayin kaɂabddamena kanenɂeeyisataro tuuk'aamolkokki woyichcha lee. <verse eid="HEB 2:17"/><verse number="18" style="v" sid="HEB 2:18"/>Usu issii c'aafamere rakkoo mankkoɂatatero maraan oc'c'aafamaraan gargaarin daanddaara.<verse eid="HEB 2:18"/></para>
  <chapter eid="HEB 2"/>
  <chapter number="3" style="c" sid="HEB 3"/>
  <para style="s1">Yesuusa Musekko karooraro laano</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1"/>Haannuun isinna addeen uumit tawaayi oɂuumanttettan k'ulluunɂi amaniil! Ammanokkaanun kafaramerona tuuk'aamolkokki woyichcha Yesuusa shaada. <verse eid="HEB 3:1"/><verse number="2" style="v" sid="HEB 3:2"/>Muse min kawaa dubbaan kaɂabddame goggolleerekki malee Yesuusana usu kashuumero Waawun kaɂabddameye. <verse eid="HEB 3:2"/><verse number="3" style="v" sid="HEB 3:3"/>Min kamadaarara minkko taroortte kabaja goggoɂabo malee Yesuusana Musekko taroortte taɂatii kabaja mankkodootisaro maraan kabajaame.<note caller="-" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="NUM 12:7">To. 12:7</ref>.</char></note> <verse eid="HEB 3:3"/><verse number="4" style="v" sid="HEB 3:4"/>Ogiraan min dubba metemeteeyi kamadaararo ibaaddo aba; kameen dubba kafelera ade Waayya. <verse eid="HEB 3:4"/><verse number="5" style="v" sid="HEB 3:5"/>Horenbbaawun amamiin kadootisaro ayees dubbaan atotaa Muse min kawaa dubbaayi kahandaaro aani kaɂabddameye. <verse eid="HEB 3:5"/><verse number="6" style="v" sid="HEB 3:6"/>Kiristoosa ade min kawaayi kaɂabddame kakkolleera ere aani leegureyye. Minkkeessana nonna; minkkeessa kakkonliinanna kakkoɂabddatanno ayeesinna takkodhaadatanno abddi ataayisayi goɂabanneya.<verse eid="HEB 3:6"/></para>
  <para style="s1">Abddatanawaattikokki gara kasisamero seerisano</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7"/>Haannuun Ayyaana K'ulluukki goggoɂamaroo,</para>
  <para style="q1" vid="HEB 3:7">«Hittaari Yaayetteessa gomaaltteen,<note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="PSA 95:7-11">Mez. 95:7-11</ref>.</char></note><verse eid="HEB 3:7"/></para>
  <para style="q2">
    <verse number="8-9" style="v" sid="HEB 3:8-9"/>K'alullattokki ulii odolaalkkisin in goggoc'aaferankki maleenna meellanee iin gutii goggokeerankki malee</para>
  <para style="q2" vid="HEB 3:8-9">isinna wodanattisin taɂajajaamon arooyelatteen;</para>
  <para style="q1" vid="HEB 3:8-9">Esee iso in c'aafeen; inne wota tamaaggaten;</para>
  <para style="q2" vid="HEB 3:8-9">Gees afarttamuun ani kafelerona deen» amara Waa.<verse eid="HEB 3:8-9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10"/>Haannuun ani hasse alattaanii amaraayegure,</para>
  <para style="q2" vid="HEB 3:10">«Wodanattiso arggetto shirmatta;</para>
  <para style="q2" vid="HEB 3:10">Raakkeenna lakkoɂaddeeseeran ame.»<verse eid="HEB 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 3:11"/>Adena</para>
  <para style="q1" vid="HEB 3:11">« ‹Ani tasisinaro tafoolssi banɂettee tos lakkotabnaraan!› ame</para>
  <para style="q2" vid="HEB 3:11">Amaraantteeyi ani ammatera.»<verse eid="HEB 3:11"/></para>
  <para style="m">
    <verse number="12" style="v" sid="HEB 3:12"/>Abbilaalttee! Isin orrokko maayyona arddokki Waakko tafakkisso tameellanna taɂammanoon wodana isinuun goggoginnonkko isiɂoorayeen. <verse eid="HEB 3:12"/><verse number="13" style="v" sid="HEB 3:13"/>Ayesuun goɂameen isinkko c'ubbooyi sobamire wodanatteessa taɂajajaamon goggoyelannonkko, «Hittaari» amame kaɂuumamara goorata giraan arggetto isiɂisiɂataayisayen. <verse eid="HEB 3:13"/><verse number="14" style="v" sid="HEB 3:14"/>Horaarjje kaɂabannenno ammanokkaani tagachchoo arri taa geennoon ataayisayi goɂabanne kiristoosane wota oɂeelinnanno linnanna.<verse eid="HEB 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 3:15"/>Hikkina, «Hittaari yaayetteessa kakkomaalttaan goorata</para>
  <para style="q2" vid="HEB 3:15">abjjolaalkkisin meellane kakkokekkeeseren goorata goggoyeleraan malee wodanattisin taɂajajaamon arooyelatteen» amame goggos'aafamerooya.<verse eid="HEB 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16"/>Golleenna hanɂu yaayetteessa maaleen abbaabateren omeelileren ayyosyyeen? Iso la Muse horehaye k'ajeelisaa ul kagibs's'ikko obeereenyenna? <verse eid="HEB 3:16"/><verse number="17" style="v" sid="HEB 3:17"/>Gees afarttam dubba Waa amaraayisaa ogireen ayyosyyeen? Lahanɂu c'ubbo ofeleraanna iso goyereen reeskkiso k'alullattokki ul iyye okkoonheseroyenna? <verse eid="HEB 3:17"/><verse number="18" style="v" sid="HEB 3:18"/>Adena hanɂu ajajaamano odiideeren kuwaarre, «Isin tafoolssii banɂettee tos lakkotabnattaan» ame usu kakkoonɂammatera ayyosyyeen? <verse eid="HEB 3:18"/><verse number="19" style="v" sid="HEB 3:19"/>Goorttanun iso tabin kakkowaateraan ammananawaattikkotti aalanttii laano addeesanna.<verse eid="HEB 3:19"/></para>
  <chapter eid="HEB 3"/>
  <chapter number="4" style="c" sid="HEB 4"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1"/>Haanssun Waa tasisinaro tafoolssi banɂe tos tabin no taɂatannenno abddi ganaa tat'aabbatetto mankkolleete maraan isinkko maayyona hitta tafoolssi banɂe tos takkotabro iddilii anhelannon goggohesoonkko no dubbana isiɂooranna. <verse eid="HEB 4:1"/><verse number="2" style="v" sid="HEB 4:2"/>Wongala isoon goggolallabaameroo noonna lallabaamera; ayesuun goɂameen isoon kalallabaamero haafura ammanooyi atatana mankkowaateen maraan isoon laɂo lakkosise. <verse eid="HEB 4:2"/><verse number="3" style="v" sid="HEB 4:3"/>Feloɂootteessa alami takkomet'amerokko haggaɂabere ogudateeraan golleenna, «Ani tasisaro tafoolssi banɂe tos lakkotabiraan ame amaraayere ammatera» goggoɂameroo giddanna noo kaɂammananna eserraa Waa noon tasisero tafoolssi banɂe tos tabnanna;<note caller="-" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="PSA 95:11">Mez. 95:11</ref>.</char></note> <verse eid="HEB 4:3"/><verse number="4" style="v" sid="HEB 4:4"/>Tatodobi arrikotti gara mas'aafa k'ulluukkii banɂe tooyi, «Waa feloɂoottessakko tatodobi arrii foolssate» amame s'aafamera.<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="GEN 2:2">Met'. 2:2</ref>.</char></note> <verse eid="HEB 4:4"/><verse number="5" style="v" sid="HEB 4:5"/>Usumaleenna hitta banɂee ade</para>
  <para style="q1" vid="HEB 4:5">«Ani isoon tasisinaro tafoolssi banɂe tos suure iso lakkotabnaraan» amara.<note caller="-" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="PSA 95:11">Mez. 95:11</ref>.</char></note><verse eid="HEB 4:5"/></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 4:6"/>Hikka wongala horaarjje omaaleeraan ajajaamana waattikko kakkeeyi Waa tasisinaro tafoolssi banɂe tos lakkotabeeran; golleenna eserraa goggotabraawun feɂi kakkoonsisanttetta ibaaddo kookkoo girowa. <verse eid="HEB 4:6"/><verse number="7" style="v" sid="HEB 4:7"/>Hikkina t'aye goggoɂamameroo</para>
  <para style="q1" vid="HEB 4:7">«Hittaari yaayetteessa gomaaltteen,</para>
  <para style="q2" vid="HEB 4:7">Wodanattisinii taɂajajaamon arooyelatteen.»</para>
  <para style="m" vid="HEB 4:7">Amaa Waa gees kamooggankko abbaabatere gara kadaawutene kaɂayeesero haafuraa arri «Hittaari» amami goggoɂuumanttoo addeesisera.<note caller="-" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="PSA 95:7-8">Mez. 95:7-8</ref>.</char></note><verse eid="HEB 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8"/>Iyyaasu gosaan foolssi isoon kasise lii girewa Waa adi, «Hittaari» amaa arri takkaleekokki gara lakkoɂayeesare.<note caller="-" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="DEU 31:7">Ada. 31:7</ref>; <ref loc="JOS 22:4">Iya. 22:4</ref>.</char></note> <verse eid="HEB 4:8"/><verse number="9" style="v" sid="HEB 4:9"/>Goorttanun gosa kawaawun taɂayihuudi tafolssi arri aanittitti foolssi ganaa gitta. <verse eid="HEB 4:9"/><verse number="10" style="v" sid="HEB 4:10"/>Waa felokko goggofoolssateroo usumalee Waa tasisinaro foolssi tos katabara felokko foolssatara.<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="GEN 2:2">Met'. 2:2</ref>.</char></note> <verse eid="HEB 4:10"/><verse number="11" style="v" sid="HEB 4:11"/>Haannuun hassu ibaaddo ajajaamana waattikko kakkeeyi goggoɂiyyeraankki malee maayyona debee seeyire goggoɂiinnoonkko tawaa tafoolssi banɂe tos tabin ataanna.<verse eid="HEB 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12"/>Haafura kawaa arddokkina kafelaroyya; mina lamane enenaan kaɂabo maamisikki shiifakkona roore kaɂenenaateyya, neefona ayyaana, mikitaalnna lefaal kalekalee taa beesiro kagoggoosaroya; wodanaa orroo tagitto k'ofana halchcha k'ok'k'ore kafirddaroya. <verse eid="HEB 4:12"/><verse number="13" style="v" sid="HEB 4:13"/>Hore tawaakko tagolattetta met't'a toonna laagitto; iltteessaa horee kameen dubba diidaa bee hawɂayi lee kamutaroya; noonna abbaab sisin kakkodaanddanna usu horeeya.<verse eid="HEB 4:13"/></para>
  <para style="s1">Yesuusa kaɂatii tuuk'aamolkokki woyichchaya</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14"/>Goortta daruurjjol orromare elddee kabeero kaɂatii katuuk'aamol woyichcha mankkoɂabnno maraan hiɂittaanii kaɂatotiinnenno ammanokkaani ataayisayi abanna; katuuk'aamol woyichchana Ere kawaa Yesuusaya. <verse eid="HEB 4:14"/><verse number="15" style="v" sid="HEB 4:15"/>Noo kaɂabnna katuuk'aamol woyichcha haranokkaani nenɂeyisayin kadanddeenoon lakkoyo; Yesuusa c'ubbo lakkofelero kuwaarre kameen dubbaayi no aani c'aafamera. <verse eid="HEB 4:15"/><verse number="16" style="v" sid="HEB 4:16"/>Goortta noo shaaga helayiinna gargaarssa noon kakkodootise goorata sino goggohelannon sino kakkohelanno kawaa korffinjje horee abissi kallayi gabbalamiinna.<verse eid="HEB 4:16"/></para>
  <chapter eid="HEB 4"/>
  <chapter number="5" style="c" sid="HEB 5"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1"/>Katuuk'aamol woyichcha dubba ibaaddo orrokko assaabamere Waanne wota taɂeselsatto haajaayi banɂe taɂibaaddoyi meebaanna jaarsso Waawun sisin shuumamaraan. <verse eid="HEB 5:1"/><verse number="2" style="v" sid="HEB 5:2"/>Hassu tuuk'aamo woyichchati metekkeessawun harano kaɂabo mankkolleero maraan koonna okasoonna oshiriɂamaraan nenɂeyisayi iso din daanddaara. <verse eid="HEB 5:2"/><verse number="3" style="v" sid="HEB 5:3"/>Usu metekkeessawun haranokokki aalanttii c'ubbokko haheso amamano kahelamissisaro jaarsso sisin kaddootisara gosa kaalaalun anlleennon giraan isiɂoottessanee adereya.<note caller="-" style="x"><char style="xo" closed="false">5:3 </char><char style="xt" closed="false"><ref loc="LEV 9:7">Woy. 9:7</ref>.</char></note> <verse eid="HEB 5:3"/><verse number="4" style="v" sid="HEB 5:4"/>Aarooni aani Waayi kaɂuumamero ibaaddo gollee kuwaarre maayyona hitta kabaja issii metekkeessayi lakkohelataro.<note caller="-" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="EXO 28:1">Biy. 28:1</ref>.</char></note><verse eid="HEB 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 5:5"/>Usumaleenna Kiristoosa katuuk'aamol woyichcha laanokotti kabaja issii metekkeessayi lakkoɂatatero; ayesuun goɂameen katuuk'aamol woyichcha laanokotti kabaja kakkohelatera,</para>
  <para style="q1" vid="HEB 5:5">«Ati erekkeetta;</para>
  <para style="q2" vid="HEB 5:5">Ani ku hittaari umulera» kaɂamero Waakkoya.<note caller="-" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="PSA 2:7">Mez. 2:7</ref>.</char></note><verse eid="HEB 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 5:6"/>K'ulluukki mas'aafaa banɂe takkaleetii Waa;</para>
  <para style="q1" vid="HEB 5:6">«Kamelkes'edek'i tuuk'aamolkokki shuumata aani</para>
  <para style="q2" vid="HEB 5:6">Ati jiruu jiroomman woyichchatta» amara.<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="PSA 110:4">Mez. 110:4</ref>.</char></note><verse eid="HEB 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7"/>Yesuusa ibaaddo lee hikka ulii kakkogire goorata goyikko haasin kadaanddaaro Waa tos kaɂatii iyyaanoyinna tanjiin ilmmii ubaa ebi ebaate; isi yeraasatanoyinna kaɂajajaame mankkollee maraan Waa ebikkeessa maale.<note caller="-" style="x"><char style="xo" closed="false">5:7 </char><char style="xt" closed="false"><ref loc="MAT 26:36-46">Mat. 26:36-46</ref>; <ref loc="MRK 14:32-42">Mar. 14:32-42</ref>; <ref loc="LUK 22:39-46">Luk'. 22:39-46</ref>.</char></note> <verse eid="HEB 5:7"/><verse number="8" style="v" sid="HEB 5:8"/>Usu maamisii ere kawaa golleenna taɂatatero rakkooyi ajajaamano agaalssate. <verse eid="HEB 5:8"/><verse number="9" style="v" sid="HEB 5:9"/>Duuddokki lee kakkomutare goorata usuun kaɂajajaamaro dubbaan jiruu jiroommakokki fayyinnaan isoon aalantti lee. <verse eid="HEB 5:9"/><verse number="10" style="v" sid="HEB 5:10"/>Usuna Waa kamelkes'edek'i shumata aani tuuk'aamolkokki woyichcha yele shuume.<verse eid="HEB 5:10"/></para>
  <para style="s1">Ammanokkisoo goggoɂiisonkko kasisamero seerisano</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11"/>Hitta haajaakokki gara noo kaɂayeesinanna kamooggan ayees gira; ayesuun goɂameen bogi malabaa giraan wudettaamana mankkowaatte maraan isin agaalssisano t'ibara. <verse eid="HEB 5:11"/><verse number="12" style="v" sid="HEB 5:12"/>Gidda gin kakkogitteen goorataayi isin kaɂagaalssisaro lii giratteen; gidda goɂameen haafura kawaa kahoraarjjee agaalssis ibaaddo kakkalee isin kallami goggoɂagaalssisiroon dootisara; hitta aalanttii isinuun odootisaraan eenooyyan kuwaarre kaɂatii babo lakkoyo. <verse eid="HEB 5:12"/><verse number="13" style="v" sid="HEB 5:13"/>Eenoo olaal kat'amara dubba yiis mankkollee maraan k'ullummakokki gara ganaa lakkoɂagaalssatero.<note caller="-" style="x"><char style="xo" closed="false">5:13 </char><char style="xt" closed="false"><ref loc="1CO 3:2">1 K'or. 3:2</ref>.</char></note> <verse eid="HEB 5:13"/><verse number="14" style="v" sid="HEB 5:14"/>Kaɂatii babo kakkoondootisara ade kaɂidanna kameellanna kale beesi addeesin kaɂis's'aamaro kajiinjjiin ibaaddoyya.<verse eid="HEB 5:14"/></para>
  <chapter eid="HEB 5"/>
  <chapter number="6" style="c" sid="HEB 6"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1"/>Goortta Kiristoosa maraan kasisamero kahoraarjjee agaalssis abbaab abbaab keesano iisigunne agaalssis dubamano; goyi tos ogeesaraan felo, c'ubbokko gula galanokkokkina Waa ammananokokki gara abbaabi abbaabi agaalssisaa kahoraarjjee ukum lakkot'aabbinsso. <verse eid="HEB 6:1"/><verse number="2" style="v" sid="HEB 6:2"/>Usumaleenna t'ink'ata, gene gutii kaano, goyikko kiyaano, kajiruu jiroomma firddakokki agaalssis adi lakkot'aabbinsso. <verse eid="HEB 6:2"/><verse number="3" style="v" sid="HEB 6:3"/>Waa noon feɂi gosise horenbbaan agaalssisii dubamano tos jiinayinanna.<verse eid="HEB 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4"/>Ammanokkisoo kakkaatero ibaaddo c'ubbokko gula galano tos abbaabin lakkodaanddaamaro. Hikka ibaaddon hittakko horenne ifa isoon hank'k'aye gire, kadaruure ilabona k'ammassereen; Ayyaana K'ulluukkikko k'ooba oɂatateeren, <verse eid="HEB 6:4"/><verse number="5" style="v" sid="HEB 6:5"/>Kaɂidankki haafura kawaanna emeeyin kagiro jiruu jiroommakki k'alaada kawaakokki hunna ok'ammassereen, <verse eid="HEB 6:5"/><verse number="6" style="v" sid="HEB 6:6"/>Hikka dubbakko abbaabayi ammanokkisoo gokakateen iso metekkisoowun ere kawaa abbaabeen mankkosuwaaran maraanna diidaa beesen mankkoyeraasanan maraan iso c'ubbokko gula galisin lakkodaanddaamaro.<verse eid="HEB 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7"/>Arggetto usuu gutii kaɂubataro idaamo kat'amara akaakiltte kaɂabbaratero ibaaddotin laɂo tasisatta erre Waakko uuso helaatta; <verse eid="HEB 6:7"/><verse number="8" style="v" sid="HEB 6:8"/>Eɂeenna k'iinc'c'ona goɂalisse adde laɂo kallayitti laatta; enee k'angaaminnatta; esekko eleenii gubaminnatta.<note caller="-" style="x"><char style="xo" closed="false">6:8 </char><char style="xt" closed="false"><ref loc="GEN 3:17-18">Met'. 3:17-18</ref>.</char></note><verse eid="HEB 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9"/>Ani ogeelaataro oottee! Noo isinuun hikka goɂayyeenssena suure fayyinnakkisinun kalleero kaɂidankki ayees gutii giranokkisin no abddatanna. <verse eid="HEB 6:9"/><verse number="10" style="v" sid="HEB 6:10"/>Waa taɂidan kafirddaaroya; haannuun feloɂoottisin t'ayena leere giddana megekkeessa maraan amaniil gargaarin isin tattusseettan geelanjje lakkoɂillooro. <verse eid="HEB 6:10"/><verse number="11" style="v" sid="HEB 6:11"/>Isin dubba abddii kaɂoorattan ayees taa gene geegissattaanii ataankisin taagachcho geetanii goggotussawun no halchchaanna. <verse eid="HEB 6:11"/><verse number="12" style="v" sid="HEB 6:12"/>No kakkoonhalchchaannana ammanoyinna obssii ataayigunne Waa abddii kasisero ayees kaɂeelnaro ibaaddo aani goggolleetanun kuwaarre laafanɂi goggolleetanun lakkoyo.<verse eid="HEB 6:12"/></para>
  <para style="s1">Abddi tawaa taɂabddantte laano</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13"/>Waa Abraamen abddi kakkosisare goorata usu kakkoɂammatira usukko karoorara kakkalee maayyona mankkogginnon maraan haa amaa usu issii ammate. <verse eid="HEB 6:13"/><verse number="14" style="v" sid="HEB 6:14"/>«Ogiraan ani ku sommaasayinnara, sanniittaanna moggaasinnara ame Waa ayeese.»<note caller="-" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="GEN 22:16-17">Met'. 22:16-17</ref>.</char></note> <verse eid="HEB 6:14"/><verse number="15" style="v" sid="HEB 6:15"/>Abraame obssee oorategure Waa abddii usuun katabero ayees helate. <verse eid="HEB 6:15"/><verse number="16" style="v" sid="HEB 6:16"/>Ibaaddo ammato gotabiro metekkeessakko karoore megeeyi ammatara; ayeeskkisoonna ammatooyi ataayisaa isoo t'eɂee tagitto dogamaa dubba baasaran. <verse eid="HEB 6:16"/><verse number="17" style="v" sid="HEB 6:17"/>Hikkamalee murtti tawaa taɂiggilsamoon laano aaloo addeesisin dootegure abddii eelin abddi ammatooyi isoon ataayisera. <verse eid="HEB 6:17"/><verse number="18" style="v" sid="HEB 6:18"/>Hikkamaleenna Waa oɂiggilssamoonna kat'araa kalleenoon ayees lama, hikkina abddina ammato noon sisera; hikka ayees lamakokki garane noo horee taggitto abddi ataayisayi abayin goggodanddeennon kakkoɂiskkanno helayiin usu tos oɂemeennenna noo kaɂatii goggoɂinna helannenna; <verse eid="HEB 6:18"/><verse number="19" style="v" sid="HEB 6:19"/>Hitti abddi girikkaaniwun kaɂaaɂinoon kaɂabddame markkafa badii taɂaalliisatto marc'c'o aantittitta; Yesuusaa taɂabnna abddi goggolokko rooritte k'ulluukki min tos tabatta.<note caller="-" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="LEV 16:2">Woy. 16:2</ref>.</char></note> <verse eid="HEB 6:19"/><verse number="20" style="v" sid="HEB 6:20"/>Hikka k'ulluukki min tos Yesuusa kamelkes'edek'i tuuk'aamokokki shuumata aani jiruu jiroomman katuuk'aamol woyichcha lee no maraan t'aye tabe.<verse eid="HEB 6:20"/></para>
  <chapter eid="HEB 6"/>
  <chapter number="7" style="c" sid="HEB 7"/>
  <para style="s1">Tuuk'aamoti Melkes'edek'i</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1"/>Melkes'edek'i kasaalemi katamaakokki wonona dubbaankko t'ok'k'i kaɂame tuuk'aamo kawaaye; hikki Melkes'edek'ina, Abraame wonolaal awode abbaabataa giraan raadii eselere sommaasate. <verse eid="HEB 7:1"/><verse number="2" style="v" sid="HEB 7:2"/>Abraame kaɂabo dubbakko usuun hora sise; Melkes'edek'ikotti fureen tahoree, «Kak'ullummaa wono» kakkalee ade, «Tasaalem katamaakokki wono» haa amano «Kanogoddaa wono» amanoyya. <verse eid="HEB 7:2"/><verse number="3" style="v" sid="HEB 7:3"/>Melkes'edek'i kaɂaddeesame odona Aanna goorttun alattaankokki hidiid lakkoɂabo; geeskkeessawuun horaarjje, girikkeessawunna gachcho lakkoɂabo; hikki Melkes'edek'i ere kawaa aani masuussa ligure jiruu jiroomman tuuk'aamo lii girnnara.<verse eid="HEB 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4"/>Hikki ibaaddoti misikki kaɂatiiyo deyaa; aanii taɂisiraɂeelin odo kalleera Abraame boojee kaɂaaterokko hora beese usuun sise. <verse eid="HEB 7:4"/><verse number="5" style="v" sid="HEB 7:5"/>Aanɂi tuuk'aamolkonɂi feloo orroo okkameeraan tawoyyole sannii gosakona taɂabraame sanniikko hikkina abbilaalttisokko hora goggoɂaatirawun seeraayi ajajeera.<note caller="-" style="x"><char style="xo" closed="false">7:5 </char><char style="xt" closed="false"><ref loc="NUM 18:21">To. 18:21</ref>.</char></note> <verse eid="HEB 7:5"/><verse number="6" style="v" sid="HEB 7:6"/>Hassu Melkes'edek'i tawoyyole sannii laana gowaatena ade Abraamekko hora aate; kaɂabddii haafura kakkonsisamere Abraame sommaasate. <verse eid="HEB 7:6"/><verse number="7" style="v" sid="HEB 7:7"/>Kic'c'arkki kanjiinkkikko somma kaɂatayinaro laano hedatano laagiro. <verse eid="HEB 7:7"/><verse number="8" style="v" sid="HEB 7:8"/>Mina toonne hora oɂaataraan ogoyinnaraanyan; mina takkaleenne ade hora kaɂaatara arddokki lii girnnara amame kakkoonɂatotaamera Melkes'edek'iya. <verse eid="HEB 7:8"/><verse number="9-10" style="v" sid="HEB 7:9-10"/>Goorttanu Melkes'edek'i Abraamene wota kakkoɂeselare goorata woyyuuti Aabbokkeessa Abraamekko ganaa haɂalannoon mankkogire maraan hora aatin kadootisara woyyuuti metekkeessawun Abraamekokki garane hora murera amanoyya.<verse eid="HEB 7:9-10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11"/>Goorttanun gosaan seera kakkosisamera kawoyyu tuuk'aamo laanokki maleeya; hikka kawoyyul tuuk'aamo likkii laano kahelamaro leenna kaɂaarooni tuuk'aamo laanokokki shumata alleenon Melkes'edek'i tuuk'aamo laanokokki shumata aankkikki kaɂabo kakkalee tuuk'aamo emeetano kadootisoon lii girare. <verse eid="HEB 7:11"/><verse number="12" style="v" sid="HEB 7:12"/>Felo otuk'aamool goɂiggilssamiraan seerana wota iggilissamano dootisara. <verse eid="HEB 7:12"/><verse number="13" style="v" sid="HEB 7:13"/>Hikki dubba kakkoonsegaamera tuuk'aamoti aanii takkaleekkoyya. Hitta aaniikko maayyona huu kafala tos gabbalame kahandaayera laagiro. <verse eid="HEB 7:13"/><verse number="14" style="v" sid="HEB 7:14"/>Goottakkaani tayihuuda aaniikko laano kaɂaddeesameya; golleenna Muse tuuk'aamolkokki gara ayeesaa giraan tayihuuda aaniikkokki gara kaɂayeesera ayees koonna laagiro.<verse eid="HEB 7:14"/></para>
  <para style="s1">Kiristoosa Melkes'edek'i aani tuuk'aamo laano</para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15"/>Hikki ayees aaloo muti kakkoɂaddeesaminnara Melkes'edek'i aankkikki kakkalee tuuk'aamo kakkokkee gooratayya; <verse eid="HEB 7:15"/><verse number="16" style="v" sid="HEB 7:16"/>Kiristoosa tuuk'aamo laanokokki shumata kakkoɂatatera girikkeessa meessa kallayikki mankkollee maraanya kuwaarre sannii taɂibaaddokko kaɂemeetero wogaanna seeraayi lakkoyo. <verse eid="HEB 7:16"/><verse number="17" style="v" sid="HEB 7:17"/>«Ati kamelkes'edek'i tuuk'aamo laanokkokki shumata aani jiruu jiroomman tuuk'aamotta» amame k'ulluukki mas'aafaal atotaamera.<note caller="-" style="x"><char style="xo" closed="false">7:17 </char><char style="xt" closed="false"><ref loc="PSA 110:4">Mez. 110:4</ref>.</char></note> <verse eid="HEB 7:17"/><verse number="18" style="v" sid="HEB 7:18"/>Usumaleenna kat'awoo ajaja laafana laɂo kallayikki mankkollee maraan hesera; <verse eid="HEB 7:18"/><verse number="19" style="v" sid="HEB 7:19"/>Seera kamuseeyi koonna likkiikki liin lakkodaanddee; gidda goɂameen noo Waa tos takkogabbalaminna takkaleekko taroortte abddi noon sisanttetta.<verse eid="HEB 7:19"/></para>
  <para style="p">
    <verse number="20-21" style="v" sid="HEB 7:20-21"/>Hittakko horene tuuk'aamo olleeren ammato kallayi tuuk'aamo leeraan;</para>
  <para style="q1" vid="HEB 7:20-21">«Waa ade Yesuusane ati kamelkes'edek'i shumata</para>
  <para style="q2" vid="HEB 7:20-21">‹Ati jiruu jiroomman tuuk'aamotta,› ame ammate; lakkogaabbiro; amame usuun osegaameraan ammatone wota tuuk'aamo leera;»<note caller="-" style="x"><char style="xo" closed="false">7:20-21 </char><char style="xt" closed="false"><ref loc="PSA 110:4">Mez. 110:4</ref>.</char></note><verse eid="HEB 7:20-21"/></para>
  <para style="m">
    <verse number="22" style="v" sid="HEB 7:22"/>Hinɂa ammatokotti aalanttii Yesuusa oɂidan ohaafura ammatowun noon waabii leera.<verse eid="HEB 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23"/>Tuuk'aamol mankkogowaaro maraan tuuk'aamo koo haɂiggilssamooni feloo gutii jiruu jiroomman girin mankkodanddeenon maraan ohoree tuuk'aamolkonɂi tootoɂoottiso onjiiyyen; <verse eid="HEB 7:23"/><verse number="24" style="v" sid="HEB 7:24"/>Yesuusa ade jiruu jiroomman kagiraro mankkollee maraan tuuk'aamo laanokkeessa kaɂiggilssamoonyya. <verse eid="HEB 7:24"/><verse number="25" style="v" sid="HEB 7:25"/>Haannuun oottessa olleeraawun kakkalee maraan horehayi ayeesano jiruu jiroommaan arddokki lee mankkogiraro maraan garakkeessane Waa tos kaɂemeetaro ibaaddo dubba duuddo fayyiisin daanddaara. <verse eid="HEB 7:25"/><verse number="26" style="v" sid="HEB 7:26"/>Hikka aankkikki k'ulluu, kattuffamoon, kamuc'c'ime, c'ubbaalessalkko woyyuu kallee, daruurkko t'ok'k'i kaɂame katuuk'aamol woyichcha noon dootisara. <verse eid="HEB 7:26"/><verse number="27" style="v" sid="HEB 7:27"/>Usu kakkalee katuuk'aamol woyichchaal aani horaarjje c'ubbokkeessa maraan, abbaabayi c'ubbo kagosa maraan arggetto jaarsso sisin lakkodootisaro; isiɂoottessa jaarsso yelate kakkosisatere goorata hikki ayees kallami takkoɂadamooti yele gudisera.<note caller="-" style="x"><char style="xo" closed="false">7:27 </char><char style="xt" closed="false"><ref loc="LEV 9:7">Woy. 9:7</ref>.</char></note> <verse eid="HEB 7:27"/><verse number="28" style="v" sid="HEB 7:28"/>Seera katuuk'aamol woyichcha yele kashuumaara tuffamano kaɂabo ibaaddoyya; seerakko abbaabatere kaɂemeetara kaɂammatoo haafura ade jiruu jiroommaan tuffi kallayikki kalleero ere kawaa shuumera.<verse eid="HEB 7:28"/></para>
  <chapter eid="HEB 7"/>
  <chapter number="8" style="c" sid="HEB 8"/>
  <para style="s1">Yesuusa ammato oɂusubkokki katuuk'aamol woyichcha laano</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1"/>Goortta no kaɂayeesinanno ayeeskko kahoree ayees hikkaya; daruurii kaɂatii kawaakkokki korffinjjeeyi mina tamerggee kahamas'eero hikka aankkikki katuuk'aamol woyichcha no abnna.<note caller="-" style="x"><char style="xo" closed="false">8:1 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Mez. 110:1</ref>.</char></note> <verse eid="HEB 8:1"/><verse number="2" style="v" sid="HEB 8:2"/>Usu kakkohanddaara tarummi dunkkaanii talleetetto k'ulluukki min kawaayiyya; hikka minkokki madaaramano gene taɂibaaddoyi alleenon giraan Goottayiyya. <verse eid="HEB 8:2"/><verse number="3" style="v" sid="HEB 8:3"/>Metemeteeyi tuuk'aamolkokki woyichcha kakkoshuumamara mebaanna jaarsso Waawun sisiinya; haannuun hikki tuuk'aamo kasisinara kooko koo girin dootisara. <verse eid="HEB 8:3"/><verse number="4" style="v" sid="HEB 8:4"/>Seerakokki malee meebaa kasisara tuuk'aamol mankkogiro maraan usu ulii kagiro lii girewa tuuk'aamo lii lakkogirare; <verse eid="HEB 8:4"/><verse number="5" style="v" sid="HEB 8:5"/>Hikki tuuk'aamol takkohanddaraan dunkkaanii daruurii tagittowun masuussana hoos taalaaltta; hikkina kakkonlleera Waa Musene ati min kakkomadaaratto goorata, «Wodamii gutii ani kuun goggotuserokki malee kameen dubba isiɂoora feli» ame goggoɂajajeerokki maleeya. <verse eid="HEB 8:5"/><verse number="6" style="v" sid="HEB 8:6"/>Gidda ade Yesuusa Waayinna ibaaddonna t'eɂe tabe hiɂi too kayelero kaɂammatoo haafura oddoɂan ammatokko taroorttettona taɂidantti abddi gutii kat'aabbatero mankkolleero maraan usumaleenna usuun osisameeraan felo dubbaankko orooraraanyyan.<verse eid="HEB 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7"/>Ohoree ammato ohaafura otuffamoon lii gireenwa kallami kaɂammatoo haafura lakkodootisare. <verse eid="HEB 8:7"/><verse number="8" style="v" sid="HEB 8:8"/>Waa gosa gutii otuffamiraan felo girano tusin amere haa amara,</para>
  <para style="q1" vid="HEB 8:8">«Ani kaɂisiraɂeel gosanenna kayihuuda gosane wota</para>
  <para style="q2" vid="HEB 8:8">Ammato oɂusubkokki haafura kakkotabinnara goorata emeeyinnara amara Goottaa.»<verse eid="HEB 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9"/>Hinɂi ammato ani iso kagibs's'i ulkko genettisoo abere kakkobeesare goorata odojjolaalkkisoone wota otabere ammato aanɂinɂi lakkoyyan; isona hinɂa ammato ohaafurayi ataatana mankkowaateen maraan aninna isokko bagagole, amara Goottaa.<verse eid="HEB 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10"/>«Goortta ani hittakko abbaabayire kaɂisraɂeel gosane wota</para>
  <para style="q2" vid="HEB 8:10">ani otabinnara ohaafura ammato hinɂayaan amara Goottaa;</para>
  <para style="q1" vid="HEB 8:10">Ani seerakkee sammuutisini kayinnara;</para>
  <para style="q2" vid="HEB 8:10">Wodanattisooyinna s'aafinara;</para>
  <para style="q1" vid="HEB 8:10">Waakkisoonna linnara,</para>
  <para style="q2" vid="HEB 8:10">Isona gosakkee linnaraan ame.<verse eid="HEB 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11"/>‹Goottaa addeesi› ami ollaatteessanna leere</para>
  <para style="q2" vid="HEB 8:11">Abbikkeessa maayyona kaɂagaalssisiro lakkodootisaro.</para>
  <para style="q1" vid="HEB 8:11">Kic'c'arkko haggaɂabere taa ibaaddo kajiinjjiin geeroo dubbana</para>
  <para style="q2" vid="HEB 8:11">In addeesirowa;<verse eid="HEB 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12"/>Baaskkisoonna haheso aminara;</para>
  <para style="q2" vid="HEB 8:12">C'ubbokkisoonna hittakko horenbbaan lakkoshaadinaro.»<note caller="-" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="JER 31:31-34">Erm. 31:31-34</ref>.</char></note><verse eid="HEB 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13"/>Goorttanun «Usubnɂi ammato ohaafura» goɂamiro ohaafura ammato ohoree laɂo osisoon yelera amanoya; haannuun felaa kagirena kaddoɂan kooko dubba kakkobayinnara goorata gabbalamera.<verse eid="HEB 8:13"/></para>
  <chapter eid="HEB 8"/>
  <chapter number="9" style="c" sid="HEB 9"/>
  <para style="s1">Kaɂulee k'ulluukki min kaɂebikokki handdaano</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1"/>Ohoree ammato ohaafura Waa hedoyisatanokokki seeranna kaɂulee k'ulluukki min kawaa abanaaye; <verse eid="HEB 9:1"/><verse number="2" style="v" sid="HEB 9:2"/>Kifilii lama kaɂaba min gire. Bollanssona t'arap'eezaa, Waawun kasisamara babo takkogire tahoraarjjee kifilii «K'ullittii» amamatte. <verse eid="HEB 9:2"/><verse number="3" style="v" sid="HEB 9:3"/>Kallami goggolokko orrohayite tagitta taɂorroo kifilii «aaloo k'ullichchaatti»<note caller="+" style="f"><char style="fr" closed="false">9:3 </char><char style="ft" closed="false">Aaloo k'ulluutti banɂe taɂamamatta, k'ulluukki min kawaayi orroo taseedi kifiliitta. Biy. 26:31-36. </char></note> amamatte. <verse eid="HEB 9:3"/><verse number="4" style="v" sid="HEB 9:4"/>Hitta kifilii orroo work'k'iikko kafelamero it'aana kakkoɂiyyoosaraan ese banɂe gire; work'k'ii kakkosarssisamera ammato ohaafurakokki saat'ine esee orroo gire; hikka ammato ohaafurakokki saat'ine orroo manna takkogire tawork'k'ii uulla, hursse taggitte taɂarooni dama, ajaja tomonno kakkos'aafamere t'alp'aakki eɂemo gire.<note caller="-" style="x"><char style="xo" closed="false">9:4 </char><char style="xt" closed="false"><ref loc="EXO 30:1-6">Biy. 30:1-6</ref>; <ref loc="EXO 25:10-16">25:10-16</ref>; <ref loc="EXO 16:33">16:33</ref>; <ref loc="NUM 17:8-10">To. 17:8-10</ref>; <ref loc="EXO 25:16">Biy. 25:16</ref>; <ref loc="DEU 10:3-5">Ada. 10:3-5</ref>.</char></note> <verse eid="HEB 9:4"/><verse number="5" style="v" sid="HEB 9:5"/>Haafura kaɂammatokokki kataabota saat'ine gutii kagiro c'ubbo haheso kakkoɂamamaro nuub baalalloɂoottisoyi goliseen oɂabaraan okabajaameen Kirubeeli oɂamamaraan met't'ajjolyen; ayesuun goɂameen hikka ayees dubbakokki gara gidda balɂaasi ayeesin lakkodaanddaanno.<note caller="-" style="x"><char style="xo" closed="false">9:5 </char><char style="xt" closed="false"><ref loc="EXO 25:18-22">Biy. 25:18-22</ref>.</char></note><verse eid="HEB 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6"/>Kameen dubba hikkamalee kakkoɂekkaaro goorata tuuk'aamol Waawun handdayin arggetto minkko tahoraarjjee kifilii tos tabaraan.<note caller="-" style="x"><char style="xo" closed="false">9:6 </char><char style="xt" closed="false"><ref loc="NUM 18:2-8">To. 18:2-8</ref>.</char></note> <verse eid="HEB 9:6"/><verse number="7" style="v" sid="HEB 9:7"/>Tallami taɂorroo kifilii tos katabara ade tuuk'aamolkokki woyichcha kaalaalya; katabarana geeskko arri too taalaalya; usuna c'ubbokkeessawunna gosa haɂaddeeson kafelero c'ubboon kasisamaro iigi haɂabooni lakkotabaro.<note caller="-" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="LEV 16:2-34">Woy. 16:2-34</ref>.</char></note> <verse eid="HEB 9:7"/><verse number="8" style="v" sid="HEB 9:8"/>Dunkkaanii tahoree kakkogitto gitakki k'ulluu aaloo k'ulluutti taɂamamatto tos katabsara raa ganaa hamutoon kagiro laano Ayyaana K'ulluukki hikkamalee tusara. <verse eid="HEB 9:8"/><verse number="9" style="v" sid="HEB 9:9"/>Hikkina hikka gooratawun masuussaya; hikkamalee kasisamara meebaanna jaarsso kasisaro ibaaddotikotti sammuuyi kamaalssamaro baaskko suure k'ulloyisin lakkodaanddaaro. <verse eid="HEB 9:9"/><verse number="10" style="v" sid="HEB 9:10"/>Hikki kamooggan ayees kakkoɂusubaayinnara goorata taa emeeroo felooyi gutii kagira kasaree kamutaro wogaalya; isona aamanona t'amanokokki garana kalekaleekki kamuc'c'isaro wogakokki gara kaalaalun kafelameroya.<verse eid="HEB 9:10"/></para>
  <para style="s1">Kakiristoosa iigi</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11"/>Ayesuun goɂameen Kiristoosa emeetaa kagiro kaɂidan ayesuun katuuk'aamol woyichcha lee mutera; usu takkotabera dunkkaanii tajjinttina duuddottitta; hitti dunkkaanii gene taɂibaaddoyi tafelamoon gittona hikka alamikotti met't'a lakkotto.<note caller="+" style="f"><char style="fr" closed="false">9:11 </char><char style="ft" closed="false">Emeetaa ogiraan gutii kaɂamaro kookkoo mas'aafajjol, «gidda ogiraawun» amara. </char></note> <verse eid="HEB 9:11"/><verse number="12" style="v" sid="HEB 9:12"/>Usu aaloo k'ulluutti taɂamamatto banɂe tos kooyikkii kallami takkoɂadamooyi iigikkeessa abere tabera kuwaarre kaɂoreenenna kakkorjjoolee iigi abe lakkotabero; hikkamalee jiruu jiroomman noon wodoo lee. <verse eid="HEB 9:12"/><verse number="13" style="v" sid="HEB 9:13"/>Kaɂoreenenna kakkorjjoolee iigi jaarssoon tagubanttetto dabbaalokkokki buluulo kabbattoyero ibaaddo gutii goɂarac'c'iraan battinnati kasooyekko muc'c'imeen ok'ullowaaraan gollee,<note caller="-" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="LEV 15:16">Woy. 15:16</ref>; <ref loc="NUM 19:9">To. 19:9</ref>,<ref loc="NUM 19:17-19">17-19</ref>.</char></note> <verse eid="HEB 9:13"/><verse number="14" style="v" sid="HEB 9:14"/>Jiruu jiroommakki ayyaanakkokki garane isiɂoottessa mulla kallayikki jaarsso yelate Waawuun kasisatera kakiristoosa iigi arddokki Waawuun noo goggohanddayinnoon sammuttaani goyi tos ogeesaraan felokko aaloo no muc'c'isin lakkodaanddaaroya?<verse eid="HEB 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15"/>Oɂuumameeran hanɂu Waa tasisero abddi jiruu jiroomman rittii goggoɂatanaawun Kiristoosa ammato oɂusubkokki iigii no hiɂi too kayello lee; hikkina kakkonleera usu horaarjje ammato ohaafurakko hegelle leere ibaaddo hidiidikko keesi c'ubbokko fayyiisin mankkogoye maraanya.<verse eid="HEB 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16"/>Bazza gogire kabbazzaaterokokki goyi addeesano dootisara; <verse eid="HEB 9:16"/><verse number="17" style="v" sid="HEB 9:17"/>Kabbazza ayees feloo kakkohaara kabbazzaatera kakkogoye goorataya; kabbazzaatera neefone giraan kabbazza ayees laɂo lakkoɂabo. <verse eid="HEB 9:17"/><verse number="18" style="v" sid="HEB 9:18"/>Hikkakkotti aalanttii ohoraarjjee ammato ohaafura suure iigi kallayi oɂataateeraan lakkoyyan. <verse eid="HEB 9:18"/><verse number="19" style="v" sid="HEB 9:19"/>Horaarjje Muse kaseera ajaja dubba gosa dubbaan segee; hikkakko abbaabatere iigi kaɂoreenenna kakkorjjoolee bekene wota ledere kaseera mas'aafanna gosa dubba hisoop'i oɂamamaraan baalalloyinna ogorro oɂidaadikko kafelamero kirrii arac'c'ee; <verse eid="HEB 9:19"/><verse number="20" style="v" sid="HEB 9:20"/>Kakkonɂarac'c'erana, «Waa isinuun kaɂajajeera ammato ohaafurakokki iigi hikkaya» amereyya.<note caller="-" style="x"><char style="xo" closed="false">9:20 </char><char style="xt" closed="false"><ref loc="EXO 24:6-8">Biy. 24:6-8</ref>.</char></note> <verse eid="HEB 9:20"/><verse number="21" style="v" sid="HEB 9:21"/>Usumaleenna dunkkaanii orroonna kakkofelataraan huu dubbaa gutii iigi arac'c'ee.<note caller="-" style="x"><char style="xo" closed="false">9:21 </char><char style="xt" closed="false"><ref loc="LEV 8:15">Woy. 8:15</ref>.</char></note> <verse eid="HEB 9:21"/><verse number="22" style="v" sid="HEB 9:22"/>Ogiraan seera kamuse malee ayees kic'c'ar kuwaarre kameen dubba iigi muc'c'imara; iigi goɂubannon c'ubbo haheso amamano lakkohelamaro.<note caller="-" style="x"><char style="xo" closed="false">9:22 </char><char style="xt" closed="false"><ref loc="LEV 17:11">Woy. 17:11</ref>.</char></note><verse eid="HEB 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23"/>Goorttanun hikki kadaruuree ayees masuussa kakkoonlleera hikka aankkikki wogaa muc'c'imano dootisare; daruurkko kalleera ayees ade hikkakko karoore jaarssoyi muc'c'imano dootisara. <verse eid="HEB 9:23"/><verse number="24" style="v" sid="HEB 9:24"/>Kiristoosa karrummii k'ulluukki min kawaawun masuussa talleetettona gene taɂibaaddoyi tafelanttetto aaloo k'ulluutti banɂe tos lakkotabero; gidda usu no maraan Waayi horee mutin daruur tos bee tabe. <verse eid="HEB 9:24"/><verse number="25" style="v" sid="HEB 9:25"/>Kaɂayihuudi tuuk'aamolkokki woyichcha kakkeessa kalleenon iigi abere gees geesii aaloo k'ulluutti banɂe tos tabe gire; Kiristoosa ade isiɂoottessa jaarsso yelayi sisayin goorata kamooggan lakkotabero. <verse eid="HEB 9:25"/><verse number="26" style="v" sid="HEB 9:26"/>Haa kalleero lii girewa alami takkomet'amerokko haggaɂabire goorata kamooggan rakkoo atayin kadootisaro lii girare; gidda goɂameen geesjjolkotti gachooyi c'ubbo nookko baasin isiɂoottessa jaarsso yelate kookki kallami takkoɂadamooyi mutera. <verse eid="HEB 9:26"/><verse number="27" style="v" sid="HEB 9:27"/>Ibaaddon goyi kooyya; goyikko abbaabaterena firdda gira. <verse eid="HEB 9:27"/><verse number="28" style="v" sid="HEB 9:28"/>Usumaleenna Kiristoosa kamooggankokki c'ubbo baasin goyi koo goyera; adena c'ubbo sidayin alleenon giraan usu oɂoorataran fayyiisin kallami adi emeeyinara.<verse eid="HEB 9:28"/></para>
  <chapter eid="HEB 9"/>
  <chapter number="10" style="c" sid="HEB 10"/>
  <para style="s1">Jaarsso laano kakiristoosa kallami takkoɂadaamooti</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1"/>Seera kamuse horenbbaan kaɂemeeyinaro kaɂidan ayesuun masuussa goorttun hoosiya kuwaarre tarummi middi lakkoɂabanaaye; haannuun gees geesii arggetto kasisamaro jaarssojjool abateeren Waa tos kaɂemeetaro ibbaaddo duuddokki yelin suure lakkodaanddaaro. <verse eid="HEB 10:1"/><verse number="2" style="v" sid="HEB 10:2"/>Seera kamuse iso duuddonɂi yelin kadanddeero leewa Waa hedoyisayin kaɂemeetaro ibaaddo kallami takkoɂadamooni c'ubbokko mankkomuc'c'imerawunna c'ubbo kallayinɂi aani sammuuttisooyi baas mankkomaalassamaro maraan jaarsso sisano iisi giraneen. <verse eid="HEB 10:2"/><verse number="3" style="v" sid="HEB 10:3"/>Hassu jaarssojjool ade gees geesii iso c'ubbo kashaadisaroyya. <verse eid="HEB 10:3"/><verse number="4" style="v" sid="HEB 10:4"/>Aalanttina kakkorjolnna kaɂoreen iigi c'ubbo baasin lakkodaanddaaro.<verse eid="HEB 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HEB 10:5"/>Haannuun Kiristoosa alami tos takkoɂemeteree haa ame;</para>
  <para style="q1" vid="HEB 10:5">«Jaarssona meebaa ati inkko lakkodoottetto;</para>
  <para style="q2" vid="HEB 10:5">maarkkaa goɂameen iin ekkaassetta;<verse eid="HEB 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6"/>Kagubataro jaarssona</para>
  <para style="q1" vid="HEB 10:6">Kac'ubbo haheso amanokokkiin kaɂenɂaamaro jaarssoyi</para>
  <para style="q2" vid="HEB 10:6">ati lakkogeggelaattetto;<verse eid="HEB 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7"/>Hassu goorata ani</para>
  <para style="q1" vid="HEB 10:7">‹Hedokkee! Mas'aafa k'ulluukki garakkee goggos'aafameroo</para>
  <para style="q2" vid="HEB 10:7">Feɂittaa gudisin ani emeeyera› » ame.<note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="PSA 40:6-8">Mez. 40:6-8</ref>.</char></note><verse eid="HEB 10:7"/></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 10:8"/>Hanɂu seera kaɂajajaaro goleenna, «Jaarssona meebaa, kagubataro jaarssona c'ubbokko haheso amamano kaɂenɂaamaro jaarsso ati inkko lakkodoottetto; isoonna adde ati lakkogeggelaattetto» ame; <verse eid="HEB 10:8"/><verse number="9" style="v" sid="HEB 10:9"/>Debeenna, «Hikkima, ani feɂittaa felin emeeyera» ame; hikkamaleenna kallamikki jaarssokotti banɂee t'aabbisin kahoree jaarsso iggilisera. <verse eid="HEB 10:9"/><verse number="10" style="v" sid="HEB 10:10"/>Hikkaniinna «Feɂii» kaɂamaro haafurakokki malee Yesuusa Kiristoosa sooyi kookkii kallami takkoɂadamooti jaarsso lee isi sisatanokotti aalanttii noo k'ulloyinnenna.<verse eid="HEB 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11"/>Tuuk'aamo metemeteeyi c'ubbo baasin kadanddeenoon aanɂi jaarssojjool arggetto sisaa arri arri aallee handdaaraan.<note caller="-" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="EXO 29:38">Biy. 29:38</ref>.</char></note> <verse eid="HEB 10:11"/><verse number="12" style="v" sid="HEB 10:12"/>Kiristoosa ade arggetto kalleero jaarsso koo sise abbaabatere Waa odokotti merggeeyi hamas's'eera. <verse eid="HEB 10:12"/><verse number="13" style="v" sid="HEB 10:13"/>Hittakko horenbbaan diinakkeessa odonnatikkeessaa hegelii taa barinaanii oorara; <verse eid="HEB 10:13"/><verse number="14" style="v" sid="HEB 10:14"/>Hikkina kakkonlleera hanɂu ok'ulloyeraan jaarsso kookokki garane jiruu jiroomman duuddonɂi mankkoyelero maraanya.<verse eid="HEB 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15"/>Ayyaana K'ulluukki ade hikka ayees noon atotaara; horaarjje,<verse eid="HEB 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16"/>«Hanɂu arrijjoolkko abbaabayire</para>
  <para style="q1" vid="HEB 10:16">Isone wota ani otabinnara ammato ohaafura hinɂayaan amara Goottaa;</para>
  <para style="q1" vid="HEB 10:16">Seerakkee wodanattisooyi kayinnara;</para>
  <para style="q2" vid="HEB 10:16">Sammuuttisooyinna s'aafinara.»<verse eid="HEB 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HEB 10:17"/>Adena «C'ubbokkisoonna omeellan feloɂoottisoo</para>
  <para style="q2" vid="HEB 10:17">Hittakko horenbbaan ani lakkoshaadinaro» amara.<note caller="-" style="x"><char style="xo" closed="false">10:17 </char><char style="xt" closed="false"><ref loc="JER 31:34">Erm. 31:34</ref>.</char></note><verse eid="HEB 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 10:18"/>Haannuun c'ubbo dubba haheso kakkoɂamame goorata c'ubbo haheso amanokokki garaan kasisamara jaarsso hittakko horenbbaan laagiro.<verse eid="HEB 10:18"/></para>
  <para style="s1">Waa tos gabbalamano kadootisaro laano</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19"/>Goorttanu abbilaalttee! Iigi kayesuusakokki garane aaloo k'ulluutti banɂe tos tabin kakkodaanddenno kaɂabddisiro helannenna. <verse eid="HEB 10:19"/><verse number="20" style="v" sid="HEB 10:20"/>Noo kakkotabnanna goggolokeessayiya; haa amanona sooɂootteessakokki garane noon kabanero kaɂusubkkiinna arddokki kalleero raadiiya. <verse eid="HEB 10:20"/><verse number="21" style="v" sid="HEB 10:21"/>Daruurii kagiro min kawaayi gutii odonnati kaɂabo kanjiinkki tuuk'aamo abnna. <verse eid="HEB 10:21"/><verse number="22" style="v" sid="HEB 10:22"/>Haannuun sammuu orroo kamaalssamaro baas kameellankko goggomuc'c'iminnon wodanattaani muc'c'isayinne, maarkkaani beke omuc'c'imeenii aaligunne, tukkultti wodananna karrummii ammano abayigunne Waa tos gabbalamnno.<note caller="-" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="LEV 8:30">Woy. 8:30</ref>; <ref loc="EZK 36:25">Hiz. 36:25</ref>.</char></note> <verse eid="HEB 10:22"/><verse number="23" style="v" sid="HEB 10:23"/>Kaɂabddii haafura noon kasisera kaɂabddame mankkollee maraan gidda ammaninne kaɂatotiinnanno abddii haggattola anlleennonii ataayisayi abanna. <verse eid="HEB 10:23"/><verse number="24" style="v" sid="HEB 10:24"/>Geelanjjeeyinna felo oɂidanii ataayigunne goggogirnnon koo kakkalee haɂatayiso; <verse eid="HEB 10:24"/><verse number="25" style="v" sid="HEB 10:25"/>Arggetto raattoo iinsse eselaa isiɂisiɂorroo isiɂisi ataayisanna kuwaarre kookkoo kukkuɂamano goggoɂiseraan malee noo adi kukkuɂamanokkaani lakkoɂiinsso; haa laanakko Goottaa kakkoɂemeeyinnara arri gabbalamano shaadaa hikka ayees aaloo fela.<verse eid="HEB 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26"/>Rummi addeensse giraan abbaabayinne bogi malabaa giraan c'ubbo gofelnne hittakko horenbbaan c'ubbo maraan kasisamara jaarsso koonna laagiro. <verse eid="HEB 10:26"/><verse number="27" style="v" sid="HEB 10:27"/>Goortta no kaɂootara ade horenbbaan kalliinnara kaɂabssisaro firddana, kaneebaatara tagubatto taɂabssisso eleentta.<note caller="-" style="x"><char style="xo" closed="false">10:27 </char><char style="xt" closed="false"><ref loc="ISA 26:11">Isa. 26:11</ref>.</char></note> <verse eid="HEB 10:27"/><verse number="28" style="v" sid="HEB 10:28"/>Seera kamuse kabbaase gutii ibaaddo lama goorttun seeddo goɂatotee shaaga kallayi goyin murttessaamara.<note caller="-" style="x"><char style="xo" closed="false">10:28 </char><char style="xt" closed="false"><ref loc="DEU 17:6">Ada. 17:6</ref>; <ref loc="DEU 1:15">1:15</ref>.</char></note> <verse eid="HEB 10:28"/><verse number="29" style="v" sid="HEB 10:29"/>Hayya, ere kawaa kattuffate, kakkok'ullooyero kaɂammatoo haafurakokki iigi kafaanchchoyisarana, kasinoo Ayyaana kahabaarara, misitti hittakko taroortte murroo atayin kadootisaro aani laara!<note caller="-" style="x"><char style="xo" closed="false">10:29 </char><char style="xt" closed="false"><ref loc="EXO 24:8">Biy. 24:8</ref>.</char></note> <verse eid="HEB 10:29"/><verse number="30" style="v" sid="HEB 10:30"/>«Halo biyaano kakkeeyya; ani tadootisatto muraa murinnara» kaɂamera maayyoyo no kanssowa; usumaleenna, «Waa gosakkeessa gutii firddinnara» amara Goottaa.<note caller="-" style="x"><char style="xo" closed="false">10:30 </char><char style="xt" closed="false"><ref loc="DEU 32:35-36">Ada. 32:35-36</ref>.</char></note> <verse eid="HEB 10:30"/><verse number="31" style="v" sid="HEB 10:31"/>Haannuun arddokki Waakotti genee iyaano aaloo kaɂabssisaroya.<verse eid="HEB 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32"/>Ifa isinuun kakkohank'k'aare goorata rakkoo tammooggan atatteenddeen takkoɂobssitetten hasse tat'awoo arri shaada. <verse eid="HEB 10:32"/><verse number="33" style="v" sid="HEB 10:33"/>Arri toottoo ibaaddo horee habaaranttettan; abboosanttettaan; toottoo goɂanttaan isin hikka aankkikki abboosa kakkogeero ibaaddone wota saatilaal mankkoleetettaan maraan rakkoo atatteettan. <verse eid="HEB 10:33"/><verse number="34" style="v" sid="HEB 10:34"/>Isin taɂidanttina tagudannoon durumma daruurii girano mankkokkassaan maraan oshaameeraawun kooko sisa; urrawoɂoottisinna isinkko kakkoɂatamereen goorata obssiiteddeen geggelooyi atatteen. <verse eid="HEB 10:34"/><verse number="35" style="v" sid="HEB 10:35"/>Goortta, kaɂatii barɂaara kakkohelayinattaan kakkoɂabddaattan arooshafatteen. <verse eid="HEB 10:35"/><verse number="36" style="v" sid="HEB 10:36"/>Feɂi tawaa gudisaddeen Waa isinuun sisin kaɂammatoo haafuraayi katabero kooko atayin obssii ooratano dootisara. <verse eid="HEB 10:36"/><verse number="37" style="v" sid="HEB 10:37"/>Aalanttina haa amame s'aafamera,;</para>
  <para style="q1" vid="HEB 10:37">«Emeeyin kagira usu goorata kic'c'arkko abbaabayire emeeyinnara;</para>
  <para style="q2" vid="HEB 10:37">lakkoɂadallaayinaro;<verse eid="HEB 10:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="HEB 10:38"/>Kakkee kalleera k'ulluukki ibaaddoti ade ammanooyi giri helayinnara;</para>
  <para style="q2" vid="HEB 10:38">Haar goggale ani usuu</para>
  <para style="q2" vid="HEB 10:38">lakkogeggelaayinaro.»<note caller="-" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="HAB 2:3-4">Inb. 2:3-4</ref>.</char></note><verse eid="HEB 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 10:39"/>Noo goɂameen ammanere kafayyaarone wota unanna kuwaarre haar galegure kabaaro ibaaddokotti una lakkonno.<verse eid="HEB 10:39"/></para>
  <chapter eid="HEB 10"/>
  <chapter number="11" style="c" sid="HEB 11"/>
  <para style="s1">Ammanokokki gara</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1"/>Ammano amano abddii kaɂooramaro kooko, «Ii rumminaa leerowa» ami atatanoyya; ilɂoo kamutoon kooko kamutaro aani yeli atatanoya. <verse eid="HEB 11:1"/><verse number="2" style="v" sid="HEB 11:2"/>Waa kahorkkoo ibaaddoon kakkoɂatoteera ammanokokki aalanttiiya.<verse eid="HEB 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3"/>Alami haafura kawaayi met't'aamano kakkoɂaddeesanna ammanooya. Haannuun kamutara kooko dubba kamutoonkko kafelamero laano kanssowa.<note caller="-" style="x"><char style="xo" closed="false">11:3 </char><char style="xt" closed="false"><ref loc="GEN 1:1">Met'. 1:1</ref>; <ref loc="PSA 33:9">Mez. 33:9</ref>; <ref loc="JHN 1:3">Yan. 1:3</ref>.</char></note><verse eid="HEB 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4"/>Aabeela kak'aayeeli jaarssokko karoore jaarsso Waawun kasisera ammanoyya; Waa kaɂabeeli jaarsso geggelooyi kakkoɂatatare goorata Aabeela ammanokkeessa k'ulluukki laano atotaame. Aabeela goggoyena ammanokkeessakokki garane giddana ayeesamara.<note caller="-" style="x"><char style="xo" closed="false">11:4 </char><char style="xt" closed="false"><ref loc="GEN 4:10">Met'. 4:10</ref>.</char></note><verse eid="HEB 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5"/>Heenokka goyi usu goggogeenonkko daruur tos kakkoɂatamera ammanoyiyya; Waa mankkoɂatatero maraan lakkomute; atamanokko t'aye ade Waa geggelaayisanokkeessa atotaamera.<note caller="-" style="x"><char style="xo" closed="false">11:5 </char><char style="xt" closed="false"><ref loc="GEN 5:24">Met'. 5:24</ref>.</char></note> <verse eid="HEB 11:5"/><verse number="6" style="v" sid="HEB 11:6"/>Ammano kallayi Waa geggelaayisin lakkodaanddaamaro; Waa tos kagabbalamara ibaaddo Waa giranona usu odootatarawun ilabo kasisaro laano ammanatano dootisara.<verse eid="HEB 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7"/>Nohe ganaa ilɂoo kamutoon ayesuun Waa kakkoserisere goorata Nohe Waa abssataa kaminee ibaaddokkeessa haasayiin markkafa kakkofelera ammanoyye; Nohena ammanooyi alami dubba c'ubbaaleessa laano tuse; Nohena ammananooyi tahelamatto k'ullumma eele.<note caller="-" style="x"><char style="xo" closed="false">11:7 </char><char style="xt" closed="false"><ref loc="GEN 6:22">Met'. 6:22</ref>.</char></note><verse eid="HEB 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8"/>Abraame bigure rittii yelayi taɂatayinaro banɂe goggoseeron kakkoɂuumamere goorata eetirraa seeyinnaro koonna suure goɂaddeesiwaatena seeyin kakkoɂajajaamera ammanoyya.<note caller="-" style="x"><char style="xo" closed="false">11:8 </char><char style="xt" closed="false"><ref loc="GEN 12:5">Met'. 12:5</ref>.</char></note> <verse eid="HEB 11:8"/><verse number="9" style="v" sid="HEB 11:9"/>Usune wota kaɂabddii haafura oɂeelleeraan Yissaak'anena Yayik'oobane wota kaɂabddii ul martti lee dunkkaanii kakkohamas's'eere ammanoyiyye. <verse eid="HEB 11:9"/><verse number="10" style="v" sid="HEB 11:10"/>Hikkana usu kakkoyelera kat'aabbame ukum taɂabtto, Waa taɂekkaaserona tamadaarero katamaa oorataa mankkogire maraanya.<verse eid="HEB 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11"/>Saarana eseen abddi kasisera Waa kaɂabddame laano mankkoɂaddeessette maraan jaarɂomanokko kakkeeyi suure umulin tadanddeennon golleetena fato kakkotootaatto hunna kakkohelattetta ammanooya.<note caller="-" style="x"><char style="xo" closed="false">11:11 </char><char style="xt" closed="false"><ref loc="GEN 18:14">Met'. 18:14</ref>; <ref loc="GEN 21:2">21:2</ref>.</char></note> <verse eid="HEB 11:11"/><verse number="12" style="v" sid="HEB 11:12"/>Haannuun kagoyero ibaaddo aani katootamere Abraame kookkoo kadaruuree barraajja aani kamooggaaterena talabu giridee c'eekale aani tatootaamon sannii helantte.<note caller="-" style="x"><char style="xo" closed="false">11:12 </char><char style="xt" closed="false"><ref loc="GEN 15:5">Met'. 15:5</ref>; <ref loc="GEN 22:17">22:17</ref>; <ref loc="GEN 32:12">32:12</ref>.</char></note><verse eid="HEB 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13"/>Hinɂi dubba ammanooyi goggogireeni goyeen; Waa isoon sisin ammato katabere ayees lakkoɂatateen; ayesuun goɂameen ebbaa deengureen kaɂatateeraan aani yelateen geggelooyi atateen. Ulii gutii marttina usu ulkki ibaaddo laanawaattikkisoo malabateen.<note caller="-" style="x"><char style="xo" closed="false">11:13 </char><char style="xt" closed="false"><ref loc="GEN 33:4">Met'. 33:4</ref>; <ref loc="1CH 29:15">1 Od. 29:15</ref>; <ref loc="PSA 39:12">Mez. 39:12</ref>.</char></note> <verse eid="HEB 11:13"/><verse number="14" style="v" sid="HEB 11:14"/>Hikkamalee kaɂayeesara ibbaaddo kakkisoo kalleero ul kaɂooratanan laano addeesise tusara. <verse eid="HEB 11:14"/><verse number="15" style="v" sid="HEB 11:15"/>Hassu iso iiseen kabbeeraan ul kashaaderan leenna eserraa abbaabayin daanddaarenwa. <verse eid="HEB 11:15"/><verse number="16" style="v" sid="HEB 11:16"/>Gidda goɂameen hikkakko karoore daruurii kagiro ul halchcharaan; haannuun Waa isoon katamaa mankkoɂekkaasero maraan, «Hedookkiso» amami uumamin isoo lakkomullaaro.<verse eid="HEB 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17"/>Abraame kakkoc'aafaamere goorata Yissaak'a jaarsso yele Waawun kakkosisera ammanoyya; Hassu kaɂabddii haafura kaɂatatera Abraame erekkeessa koo jaarsso yelinye.<note caller="-" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="GEN 22:14">Met'. 22:14</ref>.</char></note> <verse eid="HEB 11:17"/><verse number="18" style="v" sid="HEB 11:18"/>Hayya Waa, «Sanniitta Yissaak'ayi uumaminatta» ame usuun segeere.<note caller="-" style="x"><char style="xo" closed="false">11:18 </char><char style="xt" closed="false"><ref loc="GEN 21:12">Met'. 21:12</ref>.</char></note><verse eid="HEB 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 11:19"/>Waa goyikko keesin kadaanddaaro laano Abraame ammananooyi goyikko kakkeero aani Yissaak'a kallami helate. <verse eid="HEB 11:19"/><verse number="20" style="v" sid="HEB 11:20"/>Yissaak'a horenbbaan kalliinnaro ayees hedegure Yayik'oobana Eesawu kakkosommaasatera ammanoyya.<note caller="-" style="x"><char style="xo" closed="false">11:20 </char><char style="xt" closed="false"><ref loc="GEN 27:29">Met'. 27:29</ref>,<ref loc="GEN 27:40">40</ref>.</char></note><verse eid="HEB 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21"/>Yayik'ooba kakkogoyinnara goorata kakkogabbalamare goorata kayoosefi yiis metemeteeyi iso kakkosommaasaterana damakkotti brt't'ee iskkatere kakkosagadere ammanoyya.<note caller="-" style="x"><char style="xo" closed="false">11:21 </char><char style="xt" closed="false"><ref loc="GEN 47:31-48:20">Met'. 47:31—48:20</ref>.</char></note><verse eid="HEB 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22"/>Yoosefa kakkogoyinnara goorata gabbalamaa kakkoɂemeetare goorata kaɂisiraɂeel ibaaddo Gibs's'ikko goggobinaraan usu kaɂayeesere iso lefaal misi yelin dootisaraan ajaja kakkosisera ammanoyiyya.<note caller="-" style="x"><char style="xo" closed="false">11:22 </char><char style="xt" closed="false"><ref loc="GEN 50:5">Met'. 50:5</ref>; <ref loc="EXO 13:1">Biy. 13:1</ref>.</char></note><verse eid="HEB 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23"/>Muse oɂumuleeraan Muse kakkoɂalatare goorata middi kaɂidan laano mankkoɂaddeeseren maraan ajaja kawono haɂabssannooni diginni seed kakkosiyamiseeren ammanoyya.<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="EXO 2:2">Biy. 2:2</ref>; <ref loc="EXO 1:22">1:22</ref>.</char></note><verse eid="HEB 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24"/>Musena kakkojiinatare goorata, «Ere taferiɂoonikokki ere» amami uumamin feɂi sisana kakkowaatera ammanooya.<note caller="-" style="x"><char style="xo" closed="false">11:24 </char><char style="xt" closed="false"><ref loc="EXO 2:2">Biy. 2:2</ref>.</char></note> <verse eid="HEB 11:24"/><verse number="25" style="v" sid="HEB 11:25"/>Haannuun usu c'ubbooyi ohelamaraan ogiddanee geggelokko suure gosa kawaanne wota rakkoo atayin dootate. <verse eid="HEB 11:25"/><verse number="26" style="v" sid="HEB 11:26"/>Usu horenbbaan taɂatayinaro muraa mankkodeero maraan urrawo ogibs's'ikko suure Kiristoosa maraan yeraatano karooraro laano aaloo k'oppee.<verse eid="HEB 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 11:27"/>Usuna engge tawono haɂabssannooni Gibs's'ikko kakkobeera ammanoyya; ilɂoo kamutoon Hedona kaddeero aani lee halchchakkeessayi t'aabbate.<note caller="-" style="x"><char style="xo" closed="false">11:27 </char><char style="xt" closed="false"><ref loc="EXO 2:15">Biy. 2:15</ref>.</char></note> <verse eid="HEB 11:27"/><verse number="28" style="v" sid="HEB 11:28"/>Yiis barkki lagadin kaɂajajaamere erggichcha kaɂisraɂeel yiis barkki goggogoononkko amaa Muse kafaasikkaa baalana iigi arac'c'aamanokkokki woga kakkofelera ammanoyya.<note caller="-" style="x"><char style="xo" closed="false">11:28 </char><char style="xt" closed="false"><ref loc="EXO 12:30">Biy. 12:30</ref>.</char></note><verse eid="HEB 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29"/>Kaɂisiraɂeel ibaaddo ul kaɂangagee kasesseeteran aani heelanɂi bekekko gama kakkonak'eeraan ammanoyya; kagibs's'i ibaaddo ade hikkamalee liin kakkodootareen goorata iso dubba bekeeyi ennegameen.<note caller="-" style="x"><char style="xo" closed="false">11:29 </char><char style="xt" closed="false"><ref loc="EXO 14:31">Biy. 14:31</ref>.</char></note><verse eid="HEB 11:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30"/>Kaɂisiraɂeel ibaaddo taɂiyyaarkko ali tagimbbe arri todoba maraamurengureen kaɂiyaarkko gimbbe kakkoɂeɂebseeran ammanoyya.<note caller="-" style="x"><char style="xo" closed="false">11:30 </char><char style="xt" closed="false"><ref loc="JOS 6:21">Iya. 6:21</ref>.</char></note> <verse eid="HEB 11:30"/><verse number="31" style="v" sid="HEB 11:31"/>Tasharmut'aatte Reɂaabi kasalalaro ibaaddo nogoddaa mankkok'op'attetto maraan oɂajajaamoonne wota gowaanokko kakkohessetta ammanoyiyya.<note caller="-" style="x"><char style="xo" closed="false">11:31 </char><char style="xt" closed="false"><ref loc="JOS 2:21">Iya. 2:21</ref>; <ref loc="JOS 6:25">6:25</ref>.</char></note><verse eid="HEB 11:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32"/>Goortta kakkalee ani me amira? Geedonakkotti, Baraak'ikkotti, Samisoonakotti, Yofitahekotti, Daawutekkotti, Saameelakottinna kahegeroolkotti maammakiin goorata iin yeraatara.<note caller="-" style="x"><char style="xo" closed="false">11:32 </char><char style="xt" closed="false"><ref loc="PRO 6:11-8:32">Mas. 6:11—8:32</ref>; <ref loc="PRO 4:6-5:21">4:6—5:21</ref>; <ref loc="PRO 13:2-16:31">13:2—16:31</ref>; <ref loc="PRO 11:1-12:7">11:1—12:7</ref>; <ref loc="1SA 1:1">1 Sam. 1:1</ref>; <ref loc="1KI 2:11">1 Won. 2:11</ref>.</char></note> <verse eid="HEB 11:32"/><verse number="33" style="v" sid="HEB 11:33"/>Iso ammanoo Wonolaal awodeeraan; firdda karrummitii gosa bariiseen; isoon tasisantette abddi helateen; taluubaan hiɂi c'ufeen;<note caller="-" style="x"><char style="xo" closed="false">11:33 </char><char style="xt" closed="false"><ref loc="DAN 6:27">Dan. 6:27</ref>.</char></note> <verse eid="HEB 11:33"/><verse number="34" style="v" sid="HEB 11:34"/>Kaɂeleenee hunna baaseen; kaɂenennan shiifakko heseen; laafummattisookko ataan tos iggilissameen; jereen shafayiin oɂatii leeraan; isone wota jereen kashafatare diinakkokki wotaadaral horoorenaan;<note caller="-" style="x"><char style="xo" closed="false">11:34 </char><char style="xt" closed="false"><ref loc="DAN 3:30">Dan. 3:30</ref>.</char></note> <verse eid="HEB 11:34"/><verse number="35" style="v" sid="HEB 11:35"/>Heleeljjool kagoyero fallikkisoo goyikko kee giraan dee. Kuukina hikkakko karoore goyikko kiyaano helayiin hedeengureen rakkoo tammooggankki abboosa atateen; hikka aankkikki shaanokko balchchumma bin lakkodootateen.<note caller="-" style="x"><char style="xo" closed="false">11:35 </char><char style="xt" closed="false"><ref loc="1KI 17:4">1 Won. 17:4</ref>; <ref loc="2KI 2:4">2 Won. 2:4</ref>.</char></note> <verse eid="HEB 11:35"/><verse number="36" style="v" sid="HEB 11:36"/>Kookkoo kakkaleetun k'ac'c'ifamano leen boc'aameen, kuunɂi adeen talukee marc'c'oo shishaameen gureen minkashaano tabeen.<note caller="-" style="x"><char style="xo" closed="false">11:36 </char><char style="xt" closed="false"><ref loc="1KI 22:26-27">1 Won. 22:26-27</ref>; <ref loc="2CH 18:25-26">2 Od. 18:25-26</ref>; <ref loc="JER 20:2">Erm. 20:2</ref>; <ref loc="JER 37:15">37:15</ref>.</char></note> <verse eid="HEB 11:36"/><verse number="37" style="v" sid="HEB 11:37"/>Eɂemoo eeggameen, magaaziinna ekka belɂeen, shiifayi goyeen, taɂidaadnna taɂoreen c'ala sarssateenguren kafafeen; hiyyeessalnna ul kaɂibaaddoo ibaaddo leen abboosameen;<note caller="-" style="x"><char style="xo" closed="false">11:37 </char><char style="xt" closed="false"><ref loc="2CH 24:21">2 Od. 24:21</ref>.</char></note> <verse eid="HEB 11:37"/><verse number="38" style="v" sid="HEB 11:38"/>Gaadii, wodamii, ulii kagiro lagajjoolnna maddaal maraamureen. Hikka garaayi alami isoon kadootisaro lakkoye.<verse eid="HEB 11:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39"/>Hikki dubba ammanokkisookokki gara Waa kaɂatoteero golleenna isoon tasisanttetto abddi ganaa lakkohelateeran. <verse eid="HEB 11:39"/><verse number="40" style="v" sid="HEB 11:40"/>Waa noon kaɂidan kooko halchcheera, haannuun iso noonne wota kuwaarre kale duuddonɂi liin lakkodaanddaanan.<verse eid="HEB 11:40"/></para>
  <chapter eid="HEB 11"/>
  <chapter number="12" style="c" sid="HEB 12"/>
  <para style="s1">Waa yiiskkeessa murrisara</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1"/>Duumanchcha aani no maraamure kaɂabero hikka dubba atojool no mankkoɂabnno maraan sidane aani noon kalleero ayees dubba noo gutii kak'urannaamero c'ubbo baasigunne nookko horene kagiro tiyaanokokki lellaamano obssii tiinno. <verse eid="HEB 12:1"/><verse number="2" style="v" sid="HEB 12:2"/>No kakkoontiyaannana ammanokkaani kahaggaɂaberona kagudisero Yesuusa diyaanoyiyya; Usu horetteessaa ogiraan geggelokotti aalanttii masik'alii gutii gowaanokokki yeraan koonna aani hatootinoonii tamask'alii rakkoonna goyi obssee; mergge tawaayinna korffinjje hamas's'ee.<verse eid="HEB 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 12:3"/>Goorttanu ahifannoninna abddi angoosannon hikka dubba usu oneebaatareen c'ubbaalessaal usu neebaataa giraan iso kaɂobsseero Yesuusa diyaa. <verse eid="HEB 12:3"/><verse number="4" style="v" sid="HEB 12:4"/>Isin c'ubbo diidanooyi ibaaddo isin taalagadiroo gin lakkoneebatteetten. <verse eid="HEB 12:4"/><verse number="5" style="v" sid="HEB 12:5"/>Waa isin yiiskkeessa aani haa amaa kagorssaatere illootteettaan;</para>
  <para style="q1" vid="HEB 12:5">«Erekkee! Hadisano kagootta arooyerasse;</para>
  <para style="q2" vid="HEB 12:5">usu ku kakkomurrise gooratana abddi aroogoosatte;<verse eid="HEB 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6"/>Goottaa kageelaatarokkeessa hadisatara;</para>
  <para style="q2" vid="HEB 12:6">Erekkeessa aani yelate kadiyaataro murrisatara.»<note caller="-" style="x"><char style="xo" closed="false">12:6 </char><char style="xt" closed="false"><ref loc="PRO 3:11-12">Mas. 3:11-12</ref>.</char></note><verse eid="HEB 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7"/>Waa isin yiiskkeessa aani mankkototaataro maraan murroɂoottessa obssaa; odo kamurrisannoon ere ayyoya? <verse eid="HEB 12:7"/><verse number="8" style="v" sid="HEB 12:8"/>Yiis kalleera dubba taɂatataro murroo isinna goɂatannoon kosichchattaan<note caller="+" style="f"><char style="fr" closed="false">12:8 </char><char style="ft" closed="false">Kosichcha amano odo kaɂaddeesamoon ere amanoyya. </char></note> kuwaarre yiiskkee lakkottaan. <verse eid="HEB 12:8"/><verse number="9" style="v" sid="HEB 12:9"/>Hikkakko kakkalee no dubba kamurrisaro kaɂumulero odolaal abnna, noonna iso kabajaa ginne; hayya, neefo girin kaɂayyaana odokkaanun misii aaloo ajajaamana waatanna! <verse eid="HEB 12:9"/><verse number="10" style="v" sid="HEB 12:10"/>Iso idane aani leen isiɂoottisowun goggomutee goorata kic'c'aruun no murriseraan, Waa ade k'ullummatteessa ohedeedamanno goggolleennon laɂottaanun no murrisara. <verse eid="HEB 12:10"/><verse number="11" style="v" sid="HEB 12:11"/>Murroo dubba kakkomurrisamanno almmaa ogaddisiraaniyaan kuwaarre ogeggelaayisaraan aani lakkollaaran; haar abbaabatere ade murroo kaɂagaalssiseraan ibaaddoon nogodda takkoɂammaganttetto tak'ullummaa il helamissisaraan.<verse eid="HEB 12:11"/></para>
  <para style="s1">Gorssana seerisano</para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12"/>Haannuun oharggaac'eeraan genennoɂoottisinna ohareraan gilbboɂoottisin ataayisayeen.<note caller="-" style="x"><char style="xo" closed="false">12:12 </char><char style="xt" closed="false"><ref loc="ISA 35:3">Isa. 35:3</ref>.</char></note> <verse eid="HEB 12:12"/><verse number="13" style="v" sid="HEB 12:13"/>Kaɂeesara goggofayyiroon kuwaarre mikitakko goggoshirmonkko luk'k'aɂoottisinun raa kaɂidan ekkaasayen.<note caller="-" style="x"><char style="xo" closed="false">12:13 </char><char style="xt" closed="false"><ref loc="PRO 4:26">Mas. 4:26</ref>.</char></note><verse eid="HEB 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14"/>K'ullumma kallayi maayona Goottaa din mankkodanddeenon maraan ibaaddo dubbane wota nogoddaa girin kadaanddeten dubba fela; k'ullummatteessaanna girin ataayeen; <verse eid="HEB 12:14"/><verse number="15" style="v" sid="HEB 12:15"/>Isinkko maayona sino tawaa goggohank'annonkko isiɂoorayeen; usumaleenna koonna taɂokokaatto il kadubamisira akaakiltte isin orroo goggoɂalannoonkona isin goggot'iboonko kamoogganna isin goggobattoyisonkko isiɂoorayeen.<note caller="-" style="x"><char style="xo" closed="false">12:15 </char><char style="xt" closed="false"><ref loc="DEU 29:18">Ada. 29:18</ref>.</char></note> <verse eid="HEB 12:15"/><verse number="16" style="v" sid="HEB 12:16"/>Kasharmmut'aaro goorttun kooyikkii kaɂaaminnaro baboon amere barkkinttetteessa kadaddalero Eesawu aani Waa kaɂabssannon ibaaddo isin orrroo goggoginnonkko isiɂoorayeen.<note caller="-" style="x"><char style="xo" closed="false">12:16 </char><char style="xt" closed="false"><ref loc="GEN 25:9-34">Met'. 25:9-34</ref>.</char></note> <verse eid="HEB 12:16"/><verse number="17" style="v" sid="HEB 12:17"/>Haar abbaabatere Eesawu somma atayin kakkodootaro goorata hinɂi somma usukko otirameeraan kassaanwa; ootaa hanɂu somma atayi godootatena suure atayin lakkodaanddee. C'ubbokko gula galin iddilii suure lakkohelate.<note caller="+" style="f"><char style="fr" closed="false">12:17 </char><char style="fqa" closed="false">Helin lakkodaanddee, </char><char style="ft" closed="false">amano c'ubbokko gula galin iddilii lakkohelate amanoyya. </char></note><note caller="-" style="x"><char style="xo" closed="false">12:17 </char><char style="xt" closed="false"><ref loc="GEN 27:30-40">Met'. 27:30-40</ref>.</char></note><verse eid="HEB 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18"/>Isin genee kadinamaro goorttun eleenii tagubaatto tasiina wodami tos lakkogeetettaan; iyootte tos, mugud tos, huffo tosna, <verse eid="HEB 12:18"/><verse number="19" style="v" sid="HEB 12:19"/>Tat'urunbbaa yaaye goorttun kasegaamara haafura takkomaalssamaro tos lakkogeetettaan; hassu haafura kamaalera ibaaddo, «Hittakko horenbbaan kakkalee haafura noon aroosegaamo» amaa taa ebaaranii geeran.<note caller="-" style="x"><char style="xo" closed="false">12:19 </char><char style="xt" closed="false"><ref loc="EXO 19:16-22">Biy. 19:16-22</ref>; <ref loc="EXO 20:18-21">20:18-21</ref>; <ref loc="DEU 4:11-12">Ada. 4:11-12</ref>; <ref loc="DEU 5:22-27">5:22-27</ref>.</char></note><verse eid="HEB 12:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="HEB 12:20"/>Aalanttina «Giddina suure wodami godaddare</para>
  <para style="q2" vid="HEB 12:20">Eɂemooyi eeggamire hagoye»</para>
  <para style="m" vid="HEB 12:20">Kaɂamara ajaja isoon mankkoɂisilaate maraan oorayin lakkodaanddeen.<note caller="-" style="x"><char style="xo" closed="false">12:20 </char><char style="xt" closed="false"><ref loc="EXO 19:12-13">Biy. 19:12-13</ref>.</char></note><verse eid="HEB 12:20"/></para>
  <para style="m">
    <verse number="21" style="v" sid="HEB 12:21"/>Esee kaddeero ayeeskko kakkeeyi Muse suure</para>
  <para style="q1" vid="HEB 12:21">«Ani abssayera, harɂeewa» ame.<note caller="-" style="x"><char style="xo" closed="false">12:21 </char><char style="xt" closed="false"><ref loc="DEU 9:19">Ada. 9:19</ref>.</char></note><verse eid="HEB 12:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22"/>Isin goɂameen tas'iyooni wodami tos gabbalantteettan. Esena arddotti tawaa katamaa talleetetto tadaruuree Iyyerusaalemitta; geggelooyi kakukkumero kamooggan kumaayi katootaamiro erggichchaal tos gabbalantteettan. <verse eid="HEB 12:22"/><verse number="23" style="v" sid="HEB 12:23"/>Megekkiso daruurii kakkoons'aafamero, min kawaawun barkki olleeraan amaniilkotti haganaa, dubba gutii kafirddaaro Hedona duuddonɂi olleeraan k'ullooleekotti neefool tos gabbalantteettan. <verse eid="HEB 12:23"/><verse number="24" style="v" sid="HEB 12:24"/>Ammato oɂusubuun t'eɂee aallee kawogarisaro kalleeroo Yesuusa tos, kaɂaabeela iigikko karoore kaɂayeesarona kaɂarac'c'aamero iigi tos gabbalantteettan.<note caller="-" style="x"><char style="xo" closed="false">12:24 </char><char style="xt" closed="false"><ref loc="GEN 4:10">Met'. 4:10</ref>.</char></note><verse eid="HEB 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25"/>Hassu kaɂayeesaro noo lakkoɂatayinnanno goggoɂamoonkko isiɂoottisin oorayeen; hanɂu Waa gara ibaaddonne uluun goɂayeesiro lakkomaalnanno oɂameeraan iso gohesanawaateen, hayya no daruurkko kaɂayeesaro goɂatatanawaanne misii hesiin daanddaanna?<note caller="-" style="x"><char style="xo" closed="false">12:25 </char><char style="xt" closed="false"><ref loc="EXO 20:22">Biy. 20:22</ref>.</char></note> <verse eid="HEB 12:25"/><verse number="26" style="v" sid="HEB 12:26"/>Hassu goorata yaayetteessa ul aaɂissette; gidda goɂameen, «Ul kaalaal alleenon giraan kooyikkii daruurnna adire aaɂisinara» ame abddi sisera.<note caller="-" style="x"><char style="xo" closed="false">12:26 </char><char style="xt" closed="false"><ref loc="HAG 2:6">Hag. 2:6</ref>.</char></note> <verse eid="HEB 12:26"/><verse number="27" style="v" sid="HEB 12:27"/>Hikki, «Kooyikkii adire» kaɂamara haafura katusara kaɂaaɂinoon kooko t'aabbayi goggogirroon kaɂaaɂara goorttun kamet't'aamera kooko baanoya.<verse eid="HEB 12:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28"/>Goortta noo kaɂaaɂinoon wononnati mankkoɂeelnnanno maraan Waa galatiinna; usu takkogeggelayisso kabajaayinna abssii handdayinna. <verse eid="HEB 12:28"/><verse number="29" style="v" sid="HEB 12:29"/>Aalanttina Hedokkaani tagubatto eleen aaniya.<note caller="-" style="x"><char style="xo" closed="false">12:29 </char><char style="xt" closed="false"><ref loc="DEU 4:24">Ada. 4:24</ref>.</char></note><verse eid="HEB 12:29"/></para>
  <chapter eid="HEB 12"/>
  <chapter number="13" style="c" sid="HEB 13"/>
  <para style="s1">Waa kageggelaayisiro handdaano</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1"/>Arggetto isiɂisirroo taɂabbilaal geelanjje isinuun haggitte; <verse eid="HEB 13:1"/><verse number="2" style="v" sid="HEB 13:2"/>Martti k'op'ayiddeen marttisano arooɂillootteen; hikkamalee martti k'op'ataa ibaaddo kookkoo haɂaddeesoonii erggichcha k'op'ateengureen marttiseeran.<note caller="-" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="GEN 18:1-8">Met'. 18:1-8</ref>; <ref loc="GEN 19:1-3">19:1-3</ref>.</char></note> <verse eid="HEB 13:2"/><verse number="3" style="v" sid="HEB 13:3"/>Isone wota kashaanttettan aani laaddeen min kashaanoyi oshaameeran shaada; isinna iso aani rakkoo kaɂataattan aani laaddeen rakkoo oɂatataraan shaada.<verse eid="HEB 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4"/>Isiɂatatano ibaaddo dubbaa dollee kakkabajaame halleewo; olayimaraanna osharmut'araan Waa mankkofirddinaro maraan oorinna entternna isiɂisii abddatana waattikko kakkeeyi isiɂatatanokkisin aroobattoyisatteen.<verse eid="HEB 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 13:5"/>Tamaragade geelanjjekko fakkima; isin kaɂabttanwa isinuun halleewo; Waa «Ani ku suure lakkoshafiro, duuddo ku lakkoɂiisiro» amera.<note caller="-" style="x"><char style="xo" closed="false">13:5 </char><char style="xt" closed="false"><ref loc="DEU 31:6">Ada. 31:6</ref>,<ref loc="DEU 31:8">8</ref>; <ref loc="JOS 1:5">Iya. 1:5</ref>.</char></note> <verse eid="HEB 13:5"/><verse number="6" style="v" sid="HEB 13:6"/>Haannuun abddii,</para>
  <para style="q1" vid="HEB 13:6">«Goottaa kagarggaararoyya ani lakkoɂabsataro;</para>
  <para style="q1" vid="HEB 13:6">Ibaaddo iin me yelin daanddaara?» amanna.<note caller="-" style="x"><char style="xo" closed="false">13:6 </char><char style="xt" closed="false"><ref loc="PSA 118:6">Mez. 118:6</ref>.</char></note><verse eid="HEB 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7"/>Haafura kawaa horaarjje isinuun osegeeraan min kawaayi horehayeen ogeggeesaraan arooɂillootteen; girikkisoonna feloɂoottisokotti laɂo shaadaa ammanokkisoo abayeen. <verse eid="HEB 13:7"/><verse number="8" style="v" sid="HEB 13:8"/>Yesuusa Kiristoosa kelena hittaari jiruu jiroomman usu usuya; lakkoɂiggilssamaro. <verse eid="HEB 13:8"/><verse number="9" style="v" sid="HEB 13:9"/>Kaɂaddeesamoon kamooggan martti kallaaro agaalssis aroobbojaantten; wodanattaani kaɂaamo woga ooratano halleenon giraan sinoyi ataatano kaɂidankkiya; hikka kababoo wogaayi debee kasesseetara ibaaddo laɂo toonna lakkoɂatatero.<verse eid="HEB 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 13:10"/>Noo banɂe tafala abnna; golleenna dunkkaanii orroo ohandaaran tuuk'aamol hitta banɂe tafalaa kagiro babo aati aamin isoon feɂi lakkosisamatto. <verse eid="HEB 13:10"/><verse number="11" style="v" sid="HEB 13:11"/>Ayihuudikokki katuuk'aamol woyichcha c'ubbokko haheso amamano kahelamisaro kagiddi iigi abeenguren aaloo k'ulluutti banɂe tos tabara; usu giddikonɂi soo adeen dunkkaanii tattaanikko sar beeseren eleenii gubaran;<note caller="-" style="x"><char style="xo" closed="false">13:11 </char><char style="xt" closed="false"><ref loc="LEV 16:27">Woy. 16:27</ref>.</char></note> <verse eid="HEB 13:11"/><verse number="12" style="v" sid="HEB 13:12"/>Usumaleenna Yesuusa iigikkeessayi gosa k'ullooyisiin kakkatamaa karakkoo sarre rakkoo atate goye. <verse eid="HEB 13:12"/><verse number="13" style="v" sid="HEB 13:13"/>Noonna dunkkaanii tattaankko sar bigunne usu tos seenno; yeraankkeessana oɂatatanno leenna. <verse eid="HEB 13:13"/><verse number="14" style="v" sid="HEB 13:14"/>Noo ganaa taɂemeeyinnatto katamaa ooratanna kuwaarre ataayi tagirnnatta katamaa hikka ulii noon laakkogitto. <verse eid="HEB 13:14"/><verse number="15" style="v" sid="HEB 13:15"/>Goorttanu Yesuusa Kiristoosakkokki garane kasommaa jaarsso arggetto Waawuun sinsso; hikkina megekkeessa maraan usuun taɂatotaatto hiɂii kasisamaro kasommaa jaarssoyya. <verse eid="HEB 13:15"/><verse number="16" style="v" sid="HEB 13:16"/>Ayees kaɂidan felanona kaɂabttaankko kakkaleetun sisano arooɂillootteen; Waa kageggelaayisara hikka aankkikki jaarssoyya.<verse eid="HEB 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17"/>Isinuun horehayeen ofelaraawun ajajaama; odonnatikkisoyi hegelii gira; iso kakkohoosamaraan odonnati mankkoɂabaan maraan girikkisin maraan ataataraan; isin isoon goɂajajaantteen isona feloɂoottisoo geggelooyi felinnaraan; goorttun iso feloɂoottisoo k'uk'amaa felaraan; hikkina isinuun laɂo kasisiro lakkoyo.<verse eid="HEB 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18"/>Noon ebaayen; tamuc'c'intte baas takkomaalssamoon sammuu noon girano addeesatanna; raa dubbaayi taɂidantti yadaliiyi girin halchchaanna; <verse eid="HEB 13:18"/><verse number="19" style="v" sid="HEB 13:19"/>Hassukkona isin ataayi goggoɂebaattanun ani isin ataayise kaɂebaatara ani isin tos saami goggoɂabbaabaroonya.<verse eid="HEB 13:19"/></para>
  <para style="s1">Kagachchoo ebi</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20"/>Kaɂatii idaad kafoofaro Goottakkaani Yesuusa jiruu jiroommakokki kaɂammatoo haafurakokki iigii goyikko kakkeesera kanogoddaa Hedo, <verse eid="HEB 13:20"/><verse number="21" style="v" sid="HEB 13:21"/>Feɂitteessa feloo hayisiin goggodanddeetawun ayees kaɂidankki dubbaa usu isin hamuyiso; No kageggelaayisiro gara kayesuusa kiristoosane no gutii hafelo; Yesuusa Kiristoosan jiruu jiroommakko taa jiruu jiroomma geeroon kabaja halleeto; hamiinɂi.<verse eid="HEB 13:21"/></para>
  <para style="s1">Gudisano</para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22"/>Abbilaalttee! Hikki ani isinuun kas'aafera handdaa kagababban mankkolleero maraan hikka kagorssa haafura obssii goggoɂatattaawun ataayise ebaatara. <verse eid="HEB 13:22"/><verse number="23" style="v" sid="HEB 13:23"/>Abbikkaani T'imotoosa min kashaanokko biyaano isin goggoɂaddeessawun dootara; usu saami hittarraa kakkoɂemeete goorata ani usune wota emeeyire isin dinnara.<verse eid="HEB 13:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24"/>Horehayeen isin obariisaraawunna k'ulloolee dubbaan nogodda segaa; kaɂit'aaliyaa ulkko emeeten hittanii ogiraan amaniil nogodda isinuun farramaraan.<verse eid="HEB 13:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25"/>Sino isin dubbane wota halleeto; hamiinɂi.<verse eid="HEB 13:25"/></para>
  <chapter eid="HEB 13"/>
</usx>
