<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EXO" style="id">- Makua Bible Version</book>
  <para style="h">Uttawa</para>
  <para style="toc1">Uttawa ukhuma Umisri</para>
  <para style="toc2">Uttawa</para>
  <para style="toc3">Utt</para>
  <para style="mt1">Uttawa</para>
  <para style="mt2">ukhuma Umisri</para>
  <para style="imt">Malhove o uholhelha</para>
  <chapter number="1" style="c" sid="EXO 1" />
  <para style="s1">Aisraeli anootwarushiya Umisri</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 1:1" />Machina a achishaana ashilhopwana a Nayakhobo aarwelhe Umisri, kila mmoka ni manyaahanu awe ni achishaana awe aari, <verse eid="EXO 1:1" /><verse number="2" style="v" sid="EXO 1:2" />Narobeni, Nasimeoni, Nalawi, Nayuda, <verse eid="EXO 1:2" /><verse number="3" style="v" sid="EXO 1:3" />Naisakari, Nazabuloni, Nabenyamini, <verse eid="EXO 1:3" /><verse number="4" style="v" sid="EXO 1:4" />Nadani, Nanaftali, Nagadi ni Naasheri. <verse eid="EXO 1:4" /><verse number="5" style="v" sid="EXO 1:5" />Iyari yonkhaye i Nayakhobo yaari attu makhumi saba. Yeyo ikatema iyo Nayusufu aari anaholhenlhe ukhalha Umisri uwo. <verse eid="EXO 1:5" /><verse number="6" style="v" sid="EXO 1:6" />Chavireke iyaakha chinchi, Nayusufu ahorimeelha, chiichammo ashilhoko aya ni iyari ilhe yonkhaye yahorimeelha. <verse eid="EXO 1:6" /><verse number="7" style="v" sid="EXO 1:7" />Nansho iyari ya Aisraeli yahonchereria chinene, nkayaakhalha attu enchi ni o machiri chinene, nkayaawanelha kila vakittu mwiilhaponi Umisri.<verse eid="EXO 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 1:8" />Paahi baada yo uvira iyaakha chinchi, ahokhalha mwene nkina Umisri uwo ahachuwenlhe Nayusufu ni wala uchuwelha mitheko chaapangilhe aya. <verse eid="EXO 1:8" /><verse number="9" style="v" sid="EXO 1:9" />Yoyo aheerelhacha attu awe wiira, “Mwooneke Aisraeli chinre aya wo ukhalha enchi chiyo, ni ukhalha attu o machiri unipwaha hii. <verse eid="EXO 1:9" /><verse number="10" style="v" sid="EXO 1:10" />Naavieke etu iphiro iriyoothe yo waawukulha, ahunchererie, ahiwe aanittawa. Ukhalhawaya yawaaka ikhoto anowa aalhutaana ni amalhaponi ihu ni waatakana ni hii mwiilhaponi mwihu mu.” <verse eid="EXO 1:10" /><verse number="11" style="v" sid="EXO 1:11" />Paahi, attu o Umisri nkayaathanlha manyapara owemelhelha Aisraeli wiira yaatwarushe wo waavaha ntheko wo ulhipa. Aisraeli nkayaavara ntheko wo utheka makhupi o ushungelha chittu cha amwene Nafarao, Upithomu ni Uramesesi. <verse eid="EXO 1:11" /><verse number="12" style="v" sid="EXO 1:12" />Nansho Aisraeli vaathepa aya utwarushiya, phi vavawo vaathepa aya wunchereria ni uthepa uwanelha velhaponi. Paahi attu o Umisri nkayoova chinene Aisraeli. <verse eid="EXO 1:12" /><verse number="13" style="v" sid="EXO 1:13" />Paahi, attu o Umisri nkayaapangiha Aisraeli ntheko wo ushilhilhi. <verse eid="EXO 1:13" /><verse number="14" style="v" sid="EXO 1:14" />Nkayaakhalha wo urikarika ni uvara ntheko wo ulhipa wo ukoorosha ichokaa ni ukoorosha matofali, ni mitheko chonkhaye cho mmamatani, wo uhoonelhiya ikiriri.<verse eid="EXO 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 1:15" />Yamalheke, amwene o Umisri yahaalhehera Nashifra ni Napua, manyoopani o uyariha, yaayarihacha manyoopani Aebraniya, <verse eid="EXO 1:15" /><verse number="16" style="v" sid="EXO 1:16" />wo wiira, “Vanaayariha inyu manyoopani Aebraniya, mwaana noyaria uyo akhalhaka mwanlhopwana, mmwiiveke. Nansho akhalhaka mwaana mwanthiyana munhiyeke akhalheke nkumi.” <verse eid="EXO 1:16" /><verse number="17" style="v" sid="EXO 1:17" />Nansho ukhalhawaya manyoopani o uyariha ayo yaari attu o unthimicha Nlhuku, khayaapangilhe thoko chaalheheriye aya ni amwene o Umisri, nansho nkayaahiya achishaana ashilhopwana a Aisraeli akhalhe akumi. <verse eid="EXO 1:17" /><verse number="18" style="v" sid="EXO 1:18" />Paahi, amwene o Umisri nkayeehanacha manyoopani o uyariha alhe, ni waakoha, “Nlhatuni no upanga chiicho? Chani woonaka nnowaahiya achishaana ashilhopwana akhalhe akumi?”<verse eid="EXO 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 1:19" />Manyoopani ayo nkayaakhulhacha, “Manyoopani Aebraniya kharii thoko manyoopani o Umisri. Ukhalhawaya yayo anoyaracha wo uhihuvahuva, nihinaya uphiya, ayo anokhalha anamanlhe wiithaphulha.”<verse eid="EXO 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 1:20" />Paahi Nlhuku ahaavahera mirima choombone yayo manyoopani o uyariha ayo. Aisraeli nkayonchereria ni ukhalha ni machiri chinene. <verse eid="EXO 1:20" /><verse number="21" style="v" sid="EXO 1:21" />Ni ukhalhawaya manyoopani o uyariha ayo yaari attu o unthimicha Nlhuku, Nlhuku ahaavahera ibarakha yo waayaracha achishaana aya ashinene. <verse eid="EXO 1:21" /><verse number="22" style="v" sid="EXO 1:22" />Yamalheke Nafarao nkayaalhehera attu aya onkhaye, yiiraka, “Kila mwaana mwanlhopwana nohalha uyaria mwa Aebraniya arihelhiyeke umwoolhokoni Unaili, ni kila mwaana mwanthiyana nohalha uyaria, ahiiyeke nkumi.”<verse eid="EXO 1:22" /></para>
  <chapter eid="EXO 1" />
  <chapter number="2" style="c" sid="EXO 2" />
  <para style="s1">Uyaria wa ashinna Musa</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 2:1" />Yeyo ikatema iyo, ahokhalha ntu mmoka o iyari i Nalawi arwelhe unthelhani mwalhi mmoka o iyari i Nalawi nttunanawe, <verse eid="EXO 2:1" /><verse number="2" style="v" sid="EXO 2:2" />ni mwalhi uyo nkaarupalha irukulhu nkannyara mwaana mwanlhopwana. Amwooneke wiira mwaana uyo aari orera, ahommitha mpaani mieri miraru. <verse eid="EXO 2:2" /><verse number="3" style="v" sid="EXO 2:3" />Nansho vonne awe wiira khanooria ummitha wo mahuku menchi ahonkoroshelha ikikapu yo itende, nkaahika ilami, nkaamwesha mwommo mwaana uyo mwommo. Nkeesha ikikapu iyo mmahushini vachereshere mwoolhoko wo Naili. <verse eid="EXO 2:3" /><verse number="4" style="v" sid="EXO 2:4" />Arokorawe mwaana uyo nkayeevitha wiira yoone ittu inohalha umpatta mwaana uyo.<verse eid="EXO 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 2:5" />Paahi abiti Farao ahowa urapani umwoolhokoni, uno anamitheko aya ashithiyana yaalhitelhelhaka vachereshere mwoolhoko uyo. Gafula, abiti Farao ayo nkayoona ikikapu ilhe mmahushini vaavithiye aya valhe, nkayanruma namitheko aya akushe. <verse eid="EXO 2:5" /><verse number="6" style="v" sid="EXO 2:6" />Nkayaapatakulha, nkayaamwoona mwaana mwankani onlhaka. Paahi nkayaamwonelha ikiriri, nkayeera, “Ulha mwaana ulha mmoka a achishaana a Aebraniya.”<verse eid="EXO 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 2:7" />Vavawo vavawo arokorawe mwaana ulhe nkayeechooniha, nkayeerelha abiti Farao alhe wiira, “Chani kowiihanelhekeni nthiyana Muebraniya olhelheni mwaana ulha?”<verse eid="EXO 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 2:8" />Abiti Farao nkayeera, “Eiyo! Nrweeke mwamwiihaneke.” Ni uyo nkaarwa, nkeehana anumwanawe mwaana ulhe. <verse eid="EXO 2:8" /><verse number="9" style="v" sid="EXO 2:9" />Abiti Farao nkayaamwiirelha nthiyana uyo, “Munkushe mwaana ulha, mwanlhelhe, ni mii kinoulhivani.” Nthiyana uyo nkankusha mwaana ulhe, unlhelhani. <verse eid="EXO 2:9" /><verse number="10" style="v" sid="EXO 2:10" />Mwaana vaahihiye awe nipelhe, ahonhokolhosha wa abiti Farao, ni ayo nkayankusha ni ukhalha mwaamwanaya. Nkayeera, “Ukhalhawaya kinkuminhe mmaashini, paahi kinomwiihana nchina nawe Musa.”<verse eid="EXO 2:10" /></para>
  <para style="s1">Ashinna Musa anoottawelha Umidiyani</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 2:11" />Nihuku nimoka ashinna Musa vaari aya anonnuwilhe rata, ahorwaa waashikuriani ashilhoko aya, Aebraniya, nkayoona uhuva waya. Nkayaamwoona Mmisri amwiivaka Muebraniya, nlhoko aya mmoka. <verse eid="EXO 2:11" /><verse number="12" style="v" sid="EXO 2:12" />Paahi ashinna Musa ahoweha uno ni uno. Yooneke wiira khaawo ntu noona, ahomwaata ni umwiiva Mmisri ulhe, nkammuhelha munhaavani. <verse eid="EXO 2:12" /><verse number="13" style="v" sid="EXO 2:13" />Washeelhe waya, ashinna Musa ahorwaa tho, nkoona Aebraniya elhi akhomakana. Paahi, nkankoha ampangelha ittu yo uhilhoka nkhunanawe uyo, “Nlhatu waani wo unkhomakacha Muebraniya nkhunaninyu?”<verse eid="EXO 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 2:14" />Uyo nkaakhulha, “Apani owensheni inyuva ukhalha o unitawara ni o unaamuka hii? Chani nnothanana ukiiva thoko chimwiivilhe inyu nchana Mmisri ulhe?”</para>
  <para style="p" vid="EXO 2:14">Wo chiichammo etu ashinna Musa nkayoova ni wuupuwelha, “Veekinaka nenne nlhove nne niheewania!” <verse eid="EXO 2:14" /><verse number="15" style="v" sid="EXO 2:15" />Paahi Nafarao yeewekeru yayo malhove ayo ahothanana weeva ashinna Musa. Nansho ashinna Musa nkayaattawa ukhuma wa Nafarao, nkayaarwa ukhalhani ilhapo yo Umidiyani, vakhiviru ilhushi.<verse eid="EXO 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 2:16" />Nihuku nimoka, achishaana ashithiyana saba, a opochera ishaani o Umidiyani ahowaacha urikani maashi, o uhelhiya mmakulhani mwaawureria ikhondoro ni ipuri cha athumwanaya. <verse eid="EXO 2:16" /><verse number="17" style="v" sid="EXO 2:17" />Nansho attu o uchunga mihuwo akina nkayaawa ni uwomolha achishaana ashithiyana ayo, nansho ashinna Musa nkayeemelha, nkayaakaviha uwuriha mihuwo chaya. <verse eid="EXO 2:17" /><verse number="18" style="v" sid="EXO 2:18" />Achishaana ashithiyana alhe vaahokolhelhe aya, Nayethro, athumwanaya, wo nchina nikina Nareuli, ahaakoha, “Yiirelhe chani woonaka nnohokolhia chitema lhelho?”<verse eid="EXO 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 2:19" />Nkayaakhulha wiira, “Mmisri mmoka ahonoopolha mmathathani mwa attu o uchunga ikhondoro. Ni uthepa yayo, ahonirikelha maashi, nkaawuriha mihuwo chihu.”<verse eid="EXO 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 2:20" />Nayethro nkayaakoha achishaana ashithiyana ayo, “Rivayi etu yoyo ntu uyo? Woonaka nhonhiya wowo? Mwamwiihane, awe aalhia yolhia.” <verse eid="EXO 2:20" /><verse number="21" style="v" sid="EXO 2:21" />Ashinna Musa nkayaarwaa nkayaalhia. Nkaachivelhiya ukhalha uwannyawe yoyo ntu uyo. Ni uyo nkaavaha ashinna Musa mwaamwanaya mwanthiyana, Zipora, akhalhe ahanu aya. <verse eid="EXO 2:21" /><verse number="22" style="v" sid="EXO 2:22" />Nazipora ayo nkaayarelha ashinna Musa mwaana mwanlhopwana. Nkayeera mii ki nlheto wono, paahi nkayaamwiihana nchina nawe Gershomu, maana aya “Nlheto.”<verse eid="EXO 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 2:23" />Chavireke iyaakha chinchi amwene o Umisri ahokhwa, achishaana o Aisraeli nkayonlhacha chinene athananaka wiira yoopolhiye. Nlhuku nkeewa ikutto aya. <verse eid="EXO 2:23" /><verse number="24" style="v" sid="EXO 2:24" />Nkeewa ichuku chaya, nkoopuwelha malhehano aapangilhe awe ni Aburahimu ni Naisaka ni Nayakhobo. <verse eid="EXO 2:24" /><verse number="25" style="v" sid="EXO 2:25" />Nlhuku ahaaweha Aisraeli chineera aya wo uttwaruwa, nkoonelha ikiriri.<verse eid="EXO 2:25" /></para>
  <chapter eid="EXO 2" />
  <chapter number="3" style="c" sid="EXO 3" />
  <para style="s1">Nlhuku noweehana ashinna Musa</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 3:1" />Nihuku nimoka, ashinna Musa yaari achungaka nkutiro wo ikhondoro cha ahokohaya, Nayethro, opochera ishaani o Umidiyani. Ashinna Musa yahorweeha yoyo nkutiro uyo uthakoni mpata uneelha nchuwa, mpaka mwaako wo Horebu, weehaniye kaanyuma Sinai, mwaako wa Nlhuku. <verse eid="EXO 3:1" /><verse number="2" style="v" sid="EXO 3:2" />Paahi nnepa wa Apwiiya Nlhuku nkawaakhumelhelha thoko nlhimi no mooro naapharelha vantinjini. Ashinna Musa nkayoona ntinji nipharelhaka nansho nihiviaka. <verse eid="EXO 3:2" /><verse number="3" style="v" sid="EXO 3:3" />Ashinna Musa nkayeera, “Yelha ittu yo ushangiha! Nlhatuni no ntinji upharelha mooro nansho nihiviaka? Paahi etu kinoorukunuwa vano koone yelha ittu ilha.”<verse eid="EXO 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 3:4" />Apwiiya Nlhuku yooneke wiira ashinna Musa anoochushera wiira awehe, aheehana wo ukhuma vantinjini vawo, “Namusa! Namusa!”</para>
  <para style="p" vid="EXO 3:4">Ashinna Musa nkayaakhulha, “Aaah, mii va.”<verse eid="EXO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 3:5" />Apwiiya Nlhuku nkayeera, “Nhaatamerie vaa, nrulhe iratu chinyu, ukhalhawaya vakittu veneemelha inyu vawo vatakatifu. <verse eid="EXO 3:5" /><verse number="6" style="v" sid="EXO 3:6" />Mii phi Nlhuku a athumwaninyu, Nlhuku a Aburahimu, Nlhuku a Naisaka, ni Nlhuku a Nayakhobo.” Paahi ashinna Musa nkayeetiyelhelha wiitho, ukhalhawaya yahoova umwoona Nlhuku.<verse eid="EXO 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 3:7" />Yamalheke Apwiiya Nlhuku nkayeera, “Kihoona ntwarusho ninaapatta attu aka arii Umisri. Kiheewa chinokunlhelha aya wo nlhatu no utwarushiya ni attu aneemelhelha mitheko aya. Kihochuwelha chineera aya wo uwereiya, <verse eid="EXO 3:7" /><verse number="8" style="v" sid="EXO 3:8" />ni mii kihokhuruwa wiira koopolhe ukhuma miono cha attu o Umisri, kaathamihe ukhuma uno, kaarwehe mpaka ilhapo yo chayira, inolhoka wo ulhimiya ni uhuwiya mihuwo. Ilhapo inokhalha Akanaani, Ahiti, Aamori, Aperizi, Ahivi, ilhapo ya Ayebusi. <verse eid="EXO 3:8" /><verse number="9" style="v" sid="EXO 3:9" />Kiheewa ikutto ya attu aka, kihoona utwarushiya unopangelhiya aya ni attu o Umisri ayo. <verse eid="EXO 3:9" /><verse number="10" style="v" sid="EXO 3:10" />Vano kinourumani wiira nrwee u Nafarao, mwaakumihe attu aka, achishaana a Aisraeli, athame Umisri.”<verse eid="EXO 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 3:11" />Nansho ashinna Musa nkayaakhulha, “Ki mpani mii, mpaka kaarwelhe Nafarao ni waakumiha Aisraeli ilhapo yo Umisri?”<verse eid="EXO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 3:12" />Nlhuku nkaakhulha, “Mii kirii vamoka ni inyu. Nnowaakumiha Aisraeli awe yaakithimicha mii Nlhuku vachulhu ulha mwako ulha. Yeyo inowa wooniha wiira phi Mii kurummeni.”<verse eid="EXO 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 3:13" />Vavawo, ashinna Musa nkayankoha Nlhuku, “Vanova, kaarwelhaka Aisraeli ni weerelha, ‘Nlhuku a manyaapwiiya inyu hokiruma uwaninyu,’ ni ayo yakikohaka, ‘Nchina nawe mpani?’ Kaakhulheke chani?”<verse eid="EXO 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 3:14" />Nlhuku nkeerelha ashinna Musa, “MII, PHI MII KIRIWO. Mwaahimerieke, neehaniya, ‘MII KIRIWO hokiruma kiwe uwannyu.’ ”<verse eid="EXO 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 3:15" />Tho, Nlhuku nkeerelha ashinna Musa, “Mwaahimerieke Aisraeli wiira, ‘Apwiiya Nlhuku, Nlhuku a manyaapwiiya inyu, Nlhuku a Aburahimu, a Naisaka ni a Nayakhobo, hokiruma uwannyu.’ Nna phi nchina naka mahuku o uhimalha, ni wo nenno phi nohalha aka wiihaniya ni iyari chonkhaye mahuku o uhimalha. <verse eid="EXO 3:15" /><verse number="16" style="v" sid="EXO 3:16" />Nrweeke mwaathukumaniheke ashulhupalhe o Aisraeli vamoka, mwaahimerieke wiira, Apwiiya Nlhuku ahokikhumelhelha. Nlhuku o manyaathumwaninyu, Nlhuku a Aburahimu, Nlhuku a Naisaka, Nlhuku a Nayakhobo, ni wiira, ‘Wo ikekhiaye kihoweha ni woona chinopangelhiya inyu Umisri uwo. <verse eid="EXO 3:16" /><verse number="17" style="v" sid="EXO 3:17" />Kiholhakelha wiira, kinoukumihani Umisri unotwarushachiya inyu ni urwehani ilhapo ya Akanaani, ilhapo ya Ahiti, ilhapo ya Aamori, ilhapo ya Aperizi, ilhapo ya Ahivi ni ilhapo ya Ayebusi. Ilhapo inolhoka ulhimiya ni uhuwelhiya mihuwo.’<verse eid="EXO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 3:18" />“Ni attu aka ayo anowiiwelhelhani. Ni inyu nrweeke vamoka ni ashulhupalhe a Aisraeli wa Nafarao ni weerelha, ‘Apwiiya Nlhuku a Aebraniya, ahokumaana ni hii. Paahi vano ninoulhepelhani wiira nnihiye nirwee nkwaha wo mahuku mararu uthakoni, wiira nakumihe isadaka wa Apwiiya Nlhuku ihu.’ <verse eid="EXO 3:18" /><verse number="19" style="v" sid="EXO 3:19" />Ni mii kihochuwelha wiira Nafarao ayo khanouhiyererani wiira nrwaache, mpaka vanohalha aya ukhanyererihiya wo machiri. <verse eid="EXO 3:19" /><verse number="20" style="v" sid="EXO 3:20" />Paahi mii kinowooniha machiri aka ni utwarusha ilhapo yo Umisri wo upanga chittu cho ushangiha cho woopiha wowo. Vanohalha aka upanga chiicho, anouhiyani wiira nrwee.<verse eid="EXO 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 3:21" />“Ni mii kinowaapanga Amisri ayo ottuneni. Paahi anouvahani chittu vanohalha inyu uthama vawo, nhiwe mwaathama mathatharu. <verse eid="EXO 3:21" /><verse number="22" style="v" sid="EXO 3:22" />Vavawo, kila nthiyana Muebraniya noovekelhaka ittu wa namwaatamana awe Mmisri, ama nlheto nonkhalhana awe unupani wawe, ikaruma cho isiliva, cho idhahabu, ni ikuwo. Ni inyu nnowaawariha achishaana inyu ashilhopwana ni ashithiyana. Phi chiichammo chinohalha inyu ukusha mihakhu cha attu o Umisri.”<verse eid="EXO 3:22" /></para>
  <chapter eid="EXO 3" />
  <chapter number="4" style="c" sid="EXO 4" />
  <para style="s1">Nlhuku nowaavaha ashinna Musa ikuru yo upanga cho ushangiha</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 4:1" />Yamalheke ashinna Musa ahomwaakhulha Nlhuku yeeraka, “Nansho Aisraeli khanowa yaakirumelhelha mena ukiwelhelha. Anowa wiira inyuva Apwiiya Nlhuku khankikhumelhenlhe.”<verse eid="EXO 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 4:2" />Vavawo Apwiiya Nlhuku nkaakoha ashinna Musa, “Mmanreni mmathathani mwinyu mmo?”</para>
  <para style="p" vid="EXO 4:2">Ashinna Musa nkayaakhulha, “Ikopo.”<verse eid="EXO 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 4:3" />Apwiiya Nlhuku nkayeerelha ashinna Musa, “Mmoriheke vathi vawo.” Ashinna Musa nkayaamoriha ikopo iyo vathi, ni iyo nkayaathathuwa inwaa, ashinna Musa nkayaattawa. <verse eid="EXO 4:3" /><verse number="4" style="v" sid="EXO 4:4" />Nansho Apwiiya Nlhuku nkayeerelha ashinna Musa, “Mwooromeke, nvareke inwaa iyo umwiilhani.” Ashinna Musa nkayooroma nkayaavara inwaa iyo umwiilhani, nkayaathathuwa ukhalha ikopo tho. <verse eid="EXO 4:4" /><verse number="5" style="v" sid="EXO 4:5" />Apwiiya Nlhuku nkayeera, “Mwaapangeke chiicho mwoonihe Aisraeli arumelhelhe wiira mii Apwiiya Nlhuku kihoukhumelhelhani. Nlhuku a manyaathumwanaya, Nlhuku a Aburahimu, Nlhuku a Naisaka, ni Nlhuku a Nayakhobo.”<verse eid="EXO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 4:6" />Tho, Apwiiya Nlhuku nkayeerelha ashinna Musa, “Mweesheke moono inyu nhina vakhakaachani winyu vawo.” Ashinna Musa nkayaapanga chiicho, vaakuminhe aya moono nkawaakhalha ni makutulha ooteelha ttuu. <verse eid="EXO 4:6" /><verse number="7" style="v" sid="EXO 4:7" />Yamalheke Nlhuku nkeerelha ashinna Musa, “Mweesheke tho moono inyu nhina vakhakaachani winyu!” Ashinna Musa nkayeesha moono aya vakhakaachani. Vaakuminhe aya, nkawahokolhelha thoko chaari aya mahuku ene. <verse eid="EXO 4:7" /><verse number="8" style="v" sid="EXO 4:8" />Nlhuku nkeerelha ashinna Musa, “Yaahuwiwelhelhekeni ama urumelhelha yo ushangiha yo upacha iyo, anorumelhelha yo ushangiha yo nayelhi iyo. <verse eid="EXO 4:8" /><verse number="9" style="v" sid="EXO 4:9" />Nansho yaahirumelhelheke wo woona cho ushangiha piilhi chiyo, ama wiiwelhelha malhove inyu, nrikeke maashi o mwoolhoko wo Unaili ni umicha vathi. Yayo maashi ayo anoothathuwa ukhalha iphome vachulhu ilhapo vawo.”<verse eid="EXO 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 4:10" />Nansho ashinna Musa nkayaakhulha Apwiiya Nlhuku, “Mena, Thithi, nhikirume mii. Akinooria wulhumacha rata toka khalhayi, ata toka vaachokhonlhe inyu ukulhumana mii namitheko inyu vawo. Ukhalhawaya mii akinooria wulhumacha wo waalhuwa, ni nlhimi naka no ulhemelha.”<verse eid="EXO 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 4:11" />Apwiiya Nlhuku nkayaakoha ashinna Musa, “Phi mpani upilhe malhaku a ntu, phi mpani nonttuka ntu hoorie wulhumacha ama uhiiwa, oone ama ukhalha ohoona? Akihiwe mii, Apwiiya Nlhuku? <verse eid="EXO 4:11" /><verse number="12" style="v" sid="EXO 4:12" />Paahi vano, nrweeke, ni mii kinoukavihani wulhumacha, kinowiittuchihani inohalha inyu wulhumacha.”<verse eid="EXO 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 4:13" />Nansho ashinna Musa nkayeera, “Mena, Thithi, chonte, munrumeke ntu nkina.”<verse eid="EXO 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 4:14" />Vavawo Apwiiya Nlhuku nkayaathunalhelha ashinna Musa, nkayeera, “Chani! Khaawo onninyu Naharuni, uchuulhu u Nalawi? Kihochuwelha wiira yayo anowooria wulhumacha rata. Tho, anoowa uwikamelhani, ni ayo vanohalha aya uwoonani, anootelhiya munrimani mwaya. <verse eid="EXO 4:14" /><verse number="15" style="v" sid="EXO 4:15" />Mwoolhumaneke ni waahimeria malhove onkhaye anothananiya aya wulhumacha. Ni mii kinowiittuchihani mwaatti chittu cho upanga. <verse eid="EXO 4:15" /><verse number="16" style="v" sid="EXO 4:16" />Naharuni anokowolhumana Aisraeli vanipuroni winyu. Anookhalha nkavihi inyu o wulhumacha, ni inyu nnookhalha thoko Nlhuku aya, mwaavahaka ittu yo wulhumacha. <verse eid="EXO 4:16" /><verse number="17" style="v" sid="EXO 4:17" />Nkusheke ikopo ilha mmathathani mwinyu, ni wo ilha nnopanga cho ushangiha chilhe.”<verse eid="EXO 4:17" /></para>
  <para style="s1">Ashinna Musa anoohokolhia Umisri</para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 4:18" />Paahi ashinna Musa nkayaahokolhia u Nayethro, ahokohaya, ni waahimeria wiira, “Chonte, nkihiye kirwee, kihokolhie Umisri wa ashilhoko aka, koone yakhalhaka akumi nanlhelho.”</para>
  <para style="p" vid="EXO 4:18">Nayethro nkayeerelha ashinna Musa, “Nrweeke wo uhikhalha ni nipampa.”<verse eid="EXO 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 4:19" />Ashinna Musa vaari aya bado Umidiyani, Apwiiya Nlhuku aheerelha wiira, “Haya, nrweeke, nhokolhie Umisri, ukhalhawaya attu onkhaye yaathanana uwiivani alhe ahokhwacha.” <verse eid="EXO 4:19" /><verse number="20" style="v" sid="EXO 4:20" />Paahi Ashinna Musa nkayaakusha ahanu aya ni achishaana aya, nkaawelhihacha vachulhu iphuta, nkayaachokholha nkwaha uhokolhia Umisri, anakunshe mmathathani mwaya ikopo ya Nlhuku ilhe.<verse eid="EXO 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 4:21" />Tho, Apwiiya Nlhuku nkayeerelha ashinna Musa, “Vanohalha inyu uphiya Umisri vawo, mwapangeke cho ushangiha chuvahilhe akani ikuru yo upanga chiyo, umihoolho u Nafarao. Nansho kinowaahelha itiyamaru wiira ahaahiyerere Aisraeli wiira athamache. <verse eid="EXO 4:21" /><verse number="22" style="v" sid="EXO 4:22" />Ni inyu mwaahimerieke Nafarao wiira, Apwiiya Nlhuku aneera wiira, ‘Israeli phi mwaamwanaka mwanlhopwana o nttara! <verse eid="EXO 4:22" /><verse number="23" style="v" sid="EXO 4:23" />Kahouhimeriani wiira, mwaahiyerere vano achishaana aka, arwee, wiira avare mitheko chaka! Nansho mwahokhota wiira ahithamache, paahi vano kinomwiiva mwaamwaninyu mwanlhopwana o nttara ninyu.’ ”<verse eid="EXO 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 4:24" />Phi chiichammo ashinna Musa vaari aya mphironi ahokolhiaka Umisri, ahorupelha vakittu, Apwiiya Nlhuku ahaakumaanana, nkayaathanana weeva. <verse eid="EXO 4:24" /><verse number="25" style="v" sid="EXO 4:25" />Vavawo Nazipora ahottimakacha nkayaarokotta nlhuku no wiithia, nkayanthikilha nrapalha no umattepe mwaamwanaya, ni waahika ashinna Musa vamietoni, nkayeera, “Wo ilha iphome ilha nhokhalha owannyaka o ikekhiaye.” <verse eid="EXO 4:25" /><verse number="26" style="v" sid="EXO 4:26" />Nlhuku nkaahiya ashinna Musa. Nazipora yenre, “Inyuva phi abwana arusi o iphome” wo nlhatu no wiina unyawo.<verse eid="EXO 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 4:27" />Yamalheke, Apwiiya Nlhuku nkayeerelha Naharuni, “Nrwee uthakoni mwaakumaane ashinna Musa.” Paahi ahorwaa nkayaakumaana ashinna Musa umwaakoni wa Nlhuku, nkayaakumbatira. <verse eid="EXO 4:27" /><verse number="28" style="v" sid="EXO 4:28" />Ashinna Musa nkayaahimeria Naharuni malhove onkhaye aahimeriye aya ni Apwiiya Nlhuku wiira ahimie, ni cho ushangiha chonkhaye chaalheheriye aya wiira apange.<verse eid="EXO 4:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 4:29" />Paahi ashinna Musa ni Naharuni nkayaarwa Umisri nkayaathukumaniha ashulhupalhe onkhaye a Aisraeli. <verse eid="EXO 4:29" /><verse number="30" style="v" sid="EXO 4:30" />Ni Naharuni nkayaahimiacha malhove onkhaye Apwiiya Nlhuku yalhehenre aya ashinna Musa. Ni ashinna Musa ni ayo ahopangacha cho ushangiha chilhe vaattuni. <verse eid="EXO 4:30" /><verse number="31" style="v" sid="EXO 4:31" />Attu nkayaarumelhelhacha. Ni veewilhe aya wiira Apwiiya Nlhuku ahowa uwoopolhani achishaana a Aisraeli, ni wiira ahoona utwarushiya waya, ahooromihacha miuru chaya ni waathimicha Apwiiya Nlhuku.<verse eid="EXO 4:31" /></para>
  <chapter eid="EXO 4" />
  <chapter number="5" style="c" sid="EXO 5" />
  <para style="s1">Ashinna Musa ni Naharuni umihoolho u Nafarao</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 5:1" />Kaanyuma aya ashinna Musa ni Naharuni yahorwa u Nafarao, ni weerelha, “Apwiiya Nlhuku, Nlhuku o Aisraeli aneera wiira, ‘Mwaahiyacheke attu aka athamache, yapange nihuku nulhupalhe uthakoni, wo nlhatu waka.’ ”<verse eid="EXO 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 5:2" />Nansho Nafarao nkayaakoha, “Phi apani yayo Apwiiya Nlhuku ayo, ata kewelhelhe ni waahiyacha Aisraeli wiira arwaache? Mii akinaachuwelha yayo Apwiiya Nlhuku ayo, mena akinaahiyerera Aisraeli wiira arwaache.”<verse eid="EXO 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 5:3" />Ashinna Musa ni Naharuni nkayaakhulhacha, “Nlhuku a Aebraniya ahokumaana ni hii. Vano ninolhepelhani wiira nnihiye nirwaache uthakoni nkwaha wo mahuku mararu nakumihe isadaka wa Apwiiya Nlhuku ihu. Mena yaahikhalheke chiicho, yayo anooniva wo mareta o uweria ama ikhoto.”<verse eid="EXO 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 5:4" />Nansho amwene Nafarao nkayaakhulha, “Inyu mwaatti, ashinna Musa ni Naharuni, nlhatuni no ulhikacha waakumiha attu munthekoni waya? Mwaahimerieke attu ahokolhie unthekoni waya.” <verse eid="EXO 5:4" /><verse number="5" style="v" sid="EXO 5:5" />Tho Nafarao nkayeera, “Attu inyu alha enchi waapwaha attu o Umisri. Chani nnothanana etu wiira ahiyache uvara ntheko?”<verse eid="EXO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 5:6" />Nenno nihuku Nafarao nkayaalhehera amanyapara ni attu owemelhelha mitheko yeeraka, <verse eid="EXO 5:6" /><verse number="7" style="v" sid="EXO 5:7" />“Toka lhelho nhaavahe alha attu alha manyashi o ukooroshelha matofali thoko chinopanga inyu. Anoorwacha uwaaviani ashinene. <verse eid="EXO 5:7" /><verse number="8" style="v" sid="EXO 5:8" />Nansho ihesabu yo matofali anokooroshiya kila nihuku ihiwukuwe. Ikhalheke phi yeyo kila nihuku, ihiwukuwe mena ata ntofali nimoka, ukhalhawaya yalha attu alha kharina ntheko wo ulhipa, phi nlhatu nineera aya wiira, ‘Nnihiye nirwee nakumihe isadaka wa Nlhuku ihu.’ <verse eid="EXO 5:8" /><verse number="9" style="v" sid="EXO 5:9" />Mwaavacheheke ntheko wo ulhipa wiira athepeke uttwaruwa, ahiyeke wulhumacha malhove o woothacha.”<verse eid="EXO 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 5:10" />Paahi, amanyapara ni attu owemelhelha ntheko nkayaathama ni urwaa wa attu ayo ni wiira, “Nafarao aneera wiira, ‘Akinovahani manyashi o ukooroshelha matofali tho. <verse eid="EXO 5:10" /><verse number="11" style="v" sid="EXO 5:11" />Nrweeke mwaavieke mwaashinene variwoothe vanohalha inyu upatta, ni mena ntheko inyu khunowukulhiya ata vakani.’ ” <verse eid="EXO 5:11" /><verse number="12" style="v" sid="EXO 5:12" />Paahi, attu onkhaye nkayaamwaria kila vakittu velhaponi Umisri yaviaka manyashi o ukooroshelha matofali. <verse eid="EXO 5:12" /><verse number="13" style="v" sid="EXO 5:13" />Ni amanyapara nkayaathepa wiira, “Mmalhiheke ntheko inyu wo kila nihuku thoko vaawiheriya inyu manyashi mpacho valhe.” <verse eid="EXO 5:13" /><verse number="14" style="v" sid="EXO 5:14" />Amanyapara Amisri nkayaatakacha attu yaathanlhiye wemelhelha Aisraeli ntheko yiiraka, “Nlhatuni kannomalhiha ntheko inyu ni upiiha ihesabu yo matofali thoko mpacho valhe?”<verse eid="EXO 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 5:15" />Paahi attu owemelhelha ntheko vaarwenlhe aya u Nafarao, ni wonlhelha yiiraka, “Nlhatuni no unipanga chiicho hii anamitheko inyu? <verse eid="EXO 5:15" /><verse number="16" style="v" sid="EXO 5:16" />Khaninovahiya tho manyashi ariyoothe, uno nikanyererihiyaka ukoorosha matofali. Tho, hii anamitheko inyu ninowaatakachiya, uno attekilhe ayo attu inyu.”<verse eid="EXO 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 5:17" />Nansho Nafarao nkayeera, “Ohuva inyu, mwaattiva ohuva, phi nlhatu nineera inyu, ‘Nnihiye nirwee nakumihe isadaka wa Apwiiya Nlhuku.’ <verse eid="EXO 5:17" /><verse number="18" style="v" sid="EXO 5:18" />Nrwaacheke vano etu mwavare ntheko. Ukhalhawaya khannovahiya manyashi ariyoothe, nansho nthananiyaka wiira nkoorosheke matofali ihesabu thoko yo mpacho ilhe!” <verse eid="EXO 5:18" /><verse number="19" style="v" sid="EXO 5:19" />Paahi, attu o wemelhelha ntheko Aisraeli ahochuwelhacha wiira vano arii muuhuvani, ukhalhawaya yeerelhiye wiira, ihesabu yo matofali yo kila nihuku, khinowukulhiya mena.<verse eid="EXO 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 5:20" />Yathameke u Nafarao, nkayaakumaana ashinna Musa ni Naharuni yaakhanlhe yaawehereraka. <verse eid="EXO 5:20" /><verse number="21" style="v" sid="EXO 5:21" />Paahi, nkayaahimeria ashinna Musa ni Naharuni wiira, “Apwiiya Nlhuku oone nna nlhove nna ni uhukumulhani mwaattiva wo nlhatu no unipanga hii nikhalhe ittu yaarushilhe Nafarao ni anamitheko aya olhupalhe. Mwaattiva nhaavaha nlhatu wo uniiva!”<verse eid="EXO 5:21" /></para>
  <para style="s1">Ashinna Musa anowonlhelha Apwiiya Nlhuku</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 5:22" />Paahi ashinna Musa nkayaarukunuwa wa Apwiiya Nlhuku, nkayeera, “Pwiiya Nlhuku, woonaka nhaapangelha mwo uhilhoka yalha attu alha? Nlhatuni no ukiruma mii? <verse eid="EXO 5:22" /><verse number="23" style="v" sid="EXO 5:23" />Ukhalhawaya toka vaarwelhe aka u Nafarao ni wolhumana wo nchina ninyu, ahaapangelha mwo uhilhoka alha attu alha. Mena khannapanga ittu yo wookholha attu inyu ata vakani!”<verse eid="EXO 5:23" /></para>
  <chapter eid="EXO 5" />
  <chapter number="6" style="c" sid="EXO 6" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 6:1" />Nansho Apwiiya Nlhuku nkayaakhulha ashinna Musa wo wiira, “Vano nnowoona chinohalha aka waapanga Nafarao. Ukhalhawaya wo moono aka wo machiri anowaahiyerera attu aka wiira athamache. Eiyo, wo machiri anowoomolha Aisraeli athamache mwiilhaponi mwaya.”<verse eid="EXO 6:1" /></para>
  <para style="s1">Nlhuku noweehana ashinna Musa</para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 6:2" />Nlhuku nkeerelha ashinna Musa, “Mii phi Apwiiya Nlhuku. <verse eid="EXO 6:2" /><verse number="3" style="v" sid="EXO 6:3" />Kahaakhumelhelha Aburahimu, Naisaka ni Nayakhobo kichuwelhiyaka wiira Nlhuku o Machiri onkhaye. Nansho akachuwelhiye uwannyaya ukhalha Apwiiya Nlhuku. <verse eid="EXO 6:3" /><verse number="4" style="v" sid="EXO 6:4" />Tho, kahopanga malhehano ni ayo wiira kinowaavaha ilhapo yo Kanaani, ilhapo waakhanlhe aya thoko alheto. <verse eid="EXO 6:4" /><verse number="5" style="v" sid="EXO 6:5" />Uthepa yayo, kiheewa ichuku ya Aisraeli anottwarushiya ni attu o Umisri, ni mii kihoopuwelha malhehano aka. <verse eid="EXO 6:5" /><verse number="6" style="v" sid="EXO 6:6" />Paahi etu, mwaahimerieke Aisraeli wiira, ‘Mii Apwiiya Nlhuku! Kinowookholha ukhuma upottani wa attu o Umisri. Kinowookolha moono aka urii wo machiri ni waatwarusha chinene attu o Umisri, ni uwoopolhani mwaattiva. <verse eid="EXO 6:6" /><verse number="7" style="v" sid="EXO 6:7" />Kinoupangani ukhalha attu aka, ni mii kinookhalha Nlhuku inyu. Ni inyu nnowa uchuwelha wiira mii phi Apwiiya Nlhuku inyu, kuukumihilheni upottani mwa attu o Umisri. <verse eid="EXO 6:7" /><verse number="8" style="v" sid="EXO 6:8" />Ni mii kinourwehani ilhapo ilhe yaavahilhe aka Aburahimu, Naisaka ni Nayakhobo. Kinouvahani yeyo ilhapo iyo ikhalhe yawinyu. Mii phi Apwiiya Nlhuku kaalhehilhe.’ ” <verse eid="EXO 6:8" /><verse number="9" style="v" sid="EXO 6:9" />Ashinna Musa nkayeerelha Aisraeli yayo malhove ayo. Nansho manyaattu ayo khayewelhenlhe ukhalhawaya mirima chaya chahokhwa wo nlhatu wo upangihiya ntheko wo ipotta.<verse eid="EXO 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 6:10" />Yamalheke Apwiiya Nlhuku nkayeerelha ashinna Musa, <verse eid="EXO 6:10" /><verse number="11" style="v" sid="EXO 6:11" />“Nrwe mwaahimerie Nafarao, amwene o Umisri, wiira aahiye Aisraeli athamache mwiilhaponi mwaya.”<verse eid="EXO 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 6:12" />Nansho ashinna Musa nkayaakhulha Apwiiya Nlhuku, “Yakhalhaka Aisraeli khanokiiwelhelha, Nafarao anohalha ukiiwelhelha chani? Tho, mii ntu kihinooria wulhumacha rata!” <verse eid="EXO 6:12" /><verse number="13" style="v" sid="EXO 6:13" />Nansho Apwiiya Nlhuku nkayaalhehera ashinna Musa ni Naharuni arwee u Nafarao, amwene o Umisri, yaaholhelhe Aisraeli uthama Umisri uwo.<verse eid="EXO 6:13" /></para>
  <para style="s1">Iyari ya ashinna Musa ni iyari i Naharuni</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 6:14" />Alha phi machina a manyaapwiiya aya Aisraeli. Achishaana a Narobeni, nttara ni Naisraeli yaani Nayakhobo yaari, Henoko, Palu, Hesroni, ni Karimi. Yayo yaari manyaapwiiya a attu o nihimo ni Narobeni. <verse eid="EXO 6:14" /><verse number="15" style="v" sid="EXO 6:15" />Achishaana ashilhopwana a Nasimeoni yaari, Yemueli, Yamini, Ohadi, Yakini, Sohari ni Shauli. Shauli ulha aayariye ni nthiyana o Ukanaani. Yayo yaari phi manyaapwiiya a attu o nihimo ni Nasimeoni. <verse eid="EXO 6:15" /><verse number="16" style="v" sid="EXO 6:16" />Achishaana ashilhopwana a Nalawi ni iyari aya yaari, Gershoni, Kohathi ni Merari. Nalawi yaalhokenlhe iyaakha imia imoka ni makhumi mararu ni saba. <verse eid="EXO 6:16" /><verse number="17" style="v" sid="EXO 6:17" />Achishaana ashilhopwana a Nagershoni yaari, Libni ni Shimeyi, ni iyari aya yaari yulhupalhe. <verse eid="EXO 6:17" /><verse number="18" style="v" sid="EXO 6:18" />Achishaana ashilhopwana a Nakohathi yaari, Amramu, Ishari, Hebroni ni Uzieli. Nakohathi yaalhokenlhe iyaakha imia imoka ni makhumi mararu ni ttaru. <verse eid="EXO 6:18" /><verse number="19" style="v" sid="EXO 6:19" />Achishaana ashilhopwana a Namerari yaari, Mahli ni Mushi. Yayo phi manyaapwiiya a attu o nihimo ni Nalawi.<verse eid="EXO 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 6:20" />Naamramu yahaathelha Nayokebedi, amati aya, ni ayo nkayaayara Naharuni ni ashinna Musa. Naamramu yaalhokenlhe iyaakha imia imoka ni makhumi mararu ni saba. <verse eid="EXO 6:20" /><verse number="21" style="v" sid="EXO 6:21" />Achishaana ashilhopwana a Naishari yaari, Kora, Nefegi ni Zikiri. <verse eid="EXO 6:21" /><verse number="22" style="v" sid="EXO 6:22" />Achishaana ashilhopwana a Nauzieli yaari, Mishaeli, Elsafani ni Sithri.<verse eid="EXO 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 6:23" />Naharuni ahonthelha Elisheba, mwaamwana a Naaminadabu, arokorawe Nashoni. Nkayaayara Nanaadabu, Abihu, Eleazari ni Ithamani. <verse eid="EXO 6:23" /><verse number="24" style="v" sid="EXO 6:24" />Achishaana ashilhopwana a Nakora yaari, Asiri, Elikana ni Abiasafu. Yaari phi manyaapwiiya a attu o mahimo a Nakora. <verse eid="EXO 6:24" /><verse number="25" style="v" sid="EXO 6:25" />Mwaamwana a Naharuni, Eliazari, ahonthelha mmoka a achishaana ashithiyana a Naputieli, nkannyara Finiyasi. Alha phi yaari ashulhupalhe olhupalhe a Alawi.<verse eid="EXO 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 6:26" />Naharuni ni ashinna Musa yaari phi attu yaalheheriye ni Apwiiya Nlhuku wiira, “Mwaaholhelhe Aisraeli ukhuma ilhapo yo Umisri.”<verse eid="EXO 6:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 6:27" />Ni phi yayo yolhumanne Nafarao, amwene o Umisri, mwaha wo waakumiha Aisraeli mwiilhaponi Umisri.<verse eid="EXO 6:27" /></para>
  <para style="s1">Apwiiya Nlhuku anowaalhehera ashinna Musa ni Naharuni</para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 6:28" />Nihuku Apwiiya Nlhuku nolhumanne aya ni ashinna Musa Umisri nne, <verse eid="EXO 6:28" /><verse number="29" style="v" sid="EXO 6:29" />yeerenlhe wiira, “Mii phi Apwiiya Nlhuku. Mwaahimerie Nafarao, amwene o Umisri, malhove onkhaye anohimeriakani.”<verse eid="EXO 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 6:30" />Nansho ashinna Musa nkayaakhulha Apwiiya Nlhuku wiira, “Mii akinooria wulhumacha rata, Nafarao anohalha ukiwelhelha chani?”<verse eid="EXO 6:30" /></para>
  <chapter eid="EXO 6" />
  <chapter number="7" style="c" sid="EXO 7" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 7:1" />Yamalheke, Apwiiya Nlhuku nkayeerelha ashinna Musa, “Mwooneke, mii kinoupangani ukhalha thoko Nlhuku wa Nafarao, ni onninyu Naharuni ayo, anookhalha o wulhumacha vanipuroni winyu. <verse eid="EXO 7:1" /><verse number="2" style="v" sid="EXO 7:2" />Mwaahimerieke onninyu Naharuni malhove onkhaye anohalha aka ulheherani. Ni ayo anowaahimeria Nafarao wiira aahiyache Aisraeli akhumache mwiilhaponi mwaya mmo. <verse eid="EXO 7:2" /><verse number="3" style="v" sid="EXO 7:3" />Nansho kinowaahelha Nafarao itiyamaru. Ata kinathepihaka ithikineha ni cho ushangiha chinchi mwiilhaponi Umisri, <verse eid="EXO 7:3" /><verse number="4" style="v" sid="EXO 7:4" />Nafarao khanowiiwelhelhani, ni vavawo kinowookolha moono aka urii ni machiri ni utwarusha wo uviha ilhapo yo Umisri, ni waaholhelha Aisraeli ukhuma Umisri. Kinowa upanga wo mitheko chulhupalhe chiicho, uhukumulha ilhapo yo Umisri. <verse eid="EXO 7:4" /><verse number="5" style="v" sid="EXO 7:5" />Ikatema vanohalha aka wookolha moono aka utwarusha ilhapo yo Umisri ni waakumiha Aisraeli, phi vavawo, attu o Umisri vanohalha aya uchuwelha wiira mii phi Apwiiya Nlhuku.” <verse eid="EXO 7:5" /><verse number="6" style="v" sid="EXO 7:6" />Paahi, ashinna Musa ni Naharuni nkayaapanga chiicho, thoko Apwiiya Nlhuku chenre aya wo waalhehera. <verse eid="EXO 7:6" /><verse number="7" style="v" sid="EXO 7:7" />Yeyo ikatema yoolhumana aya Nafarao iyo, ashinna Musa yaari ntu o iyaakha makhumi nane. Ni Naharuni aari ni ntu o iyaakha makhumi nane ni ttaru.<verse eid="EXO 7:7" /></para>
  <para style="s1">Ikopo i Naharuni</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 7:8" />Apwiiya Nlhuku nkayeerelha ashinna Musa ni Naharuni wiira, <verse eid="EXO 7:8" /><verse number="9" style="v" sid="EXO 7:9" />“Nafarao yohimeriakani wiira nhimiecheshe wo upanga cho ushangiha, mwaahimerieke Naharuni wiira amoriheke ikopo aya vathi umihoolho u Nafarao vawo. Ni iyo inothathuwa ukhalha inwaa.” <verse eid="EXO 7:9" /><verse number="10" style="v" sid="EXO 7:10" />Paahi, ashinna Musa ni Naharuni nkayaarwa u Nafarao ni upanga thoko chilheheriye aya ni Apwiiya Nlhuku. Naharuni ahomoriha ikopo aya vathi vamihoolho u Nafarao ni anamitheko aya olhupalhe, ni iyo nkhayathathuwa ukhalha inwaa. <verse eid="EXO 7:10" /><verse number="11" style="v" sid="EXO 7:11" />Nansho, Nafarao aheehanacha attu aya o irusho ni akhwiri. Ni wo ukhwiri waya wo Umisri ni ayo ahopanga chiicho. <verse eid="EXO 7:11" /><verse number="12" style="v" sid="EXO 7:12" />Kila mmoka nkaamoriha ikopo awe vathi, nkayaathathuwa ukhalha inwaa. Nansho ikopo i Naharuni yahomiria ikopo chaya. <verse eid="EXO 7:12" /><verse number="13" style="v" sid="EXO 7:13" />Ata inakhalhaka chiicho, Nafarao ahothepa itiyamaru aya, mena khayewelhenlhe, nkayaahalha thoko Apwiiya Nlhuku chenre aya wo uhimia.<verse eid="EXO 7:13" /></para>
  <para style="s1">Mariro anookelha Umisri</para>
  <para style="r">(<ref loc="EXO 7:14-12:36">Utt 7:14-12:36</ref>)</para>
  <para style="s1">Mariro o upacha: Iphome</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 7:14" />Yamalheke Apwiiya Nlhuku nkayeerelha ashinna Musa, “Nafarao ahokhalha o itiyamaru. Ahokhota waahiyerera Aisraeli wiira athamache. <verse eid="EXO 7:14" /><verse number="15" style="v" sid="EXO 7:15" />Paahi, meelho wichishu, nrweeke mwaakumane, ikatema vanorwaa aya umwoolhokoni Unaili. Mwaalhiteke uchereshere mwoolhoko uwo. Nkusheke ikopo inyu yaathathuwilhe ukhalha inwaa ilhe. <verse eid="EXO 7:15" /><verse number="16" style="v" sid="EXO 7:16" />Mwamalhaka mwaahimerieke wiira, ‘Apwiiya Nlhuku, Nlhuku a Aebraniya, ahokiruma uwannyu kuuhimerieni wiira, mwaahiyerere attu aya arwaache uthakoni yakithimiche. Nansho mpaka vano inyuva kannottuna urumelhelha. <verse eid="EXO 7:16" /><verse number="17" style="v" sid="EXO 7:17" />Paahi, Apwiiya Nlhuku aneera wiira vano nnowaachuwelha wiira yayo phi apani. Kinowaata vachulhu maashi o mwoolhoko wo Unaili wo ilha ikopo ilha, ni maashi onkhaye anothathuwa ukhalha iphome. <verse eid="EXO 7:17" /><verse number="18" style="v" sid="EXO 7:18" />Ihopa chonkhaye chirii mmwoolhokoni Unaili chinookhwacha, ni mwoolhoko wonkhaye unowa unukha chinene, ni attu o Umisri khanowa yooria uwuria maashi ayo.’ ”<verse eid="EXO 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 7:19" />Apwiiya Nlhuku nkayeerelha ashinna Musa, “Mwaahimerie Naharuni wiira akusheke ikopo aya atheesheke vachulhu maashi o Umisri, vachulhu miolhoko chonkhaye, mashepa onkhaye, mathapwi onkhaye ni mattiya onkhaye, ni ayo anoothathuwa iphome. Iphome inowa ukhalha mwiilhaponi mwonkhaye, ata nhina chittu chonkhaye chinohelhiya maashi.”<verse eid="EXO 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 7:20" />Ashinna Musa ni Naharuni nkayaapanga thoko Apwiiya Nlhuku chaalhehenre aya. Naharuni ahothesha ikopo aya uchulhu umihoolho u Nafarao ni anamitheko aya olhupalhe, nkayaata vachulhu maashi o mwoolhoko wo Unaili, ni maashi onkhaye mmwoolhokoni mmwo ahothathuwa iphome. <verse eid="EXO 7:20" /><verse number="21" style="v" sid="EXO 7:21" />Ihopa nkachaakhwacha, mwoolhoko nkawaanukha chinene ata attu o Umisri khayonrie uwuria maashi aya. Ilhapo yonkhaye nkayaachara iphome. <verse eid="EXO 7:21" /><verse number="22" style="v" sid="EXO 7:22" />Nansho akhwiri o Umisri wo ukhwiri aya ahopangacha thoko chiicho. Paahi etu nrima u Nafarao nkawaathepa ulhipa, ni mena khayewelhenlhe ashinna Musa ni Naharuni, nkayaakhalha thoko Apwiiya Nlhuku chenre aya wo uhimia. <verse eid="EXO 7:22" /><verse number="23" style="v" sid="EXO 7:23" />Paahi, Nafarao nkayaahokolhia uwannyaya, wo uhilhoha chittu chaakumelhenlhe chiyo. <verse eid="EXO 7:23" /><verse number="24" style="v" sid="EXO 7:24" />Attu o Umisri onkhaye nkayaathipakacha vachereshere mwoolhoko wo Unaili wiira apatte maashi o uwuria, ukhalhawaya khayonrie uwuria maashi o mmwoolhokoni ayo.<verse eid="EXO 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 7:25" />Nkaavira mahuku saba, toka maashi o mwoolhoko wo Naili, vaathathuwilhe aya iphome.<verse eid="EXO 7:25" /></para>
  <chapter eid="EXO 7" />
  <chapter number="8" style="c" sid="EXO 8" />
  <para style="s1">Mariro o nayelhi: Amarapi</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 8:1" />Yamalheke Apwiiya Nlhuku nkayeerelha ashinna Musa, “Nrwee u Nafarao mwaahimerie Apwiiya Nlhuku aneera wiira, ‘Mwaahiyacheke attu aka athame wiira arwee akithimiche. <verse eid="EXO 8:1" /><verse number="2" style="v" sid="EXO 8:2" />Nansho mwakhotaka waahiyerera wiira athamache, paahi, kinowaawiha amarapi o utwarusha ilhapo inyu yonkhaye. <verse eid="EXO 8:2" /><verse number="3" style="v" sid="EXO 8:3" />Mwoolhoko wo Unaili unoochara amarapi, ni ayo anookelha mpaka unupani winyu, uchuumbani unorupa inyu, vankorini winyu, inupa cha anamitheko inyu olhupalhe ni attu inyu. Yayo amarapi ayo anookelha ata ukittu unoterekha inyu choolhia, ni nkereroni nnokandelha inyu iphepa. <verse eid="EXO 8:3" /><verse number="4" style="v" sid="EXO 8:4" />Amarapi anouwelhani mwiiruttuni mwinyu, mwiiruttuni mwa attu inyu ni mwiiruttuni mwa anamitheko inyu olhupalhe onkhaye!’ ”<verse eid="EXO 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 8:5" />Apwiiya Nlhuku nkayeerelha ashinna Musa tho, “Mwaahimerie Naharuni ookolhe moono aya atheshe ikopo aya vachulhu mwoolhoko, vachulhu mashepa ni vachulhu mathapwi. Ni amarapi ayo anookhumelhelha ni uwanelha kila vakittu mwiilhaponi Umisri.” <verse eid="EXO 8:5" /><verse number="6" style="v" sid="EXO 8:6" />Paahi Naharuni nkayaathesha ikopo aya vachulhu maashi onkhaye, amarapi nkayaakhumelhelha ni uwanelha ilhapo yonkhaye yo Umisri. <verse eid="EXO 8:6" /><verse number="7" style="v" sid="EXO 8:7" />Nansho akhwiri o Umisri wo ukhwiri aya ni ayo chiicho yahaawiiha amarapi mwiilhaponi Umisri.<verse eid="EXO 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 8:8" />Yamalheke Nafarao nkayeehana ashinna Musa ni Naharuni, nkayeerelha, “Mwaalhepelhe Apwiiya Nlhuku, wiira akithamihere mii ni attu aka amarapi ilha, ni mii kinowaahiya Aisraeli arwaache yakumihe isadaka wa Apwiiya Nlhuku.” <verse eid="EXO 8:8" /><verse number="9" style="v" sid="EXO 8:9" />Ashinna Musa nkayaakulha Nafarao, “Haya! Nkihimerieke etu ikatema inothanana inyu wiira kolhapelhelhekeni wa Nlhuku, kaalhepelhelhe anamitheko inyu olhupalhe ni attu inyu. Kinokowaalhepelha wiira, aalhakalhihe amarapi arii mmanupani mwinyu, ahalheke arii umwoolhokoni Unaili uwo tu!”<verse eid="EXO 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 8:10" />Nafarao nkayaakhulha, “Meelho.”</para>
  <para style="p" vid="EXO 8:10">Ashinna Musa ni ayo nkayeera, “Kinoopanga thoko chinre inyu wo wulhumacha chiyo, nchuwelhe wiira khaawo ntu riyoothe nolhikaana ni Apwiiya Nlhuku ihu. <verse eid="EXO 8:10" /><verse number="11" style="v" sid="EXO 8:11" />Amarapi anoothama unupani winyu, mmanupani mwa anamitheko inyu olhupalhe ni mmanupani mwa attu inyu. Anohalha ukhalha tu umwoolhokoni Unaili.”<verse eid="EXO 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 8:12" />Paahi, ashinna Musa ni Naharuni nkayaathama unupani u Nafarao, ni ashinna Musa nkayonlhelha Apwiiya Nlhuku wiira yaathamihe amarapi aawihilhe aya u Nafarao. <verse eid="EXO 8:12" /><verse number="13" style="v" sid="EXO 8:13" />Apwiiya Nlhuku nkayaapanga thoko chaalhepenlhe aya ashinna Musa. Amarapi ayo nkaakhwacha mmanupani, mmapuwani, ni mmamatani. <verse eid="EXO 8:13" /><verse number="14" style="v" sid="EXO 8:14" />Attu o Umisri nkayaakukhulhulhacha amarapi ayo mapuhe wo mapuhe, ilhapo yonkhaye nkayaanukha. <verse eid="EXO 8:14" /><verse number="15" style="v" sid="EXO 8:15" />Nansho Nafarao yooneke wiira amarapi ayo ahokhwacha, ahothepa itiyamaru tho, ni wala khayewelhenlhe ashinna Musa ni Naharuni thoko Apwiiya Nlhuku chenre aya wo uhimia.<verse eid="EXO 8:15" /></para>
  <para style="s1">Mariro o neraru: Ashimwettu o uhuviha</para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 8:16" />Yamalheke, Apwiiya Nlhuku nkayeerelha ashinna Musa, “Mwaahimerieke Naharuni ookolhe ikopo aya akhite vantukurukhuni, ninno ninoothathuwa ukhalha ashimwettu o uhuviha ilhapo yonkhaye yo Umisri.” <verse eid="EXO 8:16" /><verse number="17" style="v" sid="EXO 8:17" />Ashinna Musa ni Naharuni nkayaapanga chiicho. Naharuni ahookolha ikopo aya nkayaakhita vantukurukhuni, nkanaathathuwa ukhalha ashimwettu o uhuviha nkaawelhawelha attu ni ashinama. Ntukurukhu nonkhaye mwiilhaponi Umisri nkanaathathuwa ashimwettu o uhuviha. <verse eid="EXO 8:17" /><verse number="18" style="v" sid="EXO 8:18" />Akhwiri o Umisri, wo ukhwiri aya uyo, nkayaalhikacha uthathusha ntukurukhu nikhalhe ashimwettu o uhuviha, nansho khayorilhe. Ashimwettu o uhuviha ayo nkaawanelha mwaattuni ni mwa ashinama. <verse eid="EXO 8:18" /><verse number="19" style="v" sid="EXO 8:19" />Akhwiri alhe nkayeerelha Nafarao, “Ulha phi ntheko wo moono wa Nlhuku.” Nansho Nafarao nkaathepiha itiyamaru, mena khayewelhenlhe ashinna Musa ni Naharuni. Nkayaakhalha thoko Apwiiya Nlhuku chenre aya wo uhimia.<verse eid="EXO 8:19" /></para>
  <para style="s1">Mariro o necheshe: Iphepelhe</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 8:20" />Yamalheke, Apwiiya Nlhuku nkayeerelha ashinna Musa, “Meelho mpeherieke wichishuru nrweeke u Nafarao ikatema vanorwaa aya umwoolhokoni mwaahimerie wiira, Apwiiya Nlhuku aneera wiira, ‘Mwaahiyacheke attu aka athamache wiira arwee akithimiche. <verse eid="EXO 8:20" /><verse number="21" style="v" sid="EXO 8:21" />Mwakhotaka waahiyerera wiira arwaache, paahi, kinouwiiherani iphepelhe chinchi chuhuviheni, inyuva, anamitheko inyu olhupalhe ni attu inyu onkhaye. Anookelha mmanupani mwinyu ni inupa chonkhaye cha attu o Umisri. Iphepelhe chinchi chinoochara ilhapo yonkhaye yo Umisri. <verse eid="EXO 8:21" /><verse number="22" style="v" sid="EXO 8:22" />Nansho nenno nihuku nno ilhapo yo Gosheni unokhalha aya attu aka khinowa yaapatta nenno nihuviho nno. Wowo iphepelhe chiyo khachinowa chaakhalha. Vavawo phi nohalha inyu uchuwelha wiira mii Apwiiya Nlhuku kinoopanga chechiyo mwiilhaponi mwinyu. <verse eid="EXO 8:22" /><verse number="23" style="v" sid="EXO 8:23" />Kinowenanelha attu aka chittu chinohalha waapatta attu inyu. Yoyo mwaha wo ushangiha uyo unohalha upangia meelho.’ ” <verse eid="EXO 8:23" /><verse number="24" style="v" sid="EXO 8:24" />Apwiiya Nlhuku nkayaapanga thoko chaahimmie aya. Iphepelhe chinchi chinene nkachaachara unupani u Nafarao, inupa cho anamitheko aya olhupalhe ni ilhapo yonkhaye yo Umisri. Ilhapo yonkhaye yo Umisri nkayaatanganyiya ni chechiyo iphepelhe chiyo. <verse eid="EXO 8:24" /><verse number="25" style="v" sid="EXO 8:25" />Paahi Nafarao nkeehana ashinna Musa ni Naharuni, nkayeerelha, “Nrweeke etu mwakumihe isadaka wa Nlhuku inyu, nansho ikhalheke momu mwiilhaponi Umisri mu.”<verse eid="EXO 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 8:26" />Nansho ashinna Musa nkayaakhulha, “Mena, khachinlhoka upanga chiicho, ukhalhawaya isadaka chinohalha ihu waavaha Apwiiya Nlhuku ihu, chinowaarusha attu o Umisri. Chani, attu o Umisri yanoonaka nikumihaka isadaka chinaarusha aya, ngati anonaata malhuku? <verse eid="EXO 8:26" /><verse number="27" style="v" sid="EXO 8:27" />Ninothananiya nirwee nkwaha wo mahuku mararu uthakoni, nakumihe isadaka wa Apwiiya Nlhuku ihu, thoko chinre aya wo unilhehera.”<verse eid="EXO 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 8:28" />Paahi Nafarao nkayeera, “Kinouhiyani nrwaacheke mwakumihe isadaka wa Apwiiya Nlhuku inyu, uthakoni. Nansho nhirwaache utayi chinene. Nkilhapelhelheke etu.”<verse eid="EXO 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 8:29" />Ashinna Musa nkayaakhulha, “Ikatema vanohalha aka uthama vawo, kinowalhepelha Apwiiya Nlhuku wiira milhoko cho iphepelhe chi chithame uwaninyu, wa anamitheko inyu olhupalhe ni wa attu inyu, meelho. Nansho inyuva nhinithepiache tho ni ukhota waahiyerera attu wiira arwaache yakumihe isadaka wa Apwiiya Nlhuku.”<verse eid="EXO 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 8:30" />Paahi, ashinna Musa nkayaathama unupani u Nafarao, nkayaalhepelha Apwiiya Nlhuku. <verse eid="EXO 8:30" /><verse number="31" style="v" sid="EXO 8:31" />Apwiiya Nlhuku nkayaapanga thoko chaalhepenlhe aya ashinna Musa, iphepelhe chilhe nkachaathama u Nafarao, wa anamitheko aya olhupalhe ni wa attu aya. Mena khayaahanlhe ata iphepelhe imoka. <verse eid="EXO 8:31" /><verse number="32" style="v" sid="EXO 8:32" />Nansho ata ulha nkwaha ulha Nafarao ahothepa itiyamaru, mena khaahiyerenre Aisraeli wiira athamache.<verse eid="EXO 8:32" /></para>
  <chapter eid="EXO 8" />
  <chapter number="9" style="c" sid="EXO 9" />
  <para style="s1">Mariro o nethanu: Ukhwaacha mihuwo</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 9:1" />Yamalheke, Apwiiya Nlhuku nkayeerelha ashinna Musa wiira, “Nrwee u Nafarao mwaahimerie wiira mii Apwiiya Nlhuku, Nlhuku a Aebraniya, kineera, ‘Mwaahiyerere attu aka athamache wiira arwee akithimiche. <verse eid="EXO 9:1" /><verse number="2" style="v" sid="EXO 9:2" />Mwakhotaka waahiyerera arwaache, ni mwathepaka waavarelhelha, <verse eid="EXO 9:2" /><verse number="3" style="v" sid="EXO 9:3" />kinowookolha moono aka ni uwiiha mareta o uhilhoka chinene mmihuwoni mwinyu mwonkhaye, ing'ope, ifarasi, iphuta, ingamiya, ipuri ni ikhondoro. <verse eid="EXO 9:3" /><verse number="4" style="v" sid="EXO 9:4" />Tho, kinomianiha mihuwo cha Aisraeli ni mihuwo cha attu o Umisri wiira mwannama ata mmoka a Aisraeli hikhwe.’ ” <verse eid="EXO 9:4" /><verse number="5" style="v" sid="EXO 9:5" />Apwiiya Nlhuku nkayaaromolha ikatema, nkayeera, “Meelho, kinoopanga yoyo ntheko uyo mwiilhaponi Umisri.”<verse eid="EXO 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 9:6" />Waashelhe waya Apwiiya Nlhuku nkayaapanga thoko chaahimmie aya. Mihuwo chonkhaye cha attu o Umisri chahokhwacha, nansho khaawo mwannama ata mmoka a Aisraeli akhwilhe. <verse eid="EXO 9:6" /><verse number="7" style="v" sid="EXO 9:7" />Nafarao nkaakoherera ittu ikhumelhenlhe wo mihuwo cha Aisraeli, nkayeerelhiya wiira khaawo ata mwannama aya mmoka khwilhe. Inakhalhaka chiicho, Nafarao nkayaahalha ni ulhipa waya nrima, mena khahiyerenre Aisraeli wiira athamache.<verse eid="EXO 9:7" /></para>
  <para style="s1">Mariro o sita: Analhipwe</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 9:8" />Yamalheke, Apwiiya Nlhuku nkayeerelha ashinna Musa ni Naharuni wiira, “Kila mmoka inyu akusheke itura yo vantanuruni vanopaheriya ichokaa, munthathani mwawe. Ni ashinna Musa amwarusheke itura iyo uchulhu umihoolho wa Nafarao. <verse eid="EXO 9:8" /><verse number="9" style="v" sid="EXO 9:9" />Itura iyo inookhalha ntukurukhu ninohalha uwanelha vachulhu ilhapo yonkhaye yo Umisri. Ni uwiiha analhipwe anohalha uphulhia ni waahelha makhwata attu ni ashinama kila vakittu Umisri.” <verse eid="EXO 9:9" /><verse number="10" style="v" sid="EXO 9:10" />Paahi, oyelhi nkayaakusha itura yo vantanuruni mmathathani mwaya. Nkayaarwa u Nafarao, ni ashinna Musa nkayaamwarusha uchulhu. Analhipwe nkaakhuma ni uphulhia ukhalha makhwata o uweria wa attu ni wa ashinama. <verse eid="EXO 9:10" /><verse number="11" style="v" sid="EXO 9:11" />Attu ni ashinama nkayaakhuma analhipwe ata ni akhwiri alhe khayonrie weemelha umihoolho wa ashinna Musa ni uvingana. Ukhalhawaya ni ayo vamoka ni attu o Umisri onkhaye yahaakhuma yayo analhipwe ayo. <verse eid="EXO 9:11" /><verse number="12" style="v" sid="EXO 9:12" />Nansho Apwiiya Nlhuku nkayaathepiha itiyamaru Nafarao, ni ayo khayeewelhenlhe ashinna Musa ni Naharuni thoko Apwiiya Nlhuku chenre aya wo uhimia.<verse eid="EXO 9:12" /></para>
  <para style="s1">Mariro o saba: Ipulha yo malhuku</para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 9:13" />Yamalheke, Apwiiya Nlhuku nkayeerelha ashinna Musa, “Meelho munkwe wichishuru mwaarwelhe Nafarao, mwaahimerie wiira mii Apwiiya Nlhuku, Nlhuku a Aebraniya, kineera cho, ‘Mwaahiye attu aka athame wiira arwee akithimiche. <verse eid="EXO 9:13" /><verse number="14" style="v" sid="EXO 9:14" />Ukhalhawaya ulha nkwaha ulha kinowiiha mariro molhupalhe uwannyu, ni wa anamitheko inyu, ni wa attu inyu. Ni inyu nnochuwelha wiira khaawo ata mmoka nolhikaana ni mii mwiilhaponi mwonkhaye. <verse eid="EXO 9:14" /><verse number="15" style="v" sid="EXO 9:15" />Yakaari kahookolha moono aka, ni uwaatani inyuva ni attu inyu wo mareta, mwanlhakalhihiya. <verse eid="EXO 9:15" /><verse number="16" style="v" sid="EXO 9:16" />Nansho, phi nlhatu no uhiyani nkhalhe akumi wiira kuwooniheni wooria waka, tho wiira nchina naka nichuwanie mwiilhaponi mwonkhaye. <verse eid="EXO 9:16" /><verse number="17" style="v" sid="EXO 9:17" />Nansho inyu, nnoothepa wooniha itiyamaru wa attu aka, ni wala khannaahiyerera wiira arwaache. <verse eid="EXO 9:17" /><verse number="18" style="v" sid="EXO 9:18" />Paahi etu meelho ikatema thoko yelha, kinoorupiha ipulha yulhupalhe yo malhuku, ihinapacha woonia wiilhaponi Umisri uno toka mapachero mpaka nna. <verse eid="EXO 9:18" /><verse number="19" style="v" sid="EXO 9:19" />Paahi vano mwaarumeke attu akurumiche wiira mihuwo chinyu ni kila ittu iri mmamatani, chithokoreriye rata. Ukhalhawaya ipulha yo malhuku inonrupelha kila ntu, ni ntu riyoothe hirii vawani ni chittu chiyo chinookhwacha.’ ”<verse eid="EXO 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 9:20" />Anamitheko akina a Nafarao veewilhe aya malhove a Apwiiya Nlhuku ayo yahoovacha, nkayaahokolhoshacha ipotta chaya ni ashinama aya vawani ni waatteelha mpaani. <verse eid="EXO 9:20" /><verse number="21" style="v" sid="EXO 9:21" />Nansho ntu ahewelhenlhe nlhove na Apwiiya Nlhuku, ahaahiyacha ipotta ni ashinama aya voonene mmamatani.<verse eid="EXO 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 9:22" />Apwiiya Nlhuku nkayeerelha ashinna Musa, “Ntheeshe moono inyu wiirimu, irupe ipulha yo malhuku, irupe kila vakittu mwiilhaponi Umisri. Yaarupelhe attu, ashinama, ni vachulhu mikoko chonkhaye cho umamatani.” <verse eid="EXO 9:22" /><verse number="23" style="v" sid="EXO 9:23" />Paahi ashinna Musa nkayaathesha moono aya wiirimu. Apwiiya Nlhuku nkayaawiiha ipulha yo malhuku ni ithari ni mooro nkawaaverunya vachulhu ilhapo. Apwiiya Nlhuku nkayaarupiha ipulha yo malhuku vachulhu ilhapo yonkhaye yo Umisri. <verse eid="EXO 9:23" /><verse number="24" style="v" sid="EXO 9:24" />Ipulha yo malhuku vaarupa aya vawo, ithari yahoritima, ni mooro nkawaawulhuwa velhaponi. Mena khayaari ni malhikaaniho o yeyo ipulha iyo ilhapo yonkhaye yo Umisri toka wuupiya wo ilhapo. <verse eid="EXO 9:24" /><verse number="25" style="v" sid="EXO 9:25" />Ipulha yo malhuku iyo yahotanganya kila yaariwo mmamatani, yaheeva attu ni ashinama ilhapo yonkhaye yo Umisri. Malhuku o ipulha iyo yahontha kila nkoko ni wunthakacha kila mwiri mmamatani. <verse eid="EXO 9:25" /><verse number="26" style="v" sid="EXO 9:26" />Yeyo ipulha iyo yahorupa ilhapo yonkhaye yo Umisri, yaahikhalhe Ugosheni waakhalha aya Aisraeli. Wowo khayaarumpe ipulha yo malhuku iyo.<verse eid="EXO 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 9:27" />Nafarao nkaaruma attu yeehane ashinna Musa ni Naharuni, nkaahimeria wiira, “Ulha nkwaha ulha, mii kihotteka. Apwiiya Nlhuku ahanaa ikekhia, mii ni attu aka nihotteka. <verse eid="EXO 9:27" /><verse number="28" style="v" sid="EXO 9:28" />Mwaalhepelheke Apwiiya Nlhuku, ukhalhawaya ithari cho uritima chi ni ipulha yo malhuku ilha chihothepa. Mii kinouhiyererani mwaatti nrwaacheke, nhilhokelhe chinene tho.”<verse eid="EXO 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 9:29" />Ashinna Musa nkayaakhulha, “Phiyaru tu vanohalha aka ukhuma vawani va, kinoothesha miono chaka ni waalhepelha Apwiiya Nlhuku. Ithari chiyo chinoomaalha, ni ipulha yo malhuku iyo inoohiya urupa, nchuwelhe wiira ilhapo ilha yonkhaye ya Apwiiya Nlhuku. <verse eid="EXO 9:29" /><verse number="30" style="v" sid="EXO 9:30" />Nansho kihochuwelha wiira inyuva ni anamitheko inyu olhupalhe, bado khannaarumelhelha Apwiiya Nlhuku.”<verse eid="EXO 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 9:31" />Ipulha yo malhuku yaarupilhe iyo yahotanganyacha choolhia chonkhaye, ni mikoko cho nttoche nooteelha. Ukhalhawaya choolhia chaari chinakhomanlhe ni yoteelha chaari chinatuvilhe. <verse eid="EXO 9:31" /><verse number="32" style="v" sid="EXO 9:32" />Nansho ingaano ni choolhia chikina khacheetettiye, ukhalhawaya chaari chihinonnuwa.<verse eid="EXO 9:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 9:33" />Paahi ashinna Musa ahothama u Nafarao, nkayaarwa uchereshere iwani. Yamalheke, ahothesha miono chaya waalhepelha Apwiiya Nlhuku. Ithari chilhe ni ipulha yo malhuku ilhe chahotondova, ipulha nkayaahiya urupa. <verse eid="EXO 9:33" /><verse number="34" style="v" sid="EXO 9:34" />Nansho Nafarao yooneke wiira ipulha yo malhuku ni ithari chihotondova, ahothepiha uwonya tho, nkayaathepa itiyamaru aya vamoka ni anamitheko aya olhupalhe. <verse eid="EXO 9:34" /><verse number="35" style="v" sid="EXO 9:35" />Paahi Nafarao ahothepa itiyamaru ni ukhota waahiyerera Aisraeli wiira athamache arwee, thoko Apwiiya Nlhuku cherenlhe aya ashinna Musa.<verse eid="EXO 9:35" /></para>
  <chapter eid="EXO 9" />
  <chapter number="10" style="c" sid="EXO 10" />
  <para style="s1">Mariro o nane: Nashombe</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 10:1" />Apwiiya Nlhuku nkayeerelha ashinna Musa, “Nrweeke u Nafarao, ukhalhawaya mii kihaathepiha itiyamaru, koonihe yayo vamoka ni anamitheko aya olhupalhe cho ushangiha cho woopiha munlhokoni mwaya, <verse eid="EXO 10:1" /><verse number="2" style="v" sid="EXO 10:2" />wiira ni inyu mmwe mwaahimiachera achishaana inyu ni ashichulhu inyu, chinre aka wo waapangelha mattepwa attu o Umisri, wo upanga chechiyo cho ushangiha cho woopiha chiyo munlhokoni mwaya. Vavawo nchuwelhe wiira, mii phi Apwiiya Nlhuku.”<verse eid="EXO 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 10:3" />Paahi ashinna Musa ni Naharuni ahorwaa u Nafarao, ni waahimeria wiira, “Apwiiya, Nlhuku a Aebraniya, aneera cho, ‘Chani! Nnohalha ukhota ukhalha makhalhelho oombone umihoolho waka mpaka iyaakhani? Mwaahiyerereke attu aka wiira arwaache akithimiche. <verse eid="EXO 10:3" /><verse number="4" style="v" sid="EXO 10:4" />Mwakhotaka waahiyerera attu aka ayo wiira arwaache, paahi meelho kinowaakurusha anashombe akhuruwe mwiilhaponi mwinyu. <verse eid="EXO 10:4" /><verse number="5" style="v" sid="EXO 10:5" />Ilhapo yonkhaye yo Umisri inookhunelhiya ni yayo anashombe ayo. Anoolhiacha kila ittu yookokwelhe ipulha yo malhuku ilhe, ni mena khanohiya nnyepu uriyoothe umenlhe mmamatani. <verse eid="EXO 10:5" /><verse number="6" style="v" sid="EXO 10:6" />Anashombe ayo anoocharacha unupani winyu, inupa cha anamitheko inyu olhupalhe, ni inupa cha attu o Umisri onkhaye. Anowinchiva wo uhikhalha ittu yo waalhikaaniha ata manyaathumwaninyu mena manyaathumwanaya, khayoonne toka uyaria waya mpaka nna.’ ” Paahi ashinna Musa nkayaathama u Nafarao.<verse eid="EXO 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 10:7" />Paahi anamitheko olhupalhe nkayaakoha Nafarao, “Yolha ntu ulha nohalha unihuviha mpaka iyaakhani? Mwaahiyerereke attu alha arwaache, yaathimiche Apwiiya Nlhuku, Nlhuku aya. Chani khannoona wiira, ilhapo yo Umisri inootanganyia?”<verse eid="EXO 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 10:8" />Vavawo ashinna Musa ni Naharuni nkayeehaniya wiira ahokolhie tho u Nafarao. Nafarao nkayeerelha, “Nrwaacheke etu mwathimiche Apwiiya Nlhuku inyu. Nansho kinokoha wiira, phi apani anohalha urwaa vamoka ni inyu mwaatti?”<verse eid="EXO 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 10:9" />Ashinna Musa nkayaakhulha, “Ninorwaa ni kila ntu, ashimirawo, ashulhupalhe, ni achishaana ihu ashilhopwana ni ashithiyana. Ninookusha ni ikhondoro chihu, ipuri chihu ni ingo'pe chihu, ukhalhawaya nihothananiya naapangelhe nihuku nulhupalhe Apwiiya Nlhuku.”<verse eid="EXO 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 10:10" />Nansho wo ncheche Nafarao nkayeera, “Apwiiya Nlhuku akhalhe vamoka ni inyu mwaatti, yakhalhaka kinouhiyani wiira nrwaache vamoka manyaahanu inyu ni achishaana inyu. Ukhalhawaya wo ikekhiaye minikwa chinyu khachiri choombone, wiira nhihokolhie tho. <verse eid="EXO 10:10" /><verse number="11" style="v" sid="EXO 10:11" />Mena khinokhalha chiicho! Manyaalhopwana vekha aya phi nohalha urwaa uwaathimichani Apwiiya Nlhuku, ukhalhawaya nenno phi nlhove naathanana inyu.” Vavawo ashinna Musa ni Naharuni yahoomolhiya athame umihoolho u Nafarao.<verse eid="EXO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 10:12" />Apwiiya Nlhuku nkayeerelha ashinna Musa, “Ntheesheke moono inyu vachulhu ilhapo yo Umisri, anashombe akhuruwe vachulhu ilhapo yo Umisri, alhie mikoko chonkhaye vachulhu ilhapo, yaani chonkhaye chaahalhakalhihiye ni ipulha yo malhuku ilhe.”<verse eid="EXO 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 10:13" />Paahi ashinna Musa ahothesha ikopo aya vachulhu ilhapo yo Umisri. Apwiiya Nlhuku nkayaawukiha iphioo ukhuma unosha nchuwa uthana ni uhiyu wonkhaye. Waashelhe waya iphioo ilhe nkayaakurusha anashombe. <verse eid="EXO 10:13" /><verse number="14" style="v" sid="EXO 10:14" />Ni anashombe nkayaakhuruwa ni uwanelha kila vakittu ilhapo yonkhaye yo Umisri. Yaari enchi chinene, ahinapacha ukhalha thoko yayo ikatema ivinre mena khanowa yaakhumelhelha thoko yayo tho. <verse eid="EXO 10:14" /><verse number="15" style="v" sid="EXO 10:15" />Ahokhuneelha ilhapo yonkhaye yo Umisri, ata khiiwo ittu yoonia, nkawaakhalha ipiphi ilhapo yonkhaye. Nkayaalhia minyepu chonkhaye cho velhaponi, ni maphepu onkhaye o miri yahalhenlhe baada yo ipulha yo malhuku ilhe. Khanahalhenlhe ata nthakhuru nimoka, mena mwiri ama nkoko wo mmamatani ilhapo yonkhaye yo Umisri. <verse eid="EXO 10:15" /><verse number="16" style="v" sid="EXO 10:16" />Paahi Nafarao wo uhipicha, aheehana ashinna Musa ni Naharuni nkayeera, “Kihaapangelha mwo uhilhoka Apwiiya Nlhuku inyu ni inyu mwaattiva chiicho. <verse eid="EXO 10:16" /><verse number="17" style="v" sid="EXO 10:17" />Paahi vano, kinoulhepelhani wiira, nkilhevelhelhe uwonya waka ulha nkwaha mmoka ulha tu, nkilhapelhelheke wa Apwiiya Nlhuku inyu, anthamihe nookhwa ulha uwannyaka.”<verse eid="EXO 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 10:18" />Ashinna Musa nkayaathama u Nafarao, nkayaarwa uwalhepelhani Apwiiya Nlhuku. <verse eid="EXO 10:18" /><verse number="19" style="v" sid="EXO 10:19" />Apwiiya Nlhuku nkayaawukiha iphioo yo machiri menchi uneelha nchuwa, nkayaathamiha anashombe alhe ni waarihelha ibahari yo Shamu. Khaahalhenlhe ata nashombe mmoka mwiilhaponi mwonkhaye Umisri. <verse eid="EXO 10:19" /><verse number="20" style="v" sid="EXO 10:20" />Nansho Apwiiya Nlhuku ahaathepiha itiyamaru Nafarao, ni ayo khaahiyerenre Aisraeli wiira arwaache.<verse eid="EXO 10:20" /></para>
  <para style="s1">Mariro o tisa: Ipiphi</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 10:21" />Apwiiya Nlhuku nkayeerelha ashinna Musa, “Ntheeshe moono inyu wiirimu, ipiphi yulhupalhe ikhalhe vachulhu ilhapo yo Umisri, attu yaapapelhe mwiipiphini.” <verse eid="EXO 10:21" /><verse number="22" style="v" sid="EXO 10:22" />Paahi ashinna Musa nkayaathesha moono aya wiirimu, nkayaakhalha ipiphi totoro ilhapo yonkhaye yo Umisri wo mahuku mararu. <verse eid="EXO 10:22" /><verse number="23" style="v" sid="EXO 10:23" />Attu khayoonrie woonana ntu ni nkhunanawe, mena uthama ntu vakitu vaaria awe wo mahuku mararu. Nansho Ugosheni, waakhalha aya Aisraeli, waari nkwee, wo uhikhalha ipiphi.<verse eid="EXO 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 10:24" />Yamalheke, Nafarao aheehana ashinna Musa, ni waahimeria wiira, “Haya, nrwaacheke, mwaathimicheke Apwiiya Nlhuku. Ata achishaana inyu ayo mwaattukaneke. Nansho ikhondoro, ipuri ni ing'ope chinyu chiyo, chechiyo nhiyeke.”<verse eid="EXO 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 10:25" />Nansho ashinna Musa nkayeera, “Nnihiyeke naakusheke etu ashinama o waakumiha isadaka yo upahiya naahithe, wiira naakumihe isadaka wa Apwiiya Nlhuku ihu. <verse eid="EXO 10:25" /><verse number="26" style="v" sid="EXO 10:26" />Ninookusha ni mikutiro cho ing'ope chihu, khanohalha ata mwannama mmoka utulhi, ukhalhawaya wo mihuwo chihu chiyo phi nohalha ihu waavaha isadaka Apwiiya Nlhuku ihu. Ni mena khanichuwenlhe mwannama ani ninohalha ihu unkumiha isadaka, mpaka vanohalha ihu uphiya wowo.”<verse eid="EXO 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 10:27" />Nansho Apwiiya Nlhuku nkayaathepiha itiyamaru Nafarao, ahittune waahiyerera wiira arwaache. <verse eid="EXO 10:27" /><verse number="28" style="v" sid="EXO 10:28" />Nafarao nkayeerelha ashinna Musa, “Nthameke umihoolho waka etu! Mwiishungeke rata, nhikoone tho, ukhalhawaya nenno nihuku ninohalha inyu ukoona nno, nnookhwa!”<verse eid="EXO 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 10:29" />Ashinna Musa nkayaakhulha, “Eiyo, nholhumacha rata! Ukhalhawaya akinowa umihoolho winyu tho.”<verse eid="EXO 10:29" /></para>
  <chapter eid="EXO 10" />
  <chapter number="11" style="c" sid="EXO 11" />
  <para style="s1">Mariro o khumi: Wiiviya wa achishaana o nttara</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 11:1" />Yamalheke Apwiiya Nlhuku nkayeerelha ashinna Musa, “Ahohalha mariro nkwaha mmoka, anohalha aka waawiihera Nafarao ni attu o ilhapo yo Umisri. Yamalhaka vavawo, anouhiyani mwaattiva wiira nthame wono. Ni ayo anowa uwoomolhani nthame nhihokolhie tho. <verse eid="EXO 11:1" /><verse number="2" style="v" sid="EXO 11:2" />Mweerelheke etu Aisraeli ayo wiira, yiiweke rata, kila mmoka aya, nlhopwana wo nthiyana, alhepelheke wa amwaatamana awe, chittu chikooroshiye wo isiliva ni wo idhahabu.” <verse eid="EXO 11:2" /><verse number="3" style="v" sid="EXO 11:3" />Apwiiya Nlhuku nkayaavahera Aisraeli uttuniya umihoolho wa attu o Umisri. Uthepa yayo, ashinna Musa ahokhalha ntu o uchuwania chinene ilhapo yo Umisri yonkhaye, ni umihoolho wa anamitheko olhupalhe a Nafarao, ni wa attu onkhaye.<verse eid="EXO 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 11:4" />Yamalheke, ashinna Musa nkayeerelha Nafarao, “Apwiiya Nlhuku aneera cho, ‘Uhiyu iriyari wo lhelho, mii kinovira variyari ilhapo yo Umisri. <verse eid="EXO 11:4" /><verse number="5" style="v" sid="EXO 11:5" />Vanohalha aka uvira vawo, kila mwaana o nttara Mmisri mu nookhwa. Toka nttara ninyu Nafarao nohalha inyu unhiyera umwene, mpaka mwaana o nttara a namitheko inyu nthiyana novara ntheko wo ushilhelhani yolhia chinyu. Ata mattara a ashinama inyu ni ayo onkhaye anookhwaacha. <verse eid="EXO 11:5" /><verse number="6" style="v" sid="EXO 11:6" />Vanowa ukhalha ikutto yulhupalhe ilhapo yonkhaye yo Umisri, ihinapacha ukhumelhelha ni mena khinowa yaakhumelhelha tho. <verse eid="EXO 11:6" /><verse number="7" style="v" sid="EXO 11:7" />Nansho munlhokoni mwa Aisraeli khaawo ata mwalhapwa nohalha ukhuwelhelha, mena ashinama aya, nchuwelhe wiira mii Apwiiya Nlhuku kinowamwalhaaniha attu o Umisri ni Aisraeli.’ ” <verse eid="EXO 11:7" /><verse number="8" style="v" sid="EXO 11:8" />Ashinna Musa nkayaamalhihera waahimeria Nafarao wo wiira, “Tho, anamitheko inyu alha onkhaye anoowa ni ukooromelha mii, yiiraka wiira kithame mwiilhaponi Umisri uno, mii vamoka ni attu onkhaye anokittwara.” Yamalheke, ashinna Musa uno anarushiye, ahothama u Nafarao uwo.<verse eid="EXO 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 11:9" />Yamalheke, Apwiiya Nlhuku nkayeerelha ashinna Musa, “Nafarao khanowiwelhelhani, wiira cho ushangiha cho woopiha chaka chithepeke upangia mwiilhaponi Umisri.” <verse eid="EXO 11:9" /><verse number="10" style="v" sid="EXO 11:10" />Paahi ashinna Musa ni Naharuni yahopanga cho ushangiha chonkhaye chiyo umihoolho u Nafarao. Nansho Apwiiya Nlhuku ahaathepiha Nafarao itiyamaru aya iyo, nkayaakhota waahiyerera Aisraeli wiira athamache wiilhaponi waya uwo.<verse eid="EXO 11:10" /></para>
  <chapter eid="EXO 11" />
  <chapter number="12" style="c" sid="EXO 12" />
  <para style="s1">Aisraeli anowoopolhiya wo iphome</para>
  <para style="r">(<ref loc="DEU 16:1-8">Itor 16:1-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 12:1" />Apwiiya Nlhuku nkayeerelha ashinna Musa ni Naharuni, vaari aya Umisri wiira, <verse eid="EXO 12:1" /><verse number="2" style="v" sid="EXO 12:2" />“Ulha mweeri ulha phi nohalha ukhalha mweeri wo upacha wo kila iyaakha uwannyu. <verse eid="EXO 12:2" /><verse number="3" style="v" sid="EXO 12:3" />Mwaahimerieke attu onkhaye o Israeli wiira, vanolhoha aya uphiya nihuku no khumi no ulha mweeri ulha wiira, kila mmoka ankusheke mwaakhondoro mmoka ama mwaapuri wo kila inupa. <verse eid="EXO 12:3" /><verse number="4" style="v" sid="EXO 12:4" />Yakhalhaka iwani iyo ikaani chinene mena ihinoria aya umalhiha ikhondoro imoka, ikavihaneke ni amwaatamana aya ulhikaana chiri aya attu ayo. Munthanlheke mwannama nohalha inyu wooria kila ntu ukhura ni umalhiha inama awe. <verse eid="EXO 12:4" /><verse number="5" style="v" sid="EXO 12:5" />Munthanlheke mwaakhondoro ama ipuri. Ni uyo akhalheke n'dume ni o iyaakha imoka, hikhalhe oremara vakittu variyoothe. <verse eid="EXO 12:5" /><verse number="6" style="v" sid="EXO 12:6" />Munshungeke rata yoyo mwannama uyo mpaka nihuku no khumi ni ncheshe no ulha mweeri ulha. Nenno nihuku nno, nlhoko wonkhaye wo Aisraeli aahitheke ashinama ayo uchechilho. <verse eid="EXO 12:6" /><verse number="7" style="v" sid="EXO 12:7" />Yamalhaka, attu akusheke iphome ya ashinama ayo ni uhikahika miimo ni vachulhu mikhora chonkhaye cho kila inupa chinohalha aya ukhurelhiya yayo ashinama ayo. <verse eid="EXO 12:7" /><verse number="8" style="v" sid="EXO 12:8" />Yoyo uhiyu uyo, inama iyo yooshiyeke, ikhuriyeke ni nkatte wo uhihelhiya ihengedure ni mathapa o mathaakhuru o waawa. <verse eid="EXO 12:8" /><verse number="9" style="v" sid="EXO 12:9" />Nhikhuure inari ikithi ama inaapeiye ni maashi. Nansho yooshiyeke yonkhaye, vamoka ni muru, mweto ni inama cho mmirimani. <verse eid="EXO 12:9" /><verse number="10" style="v" sid="EXO 12:10" />Chiicho etu tho, nhishunge mmithe inama iriyoothe mpaka wichishu. Inama iriyoothe inohalha mpaka wichishu yeyo ipahiyeke mooro. <verse eid="EXO 12:10" /><verse number="11" style="v" sid="EXO 12:11" />Ni cho phi nohalha inyu ukhura inama iyo. Nlhieke nneettukilhe mishipi nnyununi mwinyu, nnawanre iratu chinyu ni uvarelha ikopo chinyu mmathathani, tayari wo nkwaha. Tho nkhureke wo waakuvihacha. Yeyo phi nihuku nulhupalhe no Pasaka a Apwiiya Nlhuku.<verse eid="EXO 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 12:12" />“Yoyo uhiyu uyo, kinoovira vachulhu ilhapo yo Umisri ni uweevakacha achishaana o nttara ashilhopwana o Umisri, attu mpaka ashinama. Kinotwarusha milhuku chonkhaye cho attu o Umisri. Mii phi Apwiiya Nlhuku. <verse eid="EXO 12:12" /><verse number="13" style="v" sid="EXO 12:13" />Paahi iphome inohalha uhikiya mmilhakoni phi yo wooniha inupa chinohalha inyu ukhalhacha. Ni mii vanohalha aka woona yeyo iphome iyo, mwaattiva kinoupwahani, khannothuriya variwoothe ikatema vanohalha aka utwarusha ilhapo yo Umisri. <verse eid="EXO 12:13" /><verse number="14" style="v" sid="EXO 12:14" />Nenno nihuku nulhupalhe nno mmweeke mwoopuwelha wo ukithimicha mii Apwiiya Nlhuku. Yayo akhalheke malheheriyo o mahuku o uhimalha uwaninyu mwaatti, iyari ata iyari.”<verse eid="EXO 12:14" /></para>
  <para style="s1">Nihuku nulhupalhe no mikatte cho uhihelhiya ihengedure</para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 12:15" />Apwiiya Nlhuku nkayeera, “Wo mahuku saba, nhilhie mikatte cho uhelhiya ihengedure. Nihuku no upacha no mahuku saba ayo, nthamiheke ihengedure mmanupani mwinyu. Ntu riyoothe alhiaka ittu ihelhiye ihengedure nhina yayo mahuku saba ayo, yoyo athamihiyeke munlhokoni mwa Aisraeli. <verse eid="EXO 12:15" /><verse number="16" style="v" sid="EXO 12:16" />Nihuku no upacha ni nihuku no saba, nnookumaana mikutano mitakatifu cho ukithimicha mii, Apwiiya Nlhuku. Wo yayo mahuku meelhi ayo nhivare ntheko uriyoothe yaahikhalhe ntheko wo uterekhacha choolhia. <verse eid="EXO 12:16" /><verse number="17" style="v" sid="EXO 12:17" />Mmweeke mwaattapelhelha nna nihuku nulhupalhe no mikatte cho uhihelhiya ihengedure ilha, muupuwelhaka nihuku nothaminheakani mwaattiva, Aisraeli, mmikutironi ukhuma Umisri. Yeyo isikukuu iyo ittapelhelhiyeke ni iyari chinyu chonkhaye chinottwara, ukhalha phi malheheriyo o mahuku o uhimalha uwaninyu. <verse eid="EXO 12:17" /><verse number="18" style="v" sid="EXO 12:18" />Paahi, nlhieke mikatte cho uhihelhiya ihengedure toka uchechilho wo nihuku no khumi ni ncheshe no mweeri wo upacha, mpaka uchechilho wo nihuku no makhumi meelhi ni moka, no yoyo mweeri wo upacha uyo. <verse eid="EXO 12:18" /><verse number="19" style="v" sid="EXO 12:19" />Wo yayo mahuku saba ayo, nheeshe ihengedure mmanupani mwinyu. Ntu riyoothe, akhalhe nlheto mena nnenchi, alhiaka ittu ihelhiye ihengedure, noothamihiya munkutironi mwa Aisraeli. <verse eid="EXO 12:19" /><verse number="20" style="v" sid="EXO 12:20" />Nhilhie ittu iriyoothe ihelhiye ihengedure mmanupani mwinyu. Nlhieke tu mikatte cho uhihelhiya ihengedure yayo mahuku saba ayo.”<verse eid="EXO 12:20" /></para>
  <para style="s1">Pasaka o upachera</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 12:21" />Paahi, ashinna Musa nkayeehana ahoolhelhi onkhaye o Aisraeli, nkayaahimeria wiira, “Kila mmoka inyu anthanlheke mwaakhondoro ama mwaapuri wo ulhikaana ni attu arii unupani wawe, wo nlhatu no unhitha isikukuu yo Pasaka. <verse eid="EXO 12:21" /><verse number="22" style="v" sid="EXO 12:22" />Nkusheke mathaakhuru o hisopo, ni upapha mphomeni munsiniani, ni uhika vachulhu ni miimo chonkhaye miilhi cho milhako cho inupa chinyu. Ntu riyoothe hikhume vathe yoyo uhiyu uyo mpaka wichishu. <verse eid="EXO 12:22" /><verse number="23" style="v" sid="EXO 12:23" />Ukhalhawaya mii Apwiiya Nlhuku kinoovira ni weevakacha attu o Umisri. Nansho vanohalha aka woona iphome inahikiye vachulhu ni miimo cho inupa chinyu kinoopwaha, ni mena akinonhiyerera o wiiva akelhe mmanupani mwinyu ni uwiivani. <verse eid="EXO 12:23" /><verse number="24" style="v" sid="EXO 12:24" />Mvarechesheke nna nlhove nna mwaattiva ni iyari chinyu ukhalha phi malheheriyo o mahuku o uhimalha. <verse eid="EXO 12:24" /><verse number="25" style="v" sid="EXO 12:25" />Vanohalha inyu ukelha ilhapo inohalha aka uuvahani ilhe, thoko mii Apwiiya Nlhuku chenre aka wo ulheha, mmweke mwaapanga chiicho. <verse eid="EXO 12:25" /><verse number="26" style="v" sid="EXO 12:26" />Kila ikatema achishaana inyu vanohalha aya ukohani, ‘Nenna nlhove nna maana aya phi ishiyani?’ <verse eid="EXO 12:26" /><verse number="27" style="v" sid="EXO 12:27" />Mmweeke mweerelha wiira, ‘Ilha isadaka yo Pasaka yo waathimicha Apwiiya Nlhuku. Ukhalhawaya ahovira vachulhu inupa cha Aisraeli, Umisri. Ikatema veevilhe aya attu o Umisri, nansho hii ahoniinanelha, khaniivilhe.’ ”</para>
  <para style="p" vid="EXO 12:27">Aisraeli yahokhoromacha ni waathimicha Apwiiya Nlhuku. <verse eid="EXO 12:27" /><verse number="28" style="v" sid="EXO 12:28" />Yamalheke Aisraeli yahorwaacha, nkayaapangacha thoko Apwiiya Nlhuku chaalhehenre aya ashinna Musa ni Naharuni.<verse eid="EXO 12:28" /></para>
  <para style="s1">Mariro o khumi: Wiivakachiya mattara o Umisri</para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 12:29" />Uhiyu iriyari, Apwiiya Nlhuku ahevakacha mattara onkhaye o Umisri. Achokholhaka wo mwaana o nttara a Nafarao, ohiyeriya umwene uyo, mpaka mattara a attu attukiye ujerani. Ata mattara a ashinama ni ayo yahokhwacha. <verse eid="EXO 12:29" /><verse number="30" style="v" sid="EXO 12:30" />Paahi uhiyu variyari, Nafarao ni anamitheko aya olhupalhe ni attu akina onkhaye o Umisri yahonkwacha. Nkawaanyuwa ikutto yulhupalhe ilhapo yonkhaye yo Umisri, ukhalhawaya khayaahanlhe inupa ata imoka yahaakhwilhe ntu.<verse eid="EXO 12:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 12:31" />Vavawo Nafarao nkayeehana ashinna Musa ni Naharuni, uhiyu yoyo yoyo, nkayeerelha wiira, “Munkwache! Nthamache! Nthamacheke, mwaattiva vamoka ni Aisraeli ayo, nrweeke mwaathimicheke Apwiiya Nlhuku thoko chinre inyu wo uhimia. <verse eid="EXO 12:31" /><verse number="32" style="v" sid="EXO 12:32" />Nkusheke mikutiro chinyu cho ikhondoro, ipuri ni ingope chinyu chiyo, nthamacheke. Tho, mwakilhapelhelheke ni mii ibarakha.”<verse eid="EXO 12:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 12:33" />Attu o Umisri nkayoomolhacha Aisraeli wiira athamache chitema, yiirachaka, “Wo ikekhiaye mwaahithameke, ninookhwaacha onkhaye!” <verse eid="EXO 12:33" /><verse number="34" style="v" sid="EXO 12:34" />Paahi Aisraeli nkayaakusha iphepa aya yaakandiye ihinaya uhelhiya ihengedure, ni inyipo chaya cho ukandelha anattukanche nkuwoni ni ukusha vamakhathani. <verse eid="EXO 12:34" /><verse number="35" style="v" sid="EXO 12:35" />Aisraeli yaari anapangilhe thoko chaahimeriye aya ni ashinna Musa katashi vawo. Yahaalhepelha attu o Umisri yaavahe chittu chikooroshiye wo isiliva, ni idhahabu ni ikuwo. <verse eid="EXO 12:35" /><verse number="36" style="v" sid="EXO 12:36" />Apwiiya Nlhuku ni ayo yaari anaavahenre Aisraeli uttuniya ni attu o Umisri. Paahi attu o Umisri yahaavahacha Aisraeli kila ittu yaavekenlhe aya. Phi chiichammo Aisraeli chaathurulhanche aya attu o Umisri nhakhu aya.<verse eid="EXO 12:36" /></para>
  <para style="s1">Aisraeli anoottawacha Umisri</para>
  <para style="p">
    <verse number="37" style="v" sid="EXO 12:37" />Aisraeli yahothamacha Uramesesi, nkayeeta wo mieto urwa Usukothi. Yaari manyaalhopwana yaaphiyelha maelufu imia sita, wo uhaalhakelhiya manyaathiyana ni achishaana. <verse eid="EXO 12:37" /><verse number="38" style="v" sid="EXO 12:38" />Wahokhalha tho nkutiro nkina wa attu yaattukanne aya vamoka ni mihuwo chinchi, ikhondoro ni ing'ope. <verse eid="EXO 12:38" /><verse number="39" style="v" sid="EXO 12:39" />Vaari aya munkwahani, ahooshacha mikatte cho iphepa yaakandiye wo uhihelhiya ihengedure ilhe. Tho, ukhalhawaya yaathamilhe Umisri wo waakuvia, paahi khayaaterekhilhe choolhia cho ulhia munkwahani.<verse eid="EXO 12:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="EXO 12:40" />Aisraeli yaari anakhanlhe Umisri iyaakha imia ncheshe ni makhumi mararu. <verse eid="EXO 12:40" /><verse number="41" style="v" sid="EXO 12:41" />Nihuku no umalhelha iyaakha yo imia ncheshe ni makhumi mararu, phi nihuku Apwiiya Nlhuku naathamihilhe aya mahimo onkhaye a Aisraeli, ukhuma Umisri. <verse eid="EXO 12:41" /><verse number="42" style="v" sid="EXO 12:42" />Yoyo uhiyu Apwiiya Nlhuku waashelhelhihilhe aya wiira aathamihe Aisraeli Umisri uyo, uhokhalha wo wuupuwelhiya ni Aisraeli onkhaye ni iyari chaya chonkhaye wo mahuku o uhimalha. Ukhalha phi uhiyu wo Aisraeli ushelhelhiha wo nlhatu no waathimicha Apwiiya Nlhuku.<verse eid="EXO 12:42" /></para>
  <para style="s1">Malheheriyo o nihuku no Pasaka</para>
  <para style="p">
    <verse number="43" style="v" sid="EXO 12:43" />Yamalheke, Apwiiya Nlhuku aheerelha ashinna Musa ni Naharuni wiira, “Anottwara alha phi malheheriyo aka anaacha nihuku no Pasaka. Nlheto riyoothe hilhie yolhia yo Pasaka. <verse eid="EXO 12:43" /><verse number="44" style="v" sid="EXO 12:44" />Nansho ipotta iriyoothe muthumilhe inyu wo nchurukhu, yakhalhaka heenelhiya unyawo, yoyo ahiiyeke alhieke. <verse eid="EXO 12:44" /><verse number="45" style="v" sid="EXO 12:45" />Ntu riyoothe ri munkwahani, mena ntu o kibarua riyoothe, hilhie yeyo yolhia iyo. <verse eid="EXO 12:45" /><verse number="46" style="v" sid="EXO 12:46" />Inama yo mwaakhondoro o Pasaka ikhuriyeke inupa imoka waapeiye awe. Nhikumihe inama iriyoothe ukhuma inupa ihithiye awe yoyo mwannama uyo, mena nhipweshe ata nikhuva nimoka no mwannama o Pasaka uyo. <verse eid="EXO 12:46" /><verse number="47" style="v" sid="EXO 12:47" />Aisraeli onkhaye attapelhelheke yeyo isikukuu iyo. <verse eid="EXO 12:47" /><verse number="48" style="v" sid="EXO 12:48" />Nlheto riyoothe nokhalha vamoka ni inyu mwaattiva athananaka unlhia Pasaka unupani wawe, achokholheke weenelha unyawo manyaalhopwana onkhaye o unupani wawe. Vavawo nowaalhakelhelhiya thoko nnenchi ni uhiyereriya unlhia Pasaka. Nlhopwana riyoothe hiinelhiye unyawo hinlhie Pasaka mena. <verse eid="EXO 12:48" /><verse number="49" style="v" sid="EXO 12:49" />Malheheriyo yayo anonttuka Muisraeli nnenchi ayo, phi yayo anaattuka alheto anohalha ukhalha munlhokoni mwinyu.”<verse eid="EXO 12:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="EXO 12:50" />Aisraeli onkhaye yahorumelhelha yayo malheheriyo ayo nkayaapanga thoko Apwiiya Nlhuku chaalhehenre aya ashinna Musa ni Naharuni. <verse eid="EXO 12:50" /><verse number="51" style="v" sid="EXO 12:51" />Nenno nihuku nno, Apwiiya Nlhuku yahaathamiha mahimo onkhaye a Aisraeli ukhuma Umisri, mmikutironi mwaya.<verse eid="EXO 12:51" /></para>
  <chapter eid="EXO 12" />
  <chapter number="13" style="c" sid="EXO 13" />
  <para style="s1">Ukumihiya isadaka achishaana o nttara</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 13:1" />Apwiiya Nlhuku yaheerelha ashinna Musa, <verse eid="EXO 13:1" /><verse number="2" style="v" sid="EXO 13:2" />“Mwaattukurieke achishaana ashilhopwana o nttara onkhaye ukhalha awaka. Ukhalhawaya achishaana ashilhopwana o nttara a Aisraeli ni o kila mwannama awaka yayo.”<verse eid="EXO 13:2" /></para>
  <para style="s1">Isikukuu yo mikatte cho uhihelhiya ihengedure</para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 13:3" />Ashinna Musa nkayeerelha attu, “Muupuwelheke nenna nihuku nna! Nihuku nikhumilhe inyu Umisri waari inyu ipotta. Nna phi nihuku Apwiiya Nlhuku nokuminheayani wowo wo moono aya wo machiri. Nenna nihuku nna, nhilhie mena nkatte uhelhiye ihengedure. <verse eid="EXO 13:3" /><verse number="4" style="v" sid="EXO 13:4" />Nnoothama Umisri nna nihuku nna, no mweeri wo upacha wo mweeri wo Habibu. <verse eid="EXO 13:4" /><verse number="5" style="v" sid="EXO 13:5" />Apwiiya Nlhuku yahaalhupelhelha manyaapwiiya ihu wiira, anouvahani mwaattiva ilhapo yo Ukanaani, Uhiti, Uamori, Uhivi ni Uyebusi. Paahi vanohalha aya upihani wowo, ilhapo inorera ulhimiya ni uhuwelhiya mihuwo, mwoopuwelheke ilha isikukuu ilha kila iyaakha, mweeri wo upacha ulha. <verse eid="EXO 13:5" /><verse number="6" style="v" sid="EXO 13:6" />Wo mahuku saba nlhieke mikatte cho uhihelhiya ihengedure, ni nihuku no saba nno nikhalheke isikukuu yo waathimicha Apwiiya Nlhuku. <verse eid="EXO 13:6" /><verse number="7" style="v" sid="EXO 13:7" />Wo mahuku saba nhilhie mikatte cho uhelhiya ihengedure. Ni mena uhikhalhe mikatte cho uhelhiya ihengedure, mena ihengedure variwoothe munlhokoni mwinyu, ni mwiilhaponi mwinyu mwonkhaye. <verse eid="EXO 13:7" /><verse number="8" style="v" sid="EXO 13:8" />Nenno nihuku nno mwaahimerieke achishaana inyu wiira, nnopanga chiicho wo nlhatu no ittu yaapangilhe aya Apwiiya Nlhuku uwaninyu, vaathamilhe inyu ilhapo yo Umisri. <verse eid="EXO 13:8" /><verse number="9" style="v" sid="EXO 13:9" />Yeyo isikukuu iyo inowa ukhalha yo wuupuwelhiya, thoko nripwe uttukiye mmononi mwinyu ama vayuchi winyu, wiira muupuwelhe malheheriyo a Apwiiya Nlhuku, mahuku onkhaye. Ukhalhawaya, Apwiiya Nlhuku ahouthamihani Umisri wo moono aya wo machiri. <verse eid="EXO 13:9" /><verse number="10" style="v" sid="EXO 13:10" />Wo chiichammo etu, ntapelhelheke isikukuu ilha nihuku naya nithanlhiye, kila iyaakha.”<verse eid="EXO 13:10" /></para>
  <para style="s1">Mwaha unaacha achishaana o nttara</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 13:11" />Ashinna Musa nkayaathepa weerelha attu wiira, “Ni chiichammo etu, ikatema Apwiiya Nlhuku vanohalha aya upihani ilhapo yo Ukanaani ni uvahani ikhalhe yawinyu thoko chaalhupenlhe aya mwaattiva ni manyaapwiiya inyu, <verse eid="EXO 13:11" /><verse number="12" style="v" sid="EXO 13:12" />nnothananiya wiira mwaavaheke Apwiiya Nlhuku nlhipu wo kila mwaana inyu o nttara nlhopwana. Kila mwannama nlhopwana yarelhe o upacha mmihuwoni mwinyu nowa ukhalha a Apwiiya Nlhuku. <verse eid="EXO 13:12" /><verse number="13" style="v" sid="EXO 13:13" />Nansho iyari o upacha ilhopwana yo iphuta, nnoomopolha wo unlhiva mwaakhondoro, ama mwaahittuneke umwoopolha, mmuntheke ishiko. Kila mwaana mwanlhopwana o nttara, munlhokoni mwinyu, mmopolheke. <verse eid="EXO 13:13" /><verse number="14" style="v" sid="EXO 13:14" />Yakhalhaka mahuku anowa mwaamwaninyu noukohani, ‘Nenna nlhove nna maana aya ishiyani?’ Munhimerieke wiira, ‘Apwiiya Nlhuku ahonoopolha wo machiri o moono aya, ukhuma Umisri waari ihu ipotta. <verse eid="EXO 13:14" /><verse number="15" style="v" sid="EXO 13:15" />Nafarao wo itiyamaru aya ahokhota unihiyerera wiira nithame, wo chiichammo etu, Apwiiya Nlhuku ahomwiiva kila mwaana mwanlhopwana o nttara mwiilhaponi Umisri. Kila nttara no attu ama no ashinama. Paahi mii kinaavaha isadaka Apwiiya Nlhuku yo kila nttara nilhopwana no achishaana aka ni o mihuwo chaka. Nansho kila nttara nilhopwana munlhokoni mwa achishaana aka, yoyo kinoomwoopolha.’ <verse eid="EXO 13:15" /><verse number="16" style="v" sid="EXO 13:16" />Nna nlhove nna ninowa ukhalha thoko nripwe uttukiye mmononi mwinyu ama vayuchi winyu, wiira Apwiiya Nlhuku ahonithamiha Umisri wo moono aya wo machiri.”<verse eid="EXO 13:16" /></para>
  <para style="s1">Nlhuku nowaholhelha attu ukhuma Umisri</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 13:17" />Ikatema Nafarao vaahiyerenre aya Aisraeli wiira arwaache, Nlhuku khavirinhe ilhapo ya Afilisti, inakhalhaka yeyo yaari iphiro yo vakhiviru. Nlhuku enre, “Akinottuna wiira attu arukunushe mirima chaya ni uhokolhia Umisri, achuwelhaka wiira anoothananiya waatakana ikhoto.” <verse eid="EXO 13:17" /><verse number="18" style="v" sid="EXO 13:18" />Nansho Nlhuku ahaawelhiha Aisraeli iphiro yo urukureria aviraka uthakoni, alhukamaka ibahari yo Ushamu. Aisraeli yaathamme anari o chireru waatakana ikhoto.<verse eid="EXO 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 13:19" />Ashinna Musa ahokusha makhuva a Nayusufu alhe, thoko chaalhehenre aya Nayusufu ahinaya ukhwa. Ukhalhawaya ahaalhupelhiha Aisraeli yeeraka, “Nlhuku vanohalha awe uwa ni uthamihani wono, mmweeke mwaakusha makhuva aka ukhuma uno.”<verse eid="EXO 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 13:20" />Paahi Aisraeli yahothamacha Usukothi, nkayaamaka nipuro Uethamu, uchereshere uthako. <verse eid="EXO 13:20" /><verse number="21" style="v" sid="EXO 13:21" />Uthana Apwiiya Nlhuku ahaaholhelha nnihuteni mwaari thoko nihute norekama nooteelha, wooniha iphiro, ni uhiyu ahaaholhelha ni nipoto no mooro norekama naamwalhelha wiira yoorie weeta uthana ni uhiyu. <verse eid="EXO 13:21" /><verse number="22" style="v" sid="EXO 13:22" />Nipoto no urekama nne khanaathamme. Naari umihoolho waya ikatema yonkhaye, nihute nooteelha uthana ni ukhalha thoko mooro uhiyu.<verse eid="EXO 13:22" /></para>
  <chapter eid="EXO 13" />
  <chapter number="14" style="c" sid="EXO 14" />
  <para style="s1">Aisraeli anoolhapuwa ibahari yo Ushamu</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 14:1" />Yamalheke, Apwiiya Nlhuku nkayeerelha ashinna Musa, <verse eid="EXO 14:1" /><verse number="2" style="v" sid="EXO 14:2" />“Mwaahimerie Aisraeli ahokolhie utulhi, amakeke vakhiviru ni Pi Hahiroth, iriyari yo iwani yo Umigdoli ni ibahari yo Ushamu, mmihoolho wo Ubaal Sefon. Mweesheke nipuro umihoolho waya vakhiviru ni ibahari. <verse eid="EXO 14:2" /><verse number="3" style="v" sid="EXO 14:3" />Ukhalhawaya Nafarao anowuupuwelha wiira, ‘Aisraeli ayo anookukuriacha, ni uthako uyo uhaatiyelhelha ahoone iphiro yo ukhuma.’ <verse eid="EXO 14:3" /><verse number="4" style="v" sid="EXO 14:4" />Vavawo mii kinowoomiha nrima Nafarao, ni ayo anouttwarelhelhani. Ni mii kinoopatta nthimicho vanohalha aka waarimeelhiha yayo ni miphingo cho manyaasikari aya onkhaye. Vavawo attu o Umisri anowa uchuwelha wiira mii phi Apwiiya Nlhuku.” Paahi Aisraeli nkayaapanga thoko chaahimeriye aya chiyo.<verse eid="EXO 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 14:5" />Nafarao yeeweke wiira Aisraeli ahottawacha, paahi vamoka ni anamitheko aya olhupalhe yahorukunusha irusho chaya, nkayeera, “Nipanngeni etu wo waahiyerera Aisraeli athamache ahinipangelhe mitheko chihu tho?” <verse eid="EXO 14:5" /><verse number="6" style="v" sid="EXO 14:6" />Paahi Nafarao nkayeesha tayari mikukuta chaya cho upurulhiya ni ifarasi cho waatakanelha ikhoto ni miphingo chaya cho manyaasikari. <verse eid="EXO 14:6" /><verse number="7" style="v" sid="EXO 14:7" />Nkaakusha mikukuta chaya cho ulhama mia sita ni mikukuta chonkhaye chikina cho ikhoto cho Umisri, chiholhelhiyaka ni ahoolhelhi olhupalhe o manyaasikari ayo. <verse eid="EXO 14:7" /><verse number="8" style="v" sid="EXO 14:8" />Apwiiya Nlhuku nkayaathepiha itiyamaru Nafarao amwene o Umisri. Ni ayo nkayattwarelhelha Aisraeli yaathamme Umisri wo wiishipa. <verse eid="EXO 14:8" /><verse number="9" style="v" sid="EXO 14:9" />Attu o Umisri vamoka na afarasi aya onkhaye, mikukuta cha afarasi o ikhoto ni oweetiha afarasi aya nkayaattwara Aisraeli. Nkayaaphwanya anamakilhe nchereshere ibahari, vakhiviru ni Pi Hahirothi, mmihoolho wo Ubaal Sefon.<verse eid="EXO 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 14:10" />Aisraeli yaweheke ni woona Nafarao awaaka ni miphingo chaya utulhi waya, ahokelhiya woova chinene, nkayonlhelha Apwiiya Nlhuku wiira ookholhe. <verse eid="EXO 14:10" /><verse number="11" style="v" sid="EXO 14:11" />Nkayeerelha ashinna Musa, “Chani, khayaariwo mahiye othosha mwiilhaponi Umisri, mpaka nniwiihe nikhwelhe uno uthakoni uno? Veeshiyani unipangelha thoko cho, unithamiha wiilhaponi Umisri? <verse eid="EXO 14:11" /><verse number="12" style="v" sid="EXO 14:12" />Chani khanohimenrieni alha malhove alha vaari ihu nihinathama Umisri ulhe? Nowinrelheni wiira nnihiyeke nithepeke uvara ntheko wa attu o Umisri. Yaari nambaya waapangelha ntheko attu o Umisri kuliko ukhwelha uthakoni uno.”<verse eid="EXO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 14:13" />Ashinna Musa nkayaakhulha Aisraeli yeeraka, “Nhoove! Mwiilhipiheke! Lhelho nnowoona Apwiiya Nlhuku chinohalha aya uwookholhani. Ukhalhawaya alha attu o Umisri alha nnoona lhelho, khannoona tho. <verse eid="EXO 14:13" /><verse number="14" style="v" sid="EXO 14:14" />Apwiiya Nlhuku anowinkhelhani mwaattiva. Mmaalheke, nhipange ittu iriyoothe.”<verse eid="EXO 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 14:15" />Apwiiya Nlhuku nkayeerelha ashinna Musa “Nnokunlhelhani? Mwahimierieke Aisraeli athepeke urwaa mihoolho. <verse eid="EXO 14:15" /><verse number="16" style="v" sid="EXO 14:16" />Nkusheke ikopo inyu, ntheesheke vachulhu ibahari, ni maashi anoomiania uno ni uno. Ni Aisraeli anoolhapuwa iriyari yo ibahari vomilhe. <verse eid="EXO 14:16" /><verse number="17" style="v" sid="EXO 14:17" />Mii kinowaahelha itiyamaru attu o Umisri, ni ayo anouttwarani variyari ibahari, ni mii vavawo kinoopatta nthimicho wo nlhatu no waalhakalhiha Nafarao ni miphingo chaya, vamoka ni mikukuta chaya cho ikhoto ni oweetiha afarasi aya. <verse eid="EXO 14:17" /><verse number="18" style="v" sid="EXO 14:18" />Eiyo, kinoothimichiya wo waarimelhiha Nafarao ni manyaasikari aya. Ni attu o Umisri anoochuwelha wiira mii phi Apwiiya Nlhuku.”<verse eid="EXO 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 14:19" />Paahi nnepa wa Nlhuku, waari uhoolho wo nkutiro wa Aisraeli ahothama nkaakhalha utulhi waya. Ni nihute nne chiicho nahothama uhoolho nkaneemelha utulhi waya, <verse eid="EXO 14:19" /><verse number="20" style="v" sid="EXO 14:20" />nkanaakhalha iriyari yo Aisraeli ni attu o Umisri. Nihute nne nkanaakhunelha attu o Umisri wo ipiphi nansho nkanaamwalhelha Aisraeli uhiyu. Wo chiichammo etu mikutiro miilhi chiyo, u Nafarao ni nkutiro wa Aisraeli, khachaatamerianne uhiyu nkwee.<verse eid="EXO 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 14:21" />Ashinna Musa nkayookolha moono aya vachulhu ibahari, ni ayo Apwiiya Nlhuku nkayaakakha ibahari utulhi wo iphioo yo machiri yo ukhuma unosha nchuwa. Yeyo iphioo iyo yahowuka uhiyu nkwee, nkayaamianiha ibahari mipata miilhi uno ni uno, iriyari nkawaakhalha vo wuuma. <verse eid="EXO 14:21" /><verse number="22" style="v" sid="EXO 14:22" />Aisraeli nkayaaviracha variyari ibahari vakitu voomilhe vawo, maashi nkaakhalha thoko ishiri wiimonono ni wiimushi waya. <verse eid="EXO 14:22" /><verse number="23" style="v" sid="EXO 14:23" />Attu o Umisri yahaattwara wo uvira vowuuma iriyari yo ibahari vawo vamoka ni afarasi aya, mikukuta cho ikhoto ni oweetiha afarasi aya onkhaye. <verse eid="EXO 14:23" /><verse number="24" style="v" sid="EXO 14:24" />Mapikosha uhinaaya usha rata, Apwiiya Nlhuku nkayaaweha mphingo wa attu o Umisri ukhuma nipoto no mooro ni nipoto no nihute, nkayoopopiha chinene mphingo wa manyaasikari o Umisri uyo. <verse eid="EXO 14:24" /><verse number="25" style="v" sid="EXO 14:25" />Nkaaphariha magurudumu o mikukuta chaya, nkayeeta wo uhuvahuva chinene. Vavawo attu o Umisri nkayeeracha, “Apwiiya Nlhuku anowenkelha Aisraeli! Ngwee etu naattawe.”<verse eid="EXO 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 14:26" />Yamalheke Apwiiya Nlhuku nkayeerelha ashinna Musa, “Mwookolhe moono inyu vachulhu ibahari, maashi ahokolhie aakhunelhe attu o Umisri vamoka ni mikukuta chaya ni oweetiha afarasi aya.” <verse eid="EXO 14:26" /><verse number="27" style="v" sid="EXO 14:27" />Paahi ashinna Musa nkayookolha moono aya vachulhu ibahari. Ni vaasha nchuwa, ibahari yahohokolhia thoko chaari aya mpacho. Attu o Umisri nkayaalhikacha uttawa maashi ayo, nansho Apwiiya Nlhuku ahaakakhelhacha ubaharini. <verse eid="EXO 14:27" /><verse number="28" style="v" sid="EXO 14:28" />Maashi nkayaakhunelha mikukuta vamoka ni attu oweetiha afarasi alhe, nkutiro wonkhaye u Nafarao waattwarelhelha Aisraeli nkawaakhwa mbaharini. Mena khahanlhe ata Mmisri mmoka. <verse eid="EXO 14:28" /><verse number="29" style="v" sid="EXO 14:29" />Nansho Aisraeli ahovira variyari ibahari vakittu voomilhe, maashi aneemenlhe thoko ishiri mpata aya wo wiimonono ni wo wiimushi.<verse eid="EXO 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 14:30" />Phi chiichammo Apwiiya Nlhuku chooponlhe aya Aisraeli mmathathani mwa attu o Umisri. Ni ayo Aisraeli nkayoona attu o Umisri anarupanche vachengweni anakhwaachilhe. <verse eid="EXO 14:30" /><verse number="31" style="v" sid="EXO 14:31" />Aisraeli vonne aya nenno nlhove no ushangiha naapangiye ni Apwiiya Nlhuku wa attu o Umisri nno, yahaathimicha Apwiiya Nlhuku ni waarumelhelha. Nkayaakhalha ni nrima wa Apwiiya Nlhuku, tho ni wa ashinna Musa, namitheko aya.<verse eid="EXO 14:31" /></para>
  <chapter eid="EXO 14" />
  <chapter number="15" style="c" sid="EXO 15" />
  <para style="s1">Nchipo no ashinna Musa</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 15:1" />Vavawo ashinna Musa vamoka ni Aisraeli nkayeepelha Apwiiya Nlhuku nna nchipo nna,</para>
  <para style="q" vid="EXO 15:1">“Kinowiipa nchipo no waatotopelha Apwiiya Nlhuku ukhalhawaya ahaakottolha,</para>
  <para style="q" vid="EXO 15:1">afarasi ni oweetiha aya nkaakakhelha mbaharini.<verse eid="EXO 15:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="EXO 15:2" />Apwiiya Nlhuku phi machiri aka ni wooria waka,</para>
  <para style="q" vid="EXO 15:2">yayo anene phi kookhonlhe.</para>
  <para style="q" vid="EXO 15:2">Yayo phi Nlhuku aka, ni mii kinowaatotopelha.</para>
  <para style="q" vid="EXO 15:2">Yayo phi Nlhuku a athumwanaka ni mii kinowaathimicha.<verse eid="EXO 15:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="EXO 15:3" />Apwiiya Nlhuku phi o ukottolha ukhotoni,</para>
  <para style="q" vid="EXO 15:3">Apwiiya Nlhuku phi nchina naya.<verse eid="EXO 15:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="EXO 15:4" />Ahotumbucheriha mbaharini mikukuta ni miphingo chi Nafarao,</para>
  <para style="q" vid="EXO 15:4">anamitheko aya olhupalhe ahotitimira mbaharini Ushamu.<verse eid="EXO 15:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="EXO 15:5" />Maashi menchi ahaakhunelha,</para>
  <para style="q" vid="EXO 15:5">ahotitimira variyari ibahari thoko nlhuku.<verse eid="EXO 15:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="EXO 15:6" />Inyuva Apwiiya Nlhuku, moono inyu wo wiimonono uhochara machiri,</para>
  <para style="q" vid="EXO 15:6">uhaanyakathacha amalhaponi.<verse eid="EXO 15:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="EXO 15:7" />Wo wiinchiva ikuru yo umwene inyu nnowarimelhiha anouvengani ayo,</para>
  <para style="q" vid="EXO 15:7">iphumu yo urushiya winyu, ni iyo inowaapaha thoko chinopahiya aya mapuhe o mithaathi.<verse eid="EXO 15:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="EXO 15:8" />Mwahowuchelhelha wo iphumu inyu, maashi nkaachara,</para>
  <para style="q" vid="EXO 15:8">nkeemelha nchii thoko ishiri,</para>
  <para style="q" vid="EXO 15:8">maashi menchi variyari ibahari aholhipa.<verse eid="EXO 15:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="EXO 15:9" />Amalhaponi aheechiirelha, ‘Kinowaattwarwa ni waavara,</para>
  <para style="q" vid="EXO 15:9">kinookawaniha chittu chaya, kikushe chinothanana aka.</para>
  <para style="q" vid="EXO 15:9">Ninookumiha uphanga ihu,</para>
  <para style="q" vid="EXO 15:9">ninowarimelhiha wo moono ihu.’<verse eid="EXO 15:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="EXO 15:10" />Nansho inyuva mwahowuchelhelha iphioo inyu,</para>
  <para style="q" vid="EXO 15:10">ni ibahari nkayaakhunelha.</para>
  <para style="q" vid="EXO 15:10">Nkayaatitimira variyari maashi menchi thoko iyuuma.<verse eid="EXO 15:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="EXO 15:11" />Inyu Apwiiya Nlhuku,</para>
  <para style="q" vid="EXO 15:11">phi nlhuku ani nolhikaana ni inyu?</para>
  <para style="q" vid="EXO 15:11">Phi mpani rii ntakatifu mulhupalhe thoko inyu,</para>
  <para style="q" vid="EXO 15:11">nnoopiha wo mitheko chulhupalhe,</para>
  <para style="q" vid="EXO 15:11">nnopanga chittu cho ushangiha?<verse eid="EXO 15:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="EXO 15:12" />Vookonlhe inyu moono inyu wo wimonono, wo machiri,</para>
  <para style="q" vid="EXO 15:12">ilhapo yahaamiria amalhaponi ihu.<verse eid="EXO 15:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="EXO 15:13" />Nrima inyu woombone wahaaholhelha attu mwookholhe inyu,</para>
  <para style="q" vid="EXO 15:13">wo machiri inyu nnowaaholhelha urii ilhapo inyu itakatifu.<verse eid="EXO 15:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="EXO 15:14" />Attu o makosho makina aheewa yayo, nkayaatetemelha,</para>
  <para style="q" vid="EXO 15:14">attu anokhalha Ufilisti ahokelhiya ni woova.<verse eid="EXO 15:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="EXO 15:15" />Ashulhupalhe o Uedomu ahoshangacha,</para>
  <para style="q" vid="EXO 15:15">ahoolhelhi o Umoabu ahokelhiya woova chinene,</para>
  <para style="q" vid="EXO 15:15">attu onkhaye anokhalha Ukanaani ahothulhuwa mmakhuvani.<verse eid="EXO 15:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="EXO 15:16" />Woopopihiya ni woova uhaakelhelha.</para>
  <para style="q" vid="EXO 15:16">Wo nlhatu winchiva wo machiri inyu,</para>
  <para style="q" vid="EXO 15:16">yayo ahomaalhacha shiriri thoko nttupi,</para>
  <para style="q" vid="EXO 15:16">mpaka attu mwookhonlhe inyu, inyu Apwiiya Nlhuku, avire,</para>
  <para style="q" vid="EXO 15:16">eiyo, mpaka yayo attu mwookhonlhe inyu ayo amalheke uvira.<verse eid="EXO 15:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="EXO 15:17" />Inyuva nnowaarweha attu inyu umwaakoni winyu,</para>
  <para style="q" vid="EXO 15:17">uthanlhilhe inyu, inyu Apwiiya Nlhuku wiira vakhalhe phi mapuro inyu,</para>
  <para style="q" vid="EXO 15:17">vakittu vatakatifu vathekilhe inyu, inyu Apwiiya Nlhuku wo miono chinyu.<verse eid="EXO 15:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="EXO 15:18" />Inyuva Apwiiya Nlhuku,</para>
  <para style="q" vid="EXO 15:18">nnotawara ilhapo mahuku o uhimalha ni uhimalha.”<verse eid="EXO 15:18" /></para>
  <para style="s1">Nchipo ni Namiriyamu</para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 15:19" />Paahi afarasi a Nafarao ni mikukuta chaya vamoka ni oweetiha afarasi aya vaavinre aya vakittu vowuma mbaharini, Apwiiya Nlhuku ahohokolhosha maashi o ibahari nkayaakhunelha. Nansho Aisraeli ahothepa weeta vakittu voomilhe variyari ibahari.<verse eid="EXO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 15:20" />Paahi anamilhohi athiyana, Namiriamu, arokoraya Naharuni, ahonkusha chunchu, ni manyaathiyana akina onkhaye nkayaattwara anari ni achunchu aya yeenaka. <verse eid="EXO 15:20" /><verse number="21" style="v" sid="EXO 15:21" />Namiriamu nkaaholhelha wiipa yeeraka, “Mwepelheke nchipo Apwiiya Nlhuku ukhalhawaya ahokottolha chinene,</para>
  <para style="q" vid="EXO 15:21">nkaatumbucheriha mbaharini afarasi ni oweetiha afarasi aya.”<verse eid="EXO 15:21" /></para>
  <para style="s1">Maashi o uthumburia</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 15:22" />Yamalheke ashinna Musa ahaaholhelha Aisraeli ukhuma mbaharini Ushamu, nkayaarwa mpaka uthako wo Ushuri. Yaheeta wo mahuku mararu muuthakoni wo uhoona maashi vakittu variwoothe. <verse eid="EXO 15:22" /><verse number="23" style="v" sid="EXO 15:23" />Yaphiyeke vakittu vaneehaniya Mara khayonrie uwuria maashi o wowo ayo, ukhalhawaya aari o uthumburia. Phi nlhatu no wiihaniya vavawo Mara, maana aya “uthumburia.” <verse eid="EXO 15:23" /><verse number="24" style="v" sid="EXO 15:24" />Paahi attu onkhaye nkayonlhelha ashinna Musa yiiraka, “Vano ninohalha uwuriani?” <verse eid="EXO 15:24" /><verse number="25" style="v" sid="EXO 15:25" />Vavawo ashinna Musa nkayonlhelha Apwiiya Nlhuku, ni ayo nkayooniha ashinna Musa ithathu. Ni ashinna Musa nkayaathumbucheriha ithathu iyo mmaashini, maashi ayo nkaakhalha oririya.</para>
  <para style="p" vid="EXO 15:25">Wowo Nlhuku ahaavaha Aisraeli malhehero ni malheheriyo. Tho ahaalhikacha oone chinorumelhelha aya. <verse eid="EXO 15:25" /><verse number="26" style="v" sid="EXO 15:26" />Nkayeerelha, “Mwakirumelhelhaka rata, mii Apwiiya Nlhuku inyu, ni upanga arii moombone vamiithoni waka, ni uthimicha malheheriyo ni malhehero aka onkhaye, paahi mii akinowiiherani alha mareta yawihenre aka attu o Umisri. Ukhalhawaya mii phi Apwiiya Nlhuku kinoulhamihani mwaattiva.” <verse eid="EXO 15:26" /><verse number="27" style="v" sid="EXO 15:27" />Yamalheke Aisraeli ahophiya Uelimu waari marapo khumi ni meelhi ni miri cho mittende makhumi saba. Nkayaamaka vavawo vakhiviru ni maashi vawo.<verse eid="EXO 15:27" /></para>
  <chapter eid="EXO 15" />
  <chapter number="16" style="c" sid="EXO 16" />
  <para style="s1">Aisraeli anoovahiya imana ni ikhwalhi</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 16:1" />Nlhoko wonkhaye wa Aisraeli wahothama, nkayaaphiya uthako wo Usinai iriyari yo Uelimu ni Usinai. Ilha yaari nihuku no khumi ni nthanu mweeri wo nayelhi toka yathamekeru Umisri. <verse eid="EXO 16:1" /><verse number="2" style="v" sid="EXO 16:2" />Paahi Aisraeli onkhaye nkayonlhelha ashinna Musa ni Naharuni uthakoni uwo, <verse eid="EXO 16:2" /><verse number="3" style="v" sid="EXO 16:3" />yeeraka, “Ikaari nambaya wiira Apwiiya Nlhuku ahoniiva Umisri, waakhalha ihu ni ukhuura ihu inama ni ulhia mikatte nkanaawona. Nansho mwaattiva nhoniwiiha uthakoni uno hii attu onkhaye va, wiira nikhweke wo ithalha!”<verse eid="EXO 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 16:4" />Phi vavawo Apwiiya Nlhuku verenlhe aya ashinna Musa, “Mii kinowurupelhani ipulha yo mikatte ukhuma wiirimu. Kila nihuku attu anookhumacha mmawani ni ukhupacha choolhia cho waathosha wo nihuku nno. Wo yeyo iphiro iyo kinowaalhikacha koone wiira anoottwara malhehero aka ama khanottwaracha. <verse eid="EXO 16:4" /><verse number="5" style="v" sid="EXO 16:5" />Nansho nihuku no sita, vanohalha aya uthokoreria choolhia chikhupanche aya, chikhalheke choolhia mikwaha miilhi yo choolhia cho kila nihuku.”<verse eid="EXO 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 16:6" />Paahi ashinna Musa ni Naharuni yaheerelha attu onkhaye Aisraeli wiira, “Uchechilho wo lhelho ulha, nnochuwelha wiira Apwiiya Nlhuku phi okuminheni ukhuma Umisri! <verse eid="EXO 16:6" /><verse number="7" style="v" sid="EXO 16:7" />Tho, meelho wichishu, nnowoona nthimicho wa Apwiiya Nlhuku ukhalhawaya aheewa ichuku inyu volhenlhe inyu. Ukhalhawaya hiyaano anamitheko aya tu.” <verse eid="EXO 16:7" /><verse number="8" style="v" sid="EXO 16:8" />Ashinna Musa tho nkayeera, “Uchechilho Apwiiya Nlhuku anouvahani inama nkhuure, ni wichishu anouvahani nkatte nlhieke ni urupalha. Ukhalhawaya aheewa ichuku inyu vonlhachilhe inyu. Hiyaano phi apani? Nhinunlhelhe hii nansho mwonlhelheke Apwiiya Nlhuku.”<verse eid="EXO 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 16:9" />Yamalheke ashinna Musa nkayeerelha Naharuni, “Mwaahimerieke Aisraeli onkhaye wiira, ‘Nthukumaneke umihoolho wa Apwiiya Nlhuku ukhalhawaya aheewa ichuku chinyu.’ ” <verse eid="EXO 16:9" /><verse number="10" style="v" sid="EXO 16:10" />Ikatema Naharuni volhumana aya Aisraeli, attu onkhaye yahoweha uthakoni. Wo uhipicha nchakarimia no nthimicho wa Apwiiya Nlhuku nkanoonia unihuteni. <verse eid="EXO 16:10" /><verse number="11" style="v" sid="EXO 16:11" />Apwiiya Nlhuku nkayeerelha ashinna Musa, <verse eid="EXO 16:11" /><verse number="12" style="v" sid="EXO 16:12" />“Kiheewa ichuku cha Aisraeli. Paahi mwaahimerie wiira uchechilho anokhuura inama, ni wichishu anolhia nkatte unothanana aya. Vavawo phi nohalha aya uchuwelha wiira mii phi Apwiiya Nlhuku inyu.”<verse eid="EXO 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 16:13" />Paahi uchechilho nkachaakhuruwa ikhwalhi chinchi, nkachaakhuneelha ikambi ya Aisraeli. Washeeke nkawaakhuma ukame uchereshere ikambi aya iyo. <verse eid="EXO 16:13" /><verse number="14" style="v" sid="EXO 16:14" />Ukame uyo vaawalhawanlhe aya, nkawaahalha uthakoni uwo ittu thoko nkatte wo uvevialha, wo waalhuwa. <verse eid="EXO 16:14" /><verse number="15" style="v" sid="EXO 16:15" />Aisraeli yooneke yeyo ittu iyo nkayaashangacha, nkayaakohanacha, “Ilha phi ishiyani?” Ukhalhawaya khayaachuwenlhe yaakhumelhenlhe ittu yaani.</para>
  <para style="p" vid="EXO 16:15">Paahi ashinna Musa nkayaahimia wiira, “Ilha phi yolhia Apwiiya Nlhuku ahovahayani, nlhieke. <verse eid="EXO 16:15" /><verse number="16" style="v" sid="EXO 16:16" />Apwiiya Nlhuku aholhehera wiira, ‘Kila ntu ashungeke yolhia ikhadiri inooria awe ulhia. Arokotteke ikibaba piilhi wo kila ntu, ashungeke unihemani wawe.’ ”<verse eid="EXO 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 16:17" />Paahi Aisraeli nkayaapanga chiicho. Akina yaarokontte chinchi ni akina vakani. <verse eid="EXO 16:17" /><verse number="18" style="v" sid="EXO 16:18" />Nansho vaaphimme aya yolhia yaarokontte aya, nkayoona wiira kila ntu hopatta yaahuvelha awe. Aarokhontte chinchi khayaarina yohalhana, ni aarokottilhe vakani, khaawukuwelhiye. Kila mmoka arii narokontte chaahuvelha awe.<verse eid="EXO 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 16:19" />Ashinna Musa nkayeerelha attu, “Ntu riyoothe hishunge mmithe!” <verse eid="EXO 16:19" /><verse number="20" style="v" sid="EXO 16:20" />Nansho attu nkayeewelhenlhe ashinna Musa. Akina aya yahoshunga mmithe. Nansho wichishu yolhia iyo yahochukumana ni ukhuma ikhune. Ashinna Musa nkayaarushiya chinene. <verse eid="EXO 16:20" /><verse number="21" style="v" sid="EXO 16:21" />Paahi kila wichishu yahorokotta yolhia kila ntu yanthosha awe ulhia. Nchuwa vaawelha aya ni ukhalha no uviha, yolhia ikina ilhe yahowalhawalha.<verse eid="EXO 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 16:22" />Nihuku no sita, Aisraeli yahorokottacha yolhia mikwaha milhi, ikibaba ncheshe kila ntu. Paahi ashulhupalhe onkhaye o Aisraeli yaharweelha ashinna Musa, nkayaalhelha nenno nlhove nno. <verse eid="EXO 16:22" /><verse number="23" style="v" sid="EXO 16:23" />Ashinna Musa nkayaakhulha, “Alha phi malheheriyo a Apwiiya Nlhuku. Meelho phi Nihuku no Wiittuwa nulhupalhe, Nihuku no Wiittuwa no Apwiiya Nlhuku. Paahi nrweeke mwaapieke ama mwakutihacheke yolhia inothanana inyu lhelho, ni yolhia inohalha iyo nshungeke mpaka meelho.”<verse eid="EXO 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 16:24" />Paahi yahoshunga choolhia chikina mpaka meelho thoko ashinna Musa chaahimmie aya. Wichishu waya yahoona wiira khayaachukumanne wala ukhuma ikhune. <verse eid="EXO 16:24" /><verse number="25" style="v" sid="EXO 16:25" />Paahi ashinna Musa nkeerelhacha wiira, “Nlhiacheke yolhia mwaashungilhe inyu iyo, ukhalhawaya lhelho phi Nihuku no Wiittuwa, neeshiye ni Apwiiya Nlhuku. Lhelho khannopatta yolhia vathe vawo. <verse eid="EXO 16:25" /><verse number="26" style="v" sid="EXO 16:26" />Wo mahuku sita nnoorokotta yolhia ilha, nansho nihuku no saba phi Nihuku no Wiittuwa, khannowa mwaapatta yolhia.”<verse eid="EXO 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 16:27" />Nansho nihuku no saba ahokhalha attu akina yaarwelhe uwaviani yolhia, nansho nkayaapatilhe. <verse eid="EXO 16:27" /><verse number="28" style="v" sid="EXO 16:28" />Vavawo Apwiiya Nlhuku nkayeerelha ashinna Musa wiira, “Chani, nnohalha ukhota malheheriyo ni Malhehero aka mpaka iyaakhani? <verse eid="EXO 16:28" /><verse number="29" style="v" sid="EXO 16:29" />Nchuwelheke wiira mii Apwiiya Nlhuku kihovahani Nihuku no Wiittuwa, phi nlhatu no uvahani yolhia yo mahuku meelhi nihuku no sita. Paahi mwiittuweke kila ntu uwannyawe, ntu riyoothe hikhume vawani nihuku no saba nna.” <verse eid="EXO 16:29" /><verse number="30" style="v" sid="EXO 16:30" />Paahi etu, attu yaheettuwa nihuku no saba.<verse eid="EXO 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 16:31" />Aisraeli yaheehana yeyo yolhia iyo, “Mana.” Yaari thoko imbeyu yo meelhe, yooteelha, ni uchiva waya warii thoko nkatte wo uvevialha uhelhiye urawo. <verse eid="EXO 16:31" /><verse number="32" style="v" sid="EXO 16:32" />Ashinna Musa nkayeerelha wiira, “Apwiiya Nlhuku aholhehera wiira, ‘Nshungeke ikibaba piilhi yo imana ni ushunga wo nlhatu wo achishaana inyu. Yolhia yolhinheakani uthakoni ikatema yo ukumihani Umisri.’ ”<verse eid="EXO 16:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 16:33" />Ashinna Musa nkayeerelha Naharuni, “Nkusheke nigudulia, nhelheke ikibaba piilhi cho imana, mweesheke umihoolho wa Apwiiya Nlhuku, ikhalhe wo nlhatu wo iyari chihu chinowa.” <verse eid="EXO 16:33" /><verse number="34" style="v" sid="EXO 16:34" />Paahi Naharuni nkayeesha imana umihoolho wo Nisanduku no Malhehano wiira ithokororiye thoko Apwiiya Nlhuku chaalhehenre aya ashinna Musa. <verse eid="EXO 16:34" /><verse number="35" style="v" sid="EXO 16:35" />Aisraeli yaholhiacha imana iyo iyaakha makhumi ncheshe, mpaka vaaphilhe aya ilhapo yaalhoka ukhalha, ilhapo yo mmwinanoni Ukanaani weenshe aya mapuro aya molhuphalhe. <verse eid="EXO 16:35" /><verse number="36" style="v" sid="EXO 16:36" />Yolhia yo imana, ipishi ncheshe yaari mpatta wo khumi wo ikipimo yo kawaida ineehaniya efa.<verse eid="EXO 16:36" /></para>
  <chapter eid="EXO 16" />
  <chapter number="17" style="c" sid="EXO 17" />
  <para style="s1">Maashi o ukhuma vamwalhani</para>
  <para style="r">(<ref loc="NUM 20:1-13">Waal 20:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 17:1" />Nlhoko wonkhaye wa Aisraeli wahothama uthako wo Usini, nkayeeta nkwaha wo uthamathama thoko chaalheheriye aya ni Apwiiya Nlhuku. Nkayaamaka Urefidimu, nansho wowo khawaariwo maashi o uwuria. <verse eid="EXO 17:1" /><verse number="2" style="v" sid="EXO 17:2" />Paahi attu nkayonlhelha ashinna Musa yeeraka, “Nnivahe maashi o uwuria.”</para>
  <para style="p" vid="EXO 17:2">Ashinna Musa nkayaakhulha, “Woonaka nnokunlhelha mii? Woonaka nnowaalhikacha Apwiiya Nlhuku?”<verse eid="EXO 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 17:3" />Nansho attu onkhaye yarii anawolhiye nttona, nkayonlhelha ashinna Musa yeeraka, “Nlhatuni no unithamiha Umisri ulhe wiira nniive wo nttona hiyaano onkhaye ni achishaana ihu ni mihuwo chihu?”<verse eid="EXO 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 17:4" />Paahi ashinna Musa nkayonlhelha Apwiiya Nlhuku yeeraka, “Kaapangelhekeni alha attu alha? Ahophiyelha ukaata malhuku!”<verse eid="EXO 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 17:5" />Apwiiya Nlhuku nkayeerelha ashinna Musa, “Nvireke mwaattuni, mwaawieke ashulhupalhe aya vakani. Tho, nkusheke ilha ikopo yaatenlhe inyu mwoolhoko wo Unaili ilha mmathathani mwinyu. <verse eid="EXO 17:5" /><verse number="6" style="v" sid="EXO 17:6" />Nkiiwelhelheke rata. Mii kinoweemelha umihoolho winyu vamwalhani Uhorebu. Ni inyuva mwaateke yoyo mwalha uyo ni maashi anokookhuma wiira attu onkhaye awuriache.” Paahi ashinna Musa nkayaapanga chiicho umihoolho wa ashulhupalhe a Aisraeli.<verse eid="EXO 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 17:7" />Ashinna Musa nkayehaana vavawo vakittu vawo Masa, maana aya “Ulhikacha” ni Meriba, maana aya “Wunlhelha.” Ukhalhawaya Aisraeli yahonlhelha ni waalhikacha Apwiiya Nlhuku yeeraka, “Chani, wo ikekhiaye Apwiiya Nlhuku arii vamoka ni hii?”<verse eid="EXO 17:7" /></para>
  <para style="s1">Ikhoto ni attu o Uamaleki</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 17:8" />Attu o Uamaleki yahowaacha ni waatakana ikhoto ni Aisraeli Urefidimu. <verse eid="EXO 17:8" /><verse number="9" style="v" sid="EXO 17:9" />Ashinna Musa nkayeerelha Nayoshua wiira, “Mwaathanlheke manyaalhopwana nrwee mwaatakane ni attu o Uamaleki. Meelho mii kinoweemelha vachulhu mwaamwako ulhe, kinavarelhenlhe ikopo ya Nlhuku ilhe mmathathani mwaka.” <verse eid="EXO 17:9" /><verse number="10" style="v" sid="EXO 17:10" />Paahi Nayoshua nkayaapanga chiicho thoko chaahimmie aya ashinna Musa, nkaarwa uwaatakanani ni attu o Uamaleki. Ashinna Musa, Naharuni ni Nahuri nkayaawelha vachulhu mwaako. <verse eid="EXO 17:10" /><verse number="11" style="v" sid="EXO 17:11" />Ikatema yonkhaye ashinna Musa vaathesha aya miono chaya uchulhu, Aisraeli yahokottolha, nansho vaakurunshe aya attu o Uamaleki ahokottolha. <verse eid="EXO 17:11" /><verse number="12" style="v" sid="EXO 17:12" />Nansho baada yo uvira ikatema, miono cha ashinna Musa chahoochaa. Paahi Naharuni ni Nahuri yahokusha nlhuku nkayeeshera ashinna Musa ni ayo nkayaakhalhelha. Yamalheke nkayaavaracha miono chi ashinna Musa, nkayaathesha, mmoka atheeshaka moono o wiimonono ni nkina moono o wiimushi. Paahi miono cha ashinna Musa nkachaakhalha chichirikhi mpaka nchuwa velhilhe aya, ukhalhawaya chaari chinatheeshiye nchulhu. <verse eid="EXO 17:12" /><verse number="13" style="v" sid="EXO 17:13" />Paahi Nayoshua ni attu aya, nkayaakottolha attu o Uamaleki wo uphanga waya.<verse eid="EXO 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 17:14" />Yamalheke Apwiiya Nlhuku nkayeerelha ashinna Musa, “Nlhepeke nna nlhove nna nkitabuni nikhalheke nuupusho. Tho, mwaahimerieke Nayoshua wiira, Mii kinowaalhakalhiha attu o Uamaleki velhaponi va.” <verse eid="EXO 17:14" /><verse number="15" style="v" sid="EXO 17:15" />Ashinna Musa nkayaatheka madhubahu ni wiihana madhubahu ayo, Yahweh Nisi, maana aya “Apwiiya Nlhuku phi Ibendera aka.” <verse eid="EXO 17:15" /><verse number="16" style="v" sid="EXO 17:16" />Yeeraka wiira, “Ntheesheke nchulhu ibendera ya Apwiiya Nlhuku! Apwiiya Nlhuku anowaatakana ni attu o Uamaleki wo mahuku onkhaye o uhimalha!”<verse eid="EXO 17:16" /></para>
  <chapter eid="EXO 17" />
  <chapter number="18" style="c" sid="EXO 18" />
  <para style="s1">Nayethro anowettakachera ashinna Musa</para>
  <para style="r">(<ref loc="DEU 1:9-18">Itor 1:9-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 18:1" />Nayethro opochera ishaani o Umidiyani, ahokohaya ashinna Musa, yaheewa mwaha wonkhaye Apwiiya Nlhuku waapangenlhe aya ashinna Musa ni Aisraeli vaathamihiya aya Umisri. <verse eid="EXO 18:1" /><verse number="2" style="v" sid="EXO 18:2" />Paahi Nayethro, yahorwaa wa ashinna Musa, anari ni Nasipora, ahanu a ashinna Musa, aahiye ni ashinna Musa utulhi, <verse eid="EXO 18:2" /><verse number="3" style="v" sid="EXO 18:3" />vamoka ni achishaana elhi a ashinna Musa. Mwaana o nttara ehaniya Gershomu. Nchina no yoyo mwaana uyo aavahiye ni athumwanawe, ashinna Musa, wo nlhatu no wiira, “Kihottawelha ulhetoni.” <verse eid="EXO 18:3" /><verse number="4" style="v" sid="EXO 18:4" />Mwaana o nayelhi ehaniya Eliezeri, ukhalhawaya ashinna Musa yeera, “Nlhuku a athumwanaka phi kinkenlhe kihiiviye ni Nafarao.”<verse eid="EXO 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 18:5" />Nayethro ahokohaya ashinna Musa, yahowa vamoka ni anaya, yaani ahano a ashinna Musa vamoka ni achishaana, nkayaaphwanya ashinna Musa uthakoni vaamakilhe aya uri mwaako wa Nlhuku. <verse eid="EXO 18:5" /><verse number="6" style="v" sid="EXO 18:6" />Ashinna Musa vaahimeriye aya wiira ahokohaya vamoka ni Nasipora, anoowa vamoka ni achishaana aya oyeelhi, <verse eid="EXO 18:6" /><verse number="7" style="v" sid="EXO 18:7" />ahothama urwa weekamelha ahokohaya ayo, nkayooromelha ni waakumbatira, ni ukohanacha. Yamalheke nkayaakelha nnihemani. <verse eid="EXO 18:7" /><verse number="8" style="v" sid="EXO 18:8" />Ashinna Musa nkayeerelha ahokohaya malhove onkhaye Apwiiya Nlhuku yaapannge aya wa Nafarao ni attu o Umisri wo nlhatu wa Aisraeli. Tho, ahaahimeria mwaha wo uhuva wonkhaye waapantte aya munkwahani, ni Apwiiya Nlhuku chenre aya wo woopolha. <verse eid="EXO 18:8" /><verse number="9" style="v" sid="EXO 18:9" />Nayethro nkayaatelhiya veewilhe aya mwaha wonkhaye upangilhe aya Apwiiya Nlhuku, wo nlhatu wa Aisraeli, wo wookholha mmathathani mwa attu o Umisri. <verse eid="EXO 18:9" /><verse number="10" style="v" sid="EXO 18:10" />Nayethro nkayeera, “Athimichiye Apwiiya Nlhuku ookhonlhe Aisraeli mmathathani mwa attu o Umisri ni waakumiha upottani u Nafarao. <verse eid="EXO 18:10" /><verse number="11" style="v" sid="EXO 18:11" />Vano kihochuwelha wiira Apwiiya Nlhuku phi olhupalhe upwaha milhuku chonkhaye, ukhalhawaya ahookholha attu alha mmathathani mwa attu o Umisri yaapangelha mattepwa.” <verse eid="EXO 18:11" /><verse number="12" style="v" sid="EXO 18:12" />Vavawo Nayethro, ahokohaya ashinna Musa, nkayaakumiha isadaka cho upahiya wa Nlhuku ni isadaka chikina. Naharuni ni ayo ahowa vamoka ni ashulhupalhe Aisraeli wiira alhie yolhia ikumihiye isadaka, vamoka ni Nayethro, wo waathimicha Apwiiya Nlhuku.<verse eid="EXO 18:12" /></para>
  <para style="s1">Ashinna Musa anowaathanlha attu o waamulha milhatu</para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 18:13" />Waashelhe waya, ashinna Musa yahokalha wiiwelhelha milhatu cha Aisraeli. Attu yaari aneemenlhe anarukurenrie, toka wichishu mpaka uchechilho. <verse eid="EXO 18:13" /><verse number="14" style="v" sid="EXO 18:14" />Nayethro ahokohaya ashinna Musa, yahoona chittu chonkhaye ashinna Musa chaapanga aya wa Aisraeli, nkayaakoha, “Nlhatuwaani wo waapangelha attu chittu thoko chii? Woonaka nnokhalha vekha inyu uno attu anorukurenrieni toka wichishu mpaka uchechilho?”<verse eid="EXO 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 18:15" />Ashinna Musa nkayaakhulha ahokohaya, “Ukhalhawaya attu anowa uwannyaka ukoherera malhove a Nlhuku. <verse eid="EXO 18:15" /><verse number="16" style="v" sid="EXO 18:16" />Attu yaanaka indewo iriyoothe, anoowacha uwannyaka, ni mii kinowaamulha, kila ntu ni nkhunanawe. Tho, kinoweettuchiha malheheriyo a Nlhuku ni malhehero aya.”<verse eid="EXO 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 18:17" />Paahi Nayethro nkayeerelha ashinna Musa wiira, “Chinopanga inyu khachinlhoka! <verse eid="EXO 18:17" /><verse number="18" style="v" sid="EXO 18:18" />Nnowiiweria mwaanene, vamoka attu alha, nnowoochaa. Ukhalhawaya ulha ntheko ulha uhorika uhinooria inyu upanga vekha inyu. <verse eid="EXO 18:18" /><verse number="19" style="v" sid="EXO 18:19" />Mwiiwelhelheke nlhove naka, ni Nlhuku akhalhe vamoka ni inyu. Inyuva mwemelhelheke attu umihoolho wa Nlhuku ni unhimeria Nlhuku ichuku chaya. <verse eid="EXO 18:19" /><verse number="20" style="v" sid="EXO 18:20" />Tho, mweettuchiheke malhehero ni malhove o waamulha a Apwiiya Nlhuku, ni wooniha iphiro chinothananiya aya ukhalha ni upanga. <verse eid="EXO 18:20" /><verse number="21" style="v" sid="EXO 18:21" />Nansho wo mwaha wo malhove makina, mwaathanlheke munlhokoni mwa attu onkhaye, attu anonthimicha Nlhuku, anokhulhuvelhiya ni ahinottuna uhongiya. Mwaavaheke yayo ntheko, akhalheke ni o waamulha milhatu ni owemelhelha attu munkutironi mwa attu elufu, imia imoka, makhumi nthanu, ni khumikhumi. <verse eid="EXO 18:21" /><verse number="22" style="v" sid="EXO 18:22" />Yayo phi nohalha ukhalha kila nihuku ni waamulha milhatu cha attu. Malhove orikarika anouwiiherani inyuva, nansho makanimakani alhe anowaamulhacha ashinene. Wo yeyo phiro iyo nnowooria waalhuwiha ntheko inyu ukhalhawaya anoukavihani inyuva yoyo mwaha uyo. <verse eid="EXO 18:22" /><verse number="23" style="v" sid="EXO 18:23" />Mwapangaka chiicho, thoko chinothanana awe Nlhuku, nnowooria upanga chittu rata. Ni attu onkhaye alha anowooria uhokolhiacha mmawannyaya wo mpuha.”<verse eid="EXO 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 18:24" />Ashinna Musa yaheewelhelha nlhove no ahokohaya nno, ni upanga thoko chaahimeriye aya. <verse eid="EXO 18:24" /><verse number="25" style="v" sid="EXO 18:25" />Paahi ashinna Musa ahaathanlha attu yaari o wooria chittu munlhokoni mwa Aisraeli. Nkayaapangacha ukhalha ahoolhelhi o mikutiro cha attu elufu, attu imia imoka, attu makhumi nthanu, ni attu khumikhumi. <verse eid="EXO 18:25" /><verse number="26" style="v" sid="EXO 18:26" />Ni yayo etu nkayaakhalha o waamulha milhatu cha attu kila ikatema. Milhatu cho urikarika ahowiiheriya ashinna Musa, nansho cho uhirikarika chilhe yahaamulha yayo ashineneru ayo.<verse eid="EXO 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 18:27" />Yamalheke upanga chiicho, ashinna Musa ni ahokohaya waholhehaniya, ni Nayethro nkayaaholhia wiilhaponi waya.<verse eid="EXO 18:27" /></para>
  <chapter eid="EXO 18" />
  <chapter number="19" style="c" sid="EXO 19" />
  <para style="s1">Aisraeli umwaakoni Usinai</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 19:1" />Nihuku no upacha no mweeri wo neraru toka vaathamme aya Umisri, Aisraeli yahophiyacha uthako wo Usinai. <verse eid="EXO 19:1" /><verse number="2" style="v" sid="EXO 19:2" />Vaathamilhe aya Urefidimu ni uphiya uthakoni Usinai, yahotheka ikambi umihoolho mwaako wo Usinai. <verse eid="EXO 19:2" /><verse number="3" style="v" sid="EXO 19:3" />Paahi ashinna Musa yahowelha umwaakoni wa Nlhuku.</para>
  <para style="p" vid="EXO 19:3">Vavawo Apwiiya Nlhuku nkayeehana ashinna Musa ukhuma umwaakoni waari aya uwo, nkayeerelha wiira, “Chii phi chiicho chinohalha inyu wereelha ayari a Nayakhobo Aisraeli ayo, <verse eid="EXO 19:3" /><verse number="4" style="v" sid="EXO 19:4" />‘Mwaattiva mwaashinene nhoona chaapangenlhe aka attu o Umisri ni iphiro yokunsheakani thoko nrepo chinokusha aya makhandi mmapuphani, nkakowiihani uwannyaka. <verse eid="EXO 19:4" /><verse number="5" style="v" sid="EXO 19:5" />Vano etu, mwavaraka nlhove naka ni uvarechesha malhehano aka, nnookhalha attu aka othanlhiya munlhokoni mwo attu o ilhapo yonkhaye. Ukhalhawaya ilhapo yonkhaye yawaka. <verse eid="EXO 19:5" /><verse number="6" style="v" sid="EXO 19:6" />Uwannyaka, mwaatti nnowa ukhalha imwene yo upochera ishaani ni nihimo nitakatifu.’ Alha phi malhove anohalha inyu waahimeria Aisraeli.”<verse eid="EXO 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 19:7" />Paahi ashinna Musa nkayaahokolhia, nkayeehanacha ashulhupalhe a Aisraeli vamoka ni waahimeria malhove alheheriye aya ni Apwiiya Nlhuku alha. <verse eid="EXO 19:7" /><verse number="8" style="v" sid="EXO 19:8" />Attu onkhaye nkayaarumelhelhacha vamoka yiiraka wiira, “Ninoopanga chittu chonkhaye chihimilhe aya Apwiiya Nlhuku.” Ni ashinna Musa nkayaahimeria Apwiiya Nlhuku nlhove naakhunlhe aya attu ayo. <verse eid="EXO 19:8" /><verse number="9" style="v" sid="EXO 19:9" />Apwiiya Nlhuku nkayeerelha ashinna Musa, “Haya, mii kinoowa uwannyu nnihuteni nolhemelha, Aisraeli akiiwe ittu kinohalha aka uwuulhumanani, wiira arumelhelhe nlhove ninyu mahuku onkhaye.”</para>
  <para style="p" vid="EXO 19:9">Yamalheke ashinna Musa nkayaamwiirelha Nlhuku ittu yulhumanche aya attu. <verse eid="EXO 19:9" /><verse number="10" style="v" sid="EXO 19:10" />Apwiiya Nlhuku nkayeerelha ashinna Musa, “Nrweeke wa attu ayo mwaahimerie wiira ettukurie lhelho ni meelho. Mweerelheke wiira apuputtacheke ikuwo chaya. <verse eid="EXO 19:10" /><verse number="11" style="v" sid="EXO 19:11" />Akhalheke tayari wo nihuku no nroto, ukhalhawaya mii Apwiiya Nlhuku kinookhuruwa vachulhu mwako wo Usinai umihoolho wa attu onkhaye. <verse eid="EXO 19:11" /><verse number="12" style="v" sid="EXO 19:12" />Tho, inyuva mweeshereke attu mwiinano, urukurerieke mwaako. Mwaamukeke, eechinanelhe chinene ahiwelhe mmwaakoni ama unyikalha mwiinano aya. <verse eid="EXO 19:12" /><verse number="13" style="v" sid="EXO 19:13" />Ntu riyoothe nohalha uvara mwaako, nowiiviya, nowaatiya malhuku ama muupa, ni ntu riyoothe nkina himmare yoyo ntu uyo. Akhalhe ntu ama mwannama, khanolhama, noowiviya. Nansho nipalhapata vanohalha aya uthepa woopiya, attu onkhaye achushereke umwaakoni.”<verse eid="EXO 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 19:14" />Paahi ashinna Musa nkayaakhuruwa umwaakoni ni waarwelha attu, nkaattukuriacha, ni ayo nkayaapuputtacha ikuwo chaya. <verse eid="EXO 19:14" /><verse number="15" style="v" sid="EXO 19:15" />Yamalheke ahaahimeriacha attu onkhaye wiira, “Nkhalheke tayari wo nihuku no nroto. Nlhopwana riyoothe hirupe ni nthiyana.”<verse eid="EXO 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 19:16" />Paahi wichishu nihuku no neraru, wahoritima ithari ni uverunya. Nihute no wiitivalha nkanaakhumelhelha vachulhu mwaako. Nipalhapata no nlhove nulhuphalhe naatetemelhihilhe attu onkhaye vakambini vawo naheewania. <verse eid="EXO 19:16" /><verse number="17" style="v" sid="EXO 19:17" />Yamalheke ashinna Musa ahaahoolhelhiha attu onkhaye ukhuma vakambini, nkayaarwa unkumaanani Nlhuku. Attu onkhaye nkayaarwacha nkayeemelhacha wuuthi mwaako.<verse eid="EXO 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 19:18" />Mwaako o Usinai waari unakhunelhiye ni mwiishi ukhalhawaya Apwiiya Nlhuku ahokhuruwa vachulhu aya mmooroni. Yoyo mwiishi wo mooro uyo wahowelha vachulhu thoko mwiishi o ntanuru nulhupalhe ni mwaako wonkhaye nkawaatetemelha wo machiri. <verse eid="EXO 19:18" /><verse number="19" style="v" sid="EXO 19:19" />Nipalhapata nahothepa uruma, ni ashinna Musa nkayaamulhumana Nlhuku. Nlhuku nkaakhulha wo uritima.<verse eid="EXO 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 19:20" />Apwiiya Nlhuku nkayaakhuruwa vachulhu mwaako Usinai, nkayeehana ashinna Musa ukhuma uchulhu, ni ayo nkayaawelha umwaakoni. <verse eid="EXO 19:20" /><verse number="21" style="v" sid="EXO 19:21" />Apwiiya Nlhuku nkayeerelha ashinna Musa, “Nkhuruwe vathi mwaamuke attu onkhaye ahiwelhe umwaakoni, ama attu enchi anorimeelha. <verse eid="EXO 19:21" /><verse number="22" style="v" sid="EXO 19:22" />Ata opochera ishaani anokaatameria, ni ayo aathananiya wiira ettukurieke, ama kinowaatwarushacha.” <verse eid="EXO 19:22" /><verse number="23" style="v" sid="EXO 19:23" />Ashinna Musa nkayeerelha Apwiiya Nlhuku, “Attu alha khanoriacha uwelha yolha mwako wo Usinai ulha ukhalhawaya inyuva mwanene mwahonilhehera wiira neesheke ni uthimicha mwiinano wo urukureria mwaako.”<verse eid="EXO 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 19:24" />Apwiiya Nlhuku nkayeerelha ashinna Musa wiira, “Nkhuruwe vathi, yamalhaka nhokolhie mmweeke ni Naharuni. Nansho nhaahiyerere opochera ishaani ni attu akina apwahe mwiinano ni uwa uwannyaka, ama kinowaatwarusha.” <verse eid="EXO 19:24" /><verse number="25" style="v" sid="EXO 19:25" />Paahi ashinna Musa yahokhuruwa ni waahimeriacha Aisraeli malhove onkhaye yaalheheriye aya.<verse eid="EXO 19:25" /></para>
  <chapter eid="EXO 19" />
  <chapter number="20" style="c" sid="EXO 20" />
  <para style="s1">Malhehero khumi</para>
  <para style="r">(<ref loc="DEU 5:1-21">Itor 5:1-21</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 20:1" />Apwiiya Nlhuku ahoolhumacha malhove onkhaye alha, nkayeera, <verse eid="EXO 20:1" /><verse number="2" style="v" sid="EXO 20:2" />“Mii phi Apwiiya Nlhuku inyu, kuthaminheni ilhapo yo Umisri, waari inyu ipotta.<verse eid="EXO 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 20:3" />“Nhikhalhe ni milhuku chikina kaahikhalhe mii vekha.<verse eid="EXO 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 20:4" />“Nhikooroshe isinyago iriyoothe yo milhuku cho woothiya, ama isinyago iriyoothe irii wiirimu, mwiilhaponi ama mmaashini wuuthi ilhapo. <verse eid="EXO 20:4" /><verse number="5" style="v" sid="EXO 20:5" />Nhikhoromelhe ama ukavihera ntheko aya, ukhalhawaya mii Apwiiya Nlhuku inyu, phi Nlhuku o ihache. Kinowaatwarusha achishaana wo nlhatu no uhilhoka wa manyaathumwanaya, ata mpaka iyari cho neraru ni cho nechenshe cho yayo ahinokittuna ayo. <verse eid="EXO 20:5" /><verse number="6" style="v" sid="EXO 20:6" />Nansho kinowaalhoha maelufu o iyari cho alhe anokittuna ni uvarechesha malhehero aka.<verse eid="EXO 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 20:7" />“Nhiromolhe wo uhikhalha ni maana nchina naka mii Apwiiya Nlhuku inyu. Ukhalhawaya mii Apwiiya Nlhuku akinohiya untwarusha nohalha uromolha nchina naka pufia.<verse eid="EXO 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 20:8" />“Nhilhiyalhe uvarechesha Nihuku no Wiittuwa, ni upanga nihuku nitakatifu. <verse eid="EXO 20:8" /><verse number="9" style="v" sid="EXO 20:9" />Nvareke ntheko mahuku sita, ni upanga chittu chinyu chonkhaye. <verse eid="EXO 20:9" /><verse number="10" style="v" sid="EXO 20:10" />Nansho nihuku no saba phi Nihuku no Wiittuwa na Apwiiya Nlhuku inyu. Nenno nihuku nno nhivare ntheko uriyoothe, inyuva ama mwaamwaninyu mwanlhopwana ama mwanthiyana ama ipotta inyu ama anamitheko inyu ashithiyana ama ashinama inyu ohuwiya ama nlheto rii uwannyu. <verse eid="EXO 20:10" /><verse number="11" style="v" sid="EXO 20:11" />Ukhalhawaya wo mahuku sita mii Apwiiya Nlhuku inyu, kahoopa irimu ni ilhapo, ibahari ni chonkhaye chiriwo. Yamalheke nkakeettuwa nihuku no saba. Paahi etu mii Apwiiya Nlhuku kahohelha ibarakha nenno Nihuku no Wiittuwa nno, nkakaapanga ukhalha nitakatifu.<verse eid="EXO 20:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 20:12" />“Mwaathimicheke athumwaninyu ni anumwaninyu, wiira nlhokelhe mahuku o uhimalha mwiilhaphoni kinouvahakani mii Apwiiya Nlhuku inyu.<verse eid="EXO 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 20:13" />“Nhiive.<verse eid="EXO 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 20:14" />“Nhilhuve.<verse eid="EXO 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 20:15" />“Nhiiye ittu iriyoothe.<verse eid="EXO 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 20:16" />“Nhimootherie namwaatana inyu.<verse eid="EXO 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 20:17" />“Nhimirielhe ishenye inupa ya amwaatamana inyu ama ahanu awe ama namitheko awe nlhopwana ama nthiyana ama ing'ope awe ama iphuta awe ama ittu iriyoothe ya amwaatamana inyu.”<verse eid="EXO 20:17" /></para>
  <para style="s1">Woova wa attu</para>
  <para style="r">(<ref loc="DEU 5:22-33">Itor 5:22-33</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 20:18" />Attu yeeweke ithari ni woona uverunya uverunyaka ni wiiwa nipalhapata vachulhu mwaako waatutuma mwiishi, onkhaye yahoovacha ni uthukumelha. Onkhaye nkayeemelhacha utayi. <verse eid="EXO 20:18" /><verse number="19" style="v" sid="EXO 20:19" />Nkayeerelha ashinna Musa, “Nnulhumaneke inyuva mwaanene, ni hii ninowiiwelhelhani, nansho Apwiiya Nlhuku ahinuulhumane, nihiwe naakhwa.” <verse eid="EXO 20:19" /><verse number="20" style="v" sid="EXO 20:20" />Ashinna Musa nkayeerelha, “Nhoove, ukhalhawaya Nlhuku howa ulhikachani wiira munthimicheke yoyo mahuku onkhaye, ni mena nhiwonye.”<verse eid="EXO 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 20:21" />Attu onkhaye yeemenlhe utayi ikatema ashinna Musa vaatamenrie aya nihute nolhemelha naari awe Nlhuku nne.<verse eid="EXO 20:21" /></para>
  <para style="s1">Malhehero anaacha madhubahu o malhuku</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 20:22" />Apwiiya Nlhuku nkayeerelha ashinna Musa, “Mweerelheke Aisraeli wiira, ‘Nhoonechesha mwaashinene wiira kihowulhumanani ukhuma wiirimu. <verse eid="EXO 20:22" /><verse number="23" style="v" sid="EXO 20:23" />Nkithimicheke mii vekha aka, mena nhikooroshe isinyago cho milhuku cho isiliva mena cho idhahabu. <verse eid="EXO 20:23" /><verse number="24" style="v" sid="EXO 20:24" />Nnokithekelha madhubahu o ittaya, ni vachulhu waya nnookihithelha ikhondoro chinyu ni ing'ope chinyu ukhalha isadaka cho upahiya ni isadaka cho uwiiha mpuha. Vakittu variwoothe vanohalha aka woopusha attu nchina naka, vavawo mii kinoowa kimwanene ni uvahani ibarakha. <verse eid="EXO 20:24" /><verse number="25" style="v" sid="EXO 20:25" />Mwakithekelhaka madhubahu o malhuku, nhitheke wo malhuku o uhemiya, ukhalhawaya mwahemaka wo ikaruma cho uhemelha malhuku, nnonyalhiha. <verse eid="EXO 20:25" /><verse number="26" style="v" sid="EXO 20:26" />Mena nhikithekelhe madhubahu o mavato o uwelhelha vachulhu, attu ahiwe yoona umattepe wo uyo ntu nowelha vachulhu uyo.’ ”<verse eid="EXO 20:26" /></para>
  <chapter eid="EXO 20" />
  <chapter number="21" style="c" sid="EXO 21" />
  <para style="s1">Malhehero anaacha waalhoha ipotta</para>
  <para style="r">(<ref loc="DEU 15:12-18">Itor 15:12-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 21:1" />“Alha phi malheheriyo anohalha inyu waavaha Aisraeli. <verse eid="EXO 21:1" /><verse number="2" style="v" sid="EXO 21:2" />Mwaanthumaka ipotta Muebraniya, avareke ntheko inyu wo iyaakha sita, nansho iyaakha yo saba nookhalha neethi, munhiyeke arweeke wo uhikhalha malhivo ariyoothe. <verse eid="EXO 21:2" /><verse number="3" style="v" sid="EXO 21:3" />Yakhalhaka aathumiye hinaya uthelha, noothama vekha awe. Nansho yakhalhaka awiilhe ni ahanu awe, paahi, athameke ni ahanu awe ayo. <verse eid="EXO 21:3" /><verse number="4" style="v" sid="EXO 21:4" />Yakhalhaka nkunya awe uyo ahonthelhiha nthiyana, nkaayara achishaana ashithiyana ni ashilhopwana, paahi nthiyana uyo ni achishaana awe anowa ukhalha nhakhu wo nkunya awe uyo, ni ipotta uyo noothama vekha awe. <verse eid="EXO 21:4" /><verse number="5" style="v" sid="EXO 21:5" />Nansho yakhalhaka ipotta uyo nowulhumacha vaattuni wiira nonttuna nkunya awe, ahanu awe ni achishaana awe, ni khanttuna uthama ni ukhalha neethi, <verse eid="EXO 21:5" /><verse number="6" style="v" sid="EXO 21:6" />paahi, nkunya uyo anrweeheke inupa yo ulhapelhiya Apwiiya Nlhuku. Yamalhaka, amweemesheke vankhorani ama vanivatoni ni untemulha nnyaru nawe. Paahi yoyo nookhalha ipotta yo mahuku o uhimalha onkhaye.<verse eid="EXO 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 21:7" />“Ntu anthumihaka mwaamwanawe mwanthiyana ukhalha ipotta, yoyo khanovahiya uneethi awe thoko ipotta nlhopwana. <verse eid="EXO 21:7" /><verse number="8" style="v" sid="EXO 21:8" />Yakhalhaka mwanene ntheko uyo anthumme wiira akhalhe mmoka a ahanu awe, aahichivelhiyeke, aavaheke nipesha athumwanawe ipotta uyo wiira amoopolhe. Mwanene ntheko uyo khanooria unthumiha wo attu o makosho makina, ukhalhawaya yapangaka chiicho, anoowonya wa athumwanawe ipotta uyo. <verse eid="EXO 21:8" /><verse number="9" style="v" sid="EXO 21:9" />Yakhalhaka ntu nonthelhiha ipotta wa mwaamwanawe, ampangelheke ipotta uyo thoko chinompangelha awe mwaamwanawe mwanthiyana o unnyara. <verse eid="EXO 21:9" /><verse number="10" style="v" sid="EXO 21:10" />Yakhalhaka mwanene ntheko nonthelha nthiyana ipotta nkina, athepeke waalhoha ahanu awe o upacha ayo wo waavaha yolhia, ikuwo ni chinothananiya munthelhini chonkhaye thoko cheera awe mpacho. <verse eid="EXO 21:10" /><verse number="11" style="v" sid="EXO 21:11" />Nansho yakhalhaka khanooria upanga yayo malhove mararu anothananiya ayo, paahi, nthiyana uyo ahiiyeke arweeke wo uhikhalha malhivo ariyoothe.<verse eid="EXO 21:11" /></para>
  <para style="s1">Malhehero anaacha mwaha wo ushilhilhi</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 21:12" />“Ntu riyoothe nomwaata ntu ni umwiiva, eeviyeke ni uyo. <verse eid="EXO 21:12" /><verse number="13" style="v" sid="EXO 21:13" />Nansho yakhalhaka khaamwiithenlhe, nansho mwiivilhe wo uhilhakelha, paahi ntu owiiva uyo nowooria uttawelha vakittu vanohalha aka uhimeriani, wiichakiha. <verse eid="EXO 21:13" /><verse number="14" style="v" sid="EXO 21:14" />Nansho ntu anrakalhihaka nkhunanawe wo mweni ni umwiiva, ata anattawelhelhaka umadhubahuni waka, munkumiheke umadhubahuni waka uwo ni umwiiva.<verse eid="EXO 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 21:15" />“Ntu riyoothe naatakacha athumwanawe ama anumwanawe, eeviyeke.<verse eid="EXO 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 21:16" />“Ntu riyoothe nonkusha wo machiri ntu wiira anthumihe ama umpanga ipotta awe, eeviyeke.<verse eid="EXO 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 21:17" />“Ntu riyoothe naaruwana athumwanawe ama anumwanawe, eeviyeke.<verse eid="EXO 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 21:18" />“Attu eelhi yaatakanaka, mmoka nkaamwata nkhunanawe nlhuku ama wo mathatha wo uhimwiiva, nansho nkanrakalhiha ni ummweria nkaarupa vanlhilhini, <verse eid="EXO 21:18" /><verse number="19" style="v" sid="EXO 21:19" />yakhalhaka aatiye uyo noolhama nkooria weeta ni ntonto, yoyo anrakalhinhe uyo nolhevelhelhiya. Nansho, ammwereheke mpaka ulhama, ni unlhiva ifidiya wo mahuku apoterinhe awe vaari awe vanlhilhini.<verse eid="EXO 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 21:20" />“Mwanene ntheko amwaataka ikopo ipotta awe nlhopwana ama nthiyana ni umwiiva vavawo vawo, yoyo ntu uyo atwarushiyeke. <verse eid="EXO 21:20" /><verse number="21" style="v" sid="EXO 21:21" />Nansho ipotta uyo akhalhaka nkumi nihuku nimoka ama meelhi, yoyo ntu uyo khanotwarushiya ukhalhawaya uyo aari awawe.<verse eid="EXO 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 21:22" />“Manyaalhopwana yaatakanachaka ni unrakalhiha nthiyana o irukulhu, mpaka nkaarihariha irukulhu awe iyo wo uhikhalha ittu ikina irakanlhe awe wo uthepa, ntu nrakhalhihe uyo nolhivihiya malhivo thoko chinohalha aya uromolha owannyawe nthiyana uyo. Ni tho, thoko ashulhupalhe chinohalha aya waamulha chiyo. <verse eid="EXO 21:22" /><verse number="23" style="v" sid="EXO 21:23" />Nansho yakhalhaka nthiyana uyo horakalhihiya chinene, paahi malhivo ayo akhalheke thoko chirakalhihiye awe, ukumi wo ukumi, <verse eid="EXO 21:23" /><verse number="24" style="v" sid="EXO 21:24" />niitho wo niitho, niino wo niino, moono wo moono, mweto wo mweto, <verse eid="EXO 21:24" /><verse number="25" style="v" sid="EXO 21:25" />upahiya mooro wo upahiya mooro, nikhwata wo nikhwata, ni waatiya wo waatiya.<verse eid="EXO 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 21:26" />“Ntu amwaataka vaniithoni ipotta awe nlhopwana ama nthiyana ni umpwesha niitho nawe nno, paahi anhiyerereke, ammaheke uneethi wo uhikhalha malhivo wo nlhatu wo niitho nawe nno. <verse eid="EXO 21:26" /><verse number="27" style="v" sid="EXO 21:27" />Ni chiichammo, ntu amwaataka ipotta awe nlhopwana ama nthiyana, nkankhulha niino, paahi anhiyerereke, ammaheke uneethi wo nlhatu no niino nawe nno.<verse eid="EXO 21:27" /></para>
  <para style="s1">Malhehero anaacha attu o uhuwa mihuwo</para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 21:28" />“Ing'ope yanhomaka ntu inyaka ni umwiiva, ing'ope iyo inowiiviya wo waatiya malhuku ni inama aya khinokhuuriya. Mwanene ing'ope uyo khanokhalha ni nlhatu. <verse eid="EXO 21:28" /><verse number="29" style="v" sid="EXO 21:29" />Nansho yakhalhaka ing'ope iyo iholhemalhelha waahoma attu inyaka, ni mwanene uyo ahaamukiya nansho khaattuke, ing'ope iyo yaamwiivaka ntu tho, yaatiyeke malhuku, ni mwanene ing'ope uyo eeviyeke. <verse eid="EXO 21:29" /><verse number="30" style="v" sid="EXO 21:30" />Ata inakhalhaka chiicho, ntu uyo alhivihiyaka nchurukhu wiira oopolhe ukumi awe, alhiveke nchurukhu wonkhaye unohalha awe ulhivihiya. <verse eid="EXO 21:30" /><verse number="31" style="v" sid="EXO 21:31" />Ing'ope yamwiivaka mwaana mwanlhopwana ama mwanthiyana a ntu nkina, nlhatu uyo waamulhiyeke wo iphiro thoko yeyo. <verse eid="EXO 21:31" /><verse number="32" style="v" sid="EXO 21:32" />Yakhalhaka ing'ope inoomwiiva ipotta nlhopwana ama nthiyana, mwanene ing'ope uyo anlhiveke mwanene ipotta uyo nchurukhu, ishekeli makhobilhi makhumi mararu. Ni ing'ope iyo yiiviyeke wo waatiya malhuku.<verse eid="EXO 21:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 21:33" />“Ntu athipaka nlhikiti ni uhiya wo uhikhunelha, ing'ope ama iphuta yatumbuchiraka mwommo, <verse eid="EXO 21:33" /><verse number="34" style="v" sid="EXO 21:34" />yoyo thipilhe nlhikiti nno anlhiveke mwanene mwannama uyo, ni mwannama khwilhe uyo nookhalha a ntu thipilhe nlhikiti uyo.<verse eid="EXO 21:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 21:35" />“Ing'ope ya ntu yarakalhihaka ing'ope ya ntu nkina ni wiiva, paahi attu athumiheke yeyo ing'ope ihanlhe ikumi iyo ni ukawana nchurukhu unohalha upattiya uyo. Tho, akawanacheke ing'ope yiiviye iyo. <verse eid="EXO 21:35" /><verse number="36" style="v" sid="EXO 21:36" />Nansho yakhalhaka ing'ope iyo yaholhemalhelha waahoma inyaka ashinama akina, ni mwanene uyo khattunke, paahi yoyo mwanene uyo ing'ope uyo noolhiva. Ni iyo yiiviye iyo inookhalha yawawe.<verse eid="EXO 21:36" /></para>
  <chapter eid="EXO 21" />
  <chapter number="22" style="c" sid="EXO 22" />
  <para style="s1">Malhehero anaacha ulhivana</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 22:1" />“Ntu eiyaka ing'ope ama ikhondoro nkaahitha ama nkaathumiha, noolhivihiya ing'ope nthanu wo kila ing'ope, ni ikhondoro ncheshe wo kila ikhondoro iyilhe awe. <verse eid="EXO 22:1" /><verse number="2" style="v" sid="EXO 22:2" />Ntu o wiiya avariyaka aphomolhaka inupa uhiyu, aatiyaka mpaka ukhwa, ntu mwiivilhe uyo khanohukumulhiya wiira heeva. <verse eid="EXO 22:2" /><verse number="3" style="v" sid="EXO 22:3" />Nansho owiiya uyo avariyaka nchuwa ninashilhe ni wiiviya, owiiva uyo nookhalha ni nlhatu wo uhukumulhiya.</para>
  <para style="p" vid="EXO 22:3">“O wiiya avariyaka, alhiveke, nansho akhalhaka kharina ittu yo ulhiva, paahi etu athumihiyeke mwanene uyo wiira alhive ittu iyilhe awe. <verse eid="EXO 22:3" /><verse number="4" style="v" sid="EXO 22:4" />Yakhalhaka mwannama eeiye uyo noophwanyiya wa yoyo owiiya uyo nari nkumi, paahi owiiya uyo noolhiva mikwaha miilhi, ikhalhe ing'ope, iphuta ama ikhondoro.<verse eid="EXO 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 22:5" />“Ntu aalhihaka ashinama awe mmatani mwaalhiye izabibu ama unhiyerera mwannama awe ulhia mmatani mwa ntu nkina, noolhiva choolhia chonkhaye cho mmatani mwawe ama imata awe yo izabibu.<verse eid="EXO 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 22:6" />“Ntu apharihelhaka mooro mmatani mwawe, nkawaavara ithuphi ni uwanelha mpaka nkawaapaha makhupi o choolhia, ama choolhia cha ntu nkina chihinakhunguriya mmatani, ama imata yoothene nkayaavia, ntu pahilhe mooro uyo alhiveke ihasara yonkhaye.<verse eid="EXO 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 22:7" />“Ntu ammahaka nkhunanawe nchurukhu ama nhakhu nkina wiira anshungelhe, nkaiyeriya unupani wawe, owiiya uyo avariyaka alhiveke mikwaha miilhi nchurukhu wiiyiilhe awe uyo. <verse eid="EXO 22:7" /><verse number="8" style="v" sid="EXO 22:8" />Nansho owiiya uyo aahivariyeke, anene inupa ayo arweeke inupa yo ulhapelhiya Apwiiya Nlhuku, yoonie wiira kahii yayo eyilhe nhakhu wa nkhunanaya uyo.<verse eid="EXO 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 22:9" />“Yakhalhaka attu elhi anowaatakanelha ing'ope ama iphuta ama ikhondoro ama ikuwo ama ittu iriyoothe yaapotenre ni kila mmoka nohimia wiira yawawe, oyelhi awiihiyeke inupa yo ulhapelhiya Apwiiya Nlhuku. Uyo nohalha uhukumulhiya wiira hotteka uyo, anlhiveke nkhunanawe uyo mikwaha miilhi.<verse eid="EXO 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 22:10" />“Ntu ammahaka nkhunanawe iphuta ama ing'ope ama ikhondoro ama mwannama nkina riyoothe wiira anhuwe, ni mwannama uyo nkaakhwa ama nkaarakalha ama nkayaaweiya wo uhikhalha ntu riyoothe onne, <verse eid="EXO 22:10" /><verse number="11" style="v" sid="EXO 22:11" />arweeke inupa yo ulhapelhiya Apwiiya Nlhuku ni ulhupelha, wo waamulha variyari aya, wooniha wiira ntu aavahiye uyo kheiyilhe nhakhu wa nkhunanawe uyo. Mwanene mwannama uyo arumelhelheke naapo nno, ni nkhunanawe uyo khanolhivihiya ittu iriyoothe. <verse eid="EXO 22:11" /><verse number="12" style="v" sid="EXO 22:12" />Nansho yakhalhaka mwannama eeiye uwannyawe, anlhiveke mwanene mwannama uyo. <verse eid="EXO 22:12" /><verse number="13" style="v" sid="EXO 22:13" />Yakhalhaka yoyo mwannama uyo eeviye ni nshene, ntu aavahiye unhuwa mwannama uyo awiiheke mahalhahalha o mwannama uyo wiira oonecheshe. Khanolhiva ittu iriyoothe ukhalhawaya eeviye ni nshene.<verse eid="EXO 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 22:14" />“Ntu amwaashimaka mwannama a nkhunanawe, mwannama uyo nkaarakalha ama nkaakhwa mwanene uyo hiriwo, ntu mwaashimme mwannama uyo alhiveke. <verse eid="EXO 22:14" /><verse number="15" style="v" sid="EXO 22:15" />Nansho yakhalhaka mwanene uyo ahaatama, paahi ntu aashimihe uyo khanolhivihiya ittu iriyoothe. Yakhalhaka mwannama uyo aari o waashimihiya wo malhivo, mwanene uyo apochereke malhivo eewananiye mpacho ayo.<verse eid="EXO 22:15" /></para>
  <para style="s1">Malhehero anaacha makhalhelho o kila nihuku</para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 22:16" />“Ntu antongosaka mwalhi hinaatameriya ni nlhopwana, nkanrupana, akumiheke mahari ni unthelha mwalhi uyo. <verse eid="EXO 22:16" /><verse number="17" style="v" sid="EXO 22:17" />Nansho athumwanawe mwalhi uyo akhotaka menamena unthelhiha mwaamwanaya uyo, ntu uyo alhiveke nchurukhu wo mahari unothananiya wo mwalhi hinaatameriya ni nlhopwana.<verse eid="EXO 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 22:18" />“Nthiyana nkhwiri hihiiye ukhalha nkumi, eeviyeke.<verse eid="EXO 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 22:19" />“Ntu nonthelha mwannama, eeviyeke.<verse eid="EXO 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 22:20" />“Ntu riyoothe nokumiha isadaka wa milhuku chikina, aahikhalhe Apwiiya Nlhuku, yoyo eeviyeke.<verse eid="EXO 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 22:21" />“Nhimpangelhe ichimwa nlheto, mena umpangelha ittu yo uhilhoka, ukhalhawaya ni inyu mwaatti mwaari alheto chiicho Umisri. <verse eid="EXO 22:21" /><verse number="22" style="v" sid="EXO 22:22" />Nhipangelhe chittu cho uhilhoka nankhwelhi ama mwaana ohiiya. <verse eid="EXO 22:22" /><verse number="23" style="v" sid="EXO 22:23" />Mwaapangelhaka chittu cho uhilhoka yayo manyaattu ayo, ni mii nkakeewa ikutto aya, wo ikekhiaye kinoweewelhelha ikutto aya. <verse eid="EXO 22:23" /><verse number="24" style="v" sid="EXO 22:24" />Ni mii kinoorushiya, kinoowiivani mwaatti vanorwaa inyu ukhotoni, manyaahanu inyu anookhalha manyanankhwelhi, ni achishaana inyu anookhalha ohiiya chiicho.<verse eid="EXO 22:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 22:25" />“Mwamwaashimihaka ntu riyoothe nchurukhu munlhokoni mwa attu aka amashikini, nkhalheke thoko khannamwaashimiha, ni mena nhikohe ifaida yo vachulhu. <verse eid="EXO 22:25" /><verse number="26" style="v" sid="EXO 22:26" />Mwakushaka ikuwo yo nkhunaninyu nkamwaavarelha imboote, munhokolhoshereke nchuwa nihinaaya wiilha, <verse eid="EXO 22:26" /><verse number="27" style="v" sid="EXO 22:27" />ukhalhawaya yeyo phi ikuwo inokhulhuvelha awe, phi nekhunelha awe. Ama nnaanyihera nohalha wiikhunelhani? Vanohalha awe ukunlhelha vawo, kinowiiwa ikutto awe, ukhalhawaya mii o ikiriri.<verse eid="EXO 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 22:28" />“Nhinruwane Nlhuku, mena nhinruwane nholhelhi a attu inyu.<verse eid="EXO 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 22:29" />“Nhipiche ukumiha mpatta unokhuma nchoolhiani nruwenrie inyu ni idivai inyu.</para>
  <para style="p" vid="EXO 22:29">“Nkivaheke achishaana inyu ashilhopwana o nttara. <verse eid="EXO 22:29" /><verse number="30" style="v" sid="EXO 22:30" />Nkivaheke chiicho mattara o ing'ope ni ikhondoro chinyu. Munhiyeke mwannama nlhopwana o nttara uyo akhalheke ni anumwanawe mahuku saba, nihuku no nane nkivaheke mii.<verse eid="EXO 22:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 22:31" />“Mwaatti phi attu aka athanlhiye. Paahi nhikhure inama yo mwannama eeviye ni nshene. Yeyo inama iyo arihelhiyeke ashipwa.<verse eid="EXO 22:31" /></para>
  <chapter eid="EXO 22" />
  <chapter number="23" style="c" sid="EXO 23" />
  <para style="s1">Mwaalhoheke rata attu ni ashinama</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 23:1" />“Nhihimiache chittu cho woothiya. Ni mena nhinkavihe ntu o uhilhoka wiira munhimiecheshe vanoothacha awe. <verse eid="EXO 23:1" /><verse number="2" style="v" sid="EXO 23:2" />Nhilhutaane ni nlhoko wa attu anopanga chittu cho uhilhoka, mena nhilhutaane ni attu anohimiacha chittu cho woothiya umilhatuni, wiira arukunushe ikekhia. <verse eid="EXO 23:2" /><verse number="3" style="v" sid="EXO 23:3" />Nhoothache wiira munkavihere ntu nshikini umilhatuni.<verse eid="EXO 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 23:4" />“Mwoonaka ing'ope ama iphuta ya mmalhaponi inyu inapotenre, munhokholhoshereke mwanene. <verse eid="EXO 23:4" /><verse number="5" style="v" sid="EXO 23:5" />Mwoonaka iphuta ya ntu noovengani inawulhuwilhe ni nsigo aya, munkaviheke ntu uyo weemesha iphuta awe iyo, mena nhivire nkamwaarwa.<verse eid="EXO 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 23:6" />“Nhirukunushe ikekhiaye ya ntu nshikini umilhatuni wawe. <verse eid="EXO 23:6" /><verse number="7" style="v" sid="EXO 23:7" />Nhootherie attu, ni mena nhiive attu anopanga moombone ni o ikekhiaye. Ukhalhawaya akinonhiyerera ntu o uwonya. <verse eid="EXO 23:7" /><verse number="8" style="v" sid="EXO 23:8" />Nhipochere nchurukhu wo uhongiya, ukhalhawaya yoyo unowaahelha uhoona ahoolhelhi, ni urukunusha ikekhia ya attu anopanga moombone.<verse eid="EXO 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 23:9" />“Nhaapangelhe ichimwa alheto, ukhalhawaya mwaattiva nhochuwelha nlheto chinokhalha awe, ukhalhawaya ni inyu mwaari alheto Umisri.<verse eid="EXO 23:9" /></para>
  <para style="s1">Iyaakha yo saba ni Nihuku no Wiittuwa</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 23:10" />“Iyaakha sita mwaalheke choolhia mmamatani mwinyu ni ukhungura choolhia chiyo. <verse eid="EXO 23:10" /><verse number="11" style="v" sid="EXO 23:11" />Nansho iyaakha yo saba, nhiyeke imata chinyu wo uhaalha imbeyu, wiira amashikini mmilhokoni mwa attu inyu arokottache mahalhahalha o choolhia mmamatani mwinyu mmo ni ashinama o mwiithuphini alhiache. Mpangeke chiichammo imata chinyu cho izabibu ni cho izeituni.<verse eid="EXO 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 23:12" />“Wo mahuku sita nvareke ntheko inyu, nansho nihuku no saba mwiittuweke, wiira ing'ope chinyu ni iphuta chinyu chiittuweke. Ni ipotta chinyu ni anamitheko alheto ettuwacheke. <verse eid="EXO 23:12" /><verse number="13" style="v" sid="EXO 23:13" />Mvarechesheke malhove onkhaye kuhimenrieakani. Nhiromolhe machina o milhuku chikina ata vakani, yayo ahiiwaanie mmalhakuni mwinyu.<verse eid="EXO 23:13" /></para>
  <para style="s1">Isikukuu chulhupalhe ttaru</para>
  <para style="r">(<ref loc="EXO 34:18-26">Utt 34:18-26</ref>; <ref loc="DEU 16:1-17">Itor 16:1-17</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 23:14" />“Nttapelhelheke ni upanga isikukuu mikwaha miraru kila iyaakha ukithimicha mii. <verse eid="EXO 23:14" /><verse number="15" style="v" sid="EXO 23:15" />Mpangeke isikukuu yo mikatte cho uhihelhiya ihengedure mahuku saba, thoko chaalhehenre aka. Mpangeke ikatema ithanlhiye upangiya mweeri wo Habibu, ukhalhawaya yoyo phi mweeri waathamme inyu Umisri. Ntu riyoothe hiwe umihoolho waka, wo uhikusha ittu.<verse eid="EXO 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 23:16" />“Mpangeke isikukuu yo milhipu cho upacha cho ntheko inyu ni yo milhipu cho mmamatani mwinyu.</para>
  <para style="p" vid="EXO 23:16">“Mpangeke Isikukuu yo Nlhalha kila vanochokholha inyu ukhungura choolhia mmamatani mwinyu. <verse eid="EXO 23:16" /><verse number="17" style="v" sid="EXO 23:17" />Kila iyaakha manyaalhopwana onkhaye akumaaneke mikwaha miraru, umihoolho waka mii Apwiiya Nlhuku.<verse eid="EXO 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 23:18" />“Nhikumihe isadaka yo nkatte uhelhiye ihengedure vanokumiha inyu isadaka ya ashinama uwannyaka. Ni mena nhihiye makhura a ashinama ayo mpaka wichishu wo nihuku no nayelhi.<verse eid="EXO 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 23:19" />“Kila iyaakha, vanokhungura inyu mmamatani mwinyu, mmwiiheke isadaka yo milhipu unupani waka mii Apwiiya Nlhuku inyu.</para>
  <para style="p" vid="EXO 23:19">“Nhaapie inama yo mwaakhondoro ama yo mwaapuri ni mapelhe a anumwanawe.<verse eid="EXO 23:19" /></para>
  <para style="s1">Malhehano ni malheheriyo</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 23:20" />“Mwooneke, Mii kinonruma nnepa oholhelheni munkwahani mwinyu wiira opiheni rata mwiilhaponi kuweshenreakani. <verse eid="EXO 23:20" /><verse number="21" style="v" sid="EXO 23:21" />Mmwiwelhelheke ni urumelhelha ittu iriyoothe inohalha awe uhimeriani. Nhinttekelhe ukhalhawaya mii kihonruma wo nchina naka, ni mena khanouhiyererani mena uwonya. <verse eid="EXO 23:21" /><verse number="22" style="v" sid="EXO 23:22" />Nansho mwamwiiwelhelhaka rata ni upanga chittu chonkhaye chinohimia awe, mii kinowaatakana ni amalhaponi inyu onkhaye. <verse eid="EXO 23:22" /><verse number="23" style="v" sid="EXO 23:23" />Nnepa aka unouholhelhani ni upihani ilhapo ya attu o Uamori, attu o Uhiti, attu o Uperizi, attu o Ukanaani, attu o Uhivi ni attu o Uyebusi, ni mii kinowaarimelhiha onkhaye ayo. <verse eid="EXO 23:23" /><verse number="24" style="v" sid="EXO 23:24" />Paahi etu nhikhoromelhe milhuku chaya wiira nthimiche, mena uvara mitheko chaya, mena uttwariha chittu chaya. Nansho nhararieke ni upweshakacha mapoto anothimicha aya.<verse eid="EXO 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 23:25" />“Nkithimicheke mii Apwiiya Nlhuku inyu. Ni mii kinouvahani ibarakha yo choolhia ni maashi, ni uthamiha mareta munlhokoni mwinyu. <verse eid="EXO 23:25" /><verse number="26" style="v" sid="EXO 23:26" />Khanowa aakhalha nthiyana nohalha urihakacha mena uhiyara mwiilhaponi mwinyu. Ni mii kinouvaherani ukumi wo iyaakha chinchi.<verse eid="EXO 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 23:27" />“Kinowoopopiha attu onkhaye anouvingani mwaatti wiira owooveni, ni waakukureha attu onkhaye anohalha inyu waanana, kinowaarukunusha amalhaponi inyu oottaweni. <verse eid="EXO 23:27" /><verse number="28" style="v" sid="EXO 23:28" />Kinoowiiha matendehu umihoolho winyu, wiira yoomolhache attu o Uhivi, attu o Ukanaani ni attu o Uhiti. <verse eid="EXO 23:28" /><verse number="29" style="v" sid="EXO 23:29" />Akinaathamiha yayo attu ayo iyaakha imoka, wiira ilhapo ihikhalhe chiicho, ashinama o mwiithuphini ahiwe onchereria ni upwahani machiri. <verse eid="EXO 23:29" /><verse number="30" style="v" sid="EXO 23:30" />Nansho kinowaawukulha vakani vakani mpaka vanohalha inyu uwanelha ni uvarelha ilhapo iyo. <verse eid="EXO 23:30" /><verse number="31" style="v" sid="EXO 23:31" />Miinano cho ilhapo inyu iyo chinowa ukhalha ukhuma ibahari yo Ushamu mpaka ibahari yo Umedeteraniya. Ni ukhuma uthakoni mpaka mwoolhoko wo Yufrati. Ukhalhawaya kinowaahelha mmathathani mwinyu anenchi o yeyo ilhapo iyo, ni inyu nnowoomolha wiira athamache. <verse eid="EXO 23:31" /><verse number="32" style="v" sid="EXO 23:32" />Nhilhehane ittu iriyoothe ni yayo attu ayo, mena ni milhuku chaya. <verse eid="EXO 23:32" /><verse number="33" style="v" sid="EXO 23:33" />Nhaahiyerere wiira akhalhe mwiilhaponi mwinyu, ahiwe owonyihani nkamwaakiwonya mii. Ukhalhawaya mwavaraka mitheko cho milhuku chaya chiyo, wo ikekhiaye vavawo nnoowaya munriankhoni mwaya.”<verse eid="EXO 23:33" /></para>
  <chapter eid="EXO 23" />
  <chapter number="24" style="c" sid="EXO 24" />
  <para style="s1">Malhehano a Nlhuku ni Aisraeli anoottukiya mwaavi</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 24:1" />Apwiiya Nlhuku nkayeerelha ashinna Musa wiira, “Mmweeke umwaakoni, inyuva ni Naharuni ni Naabihu vamoka ni ashulhupalhe makhumi saba a Aisraeli, mwakhoromeke vanaatameria inyu mwaako ni ukithimicha. <verse eid="EXO 24:1" /><verse number="2" style="v" sid="EXO 24:2" />Inyuva ashinna Musa vekha inyu phi nohalha ukaatameria, nansho akina ahiwe ukaatameria, ni mena Aisraeli ayo ahiwelhache umwaakoni vamoka ni inyu.”<verse eid="EXO 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 24:3" />Paahi, ashinna Musa nkayarwaa uwaahimeriani attu onkhaye malhove ni malhehero onkhaye a Apwiiya Nlhuku alheheriye aya. Attu onkhaye nkayaakhulha wo nlhove nimoka yeeraka, “Ninoopanga chonkhaye chihimiye ni Apwiiya Nlhuku.” <verse eid="EXO 24:3" /><verse number="4" style="v" sid="EXO 24:4" />Ashinna Musa aholhepa malhehero onkhaye aavahiye aya ni Apwiiya Nlhuku.</para>
  <para style="p" vid="EXO 24:4">Mapikoosha o nihuku no nayelhi, ahotheka madhubahu o malhuku wuuthi mwaako. Nkayeemesha ni mapoto o malhuku khumi ni meelhi wo ulhikaana ni makosho khumi ni meelhi a Aisraeli. <verse eid="EXO 24:4" /><verse number="5" style="v" sid="EXO 24:5" />Yamalheke ahaaruma ashimirawo Aisraeli wiira yakumihe isadaka cho upahiya wa Apwiiya Nlhuku, ni waahithelha ashing'ope madume o isadaka cho ulhiya ni attu. <verse eid="EXO 24:5" /><verse number="6" style="v" sid="EXO 24:6" />Ashinna Musa nkayaarika iphome vakani ya ashinama ayo ni weesha nnibirikani, ni iphome ikina iyo nkayaamicha vamadhubahuni. <verse eid="EXO 24:6" /><verse number="7" style="v" sid="EXO 24:7" />Yamalheke ahokusha ikitabu yo malhehano a Apwiiya Nlhuku, nkayaashoma umihoolho wa attu. Ni attu ayo nkayeera, “Ninoopanga chonkhaye chihihimiye ni Apwiiya Nlhuku, ni urumelhelha.” <verse eid="EXO 24:7" /><verse number="8" style="v" sid="EXO 24:8" />Paahi ashinna Musa nkayaakusha iphome yaari nnibirikani ilhe ni waamichera attu, yiiraka, “Ilha phi iphome yo malhehano a Apwiiya Nlhuku, enshe aya ni inyu mwaatti thoko malhove aya onkhaye alha.”<verse eid="EXO 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 24:9" />Yamalheke ashinna Musa yahowelha umwaakoni, vamoka ni Naharuni, Naadabu ni Naabihu ni ashulhupalhe makhumi saba o Aisraeli, <verse eid="EXO 24:9" /><verse number="10" style="v" sid="EXO 24:10" />nkayaamwona Nlhuku a Aisraeli. Vaanyikanlhe awe mieto chawe, wahokhalha ittu thoko mmuto wo malhuku o johari, o woonia nkwee thoko irimu. <verse eid="EXO 24:10" /><verse number="11" style="v" sid="EXO 24:11" />Nansho Nlhuku khaapannge ittu iriyoothe yo uhilhoka wo yayo ahoolhelhi a Aisraeli ayo. Yahomwoona Nlhuku, nkayaalhia ni uwuria.<verse eid="EXO 24:11" /></para>
  <para style="s1">Ashinna Musa umwaakoni Usinai</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 24:12" />Apwiiya Nlhuku nkayeehana ashinna Musa, “Mmweeke uwannyaka umwaakoni uno, nkilhitelhelhe wowo. Mii kinouvahani ivibau piilhi cho malhuku chilhepiye malhehero ni malheheriyo kilhempe aka wo nlhatu no weettuchiha Aisraeli.” <verse eid="EXO 24:12" /><verse number="13" style="v" sid="EXO 24:13" />Paahi, ashinna Musa nkayaarwa vamoka ni Nayoshua, namitheko aya, nkayaawelha umwaakoni wa Nlhuku.<verse eid="EXO 24:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 24:14" />Nansho ahinaya urwaa, ashinna Musa yaheerelha ashulhupalhe alhe wiira, “Nnilhiteke va mpaka vanohohalha ihu uhokolhelhani. Naharuni ni Nahuri ari vamoka ni inyu, riyoothe rii ni nlhove aarwelheke yayo manyaattu ayo.”<verse eid="EXO 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 24:15" />Paahi, ashinna Musa nkayaarwa umwaakoni, ni nihute nkanaakhunelha mwaako. <verse eid="EXO 24:15" /><verse number="16" style="v" sid="EXO 24:16" />Nthimicho wa Apwiiya Nlhuku nkawaakhuruwa vachulhu mwaako wo Usinai ni nihute nahokhunelha mwaako uyo wo mahuku sita. Nihuku no saba Nlhuku aheehana ashinna Musa ukhuma variyari nihute nne. <verse eid="EXO 24:16" /><verse number="17" style="v" sid="EXO 24:17" />Nthimicho wa Apwiiya Nlhuku wahaaria mmiithoni mwa Aisraeli thoko mooro unoparelha vachulhu mwaako. <verse eid="EXO 24:17" /><verse number="18" style="v" sid="EXO 24:18" />Ashinna Musa nkayaawelha umwaakoni, nkayaakelha nnihuteni mmo. Nkayaakhalha wowo mahuku makhumi ncheshe, uthana ni uhiyu.<verse eid="EXO 24:18" /></para>
  <chapter eid="EXO 24" />
  <chapter number="25" style="c" sid="EXO 25" />
  <para style="s1">Nlhuku nowaavaha ashinna Musa malhehero o Nihema Nitakatifu</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 25:1" />Apwiiya Nlhuku nkayeerelha ashinna Musa, <verse eid="EXO 25:1" /><verse number="2" style="v" sid="EXO 25:2" />“Mweerelhe Aisraeli wiira awiihe izawadi uwannyaka. Mpochereke wa attu ayo ittu iriyoothe inothanana aya ukumiha uwannyaka. <verse eid="EXO 25:2" /><verse number="3" style="v" sid="EXO 25:3" />Chi phi chittu chinohalha inyu upochera chiyo, idhahabu, isiliva, ishaaba, <verse eid="EXO 25:3" /><verse number="4" style="v" sid="EXO 25:4" />nttoche no mapururu o ikhondoro no kibuluu, no zambarau ni no khwiilha. Ikuwo yooteelha, yorera, ni mapururu o ipuri, <verse eid="EXO 25:4" /><verse number="5" style="v" sid="EXO 25:5" />marapalha o ikhondoro chilhopwana chihelhiye irangi yokhwilha, marapalha o ipuri, imbau cho nsonobari, <verse eid="EXO 25:5" /><verse number="6" style="v" sid="EXO 25:6" />makhura o ikhandiri, chittu cho uhelhiya makhura o unukhelha o uttukuria chittu, ubani wo unukhelha chinene, <verse eid="EXO 25:6" /><verse number="7" style="v" sid="EXO 25:7" />malhuku o nhakhu aneehaniya sadoniki ni malhuku makina o utottelhiya ikuwo yo ukhunelha ikhakacha ya opochera ishaani ni nrupa wo vakhakaachani.<verse eid="EXO 25:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 25:8" />“Tho, attu ayo akithekelheke Nihema Nitakatifu wiira kikhalhe munlhokoni mwinyu. <verse eid="EXO 25:8" /><verse number="9" style="v" sid="EXO 25:9" />Athekeke Nihema ni ukoorosha chittu cho nhina mmo thoko chinohalha aka uwoonihani.<verse eid="EXO 25:9" /></para>
  <para style="s1">Nisanduku no Malhehano</para>
  <para style="r">(<ref loc="EXO 37:1-9">Utt 37:1-9</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 25:10" />“Nkoorosheke nisanduku no imbau cho nsonobari no urekama miono micheshe, ukhanuwa miono miilhi ni nchusha miono miilhi. <verse eid="EXO 25:10" /><verse number="11" style="v" sid="EXO 25:11" />Nhikeke idhahabu yorera nhina ni vathe, ni urukureeriha nreko wo idhahabu mipata chonkhaye. <verse eid="EXO 25:11" /><verse number="12" style="v" sid="EXO 25:12" />Tho nkooroshelheke ibangili ncheshe cho idhahabu, cho uwariha mieto chaya ncheshe, ibangili piilhi mpatta mmoka, ni ibangili piilhi mpata nkina. <verse eid="EXO 25:12" /><verse number="13" style="v" sid="EXO 25:13" />Nhemeke miri cho nsegasega cho n'johoro, ni chiyo nhikeke idhahabu. <verse eid="EXO 25:13" /><verse number="14" style="v" sid="EXO 25:14" />Mmiriheke chechiyo mishaamu chiyo mbangilini mwo mipata miilhi cho nisanduku chiyo, wiira noorie ukushiya. <verse eid="EXO 25:14" /><verse number="15" style="v" sid="EXO 25:15" />Chechiyo mishaamu chiyo chikhalheke mwommo mahuku onkhaye, chihithamihiye mena. <verse eid="EXO 25:15" /><verse number="16" style="v" sid="EXO 25:16" />Munisandukuni mmo, mweesheke ivibau piilhi cho malhuku chilhepilhe aka malheheriyo aka.<verse eid="EXO 25:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 25:17" />“Mwamalhihaka, nkoorosheke ikifuniko yo idhahabu yorera, vaneehaniya nipuro no woonelhiya attu ikiriri. Urekama waya miono miilhi ni nusu ni makhuvi aya moono mmoka ni nusu. <verse eid="EXO 25:17" /><verse number="18" style="v" sid="EXO 25:18" />Tho, nhaneke idhahabu yorera, mwaapangacheke o wuupiya o mapupha o wookwa elhi, anolhikaana ni amakerubi, mweesheke mwisho wo ikifuniko iyo uno ni uno, <verse eid="EXO 25:18" /><verse number="19" style="v" sid="EXO 25:19" />mmoka mwisho mmoka ni nkina mwisho nkina. Akhalheke vachulhu vawo, nansho avaraaneke, akhalheke ittu imoka ni ikifuniko iyo. <verse eid="EXO 25:19" /><verse number="20" style="v" sid="EXO 25:20" />Awehaneke, mapupha aya anookwelhe ni ukhunelha ikifuniko iyo, anooromenlhe. <verse eid="EXO 25:20" /><verse number="21" style="v" sid="EXO 25:21" />Mweesheke ivibau piilhi chinohalha aka uvahani chiyo munisandukuni mmo. Mwamalhaka, nkhunelheke ikifuniko iyo vachulhu nisanduku vawo. <verse eid="EXO 25:21" /><verse number="22" style="v" sid="EXO 25:22" />Mii kinoukumaanani vavawo, vachulhu nisanduku vawo, variyari wa amakerubi elhi vawo. Kinowa uwulhumanani ni uvahani malheheriyo o waahimeria Aisraeli.<verse eid="EXO 25:22" /></para>
  <para style="s1">Imeza yo weeshiya Mikatte chikumihiye wa Apwiiya Nlhuku</para>
  <para style="r">(<ref loc="EXO 37:10-16">Utt 37:10-16</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 25:23" />“Nkoorosheke imeza yo imbau cho n'johoro yo urekama miono micheshe, ukhanuwa moono mmoka ni nusu ni nchusha naya miono miraru. <verse eid="EXO 25:23" /><verse number="24" style="v" sid="EXO 25:24" />Nhikeke imeza iyo idhahabu yorera ni urukureeriha nreko wo idhahabu mipata chonkhaye. <verse eid="EXO 25:24" /><verse number="25" style="v" sid="EXO 25:25" />Mwamalhihaka, nrukureeriheke vachulhu vawo ikibau yo ukhanuwa iinchi ttaru wiira chittu chihimore. Nrukureeriheke ni nreko wo idhahabu yo rera mipata chonkhaye. <verse eid="EXO 25:25" /><verse number="26" style="v" sid="EXO 25:26" />Nkoorosheke ibangili ncheshe cho idhahabu ni uwariha ikhoona ncheshe cho mieto chaya micheshe chiyo. <verse eid="EXO 25:26" /><verse number="27" style="v" sid="EXO 25:27" />Ibangili chiyo chipharelhelhihiyeke vakhiviru ni ubau unorukureria vachulhu uyo, wiira chithathelhiye nisanduku nno. <verse eid="EXO 25:27" /><verse number="28" style="v" sid="EXO 25:28" />Nkoorosheke mishaamu miilhi cho n'johoro ni uhika idhahabu. Phi mishaamu cho uthathelha imeza iyo. <verse eid="EXO 25:28" /><verse number="29" style="v" sid="EXO 25:29" />Tho, nkoorosheke isahani ni ikikombe, nkawo ni inyipo cho uhelhiya isadaka cho uwuriya. Chonkhaye chiyo nkoorosheke wo idhahabu yorera. <verse eid="EXO 25:29" /><verse number="30" style="v" sid="EXO 25:30" />Mweesheke imeza iyo umihoolho wo Nisanduku no Malhehano. Vachulhu imeza vawo, mweesheke mikatte chikumihiye isadaka chiyo, mahuku onkhaye.<verse eid="EXO 25:30" /></para>
  <para style="s1">Iphata yo uthomeiya ikhandiri</para>
  <para style="r">(<ref loc="EXO 37:17-24">Utt 37:17-24</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 25:31" />“Nkoorosheke iphata yo uthomeiya ikhandiri ihaniye wo idhahabu yorera. Ikhalhelho aya ni nkupu aya chikhalheke ittu imoka. Tho, chihaniyeke wo ulhikaana ni maua, yaani ikikombe chaya, ituva chaya ni maua aya ayo akhalheke ittu imoka. <verse eid="EXO 25:31" /><verse number="32" style="v" sid="EXO 25:32" />Ikhalheke ni iritta sita, iritta ttaru mpatta mmoka ni iritta ttaru mpata nkina. <verse eid="EXO 25:32" /><verse number="33" style="v" sid="EXO 25:33" />Wo kila nritta ukhalheke ikikombe ttaru cho ulhikaana ni ituva cho mwiri wo mlozi, kila imoka ni ituva aya ni niua naya. <verse eid="EXO 25:33" /><verse number="34" style="v" sid="EXO 25:34" />Vachulhu iphata vawo vakhalheke ikikombe ncheshe cho ulhikaana ni maua o mwiri wo nlozi, ituva chaya ni maua aya. <verse eid="EXO 25:34" /><verse number="35" style="v" sid="EXO 25:35" />Vanokhuma iritta sita chiyo, vakhalheke ni nlhuto nimokanimoka wuuthi. <verse eid="EXO 25:35" /><verse number="36" style="v" sid="EXO 25:36" />Mikaanda chiyo ni iritta chiyo chikhalheke ittu imoka ni iphata iyo, ni chonkhaye chihaniyeke wo idhahabu yorera. <verse eid="EXO 25:36" /><verse number="37" style="v" sid="EXO 25:37" />Tho mwaakoorosheke ikhandiri aya saba, ni ayo aparihelhiyeke wiira amwalhie. <verse eid="EXO 25:37" /><verse number="38" style="v" sid="EXO 25:38" />Thothoni tho, nkoorosheke mikasi chikani cho uwukulhelha utambi ni isahani cho uhelha itura, wo idhahabu yorera. <verse eid="EXO 25:38" /><verse number="39" style="v" sid="EXO 25:39" />Nkoorosheke iphata iyo ni chittu chaya chonkhaye chiyo wo idhahabu yorera ikilo makhumi mararu ni nthanu. <verse eid="EXO 25:39" /><verse number="40" style="v" sid="EXO 25:40" />Nkoorosheke rata wo ulhikaana thoko chenre inyu wo woonihiya umwaakoni ulhe.”<verse eid="EXO 25:40" /></para>
  <chapter eid="EXO 25" />
  <chapter number="26" style="c" sid="EXO 26" />
  <para style="s1">Malheheriyo o uthekiya Nihema nitakatifu</para>
  <para style="r">(<ref loc="EXO 36:8-38">Utt 36:8-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 26:1" />“Wo uthepa vavawo, nthekeke Nihema nitakatifu wo mapaziya khumi o ikuwo yooteelha yoorera, ni wo nttoche no mapururu o ikhondoro no irangi yo kibuluu, yo zambarau ni yo khwiilha. Vachulhu mapaziya ayo mfumeke ipicha cho makerubi. <verse eid="EXO 26:1" /><verse number="2" style="v" sid="EXO 26:2" />Kila iyaakerio irekameke miono makhumi ncheshe ni piilhi, makhuvi akhalheke miono sita. Mapaziya onkhaye alhikaaneke uphimiya waya. <verse eid="EXO 26:2" /><verse number="3" style="v" sid="EXO 26:3" />Nlhutaaniheke mapaziya mathanu ukhalha ikipande imoka, ni mathanu makina ayo ikipande imoka. <verse eid="EXO 26:3" /><verse number="4" style="v" sid="EXO 26:4" />Kila ikipande, ntottelheke mikaanda cho kibuluu mminikiye iyaakerio yo mwisho no ikipande yo mpacho ilhe. Tho, ntottelheke mikaanda upande wo mwisho wo iyaakerio yo ikipande yo nayelhi iyo. <verse eid="EXO 26:4" /><verse number="5" style="v" sid="EXO 26:5" />Ntottelheke mikaanda makhumi nthanu iyaakerio imoka ni mikaanda chikina makhumi nthanu yo nayelhi iyo, chonkhaye chiwehaneke. <verse eid="EXO 26:5" /><verse number="6" style="v" sid="EXO 26:6" />Mwamalhihaka, mweesheke mikhoyi cho uvarelhelha iyaakerio makhumi nthanu cho idhahabu cho ulhutaaniha ikipande piilhi cho iyaakerio chiyo, nihema nno nikhalheke ittu imoka.<verse eid="EXO 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 26:7" />“Tho, nkoorosheke yakerio khumi ni nimoka o mapururu o ipuri cho ukhunelha nihema nno. <verse eid="EXO 26:7" /><verse number="8" style="v" sid="EXO 26:8" />Kila iyaakerio irekameke futi makhumi ncheshe ni nthanu, ikhanuweke miono sita. Chonkhaye khumi ni nimoka chilhikaaneke uphimiya waya. <verse eid="EXO 26:8" /><verse number="9" style="v" sid="EXO 26:9" />Nlhutaaniheke iyaakerio sita vamoka, ni iyakerio nthanu vekha aya. Iyaakerio yo sita yo uhoolho wo Nihema uwo, ivilhikiyeke ukhalha nlhako wo ukelha nnihemani mmo. <verse eid="EXO 26:9" /><verse number="10" style="v" sid="EXO 26:10" />Ntottelheke mikaanda makhumi nthanu mwisho wo iyaakerio yo umalhihera iyo munlhokoni mwo ayo chilhutaanihiye vamoka ayo, ni mikaanda makhumi nthanu mwisho wo iyaakerio irii vathe wo chiyo piilhi chilhutaanihiye vamoka chiyo. <verse eid="EXO 26:10" /><verse number="11" style="v" sid="EXO 26:11" />Nkoorosheke ivibaniyo makhumi nthanu cho shaaba cho uvarelhelha nipaziya, ni uttukelhelha mikaanda makhumi nthanu ayo wiira nlhutaanihe mapaziya ayo akhalheke nihema nimoka. <verse eid="EXO 26:11" /><verse number="12" style="v" sid="EXO 26:12" />Ntukelhelheke nusu yo nipaziya nihanlhe nno utulhi wo Nihema uwo. <verse eid="EXO 26:12" /><verse number="13" style="v" sid="EXO 26:13" />Nvilhikeke moono mmoka ni nusu wo nipaziya uhalhenlhe kila mpata uyo, wiira ikhunelhe yeeshe nipirothi no Nihema nno.<verse eid="EXO 26:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 26:14" />“Tho, nkoorosheke mafuniko meelhi o Nihema nno. Nimoka no nrapalha no ikhondoro ilhopwana nihikiye irangi yo khwiilha, nikina no nrapalha nowoolhwa no ipuri.<verse eid="EXO 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 26:15" />“Nkoorosheke ifuremu cho imbau cho n'johoro cho weemesheriya Nihema nno. <verse eid="EXO 26:15" /><verse number="16" style="v" sid="EXO 26:16" />Kila ifuremu irekameke miono khumi ni nthanu, ikhanuweke miono miilhi. <verse eid="EXO 26:16" /><verse number="17" style="v" sid="EXO 26:17" />Ni kila ifuremu ikhalheke ni malhimi meelhi o uvarelhelha wo vathi. Ifuremu chonkhaye chilhikaaneke. <verse eid="EXO 26:17" /><verse number="18" style="v" sid="EXO 26:18" />Nkoorosheke ifuremu makhumi meelhi cho weemesheriya Nihema mpata wo uchawa, <verse eid="EXO 26:18" /><verse number="19" style="v" sid="EXO 26:19" />ikhalhelho cho isiliva makhumi ncheshe, cho weeshiya wuuthi ifuremu makhumi meelhi chiyo. Ikhalhelho piilhi wuuthi ubau mmoka, cho uvarelhelha malhimi meelhi alhe, ni ikhalhelho piilhi wuuthi ifuremu ikina uyo uvarelhelha malhimi meelhi aya ayo. <verse eid="EXO 26:19" /><verse number="20" style="v" sid="EXO 26:20" />Nkoorosheke ifuremu makhumi meelhi cho weemesheriya Nihema mpata wo uchulhu, <verse eid="EXO 26:20" /><verse number="21" style="v" sid="EXO 26:21" />ni ikhalhelho makhumi ncheshe cho shaaba, wuuthi wo kila ifuremu imoka. <verse eid="EXO 26:21" /><verse number="22" style="v" sid="EXO 26:22" />Utulhi Nihema uwo mpata uneelha nchuwa, nkoorosheke ifuremu sita, <verse eid="EXO 26:22" /><verse number="23" style="v" sid="EXO 26:23" />ni ifuremu piilhi cho weemeshiya nkhonani. <verse eid="EXO 26:23" /><verse number="24" style="v" sid="EXO 26:24" />Chechiyo ifuremu cho vakhonani chiyo chilhutaaneke toka vathi mpaka uchulhu. Ifuremu cho piilhi cho vakhonani chiirihiyeke chiicho wiira chilhikaane. <verse eid="EXO 26:24" /><verse number="25" style="v" sid="EXO 26:25" />Tho chikhalheke ifuremu nane ni ikhalhelho chaya khumi ni sita cho isiliva. Ikhalhelho piilhi cho vathi cho kila ifuremu ni ikhalhelho piilhi vathi ifuremu ikina.<verse eid="EXO 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 26:26" />“Nkoorosheke mapoopola o mwiri wo nshita o ulhutaaniha ifuremu chiyo. Mapoopola nthanu o mpata mmoka, <verse eid="EXO 26:26" /><verse number="27" style="v" sid="EXO 26:27" />ni mapoopola nthanu o mpata nkina wo Nihema, ni mapoopola nthanu o mpata uneelha nchuwa, utulhi uwo. <verse eid="EXO 26:27" /><verse number="28" style="v" sid="EXO 26:28" />Nipoopola no variyari, ninottukiya variyari wo Nihema, nikhalheke no ukhuma mwiinano mmoka mpaka mwiinano nkina wo Nihema. <verse eid="EXO 26:28" /><verse number="29" style="v" sid="EXO 26:29" />Nhikeke idhahabu ifuremu chiyo chonkhaye ni upharihelhelha ibangili cho idhahabu cho uvirihiya mishaamu chilhe, chinohalha uhikiya idhahabu ni chiyo. <verse eid="EXO 26:29" /><verse number="30" style="v" sid="EXO 26:30" />Nkoorosheke Nihema nno, no ulhikaana thoko choonihiye inyu umwaakoni.<verse eid="EXO 26:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 26:31" />“Nkoorosheke nipaziya nikina no ikuwo yorera yooteelha. Nifumiyeke wo urata ipicha cha amakerubi vachulhu, wo irangi yo kibuluu, yo zambarau ni yo khwiilha. <verse eid="EXO 26:31" /><verse number="32" style="v" sid="EXO 26:32" />Nkoorosheke mikurio micheshe cho n'johoro chihikiye idhahabu, tho chiri ni ivibaniyo cho uvarelhelha nipaziya ncheshe cho idhahabu. Mweemesheke vachulhu ikhalhelho ncheshe cho isiliva chiyo, ni uthomia nipaziya nno vachulhu waya, nvibaniyoni mmo. <verse eid="EXO 26:32" /><verse number="33" style="v" sid="EXO 26:33" />Mwamalhihaka uthomia nipaziya, mmwiiheke Nisanduku no Malhehano ninari ni ivibau piilhi cho malhuku nhina, utulhi wo nipaziya uwo. Nipaziya nno nimianiheke Vakittu Vatakatifu ni Vakittu Vatakatifu Chinene. <verse eid="EXO 26:33" /><verse number="34" style="v" sid="EXO 26:34" />Mwamalhaka vavawo, nkhunelheke ikifuniko yo Nisanduku no Malhehano nno vachulhu vawo. <verse eid="EXO 26:34" /><verse number="35" style="v" sid="EXO 26:35" />Imeza yo n'johoro ilhe ikhalheke vathe uhoolho wo nipaziya. Ikiango yo ikhandiri, mweesheke mpata wo vathi, ni imeza iyo ikhalheke mpata wo uchulhu.<verse eid="EXO 26:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 26:36" />“Nkoorosheke nlhako wo Nihema nno, wo nipaziya no mapururu o ikhondoro o irangi yo kibuluu, yo zambarau, ni yo khwiilha, ni ikuwo yooteelha yoorera. Nittaviyeke wo urata. <verse eid="EXO 26:36" /><verse number="37" style="v" sid="EXO 26:37" />Tho nkoorosheke mikurio mithanu cho n'johoro cho uthomeiya nipaziya no nlhako. Nhikahikeke idhahabu vachulhu, ni ivibaniyo cho uvarelhelha nipaziya chaya chikhalheke cho idhahabu chiicho. Tho nkooroshelheke ikhalhelho chaya cho shaaba.”<verse eid="EXO 26:37" /></para>
  <chapter eid="EXO 26" />
  <chapter number="27" style="c" sid="EXO 27" />
  <para style="s1">Malhehero anaacha nisanduku no waapahera ashinama</para>
  <para style="r">(<ref loc="EXO 38:1-7">Utt 38:1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 27:1" />“Nkoorosheke ittu thoko nisanduku no ulhikaana kila mpata, no ukhalha madhubahu o waapahera ashinama o isadaka no mwiri wo n'johoro. Nikhalheke no urekama miono nthanu, ukhanuwa miono nthanu, ni nchusha naya miono miraru. <verse eid="EXO 27:1" /><verse number="2" style="v" sid="EXO 27:2" />Nkoorosheke ikhona ncheshe cho madhubahu ayo, ni ikhona chiyo chikhalheke ittu imoka ni nisanduku ninene nno. Nhina nisanduku mmo, nkhuneelheke wo uhika ishaaba. <verse eid="EXO 27:2" /><verse number="3" style="v" sid="EXO 27:3" />Nkoorosheke ni ikaruma chaya, mavalhi o ukukuttelha itura, isepetu cho ukhupelha itura wuuthi madhubahu, inyipo, iyuuma cho urukunushelha inama ni isahani cho uvalhelha mooro. Chonkhaye chikooroshiyeke wo ishaaba. <verse eid="EXO 27:3" /><verse number="4" style="v" sid="EXO 27:4" />Mwamalhakaru, nkoorosheke nttavi no ishaaba no waaneelha inama niwarihiye ibangili ncheshe kila ikhona yo nttavi nno. <verse eid="EXO 27:4" /><verse number="5" style="v" sid="EXO 27:5" />Mweesheke nttavi nno unrekoni wuuthi madhubahu uwo, wiira nttavi nno niphiye variyari madhubahu. <verse eid="EXO 27:5" /><verse number="6" style="v" sid="EXO 27:6" />Tho nkoorosheke mishaamu cho n'johoro cho uthathelha madhubahu ayo. Ni chiyo nhikeke ishaaba. <verse eid="EXO 27:6" /><verse number="7" style="v" sid="EXO 27:7" />Mishaamu chiyo chikelhihiyeke mbangilini mmo, chinaakhalheke mipata miilhi cho madhubahu ayo vanothathiya aya vawo. <verse eid="EXO 27:7" /><verse number="8" style="v" sid="EXO 27:8" />Nisanduku nno nkoorosheke wo imbau, ni nhina nikhalheke mwaari, thoko chenre aka wo uwoonihani umwaakoni ulhe.<verse eid="EXO 27:8" /></para>
  <para style="s1">Ntenje no Nihema Nitakatifu</para>
  <para style="r">(<ref loc="EXO 38:9-20">Utt 38:9-20</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 27:9" />“Nthekeke ntenje vanihemani vawo. Mpata wo utulhi ukhalheke wo nipaziya no ikuwo yooteelha ittaviye rata, mpata mmoka wo ntenje nno urekameke miono imia imoka. <verse eid="EXO 27:9" /><verse number="10" style="v" sid="EXO 27:10" />Mapaziya ayo avarelhelhiyeke ni mikurio makhumi meelhi o ishaaba, ni ikhalhelho chaya makhumi meelhi chiicho cho ishaaba. Nansho ivibaniyo cho uvarelhelha nipaziya ni mapoopola o uchulhu unottukelhelhiya mapaziya alhalheke o isiliva. <verse eid="EXO 27:10" /><verse number="11" style="v" sid="EXO 27:11" />Ikhalheke chiichammo wo mpata wo uchulhu wo ntenje nno. <verse eid="EXO 27:11" /><verse number="12" style="v" sid="EXO 27:12" />Mpata uneelhelha nchuwa ntenje nno, ukhalheke wo nipaziya no urekama miono makhumi nthanu, mikurio khumi ni ikhalhelho khumi. <verse eid="EXO 27:12" /><verse number="13" style="v" sid="EXO 27:13" />Mpata unosha nchuwa, uri nlhako uwo, ukhanuweke miono makhumi nthanu. <verse eid="EXO 27:13" /><verse number="14" style="v" sid="EXO 27:14" />Nipaziya no mpata mmoka wo vanlhakoni nikhalheke miono khumi ni nthanu, mikurio chinaakhalheke miraru ni ikhalhelho ttaru. <verse eid="EXO 27:14" /><verse number="15" style="v" sid="EXO 27:15" />Mpata wo nayelhi ukhalheke chiicho, nipaziya no miono khumi ni nthanu, mikurio chinaakhalheke miraru ni ikhalhelho ttaru. <verse eid="EXO 27:15" /><verse number="16" style="v" sid="EXO 27:16" />Nlhako wo ntenje uyo ukhalheke ni nipaziya no miono makhumi meelhi, no ikuwo yooteelha yorera, ittaviye ni ntu o rata wo uthakanihiya irangi yo kibuluu, zambarau ni yo khwiilha. Ninno nivarelhelhiyeke ni mikurio micheshe ni ikhalhelho chinaakhalheke ncheshe chiicho. <verse eid="EXO 27:16" /><verse number="17" style="v" sid="EXO 27:17" />Mikurio chonkhaye cho urukureria ntenje nno mipata chonkhaye chilhutaanihiyeke ni mapoopola o isiliva, ivibaniyo cho uvarelhelha nipaziya chaya chinaakhalheke cho isiliva nansho ikhalhelho chaya chinaakhalheke cho ishaaba. <verse eid="EXO 27:17" /><verse number="18" style="v" sid="EXO 27:18" />Ntenje nno nitalhiveke miono imia imoka, nikhanuweke miono makhumi nthanu uno ni uno, ni nchusha nikhalheke miono nthanu. Mapaziya aya akhalheke o ikuwo yooteelha yorera, ni ikhalhelho chaya chinaakhalheke cho ishaaba. <verse eid="EXO 27:18" /><verse number="19" style="v" sid="EXO 27:19" />Chittu chikina chonkhaye chinohalha uvarelhiya ntheko wo iphiro iriyoothe Nnihemani, ni ikhomo chaya chonkhaye ni ikhomo cho ntenje chonkhaye, chinaakhalheke cho ishaaba.<verse eid="EXO 27:19" /></para>
  <para style="s1">Malheheriyo anaacha ikhandiri</para>
  <para style="r">(<ref loc="LEV 24:1-4">Ala 24:1-4</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 27:20" />“Mwaalhehereke Aisraeli wiira awiiheke makhura oombone chinene o izeituni o uparihelhelha ikhandiri, wiira ipharelhe mahuku onkhaye. <verse eid="EXO 27:20" /><verse number="21" style="v" sid="EXO 27:21" />Yeemesheke iphata cho uthomeiya ikhandiri wo vathe wo nipaziya, uhoolho wo Nisanduku no Malhehano niri ni ivipande cho malhuku alhempe aka malheheriyo. Naharuni ni achishaana aya alhitelhelheke ikhandiri chiyo vanopharelha aya, toka uchechilho mpaka wichishu. Yayo malheheriyo ayo ashungiyeke ni Aisraeli onkhaye ni achishaana aya wo mahuku onkhaye anowa.”<verse eid="EXO 27:21" /></para>
  <chapter eid="EXO 27" />
  <chapter number="28" style="c" sid="EXO 28" />
  <para style="s1">Mwaha unaacha ikuwo cha Opochera ishaani</para>
  <para style="r">(<ref loc="EXO 39:1-7">Utt 39:1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 28:1" />“Mweehaneke onninyu Naharuni vamoka ni achishaana aya, Nanaadabu, Naabihu, Naeliezeri ni Naithamari, wiira awe aavara ntheko wo upochera ishaani. <verse eid="EXO 28:1" /><verse number="2" style="v" sid="EXO 28:2" />Ni inyu mwaatottelheke onninyu Naharuni ayo ikuwo chitakatifu wiira oonie anashichinre ni ukhalha ni nthimicho. <verse eid="EXO 28:2" /><verse number="3" style="v" sid="EXO 28:3" />Mwaahimerieke attu o utotta ikuwo rata kaavahilhe aka irusho, yaatottelhe Naharuni ikuwo wiira, avaheriye ukhalha opochera ishaani aka. <verse eid="EXO 28:3" /><verse number="4" style="v" sid="EXO 28:4" />Mweerelheke attoteke nrupa wo uwara vakhakaachani, ikuwo yo ukhunelha ikhakacha, ikanzu, nkogo utottiye uttaviye rata, mphumburu ni nshipi. Naharuni vamoka ni achishaana aya awareke chechiyo wiira avare ntheko aka wo upochera ishaani. <verse eid="EXO 28:4" /><verse number="5" style="v" sid="EXO 28:5" />Attu o utotta ikuwo ayo, atotteke wo ikuwo yorera yo irangi yo kibuluu, yo zambarau, yo khwiilha ni yorera yoteelha.<verse eid="EXO 28:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 28:6" />“Atotteke ikuwo yo ukhunelha ikhakacha yo ikuwo yorera yootelha, ni uphwanelhiha rata wo irangi yo kibuluu, yo zambarau, ni yo khwiilha. <verse eid="EXO 28:6" /><verse number="7" style="v" sid="EXO 28:7" />Chikhalhaneke mikaanda miilhi cho uttukelhiya vamakhathani, chilhutaanihiye uno ni uno wiira chittukiyeke vamoka. <verse eid="EXO 28:7" /><verse number="8" style="v" sid="EXO 28:8" />Nkaanda uyo chiicho utottiyeke wo nttoche no idhahabu, utottiyeke ni ukhalha ittu imoka ni ikuwo yo ukhunelha ikhakacha iyo, ni uphwanelhihiya ni ikuwo yorera yo kibuluu, yo zambarau, yo khwiilha ni yorera yoteelha. <verse eid="EXO 28:8" /><verse number="9" style="v" sid="EXO 28:9" />Tho nkusheke malhuku meelhi o isadoniki, nnohalha inyu ukheria machina o makosho a achishaana khumi ni elhi a Nayakhobo vachulhu waya. <verse eid="EXO 28:9" /><verse number="10" style="v" sid="EXO 28:10" />Machina sita nlhuku no upacha ni makina sita ayo nlhuku nikina nno. Machina ayo attwaraaneke thoko chinre aya wo uyaria waya. <verse eid="EXO 28:10" /><verse number="11" style="v" sid="EXO 28:11" />Nkherieke yayo machina ayo vachulhu vawo thoko ntu o uhema chittu chinohema awe nhuri. Mwamalhaka, nreeriheke ni uwariha nhina ittu inovarelhelha ikooroshiye wo idhahabu iyo. <verse eid="EXO 28:11" /><verse number="12" style="v" sid="EXO 28:12" />Yayo malhuku meelhi ayo eeshiyeke vachulhu mikaanda cho ikuwo yo ukhunelha ikhakacha iyo wo woopuwelha makosho khumi ni meelhi a Aisraeli. Paahi Naharuni awareke yayo machina ayo mmakhathani mwaya umihoolho waka mii Apwiiya Nlhuku, wo woopuwelha. <verse eid="EXO 28:12" /><verse number="13" style="v" sid="EXO 28:13" />Nkoorosheke chittu piilhi cho uvarelhelha, cho idhahabu, <verse eid="EXO 28:13" /><verse number="14" style="v" sid="EXO 28:14" />ni mikufu miilhi cho idhahabu yorera, chittaviye thoko ikhwambalha. Nttukelhelheke chechiyo mikufu chiyo nhina ittu yo idhahabu inovarelhelha mmo.<verse eid="EXO 28:14" /></para>
  <para style="s1">Nrupa wo uwariya vakhakaachani</para>
  <para style="r">(<ref loc="EXO 39:8-21">Utt 39:8-21</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 28:15" />“Ntotteke nrupa wo uwariya vakhakaachani, wo uchuwelha mathananelho a Nlhuku. Ukooroshiye rata thoko chitottiye aya ikuwo yo ukhunelha ikhakacha ilhe. Utottiyeke wo ikuwo yorera yoteelha ittaviye rata, ni uphwanelhihiya wo nttoche no idhahabu, no irangi yo kibuluu, yo zambarau ni yo khwiilha. <verse eid="EXO 28:15" /><verse number="16" style="v" sid="EXO 28:16" />Nrupa uyo ulhikaaneke, kila mpata ukhalheke makokho mararu. <verse eid="EXO 28:16" /><verse number="17" style="v" sid="EXO 28:17" />Upambiyeke wo misitari ncheshe cho malhuku o nhakhu. Nsitari wo upacha ukhalheke wo malhuku o iakiki, itopazi ni almasi yo khwiilha. <verse eid="EXO 28:17" /><verse number="18" style="v" sid="EXO 28:18" />Nsitari wo nayelhi upambiyeke malhuku o zumaridi, iyakuti yo kibuluu ni almasi. <verse eid="EXO 28:18" /><verse number="19" style="v" sid="EXO 28:19" />Nsitari wo neraru ukhalheke wo malhuku o yasintho, iakiki yo khwiilha ni amethesito. <verse eid="EXO 28:19" /><verse number="20" style="v" sid="EXO 28:20" />Wo necheshe uyo ukhalheke wo malhuku o zabarajadi, shohamu ni yaspi. Onkhaye ahelhiyeke nhina ittu yo idhahabu inovarelhelha mmo. <verse eid="EXO 28:20" /><verse number="21" style="v" sid="EXO 28:21" />Paahi akhalheke malhuku khumi ni meelhi alhepiye machina o makosho a Aisraeli. Kila nlhuku nimoka neemelhelheke makosho khumi ni meelhi alhe. <verse eid="EXO 28:21" /><verse number="22" style="v" sid="EXO 28:22" />Nrupa wo vakhakaachani uyo nkooroshelheke mikufu cho idhahabu yorera ittaviye thoko ikhwambalha. <verse eid="EXO 28:22" /><verse number="23" style="v" sid="EXO 28:23" />Tho mwaakoorosheke apete elhi o idhahabu o uwarihiya nrupa wo vakhakaachani ni uwariha ikhona piilhi cho nrupa uyo. <verse eid="EXO 28:23" /><verse number="24" style="v" sid="EXO 28:24" />Mmwariheke mikufu miilhi cho idhahabu chittaviye chiyo ikhona piilhi cho pete chiri vachulhu nrupa wo vakhakaachani uyo. <verse eid="EXO 28:24" /><verse number="25" style="v" sid="EXO 28:25" />Ikhona chikina piilhi cho nkufu wo idhahabu chiyo nvaraaniheke chittu cho idhahabu chinovarelhelha piilhi chiyo, ni ikibati ilhe wiira chihihiyane ni ikipande yo ikuwo yo ukhunelha ikhakacha uhoolho waya uwo. <verse eid="EXO 28:25" /><verse number="26" style="v" sid="EXO 28:26" />Tho, mwaakorosheke apete elhi o idhahabu, mmwariheke ikhona piilhi cho nrupa wo vakhakaachani, wo nhina nrupa uyo vachulhu ikuwo yo ukhunelha ikhakacha. <verse eid="EXO 28:26" /><verse number="27" style="v" sid="EXO 28:27" />Tho, mwaakorosheke apete elhi akina o idhahabu mmwariheke ikhona piilhi cho vathi vakizibauni, vanokumaana ikishikizo ni nshipi uttaviye rata uyo. <verse eid="EXO 28:27" /><verse number="28" style="v" sid="EXO 28:28" />Mwamalhaka, ntukelhelheke nrupa uyo vakizibauni wo utukaaniha apete ayo ni nripwe wo kibuluu, wiira nrupa uyo uhithaphuwe nansho ukhalheke vachulhu nshipi uttaviye rata uyo.<verse eid="EXO 28:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 28:29" />“Ni Naharuni vanokelha aya Vakittu Vatakatifu, awareke nrupa ukheriye machina o makosho a Aisraeli. Wo wiira chiicho, mii Apwiiya Nlhuku akinoulhiyalhani mwaatti mena. <verse eid="EXO 28:29" /><verse number="30" style="v" sid="EXO 28:30" />Nhina nrupa uyo nhelheke malhuku o uchuwelhiha mathananelho a Nlhuku aneehaniya Urimu ni Thumimu, wiira Naharuni akusheke vanowa aya umihoolho wa Apwiiya Nlhuku. Paahi Naharuni ikatema chonkhaye awareke, wiira achuwelhe chinothanana aka chinaacha Aisraeli.<verse eid="EXO 28:30" /></para>
  <para style="s1">Ikuwo chikina cha opochera ishaani</para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 28:31" />“Ntotteke ikanzu yo isufu ihelhiye irangi yo kibuluu yo uwarelha ikuwo yo ukhunelha ikhakacha. <verse eid="EXO 28:31" /><verse number="32" style="v" sid="EXO 28:32" />Ikhalheke ni vakittu wo uviriha muru variyari, ni nthotho mwaya weeshiyeke mminiko wo ufumiya wiira ihaahuwe. <verse eid="EXO 28:32" /><verse number="33" style="v" sid="EXO 28:33" />Mminiko wo vathi, uwarihiyeke makomamanga o kibuluu, o zambarau ni o khwiilha. <verse eid="EXO 28:33" /><verse number="34" style="v" sid="EXO 28:34" />Tho, chirukurerihiyeke injuga cho idhahabu variyari makomamanga ayo. <verse eid="EXO 28:34" /><verse number="35" style="v" sid="EXO 28:35" />Naharuni awareke yeyo ikanzu iyo vanovara aya ntheko wo opochera ishaani. Injuga chiyo chiiwanieke vanokelha aya ni ukhuma Vakittu Vatakatifu, umihoolho waka Apwiiya Nlhuku, ni ayo khaneeviya.<verse eid="EXO 28:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 28:36" />“Mwamalhaka, nkoorosheke ikibati yo idhahabu yorera, ni ukheria vachulhu waya thoko ntu chinokheria awe ni nhuri, ‘Ntakatifu wa Apwiiya Nlhuku.’ <verse eid="EXO 28:36" /><verse number="37" style="v" sid="EXO 28:37" />Nttukelhelheke yeyo ikibati yo idhahabu iyo vamphumburuni, uhoolho, wo nripwe wo kibuluu. <verse eid="EXO 28:37" /><verse number="38" style="v" sid="EXO 28:38" />Naharuni awareke yeyo ikibati idhahabu iyo vayuchi. Wo yeyo iphiro iyo anookusha milhatu cha Aisraeli yakhalhaka ahopangacha vanokumiha aya isadaka chaya chitakatifu, ni mii kinoopochera isadaka chaya.<verse eid="EXO 28:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="EXO 28:39" />“Mwaatottelheke Naharuni nkogo woteelha worera ulhepiye rata, ni waatottelha ikofiya yorera yoteelha, ni nshipi uttaviye rata.<verse eid="EXO 28:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="EXO 28:40" />“Mwaatottelhacheke achishaana a Naharuni mikogo, mishipi, ni ikofiya wiira yoonie ahaana nthimicho ni oreracha. <verse eid="EXO 28:40" /><verse number="41" style="v" sid="EXO 28:41" />Mwaawariheke onninyu Naharuni ni achishaana aya chechiyo ikuwo chiyo. Mwamalhaka, mwaahikeke makhura ni weeshera miono wiira oorie uvara ntheko aka. <verse eid="EXO 28:41" /><verse number="42" style="v" sid="EXO 28:42" />Tho mwaatottelheke isuruwali fupi choteelha cho waakhunelha toka nnyununi mpaka mmakuthani, wiira eetiyelhelhe. <verse eid="EXO 28:42" /><verse number="43" style="v" sid="EXO 28:43" />Naharuni ni achishaana aya awareke chechiyo isuruwali fupi chiyo kila vanokelha aya Nihema no nkutano ama vanaatameria aya madhubahu, uvara ntheko wo opochera ishaani Vakittu Vatakatifu. Vavawo anowiitiyelhelha ni woopwaa wiira ahiiviye. Yayo akhalheke malheheriyo o mahuku onkhaye wa Naharuni ni iyari chaya.”<verse eid="EXO 28:43" /></para>
  <chapter eid="EXO 28" />
  <chapter number="29" style="c" sid="EXO 29" />
  <para style="s1">Malheheriyo anaacha Naharuni ni achishaana aya</para>
  <para style="r">(<ref loc="LEV 8:1-36">Ala 8:1-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 29:1" />“Chilha phi chittu chinohalha inyu waapangelha Naharuni ni achishaana aya, yeeshiye umihoolho waka wiira akhalhe opochera ishaani. Mwaakusheke mwaang'ope n'dume mmoka ni ikhondoro madume meelhi o uhiremara. <verse eid="EXO 29:1" /><verse number="2" style="v" sid="EXO 29:2" />Nkusheke iphepa yooshilhia yo ingaano, nkoorosheke mikatte cho uhihelhiya ihengedure ni maandazi o uhihelhiya ihengedure akandiye wo makhura. <verse eid="EXO 29:2" /><verse number="3" style="v" sid="EXO 29:3" />Mwamalhaka, nhelheke mikatte ni maandazi ayo nchikapuni, ni ukumiha isadaka uwannyaka vamoka ni mwaang'ope uyo ni ikhondoro piilhi chiyo.<verse eid="EXO 29:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 29:4" />“Yamalhaka, mwaarweheke Naharuni ni achishaana aya vanlhakoni u Nihema Nitakatifu, mwaattukuriacheke wo maashi. <verse eid="EXO 29:4" /><verse number="5" style="v" sid="EXO 29:5" />Mwamalhihaka vavawo, mwaawariheke Naharuni ikuwo cha opochera ishaani, ikanzu, nkogo, ikuwo yo ukhunelha ikhakacha, nrupa wo vakhakaachani, ni nshipi wo wiittuka nnyununi uttaviye rata ulhe. <verse eid="EXO 29:5" /><verse number="6" style="v" sid="EXO 29:6" />Tho, mwaattukeke mphumburu mmuruni ni waattuka ikibati yo idhahabu ilhepiye nchina ‘Ntakatifu wa Apwiiya Nlhuku’ ilhe, vayuchi. <verse eid="EXO 29:6" /><verse number="7" style="v" sid="EXO 29:7" />Mwamalhihaka upanga chiicho, nkusheke makhura mwaamiinelheke Naharuni vamuruni.<verse eid="EXO 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 29:8" />“Mwamalhihaka vavawo, mwaawiiheke achishaana a Naharuni, mwaawariheke mikogo, <verse eid="EXO 29:8" /><verse number="9" style="v" sid="EXO 29:9" />mwaattukeke mishipi nnyununi ni waattuka miphumburu mmuruni. Chiicho phi nohalha inyu waavaha Naharuni ni iyari aya yonkhaye, ntheko wo opochera ishaani wo mahuku o uhimalha.<verse eid="EXO 29:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 29:10" />“Mwamalhihaka, mummwiiheke mwaang'ope n'dume ulhe, uhoolho wo Nihema Nitakatifu. Naharuni ni achishaana aya yeesheke miono chaya vamuruni wo mwaang'ope uyo. <verse eid="EXO 29:10" /><verse number="11" style="v" sid="EXO 29:11" />Ni inyu munhitheke mwaang'ope uyo umihoolho waka mii, Apwiiya Nlhuku, vanlhakoni Vanihemani vawo. <verse eid="EXO 29:11" /><verse number="12" style="v" sid="EXO 29:12" />Nkusheke iphome awe iyo, nhikeke ikhona cho madhubahu wo nikokho ninyu, ni umiinelha iphome ikina iyo wuuthi nisanduku no upaheriya isadaka nno. <verse eid="EXO 29:12" /><verse number="13" style="v" sid="EXO 29:13" />Mwamalhihaka vavawo, nkusheke makhura onkhaye anokhunelha marupo, ni ithayi yoombone yo ahapa, imphio piilhi, ni makhura arii vachulhu, mpaheke onkhaye vachulhu madhubahu vawo. <verse eid="EXO 29:13" /><verse number="14" style="v" sid="EXO 29:14" />Nansho inama yo mwaang'ope uyo, nrapalha vamoka ni mavi awe ayo, chechiyo mpaheke mooro uchereshere ikambi, ikhalhe isadaka yo uthamiha milhatu cho uwonya winyu.<verse eid="EXO 29:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 29:15" />“Mwamalhihaka vavawo, nkusheke ikhondoro ilhopwana imoka ni weerelha Naharuni ni achishaana aya wiira eesheke miono chaya vamuruni wo ikhondoro iyo. <verse eid="EXO 29:15" /><verse number="16" style="v" sid="EXO 29:16" />Ni inyu nhitheke, ni iphome aya iyo mmichamicheke urukureria nisanduku no madhubahu nno. <verse eid="EXO 29:16" /><verse number="17" style="v" sid="EXO 29:17" />Mwamalhaka, ntupulhacheke ipilhipicha, nhapiheke marupo, mahema ni mieto chaya, ni weesha muru vamoka ni chikina chonkhaye. <verse eid="EXO 29:17" /><verse number="18" style="v" sid="EXO 29:18" />Mwamalhihaka vavawo, mpaheke mooro inama yonkhaye yo ikhondoro iyo vachulhu madhubahu wiira nkumihe isadaka wa Apwiiya Nlhuku. Ukhalhawaya nihiriri no isadaka ikumihiye wo mooro ninookiteelhiha nrima mii Apwiiya Nlhuku.<verse eid="EXO 29:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 29:19" />“Nkusheke ikhondoro ikina iyo, Naharuni ni achishaana aya yeesheke miono chaya vamuruni waya. <verse eid="EXO 29:19" /><verse number="20" style="v" sid="EXO 29:20" />Nhitheke ni ukusha iphome ni waahika Naharuni vamoka ni achishaana aya indewe cho manyaru aya o wiimonono, makokho aya molhupalhe o wiimonono ni makokho molhupalhe o mieto chaya cho wiimonono. Iphome inohalha iyo mmichamicheke urukureria madhubahu ayo. <verse eid="EXO 29:20" /><verse number="21" style="v" sid="EXO 29:21" />Tho, nkusheke iphome iri vamadhubahuni ni makhura o wootiya alhe, mwaamichamichereke Naharuni ni ikuwo chaya, tho mwaamichamichereke achishaana aya ni ikuwo chaya. Vavawo Naharuni ni achishaana aya ni ikuwo chaya chonkhaye anookhalha atakatifu.<verse eid="EXO 29:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 29:22" />“Mwamalhaka vavawo, nkusheke makhura o ikhondoro ilhopwana iyo, mwiilha aya, makhura anokhunelha marupo, ithayi yoombone ya ahapa, imphio chaya piilhi ni makhura aya, vamoka ni mphanja aya wo wiimonono. <verse eid="EXO 29:22" /><verse number="23" style="v" sid="EXO 29:23" />Ukhuma nchikapuni nri mikatte cho uhihelhiya ihengedure mmo, irii umihoolho waka mii Apwiiya Nlhuku, nkusheke nkatte mmoka ni andazi nimoka nikatahunyiye wo makhura ni nkatte wo uvevialha mmoka. <verse eid="EXO 29:23" /><verse number="24" style="v" sid="EXO 29:24" />Chonkhaye chiyo mwaavaheke Naharuni ni achishaana aya. Ni ayo yeenulheke uchulhu ni ukumiha isadaka uwannyaka mii Apwiiya Nlhuku. <verse eid="EXO 29:24" /><verse number="25" style="v" sid="EXO 29:25" />Nkusheke mikatte chiyo tho ukhuma mmathathani mwaya, upaha mooro vachulhu madhubahu vamoka ni isadaka yo upahiya ilhe. Chikhalhe nihiriri no nukhelha no ukiteelhiha mii Apwiiya Nlhuku. <verse eid="EXO 29:25" /><verse number="26" style="v" sid="EXO 29:26" />Baada yo vavawo nkusheke ikidari yo ikhondoro yo weeshiya Naharuni umihoolho waka iyo, wooniha wiira nhokivaha isadaka mii Apwiiya Nlhuku, ni iyo inookhalha mpatta wawinyu.<verse eid="EXO 29:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 29:27" />“Nkusheke ikidari ni mphanja wo ikhondoro yo upacha, ikumihiye isadaka yo weeshiya umihoolho waka opochera ishaani, ni inama yo ikhondoro ikina yeenulhiye wooniha wiira ihokumihiya isadaka uwannyaka mii, nthamiheke ikidari ni mphanja chikhalhe yolhia i Naharuni ni achishaana aya. <verse eid="EXO 29:27" /><verse number="28" style="v" sid="EXO 29:28" />Paahi mahuku anowa, kila Aisraeli vanokumiha aya isadaka uwannyaka mii, akusheke chechiyo induri chiyo ukhuma isadaka chaya cho waathanihiya chinokumiha aya, ni waavaha Naharuni ni achishaana aya. Yeyo phi isadaka aya, uwannyaka mii Apwiiya Nlhuku.<verse eid="EXO 29:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 29:29" />“Baada yo ukhwa wa Naharuni, ikuwo chaya chitakatifu avahiyeke achishaana aya, awareke vanohikiya aya makhura ni ikatema vanohalha aya uvahiya ntheko wo opochera ishaani. <verse eid="EXO 29:29" /><verse number="30" style="v" sid="EXO 29:30" />Mwaamwana a Naharuni nohalha ukhalha opochera ishaani vanipuroni wa athumwanawe, awareke chechiyo ikuwo chiyo ni ukhalha Unihemani uwo wo mahuku saba, vanovara awe ntheko Vakittu Vatakatifu.<verse eid="EXO 29:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 29:31" />“Nkusheke inama yo ikhondoro ikina ikumihiye isadaka ilhe ni waapia untenjeni u Nihema Nitakatifu. <verse eid="EXO 29:31" /><verse number="32" style="v" sid="EXO 29:32" />Mwamalhihakaru, mwaavaheke Naharuni ni achishaana aya akhurelheke vanlhakoni u Nihema Nitakatifu, vamoka ni mikatte chaahalhenlhe nchikapuni mmwe. <verse eid="EXO 29:32" /><verse number="33" style="v" sid="EXO 29:33" />Alhieke chechiyo chittu chikumihiye isadaka cho uhiyereriya uwonya chiyo, nansho ntu nkina hihiyereriye wiira alhie, ukhalhawaya chitakatifu. <verse eid="EXO 29:33" /><verse number="34" style="v" sid="EXO 29:34" />Yakhalhaka inama iriyoothe ama mikatte chinoohalha mpaka wichishu, paahi mpaheke mooro, chihilhiye ukhalhawaya chitakatifu.<verse eid="EXO 29:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 29:35" />“Chiichammo phi nohalha inyu waapangelha Naharuni ni achishaana aya wo ulhikaana ni chittu chonkhaye chulhehenreakani. Mwaapangelheke yoyo ntheko ntakatifu uyo mahuku saba. <verse eid="EXO 29:35" /><verse number="36" style="v" sid="EXO 29:36" />Ni kila nihuku nkumiheke isadaka yo ing'ope n'dume wo nlhatu wo uthamihiya milhatu cho uwonya. Wo wiira chiicho, nnoopanga madhubahu ayo ukhalha matakatifu. Mwamalhaka nttukurieke wo umiinelha makhura. <verse eid="EXO 29:36" /><verse number="37" style="v" sid="EXO 29:37" />Mpangeke chiicho kila nihuku wo mahuku saba. Baada yo vavawo, madhubahu ayo anookhalha matakatifu chinene, ni kila ittu inohalha uvara madhubahu ayo inookhalha itakatifu.<verse eid="EXO 29:37" /></para>
  <para style="s1">Isadaka yo kila nihuku</para>
  <para style="r">(<ref loc="NUM 28:1-8">Waal 28:1-8</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="EXO 29:38" />“Kila nihuku mahuku anowa, nkumiheke isadaka vachulhu madhubahu vawo, ashikhondoro eelhi o iyaakha imoka. <verse eid="EXO 29:38" /><verse number="39" style="v" sid="EXO 29:39" />Mwaakhondoro mmoka isadaka wichishu, ni mwaakhondoro nkina isadaka uchechilho. <verse eid="EXO 29:39" /><verse number="40" style="v" sid="EXO 29:40" />Tho, vamoka ni mwaakhondoro opacha, nkumiheke ikilo imoka yo iphepa yo shilhia ithakanihiye ni ilita imoka yo makhura oombone, ni ilita imoka yo idivai, ikhalhe isadaka yo uwuriya. <verse eid="EXO 29:40" /><verse number="41" style="v" sid="EXO 29:41" />Thothoni tho, mwaakhondoro nkina o uchechilho ulhe, munkumiheke vamoka ni isadaka yo choolhia ni yo uwuriya thoko chipannge inyu wichishu. Nihiriri no yeyo isadaka inopahiya iyo inookiteelhiha mii Apwiiya Nlhuku. <verse eid="EXO 29:41" /><verse number="42" style="v" sid="EXO 29:42" />Yeyo isadaka yo upahiya iyo ikumihiyeke umihoolho waka mii Apwiiya Nlhuku, mahuku onkhaye iyari ni iyari, vanlhakoni u Nihema Nitakatifu unohalha aka ukumaana ni attu aka. Tho, ni uwulhumanani inyuva Namusa. <verse eid="EXO 29:42" /><verse number="43" style="v" sid="EXO 29:43" />Vavawo kinoowa koolhumana Aisraeli, ni nthimicho aka unowa upanga vavawo vakittu vawo ukhalha Vatakatifu. <verse eid="EXO 29:43" /><verse number="44" style="v" sid="EXO 29:44" />Kinoopanga Nihema Nitakatifu ni madhubahu ayo ukhalha chitakatifu. Tho Naharuni ni achishaana aya kinowaavariha ntheko wo opochera ishaani. <verse eid="EXO 29:44" /><verse number="45" style="v" sid="EXO 29:45" />Kinookhalha munlhokoni mwa Aisraeli, ni mii kinookhalha Nlhuku aya. <verse eid="EXO 29:45" /><verse number="46" style="v" sid="EXO 29:46" />Vavawo phi nowa aya yaachuwelha wiira mii phi Apwiiya Nlhuku, Nlhuku aya, kaawiihilhe uno ukhuma Umisri, wiira kikhalhe munlhokoni mwaya.”<verse eid="EXO 29:46" /></para>
  <chapter eid="EXO 29" />
  <chapter number="30" style="c" sid="EXO 30" />
  <para style="s1">Madhubahu o ututumiheriya ubani</para>
  <para style="r">(<ref loc="EXO 37:25-28">Utt 37:25-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 30:1" />“Nkoorosheke madhubahu o imbau cho n'johoro o ututumiheriya ubani. <verse eid="EXO 30:1" /><verse number="2" style="v" sid="EXO 30:2" />Akhalheke o ulhikaana mipata chonkhaye. Urekama mmono mmoka ni nusu, makhuvi moono mmoka ni nusu, ni utalhiva moono mmoka ni nusu. Inyaka chaya chikhalheke ittu imoka ni madhubahu ayo. <verse eid="EXO 30:2" /><verse number="3" style="v" sid="EXO 30:3" />Nkhunelheke wo idhahabu yorera vachulhu, mpararini ni inyaka chaya. Tho, nrukureriheke nreko wo idhahabu. <verse eid="EXO 30:3" /><verse number="4" style="v" sid="EXO 30:4" />Mwamalhaka, mwaakoorosheke apete acheshe o idhahabu o uwariha miri cho nsegasega cho uthathelha madhubahu. Eeshiyeke wo vathi, eelhi uno ni eelhi akina mpata wo nayelhi. <verse eid="EXO 30:4" /><verse number="5" style="v" sid="EXO 30:5" />Chechiyo miri chiyo chinaakhalheke cho n'johoro, chihikiye idhahabu. <verse eid="EXO 30:5" /><verse number="6" style="v" sid="EXO 30:6" />Madhubahu ayo eeshiyeke uhoolho wo nipaziya, vachereshere Nisanduku no Malhehano ni ikifuniko aya. Vavawo phi nohalha aka uukumaanani. <verse eid="EXO 30:6" /><verse number="7" style="v" sid="EXO 30:7" />Kila nihuku Naharuni vanohalha aya ukelha uwehawehani ikhandiri, atutumiherelheke ubani wo unukhelha vachulhu madhubahu ayo. <verse eid="EXO 30:7" /><verse number="8" style="v" sid="EXO 30:8" />Tho, atutumihereke ubani uchechilho vanoparihelha aya ikhandiri. Yeyo isadaka iyo ikumihiyeke mahuku onkhaye wo iyari chinyu chonkhaye wo uheemelha. <verse eid="EXO 30:8" /><verse number="9" style="v" sid="EXO 30:9" />Vamadhubahuni vawo, nhiwuchelhelhe mena ubani uchiichihiye wiira uhipahiye, ama umpaha mwannama riyoothe ama isadaka yo choolhia vachulhu vawo, ama umichera idivai iriyoothe ukhalha isadaka vavawo. <verse eid="EXO 30:9" /><verse number="10" style="v" sid="EXO 30:10" />Nkwaha mmoka kila iyaakha, Naharuni attukurieke inyaka ncheshe cho madhubahu ayo wo iphome ya ashinama akumihiye isadaka yo uthamiha milhatu cho uwonya. Ipangiyeke chiicho iyaakha chonkhaye chinowa. Ukhalhawaya madhubahu ayo matakatifu chinene, uwannyaka mii Apwiiya Nlhuku.”<verse eid="EXO 30:10" /></para>
  <para style="s1">Ikhodi yo Nihema Nitakatifu</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 30:11" />Apwiiya Nlhuku nkayeerelha ashinna Musa wiira, <verse eid="EXO 30:11" /><verse number="12" style="v" sid="EXO 30:12" />“Kila vanohalha inyu waalhakelha attu o Israeli, kila ntu akilhiveke ikhodi yo wiilhivelha mwanene, wiira uhikhalhe mareta mahuku attu vanaalhakelhiya aya. <verse eid="EXO 30:12" /><verse number="13" style="v" sid="EXO 30:13" />Kila ntu naalhakelhiya akilhiveke nchurukhu wo ulhikaana ni malhivo aromolhiye ulhiviya. Yoyo nchurukhu uyo phi isadaka uwannyaka mii, Apwiiya Nlhuku. <verse eid="EXO 30:13" /><verse number="14" style="v" sid="EXO 30:14" />Kila mmoka nohalha waalhakelhiya, toka o iyaakha makhumi meelhi ni uthepa, akumiheke yayo malhivo ayo. <verse eid="EXO 30:14" /><verse number="15" style="v" sid="EXO 30:15" />Attu o nhakhu mwinchi ahilhive wo uthepa, mena nshikini hiwukulhe ikhodi awe iyo. <verse eid="EXO 30:15" /><verse number="16" style="v" sid="EXO 30:16" />Mpochereke yoyo nchurukhu uyo ukhuma wa attu o Israeli, ni waavaha attu anovara ntheko wo uwehaweha Nihema Nitakatifu. Ni uyo unookhalha malhivo o ukumi aya, ni mii kinowoopuwelha wiira keenanelhe.”<verse eid="EXO 30:16" /></para>
  <para style="s1">Malhehero o inyipo yulhupalhe yo ishaaba</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 30:17" />Apwiiya Nlhuku nkayeerelha ashinna Musa wiira, <verse eid="EXO 30:17" /><verse number="18" style="v" sid="EXO 30:18" />“Nkoorosheke inyipo yulhupalhe yo shaaba yo uhelhiya maashi o ukhucha. Neeshiyeke variyari Nihema Nitakatifu ni madhubahu, ni ucharihiya maashi. <verse eid="EXO 30:18" /><verse number="19" style="v" sid="EXO 30:19" />Naharuni ni achishaana aya yiiwulhulheke mieto ni unyawa miono chaya yayo maashi ayo, <verse eid="EXO 30:19" /><verse number="20" style="v" sid="EXO 30:20" />ahinaaya ukelha Nihema Nitakatifu, ni ahinaaya waatameria madhubahu wiira akumihe isadaka yo upahiya uwannyaka mii, Apwiiya Nlhuku. Yaahireke chiicho, anookhwa. <verse eid="EXO 30:20" /><verse number="21" style="v" sid="EXO 30:21" />Inothananiya wiira yiiwulhulheke mieto ni unyawa miono chaya ahiwe yaakhwa. Yayo anookhalha phi malhemalhelho o mahuku onkhaye, toka Naharuni ni iyari aya mpaka iyari chinowa.”<verse eid="EXO 30:21" /></para>
  <para style="s1">Malhehero anaacha makhura matakatifu</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 30:22" />Tho, Apwiiya Nlhuku nkayeerelha ashinna Musa wiira, <verse eid="EXO 30:22" /><verse number="23" style="v" sid="EXO 30:23" />“Nkusheke chittu cho unukhelha thoko chi, makhura o upophori wo mwiri wo manemane kilo sita, mdalasini wo nihiriri no unukhelha ikilo ttaru, mihalhu cho unukhelha ikilo ttaru, <verse eid="EXO 30:23" /><verse number="24" style="v" sid="EXO 30:24" />ni mdalasini wo nikosho nikina wo unukhelha, kilo sita. Chonkhaye chiphimiyeke ni ulhikaana ikipimo cho Nihema Nitakatifu. Tho, nkusheke ni ilita ncheshe cho makhura. <verse eid="EXO 30:24" /><verse number="25" style="v" sid="EXO 30:25" />Wo chechiyo, nkoorosheke makhura matakatifu, nthakaniheke thoko chineera aya attu anokoorosha makhura o unukhelha. Yayo akhalheke o uhikiya attu aneeshiya mmihoolho wa Apwiiya Nlhuku. <verse eid="EXO 30:25" /><verse number="26" style="v" sid="EXO 30:26" />Yamalhaka mmiinelheke makhura ayo Nihema Nitakatifu nno, Nisanduku no Malhehano nno, <verse eid="EXO 30:26" /><verse number="27" style="v" sid="EXO 30:27" />imeza ni ikaruma chaya chonkhaye, iphata yo ikhandiri ni ikaruma chaya chonkhaye, madhubahu o ututumiherelha ubani, <verse eid="EXO 30:27" /><verse number="28" style="v" sid="EXO 30:28" />madhubahu o ukumiheriya isadaka chinohalha upahiya ni ikaruma chaya, inyipo yulhupalhe ni ikhalhelho aya. <verse eid="EXO 30:28" /><verse number="29" style="v" sid="EXO 30:29" />Mweesheke wo nlhatu wo ntheko wa Apwiiya Nlhuku wo uhika makhura, wiira chonkhaye chikhalhe chitakatifu. Ni ittu iriyoothe inohalha uvara, inookhalha itakatifu. <verse eid="EXO 30:29" /><verse number="30" style="v" sid="EXO 30:30" />Mwamalhaka, mwaahikeke makhura Naharuni ni achishaana aya ni waahaulha wo nlhatu wo ntheko wo upochera ishaani. <verse eid="EXO 30:30" /><verse number="31" style="v" sid="EXO 30:31" />Mwaahimerieke Aisraeli wiira, ‘Alha makhura alha phi makhura aka matakatifu, ashungiyeke mmilhokoni mwo iyari chinyu chinowa mahuku onkhaye. <verse eid="EXO 30:31" /><verse number="32" style="v" sid="EXO 30:32" />Nhaahike mwiiruttuni attu ahiri opochera ishaani, ni mena nhikooroshe makhura o ulhikaana ni alha, wo iphiro yo uthakanihacha chechiyo chittu chiromolhiye chiyo. Alha makhura alha, matakatifu, ni inyu mwooneke wiira matakatifu. <verse eid="EXO 30:32" /><verse number="33" style="v" sid="EXO 30:33" />Ntu riyoothe nokoorosha makhura thoko alha, ama unhika ntu hinophwanelhiya uhikiya alha makhura alha, ahikhalhe opochera ishaani, yoyo haalhakelhiye munlhokoni mwa attu aka.’ ”<verse eid="EXO 30:33" /></para>
  <para style="s1">Malhehero anaacha ubani</para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 30:34" />Apwiiya Nlhuku nkayeerelha ashinna Musa wiira, “Mwaahimerieke attu o Israeli, akusheke makhura o unukhelha, yaani upophori wo natafi, upophori wo shekelethi, upophori wo kelbena, ni ubani woombone. <verse eid="EXO 30:34" /><verse number="35" style="v" sid="EXO 30:35" />Chonkhaye chiyo chilhikaaneke maphimelhiyo aya nkooroshelheke ubani thoko chinokooroshiya aya ni attu o ukoorosha makhura o unukhelha. Nlhukeke maakha wiira ubani uyo urere ni ukhalha ntakatifu. <verse eid="EXO 30:35" /><verse number="36" style="v" sid="EXO 30:36" />Mwamalhihaka, nshilheke chinene, mweesheke u Nihema Nitakatifu, ni uhikahiha Nisanduku no malhehano, vakittu vanohalha aka ukumaanani, ni uyo unookhalha ubani ntakatifu uwannyu mwaatti. <verse eid="EXO 30:36" /><verse number="37" style="v" sid="EXO 30:37" />Nhikooroshe yoyo ubani uyo wo nlhatu winyu mwaashinene, ukhalhawaya yoyo unowa ukhalha ubani ntakatifu uwannyu mwaati. <verse eid="EXO 30:37" /><verse number="38" style="v" sid="EXO 30:38" />Ntu riyoothe nohalha ukoorosha wiira eehike mwanene, yoyo haalhakelhiye munlhokoni mwa attu aka.”<verse eid="EXO 30:38" /></para>
  <chapter eid="EXO 30" />
  <chapter number="31" style="c" sid="EXO 31" />
  <para style="s1">Anamitheko o utheka Nihema Nitakatifu</para>
  <para style="r">(<ref loc="EXO 35:30-36:1">Utt 35:30-36:1</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 31:1" />Apwiiya Nlhuku nkayeerelha ashinna Musa wiira, <verse eid="EXO 31:1" /><verse number="2" style="v" sid="EXO 31:2" />“Mwooneke, kihaathanlha Nabezaleli anaaya Nauri, uchulhu wa Nanahuri, o ukhuma nikosho no Uyuda, <verse eid="EXO 31:2" /><verse number="3" style="v" sid="EXO 31:3" />kihaachariha machiri aka. Kihaavaha irusho cho uchuwelha, urata ni wooria mitheko chonkhaye cho ukoorosha chittu. <verse eid="EXO 31:3" /><verse number="4" style="v" sid="EXO 31:4" />Wiira akooroshe wo urata, chittu cho idhahabu, isiliva, ni ishaaba. <verse eid="EXO 31:4" /><verse number="5" style="v" sid="EXO 31:5" />Kihaavaha irusho cho uhema malhuku o uphwanelhiha chittu, uhema imbau, ni wooria ukoorosha kila ittu. <verse eid="EXO 31:5" /><verse number="6" style="v" sid="EXO 31:6" />Wo uthepa, kihaathanlha Naoholiabu anaaya Naahisamaki, o nikosho ni Nadani, avare ntheko vamoka ni ayo. Tho, kihaavaha attu akina wooria chinene wiira avare mitheko chikinachikina, wiira akooroshe chittu chonkhaye kilhehenre aka wiira chikooroshiye. <verse eid="EXO 31:6" /><verse number="7" style="v" sid="EXO 31:7" />Atheke Nihema Nitakatifu, Nisanduku no Malhehano ni ikifuniko aya, vamoka ni ikaruma chaya chonkhaye, <verse eid="EXO 31:7" /><verse number="8" style="v" sid="EXO 31:8" />ni imeza ni chittu chaya, iphata yo idhahabu yorera yo uthomeiya ikhandiri ni ikerero chaya. Akoorosheke madhubahu o ututumihera ubani, <verse eid="EXO 31:8" /><verse number="9" style="v" sid="EXO 31:9" />madhubahu o isadaka cho upahiya ni chittu chaya chonkhaye, inyipo yulhupalhe yo maashi vamoka ni ikhalhelho aya, <verse eid="EXO 31:9" /><verse number="10" style="v" sid="EXO 31:10" />ikuwo chitakatifu cho uwariya ni Naharuni ni achishaana aya anohalha uvara ntheko wo opochera ishaani. <verse eid="EXO 31:10" /><verse number="11" style="v" sid="EXO 31:11" />Tho, akoorosheke makhura o wootiya ni ubani wo unukhelha wo ututumihiya Vakittu Vatakatifu. Akoorosheke chittu chonkhaye chiyo thoko chinre aka wo waalhehera.”<verse eid="EXO 31:11" /></para>
  <para style="s1">Malhehero o Nihuku no Wiittuwa</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 31:12" />Apwiiya Nlhuku nkayeerelha ashinna Musa tho, <verse eid="EXO 31:12" /><verse number="13" style="v" sid="EXO 31:13" />“Mwaahimerieke attu ayo, avarechesheke Nihuku no Wiittuwa naka, ukhalhawaya phi alama yo malhehano uwannyaka mii ni iyari chinyu chonkhaye. Wooniha wiira, mii phi Apwiiya Nlhuku kuupanngeni mwaatti ukhalha atakatifu. <verse eid="EXO 31:13" /><verse number="14" style="v" sid="EXO 31:14" />Nvarechesheke Nihuku no Wiittuwa, ukhalhawaya nenno nihuku nitakatifu uwannyu mwaatti. Ntu riyoothe hinovarechesha nenno nihuku nno, eeviyeke. Ni ntu nohalha uvara ntheko nenno nihuku nno, haalhakelhiye munlhokoni mwa attu awe. <verse eid="EXO 31:14" /><verse number="15" style="v" sid="EXO 31:15" />Nvareke ntheko mahuku sita, nansho nihuku no saba, nenno nihuku naka neeshiye no wiittuwa. Ntu riyoothe novara ntheko nenno nihuku nno, eeviyeke. <verse eid="EXO 31:15" /><verse number="16" style="v" sid="EXO 31:16" />Aisraeli avarechesheke nenno nihuku nno ukhalha phi alama yo malhehano o mahuku o uhimalha. <verse eid="EXO 31:16" /><verse number="17" style="v" sid="EXO 31:17" />Yayo phi malhehano aka o mahuku o uhimalha uwannyaka mii ni Aisraeli. Ukhalhawaya Mii, Apwiiya Nlhuku kahoopa irimu ni ilhapo wo mahuku sita, ni nihuku no saba kahohiya uvara ntheko, nkakeettuwa.” <verse eid="EXO 31:17" /><verse number="18" style="v" sid="EXO 31:18" />Apwiiya Nlhuku amalhihekeru wolhumana ashinna Musa umwaakoni Usinai, ahaavaha ivibau piilhi cho malhuku chaalhempe aya malheheriyo, anene Apwiiya Nlhuku wo nikokho naya.<verse eid="EXO 31:18" /></para>
  <chapter eid="EXO 31" />
  <chapter number="32" style="c" sid="EXO 32" />
  <para style="s1">Isinyago yo mwaang'ope o idhahabu</para>
  <para style="r">(<ref loc="DEU 9:6-29">Itor 9:6-29</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 32:1" />Attu vonne aya wiira ashinna Musa ahocherewa ukhuruwa umwaakoni, ahothukumanacha ni weerelha Naharuni wiira, “Khanichuwenlhe ittu yaapattilhe ashinna Musa, aniwiihilhe uno ukhuma Umisri. Paahi mwaakuvieke, nnikooroshelheke milhuku cho uniholhelha!”<verse eid="EXO 32:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 32:2" />Naharuni nkayaakhulha, “Mwaarulheke manyaahanu inyu ni achishaana inyu ivipuli cho idhahabu chiwanre aya chiyo, nkiwiihereke mii.” <verse eid="EXO 32:2" /><verse number="3" style="v" sid="EXO 32:3" />Paahi attu onkhaye ahorulhacha, nkayaarwehelha Naharuni. <verse eid="EXO 32:3" /><verse number="4" style="v" sid="EXO 32:4" />Ni ayo ahokusha ivipuli chonkhaye chiyo, nkayaathulhusha, nkayaamiina ni ukoorosha isinyago yo mwaang'ope. Attu nkayoona ni wiira, “Ulha phi nlhuku inyu Aisraeli! Ulha phi uyo nikumihilhe ilhapo yo Umisri!”<verse eid="EXO 32:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 32:5" />Naharuni vonne aya ittu ikhumelhenlhe, ahotheka madhubahu umihoolho wo isinyago yo mwaang'ope uyo ni utangacha wiira, “Meelho ninoopanga isikukuu yo waathimicha Apwiiya Nlhuku!” <verse eid="EXO 32:5" /><verse number="6" style="v" sid="EXO 32:6" />Paahi attu ahonkwacha mapikoosha ni waawiiha ashinama wiira ahitachiye ni upahiya vamadhubahuni. Tho ahowiihacha isadaka cho ukondiha umpwana aya ni Apwiiya Nlhuku. Nkayaakhalhacha ulhia, uwuria ni upangacha chittu cho uhilhoka.<verse eid="EXO 32:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 32:7" />Paahi Apwiiya Nlhuku aheerelha ashinna Musa, “Nkhuruweke, ukhalhawaya attu inyu, mwaawihilhe inyu ukhuma Umisri, ahokittekelha! <verse eid="EXO 32:7" /><verse number="8" style="v" sid="EXO 32:8" />Ahohiyacha iphiro konihilhe aka! Ahokoorosha isinyago yo mwaang'ope o idhahabu. Ahothimicha yeyo ni ukumiha isadaka wo yeyo. Ni vano aneera wiira, ‘Ulha phi nlhuku ihu, hii Aisraeli va! Phi uyo niwiinhe uno ukhuma Umisri!’ ”<verse eid="EXO 32:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 32:9" />Yamalheke, Apwiiya Nlhuku nkayeerelha ashinna Musa wiira, “Kihochuwelha itiyamaru ya alha attu alha. <verse eid="EXO 32:9" /><verse number="10" style="v" sid="EXO 32:10" />Ahokirusha chinene. Paahi kinowaalhakalhiha. Nhilhikache ukihiiha! Vavawo kinoupangani inyuva ni iyari inyu nkhalhe nikosho nulhupalhe.”<verse eid="EXO 32:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 32:11" />Nansho ashinna Musa ahaashontelhelha Apwiiya Nlhuku ni wiira, “Pwiiya Nlhuku, nhirushiye chinene, nhaathunalhelhe attu inyu ayo! Yayo phi attu mwooponlhe inyu ukhuma Umisri wo machiri inyu molhupalhe! <verse eid="EXO 32:11" /><verse number="12" style="v" sid="EXO 32:12" />Nhipange ittu iriyoothe inohalha waavaha attu o Umisri nlhove no wiira, ‘Nlhuku aya haakumiha wiilhaponi wihu uno, ukhalhawaya aathanana weevakacha umwaakoni ni waalhakalhiha!’ Nhirushiye! Nrukunuweke, nhipange ittu ikihimenrie inyu wiira nnothanana upanga iyo! Nhaapangelhe attu inyu ittu yo uhilhoka iyo, yinre inyu wiira nnoopanga iyo! <verse eid="EXO 32:12" /><verse number="13" style="v" sid="EXO 32:13" />Mwoopuwelheke anamitheko inyu, Aburahimu, Naisaka, ni Nayakhobo. Inyu mwaanene mwahaalhelha wiira, ‘Kinowoorihani ukhalha ni achishaana enchi thoko ittotwa cho wiirimu.’ Mwaheerelha wiira, ‘Kinowa waavaha achishaana inyu ilhapo yonkhaye Kinolheha aka wiira kinowaavaha, ikhalhe yawaya mahuku o uhimalha.’ ”<verse eid="EXO 32:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 32:14" />Paahi Apwiiya Nlhuku ahorukunusha irusho chaya. Khayaapannge ittu yo uhilhoka wa attu aya, yenre aya wiira anoopanga.<verse eid="EXO 32:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 32:15" />Ashinna Musa ahohokolhia ukhuma umwaakoni anakushilhe ikipande piilhi cho malhuku chaalhepiye malheheriyo uno ni uno. <verse eid="EXO 32:15" /><verse number="16" style="v" sid="EXO 32:16" />Nlhuku mwanene phi akooronshe ikipande cho malhuku chiyo ni ulhepa malheheriyo uno ni uno.<verse eid="EXO 32:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 32:17" />Nayoshua nkayeewa attu vaakhuwelha aya, nkayeerelha ashinna Musa, “Kineewa thoko attu anowaatakana ikhoto unikambini uwo.”<verse eid="EXO 32:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 32:18" />Nansho ashinna Musa nkayeera, “Wowo kuhii unyakulhiya wo wunlha ama wo ukottolha, wowo unyakulhiya wo wiipiya ichipo!”<verse eid="EXO 32:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 32:19" />Ikatema ashinna Musa vaatameria aya vanikambini vawo, ni woona isinyago yo mwaang'ope, ni attu yiinaka, ahorushiya chinene. Ahoriha ikipande cho malhuku chilhe vathi wuuthi mwaako, nkachaaphwia. <verse eid="EXO 32:19" /><verse number="20" style="v" sid="EXO 32:20" />Paahi ahokusha isinyago yo mwang'ope ilhe nkayaapaha vamooroni. Nkaashilha mpaka nkayaakhalha iphepa. Nkayoothwaa iphepa iyo mmaashini, nkaakhanyereriha Aisraeli wiira awurie. <verse eid="EXO 32:20" /><verse number="21" style="v" sid="EXO 32:21" />Yamalheke, nkayeerelha Naharuni, “Attu alha yoopanngeni, mpaka nkamwaawulhusha muuwonyani wulhupalhe thoko choo?”<verse eid="EXO 32:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 32:22" />Naharuni nkaakhulha, “Chonte, nhikithunalhelhe, munna. Nhaachuwelha chiri aya tayari uwonya. <verse eid="EXO 32:22" /><verse number="23" style="v" sid="EXO 32:23" />Yaakiirenlhe wiira, ‘Ukhalhawaya khanichuwenlhe ittu yaapattilhe ashinna Musa, aniwiihilhe uno ukhuma Umisri, paahi etu nnikooroshelheke nlhuku o uniholhelha!’ <verse eid="EXO 32:23" /><verse number="24" style="v" sid="EXO 32:24" />Paahi kahaakhulha wiira, ‘Kila ntu wanre ikipuli yo idhahabu arulheke.’ Paahi ahorulhacha nkayaakivaha, nkakaathulhusha vamooroni, ni ukoorosha isinyago yo mwang'ope!”<verse eid="EXO 32:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 32:25" />Paahi ashinna Musa vonne aya wiira attu ahopanga ittu yo uhilhoka, ukhalhawaya Naharuni ahaahiyacha apange thoko chinothanana aya, ni ukhalha ittu yo utheehacha wa amalhaponi aya, <verse eid="EXO 32:25" /><verse number="26" style="v" sid="EXO 32:26" />aheemelha vanlhakoni vanipuroni, nkayeera, “Kila ntu naarumelhelha Apwiiya Nlhuku, aweeke uwannyaka!” Paahi iyari ya Alawi yonkhaye yahothukumana ni waarukureria. <verse eid="EXO 32:26" /><verse number="27" style="v" sid="EXO 32:27" />Nkayeerelhacha, “Apwiiya Nlhuku ihu Aisraeli, aholhehera wiira kila mmoka inyu eettukeke uphanga awe nnyununi mwawe, arukurerieke vanikambini ukhuma nlhako mmoka mpaka nlhako nkina, kila mmoka amwiiveke mmuchi awe, mpwana awe ni namwaatamana awe.” <verse eid="EXO 32:27" /><verse number="28" style="v" sid="EXO 32:28" />Alawi ahorumelhelhacha nlhove ni ashinna Musa. Nkayaarwaa ni weevakacha manyaalhopwana maelufu mararu nenno nihuku nno. <verse eid="EXO 32:28" /><verse number="29" style="v" sid="EXO 32:29" />Ashinna Musa nkayeerelha Alawi, “Lhelho nheekumiha mwaashinene wa Apwiiya Nlhuku wo weevakacha achishaana inyu ni ashunninyu, paahi Apwiiya Nlhuku anouvahani ibarakha.”<verse eid="EXO 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 32:30" />Waashelhe waya, ashinna Musa aherelha attu, “Nhowonya chinene. Vano kinoowelha tho umwaakoni koolhumane Apwiiya Nlhuku. Veekinaka kinokoowolhumana nlhove no waalhepelha wiira ohiyerereni uwonya winyu.” <verse eid="EXO 32:30" /><verse number="31" style="v" sid="EXO 32:31" />Paahi ashinna Musa ahorwaa umwaakoni ni wolhumana Apwiiya Nlhuku yeeraka, “Kinoochukulha chinene wiira attu alha ahowonya chinene. Aheekooroshelha nlhuku o idhahabu nkayanthimicha. <verse eid="EXO 32:31" /><verse number="32" style="v" sid="EXO 32:32" />Nansho vano kinoushontelhelhani wiira, mwaahiyerereke uwonya waya uwo. Mwaahaahiyerereke, paahi nfuteke nchina naka nkitabuni ulhempe inyu machina a attu inyu.”<verse eid="EXO 32:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 32:33" />Nansho Apwiiya Nlhuku nkayeerelha ashinna Musa wiira, “Kinohalha ufuta machina a attu akiwonnye vekha aya, nkitabuni mwaka mmo. <verse eid="EXO 32:33" /><verse number="34" style="v" sid="EXO 32:34" />Vano etu nkhuruweke nrweeke mwaaholhelheke Aisraeli, ukittu kuhimenrieakani. Muupuwelheke mmuruni mwinyu wiira, nnepa wo wiirimu waka unouholhelhani. Nansho, nihuku kinohalha aka waakhuruwelha nno, kinoowa kaatwarusha wo nlhatu no uwonya waya.”<verse eid="EXO 32:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 32:35" />Paahi Apwiiya Nlhuku ahaakurushelha mareta molhupalhe attu ayo, wo nlhatu no waalhepelha Naharuni wiira yaakooroshelhe isinyago yo mwaang'ope o idhahabu ilhe.<verse eid="EXO 32:35" /></para>
  <chapter eid="EXO 32" />
  <chapter number="33" style="c" sid="EXO 33" />
  <para style="s1">Nlhuku nowaamuka Aisraeli</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 33:1" />Apwiiya Nlhuku nkayeerelha ashinna Musa wiira, “Nthameke va vamoka ni Aisraeli nnaaholhelha inyu ukhuma Umisri ayo. Nrweeke ilhapo Kaalhenhe aka Aburahimu, Naisaka, ni Nayakhobo, wiira kinowaavaha achishaana aya. <verse eid="EXO 33:1" /><verse number="2" style="v" sid="EXO 33:2" />Kinonruma nnepa aka oholhelheni, ni kinowoomolhacha attu o Ukanaani, attun o Uamori, attu o Uhethi, attu o Uperizi, attu o Uhivi ni attu o Uyebusi. <verse eid="EXO 33:2" /><verse number="3" style="v" sid="EXO 33:3" />Nrweeke ilhapo yoombone ulhima ni uhuwa mihuwo. Nansho akinorwaa vamoka ni inyu, ukhalhawaya mwaatti attu o itiyamaru, kihiwe koowivakachani mphironi mmo.”<verse eid="EXO 33:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 33:4" />Attu vewilhe aya ahokelhachiya nipampa, ni mena khaariwo ata mmoka aawanre mapambo awe. <verse eid="EXO 33:4" /><verse number="5" style="v" sid="EXO 33:5" />Yaapannge chiicho ukhalhawaya Apwiiya Nlhuku aheerelha ashinna Musa wiira, “Mwaahimerie attu ayo, ‘Mwaatti attu o itiyamaru, karwaaka vamoka ni inyu mwaatti, akinopicha kinowiivakachani. Paahi nrulhacheke mapambo inyu ayo, ni mii kinoochuwelha ittu yo upangani.’ ” <verse eid="EXO 33:5" /><verse number="6" style="v" sid="EXO 33:6" />Paahi Aisraeli vaathamme aya umwaakoni Usinai, khayaawanre tho mapambo aya.<verse eid="EXO 33:6" /></para>
  <para style="s1">Nihema Nitakatifu</para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 33:7" />Kila Aisraeli vaamanke aya nikambi, ashinna Musa ahotheka Nihema Nitakatifu uchereshere nikambi. Nkayeehana nihema nno, “Nihema Nitakatifu.” Paahi ntu riyoothe ari ni milhatu wa Apwiiya Nlhuku ahorwaa unihemani uwo, uchereshere nikambi. <verse eid="EXO 33:7" /><verse number="8" style="v" sid="EXO 33:8" />Kila nkwaha ashinna Musa vaakelha aya Nihema Nitakatifu, attu onkhaye ahemelhacha vamilhakoni waya mpaka vaamanlhe aya ukelha Nnihemani. <verse eid="EXO 33:8" /><verse number="9" style="v" sid="EXO 33:9" />Nkayaakhalha wiira, ashinna Musa kila vaakenlhe aya Nnihemani, nihute no urekama noonia thoko mooro, nahokhuruwa ni weemelha vanlhakoni wo Nihema Nitakatifu, ni Apwiiya Nlhuku nkayoolhumana ashinna Musa ukhuma nnihuteni mmo. <verse eid="EXO 33:9" /><verse number="10" style="v" sid="EXO 33:10" />Attu onkhaye vonne aya nipoto no nihute nno vanlhakoni wo Nihema Nitakatifu vawo, onkhaye yaheewulhusha makukhu ni waathimicha Apwiiya Nlhuku. <verse eid="EXO 33:10" /><verse number="11" style="v" sid="EXO 33:11" />Apwiiya Nlhuku yolhumana ashinna Musa thoko ntu ni mpwana awe. Yamalheke ashinna Musa ahohokolhia unipuroni, nansho mmirawo aakaviha uyo, Yoshua mwaamwana a Nanuni ahohalha u Nihema Nitakatifu.<verse eid="EXO 33:11" /></para>
  <para style="s1">Nlhuku noolheha ukhalha ni attu awe</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 33:12" />Ashinna Musa nkayeerelha Apwiiya Nlhuku, “Wo ikekheene mwahokiirelha, ‘Mwaaholhelhe attu ukelha ilhapo kinohalha uwoonihani,’ nkamweera tho wiira, nhokichuwelha ni wiira kihoutelhihani. Nansho khannakihimeria mpani nohalha inyu unruma wiira akikavihere! <verse eid="EXO 33:12" /><verse number="13" style="v" sid="EXO 33:13" />Paahi, kinoulhepelhani wiira yakhalhaka nhokoonelha ikiriri umihoolho winyu, nkooniheke etu iphiro chinyu, kuuchuwelheni, kithepe upatta ikiriri inyu. Tho, muupuwelheke wiira, attu alha, attu inyu.”<verse eid="EXO 33:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 33:14" />Apwiiya Nlhuku nkayaakhulha, “Kinorwaa vamoka ni inyuva, ni mii kinouteelhihani munrimani.”<verse eid="EXO 33:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 33:15" />Ashinna Musa nkayaakhulha, “Yakhalhaka inyu mwaanene khannorwaa vamoka ni mii, paahi etu nhinithamihe vaa. <verse eid="EXO 33:15" /><verse number="16" style="v" sid="EXO 33:16" />Ukhalhawaya inohalha uchuwelhiya chani wiira mii kihoonelhiya ikiriri umihoolho winyu vamoka ni attu inyu, mwaahirweeke vamoka ni hii? Ukhalha winyu vamoka ni hii unonimwalhaaniha mmilhokoni mwa attu akina velhaponi.”<verse eid="EXO 33:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 33:17" />Apwiiya Nlhuku nkayeerelha ashinna Musa wiira, “Kinoopanga thoko chinre inyu wo ulhepelha chiyo, ukhalhawaya kihouchuwelhani rata, ni mii nhokiteelhiha.”<verse eid="EXO 33:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 33:18" />Paahi ashinna Musa nkayeera, “Paahi nkooniheke etu nthimicho inyu!”<verse eid="EXO 33:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 33:19" />Apwiiya Nlhuku nkayaakhulha, “Kinowoonihani ikuru aka chiri aya, ni uromolha nchina naka wiira, Mii Apwiiya Nlhuku. Ni mii kinompangelha moombone ntu nokittuna, ni umoonelha ikiriri ntu nomoonelha aka ikiriri. <verse eid="EXO 33:19" /><verse number="20" style="v" sid="EXO 33:20" />Nansho khannoona ikhove aka, ukhalhawaya khaawo ntu riyoothe nohalha ukoona ni ukhalha nkumi. <verse eid="EXO 33:20" /><verse number="21" style="v" sid="EXO 33:21" />Nansho mwooneke! Vaa vahawo vakittu vakhiviru ni mii vanohalha inyu weemelha vachulhu mwalha. <verse eid="EXO 33:21" /><verse number="22" style="v" sid="EXO 33:22" />Nthimicho aka vanohalha aya uvira vawo, kinoutumbucherihani munnyateni vachulhu mwalha vawo, ni ukhunelhani wo nthatha naka, mpaka vanohalha aka uvira. <verse eid="EXO 33:22" /><verse number="23" style="v" sid="EXO 33:23" />Yamalhaka kinoothamiha nthatha naka, ni inyu nnookoona wo utulhi, nansho khannokoona ikhove aka.”<verse eid="EXO 33:23" /></para>
  <chapter eid="EXO 33" />
  <chapter number="34" style="c" sid="EXO 34" />
  <para style="s1">Ikipande chikina cho malhuku chaalhepiye malheheriyo</para>
  <para style="r">(<ref loc="DEU 10:1-5">Itor 10:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 34:1" />Apwiiya Nlhuku nkayeerelha ashinna Musa, “Nhemeke ikipande piilhi cho malhuku cho ulhikaana cho mpacho chaapwenshe inyu chilhe. Ni mii kinoolhepa malhove aalhepiye ikibau cho mpacho chilhe. <verse eid="EXO 34:1" /><verse number="2" style="v" sid="EXO 34:2" />Nkhalheke tayari meelho wichishu, mmweeke tho vachulhu mwaako wo Sinai mmwe mwaakulhumana. <verse eid="EXO 34:2" /><verse number="3" style="v" sid="EXO 34:3" />Ni vavawo vanowa inyu vawo, nhinttukane ntu riyoothe, akinttuna ntu awe umwaakoni. Tho, nhihiyerere ikhondoro ama ing'ope iriyoothe ilhie vakhiviru mwaako vawo.” <verse eid="EXO 34:3" /><verse number="4" style="v" sid="EXO 34:4" />Paahi ashinna Musa ahohema ikibau piilhi cho malhuku thoko chaari aya cho mpacho chilhe. Nkayonkwa wichishuru waashelhe aya. Nkayaakusha ikipande cho malhuku chiyo mmathathani urwaana vachulhu mwaako wo Sinai, thoko Apwiiya Nlhuku chaalhehenre aya.<verse eid="EXO 34:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 34:5" />Yamalheke, Apwiiya Nlhuku ahokhuruwa nnihuteni ni weemelha ni ashinna Musa. Nkayaaromolha nchina naya wiira, Apwiiya Nlhuku. <verse eid="EXO 34:5" /><verse number="6" style="v" sid="EXO 34:6" />Baada yo vavawo Apwiiya Nlhuku ahovira uhoolho wa ashinna Musa ni wiiromolha wiira, “Mii Apwiiya Nlhuku. Ikatema chonkhaye kiri o ikiriri ni o waattuna attu. Akinaakuvia urushiya, kinopanga thoko chinolheha aka, wo uhirukunusha malhehano aka. <verse eid="EXO 34:6" /><verse number="7" style="v" sid="EXO 34:7" />Mii kinowaattuna attu wo maelufu o iyari, kinowaahiyerera uwonya waya, nansho akinohiya mena untwarusha ntu notteka. Akinaatwarusha yayo vekha ayaru, nansho ni achishaana aya, mpaka iyari yo neraru, ni yo necheshe.”<verse eid="EXO 34:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 34:8" />Ashinna Musa nkayaakhoroma wo waakuvia mpaka vathi ni waathimicha Apwiiya Nlhuku. <verse eid="EXO 34:8" /><verse number="9" style="v" sid="EXO 34:9" />Nkayeera, “Apwiiya Nlhuku, mwakhalhaka nhoteelhiya ni mii, Kinoulhepelhani etu nrweeke vamoka ni hii. Eiyo, attu alha ahochara itiyamaru, nansho nnihiyerereke uwonya wihu wonkhaye, nnirumelhelheke wiira nikhalhe attu inyu mahuku o uhimalha.”<verse eid="EXO 34:9" /></para>
  <para style="s1">Malhehano anohokolhelhiya</para>
  <para style="r">(<ref loc="EXO 23:14-19">Utt 23:14-19</ref>; <ref loc="DEU 7:1-5">Itor 7:1-5</ref>; <ref loc="DEU 16:1-17">16:1-17</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 34:10" />Apwiiya Nlhuku nkayaakhulha, “Mwooneke, Kinoopanga malhehano ni inyu. Kinoopanga cho ushangiha chulhupalhe umihoolho wa attu inyu uno yoonaka. Cho ushangiha chihinapacha ata ntu mmoka upanga velhaponi va. Attu onkhaye ari vakhiviru ni inyu, anowoona chittu chulhupalhe chinohalha aka upanga mii, Apwiiya Nlhuku. Kinoupangelhani chittu cho ushangiha chinene. <verse eid="EXO 34:10" /><verse number="11" style="v" sid="EXO 34:11" />Nrumelhelheke malheheriyo anohalha aka uvahani lhelho. Kinowoomolhacha attu o Ukanaani, attu o Uhiti, attu o Uperizi, attu o Uhivi ni attu o Uyebusi. <verse eid="EXO 34:11" /><verse number="12" style="v" sid="EXO 34:12" />Nansho mwiichiinanelheke wiira, nheeshe malhehano ni attu anokhalha ilhapo inokelha inyu, ukhalhawaya yeyo inookhalha nrianko wo uwayihani. <verse eid="EXO 34:12" /><verse number="13" style="v" sid="EXO 34:13" />Nansho mphomolhacheke madhubahu aya, nkakhacheke mapoto anothimicha aya, ni isinyago cho milhuku chaya chithiyana Ashera.<verse eid="EXO 34:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 34:14" />“Nhinthimiche nlhuku nkina yaahikhalhe mii. Ukhalhawaya Mii phi Nlhuku kineehaniya Nlhuku o ihache. Mwaahipangeke chiicho, kinoorushiya. <verse eid="EXO 34:14" /><verse number="15" style="v" sid="EXO 34:15" />Nhilhehane malhehano ni attu o yeyo ilhapo iyo, ukhalhawaya vanohalha aya ulhapelha milhuku chaya cho woothiya chiyo, ni ukumiha isadaka uwannyaya, anoulhatulhani. Paahi etu nhilhutaanane. <verse eid="EXO 34:15" /><verse number="16" style="v" sid="EXO 34:16" />Mwaakushaka manyaathiyana aya ukhalha manyaahanu a achishaana inyu ashilhopwana, uno manyaathiyana ayo alhapelhaka milhuku chaya chiyo, anowaapurulha achishaana inyu ashilhopwana ayo ulhapelhani milhuku chaya chiyo.<verse eid="EXO 34:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 34:17" />“Nhikooroshache milhuku cho iyuma, nkamwaalhapelha.<verse eid="EXO 34:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 34:18" />“Nvarechesheke malhemalhelho o Isikukuu yo Mikatte cho uhihelhiya ihengedure. Tho, thoko chinre aka wo ulheherani wiira, nhilhie mikatte cho uhelhiya ihengedure wo mahuku saba, mweeri wo Habibu, ukhalhawaya yoyo phi mweeri waathamme inyu Umisri.<verse eid="EXO 34:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 34:19" />“Kila mwaana mwanlhopwana o nttara, ni madume o mattara a ashinama anaahuwa inyu, awaka. <verse eid="EXO 34:19" /><verse number="20" style="v" sid="EXO 34:20" />Nansho mmoopolheke kila mwannama o nttara o iphuta wo ukumiha ikhondoro ilhopwana vanipuroni waya. Mwaahipangeke chiicho, mmuntheke ishiko awe. Mmoopolheke kila mwaana mwanlhopwana o nttara.</para>
  <para style="p" vid="EXO 34:20">“Tho vavawo, hikhalhe ntu riyoothe nohalha uwa umihoolho waka wo uhikhalha ni isadaka yo ukumiha.<verse eid="EXO 34:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 34:21" />“Mpangeke mitheko chinyu mahuku sita, nansho nihuku no saba mwiittuweke, ata inakhalhaka ikatema yo ulhima ama nlhalha wo ukhungura choolhia.<verse eid="EXO 34:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 34:22" />“Kila iyaakha, mpangeke Isikukuu yo Ukhungura choolhia kila vanochokholha inyu ukhungura ingaano, ni uvarechesha Isikukuu yo Marapatta vanomalhiha inyu nlhalha wo ukhungura choolhia chinyu.<verse eid="EXO 34:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 34:23" />“Mikwaha miraru kila iyaakha, manyaalhopwana onkhaye athukumaaneke umihoolho waka, ukithimicha mii Apwiiya Nlhuku, Nlhuku a Aisraeli. <verse eid="EXO 34:23" /><verse number="24" style="v" sid="EXO 34:24" />Vanohalha aka woomolhacha amalhaponi inyu vawo, kinoochusheriha miinano cho ilhapo inyu, ni vavawo khanowa aakhalha ata ntu mmoka nohalha ulhikacha waatakana ni inyu ikatema yo isikukuu ttaru chiyo.<verse eid="EXO 34:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 34:25" />“Vanokumiha inyu isadaka yo iphome, nhikumihe vamoka ni nkatte uhelhiye ihengedure. Ni ikatema yo isikukuu yo Pasaka, hihalhihe mmithe.<verse eid="EXO 34:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 34:26" />“Nkumiheke isadaka yo choolhia cho mmamatani mwinyu vanowiiha inyu isadaka unupani waka mii Apwiiya Nlhuku inyu.</para>
  <para style="p" vid="EXO 34:26">“Nhimwaapie mwaakhondoro ama mwaapuri mmapelheni mwa anumwanawe.”<verse eid="EXO 34:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 34:27" />Tho, Apwiiya Nlhuku aheerelha ashinna Musa wiira, “Nlhepeke alha malhove alha, ukhalhawaya wo alha malhove alha kinolhehana ni inyu ni attu o Uisraeli.” <verse eid="EXO 34:27" /><verse number="28" style="v" sid="EXO 34:28" />Ashinna Musa ahokhalha umwaakoni uwo vamoka ni Apwiiya Nlhuku mahuku makhumi ncheshe, uthana ni uhiyu. Khayaalhilhie wala uwuria ittu iriyoothe. Nkayaalhepa malhove onkhaye o malhehano, malheheriyo khumi ayo.<verse eid="EXO 34:28" /></para>
  <para style="s1">Ashinna Musa anookhuruwa umwaakoni Usinai</para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 34:29" />Ashinna Musa ahokhuruwa umwaakoni Usinai anakushilhe Malheheriyo Khumi, ahichuwelhaka wiira ikhove aya yaari ithekaka ukhalhawaya ahoolhumana Apwiiya Nlhuku. <verse eid="EXO 34:29" /><verse number="30" style="v" sid="EXO 34:30" />Naharuni ni attu onkhaye ahaaweha ashinna Musa nkayoona ikhove aya ithekaka, nkayoovacha waatameria. <verse eid="EXO 34:30" /><verse number="31" style="v" sid="EXO 34:31" />Nansho ashinna Musa aheehana Naharuni ni ashulhupalhe onkhaye, nkayoolhumana. <verse eid="EXO 34:31" /><verse number="32" style="v" sid="EXO 34:32" />Baada yo vavawo, Aisraeli onkhaye ahowaacha, ni ashinna Musa ahaavaha malheheriyo onkhaye aavahiye aya ni Apwiiya Nlhuku umwaakoni Usinai. <verse eid="EXO 34:32" /><verse number="33" style="v" sid="EXO 34:33" />Ashinna Musa amalhihekeru woolhumana attu, aheetiyelhelha ni ntandiyo wiitho. <verse eid="EXO 34:33" /><verse number="34" style="v" sid="EXO 34:34" />Nansho ashinna Musa kila vaakelha aya Nihema Nitakatifu wolhumana Apwiiya Nlhuku, ahorulha ntandiyo uyo. Ni kila vaakhuma aya vathe, ahaahimeriacha Aisraeli malhove onkhaye alheheriye aya ni Apwiiya Nlhuku. <verse eid="EXO 34:34" /><verse number="35" style="v" sid="EXO 34:35" />Aisraeli onkhaye yahoona wiira ikhove ya ashinna Musa yaari ipharelhaka. Phi vavawo ashinna Musa veetiyelhelha aya tho wiitho ni ntandiyo, mpaka ikatema ikina yaarwa aya woolhumanani Apwiiya Nlhuku.<verse eid="EXO 34:35" /></para>
  <chapter eid="EXO 34" />
  <chapter number="35" style="c" sid="EXO 35" />
  <para style="s1">Ikano chinaacha Nihuku no Wiittuwa</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 35:1" />Ashinna Musa nkayaakumaaniha attu onkhaye o Uisraeli, nkayeerelhacha wiira, “Alha phi malhove akilhenhere aya Apwiiya Nlhuku wiira mpangeke. <verse eid="EXO 35:1" /><verse number="2" style="v" sid="EXO 35:2" />Nvareke ntheko mahuku sita, nansho nihuku no saba ninookhalha Nihuku no Wiittuwa winyu. Phi Nihuku no Wiittuwa Nitakatifu neeshiye ni Apwiiya Nlhuku. Ntu riyoothe novara ntheko nenno nihuku nno nowiiviya. <verse eid="EXO 35:2" /><verse number="3" style="v" sid="EXO 35:3" />Nhiparihelhe ata mooro mmanupani mwinyu Nihuku no Wiittuwa nno.”<verse eid="EXO 35:3" /></para>
  <para style="s1">Isadaka cho ukavihera uthekiya Nihema Nitakatifu</para>
  <para style="r">(<ref loc="EXO 25:1-9">Utt 25:1-9</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 35:4" />Ashinna Musa nkayoolhumacha malhove wa Aisraeli onkhaye wiira, “Apwiiya Nlhuku alhehenre wiira, <verse eid="EXO 35:4" /><verse number="5" style="v" sid="EXO 35:5" />Nkumiheke isadaka wa Apwiiya Nlhuku. Kila ntu ri ni nrima woombone akumiheke wa Apwiiya Nlhuku idhahabu, isiliva, ishaaba, <verse eid="EXO 35:5" /><verse number="6" style="v" sid="EXO 35:6" />nttoche no mapururu o ikhondoro o kibuluu, o zambarau ni o khwiilha, ikuwo chitottiye ni nttoche no mapururu o ipuri, <verse eid="EXO 35:6" /><verse number="7" style="v" sid="EXO 35:7" />marapalha o ikhondoro chilhopwana chihelhiye irangi yo khwiilha, marapalha o ipuri, imbau cho n'johoro, <verse eid="EXO 35:7" /><verse number="8" style="v" sid="EXO 35:8" />makhura o uhelhiya nkhandirini, ikiungo cho uthakanihiya makhura o unukhelha ni cho uthakanihiya ubani wo unukhelha chinene, <verse eid="EXO 35:8" /><verse number="9" style="v" sid="EXO 35:9" />malhuku o nhakhu o isadoniki ni malhuku makina o nhakhu o uphwanelhihiya vachulhu ikuwo yo ukhunelha ikhakacha ni vachulhu nrupa wo vakhakaachani.<verse eid="EXO 35:9" /></para>
  <para style="s1">Ikerero cho uthekelhiya Nihema Nitakatifu</para>
  <para style="r">(<ref loc="EXO 39:32-43">Utt 39:32-43</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 35:10" />“Attu onkhaye anooria uvara ntheko wo urata munlhokoni mwa attu inyu, aweeke akoorosheke kila ittu thoko chilhehenre aya Apwiiya Nlhuku. <verse eid="EXO 35:10" /><verse number="11" style="v" sid="EXO 35:11" />Nihema Nitakatifu ni ikifuniko aya, nipaziya naya, ivibaniyo chaya cho uvarelhelha nipaziya, mikurio chaya, mapoopola aya, ikhalhelho chaya, <verse eid="EXO 35:11" /><verse number="12" style="v" sid="EXO 35:12" />Nisanduku no Malhehano vamoka ni mishaamu chaya, ikifuniko aya, nipaziya no umwalhaaniha Vakittu Vatakatifu chinene nne, <verse eid="EXO 35:12" /><verse number="13" style="v" sid="EXO 35:13" />imeza, mishaamu chaya ni ikaruma chaya chonkhaye, mikatte chineeshiya umihoolho wa Apwiiya Nlhuku, <verse eid="EXO 35:13" /><verse number="14" style="v" sid="EXO 35:14" />iphata yo uthomeiya ikhandiri ni ikaruma chaya, akhandiri ni makhura aya, <verse eid="EXO 35:14" /><verse number="15" style="v" sid="EXO 35:15" />madhubahu o utumiherelha ubani ni mishaamu chaya, makhura o uhikiya, ubani wo unukhelha, nipaziya no nlhako wo Nihema Nitakatifu, <verse eid="EXO 35:15" /><verse number="16" style="v" sid="EXO 35:16" />madhubahu o ututumiheriya isadaka, vamoka ni nttavi naya no shaaba, mishaamu chaya ni ikaruma chaya chonkhaye, inyipo yulhupalhe yo uhelhiya maashi o ukhucha mmietoni ni ikhalhelho aya, <verse eid="EXO 35:16" /><verse number="17" style="v" sid="EXO 35:17" />mapaziya o ntenje, ikuwo chaya ni ikhalhelho chaya, nipaziya no nlhako wo ntenje, <verse eid="EXO 35:17" /><verse number="18" style="v" sid="EXO 35:18" />ikhomo cho Nihema Nitakatifu, cho ntenje vamoka ni ivibaniyo chaya cho uvarelhelha nipaziya, <verse eid="EXO 35:18" /><verse number="19" style="v" sid="EXO 35:19" />ikuwo chorera chitottiye rata, cho uwariya Vakittu Vatakatifu, yaani ikuwo cho uwara Naharuni ni achishaana aya ashilhopwana, vanovara aya ntheko wo opochera ishaani.”<verse eid="EXO 35:19" /></para>
  <para style="s1">Attu anoowiiha isadaka chaya</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 35:20" />Paahi amalhihekeru, nlhoko wonkhaye wa Aisraeli wahothama umihoolho wa ashinna Musa ni uhokolhia umapuroni waya. <verse eid="EXO 35:20" /><verse number="21" style="v" sid="EXO 35:21" />Kila mmoka aateelhiye munrimani wawe, ahowiiha isadaka wa Apwiiya Nlhuku. Nkayaawiihacha chittu chaathananiya wo ukavihera ntheko wo uthekiya Nihema Nitakatifu ni chittu chikina chonkhaye chaathananiya. Tho, ni chiyo cho utottiya ikuwo cho uwara opochera ishaani. <verse eid="EXO 35:21" /><verse number="22" style="v" sid="EXO 35:22" />Attu onkhaye, manyaalhopwana ni manyaathiyana yaateelhiye munrimani, ahowiiha ichipini, ivipuli, apete, ibangili, mikufu, ni chittu chikina chikooroshiye wo idhahabu, nkayaakumiha isadaka wa Apwiiya Nlhuku. <verse eid="EXO 35:22" /><verse number="23" style="v" sid="EXO 35:23" />Tho, kila mmoka aakhalhanne ikuwo yoombone yoteelha, yo kibuluu, yo zambarau ni yo khwiilha, ama yo mapururu o ipuri ama yo marapalha o ikhondoro ihelhiye irangi yo khwiilha, ahowiiha. <verse eid="EXO 35:23" /><verse number="24" style="v" sid="EXO 35:24" />Attu yonrie ukumiha isiliva ama ishaaba ahowiiha chechiyo isadaka wa Apwiiya Nlhuku. Ni ntu riyoothe aarina imbau cho n'johoro, ni uyo ahowiiha chiicho. <verse eid="EXO 35:24" /><verse number="25" style="v" sid="EXO 35:25" />Manyaathiyana onkhaye yaachuwenlhe uritha rata nttoche, ahowiiha mattoche orera oteelha, o kibuluu, o zambarau, ni o khwiilha aarinthe aya. <verse eid="EXO 35:25" /><verse number="26" style="v" sid="EXO 35:26" />Ni manyaathiyana onkhaye ooria ntheko wo uritha, ahoritha nttoche no mapururu o ipuri. <verse eid="EXO 35:26" /><verse number="27" style="v" sid="EXO 35:27" />Aholhelhi onkhaye ahowiiha malhuku o nhakhu o isadoniki ni malhuku makina o nhakhu o uphwanelhiha vachulhu ikuwo yo ukhunelha ikhakacha ni vachulhu nrupa wo vakhakaachani. <verse eid="EXO 35:27" /><verse number="28" style="v" sid="EXO 35:28" />Tho, ahowiiha iviungo, makhura o uhelhiya nkhandirini, makhura o uhikiya, ni ubani wo unukhelha chinene. <verse eid="EXO 35:28" /><verse number="29" style="v" sid="EXO 35:29" />Attu onkhaye manyaalhopwana ni manyaathiyana, yaateelhiye munrimani mwaya ahowiiha wo uhikhanyererihiya ittu iriyoothe yaarina aya ni ukumiha isadaka wa Apwiiya Nlhuku, thoko chaalheheriye aya ashinna Musa wiira ipangiye chiicho.<verse eid="EXO 35:29" /></para>
  <para style="s1">Anamitheko o utheka Nihema Nitakatifu</para>
  <para style="r">(<ref loc="EXO 31:1-11">Utt 31:1-11</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 35:30" />Ashinna Musa nkayeerelha Aisraeli wiira, “Mwiiwelhelheke rata. Apwiiya Nlhuku ahaathanlha Nabezaleli, anaaya Nauri, yaani uchulhu u Nanahuri, o ukhuma nihimo ni Nayuda. <verse eid="EXO 35:30" /><verse number="31" style="v" sid="EXO 35:31" />Apwiiya Nlhuku ahaaholhelha yayo wo machiri aya ni waavaha irusho, wooria ni uvara ntheko uriyoothe rata. <verse eid="EXO 35:31" /><verse number="32" style="v" sid="EXO 35:32" />Wiira etu oopuwelhe chittu cho ukheria wo urata ni uhana idhahabu, isiliva ni ishaaba, <verse eid="EXO 35:32" /><verse number="33" style="v" sid="EXO 35:33" />ahemache chittu cho uphwanelhiha wo malhuku o nhakhu, ni uhemacha imbau cho upangelhiya mitheko chikina chonkhaye. <verse eid="EXO 35:33" /><verse number="34" style="v" sid="EXO 35:34" />Tho ahaavaha yayo manyaattu ayo, ni Naoholiabu, anaaya Naahisamaki, o ukhuma nihimo ni Nadani, wooria, wiira yeettuchihe attu akina mitheko chaya chiyo. <verse eid="EXO 35:34" /><verse number="35" style="v" sid="EXO 35:35" />Ahovahiya irusho cho upanga kila ittu inaacha ntheko wo attu anokoorosha chittu rata, attu anoritha mattoche o mapururu o ikhondoro o irangi cho kibuluu, zambarau ni o khwiilha. Attu anooria utotta ikuwo choteelha chorera chirithiye rata, ni attu anopanga yoyo ntheko uyo rata.”<verse eid="EXO 35:35" /></para>
  <chapter eid="EXO 35" />
  <chapter number="36" style="c" sid="EXO 36" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 36:1" />“Paahi Nabezaleli ni Naoholiabu vamoka ni anamitheko akina onkhaye avaheriye ni Apwiiya Nlhuku machiri ni irusho cho uchuwelha iphiro cho uvara mitheko chonkhaye cho utheka Nihema Nitakatifu, avareke ntheko uyo wo ulhikaana ni malhove onkhaye alheheriye ni Apwiiya Nlhuku.”<verse eid="EXO 36:1" /></para>
  <para style="s1">Attu anoowiiha isadaka chinchi</para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 36:2" />Paahi ashinna Musa aheehana Nabezaleli ni Naoholiabu vamoka ni kila ntu aavaheriye uchuwelha uvara ntheko ni Apwiiya Nlhuku, ni kila ntu aachivelhiye munrimani mwawe wiira avare ntheko mwanene. <verse eid="EXO 36:2" /><verse number="3" style="v" sid="EXO 36:3" />Yayo attu ayo yahopochera chittu chaakumihiye ni attu ukhalha isadaka wa Apwiiya Nlhuku wo ntheko wo uthekiya Nihema Nitakatifu. Attu ni ayo kila wichishu ahothepa ukumiha chittu. <verse eid="EXO 36:3" /><verse number="4" style="v" sid="EXO 36:4" />Paahi attu onkhaye o uchuwelha uvara ntheko wo utheka Nihema Nitakatifu ayo ahothama umithekoni waya nkayaarwelha ashinna Musa, <verse eid="EXO 36:4" /><verse number="5" style="v" sid="EXO 36:5" />ni weerelha wiira, “Attu anoothepa uwiiha chittu upwaha chinothanana ihu wo nlhatu wo ntheko wa Apwiiya Nlhuku, thoko chinilhehenre aya!”<verse eid="EXO 36:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 36:6" />Paahi ashinna Musa aholhehera wiira, “Ntu riyoothe hiwiihe tho ittu wo uthepa ilhe ilheheriye wo ntheko wo uthekelha Nihema Nitakatifu!” Attu veewilhe aya nlhove nno, ahohiyacha ukumiha wo uthepa chittu chaalheheriye chiyo, <verse eid="EXO 36:6" /><verse number="7" style="v" sid="EXO 36:7" />ukhalhawaya chittu chaakumihilhe aya chiyo, chahothosha wo ntheko uyo, kwaani chahothepa ata chaathananiya chilhe.<verse eid="EXO 36:7" /></para>
  <para style="s1">Uthekiya Nihema Nitakatifu</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 36:8" />Attu onkhaye owooria uvara ntheko ahotheka Nihema Nitakatifu wo mapaziya khumi o ikuwo yorera yoteelha, ni uphwanelhihiya wo nttoche no mapururu o ikhondoro no irangi yo kibuluu, yo zambarau ni yo khwiilha, ni ufumiya ipicha cha amakerubi vachulhu. <verse eid="EXO 36:8" /><verse number="9" style="v" sid="EXO 36:9" />Urekama wo kila nipaziya waari miono makhumi ncheshe ni meelhi, makhuvi akhalhaka miono sita. Mapaziya onkhaye khumi ayo aholhikaana maphimelhiyo aya. <verse eid="EXO 36:9" /><verse number="10" style="v" sid="EXO 36:10" />Attu ayo aholhutaaniha mapaziya nthanu vamoka ukhalha ittu imoka ni makina nthanu ayo chiicho. <verse eid="EXO 36:10" /><verse number="11" style="v" sid="EXO 36:11" />Nkayaatottelha mikaanda cho kibuluu kila nlhuto no nipaziya nimoka, ni nkunjo wo nipaziya nno, ni upanga chiicho wo vathe, nlhuto no nayelhi nno. <verse eid="EXO 36:11" /><verse number="12" style="v" sid="EXO 36:12" />Ahottotelha mikaanda makhumi nthanu nipaziya nimoka, ni mikaanda makhumi nthanu mpindo wo nipaziya naari nijora no nayelhi nno, awehanaka nna ni nna. <verse eid="EXO 36:12" /><verse number="13" style="v" sid="EXO 36:13" />Yamalheke, ahokoorosha ivibaniyo cho uvarelhelha mapaziya makhumi nthanu cho idhahabu o ulhutaanihelha ivipande piilhi cho mapaziya alhe, paahi nihema nno nkanaakhalha ittu imoka. <verse eid="EXO 36:13" /><verse number="14" style="v" sid="EXO 36:14" />Yamalheke, ahokoorosha ikifuniko yo ukhunelha nihema wo mapaziya khumi ni moka no mapururu o ipuri. <verse eid="EXO 36:14" /><verse number="15" style="v" sid="EXO 36:15" />Kila nipaziya naari no urekama miono makhumi nthanu, makhuvi miono sita. Mapaziya onkhaye khumi ni moka aari o ulhikaana. <verse eid="EXO 36:15" /><verse number="16" style="v" sid="EXO 36:16" />Nkayaalhutaaniha mapaziya nthanu vamoka, ni mapaziya sita vamoka. <verse eid="EXO 36:16" /><verse number="17" style="v" sid="EXO 36:17" />Tho, ahotottelha mikaanda makhumi nthanu upindo wo nipaziya no mwisho no ikipande yo upacha, ni mikaanda makhumi nthanu upindo wo ikipande yo nayelhi. <verse eid="EXO 36:17" /><verse number="18" style="v" sid="EXO 36:18" />Yamalheke nkayaakoorosha mikaanda makhumi nthanu cho shaaba ni ulhutaaniha ivipande piilhi chilhe ukhalha nipaziya nimoka. <verse eid="EXO 36:18" /><verse number="19" style="v" sid="EXO 36:19" />Yamalheke yeyo, ahokoorosha ikifuniko yo nrapalha no wolhwaa no ikhondoro ilhopwana, ni vachulhu ikifuniko ikina yo nrapalha no wolhwaa no ipuri. <verse eid="EXO 36:19" /><verse number="20" style="v" sid="EXO 36:20" />Tho, nkayaakoorosha ifuremu cho weemeshera nihema cho imbau cho n'johoro. <verse eid="EXO 36:20" /><verse number="21" style="v" sid="EXO 36:21" />Kila ifuremu yaari yo urekama miono khumi ni nthanu ni makhuvi aya yaari moono mmoka ni nusu. <verse eid="EXO 36:21" /><verse number="22" style="v" sid="EXO 36:22" />Kila ifuremu yaari ni malhimi meelhi o ulhutaanihera. Ifuremu chonkhaye cho nihema nno chahokhalha ni malhimi ayo. <verse eid="EXO 36:22" /><verse number="23" style="v" sid="EXO 36:23" />Ifuremu chaakooroshiye chaari, makhumi meelhi mpata wo uchawa, <verse eid="EXO 36:23" /><verse number="24" style="v" sid="EXO 36:24" />ni ikhalhelho cho isiliva makhumi ncheshe, wuuthi wo kila ubau wiira chivarelhelhe malhimi meelhi ayo. <verse eid="EXO 36:24" /><verse number="25" style="v" sid="EXO 36:25" />Mpata wo nayelhi, yaani uchulhu wo nihema nno, ahokoorosha ifuremu makhumi meelhi chiicho, <verse eid="EXO 36:25" /><verse number="26" style="v" sid="EXO 36:26" />ni ikhalhelho chaya makhumi ncheshe cho isiliva wuuthi wo kila ifuremu. <verse eid="EXO 36:26" /><verse number="27" style="v" sid="EXO 36:27" />Mpata wo utulhi wo nihema, yaani uneelha nchuwa, ahokoorosha ifuremu sita <verse eid="EXO 36:27" /><verse number="28" style="v" sid="EXO 36:28" />Tho, ahokoorosha imbau piilhi cho ikhona cho utulhi wo nihema nno. <verse eid="EXO 36:28" /><verse number="29" style="v" sid="EXO 36:29" />Ifuremu piilhi cho mpararini chiyo chahohiyana wo vathi, nansho chaholhutaanihiya vaari ibangili yo upacha vawo. Ifuremu piilhi cho ikhona piilhi chiyo chaakooroshiye wo ulhikaana. <verse eid="EXO 36:29" /><verse number="30" style="v" sid="EXO 36:30" />Paahi ifuremu chiyo chaari nane ni ikhalhelho chaya cho isiliva chaari khumi ni sita, ikhalhelho piilhi wuuthi kila ifuremu. <verse eid="EXO 36:30" /><verse number="31" style="v" sid="EXO 36:31" />Tho, anamitheko ayo ahokoorosha mitambalapanya cho n'johoro, mitambalapanya nthanu cho mpata mmoka wo nihema, <verse eid="EXO 36:31" /><verse number="32" style="v" sid="EXO 36:32" />mitambalapanya nthanu cho mpata wo nayelhi wo nihema ni mitambalapanya nthanu cho ifuremu cho utulhi wo nihema, yaani uneelha nchuwa. <verse eid="EXO 36:32" /><verse number="33" style="v" sid="EXO 36:33" />Ahokoorosha tho n'gomba wo variyari waaphiyelha nusu yo nihema nno, waavira variyari nihema ukhuma uno mpaka uno. <verse eid="EXO 36:33" /><verse number="34" style="v" sid="EXO 36:34" />Ifuremu chonkhaye chiyo ahohikahika idhahabu, nkayaakooroshelha ibangili cho idhahabu cho uvarelhelha mishaamu chiyo, ni chiyo chahohikiya idhahabu.<verse eid="EXO 36:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 36:35" />Ahokoorosha nipaziya no ikuwo yorera yoteelha yaaphwanelhihiye ni nttoche no irangi yo kibuluu, yo zambarau ni yo khwiilha. Nkanaafumiya ipicha cha amakerubi ni attu o wooria yoyo ntheko uyo rata vachulhu waya. <verse eid="EXO 36:35" /><verse number="36" style="v" sid="EXO 36:36" />Yamalheke, nkayaakoorosha mikurio micheshe cho n'johoro, nkayaahikahika idhahabu ni uttukelhelha ni ivibaniyo cho uvarelhelha nipaziya cho idhahabu. Tho, ahokoorosha ikhalhelho ncheshe cho isiliva. <verse eid="EXO 36:36" /><verse number="37" style="v" sid="EXO 36:37" />Yamalheke, tho ahokoorosha nipaziya wo ikuwo yorera yoteelha yaattaviye ni ntu o urata chinene no nlhako wo nihema, naaphwanelhihiye ni nttoche no irangi yo kibuluu, yo zambarau ni yo khwiilha, <verse eid="EXO 36:37" /><verse number="38" style="v" sid="EXO 36:38" />ni mikurio chaya nthanu ni ivibaniyo chaya cho uvarelhelha nipaziya, chaahinke aya idhahabu wo uchulhu mpaka vathi, nansho ikhalhelho chaya nthanu chaari cho ishaaba.<verse eid="EXO 36:38" /></para>
  <chapter eid="EXO 36" />
  <chapter number="37" style="c" sid="EXO 37" />
  <para style="s1">Ukooroshiya Nisanduku no Malhehano</para>
  <para style="r">(<ref loc="EXO 25:10-22">Utt 25:10-22</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 37:1" />Paahi Nabezaleli ahokoorosha Nisanduku no Malhehano wo imbau cho n'johoro, no urekama miono miilhi ni nusu, ukhanuwa moono mmoka ni nusu ni nchusha naya moono mmoka ni nusu. <verse eid="EXO 37:1" /><verse number="2" style="v" sid="EXO 37:2" />Nkayaakhunelha wo uhika idhahabu yorera nhina ni vachulhu, nkayeesha ni nreko wo idhahabu wo urukureria mipata chonkhaye. <verse eid="EXO 37:2" /><verse number="3" style="v" sid="EXO 37:3" />Tho, ahokoorosha ibangili ncheshe cho idhahabu cho uvirihelhiya mishaamu cho uthathelha nisanduku nno. Nkayaawarihelha ikhona ncheshe chiyo, kila ikhona imoka ibangili imoka. <verse eid="EXO 37:3" /><verse number="4" style="v" sid="EXO 37:4" />Nkayaakoorosha mishaamu miilhi cho uthathelha nisanduku nno nsegasega, cho n'johoro ni uhika idhahabu vachulhu. <verse eid="EXO 37:4" /><verse number="5" style="v" sid="EXO 37:5" />Nkayaaviriha chechiyo mishaamu chiyo mbangilini mmwe munisandukuni mmo uno ni uno, wiira chithathelhiye nisanduku nno. <verse eid="EXO 37:5" /><verse number="6" style="v" sid="EXO 37:6" />Nkayaakoorosha ikifuniko yo idhahabu yorera, vaneehaniya nipuro yo woonelhiya attu ikiriri, yo urekama miono miilhi ni nusu, ni uchara waya moono mmoka ni nusu. <verse eid="EXO 37:6" /><verse number="7" style="v" sid="EXO 37:7" />yamalheke, ahaakoorosha amakerubi eelhi wo uhana idhahabu, ni weesha vachulhu ikifuniko yo nisanduku vawo, <verse eid="EXO 37:7" /><verse number="8" style="v" sid="EXO 37:8" />mmoka uno ni nkina uno. Onkhaye aakooroshiye wo ukhalha ittu imoka ni ikifuniko iyo. <verse eid="EXO 37:8" /><verse number="9" style="v" sid="EXO 37:9" />Yayo amakerubi ayo eeshiye wo uwehana, mapupha aya anookolhiye ni ukhunelha vachulhu nisanduku nno.<verse eid="EXO 37:9" /></para>
  <para style="s1">Ukooroshiya imeza yo Mikatte chinokumihiya isadaka wa Nlhuku</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 37:10" />Tho Nabezaleli ahokoorosha imeza yo n'johoro yo urekama miono miilhi, ukhanuwa moono mmoka ni nchusha naya moono mmoka ni nusu. <verse eid="EXO 37:10" /><verse number="11" style="v" sid="EXO 37:11" />Nkayaakhunelha wo uhika idhahabu yorera ni urukureriha nreko wo idhahabu. <verse eid="EXO 37:11" /><verse number="12" style="v" sid="EXO 37:12" />Tho ahorukureriha ubau, ukhanuwa waya makokho macheshe mipata chonkhaye. <verse eid="EXO 37:12" /><verse number="13" style="v" sid="EXO 37:13" />Nkayaakoorosha ibangili ncheshe cho uvirihiya mishaamu cho uthathelha nisanduku ni uwarihelha ikhona ncheshe vanomalhelha aya mieto cho imeza iyo. <verse eid="EXO 37:13" /><verse number="14" style="v" sid="EXO 37:14" />Chechiyo ibangili cho uthathelha imeza chiyo chaalhutanihiye vakhiviru ni ubau waarukurerihiye ulhe. <verse eid="EXO 37:14" /><verse number="15" style="v" sid="EXO 37:15" />Nkayaakoorosha mishaamu miilhi cho n'johoro cho uthathelha nisanduku nno, nkayaahika idhahabu. <verse eid="EXO 37:15" /><verse number="16" style="v" sid="EXO 37:16" />Tho wo idhahabu yorera iyo ahokoorosha ikaruma chonkhaye cho weeshiya vachulhu imeza iyo, yaani isahani ni ivisahani cho weesheriya ubani, ikikombe chaya ni inyipo chaya cho uhelhiya isadaka yo cho uwuriya.<verse eid="EXO 37:16" /></para>
  <para style="s1">Ukooroshiya iphata yo uthomeiya ikhandiri</para>
  <para style="r">(<ref loc="EXO 25:31-40">Utt 25:31-40</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 37:17" />Tho, ahokoorosha iphata yo uthomeiya ikhandiri wo idhahabu yorera. Nkayaakoorosha ni ikhalhelho aya ni nkupu aya waahaniye ni idhahabu, maua aya, yaari ni ikhuche chaya ni ituva chaya, chonkhaye chikhalhaka ittu imoka ni iphata iyo. <verse eid="EXO 37:17" /><verse number="18" style="v" sid="EXO 37:18" />Iritta sita chikhalhaka kila mpata wo nreko nno, iritta ttaru mpata mmoka ni iritta ttaru mpata nkina. <verse eid="EXO 37:18" /><verse number="19" style="v" sid="EXO 37:19" />Kila iritta imoka chahokhalha ikikombe ttaru cho ulhikaana ni maua o mwiri wo mlozi. Kila imoka ni ituva aya ni niuwa naya. <verse eid="EXO 37:19" /><verse number="20" style="v" sid="EXO 37:20" />Vankupuni vawo vahokhalha ikikombe ncheshe chaakooroshiye wo ulhikaana ni maua o mwiri wo mlozi, vamoka ni ituva chaya ni maua aya. <verse eid="EXO 37:20" /><verse number="21" style="v" sid="EXO 37:21" />Kila vaakhumme iritta ttaru vawo wo vathi, wahokhalha ituva imoka. <verse eid="EXO 37:21" /><verse number="22" style="v" sid="EXO 37:22" />Ituva chiyo ni iritta chaya chiyo yaari ittu imoka ni iphata iyo, yaakooroshiye wo uhaniya idhahabu yorera. <verse eid="EXO 37:22" /><verse number="23" style="v" sid="EXO 37:23" />Ahokoorosha ni ikhandiri chaya saba, ikoleo chaya ni ivisahani chaya cho idhahabu yorera. <verse eid="EXO 37:23" /><verse number="24" style="v" sid="EXO 37:24" />Nkayaakoorosha iphata ni chittu chaya wo ikilo makhumi mararu ni nthanu cho idhahabu yorera.<verse eid="EXO 37:24" /></para>
  <para style="s1">Ukooroshiya Madhubahu o Ututumiherelha ubani</para>
  <para style="r">(<ref loc="EXO 30:1-5">Utt 30:1-5</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 37:25" />Nabezaleli ahokoorosha madhubahu o utumiherelhiya ubani o imbau cho n'johoro. Madhubahu ayo aari o ulhikaana, kila mpata waari moono mmoka. Yaani urekama waya, ukhanuwa waya ni nchusha naya. Inyaka cho ikhona chaya chiyo chaari ittu imoka ni madhubahu anene ayo. <verse eid="EXO 37:25" /><verse number="26" style="v" sid="EXO 37:26" />Nkaahika idhahabu yorera chonkhaye chiyo, uchulhu, mpararini, ni inyaka chaya. Tho ahokooroshelha nreko wo idhahabu. <verse eid="EXO 37:26" /><verse number="27" style="v" sid="EXO 37:27" />Ahokoorosha ni ibangili piilhi cho idhahabu wuuthi nreko wo madhubahu uyo uno ni uno. Chechiyo ibangili chiyo chaari cho uvirihiya mishaamu cho uthathelha madhubahu ayo. <verse eid="EXO 37:27" /><verse number="28" style="v" sid="EXO 37:28" />Tho, ahokoorosha mishaamu miilhi ni uhika idhahabu vachulhu.<verse eid="EXO 37:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 37:29" />Yamalheke, ahokoorosha makhura matakatifu o uhikiya ni ubani worera wo unukhelha chinene. Nkayaathakaniha ubani uyo ni makhura o unukhelha thoko chinopangiya ni attu o wooria yoyo ntheko uyo.<verse eid="EXO 37:29" /></para>
  <chapter eid="EXO 37" />
  <chapter number="38" style="c" sid="EXO 38" />
  <para style="s1">Ukooroshiya Madhubahu o upaheriya isadaka</para>
  <para style="r">(<ref loc="EXO 27:1-8">Utt 27:1-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 38:1" />Nkayaakoorosha madhubahu o upaheriya isadaka, ni ayo aakooroshiye wo imbau cho n'johoro. Aari o urekama miono nthanu, ukhanuwa waya miono nthanu, yaani yaari yo nraba. Nchusha naari miono miraru. <verse eid="EXO 38:1" /><verse number="2" style="v" sid="EXO 38:2" />Kila ikhona yo madhubahu ayo ahokoorosha inyaka yaakhanlhe ittu imoka ni madhubahu ayo, nkayaakhunelha wo uhika ishaaba. <verse eid="EXO 38:2" /><verse number="3" style="v" sid="EXO 38:3" />Tho, ahokoorosha ikaruma chonkhaye cho madhubahu ayo, yaani, iyoopwe, isepetu, inyipo, iyuma cho urukunushelha inama, ni isahani cho uvalhelha mooro. Chonkhaye chiyo aakooronshe wo shaaba. <verse eid="EXO 38:3" /><verse number="4" style="v" sid="EXO 38:4" />Tho, ahokoorosha nttavi no shaba no ukhalhiheriya ikhuni ni makhalha. Nkayeesha wuuthi madhubahu ayo wo variyari. <verse eid="EXO 38:4" /><verse number="5" style="v" sid="EXO 38:5" />Nkayaakoorosha ni ibangili ncheshe cho uvirihiya mishaamu cho uthathelha nsegasega madhubahu ayo, chaawarihiye ikhona ncheshe chiyo. <verse eid="EXO 38:5" /><verse number="6" style="v" sid="EXO 38:6" />Ahokoorosha ni mishaamu cho n'johoro cho uthathelha madhubahu ni uhika ishaaba, <verse eid="EXO 38:6" /><verse number="7" style="v" sid="EXO 38:7" />nkayaaviriha mishaamu chiyo mbangilini mwaawarihiye ikhona cho madhubahu chilhe. Madhubahu ayo aakooroshiye thoko nisanduku no imbau ni ukhalha mwaari nhina mmo.<verse eid="EXO 38:7" /></para>
  <para style="s1">Ukooroshiya inyipo yulhupalhe yo shaaba</para>
  <para style="r">(<ref loc="EXO 30:18">Utt 30:18</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 38:8" />Yamalheke, Nabezaleli ni anamitheko akhunanaya ahokoorosha inyipo yulhupalhe yo ishaaba ni ikhalhelho aya yo shaaba chiicho. Inyipo yulhupalhe iyo yaari yo ivipande cho shaaba chaakumihiye ni manyoopani aakavihera ntheko vanlhakoni u Nihema Nitakatifu, chaapanga aya ikioo cho wiiwehera.<verse eid="EXO 38:8" /></para>
  <para style="s1">Ukooroshiya ntenje no Nihema Nitakatifu</para>
  <para style="r">(<ref loc="EXO 27:9-19">Utt 27:9-19</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 38:9" />Tho, amalhihekeru vavawo, ahotheka ntenje no mapaziya o ikuwo yorera yoteelha. Mapaziya o mpata wo uchawa aari o utalhiva miono imia imoka. <verse eid="EXO 38:9" /><verse number="10" style="v" sid="EXO 38:10" />Mikurio chaya chaari cho miuru cho shaaba makhumi meelhi, ni ikhalhelho makhumi meelhi cho ishaaba chiicho. Nansho mapoopola ni ivibaniyo cho uvarelhelha nipaziya chaari cho isiliva. <verse eid="EXO 38:10" /><verse number="11" style="v" sid="EXO 38:11" />Mpata wo uchulhu mapaziya aari o utalhiva miono imia imoka, ni ikhalhelho makhumi meelhi cho shaaba, nansho mapoopola ni ivibaniyo chaya cho uvarelhelha nipaziya chaari cho isiliva. <verse eid="EXO 38:11" /><verse number="12" style="v" sid="EXO 38:12" />Mapaziya o mpata uneelha nchuwa, aari o utalhiva miono makhumi nthanu, mikurio khumi ni ikhalhelho chaya khumi, mapoopola ni ivibaniyo chaya cho uvarelhelha nipaziya chaari cho isiliva. <verse eid="EXO 38:12" /><verse number="13" style="v" sid="EXO 38:13" />Unosha nchuwa, waari nlhako uwo, ukhanuwa waari miono makhumi nthanu. <verse eid="EXO 38:13" /><verse number="14" style="v" sid="EXO 38:14" />Nipaziya no kila mpata vanlhakoni naari, miono khumi ni nthanu utalhiva waya, ni mikurio miraru, ni ikhalhelho ttaru, <verse eid="EXO 38:14" /><verse number="15" style="v" sid="EXO 38:15" />tho mpata nkina uyo chiicho. Vanlhakoni vawo nipaziya naari no miono khumi ni nthanu utalhiva waya, mikurio miraru ni ikhalhelho ttaru uno ni chiichammo ukina uwo. <verse eid="EXO 38:15" /><verse number="16" style="v" sid="EXO 38:16" />Mapaziya onkhaye o ntenje nno yaari o ikuwo yottaviya yorera yoteelha. <verse eid="EXO 38:16" /><verse number="17" style="v" sid="EXO 38:17" />Ikhalhelho chonkhaye cho mikurio chaari cho ishaaba, nansho ivibaniyo chaya cho uvarelhelha nipaziya ni ivibaniyo cho uttukelha chiyo chaari cho isiliva. Mikurio chonkhaye cho ntenje chiyo chaalhutaanihiye ni mapoopola o isiliva. <verse eid="EXO 38:17" /><verse number="18" style="v" sid="EXO 38:18" />Nipaziya no vanlhakoni naari no ikuwo yorera yoteelha naattavelhiye ni nttoche no irangi yo kibuluu, no irangi yo zambarau ni yo khwiilha. Naari no urekama miono makhumi meelhi, naakhunelha miono nthanu, wo ulhikaana ni mapaziya makina o ntenje nno chaari aya.<verse eid="EXO 38:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 38:19" />Tho, mikurio chaya chaari ncheshe, cho miuru cho shaaba. Mapoopola aya yaari o isiliva, miuru chaya ni ivibaniyo cho uttukelhelha chaari cho isiliva. <verse eid="EXO 38:19" /><verse number="20" style="v" sid="EXO 38:20" />Ikhomo chonkhaye cho nihema ni cho ntenje chaari cho ishaaba.<verse eid="EXO 38:20" /></para>
  <para style="s1">Ikaruma chaathekelhiye nihema</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 38:21" />Alha phi maaalhakelhiyo o chittu chaathekelhiye Nihema Nitakatifu, yaani nihema weeshiye Nisanduku no Malhehano naari malhuku aalhepiye malheheriyo a Apwiiya Nlhuku. Chaalhakelhiye ni Alawi yaahoolhelhiye ni Naithamari, mwaamwanaya opochera ishaani, Naharuni, thoko chaalheheriye aya ni ashinna Musa.<verse eid="EXO 38:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 38:22" />Nabezaleli anaaya Nauri, uchulhu u Nahuri, o nikosho ni Nayuda ahopanga chittu chonkhaye Apwiiya Nlhuku chaalhehenre aya ashinna Musa wiira chipangiye. <verse eid="EXO 38:22" /><verse number="23" style="v" sid="EXO 38:23" />Owaakaviha ntheko uyo yaari Naoholiabu anaaya Naahisamaki, o nihimo ni Nadani. Yayo yaari o wooria chinene uhema malhuku ni ukoorosha mapambo, namitheko o irusho, o wooria uphwanelhiha rata ikuwo yorera yoteelha wo nttoche no irangi yo kibuluu, yo zambarau ni yo khwiilha.<verse eid="EXO 38:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 38:24" />Idhahabu yonkhaye yaakumihiye wa Apwiiya Nlhuku, wo nlhatu wo uvarelhiya ntheko wo uthekiya Nihema Nitakatifu yaari ikilo imia nane ni makhumi saba ni saba, ni igramu imia ttaru, wo ulhikaana ni maphimelhiyo eeshiye u Nihema Nitakatifu nno. <verse eid="EXO 38:24" /><verse number="25" style="v" sid="EXO 38:25" />Malhuku o isiliva aakumihiye ni nlhoko wa attu ayo thoko chenre aya wo waalhakelhiya, yaari ikilo maelufu mararu, ni khumi ni saba, ni igramu imia saba ni makhumi nthanu, wo ulhikaana ni maphimelhiyo eeshiye u Nihema Nitakatifu nno. <verse eid="EXO 38:25" /><verse number="26" style="v" sid="EXO 38:26" />Kila ntu o iyaakha makhumi meelhi ni uthepa, ahaalhakelhiya, ni kila mmoka ahokumiha isiliva igramu nthanu thoko chaalheheriye u Nihema Nitakatifu. Attu onkhaye yaalhakelhiye yaari manyaalhopwana, laki sita ni maelufu mararu, ni imia nthanu ni makhumi nthanu. <verse eid="EXO 38:26" /><verse number="27" style="v" sid="EXO 38:27" />Isiliva ikilo maelufu mararu chahotumika ukooroshelhiya ikhalhelho imia imoka cho Nihema Nitakatifu chilhe, ni nipaziya. Vavawo yaani ikilo makhumi mararu kila ikhalhelho imoka. <verse eid="EXO 38:27" /><verse number="28" style="v" sid="EXO 38:28" />Ikilo khumi ni saba ni igramu makhumi saba ni nthanu chaahanlhe, chaatumikilhe ukooroshelha mapoopola o uttukelha mikurio, ni uhikahikiya mikurio vachulhu, ni ukooroshelha ittevereve cho uvarelhelha nipaziya. <verse eid="EXO 38:28" /><verse number="29" style="v" sid="EXO 38:29" />Wo waalhakelhiya, ishaaba yaakumihiye ni Aisraeli wa Apwiiya Nlhuku yaari, ikilo maelufu meelhi, imia imoka ni makhumi meelhi ni ncheshe. <verse eid="EXO 38:29" /><verse number="30" style="v" sid="EXO 38:30" />Phi iyo yaakhushilhe aya Nabezaleli ukooroshelha ikhalhelho cho nlhako wo Nihema Nitakatifu, madhubahu o upahera isadaka, nttavi naya no weeshiya ikhuni ni makhalha, ikaruma chonkhaye cho madhubahu, <verse eid="EXO 38:30" /><verse number="31" style="v" sid="EXO 38:31" />ikhalhelho cho mikurio cho ntenje chaarukurenrie mipata chonkhaye, cho nlhako wo ntenje, ikhomo chonkhaye cho Nihema Nitakatifu.<verse eid="EXO 38:31" /></para>
  <chapter eid="EXO 38" />
  <chapter number="39" style="c" sid="EXO 39" />
  <para style="s1">Utottiya ikuwo cho Opochera ishaani</para>
  <para style="r">(<ref loc="EXO 28:1-14">Utt 28:1-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 39:1" />Nabezaleli, Naoholiabu vamoka ni anamitheko akina ahototta ikuwo chorera cho uwara Naharuni vanovara aya ntheko wo opochera ishaani u Nihema Nitakatifu. Yaakooronshe wo ikuwo cho irangi yo kibuluu, yo zambarau, ni yo khwiilha, thoko Apwiiya Nlhuku chenre aya wo waalhehera ashinna Musa. <verse eid="EXO 39:1" /><verse number="2" style="v" sid="EXO 39:2" />Tho, ahottota ikuwo ukhunelha ikhakacha wo nttoche no uttaviya no idhahabu yorera no irangi yo kibuluu, yo zambarau, ni yo khwiilha vachulhu ikuwo yorera yoteelha. <verse eid="EXO 39:2" /><verse number="3" style="v" sid="EXO 39:3" />Nkayaathulhusha idhahabu ni uthikilhacha nttoche no uyevayeva wiira nittaviye vamoka ni ikuwo yorera yo irangi yo kibuluu, yo irangi yo zambarau, ni yo khwiilha, vachulhu ikuwo yorera yoteelha ittaviye wo uratiya chinene. <verse eid="EXO 39:3" /><verse number="4" style="v" sid="EXO 39:4" />Ikuwo yo ukhunelha ikhakacha iyo yaawariya wo uttukiya mikaanda miilhi vamakhathani ni ukumaana. <verse eid="EXO 39:4" /><verse number="5" style="v" sid="EXO 39:5" />Ahokoorosha ni nshipi waattaviye rata wiira uttukiye vamoka ni ukhalha ittu imoka ni ikuwo yo ukhunelha ikhakacha iyo. Yoyo waattaviye wo chechiyo chittu chiyo, idhahabu, ikuwo yorera yo irangi yo kibuluu, yo irangi yo zambarau, ni yo khwiilha, yoottaviya, vamoka ni ikuwo yorera yoteelha thoko Apwiiya Nlhuku chaalhehenre aya ashinna Musa. <verse eid="EXO 39:5" /><verse number="6" style="v" sid="EXO 39:6" />Yamalheke, yahokooroshacha malhuku o isadoniki ni uvarelhelhiha ni idhahabu, ni ukheria thoko nhuri machina a achishaana khumi ni elhi a Nayakhobo. <verse eid="EXO 39:6" /><verse number="7" style="v" sid="EXO 39:7" />Nkayeesha yayo malhuku ayo vachulhu mikaanda chaattukiya vamakhathani wiira eemelhelhe machina a achishaana a Nayakhobo khumi ni elhi, thoko Apwiiya Nlhuku chaalhehenre aya ashinna Musa.<verse eid="EXO 39:7" /></para>
  <para style="s1">Nrupa wo vakhakaachani</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 39:8" />Tho, ahototta nrupa wo vakhakaachani, wo ikuwo ni nttoche no irangi thoko chikooroshilhe aya ikuwo yo ukhunelha ikhakacha ilhe. <verse eid="EXO 39:8" /><verse number="9" style="v" sid="EXO 39:9" />Nrupa uyo waari wo ulhikaana ipatta chaya chonkhaye, urekama ni ukhanuwa waya nthatha nimoka, tho waari wo ukunjiya. <verse eid="EXO 39:9" /><verse number="10" style="v" sid="EXO 39:10" />Nrupa uyo waapambiye ni isafu ncheshe cho malhuku o nhakhu. Isafu imoka yaari yo o iakiki, itopazi ni almasi yo khwiilha. <verse eid="EXO 39:10" /><verse number="11" style="v" sid="EXO 39:11" />Isafu yo nayelhi yaari yo zamaradi, iyakuti yo kibuluu ni almasi. <verse eid="EXO 39:11" /><verse number="12" style="v" sid="EXO 39:12" />Isafu yo neraru yaari yo iyasintho, iakiki yo khwiilha ni amethesito. <verse eid="EXO 39:12" /><verse number="13" style="v" sid="EXO 39:13" />Yo necheshe yaari yo izabarajadi, ishohamu ni yaspi. Onkhaye ayo ahomiinelhiya mwaavarelhelhiya ni idhahabu mmo. <verse eid="EXO 39:13" /><verse number="14" style="v" sid="EXO 39:14" />Paahi aari malhuku khumi ni meelhi aakheriye machina a achishaana a Nayakhobo. Aakheriye thoko chinokheriya aya nhuri, kila nimoka nikheriyaka nchina no weemelhelha nihimo nimoka no achishaana khumi ni meelhi a Nayakhobo. <verse eid="EXO 39:14" /><verse number="15" style="v" sid="EXO 39:15" />Tho, ahokoorosha mikufu cho idhahabu yorera cho uwarihiya nrupa wo vakhakaachani valhe cho ukhalha thoko miripwe. <verse eid="EXO 39:15" /><verse number="16" style="v" sid="EXO 39:16" />Nkayaakoorosha ni cho uvarelha piilhi cho idhahabu yorera, ni apete elhi o idhahabu chiicho, ni utottelha apete ayo ikhona piilhi cho nchulhu cho nrupa uyo. <verse eid="EXO 39:16" /><verse number="17" style="v" sid="EXO 39:17" />Nkayaattukelhelha mikufu miilhi cho idhahabu chiyo vapeteni aawarihiye nrupa wo vakhakaachani chiyo. <verse eid="EXO 39:17" /><verse number="18" style="v" sid="EXO 39:18" />Ni mikaanda miilhi cho idhahabu chilhe ahottukelhelha chittu piilhi cho uvarelhelha chilhe ni uvaraaniha ikipande piilhi cho ikuwo yo ukhunelha ikhakacha chaari vamakhathani, wo uhoolho. <verse eid="EXO 39:18" /><verse number="19" style="v" sid="EXO 39:19" />Tho, ahokoorosha apete eelhi o idhahabu, nkayaawariha ikhona piilhi cho nhina nrupa wo vakhakaachani kharibu ni ikuwo yo ukhunelha ikhakacha. <verse eid="EXO 39:19" /><verse number="20" style="v" sid="EXO 39:20" />Nkayaakoorosha apete eelhi tho, o idhahabu ni uwariha uhoolho, ikhona piilhi cho vathi cho ikuwo yo ukhunelha ikhakacha, vanokumaana nshipi uttaviye rata ulhe. <verse eid="EXO 39:20" /><verse number="21" style="v" sid="EXO 39:21" />Nkayaattuka nrupa wo vakhakaachani vachulhu ikuwo yo ukhunelha ikhakacha wo miripwe miilhi cho irangi yo kibuluu, wiira uhithaphuwe, nansho ukhalhelheke nshipi uttaviye rata ulhe thoko Apwiiya Nlhuku chaalhehenre aya ashinna Musa.<verse eid="EXO 39:21" /></para>
  <para style="s1">Utottiya ikanzu</para>
  <para style="r">(<ref loc="EXO 28:31-43">Utt 28:31-43</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 39:22" />Yamalheke ahototta ikanzu yo irangi yo kibuluu yo uwarelhiya ikuwo yo ukhunelha ikhakacha. <verse eid="EXO 39:22" /><verse number="23" style="v" sid="EXO 39:23" />Yeyo ikanzu iyo yahokhalha ni vakittu wo uviriha muru variyari, ni iyo yaheeshiya mminiko wo ufumiya wo ishiko aya iyo wiira ihaahuwe. <verse eid="EXO 39:23" /><verse number="24" style="v" sid="EXO 39:24" />Mminiko wo vathi wo ikanzu iyo wahofumiya mapambo o makomamanga o irangi yo kibuluu, o irangi yo zambarau, ni o irangi yo khwiilha, ni ikuwo yoottaviya yorera yoteelha. <verse eid="EXO 39:24" /><verse number="25" style="v" sid="EXO 39:25" />Yamalheke ahokoorosha injuga cho idhahabu, ni kila baada yo nikomamanga nimoka aheesha injuga vamminikoni wo ikanzu iyo. <verse eid="EXO 39:25" /><verse number="26" style="v" sid="EXO 39:26" />Paahi injuga ni makomamanga ayo ahottwaraana urukureria mminiko wo ikanzu iyo, thoko Apwiiya Nlhuku chaalhehenre aya ashinna Musa. <verse eid="EXO 39:26" /><verse number="27" style="v" sid="EXO 39:27" />Amalhihekeru vavawo, ahototta mikogo chi Naharuni ni achishaana aya wo ikuwo yorera yoteelha, <verse eid="EXO 39:27" /><verse number="28" style="v" sid="EXO 39:28" />mphumburu woteelha, ikofia chorera choteelha, isuruwali fupi cho ikuwo yorera yoteelha yottaviya, <verse eid="EXO 39:28" /><verse number="29" style="v" sid="EXO 39:29" />ni mishipi choteelha choorera choottaviya, cho irangi yo kibuluu, yo irangi yo zambarau, ni yo khwiilha, ni ufumiya rata thoko Apwiiya Nlhuku chaalhehenre aya ashinna Musa. <verse eid="EXO 39:29" /><verse number="30" style="v" sid="EXO 39:30" />Tho, ahokoorosha nipambo no ikibati yo idhahabu yorera no ittaji itakatifu ni ulhepa vachulhu vawo, “Nthimicho, ukhalhe wa Apwiiya Nlhuku.” <verse eid="EXO 39:30" /><verse number="31" style="v" sid="EXO 39:31" />Nkayaattuka uhoolho wo mphumburu uyo wo nripwe wo irangi yo kibuluu, thoko Apwiiya Nlhuku chaalhehenre aya ashinna Musa.<verse eid="EXO 39:31" /></para>
  <para style="s1">Umalhihiya wo ntheko</para>
  <para style="p">
    <verse number="32" style="v" sid="EXO 39:32" />Paahi ntheko wonkhaye wo Nihema Nitakatifu wahomalha. Aisraeli ahopanga chittu chonkhaye thoko Apwiiya Nlhuku chaalhehenre aya ashinna Musa. <verse eid="EXO 39:32" /><verse number="33" style="v" sid="EXO 39:33" />Nkayaawiiha Nihema Nitakatifu wa ashinna Musa vamoka ni chittu chaya chonkhaye, mikhoyi cho uvarelhelha nipaziya, ifuremu chaya, mapoopola, mikurio ni ikhalhelho chaya, <verse eid="EXO 39:33" /><verse number="34" style="v" sid="EXO 39:34" />ikifuniko yo marapalha o ikhondoro madume ni ikifuniko yo marapalha o ipuri yaahelhiye irangi yo khwiilha, nipaziya no Vakittu Vatakatifu, <verse eid="EXO 39:34" /><verse number="35" style="v" sid="EXO 39:35" />Nisanduku no Malhehano, mishaamu chaya cho uthathelha nsegasega, ikifuniko, yaari phi vaneehaniya nipuro no woonelhiya attu ikiriri. <verse eid="EXO 39:35" /><verse number="36" style="v" sid="EXO 39:36" />Tho, imeza ni chittu chaya chonkhaye, mikatte mitakatifu chikumihiye isadaka wa Nlhuku, <verse eid="EXO 39:36" /><verse number="37" style="v" sid="EXO 39:37" />iphata yo idhahabu yorera yo uthomeiya ikhandiri, ikhandiri ni ikaruma chaya chonkhaye, vamoka ni makhura o uhelhiya ikhandiri chiyo, <verse eid="EXO 39:37" /><verse number="38" style="v" sid="EXO 39:38" />madhubahu o idhahabu, makhura o uhikiya, ubani wo unukhelha, nipaziya no nlhako wo Nihema Nitakatifu, <verse eid="EXO 39:38" /><verse number="39" style="v" sid="EXO 39:39" />madhubahu o ishaaba ni mattavi aya o ishaaba, mishaamu chaya cho uthathelha ni ikaruma chaya chonkhaye, inyipo yulhupalhe ni ikhalhelho aya, <verse eid="EXO 39:39" /><verse number="40" style="v" sid="EXO 39:40" />mapaziya o ntenje, mikurio chaya ni ikhalhelho chaya, nipaziya no nlhako wo ntenje, ivibaniyo chaya cho uvarelhelha nipaziya ni ikhomo chaya, ikaruma chonkhaye chaathananiya uvarelhiya ntheko u Nihema Nitakatifu, <verse eid="EXO 39:40" /><verse number="41" style="v" sid="EXO 39:41" />ikuwo chonkhaye chaatottiye rata wo nlhatu wo uwariya ni Naharuni ni achishaana aya vanovara aya ntheko wo opochera ishaani Vakittu Vatakatifu. <verse eid="EXO 39:41" /><verse number="42" style="v" sid="EXO 39:42" />Aisraeli ahopanga kila ittu thoko Apwiiya Nlhuku chaalhehenre aya ashinna Musa. <verse eid="EXO 39:42" /><verse number="43" style="v" sid="EXO 39:43" />Ashinna Musa ahovira ni uweha kila ittu, nkayaachivelhiya wiira attu ahopanga kila ittu thoko Apwiiya Nlhuku chenre aya wo ulhehera. Paahi etu ashinna Musa ahaavahacha ibarakha.<verse eid="EXO 39:43" /></para>
  <chapter eid="EXO 39" />
  <chapter number="40" style="c" sid="EXO 40" />
  <para style="s1">Weemeshiya Nihema Nitakatifu</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 40:1" />Apwiiya Nlhuku nkayeerelha ashinna Musa wiira, <verse eid="EXO 40:1" /><verse number="2" style="v" sid="EXO 40:2" />“Mweemesheke Nihema Nitakatifu nno mwaahino, nihuku no upacha no mweeri wo upacha. <verse eid="EXO 40:2" /><verse number="3" style="v" sid="EXO 40:3" />Nhina mmo, mweesheke Nisanduku no Malhehano, mwamalhihaka mweesheke nipaziya umihoolho waya. <verse eid="EXO 40:3" /><verse number="4" style="v" sid="EXO 40:4" />Mweesheke imeza ni uphaka chittu chaya vachulhu vawo. Tho, mmwiiheke iphata ni uthomia ikhandiri chiyo vachulhu waya. <verse eid="EXO 40:4" /><verse number="5" style="v" sid="EXO 40:5" />Mwamalhihaka, mweesheke madhubahu o ututumiheriya ubani umihoolho wo Nisanduku no Malhehano. Mwamalhihaka vavawo, nttukelhelheke nipaziya vanlhakoni wo Nihema Nitakatifu. <verse eid="EXO 40:5" /><verse number="6" style="v" sid="EXO 40:6" />Tho, mweesheke madhubahu o upaheriya isadaka uhoolho wo nlhako wo Nihema Nitakatifu. <verse eid="EXO 40:6" /><verse number="7" style="v" sid="EXO 40:7" />Mweesheke ni inyipo yuulhupalhe yo maashi o unyawa variyari wo Nihema Nitakatifu ni madhubahu, ni uchariha maashi. <verse eid="EXO 40:7" /><verse number="8" style="v" sid="EXO 40:8" />Nttukelhelheke nipaziya no urukureria ntenje, ni uttukelhelha nipaziya vanlhakoni vawo.<verse eid="EXO 40:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 40:9" />“Mwamalhaka vavawo, nkusheke makhura o uhikiya ayo ni uhikahika Nihema Nitakatifu ni ikaruma chaya chonkhaye. Vavawo phi nohalha aya ukhalha nitakatifu. <verse eid="EXO 40:9" /><verse number="10" style="v" sid="EXO 40:10" />Tho, nhikeke makhura madhubahu o ukumiheriya isadaka chinohalha upahiya ni ikaruma chinovarelhiya ntheko, ni iyo inookhalha itakatifu. <verse eid="EXO 40:10" /><verse number="11" style="v" sid="EXO 40:11" />Tho, nhikeke makhura inyipo yulhupalhe iyo ni ikhalhelho aya iyo chiicho.<verse eid="EXO 40:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 40:12" />“Mwamalhihaka, mwaawiiheke Naharuni ni achishaana aya awaache vanlhakoni Nihema Nitakatifu vawo, mwaakhuchiheke maashi. <verse eid="EXO 40:12" /><verse number="13" style="v" sid="EXO 40:13" />Mwaawariheke Naharuni ikuwo chitakatifu chilhe, mwaahikeke makhura ni waahelha utakatifu, wiira avare ntheko aka wo opochera ishaani. <verse eid="EXO 40:13" /><verse number="14" style="v" sid="EXO 40:14" />Mweehanacheke achishaana aya ayo, mwaawariheke mikogo chaya chilhe. <verse eid="EXO 40:14" /><verse number="15" style="v" sid="EXO 40:15" />Mwamalhihaka, mwaahikeke makhura thoko aahikilhe inyu athumwanaya ayo, wiira ni ayo avare ntheko aka wo opochera ishaani. Ukhalhawaya uhikiya makhura uwo, unowaakelhiha ntheko wo opochera ishaani, wo uhimalha ni iyari chaya chonkhaye.”<verse eid="EXO 40:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 40:16" />Ashinna Musa ahopanga chittu chonkhaye thoko Apwiiya Nlhuku chenre aya wo ulhehera. <verse eid="EXO 40:16" /><verse number="17" style="v" sid="EXO 40:17" />Paahi nihuku no upacha no mweeri wo upacha wo iyaakha yo nayelhi baada yo uthama Umisri, ashinna Musa ni Aisraeli aheemesha Nihema Nitakatifu. <verse eid="EXO 40:17" /><verse number="18" style="v" sid="EXO 40:18" />Wo uttwara malhehero a ashinna Musa, Aisraeli aheemesha Nihema Nitakatifu, weesha ikhalhelho chaya, weemesha mikurio, weemesha ifuremu chaya ni ulhutaaniha mapoopola. <verse eid="EXO 40:18" /><verse number="19" style="v" sid="EXO 40:19" />Nkayaathaphurulha nipaziya, nkayaarukureriha, ni ukhuneelha vachulhu Nihema Nitakatifu, thoko Apwiiya Nlhuku chenre aya wo waalhehera. <verse eid="EXO 40:19" /><verse number="20" style="v" sid="EXO 40:20" />Yamalheke, ahokusha ikipande piilhi cho malhuku chaalhepiye Malheheriyo ni uhelha nhina Nisanduku no Malhehano. Nkayaakusha mishaamu chilhe ni weesha vachulhu nisanduku, ni weesha ikifuniko vachulhu nisanduku vawo vaneehaniya nipuro no woonelhiya attu ikiriri. <verse eid="EXO 40:20" /><verse number="21" style="v" sid="EXO 40:21" />Nkayeesha Nisanduku no Malhehano nno Nnihemani ni uttukelhelha nipaziya. Paahi wo upanga chiicho, ahotiyelhelha attu ahoone Nisanduku no Malhehano, thoko chaalheheriye aya ni Apwiiya Nlhuku. <verse eid="EXO 40:21" /><verse number="22" style="v" sid="EXO 40:22" />Nkayeesha ni imeza Nnihemani, mpata wo uchulhu, vathe wo nipaziya. <verse eid="EXO 40:22" /><verse number="23" style="v" sid="EXO 40:23" />Vachulhu imeza vawo aheesha mikatte chikumihiye isadaka wa Apwiiya Nlhuku, thoko chaalheheriye aya ni Apwiiya Nlhuku. <verse eid="EXO 40:23" /><verse number="24" style="v" sid="EXO 40:24" />Nkayeemesha iphata yo uthomeiya ikhandiri Nnihemani mpata wo uchawa, waatameria imeza iyo. <verse eid="EXO 40:24" /><verse number="25" style="v" sid="EXO 40:25" />Nkaaaparihelha ikhandiri chiyo umihoolho wa Apwiiya Nlhuku, thoko Apwiiya Nlhuku chenre aya wo ulhehera. <verse eid="EXO 40:25" /><verse number="26" style="v" sid="EXO 40:26" />Yamalhekeru, ashinna Musa aheesha madhubahu o idhahabu alhe Nnihemani, uhoolho wo nipaziya, <verse eid="EXO 40:26" /><verse number="27" style="v" sid="EXO 40:27" />nkayaapaha ubani wo unukhelha thoko chaalheheriye aya ni Apwiiya Nlhuku. <verse eid="EXO 40:27" /><verse number="28" style="v" sid="EXO 40:28" />Nkayaattukelhelha nipaziya vanlhakoni wo Nihema Nitakatifu, <verse eid="EXO 40:28" /><verse number="29" style="v" sid="EXO 40:29" />nkayeesha madhubahu o isadaka yo upahiya, ni isadaka yo choolhia, vakhiviru ni nlhako wo Nihema Nitakatifu, thoko chaalheheriye aya ni Apwiiya Nlhuku. <verse eid="EXO 40:29" /><verse number="30" style="v" sid="EXO 40:30" />Nkayeesha inyipo yulhupalhe yo uhelhiya maashi o ukhucha, variyari Nihema Nitakatifu, nkayaachariha maashi. <verse eid="EXO 40:30" /><verse number="31" style="v" sid="EXO 40:31" />Ashinna Musa, Naharuni, ni achishaana a Naharuni, onkhaye ahokhucha miono ni mieto chaya ni yayo maashi ayo. <verse eid="EXO 40:31" /><verse number="32" style="v" sid="EXO 40:32" />Ni kila vaakenlhe aya Nihema Nitakatifu, ni vaatameria aya madhubahu, ashinna Musa, Naharuni ni achishaana aya, ahokhuchacha thoko Apwiiya Nlhuku chenre aya wo waalhehera ashinna Musa. <verse eid="EXO 40:32" /><verse number="33" style="v" sid="EXO 40:33" />Wo umalhihera, ashinna Musa ni nlhoko aya, ahotheka ntenje urukureria Nihema Nitakatifu nno ni madhubahu. Nkayeesha ni nipaziya vanlhakoni wo ntenje nno. Paahi etu ashinna Musa vamoka ni attu ayo nkayaamalhiha ntheko wonkhaye.<verse eid="EXO 40:33" /></para>
  <para style="s1">Nihute vachulhu Nihema Nitakatifu</para>
  <para style="r">(<ref loc="NUM 9:15-23">Waal 9:15-23</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 40:34" />Yamalhekeru, nihute nne nkanaakhunelha Nihema Nitakatifu, ni nthimicho wa Apwiiya Nlhuku nkawaaria Nnihemani mmo. <verse eid="EXO 40:34" /><verse number="35" style="v" sid="EXO 40:35" />Ukhalhawaya nthimicho uyo waari wo waaria chinene, ashinna Musa khayonrie ukelha Nihema Nitakatifu. <verse eid="EXO 40:35" /><verse number="36" style="v" sid="EXO 40:36" />Paahi ukhuma nenno nihuku nno, Aisraeli khayaathamme wiira eete nkwaha, yaahikhalhe nihute nne veenulhiye aya uthama vachulhu Nihema Nitakatifu nne. <verse eid="EXO 40:36" /><verse number="37" style="v" sid="EXO 40:37" />Yakhalhaka nihute nne naari ninakhanlhe vachulhu Nihema Nitakatifu, khayaathamme, mpaka veenulhiye aya uchulhu. <verse eid="EXO 40:37" /><verse number="38" style="v" sid="EXO 40:38" />Kila vaari aya munkwahani, Aisraeli ahooria woona nihute na Apwiiya Nlhuku nne vachulhu Nihema Nitakatifu, uthana, ni uhiyu ahoona mooro ulhe upharelhaka nnihuteni mmo vachulhu Nihema Nitakatifu vawo.<verse eid="EXO 40:38" /></para>
  <chapter eid="EXO 40" />
</usx>