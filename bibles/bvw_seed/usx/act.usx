<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ACT" style="id" />
  <para style="h">ACTS</para>
  <para style="toc3">Tf</para>
  <para style="toc1">TORCHƏKƏNA FATHLƏNCHA</para>
  <para style="toc2">Torchəkəna Fathləncha</para>
  <para style="toc1">Torchəkəna Fathləncha</para>
  <para style="mt1">TORCHƏKƏNA FATHLƏNCHA</para>
  <chapter number="1" style="c" sid="ACT 1" />
  <para style="s">Ɗǝfshuwun Ɓata Shemeɗ Chiɗchiɗ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1" />Hur tǝrka ɗelwer engna, le yarutisi sokǝn Tiyofalus, yaraɗi ichihi nat tǝrkaatǝ Yǝso sǝta tǝ fichile tǝrkaatǝn sakandaɗi, <verse eid="ACT 1:1" /><verse number="2" style="v" sid="ACT 1:2" />kǝ fari tǝrtǝ fichinda afshi, ɗifitǝ fǝra kussa fathlǝnchi'en taɗtǝnhar tǝmbǝɗa Shemeɗ Chiɗchiɗ. <verse eid="ACT 1:2" /><verse number="3" style="v" sid="ACT 1:3" />Hur mundǝ kumchit fwaɗa, ɗifitǝ ɓahtǝ'enhi tǝ mǝrtǝ'en, kurɓaɗǝ cheɗa fat'enna kanda a mbachǝ somsomǝn ndatwa tǝkit a thlee tǝ shisshingtafa, paɗ mbwa'aɗǝ pathlǝ mwanda Fara kanda. <verse eid="ACT 1:3" /><verse number="4" style="v" sid="ACT 1:4" />Naɗi natǝn tǝ kandǝyu, ndangna kandǝwa: "Mǝ malindǝ Urshelima hiwa, kǝ pundǝ kǝ nǝhhǝɗ ɗǝfshuni ɗǝftǝ shinkǝn hiiyu, nda i mbwa'andǝna kanda, <verse eid="ACT 1:4" /><verse number="5" style="v" sid="ACT 1:5" />Kǝthlǝm Yohanna sǝkǝn baptisma tǝ ama, a hanmunchǝ ɗimek nakficha sa baptisma kuni tǝ Shemeɗ Chiɗchiɗ."<verse eid="ACT 1:5" /></para>
  <para style="s">Tǝra Fichǝ Almasihu Kǝ Afshi</para>
  <para style="r">(<ref loc="MRK 16:19-20">Mk 16:19-20</ref>; <ref loc="LUK 24:50-53">Lk 24:50-53</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6" />Kǝnat Yǝso humtǝhi tǝ fathlǝncha, sahangndǝwa: "Lǝmwanda, nakǝnya natu ngǝr fǝra kuturichit'ena Israila ɗǝwa?" <verse eid="ACT 1:6" /><verse number="7" style="v" sid="ACT 1:7" />Ndangna kandǝwa: "Nga innuni kǝ sǝnuni thlet hanmunchǝ tǝ hanthlǝkchǝkǝnwa, papa ndak nak tǝ alchitkǝn. <verse eid="ACT 1:7" /><verse number="8" style="v" sid="ACT 1:8" />Nuni mbǝs alchita ma ɓeɗ Shemeɗ kǝ ɗar inchengnuni. Nakuni nat kǝ shetachengna, kǝ nuni mbwa'a pathlengna nofcha a hur Urshelima tǝ hachahai Yahudiya nat tǝ Samariya tǝ sǝrǝt kishitǝ nat." <verse eid="ACT 1:8" /><verse number="9" style="v" sid="ACT 1:9" />Kǝ mbuutǝn kichu, kanda ɗar kǝlanda, tǝrangficha afshi kǝ hur husomba'a, ɓakna shekata hwanichengnanda mwa'unda ngǝr nanndǝwa. <verse eid="ACT 1:9" /><verse number="10" style="v" sid="ACT 1:10" />Kanda ɗar kǝlata afshi, mǝlan paɗ mǝla pǝɗata, ɓak nofchi chappa thlara thlǝmatnanda, tǝ njelechǝ heɗǝɗa. <verse eid="ACT 1:10" /><verse number="11" style="v" sid="ACT 1:11" />Ndangnda kandǝwa: "Hishcha Galilicha, kǝthlǝmmǝ natuni kikit kǝnuni kǝlata afshi? Yǝso ti tǝrrandǝ ficha hurnuni kǝ afshiya, farǝyuna nan ngǝr ɓata nda i natuni pǝɗat'ena hur afshi."<verse eid="ACT 1:11" /></para>
  <para style="s">Teɗ Fichǝ Matiyas kǝ Ngǝrka Kwar Mwanda Yahuda</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12" />Thlaakǝnda malkǝndǝ shohla Zaitunhi ngǝrangndǝ'ina Urshelima nakǝn nga langngǝwa, witǝ nduk ka mel ǝrta. <verse eid="ACT 1:12" /><verse number="13" style="v" sid="ACT 1:13" />Kǝ nannda sata hǝmǝtkǝn, tǝrkǝnda huri afshi kǝ mbǝɗi nanndǝ ɗǝndas. nda: Bitrus, Yohanna, Yakubu, Andarawus, Filibus, Toma, Bartalamawus tǝ Matiyu, Yakubu hweya Halfa tǝ Saminu lǝ mbat thlǝt inda punofcha ɗi tǝ Yahuza hweya Yakubu. <verse eid="ACT 1:13" /><verse number="14" style="v" sid="ACT 1:14" />Humkǝndǝhi natyu tǝ yarǝ ǝrta, naknda nata hwandǝ kǝnding, tǝ Maryamu man Yǝso tǝ nischǝ terchin tǝ hwanmanchǝ Yǝso. <verse eid="ACT 1:14" /><verse number="15" style="v" sid="ACT 1:15" />A hanmunchiniyu, ngomkǝ fafǝrkithi aru tǝ kumchitchap kǝ mbǝt ǝrta, thlaakǝ Bitrus kit a hurnanda, ndakǝnwa: <verse eid="ACT 1:15" /><verse number="16" style="v" sid="ACT 1:16" />"Hwanmanchina, sokkǝn waat kǝ nǝhɗangfichi ihi mbuutǝ shunda Farǝ soh tǝ mbǝɗa Shemeɗ Chiɗchiɗ ɓak tǝ miya Dauda kǝ ɗar Yahuda le hǝmka mbanna hur fichile kǝsang Yǝso. <verse eid="ACT 1:16" /><verse number="17" style="v" sid="ACT 1:17" />Kǝthlǝm nakna hurnǝm soh, paɗ fǝra fichi i natna sǝta hur toriya. <verse eid="ACT 1:17" /><verse number="18" style="v" sid="ACT 1:18" />(Yahuda, tǝkǝni ɓǝɓi tor'en hiitǝn mbǝtsi, hǝmkǝnhi tǝ inda, ɗathlkǝ hur'en ɓak hanheɗechi'ena haiya. <verse eid="ACT 1:18" /><verse number="19" style="v" sid="ACT 1:19" />Kusheng shiwun mǝrta Yahuda sǝkkǝ nofcha Urshelima nat, ak fichi mbǝtkǝnwa Akaldama tǝ miyengnanda, sakǝtkǝnwa mbǝt fwara.) <verse eid="ACT 1:19" /><verse number="20" style="v" sid="ACT 1:20" />Ɗǝk Bitrussa mban tǝ ndatwa:</para>
  <para style="q1" vid="ACT 1:20">Nakna hur yaratkǝn kichuyu a hur Zabura, ndatwa:</para>
  <para style="q1" vid="ACT 1:20">"Nak huraa'ena nata kǝtǝn kuffi,</para>
  <para style="q2" vid="ACT 1:20">mǝ soki nifa hurkǝnwa:</para>
  <para style="q1" vid="ACT 1:20">paɗ mbǝt soktǝ'en a hur torkǝn kǝ tǝr yuna." <verse eid="ACT 1:20" /><verse number="21" style="v" sid="ACT 1:21" />Kǝthlǝm ndǝkǝn sokkǝn waat kǝ taɗim yunihara a hur nofchi natǝm tǝ kandǝ nat farǝ natma witǝ tǝ Lǝmwandǝ Yǝso yu. <verse eid="ACT 1:21" /><verse number="22" style="v" sid="ACT 1:22" />Thlata fari sandǝ Yohanna baptisma kǝ fari tǝrtǝndǝndi a hurnǝm kǝ afshi. Chikawun tǝrtǝ ficha, nan sokta sheta tǝkǝm kǝ ɗar thlata Yǝso a hur mǝmatcha. <verse eid="ACT 1:22" /><verse number="23" style="v" sid="ACT 1:23" />Harkǝndǝ nofchi chap: Yusufu lela atfichǝwa Barsabas, lela atndǝ paɗwa Yustus tǝ Matiyas. <verse eid="ACT 1:23" /><verse number="24" style="v" sid="ACT 1:24" />Hwankǝnda tǝ ndatwa: "Ai Lǝmwanda, lǝ sǝn hanndǝkiketa chika wuni, cheɗɗu le taɗtuhara hur nofchi chapya. <verse eid="ACT 1:24" /><verse number="25" style="v" sid="ACT 1:25" />Kǝ sokka lǝ thlǝnda hur torkǝn, kǝ tǝrǝn mbǝtsokta Yahuda le lengkǝhi pǝɗaka mbǝɗi ɓatǝn yu. <verse eid="ACT 1:25" /><verse number="26" style="v" sid="ACT 1:26" />'Yimkǝnda tata, sǝmkǝ Matiyas ɗǝfkǝfichinda hur fathlǝncha, humang fichi tǝ fichile kumngǝrǝnsǝ ertǝyu.<verse eid="ACT 1:26" /></para>
  <chapter eid="ACT 1" />
  <chapter number="2" style="c" sid="ACT 2" />
  <para style="s">Ɓata Shemeɗ Chiɗchiɗ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1" />Kǝ saatǝ farǝ pentekos, uf fa fǝrkit hwimndǝhi mbǝt ǝrta. <verse eid="ACT 2:1" /><verse number="2" style="v" sid="ACT 2:2" />Sutolluwa, sǝkkǝ fichi tit ǝna hur afshi nda kapat rǝnna'a nǝhɗaɗǝ huri'i nannda hurkǝn ɗǝɗas. <verse eid="ACT 2:2" /><verse number="3" style="v" sid="ACT 2:3" />Cheɗkǝ ichi fechengnanda nda hanshuwun hwata, kanda saktǝhi, kanda ɗǝta ɗar inchengnanda. <verse eid="ACT 2:3" /><verse number="4" style="v" sid="ACT 2:4" />Nǝhɗang fichi kandǝ nat tǝ Shemeɗ Chiɗchiɗ, tǝrkaakǝndǝ shundǝ tǝ michǝ somsomǝn, ɗa i fǝrandǝ Shemeɗ shunda kanda. <verse eid="ACT 2:4" /><verse number="5" style="v" sid="ACT 2:5" />A thlahmbǝchiniyu, Yahudawechisi fa mwanandǝ Farǝ kaǝn, ɓaka a hachahaichǝ somsomǝn a hur kishita nak tǝ sokta a Urshelima. <verse eid="ACT 2:5" /><verse number="6" style="v" sid="ACT 2:6" />Kǝ sǝktǝndǝ iniyu, humkǝndǝhi ngomkǝnda mbǝt ǝrta kǝthlǝm a kwehǝr sokkǝnaɗi, chikawun mǝla sǝktǝ kanda shundǝ tǝ miyengnanda. <verse eid="ACT 2:6" /><verse number="7" style="v" sid="ACT 2:7" />Pǝɗang ǝn kandǝfa paɗ shekɗang'indǝ kanda, ndakndǝwa: "Awi fa shuni natya nga Galilawechiwowa?" <verse eid="ACT 2:7" /><verse number="8" style="v" sid="ACT 2:8" />Sǝk ǝnikǝni natma sǝk kanda shundǝ tǝ miya chikawuni? <verse eid="ACT 2:8" /><verse number="9" style="v" sid="ACT 2:9" />kǝmnangya, Fartiyawecha tǝ Madiyawecha, tǝ Elamawecha tǝ nofcha hachahai Mesofotamiya tǝ Yahudiya tǝ Kafadokiya tǝ i Fantus tǝ Asiya, <verse eid="ACT 2:9" /><verse number="10" style="v" sid="ACT 2:10" />tǝ Firijiya tǝ Bamfiliya tǝ Masar tǝ fichile nak nduknduk tǝ Sayirin a hachahai Libiya tǝ romchi ɓaka Roma. Yahudawecha tǝ fichile yimka tǝrmbandengnǝm. <verse eid="ACT 2:10" /><verse number="11" style="v" sid="ACT 2:11" />Paɗ kǝmnang Kiritawecha tǝ Larabawecha, nat kǝmna sǝk kanda shundǝ tǝ miyengnǝm kǝ ɗar pǝktat ichi sǝt Fara." <verse eid="ACT 2:11" /><verse number="12" style="v" sid="ACT 2:12" />Pǝɗang ǝn kandǝfǝ natnda kohǝrkǝ inchengnandaɗi, ɗakndǝwa: "Mǝnaka sakǝt iya?" <verse eid="ACT 2:12" /><verse number="13" style="v" sid="ACT 2:13" />Chang funǝ mi kandǝhi ndatwa: "Tǝ sandǝ am inabi ngalkǝndǝ ɓeng."<verse eid="ACT 2:13" /></para>
  <para style="s">Ɓassa Bitrus A Farǝ Pentekos</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14" />Thlaakǝ Bitrus kit tǝ tahǝt fathlǝnchi kumngǝrǝnsǝ'ǝrtǝyu, i'naǝn ɓurathi ɓassangna kandǝsi, ndakǝnwa: "Hwanmanchina Yahudawecha tǝ fichile naktǝ sokta Urshelima nat sǝkamnji, paɗ kǝ ɗǝffuni i'nda i nati mbwa'anda kuni. <verse eid="ACT 2:14" /><verse number="15" style="v" sid="ACT 2:15" />Nofchiya nga tǝ tǝrang ǝna kandǝ nda i tǝrtuniwa, nakǝn mwee mbǝta ɓingtǝyawa: hanthlikkǝn hanhertǝ ndak. <verse eid="ACT 2:15" /><verse number="16" style="v" sid="ACT 2:16" />I natuniya ndǝkǝn mbutǝ tapǝnaa Yowel ndatwa: <verse eid="ACT 2:16" /><verse number="17" style="v" sid="ACT 2:17" />"'Ndak Farǝ wa,</para>
  <para style="q1" vid="ACT 2:17">a mweshit hanmunchikǝn ni thlǝr Shemeɗengna ɗar inda nofchi nat.</para>
  <para style="q2" vid="ACT 2:17">Hwechengnuni kǝ nishchi tǝ hishcha nanda mbu icha le mbwa'andǝ Fara kanda.</para>
  <para style="q1" vid="ACT 2:17">Kimshechengnuni nanda nat'ichi tamuchitnda nata,</para>
  <para style="q2" vid="ACT 2:17">tuɓurnofchengnuni nanda sǝnnata. <verse eid="ACT 2:17" /><verse number="18" style="v" sid="ACT 2:18" />A hanmunchiniyu ni thlǝr shemeɗengna kǝ ɗar inda mafechengna hishchi tǝ nishchi nat,</para>
  <para style="q1" vid="ACT 2:18">paɗ nanda mbu icha le mbwa'andǝ Fara kanda.<verse eid="ACT 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ACT 2:19" />Ni che ǝnat pǝɗandǝ nifǝfa a hur afshi,</para>
  <para style="q2" vid="ACT 2:19">tǝ i na che sakǝt ǝnat pǝɗandǝ nofchǝfa a kishita,</para>
  <para style="q1" vid="ACT 2:19">naknanat fwara tǝ hwata tǝ ǝnnda husomba'a. <verse eid="ACT 2:19" /><verse number="20" style="v" sid="ACT 2:20" />Hwatfarǝ nan yimta hulta,</para>
  <para style="q2" vid="ACT 2:20">ndǝra'a nan tǝɓǝrtǝhi ngah nda fwara,</para>
  <para style="q1" vid="ACT 2:20">kana fari Lǝmwandiyu ɓata,</para>
  <para style="q2" vid="ACT 2:20">kapat fari nak mwanchin. <verse eid="ACT 2:20" /><verse number="21" style="v" sid="ACT 2:21" />Farini hachiyu,</para>
  <para style="q1" vid="ACT 2:21">chikawun hwanka hur thlǝm Lǝmwanda nan hǝrǝkta. <verse eid="ACT 2:21" /><verse number="22" style="v" sid="ACT 2:22" />Hwanmanchina, Israilawecha, sǝkam shuniya. Yǝso lǝ Nazaratta, nifi cheɗandǝ Fara kuni tǝ pǝktat torcha tǝ ǝnat pǝɗandǝ nifǝfa tǝ che ichi somsomǝn a hurnuni tǝ mbǝɗ'en, nda i sǝntuni tǝ indengnuni. <verse eid="ACT 2:22" /><verse number="23" style="v" sid="ACT 2:23" />Yǝso tiya, fǝrkǝ fichindi tepi tehishhi paɗ tǝ sǝnda Fara, kunang kukwang kǝ ɓǝllangnda tǝ mbǝɗa ɓǝɓi nofcha. <verse eid="ACT 2:23" /><verse number="24" style="v" sid="ACT 2:24" />Ɓak Fara thla'anda ɗifitǝ ɓohandǝ hanmurtǝɗa i'ndi'en, kǝthlǝm ngu sǝtta hanmurta kǝ kǝsǝnndǝharwa. <verse eid="ACT 2:24" /><verse number="25" style="v" sid="ACT 2:25" />Dauda kutura mbwitǝ ǝn kǝɗarkǝn ndatwa: "A neɗi Lǝmwandǝ mǝla thlǝmmatnǝ kǝnding. Ngi hǝhǝrtǝfuwa, kǝthlǝm mǝla harsǝmtengna. <verse eid="ACT 2:25" /><verse number="26" style="v" sid="ACT 2:26" />Kǝthlǝm ndǝkǝn, hanndǝkiketengna sǝk mbǝndǝfa, hanshundengna in immish mbǝnfata. Tǝ paɗ thlarkǝ faɗengna ɗar ɗǝf'inda mbǝɗa Fara. <verse eid="ACT 2:26" /><verse number="27" style="v" sid="ACT 2:27" />Kǝthlǝm nguna malǝ faɗengna hur mǝmatchiwa, ndu kǝ mallangnǝ iuti nak Chiɗchiɗ kǝ yirakaɗa kwatwa. <verse eid="ACT 2:27" /><verse number="28" style="v" sid="ACT 2:28" />Cheɗinǝ mba shisshingta. Nu nǝhɗitǝ tǝ mbǝnfata naku tǝnji kǝnding. <verse eid="ACT 2:28" /><verse number="29" style="v" sid="ACT 2:29" />"Hwanamanchina, ni mbǝlla mbwa'anda kuni tǝ kitchitwa kakannǝm Dauda, ndatwa miri a thlohaficha, kwat'en mwakǝna thlǝmmatnǝm kǝ ɓukweya. <verse eid="ACT 2:29" /><verse number="30" style="v" sid="ACT 2:30" />Nakǝn kǝ tapǝnaa, paɗ a shinwa ɗǝffa Farǝ shundǝhi tǝ at'ichimi ndatwa kachit Dauda na sokta mbǝt sok kuturichit'en. <verse eid="ACT 2:30" /><verse number="31" style="v" sid="ACT 2:31" />Ɓak Dauda nathi kichuyu, paɗ a shuwun kǝ ɗar thlata Almasihu a hur mǝmatcha. Nakna ndatwa Farǝ ngu malǝnda hur mǝmatchuwa ndu kǝmalǝn fat'en kǝ yirakaɗa kwatwa. <verse eid="ACT 2:31" /><verse number="32" style="v" sid="ACT 2:32" />Thlaa Farǝ Yǝso a hur mǝmatcha, kanang natani shetachǝ nakani. <verse eid="ACT 2:32" /><verse number="33" style="v" sid="ACT 2:33" />Nakǝn mwanaficha nakna harsǝmta Fara, Paɗ shinkǝn nda i ɗǝftǝn shundǝhi, fǝraǝn Shemeɗ Chiɗchiɗ kǝ thlǝrka ɗar inchengnǝm nda i sǝktuni paɗ natuni ɓukweya. <verse eid="ACT 2:33" /><verse number="34" style="v" sid="ACT 2:34" />Nga Dauda tǝrka hur afshiwa, chika mǝlan ndakǝnwa:</para>
  <para style="b" vid="ACT 2:34" />
  <para style="q1" vid="ACT 2:34">"Lǝmwandǝ ndangnga Lǝmwandengnǝwa, soku harsǝmtengna,<verse eid="ACT 2:34" /></para>
  <para style="q2">
    <verse number="35" style="v" sid="ACT 2:35" />Kani ɗǝf atikrechiwa ishangnǝkanda ka sarǝcheku." <verse eid="ACT 2:35" /><verse number="36" style="v" sid="ACT 2:36" />"Kǝthlǝmndǝkǝn chikawuna hur Isra'ila kǝsǝnǝn tǝkitwa Yǝso ti kukwandunihiyu, ngǝra Fara Lǝmwanda tǝ Almasihu." <verse eid="ACT 2:36" /><verse number="37" style="v" sid="ACT 2:37" />Kǝ sǝktǝndǝ shuniniyu, thlǝhǝrkǝn kanda hanɗǝkiketa, ndangnda Bitrus tǝ tahǝt fathlǝnchikǝnwa: "Hwanmancha, mǝnatani sǝta?" <verse eid="ACT 2:37" /><verse number="38" style="v" sid="ACT 2:38" />Ndǝkǝn ndandǝ Bitrussa kandǝwa: "Kǝ tǝrunihi kǝ sangfichǝ baptisma kuni a hur thlǝm Yǝso kǝrǝsti kǝthlǝm kǝ kallangfichi ɓǝɓichitfechengnuni kunihi, kanuni thlǝt Shemeɗ Chiɗchiɗ. <verse eid="ACT 2:38" /><verse number="39" style="v" sid="ACT 2:39" />Kǝthlǝm ɗǝfshunihiya innuni tǝ hwechengnuni, tǝ fichile nak langngǝ paɗ, chikawun at Lǝmwanda, Farengnǝm." <verse eid="ACT 2:39" /><verse number="40" style="v" sid="ACT 2:40" />Ɗǝk Bitrussa mban tǝ ɓassanda kandǝ kǝ tolta, nakna ndanda kandǝwa: "Hǝrkamǝn fechengnuni hura sǝɓ kishi'iya." <verse eid="ACT 2:40" /><verse number="41" style="v" sid="ACT 2:41" />Fichile fǝrkǝkit kǝ ɗar shunda Bitrus, sangfichǝ baptisma kanda. A farǝniyu chekkǝ nofchǝ kǝ ɗar fafǝrkit nduk aru kumchit mǝkkan. <verse eid="ACT 2:41" /><verse number="42" style="v" sid="ACT 2:42" />Ɓaknda ɗǝf inchengnanda sakini fathlǝnchiyu, lǝ humkǝndǝhi kǝnnda chi johma, paɗ kǝnnda hwanda.<verse eid="ACT 2:42" /></para>
  <para style="s">Witǝ Soki Nat fa Tǝrmbanda Hurkǝn</para>
  <para style="p">
    <verse number="43" style="v" sid="ACT 2:43" />Kǝsang lechit chikawuni, sǝk fathlǝnchikǝn ǝnat pǝɗandǝ nofchifǝ tǝ sakchikǝn kaǝn. <verse eid="ACT 2:43" /><verse number="44" style="v" sid="ACT 2:44" />Nat fafǝrkit kanda mbǝt'ǝrta, chikamengnanda paɗ ǝrta. <verse eid="ACT 2:44" /><verse number="45" style="v" sid="ACT 2:45" />Hi'yangndǝ ichiɗǝ naksengnandǝ nat, sakangndǝ handǝɓǝlkǝna chikawuni, nda i yahtǝn. <verse eid="ACT 2:45" /><verse number="46" style="v" sid="ACT 2:46" />I sǝkka wembǝta kanda ɗǝta kapat hura'a Farǝ tǝ ndani rǝmma, kǝnnda chi njohma a hurechengnanda, kǝnnda sǝm'ǝna mbǝt ǝrta tǝ mbǝndǝfa tǝ hanɗǝkiketǝ yuyur. <verse eid="ACT 2:46" /><verse number="47" style="v" sid="ACT 2:47" />Kanda mwanandǝ Fara, nangnda mbǝs hamta mbǝɗa nofchinat. I sǝka wembǝta Lǝmwanda cheka fichile hǝrkandǝfich kanda.<verse eid="ACT 2:47" /></para>
  <chapter eid="ACT 2" />
  <chapter number="3" style="c" sid="ACT 3" />
  <para style="s">Kǝna Fichi Tǝraɗɗaɗi Mikǝttǝn Hwanda</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1" />Farǝle nda Bitrus tǝ Yohanna pǝɗata kapat hura'a Fara ka hwanda a farǝhuftǝ, hanthlǝkkǝn mǝkkan. <verse eid="ACT 3:1" /><verse number="2" style="v" sid="ACT 3:2" />Bakndǝ tǝ nifǝ le ngǝttǝ fichǝ kǝ tǝraɗ kǝnding la ɓaknda ɗǝfndǝhi nduk kǝ mi ɓang kapat hura'a Fara lela atndǝwa chamare tǝ mimbangnga, kǝthlǝm kǝ hwanǝn fǝr poffǝnna harra fa yimta kapat hura'a Fara. <verse eid="ACT 3:2" /><verse number="3" style="v" sid="ACT 3:3" />Kǝnatǝn nda Bitrus tǝ Yohanna yimta kapat hura'a Fara, hwanaǝn fǝr poffǝn kanda <verse eid="ACT 3:3" /><verse number="4" style="v" sid="ACT 3:4" />Nda Bitrus tǝ Yohanna nak nda kǝllanda, ndak Bitrus wa: "Kǝllan kani." <verse eid="ACT 3:4" /><verse number="5" style="v" sid="ACT 3:5" />Ngǝrkǝ hur'indǝ'en nat kǝfaɗengnanda, naǝnhiwa nan mbǝs'ǝna harengnanda. <verse eid="ACT 3:5" /><verse number="6" style="v" sid="ACT 3:6" />Ndak Bitrus wa: "Hanɗǝɓǝltengnǝsǝwa, i'naksengna ndǝkǝn nati fǝrruta. A hur thlǝm Yǝso Almasihu Lǝnazartta, thla'u wi'iu." <verse eid="ACT 3:6" /><verse number="7" style="v" sid="ACT 3:7" />Kǝskǝ Bitrus harsǝmtǝ'en thla'a'ǝn. Chatkichuyu sarrǝchi'en tǝ sanglamchi'en sǝkndǝ alchita. <verse eid="ACT 3:7" /><verse number="8" style="v" sid="ACT 3:8" />Thlaakǝn pǝrkǝna afshi thlarkǝnhi tǝrkaakǝn wita, yimkǝna kapat hura'a Farǝ tǝ kanda, mǝla wita mǝla pǝrta afshi, mǝla mwanandǝ Fara. <verse eid="ACT 3:8" /><verse number="9" style="v" sid="ACT 3:9" />Nat nofcha nakndǝndi mǝla wita mǝla mwanandǝ Fara. <verse eid="ACT 3:9" /><verse number="10" style="v" sid="ACT 3:10" />Mbǝssangndǝwa mǝlanni lǝ sokka a chamare tǝ mimbang kapat hura'a Fara kǝnna hwafǝrpoffǝnyu. Pǝɗang ǝn kandǝfǝ kǝ ɗar i'ndi'en.<verse eid="ACT 3:10" /></para>
  <para style="s">Ɓassa Bitrus a Kǝttǝn Para Sulemanu</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11" />Kǝskǝn Bitrus tǝ Yohanna har, ngomkǝ nofchǝ nat kǝ thlǝmatnandǝ tǝ rahta a hur kǝttǝn para Sulemanu, kǝthlǝm a pǝɗa'ǝnkandǝfa paɗ kwehǝr hur'inchennandaɗi. <verse eid="ACT 3:11" /><verse number="12" style="v" sid="ACT 3:12" />Kǝnat Bitrus kichu, kahaan hur'inda nofchǝ tǝ ndatwa: "Israilawecha, mǝsǝk pǝɗandǝ'ǝnkunifǝ kǝ ɗar iya? Kǝthlǝmmǝ natuni kǝlandǝ kani nda tǝ alchiɗ'indengnani wiitǝ nifiya ndu kuwur Farengnani sǝk wiitǝ nifiiya? <verse eid="ACT 3:12" /><verse number="13" style="v" sid="ACT 3:13" />Fara Ibrahim tǝ Ishaku tǝ Yakubu, Fara kakechinǝm nat, mǝlan mwanang mafat'en Yǝso, le chertuni paɗ fǝrtunindi a mbanitǝ Bilatus yu, chikama sokkǝnwa tirwa nan kalǝndǝhi. <verse eid="ACT 3:13" /><verse number="14" style="v" sid="ACT 3:14" />Cherkuni le nak chiɗchiɗ lǝ kafata, hwankuni kǝ kallangfichi lǝ ɓǝlfata kunihi. <verse eid="ACT 3:14" /><verse number="15" style="v" sid="ACT 3:15" />Ɓǝlangnguni le nak tǝ mba shisshingta har, thla'ang Fara hur mǝmatcha, kanang shetacha ɗar kitchitkǝn. <verse eid="ACT 3:15" /><verse number="16" style="v" sid="ACT 3:16" />"Tǝ mbǝɗa fǝrkit hur thlǝm Yǝso, kǝntǝ nifiɗiya, sǝntuni sohwa tǝraɗ. Kittǝkǝn fǝrkitchiɗi tǝmbǝɗa thlǝm Yǝso kǝnang nifiɗiya a hwanitengnuni nat. <verse eid="ACT 3:16" /><verse number="17" style="v" sid="ACT 3:17" />Nakǝnya hwanmancha, mbǝssaɗiwa i sanduni Yǝso sǝkuni hur ɓahsǝnda, nda i sǝt fa hǝmɓanichengnuni. <verse eid="ACT 3:17" /><verse number="18" style="v" sid="ACT 3:18" />Tǝkichu nǝhɗandǝ Farǝ ɗǝfshundǝ'enhi tǝ miya tapǝnechǝ nat, ndatwa Kǝrǝsti nan sat ɓahta. <verse eid="ACT 3:18" /><verse number="19" style="v" sid="ACT 3:19" />Kǝthlǝm ndǝkǝn kǝ tǝrunihi kǝ tǝɓrunihi ɓǝɗa Fara, kǝthlǝm kǝ sapang fichǝ ɓǝɓichitfechengnuni ɗi, Lǝmwanda nannata cheka alchit hanɗǝkiketa kuni. <verse eid="ACT 3:19" /><verse number="20" style="v" sid="ACT 3:20" />Paɗ nan thlǝn Kǝrǝsti ti taɗandǝnakunisi soh, mǝlan naka Yǝso. <verse eid="ACT 3:20" /><verse number="21" style="v" sid="ACT 3:21" />Waat kǝ sokka hur afshi kǝ fari natficha mbumbweɗandǝ ichihi nat kǝ yuwachikǝn, nda i ɗǝftǝ Farǝ shiwunkǝnhi kǝsoh tǝ mbǝɗa tapǝnechi'en chiɗchiɗ. <verse eid="ACT 3:21" /><verse number="22" style="v" sid="ACT 3:22" />Ndak Musawa: "Farǝ Lǝmwanda nan thla'a tapǝna'a kunisi a hur nofchengnuni, nda i thla'itǝn. Waat kǝ ɗǝffuni inda i nat mbwa'andǝna kuni nat." <verse eid="ACT 3:22" /><verse number="23" style="v" sid="ACT 3:23" />Nakna sokta chikawun kawuchik thlǝmmata tapǝni'iniyu na ficha sǝɓandaɗa hur nofcha. <verse eid="ACT 3:23" /><verse number="24" style="v" sid="ACT 3:24" />Tapǝnechi mbukǝ ichi nat, thlata Samaila ka kǝs fichilesi ɓaka ɗifi, mbwindǝ ichi naka sǝt nat a hanmunchi nakǝnya. <verse eid="ACT 3:24" /><verse number="25" style="v" sid="ACT 3:25" />Kunang naka hwecha tapǝnechiniyu paɗ kuna hur ɗǝf shunini ɗǝfandǝ Fara kakechǝnǝmhiyu. Kǝthlǝm ndang Fara Ibrahim wa: "Tǝ mbǝɗa kachitwa na nofcha kishita natta mbǝs ǝnhar. <verse eid="ACT 3:25" /><verse number="26" style="v" sid="ACT 3:26" />Kǝ thla'andǝ Farǝ mafat'en Yǝso, tǝrkaakǝn thlǝnndi kǝ mbǝɗengnuni Israilawecha, kǝthlǝm kǝ fǝraǝn mbǝs ǝnhara kuni tǝ mbǝɗa tǝɓrandǝ chikawuna hurnuni kǝ malaǝn ɓǝɓi ɗǝsǝchi'en."<verse eid="ACT 3:26" /></para>
  <chapter eid="ACT 3" />
  <chapter number="4" style="c" sid="ACT 4" />
  <para style="s">Bitrus tǝ Yohanna Mbanitǝ fa Yarandǝ Ichihi</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1" />Pǝrischa tǝ la hǝmmbanita fa pu kappat hura'a Farǝ har tǝ Sadukiyawecha, ɓaknda mbǝsnda Bitrus tǝ Yohanna kanda hur shunandǝ nofcha. <verse eid="ACT 4:1" /><verse number="2" style="v" sid="ACT 4:2" />Shiɓhurchengnandaɗi kǝthlǝm kanda sakanda nofchihar tǝ sǝnanda kandǝsǝwa mǝmatcha nanda thlatǝ tǝ shisshingchafa nda i thlaatǝ Yǝso. <verse eid="ACT 4:2" /><verse number="3" style="v" sid="ACT 4:3" />Kǝsangndǝ kanda, ɗǝkndǝ tǝ kanda kǝttǝn pursuna kǝ ishki, nakǝn tepa shiɗ farǝhufta. <verse eid="ACT 4:3" /><verse number="4" style="v" sid="ACT 4:4" />Yakat fichile sǝkkǝ ɓassikǝn, fǝrkǝndǝkitsi. Nofchi fǝrkǝkittǝkǝn sheendǝ aru kumchitɗurman. <verse eid="ACT 4:4" /><verse number="5" style="v" sid="ACT 4:5" />Ɓingǝtkǝn, fa yarandǝ ichihi a kuturchitkǝn uf tǝ fa hǝmmbanita tǝ malɗǝmcha fa sakandǝ kussaɗi, ngomkǝndǝhi a Urshelima. <verse eid="ACT 4:5" /><verse number="6" style="v" sid="ACT 4:6" />Tǝ Hanana kapat pǝrist tǝ Kayafa tǝ Yohanna tǝ Alekzanda, nat ta fichile naka hur ngitikta kapat pǝrist. <verse eid="ACT 4:6" /><verse number="7" style="v" sid="ACT 4:7" />Ɓakndǝ tǝ Bitrus tǝ Yohanna, thlarangndǝ kandǝhi kǝ hur ɗiffi, sahangndǝ kandǝwa: "Tǝ alchitmi ndu tǝ thlǝm wuni sǝtuni ichiya?" <verse eid="ACT 4:7" /><verse number="8" style="v" sid="ACT 4:8" />Bitrus, nǝhǝɗkaɗǝ tǝ Shemeɗ Chiɗchiɗ, ndangnakandǝwa: "Kuturcha tǝ pǝktat nofcha, <verse eid="ACT 4:8" /><verse number="9" style="v" sid="ACT 4:9" />Sahangnguni mi kani ɓukweya kǝthlǝm kachiɗi sandani tǝraɗtiyawa tǝ mbayi kǝntǝna ɗiyawa? <verse eid="ACT 4:9" /><verse number="10" style="v" sid="ACT 4:10" />Yahkisi kǝ sǝnuni nattuni tǝ Israilawecha, ndatwa tǝ thlǝm Yǝso Almasihu Lǝnazaratta, le kukwandunihi thla'andǝ Fara hur mǝmatcha, kǝntǝ nifiɗi ngwalngwal kita mbanitǝnuniya. <verse eid="ACT 4:10" /><verse number="11" style="v" sid="ACT 4:11" />Mǝlan naka:</para>
  <para style="q1" vid="ACT 4:11">"Ngwiyi chertuni kunang fa tincha,</para>
  <para style="q2" vid="ACT 4:11">ndǝkǝn sokka kukuwun tinda."<verse eid="ACT 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ACT 4:12" />Nifǝsi na mbǝssa kaɓi nifǝ chika ǝrtǝwa, kǝthlǝm thlǝmsa hur kishi'inatya fǝrandǝ ficha nifa le na mbǝssakaɓikǝmwa." <verse eid="ACT 4:12" /><verse number="13" style="v" sid="ACT 4:13" />Kǝ natndǝ alchit shunda nda Bitrus tǝ Yohanna, paɗ mbǝssangndǝwa nga fa sǝn'ǝnwa, paɗ fa ɓahcha, pǝɗang ǝn kandǝfa. Ɓeɗnda mbǝssandǝ paɗwa kǝsoh nakndǝ tǝ Yǝso. <verse eid="ACT 4:13" /><verse number="14" style="v" sid="ACT 4:14" />Kǝnannda nat nifi kǝnandǝndaɗaɗi kita hurnanda, ɓahkǝndǝ i nannda mbuta. <verse eid="ACT 4:14" /><verse number="15" style="v" sid="ACT 4:15" />Ndangnda nda Bitrus tǝ Yohanna wa kǝ chendakisha kǝttǝn yarangndǝ ichihi, kǝ yarangndǝ ichihi kǝ ndani. <verse eid="ACT 4:15" /><verse number="16" style="v" sid="ACT 4:16" />Ndakndǝwa: "Nakma sandǝ nofchiya kǝni? Mbandǝsǝ namma ndatwa sundǝ ǝnat pǝɗandǝ nifǝfuwowa, kǝthlǝm chikawuni a Urshelima shinwa shiɗ fichǝ ǝn kichu. <verse eid="ACT 4:16" /><verse number="17" style="v" sid="ACT 4:17" />Kǝthlǝm kǝ njaam ɗǝttǝkǝna kanda mban, ɓokamna kanda, mǝ ngǝrinda shunandǝ nifa hur thlǝmmiyawa." <verse eid="ACT 4:17" /><verse number="18" style="v" sid="ACT 4:18" />Akndǝ fathlǝnchikǝn, ɓokangnda kanda mǝ ngǝrinda shunandǝ nifǝ ndu kǝ sakangnda nifǝhar hur thlǝm Yǝso wa. <verse eid="ACT 4:18" /><verse number="19" style="v" sid="ACT 4:19" />Ngǝrang nda Bitrus tǝ Yohanna kandǝsǝwa: "Keekesa mbanitǝ Fara kǝ sǝkani innuni kǝ cherani i Farǝwa, Kǝlamǝn kǝnuni. <verse eid="ACT 4:19" /><verse number="20" style="v" sid="ACT 4:20" />Kǝthlǝm kanang ngani malandǝ mbu i natani tǝ i sǝktaniwa." <verse eid="ACT 4:20" /><verse number="21" style="v" sid="ACT 4:21" />Ngǝrkǝndǝ chekandǝ ɓokanda kanda kalkǝndǝ kandǝhi, kǝthlǝm sǝnundǝ mbayi nannda fǝra ɓwenne kandǝwa kǝthlǝm nofcha. Kǝthlǝm chikawun mǝla mwanandǝ Fara kǝ ɗar i sǝka. <verse eid="ACT 4:21" /><verse number="22" style="v" sid="ACT 4:22" />Nifi mbǝskǝ kǝndaɗaɗi tǝ mbanda ǝnat pǝɗandǝ nifǝfa, sheraɗa hurat kumchit fwaɗa tǝ ngǝtta.<verse eid="ACT 4:22" /></para>
  <para style="s">Hwanda Fafǝrkit ti Shuwunkǝ Nga tǝ Lechitfuwa</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23" />Kǝ kaltǝndǝ kandǝhi, nda Bitrus tǝ Yohanna pǝɗaknda mbǝs fahchinanda, mbwa'angndǝ i kandǝ mbutǝ pǝktat pǝristcha tǝ pǝktecha. <verse eid="ACT 4:23" /><verse number="24" style="v" sid="ACT 4:24" />Kandang paɗ kǝ sǝktǝndǝ kichu, thla'angndǝ ɓurechengnanda mbǝɗa Fara hurhwanda, ndakndǝwa: "Lǝmwandǝ lǝ alchitnat, sokǝn sǝk hur afshi tǝ kishita tǝ hawurta tǝ ichi naka hurkǝn nat. <verse eid="ACT 4:24" /><verse number="25" style="v" sid="ACT 4:25" />Tǝ mbǝɗa Shemeɗ Chiɗchiɗ, tǝ miya kakannani Dauda, mafaɗeku ndatuwa:</para>
  <para style="q1" vid="ACT 4:25">"Kǝthlǝmmǝ sǝɓɓandǝ punofcha huraɗi?</para>
  <para style="q2" vid="ACT 4:25">Kǝthlǝmmǝ nat nofcha kike kohat i'cha? <verse eid="ACT 4:25" /><verse number="26" style="v" sid="ACT 4:26" />Kuturcha kishita tehishndǝfa mbata, fa hǝmmbanita humandǝ inda kǝ ɗar Lǝmwanda tǝ Kǝrǝsti paɗ." <verse eid="ACT 4:26" /><verse number="27" style="v" sid="ACT 4:27" />"Kittǝkǝn a hur hǝmǝɗiya Hiridus tǝ Buntus Bilatus humandǝ inda tǝ punofcha tǝ nofcha Isra'ilawecha kǝ sangndǝ ɓǝɓichitfatfa nat kǝ ɗar mafaɗeku Yǝso le taɗtuhar. <verse eid="ACT 4:27" /><verse number="28" style="v" sid="ACT 4:28" />Humangndǝ inda kǝthlǝm kǝ sǝndǝ ichi taptu kǝ tahsangnǝhi tǝ alchiɗeku tǝ yahtekuwa nan sǝta. <verse eid="ACT 4:28" /><verse number="29" style="v" sid="ACT 4:29" />Nakǝnya Lǝmwanda, kǝlandǝn kah thlemmaɗengnanda kǝ Fǝrangnǝ mbaɓǝs shundeku mafecheku tǝ alchita. <verse eid="ACT 4:29" /><verse number="30" style="v" sid="ACT 4:30" />Kǝlla tiɗɗangnǝ harekuhi i kǝndaɗi, kǝ sani ǝnat pǝɗandǝ nifǝfa tǝ sakchikǝn tǝ mbǝɗa thlǝm mafaɗeku chiɗchiɗ, Yǝso." <verse eid="ACT 4:30" /><verse number="31" style="v" sid="ACT 4:31" />Ɗifitǝ hwandengnanda, mbǝɗi humtǝndǝhi hǝhǝrkǝnfa, nǝhɗang fichi kandǝ tǝ Shemeɗ Chiɗchiɗ. Ɓǝskǝndǝ pathla Farǝ nga lecgitfuwa.<verse eid="ACT 4:31" /></para>
  <para style="s">Chikama Fafǝrkit Ərta</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32" />Sǝrǝt fichile fǝrkǝkit, humkǝndǝhi hanɗǝkiketǝ ǝrta tǝ yarǝ ǝrta. Ngusǝ ndakwa i naksǝ'enwa ikǝnwa, chikamǝ naksengnanda innandǝ nat. <verse eid="ACT 4:32" /><verse number="33" style="v" sid="ACT 4:33" />Fathlǝnchǝkǝn fǝrkǝndǝ sheta tǝ thlata Yǝso Lǝmwanda hur mǝmatcha tǝ alchita, paɗ Kachita Farǝ kaǝn a ɗar nandǝ nat nda. <verse eid="ACT 4:33" /><verse number="34" style="v" sid="ACT 4:34" />Ngusa hurnandǝ ɓahkǝ ǝnwa, kǝthlǝm nat fa hurecha tǝ hicha hiyandaɗi ɓakndǝ tǝ hanɗǝɓǝlkǝn. <verse eid="ACT 4:34" /><verse number="35" style="v" sid="ACT 4:35" />Ɓakndǝ tǝ hanndǝɓǝlkǝn, fǝrangnda fathlǝnchǝkǝn, sakang ficha nofchinat chikawun keeke a i yahtǝn. <verse eid="ACT 4:35" /><verse number="36" style="v" sid="ACT 4:36" />Nifǝsi thlǝmkǝnwa Yusufu, lǝ Lawita kachitkǝn lǝ Kubrustǝ nakǝn, la at fathlǝnchǝkǝnwa Barnabas (sakitkǝnwa: "Hwan cheka alchita hanɗǝkiketa") <verse eid="ACT 4:36" /><verse number="37" style="v" sid="ACT 4:37" />Hiyaǝn hitǝ'enaɗi, ɓakǝn tǝ hanndǝɓǝlkǝnna ɓanitǝ fathlǝnchikǝn.<verse eid="ACT 4:37" /></para>
  <chapter eid="ACT 4" />
  <chapter number="5" style="c" sid="ACT 5" />
  <para style="s">Hananiya tǝ Safiratu</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1" />Nifǝsǝ thlǝmkǝnwa Hananiya tǝ nuhkǝn Safiratu, hi'yaǝn mbǝt enaɗi. <verse eid="ACT 5:1" /><verse number="2" style="v" sid="ACT 5:2" />Ɓuɓweekǝn hanɗǝɓǝlkǝn har tǝ sǝnda nuhkǝnsi, ɓakǝn tǝ tahhǝtkǝn ɗǝfkǝnhi mbanitǝ fathlǝncha. <verse eid="ACT 5:2" /><verse number="3" style="v" sid="ACT 5:3" />Ndǝkǝn ndat Bitrus wa: "Sokǝn Hananiya, mǝsǝk malandu Sheɗan kǝ nǝhɗaǝn hanɗǝkiketeku kǝ lekangna Shemeɗsǝ Chiɗchiɗ, ɓuɓweetu hanɗǝɓǝltǝ harra hur hanɗǝɓǝl hiti hi'yanduɗi? <verse eid="ACT 5:3" /><verse number="4" style="v" sid="ACT 5:4" />Thlateku kǝ ɗǝna hi'yandaɗaɗi, nga iuwowa? Ɗifitǝ hi'yaɗekuɗi, hanɗǝɓǝlkǝn nga iuwowa? Mǝsǝk ɗǝftu lekta hanndǝkiketeku? Nga nifǝ lekandusǝwa, Fara." <verse eid="ACT 5:4" /><verse number="5" style="v" sid="ACT 5:5" />Kǝ sǝktǝ Hananiya shuniniyu, hǝmkǝnhi mǝrkǝn. Nat fichile sǝkka kǝsang lechit kandǝ kaǝn. <verse eid="ACT 5:5" /><verse number="6" style="v" sid="ACT 5:6" />Ɓak kimshecha tǝranda kish, fwaɗangndǝ tǝ njeli thlohmurta pǝɗaknda thlohhanda. <verse eid="ACT 5:6" /><verse number="7" style="v" sid="ACT 5:7" />Ɗifitǝ nda hanthlǝkkǝn mǝkkan, yimkǝ nuhkǝnsi, sǝnutǝ i sǝkwa. <verse eid="ACT 5:7" /><verse number="8" style="v" sid="ACT 5:8" />Ndǝkǝn sahandǝ Bitrus wa: "Ɓu'i'tǝn, hi'yangnguni hitiɗiyu kichawa?" Ngǝmanwa: "Aa, kichuyu." <verse eid="ACT 5:8" /><verse number="9" style="v" sid="ACT 5:9" />Ndǝkǝn ndandǝ Bitrus wa: "Mǝsǝk humanduni mi kǝ kikeɗangnguni Shemeɗa Lǝmwandǝ kicheya? Suku kwarsara fichile pǝɗaka thlohhandǝ sǝmatu, kanda mikǝnnda, nanda tǝrruta kish paɗ." <verse eid="ACT 5:9" /><verse number="10" style="v" sid="ACT 5:10" />Chatkichuyu, hǝmkǝnhi mǝrkǝn. Kǝ yimtǝ kimshechikǝnsi, mbǝssangndǝ kǝ murǝtkǝn, tǝrkǝndǝndi kitangnda kish pǝɗangnda thlohhanda thlǝmat sǝmaha. <verse eid="ACT 5:10" /><verse number="11" style="v" sid="ACT 5:11" />Kǝssang lechit kǝttǝn hwakǝn kaǝn nat ta fichile sǝkkǝ ichiniyu.<verse eid="ACT 5:11" /></para>
  <para style="s">Shiɗ Fathlǝnchi Ənat Pǝɗandǝ Nofchǝfǝ oi</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12" />Shiɗ fichi ǝnat pǝɗandǝ nifǝfa tǝ sakchikǝn kaǝn a hur nofcha tǝ ɓǝɗa fathlǝncha. Nat fafǝrkit la ngomkǝndǝhi kǝttǝn para Sulemanu tǝ yarǝ ǝrta. <verse eid="ACT 5:12" /><verse number="13" style="v" sid="ACT 5:13" />A hur tahhǝt nofcha, ngusǝ cheɗkǝ nda nan yimta hurnandǝwa, chika kichu la fǝrang nofchǝ mwanda kanda. <verse eid="ACT 5:13" /><verse number="14" style="v" sid="ACT 5:14" />Nak fafǝrkitta chektǝ kaǝn kǝ ɓǝɗa Lǝmwanda, sheraɗa le soh, hishchǝ tǝ nishchǝ nat. <verse eid="ACT 5:14" /><verse number="15" style="v" sid="ACT 5:15" />Ala ɓakndǝ tǝ hacha mimbacha, funa mbǝt'hunecha funa ɗǝngǝlcha, kǝthlǝm ma Bitrusa mbǝrtǝhi, chika mirshingtǝ'en kǝɗǝn tǝ ɗar funa. <verse eid="ACT 5:15" /><verse number="16" style="v" sid="ACT 5:16" />Nofcha a thlet mbichi somsomǝn taurang Urshelima hiyu naknda ngomta, kanda ɓat tǝ hacha tǝ fichile nat ɓǝɓilǝwurcha ɓahandǝ kanda, kǝnang fichi kandaɗǝ natnda.<verse eid="ACT 5:16" /></para>
  <para style="s">Ɓahha Fichi Fathlǝncha Kǝthlǝm Fǝrkit'engnanda</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17" />Thlaakǝ kapat pǝrist tǝ fichile naka thlǝmatkǝn, fa tǝrmbanda Sadukiyawecha, nakndǝ tǝ sǝrǝhtafǝ kaǝn. <verse eid="ACT 5:17" /><verse number="18" style="v" sid="ACT 5:18" />Kǝsangndǝ fathlǝnchikǝn, ɗǝkndǝ tǝ kanda pursuna. <verse eid="ACT 5:18" /><verse number="19" style="v" sid="ACT 5:19" />Sokkǝn a fiɗɗikta, ɓak Mala'ika Lǝmwanda i'nandǝ mikǝtǝn pursunechikǝnhi, chaǝn kanda kish ndangna kandǝwa: <verse eid="ACT 5:19" /><verse number="20" style="v" sid="ACT 5:20" />"Ɗama kapat hura'a Fara ɗuni thlarǝhi hurkǝn kǝ mbwa'angnguni nofcha pathlǝ yuwa shisshingta kanda." <verse eid="ACT 5:20" /><verse number="21" style="v" sid="ACT 5:21" />Kǝ sǝktǝndǝ kichu yimkǝnda kapat hura'a Fara ɓingta naknda sakandaɗi. Kapat pǝrist tǝ fichile naka thlǝmatkǝn chekndakish, akndǝ fa sakandǝ ichihi tǝ fa hǝmmbanita Isra'ilawecha, thlǝnkǝnda pursuna kǝ ɓafichi tǝ kanda. <verse eid="ACT 5:21" /><verse number="22" style="v" sid="ACT 5:22" />Kǝ ɗǝt fa pu pursuna tǝkǝn, mbǝsawundǝ kandǝsǝwa, ɓaknda ɗaɗi ndakndǝwa: <verse eid="ACT 5:22" /><verse number="23" style="v" sid="ACT 5:23" />"Ɗǝkkani mbǝssandi pursuna tǝkǝna kuɓultǝ ndiichin, fa putǝhar kandǝsi a mikǝttǝnchikǝn, kǝ i'nandanihi mbǝssawani nifa hurkǝn chika ǝrtǝwa." <verse eid="ACT 5:23" /><verse number="24" style="v" sid="ACT 5:24" />Kǝ sǝktǝ kapat lǝ pu kapat hura'a Farǝ har kichu tǝ pǝktat pǝristchikǝn, kohǝrkǝ inchengnandaɗi, naknda sakandǝhi mǝna kuwurɗifitǝkǝn. <verse eid="ACT 5:24" /><verse number="25" style="v" sid="ACT 5:25" />Ɓakyuna ndanda kandǝwa: "Nofchi somtuni pursunayu kanda hur kapat hura'a Fara kanda sakanda nofchihar." <verse eid="ACT 5:25" /><verse number="26" style="v" sid="ACT 5:26" />Fa pu kǝttǝn hwakǝn har tǝ kapat nanda pǝɗaknda ɓat tǝ fathlǝnchikǝn, paɗ ngatǝalwa, kǝthlǝm pǝktechikǝn kanda lechita mǝmǝmuhanda kandǝfǝ tǝ ngwichǝwa. <verse eid="ACT 5:26" /><verse number="27" style="v" sid="ACT 5:27" />Kǝ ɓatndǝ tǝkanda, thlarangndǝ kandǝhi a mbanitǝ fa sakandǝ ichihi. Nak kapat pǝristsa sahami kanda. <verse eid="ACT 5:27" /><verse number="28" style="v" sid="ACT 5:28" />Ndakǝnwa: "Ɓokandǝmakuni, mǝ ngǝriɗuni sakanda nifihar a hur thlǝm nifiyawa, chika kichu nǝhɗaɗuni Urshelima ɗi tǝ saktengnuni kǝ ɗarkǝn, a yahkunisǝ nakǝnya kǝ tǝrranǝ hakke tǝ fwara nifiya kǝ ɓa ɗar inchengnani." <verse eid="ACT 5:28" /><verse number="29" style="v" sid="ACT 5:29" />Bitrus tǝ tahǝt fathlǝnchikǝn ngǝmangndǝwa: "Sokkǝn waat kǝ sani i mbutǝ Fara nga i mbutǝ nifuwa. <verse eid="ACT 5:29" /><verse number="30" style="v" sid="ACT 5:30" />Fara kakechinǝm thla'ang Yǝso hur mǝmatcha, le mbǝlanduni tǝ mbanda kukwandǝhi ɗar palita. <verse eid="ACT 5:30" /><verse number="31" style="v" sid="ACT 5:31" />Mǝlan mwanandǝ Fara ɗǝfkǝnndǝ tǝ harsǝmtǝ'en, sangna lǝ hǝmmbanita paɗ lǝ thlǝt nofchaɗi. Sǝkǝn iniyu kǝthlǝm Isra'ilawecha kǝ mbǝsndǝ mba tǝrtǝhi kǝ kalangfichǝ ɓǝɓichitfechengnanda kandǝhi. <verse eid="ACT 5:31" /><verse number="32" style="v" sid="ACT 5:32" />Kanang shetacha kǝ ɗar ichini natyu, kichu paɗ tǝ Shemeɗ Chiɗchiɗ, fǝrandǝ Fara fichile la kuwurkǝ ichi la mbutǝn." <verse eid="ACT 5:32" /><verse number="33" style="v" sid="ACT 5:33" />Kǝ sǝktǝndǝ kichu, sǝɓkǝ hurchengnandaɗi kaǝn, yahkǝndǝsa ɓǝllandǝ kanda. <verse eid="ACT 5:33" /><verse number="34" style="v" sid="ACT 5:34" />Yunǝsa mbǝnniyu lǝ Farisiyawata nat thlǝmkǝnwa Gamaliyel, lǝ ɓassǝ kus, le la fǝrandǝ nofchinat mwanda, thlaakǝn kit a hur fa sak'michikǝn ndakǝnwa chamǝn nofchikishya kwandǝn. <verse eid="ACT 5:34" /><verse number="35" style="v" sid="ACT 5:35" />Kanna ndanda kandǝwa: "Hwanmanchina Isra'ilawecha, mbǝramsa i yahtunisa sandǝ nofchiya. <verse eid="ACT 5:35" /><verse number="36" style="v" sid="ACT 5:36" />Hurechi mbǝrkǝhiyu, ɓak yunǝ kichu wa mǝlan Tuɗas, tǝrkǝn indǝ'en nda ǝnnakǝn, nifǝ aru fwaɗa ɗǝk kakǝn, ɓak ficha ɓǝllanda, fichile ɗǝk kakǝn nat wuwelkǝndǝhi. <verse eid="ACT 5:36" /><verse number="37" style="v" sid="ACT 5:37" />Ɗifitǝ mǝlan paɗ, fari nat ficha thlikandǝ nofcha, ɓak yuna wa mǝlan Yahuda lǝ Galilita, chikaǝn funa kuwurkǝndǝndǝ, mǝlan paɗ thlǝrǝtkǝnaɗi. Fa kuwurndǝ tǝkǝn wuwelkǝndǝhi. <verse eid="ACT 5:37" /><verse number="38" style="v" sid="ACT 5:38" />Chikale nakǝnya, ni mbwa'andakuni, chamakisha mbanda nofchiya, ma i natnda sakta i nifa, ngu ndǝta mbahwa: <verse eid="ACT 5:38" /><verse number="39" style="v" sid="ACT 5:39" />Ma i Fara, nguni mbǝla sa'ǝnkandǝwa. Na ficha mbǝssandǝ kuni kuna mbat tǝ Fara." <verse eid="ACT 5:39" /><verse number="40" style="v" sid="ACT 5:40" />Ngǝmangndǝ shundǝ'en, akndǝ fathlǝnchikǝnna hurkǝn, tǝppangnda kanda. Ndangnda kandǝwa mǝ ngǝrǝnda shundǝ tǝ thlǝm Yǝso wa, kannda kalǝ kandǝhi. <verse eid="ACT 5:40" /><verse number="41" style="v" sid="ACT 5:41" />Fathlǝnchikǝn malkǝndǝ mbanitǝ fa sakandǝ ichihi, kanda sǝt mbǝnfata a ɗar ndatwa shǝkndǝsi kǝ sandǝ ɓahta kǝthlǝm thlǝm Yǝso. <verse eid="ACT 5:41" /><verse number="42" style="v" sid="ACT 5:42" />Chikayen wembǝta, ndu hur kapat hura'a Fara ndu huri, malaundǝ sakandaɗi tǝ fǝr kusheng shundǝ mbinchin kǝ ɗar Yǝso wa mǝlan naka Kǝrǝstiwa.<verse eid="ACT 5:42" /></para>
  <chapter eid="ACT 5" />
  <chapter number="6" style="c" sid="ACT 6" />
  <para style="s">Teɗ Fichi fa Torchihar Muɗ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1" />A hanmunchiniyu nak fa fǝrkitta chektǝ oi, nak hurumtǝsǝ kaǝn. Yahudawecha fa shuwun Helenanchi naknda hurmanda Ibraniyawechǝfa, fa shundǝ tǝ mi Helenanchi, wa kǝlundǝsa nishchengnandǝ fichile mǝrtǝ hishchengnanda ka sak ichi kǝnding wa. <verse eid="ACT 6:1" /><verse number="2" style="v" sid="ACT 6:2" />Fichile kumngǝrǝnsǝ chapyu akndǝ fa fǝrkit ndakndǝwa: "Kamusǝ kimnang kǝ malaam ɓassǝ pathla Farǝ kǝ yimma pathlǝ ndǝsǝmtǝ wa. <verse eid="ACT 6:2" /><verse number="3" style="v" sid="ACT 6:3" />Kǝthlǝm ndǝkǝn, hwanmanchina, taɗam nofchihar muɗ a hurnuni, fichile la fǝrandǝ fichǝ mwanda kanda, paɗ nihiɗndaɗi tǝ Shemeɗa tǝ sǝnda, kǝ sǝmkanda ɗar toriya. <verse eid="ACT 6:3" /><verse number="4" style="v" sid="ACT 6:4" />Kǝmnang nakma nata ɗar hwanda tǝ sakandǝ shuwunkǝnaɗi." <verse eid="ACT 6:4" /><verse number="5" style="v" sid="ACT 6:5" />I mbutǝnda mbǝnangna nofchifǝ nat. Ndǝkǝn taɗtǝndǝ Istifanus, nifi nǝhiɗkǝ tǝ fǝrkit tǝ Shemeɗ Chiɗchiɗ tǝ Filibus tǝ Burokoras tǝ Nikanor tǝ Timan tǝ Barminas tǝ Nikolas lǝ Antakiyata le yimka tǝrmbanda Yahudawecha. <verse eid="ACT 6:5" /><verse number="6" style="v" sid="ACT 6:6" />Fichileya ɓanndǝ tǝ kanda mbǝɗa fathlǝncha, hwankǝnda ɗǝffaǝn harra kanda in. <verse eid="ACT 6:6" /><verse number="7" style="v" sid="ACT 6:7" />Nak pathla Fara nata ɗǝta mban. Fa fǝrkit naknda chekta a Urshelima kaǝn, pǝristchǝ terchin fǝrkǝkit.<verse eid="ACT 6:7" /></para>
  <para style="s">Kǝsa Fichi Istifanus</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8" />Istifanus, nifi nǝhǝɗkaɗǝ tǝ kafata tǝ alchita, shiɗtǝ pǝktat icha tǝ ǝnat sakchikǝn kaǝn a hur nofcha. <verse eid="ACT 6:8" /><verse number="9" style="v" sid="ACT 6:9" />Funǝsi a mbǝt humta Yahudawechihi lela atfichiwa kǝttǝn hwanda fichile kaltǝfichihi, thla'angnda Istifanus fa tǝ halǝ'inda, Yahudawechǝ ɓaka Sayirin tǝ Alekzandariya tǝ funa hachahai Kilikiya tǝ Asiya. <verse eid="ACT 6:9" /><verse number="10" style="v" sid="ACT 6:10" />Nakǝn tǝ sǝnǝnafǝ fǝrandǝ Shemeɗ i shunda, ngusǝ mbǝlaakǝ thlarǝhi kǝ halǝn'indǝ tǝndǝwa. <verse eid="ACT 6:10" /><verse number="11" style="v" sid="ACT 6:11" />Shipangndǝ yipta funa hur a ɓuɓweeta kǝ mbundǝ lektǝ kǝ ɗar Istifanus ndatwa: "Shikanindi mǝla erǝ Musa tǝ Fara." <verse eid="ACT 6:11" /><verse number="12" style="v" sid="ACT 6:12" />I'nǝyu thla'andǝ hur'inda nofcha, tǝ fa hǝmmbanita, tǝ malɗǝmcha fa sakandǝ kussaɗi. Kǝsangndǝ Istifanus ɓakndǝ tǝnda mbanitǝ fa sakandǝ ichihi. <verse eid="ACT 6:12" /><verse number="13" style="v" sid="ACT 6:13" />Ɓakndǝ tǝ fa fǝr sheta tǝ lekta, ndakndǝwa: "Nifiya kǝnding la nakna mbu sǝɓ'icha kǝ ɗar mbǝɗi chiɗchiɗya tǝ kuscha Musa, <verse eid="ACT 6:13" /><verse number="14" style="v" sid="ACT 6:14" />Kǝthlǝm shikanindi mǝla ndatwa Yǝso Lǝnazareta nan fǝffalandǝ mbǝnɗiɗiya, kǝ mbumbweɗaǝn ɗǝsǝchengnǝmhi le malandǝ Musa kǝmhi." <verse eid="ACT 6:14" /><verse number="15" style="v" sid="ACT 6:15" />Kǝ sǝktǝ nofchi nat sokkǝhi ɓǝt humkǝnhi, thlǝrangndǝ hwanichafa, nakndǝ chumwandǝ'en nda i Mala'ika<verse eid="ACT 6:15" /></para>
  <chapter eid="ACT 6" />
  <chapter number="7" style="c" sid="ACT 7" />
  <para style="s">Fǝr Ngǝmta Istifanus</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1" />Kapat pǝristǝkǝn, sahaǝn mi Istifanus wa: "Ichi natnda chitsǝhi ɗarkǝnya kitwa?" <verse eid="ACT 7:1" /><verse number="2" style="v" sid="ACT 7:2" />Ngǝmang Istifanus wa: "Hwanmanchina tǝ shinchina, sǝkamnji. Farǝ lǝmwanda cheɗang fat'ena kakatnǝm Ibrahim a Mesofotamiya, kana ndǝta sokta a Haran. <verse eid="ACT 7:2" /><verse number="3" style="v" sid="ACT 7:3" />Ndaǝnwa: "Chukisha hachahaiyeku tǝ parchǝwa kǝ yimna hachahaiyi nati cheɗuta. <verse eid="ACT 7:3" /><verse number="4" style="v" sid="ACT 7:4" />Thlaakǝn malkǝn hachahaiya Kaldiyawechǝ hi kǝ hachahai Haran kǝ farǝ mǝrta shinkǝn. Kana Fara ɓattǝnda ɓǝɗi natunisǝ nakǝnya. <verse eid="ACT 7:4" /><verse number="5" style="v" sid="ACT 7:5" />Fǝrawu Farǝ mbǝta mbǝnniyu kǝ ikǝn chika ishtǝ ǝrtǝwa, ndǝffaǝn shundǝhi tǝ ndatwa, kǝmban hachahaikǝn nat nan sokta'ikǝn tǝ kachitkǝn chika nguchik hwe'ensiyu. <verse eid="ACT 7:5" /><verse number="6" style="v" sid="ACT 7:6" />Ngǝrkǝ Farǝ shunandǝ ndatwa, na kachitwa ɗǝta sokta a hachahai somǝn kǝ mafecha, nanda sat ɓahtǝ kaǝn kǝ hurat aru fwaɗa. <verse eid="ACT 7:6" /><verse number="7" style="v" sid="ACT 7:7" />Nifǝra ɓahta hachahaiyi sang nofcheku kǝ mafechiyu, ndak Farǝwa, 'a mweshikǝn nanda chetakish kǝ ɓanda mwanita a mbǝɗya.' <verse eid="ACT 7:7" /><verse number="8" style="v" sid="ACT 7:8" />A hanmunchiniyu ɗǝffang Fara shunda Ibrahim hi i hesha. Ngǝtkǝ Ibrahim Ishaku, heshaǝn a mundǝ foɗfoɗa. Naknamban kichuyu, Ishaku heshaǝn Yakubu, Yakubu heshaǝn hwanchi'en kumngǝrǝnsi chap kakechinǝm. <verse eid="ACT 7:8" /><verse number="9" style="v" sid="ACT 7:9" />"Kakechǝnǝm tǝkǝn naknda sǝrǝh Yusufu, hi'yang ndandǝ kǝ Masar anakǝn Farǝ tǝndi. <verse eid="ACT 7:9" /><verse number="10" style="v" sid="ACT 7:10" />Thlǝkkǝnndaɗa hur ɓahta, fǝrang Farǝ mbǝs'ǝnhar tǝ sǝnda a mbanitǝ Fir'auna kutur Masarcha, fǝrang kuturkǝn mwanda a hachahai Masar uf paɗ fǝraǝn huraa'ena har. <verse eid="ACT 7:10" /><verse number="11" style="v" sid="ACT 7:11" />Ɓak mita yimta hachahai Masar tǝ Kan'ana, tǝ ɓahtǝ kaǝn sokkǝn kakechinǝm ɗǝsǝmtengnandǝsǝwa. <verse eid="ACT 7:11" /><verse number="12" style="v" sid="ACT 7:12" />Sǝkkǝ Yakubu wa ɗǝsǝmtǝsa Masar, thlǝnkǝn hwechi'en kakechinǝm kǝ Masar kǝthlǝm kǝ ɗǝnda hi ndǝsǝmta paɗ tǝrka ɗǝɗengnanda. <verse eid="ACT 7:12" /><verse number="13" style="v" sid="ACT 7:13" />Chapatǝ ɗǝɗengnanda, cheɗang Yusufu fata hwanmanchikǝn, paɗ cheɗang Yusufu hwanmanchikǝna Fir'auna. <verse eid="ACT 7:13" /><verse number="14" style="v" sid="ACT 7:14" />Thlǝnkǝ Yusufu wa shinkǝn tǝ tahhǝt witǝnandǝ nat, nifǝ kumchitmuɗ ngǝrǝnsǝ ɗurman, kǝ ɓanda hai kǝ Masar. <verse eid="ACT 7:14" /><verse number="15" style="v" sid="ACT 7:15" />Pǝɗak Yakubu kǝ Masar, mǝrkǝna mbǝnniyu nda i mǝrtǝ kakechinǝm. <verse eid="ACT 7:15" /><verse number="16" style="v" sid="ACT 7:16" />Kohkǝ fichǝ mǝmatchinanda kǝ Shekem ɗǝkficha thlohandǝ kanda a hur kwaɗi hiitǝ Ibrahim tǝ hanɗǝɓǝlta a hara hwecha Hamor a Shekem tǝkǝn. <verse eid="ACT 7:16" /><verse number="17" style="v" sid="ACT 7:17" />Nak farǝ ɗǝf shunda Farǝ hi tǝ Ibrahim satǝ nduk, Yahudawechikǝna a Masar chekkǝndǝ kaǝn. <verse eid="ACT 7:17" /><verse number="18" style="v" sid="ACT 7:18" />Tǝrkǝ kutursǝ somǝn a Masar tǝkǝn le sǝnuchik ǝn kǝɗar Yusufu <verse eid="ACT 7:18" /><verse number="19" style="v" sid="ACT 7:19" />Kuturǝniyu a pupwiktǝ nofchengnǝmhi oi paɗ a fǝraɗǝ ɓahta parchinǝm, la ɗǝfkǝn kandǝ kǝ somangndǝ hanngwa'yarchengnandaɗi kǝthlǝm kǝ mǝmatnda. <verse eid="ACT 7:19" /><verse number="20" style="v" sid="ACT 7:20" />A thlahɓǝchiniyu ngǝttǝfichǝ Musa, hwee ndiichin a mbanitǝ Fara. Kǝskǝ parchikǝn ndǝhar ndǝraa mǝkkan a hurhura'a shinkǝn. <verse eid="ACT 7:20" /><verse number="21" style="v" sid="ACT 7:21" />Kǝ muhandǝndaɗi ɗǝk hweya Fira'una tǝrta saǝn nda hwe'en mwanaǝn. <verse eid="ACT 7:21" /><verse number="22" style="v" sid="ACT 7:22" />Sakangfichǝ sǝnda Musahar i Masarawechi nat, paɗ alchit'ensi a hur torchǝ tǝ shunda. <verse eid="ACT 7:22" /><verse number="23" style="v" sid="ACT 7:23" />"Saakǝn hurat kumchit fwaɗa, ndakǝnwa kemsǝ kǝɗa nat fahchikǝn Israilawecha. <verse eid="ACT 7:23" /><verse number="24" style="v" sid="ACT 7:24" />A farǝle nakǝn lǝ Masarta ɓahandǝ hwanmankǝn, thlǝkǝn hwanmankǝn ɓǝlaǝn hwan lǝ Masartiyu. <verse eid="ACT 7:24" /><verse number="25" style="v" sid="ACT 7:25" />Naǝn Musa hiwa hwanmanchikǝn Israilawecha mbǝsandǝwa Farǝ naka sǝt tor tǝndi kǝ chaǝn kanda kissha hur ɓahta, a nakǝn ɓǝssawundǝwa. <verse eid="ACT 7:25" /><verse number="26" style="v" sid="ACT 7:26" />Wenkǝɓǝta ngǝrkǝn chetakish, nakǝn hwanmanchikǝn Israilawechi chap kanda mbata, 'yahkǝnsa mbǝnandǝ kanda, ndakǝnwa: 'Hishcha' nakuni hwanmani mǝsǝk natuni mbata?'' <verse eid="ACT 7:26" /><verse number="27" style="v" sid="ACT 7:27" />Lenaka fǝra ɓahta shekkǝnyu njingtaǝn Musa ɗi ndakǝnwa, 'Wun ɗǝfkǝsa kutura tǝ lǝ sakmi kǝ ɗarnani?' <verse eid="ACT 7:27" /><verse number="28" style="v" sid="ACT 7:28" />'Yahnǝsa ɓǝlitǝ nda i ɓǝlandu lǝ Masarti ɓǝraa'yuwa? <verse eid="ACT 7:28" /><verse number="29" style="v" sid="ACT 7:29" />Kǝsǝktǝ Musa kichu, rahkǝn malkǝn hachahaikǝnhi pǝɗakna hachahaya Midiyanacha sokkǝn kǝ romma ɓǝnniyu paɗ ngaǝlngǝn hweechi chap kǝ hishcha. <verse eid="ACT 7:29" /><verse number="30" style="v" sid="ACT 7:30" />Ɗifitǝ hurat kumchitfwaɗa, cheɗang mala'ika fat'ena Musa tǝ mbǝnda hanshuwun hwata, naka kǝsta ɗar hanafta a loktara nduk tǝ shohla Sina'i. <verse eid="ACT 7:30" /><verse number="31" style="v" sid="ACT 7:31" />Kǝnat Musa i'niyu pǝɗangǝnfa mbǝnniyu. Ɓahkǝn nduk kǝthlǝm kǝnanhi ndiichin, sǝkkǝn ɓurata Lǝmwanda: <verse eid="ACT 7:31" /><verse number="32" style="v" sid="ACT 7:32" />'Njang naka Fara kakechuwa, Fara Ibrahim, Ishaku tǝ Yakubu.' Lechik Musa, nakna saktatfa tǝraǝn hwanitaɗi. <verse eid="ACT 7:32" /><verse number="33" style="v" sid="ACT 7:33" />Ndǝkǝn ndandǝ Lǝmwandǝwa, 'Mbasan pahǝmchekuhi, kǝthlǝm mbǝɗi thlartusiyu chiɗchiɗtǝ mbǝta. <verse eid="ACT 7:33" /><verse number="34" style="v" sid="ACT 7:34" />A neɗi ɓahta nofchengnǝhi a Masar. Shiki tiɗengnanda, Ɓakihaiya kǝthlǝm kǝthlǝ kandaɗi. Nakǝnya ɗu ni thlǝnsa kǝ ngǝrangnǝinna Masar <verse eid="ACT 7:34" /><verse number="35" style="v" sid="ACT 7:35" />"Musati chertǝnda ndatwa: 'Wun ɗǝfkǝsa kutura tǝ lǝ sakmiya?' Mǝlan thlǝntǝ Farǝ nakǝnya kǝ naka kutura tǝ lǝ thlǝtkandaɗi tǝ mbǝɗa mala'ika cheɗang fat'en tǝ mbanda hwata ɗar hanafta. <verse eid="ACT 7:35" /><verse number="36" style="v" sid="ACT 7:36" />Nifiniyu chang kanda kish a Masar, ɗifitǝ sǝt ichi pǝɗang nofchifǝ kaǝn, paɗ tǝ i sǝtna a fi hawurta tǝ loktara, tǝrkǝ ndǝ hurat kumchit fwaɗa. <verse eid="ACT 7:36" /><verse number="37" style="v" sid="ACT 7:37" />Musa tǝkǝn ndangna Israilawechǝ wa, 'Na Fara thla'a'ndǝ yuna hurnuni kǝ tapǝna'a nda njang.' <verse eid="ACT 7:37" /><verse number="38" style="v" sid="ACT 7:38" />Nifikǝn nakna hurnuni fari ngomtunihi a loktarǝ tǝ kakechinǝm tǝ mala'ika ɓaka shunanda a shohla Sinaiyu tǝ shinchinǝm. Mbǝnniyu thlǝt Musa shuwun nathi kana ɓata fǝranda kǝm. <verse eid="ACT 7:38" /><verse number="39" style="v" sid="ACT 7:39" />Kakechinǝm tǝkǝn cherkǝnda fǝra mwanda, kawundǝ thlǝmatwa. Cherkǝndǝndi a 'yahkǝndǝsa ngǝrandǝinna Masar. <verse eid="ACT 7:39" /><verse number="40" style="v" sid="ACT 7:40" />Ndangnda Haruna wa kǝ tahsaǝn ɗǝhhacha kandǝsi, fichile na nata mban. Kǝthlǝm sǝnwum i kǝskǝ Musa ti chang kǝma kishsha Masar wa. <verse eid="ACT 7:40" /><verse number="41" style="v" sid="ACT 7:41" />Tinkǝndǝ ɗǝhhata nda hwalata, thlangndǝ ɓurat ɗǝhǝrǝmcha ɗǝhhakǝn i mbǝnfata kǝ ɗar i tahǝstǝndǝ tǝ harchengnanda. <verse eid="ACT 7:41" /><verse number="42" style="v" sid="ACT 7:42" />Tǝɓrang Farǝ hǝsǝra kandǝfa malkǝn kandǝhi kǝnnda mwanandǝ handǝrecha afshi nda farengnanda, nda i natna hur yaratkǝna tapǝnecha, kunang Israilawecha, njang thlanduni ɓurat ɗǝhǝrǝmcha mwananduni ɗǝhhacha a loktarǝ hurat kumchitfwaɗa wa? <verse eid="ACT 7:42" /><verse number="43" style="v" sid="ACT 7:43" />Harkuni kǝttǝn ɗǝhhachengnuni Molek tǝ ɗǝhha handǝra'a Refan, nakuni witǝ tǝ kanda, ɗǝhhachi tahǝstuni tǝ harcha kǝthlǝm kǝ mwanangnguni kanda, njang paɗ ni harandi kuni kǝ ɗifitǝ Babila. <verse eid="ACT 7:43" /><verse number="44" style="v" sid="ACT 7:44" />Soh kakechinǝm tenti engnandǝsi a loktara, le cheɗkǝwa lanak Fara mbǝnniyu. Ndǝkǝn na tenti tǝ ndandǝ Fara Musa wa kǝ tahsǝn, tahǝskǝndǝ nda i ndandǝ Fara kanda. <verse eid="ACT 7:44" /><verse number="45" style="v" sid="ACT 7:45" />Ɗifitǝ hurecha, kakechinǝm ti thlǝk iniyu, ɓakndǝ tǝkǝna hachahayi fǝrandǝ Fara kanda, ɗifitǝ rǝki rǝktǝ Farǝ nofchi naka hachahaikǝn, fari nat Joshua kǝ lǝ hǝm mbanita. Tenti tiniyu nakna mbǝnniyu kǝ thlahmbǝɗi sǝt Dauda kuturichita. <verse eid="ACT 7:45" /><verse number="46" style="v" sid="ACT 7:46" />Dauda tǝkǝn mbishtǝ ɗwachita mbǝɗa Fara a hwankǝnwa nan tina hura'a Fara Yakubu si. <verse eid="ACT 7:46" /><verse number="47" style="v" sid="ACT 7:47" />Sokkǝn Sulemanu tinang hurikǝnsi. <verse eid="ACT 7:47" /><verse number="48" style="v" sid="ACT 7:48" />A nakǝn Kapat Lǝmwanda sokwa hurǝ'i tintǝ nifǝ tǝ harwa, nda i ndat tapǝna'a, <verse eid="ACT 7:48" /><verse number="49" style="v" sid="ACT 7:49" />"Hur afshi mbǝt soktengna, hachahaya mbǝt sǝt sarǝchengna, witǝ hurǝmǝ natuni tinitǝsi? Paɗaa witǝ mbǝt yipmi natuni tinitǝsi?" <verse eid="ACT 7:49" /><verse number="50" style="v" sid="ACT 7:50" />Nga harchengnǝ tingkǝ ichi natyawowa? <verse eid="ACT 7:50" /><verse number="51" style="v" sid="ACT 7:51" />Kunang fa kwaakwachit hur i'ncha, tǝ fa kwaakwachit hanɗǝkikecha, tǝ fa kwaakwachit thlǝmecha, kǝ nding kuna cherami Chiɗchiɗ tǝ Shemeɗ fa. Sǝk kakechinuni kichuyu a nakuni sǝtkichu kunang paɗ <verse eid="ACT 7:51" /><verse number="52" style="v" sid="ACT 7:52" />A hur tapǝnecha, wun fǝrawuchit kakechinuni ɓahta? Ɓǝlandǝ fichile mbukǝ ɓata lǝ kafatchiɗchiɗ. kunang paɗ fǝrkunindǝ a ɓǝllangnguni. <verse eid="ACT 7:52" /><verse number="53" style="v" sid="ACT 7:53" />Thlǝkuni kuscha Fara cherkuni hǝrǝmtǝhar keeke.<verse eid="ACT 7:53" /></para>
  <para style="s">A Ɓǝllandǝ Istifanus tǝ Muhta</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54" />Kǝ sǝktǝndǝ kichu sǝɓkǝ hurchengnandanɗi, nangnda cha'andǝ hanthlanchengnandǝ kǝ ɗarkǝn. <verse eid="ACT 7:54" /><verse number="55" style="v" sid="ACT 7:55" />A nakǝn Istifanus a nihiɗaɗi tǝ Shemeɗ Chiɗchiɗ, kǝlakna hur afshi a nakǝn mwanda Fara, paɗ Yǝso kita harsǝmta Fara. <verse eid="ACT 7:55" /><verse number="56" style="v" sid="ACT 7:56" />Ndǝkǝn ndat Istifanus wa: "Nama, a neɗi afshi inhi paɗ hweya nifa kita harsǝmta Fara." <verse eid="ACT 7:56" /><verse number="57" style="v" sid="ACT 7:57" />Thlaakǝndǝ tǝ kapat kukwara, ngǝlangndǝ thlǝmechengnandǝ tǝ harchengnanda ngomangndafa. <verse eid="ACT 7:57" /><verse number="58" style="v" sid="ACT 7:58" />Changnda kish kǝ hǝsǝr hura'a ndǝknda mumuhwandafa. Fichile mumuhwangfiyu malkǝndǝ ichengnanda mbǝnniyu hara kimshaa lela atfichiwa Shawulu. <verse eid="ACT 7:58" /><verse number="59" style="v" sid="ACT 7:59" />Naknda mumuhwanda Istifanusafa, hwankǝn ndatwa: "Lǝmwandǝ Yǝso, thlu shemeɗengna." <verse eid="ACT 7:59" /><verse number="60" style="v" sid="ACT 7:60" />Hǝmkǝna ɗar weɗchi'en, i'naǝn ɓurathi kaǝn, ndakǝnwa: "Lemwanda, mǝ thlikani ɓǝɓichitfechiya a ɗar inchengnandǝwa." Mbukǝn i'niyu, mǝrkǝn.<verse eid="ACT 7:60" /></para>
  <chapter eid="ACT 7" />
  <chapter number="8" style="c" sid="ACT 8" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1" />Huneɗ Shawulu ɗar ɓǝl Istifanus.</para>
  <para style="s" vid="ACT 8:1">Shawulu Fǝrandǝ Bahta Ɓǝt Ngǝlhwanicha</para>
  <para style="p" vid="ACT 8:1">A farǝniyu thlaakǝ kapat ɓahtǝ kǝ ɗar fa tǝrmbayi naka Urshelima. Wuwelkandǝhi kǝ thlet hǝmǝt Yahudiya tǝ Samariya, fa thlǝnchǝ ndak maltǝndǝsi.<verse eid="ACT 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 8:2" />Funǝ nofchisi fa mwandǝ Fara ndǝknda thlohandǝ Istifanus, tikndǝ kaǝn kǝ mǝrti'en. <verse eid="ACT 8:2" /><verse number="3" style="v" sid="ACT 8:3" />A nakǝn Shawulu ndǝkna mban tǝ fǝra ɓahta fa tǝrmbanda nda hishchǝ tǝ nishcha, la yimkǝn huraahura'a, mǝla somkanda pursuna.<verse eid="ACT 8:3" /></para>
  <para style="s">Ɓesh Filibus Pathla Fara A Hur Samariya</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4" />Fichile wuwelandǝ fichi kandǝhiyu, pǝɗaknda thlet mbichǝ somsomǝn naknda ɓassǝ pathla Fara. <verse eid="ACT 8:4" /><verse number="5" style="v" sid="ACT 8:5" />Pǝɗak Filibus kǝ hurhuri Samariya ɗǝkna nata ɓassanda nofchisi kǝ ɗar Kǝrǝsti. <verse eid="ACT 8:5" /><verse number="6" style="v" sid="ACT 8:6" />Nofchi oi tǝ hanɗǝkiketǝ ǝrta sǝkkǝnda, nakndǝ ǝnat pǝɗadǝfaɗifǝ natna sǝta, naknda kathlǝmata i nat Filibussa mbuta. <verse eid="ACT 8:6" /><verse number="7" style="v" sid="ACT 8:7" />Ɓǝɓi shemechi naka chetakishyu naknda kukwara. Tǝraɗcha tǝ fichile sakkaɗi kanda kǝɗaɗi. <verse eid="ACT 8:7" /><verse number="8" style="v" sid="ACT 8:8" />Nak mbǝnfatsǝ kaǝn a hǝmǝɗiniyu. <verse eid="ACT 8:8" /><verse number="9" style="v" sid="ACT 8:9" />Nifǝsa mbǝnniyu thlǝmkǝnwa Saminu, lǝ sǝt tor kullata, lafǝraǝn ǝnat pǝɗandǝ Samariyawechafa, la tǝrkǝnwa kapat nifǝ nakǝn. <verse eid="ACT 8:9" /><verse number="10" style="v" sid="ACT 8:10" />Chikawuni, hanhwe tǝ kapatnifa nat a fǝrandǝ hur'inda tǝ ndatwa: "Nifiya alchita Fara la atfichǝwa kapat Mwanda." <verse eid="ACT 8:10" /><verse number="11" style="v" sid="ACT 8:11" />A fǝrangndǝ hur'indǝ kaǝn, kǝthlǝm a mwin tirǝɓ mǝla sǝt ǝnat pǝɗandǝ nofchifa tǝ ǝnat kullechi'en. <verse eid="ACT 8:11" /><verse number="12" style="v" sid="ACT 8:12" />Paɗ kǝ ɓat nofchiyu fǝrkitta ɓassa Filibus kǝ ɗar kusheng shundǝ ɓinchin kǝ pathlǝ kuturichita Fara tǝ thlǝm Yǝso Kǝrǝsti, sangndǝ baptisma kanda, hischi tǝ nishchi nat. <verse eid="ACT 8:12" /><verse number="13" style="v" sid="ACT 8:13" />Chika Saminu tǝ i'ndǝ'en a firtǝkit, saǝn baptisma nakna witǝ tǝ Filibus kalutǝndǝhiwa. Saminu nakna nat ichi natna sǝta i pǝɗandǝ nofchifa, mǝlan paɗ pǝɗang ǝnfa. <verse eid="ACT 8:13" /><verse number="14" style="v" sid="ACT 8:14" />Kǝ sǝktǝ fathlǝnchi Urshelimayuwa, Samariyawecha a thlǝɗndǝ pathla Fara, thlǝnangndǝ nda Bitrus tǝ Yohanna kanda. <verse eid="ACT 8:14" /><verse number="15" style="v" sid="ACT 8:15" />Satengnanda, hwanangnda kaɗǝsi kǝthlǝm kǝ thlǝndǝ Shemeɗ Chiɗchiɗ. <verse eid="ACT 8:15" /><verse number="16" style="v" sid="ACT 8:16" />Kǝthlǝm Chiɗchiɗ tǝ Shemeɗkǝn tǝrwahai kǝ ɗar inda yunǝ kwandǝnwa, tǝ sang fichi baptisma kandǝ ndak a hur thlǝm Lǝmwandǝ Yǝso. <verse eid="ACT 8:16" /><verse number="17" style="v" sid="ACT 8:17" />Ndǝkǝn sandǝ Bitrus tǝ Yohanna harcha kanda in thlǝkndǝ Chiɗchiɗ tǝ Shemeɗa. <verse eid="ACT 8:17" /><verse number="18" style="v" sid="ACT 8:18" />Kǝnat Saminuwa tǝ ɓǝɗa ndǝfhara'inna fathlǝnchǝ la mbǝstǝ fichi Chiɗchiɗ tǝ Shemeɗa, fǝraǝn hanndǝɓǝlta kanda. <verse eid="ACT 8:18" /><verse number="19" style="v" sid="ACT 8:19" />Ndakǝnwa: "Njang paɗ fǝramitǝn alchiɗiya, kǝthlǝm chikawun ndǝfandi hara'in kǝ thlǝn Chiɗchiɗ tǝ Shemeɗa." <verse eid="ACT 8:19" /><verse number="20" style="v" sid="ACT 8:20" />Ndǝkǝn ndandǝ Bitrus wa: "Sokǝn tǝ hanndiɓǝlteku kǝ thlǝrtuninɗi, mbah sukǝnfǝwa nu mbǝs fǝrta Farǝ tǝ hanndiɓǝlta. <verse eid="ACT 8:20" /><verse number="21" style="v" sid="ACT 8:21" />Sǝssa hur torchiyawa, kǝthlǝm hanndǝkiketeku nga keeke kǝ mbǝɗa Farǝ wa. <verse eid="ACT 8:21" /><verse number="22" style="v" sid="ACT 8:22" />Tǝrruhi hur ɓǝɓi ndǝsǝcheku kǝ hwanangnǝ Lǝmwanda ma mbandǝsi kǝ kallukǝn ɓǝɓi yarekuhi.<verse eid="ACT 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 8:23" />Kǝthlǝm kǝlayi sokǝn cheku nat ɗǝhɗǝh, paɗ naku chingching hur ɓǝɓifata." <verse eid="ACT 8:23" /><verse number="24" style="v" sid="ACT 8:24" />Ngǝmang Saminuwa: "Hwanamitǝnsi kǝ mbǝɗa Lǝmwanda kǝthlǝm ichi mbutuni natya, mǝ ɓiɗa ɗar indengnǝwa." <verse eid="ACT 8:24" /><verse number="25" style="v" sid="ACT 8:25" />Kǝ mbwa'andǝ Bitrus tǝ Yohanna kanda i natnda, ɓassangndǝ pathla Lǝmwanda kaɗǝsi le nak ɓinchin, naknda ngǝrangndǝ'ina Urshelima, ndǝkndǝ tǝ ɓassa a thlet hǝmchǝ somsomǝn, a hachahai Samariya oi.<verse eid="ACT 8:25" /></para>
  <para style="s">Filibus tǝlǝ Itiyofiyata.</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26" />Ndang mala'ika Lǝmwanda Filibuswa: "Thla'u ɗu tǝ kukuwun hishingteku kǝ tǝrnǝ mbayi thlaaka Urshelima kǝ Gaza yu, naka mba loktariyu." <verse eid="ACT 8:26" /><verse number="27" style="v" sid="ACT 8:27" />Thlaakǝn pǝɗakǝn, kǝmkǝn tǝlǝ Itiyofiyata mbanda, kullaɓta, kapat nifa a hur kuturichita Kandis, kutur nishcha a Itiyofiyata, mǝlan na lǝ kǝs ndǝɓǝltǝhar. Ɓakna Urshelima kǝthlǝm kǝ mwanaǝn. <verse eid="ACT 8:27" /><verse number="28" style="v" sid="ACT 8:28" />Nakna ngǝrandǝ i'naɗi ɗassa hur ǝnat sokta a Pirish keeke'en, mǝla changngat ɗelwerra Ishaya tapǝna'a. <verse eid="ACT 8:28" /><verse number="29" style="v" sid="ACT 8:29" />Ndang Shemeɗa Filibuswa: "Ɗuɗuk tǝ Pirish keeketiyu." <verse eid="ACT 8:29" /><verse number="30" style="v" sid="ACT 8:30" />Rahkǝ Filibus kǝ thlǝmmatkǝn, nakna sǝk i nat nifiyu changngata a hur ɗelwerra Ishaya tapǝna'a. Sahang Filibus wa: "Shinnǝ sakǝt i natu changngatyawa?" <verse eid="ACT 8:30" /><verse number="31" style="v" sid="ACT 8:31" />Ngǝmang nifiyuwa, "Naki sǝndǝwa kǝni manga nifi tausang engnǝwa?" Ndǝkǝn ndandǝna Filibus wa kǝ tǝrǝnsi kǝ ɗa mbǝssndi kǝ sokndǝ rǝmma. <verse eid="ACT 8:31" /><verse number="32" style="v" sid="ACT 8:32" />I natna changngata a hur ɗelwertǝkǝn ndatwa: "Kahkǝ fichindi nda shohrata kǝ mbǝt thletɓurata. Nda i lanat hwan Shohrat ɓa a hara lǝ hǝsta, nakǝn kichu chika miya i'nawuhiwa. <verse eid="ACT 8:32" /><verse number="33" style="v" sid="ACT 8:33" />Njirkǝndǝndi paɗ njangndǝ kitchitkǝn. Wunna mbǝla mbu kachitkǝn? Kǝthlǝm thla fichǝ shisshingtǝenhi hur kishita." <verse eid="ACT 8:33" /><verse number="34" style="v" sid="ACT 8:34" />Ndǝkǝn ndandǝ kullaɓiyu Filibuswa: "Wunnat tapǝni'iya shunda ɗarkǝn, kǝ ɗar'i'ndi'enwa ndu kǝ ɗar yunǝ somǝn?" <verse eid="ACT 8:34" /><verse number="35" style="v" sid="ACT 8:35" />Tǝrkaakǝ Filibus shunda tǝrta mbǝɗi changngat nifiyu, nakna mbwa'a kweshcha kusheng shundǝ kǝ ɗar Yǝso. <verse eid="ACT 8:35" /><verse number="36" style="v" sid="ACT 8:36" />Naknda ɗar wita hur mbanda saakǝnda mbǝɗi nat amsi, ndak nifiyuwa: "A amya mǝna njat kǝ sikǝ fichi baptisma?" <verse eid="ACT 8:36" /><verse number="37" style="v" sid="ACT 8:37" />Ndak Filibus wa, "Ma firnǝkit tǝ hanɗǝkiketǝ ǝrta sukǝ ficha: "Ngǝmang nifiyuwa Firikit Yǝso Almasihu hweya Farǝ nakǝn." <verse eid="ACT 8:37" /><verse number="38" style="v" sid="ACT 8:38" />Chatkichuyu ndak nifiyuwa kǝ thlarang fichi Pirish keeketihiyu. Nda Filibus tǝ kullaɓiyu tǝrkǝnda haya, yimkǝnda hur ammiyu, sang Filibus baptisma. <verse eid="ACT 8:38" /><verse number="39" style="v" sid="ACT 8:39" />Kǝ natnda cheta hur amkǝn, tǝrang Shemeɗa Lǝmwanda Filibus. Kullaɓiyu ngǝrutǝ natndǝ paɗwa, kǝskǝn mbandǝ'en pǝɗakǝn tǝ mbǝnfata. <verse eid="ACT 8:39" /><verse number="40" style="v" sid="ACT 8:40" />A nak fichi Filibus a Azotus. Nakna ɓǝrtǝhi ɓasskǝn kusheng shundǝ mbinchinna thlet hǝmchini natta mbǝnniyu saakǝnna Kaisariya.<verse eid="ACT 8:40" /></para>
  <chapter eid="ACT 8" />
  <chapter number="9" style="c" sid="ACT 9" />
  <para style="s">Tǝɓǝrta Shawulu Hi</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1" />Ɗǝk Shawulu mban tǝ fǝraa lechita fa tǝrmbanda Lǝmwandǝ kaǝn, ndatwa nan ɓǝllandǝ kanda, ɗǝkna ɓǝɗa kapat pǝrist. <verse eid="ACT 9:1" /><verse number="2" style="v" sid="ACT 9:2" />Hwanaǝn kǝ yaraǝn ɗelwerchisi kǝ mbǝt humta Yahudawechihi a Dimaska, kǝthlǝm kǝ mbǝssǝn mba kǝsandǝ nofcha fa tǝrmbakǝn, hishchǝ tǝ nishchǝ nat kǝɗǝn tǝkanda Urshelima a kǝnda. <verse eid="ACT 9:2" /><verse number="3" style="v" sid="ACT 9:3" />Mǝla pǝɗata, shee nduk tǝ Dimaska tǝkǝn chat kichuyu ɓak ɗwachita haya afshi tauraǝn Shawulu tǝkǝnhi. <verse eid="ACT 9:3" /><verse number="4" style="v" sid="ACT 9:4" />Hǝmkǝnhi hachahaiya sǝkkǝn ɓurata ndatwa: "Shawulu, Shawulu, kǝthlǝmǝ natu ɓahita?" <verse eid="ACT 9:4" /><verse number="5" style="v" sid="ACT 9:5" />Mǝlan paɗ ndakǝnwa: "Wunnaku Lǝmwanda?" Ndǝkǝn ɗandǝnwa: "Njang Yǝso le natu fǝra ɓahtiyu. <verse eid="ACT 9:5" /><verse number="6" style="v" sid="ACT 9:6" />Thla'u kǝ yimna hurhura'a, mbǝnniyu nanda mbu'u i natu sǝta." <verse eid="ACT 9:6" /><verse number="7" style="v" sid="ACT 9:7" />Nofchi nannda witǝ rǝmmǝyu, thlarkǝndǝhi kǝmma kanda shundǝsuwa, kanda sǝk ɓuratkǝn nakǝn kanda nat nifǝwa. <verse eid="ACT 9:7" /><verse number="8" style="v" sid="ACT 9:8" />Thlaakǝ Shawulu a hachahaiya, i'naǝn hwanichi'enhi mbǝla'utǝ nat ǝnwa. Nofchi nannda witǝyu kǝskǝndǝ har'en, ndǝkndǝ tǝnda hurhuri Dimaska. <verse eid="ACT 9:8" /><verse number="9" style="v" sid="ACT 9:9" />Mundǝ mǝkkan mǝla natmbǝtwa, paɗ sǝmutǝ'ǝnwa sutǝ amwa. <verse eid="ACT 9:9" /><verse number="10" style="v" sid="ACT 9:10" />Lǝ tǝrɓandǝsa Dimaska lǝ atfichiwa Hananiya, ndang Lǝmwanda a hur ǝn nda sǝnnatǝwa: "Hananiya." Ngǝmanwa: "A njangya Lǝmwanda." <verse eid="ACT 9:10" /><verse number="11" style="v" sid="ACT 9:11" />Ndǝkǝn ndandǝ Lǝmwandǝwa: "Thla'u kǝ ɗǝnna mbayi la atfichiwa Ndellengnga, kǝ sahnǝ hura'a Yahuda nifi ɓaka Tarsus la atfichiwa Shawuluyu. Nakǝn kicheya mǝla hur hwanda. <verse eid="ACT 9:11" /><verse number="12" style="v" sid="ACT 9:12" />A neɗɗa hur ǝn nda sǝnnatǝwa nifa ɓata la atfichiwa Hananiya, ma shee nansa harcha in kǝthlǝm kǝ ngǝrǝn nat mbǝta." <verse eid="ACT 9:12" /><verse number="13" style="v" sid="ACT 9:13" />Ngǝmang Hananiya wa: "Lǝmwanda, a shiki nofchi oiya mbu ɓǝɓi icha ɗar nifinǝyu le sandǝn fa tǝrmbanda a Urshelima: <verse eid="ACT 9:13" /><verse number="14" style="v" sid="ACT 9:14" />Paɗ pǝktat pǝristchiyu fǝrandǝ alchita kǝ kǝssaǝn chikawun naka at thlǝmwa." <verse eid="ACT 9:14" /><verse number="15" style="v" sid="ACT 9:15" />Ndǝkǝn ɗandǝ Lǝmwandǝwa. "Ɗu, kǝthlǝm teɗindi kǝ sokka ǝnat torrengna, kǝ ɗǝn tǝ thlǝmna mbǝɗa punofcha tǝ kuturcha, paɗ tǝ Isra'ilawecha. <verse eid="ACT 9:15" /><verse number="16" style="v" sid="ACT 9:16" />Ni cheɗa witǝ ɓahhi natna satta kǝthlǝm thlǝmna." <verse eid="ACT 9:16" /><verse number="17" style="v" sid="ACT 9:17" />Pǝɗak Hananiya, ndǝkna mbǝssandǝ Shawulu. Saǝn harcha in, ndakǝnwa: "Hwan'yaa Shawulu, Lǝmwandǝ Yǝso cheɗukǝ fat'ena mbandǝyu thlinkǝnji kǝthlǝm kǝ ngǝrnǝ natmbǝta paɗ kǝ nǝhǝɗnǝ tǝ Shemeɗ Chiɗchiɗ." <verse eid="ACT 9:17" /><verse number="18" style="v" sid="ACT 9:18" />Chat kichuyu ichi nda ɓwar tinda hǝhatkǝnda haya a hwanichi'en, ngǝrkǝna nata natmbǝta. Thlaakǝn sangfichi baptisma. <verse eid="ACT 9:18" /><verse number="19" style="v" sid="ACT 9:19" />Sǝmkǝn ǝna ɓak alchit'enaɗi.</para>
  <para style="s" vid="ACT 9:19">Shawulu Ɓeshtǝ Pathla Fara a Dimaska</para>
  <para style="p" vid="ACT 9:19">Sokkǝ Shawulu hi a Dimaska, i hanmunchi ɗǝmek tǝ fa tǝrmbanda. <verse eid="ACT 9:19" /><verse number="20" style="v" sid="ACT 9:20" />Chatkichuyu tǝrkaakǝn nata ɓasǝ Yǝso, a mbǝt humta Yahudawechihi ndatwa, mǝlan naka hweya Fara. <verse eid="ACT 9:20" /><verse number="21" style="v" sid="ACT 9:21" />Nat fichile sǝkkǝndi, pǝɗang ǝn kandǝfa, ɗakndǝwa, "Awi nga nifiya wuwelang fa tǝrmbanda Yǝso ɗa a Urshelima wa? Ɓakna mbǝɗya kǝthlǝm kǝ kǝssaǝn kanda kǝ ɗǝn tǝ kanda kǝ mbǝɗa kapat pǝristchikǝn?" <verse eid="ACT 9:21" /><verse number="22" style="v" sid="ACT 9:22" />Ɓassa Shawulu nakǝn kǝ chektǝ kǝ chektǝ tǝ alchita, paɗ shiwunchi'en kǝ ɗar Yǝso nakǝn tǝɓraɗǝ hur'i'nda Yahudawechihi naka Dimaska.<verse eid="ACT 9:22" /></para>
  <para style="s">Hirǝk Shawulu A Haara Yahudawecha</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23" />Ɗifitǝ hanmunchi kaǝn, humang Yahudawechi miwa nanda mbǝllanda. <verse eid="ACT 9:23" /><verse number="24" style="v" sid="ACT 9:24" />Kanda ngunguɗndi fiɗiktǝ tǝ farǝ nat, a mimbangnga kǝthlǝm kǝ ɓǝllangnda, a nakǝn kusheng shiwunkǝn himma thlǝmata Shawulu. <verse eid="ACT 9:24" /><verse number="25" style="v" sid="ACT 9:25" />A fiɗikta kimshechi'en hǝrkangndǝ tǝ tinkuɓata hur changlangta.<verse eid="ACT 9:25" /></para>
  <para style="s">Shawulu A Urshelima</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26" />Kǝ saatǝ Shawulu Urshelima, sǝkǝn i natna sǝta kǝthlǝm kǝ kǝmndǝ tǝ fa tǝrmbanda, a nakǝn natnda kanda lechanda. Fǝrundǝ kitsuwa shiɗa lǝ tǝrmbandiwa. <verse eid="ACT 9:26" /><verse number="27" style="v" sid="ACT 9:27" />Ndǝkǝn kǝstǝ Barnabas har'en, ɓakǝn tǝnda mbǝɗa fathlǝncha, paɗ mbwa'angna kandǝ kǝmmi kǝmtǝ Shawulu tǝ Lǝmwanda, a mba Dimaska tǝ witǝ shuni shunandǝ Lǝmwanda. Ngǝrkǝn ndanda kandǝ paɗwa ɓesh Shawulu tǝ alchitafa a hur thlǝm Yǝso a Dimaska. <verse eid="ACT 9:27" /><verse number="28" style="v" sid="ACT 9:28" />Sokkǝ Shawulu tǝ kanda, wu'yaǝn kandǝ nat nda hurkǝn tǝ ɗifitǝkǝn a Urshelima, nakna ɓassǝ tǝ alchitafa a hur thlǝm Lǝmwanda. <verse eid="ACT 9:28" /><verse number="29" style="v" sid="ACT 9:29" />A lanakna shundǝ tǝ Yahudawecha fa sǝk Helenanchi kǝna sǝt thlangǝtmi tǝ kanda, yahkǝndǝsi kǝ ɓǝsɗǝ mbanda mbah nanda ɓǝllangnda. <verse eid="ACT 9:29" /><verse number="30" style="v" sid="ACT 9:30" />Kǝɓat fahchikǝnna mbǝssandǝ kichu, tǝrkǝndǝndi kǝ Kaisariya, paɗ thlingkǝndǝndi kǝ Tarsus. <verse eid="ACT 9:30" /><verse number="31" style="v" sid="ACT 9:31" />Sokkǝn fa tǝrmbayi a Yahudiya tǝ Galili tǝ Samariya yu, ɓeɗnda mbǝs yuyurchita, naknda ɗǝta mban tǝ torchengnanda tǝ alchitafa, kǝthlǝm fa tǝrmbakǝn naknda wita hur lechanda Lǝmwanda. Paɗ tǝ Shemeɗ Chiɗchiɗɗa kǝssanda kandǝsi naknda chekta.<verse eid="ACT 9:31" /></para>
  <para style="s">Kǝnnafichi Iniyassa ɗi</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32" />Nak Bitrussa nata wiyandǝ mbichi somsomǝn a hurnanda, ɓakna mbǝs hwecha Fara a Lidda. <verse eid="ACT 9:32" /><verse number="33" style="v" sid="ACT 9:33" />Mbǝnniyu ɓatna mbǝssandǝ nifi la atndǝwa Iniyas, ndukka mbǝthunat hurat foɗffoɗa sheɗ sarǝchi'enaɗi. <verse eid="ACT 9:33" /><verse number="34" style="v" sid="ACT 9:34" />Ndǝkǝn ndandǝ Bitrus wa: "Iniyas, kǝnnu Yǝso Kǝrǝsti ɗi, thla'u tǝrru mbǝthunaɗeku." Chatkichuyu thlaakǝn. <verse eid="ACT 9:34" /><verse number="35" style="v" sid="ACT 9:35" />Uf nofchi naktǝ sokta a Lidda, tǝ Sharon nakndǝ Iniyas mǝla witǝhi tǝɓǝrkǝndǝhi kǝ mbǝɗa Lǝmwanda.<verse eid="ACT 9:35" /></para>
  <para style="s">Thla'a Bitrus Murǝt Tabita tǝ Shisshingtafa</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36" />Lǝ tǝrmbandǝsa Yoffa thlǝmkǝnwa Tabita le nat sakǝtkǝnwa Dokas. Kafat'ensi paɗ fǝrchin'ǝna. <verse eid="ACT 9:36" /><verse number="37" style="v" sid="ACT 9:37" />A hanmunchiniyu haɗkǝn, mǝrkǝn, fanang ficha ndǝknda ndǝfnda kǝttǝn afshi, kǝthlǝm kǝ thlohahnda. <verse eid="ACT 9:37" /><verse number="38" style="v" sid="ACT 9:38" />Lidda nakǝn nduk tǝ Yoffa. Sǝkkǝ fafǝrkit wa Bitrussa mbǝnniyu. Thlingkǝndǝ nofchi chap kǝ mbǝɗ'en ndatwa: "Komkom weshu ɓana mbǝs kani nga tǝ kǝfatichitfuwa." <verse eid="ACT 9:38" /><verse number="39" style="v" sid="ACT 9:39" />Thlaakǝ Bitrus pǝɗakndǝ tǝ fichile thlintǝnda. Kǝ saatǝn, ɗǝkndǝtǝnda hurǝ afshitǝkǝn. Kǝttǝnkǝn nihiɗaɗi tǝ ndǝlat nishchi fichile mǝrtǝ hishchengnanda, kanda tita paɗ cheɗangndǝ njelechi tǝ tahhǝt ichi 'yahmandǝ Dokas tǝkǝna kandǝsi, thlahɓǝndǝ natǝn tǝ kanda. <verse eid="ACT 9:39" /><verse number="40" style="v" sid="ACT 9:40" />Chang Bitrus nofchakissha kǝttǝnkǝn uf, sǝkkǝn kurumchihi, hwankǝn. Kǝ tuɓwandǝn hwakǝn, tǝɓǝrkǝnhi fa murutkǝn ndakǝnwa: "Tabita, thla'u." Chatkichuyu inaǝn hwanichihi, kǝ natǝn Bitrus, thlaakǝn ɗas. <verse eid="ACT 9:40" /><verse number="41" style="v" sid="ACT 9:41" />Kǝskǝ Bitrus har'en thla'aǝn. Ndǝkǝn atǝn ndǝlat nishchi mǝrtǝ hishchengnandǝyu, nat tǝ fafǝrkit, fǝraǝn Tabita tǝkǝnna kanda tǝ shisshingtafa. <verse eid="ACT 9:41" /><verse number="42" style="v" sid="ACT 9:42" />Kusheng shiwunkǝn fankǝnhi a Yoffa nat, paɗ nofchǝ terchin fǝrkǝkit kǝ mbǝɗa Lǝmwanda. <verse eid="ACT 9:42" /><verse number="43" style="v" sid="ACT 9:43" />Sokkǝ Bitrus hi a Yoffa tǝkǝn hanmunchi kaǝn, hura'a Saminu lǝ tahhasǝ pomcha.<verse eid="ACT 9:43" /></para>
  <chapter eid="ACT 9" />
  <chapter number="10" style="c" sid="ACT 10" />
  <para style="s">Bitrus Tǝ Karniliyus</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1" />Nifǝsa a Kaisariya thlǝmkǝnwa Karneliyus. Kapat nifa a mbǝt thlǝrhwata Italiyacha la atfichiwa: "Hum'i'nda fa thlǝrhwecha Italiya." <verse eid="ACT 10:1" /><verse number="2" style="v" sid="ACT 10:2" />Mǝlan lǝ tǝrmbanda Fara, paɗ lalechengna Fara, mǝlan tǝ nofchi'enna huraa'en. La fǝraǝn icha nofcha tǝ har chaa, paɗ la nakna hwanandǝ Farǝ noknok. <verse eid="ACT 10:2" /><verse number="3" style="v" sid="ACT 10:3" />Farǝle tǝ farǝhufta hanthlǝkkǝn mǝkkan, nakǝn mala'ika Fara ndaa hursǝnnata mǝla ɓata mbǝsndi, ndaǝnwa: "Karneliyus." <verse eid="ACT 10:3" /><verse number="4" style="v" sid="ACT 10:4" />Kǝllang Karneliyus tǝ lechitafa, ndakǝnwa: "Mi, Lǝmwanda?" Ndǝkǝn ndandǝ mala'ikawa: "Hwandeku tǝ fǝr'ǝnneku shee'a mbǝɗa Fara, ǝnat kuɗuktǝhar a mbanitǝ Fara. <verse eid="ACT 10:4" /><verse number="5" style="v" sid="ACT 10:5" />Nakǝnya, thlǝnu nofchǝ kǝ Yoffa kǝ andǝ Saminu lelǝ atfichiwa Bitrus. <verse eid="ACT 10:5" /><verse number="6" style="v" sid="ACT 10:6" />Nakna sokta mbǝɗa Saminu lǝ tahhasǝ pomcha, le nat huraa'ena mi hawurta." <verse eid="ACT 10:6" /><verse number="7" style="v" sid="ACT 10:7" />Kǝ pǝɗat mala'ika ti shunangyu, ak Karneliyus nofchihar chap a hur mafechi'en, fa sa tora huraa'en, tǝlǝ thlǝrhwata lela lechangnga Fara, hur fichile lǝ sang tor kǝnding. <verse eid="ACT 10:7" /><verse number="8" style="v" sid="ACT 10:8" />Mbwa'aǝn chikama kanda, thlǝnkǝn kanda Yoffa.<verse eid="ACT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9" />Ɓingǝtkǝn, nofchi thlǝntǝ Karneliyusyu ndukndǝhi kǝ hurhura'a, pǝɗak Bitrussa hurǝ afshi, ɗǝkna nata hwanda a hurfara. <verse eid="ACT 10:9" /><verse number="10" style="v" sid="ACT 10:10" />Nak mita fi'en, paɗ yahkǝnsa sǝm'ǝna, ficha nǝha'ǝna chat yimkǝnna hur ǝn nda sǝnnata. <verse eid="ACT 10:10" /><verse number="11" style="v" sid="ACT 10:11" />Nakǝn afshi inhi, ǝna ɓatahai nda kapat ɗǝ supta, firficha hai tǝ kukuwunchi'en fwaɗɗa. <verse eid="ACT 10:11" /><verse number="12" style="v" sid="ACT 10:12" />I sǝka ɗǝhǝrǝmta neesa hurkǝn, fa sarǝchǝsǝ fwaɗɗa, tǝ fa kah hurcha hachahaya tǝ ɗishcha. <verse eid="ACT 10:12" /><verse number="13" style="v" sid="ACT 10:13" />Sǝkkǝn ɓurata ndanduwa: "Thla'u, Bitrus: thliu ɓurata kǝ chiina." <verse eid="ACT 10:13" /><verse number="14" style="v" sid="ACT 10:14" />Ndǝkǝn ndat Bitruswa: "Auwa Lǝmwanda, kǝthlǝm tamwi chi i nguchik chiɗchiɗ ndu ndǝɗuwowa." <verse eid="ACT 10:14" /><verse number="15" style="v" sid="ACT 10:15" />Ngǝrkǝn sǝk ɓuraɗiyu i chapatǝkǝn ndatwa: "I tahsandǝ Farǝhi tamina ndatwa nga chiɗchiɗwa." <verse eid="ACT 10:15" /><verse number="16" style="v" sid="ACT 10:16" />Kurɓang iniyu sǝt mǝkkan. Chat kichuyu kahang fichi ǝnatkǝnaɗi kǝ afshi. <verse eid="ACT 10:16" /><verse number="17" style="v" sid="ACT 10:17" />Nak Bitrussa hur ɓweechitfat kaǝn, kǝ ɗar i'ni nda sǝnnatiyuwa nakna sokta mi? Chat nofchi thlǝntǝ Karneliyusyu sheenda hura'a Saminu, thlerkǝndǝhi kikkita mimbangnga. <verse eid="ACT 10:17" /><verse number="18" style="v" sid="ACT 10:18" />Akndǝfata sahkǝnda, nifi la atfichiwa Saminu Bitrusyu, ndu tǝrkǝna haya mbǝnniyu. <verse eid="ACT 10:18" /><verse number="19" style="v" sid="ACT 10:19" />Kǝnat Bitrussa yarandǝ i'nihi nda sǝnnatiyu, ndang Shemeɗwa: "Sǝku, ɓeɗ nofchǝ mǝkkan kanda katsa. <verse eid="ACT 10:19" /><verse number="20" style="v" sid="ACT 10:20" />Thla'u, tǝruhaya, kǝ pǝɗuni tǝ kanda, mǝ ndǝrminǝwa kǝthlǝm njang thlǝngkǝ kanda." <verse eid="ACT 10:20" /><verse number="21" style="v" sid="ACT 10:21" />Ndǝkǝn tǝrtǝ Bitrussa hai kǝ mbǝɗa nofchiyu, ndakǝnwa: "Njangya njang natuni kata. Kǝthlǝm mǝ ɓatuni?" <verse eid="ACT 10:21" /><verse number="22" style="v" sid="ACT 10:22" />Ndǝkǝn ndatndǝwa: "Karneliyus kapat nifa a Romacha thlǝngkǝkani. Kanifǝ nakǝn, paɗ lǝ mwana'ǝn Farǝ noknok, Yahudawechǝ nat la fǝrangndǝ mwanda. Chiɗchiɗ tǝ Mala'ikachǝ ndangwa, kǝ thlǝnukǝn fata kǝ ɗina huraa'en kǝthlǝm kǝ sǝkǝn i natu mbuta." <verse eid="ACT 10:22" /><verse number="23" style="v" sid="ACT 10:23" />Sang Bitrus marapa kanda, ndangna kandǝwa kǝ hunandǝhi ke wenmbǝta. Ɓingǝtkǝn, thlaakǝn pǝɗakndǝ tǝ nochiyu, funǝ hwanmanchisa Yoffa ndǝfkǝndǝndi. <verse eid="ACT 10:23" /><verse number="24" style="v" sid="ACT 10:24" />Saakǝnda Kaisariya ɓingǝtkǝn. Karneliyus mǝla pukanda, paɗ ngomandǝ hwanmanchikǝn tǝ shikechikǝn. <verse eid="ACT 10:24" /><verse number="25" style="v" sid="ACT 10:25" />Kǝnat Bitrussa yimta hurǝkǝn, sang Karnǝliyus marapa, himkǝna mbanitǝkǝn nakna mwananda. <verse eid="ACT 10:25" /><verse number="26" style="v" sid="ACT 10:26" />Thla'ang Bitrus, ndaǝnwa: "Thla'u, njangma nifǝnaki nda sokǝn." <verse eid="ACT 10:26" /><verse number="27" style="v" sid="ACT 10:27" />Bitrussa ɗar shundǝ tǝndi yimkǝnda huri, ɗǝknda mbǝstǝ hwim nofchǝ oi. <verse eid="ACT 10:27" /><verse number="28" style="v" sid="ACT 10:28" />Ndangna kandǝwa: "Kunang tǝ inchengnuni shinuniwa, keekesuwa lǝ Yahudawat kǝ sǝn shikechit ndu kǝ humndǝhi tǝ punofchǝwa. Farǝ cheɗikǝwa mǝ tǝrǝndi chikawun wa nga chiɗchiɗwowa. <verse eid="ACT 10:28" /><verse number="29" style="v" sid="ACT 10:29" />Ndǝkǝn sǝk ɓati kaɗi katfichinji a cherwifǝwa. Mbwa'amitǝn i sǝk thlǝnitunifata: <verse eid="ACT 10:29" /><verse number="30" style="v" sid="ACT 10:30" />Ndǝkǝn ngǝrtǝ Karneliyus sǝwa: "Munǝ fwaɗɗa mbǝrkǝhiyu nja hwandǝ hure'engna, hanthlǝkkǝn mǝkkan i farǝhufta a hure'engna, ɓak nifa mbǝsnji tǝ furnjelechafa lela tǝrang hwanita, thlarkǝnhi mbanitina. <verse eid="ACT 10:30" /><verse number="31" style="v" sid="ACT 10:31" />Ndakǝnwa, Karneliyus, ngǝmma Farǝ hwaɗeku tǝ fǝr'ǝneku, shokka ǝnat kuɗukta mbǝɗa Fara. <verse eid="ACT 10:31" /><verse number="32" style="v" sid="ACT 10:32" />Kǝthlǝm ndǝkǝn, thlǝnu nifi nakǝnya kǝ Yoffa kǝ afichi Saminu lǝ atfichiwa Bitrusyu, tǝrkǝna haya a hura'a Saminu lǝ tahhasǝ pomcha, nduk tǝ mi hawurta.' <verse eid="ACT 10:32" /><verse number="33" style="v" sid="ACT 10:33" />Chat kǝ thlǝnuti fata, a ndǝrmunǝwa ɓaku. Nakǝnya kanang naka mbǝɗya, nakani mbanitǝ Fara, kǝ sǝkani i fǝrrutǝ Lǝmwanda kǝ mbwa'angna kani."<verse eid="ACT 10:33" /></para>
  <para style="s">Shik Punofchǝ Kusheng Kwescha Shunda</para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34" />Ndǝkǝn tǝrkaatǝ Biturssa shunandǝ kandǝ tǝ ndatwa: "Nakǝnya ɓǝsaɗi tǝ ndatwa Farǝ taɗuharwa. <verse eid="ACT 10:34" /><verse number="35" style="v" sid="ACT 10:35" />La thlǝkǝn fichile lalechanga, tǝ fichile la sǝk i nak keeke kǝ ɓǝɗa nofcha. <verse eid="ACT 10:35" /><verse number="36" style="v" sid="ACT 10:36" />Shinuniwa shuniya thlǝnkǝ Fara mbǝɗa Isra'ilawecha, ficha ɓassa kashuwun yuyurchita kandǝsi tǝ mbǝɗa Yǝso kǝrǝsti. Le naka Lǝmwandǝ nat. <verse eid="ACT 10:36" /><verse number="37" style="v" sid="ACT 10:37" />Shikuni i sǝka a hachahai Yahudiya nat, tǝrkata a hachahai Galili, ɗifitǝ ɓassǝ baptismati sǝt Yohanna. <verse eid="ACT 10:37" /><verse number="38" style="v" sid="ACT 10:38" />Paɗ shinuni kusheng Yǝso Lǝnazaratta, witǝ i sǝt Farǝ kǝ ɗarkǝn fǝrandǝn Shemeɗ Chiɗchiɗ tǝ alchita. Ɗǝk Yǝso mban tǝ ka torcha, mǝla kǝnadǝ nofchandǝ nat fichile kǝsti Sheɗan har, kǝthlǝm Farǝ tǝndi. <verse eid="ACT 10:38" /><verse number="39" style="v" sid="ACT 10:39" />Kanang na shetacha, kǝthlǝm neɗani ichi sǝttǝn nat a Yahudiya tǝ Urshelima. Ɓǝllangnda tǝ mba kukwandǝhi ɗar palita. <verse eid="ACT 10:39" /><verse number="40" style="v" sid="ACT 10:40" />Thla'ang Farǝ tǝ shisshingtafa a farǝ mun mǝkkatǝkǝn. Malaǝn paɗ kǝ cheɗin fat'en. <verse eid="ACT 10:40" /><verse number="41" style="v" sid="ACT 10:41" />Cheɗutǝ fat'en kǝ mbǝɗa nofchi natwa, paɗ kǝ mbǝɗa fichile taɗtǝ Farǝ har kǝ soh, kanang hacha, sǝmkǝ'ǝn tǝ sat'ǝn tǝndi ɗiffitǝ thlatǝ'ena kwata. <verse eid="ACT 10:41" /><verse number="42" style="v" sid="ACT 10:42" />Fǝraǝn tora kani kǝ ɓasangani nofchisi chika tǝteni, paɗ kǝ cheɗani tǝ kitwa, Yǝso mǝlan taɗtǝ Fara lǝ thlakita chikawunsa hur fa shisshingtǝ tǝ mǝmatcha. <verse eid="ACT 10:42" /><verse number="43" style="v" sid="ACT 10:43" />Mǝlan shiwuntǝ tapǝnecha inkǝn ndatwa: "Chikawun fǝrkǝkit kǝ mbǝɗ'en, na ficha kala ɓǝɓifechi'enhi hur thlǝmkǝn."<verse eid="ACT 10:43" /></para>
  <para style="s">Fǝraa Fichǝ Shemeɗ Chiɗchiɗɗa Punofcha</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44" />Nak Bitrusa hur shiwunchiniyu, ɓak Chiɗchiɗ tǝ Shemeɗa ɗar chikawun naka sǝk shiwunchi'en. <verse eid="ACT 10:44" /><verse number="45" style="v" sid="ACT 10:45" />Yahudawechǝ fa tǝrmbandǝ ɓaka Yoffa ndǝfkǝ Bitrus yu, pǝɗang ǝn kandǝfa, kǝthlǝm a thlǝr Farǝ Chiɗchiɗ tǝ Shemeɗ hi chika kǝ ɗar punofcha. <verse eid="ACT 10:45" /><verse number="46" style="v" sid="ACT 10:46" />Kǝthlǝm shikndǝ kandǝ kanda shundǝ tǝ michǝ somsomǝn, kanda mwanandǝ Fara. Ndǝkǝn sahtǝ Bitrus wa: <verse eid="ACT 10:46" /><verse number="47" style="v" sid="ACT 10:47" />"Yunisi na njat kǝ sangfichi baptisma nofchiyawa, taɓkǝn kǝ thlǝndǝ Shemeɗ Chiɗchiɗ nda i thlǝtani?" <verse eid="ACT 10:47" /><verse number="48" style="v" sid="ACT 10:48" />Ndǝkǝn ndatǝnwa kǝ sangfichi baptisma kanda a hur thlǝm Yǝso kǝrǝsti. Ɗiffitǝkǝn ndǝkǝn ndandǝnda Bitruswa kǝ chekaǝn munchi ɗimek kicha a thlǝmatnanda.<verse eid="ACT 10:48" /></para>
  <chapter eid="ACT 10" />
  <chapter number="11" style="c" sid="ACT 11" />
  <para style="s">Ɓwa'a Bitrussa Fa Tǝrmbanda Urshelima Nat I Sǝka</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1" />Fathlǝncha tǝ fa fǝrkitti naka Yahudiya, sǝkkǝndǝwa thlǝɗ punofchǝ pathla Fara. <verse eid="ACT 11:1" /><verse number="2" style="v" sid="ACT 11:2" />Kǝ ɗǝt Bitrussa Urshelima, thla'ang pǝktat Yahudawachǝfa, fichile fǝrkǝkit kǝ ɗar hesha, ndatwa: <verse eid="ACT 11:2" /><verse number="3" style="v" sid="ACT 11:3" />"Yimku hura'a punofcha fichile heshuchika sǝmku ǝn tǝ kanda" <verse eid="ACT 11:3" /><verse number="4" style="v" sid="ACT 11:4" />Mbwa'ang Bitrussa kandǝ keeke nat i sǝka. <verse eid="ACT 11:4" /><verse number="5" style="v" sid="ACT 11:5" />"Nja hǝmǝt Yoffa nja hwanda, naki'ǝn ndaa hur'sǝnnata, naki ǝna ɓata haya hur'afshi nda kapat ǝnat supta, firficha haya hur'afshi tǝ kukuwunchi'en fwaɗa, saakǝn nduk tǝnji. <verse eid="ACT 11:5" /><verse number="6" style="v" sid="ACT 11:6" />Kǝ kǝlandi nduk a naki ɗǝhǝrǝmcha, tǝ hanthlucha hurhwela'a tǝ fa kah hura hachahaya tǝ ɗishcha. <verse eid="ACT 11:6" /><verse number="7" style="v" sid="ACT 11:7" />Sǝkki ɓurata nditǝwa: "Thla'u, Bitrus: ɓǝllu kǝ chiina.' <verse eid="ACT 11:7" /><verse number="8" style="v" sid="ACT 11:8" />Ndakiwa auwa Lǝmwanda, tamu kohat ǝnkichu ndu i nguchik ndiichina yimta hurmiyengnuwa. <verse eid="ACT 11:8" /><verse number="9" style="v" sid="ACT 11:9" />Ngǝmang ɓurata hur'afshi, shuwunkǝn i chapatǝkǝn, ndatwa: "I sǝt Farǝ chiɗchiɗ kǝ ndǝnuwa ndǝɗuwowa.' <verse eid="ACT 11:9" /><verse number="10" style="v" sid="ACT 11:10" />Kurɓang iniyu sǝt mǝkkan, kana ficha ngǝr kahanda hur'afshi. <verse eid="ACT 11:10" /><verse number="11" style="v" sid="ACT 11:11" />Chatkichuyu ɓak nofchǝ mǝkkan kǝ huri'i natanisi, thlǝntǝ fichǝ kanda a Kaisariya kǝ mbǝɗengna. <verse eid="ACT 11:11" /><verse number="12" style="v" sid="ACT 11:12" />Ndak Shemeɗ Chiɗchiɗwa, kǝɗi tǝ kanda mǝtaɗiɗiharwa. Ɗǝfkǝ hwanmanchǝ nji tehhethl, yimkani hura'a nifikǝn. <verse eid="ACT 11:12" /><verse number="13" style="v" sid="ACT 11:13" />Mbwa'angna kani naɗi natǝn mala'ika kitta hura'en ndakǝnwa, 'Thlǝnu nofchǝ kǝ Yoffa kǝ afichi Saminu nat thlǝmkǝn paɗwa Bitrus: <verse eid="ACT 11:13" /><verse number="14" style="v" sid="ACT 11:14" />Mǝlan na mbu shuni na fǝru hǝrǝkta, sokǝn tǝ nofchi hure'eku nat. <verse eid="ACT 11:14" /><verse number="15" style="v" sid="ACT 11:15" />Kǝ tǝrkaati ka shunda, ɓak Chiɗchiɗ tǝ Shemeɗa hai kǝ ɗar inchengnandǝ nat nda i ɓatna hai kǝ ɗar inchengnani a tǝrkakǝn. <verse eid="ACT 11:15" /><verse number="16" style="v" sid="ACT 11:16" />Kuɗukki shunda Lǝmwanda nda i ndatǝnwa, 'Sǝk Yohanna baptisma tǝ ama, kunang nak ficha sa baptisma kuni tǝ Shemeɗ Chiɗchiɗ.' <verse eid="ACT 11:16" /><verse number="17" style="v" sid="ACT 11:17" />Sokkǝn fǝrra Fara kandǝ keeke tǝ le sandǝn kǝm, fari fǝrtǝm kit kǝ mbǝɗa Lǝmwandǝ Yǝso Kǝrǝsti, wun njang na ndanda Farǝ wa nga kichuwa?" <verse eid="ACT 11:17" /><verse number="18" style="v" sid="ACT 11:18" />Kǝ sǝktǝndǝ kichu ɓahkǝndǝ i natnda mbuta, mwanangndǝ Fara ndatwa: "Awi chika punofchima i'na Farǝ mba tǝrtǝhi kandǝsi tǝ mbǝs shisshingta."<verse eid="ACT 11:18" /></para>
  <para style="s">Fa Tǝrmbanda a Antakiya a Hur Suriya</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19" />Fichile wuwelkǝhi kǝthlǝm pwanchi thlaakǝ kǝ ɗar Istifanusyu, pǝɗakndǝ kǝ hachahai Finikiya tǝ Sayifurus tǝ hǝmǝt Antakiya, naknda ɓassa shuwunkǝna Yahudawechisǝ ɗeng nga chika wunwa. <verse eid="ACT 11:19" /><verse number="20" style="v" sid="ACT 11:20" />Funǝsa hurnanda Sayifuruscha, tǝ Sayirincha, kǝ saatǝnda Antakiya ɓassangnda punofchisi, naknda mbwa'a kweshcha kusheng shunda kandǝ kǝ ɗar Lǝmwandǝ Yǝso. <verse eid="ACT 11:20" /><verse number="21" style="v" sid="ACT 11:21" />Hara Lǝmwandǝ tǝkanda, nofchǝ oi fǝrkǝ kit tǝɓǝrkǝndǝhi mbǝɗa Lǝmwanda. <verse eid="ACT 11:21" /><verse number="22" style="v" sid="ACT 11:22" />Kusheng shuwun i sǝka, saakǝna thlǝmata fa tǝrmbanda a Urshelima, thlǝngkǝndǝ Barnabas kǝ Antakiya tǝkǝn. <verse eid="ACT 11:22" /><verse number="23" style="v" sid="ACT 11:23" />Kǝ saatǝn paɗ a neɗtǝ kafaɗi sandǝ Farǝ kanda, sǝkǝn mbǝnfat kaǝn paɗ chekaǝn alchita kandǝ tǝ ndatwa, kǝ thlarndǝ tǝ alchitafa hur fǝrkit kǝ mbǝɗa Lǝmwanda tǝ hanndǝkikechengnandǝ nat. <verse eid="ACT 11:23" /><verse number="24" style="v" sid="ACT 11:24" />Kǝthlǝm Barnabas kanifǝ nakǝn, nihǝɗaɗi tǝ Shemeɗ Chiɗchiɗ paɗ tǝfǝrkit. Chekkǝ nofchǝ oi kǝ mbǝɗa Lǝmwanda.<verse eid="ACT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25" />Pǝɗak Barnabassa Tarsus kakat Shawulu. <verse eid="ACT 11:25" /><verse number="26" style="v" sid="ACT 11:26" />Kǝ mbǝssandǝn, ɓakǝn tǝnda Antakiya. Hurata, nda Barnabas tǝ Shawulu kanda kǝmtǝ kǝ mbǝt ngǝlhwanita, kanda sakanda nofchihar oi. A Antakiya tǝrkaatǝ ficha at fa tǝrmbachǝwa Kǝrǝstacha. <verse eid="ACT 11:26" /><verse number="27" style="v" sid="ACT 11:27" />A hanmunchiniyu funǝ tapǝnechǝsi ɓaka Antakiya thlata Urshelima. <verse eid="ACT 11:27" /><verse number="28" style="v" sid="ACT 11:28" />Ərta hurnanda thlǝmkǝnwa Agabus, thlaakǝn kit shuwunkǝn tǝ alchit Shemeɗa fa ndatwa, na mita natsǝ kaǝn hur kishitǝ nat, sǝk mitǝkǝna thlahmbǝt kuturichita Kalaudiyus. <verse eid="ACT 11:28" /><verse number="29" style="v" sid="ACT 11:29" />Ndǝkǝn tǝrtǝ fa tǝrmbandǝhurwa, chikawun nan fǝr ǝna keeke a alchit'en kǝthlǝm kǝ thlǝnang ficha hwanmanchi naka hachahai Yahudiya. <verse eid="ACT 11:29" /><verse number="30" style="v" sid="ACT 11:30" />Sǝkndǝ kichu, thlǝnangnda pǝktechi mbǝnniyu tǝ hara Barnabas tǝ Shawulu.<verse eid="ACT 11:30" /></para>
  <chapter eid="ACT 11" />
  <chapter number="12" style="c" sid="ACT 12" />
  <para style="s">A Ɓǝllandǝ Yakubu Paɗ Kuɓlandǝ Bitrus</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1" />Nda mbǝt kicheeya, Hiridus kutura tǝrkaatǝn fǝrra ɓahta funǝ fafǝrkit a mbǝt ngǝlhwanita. <verse eid="ACT 12:1" /><verse number="2" style="v" sid="ACT 12:2" />Ɓǝllaǝn Yakubu hwanman Yohanna tǝ thlohta <verse eid="ACT 12:2" /><verse number="3" style="v" sid="ACT 12:3" />Kǝ natǝn ǝnatkǝn mbǝnaɗa Yahudawechǝ fa, thlaakǝn kǝssaǝn Bitrus paɗ, sǝk i'niyu a thlahmbǝt chohhǝm sǝmɗǝsǝmta le nguchit mehndǝsa fi'en. <verse eid="ACT 12:3" /><verse number="4" style="v" sid="ACT 12:4" />Kǝ kǝsandǝn muhkǝnnda pursuna, fǝrangna fathlǝrhwecha har, fathlǝrhwechǝ fwaɗa fwaɗa sakkǝn fwaɗa, tǝ yarǝwa ma mbir chohhǝmkǝnhi kana ɓattǝnda mbanitǝ nofcha. <verse eid="ACT 12:4" /><verse number="5" style="v" sid="ACT 12:5" />Kuɓlang fichǝ Bitrus kǝ hur pursuna, nak fangǝlhwanicha hwananǝndǝ Farǝ tǝkit kǝ ɗarkǝn.<verse eid="ACT 12:5" /></para>
  <para style="s">Kǝta Fichi Bitrussa Kissha Pursuna</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6" />A fiɗikiniyu manat Hiridussa chandǝ Bitrussa kish, mǝla saɓweni a thlerǝ fa thlǝrhwechǝ chap. A kǝnandǝ tǝ chalaluchǝ chap. Fa thlǝrhwatkǝn kanda ɗar tor kiikit a mimbang pursuna. <verse eid="ACT 12:6" /><verse number="7" style="v" sid="ACT 12:7" />Chatkichuyu, ɓak mala'ika Lǝmwanda thlarǝ nduktǝndi, yimkǝ ɗwachita hurkǝttǝnkǝn. Tǝkang mala'ika tǝkǝn harra Bitrus fa mumi thla'a'ǝn, ndaǝnwa: "Thla'u leɗleɗ." Chalaluchi har'enyu kwaskǝndǝhi chuthla. <verse eid="ACT 12:7" /><verse number="8" style="v" sid="ACT 12:8" />Ndǝkǝn ndandǝ mala'ika tiiyuwa: "Kǝnan ɗǝ kǝndeku kan ndiichin, kǝ panǝ pahǝmcheku." Sǝkǝn kichuyu. Ndang mala'ikawa: "Suppu ndǝ supteku fa kǝ kuwurnǝnji." <verse eid="ACT 12:8" /><verse number="9" style="v" sid="ACT 12:9" />Chekna kissha pursuna tǝkǝn nakna kuwur mala'ika tǝkǝn. Ichini natyu sǝnuwa kitwa, naǝnhiwa ǝnnda sǝnnata natna hurkǝn. <verse eid="ACT 12:9" /><verse number="10" style="v" sid="ACT 12:10" />Kǝ pǝɗandǝnda fa pumbǝtkǝnhar i tǝrkakǝn tǝ'i chapatǝkǝn saakǝnda mimbangngi sǝtfichi tǝ tǝpassa lela chetfichi chat kǝ hurhura'a, inangna kandǝsǝ ichitkǝn. Chekndakish naknda wita hurmbakǝn, chatkichuyu mala'ika tǝkǝn malkǝnndǝhi. <verse eid="ACT 12:10" /><verse number="11" style="v" sid="ACT 12:11" />Kǝ ɓat Bitrussa ndǝ kǝ hur'indi'en, ndakǝnwa: "Nakǝnya sǝntiwa tǝ kit Lǝmwandǝ thlǝngkǝ mala'ika'en, kǝ ɓa hǝrkǝta a hara Hiridus tǝ ɓǝɓi sakta Yahudawecha."<verse eid="ACT 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 12:12" />Kǝ mbǝsandǝn kichu, pǝɗakna hura'a Maryamu, man Yohanna la atfichiwa Markus, mbǝɗi humtǝ nofchǝhi oi kanda hwanda. <verse eid="ACT 12:12" /><verse number="13" style="v" sid="ACT 12:13" />Kǝ fuɗandǝ Bitrus mimbangkǝn, ɓak hwanhura'a kish kǝ nuhhweya nat thlǝmkǝnwa Roda, kǝthlǝm kǝ nan ndu wuni. <verse eid="ACT 12:13" /><verse number="14" style="v" sid="ACT 12:14" />Kǝ mbǝssandǝn kǝ ɓurata Bitrus, ngǝraǝn'in kǝ huri inawutǝ mimbangkǝnhiwa, kǝthlǝm mbǝnfata, ndangna nofchiiyuwa: "Bitrus kita mimbangnga." <verse eid="ACT 12:14" /><verse number="15" style="v" sid="ACT 12:15" />Ndangndǝwa: "Tǝrru luwurcha!" Mǝlan paɗ nakna nata ɗahanda kandǝ'in wa mǝlan. Ndǝkǝn ndatndǝwa: "Nakna nat kǝ mala'ika'en." <verse eid="ACT 12:15" /><verse number="16" style="v" sid="ACT 12:16" />Bitrus paɗ nakna nata fuɗandǝ mimbangngiyu. Kǝ inaandǝndǝ mimbangkǝnhi nakndǝ kǝ mǝlan, pǝɗang ǝn kandǝfa. <verse eid="ACT 12:16" /><verse number="17" style="v" sid="ACT 12:17" />Mǝlan paɗ thla'aǝn hara kanda kǝ ngasndǝɓa, mbwa'angna kandǝ chayi chandǝ Lǝmwanda kissha pursuna. Ndakǝnwa: "Kǝ mbwa'anguni Yakubu tǝ tahhǝt hwanmancha ichini sǝk natyu." Pǝɗakna mbǝt somǝn. <verse eid="ACT 12:17" /><verse number="18" style="v" sid="ACT 12:18" />Wendambǝta, nga hwan thlahur'indi thlaaka hurɗifitǝ fa thlǝrhwechiyuwa kǝ ɗar i kǝskǝ Bitrus. <verse eid="ACT 12:18" /><verse number="19" style="v" sid="ACT 12:19" />Kǝ kat Hiridus ndi mbǝssawuwa, nakna tawasǝ kitchitkǝnna mbǝɗa fa pukǝnhar. Fǝrkǝn mi tǝ ndatwa kǝ mbǝllangfichi kanda. Ɗiffitǝkǝn thlaakǝ Hiridus a Yahudiya pǝɗakna Kaisariya, sokkǝnna mbǝnniyu kǝ farǝyuna.<verse eid="ACT 12:19" /></para>
  <para style="s">Mǝrta Hiridus</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20" />Nakǝnya shiɓhura Hiridussa ɗi tǝ nofcha Taya tǝ Sidon. Nak nofchini kichuyu ɓaknda mbǝɗ'en, ɗiffitǝ kahhandǝ hur'inda Bilastus le nak mwanchina hura'a kutura, kǝthlǝm kǝ mbǝsndǝ sok yuyurchita paɗ la mbǝskǝndǝ ndǝsǝmta a furta Hiridus tǝkǝn. <verse eid="ACT 12:20" /><verse number="21" style="v" sid="ACT 12:21" />A farǝle fari tahsandǝ fichihi kǝmtǝ tǝ kutura, pak Hiridus njeli kuturichit'en, sokkǝna mbǝt sok kuturichita shunaǝn nofcha. <verse eid="ACT 12:21" /><verse number="22" style="v" sid="ACT 12:22" />Nofchi humkǝyu hwaknda ndatwa: "Leya nga ɓurata nifǝwa, ɓurata lura." <verse eid="ACT 12:22" /><verse number="23" style="v" sid="ACT 12:23" />Chatkichuyu tǝpkǝ mala'ika Lǝmwandǝ Hiridus hi, kǝthlǝm fǝrautǝ mwanda Farǝ wa. Mbǝnniyu cha'ang hwacha Hiridus mǝrkǝn. <verse eid="ACT 12:23" /><verse number="24" style="v" sid="ACT 12:24" />A nak shunda Fara nata fandǝhi chika tǝteni, nakna ndǝta mban nak fa fǝrkitta chekta.<verse eid="ACT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 12:25" />Kǝ tǝɓwandǝ nda Barnabas tǝ Shawulu i natnda sǝta a Urshelima, ngǝrangndǝ'in kǝ Antakiya, tahkǝndǝ Yohanna in la atfichiwa Markus.<verse eid="ACT 12:25" /></para>
  <chapter eid="ACT 12" />
  <chapter number="13" style="c" sid="ACT 13" />
  <para style="s">Teɗfichǝ Barnabas tǝ Shawulu Thlǝnfichǝ Kanda</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1" />A kǝtǝn whayi a Antakiyayu Tapǝnechǝsi tǝ malɗǝmcha, Barnabas, Samiyon la atfichǝwa pukǝn, Lushiyus le ɓaka Sayirin, tǝ Manayen, le mwantǝnda mbǝt ǝrtǝ tǝ Hiridus kutura tǝ Shawulu. <verse eid="ACT 13:1" /><verse number="2" style="v" sid="ACT 13:2" />Naknda mwananɗǝ Lǝmwanda tǝ kǝrkushimta, Ndak Shemeɗ Chiɗchiɗ wa: "Ɗǝffaam Barnabas hi tǝ Shawulu kǝllar kǝthlem tori ati kanda." <verse eid="ACT 13:2" /><verse number="3" style="v" sid="ACT 13:3" />Ɗiffitǝ kǝrkushimta tǝ hwanda sangndǝ harcha kanda in ndangnda kandǝwa pǝɗama.<verse eid="ACT 13:3" /></para>
  <para style="s">Barnabas tǝ Shawulu a Sayifurus</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4" />Kandang paɗ kǝ thlǝntǝ Shemeɗ Chiɗchiɗ kanda, pǝɗaknda hai kǝ Salukiya, thlaakǝndǝ kǝ Sayifurus hur kommbawal. <verse eid="ACT 13:4" /><verse number="5" style="v" sid="ACT 13:5" />Kǝ saatǝnda Salamis, ɓaskǝndǝ pathla Fara hur kǝtǝn humta Yahudawechǝhi. Yohanna mǝlan tǝkanda nakna kǝsanda kandǝsi. <verse eid="ACT 13:5" /><verse number="6" style="v" sid="ACT 13:6" />Kǝ wiyangndǝn hachahaikǝn nat ɓaknda Bafos, kǝmkǝndǝ tǝlǝ Yahudawata lǝ kulata, tapǝna'a lǝ lekta, thlemkǝnwa Bar Yoshuwa. <verse eid="ACT 13:6" /><verse number="7" style="v" sid="ACT 13:7" />Le humandǝndǝ i'ndǝ tǝle kǝskǝ hachahaikǝn har, Sarjiyus Bulus, mǝlan ti naka lǝ sǝn'ǝnna. Ngomna tǝkǝn akǝn nda Barnabas tǝ Shawulu, kǝthlem yahsa sǝk pathla Fara. <verse eid="ACT 13:7" /><verse number="8" style="v" sid="ACT 13:8" />Paɗ Alimas lǝ kulata (kǝthlem sakǝt thlemkǝn kichu tǝ miya Heliniyawecha), fǝrautǝ hum'inda kandǝwa, nakna katkǝ tǝpraǝn hur inda ngomnatǝkǝnhi a hur fǝrkitchiɗiniyu. <verse eid="ACT 13:8" /><verse number="9" style="v" sid="ACT 13:9" />Nakǝn Shawulu la atfichǝ paɗwa Bulus, nihiɗ tǝ Shemeɗ Chiɗchiɗ, kǝlaǝn Alimas ndongnga kǝ hur hwanita. <verse eid="ACT 13:9" /><verse number="10" style="v" sid="ACT 13:10" />Ndakǝnwa: "Sokǝn hweya sheɗan, atikretǝ ichi nak ndiichin nat. Lǝ lektǝ naku paɗ lǝ shekɗaɗǝ nofcha. Nguna malandǝ tǝɓrandǝ kitchit mbanda Lǝmwandǝhiwowa? <verse eid="ACT 13:10" /><verse number="11" style="v" sid="ACT 13:11" />Nakǝnya haraa Lǝmwanda sǝt atikrechit tǝssa, paɗ nukukomta nguna mbǝlla nat hwatfarǝwa, kǝ hanthlikchi ɗemek: "Chatkichuyu hussoɓa tǝ hulta ngǝlangndǝ hwanitǝ'en. Nakna tapta kǝna kat le na kǝssandǝsi. <verse eid="ACT 13:11" /><verse number="12" style="v" sid="ACT 13:12" />Kǝ nat ngomna tǝkǝn i sǝka fǝrkǝn kit, kǝthlem pǝɗa'ǝnatkǝnfǝ oi kǝ ɗar sakta Lǝmwanda.<verse eid="ACT 13:12" /></para>
  <para style="s">Nda Bulus tǝ Barnabas a Antakiya Hur Bisidiya</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13" />Nakǝnya Bulus tǝ shikechǝ witǝ'en, thlaakǝnda Bafos a hur kommbawal, pǝɗaknda Ferga chaa tǝ hachahai Famfiliya. Yohanna malkǝnkandǝhi ngǝraǝn inna Urshelima. <verse eid="ACT 13:13" /><verse number="14" style="v" sid="ACT 13:14" />Ɓǝrkǝɗǝhi kǝ ɓan thlata Ferga, pǝɗaknda Antakiya tǝ hachahai Bisindiya. Farǝ yipta Yahudawecha yimkǝnda kǝtǝn humta Yahudawechihi sokkǝndǝhi. <verse eid="ACT 13:14" /><verse number="15" style="v" sid="ACT 13:15" />Ɗiffitǝ changngata hur kus tǝ ɗelwercha tapǝnecha, fambanichikǝnna hur kǝtǝn humta Yahudawechikǝn, thlǝnangnda kanda ndatwa: "Hwanmancha ma shundengnunisi lena kǝssanda nofchǝsi mbwa'ama." <verse eid="ACT 13:15" /><verse number="16" style="v" sid="ACT 13:16" />Thlaakǝ Bulus kit thla'a'ǝn haraa kǝ ngas nofchǝ ɓa, ndakǝnwa: "Kunang hwanmanchǝnǝ Isra'ilawecha, tǝ kunang ti lalechangnga Fara, kam thlǝmathi. <verse eid="ACT 13:16" /><verse number="17" style="v" sid="ACT 13:17" />Fara nofcha Isra'ila, taɗkǝ kakechengnǝm teraǝn kandǝ oi. A thlahmbǝɗi natnda soktǝ nda romcha a hachahai Masar, paɗ tǝ kapat alchita chandǝn kandakish a hachahaikǝn. <verse eid="ACT 13:17" /><verse number="18" style="v" sid="ACT 13:18" />Kǝrǝskǝn<note caller="+" style="f"><char style="fr" closed="false">13:18 </char><char style="ft" closed="false">Funǝ yarechikǝn kileɗsa</char><char style="fp" closed="false" /></note> kandǝ hurat kumchit fwaɗa a hur loktara. <verse eid="ACT 13:18" /><verse number="19" style="v" sid="ACT 13:19" />Ɗiffitǝ thlǝrtandǝ hachahaichaɗǝ muɗ hur Kan'ana, fǝraǝn hachahaikǝnna Isra'ilawecha kǝ sokka innanda.<verse eid="ACT 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 13:20" />Sǝk i'ya a hur hurat aru fwaɗa tǝ kumchit ɗurman. Ɗiffitǝ ndǝkǝn fǝraǝn fa sak miya kanda kǝ thlahɓǝt tapǝnaa Samaila. <verse eid="ACT 13:20" /><verse number="21" style="v" sid="ACT 13:21" />Hwankǝndǝ kǝ fwaɗangfichǝ kutura kandǝsi, fǝrang Farǝ Shawulu kanda. Hweya Kish, kachit nda Bilyaminu, le sokkǝ kuturichit hurat kumchit fwaɗa. <verse eid="ACT 13:21" /><verse number="22" style="v" sid="ACT 13:22" />Kǝ kǝtandǝ Farǝ Shawuluhi, tha'a'ǝn Dauda kǝ sokka kuturreng nanda. Le fǝrtǝ Farǝ sheta kǝɗarkǝn ndatwa: "A mbǝshi Dauda hweya Yessi, nifǝ lǝwitǝ hanɗǝkiketengna, le na sǝt i yahti nat.' <verse eid="ACT 13:22" /><verse number="23" style="v" sid="ACT 13:23" />"Hur kachit nifǝniyu, ɓat Farǝ tǝ lena Thlǝt Isra'ilawechaɗi, Yǝso, nda i ɗǝftǝn shuwunkǝnhi. <verse eid="ACT 13:23" /><verse number="24" style="v" sid="ACT 13:24" />Ɓassa Yohanna nofchǝsǝ nat a Isra'ila kǝtǝrndǝhi, kǝ sangfichǝ baptisma kanda, kanna Yǝso ɓata. <verse eid="ACT 13:24" /><verse number="25" style="v" sid="ACT 13:25" />Kǝ nat Yohanna nduk tuɓandǝ tor'en, ndakǝnwa, lanaǝn kunihiwa wunnaki? Njang nga mǝllanwa. Auwa, yunaɓata ɗifitǝna, le sukuchitisi kǝ kwassayi sahǝtpahǝmchi'enhi." <verse eid="ACT 13:25" /><verse number="26" style="v" sid="ACT 13:26" />"Hwanmancha, kachit Ibrahim, tǝ fichile hurnuni lalechangnga Fara, kǝ mbǝɗengnǝm thlǝntǝfichǝ kusheng shuwun hǝrǝkiya. <verse eid="ACT 13:26" /><verse number="27" style="v" sid="ACT 13:27" />Nofchi nak tǝ sokta hur Urshelima tǝ fambanichengnanda, mbǝssaundǝwa mǝllanwa, paɗ sunundǝwa mǝllan shuwuntǝ tapǝnecha ɗarkǝn, la changkandǝfichǝ pwaree a farǝ yipta Yahudawecha, nǝhɗangndǝ shuwunkǝnhi tǝ kiitati thlandǝndǝsi. <verse eid="ACT 13:27" /><verse number="28" style="v" sid="ACT 13:28" />Chika mbǝssauchikndǝ tǝ chithansarǝhiyu, le kamkǝsi kǝ mǝrrǝn, chika tǝkichu hwanangndǝ Bilatus kǝ ɓǝllangficha. <verse eid="ACT 13:28" /><verse number="29" style="v" sid="ACT 13:29" />Kǝ nǝhɗandǝndǝ ichihi yaratfichǝ kǝ ɗarkǝn nat, tǝrangndahaya ɗar palita hunangnda hur kwata. <verse eid="ACT 13:29" /><verse number="30" style="v" sid="ACT 13:30" />Thla'ang Fara hur mǝmatcha. <verse eid="ACT 13:30" /><verse number="31" style="v" sid="ACT 13:31" />Munchǝ terchin mǝla cheɗafat'ena fichile ɓatndǝtǝndi, thlata Galili kǝ Urshelima, kandang naka shetachi'en nakǝnya kǝ mbǝɗa nofcha. <verse eid="ACT 13:31" /><verse number="32" style="v" sid="ACT 13:32" />Paɗ kanang ɓangngani kweshcha shuniya kuni tǝndatwa, ɗǝfshuni ɗǝffandǝ Fara shinchinǝmhi. <verse eid="ACT 13:32" /><verse number="33" style="v" sid="ACT 13:33" />Nǝhɗaɗǝngnǝm hi, kǝmnangti naka hwechengnanda, tǝ mbǝɗa thla'andǝ Yǝso a hur mǝmatcha.</para>
  <para style="p" vid="ACT 13:33">Nda i natna hur yaratkǝn, a hur chapatǝ Zabura ndatwa:</para>
  <para style="q" vid="ACT 13:33">"Sokǝn naka hwe'engna,</para>
  <para style="q2" vid="ACT 13:33">ɓukweya sokkǝ kǝ sukka."<verse eid="ACT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 13:34" />Pathlǝ thla'ai thla'andǝna hur mǝmatcha, ndatwa: "Ngu ngǝr mǝrtaɗi ndu kǝ ngǝrǝn yirata hurkwatwa." A i mbutǝnya, ni fǝrru chiɗchiɗchita tǝ kitchit mbǝs'ǝnharra Dauda. <verse eid="ACT 13:34" /><verse number="35" style="v" sid="ACT 13:35" />Kǝthlem ndǝkǝn ngǝrkǝn ndat paɗa hur Zabura tǝllewa:</para>
  <para style="q1" vid="ACT 13:35">"Ngu malandǝ le nak chiɗchiɗ kǝ yiraka hur kwatwa.' <verse eid="ACT 13:35" /><verse number="36" style="v" sid="ACT 13:36" />Kǝ mweshandǝ Dauda tori fǝrandǝ Fara, a thlahmbǝt tor'en mǝrkǝn, thlohhangficha, mbǝɗi thlohhandǝfichǝ shinchikǝn, yiraknaɗa hur kwata. <verse eid="ACT 13:36" /><verse number="37" style="v" sid="ACT 13:37" />Le thla'andǝ Fara a yirruwa. <verse eid="ACT 13:37" /><verse number="38" style="v" sid="ACT 13:38" />Kǝ sǝnnunisi hwanmancha, ndatwa tǝ mbǝɗa Yǝso natficha kalla ɓǝɓichitfechengnuni kunihi. <verse eid="ACT 13:38" /><verse number="39" style="v" sid="ACT 13:39" />Chikawun fǝrkǝkit tǝ mbǝɗ'en mbishtǝ hǝrǝkta. Hur chikamǝnat le nguchittu hǝrǝktǝ tǝ kussa Musa. <verse eid="ACT 13:39" /><verse number="40" style="v" sid="ACT 13:40" />Kǝthlem ndǝkǝn ɗǝffam'indǝsi, mǝɓi i mbutǝ Fara hur ɗelwercha tapǝnecha kǝ mbǝssǝnkuniwa ndatwa:<verse eid="ACT 13:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="ACT 13:41" />"Namma, kunang fa njirfata,</para>
  <para style="q2" vid="ACT 13:41">kǝ pǝɗang'ǝnkunifa, kǝ mǝrruni</para>
  <para style="q1" vid="ACT 13:41">kǝthlem ni sǝt tora hanmunchengnuni,</para>
  <para style="q2" vid="ACT 13:41">tori nguchittuni fǝrkitchitsi, chika mbwa'ang yuna kuni."<verse eid="ACT 13:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42" />Kǝ chetnda Bulus tǝ Barnabassa kish, hwanang nofchǝkǝn kandǝ ndatwa, kǝ ngǝrnda ɓata mbwa'a ichiniyu kanda, a farǝ yipta Yahudawechi na ɓatyu. <verse eid="ACT 13:42" /><verse number="43" style="v" sid="ACT 13:43" />Ɗiffitǝ wuwela nofchǝ hi, Yahudawechǝ oi tǝ fichile fǝrkǝ inndǝ kaǝn, kǝtǝr mbanda yahudawecha, kuwurkǝndǝ Bulus tǝ Barnabas, shunang ndǝ kanda. Paɗ ndangnda kandǝwa, kǝ ɗǝndamban tǝ nata hur kafata Fara. <verse eid="ACT 13:43" /><verse number="44" style="v" sid="ACT 13:44" />Ngǝrkǝ farǝ yipta Yahudawecha sata, sokkǝn chikawuna hur hǝmǝtkǝn, hwimndǝhi kǝthlǝm kǝ sǝkndǝ pathla Fara. <verse eid="ACT 13:44" /><verse number="45" style="v" sid="ACT 13:45" />Paɗ kǝ nat Yahudawechǝ nofchǝ oi, nǝhǝɗkǝ hanɗǝkikecheng nandaɗi tǝ sǝrǝhta, naknda halǝ'inda kǝ ɗar i'mbuttǝ Bulus, paɗ naknda njirndi. <verse eid="ACT 13:45" /><verse number="46" style="v" sid="ACT 13:46" />Bulus tǝ Barnabas shuwunkǝndǝ tǝ alchita, ndatwa: "Kunang kamkǝsi kǝ tǝrkaafichǝ ɓassa pathla Fara kunisi. Sokkǝn a cheruni, cheɗkuniwa, kamusi kǝ mbǝssuni shisshingtǝ lekǝ pwareewa, nakǝnya nani tǝɓǝrtǝhi kǝ mbǝɗa punofcha. <verse eid="ACT 13:46" /><verse number="47" style="v" sid="ACT 13:47" />Kǝthlem Lǝmwanda tepa ɗǝftǝkanisi ndakǝnwa:</para>
  <para style="q1" vid="ACT 13:47">"Ɗifikuni kǝnuni ɗwachita punofcha,</para>
  <para style="q2" vid="ACT 13:47">kǝthlǝm kǝ sokǝnwa tǝ mbǝɗengnuni nat kishita hǝrǝkta."<verse eid="ACT 13:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48" />Kǝ sǝktǝ punofchǝkǝn kichu, sǝkndǝ mbǝnfat kaǝn, tǝpaɗ mwanangndǝ shunda Fara, fichile ɓaka soktǝwa nanda mbǝs shisshingta. Le kǝpwaree fǝrkǝndǝkit. <verse eid="ACT 13:48" /><verse number="49" style="v" sid="ACT 13:49" />Fankǝ shunda Lǝmwandǝhi chikatǝteni a sǝrǝt hachahaikǝn nat. <verse eid="ACT 13:49" /><verse number="50" style="v" sid="ACT 13:50" />Yahudawecha ɗǝknda chikandǝ nischa, fa lechanda Fara, paɗ fichile la nat ficha fǝraa mwanda kanda, tǝ pǝktat nofcha hǝmǝtkǝn. Tǝrkaakǝndǝ fǝraa pwancha nda Bulus tǝ Barnabas, tǝpaɗ rǝkkǝndǝ kanda a sǝrǝt thlet hǝmtengnanda. <verse eid="ACT 13:50" /><verse number="51" style="v" sid="ACT 13:51" />Tǝpangndǝ tǝnnayiɗa sarǝchengnanda, kǝ sokka sheta ɗar inchǝngnanda, pǝɗaknda hǝmǝt Ikoniya. <verse eid="ACT 13:51" /><verse number="52" style="v" sid="ACT 13:52" />Sokkǝn fafǝrkit, nǝhhǝɗkǝndǝ tǝ mbǝnfat oi, paɗ nǝhhǝɗkǝndǝɗi tǝ Shemeɗ Chiɗchiɗ.<verse eid="ACT 13:52" /></para>
  <chapter eid="ACT 13" />
  <chapter number="14" style="c" sid="ACT 14" />
  <para style="s">Bulus tǝ Barnabas a Ikoniya</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1" />A Ikoniya, Bulus tǝ Barnabas yimkǝnda mbǝt humta Yahudawechǝhi, ɓaskǝndǝ pathla Farǝ tǝ alchitafa, tǝrkǝ nofchǝhi oi, Yahudawechǝ tǝ punofchǝ nat fǝrkǝndǝkit. <verse eid="ACT 14:1" /><verse number="2" style="v" sid="ACT 14:2" />Yahudawechi fǝruchikkit, kurtangndǝ hur i'nda punofchǝhi, sǝɓangndǝ hurɗifitǝnaɗaɗi kǝ ɗar hwanmanchinandǝ fafǝrkit. <verse eid="ACT 14:2" /><verse number="3" style="v" sid="ACT 14:3" />Bulus tǝ Barnabas tǝrkǝndǝ hanmunchǝ oi a mbǝnniyu. Kanda ɓassǝ lechitfuwa kǝɗar Lǝmwanda, lefǝrkǝ sheta tǝ shuwun kafat'en, tǝ mba sǝt ǝnnat pǝɗandǝ nofchǝfa, tǝ sakchikǝn tǝ mbǝɗengnanda. <verse eid="ACT 14:3" /><verse number="4" style="v" sid="ACT 14:4" />Nofchi naka hǝmmǝtkǝn sakkǝndǝhi, funa mbǝɗa Yahudawecha, nak funa mbǝɗa fathlǝnchǝkǝn. <verse eid="ACT 14:4" /><verse number="5" style="v" sid="ACT 14:5" />Punofchǝ tǝ Yahudawechǝkǝn, tǝ fahǝm mbanichengnanda, tahsangndǝhi wa nanda fǝrra pwancha kanda, paɗ kǝ mumuhhwangnda kandǝfa. <verse eid="ACT 14:5" /><verse number="6" style="v" sid="ACT 14:6" />Kǝ sǝkkǝndǝ i naka sǝta, rahkǝnda thlet hǝmǝt Listira tǝ Darbe, a hachahai lkoniya, tǝ tahhǝt hǝmchǝ nak nduknduk, <verse eid="ACT 14:6" /><verse number="7" style="v" sid="ACT 14:7" />a mbǝnniyu ɗǝknda mban tǝ ɓassǝ kweshcha shiwunkǝn.<verse eid="ACT 14:7" /></para>
  <para style="s">Bulus tǝ Barnabas a Listira</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8" />A Listira nifǝsi nak ɗas kǝ tǝraɗ, tamwa sǝt tor tǝ sarǝchǝ'enwa, nakǝn kichuyu kǝ ngǝttǝ'en tamwa witǝuwa. <verse eid="ACT 14:8" /><verse number="9" style="v" sid="ACT 14:9" />Nakna sǝk ɓassa Bulus, nak Bulussa kǝlandǝ ndongnga, kǝnatǝn fǝrkit'en kemsi kǝ kǝnangfichaɗi. <verse eid="ACT 14:9" /><verse number="10" style="v" sid="ACT 14:10" />I'naǝn ɓurathi kaǝn ndakǝnwa: "Thla'u thlarnǝhi kit kǝ ɗar sarǝcheku. "Thlaakǝn tǝrkaakǝn wita. <verse eid="ACT 14:10" /><verse number="11" style="v" sid="ACT 14:11" />Kǝ nat nofchi oiyu i sǝt Bulus i'nangndǝ ɓurechǝhi, ndakndǝ tǝ mi Likoniyachitwa: "Ɓeɗ luwurchahai kǝ mbǝɗengnǝm nda nofcha!" <verse eid="ACT 14:11" /><verse number="12" style="v" sid="ACT 14:12" />Ɗǝffangndǝ Barnabas wa Zeyus, Bulus paɗ wa Hermes, kǝthlem mǝlan naka kapat lǝ shuwunkǝn. <verse eid="ACT 14:12" /><verse number="13" style="v" sid="ACT 14:13" />Pǝrissa Zeyus ɗǝhhayu, le nak kapat kǝtǝn ɗǝhhakǝnna ɗifiti hǝmta, ɓakǝn tǝ lecha tǝ fitǝ icha, kǝ mimbang hǝmǝtkǝn, yahhǝnsa fǝr poffǝn'en ɓweet tǝ nofcha. <verse eid="ACT 14:13" /><verse number="14" style="v" sid="ACT 14:14" />Kǝ sǝktǝ fathlǝnchikǝn nda Barnabas tǝ Bulus i naka sǝta, thlǝthlahhangndǝ njelechengnandaɗi, rahkǝnda hur nofchiyu, thla'angndǝ ɓurata ndatwa: <verse eid="ACT 14:14" /><verse number="15" style="v" sid="ACT 14:15" />"Nofcha mǝ sǝk natuni sǝt iya?" Kanang nofchǝ nda kunang! Tǝ ɓangngani kweshcha kusheng shunda kuni, kǝthlem kǝ tǝɓrunihi, hurwitǝ ɓǝɓiɗǝsǝchiya kǝ mbǝnda Fara, le nak tǝ shisshingta, le sǝk afshi tǝ kishita, hawurta tǝ ichi nat naka hurchikǝn. <verse eid="ACT 14:15" /><verse number="16" style="v" sid="ACT 14:16" />Hursoh ti mbǝrkǝhi, malaɗǝ nofchǝ nat kǝ wii nda mbachi yahtǝnda. <verse eid="ACT 14:16" /><verse number="17" style="v" sid="ACT 14:17" />Chikka tǝ kichu malutǝ fat'en nga ǝ'nat sheta sǝwowa. Kǝthlǝm shiɗtǝ ǝnndiichin, tǝ mba fǝrra ercha kuni afshi tǝ fekchǝ ndiichin, ngalaǝn kuni tǝ ɗǝsǝmta, paɗ mǝlla fǝrra mbǝnfata kuni. <verse eid="ACT 14:17" /><verse number="18" style="v" sid="ACT 14:18" />Nat tǝ shuwunchiniyu ɓehndǝhi, kan'nda njat fǝr poffǝnti yahtǝ nofchiyu fǝrta, kǝthlǝm kandang.<verse eid="ACT 14:18" /></para>
  <para style="s">Mumuhaficha Bulus fa a Listira</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19" />Ndǝkǝn ɓat Yahudawecha a Antakiya tǝ Ikoniya, lǝmkǝndǝ nofchi ngomkǝhiyu, mumuhangnda Bulus fa, paɗ kahangnda kishsha hur hǝmǝtkǝn, naǝn kandǝhiwa miri. <verse eid="ACT 14:19" /><verse number="20" style="v" sid="ACT 14:20" />Kǝ ɓat fa fǝrkitta taurandǝhi, thlaakǝn paɗ ngǝraǝn i'nna hurhura'a. A ɓingǝtkǝn mǝlan tǝ Barnabas pǝɗaknda Darbe. <verse eid="ACT 14:20" /><verse number="21" style="v" sid="ACT 14:21" />Ɗiffitǝ ɓassǝ kwescha kusheng shiwunkǝn kǝ hǝmmǝtkǝn, mbǝskǝndǝ fichile fǝrkǝkit oi, ngǝrangndǝ'ina Listira tǝ Ikoniya paɗ tǝ Antakiya, <verse eid="ACT 14:21" /><verse number="22" style="v" sid="ACT 14:22" />Mbǝnniyu sakandǝnda nofchǝhar tǝndatwa, kǝ sokndǝ tǝ alchitafa hur fǝrkit. Chekangnda kandǝ tǝ ndatwa, tǝ sat ɓahtǝ kaǝn natma mbǝs yimta kuturichita Fara. <verse eid="ACT 14:22" /><verse number="23" style="v" sid="ACT 14:23" />Bulus tǝ Barnabas taɗangndǝ pǝktecha kandǝsi, a hur chikayen kǝtǝn hwanda, tǝmbǝɗa hwanandǝ Fara tǝ kǝrkushimta, fǝrkǝndǝ kanda hara Lǝmwanda, le fǝrtǝndǝ kitchitta mbǝɗ'en.<verse eid="ACT 14:23" /></para>
  <para style="s">Nda Bulus tǝ Barnabas Ngǝrrandǝ'ina Antakiya tǝ Suriya</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 14:24" />Ɓǝrkǝndǝhi tǝ hur Bisidiya ɓaknda hur Famfiliya. <verse eid="ACT 14:24" /><verse number="25" style="v" sid="ACT 14:25" />Kǝ ɓastǝndǝ shiwunkǝn hur hǝmǝt Ferga, pǝɗaknda hai kǝ Ataliya. <verse eid="ACT 14:25" /><verse number="26" style="v" sid="ACT 14:26" />Mbǝnniyu yimkǝnda hur kommbawal ngǝrrangndǝ'ina Antakiya, mbǝɗi soh hwanandǝ fichǝ kafata Fara kandǝsi, kǝthlǝm kǝ hǝrmǝn kandǝhar hur tori tuɓandǝndǝ nakǝnya. <verse eid="ACT 14:26" /><verse number="27" style="v" sid="ACT 14:27" />Kǝ saatǝnnda Antakiya, ngomangndǝ fa tǝr mbandakish, kǝ mbǝt ǝrta, nbwa'angnda kandǝ nat i sǝt Farǝ tǝ mbǝɗengnanda, paɗ tǝ mbayi i'nandǝn mikǝtǝn fǝrkitchithi kǝ mbǝɗa punofcha. <verse eid="ACT 14:27" /><verse number="28" style="v" sid="ACT 14:28" />Sokkǝnnda mbǝnniyu hammunchǝ oi tǝ fatǝrmbanda.<verse eid="ACT 14:28" /></para>
  <chapter eid="ACT 14" />
  <chapter number="15" style="c" sid="ACT 15" />
  <para style="s">Yarandǝ'ichǝhi a Urshelima</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1" />Ɓak funǝ nofcha a Yahudiya tǝ Antakiya, naknda sakanda fa tǝrmbandǝ har, ndatwa: "Manga tǝ heshangfichǝkuni nda i mbutǝ ɗǝssǝta Musa wa, nguni mbǝs hǝrǝktǝwa." <verse eid="ACT 15:1" /><verse number="2" style="v" sid="ACT 15:2" />Nga hwan halǝ'indǝ yimka thlerǝ nda Bulus tǝ Barnabas tǝ nofchiyuwa, harkǝ fichǝ nda Bulus tǝ Barnabas tǝ funǝ fa tǝrmbanda kǝ ɗǝnda Urshelima kǝ ɓǝɗa fathlǝncha tǝ pǝktecha, kǝthlǝm kǝ tausangndǝ shuninihiyu. <verse eid="ACT 15:2" /><verse number="3" style="v" sid="ACT 15:3" />Nofchǝ thlǝntǝfichǝyu, pǝɗangndǝ tǝ hurhuri Finikiya tǝ Samariya, naknda mbu tǝɓǝrta punofchihi kǝ mbǝɗa Fara, fǝrang ndǝ ɓǝnfata fa tǝrmbandǝ kaǝn. <verse eid="ACT 15:3" /><verse number="4" style="v" sid="ACT 15:4" />Kǝ sa'atǝnda Urshelima, fa tǝrmbanda tǝ fathlǝncha, tǝ pǝktecha sangndǝ marapa kanda, kandang paɗ mbukǝndǝ uf i sǝt Farǝ tǝ mbǝɗengnanda.<verse eid="ACT 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 15:5" />Funǝ fafǝrkitsi naka hur mbanda Farisiyawecha, thla'akǝnda ndankndǝwa: "Sokkǝn waat kǝ heshangfichǝ punofcha, paɗ kǝ ɗǝffichǝ kanda kǝ kǝsndǝ kussa Musa har."<verse eid="ACT 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6" />Fathlǝncha tǝ pǝktecha fa tǝrmbanda ngomkǝndǝhi, kǝthlem kǝ tausangndǝ shuninihiyu. <verse eid="ACT 15:6" /><verse number="7" style="v" sid="ACT 15:7" />Ɗiffitǝ shuni shiwuntǝnda ɗarkǝn kaǝn, thlaakǝ Bitrus kit ndangna kandǝwa: "Hwanmancha shinuniwa thlata tǝrkakǝn, teɗ Farǝ nja hurnuni ndatwa, tǝmbǝɗengnǝ nat punofcha ɓǝs kusheng shunda kǝ fǝrndǝkitsi. <verse eid="ACT 15:7" /><verse number="8" style="v" sid="ACT 15:8" />Fara le sǝnkǝ hanndǝkiketa cheɗkǝwa a thliiɗtǝ kanda tǝ mba fǝrra Chiɗchiɗ tǝ Shemeɗa kanda, nda i fǝrra ndǝnakani. <verse eid="ACT 15:8" /><verse number="9" style="v" sid="ACT 15:9" />Paɗ cheɗutǝ sǝmsǝmchita thlerǝnanda tǝ kaniwa, kǝ sapaɗǝn hanɗǝkikechengnandaɗi tǝɓǝɗa fǝrkit. <verse eid="ACT 15:9" /><verse number="10" style="v" sid="ACT 15:10" />Kǝthlem ndǝkǝn, mǝsǝk natuni kikeɗandǝ Fara, tǝmbǝɗa ɗǝffa rǝfta kimshechi'ena ɓur, le nguchit shinchinǝm tǝkǝmna mbǝlla tǝrta? <verse eid="ACT 15:10" /><verse number="11" style="v" sid="ACT 15:11" />Paɗ firǝm kitwa, nakma mbǝs hǝrǝktǝ tǝ mbǝɗa kafata Lǝmwandǝ Yǝso, nda i mbǝstǝnda." <verse eid="ACT 15:11" /><verse number="12" style="v" sid="ACT 15:12" />Uf nofchi ngomkǝhi ngaskǝndǝ ɓa, naknda kathlǝmmata nda Barnabas tǝ Bulus, nak nda mbu alchiɗi fǝrandǝ Fara kanda, kǝ sǝndǝ ǝnat pǝɗandǝ nofchǝ fa, tǝ ǝnat sheka'inda a hur punofcha. <verse eid="ACT 15:12" /><verse number="13" style="v" sid="ACT 15:13" />Ɗiffitǝ mweshandǝ shundǝngnanda, ngǝrkǝ Yakubu si tǝ ndakǝnwa: "Hwanmancha sǝkam nji. <verse eid="ACT 15:13" /><verse number="14" style="v" sid="ACT 15:14" />Mbwa'a Siman Bitrussa kǝm laɗi lat Fara ɓata mbǝɗa punofcha, paɗ hertǝ funǝharra hurnanda kǝthlǝm thlǝmkǝn. <verse eid="ACT 15:14" /><verse number="15" style="v" sid="ACT 15:15" />Leya ɓakna soktǝ keeke tǝ shunda tapǝnecha, nda i yarandǝ fichihi tǝndatwa,<verse eid="ACT 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ACT 15:16" />'Ɗiffitǝ ndǝkǝn ni ngǝr ɓata</para>
  <para style="q2" vid="ACT 15:16">tǝpaɗ ni ngǝr tinandǝ hura'a Dauda le hǝmkǝhi.</para>
  <para style="q1" vid="ACT 15:16">Kǝ ngǝri tinandǝ thlarǝ'enna kwarkǝn kǝnan kit.<verse eid="ACT 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 15:17" />Tahhǝt nofchi nat katnji, njang Lǝmwanda,</para>
  <para style="q2" vid="ACT 15:17">nat tǝ punofchǝ la atfichǝ tǝ thlimna,</para>
  <para style="q1" vid="ACT 15:17">ndat Lǝmwanda le sǝk i'chiya.<verse eid="ACT 15:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="ACT 15:18" />Sǝntǝ fichǝ kǝ soh.<verse eid="ACT 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19" />"Kǝthlǝm ɗǝkǝn a kǝlandengna, kamusǝ kǝ thla'am hur'inda punofchi naka tǝɓǝrtǝhi kǝ ɓǝɗa Farǝwa. <verse eid="ACT 15:19" /><verse number="20" style="v" sid="ACT 15:20" />Makǝ yarangma kandǝsi ndatwa, kǝ malangndǝ ɗǝsǝmta ɗǝhacha. Mǝsǝmindǝ chaɗnguwa, mǝsindǝ fǝllawichitwa, paɗ mǝ sǝmindǝ i ɓekrandǝfichǝ mɓurat'enwa. <verse eid="ACT 15:20" /><verse number="21" style="v" sid="ACT 15:21" />Kǝthlǝm hur soh, a thlet hǝmchǝ somsomǝn fa ɓassǝsi tǝ ɗelwercha Musa, paɗ la changngandǝ fichǝ kanda chika yen farǝ yipta Yahudawecha, a kǝtǝn hwacha ɓeshfichǝ kussa Musa, a hur chikayen hǝmta i hurechǝ terchin, tǝpaɗ la changangficha isǝka farǝ yipta Yahudawecha, a kǝtǝn humchengnanda.<verse eid="ACT 15:21" /></para>
  <para style="s">Thlǝn fa Yarandǝ Ichǝhi Yarata kǝ Ɓǝɗa Punofchi Fǝrkǝkit</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22" />Fathlenchǝkǝn tǝ pǝktecha, nat tǝ fa tǝrmbanda kǝllangndǝwa ndiichinsi, kǝ taɗɗǝ nofchihar a hurnanda, kǝ thlǝnndǝ kanda Antakiya tǝ Bulus tǝ Barnabas, fichile taɗtǝnda nda Sila tǝ Yahuda lela atfichǝndǝwa Barsaba. Kandangti naka fambanicha fafǝrkit. <verse eid="ACT 15:22" /><verse number="23" style="v" sid="ACT 15:23" />Fǝrangndǝ yarat ɗelwera kanda, kǝ ɗangnda kanda le naka ndatwa: "Kanang hwammanchǝnuni,</para>
  <para style="pmo" vid="ACT 15:23">Fathlǝncha tǝ fambanicha, kǝmbǝɗa hwammancha fichile naka punofcha, hur Antakiya tǝ Suriya tǝ Kilikiya,</para>
  <para style="pmo" vid="ACT 15:23">Ndat'ǝn kaǝn. <verse eid="ACT 15:23" /><verse number="24" style="v" sid="ACT 15:24" />A shikani wa nofchisi thlaaka hurnani, mbǝɗya thla'andǝ hur inchengnuni tǝ shuwuncha. Chika sokkǝn thlǝnwani kandǝwa, <verse eid="ACT 15:24" /><verse number="25" style="v" sid="ACT 15:25" />Hwimanihi yaraɗanihi ndiɗchinsi kǝ taɗani nofchihara hurnani, kǝ thlǝnani kanda mbǝɗengnuni, tǝ kaa shikechǝnǝm Barnabas tǝ Bulus. <verse eid="ACT 15:25" /><verse number="26" style="v" sid="ACT 15:26" />Nofchiya tepa fǝrndǝ shisshingchengnanda, kǝthlem thlǝm Lǝmwandengnǝm Yǝso Kǝrǝsti. <verse eid="ACT 15:26" /><verse number="27" style="v" sid="ACT 15:27" />Kǝthlem ndǝkǝn thlinnani Yahuda tǝ Silas, kandang tǝ inchengnanda nanda mbwa'a nda kuni tǝ miya, witǝ ǝn'ǝrta tǝ i natani yarata. <verse eid="ACT 15:27" /><verse number="28" style="v" sid="ACT 15:28" />Keekesi mbǝɗa Shemeɗ Chiɗchiɗ, tǝ kanang neɗɗaniwa ndiɗchinsi, mǝ ɗǝfaɗani kapat lǝkta kuni'inwa kǝ sherangka ichi sokkǝ waatwa: <verse eid="ACT 15:28" /><verse number="29" style="v" sid="ACT 15:29" />Kǝ lenganguni ichihi thlithlandǝficha ɗǝhacha, tǝ i'sǝka thluwa ɗǝhǝrǝmtǝ mǝrkǝ nga fwarsafǝwa, tǝ i'sǝka thluwa ɗǝhǝrǝmi ɓekrandǝfichǝ ɓurat'en. Tǝpaɗ mǝ siɗuni fǝllawichitwa. Ma hirmuni ichini haryu, nuni sǝt ichǝ ndiichin.</para>
  <para style="pmc" vid="ACT 15:29">Kǝ sokuni ngwalngwal."<verse eid="ACT 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30" />Kǝ thlǝntǝfichǝkanda, pǝɗak ndǝ hai kǝ Antakiya, ngommangndǝ fa tǝrmbanda, fǝrangndǝ yarat ɗelwer tǝkǝna kanda. <verse eid="ACT 15:30" /><verse number="31" style="v" sid="ACT 15:31" />Kǝ changngandǝnda sǝkndǝ mbǝnfata, kǝthlǝm alchiɗi chekandǝnda kanda. <verse eid="ACT 15:31" /><verse number="32" style="v" sid="ACT 15:32" />Yahuda tǝ Silas kandangti naka tapǝnechǝ paɗ, shunangndǝ kandǝ ka'ǝn, paɗ chekangndǝ alchita hwammancha, tǝ shiwunchǝ oi. <verse eid="ACT 15:32" /><verse number="33" style="v" sid="ACT 15:33" />Ɗiffitǝ hangmuncha mbǝnniyu, malkǝndǝ kandǝhi ngwalngwal, ngǝrandǝ'ina mbǝɗa fǝchile thlǝnkǝ kanda. <verse eid="ACT 15:33" /><verse number="34" style="v" sid="ACT 15:34" />Kǝllang Silaswa keekesi, mǝllan kǝ sokka mbǝnniyu. <verse eid="ACT 15:34" /><verse number="35" style="v" sid="ACT 15:35" />Bulus tǝ Barnabas tǝngkǝnda hur Antakiya, naknda sakandaɗi tǝ ɓassǝ shunda Lǝmwanda, tǝ nofchǝterchin paɗ.<verse eid="ACT 15:35" /></para>
  <para style="s">Bulus tǝ Barnabas Shekndǝhi</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36" />Ɗiffitǝ hanmuncha, Bulus ndangna Barnabas wa: "ngǝramǝn'in ɗǝmma kǝlandǝ hwanmancha hur chikayen hǝmta mbichi ɓastǝm shunda Lǝmwanda, tǝpaɗ kǝnǝm ndu nakndǝ kǝni." <verse eid="ACT 15:36" /><verse number="37" style="v" sid="ACT 15:37" />Barnabas yahkǝnsi kǝ pǝdandǝ ɓweet tǝ Yohanna, lǝ atfichǝwa Markus. <verse eid="ACT 15:37" /><verse number="38" style="v" sid="ACT 15:38" />Bulus yaraǝnhi kamusuwa kǝ pǝɗandǝ tǝle saktǝndǝhi a hur Famfiliya, tǝpaɗ chertǝn ɗǝta mbet tortǝkandǝyuwa. <verse eid="ACT 15:38" /><verse number="39" style="v" sid="ACT 15:39" />Mbenniyu thla'akǝ ɓǝɓi somsommǝnchitta hanɗǝkiketa thlerǝnanda, kǝthlǝm ndǝkǝn sakkǝndǝhi tǝ ndani, Barnabas tǝrkǝn Markus, yimkǝnda kombawal pǝɗaknda Sayifurus. <verse eid="ACT 15:39" /><verse number="40" style="v" sid="ACT 15:40" />Bulus taɗkǝn Silas, ɗiffitǝ fǝri fǝrtǝ hwanmanchǝ kanda, ƙǝ kafata Lǝmwanda pǝɗanda. <verse eid="ACT 15:40" /><verse number="41" style="v" sid="ACT 15:41" />Pǝɗak Bulus tǝhur hachahai Suriya tǝ Kilikiya, nakna cheka alchita kanda kǝtǝn hwachikǝn.<verse eid="ACT 15:41" /></para>
  <chapter eid="ACT 15" />
  <chapter number="16" style="c" sid="ACT 16" />
  <para style="s">Timoti kwiyirtǝ Bulus tǝ Sila</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1" />Bulus ɓakǝn paɗ kǝ Darbe tǝ Listira. Lǝ fǝrkitsa mbǝnniyu, thlemkǝnwa Timoti, hweya nuhnifǝ lǝ Yahudawata shinkǝn lǝ Helenawata. <verse eid="ACT 16:1" /><verse number="2" style="v" sid="ACT 16:2" />Fafǝrkitti naka Listira tǝ Ikoniya lanaknda hamndi. <verse eid="ACT 16:2" /><verse number="3" style="v" sid="ACT 16:3" />Yahkǝ Bulus kǝ ɗǝf Timoti ndi, tǝrkǝnndi tǝ paɗ hesha'ǝn, kǝthlem Yahudawechi naka mbechiniyu nat nda shinndǝwa shinkǝn lǝ Helenawata. <verse eid="ACT 16:3" /><verse number="4" style="v" sid="ACT 16:4" />Naknda ɗar pǝɗata wiikǝndǝ hǝmtǝ hǝmta, naknda mbwa'anda nofcha ichi yarandǝ fathlenchikǝnhi, tǝ pǝktecha fichile naka Urshelima, ndangnda fafǝrkitwa kǝ kuwurndǝ i yarandǝndǝhi. <verse eid="ACT 16:4" /><verse number="5" style="v" sid="ACT 16:5" />Tǝkichu nofchǝ fatǝrmbanda, chekkǝndǝ tǝ alchita hur fǝrkit, chikayen para kanda tera.<verse eid="ACT 16:5" /></para>
  <para style="s">Bulus Neɗtǝ ǝn Ndaa Hur Sǝnnata kǝ Ɗar Makidoniya</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6" />Bulus tǝ nofchi'en wiyangndǝ sǝrǝt hachahai Firijiya tǝ Galatiya, kǝthlem Shemeɗ Chiɗchiɗ njanda kanda, mǝ ɓasindǝ pathla Fara hur Asiya wa. <verse eid="ACT 16:6" /><verse number="7" style="v" sid="ACT 16:7" />Kǝ ɓatndǝ kǝ sǝrǝt hachahai Misiya, yahkǝndǝ ɗǝt tǝhur hachahai Bitiniya, chikakichu paɗ Shemeɗa Yǝso ngǝmawa kandǝsǝwa. <verse eid="ACT 16:7" /><verse number="8" style="v" sid="ACT 16:8" />Mbǝrkǝndǝhi tǝ kǝllari Misiya, pǝɗaknda hai kǝ Toruwas. <verse eid="ACT 16:8" /><verse number="9" style="v" sid="ACT 16:9" />A fiɗikkǝn ɓak ǝna ɓǝs Bulus ndaa hur sǝnata, nakǝn nifǝ lǝ Makidoniyata, kit nakna hwananda tǝ ndatwa: "Aɓu Makidoniya kǝ kǝsangnakanisi." <verse eid="ACT 16:9" /><verse number="10" style="v" sid="ACT 16:10" />Kǝ nat Bulus i'ni nda sǝnnatǝyu, chatkichuyu kakkani mbanda Makidoniya, mweshangngani tǝndatwa Farǝ nakka atkǝm, kǝ ɓassaam kweshcha shunda kandǝsi.<verse eid="ACT 16:10" /></para>
  <para style="s">Lidiya Fǝrti kit</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11" />Pǝɗakani hur kombawal, thlata Toruwas kǝ Samotiras, wendambǝt paɗ pǝɗakani Niyafolis. <verse eid="ACT 16:11" /><verse number="12" style="v" sid="ACT 16:12" />Thlata mbǝnniyu paɗ ɗǝkani Filibi, le naka kapat hǝmta Makidoniya, nat Romawecha sǝt kutǝrichitkǝn. Shiɗani hanmunchǝ ɗǝmek a hur hǝmǝɗiniyu: <verse eid="ACT 16:12" /><verse number="13" style="v" sid="ACT 16:13" />Farǝ yipta Yahudawecha, chekani kish kǝ mimbang hǝmǝtkǝn, ɗǝkani mi'ama, mbǝɗi natani yarǝwa na mbita natsi i hwanandǝ Fara, mbǝnniyu sokkanihi shunangngani nishchi ngomkǝhi. <verse eid="ACT 16:13" /><verse number="14" style="v" sid="ACT 16:14" />Ərta hur nishchi naka sǝkkani, thlemkǝnwa Lidiya, ɓakna hǝmǝt Tayatira, lǝ hiiyandi fi njelechaɗi, lǝ mwanandǝ Farǝ naken. I'nang Lǝmwandǝ hanɗǝkiketǝ'enhi, ɗǝfkǝn hur'i'nda i nat Bulussa mbuta. <verse eid="ACT 16:14" /><verse number="15" style="v" sid="ACT 16:15" />Kǝ sandǝfichǝ baptisma tǝ fichile naka huraa'en, hwanang Lidiya kani, tǝndatwa: "Ɓaknasoktǝwa ngǝmaɗuniwa njang lǝ fǝrkit kǝmbǝnda Lǝmwanda, ɓam tama hure'engna kǝ sokkunihi." Tǝkichu kahandǝn hur i'ɗǝngnani.<verse eid="ACT 16:15" /></para>
  <para style="s">Bulus tǝ Silassa Pursuna</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16" />Farǝle nakani pǝɗata mbǝt hwanda, kǝmkani tǝ mafat nuhhweya, lenat shemeɗ luwurchǝsa fi'en, la kulakǝn, tǝpaɗ la mbǝskǝn hanɗǝɓǝlta, kǝ fǝrangka nofchi naka thlǝmatkǝn, tǝ ɓǝɗa kulat'en. <verse eid="ACT 16:16" /><verse number="17" style="v" sid="ACT 16:17" />Nakna kuwur kani tǝ Bulus mǝlla hwata, ndatwa: "Nofchiya mafecha Fara le sherkǝ tǝ mwanda, kanda ɓassa mba hǝrǝkta kunisi." <verse eid="ACT 16:17" /><verse number="18" style="v" sid="ACT 16:18" />Ɗǝknamban tǝ sǝt i'niyu i mundǝ tǝrchin. Tǝkichu sǝɓkǝ hanndǝkiketa Bulussa ɗǝ kaǝn, tǝɓǝrkǝnhi ndangna shemeɗiwa: "Nja ɗǝfsǝ waat hur thlem Yǝso Kǝristi chukishsha fat'en." Chatkichuyu cheknakish.<verse eid="ACT 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 16:19" />Kǝnat fa nuhwani natna hure'engnandǝyu, resh mba mbǝs ǝ'nengnandaɗi, kǝsangndǝ Bulus tǝ Sila, tǝpaɗ kahkǝndǝ kanda milumo, ndǝkndǝ tǝ kanda mbanitǝ fichile nak tǝ kuturichit hachahaikǝna har. <verse eid="ACT 16:19" /><verse number="20" style="v" sid="ACT 16:20" />Kǝ ɗǝtndǝ tǝ kanda mbanitǝ fa sakmicha, ndakndǝwa: "Nofchiya Yahudawecha, naknda kanda shekɗa i'ndǝ hǝmtengnani. <verse eid="ACT 16:20" /><verse number="21" style="v" sid="ACT 16:21" />Kanda sakandǝ ɗǝssǝchaɗi kamuchǝksi, le kamuchiksi kanang Romawecha kǝ thlani."<verse eid="ACT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 16:22" />Ɓak terǝ nofcha humangndǝ miya kǝ ɗar walǝkanda, fa sak michikǝn thlethlahangndǝ njelecha nda Bulussa ɗi tǝ Sila, ndankndǝwa kǝ tǝpangficha kandǝ kaǝn. <verse eid="ACT 16:22" /><verse number="23" style="v" sid="ACT 16:23" />Ɗiffitǝ tǝpanda kandǝ kaǝn, somkǝndǝ kanda pursuna, ndangficha lǝ pu pursunatǝkǝn harwa, kǝ kǝlansakandǝ kaǝn, mǝninda hǝrǝkta. <verse eid="ACT 16:23" /><verse number="24" style="v" sid="ACT 16:24" />Kǝ thlǝtǝn shuwunkǝn, ɗǝkǝn tǝ kanda kakǝ hur kǝtǝn pursunatǝkǝn kǝnaǝn sarǝchengnanda thleri peh'afta.<verse eid="ACT 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25" />A ɗar fiɗikta, Bulus tǝ Sila kanda hwanda, tǝ in i'mish mwanandǝ Fara, tahǝt pursunachikǝn kanda kathlǝmmata kanda. <verse eid="ACT 16:25" /><verse number="26" style="v" sid="ACT 16:26" />Su tollǝwa, sǝkkǝfichǝ kapat hǝhǝrta kisshitǝfa, njun kǝtǝn pursuna tǝkǝn hǝhǝrkǝnfa. chatkichuyu mikǝtǝn pursuna tǝkǝn inkǝndǝhi nat, tǝpaɗ uf challaluchi kǝnandǝfichǝ pursunachikǝnsi hǝhhatkǝndahaiya. <verse eid="ACT 16:26" /><verse number="27" style="v" sid="ACT 16:27" />Kǝ thlaatǝ lǝpu pursuna tǝkǝnhar, anakǝn in mikǝtǝnchǝkǝnhi nat. Yarkǝnwa reh pursunachikǝn, kǝtkǝn thlohtǝ'en, tǝna ɓǝllandǝfat'en. <verse eid="ACT 16:27" /><verse number="28" style="v" sid="ACT 16:28" />Shuwunkǝ Bulus tǝ kapat ɓurat ndatwa: "Mǝsanǝ mboro i'ndekufuwa, kana mbǝɗya nattani." <verse eid="ACT 16:28" /><verse number="29" style="v" sid="ACT 16:29" />Lǝpu pursunatǝkǝnhar ndakǝnwa, kǝɓa fichǝ tǝ tikkesha, tǝpaɗ weshkǝna rahta hurkǝn, mǝla saktatfa tǝ lechita ɗǝkna hǝmta mbanitǝ Bulus tǝ Sila. <verse eid="ACT 16:29" /><verse number="30" style="v" sid="ACT 16:30" />Mbǝnniyu chaǝn kanda kish ndangnakandǝwa: "Famwanda, mǝnati sǝt kǝthlem kǝ mbǝsi hǝrǝkta?"<verse eid="ACT 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 16:31" />Ndangndǝwa: "Fǝrukit kǝ ɓǝnda Lemwandǝ Yǝso, nu mbǝs hǝrǝkta tǝ chikawuna hur hure'eku." <verse eid="ACT 16:31" /><verse number="32" style="v" sid="ACT 16:32" />Shunangndǝ pathla Lemwanda, nat tǝ fichile naka hur huraa'en. <verse eid="ACT 16:32" /><verse number="33" style="v" sid="ACT 16:33" />Chika nakna fiɗiktiyu, lǝpu pursunatǝkǝnhar kileɗsa kanda tǝpaɗ sapaɗǝ ndindichengnandaɗi. Chatkichuyu mǝlan tǝ fichile naka hur hura'en sangfichǝ baptisma kanda. <verse eid="ACT 16:33" /><verse number="34" style="v" sid="ACT 16:34" />Ɓakǝn tǝ kanda hur huraa'en, tǝpaɗ saǝn ɗǝsǝmta kanda mban, mǝlan tǝ fichile naka hur huraa'en, naknda sǝt mbenfata kǝthlem firndǝkit kǝmbǝnda Fara.<verse eid="ACT 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35" />Wenda mbǝta fa sak michikǝn thlǝnkǝndǝ hansǝsalchǝ ndatwa: "Kǝ kalndǝ nofchihiyu!" <verse eid="ACT 16:35" /><verse number="36" style="v" sid="ACT 16:36" />Lǝpu pursunatǝkǝnhar ndangna Bulus wa: "Ndak fa sak michikǝnwa, kǝ kalfichǝ kunihi nakǝnya, chamakis pǝɗam ngwalngwal."<verse eid="ACT 16:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37" />Ngǝrkǝ Bulussǝwa: "Tǝpangnda kani a ɓaniti nofchǝ talyar, sahhawundǝ mikaniwa, a nakǝn kanang Romawecha, paɗ pǝkkǝndǝkani pursuna. Nakǝnnya yahkǝndǝ kalǝkanihi ɓuɓweta? Auwa! Kǝ ɓanda harandǝ kanikish tǝ i'ndengnanda."<verse eid="ACT 16:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 16:38" />Kǝ ɗǝt hansǝsalchiyu mbu i'niyu, nak fa samichikǝnna lechita, ɓaknda sǝndǝwa Bulus tǝ Sila Romawecha. <verse eid="ACT 16:38" /><verse number="39" style="v" sid="ACT 16:39" />Ɓaknda tǝrandakandǝhi. Kanda harandǝ kandakish, tǝpaɗ hwanangndǝkanda kǝmalndǝ hǝmǝtkǝnhi. <verse eid="ACT 16:39" /><verse number="40" style="v" sid="ACT 16:40" />Ɗiffitǝ cheta nda Bulus tǝ Sila kishsha pursuna, ngǝrangndǝ'ina hura'a Lidiya. Humkǝndǝhi mbǝnniyu tǝ fichile fǝrkǝkit mbwa'angndǝ shuwuncha kanda, paɗ ɓaknda soktǝ tǝ alchit hanɗǝkiketa. Pǝɗaknda.<verse eid="ACT 16:40" /></para>
  <chapter eid="ACT 16" />
  <chapter number="17" style="c" sid="ACT 17" />
  <para style="s">Bulus tǝ Sila a Tassalonika</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1" />Kuwurkǝndǝ tǝ Amfibolis tǝ Afolloniya, saakǝndǝ Tassalonika kǝ mbǝɗi nat kǝtǝn humta Yahudawecha. <verse eid="ACT 17:1" /><verse number="2" style="v" sid="ACT 17:2" />Bulus yimkǝna thlǝmmatnanda nda i sǝntǝnhi, mbǝraɗ farǝ yiptǝhi mǝkkan mǝlla halǝ'i'ndǝ tǝ kanda a hur ɗelwercha Fara. <verse eid="ACT 17:2" /><verse number="3" style="v" sid="ACT 17:3" />Nakna chekanda kanda, paɗ kǝna sǝnanda kandǝsi tǝ ndatwa, keekesi kǝ saa Kǝrǝsti pwene, paɗ kǝ thlaaka hur mǝmmatcha, ngǝrkǝn ndatwa. Yǝso ti nati mbwa'andakunniya, mǝllan naka Kǝrǝsti. <verse eid="ACT 17:3" /><verse number="4" style="v" sid="ACT 17:4" />Paɗ funǝ Yahudawecha, kahhafichi hur'inchengnanda, hummangndǝ i'ndǝ tǝ Bulus tǝ Sila, kichupaɗ sǝt Helinawechǝ oi fa lechanda Fara, tǝ kichupaɗ sǝt pǝktat nischǝ oi fa mbutǝ kǝ sǝkficha. <verse eid="ACT 17:4" /><verse number="5" style="v" sid="ACT 17:5" />Nak Yahudawechikǝna sǝrǝhta, ngommang ndǝ hwanchǝ rǝnnecha a lumo. Kǝ ngomtǝnnda, tǝrkaakǝndǝ thla'andǝ hur'i'nda a hur hǝmmǝtkǝn. Yimkǝnnda hurhura'a Yason nak nda kat Bulus tǝ Sila kǝthlǝm kǝ ɓandǝ tǝ kanda mbanitǝ nofcha. <verse eid="ACT 17:5" /><verse number="6" style="v" sid="ACT 17:6" />Kǝ ɓǝssawuchitndǝ kanda, kahkǝndǝ Yason tǝ funǝ hwanmancha, ɗǝkndǝ tǝ kanda mbanitǝ fa sak miiya, nak nda hwatta kanda ndatwa: "Nofchiya naka thlahur'i'nda chika ayi hurkisshita, ɓeɗnda mbǝɗya paɗ. <verse eid="ACT 17:6" /><verse number="7" style="v" sid="ACT 17:7" />Yason thliɗtǝ kanda, ufnda kǝllundǝssa kussa Kaisarwa, ndatwa yunǝ kutursi, thlǝmkǝnwa Yǝso." <verse eid="ACT 17:7" /><verse number="8" style="v" sid="ACT 17:8" />Thlaakǝ hur'i'nda Nofcha tǝ fa sakmicha kǝ sǝktǝndǝ ichiniyu. <verse eid="ACT 17:8" /><verse number="9" style="v" sid="ACT 17:9" />Kǝ thlǝɗ ndǝ hanɗǝɓǝl punofchǝhar a harra Yason tǝ tahǝt nofcha kalkǝndǝ kandǝhi kǝ pǝɗanda.<verse eid="ACT 17:9" /></para>
  <para style="s">Bulus tǝ Sila a Biriya</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10" />Chat kǝ sǝt fiɗikta, ɗǝfkǝ hwanmancha ndǝ Bulus tǝ Sila kǝ pǝɗanda Biriya. Kǝ saatǝnda mbǝnniyu yimkǝnnda kǝtǝn humta Yahudawechihi. <verse eid="ACT 17:10" /><verse number="11" style="v" sid="ACT 17:11" />Yahudawechi naka ɓǝɗya pǝɗanda fichilehi naka Tasalonika tǝ hur'i'nda, kǝthlǝm thliɗndǝ shuwunkǝn tǝ harchǝ chap chap, lanaknda tausandǝ shunda Farǝ wembǝta kǝ nandǝ ndu i mbutǝ Bulusyu kit. <verse eid="ACT 17:11" /><verse number="12" style="v" sid="ACT 17:12" />Oiya hur Yahudawechi fǝrkǝkit, Paɗ tǝ funǝ nishchǝ Helinawecha fichile naktǝ mwanda tǝ hishchǝ paɗ. <verse eid="ACT 17:12" /><verse number="13" style="v" sid="ACT 17:13" />Kǝ sǝktǝ Yahudawechi naka Tassalonikayu, tǝ ndatwa Bulussa ɓassǝ pathla Fara a Biritiya, ɗǝknda nata chikandǝ kanda kǝnnda thla'andǝ hur'i'nda nofcha. <verse eid="ACT 17:13" /><verse number="14" style="v" sid="ACT 17:14" />Chatkichuyu ɗǝfkǝ fafǝrkit Bulus kǝ pǝɗaka mihawurta, nda Sila tǝ Timoti thlarkǝndǝhi mbǝnniyu. <verse eid="ACT 17:14" /><verse number="15" style="v" sid="ACT 17:15" />Fichile ɗǝfkǝ Bulusyu saakǝndǝ tǝndi kǝ Atina. Naknda ngǝrandǝ'in thlǝkndǝ thlǝnda ɓǝɗa Bulus ndatwa, yehsi nda Sila tǝ Timoti kǝ ɗǝnda mbǝsndǝ leɗleɗ, pǝɗaknda.<verse eid="ACT 17:15" /></para>
  <para style="s">Bulussa Atina</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16" />Kǝ nat Bulussa pu kanda a Atina, sǝɓkǝ hanɗǝkiketǝ'enaɗi kaǝn, kǝ natǝn hǝmǝtkǝn nihiɗaɗi tǝ ɗǝhhacha. <verse eid="ACT 17:16" /><verse number="17" style="v" sid="ACT 17:17" />I sǝka para la nakna halǝ'i'nda kǝtǝn humta Yahudawechǝhi kandang tǝ funǝ Helinawecha fa lechanda Fara. Chika ɓǝɗi nat lumo fichile la ɓǝlaakǝ nata ɓǝnniyu. <verse eid="ACT 17:17" /><verse number="18" style="v" sid="ACT 17:18" />Funǝsǝ paɗ Abikuriyawecha tǝ Sitokiyawecha fa mbǝr'ǝna halkǝndǝ'i'ndǝ tǝ ndi. Funengnanda ndakndǝwa: "Mǝ yahtǝ lǝ ɗaakiya mbuta?" Ndakfunǝwa: "Nda lǝɓassǝ ɗǝhhacha nofcha." "Mbukǝndǝ kichu kǝthlǝm Bulussa ɓassǝ Yǝso tǝ thlata mǝmatcha. <verse eid="ACT 17:18" /><verse number="19" style="v" sid="ACT 17:19" />Tǝrkǝndǝndi ɗǝkndǝ tǝnda ɗar Arasa, ndakndǝwa: "Ndu nu mbǝlla mbwa'andakani witǝ yuwa sakayiɗi natu sakandaɗiya? <verse eid="ACT 17:19" /><verse number="20" style="v" sid="ACT 17:20" />Kǝthlǝm ɓanǝ yuwa icha thlǝmechengnani, yahkanisi kǝ sǝnnani i naka sakchikǝn." <verse eid="ACT 17:20" /><verse number="21" style="v" sid="ACT 17:21" />Nakǝnya nat Atinawecha tǝ romchi naka mbǝɗengnanda, ǝnsǝ lǝ sǝnndǝ kǝ sherangka mbu yuwa shuwuncha tǝ sǝk yuwa icha. <verse eid="ACT 17:21" /><verse number="22" style="v" sid="ACT 17:22" />Thlaakǝ Bulus thlarkǝnhi hurɗifitǝ Arasacha, ndakǝnwa: "Kunang nofchi Atinacha, a mbǝssaɗi wa kunang fa tǝr mbandǝ chika tǝ teni. <verse eid="ACT 17:22" /><verse number="23" style="v" sid="ACT 17:23" />Kǝthlǝm manja mbǝrtǝhi tǝ hǝmǝtkǝn, lanaki ichi natuni mwananda, a naki mbǝt fǝr pofǝn tǝ yarata ɗarkǝn ndatwa: "Kǝthlǝm Fari sǝnuchit ficha. Lenatuni mwanandǝ sǝnuchituniyu, mǝllan nati mbwa'anda kuni. <verse eid="ACT 17:23" /><verse number="24" style="v" sid="ACT 17:24" />Fara letinkǝ kisshita tǝ ichinaka hurkǝn uf, mǝllan naka Lǝmwanda afshi tǝ kisshita, shokwa kǝtǝn kapat hura'a Farǝ letintǝ nifǝwa. <verse eid="ACT 17:24" /><verse number="25" style="v" sid="ACT 17:25" />Kichu paɗ ɓahwa kat nifǝ kǝ kǝssaansǝ tǝ harchǝ'enwa, ɓahwa yah ǝnwa, kǝthlǝm mǝllan tǝ i'ndi'en la fǝrang shisshingta nifa, tǝ yipta tǝ ichi natna yahtǝ nat. <verse eid="ACT 17:25" /><verse number="26" style="v" sid="ACT 17:26" />Mǝllan paɗ tinkǝ yakat terǝ nofcha tǝ mbǝɗa nifǝ ǝrta, kǝthlǝm kǝ soknda hur kisshitǝ nat, tahsaǝn sǝrǝt naɗengnandǝhi, tǝ sǝrǝt hǝmchengnanda. <verse eid="ACT 17:26" /><verse number="27" style="v" sid="ACT 17:27" />Sǝk Farǝ kichuyu kǝthlǝm kǝ kandǝndi, mbahya nanda taptǝ kǝ mbǝssangnda, chika sokkǝn nga nakǝn langngǝ tǝkǝmwa. <verse eid="ACT 17:27" /><verse number="28" style="v" sid="ACT 17:28" />Kǝthlǝm: "Tǝ mbǝɗ'en natǝmhi, lanatma yipta, paɗ tǝ mbǝɗ'en mwaatǝmhi. Nda i mbutǝ funengnuni fa at imshi ndatwa: "Kitchitkǝn, kǝmnang ma witǝkǝn nakǝm.' <verse eid="ACT 17:28" /><verse number="29" style="v" sid="ACT 17:29" />"Nakǝn kǝmnang witǝ Fara, kamusi kǝ yarǝm tǝ ndatwa Farǝ nakǝn nda zinariya ndu azurfa ndu ngwiya, le tahhǝstǝ nifǝ tǝ ɗathlǝ'enwa. <verse eid="ACT 17:29" /><verse number="30" style="v" sid="ACT 17:30" />A hur soh tǝrra Farǝ chumwandǝ'enaɗi a ɗar tor ɓomchita. Nakǝnya mbwa'aɗa nofchǝ nat, chika tǝ tee'ǝn kǝtǝrndǝhi. <verse eid="ACT 17:30" /><verse number="31" style="v" sid="ACT 17:31" />Kǝthlǝm tahsaɗǝ farihi natna ɓata sa kiita kisshitǝsi, i kitchitkǝn tǝ mbǝɗa nofchi tahsaɗǝnhi, kǝthlǝm ndǝkǝn firtǝ kitchitkǝn kǝ mbǝɗa chika wunni, tǝ thla'a nda hur mǝmatcha." <verse eid="ACT 17:31" /><verse number="32" style="v" sid="ACT 17:32" />Kǝ sǝktǝndǝ shuwun thlata mǝmatcha, funengnanda njirkǝndǝndi, ndak funǝ paɗwa: "Yahkani kǝ ngǝrani sǝk i natu mbuta kǝ ɗar shuniya paɗ." <verse eid="ACT 17:32" /><verse number="33" style="v" sid="ACT 17:33" />A mbǝnniyu saktǝ Bulushi tǝ kanda ɓǝɗakǝn. <verse eid="ACT 17:33" /><verse number="34" style="v" sid="ACT 17:34" />Funengnanda ngǝrang ndǝ'ina mbǝɗa Bulus, fǝrkǝndǝ kit. A hurnanda Diyonisiyus, lǝ sakmicha, tǝ nuhnifa le nat thlǝmkǝnwa Damaris, tǝ funǝ paɗ fichile naka thlǝmatnanda.<verse eid="ACT 17:34" /></para>
  <chapter eid="ACT 17" />
  <chapter number="18" style="c" sid="ACT 18" />
  <para style="s">Bulussa Korinti</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1" />Ɗiffitǝ ndǝkǝn, malkǝ Bulus Atinahi pǝɗakna Korinti. <verse eid="ACT 18:1" /><verse number="2" style="v" sid="ACT 18:2" />Kǝmkǝndǝ tǝ lǝ Yahudawata mbǝnniyu nat thlǝmkǝnwa Akila lǝ Fontusta. Le ɓak nakǝnya a Italiya, kandang tǝ nuhkǝn le nat thlǝmkǝnwa Biriskila, kǝthlǝm Kalaudiyus firtǝ kus ndatwa nat Yahudawecha kǝ malndǝ Romahi. Ɗǝk Bulussa mbǝskanda. <verse eid="ACT 18:2" /><verse number="3" style="v" sid="ACT 18:3" />Nakǝn tor harengnandǝ ǝrtǝ tǝ nofchiyu, tor tahhasǝ tenti, sokkǝnna thlǝmatnanda naknda sǝt torra. <verse eid="ACT 18:3" /><verse number="4" style="v" sid="ACT 18:4" />I'sǝka farǝ yipta Yahudawecha, la yimkǝna kǝtǝn humta Yahudawecha, a la nangna kahandǝ hur'inda Yahudawechǝ tǝ punofcha.<verse eid="ACT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5" />Kǝ ɓaɗnda Sila tǝ Timoti a Makidoniya, ɓaknda mbǝs Bulus firtǝ fat'enna ɓassa, mǝlla cheɗanda Yahudawecha tǝ kitwa, Yǝso naka Kǝrǝsti. <verse eid="ACT 18:5" /><verse number="6" style="v" sid="ACT 18:6" />Halangndǝ'i'nda nak nda i'erandǝfa, tǝppaǝn njelechi'ennaɗi ndangna kandǝwa: "Hekke tǝ fwarchengnuni tǝ inchengnuni! njang cheɗikish. Thlata nakǝnya kǝ mban ɗǝki mbǝɗa punofcha." <verse eid="ACT 18:6" /><verse number="7" style="v" sid="ACT 18:7" />Malkǝn mbǝnnihiyu pǝɗakna hura'a nifǝ lǝ atfichiwa Titiyus Yustus, lǝmwanandǝ Fara, huraa'en nduk tǝ mikǝtǝn humta Yahudawecha. <verse eid="ACT 18:7" /><verse number="8" style="v" sid="ACT 18:8" />Kirisbus, kappat nifa mbǝt humta Yahudawecha, fǝrkǝn kit kǝmbǝɗa Fara, kandang tǝ nofchi huraa'ennat. Korintiyawechi oi sǝkkǝ ɓassa Bulus, fǝrkǝndǝkit sanfichǝ baptisma kanda.<verse eid="ACT 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9" />Farǝle fiɗikta, chenɗang Lǝmwanda Bulus hur'ǝn nda sǝnnatawa: "Mǝlechinuwa, ɗumban tǝ ɓasseku paɗ mǝngasinǝ ɓaawa, <verse eid="ACT 18:9" /><verse number="10" style="v" sid="ACT 18:10" />Kǝthlǝm njangtǝsa, paɗ nifǝsǝ na walǝsa kǝ sukǝn'ǝnwa, kǝthlǝm nofchengnǝsi oi hur hǝmmǝɗiya." <verse eid="ACT 18:10" /><verse number="11" style="v" sid="ACT 18:11" />Sokkǝ Bulushi mbǝnniyu, hurat'ǝrta tǝ ndǝraa tehethl, mǝlla sakandǝ pathla Fara ɗi a hurnanda.<verse eid="ACT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12" />A fari nat Galiyo sǝt kuturichita furǝt Akaya, thla'ang Yahudawechǝ Bulussafa, ɓakndǝtǝnda mbanitǝ fasakmiya. <verse eid="ACT 18:12" /><verse number="13" style="v" sid="ACT 18:13" />Ndakndǝwa: "Nifiya mǝlla kahhandǝ hur'i'nda nofcha, kǝ mwanangndǝ Fari nguchik keeke tǝ kus."<verse eid="ACT 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 18:14" />Kǝ nat Bulus nduk kǝ shunǝn, ndǝkǝn ndandǝ Galiyo Yahudawechǝkǝnwa: "Makǝthlǝm sǝt'ǝn nduɗuwa ndu kapat ɓǝɓi'ǝna, mani kathlǝmmatakuni. <verse eid="ACT 18:14" /><verse number="15" style="v" sid="ACT 18:15" />Nakǝn pathlǝ sahmi kǝ ɗar shuwuncha, tǝ thlǝmcha tǝ paɗ kus engnuni, kǝllamǝn kunang tǝ inchengnuni. Njang ngi mbǝlla thlandǝ shundǝhi kǝ ɗar witǝ ichiyawa." <verse eid="ACT 18:15" /><verse number="16" style="v" sid="ACT 18:16" />Rǝkkǝn kanda kǝtǝn sakmikǝn. <verse eid="ACT 18:16" /><verse number="17" style="v" sid="ACT 18:17" />Nat nda kǝsangndǝ Sostanus lǝhǝm mbanita a mbǝt humta Yahudawechǝhi, tǝppangnda a mbanitǝ fa sakmikǝn. Kǝmmawuchik'ǝn Galiyo kǝ ɗar i'sǝtnda<verse eid="ACT 18:17" /></para>
  <para style="s">Ngǝraa Bulus Ina Antakiya Ɗǝkǝn chaa tǝ Hur Suriya</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18" />Ɗiffitǝ ndǝkǝn sokkǝ Bulushi hanmunchǝ oi tǝfafǝrkit a mbǝnniyu, ndangna kandǝwa nan malǝkandǝhi, a yimkǝnna kommbawal, ɓǝɗakna Suriya kandang tǝ Biriskila tǝ Akila. Kǝ saatǝnda Kankiriya, hǝsaǝn hwasǝ indǝ'enaɗi, kǝthlǝm kǝ nǝhɗaǝn shunihi mbuɗtǝn. <verse eid="ACT 18:18" /><verse number="19" style="v" sid="ACT 18:19" />Saakǝnda Afisa, malkǝn Biriskila tǝ Akila mbǝnniyu, mǝllan tǝ i'ndǝ'en yimkǝnna kǝtǝn humta Yahudawechihi, nakna tausandǝ shuwunkǝn tǝ Yahudawechikǝn. <verse eid="ACT 18:19" /><verse number="20" style="v" sid="ACT 18:20" />Hwanangndǝwa kǝ sokka mbǝnniyu hanmunchǝ oi, cherkǝnfa. <verse eid="ACT 18:20" /><verse number="21" style="v" sid="ACT 18:21" />Nakna pǝɗata ndangnakanduwa: "Ni ngǝrandǝ'inna mbǝɗengnuni ma ngǝmma Fara." Yimkǝnna kommbawal pǝɗakna Afisa. <verse eid="ACT 18:21" /><verse number="22" style="v" sid="ACT 18:22" />Kǝ tǝrtǝnahaya a Kaisariya, pǝɗaknashi ɗǝkna nda'ǝnna fa tǝrmbanda, pǝɗatahai kǝ Antakiya.<verse eid="ACT 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 18:23" />Ɗifitǝ munchi sǝtna mbǝnniyu, thlaakǝn wiyaan furǝt Galatiya tǝ Firijiya nakna kuwur hǝmtǝ hǝmta, kǝna cheka alchita fa tǝrmbandǝ nat.<verse eid="ACT 18:23" /></para>
  <para style="s">Ɓesh Afolos tǝ Alchitafa a Afisa</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24" />Lǝ Yahudawatsi thlǝmkǝnwa Afolos ɓaka Afisa. Mǝllan lǝ Iskandariyatǝ nakǝn. Lǝ mbǝr shunda shintǝ'ǝnkaǝn, nat tǝ yarat shunda Fara. <verse eid="ACT 18:24" /><verse number="25" style="v" sid="ACT 18:25" />Sakafǝchǝ pathlǝ mbanda Lǝmwandǝhar, paɗ nakǝn tǝ alchita fa hur Shemeɗa, la mbukǝn paɗ kǝ sakaan'ichaɗi kǝ ɗar Yǝso keeke, nat tǝ kichu baptisma Yohanna ndak sǝntǝn. <verse eid="ACT 18:25" /><verse number="26" style="v" sid="ACT 18:26" />Tǝrkaakǝn shundǝ tǝ alchitafa, a kǝtǝn humta Yahudawecha, kǝ sǝktǝ nda Biriskila tǝ Akila ndi, tǝrkǝndǝnda huri, chekangndǝ mbwa'a pathla Farǝ kaǝn. <verse eid="ACT 18:26" /><verse number="27" style="v" sid="ACT 18:27" />Kǝ yahtǝ Afollossa ɗǝta Akaya, chekang hwanmanchǝ alchita, paɗ yarangndǝ ɗelwera fa tǝr mbandǝsi kǝthlǝm kǝ thlǝndǝndi tǝ harchǝchap. Kǝ saatǝn, kǝssangna fichilesi fǝrkǝkit kaǝn, tǝ mbǝɗa kafata. <verse eid="ACT 18:27" /><verse number="28" style="v" sid="ACT 18:28" />Kǝthlǝm sheraɗa Yahudawecha tǝ alchit kaǝn, fǝraan harǝfata kanda mbanitǝ nofcha, la cheɗkǝnwa hur pathla Fara Yǝso naka Kǝrǝsti.<verse eid="ACT 18:28" /></para>
  <chapter eid="ACT 18" />
  <chapter number="19" style="c" sid="ACT 19" />
  <para style="s">Bulus a Afisa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1" />A thlahmbǝɗi nat Afollossa korinti, Bulus wuyaǝn hur thlet hǝmǝtkǝn saakǝna Afisa, mbǝɗi mbǝsandǝn tahhǝt kimshechǝkǝn. <verse eid="ACT 19:1" /><verse number="2" style="v" sid="ACT 19:2" />Ndangna kandǝwa: "A thlinduni Shemeɗ Chiɗchiɗ a thlahmbǝɗi fǝrtuni kitwa?"</para>
  <para style="p" vid="ACT 19:2">Ndangndǝwa: "Auwa, ɓahwani tamta sǝktǝwa Shemeɗsi Chiɗchiɗwa." <verse eid="ACT 19:2" /><verse number="3" style="v" sid="ACT 19:3" />Ndakǝnwa: "Witǝ baptisama tǝmǝ sandǝfichǝkuni?" Ndakndǝwa baptisma Yohanna." <verse eid="ACT 19:3" /><verse number="4" style="v" sid="ACT 19:4" />Ndak Buluswa: "Yohanna sǝkǝn baptisma kǝchendǝnwa tǝrnifǝhi, nakna ndanda nofchuwa kǝ fǝrndǝ kit kǝ mbǝɗa le na ɓata ɗiffitǝkǝn, naka Yǝso." <verse eid="ACT 19:4" /><verse number="5" style="v" sid="ACT 19:5" />Kǝ sǝktǝndǝ kichu, sang fichǝ baptisma kanda a hur thlǝm Lǝmwanda Yǝso. <verse eid="ACT 19:5" /><verse number="6" style="v" sid="ACT 19:6" />Kǝ ɗǝffandǝ Bulus hara kanda in, ɓak Shemeɗ Chiɗchiɗ kǝ ɗarnanda, naknda shundǝ tǝ hanshuwunchǝ somsomǝn, paɗ naknda mbu'icha. <verse eid="ACT 19:6" /><verse number="7" style="v" sid="ACT 19:7" />Ufnda nak ndǝ nifǝ kumngǝrǝnsi chap. <verse eid="ACT 19:7" /><verse number="8" style="v" sid="ACT 19:8" />Yimkǝ Bulussa kǝtǝn humta Yahudawechihi nakna ɓassa lechitfuwa shee ndǝraa mǝkkan, mǝlla halǝ'i'ndǝ tǝ kanda, nakna kahhandǝ hur'inchengnanda kǝ ɗar mwanda Fara. <verse eid="ACT 19:8" /><verse number="9" style="v" sid="ACT 19:9" />Paɗ funǝsa hurnanda tǝ kwaakwachit i'nda cherkǝnda fǝrkit, naknda njirandǝ mbanda Lǝmwananda mbanitǝ nofcha, kǝthlǝm kichu Bulus sakkǝnhi tǝkanda, pǝɗakǝn tǝ fa fǝrkit, nakna sakandaɗi i sǝkka wembǝta a makaranta Tiranus. <verse eid="ACT 19:9" /><verse number="10" style="v" sid="ACT 19:10" />Hurat chap mǝlla sǝt kichu, tǝ kichu nat nofchi naka hǝmǝt Asiya shikndǝ pathla Lǝmwanda, Yahudawecha tǝ punofcha.<verse eid="ACT 19:10" /></para>
  <para style="s">Hwecha Sikeba</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11" />A shiɗ Farǝ ǝnat sheka i'ndǝ oi tǝ mbǝɗa Bulus le tamuchit ficha nata. <verse eid="ACT 19:11" /><verse number="12" style="v" sid="ACT 19:12" />Chika mayani'en ndu njelaa'en, le tǝkanghara fat'enfa, la ɗangficha hacha kǝ kǝnda hur hafaɗeng nanda, paɗ kǝ sakndǝhi tǝ ɓǝɓishemecha. <verse eid="ACT 19:12" /><verse number="13" style="v" sid="ACT 19:13" />Funǝ Yahudawecha fichile la naka wiyandǝ hǝmǝtkǝn, la naknda rǝk ɓǝɓishemecha, la sǝkndǝ tor tǝ thlǝm Lǝmwandǝ Yǝso, a ɗar fichile nak tǝ ɓǝɓishemechikǝnafa la ndangndǝwa: "A hur thlǝm Yǝso lela ɓastǝ Bulussa ɗarkǝn chamakish." <verse eid="ACT 19:13" /><verse number="14" style="v" sid="ACT 19:14" />A hurnanda hwechǝsi muɗ kǝ hishcha, naka i kapat pǝrist lǝ Yahudawata le nat thlǝmkǝnwa Sikeba, uf nda lasǝkndǝ kichu. <verse eid="ACT 19:14" /><verse number="15" style="v" sid="ACT 19:15" />Ngǝmang ɓǝɓishemeɗ kǝn kandǝwa: "A shini Yǝso paɗ a shini Bulus, kunang paɗ kunang miicha?" <verse eid="ACT 19:15" /><verse number="16" style="v" sid="ACT 19:16" />Nifi nak tǝ ɓǝɓishemeɗɗǝ fiyu pǝrkǝnna ɗarnanda, sherangna kandǝ tǝ alchita, cheknda kissha hurikǝn tǝ wesha tamkwal tamkwal paɗ ɓǝskǝndǝ ndindicha.<verse eid="ACT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 19:17" />Fichile nak tǝ sokta a Afisa, Yahudawecha tǝ punofcha, kǝ sǝktǝndǝ i sǝkyu kǝsang lechit kandǝ nat, mwanang ndǝ thlǝm Lǝmwandǝ Yǝso. <verse eid="ACT 19:17" /><verse number="18" style="v" sid="ACT 19:18" />Oi a hur yuwa fafǝrkit, ɓaknda nata mbu ɓǝɓi ɗǝssǝcheng nanda tallara. <verse eid="ACT 19:18" /><verse number="19" style="v" sid="ACT 19:19" />Nofchǝ oi fa kulecha ɓakndǝ tǝ ɗelwercheng nanda, 'yangndaɗaɗi a mbanitǝ nofchǝ uf, kǝ sakandǝndǝ hanɗǝɓǝl ɗelwerchi ikkaɗi, mbǝssang ndǝwa a shee azurfa aru kumchit kum ɗurman (50,000). <verse eid="ACT 19:19" /><verse number="20" style="v" sid="ACT 19:20" />Shunda Lǝmwanda nakna ɗǝta mban tǝ alchitafǝ kaǝn.<verse eid="ACT 19:20" /></para>
  <para style="s">Thla Hur'i'nda a Afisa</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21" />Ɗiffitǝ ichini sǝknatyu, Bulus yarkǝnna hanɗǝkiketi'enwa niɗǝttǝ Makidoniya, tǝ Akaya ka cheta Urshelima, ndakǝnwa ma ɗiɗi mbǝnniyu waat kǝ ɗi hǝmmǝt Roma." <verse eid="ACT 19:21" /><verse number="22" style="v" sid="ACT 19:22" />Thlǝnkǝn funǝ chap hur fa kǝssa torchǝsi, nda Timoti tǝ Arastus, kǝ Makidoniya, mǝllan thlarkǝnhi a hǝmmǝt Asiya tolla.<verse eid="ACT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23" />A hanmunchiniyu thlakkǝ kapat thla hur'i'nda, kǝ ɗar pathlǝ fa tǝrmbanda Yǝso. <verse eid="ACT 19:23" /><verse number="24" style="v" sid="ACT 19:24" />Thla hur'inkǝn ɓakǝn tǝ mbǝɗa lǝ ɓǝlta, le nat thlǝmkǝnwa Dimitiriyus, lelǝ sǝk tor tǝ hurita, kǝnna ɓǝl kǝtǝn ɗǝhhacha Artemis. Lanakna mbǝssa hanɗǝɓǝlta fa torharkǝnsǝ kaǝn. <verse eid="ACT 19:24" /><verse number="25" style="v" sid="ACT 19:25" />A ngomaǝn kandǝ nat tǝ fichile nat witǝ torhareng nandǝ ǝrta, ndakǝnwa: "Nofcha, ashinuniwa tǝ tori engnaniya mbǝsti kǝnnecha. <verse eid="ACT 19:25" /><verse number="26" style="v" sid="ACT 19:26" />Kuna nata kuna sǝkta nga Afisa ɗengwa nat tǝ Asiya, Bulus kahhaɗǝ hur'i'nda nofchǝ oi, paɗ tǝɓrandǝ nofchihi oi, tǝ ndatwa ɗǝhachi lǝ tintuni tǝ harcha nga Farǝwa. <verse eid="ACT 19:26" /><verse number="27" style="v" sid="ACT 19:27" />Mbǝrramsi mborro ɓata naficha sǝɓandǝ thlǝm torengnǝmmaɗi. Ɗiffitǝ ndǝkǝn paɗ tǝ kǝttǝn nuhɗahata kapat alliya a Artemis, nan soktǝ nga ǝnwa, paɗ nan saktǝhi tǝ mwandǝ'en, mǝllan ti lamwanandǝ hǝmmǝt Asiya tǝ kishitǝ nat." <verse eid="ACT 19:27" /><verse number="28" style="v" sid="ACT 19:28" />Kǝ sǝktǝndǝkichu sǝɓkǝ hurcheng nandaɗi, naknda hwat tǝ ndatwa: "A shok kapat mwanda Artemis a Afisawecha!" <verse eid="ACT 19:28" /><verse number="29" style="v" sid="ACT 19:29" />Nǝhǝɗkǝ hǝmǝtkǝnaɗǝ tǝ sheka i'nda, rahkǝndǝ kǝ mbǝt terǝkǝn, kǝssangndǝ Gayus tǝ Aristarkus, shikechǝ wita Bulus a Makidoniya. <verse eid="ACT 19:29" /><verse number="30" style="v" sid="ACT 19:30" />Yeh Bulus si kǝ yimka hur nofchǝkǝn, ngǝmauchik fa fǝrkit. <verse eid="ACT 19:30" /><verse number="31" style="v" sid="ACT 19:31" />Kuturchǝsa Asiya naka shikechǝkǝn, thlǝnangndǝ shundǝ tǝ ndatwa, mǝ ɓahiɗa yimta hur nofchi oi yuwa. <verse eid="ACT 19:31" /><verse number="32" style="v" sid="ACT 19:32" />Yakat nofchi ngomkǝhiyu, kanda hur sheka'i'nda, kǝthlǝm shekndǝhi, funǝ tǝ mbǝɗyu funǝ paɗ tǝ mbǝɗya, sokkǝn terchin fichile sǝnuchik i humang kandǝhi. <verse eid="ACT 19:32" /><verse number="33" style="v" sid="ACT 19:33" />Funǝ Yahudawechǝsi pǝkkǝndǝ Alekzanda mban. Mǝlan paɗ thla'a'ǝn hara kǝthlǝm kǝ ngasfichǝ ɓa, mbah nan mbwa'anda kandǝ i sǝka. <verse eid="ACT 19:33" /><verse number="34" style="v" sid="ACT 19:34" />Kǝ mbǝssandǝndǝwa lǝ Yahudawat nakǝn, hanthlikchǝ chap ufndǝ kanda hwata, tǝ kapat ɓurata ndatwa: "Kapat mwanda Artemis a shoka Afisawecha!"<verse eid="ACT 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35" />A mweshitkǝn, lǝ yaratkǝnna hǝmǝtkǝn ngassaǝn nofchihiyu, ndakǝnwa: "Kunang Afisawecha, wun sǝnuchikwa hǝmmǝt Afisa naka hǝrǝm kǝttǝn ɗǝhhacha kapat Artemis, tǝ kweshcha ngwiyi hǝmka haya afshi? <verse eid="ACT 19:35" /><verse number="36" style="v" sid="ACT 19:36" />Nda i natǝm ichiniyu, kamusi kǝ halǝm i'ndǝwa, kamkǝnsi kǝ ngassuni ɓa mǝ wesshiɗuniwa. <verse eid="ACT 19:36" /><verse number="37" style="v" sid="ACT 19:37" />Ɓakuni tǝ nofchiya ɓǝɗya, chika sokkǝn herkunda kǝtǝn ɗǝhhachengnǝm, ndu kǝ mbundǝ ɓǝɓi'ǝn kǝ ɗar nuhɗǝhhachengnǝmwa. <verse eid="ACT 19:37" /><verse number="38" style="v" sid="ACT 19:38" />Ma Dimitiriyus tǝ shikechǝkǝn tǝ fa sǝt torchi'en, ma ǝnsa thlerǝnandǝ tǝ yuna, a i'nafichǝ kǝtǝn sakmichǝhi, paɗ fa sakmikǝnsi ɗǝknda muh hanhara. <verse eid="ACT 19:38" /><verse number="39" style="v" sid="ACT 19:39" />Ma ǝnsǝ yahtunisa ɓattǝkǝn kǝ mban, ɗǝk ma mweshanda mbanitǝ pǝktecha. <verse eid="ACT 19:39" /><verse number="40" style="v" sid="ACT 19:40" />Kittǝkǝn kǝmna hur lechit ngǝm muhhanhar thlahur inni ɓukweya, kǝthlǝm ngǝma mbǝlla mbu i ɓaktǝ thlahuri'ndǝ kǝ ɗarnandǝwa. <verse eid="ACT 19:40" /><verse number="41" style="v" sid="ACT 19:41" />Kǝ mbutǝn ichiniyu kalkǝn nofchǝkǝnhi.<verse eid="ACT 19:41" /></para>
  <chapter eid="ACT 19" />
  <chapter number="20" style="c" sid="ACT 20" />
  <para style="s">Bulus Ngǝraɗǝ i'na Makidoniya tǝ Hellas</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1" />Kǝ tuɓwat thlahur'i'nda, Bulus akǝn fafǝrkit, chekaǝn alchita kanda hur hanɗǝkiketa, ɗǝkǝn ndandǝnakandǝwa sefarǝyuna, pǝɗakna hǝmmǝt Makidoniya. <verse eid="ACT 20:1" /><verse number="2" style="v" sid="ACT 20:2" />Kǝ wiyandǝn thlet hǝmchikǝn, chekaǝn alchita fafǝrkit kaǝn, ɓakna hǝmmǝt Hellas. <verse eid="ACT 20:2" /><verse number="3" style="v" sid="ACT 20:3" />Sǝkǝn ndǝraa mǝkkana mbǝnniyu, nakna harǝfa kǝ pǝɗaka Suriya a hur kombawal, nak Yahudawecha yaraa ɓǝɓi'ichafa. Ndǝkǝn yartǝnwa nan ngǝrandǝ in tǝ Makidoniya. <verse eid="ACT 20:3" /><verse number="4" style="v" sid="ACT 20:4" />Nofchi ɗǝfkǝ Bulus nda: Sufata hweya Farus lǝ Biriyata, tǝ Aristarkus tǝ Sakundus, Nofcha Tassalonika, tǝ Gayus nangna Darbe, tǝ Timoti, nat tǝ Tikikus tǝ Tarofimus, nofcha Asiya. <verse eid="ACT 20:4" /><verse number="5" style="v" sid="ACT 20:5" />Fichile lak pǝɗata ɓan puukǝndǝ kani a Toruwas. <verse eid="ACT 20:5" /><verse number="6" style="v" sid="ACT 20:6" />Kanang paɗ malkani Filibihi yimkani kommbawal, ɗiffitǝ chi njohmi nguchit mehndǝsa fi'en, hur mundǝ ɗurman ndǝkani mbǝskanda a Toruwas sokkani ɓǝnniyu mundǝ muɗ.<verse eid="ACT 20:6" /></para>
  <para style="s">Thla'a Fichǝ Murǝt Aftikos a Toruwas</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7" />Tǝrka mundǝmuɗ ngomkani uf kǝthlǝm kǝ chichangani njohmǝhi. Thlaakǝ Bulus ɓassangna kandǝsi. Nakna harǝfǝ kǝthlǝm yehsa pǝɗata ɓingǝtkǝn, nakna ɓassǝ toltol taa kǝ ɗar fiɗikta. <verse eid="ACT 20:7" /><verse number="8" style="v" sid="ACT 20:8" />A kǝtǝni ngomtani a huri afshi tikkeshchisǝ oi. <verse eid="ACT 20:8" /><verse number="9" style="v" sid="ACT 20:9" />Hwan kimshaasi thlǝmkǝnwa Aftikos sokkǝn ɗassa tinkummbata, kǝssang ɓweni kaǝn. Bulussa ɗar ɓassǝ toltol yimkǝna ɓweni kasat, hǝmkǝnnahaya mǝkkatǝ tǝrkǝtǝnkǝn, tǝrkǝ fichiɗǝ kǝ murǝtkǝn. <verse eid="ACT 20:9" /><verse number="10" style="v" sid="ACT 20:10" />Tǝrkǝ Bulussa haya kǝ ɓǝɗi nat hwaniyu, ɓirkǝnhi ɗarkǝn tǝrkǝnnda kapahɓa ndakǝnwa: "Mǝ thla'i hur'i'ɗengnuniwa mwe tǝ shisshingtafa. <verse eid="ACT 20:10" /><verse number="11" style="v" sid="ACT 20:11" />Ngǝrang Bulus inna huri afshi ɗǝkna chichandǝ njohmǝhi chiikǝn. Nakna shundǝ tǝkanda kǝ wenda ɓǝta kanapǝɗata. <verse eid="ACT 20:11" /><verse number="12" style="v" sid="ACT 20:12" />Pǝɗakndǝ tǝ kimshi'iyu tǝ shisshingtafa nangnda kwalǝ kaǝn.<verse eid="ACT 20:12" /></para>
  <para style="s">Witǝ Thlata Toruwas kǝ Miletus</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13" />Kǝ natani sa'a'ndǝ kommbawal, yimkanisi kǝ Asus kǝthlǝm kǝ tǝrrani Bulussa mbǝnniyu nda i tahsandǝnhi, mǝllan yarkǝnwa tǝsar natna ɗǝta. <verse eid="ACT 20:13" /><verse number="14" style="v" sid="ACT 20:14" />Kǝ ɓatna mbǝskani a Asus, tǝrkaninda hur kommbawal ɗǝkani kǝ Mitilin. <verse eid="ACT 20:14" /><verse number="15" style="v" sid="ACT 20:15" />Thlaakani ɓǝnniyu ɓingǝtle a hur kommbawal ɓakani kǝllari Kiyos. Iskichitkǝn changani kǝ Samas ɗiffitǝ mundǝ ǝrtǝ paɗ saakani Miletus. <verse eid="ACT 20:15" /><verse number="16" style="v" sid="ACT 20:16" />Tǝrkǝ Bulus hurwa ngu thlarǝhi Afisa wa, kǝthlǝm mǝ sǝɓɓaɗǝ han thlikchaɗa Asiya wa. Mǝlla weshi kǝ saaka Urshelima ma mbandǝsi a farǝ Pentikos.<verse eid="ACT 20:16" /></para>
  <para style="s">Shuna Bulus Pǝktecha a Afisa</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17" />A Militus thlǝntǝ Bulus, kǝ Afisa kǝ ang fichǝ pǝktecha, mbǝt hwanda kǝ ɓanda mbǝsndi. <verse eid="ACT 20:17" /><verse number="18" style="v" sid="ACT 20:18" />Kǝ ɓatnda mbǝsndi ndangnakandǝwa: "Kunang tǝ inchengnuni a shinuni witǝ soki sokti tǝkuni, i'sǝka para njang tǝ kuni, thlata fari ɗǝfti sarengnǝ kǝ Asiya. <verse eid="ACT 20:18" /><verse number="19" style="v" sid="ACT 20:19" />Nja sa tor Lǝmwanda tǝ amtita tǝ ɓahmwa'i'nda tǝ ɓahhi satti tǝmbǝɗa ɓǝɓi yarǝcha Yahudawecha. <verse eid="ACT 20:19" /><verse number="20" style="v" sid="ACT 20:20" />A malawi mbwa'a i'chakuni le na kǝssanda kunisǝwa, paɗ lanaki sakandakunihar a hur nofcha ɓuɓwetǝfǝwa, tǝ paɗ la yimkǝ huraa hura'a. <verse eid="ACT 20:20" /><verse number="21" style="v" sid="ACT 20:21" />Kahhaɗi hur'i'nda Yahudawecha tǝ punofcha kǝ tǝrndǝhi mbanitǝ Fara, paɗ kǝ fǝrndǝ kit kǝ mbǝɗa Lǝmwaɗengnǝm Yǝso Kǝrǝsti.<verse eid="ACT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 20:22" />Nakǝnya ɗǝki Urshelima tǝ ɓǝɗa alchita Shemeɗ Chiɗchiɗ. Paɗ sinwi'i'na kǝsnja mbǝnniyuwa, <verse eid="ACT 20:22" /><verse number="23" style="v" sid="ACT 20:23" />A nakǝn cheɗi Chiɗchiɗtǝ Shemeɗwa, i'sǝka hǝmta na pursunachita natsi, tǝ ɓahta le naka punji. <verse eid="ACT 20:23" /><verse number="24" style="v" sid="ACT 20:24" />Chika tǝ kichu tǝrwi shisshintengnǝ nda ǝn ndiichinwa, ndu kapat ǝnkǝ fandengnǝwa, mani mbǝlla tuɓwandǝ tori fǝritǝ Lǝmwandǝ Yǝso, le naka ɓassǝ kweshcha kusheng shunda kǝ ɗar kafata Fara. <verse eid="ACT 20:24" /><verse number="25" style="v" sid="ACT 20:25" />Nakǝnya a shiniwa ngusa hurnuni na ngǝrnatnjuwa, kunangti wiiyaandi kuni kǝni ɓassa kuturichita Fara kunisi. <verse eid="ACT 20:25" /><verse number="26" style="v" sid="ACT 20:26" />Tǝpaɗ nja sǝnnanda kunisi ɓukweya, mwa'u fwara yunengnunisa ɗar indengnuwa, <verse eid="ACT 20:26" /><verse number="27" style="v" sid="ACT 20:27" />Kǝthlǝm a sǝkwi lǝklǝkchit mbwa'a yaara Farakuni natwa. <verse eid="ACT 20:27" /><verse number="28" style="v" sid="ACT 20:28" />Mbǝramsa inchengnuni, tǝpaɗ uf chaɓi ɗǝftǝ Chiɗchiɗchita Shemeɗ kuni, kǝnuni fa putǝhar kǝ ɗuni mban tǝ hǝrǝm nofcha, fa kuwur mbanda Fara, fichile mbǝssandǝna i'ndi'en tǝ mbǝɗa fwara hwe'en. <verse eid="ACT 20:28" /><verse number="29" style="v" sid="ACT 20:29" />A shini tǝ ndatwa ma pǝɗeɗi funǝ ɓǝɓi nofcha nanda yimta hurnuni, paɗ ngunda malandǝ chaɓǝkǝnwa. <verse eid="ACT 20:29" /><verse number="30" style="v" sid="ACT 20:30" />Tǝpaɗ funa hurnuni nanda thlata kǝnnda shuwun lekta, kǝthlǝm kǝ kahangndǝ fa kuwur mbanda Fara kǝ thlǝmmantnanda. <verse eid="ACT 20:30" /><verse number="31" style="v" sid="ACT 20:31" />Kǝthlǝm ɗǝkǝn sokam tǝ tahhasǝffa, kǝ kuɗkuni, hurat mǝkkan fiɗiktǝsǝwa farǝsǝwa, mallawi mbwa'anda kuni natuni tǝ amtitwa. <verse eid="ACT 20:31" /><verse number="32" style="v" sid="ACT 20:32" />Nakǝnya njang firi kuni ɓǝɗa Fara, paɗ tǝ shuwun kafat'en, le na mbǝlla tinandǝkuni, paɗ kǝ fǝrangka kuni i tahsandǝnhi nat tǝ fichile nakchiɗchiɗ. <verse eid="ACT 20:32" /><verse number="33" style="v" sid="ACT 20:33" />A yahwi zinariya ndu azurfa ndu njelecha yunǝwa. <verse eid="ACT 20:33" /><verse number="34" style="v" sid="ACT 20:34" />Kunang tǝ inchengnuni a shinuniwa a shiɗi tor tǝ harchi'engnǝya kǝthlǝm kǝ kwanayi indengnǝ i'yahtǝn tǝ fichile naka thlǝmmatna. <verse eid="ACT 20:34" /><verse number="35" style="v" sid="ACT 20:35" />A hur ichi nat cheɗaɗi sakǝtkǝnakuni tǝ ndatwa, sokkǝn waat kǝsuni tor kicheya kǝthlǝm kǝ kǝssangnguni fichilesi nguchik tǝ alchitafa, kǝnuni kuɗuk pathla Lǝmwandǝ Yǝso mǝllanti ndakwa: "Fǝr'ǝnna pǝɗaɗa thlǝthi tǝ mbǝsta.'"<verse eid="ACT 20:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36" />Kǝ mweshandǝ Bulus mbutǝkichu, kopkǝnhi hwakǝn nat tǝ kandang. <verse eid="ACT 20:36" /><verse number="37" style="v" sid="ACT 20:37" />Mǝrkǝndǝhi tit ufnda, hǝmmangndafa kǝskǝndǝndǝhar i saktǝhi. <verse eid="ACT 20:37" /><verse number="38" style="v" sid="ACT 20:38" />Nakndǝ tǝ sǝɓhura, kǝthlǝm shuni ndandǝnakandǝwa ngundangǝrnatndǝwa, thlaakǝnda ɗǝfkǝndǝndi kǝmbǝt kommbawal.<verse eid="ACT 20:38" /></para>
  <chapter eid="ACT 20" />
  <chapter number="21" style="c" sid="ACT 21" />
  <para style="s">Pǝɗata Bulus kǝ Urshelima</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1" />Kǝ maltanikandǝhi, yimkani hur kommbawaltǝkǝn pǝɗakani kǝ Kos, wendambǝt paɗ ɗǝkani kǝ Rodes, thlaakani mbǝnniyu paɗ kǝ Fatara. <verse eid="ACT 21:1" /><verse number="2" style="v" sid="ACT 21:2" />Kǝ mbǝstani kommbawalti na ɗǝtǝ furut Finikiya, yimkanisi pǝɗakani. <verse eid="ACT 21:2" /><verse number="3" style="v" sid="ACT 21:3" />Kǝ tǝrkaatani nat Sayifurus, malkanihi tǝ kukun hishingta, ɗǝkaniɓan tǝ pǝɗata hǝmmǝt Suriya. Tǝrkanihaya a Taya, kǝthlǝm a mbǝnniyu nat kommbawaltǝkǝnna harandǝ ichi'enna haya. <verse eid="ACT 21:3" /><verse number="4" style="v" sid="ACT 21:4" />Kǝ mbǝstani fafǝrkit, sokkanihi mbǝnniyu mundǝmuɗ. Tǝ mbǝɗa shemeɗa ndangnda Buluswa mǝɗiɗa Urshelimawa. <verse eid="ACT 21:4" /><verse number="5" style="v" sid="ACT 21:5" />Tǝ kichu kǝ saatǝ munchi natani thlata, kǝnkanihursǝ tǝ wita. Thlaakǝnndǝ ufnda tǝ nishcha tǝ hwecha ɗǝfkǝndǝ kani kǝ ɗǝffitǝ hǝmta, mbǝnniyu kopkanihi mi ama hwankani, <verse eid="ACT 21:5" /><verse number="6" style="v" sid="ACT 21:6" />kanani saktǝhi tǝkanda. Kanani yimta hur kommbawal, kandang paɗ ngǝrangndǝ'ina huri.<verse eid="ACT 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7" />Kǝ tuɓwandani witengnani a Taya, saakani kǝ Tolemayis, ndangani ǝnna fahchǝnani, sǝkani mundǝ ǝrta mbǝɗengnanda. <verse eid="ACT 21:7" /><verse number="8" style="v" sid="ACT 21:8" />Wembǝtle thlaakani ɗǝkani kǝ Kaisariya, yimkani kǝ hura'a Filibus lǝ ɓassa, le nak ǝrta a hur fichile muɗ taatǝ fichǝharyu. <verse eid="ACT 21:8" /><verse number="9" style="v" sid="ACT 21:9" />Hwechǝ'ensi fwaɗa kǝ hantarcha ngwanauchit fichǝkanda, lanaknda mbu'icha. <verse eid="ACT 21:9" /><verse number="10" style="v" sid="ACT 21:10" />Ɗiffitǝ sǝt hanmuncha mbǝnniyu, ɓak yunǝ lenaka tapǝna'a nat thlǝmkǝnwa Agabus nakna Yahudiya. <verse eid="ACT 21:10" /><verse number="11" style="v" sid="ACT 21:11" />Kǝ ɓat Agabussa thlǝmmatnani, tǝrkǝn sahǝt kǝnhura Bulus. Ndǝkǝn kǝnandǝn harchi'en, tǝ sarǝchi'en ndakǝnwa: "A i'ndat Chiɗchiɗ tǝ Shemeɗkǝnya, 'kichu Yahundawecha Urshelima, nanda kǝnandǝ lǝ sahǝt kǝnhuriya, paɗ kǝ fǝrndǝndi kǝ mbǝɗa punofcha."<verse eid="ACT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12" />Kǝ sǝktani kichu, kanang tǝ nofchi naka mbǝnniyu, hwanangani Bulus mǝ ɗiɗa Urshelimawa. <verse eid="ACT 21:12" /><verse number="13" style="v" sid="ACT 21:13" />Ngǝmmang Bulus ndakǝnwa, "Kǝthlǝmmi natuni sǝtkichu? Kǝthlǝmmi natuni tita kǝnuni sǝɓandǝ hanɗǝkiketengnaɗi? A tehshifa nga kǝnitǝ ɗengwama, ndu kǝ ɓǝllikǝficha a Urshelima kǝthlǝm thlǝm Lǝmwandǝ Yǝso." <verse eid="ACT 21:13" /><verse number="14" style="v" sid="ACT 21:14" />Mbǝla'uchikani tǝɓrandǝ yarǝ'enhiyu, ngaskani ɓa, ndakaniwa: "Suku sakta Lǝmwanda kǝ nǝhɗǝnhi."<verse eid="ACT 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15" />Ɗiffitǝ munchǝkǝn tahǝskanifa pǝɗakani Urshelima. <verse eid="ACT 21:15" /><verse number="16" style="v" sid="ACT 21:16" />Funǝ fafǝrkitsa Kaisariya ɗǝfkǝ kani, ɗǝkndǝ tǝ kani mbǝɗa Manason lenatani tǝrtahaya mbǝt'en, nifǝkǝn lǝ Sayifurustǝ nakǝn, nakǝn ǝrta a hur fafǝrkitti tǝrkakǝnyu.<verse eid="ACT 21:16" /></para>
  <para style="s">Bulus Ɗiɗǝ Urshelima</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17" />Kǝ ɓatani Urshelima, thlǝk fahchǝnanikani tǝ mbǝnfat kaǝn. <verse eid="ACT 21:17" /><verse number="18" style="v" sid="ACT 21:18" />Wendambǝta pǝɗakani tǝ Bulus kǝ mbǝɗa Yakubu, pǝktecha fafǝrkit kanda mbǝnniyu. <verse eid="ACT 21:18" /><verse number="19" style="v" sid="ACT 21:19" />Ɗiffitǝ nda ichakanda, ndǝkǝn mbwa'andǝna kandǝ ǝrtǝ ǝrtǝ ichi sǝt Fara a hur punofcha, tǝ mbǝɗa tori sǝt Bulus. <verse eid="ACT 21:19" /><verse number="20" style="v" sid="ACT 21:20" />Kǝ sǝktǝndǝ kichu, mwanangndǝ Fara. Ndangnda Buluswa, "Neɗnǝwa hwanmanani, terǝ nofchǝ oi a hur Yahudawecha firndǝ kit, ufndǝ fa sǝrǝh kuwur kussa Musa naknda. <verse eid="ACT 21:20" /><verse number="21" style="v" sid="ACT 21:21" />A mbwa'a fichǝ kushengwa kandǝ ndatwa, sokǝn lasakagnga Yahudawechihar uf fichile naka hur punofcha wa muhang ndǝ kussa Musa ɗi. Paɗ la ndakuwa mǝ heshafichǝ hwechengnandǝwa, paɗ mǝ kurindǝ tormurteng nandǝwa. <verse eid="ACT 21:21" /><verse number="22" style="v" sid="ACT 21:22" />Nakmasǝtwa kǝniya chu? Kǝthlǝm nanda sǝk kushsheng ɓaɗeku. <verse eid="ACT 21:22" /><verse number="23" style="v" sid="ACT 21:23" />I naksi su i ndutani kǝ sǝna. Nofchengnanisǝ fwaɗa, fichile ak ichimi. <verse eid="ACT 21:23" /><verse number="24" style="v" sid="ACT 21:24" />Haru nofchiniyu kǝ ɗuni sapandǝ faɗengnuniɗi, kǝ kwanǝ i la kwantǝficha, kǝthlǝm kǝ hǝssang ndǝ kanda. Tǝ kichu nat ficha sǝndǝ tǝ ndatwa, i mbwa'andǝ ficha kanda nga kitchitsuwa, paɗ nakndanat nda sokǝn naka kuwur i mbutǝ kustǝkǝn. <verse eid="ACT 21:24" /><verse number="25" style="v" sid="ACT 21:25" />Paɗ punofchi fǝrkǝkit, a thlinani ɗelwer tepi thlaɗanihi, mǝngǝmiɗunifa kǝ sǝmmuni i'thlandǝficha ɗǝhhachiwa, tǝ fǝllawichitta, tǝ chi i'ɓekrandǝfichǝ ɓurat'en, paɗ tǝ chi thlu tǝ fwar'en.<verse eid="ACT 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26" />Ɓingǝtkǝn Bulus tǝrkǝn nofchǝkǝn, sapangfichǝ kandaɗǝ ufnda. Yimkǝnnda kapat hura'a Fara, kǝthlǝm kǝ sǝnaǝn farǝ nǝhata saptengnandaɗi, a fari nat ficha fǝr poffǝn kǝthlǝm chikawuni.<verse eid="ACT 21:26" /></para>
  <para style="s">A Kǝssafichǝ Bulus a Hur Kapat Hura'a Fara</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27" />Kǝ nat mundǝ muɗɗa yah nǝhata, Yahudawechi ɓaka hǝmǝt Asiya nakndǝ Bulus a kapat hura'a Fara. Ndǝkǝn chikandǝndǝ terǝ humkǝn ufnda, kǝssangnda. <verse eid="ACT 21:27" /><verse number="28" style="v" sid="ACT 21:28" />Naknda hwata kannda ndatwa: "Nofcha Isra'ila, kǝssamnakanisi! Le nifiya lasakaǝn ɓǝɓi'ichaɗi kǝ ɗar nofchengnǝm chika ayi, kǝnambwa'anda chika wuni, kǝ njirndǝ kussa Yahundawecha. Lashuwungkǝn ɓǝɓi'icha ɗar kapat hura'a Fara, paɗ latǝkmaǝn kweshcha mbǝɗihi chiɗchiɗya tǝ mbǝɗa ɓattǝ punofcha hurkǝn. <verse eid="ACT 21:28" /><verse number="29" style="v" sid="ACT 21:29" />Kǝthlǝm soh neɗ ndǝ Tarofimus lǝ Afisawata, kanda mbǝt ǝrta a hur hǝmta, tǝrkǝndǝwa Bulus yima kapat hura'a Fara tǝ ndi.<verse eid="ACT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30" />Chatkichuyu shekɗang in'ndǝ hǝmta, ɓaknofchǝ tǝ rahtǝ ufnda, kǝssang ndǝ Bulus kahkǝndǝnda kish, a hur kapat hura'a Fara, chatkichuyu ngǝllang fichǝ mikǝtǝncha. <verse eid="ACT 21:30" /><verse number="31" style="v" sid="ACT 21:31" />Kanda ɗar yarǝ ɓǝllanda, saakǝ kushengkǝna mbǝɗa kapat lǝthlǝrhwata, ndatwa kim Urshelimahi tǝ thla hur in'nda. <verse eid="ACT 21:31" /><verse number="32" style="v" sid="ACT 21:32" />Chatkichuyu harkǝn fathlǝrhwecha tǝ pǝktat fathlǝrhwecha Roma, rahkǝnda hai kǝ mbǝɗi nat ngomnofchǝkǝn. Paɗ kǝ natndǝ fathlǝrhwechǝkǝn tǝ kapat nanda malang ndǝ tǝp Bulus. <verse eid="ACT 21:32" /><verse number="33" style="v" sid="ACT 21:33" />Ɓak kapatnandǝ nduk kǝssaǝn, ndakǝnwa kǝ kǝnnang ficha, tǝ chalalochǝ chap. Kanna sahtǝwa ndu wunnakǝn, tǝ i paɗ sǝttǝn. <verse eid="ACT 21:33" /><verse number="34" style="v" sid="ACT 21:34" />Thlaakǝ terǝ nofchiyu naknda muh hanhara, ndakfunuwa kǝcha, nak funǝndatpaɗwa kǝcha. Kǝthlǝm yakat thlahur in'nda hullaɗa mbǝssandǝ ɗarshuwunkǝn, ndakǝnwa kǝ ɗafichǝ tǝnda hura'a fathlǝrhwecha. <verse eid="ACT 21:34" /><verse number="35" style="v" sid="ACT 21:35" />Kǝ saatǝ Bulus kǝmi tǝrta, tǝrkǝ fathlǝrhwechǝkǝnndi kǝthlǝm thlahur'inda terǝ nofcha, <verse eid="ACT 21:35" /><verse number="36" style="v" sid="ACT 21:36" />Yakat nofchǝ oi kuwurkǝkanda, kanda hwata tǝ ndatwa: "Ɓǝllamǝn!"<verse eid="ACT 21:36" /></para>
  <para style="s">Shuna Bulus Nofcha</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37" />Kǝ natndǝ nduk yimtǝ tǝ Bulus kǝ hura'a fathlǝrhwechǝkǝn, ndǝkǝn ndandǝna kapatnandǝwa: "Ni mbǝlla shunutǝwa?"</para>
  <para style="p" vid="ACT 21:37">Ngǝrkǝ kapatnandǝtǝkǝnsuwa: "Awi la mbǝrku Helenanciwa? <verse eid="ACT 21:37" /><verse number="38" style="v" sid="ACT 21:38" />Awi nga sokǝn naka Lǝmasarawatwa, naka a hurechi mbǝrkǝhi humang thlahur'indǝyuwa, kahkǝ nofchǝ aru kumchit kum fwaɗa fa ɓǝlfata kǝ loktarǝyuwa?" <verse eid="ACT 21:38" /><verse number="39" style="v" sid="ACT 21:39" />Ndǝkǝn ngǝmmandǝ Buluswa: "Ə, njang Lǝyahudawata naki a Tarsus, a hachahai Kilikiya. Njang ɓaki hǝmǝɗi sǝntǝficha, nja hwanuta malitǝn kǝ shunayi nofcha." <verse eid="ACT 21:39" /><verse number="40" style="v" sid="ACT 21:40" />Kǝ fǝrandǝn mbanda, thlarkǝ Bulus kǝ mbǝt thlara, thla'anghara kǝmbǝɗa terǝ nofcha kǝthlǝm kǝ ngasndǝ ɓa. Kǝ ngastǝ ndǝ ɓa, shunaǝn kandǝ tǝ mi Aramayata, ndatwa:<verse eid="ACT 21:40" /></para>
  <chapter eid="ACT 21" />
  <chapter number="22" style="c" sid="ACT 22" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1" />"Hanmanchina tǝ shinchina sǝkamnji, kǝ mbwa'ayikuni isǝka kǝthlǝm kǝ cheɗayikuniwa suwuni'ǝnwa." <verse eid="ACT 22:1" /><verse number="2" style="v" sid="ACT 22:2" />Kǝ sǝktǝndǝndǝ shunaɗǝkandǝ tǝ mi Ibraniyanci, ngaskǝndǝ ɓa.</para>
  <para style="p" vid="ACT 22:2">Ndǝkǝn ndatǝnwa: <verse eid="ACT 22:2" /><verse number="3" style="v" sid="ACT 22:3" />"Njang lǝ Yahudawat naki, ngǝtkǝfichinja Tarsus, a hachahai Kilikiya. Nat tǝkichu mwanki hǝmmǝɗiya, paɗ sakikǝfichǝ changkathar tǝ mbǝɗa Gamaniel, le sakikǝ ichǝhar uf kǝ ɗar sakta kakechengnǝm. Lǝ sǝrǝhki kuwur Fara, nda i uffuni lǝ sutuni a ɓukweya. <verse eid="ACT 22:3" /><verse number="4" style="v" sid="ACT 22:4" />Ɓahhaɗi fa kuwur mbanda Yǝso, paɗ lanaki ɓǝllandǝkanda, lanaki kǝnandǝ nofcha nda hishcha tǝ nishcha, la muhki kanda hur pursuna. <verse eid="ACT 22:4" /><verse number="5" style="v" sid="ACT 22:5" />Kapat pǝrist tǝ pǝktat fasakmicha, tǝ fa hǝmmbanicha, na sheta kǝ ɗarna. Mbǝɗengnandǝ thlitti ɗelwer kǝ mbǝɗa fahchinǝm Yahudawecha, thlaaki pǝɗakǝ kǝ Dimaska, kǝ thlǝm kǝ hari fichile naka mbǝnniyu, kǝ ɓitǝkanda Urshelima a kǝnnda, ɓah nanda fǝraa pwane kanda.<verse eid="ACT 22:5" /></para>
  <para style="s">Bulus Mbwitǝ Tǝrtǝ'ennhi</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6" />"Nja ɗar pǝɗata, kǝ saati nduk tǝ Dimaska, kana hur fara sata, chatkichuyu ɓak ɗwachita afshi, finikǝn. <verse eid="ACT 22:6" /><verse number="7" style="v" sid="ACT 22:7" />Hǝmkǝnhi kǝ hachahaya sǝkki ɓurata ɗitǝwa: 'Shawulu, Shawulu, i'mi natu fǝri pwancha?' <verse eid="ACT 22:7" /><verse number="8" style="v" sid="ACT 22:8" />Njang paɗ ngǝmayiwa, sokǝn wuni, Lǝmwanda?' Ndǝkǝn ɗitǝnwa: "Njang Yǝso Lǝnazaratta, le natu fǝra pwancha. <verse eid="ACT 22:8" /><verse number="9" style="v" sid="ACT 22:9" />Paɗ fichǝle naka thlǝmmatna, neɗɗi ɗwaachikkǝn, nattǝkichu sukundǝ ɓurata lenaka shundǝ tǝ njiuwa. <verse eid="ACT 22:9" /><verse number="10" style="v" sid="ACT 22:10" />Ndakiwa, mǝnati sǝtta Lǝmwanda?" Ndǝkǝn ɗitǝ Lǝmwanduwa, thla'u kǝ yimna Dimaska, a mbǝnniyu nat ficha mbu'u i tahsandǝ fichǝhi kǝ sǝnna. <verse eid="ACT 22:10" /><verse number="11" style="v" sid="ACT 22:11" />Kǝ hullandi nat mbǝta kǝthlǝm ɗwaachit hwaɗiyu, thlaakǝ fichile natani mbǝt ǝrtǝyu kǝskǝndǝ harengna, saaki kǝ Dimaska:<verse eid="ACT 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12" />"Yunǝsi nat thlǝmkǝnwa Hananiya, la kuwur Farǝ nakǝn nda iyarandǝ kus hi, lela shunang Yahudawecha nat kǝ sǝkndǝndi fichile nak tǝ sokta mbǝnniyu. <verse eid="ACT 22:12" /><verse number="13" style="v" sid="ACT 22:13" />Ɓakna mbǝsnji, thlarkǝn nduk tǝ nji ndikǝnwa: "Shawulu hwanya thlu natmbǝɗeku." Chatkichuyu naki nat mbǝta nakindi. <verse eid="ACT 22:13" /><verse number="14" style="v" sid="ACT 22:14" />Ndakǝnwa: "Tǝɗ Fara kakechengnǝmsa kǝthlǝm kǝ sǝnnǝ sakti'en, kǝ nana lǝ kachita kǝ sǝknǝ shunda mi'en. <verse eid="ACT 22:14" /><verse number="15" style="v" sid="ACT 22:15" />Kǝthlǝm kǝ sǝnna lǝ sheta'en kǝ mbǝɗa nofchǝ nat kǝ ɗar i'natu, tǝ'i'sǝktu. <verse eid="ACT 22:15" /><verse number="16" style="v" sid="ACT 22:16" />Nakǝnya mǝnatu puta? thla'u, kǝ sukǝ fichǝ baptisma kǝthlǝm kǝ sapang fichǝ ɓǝɓifaɗekuɗi, tǝ mbǝɗa at thlǝmkǝn."<verse eid="ACT 22:16" /></para>
  <para style="s">Eɗ Farǝ Bulus kǝ Mbǝɗa Punofcha</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17" />"Kǝ ngǝrandi'ina Urshelima, naki hwanda a kapat hura'a Fara, ɓak ǝn nda sǝnnata mbǝsnji. <verse eid="ACT 22:17" /><verse number="18" style="v" sid="ACT 22:18" />Naki Lǝmwanda, nangna nditǝwa: "Suleɗleɗ kǝ chenakisha Urshelima, kǝthlǝm ngunda thlǝt sheta e'ku kǝ ɗarnǝwa." <verse eid="ACT 22:18" /><verse number="19" style="v" sid="ACT 22:19" />Njang paɗ ndakiwa: "Lǝmwanda, kandang tǝ inchengnanda a shinnda i sǝka kǝtǝn humta Yahudawechǝhi, a kǝnnaɗi fichile fǝrkǝkit kǝmbǝɗeku, paɗ a tǝppaɗi kanda. <verse eid="ACT 22:19" /><verse number="20" style="v" sid="ACT 22:20" />Kǝ thlǝrandǝ fichǝ fwara Istifanusa ɗi, lǝ sheta ti e'kuyu, njang ma njang kitta mbǝnniyu, nja kuwur i sǝt ficha, nja pu njelecha fichilehar ɓǝlangyu." <verse eid="ACT 22:20" /><verse number="21" style="v" sid="ACT 22:21" />Ndikǝnwa: "Thla'u puɗu, ni thlǝnsa langna kǝ mbǝɗa punofcha."<verse eid="ACT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22" />Terǝ nofchǝkǝn naknda kathlǝmata Bulus, ɓakna mbu shuniniyu, mǝlla ɗar mbu'ichiniyu, thla'ang ndǝ hwata kanda ndatwa: "Ɓǝllamǝn! Sakamǝn witǝ nifihiya tǝkishita, kamusi kǝ nan tǝ shisshingtǝwa!" <verse eid="ACT 22:22" /><verse number="23" style="v" sid="ACT 22:23" />Naknda hwata nak nda muhandǝ ɗǝsupchengnandaɗi, naknda thla'andǝ tǝnnata, <verse eid="ACT 22:23" /><verse number="24" style="v" sid="ACT 22:24" />Kǝthlǝm ndǝkǝn Lǝmbanita fathlǝrhwata shuwunkǝn tǝ ndatwa, kǝ ɗa fichǝ tǝ Bulus kǝ mbǝɗi la soktǝ fathlǝrhwata, kǝthlǝm kǝ tǝpangnda kǝ sǝnndǝ isǝk nat nofcha hwanda kicheya. <verse eid="ACT 22:24" /><verse number="25" style="v" sid="ACT 22:25" />Kǝ kǝnnandǝnda kǝthlǝm kǝ tǝppangnda, ndang Bulussa kapat lǝthlǝrhwatkǝnna Roma lenak kit nduktǝndi: "Awi, hur kus keekesi kǝ sangnǝ ǝn ndu kǝ tǝpang ficha nifi naka hanhura'a Romawecha nga tǝ sang fichǝ kitasǝwowa?" <verse eid="ACT 22:25" /><verse number="26" style="v" sid="ACT 22:26" />Kǝ sǝktǝ kapat lǝthlǝrhwata Roma kichu, ɗǝkna mbǝs lǝmbanikǝn ndaǝnwa: "Mǝnatu yarǝsǝta? Nifiya hwan Roma nakǝn." <verse eid="ACT 22:26" /><verse number="27" style="v" sid="ACT 22:27" />Ɓak kapat nanda mbǝs Bulus ndaǝnwa: "Mbu'i'tǝn kit, sokǝn hwan hachahai Roma wa?" Ndang Bulus, "Ə." <verse eid="ACT 22:27" /><verse number="28" style="v" sid="ACT 22:28" />Ngǝmmang kapat lǝthlǝrhwatkǝnwa: "njang tǝ hanɗǝɓǝltǝ oi mbǝsti nata hwanhǝmta. Ndang Buluswa: "Njang ɗǝkǝn ngǝttǝfichǝ nji." <verse eid="ACT 22:28" /><verse number="29" style="v" sid="ACT 22:29" />Fichile naka yarǝ tawasǝndi chatkichuyu mbahkǝndǝ ɗifi'in. Kapat lǝthlǝrhwatkǝn kǝsǝntǝnwa Bulus lǝ hwan hachahai Roma nakǝn lechǝkǝn, paɗ teppa kǝnnaɗa.<verse eid="ACT 22:29" /></para>
  <para style="s">Bulus Mbanitǝ fa Sakmicha</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30" />Kǝ wentǝ mbǝtta, ɓak kapat lǝthlǝrhwatakǝn yahkǝnsa sǝn kachit i sǝk ɓat Yahudawecha muhhanhar Bulus, ɓakna kwasandǝhi, mbukǝn tǝ kapat ɓurat ndatwa, i sǝka pǝrischa tǝ fasakmicha kǝ ngomndǝhi. Ɓakǝn tǝ Bulus kǝ thlarnka mbanitǝnanda.<verse eid="ACT 22:30" /></para>
  <chapter eid="ACT 22" />
  <chapter number="23" style="c" sid="ACT 23" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1" />Thlaakǝ Bulus nakna kǝlandǝ fa sakmichǝkǝn, ndakǝnwa: "Kunang hwanmanchina, kǝ ɓukweeya a hur hanɗǝkiketengna mwa'u ǝn'sǝ ngweɗechin ndu ǝnat thlahur'i'ndǝ kǝ ɗar naɗengnǝhi a mbanitǝ Farawa." <verse eid="ACT 23:1" /><verse number="2" style="v" sid="ACT 23:2" />Kǝ sǝktǝndǝ kichu, thlaakǝ Hananiya kapat pǝrist, ndǝfkǝn fichile nak nduk tǝ Bulus, kǝ tǝpndǝnda mi. <verse eid="ACT 23:2" /><verse number="3" style="v" sid="ACT 23:3" />Ndak Buluswa: "Sokǝn kohat nifa! Sokǝn thlari pa'andǝ fichi fur kurrata, sokǝn ma na Fara tǝpsa! Sokkuhi kǝnna si kitasi kǝ ɗar sakandaɗa Musa, a landǝfku kǝ tǝpfichi nji, i nguchik keeke a hur sakakǝnnaɗi." <verse eid="ACT 23:3" /><verse number="4" style="v" sid="ACT 23:4" />Fichile nak kikit mbǝnniyu ndangnda Buluswa: ''Kapat Pǝristsa Farǝ natu era?'' <verse eid="ACT 23:4" /><verse number="5" style="v" sid="ACT 23:5" />Ndak Buluswa: "Hwanmanchina, a sǝnwiwa mǝllan naka kapat Pǝristwa. Kǝthlǝm a yeraɗficha a hur shunda Farǝ, ndatwa: "Mǝ erinǝ lǝhǝm mbanita nofchǝwa." <verse eid="ACT 23:5" /><verse number="6" style="v" sid="ACT 23:6" />Kǝ sǝntǝ Buluswa, funǝ Sadukiyawecha funǝ paɗ Farisawecha, thla'a'ǝn ɓurata hur fasakmicha, ndakǝnwa: "Hwanmancha, njangma lǝ Farisiyawat naki, Hweya Farisiyawa. Andiya kǝthlǝm ɗifi inndǝ kǝ ɗar thlata mǝmatcha ndǝkǝn sǝk natuni sakimiya." <verse eid="ACT 23:6" /><verse number="7" style="v" sid="ACT 23:7" />Kǝ mbuɗtǝn kichu, thlaakǝ halǝ'i'nda tinnda Farisiyawecha tǝ Sadukiyawecha, sakkǝ ngomnofchǝkǝnhi kurutkǝn chap. <verse eid="ACT 23:7" /><verse number="8" style="v" sid="ACT 23:8" />Ndak Sadukiyawechuwa, thlata mǝmatchǝsuwa, mala'ikachisǝwa, ndu Shemeɗa. Farisiyawecha kandang ngǝmmandǝwa neesi nat mǝkkanwa. <verse eid="ACT 23:8" /><verse number="9" style="v" sid="ACT 23:9" />Thlaakǝ kapat sheka'inda naknda shundǝ kǝ afshi, funǝ malndǝmchǝ fa sakandǝ kussa Musaɗi, Farisiyawecha thlarkǝndǝhi kit, naknda halǝ'innda, ndakndǝwa: "Kanang a mbǝssawani ɓǝɓi i'sǝt nifiyawa. Mbahya yunǝ Shemeɗa ndu mala'ika shunangnga." <verse eid="ACT 23:9" /><verse number="10" style="v" sid="ACT 23:10" />Kǝ thlaatǝ halǝ'inkǝn kaǝn, lechik kapat lǝ thlǝrhwatkǝn kǝthlǝm mǝni nda thlǝthlahhandǝ Bulus hi. Fǝrkǝn mi tǝndatwa, fathlǝrhwatkǝn kǝ tǝrndahaya kǝ thlǝndǝ Bulussa ɗǝ tǝ alchita, kǝ ɓandǝ tǝndǝ kǝ mbǝt sokta fa thlǝrhwata. <verse eid="ACT 23:10" /><verse number="11" style="v" sid="ACT 23:11" />Sǝk fiɗikta thlarkǝ Lǝmwandǝ nduk tǝ Bulus, ndakǝnwa: "Ɗu mban tǝ alchit hanɗǝkiketa, nda i fǝrtu sheta kǝ ɗarna a Urshelima, kichu paɗ kamkǝsi kǝ fǝrnǝ sheta ɗarna a Roma."<verse eid="ACT 23:11" /></para>
  <para style="s">Shiɗ Fichǝ Ɓǝɓi Sakta kǝ Ɓǝlang Fichǝ Bulus</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12" />Wendambǝta, Yahudawecha tahǝskǝndǝfa kǝthlǝm kǝ ɓallangndǝ Bulus. Akndǝ ichǝmi tǝ ndatwa, ngunda sǝmtǝwa ngunda satwa, se ma ɓǝllandǝ Bulus. <verse eid="ACT 23:12" /><verse number="13" style="v" sid="ACT 23:13" />Fichile sǝk ɓǝɓi tahasinifiyu, pǝɗanda nifǝhi kumchit fwaɗa. <verse eid="ACT 23:13" /><verse number="14" style="v" sid="ACT 23:14" />Ɗǝknda mbǝɗa pǝktat pǝristcha tǝ fa hǝmmbanita, ndakndǝwa: "A eɗɗani kapat ichimi tǝ ndatwa, ngani sǝm'ǝnwa ngani sat'ǝnwa sema ɓǝllaɗani Bulus. <verse eid="ACT 23:14" /><verse number="15" style="v" sid="ACT 23:15" />Kǝthlǝm kichu, nakǝnya kunang tǝ fasakmicha, hwanamǝn kapat lǝ thlǝrhwatkǝn, kǝ ɓaǝn Bulussa kuni, nda tǝ yahunisi kǝ ngǝruni sahamihar kaǝn, kanang paɗ tehshanifa kǝ ɓǝllangngani kana sata."<verse eid="ACT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16" />Kǝ sǝktǝ hweya hwanman Bulus witǝ tahasifǝ nanda sita, ɗǝkna yimta mbǝt sokta fathlǝrhwatkǝn mbwa'angna Bulus. <verse eid="ACT 23:16" /><verse number="17" style="v" sid="ACT 23:17" />Bulus akǝn yuna hur kapat fathlǝrhwata Roma, ndakǝnwa: "Ɗu tǝ hwankimshi'iya mbanitǝ kapat fathlǝrhwata, shundǝsǝ yahtǝnsa mbwa'anda." <verse eid="ACT 23:17" /><verse number="18" style="v" sid="ACT 23:18" />Kapat lǝthlǝrhwatkǝna Roma tǝrkǝn hankimshikǝn, ɗǝkǝn tǝnda mbǝɗa kapatnanda. Kapat lǝthlǝrhwatkǝnna Roma, ndakǝnwa: "Bulus hwan pursunatiyu, aknji, hwanikǝnwa kǝ ɓitǝ hwankimshi'iya mbǝɗeku, kǝthlǝm ǝnsǝ natna mbu'uta." <verse eid="ACT 23:18" /><verse number="19" style="v" sid="ACT 23:19" />Kapat lǝthlǝrhwatkǝn kǝskǝn hara kimshikǝn, kahkǝnda kǝlar, sahaǝn miya ɓuɓweeta: "Mǝnani yahtusa mbwi'itiyu?" <verse eid="ACT 23:19" /><verse number="20" style="v" sid="ACT 23:20" />Ndang kimshikǝnwa: "Pǝktecha Yahudawecha tahsandǝhi, nanda hwanuta kǝ ɗangnǝ Bulussa kanda mbanitǝ fasakmichǝ ishki, nda yahkǝndǝ kǝ ngǝrndǝ tausandǝ shuwunkǝn'enhi kaǝn. <verse eid="ACT 23:20" /><verse number="21" style="v" sid="ACT 23:21" />Paɗ mǝ ngǝmmana kandǝsǝwa, kǝthlǝm pǝɗaɗa nifǝhi kumchit fwaɗa kanda ɗuwetndi kanda kat kǝ ɓǝllangnda, paɗ tepa eɗndǝ i'chimi ndatwa, ngunda sǝmtǝwa ngunda satwa sema ɓǝllanda. Nakǝnya a tehishndǝfa, ngǝmteku ndak nannda puta." <verse eid="ACT 23:21" /><verse number="22" style="v" sid="ACT 23:22" />Kahhang kapat Lǝthlǝrhwatkǝn thlǝmata hwankimshikǝn tǝ ndatwa: "Mǝ mbwa'ana yunuwa mbu'i'nǝ shuniyawa." Kalkǝndǝhi kǝ pǝɗan.<verse eid="ACT 23:22" /></para>
  <para style="s">Thlindǝ Bulus kǝ Mbǝɗa Ngomna Felis</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23" />Kapat lǝthlǝrhwatkǝn akǝn pǝktat fa thlǝrhwechǝkǝnna Roma chap, ndangnakandǝwa: "Tahsamfa ɗukuni Kaisariya, hwanthlikǝn hanherta i'fiɗikta tǝ fa thlǝrhwechǝ kumchitkum chap, tǝ kumchit muɗ fa pǝrpirishcha, tǝ fa thlǝrhwat kumchitkum chap fa mbat tǝ pela." <verse eid="ACT 23:23" /><verse number="24" style="v" sid="ACT 23:24" />Kǝ kuni pirshihar le nat Bulussa pǝrtǝsi, kǝ ɗunitǝnda mbǝɗa Ngomna Felis ngwalngwal. <verse eid="ACT 23:24" /><verse number="25" style="v" sid="ACT 23:25" />Yarakǝn ɗelwer nda iya:<verse eid="ACT 23:25" /></para>
  <para style="pmo">
    <verse number="26" style="v" sid="ACT 23:26" />"Thlata Kalaudiyas Lisiyas,</para>
  <para style="pmo" vid="ACT 23:26">Kǝ mbǝɗa lǝ mwandǝ Ngomna Felis. Ndat ǝn oi.<verse eid="ACT 23:26" /></para>
  <para style="pm">
    <verse number="27" style="v" sid="ACT 23:27" />Nifiya kǝsandǝ Yahudawecha, ndukndǝhi kǝ ɓǝllangnda, thlaaki leɗleɗ tǝ fathlǝrhwecha thlǝkindaɗi, kǝthlǝm a shikiwa mǝllan hwanhǝmǝt Roma nakǝn. <verse eid="ACT 23:27" /><verse number="28" style="v" sid="ACT 23:28" />Yahkisǝ kǝ sǝki isǝtǝn nannda tǝramifa, ɗǝkitǝnda mbanitǝ fasakmichengnanda. <verse eid="ACT 23:28" /><verse number="29" style="v" sid="ACT 23:29" />Ɓaki mbǝssandǝwa naknda tǝramifa kǝɗar shuwun sakandengna nda ɗaɗi, kǝthlǝm i'sǝtǝn saawa ɗǝffandafǝ kǝ kǝnangnda ndu kǝ ɓǝllangndǝwa. <verse eid="ACT 23:29" /><verse number="30" style="v" sid="ACT 23:30" />Kǝ mbu'i'tǝfichiwa ɓǝɓi ǝnsǝ natficha yarandǝfa, chatkichuyu thlǝnukindi. Ndǝkǝn ndandǝ fichile muhkǝ hanharkǝnwa, kǝ ɗǝnda mbuta mbanituwa i'nat ndǝ sǝtǝn ndǝɗuwayu." <verse eid="ACT 23:30" /><verse number="31" style="v" sid="ACT 23:31" />Kǝthlǝm ndǝkǝn fa thlǝrhwatkǝn tǝrkǝndǝ Bulus, nda i mbwa'andǝ ficha kanda, ɗǝkndǝ tǝndi kǝ Antifatiris a fiɗikta. <verse eid="ACT 23:31" /><verse number="32" style="v" sid="ACT 23:32" />Ɓingngitkǝn malkǝndǝ fa thlǝrhwatkǝn fichile la pǝr kǝ pirishcha kǝ ɗǝnda mbantǝndi, kandang paɗ ngǝrangndǝ'inna mbǝtsoktengnanda. <verse eid="ACT 23:32" /><verse number="33" style="v" sid="ACT 23:33" />Kǝ ɓat fathlǝrhwatkǝn, fichile la pǝr kǝ pirihcha saakǝnnda Kaisariya, fǝrangndǝ ɗelwera ngomna, malkǝndǝ Bulushi a hurhar'en. <verse eid="ACT 23:33" /><verse number="34" style="v" sid="ACT 23:34" />Kǝ changkandǝ ngomna ɗelwertǝkǝn, sahaǝn mi Bulus ndu ɓakna hǝmmǝt mi? sǝkǝnwa ɓakna Kilikiya, <verse eid="ACT 23:34" /><verse number="35" style="v" sid="ACT 23:35" />ndakǝnwa: "Ni kathlǝmmata shundeku, a fari ɓatfichile muhkǝ hanharwa: "Ndǝkǝn fǝrtǝ ngomna shunda kǝ ngǝllangficha, a huri kuturichita Hiridus le tintǝn. Kǝ puufichindǝhar.<verse eid="ACT 23:35" /></para>
  <chapter eid="ACT 23" />
  <chapter number="24" style="c" sid="ACT 24" />
  <para style="s">Mwih Yahudawechǝ Hanhar Bulus</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1" />Ɗiffitǝ munndǝ ndurman kapat pǝrist Hananiya, ɓeɗ tǝ funǝ pǝktecha, Paɗ tǝ yunǝ lǝmbǝr shunda le nat thlǝmkǝnwa Tartulus. Kǝthlǝm kǝ muhndǝ hanhar Bulus a ɓanitǝ ngomna. <verse eid="ACT 24:1" /><verse number="2" style="v" sid="ACT 24:2" />A yimang fichi Bulussi, Tǝrkaakǝ Tartulus muh hanhar Bulussa ɓanitǝ ngomna Felis, ndakǝnwa: "Nakǝn tǝ ɓǝɗa sǝndeku sandǝ fichi kachit nofchengnǝm, Paɗ kǝthlǝm lakǝllaku langnga, ndǝkǝn sǝk tahǝstǝ fichi ichi oi fichile sokka kachitta nofchengnǝm. <verse eid="ACT 24:2" /><verse number="3" style="v" sid="ACT 24:3" />Nofchengnǝm chika ayi kanda su usoko nga sǝrtǝfuwa. <verse eid="ACT 24:3" /><verse number="4" style="v" sid="ACT 24:4" />Paɗ kǝthlǝm mǝ sǝɓaɗi hanthlik chikǝn eku'ndǝwa, nja hwanuta hur kachiɗeku Kǝ kangnǝ thlǝmmata i nguɗǝh nattani ɓuta. <verse eid="ACT 24:4" /><verse number="5" style="v" sid="ACT 24:5" />Mbǝssaɗani ndatwa nifiya lǝ ɓat tǝ thlahur'inda, lanakna ɓat tǝ thlahur'inda thlerǝ Yahudawecha, chika tǝteni a hur kishita, Paɗ mǝllan nalǝ mbanita i leki la atfichiwa Nazarawa. <verse eid="ACT 24:5" /><verse number="6" style="v" sid="ACT 24:6" />Keɗ kǝ tǝkmaǝn kapat hura'a Fara ɗi, Paɗ a kǝssangngani. <verse eid="ACT 24:6" /><verse number="7" style="v" sid="ACT 24:7" />Paɗ Lisiyas lǝ ɓanita, ɓakna thlǝtndaɗaɗi harengnani tǝ alchitta. <verse eid="ACT 24:7" /><verse number="8" style="v" sid="ACT 24:8" />A ɗiftǝ fa muhhanhar nifiya kǝ ɓanda ɓanituwa. Ma usanǝ mihar sokǝn tǝ i'ndeku, nu mbǝlla sǝnda mbǝɗ'en nat ichi nattani muh hanharkǝn.<verse eid="ACT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 24:9" />Yahudawecha kwiyirndǝ ɗiffitǝkǝn kichu. Ngǝmangndǝwa, nak ǝnnatkǝn kichu.<verse eid="ACT 24:9" /></para>
  <para style="s">Hǝrka Bulus Fat'enna Mbanitǝ Felis</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10" />Fǝrang ngomna mba shunda Bulus, ndǝkǝn ngǝmandǝ Bulus ndakǝnwa: "Ni hǝrkandǝ indengna tǝ chiɗchiɗchit hanɗǝkiketa, kǝthlǝm shiniwa shiɗnǝ hurechǝ oi, sassa kiita nofchiya. <verse eid="ACT 24:10" /><verse number="11" style="v" sid="ACT 24:11" />Ma tausanǝhi nu mbǝssandǝ wa, mbǝrawa munndǝhi kumngǝrǝnsǝchapwa, Kǝ pǝɗati Urshelima ka hwanda. <verse eid="ACT 24:11" /><verse number="12" style="v" sid="ACT 24:12" />Fa muh hanharnǝtiya tamunda mbǝssitǝ nja halǝ'i'ndǝ tǝ nifǝwa, ndu nja thla'andǝ hur'i'nda nofcha kapat hura'a Fara ndu a mbǝt humta Yahudawecha, ndu a hur hǝmǝtkǝn. <verse eid="ACT 24:12" /><verse number="13" style="v" sid="ACT 24:13" />Ichi nat'nda mbuta ɗar i'ndengnǝ nakǝnya ngunda mbǝlla fǝru sǝndǝwa. <verse eid="ACT 24:13" /><verse number="14" style="v" sid="ACT 24:14" />Ən ǝrtǝ ngǝmandi, ndǝkǝn naka nja kuwur Fara kakechengnǝm tǝ mbanda nofchi la kuwurkǝ Yǝso, la atfichiwa Nazarawa, lǝnaki fǝrkitta ɗar ichi uf yarandǝ fichihi nda i lasakandǝ Musaɗi paɗ tǝ laulawecha Tapǝnecha. <verse eid="ACT 24:14" /><verse number="15" style="v" sid="ACT 24:15" />Nja ɗǝf hanɗǝkiketa mbǝɗa Fara, nda i nat fichileya sǝta, ndatwa, naficha thla'andǝ mǝmatcha, fa kafata tǝ fa ɓah kafat nat. <verse eid="ACT 24:15" /><verse number="16" style="v" sid="ACT 24:16" />Ndǝkǝn sǝk pware lanati kweetǝhi a hanɗǝkiketengna, kǝ soki nga kweeɗechinna mbanitǝ Farǝ tǝ nofchǝwa. <verse eid="ACT 24:16" /><verse number="17" style="v" sid="ACT 24:17" />Paɗ ɗiffitǝ hanhurechǝ nguɗeh, ɓakiɗi kǝ Urshelima kǝthlǝm kǝ fǝripoffǝn kǝ mbǝɗa nofchengnǝm, paɗ tǝ thlǝr icha. <verse eid="ACT 24:17" /><verse number="18" style="v" sid="ACT 24:18" />Nja hur sǝt kichu, mbǝssikǝnda shepiɗi a hur kapat hura'a Fara, nga tǝ ngomnofchǝwa, ndu thla hur'i'ndǝwa. <verse eid="ACT 24:18" /><verse number="19" style="v" sid="ACT 24:19" />Funǝ Yahudawechǝsi a hachahai Asiya fichile naka mbǝnniyu, kandang kamkǝsi kǝ ɓanda mbanituwa ka muh hanharna, ma shundengnandǝsi kǝ faɗengna. <verse eid="ACT 24:19" /><verse number="20" style="v" sid="ACT 24:20" />Mangakichuwa malamǝn nofchiya kǝ mbundǝ i mbǝssitǝndǝsi a fari thlartihi mbanitǝ fa sakmicha. <verse eid="ACT 24:20" /><verse number="21" style="v" sid="ACT 24:21" />Manga kǝ ɗar i'ǝrtǝ mbwa'andi kish tǝ alchita fari thlartihi mbanitǝnandǝ ndatwa: "Lenaka ɗar thlaata mǝmatcha, sǝk nati mbanitǝnuni ɓukweya."<verse eid="ACT 24:21" /></para>
  <para style="s">Kuɓla Fichi Bulus a Kaisariya</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22" />Felis paɗ nakǝn tǝ sakǝt sinnda kǝ ɗar mbanda Yǝso, thlaraǝn kandǝhi, ndakǝnwa: "Sema ɓeɗ Lisiyas lǝmbanitǝ kwaɗǝn kani thlandǝ kiita engnunihi. <verse eid="ACT 24:22" /><verse number="23" style="v" sid="ACT 24:23" />Ndǝkǝn fǝrtǝ Felis shundǝ kǝ mbǝɗa kapat lǝthlǝrhwata Roma, kǝnna pu Bulus har, Paɗ kǝ fǝraɗǝ pwene oi wa, kǝ njaɗa shikechǝkǝn kǝ ɓanda mbǝɗ'enwa, ndu kǝ kǝssangndǝsuwa. <verse eid="ACT 24:23" /><verse number="24" style="v" sid="ACT 24:24" />Ɗiffitǝ hanmunchikǝn ɓaknda Felis tǝ nuhkǝn Durusila, lǝ Yahudawata, a thlǝnkǝn kǝ ɓa fichi tǝ Bulus, a kaǝn thlǝmmata kǝ ɗar shuwun kitchita Yǝso Kǝrǝsti. <verse eid="ACT 24:24" /><verse number="25" style="v" sid="ACT 24:25" />Tǝrkaakǝ Bulussa fǝr sakǝtkǝn kǝ ɗar kitchitta, tǝ pǝɗa yah ǝnat alchitta fat hi, tǝ farǝ ɓahhi naka ɓatyu. Sǝkkǝn kichu kǝsang lechit Felis, ndangna Buluswa: "Nakǝnya ngǝran'in. Ma mbisshi mbanda ni atsa." <verse eid="ACT 24:25" /><verse number="26" style="v" sid="ACT 24:26" />Mǝlla ɗǝf hanɗǝkiketǝsuwa na Bulussa fǝraa hanɗǝɓǝlta, ndǝkǝn sǝknat Felissa nata atndǝ noknok kǝna shundǝ tǝndi. <verse eid="ACT 24:26" /><verse number="27" style="v" sid="ACT 24:27" />Paɗ a ɗiffitǝ hurat chap, sǝk Fokiyus Festus kǝ ngomna kǝ kwar Felis. kǝthlǝm Felis mǝlla kat chiɗchiɗachita fwara mbanitǝ Yahudawecha, ndǝkǝn sǝk maltǝn Bulussa pursuna.<verse eid="ACT 24:27" /></para>
  <chapter eid="ACT 24" />
  <chapter number="25" style="c" sid="ACT 25" />
  <para style="s">Thla'a Bulus Muhhanhar'en kǝ Mbanitǝ Kaisar</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1" />Ɗiffiti munndǝ mǝkkan, saakǝ Festus kǝthlǝm kǝ kǝssǝn tor ngomnachita, thlaakǝna Kaisariya pǝɗakna Urshelima. <verse eid="ACT 25:1" /><verse number="2" style="v" sid="ACT 25:2" />Pǝktat Pǝristcha tǝ fa hǝmmbanita Yahudawecha, ɗǝknda muh hanhar Bulussa mbǝɗ'en. <verse eid="ACT 25:2" /><verse number="3" style="v" sid="ACT 25:3" />Hwanangnda, kǝ ngǝrang fichi Bulus kǝ Urshelima, kǝthlǝm a tahsandǝhi wa nanda ɓǝllanda mbanda. <verse eid="ACT 25:3" /><verse number="4" style="v" sid="ACT 25:4" />Ngǝmang Festus ndakǝnwa: Ndif fichi Bulus hi a Kaisariya, njang tǝ i'ndengna nja tǝrtǝhurwa ni ɗǝtta mbǝnniyu hanmunchiya. <verse eid="ACT 25:4" /><verse number="5" style="v" sid="ACT 25:5" />Ɗǝkǝn ndatǝn paɗwa kǝthlǝm kichu, pǝktechengnuni kǝ ɓandǝ tǝnji, ma nifiya ǝnsǝ sǝttǝn nga keekewa, Kǝ ɓanda muh hanharkǝn.<verse eid="ACT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6" />Mbǝrawa mundǝhi foɗfoɗǝ ndu kum a mbǝɗengnandǝwa, ndǝkǝn ngǝrandǝn'ina Kaisariya. Ɓingngitkǝn sokǝnna mbǝt soktǝ'en i'kiita, thlǝnkǝn kǝ ɓa fichi tǝ Bulussa mbanitǝkǝn. <verse eid="ACT 25:6" /><verse number="7" style="v" sid="ACT 25:7" />Kǝ ɓat Bulus, Yahudawechi ɓaka Urshelima thlaakǝnda taurangndǝhi, naknda ɓattǝ muh hanharengnandǝ oi kǝɗarkǝn, naknda cheka fǝra pwanchǝ kaǝn, ichi mbutǝnda ngunda mbǝla mbu kakatitǝkǝnwa. <verse eid="ACT 25:7" /><verse number="8" style="v" sid="ACT 25:8" />Paɗ Bulus hǝrkaǝn fat'en ndakǝnwa: "Njang sawi ɓǝɓi'ǝn sakta Yahudawechuwa, tǝ paɗ sawi ɓǝɓi'ǝn kapat hura'a Farǝwa, paɗ sawi ɓǝɓi'ǝn Kaisarwa chika nguɗehwa. <verse eid="ACT 25:8" /><verse number="9" style="v" sid="ACT 25:9" />Yahkǝ Festussa tǝraandǝ hanɗǝkiketa Yahudawechǝhi, sahaǝn mi Buluswa: "Ndunu ngǝmtǝfa kǝ ɗǝna Urshelima kǝ sukǝ fichi kiitasa mbanitǝna kǝ ɗar ichiniyu. <verse eid="ACT 25:9" /><verse number="10" style="v" sid="ACT 25:10" />Ndak Bulus wa: "Njang kitta mbanitǝ kiita Kaisar, a mbǝɗya kamkǝsi kǝ sikǝ fichi kiitasi. Sawi ɓǝɓi'ǝn Yahudawechiwa, sokǝnma shinnǝ kichu kaǝn. <verse eid="ACT 25:10" /><verse number="11" style="v" sid="ACT 25:11" />Ma njang la sǝk i kamuchiksi, paɗ mashiɗi ɓǝɓi'i saaka kǝ ɓǝllikǝ ficha, ngi cherifa kǝ ɓǝllikǝ fichǝwa. Paɗ manga kitchitsǝ kǝ ɗar muhhanhari nat nda muhta ɗarnǝwa, Paɗ nga nifǝsi na mbǝlla fǝrnja mbǝndengnandǝwa. Nja hwanda kǝ thla'ang fichi muh hanharengna mbanitǝ Kaisar. <verse eid="ACT 25:11" /><verse number="12" style="v" sid="ACT 25:12" />Ɗiffitǝ yarandǝ icha nda Festus hi tǝ fa sakmichi'en, ngǝmkǝn ndakǝnwa: "Makichu hwanu kǝ thla'ang fichǝ hanhareku kǝ mbǝnitǝ Kaisar paɗ natu pǝɗata."<verse eid="ACT 25:12" /></para>
  <para style="s">Bulus a Mbanitǝ Agiriffa tǝ Banis</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13" />Ɗiffitǝ hanmunchǝ ɗimek, Agiriffa kutura tǝ Banis ɓaknda Kaisariya kǝthlǝm kǝ sangndǝ marapa Festus. <verse eid="ACT 25:13" /><verse number="14" style="v" sid="ACT 25:14" />Nakǝn nanda sǝt hanmunchǝ oi a mbǝnniyu, ndǝkǝn ɓat Festus tǝ shuwun Bulus kǝ mbǝɗa kutura. Festus ndakǝnwa: "Nifǝsi malitǝ Felis hi a pursuna. <verse eid="ACT 25:14" /><verse number="15" style="v" sid="ACT 25:15" />Thlahmbǝɗi nati a Urshelima pǝktat Pǝrischa tǝ fa mbanicha Yahudawecha ɓikǝndǝ muh hanhar nifiya, hwanikǝnnda kǝ thlang fichi kiitasi. <verse eid="ACT 25:15" /><verse number="16" style="v" sid="ACT 25:16" />Paɗ ndayi kandǝwa, kanang Romawecha sǝnwanihi tǝ sa kiita le sǝk ɓǝɓi'ǝnwa, sema ɓeɗndǝtǝndi kǝ mbǝɗa fa muh hanharkǝn hwanitǝ tǝ hwanita, paɗ sema fǝraa fichi mbanda kǝthlǝm kǝ hǝrkaǝn i'ndi'en kǝ ɗar muh hanhari sǝt ficha. <verse eid="ACT 25:16" /><verse number="17" style="v" sid="ACT 25:17" />Kǝthlǝm kichu, ɓak nda mbǝɗya rǝmmǝ tǝ ndi, a sǝɓawi hanthlikǝnnaɗǝwa, ɓingnetkǝn sokki mbǝt soksakmiya, ɗǝfki ke ɓafichǝ tǝ nifǝkǝn. <verse eid="ACT 25:17" /><verse number="18" style="v" sid="ACT 25:18" />Kǝ thlaatǝ fa muh hanharkǝn, ɓundǝ tǝ muh hanharkǝn kǝ ɗar ɓǝɓi i nati yarǝ kǝ ɗarkǝnwa. <verse eid="ACT 25:18" /><verse number="19" style="v" sid="ACT 25:19" />Nakǝn shuwunchengnandǝsi le fǝruchit ndǝ kitsi kǝ ɗar Bulus, kǝ ɗar tǝr mbandengnanda, tǝ yunǝ wa Yǝso le mǝrka, Paɗ le thlartǝ Bulus tǝ alchitwa mǝllan tǝ shisshingtafa. <verse eid="ACT 25:19" /><verse number="20" style="v" sid="ACT 25:20" />Njang paɗ mbahki i nati tausandǝ ichihiya, sahayi Bulus ndu nan ngǝmtǝfa kǝ ɗǝka Urshelima kǝsang fichǝ kiitasi kǝ ɗar ichiniyu. <verse eid="ACT 25:20" /><verse number="21" style="v" sid="ACT 25:21" />Paɗ kak Bulus kǝthlarang fichǝ shundǝ'enhi, Kaisar kapat kutura kǝ thlaǝn kiita enhi, fǝrkǝn shunda kǝnna ficha pundǝhar kǝ fari nati thlǝnnda kǝ ndang ficha Kaisar. <verse eid="ACT 25:21" /><verse number="22" style="v" sid="ACT 25:22" />Agiriffa kutura ndangna Festus wa: "Njang ma ni ɓata kathlǝmmata nifiya tǝ i'ndengna." Festus ndakǝnwa: "Nu sǝkndǝ ishki. <verse eid="ACT 25:22" /><verse number="23" style="v" sid="ACT 25:23" />Wendambǝta Agiriffa tǝ Banis yimkǝndǝsi tǝ mwanda witǝ i kuturcha, ɓak ndǝ tǝ pǝktat fa mbecha tǝ pǝktecha hǝmǝtkǝn. Fǝrkǝ Festus shundǝ tǝndatwa kǝ yimang fichǝ Bulus kǝ kǝttǝn sakmiya. <verse eid="ACT 25:23" /><verse number="24" style="v" sid="ACT 25:24" />Ndǝkǝn ndat Festuswa: "Agiriffa kutura, nattǝ nofchi natǝm tǝ kandǝ rǝmma, a nifi ɓitǝ nofcha Yahudawechǝ hanharkǝn kǝ Urshelima, tǝ mbǝɗya paɗ, Kanda hwattǝ ndatwa Kammusǝ kǝ malfichi ndi tǝ shissingtǝwa. <verse eid="ACT 25:24" /><verse number="25" style="v" sid="ACT 25:25" />Paɗ njang nuwi i sǝttǝn le saaka i ɓǝllandǝwa. Nakǝn paɗ mǝllan tǝ i'ndi'en keɗ tǝ ndatwa kǝ ngǝrang fichi kita'enna mbanitǝ lǝ mwandǝ Kaisar, ndakiwa ni thlindǝ tǝndǝ mbǝɗ'en. <verse eid="ACT 25:25" /><verse number="26" style="v" sid="ACT 25:26" />Paɗ nga kakati tǝ shundǝsi nati yaranda kutura Roma lǝ mwandǝsǝwa. Kǝthlǝm ndǝkǝn ɓaki tǝ ndi kǝ mbanitǝnuni, kapatkǝnna mbanitǝwa sokǝn Agiriffa kutura, kǝthlǝm ɗiffitǝ usamihar ndu ni mbǝs i nati yarata ɗarkǝn. <verse eid="ACT 25:26" /><verse number="27" style="v" sid="ACT 25:27" />Kǝthlǝm njang a na ndengna, mbomchita kǝ thlǝn fichi hwan pursuna, nga tǝ cheɗ fichi ɓǝɓi ichi sǝtǝnwa."<verse eid="ACT 25:27" /></para>
  <chapter eid="ACT 25" />
  <chapter number="26" style="c" sid="ACT 26" />
  <para style="s">Hǝrka Bulus I'ndǝ'en a Mbanitǝ Agiriffa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1" />Ndang Agiriffa Bulus wa: "Fǝrrufichi mbanda ke hǝrkangnǝ i'ndeku." Thla'ang Bulus hara, tǝrkaakǝn shunda ndakǝnwa, <verse eid="ACT 26:1" /><verse number="2" style="v" sid="ACT 26:2" />A shiɗi sa'a, naki hǝrkandǝ i'ndengnǝ ɓukweya a mbanitǝ Agiriffa kutura kǝ yakat shuwunchi mbutǝ Yahudawechǝ kǝ ɗarna. <verse eid="ACT 26:2" /><verse number="3" style="v" sid="ACT 26:3" />Sokkǝn lǝ mbǝrtǝ naku sǝn ǝ'nat sǝtta Yahudawecha tǝ ichi lanatnda halǝ'i'nda ɗarkǝn. kǝthlǝm kichu nja hwanuta kǝ kikǝnnǝ thlǝmmata tǝ kǝrǝsta. <verse eid="ACT 26:3" /><verse number="4" style="v" sid="ACT 26:4" />Nat Yahudawecha shinndǝ witǝ soki sokti njang kǝ hwankimsha'a, thlata tǝrkakǝnna hǝmtengna paɗ tǝ Urshelima taakǝ ɓukweeya. <verse eid="ACT 26:4" /><verse number="5" style="v" sid="ACT 26:5" />Shinndǝ nji kǝ soh, paɗ ma yehndǝsi nanda mbǝlla fǝr sheta ndatwa, naki hur humihi sherkǝ tǝ kuwur kus a hur tǝr mbandengnǝm, sokki kǝlǝ Farisiyawata. <verse eid="ACT 26:5" /><verse number="6" style="v" sid="ACT 26:6" />Nakǝnya njang kitta mbanitǝnuni kǝthlǝm kǝ sikǝ fichi kiitasi kǝthlǝm ɗiffi hanɗkiketengna kǝ ɗar nǝhhata ɗǝf shuni fǝrandǝ Fara kakechinǝm. <verse eid="ACT 26:6" /><verse number="7" style="v" sid="ACT 26:7" />Ɗǝfshuwunkǝn naka kachitnǝm kumngǝrǝnsǝ chap ɗǝfkǝndǝsi mbah nanda nat nǝhatǝ'en, paɗ nak nda kǝn hursi tǝ kuwur Fara nda fiɗiktǝ tǝ fara. Sokǝn kutura, kǝthlǝm ɗiffi hanɗǝkiketa ɗar nǝhata ɗǝfshuniniyu, sǝk nat Yahudawecha tǝrimifa! <verse eid="ACT 26:7" /><verse number="8" style="v" sid="ACT 26:8" />Mǝ sǝka a naɗengnuni ɓahwanatwa na Fara thla'andǝ mǝmatchǝwa? <verse eid="ACT 26:8" /><verse number="9" style="v" sid="ACT 26:9" />Njang tǝ i'ndengnǝ soh kǝllayi nda keeke kǝ si ichǝ oi, kǝnji shunda Yǝso lǝ Nazaratta kǝ ɗǝka mban. <verse eid="ACT 26:9" /><verse number="10" style="v" sid="ACT 26:10" />I sǝti hacha a Urshelima, a mbishi alchita mbǝɗa pǝktat pǝrist cha, kǝthlǝm kǝ kuɓlayi fa tǝr mbandǝ oi kǝ pursuna. Tǝ Paɗ fari nat ficha ɓǝlandǝ kanda nja kuwur ɗiffitǝnanda. <verse eid="ACT 26:10" /><verse number="11" style="v" sid="ACT 26:11" />Lafǝrayi pwancha kanda mbǝt humta Yahudawechihi lǝɗǝfki kandǝ kǝ shuwunndǝ ɓǝɓishundǝ kǝ ɗar thlǝm Yǝso. Kǝthlǝm lanaki kǝs komlǝ tǝ kandǝ kaǝn, lǝ naki kuwur kandǝ kǝ funǝ hǝmchǝ somsomǝn kǝni sa pwanchǝ kanda.<verse eid="ACT 26:11" /></para>
  <para style="s">Bulus Mbu'tǝ Kusheng Tǝɓǝtǝ'enhi</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12" />Ficha hur sǝtkichu, farǝle nja pǝɗata Dimaska, tǝ yahta pǝktat pǝristcha tǝ yarat ɗelwerti fǝritǝnda. <verse eid="ACT 26:12" /><verse number="13" style="v" sid="ACT 26:13" />A hur hwatfara mbanda, Sokǝn kutura kǝ nanǝhi, neɗi ɗwachita le sherangnga ɗwachita hwatfara, finkǝnna afshi taurikǝnhi njang tǝ shikechi witengna. <verse eid="ACT 26:13" /><verse number="14" style="v" sid="ACT 26:14" />Uffani hǝmkanihi hachahaya, Sǝkki ɓurata nditǝ tǝ mi Ibraniyanci, 'Shawulu, 'Shawulu, Kǝthlǝmmi natu fǝri pwancha? Nanna fǝra pwene i'ndeku tǝ sǝt atikrechit tǝ nji.' <verse eid="ACT 26:14" /><verse number="15" style="v" sid="ACT 26:15" />Ndakiwa, 'Wunnaku Lǝmwanda? "Ndikǝ Lǝmwandǝwa, 'Njang Yǝso le natu fǝrapwancha. <verse eid="ACT 26:15" /><verse number="16" style="v" sid="ACT 26:16" />Paɗ thla'u kǝ thlarnǝhi kit. Cheɗki fandengna mbǝɗeku kǝ ɗǝffisa kǝllasi tora, paɗ kǝ fǝrnǝ sheta kǝ ichi natu kǝ ɗarna, paɗ tǝ ichi nati cheɗutǝ kǝ mban. <verse eid="ACT 26:16" /><verse number="17" style="v" sid="ACT 26:17" />Ni hǝrkuta mbǝnda nofcheku tǝ punochǝ paɗ. Ni thlinsa mbǝɗa punofchǝkǝn, <verse eid="ACT 26:17" /><verse number="18" style="v" sid="ACT 26:18" />Kǝthlǝm kǝ i'nangnǝ hwanichengnaɗǝhi, Kǝ tǝɓǝrndǝhi a hulta kǝ ɗwachitta, paɗ tǝ thlata alchita sheɗan kǝ alchita Fara, tǝ kichu nannda mbǝskaɓiɗi ɗar ɓǝɓichitfecha, tǝ mbǝs'ǝnhar nat tǝ fichile sokkǝ chiɗchiɗ kǝthlǝm a firndǝ kit kǝ mbǝɗengna. <verse eid="ACT 26:18" /><verse number="19" style="v" sid="ACT 26:19" />Kǝthlǝm kichu, sokǝn Agiriffa kutura, a cherwi kǝ fǝrayi mwanda ǝnnda sǝnnatǝwa ɓaka haiya afshi kǝ mbǝɗengna. <verse eid="ACT 26:19" /><verse number="20" style="v" sid="ACT 26:20" />Tǝrkaaki ɓasanda nofchisa Dimaska, kani sanda nofchǝsa Urshelima chika ayi a thlet hǝmmǝt Yahudawecha, sayi punofchǝsǝ paɗ, ndatwa kǝ tǝrɗǝhi kǝ tǝmǝrɗǝhi kǝ mbǝɗa Fara, kǝ sǝndǝ ichi nachetǝwa tirɗǝhi. <verse eid="ACT 26:20" /><verse number="21" style="v" sid="ACT 26:21" />Ndǝkǝn sǝk kǝssitǝ Yahudawecha a kapat hura'a Fara, naknda kat kǝ ɓǝllikǝnnda. <verse eid="ACT 26:21" /><verse number="22" style="v" sid="ACT 26:22" />Paɗ kǝssikǝ Farǝsi kǝ nakǝnya, ndǝkǝn nati mbǝɗya kǝni fǝr sheta kǝ ɓǝɗa pǝktecha tǝ hwecha. Nga ǝnsomǝn nati mbutuwa, se i nat Tapǝnnecha tǝ Musa ndatndǝwa nan sǝta, <verse eid="ACT 26:22" /><verse number="23" style="v" sid="ACT 26:23" />Keekesi Kǝrǝsti kǝ san pwane, kǝ sokka tǝrka thlata mǝmatcha, Kǝthlǝm kǝ ɓan tǝ ɗwachitta mbaɗa nofcha, Yahudawecha tǝ punofchǝ nat." <verse eid="ACT 26:23" /><verse number="24" style="v" sid="ACT 26:24" />Bulussa ɗar hǝrkandǝ fat'en Festus thlaǝn ɓurat tǝ alchita ndakǝnwa: "Bulus, luwurchǝ naka tǝrutǝwa! Yakat changngandeku tǝb'raɗǝ i'ndekuhi!" <verse eid="ACT 26:24" /><verse number="25" style="v" sid="ACT 26:25" />Ndak Bulus paɗwa: "Festus lǝmwanda, nga luwurchǝtǝrikǝwa. Kit nati mbuta a hur i'nda. <verse eid="ACT 26:25" /><verse number="26" style="v" sid="ACT 26:26" />Paɗ kutura shintǝ ichi natya, lǝ naki shunandǝ lechitfǝwa. A shinisǝwa kileesa ichini natyu, kǝthlǝm nga ɓuɓweetǝ sǝt fichiwa. <verse eid="ACT 26:26" /><verse number="27" style="v" sid="ACT 26:27" />Agiriffa kutura, a firnǝ kit tǝ Tapǝnnecha? A shiniwa firnǝ kit." <verse eid="ACT 26:27" /><verse number="28" style="v" sid="ACT 26:28" />Ndang Agiriffa Bulus wa: "A hur hanthlikchi ɗimekya yahtusa lǝmnji kǝsi Kǝrǝsta?" <verse eid="ACT 26:28" /><verse number="29" style="v" sid="ACT 26:29" />Bulus paɗ ndakǝnwa: "Chika hanthlikchǝ ɗimek, ndu njang ndu nga njangwa nja hwandǝ tǝ ndatwa kǝɗǝf Fara mǝniɗa sokǝn ɗengwa, nat tǝ fichile naka sǝknji ɓukweya, kǝnandǝ nda i'nati, nga nat tǝ chalalotiyawa." <verse eid="ACT 26:29" /><verse number="30" style="v" sid="ACT 26:30" />Thlaakǝ kutura, kichu paɗ ngomna tǝ Banis tǝ fichile natndǝ ɗǝndassa mbǝt ǝrta. <verse eid="ACT 26:30" /><verse number="31" style="v" sid="ACT 26:31" />Cheknda kishsha mbǝt kiita ndangnda ndaniwa: "Nifiya sutǝ i'kamkǝsi kǝkuɓlang fichǝwa, ndu kǝ ɓǝlang fichǝwa." <verse eid="ACT 26:31" /><verse number="32" style="v" sid="ACT 26:32" />Ndang Agiriffa Festus wa: "Ma nga i'nakǝn nifiya thla'a ɗǝ muh hanhar'enna ɓanitǝ Kaisar wa, ma kǝ kalfichǝndǝhi."<verse eid="ACT 26:32" /></para>
  <chapter eid="ACT 26" />
  <chapter number="27" style="c" sid="ACT 27" />
  <para style="s">Bulus Yimma Kommbawal kǝ Roma</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1" />Kǝ tahsandǝ fichi kanihi hur kommbawal kǝ thlaani kǝ thlet hǝmmǝt Italiya, Ndekǝn fǝrtǝɗǝ Bulus tǝ funǝ hwanchǝ pursunacha a hara kapat lǝthlǝrhwata Roma le nat thlǝmkǝnwa Yuliyus, ǝrta hurfa thlǝrhwatkǝna Kaisar Augustus. <verse eid="ACT 27:1" /><verse number="2" style="v" sid="ACT 27:2" />Yimkani kommbawal tǝ le i Adiramitiyum, le tahǝskǝ thlaata kǝ thlet hǝmchi naka kǝllarǝ Asiya, Tǝrkaakani wita. Aristarkus lǝ Tasalonikata i hachahai Makidoniya, mǝllan tǝkǝm. <verse eid="ACT 27:2" /><verse number="3" style="v" sid="ACT 27:3" />Ɓingǝtkǝn kana Sidon. Yuliyus chendaǝn kafata Bulus, kǝ ɗǝka nat shikechikǝn, kǝ kǝssangndǝsi. <verse eid="ACT 27:3" /><verse number="4" style="v" sid="ACT 27:4" />Thlaakani mbǝɗya hur kommbawal nak rǝnna'a ɓahhandǝ kani. Kǝthlǝm ndǝkǝn ɗǝkani tǝ ɗiffitǝ tingring Sayifurus mbǝɗi nguchit rǝnnaa tǝ alchitsi. <verse eid="ACT 27:4" /><verse number="5" style="v" sid="ACT 27:5" />Ɗiffitǝ cheɗǝngnanikishsha hawurkǝn le nak nduk tǝ hachahai Kilikiya tǝ Famfiliya, Saakani Mira hachahai Likiya. <verse eid="ACT 27:5" /><verse number="6" style="v" sid="ACT 27:6" />A mbǝnniyu kapat lǝ thlǝrhwata Romawecha mbǝskǝn kommbawalla Alekzandariya lǝ ɗǝta hachahai Italiya, Sikǝnkani hurkǝn. <verse eid="ACT 27:6" /><verse number="7" style="v" sid="ACT 27:7" />Sǝkani mundǝ tǝ muncha kweekani nata witǝ hǝɓakka, tǝ kweetǝ saatani nduk kǝ hǝmǝt Kinidus. Kǝ njandǝ rǝna'a kani ɗǝta mban, Kuwurkani tǝ kǝllar tǝ mbǝɗi nguchit rǝnnasi, tǝ ɗiffitǝ tingring Kirit nduk tǝ Salmoni. <verse eid="ACT 27:7" /><verse number="8" style="v" sid="ACT 27:8" />Nakani kwee mbǝrandǝhi, kǝ mbǝɗi lǝ atfichiwa Kwescha mbǝt thlara kammbawalcha, nduk tǝ hǝmǝt Lasiya. <verse eid="ACT 27:8" /><verse number="9" style="v" sid="ACT 27:9" />Nakǝn sǝɓafichi hanthlikchaɗi oi, wikǝn paɗ sokkǝn tǝ mboro, kǝthlǝm a hanthlikchiniyu shiɗ hurat langnga har kǝ farǝ kǝr kwisshimta i farǝ ɓǝɓichitfata mbirhi. Tiɗɗang Bulus thlǝmmechengnanda. <verse eid="ACT 27:9" /><verse number="10" style="v" sid="ACT 27:10" />Ndangna kandǝwa: "Shisshingchengnuni kǝ sǝn tolla, Kǝllaɗi wiiya nannat tǝ mboro paɗ tǝ kuɓat ichi oi, nga kuɓat icha kommbawal ndengwa nat tǝ Shisshingchengnǝm."<verse eid="ACT 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 27:11" />Kapat lǝthǝrhwatkǝn ngǝmaǝn tǝ i mbutǝ Buluswa, Kǝthlǝm kichu kan thlǝmata shunda lǝ koharǝ kommbawaltǝkǝn paɗ tǝlǝ kommbawal tǝkǝn. <verse eid="ACT 27:11" /><verse number="12" style="v" sid="ACT 27:12" />Nakǝn mbǝt ngomta kommbawalcha Lasiya su keeke kǝ sok kommbawalchi fekta mbǝɗyawa, nakǝn yakat funengnani ngǝmkǝndǝfa kǝ ɗaficha mban tǝ wita, Paɗ kǝ kweefichihi kǝ saa ficha Finiks manan sǝtta, kǝthlǝm kǝ sokɗǝ fekta mbǝnniyu. Finiks mbǝt humta kommbawalchihi a chicheng Kirit le naka kǝllaɗǝ kukuwun hishingta tǝ mbǝt hǝmfara, paɗ tǝ kukuwun harsǝmta tǝ mbǝt hǝmfara.<verse eid="ACT 27:12" /></para>
  <para style="s">Kapat Rǝnna'a Hawurta</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13" />Tǝrkaakǝ rǝnnaa thlata tǝ kukkuwun harsǝmtǝ ngunngundeh, saǝn nofchifiyuwa nanda mbǝlla sǝt i naka handǝkikechengnanda, kahangndǝ tǝppasiɗǝ kǝskǝ kommbawal tǝkǝn har, kuwurkǝndǝ tǝ chicheng Kirit, nduk tǝ mi hawurta. <verse eid="ACT 27:13" /><verse number="14" style="v" sid="ACT 27:14" />Su tolluwa ɓak kapat rǝnna'a tǝ kukuwun harsǝmta tǝ mbǝt chet fara, thlaakǝ rǝnnǝkǝna tingringta. <verse eid="ACT 27:14" /><verse number="15" style="v" sid="ACT 27:15" />Kǝtǝptǝ rǝnnikǝn kommbawaltǝkǝn, hulangna kǝllaɗǝ rǝnnikǝn, ndǝkǝn malandani nak rǝnnikǝna pǝkkani. <verse eid="ACT 27:15" /><verse number="16" style="v" sid="ACT 27:16" />Kuwurkani tǝ ɗiffitǝ hantingringta le nat thlǝmkǝnwa Kauda, mbǝɗi tahtǝ alchita rǝnnahi, kweekani kahhandǝ kommbawal tǝkǝn ka ɗǝfta mi chichengta. <verse eid="ACT 27:16" /><verse number="17" style="v" sid="ACT 27:17" />Ɗiffitǝ kahhandǝ hwan kommbawal tǝkǝn kǝ hur kapat kommbawaltǝkǝn, ɗathlkǝnda kǝnang ndǝhi kǝffa kapat kommbawaltǝkǝn kǝthlǝm mǝninda fǝffathlaɗi. Tǝrangndǝ kuwurta kommbawaltǝkǝnna haya mbah na rǝnna'a njek nda kǝllar kǝthlǝm mbǝlla'undǝ koharǝkǝnwa, sǝkndǝ kichu kǝthlǝm kanda lechita mǝniɗa muh kanda hansohhi Sirtis lela mǝhɗang ichi uf. <verse eid="ACT 27:17" /><verse number="18" style="v" sid="ACT 27:18" />Kǝthlǝm rǝnnikǝna ɓahandǝkandǝ kaǝn, ɓingǝtkǝn tǝrkaakǝndǝ harandǝ ichihaya hur kommbawaltǝkǝn, somkǝnnda hur ama. <verse eid="ACT 27:18" /><verse number="19" style="v" sid="ACT 27:19" />A farǝ mǝkkatǝkǝn kandang tǝ harchengnanda sommangndǝ ǝnat tor kommbawalchikǝnnaɗi. <verse eid="ACT 27:19" /><verse number="20" style="v" sid="ACT 27:20" />Kǝ sǝtani munchǝ oi nuwani farǝ tǝ hanndǝrechuwa, paɗ kapat ɗǝf er tǝ rǝnna'a nakna tǝppandakani, kǝtangani hanɗǝkiketakish tǝ ndatwa ngani hǝrǝktǝwa. <verse eid="ACT 27:20" /><verse number="21" style="v" sid="ACT 27:21" />Nakǝn mwinndǝhi sǝmunɗǝ ɗǝsǝmtǝwa, thlaakǝ Bulus kit a hurnanda, ndakǝnwa: "Nofcha, mamashikuni shundengna, tǝndatwa mǝ thla'iɗuni a tingring Kiritwa, ma hǝmwuni hur mboro tǝ kuɓat'ichiyawa. <verse eid="ACT 27:21" /><verse number="22" style="v" sid="ACT 27:22" />Nakǝnya nja kahhandǝ thlemaɗengnuni sam alchit fata, kǝthlǝm nga yunǝsǝ nasǝt mboro tǝ shisshingtǝ'ena hurnuniwa, kommbawaltǝkǝn natficha sǝt mboro tǝkǝn ndak. <verse eid="ACT 27:22" /><verse number="23" style="v" sid="ACT 27:23" />Kǝthlǝm a fiɗiki ɓǝraayu mala'ika Fara le nati kǝ'ikǝn nati mwananda, thlarkǝn nduk tǝ nji, <verse eid="ACT 27:23" /><verse number="24" style="v" sid="ACT 27:24" />ndakǝnwa: "Buluswa, mǝlechinuwa. Sokǝn waat kǝthlarna mbanitǝ kaisar. Andiya paɗ tǝmbǝnda kafata Fara nan hǝrkandǝ shikechǝ witeku." <verse eid="ACT 27:24" /><verse number="25" style="v" sid="ACT 27:25" />Kǝthlǝm ndǝkǝn sam alchitafa kunang nofcha, kǝthlǝm firikit kǝ mbǝnda Farǝ tǝndatwa i'mbwi'itǝfichǝyu, nakna nat kichu. <verse eid="ACT 27:25" /><verse number="26" style="v" sid="ACT 27:26" />Sokkǝn waat kǝ muhang rǝnnaa kǝmmaɗi kǝ ɗar hansohi tingring le."<verse eid="ACT 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27" />A fiɗik kumgǝrǝnsǝ fwaɗa tǝkǝn, nak nda njekkani a hawur Meditereniya. A ɗarfiɗikta fa koharǝ kummbawaltǝkǝn tǝrkǝndǝwa nakani nduk tǝ hachahaya. <verse eid="ACT 27:27" /><verse number="28" style="v" sid="ACT 27:28" />Kikeɗangndǝ hwengngǝchitta amkǝn, mbǝssangndǝ a shee ishtǝ sarǝ aru tǝ kumchitchap. Ɗǝkkani mban kuɗeh ngǝrkǝnda kikeɗanda, mbǝskǝndǝ ishtǝ sarǝ kumchit hanherta. <verse eid="ACT 27:28" /><verse number="29" style="v" sid="ACT 27:29" />Kǝthlǝm rahlechita mǝɗi kommbawal egnani kuk ngwichǝwa, kalkǝndǝ ǝnnat thlarandǝ kommbawaltǝkǝn hi fichile nak lǝklǝk fwaɗa, tǝ ɗǝffitǝ kommbawaltǝkǝn kǝthlǝm kǝ njaǝnwita. Hwankǝndǝ Fara kǝthlǝm kǝ wenmbǝt leɗleɗ. <verse eid="ACT 27:29" /><verse number="30" style="v" sid="ACT 27:30" />Paɗ fa koharǝ kommbawaltǝkǝn kakndǝ mba hǝrǝkta. Tǝrangndǝ hwan kummbawaltǝkǝnna haya naknda sǝt ɗathla nda nanda tǝrandǝ tǝppasi hai lǝklǝkyu kǝ mbanitǝ kapat kommbawaltǝkǝn. <verse eid="ACT 27:30" /><verse number="31" style="v" sid="ACT 27:31" />Ndǝkǝn ndandǝ Bulussa kapat lǝthlǝrhwatkǝna Roma tǝ fathlǝrhwechǝkǝnwa: "Ma thlaru nofchihiya hur kommbawaltiyawa, nga mbandǝsǝ natuni hǝrǝktǝwa." <verse eid="ACT 27:31" /><verse number="32" style="v" sid="ACT 27:32" />Thlithlang fa thlǝrhwatkǝn sahǝt hwan kommbawal tǝkǝnaɗi kalkǝndǝhi kǝ pǝɗaka ɗar ama.<verse eid="ACT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33" />Kǝ nat mbǝt nduk wenda, hwanang Bulus kandǝwa kǝ sǝmndǝ ɗǝsǝmta ndakǝnwa: "Ɓukweya mundǝ kumngǝrǝnsǝ fwaɗa kuna puta, sǝmwuni ǝnwa. <verse eid="ACT 27:33" /><verse number="34" style="v" sid="ACT 27:34" />Kǝthlǝm ndǝkǝn nja hwanandǝkuni kǝ sǝmmuni ɗǝsǝmta kǝthlem ngwalngwalchit faɗengnuni paɗ yunǝsa hurnuni na mɓah hwasǝ'en chika ǝrtǝwa." <verse eid="ACT 27:34" /><verse number="35" style="v" sid="ACT 27:35" />Kǝ mbutǝn kichu, tǝrkǝn njohma saǝn usoko Fara a mbanitǝnanda chichaǝnhi tǝrkaakǝn chiita. <verse eid="ACT 27:35" /><verse number="36" style="v" sid="ACT 27:36" />Natnda mbǝskǝndǝ alchit sǝmɗǝsǝmta. <verse eid="ACT 27:36" /><verse number="37" style="v" sid="ACT 27:37" />Uffani hur kommbawaltǝkǝn nakani nifǝ aru kumkum chap tǝ kumchit muɗ ngǝrǝnsǝ tehethl (276). <verse eid="ACT 27:37" /><verse number="38" style="v" sid="ACT 27:38" />Kǝ sǝmtǝnda ngelnda, tahhandǝ lǝkta kommbawaltǝkǝnhi, naknda som alkama hur ama.<verse eid="ACT 27:38" /></para>
  <para style="s">Fǝfathla Rahhaa Kommbawalaɗi</para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39" />Kǝ wentǝmbǝta, fa koharǝ kommbawaltǝkǝn mbǝsaundǝ furuɗi nanndǝwa, mbǝtsi nguɗuk tǝ hansohitǝsi. Tahaskǝndǝfa kǝ ɗǝndǝ tǝ kommbawaltǝkǝnna ɗar hansohikǝn manansǝta. <verse eid="ACT 27:39" /><verse number="40" style="v" sid="ACT 27:40" />Thlithlang ndǝ sahǝt tǝppaskǝnaɗǝ malkǝnda hur ama. Chatkichu paɗyu nangnda kwasandǝ sahchǝkǝnhi a fa i latǝprang kommbawaltǝkǝnhi. Thla'angndǝ kuwurchi naka kommbawaltǝkǝn keeke tǝ mbayi natrǝnnaa njekanda mban ɗǝffanndǝ innda kǝlarǝ hawurkǝn. <verse eid="ACT 27:40" /><verse number="41" style="v" sid="ACT 27:41" />Kǝ saatani mbǝtkǝmta ama, tǝpkǝ kommbawaltǝkǝn hansohita yimkǝ'innda kommbawaltǝkǝna hur hansohikǝn mbǝlla'utǝ hǝhǝrtǝfuwa. Tǝrkaakǝ kommbawaltǝkǝn fǝfathlǝɗi tǝ ɗiffi kǝthlǝm rahha'a.<verse eid="ACT 27:41" /></para>
  <para style="s">Fǝfethl Kommbawallaɗi</para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42" />Tahǝskǝ fathlǝrhwatkǝnfa kǝthlǝm kǝ ɓǝllangndǝ pursunechǝkǝn, mǝni yuneng nanda kun'ngoftǝ kǝ hǝrkǝn. <verse eid="ACT 27:42" /><verse number="43" style="v" sid="ACT 27:43" />Nakǝn kapat lǝthlǝrhwatkǝnna Roma yehsa hǝrkandǝ Bulus, njangnakanda. Fǝrkǝn shundǝ tǝ alchita ndatwa: "Nat fichile mbǝrkǝ ama kǝ pǝparnda hurkǝn kǝ chang ndǝ kǝ mi chicheng le." <verse eid="ACT 27:43" /><verse number="44" style="v" sid="ACT 27:44" />Tahhǝt pursunachǝkǝn kǝ tǝrnda ɗar chichet afchǝkǝn ndu hur chichet kommbawaltǝkǝn. Tǝkichu chetndakish kǝ mi chichengkǝn ngwalngwal.<verse eid="ACT 27:44" /></para>
  <chapter eid="ACT 27" />
  <chapter number="28" style="c" sid="ACT 28" />
  <para style="s">Bulus a Tingring Malta</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1" />Ɗiffitǝ hǝrǝktengnani, sǝkaniwa, awi thlǝm tingringǝyuwa Malta. <verse eid="ACT 28:1" /><verse number="2" style="v" sid="ACT 28:2" />Nofchi mbǝnniyu cheɗangdǝkafata kani kaǝn. Thlǝkndǝ kani natani, njihangndǝ hwatakani kǝthlǝm ersi paɗ mbitǝsi. <verse eid="ACT 28:2" /><verse number="3" style="v" sid="ACT 28:3" />Ngomkǝ Bulus afcha nakna sǝtta hwaɗiyu, chek hwithlnda kissha hur hwaɗiyu lenat yethaftǝ'en thlerthler, njo'aǝn hara Bulus. <verse eid="ACT 28:3" /><verse number="4" style="v" sid="ACT 28:4" />Kǝ nat nofchi naka mbǝnniyu hwithlinkǝnna hǝhhǝrtǝfa hara Bulus wangarra, ndangnda ndaniwa: "Kitchitkǝn nifiya lǝɓǝlfatanakǝn! Andiya, chikanakǝn hirikka hurhawurta, nattǝkichu alhaki enna kuwurndi nan mǝrta. <verse eid="ACT 28:4" /><verse number="5" style="v" sid="ACT 28:5" />Bulus paɗ saktaǝn har'en muhaǝn hwithinkǝnna hur hwata, mbǝsutǝ ndinditwa. <verse eid="ACT 28:5" /><verse number="6" style="v" sid="ACT 28:6" />Naǝn kandǝhiwa nan hǝthlta ndu kǝ hǝmǝnhi chat kǝ mǝrrǝn, sǝkndǝ tolla nunda saǝnwa, ngǝrkǝndǝ yarǝtǝ ndatwa mǝllan witǝ farǝ mǝ nakǝn. <verse eid="ACT 28:6" /><verse number="7" style="v" sid="ACT 28:7" />A mbǝɗǝ ndukya mbichisi i lǝ mbani tingringkǝn lǝ at fichiwa, Fubiliyus. Mǝllan thlǝk kani, fǝraǝn mbǝt munda kani ndiichin, kǝllakndǝsa kani, i'mundǝ mǝkkan. <verse eid="ACT 28:7" /><verse number="8" style="v" sid="ACT 28:8" />Shin Fubiliyus nduk tǝ hafat kakǝnnda tǝ i ɗǝlǝhta. Yimkǝ Bulussa thlǝmatken hwanaǝnsi, ɗǝffaǝn hara in, kǝnkǝ nifǝkǝnaɗi. <verse eid="ACT 28:8" /><verse number="9" style="v" sid="ACT 28:9" />Paɗ kǝ sǝkǝn kichu, nat tahǝt haacha fichile naka thlet tingringǝniyu naknda ɓata nak ficha kǝnandǝ kandaɗi. <verse eid="ACT 28:9" /><verse number="10" style="v" sid="ACT 28:10" />Fǝrangndǝ poffǝna kani oi. Nakani thlata kommbawal tǝkǝn, ngomangndǝ icha kani lenatani yahta.<verse eid="ACT 28:10" /></para>
  <para style="s">Shee Bulus kǝ Hǝmǝt Roma</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11" />Ɗiffitǝ ndǝraa mǝkkan, thlaakani a tingring Malta hur kommbawal Alekzandiriya le tumbang fekta tingringkǝn. Tahsa fichi mirshing mǝhɗat hwanmanchisi nda farǝcha. <verse eid="ACT 28:11" /><verse number="12" style="v" sid="ACT 28:12" />Ɓakani Sirakus munkani mǝkkanna mbǝnniyu. <verse eid="ACT 28:12" /><verse number="13" style="v" sid="ACT 28:13" />A mbǝɗya paɗ pǝɗakani kǝ Rikiyum. Ɗiffitǝ mundǝ ǝrta, thlaakǝ rǝnnǝ kukuwun harsǝmta, Wendambǝt paɗ saakani Futiyoli. <verse eid="ACT 28:13" /><verse number="14" style="v" sid="ACT 28:14" />A mbǝnniyu kǝmkani tǝ hwanmancha fa fǝrkit, hwanangndǝ kani kǝ sani mundǝ muɗ tǝ kanda. Tǝ kichu saatani Roma. <verse eid="ACT 28:14" /><verse number="15" style="v" sid="ACT 28:15" />Kǝ sǝktǝ fa tǝrmbanda Roma kusengnani, ɓaknda sa marapa kani a lumo Affiyus, tǝ paɗ mbǝndi la ndat fichiwa mbǝt tǝrtahai Mǝkkan. Nak Bulus kanda saǝn usoko Fara, ngǝrkǝn mbǝs alchitafa. <verse eid="ACT 28:15" /><verse number="16" style="v" sid="ACT 28:16" />Kǝ yimtani Roma ngǝmang ficha Bulus si kǝɗa sokta a huri haiya rǝmmǝ tǝ lǝ thlǝrwhaɗi naka pundǝhar.<verse eid="ACT 28:16" /></para>
  <para style="s">Ɓasa Bulus a Roma</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17" />Ɗiffitǝ mundǝ mǝkkan, Bulus akǝn pǝktat Yahudawecha ngomkǝndǝhi ndǝkǝn ndandǝna kandǝwa: "Kunang hwanmancha, chika nakǝn sawi ɓǝɓi'ǝn nofchengnǝmwa, ndu ɓǝɓi'ǝn i tǝrmbanda kakechengnǝm, nat tǝ kichu a kǝssi ficha a Urshelima fǝrkǝfichi nji kǝ Roma kǝkǝnnikǝnda. <verse eid="ACT 28:17" /><verse number="18" style="v" sid="ACT 28:18" />Kandang paɗ kǝ usitǝndǝmihar, Yahkǝndǝsi kǝ kalndǝ njihi, kǝthlǝm mbǝsiwundǝ tǝ ɓǝɓi'ǝn le saaka ɓǝllitǝwa. <verse eid="ACT 28:18" /><verse number="19" style="v" sid="ACT 28:19" />Paɗ cherkǝ Yahudawechi ngǝmtǝfa, ɓakna soktǝ waat kǝ tǝrayi muh hanharengna mbanitǝ Kaisar, chikanakǝn ngatǝni muh hanhar nofchengnǝmwa. <verse eid="ACT 28:19" /><verse number="20" style="v" sid="ACT 28:20" />Ndǝkǝn sǝk kati kǝ nikuni, paɗ kǝ yaraam ichihi tǝ kuni, kǝthlǝm le ndǝftǝ Isra'ilawechǝ hanndǝkiketa natnda pu'ɓat'en sǝk kǝnitificha tǝ chalalocha." <verse eid="ACT 28:20" /><verse number="21" style="v" sid="ACT 28:21" />Ndǝkǝn ndaɗǝɗǝwa: "Kanang mbǝswani yarat ndelwer a thlet hǝmǝt Yahudiya kǝ ɗarwuwa, nga yunǝ hwanmananisi ɓak tǝ kushengwuwa ndu kǝ mbu'un ɓǝɓi shunda ɗarwuwa. <verse eid="ACT 28:21" /><verse number="22" style="v" sid="ACT 28:22" />Paɗ yahkanisi kǝ sǝkani yareku amiyeku, kǝthlǝm i sǝntani, yuwa humǝhi i lekiyu chikawuni mǝla shuwun ɓǝɓi icha ɗarkǝn.<verse eid="ACT 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23" />Ɗǝfkǝndǝ fari natnda humtǝhi tǝ Bulus, ndǝkǝn ɓatnda mbǝt tǝrtǝ'enahaya, ɓakndǝ kaǝn. Thlata ɓingta kǝ farǝhufta mǝlla mwa'anda kanda tǝ sǝna kuturichita Fara kandǝsi, nakna kweetǝhi kǝ kahǝn kanda ɓǝɗa Yǝso tǝ mba sakanda Musaɗi tǝ ɗelwercha Tapǝnecha. <verse eid="ACT 28:23" /><verse number="24" style="v" sid="ACT 28:24" />Funa ngǝmmangndǝ i mbutǝn, funa paɗ cherkǝndǝ fǝrkitsi. <verse eid="ACT 28:24" /><verse number="25" style="v" sid="ACT 28:25" />Kǝthlǝm kichu halǝ'indǝsa thlerǝnanda. Naknda malǝ mbǝnnihiyu shunang Bulus kandǝ ǝrta ndatwa: "Awi Shemeɗ Chiɗchiɗ mbwitǝ kit, Shunandǝn kakechinuni tǝ miya tapǝnaa Ishaya ndatwa:<verse eid="ACT 28:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 28:26" />"Ɗu mbǝnda nofchiya, kǝ ndangna kandǝwa,</para>
  <para style="q1" vid="ACT 28:26">Sǝkta, nuni nata sǝkta, Paɗ nguni sǝndǝwa,</para>
  <para style="q2" vid="ACT 28:26">Nat paɗ nuninatanata, nguni mbǝssandǝwa.<verse eid="ACT 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 28:27" />Kǝthlǝm hanndǝkiketa nofchiya shiɗ kwaakwaa,</para>
  <para style="q2" vid="ACT 28:27">resh thlǝmechengnandaɗi, ngǝlangndǝ hwanichengnanda,</para>
  <para style="q1" vid="ACT 28:27">kǝthlǝm mǝ nindǝ tǝ hwanichengnandǝwa kǝ sǝkndǝ paɗ tǝ thlǝmechengnanda,</para>
  <para style="q2" vid="ACT 28:27">kǝ mbǝsangndǝ tǝ hanɗǝkikechengnanda,</para>
  <para style="q1" vid="ACT 28:27">kǝ tǝɓǝrndǝhi mbǝɗengna kǝ kǝnayi kanda ɗi.<verse eid="ACT 28:27" /></para>
  <para style="q2">
    <verse number="28" style="v" sid="ACT 28:28" />Paɗ, kǝ sǝnuniwa, Fara a thlintǝ kuseng hǝrǝkta kǝ mbǝnda punofcha. Kandang paɗ nanda kat thlǝmatsi. <verse eid="ACT 28:28" /><verse number="29" style="v" sid="ACT 28:29" />Kǝ mbukǝn kichu, thlaakǝ Yahudawecha mbǝnniyu tǝ halǝ'indǝ kaǝn a hurɗiffitǝnanda. <verse eid="ACT 28:29" /><verse number="30" style="v" sid="ACT 28:30" />Bulus sokǝna huriini natna kwandǝyu hurat chap mǝlla thlǝt fichile ɓaka mbǝɗ'en. <verse eid="ACT 28:30" /><verse number="31" style="v" sid="ACT 28:31" />Nakǝn njawundǝ ɓasǝwa, nakna ɓasǝ kuturichita Fara, nakna sakandaɗi kǝ ɗar Lǝmwandǝ Yǝso Kǝrǝsti nga lechitsuwa.<verse eid="ACT 28:31" /></para>
  <chapter eid="ACT 28" />
</usx>