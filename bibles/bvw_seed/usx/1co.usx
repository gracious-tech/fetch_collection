<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CO" style="id">-Boga Translation Project</book>
  <para style="toc3">1 Kr</para>
  <para style="toc1">TƏRKA THLIN YARAT ƊELWERA BULUS KƏ MBƏƊA KORINTIYAWECHA</para>
  <para style="toc2">1 KORINTIYAWECHA</para>
  <para style="toc1">TƏRKA THLIN YARAT ƊELWERA BULUS KƏ MBƏƊA KORINTIYAWECHA</para>
  <para style="mt2">TƏRKA THLIN YARAT ƊELWERA BULUS KƏ MBƏƊA</para>
  <para style="mt1">KORINTIYAWECHA</para>
  <chapter number="1" style="c" sid="1CO 1" />
  <para style="s">Ndat Ənna</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1" />Yarat ɗelwertiya ɓakna mbǝɗengna njang Bulus, at Fara tǝ ngǝmtǝ'en kǝ naka lǝthlǝnda Yǝso Kǝrǝsti. Paɗ yaraki ɗelwertiya tǝ hwanmanǝm Sastanis. <verse eid="1CO 1:1" /><verse number="2" style="v" sid="1CO 1:2" />Nakani yarat ɗelwertiya kǝ ɓǝɗa fa tǝrmbanda Fara hur Korinti, tǝ mbǝɗa fichile taɗtǝ fichihar a hur Yǝso Kǝrǝsti, atfichǝ kandǝ kǝnandǝ chiɗchiɗ, nat tǝ fichile chika ayi la ak thlǝm Lǝmwaɗengnǝm Yǝso kǝrǝsti, Lǝmwaɗengnanda tǝ inǝm: <verse eid="1CO 1:2" /><verse number="3" style="v" sid="1CO 1:3" />Kafata tǝ yuyurchita mbǝɗa Shinnǝm Fara tǝ Lǝmwaɗengnǝm, Yǝso Kǝrǝsti kǝ mbǝɗengnuni.<verse eid="1CO 1:3" /></para>
  <para style="s">Sǝt Usoko</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4" />Kǝnding la naki sandǝ Farǝ usoko kǝthlǝm kunang, kǝthlǝm kafaɗi Farǝ fǝrandǝna kuni tǝ mbǝɗa Kǝrǝsti Yǝso. <verse eid="1CO 1:4" /><verse number="5" style="v" sid="1CO 1:5" />Chika tǝ mba yeni fǝraɗǝ hurmichita kuni a fat'en, hur shuwunchengnuni tǝ sǝn'ǝn paɗ nat, <verse eid="1CO 1:5" /><verse number="6" style="v" sid="1CO 1:6" />kǝthlǝm ɓeɗ ficha mbǝsandǝ sheta engnani kǝ ɗar Kǝrǝsti a hurnuni. <verse eid="1CO 1:6" /><verse number="7" style="v" sid="1CO 1:7" />Kǝthlǝm ndǝkǝn ɓahwuni chika witǝ fǝr shemeɗ muwa, nda i natuni ɗǝf hwanita ɓata Lǝmwaɗengnǝm Yǝso Kǝrǝsti; <verse eid="1CO 1:7" /><verse number="8" style="v" sid="1CO 1:8" />Le na kǝskunihar tǝ alchita kǝ mweshitkǝn, kǝthlǝm kǝ sokuni nga fa chithansarǝhiwa a farǝ ɓata Lǝmwaɗengnǝm Yǝso Kǝrǝsti. <verse eid="1CO 1:8" /><verse number="9" style="v" sid="1CO 1:9" />Fara, lǝ nǝhɗandǝ ɗǝfshundǝhi mǝlan ak kuni kǝnuni ɓweet tǝ hwe'en Yǝso Kǝrǝsti Lǝmwandengnǝm.<verse eid="1CO 1:9" /></para>
  <para style="s">Sakchǝhi a Hur fa Tǝrmbanda</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10" />Hwanaɗi kuni, hwanmancha, a hur thlǝm Lǝmwaɗengnǝm Yǝso Kǝrǝsti ndatwa: "Natuni kǝ ngǝmuni tǝ ndani mǝni saktǝhi sa hurnuniwa, kǝ humangnguni inda kǝna yarengnuni ǝrta, hanndǝkikechengnuni paɗ ǝrta." <verse eid="1CO 1:10" /><verse number="11" style="v" sid="1CO 1:11" />Hwanmanchina mbu'i nofchi hura'a Kuluwi yu, ndatwa mbatsa thlerǝnuni. <verse eid="1CO 1:11" /><verse number="12" style="v" sid="1CO 1:12" />I nati yarǝ ndatwa, chika wuna hurnuni mǝla mbu ǝn somǝn, ndatwa: "Njang i Bulus, "Yuna ndatwa, "Njang i Afolos, "Yunǝ paɗwa, "Njang i Kefas, "Yunǝwa" Njang i Kǝrǝsti." <verse eid="1CO 1:12" /><verse number="13" style="v" sid="1CO 1:13" />Awi a shek Kǝrǝsti hiwa? Ndu Bulus kukwandǝfichihi kǝthlǝm kunang? Ndu sang fichi baptisma kuni hur thlǝm Bulus? <verse eid="1CO 1:13" /><verse number="14" style="v" sid="1CO 1:14" />Saɗi Farǝ usoko sawi baptisma yuna hurnuniwa, nda Kirisbus tǝ Gayus ndak sandi kanda, <verse eid="1CO 1:14" /><verse number="15" style="v" sid="1CO 1:15" />Kǝthlǝm ndǝkǝn yunǝsǝ na ndatwa sangfichi baptisma hur Thlǝmnǝwa. <verse eid="1CO 1:15" /><verse number="16" style="v" sid="1CO 1:16" />Kit a saɗi baptisma nofchi hura'a Istifanus. Ɗifitǝ ndǝkǝn kuɗukwi ndu saɗi baptisma yunǝ paɗwa. <verse eid="1CO 1:16" /><verse number="17" style="v" sid="1CO 1:17" />Thlǝnu Kǝrǝsti njiwa kǝ si baptisma wa, paɗ kǝ ɓassi laulawata nga tǝ mbǝr sǝn'ǝna nifǝwa, kǝthlǝm mǝ sǝɓa fichi alchit palita Kǝrǝsti ɗǝwa.<verse eid="1CO 1:17" /></para>
  <para style="s">Kǝrǝsti Alchita Fara tǝ Sǝn'ǝn'en</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18" />Pathla palita ɓomchita mbǝɗa fichile naka mba thlǝrǝttaɗi, paɗ kǝ mbǝɗengnani kanang ti hǝrǝkka alchita Fara. <verse eid="1CO 1:18" /><verse number="19" style="v" sid="1CO 1:19" />Kǝthlǝm yara fichǝhi ndatwa:</para>
  <para style="q1" vid="1CO 1:19">"Ni wuwelandǝ sǝn'ǝna lǝ sǝnda ɗi,</para>
  <para style="q2" vid="1CO 1:19">kǝ sayi ɗathla lǝ ɗathlaɗi kǝ'ǝn pofǝn."<verse eid="1CO 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 1:20" />A ai fa ɗathla? A ai fa sǝn'icha? A ai fa halǝ'inda kisshi'iya? A chawu Fara kishwa ɗathla kisshi'iya ɓomchitwowa? <verse eid="1CO 1:20" /><verse number="21" style="v" sid="1CO 1:21" />Sokkǝn a hur ɗathla Fara, sǝnu kisshitǝ Farǝ tǝ mbanda ɗathlǝ'enwa, mbǝnangna Farǝ fa kǝ hǝrkaǝn fichile fǝrkǝkit, tǝ mbǝɗa ɓomchit ɓassǝ laulawatkǝn. <verse eid="1CO 1:21" /><verse number="22" style="v" sid="1CO 1:22" />Keɗ Yahudawechǝ kǝ nandǝ sakǝtkǝn, Helenawecha naknda kat ɗathla, <verse eid="1CO 1:22" /><verse number="23" style="v" sid="1CO 1:23" />kanang kana ɓassǝ Kǝrǝsti kukwandǝ fichǝhi, i sokka ǝnat chithansarǝhi mbǝɗa Yahudawecha, ɓomchit paɗɗaa mbǝɗa punofcha, <verse eid="1CO 1:23" /><verse number="24" style="v" sid="1CO 1:24" />A nakǝn mbǝɗa fichile at Fara, ndu Yahudawecha ndu Helenawecha nat hwaa, Kǝrǝsti alchita Fara tǝ ɗathla Fara. <verse eid="1CO 1:24" /><verse number="25" style="v" sid="1CO 1:25" />Kǝthlǝm i tǝrtǝ fichǝwa shiɗ Farǝ ɓomchita, sheraɗa ɗathla nifa, paɗ ɓah alchita Fara, sheraɗa alchita nifa. <verse eid="1CO 1:25" /><verse number="26" style="v" sid="1CO 1:26" />Hwanmancha yaramǝn naɗengnunihi fari at fichi kuni. Nga terchǝnuni nak tǝ sǝn'ǝn witǝ i nifǝwa; nga terchin nak tǝ mwandǝwa, paɗ nga terchin ngǝttǝ fichǝ nda kuturchǝwa. <verse eid="1CO 1:26" /><verse number="27" style="v" sid="1CO 1:27" />Farǝ taɗkǝn i har naka ɓomchita kish, kǝthlǝm kǝ harangfat fa ɗathla, taɗkǝ Farǝ i nak ɓukɓukka hur kisshita kǝ harangfat fa alchita. <verse eid="1CO 1:27" /><verse number="28" style="v" sid="1CO 1:28" />Taɗkǝ Farǝ ǝnat kuɓanda fata tǝ i njirtǝ kisshita nat tǝ ichi nguchǝksi kǝthlǝm i la nat nofcha tǝrtǝwa ndiichin kǝ saǝn nga'ǝnwa. <verse eid="1CO 1:28" /><verse number="29" style="v" sid="1CO 1:29" />Nat ichiniyu, sǝkǝn kǝthlǝm mǝ tǝri nifǝ tǝ hwasa'inwa ǝn nakǝn a mbanitǝ Farǝ wa. <verse eid="1CO 1:29" /><verse number="30" style="v" sid="1CO 1:30" />Farǝ sǝka natuni hur Yǝso Kǝrǝsti, le sokka ɗathlengnǝmma mbǝɗa Fara, mǝllan sokka fǝrkit engnǝm, chiɗchiɗchita tǝ hǝrǝktengnǝm. <verse eid="1CO 1:30" /><verse number="31" style="v" sid="1CO 1:31" />Kǝthlǝm ndǝkǝn nda i natna hur yaratkǝn: "Chikawun na thla'a'ndǝ inda kǝ thla'angka hur Lǝmwanda."<verse eid="1CO 1:31" /></para>
  <chapter eid="1CO 1" />
  <chapter number="2" style="c" sid="1CO 2" />
  <para style="s">Ɓassǝ Pathla Kǝrǝsti le Kukwandǝficha</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1" />Hwanmancha, ma ɓeɗi mbǝɗengnuni, ɓuwi kǝthlǝm kǝ mbwa'aikuni i naka ɓuɓweeta Fara, tǝ mbǝr shunda ndu tǝ sǝn'ǝnwa. <verse eid="1CO 2:1" /><verse number="2" style="v" sid="1CO 2:2" />Kǝthlǝm tepi tirihur yahwisa sǝn'ǝn somǝn naki tǝ kuniwa, Yǝso Kǝrǝsti ndak, le kukwandǝfichǝhi. <verse eid="1CO 2:2" /><verse number="3" style="v" sid="1CO 2:3" />Ɓaki mbǝɗengnuni hur ɓah alchita tǝ lechita, paɗ tǝ saktatfǝ kaǝn. <verse eid="1CO 2:3" /><verse number="4" style="v" sid="1CO 2:4" />Lǝmfatsi ndu ɗathla hur shuɗengnǝ tǝ ɓassengnǝwa, tǝ cheɗndǝ alchita Shemeɗa, <verse eid="1CO 2:4" /><verse number="5" style="v" sid="1CO 2:5" />Kǝthlǝm fǝrkitchiɗengnuni mǝniɗa ɗar sǝn'ǝna nofchǝwa, kǝ naka ɗar alchita Fara.<verse eid="1CO 2:5" /></para>
  <para style="s">Sǝn'ǝna Mbǝɗa Shemeɗa</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6" />Chika tǝ kichu, la shuwunkani sǝn'ǝna kǝ mbǝɗa fichile mwanka hur fǝrkit, nga sǝn'ǝna kisshi'i nakǝnya ndu i kuturchi nakǝnya, fichile naka thlǝrǝttaɗǝwa. <verse eid="1CO 2:6" /><verse number="7" style="v" sid="1CO 2:7" />La nakani shuwun sǝn'ǝna Fara hur ɓuɓweetǝ yu, le naka hur ɓuɓweetǝ soh, sǝn'ǝni fǝrtǝ Farǝ soh kǝ tǝrka nathi kǝthlǝm mwaɗengnǝm. <verse eid="1CO 2:7" /><verse number="8" style="v" sid="1CO 2:8" />Hur kuturchi nakǝnya ngusǝ mbǝsang sǝn'ǝniyawa, mamuwa mbǝsanda, ma kukwawundǝ Lǝmwandǝ le nak mwanchinwa. <verse eid="1CO 2:8" /><verse number="9" style="v" sid="1CO 2:9" />Nda i nat yaratkǝna hur laulawatkǝn:</para>
  <para style="q1" vid="1CO 2:9">"I tahsandǝ Fara fichilesǝ la mbǝnkǝfatkǝn, tamu hwanita natwa, thlǝmatsǝ tamka sǝktǝwa, hanndǝkiketa nifǝsǝ tamka yarandǝhiwa."<verse eid="1CO 2:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="1CO 2:10" />Kanang cheɗandǝ Fara kani tǝ mbǝɗa Shemeɗ'en. Shemeɗ la kaǝn chikamǝnat, chikamǝ naka hwengngǝchit icha Fara. <verse eid="1CO 2:10" /><verse number="11" style="v" sid="1CO 2:11" />Wuna hurnofcha sǝnkǝ yara nifa, manga Shemeɗi nifǝkǝn ti naka fi'enwa? Kichu paɗ nifǝsǝ sǝnkǝ yara Farǝ wa Shemeɗa Farǝ ndak. <verse eid="1CO 2:11" /><verse number="12" style="v" sid="1CO 2:12" />Thluwani shemeɗa kisshitǝwa, Shemeɗi ɓaka mbǝɗa Fara thlǝtani, kǝthlǝm kǝ sǝnani ichi fǝrandǝ Fara kani pofǝn. <verse eid="1CO 2:12" /><verse number="13" style="v" sid="1CO 2:13" />La mbwa'angani ichiya kuni, nga tǝ shuwunchǝ le sakandǝ fichaɗi tǝ mbǝɗa sǝn'ǝna nifǝwa tǝ shuwunchi sakandǝ fichaɗi tǝ Shemeɗa, tǝ mbu i naka kitchita shemeɗa a hur shunda Shemeɗa. <verse eid="1CO 2:13" /><verse number="14" style="v" sid="1CO 2:14" />Nifi nguchit Shemeɗa fi'en thlutǝ ichi ɓaka mbǝɗa Shemeɗa Farǝ wa, kǝthlǝm nakǝn kǝ ɓomchita mbǝɗ'en, paɗ ngu mbǝlla sǝn kandǝwa, kǝthlǝm tǝ mbǝɗa Shemeɗ la sǝntǝfichǝ kanda. <verse eid="1CO 2:14" /><verse number="15" style="v" sid="1CO 2:15" />Nifi nat Shemeɗsa fi'en la sǝnkǝ ichǝ nat, mǝllan tǝ indi'en nifǝsǝ na kikeɗandǝwa.<verse eid="1CO 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CO 2:16" />"Wun sǝnkǝ yara Lǝmwanda har natna sakandǝhar?"</para>
  <para style="m" vid="1CO 2:16">Kanang yarengnani i Kǝrǝsti.<verse eid="1CO 2:16" /></para>
  <chapter eid="1CO 2" />
  <chapter number="3" style="c" sid="1CO 3" />
  <para style="s">Shikechǝ Tora Fara</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1" />Hwanmancha, ngi mbǝlla mbwa'a' ǝna kuni nda nofchi naktǝ shemeɗa fǝwa, nda nofchi naka kisshita, paɗ nda hangwa'yarcha hur tǝrmbanda Kǝrǝsti. <verse eid="1CO 3:1" /><verse number="2" style="v" sid="1CO 3:2" />Yah fǝrandǝ kuni nga ɗǝsǝmtǝ kwaakwaawa, kǝthlǝm sǝkwunisa sǝm'ǝn kwaakwaa kwaɗǝnwa. Chika nakǝnya sǝkwunisǝwa, <verse eid="1CO 3:2" /><verse number="3" style="v" sid="1CO 3:3" />Kǝthlǝm paaya mwakuni hur fata. Makuna sǝrǝh ndani paɗ thlangǝtmisa thlerǝnuni, nga mwakuni hur fatwowa? Ɗǝsǝchengnuni nga nda tǝ fatwa? <verse eid="1CO 3:3" /><verse number="4" style="v" sid="1CO 3:4" />Kǝthlǝm ma ndeɗ yunǝwa, "Njang i Bulus", "Ndak yunǝwa", "Njang i Afolos", Nga tor fat natuni sǝtyuwa?<verse eid="1CO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5" />Wun naka Afolos? Wun naka Bulus? Nga mafechǝwa fichile fǝrtuni kit tǝ mbǝɗengnanda, nda i fǝrandǝ Lǝmwanda tora chikawun engnanda? <verse eid="1CO 3:5" /><verse number="6" style="v" sid="1CO 3:6" />Njang hǝfkǝ hanwǝtǝkǝn, thlǝrkǝ Afolos amsǝ, paɗ Farǝ mwanangnga. <verse eid="1CO 3:6" /><verse number="7" style="v" sid="1CO 3:7" />Kǝthlǝm ndǝkǝn, lǝ hǝfkǝn tǝ le thlǝrkǝ amsi nga naknda mi ǝnwa, Farǝ ndak mǝllanti la mwanangnga. <verse eid="1CO 3:7" /><verse number="8" style="v" sid="1CO 3:8" />Lǝ hǝfkǝn tǝ lǝ thlǝr amkǝnsi nakndǝ ǝrta, chika wuna hurnanda nakficha kwanandǝ keeke tǝ tor'en. <verse eid="1CO 3:8" /><verse number="9" style="v" sid="1CO 3:9" />Kǝthlǝm kanang shikechǝ fa torcha Fara, kunang hita Fara, tinda Fara.<verse eid="1CO 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 3:10" />Tǝ mbǝɗa kafaɗi fǝritǝ Fara, a ɗǝfi thlorǝ tindǝhi kǝ lǝ mbǝr tinda, ɓakyuna nata chekandǝ tinkǝn kǝ ɗarkǝn. Chikawuni kǝ sǝn hǝɓaakǝ tǝ witǝ tindǝ'en. <verse eid="1CO 3:10" /><verse number="11" style="v" sid="1CO 3:11" />Kǝthlǝm nifǝsǝ na ɗǝf thlorǝ tinda kǝ pǝɗangka le hi ɗǝftǝ fichǝhiwa, le naka Yǝso Kǝrǝsti. <verse eid="1CO 3:11" /><verse number="12" style="v" sid="1CO 3:12" />Nakǝnya ma tin yunǝ kǝ ɗar thlorǝ tinkǝn tǝ zinariya, ndu tǝ azurfa, ndu tǝ ngwichǝ ɗiichin, ndu tǝ afcha, ndu tǝ hwelaa, ndu tǝ kofcha, <verse eid="1CO 3:12" /><verse number="13" style="v" sid="1CO 3:13" />na tora chikawuna chetakish, kǝthlǝm fariniyu nan chetakissha ɗwaachitkǝn. Nak tora chikawuna chetakish tǝ hwata, hwatkǝn na kikeɗandǝ tora chikawuni. <verse eid="1CO 3:13" /><verse number="14" style="v" sid="1CO 3:14" />Ma tini sǝtficha kǝ ɗar thlorǝ tinkǝn hiriki iwaɗǝwa, le tinka nan thlǝt kǝnikǝn. <verse eid="1CO 3:14" /><verse number="15" style="v" sid="1CO 3:15" />Ma iɗ torkǝna ɗi, le tinka nan sat ɓahta, mǝllan tǝ indǝ'en nan hǝrǝkta nda nifi kuwurkǝ tǝ hur hwata. <verse eid="1CO 3:15" /><verse number="16" style="v" sid="1CO 3:16" />Awi sǝnwuniwa kunang tǝ inchengnuni naka kapat hura'a Farǝwa, paɗ nak Shemeɗa Farǝ tǝ sokta a hur hanndǝkikechengnuniwowa? <verse eid="1CO 3:16" /><verse number="17" style="v" sid="1CO 3:17" />Chikawun sǝɓang kapat hura'a Fara ɗi, na Fara sǝɓandaɗi; kǝthlǝm kapat hura'a Fara la nakǝn chiɗchiɗ, kunang naka kapat hura'a Farǝkǝn.<verse eid="1CO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18" />Mǝ lǝmiɗuni inchengnuniwa. Ma yunǝsa hurnuni la yarkǝwa ɗathlchin a hur kisshi'i nakǝnya, kǝ saǝn fat'en nda ɓoma, kǝthlǝm kǝ sǝka lǝ ɗathla. <verse eid="1CO 3:18" /><verse number="19" style="v" sid="1CO 3:19" />Ɗathla kisshi'iya ɓomchita mbǝɗa Fara. Nda i natna hur yarat laulawatkǝn: "La kǝsaǝn fichile nak ɗathlchin a hur ɗathlengnanda." <verse eid="1CO 3:19" /><verse number="20" style="v" sid="1CO 3:20" />Tǝpaɗ: "A shin Lǝmwandǝwa yara fa ɗathlǝ nga ǝnwa." <verse eid="1CO 3:20" /><verse number="21" style="v" sid="1CO 3:21" />Kǝthlǝm ndǝkǝn mǝ hupa nifǝ hǝsǝr tǝ nifǝwa. Kǝthlǝm chikamǝ nat innuni, <verse eid="1CO 3:21" /><verse number="22" style="v" sid="1CO 3:22" />ndu Bulus, ndu Afolos, ndu Kefas, ndu kisshita, ndu shisshingta, ndu mǝrtaɗi, ndu ichi nakǝnya, ndu ichi naka mban, nat innuni. <verse eid="1CO 3:22" /><verse number="23" style="v" sid="1CO 3:23" />Kunang paɗ i Kǝrǝsti, Kǝrǝsti paɗ i Fara.<verse eid="1CO 3:23" /></para>
  <chapter eid="1CO 3" />
  <chapter number="4" style="c" sid="1CO 4" />
  <para style="s">Fathlǝncha Kǝrǝsti</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1" />Tǝkichu kemsi kǝ tǝruni kaniwa mafecha Kǝrǝsti, tǝ fichile ngǝmandǝ fichǝ kǝnandǝ tǝ ichi Farǝ naka ɓuɓweeta. <verse eid="1CO 4:1" /><verse number="2" style="v" sid="1CO 4:2" />Sokkǝn waat nifi malandǝ fichǝ ichahar kemsi kǝ mbǝsang fichǝ tǝ kitchita fa. <verse eid="1CO 4:2" /><verse number="3" style="v" sid="1CO 4:3" />A mbǝɗengna, hanhwan'ǝna kǝ nda fichǝwa kunang na sakimiya ndu mbǝt sakmiya chikawun nifa. Kitchitkǝn, njang mangi sakamiya faɗengniwa. <verse eid="1CO 4:3" /><verse number="4" style="v" sid="1CO 4:4" />A shini hur indengniwa naki yalfar, chika kichu ngu soktǝwa chiwi hansarǝhiwa. Lǝmwandǝ na kikeɗita. <verse eid="1CO 4:4" /><verse number="5" style="v" sid="1CO 4:5" />Kǝthlǝm ndǝkǝn mǝ thlaɗuni sakmihi kǝ ɗar yunǝ pofǝn sa'u hanmunchikǝn kwaɗǝnwa; pwa'ama kǝ farǝ nat Lǝmwanda ɓata. Mǝllan na chandǝ ichi kissha ɓuɓweeta kǝ ɗwachitkǝn, kǝ cheɗin yara hanɗǝkikecha. A farǝniyu chikawun nan thlǝt hamtǝ'ena mbǝɗa Fara.<verse eid="1CO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6" />Nakǝnya hwanmanchina, fǝrki sakǝt ichi natya kǝ faɗengnǝ tǝ Afolos kǝthlǝm kunang, kǝ sakuni ǝn tǝ mbǝɗengnani kǝ ɗar shuni ndatfichǝwa: "Mǝ mbǝraɗuni ihi yarandǝ fichihi hur laulawatkǝnwa." Mǝ thla'a yunǝ inda hurnuni kǝ mbǝrangka lehi kǝ ɗar yunǝwa. <verse eid="1CO 4:6" /><verse number="7" style="v" sid="1CO 4:7" />Wun sukǝ somǝnhi tǝ tahhǝt nofcha, mǝnakseku le thluchitu? Sokkǝnma tǝ thlǝna, mǝsǝk natu thla'a'ndǝ inda nda nga tǝ thlǝnǝwa? <verse eid="1CO 4:7" /><verse number="8" style="v" sid="1CO 4:8" />Tepi mbǝshuni nat ichi yahtuni! Tepi shokuni kǝ hurrumcha! Tepi shokuni kuturcha nga tǝ kanangwa! Mayahtengna kǝ sokuni ka kǝ kuturcha, kǝthlǝm kanang ma kǝ sokani kuturichitkǝn tǝ kuni. <verse eid="1CO 4:8" /><verse number="9" style="v" sid="1CO 4:9" />A naɗengna cheɗ Fara a ɗwachitkǝnwa, kanang fathlǝncha njirandǝ fichǝ kaniɗi kǝ ndukwatkǝn chika mi, nda nofchi thlandǝ fichǝ sakmi mǝrtaɗa kandǝsi, sangfichi kani kǝ ǝnat nata kisshita, tǝ mala'ika cha nat tǝ nofcha. <verse eid="1CO 4:9" /><verse number="10" style="v" sid="1CO 4:10" />Shokani kǝ ɓomcha Kǝrǝsti, kunang nakuni kǝ fa ɗathla hur Kǝrǝsti! Kanang fa kuɓanda fata, kunang nakuni kwaakwaa. Ficha natkuni tǝ kapatichita fa, kanang nga ǝnnakaniwa. <verse eid="1CO 4:10" /><verse number="11" style="v" sid="1CO 4:11" />Paa kǝ nakǝnya, nakani hur mita tǝ kusshimta, thlǝthlah njelecha naka fechengnani, ficha tǝpanda kani paɗ hurechengnanisǝwa. <verse eid="1CO 4:11" /><verse number="12" style="v" sid="1CO 4:12" />La sani tor kaǝn tǝ harchengnani. Ma erndǝ kani, ndǝfangani mbǝs'ǝnhara kanda; ma fǝrandǝ pwancha kani, kǝrǝskani. <verse eid="1CO 4:12" /><verse number="13" style="v" sid="1CO 4:13" />Ma sǝɓandǝ thlǝmchǝnaniɗi, la shunangani kandǝ tǝ kachita. Paaya sokkani nda chirǝfta kisshita, i nat chikawuna wuɗekta. <verse eid="1CO 4:13" /><verse number="14" style="v" sid="1CO 4:14" />Nga yaraki iya kǝthlǝm kǝ harangfat kuniwa, kǝ tahsayi kuni nda hwanchi yahti. <verse eid="1CO 4:14" /><verse number="15" style="v" sid="1CO 4:15" />Chikama sokkǝn fasakchengnunisǝ aru kumchitkum (10,000) a hur Kǝrǝsti, shinchǝnunisǝ terchinwa, kǝthlǝm njang naka shinnuni a hur Yǝso Kǝrǝsti tǝ mbǝɗa laulawata. <verse eid="1CO 4:15" /><verse number="16" style="v" sid="1CO 4:16" />Kǝthlǝm ndǝkǝn nja hwanandǝ kuni kǝ sakuni nji. <verse eid="1CO 4:16" /><verse number="17" style="v" sid="1CO 4:17" />Kǝthlǝm ndǝkǝn nja thlǝna Timoti kuni, hwe'engna le la mbǝntifatkǝn, le nak tǝ kachita a hur Lǝmwanda. Nan kuɗkanda kuni tǝ mbanda naɗengnǝhi a hur Yǝso Kǝrǝsti, nda i soktǝn keeke tǝ i sakandi ɗaɗi chika ayi hur chika yen mbǝt tǝrmbanda. <verse eid="1CO 4:17" /><verse number="18" style="v" sid="1CO 4:18" />Funa thla'a'ndǝ inda nda ngi ɓata mbǝɗengnuniwa <verse eid="1CO 4:18" /><verse number="19" style="v" sid="1CO 4:19" />Ma ngǝma Lǝmwanda ni ɓata mbǝɗengnuni chetchetya, kani tausandǝ alchiɗi mbǝstǝ fa thla'a'ndǝ iniyu kish tǝ shuwunchengnanda. <verse eid="1CO 4:19" /><verse number="20" style="v" sid="1CO 4:20" />Kǝthlǝm kuturichita Fara nga pathla shundǝwa pathla alchita. <verse eid="1CO 4:20" /><verse number="21" style="v" sid="1CO 4:21" />Mǝ yahtunisi? Kǝ ɓi mbǝɗengnuni tǝ kuɓwerǝwa, ndu hur mbǝnfata paɗ tǝ ngwallǝchit shemeɗa?<verse eid="1CO 4:21" /></para>
  <chapter eid="1CO 4" />
  <chapter number="5" style="c" sid="1CO 5" />
  <para style="s">Chamǝn Fǝlau tǝ Hwanmanda Kish</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1" />Shikiwa fǝlawichitsa hurnuni, witǝ le tamuchit ficha sǝta chika hur fa sǝt tor ɗǝhhacha, yuna sok fǝlawichit tǝ nuh shinkǝn. <verse eid="1CO 5:1" /><verse number="2" style="v" sid="1CO 5:2" />Nakuni thla'a'ndǝ inda! Nga kwesh sǝtuni sǝɓhurwa? Chikawun sǝk iniyu kǝ chang ficha kissha hurnuni. <verse eid="1CO 5:2" /><verse number="3" style="v" sid="1CO 5:3" />Chika sokkǝn njangsǝ tǝ iɗengna mbǝnniyuwa, njang tǝ kuni hur hanɗǝkiketa. Tepi sakaɗi miya nifi sǝk witǝ iniyu, nda njangsa mbǝnniyu. <verse eid="1CO 5:3" /><verse number="4" style="v" sid="1CO 5:4" />Ma hwimunihi a hur thlǝm Lǝmwandǝ Yǝso njang tǝ kuni mbǝnniyu hur hanɗǝkiketa, paɗ alchita Lǝmwaɗengnǝm Yǝso mbǝnniyu, <verse eid="1CO 5:4" /><verse number="5" style="v" sid="1CO 5:5" />witǝ nifiniyu kǝ fǝranguni Sheɗan kǝthlǝm kǝ ɓǝllang ficha hur fata, mbah na shemeɗ'ena hǝrǝkta farǝ ɓata Lǝmwandǝ Yǝso.<verse eid="1CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6" />Thla'a'ndǝ inchengnuni ndǝɗuwa. Sǝnwuniwa, mehndǝ nguɗehkicha la huppang humbat tahasǝ njohmǝ wowa? <verse eid="1CO 5:6" /><verse number="7" style="v" sid="1CO 5:7" />Pa'amǝn ɗohhǝt mehniɗiyu fechengnuni, kǝ sokuni kǝ yuwa ɗokyeta le nguchit mehndǝsa fi'en, kǝthlǝm kittǝkǝn nakuni kichu. Kǝthlǝm teppa thlafichi ɓurat hwan shohraɗengnǝm i chohhǝm tala, mǝlan naka Kǝrǝsti. <verse eid="1CO 5:7" /><verse number="8" style="v" sid="1CO 5:8" />Kǝthlǝm ndǝkǝn kǝsam chohhǝmtengnǝmhar nga tǝ ɗohhǝt mehndǝwa, mehǝn sǝɓfata tǝ ɓǝɓifata. Kǝla sǝm chohhǝmtengnǝm tǝ njohmi nguchit mehndǝsi, ndǝkǝn naka njohǝm kachita tǝ kitchita. <verse eid="1CO 5:8" /><verse number="9" style="v" sid="1CO 5:9" />Yaraɗi kunisa hur thlǝn yarat ɗelwer engna ndatwa mǝlla humiɗunihi tǝ fǝlauchiwa. <verse eid="1CO 5:9" /><verse number="10" style="v" sid="1CO 5:10" />Nga yarengnǝwa nofchi kisshi'iya naka fǝlauchiwa, tǝ fa yah'ichǝwa, tǝ fa ɗathlanda nofchifǝwa, tǝ fa sǝt tor ɗǝhhachǝwa. Kǝthlǝm ma nakǝn kichu sokkǝn waat kǝ chunikissha hur kisshita. <verse eid="1CO 5:10" /><verse number="11" style="v" sid="1CO 5:11" />Yarayi kunisi mǝ sokiɗuni tǝ chikawun la at fichiwa hwanmanda lǝ tǝrmbanda, ma la sǝkǝn fǝlawichita, ndu lǝ yah'icha, ndu lǝ mwanandǝ ɗǝhhacha, ndu lǝ erǝfata, ndu lǝ sat icha, ndu hara. Chika sǝm'ǝn mǝ sǝmiɗuni tǝ witǝ nofchiniyuwa.<verse eid="1CO 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 5:12" />Mǝ kǝmikǝ tǝ sakamiya fichile nguchika hur tǝrmbanda? Nga fichile naka hur tǝrmbandǝ natuni sakamiya kandǝwa? <verse eid="1CO 5:12" /><verse number="13" style="v" sid="1CO 5:13" />Farǝ na sakamiya fichile nguchika hur tǝrmbanda: "Chamǝn ɓǝɓi nifa hurnuni."<verse eid="1CO 5:13" /></para>
  <chapter eid="1CO 5" />
  <chapter number="6" style="c" sid="1CO 6" />
  <para style="s">Mǝ ɗi Fafǝrkitta Muhhanhar Ndaniwa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1" />Ma yunǝsa hurnuni naka thlangǝtmi tǝ shekkǝn, mǝ ɗiɗa muhhanharkǝna mbǝɗa fa ɓah fǝrkitwa, nga kweshkǝn kǝ mbǝɗa fa fǝrkitwowa? <verse eid="1CO 6:1" /><verse number="2" style="v" sid="1CO 6:2" />Awi sǝnwuniwa fa fǝrkit na sakamiya kisshitǝwowa? Makunang na sakamiya kisshita, nguni mbǝla sakmi ichi top-topyawowa? <verse eid="1CO 6:2" /><verse number="3" style="v" sid="1CO 6:3" />A sǝnwuniwa kǝmnang na sakamiya Mala'ika chiwowa? Kana cheta ichi natma soktǝsa kisshi'iya! <verse eid="1CO 6:3" /><verse number="4" style="v" sid="1CO 6:4" />Ma witǝ muhhanhar chini engnunisiyu, mǝsǝk la ɗǝtuni tǝkǝna mbanitǝ fichile nguchika miya ǝna mbanitǝ fa tǝrmbanda? <verse eid="1CO 6:4" /><verse number="5" style="v" sid="1CO 6:5" />Mbuki iniyu kǝthlǝm kǝ harangfat kuni. Sokkǝnyawa yunǝsa hurnuni ǝrtǝ nak ɗathlchin na tahsandǝ thlerǝ fa fǝrkitaɗǝwa? <verse eid="1CO 6:5" /><verse number="6" style="v" sid="1CO 6:6" />Paɗ mǝsǝka hwanmanda la ɗǝtna muhhanhar hwanmankǝn a mbanitǝ fa ɓah fǝrkit?<verse eid="1CO 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 6:7" />Muhhanhar ndani ti la muhtuniyu kǝttǝhi mbǝɗengnuni. Nga kweshkǝn kǝrǝstuni kǝ nuni ɓomchǝwowa? Mǝsǝk nguchituni kǝrǝstǝ kǝ ɗathlang ficha kuni fa? <verse eid="1CO 6:7" /><verse number="8" style="v" sid="1CO 6:8" />Kunang tǝ inchengnuni kuna ɗathlanda ndanifa kuna puppuk ndanihi, ta hwanmanchǝnuni la sanduni ichiniyu kanda. <verse eid="1CO 6:8" /><verse number="9" style="v" sid="1CO 6:9" />Awi sǝnwuniwa fa ɓah fǝrkit ngunda mbǝs yimta kutǝrichita Farǝwowa? Mǝ lǝmi fichi kuniwa, kǝthlǝm fa sǝɓtaɗaɗisi ndu fa sǝt torɗǝhhacha, ndu fa sǝt fǝlauwichita, ndu hishchǝ fa che fechengnanda, ndu hishchi fa mundǝ tǝ hishcha, <verse eid="1CO 6:9" /><verse number="10" style="v" sid="1CO 6:10" />ndu harcha, ndu fa yahta, ndu fa sat'icha, ndu fa erǝfata, ndu fa ɗathlanda nofchǝfa na mbǝs mbǝta hur kuturichita Farǝwa. <verse eid="1CO 6:10" /><verse number="11" style="v" sid="1CO 6:11" />Nak funengnuni kichuyu. Anakǝn sapa fichǝ kuniɗi, tahsafichǝ kuni, chafichǝ kuni kish a hur thlǝm Lǝmwandǝ Yǝso Kǝrǝsti, paɗ tǝ mbǝɗa Shemeɗa Farengnǝm.<verse eid="1CO 6:11" /></para>
  <para style="s">Mwanamǝn Fara tǝ Fechengnuni</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12" />"Chikamǝ ngǝmifichǝsi", Paɗ nga chikamǝ na kǝsitisǝwa. "Chikamǝ ngǝmifichǝsi", Chika kichu ngi sokta mafata chikamǝwa. <verse eid="1CO 6:12" /><verse number="13" style="v" sid="1CO 6:13" />"Ɗǝsǝmta kǝthlǝm hura, hur paɗ kǝthlǝm ɗǝsǝmta" Farǝ nan thlǝrtandǝ kandaɗǝ hwaa. Sufichǝ fata kǝthlǝm kǝ i fǝlawichitwa, kǝ naka i Lǝmwanda, Lǝmwandǝ paɗɗaa i fata. <verse eid="1CO 6:13" /><verse number="14" style="v" sid="1CO 6:14" />Thla'ang Farǝ Lǝmwanda hur mǝmatcha tǝ alchit'en, paɗ chika kǝm nan thla'a'ndǝ kǝm. <verse eid="1CO 6:14" /><verse number="15" style="v" sid="1CO 6:15" />Awi sǝnwuniwa fechengnuni njarǝ fata Kǝrǝsti tǝ indǝ'enwowa? Kemsǝ hachiya kǝ hari njarǝ fata Kǝrǝsti kǝ humayi kandǝ tǝ ɓǝɓimanda? Ngu tamtasǝtwa! <verse eid="1CO 6:15" /><verse number="16" style="v" sid="1CO 6:16" />Awi sǝnwuniwa nifi humangfat tǝ ɓǝɓimanda sokkǝndǝ fat ǝrtǝ tǝ ndǝwowa? Kǝthlǝm nda i nat yarat laulawatkǝn: "Chapndǝyu naknda soktǝ kǝ fat ǝrta." <verse eid="1CO 6:16" /><verse number="17" style="v" sid="1CO 6:17" />Le humang fat'enhi tǝ Lǝmwanda, sokkǝndǝ ǝrta hur shemeɗ tǝ ndi. <verse eid="1CO 6:17" /><verse number="18" style="v" sid="1CO 6:18" />Rahamna fǝlawichithar! Tahhǝt ɓǝɓichitfechi nat la sǝt nifa nakna kisshitǝ fat'en, paɗ le sǝk ɓǝɓichitfat tǝ mbanda fǝlawichita sǝkǝn ɓǝɓichitfat kǝ fa fat'en. <verse eid="1CO 6:18" /><verse number="19" style="v" sid="1CO 6:19" />Sǝnwuniwa fechengnuni kapat hura'a Fara le naktǝ Shemeɗ Chiɗchiɗ, naka a hanndǝkikechengnuni, le thlǝtuni ɓǝɗa Farǝ wowa? Nga nakuni tǝ alchit inchengnuniwa. <verse eid="1CO 6:19" /><verse number="20" style="v" sid="1CO 6:20" />Hikkǝ fichǝ kuni 'yang'yang. Kǝthlǝm ndǝkǝn mwanamǝn Farǝ tǝ fechengnuni.<verse eid="1CO 6:20" /></para>
  <chapter eid="1CO 6" />
  <chapter number="7" style="c" sid="1CO 7" />
  <para style="s">Hafata Sok Reta</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1" />Nakǝnya kǝ ichi yaratuni ɗarkǝn, ndiichinsi hishnifǝ mǝ kahindǝ kanwa. <verse eid="1CO 7:1" /><verse number="2" style="v" sid="1CO 7:2" />Kǝthlǝm rahhanda fǝlawichit har, chikawun hishnifǝ kǝnan tǝ nuhkǝnsi, paɗ chikawun nuhnifǝ kǝnan tǝ sǝmahsi. <verse eid="1CO 7:2" /><verse number="3" style="v" sid="1CO 7:3" />Hishnifǝ kǝ fǝraǝn i kamkǝsa nuhkǝn i reta, nuhnifǝ paɗ kǝ fǝraǝn i kamkǝsa sǝmahha i reta. <verse eid="1CO 7:3" /><verse number="4" style="v" sid="1CO 7:4" />Kǝthlǝm nuhnifǝ alchit'ensǝ kǝ fa fat'en ichitkǝnwa, sǝmah ndak. Kichu paɗ sǝmah alchit'ensǝ kǝ fa fat'en ichitkǝnwa, nuhkǝn ndak. <verse eid="1CO 7:4" /><verse number="5" style="v" sid="1CO 7:5" />Mǝ njaɗuni ndaniwa, kǝnan tǝ ngǝmtengnuni hwaa, kǝ fari ɗǝftuni kǝthlǝm kǝna hur'inchengnuni hur hwanda kanuni ngǝr kǝmta, kǝthlǝm mǝ limi sheɗan kuni a ɗar ɓah kǝrǝstǝwa. <verse eid="1CO 7:5" /><verse number="6" style="v" sid="1CO 7:6" />Mbuki iya i kamkǝsi yarandǝhi, nga waatwa. <verse eid="1CO 7:6" /><verse number="7" style="v" sid="1CO 7:7" />Mamuwa nansǝta kǝna nofchǝ nat nda njang. Nakǝn chikawun hishnifa tǝ i fǝrandǝ Fara, leya tǝ witǝ i fǝrandǝn leyu paɗ tǝ witǝ ikǝn.<verse eid="1CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8" />Kǝ mbǝɗa fichile kahuchikkan tǝ ndǝllat nishcha fichile mǝrtǝ hishchengnandǝyu, a kǝllaɗengna keekesi kǝ soknda kahundǝ kanwa nda i nati. <verse eid="1CO 7:8" /><verse number="9" style="v" sid="1CO 7:9" />Ma ngunda mbǝla kǝs fechengnandǝ harwa, kǝ kahndǝ kan. Kweshkǝn kǝ kah nifǝ kan mǝni ita ɗi tǝ yahta.<verse eid="1CO 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 7:10" />Kǝ mbǝɗa fichile kahkǝ kan nja ndandakuniwa, nga njangwa Lǝmwanda, ndatwa: "Nuhnifǝ mǝ sakindǝhi tǝ sǝmahwa." <verse eid="1CO 7:10" /><verse number="11" style="v" sid="1CO 7:11" />Ma ɓeɗa saktǝhi tǝndi, kǝ sokǝn kichuyu kǝnretsǝwa, manga kichuuwa kǝ tahsangndǝ thlerǝnandaɗi tǝ sǝmahha. Hishnifǝ paɗ mǝ sakiɗǝhi tǝ nuhkǝnwa.<verse eid="1CO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12" />Kǝ mbǝɗa tahchikǝn paɗ ndakiwa: "Nga Lǝmwandǝ mbukǝwa." Ma yunǝ hwanmandǝsi nat nuhkǝn kǝla ɓahfǝrkit, ngim nuhnifǝkǝn kǝ sokǝn tǝndi, mǝ cheriɗǝndǝwa. <verse eid="1CO 7:12" /><verse number="13" style="v" sid="1CO 7:13" />Ma nuhnifǝsǝ nat sǝmah kǝ lǝ ɓahfǝrkit, ngim hisnifǝkǝn kǝ sokǝn tǝndi, mǝ cheriɗǝndǝwa. <verse eid="1CO 7:13" /><verse number="14" style="v" sid="1CO 7:14" />Kǝthlǝm hishnifǝ lǝ ɓahfǝrkit, tahsafichǝ chiɗchiɗ tǝ mbǝɗa nuhkǝn, paɗ nuhnifǝ lǝ ɓahfǝrkit, tahsafichaɗi chiɗchiɗ tǝ mbǝɗa sǝmahha. Manga kichuwa, hwechengnuni naknda nat tǝ putafa, nda i natǝn nakǝnya, nakndǝ chiɗchiɗ.<verse eid="1CO 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 7:15" />Ma lǝ ɓahfǝrkittiyu yahkǝsa saktǝhi tǝ shetkǝn kǝnan kichu. A witǝ mbǝnniyu, hwanmandǝ kǝ nuhnifǝ ndu kǝ hishnifǝ nga waatsa sokkǝnwa. Kǝthlǝm Farǝ akǝn kǝm kǝ sok yuyurchit tǝ ndani. <verse eid="1CO 7:15" /><verse number="16" style="v" sid="1CO 7:16" />Sokǝn nuhnifa, shinnǝ ndu mbahya sokǝn na hǝrkandǝ sǝmatuuwa? Sokǝn hishnifa, shinnǝ ndu mbahya sokǝn na hǝrkandǝ nuhwuwa?<verse eid="1CO 7:16" /></para>
  <para style="s">Witǝ Soki Yahtǝ Lǝmwandǝsǝ Kǝ Sokficha</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17" />Chika witǝmǝ natma hurkǝn, chikawun kǝ sokka mbǝɗi ɗǝftǝ Lǝmwandǝndǝsi a nat'enhi, kǝ i at Farǝ ndi. Ndǝkǝn naka mbutengna kǝ mbǝɗa fafǝrkit nat. <verse eid="1CO 7:17" /><verse number="18" style="v" sid="1CO 7:18" />Wun taɓkǝ kǝ heshang ficha kǝ fari at fichǝndi? Mǝ sokiɗǝ kǝ lǝ ɓah heshiwa. Le heshuchika kǝ fari at fichǝndi, mǝ kiɗǝ heshiwa. <verse eid="1CO 7:18" /><verse number="19" style="v" sid="1CO 7:19" />Hesha tǝ ɓah hesha nga ǝn nakndǝwa, kuwur kussa Farǝ ndak naka ka'ǝna. <verse eid="1CO 7:19" /><verse number="20" style="v" sid="1CO 7:20" />Chikawun kǝ nan nda i natǝn kǝ fari at Fara ɗi. <verse eid="1CO 7:20" /><verse number="21" style="v" sid="1CO 7:21" />Naku kǝ mafat kana ficha atsǝwa? Mǝ kǝmu ǝnwa. Manu ɓǝs alchit iɗeku, sǝku tor tǝ mbayiniyu. <verse eid="1CO 7:21" /><verse number="22" style="v" sid="1CO 7:22" />Chikawun naka mafata kana Lǝmwanda atndi nakǝn kǝ nifi ɓǝske alchit iɗi'en a Lǝmwanda. Kichu paɗ le nguchika mafata kana ficha atndi nakǝn kǝ mafata Kǝrǝsti. <verse eid="1CO 7:22" /><verse number="23" style="v" sid="1CO 7:23" />Hikkǝ fichǝ kuni 'yang'yang mǝ niɗuni mafecha nofchǝwa. <verse eid="1CO 7:23" /><verse number="24" style="v" sid="1CO 7:24" />Kǝthlǝm ndǝkǝn hwanmancha, chika hur witǝ sokmǝ atfichǝ chikawuni, kǝ sokǝn kichu nda i at Farǝndi, kǝnan tǝ Farǝ'en.<verse eid="1CO 7:24" /></para>
  <para style="s">Fichǝle Kahuchikkan tǝ Fichile Mǝrtǝ Hishchengnanda</para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25" />Kǝ ɗar nishchi tamuchika kan, fǝriwu Lǝmwandǝ alchit shuɗe kǝ ɗarkǝnwa, paɗ naki fǝr i naka yarengna kǝ ɗar ndatwa njangti ngǝmitǝ fichǝsi a ɗar shisshetfata Lǝmwanda. <verse eid="1CO 7:25" /><verse number="26" style="v" sid="1CO 7:26" />Ma yarengna, kǝthlǝm ɓahhi natma hurkǝn nakǝnya, keekesi kǝ soknifǝ ichitkǝn nda i natǝn. <verse eid="1CO 7:26" /><verse number="27" style="v" sid="1CO 7:27" />A kehnikanwa? Mǝ kǝnǝ saktǝhiwa. Ma kahunikanwa, mǝ kǝnǝ nuhnifǝwa. <verse eid="1CO 7:27" /><verse number="28" style="v" sid="1CO 7:28" />Ma kehnikan sunǝ ɓǝɓichitfatwa, ma keh nuhhwekan sutǝ ɓǝɓichitfatwa. Fichile kahkǝkan nanda yimta ɓahtǝ somsomǝn a naɗihiya, njang tǝ yahhisǝ kǝnan paapa'a mbǝɗengnuni.<verse eid="1CO 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 7:29" />I yarti hwanmancha, ndatwa hanmunchikǝn nguɗeh. Thlata nakǝnya kǝ mban fichile nat nishchengnandǝsi kǝ sokndǝ nda ngusengnandǝwa, <verse eid="1CO 7:29" /><verse number="30" style="v" sid="1CO 7:30" />Fa tita nda nga tǝnnda titwa, fichile naka mbǝnfata nda nga kanda mbǝnfatwa, fichile hikkǝ'ǝna kǝ nandǝ nda nga ichengnandǝ kǝ kǝsndǝharwa. <verse eid="1CO 7:30" /><verse number="31" style="v" sid="1CO 7:31" />Fichile naka sǝt tor tǝ ǝnat kisshita mǝ ɗǝfindǝ fatsǝwa. Kǝthlǝm kisshikǝn a naɗi nakǝnya, tǝ naka mbǝrtǝhi.<verse eid="1CO 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 7:32" />Yahkisi kǝnuni cha'a hur thlahur i'nda. Nifi kahhuchikkan nak yarǝ'ena ɗar torcha Lǝmwanda, i natna sǝta kǝ tǝraǝn hura Lǝmwandǝhi. <verse eid="1CO 7:32" /><verse number="33" style="v" sid="1CO 7:33" />Le kahkǝkan nak yarǝ'ena nata ɗar ǝnat kisshita, mbayi natna sǝt kǝ tǝraǝn hura nuhkǝnhi. <verse eid="1CO 7:33" /><verse number="34" style="v" sid="1CO 7:34" />Paɗ shek hur'indǝ'enhi. Nuhnifǝ kahhuchikkan ndu nuhhweya nak yarǝ'ena ɗar torcha Lǝmwanda, la ɗǝfkǝn indǝ'en kaǝn kǝ mbǝɗa Lǝmwanda a hur fat tǝ shemeɗa. Nuhnifi kahkǝkan yarǝ'ena ɗar ǝnat kisshita, mbayi natna sǝt kǝ tǝraǝn hura sǝmahhi. <verse eid="1CO 7:34" /><verse number="35" style="v" sid="1CO 7:35" />Naki mbu ichiya kǝthlǝm kǝ kǝsangka kunisi, ngauwa kǝ ɓweshikuniwa, kǝthlǝm soktengnuni kǝnaka mbandǝ ndiichin mǝ saki yarengnunihi hur mwanandǝ Lǝmwandǝwa.<verse eid="1CO 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36" />Ma yaraa yunǝhiwa i natna sǝt kǝ ɗar nuhhwani ngwantǝn nga keekewa, a nakǝn hurrecha nuhhwankǝna mbǝrtǝhi paɗ a fat'en kemsǝ kǝ kahhǝnkan, kǝ sǝn kichu nda i yahtǝn. Nga tǝna sǝt ɓǝɓichitfatwa, kǝ kǝnangndǝ reta. <verse eid="1CO 7:36" /><verse number="37" style="v" sid="1CO 7:37" />Nifi thlarkǝ kit kǝ ɗar yara hanndǝkiketǝ'en ndatwa ǝnatkǝn nga waatwa paɗ nan mbǝlla kǝs indǝ'enhar, paɗ tira hanndǝkiketǝ'enwa ngu kahhandǝ nuhhwaniyuwa, mǝlan ma shiɗtǝ i nak keeke. <verse eid="1CO 7:37" /><verse number="38" style="v" sid="1CO 7:38" />Nifi kahhang nuhhwani ngwantǝn shiɗ keeke, paɗ nifi kahhauchik nuhhwani ngwantǝn shiɗtǝ i kamkǝsǝ kaǝn.<verse eid="1CO 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 7:39" />Nuhnifǝ nakna kǝnda kǝ mbǝɗa sǝmahha ma tana mweehi tǝ shishingta. Ma mir sǝmahha, cheɗa kissha sahta kǝ kahhǝn chikawun yahtǝn, sokkǝn waat kǝ na hishnifǝkǝna i Lǝmwanda. <verse eid="1CO 7:39" /><verse number="40" style="v" sid="1CO 7:40" />A thlandǝ shuɗengnǝhi, nan nat tǝ mbǝnfat kaǝn manan soktǝ ichitkǝn nda i natǝn. Paɗ la sikǝnfǝ Shemeɗa Farengnǝsi.<verse eid="1CO 7:40" /></para>
  <chapter eid="1CO 7" />
  <chapter number="8" style="c" sid="1CO 8" />
  <para style="s">Ɗǝsǝmi Fǝrandǝ Ficha Ɗǝhhacha</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1" />Nakǝnya pathlǝ ɗǝsǝmi fǝrandǝ ficha ɗǝhhacha: "Shinǝmwa nattǝm sǝɗengnǝmsi." Sǝndǝ la ɓakǝn tǝ thla'inda, mbǝnfata la tinaǝn. <verse eid="1CO 8:1" /><verse number="2" style="v" sid="1CO 8:2" />Ma tiryunǝwa shintǝ'ǝna, paaya sǝnu nda i kamkǝsi kǝ sǝnǝnwa. <verse eid="1CO 8:2" /><verse number="3" style="v" sid="1CO 8:3" />Ma yuna mbǝnfat Fara, shin Farǝ ndi.<verse eid="1CO 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4" />Pathlǝ sǝm ɗǝsǝmi fǝrandǝ ficha ɗǝhhacha: "A shinǝmwa ɗǝhhata nga ǝnnakǝnna kisshitǝwa paɗ Farǝsǝ somǝnwa ǝrta." <verse eid="1CO 8:4" /><verse number="5" style="v" sid="1CO 8:5" />Chika sokkǝnwa funisǝ la atfichǝwa farǝcha a Afshi ndu kisshita (nda i nat, "farǝchǝsǝ" ka'ǝn "shinchǝsǝ" paɗ kaǝn), <verse eid="1CO 8:5" /><verse number="6" style="v" sid="1CO 8:6" />Chika kichu a mbǝɗengnǝm Farǝ ǝrta, le naka Shinda, ichi natya ɓakna mbǝɗ'en, naɗengnǝmhi kǝthlǝm mǝlan. Lǝmwandǝsi ǝrta Yǝso Kǝrǝsti, tǝ mbǝɗ'en chet ichi kish natya, kǝmnang paɗ naɗengnǝmhi tǝ mbǝɗ'en.<verse eid="1CO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7" />Nga chikawun sǝnkǝ iyawa. Funǝ paaya sǝɗengnandǝhi tǝ tor ɗǝhhacha, la saǝn kandǝfǝwa ɗǝsǝmi la sǝmtǝnda nda i fǝrandǝficha ɗǝhhata. Kǝthlǝm ndǝkǝn nguchikndǝ kwaakwa'a hur hanndǝkiketa la tǝrkǝndǝwa shiɓndaɗaɗi. <verse eid="1CO 8:7" /><verse number="8" style="v" sid="1CO 8:8" />Ɗǝsǝmtǝ ɗutǝkǝm nduk tǝ Farǝwa. Ma sǝmwumwa ngǝma tahtǝhiwa, ma shimǝm ngǝma chektǝwa. <verse eid="1CO 8:8" /><verse number="9" style="v" sid="1CO 8:9" />Kǝ ɗǝfuni indǝsi, mbǝs thlǝt indengnuni mǝ sokiɗa ǝnat chit hansarǝhi mbǝɗa fichile nguchit alchiɗengnandǝsi. <verse eid="1CO 8:9" /><verse number="10" style="v" sid="1CO 8:10" />Kǝthlǝm ma neɗ yunǝsa le nguchik kwaakwa'a hur fǝrkit, sokǝn tǝ sǝnka sa sǝm'ǝna kǝtǝn mwanandǝ ɗǝhhacha, fǝrauni alchit sǝm i tahsandǝ ficha ɗǝhhachǝwowa? <verse eid="1CO 8:10" /><verse number="11" style="v" sid="1CO 8:11" />Kǝthlǝm ndǝkǝn hwanmani nguchik kwaakwa'a na sǝndeku sokta mba hǝmtǝ'enhi, le mǝrtǝ Kǝrǝsti ɗi kǝthlǝm mǝlan. <verse eid="1CO 8:11" /><verse number="12" style="v" sid="1CO 8:12" />Ma shiɗnǝ ɓǝɓichitfat kǝ mbǝɗa hwanmanchiwa, tǝ mbǝnniyu paɗ ɗǝfau ndindita kandǝ kǝ ɗar ɓah kwaakwaa chiɗengnanda, tǝ sǝnǝ ɓǝɓichitfat kǝ mbǝɗa Kǝrǝsti. <verse eid="1CO 8:12" /><verse number="13" style="v" sid="1CO 8:13" />Kǝthlǝm ndǝkǝn, ma sǝm'ǝn na ɗǝf hwanyaa kǝ yimka hur ɓǝɓichitfata, mwawi tamta chi thlu paɗwa, kǝthlǝm mǝ ɗǝffiɗǝ ndǝ kǝ hǝmǝnhiwa.<verse eid="1CO 8:13" /></para>
  <chapter eid="1CO 8" />
  <chapter number="9" style="c" sid="1CO 9" />
  <para style="s">Ichi Kamkǝsǝ tǝ Tora Lǝthlǝnda</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1" />Njang mbǝs thlǝt indengnǝsǝwowa? Njang nga lǝthlǝndǝ nakiwowa? Anuwi Yǝso Lǝmwaɗengnǝmwowa? Kunang nga kǝni torengnǝ nakuni a hur Lǝmwandǝwowa? <verse eid="1CO 9:1" /><verse number="2" style="v" sid="1CO 9:2" />Chika sokkǝnwa nga lǝthlǝndǝ naki mbǝɗa funiwa, kittǝkǝn mbǝɗengnuni njang lǝthlǝnda, kǝthlǝm kunang naka sheta tǝ tor lǝthlǝɗengna a hur Lǝmwanda.<verse eid="1CO 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 9:3" />Tǝ ndǝkǝn la chandǝ faɗengna kish a mbǝɗa fa tauwasǝnji. <verse eid="1CO 9:3" /><verse number="4" style="v" sid="1CO 9:4" />Alchiɗengnanisǝ kǝ fǝranguni sǝm'ǝna kani tǝ satwowa? <verse eid="1CO 9:4" /><verse number="5" style="v" sid="1CO 9:5" />Nga alchiɗengnanisǝ kǝ tǝrani kan kǝ wi'yani tǝ nishchengnani fafǝrkit nda i la sǝt tahhǝt fathlǝncha, tǝ hwanmancha Lǝmwanda tǝ Kefas yuwowa? <verse eid="1CO 9:5" /><verse number="6" style="v" sid="1CO 9:6" />Nga njang tǝ Barnabas ndak sokkǝ waat kǝ sani tor sǝma'ǝn inchengnani kǝ nanihiwa?<verse eid="1CO 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 9:7" />Wun la sǝk tor thlǝrhwata kana sǝma'ǝn indǝ'en? Wun na pat affǝt inabi kǝ cherka chi hwanchikǝn? Wun na hǝrǝm chaɓa kǝ cherka sat yahkǝn? <verse eid="1CO 9:7" /><verse number="8" style="v" sid="1CO 9:8" />Naki mbu ichiya ɗar yara nifǝwa? Ndu kustǝkǝn kichuwowa? <verse eid="1CO 9:8" /><verse number="9" style="v" sid="1CO 9:9" />Yarang fichǝhi a hur kussa Musa ndatwa: "Mǝ panǝ hwan sokroka latami mamǝla sǝt tora hurhitǝwa." Lat ndak la hǝrǝmtǝ Farǝwa? <verse eid="1CO 9:9" /><verse number="10" style="v" sid="1CO 9:10" />Nga shuwunkǝn kǝthlǝm kǝmnangwowa? Aa kǝthlǝm kǝmnang yarandǝ ficha. Kǝthlǝm lǝ huɗata, nakna huɗat tǝ ɗǝffatsǝ nan mbǝs ǝna, le naka ɗǝktǝ paɗ nakna ɗǝktǝ tǝ yarǝ mbǝs'ǝna hur ɗǝsǝmi hitǝkǝn. <verse eid="1CO 9:10" /><verse number="11" style="v" sid="1CO 9:11" />Ma hifani hanwitǝ shemeɗa Fara hur hanɗǝkikecheng'nuni, kapat ǝnwa ma mbishani icha mbǝɗengnuni? <verse eid="1CO 9:11" /><verse number="12" style="v" sid="1CO 9:12" />Mana funa mbǝs mba sǝt kichu mbǝɗengnuni, sherawani kandǝ tǝ mba sǝt kichuwowa?</para>
  <para style="p" vid="1CO 9:12">Chika kichu suwani tor tǝ mbayiniyuwa, kǝriskani tǝ chikamǝ kǝthlǝm mǝ ɓiɗani tǝ i na njat tor laulawata Kǝrǝstiwa. <verse eid="1CO 9:12" /><verse number="13" style="v" sid="1CO 9:13" />Sǝnwuniwa fichile la sǝk tora kapat hura'a Fara, la mbǝskǝndǝ ɗǝsǝmtengnanda kapat hura'a Farǝkǝnwowa? Fa sǝt tora bagadi la mbǝskǝndǝ ɗǝsǝmta hur ichi la fǝrtǝ fichi i fǝr pofǝnwowa? <verse eid="1CO 9:13" /><verse number="14" style="v" sid="1CO 9:14" />Kichuyu paɗ mbutǝ Lǝmwanda ndatwa, fichile naka ɓassǝ laulawata kǝ thlǝndǝ ǝnat nathi engnandǝ tǝ mbǝɗa laulawatkǝn.<verse eid="1CO 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15" />Njang tamwi sah ǝn kuni hur ichiniyuwa, paɗ nga naki yarat'iya tǝ ɗǝffatsǝwa kǝ sikǝ fichǝ kichuwa. Kweshkǝn kǝ mǝri, mǝni yuna nji wilwirtengna tǝ ndǝkǝn. <verse eid="1CO 9:15" /><verse number="16" style="v" sid="1CO 9:16" />Chika kichu ma ɓesshi laulawatkǝn, ngi wilwirtǝwa, kǝthlǝm ɗǝfkǝ fichǝnji waat kǝ ɓassi. Ai engna ma ɓasswi laulawatkǝnwa. <verse eid="1CO 9:16" /><verse number="17" style="v" sid="1CO 9:17" />Mamuwa la ɓasski a ɗar yahtengna mala kwanikǝ ficha. Sokkǝnwa nga ɗar yahtengnǝwa, tǝni sǝt i malitǝ fichǝhi. <verse eid="1CO 9:17" /><verse number="18" style="v" sid="1CO 9:18" />Mǝnaka kǝnikǝn engna? Kǝnikǝn engna ndǝkǝn naka ɓasse laulawatkǝn, kǝ ɓassǝ pofǝn. Sǝwitor tǝ cheta mbǝɗengnǝ nat a hur ɓassǝkǝnwa.<verse eid="1CO 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19" />Chikama sokkǝn naki kweɗeleng nga hara chikawunwa, saɗi faɗengna mafata nofchǝnat, kǝthlǝm kǝ mbǝsi nofchǝ oi. <verse eid="1CO 9:19" /><verse number="20" style="v" sid="1CO 9:20" />Kǝ mbǝɗa Yahudawecha, naki nda lǝ Yahudawata, kǝthlǝm kǝ mbǝla'i kahhandǝ hur'incha Yahudawecha. Kǝ mbǝɗa fichile nat kussa alchiɗengnanda, naki nda le naka kakǝn paɗ (chikama sokkǝn njang tǝ indengna nga naki ka kustǝkǝnwa) kǝthlǝm kǝ kahhayi hur'incha fichile naka ka kus tǝkǝn. <verse eid="1CO 9:20" /><verse number="21" style="v" sid="1CO 9:21" />Fichile nguchika ka kus tǝkǝn sokki nda kandang (chika sokkǝn nga naki kisshitǝ kussa Farǝwa naki ka kussa Kǝrǝsti) kǝthlǝm kǝ kahhayi hur'inda fichile nguchika ka kus. <verse eid="1CO 9:21" /><verse number="22" style="v" sid="1CO 9:22" />Kǝ mbǝɗa fichile nguchit alchitsi njang ma naki alchitsǝwa, kǝthlǝm kǝ kahhayi hur'incha fichile nguchit alchiɗengnandǝsi. Sokki kǝ ichinat kǝ mbǝɗa nofchǝ nat kǝthlǝm chika tǝ kǝni kǝ hǝrkayi funa. <verse eid="1CO 9:22" /><verse number="23" style="v" sid="1CO 9:23" />Sǝki ichini natyu kǝthlǝm kusheng shundǝ mbinchin, kǝthlǝm kǝ mbǝsi ǝnhar hur mbǝs'ichihar. <verse eid="1CO 9:23" /><verse number="24" style="v" sid="1CO 9:24" />Sǝnwuniwa hur fa teri rahta, nat fa teri rahkǝn la kweekǝndǝhi kǝ pǝɗangnda ndanihi, ǝrtǝ ndak la thlǝk kǝnikǝnwowa? Yimamma rahkǝn kǝthlǝm kǝ mbǝsuni kǝnikǝn. <verse eid="1CO 9:24" /><verse number="25" style="v" sid="1CO 9:25" />Nat fa yimta terriyiniyu, la fǝrangndǝ ɓahta fechengnandǝ chika tǝteni. La sǝkndǝ kichu kǝthlǝm kǝ mbǝsndǝ kǝnikǝn lena sǝɓtaɗi, kǝmnang paɗ la sǝkǝm inǝm kǝ mbǝsǝm kǝnikǝn le nguchika sǝɓtaɗǝ kǝpwaree. <verse eid="1CO 9:25" /><verse number="26" style="v" sid="1CO 9:26" />A rahwi pofǝn nda nga mbǝt ɗǝtsǝwowa, a tokwi fat nda lela tokkǝ rǝnnawa. <verse eid="1CO 9:26" /><verse number="27" style="v" sid="1CO 9:27" />Tǝ fǝrayi ɓahta faɗengna kǝ sayi mafata, kǝthlǝm ɗiffitǝ ɓassanda nofchǝsi njang tǝ indengna mǝ nji fichǝ mbǝs kǝnikǝnwa.<verse eid="1CO 9:27" /></para>
  <chapter eid="1CO 9" />
  <chapter number="10" style="c" sid="1CO 10" />
  <para style="s">Kah Thlǝmat kǝ Ɗar Ɗǝsǝta Isra'ilawecha</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1" />Yahkǝsi kǝ sǝnuni, hwanmancha, ndatwa kakechinǝm nat wikǝnda ka husomba'a, paɗ natndǝ ɗǝkndǝ tǝ hur hawurta. <verse eid="1CO 10:1" /><verse number="2" style="v" sid="1CO 10:2" />A ka husombi'iniyu tǝ hur hawurkǝn sandǝ fichǝ baptisma kandǝ uf kǝ kuwur Musa. <verse eid="1CO 10:2" /><verse number="3" style="v" sid="1CO 10:3" />Natnda sǝmkǝndǝ ɗǝsǝmta shemeɗa. <verse eid="1CO 10:3" /><verse number="4" style="v" sid="1CO 10:4" />Natnda sakndǝ ama shemeɗa, kǝthlǝm sheɗndǝ ama a ngwiya shemeɗa le wiikǝ tǝ kanda. Ngwikǝn Kǝrǝsti nakǝn. <verse eid="1CO 10:4" /><verse number="5" style="v" sid="1CO 10:5" />Chika tǝ kichu, sǝku Farǝ mbǝnfat tǝ funǝ oi a hurnandǝwa, tǝkang fichǝ kandǝhi a loktara.<verse eid="1CO 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6" />Sǝk ichininatyu kǝ naka sakchikǝna mbǝɗengnǝm, kǝthlǝm mǝɗi hanndǝkikechengnǝma ɗar ɓǝɓi ichǝ nda i sǝtndǝwa. <verse eid="1CO 10:6" /><verse number="7" style="v" sid="1CO 10:7" />Mǝ sokiɗuni kǝ fa sǝt tor ɗǝhhachǝ nda i sǝt funengnandǝwa, nda i natna hur yarat laulawatkǝn ndatwa: "Sokkǝ nofchikǝnhi kǝ sǝmndǝ kǝ sanda, thlaakǝnda naknda rǝɓta a hur sǝɓtaɗǝ i fǝlawichita." <verse eid="1CO 10:7" /><verse number="8" style="v" sid="1CO 10:8" />Mǝ yimindǝma fǝlawichit nda i sǝt funengnandǝwa, ɓaka sǝt nifǝ aru kumchitkum chap tǝ aru kumchit mǝkkan (23,000) mǝrka farǝ ǝrta. <verse eid="1CO 10:8" /><verse number="9" style="v" sid="1CO 10:9" />Ngǝma kikeɗandǝ Lǝmwandǝwa nda i sǝt funengnandǝwa, ɓak hwithlincha tǝkandǝ kandahi. <verse eid="1CO 10:9" /><verse number="10" style="v" sid="1CO 10:10" />Mǝ hurmiɗǝm nda i sǝt funengnandǝwa, Mala'ika tǝ ɓǝlta tǝkaǝn kandahi.<verse eid="1CO 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 10:11" />Kǝskǝ ichini kandǝyu kǝ naka sakǝtkǝn, yarang fichǝ kandǝhi kǝthlǝm kǝ sǝka ǝnat kah thlǝmaɗengnǝm, kǝmnang ti ɓat ndukwat kisshikǝna mbǝskǝm. <verse eid="1CO 10:11" /><verse number="12" style="v" sid="1CO 10:12" />Kǝthlǝm ndǝkǝn chikawun yarkǝwa nakǝn kit, kǝ mbǝrǝnsi mǝ hǝmiɗǝhiwa. <verse eid="1CO 10:12" /><verse number="13" style="v" sid="1CO 10:13" />Kiketǝsi tamka mbǝskuni le mbǝsuchitǝn nifǝwa. Farǝ lǝ kachita, ngu tamta ngǝmtǝ kǝ kikeɗang fichǝ kuni tǝ i na sheranda allengnuniwa. Ma kikeɗa fichǝ kuni nan mbǝssa mba chetakissha kuni, kǝthlǝm kǝ mbǝla'uni kǝrǝskǝn.<verse eid="1CO 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14" />Kǝthlǝm ndǝkǝn shikechina, rahamna tor ɗǝhhachihar. <verse eid="1CO 10:14" /><verse number="15" style="v" sid="1CO 10:15" />Shuwunki tǝ kuni kunang fa hur'incha, kǝ yarangunihi kunang tǝ iɗengnuni i mbuti. <verse eid="1CO 10:15" /><verse number="16" style="v" sid="1CO 10:16" />Kop i mbǝs'inhar le la sǝtǝm usoko kǝ ɗarkǝn, nga ndǝkǝn la ɗǝfkǝkǝm kǝnǝm ǝrta a hur fwara Kǝrǝstiwowa? Njohmi la chichaɗǝmhi nga ndǝkǝn la ɗǝfkǝkǝm kǝnǝm ǝrta a hur fwara Kǝrǝstiwowa? <verse eid="1CO 10:16" /><verse number="17" style="v" sid="1CO 10:17" />Kǝthlǝm njohmiya ǝrta, kǝmnang ti nak terchin fat ǝrta, kǝthlǝm nattǝm njohmǝ ǝrtǝ la chiitǝm.<verse eid="1CO 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 10:18" />Kǝlamǝn Isra'ilawecha: Fichile la sǝmka hur i fǝrtǝ ficha, nga la humndǝhi tǝ ndani hur sǝm ichi fǝrandǝ ficha Fara a bagadi tǝ fǝr'ichǝwowa? <verse eid="1CO 10:18" /><verse number="19" style="v" sid="1CO 10:19" />Mǝ nati yarǝ hachiyu? Ɗǝsǝmi fǝrandǝ ficha ɗǝhhacha naka ǝnwa, ndu ɗǝhhakǝn naka ǝna? <verse eid="1CO 10:19" /><verse number="20" style="v" sid="1CO 10:20" />Auwa, yarengnaa i la fǝrtǝ fa sǝt tor ɗǝhhacha la fǝrangnda lǝwurcha nga Farǝwa. Yahwisǝ kǝ la nuni humtǝhi tǝ lǝwurchǝwa. <verse eid="1CO 10:20" /><verse number="21" style="v" sid="1CO 10:21" />Nguni sat tǝ kop a Lǝmwandǝ kǝ suni paɗ tǝ i lǝwurchǝwa. Nguni sǝm'ǝna a mbǝt sǝmɗǝsǝmta Lǝmwanda kǝ sǝmuni paɗ a i lǝwurchǝwa. <verse eid="1CO 10:21" /><verse number="22" style="v" sid="1CO 10:22" />Nǝma ɗǝf Lǝmwandǝ kǝ sǝrǝhtǝwa? Sheraɗǝm tǝ alchitwa?<verse eid="1CO 10:22" /></para>
  <para style="s">Su Chikamǝ Kǝthlǝm Kǝ Mwanangfichǝ Fara</para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23" />"Nat icha ngǝmaficha kǝmsi", Nga nat ichǝ na kǝsanda kǝmsǝwa. "Nat icha ngǝmaficha kǝmsi." Nga nat ichǝ la tinangwa. <verse eid="1CO 10:23" /><verse number="24" style="v" sid="1CO 10:24" />Mǝ si nifǝ ǝn ndiichin kǝ ɗar indǝ'en ɗengwa, kǝsǝn kǝ ɗar'inda funǝ paɗ. <verse eid="1CO 10:24" /><verse number="25" style="v" sid="1CO 10:25" />Chi'u chikawitǝ thlumi, la hi'yandǝ fichaɗa mbǝt hi'yandǝ thluwaɗi, nga tǝ sahmi mbǝɗi ɓat thlukǝnwa, kǝthlǝm mǝni yarengnuni nata mbǝɗi chet thlukǝn. <verse eid="1CO 10:25" /><verse number="26" style="v" sid="1CO 10:26" />Kǝthlǝm: "Kisshitǝ i Lǝmwanda nat tǝ ichi naka hurkǝn."<verse eid="1CO 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 10:27" />Ma eɗ lǝ ɓah fǝrkit sa sǝm ɗǝsǝmta, ngǝmkufǝ ɗǝkuni, sǝmu i ɓandǝ ficha kuni nga tǝ sahmiwa, kǝthlǝm kǝna hur'indǝ ngwalngwal. <verse eid="1CO 10:27" /><verse number="28" style="v" sid="1CO 10:28" />Ma ndu yunǝwa: "Ɗǝsǝmiya i ɗǝhhata", Mǝ sǝminǝwa, kǝthlǝm le mbukǝ paɗ kǝna hanndǝkiketǝ'en yuyur tǝ sokǝn. <verse eid="1CO 10:28" /><verse number="29" style="v" sid="1CO 10:29" />Nga yarkiwa hur'iɗekuwa, ikǝn. Yunǝ nan ndatwa kǝthlǝmmǝ nat ficha nji i yahtǝ faɗengna, kǝthlǝm yuyurchit hanndǝkiketa yuna? <verse eid="1CO 10:29" /><verse number="30" style="v" sid="1CO 10:30" />Ma saɗi Farǝ usoko, kani sǝm ɗǝsǝmkǝn, kǝthlǝmmǝ nat ficha ishnji kǝ ɗar i sandǝ Farǝ usokosi?<verse eid="1CO 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 10:31" />Ndu tǝ sǝmna ndu tǝ sana, ndu chika witǝmǝ natu sǝta, su nat kǝthlǝm mwanandǝ thlǝm Fara. <verse eid="1CO 10:31" /><verse number="32" style="v" sid="1CO 10:32" />Mǝ siɗuni kǝ ǝnat chit hansarǝhiwa, ndu Yahudawecha, ndu fichile nguchika Yahudawecha ndu nofcha Fara. <verse eid="1CO 10:32" /><verse number="33" style="v" sid="1CO 10:33" />Naki kweetǝhi kǝ tǝrayi hura nofchihi nat chika tǝteni. Nga tǝni kat i na mbǝnanda faɗengnǝfǝwa, paɗ i na mbǝnanda nofchǝfǝ oi, kǝthlǝm kǝ hǝrǝknda.<verse eid="1CO 10:33" /></para>
  <chapter eid="1CO 10" />
  <chapter number="11" style="c" sid="1CO 11" />
  <para style="nb">
    <verse number="1" style="v" sid="1CO 11:1" />Sakamnji nda i nati sak Kǝrǝsti.<verse eid="1CO 11:1" /></para>
  <para style="s">I Kamkǝsi kǝ sa Ficha ka Mwanandǝ Fara</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2" />Nja hamkuni kǝthlǝm la kuɗukkuni nji chika hurmi, kishshuni ichi sakandǝ kuni har ɗichin nda i fǝrandi kuni.<verse eid="1CO 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 11:3" />Yah kisi kǝ sǝnuniwa le naka inn chikawun hishnifa Kǝrǝsti, le naka inn chikawun nuhnifa, hishnifa, le naka inn Kǝrǝsti Fara. <verse eid="1CO 11:3" /><verse number="4" style="v" sid="1CO 11:4" />Chikawun hishnifǝ hwanka ndu tǝ mbu'ǝn icha Fara indǝ'ena supta, njirtǝ Kǝrǝsti le nak mwanchinna mbanitǝkǝn. <verse eid="1CO 11:4" /><verse number="5" style="v" sid="1CO 11:5" />Chikawun nuhnifǝ hwanka, ndu tǝ mbu'ǝn icha Fara supwawutǝ i'ndǝwa, njirtǝ sǝmahha le nak mwanchinna mbanitǝkǝn, nakǝn keeke tǝ hǝsandǝ i'ndǝ'enaɗi. <verse eid="1CO 11:5" /><verse number="6" style="v" sid="1CO 11:6" />Ma cher nuhnifǝ supwandǝ i'ndǝ'en, kǝ hǝsaǝn hwasǝ'enaɗi. Manakǝn harǝfatsi ma hǝsa nuhnifǝ hwasǝ'enaɗi ndu kǝ hǝsangkaɗǝ tukulmur, kǝ supwaǝn. <verse eid="1CO 11:6" /><verse number="7" style="v" sid="1CO 11:7" />Kamusi hishnifǝ kǝ supwa'ǝn i'ndǝ'enwa, nakǝn kǝ mirshingta paɗ mwanda Fara. Nuhnifa paɗ mwanda hishnifa. <verse eid="1CO 11:7" /><verse number="8" style="v" sid="1CO 11:8" />Kǝthlǝm a tǝrkakǝn hishnifa nga chekna fata nuhnifǝwa, nuhnifǝ cheka fata hishnifa. <verse eid="1CO 11:8" /><verse number="9" style="v" sid="1CO 11:9" />Su fichǝ hishnifǝ kǝthlǝm nuhnifǝwa, nuhnifǝ sǝt fichǝ kǝthlǝm hishnifa. <verse eid="1CO 11:9" /><verse number="10" style="v" sid="1CO 11:10" />Kǝthlǝm ndǝkǝn sokkǝn waat nuhnifǝ kǝ kǝnǝn ɗankwali i'ndǝ'en, che sakǝtkǝna sǝmah nak mwanchin, paɗ kǝthlǝm mala'ikacha. <verse eid="1CO 11:10" /><verse number="11" style="v" sid="1CO 11:11" />Chika tǝkichu, a hur Lǝmwanda nuhnifǝ nga somǝnhi tǝ hishnifǝwa, hishnifǝ paɗ nga somǝnhi tǝ nuhnifǝwa.<verse eid="1CO 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 11:12" />Nda i nat nuhnifǝ chekna fata hishnifa, kichu paɗ nuhnifǝ ngǝtkǝ hishnifa. Ichi nat paɗ ɓaknda mbǝɗa Fara. <verse eid="1CO 11:12" /><verse number="13" style="v" sid="1CO 11:13" />Yaramǝnhi tǝ inchengnuni, keekesi nuhnifǝ kǝ hwanaǝn Farǝ tǝ indǝ'en chaawa? <verse eid="1CO 11:13" /><verse number="14" style="v" sid="1CO 11:14" />Sakkawu nathi kǝmharwa ma mel hishnifǝ hwasǝ'en njang, nga ǝnat harǝfata mbǝɗ'enwowa? <verse eid="1CO 11:14" /><verse number="15" style="v" sid="1CO 11:15" />Ma hwasa nuhnifǝ njang nga mwandǝ'enwa? Fǝrang fichǝ hwasǝ njang kichuyu kǝthlǝm kǝ ngǝlaǝn i'ndǝ'ensi. <verse eid="1CO 11:15" /><verse number="16" style="v" sid="1CO 11:16" />Ma yunǝsǝ nat halǝ'indǝ'ensi kǝ ɗar iniyu, kanang sǝnwani ɗǝsǝchǝ somǝnwa, nakǝn kichu mbǝɗa tahhǝt nofcha Fara.<verse eid="1CO 11:16" /></para>
  <para style="s">Njirandǝ Sat Jibi Lǝmwandaɗi</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17" />Kǝ ichiya hamwi kuniwa, kǝthlǝm ma hwimunihi nga i katkǝnwa i sǝɓkǝn. <verse eid="1CO 11:17" /><verse number="18" style="v" sid="1CO 11:18" />A tǝrkakǝn, sǝkkiwa ma hwimunihi humta fa tǝrmbanda, a lanak saktǝhisa hurnuni. Ɓeɗi fǝrkita ɗar shuwunkǝn nguɗeh kicha. <verse eid="1CO 11:18" /><verse number="19" style="v" sid="1CO 11:19" />Sokkǝn waat kǝ mbǝs fichǝ saktǝhi hurnuni, kǝthlǝm kǝ sǝnfichǝ fa kachita hurnuni. <verse eid="1CO 11:19" /><verse number="20" style="v" sid="1CO 11:20" />Ma hwimunihi nga jibi Lǝmwandǝ la sǝm tuniwa. <verse eid="1CO 11:20" /><verse number="21" style="v" sid="1CO 11:21" />Kǝthlǝm a chikǝn, chikawun la ɗǝkna mban tǝ sǝm ɗǝsǝmtǝ'en pu'utǝ nifǝwa. Yunǝ tǝ mita fa, yunǝ ngeli har tǝraɗa. <verse eid="1CO 11:21" /><verse number="22" style="v" sid="1CO 11:22" />Nga hurechengnunisǝ kǝ sǝmuni kǝ suni hurkǝnwowa? Tǝ njiruni fa tǝrmbanda Fara, paɗ kǝnuni ɓahhandǝ fichile nguchit ichengnandǝsi? Mǝnati mbwa'anda kuni? Kǝ hamikuni kǝ iniyuwa? Auwa ngi hamkuniwa.<verse eid="1CO 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23" />I fǝrandi kuniya thlǝki mbǝɗa Lǝmwanda ndatwa: Lǝmwandǝ Yǝso, a fiɗiki fǝrtǝ fichǝndi, tǝrkǝn njohma, <verse eid="1CO 11:23" /><verse number="24" style="v" sid="1CO 11:24" />ɗifitǝ sǝt usoko'en, chichaanhi ndakǝnwa: "Faɗengnǝniya, fǝrtǝ fichǝ kǝthlǝm kunang. La sam kichu kǝthlǝm kuɗuktǝ tǝnji." <verse eid="1CO 11:24" /><verse number="25" style="v" sid="1CO 11:25" />Mbandǝ ǝrtǝ paɗ, ɗifitǝ jibi tǝkǝn tǝrkǝn kop, ndakǝnwa: "Koptiya i yuwa ɗǝf shundǝhi a hur fwarengna. Sam kichu nat kǝ farǝ natuni sata kǝthlǝm kuɗuktǝ tǝnji." <verse eid="1CO 11:25" /><verse number="26" style="v" sid="1CO 11:26" />Chika kwat natuni chi njohmiya, paɗ natuni sata a koptiya, nuni mbu mǝrtaɗa Lǝmwanda kǝ fari natna ɓata.<verse eid="1CO 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 11:27" />Kǝthlǝm ndǝkǝn, nat le chiikǝ njohmiya, sheɗɗa hur kop ti Lǝmwandǝya nga hur chiɗchiɗchitwa, shiɗtǝ ɓǝɓichitfat kǝ fata tǝ fwara Lǝmwanda. <verse eid="1CO 11:27" /><verse number="28" style="v" sid="1CO 11:28" />Chikawun kǝ kikeɗaǝn fat'en, kana chi njohhǝmkǝn paɗ kana sata koptǝkǝn. <verse eid="1CO 11:28" /><verse number="29" style="v" sid="1CO 11:29" />Kǝthlǝm chikawun chiika a sheɗ paɗ ngatǝ mwanandǝ fatkǝna Lǝmwandǝwa, paɗ saɗǝ sakmiya fat'ensi, tǝ mbǝɗa chi'ini tǝ saɗini'enyu. <verse eid="1CO 11:29" /><verse number="30" style="v" sid="1CO 11:30" />Ndǝkǝn sǝka nofchǝ oi a hurnuni alchiɗengnandǝsǝwa, funǝ haachinnda, paɗ terchina hurnuni a mirnda. <verse eid="1CO 11:30" /><verse number="31" style="v" sid="1CO 11:31" />Ma yaraɗǝm inchengnǝmhi poo, ngu ficha sakamiya kǝmwa. <verse eid="1CO 11:31" /><verse number="32" style="v" sid="1CO 11:32" />Ma Lǝmwandǝ sakang miyakǝm, na ficha eltandǝkǝm kǝthlǝm mǝ thlandǝ kita kǝmsǝ tǝ kisshitǝwa.<verse eid="1CO 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 11:33" />Kǝthlǝm ndǝkǝn hwanmanchina, ma hwimunihi kǝthlǝm sǝm'ǝna, kǝ pu'uni ndani. <verse eid="1CO 11:33" /><verse number="34" style="v" sid="1CO 11:34" />Ma yunǝsǝ tǝ mitafa, kǝ sǝmǝn'ǝna huri, kǝthlǝm humtengnuni mǝ ɓandǝ thlet shunda kuniwa.</para>
  <para style="p" vid="1CO 11:34">Kǝ ɗar tahhǝt icha, ni mbwa'a mbachǝkǝna kuni ma ɓeɗi.<verse eid="1CO 11:34" /></para>
  <chapter eid="1CO 11" />
  <chapter number="12" style="c" sid="1CO 12" />
  <para style="s">Fǝr Chiɗchiɗ tǝ Shemeɗ Somsomǝn</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1" />Nakǝnya paɗ hwanmancha, pathlǝ fǝr shemeɗ somsomǝn, yahwisǝ kǝnuni tǝ ɓahsǝndǝwa. <verse eid="1CO 12:1" /><verse number="2" style="v" sid="1CO 12:2" />Shinuniwa fari natuni nga fa tǝrmbandǝwa, limfichǝ kuni paɗ shekɗang fichǝ kuni kǝ fa kuwur ɗǝhhachi nguchit shishingchengnandǝsi. <verse eid="1CO 12:2" /><verse number="3" style="v" sid="1CO 12:3" />Kǝthlǝm ndǝkǝn yahkǝsi kǝ sǝnuniwa nifǝsǝ na shunda hur Shemeɗa Fara na ndatwa: "Yǝso nga'ǝn nakǝnwa" paɗ nifǝsǝ na ndatwa: "Yǝso Lǝmwandǝ nakǝn." Manga nakna hur Shemeɗ Chiɗchiɗ wa.<verse eid="1CO 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4" />Nakǝnya fǝrtǝsǝ somǝn somǝn, Shemeɗ ǝrtǝ la fǝrkǝ kanda. <verse eid="1CO 12:4" /><verse number="5" style="v" sid="1CO 12:5" />Mbachǝsi somǝn somǝn i sǝt torcha, chika kichu Lǝmwandǝ ǝrta. <verse eid="1CO 12:5" /><verse number="6" style="v" sid="1CO 12:6" />Torchǝsi somǝn somǝn, chika kichu kǝmka Farǝ ǝrtǝ la fǝrkǝ tori nat chikawuna sǝta.<verse eid="1CO 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 12:7" />Chikawuni fǝra Farǝ mba ɓata Shemeɗa kǝthlǝm kǝ kǝsangka chikawunsi. <verse eid="1CO 12:7" /><verse number="8" style="v" sid="1CO 12:8" />Yuna fǝrang fichǝ Shemeɗ mbǝr shunda, tǝpaɗ yuna Shemeɗ shuwun sǝn'ǝna, natyu tǝ mbǝɗa Shemeɗ ǝrta. <verse eid="1CO 12:8" /><verse number="9" style="v" sid="1CO 12:9" />Yuna i fǝrkit tǝ mbǝɗa Shemeɗ ǝrta, yuna i kǝnandǝ nofcha ɗi tǝ mbǝɗa Shemeɗini ǝrtǝyu. <verse eid="1CO 12:9" /><verse number="10" style="v" sid="1CO 12:10" />Yuna fǝrangndǝ alchit sǝt ǝnat pǝɗandǝ nifǝfa, yunǝ i mbu icha Fara le na sǝt kǝmban, yuna i mbǝla sakandǝ shemeɗchǝhi, yuna i sǝn hanshuwunchǝ somǝn somǝn, yunǝ paɗ mbǝla sǝn i nat hanshuwunchi somsomǝnna mbuta. <verse eid="1CO 12:10" /><verse number="11" style="v" sid="1CO 12:11" />Ichini natyu tora Shemeɗ ǝrtǝ la sǝk kanda, le la sakangnga chikawun nda i yahtǝn.<verse eid="1CO 12:11" /></para>
  <para style="s">Fat Ərta Njarǝchi Somsomǝn</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12" />Nda i nat fat ǝrta njarǝchi'en terchin, chikama sokkǝn njarǝchi'en terchin, nakndǝ kǝ fat ǝrta, nak Kǝrǝsti kichuyu. <verse eid="1CO 12:12" /><verse number="13" style="v" sid="1CO 12:13" />Sangfichi baptisma kǝm nattǝm tǝ Shemeɗ ǝrta kǝ hur fat ǝrta, ndu Yahudawecha, punofcha, ndu mafecha, ndu fichile thlǝk inchengnandaɗi, nattǝm ɗǝfkǝ fichǝkǝm kǝsǝma hur Shemeɗ ǝrta.<verse eid="1CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 12:14" />Fatkǝn nga tahsang fichǝ tǝ njarǝ ǝrtǝwa, paɗ njarǝchǝkǝn terchin. <verse eid="1CO 12:14" /><verse number="15" style="v" sid="1CO 12:15" />Mana sara ndatwa: "Njang nga har nakiwa, makichu nga naki fa fatwa." Mbutǝ kichu ngu ɗǝfndǝ kǝ sakndǝhi tǝ njarǝchikǝnna fatkǝnwa. <verse eid="1CO 12:15" /><verse number="16" style="v" sid="1CO 12:16" />Ma na thlǝmata ndatwa: "Kǝthlǝm njang nga hwanitǝwa, makichu nga naki fa fatwa." Mbutǝ kichu ngu ɗǝfndǝ kǝ sakndǝhi tǝ njarǝchikǝnna fatkǝnwa. <verse eid="1CO 12:16" /><verse number="17" style="v" sid="1CO 12:17" />Ma fatkǝn nat kǝ hwanita, nakficha la sǝkmbǝt tǝ mi? Ma fatkǝn nat kǝ thlǝmata, nakficha la sa mbǝt tǝ mi? <verse eid="1CO 12:17" /><verse number="18" style="v" sid="1CO 12:18" />Kittǝkǝn Farǝ tahsang njarǝcha hur fata, chikayeni nda i yahtǝn kǝ nandǝsi. <verse eid="1CO 12:18" /><verse number="19" style="v" sid="1CO 12:19" />Ma nak fatkǝn nat kǝ njarǝchǝ ǝrta, nak fatkǝna natwa kǝni? <verse eid="1CO 12:19" /><verse number="20" style="v" sid="1CO 12:20" />Nda i natǝn, njarǝchǝ terchin chika kichu fat ǝrta.<verse eid="1CO 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 12:21" />Hwanitǝ ngu ndanda harwa, "Kǝmiwu'ǝntǝsǝwa." Ndu inda kǝ ndangka harchǝwa, "Kǝmiwu'ǝntǝkuniwa." <verse eid="1CO 12:21" /><verse number="22" style="v" sid="1CO 12:22" />A mbandǝ somǝn, njarǝchi fafat la kǝlandǝ fichǝwa nda nga kwaakwa'a ndǝwa, kandang naka kechikǝn, <verse eid="1CO 12:22" /><verse number="23" style="v" sid="1CO 12:23" />Njarǝchi fafat la kǝlandǝ fichǝ nda nga ǝnnakndǝwa, kandang la mwanandani kaǝn. Njarǝchi kamuchiksi kǝ nafichiyu, la kǝlak fichasa kanda, <verse eid="1CO 12:23" /><verse number="24" style="v" sid="1CO 12:24" />njarǝchi'engnǝm nak ndiichinyu, nga ma safichǝ ǝn kandǝwa. Humang Farǝ njarǝcha fata, nda i ngǝrandǝn njarǝchi farawuchit fichi mwanda, sokkǝn tǝ mwanda fa. <verse eid="1CO 12:24" /><verse number="25" style="v" sid="1CO 12:25" />Sǝkǝn iniyu kǝthlǝm mǝni saktǝhisa hur fatwa, njarǝchikǝn kǝ la tǝrndǝwa nakndǝ nat keeke. <verse eid="1CO 12:25" /><verse number="26" style="v" sid="1CO 12:26" />Ma njarǝsǝ ǝrtǝ naka ɓahta, nat ndǝ nanda nata hur ɓahta, ma njarǝsǝ ǝrtǝ fǝrandǝ fichǝ mwanda, nat njarǝchikǝn kǝ mbǝnndǝ fata.<verse eid="1CO 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 12:27" />Nakǝnya kunang naka fata Kǝrǝsti, chikawun ǝrta hurnuni nakǝn kǝ njarǝchi'en. <verse eid="1CO 12:27" /><verse number="28" style="v" sid="1CO 12:28" />A kǝtǝn mwanandǝ Fara hertǝ nofchǝhar, saǝn funa tǝrkakǝn kǝ Fathlǝncha, chapatǝkǝn Tapǝnecha, mǝkkatǝkǝn fa sakaɗaɗi, funǝ fa sǝt ǝnat pǝɗandǝ nifǝfa, funǝ fa kǝnandǝ nofchaɗi, funǝ fa kǝsanda nofchǝsi, funǝ fa kǝlandǝ tora nofcha paɗ funǝ fa shundǝ tǝ hanshuwunchǝ somsomǝn. <verse eid="1CO 12:28" /><verse number="29" style="v" sid="1CO 12:29" />Nat fatǝrmbakǝn fathlǝnchǝwa? Nat fatǝrmbakǝn tapǝnechǝwa? Nat fatǝrmbakǝn fa sakandaɗaɗiwa? Nat fatǝrmbakǝn fa sǝt ǝnat pǝɗandǝ nofchǝfǝwa? <verse eid="1CO 12:29" /><verse number="30" style="v" sid="1CO 12:30" />Nat fatǝrmbakǝn fa mbǝs fǝr kǝnandǝ nofchandǝwa? Nat fatǝrmbakǝn fa shundǝ tǝ hanshuwunchǝ somsomǝnwa? Nat fatǝrmbakǝn fa mbu sakǝt i shuwuntǝ fichǝ tǝ hanshuwunchǝ somsomǝnwa? <verse eid="1CO 12:30" /><verse number="31" style="v" sid="1CO 12:31" />Paɗ kam fǝrtǝ somsomǝn tǝ rahta fichile nak ka mwanchin.</para>
  <para style="p" vid="1CO 12:31">Ni cheɗa mbanda kuni le sherkǝ nat tǝ ndata.<verse eid="1CO 12:31" /></para>
  <chapter eid="1CO 12" />
  <chapter number="13" style="c" sid="1CO 13" />
  <para style="s">Mba Mbǝnfata</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1" />Chikama la mbǝrki shundǝ tǝ hanshuwuncha nofcha tǝ i Mala'ikacha, nakǝn mbǝnfatsa faɗengniwa, sokki nda pupwandǝra lǝ la tik kaǝn, manga kichuwa nda thlǝmra. <verse eid="1CO 13:1" /><verse number="2" style="v" sid="1CO 13:2" />Chikama fǝrtengnǝsi i mbu'icha Fara paɗ la mbǝsayi ichi ɓuɓweeta tǝ sǝndǝ nat, ma fǝrkitchiɗengnǝsǝ kaǝn ni mbǝla mbasandǝ shohlachaɗi nga mbǝnfatsa faɗengniwa nga ǝn nakiwa. <verse eid="1CO 13:2" /><verse number="3" style="v" sid="1CO 13:3" />Chikama ni fǝra ichi naksengnǝ nata fa ɓahcha kǝ fǝri faɗengna kǝ 'yangfichaɗi manga mbǝnfatsa faɗengniwa, ǝnsǝ nati mbǝstisǝwa.<verse eid="1CO 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4" />Mbǝnfata kǝrǝstǝ'ensi, tǝ kafata, sǝrǝhtǝsa hur mbǝnfatwa, thla'andǝ'ensǝwa, mwa'indǝsǝwa. <verse eid="1CO 13:4" /><verse number="5" style="v" sid="1CO 13:5" />Mbǝnfata thla'indǝsǝwa, yah'indǝsa hur mbǝnfatwa, sǝɓhursǝ paapawa, kǝs'ǝnsahurwa. <verse eid="1CO 13:5" /><verse number="6" style="v" sid="1CO 13:6" />Mbǝnfata yahutǝ sǝɓfatwa, la mbǝnkǝnfat kǝ i sǝtficha ɗar kit. <verse eid="1CO 13:6" /><verse number="7" style="v" sid="1CO 13:7" />Mbǝnfat la nakǝn tǝ kǝrǝstafa kǝɗing chika hur witǝmi, la nakǝn tǝ fǝrkit hur chikamǝ nat, la ɗǝfkǝn hanndǝkiketa ichinat, la kǝrǝskǝn tǝ ichinat.<verse eid="1CO 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8" />Tamu mbǝnfata tuɓwatwa kǝparee. Mbu'ichi Farǝ na sǝt kǝmban nan thlǝrǝttaɗi, shundǝ tǝ hanshuwunchi somsomǝn nan shekata, sǝn'ǝna nan thlǝrǝttaɗi. <verse eid="1CO 13:8" /><verse number="9" style="v" sid="1CO 13:9" />Sǝn'ǝnengnǝm nǝhɗuhiwa. Mbu'ichi chandǝ Fara kish ngǝ mbǝɗengnǝm nǝhɗuhiwa. <verse eid="1CO 13:9" /><verse number="10" style="v" sid="1CO 13:10" />Ma ɓeɗ le nǝhhǝɗkǝhi, le nǝhɗuchikhi nan thlǝrǝttaɗi. <verse eid="1CO 13:10" /><verse number="11" style="v" sid="1CO 13:11" />Thlahmbǝɗi nati kǝ hweya, la shuwunkǝ nda hweya, la yarki nda hweya, la mbuki ichi kamkǝsi nda hweya. Kǝ sǝkti nifa, malayi hwanchita. <verse eid="1CO 13:11" /><verse number="12" style="v" sid="1CO 13:12" />Nakǝnya la nakǝm nda a hur shishing'ama, shummǝ shumma, farǝkǝn nakma nat hwanitǝ tǝ hwanita. Sǝn'ǝnengna nakǝnya nǝhɗuhiwa, a farǝkǝn na sǝɗengna nǝhhatǝhi nda i sǝntǝfichinji ndiichin.<verse eid="1CO 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 13:13" />Nakǝnya, ichi mǝkkanya shokndǝ kichu, fǝrkit, ɗǝf hanndǝkiketǝsi, tǝ mbǝnfata. Le nak mwanchina hurnanda mbǝnfata.<verse eid="1CO 13:13" /></para>
  <chapter eid="1CO 13" />
  <chapter number="14" style="c" sid="1CO 14" />
  <para style="s">Fǝr Hanshuwunchǝ Somsomǝn<optbreak /> tǝ Mbu'ichi Naka Yara Fara</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1" />Kwe'yamhi kǝ kuni mbǝnfata, kǝ kuni fǝrta Shemeɗ Chiɗchiɗ, nda i yah mbu ichi naka yara Fara. <verse eid="1CO 14:1" /><verse number="2" style="v" sid="1CO 14:2" />Kǝthlǝm le la shuwunkǝ tǝ hanshundǝ somǝn, nga tǝ nofchǝ natna shundǝwa tǝ Fara, nifǝsǝ la sǝnkǝ i natna mbutǝwa, la mbukǝn icha ɓuɓweeta mbǝɗa alchita Shemeɗa. <verse eid="1CO 14:2" /><verse number="3" style="v" sid="1CO 14:3" />Le la mbukǝ ichi na yara Fara, na shunandǝ nofcha kǝ tinaǝn kanda, kǝ chekaǝn alchita kanda, kǝ saǝn sǝssi kanda. <verse eid="1CO 14:3" /><verse number="4" style="v" sid="1CO 14:4" />Le naka shundǝ tǝ hanshundǝ somǝn naka tinaɗǝ fat'en, paɗ le naka mbu'ichi na yara Fara tinaɗǝ fatǝrmbanda. <verse eid="1CO 14:4" /><verse number="5" style="v" sid="1CO 14:5" />Yahkisi natuni kǝ shununi tǝ hanshuwunchǝ somsomǝn, ɓureɗi yahtǝ kǝ mbu'uni ichi na yara Fara. Le la mbukǝ ichi na yara Fara, sheraɗa le la shuwunkǝ tǝ hanshuwunchǝ somsomǝn, ma mbwi yunǝ hanngalǝ i mbutǝn, kana tinandǝ fatǝrmbanda.<verse eid="1CO 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 14:6" />Nakǝnya hwanmancha, ma ɓeɗi mbǝskuni nja shundǝ tǝ hanshuwuncha, mǝ natna chekanda kuni ma mbwa'awi hangngalǝ shuwunkǝna kuniwa, ndu sǝnda, ndu ichi na yara Fara, ndu sakandaɗi? <verse eid="1CO 14:6" /><verse number="7" style="v" sid="1CO 14:7" />Nakǝn kichu tǝ ichi nguchit shishingtǝsa fechengnanda, nda kǝla'a tǝ ǝnat pecha, ma chu ɓurechengnanda kish ɗiichinwa, wun na sǝn i nat ficha futa tǝ i nat ficha peta? <verse eid="1CO 14:7" /><verse number="8" style="v" sid="1CO 14:8" />Ma pyawu fichǝ kutmetǝ keeke tǝ i nat ficha sǝndǝwa, wun na sǝhatǝfǝ kǝ mbata? <verse eid="1CO 14:8" /><verse number="9" style="v" sid="1CO 14:9" />Nakǝn kichu mbǝɗengnuni, ma shununi tǝ hanshuni mbǝsauchit ficha, nakficha sǝn i mbutuniwa kǝni? Shuwunkuniyu mere pǝɗakna hur rǝnna'a. <verse eid="1CO 14:9" /><verse number="10" style="v" sid="1CO 14:10" />Michisi somsomǝna hur kisshita, chika yen miya tǝ sakǝtkǝnsi. <verse eid="1CO 14:10" /><verse number="11" style="v" sid="1CO 14:11" />Ma sǝnwi sakǝt mikǝnwa, naki nat kǝ roma mbǝɗa lǝ shuwunkǝn, lǝ shuwunkǝn paɗ nakǝn kǝ roma mbǝɗengna. <verse eid="1CO 14:11" /><verse number="12" style="v" sid="1CO 14:12" />Nakǝn kichu mbǝɗengnuni, nakuni tǝ ɓwechit hura a ɗar mbǝs fǝr Shemeɗchi somsomǝn, fǝram alchiɗengnuni kǝ suni tor tǝ fǝr Shemeɗǝ na tinandǝ fatǝrmbanda.<verse eid="1CO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13" />Kǝthlǝm ndǝkǝn, chikawun na shundǝ tǝ hanshundǝ somsomǝn kǝ hwanǝn kǝ fǝrang fichǝ mba sǝn i mbutǝn. <verse eid="1CO 14:13" /><verse number="14" style="v" sid="1CO 14:14" />Kǝthlǝm ma hweni tǝ hanshundǝ somǝn, shemeɗengnǝ hwanka, paɗ yarengnǝ cheku tǝ ǝnwa. <verse eid="1CO 14:14" /><verse number="15" style="v" sid="1CO 14:15" />Mǝnati sǝta? Ni hwandǝ tǝ shemeɗengna, ni hwandǝ tǝ yarengnǝ paɗ. Ni ǝn'imshi tǝ shemeɗengna, ni i'ndǝ tǝ yarengnǝ paɗ. <verse eid="1CO 14:15" /><verse number="16" style="v" sid="1CO 14:16" />Manga kichuuwa, masa sǝt usoko tǝ shemeɗeku, tǝ kǝni le naka kuthlǝmata mbǝsauchik hanshuniniyu ndatwa: "Kǝ sokǝn kichu wa kǝnǝ." Kǝ ɗar usoko tǝ natu sǝta, ma sǝnutǝ i natu mbutǝwa? <verse eid="1CO 14:16" /><verse number="17" style="v" sid="1CO 14:17" />Chika sokkǝnwa shiɗi usoko kaǝn, ǝnsǝ chekandǝna le nak nduk tǝsǝ le sǝnuchikwa.<verse eid="1CO 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18" />Saɗi Farǝ usoko sheraɗi kuni tǝ shundǝ tǝ hanshuwunchǝ somsomǝn. <verse eid="1CO 14:18" /><verse number="19" style="v" sid="1CO 14:19" />Chika kichu, a hur kǝtǝn hwanda kweshikǝn kǝ mbu'i ichi ɗurman tǝ hanndǝkiketengna kǝthlǝm kǝ sakayi funǝhar mǝni mbu ichi aru kumchitkum (10,000) tǝ hanshundǝ somsomǝn.<verse eid="1CO 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20" />Hwanmancha, malamǝn yarǝ'ichǝ nda hwecha. Kǝnuni hwecha a hur ɓǝɓichitfata, kǝnuni pǝktecha hur yarengnuni.<verse eid="1CO 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 14:21" />A hur kus yara fichǝhiwa:</para>
  <para style="q1" vid="1CO 14:21">"Tǝ mbǝɗa nofcha fa hanshuwunchǝ</para>
  <para style="q2" vid="1CO 14:21">somsomǝn paɗ tǝ miya</para>
  <para style="q1" vid="1CO 14:21">romcha nati shundǝ tǝ nofchiya,</para>
  <para style="q2" vid="1CO 14:21">chika tǝkichu ngunda kithlǝmatwa,</para>
  <para style="q1" vid="1CO 14:21">ndat Lǝmwanda."<verse eid="1CO 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 14:22" />Awi shundǝ tǝ hanshuwuncha nakndǝ kǝ sakǝtkǝn nga kǝ mbǝɗa fa fǝrkitwa kǝ mbǝɗa fa ɓahfǝrkit. Mbu yara Fara i fafǝrkit nga i fa ɓahfǝrkitwa. <verse eid="1CO 14:22" /><verse number="23" style="v" sid="1CO 14:23" />Kǝthlǝm ndǝkǝn ma hwim fatǝrmbandǝhi, kana chikawunna nata shundǝ tǝ hanshuwunchi somsomǝn, nakǝn funǝsǝ mbǝsaundǝ i nat ficha sǝtwa, ndu funǝ fa ɓahfǝrkit yimkǝsi, ngunda ndatwa nga nakuni hur'inchǝwa? <verse eid="1CO 14:23" /><verse number="24" style="v" sid="1CO 14:24" />Ma chikawuna mbu yari Farǝ na sǝtta, kana lǝ ɓahfǝrkit ndu yunǝ roma yimtǝsi le sǝnuchik i nat ficha sǝtta, ɓak shunda chikawuna tǝka harfa a kakǝn tǝrtǝhi. <verse eid="1CO 14:24" /><verse number="25" style="v" sid="1CO 14:25" />Naficha chaɗǝ ɓuɓwee ichi kissha hanɗǝkiketǝ'enyu, tǝ kichu hǝmkǝnhi mwanaǝn Fara ndakǝnwa: "Kittǝkǝn Fara hurnuni."<verse eid="1CO 14:25" /></para>
  <para style="s">Kǝ Mwanang Fichǝ Fara Mbayi Kamkǝsi</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26" />Mǝ natma mbuta hwanmancha? Ma hwimunihi yuna imshǝ'ensi i mwanandǝ Fara, yunǝ sakandaɗi, yunǝ mbu'icha, yunǝ shundǝ tǝ hanshundǝ somsomǝn, yuna fǝr hanngalǝ shunda. Sam ichǝnat kǝthlǝm tinandǝ fafǝrkit. <verse eid="1CO 14:26" /><verse number="27" style="v" sid="1CO 14:27" />Mana yuna shundǝ tǝ hanshundǝ somsomǝn, mǝ sheraɗa nifǝ chap ndu mǝkkanwa, kǝ sǝndǝ ɗeɗerra paɗ yunǝ kǝ fǝrǝn hanngalǝ shuwunkǝn. <verse eid="1CO 14:27" /><verse number="28" style="v" sid="1CO 14:28" />Manga yunǝsǝ na fǝr hanngalǝ shuwunkǝnwa, chikawun kǝ ngasǝn ɓa'a hur fatǝrmbakǝn, kǝ shunaǝn fat'en tǝ Fara.<verse eid="1CO 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 14:29" />Tapǝnechǝ chap ndu mǝkkan kǝ shuwunnda, tahchikǝn kǝ kikeɗangndǝ hǝɓakkǝ i mbutǝnda. <verse eid="1CO 14:29" /><verse number="30" style="v" sid="1CO 14:30" />Ma yunǝsa mbǝnniyu ɗas ɓat sǝn'ichikǝna mbǝt'en, le naka shunda tǝrkakǝnyu kǝ ngasǝn ɓa. <verse eid="1CO 14:30" /><verse number="31" style="v" sid="1CO 14:31" />Natuni nuni mbǝla mbu ichi na yara Fara ǝrtǝ ǝrta, kǝthlǝm kǝ sak chikawuni paɗ kǝ mbǝs chikawun alchita, <verse eid="1CO 14:31" /><verse number="32" style="v" sid="1CO 14:32" />Tapǝnecha la mbǝllakǝndǝ hǝrǝm inchengnandǝ har. <verse eid="1CO 14:32" /><verse number="33" style="v" sid="1CO 14:33" />Fara nga Farǝ la shekɗandǝ i'ndǝwa, i yuyurchita.</para>
  <para style="p" vid="1CO 14:33">Nakǝn kichu mbǝɗa fatǝrmbaɗǝ chiɗchiɗ, <verse eid="1CO 14:33" /><verse number="34" style="v" sid="1CO 14:34" />kǝ ngas nishchǝ ɓa a hur kǝtǝn hwacha. Kǝthlǝm fǝrau fichǝ mbanda kandǝ kǝ shuwunndǝwa, kǝ kuwurndǝ ndak nda i mbutǝ kus. <verse eid="1CO 14:34" /><verse number="35" style="v" sid="1CO 14:35" />Ma ǝnsǝ yahtǝnda sahta, kǝ sahhangndǝ hishchǝngnanda huri. Kǝthlǝm ǝnat harǝfata kǝ shuwun nuhnifa a hur kǝtǝn hwanda.<verse eid="1CO 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36" />Tǝrkaakǝ shunda Fara ɓat tǝ mbǝɗengnuniwa, ndu kunang ndak sa'andǝn? <verse eid="1CO 14:36" /><verse number="37" style="v" sid="1CO 14:37" />Mala yarkǝ yunǝwa tapǝnaa nakǝn, ndu le mbǝskǝ fǝrta shemeɗa, kǝ sǝnǝnwa ichi nati yaranda kunisǝya mbuta Lǝmwanda. <verse eid="1CO 14:37" /><verse number="38" style="v" sid="1CO 14:38" />Ma cher yunǝ mbǝnnifiyu, mǝlan ma kǝ cherunindǝfa.<verse eid="1CO 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39" />Kǝthlǝm ndǝkǝn hwanmancha, namtǝ ɓweechit hur mbu ichi na yara Fara paɗ mǝ malaɗuni shundǝ tǝ hanshuwunchǝ somsomǝnwa. <verse eid="1CO 14:39" /><verse number="40" style="v" sid="1CO 14:40" />Kǝ suni chikama a mbayi kamkǝsi, paɗ a hur tahhasǝkǝn.<verse eid="1CO 14:40" /></para>
  <chapter eid="1CO 14" />
  <chapter number="15" style="c" sid="1CO 15" />
  <para style="s">Thlata Kǝrǝsti Hur Mǝmatcha</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1" />Nakǝnya, hwanmancha, ni kuɗkanda kuni kwescha shuni ɓassandi kuniyu, le thlǝtuni thlartuni ɗarkǝn. <verse eid="1CO 15:1" /><verse number="2" style="v" sid="1CO 15:2" />Tǝ mbǝɗa kwescha shuwunkǝn hǝrǝktuni, ma kisshuni shunihar mbwa'andǝ kuni kwaakwaa. Manga kichuuwa fǝrkit engnuni mere.<verse eid="1CO 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3" />I kamkǝsi sǝnandi kunisi, ndǝkǝn naka i thlǝta, ndatwa: "Kǝrǝsti mǝrkǝnaɗi kǝthlǝm ɓǝɓichitfechengnǝm, nda i natna hur yarat laulawata Farǝ le mbutǝn, <verse eid="1CO 15:3" /><verse number="4" style="v" sid="1CO 15:4" />ndatwa thloha ficha, farǝ mun mǝkkatǝkǝn thla'aficha, nda i natna hur yarat laulawatkǝn, <verse eid="1CO 15:4" /><verse number="5" style="v" sid="1CO 15:5" />cheɗaɗǝ fat'ena Kefas kana fichile kumngǝrǝnsǝ chapyu. <verse eid="1CO 15:5" /><verse number="6" style="v" sid="1CO 15:6" />Kana cheɗa fat'ena hwanmancha fichile sheranga aru ɗurman (500) a farǝ ǝrta, mweefunǝsi tǝ shisshingtafa, chikama sokkǝn funa mirnda. <verse eid="1CO 15:6" /><verse number="7" style="v" sid="1CO 15:7" />Kana cheɗa fat'ena Yakubu, tǝ tahhǝt fathlǝnchǝkǝn nat. <verse eid="1CO 15:7" /><verse number="8" style="v" sid="1CO 15:8" />A mweshitkǝn nat, cheɗikǝn fata, nda le ngǝttǝ ficha a fari kamuchiksǝ.<verse eid="1CO 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 15:9" />Kǝthlǝm njang naka mweshitmiya fathlǝncha, kamuchiksǝ kǝ afichǝwa lǝthlǝnda, kǝthlǝm fǝraɗi ɓahta fa tǝrmbanda Fara. <verse eid="1CO 15:9" /><verse number="10" style="v" sid="1CO 15:10" />Tǝ mbǝɗa kafata Fara nati kǝ i natiya, kafat'en kǝ mbǝɗengna nga merewa. Shiɗi tor sheraɗi chikawuna hurnanda, chikama sokkǝn nga njangwa, kafaɗi Farǝ nak tǝ njiyu. <verse eid="1CO 15:10" /><verse number="11" style="v" sid="1CO 15:11" />Ndu njang ndu kaɗang, ɓasskani kichuyu, tǝ kichuyu paɗ fǝrtuni kit.<verse eid="1CO 15:11" /></para>
  <para style="s">Thlata Mǝmatcha</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12" />Ma ficha ɓassǝ thlata Kǝrǝsti a hur mǝmatcha, mǝsǝk la ndat funengnuniwa thlata mǝmatchǝsǝwa? <verse eid="1CO 15:12" /><verse number="13" style="v" sid="1CO 15:13" />Ma nga thlata mǝmatchǝsǝwa, sokkǝn chika Kǝrǝsti thla'awu fichǝwa. <verse eid="1CO 15:13" /><verse number="14" style="v" sid="1CO 15:14" />Ma thlaawu fichǝ Kǝrǝstiwa, ɓassengnani pofǝn, fǝrkitchiɗengnuni pofǝn. <verse eid="1CO 15:14" /><verse number="15" style="v" sid="1CO 15:15" />Ma tana nakǝn kichu, shiɗani fa lekta Fara, kǝthlǝm shiɗani sheta kǝ ɗar Farǝwa thla'aɗǝ Kǝrǝsti hur mǝmatcha, le thla'awuchitǝn, ma tǝ kitwa thla'awu fichǝ mǝmatchǝwa. <verse eid="1CO 15:15" /><verse number="16" style="v" sid="1CO 15:16" />Kǝthlǝm ma thla'awu fichǝ mǝmatchǝwa, sokkǝn Kǝrǝsti ma thla'awu fichǝwa. <verse eid="1CO 15:16" /><verse number="17" style="v" sid="1CO 15:17" />Ma sokkǝn thla'awu fichǝ Kǝrǝstiwa, fǝrkitchiɗengnuni pofǝn paɗ paaya mwakuni hur ɓǝɓichitfechengnuni. <verse eid="1CO 15:17" /><verse number="18" style="v" sid="1CO 15:18" />Sokkǝn fichile fǝrkǝkitta hur Kǝrǝsti, kannda mǝrtaɗi thlǝrǝtkǝndaɗi. <verse eid="1CO 15:18" /><verse number="19" style="v" sid="1CO 15:19" />Ma ɗǝfǝm hanɗǝkiketengnǝm kǝ Kǝrǝsti kǝthlǝm naɗihiya ɗeng, sheraɗima chikawun kǝ ǝnat haɗandǝ nifǝfa.<verse eid="1CO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20" />Kitchitkǝn thla'afichǝ Kǝrǝsti a hur mǝmatcha, mǝlan naka tǝrka thlata fichile mǝrkaɗi. <verse eid="1CO 15:20" /><verse number="21" style="v" sid="1CO 15:21" />Nakǝn ɓak murtǝ tǝ mbǝɗa nifa ǝrta, tǝ mbǝɗa nifǝ ǝrta paɗ ɓat thlata mǝmatcha. <verse eid="1CO 15:21" /><verse number="22" style="v" sid="1CO 15:22" />Nda i nat ficha mǝmattǝ kǝthlǝm Adamu, kichu paɗ kǝthlǝm Kǝrǝsti nat ficha thla'andǝ nofchǝ nat. <verse eid="1CO 15:22" /><verse number="23" style="v" sid="1CO 15:23" />Nak thlakǝna nata ndera chikawun tǝ witǝ ikǝn, Kǝrǝsti na nata tǝrkakǝn, kana fichile naka ikǝn a fari natna ngǝrandǝ'in. <verse eid="1CO 15:23" /><verse number="24" style="v" sid="1CO 15:24" />Kana mweshitmikǝna ɓata, fari natna fǝra kuturǝchita Fara Shinda, ɗifitǝ wuwwelandǝ fa kuturǝchitaɗi, nat tǝ kuturcha tǝ alchita. <verse eid="1CO 15:24" /><verse number="25" style="v" sid="1CO 15:25" />Waat nan sok kuturǝchita, kana ɗǝf atikrechikǝn kǝ ka sarǝchi'en. <verse eid="1CO 15:25" /><verse number="26" style="v" sid="1CO 15:26" />Hanmurtǝ naka mweshitmi atikretǝkǝn ti natna ɓǝllanda. <verse eid="1CO 15:26" /><verse number="27" style="v" sid="1CO 15:27" />"Kǝthlǝm shiɗtǝ ichinat kǝ ka sarǝchi'en" Ma ɗeɗfichǝwa: "Shiɗtǝ ichinat kǝ ka sarǝchi'en", cheɗakissha ɗwaachitkǝnwa nga nat tǝ Farǝ tǝ indǝ'enwa, le ɗǝfkǝ chikamǝnat kǝ ka Kǝrǝsti. <verse eid="1CO 15:27" /><verse number="28" style="v" sid="1CO 15:28" />Kǝ ngǝrandǝ Farǝ ichiniyu kǝ ka sarǝchi'en, hwankǝn paɗ sokkǝna ka Fara, kana Fara nata chikamǝ tǝ tǝmǝ nat.<verse eid="1CO 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29" />Manga thlata mǝmatchǝsǝwa, mǝnat nofchiya sǝta, fichile sandǝ fichǝ baptisma kanda kǝthlǝm mǝmatcha? Ma thla'awu fichǝ mǝmatchǝwa kǝpware, kǝthlǝmmǝ la sandǝ fichǝ baptisma nofchǝ kǝthlǝm kandang? <verse eid="1CO 15:29" /><verse number="30" style="v" sid="1CO 15:30" />Kǝthlǝmmǝ la natma ɗǝf inchengnǝma hur mboro chikayen hanthlǝkta? <verse eid="1CO 15:30" /><verse number="31" style="v" sid="1CO 15:31" />Wembǝta nja miya hanmurta! Yarkiyaa hwanmancha, kittǝkǝn la thla'ayi'indǝ kǝthlǝm kunang hur Yǝso Kǝrǝsti Lǝmwaɗengnǝm. <verse eid="1CO 15:31" /><verse number="32" style="v" sid="1CO 15:32" />Ma mbeɗi tǝ pǝktat hanthlucha a Afisa, kǝthlǝm yarengnǝ kǝ ɗar nifa, mǝ naka mbǝstengnǝhar? Mangu ficha thla'andǝ mǝmatchǝwa,</para>
  <para style="q1" vid="1CO 15:32">"Nga kwesh kǝ sǝmǝm kǝ sǝmwa nakǝn ishki nǝma mǝrta?"<verse eid="1CO 15:32" /></para>
  <para style="m">
    <verse number="33" style="v" sid="1CO 15:33" />Mǝ lǝmi fichǝ kuniwa: "Soktǝ tǝ ɓǝɓinofcha la sǝɓaǝn ka hur'indaɗi." <verse eid="1CO 15:33" /><verse number="34" style="v" sid="1CO 15:34" />Ɓamaɗi kǝ hur'inchengnuni ndiichin, kǝ malanguni sǝt ɓǝɓichitfata. Kǝthlǝm funengnuni sǝnundǝ Farǝwa. Mbuki iniyu kǝthlǝm kǝ harangfat kuni.<verse eid="1CO 15:34" /></para>
  <para style="s">Thlata Fata</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35" />Paɗ funǝ nanda sahtǝ ndatwa: "La thla'ang fichǝ mǝmatchǝwa kǝni? Tǝ witǝ fatmǝ natnda ɓata?" <verse eid="1CO 15:35" /><verse number="36" style="v" sid="1CO 15:36" />Ɓoma! I hǝftu ngu tiftǝwa se ma mirwa. <verse eid="1CO 15:36" /><verse number="37" style="v" sid="1CO 15:37" />Ma hifna, nga cheta i hǝftu tǝ fatkǝn na tiftǝwa, hanwitǝkǝn ndak. Ndu i alkama ndu hanwitǝ ǝn somǝn. <verse eid="1CO 15:37" /><verse number="38" style="v" sid="1CO 15:38" />Farǝ la fǝrang fata hanwitǝkǝn nda i yahtǝn, paɗ chika witǝ hanwitǝmi la fǝraǝn fatkǝn'en. <verse eid="1CO 15:38" /><verse number="39" style="v" sid="1CO 15:39" />Nga nat thlu ǝrtǝwa, nofchǝ tǝ witǝ thlǝwengnanda ǝrta, ɗǝhǝrǝmchǝ tǝ witǝ innanda, ɗishchǝ tǝ witǝ innanda, tinchǝ paɗ tǝ witǝ innanda. <verse eid="1CO 15:39" /><verse number="40" style="v" sid="1CO 15:40" />Tinɗǝsi i afshi neɗsǝ paɗ i kisshita, mwanda i afshi somǝn, mwanda i kisshitǝ paɗ somǝn. <verse eid="1CO 15:40" /><verse number="41" style="v" sid="1CO 15:41" />Mwanda hwatfarǝ somǝn, i ndǝraa somǝn, i hanndǝrechǝ somǝn; kǝthlǝm yunǝ hanndǝraa somǝn mwandǝ'en tǝ le. <verse eid="1CO 15:41" /><verse number="42" style="v" sid="1CO 15:42" />Nakǝn kichu tǝ pathlǝ thlata mǝmatcha. I hǝftǝ ficha nan yirataɗi, i thla'andǝ ficha yirat'ensaɗǝwa. <verse eid="1CO 15:42" /><verse number="43" style="v" sid="1CO 15:43" />La hǝfkǝ ficha tǝ ɓah fǝr mwanda, thla'ang ficha hur mwanda. La hǝfkǝ ficha hur ɓah alchita, thla'ang ficha hur alchita. <verse eid="1CO 15:43" /><verse number="44" style="v" sid="1CO 15:44" />Hǝfkǝ ficha hur cheta fata, thla'ang ficha hur fata shemeɗa. Nakǝn fatsǝ i cheta fata, fatsǝ paɗ i shemeɗa.<verse eid="1CO 15:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="1CO 15:45" />Nakǝn kichu hur yaratkǝn, "Adamu tǝrka nifa sokka nifǝ tǝ shisshingtafa, ndukwalat Adamu shemeɗa lela fǝrkǝ shisshingta. <verse eid="1CO 15:45" /><verse number="46" style="v" sid="1CO 15:46" />Nga le naka i shemeɗ naka tǝrkakǝnwa, i punifǝchita, kana i shemeɗa. <verse eid="1CO 15:46" /><verse number="47" style="v" sid="1CO 15:47" />Tǝrka nifa chekna hur furta a hur kisshita, chapatǝ nifa ɓakna hur afshi <verse eid="1CO 15:47" /><verse number="48" style="v" sid="1CO 15:48" />Nda ini chet nifa hur furtuyu, nakǝn kichuyu tǝ fichile naka i furta. Nda i'ni nat leni hur afshiyu, kichu paɗ natna nata kǝ fichile naka i hur afshi. <verse eid="1CO 15:48" /><verse number="49" style="v" sid="1CO 15:49" />Nda i'ni tǝrtǝm mirshingta leni cheka hur furtuyu, kichu paɗ natma tǝr mirshingta le naka hur afshi.<verse eid="1CO 15:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50" />I nati mbwa'anda kuni, hwanmancha, ngusǝtta faɗengnǝm nda thlu tǝ fwara kǝ yimnda kuturǝchita Farǝwa. Kichu paɗ lǝ yirata ngu mbǝs ǝna a ratǝ le nguchika yiratwa. <verse eid="1CO 15:50" /><verse number="51" style="v" sid="1CO 15:51" />Kamthlǝmathi, ni mbwa'a ǝna kuni ɓuɓweeta. Ngǝma mǝrtǝ natǝmwa, natǝm naficha ɓuɓweɗandǝkǝmhi, <verse eid="1CO 15:51" /><verse number="52" style="v" sid="1CO 15:52" />Nda nakǝnya a tǝɓǝrta hwanitǝhi, a mweshitmi kutmeta. Naficha pyandǝ kutmeta, thla'ang fichǝ mǝmatcha tǝ faɗi nguchika yirata, kana ficha ɓuɓweɗandǝ kǝmhi. <verse eid="1CO 15:52" /><verse number="53" style="v" sid="1CO 15:53" />Kǝthlǝm faɗi na yirata waat kǝ ɓuɓweɗang fichǝhi tǝle nguchika yirata, lela mǝrkǝ paɗ kǝ ɓuɓweɗang fichǝ tǝle nguchika mǝrta. <verse eid="1CO 15:53" /><verse number="54" style="v" sid="1CO 15:54" />Le na yirata ma ɓuɓweɗa fichǝhi tǝle nguchika yirata, le na mǝrta kǝ ɓuɓweɗang fichǝ tǝle nguchika mǝrta, a mbǝnniyu nat i yarandǝ fichǝhi hur shunda Farǝ nan nǝhhatǝhi ndatwa:</para>
  <para style="q1" vid="1CO 15:54">"Mǝhɗafichǝ hanmurta, shera ficha al'en." <verse eid="1CO 15:54" /><verse number="55" style="v" sid="1CO 15:55" />"Ai hanmurta, mbǝs'ǝnekuhara ayi? Ai hanmurta, alchiɗeku ayi?"<verse eid="1CO 15:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="1CO 15:56" />Alchita hanmurta ɓǝɓichitfata, kus naka alchita ɓǝɓichitfata. <verse eid="1CO 15:56" /><verse number="57" style="v" sid="1CO 15:57" />Usoko Fara le fǝrang mbǝs'ǝna kǝmhar tǝ mbǝɗa Lǝmwaɗengnǝm Yǝso Kǝrǝsti. <verse eid="1CO 15:57" /><verse number="58" style="v" sid="1CO 15:58" />Kǝthlǝm ndǝkǝn hwanmanchinǝ ti yahti, thlaramhi kit, mǝ fohha ǝnkuniɗiwa. Kǝnding kǝ fǝrunǝ fechengnuni nat kǝ tora Lǝmwanda, kǝthlǝm shinuniwa ɓahtengnunihi hur Lǝmwanda ngu nat pofǝnwa.<verse eid="1CO 15:58" /></para>
  <chapter eid="1CO 15" />
  <chapter number="16" style="c" sid="1CO 16" />
  <para style="s">Kǝsanda Fichilesǝ Nak Chiɗchiɗ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1" />Nakǝnya pathlǝ kǝsaanda fichilesǝ nak chiɗchiɗ, sam nda i ndaɗi mbǝt ngǝlhwanichi a Galatiyayu. <verse eid="1CO 16:1" /><verse number="2" style="v" sid="1CO 16:2" />A farǝ ladi, tǝrka chika yen mundǝ muɗ, chikawuni kǝla ɗǝfǝn hanndǝɓǝltǝhi kǝlar hur i la mbǝlaatǝn mbǝsta kǝ kǝsǝnhar, kǝthlǝm ma ɓeɗi mǝni hum'icha natsǝwa. <verse eid="1CO 16:2" /><verse number="3" style="v" sid="1CO 16:3" />Ma she'i ni thlǝn fichile hartunihar, ngǝmtuni tǝkanda, tǝ yarat ɗelwer kǝ ɗǝndǝ tǝ fǝrpofǝn engnuni kǝ Urshelima. <verse eid="1CO 16:3" /><verse number="4" style="v" sid="1CO 16:4" />Ma sokkǝnwa keekesi njang paɗ kǝ ɗi, natnda ɗǝfkǝɗǝnji.<verse eid="1CO 16:4" /></para>
  <para style="s">Tahhasǝfǝ i Wita</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5" />Ni ɓata mbǝɗengnuni ma ɗiɗi tǝ Makidoniya, kǝthlǝm yahkisi kǝ ɗi tǝ Makidoniya. <verse eid="1CO 16:5" /><verse number="6" style="v" sid="1CO 16:6" />Mbah kǝ si tolla mbǝɗengnuni, mbahya ma kǝ mbǝrayi fektǝhi mbǝnniyu, kǝthlǝm kǝ kǝsikunisi nat mbǝɗi nati ɗǝta. <verse eid="1CO 16:6" /><verse number="7" style="v" sid="1CO 16:7" />Nga yahtengna kǝnikuni nakǝnya kǝ mbǝrihi ndakwa, ɗǝfi hanndǝkiketǝsi kǝ muni tolla mbǝɗengnuni, ma ngǝma Lǝmwandǝ. <verse eid="1CO 16:7" /><verse number="8" style="v" sid="1CO 16:8" />Paɗ ni thlarǝhi a Afisa kǝ farǝ Pentekos, <verse eid="1CO 16:8" /><verse number="9" style="v" sid="1CO 16:9" />Kǝthlǝm i'ni fichǝ mikǝnndǝsǝ hauyang i tor nat tǝ mbǝs'ǝnsi chika sokkǝn atikrechisǝ kaǝn.<verse eid="1CO 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10" />Ma ɓeɗ Timoti, kǝ ngǝmangnguni kǝ kalǝn fathi hurnuni, kǝthlǝm mǝlan ma na sǝt tora Lǝmwandǝ nda i nati sǝtta. <verse eid="1CO 16:10" /><verse number="11" style="v" sid="1CO 16:11" />Mǝ cherinduni thlǝtndǝwa, kǝ kǝsangngunisa hur witǝ'en yuyur, kǝthlǝm kǝ ngǝraǝn i'na mbǝɗengna, nja kǝlata mba ɓat'en tǝ hwanmancha.<verse eid="1CO 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 16:12" />Nakǝnya pathlǝ hwanmanǝm Afolos paɗ, hwanaɗi tǝ alchitafa kǝ ɗǝka mbǝɗengnuni tǝ tahhǝt hwanmancha, nakǝn nga yahtǝ'en kǝ ɗǝn nakǝnyawa. Nan ɗǝta ma mbish tǝ mbanda.<verse eid="1CO 16:12" /></para>
  <para style="s">Mweshit Mi Shunda</para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13" />Sokam tǝ tahhasǝfa, kǝ thlaruni kit tǝ alchita a hur fǝrkitengnuni, kǝnuni nda hishcha, kǝnuni tǝ alchitafa. <verse eid="1CO 16:13" /><verse number="14" style="v" sid="1CO 16:14" />I natuni sǝtnat kǝ suni hur mbǝnfata. <verse eid="1CO 16:14" /><verse number="15" style="v" sid="1CO 16:15" />Hwanmancha, shinuni nofchi hura'a Istifanus kanda tǝrkakǝ tǝrtǝhi a hur hachahai Akaya, paɗ firndǝ fechengnanda kǝ sangndǝ tora fichile nak chiɗchiɗ. <verse eid="1CO 16:15" /><verse number="16" style="v" sid="1CO 16:16" />Nja hwanandǝ kuni kǝ fǝranguni mwanda witǝ nofchiniyu, tǝ fichile naka shikechǝ torchengnani tǝ ɓahtengnani. <verse eid="1CO 16:16" /><verse number="17" style="v" sid="1CO 16:17" />Shiki mbǝndǝfǝ tǝ ɓata Istifanus, tǝ Fartunatus, tǝ Akaikus, le sokkǝ nda kunang ɓaka. <verse eid="1CO 16:17" /><verse number="18" style="v" sid="1CO 16:18" />Tǝrandǝ hurengnǝhi nat tǝ innuni. Witǝ nofchiniyu kǝla fǝranguni mwanda kanda.<verse eid="1CO 16:18" /></para>
  <para style="s">Mweshitmi Ndat'icha</para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19" />Fa tǝrmbayi Asiyayu kanda nda'icha kuni. Akila tǝ Biriskila tǝ fa tǝrmbayi la humkǝhi hure'engnandǝyu, kanda nda'icha kuni kaǝn hur thlǝm Lǝmwanda. <verse eid="1CO 16:19" /><verse number="20" style="v" sid="1CO 16:20" />Hwanmanchi natta mbǝnniyu kanda nda'ǝna kuni. Kǝ ndangnguni icha ndani tǝ chiɗchiɗ tǝ kǝsndanihar. <verse eid="1CO 16:20" /><verse number="21" style="v" sid="1CO 16:21" />Njang Bulus yarak ndat'ǝnaɗiya tǝ harengna. <verse eid="1CO 16:21" /><verse number="22" style="v" sid="1CO 16:22" />Ma yunǝsǝ nguchit mbǝnfat'ensi kǝ mbǝɗa Lǝmwanda, kǝnaka sǝɓkǝn. Lǝ Lǝmwada a ɓu. <verse eid="1CO 16:22" /><verse number="23" style="v" sid="1CO 16:23" />Kafata Lǝmwandǝ Yǝso kǝnan tǝ kuni. <verse eid="1CO 16:23" /><verse number="24" style="v" sid="1CO 16:24" />Malan mbǝnfaɗengna kǝnan tǝ kuni natuni hur Yǝso Kǝrǝsti. Kǝsokǝn kichu.<verse eid="1CO 16:24" /></para>
  <chapter eid="1CO 16" />
</usx>