<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">MARKUS - Boga Translation Project</book>
  <para style="toc3">Mk</para>
  <para style="toc2">Markus</para>
  <para style="toc1">Kwascha Laulawaɗi Yarat Markus</para>
  <para style="mt2">Kwascha Laulawaɗi Yarat</para>
  <para style="mt1">Markus</para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s">Yohanna lǝ Sǝt Baptima Tahsandǝ Ɓanda Yǝso ɗi</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />Leya kweshcha shundǝ kǝ ɗar Yǝso kǝrǝsti hweya Fara. <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />Nda i yarandǝ tapǝnaa Ishaya hi tǝ ndatwa: "Ni thlǝn lǝ thlǝnda mban le na tahsandǝ mbanɗeku ɗi. <verse eid="MRK 1:2" /><verse number="3" style="v" sid="MRK 1:3" />Ɓurata nifǝ le naka atfata hur loktara, le naka ndatwa tahsan mbanda lǝ Mwanda ɗi kǝ pupwenangnguni mbachikǝn'en hi."<verse eid="MRK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4" />Ɓak Yohanna nakna ɓasa hur loktarǝ tǝ ndatwa: "Chikawuni kǝtǝrǝnhi kǝ sangfichǝ Baptisma kǝ kalang fichǝ ɓǝɓichitfechi'enhi." <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />Nat nofchi Yahudiya tǝ Urshelima ɗǝknda ɓǝɗ'en tǝrkǝndǝhi saǝn baptisma kanda a suhwaɗ Urdun. <verse eid="MRK 1:5" /><verse number="6" style="v" sid="MRK 1:6" />Yohanna njela'en pom ngelupa kǝnaǝn mumi'en tǝ poma, ɗǝsǝmtǝ'en mbecha tǝ ɗecha. <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />Ndakǝnwa yuna ɓata ɗiffitǝna le nak mwanchin mǝ njang chika sahǝt pahǝmchi'en sǝkwisi kǝ koppihi kǝ kwasayihiwa. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />Saayi Baptisma kuni tǝ ama paɗ nakna sǝt ikǝn tǝ Chiɗchiɗ chit Shemeɗa.<verse eid="MRK 1:8" /></para>
  <para style="s">Sa Fichǝ Baptisma Yǝso</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />Hanmunchiniyu ɓak Yǝso thlata Nazarat a thlet hǝmǝt Galili. Yohanna saǝn baptisma a suhwaɗ Urdun. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />Nak Yǝso cheta kisha hur ama chatkichuyu nakǝn in'afshi hi ɓak Shemeɗa Fara hai kǝ ɗar indi'en nda ngungwiɗnga. <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />Sǝkkǝ nofchǝ ɓurata a afshi tǝ ndatwa: "Sokǝn naka hwe'engna le yahti paɗ lela sǝkti mbǝnkǝnfa."<verse eid="MRK 1:11" /></para>
  <para style="s">Kǝkaɗa Sheɗan Yǝso</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />Chatkichuyu pǝkkǝ Shemeɗa Farǝ ndǝ kǝ hur loktara. <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />Munɗǝ kumchit fwaɗa Sheɗanna kǝkaɗanda a hur loktara. Mǝla hur loktara tǝ ɗǝ hǝrǝmcha nak mala'ika Fara kǝssandǝsi.<verse eid="MRK 1:13" /></para>
  <para style="s">Tirke Yǝso Tora Galili</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />Ɗiffitǝkǝn kǝsang fichǝ Yohanna, ɓak Yǝso kǝ hachahai Galili nakna ɓasǝ kweshcha shunda Fara. <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />Ndakǝnwa: "Ɓeɗ hanmunchǝkǝn nduk. Fara yehsǝ cheɗanda kuni wa kutur nakǝn. Chikawuni kǝ tǝrǝnhi, fǝram kit kǝ kwescha shunda Fara."<verse eid="MRK 1:15" /></para>
  <para style="s">Eɗ Yǝso Tǝrka Kimshechi'en</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />Nak Yǝso ɓǝrtǝhi tǝ mi suhwaɗ Galili, nakǝn Siman tǝ Andarawus hwanman Siman kanda muh langtanganga kǝthlǝm fa tumchǝ naknda. <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />Ndang Yǝso kandǝwa: "Kuramnji ni sandǝkuni kǝfa ɓat tǝ nofcha mbǝɗengna." <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />Chatkichuyu malangndǝ tum tincha kurǝkǝndǝndǝ. <verse eid="MRK 1:18" /><verse number="19" style="v" sid="MRK 1:19" />Nak Yǝso witǝ kǝ ɓan, nakǝn Yakubu hweeya Zabadi tǝ Yohanna hwanmankǝn a hur kommbawal, kanda tahsandǝ langtangchengnanda. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />Akǝn kanda malkǝndǝ shinnandǝhi, Zabadi hur kommbawal tǝ tahǝt fa torcheng nanda kurǝkǝndǝndi.<verse eid="MRK 1:20" /></para>
  <para style="s">Yǝso Riktǝ Ɓǝɓi Shemeɗa</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />Ɓaknda Kafarnahum, ɓak farǝ yipta Yahudawecha, yimkǝ Yǝso ɓǝt humta Yahudawechihi, nakna sakanda kandǝhar. <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />Shekɗa ng i'ndǝ kandǝ tǝ witǝ sakiniyu, nda nifǝ sǝkkǝsi, nga nda malndǝmcha thlahɓǝt Musa wa. <verse eid="MRK 1:22" /><verse number="23" style="v" sid="MRK 1:23" />Nifǝsa hur ɓǝt humta Yahudawechikǝnhi tǝ ɓǝɓi Shemeɗa fa hwakǝn, <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />ndakǝnwa: "Mǝ kǝmukǝ tǝ kani Yǝso lǝ Nazarat ta? Ɓaku kǝ tǝkangnǝ kanihiwa? A shini ndu wunnaku. Sokǝn naku Chiɗchiɗ le ɓaka mbǝɗa Fara." <verse eid="MRK 1:24" /><verse number="25" style="v" sid="MRK 1:25" />"Ɓokang Yǝso ɓǝɓi shemeɗkǝnhi ndaǝnwa ngasu ɓa, chukisha fat'en!" <verse eid="MRK 1:25" /><verse number="26" style="v" sid="MRK 1:26" />Ɓǝɓi shemeɗkǝn nakna saktanda mǝla hwata cheknakisha fat'en. <verse eid="MRK 1:26" /><verse number="27" style="v" sid="MRK 1:27" />Pǝɗang ǝnatkǝn nofchǝkǝnfa sahangndǝ ndani witǝ mǝ leya? Yuwa sakandaɗi tǝ sǝktǝsiwa? Ndangna ɓǝɓi shemeɗchǝkǝnwa kǝ chendakish paɗ sǝkkǝndǝndi. <verse eid="MRK 1:27" /><verse number="28" style="v" sid="MRK 1:28" />Kusheng i sǝt Yǝso yu sǝkkǝficha a hachahai Galili nat.<verse eid="MRK 1:28" /></para>
  <para style="s">Kǝnna Yǝso Nofcha ɗǝ oi</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />Ɗiffitǝ chendengnanda kisha ɓǝt humta Yahudawechihi, pǝɗang Yǝso tǝ Yakubu tǝ Yohanna kǝ hura'a nda Siman tǝ Andarawus. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />Nak thlaɓǝr Siman hahchin hafat kakǝnnda, chatkichuyu ɓwa'angnda Yǝso. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />Ɗǝk Yǝso ɓǝsndi kǝskǝn har'en thlaǝn, chat kǝnkǝna ɗaɗi nakna sǝt tor ɗǝsǝmta. <verse eid="MRK 1:31" /><verse number="32" style="v" sid="MRK 1:32" />Ɗiffitǝ hǝmta farǝhi ngomang ndǝ haacha tǝ fa ɓǝɓi luwurcha, <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />Nofchi hur hǝmǝtkǝn ngomkǝnda kish kǝ mi hura'a, <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />Kǝnang Yǝso hachǝkǝnaɗi tǝ fa ɓǝɓi luwurcha, paɗ malawutǝ fa ɓǝɓi luwurchǝkǝn kǝ shuwunndǝwa kǝthlǝm shinndǝndi.<verse eid="MRK 1:34" /></para>
  <para style="s">Piɗet Yǝso Hwanda Ɓǝɗi Nguchit Nifǝsi</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />Thlaakǝna ɓingtǝ tung, mwee ɓǝt shumma kǝ ɓǝt nguɗuk ka hwanda. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />Siman tǝ tahǝt nofchǝkǝn naknda katndi. <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />Mbǝsangnda, ndangndǝwa: "Chikawun mǝla kassa." <verse eid="MRK 1:37" /><verse number="38" style="v" sid="MRK 1:38" />Ndang Yǝso kandǝwa: "Tama hwanhǝmchi naka ɓan, kǝnni ɓasa pǝnniyu paɗ ndǝkǝn cheka ɓat tǝ nji." <verse eid="MRK 1:38" /><verse number="39" style="v" sid="MRK 1:39" />Wu'yaǝn hachahai Galili nak na ɓasa ɓǝt humta Yahudawechihi nak na chandǝ ɓǝɓi luwurcha kish.<verse eid="MRK 1:39" /></para>
  <para style="s">Kǝna Yǝso Nifǝ tǝ Tarkwinda fa</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />Ɓak nifǝ tǝ tarkwinda fa, kopkǝnhi nakna hwanandǝ tǝ ndatwa: "Ma yehnǝsi kǝnitǝna ɗaɗi." <verse eid="MRK 1:40" /><verse number="41" style="v" sid="MRK 1:41" />Haɗaǝn Yǝso fa, tǝka'ǝn harfa, ndakǝnwa: "Yehisi kǝnu ɗaɗi." <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />Chat kichuyu yimkǝ tarkwiinkǝnhi kǝnkǝnaɗi. <verse eid="MRK 1:42" /><verse number="43" style="v" sid="MRK 1:43" />Ndang Yǝso wa pǝɗu kǝ mbwa'ana nifǝwa, <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />"Mbwa'ana chikawunwa, pǝɗu ɗu cheɗan faɗǝ ku Pǝrist kǝ fǝrnǝ i la fǝrtǝ ficha ma kǝnafichǝ nifa ɗaɗi nda ǝnnǝnǝ sakandǝ Musa kuni har yu, kǝ sokka ǝnnat sǝndǝwa kinnaɗi." <verse eid="MRK 1:44" /><verse number="45" style="v" sid="MRK 1:45" />Pǝɗakǝn nakna mbwa'anda nofcha nakna fanandǝ shuwunkǝnhi ka'ǝn, kǝthlǝm ndǝkǝn Yǝso mbǝla'utǝ kalǝfathi a thlet hwanhǝmchǝkǝnwa. Pǝndakǝn kǝ ɓǝt ngunduk, paɗ nak nofcha ɓata mbǝɗ'en chika tǝ teni.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s">Kǝna Yǝso Nifǝ le Saka ɗi</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />Ɗiffitǝ hwanmunchǝkǝn ɗimek, ngǝrang Yǝso in kǝ Kafarnahum, sǝkkǝ nofchǝwa mǝlahuri. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />Ɓak nofchǝ oi, paɗ mwa'u ɓǝtsǝwa taa kǝ mikǝnnda, mǝlan paɗ nakna ɓasa pathla Fara kanda. <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />Nɗǝkǝn ɓat nofcha mɓǝɗ'en tǝ tǝraɗ, nofchǝ fwaɗa tǝrkǝndi. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />Mbǝsundǝ ɓǝt kǝ thlǝmatkǝn ndukwa, kǝthlǝm yakat nofcha tǝrkǝndǝ tǝ ɗar kǝtǝnkǝn, pahangndǝhi fǝrkǝndǝnda hai kǝ mbanitǝ Yǝso a ɗar ɓǝt hunat'en. <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />Nak Yǝso fǝr kitchiɗengnandǝhi, ndangna le sakaɗiyuwa: "Hweya kalu fichǝ ɓǝɓifechekuhi." <verse eid="MRK 2:5" /><verse number="6" style="v" sid="MRK 2:6" />Malɗǝmchi fǝrkǝ kit kǝ kussa Musa yu nak ɗǝɗassa mbǝnniyu naknda yarandǝhi hur hanndǝkikecheng nanda. <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />"Kǝthlǝm mi nat nifiya shundǝ kichuyu? Mbwitǝ i nguchik keeke kǝ ɓǝɗa Fara, wunla kalang ɓǝɓichitfata nifǝhi manga Faruwa?" <verse eid="MRK 2:7" /><verse number="8" style="v" sid="MRK 2:8" />Tangtang neɗ Yǝso hi hur shemeɗ'en i nannda yara, ndangna kandǝwa: "Kǝthlǝm mi natuni yarǝ kichuyu hur hanndǝkikechengnuni? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />Len nak pa'pa i? kǝ ndangna le sakaɗiyuwa kalufichi ɓǝɓifandekuhiwa ndu kǝndangnǝwa thla'u tǝru ɓǝt hunaɗeku kǝ wii nǝ witekuwa? <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />Kǝthlǝm kǝsǝnuniwa alchita hweya nifǝsi kǝ kalǝn ɓǝɓifathi a hur kishi'iya, ndangna le sakaɗǝ tǝkǝnwa: <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />"Ndukiwa thla'u tǝru ɗǝngleku kǝ pǝɗana ɗaɗi kǝ hure'eku." <verse eid="MRK 2:11" /><verse number="12" style="v" sid="MRK 2:12" />Thlaakǝn tukwas tǝrkǝn ndǝnglǝ'en cheknakissha hur hurǝkǝn, ɓanitǝ chikawuni, shekndang indǝ kanda naknda mwanandǝ Fara, ndangndǝwa: "Tamwuma nat ǝn kicheyawa."<verse eid="MRK 2:12" /></para>
  <para style="s">Eɗ Yǝso Lawi</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />Ngǝrkǝn chetakish paɗ kǝ mi hawurta, ɓak ngom nofcha ɓǝɗ'en, paɗ sakangnakandǝ har. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />Nakna mbǝrtǝhi, nakǝn Lawi hweya Halfa ɗas ɓǝt thlǝt chamta, ndaǝnwa: "Kurunji" thlaakǝn kurukǝnndi. <verse eid="MRK 2:14" /><verse number="15" style="v" sid="MRK 2:15" />Nak Yǝso sǝm'ǝna a hurhura'a Lawi tǝ fa thlǝt chamcha tǝ fa ɓǝɓichitfata, tǝ kimshechi'en kǝthlǝm nofchǝ ka'ǝn kurukǝndi. <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />Kǝ nat malɗǝmcha fa sakandǝ ndelwercha Musa ɗi fichile naka Farisiyawecha, Yǝso mǝla sǝm'ǝn tǝ fa ɓǝɓifecha, tǝ fa thlǝt chamcha, ndangnda kimshechi'enwa kǝthlǝm mi natna sǝm'ǝn tǝ fa thlǝt chamcha paɗ tǝ fa ɓǝɓifecha? <verse eid="MRK 2:16" /><verse number="17" style="v" sid="MRK 2:17" />Kǝ sǝktǝ Yǝso kandǝ kichuyu, ndangna kandǝwa: "Nofchi nak ngwalngwal hi, kǝmawu ǝn kandǝ tǝ lǝ fǝr hanɓǝɓaawa, fichile nak hahchin na kanndi. Ɓuwi kǝthlǝm kǝ i fichile fǝrkǝ kitwa, ɓaki kǝthlǝm fa ɓǝɓichitfata".<verse eid="MRK 2:17" /></para>
  <para style="s">Sahhami Yǝso kǝ Ɗar Cherǝ Ama</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />Nakǝnya kimshecha Yohanna tǝ Farisiyawecha kanda cherǝ ama. Ɓak nofcha mbǝɗa Yǝso sahangndǝwa: "Kǝthlǝm mi nat kimshecha Yohanna tǝ i Farisiyawecha cherǝ ama paɗ ichiwa kanda cherǝ amwa? <verse eid="MRK 2:18" /><verse number="19" style="v" sid="MRK 2:19" />Ngǝmang Yǝso wa, tǝkǝnǝnat sǝmat pera nata thlǝmat shikechikǝn kǝnnda cherǝ ama? Ngu nat kichuwa, ma mwe sǝmat perǝkǝn tǝ kandǝwa. <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />Hanmunchǝkǝna ɓata le nat ficha tǝrandǝ sǝmat perǝkǝna thlǝmannda farinǝyu nanda cherǝ ama. <verse eid="MRK 2:20" /><verse number="21" style="v" sid="MRK 2:21" />Nifǝsi na ɓumandǝ yuwa njela'a tǝ ɗohǝt njelaawa kǝthlem ma shiɗ kichu na ɗohǝt njelǝkǝna thlahtaɗi ka'ǝn. <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />Nifǝsi na thlǝr yuwa am innabi kǝ hur ɗohǝt kupat wa, kǝthlǝm nan fǝlta ɗi paɗ nu kuɓat i hurkǝnyu tǝ kupatkǝn nat. Kǝthlǝm ɗǝkǝn naku thlǝr yuwa am innabi kǝ hur yuwa kupata.<verse eid="MRK 2:22" /></para>
  <para style="s">Yǝso Lǝmwanda Mǝlan na Farǝ Yipta</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />Farǝyipta nak Yǝso ɓǝrtǝhi tǝ hur hitǝ hwarma, nak kimshechi'ena ɓwerǝt hwarǝm kǝnna mi. <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />Ndang Farisiyawechǝwa: "Nu, kǝthlǝm mi nannda sǝt i ngǝmawuchit kustǝkǝn kǝ sǝficha farǝ yipta?" <verse eid="MRK 2:24" /><verse number="25" style="v" sid="MRK 2:25" />Ngǝmaǝn kandǝwa: "Tamwuni changngandǝwowa, i sǝt Dauda yahkǝn ɗǝsǝmta kǝthlǝm mitafi'en, kandang tǝ nofchi'en fichile naka thlǝmatkǝnwa? <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />Yim kǝna kǝtǝn mwanandǝ Fara a thlahɓǝɗi nat Abiyata kǝ kapat Pǝrist, chiikǝn njohmi tahsandǝ fichihi kǝthlǝm kapat Pǝrist le kamuchiksi kǝ chii nifǝ somǝnwa, kapat Pǝrist ndak kamkǝsi kǝ chi'ǝn. Paɗ fǝrangna fichile naka thlǝmatkǝn yu. <verse eid="MRK 2:26" /><verse number="27" style="v" sid="MRK 2:27" />"Ndang Yǝso kandǝwa, sǝk fichǝ Farǝyipta Yahudawecha kǝthlǝm nifa, su fichǝ nifa kǝthlǝm Farǝyiptǝwa." <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />Kǝthlǝm ndǝkǝn, Hweya Nifǝ mǝlan naka Lǝmwanda nat tǝ i Farǝyipta."<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s">Nifa le Sat Har'ennaɗi a Kafarnahum</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />Farǝ le yimkǝ Yǝso ɓǝt humta Yahudawechihi, nakǝn nifa le sat har'enaɗi. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />Nak nofcha kǝlandǝ ndu na Yǝso kǝnandaɗaɗi farǝ yipta kǝthlǝm kǝ mbǝsndǝ i nannda tǝramiyafa <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />Ndang Yǝso le sat har'ennaɗiyuwa: "Thla'u thlaru mbanitǝ nofcha." <verse eid="MRK 3:3" /><verse number="4" style="v" sid="MRK 3:4" />Sahang Yǝso kanda: "Mǝ mbutǝ kustǝkǝn kǝsǝficha Farǝ Yipta? kafatwa ndu ɓǝɓichitfatwa, kǝ hǝrkang fichǝ shisshingtǝwa ndu kǝ ɓǝlang fichǝwa?" ngaskǝndǝ shetǝta. <verse eid="MRK 3:4" /><verse number="5" style="v" sid="MRK 3:5" />Kǝlang Yǝso kandǝ tǝ sǝɓ hur ka'ǝn kǝthlǝm kwaakwaachit hanndǝkikechengnanda. Ndaǝnwa: "pupwanan harekuhi." Pupwanaǝn hi kǝnkǝnaɗi.<verse eid="MRK 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 3:6" />Chek Farisiyawecha tǝ wesha kǝ ɓǝnda nofcha Hiridus kǝthlǝm kǝ tahsangndǝ mbayihi nannda ɓǝlandǝ Yǝso.<verse eid="MRK 3:6" /></para>
  <para style="s">Nofchǝ oi Kurǝkǝ Yǝso</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />Thlaakǝ Yǝso tǝ kimshechi'en kǝmi hawurta, kurǝkǝ nofchǝ ndǝ oi thlata Galili nat tǝ nofcha Yahudiya, <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />sǝkkǝndǝ ichi nat nanna sǝtta, yakat nofchǝ ka'ǝn ɓaknda mbǝɗ'en, thlata Urshelima, Edom tǝ hachahai Urdun taa kǝ Taya tǝ Sidon. <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />Kǝthlǝm rahanda njekthlǝ-njekthlǝchitta nofchihar, ndangna kimshechi'enwa ɗama kǝlam han kommbawal har ǝrta, kǝthlǝm terǝ nofcha mǝninda tǝkaharfa. <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />Kǝnannɗǝ nofcha ɗaɗi oi, nat fa hafecha nangnda ɓahtǝ nduk kǝthlǝm kǝ mbunangndǝharfa. <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />Chika kwat nat ɓǝɓi shemechikǝn ndi chat kopkǝndǝhi kanda kukwara ndangndǝwa: "Sokǝn naka hweya Fara." <verse eid="MRK 3:11" /><verse number="12" style="v" sid="MRK 3:12" />Tiiɗaǝn thlǝmechengnanda kǝ mbwa'anda nifǝ ndu wunnakǝnwa.<verse eid="MRK 3:12" /></para>
  <para style="s">Teɗ Yǝso Kimshechi Kumngǝrǝnsǝ Chap</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />Tǝrkǝna ɗargwiya akǝn fichile yahtǝn ɓaknda ɓǝsndi <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />Taɗkǝn nofchǝ kum ngǝrǝnsǝ chap akǝn kandǝwa kimshechi'en fichile na nat tǝndi, ɓahnan la thlǝnkanda kǝ ɗǝnda ɓasa. <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />Paɗ nuni mbǝs alchit chandǝ ɓǝɓi luwurcha kish. <verse eid="MRK 3:15" /><verse number="16" style="v" sid="MRK 3:16" />Fichile taɗtǝn kum ngǝrǝnsǝ chap yu, Saminu (le ɗǝfandǝnwa Bitrus), <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />Yakubu hweya Zabadi tǝ Yohanna hwanmankǝn (le ɗǝfandǝn paɗwa Buwanarjis sakǝtkǝnwa hwecha ɓok era"), <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />Andarawus, tǝ Saminu, tǝ Filibus, tǝ Bartamalawus, tǝ Matiyu, tǝ Toma, tǝ Yakubu hweya Halfa, tǝ Taddawus, tǝ Saminu lǝ Kan'anata. <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />Tǝ Yahuda Iskariyoti le hi'yang Yǝso ɗi.<verse eid="MRK 3:19" /></para>
  <para style="s">Yǝso tǝ Ba'alzabul</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />Chat pǝɗak Yǝso huri, ngǝrkǝ nofcha ngomtǝ oi, mǝlan tǝ kimshechi'en ɓǝsundǝ har sǝm ndǝsǝmtǝwa. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />Kǝ sǝktǝ nofchi'en ɗǝknda kǝsanda kǝthlǝm nofcha ndatwa: "Tǝraa luwurcha." <verse eid="MRK 3:21" /><verse number="22" style="v" sid="MRK 3:22" />Malɗǝmchǝ fa sakandǝ ɗelwercha Musa ɗi, fichile ɓaka a Urshelima ndangndǝwa: "Kutur luwurchǝ naka fi'en paɗ tǝ alchita kutur luwurcha la rǝktǝn luwurcha kish." <verse eid="MRK 3:22" /><verse number="23" style="v" sid="MRK 3:23" />Ak Yǝso kanda, shuwunkǝn tǝ kanda hur sakǝtkǝn, ndakǝnwa tǝkǝni nat sheɗanna ɓǝla kǝtandǝ sheɗanna kish? <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />Ma shek kuturichithi chap, kuturichitkǝn ngu soktǝwa. <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />Kichu paɗ ma shek huraahi chap hurǝkǝn ngu thlarǝwa. <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />Sheɗan ma thla'aɗa fat'enfa kǝssakǝnhi ngu ɓǝla thlarǝwa kǝthlǝm ndukwat'en ɓaka. <verse eid="MRK 3:26" /><verse number="27" style="v" sid="MRK 3:27" />Kitchitkǝn nifǝsina ɓǝla yimta hura'a lǝ alchit kǝ herka'ǝnwa, manga tǝ kǝnaǝn lǝ alchitkǝnhi kana mbǝla herkandǝwa. <verse eid="MRK 3:27" /><verse number="28" style="v" sid="MRK 3:28" />Kitchikǝn tǝni mbwa'anda kuni nat ɓǝɓifechi sǝt nofcha na ficha kalandakandǝhi tǝ chika wun njirfat sǝtnda, <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />Chika tǝ kichu le njirkǝ Chiɗchiɗ tǝ Shemeɗa ngu ficha kalandǝhiwa nakna nat kǝla ɓǝɓichitfat kǝ pware. <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />Mbukǝ Yǝso kichu kǝthlǝm lǝ ndangndǝwa: "Ɓǝɓi shemeɗ'ensi."<verse eid="MRK 3:30" /></para>
  <para style="s">Man Yǝso tǝ Hwanmanchikǝn</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />Ɓak mankǝn tǝ hwanmanchikǝn thlarkǝnda kish, thlǝnkǝndǝwa kǝɓan. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />Yakat nofchi tauranghiyu shuwunkǝndǝ tǝ ndi ndangndǝwa, yatu tǝ hwanmanchiwa kanda katsa kish yehndǝ sa natsa. <verse eid="MRK 3:32" /><verse number="33" style="v" sid="MRK 3:33" />Ngǝmaǝn kandǝwa: "Wun yaa tǝ hwanmanchina?" <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />Tǝɓǝrkǝnhi tǝ ɓǝɗa fichile ɗas ɗas yu ndangnakandǝwa: "Nam kandǝya fichileya naka nda yaa tǝ hwanmanchina" <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />Nat le sǝk i yahtǝ Fara mǝlan na hwanyaa tǝ yaa.<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">Sakǝtkǝn tǝ la Hǝfta</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />Paɗ tǝrkaakǝ Yǝso sakandaɗa mi kapat hawurta ngomkǝ nofchǝ ka'ǝn, tǝrkǝna hur kommbawal sokkǝnhi kǝ hurkǝn, nofchǝ oi a mi chicheng hawurkǝn. <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />Nakna sakandakandǝhara a hur sakǝtkǝn tǝ ndatwa. <verse eid="MRK 4:2" /><verse number="3" style="v" sid="MRK 4:3" />Sǝkama! chek lǝ huɗata kish ka hǝfta <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />Nakna weshǝ witǝkǝn, funǝ witǝkǝn hǝmkǝnda hai kǝ hur mbanda, ɓak hanɗishcha chathlanda. <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />Funǝ witǝkǝn paɗ hǝhatkǝnnda ɗar fufurta ɓǝɗi nguchit furtǝsǝ ɗiichin, tifkǝnda kish leɗleɗ, kǝthlǝm ngafurtǝsa ɗarkǝn ɗiichinwa, <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />Tǝkkǝ hwatfarǝhi, lifirkǝndaɗi kǝthlǝm nga thlorǝ'ensǝ ɗiichinwa, hwarkǝnaɗi. <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />Paɗ funǝ hǝhatkǝnda hur ndahcha, mwankǝnda paɗ njekthlang ndahchiyu ɓǝla'utǝ sǝt hwechafuwa. <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />Funǝ paɗ hǝhatkǝndahai kǝ hachahai ɗiichin mbulkǝn sǝkǝn hwechafa, funǝ kumchit mǝkkan, funǝ kumchit tehhweth, funǝ paɗ kumchit kum. <verse eid="MRK 4:8" /><verse number="9" style="v" sid="MRK 4:9" />Ndak Yǝso wa: "Le nat thlǝmat sǝktǝ'ensi kǝ sǝkkǝn."<verse eid="MRK 4:9" /></para>
  <para style="s">I Sǝk Fǝrtǝn Sakǝtkǝn</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />Nak Yǝso ichitkǝn, fichile nduk tǝndǝ tǝ kimshechi'en kumngǝrǝnsǝ chap, sahahndǝ sakǝt shuniniyu. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />Ndangnakandǝwa: "kunang ngǝmaficha kunisi kǝ sǝnnuni i naka ɓuɓweeta hur mwanda Fara, fichile nguchika hurnuni, chikamǝ naki mbwa'anda kanda hur sakǝtkǝn. <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />Nanda kǝllathi kǝ kǝllathi chika kichu ngunda natwa, kǝ kandǝ thlǝmathi kǝ kat thlǝmathi chika kichu ngunda sǝktǝwa. Kǝthlǝm ma shiɗndǝ kichu nanda tǝɓǝrtǝhi ɓǝnda Fara kǝ kalang fichi ɓǝɓichitfechengnanda kandǝhi. <verse eid="MRK 4:12" /><verse number="13" style="v" sid="MRK 4:13" />Ndangnakandǝwa, awi sǝnwuni sakǝt shuniniyuwa? Nakuni sǝn yakat sakchikǝnwa kǝnni? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />Lǝ huɗaɗiyu hiftǝ shunda Fara. <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />Fichile hǝhatkahai kǝ hur mbandǝyu, kandang naka sakǝt fichile hǝftǝ fichǝ shuwunkǝna hanndǝkikechengnandǝyu, kǝ sǝktǝnda chat kichuyu ɓak sheɗanna thlandǝ kandǝhar. <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />Kichu paɗ hanwitǝ hǝftǝ ficha hur fufurtǝyu, kandang naka fichile sǝkkǝ shuwunkǝn thlǝkndǝ tǝ mbǝnfata. <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />A nakǝn sutǝ thlora hanndǝkikechengnanduwa, nga alchindengnandǝsuwa, ma yimnda hur ɓahtǝ kǝthlǝm shuniniyu chikndǝ hansarǝhi. <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />Funǝ paɗ kandang naka sakǝt fichile hǝhatka hur ndahchiyu, kandang sǝkkǝ shuwunkǝn, <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />paɗ ǝnat kishita tǝ kǝnecha tǝ yah icha kishita, yimkǝndǝsi njaǝn shuwunkǝnna kanda suwa kweshchaǝnwa. <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />Fichile hǝhtǝ ficha hur furtǝ ɗiichinyu kandang naka sakǝt fichile sǝkkǝ shuwunkǝn thlǝknda, sǝkndǝ torsi mbǝskǝndǝ chekǝtkǝn, funǝ kumchit mǝkkan, funǝ kumchit tehhweth, funǝ kumchitkum.<verse eid="MRK 4:20" /></para>
  <para style="s">Tikesha le Supwandǝ Fichǝ tǝ I'nafta</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />Ɗǝk Yǝso mban tǝ ndanda kanduwa: "Mǝlapakaa la ɓak fichǝ tǝ tikesha huri kǝthlǝm kǝ supwang fichǝ tǝ i'naftǝwa, manga kichuwa kǝ ɗǝffichǝhi kǝka ɓǝt hunatwa? le ɓatunitǝkǝn kǝthlǝm kǝ ɗǝffuni kǝ ɓǝɗi la ɗǝftǝfichǝwa? <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />Ənsǝnaka ɓuɓweetǝ nguchit ficha chandakishwa, ǝnsa supta nguchit ficha kwallandandǝwa. <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />Le nat thlǝmat sǝktǝensi kǝ sǝkkǝn!'' <verse eid="MRK 4:23" /><verse number="24" style="v" sid="MRK 4:24" />Paɗ ndangna kandǝwa, ɗǝffam i'ndǝsi, kǝ ɗar ǝnǝnǝ sǝktuniyu, somǝɗi kǝkaɗtusi, tǝ ndǝkǝn nat ficha kǝkaɗutǝsi. <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />Kǝthlǝm le natǝn'ensi, mǝlan nat ficha chekanda, le nguchitǝn'ensi paɗ chikale naka har'en na ficha thlandǝhar kǝ chekang ficha le natǝnsǝ'en.<verse eid="MRK 4:25" /></para>
  <para style="s">Sakǝt Tifta Wita</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />Ndakǝn paɗwa: "Mwanda Fara nakǝn nda nifǝ weshkǝ witǝ'enna hachahaya. <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />Kǝ hunanhi kǝ thlaǝn tifkǝ witǝkǝnna kish, mwankǝn, sǝnutǝ ndu sǝkǝn kǝniwa. <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />Furtǝ tǝ i'ndǝ'en la ɓǝlaakǝn mwanandǝ hwarma paɗ kǝ ɓulǝn, sǝn hwechafa. <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />Ma nihiɗi hwasaǝn tǝ chelta, kǝthlǝm shee thlahɓǝt nǝhatǝ'en."<verse eid="MRK 4:29" /></para>
  <para style="s">Sakǝtkǝn tǝ Hwan Musdad</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />Ndakǝn paɗwa, nakma kǝkaɗandǝ mwanda Farǝ tǝ mi? Manga kichuwa witǝ sakǝtmi natma kǝkaɗandǝfa? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />Nakǝn nda hwan musdad, le nak nguɗeh a hur ichi la hǝftǝficha hachahaya. <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />Chika tǝ kichu ma hǝffa ficha, nan mwanda kǝ mbǝranka tahǝt afchihi hur hitǝkǝnyu, njarkǝnhi ka'ǝn paɗ kana hanɗishcha sokta kaaftǝ'en. <verse eid="MRK 4:32" /><verse number="33" style="v" sid="MRK 4:33" />Tǝ sakǝt shuwunchǝ ka'ǝn mbutǝ Yǝso shunda Fara, kǝ sǝrǝt sǝndengnanda. <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />Mbwa'autǝ shunda kanda nga tǝ sakǝtkǝnwowa, paɗ mamǝlan ichitkǝn, la mbwa'angna kimshechi'en chikami.<verse eid="MRK 4:34" /></para>
  <para style="s">Yǝso Ɓokaɗa Kapat Rǝnnaahi</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />Farǝniyu sǝk farǝhufta, ndangna kimshechi'enwa: "Chamǝn hawurkǝn kǝ mi chicheng le taatǝyu." <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />Malkǝndǝ ngomnofchikǝn ɗiffi'in, pǝɗakndǝ tǝnda hur kommbawal ichitkǝn, paɗ kurǝkǝ tahchikǝn kanda. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />Ndǝkǝn thlatǝ husomba tǝrǝnna ka'ǝn, nak rǝnnikǝna hǝhrandǝ kommbawal tǝkǝn, nak ama hasa hur kommbawal tǝkǝn nda nan nǝhata. <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />Yǝso paɗ mǝla hur kommbawal tǝkǝn a ɗar ɓǝt sokta mǝla saɓweni, nahnang kimshechi'en ndangndǝwa: "Malɗǝm, nǝma tǝktǝhi, kǝmmuwowa?" <verse eid="MRK 4:38" /><verse number="39" style="v" sid="MRK 4:39" />Nahǝnkǝn, ɓokangna rǝnnikǝnhi, ndangna rah amkǝnwa: "Thlarruhi! kǝ ngasnǝ kǝmma!" Ndǝkǝn thlartǝ rǝnnikǝnhi shǝyyet. <verse eid="MRK 4:39" /><verse number="40" style="v" sid="MRK 4:40" />Ndangna kimshchi'enwa: "Kǝthlǝm mǝ lechituni kakǝchiuyu? Paa kǝnakǝnya ngafǝrkit engnunisǝwowa? <verse eid="MRK 4:40" /><verse number="41" style="v" sid="MRK 4:41" />Lechitndaɗǝ kaka'ǝn, ndangndandaniwa: "Witǝ nifǝmǝkicheya, rǝnna'a tǝ ama kanda fǝra mwanda?<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="ms">Kǝna Yǝso Nifaɗi, le Nak tǝ Hafat Ɓǝɓi Shemeɗa fa</para>
  <para style="ms">(Matt 8:28-44; Luk 8:26-39)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />Kǝ chandǝndǝ suhwaɗa kǝ hachahai Garasinawecha. <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />Kǝ tǝrtǝ Yǝso haya hur kommbawal, thlaakǝ nifa le nak tǝ ɓǝɓi shemeɗa, mbǝt shok tǝ'en mbǝt thlohmurcha ɓakna mbǝɗa Yǝso. <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />Nifǝkǝn kwatmurcha naka mbǝt shoktǝ'en, nifǝsi la mbǝllakkǝ kǝnnanduwa chika tǝ chalalochiwa. <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />Kǝthlǝm kurɓafichǝ kǝnnandǝ harchi'en tǝ sarǝchi'en tǝ chalalocha, nat tǝkichu ɗǝɗahaǝn chalalo tǝkkǝnnaɗa sarǝ'en. Nga nifǝsi tǝ alchitafa la mbǝlakkǝ kǝssandǝhiwa <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />Nda fiɗikta tǝ fara la nakna kwat murchǝ tǝ ɗar shohlacha kǝnna nata tit ka'ǝn, paɗ kǝnna ɓursa ndǝ fat'enaɗi tǝ ngwicha. <verse eid="MRK 5:5" /><verse number="6" style="v" sid="MRK 5:6" />Kǝ natǝn Yǝso langnga, paakǝnsi tǝ rahta ɗǝkna hǝmta mbanitǝkǝn. <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />Hwakǝn tǝ alchit tǝ kapat ɓurata ndakǝnwa: "Mǝ natu sǝtsa nji, Yǝso hweya Fara le nak mwanchin? A humuɗi tǝ Fara, mǝ fǝrinǝ pwanchiuwa. <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />Mbukǝn kichu kǝthlǝm nda Yǝso wa: "Chukisshafata nifiya sokǝn ɓǝɓi shemeɗa." <verse eid="MRK 5:8" /><verse number="9" style="v" sid="MRK 5:9" />Ndǝkǝn sahandǝ Yǝso wa: "Thlǝmmuwa kǝni?" A ngǝmmanwa: "Thlǝmnǝwa terchin, kǝthlǝm nakani oi." <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />A hwanaǝn Yǝso tǝ ndatwa: "Mǝ rǝkinǝ kanda mbǝnniyuwa." <verse eid="MRK 5:10" /><verse number="11" style="v" sid="MRK 5:11" />Kǝthlǝm mbǝnniyu kapat chaɓa katuchisi naka hǝrimtǝ nduk tǝ shohlata. <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />Ɓǝɓi shemechiyu hwanangnduwa: "Kǝ malaǝn kanda kǝ yimnda hur katuchiyu." <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />A ngǝmmang na kandǝsi. Thlaakǝ ɓǝɓi shemechiyu chekndakish, yimkǝnnda hur katuchiyu, katuchiyu shee ndǝ aru kumchit chap (2,000), a rah kǝnda ka hǝhhatta hur hawurta, tǝkkǝndǝhi nat ahur ama. <verse eid="MRK 5:13" /><verse number="14" style="v" sid="MRK 5:14" />Kǝ nat fa hǝrǝm katuchiyu kichu, rah kǝnda ka mbuta hǝmta, tǝ han hǝmchikǝn chek nofchakish ka nat i sǝkka. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />Kǝ ɓatnda thlǝmmat Yǝso, nak ndǝ nifi nak soh tǝ ɓǝɓi shemecha fǝyu, ɗas tǝ njelecha fa mǝlla hur iɗi'en thlaakǝnnda lechik nda. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />Fichile sǝt fichi ǝnnat kǝnna hwaniteng na ndǝyu, ndǝkǝn chekandǝndǝ ɗwaachik kǝnna kanda, i kǝs kǝ lǝ ɓǝɓi shemeɗiyu tǝ katuchiyu. <verse eid="MRK 5:16" /><verse number="17" style="v" sid="MRK 5:17" />Thlaakǝ nofchikǝn hwanang ndǝ Yǝso kǝ mallǝn thlet hǝmteng nandǝ hi. <verse eid="MRK 5:17" /><verse number="18" style="v" sid="MRK 5:18" />Kǝ nat Yǝso yimta kommbawal, nifi soh nak tǝ ɓǝɓi shemeɗi fiiyu hwanaǝn Yǝso wa nan ɗǝtkakǝn. <verse eid="MRK 5:18" /><verse number="19" style="v" sid="MRK 5:19" />Nat tǝ kichu Yǝso ngǝmmawusuwa, ndaǝnwa ɗu huri kǝ mbǝɗa fahchuwa, kǝ mbwa'angna kanda witǝ pǝktat ichi sutǝ Lǝmwanda tǝ haɗi haɗandufa. <verse eid="MRK 5:19" /><verse number="20" style="v" sid="MRK 5:20" />Thlaakǝ nifiyu pǝɗakǝn ɗǝk na nata mbu i sandǝ ficha Dikafolis sakkǝtkǝn hǝmchǝ kum witǝ pǝktat i chi sandǝ Yǝso. Uf nofcha pǝɗang ǝnnatkǝn kandǝ fa.<verse eid="MRK 5:20" /></para>
  <para style="s">Kǝnna Yǝso Hweya Yayirussa ɗi<optbreak /> Tǝ Nuhnifa le Nak tǝ Hafat Thlǝrfwara fa</para>
  <para style="r">(<ref loc="MAT 9:18-26">Mt 9:18-26</ref>; <ref loc="LUK 8:40-56">Lk 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />Yim kǝ Yǝso hur kommbawal chaǝn kǝ mi chicheng le, ɓak nofchi oiya kǝtwurangndǝhi mǝllan paɗ mǝlla mi chicheng hawurkǝn. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />Yunǝsǝ ǝrta naka kapat nifa a mbǝt humta Yahudawechihi, thlǝmkǝn wa Yayirus. Kǝ natǝn Yǝso himkǝnhi mbanitǝkǝn, <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />nakna hwanandǝ ka'ǝn tǝ ndatwa: "Hwe'engna le nak nguɗeh, kǝ nuhhweya mǝlla miya murta, nja hwanuta tama kǝ ɗǝnna tǝkaharfa kǝthlǝm kǝ kǝnkaɗi." <verse eid="MRK 5:23" /><verse number="24" style="v" sid="MRK 5:24" />Pǝɗak Yǝso tǝndi, kuwurkǝ nofchi kandǝ oi nangnda njekkathlǝndi. <verse eid="MRK 5:24" /><verse number="25" style="v" sid="MRK 5:25" />Nuhnifǝssa mbǝnniyu hurak kum ngǝrǝnsǝ chap tǝ hafat thlǝrfwara fa. <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />A sheetǝ pwanchǝ oi a hara fafǝr hamɓǝɓecha, tuɓwaɗǝ i nak sǝ'en nat, chika tǝ kichu mbǝsutǝ sǝmmǝchitwa hafatkǝn nakǝn kǝmban kǝmban. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />Kǝ sǝktǝn kussheng Yǝso, ɗǝkǝn tǝ ɗifitǝkǝn tǝ hur terǝ nofchiyu tǝka'ǝn hara njela'enfa. <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />Nak na yarǝwa: "Matǝkaɗi hara njela'enfa ni kǝndaɗi" <verse eid="MRK 5:28" /><verse number="29" style="v" sid="MRK 5:29" />Chatkichuyu thlarkǝ thlǝrfwarkǝn hi, sǝkkǝnsa fat'enwa kinaɗi. <verse eid="MRK 5:29" /><verse number="30" style="v" sid="MRK 5:30" />Chatkichuyu sǝkkǝ Yǝso cheɗ alchǝta kishsha fat'en, tǝɓɓǝrkǝn hi hur terǝ nofcha ndakǝnwa: "Wun tǝkang hara njele'engnǝ fa?" <verse eid="MRK 5:30" /><verse number="31" style="v" sid="MRK 5:31" />Ngǝmang kimshechi'en wa: "Sa nat nofchǝ njekthlǝnjekthla, kanna ndatwa, wun tǝkukǝ harfa?" <verse eid="MRK 5:31" /><verse number="32" style="v" sid="MRK 5:32" />Kǝlak Yǝso hi kǝthlǝm kǝ nan ndu wun tǝkang harfa. <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />Nuhiyu kǝ sǝntǝn i sǝka fat'en lechikǝn, ɓakna mbǝsndi kopkǝnhi mbwaǝn nat kitchit i'sǝka. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />Ndaǝnwa: "Hwe'engna, fǝrkitchiɗeku kǝnuɗaɗi. Pǝɗu ngwalngwal, kinhafaɗekuɗi." <verse eid="MRK 5:34" /><verse number="35" style="v" sid="MRK 5:35" />Mǝlla ɗar shunda chat ɓak funa mbǝɗa Yayirus kapat nifa ndangnduwa: "Hwe'eku teppa miri! mǝ sǝk natu ɓahandǝ Malɗǝm paɗi?" <verse eid="MRK 5:35" /><verse number="36" style="v" sid="MRK 5:36" />Nattǝ kicchu Yǝso ɗufutǝ i'nda i nannda mbutuwa, ndangna kapat nifǝkǝnwa: "Mǝlechinuwa, so kǝn fǝru kit ndak." <verse eid="MRK 5:36" /><verse number="37" style="v" sid="MRK 5:37" />Malautǝ, chikka wun kǝ kurǝn ndǝwa tǝrkǝn Bitrus tǝ Yakubu tǝ Yohanna hwamman Yakubu. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />Kǝ saatǝnda hura'a Yayirus kapat nifa, nak Yǝso nofcha kanda tita funa hwata. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />Yimkǝnna hurikǝn, ndangnakandǝwa: "Kǝthlǝm mǝ natuni tita kǝ nuni nata hwata? Nuhhwaniya mǝruwa, tǝnakasaɓweni." <verse eid="MRK 5:39" /><verse number="40" style="v" sid="MRK 5:40" />Nangnda masanda masǝ njirfata. Chaǝn nofchi kisha hurikǝn nat, akǝn shin hwankǝn tǝ mankǝn, tǝ kimshechi'en fichile naka thlǝmmatkǝn, yimkǝnnda mbǝɗi nat nuhhwaniyu. <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />Kǝskǝn har'en ndaǝnwa: "Talita kumi." (sakǝtkǝnwa: "Hannuhhweya, ndakiwa thla'u"). <verse eid="MRK 5:41" /><verse number="42" style="v" sid="MRK 5:42" />Chat kichuyu thlaakǝ nuhhwaniyu nakna witahi. (hurat'en kumngǝrǝnsǝ chap). Nofchi naka mbǝnniyu pǝɗang ǝnatkǝnkandǝfa. <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />Kahang Yǝso thlǝmmachengnandǝ tǝ ndatwa mǝ sǝni nifǝ isǝkyawa, fǝramǝn ɗǝsǝmtǝ kǝ sǝmǝn.<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s">Cherfichǝ Yǝso a Nazarat</para>
  <para style="ms">(Matt 13:53-58, Lk 4:16-30)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />Malkǝ Yǝso mbǝnnihiyu ngǝraǝn inna hǝmtǝ'en, kimshechi'en paɗ kuwurkǝndǝndi. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />Kǝ saatǝ farǝ yipta, tǝrkaakǝn sakandaɗa mbǝt humta Yahudawechihi. Nofchǝ oi naka kathlǝmmata, paɗ pǝɗang ǝnnatkǝn kandǝfa nakndandatwa: "A'ai mbǝstǝ nifiya witǝ ichiya? witǝ sǝnmǝ fǝra ndǝ fichǝ kicheya? ɓatna nata sǝt ǝnat sheka i'nniya?<verse eid="MRK 6:2" /></para>
  <para style="m">
    <verse number="3" style="v" sid="MRK 6:3" />Leya nga mǝllan naka lǝ kukwat ichiyuwa, hweya Maryamu hwamman nda Yakubu, tǝ Yusufu, tǝ Yahuda, tǝ Siman? Hwamman chikǝn kǝ nishcha nga kandang ni thlǝmmat nǝm yawowa?" Cherkǝndǝndǝfa. <verse eid="MRK 6:3" /><verse number="4" style="v" sid="MRK 6:4" />Ndang Yǝso kandǝwa: "Tapǝna'a ɓahutǝ mwanduwa manga himtǝ'en tǝ hur hwammanchikǝn, tǝ hur hura'enwa." <verse eid="MRK 6:4" /><verse number="5" style="v" sid="MRK 6:5" />Yǝso mbǝla'u tǝ sǝt tor ǝnnat fǝr sheka i'nda mbǝnniyuwa, kǝnaǝnfunaɗi ɗimek hur fichile nak hahchin tǝ ɗǝffa hara kanda in. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />Pǝɗang ǝnatkǝnfa tǝ ɓah fǝr kitchǝɗengnanda. A wu'yaǝn han hǝmcha, nakna sakanda kandǝ har.<verse eid="MRK 6:6" /></para>
  <para style="s">Thlin Yǝso Kimshechi'en Kumngrǝnsǝ Chap</para>
  <para style="r">(<ref loc="MAT 10:5-15">Mt 10:5-15</ref>; <ref loc="LUK 9:1-16">Lk 9:1-16</ref>)</para>
  <para style="m">
    <verse number="7" style="v" sid="MRK 6:7" />Akǝn kimshechi'en kumngǝrǝnsǝ chap, thlinkǝn kanndǝ chap chap, a fǝraǝn alchita kanda i rǝk ɓǝɓi shemecha. <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />Ɓokang na kandǝwa makunna pǝɗata mǝtǝriɗuni ǝn inwa, chika ɗǝsǝmta, chika yokta, chika ɗǝngla, chika hanɗǝɓǝlta kǝ hur kwandangchengnuniwa, sǝssal ndak natuni tǝrta. <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />Tǝ paɗ kǝ puni pahamcha, mǝ hummaɗuni njelaa chapwa. <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />Ndangna kandǝ paɗwa: "Uf huri'i yimtunisi, kǝ sokkuni mbǝnniyu kǝ farinatuni thlata. <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />Uf mbǝɗi cher tǝ ndǝ kuni paɗ kawundǝ thlǝmmata kuniwa, manuni pǝɗata, kǝ tǝppanguni tǝnnayiɗa sarǝchengnuni kǝthlǝm kǝ sokka ǝnnat sinnda ɗar inndengnanda." <verse eid="MRK 6:11" /><verse number="12" style="v" sid="MRK 6:12" />Pǝɗangda nataɓasanda nofchisi tǝ ndatwa kǝtǝrndǝhi kǝ malangndǝ ɓǝɓichitfechengnanda. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />A chang ndǝ ɓǝɓi shemechakish oi, pa'angndǝ fiɗɗetafichile nak hahchin oi kǝnkǝnndaɗi.<verse eid="MRK 6:13" /></para>
  <para style="s">Mǝrta Yohanna lǝsǝt Baptisma</para>
  <para style="r">(<ref loc="MAT 14:1-12">Mt 14:1-12</ref>; <ref loc="LUK 9:7-9">Lk 9:7-9</ref>)</para>
  <para style="m">
    <verse number="14" style="v" sid="MRK 6:14" />Hiridus kutura sǝkkǝn kusheng shuwun Yǝso kǝthlǝm fen thlǝmkǝnhi chika tǝteni funa ndatwa: "Yohanna lǝsǝt Baptisma thla'a ndǝ ficha hur mǝmatcha, ndǝkǝn sǝk natǝn tǝ alchit sǝt ǝnnat fǝr sheka i'nda." <verse eid="MRK 6:14" /><verse number="15" style="v" sid="MRK 6:15" />Ndakfunuwa: "Iliya tapǝna'a" funǝ paɗ ndakndǝwa, "Nda ǝrta hur tapǝnechi sohyu." <verse eid="MRK 6:15" /><verse number="16" style="v" sid="MRK 6:16" />Kǝ sǝktǝ Hiridus shuwunkǝn, ndakǝnwa, Yohanna nǝyu, le thlendi i'ndǝ ennaɗi thlaaka hur mǝmatcha." <verse eid="MRK 6:16" /><verse number="17" style="v" sid="MRK 6:17" />Kǝthlǝm Hiridus tǝ i'ndǝ'en mbukǝ tǝ ndatwa kǝ kǝssang fichǝ Yohanna, kǝ kǝnnang ficha kǝ ɗǝndǝ tǝnda pursuna. Sǝk Hiridus kichu kǝthlǝm Hirudiya, Nuh Filibus hwanmankǝn kahandǝn. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />Kǝthlǝm Yohanna lǝnakna mbwa'anda Hiridus wa, "Ngǝmawu kus kǝ kahangnǝ nuh hwanyatuwa".<verse eid="MRK 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19" />Awi Hirudiya mǝlla kǝs kommbǝl Yohanna a hur hanɗǝkiketǝ'en, a yahkǝn kǝ ɓǝllaǝn. Nat tǝkichu mbǝsutǝ mbandǝwa, <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />Kǝthlǝm Hiridus lechaɗa Yohanna, A shinwa mǝllan ka nifǝnakǝn, a shin tǝ ndatwa nakǝn chiɗchiɗ, lǝ ɗwachit paɗ, ndǝkǝn sǝk Hiridus kǝstǝn Yohanna har ndiichin, lǝ shekɗang i'nda ma mǝlla sǝk Yohanna mǝlla shundǝ tǝndi, nat tǝkichu lǝ nakna mbǝnandǝfa ma mǝlla sǝk shundǝ'en. <verse eid="MRK 6:20" /><verse number="21" style="v" sid="MRK 6:21" />A mweshitkǝn ɓak Hirudiya mbǝs mbanda. A farǝ mbǝnfat thlahmbǝt ngǝtta Hiridus, akǝn pǝktat nofcha, funa ngomnati, funa hurfathlǝrhwata, tǝ pǝktat nofchi Galili. <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />Kǝ yimtǝ hweya Hirudiyasi kǝ nuhhweya, rǝmkǝn mbǝnang na Hiridus fa tǝ tahǝt romchi naksi. Ndang kutura nuhhwaniyuwa: "Hwanitǝn i yahtu, ni furuta." <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />Akǝn ichimi tǝ ndatwa, hwanitin i yahtu nifuruta chika mbuth kuturichiɗengna. <verse eid="MRK 6:23" /><verse number="24" style="v" sid="MRK 6:24" />Thlaakǝ nuhhwaniyu cheknakish kambǝs mankǝn mbwa'ǝn tǝ ndatwa: "Mǝnati hwanada" Ngǝmmang mankǝnwa i'nda Yohanna lǝ sǝt Baptisma. <verse eid="MRK 6:24" /><verse number="25" style="v" sid="MRK 6:25" />Chatkichuyu ngǝraǝn inna mbǝnda kutura tǝ wesha hwanan tǝ ndatwa, yahkǝsi nakǝn nakǝnya kǝ fǝrikǝnnǝ i'nda Yohanna lǝ sǝt Baptisma a hur tǝpɓi. <verse eid="MRK 6:25" /><verse number="26" style="v" sid="MRK 6:26" />Sǝɓkǝ hanndǝkiketa kuturaɗǝ ka'ǝn. Paɗ ngu mbǝlla cherǝfuwa kǝthlǝm teppa eɗtǝ ichimi mbanitǝ nofcha, kǝthlǝm ngu mbǝlla talandǝ i mbutǝnwa. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />Chatkichuyu thlǝnkǝn yuna hur fapundǝ har ndaǝnwa, kǝ ɗa ɓattǝ i'nda Yohanna, pǝɗak nifiyu kǝ pursunatǝkǝn ɗǝkna thlandǝ i'nda Yohanna, <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />ɓakǝn tǝ inkǝnna hur tǝpɓi fǝrangna nuhhwaniyu, thlǝk nuhhwaniyu fǝrangna mankǝn. <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />Kǝ sǝktǝ kimshecha Yohanna kichuyu, pǝɗaknda tǝr fatkǝn ɗǝknda thlohanda.<verse eid="MRK 6:29" /></para>
  <para style="ms">Yǝso Sǝmmaɗǝ'ǝn Nofchǝ Aru Kumchitkum Ɗurman (5,000)</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mt 14:13-21</ref>; <ref loc="LUK 9:10-17">Lk 9:10-17</ref>; <ref loc="JHN 6:1-14">Yh 6:1-14</ref>)</para>
  <para style="m">
    <verse number="30" style="v" sid="MRK 6:30" />Kǝ ɓat fathlǝncha Yǝso ɗi ngomkǝndǝhi mbwa'ang ndǝ i sǝtndǝ uf, tǝ i sakandǝndaɗi. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />Nak nofchǝ oiya ɓata funa pǝɗata, Yǝso tǝ fathlǝnchi'en mbǝsundǝ har sǝmɗǝsǝmtuwa. Ndǝkǝn ndandǝnna kanndǝwa tama katmbǝt har nguɗuk, kǝthlǝm kǝ yipuni. <verse eid="MRK 6:31" /><verse number="32" style="v" sid="MRK 6:32" />Pǝɗaknda hur kommbawal kǝ mbǝt nguɗuk ichitnanda. <verse eid="MRK 6:32" /><verse number="33" style="v" sid="MRK 6:33" />Awi neɗ nofchǝ kandǝ oi kanda pǝɗata, paɗ shinndǝ kanda, rahkǝnda tǝ sarǝcha a hur thlet hǝmchikǝn laknda mbǝɗi natnda ɗǝta. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />Cheta Yǝso kissha hur kommbawaltǝkǝn, nakǝn nofchǝ oi haɗangndǝfa, kǝthlǝm nakndǝ nda shohrecha le nguchit lǝ hǝrǝmtǝsi. A tǝrkaakǝn saka ichakandǝhar oi. <verse eid="MRK 6:34" /><verse number="35" style="v" sid="MRK 6:35" />Nak mbǝta hulta ɓak kimshechi'ena mbǝsndi, ndangndǝwa: "Mbǝɗi natǝmya nguɗuk nifǝsǝwa, tǝpaɗ mbǝta hulta. <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />Ndandǝna nofchiyawa kǝpǝɗanda kǝ kahǝmcha tǝthlet hǝmchi ndukndukya kǝɗǝnda hi i nanndasǝmta." <verse eid="MRK 6:36" /><verse number="37" style="v" sid="MRK 6:37" />Paɗ ngǝmmang Yǝso tǝ ndatwa: "Kunang fǝramǝn ɗǝsǝmta kanndǝ kǝ sǝmnda." Ndǝkǝn ndandǝndǝwa, kǝ ɗani hi njohma i dinari aruchap kǝ fǝrangani kandǝ kǝ chiindǝwa? <verse eid="MRK 6:37" /><verse number="38" style="v" sid="MRK 6:38" />Ndangna kandǝwa, njohmǝ kurmi naksengnuni? ɗama kǝllamǝn ɗǝknda kǝllanda ndangndǝwa, njohmǝ ɗurman tǝ tinchǝ chap. <verse eid="MRK 6:38" /><verse number="39" style="v" sid="MRK 6:39" />Ndang Yǝso kimshechi'enwa kǝ ndangnda nofchiyuwa kǝ sokndǝhi tǝnglǝng-tǝnglǝng kǝ ɗar nduhwelecha. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />A sokkǝndǝhi tǝnglǝng-tǝnglǝng, funǝ kumchit kum, funǝ paɗ kumchit ɗurman. <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />Tǝrkǝn njohǝmchi ɗurmanyu tǝ tinchi chap yu, kǝlangna afshi saǝn usoko Fara, saka'ǝnhi fǝrang na kimsechi'en, kǝ sakangnda nofcha. Sǝkǝn kichu tǝ tinchikǝn paɗ. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />Uf nda sǝmkǝnnda ngalkǝnnda. <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />Ngomang kimshechi'en fishirchikǝn nihǝɗ inaftǝ kumngǝrǝnsǝ chap, <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />Terǝ nofchi sǝmkǝ ɗǝsǝmkǝn, hishchǝ, sheendǝ aru kumchit kum ɗurman (5,000).<verse eid="MRK 6:44" /></para>
  <para style="s">Wii Yǝso Ɗar Ama</para>
  <para style="r">(<ref loc="MAT 14:22-33">Mt 14:22-33</ref>; <ref loc="JHN 6:16-21">Yh 6:16-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />Chatkichuyu ndang Yǝso kimsechi'en wa, kǝ yimnda hur kommbawal, kǝ landǝ cheta kǝ Betsaida, mǝlan paɗ kalkǝn terǝ nofchihiyu. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />Ɗiffitǝ kalǝ nofchihi tǝrkǝna ɗar shohlata kǝthlǝm kǝ hwanǝn. <verse eid="MRK 6:46" /><verse number="47" style="v" sid="MRK 6:47" />Sǝk farǝ hufta, kommbawal tiyu a hur ɗiffiti hawurta, Yǝso paɗ mǝlla hachahai i'chitkǝn. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />Kǝ natin kimshechi'ena ɓahtǝhi tǝ koharǝkǝn, kǝthlǝm rǝnna'a ɓahandǝ kanda, keeke tǝ kukwara ɗekta katǝtɓǝta, mǝlla ɓata mbǝskandǝ tǝ wita ɗar hawurkǝn. Yarkǝnwa na lata mban. <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />Kǝ natndǝndi mǝlla wita ɗar ama, naknda muh hanhara naǝn kandǝhiwa ɗǝhanifa. <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />Kǝthlǝm ufnda neɗndǝndi, lechiknda, chatkichuyu "Shunaǝn kandǝ tǝ ndatwa ǝnsuwa, njeta, mǝ lechiɗuniwa." <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />Mbǝnniyu yimkǝna kommbawal tǝ kanda, chatkichuyu thlarkǝ rǝnnikǝnhi. Shekɗang i'ndǝkandǝ ka'ǝn. <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />Kǝthlǝm sunundǝ sakǝt sǝma'ǝn nofchi aru kumchit ɗurmanyu tǝ njohmǝwa, kǝthlǝm kwaakwaachit hanɗǝkikechengnanda.<verse eid="MRK 6:52" /></para>
  <para style="ms">Kǝnna Yǝso Fichileɗǝ Nak Haachin a Janisarat</para>
  <para style="r">(<ref loc="MAT 14:34-36">Mt 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />Kǝ chandǝndǝ hawurkǝn kǝ kishitǝle, tǝrkǝnda haya a thlet hǝmǝt Jenisarat, kǝnangndǝ kommbawal tǝkǝnhi kǝmi chichengkǝn. <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />Kǝchet nda kisha hur kommbawal mbǝssang nofchuwa mǝllan. <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />Rahkǝnda hur hǝmchikǝn, naknda ɓat tǝ fichile nak haachin a ɗar mbǝt hunechengnanda kǝ mbǝɗi sǝktǝndǝwa mǝlla mbǝnniyu. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />Nat mbǝɗi yimtǝn, thlet hwan hǝmchǝ tǝ hǝmcha, la naknda ɗǝt tǝ haachǝ kǝmbǝɗ'en paɗ tǝmi lumocha, a lanaknda hwananda kǝthlǝm kǝ tǝkangndǝ hara chika mi njela'enfa, nat le tǝkang harfa kǝnkǝnaɗi.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="ms">Sakandaɗaɗi kǝ Ɗar Chiɗchiɗchita</para>
  <para style="r">(<ref loc="MAT 15:1-9">Mt 15:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />Farisawecha tǝ malɗǝmcha fichile la sakang kussa ɗi ɓaka Urshelima, ngomkǝnda thlǝmat Yǝso. <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />A mbǝssangndǝ tǝ ndatwa kimshechi'en kanda sǝmɗǝsǝmtǝ tǝ tǝkǝmharcha sapawundǝwa. <verse eid="MRK 7:2" /><verse number="3" style="v" sid="MRK 7:3" />(Kǝthlǝm Farisawecha tǝ tahǝt Yahudawecha sǝmundǝ ɗǝsǝmtǝ kichu sapundǝ harwa, kǝthlǝm tor murta pǝktechengnanda nakǝn kichu. <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />Ma ɓennda ɗa lumo, manga tǝ fanndǝ nda i mbutǝ tor murtengnandǝwa ngunda sǝmɗǝsǝmtǝwa. Tor murtengnandǝsi paɗ lela kuwur tǝnda, nda sap tǝpsat 'amcha, tǝ ɓicha, tǝ kuppecha tǝ kǝtǝn sǝm'ǝna.) <verse eid="MRK 7:4" /><verse number="5" style="v" sid="MRK 7:5" />Kǝthlǝm ndǝkǝn sahang Farisawecha tǝ pǝktat malɗǝmcha fasakandǝ shuwun kussa Musaɗi: "Kǝthlǝm mi kimsecheku yahundǝ kuwur tor murcha pǝktechengnaniwa, mashiɗ kǝnnanda sǝmɗǝsǝmta tǝ tǝkǝmharcha?" <verse eid="MRK 7:5" /><verse number="6" style="v" sid="MRK 7:6" />A ngǝmang Yǝso tǝ ndatwa: "Kohat nofcha keekesi fǝrtǝ Ishaya sakǝtkǝn kǝ ɗarnuni, nda i yarandǝ ficha.</para>
  <para style="q1" vid="MRK 7:6">Nofchiya a mi ɗeng nannda mwanita,</para>
  <para style="q2" vid="MRK 7:6">paɗ hanɗǝkikechengnanda nakǝn langnga tǝ nji.<verse eid="MRK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7" />Poffǝn lǝnannda mwanandǝ thlǝmna,</para>
  <para style="q2" vid="MRK 7:7">kussi ti la natnda sakandaɗi, i nofchǝ ɗeng,</para>
  <para style="q2" vid="MRK 7:7">ɗar ndatwa shunda Fara.<verse eid="MRK 7:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MRK 7:8" />Lamallanguni i ndat Faruwa kǝ suni, nakuni kuwur tor murta nofcha." <verse eid="MRK 7:8" /><verse number="9" style="v" sid="MRK 7:9" />Ndangnakandǝwa: "Awi nuni mbǝllamalandǝ kussi Fara kǝthlǝm kǝ kuruni tor murchengnuni! <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />Kǝthlǝm ndak Musa wa, 'fǝran mwanda suka tǝ yatu paɗ le erkǝ shinkǝn tǝ mankǝn keekesi kǝ ɓǝllang ficha.' <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />Paɗ landakuniwa: ''Nat i nat shinchinuni tǝ manchinuni ɓǝsta mbǝɗa nifǝ soh sokkǝn nda korban" (sakǝtkǝnwa fǝrraɗi Fara). <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />kǝthlǝm ndǝkǝn mwawuni mallandǝ kǝ kǝssaǝn tora shinkǝnsi tǝ mankǝn wa. <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />Tǝkichu la natuni, cherǝ pathla Fara, tǝ pathlǝ kuwur tormurchengnuni, paɗ la nakuni ɗahhanda witǝ ichiniyu in.<verse eid="MRK 7:13" /></para>
  <para style="ms">Ichi la Tǝkmang Nifǝhi</para>
  <para style="r">(<ref loc="MAT 15:10-20">Mt 15:10-20</ref>)</para>
  <para style="m">
    <verse number="14" style="v" sid="MRK 7:14" />Ngǝrkǝ Yǝso at nofcha mbǝɗ'en, ndangnakandǝwa kami thlǝmmat uffuni, paɗ kǝsununisi ndiichin. <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />Nga i lasǝmtǝ nifa hur na tǝkmandǝhiwa, i la cheka hur handǝkiketǝ la tǝkmang nifǝhi. <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />[Uf le nat thlǝmmatsǝktǝ'ensi kǝ sǝkkǝn.] <verse eid="MRK 7:16" /><verse number="17" style="v" sid="MRK 7:17" />Kǝ saktǝnhi tǝ nofchi oiyu yimkǝnna huri, sahang kimsechi'en sakǝt i'sakandǝnaɗiyu. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />Ndangnakandǝwa: "Awi kunang paɗ sǝnwuni sakǝtkǝn tǝ ndatwa i sǝmtǝ nifa hur, ɓahwa tǝkmandǝhiwa. <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />Kǝthlǝm nga la yimkǝnna hur hanɗǝkiketǝwa la yimkǝnna hur kǝhapangkaɗi. A hurra shuniya cheɗkǝ Yǝso wa i sǝka ɗǝsǝmta tǝkǝmtǝsa fi'enwa. <verse eid="MRK 7:19" /><verse number="20" style="v" sid="MRK 7:20" />Ngǝr kǝnna ndatwa i lachekakissha hur hanɗǝkiketa nifa ndǝkǝn na tǝkmanghi. <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />Kǝthlǝm a hur hanɗǝkiketa nifa la chetɓǝɓi'ichakish, ndanda ɓǝɓiyara, fǝllawichita, herketa, tǝ ɓǝlfata, <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />Katnishcha nofcha, sǝɓfata, lekta, sǝrǝhta, mwa'inda, ɓokta, tǝ ɓomchita. <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />Uf ɓǝɓi'ichiniyu lǝ chekna hanɗǝkiketa, ndǝkǝn la tǝkmang nifǝhi.<verse eid="MRK 7:23" /></para>
  <para style="s">Nuhnifǝ lǝ Helinawata Fǝrkǝ Kit kǝ Mbǝɗa Yǝso</para>
  <para style="r">(<ref loc="MAT 15:21-28">Mt 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />Mbǝnniyu malkǝ Yǝso Galilihi pǝɗakna thlet hǝmmǝt Taya tǝ Sidon. yimkǝnna hura'a yuna, a yahu kǝ sǝnfichiwa. Nat tǝ kichu ɓuɓwe'iuwa. <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />Chatkichuyu nuhnifǝsi, tǝ hwe'ensi kǝ nuhhweya naktǝ ɓǝbi shemeɗafa, kǝ sǝktǝn kusheng Yǝso, ɓakna hǝmtǝhi mbanitǝkǝn. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />Nuhhiyu witǝ Helinawechǝ nakǝn, a thlet hǝmǝt Finikiya ngǝttǝfichǝndi, a hachahai Suriya. A hwanaǝn Yǝso wa kǝ kǝtaǝn ɓǝɓi luwurchaɗa fa hwe'en. <verse eid="MRK 7:26" /><verse number="27" style="v" sid="MRK 7:27" />Ndang Yǝso wa: "Suku kǝ ngal hwechǝ kwaɗǝn, kǝthlǝm kamusi kǝ tǝr fichǝ ɗǝsǝmta hwecha kǝ fǝrang ficha hǝɗechuwa." <verse eid="MRK 7:27" /><verse number="28" style="v" sid="MRK 7:28" />A ngǝmang nuhiyu tǝ ndatwa: "Ə, kichuyu malɗǝm, chikatǝ kichu hǝɗecha la sǝmkǝnndǝ fishirchikǝnti ka tebǝr lela hǝhatka haya miya hwecha. <verse eid="MRK 7:28" /><verse number="29" style="v" sid="MRK 7:29" />Ndǝkǝn ndandǝ Yǝso wa: "Kǝthlǝm shundeku, ɗuɗaɗi, ɓǝɓilura shekhi tǝ 'hwe'eku." <verse eid="MRK 7:29" /><verse number="30" style="v" sid="MRK 7:30" />Ngǝrang nuhnifǝkǝn inna ɗi ɗǝkna mbǝssandǝ hwe'en ɗuk a mbǝthunata ɓǝɓi luriyu tepa keltǝndǝhi.<verse eid="MRK 7:30" /></para>
  <para style="s">Kǝnna Yǝso Ɓommaɗi</para>
  <para style="m">
    <verse number="31" style="v" sid="MRK 7:31" />Malkǝ Yǝso thlet hǝmǝt Tayahi, kuwurkǝn tǝ Sidon ɗǝkna hawur Galili. A mbanda kwirtǝ thlet Hǝmchǝ shee Kum. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />A mbǝnniyu ɓang ndǝ ɓomma, le lakweekǝ shunda, a hwanangnda kǝthlǝm kǝ ɗǝfaǝn hara in. <verse eid="MRK 7:32" /><verse number="33" style="v" sid="MRK 7:33" />Kaɓkǝ Yǝso ɓommiyu kǝkǝllar, mbahkǝnndaɗa thlǝmat nofchiyu kǝ mbǝɗi nguchit nifǝsi. Pakǝn hanharchi'enna hur thlǝmmecha nifiyu, chahkǝn yahta hanhar'en, tǝka'ǝn hara hanshunda nifǝkǝn fa. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />Kǝlak na afshi kahkǝn yiptǝ langnga, ndakǝnwa: "Iffata!" sakǝtkǝnwa: "Innuhi!" <verse eid="MRK 7:34" /><verse number="35" style="v" sid="MRK 7:35" />Kǝ mbutǝn kichu inkǝ thlǝmmecha nifǝkǝnhi, i kǝnnang hanshundǝ'en paɗ kwaskǝnhi, tǝr kaakǝn shundǝ ndiichin. <verse eid="MRK 7:35" /><verse number="36" style="v" sid="MRK 7:36" />Ɓokang Yǝso kandǝwa mǝ mbwa'anda chika wunwa, nattǝ ɓoki ɓokandǝnnakanda nak mbukǝnna chekta. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />Shekɗang i'ndǝ kandǝ ka'ǝn, ndakndǝwa shiitǝ ichindiichin oi! Sokkǝn ɓomchasǝkmbǝta, tippengcha kanda shunda".<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">Yǝso Sǝmandǝ ǝn Nifǝ Aru Kumchit Fwaɗɗa (4,000)</para>
  <para style="r">(<ref loc="MAT 15:32-39">Mt 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />A hur hanmunchiniyu, nofchǝ oi paɗ ɓaka mbǝs Yǝso. A nakǝn ǝnsǝ nannda sǝmtǝwa, ak Yǝso kimshechi'en ndangna kandǝwa: <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />"Nofchiya haɗitǝfa, kǝthlǝm munkǝndǝ mǝkkan nakǝnya kanda thlǝmatna mwa'u ndǝsǝmtengnandǝsuwa, <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />Ma ɗeɗi nakǝnyawa kǝ pǝɗandaɗaɗi tǝ mita, na funa hǝhattǝhi mbacha. Kǝthlǝm funǝ ɓakndǝ langnga." <verse eid="MRK 8:3" /><verse number="4" style="v" sid="MRK 8:4" />Ndǝkǝn ngǝmmandǝ kimshechi'enwa: "Nakma mbǝs njohma aiya hurhweli'iya na sǝmma ǝn nofchi natya?" <verse eid="MRK 8:4" /><verse number="5" style="v" sid="MRK 8:5" />Sahang Yǝso kimshechiken'enwa: "njohmǝ kurmǝ naksengnuni?" Ngǝmangndǝwa: "Muɗ." <verse eid="MRK 8:5" /><verse number="6" style="v" sid="MRK 8:6" />Ndangna nofchiyuwa kǝ sokndǝhi kǝ hachahaya. Ndǝkǝn hartǝn njohhomchi muɗ yu, saǝn usoko Fara, chichaǝnhi, fǝrangna kimshechi'en kǝ sakangnda nofchiyu, sǝk kimshechi'en kichuyu. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />Tǝ paɗ tinchisǝ ɗimek. Yǝso saǝn usoko Fara, ndangna kimshechi'enwa leya paɗ sakamna kanda. <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />Sǝmkǝnda ngalkǝndǝ nda i yahtǝnda. Ɗiffitǝkǝn ngomang kimshechi'en fishirchikǝn inaftǝ muɗ. <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />A farǝkǝn shee nifǝ aru kumchit fwaɗɗa (4,000). Paɗ ndang Yǝso kandǝwa pǝɗama. <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />Chatkichuyu thlaakǝ Yǝso tǝ kimshechi'en yimkǝnda hur kommbawal pǝɗaknda thlet hǝmǝt Dalmanuta.<verse eid="MRK 8:10" /></para>
  <para style="s">Sheh Farisawechǝ Sakǝtkǝn</para>
  <para style="r">(<ref loc="MAT 12:38-42">Mt 12:38-42</ref>; <ref loc="MAT 16:1-4">16:1-4</ref>; <ref loc="LUK 12:54-56">Lk 12:54-56</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />Ɓak Farisawecha tǝrkaakǝndǝ sahami Yǝso. Kǝthlǝm yahndǝssa kǝkaɗanda, sahangndǝ kǝ cheɗaǝn sakǝtkǝna kanda a hur afshi. <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />Kǝtkǝn yiptǝ langnga hur shemeɗ'en ndakǝnwa: "Kǝthlǝm mǝ nat nofchi kishi'i nakǝnya katsakǝtkǝn? Kitchitkǝn ni mbwa'anda kuni sakǝtkǝnsi nat ficha fǝranda kishi'i nakǝnyawa." <verse eid="MRK 8:12" /><verse number="13" style="v" sid="MRK 8:13" />Thlaakǝn malkǝnkandǝhi, yimkǝnda hur kommbawal pǝɗakǝn kǝ chicheng le.<verse eid="MRK 8:13" /></para>
  <para style="s">Mehnda Farisiyawecha tǝ i Hiridus</para>
  <para style="r">(<ref loc="MAT 16:5-12">Mt 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />A nakǝn mbutandǝ kimshecha Yǝso kǝ tǝrndi njohmǝ in, njohmǝ ǝrtǝ ndak naka harengnanda hur kommbawal tǝkǝn. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />Ndang Yǝso kimshechǝkǝn'enwa: "Ndǝfam ǝndisǝ ndiichin kǝ ndǝsǝcha Farisawecha tǝ i Hiridus nda mehnda." <verse eid="MRK 8:15" /><verse number="16" style="v" sid="MRK 8:16" />Tǝrkaakǝndǝ shundǝ tǝndani tǝ ndatwa: "Mbukǝn i'ya kǝthlǝm njohmǝsa harrengnǝmwa." <verse eid="MRK 8:16" /><verse number="17" style="v" sid="MRK 8:17" />Shin Yǝso i nat kimshechǝkǝna shunda ɗarkǝn, ndǝkǝn sahandǝn mǝ kandǝwa: "Kǝthlǝm mǝ natu ni ndandandaniwa njohmǝ nguchiksa harengnuni?" Awi paaya a sǝnwuniwowa? Tǝpaɗɗaa paaya a mbǝsawuniwowa? Paaya mwaakǝ hanndǝkikechengnuni kwaakwaawa? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />Hwanichengnunisi, nuwuni mbǝtwowa? Thlǝmmechengnunisi, sǝkwuni mbǝtwowa? Kuɗukwunniharwowa? <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />Fari chichandi njohmihi ɗurman chiitǝ nofchǝ aru kumchit ɗurman yu, inaftǝ kurmi ngomanduni fishirchikǝn tiiyu?" Ngǝmang kimshechǝkǝn wa: "I'naftǝ kumngǝrǝnsǝ chap." <verse eid="MRK 8:19" /><verse number="20" style="v" sid="MRK 8:20" />Ngǝrkǝn ndanda kandǝwa njohmi muɗ chichandǝhi chiiti nofchǝ aru kumchit fwaɗɗa yu i'naftǝ kurmi ngomanduni fishirchikǝn?" Ngǝmangndǝwa "i'naftǝ muɗ." <verse eid="MRK 8:20" /><verse number="21" style="v" sid="MRK 8:21" />Paɗ sahaǝnmi kandǝwa: "Kananat paaya a mbǝsawuniwowa?"<verse eid="MRK 8:21" /></para>
  <para style="s">Yǝso Kǝnnandǝ Nifaɗi kǝ Kukomta a Betsaida</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />Yǝso tǝ kimshechi'en ɓaknda Betsaida, ɓak nofchǝ tǝ nifǝ kǝ kukomta, hwanang nofchiyu kǝ tǝka'ǝn harfa. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />Kǝskǝn haara kukomǝyu, chekǝntǝnda kish a hur thlet hǝmǝtkǝn. Chahkǝ Yǝso yahta hwanicha kukomǝyu sǝkkǝn harchi'enna hwanicha kukomǝyu, sahang Yǝso wa: "Sa nat mbǝt wa?" <verse eid="MRK 8:23" /><verse number="24" style="v" sid="MRK 8:24" />Kǝllakna afshi a ndakǝnwa: "Nja nat nofcha nakndǝ nda afchǝ naka wiita." <verse eid="MRK 8:24" /><verse number="25" style="v" sid="MRK 8:25" />Ngǝrkǝ Yǝso sǝt harchi'enna hwanicha kukomǝyu, nakǝnya kǝllak nifiyu ndiichin, ǝnkǝ hwanichi'en hi nakna nat chikamǝhi chiɗchiɗ. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />Ndǝkǝn ndandǝ Yǝso wa: "Ɗuɗaɗi kǝ huri, mǝ ngǝrina thlet hǝmǝɗiniyuwa."<verse eid="MRK 8:26" /></para>
  <para style="s">Bitrus Mbwiti Kitchit kǝ Ɗar Yǝso Mǝllan na Kǝrǝsti</para>
  <para style="r">(<ref loc="MAT 16:13-20">Mt 16:13-20</ref>; <ref loc="LUK 9:18-21">Lk 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />Thlaakǝ Yǝso tǝ kimshechi'en kǝ thlet hǝmcha hachahai Kaisariya Filibi. Nak nda wita ndǝkǝn sahandǝn kimshechi'enwa: "La tǝrkǝ nofchuwa wunnaki?" <verse eid="MRK 8:27" /><verse number="28" style="v" sid="MRK 8:28" />Ngǝmang funǝ la ndakndǝwa: "Sokǝn Yohanna lǝ sǝt Baptisma, funǝ la ndakndǝwa Iliya tapǝna'a, funǝ paɗ la nɗakndǝwa naku ǝrta hur tapǝnecha." <verse eid="MRK 8:28" /><verse number="29" style="v" sid="MRK 8:29" />Ndǝkǝn sahandǝ Yǝso kimshechi'enwa kunang kǝni: "La ndakuniwa wun naki?" Bitrus Ngǝmanwa sokǝn naka Kǝrǝsti." <verse eid="MRK 8:29" /><verse number="30" style="v" sid="MRK 8:30" />Ɓokang Yǝso kandǝ ndatwa: "Mǝ mbwa'anda yunǝ ndu wun nakǝnwa."<verse eid="MRK 8:30" /></para>
  <para style="s">Mbwi Yǝso Witǝ Mǝri Natna Mǝrta tǝ Thlatǝ'enna Kwata</para>
  <para style="r">(<ref loc="MAT 16:21-28">Mt 16:21-28</ref>; <ref loc="LUK 9:22-27">Lk 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />Tǝrkaakǝ Yǝso sakandakandǝhar tǝ ndatwa: "Hweya nifǝ nan ɓahtǝhi tǝ ichi somsomǝn, paɗ kǝ cher pǝktechǝndi tǝ pǝktat pǝristochicha, tǝfa sakandǝ ɗalwer tǝ kussa Musa ɗi. Nanda ɓǝllanda, ɗiffitǝ mundǝ mǝkkan nan thlata. <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />Mbwa'ǝn ichiniyu kimshechi'en a ɗwachitkǝn. Ɓak Bitrussa kahndi kǝ kǝlar ɓoka'ǝn kǝ ɗar mbuwitǝ'ichiniyu. <verse eid="MRK 8:32" /><verse number="33" style="v" sid="MRK 8:33" />Tǝɓǝrkǝ Yǝso hi nakna kǝllandǝ kimshechi'en, ɓokangna Bitrus hi tǝ ndatwa: ''Mbahhu thlǝmatna Sheɗan, yareku nga i Farǝwa i nifa." <verse eid="MRK 8:33" /><verse number="34" style="v" sid="MRK 8:34" />Akǝn nofchǝ tǝ kimshechi'en, ndangna kandǝwa: "Nifi yahkǝssa kuwurnji kǝ cherǝn i'ndǝ'en, kǝ tǝrǝn palitǝ'en kǝ kurǝn nji." <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />Kǝthlǝm chikawun yahkǝssa hǝrkandǝ shisshingtǝ'en nan shekɗanda, paɗ chǝkawun shekɗang shisshingtǝ'en kǝthlǝm njang tǝ kushengshundǝ mbǝnchin, nan hǝrkandi shisshingtǝ'en. <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />Mǝ naka mbǝs ǝnhara nifa ma mbǝssandǝ kisshita kǝ ɓahhǝn shisshingta. <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />Mǝnat nifa fǝrta kǝthlǝm shisshingtǝ'en? <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />Chǝkawun la harandǝfat kǝthlǝm njang tǝ shundengna a kishi ɓahkitchiɗiya tǝ ɓǝɓichit faɗi nakǝnya, hweya nifa nan sǝk harǝfat'en paɗ ma ɓeɗa hur mwanda Shinkǝn tǝ mala'ikachǝ chiɗchiɗ.<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />Ndǝkǝn ngǝrtǝ Yǝso ndanda kandǝwa: "kittǝkǝn nja mbwa'anda kuni, funǝsa a hurnuni mbǝɗya ngunda mǝrtǝwa sema neɗndǝ kuturichita Fara ɓeɗ tǝ alchita."<verse eid="MRK 9:1" /></para>
  <para style="s">Mbumbweta Fata Yǝso hi</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />Ɗiffitǝ mundǝ tehheth, harkǝ Yǝso nda Bitrus tǝ Yakubu tǝ Yohanna, ɗǝkǝn tǝ kanda shohlatǝ lenak njang, nakndǝ ichitnanda mbǝnniyu. Naknda nata kǝllathi chat mbumbweɗkǝ fata Yǝso hi a mbanitǝnanda, <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />sǝk njelechi'en hendǝɗa nakna kǝstǝfǝ nda hwatfara, nguchit nifa mbǝlla sapandǝ njelechi'en tǝ pachau kichuyu a hur kishi'iya. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />Chatkichuyu ɓak nda Iliya tǝ Musa, cheɗkǝndǝ faɗengnanda paɗ kanda shundǝ tǝ Yǝso. <verse eid="MRK 9:4" /><verse number="5" style="v" sid="MRK 9:5" />Ndang Bitrussa Yǝso wa: "Malɗǝm ɓaɗengnǝma mbǝdya ndiichinsi, tahsam kǝtǝnchǝ mǝkkan, ǝrtǝ iyuwa, ǝrtǝ i Musa, ǝrtǝ i Iliya." <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />Mbukǝn iniyu kǝthlǝm sǝnutǝ'i'natna mbutǝwa, kǝthlǝm a lechiɗnda. <verse eid="MRK 9:6" /><verse number="7" style="v" sid="MRK 9:7" />Ɓak husomba'a haya kǝ ɗar inchengnanda ngǝlaǝn kanda, chek mburata kissha hur husombikǝn tǝ ndatwa: "Ka hweengnǝniya leyahti kamǝn thlǝmmata." <verse eid="MRK 9:7" /><verse number="8" style="v" sid="MRK 9:8" />Chat kǝllakndǝhi chika tǝteni nundǝ nifǝ somǝnwa, se Yǝso ndak naka thlǝmat nanda. <verse eid="MRK 9:8" /><verse number="9" style="v" sid="MRK 9:9" />Naknda tǝrtahaya a shohlayiyu, ndang Yǝso kandǝwa: "Mǝ mbwa'anduni nifǝ i'nattuniyawa, se fari thlaatǝ hweya nifa hur mǝmatcha." <verse eid="MRK 9:9" /><verse number="10" style="v" sid="MRK 9:10" />Kǝskǝndǝ I'har mbwa'andǝnna kanda, paɗ naknda sahandǝ ndanichǝ tǝ ndatwa: "Mǝ naka sakǝt thlata a hur mǝmatcha." <verse eid="MRK 9:10" /><verse number="11" style="v" sid="MRK 9:11" />Sahang ndǝ mi tǝ ndatwa: "Kǝthlǝm mǝ ndat malɗǝmchǝ fa sakandǝ kus tǝkǝnnaɗi, Iliya na tǝrka thlata?" <verse eid="MRK 9:11" /><verse number="12" style="v" sid="MRK 9:12" />Ngǝrkǝ Yǝso sǝwa: "Kittǝkǝn Iliya na tǝrka thlata kǝthlǝm kǝ tahsaǝn chikamǝhi. Chika tǝ kichu, kǝthlǝmmǝ ndat laulawatkǝnwa hweya nifa nan sat pwanchǝ ka'ǝn tǝ paɗ kǝ njirndǝndi? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />Paɗ nja mbwa'anda kuni ndatwa, Iliya tepi ɓeɗi sa nofchǝ i'ngǝmtǝ hurengnanda nda i'natna a hur laulawatkǝn kǝ ɗar i'ndi'en.<verse eid="MRK 9:13" /></para>
  <para style="s">Kǝna Yǝso Hweeya ɗi tǝ Ɓǝɓi Shemecha fa</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />Kǝnatnda ngǝrta mbǝɗa tahǝt kimshechi'en, nakndǝ nofchǝ oi, a taurangndǝ kandǝhi, paɗ funǝ malɗǝmcha fa sakandǝ kus tǝ tǝrɓanda Fara ɗi kanda halǝ'i'ndǝ tǝ kanda. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />Kǝnat nofchiyu Yǝso, pǝɗang ǝn kandǝfa, rahkǝnda thlǝmatkǝn ndangndǝ ǝna. <verse eid="MRK 9:15" /><verse number="16" style="v" sid="MRK 9:16" />Ndǝkǝn sahandǝ Yǝso kandǝwa: "Mǝnatuni halǝ'i'ndǝ tǝ kandǝ kǝ ɗarkǝn?" <verse eid="MRK 9:16" /><verse number="17" style="v" sid="MRK 9:17" />Yuna hur nofchiiyu shuwunkǝn tǝ ndatwa: "Malɗǝm ɓuɗi hwe'engna kǝthlǝm kǝ kǝnangɗi ɓǝɓi shemeɗɗa fat'en njandǝ shunda. <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />Ma ɓeɗ ɓǝɓi shemeɗkǝnna fi'en la muhkǝnndǝhi kǝ hachahaya. Mi'enna hupta kǝna chi hanthlanchi'en, chat mbǝsku titiɗhi. Ndaɗi kimshecheku wa kǝ rǝkangndǝ ɓǝɓishemechikǝnna kish mbǝlla'undǝwa." <verse eid="MRK 9:18" /><verse number="19" style="v" sid="MRK 9:19" />Ngǝmang Yǝso kandǝwa: "Kunang nofchǝ fa ɓahfǝrkit! Kǝkwat natmanata ɓǝt ǝrtǝ tǝ kuni? Kǝ kwat natinata kǝrǝstǝ tǝkuni? Ɓamitǝn hwankǝn." <verse eid="MRK 9:19" /><verse number="20" style="v" sid="MRK 9:20" />Ɓangndǝ hwaniyu. Kǝnat ɓǝɓi shemeɗiyu Yǝso, tǝpkǝn hwanihiyu hachahaya mǝla takarǝhi mi'enna hupta. <verse eid="MRK 9:20" /><verse number="21" style="v" sid="MRK 9:21" />"Ndǝkǝn sahandǝ Yǝso mi shin hwanniyuwa?" Ɓǝt kǝnni kǝstǝ'i'ndiya?" Ngǝmanwa: "Thlata hwanchit'en. <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />Kurɓandǝ nata muhnda hur am tǝ hwata tǝna mbǝlanda. Paɗ manu mbǝllata kǝsanna kanisi kǝ handukanifa." <verse eid="MRK 9:22" /><verse number="23" style="v" sid="MRK 9:23" />"Ndǝkǝn ndandǝ Yǝso wa kǝthlǝm mǝnatu ndatwa mani mbǝllata?" Chikamǝ nan sǝtta kǝ mbǝɗa le fǝrkǝ kit." <verse eid="MRK 9:23" /><verse number="24" style="v" sid="MRK 9:24" />Chatkichuyu shin hwanniyuwa tǝkǝn ndakǝnwa, a firi kit, paɗ kǝsitǝnsi tǝ ɓah fǝr kitchiɗengna." <verse eid="MRK 9:24" /><verse number="25" style="v" sid="MRK 9:25" />Kǝ nat Yǝso nofchǝkǝna chektǝ oi, kanda ɓat tǝ rahta, ɓokangna ɓǝɓi shemeɗkǝnhi tǝ ndatwa: "Sokǝn ɓǝɓi shemeɗɗi njang sǝkɓǝt tǝ shunda hwaniya nja ndutuwa chukisha fat'en mǝ tamina ngǝr yimta fat'enwa." <verse eid="MRK 9:25" /><verse number="26" style="v" sid="MRK 9:26" />Ɓǝɓi shemeɗɗiyu hwakǝn, tǝpkǝn hwanihiyu fat'enna saktatfa chekna kish. Nak hwanniyu ɗuk nda tǝ mǝrrǝn, nak nofcha hurrumta paɗ terchin ndangwa tǝ mǝrrǝn. <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />Kǝskǝ Yǝso hara hwanniyu kǝsaansi thlarkǝnhi kit. <verse eid="MRK 9:27" /><verse number="28" style="v" sid="MRK 9:28" />Ɗiffitǝ ndǝkǝn, Yǝso tǝ kimshechi'en i'chitnanda a huri, sahang kimshechi'en miya a ɓuɓweeta: "kǝthlǝmmi mbǝla'uchitani kǝtandǝ ɓǝɓi shemeɗɗiyu?" <verse eid="MRK 9:28" /><verse number="29" style="v" sid="MRK 9:29" />Ngǝmang Yǝso wa: "Witǝkǝn ngu chetakish kichuwa se tǝ hwanda."<verse eid="MRK 9:29" /></para>
  <para style="s">A Ngǝr Yǝso Mbu Witǝ Mǝri Natna Mǝrtaɗi</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />Malkǝndǝ mbǝnnihiyu cheknda kish tǝ hurhuri Galili. kǝthlǝm yahu Yǝso kǝ sǝn nifǝ mbǝndi natǝnwa, <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />nakna sakanda kimshechi'en har tǝ ndatwa: "Na ficha fǝr hweya nifa kǝ harra attikrechikǝn, nanda mbǝllanda paɗ ɗiffitǝ mundǝ mǝkkan nan thlata hur mǝmatcha."<verse eid="MRK 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 9:32" />Nakǝn mbǝsawundǝ i'mbutǝnwa tǝ paɗ kanda lechit kǝ sahangndǝ i'natna yara.<verse eid="MRK 9:32" /></para>
  <para style="s">Wun Nak Mwanchin</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />Ɓak nda Kafarnahum sokkǝndǝhi a huri sahang Yǝso kimshechi'enwa: "Mǝnatuni shunda ɗarkǝna mbandiyu?" <verse eid="MRK 9:33" /><verse number="34" style="v" sid="MRK 9:34" />Mbǝla'undǝ fǝra ngǝmkǝnwa, kǝthlǝm a mbanda helndǝ i'ndǝ tǝ ndani ndatwa wun nak mwanchinna hurnanda. <verse eid="MRK 9:34" /><verse number="35" style="v" sid="MRK 9:35" />Sokkǝnhi, akǝn kimshechi'en kumngǝrǝnsǝ chap yu, ndangnakandǝwa: "Chikawun yahkǝsa nata mban kǝ naka ɗiffi paɗ kǝ saǝn fat'en kǝ mafata nofchǝ nat." <verse eid="MRK 9:35" /><verse number="36" style="v" sid="MRK 9:36" />Tǝrkǝn hwe har, thlaraanhi hurɗifitǝnanda tǝrkǝnndǝ, ndangna kandǝwa: <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />"Chikawun thlǝk hwe kicheya a hur thlǝmna thlǝtǝnji, paɗ chikawun thlǝknji, thlutǝnji ɗengwa thlǝkǝn tǝ Papati thlǝnkǝnji."<verse eid="MRK 9:37" /></para>
  <para style="s">Nat le Nguchika Atikrechit Tǝkǝm Mǝlanna'i'nǝm</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />Ndang Yohanna Yǝso wa: "Malɗǝm neɗani nifa rǝk ɓǝɓi luwurcha a hur thlǝmwa, ndangnganiwa kǝ malaǝn kǝthlǝm nga nakna hurnaniwa" <verse eid="MRK 9:38" /><verse number="39" style="v" sid="MRK 9:39" />Ndǝkǝn ndat Yǝso wa: "Mǝ njaɗuniwa, nifǝsi na sǝt witǝ torǝniyu a hur thlǝmna mashiɗ kǝ tǝɓrǝnhi kǝ mbuǝn ɓǝɓi'icha i'ndengniwa." <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />Chikawun nguchika atikrechit tǝ kǝm mǝlan i'nǝm. <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />Kittǝkǝn nati mbwa'anda kuni, nat nifi fǝrang amsata kuni kǝthlǝm kunang 'i Kǝrǝsti nan thlǝt kǝnikǝn.<verse eid="MRK 9:41" /></para>
  <para style="s">I'chi na Ɗǝf Nifa Sǝt Ɓǝɓichitfata</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />Chikawun ɗǝfkǝ ǝrta hur hwanchi fǝrkǝ kit kǝ ɓǝɗengniya kǝ sǝn ɓǝɓichitfata, kweshaɗa nifiniyu kǝ wokang fichǝ fǝnhata ɓur kǝ muh fichǝnda hur hawurta. <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />Ma hareku la ɗǝfkǝsa sǝt ɓǝɓichitfata thlandinaɗaɗi. Kweskǝn kǝ yimna pwan nga harsǝ ǝrtǝwa mǝni muhsa hwata tǝ harchǝ hwaa. <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />Hwaɗi la lǝfuchik kǝ pwaree. <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />Ma sareku la ɗǝfkǝsa sǝt ɓǝɓichitfata, thlandǝnaɗi kweshkǝn kǝ yimna pwan nga sarǝsǝ ǝrtǝwa mǝni muhsa hwat tǝ sarǝchi hwaa. <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />Hwanɗi la lǝfuchik kǝ pwaree. <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />Ma hwaniteku la ɗǝfkǝsa sǝt ɓǝɓichitfata, kǝtandǝnaɗi kweshkǝn kǝ yimna mwanda Farǝ tǝ hwanitǝ ǝrta mǝni muhsa hur hwat tǝ hwanichǝ hwaa. <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />Mbǝɗi la mǝruchit hweecha, paɗ hwatkǝn tamwa liftǝwa. <verse eid="MRK 9:48" /><verse number="49" style="v" sid="MRK 9:49" />"Kǝthlǝm chikawun nak ficha kikeɗandǝ tǝ hwata. <verse eid="MRK 9:49" /><verse number="50" style="v" sid="MRK 9:50" />"Mannda ndiichin, paɗ ma tǝr mbǝndǝ'ennaɗi, naku mbǝlla ngǝranda kwarkǝn kǝ manndawa kǝni? Kǝnuni mbinchin tǝ ndani nda i nat mannda, paɗ kǝ sokuni yuyur tǝ ndani."<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s">Sakandaɗi kǝ Ɗar Sak Reta</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />Yǝso malkǝn thlet hǝmǝɗkenhi pǝɗakna thlet hǝmǝɗ Yahudiya chaǝn suhwaɗ Yodan. Humkǝ nofchǝ oi kǝ thlǝmatkǝn, nakna nata sakanda nofchiharyu nda i la sǝtǝn kǝnding. <verse eid="MRK 10:1" /><verse number="2" style="v" sid="MRK 10:2" />Ɓak Farisawecha mbǝsndi kǝthlǝm kǝ kikeɗangnda, sahangndǝ mi wa: "Keekesi kǝ kal hishnifǝ nuhkǝnhiwa?" <verse eid="MRK 10:2" /><verse number="3" style="v" sid="MRK 10:3" />Ngǝmang Yǝso kandǝ tǝ sahmi paɗ ndatwa: "Mǝ mbutǝ Musa a hur kus tǝkǝn kǝ ɗar sak reta?" <verse eid="MRK 10:3" /><verse number="4" style="v" sid="MRK 10:4" />Ngǝmang "Musa fǝrandǝn mbanda hishnifa kǝ yaraǝn ɗelwera nuhkǝnsǝ kǝ fǝraǝn kǝ rǝkǝnndǝ." <verse eid="MRK 10:4" /><verse number="5" style="v" sid="MRK 10:5" />Ndǝkǝn ndandǝ Yǝso kandǝwa: "Yarangna kunisǝ kichuyu kǝthlǝm kwaakwaachit hanndǝkikechengnuni. <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />Paɗ thlata tǝrkakǝn tinkǝ Farǝ kandǝ, nuhnifa tǝ hishnifa. <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />Kǝthlǝm ndǝkǝn hishnifǝ nan malǝ shinkǝhi tǝ mankǝn kǝ nandǝ ǝrtǝ tǝ nuhkǝn. <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />Chapndǝyu hwimndǝhi kǝ ǝnǝrta. Nga nakndǝ chap paɗwa nakndǝ ǝrta. <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />Kǝthlǝm ndǝkǝn i'humandǝ Fara mǝ saka nifǝhiwa. <verse eid="MRK 10:9" /><verse number="10" style="v" sid="MRK 10:10" />Kǝnatǝn i'chitkǝn tǝ kimshechi'enna huri sahangndǝ mi kǝ ɗar shuniniyu paɗ. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />Ndangnakandǝwa: "Chikawun cherkǝ nuhkǝn kahkǝn somǝn shiɗtǝ fǝlawichit tǝ ndi <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />Paɗ ma cher nuhnifǝ sǝmaha kahkǝn yunǝ somǝn, shiɗtǝ fǝlawichita."<verse eid="MRK 10:12" /></para>
  <para style="s">Yǝso Fǝrandǝ Mbǝsǝnhara Hwecha.</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />Farǝ le ɓang parchǝ hwechengnanda Yǝso kǝthlǝm kǝ tǝka'ǝn harra kandǝfa kǝ fǝraǝn mbǝsǝnhara kanda. Nak kimshechi'enna njanda parchiyuwa mǝ ɓindǝ tǝ hwanchiyu mbanitǝkǝnwa. <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />Kǝnat Yǝso kichuyu, sǝɓkǝ hur'ennaɗi, ndangna kandǝwa: "Malamǝn hwecha kǝ ɓanda mbǝndengna, mǝ njanduni kandǝwa, kǝthlǝm kuturichita Fara i'witǝ fichile nak nda kandang. <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />Kitchitkǝn nati mbwa'anda kuni chikawun thluchik mwanda Farǝ nda hweya, ngu yimtǝsǝwa." <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />Mbǝnniyu harkǝn hwanchiyu sǝkǝn harcha inchengnanda fǝraǝn mbǝs'ǝna kandahar.<verse eid="MRK 10:16" /></para>
  <para style="s">Kimshaa lǝ Kǝna'a</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />Yǝso tahǝskǝnfa na ɓǝɗata Urshelima, ɓak kimsha'a lǝ kǝnaa tǝ rahta, sǝkǝn kurumchihi ɓanitǝkǝn sahaǝnwa: "Ka Malɗǝm, mǝ natisǝta kani ɓǝs shisshingtǝ le kǝ pware?" <verse eid="MRK 10:17" /><verse number="18" style="v" sid="MRK 10:18" />Sahang Yǝso wa: "Kǝthlǝm mǝ atunjiwa ka malɗǝm?" "Nifǝsǝ naka katkǝnwa se Farǝ ndak. <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />Kǝ ngǝmayi sahmiyeku a shinnǝ kuschikkǝnwa! Mǝ mbǝlǝnifatwa, mǝ sǝni fǝlawichitwa, mǝ herkinǝwa, mǝ thlerna ɗar yuna a ɗar lektǝwa, mǝ ndathlana nifafuwa, kǝ fǝrrangnǝ mwanda nda suk tǝ yatu." <verse eid="MRK 10:19" /><verse number="20" style="v" sid="MRK 10:20" />Ndǝkǝn ndandǝnwa: "Malɗǝm, a hǝrmi i'chiniharyu nat thlata hwanchiɗengna." <verse eid="MRK 10:20" /><verse number="21" style="v" sid="MRK 10:21" />Kǝlang Yǝso kimshi'iyu tǝ hwanitǝ mbǝnfata ndaǝnwa: "Ən ǝrtǝ tahhuka, ɗu hi'yan i'chiɗǝ nakseku nat kǝ sakangnǝ hanndǝɓǝlkǝna fa ɓahcha, nu mbǝs hurmichita hur afshi, kanna ɓata kuwurnji." <verse eid="MRK 10:21" /><verse number="22" style="v" sid="MRK 10:22" />Kǝ sǝktǝn shuninuyu, ɓǝɗakǝn tǝ sǝɓhura, kǝthlǝm lǝ kǝnaa nakǝn ka'ǝn. <verse eid="MRK 10:22" /><verse number="23" style="v" sid="MRK 10:23" />Kǝlak Yǝso hi ndangna kimshechi'enwa: "'Yang'yangnga fa hurumta kǝ yimka kuturichita Fara!" <verse eid="MRK 10:23" /><verse number="24" style="v" sid="MRK 10:24" />Pǝndang ǝnna kimshechifiyu tǝ shuwunkǝn. Ndǝkǝn ngǝrtǝ Yǝso ndanda kandǝ paɗwa: "Hwecha, yimta kuturichita Farǝ 'yang'yang. <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />Nannat paapa'a fa ngelupa kǝ 'yimǝn tǝ kwat lipir mǝni hurumta kǝ yimka kuturichita Fara." <verse eid="MRK 10:25" /><verse number="26" style="v" sid="MRK 10:26" />Kǝ sǝktǝ kimshechǝkǝn'en shuniniyu, pǝndang ǝn kandǝfǝ ka'ǝn sahkǝndǝwa: "Ma nakǝn kichu wunhacha na hǝrǝkta hurkishi'iya?"<verse eid="MRK 10:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="MRK 10:27" />Kǝllang Yǝso kandǝ ndakǝnwa: "Mbǝɗa nifa ngu nat paapaawa, mbǝɗa Fara chikamǝ nan nat paapaa." <verse eid="MRK 10:27" /><verse number="28" style="v" sid="MRK 10:28" />Tǝrkaakǝ Bitrus ndandǝwa: "Kanang melani i'chi hi nat kana kuwursa." <verse eid="MRK 10:28" /><verse number="29" style="v" sid="MRK 10:29" />Ndǝkǝn ndat Yesowa: "Kittǝkǝn nja mbwa'anda kuni, chǝkawun malkǝ huraahi, ndu hwanmanchǝkǝn kǝ hishcha tǝ nishcha, ndu shinkǝn ndu mankǝn, ndu hwechi'en, ndu pwatarcha kǝthlǝm njang tǝ ka kusheng shunda, <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />nan mbǝs ǝn arucha a kishi'i nakǝnya, hurecha, hwanmancha, parcha, hwecha tǝ pwatarcha tǝ pwenecha nan mbǝs shisshingta a hurrechi na ɓatyu, <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />Kǝthlǝm ndǝkǝn, terchin fichile naka mban nakǝnya naknda nata ɗiffi, fichile naka ɗiffi paɗ naknda nata mban."<verse eid="MRK 10:31" /></para>
  <para style="s">Mǝkkatǝ Shunda Yǝso kǝ Ɗar Mǝrtǝ'enaɗi</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />Kanda pǝɗata Urshelima, Yǝso lak na mbanitǝnanda. Pǝɗang ǝnnatkǝn kimshechi'enfa, nofchi naka kuwur kanda ɗiffi paɗ lechiknda. Thlarkǝ Yǝso hi akǝn kimshechi'en kumngǝrǝnsǝ chapyu kǝ kǝlar, mbwa'angna kandǝ nat i' na mbǝsndi. <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />Ndakǝnwa: "Sǝkama, nakǝnya nǝma ndǝta Urshelima, kǝ mbǝndǝ nat ficha fǝr hweya nifa, kǝ harra pǝktat pǝristcha tǝ malɗǝmcha fa sakandǝ kus tǝkǝnnaɗi. Nanda thla kitasǝ i'mǝrtaɗi kǝ fǝrndǝndi kǝ harra punofcha. <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />Nanda sa welǝm, chahangndǝ yahta fa, tǝppangnda, kǝ mbǝllangnda. Hur mundǝ mǝkkan nan thlata."<verse eid="MRK 10:34" /></para>
  <para style="s">Hwanda Nda Yakubu tǝ Yohanna</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />Nda Yakubu tǝ Yohanna hweecha Zabadi ɓaknda ɓǝsndi ndangndǝwa: "Maldǝm, ǝnsǝ yahtanisa hwanuta kǝ sangnǝ kani." <verse eid="MRK 10:35" /><verse number="36" style="v" sid="MRK 10:36" />Sahaǝn kandǝwa: "Mǝ yahtuni kǝ sayi kuni?" <verse eid="MRK 10:36" /><verse number="37" style="v" sid="MRK 10:37" />Ndangndǝwa: "Fari natu yimta kuturichiɗeku hur afshi kǝ sokǝm rǝmma, ǝrta harsǝmteku ǝrtǝ paɗ a hishingteku." <verse eid="MRK 10:37" /><verse number="38" style="v" sid="MRK 10:38" />Ndang Yǝso kandǝwa: "Sǝnwuni i natuni hwandǝwa. Nuni mbǝla sat ɓahhi nati satyawa? Nuni mbǝla thlǝt baptisma ti nati thlǝtyawa?" <verse eid="MRK 10:38" /><verse number="39" style="v" sid="MRK 10:39" />Ngǝmangndǝwa: "Aa nani mbǝlata." Ndang Yǝso kandǝwa: "Nuni mbǝla sat ɓahi nati sata, kǝ thluni baptisma ti nati thlǝta. <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />Paɗ alchiɗengnǝsǝ nati ndatwa leya na sokta a harsǝmtengna ndu hǝshingtengnǝwa. Farǝ tahsaǝn ɓichiniyu kǝ i' fichile taɗtǝnhar." <verse eid="MRK 10:40" /><verse number="41" style="v" sid="MRK 10:41" />Kǝ sǝktǝ tahǝt kimshechi'en kumyu shuniniyu sǝɓkǝ hurchengnandaɗi kǝ ɗar Yakubu tǝ Yohanna. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />Ak Yǝso kandǝ nat, ndangna kandǝwa: "Shinuniwa, fichile naka kuturcha a kishi'iya la sǝkndǝ tor tǝ alchindengnanda kǝ ɗar nofchengnanda, paɗ pǝktechǝkǝn la sǝkndǝ tor tǝ mwaɗengnanda kǝ ɗar nofchengnanda. <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />Ngu nat kichu a hurnuniwa. Paɗ le yahkǝsa nat mwanchin a hurnuni, kǝ sǝka mafata tahchǝkǝn. <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />Tǝ paɗ le yahkǝssa nata mban, kǝ naka mafata nofchǝ nat. <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />Kǝthlǝm chika hweya nifa a ɓu kǝ sang fichǝ torwa, ɓakǝn kǝ saǝn tora nofcha, paɗ kǝ fǝrǝn shisshingtǝ'en kǝ thlǝn nofchandǝ oi."<verse eid="MRK 10:45" /></para>
  <para style="s">Bartimawus Kukomta Kǝna Yǝso ɗi</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />Yǝso tǝ kimshechi'en saakǝnda Yeriko. Naknda malǝ Yerikohi tǝ nofchǝ oi, lǝ hwandǝsǝ paɗ kukomta thlǝmkǝnwa Bartimawus, hweya Timawus, ɗas a mi mbanda, <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />Kǝ sǝktǝ Bartimawus wa Yǝso Lǝnazarat naka mbǝrtǝhi, ndǝkǝn thla'andǝn mburata ndatwa: "Yǝso hweya Dauda, kǝ handukǝfa." <verse eid="MRK 10:47" /><verse number="48" style="v" sid="MRK 10:48" />Ɓokang nofchihi oiyu ndangndǝwa kǝ ngasǝn ɓa. Thlat tǝkichu i'naǝn mburathi ka'ǝn: "Hweya Dauda kǝ handukifa!" <verse eid="MRK 10:48" /><verse number="49" style="v" sid="MRK 10:49" />Sǝkkǝ Yǝso ndi thlarkǝn hi ndakǝnwa: "Ndamǝnwa kǝ ɓaka mbǝɗya." Nofchiyu ndangnda kukomiyuwa: "Kwallu hacha," "Aɓu mǝla atsa." <verse eid="MRK 10:49" /><verse number="50" style="v" sid="MRK 10:50" />Chatkichuyu thlakǝ kukomiyu muhaǝn ndǝ suptǝ'enaɗi, ndǝkna mbǝs Yǝso. <verse eid="MRK 10:50" /><verse number="51" style="v" sid="MRK 10:51" />Ndǝkǝn sahandǝ Yǝso miya: "Mǝyahtusǝ kǝ sukǝ?" Ndǝkǝn ngǝmandǝ kukomiyuwa: "Malɗǝm, Yahkǝsi kǝ mbǝsi natmbǝta."<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />Ndang Yǝso wa: "Ndu, fǝrkitchindeku kǝnuɗaɗi." Chatkichuyu inkǝ hwanichi'enhi kuwurkǝn Yǝso pǝɗaknda.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">Yim Yǝso kǝ Urshelima</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />Kǝnatnda satǝ nduk kǝ Urshelima, a Betafaji, tǝ Betani, tǝ shohla Zaitun, thlinkǝ Yesu kimshechi'en chap, <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />Ndangna kanduwa, yimmama thlet hǝmǝɗini taata mbanitǝnuniyu, nda yimtengnunisi nuni nat hwan kware kǝnda, le tamuchit ficha pǝrtǝsi. Kǝ kwasuni ɓunitǝkǝn. <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />Chika wun sahang mi kuni wa kǝthlǝm mi, natuni sǝt kichu? Ndangnguniwa shinnǝm naka yahta, paɗ nan ɓattǝkǝn nakǝnya. <verse eid="MRK 11:3" /><verse number="4" style="v" sid="MRK 11:4" />Ndǝkǝn pǝndat kimshechi'en ndǝknda ɓǝssandǝ hwan kware tǝkǝnna miɓanga a kǝlarǝ mbanda, kwassang ndǝ hi. <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />Nofchi nak kitkita mbǝnniyu, ndangnda kanduwa: "Kǝthlǝm mi natuni kwasǝ hwan kware ti ya? <verse eid="MRK 11:5" /><verse number="6" style="v" sid="MRK 11:6" />Mbwa'angnda kandǝ I ndandǝ Yǝso kandǝwa kǝ mbunda, malang nofchikǝnkanda pǝndakndǝtǝkǝn. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />Ɓangndǝ hwan kware tǝkǝna Yǝso supkǝndǝ njelenjengnanda ɗar hwan kware tǝkǝn pǝrkǝnsi. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />Nofchǝ oi supkǝndǝ ndǝ supcheng nanda mbanda, funǝ paɗ thlithlahkǝndǝ swikangrechi har somkǝndǝhi. <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />Fichile ɓan tǝ fichile naka ɗiffi naknda whata, funa kukwara tǝ ndatwa, Hosanna! ɓǝs'ǝnna har shok kǝ ndukwatkǝn kǝɓǝɗa lǝɓatta hur thlǝm Lǝmwanda. <verse eid="MRK 11:9" /><verse number="10" style="v" sid="MRK 11:10" />Ɓǝs'ichisǝ har a ɗar ɓata kuturichita kakatnǝm Dauda! Mwanamǝn Fara le naka afshi <verse eid="MRK 11:10" /><verse number="11" style="v" sid="MRK 11:11" />Yim kǝnna Urshelima, kǝ kapat hura'a Fara, kǝllaǝn chikami, Sǝk farǝhufta, chekna kish pǝɗak na Betani tǝ kimshechi'en kum ngǝrrǝnsǝ chap.<verse eid="MRK 11:11" /></para>
  <para style="s">Yǝso Sǝɓandi Affǝt Shuɓwata ɗi tǝ Shunda.</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />Ɓingǝtkǝn naknda malǝ Betanihi, nak mita fa Yǝso. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />Anakǝn affǝt shuɓwat tǝ swa'en kundummǝ kuɗkuɗ langnga, ndǝkǝn ndǝtǝn ka nata naǝnhiwa nan mbǝs hwecha ɓuratkǝn. Swechǝ ndaknaksi, kǝthlǝm sa'u farǝ ngǝttǝ'enwa. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />Ndang Yǝso affǝtkǝnwa: "Mǝ ngǝri nifa chi hwecheku paɗwa." A shik kimshechi'en i mbutǝn.<verse eid="MRK 11:14" /></para>
  <para style="s">Yǝso Rǝkaɗǝ fa Hitǝ tǝ Hi'yandaɗi a Kapat Hura'a Fara</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />Ɓakndaɗi kǝ Urshelima, yim kǝ Yǝso kǝ kapat hura'a Fara, rǝkkǝn fa hita tǝ fa hi'yandǝ ichaɗa hur kapat hurikǝnna Fara, paɗ wuwelaǝn hanafcha fa hi'yandǝ Tattabaracha ndǝ tǝ fa mbumbwe hanndiɓǝlcha. <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />Paɗ thlaraǝn chika wunhi naka sǝt tortǝ kapat huri kǝnna Fara nda mbǝt hi'yandǝ ichaɗi. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />Ndangna kandǝwa: "Ndak yaratkǝnwa, 'Hure'engna nak ficha atwa mbǝt hwanda a hǝmchǝnat, ɓakuni tǝɓrandǝhi kǝ mbǝt sokta harcha." <verse eid="MRK 11:17" /><verse number="18" style="v" sid="MRK 11:18" />Kǝ sǝktǝ pǝktat pǝrischǝ tǝ malɗǝmcha i laulawatkǝn i sǝt Yǝso, kakndǝ mbayi natnda mbǝllanda. Sokkǝn lechanda kǝthlǝm nofchi humkǝyu pǝɗa'ǝnkandǝfǝ tǝ saktǝ'en. <verse eid="MRK 11:18" /><verse number="19" style="v" sid="MRK 11:19" />A Farǝhuffǝɗiniyu chek Yǝso kisha hǝmǝtkǝn tǝ kimshechi'en.<verse eid="MRK 11:19" /></para>
  <para style="s">Ənat Sakta A ɗar Shuɓwaɗi Hwarkaɗiyu</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />Kanda mbǝrtǝhi a ɓingǝtkǝn tǝ thlǝmat affǝɗi mbutǝn ǝn kǝ ɗarkǝnyu, mbǝssang kimshechi'en affǝt shuɓwatkǝn hwerandǝ kǝ thlorǝkǝn. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />Kuɗukkǝ Bitrus i mbutǝ Yǝso kǝ ɗar shuɓwaɗiyu a farǝle ndakǝnwa: "Malɗǝm, kǝllu shuɓwandǝ sǝɓandundǝ tǝ hanngalǝ shunda hweraɗi paɗ miraɗi." <verse eid="MRK 11:21" /><verse number="22" style="v" sid="MRK 11:22" />Ngǝmang Yǝso kimshechi'en wa: "Nam tǝ fǝrkitta mbǝnda Fara. <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />Ni mbwa'a kittǝkǝna kuni, chikawun ndannga shohlayiya wa, 'thla'u hǝmu hur hawuriyu, nan hǝmtǝsi. Paɗ waat kǝ fǝrnǝkit kǝna sǝtkichu, mǝninǝ tǝ hanɗǝkiketǝ chap chap wa. <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />Kǝthlǝm ndǝkǝn nja mbwa'anda kuni, chika mǝ katuni hur hwanda, ma firuni kitsi tepa mbishuni, nan sokta innuni. <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />Paɗ ma thleruni hi kuna hwanda, ma yunǝ si natuni tǝnda a hurhanɗǝkiketa, kǝ kaluni ndǝhi, kǝ thlǝm shinnuni ti naka hur afshi nan kala ɓǝɓichitfechengnuni kunǝhi. <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />Paɗ ma kalawuni ɓǝɓichitfechengnanda kandǝhiwa, shinnuni hur afshi ngu kala ɓǝɓichitfechengnuni kunihiwa.<verse eid="MRK 11:26" /></para>
  <para style="s">Sahtǝ kǝ Ɗar Alchita Yǝso.</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />Ngǝrkǝ nda yimta Urshelima. Nak Yǝso wi'yandǝ kapat hura'a Farǝhi, pǝktat Pǝrischǝ tǝ pǝktat malɗǝmcha fichile la sakang kus tǝ tǝrmbandaɗi, tǝ fa ɓanita ɓaknda ɓǝɗ'en. <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />Ndangndǝwa: "Mbǝsku alchit sǝt ichinatya ayi? Wun fǝrukǝ mbanda kǝ sǝni kanda?" <verse eid="MRK 11:28" /><verse number="29" style="v" sid="MRK 11:29" />Ngǝmang Yǝso kandǝwa: "Ni sahami kuni ǝrta, ma fǝrinduni ngǝmkǝn kani ɓwa'anda kuni ndu wun fǝrikǝ alchit ichi nati sǝtya. <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />Ɓwa'ami ɓǝskǝ Yohanna alchit sa Baptisma nofcha ayi mɓǝnda Farǝ wa, ndu ɓǝɗa nifa?" <verse eid="MRK 11:30" /><verse number="31" style="v" sid="MRK 11:31" />Tǝrkaakǝndǝ halǝi'nda tinnanda mǝnat ma ndata? Ma ngǝmandǝm wa ɓǝnda Fara, nan ndatwa mǝ sǝk fǝruchituni kitta Yohanna? <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />Paɗ ma ɗendǝm wa ɓǝnda nifa kanda lechanda nofcha kǝthlǝm tǝrkǝ nofchuwa, Yohanna tapǝnaa nakǝn. <verse eid="MRK 11:32" /><verse number="33" style="v" sid="MRK 11:33" />Ndǝkǝn ndandǝnda Yǝso wa: "Sǝnwaniwa. "Ndang Yǝso kandǝwa: "Njang paɗ ngi mbwa'andakuni ndi tǝ witǝ alchit mǝ la sittǝ pǝktat torchiyawa."<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">Fǝr Sakǝt Shunda Ɗar fa Thlǝt Hita kǝ Hurata</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />Tǝrkaakǝ Yǝso shunandǝ kandǝ tǝ sakǝt shundǝ ndakǝnwa: "Nifǝsǝ nat hitǝ inabi ensi, tauraǝn hi tǝ thlara, rekǝn mbǝt yimmandǝ hwanchi inabi tǝkǝnsi, a tinkǝn kǝtǝn pu hitǝkǝnhar. Fǝrang na funǝ fa huɗatkǝn, kana pǝɗata hachahai somǝn. <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />Saakǝ farǝ ɗamhwanchi inabi tǝkǝn, thlǝnkǝn mafat'en har ǝrtǝ kǝ mbǝɗa fichile tǝr kǝ hitiyu, kǝthlǝm kǝ thlangndǝ hwanchi inabi chiyu a hitǝkǝn. <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />Fa tǝr hitǝkǝn kǝsagndǝ mafaɗiyu tǝpangnda, kalkǝndǝndǝhi pǝɗakǝn har chaa. <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />Ngǝrkǝ lǝ hitiyu thlǝnna mafata kandǝ somǝn, erkǝndǝndi tǝpangnda in, sangndǝ ǝnnat harǝ fata. <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />Ngǝrkǝna thlǝn yuna, leya paɗ mbǝllangnda. Nakǝn kichu tǝ yakat fichile thlǝntǝn, funǝ tǝ tǝpangnda kanda funǝ tǝ mbǝllangndǝ kanda. <verse eid="MRK 12:5" /><verse number="6" style="v" sid="MRK 12:6" />A tahkǝn nifǝ ǝrta, hwan lelǝ mbǝntǝn fatkǝn ka'ǝn. A mweshitkǝn lǝ hitiyu thlǝnkǝn ndi kǝ mbǝɗengnanda tǝ yarǝwa kittǝkǝn nanda fǝra mwanda hwe'engna. <verse eid="MRK 12:6" /><verse number="7" style="v" sid="MRK 12:7" />Fichile tǝrkǝ hitiyu ndangndandaniwa, Ale na sokta lǝ hitǝkǝnya a ɓama ɓǝma ɓǝllanda, kǝ sok hitǝkǝna i'nǝm. <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />Kǝssangnda a ɓǝllangnda, muhangndi murrut kǝnaɗi kǝ ɗiffitǝ hitǝkǝn." <verse eid="MRK 12:8" /><verse number="9" style="v" sid="MRK 12:9" />Sahang Yǝso kandǝwa: "Saǝnkunifǝwa mǝnat lǝ hitiyu sǝta? Ni mbwa'anda kuni-nan mbǝlandǝ fa hundechiniyu kǝ fǝraǝn hitikǝna funǝ somǝn. <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />Tamwuni changngandǝ iya hur yarat shiwuncha Farǝwowa? Ngwiyi chertǝ fatinda sokka kukuwun tinda. <verse eid="MRK 12:10" /><verse number="11" style="v" sid="MRK 12:11" />Ndǝsǝta Lǝmwandǝniyu, paɗ ǝnat pǝɗandǝ kǝmfa hwanichengnǝm. <verse eid="MRK 12:11" /><verse number="12" style="v" sid="MRK 12:12" />Pǝktat fatǝr mbanda yahkǝndǝsa kǝsandǝ Yǝso kǝthlǝm mbǝssandǝwa fǝrkǝn sakǝt ɓǝɓi fa huɗechiniyu kǝ ɗar inchengnanda. Anakǝn kanda lechanda nofchi oiyu, kǝthlǝm ndǝkǝn mallangnda pǝɗaknda.<verse eid="MRK 12:12" /></para>
  <para style="s">Kwa Chamta Mbǝɗa Kaisar.</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />Farǝle, thlǝnkǝ pǝktechǝ funa hur Farisiyawecha tǝ nofcha Hiridus, kǝthlǝm kǝ mbǝsangndǝ chit'hansara Yǝso hi, a hur shiwunchi nat na mbuta ɓah nanda kǝsanda. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />Satengnanda, ndangndǝwa: "Malɗǝm, shinani wa sokǝn lǝkitchita. Nofchǝ uf ǝrta mbǝɗeku yah i'ndekusǝwa. Lasakawu mbanda Fara ɗi a ɗar kitchita. Nakǝnya mbwa'ana kani keekesi kǝ kwanani chamta ɓǝɗa Kaisar kapat kutura Romacha ndu nga keekesuwa? <verse eid="MRK 12:14" /><verse number="15" style="v" sid="MRK 12:15" />Anakǝn a mbǝssa Yǝso sakta kohat nofchǝkǝn, ndangnakandǝwa: "Kǝthlǝmmǝ natuni ndǝfi kantara mban? Ɓamitǝn hanndǝmbǝlta Romawecha kǝ ni." <verse eid="MRK 12:15" /><verse number="16" style="v" sid="MRK 12:16" />Ndǝkǝn ɓandǝndǝ ǝrta, sahkǝnwa, mirshingngiya tǝ thlǝmmǝ ɗarkǝnya i wuni?" Ndangndǝwa: "I Kaisar." <verse eid="MRK 12:16" /><verse number="17" style="v" sid="MRK 12:17" />Ndang Yǝso kandǝwa: "Fǝramna Fara i naka i Fara paɗ fǝranguni Kaisar i naka i Kaisar." Pǝɗang ǝnatkǝn kandǝfǝ ka'ǝn tǝ ngǝmtǝ'en.<verse eid="MRK 12:17" /></para>
  <para style="s">Sahmi kǝ Ɗar Thlata Mǝmatcha</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />Ɓak Sadukiyawecha mbǝs Yǝso, pǝktat fa tǝrmbanda fichile ndakwa thlatǝsa ɗiffitǝ mǝrtaɗǝwa. Sahangndǝmi tǝ ndatwa: <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />"Malɗǝm, yarang Musa kus tiya kanisi ndatwa, ma mir hwanman nifǝ kǝ hishnifa, meltǝ nuhnifihi nga hwechi'ensuwa, hwanmankǝn kǝ hishnifa nan kǝna reta kǝ ngalaǝn hwecha hwanmankǝntisǝ mǝrkǝyu, kǝthlǝm kǝɗa thlǝm hwanmankǝna mban. <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />Hwanmanchisi muɗ kǝ hishcha, hwalat'hwankǝn thlekǝn perra, mǝrkǝn malutǝ hwehiwa, <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />Chapatǝkǝn tǝrkǝn nuhmuruɗiyu kǝ nuhkǝn, mǝlan paɗ mǝrkǝn malutǝ hwehiwa. Sokkǝn kichu tǝ mǝkkatǝkǝn. <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />Nakna mban kichuyu tuɓwaǝn hwanmanchi muɗyu malundǝ hwehiwa. A mweshitmikǝn ɓak nuhiyu mǝrta. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />Kǝthlǝm ndǝkǝn mbwa'ana kani, a thlata mǝmatcha nakna nat kǝ nuh wuni? Kǝthlǝm ufndǝ muɗ reɗndǝ tǝndi." <verse eid="MRK 12:23" /><verse number="24" style="v" sid="MRK 12:24" />Ndang Yǝso kandǝwa: "Ndǝkǝn sǝk la suchituni keeke kǝthlǝm sǝnwuni yarat shunda Faruwa, Paɗ sǝnwuni alchita Farǝwa. <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />Thlahmbǝɗi nat mǝmatcha thlata, mwa'u hishcha ret nishchǝwa, nishchi paɗ mwa'u ficha fǝrkanda kanwa. Naknda soktǝ nda fathlǝncha Fara hur'afshi. <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />Ɗar pathlǝ thlata mǝmatcha, awi tamwuni changnganda a hur ɗelwercha Musa wowa, a hur kusheng shiwun hurhwelii kǝskǝ hwatyu? Ndatwa njang naka Fara Ibrahim, Ishaku tǝ paɗ i' Yakubu." <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />Mǝlan nga Fara mǝmatchǝwa, i' fa shisshingcha. Shiɗɗuni i'nguchik Keeke."<verse eid="MRK 12:27" /></para>
  <para style="s">Kus le Nak Mwanchin</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />Ərta hur malɗǝmcha fa sakandǝ kussa Musa ɗi, thlarkǝnhi mbǝnniyu nakna sǝkkanda halǝ'i'ndǝ tǝ ndani. Mbǝssaǝn tǝndatwa Yǝso firtǝ ngǝmtǝ ndiichin, sahkǝnwa: "Yen kus tǝni cheka nat mwanchina hur kuschi ufya?" <verse eid="MRK 12:28" /><verse number="29" style="v" sid="MRK 12:29" />Ngǝmang Yǝso wa: "Le nak mwanchin ndǝkǝn naka, Sǝkama, Kunang Israilawecha, Lǝmwanda Farengnǝm mǝlan ǝrta na Lǝmwandǝ ndak. <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />Waat kǝ mbǝnnǝfat Lǝmwanda Fareku tǝ hanndǝkiketǝku uf, tǝ shisshingteku uf, tǝ yareku uf tǝ paɗ alchiɗeku uf.' <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />Chapatǝkǝn paɗ ndǝkǝn naka, 'Kǝ yahnǝ le nattuni nduknduk nda i'yahtu i'ndeku.' Nga kussi si mbǝrangnga fichilehiya tǝ mwandǝwa." <verse eid="MRK 12:31" /><verse number="32" style="v" sid="MRK 12:32" />Ndǝkǝn ngǝrandǝ malɗǝmti la sakangnga ɗǝwa: "Keeke mbuutu malɗǝm. Mbwi nǝ kittǝkǝn ndatwa Farǝ ǝrta yunǝsǝ paɗwa. <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />Paɗ ashini ndiichinsi kǝ yah fichindǝ tǝ hanɗǝkiketǝ uf tǝ mbǝssandengnǝ uf, tǝ alchit uf, tǝ paɗ kǝ yahnǝ fichile natuni nduknduk nda i yahtu i'ndeku. Ndǝkǝn nak ndiichin oi sheraɗa fǝr us'i'chi tǝ fǝr pofǝnti yahtǝ ficha hur kustǝkǝn." <verse eid="MRK 12:33" /><verse number="34" style="v" sid="MRK 12:34" />Kǝ mbǝsandǝ Yǝso wa nifiniyu a mbǝssaɗǝ ngǝmtǝ'en tǝ ɗathla, ndaǝnwa: "Nganaku lanngǝ tǝ kuturichitta Farǝwa. "Ɗiffitǝ ndǝkǝn yunǝsǝ sǝk alchit hanndǝkiketǝ kǝ ngǝrǝn sahhami paɗwa.<verse eid="MRK 12:34" /></para>
  <para style="s">Hweya Wun Kǝrǝsti Tiya?</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />Nak Yǝso sakandaɗa hur kapat hura'a Fara, sahkǝnwa: "Tǝkǝni lanat malɗǝmcha fa sakandǝ kus Musaɗi ndatwa, "kǝrǝsti hweya Dauda nakǝn? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />Kǝthlǝm Dauda tǝ i'ndi'en a hur Shemeɗ Chiɗchiɗ, ndakǝnwa: "Lǝmwanda ndangna Lǝmwandengnǝwa, sokuhi tǝ harsǝmtengna, kǝ fari nati ndǝf atikrechǝuwa ka sarǝcheku." <verse eid="MRK 12:36" /><verse number="37" style="v" sid="MRK 12:37" />Dauda tǝ i'ndi'en eɗtǝndǝwa Lǝmwanda, tǝ kǝnǝ natna sokta hwe'en?" Kapat humtǝhi kathlǝmat tǝ mbǝndǝfa.<verse eid="MRK 12:37" /></para>
  <para style="s">Mbǝramsa Malɗǝmcha fa Sakaɗǝ Kus Tǝkǝnaɗi.</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />A sakandǝ'enaɗi ndakǝnwa: "Mbǝramsa malɗǝmcha fa sakaɗǝ kus tǝ tǝrɓandaɗi, la yahkǝnda witǝ tǝ pǝktat njelecha, kǝthlǝm kǝ ndang fichi ǝnna kandǝ tǝmwanda lumocha. <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />Paɗ la mbǝnangfata kanda kǝ mbǝsndi mbǝtsokchi ndiichin a mbǝt humta Yahudawechihi, tǝ mbǝt rǝɓcha. <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />Kandang harǝfatsǝwa la naknda sǝmandǝ i'cha ndǝlat nishchi mǝrtǝ hishchengnanda, tǝ hwandǝ toltol a hur nofcha nda ka fa tǝrmbanda. Kǝthlǝm ndǝkǝn nanda sat ɓahtǝ ka'ǝn."<verse eid="MRK 12:40" /></para>
  <para style="s">Fǝr Poffǝnna Ndǝlat Nuhnifǝ Mǝrtǝ Sǝmahha.</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />Sokkǝ Yǝso nduktǝ yokǝt ngom hanndǝmbǝlta a kapat hura'a Fara, nakna nata kǝlandǝ nofchi naka muh hanndǝmbǝltengnanda hur yokǝt fǝr poffǝn tǝkǝn. Hurrumchi oi muhkǝ hanndǝmbǝlchǝ ka'ǝn. <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />A ɓak nuhnifǝ lǝ ɓahta le mǝrtǝ sǝmahha, somkǝn mbuthl kopo chap kǝ hurkǝn, le sokka pene ǝrta. <verse eid="MRK 12:42" /><verse number="43" style="v" sid="MRK 12:43" />Ak Yǝso kimshechi'en kǝ thlǝmatkǝn, ndangna kandǝwa: "Kitchitkǝn nati mbwa'anda kuni, i'fǝrtǝ ndǝlat nuhhi mǝrtǝ sǝsmahya, mbǝranda i'chika wunhi uf. <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />Kandang ufya fǝrkǝnda hur kǝnechengnanda, mǝllan paɗ a hur ɓahtǝ'en fǝrtǝn uf i'tahangsa nat'en."<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">Mbwi Yǝso Witǝ i na Kǝs Kapat Hura'a Fara</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />Nak Yǝso malǝ kapat hura'a Farǝhi, ǝrta hur kimshechi'en ndakǝnwa: "Malɗǝm, nu witǝ pǝktat ngwichiya tǝ pǝktat tinchiya." <verse eid="MRK 13:1" /><verse number="2" style="v" sid="MRK 13:2" />Ndang Yǝso wa: "Nga neɗnǝ pǝktat tinchiyawa? Nga yunǝsǝ natficha mala mbǝnniyu chika ǝrtǝwa paɗ ngwisǝ nat ficha mala ɗar shekkǝn nguchitficha wuwellandǝhiwa."<verse eid="MRK 13:2" /></para>
  <para style="s">Tǝrka Ɓahtǝhi.</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />Paɗ sokkǝnna ɗar shohla Zaitun le naka kǝllarǝ kapat hura'a Fara. Bitrus, Yakubu, Yohanna tǝ Andarawus ɓakndǝ i'chitnanda ɓuɓweeta sahangndǝwa: <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />"Mbwa'andǝna kani, kwat nat i'chiya sǝta? Mǝnaka sakǝtkǝn na chetǝwa a shee farǝ sǝta i'chiniya?" <verse eid="MRK 13:4" /><verse number="5" style="v" sid="MRK 13:5" />Ngǝrkǝ Yǝso sǝwa, "Ndǝffam i'ndǝsi mǝ shekɗa yunǝ kuniwa. <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />Kǝthlǝm nofchǝ oi na ɓata hur thlǝmnǝ tǝ ndatwa, 'njang naka kǝrǝsti.' Nanda lǝm nofchǝ oi. <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />Paɗ ma shikunǝ pathlǝ mbecha tǝ kusheng mbecha, mǝ lechiɗuniwa. Waat i'chiniyu nat kǝssǝn kichu, paɗ mweshitkǝn sa'u kwandǝnwa. <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />Hǝmtǝ nan thla'anda hǝmtǝ fa, kuturichit paɗ nan thla'anda kuturichita fa. Na ficha sǝk hǝhǝrta hachahaifa mbechǝ somsomǝn a kisshita, tǝ paɗ na mita natsi. I'chininatyu tǝrka pwanchǝ kwaɗǝn, mwee funa ɓata. <verse eid="MRK 13:8" /><verse number="9" style="v" sid="MRK 13:9" />"Kǝ sokuni tǝ tahhasǝfa ma i'chiniyu tǝrka thlata. Nanda ndǝttǝkuni kǝ mbǝt sakmicha, paɗ nanda tǝppanda kuni a mbǝt humta Yahudawechahi, paɗ nuni thlara ɓanitǝ pǝktat nofcha tǝ kuturcha kǝthlǝm thlǝmna, paɗ nuni mbǝs mba mbwa'a kusheng shunda kandǝ kǝ ɗar i'ndengna. <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />Kǝthlǝm kusheng shundǝ mbinchin nat ficha tǝrka ɓassanda hǝmchǝ nat. <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />Ma harandǝ kuni ɗǝɗndǝ tǝ kuni mbǝt shunda, mǝ thla'i hur in'chengnuni kǝ ɗar i'natuni mbutǝwa. Mbwa'am i'mbwa'andǝ Fara kuni a mbǝnniyu, kǝthlǝm nga kunang na shundǝwa Chiɗchiɗ tǝ Shemeɗ ndak na shunda. <verse eid="MRK 13:11" /><verse number="12" style="v" sid="MRK 13:12" />Paɗ hwanmanda nan fǝr hwanmankǝn kǝ ɓǝlang ficha, Shindǝ paɗ nan fǝr hwe'en, paɗ hwecha nanda thla'anda parchinandǝ fa, kǝ ɗǝfndǝ kǝ tǝkang fichǝ kandǝhi. <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />Paɗ chikawun nan cherǝ kuni kǝthlǝm thlǝmna. Paɗ le kǝrǝskǝ kǝ ndukwatkǝn nan hǝrǝkta.<verse eid="MRK 13:13" /></para>
  <para style="s">Sat Pwancha.</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />"Farǝkǝnaɓata ma mbishuni ǝnat tǝkǝmta le na ɓat tǝ pwancha a thlerhi mbǝɗi kamuchiksi, (Lǝ changngatkǝn kǝ sǝnǝn): "Fichile naka Yahudiya kǝ rahnda shohlacha. <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />Le naka afshi a ɗar kǝnnda mǝ tǝriɗahai kǝ yimka huriwa nan tǝr ǝnwa. <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />Le naka hi mǝ ngǝriɗa huri wa nan tǝr ǝnat suptǝ'enwa. <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />Ai kǝmbǝɗa nishcha fichile tǝ hwechahur tǝ fichile tǝ hwecha hǝsǝr a hur munchiniyu. <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />Hwanama mǝ si ichiniyu a hur mbitǝuwa. <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />A thlah mbǝɗiniyu, na pwancha natsi le tamu chit ficha nata kǝ sǝt Farǝ kishita kǝ ɓukweya, paɗ ngu ficha ngǝrandǝwa kǝ ndukwatkǝn. <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />Manga i'nakǝn tahha Lǝmwandǝ hanmunchikǝnhiwa nifǝsi na hǝrǝktǝwa, Paɗ kǝthlǝm tachikǝnharti taatǝn, ndǝkǝn sǝk tahandǝn hanmunchikǝnhi. <verse eid="MRK 13:20" /><verse number="21" style="v" sid="MRK 13:21" />Mǝnda yuna kuniwa, "Nama, a Kǝrǝstiya, ndu 'mǝlan taatiyu' mǝ fǝriɗuni kitsǝwa. <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />Kǝthlǝm fa lekchisi na chetakish wa kandang naka kǝrǝsti, tǝ tapǝnecha i'lekta, paɗ kǝnanda sǝt ǝnat pǝɗandǝ nifǝfa kǝthlǝm kǝ shekɗangndǝ nofcha, manan sǝta chika tachikǝnhara Fara. <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />Kǝ ndǝfuni i'ndǝsi, mbwa'aɗi chikama kuni leɗya. <verse eid="MRK 13:23" /><verse number="24" style="v" sid="MRK 13:24" />Ɗiffitǝ Pwanchini hanmunchiniyu, hwatfarǝ nan yimta hulta, ndǝrra'a ngu fǝr ɗwachitwa, <verse eid="MRK 13:24" /><verse number="25" style="v" sid="MRK 13:25" />Handǝrechǝ paɗ nanda nata hǝhatta haya afshi, alchita afshi nan hǝhǝrtǝfa. <verse eid="MRK 13:25" /><verse number="26" style="v" sid="MRK 13:26" />Ɗif fitǝkǝn chikawun nannat hweya nifa ɓata hur hussomɓa tǝ kapat alchit tǝ mwanda. <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />Kana thlǝn fathlǝnchi'en kǝ ngommangndǝ tachikǝn'en chika aya hurkishita, thlata ndukwat kukunchi fwaɗa a kishita thlata ndukwat kishitǝ kǝ le.<verse eid="MRK 13:27" /></para>
  <para style="s">Ənat Sakta Ɗar Affǝt Shuɓwata</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />Nakǝnya sakam ǝna ɗar affǝt shuɓwata. Ma mbisshuni tirkeetǝ njarǝhi mǝla titita, kǝ sǝnunisǝwa fektǝ ndukhi. <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />Kichu paɗ, ma neɗnduni ichiya sǝta kǝ sǝnunisǝwa ɓat'en ndukhi mǝla mi kǝnnda. <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />Kitchitkǝn nati ɓwa'anda kuni, naɗihi nakǝnya ngu mbǝrtǝhiwa, sema shiɗ i'chinatyu. <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />Afshi tǝ kishita nanda thlǝrǝttaɗi, paɗ shundengnǝ ngu tamta thlǝrǝttaɗǝwa.<verse eid="MRK 13:31" /></para>
  <para style="s">Nifǝsǝ Sǝnkǝ Farǝkǝn ndu Hanthlikchǝkǝnwa.</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />Paɗ nifǝsǝ sǝnkǝ farǝkǝn ndu hanthlikǝn kurmi fari nat i'chiniyu sǝta, chika fathlǝnchikǝna hur afshi ndu hwankǝn tǝ'i'ndǝ'en. Shindǝ sǝnkǝ ndak. <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />Nakǝn sǝnwuni fari nat farǝkǝna ɓatwa, sokam tǝ tahhasǝfa. <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />"Ɓata hweya nifa naknanat nda nifǝ na sǝt witǝ langnga, ma meltǝ huraahi, saka'ǝn tora mafechi'en, chika wun tǝ tor'en, ndangna lǝ pu mimbangkǝnharwa, kǝ ndǝfǝn i'ndǝsi kǝ fari natna ngǝrandǝ'in. <verse eid="MRK 13:34" /><verse number="35" style="v" sid="MRK 13:35" />Chika kunang kǝ ndǝfuni i'ndǝsi, kǝthlǝm sǝnwuni fari nat lǝ hura'a ɓataɗǝwa, ndu farǝhufta, hurɗiffitǝ findǝkta, katǝt ɓǝta, mbahya ɓingta. <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />Ma ɓeɗ kurukchuk mǝ ɓiɗa mbǝsandǝ kuni saɓweniwa. <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />I la ɓwa'aɗi kuni, la ɓwa'ayi chikawuni kǝ sokuni tǝ tahhasǝfa."<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">Keɗ Pǝktechǝ Mbandǝ kǝ Ɓǝlangndǝ Yǝso</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mt 26:1-5</ref>; <ref loc="LUK 22:1-2">Lk 22:1-2</ref>; <ref loc="JHN 11:45-53">Yh 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />Tahkǝ mundǝ chap kǝ safichǝ chohhǝmtala tǝ i'chi njohma le nguchit mehɗǝsafi'en. Le nak mwanchina hur pǝrischa tǝ malɗǝmcha fa sakandǝ kussa ɗi, naknda kat mba kǝsandǝ Yǝso ɓuɓweeta kǝthlem kǝ ɓǝlangnda. <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />Kǝthlǝm lǝ ndakndǝwa: "Ngǝma sǝt iya hur njohhǝmiyawa, mǝni nofcha thla'andǝhur'i'nda."<verse eid="MRK 14:2" /></para>
  <para style="s">Pa'afichǝ Kwescha Fiɗeta Yǝso a Betani</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />Yǝso mǝla Betani hura'a Siman le nat tarkwindafi'en soh. Mǝla ɗar sǝm'ǝna, yimkǝ nuhnifǝsi tǝ kwescha kupat tahǝstǝfichi tǝ pundala, tǝ fiɗeta hurkǝn le nat satǝ'en mbinchinfa la atfichuwa nardi, la hiikǝfichǝ tǝ hanɗǝɓeltǝ oi, chaǝn kupaɗihiyu thlǝraǝn fiɗetkǝna Yǝso in. <verse eid="MRK 14:3" /><verse number="4" style="v" sid="MRK 14:4" />Nofchi naka mbǝnniyu sǝɓkǝ hanɗǝkikecheng nandaɗi tǝ i sǝt nuhiyu, ndangndandaniwa: "Kǝthlemmǝ natna sǝɓandǝ fiɗeɗiɗǝ lahiitǝfichǝ tǝ hanɗǝɓeltǝ oi kicheya? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />Matǝ hi'yangfichaɗiya manaficha mbǝs hanɗǝɓelta i sherangnga aru kumchit kum mǝkkan, kǝ fǝrangficha fa ɓahcha." Ɓokangnda nuhihiyu ka'ǝn. <verse eid="MRK 14:5" /><verse number="6" style="v" sid="MRK 14:6" />Ndak Yǝso wa: "Malamǝn nuhhiniyu! Kǝthlemmǝ natuni ɗahandǝ'in? Shiɗtǝ'ǝn ndiichin. <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />Faɓahcha pware a hurnuni, nuni mbǝlla kǝsandakandǝsi chikakwat yahtuni. Paɗ nga njang tǝ kuni pwareewa. <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />Nuhhiya shiɗtǝ i natna mbǝla sita. Thlǝriɗǝ fiɗetafa a tah'saɗǝ faɗengnǝ kǝ fari natficha thlohita. <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />Kitchitkǝn mbwa'andi kuni, uf mbǝɗi nat nofcha ɓasǝ kusheng kashunda hur kishitǝ nat, nanda mbu i sǝt nuhhiya, kǝthlem kǝ kuɗukfichǝndi."<verse eid="MRK 14:9" /></para>
  <para style="s">Ngǝma Yahuda wa Nan Fǝr Yǝso kǝ Kǝsangnda</para>
  <para style="r">(<ref loc="MAT 26:14-16">Mt 26:14-16</ref>; <ref loc="LUK 22:3-6">Lk 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />Yahuda Iskaryoti ǝrta hur kimshecha Yǝso kumkǝngǝrǝnsǝ chap, ɗǝkna mbǝɗa Pǝktat Pǝristchǝkǝn kǝthlǝm kǝ hi'yangka ɗi. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />Sǝkkǝndǝ i yahtǝna sǝta naknda kwala, ndǝkǝn tahsaɗǝɗǝhiwa nani fǝrru hanɗǝɓǝlta. Mbǝnniyu ngagtǝ Yahuda kat mbayi natna hi'ya Yǝso kanda.<verse eid="MRK 14:11" /></para>
  <para style="s">Yǝso tǝ Kimshechi'en Chiindǝ Njohmǝ Nga Mehndǝfǝwa</para>
  <para style="r">(<ref loc="MAT 26:17-25">Mt 26:17-25</ref>; <ref loc="LUK 22:7-14">Lk 22:7-14</ref>, <ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Yh 13:21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />Saakǝ tǝrka farǝ chi njohǝm chohhǝmtala le nguchit mehnɗǝsa fi'en, le lǝ thlet fichǝ ɓurat hanshohrata, ndang kimshechi'enwa: "A ai yahtusi kǝ tahsukani mbǝt chi njohǝm chohhǝm talǝkǝnsi?" <verse eid="MRK 14:12" /><verse number="13" style="v" sid="MRK 14:13" />A thlǝnkǝn kimshechi'en chap ndagnna kaɗewa: "Ɗama hur hǝmta, nuni kǝmtǝ tǝ nifǝ mǝla rǝf ɓǝt ama, kurunindi, <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />uf huri'i yimtǝn, ndangnguni lǝ hurikǝn wa: "Ndak malɗǝm wa a ai kǝtǝn romchi natti chi njohhǝm chohhǝmtala kanang tǝ kimshechengna?' <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />Nan cheɗa kapat kǝnnda kuni afshi le taptǝficha kǝ tahsangficha. Mbǝnniyu natuni tahsǝ njohǝmkǝna kǝmsi." <verse eid="MRK 14:15" /><verse number="16" style="v" sid="MRK 14:16" />Kimshechiyu malkǝdǝ mbǝnnihiyu pǝɗaknda hur hǝmta, ɗǝknda mbisandǝ uf ichi sǝka nda i mbutǝ Yǝso. Tahsangndǝ chohhǝmtalǝkǝnhi. <verse eid="MRK 14:16" /><verse number="17" style="v" sid="MRK 14:17" />Ɗiffitǝ hǝmta fara Yǝso tǝ kimshechi'en kum kǝngirǝnsǝ chap ɓaknda hurikǝn. <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />Kanda ɗar sǝm'ǝna, ndak Yǝso wa: "Kitchitkǝn nati mbwa'anda kuni, ǝrta hurnuni nan hi'itaɗi, le natani sǝm'ǝn tǝndi." <verse eid="MRK 14:18" /><verse number="19" style="v" sid="MRK 14:19" />Kǝ sǝktǝ kimshechi'en kichu sǝɓkǝ hanɗekiketeng nandaɗi, tǝrƙaakǝnda sahandǝ ǝrtǝ ǝrta tǝ ndatwa: "Njang wa?" <verse eid="MRK 14:19" /><verse number="20" style="v" sid="MRK 14:20" />Ngǝrkǝnsuwa, ǝrta hurnuni kumkǝngǝrǝnsi chap le natani sǝmta hur tǝɓi ǝrta. <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />Andiya hweya nifǝ nan ɓǝɗata, nda i yarandǝfichǝ kushengkǝnhi nattǝ kichu, ai kǝ mbǝɗa nifi yahkǝsa fǝr hweya nifa! Kweshkǝna ngǝtufichǝndǝwa."<verse eid="MRK 14:21" /></para>
  <para style="s">Sǝm Jibi i Lǝmwanda</para>
  <para style="r">(<ref loc="MAT 26:26-30">Mt 26:26-30</ref>; <ref loc="LUK 22:14-20">Lk 22:14-20</ref>; <ref loc="1CO 11:23-25">1 Kr 11:23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />Naknda ɗar sǝm'ǝna, tǝrkǝn njohma saǝn usoko Fara, chichaǝnhi fǝrangna kimshechi'en, ndagna kandǝwa: "Thlama; leya faɗegna." <verse eid="MRK 14:22" /><verse number="23" style="v" sid="MRK 14:23" />Ɗiffitǝkǝn tǝrkǝn tǝpsat ama, a sǝkǝn usoko, a fǝrangna kanda sakndǝ ufnda <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" />"Leya fwarengna le thlerandiɗi kǝthlem nofchǝ oi." <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />"Tǝni mbwa'a kitchitkǝna kuni thlatǝ nakǝnya kǝ mban mwaawi sat ǝnwa magnga fari natisat yuwakǝnna hur mwanda Farǝ wa." <verse eid="MRK 14:25" /><verse number="26" style="v" sid="MRK 14:26" />In'kǝndǝ imsha, pǝɗaknda kish kǝ shohla Zaitun.<verse eid="MRK 14:26" /></para>
  <para style="s">Mbwi Yǝso Halǝ'i'ni Nat Bitrussa Hala</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mt 26:31-35</ref>; <ref loc="LUK 22:31-35">Lk 22:31-35</ref>; <ref loc="JHN 13:36-38">Yh 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />Kanda ɗar wita ndang Yǝso kandǝwa: "Uffuni nuni rahta maluni nji i'chitna. Nda i yarandǝ fichǝ ndatwa,</para>
  <para style="q1" vid="MRK 14:27">'Ni ɓǝlandǝ la hǝrǝmta,</para>
  <para style="q2" vid="MRK 14:27">shohrechikǝn nanda wuwelǝhi.'<verse eid="MRK 14:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="MRK 14:28" />Ɗǝk na mban tǝndandǝ wa ɗiffitǝ thlatengna tǝ shisshingta ni lata Galili mǝ kunang".<verse eid="MRK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29" />Ndang Bitrussa Yǝso wa: "Njang ngi malǝsǝhiwa chika rahkǝ tahchikǝn nat."<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />Ndang Yǝso Bitrus wa: "Kitchitkǝn nati mbu'uta fiɗǝkiya kǝ kukwara ɗektǝ chap nu kurɓadǝ halǝ indǝ mǝkkan tǝ ndat wa sǝnunǝ njiwa." <verse eid="MRK 14:30" /><verse number="31" style="v" sid="MRK 14:31" />Chika tǝ kichu nak Bitrussa kurɓandǝ mbuta tǝ alchita ndatwa, chika tǝna ficha tǝkkandǝkǝmhi hwaa ngi tamta halǝ i'ndǝwa sǝnwisǝwowa!" Natnda ndakndǝ kichu.<verse eid="MRK 14:31" /></para>
  <para style="s">Hwana Yǝso Fara hur Getsemani</para>
  <para style="r">(<ref loc="MAT 26:36-46">Mt 26:36-46</ref>; <ref loc="LUK 22:39-46">Lk 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />Ndǝkǝn saatǝnda mbiɗǝ la atfǝchiwa Getsemani. Ndangna kimshechi'en wa: "Sokamhi mbiɗya, kǝ ɗi hwanda." <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />Tǝrkǝn Bitrus, Yakubu tǝ Yohanna, tǝrkaakǝn sǝk ɓahtǝ ka'ǝn, mirfat'ennaɗi. <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />Ndangnakandǝwa: "Shisshingtengna mǝlla nat pwanchǝ ka'ǝn. Thlaramhi mbiɗya kǝ nuni kǝlathi." <verse eid="MRK 14:34" /><verse number="35" style="v" sid="MRK 14:35" />Ɗǝkna mban nguɗeh hǝmkǝnhi hachaya nakna hwandǝ tǝ ndatwa: "Ma mbandǝsi mǝ niɗi pwene ti naka ɓatyuwa." <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />Ndakǝnwa: "Papa, Papa, ǝnsǝ nak 'yang'yang nga mbǝɗekuwa. Tǝrran pwene tiɗaɗi fi'engnǝya. Chika tǝ kichu nga i yahti natu sǝtwa iu'wa. <verse eid="MRK 14:36" /><verse number="37" style="v" sid="MRK 14:37" />Ndǝkǝn ngǝrandǝn ina thlemat kimshechi'en ɗǝkna mbǝsandǝ kanda sa ɓweni. Ndangna Bitrus wa: "Bitrus, nanna sa ɓweni? Awi nguna mbǝlla soktǝ tolla a kǝlat chika i hanthliktǝ ǝrtǝwa? <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />Sokam tǝ tahasǝfa kǝ nuni hwanda kǝthlǝm mǝhǝmiɗuni hur yah'ichǝwa. Paɗ tir shemeɗa nat tǝkichu fatkǝn tǝrruwa." <verse eid="MRK 14:38" /><verse number="39" style="v" sid="MRK 14:39" />Ngǝrkǝnna ngǝrrandǝ'in kǝthlǝm kǝ hwanin, nakna ngǝrrandǝ shuni shuwuntǝn soh. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />Ngǝrkǝna ɓata thlemat nanda ɓakna mbǝsandǝ kanda saɓweni, kǝthlǝm uf nda nǝhǝɗ ɓweni hwanichengnandǝ ka'ǝn, ɓahkǝndǝ i nan nda mbwa'anda. <verse eid="MRK 14:40" /><verse number="41" style="v" sid="MRK 14:41" />Ngǝrkǝna thlǝmatnanda i mǝkkatǝkǝn, ndangna kandǝwa: "Paaya mwakuni saɓweni kǝnuni yipta? Shik kichu, shee farǝkǝn. A fir fichi hweeya nifa kǝ hara fa ɓǝɓichitfata. <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />Thla'ama, tama. nama, nifina hiiyandaɗaɗi mǝlanya!"<verse eid="MRK 14:42" /></para>
  <para style="s">Kǝsafichǝ Yǝso</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mt 26:47-56</ref>; <ref loc="LUK 22:47-53">Lk 22:47-53</ref>; <ref loc="JHN 18:3-12">Yh 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />Chatkichuyu, kǝ nanna ngǝlandǝ mi'en, ɓak Yahuda ǝrta hur kumngǝrǝnsǝ chap tǝkǝn tǝ nofchǝ oi tǝ thlohcha tǝ sǝssalcha, pǝktat pǝristcha tǝ malɗǝmcha fa sakandǝ kusaɗi, tǝ pǝktechi thlenkǝ kanda. <verse eid="MRK 14:43" /><verse number="44" style="v" sid="MRK 14:44" />Kǝthlǝm nifi hi'yangngaɗiyu teppa mweshandǝ tǝ ndatwa: "Le natti mbǝnfatkǝnyu mǝlan naka nifǝkǝn. Kǝ kǝsangnguni kǝ pǝɗuni tǝnda har." <verse eid="MRK 14:44" /><verse number="45" style="v" sid="MRK 14:45" />Kǝ saatǝn ɗǝkna mbǝs Yǝso ndaǝnwa: "Lǝ hura'a." Nakna mbǝnfatkǝn tǝ kǝmmiya. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />Chatkichuyu njo'angnda kǝsangnda. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />Ərta hurnandǝ le nak kit, kǝtkǝn thlohtǝ'en chathlaǝn thlemata mafata kapat Pǝrist tǝkǝnnaɗi. <verse eid="MRK 14:47" /><verse number="48" style="v" sid="MRK 14:48" />Ndang Yǝso kandǝwa, ɓakuni tǝ thlohcha tǝ sǝssalcha kǝthlem kǝ kǝsikuni nda tǝni hara? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />Hanmunchikǝn kǝm nang tǝ kuni nja sakandaɗa hur kapat hura'a Fara, nattǝ kichu kǝsiwuniwa. Sǝk fichǝ kichuyu kǝthlǝm kǝ nǝhɗang fichǝ i mbutǝ laulawatkǝn. <verse eid="MRK 14:49" /><verse number="50" style="v" sid="MRK 14:50" />Mbǝnniyu ɓak kimshechi'ena cherǝndǝfa, rahkǝnda.<verse eid="MRK 14:50" /></para>
  <para style="s">Kimshi'i Rahka</para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />Han kimshasi tǝ ɗǝ supta fa, kuwurkǝn ndi. Njo'angnda, <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />mǝllan mallaǝn ɗǝ supkǝna kanda, rahkǝn tamkwal.<verse eid="MRK 14:52" /></para>
  <para style="s">Yǝso Mbanitǝ fa Yarakǝn hi</para>
  <para style="r">(<ref loc="MAT 26:57-68">Mt 26:57-68</ref>; <ref loc="LUK 22:54-55">Lk 22:54-55</ref>, <ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">Yh 18:13-14</ref>, <ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />Mbǝnniyu Pǝɗak ndǝ tǝ Yǝso kǝ mbǝɗa kapat pǝrist. Nat pǝktat pǝristcha tǝ fambanicha tǝ malɗǝmcha fa sakandǝ kussa ɗi ngomkǝnda thlǝmmatkǝn. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />Bitrus nakan langnga nattǝkichu kuwurkǝnndi, kǝ hura'a kapat pǝrist tǝkǝn sokkǝnna thlemat fa pu hurikǝnhar nakna tǝk hwata. <verse eid="MRK 14:54" /><verse number="55" style="v" sid="MRK 14:55" />Mbǝnniyu pǝktat pǝristcha tǝ pǝktat fasakmichǝ uf nda naknda kat sakǝt shuni nannda ɗǝftǝ kǝ ɗar Yǝso, kǝthlǝm kǝ mbǝsndǝ kǝ ɓǝlangnda, nattǝkichu mbǝsundǝ mbandǝwa. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />Paɗ nofchǝ oi shuwunkǝ lekta ɗar i'ndi'en paɗ ɓu miyengnandǝ ǝrtǝwa. <verse eid="MRK 14:56" /><verse number="57" style="v" sid="MRK 14:57" />Ɗiffitǝkǝn paɗ thlaakǝ funǝ tǝ lektǝ kǝ ɗar i'ndi'en ndatwa: <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />"Shikanindi ndatwa, 'ni hokkandǝ kapat hura'a Farǝhi le tintǝ fichǝ tǝ harcha, paɗ hur mundǝ mǝkkan ni tinnanda kwarkǝn nga tǝ harchǝwa." <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />Chika tǝ kichu shundengnandǝ ɓu ǝrtǝwa. <verse eid="MRK 14:59" /><verse number="60" style="v" sid="MRK 14:60" />A mbǝnniyu thlaakǝ kapat pǝrist thlarkǝnhi kit kǝ hurɗifitǝnanda sahaǝn mi Yǝso tǝ ndatwa: "Nga ngǝmtekusǝwowa? A ɗar witǝ i'chi mbutǝ ficha i'ndekuyawowa?" <verse eid="MRK 14:60" /><verse number="61" style="v" sid="MRK 14:61" />Ngaskǝn ɓa ngǝrawusǝwa. Ngǝrkǝ kapat pǝrist tǝkǝnna sahandǝ paɗ: "Sokǝn naka Kǝrǝsti, hweya Farǝwa?" <verse eid="MRK 14:61" /><verse number="62" style="v" sid="MRK 14:62" />Ndak Yǝso wa: "Njang." "Tǝpaɗ nuni nat hweya nifa ɗassa harsǝmta le nak mwanchin mǝla ɓatahaya hur afshi hur husomba'a." <verse eid="MRK 14:62" /><verse number="63" style="v" sid="MRK 14:63" />Ndǝkǝn thlǝthlahandǝ kapat pǝrist tǝkǝn njela'enaɗi, ndakǝnwa mǝnatma ngǝrkata mbǝɗ'en paɗi. <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />"Sǝkam witǝ njir faɗi sǝtǝn: "Mǝ nattuni?" Uf nda thlangndǝ kitahi tǝ ndatwa keekesi kǝ mǝrkaɗi. <verse eid="MRK 14:64" /><verse number="65" style="v" sid="MRK 14:65" />Chatkichuyu tǝrkaakǝ funa chaha yahtafa, kǝnangndǝ hwanichi'en, tǝtǝpangndǝfa, ndangndǝwa: "Mbwa'ana kani wun tǝpkǝsa." Fa pu kapat hurikǝnhar mbwaltakǝnndi.<verse eid="MRK 14:65" /></para>
  <para style="s">Bitrus Heltǝ I'ndǝ tǝ Ndatwa Sǝnu tǝ Yǝso wa</para>
  <para style="r">(<ref loc="MAT 26:69-75">Mt 26:69-75</ref>; <ref loc="LUK 18:15-18">Lk 18:15-18</ref>, <ref loc="LUK 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />Bitrus mǝllan ndassa hachahaya fǝlhura'a, ɓak nuhhwee ǝrta hur mafecha kapat pǝrist. <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />Nakkǝn Bitrussa tǝk hwata, nakna kǝllandǝ ndakǝnwa: "Sokǝnma, kunang nak tǝ Yǝso Lǝnazarattaɗiyu."</para>
  <para style="m" vid="MRK 14:67">"Ndaǝnwa kunang nak tǝ Yǝso Lǝnazarattaɗiya. <verse eid="MRK 14:67" /><verse number="68" style="v" sid="MRK 14:68" />Paɗ halkǝn i'ndǝ ndakǝnwa: "Njang sǝnwi i natu shunda ɗarkǝnwa. Paɗ mbǝssawiwa!" Cheknakish kǝ mi mbanga. Chatkichuyu kukwarkǝ ɗekta. <verse eid="MRK 14:68" /><verse number="69" style="v" sid="MRK 14:69" />Mafat nuhhwaniyu nakǝnndi, ngǝrkǝn ndanda fichile kitkitta mbǝnniyuwa: "Nifiya mǝlla hur nanda." <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />Ngǝrkǝna halǝ i'nda.</para>
  <para style="m" vid="MRK 14:70">Toppǝ kicha paɗ fichile kitkityu ndangnda Bitruswa: "Kitchitkǝn sokǝn paɗ naku ǝrta hurnanda, kǝthlǝm sokǝn lǝ Galiliyawata." <verse eid="MRK 14:70" /><verse number="71" style="v" sid="MRK 14:71" />Nakna cherǝ i'ndi'en kǝnna nata at'i'chimi tǝ ndatwa: "Sǝnwi nifi natuni shunda ɗarkǝnwa." <verse eid="MRK 14:71" /><verse number="72" style="v" sid="MRK 14:72" />Chatkichuyu kukwarkǝ ɗekta i chapatǝkǝn. Kuɗukkǝ Bitrus tǝ shuni mbwa'andǝ Yǝso ndatwa: "Kǝ kukwara ɗǝktǝ chap nu kurɓandǝ halǝ i'ndǝ mǝkkan ndatwa sununǝ njiwa." Kǝ kuɗǝktǝn shuwunkǝn chat nakna tita.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">Yǝso Mǝla Mbanitǝ Bilatus</para>
  <para style="r">(<ref loc="MAT 27:1-2">Mt 27:1-2</ref>, <ref loc="MAT 27:11-14">11-14</ref>; <ref loc="LUK 23:1-5">Lk 23:1-5</ref>; <ref loc="JHN 18:28-38">Yh 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />Kǝnat ɓǝta wenda mbingtǝ tung, pǝktat pǝristchikǝn tǝ pǝktat fambanicha tǝ malɗǝmchǝ fa sakandǝ kussa Musa ɗi, tǝ pǝktat fasakmicha tahsangndǝ hi. Ɗǝkǝn kǝnandǝɗǝ Yǝso pǝɗakndǝ tǝnda mbaniti Bilatus. <verse eid="MRK 15:1" /><verse number="2" style="v" sid="MRK 15:2" />Sahang Bilatus mi Yǝso tǝ ndatwa: "Sokǝn naka kutur Yahundawechǝwa?" Ngǝmaǝn'en tǝ ndatwa: "A mbwinǝ keeke." <verse eid="MRK 15:2" /><verse number="3" style="v" sid="MRK 15:3" />Nak pǝktat pǝristchikǝnna nata muh hanharkǝn kǝ ɗar i'chǝ oi. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />Ngǝrkǝ Bilatus sahami tǝ ndatwa: "Nga ngǝmtǝsi natu ngǝrtǝsǝwowa? Nu yakat kohat shuwunchi nannda mbutǝ kǝ ɗar i'ndekuyu." <verse eid="MRK 15:4" /><verse number="5" style="v" sid="MRK 15:5" />Yǝso paaya ngǝrausǝwa, pǝɗang ǝnnatkǝn Bilatus fa.<verse eid="MRK 15:5" /></para>
  <para style="s">Thla Fichǝ Kiita Yǝso i Mǝrtaɗi</para>
  <para style="r">(<ref loc="MAT 27:15-26">Mt 27:15-26</ref>; <ref loc="LUK 23:13-25">Lk 23:13-25</ref>; <ref loc="JHN 18:39-19:16">Yh 18:39--19:16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />Ma shee farǝ chohhǝmtala Bilatus lakalkǝn nifǝhi ǝrta hur pursunacha le sahtǝnda. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />Hur fa thlahur in'chi pursunayu yunǝsǝ mbǝlkǝfata le la atfichǝwa Barnabas. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />Ɓak ngom nofchǝ oi tǝrkaakǝndǝ hwanandǝ Bilatus kǝ saǝn kandǝ nda i'sǝntǝnhi tǝ sandǝ kanda. <verse eid="MRK 15:8" /><verse number="9" style="v" sid="MRK 15:9" />Ndǝkǝn ngǝmmandǝn engnanda: "Yahkunisi kǝ kallayi kutur Yahundawecha kuni hiwa?" <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />Kǝthlem mbǝssaɗiwa tǝ nan'nda sǝrǝhndi, ndǝkǝn nat pǝktat pǝristchikǝna fǝrndi. <verse eid="MRK 15:10" /><verse number="11" style="v" sid="MRK 15:11" />Pǝktat pǝristchikǝn chikangndǝ nofchikǝn, kweshkǝn kǝkalaǝn Barnabassa kandǝ hi. <verse eid="MRK 15:11" /><verse number="12" style="v" sid="MRK 15:12" />Ngǝrkǝ Bilatussa ndanda kandǝwa: "Mǝnati sandǝ nifi lǝ atuniwa kutur Yahundachiya?" <verse eid="MRK 15:12" /><verse number="13" style="v" sid="MRK 15:13" />Ngǝrkǝndǝ hwata tǝ ndatwa: "Kukanhi!" <verse eid="MRK 15:13" /><verse number="14" style="v" sid="MRK 15:14" />Ndang Bilatussa kandǝwa: "Kǝthlem mi? witǝ ɓǝɓifat mǝ sǝtǝn?"</para>
  <para style="p" vid="MRK 15:14">Chika tǝ kichu thla'angndǝ mburat uf ndǝ tǝ alchita ndakndǝwa: "Kukamǝn hi!" <verse eid="MRK 15:14" /><verse number="15" style="v" sid="MRK 15:15" />Bilatus yahkǝnsa tǝra hur ngom nofchihiyu kalaǝn Barnabassa kandǝ hi. Ɗifitǝ tǝppi tǝpandǝ fathlǝrhwecha Yǝso fǝrangna kanda kǝ kukwangndǝhi.<verse eid="MRK 15:15" /></para>
  <para style="s">Njir Fathlǝrhwechǝ Yǝso</para>
  <para style="r">(<ref loc="MAT 27:27-31">Mt 27:27-31</ref>; <ref loc="JHN 19:2-3">Yh 19:2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />Pǝɗak fathlǝrhwechǝ tǝndi kǝ huri kuturichita, kǝ hur huri kuturichita, akndǝ tahǝt fathlǝrhwatkǝn nat. <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />Pangndǝ njeli kuturichit ngah nda am fi mbillehsheta, tahǝskǝndǝ fwa'in ndahha pangnda in. <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />Tǝrkaakǝndǝ nda ǝnna: "Mbwarǝ shisshingta kǝ mbǝɗeku kutur Yahundawecha!" <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />Naknda rǝrro'a ndǝffa'in tǝ sǝssala, naknda chahha yahta fa, tǝpaɗ naknda kopandǝhi wa tǝnnda fǝra mwanda. <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />Kǝ mweshandǝndǝ njirndi, kǝtangndǝ njeli'ihi fi'en ngah nda am fi mbillehshetyu pangndǝ ikǝn. Pǝɗakndǝ tǝndǝ kǝthlem kǝ ɗǝnda kukwandǝhi ɗar palita.<verse eid="MRK 15:20" /></para>
  <para style="s">Kukwa Fichǝ Yǝso hi</para>
  <para style="r">(<ref loc="MAT 27:32-44">Mt 27:32-44</ref>; <ref loc="LUK 23:26-43">Lk 23:26-43</ref>; <ref loc="JHN 19:17-27">Yh 19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />Kanda ɗar mbǝrtǝhi tǝ Yǝso mǝlla rǝf palitǝ'en, chat a nifiya lenat thlemkǝn wa Siman lǝ Sayirinta, shinnda Alekzanda tǝ Rufus, mǝla ɓata thlet hǝmta ɗǝfkǝndǝndi waat kǝtǝrǝn palita Yǝso. <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />Pǝɗakndǝ tǝ ndi kǝ mbǝɗi lǝ atfichǝwa Golgota (sakatkǝn wa mbǝt tǝɓ i'nda"). <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />A mbǝnniyu fǝrrangndǝ am'innabi le kurtandǝndǝhi tǝ mur, cherkǝn sata. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />Kukangndǝhi ɗar palita, sakangndǝ njela'en hi thlerǝnanda, naknda tata kǝthlem kǝ sǝnndǝ i'nat chikawuna mbǝsta. <verse eid="MRK 15:24" /><verse number="25" style="v" sid="MRK 15:25" />Kukangndǝhi tǝ hanthlǝktǝ hanherta i'ɓingta. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />A yarandǝ ǝnat sǝnkǝn kǝ ɗarkǝn: "Kutur Yahudawecha." <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />Mbǝnniyu kukangndǝ hi tǝ harchǝ chap, ǝrta harsǝmtǝ'en ǝrta hishingtǝ'en. <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />Leya ndǝkǝn na nǝhata laulawathi, ndakwa a thlǝkfichǝnda hur fa cherǝ thlǝn i mbutǝ kus." <verse eid="MRK 15:28" /><verse number="29" style="v" sid="MRK 15:29" />Nat nofchi naka mbǝrtǝhi tǝ mbǝnniyu, naknda hǝhrandǝ i'nda kǝnnda shuwun ɓǝɓi icha ɗar Yǝso tǝ ndatwa: "Yu! sokǝn ti ndakwa, nu hokandǝ kappat hura'a Farǝhi paɗ kǝ tinangna hur munchǝ mǝkkan, <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />hǝrkandǝn i'ndeku hacha, kǝ tǝrnahaya ɗar pali'iya!" <verse eid="MRK 15:30" /><verse number="31" style="v" sid="MRK 15:31" />Kichu paɗ pǝktat pǝristcha tǝ malɗǝmcha fa sakandǝ kussa ɗi, lǝ naknda shuwun njirndi a thlerǝnanda, lǝ naknda ndatwa: "Hǝrkaɗǝfuna: "Ngu hǝrkandǝ i'ndi'enwa. <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />Kǝ tǝr Kǝrǝsti haya kutur Isra'ilawecha, kǝ tǝrkahaya ɗar palikǝn chetchetya, tǝkichu natma nata kǝ fǝrǝmkita ɗarkǝn." Fichile kukandǝ fichikandǝ tǝndi i'erandǝfa.<verse eid="MRK 15:32" /></para>
  <para style="s">Mǝrta Yǝso</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mt 27:45-56</ref>; <ref loc="LUK 23:44-49">Lk 23:44-49</ref>; <ref loc="JHN 19:28-30">Yh 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />Hanthlǝktǝ kumkǝngǝrǝnsi chap i hur fara, ngǝlang hultǝ hachahaikǝn nat, kǝ hanthlǝktǝ mǝkan i farǝhufta. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />Kǝ saatǝ hanthliktǝ mǝkan, tik Yǝso tǝ kapat mburata, ndakǝnwa: "Eloi, Eloi, lama sabatani?" sakǝtkǝn wa: "Ai Fara, Ai Fara, mǝsǝk chertunji?" <verse eid="MRK 15:34" /><verse number="35" style="v" sid="MRK 15:35" />Fichile thlarkǝ nduk tǝndi kǝsǝktǝndǝ kichu ndakndǝwa: "Sǝkama mǝla at Iliya." <verse eid="MRK 15:35" /><verse number="36" style="v" sid="MRK 15:36" />Rahkǝ yuna hurnanda ɗǝkna tǝnnandǝ ǝn nda hussunnjela'a, tǝ am tamnda fakkǝna sǝssala, fǝrangna Yǝso kǝ san, ndakndǝwa, "Pwa'ama, kǝnǝm ma na Iliya ɓata tǝrandahaya ɗar pali'i'ya." <verse eid="MRK 15:36" /><verse number="37" style="v" sid="MRK 15:37" />Chatkichu shuwunkǝ Yǝso tǝ kapat mburata, kanna kalǝ shisshingtǝ'enhi. <verse eid="MRK 15:37" /><verse number="38" style="v" sid="MRK 15:38" />Kuwuri kǝntǝ ficha kapat hura'a Fara thlahkǝn hi chap, thlata ɗarkǝn kǝ kakǝn. <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />Kapat fathlǝehwechǝkǝn le nak kitta mbǝniyu a kǝlanda nakǝn mǝri'mǝrtǝn<note caller="+" style="f"><char style="fr" closed="false">15:39 </char><char style="ft" closed="false">Funǝ yarechikǝn ndakndǝwa tiɗ kǝna mǝrta </char></note> ndakǝnwa: "Kitchitkǝn nifiya hweya Farǝ nakǝn!" <verse eid="MRK 15:39" /><verse number="40" style="v" sid="MRK 15:40" />Nishchǝsi thlarkǝ langnga naka nat kanda nishchǝkǝn nda Maryamu le ɓaka a Magdala, Maryamu man Yakubu le nak nguɗɗeh mǝ Yusufu<note caller="+" style="f"><char style="fr" closed="false">15:40 </char><char style="ft" closed="false">Greek cha yaru ndǝwa Josephwa yarak nduwa Joses</char></note>, tǝ Salomi. <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />Kandang kuwurkǝndǝ, naɗi natnda hachahai Galili, kwirndǝndǝ tǝpaɗ fǝrandǝ mwanda, tǝ yakat nishchi oiyu ɗǝfkǝndǝ kǝ Urshelimayu kanda mbǝnniyu.<verse eid="MRK 15:41" /></para>
  <para style="s">Thloh Yǝso</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mt 27:57-61</ref>; <ref loc="LUK 23:50-56">Lk 23:50-56</ref>; <ref loc="JHN 19:38-42">Yh 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />Sǝk farǝ hufta, ɓakna soktǝ kǝ farǝ tahasǝfa kǝthlǝm ishkichitkǝn farǝ yipta Yahudawecha, <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />Nifǝsi lǝ atfichǝwa Yusufu ɓakna hǝmǝt Armatiya, nakǝn ǝrta hur fichile lǝ fǝrandǝ fichǝ mwanda, lenaka pu mwanda Fara, sǝkǝn alchit hanɗǝkiketa ndǝkna mbǝnda Bilatus, sahaǝn murǝt Yǝso. <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />Pǝɗang ǝnatkǝn Bilatus fa ndu a teppa mirri, thlǝnkǝn kǝ angfichile nak mwachina hur fathǝrhwechǝkǝn, sahaǝn miya: "Tǝkit Yǝso teppa mirwa?" <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />Kǝ sǝktǝn kichu miya kapat fathlǝrhwechǝkǝn tǝ ndatwa teppa mirri, fǝraǝn murǝt fatkǝnna Yusufu. <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />Hiikǝ Yusufu njeli thlohmurta, tǝraǝn fata Yǝso haya, fwaɗaǝn tǝ njeli thlohmurundǝyu, ɗǝfkǝna hur kwata le retficha fa ngwiya. Pwatkǝn paplata ngǝlaǝn mi kwatkǝnsi. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />Maryamu le ɓaka a Magdala tǝ Maryamu man Yusufu neɗndǝ mbǝɗi hunandǝ ficha.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">Thlata Yǝso kwata</para>
  <para style="r">(<ref loc="MAT 28:1-8">Mt 28:1-8</ref>; <ref loc="LUK 24:1-12">Lk 24:1-12</ref>; <ref loc="JHN 20:1-10">Yh 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />Kǝ mbǝrkǝ farǝ yipta Yahundawechǝ hi, Maryamu le ɓaka a Magdala, tǝ Maryamu man Yakubu, tǝ Salomi, hiikǝndi fiɗeɗi nat satǝ'en mbinchinfa kǝthlem kǝ ɗǝnda pa'anda Yǝso fa. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />A farǝ Lati ɓingtǝ tung, kǝnat fara cheta pǝɗaknda mi kwatkǝn. <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />Nangnda ndandandani chiuwa: "Wun na pwatandǝ paplatkǝn engnǝmaɗa mi kwatkǝn?" <verse eid="MRK 16:3" /><verse number="4" style="v" sid="MRK 16:4" />Kǝ thla'andǝndǝ i'nda nak ndǝ paplatkǝn a teppa pwatafichaɗi nakǝn mwanchin. <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />Kǝnannda yimta hur kwatkǝn, nakndǝ hwankimsha'a ɗas tǝ harsǝmta, tǝ heɗɗi njela'a pǝɗang ǝnatkǝn kandǝfa. <verse eid="MRK 16:5" /><verse number="6" style="v" sid="MRK 16:6" />Ndangna kandǝwa mǝ pǝɗa ǝnkunifǝwa nuni kat Yǝso Lǝnazaratta, le kukkwandǝfichǝhi. A thle'i, mǝlansa mbǝnniyuwa, kǝlama mbǝɗi hunandǝficha. <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />Ɗama mbwa'amna kimshechi'en tǝ Bitrus, tǝndatwa nan lata Galili mǝ kandang, mbǝnniyu nuni nanndi nda i mbwa'a'ndǝnakuni." <verse eid="MRK 16:7" /><verse number="8" style="v" sid="MRK 16:8" />Nishchǝkǝn paɗ shekɗa'indǝ kanda kandǝ saktatfa Cheknda kish tǝ rahta, a hurkwatkǝn fechengnanda rǝptǝfa shekɗa'indǝ kandǝ ka'ǝn. Mbwa'aundǝ ǝna nifuwa kǝthlǝm kanda lechita.<verse eid="MRK 16:8" /></para>
  <para style="s">Yǝso Cheɗaɗǝ Fat'enna Maryamu Magdaliya</para>
  <para style="r">(<ref loc="JHN 20:11-18">Yh 20:11-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />
    <note caller="+" style="f">
      <char style="fr" closed="false">16:9 </char>
      <char style="ft" closed="false">A hura yerechi yaratfichǝ soh ngusuwa chekangficha</char>
    </note> [Kǝ thlattin tǝ shisshingta fa ɓingtǝ tung a farǝ Lati, tǝrkaakǝn ɓata mbǝs Maryamu le ɓaka a Magdala, nuhi rǝktǝ Yǝso lǝwurchǝ muɗa fet'en. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />Mǝlan paɗ ɗǝkna mbwa'anda fichile natndǝ tǝ Yǝso soh kana mǝrta ɗǝkna mbǝssandǝkanda sǝɓ hura tǝ paɗ kanda tita. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />Kǝ sǝktǝndǝwa Yǝso mǝllan tǝ shisshingta fa, tǝpaɗ neɗtǝndi, cherkǝnda fǝrkitsi. <verse eid="MRK 16:11" /><verse number="12" style="v" sid="MRK 16:12" />Ɗiffitǝ ndǝkǝn cheɗkǝn fat'enna mbǝnda funǝ chap hurnandǝ tǝ witǝ natsomǝn, kanda ɗar pǝɗata thlethǝmta. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />Nofchi chapyu ngǝrangndǝ'in ɓaknda mbwa'anda tahchikǝn, chika tǝkichu fǝrundǝ kitsi kǝ ɗar i mbutǝndǝwa.<verse eid="MRK 16:13" /></para>
  <para style="s">Cheɗɗa Yǝso Fat'enna Kimshechi'en Kumngǝrǝnsǝ Ərta</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mt 28:16-20</ref>; <ref loc="LUK 24:36-40">Lk 24:36-40</ref>; <ref loc="JHN 20:19-23">Yh 20:19-23</ref>; <ref loc="ACT 1:6-8">Tf 1:6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />Ɗiffitǝ ndǝkǝn ɓak Yǝso mbǝs kimshechi'en kumkǝngǝrǝnsǝ ǝrta shokndǝhi kanda sǝm ɗǝsǝmta, ɓokkangna kandǝhi kǝ ɗar ɓah fǝrkitchiɗeng nanda, tǝ kwaakwaachit hanɗǝkiketa, kǝthlem cherndǝ fǝrkitta ɗar fichile naknda a ɗiffitǝ thla'i'thlattǝn. <verse eid="MRK 16:14" /><verse number="15" style="v" sid="MRK 16:15" />Ndangna kandǝwa ɗama hur kishitǝ nat kǝ ɓassuni kwescha shunda kǝ mbǝɗa nofchǝ nat. <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />Uf nifi fǝrkǝkit sangfichǝ baptisma nan hǝrǝkta, paɗ le cherkǝ fǝrkit na ficha fǝra pwancha. <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />Na ficha nat sakǝt i'chiiya tǝ mbǝɗa fichile fǝrkǝkit: nanda chandǝ ɓǝɓi lǝwurchakissha hur thlemna, nanda shuwun yuwamichǝ somsomǝn, <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />Nanda harǝ huthlǝnchahar tǝ paɗ chika witǝ ɓǝɓi i'natma sandǝ ngu tamta sa ǝnkanduwa; nanda sa harcha nofcha in fichile nak hahchin nanda kǝndaɗi."<verse eid="MRK 16:18" /></para>
  <para style="s">Tǝra Fichǝ Yǝso kǝ Afchi</para>
  <para style="r">(<ref loc="LUK 24:50-53">Lk 24:50-53</ref>; <ref loc="ACT 1:9-11">Tf 1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />Ɗiffitǝ shuni shunandǝ Lǝmwandǝ Yǝso kanda, tǝrrang ficha afshi, sokkǝnna har sǝmta Fara. <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />Pǝɗak kimshechikǝnna nata ɓasǝ kwashchǝ shunda Fara chika ayi, Lǝmwanda nakna kǝsanda kandǝsi. Tǝ mbǝɗa ǝnnat sheka inchi nannda sǝtyu cheɗkǝnwa kweshcha shuni nannda ɓassǝyu ɓakna mbǝɗa Fara.]<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>