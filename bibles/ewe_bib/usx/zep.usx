<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ZEP" style="id">- Biblica® Open Ewe Contemporary Scriptures 2020</book>
  <para style="h">Zefania</para>
  <para style="toc1">Zefania ƒe agbalẽ</para>
  <para style="toc2">Zefania</para>
  <para style="toc3">Zef</para>
  <para style="mt1">Zefania</para>
  <para style="mt2">ƒe agbalẽ</para>
  <chapter number="1" style="c" sid="ZEP 1"/>
  <para style="p">
    <verse number="1" style="v" sid="ZEP 1:1"/>Esiae nye Yehowa ƒe nya si va na Zefania, Kusi ƒe vi. Kusi fofoe nye Hezekia, Hezekia fofoe nye Amaria, eye Amaria fofoe nye Gedalia. Gbedeasi la va le Yuda fia Yosia, Amon ƒe vi ŋɔli.<verse eid="ZEP 1:1"/></para>
  <para style="b"/>
  <para style="s1">Nuxɔxlɔ̃ amewo tso tsɔtsrɔ̃ si gbɔna la ŋuti</para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 1:2"/>“Makplɔ nu sia nu si</para>
  <para style="q2" vid="ZEP 1:2">le miaƒe anyigba dzi la ɖa ƒioƒioƒio.”</para>
  <para style="q2" vid="ZEP 1:2">Yehowae gblɔe.<verse eid="ZEP 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 1:3"/>“Matsrɔ̃ amewo kple lãwo siaa;</para>
  <para style="q2" vid="ZEP 1:3">Matsrɔ̃ dziƒoxeviwo</para>
  <para style="q2" vid="ZEP 1:3">kple lã siwo le atsiaƒu me la hã</para>
  <para style="q2" vid="ZEP 1:3">kple nu vɔ̃ɖi wɔlawo.”</para>
  <para style="b" vid="ZEP 1:3"/>
  <para style="q1" vid="ZEP 1:3">“Ne metsrɔ̃ amegbetɔwo katã</para>
  <para style="q2" vid="ZEP 1:3">le anyigba dzi,”</para>
  <para style="q2" vid="ZEP 1:3">Yehowae gblɔe.<verse eid="ZEP 1:3"/></para>
  <para style="s1">Nugbeɖoɖo ɖe Yuda ŋu</para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 1:4"/>“Mado nye asi ɖe Yuda</para>
  <para style="q2" vid="ZEP 1:4">kple ame siwo katã le Yerusalem la gbɔ.</para>
  <para style="q1" vid="ZEP 1:4">Maɖe nu siwo katã susɔ na Baal la ɖa le teƒe sia;</para>
  <para style="q2" vid="ZEP 1:4">maɖe trɔ̃nuawo kple nunɔla</para>
  <para style="q2" vid="ZEP 1:4">siwo gasubɔa trɔ̃ hã ƒe ŋkɔwo ɖa,<verse eid="ZEP 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 1:5"/>ame siwo dea ta agu le xɔwo tame hesubɔa dziƒoŋunuwo,</para>
  <para style="q2" vid="ZEP 1:5">hekpe ɖe ame siwo dea ta agu na Yehowa,</para>
  <para style="q2" vid="ZEP 1:5">gake wogakaa atam na Molek,<verse eid="ZEP 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 1:6"/>kple ame siwo trɔ le Yehowa yome,</para>
  <para style="q2" vid="ZEP 1:6">eye womedinɛ alo biaa eta sena o la siaa ŋu.”<verse eid="ZEP 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 1:7"/>Mizi ɖoɖoe le Aƒetɔ Yehowa ŋkume,</para>
  <para style="q2" vid="ZEP 1:7">elabena Yehowa ƒe ŋkeke la tu aƒe.</para>
  <para style="q1" vid="ZEP 1:7">Yehowa dzra vɔsa ɖo, eye wòkɔ ame</para>
  <para style="q2" vid="ZEP 1:7">siwo wòkpe la hã ŋuti.<verse eid="ZEP 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 1:8"/>“Le Yehowa ƒe vɔsagbea la,</para>
  <para style="q2" vid="ZEP 1:8">mahe to na Yuda ƒe dumegãwo kple fiaviŋutsuwo,</para>
  <para style="q1" vid="ZEP 1:8">kpakple ame siwo ta dutatɔwo ƒe avɔwo.<verse eid="ZEP 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 1:9"/>Le ŋkeke ma dzi la,</para>
  <para style="q2" vid="ZEP 1:9">mahe to na ame siwo katã tia kpo flɔa kpui</para>
  <para style="q1" vid="ZEP 1:9">siwo le trɔ̃xɔwo nu, eye woyɔa woƒe trɔ̃xɔwo me</para>
  <para style="q2" vid="ZEP 1:9">kple ŋutasesẽ kple beble.”<verse eid="ZEP 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 1:10"/>Yehowa be:</para>
  <para style="q1" vid="ZEP 1:10">“Le ŋkeke ma dzi la,</para>
  <para style="q2" vid="ZEP 1:10">avifafa aɖi tso Tɔmelãgbo la nu,</para>
  <para style="q1" vid="ZEP 1:10">asiƒunu aɖi tso dua ƒe akpa evelia,</para>
  <para style="q2" vid="ZEP 1:10">eye howɔwɔ gã aɖe aɖi tso togbɛwo dzi.<verse eid="ZEP 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 1:11"/>Mifa avi, mi ame siwo le asiɖoƒe ƒe nutowo me,</para>
  <para style="q2" vid="ZEP 1:11">miaƒe asitsalawo katã atsrɔ̃,</para>
  <para style="q2" vid="ZEP 1:11">eye ame siwo katã dzraa klosalonuwo la hã atsrɔ̃.<verse eid="ZEP 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 1:12"/>Le ɣe ma ɣi me la,</para>
  <para style="q2" vid="ZEP 1:12">masi akaɖi adi ɖekematsɔlemetɔwo</para>
  <para style="q1" vid="ZEP 1:12">le Yerusalem ahe to na wo,</para>
  <para style="q2" vid="ZEP 1:12">ame siwo le abe wain ƒe aƒe ene,</para>
  <para style="q1" vid="ZEP 1:12">eye wogblɔ le woƒe dzi me be,</para>
  <para style="q2" vid="ZEP 1:12">‘Yehowa mawɔ naneke mí,</para>
  <para style="q2" vid="ZEP 1:12">eɖanye nyui alo vɔ̃ o.’<verse eid="ZEP 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 1:13"/>Woava ha woƒe kesinɔnu gbogboawo adzoe,</para>
  <para style="q2" vid="ZEP 1:13">woagbã woƒe aƒewo,</para>
  <para style="q1" vid="ZEP 1:13">woatso aƒewo, ke womanɔ wo me o,</para>
  <para style="q2" vid="ZEP 1:13">woade waingblewo, ke womano wain tso wo me o.”<verse eid="ZEP 1:13"/></para>
  <para style="s1">Yehowa ƒe ŋkeke gã la</para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 1:14"/>Yehowa ƒe ŋkeke ma tu aƒe vɔ,</para>
  <para style="q2" vid="ZEP 1:14">egbɔna kpuie.</para>
  <para style="q1" vid="ZEP 1:14">Miɖo to,</para>
  <para style="q2" vid="ZEP 1:14">le Yehowa ƒe ŋkeke ma dzi la,</para>
  <para style="q1" vid="ZEP 1:14">woado ɣli kple vevesese,</para>
  <para style="q2" vid="ZEP 1:14">aʋawɔlawo ƒe ɣlidodo ade dzi le afi ma.<verse eid="ZEP 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 1:15"/>Anye ŋkeke si dzi woatrɔ Mawu ƒe dɔmedzoe akɔ ɖe anyi;</para>
  <para style="q2" vid="ZEP 1:15">anye hiãgbe kple xaxagbe,</para>
  <para style="q2" vid="ZEP 1:15">anye dzɔgbevɔ̃e kple tsɔtsrɔ̃gbe.</para>
  <para style="q1" vid="ZEP 1:15">Ŋkeke sia anye blukɔ kple vivitidogbe,</para>
  <para style="q2" vid="ZEP 1:15">afu kple tsizidogbe,<verse eid="ZEP 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ZEP 1:16"/>Anye aʋakpẽkugbe kple aʋaɣlidogbe,</para>
  <para style="q2" vid="ZEP 1:16">ɖe du siwo woɖo gli sesẽwo ƒo xlãe</para>
  <para style="q1" vid="ZEP 1:16">kple gbetakpɔxɔ siwo le dzogoe dzi ŋu.<verse eid="ZEP 1:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 1:17"/>“Mahe xaxa va ameawo dzi,</para>
  <para style="q2" vid="ZEP 1:17">eye woazɔ abe ŋkugbagbãtɔwo ene,</para>
  <para style="q2" vid="ZEP 1:17">elabena woda vo ɖe Yehowa ŋu.</para>
  <para style="q1" vid="ZEP 1:17">Woƒe ʋu akɔ ɖi abe ʋuʋudedi ene,</para>
  <para style="q2" vid="ZEP 1:17">eye woƒe dɔmenuwo akaka abe gbeɖuɖɔ ene.<verse eid="ZEP 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 1:18"/>Le Yehowa ƒe dɔmedzoeŋkeke sia dzi la,</para>
  <para style="q2" vid="ZEP 1:18">woƒe klosalo alo sika</para>
  <para style="q2" vid="ZEP 1:18">mate ŋu aɖe wo o.”</para>
  <para style="b" vid="ZEP 1:18"/>
  <para style="q1" vid="ZEP 1:18">Yehowa ƒe ŋuʋaʋã ƒe dzo</para>
  <para style="q2" vid="ZEP 1:18">afia xexea me katã,</para>
  <para style="q1" vid="ZEP 1:18">elabena atsrɔ̃ ame siwo katã</para>
  <para style="q2" vid="ZEP 1:18">le anyigba dzi la kpata.<verse eid="ZEP 1:18"/></para>
  <para style="b"/>
  <chapter eid="ZEP 1"/>
  <chapter number="2" style="c" sid="ZEP 2"/>
  <para style="q1">
    <verse number="1" style="v" sid="ZEP 2:1"/>Miƒo ƒu! Miƒo ƒu!</para>
  <para style="q2" vid="ZEP 2:1">O, dukɔ si ŋu mekpena o,<verse eid="ZEP 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 2:2"/>hafi ɣeyiɣi si woɖo ɖi la naɖo,</para>
  <para style="q2" vid="ZEP 2:2">eye ŋkeke ma nava gbɔ mi abe atsa ene,</para>
  <para style="q1" vid="ZEP 2:2">hafi Yehowa ƒe dziku dziŋɔ la nava dziwò,</para>
  <para style="q2" vid="ZEP 2:2">hafi Yehowa ƒe dɔmedzoeŋkeke la nava dziwò.<verse eid="ZEP 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 2:3"/>Midi Yehowa,</para>
  <para style="q2" vid="ZEP 2:3">mi anyigbadzitɔ siwo katã bɔbɔ mia ɖokui,</para>
  <para style="q2" vid="ZEP 2:3">mi ame siwo wɔa eƒe lɔlɔ̃nu.</para>
  <para style="q1" vid="ZEP 2:3">Midi dzɔdzɔenyenye, midi ɖokuibɔbɔ;</para>
  <para style="q2" vid="ZEP 2:3">ɖewohĩ woatsyɔ nu mia dzi</para>
  <para style="q2" vid="ZEP 2:3">le Yehowa ƒe dzikuŋkeke la dzi.<verse eid="ZEP 2:3"/></para>
  <para style="s1">Nugbeɖoɖo ɖe Filistitɔwo ŋu</para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 2:4"/>Gaza azu aƒedo,</para>
  <para style="q2" vid="ZEP 2:4">eye Askelon azu gli gbagbã.</para>
  <para style="q1" vid="ZEP 2:4">Le ŋdɔkutsu me woalɔ Asdod ƒioƒioƒio,</para>
  <para style="q2" vid="ZEP 2:4">eye woaho Ekron kple ke.<verse eid="ZEP 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 2:5"/>Baba na mi Keretitɔwo,</para>
  <para style="q2" vid="ZEP 2:5">mi ame siwo le ƒuta;</para>
  <para style="q1" vid="ZEP 2:5">O Kanaan, Filistitɔwo ƒe anyigba, Yehowa tsɔ nya ɖe mia ŋu be,</para>
  <para style="q2" vid="ZEP 2:5">“Matsrɔ̃ mi keŋkeŋkeŋ, eye ame aɖeke masusɔ o.”<verse eid="ZEP 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 2:6"/>Keretitɔwo ƒe nɔƒe si le ƒuta la,</para>
  <para style="q2" vid="ZEP 2:6">azu alẽkpo kple nɔƒe na alẽkplɔlawo.<verse eid="ZEP 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 2:7"/>Anye ame mamlɛ siwo susɔ na Yuda ƒe aƒe la tɔ,</para>
  <para style="q2" vid="ZEP 2:7">afi mae woakpɔ lãnyiƒe le.</para>
  <para style="q1" vid="ZEP 2:7">Le fiẽ me la, woamlɔ Askelontɔwo ƒe aƒewo me.</para>
  <para style="q2" vid="ZEP 2:7">Yehowa, woƒe Mawu la</para>
  <para style="q2" vid="ZEP 2:7">akpɔ wo ta, eye wòagaɖo wo te.<verse eid="ZEP 2:7"/></para>
  <para style="s1">Nugbeɖoɖo ɖe Moab kple Amon ŋu</para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 2:8"/>“Mese Moab ƒe alɔmeɖeɖe</para>
  <para style="q2" vid="ZEP 2:8">kple Amon ƒe viwo ƒe vlododo,</para>
  <para style="q1" vid="ZEP 2:8">ame siwo dzi nye dukɔ,</para>
  <para style="q2" vid="ZEP 2:8">eye woɖo nugbe ɖe woƒe anyigba ŋuti.<verse eid="ZEP 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 2:9"/>Yehowa Ŋusẽkatãtɔ, Israel ƒe Mawu la gblɔ be,</para>
  <para style="q2" vid="ZEP 2:9">Zi ale si meli la, woatsrɔ̃ Moab kple Amon</para>
  <para style="q1" vid="ZEP 2:9">abe ale si wotsrɔ̃ Sodom kple Gomora ene,</para>
  <para style="q2" vid="ZEP 2:9">eye woazu ŋuvedzeɖeƒe kple gbegbe;</para>
  <para style="q1" vid="ZEP 2:9">nye ame siwo susɔ la aha wo,</para>
  <para style="q2" vid="ZEP 2:9">eye woaxɔe le wo si.”<verse eid="ZEP 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 2:10"/>Woaxɔ woƒe dada ƒe fetu,</para>
  <para style="q2" vid="ZEP 2:10">elabena woɖu fewu le Yehowa,</para>
  <para style="q2" vid="ZEP 2:10">Dziƒoʋakɔwo ƒe Aƒetɔ la ƒe dukɔ ŋuti.<verse eid="ZEP 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 2:11"/>Yehowa ana nu vɔ̃ɖi geɖe nava wo dzi.</para>
  <para style="q2" vid="ZEP 2:11">Atsrɔ̃ woƒe mawuwo katã</para>
  <para style="q1" vid="ZEP 2:11">kple woƒe ŋusẽ ɖa, eye ame sia ame asubɔe le</para>
  <para style="q2" vid="ZEP 2:11">eƒe anyigba dzi le xexea me godoo.<verse eid="ZEP 2:11"/></para>
  <para style="s1">Nugbeɖoɖo ɖe Kus ŋu</para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 2:12"/>“Mi Kustɔwo,</para>
  <para style="q2" vid="ZEP 2:12">woatsrɔ̃ miawo hã kple yi.”<verse eid="ZEP 2:12"/></para>
  <para style="s1">Nugbeɖoɖo ɖe Asiria ŋu</para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 2:13"/>Nenema kee nye anyiehetɔwo hã;</para>
  <para style="q2" vid="ZEP 2:13">atsrɔ̃ Asiria kple eƒe toxɔdu Ninive xɔŋkɔ la gbidigbidi,</para>
  <para style="q2" vid="ZEP 2:13">eye wòanɔ abe dzogbe ene.<verse eid="ZEP 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 2:14"/>Du xɔŋkɔ sia azu gbeɖuƒe na alẽhawo.</para>
  <para style="q2" vid="ZEP 2:14">Gbemelã kple xe vovovowo atsɔ teƒe sia awɔ wo nɔƒee.</para>
  <para style="q1" vid="ZEP 2:14">Hlɔ̃madewo aɖe do ɖe afi ma,</para>
  <para style="q2" vid="ZEP 2:14">akagawo kple alugewo awɔ atɔ ɖe eƒe fiasãwo me,</para>
  <para style="q1" vid="ZEP 2:14">eye woadzo ɖe eƒe fesrewo nu anɔ xɔxlɔ̃m;</para>
  <para style="q2" vid="ZEP 2:14">eye akpaviãwo adzo ɖe fiasã la ƒe ʋɔtruwo nu.</para>
  <para style="q1" vid="ZEP 2:14">Mlɔeba la, ʋuƒo nyui</para>
  <para style="q2" vid="ZEP 2:14">siwo wotsɔ wɔ xɔa mee la atsi gota ŋdɔ naɖu.<verse eid="ZEP 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 2:15"/>Esiawoe nye nu siwo ava dzɔ ɖe du si kpɔ dzidzedze,</para>
  <para style="q2" vid="ZEP 2:15">eye wòle tomefafa me la dzi.</para>
  <para style="q1" vid="ZEP 2:15">Du sia gblɔ na eɖokui be,</para>
  <para style="q2" vid="ZEP 2:15">“Le xexea me katã la,</para>
  <para style="q2" vid="ZEP 2:15">du aɖeke mekpɔ ŋusẽ de nunye o.”</para>
  <para style="q1" vid="ZEP 2:15">Gake azɔ, mikpɔ ɖa,</para>
  <para style="q2" vid="ZEP 2:15">eyae nye du si gbã gudugudu,</para>
  <para style="q2" vid="ZEP 2:15">zu gbegbe na lãwo kple xewo!</para>
  <para style="q1" vid="ZEP 2:15">Azɔ ame sia ame si ava to eŋuti la ado tsiã,</para>
  <para style="q2" vid="ZEP 2:15">aʋuʋu ta, elabena maxɔe ase o.<verse eid="ZEP 2:15"/></para>
  <chapter eid="ZEP 2"/>
  <chapter number="3" style="c" sid="ZEP 3"/>
  <para style="s2">Nya siwo ava dzɔ ɖe Yerusalem dzi</para>
  <para style="q1">
    <verse number="1" style="v" sid="ZEP 3:1"/>“Baba na du si yɔ fũu kple ŋutasesẽ,</para>
  <para style="q2" vid="ZEP 3:1">aglãdzedze kple ɖiƒoƒo.<verse eid="ZEP 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 3:2"/>Mesea ame aɖeke ƒe gbe o,</para>
  <para style="q2" vid="ZEP 3:2">eye melɔ̃na be woagbe nya na ye hã o.</para>
  <para style="q1" vid="ZEP 3:2">Mexɔ Yehowa dzi se o,</para>
  <para style="q2" vid="ZEP 3:2">eye metena ɖe eƒe Mawu la ŋu hã o.<verse eid="ZEP 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 3:3"/>Eƒe kplɔlawo le abe dzata</para>
  <para style="q2" vid="ZEP 3:3">dɔwui si le gbe tem la ene.</para>
  <para style="q1" vid="ZEP 3:3">Woƒe ʋɔnudrɔ̃lawo le abe amegaxi si lé nu</para>
  <para style="q2" vid="ZEP 3:3">le zã me, eye wòɖui vɔ keŋ hafi ŋu ke la ene.<verse eid="ZEP 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 3:4"/>Eƒe nyagblɔɖilawo doa wo ɖokuiwo ɖe dzi,</para>
  <para style="q2" vid="ZEP 3:4">eye wonye ame vɔ̃ɖiwo.</para>
  <para style="q1" vid="ZEP 3:4">Eƒe nunɔlawo do gu kɔkɔeƒe la,</para>
  <para style="q2" vid="ZEP 3:4">eye wodo vlo Mawu ƒe seawo.<verse eid="ZEP 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 3:5"/>Ke Yehowae nye dzɔdzɔetɔ le wo dome,</para>
  <para style="q2" vid="ZEP 3:5">eye mewɔa nu gbegblẽ aɖeke o.</para>
  <para style="q1" vid="ZEP 3:5">Ŋdi sia ŋdi la,</para>
  <para style="q2" vid="ZEP 3:5">eɖea eƒe dzɔdzɔenyenye ɖe go,</para>
  <para style="q1" vid="ZEP 3:5">eye ŋkeke aɖeke medanɛ ƒu o.</para>
  <para style="q2" vid="ZEP 3:5">Gake nu vɔ̃ wɔlawo menya ŋukpe o.<verse eid="ZEP 3:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 3:6"/>“Metsrɔ̃ dukɔ geɖewo,</para>
  <para style="q2" vid="ZEP 3:6">megbã woƒe mɔ sesẽwo,</para>
  <para style="q1" vid="ZEP 3:6">mena woƒe ablɔwo dzi ɖi gbɔlo,</para>
  <para style="q2" vid="ZEP 3:6">eye ame aɖeke megatoa wo dzi o.</para>
  <para style="q1" vid="ZEP 3:6">Woƒe duwo gbã,</para>
  <para style="q2" vid="ZEP 3:6">eye ame ɖeka pɛ gɔ̃ hã masusɔ o.<verse eid="ZEP 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 3:7"/>Megblɔ na du la be,</para>
  <para style="q2" vid="ZEP 3:7">‘Azɔ la, àvɔ̃m vavã, eye nàxɔ nye ɖɔɖɔɖo!’</para>
  <para style="q1" vid="ZEP 3:7">Ekema womagatsrɔ̃ eƒe nɔƒe</para>
  <para style="q2" vid="ZEP 3:7">alo nye tohehe magava edzi o,</para>
  <para style="q2" vid="ZEP 3:7">gake wogatsi dzi ɖe nu vɔ̃ wɔwɔ ŋu,<verse eid="ZEP 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 3:8"/>eya ta mikpɔ nye asi nu,”</para>
  <para style="q2" vid="ZEP 3:8">Yehowae gblɔe,</para>
  <para style="q1" vid="ZEP 3:8">“elabena ŋkeke li gbɔna,</para>
  <para style="q2" vid="ZEP 3:8">matsi tsitre aɖi ɖase.</para>
  <para style="q1" vid="ZEP 3:8">Meɖoe be maƒo dukɔwo katã</para>
  <para style="q2" vid="ZEP 3:8">kple fiaɖuƒewo nu ƒu,</para>
  <para style="q1" vid="ZEP 3:8">eye makɔ nye dɔmedzoe</para>
  <para style="q2" vid="ZEP 3:8">kple nye dziku helĩhelĩ ɖe wo dzi.</para>
  <para style="q1" vid="ZEP 3:8">Ale nye ŋuʋaʋã ƒe dzo afia anyigba la katã.<verse eid="ZEP 3:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 3:9"/>“Ɣe ma ɣi la, makɔ nye amewo ƒe nuyiwo ŋu,</para>
  <para style="q2" vid="ZEP 3:9">ale wo katã woayɔ Yehowa ƒe ŋkɔ,</para>
  <para style="q2" vid="ZEP 3:9">eye woasubɔe kple nusɔsɔe.<verse eid="ZEP 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 3:10"/>Tso Kus tɔsisi la godo ke, nye subɔlawo</para>
  <para style="q2" vid="ZEP 3:10">kple nye ame siwo ka hlẽ la,</para>
  <para style="q2" vid="ZEP 3:10">atsɔ woƒe nunanawo vɛ nam.<verse eid="ZEP 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 3:11"/>Le ɣe ma ɣi la,</para>
  <para style="q2" vid="ZEP 3:11">ŋu magakpe mi le miaƒe nu vɔ̃</para>
  <para style="q1" vid="ZEP 3:11">siwo katã miewɔ ɖe ŋunye la ta o,</para>
  <para style="q2" vid="ZEP 3:11">elabena maɖe ame siwo katã kpɔa</para>
  <para style="q1" vid="ZEP 3:11">dzidzɔ le ɖokuidodoɖedzi ŋuti la ɖa</para>
  <para style="q2" vid="ZEP 3:11">le dua me, ale be dadala</para>
  <para style="q2" vid="ZEP 3:11">aɖeke maganɔ nye to kɔkɔe la dzi o.<verse eid="ZEP 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 3:12"/>Ke magblẽ ame siwo nye ame fafawo</para>
  <para style="q2" vid="ZEP 3:12">kple ɖokuibɔbɔɖeanyilawo,</para>
  <para style="q1" vid="ZEP 3:12">ame siwo xɔ nye, Yehowa</para>
  <para style="q2" vid="ZEP 3:12">ƒe ŋkɔ dzi se la ɖe mia dome.<verse eid="ZEP 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 3:13"/>Israel ƒe ame mamlɛawo magawɔ vɔ̃ o,</para>
  <para style="q2" vid="ZEP 3:13">womada alakpa o,</para>
  <para style="q1" vid="ZEP 3:13">eye womakpɔ amebeble le woƒe nu me o.</para>
  <para style="q2" vid="ZEP 3:13">Woaɖu nu, amlɔ anyi,</para>
  <para style="q2" vid="ZEP 3:13">eye ame aɖeke mado ŋɔdzi na wo o.”<verse eid="ZEP 3:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 3:14"/>O Zion vinyɔnu, dzi ha, O Israel, do ɣli,</para>
  <para style="q2" vid="ZEP 3:14">kpɔ dzidzɔ, eye wò dzi nayɔ fũu kple aseyetsotso,</para>
  <para style="q2" vid="ZEP 3:14">O Yerusalem vinyɔnuvi!<verse eid="ZEP 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 3:15"/>Yehowa ɖe wò tohehewo ɖa,</para>
  <para style="q2" vid="ZEP 3:15">eye wòna wò futɔwo gbugbɔɖemegbe.</para>
  <para style="q1" vid="ZEP 3:15">Yehowa, Israel ƒe fia la</para>
  <para style="q2" vid="ZEP 3:15">li kpli wò, eya ta vɔ̃wɔame</para>
  <para style="q2" vid="ZEP 3:15">aɖeke mado ŋɔdzi na wò o.<verse eid="ZEP 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ZEP 3:16"/>Gbe ma gbe la,</para>
  <para style="q2" vid="ZEP 3:16">woagblɔ na Yerusalem be,</para>
  <para style="q1" vid="ZEP 3:16">“Mègavɔ̃ o, O Zion,</para>
  <para style="q2" vid="ZEP 3:16">eye mègana wò alɔ nagbɔdzɔ o.<verse eid="ZEP 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 3:17"/>Yehowa wò Mawu la li kpli wò,</para>
  <para style="q2" vid="ZEP 3:17">kalẽtɔ si ate ŋu axɔ na wò lae wònye.</para>
  <para style="q1" vid="ZEP 3:17">Akpɔ dzidzɔ gã aɖe ɖe ŋuwò,</para>
  <para style="q2" vid="ZEP 3:17">atsɔ eƒe lɔlɔ̃ afa akɔ na wò,</para>
  <para style="q2" vid="ZEP 3:17">eye wòado dzidzɔ na wò kple hadzidzi.”<verse eid="ZEP 3:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 3:18"/>“Maɖe konyifafa siwo nɔa miaƒe takpegbewo la ɖa le mia ŋu,</para>
  <para style="q2" vid="ZEP 3:18">elabena wonyea agba kple mokaka na mi.<verse eid="ZEP 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ZEP 3:19"/>Le ɣe ma ɣi la, matu nu</para>
  <para style="q2" vid="ZEP 3:19">kple ame siwo katã te mi ɖe anyi la,</para>
  <para style="q1" vid="ZEP 3:19">makpe ɖe ataŋeŋetɔwo ŋu,</para>
  <para style="q2" vid="ZEP 3:19">eye maƒo ame siwo ka hlẽ la nu ƒu.</para>
  <para style="q1" vid="ZEP 3:19">Matsɔ kafukafu kple bubu ana wo</para>
  <para style="q2" vid="ZEP 3:19">le anyigba ɖe sia ɖe si dzi wodo ŋukpe wo le.<verse eid="ZEP 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ZEP 3:20"/>Ɣe ma yi la, maƒo mia nu ƒu;</para>
  <para style="q2" vid="ZEP 3:20">ɣe ma yi me la, makplɔ mi va aƒee.</para>
  <para style="q1" vid="ZEP 3:20">Matsɔ bubu kple kafukafu ana mi le</para>
  <para style="q2" vid="ZEP 3:20">anyigbadzidukɔwo katã dome,</para>
  <para style="q1" vid="ZEP 3:20">nenye be megbugbɔ mi ɖo te le</para>
  <para style="q2" vid="ZEP 3:20">miawo ŋutɔ ƒe ŋkuwo me.”</para>
  <para style="q2" vid="ZEP 3:20">Yehowae gblɔe.<verse eid="ZEP 3:20"/></para>
  <chapter eid="ZEP 3"/>
</usx>
