<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="NAM" style="id">- Biblica® Open Ewe Contemporary Scriptures 2020</book>
  <para style="h">Nahum</para>
  <para style="toc1">Nahum ƒe agbalẽ</para>
  <para style="toc2">Nahum</para>
  <para style="toc3">Nah</para>
  <para style="mt1">Nahum</para>
  <para style="mt2">ƒe agbalẽ</para>
  <chapter number="1" style="c" sid="NAM 1"/>
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1"/>Esiae nye nyagblɔɖi si Mawu ɖe fia Nyagblɔɖila Nahum, Elkositɔ, le ŋutega me tso nu si ava dzɔ ɖe Ninive dzi la ŋu, eye wòŋlɔe ɖe agbalẽ sia me.<verse eid="NAM 1:1"/></para>
  <para style="b"/>
  <para style="s1">Yehowa do dɔmedzoe ɖe Ninive ŋu</para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 1:2"/>Yehowa nye Mawu ʋãŋu kple hlɔ̃biala.</para>
  <para style="q2" vid="NAM 1:2">Ebiaa hlɔ̃, eye wòyɔ fũu kple dɔmedzoe.</para>
  <para style="q1" vid="NAM 1:2">Yehowa biaa hlɔ̃ eƒe ketɔwo,</para>
  <para style="q2" vid="NAM 1:2">eye wòléa dziku ɖi na eƒe futɔwo.<verse eid="NAM 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 1:3"/>Yehowa medoa dziku kaɖikaɖi o,</para>
  <para style="q2" vid="NAM 1:3">ŋusẽ triakɔ le esi, eye magbe tohehe na agɔdzela o.</para>
  <para style="q1" vid="NAM 1:3">Eƒe mɔwo to ahom kple ya sẽsewo me,</para>
  <para style="q2" vid="NAM 1:3">eye lilikpowoe nye eƒe afɔ ƒe ʋuʋudedi.<verse eid="NAM 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 1:4"/>Eblu ɖe atsiaƒu ta wòmie,</para>
  <para style="q2" vid="NAM 1:4">eye wòna tɔsisiwo me ƒu kplakplakpla.</para>
  <para style="q1" vid="NAM 1:4">Basan kple Karmel ƒe lãnyiƒe damawo zu gbegbe,</para>
  <para style="q2" vid="NAM 1:4">eye Lebanon ƒe ave damawo zu dzogbe.<verse eid="NAM 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 1:5"/>Towo ʋuʋu kpekpekpe,</para>
  <para style="q2" vid="NAM 1:5">eye togbɛwo lolõ gbanaa le eŋkume,</para>
  <para style="q1" vid="NAM 1:5">anyigba kple edzinɔlawo katã ʋuʋu le eŋkume.<verse eid="NAM 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 1:6"/>Ame ka ate ŋu anɔ te ɖe eƒe dziku nu?</para>
  <para style="q2" vid="NAM 1:6">Ame ka ate ŋu anɔ te ɖe eƒe</para>
  <para style="q2" vid="NAM 1:6">dɔmedzoe helĩhelĩ la nu?</para>
  <para style="q1" vid="NAM 1:6">Ekɔ eƒe dɔmedzoe ɖe anyi abe dzo ene,</para>
  <para style="q2" vid="NAM 1:6">eye agakpewo kaka le eŋkume.<verse eid="NAM 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 1:7"/>Yehowa nyo, elabena enye sitsoƒe le xaxa me!</para>
  <para style="q2" vid="NAM 1:7">Eléa be na ame si xɔa edzi sena.<verse eid="NAM 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 1:8"/>Ke atsrɔ̃ Ninive kple tɔɖɔɖɔ,</para>
  <para style="q2" vid="NAM 1:8">eye wòanya eƒe futɔwo aɖo ɖe viviti me.<verse eid="NAM 1:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 1:9"/>Nugbe ɖe sia ɖe si woɖo ɖe Yehowa ŋu la,</para>
  <para style="q2" vid="NAM 1:9">mana wòadze edzi o,</para>
  <para style="q2" vid="NAM 1:9">ke boŋ gbegblẽ mava na wo zi evelia o.<verse eid="NAM 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 1:10"/>Woabla wo ɖe ŋuve me,</para>
  <para style="q2" vid="NAM 1:10">woano woawo ŋutɔ ƒe wain amu,</para>
  <para style="q2" vid="NAM 1:10">eye woabi abe gbe ƒuƒu ene.<verse eid="NAM 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 1:11"/>O Ninive, mewòe ame si ɖo nugbe ɖe Yehowa ŋu,</para>
  <para style="q2" vid="NAM 1:11">eye wòɖo aɖaŋu vlo na amewo la do tso.<verse eid="NAM 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NAM 1:12"/>Ale Yehowa gblɔe nye esi:</para>
  <para style="q1" vid="NAM 1:12">“Togbɔ be wosɔ gbɔ,</para>
  <para style="q2" vid="NAM 1:12">eye kpeɖeŋutɔwo le wo si hã la,</para>
  <para style="q2" vid="NAM 1:12">wo katã woatsrɔ̃, eye wo nu ava ayi.</para>
  <para style="q1" vid="NAM 1:12">O Yuda, togbɔ be mede abi ŋuwò hã la,</para>
  <para style="q2" vid="NAM 1:12">nyemagade abi ŋuwò azɔ o.<verse eid="NAM 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 1:13"/>Azɔ la, maŋe kɔkuti le wò kɔ,</para>
  <para style="q2" vid="NAM 1:13">eye matu ka wò tso bablawo me.”<verse eid="NAM 1:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="NAM 1:14"/>Yehowa de se tso wò Ninive ŋuti be:</para>
  <para style="q2" vid="NAM 1:14">“Womayɔ wò ŋkɔ ɖe dzidzime aɖeke ŋuti o.</para>
  <para style="q2" vid="NAM 1:14">Mafli miaƒe aklamakpakpɛwo,</para>
  <para style="q1" vid="NAM 1:14">eye magbã legba siwo mieli ɖe miaƒe</para>
  <para style="q2" vid="NAM 1:14">mawuwo ƒe gbedoxɔ me.</para>
  <para style="q1" vid="NAM 1:14">Maɖe yɔdo na mi,</para>
  <para style="q2" vid="NAM 1:14">elabena mieganyo na naneke o.”<verse eid="NAM 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 1:15"/>Kpɔ ɖa, dɔlawo tso towo dzi gbɔna</para>
  <para style="q2" vid="NAM 1:15">kple nya nyui,</para>
  <para style="q2" vid="NAM 1:15">eye wole gbeƒã ɖem ŋutifafa!</para>
  <para style="q1" vid="NAM 1:15">O Yuda, ɖu wò ŋkekenyuiwo,</para>
  <para style="q2" vid="NAM 1:15">eye nàxe wò adzɔgbeɖefewo.</para>
  <para style="q1" vid="NAM 1:15">Ame vɔ̃ɖiwo magava aha wò azɔ o,</para>
  <para style="q2" vid="NAM 1:15">elabena woatsrɔ̃ wo keŋkeŋ.<verse eid="NAM 1:15"/></para>
  <chapter eid="NAM 1"/>
  <chapter number="2" style="c" sid="NAM 2"/>
  <para style="s1">Wogbã Ninive</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 2:1"/>Ninive, futɔwo ƒe asrafowo ƒo ɖe dziwò vɔ.</para>
  <para style="q2" vid="NAM 2:1">Kpɔ wò mɔ sẽsewo ta.</para>
  <para style="q2" vid="NAM 2:1">Wò ŋkuwo nenɔ mɔ la ŋu.</para>
  <para style="q2" vid="NAM 2:1">Mibla ali dzi sesĩe</para>
  <para style="q2" vid="NAM 2:1">eye miƒo aʋawɔlawo nu ƒu.<verse eid="NAM 2:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 2:2"/>Yehowa agbugbɔ Yakob ƒe atsyɔ̃ nɛ,</para>
  <para style="q2" vid="NAM 2:2">eye wòanɔ abe Israel tɔ ene.</para>
  <para style="q1" vid="NAM 2:2">Togbɔ be futɔwo gblẽ wò,</para>
  <para style="q2" vid="NAM 2:2">Yakob ƒe anyigba,</para>
  <para style="q2" vid="NAM 2:2">eye woha wò waingblewo hã.<verse eid="NAM 2:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 2:3"/>Futɔwo ƒe asrafowo ƒe akpoxɔnu biã dzẽe,</para>
  <para style="q2" vid="NAM 2:3">eye wodo awu dzĩ.</para>
  <para style="q1" vid="NAM 2:3">Tasiaɖamŋugawo le dzo dam gbe si gbe</para>
  <para style="q2" vid="NAM 2:3">wobla akpa na aʋawɔwɔ,</para>
  <para style="q2" vid="NAM 2:3">eye kalẽtɔwo le woƒe akplɔwo nyem le yame.<verse eid="NAM 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 2:4"/>Tasiaɖamwo le zi nyem le mɔtatawo dzi,</para>
  <para style="q2" vid="NAM 2:4">eye wole du ƒum le ablɔwo me le yiyim le gbɔgbɔm.</para>
  <para style="q1" vid="NAM 2:4">Woƒe dzedzeme le abe akakatiwo ene,</para>
  <para style="q2" vid="NAM 2:4">eye wole dzo kem abe dzikedzo ene.<verse eid="NAM 2:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 2:5"/>Fia la ado ɣli ayɔ eƒe aʋafiawo;</para>
  <para style="q2" vid="NAM 2:5">woanɔ du dzi anɔ anyi dzem,</para>
  <para style="q1" vid="NAM 2:5">anɔ fɔfɔm be yewoayi aɖaɖo gli sesẽwo,</para>
  <para style="q2" vid="NAM 2:5">ale be futɔwo mate ŋu akpɔ mɔ ava o.<verse eid="NAM 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 2:6"/>Agbo si le tɔsisi la nu la aʋu siaa,</para>
  <para style="q2" vid="NAM 2:6">eye fiasã la ƒe gliwo anye kpo, amu adze anyi.<verse eid="NAM 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 2:7"/>Woɖe gbe be woaɖe aboyo dua me tɔwo.</para>
  <para style="q2" vid="NAM 2:7">Eƒe kosiviwo anɔ xɔxlɔ̃m abe ahɔnɛ ene,</para>
  <para style="q2" vid="NAM 2:7">eye woanɔ akɔta ƒom.<verse eid="NAM 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 2:8"/>Ninive le abe ta si ƒe tsi le sisim ene.</para>
  <para style="q2" vid="NAM 2:8">Ne woado ɣli be:</para>
  <para style="q1" vid="NAM 2:8">“Mitɔ, mitɔ,”</para>
  <para style="q2" vid="NAM 2:8">la, ame aɖeke manye kɔ akpɔ megbe o.<verse eid="NAM 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 2:9"/>Miha klosalowo!</para>
  <para style="q2" vid="NAM 2:9">Mìha sika!</para>
  <para style="q1" vid="NAM 2:9">Kesinɔnuwo sɔ gbɔ fũu,</para>
  <para style="q2" vid="NAM 2:9">xexlẽme meli na nu xɔasi siawo o.<verse eid="NAM 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 2:10"/>Woɖi gbɔlo dua keŋkeŋ,</para>
  <para style="q2" vid="NAM 2:10">wohae eye woɖe amae.</para>
  <para style="q1" vid="NAM 2:10">Amewo ƒe dzi gbã, klowo le ƒoƒom kpakpakpa,</para>
  <para style="q2" vid="NAM 2:10">ameti blibo la le dzodzom nyanyanya,</para>
  <para style="q2" vid="NAM 2:10">eye ŋkume sia ŋkume afu tititi.<verse eid="NAM 2:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 2:11"/>Afi ka dzatawo ƒe do la le azɔ?</para>
  <para style="q2" vid="NAM 2:11">Afi si wonyia dzataviwo le,</para>
  <para style="q1" vid="NAM 2:11">afi si dzatatsu kple dzatanɔ</para>
  <para style="q2" vid="NAM 2:11">kple dzatavi ɖia tsa le vɔvɔ̃manɔmee ɖe?<verse eid="NAM 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 2:12"/>Dzatatsu léa nu si ade viawo kple dzatanɔ nu;</para>
  <para style="q2" vid="NAM 2:12">etsɔa nuléleawo yɔa eƒe mlɔƒe kple eƒe dowo me fũu.<verse eid="NAM 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 2:13"/>Yehowa, Dziƒoʋakɔwo ƒe Aƒetɔ la gblɔ be:</para>
  <para style="q1" vid="NAM 2:13">“Metso ɖe ŋuwò;</para>
  <para style="q2" vid="NAM 2:13">matɔ dzo wò tasiaɖamwo,</para>
  <para style="q2" vid="NAM 2:13">eye wò dzataviwo atsi yi nu.</para>
  <para style="q1" vid="NAM 2:13">Nyemagblẽ ame aɖeke ɖe anyigba dzi nàgada adzoe o,</para>
  <para style="q2" vid="NAM 2:13">eye womagase wò ame dɔdɔwo ƒe gbe le teƒe aɖeke azɔ o.”<verse eid="NAM 2:13"/></para>
  <chapter eid="NAM 2"/>
  <chapter number="3" style="c" sid="NAM 3"/>
  <para style="s1">Baba na Ninive</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 3:1"/>Baba na du si yɔ fũu kple ʋukɔkɔɖi,</para>
  <para style="q2" vid="NAM 3:1">alakpadada kple nuhaha,</para>
  <para style="q2" vid="NAM 3:1">eye wògbe asiɖeɖe le nu siwo wòha la ŋu.<verse eid="NAM 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 3:2"/>Ƒu to anyi nàse ale si sɔƒokawo le gbe dom,</para>
  <para style="q2" vid="NAM 3:2">eye tasiaɖamwo ƒe afɔtiwo,</para>
  <para style="q1" vid="NAM 3:2">kple sɔwo ƒe afɔkpawo le hoo wɔm esime tasiaɖamwo</para>
  <para style="q2" vid="NAM 3:2">le du sim glaŋglaŋglaŋ le mɔtatawo dzi!<verse eid="NAM 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 3:3"/>Sɔdolawo dze agbo, yiwo le dzo dam,</para>
  <para style="q2" vid="NAM 3:3">eye akplɔwo le dzo sim le woƒe asi me!</para>
  <para style="q1" vid="NAM 3:3">Ame tsiaʋawo teƒe mekɔ o,</para>
  <para style="q2" vid="NAM 3:3">ame kukuwo sɔ gbɔ taŋtaŋtaŋ,</para>
  <para style="q2" vid="NAM 3:3">eye ɖewo tsi wo nɔewo dzi.</para>
  <para style="q1" vid="NAM 3:3">Amewo le wo dzi zɔm le anyi dzem,</para>
  <para style="q2" vid="NAM 3:3">le fɔfɔm; gale anyi dzem.<verse eid="NAM 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 3:4"/>Esiawo katã va eme ɖe gbolo ɖeka ƒe gbolowɔwɔ vivivo ta.</para>
  <para style="q2" vid="NAM 3:4">Ame si ble afakalawo ƒe amegã nu,</para>
  <para style="q1" vid="NAM 3:4">eye wòdo kluvi dukɔwo kple eƒe gbolowɔwɔ hebla amewo</para>
  <para style="q2" vid="NAM 3:4">kple eƒe adzewɔwɔ.<verse eid="NAM 3:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 3:5"/>Yehowa, Dziƒoʋakɔwo ƒe Aƒetɔ la gblɔ be:</para>
  <para style="q2" vid="NAM 3:5">“Le esia ta, metsi tsitre ɖe ŋuwò,</para>
  <para style="q2" vid="NAM 3:5">azɔ maɖe motsyɔvɔ le mo na wò,</para>
  <para style="q1" vid="NAM 3:5">mana dukɔwo nakpɔ wò amame,</para>
  <para style="q2" vid="NAM 3:5">eye fiaɖuƒewo nakpɔ wò ŋukpe.<verse eid="NAM 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 3:6"/>Malɔ gbeɖuɖɔ akɔ ɖe dziwò,</para>
  <para style="q2" vid="NAM 3:6">ado ŋunyɔ wò, eye nàzu nukpɔkpɔ na dukɔwo.<verse eid="NAM 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 3:7"/>Ame siwo katã akpɔ wò la, dzidzi aƒo wo,</para>
  <para style="q2" vid="NAM 3:7">eye woagbugbɔ ɖe megbe agblɔ be,</para>
  <para style="q1" vid="NAM 3:7">‘Ninive gbã gudugudu, ame ka afa nɛ?’</para>
  <para style="q2" vid="NAM 3:7">Afi ka makpɔ ame aɖe le wòafa akɔ na wò?”<verse eid="NAM 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 3:8"/>Wòe nyo wu Tebes, si le Nil tɔsisi to,</para>
  <para style="q2" vid="NAM 3:8">eye tɔ la ƒo xlãe godoa?<verse eid="NAM 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 3:9"/>Kus kple Egipte nye eƒe ŋusẽ triakɔ la.</para>
  <para style="q2" vid="NAM 3:9">Nenema ke Putitɔwo kple Libiatɔwo</para>
  <para style="q2" vid="NAM 3:9">nye eƒe kpeɖeŋutɔwo le aʋa me,<verse eid="NAM 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 3:10"/>gake Tebes dze anyi,</para>
  <para style="q2" vid="NAM 3:10">woɖe aboyo emenɔlawo, eye wotsɔ wo viwo</para>
  <para style="q2" vid="NAM 3:10">ƒe ta xlã ɖe kpe le mɔtatawo dzi.</para>
  <para style="q1" vid="NAM 3:10">Wodzidze nu ɖe eƒe bubumewo dzi,</para>
  <para style="q2" vid="NAM 3:10">eye wode kɔsɔkɔsɔ eƒe amegãwo katã.<verse eid="NAM 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 3:11"/>Wò hã àmu aha, asi abe,</para>
  <para style="q2" vid="NAM 3:11">eye àdi sitsoƒe le futɔwo ta.<verse eid="NAM 3:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 3:12"/>Wò mɔ sesẽwo katã anɔ abe gboti si dzi</para>
  <para style="q2" vid="NAM 3:12">kutsetse ɖiɖiwo le la ene.</para>
  <para style="q1" vid="NAM 3:12">Ne woʋuʋu atia la,</para>
  <para style="q2" vid="NAM 3:12">kutsetsewo gena ɖe eɖula ƒe nu me.<verse eid="NAM 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 3:13"/>Kpɔ wò asrafowo ɖa,</para>
  <para style="q2" vid="NAM 3:13">wo katã wole abe nyɔnuwo ene.</para>
  <para style="q1" vid="NAM 3:13">Wò anyigba ƒe agbo anɔ ʋuʋu ɖi siaa</para>
  <para style="q2" vid="NAM 3:13">na wò futɔwo, eye dzo afia wò gametiwo.<verse eid="NAM 3:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="NAM 3:14"/>Du tsi kɔ ɖi na ɖokuiwò ɖe aʋadzegbe ŋu.</para>
  <para style="q2" vid="NAM 3:14">Dzra wò mɔ sesẽwo ƒe gliwo ɖo.</para>
  <para style="q1" vid="NAM 3:14">Ge ɖe anyiʋewo me, eye nànya anyi atsɔ tre gli gbagbãwoe.<verse eid="NAM 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 3:15"/>Esi nèle nu siawo wɔm la dzo ava fia wò;</para>
  <para style="q2" vid="NAM 3:15">yi alã wò aƒu anyi, eye woaɖu wò</para>
  <para style="q2" vid="NAM 3:15">abe ale si ʋetsuvi ɖua nui ene.</para>
  <para style="q1" vid="NAM 3:15">Midzi ɖe edzi abe ʋetsuviwo ene,</para>
  <para style="q2" vid="NAM 3:15">misɔ gbɔ ɖe edzi abe ʋetsuviwo ene.<verse eid="NAM 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="NAM 3:16"/>Èdzi wò asitsalawo ɖe edzi va se ɖe</para>
  <para style="q2" vid="NAM 3:16">esime wosɔ gbɔ wu ɣletiviwo,</para>
  <para style="q1" vid="NAM 3:16">gake ʋetsuviwo aɖu wo,</para>
  <para style="q2" vid="NAM 3:16">aɖi gbɔlo anyigba la, eye woadzo adzo.<verse eid="NAM 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="NAM 3:17"/>Ŋuwòdzɔlawo asɔ gbɔ abe ʋetsuviwo</para>
  <para style="q2" vid="NAM 3:17">ƒe ha gã aɖe ene, eye wò amegãwo asɔ gbɔ</para>
  <para style="q1" vid="NAM 3:17">abe ʋetra siwo dze ɖe gli ŋu</para>
  <para style="q2" vid="NAM 3:17">le ŋdi me, ke ne ɣe dze ko la,</para>
  <para style="q1" vid="NAM 3:17">woadzo adzo, eye teƒe si wonɔ la magadze o ene.<verse eid="NAM 3:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="NAM 3:18"/>O Asiria fia, wò kplɔlawo le akɔlɔ̃e dɔm;</para>
  <para style="q2" vid="NAM 3:18">wò bubumewo mlɔ anyi le dzudzɔm.</para>
  <para style="q1" vid="NAM 3:18">Woakaka wò amewo ɖe towo dzi,</para>
  <para style="q2" vid="NAM 3:18">eye ame aɖeke maƒo wo nu ƒu o.<verse eid="NAM 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="NAM 3:19"/>Naneke mate ŋu awu abi si nèxɔ la o,</para>
  <para style="q2" vid="NAM 3:19">elabena edzi ŋɔ ŋutɔ.</para>
  <para style="q1" vid="NAM 3:19">Ame sia ame si ase wò anyidzedze la,</para>
  <para style="q2" vid="NAM 3:19">aƒo asikpe ɖe tawò,</para>
  <para style="q1" vid="NAM 3:19">elabena ame kae mekpɔ gome le wò</para>
  <para style="q2" vid="NAM 3:19">ŋutasesẽ gbogboawo me o?<verse eid="NAM 3:19"/></para>
  <chapter eid="NAM 3"/>
</usx>
