<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MIC" style="id">- Biblica® Open Ewe Contemporary Scriptures 2020</book>
  <para style="h">Mika</para>
  <para style="toc1">Mika ƒe agbalẽ</para>
  <para style="toc2">Mika</para>
  <para style="toc3">Mik</para>
  <para style="mt1">Mika</para>
  <para style="mt2">ƒe agbalẽ</para>
  <chapter number="1" style="c" sid="MIC 1"/>
  <para style="p">
    <verse number="1" style="v" sid="MIC 1:1"/>Esiae nye gbedeasi si va na Mika, Moresitɔ la, tso Yehowa gbɔ. Gbedeasia va nɛ le Yada fiawo, Yotam, Ahaz kple Hezekia ŋɔli. Gbedeasia ku ɖe Samaria kple Yerusalem ŋuti, eye wòva nɛ le ŋutega me.<verse eid="MIC 1:1"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 1:2"/>Mi dukɔwo katã miɖo to nya sia,</para>
  <para style="q2" vid="MIC 1:2">wò anyigba kple edzinɔlawo katã mise ɖa;</para>
  <para style="q1" vid="MIC 1:2">Aƒetɔ Yehowa le eƒe gbedoxɔ kɔkɔe me</para>
  <para style="q2" vid="MIC 1:2">eye wòtsɔ nya ɖe mia ŋuti!<verse eid="MIC 1:2"/></para>
  <para style="s1">Ʋɔnudɔdrɔ̃ Samaria kple Yerusalem</para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 1:3"/>Kpɔ ɖa Yehowa gbɔna tso eƒe nɔƒe!</para>
  <para style="q2" vid="MIC 1:3">Eɖi tso dzi eye wòzɔ to kɔkɔƒewo le anyigba dzi.<verse eid="MIC 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 1:4"/>Towo lolõ ɖe eƒe afɔ te,</para>
  <para style="q2" vid="MIC 1:4">eye balimewo ma le eŋgɔ</para>
  <para style="q1" vid="MIC 1:4">abe ale si bosomi lolõnae le dzo gbɔ ene;</para>
  <para style="q2" vid="MIC 1:4">abe ale si tsi sina ne wòle aga ɖim ene.<verse eid="MIC 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 1:5"/>Nu siawo katã le dzɔdzɔm ɖe Yakob ƒe aglãdzedze ta,</para>
  <para style="q2" vid="MIC 1:5">ele dzɔdzɔm ɖe Israel ƒe aƒe ƒe nu vɔ̃wo ta.</para>
  <para style="q1" vid="MIC 1:5">Nu kae nye Yakob ƒe aglãdzedzea?</para>
  <para style="q2" vid="MIC 1:5">Ɖe menye Samariae oa?</para>
  <para style="q1" vid="MIC 1:5">Nu kae nye Yuda ƒe vɔsaƒewo?</para>
  <para style="q2" vid="MIC 1:5">Ɖe menye Yerusalem ye oa?<verse eid="MIC 1:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 1:6"/>“Le esiawo ta la, mana Samaria nazu aƒedo,</para>
  <para style="q2" vid="MIC 1:6">ale be woate ŋu ade waingble ɖe edzi gɔ̃ hã.</para>
  <para style="q1" vid="MIC 1:6">Malɔ eƒe kpe gbagbãwo akɔ ɖe balime</para>
  <para style="q2" vid="MIC 1:6">eye eƒe xɔwo ƒe agunu adze.<verse eid="MIC 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 1:7"/>Woagbã eƒe legbawo gudugudu</para>
  <para style="q2" vid="MIC 1:7">eye woatɔ dzo nunana siwo woli kɔe ɖe eƒe trɔ̃xɔwo me.</para>
  <para style="q2" vid="MIC 1:7">Ale matɔ dzo eƒe legbawo katã.</para>
  <para style="q1" vid="MIC 1:7">Elabena gboloho wotsɔ ƒo wo nu ƒui</para>
  <para style="q2" vid="MIC 1:7">eye gboloho woagazu.”<verse eid="MIC 1:7"/></para>
  <para style="s1">Konyifafa kple avifafa</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 1:8"/>Le esia ta mafa avi ado ɣli;</para>
  <para style="q2" vid="MIC 1:8">maɖe amama azɔ afɔ ƒuƒlu.</para>
  <para style="q1" vid="MIC 1:8">Maxlɔ̃ abe amegaxi ene,</para>
  <para style="q2" vid="MIC 1:8">eye mafa konyi abe adzexe ene,<verse eid="MIC 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 1:9"/>elabena Yuda ka abi makumaku.</para>
  <para style="q2" vid="MIC 1:9">Abi la keke va ɖo nye dukɔ ƒe agbowo nu ke,</para>
  <para style="q2" vid="MIC 1:9">va ɖo Yerusalem ŋutɔ gɔ̃ hã.<verse eid="MIC 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 1:10"/>Migaɖe gbeƒãe alo afa avi le Gat o.</para>
  <para style="q2" vid="MIC 1:10">Ke mibliba mia ɖokuiwo ɖe</para>
  <para style="q2" vid="MIC 1:10">ke me le Bet Ofra.<verse eid="MIC 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 1:11"/>Mi Safirtɔwo midzo le ŋukpe kple amamanɔnɔ me;</para>
  <para style="q2" vid="MIC 1:11">mi Zaanantɔwo miadzo o.</para>
  <para style="q1" vid="MIC 1:11">Bet Ezel le konyi fam eya</para>
  <para style="q2" vid="MIC 1:11">ta sitsoƒe aɖeke mele esi na mi o.<verse eid="MIC 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 1:12"/>Marotɔwo le mɔ kpɔm vevie be ŋu nyui aɖe ava ke,</para>
  <para style="q2" vid="MIC 1:12">gake vevesese koe le wo lalam,</para>
  <para style="q1" vid="MIC 1:12">elabena gbegblẽ tso Yehowa gbɔ va</para>
  <para style="q2" vid="MIC 1:12">keke Yerusalem ƒe agbo nu.<verse eid="MIC 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 1:13"/>Mi Lakistɔwo mitsi sɔwo</para>
  <para style="q2" vid="MIC 1:13">ɖe miaƒe tasiaɖamwo ŋu.</para>
  <para style="q1" vid="MIC 1:13">Wòe nye Zion nyɔnuvi ƒe nu vɔ̃ ƒe gɔmedzeƒe</para>
  <para style="q2" vid="MIC 1:13">elabena wokpɔ Israel ƒe nu vɔ̃wo le mewò.<verse eid="MIC 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 1:14"/>Eya ta miaklã ɖa tso Moreset Gat gbɔ.</para>
  <para style="q2" vid="MIC 1:14">Akzib ƒe aƒe aflu Israel fiawo.<verse eid="MIC 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 1:15"/>Mi ame siwo le Maresa,</para>
  <para style="q2" vid="MIC 1:15">makplɔ aʋakɔ aƒu mi,</para>
  <para style="q1" vid="MIC 1:15">woaɖu mia dzi,</para>
  <para style="q2" vid="MIC 1:15">ale Israel ƒe ŋutikɔkɔe ava Adulam.<verse eid="MIC 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 1:16"/>Lũ ta kolikoli nàfa konyi</para>
  <para style="q2" vid="MIC 1:16">elabena wokplɔ vi siwo gbɔ mèlɔ̃a nu le o la dzoe.</para>
  <para style="q1" vid="MIC 1:16">Lũ ta wòanɔ abe akaga tɔ ene,</para>
  <para style="q2" vid="MIC 1:16">elabena woakplɔ viwòwo ayi aboyo mee.<verse eid="MIC 1:16"/></para>
  <chapter eid="MIC 1"/>
  <chapter number="2" style="c" sid="MIC 2"/>
  <para style="s1">Ame ƒe ɖoɖowo kple Mawu ƒe ɖoɖowo</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 2:1"/>Baba na mi ame siwo ɖoa nu vɔ̃ɖi be yewoawɔ</para>
  <para style="q2" vid="MIC 2:1">kple ame siwo ɖoa nu vɔ̃ɖi le woƒe abawo dzi.</para>
  <para style="q1" vid="MIC 2:1">Ŋdi kanya la, wowɔa nu siwo woɖo</para>
  <para style="q2" vid="MIC 2:1">elabena ŋusẽ le wo si be woawɔe.<verse eid="MIC 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 2:2"/>Ne agble dim wole la, woxɔnɛ sesẽtɔe;</para>
  <para style="q2" vid="MIC 2:2">ne xɔ dim wole la, woxɔa eya hã kple akpasesẽ.</para>
  <para style="q1" vid="MIC 2:2">Nenye be anyigba ɖeka alo xɔ ɖeka ma koe le amea si hã la,</para>
  <para style="q2" vid="MIC 2:2">woxɔnɛ le esi.</para>
  <para style="q1" vid="MIC 2:2">Ale mietea ŋu xɔa amea</para>
  <para style="q2" vid="MIC 2:2">kple eƒe domenyinuwo siaa sesẽtɔe.<verse eid="MIC 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MIC 2:3"/>Eya ta ale Yehowa gblɔe nye esi,</para>
  <para style="q1" vid="MIC 2:3">“Meɖo gbegblẽ ɖe ame siawo ŋuti</para>
  <para style="q2" vid="MIC 2:3">eye miate ŋu aɖe mia ɖokuiwo ɖa le gbegblẽ sia me o.</para>
  <para style="q1" vid="MIC 2:3">Miate ŋu agazɔ dadatɔe o</para>
  <para style="q2" vid="MIC 2:3">elabena anye ɣeyiɣi vɔ̃.<verse eid="MIC 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 2:4"/>Le ŋkeke ma dzi la, amewo aɖu fewu le mia ŋu,</para>
  <para style="q2" vid="MIC 2:4">eye woadzi konyifaha sia na mi amenuɖiatɔe be:</para>
  <para style="q1" vid="MIC 2:4">‘Wotsrɔ̃ mi keŋkeŋ; hema nye dukɔ ƒe nunɔamesiwo.</para>
  <para style="q2" vid="MIC 2:4">Yehowa xɔe le asinye.</para>
  <para style="q1" vid="MIC 2:4">Ema míaƒe anyigbawo na ame siwo ɖe aboyo mí.’ ”<verse eid="MIC 2:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 2:5"/>Eya ta ne ɣeyiɣi de be woadzidze nu ama anyigba la,</para>
  <para style="q2" vid="MIC 2:5">ame aɖeke manɔ mía si le Yehowa ƒe asaɖa me amae na mí o.<verse eid="MIC 2:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 2:6"/>Woƒe Nyagblɔɖilawo gblɔ nam be:</para>
  <para style="q2" vid="MIC 2:6">“Mègagblɔ nya ɖi tso nu siawo ŋuti o</para>
  <para style="q2" vid="MIC 2:6">elabena ŋukpe mava mía dzi o.”<verse eid="MIC 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 2:7"/>O Yakob ƒe aƒe, aleke woagblɔ nya siae?</para>
  <para style="q2" vid="MIC 2:7">“Ɖe Yehowa ƒe gbɔgbɔ ado dɔmedzoea?</para>
  <para style="q2" vid="MIC 2:7">Ɖe esiawo tso egbɔa?</para>
  <para style="b" vid="MIC 2:7"/>
  <para style="q1" vid="MIC 2:7">“Ɖe nye nyawo mewɔa nyui na</para>
  <para style="q2" vid="MIC 2:7">ame siwo lé mɔ dzɔdzɔe tsɔ oa?<verse eid="MIC 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 2:8"/>Ke nye dukɔ tso ɖe ŋunye</para>
  <para style="q2" vid="MIC 2:8">abe woƒe futɔ ene.</para>
  <para style="q1" vid="MIC 2:8">Mieɖe awu xɔasiwo le ame</para>
  <para style="q2" vid="MIC 2:8">siwo va le eme tsom</para>
  <para style="q2" vid="MIC 2:8">le ŋutifafa me la ŋuti abe asrafo siwo tso aʋa gbɔ la ene.<verse eid="MIC 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 2:9"/>Mienya nyɔnu siwo le nye dukɔ</para>
  <para style="q2" vid="MIC 2:9">me la le woƒe aƒe nyuiwo me.</para>
  <para style="q1" vid="MIC 2:9">Miexɔ nye yayra</para>
  <para style="q2" vid="MIC 2:9">le wo viwo si tegbee.<verse eid="MIC 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 2:10"/>Mitso ne miadzo le afi sia,</para>
  <para style="q2" vid="MIC 2:10">elabena esia menye dzudzɔƒe wònye na mi o;</para>
  <para style="q1" vid="MIC 2:10">elabena wodo gu teƒe la, eye wogbãe,</para>
  <para style="q2" vid="MIC 2:10">ale be womagate ŋu aɖɔe ɖo o.<verse eid="MIC 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 2:11"/>Ne alakpatɔ kple ameblela aɖe va gblɔ be magblɔ nya ɖi be,</para>
  <para style="q2" vid="MIC 2:11">‘Wain kple aha nabɔ na mi fũu’</para>
  <para style="q2" vid="MIC 2:11">la, eyae nye nyagblɔɖila si tɔgbi ame siawo lɔ̃na.”<verse eid="MIC 2:11"/></para>
  <para style="s1">Mawu do ɖeɖekpɔkpɔ ŋugbe</para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 2:12"/>“O Yakob, magaƒo mia nu ƒu.</para>
  <para style="q2" vid="MIC 2:12">Maƒo Israel ƒe ame mamlɛawo nu ƒu godoo.</para>
  <para style="q1" vid="MIC 2:12">Maƒo wo nu ƒu abe alẽwo ene ɖe lãkpɔ me</para>
  <para style="q2" vid="MIC 2:12">eye woanɔ abe alẽha le gbeɖuƒe ene.<verse eid="MIC 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 2:13"/>Ame si gbãa agbowo la adze ŋgɔ na wo</para>
  <para style="q2" vid="MIC 2:13">eye woato agboawo me ado go.</para>
  <para style="q1" vid="MIC 2:13">Woƒe fia adze ŋgɔ na wo</para>
  <para style="q2" vid="MIC 2:13">eye Yehowa anye woƒe kplɔla.”<verse eid="MIC 2:13"/></para>
  <chapter eid="MIC 2"/>
  <chapter number="3" style="c" sid="MIC 3"/>
  <para style="s1">Mawu ka mo na kplɔlawo kple nyagblɔɖilawo</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 3:1"/>Eye megblɔ be:</para>
  <para style="q1" vid="MIC 3:1">“Miɖo to, mi Yakob ƒe kplɔlawo.</para>
  <para style="q2" vid="MIC 3:1">Mi ame siwo le Israel ƒe aƒe dzi ɖum.</para>
  <para style="q1" vid="MIC 3:1">Miawoe wòdze be mianya nyui tso vɔ̃ gbɔ<verse eid="MIC 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 3:2"/>gake miawo boŋue gbe nu le nyui gbɔ eye mielɔ̃ vɔ̃.</para>
  <para style="q2" vid="MIC 3:2">Mievuvu ayi le nye amewo ŋu</para>
  <para style="q2" vid="MIC 3:2">ye mievuvu lã le woƒe ƒuwo ŋuti.<verse eid="MIC 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 3:3"/>Mieɖu nye amewo katã ƒe lã,</para>
  <para style="q2" vid="MIC 3:3">vuvu ayi le wo ŋuti, gbã ƒu ɖe lãme na wo</para>
  <para style="q2" vid="MIC 3:3">eye miefli wo abe ale si woflia adelã dea zee ene.”<verse eid="MIC 3:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 3:4"/>Ekema woado ɣli ayɔ Yehowa gake matɔ na wo o</para>
  <para style="q2" vid="MIC 3:4">eye aɣla eƒe mo ɖe wo ɖe nu vɔ̃ si wowɔ la ta.<verse eid="MIC 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 3:5"/>Ale Yehowa gblɔe nye esi:</para>
  <para style="q2" vid="MIC 3:5">“Mi nyagblɔɖila siwo kplɔa nye amewo tranae;</para>
  <para style="q1" vid="MIC 3:5">ne ame aɖe na nu wo,</para>
  <para style="q2" vid="MIC 3:5">woɖu la, wodoa ŋutifafa nɛ;</para>
  <para style="q1" vid="MIC 3:5">ke ne ame aɖe mena nu wo o la,</para>
  <para style="q2" vid="MIC 3:5">wohoa aʋa ɖe eŋuti.<verse eid="MIC 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 3:6"/>Zã ado aƒo xlã mi eye miegale ŋutega kpɔ ge o;</para>
  <para style="q2" vid="MIC 3:6">viviti atsyɔ mia dzi eye Mawu ƒe gbe mava na mi o.</para>
  <para style="q1" vid="MIC 3:6">Ɣe aɖo to ɖe mia dzi eye ŋkeke ado viviti na mi.<verse eid="MIC 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 3:7"/>Miaƒe nukpɔlawo aɖu ŋukpe</para>
  <para style="q2" vid="MIC 3:7">eye woado ŋukpe miaƒe nukalawo.</para>
  <para style="q1" vid="MIC 3:7">Woatsɔ asi atsyɔ mo</para>
  <para style="q2" vid="MIC 3:7">elabena gbe aɖeke metso Mawu gbɔ na wo o.”<verse eid="MIC 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 3:8"/>Ke nye la, ŋusẽ yɔ menye taŋtaŋ,</para>
  <para style="q2" vid="MIC 3:8">Yehowa ƒe Gbɔgbɔ le dzinye</para>
  <para style="q1" vid="MIC 3:8">eya ta matsɔ dzɔdzɔenyenye</para>
  <para style="q2" vid="MIC 3:8">kple ŋusẽ aɖe gbeƒã Yakob ƒe nu tovowo wɔwɔ</para>
  <para style="q2" vid="MIC 3:8">kple Israel ƒe nu vɔ̃.<verse eid="MIC 3:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 3:9"/>Miɖo tom, mi Yakob ƒe aƒe ƒe kplɔlawo</para>
  <para style="q2" vid="MIC 3:9">kple mi ame siwo le Israel ƒe aƒe dzi ɖum.</para>
  <para style="q1" vid="MIC 3:9">Mi ame siwo gbe nu le dzɔdzɔenyenye gbɔ</para>
  <para style="q2" vid="MIC 3:9">eye mietrɔa gbo nu siwo katã le dzɔdzɔe.<verse eid="MIC 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 3:10"/>Mi ame siwo tu Zion ɖe ʋukɔkɔɖeanyi dzi</para>
  <para style="q2" vid="MIC 3:10">kple Yerusalem ɖe vɔ̃ɖinyenye dzi.<verse eid="MIC 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 3:11"/>Miaƒe kplɔlawo xɔa zãnu hafi drɔ̃a ʋɔnu.</para>
  <para style="q2" vid="MIC 3:11">Miaƒe nunɔlawo fiaa nu ɖe ga si woaxɔ ta</para>
  <para style="q1" vid="MIC 3:11">eye miaƒe Nyagblɔɖilawo gblɔa nya ɖi ɖe ga ta</para>
  <para style="q2" vid="MIC 3:11">gake woziɔna ɖe Yehowa ŋu gblɔna be:</para>
  <para style="q1" vid="MIC 3:11">“Yehowa le mia dome</para>
  <para style="q2" vid="MIC 3:11">eya ta vɔ̃ aɖeke mawɔ mí o.”<verse eid="MIC 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 3:12"/>Miawo ta woaŋlɔ</para>
  <para style="q2" vid="MIC 3:12">Zion abe agble ene,</para>
  <para style="q1" vid="MIC 3:12">Yerusalem azu glikpo gã ɖeka</para>
  <para style="q2" vid="MIC 3:12">eye to si dzi gbedoxɔ le la azu togbɛ si zu ave.<verse eid="MIC 3:12"/></para>
  <chapter eid="MIC 3"/>
  <chapter number="4" style="c" sid="MIC 4"/>
  <para style="s1">Yehowa ƒe to la</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 4:1"/>Le ŋkeke mamlɛawo me la,</para>
  <para style="q2" vid="MIC 4:1">woaɖo to si dzi Yehowa ƒe gbedoxɔ</para>
  <para style="q2" vid="MIC 4:1">le la te abe to si ƒo towo katã ta la ene.</para>
  <para style="q1" vid="MIC 4:1">Woakɔe wòagbɔ togbɛwo katã ta</para>
  <para style="q2" vid="MIC 4:1">eye amewo aƒo zi ɖe eŋu.<verse eid="MIC 4:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MIC 4:2"/>Dukɔ geɖewo ava agblɔ be,</para>
  <para style="q1" vid="MIC 4:2">“Miva. Mina míayi Yehowa ƒe to la dzi</para>
  <para style="q2" vid="MIC 4:2">le Yakob ƒe Mawu la ƒe gbedoxɔ me.</para>
  <para style="q1" vid="MIC 4:2">Afia eƒe mɔwo mí ale be míazɔ le eƒe mɔwo dzi.”</para>
  <para style="q2" vid="MIC 4:2">Nufiame atso Zion ava</para>
  <para style="q2" vid="MIC 4:2">eye Yehowa ƒe nya atso Yerusalem ava.<verse eid="MIC 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 4:3"/>Adrɔ̃ ʋɔnu le amewo dome,</para>
  <para style="q2" vid="MIC 4:3">eye wòadzra dukɔ sesẽ siwo le kpuiƒe</para>
  <para style="q2" vid="MIC 4:3">kple didiƒe siaa la dome ɖo.</para>
  <para style="q1" vid="MIC 4:3">Woatsɔ woƒe aʋawɔyiwo atu kodzoewoe,</para>
  <para style="q2" vid="MIC 4:3">eye woatsɔ woƒe akplɔwo atu hɛ gobɛwoe.</para>
  <para style="q1" vid="MIC 4:3">Dukɔ matsɔ yi ɖe dukɔ ŋu</para>
  <para style="q2" vid="MIC 4:3">alo axɔ hehe na aʋawɔwɔ o.<verse eid="MIC 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 4:4"/>Ame sia ame anɔ anyi bɔkɔɔ</para>
  <para style="q2" vid="MIC 4:4">ɖe eya ŋutɔ ƒe wainka kple gboti te;</para>
  <para style="q1" vid="MIC 4:4">eye ame aɖeke magado ŋɔdzi na wo azɔ o</para>
  <para style="q2" vid="MIC 4:4">elabena Yehowa, dziƒoʋakɔwo ƒe Aƒetɔ lae gblɔe.<verse eid="MIC 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 4:5"/>Dukɔwo katã ate ŋu azɔ le woƒe mawuwo ƒe ŋkɔ me</para>
  <para style="q2" vid="MIC 4:5">gake míawo ya míazɔ le Yehowa, míaƒe Mawu la ƒe ŋkɔ me tegbetegbe.<verse eid="MIC 4:5"/></para>
  <para style="s1">Yehowa ƒe ɖoɖo</para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 4:6"/>Yehowa be,</para>
  <para style="q2" vid="MIC 4:6">“Le ŋkeke ma dzi la,</para>
  <para style="q1" vid="MIC 4:6">maƒo tekunɔwo,</para>
  <para style="q2" vid="MIC 4:6">aboyomewo kple ame siwo ƒe dzi megbã la nu ƒu.<verse eid="MIC 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 4:7"/>Mawɔ tekunɔwo woazu ame mamlɛawo,</para>
  <para style="q2" vid="MIC 4:7">eye ame siwo wonya la nazu dukɔ sẽŋu aɖe.</para>
  <para style="q1" vid="MIC 4:7">Yehowa aɖu fia ɖe wo dzi</para>
  <para style="q2" vid="MIC 4:7">le Zion to dzi tso gbe ma gbe heyi tegbee.<verse eid="MIC 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 4:8"/>Ke wò la, O nye alẽha ƒe gbetakpɔla,</para>
  <para style="q2" vid="MIC 4:8">O Zion nyɔnuvi ƒe togbɛ,</para>
  <para style="q2" vid="MIC 4:8">dziɖuɖu agava na wò abe tsã ene.</para>
  <para style="q1" vid="MIC 4:8">Dziɖuɖu ƒe ŋusẽ agava na wò abe tsã ene</para>
  <para style="q2" vid="MIC 4:8">eye fiaɖuɖu agava na Yerusalem vinyɔnu.”<verse eid="MIC 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 4:9"/>Azɔ nu ka ta nèle avi fam</para>
  <para style="q2" vid="MIC 4:9">eye ɖe fia aɖeke mele asiwò oa?</para>
  <para style="q1" vid="MIC 4:9">Afi ka wò fia si wòle be wòakplɔ wò la to?</para>
  <para style="q1" vid="MIC 4:9">Ɖe wò aɖaŋuɖolawo ku hafi nèle ŋeŋem</para>
  <para style="q2" vid="MIC 4:9">abe nyɔnu si le ku lém la enea?<verse eid="MIC 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 4:10"/>O Zion nyɔnuvi, ƒo dablibɛ,</para>
  <para style="q2" vid="MIC 4:10">nàlé ku abe nyɔnu si le vi dzim la ene,</para>
  <para style="q1" vid="MIC 4:10">elabena tso azɔ dzi yina la,</para>
  <para style="q2" vid="MIC 4:10">àdzo le du sia me aɖanɔ gbegbe,</para>
  <para style="q1" vid="MIC 4:10">woakplɔ wò ayi ɖe aboyo me</para>
  <para style="q2" vid="MIC 4:10">le Babilonianyigba dzi,</para>
  <para style="q1" vid="MIC 4:10">gake le afi sia la, maɖe wò.</para>
  <para style="q2" vid="MIC 4:10">Le afi ma la,</para>
  <para style="q2" vid="MIC 4:10">Yehowa aɖe wò tso futɔwo ƒe asi me.<verse eid="MIC 4:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 4:11"/>Ke azɔ la, dukɔ geɖewo wɔ ɖeka wɔ</para>
  <para style="q2" vid="MIC 4:11">babla ɖe mia ŋuti;</para>
  <para style="q2" vid="MIC 4:11">Wogblɔ be:</para>
  <para style="q1" vid="MIC 4:11">“Mina míado gui eye míaƒe ŋkuwo natsa le Zion.”<verse eid="MIC 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 4:12"/>Ke womenya Yehowa ƒe susuwo o,</para>
  <para style="q2" vid="MIC 4:12">eye womese eƒe ɖoɖowo gɔme o.</para>
  <para style="q1" vid="MIC 4:12">Eya ame si ƒo wo nu ƒu abe ale si woƒoa</para>
  <para style="q2" vid="MIC 4:12">lu bablawo nu ƒu ɖe lugbɔƒee ene.<verse eid="MIC 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 4:13"/>“Tsi tsitre, O Zion nyɔnuvi, eye nàtugu lu</para>
  <para style="q2" vid="MIC 4:13">elabena mana wò dzo nanye gayibɔ,</para>
  <para style="q1" vid="MIC 4:13">wò afɔkli nanye akɔbli</para>
  <para style="q2" vid="MIC 4:13">eye nàgbã dukɔwo gudugudu.”</para>
  <para style="q1" vid="MIC 4:13">Kɔ woƒe afunyinu ŋu na Yehowa</para>
  <para style="q2" vid="MIC 4:13">kple woƒe kesinɔnuwo ŋu</para>
  <para style="q2" vid="MIC 4:13">na anyigba katã ƒe Aƒetɔ la.<verse eid="MIC 4:13"/></para>
  <chapter eid="MIC 4"/>
  <chapter number="5" style="c" sid="MIC 5"/>
  <para style="s1">Mawu do dziɖula aɖe tso Betlehem ƒe ŋugbe</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 5:1"/>O aʋawɔlawo ƒe du.</para>
  <para style="q2" vid="MIC 5:1">Ƒo wò aʋawɔlawo nu ƒu</para>
  <para style="q1" vid="MIC 5:1">elabena futɔwo ɖe to ɖe mí.</para>
  <para style="q2" vid="MIC 5:1">Woatsɔ ati aƒo tome na Israel ƒe dziɖula.<verse eid="MIC 5:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 5:2"/>“Ke wò, Betlehem, Efrata,</para>
  <para style="q2" vid="MIC 5:2">togbɔ be èle sue le Yuda ƒe ƒomeawo dome hã la,</para>
  <para style="q1" vid="MIC 5:2">mewòe ame si le nye dukɔ Israel</para>
  <para style="q2" vid="MIC 5:2">kplɔ ge la ado tso nam.</para>
  <para style="q1" vid="MIC 5:2">Ame si ƒe dzɔtsoƒe metsɔ o</para>
  <para style="q2" vid="MIC 5:2">elabena eli tso keke blema ke.”<verse eid="MIC 5:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 5:3"/>Mawu aɖe asi le Israel ŋuti na eƒe futɔwo va se ɖe</para>
  <para style="q2" vid="MIC 5:3">esime nyɔnu si fu le ɖuɖum la nadzi vi;</para>
  <para style="q1" vid="MIC 5:3">eye Israelvi siwo susɔ ɖe aboyo me la</para>
  <para style="q2" vid="MIC 5:3">natrɔ gbɔ akpe ɖe wo nɔviwo ŋuti anɔ</para>
  <para style="q2" vid="MIC 5:3">woawo ŋutɔ ƒe anyigba dzi.<verse eid="MIC 5:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 5:4"/>Atsi tsitre akplɔ eƒe alẽhawo le Yehowa ƒe ŋusẽ me</para>
  <para style="q2" vid="MIC 5:4">kple Yehowa, eƒe Mawu la ƒe fianyenye me.</para>
  <para style="q1" vid="MIC 5:4">Eƒe dukɔ la anɔ anyi le ŋutifafa me</para>
  <para style="q2" vid="MIC 5:4">elabena woade bubu eƒe gãnyenye ŋuti</para>
  <para style="q2" vid="MIC 5:4">le xexea me godoo.<verse eid="MIC 5:4"/></para>
  <para style="s1">Ɖeɖe kple tsɔtsrɔ̃</para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 5:5"/>Eyae anye woƒe ŋutifafa.</para>
  <para style="q2" vid="MIC 5:5">Ne Asiria ho aʋa va míaƒe anyigba dzi heto</para>
  <para style="q2" vid="MIC 5:5">míaƒe mɔ sesẽwo me la,</para>
  <para style="q1" vid="MIC 5:5">ekema míadɔ alẽkplɔla adre ɖe eŋuti</para>
  <para style="q2" vid="MIC 5:5">kple kplɔla enyi be woakplɔ mí.<verse eid="MIC 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 5:6"/>Woaɖu Asiria dzi kple yi,</para>
  <para style="q2" vid="MIC 5:6">eye woato eƒe agbowo me age ɖe</para>
  <para style="q2" vid="MIC 5:6">Nimrɔd ƒe anyigba dzi.</para>
  <para style="q1" vid="MIC 5:6">Aɖe mí tso Asiria ƒe asime nenye be</para>
  <para style="q2" vid="MIC 5:6">wòho aʋa va dze míaƒe anyigba dzi</para>
  <para style="q2" vid="MIC 5:6">be yeaɖo afɔ míaƒe liƒowo dzi.<verse eid="MIC 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 5:7"/>Yakob ƒe ame mamlɛawo anɔ ame geɖewo dome</para>
  <para style="q2" vid="MIC 5:7">abe ahũ si dza tso Yehowa gbɔ</para>
  <para style="q1" vid="MIC 5:7">kple agbafie si dzana ɖe gbe dzi, eye melalaa amegbetɔ</para>
  <para style="q2" vid="MIC 5:7">alo kpɔa amegbetɔ ƒe asinu o la ene.<verse eid="MIC 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 5:8"/>Yakob ƒe ame mamlɛawo anɔ dukɔwo</para>
  <para style="q2" vid="MIC 5:8">kple ame geɖewo dome abe</para>
  <para style="q1" vid="MIC 5:8">dzata le lã wɔadã siwo le ave me</para>
  <para style="q2" vid="MIC 5:8">kple dzatavi le alẽhawo dome ene.</para>
  <para style="q1" vid="MIC 5:8">Dzatavi si le yiyim la,</para>
  <para style="q2" vid="MIC 5:8">enyea avuzi hevuvua nu</para>
  <para style="q2" vid="MIC 5:8">eye ame aɖeke mate ŋu axɔ nu le esi o.<verse eid="MIC 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 5:9"/>Àkɔ wò alɔ dzi le dziɖuɖu me ɖe wò futɔwo ŋuti</para>
  <para style="q2" vid="MIC 5:9">eye àɖu wò ketɔwo katã dzi.<verse eid="MIC 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MIC 5:10"/>Yehowa be:</para>
  <para style="q1" vid="MIC 5:10">“Le gbe ma gbe la,</para>
  <para style="q2" vid="MIC 5:10">matsrɔ̃ miaƒe sɔwo</para>
  <para style="q2" vid="MIC 5:10">eye magblẽ miaƒe tasiaɖamwo<verse eid="MIC 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 5:11"/>Magbã wò duwo</para>
  <para style="q2" vid="MIC 5:11">eye mamu wò mɔ sesẽwo aƒu anyi.<verse eid="MIC 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 5:12"/>Matsi adzewɔwɔ nu le wò anyigba dzi</para>
  <para style="q2" vid="MIC 5:12">eye màgasa gbesa azɔ o.<verse eid="MIC 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 5:13"/>Matɔ dzo wò aklamakpakpɛwo</para>
  <para style="q2" vid="MIC 5:13">eye magbã wò legba siwo nèwɔ</para>
  <para style="q2" vid="MIC 5:13">kple wò asiwo be màgade ta agu na wo o.<verse eid="MIC 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 5:14"/>Maho miaƒe aƒeli kɔkɔwo aƒu anyi</para>
  <para style="q2" vid="MIC 5:14">eye magbã miaƒe duwo.<verse eid="MIC 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 5:15"/>Mlɔeba la, matrɔ nye dziku akɔ ɖe</para>
  <para style="q2" vid="MIC 5:15">dukɔ siwo gbe toɖoɖom la dzi eye mabia hlɔ̃ wo.”<verse eid="MIC 5:15"/></para>
  <chapter eid="MIC 5"/>
  <chapter number="6" style="c" sid="MIC 6"/>
  <para style="s1">Yehowa tsɔ nya ɖe Israel ŋu</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 6:1"/>Mise nya si gblɔm Yehowa le na eƒe dukɔ:</para>
  <para style="q1" vid="MIC 6:1">“Tsi tsitre, nàgblɔ nya siwo nètsɔ ɖe ŋutinye.</para>
  <para style="q2" vid="MIC 6:1">Towo kple togbɛwo nanye ɖasefowo</para>
  <para style="q2" vid="MIC 6:1">na nya siwo nètsɔ ɖe ŋutinye.<verse eid="MIC 6:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 6:2"/>“Azɔ la, mi towo, miɖo to miase nya</para>
  <para style="q2" vid="MIC 6:2">siwo Yehowa tsɔ ɖe mia ŋuti.</para>
  <para style="q1" vid="MIC 6:2">Miɖo to, mi anyigba ƒe agunu mavɔwo,</para>
  <para style="q2" vid="MIC 6:2">elabena Yehowa tsɔ nya ɖe eƒe dukɔ ŋuti</para>
  <para style="q2" vid="MIC 6:2">eye wòtsɔ nya ɖe Israel ŋu.<verse eid="MIC 6:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 6:3"/>“O, nye dukɔ, nu ka mewɔ wò?</para>
  <para style="q2" vid="MIC 6:3">Fu ka meɖe na wò?</para>
  <para style="q2" vid="MIC 6:3">Ɖo eŋu nam!<verse eid="MIC 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 6:4"/>Elabena nyee kplɔ wò tso Egipte</para>
  <para style="q2" vid="MIC 6:4">eye meɖe wò tso kluvinyenye me.</para>
  <para style="q1" vid="MIC 6:4">Medɔ Mose, Aron kple Miriam be woakplɔ mi.<verse eid="MIC 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 6:5"/>Nye dukɔ, ɖo ŋku aɖaŋu si Moab fia, Balak,</para>
  <para style="q2" vid="MIC 6:5">ɖo kple ale si Balaam, Beor ƒe vi la ɖo eŋu nɛ la dzi.</para>
  <para style="q1" vid="MIC 6:5">Ɖo ŋku wò mɔzɔzɔ tso Sitim yi Gilgal</para>
  <para style="q2" vid="MIC 6:5">la dzi, be nàdze si Yehowa ƒe nu dzɔdzɔe wɔwɔwo.”<verse eid="MIC 6:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 6:6"/>Nu ka matsɔ ɖe asi ado ɖe Yehowa gbɔ</para>
  <para style="q2" vid="MIC 6:6">eye made ta agu ɖe Mawu dziƒoʋĩtɔ la ŋkume?</para>
  <para style="q1" vid="MIC 6:6">Matsɔ nyivi si xɔ ƒe ɖeka la asa numevɔ nɛa?<verse eid="MIC 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 6:7"/>Ɖe agbo akpewo kple amitɔsisi akpe akpewo adze Yehowa ŋua?</para>
  <para style="q1" vid="MIC 6:7">Ɖe matsɔ nye ŋgɔgbevi asa vɔe ɖe nye dzidadawo ta</para>
  <para style="q2" vid="MIC 6:7">kple nye dɔmevi ɖe nye luʋɔ ƒe nu vɔ̃ ta mahã?<verse eid="MIC 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 6:8"/>O amegbetɔ, egblɔ nu si nyo la na wò.</para>
  <para style="q2" vid="MIC 6:8">Nu ka Yehowa di tso asiwò?</para>
  <para style="q1" vid="MIC 6:8">Be nàwɔ nu si le eteƒe, alɔ̃ nublanuikpɔkpɔ eye nàzɔ</para>
  <para style="q2" vid="MIC 6:8">kple wò Mawu la le ɖokuibɔbɔ me.<verse eid="MIC 6:8"/></para>
  <para style="s1">Israel ƒe agɔdzedze kple tohehe</para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 6:9"/>“Miɖo to! Yehowa le Yerusalem dua katã yɔm.</para>
  <para style="q2" vid="MIC 6:9">Ame si vɔa wò ŋkɔ la, nunyalae.</para>
  <para style="q2" vid="MIC 6:9">Miɖo to ameƒoti la kple Ame si dɔe ɖa.<verse eid="MIC 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 6:10"/>O, aƒe vɔ̃ɖi! Ɖe maŋlɔ wò kesinɔnu madzɔmadzɔ</para>
  <para style="q2" vid="MIC 6:10">kple nudotre sue si dzi fiƒode le la bea?<verse eid="MIC 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 6:11"/>Ɖe matso afia na ame aɖe ne nudanu madzɔmadzɔ le esi</para>
  <para style="q2" vid="MIC 6:11">eye nudakpe amebatɔwo yɔ akplo me nɛ fũua?<verse eid="MIC 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 6:12"/>Miaƒe kesinɔtɔwo yɔ fũu kple ŋutasẽse</para>
  <para style="q2" vid="MIC 6:12">eye miaƒe dukɔmeviwo daa alakpa</para>
  <para style="q2" vid="MIC 6:12">eye amebeble le aɖe dzi na wo.<verse eid="MIC 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 6:13"/>Eya ta nye hã matsrɔ̃ wò,</para>
  <para style="q2" vid="MIC 6:13">agbã wò gudugudu ɖe wò nu vɔ̃wo ta.<verse eid="MIC 6:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 6:14"/>Àɖu nu, ke màɖi ƒo o,</para>
  <para style="q2" vid="MIC 6:14">eye dɔ anɔ wuwòm ɖaa.</para>
  <para style="q1" vid="MIC 6:14">Àdzra nu gbogbowo ɖo, ke naneke masusɔ na wò o,</para>
  <para style="q2" vid="MIC 6:14">elabena ne ɖe susɔ gɔ̃ hã la,</para>
  <para style="q2" vid="MIC 6:14">matsɔe ade asi na yi.<verse eid="MIC 6:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 6:15"/>Àƒã nu, ke màŋe nu o;</para>
  <para style="q2" vid="MIC 6:15">àɖa ami, gake màkpɔ ami asi o;</para>
  <para style="q2" vid="MIC 6:15">àfia waintsetse, ke màkpɔ wain ano o.<verse eid="MIC 6:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 6:16"/>Miewɔ nu ɖe Omri ƒe sewo nu</para>
  <para style="q2" vid="MIC 6:16">eye miewɔ Ahab ƒe aƒe la ƒe nuwɔnawo katã.</para>
  <para style="q1" vid="MIC 6:16">Miedze woƒe nuɖoanyiwo yome</para>
  <para style="q2" vid="MIC 6:16">eya ta matsɔ mi ade asi na gbegblẽ</para>
  <para style="q1" vid="MIC 6:16">eye wò amewo azu alɔmeɖenu;</para>
  <para style="q2" vid="MIC 6:16">ale dukɔwo ƒe vlododo ava dziwò.”<verse eid="MIC 6:16"/></para>
  <chapter eid="MIC 6"/>
  <chapter number="7" style="c" sid="MIC 7"/>
  <para style="s1">Israel ƒe nublanuitɔnyenye</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 7:1"/>Baba nam!</para>
  <para style="q2" vid="MIC 7:1">Elabena mele ko abe ame aɖe si</para>
  <para style="q1" vid="MIC 7:1">le kutsetse dim vevie le ati dzi</para>
  <para style="q2" vid="MIC 7:1">le esi nuŋeɣi nu va yi vɔ la ene.</para>
  <para style="q1" vid="MIC 7:1">Elabena nyemekpɔ kutsetse ɖiɖi aɖeke agbe,</para>
  <para style="q2" vid="MIC 7:1">aɖu, atsɔ atsi nye dɔwuame nu o.<verse eid="MIC 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 7:2"/>Alea kee ame nyuiwo hã vɔ le anyigba la dzi.</para>
  <para style="q2" vid="MIC 7:2">Mate ŋu akpɔ ame ɖɔʋu ɖeka hɔ̃ɔ hã o.</para>
  <para style="q1" vid="MIC 7:2">Ame sia ame le klalo be yeakɔ ʋu ɖi</para>
  <para style="q2" vid="MIC 7:2">eye ame sia ame ɖo ɖɔ ɖi na nɔvia.<verse eid="MIC 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 7:3"/>Woƒe asi eveawo bi ɖe nu vɔ̃ɖi wɔwɔ me.</para>
  <para style="q2" vid="MIC 7:3">Dziɖula xɔa zãnu eye ʋɔnudrɔ̃la tsoa afia</para>
  <para style="q2" vid="MIC 7:3">na ame si na zãnue.</para>
  <para style="q1" vid="MIC 7:3">Kesinɔtɔwo ɖoa nu si dim wole;</para>
  <para style="q2" vid="MIC 7:3">ale ame siawo blaa nu ɖekae hewɔna.<verse eid="MIC 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 7:4"/>Ame nyuitɔ si nàkpɔ le wo dome la le ko abe ŋu si tɔa</para>
  <para style="q2" vid="MIC 7:4">ame ene eye woƒe nuteƒewɔla vɔ̃ɖi wu ŋukpɔtɔtɔ.</para>
  <para style="q1" vid="MIC 7:4">Ke miaƒe gbetakpɔlawo ƒe ŋkeke la ɖo vɔ.</para>
  <para style="q2" vid="MIC 7:4">Gbe si gbe Mawu ava asrã mi kpɔ la tu aƒe.</para>
  <para style="q1" vid="MIC 7:4">Azɔ ɣeyiɣi si tɔtɔ aɖo wo dome la ɖo vɔ.<verse eid="MIC 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 7:5"/>Mègaxɔ wò aƒelika dzi se o.</para>
  <para style="q2" vid="MIC 7:5">Mègaɖo dzi ɖe xɔ̃wò ŋu o.</para>
  <para style="q1" vid="MIC 7:5">Nya ale si nàƒo nu le nyɔnu si</para>
  <para style="q2" vid="MIC 7:5">le akɔwò nu la gɔ̃ hã gbɔ<verse eid="MIC 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 7:6"/>elabena viŋutsu made bubu fofoa ŋu o;</para>
  <para style="q2" vid="MIC 7:6">vinyɔnu adze aglã ɖe dadaa ŋu</para>
  <para style="q1" vid="MIC 7:6">eye lɔ̃xoyɔvi atso ɖe lɔ̃xoa ŋu.</para>
  <para style="q2" vid="MIC 7:6">Ame ƒe futɔwo atso eya ŋutɔ ƒe aƒe me.<verse eid="MIC 7:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 7:7"/>Ke nye la, mele ŋudzɔ le mɔ kpɔm na Yehowa.</para>
  <para style="q2" vid="MIC 7:7">Mele lalam na Mawu, nye Ɖela.</para>
  <para style="q2" vid="MIC 7:7">Ɛ̃, nye Mawu aɖo tom hã.<verse eid="MIC 7:7"/></para>
  <para style="s1">Israel agatsitre</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 7:8"/>O nye futɔ, dzi megadzɔ wò le nye anyidzedze ŋuti o;</para>
  <para style="q2" vid="MIC 7:8">togbɔ be medze anyi hã la,</para>
  <para style="q2" vid="MIC 7:8">magafɔ ɖe tsitre!</para>
  <para style="q1" vid="MIC 7:8">Ne menɔ anyi ɖe viviti tsiɖitsiɖi me hã,</para>
  <para style="q2" vid="MIC 7:8">Yehowa ŋutɔ anye nye kekeli.<verse eid="MIC 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 7:9"/>Esi meda vo ɖe Yehowa ŋuti ta la</para>
  <para style="q2" vid="MIC 7:9">mabɔbɔ ɖe eƒe dɔmedzoe te va se ɖe esime wòadrɔ̃ nye nya</para>
  <para style="q1" vid="MIC 7:9">eye wòatso afia nam, ekema akplɔm va kekeli me</para>
  <para style="q2" vid="MIC 7:9">eye makpɔ eƒe dzɔdzɔenyenye.<verse eid="MIC 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 7:10"/>Ekema nye futɔ akpɔe eye ŋu akpee.</para>
  <para style="q2" vid="MIC 7:10">Eya ame si bia be,</para>
  <para style="q1" vid="MIC 7:10">“Afi ka Yehowa wò Mawu la le?”</para>
  <para style="q2" vid="MIC 7:10">Azɔ mekpɔ eƒe anyidzedze kple nye ŋkuwo</para>
  <para style="q2" vid="MIC 7:10">kple ale si woanyamae abe ba ene.<verse eid="MIC 7:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 7:11"/>Ŋkeke si dzi woatu wò duwo la ava</para>
  <para style="q2" vid="MIC 7:11">eye ŋkeke na wò liƒowo ƒe keke ɖe edzi gbɔna.<verse eid="MIC 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 7:12"/>Ɣe ma ɣi la, amewo atso Asiria</para>
  <para style="q2" vid="MIC 7:12">kple Egipte ƒe duwo me ava</para>
  <para style="q1" vid="MIC 7:12">eye ɖewo atso Egipte va se ɖe</para>
  <para style="q2" vid="MIC 7:12">keke Frat tɔsisi la nu.</para>
  <para style="q1" vid="MIC 7:12">Gawu la, amewo atso atsiaƒu nu yi atsiaƒu nu,</para>
  <para style="q2" vid="MIC 7:12">tso to dzi yi to dzi, ava kpɔ wò ɖa.<verse eid="MIC 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 7:13"/>Ke anyigba aɖi gbɔlo le edzinɔlawo ƒe nu vɔ̃wo ta.<verse eid="MIC 7:13"/></para>
  <para style="s1">Gbedodoɖa kple kafukafu</para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 7:14"/>O Yehowa, va kplɔ wò dukɔ kple wò atizɔti,</para>
  <para style="q2" vid="MIC 7:14">alẽha si nye wò domenyinu;</para>
  <para style="q1" vid="MIC 7:14">alẽha si nɔ eɖokui si le avewo me</para>
  <para style="q2" vid="MIC 7:14">kple lãnyiƒe damawo dzi.</para>
  <para style="q1" vid="MIC 7:14">Na woaɖu gbe damawo le Basan</para>
  <para style="q2" vid="MIC 7:14">kple Gilead abe tsã ene.<verse eid="MIC 7:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 7:15"/>“Abe ale si wònɔ le ŋkeke</para>
  <para style="q2" vid="MIC 7:15">siwo me nèdo go tso Egipte ene la,</para>
  <para style="q2" vid="MIC 7:15">mafia wo nye nukunuwo.”<verse eid="MIC 7:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 7:16"/>Dukɔwo akpɔe eye ŋukpe alé wo</para>
  <para style="q2" vid="MIC 7:16">elabena woƒe ŋusẽwo katã nu ayi.</para>
  <para style="q1" vid="MIC 7:16">Woatsɔ woƒe asiwo aɖo nu eye woƒe towo atsi.<verse eid="MIC 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="MIC 7:17"/>Woaɖu ʋuʋudedi abe da</para>
  <para style="q2" vid="MIC 7:17">kple nu gbagbe siwo tana le anyigba la ene.</para>
  <para style="q1" vid="MIC 7:17">Woado le woƒe dowo me kple vɔvɔ̃,</para>
  <para style="q2" vid="MIC 7:17">atrɔ ɖe Yehowa, míaƒe Mawu la</para>
  <para style="q2" vid="MIC 7:17">ŋu eye woavɔ̃ miawo hã.<verse eid="MIC 7:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MIC 7:18"/>Afi ka woagakpɔ Mawu bubu le</para>
  <para style="q2" vid="MIC 7:18">wòanɔ abe wò si tsɔa wò</para>
  <para style="q1" vid="MIC 7:18">domenyinu mamlɛawo ƒe nu vɔ̃wo</para>
  <para style="q2" vid="MIC 7:18">kple dzidadawo kena la ene?</para>
  <para style="q1" vid="MIC 7:18">Mèdoa dɔmedzoe ɖikaa o, ke boŋ</para>
  <para style="q2" vid="MIC 7:18">èkpɔa dzidzɔ le amenuveve ŋuti.<verse eid="MIC 7:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="MIC 7:19"/>Àgakpɔ nublanui na mí,</para>
  <para style="q2" vid="MIC 7:19">atiti afɔ ɖe míaƒe nu vɔ̃wo dzi</para>
  <para style="q1" vid="MIC 7:19">eye àtsɔ míaƒe dzidadawo katã</para>
  <para style="q2" vid="MIC 7:19">aƒu gbe ɖe atsiaƒu ƒe gogloƒe ke!<verse eid="MIC 7:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="MIC 7:20"/>Àwɔ nuteƒe na Yakob,</para>
  <para style="q2" vid="MIC 7:20">eye àkpɔ nublanui</para>
  <para style="q1" vid="MIC 7:20">na Abraham abe ale si nèka atam</para>
  <para style="q2" vid="MIC 7:20">na mía fofowo tso blema ke ene.<verse eid="MIC 7:20"/></para>
  <chapter eid="MIC 7"/>
</usx>
