<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PSA" style="id">- Biblica® Open Ewe Contemporary Scriptures 2020</book>
  <para style="h">Psalmowo</para>
  <para style="toc1">Psalmowo</para>
  <para style="toc2">Psalmowo</para>
  <para style="toc3">Psa</para>
  <para style="mt1">Psalmowo</para>
  <chapter number="1" style="c" sid="PSA 1"/>
  <para style="ms">Agbalẽ gbãtɔ</para>
  <para style="mr">
    <ref loc="PSA 1-41">Psalmowo 1–41</ref></para>
  <para style="cl">Psalmo 1</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 1:1"/>Woayra ame si</para>
  <para style="q2" vid="PSA 1:1">mezɔna ɖe ame vɔ̃ɖiwo ƒe aɖaŋuɖoɖo nu</para>
  <para style="q1" vid="PSA 1:1">alo nɔa tsitre ɖe nu vɔ̃ wɔlawo ƒe mɔ dzi loo</para>
  <para style="q2" vid="PSA 1:1">alo nɔa anyi ɖe fewuɖulawo dome o,<verse eid="PSA 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 1:2"/>ke boŋ ekpɔa dzidzɔ le Yehowa ƒe se la ŋu,</para>
  <para style="q2" vid="PSA 1:2">eye wòdea ŋugble le eŋu zã kple keli.<verse eid="PSA 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 1:3"/>Eya amea ɖi ati si wodo ɖe tɔʋuwo to,</para>
  <para style="q2" vid="PSA 1:3">esi tsea ku le etseɣi,</para>
  <para style="q1" vid="PSA 1:3">melũa xe o, eye</para>
  <para style="q2" vid="PSA 1:3">nu sia nu si wòwɔna la, edzea edzi nyuie.<verse eid="PSA 1:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 1:4"/>Mele alea na ame vɔ̃ɖi ya o!</para>
  <para style="q2" vid="PSA 1:4">Wole abe blitsro si ya ƒona dzonae la ene.<verse eid="PSA 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 1:5"/>Eya ta ame vɔ̃ɖi manɔ te le ʋɔnudrɔ̃gbe,</para>
  <para style="q2" vid="PSA 1:5">alo nu vɔ̃ wɔlawo nanɔ ame dzɔdzɔewo ƒe ha me o.<verse eid="PSA 1:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 1:6"/>Elabena Yehowa kpɔa ame dzɔdzɔewo ƒe mɔ ta,</para>
  <para style="q2" vid="PSA 1:6">ke ame vɔ̃ɖiwo ƒe mɔ atsrɔ̃ gbidii.<verse eid="PSA 1:6"/></para>
  <chapter eid="PSA 1"/>
  <chapter number="2" style="c" sid="PSA 2"/>
  <para style="cl">Psalmo 2</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 2:1"/>Nu ka ta dukɔwo le nugbe ɖom,</para>
  <para style="q2" vid="PSA 2:1">eye amewo le nu dzodzrowo ɖom?<verse eid="PSA 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 2:2"/>Anyigbadzifiawo ɖo afɔ anyi sesĩe,</para>
  <para style="q2" vid="PSA 2:2">eye dumegãwo ƒo ta kpli ɖe aɖaŋu me ɖe</para>
  <para style="q2" vid="PSA 2:2">Yehowa kple eƒe amesiamina la ŋu.<verse eid="PSA 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 2:3"/>Wole gbɔgblɔm be,</para>
  <para style="q2" vid="PSA 2:3">“Mina míado le Yehowa kple eƒe amesiamina la te,</para>
  <para style="q2" vid="PSA 2:3">eye míana ablɔɖe mía ɖokuiwo.”<verse eid="PSA 2:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 2:4"/>Ame si woɖo zi dzi le dziƒo la ko nu,</para>
  <para style="q2" vid="PSA 2:4">eye Yehowa ɖe alɔme le wo ŋu.<verse eid="PSA 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 2:5"/>Tete wòka mo na wo le eƒe dɔmedzoe me,</para>
  <para style="q2" vid="PSA 2:5">eye wòdo ŋɔdzi na wo le eƒe dziku helĩhelĩ me hegblɔ be,<verse eid="PSA 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 2:6"/>“Meɖo nye ŋutɔ nye fia ɖe Zion,</para>
  <para style="q2" vid="PSA 2:6">nye to kɔkɔe la dzi.”<verse eid="PSA 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 2:7"/>Maɖe gbeƒã Yehowa ƒe sedede la;</para>
  <para style="q1" vid="PSA 2:7">Yehowa gblɔ nam be,</para>
  <para style="q2" vid="PSA 2:7">“Wòe nye vinye ŋutsu,</para>
  <para style="q2" vid="PSA 2:7">egbea mezu fofowò.<verse eid="PSA 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 2:8"/>Biam, ne matsɔ dukɔwo awɔ wò domenyinui</para>
  <para style="q2" vid="PSA 2:8">kple anyigba ƒe seƒewo ke awɔ tɔwòe.<verse eid="PSA 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 2:9"/>Àtsɔ gafiatikplɔ aɖu wo dzii, eye àxlã wo ɖi,</para>
  <para style="q2" vid="PSA 2:9">woakaka abe ale si ze gbãnae ene.”<verse eid="PSA 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 2:10"/>Eya ta mi fiawo, midze nunya,</para>
  <para style="q2" vid="PSA 2:10">eye mi anyigbadzidumegãwo, miɖo to nuxlɔ̃ame.<verse eid="PSA 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 2:11"/>Mitsɔ ɖokuibɔbɔ kple bubu subɔ Yehowa le dzidzɔ gã me</para>
  <para style="q2" vid="PSA 2:11">kple dzodzo nyanyanya.<verse eid="PSA 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 2:12"/>Mitsɔ ɖokuibɔbɔ do ɖe fia la ŋkume, ne menye nenema o la,</para>
  <para style="q2" vid="PSA 2:12">ado dziku, eye wòatsrɔ̃ mi kpata,</para>
  <para style="q1" vid="PSA 2:12">elabena eƒe dɔmedzoe ate ŋu afla ɣe sia ɣi.</para>
  <para style="q2" vid="PSA 2:12">Woayra ame siwo katã tsɔe wɔ sitsoƒee.<verse eid="PSA 2:12"/></para>
  <chapter eid="PSA 2"/>
  <chapter number="3" style="c" sid="PSA 3"/>
  <para style="cl">Psalmo 3</para>
  <para style="d">David ƒe ha, esi wòsi le via Absalom nu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 3:1"/>O, Yehowa, aleke nye futɔwo sɔ gbɔ ale!</para>
  <para style="q2" vid="PSA 3:1">Aleke ame geɖewo tso ɖe ŋunye ale!<verse eid="PSA 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 3:2"/>Ame geɖewo le gbɔgblɔm tso ŋutinye be,</para>
  <para style="q2" vid="PSA 3:2">“Mawu maɖee akpɔ o.” <char style="qs">Sela</char><verse eid="PSA 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 3:3"/>O, Yehowa, ke wò la, ènye akpoxɔnu ƒo xlãm;</para>
  <para style="q2" vid="PSA 3:3">ètsɔ ŋutikɔkɔe kɔ ɖe dzinye, eye nèkɔ nye ta dzi.<verse eid="PSA 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 3:4"/>Yehowae medo ɣli na sesĩe,</para>
  <para style="q2" vid="PSA 3:4">eye wòtɔ nam tso eƒe to kɔkɔe la dzi. <char style="qs">Sela</char><verse eid="PSA 3:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 3:5"/>Memlɔ anyi hedɔ alɔ̃;</para>
  <para style="q2" vid="PSA 3:5">meganyɔ, elabena Yehowae kpɔ tanye.<verse eid="PSA 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 3:6"/>Nyemavɔ̃ na ame akpe nane siwo ho,</para>
  <para style="q2" vid="PSA 3:6">ɖe to ɖem godoo la o.<verse eid="PSA 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 3:7"/>Tso, O, Yehowa! Ɖem, O, nye Mawu!</para>
  <para style="q2" vid="PSA 3:7">Ƒo tome na nye futɔwo katã;</para>
  <para style="q2" vid="PSA 3:7">eye nàŋe aɖu na ame vɔ̃ɖiwo.<verse eid="PSA 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 3:8"/>Yehowa gbɔe ɖeɖe tsona.</para>
  <para style="q2" vid="PSA 3:8">Na be wò yayra nanɔ wò amewo dzi. <char style="qs">Sela.</char><verse eid="PSA 3:8"/></para>
  <chapter eid="PSA 3"/>
  <chapter number="4" style="c" sid="PSA 4"/>
  <para style="cl">Psalmo 4</para>
  <para style="d">David ƒe ha na hɛnɔ la. Woadzii ɖe kasaŋku ŋu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 4:1"/>Nye Mawu dzɔdzɔetɔ,</para>
  <para style="q2" vid="PSA 4:1">tɔ nam ne meyɔ wò.</para>
  <para style="q1" vid="PSA 4:1">Na gbɔdzɔem le nye xaxa me;</para>
  <para style="q2" vid="PSA 4:1">kpɔ nye nublanui, eye nàse nye gbedodoɖa.<verse eid="PSA 4:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 4:2"/>O! Amegbetɔviwo, va se ɖe ɣe ka ɣie</para>
  <para style="q2" vid="PSA 4:2">miaɖi gbɔ̃ nye ŋutikɔkɔe?</para>
  <para style="q1" vid="PSA 4:2">Va se ɣe ka ɣie mialɔ̃ beble,</para>
  <para style="q2" vid="PSA 4:2">ahadze aʋatsomawuwo yome? <char style="qs">Sela</char><verse eid="PSA 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 4:3"/>Minyae be Yehowa tia mawuvɔ̃lawo na eɖokui,</para>
  <para style="q2" vid="PSA 4:3">eya ta Yehowa asee, ne meyɔe.<verse eid="PSA 4:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 4:4"/>Migawɔ nu vɔ̃ ne dzi ku mi o;</para>
  <para style="q2" vid="PSA 4:4">ne miele miaƒe abawo dzi la,</para>
  <para style="q2" vid="PSA 4:4">midzro miaƒe dziwo me, eye mizi ɖoɖoe. <char style="qs">Sela</char><verse eid="PSA 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 4:5"/>Misa vɔ siwo le dzɔdzɔe,</para>
  <para style="q2" vid="PSA 4:5">eye miɖo dzi ɖe Yehowa ŋu.<verse eid="PSA 4:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 4:6"/>Ame geɖewo le biabiam be, “Ame kae afia nu nyui aɖe mí?”</para>
  <para style="q2" vid="PSA 4:6">Na wò mo ƒe kekeli naklẽ ɖe mía dzi, O! Yehowa.<verse eid="PSA 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 4:7"/>Ètsɔ dzidzɔ gã aɖe yɔ nye dzi me wu ame siwo bli</para>
  <para style="q2" vid="PSA 4:7">kple wain yeye do agbogbo na.<verse eid="PSA 4:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 4:8"/>Mamlɔ anyi, adɔ alɔ̃ le ŋutifafa me,</para>
  <para style="q2" vid="PSA 4:8">elabena wò, Yehowa, koe na mele dedie.<verse eid="PSA 4:8"/></para>
  <chapter eid="PSA 4"/>
  <chapter number="5" style="c" sid="PSA 5"/>
  <para style="cl">Psalmo 5</para>
  <para style="d">David ƒe ha na hɛnɔ la. Woadzii kple kpẽ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 5:1"/>O! Yehowa, ɖo to nye nyawo,</para>
  <para style="q2" vid="PSA 5:1">eye nàse nye hũɖeɖe.<verse eid="PSA 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 5:2"/>Fianye kple Mawunye,</para>
  <para style="q2" vid="PSA 5:2">ɖo to nye ɣlidodo,</para>
  <para style="q2" vid="PSA 5:2">elabena wòe mele gbe dom ɖa na.<verse eid="PSA 5:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 5:3"/>O! Yehowa, le ŋdi me la, àse nye gbe;</para>
  <para style="q2" vid="PSA 5:3">le ŋdi me la, matsɔ nye biabiawo aɖo ŋkuwò me,</para>
  <para style="q2" vid="PSA 5:3">eye manɔ lalam kple mɔkpɔkpɔ.<verse eid="PSA 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 5:4"/>Menye Mawu si kpɔa dzidzɔ le vɔ̃ ŋutie nènye o;</para>
  <para style="q2" vid="PSA 5:4">wò la, ame vɔ̃ɖiwo mate ŋu anɔ gbɔwò o.<verse eid="PSA 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 5:5"/>Ɖokuiŋudzelawo mate ŋu atsi tsitre ɖe ŋkuwò me o;</para>
  <para style="q2" vid="PSA 5:5">elabena èlé fu nu vlo wɔlawo katã.<verse eid="PSA 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 5:6"/>Ètsrɔ̃ aʋatsokalawo;</para>
  <para style="q2" vid="PSA 5:6">Yehowa tsri hlɔ̃dolawo kple ameblelawo.<verse eid="PSA 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 5:7"/>Ke nye ya, mava wò aƒe me to wò nublanuikpɔkpɔ gã la me.</para>
  <para style="q2" vid="PSA 5:7">Matsɔ bubu ade ta agu ɖe wò gbedoxɔ kɔkɔe la ŋgɔ.<verse eid="PSA 5:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 5:8"/>Kplɔm, O! Yehowa,</para>
  <para style="q2" vid="PSA 5:8">le wò dzɔdzɔenyenye nu le nye futɔwo ta,</para>
  <para style="q2" vid="PSA 5:8">eye wɔ wò mɔwo dzɔdzɔe le ŋkunye me.<verse eid="PSA 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 5:9"/>Womate ŋu axɔ nya siwo doa go tso</para>
  <para style="q2" vid="PSA 5:9">woƒe nu me la ɖeka pɛ hã dzi ase o,</para>
  <para style="q2" vid="PSA 5:9">woƒe dzi yɔ fũu kple gbegblẽ.</para>
  <para style="q1" vid="PSA 5:9">Woƒe ve me le abe yɔdo si le ʋuʋu ɖi la ene,</para>
  <para style="q2" vid="PSA 5:9">eye wotsɔa woƒe aɖe gblɔa alakpanyawoe.<verse eid="PSA 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 5:10"/>O! Mawu, bu fɔ wo!</para>
  <para style="q2" vid="PSA 5:10">Na be woƒe ayemɔwo naƒu wo anyi.</para>
  <para style="q1" vid="PSA 5:10">Ɖe wo ɖa le woƒe nu vɔ̃ gbogboawo ta,</para>
  <para style="q2" vid="PSA 5:10">elabena wodze aglã ɖe ŋuwò.<verse eid="PSA 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 5:11"/>Ke na ame siwo si wò tso la nakpɔ dzidzɔ,</para>
  <para style="q2" vid="PSA 5:11">eye na be woadzi ha kple dzidzɔ tegbee.</para>
  <para style="q1" vid="PSA 5:11">Keke wò ametakpɔkpɔ ɖe wo dzi,</para>
  <para style="q2" vid="PSA 5:11">ale be ame siwo lɔ̃ wò ŋkɔ la natso aseye le mewò.<verse eid="PSA 5:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 5:12"/>O! Yehowa, èyraa ame dzɔdzɔewo vavã,</para>
  <para style="q2" vid="PSA 5:12">eye nètsɔa wò amenuveve ƒoa xlã wo abe akpoxɔnu ene.<verse eid="PSA 5:12"/></para>
  <chapter eid="PSA 5"/>
  <chapter number="6" style="c" sid="PSA 6"/>
  <para style="cl">Psalmo 6</para>
  <para style="d">David ƒe ha na hɛnɔ la. Woadzii ɖe kasaŋku kple <char style="tl">seminit</char> ŋu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 6:1"/>O! Yehowa, mègaka mo nam le wò dziku me</para>
  <para style="q2" vid="PSA 6:1">alo ahe to nam le wò dɔmedzoe helĩhelĩ me o.<verse eid="PSA 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 6:2"/>Yehowa, kpɔ nublanui nam, elabena nu te ŋunye.</para>
  <para style="q2" vid="PSA 6:2">O! Yehowa, yɔ dɔm, elabena nye ƒuwo le veve sem.<verse eid="PSA 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 6:3"/>Nye luʋɔ le nuxaxa me.</para>
  <para style="q2" vid="PSA 6:3">Va se ɖe ɣe ka ɣi, O! Yehowa,</para>
  <para style="q2" vid="PSA 6:3">va se ɖe ɣe ka ɣi?<verse eid="PSA 6:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 6:4"/>O! Yehowa, trɔ ɖe ŋunye, eye nàɖem;</para>
  <para style="q2" vid="PSA 6:4">ɖem, le wò lɔlɔ̃ si meʋãna o la ta.<verse eid="PSA 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 6:5"/>Ame aɖeke meɖoa ŋku dziwò ne eku o.</para>
  <para style="q2" vid="PSA 6:5">Ame kae kafua wò tso eƒe yɔdo me?<verse eid="PSA 6:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 6:6"/>Mevɔ le eme keŋkeŋ le ŋeŋe ta;</para>
  <para style="q2" vid="PSA 6:6">metsɔ aɖatsi ƒo nye aba, elabena mefa avi zã blibo la,</para>
  <para style="q2" vid="PSA 6:6">eye nye aɖatsi wɔe be nye dɔƒe ƒo tsi belebele.<verse eid="PSA 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 6:7"/>Nuxaxa na ɖeɖi te nye ŋkuwo ŋu;</para>
  <para style="q2" vid="PSA 6:7">womegale nu kpɔm tututu o, le nye futɔwo ta.<verse eid="PSA 6:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 6:8"/>Mite ɖa le gbɔnye, mi nu vlo wɔlawo,</para>
  <para style="q2" vid="PSA 6:8">elabena Yehowa se nye avifafa.<verse eid="PSA 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 6:9"/>Yehowa se ɣli si medo be wòakpɔ nye nublanui;</para>
  <para style="q2" vid="PSA 6:9">Yehowa xɔ nye gbedodoɖa alɔ eve.<verse eid="PSA 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 6:10"/>Nye futɔwo katã ŋu akpe mi, eye miaƒe mo atsi dãa;</para>
  <para style="q2" vid="PSA 6:10">woagbugbɔ ɖe megbe enumake kple ŋukpe.<verse eid="PSA 6:10"/></para>
  <chapter eid="PSA 6"/>
  <chapter number="7" style="c" sid="PSA 7"/>
  <para style="cl">Psalmo 7</para>
  <para style="d">David ƒe konyifaha si wòdzi na Yehowa le Benyamintɔ, Kus ƒe nyawo ta.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 7:1"/>O! Yehowa, nye Mawu, wòe mesi tso,</para>
  <para style="q2" vid="PSA 7:1">xɔ nam, eye nàɖem tso ame siwo katã le yonyeme tim la ƒe asi me.<verse eid="PSA 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 7:2"/>Ne menye nenema o la,</para>
  <para style="q2" vid="PSA 7:2">woavuvum abe ale si dzata vuvua nui ene,</para>
  <para style="q1" vid="PSA 7:2">eye woavuvum ʋayaʋaya,</para>
  <para style="q2" vid="PSA 7:2">xɔnametɔ aɖeke mava ɖem o.<verse eid="PSA 7:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 7:3"/>O! Yehowa, nye Mawu,</para>
  <para style="q2" vid="PSA 7:3">ne mewɔ nu sia, eye vɔ̃ lé ɖe nye asiwo ŋu,<verse eid="PSA 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 7:4"/>ne mewɔ nu vɔɖi ɖe ame si li kplim le ŋutifafa me ŋuti</para>
  <para style="q2" vid="PSA 7:4">alo meda adzo nye futɔ naneke mawɔmawɔtɔe la,<verse eid="PSA 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 7:5"/>ekema na nye futɔ nati yonyeme, eye eƒe asi nasu dzinye;</para>
  <para style="q2" vid="PSA 7:5">na be wòafanyam ɖe anyigba,</para>
  <para style="q2" vid="PSA 7:5">eye wòana matsi ke me adɔ. <char style="qs">Sela</char><verse eid="PSA 7:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 7:6"/>O! Yehowa, tso, le wò dziku me;</para>
  <para style="q2" vid="PSA 7:6">tso ɖe nye futɔwo ƒe nyanyra ŋuti.</para>
  <para style="q2" vid="PSA 7:6">Nyɔ, nye Mawu, ne nàɖo ʋɔnu dzɔdzɔe dɔdrɔ̃ anyi.<verse eid="PSA 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 7:7"/>Na be amehawo naƒo ƒu ɖe ŋuwò.</para>
  <para style="q2" vid="PSA 7:7">Ɖu fia ɖe wo dzi tso dziƒo;<verse eid="PSA 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 7:8"/>na be Yehowa nadrɔ̃ ʋɔnu dukɔ la.</para>
  <para style="q2" vid="PSA 7:8">O! Yehowa, tso afia nam le nye dzɔdzɔenyenye ta,</para>
  <para style="q2" vid="PSA 7:8">O! Dziƒoʋĩtɔ, tso afia nam le nye nuteƒewɔwɔ ta.<verse eid="PSA 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 7:9"/>O! Mawu dzɔdzɔetɔ,</para>
  <para style="q2" vid="PSA 7:9">ame si dzroa susuwo kple dziwo me,</para>
  <para style="q1" vid="PSA 7:9">na ame vɔ̃ɖiwo ƒe nu vɔ̃ɖi wɔwɔ nu natso,</para>
  <para style="q2" vid="PSA 7:9">eye nàna dedinɔnɔ ame dzɔdzɔewo.<verse eid="PSA 7:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 7:10"/>Nye akpoxɔnue nye Mawu Dziƒoʋĩtɔ la,</para>
  <para style="q2" vid="PSA 7:10">ame si ɖea ame si dza le eƒe dzi me.<verse eid="PSA 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 7:11"/>Mawue nye ʋɔnudrɔ̃la dzɔdzɔe,</para>
  <para style="q2" vid="PSA 7:11">Mawu si ɖea eƒe dɔmedzoe fiana gbe sia gbe.<verse eid="PSA 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 7:12"/>Nu metia kɔ nɛ o, anyre eƒe yi,</para>
  <para style="q2" vid="PSA 7:12">eye wòavu eƒe dati me.<verse eid="PSA 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 7:13"/>Edzra eƒe lãnuwo ɖo da ɖi,</para>
  <para style="q2" vid="PSA 7:13">eye eƒe aŋutrɔ bibiawo la etrɔ asi le wo ŋu wosɔ gbe.<verse eid="PSA 7:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 7:14"/>Ame si fɔ nu vɔ̃ɖi ƒe fu,</para>
  <para style="q2" vid="PSA 7:14">eye dzɔgbevɔ̃e zu fu wòfɔ la,</para>
  <para style="q2" vid="PSA 7:14">adzi beble ƒe vi.<verse eid="PSA 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 7:15"/>Ame si ɖe ʋe, heku eme wògoglo nyuie la age dze ʋe si</para>
  <para style="q2" vid="PSA 7:15">eya ŋutɔ ɖe la me.<verse eid="PSA 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 7:16"/>Dzɔgbevɔ̃e si wòhe vɛ la atrɔ abali ɖe eya ŋutɔ ŋuti,</para>
  <para style="q2" vid="PSA 7:16">eye eƒe ŋutasesẽ atrɔ ava eya ŋutɔ ƒe ta dzi.<verse eid="PSA 7:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 7:17"/>Mada akpe na Yehowa le eƒe dzɔdzɔenyenye ta,</para>
  <para style="q2" vid="PSA 7:17">eye madzi kafukafuha na Yehowa Dziƒoʋĩtɔ la ƒe ŋkɔ.<verse eid="PSA 7:17"/></para>
  <chapter eid="PSA 7"/>
  <chapter number="8" style="c" sid="PSA 8"/>
  <para style="cl">Psalmo 8</para>
  <para style="d">David ƒe ha na hɛnɔ la. Woadzii ɖe <char style="tl">gitit</char> ƒe gbeɖiɖi nu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 8:1"/>O Yehowa, míaƒe Aƒetɔ,</para>
  <para style="q2" vid="PSA 8:1">aleke wò ŋkɔ ƒe gãnyenye yɔ anyigba katã dzi ale!</para>
  <para style="b" vid="PSA 8:1"/>
  <para style="q1" vid="PSA 8:1">Èɖo wò ŋutikɔkɔe anyi</para>
  <para style="q2" vid="PSA 8:1">ɖe dziƒowo tame.<verse eid="PSA 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 8:2"/>Èɖo kafukafu anyi ɖe ɖeviwo</para>
  <para style="q2" vid="PSA 8:2">kple vi nonowo ƒe nu me le wò futɔwo ta be</para>
  <para style="q2" vid="PSA 8:2">nàmia nu na futɔ kple hlɔ̃biala la.<verse eid="PSA 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 8:3"/>Ne mekpɔ wò dziƒowo,</para>
  <para style="q2" vid="PSA 8:3">siwo nye wò asinudɔwɔwɔwo,</para>
  <para style="q1" vid="PSA 8:3">ne mekpɔ ɣleti kple ɣletiviwo,</para>
  <para style="q2" vid="PSA 8:3">nu siwo nètsɔ ɖo wo nɔƒee la,<verse eid="PSA 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 8:4"/>Nu kae nye amegbetɔ be wò ŋkuwo le eŋuti</para>
  <para style="q2" vid="PSA 8:4">kple amegbetɔvi be nèléa be nɛ?<verse eid="PSA 8:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 8:5"/>Èwɔe wòsɔ kple Mawu kloe,</para>
  <para style="q2" vid="PSA 8:5">eye nètsɔ ŋutikɔkɔe kple bubu ɖɔ nɛ.<verse eid="PSA 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 8:6"/>Èwɔe be wòanye agbo ɖe wò asinudɔwɔwɔ dzi;</para>
  <para style="q2" vid="PSA 8:6">eye nètsɔ nu sia nu de eƒe afɔ te.<verse eid="PSA 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 8:7"/>Alẽhawo, nyihawo,</para>
  <para style="q2" vid="PSA 8:7">gbemelãwo,<verse eid="PSA 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 8:8"/>dziƒoxeviwo, ƒumelãwo</para>
  <para style="q2" vid="PSA 8:8">kple nu siwo katã ƒua tsi</para>
  <para style="q2" vid="PSA 8:8">le atsiaƒu me la le eƒe kpɔkplɔ te.<verse eid="PSA 8:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 8:9"/>O Yehowa, míaƒe Aƒetɔ,</para>
  <para style="q2" vid="PSA 8:9">aleke wò ŋkɔ ƒe gãnyenye yɔ anyigba katã dzi ale!<verse eid="PSA 8:9"/></para>
  <chapter eid="PSA 8"/>
  <chapter number="9" style="c" sid="PSA 9"/>
  <para style="cl">Psalmo 9</para>
  <para style="d">David ƒe ha na hɛnɔ la. Woadzii ɖe “ŋutsuvi la ƒe ku” ƒe gbeɖiɖi nu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 9:1"/>Makafu wò, O! Yehowa,</para>
  <para style="q2" vid="PSA 9:1">kple nye dzi blibo,</para>
  <para style="q2" vid="PSA 9:1">maɖe wò nukunuwɔwɔwo katã afia.<verse eid="PSA 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 9:2"/>Dzi adzɔm, eye matso aseye le mewò;</para>
  <para style="q2" vid="PSA 9:2">O Dziƒoʋĩtɔ, madzi kafukafuhawo na wò ŋkɔ.<verse eid="PSA 9:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 9:3"/>Nye futɔwo trɔ megbe;</para>
  <para style="q2" vid="PSA 9:3">wokli nu, eye wo katã wotsrɔ̃ le ŋkuwò me.<verse eid="PSA 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 9:4"/>Elabena wòe xɔ nye nya,</para>
  <para style="q2" vid="PSA 9:4">eye nèɖe nye dzɔdzɔenyenye ɖe go.</para>
  <para style="q2" vid="PSA 9:4">Ènɔ wò fiazikpui dzi, eye nèdrɔ̃ ʋɔnu dzɔdzɔe.<verse eid="PSA 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 9:5"/>Èka mo na dukɔwo, eye nètsrɔ̃ ame vɔ̃ɖiwo hetutu</para>
  <para style="q2" vid="PSA 9:5">woƒe ŋkɔwo ɖa tso mavɔ me yi ɖe mavɔ me.<verse eid="PSA 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 9:6"/>Tsɔtsrɔ̃ mavɔ va futɔ la dzi,</para>
  <para style="q2" vid="PSA 9:6">elabena èho woƒe duwo,</para>
  <para style="q2" vid="PSA 9:6">eye womagaɖo ŋku wo dzi gɔ̃ hã akpɔ gbeɖe o.<verse eid="PSA 9:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 9:7"/>Yehowa aɖu fia tegbetegbe;</para>
  <para style="q2" vid="PSA 9:7">eɖo eƒe fiazikpui anyi hena ʋɔnudɔdrɔ̃.<verse eid="PSA 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 9:8"/>Adrɔ̃ ʋɔnu xexea me le dzɔdzɔenyenye me;</para>
  <para style="q2" vid="PSA 9:8">akplɔ dukɔwo katã le nuteƒewɔwɔ me.<verse eid="PSA 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 9:9"/>Yehowa nye sitsoƒe na ame siwo wote ɖe anyi</para>
  <para style="q2" vid="PSA 9:9">kple mɔ sesẽ le xaxaɣiwo.<verse eid="PSA 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 9:10"/>Ame siwo nya wò ŋkɔ la aɖo dzi ɖe ŋuwò,</para>
  <para style="q2" vid="PSA 9:10">elabena wò Yehowa,</para>
  <para style="q2" vid="PSA 9:10">megble ame siwo dia wò la ɖi kpɔ o.<verse eid="PSA 9:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 9:11"/>Midzi kafukafuhawo na Yehowa,</para>
  <para style="q2" vid="PSA 9:11">ame si nɔ fiazikpui dzi gli le Zion,</para>
  <para style="q2" vid="PSA 9:11">miɖe gbeƒã nu siwo wòwɔ la le dukɔwo dome.<verse eid="PSA 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 9:12"/>Elabena eya, ame si biaa hlɔ̃ hlɔ̃dolawo la,</para>
  <para style="q2" vid="PSA 9:12">ɖoa ŋku edzi, medoa toku hiãtɔwo ƒe ɣlidodo o.<verse eid="PSA 9:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 9:13"/>O Yehowa, kpɔ ale si nye futɔwo le yonyeme tim ɖa!</para>
  <para style="q2" vid="PSA 9:13">Kpɔ nye nublanui, eye nàkɔm tso ku ƒe agbowo me,<verse eid="PSA 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 9:14"/>be maɖe wò kafukafu afia le Zion Vinyɔnu ƒe agbowo me,</para>
  <para style="q2" vid="PSA 9:14">eye le afi ma matso aseye le ɖeɖe si nènam la ta.<verse eid="PSA 9:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 9:15"/>Dukɔwo ge dze do si woawo ŋutɔ woɖe la me;</para>
  <para style="q2" vid="PSA 9:15">woƒe afɔwo ɖo ɖɔ si woawo ŋutɔ woɖo ɖi le bebeme la me.<verse eid="PSA 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 9:16"/>Yehowa ɖe eɖokui fia to eƒe ʋɔnu dzɔdzɔe dɔdrɔ̃ me;</para>
  <para style="q2" vid="PSA 9:16">ame vɔ̃ɖiwo ƒe asinudɔwɔwɔwo atsɔ wo ade mɔ me.</para>
  <para style="q2" vid="PSA 9:16">Ŋugbledede. <char style="qs">Sela</char><verse eid="PSA 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 9:17"/>Ame vɔ̃ɖiwo gbugbɔ yi yɔ me,</para>
  <para style="q2" vid="PSA 9:17">nenema kee nye dukɔ siwo ŋlɔ Mawu be.<verse eid="PSA 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 9:18"/>Ke womaŋlɔ hiãtɔ be ɖikaa</para>
  <para style="q2" vid="PSA 9:18">alo ame si le fu kpem la, mɔkpɔkpɔ nabu ɖee o.<verse eid="PSA 9:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 9:19"/>Tso, O Yehowa! Mègana amegbetɔ naɖu dzi o,</para>
  <para style="q2" vid="PSA 9:19">na woadrɔ̃ ʋɔnu dukɔwo le ŋkuwò me.<verse eid="PSA 9:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 9:20"/>O! Yehowa, ƒo wo ƒu anyi kple ŋɔdzi;</para>
  <para style="q2" vid="PSA 9:20">na dukɔwo nanya be amegbetɔwo yewonye. <char style="qs">Sela.</char><verse eid="PSA 9:20"/></para>
  <chapter eid="PSA 9"/>
  <chapter number="10" style="c" sid="PSA 10"/>
  <para style="cl">Psalmo 10</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 10:1"/>O! Yehowa, nu ka ta nèle adzɔge ʋĩi ɖo?</para>
  <para style="q2" vid="PSA 10:1">Nu ka ta nèɣla ɖokuiwò le xaxaɣiwo ɖo?<verse eid="PSA 10:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 10:2"/>Ame vɔ̃ɖi dadala he hiãtɔ ƒu anyi,</para>
  <para style="q2" vid="PSA 10:2">ke wògena ɖe mɔ si wòtre da ɖi la me.<verse eid="PSA 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 10:3"/>Nu siwo eƒe dzi dina la, egblɔnɛ adegbeƒotɔe;</para>
  <para style="q2" vid="PSA 10:3">eyraa ŋuklẽlawo, eye wòɖea alɔme le Yehowa ŋu.<verse eid="PSA 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 10:4"/>Ame vɔ̃ɖi la media eƒe mɔ o,</para>
  <para style="q2" vid="PSA 10:4">le dada viviwo ta,</para>
  <para style="q1" vid="PSA 10:4">le eƒe ŋugblededewo katã me la,</para>
  <para style="q2" vid="PSA 10:4">meɖoa ŋku Mawu dzi o.<verse eid="PSA 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 10:5"/>Eƒe mɔwo dzea edzi nɛ nyuie ɣe sia ɣi,</para>
  <para style="q2" vid="PSA 10:5">edoa eɖokui ɖe dzi,</para>
  <para style="q1" vid="PSA 10:5">wò sewo didi tso egbɔ;</para>
  <para style="q2" vid="PSA 10:5">eye wòɖoa hehe ɖe eƒe futɔwo ta.<verse eid="PSA 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 10:6"/>Egblɔna na eɖokui be, “Naneke maʋuʋum o,</para>
  <para style="q2" vid="PSA 10:6">makpɔ dzidzɔ ɣe sia ɣi, eye nyemage ɖe dzɔgbevɔ̃e me akpɔ o.”<verse eid="PSA 10:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 10:7"/>Fiƒode, alakpa kple ŋɔdzidodo yɔ eƒe nu me fũu,</para>
  <para style="q2" vid="PSA 10:7">eye gbegblẽ kple nu vɔ̃ɖi le eƒe aɖe te.<verse eid="PSA 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 10:8"/>Edea xa ɖe kɔƒewo xa;</para>
  <para style="q2" vid="PSA 10:8">ewu ame maɖifɔwo le xame,</para>
  <para style="q2" vid="PSA 10:8">eye wòtsa ŋu na ame si wòalé le bebeme.<verse eid="PSA 10:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 10:9"/>Edea xa ɖe ɣaɣlɛƒe abe dzatae be ɖe ave xa ene;</para>
  <para style="q2" vid="PSA 10:9">ale be wòalé amemanɔsitɔ;</para>
  <para style="q2" vid="PSA 10:9">eléa amemanɔsitɔ, eye wòhea wo ɖe eƒe ɖɔ me dzonae.<verse eid="PSA 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 10:10"/>Etoa ƒu ɖe lãme na ame siwo wòlé,</para>
  <para style="q2" vid="PSA 10:10">woƒe mo tsyɔa zi, eye womuna dzea anyi le eƒe ŋusẽ te.<verse eid="PSA 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 10:11"/>Egblɔna na eɖokui be,</para>
  <para style="q2" vid="PSA 10:11">“Mawu ŋlɔ be; etsɔ nu tsyɔ eƒe mo, eye mele nu kpɔm o.”<verse eid="PSA 10:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 10:12"/>Tso, Yehowa! O! Mawu, kɔ wò abɔ dzi.</para>
  <para style="q2" vid="PSA 10:12">Mègaŋlɔ hiãtɔ be o.<verse eid="PSA 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 10:13"/>Nu ka ta ame vɔ̃ɖi la le alɔme ɖem le Mawu ŋuti ɖo?</para>
  <para style="q2" vid="PSA 10:13">Nu ka ta wògblɔna na eɖokui be,</para>
  <para style="q2" vid="PSA 10:13">“Mayɔm be mana akɔnta o” ɖo?<verse eid="PSA 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 10:14"/>Ke wò, O! Mawu, koe kpɔa dzɔgbevɔ̃e kple vevesese;</para>
  <para style="q2" vid="PSA 10:14">èbua eŋuti, eye asiwò me wole.</para>
  <para style="q1" vid="PSA 10:14">Ame si le fukpekpe me la,</para>
  <para style="q2" vid="PSA 10:14">tsɔa eɖokui dea asi na wò;</para>
  <para style="q2" vid="PSA 10:14">elabena wòe nye xɔnametɔ na tsyɔ̃eviwo.<verse eid="PSA 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 10:15"/>Ŋe abɔ na ame vɔ̃ɖi kple nu tovo wɔla;</para>
  <para style="q2" vid="PSA 10:15">yɔe ne wòana akɔnta tso nu vɔ̃ɖi siwo wòwɔ</para>
  <para style="q2" vid="PSA 10:15">ame aɖeke mekpɔe o la ŋuti.<verse eid="PSA 10:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 10:16"/>Yehowae nye fia tso mavɔ me yi mavɔ me;</para>
  <para style="q2" vid="PSA 10:16">dukɔwo atsrɔ̃ ɖa le eƒe anyigba dzi.<verse eid="PSA 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 10:17"/>O! Yehowa, èse hiãtɔwo ƒe didi;</para>
  <para style="q2" vid="PSA 10:17">ède dzi ƒo na wo, eye nèɖo to woƒe ɣlidodo.<verse eid="PSA 10:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 10:18"/>Èʋli tsyɔ̃eviwo kple ame siwo wote ɖe anyi la ta,</para>
  <para style="q2" vid="PSA 10:18">ale be amegbetɔ si nye anyi la magado ŋɔdzi na amewo azɔ o.<verse eid="PSA 10:18"/></para>
  <chapter eid="PSA 10"/>
  <chapter number="11" style="c" sid="PSA 11"/>
  <para style="cl">Psalmo 11</para>
  <para style="d">David ƒe ha na hɛnɔ la.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 11:1"/>Yehowae mesi tso.</para>
  <para style="q2" vid="PSA 11:1">Aleke miele gbɔgblɔm nam be,</para>
  <para style="q2" vid="PSA 11:1">“Dzo abe xevi ene nàyi ɖe wò to dzi?<verse eid="PSA 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 11:2"/>Elabena kpɔ ɖa, ame vɔ̃ɖiwo he woƒe da me;</para>
  <para style="q2" vid="PSA 11:2">wotsɔ woƒe aŋutrɔwo ɖo datikawo ŋuti be</para>
  <para style="q2" vid="PSA 11:2">woada ame siwo dza le woƒe dzi me la le blukɔ me.<verse eid="PSA 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 11:3"/>Esi wole gɔmeɖokpeawo gbãm la,</para>
  <para style="q2" vid="PSA 11:3">nu ka dzɔdzɔetɔ la awɔ?”<verse eid="PSA 11:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 11:4"/>Yehowa le eƒe gbedoxɔ kɔkɔe la me;</para>
  <para style="q2" vid="PSA 11:4">Yehowa le eƒe fiazikpui dzi le dziƒo.</para>
  <para style="q1" vid="PSA 11:4">Elé ŋku ɖe amegbetɔviwo ŋu,</para>
  <para style="q2" vid="PSA 11:4">eye wòdo wo kpɔ.<verse eid="PSA 11:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 11:5"/>Yehowa doa ame dzɔdzɔe kpɔna,</para>
  <para style="q2" vid="PSA 11:5">ke eƒe luʋɔ tsri ame vɔ̃ɖiwo</para>
  <para style="q2" vid="PSA 11:5">kple ame siwo lɔ̃a ŋutasesẽ.<verse eid="PSA 11:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 11:6"/>Ana dzoka xɔxɔ kple aŋɔ dzodzoe nadza ɖe</para>
  <para style="q2" vid="PSA 11:6">ame vɔ̃ɖiwo dzi, eye ya xɔdzo anye wo tɔ gome.<verse eid="PSA 11:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 11:7"/>Elabena Yehowae nye dzɔdzɔetɔ, elɔ̃a nuteƒewɔwɔ;</para>
  <para style="q2" vid="PSA 11:7">ame siwo dza le woƒe dzi me la akpɔ eƒe ŋkume.<verse eid="PSA 11:7"/></para>
  <chapter eid="PSA 11"/>
  <chapter number="12" style="c" sid="PSA 12"/>
  <para style="cl">Psalmo 12</para>
  <para style="d">David ƒe ha na hɛnɔ la. Woadzii ɖe <char style="tl">seminit</char> ŋu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 12:1"/>Xɔ nam, Yehowa elabena, mawuvɔ̃lawo megali o,</para>
  <para style="q2" vid="PSA 12:1">eye nuteƒewɔlawo bu le amegbetɔwo dome.<verse eid="PSA 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 12:2"/>Ame sia ame kaa aʋatso na ehavi,</para>
  <para style="q2" vid="PSA 12:2">eye wovivia nu me,</para>
  <para style="q2" vid="PSA 12:2">elabena woƒe nuyiwo blea ame.<verse eid="PSA 12:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 12:3"/>Yehowa nelã beblenuyiwo katã</para>
  <para style="q2" vid="PSA 12:3">kple aɖe siwo doa wo ɖokui ɖe dzi<verse eid="PSA 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 12:4"/>hegblɔna be, “Míaɖu dzi kple míaƒe aɖewo,</para>
  <para style="q2" vid="PSA 12:4">míaƒe nuyiwo nye mía tɔ,</para>
  <para style="q2" vid="PSA 12:4">ame kae aɖu amegã ɖe mía dzi?”<verse eid="PSA 12:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 12:5"/>Yehowa be, “Esi wotea ame gblɔewo ɖe to,</para>
  <para style="q2" vid="PSA 12:5">eye hiãtɔwo ŋena ta la, matso azɔ.</para>
  <para style="q2" vid="PSA 12:5">Maɖe wo tso ame siwo le vlo dom wo la ƒe asi me.”<verse eid="PSA 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 12:6"/>Kpɔtsɔtsɔ mele Yehowa ƒe nyawo ŋuti o,</para>
  <para style="q2" vid="PSA 12:6">wole abe klosalo si wololo le anyikpo me,</para>
  <para style="q2" vid="PSA 12:6">eye wòdza zi gbɔ zi adre la ene.<verse eid="PSA 12:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 12:7"/>Ame vɔ̃ɖiwo zɔna le ablɔɖe me,</para>
  <para style="q2" vid="PSA 12:7">eye wodea bubu yakanuwɔwɔwo ŋu le amegbetɔwo dome.<verse eid="PSA 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 12:8"/>O! Yehowa, àna míanɔ dedie,</para>
  <para style="q2" vid="PSA 12:8">eye àdzɔ mía ŋu tso ame siawo tɔgbi ƒe asi me tegbetegbe.<verse eid="PSA 12:8"/></para>
  <chapter eid="PSA 12"/>
  <chapter number="13" style="c" sid="PSA 13"/>
  <para style="cl">Psalmo 13</para>
  <para style="d">David ƒe ha na hɛnɔ la.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 13:1"/>O! Yehowa, va se ɖe ɣe ka ɣi?</para>
  <para style="q2" vid="PSA 13:1">Ɖe nàŋlɔm be ɖikaɖika?</para>
  <para style="q2" vid="PSA 13:1">Va se ɖe ɣe ka ɣi nàɣla wò ŋkume ɖem?<verse eid="PSA 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 13:2"/>Va se ɖe ɣe ka ɣi mawɔ avu kple nye tamesusu,</para>
  <para style="q2" vid="PSA 13:2">eye gbe sia gbe nuxaxa nayɔ nye dzi me?</para>
  <para style="q2" vid="PSA 13:2">Va se ɖe ɣe ka ɣi nye futɔwo aɖu dzinye?<verse eid="PSA 13:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 13:3"/>Kpɔm ɖa, eye nàɖo nya ŋu nam,</para>
  <para style="q2" vid="PSA 13:3">O! Yehowa, nye Mawu.</para>
  <para style="q1" vid="PSA 13:3">Na kekeli naklẽ ɖe nye ŋkuwo dzi,</para>
  <para style="q2" vid="PSA 13:3">ne menye nenema o la,</para>
  <para style="q2" vid="PSA 13:3">madɔ alɔ̃ ayi ku me.<verse eid="PSA 13:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 13:4"/>Ekema nye futɔwo agblɔ be,</para>
  <para style="q2" vid="PSA 13:4">“Meɖu edzi,” eye nye ketɔwo akpɔ dzidzɔ ne medze anyi.<verse eid="PSA 13:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 13:5"/>Ke nye ya meɖo dzi ɖe wò lɔlɔ̃ si meʋãna o la ŋu,</para>
  <para style="q2" vid="PSA 13:5">nye dzi le aseye tsom le wò xɔname ŋuti.<verse eid="PSA 13:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 13:6"/>Madzi ha na Yehowa,</para>
  <para style="q2" vid="PSA 13:6">elabena ewɔ nyui nam.<verse eid="PSA 13:6"/></para>
  <chapter eid="PSA 13"/>
  <chapter number="14" style="c" sid="PSA 14"/>
  <para style="cl">Psalmo 14</para>
  <para style="d">David ƒe ha na hɛnɔ la.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 14:1"/>Bometsila gblɔna le eƒe dzi me be,</para>
  <para style="q2" vid="PSA 14:1">“Mawu aɖeke meli o.”</para>
  <para style="q1" vid="PSA 14:1">Wonye ame tovowo, eye woƒe nuwɔnawo nye ŋunyɔnu;</para>
  <para style="q2" vid="PSA 14:1">ame ɖeka hɔ̃ɔ hã mele wo dome si wɔa nu nyui o.<verse eid="PSA 14:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 14:2"/>Yehowa bi kɔ kpɔ amegbetɔviwo ɖa tso dziƒo,</para>
  <para style="q2" vid="PSA 14:2">be wòakpɔe ɖa be nugɔmesela aɖe le wo dome,</para>
  <para style="q2" vid="PSA 14:2">eye wòdia Mawu vevie mahã?<verse eid="PSA 14:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 14:3"/>Wo katã wodze ɖe aga,</para>
  <para style="q2" vid="PSA 14:3">wo katã tim wogblẽ;</para>
  <para style="q1" vid="PSA 14:3">ame aɖeke meli si wɔa nu nyui o,</para>
  <para style="q2" vid="PSA 14:3">ɖeka pɛ gɔ̃ hã meli o.<verse eid="PSA 14:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 14:4"/>Ɖe nu tovo wɔlawo,</para>
  <para style="q2" vid="PSA 14:4">ame siwo ɖua nye amewo abe abolo ene,</para>
  <para style="q2" vid="PSA 14:4">eye womeyɔa Yehowa o la manya esia oa?<verse eid="PSA 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 14:5"/>Ŋɔdzi lé wo ale gbegbe,</para>
  <para style="q2" vid="PSA 14:5">elabena Mawu le ame dzɔdzɔewo ƒe hame.<verse eid="PSA 14:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 14:6"/>Mi nu tovo wɔlawo,</para>
  <para style="q2" vid="PSA 14:6">miegblẽ ame dahewo ƒe ɖoɖowo me,</para>
  <para style="q2" vid="PSA 14:6">gake Yehowae nye woƒe sitsoƒe.<verse eid="PSA 14:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 14:7"/>O! Xɔname ado tso Zion na Israel.</para>
  <para style="q2" vid="PSA 14:7">Ne Yehowa gaɖo eƒe amewo ƒe nunyonamewo te la,</para>
  <para style="q2" vid="PSA 14:7">na Yakob natso aseye, eye Israel nakpɔ dzidzɔ!<verse eid="PSA 14:7"/></para>
  <chapter eid="PSA 14"/>
  <chapter number="15" style="c" sid="PSA 15"/>
  <para style="cl">Psalmo 15</para>
  <para style="d">David ƒe ha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 15:1"/>Yehowa, ame kae dze anɔ wò kɔkɔeƒe la?</para>
  <para style="q2" vid="PSA 15:1">Ame kae anɔ wò togbɛ kɔkɔe la dzi?<verse eid="PSA 15:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 15:2"/>Ame si fɔɖiɖi mele eƒe zɔzɔme ŋu o,</para>
  <para style="q2" vid="PSA 15:2">eye wòwɔa nu dzɔdzɔe lae.</para>
  <para style="q2" vid="PSA 15:2">Ame si toa nyateƒe tso eƒe dzi me ke<verse eid="PSA 15:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 15:3"/>eye ameŋugbegblẽ mele aɖe dzi nɛ o,</para>
  <para style="q2" vid="PSA 15:3">ame si mewɔa vɔ̃ ɖe ehavi ŋu o,</para>
  <para style="q2" vid="PSA 15:3">eye meƒoa ɖi nɔvia amegbetɔ o,<verse eid="PSA 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 15:4"/>ame si ame baɖa ƒe nu menyoa eŋu o,</para>
  <para style="q2" vid="PSA 15:4">ke boŋ edea bubu ame siwo vɔ̃a Yehowa la ŋuti,</para>
  <para style="q1" vid="PSA 15:4">ame si kaa atam si hea vevesese vanɛ,</para>
  <para style="q2" vid="PSA 15:4">gake megbea edziwɔwɔ o,<verse eid="PSA 15:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 15:5"/>ame si medoa ga xɔa deme ɖe edzi o,</para>
  <para style="q2" vid="PSA 15:5">eye mexɔa zãnu ɖe ame maɖifɔ ŋuti o.</para>
  <para style="b" vid="PSA 15:5"/>
  <para style="q1" vid="PSA 15:5">Ame si wɔa nu siawo la,</para>
  <para style="q2" vid="PSA 15:5">naneke maʋãe akpɔ gbeɖegbeɖe o.<verse eid="PSA 15:5"/></para>
  <chapter eid="PSA 15"/>
  <chapter number="16" style="c" sid="PSA 16"/>
  <para style="cl">Psalmo 16</para>
  <para style="d">David ƒe ha si wɔa dɔ ɖe ame dzi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 16:1"/>O! Mawu, na manɔ dedie,</para>
  <para style="q2" vid="PSA 16:1">elabena wò mee mebe ɖo.<verse eid="PSA 16:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 16:2"/>Megblɔ na Yehowa be,</para>
  <para style="q2" vid="PSA 16:2">“Wòe nye nye Aƒetɔ;</para>
  <para style="q2" vid="PSA 16:2">nu nyui aɖeke mele asinye kpe ɖe ŋuwò o.”<verse eid="PSA 16:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 16:3"/>Ame kɔkɔe siwo le anyigba dzi la woe nye bubume</para>
  <para style="q2" vid="PSA 16:3">siwo ƒe nu nyoa ŋunye vevie.<verse eid="PSA 16:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 16:4"/>Ame siwo ati mawu tutɔwo yome la, adzi woƒe vevesesewo ɖe edzi.</para>
  <para style="q2" vid="PSA 16:4">Nyemasa woƒe ʋuvɔsawo na mawu mawo,</para>
  <para style="q2" vid="PSA 16:4">alo ayɔ woƒe ŋkɔwo o.<verse eid="PSA 16:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 16:5"/>Yehowa, èɖo tɔnye gome</para>
  <para style="q2" vid="PSA 16:5">kple nye kplu da ɖi nam;</para>
  <para style="q2" vid="PSA 16:5">èna nye gomekpɔkpɔ le dedie nam.<verse eid="PSA 16:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 16:6"/>Liƒo ƒe dzidzeka la dze teƒe nyuiwo nam;</para>
  <para style="q2" vid="PSA 16:6">le nyateƒe me la, domenyinu si do dzidzɔ nam la su asinye.<verse eid="PSA 16:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 16:7"/>Makafu Yehowa, ame si ɖoa aɖaŋu nam;</para>
  <para style="q2" vid="PSA 16:7">le zã me ke hã, nye dzi xlɔ̃a num.<verse eid="PSA 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 16:8"/>Metsɔ Yehowa ɖo ŋkunye me ɖaa,</para>
  <para style="q2" vid="PSA 16:8">elabena ele nye nuɖusime, eya ta nyemavɔ̃ o.<verse eid="PSA 16:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 16:9"/>Esia ta nye dzi le dzidzɔ kpɔm,</para>
  <para style="q2" vid="PSA 16:9">nye aɖe tso aseye, eye nye ŋutilã hã agbɔ ɖe eme le dedinɔnɔ me,<verse eid="PSA 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 16:10"/>elabena màgblẽm ɖi na yɔdo alo ana wò,</para>
  <para style="q2" vid="PSA 16:10">Kɔkɔetɔ la, nàkpɔ gbegblẽ o.<verse eid="PSA 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 16:11"/>Èna menya agbemɔ la;</para>
  <para style="q2" vid="PSA 16:11">àtsɔ dzidzɔkpɔkpɔ ayɔ menye le ŋkuwò me,</para>
  <para style="q1" vid="PSA 16:11">eye matsɔ vivisese si mevɔna o la</para>
  <para style="q2" vid="PSA 16:11">anɔ wò nuɖusime tegbee.<verse eid="PSA 16:11"/></para>
  <chapter eid="PSA 16"/>
  <chapter number="17" style="c" sid="PSA 17"/>
  <para style="cl">Psalmo 17</para>
  <para style="d">David ƒe gbedodoɖa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 17:1"/>See, O! Yehowa, ɖo to nye ɣlidodo</para>
  <para style="q2" vid="PSA 17:1">kple nye dzɔdzɔenyenye ƒe kukuɖeɖe.</para>
  <para style="q1" vid="PSA 17:1">Ƒu to anyi ɖe nye gbedodoɖa</para>
  <para style="q2" vid="PSA 17:1">si metso alakpanuyiwo me o.<verse eid="PSA 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 17:2"/>Afiatsotso nam netso gbɔwò,</para>
  <para style="q2" vid="PSA 17:2">eye na wò ŋkuwo nakpɔ nu si le dzɔdzɔe.<verse eid="PSA 17:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 17:3"/>Togbɔ be èdzro nye dzi me</para>
  <para style="q2" vid="PSA 17:3">eye nèlé ŋku ɖe ŋunye tsitotsito le zã me;</para>
  <para style="q1" vid="PSA 17:3">ne èdom kpɔ hã la,</para>
  <para style="q2" vid="PSA 17:3">màkpɔ naneke le menye o.</para>
  <para style="q2" vid="PSA 17:3">Meɖoe kplikpaa be nye nu mawɔ nu vɔ̃ o.<verse eid="PSA 17:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 17:4"/>Le amegbetɔwo ƒe nuwɔnawo me la,</para>
  <para style="q2" vid="PSA 17:4">metsɔ wò numenya kpɔ ɖokuinye dzii be,</para>
  <para style="q2" vid="PSA 17:4">nyemage ɖe ame vɔ̃ɖiwo ƒe mɔwo dzi o.<verse eid="PSA 17:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 17:5"/>Nye afɔɖeɖewo li ɖe wò toƒewo,</para>
  <para style="q2" vid="PSA 17:5">eye nye afɔ meɖiɖi o.<verse eid="PSA 17:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 17:6"/>Mele yɔwòm, O! Mawu, elabena àtɔ nam;</para>
  <para style="q2" vid="PSA 17:6">ƒu to anyi ɖe ŋunye, eye nàse nye gbedodoɖa.<verse eid="PSA 17:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 17:7"/>Ɖe wò lɔlɔ̃ gã la ƒe nukunu fia,</para>
  <para style="q2" vid="PSA 17:7">wò ame si tsɔa wò nuɖusi ɖea ame siwo si wò tso,</para>
  <para style="q2" vid="PSA 17:7">tso woƒe futɔwo ƒe asi me.<verse eid="PSA 17:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 17:8"/>Kpɔ tanye abe wò ŋku ƒe gadaglamakui ene,</para>
  <para style="q2" vid="PSA 17:8">eye nàɣlam ɖe wò aʋala ƒe vɔvɔli te,<verse eid="PSA 17:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 17:9"/>ɖem tso ame vɔ̃ɖi siwo le funyafunya wɔmem</para>
  <para style="q2" vid="PSA 17:9">kple futɔ siwo ɖe to ɖem la ƒe asi me.<verse eid="PSA 17:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 17:10"/>Wotu woƒe ŋutasẽdziwo,</para>
  <para style="q2" vid="PSA 17:10">eye wotsɔa woƒe nuwo gblɔa dadanyawoe.<verse eid="PSA 17:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 17:11"/>Wodo afɔ nam, eye azɔ la, woɖe to ɖem,</para>
  <para style="q2" vid="PSA 17:11">woƒe ŋkuwo le te ne woaxlãm ɖe anyigba.<verse eid="PSA 17:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 17:12"/>Wole abe dzata dɔwui si le nu dim be yealé,</para>
  <para style="q2" vid="PSA 17:12">hele adeklo dzi le avekɔe me ene.<verse eid="PSA 17:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 17:13"/>O! Yehowa, tso, kpe akɔ kpli wo,</para>
  <para style="q2" vid="PSA 17:13">he wo ƒu anyi, eye tsɔ wò yi nàɖem le ame vɔ̃ɖiwo ƒe asi me.<verse eid="PSA 17:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 17:14"/>O! Yehowa, tsɔ wò asi ɖem le ame siawo tɔgbi</para>
  <para style="q2" vid="PSA 17:14">kple xexemetɔ siawo ƒe asi me,</para>
  <para style="q2" vid="PSA 17:14">ame siwo ƒe fetu le agbe sia me.</para>
  <para style="q1" vid="PSA 17:14">Ètsia ame siwo nèlɔ̃ vevie la ƒe dɔwuame nu;</para>
  <para style="q2" vid="PSA 17:14">wo viŋutsuwo kpɔ nu nyui geɖe,</para>
  <para style="q2" vid="PSA 17:14">eye wodzraa kesinɔnuwo ɖo ɖi na wo viwo.<verse eid="PSA 17:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 17:15"/>Ke nye la, makpɔ wò ŋkume le dzɔdzɔenyenye me,</para>
  <para style="q2" vid="PSA 17:15">eye ne menyɔ hekpɔ wò nɔnɔme ko la, maɖi ƒo.<verse eid="PSA 17:15"/></para>
  <chapter eid="PSA 17"/>
  <chapter number="18" style="c" sid="PSA 18"/>
  <para style="cl">Psalmo 18</para>
  <para style="d">David, Yehowa ƒe dɔla, ƒe ha na hɛnɔ la. David dzi ha sia na Yehowa le esime wòɖee tso Saul kple eƒe futɔ bubuawo ƒe asi me. David gblɔ be:</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 18:1"/>O! Yehowa, nye ŋusẽ, melɔ̃ wò.<verse eid="PSA 18:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 18:2"/>Yehowa nye nye agakpe, nye mɔ kple nye xɔnametɔ.</para>
  <para style="q2" vid="PSA 18:2">Nye Mawu nye nye agakpe, eyae mesi tso.</para>
  <para style="q1" vid="PSA 18:2">Eyae nye nye akpoxɔnu kple ɖeɖe</para>
  <para style="q2" vid="PSA 18:2">ƒe ŋusẽ kple nye mɔ sesẽ.<verse eid="PSA 18:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 18:3"/>Meyɔ Yehowa, ame si dze na kafukafu,</para>
  <para style="q2" vid="PSA 18:3">eɖem tso nye futɔwo katã ƒe asi me.<verse eid="PSA 18:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 18:4"/>Ku ƒe kawo blam,</para>
  <para style="q2" vid="PSA 18:4">eye nu siwo gblẽa ame la ƒo ɖe dzinye abe tɔʋu ene.<verse eid="PSA 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 18:5"/>Tsiẽƒe ƒe kawo</para>
  <para style="q2" vid="PSA 18:5">blam, eye ku ƒe mɔtetrewo ɖi kpem.<verse eid="PSA 18:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 18:6"/>Meyɔ Yehowa le nye xaxa me;</para>
  <para style="q2" vid="PSA 18:6">medo ɣli na nye Mawu be wòaɖem.</para>
  <para style="q1" vid="PSA 18:6">Ese nye gbe tso eƒe gbedoxɔ me ke,</para>
  <para style="q2" vid="PSA 18:6">eye nye ɣlidodo ɖo egbɔ, ge ɖe eƒe to me.<verse eid="PSA 18:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 18:7"/>Tete anyigba dzo nyanyanya, eye wòʋuʋu;</para>
  <para style="q2" vid="PSA 18:7">towo ƒe agunuwo ke hã ʋuʋu heyeheye,</para>
  <para style="q2" vid="PSA 18:7">eye wodzo kpekpekpe, elabena dzi kui.<verse eid="PSA 18:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 18:8"/>Dzudzɔ do tso eƒe ŋɔtime;</para>
  <para style="q2" vid="PSA 18:8">dzo ƒe aɖewo do tso eƒe nu me</para>
  <para style="q2" vid="PSA 18:8">eye dzoka xɔxɔwo kplɔe ɖo.<verse eid="PSA 18:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 18:9"/>Ema dziŋgɔli ɖe eve,</para>
  <para style="q2" vid="PSA 18:9">wòto eme ɖi va anyi,</para>
  <para style="q2" vid="PSA 18:9">eye lilikpo do blukɔ le eƒe afɔ te.<verse eid="PSA 18:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 18:10"/>Ede kerubiwo dzi, eye wòdzo dzo.</para>
  <para style="q2" vid="PSA 18:10">Eɖo asagba ɖe ya ƒe aʋalawo dzi.<verse eid="PSA 18:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 18:11"/>Viviti nye avɔ si wòtsyɔ, eye lilikpo yibɔ</para>
  <para style="q2" vid="PSA 18:11">si dzaa tsi lae nye agbadɔ si ƒo xlãe.<verse eid="PSA 18:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 18:12"/>Lilikpo, kpetsi kple dzikedzo do tso</para>
  <para style="q2" vid="PSA 18:12">eƒe mo ƒe keklẽ la me.<verse eid="PSA 18:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 18:13"/>Yehowa ɖe gbe tso dziƒo,</para>
  <para style="q2" vid="PSA 18:13">eye Dziƒoʋĩtɔ la na wose eƒe gbe.<verse eid="PSA 18:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 18:14"/>Eda eƒe aŋutrɔ, eye wòkaka eƒe futɔwo,</para>
  <para style="q2" vid="PSA 18:14">eɖo dzikedzo ɖa, eye wòtɔtɔ wo.<verse eid="PSA 18:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 18:15"/>Atsiaƒu ƒe balimewo dze gaglã,</para>
  <para style="q2" vid="PSA 18:15">eye anyigba ƒe gɔmeɖoɖo tsi ƒuƒlu.</para>
  <para style="q1" vid="PSA 18:15">Le Yehowa ƒe nyaheɖeameŋu</para>
  <para style="q2" vid="PSA 18:15">kple gbɔgbɔ si do tso eƒe ŋɔtime ta.<verse eid="PSA 18:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 18:16"/>Edo asi ɖa tso dziƒo lém,</para>
  <para style="q2" vid="PSA 18:16">Heɖem tso tɔ goglowo me.<verse eid="PSA 18:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 18:17"/>Eɖem tso nye futɔ ŋusẽtɔwo ƒe asi me,</para>
  <para style="q2" vid="PSA 18:17">tso nye ketɔwo ƒe asi me,</para>
  <para style="q2" vid="PSA 18:17">ame siwo sesẽ wum akpa la ƒe asi me.<verse eid="PSA 18:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 18:18"/>Woƒo ɖe dzinye le nye dzɔgbevɔ̃egbe,</para>
  <para style="q2" vid="PSA 18:18">gake Yehowa nye nye kpeɖeŋutɔ.<verse eid="PSA 18:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 18:19"/>Eɖem tsɔ da ɖe teƒe gbadzaa;</para>
  <para style="q2" vid="PSA 18:19">eɖem, elabena nye nu nyo eŋu.<verse eid="PSA 18:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 18:20"/>Yehowa nɔ kplim le nye dzɔdzɔenyenye nu,</para>
  <para style="q2" vid="PSA 18:20">eye wòwɔ nyui nam le esi nye asi me dza la ta.<verse eid="PSA 18:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 18:21"/>Elabena melé Yehowa ƒe mɔwo me ɖe asi;</para>
  <para style="q2" vid="PSA 18:21">nyemewɔ vɔ̃ hetrɔ le nye Mawu yome o.<verse eid="PSA 18:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 18:22"/>Eƒe sewo katã le ŋkunye me;</para>
  <para style="q2" vid="PSA 18:22">eye nyemetrɔ le eƒe ɖoɖowo yome o.<verse eid="PSA 18:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 18:23"/>Nyemeɖi fɔ le eŋkume o,</para>
  <para style="q2" vid="PSA 18:23">eye mete ɖokuinye ɖa tso nu vɔ̃ gbɔ.<verse eid="PSA 18:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 18:24"/>Yehowa wɔ nyui nam le nye dzɔdzɔenyenye</para>
  <para style="q2" vid="PSA 18:24">kple esi nye asi me dza le eŋkume la ta.<verse eid="PSA 18:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 18:25"/>Èwɔa nuteƒe na nuteƒewɔla,</para>
  <para style="q2" vid="PSA 18:25">eye nèfiaa ɖokuiwò fɔmaɖilae na ame si ŋu fɔɖiɖi mele o.<verse eid="PSA 18:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 18:26"/>Ame si dza le eƒe dzi me la, èɖea ɖokuiwò fianɛ be èdza,</para>
  <para style="q2" vid="PSA 18:26">eye nèfiaa ɖokuiwò ayetɔe ɖe ayetɔ la ŋu.<verse eid="PSA 18:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 18:27"/>Èɖea ame siwo bɔbɔa wo ɖokui,</para>
  <para style="q2" vid="PSA 18:27">ke ame siwo si dadaŋku le la, èɖiɖia wo ɖe anyi.<verse eid="PSA 18:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 18:28"/>Wò, O! Yehowae na nye akaɖi le bibim,</para>
  <para style="q2" vid="PSA 18:28">eye nye Mawu trɔ nye viviti wòzu kekeli.<verse eid="PSA 18:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 18:29"/>Mate ŋu alũ ɖe aʋakɔ dzi to wò kpekpeɖeŋu me,</para>
  <para style="q2" vid="PSA 18:29">eye le nye Mawu ta mate ŋu ati kpo aflɔ gli.<verse eid="PSA 18:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 18:30"/>Mawu ya ƒe mɔwo de blibo,</para>
  <para style="q2" vid="PSA 18:30">Yehowa ƒe nya nye nyateƒe sɔŋ.</para>
  <para style="q2" vid="PSA 18:30">Enye akpoxɔnu na ame siwo tsɔe wɔ sitsoƒee.<verse eid="PSA 18:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 18:31"/>Elabena ame kae ganye Mawu kpe ɖe Yehowa ŋu?</para>
  <para style="q2" vid="PSA 18:31">Ame kae ganye Agakpe,</para>
  <para style="q2" vid="PSA 18:31">ɖe menye míaƒe Mawu la koe oa?<verse eid="PSA 18:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 18:32"/>Mawue nye nye mɔ sesẽ,</para>
  <para style="q2" vid="PSA 18:32">Eyae na nye mɔ zu gbadzaa.<verse eid="PSA 18:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 18:33"/>Ewɔ nye afɔwo abe zi tɔwo ene,</para>
  <para style="q2" vid="PSA 18:33">eye wòna metea ŋu tsia tsitre ɖe teƒe kɔkɔwo.<verse eid="PSA 18:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 18:34"/>Efia aʋawɔwɔ nye asiwo,</para>
  <para style="q2" vid="PSA 18:34">eye nye asiwo ate ŋu abɔ dati si wowɔ kple akɔbli.<verse eid="PSA 18:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 18:35"/>Ètsɔ wò dziɖuɖu ƒe akpoxɔnu la nam,</para>
  <para style="q2" vid="PSA 18:35">eye wò nuɖusi lém ɖe te.</para>
  <para style="q2" vid="PSA 18:35">Èbɔbɔ ɖokuiwò be nàdo kɔkɔm.<verse eid="PSA 18:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 18:36"/>Èkeke mɔ le tenye,</para>
  <para style="q2" vid="PSA 18:36">be nye klowo magli le tenye o.<verse eid="PSA 18:36"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 18:37"/>Meti nye futɔwo yome, eye metu wo.</para>
  <para style="q2" vid="PSA 18:37">Nyemetrɔ le wo yome o,</para>
  <para style="q2" vid="PSA 18:37">va se ɖe esime wotsrɔ̃.<verse eid="PSA 18:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 18:38"/>Metsrɔ̃ wo be womagate ŋu afɔ gbeɖe o,</para>
  <para style="q2" vid="PSA 18:38">ale wodze anyi ɖe nye afɔ nu.<verse eid="PSA 18:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 18:39"/>Wòe na ŋusẽm hena aʋa la wɔwɔ,</para>
  <para style="q2" vid="PSA 18:39">Èna mebɔbɔ ame siwo katã</para>
  <para style="q2" vid="PSA 18:39">tso ɖe ŋunye la ɖe anyi.<verse eid="PSA 18:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 18:40"/>Èna nye futɔwo trɔ megbe dem helé du tsɔ,</para>
  <para style="q2" vid="PSA 18:40">eye metsrɔ̃ nye futɔwo.<verse eid="PSA 18:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 18:41"/>Wodo ɣli be Yehowa naxɔ na yewo,</para>
  <para style="q2" vid="PSA 18:41">gake ame aɖeke mexɔ na wo o,</para>
  <para style="q2" vid="PSA 18:41">elabena Yehowa metɔ na wo o.<verse eid="PSA 18:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 18:42"/>Metu wo memie abe ʋuʋudedi si ya lɔ ɖe nu la ene,</para>
  <para style="q2" vid="PSA 18:42">eye metrɔ wo ɖe mɔtata dzi abe anyi ene.<verse eid="PSA 18:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 18:43"/>Èɖem tso ame siwo va dze dzinye la ƒe asi me,</para>
  <para style="q2" vid="PSA 18:43">ètsɔm ɖo dukɔwo nu,</para>
  <para style="q2" vid="PSA 18:43">eye ame siwo nyemenya o la dzie meɖu fia ɖo.<verse eid="PSA 18:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 18:44"/>Ne wose ŋkɔnye ko la,</para>
  <para style="q2" vid="PSA 18:44">woɖoa tom, eye du bubu me tɔwo gɔ̃ hã</para>
  <para style="q2" vid="PSA 18:44">dzona nyanyanya le nye ŋkume.<verse eid="PSA 18:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 18:45"/>Dzi ɖena le wo katã ƒo, eye wotsɔa dzodzo nyanyanya hedoa goe</para>
  <para style="q2" vid="PSA 18:45">le woƒe mɔ sesẽwo me.<verse eid="PSA 18:45"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 18:46"/>Yehowa li tegbee!</para>
  <para style="q2" vid="PSA 18:46">Woakafu nye Agakpe la!</para>
  <para style="q2" vid="PSA 18:46">Woado Mawu, nye Xɔla la, ɖe dzi bobobo!<verse eid="PSA 18:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 18:47"/>Eyae nye Mawu si biaa hlɔ̃ nam,</para>
  <para style="q2" vid="PSA 18:47">eye wòbɔbɔa dukɔwo ɖe nye afɔ te,<verse eid="PSA 18:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 18:48"/>ame si ɖeam tso nye futɔwo ƒe asi me.</para>
  <para style="q2" vid="PSA 18:48">Èkɔm ɖe dzi gbɔ nye futɔwo ta,</para>
  <para style="q2" vid="PSA 18:48">eye nèɖem tso ŋutasẽlawo ƒe asi me.<verse eid="PSA 18:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 18:49"/>O! Yehowa, makafu wò le dukɔwo dome</para>
  <para style="q2" vid="PSA 18:49">le esia ta, eye madzi kafukafuha na wò ŋkɔ.<verse eid="PSA 18:49"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 18:50"/>Ena dziɖuɖu gãwo eƒe fia la;</para>
  <para style="q2" vid="PSA 18:50">eɖe amenuveve si nu meyi o la fia David,</para>
  <para style="q2" vid="PSA 18:50">eƒe amesiamina la kple eƒe dzidzimeviwo tegbee.<verse eid="PSA 18:50"/></para>
  <chapter eid="PSA 18"/>
  <chapter number="19" style="c" sid="PSA 19"/>
  <para style="cl">Psalmo 19</para>
  <para style="d">David ƒe ha na hɛnɔ la.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 19:1"/>Dziƒo ɖe Mawu ƒe ŋutikɔkɔe ɖe go,</para>
  <para style="q2" vid="PSA 19:1">eye dziŋgɔli le gbeƒã ɖem eƒe asinudɔwo.<verse eid="PSA 19:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 19:2"/>Tso ŋkeke yi ŋkeke, wole Mawu ƒe ŋutikɔkɔe kafum,</para>
  <para style="q2" vid="PSA 19:2">eye tso zã yi zã,</para>
  <para style="q2" vid="PSA 19:2">wole eƒe gãnyenye ɖem fia.<verse eid="PSA 19:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 19:3"/>Nuƒoƒo alo gbegbɔgblɔ aɖeke meli</para>
  <para style="q2" vid="PSA 19:3">si me womese woƒe gbe le o.<verse eid="PSA 19:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 19:4"/>Woƒe gbe ɖina le anyigba dzi afi sia afi,</para>
  <para style="q2" vid="PSA 19:4">eye woƒe nyawo dea xexea me ƒe mlɔenu ke gɔ̃ hã.</para>
  <para style="q1" vid="PSA 19:4">Etu agbadɔ ɖe dziƒowo na ɣe,<verse eid="PSA 19:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 19:5"/>eye wòle abe ŋugbetɔsrɔ̃e le go dom tso eƒe agbadɔ me ene.</para>
  <para style="q2" vid="PSA 19:5">Ele abe duƒula si le dzidzɔ kpɔm be wòalé eƒe mɔ atsɔ ene.<verse eid="PSA 19:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 19:6"/>Ɣe dzena tso dziƒo ƒe go ɖeka dzi,</para>
  <para style="q2" vid="PSA 19:6">eye wòzɔna yia go kemɛ dzi,</para>
  <para style="q2" vid="PSA 19:6">naneke meɣla ɖe eƒe dzoxɔxɔ o.<verse eid="PSA 19:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 19:7"/>Yehowa ƒe se la de blibo,</para>
  <para style="q2" vid="PSA 19:7">enaa agbegbɔgbɔ luʋɔ!</para>
  <para style="q1" vid="PSA 19:7">Yehowa ƒe ɖoɖowo le eteƒe,</para>
  <para style="q2" vid="PSA 19:7">eye wonana bometsilawo dzea nunya.<verse eid="PSA 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 19:8"/>Yehowa ƒe mɔwo dzɔ,</para>
  <para style="q2" vid="PSA 19:8">wonana dzi kpɔa dzidzɔ.</para>
  <para style="q1" vid="PSA 19:8">Yehowa ƒe sewo me kɔ,</para>
  <para style="q2" vid="PSA 19:8">wonana ame dzea nunya.<verse eid="PSA 19:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 19:9"/>Yehowa ƒe sewo me kɔ;</para>
  <para style="q2" vid="PSA 19:9">wonɔa anyi ɖaa.</para>
  <para style="q1" vid="PSA 19:9">Yehowa ƒe sewo li ke sesĩe,</para>
  <para style="q2" vid="PSA 19:9">eye ɖikeke aɖeke mele woƒe dzɔdzɔenyenye ŋu o.<verse eid="PSA 19:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 19:10"/>Woxɔ asi wu sika kple sika nyuitɔ;</para>
  <para style="q2" vid="PSA 19:10">wovivina wu anyitsi</para>
  <para style="q2" vid="PSA 19:10">kple anyitsi si woɖe le anyito me.<verse eid="PSA 19:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 19:11"/>Wò sewo wotsɔ xlɔ̃ nu wò dɔlae,</para>
  <para style="q2" vid="PSA 19:11">elabena viɖe gã geɖe le wo dzi wɔwɔ me.<verse eid="PSA 19:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 19:12"/>Ame kae ate ŋu ade dzesi nu gbegblẽ si wòwɔ?</para>
  <para style="q2" vid="PSA 19:12">Tsɔ nye vodada siwo metsɔ ɣla la kem.<verse eid="PSA 19:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 19:13"/>Ɖe wò dɔla tso lɔlɔ̃nuwɔwɔ ƒe nu vɔ̃wo hã me;</para>
  <para style="q2" vid="PSA 19:13">womaɖu dzinye akpɔ o.</para>
  <para style="q1" vid="PSA 19:13">Ekema mazu fɔɖiɖi manɔŋutɔ,</para>
  <para style="q2" vid="PSA 19:13">eye ŋutinye akɔ tso vodada gã me.<verse eid="PSA 19:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 19:14"/>Na be nye numenyawo</para>
  <para style="q2" vid="PSA 19:14">kple nye dzi ƒe ŋugbledede nadze ŋuwò,</para>
  <para style="q2" vid="PSA 19:14">O! Yehowa, nye Agakpe kple nye Xɔnametɔ.<verse eid="PSA 19:14"/></para>
  <chapter eid="PSA 19"/>
  <chapter number="20" style="c" sid="PSA 20"/>
  <para style="cl">Psalmo 20</para>
  <para style="d">David ƒe ha na hɛnɔ la.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 20:1"/>Yehowa netɔ na wò ne èɖo xaxa me;</para>
  <para style="q2" vid="PSA 20:1">Yakob ƒe Mawu la ƒe ŋkɔ nanye ŋuwòdzɔla.<verse eid="PSA 20:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 20:2"/>Neɖo kpekpeɖeŋu ɖe wò tso kɔkɔeƒe la,</para>
  <para style="q2" vid="PSA 20:2">eye wòaɖo xɔname ɖe wò tso Zion.<verse eid="PSA 20:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 20:3"/>Neɖo ŋku wò vɔsawo katã dzi,</para>
  <para style="q2" vid="PSA 20:3">eye wòaxɔ wò numevɔsawo. <char style="qs">Sela</char><verse eid="PSA 20:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 20:4"/>Nena nu si wò dzi di la wò,</para>
  <para style="q2" vid="PSA 20:4">eye wòana wò ɖoɖowo katã nadze edzi na wò.<verse eid="PSA 20:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 20:5"/>Míado dzidzɔɣli ne èɖu dzi, eye míakɔ míaƒe aflagawo dzi</para>
  <para style="q2" vid="PSA 20:5">le míaƒe Mawu la ƒe ŋkɔ me.</para>
  <para style="b" vid="PSA 20:5"/>
  <para style="q1" vid="PSA 20:5">Yehowa awɔ nu siwo katã nèbiae la na wò.<verse eid="PSA 20:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 20:6"/>Azɔ menya be Yehowa ɖe eƒe amesiamina,</para>
  <para style="q2" vid="PSA 20:6">etɔ nɛ tso eƒe nɔƒe kɔkɔe la</para>
  <para style="q2" vid="PSA 20:6">kple eƒe nuɖusi ƒe ŋusẽ, si wòtsɔna ɖea amee.<verse eid="PSA 20:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 20:7"/>Ame aɖewo ɖoa ŋu ɖe tasiaɖamwo ŋu,</para>
  <para style="q2" vid="PSA 20:7">eye ame aɖewo ɖoa dzi ɖe sɔwo ŋu,</para>
  <para style="q1" vid="PSA 20:7">ke míawo ya míeɖo dzi ɖe Yehowa,</para>
  <para style="q2" vid="PSA 20:7">míaƒe Mawu la ƒe ŋkɔ ŋu.<verse eid="PSA 20:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 20:8"/>Ame mawo la, wodzea klo, eye wodzea anyi,</para>
  <para style="q2" vid="PSA 20:8">ke míawo ya, míenɔa tsitre, eye míedzɔna kã.<verse eid="PSA 20:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 20:9"/>O! Yehowa, xɔ na fia la!</para>
  <para style="q2" vid="PSA 20:9">Tɔ na mí ne míeyɔ wò!<verse eid="PSA 20:9"/></para>
  <chapter eid="PSA 20"/>
  <chapter number="21" style="c" sid="PSA 21"/>
  <para style="cl">Psalmo 21</para>
  <para style="d">David ƒe ha na hɛnɔ la.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 21:1"/>O! Yehowa, fia la le dzidzɔ kpɔm le wò ŋusẽ me.</para>
  <para style="q2" vid="PSA 21:1">Ale gbegbe wòle aseye tsom le dziɖuɖu gã siwo nènae la ta!<verse eid="PSA 21:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 21:2"/>Ètsɔ nu si eƒe dzi di la nɛ, eye nèwɔ nu</para>
  <para style="q2" vid="PSA 21:2">siwo wòtsɔ eƒe nu bia la dzi nɛ. <char style="qs">Sela</char><verse eid="PSA 21:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 21:3"/>Ètsɔ yayra xɔasi geɖewo do dza nɛ,</para>
  <para style="q2" vid="PSA 21:3">eye nètsɔ fiakuku si wowɔ kple sika nyuitɔ la ɖɔ nɛ.<verse eid="PSA 21:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 21:4"/>Ebia agbe wò, eye nènae hedidi</para>
  <para style="q2" vid="PSA 21:4">eƒe ŋkekewo tso mavɔ me yi mavɔ me.<verse eid="PSA 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 21:5"/>Eƒe ŋkɔxɔxɔ de du to dziɖuɖu siwo nènae la me.</para>
  <para style="q2" vid="PSA 21:5">Ètsɔ atsyɔ̃ kple bubu kɔ ɖe eya amea dzi.<verse eid="PSA 21:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 21:6"/>Vavã ènae yayra si nu meyina o,</para>
  <para style="q2" vid="PSA 21:6">eye nèna dzidzɔkpɔkpɔ kple aseyetsotsoe le ŋkuwò me.<verse eid="PSA 21:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 21:7"/>Elabena fia la ɖo dzi ɖe Yehowa ŋu,</para>
  <para style="q2" vid="PSA 21:7">eye le Dziƒoʋĩtɔ la ƒe lɔlɔ̃ si meʋãna o ta la,</para>
  <para style="q2" vid="PSA 21:7">mavɔ̃ akpɔ gbeɖe o.<verse eid="PSA 21:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 21:8"/>Wò asi alé wò futɔwo katã,</para>
  <para style="q2" vid="PSA 21:8">eye wò nuɖusi atu wò ketɔwo.<verse eid="PSA 21:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 21:9"/>Ne wò vavaɣi ɖo la,</para>
  <para style="q2" vid="PSA 21:9">àwɔ wo abe kpodzo bibi ene.</para>
  <para style="q1" vid="PSA 21:9">Yehowa ami wo le eƒe dɔmedzoe me,</para>
  <para style="q2" vid="PSA 21:9">eye eƒe dzo afia wo katã.<verse eid="PSA 21:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 21:10"/>Àtsrɔ̃ woƒe dzidzimeviwo ɖa le anyigba dzi,</para>
  <para style="q2" vid="PSA 21:10">eye àtsrɔ̃ woƒe nunɔamesiwo ɖa le amegbetɔwo dome.<verse eid="PSA 21:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 21:11"/>Togbɔ be wole vɔ̃ ɖom ɖe ŋuwò,</para>
  <para style="q2" vid="PSA 21:11">eye wowɔ ɖoɖowo be woasẽ ŋuta le ŋuwò hã la,</para>
  <para style="q2" vid="PSA 21:11">madze edzi na wo o,<verse eid="PSA 21:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 21:12"/>elabena ne èdidi wò aŋutrɔ ɖe wo dzi la,</para>
  <para style="q2" vid="PSA 21:12">woatrɔ ʋu me ade wò adzo.<verse eid="PSA 21:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 21:13"/>Ède ŋgɔ, O! Yehowa, le wò ŋusẽ me;</para>
  <para style="q2" vid="PSA 21:13">eya ta míadzi ha, eye míakafu wò ŋusẽ.<verse eid="PSA 21:13"/></para>
  <chapter eid="PSA 21"/>
  <chapter number="22" style="c" sid="PSA 22"/>
  <para style="cl">Psalmo 22</para>
  <para style="d">David ƒe ha na hɛnɔ la, ne woadzi ɖe “Zinɔ le ŋdi kanyaa” ƒe gbeɖiɖi nu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 22:1"/>Nye Mawu, nye Mawu, nu ka ŋuti nègblẽm ɖi?</para>
  <para style="q2" vid="PSA 22:1">Nu ka ta nèle adzɔge ʋĩi na xɔxɔ nam,</para>
  <para style="q2" vid="PSA 22:1">eye nète ɖa xaa tso nye hũɖeɖe gbɔ?<verse eid="PSA 22:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 22:2"/>O! Nye Mawu, medo ɣli na wò le ŋkeke</para>
  <para style="q2" vid="PSA 22:2">kple zã me; megale edzi ko,</para>
  <para style="q2" vid="PSA 22:2">gake mètɔ nam o.<verse eid="PSA 22:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 22:3"/>Ke wò la, èle kɔkɔe, eye Israel ƒe kafukafuhawo zu</para>
  <para style="q2" vid="PSA 22:3">fiazikpui nènɔ anyi ɖe edzi gli.<verse eid="PSA 22:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 22:4"/>Mewòe mía fofowo tsɔ woƒe xɔse dee,</para>
  <para style="q2" vid="PSA 22:4">woka ɖe dziwò, eye nèɖe wo.<verse eid="PSA 22:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 22:5"/>Wodo ɣli na wò, eye nèɖe wo,</para>
  <para style="q2" vid="PSA 22:5">dziwòe woka ɖo, eye ŋu mekpe wo o.<verse eid="PSA 22:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 22:6"/>Ke nye la, ŋɔ menye, menye amegbetɔ o,</para>
  <para style="q2" vid="PSA 22:6">elabena amewo ɖu fewu le ŋunye, eye wodo vlom.<verse eid="PSA 22:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 22:7"/>Ame siwo katã kpɔm la ɖe alɔme le ŋunye;</para>
  <para style="q2" vid="PSA 22:7">woflɔa dzu ɖe dzinye, eye woʋuʋua ta ɖe ŋunye gblɔna be:<verse eid="PSA 22:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 22:8"/>“Eka ɖe Yehowa dzi,</para>
  <para style="q2" vid="PSA 22:8">Yehowa neɖee míakpɔ.</para>
  <para style="q2" vid="PSA 22:8">Yehowa neɖee, elabena eƒe nu nyo eŋu.”<verse eid="PSA 22:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 22:9"/>Ke wòe hem tso vidzidɔ me,</para>
  <para style="q2" vid="PSA 22:9">eye le danye ƒe no nu ke, èna meka ɖe dziwò.<verse eid="PSA 22:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 22:10"/>Wòe nye nye Mawu tso danye ƒe dɔ me</para>
  <para style="q2" vid="PSA 22:10">ke, eye tso ɖevime wotsɔm de asi na wò.<verse eid="PSA 22:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 22:11"/>Mèganɔ adzɔge tso gbɔnye o,</para>
  <para style="q2" vid="PSA 22:11">elabena xaxa tum,</para>
  <para style="q2" vid="PSA 22:11">eye ame aɖeke meli axɔ nam o.<verse eid="PSA 22:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 22:12"/>Nyitsu geɖewo ɖe to ɖem;</para>
  <para style="q2" vid="PSA 22:12">Basan nyitsu sesẽwo ƒo xlãm.<verse eid="PSA 22:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 22:13"/>Woke woƒe nuwo ɖe ŋunye baa</para>
  <para style="q2" vid="PSA 22:13">abe dzata si le gbe tem hele nu si wòlé la vuvum ene.<verse eid="PSA 22:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 22:14"/>Woƒom ɖe anyi abe tsi ene,</para>
  <para style="q2" vid="PSA 22:14">eye nye ƒuwo katã gli le woƒe kpeƒewo.</para>
  <para style="q2" vid="PSA 22:14">Nye dzi lolõ ɖe dɔ me nam gbanaa hesi to menye.<verse eid="PSA 22:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 22:15"/>Ŋusẽ vɔ le ŋunye abe ze gbagbã ene,</para>
  <para style="q2" vid="PSA 22:15">eye nye aɖe lé ɖe nye nu me,</para>
  <para style="q2" vid="PSA 22:15">elabena ètsɔm mlɔ ku ƒe ʋuʋudedi me.<verse eid="PSA 22:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 22:16"/>Avuwo ƒo xlãm,</para>
  <para style="q2" vid="PSA 22:16">ame vɔ̃ɖiwo ƒe ha ɖe to ɖem,</para>
  <para style="q2" vid="PSA 22:16">eye wotsɔ nu ŋɔ nye asiwo kple afɔwo.<verse eid="PSA 22:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 22:17"/>Mate ŋu axlẽ nye ƒuwo,</para>
  <para style="q2" vid="PSA 22:17">amewo fɔ ŋku ɖe dzinye,</para>
  <para style="q2" vid="PSA 22:17">eye wokpɔ dzidzɔ le nye anyidzedze ŋuti.<verse eid="PSA 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 22:18"/>Woma nye awuwo na wo nɔewo,</para>
  <para style="q2" vid="PSA 22:18">eye woda akɔ ɖe nye awu ʋlaya dzi.<verse eid="PSA 22:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 22:19"/>Ke wò, O! Yehowa, mèganɔ adzɔge o;</para>
  <para style="q2" vid="PSA 22:19">O! Nye ŋusẽ, va kaba nàɖem.<verse eid="PSA 22:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 22:20"/>Ɖe nye agbe tso yi ƒe asi me,</para>
  <para style="q2" vid="PSA 22:20">eye ɖe nye agbe xɔasi la tso avuwo ƒe ŋusẽ me.<verse eid="PSA 22:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 22:21"/>Ɖem le dzatawo ƒe nu me,</para>
  <para style="q2" vid="PSA 22:21">eye nàɖem le towo ƒe dzowo nu.<verse eid="PSA 22:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 22:22"/>Maɖe gbeƒã wò ŋkɔ na nɔvinyewo,</para>
  <para style="q2" vid="PSA 22:22">eye le amehawo dome, makafu wò.<verse eid="PSA 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 22:23"/>Mi ame siwo vɔ̃a Yehowa, mikafui!</para>
  <para style="q2" vid="PSA 22:23">Mi, Yakob ƒe dzidzimeviwo, mide bubu eŋuti!</para>
  <para style="q2" vid="PSA 22:23">Misroe ɖa, mi Israel ƒe dzidzimeviwo!<verse eid="PSA 22:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 22:24"/>Elabena menyɔ ŋu alo do vlo</para>
  <para style="q2" vid="PSA 22:24">ame siwo le fu kpem la ƒe hiãtuame o;</para>
  <para style="q1" vid="PSA 22:24">meɣla eƒe mo ɖee o,</para>
  <para style="q2" vid="PSA 22:24">ke boŋ eɖo to eƒe ɣlidodo na kpekpeɖeŋu.<verse eid="PSA 22:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 22:25"/>Gbɔwòe nye kafukafuha si medzina</para>
  <para style="q2" vid="PSA 22:25">le ameha gãwo dome la ƒe tanya tsona.</para>
  <para style="q1" vid="PSA 22:25">Maxe nye adzɔgbeɖefewo</para>
  <para style="q2" vid="PSA 22:25">le ame siwo vɔ̃a wò la ŋkume.<verse eid="PSA 22:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 22:26"/>Hiãtɔwo aɖu nu aɖi ƒo;</para>
  <para style="q2" vid="PSA 22:26">ame siwo dia Yehowa la akafui.</para>
  <para style="q2" vid="PSA 22:26">Miaƒe dziwo nenɔ agbe tegbee!<verse eid="PSA 22:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 22:27"/>Anyigba ƒe mlɔenu katã hã aɖo ŋku edzi,</para>
  <para style="q2" vid="PSA 22:27">atrɔ ɖe Yehowa ŋu,</para>
  <para style="q1" vid="PSA 22:27">eye anyigbadzidukɔwo ƒe ƒomeawo katã</para>
  <para style="q2" vid="PSA 22:27">ava de ta agu ɖe eŋkume.<verse eid="PSA 22:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 22:28"/>Elabena fiaɖuɖu la nye Yehowa tɔ,</para>
  <para style="q2" vid="PSA 22:28">eye wòɖu fia ɖe dukɔwo dzi.<verse eid="PSA 22:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 22:29"/>Kesinɔtɔ siwo katã le anyigba dzi la</para>
  <para style="q2" vid="PSA 22:29">aɖu nu, eye woasubɔe;</para>
  <para style="q1" vid="PSA 22:29">ame siwo katã mate ŋu anɔ agbe o,</para>
  <para style="q2" vid="PSA 22:29">eye woyi ɖe ke ƒe tume la adze klo ɖe eŋkume.<verse eid="PSA 22:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 22:30"/>Dzidzimewo asubɔe, eye dzidzime siwo ava dzɔ la,</para>
  <para style="q2" vid="PSA 22:30">woagblɔ nya na wo tso Aƒetɔ la ŋuti.<verse eid="PSA 22:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 22:31"/>Woaɖe gbeƒã eƒe dzɔdzɔenyenye na</para>
  <para style="q2" vid="PSA 22:31">ame siwo meva dzɔ haɖe o,</para>
  <para style="q2" vid="PSA 22:31">elabena eyae wɔe.<verse eid="PSA 22:31"/></para>
  <chapter eid="PSA 22"/>
  <chapter number="23" style="c" sid="PSA 23"/>
  <para style="cl">Psalmo 23</para>
  <para style="d">David ƒe ha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 23:1"/>Yehowae nye kplɔnyela,</para>
  <para style="q2" vid="PSA 23:1">eya ta naneke mahiãm o.<verse eid="PSA 23:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 23:2"/>Lãnyiƒe damawo dzi wòna metsyɔ akɔ ɖo,</para>
  <para style="q2" vid="PSA 23:2">eye wòkplɔm yi tɔʋu fafɛwo gbɔe,<verse eid="PSA 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 23:3"/>hena nye luʋɔ gbɔ agbe.</para>
  <para style="q2" vid="PSA 23:3">Ekplɔm to dzɔdzɔenyenye ƒe</para>
  <para style="q2" vid="PSA 23:3">mɔwo dzi le eƒe ŋkɔ la ta.<verse eid="PSA 23:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 23:4"/>Ne mezɔ to ku ƒe balime si do viviti tsiɖitsiɖi hã la,</para>
  <para style="q2" vid="PSA 23:4">nyemavɔ̃ dzɔgbevɔ̃e aɖeke o,</para>
  <para style="q1" vid="PSA 23:4">elabena wòe le gbɔnye, eye wò lãkplɔti</para>
  <para style="q2" vid="PSA 23:4">kple atikplɔ faa akɔ nam.<verse eid="PSA 23:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 23:5"/>Èɖo kplɔ̃ ɖe akɔnyeme le nye ketɔwo ƒe ŋkume.</para>
  <para style="q2" vid="PSA 23:5">Èsi ami ɖe ta nam, nye kplu yɔ gbagba.<verse eid="PSA 23:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 23:6"/>Vavãe, dzɔgbenyui kple amenuveve adze yonyeme</para>
  <para style="q2" vid="PSA 23:6">le nye agbemeŋkekewo katã me,</para>
  <para style="q2" vid="PSA 23:6">eye manɔ Yehowa ƒe aƒe me ɖaa.<verse eid="PSA 23:6"/></para>
  <chapter eid="PSA 23"/>
  <chapter number="24" style="c" sid="PSA 24"/>
  <para style="cl">Psalmo 24</para>
  <para style="d">David ƒe ha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 24:1"/>Anyigba kple nu siwo katã yɔ edzi,</para>
  <para style="q2" vid="PSA 24:1">xexea me kple emenɔlawo katã nye Yehowa tɔ.<verse eid="PSA 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 24:2"/>Elabena eɖoe anyi ɖe atsiaƒu dzi,</para>
  <para style="q2" vid="PSA 24:2">eye wòɖo egɔme anyi ɖe tɔsisiwo dzi gli.<verse eid="PSA 24:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 24:3"/>Ame kae alia Yehowa ƒe togbɛ?</para>
  <para style="q2" vid="PSA 24:3">Ame kae atsi tsitre ɖe eƒe kɔkɔeƒe la?<verse eid="PSA 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 24:4"/>Ame si ƒe asi me dza, eye eƒe dzi me le dzadzɛe,</para>
  <para style="q2" vid="PSA 24:4">ame si metsɔ eƒe luʋɔ na legba o,</para>
  <para style="q2" vid="PSA 24:4">eye mekaa aʋatso heta nu dzodzro o.<verse eid="PSA 24:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 24:5"/>Eya axɔ yayra tso Yehowa gbɔ, eye Mawu,</para>
  <para style="q2" vid="PSA 24:5">eƒe Ɖela la, atso afia nɛ.<verse eid="PSA 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 24:6"/>O! Yakob ƒe Mawu,</para>
  <para style="q2" vid="PSA 24:6">aleae dzidzime si dia wò,</para>
  <para style="q2" vid="PSA 24:6">eye wòdia ŋkuwòme la le. <char style="qs">Sela</char><verse eid="PSA 24:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 24:7"/>O! Mi agbowo, miʋu;</para>
  <para style="q2" vid="PSA 24:7">mi blemaʋɔtruwo, miʋu,</para>
  <para style="q2" vid="PSA 24:7">ne Ŋutikɔkɔefia la nage ɖe eme.<verse eid="PSA 24:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 24:8"/>Ame kae nye Ŋutikɔkɔefia la?</para>
  <para style="q2" vid="PSA 24:8">Yehowa ŋusẽtɔ kple kalẽtɔ lae,</para>
  <para style="q2" vid="PSA 24:8">Yehowa si wɔa kalẽ le aʋagbedzi lae.<verse eid="PSA 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 24:9"/>O! Mi agbowo, miʋu;</para>
  <para style="q2" vid="PSA 24:9">mi blemaʋɔtruwo, miʋu,</para>
  <para style="q2" vid="PSA 24:9">ne Ŋutikɔkɔefia la nage ɖe eme.<verse eid="PSA 24:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 24:10"/>Ame kae nye Ŋutikɔkɔefia sia?</para>
  <para style="q2" vid="PSA 24:10">Yehowa Ŋusẽkatãtɔ lae nye Ŋutikɔkɔefia la. <char style="qs">Sela.</char><verse eid="PSA 24:10"/></para>
  <chapter eid="PSA 24"/>
  <chapter number="25" style="c" sid="PSA 25"/>
  <para style="cl">Psalmo 25</para>
  <para style="d">David ƒe ha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 25:1"/>O! Yehowa,</para>
  <para style="q2" vid="PSA 25:1">wòe mekɔ nye luʋɔ ɖe dzi na.<verse eid="PSA 25:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 25:2"/>O! Nye Mawu, ŋuwòe meɖo dzi ɖo.</para>
  <para style="q2" vid="PSA 25:2">Mègana ŋu nakpem,</para>
  <para style="q2" vid="PSA 25:2">alo nàɖe mɔ nye futɔwo naɖu dzinye o.<verse eid="PSA 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 25:3"/>Ame si tsɔ eƒe mɔkpɔkpɔ da ɖe dziwò la,</para>
  <para style="q2" vid="PSA 25:3">ŋu makpee akpɔ gbeɖe o;</para>
  <para style="q2" vid="PSA 25:3">gake ŋu akpe ame siwo nye vivimenuwɔlawo.<verse eid="PSA 25:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 25:4"/>O! Yehowa, fia wò mɔwo</para>
  <para style="q2" vid="PSA 25:4">kple wò toƒewom,<verse eid="PSA 25:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 25:5"/>kplɔm le wò nyateƒe la me, eye nàfia num,</para>
  <para style="q2" vid="PSA 25:5">elabena wòe nye nye Mawu kple nye Ɖela,</para>
  <para style="q2" vid="PSA 25:5">eye nye mɔkpɔkpɔ le mewò ŋkeke blibo la katã.<verse eid="PSA 25:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 25:6"/>O! Yehowa, ɖo ŋku wò lɔlɔ̃</para>
  <para style="q2" vid="PSA 25:6">kple wò nublanuikpɔkpɔ sɔgbɔ la dzi,</para>
  <para style="q2" vid="PSA 25:6">elabena woli tso blema ke.<verse eid="PSA 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 25:7"/>O! Yehowa, mègaɖo ŋku nye ɖekakpuimenu vɔ̃wo</para>
  <para style="q2" vid="PSA 25:7">kple nye aglãdzemɔwo dzi o;</para>
  <para style="q1" vid="PSA 25:7">ke boŋ ɖo ŋku dzinye le wò lɔlɔ̃ la ta,</para>
  <para style="q2" vid="PSA 25:7">elabena nyuiwɔwɔ le mewò.<verse eid="PSA 25:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 25:8"/>Yehowa nyo, eye wòwɔa nu dzɔdzɔe,</para>
  <para style="q2" vid="PSA 25:8">eya ta efiaa eƒe mɔ nu vɔ̃ wɔlawo.<verse eid="PSA 25:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 25:9"/>Ekplɔa ɖokuibɔbɔlawo to nu dzɔdzɔe wɔwɔ me,</para>
  <para style="q2" vid="PSA 25:9">eye wòfiaa eƒe mɔ wo.<verse eid="PSA 25:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 25:10"/>Yehowa ƒe mɔwo katã nye lɔlɔ̃ kple nuteƒewɔwɔ na</para>
  <para style="q2" vid="PSA 25:10">ame siwo léa eƒe nubablamenyawo ɖe asi.<verse eid="PSA 25:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 25:11"/>O! Yehowa, togbɔ be nye dzidada sɔ gbɔ ale gbegbe hã la,</para>
  <para style="q2" vid="PSA 25:11">tsɔ wo kem le wò ŋkɔ la ta.<verse eid="PSA 25:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 25:12"/>Ekema ame kawoe nye ŋutsu ma siwo vɔ̃a Yehowa?</para>
  <para style="q2" vid="PSA 25:12">Afia nu wo le mɔ si woato la dzi.<verse eid="PSA 25:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 25:13"/>Woakpɔ dzidzedze le woƒe agbemeŋkekewo me,</para>
  <para style="q2" vid="PSA 25:13">eye woƒe dzidzimeviwo anyi anyigba la ƒe dome.<verse eid="PSA 25:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 25:14"/>Yehowa gblɔa nya ɣaɣlawo na ame siwo vɔ̃nɛ,</para>
  <para style="q2" vid="PSA 25:14">eye wòɖea eƒe nubabla fiaa wo.<verse eid="PSA 25:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 25:15"/>Nye ŋkuwo le Yehowa ŋu ɖaa,</para>
  <para style="q2" vid="PSA 25:15">elabena eya koe aɖe nye afɔ le mɔ me.<verse eid="PSA 25:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 25:16"/>Trɔ ɖe ŋunye ne nàve nunye,</para>
  <para style="q2" vid="PSA 25:16">elabena metsi akogo, eye hiã tum.<verse eid="PSA 25:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 25:17"/>Nye dzi ƒe nuxaxawo do gã ɖe edzi,</para>
  <para style="q2" vid="PSA 25:17">na vovom tso nye vevesesewo me.<verse eid="PSA 25:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 25:18"/>Nye kɔ nàkpɔ nye nuxaxa kple nye vevesese ɖa,</para>
  <para style="q2" vid="PSA 25:18">eye nàɖe nye nu vɔ̃wo katã ɖa.<verse eid="PSA 25:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 25:19"/>Kpɔ ale si nye futɔwo dzi ɖe edzii ɖa,</para>
  <para style="q2" vid="PSA 25:19">eye nàkpɔ ale si wolé fum ɖikaɖikae ɖa!<verse eid="PSA 25:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 25:20"/>Kpɔ nye agbe ta, eye nàɖem;</para>
  <para style="q2" vid="PSA 25:20">megana ŋu nakpem o, elabena mewòe mebe ɖo.<verse eid="PSA 25:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 25:21"/>Nuteƒewɔwɔ kple dzɔdzɔenyenye nedzɔ ŋunye,</para>
  <para style="q2" vid="PSA 25:21">elabena nye mɔkpɔkpɔ le mewò.<verse eid="PSA 25:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 25:22"/>O! Mawu,</para>
  <para style="q2" vid="PSA 25:22">ɖe Israel tso woƒe xaxawo katã me.<verse eid="PSA 25:22"/></para>
  <chapter eid="PSA 25"/>
  <chapter number="26" style="c" sid="PSA 26"/>
  <para style="cl">Psalmo 26</para>
  <para style="d">David ƒa ha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 26:1"/>O! Yehowa, tso afia nam,</para>
  <para style="q2" vid="PSA 26:1">elabena menɔ agbe si ŋu fɔɖiɖi mele o.</para>
  <para style="q1" vid="PSA 26:1">Meɖo dzi ɖe Yehowa ŋu,</para>
  <para style="q2" vid="PSA 26:1">nyemeʋã kpɔ gbeɖe o.<verse eid="PSA 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 26:2"/>O! Yehowa, lolom, dom kpɔ;</para>
  <para style="q2" vid="PSA 26:2">eye nàdzro nye dzi kple tamesusu hã me,<verse eid="PSA 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 26:3"/>elabena wò lɔlɔ̃ le ŋkunye me ɖaa,</para>
  <para style="q2" vid="PSA 26:3">eye mezɔna le wò nyateƒe la me ɣe sia ɣi.<verse eid="PSA 26:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 26:4"/>Nyemanɔ anyi ɖe ameblelawo dome,</para>
  <para style="q2" vid="PSA 26:4">alo ade ha kple alakpanuwɔlawo o.<verse eid="PSA 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 26:5"/>Metsri ame tovowo ƒe habɔbɔ,</para>
  <para style="q2" vid="PSA 26:5">eye megbe be nyemanɔ ame vɔ̃ɖiwo dome o.<verse eid="PSA 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 26:6"/>Meklɔ nye asiwo le fɔmaɖimaɖi me,</para>
  <para style="q2" vid="PSA 26:6">eye meƒo xlã wò vɔsamlekpui, O! Yehowa,<verse eid="PSA 26:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 26:7"/>hele wò kafukafuha dzim</para>
  <para style="q2" vid="PSA 26:7">kple ɣli le nukudɔ siwo katã nèwɔ la xlẽm fia.<verse eid="PSA 26:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 26:8"/>O! Yehowa, melɔ̃ aƒe si me nèle,</para>
  <para style="q2" vid="PSA 26:8">afi si wò ŋutikɔkɔe le.<verse eid="PSA 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 26:9"/>Mègatsɔ nye luʋɔ kpe ɖe nu vɔ̃ wɔlawo ŋuti</para>
  <para style="q2" vid="PSA 26:9">kple nye agbe kpe ɖe hlɔ̃dolawo ŋuti,<verse eid="PSA 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 26:10"/>ame siwo ƒe asi me ɖoɖo vɔ̃ɖiwo le,</para>
  <para style="q2" vid="PSA 26:10">eye woƒe nuɖusime yɔ fũu kple zãnuxɔxɔ o.<verse eid="PSA 26:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 26:11"/>Ke nye la, menɔ agbe si ŋu fɔɖiɖi mele o,</para>
  <para style="q2" vid="PSA 26:11">eya ta ɖem, eye nàkpɔ nublanui nam.<verse eid="PSA 26:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 26:12"/>Nye afɔ le sɔsɔeƒe.</para>
  <para style="q2" vid="PSA 26:12">Makafu Yehowa le takpekpe gã la me.<verse eid="PSA 26:12"/></para>
  <chapter eid="PSA 26"/>
  <chapter number="27" style="c" sid="PSA 27"/>
  <para style="cl">Psalmo 27</para>
  <para style="d">David ƒe ha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 27:1"/>Yehowae nye nye kekeli kple nye ɖeɖe.</para>
  <para style="q2" vid="PSA 27:1">Ame ka mavɔ̃?</para>
  <para style="q1" vid="PSA 27:1">Yehowae nye mɔ sesẽ na nye agbe,</para>
  <para style="q2" vid="PSA 27:1">ame ka adzi ŋɔ nam?<verse eid="PSA 27:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 27:2"/>Ne ame vɔ̃ɖiwo lũ ɖe dzinye be woavuvum,</para>
  <para style="q2" vid="PSA 27:2">ne nye futɔwo kple nye ketɔwo lũ ɖe dzinye la,</para>
  <para style="q2" vid="PSA 27:2">woakli nu adze anyi.<verse eid="PSA 27:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 27:3"/>Togbɔ be aʋakɔ gã aɖe ɖe to ɖem hã la,</para>
  <para style="q2" vid="PSA 27:3">nye dzi mavɔ̃ o,</para>
  <para style="q1" vid="PSA 27:3">togbɔ be wodze aʋa ɖe ŋunye hã la,</para>
  <para style="q2" vid="PSA 27:3">azɔ koŋ dzi aɖo ƒonye.<verse eid="PSA 27:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 27:4"/>Nu ɖeka mebia Yehowa,</para>
  <para style="q2" vid="PSA 27:4">esiae nye be manɔ Yehowa ƒe aƒe me</para>
  <para style="q1" vid="PSA 27:4">le nye agbemeŋkekewo katã me,</para>
  <para style="q2" vid="PSA 27:4">ne malé ŋku ɖe Yehowa ƒe nyonyo ŋu,</para>
  <para style="q2" vid="PSA 27:4">eye madii le eƒe gbedoxɔ me.<verse eid="PSA 27:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 27:5"/>Elabena le xaxaɣiwo la,</para>
  <para style="q2" vid="PSA 27:5">atsyɔ nu dzinye le eƒe nɔƒe la me;</para>
  <para style="q1" vid="PSA 27:5">aɣlam ɖe eƒe agbadɔ ƒe bebeƒe,</para>
  <para style="q2" vid="PSA 27:5">eye wòakɔm aɖo agakpe kɔkɔ aɖe dzi.<verse eid="PSA 27:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 27:6"/>Ekema nye ta akɔ dzi agbɔ nye futɔ</para>
  <para style="q2" vid="PSA 27:6">siwo ƒo xlãm godoo la ta;</para>
  <para style="q1" vid="PSA 27:6">matsɔ dzidzɔɣli asa vɔ nɛ le eƒe agbadɔ kɔkɔe la me.</para>
  <para style="q2" vid="PSA 27:6">Madzi ha, eye maƒo saŋku na Yehowa.<verse eid="PSA 27:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 27:7"/>O! Yehowa, se nye gbe, ne meyɔ wò;</para>
  <para style="q2" vid="PSA 27:7">kpɔ nublanui nam, eye nàtɔ nam.<verse eid="PSA 27:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 27:8"/>Nye dzi le gbɔgblɔm le ŋuwò be,</para>
  <para style="q2" vid="PSA 27:8">“Di eƒe ŋkume!”</para>
  <para style="q2" vid="PSA 27:8">Yehowa, wò ŋkumee madi.<verse eid="PSA 27:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 27:9"/>Mègaɣla wò ŋkume ɖem o,</para>
  <para style="q2" vid="PSA 27:9">mègatrɔ wò dɔla ɖo ɖa le dɔmedzoe me o,</para>
  <para style="q2" vid="PSA 27:9">elabena wòe nye nye xɔnametɔ.</para>
  <para style="q1" vid="PSA 27:9">O! Mawu, nye Ɖela,</para>
  <para style="q2" vid="PSA 27:9">mègagbe nu le gbɔnye alo agblem ɖi o.<verse eid="PSA 27:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 27:10"/>Togbɔ be tɔnye kple nɔnye gblem ɖi hã la,</para>
  <para style="q2" vid="PSA 27:10">Yehowa axɔm.<verse eid="PSA 27:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 27:11"/>O! Yehowa, fia wò mɔwom;</para>
  <para style="q2" vid="PSA 27:11">kplɔm to mɔ dzɔdzɔe dzi,</para>
  <para style="q2" vid="PSA 27:11">le ame siwo tem ɖe to la ta.<verse eid="PSA 27:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 27:12"/>Mègatsɔm de asi na nye futɔwo ƒe didi o,</para>
  <para style="q2" vid="PSA 27:12">elabena alakpaɖasefowo tso ɖe ŋutinye kpe ɖe</para>
  <para style="q2" vid="PSA 27:12">ame siwo lɔ ŋutasesẽ ƒe gbɔgbɔtsixɛ ɖe ƒo la ŋuti.<verse eid="PSA 27:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 27:13"/>Esia nye nu si dzi meka ɖo la be:</para>
  <para style="q2" vid="PSA 27:13">Makpɔ Yehowa ƒe nu nyuiwo</para>
  <para style="q2" vid="PSA 27:13">le agbagbeawo ƒe anyigba dzi.<verse eid="PSA 27:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 27:14"/>Kpɔ mɔ na Yehowa;</para>
  <para style="q2" vid="PSA 27:14">sẽ ŋu, eye nàlé dzi ɖe ƒo.</para>
  <para style="q2" vid="PSA 27:14">Kpɔ mɔ na Yehowa.<verse eid="PSA 27:14"/></para>
  <chapter eid="PSA 27"/>
  <chapter number="28" style="c" sid="PSA 28"/>
  <para style="cl">Psalmo 28</para>
  <para style="d">David ƒe ha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 28:1"/>O! Yehowa, nye Agakpe,</para>
  <para style="q2" vid="PSA 28:1">wò yɔm mele, mègado tokum o.</para>
  <para style="q1" vid="PSA 28:1">Elabena ne èzi ɖoɖoe la,</para>
  <para style="q2" vid="PSA 28:1">manɔ abe ame siwo yi aʋlime la ene.<verse eid="PSA 28:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 28:2"/>Esi mekɔ nye asiwo dzi ɖo ɖe wò Kɔkɔeƒewo ƒe Kɔkɔƒe la gbɔ la,</para>
  <para style="q2" vid="PSA 28:2">se nye ɣlidodo na nublanuikpɔkpɔ,</para>
  <para style="q2" vid="PSA 28:2">ne meyɔ wò be nàxɔ nam.<verse eid="PSA 28:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 28:3"/>Mègakplɔm kpe ɖe ame vɔ̃ɖiwo ŋu o,</para>
  <para style="q2" vid="PSA 28:3">ame siwo ƒoa nu kple aƒelikawo fafɛ,</para>
  <para style="q2" vid="PSA 28:3">gake vɔ̃ɖivɔ̃ɖi le woƒe dzi me.<verse eid="PSA 28:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 28:4"/>Ɖo eteƒe na wo le woƒe nuwɔnawo</para>
  <para style="q2" vid="PSA 28:4">kple woƒe dɔwɔwɔ vɔ̃wo ta.</para>
  <para style="q1" vid="PSA 28:4">Xe fe na wo ɖe nu si woƒe asiwo wɔ la nu,</para>
  <para style="q2" vid="PSA 28:4">eye nàgbugbɔ tohehe si wodze na la ahe va wo dzii.<verse eid="PSA 28:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 28:5"/>Esi womede bubu Yehowa ƒe nuwɔnawo</para>
  <para style="q2" vid="PSA 28:5">kple eƒe asinudɔwo ŋuti o ta la,</para>
  <para style="q1" vid="PSA 28:5">àgbã wo aƒu anyi,</para>
  <para style="q2" vid="PSA 28:5">eye màgbugbɔ wo atu akpɔ gbeɖe o.<verse eid="PSA 28:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 28:6"/>Woakafu Yehowa, elabena ese ɣli si dom mele</para>
  <para style="q2" vid="PSA 28:6">le nublanuikpɔkpɔ biam.<verse eid="PSA 28:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 28:7"/>Yehowae nye nye ŋusẽ kple akpoxɔnu;</para>
  <para style="q2" vid="PSA 28:7">nye dzi ka ɖe eya amea dzi, eye wòɖem.</para>
  <para style="q1" vid="PSA 28:7">Nye dzi ti kpo le dzidzɔkpɔkpɔ ta,</para>
  <para style="q2" vid="PSA 28:7">eye mada akpe nɛ to hadzidzi me.<verse eid="PSA 28:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 28:8"/>Yehowae nye eƒe dukɔ ƒe ŋusẽ;</para>
  <para style="q2" vid="PSA 28:8">ɖeɖe ƒe mɔ sesẽ wònye na eƒe amesiamina.<verse eid="PSA 28:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 28:9"/>Ɖe wò dukɔ, eye nàyra wò domenyinu;</para>
  <para style="q2" vid="PSA 28:9">nànye woƒe kplɔla, eye nàkɔ wo ɖe akɔnu tegbetegbe.<verse eid="PSA 28:9"/></para>
  <chapter eid="PSA 28"/>
  <chapter number="29" style="c" sid="PSA 29"/>
  <para style="cl">Psalmo 29</para>
  <para style="d">David ƒe ha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 29:1"/>Mitsɔ bubu na Yehowa, O! Mi ŋusẽtɔwo,</para>
  <para style="q2" vid="PSA 29:1">mitsɔ ŋutikɔkɔe kple ŋusẽ na Yehowa.<verse eid="PSA 29:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 29:2"/>Mitsɔ ŋutikɔkɔe si dze Yehowa ƒe ŋkɔ nɛ;</para>
  <para style="q2" vid="PSA 29:2">misubɔ Yehowa le eƒe kɔkɔenyenye ƒe atsyɔ̃ me.<verse eid="PSA 29:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 29:3"/>Yehowa ƒe gbe ɖi le tsiwo dzi;</para>
  <para style="q2" vid="PSA 29:3">Ŋutikɔkɔe ƒe Mawu la ɖe gbe,</para>
  <para style="q2" vid="PSA 29:3">eye Yehowa ɖe gbe le tsi gãwo dzi.<verse eid="PSA 29:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 29:4"/>Ŋusẽ le Yehowa ƒe gbe ŋu,</para>
  <para style="q2" vid="PSA 29:4">eye ŋutikɔkɔe nye Yehowa ƒe gbe.<verse eid="PSA 29:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 29:5"/>Yehowa ƒe gbe ŋe Lebanon ƒe sedatiwo.<verse eid="PSA 29:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 29:6"/>Ena Lebanon ti kpo abe nyivi ene,</para>
  <para style="q2" vid="PSA 29:6">eye Sirion hã abe tovi ene.<verse eid="PSA 29:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 29:7"/>Yehowa ƒe gbe ke dzo mia abe dzikedzo ene.<verse eid="PSA 29:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 29:8"/>Yehowa ƒe gbe ʋuʋu dzogbenyigba,</para>
  <para style="q2" vid="PSA 29:8">eye Yehowa ʋuʋu Kades Dzogbenyigba.<verse eid="PSA 29:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 29:9"/>Yehowa na gboti sesẽwo ʋuʋu heyeheye,</para>
  <para style="q2" vid="PSA 29:9">eye wòna avewo lũ xɛ.</para>
  <para style="q1" vid="PSA 29:9">Le eƒe gbedoxɔ me la, ame sia ame do ɣli be,</para>
  <para style="q2" vid="PSA 29:9">“Ŋutikɔkɔe!”<verse eid="PSA 29:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 29:10"/>Yehowa nɔ eƒe fiazikpui dzi gli le tsiɖɔɖɔ dzi.</para>
  <para style="q2" vid="PSA 29:10">Woɖo Yehowa fia tso mavɔ me yi mavɔ me.<verse eid="PSA 29:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 29:11"/>Yehowa naa ŋusẽ eƒe dukɔ;</para>
  <para style="q2" vid="PSA 29:11">eye wòyraa eƒe amewo kple ŋutifafa.<verse eid="PSA 29:11"/></para>
  <chapter eid="PSA 29"/>
  <chapter number="30" style="c" sid="PSA 30"/>
  <para style="cl">Psalmo 30</para>
  <para style="d">David ƒe ha na gbedoxɔ la ŋutikɔkɔ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 30:1"/>O! Yehowa, mado wò ɖe dzi,</para>
  <para style="q2" vid="PSA 30:1">elabena wòe hem do goe tso ʋe globo me,</para>
  <para style="q2" vid="PSA 30:1">eye mèna mezu nu ɖikokoe na nye futɔwo o.<verse eid="PSA 30:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 30:2"/>O! Yehowa, nye Mawu,</para>
  <para style="q2" vid="PSA 30:2">mebia kpekpeɖeŋu tso gbɔwò, eye nèyɔ dɔm.<verse eid="PSA 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 30:3"/>O! Yehowa, wòe ɖem tso tsiẽƒe,</para>
  <para style="q2" vid="PSA 30:3">eye mèna meyi aʋlime o.<verse eid="PSA 30:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 30:4"/>Midzi ha na Yehowa,</para>
  <para style="q2" vid="PSA 30:4">mi eƒe ame kɔkɔewo,</para>
  <para style="q2" vid="PSA 30:4">eye mikafu eƒe ŋkɔ kɔkɔe la.<verse eid="PSA 30:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 30:5"/>Elabena medoa dɔmedzoe eteƒe didina o,</para>
  <para style="q2" vid="PSA 30:5">ke eƒe amenuveve ya nɔa anyi agbenɔɣi katã.</para>
  <para style="q1" vid="PSA 30:5">Avifafa anɔ anyi le zã me,</para>
  <para style="q2" vid="PSA 30:5">gake aseyetsotso ava le ŋdi me.<verse eid="PSA 30:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 30:6"/>Esi mekpɔ be meli ke la, megblɔ be,</para>
  <para style="q2" vid="PSA 30:6">“Nye la, nyemaʋuʋu kpɔ gbeɖe o.”<verse eid="PSA 30:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 30:7"/>O! Yehowa, esi nève nunye la,</para>
  <para style="q2" vid="PSA 30:7">èna nye to li ke zã,</para>
  <para style="q1" vid="PSA 30:7">gake esi nèɣla wò ŋkume ɖem la,</para>
  <para style="q2" vid="PSA 30:7">nye mo tsi dãa.<verse eid="PSA 30:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 30:8"/>Yehowa, wòe meyɔ,</para>
  <para style="q2" vid="PSA 30:8">Yehowae medo ɣli na be wòakpɔ nublanui nam.<verse eid="PSA 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 30:9"/>“Viɖe kae le eme ne donyeme</para>
  <para style="q2" vid="PSA 30:9">gblẽ alo ne meyi ɖe aʋlime?</para>
  <para style="q1" vid="PSA 30:9">Ɖe ʋuʋudedi akafu wòa?</para>
  <para style="q2" vid="PSA 30:9">Ɖe wòaɖe gbeƒã wò nuteƒewɔwɔa?<verse eid="PSA 30:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 30:10"/>See, O! Yehowa, eye nàkpɔ nye nublanui;</para>
  <para style="q2" vid="PSA 30:10">O! Yehowa, kpe ɖe ŋunye.”<verse eid="PSA 30:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 30:11"/>Èna nye avifafa zu ɣeɖuɖu;</para>
  <para style="q2" vid="PSA 30:11">èɖe akpanya le ŋutinye hetsɔ dzidzɔkpɔkpɔ do nam,<verse eid="PSA 30:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 30:12"/>ale be nye dzi nadzi ha na wò, eye mazi ɖoɖoe o.</para>
  <para style="q2" vid="PSA 30:12">O! Yehowa, nye Mawu,</para>
  <para style="q2" vid="PSA 30:12">mada akpe na wò tegbetegbe.<verse eid="PSA 30:12"/></para>
  <chapter eid="PSA 30"/>
  <chapter number="31" style="c" sid="PSA 31"/>
  <para style="cl">Psalmo 31</para>
  <para style="d">David ƒe ha na hɛnɔ la.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 31:1"/>O! Yehowa, mewòe mebe ɖo;</para>
  <para style="q2" vid="PSA 31:1">mègana ŋu nakpem akpɔ gbeɖe o;</para>
  <para style="q2" vid="PSA 31:1">ɖem le wò dzɔdzɔenyenye la ta.<verse eid="PSA 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 31:2"/>Ƒu to anyi ɖe ŋunye, va kaba nàɖem,</para>
  <para style="q2" vid="PSA 31:2">nànye nye xɔxɔ ƒe agakpe</para>
  <para style="q2" vid="PSA 31:2">kple mɔ sesẽ ne nàɖem.<verse eid="PSA 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 31:3"/>Le wò ŋkɔ la ta, kplɔm, eye nàfia mɔm,</para>
  <para style="q2" vid="PSA 31:3">elabena wòe nye nye agakpe kple mɔ sesẽ.<verse eid="PSA 31:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 31:4"/>Ɖem le mɔ si woɖo ɖi nam la me,</para>
  <para style="q2" vid="PSA 31:4">elabena wòe nye nye mɔ sesẽ.<verse eid="PSA 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 31:5"/>Asiwò me metsɔ nye gbɔgbɔ de, eya ta Yehowa,</para>
  <para style="q2" vid="PSA 31:5">nyateƒe ƒe Mawu, va nàɖem.<verse eid="PSA 31:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 31:6"/>Metsri ame siwo ku ɖe legba maɖinuwo ŋu;</para>
  <para style="q2" vid="PSA 31:6">ke nye la meku ɖe Yehowa ŋu.<verse eid="PSA 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 31:7"/>Makpɔ dzidzɔ, eye matso aseye le wò lɔlɔ̃ la me,</para>
  <para style="q2" vid="PSA 31:7">elabena èkpɔ nye hiã henya nye luʋɔ ƒe nuxaxa.<verse eid="PSA 31:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 31:8"/>Mètsɔm de asi na nye futɔ o,</para>
  <para style="q2" vid="PSA 31:8">ke boŋ èɖo nye afɔ gbadzaƒe.<verse eid="PSA 31:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 31:9"/>O! Yehowa, kpɔ nublanui nam,</para>
  <para style="q2" vid="PSA 31:9">elabena nye dzi ʋu dzo,</para>
  <para style="q1" vid="PSA 31:9">nuxaxa na nye ŋkuwo dzi wɔ dɔ̃ɔ,</para>
  <para style="q2" vid="PSA 31:9">eye konyifafa na nye luʋɔ kple ŋutilã gbɔdzɔ.<verse eid="PSA 31:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 31:10"/>Vevesese sɔŋ yɔ nye agbe me,</para>
  <para style="q2" vid="PSA 31:10">eye ŋeŋe xɔ nye agbenɔƒewo me.</para>
  <para style="q1" vid="PSA 31:10">Ŋusẽ vɔ le ŋunye le nye fukpekpewo ta,</para>
  <para style="q2" vid="PSA 31:10">eye nye ƒuwo hã nyunyɔ ɖe lãme nam.<verse eid="PSA 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 31:11"/>Le nye futɔwo ƒe nuwɔnawo ta mezu alɔmeɖenu na nye</para>
  <para style="q2" vid="PSA 31:11">aƒelikawo vevie ŋutɔ.</para>
  <para style="q1" vid="PSA 31:11">Mezu ŋɔdzinu na xɔ̃nyewo,</para>
  <para style="q2" vid="PSA 31:11">eye ame siwo do gom le mɔtata dzi la sina le nunye.<verse eid="PSA 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 31:12"/>Woŋlɔm be abe ɖe meku xoxo ene,</para>
  <para style="q2" vid="PSA 31:12">ale mezu ze gbagbã.<verse eid="PSA 31:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 31:13"/>Mese ame geɖewo ƒe ameŋugblẽnyawo;</para>
  <para style="q2" vid="PSA 31:13">ŋɔdzi ɖe to ɖem, wode adaŋu tso ŋunye,</para>
  <para style="q2" vid="PSA 31:13">eye woɖo nugbe be yewoaɖe nye agbe ɖa.<verse eid="PSA 31:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 31:14"/>Ke wò, Yehowa, dzie meka ɖo;</para>
  <para style="q2" vid="PSA 31:14">megblɔ be, “Wòe nye nye Mawu.”<verse eid="PSA 31:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 31:15"/>Nye ɣeyiɣiwo le asiwò me;</para>
  <para style="q2" vid="PSA 31:15">ɖem tso nye futɔwo kple ame siwo</para>
  <para style="q2" vid="PSA 31:15">le yonyeme tim la ƒe asi me.<verse eid="PSA 31:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 31:16"/>Na wò mo naklẽ ɖe wò dɔla dzi,</para>
  <para style="q2" vid="PSA 31:16">ɖem le wò lɔlɔ̃ si meʋãna o la ta.<verse eid="PSA 31:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 31:17"/>O! Yehowa, mègana ŋu nakpem o,</para>
  <para style="q2" vid="PSA 31:17">elabena wòe medo ɣli na;</para>
  <para style="q1" vid="PSA 31:17">ke na ŋu nakpe ame vɔ̃ɖiwo,</para>
  <para style="q2" vid="PSA 31:17">eye ɖoɖoe nazi le wo nu le yɔme.<verse eid="PSA 31:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 31:18"/>De ga nu na woƒe alakpanuyiwo,</para>
  <para style="q2" vid="PSA 31:18">elabena wotsɔa dada</para>
  <para style="q2" vid="PSA 31:18">kple ɖekematsɔleme gblɔa nya vlo ɖe ame dzɔdzɔe ŋu.<verse eid="PSA 31:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 31:19"/>Wò nu nyui siwo nèdzra ɖo ɖi na</para>
  <para style="q2" vid="PSA 31:19">ame siwo vɔ̃a wò la lolo ŋutɔ.</para>
  <para style="q1" vid="PSA 31:19">Nu nyui siwo nèkɔ ɖe ame siwo</para>
  <para style="q2" vid="PSA 31:19">si wò tso dzi le amewo ƒe ŋkume la lolo.<verse eid="PSA 31:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 31:20"/>Èɣla wo ɖe ɣaɣlaƒe si le gbɔwò,</para>
  <para style="q2" vid="PSA 31:20">tso amewo ƒe ayemenuwo gbɔ.</para>
  <para style="q1" vid="PSA 31:20">Èɣla wo ɖe nɔwòƒe be</para>
  <para style="q2" vid="PSA 31:20">woanɔ dedie tso aɖeɖiƒoame gbɔ.<verse eid="PSA 31:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 31:21"/>Woakafu Yehowa,</para>
  <para style="q2" vid="PSA 31:21">elabena eɖe eƒe nukulɔlɔ̃ la fiam</para>
  <para style="q2" vid="PSA 31:21">le esime mele du si ŋu woƒu kpo ɖo la me.<verse eid="PSA 31:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 31:22"/>Megblɔ le nye dzikatsoƒo me be:</para>
  <para style="q2" vid="PSA 31:22">“Woɖem ɖa le wò ŋkume azɔ!”</para>
  <para style="q1" vid="PSA 31:22">Ke hã la, èse nye nublanuiɣlidodo</para>
  <para style="q2" vid="PSA 31:22">esi meyɔ wò be nàxɔ nam.<verse eid="PSA 31:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 31:23"/>Milɔ̃ Yehowa, mi eƒe ame kɔkɔewo!</para>
  <para style="q2" vid="PSA 31:23">Yehowa kpɔa nuteƒewɔlawo ta,</para>
  <para style="q1" vid="PSA 31:23">ke eɖoa eteƒe na dadalawo wòsɔa gbɔ dea</para>
  <para style="q2" vid="PSA 31:23">woƒe nuwɔnawo nu.<verse eid="PSA 31:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 31:24"/>Misẽ ŋu, eye milé dzi ɖe ƒo, mi ame siwo katã tsɔ</para>
  <para style="q2" vid="PSA 31:24">miaƒe mɔkpɔkpɔ de Yehowa me.<verse eid="PSA 31:24"/></para>
  <chapter eid="PSA 31"/>
  <chapter number="32" style="c" sid="PSA 32"/>
  <para style="cl">Psalmo 32</para>
  <para style="d">David ƒe nufiameha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 32:1"/>Woayra ame si wotsɔ eƒe dzidadawo kee,</para>
  <para style="q2" vid="PSA 32:1">eye wotsyɔ nu eƒe nu vɔ̃wo dzi.<verse eid="PSA 32:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 32:2"/>Woayra ŋutsu si Aƒetɔ la meɖe vodada na o,</para>
  <para style="q2" vid="PSA 32:2">eye alakpa mele eƒe gbɔgbɔ me o.<verse eid="PSA 32:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 32:3"/>Esi mezi ɖoɖoe la,</para>
  <para style="q2" vid="PSA 32:3">nye ŋeŋe atraɖii ŋkeke blibo la katã na nye ƒuwo nyunyɔ.<verse eid="PSA 32:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 32:4"/>Elabena wò asi sẽ ɖe dzinye zã</para>
  <para style="q2" vid="PSA 32:4">kple keli katã, eye ŋusẽ vɔ le ŋunye</para>
  <para style="q2" vid="PSA 32:4">abe dzomeŋɔli ƒe dzoxɔxɔ mee mele ene. <char style="qs">Sela</char><verse eid="PSA 32:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 32:5"/>Tete meɖe nye nu vɔ̃wo fia wò,</para>
  <para style="q2" vid="PSA 32:5">eye nyemetsyɔ nu nye dzidadawo dzi o.</para>
  <para style="q1" vid="PSA 32:5">Megblɔ be, “Maʋu nye dzidadawo me na Yehowa”,</para>
  <para style="q2" vid="PSA 32:5">eye nètsɔ nye nu vɔ̃wo ƒe yomedzenuwo kem. <char style="qs">Sela</char><verse eid="PSA 32:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 32:6"/>Mawumemewo katã nedo gbe ɖa na wò zi ale si nèli kpli wo,</para>
  <para style="q2" vid="PSA 32:6">elabena enye nyateƒe be ne tɔsisi gãwo ɖɔ la, womade wo gbɔ o.<verse eid="PSA 32:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 32:7"/>Wòe nye nye bebeƒe,</para>
  <para style="q2" vid="PSA 32:7">àɖem tso xaxa me, eye àtsɔ ɖeɖe</para>
  <para style="q2" vid="PSA 32:7">ƒe aseyetsohawo aƒo xlãm. <char style="qs">Sela</char><verse eid="PSA 32:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 32:8"/>Mafia nu wò, eye mafia mɔ si nàto la wò.</para>
  <para style="q2" vid="PSA 32:8">Maxlɔ̃ nu wò, eye makpɔ tawò.<verse eid="PSA 32:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 32:9"/>Mèganɔ abe sɔ alo tedzisɔ</para>
  <para style="q2" vid="PSA 32:9">siwo nunya mele tagbɔ na o la ene o,</para>
  <para style="q1" vid="PSA 32:9">elabena ele be woade ka</para>
  <para style="q2" vid="PSA 32:9">kple numega nu me na wo hafi amla wo,</para>
  <para style="q1" vid="PSA 32:9">ne menye nenema o la,</para>
  <para style="q2" vid="PSA 32:9">womate ŋu ate ɖe ŋuwò o.<verse eid="PSA 32:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 32:10"/>Ame vɔ̃ɖiwo kpea fu geɖe,</para>
  <para style="q2" vid="PSA 32:10">ke Yehowa ƒe lɔlɔ̃ si meʋãna o la ƒoa xlã</para>
  <para style="q2" vid="PSA 32:10">ame siwo ɖoa dzi ɖe eŋu la.<verse eid="PSA 32:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 32:11"/>Mikpɔ dzidzɔ, eye mitso aseye ɖe Yehowa ŋu,</para>
  <para style="q2" vid="PSA 32:11">mi ame dzɔdzɔewo;</para>
  <para style="q2" vid="PSA 32:11">midzi ha, mi ame siwo katã ƒe dzi le dzɔdzɔe!<verse eid="PSA 32:11"/></para>
  <chapter eid="PSA 32"/>
  <chapter number="33" style="c" sid="PSA 33"/>
  <para style="cl">Psalmo 33</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 33:1"/>Midzi ha kple dzidzɔ na Yehowa,</para>
  <para style="q2" vid="PSA 33:1">mi ame dzɔdzɔewo;</para>
  <para style="q1" vid="PSA 33:1">edze mi ame siwo ƒe dzi to</para>
  <para style="q2" vid="PSA 33:1">mɔ ɖeka la be woakafui.<verse eid="PSA 33:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 33:2"/>Mikafu Yehowa kple kasaŋkuwo,</para>
  <para style="q2" vid="PSA 33:2">eye miƒo ha nɛ le ka ewo ƒe kasaŋku dzi.<verse eid="PSA 33:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 33:3"/>Midzi ha yeye nɛ;</para>
  <para style="q2" vid="PSA 33:3">miƒo ha nɛ kple ŋusẽ, eye míado dzidzɔɣli.<verse eid="PSA 33:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 33:4"/>Elabena Yehowa ƒe nya nye nyateƒe, eye wòto mɔ ɖeka;</para>
  <para style="q2" vid="PSA 33:4">etoa nyateƒe le nu siwo katã wòwɔna la me.<verse eid="PSA 33:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 33:5"/>Yehowa lɔ̃a dzɔdzɔenyenye kple nuteƒewɔwɔ;</para>
  <para style="q2" vid="PSA 33:5">anyigba yɔ fũu kple eƒe lɔlɔ̃ si meʋãna o.<verse eid="PSA 33:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 33:6"/>Yehowa ƒe nya wotsɔ wɔ dziƒowoe,</para>
  <para style="q2" vid="PSA 33:6">eye eƒe numegbɔgbɔ wotsɔ wɔ wo ŋuti nuwoe.<verse eid="PSA 33:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 33:7"/>Eƒo atsiaƒumetsiwo nu ƒu ɖe kpluwo me,</para>
  <para style="q2" vid="PSA 33:7">eye wòdzra tɔ goglowo ɖo ɖe nudzraɖoƒewo.<verse eid="PSA 33:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 33:8"/>Anyigba katã nevɔ̃ Yehowa,</para>
  <para style="q2" vid="PSA 33:8">eye xexemetɔwo katã nede bubu eŋu.<verse eid="PSA 33:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 33:9"/>Elabena eƒo nu, eye wòva dzɔ;</para>
  <para style="q2" vid="PSA 33:9">eɖe gbe, eye wòli ke goŋgoŋgoŋ.<verse eid="PSA 33:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 33:10"/>Yehowa gblẽ dukɔwo ƒe adaŋudedewo me,</para>
  <para style="q2" vid="PSA 33:10">eye wòtɔtɔ anyigbadzitɔwo ƒe ɖoɖowo.<verse eid="PSA 33:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 33:11"/>Ke Yehowa ya ƒe ɖoɖowo nɔa anyi maʋamaʋãe ɖikaa,</para>
  <para style="q2" vid="PSA 33:11">eye eƒe dzimesusuwo li tso dzidzime yi dzidzime.<verse eid="PSA 33:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 33:12"/>Woayra dukɔ si ƒe Mawue nye Yehowa,</para>
  <para style="q2" vid="PSA 33:12">ame siwo wòtia be woanyi yeƒe dome.<verse eid="PSA 33:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 33:13"/>Yehowa bi kɔ tso dziƒo ke,</para>
  <para style="q2" vid="PSA 33:13">eye wòkpɔ amegbetɔviwo katã.<verse eid="PSA 33:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 33:14"/>Ele eƒe nɔƒe ke hekpɔ</para>
  <para style="q2" vid="PSA 33:14">ame siwo katã le anyigba dzi,<verse eid="PSA 33:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 33:15"/>eya ame si wɔ ame sia ame ƒe dzi,</para>
  <para style="q2" vid="PSA 33:15">eye wòléa ŋku ɖe nu sia nu si wowɔna la ŋu.<verse eid="PSA 33:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 33:16"/>Aʋakɔ gbogbo si le fia aɖe si la mate ŋu aɖee o,</para>
  <para style="q2" vid="PSA 33:16">eye ŋusẽ triakɔ hã meɖea kalẽtɔ o.<verse eid="PSA 33:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 33:17"/>Ne eɖo ɖeɖe dzi la,</para>
  <para style="q2" vid="PSA 33:17">sɔ maɖe ame si tsɔ eƒe mɔkpɔkpɔ da ɖe edzi o,</para>
  <para style="q1" vid="PSA 33:17">togbɔ be ŋusẽ triakɔ le esi hã la,</para>
  <para style="q2" vid="PSA 33:17">mate ŋu aɖee o.<verse eid="PSA 33:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 33:18"/>Ke Yehowa ƒe ŋku le ame siwo vɔ̃nɛ la ŋu,</para>
  <para style="q2" vid="PSA 33:18">ame siwo tsɔa woƒe mɔkpɔkpɔ dana ɖe</para>
  <para style="q2" vid="PSA 33:18">eƒe lɔlɔ̃ si meʋãna o la dzi,<verse eid="PSA 33:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 33:19"/>be wòaɖe wo tso ku ƒe asi me,</para>
  <para style="q2" vid="PSA 33:19">eye wòana woatsi agbe le dɔŋɔli.<verse eid="PSA 33:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 33:20"/>Míele lalam le mɔ kpɔm na Yehowa,</para>
  <para style="q2" vid="PSA 33:20">eyae nye míaƒe xɔname kple akpoxɔnu.<verse eid="PSA 33:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 33:21"/>Míaƒe dziwo le dzidzɔ kpɔm le eya amea me,</para>
  <para style="q2" vid="PSA 33:21">elabena mieka ɖe eƒe ŋkɔ kɔkɔe la dzi.<verse eid="PSA 33:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 33:22"/>O! Yehowa, na wò lɔlɔ̃ si meʋãna o la,</para>
  <para style="q2" vid="PSA 33:22">nanɔ mía dzi abe ale si míetsɔ míaƒe</para>
  <para style="q2" vid="PSA 33:22">mɔkpɔkpɔ da ɖe dziwò ene.<verse eid="PSA 33:22"/></para>
  <chapter eid="PSA 33"/>
  <chapter number="34" style="c" sid="PSA 34"/>
  <para style="cl">Psalmo 34</para>
  <para style="d">David ƒe ha. Ekpa ha sia esime wòdo aɖaʋatɔ eɖokui le Abimelek ŋkume, eye wònyae wòdzo.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 34:1"/>Mado Yehowa ɖe dzi ɣe sia ɣi;</para>
  <para style="q2" vid="PSA 34:1">eye eƒe kafukafu anɔ nye nu me ɖaa.<verse eid="PSA 34:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 34:2"/>Nye luʋɔ aƒo adegbe le Yehowa me,</para>
  <para style="q2" vid="PSA 34:2">ame siwo le veve sem la nesee ne woakpɔ dzidzɔ.<verse eid="PSA 34:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 34:3"/>Mido kɔkɔ Yehowa kplim;</para>
  <para style="q2" vid="PSA 34:3">mina míawɔ ɖeka ado eƒe ŋkɔ ɖe dzi.<verse eid="PSA 34:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 34:4"/>Meyɔ Yehowa, eye wòtɔ nam heɖem tso nye vɔvɔ̃wo katã me.<verse eid="PSA 34:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 34:5"/>Ame siwo tsɔ woƒe ŋku da ɖe edzi la aklẽ,</para>
  <para style="q2" vid="PSA 34:5">ŋukpe matsyɔ mo na wo o.<verse eid="PSA 34:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 34:6"/>Hiãtɔ sia yɔe, eye Yehowa ɖo toe,</para>
  <para style="q2" vid="PSA 34:6">heɖee le eƒe xaxawo katã me.<verse eid="PSA 34:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 34:7"/>Yehowa ƒe dɔlawo ƒua asaɖa anyi ƒoa xlã</para>
  <para style="q2" vid="PSA 34:7">ame siwo vɔ̃nɛ, eye wòɖea wo.<verse eid="PSA 34:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 34:8"/>Miɖɔe kpɔ, ne miakpɔe be Yehowa ƒe dɔ me nyo;</para>
  <para style="q2" vid="PSA 34:8">woayra ŋutsu si be ɖe eya amea me.<verse eid="PSA 34:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 34:9"/>Mivɔ̃ Yehowa, mi eƒe ame kɔkɔewo,</para>
  <para style="q2" vid="PSA 34:9">elabena naneke mehiãa ame siwo vɔ̃nɛ la o.<verse eid="PSA 34:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 34:10"/>Dɔ awu dzatawo, eye woagbɔdzɔ,</para>
  <para style="q2" vid="PSA 34:10">gake ame siwo dia Yehowa ya la, kesinɔnu aɖeke mahiã wo o.<verse eid="PSA 34:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 34:11"/>Miva, vinyewo, miɖo tom,</para>
  <para style="q2" vid="PSA 34:11">ne mafia Yehowavɔvɔ̃ mi.<verse eid="PSA 34:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 34:12"/>Mia dometɔ siwo lɔ̃ agbe,</para>
  <para style="q2" vid="PSA 34:12">eye miedi be miakpɔ ŋkekenyui geɖewo la,<verse eid="PSA 34:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 34:13"/>mikpɔ miaƒe aɖewo dzi nyuie tso vɔ̃ ŋuti,</para>
  <para style="q2" vid="PSA 34:13">eye miaƒe nuyiwo tso aʋatsokaka ŋuti.<verse eid="PSA 34:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 34:14"/>Mite ɖa le vɔ̃ gbɔ, eye miawɔ nu nyui,</para>
  <para style="q2" vid="PSA 34:14">midi ŋutifafa, eye miati eyome.<verse eid="PSA 34:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 34:15"/>Yehowa ƒe ŋku le ame dzɔdzɔewo ŋu,</para>
  <para style="q2" vid="PSA 34:15">eye eƒe towo le woƒe ɣlidodo ŋu;<verse eid="PSA 34:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 34:16"/>ke Yehowa klẽa ŋku ɖe nu vɔ̃ɖi wɔlawo be wòaɖe wo ɖa</para>
  <para style="q2" vid="PSA 34:16">le anyigba dzi, eye womagaɖo ŋku wo dzi akpɔ o.<verse eid="PSA 34:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 34:17"/>Ame dzɔdzɔewo do ɣli,</para>
  <para style="q2" vid="PSA 34:17">Yehowa see, eye wòɖe wo le woƒe xaxawo katã me.<verse eid="PSA 34:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 34:18"/>Yehowa tsɔ ɖe ame siwo ƒe dzi gbã gudugudu la gbɔ,</para>
  <para style="q2" vid="PSA 34:18">eye wòɖea ame siwo ƒe gbɔgbɔ wogbã ƒu anyi.<verse eid="PSA 34:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 34:19"/>Ame dzɔdzɔe ƒe fukpekpewo sɔ gbɔ ŋutɔ,</para>
  <para style="q2" vid="PSA 34:19">gake Yehowa ɖenɛ le wo katã me;<verse eid="PSA 34:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 34:20"/>ekpɔa eƒe ƒuwo katã ta,</para>
  <para style="q2" vid="PSA 34:20">eye womaŋe wo dometɔ aɖeke o.<verse eid="PSA 34:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 34:21"/>Dzɔgbevɔ̃e awu ame vɔ̃ɖi,</para>
  <para style="q2" vid="PSA 34:21">eye woabu fɔ ame dzɔdzɔewo ƒe futɔwo.<verse eid="PSA 34:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 34:22"/>Yehowa ɖea eƒe dɔlawo,</para>
  <para style="q2" vid="PSA 34:22">eye womabu fɔ ame siwo katã sinɛ tsona la o.<verse eid="PSA 34:22"/></para>
  <chapter eid="PSA 34"/>
  <chapter number="35" style="c" sid="PSA 35"/>
  <para style="cl">Psalmo 35</para>
  <para style="d">David ƒe ha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 35:1"/>O! Yehowa, wɔ avu kple ame siwo le avu wɔm kplim;</para>
  <para style="q2" vid="PSA 35:1">wɔ aʋa kple ame siwo le aʋa wɔm kplim.<verse eid="PSA 35:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 35:2"/>Tso, tsɔ akpoxɔnu kple wò akɔtatsyɔnu, eye nàxɔ nam.<verse eid="PSA 35:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 35:3"/>Tsɔ akplɔ nueveetɔ kple nuɖekɛtɔ ɖe yonyemetilawo ŋuti.</para>
  <para style="q2" vid="PSA 35:3">Gblɔ na nye luʋɔ be,</para>
  <para style="q2" vid="PSA 35:3">“Nyee nye wò xɔname.”<verse eid="PSA 35:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 35:4"/>Ame siwo le nye agbe yome tim la,</para>
  <para style="q2" vid="PSA 35:4">ŋukpe kple vlododo nelé wo,</para>
  <para style="q1" vid="PSA 35:4">eye ame siwo le nugbe ɖom ɖe nye gbegblẽ ŋu la,</para>
  <para style="q2" vid="PSA 35:4">gbegblẽ netrɔ va woawo ŋutɔ dzi.<verse eid="PSA 35:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 35:5"/>Wonenɔ abe bli ƒe atsa si ya lɔ ɖe nu ene,</para>
  <para style="q2" vid="PSA 35:5">eye Yehowa ƒe dɔla nenya wo ɖe du nu;<verse eid="PSA 35:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 35:6"/>woƒe mɔ dzi nedo viviti, ahanɔ ɖiɖim,</para>
  <para style="q2" vid="PSA 35:6">eye Yehowa ƒe dɔla neti wo yome.<verse eid="PSA 35:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 35:7"/>Esi nyemewɔ naneke wo o,</para>
  <para style="q2" vid="PSA 35:7">gake woɖo ɖɔ ɖi nam, eye woɖe ʋe ɖi nam ta la,<verse eid="PSA 35:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 35:8"/>gbegblẽ neƒo ɖe wo dzi kpoyi,</para>
  <para style="q2" vid="PSA 35:8">ɖɔ si woɖo nam la neɖe woawo ŋutɔ,</para>
  <para style="q2" vid="PSA 35:8">eye woage dze ʋe si woɖe ɖi nam la me aƒaƒã ɖe afi ma.<verse eid="PSA 35:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 35:9"/>Ekema nye luʋɔ atso aseye le Yehowa me,</para>
  <para style="q2" vid="PSA 35:9">eye wòadzɔ dzi le eƒe xɔname ŋuti.<verse eid="PSA 35:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 35:10"/>Nye ameti blibo la katã mado ɣli be,</para>
  <para style="q2" vid="PSA 35:10">“O! Yehowa, ame kae sɔ kpli wò?</para>
  <para style="q1" vid="PSA 35:10">Wò ame si ɖe ame beliwo tso</para>
  <para style="q2" vid="PSA 35:10">ame siwo sesẽ wu wo la ƒe asi me,</para>
  <para style="q1" vid="PSA 35:10">eye nèɖe hiãtɔwo kple ame dahewo tso</para>
  <para style="q2" vid="PSA 35:10">ame siwo ha wo la ƒe asi me.”<verse eid="PSA 35:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 35:11"/>Ɖasefo ŋutasẽlawo zɔ va ŋgɔgbe,</para>
  <para style="q2" vid="PSA 35:11">eye wobia biabiam tso nu</para>
  <para style="q2" vid="PSA 35:11">siwo ŋuti nyemenya naneke le o.<verse eid="PSA 35:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 35:12"/>Wotsɔ vɔ̃ ɖo nyui teƒe nam,</para>
  <para style="q2" vid="PSA 35:12">eye wogble nye luʋɔ ɖe nuxaxa me.<verse eid="PSA 35:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 35:13"/>Gake ne wodze dɔ la,</para>
  <para style="q2" vid="PSA 35:13">metaa akpanya, eye metsɔa nutsitsidɔ bɔbɔa ɖokuinyee.</para>
  <para style="q2" vid="PSA 35:13">Ne womeɖo nye gbedodoɖa ŋuti nam o la,<verse eid="PSA 35:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 35:14"/>menɔa yiyim kpokpokpo le nuxaxa me abe xɔ̃nye</para>
  <para style="q2" vid="PSA 35:14">alo nɔviŋutsu fam mele ene.</para>
  <para style="q1" vid="PSA 35:14">Medea mo to abe danye ƒe ku fam mele ene.<verse eid="PSA 35:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 35:15"/>Gake ne mekli nu la,</para>
  <para style="q2" vid="PSA 35:15">woƒoa ƒu koa nu hahaha,</para>
  <para style="q2" vid="PSA 35:15">eye ne mele vo me la, futɔwo va ɖea to ɖem.</para>
  <para style="q2" vid="PSA 35:15">Woɖea alɔme le ŋunye madzudzɔmadzudzɔe.<verse eid="PSA 35:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 35:16"/>Woɖua fewu le ŋunye vevesesetɔe,</para>
  <para style="q2" vid="PSA 35:16">eye woɖua aɖukli ɖe ŋunye abe mawumavɔ̃lawo ene.<verse eid="PSA 35:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 35:17"/>O! Aƒetɔ, va se ɖe ɣe ka ɣi nànɔ te akpɔ wo ase ɖo?</para>
  <para style="q2" vid="PSA 35:17">Ɖe nye agbe tso woƒe nu gbegblẽwo me,</para>
  <para style="q2" vid="PSA 35:17">ɖe nye agbe xɔasi tso dzata siawo ƒe asi me.<verse eid="PSA 35:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 35:18"/>Ekema mada akpe na wò le ameha gã la dome,</para>
  <para style="q2" vid="PSA 35:18">eye makafu wò le ame gbogbowo dome.<verse eid="PSA 35:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 35:19"/>Mègana ame siwo nye nye futɔwo la nakpɔ dziɖuɖu</para>
  <para style="q2" vid="PSA 35:19">ƒe dzidzɔ ɖe ŋunye yakatɔe o,</para>
  <para style="q1" vid="PSA 35:19">eye mègana ame siwo lé fum susumanɔmetɔe la</para>
  <para style="q2" vid="PSA 35:19">nate ŋku ɖem kple vevesese o.<verse eid="PSA 35:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 35:20"/>Womeƒoa nu ŋutifafatɔe o,</para>
  <para style="q2" vid="PSA 35:20">ke boŋ woɖoa alakpa ƒe amenutsonyawo ɖi ɖe</para>
  <para style="q2" vid="PSA 35:20">ame siwo le anyigba dzi kpoo la ŋuti.<verse eid="PSA 35:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 35:21"/>Wokea woƒe nu baa ɖe ŋutinye hegblɔna be,</para>
  <para style="q2" vid="PSA 35:21">“Ɛhɛ̃! Ɛhɛ̃! Míawo ŋutɔ míekpɔe kple míaƒe ŋkuwo.”<verse eid="PSA 35:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 35:22"/>O! Yehowa, èkpɔ esia, eya ta mègazi ɖoɖoe o.</para>
  <para style="q2" vid="PSA 35:22">O! Aƒetɔ, mèganɔ adzɔge nam o.<verse eid="PSA 35:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 35:23"/>Nyɔ, tso nàʋli tanye!</para>
  <para style="q2" vid="PSA 35:23">Wɔ avu ɖe nunye,</para>
  <para style="q2" vid="PSA 35:23">nye Mawu kple nye Aƒetɔ.<verse eid="PSA 35:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 35:24"/>Tso afia nam le wò dzɔdzɔenyenye la ta,</para>
  <para style="q2" vid="PSA 35:24">O! Yehowa, nye Mawu,</para>
  <para style="q2" vid="PSA 35:24">mègana woakpɔ dziɖuɖu ƒe dzidzɔ ɖe ŋutinye o.<verse eid="PSA 35:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 35:25"/>Mègana woabu be,</para>
  <para style="q2" vid="PSA 35:25">“Ɛhɛ̃, esia tututu dim míele” o.</para>
  <para style="q2" vid="PSA 35:25">Alo agblɔ be, “Míemii agbagbee” o.<verse eid="PSA 35:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 35:26"/>Ame siwo katã le dzidzɔ kpɔm tso nye xaxa ŋuti la,</para>
  <para style="q2" vid="PSA 35:26">ŋukpe nelé wo, eye woatɔtɔ;</para>
  <para style="q2" vid="PSA 35:26">na be ame siwo kɔ wo ɖokuiwo dzi ɖe ŋutinye la</para>
  <para style="q2" vid="PSA 35:26">nata ŋukpe kple vlododo abe avɔ ene.<verse eid="PSA 35:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 35:27"/>Ke ame siwo dzɔ dzi be nètso afia nam la</para>
  <para style="q2" vid="PSA 35:27">nedo dzidzɔɣli kple aseyetsoɣli.</para>
  <para style="q2" vid="PSA 35:27">Wonenɔ gbɔgblɔm ɖaa be,</para>
  <para style="q1" vid="PSA 35:27">“Woado Yehowa, ame si dzɔa dzi le eƒe dɔla</para>
  <para style="q2" vid="PSA 35:27">ƒe dedinɔnɔ ŋu la ɖe dzi.”<verse eid="PSA 35:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 35:28"/>Nye aɖe aƒo nu le wò dzɔdzɔenyenye ŋuti,</para>
  <para style="q2" vid="PSA 35:28">eye wòadzi wò kafukafuha ɖaa.<verse eid="PSA 35:28"/></para>
  <chapter eid="PSA 35"/>
  <chapter number="36" style="c" sid="PSA 36"/>
  <para style="cl">Psalmo 36</para>
  <para style="d">David, Yehowa ƒe dɔla, ƒe ha na hɛnɔ la.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 36:1"/>Yehowa ƒe gbedeasi aɖe le nye dzi me tso</para>
  <para style="q2" vid="PSA 36:1">ame vɔ̃ɖi ƒe nu vɔ̃ wɔwɔ ŋuti.</para>
  <para style="q2" vid="PSA 36:1">Mawuvɔvɔ̃ aɖeke mele woƒe ŋkuwo me o.<verse eid="PSA 36:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 36:2"/>Elabena le eya ŋutɔ ŋkume,</para>
  <para style="q2" vid="PSA 36:2">wòvivi nu me na eɖokui ale gbegbe be</para>
  <para style="q1" vid="PSA 36:2">mete ŋu kpɔ eƒe nu vɔ̃ dze sii</para>
  <para style="q2" vid="PSA 36:2">alo wòagbe nu le egbɔ o.<verse eid="PSA 36:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 36:3"/>Eƒe numenyawo vɔ̃ɖi,</para>
  <para style="q2" vid="PSA 36:3">henye beble sɔŋ, eye wòdzudzɔ nuwɔwɔ ɖe nunya me</para>
  <para style="q2" vid="PSA 36:3">kple nu nyui wɔwɔ.<verse eid="PSA 36:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 36:4"/>Eɖoa nu vɔ̃ɖi le eƒe aba dzi,</para>
  <para style="q2" vid="PSA 36:4">etsɔa eɖokui dea asi na nu si nye vɔ̃,</para>
  <para style="q2" vid="PSA 36:4">eye megbea nu si nye nu gbegblẽ o.<verse eid="PSA 36:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 36:5"/>O! Yehowa, wò lɔlɔ̃ kɔ ɖatɔ dziƒowo ke,</para>
  <para style="q2" vid="PSA 36:5">eye wò nuteƒewɔwɔ tɔ dziŋgɔli ke.<verse eid="PSA 36:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 36:6"/>Wò dzɔdzɔenyenye le abe to gãwo ene,</para>
  <para style="q2" vid="PSA 36:6">eye wò afiatsotso le abe tɔ goglo ene.</para>
  <para style="q2" vid="PSA 36:6">O! Yehowa, èkpɔa amegbetɔwo kple lãwo siaa ta.<verse eid="PSA 36:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 36:7"/>Wò lɔlɔ̃ si meʋãna o la xɔ asi loo!</para>
  <para style="q2" vid="PSA 36:7">Ame siwo ŋuti bubu le</para>
  <para style="q2" vid="PSA 36:7">kple ame siwo ŋuti mele o,</para>
  <para style="q1" vid="PSA 36:7">le amegbetɔviwo dome siaa kpɔa sitsoƒe</para>
  <para style="q2" vid="PSA 36:7">le wò aʋala ƒe vɔvɔli te.<verse eid="PSA 36:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 36:8"/>Wò aƒemenu gbogboawo nye nuɖuɖu na wo,</para>
  <para style="q2" vid="PSA 36:8">eye nènaa tsi wo wonona tso wò dzidzɔtɔsisi la me.<verse eid="PSA 36:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 36:9"/>Elabena gbɔwòe agbe ƒe tsitsetse la le,</para>
  <para style="q2" vid="PSA 36:9">eye wò kekeli mee míekpɔa kekeli le.<verse eid="PSA 36:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 36:10"/>Yi edzi nàɖe wò lɔlɔ̃ afia ame siwo nya wò,</para>
  <para style="q2" vid="PSA 36:10">eye nàɖe wò dzɔdzɔenyenye afia</para>
  <para style="q2" vid="PSA 36:10">ame siwo ƒe dzi to mɔ ɖeka.<verse eid="PSA 36:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 36:11"/>Dadalawo megaɖo afɔ dzinye,</para>
  <para style="q2" vid="PSA 36:11">alo ame vɔ̃ɖiwo ƒe asi nanyam o.<verse eid="PSA 36:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 36:12"/>Kpɔ ale si nu vɔ̃ɖi wɔlawo dze anyi ɖe anyigbae ɖa;</para>
  <para style="q2" vid="PSA 36:12">wotutu wo ƒu anyi, eye womete ŋu fɔ o!<verse eid="PSA 36:12"/></para>
  <chapter eid="PSA 36"/>
  <chapter number="37" style="c" sid="PSA 37"/>
  <para style="cl">Psalmo 37</para>
  <para style="d">David ƒe ha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 37:1"/>Mègadzo nyanyanya le ame vɔ̃ɖiwo ta,</para>
  <para style="q2" vid="PSA 37:1">alo aʋã ŋu nu tovo wɔlawo o<verse eid="PSA 37:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 37:2"/>elabena esusɔ vie woayrɔ abe gbe ene,</para>
  <para style="q2" vid="PSA 37:2">eye abe gbe mumu ene la, woaku wo atsɔ aƒu gbe.<verse eid="PSA 37:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 37:3"/>Ɖo dzi ɖe Yehowa ŋu, eye nàwɔ nyui;</para>
  <para style="q2" vid="PSA 37:3">nɔ anyigba la dzi, eye nàɖu eƒe nu nyuiwo le dziɖeɖi me.<verse eid="PSA 37:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 37:4"/>Yehowa ƒe nu nenyo ŋuwò ekema ana nu</para>
  <para style="q2" vid="PSA 37:4">siwo wò dzi di la wò.<verse eid="PSA 37:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 37:5"/>Tsɔ wò mɔwo gblẽ ɖe Yehowa ƒe asi me;</para>
  <para style="q2" vid="PSA 37:5">ɖo dzi ɖe eŋu, eye awɔ esia na wò.<verse eid="PSA 37:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 37:6"/>Ana wò dzɔdzɔenyenye nàdze abe ŋdikekeli ene,</para>
  <para style="q2" vid="PSA 37:6">eye wò dzɔdzɔenyenye ƒe mɔ abe ŋdɔkutsuɣe ene.<verse eid="PSA 37:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 37:7"/>Zi kpoo le Yehowa ŋkume,</para>
  <para style="q2" vid="PSA 37:7">eye nànɔ eƒe asinu kpɔm le dzigbɔɖi me.</para>
  <para style="q1" vid="PSA 37:7">Ne amewo ƒe mɔwo dze edzi na wo,</para>
  <para style="q2" vid="PSA 37:7">eye wote ŋu wɔ nu vɔ̃ɖi siwo woɖo la,</para>
  <para style="q2" vid="PSA 37:7">mègavɔ̃ nàdzo nyanyanya o.<verse eid="PSA 37:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 37:8"/>Ɖe asi le dziku ŋu, eye nàtrɔ megbe de wò dɔmedzoe,</para>
  <para style="q2" vid="PSA 37:8">ŋɔ megadzi wò o,</para>
  <para style="q2" vid="PSA 37:8">elabena nu vɔ̃ɖi me ko wòakplɔ wò ayii.<verse eid="PSA 37:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 37:9"/>Woatsrɔ̃ ame vlowo</para>
  <para style="q2" vid="PSA 37:9">gake ame siwo tsɔ woƒe mɔkpɔkpɔ de</para>
  <para style="q2" vid="PSA 37:9">Yehowa me la, anyi anyigba la ƒe dome.<verse eid="PSA 37:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 37:10"/>Esusɔ vie ko ame vɔ̃ɖi la maganɔ anyi o,</para>
  <para style="q2" vid="PSA 37:10">togbɔ be àdi wo hã la, màkpɔ wo o.<verse eid="PSA 37:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 37:11"/>Ke ame fafawo anyi anyigba la ƒe dome,</para>
  <para style="q2" vid="PSA 37:11">eye dzi adzɔ wo le ŋutifafa gbogbo la ta.<verse eid="PSA 37:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 37:12"/>Ame vɔ̃ɖiwo ɖo nugbe ɖe</para>
  <para style="q2" vid="PSA 37:12">ame dzɔdzɔewo ŋu heɖu aɖukli ɖe wo ŋuti.<verse eid="PSA 37:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 37:13"/>Ke Aƒetɔ la le ame vɔ̃ɖiwo kom,</para>
  <para style="q2" vid="PSA 37:13">elabena enya be woƒe ŋkeke la gbɔna.<verse eid="PSA 37:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 37:14"/>Ame vɔ̃ɖiwo ɖe woƒe yi,</para>
  <para style="q2" vid="PSA 37:14">eye wohe woƒe dati me be woada hiãtɔ</para>
  <para style="q1" vid="PSA 37:14">kple ame dahe aƒu anyi,</para>
  <para style="q2" vid="PSA 37:14">eye woawu ame siwo ƒe zɔzɔme to mɔ ɖeka.<verse eid="PSA 37:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 37:15"/>Gake woƒe yiwo aŋɔ woawo ŋutɔ ƒe dziwo,</para>
  <para style="q2" vid="PSA 37:15">eye woƒe datiwo aŋe.<verse eid="PSA 37:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 37:16"/>Nu ʋɛ si le ame dzɔdzɔewo si la nyo wu</para>
  <para style="q2" vid="PSA 37:16">kesinɔnu gbogbo siwo le ame vɔ̃ɖiwo si,<verse eid="PSA 37:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 37:17"/>elabena woaŋe ame vɔ̃ɖiwo ƒe ŋusẽ,</para>
  <para style="q2" vid="PSA 37:17">ke Yehowa alé ame dzɔdzɔewo ɖe te.<verse eid="PSA 37:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 37:18"/>Ame siwo ŋuti fɔɖiɖi mele o la</para>
  <para style="q2" vid="PSA 37:18">ƒe ŋkekewo le nyanya na Yehowa,</para>
  <para style="q2" vid="PSA 37:18">eye woƒe domenyinu anɔ anyi tegbetegbe.<verse eid="PSA 37:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 37:19"/>Le ŋkeke vɔ̃wo dzi la, womalũ xɛ o;</para>
  <para style="q2" vid="PSA 37:19">le dɔŋɔli la, nuɖuɖu ado agbogbo na woawo ya.<verse eid="PSA 37:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 37:20"/>Ke ame vɔ̃ɖi ya atsrɔ̃.</para>
  <para style="q2" vid="PSA 37:20">Yehowa ƒe futɔwo anɔ abe gbe ƒe seƒoƒo ene,</para>
  <para style="q1" vid="PSA 37:20">woanya kpɔ nyuie, gake wo nu ava yi,</para>
  <para style="q2" vid="PSA 37:20">woabu abe dzudzɔ ene.<verse eid="PSA 37:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 37:21"/>Ame vɔ̃ɖi doa nugbana, eye mexea fea o,</para>
  <para style="q2" vid="PSA 37:21">ke ame dzɔdzɔe ya naa nu faa.<verse eid="PSA 37:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 37:22"/>Ame siwo Yehowa yra la anyi anyigba la ƒe dome,</para>
  <para style="q2" vid="PSA 37:22">ke ame siwo wòƒo fi de la, woaɖe wo ɖa.<verse eid="PSA 37:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 37:23"/>Ŋutsu si ƒe mɔwo dze Yehowa ŋu la,</para>
  <para style="q2" vid="PSA 37:23">elia ke eƒe afɔɖeɖewo;<verse eid="PSA 37:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 37:24"/>ne ekli nu hã la, madze anyi o</para>
  <para style="q2" vid="PSA 37:24">elabena Yehowa tsɔ eƒe asi lée ɖe te.<verse eid="PSA 37:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 37:25"/>Tsã la, menye ɖevi, ke azɔ la metsi,</para>
  <para style="q2" vid="PSA 37:25">gake womegble ame dzɔdzɔe aɖeke ɖi mekpɔ kpɔ loo,</para>
  <para style="q2" vid="PSA 37:25">alo wo viwo nabia abolo hafi aɖu o.<verse eid="PSA 37:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 37:26"/>Woawo boŋ vea ame nu ɣe sia ɣi,</para>
  <para style="q2" vid="PSA 37:26">eye wodoa nugbana na amewo faa;</para>
  <para style="q2" vid="PSA 37:26">eya ta wo viwo axɔ yayra.<verse eid="PSA 37:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 37:27"/>Tsri nu vɔ̃ɖi, eye nàwɔ nyui</para>
  <para style="q2" vid="PSA 37:27">ekema ànɔ anyigba dzi tegbetegbe.<verse eid="PSA 37:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 37:28"/>Elabena Yehowa lɔ̃a nu dzɔdzɔe wɔlawo,</para>
  <para style="q2" vid="PSA 37:28">eye magblẽ eƒe nuteƒewɔlawo ɖi o.</para>
  <para style="b" vid="PSA 37:28"/>
  <para style="q1" vid="PSA 37:28">Akpɔ wo ta tegbee,</para>
  <para style="q2" vid="PSA 37:28">ke ame vɔ̃ɖi ƒe dzidzimeviwo ya woatsrɔ̃ wo.<verse eid="PSA 37:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 37:29"/>Ame dzɔdzɔe anyi anyigba la ƒe dome,</para>
  <para style="q2" vid="PSA 37:29">eye wòanɔ edzi tegbee.<verse eid="PSA 37:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 37:30"/>Nunyanya doa go tso ame dzɔdzɔe ƒe nu me,</para>
  <para style="q2" vid="PSA 37:30">eye eƒe aɖe gblɔa nu si le eteƒe.<verse eid="PSA 37:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 37:31"/>Eƒe Mawu ƒe se le eƒe dzi me,</para>
  <para style="q2" vid="PSA 37:31">eya ta eƒe afɔ meɖiɖina o.<verse eid="PSA 37:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 37:32"/>Ame vɔ̃ɖiwo de xa ɖi na ame dzɔdzɔewo,</para>
  <para style="q2" vid="PSA 37:32">eye wole woƒe ku dim;<verse eid="PSA 37:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 37:33"/>gake Yehowa matsɔ wo agblẽ ɖe woƒe ŋusẽ te,</para>
  <para style="q2" vid="PSA 37:33">alo wòaɖe mɔ be, woabu fɔ wo ne wokplɔ wo va ʋɔnui o.<verse eid="PSA 37:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 37:34"/>Lala nàkpɔ Yehowa ƒe asinu,</para>
  <para style="q2" vid="PSA 37:34">eye nàlé eƒe mɔ ɖe asi.</para>
  <para style="q1" vid="PSA 37:34">Ado wò ɖe dzi be nànyi anyigba la ƒe dome.</para>
  <para style="q2" vid="PSA 37:34">Ne woatsrɔ̃ ame vɔ̃ɖiwo la, àkpɔ eteƒe.<verse eid="PSA 37:34"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 37:35"/>Mekpɔ ame vɔ̃ɖi,</para>
  <para style="q2" vid="PSA 37:35">ŋutasẽla aɖe wòda ama nyuie</para>
  <para style="q2" vid="PSA 37:35">abe ati dama si dzɔ kple anyigba la ene.<verse eid="PSA 37:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 37:36"/>Gake eteƒe medidi o ko, enu va yi, eye megali o;</para>
  <para style="q2" vid="PSA 37:36">togbɔ be medii hã la, nyemeke ɖe eŋuti o.<verse eid="PSA 37:36"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 37:37"/>Bu ame maɖifɔ la ŋu,</para>
  <para style="q2" vid="PSA 37:37">eye nàlé ŋku ɖe ame dzɔdzɔewo ŋu,</para>
  <para style="q2" vid="PSA 37:37">elabena ŋgɔgbe li na ŋutifafamewo katã.<verse eid="PSA 37:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 37:38"/>Ke woatsrɔ̃ nu vɔ̃ wɔlawo katã,</para>
  <para style="q2" vid="PSA 37:38">eye woaɖe ame vɔ̃ɖi la ɖa.<verse eid="PSA 37:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 37:39"/>Ame dzɔdzɔewo ƒe xɔxɔ atso Yehowa gbɔ,</para>
  <para style="q2" vid="PSA 37:39">eye eyae nye woƒe mɔ sesẽ le xaxaɣeyiɣiwo me.<verse eid="PSA 37:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 37:40"/>Ke Yehowa kpena ɖe wo ŋu, eye wòɖea wo tso dzɔgbevɔ̃e me;</para>
  <para style="q2" vid="PSA 37:40">eɖea wo tso ame vɔ̃ɖiwo ƒe asi me,</para>
  <para style="q2" vid="PSA 37:40">eye wòkpena ɖe wo ŋu,</para>
  <para style="q2" vid="PSA 37:40">elabena eyae wosi tso.<verse eid="PSA 37:40"/></para>
  <chapter eid="PSA 37"/>
  <chapter number="38" style="c" sid="PSA 38"/>
  <para style="cl">Psalmo 38</para>
  <para style="d">David ƒe ha. Kukuɖeɖe.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 38:1"/>O! Yehowa, mègaka mo nam le wò dziku me,</para>
  <para style="q2" vid="PSA 38:1">alo ahe to nam le wò dɔmedzoe helĩhelĩ me o,<verse eid="PSA 38:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 38:2"/>elabena wò aŋutrɔwo ƒo ɖem,</para>
  <para style="q2" vid="PSA 38:2">eye wò asi sẽ ɖe dzinye.<verse eid="PSA 38:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 38:3"/>Wò dziku helĩhelĩ la wɔe be ŋusẽ aɖeke megale menye o;</para>
  <para style="q2" vid="PSA 38:3">nye ƒuwo tugu le nye nu vɔ̃ ta.<verse eid="PSA 38:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 38:4"/>Nye dzidada kɔ gbɔ tanye abe agba kpekpe si</para>
  <para style="q2" vid="PSA 38:4">nyemate ŋu atsɔ o la ene.<verse eid="PSA 38:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 38:5"/>Nye abiwo ƒaƒã hele ʋeʋẽm</para>
  <para style="q2" vid="PSA 38:5">le nye bometsitsi ƒe nu vɔ̃ ta.<verse eid="PSA 38:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 38:6"/>Wobɔbɔm ɖe anyi, eye woɖi gbɔ̃m,</para>
  <para style="q2" vid="PSA 38:6">eye ŋkeke blibo la, mele yiyim le nuxaxa me.<verse eid="PSA 38:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 38:7"/>Vevesese manyagblɔ aɖe xɔ nye ame blibo la me,</para>
  <para style="q2" vid="PSA 38:7">eye ŋusẽ aɖeke megale nye ameti blibo la ŋu o.<verse eid="PSA 38:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 38:8"/>Megbɔdzɔ, hegba gudugudu,</para>
  <para style="q2" vid="PSA 38:8">eye mele ŋeŋem le nye dzi ƒe vevesese ta.<verse eid="PSA 38:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 38:9"/>O! Aƒetɔ, nye dzimedidiwo katã le ŋkuwò me,</para>
  <para style="q2" vid="PSA 38:9">eye nye hũɖeɖewo meɣla ɖe wò o.<verse eid="PSA 38:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 38:10"/>Nye dzi le tsotsom kpokpokpo,</para>
  <para style="q2" vid="PSA 38:10">ŋusẽ vɔ le ŋunye, eye nyemegate ŋu le nu kpɔm o.<verse eid="PSA 38:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 38:11"/>Le nye abiawo ta,</para>
  <para style="q2" vid="PSA 38:11">xɔ̃nyewo kple nye zɔhɛwo ƒo asa nam,</para>
  <para style="q2" vid="PSA 38:11">eye nye aƒelikawo hã le adzɔge nam.<verse eid="PSA 38:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 38:12"/>Ame siwo le nye agbe yome tim la tre mɔ nam,</para>
  <para style="q2" vid="PSA 38:12">ame siwo di be yewoawɔ nuvevim la</para>
  <para style="q2" vid="PSA 38:12">le nu ƒom tso nye gbegblẽ ŋuti;</para>
  <para style="q2" vid="PSA 38:12">ŋkeke blibo la wole ɖoɖo wɔm ɖe alakpadada ŋu.<verse eid="PSA 38:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 38:13"/>Mele abe tokunɔ si mate ŋu ase nu o la ene,</para>
  <para style="q2" vid="PSA 38:13">eye mele abe aɖetututɔ si mate ŋu aƒo nu o la ene.<verse eid="PSA 38:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 38:14"/>Mele abe ame si mesea nu o la ene</para>
  <para style="q2" vid="PSA 38:14">kple ame si mate ŋu atsɔ eƒe nu aɖo nya aɖeke ŋu o la ene.<verse eid="PSA 38:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 38:15"/>O! Yehowa, mele asiwò nu kpɔm,</para>
  <para style="q2" vid="PSA 38:15">O! Aƒetɔ, nye Mawu, atɔ nam godoo.<verse eid="PSA 38:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 38:16"/>Elabena megblɔ be, “Mègana be woakpɔ dziɖuɖu ƒe dzidzɔ ɖe ŋutinye,</para>
  <para style="q2" vid="PSA 38:16">alo woado wo ɖokui ɖe dzi ɖe ŋutinye ne nye afɔ ɖiɖi o.”<verse eid="PSA 38:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 38:17"/>Esusɔ vie ko madze anyi,</para>
  <para style="q2" vid="PSA 38:17">eye nye vevesese la le edzi ɖaa.<verse eid="PSA 38:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 38:18"/>Meʋu nye dzidada me,</para>
  <para style="q2" vid="PSA 38:18">eye nye nu vɔ̃ ɖe fu nam.<verse eid="PSA 38:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 38:19"/>Ame geɖewoe nye nye futɔ gãwo,</para>
  <para style="q2" vid="PSA 38:19">eye ame siwo lé fum susumanɔmetɔe la sɔ gbɔ ŋutɔ.<verse eid="PSA 38:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 38:20"/>Ame siwo tsɔ vɔ̃ ɖo nyui siwo mewɔ teƒe la</para>
  <para style="q2" vid="PSA 38:20">ƒo ɖi nye ŋkɔ,</para>
  <para style="q2" vid="PSA 38:20">esi meti nu si nyo la yome.<verse eid="PSA 38:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 38:21"/>O! Yehowa, mègagblẽm ɖi o,</para>
  <para style="q2" vid="PSA 38:21">O! Nye Mawu, mèganɔ adzɔge nam o.<verse eid="PSA 38:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 38:22"/>Va kaba, nàɖem,</para>
  <para style="q2" vid="PSA 38:22">O! Aƒetɔ, nye Ɖela.<verse eid="PSA 38:22"/></para>
  <chapter eid="PSA 38"/>
  <chapter number="39" style="c" sid="PSA 39"/>
  <para style="cl">Psalmo 39</para>
  <para style="d">David ƒe ha na hɛnɔ Yedutun.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 39:1"/>Megblɔ be, “Malé ŋku ɖe nye mɔwo ŋu,</para>
  <para style="q2" vid="PSA 39:1">akpɔ nye aɖe dzi be mawɔ nu vɔ̃ o,</para>
  <para style="q1" vid="PSA 39:1">eye zi ale si ame vɔ̃ɖi la gale ŋkunye me la,</para>
  <para style="q2" vid="PSA 39:1">made ga nye nu.”<verse eid="PSA 39:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 39:2"/>Gake esi mezi ɖoɖoe li kpoo,</para>
  <para style="q2" vid="PSA 39:2">eye nyemele nya nyui aɖeke gblɔm o hã la,</para>
  <para style="q2" vid="PSA 39:2">nye vevesese do ga ɖe edzi.<verse eid="PSA 39:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 39:3"/>Nye dzi xɔ dzo ɖe dɔ me nam;</para>
  <para style="q2" vid="PSA 39:3">esi mele ŋugble dem la, exɔ dzo ɖe edzi;</para>
  <para style="q2" vid="PSA 39:3">tete meƒo nu kple nye aɖe.<verse eid="PSA 39:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 39:4"/>“O! Yehowa, fia nye agbe ƒe nuwuwu</para>
  <para style="q2" vid="PSA 39:4">kple ŋkeke ale si manɔ agbee lam;</para>
  <para style="q2" vid="PSA 39:4">eye na manya ale si nye agbe le du dzii.<verse eid="PSA 39:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 39:5"/>Èwɔ nye ŋkekewo wole abe asi ƒe kekeme ko ene,</para>
  <para style="q2" vid="PSA 39:5">eye nye agbenɔɣi menye naneke le ŋkuwò me o.</para>
  <para style="q2" vid="PSA 39:5">Amegbetɔ ɖe sia ɖe ƒe agbe le abe ƒuƒu ko ene. <char style="qs">Sela</char><verse eid="PSA 39:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 39:6"/>“Amegbetɔ le yiyim, le gbɔgbɔm,</para>
  <para style="q2" vid="PSA 39:6">ke vɔvɔli ko wònye.</para>
  <para style="q1" vid="PSA 39:6">Ele agbagba dzem, gake wo katã nye nu dzodzro</para>
  <para style="q2" vid="PSA 39:6">Eli kɔ kesinɔnuwo gleglegle,</para>
  <para style="q2" vid="PSA 39:6">gake menya ame si ƒe asi me woayi ɖo o.<verse eid="PSA 39:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 39:7"/>“Aƒetɔ, ke azɔ la, nu ka makpɔ mɔ na?</para>
  <para style="q2" vid="PSA 39:7">Nye mɔkpɔkpɔ le mewò.<verse eid="PSA 39:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 39:8"/>Ɖem tso nye vodadawo katã me,</para>
  <para style="q2" vid="PSA 39:8">eye mègawɔm mazu alɔmeɖenu na yakamewo o.<verse eid="PSA 39:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 39:9"/>Mezi ɖoɖoe, nyemake nu o,</para>
  <para style="q2" vid="PSA 39:9">elabena wòe wɔ esia.<verse eid="PSA 39:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 39:10"/>Ɖe wò tohehe si le dzinye la ɖa;</para>
  <para style="q2" vid="PSA 39:10">wò asi va dzinye kple ŋusẽ ale metsi anyigba.<verse eid="PSA 39:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 39:11"/>Èkaa mo, eye nèhea to na amewo ɖe woƒe nu vɔ̃wo ta;</para>
  <para style="q2" vid="PSA 39:11">ègblẽa woƒe kesinɔnuwo dome abe agbagblaʋui ene,</para>
  <para style="q2" vid="PSA 39:11">ale amegbetɔ ɖe sia ɖe le abe ƒuƒu ko ene. <char style="qs">Sela.</char><verse eid="PSA 39:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 39:12"/>“O! Yehowa, se nye gbedodoɖa,</para>
  <para style="q2" vid="PSA 39:12">nye ɣlidodo hena kpekpeɖeŋu nede to me na wò;</para>
  <para style="q2" vid="PSA 39:12">mègado toku nye avifafa o.</para>
  <para style="q1" vid="PSA 39:12">Amedzro kple mɔzɔla menye le gbɔwò</para>
  <para style="q2" vid="PSA 39:12">abe ale si fofonyewo katã nɔ ene.<verse eid="PSA 39:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 39:13"/>Ɖe ŋku ɖa le ŋunye, ale be magakpɔ dzidzɔ hafi mayi,</para>
  <para style="q2" vid="PSA 39:13">eye nyemaganɔ anyi o.”<verse eid="PSA 39:13"/></para>
  <chapter eid="PSA 39"/>
  <chapter number="40" style="c" sid="PSA 40"/>
  <para style="cl">Psalmo 40</para>
  <para style="d">David ƒe ha na hɛnɔ la.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 40:1"/>Mele mɔ kpɔm na Yehowa le dzigbɔɖi blibo me;</para>
  <para style="q2" vid="PSA 40:1">etrɔ ɖe ŋutinye, eye wòse nye ɣlidodo.<verse eid="PSA 40:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 40:2"/>Ehem do goe tso ʋe dziŋɔ me,</para>
  <para style="q2" vid="PSA 40:2">eye wòɖem tso ba finyafinya me,</para>
  <para style="q1" vid="PSA 40:2">hetsɔ nye afɔ ɖo agakpe dzi,</para>
  <para style="q2" vid="PSA 40:2">eye wòna meli ke ɖe afi si metɔ ɖo.<verse eid="PSA 40:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 40:3"/>Etsɔ ha yeye de nunye si nye kafukafuha na míaƒe Mawu la.</para>
  <para style="q2" vid="PSA 40:3">Ame geɖewo akpɔe,</para>
  <para style="q2" vid="PSA 40:3">woavɔ̃e, eye woaɖo dzi ɖe Yehowa ŋu.<verse eid="PSA 40:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 40:4"/>Woayra ame si ɖoa dzi ɖe Yehowa ŋu,</para>
  <para style="q2" vid="PSA 40:4">ame si mekpɔa dadalawo ƒe asinu,</para>
  <para style="q2" vid="PSA 40:4">alo kplɔa ame siwo dze alakpalegbawo yome o.<verse eid="PSA 40:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 40:5"/>O! Yehowa, nye Mawu,</para>
  <para style="q2" vid="PSA 40:5">wò nukunu siwo nèwɔ la sɔ gbɔ loo!</para>
  <para style="q1" vid="PSA 40:5">Ɖoɖo geɖe siwo nèwɔ ɖe mía ŋu la,</para>
  <para style="q2" vid="PSA 40:5">ame aɖeke mate ŋu axlẽ wo afia wò o.</para>
  <para style="q1" vid="PSA 40:5">Ne ɖe wòanye be maƒo nu le wo ŋu,</para>
  <para style="q2" vid="PSA 40:5">eye maxlẽ wo afia la, nyemate ŋui o,</para>
  <para style="q2" vid="PSA 40:5">elabena wosɔ gbɔ akpa.<verse eid="PSA 40:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 40:6"/>Mèdi vɔsa kple nunana,</para>
  <para style="q2" vid="PSA 40:6">alo bia numevɔsa kple akpedavɔsa o,</para>
  <para style="q2" vid="PSA 40:6">ke boŋ èʋu nye towo be mase wò gbe,<verse eid="PSA 40:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 40:7"/>eya ta meɖo ŋu be,</para>
  <para style="q2" vid="PSA 40:7">“Nyee nye si meva;</para>
  <para style="q2" vid="PSA 40:7">agbalẽ mee woŋlɔe ɖo tso ŋutinye.<verse eid="PSA 40:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 40:8"/>Medi be mawɔ wò lɔlɔ̃nu,</para>
  <para style="q2" vid="PSA 40:8">O! Nye Mawu, woŋlɔ wò se la ɖe nye dzi me.”<verse eid="PSA 40:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 40:9"/>O! Yehowa, meɖe gbeƒã wò dzɔdzɔenyenye le ameha gã la dome,</para>
  <para style="q2" vid="PSA 40:9">eye abe ale si nènya ene la, nyememia nye nu o.<verse eid="PSA 40:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 40:10"/>Nyemeɣla wò dzɔdzɔenyenye ɖe nye dzi me o,</para>
  <para style="q2" vid="PSA 40:10">ke boŋ meƒo nu le wò nuteƒewɔwɔ kple ɖeɖe ŋuti.</para>
  <para style="q1" vid="PSA 40:10">Nyemeɣla wò lɔlɔ̃</para>
  <para style="q2" vid="PSA 40:10">kple wò nyateƒe la ɖe ameha gã la o.<verse eid="PSA 40:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 40:11"/>O! Yehowa, mègate wo nublanuikpɔkpɔ o,</para>
  <para style="q2" vid="PSA 40:11">ke boŋ na be wò lɔlɔ̃ kple wò nyateƒe nakpɔ tanye ɖaa,<verse eid="PSA 40:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 40:12"/>elabena fukpekpe siwo mele xexlẽ o la ɖe to ɖem,</para>
  <para style="q2" vid="PSA 40:12">nye nu vɔ̃wo wu tsɔtsɔ nam</para>
  <para style="q2" vid="PSA 40:12">eye nyemegate ŋu le nu kpɔm o.</para>
  <para style="q1" vid="PSA 40:12">Wosɔ gbɔ wu nye taɖa,</para>
  <para style="q2" vid="PSA 40:12">eye dzi ɖe le ƒonye.<verse eid="PSA 40:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 40:13"/>O! Yehowa, nedze ŋuwò be nàɖem;</para>
  <para style="q2" vid="PSA 40:13">O! Yehowa, va kaba nàɖem.<verse eid="PSA 40:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 40:14"/>Ŋu nekpe ame siwo katã le nye agbe dim ne woaɖe ɖa la;</para>
  <para style="q2" vid="PSA 40:14">woƒe mo netsi dãa,</para>
  <para style="q1" vid="PSA 40:14">eye ame siwo katã le nye gbegblẽ dim la</para>
  <para style="q2" vid="PSA 40:14">negbugbɔ ɖe megbe kple ŋukpe.<verse eid="PSA 40:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 40:15"/>Ame siwo le gbɔgblɔm ɖe ŋunye be,</para>
  <para style="q2" vid="PSA 40:15">“Ehɛ̃! Ehɛ̃!” la ƒe ŋukpe newɔ moya na wo.<verse eid="PSA 40:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 40:16"/>Ke ame siwo katã dia wò la akpɔ dzidzɔ,</para>
  <para style="q2" vid="PSA 40:16">eye woatso aseye akpɔ dzidzɔ le mewò.</para>
  <para style="q1" vid="PSA 40:16">Ame siwo lɔ̃a wò ɖeɖe la negblɔ ɖaa be,</para>
  <para style="q2" vid="PSA 40:16">“Mido Yehowa ɖe dzi!”<verse eid="PSA 40:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 40:17"/>Ke nye la, meda ahe, eye hiã le tu yem,</para>
  <para style="q2" vid="PSA 40:17">O! Aƒetɔ, ɖo ŋku dzinye. O! Nye Mawu,</para>
  <para style="q1" vid="PSA 40:17">wòe nye nye kpeɖeŋutɔ kple nye xɔname,</para>
  <para style="q2" vid="PSA 40:17">mègahe ɖe megbe o.<verse eid="PSA 40:17"/></para>
  <chapter eid="PSA 40"/>
  <chapter number="41" style="c" sid="PSA 41"/>
  <para style="cl">Psalmo 41</para>
  <para style="d">David ƒe ha na hɛnɔ la.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 41:1"/>Woayra ame si tsɔ ɖe le eme na ame dahewo,</para>
  <para style="q2" vid="PSA 41:1">Yehowa aɖee le xaxaɣi.<verse eid="PSA 41:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 41:2"/>Yehowa adzɔ eŋu, eye wòakpɔ eƒe agbe ta.</para>
  <para style="q2" vid="PSA 41:2">Yehowa ayrae le anyigba dzi,</para>
  <para style="q2" vid="PSA 41:2">eye matsɔe ade asi na eƒe futɔwo ƒe didi o.<verse eid="PSA 41:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 41:3"/>Yehowa anɔ kplii le dɔba dzi, eye wòana lãmesesẽe,</para>
  <para style="q2" vid="PSA 41:3">afɔe tso dɔba dzi.<verse eid="PSA 41:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 41:4"/>Megblɔ be, “O! Yehowa,</para>
  <para style="q2" vid="PSA 41:4">kpɔ nublanui nam, yɔ dɔm,</para>
  <para style="q2" vid="PSA 41:4">elabena mewɔ nu vɔ̃ ɖe ŋuwò.”<verse eid="PSA 41:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 41:5"/>Nye futɔwo le gbɔgblɔm tso ŋunye fewuɖutɔe be,</para>
  <para style="q2" vid="PSA 41:5">“Ɣe ka ɣi gɔ̃e wòle kuku ge ne eƒe ŋkɔ natsrɔ̃?”<verse eid="PSA 41:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 41:6"/>Ne ame aɖe ɖi tsa va be yeakpɔm ɖa la,</para>
  <para style="q2" vid="PSA 41:6">edaa alakpa, eƒe dzi ƒoa ameŋugblẽnyawo nu ƒu,</para>
  <para style="q2" vid="PSA 41:6">eye wòdoa go yina kakanɛ.<verse eid="PSA 41:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 41:7"/>Nye futɔwo katã le dalĩ dom le ŋutinye,</para>
  <para style="q2" vid="PSA 41:7">eye wole nu vɔ̃ɖiwo susum tso ŋutinye le gbɔgblɔm be,<verse eid="PSA 41:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 41:8"/>“Dɔléle vɔ̃ɖi aɖe dze edzi,</para>
  <para style="q2" vid="PSA 41:8">magatso le afi si wòmlɔ la akpɔ gbeɖe o.”<verse eid="PSA 41:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 41:9"/>Xɔ̃nye si tsi metoa nye kplii dome o,</para>
  <para style="q2" vid="PSA 41:9">ame si dzi meka ɖo,</para>
  <para style="q2" vid="PSA 41:9">eye wòɖua nu kplim la kɔ eƒe afɔkpodzi dzi ɖe ŋutinye.<verse eid="PSA 41:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 41:10"/>O! Yehowa, ke wò ya kpɔ nye nublanui,</para>
  <para style="q2" vid="PSA 41:10">kɔm ɖe dzi be maɖo teƒe na wo.<verse eid="PSA 41:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 41:11"/>Menya be èkpɔ ŋudzedze le ŋutinye,</para>
  <para style="q2" vid="PSA 41:11">elabena nye ketɔ meɖu dzinye o.<verse eid="PSA 41:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 41:12"/>Le nye nuteƒewɔwɔ ta la, èlém ɖe asi,</para>
  <para style="q2" vid="PSA 41:12">eye nètsɔm ɖo wò ŋkume tegbetegbe.<verse eid="PSA 41:12"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 41:13"/>Woakafu Yehowa, Israel ƒe Mawu la</para>
  <para style="q2" vid="PSA 41:13">tso mavɔ me yi mavɔ me.</para>
  <para style="qc" vid="PSA 41:13">Neva eme, ɛ̃, neva eme.<verse eid="PSA 41:13"/></para>
  <chapter eid="PSA 41"/>
  <chapter number="42" style="c" sid="PSA 42"/>
  <para style="ms">Agbalẽ evelia</para>
  <para style="mr">
    <ref loc="PSA 42-72">Psalmowo 42–72</ref></para>
  <para style="cl">Psalmo 42</para>
  <para style="d">Korah ƒe viwo ƒe ha na hɛnɔ la.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 42:1"/>Ale si zinɔ ƒe ve me ƒunae ɖe tɔʋuwo ŋu la,</para>
  <para style="q2" vid="PSA 42:1">O! Mawu, nenemae nye luʋɔ le diwòm.<verse eid="PSA 42:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 42:2"/>Tsikɔ le nye luʋɔ wum ɖe Mawu ŋu,</para>
  <para style="q2" vid="PSA 42:2">ɖe Mawu gbagbe la ŋu.</para>
  <para style="q2" vid="PSA 42:2">Ɣe ka ɣi mayi aɖado go Mawu?<verse eid="PSA 42:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 42:3"/>Nye aɖatsiwo zu nuɖuɖu nam zã kple keli,</para>
  <para style="q2" vid="PSA 42:3">evɔ amewo le gbɔgblɔm nam ŋkeke blibo la be,</para>
  <para style="q2" vid="PSA 42:3">“Afi ka wò Mawu la le?”<verse eid="PSA 42:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 42:4"/>Nu siawo dzi meɖo ŋkue esi meyi ɖokuinye me.</para>
  <para style="q2" vid="PSA 42:4">Tsã la, nyee kplɔa amehawo;</para>
  <para style="q2" vid="PSA 42:4">menɔa ŋgɔ kplɔa wo yina ɖe gbedoxɔ me,</para>
  <para style="q1" vid="PSA 42:4">eye dzidzɔɣli kple kafukafuhawo dea dzi</para>
  <para style="q2" vid="PSA 42:4">le ŋkekenyuiɖulawo dome kɔtɔɔ.<verse eid="PSA 42:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 42:5"/>O! Nye luʋɔ, nu ka ŋuti nèle nu xam?</para>
  <para style="q2" vid="PSA 42:5">Nu ka ta nètsi dzodzodzoe le menye ɖo?</para>
  <para style="q1" vid="PSA 42:5">Tsɔ wò mɔkpɔkpɔ da ɖe Mawu dzi,</para>
  <para style="q2" vid="PSA 42:5">elabena magakafui,</para>
  <para style="q1" vid="PSA 42:5">eya ame si nye nye Ɖela</para>
  <para style="q2" vid="PSA 42:5">kple nye Mawu.<verse eid="PSA 42:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 42:6"/>Nye luʋɔ le nu xam le menye,</para>
  <para style="q2" vid="PSA 42:6">eya ta maɖo ŋku dziwò le Yɔdanyigba dzi,</para>
  <para style="q2" vid="PSA 42:6">le Hermon tame ke kple Mizar to dzi.<verse eid="PSA 42:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 42:7"/>Tɔ goglo yɔa tɔ goglo le wò tsitsetsewo ƒe howɔwɔ me;</para>
  <para style="q2" vid="PSA 42:7">wò tsitsotsoewo kple tsi kpakawo ŋe tsyiɔ dzinye.<verse eid="PSA 42:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 42:8"/>Le ŋkeke me la, Yehowa ɖoa eƒe lɔlɔ̃ ɖem,</para>
  <para style="q2" vid="PSA 42:8">le zã me la eƒe ha nɔa nunyeme,</para>
  <para style="q2" vid="PSA 42:8">eye wònyea gbedodoɖa na nye agbe ƒe Mawu la.<verse eid="PSA 42:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 42:9"/>Megblɔ na Mawu, nye Agakpe la be,</para>
  <para style="q2" vid="PSA 42:9">“Nu ka ta nèŋlɔm be ɖo?</para>
  <para style="q1" vid="PSA 42:9">Nu ka ta manɔ yiyim, anɔ nu xam</para>
  <para style="q2" vid="PSA 42:9">le nye futɔwo ƒe teteɖeanyi ta ɖo?”<verse eid="PSA 42:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 42:10"/>Nye ƒuwo le veve sem, eye nye ketɔwo</para>
  <para style="q2" vid="PSA 42:10">le alɔme ɖem le ŋunye,</para>
  <para style="q1" vid="PSA 42:10">le gbɔgblɔm nam ŋkeke blibo la be,</para>
  <para style="q2" vid="PSA 42:10">“Afi ka wò Mawu la le?”<verse eid="PSA 42:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 42:11"/>O! Nye luʋɔ, nu ka ta nèle nu xam ɖo?</para>
  <para style="q2" vid="PSA 42:11">Nu ka ta nètsi dzodzodzoe le menye ɖo?</para>
  <para style="q1" vid="PSA 42:11">Tsɔ wò mɔkpɔkpɔ da ɖe Mawu dzi,</para>
  <para style="q2" vid="PSA 42:11">elabena magakafui,</para>
  <para style="q2" vid="PSA 42:11">eya ame si nye nye Ɖela kple nye Mawu.<verse eid="PSA 42:11"/></para>
  <chapter eid="PSA 42"/>
  <chapter number="43" style="c" sid="PSA 43"/>
  <para style="cl">Psalmo 43</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 43:1"/>O! Mawu, tso afia nam,</para>
  <para style="q2" vid="PSA 43:1">eye nàʋli tanye le mawumavɔ̃lawo dome,</para>
  <para style="q2" vid="PSA 43:1">ɖem tso ame vɔ̃ɖiwo kple ameblelawo ƒe asi me.<verse eid="PSA 43:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 43:2"/>Wòe nye Mawu, nye mɔ sesẽ.</para>
  <para style="q2" vid="PSA 43:2">Nu ka ta nègbem ɖo?</para>
  <para style="q1" vid="PSA 43:2">Nu ka ta manɔ yiyim, anɔ nu xam</para>
  <para style="q2" vid="PSA 43:2">le nye futɔwo ƒe teteɖeanyi ta ɖo?<verse eid="PSA 43:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 43:3"/>Ɖo wò kekeli kple nyateƒe ɖa, ne woakplɔm;</para>
  <para style="q2" vid="PSA 43:3">na woakplɔm ayi ɖe wò to kɔkɔe la dzi, afi si nènɔna.<verse eid="PSA 43:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 43:4"/>Ekema mayi ɖe Mawu ƒe vɔsamlekpui ŋgɔ,</para>
  <para style="q2" vid="PSA 43:4">Mawu si nye nye aseyetsotso kple nye dzidzɔ.</para>
  <para style="q2" vid="PSA 43:4">O! Mawu, nye Mawu, makafu wò kple kasaŋku.<verse eid="PSA 43:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 43:5"/>O! Nye luʋɔ, nu ka ta nèle nu xam ɖo?</para>
  <para style="q2" vid="PSA 43:5">Nu ka ta nètsi dzodzodzoe le menye ɖo?</para>
  <para style="q1" vid="PSA 43:5">Tsɔ wò mɔkpɔkpɔ da ɖe Mawu dzi,</para>
  <para style="q2" vid="PSA 43:5">elabena magakafui,</para>
  <para style="q2" vid="PSA 43:5">eya ame si nye nye Ɖela kple nye Mawu.<verse eid="PSA 43:5"/></para>
  <chapter eid="PSA 43"/>
  <chapter number="44" style="c" sid="PSA 44"/>
  <para style="cl">Psalmo 44</para>
  <para style="d">Korah ƒe viwo ƒe nufiameha na hɛnɔ la.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 44:1"/>O! Mawu, míawo ŋutɔ míesee</para>
  <para style="q2" vid="PSA 44:1">kple míaƒe towo, nu siwo mía fofowo gblɔ na</para>
  <para style="q2" vid="PSA 44:1">mí tso nu siwo nèwɔ na wo le woƒe ɣeyiɣiwo me le blema.<verse eid="PSA 44:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 44:2"/>Ètsɔ wò asi nya dukɔwo,</para>
  <para style="q2" vid="PSA 44:2">eye nètsɔ mía fofowo ɖo wo teƒe.</para>
  <para style="q1" vid="PSA 44:2">Ègbã dukɔwo gudugudu,</para>
  <para style="q2" vid="PSA 44:2">ke èna mía fofowo ya dzi ɖe edzi.<verse eid="PSA 44:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 44:3"/>Anyigba mesu wo si to</para>
  <para style="q2" vid="PSA 44:3">woawo ŋutɔ ƒe yi dzi loo,</para>
  <para style="q1" vid="PSA 44:3">alo woawo ŋutɔ ƒe alɔe ɖu dzi na wo o,</para>
  <para style="q2" vid="PSA 44:3">ke boŋ wò nuɖusi,</para>
  <para style="q1" vid="PSA 44:3">wò alɔ kple wò mo ƒe kekelie xɔ na wo,</para>
  <para style="q2" vid="PSA 44:3">elabena èlɔ̃ wo.<verse eid="PSA 44:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 44:4"/>Wòe nye nye Fia kple nye Mawu,</para>
  <para style="q2" vid="PSA 44:4">wòe he dziɖuɖuwo vɛ na Yakob.<verse eid="PSA 44:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 44:5"/>To dziwò míetutu míaƒe futɔwo do ɖe megbe,</para>
  <para style="q2" vid="PSA 44:5">eye to wò ŋkɔ me míenya avuzi le míaƒe futɔwo dzi.<verse eid="PSA 44:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 44:6"/>Nyemeɖo ŋu ɖe nye aŋutrɔ ŋu o,</para>
  <para style="q2" vid="PSA 44:6">eye nye yi mehe dziɖuɖu vɛ nam o,<verse eid="PSA 44:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 44:7"/>ke boŋ èna míeɖu míaƒe ketɔwo dzi,</para>
  <para style="q2" vid="PSA 44:7">eye nèna ŋukpe lé míaƒe adikatɔwo.<verse eid="PSA 44:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 44:8"/>Míetsɔ Mawu ƒo adegbe ŋkeke blibo la,</para>
  <para style="q2" vid="PSA 44:8">eye míakafu wò ŋkɔ tegbetegbe. <char style="qs">Sela</char><verse eid="PSA 44:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 44:9"/>Ke azɔ la, ègbe mí, eye nèbɔbɔ mí ɖe anyi;</para>
  <para style="q2" vid="PSA 44:9">azɔ la, mègadona kple míaƒe aʋakɔwo o.<verse eid="PSA 44:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 44:10"/>Èna míegbugbɔ ɖe megbe le míaƒe futɔwo ŋgɔ,</para>
  <para style="q2" vid="PSA 44:10">eye míaƒe ketɔwo ha mí.<verse eid="PSA 44:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 44:11"/>Ètsɔ mí na be woavuvu mí abe alẽwo ene,</para>
  <para style="q2" vid="PSA 44:11">eye nèkaka mí ɖe dukɔwo dome.<verse eid="PSA 44:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 44:12"/>Ètsɔ wò dukɔ la dzra ho kpɔtsɔe</para>
  <para style="q2" vid="PSA 44:12">eye mèkpɔ naneke le wo dzadzra me o.<verse eid="PSA 44:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 44:13"/>Ètsɔ mí wɔ vlodonu na míaƒe aƒelikawo,</para>
  <para style="q2" vid="PSA 44:13">eye míezu alɔmeɖenu kple nu ɖikokoe na ame siwo ƒo xlã mí.<verse eid="PSA 44:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 44:14"/>Ètsɔ mí wɔ lodonu le dukɔwo dome,</para>
  <para style="q2" vid="PSA 44:14">eye amewo ʋuʋua ta ɖe mía ŋu ne wokpɔ mí.<verse eid="PSA 44:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 44:15"/>Nye vlododo le ŋkunye me ŋkeke blibo la,</para>
  <para style="q2" vid="PSA 44:15">eye ŋukpe tsyɔa mo nam,<verse eid="PSA 44:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 44:16"/>ne vlodolawo, fewuɖulawo le nunye ɖiam,</para>
  <para style="q2" vid="PSA 44:16">elabena futɔ la ɖoe kplikpaa be yeabia hlɔ̃m.<verse eid="PSA 44:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 44:17"/>Togbɔ be míeŋlɔ wò be,</para>
  <para style="q2" vid="PSA 44:17">alo da alakpa le wò nubabla la me o hã</para>
  <para style="q2" vid="PSA 44:17">la, èna nu siawo katã va mía dzi.<verse eid="PSA 44:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 44:18"/>Míaƒe dziwo metrɔ le yowòme o,</para>
  <para style="q2" vid="PSA 44:18">eye míaƒe afɔwo hã metra le wò mɔ dzi o.<verse eid="PSA 44:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 44:19"/>Gake ègbã mí gudugudu hegble mí ɖe amegaxiwo dome,</para>
  <para style="q2" vid="PSA 44:19">eye nètsɔ viviti tsiɖitsiɖi tsyɔ mía dzi.<verse eid="PSA 44:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 44:20"/>Nenye ɖe míeŋlɔ míaƒe Mawu ŋkɔ be,</para>
  <para style="q2" vid="PSA 44:20">alo ke míaƒe abɔwo na dzromawu aɖe la,<verse eid="PSA 44:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 44:21"/>ɖe Mawu manya esi wònya</para>
  <para style="q2" vid="PSA 44:21">dzimenu ɣaɣlawo katã oa?<verse eid="PSA 44:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 44:22"/>Gake le tawò la, míekpɔa ku ŋkeke blibo la,</para>
  <para style="q2" vid="PSA 44:22">eye wobua mí abe alẽ siwo wokplɔ yina wuwu ge la ene.<verse eid="PSA 44:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 44:23"/>Nyɔ, O Aƒetɔ! Nu ka ta nèle alɔ̃ dɔm ɖo?</para>
  <para style="q2" vid="PSA 44:23">Fɔ! Mègagbe mí ɖikaa o.<verse eid="PSA 44:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 44:24"/>Nu ka ta nèɣla wò mo,</para>
  <para style="q2" vid="PSA 44:24">eye nèŋlɔ míaƒe hiãkame kple teteɖeanyi be ɖo?<verse eid="PSA 44:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 44:25"/>Wohe mí ƒu ke me,</para>
  <para style="q2" vid="PSA 44:25">eye míaƒe ŋutilã lé ɖe anyigba.<verse eid="PSA 44:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 44:26"/>Tso, nàxɔ na mí,</para>
  <para style="q2" vid="PSA 44:26">ɖe mí le wò lɔlɔ̃ si meʋãna o la ta.<verse eid="PSA 44:26"/></para>
  <chapter eid="PSA 44"/>
  <chapter number="45" style="c" sid="PSA 45"/>
  <para style="cl">Psalmo 45</para>
  <para style="d">Korah ƒe viwo ƒe nufiameha si nye srɔ̃ɖeha na hɛnɔ la, ne woadzi ɖe dzogbenya ƒe gbeɖiɖi nu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 45:1"/>Nya nyuiwo le fiefiem le nye dzi me</para>
  <para style="q2" vid="PSA 45:1">esi mele ha sia kpam na fia la,</para>
  <para style="q2" vid="PSA 45:1">eye nye aɖee nye nuŋlɔla adodoea ƒe nuŋlɔti.<verse eid="PSA 45:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 45:2"/>Èdze ɖeka wu ŋutsuwo katã,</para>
  <para style="q2" vid="PSA 45:2">wotsɔ amenuveve si ami na wò nuyi,</para>
  <para style="q2" vid="PSA 45:2">elabena Mawu yra wò tegbee.<verse eid="PSA 45:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 45:3"/>O! Kalẽtɔ, tsɔ wò yi ta ɖe ali,</para>
  <para style="q2" vid="PSA 45:3">eye nàtsɔ wò atsyɔ̃ kple gãnyenye ata.<verse eid="PSA 45:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 45:4"/>Do sɔ dziɖuɖutɔe le wò fianyenye me.</para>
  <para style="q2" vid="PSA 45:4">Le nyateƒe, ɖokuibɔbɔ kple dzɔdzɔenyenye me,</para>
  <para style="q2" vid="PSA 45:4">na wò nuɖusi naɖe wò nuwɔwɔ dziŋɔwo afia.<verse eid="PSA 45:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 45:5"/>Na wò aŋutrɔ ɖaɖɛwo naŋɔ fia la ƒe futɔwo ƒe dzi,</para>
  <para style="q2" vid="PSA 45:5">eye na dukɔwo nadze anyi ɖe wò afɔ nu.<verse eid="PSA 45:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 45:6"/>O! Mawu, wò fiazikpui ali ke tso mavɔ me yi ɖe mavɔ me,</para>
  <para style="q2" vid="PSA 45:6">wò fiaɖuƒe la ƒe tsiamiti anye nuteƒewɔwɔ ƒe atikplɔ.<verse eid="PSA 45:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 45:7"/>Èlɔ̃ dzɔdzɔenyenye, eye nètsri nu vɔ̃ɖi wɔwɔ;</para>
  <para style="q2" vid="PSA 45:7">eya ta Mawu, wò Mawu la</para>
  <para style="q1" vid="PSA 45:7">ɖo wò nèkɔ gbɔ fia bubuwo ta to dzidzɔkpɔkpɔ</para>
  <para style="q2" vid="PSA 45:7">ƒe amisisi na wò me.<verse eid="PSA 45:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 45:8"/>Kotoklobo, lifi kple atike ʋeʋĩ le ya ɖem le wò awuwo me.</para>
  <para style="q2" vid="PSA 45:8">Kasaŋkuwo na nèle aseye tsom le wò nyiɖufiasawo me.<verse eid="PSA 45:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 45:9"/>Fiavinyɔnuwo le wò nyɔnu bubumewo dome,</para>
  <para style="q2" vid="PSA 45:9">eye fiasrɔ̃ si do Ofir Sikanuwo la nɔ wò nuɖusime.<verse eid="PSA 45:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 45:10"/>O! Vinyɔnu, ɖo to, nàbu eŋu, eye nàƒu to anyi.</para>
  <para style="q2" vid="PSA 45:10">Ŋlɔ wò dukɔ kple fofowò ƒe aƒe la be.<verse eid="PSA 45:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 45:11"/>Wò tugbedzedze wɔ dɔ ɖe fia la dzi ŋutɔ,</para>
  <para style="q2" vid="PSA 45:11">eya ta de bubu eŋu, elabena eyae nye wò aƒetɔ.<verse eid="PSA 45:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 45:12"/>Tiro vinyɔnu atsɔ nunana vɛ,</para>
  <para style="q2" vid="PSA 45:12">eye ŋutsu kesinɔtɔwo ava bia amenuveve tso gbɔwò.<verse eid="PSA 45:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 45:13"/>Fiavinyɔnu la nye keklẽ sɔŋ le eƒe xɔ me;</para>
  <para style="q2" vid="PSA 45:13">eye wotsɔ sika lé ɖe eƒe awu legbe ƒe teƒeteƒewo keŋ.<verse eid="PSA 45:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 45:14"/>Edo awu legbe si wolɔ̃ kple ka,</para>
  <para style="q2" vid="PSA 45:14">eye wokplɔe va fia la gbɔe;</para>
  <para style="q1" vid="PSA 45:14">eƒe dɔlanyɔnu siwo menya ŋutsu o la kplɔe ɖo,</para>
  <para style="q2" vid="PSA 45:14">eye wokplɔ wo vɛ na wò.<verse eid="PSA 45:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 45:15"/>Wokplɔ wo ge ɖe eme le dzidzɔkpɔkpɔ kple aseyetsotso me,</para>
  <para style="q2" vid="PSA 45:15">ale woge ɖe fiasã la me.<verse eid="PSA 45:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 45:16"/>Mía viŋutsuwo axɔ ɖe mía fofowo teƒe,</para>
  <para style="q2" vid="PSA 45:16">eye míawɔ wo fiaviwo le anyigba la katã dzi.<verse eid="PSA 45:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 45:17"/>Mana woaɖo ŋku dziwò le dzidzimewo katã me,</para>
  <para style="q2" vid="PSA 45:17">eya ta dukɔwo akafu wò tso mavɔ me yi ɖe mavɔ me.<verse eid="PSA 45:17"/></para>
  <chapter eid="PSA 45"/>
  <chapter number="46" style="c" sid="PSA 46"/>
  <para style="cl">Psalmo 46</para>
  <para style="d">Korah ƒe viwo ƒe ha na hɛnɔ la, ne woadzi ɖe <char style="tl">alamot</char> ƒe gbeɖiɖi nu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 46:1"/>Mawue nye míaƒe sitsoƒe kple ŋusẽ,</para>
  <para style="q2" vid="PSA 46:1">xɔnametɔ si li ɖaa kpli mí le xaxawo me.<verse eid="PSA 46:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 46:2"/>Eya ta ne anyigba gli le zi dzi hã la, míavɔ̃ o,</para>
  <para style="q2" vid="PSA 46:2">ne towo ho ɖadze atsiaƒu me,<verse eid="PSA 46:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 46:3"/>eye atsiaƒutsi ɖe gbe lɔ futukpɔ ɖe nu,</para>
  <para style="q2" vid="PSA 46:3">ale be towo dzo kpekpekpe</para>
  <para style="q2" vid="PSA 46:3">le eƒe howɔwɔ ta hã la, míavɔ̃ o. <char style="qs">Sela</char><verse eid="PSA 46:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 46:4"/>Tɔsisi aɖe li,</para>
  <para style="q2" vid="PSA 46:4">esi ƒe tsiwo doa dzidzɔ na Mawu ƒe du,</para>
  <para style="q2" vid="PSA 46:4">teƒe kɔkɔe, afi si Dziƒoʋĩtɔ la nɔna.<verse eid="PSA 46:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 46:5"/>Mawu le afi ma, eya ta mamu adze anyi o.</para>
  <para style="q2" vid="PSA 46:5">Mawu akpe ɖe eŋu ne ŋu ke teti.<verse eid="PSA 46:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 46:6"/>Hoowɔwɔ ɖo dukɔwo me, fiaɖuƒewo mu;</para>
  <para style="q2" vid="PSA 46:6">ekɔ eƒe gbe dzi, tete anyigba lolo.<verse eid="PSA 46:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 46:7"/>Yehowa, Dziƒoʋakɔwo ƒe Aƒetɔ la li kpli mí,</para>
  <para style="q2" vid="PSA 46:7">Yakob ƒe Mawu la nye míaƒe mɔ sesẽ. <char style="qs">Sela</char><verse eid="PSA 46:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 46:8"/>Miva kpɔ Yehowa ƒe dɔwɔwɔwo ɖa,</para>
  <para style="q2" vid="PSA 46:8">miva kpɔ gbegblẽ si wòhe va anyigba dzi la ɖa.<verse eid="PSA 46:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 46:9"/>Ena aʋawɔwɔ nu tso va se ɖe keke anyigba ƒe mlɔenu ke;</para>
  <para style="q2" vid="PSA 46:9">eŋe da, eye wòfli akplɔ,</para>
  <para style="q2" vid="PSA 46:9">hetɔ dzo akpoxɔnuwo.<verse eid="PSA 46:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 46:10"/>“Ɖe dzi ɖi, eye nànya be nyee nye Mawu.</para>
  <para style="q2" vid="PSA 46:10">Woadom ɖe dzi le dukɔwo dome,</para>
  <para style="q2" vid="PSA 46:10">eye woadom ɖe dzi le anyigba dzi.”<verse eid="PSA 46:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 46:11"/>Yehowa Dziƒoʋakɔwo ƒe Aƒetɔ la li kpli mí,</para>
  <para style="q2" vid="PSA 46:11">Yakob ƒe Mawu la nye míaƒe mɔ sesẽ. <char style="qs">Sela.</char><verse eid="PSA 46:11"/></para>
  <chapter eid="PSA 46"/>
  <chapter number="47" style="c" sid="PSA 47"/>
  <para style="cl">Psalmo 47</para>
  <para style="d">Korah ƒe viwo ƒe ha na hɛnɔ la.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 47:1"/>Miƒo asikpe, mi dukɔwo katã.</para>
  <para style="q2" vid="PSA 47:1">Mitso aseye ɖe Mawu ŋu kple ɣli.<verse eid="PSA 47:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 47:2"/>Ŋɔdzi le Yehowa Dziƒoʋĩtɔ la ŋu ale gbegbe,</para>
  <para style="q2" vid="PSA 47:2">eyae nye Fiagã ɖe anyigba la katã dzi!<verse eid="PSA 47:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 47:3"/>Ebɔbɔ dukɔwo ɖe mía te,</para>
  <para style="q2" vid="PSA 47:3">eye wòtsɔ anyigbadzitɔwo de míaƒe afɔ te.<verse eid="PSA 47:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 47:4"/>Etia míaƒe domenyinu na mí si nye dada na Yakob,</para>
  <para style="q2" vid="PSA 47:4">ame si wòlɔ̃. <char style="qs">Sela</char><verse eid="PSA 47:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 47:5"/>Mawu yi dzi kple aseyetsotso,</para>
  <para style="q2" vid="PSA 47:5">Yehowa yi dzi kple kpẽ ƒe ɖiɖi.<verse eid="PSA 47:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 47:6"/>Midzi kafukafuhawo na Mawu,</para>
  <para style="q2" vid="PSA 47:6">midzi kafukafuhawo;</para>
  <para style="q1" vid="PSA 47:6">midzi kafukafuhawo na míaƒe Fia la,</para>
  <para style="q2" vid="PSA 47:6">midzi kafukafuhawo,<verse eid="PSA 47:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 47:7"/>elabena Mawue nye Fia ɖe anyigba blibo la dzi,</para>
  <para style="q2" vid="PSA 47:7">midzi kafukafuha nɛ.<verse eid="PSA 47:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 47:8"/>Mawu ɖu fia ɖe dukɔwo dzi.</para>
  <para style="q2" vid="PSA 47:8">Mawu nɔ anyi ɖe eƒe fiazikpui kɔkɔe la dzi.<verse eid="PSA 47:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 47:9"/>Dukɔwo ƒe bubumewo ɖi anyi</para>
  <para style="q2" vid="PSA 47:9">abe Abraham ƒe Mawu la ƒe amewo ene,</para>
  <para style="q1" vid="PSA 47:9">elabena anyigbadzifiawo nye Mawu tɔ,</para>
  <para style="q2" vid="PSA 47:9">elabena wodo eya amea ɖe dzi bobobo.<verse eid="PSA 47:9"/></para>
  <chapter eid="PSA 47"/>
  <chapter number="48" style="c" sid="PSA 48"/>
  <para style="cl">Psalmo 48</para>
  <para style="d">Korah ƒe viwo ƒe ha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 48:1"/>Yehowa lolo, eye eya koe dze kafukafu</para>
  <para style="q2" vid="PSA 48:1">le míaƒe Mawu la ƒe du me, le eƒe to kɔkɔe la dzi.<verse eid="PSA 48:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 48:2"/>Zion to la kɔkɔ henya kpɔ ale gbegbe,</para>
  <para style="q2" vid="PSA 48:2">eye wònye dzudzɔdonu na anyigba blibo la.</para>
  <para style="q2" vid="PSA 48:2">Fia gã la ƒe du, si le abe Zafon to kɔkɔe la ene.<verse eid="PSA 48:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 48:3"/>Mawu le eƒe fiasãwo me,</para>
  <para style="q2" vid="PSA 48:3">eye wòɖe eɖokui fia abe eƒe mɔ sesẽ ene.<verse eid="PSA 48:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 48:4"/>Fiawo ƒo woƒe aʋakɔwo nu ƒu,</para>
  <para style="q2" vid="PSA 48:4">hezɔ ɖe edzi ɖekae,<verse eid="PSA 48:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 48:5"/>ke esi wokpɔe la, woƒe nu ku,</para>
  <para style="q2" vid="PSA 48:5">ŋɔdzi lé wo eye wosi dzo.<verse eid="PSA 48:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 48:6"/>Dzidzi ƒo wo, eye wose veve</para>
  <para style="q2" vid="PSA 48:6">abe nyɔnu si le ku lém la ene.<verse eid="PSA 48:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 48:7"/>Egbã wo gudugudu</para>
  <para style="q2" vid="PSA 48:7">abe ale si ɣedzeƒeya gbã Tarsis tɔdziʋuwo ene.<verse eid="PSA 48:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 48:8"/>Abe ale si míese ene la,</para>
  <para style="q2" vid="PSA 48:8">nenemae míekpɔe le Yehowa,</para>
  <para style="q1" vid="PSA 48:8">Dziƒoʋakɔwo ƒe Aƒetɔ la</para>
  <para style="q2" vid="PSA 48:8">kple míaƒe Mawu la ƒe du mee.</para>
  <para style="q1" vid="PSA 48:8">Mawu na wòanɔ dedie</para>
  <para style="q2" vid="PSA 48:8">tegbetegbe. <char style="qs">Sela</char><verse eid="PSA 48:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 48:9"/>O! Mawu, míedea ŋugble le wò lɔlɔ̃ si meʋãna o la ŋu</para>
  <para style="q2" vid="PSA 48:9">le wò gbedoxɔ me.<verse eid="PSA 48:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 48:10"/>O! Mawu, wò kafukafu de keke anyigba la ƒe mlɔenu</para>
  <para style="q2" vid="PSA 48:10">ke abe wò ŋkɔ ene.</para>
  <para style="q2" vid="PSA 48:10">Wò nuɖusi ɖua fia le dzɔdzɔenyenye me.<verse eid="PSA 48:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 48:11"/>Zion to kpɔ dzidzɔ,</para>
  <para style="q2" vid="PSA 48:11">eye Yuda ƒe kɔƒewo</para>
  <para style="q2" vid="PSA 48:11">le aseye tsom le wò afiatsotso ta.<verse eid="PSA 48:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 48:12"/>Mizɔ Zion to la ŋu godoo,</para>
  <para style="q2" vid="PSA 48:12">mizɔ ƒo xlãe, eye mixlẽ eƒe xɔ tsralawo,<verse eid="PSA 48:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 48:13"/>ne miakpɔ kpo si woƒo ɖe eƒe gliwo ŋu.</para>
  <para style="q2" vid="PSA 48:13">Mikpɔ eƒe fiasãwo nyuie ne míatsɔe atu xoe</para>
  <para style="q2" vid="PSA 48:13">na dzidzime si gbɔna,<verse eid="PSA 48:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 48:14"/>elabena Mawu siae nye míaƒe Mawu</para>
  <para style="q2" vid="PSA 48:14">tso mavɔ me yi ɖe mavɔ me;</para>
  <para style="q2" vid="PSA 48:14">eyae anye mía kplɔla yi ɖase ɖe nuwuwu.<verse eid="PSA 48:14"/></para>
  <chapter eid="PSA 48"/>
  <chapter number="49" style="c" sid="PSA 49"/>
  <para style="cl">Psalmo 49</para>
  <para style="d">Korah ƒe viwo ƒe ha na hɛnɔ la.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 49:1"/>Mi anyigbadzitɔwo katã, mise esia;</para>
  <para style="q2" vid="PSA 49:1">mi xexemetɔwo katã miƒu to anyi,<verse eid="PSA 49:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 49:2"/>mi ame dzodzrowo kple amegãwo,</para>
  <para style="q2" vid="PSA 49:2">ame dahewo kple kesinɔtɔwo siaa.<verse eid="PSA 49:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 49:3"/>Nye nu agblɔ nunya ƒe nyawo,</para>
  <para style="q2" vid="PSA 49:3">eye nya siwo ado tso nye dzi me la ahe gɔmesese vɛ.<verse eid="PSA 49:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 49:4"/>Maƒu to anyi ɖe lododo ŋu,</para>
  <para style="q2" vid="PSA 49:4">eye mato adzo kple nye kasaŋku.<verse eid="PSA 49:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 49:5"/>Nu ka ta mavɔ̃ ne ŋkeke vɔ̃wo va,</para>
  <para style="q2" vid="PSA 49:5">ne ame vɔ̃ɖi, ameblelawo ƒo xlãm,<verse eid="PSA 49:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 49:6"/>ame siwo ɖoa dzi ɖe woƒe kesinɔnuwo ŋu,</para>
  <para style="q2" vid="PSA 49:6">eye wotsɔa woƒe nukpɔkpɔ gbogboawo nɔa adegbe ƒom ɖo?<verse eid="PSA 49:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 49:7"/>Ame aɖeke mate ŋu aɖe nɔvia ƒe agbe</para>
  <para style="q2" vid="PSA 49:7">alo atsɔ ga aƒle etae le Mawu gbɔ o.<verse eid="PSA 49:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 49:8"/>Agbeƒlega menye ga sue o,</para>
  <para style="q2" vid="PSA 49:8">eye ga home aɖeke made enu be<verse eid="PSA 49:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 49:9"/>amea nanɔ agbe tegbee,</para>
  <para style="q2" vid="PSA 49:9">eye makpɔ ku o.<verse eid="PSA 49:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 49:10"/>Ame sia ame kpɔe be nunyala kuna;</para>
  <para style="q2" vid="PSA 49:10">bometsilawo kple abunɛtɔwo siaa tsrɔ̃na,</para>
  <para style="q2" vid="PSA 49:10">eye wogblea woƒe kesinɔnuwo ɖi na ame bubuwo.<verse eid="PSA 49:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 49:11"/>Togbɔ be anyigbawo le wo</para>
  <para style="q2" vid="PSA 49:11">si woŋlɔ woƒe ŋkɔwo ɖe wo dzi hã la,</para>
  <para style="q1" vid="PSA 49:11">woƒe yɔdowo anye woƒe aƒe tegbee,</para>
  <para style="q2" vid="PSA 49:11">eye woanye woƒe nɔƒe tso dzidzime yi dzidzime.<verse eid="PSA 49:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 49:12"/>Togbɔ be kesinɔnu geɖewo</para>
  <para style="q2" vid="PSA 49:12">le amegbetɔ si hã la, manɔ agbe tegbee o,</para>
  <para style="q2" vid="PSA 49:12">ɖeko wòle abe gbemelã siwo tsrɔ̃na ene.<verse eid="PSA 49:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 49:13"/>Esia nye nu si dzɔna ɖe</para>
  <para style="q2" vid="PSA 49:13">ame siwo ɖo ŋu ɖe wo ɖokuiwo ŋu la dzi.</para>
  <para style="q1" vid="PSA 49:13">Aleae wòanɔ na wo yomedzela</para>
  <para style="q2" vid="PSA 49:13">siwo dea woƒe nyagbɔgblɔwo dzi. <char style="qs">Sela</char><verse eid="PSA 49:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 49:14"/>Woayi tsiẽƒe abe alẽwo ene,</para>
  <para style="q2" vid="PSA 49:14">eye woanye nuɖuɖu na ku.</para>
  <para style="q1" vid="PSA 49:14">Ame dzɔdzɔe aɖu wo dzi le ŋdi,</para>
  <para style="q2" vid="PSA 49:14">woƒe ŋutilãwo aƒaƒã ɖe yɔdo me,</para>
  <para style="q2" vid="PSA 49:14">eye woate ɖa xaa tso woƒe xɔ gã dranyiwo gbɔ.<verse eid="PSA 49:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 49:15"/>Ke Mawu aɖe nye agbe tso ku me,</para>
  <para style="q2" vid="PSA 49:15">eye wòaxɔm ɖe eɖokui gbɔ. <char style="qs">Sela</char><verse eid="PSA 49:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 49:16"/>Ne ame aɖe zu kesinɔtɔ la,</para>
  <para style="q2" vid="PSA 49:16">megawɔ moya na wò o,</para>
  <para style="q2" vid="PSA 49:16">ne eƒe aƒe ƒe atsyɔ̃ dzi ɖe edzi la, megawɔ nuku na wò o,<verse eid="PSA 49:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 49:17"/>elabena ne eku la, matsɔ naneke ɖe asi o,</para>
  <para style="q2" vid="PSA 49:17">eƒe atsyɔ̃ gɔ̃ hã mayi yɔ me kplii o.<verse eid="PSA 49:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 49:18"/>Togbɔ be ebu eɖokui ame si woyra,</para>
  <para style="q2" vid="PSA 49:18">eye amewo kafui esi nu le edzi dzem nɛ hã la,<verse eid="PSA 49:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 49:19"/>ayi aɖawɔ ɖeka kple fofoa ƒe dzidzime</para>
  <para style="q2" vid="PSA 49:19">si magakpɔ agbe ƒe kekeli akpɔ o.<verse eid="PSA 49:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 49:20"/>Ame si si kesinɔnuwo le, evɔ gɔmesese mele esi o la</para>
  <para style="q2" vid="PSA 49:20">le abe gbemelã si tsrɔ̃ la ene.<verse eid="PSA 49:20"/></para>
  <chapter eid="PSA 49"/>
  <chapter number="50" style="c" sid="PSA 50"/>
  <para style="cl">Psalmo 50</para>
  <para style="d">Asaf ƒe ha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 50:1"/>Mawu ŋusẽtɔ, Yehowa ƒo nu heyɔ takpekpe na</para>
  <para style="q2" vid="PSA 50:1">anyigba la tso agudzedze va se ɖe esime ɣe ɖo to.<verse eid="PSA 50:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 50:2"/>Mawu klẽ tso Zion</para>
  <para style="q2" vid="PSA 50:2">le eƒe anidzedze blibo la me.<verse eid="PSA 50:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 50:3"/>Míaƒe Mawu la gbɔna,</para>
  <para style="q2" vid="PSA 50:3">ahom le tutum le eŋgɔ,</para>
  <para style="q2" vid="PSA 50:3">dzo le nu bim le eŋgɔ, eye mazi ɖoɖoe o.<verse eid="PSA 50:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 50:4"/>Eɖi ʋɔnu, eye wòyɔ dziƒo</para>
  <para style="q2" vid="PSA 50:4">kple anyigba ne wòadrɔ̃ ʋɔnu eƒe dukɔ,<verse eid="PSA 50:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 50:5"/>“Miƒo nye ame kɔkɔewo nu ƒu nam,</para>
  <para style="q2" vid="PSA 50:5">ame siwo bla nu kplim kple akpedavɔsa.”<verse eid="PSA 50:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 50:6"/>Dziƒo ɖe gbeƒã eƒe dzɔdzɔenyenye,</para>
  <para style="q2" vid="PSA 50:6">elabena Mawu ŋutɔe nye ʋɔnudrɔ̃la. <char style="qs">Sela</char><verse eid="PSA 50:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 50:7"/>“See, o nye dukɔ, mele nu ƒo ge,</para>
  <para style="q2" vid="PSA 50:7">O! Israel, maɖu ɖasefo ɖe ŋuwò,</para>
  <para style="q2" vid="PSA 50:7">elabena nyee nye Mawu, wò Mawu la.<verse eid="PSA 50:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 50:8"/>Nyemeka mo na wò ɖe wò akpedavɔsa</para>
  <para style="q2" vid="PSA 50:8">alo numevɔsa siwo le ŋkunye me ɖaa la ta o.<verse eid="PSA 50:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 50:9"/>Nyemehiã nyitsu tso wò nyikpo me,</para>
  <para style="q2" vid="PSA 50:9">alo gbɔ̃wo tso wò gbɔ̃kpo me o,<verse eid="PSA 50:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 50:10"/>elabena avemelãwo katã tɔnye wonye,</para>
  <para style="q2" vid="PSA 50:10">kple nyi siwo le togbɛ akpewo dzi.<verse eid="PSA 50:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 50:11"/>Menya xevi ɖe sia ɖe si le towo dzi,</para>
  <para style="q2" vid="PSA 50:11">eye nuwɔwɔ ɖe sia ɖe si le gbe me la tɔnyee wonye.<verse eid="PSA 50:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 50:12"/>Ne dɔe le wuyem la, nyemagblɔe na wò o,</para>
  <para style="q2" vid="PSA 50:12">elabena xexea me kple nu siwo katã le eme la nye tɔnye.<verse eid="PSA 50:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 50:13"/>Ɖe meɖua nyilã</para>
  <para style="q2" vid="PSA 50:13">alo noa gbɔ̃wo ƒe ʋua?<verse eid="PSA 50:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 50:14"/>“Mitsɔ akpedavɔsawo na Mawu,</para>
  <para style="q2" vid="PSA 50:14">eye mixe miaƒe adzɔgbeɖefewo na Dziƒoʋĩtɔ la.<verse eid="PSA 50:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 50:15"/>Miyɔm le xaxagbe,</para>
  <para style="q2" vid="PSA 50:15">maɖe mi, eye miade bubu ŋutinye.”<verse eid="PSA 50:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PSA 50:16"/>Ke Mawu le gbɔgblɔm na ame vɔ̃ɖi la be:</para>
  <para style="q1" vid="PSA 50:16">“Mɔ ka nèkpɔ be nàxlẽ nye sewo afia,</para>
  <para style="q2" vid="PSA 50:16">alo alé nye nubabla la ɖe nu?<verse eid="PSA 50:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 50:17"/>Wò la èlé fu nye nufiame,</para>
  <para style="q2" vid="PSA 50:17">eye nètsɔ nye nyawo ƒu gbe ɖe megbe.<verse eid="PSA 50:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 50:18"/>Ne èkpɔ fiafitɔ la, èwɔa ɖeka kplii,</para>
  <para style="q2" vid="PSA 50:18">eye nèdea ha kple ahasitɔwo.<verse eid="PSA 50:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 50:19"/>Nya vlowo doa go le nuwò,</para>
  <para style="q2" vid="PSA 50:19">eye wò aɖe blea ame.<verse eid="PSA 50:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 50:20"/>Ègblɔa nya tsia tsitre ɖe nɔviwò ŋu,</para>
  <para style="q2" vid="PSA 50:20">eye nèƒoa ɖi dawòvi ŋutsu.<verse eid="PSA 50:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 50:21"/>Nu siawoe nye nu siwo nèwɔ hafi mezi ɖoɖoe,</para>
  <para style="q2" vid="PSA 50:21">eye nèsusu be ɖeko mele abe ye ene,</para>
  <para style="q1" vid="PSA 50:21">gake maka mo na wò,</para>
  <para style="q2" vid="PSA 50:21">eye mado asi ɖe mo na wò.<verse eid="PSA 50:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 50:22"/>“Bu esia ŋuti, wò ame si ŋlɔ Mawu be,</para>
  <para style="q2" vid="PSA 50:22">ne menye nenema o la, mavuvu wò kakɛkakɛ,</para>
  <para style="q2" vid="PSA 50:22">eye ame aɖeke maxɔ wò le asinye o.<verse eid="PSA 50:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 50:23"/>Ame si na akpedavɔsa la,</para>
  <para style="q2" vid="PSA 50:23">de bubu ŋunye, eye wòta mɔ be</para>
  <para style="q2" vid="PSA 50:23">mafia Mawu ƒe ɖeɖee.”<verse eid="PSA 50:23"/></para>
  <chapter eid="PSA 50"/>
  <chapter number="51" style="c" sid="PSA 51"/>
  <para style="cl">Psalmo 51</para>
  <para style="d">David ƒe ha na hɛnɔ la. Ekpa ha sia esime wòwɔ ahasi kple Batseba, eye Nyagblɔɖila Natan va egbɔ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 51:1"/>O! Mawu, kpɔ nye nublanui le wò lɔlɔ̃ si meʋãna o la ta.</para>
  <para style="q2" vid="PSA 51:1">Le wò dɔmenyo sɔgbɔ la nu, tutu nye dzidadawo ɖa.<verse eid="PSA 51:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 51:2"/>Klɔ nye vodadawo katã ɖa, eye nàle tsi nam</para>
  <para style="q2" vid="PSA 51:2">ŋunye nakɔ tso nye nu vɔ̃wo me.<verse eid="PSA 51:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 51:3"/>Elabena menya nye dzidadawo,</para>
  <para style="q2" vid="PSA 51:3">eye nye nu vɔ̃wo le nye ŋkume ɖaa.<verse eid="PSA 51:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 51:4"/>Ŋuwò, wò ko ŋu mewɔ nu vɔ̃ ɖo,</para>
  <para style="q2" vid="PSA 51:4">eye nu si nye vɔ̃ le wò ŋkume la mewɔ,</para>
  <para style="q1" vid="PSA 51:4">eya ta ne èle nu ƒom la, woaɖee afia be tɔwò dzɔ,</para>
  <para style="q2" vid="PSA 51:4">eye ne ètso afia la, woagblɔ be ele eteƒe.<verse eid="PSA 51:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 51:5"/>Vavã, wodzim ɖe nu vɔ̃ me,</para>
  <para style="q2" vid="PSA 51:5">eye nu vɔ̃ me danye fɔ nye fu ɖo.<verse eid="PSA 51:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 51:6"/>Vavã, nyateƒe si tso dzi me ke la nèdina;</para>
  <para style="q2" vid="PSA 51:6">èfia nunyam le ememe ke.<verse eid="PSA 51:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 51:7"/>Klɔ ŋutinye kple kakle, eye ŋunye aɖi;</para>
  <para style="q2" vid="PSA 51:7">le tsi nam, eye mafu tititi wu aklala.<verse eid="PSA 51:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 51:8"/>Na mase dzidzɔkpɔkpɔ kple aseyetsotso,</para>
  <para style="q2" vid="PSA 51:8">ne nye ƒu siwo nèŋe la nakpɔ dzidzɔ.<verse eid="PSA 51:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 51:9"/>Ɣla wò mo ɖe nye nu vɔ̃wo,</para>
  <para style="q2" vid="PSA 51:9">eye nàtutu nye vodadawo katã ɖa.<verse eid="PSA 51:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 51:10"/>O! Mawu, wɔ dzi dzadzɛ aɖe nam,</para>
  <para style="q2" vid="PSA 51:10">eye nàgbugbɔ gbɔgbɔ si li ke la de menye.<verse eid="PSA 51:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 51:11"/>Mègatsɔm ƒu gbe le wò ŋkume,</para>
  <para style="q2" vid="PSA 51:11">alo nàxɔ wò Gbɔgbɔ Kɔkɔe la le asinye o.<verse eid="PSA 51:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 51:12"/>Gbugbɔ ɖeɖekpɔkpɔ ƒe dzidzɔ de menye,</para>
  <para style="q2" vid="PSA 51:12">eye nàna gbɔgbɔ si le klalo la be wòalém ɖe asi.<verse eid="PSA 51:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 51:13"/>Ekema mafia wò mɔwo dzidalawo,</para>
  <para style="q2" vid="PSA 51:13">eye nu vɔ̃ wɔlawo atrɔ ava gbɔwò.<verse eid="PSA 51:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 51:14"/>O! Mawu, ɖem tso ʋukɔkɔɖi ƒe nu vɔ̃ me,</para>
  <para style="q2" vid="PSA 51:14">wò Mawu si ɖem, eye nye aɖe adzi ha</para>
  <para style="q2" vid="PSA 51:14">le wò dzɔdzɔenyenye ŋu.<verse eid="PSA 51:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 51:15"/>O! Aƒetɔ, ke nye nuyiwo,</para>
  <para style="q2" vid="PSA 51:15">eye nye nu aɖe gbeƒã wò kafukafu.<verse eid="PSA 51:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 51:16"/>Mèdia vɔsa o, anye ne metsɔe na wò;</para>
  <para style="q2" vid="PSA 51:16">numevɔsa hã medoa dzidzɔ na wò o.<verse eid="PSA 51:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 51:17"/>Vɔsa siwo nye Mawu tɔe nye gbɔgbɔ si wogbã.</para>
  <para style="q2" vid="PSA 51:17">O! Mawu, màdo vlo dzi si gbã hetugu la o.<verse eid="PSA 51:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 51:18"/>Na nu nadze edzi na Zion le wò didi nyui la nu,</para>
  <para style="q2" vid="PSA 51:18">eye nàɖo Yerusalem ƒe gliwo te.<verse eid="PSA 51:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 51:19"/>Ekema dzɔdzɔenyenyevɔsawo</para>
  <para style="q2" vid="PSA 51:19">kple numevɔsa blibowo ava gbɔwò,</para>
  <para style="q1" vid="PSA 51:19">ado dzidzɔ na wò, eye woatsɔ nyitsuwo asa vɔe</para>
  <para style="q2" vid="PSA 51:19">le wò vɔsamlekpui dzi.<verse eid="PSA 51:19"/></para>
  <chapter eid="PSA 51"/>
  <chapter number="52" style="c" sid="PSA 52"/>
  <para style="cl">Psalmo 52</para>
  <para style="d">David ƒe nufiameha na hɛnɔ la. Ekpa ha sia esi Edomtɔ, Doeg yi ɖagblɔ na Saul be, “David yi ɖe Ahimelek ƒe aƒe me.”</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 52:1"/>Nu ka ta nètsɔ nu vɔ̃ɖi le adegbe ƒom, wò kalẽtɔ?</para>
  <para style="q2" vid="PSA 52:1">Nu ka wɔ nèle adegbe ƒom ŋkeke blibo la,</para>
  <para style="q2" vid="PSA 52:1">wò ame si nye ŋunyɔnu le Mawu ƒe ŋkume?<verse eid="PSA 52:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 52:2"/>Wò aɖe le gbegblẽ ɖom;</para>
  <para style="q2" vid="PSA 52:2">èle abe hɛ ɖaɖɛ ene, wò alakpatɔ.<verse eid="PSA 52:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 52:3"/>Èlɔ̃ vɔ̃ wu nyui,</para>
  <para style="q2" vid="PSA 52:3">èlɔ̃ alakpa wu nyateƒetoto. <char style="qs">Sela</char><verse eid="PSA 52:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 52:4"/>O! Wò alakpaɖe,</para>
  <para style="q2" vid="PSA 52:4">èlɔ̃ nya gbegblẽwo sɔŋ ko!<verse eid="PSA 52:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 52:5"/>Vavã, Mawu hã aƒu wò anyi ɖe gbegblẽ mavɔ me.</para>
  <para style="q2" vid="PSA 52:5">Mawu ahe wò ado goe tso wò agbadɔ me,</para>
  <para style="q2" vid="PSA 52:5">aho wò kple ke tso agbagbeawo ƒe anyigba dzi. <char style="qs">Sela</char><verse eid="PSA 52:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 52:6"/>Ame dzɔdzɔewo akpɔe, eye woavɔ̃;</para>
  <para style="q2" vid="PSA 52:6">woakoe ahagblɔ be,<verse eid="PSA 52:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 52:7"/>“Kpɔ ɖa, ŋutsu si metsɔ Mawu wɔ eƒe mɔ sesẽ o,</para>
  <para style="q2" vid="PSA 52:7">ke boŋ wòtsɔ eƒe dzi ɖo eƒe kesinɔnu gbogboawo ŋu,</para>
  <para style="q2" vid="PSA 52:7">eye wòkpɔ ŋusẽ hegblẽ ame bubuwo dome lae nye esi!”<verse eid="PSA 52:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 52:8"/>Ke nye la, mele abe amiti si le tsetsem le Mawu ƒe aƒe me la ene.</para>
  <para style="q2" vid="PSA 52:8">Meɖo dzi ɖe Mawu ƒe lɔlɔ̃ si meʋãna o</para>
  <para style="q2" vid="PSA 52:8">la ŋu tso mavɔ me yi ɖe mavɔ me.<verse eid="PSA 52:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 52:9"/>Makafu wò tegbee le nu si nèwɔ la ta;</para>
  <para style="q2" vid="PSA 52:9">matsɔ nye mɔkpɔkpɔ ade wò ŋkɔ me,</para>
  <para style="q1" vid="PSA 52:9">elabena wò ŋkɔ nyo.</para>
  <para style="q2" vid="PSA 52:9">Makafu wò le wò ame kɔkɔewo ŋkume.<verse eid="PSA 52:9"/></para>
  <chapter eid="PSA 52"/>
  <chapter number="53" style="c" sid="PSA 53"/>
  <para style="cl">Psalmo 53</para>
  <para style="d">David ƒe ha na hɛnɔ la. Woadzii ɖe nublanuigbe me.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 53:1"/>Bometsila gblɔ le eƒe dzi me be,</para>
  <para style="q2" vid="PSA 53:1">“Mawu aɖeke meli o.”</para>
  <para style="q1" vid="PSA 53:1">Wonye ame baɖawo, woƒe mɔwo hã nye nu tovowo,</para>
  <para style="q2" vid="PSA 53:1">ame aɖeke meli si wɔa nu nyui o.<verse eid="PSA 53:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 53:2"/>Mawu lé ŋku ɖe amegbetɔviwo ŋu tso dziƒo,</para>
  <para style="q2" vid="PSA 53:2">ne wòakpɔe ɖa be ame aɖe se nu gɔme alo di Mawu hã.<verse eid="PSA 53:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 53:3"/>Ke ame sia ame trɔ megbe dee,</para>
  <para style="q2" vid="PSA 53:3">wo katã tim wɔ nu tovo;</para>
  <para style="q1" vid="PSA 53:3">ame ɖeka hɔ̃ɔ hã meli si wɔa nu nyui o,</para>
  <para style="q2" vid="PSA 53:3">ɖeka pɛ hã meli o.<verse eid="PSA 53:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 53:4"/>Ɖe ame vɔ̃ɖiwo,</para>
  <para style="q2" vid="PSA 53:4">ame siwo vuvu nye dukɔ abe ale si woɖua aboloe ene,</para>
  <para style="q1" vid="PSA 53:4">eye womeyɔa Mawu o la</para>
  <para style="q2" vid="PSA 53:4">ava srɔ̃ nu gbe aɖe gbea?<verse eid="PSA 53:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 53:5"/>Woawoe ma ŋɔdzi lé, evɔ ŋɔdzinu aɖeke meli hafi o.</para>
  <para style="q2" vid="PSA 53:5">Mawu gbã ƒu ɖe lãme na ame siwo tso ɖe mia ŋu la;</para>
  <para style="q2" vid="PSA 53:5">ena ŋukpe lé wo, elabena Mawu gbe wo.<verse eid="PSA 53:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 53:6"/>O! Xɔname neva tso Zion na Israel!</para>
  <para style="q2" vid="PSA 53:6">Ne Mawu gaɖo eƒe dukɔ ƒe nunyonamewo te la,</para>
  <para style="q2" vid="PSA 53:6">Yakob netso aseye, eye Israel nekpɔ dzidzɔ!<verse eid="PSA 53:6"/></para>
  <chapter eid="PSA 53"/>
  <chapter number="54" style="c" sid="PSA 54"/>
  <para style="cl">Psalmo 54</para>
  <para style="d">David ƒe ha na hɛnɔ la. Woadzii ɖe kasaŋku ŋu. David kpa ha sia esi Zifitɔwo yi Saul gbɔ gblɔ nɛ be, “Ɖe David meva ɣla ɖe mía dome oa?”</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 54:1"/>Ɖem, O! Mawu, ɖem kple wò ŋkɔ,</para>
  <para style="q2" vid="PSA 54:1">tsɔ wò ŋusẽ tso afia nam.<verse eid="PSA 54:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 54:2"/>O! Mawu, se nye gbedodoɖa,</para>
  <para style="q2" vid="PSA 54:2">eye nàƒu to anyi ɖe nye numenyawo ŋu.<verse eid="PSA 54:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 54:3"/>Amedzrowo tso ɖe ŋunye,</para>
  <para style="q2" vid="PSA 54:3">ŋutasẽlawo ti nye agbe yome,</para>
  <para style="q2" vid="PSA 54:3">ame siwo mebua Mawu ɖe naneke me o. <char style="qs">Sela</char><verse eid="PSA 54:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 54:4"/>Mawu nye nye xɔnametɔ vavã,</para>
  <para style="q2" vid="PSA 54:4">Aƒetɔ lae nye ame si lém ɖe asi.<verse eid="PSA 54:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 54:5"/>Vɔ̃ negbugbɔ va ame siwo le ŋunye gblẽm la dzi,</para>
  <para style="q2" vid="PSA 54:5">tsrɔ̃ wo le wò nuteƒewɔwɔ ta.<verse eid="PSA 54:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 54:6"/>Masa lɔlɔ̃nuvɔsa na wò,</para>
  <para style="q2" vid="PSA 54:6">O! Yehowa, makafu wò ŋkɔ, elabena enyo.<verse eid="PSA 54:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 54:7"/>Eɖem tso nye xaxawo katã me,</para>
  <para style="q2" vid="PSA 54:7">eye nye ŋkuwo kpɔ ale si woɖu nye futɔwo dzii.<verse eid="PSA 54:7"/></para>
  <chapter eid="PSA 54"/>
  <chapter number="55" style="c" sid="PSA 55"/>
  <para style="cl">Psalmo 55</para>
  <para style="d">David ƒe nufiameha na hɛnɔ la. Woadzii ɖe kasaŋku ŋu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 55:1"/>O! Mawu, ɖo to nye gbedodoɖa,</para>
  <para style="q2" vid="PSA 55:1">mègado toku nye kokoƒoƒo o.<verse eid="PSA 55:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 55:2"/>Ɖo tom, eye nàtɔ nam.</para>
  <para style="q1" vid="PSA 55:2">Nye tamesusuwo ɖea fu nam, eye metɔtɔna,<verse eid="PSA 55:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 55:3"/>ne mese futɔ la ƒe gbe,</para>
  <para style="q2" vid="PSA 55:3">alo ne ame vɔ̃ɖi la tro ŋku ɖem.</para>
  <para style="q1" vid="PSA 55:3">Elabena wohe fukpekpe va dzinye,</para>
  <para style="q2" vid="PSA 55:3">eye wogblɔa nya vɔ̃wo ɖe ŋunye le woƒe dɔmedzoe me.<verse eid="PSA 55:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 55:4"/>Nye dzi le nu xam vevie le menye;</para>
  <para style="q2" vid="PSA 55:4">ku ƒe ŋɔdzi ɖe to ɖem.<verse eid="PSA 55:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 55:5"/>Vɔvɔ̃ kple dzodzo nyanyanya lém,</para>
  <para style="q2" vid="PSA 55:5">eye ŋɔdzi gbagba blam.<verse eid="PSA 55:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 55:6"/>Megblɔ be,</para>
  <para style="q2" vid="PSA 55:6">“O! Ɖe wònye aʋala le asinye abe ahɔnɛ ene la,</para>
  <para style="q2" vid="PSA 55:6">anye ne madzo aɖadzudzɔ le teƒe aɖe.<verse eid="PSA 55:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 55:7"/>Madzo ayi keke gbegbe,</para>
  <para style="q2" vid="PSA 55:7">aɖanɔ afi ma. <char style="qs">Sela</char><verse eid="PSA 55:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 55:8"/>Maɖe abla ayi ɖe nye bebeƒe,</para>
  <para style="q2" vid="PSA 55:8">ate ɖe aga tso ya sesẽwo kple ahom gbɔ.”<verse eid="PSA 55:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 55:9"/>O! Aƒetɔ, tɔtɔ ame vɔ̃ɖiwo,</para>
  <para style="q2" vid="PSA 55:9">tɔtɔ woƒe nyagbɔgblɔwo, elabena mekpɔ ŋutasesẽ</para>
  <para style="q2" vid="PSA 55:9">kple ʋunyaʋunya le dua me.<verse eid="PSA 55:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 55:10"/>Zã kple keli wole tatam le eƒe gliwo dzi,</para>
  <para style="q2" vid="PSA 55:10">eye nugbeɖoɖo kple hiãkame le eme.<verse eid="PSA 55:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 55:11"/>Ŋusẽ siwo gblẽa nu la le dɔ wɔm le dua me;</para>
  <para style="q2" vid="PSA 55:11">ŋutasesẽ kple alakpadada medzona le eƒe ablɔ dzi o.<verse eid="PSA 55:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 55:12"/>Ne futɔe le dzu yem la, mate ŋu atsɔe;</para>
  <para style="q2" vid="PSA 55:12">ne ketɔe kɔ eɖokui ɖe dzi ɖe ŋunye la, mate ŋu aɣla ɖee,<verse eid="PSA 55:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 55:13"/>gake wò, ŋutsu abe nye ene,</para>
  <para style="q2" vid="PSA 55:13">xɔ̃nye vevi kple nye kpeɖeŋutɔ,<verse eid="PSA 55:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 55:14"/>nye kple ame si dome habɔbɔ vivi aɖe nɔ,</para>
  <para style="q2" vid="PSA 55:14">eye míezɔna aduadu le amehawo dome le gbedoxɔ me lae.<verse eid="PSA 55:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 55:15"/>Ku neƒo ɖe nye ketɔwo dzi kpoyi;</para>
  <para style="q2" vid="PSA 55:15">woneyi yɔdo me agbagbe,</para>
  <para style="q2" vid="PSA 55:15">elabena nu vɔ̃ɖi wɔwɔ xɔ aƒe ɖe wo dome.<verse eid="PSA 55:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 55:16"/>Ke meyɔ Mawu,</para>
  <para style="q2" vid="PSA 55:16">eye wòtɔ nam, heɖem.<verse eid="PSA 55:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 55:17"/>Fiẽ, ŋdi kple ŋdɔ</para>
  <para style="q2" vid="PSA 55:17">medo ɣli le xaxame, eye wòse nye gbe.<verse eid="PSA 55:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 55:18"/>Eɖem tso aʋa si le edzi yim kplim la me le dedinɔnɔ me,</para>
  <para style="q2" vid="PSA 55:18">togbɔ be ame geɖewo tso ɖe ŋutinye hã.<verse eid="PSA 55:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 55:19"/>Mawu, ame si le fiazikpui dzi tegbee la asee,</para>
  <para style="q2" vid="PSA 55:19">eye wòabɔbɔ wo ɖe anyi, <char style="qs">Sela</char></para>
  <para style="q1" vid="PSA 55:19">ame siwo gbe tɔtrɔ le woƒe mɔwo dzi,</para>
  <para style="q2" vid="PSA 55:19">eye womevɔ̃a Mawu o lae.<verse eid="PSA 55:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 55:20"/>Nye zɔhɛ wɔ avu</para>
  <para style="q2" vid="PSA 55:20">kple exɔlɔ̃wo hegblẽ kɔ ɖo na eƒe nubabla.<verse eid="PSA 55:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 55:21"/>Eƒe nuƒo zrɔ̃ dredredre abe notsi kpekpe ene,</para>
  <para style="q2" vid="PSA 55:21">evɔ aʋawɔwɔ le eƒe dzi me;</para>
  <para style="q1" vid="PSA 55:21">eƒe numenyawo zrɔ̃ wu ami,</para>
  <para style="q2" vid="PSA 55:21">gake wonye yi siwo woɖe le aku me lé ɖe asi.<verse eid="PSA 55:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 55:22"/>Tsɔ wò dzimaɖiwo da ɖe Yehowa dzi, eye akpɔ tawò,</para>
  <para style="q2" vid="PSA 55:22">elabena mana ame dzɔdzɔe la nadze anyi akpɔ gbeɖe o.<verse eid="PSA 55:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 55:23"/>O! Mawu, ke wò la,</para>
  <para style="q2" vid="PSA 55:23">àhe ame vɔ̃ɖiwo ayi yɔdo me.</para>
  <para style="q1" vid="PSA 55:23">Ŋutsu hlɔ̃dolawo kple ameblelawo manɔ agbe</para>
  <para style="q2" vid="PSA 55:23">wòade agbemeŋkeke siwo nèna wo la ƒe afã hã o.</para>
  <para style="b" vid="PSA 55:23"/>
  <para style="q1" vid="PSA 55:23">Ke nye la, wò ko dzi meka ɖo.<verse eid="PSA 55:23"/></para>
  <chapter eid="PSA 55"/>
  <chapter number="56" style="c" sid="PSA 56"/>
  <para style="cl">Psalmo 56</para>
  <para style="d">David ƒe nufiameha na hɛnɔ la. Woadzii ɖe “Ahɔnɛ si dzo ɖe logoti dzi le didiƒe ke” la ƒe gbeɖiɖi nu. Ekpa ha sia esi Filistitɔwo lée le Gat.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 56:1"/>Kpɔ nye nublanui, O! Mawu,</para>
  <para style="q2" vid="PSA 56:1">elabena amegbetɔwo ti yonyeme kple ŋkubiã;</para>
  <para style="q2" vid="PSA 56:1">ŋkeke blibo la wole yonyeme kutɔkutɔe.<verse eid="PSA 56:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 56:2"/>Ame siwo le ŋunye gblẽm la ti yonyeme ŋkeke blibo la,</para>
  <para style="q2" vid="PSA 56:2">eye wo dometɔ geɖewo tso ɖe ŋunye kple dada.<verse eid="PSA 56:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 56:3"/>Maka ɖe dziwò ne vɔvɔ̃ ɖom.<verse eid="PSA 56:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 56:4"/>Wò Mawu si ƒe nya mekafu,</para>
  <para style="q1" vid="PSA 56:4">Mawu si dzi meka ɖo; nyemavɔ̃ akpɔ o.</para>
  <para style="q2" vid="PSA 56:4">Nu ka amegbetɔ, ŋutilã kple ʋu, awɔm ma?<verse eid="PSA 56:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 56:5"/>Ŋkeke blibo la wotrɔa gbo nye nyawo,</para>
  <para style="q2" vid="PSA 56:5">ɣe sia ɣi wole nugbe ɖom be woawɔ nuvevim.<verse eid="PSA 56:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 56:6"/>Woɖo babla, wole ŋu tsam,</para>
  <para style="q2" vid="PSA 56:6">hele ŋku lém ɖe nye afɔɖeɖewo ŋu,</para>
  <para style="q2" vid="PSA 56:6">eye wotsi dzi ɖe nye agbetsɔtsrɔ̃ ŋuti.<verse eid="PSA 56:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 56:7"/>Ɖe woƒe vɔ̃ɖinyenye ta la, megana mɔ woasi o;</para>
  <para style="q2" vid="PSA 56:7">O! Mawu, he dukɔwo ƒu anyi le wò dɔmedzoe me.<verse eid="PSA 56:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 56:8"/>Ŋlɔ nye konyifafa da ɖi;</para>
  <para style="q2" vid="PSA 56:8">lé nye aɖatsiwo ɖe agbalẽ dzi;</para>
  <para style="q2" vid="PSA 56:8">ɖe womele wò nyaŋlɔɖiwo me xoxo oa?<verse eid="PSA 56:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 56:9"/>Ekema nye futɔwo atrɔ adzo, ne meyɔ wò be nàxɔ nam.</para>
  <para style="q2" vid="PSA 56:9">To esia me la, manya be Mawu nye tɔnye.<verse eid="PSA 56:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 56:10"/>Mawu, ame si ƒe nya mekafu,</para>
  <para style="q2" vid="PSA 56:10">Yehowa ame si ƒe nya mekafu.<verse eid="PSA 56:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 56:11"/>Mawu, ame si dzi meka ɖo; nyemavɔ̃ o.</para>
  <para style="q2" vid="PSA 56:11">Nu ka amegbetɔ ate ŋu awɔm?<verse eid="PSA 56:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 56:12"/>O! Mawu, meɖe adzɔgbe na wò,</para>
  <para style="q2" vid="PSA 56:12">eya ta maxe adzɔgbeɖefe na wò.<verse eid="PSA 56:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 56:13"/>Elabena èɖem tso ku me,</para>
  <para style="q2" vid="PSA 56:13">eye nèna be nye afɔwo hã magaɖiɖi o,</para>
  <para style="q1" vid="PSA 56:13">ne mate ŋu azɔ le Mawu ŋkume</para>
  <para style="q2" vid="PSA 56:13">le agbagbeawo ƒe anyigba dzi.<verse eid="PSA 56:13"/></para>
  <chapter eid="PSA 56"/>
  <chapter number="57" style="c" sid="PSA 57"/>
  <para style="cl">Psalmo 57</para>
  <para style="d">David ƒe ha na hɛnɔ la. Woadzii ɖe “Mègagblẽ nu o” ƒe gbeɖiɖi nu. Ekpa ha sia esi wòsi le Saul nu yi ɖabe ɖe agado aɖe me.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 57:1"/>Kpɔ nye nublanui, O! Mawu, kpɔ nye nublanui,</para>
  <para style="q2" vid="PSA 57:1">elabena wò mee nye luʋɔ kpɔ sitsoƒe le.</para>
  <para style="q1" vid="PSA 57:1">Wò aʋala ƒe vɔvɔli te mabe ɖo va se ɖe</para>
  <para style="q2" vid="PSA 57:1">esime gbegblẽ la nu nava yi.<verse eid="PSA 57:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 57:2"/>Mawu, Dziƒoʋĩtɔ lae medo ɣli na,</para>
  <para style="q2" vid="PSA 57:2">Mawu si wɔa ɖoɖo si wòwɔ ɖe ŋunye la dzi.<verse eid="PSA 57:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 57:3"/>Edɔ xɔnametɔ tso dziƒo, eye wòxɔ nam heka mo na</para>
  <para style="q2" vid="PSA 57:3">ame siwo le yonyeme tim kutɔkutɔe. <char style="qs">Sela</char></para>
  <para style="q2" vid="PSA 57:3">Mawu dɔ eƒe lɔlɔ̃ kple eƒe nuteƒewɔwɔ ɖa.<verse eid="PSA 57:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 57:4"/>Mele dzatawo dome,</para>
  <para style="q2" vid="PSA 57:4">memlɔ lã lénuwo dome,</para>
  <para style="q1" vid="PSA 57:4">amegbetɔ siwo ƒe aɖuwo nye akplɔwo kple aŋutrɔwo,</para>
  <para style="q2" vid="PSA 57:4">eye woƒe aɖewo nye yi ɖaɖɛwo.<verse eid="PSA 57:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 57:5"/>Medo wò ɖe dzi, O Mawu, gbɔ dziƒowo ŋu,</para>
  <para style="q2" vid="PSA 57:5">na wò ŋutikɔkɔe naklẽ ɖe anyigba blibo la dzi.<verse eid="PSA 57:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 57:6"/>Woɖo ɖɔ ɖi na nye afɔ,</para>
  <para style="q2" vid="PSA 57:6">ena mete ɖe anyi kple nuxaxa.</para>
  <para style="q1" vid="PSA 57:6">Woɖe ʋe ɖe mɔ dzi nam,</para>
  <para style="q2" vid="PSA 57:6">gake woawo ŋutɔ ge dze eme. <char style="qs">Sela</char><verse eid="PSA 57:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 57:7"/>Nye dzi li ke sesĩe, O Mawu,</para>
  <para style="q2" vid="PSA 57:7">nye dzi li ke sesĩe,</para>
  <para style="q2" vid="PSA 57:7">eya ta madzi ha aƒo saŋku.<verse eid="PSA 57:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 57:8"/>Nyɔ, nye luʋɔ!</para>
  <para style="q2" vid="PSA 57:8">Nyɔ, kasaŋku kple gasaŋku!</para>
  <para style="q2" vid="PSA 57:8">Mana fɔŋli nanyɔ!<verse eid="PSA 57:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 57:9"/>O! Aƒetɔ, makafu wò le dukɔwo dome,</para>
  <para style="q2" vid="PSA 57:9">eye madzi ha na wò le dukɔwo dome,<verse eid="PSA 57:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 57:10"/>elabena wò lɔlɔ̃ keke ta,</para>
  <para style="q2" vid="PSA 57:10">yi ɖatɔ dziƒo ke, eye wò nuteƒewɔwɔ yi ɖatɔ dziŋgɔli.<verse eid="PSA 57:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 57:11"/>Medo wò ɖe dzi, O Mawu, gbɔ dziƒowo ŋu,</para>
  <para style="q2" vid="PSA 57:11">na wò ŋutikɔkɔe naklẽ ɖe anyigba blibo la dzi.<verse eid="PSA 57:11"/></para>
  <chapter eid="PSA 57"/>
  <chapter number="58" style="c" sid="PSA 58"/>
  <para style="cl">Psalmo 58</para>
  <para style="d">David ƒe nufiameha na hɛnɔ la. Woadzii ɖe “Mègagblẽ nu o” ƒe gbeɖiɖi nu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 58:1"/>Ɖe mi dziɖulawo mietoa nyateƒea?</para>
  <para style="q2" vid="PSA 58:1">Ɖe mietsoa afia dzɔdzɔe na amewoa?<verse eid="PSA 58:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 58:2"/>Ao, nu madzɔmadzɔ wɔwɔ boŋ míeɖo ɖe miaƒe dziwo me,</para>
  <para style="q2" vid="PSA 58:2">eye míaƒe asiwo wɔa ŋutasẽnu le anyigba dzi.<verse eid="PSA 58:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 58:3"/>Ame vɔ̃ɖiwo tra mɔ tso keke woƒe vidzĩ me ke,</para>
  <para style="q2" vid="PSA 58:3">eye tso wo dadawo ƒe dɔ me ke,</para>
  <para style="q2" vid="PSA 58:3">wodze aglã, hedaa alakpa.<verse eid="PSA 58:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 58:4"/>Woƒe aɖi le abe da ƒe aɖi ene.</para>
  <para style="q2" vid="PSA 58:4">Egale abe ƒli si xe nu eƒe to me ene,<verse eid="PSA 58:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 58:5"/>eye ne gbesala ɖe gbe nɛ la, mewɔa edzi o;</para>
  <para style="q2" vid="PSA 58:5">aleke gbegbee dzotɔ la bi ɖe gbesasa mee hã la, mesenɛ o.<verse eid="PSA 58:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 58:6"/>O, Mawu, ŋe aɖu ɖe nu me na wo,</para>
  <para style="q2" vid="PSA 58:6">O, Yehowa, tu tsyo na dzata la!<verse eid="PSA 58:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 58:7"/>Wo nu neyi abe tsi si si va yi la ene.</para>
  <para style="q2" vid="PSA 58:7">Ne wovu woƒe dawo me la,</para>
  <para style="q2" vid="PSA 58:7">woƒe aŋutrɔwo nu netsi.<verse eid="PSA 58:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 58:8"/>Wole abe abɔbɔ si va yi, eye etoƒe bu la ene.</para>
  <para style="q2" vid="PSA 58:8">Wonenɔ abe fu gege ene, be womakpɔ ɣe o.<verse eid="PSA 58:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 58:9"/>Hafi miaƒe zewo nase ŋutidzo si wodo ɖe wo te ŋkɔ,</para>
  <para style="q2" vid="PSA 58:9">eɖanye mumua, alo ƒuƒua o,</para>
  <para style="q2" vid="PSA 58:9">woakplɔ ame vɔ̃ɖi la adzoe.<verse eid="PSA 58:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 58:10"/>Ame dzɔdzɔewo akpɔ dzidzɔ,</para>
  <para style="q2" vid="PSA 58:10">ne wole hlɔ̃ biam ɖe wo nu,</para>
  <para style="q1" vid="PSA 58:10">eye wole woƒe afɔwo klɔm ɖe</para>
  <para style="q2" vid="PSA 58:10">ame vɔ̃ɖiwo ƒe ʋu me.<verse eid="PSA 58:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 58:11"/>Ekema amewo agblɔ be,</para>
  <para style="q2" vid="PSA 58:11">“Vavã, wogale eteƒe ɖom na ame dzɔdzɔe,</para>
  <para style="q2" vid="PSA 58:11">eye Mawu aɖe li si drɔ̃a ʋɔnu anyigba vavã.”<verse eid="PSA 58:11"/></para>
  <chapter eid="PSA 58"/>
  <chapter number="59" style="c" sid="PSA 59"/>
  <para style="cl">Psalmo 59</para>
  <para style="d">David ƒe nufiameha na hɛnɔ la. Woadzii ɖe “Mègagblẽ nu o” ƒe gbeɖiɖi nu. Ekpa ha sia esi Saul dɔ amewo be woadzɔ eƒe aƒe ŋu, eye ne edo go la, woawui.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 59:1"/>O! Mawu, ɖem tso nye futɔwo ƒe asi me;</para>
  <para style="q2" vid="PSA 59:1">kpɔ tanye le ame siwo tso ɖe ŋutinye la ta.<verse eid="PSA 59:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 59:2"/>Ɖem tso nu vlo wɔlawo ƒe asi me</para>
  <para style="q2" vid="PSA 59:2">eye nàxɔm tso hlɔ̃dolawo ƒe asi me.<verse eid="PSA 59:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 59:3"/>Kpɔ ale si wode xa ɖi nam lae ɖa!</para>
  <para style="q2" vid="PSA 59:3">Ame nyanyrawo ɖo nugbe ɖe ŋunye,</para>
  <para style="q2" vid="PSA 59:3">evɔ la, O Yehowa, nyemedze agɔ,</para>
  <para style="q2" vid="PSA 59:3">alo wɔ nu vɔ̃ aɖeke o.<verse eid="PSA 59:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 59:4"/>Nyemeda vo aɖeke o,</para>
  <para style="q2" vid="PSA 59:4">evɔ wole klalo be woadze dzinye.</para>
  <para style="q2" vid="PSA 59:4">Tso, nàxɔ nam; kpɔ xaxa si me mele la ɖa!<verse eid="PSA 59:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 59:5"/>O! Yehowa, Mawu Ŋusẽkatãtɔ,</para>
  <para style="q2" vid="PSA 59:5">Israel ƒe Mawu, nyɔ nàhe to na dukɔwo,</para>
  <para style="q2" vid="PSA 59:5">mègakpɔ nublanui na ametatrɔla vɔ̃ɖi siawo o. <char style="qs">Sela</char><verse eid="PSA 59:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 59:6"/>Wotrɔ gbɔ le fiẽ me le gbe tem abe avuwo ene,</para>
  <para style="q2" vid="PSA 59:6">eye wole tsaglãla tsam le dua me.<verse eid="PSA 59:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 59:7"/>Kpɔ nu si wotu tso woƒe nu me la ɖa,</para>
  <para style="q1" vid="PSA 59:7">wotu nyawo tso woƒe nuyiwo me le gbɔgblɔm be,</para>
  <para style="q2" vid="PSA 59:7">“Ame ka ate ŋu aɖo to mí?”<verse eid="PSA 59:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 59:8"/>O! Yehowa, wò koe le wo kom,</para>
  <para style="q2" vid="PSA 59:8">èɖe alɔme le dukɔ mawo katã ŋu.<verse eid="PSA 59:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 59:9"/>O! Nye ŋusẽ, mele nuwò kpɔm.</para>
  <para style="q2" vid="PSA 59:9">O! Mawu, wòe nye nye mɔ sesẽ,<verse eid="PSA 59:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="PSA 59:10"/>nye Mawu lɔlɔ̃tɔ.</para>
  <para style="b" vid="PSA 59:10"/>
  <para style="q1" vid="PSA 59:10">Mawu adze ŋgɔ nam, eye ana makpɔ dziɖuɖu ƒe dzidzɔ</para>
  <para style="q2" vid="PSA 59:10">ɖe nye ketɔwo dzi.<verse eid="PSA 59:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 59:11"/>Gake mègawu wo o,</para>
  <para style="q2" vid="PSA 59:11">O! Aƒetɔ, míaƒe akpoxɔnu,</para>
  <para style="q2" vid="PSA 59:11">ne menye nenema o la, nye amewo aŋlɔ be.</para>
  <para style="q1" vid="PSA 59:11">Le wò ŋusẽ me, na woatsa tsaglãla,</para>
  <para style="q2" vid="PSA 59:11">eye nàhe wo aƒu anyi.<verse eid="PSA 59:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 59:12"/>Nya sia nya si doa le wo nu la nye nu vɔ̃,</para>
  <para style="q2" vid="PSA 59:12">woƒe dada nazu abe mɔ ene aɖe wo,</para>
  <para style="q2" vid="PSA 59:12">Le fiƒodenya kple alakpanya siwo wogblɔ ta la,<verse eid="PSA 59:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="PSA 59:13"/>fia wo kple dziku,</para>
  <para style="q2" vid="PSA 59:13">fia wo va se ɖe esime womaganɔ anyi o.</para>
  <para style="q1" vid="PSA 59:13">Ekema woanya va se ɖe anyigba la ƒe mlɔenu ke, be</para>
  <para style="q2" vid="PSA 59:13">Mawue nye fia ɖe Yakob dzi. <char style="qs">Sela</char><verse eid="PSA 59:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 59:14"/>Wotrɔ gbɔ le fiẽ me, le gbe tem abe avuwo ene,</para>
  <para style="q2" vid="PSA 59:14">eye wole tsaglãla tsam le dua me.<verse eid="PSA 59:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 59:15"/>Wole tsatsam le nuɖuɖu dim,</para>
  <para style="q2" vid="PSA 59:15">eye ne womeɖi ƒo o la, wonɔa wòwóm.<verse eid="PSA 59:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 59:16"/>Ke nye la, madzi wò ŋusẽ ƒe ha,</para>
  <para style="q2" vid="PSA 59:16">eye le ŋdi me la, madzi ha le wò lɔlɔ̃ ŋuti,</para>
  <para style="q1" vid="PSA 59:16">elabena wòe nye nye mɔ sesẽ,</para>
  <para style="q2" vid="PSA 59:16">kple nye sitsoƒe le xaxaɣiwo.<verse eid="PSA 59:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 59:17"/>O! Nye ŋusẽ, mele kafukafuha dzim na wò.</para>
  <para style="q2" vid="PSA 59:17">O! Mawu, wòe nye nye mɔ sesẽ kple nye Mawu si dzi meka ɖo.<verse eid="PSA 59:17"/></para>
  <chapter eid="PSA 59"/>
  <chapter number="60" style="c" sid="PSA 60"/>
  <para style="cl">Psalmo 60</para>
  <para style="d">David ƒe ha na hɛnɔ la. Woadzii ɖe “Nubabla ƒe Dzogbenya” ƒe gbeɖiɖi nu. David kpa nufiameha sia esi wòwɔ aʋa kple Aram Naharaim kple Aram Zobah, kpe ɖe esi Yoab trɔ gbɔ tso aʋa le Dze Balime, afi si wòwu Edomtɔ akpe wuieve (12,000) le la ŋu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 60:1"/>O! Mawu, ègbe mí, èti kpo dze mía dzi,</para>
  <para style="q2" vid="PSA 60:1">eye nèdo dɔmedzoe ɖe mía ŋu,</para>
  <para style="q2" vid="PSA 60:1">eya ta gbugbɔ mí ɖo te!<verse eid="PSA 60:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 60:2"/>Èʋuʋu anyigba la, eye nèfee wòle nuvo,</para>
  <para style="q2" vid="PSA 60:2">eya ta gatre eƒe gbagbãƒeawo, elabena ele ʋuʋum.<verse eid="PSA 60:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 60:3"/>Èna ɣeyiɣi sesẽwo tu wò dukɔ la,</para>
  <para style="q2" vid="PSA 60:3">eye nèna wain mí míeno mu hele yiyim sɔgɔsɔgɔsɔgɔ.<verse eid="PSA 60:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 60:4"/>Ke hena ame siwo vɔ̃a wò la,</para>
  <para style="q2" vid="PSA 60:4">èkɔ aflaga dzi be wòanye akpoxɔnu ɖe</para>
  <para style="q2" vid="PSA 60:4">woƒe aŋutrɔ ŋu. <char style="qs">Sela</char><verse eid="PSA 60:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 60:5"/>Xɔ na mí, eye nàɖe mí kple wò nuɖusi,</para>
  <para style="q2" vid="PSA 60:5">be ame siwo nèlɔ̃ la nakpɔ xɔxɔ.<verse eid="PSA 60:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 60:6"/>Mawu ƒo nu tso eƒe kɔkɔeƒe la be;</para>
  <para style="q2" vid="PSA 60:6">“Le dziɖuɖu me, mama Sekem,</para>
  <para style="q2" vid="PSA 60:6">eye madzidze Sukɔt Balime hã.<verse eid="PSA 60:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 60:7"/>Gilead nye tɔnye, Manase hã tɔnyee.</para>
  <para style="q2" vid="PSA 60:7">Nye gakukue nye Efraim,</para>
  <para style="q2" vid="PSA 60:7">eye Yuda nye nye fiatikplɔ.<verse eid="PSA 60:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 60:8"/>Moab nye nye asiklɔgba,</para>
  <para style="q2" vid="PSA 60:8">meɖe nye tokota ƒu gbe ɖe Edom dzi,</para>
  <para style="q2" vid="PSA 60:8">eye medo dziɖuɖuɣli ɖe Filistia ta.”<verse eid="PSA 60:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 60:9"/>Ame ka akplɔm ayi du si ŋu</para>
  <para style="q2" vid="PSA 60:9">woɖo gli sesẽ ƒo xlãe la me?</para>
  <para style="q2" vid="PSA 60:9">Ame ka akplɔm ayi Edom?<verse eid="PSA 60:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 60:10"/>O! Mawu, ɖe menye wòe o la,</para>
  <para style="q2" vid="PSA 60:10">wò ame si gbe mí, eye mègadona</para>
  <para style="q2" vid="PSA 60:10">kple míaƒe aʋakɔwo lae oa?<verse eid="PSA 60:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 60:11"/>Kpe ɖe mía ŋu, ɖe míaƒe futɔwo ŋuti,</para>
  <para style="q2" vid="PSA 60:11">elabena amegbetɔ ƒe kpekpeɖeŋu mele ɖeke me o.<verse eid="PSA 60:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 60:12"/>To Mawu dzi, míaɖu dzi,</para>
  <para style="q2" vid="PSA 60:12">eye míafanya míaƒe futɔwo ɖe anyigba.<verse eid="PSA 60:12"/></para>
  <chapter eid="PSA 60"/>
  <chapter number="61" style="c" sid="PSA 61"/>
  <para style="cl">Psalmo 61</para>
  <para style="d">David ƒe ha na hɛnɔ la. Woadzii ɖe kasaŋku ŋu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 61:1"/>Se nye ɣlidodo, O Mawu,</para>
  <para style="q2" vid="PSA 61:1">eye nàlé to ɖe nye gbedodoɖa ŋu.<verse eid="PSA 61:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 61:2"/>Meyɔ wò tso anyigba ƒe mlɔenu,</para>
  <para style="q2" vid="PSA 61:2">meyɔ wò, esi nu te nye dzi ŋu belibelibeli;</para>
  <para style="q2" vid="PSA 61:2">azɔ kplɔm yi ɖe agakpe si kɔ wum la dzi,<verse eid="PSA 61:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 61:3"/>elabena wòe nye nye sitsoƒe</para>
  <para style="q2" vid="PSA 61:3">kple mɔ sesẽ, le futɔ la ta.<verse eid="PSA 61:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 61:4"/>Medi vevie be manɔ wò agbadɔ me tegbee,</para>
  <para style="q2" vid="PSA 61:4">eye mabe ɖe wò aʋala ƒe fafaƒe. <char style="qs">Sela</char><verse eid="PSA 61:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 61:5"/>O! Mawu, èse nye adzɔgbeɖeɖewo,</para>
  <para style="q2" vid="PSA 61:5">eye nètsɔ ame siwo vɔ̃a wò ŋkɔ la ƒe domenyinu nam.<verse eid="PSA 61:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 61:6"/>Dzi fia la ƒe agbemeŋkekewo ɖe edzi nɛ,</para>
  <para style="q2" vid="PSA 61:6">eƒe ƒewo nasɔ gbɔ be wòakpɔ dzidzime geɖewo.<verse eid="PSA 61:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 61:7"/>Neɖu fia le Mawu ŋkume tegbee,</para>
  <para style="q2" vid="PSA 61:7">eye na wò lɔlɔ̃ kple nuteƒewɔwɔ nakpɔ eta.<verse eid="PSA 61:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 61:8"/>Ekema madzi kafukafuha na wò ŋkɔ tegbee,</para>
  <para style="q2" vid="PSA 61:8">eye maxe nye adzɔgbeɖefewo gbe sia gbe.<verse eid="PSA 61:8"/></para>
  <chapter eid="PSA 61"/>
  <chapter number="62" style="c" sid="PSA 62"/>
  <para style="cl">Psalmo 62</para>
  <para style="d">David ƒe ha na Hɛnɔ Yedutun.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 62:1"/>Mawu me ko nye luʋɔ kpɔ gbɔɖeme le,</para>
  <para style="q2" vid="PSA 62:1">eye eya ko gbɔ nye xɔxɔ tsona.<verse eid="PSA 62:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 62:2"/>Eya koe nye nye agakpe,</para>
  <para style="q2" vid="PSA 62:2">nye xɔxɔ kple nye mɔ sesẽ, eya ta nyemaʋã akpɔ gbeɖe o.<verse eid="PSA 62:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 62:3"/>Va se ɖe ɣe ka ɣi nànɔ ame ɖeka ƒoƒo dzi?</para>
  <para style="q2" vid="PSA 62:3">Ɖe mi katã mialé ame si le abe gli gbagbã</para>
  <para style="q2" vid="PSA 62:3">kple kpɔ si le mumum ene la aƒu anyia?<verse eid="PSA 62:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 62:4"/>Woɖoe vavã be yewoatutui tso</para>
  <para style="q2" vid="PSA 62:4">eƒe nɔƒe kɔkɔ la, elabena wolɔ̃a alakpadada.</para>
  <para style="q1" vid="PSA 62:4">Wotsɔa woƒe nuwo gblɔa yayranyawoe,</para>
  <para style="q2" vid="PSA 62:4">ke fiƒode le woƒe dzi me. <char style="qs">Sela</char><verse eid="PSA 62:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 62:5"/>O! Nye luʋɔ, gbɔ ɖe eme le Mawu ɖeka ko me,</para>
  <para style="q2" vid="PSA 62:5">elabena eya gbɔ nye mɔkpɔkpɔ tso.<verse eid="PSA 62:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 62:6"/>Eya hɔ̃ɔ koe nye nye agakpe,</para>
  <para style="q2" vid="PSA 62:6">nye xɔxɔ kple nye mɔ sesẽ,</para>
  <para style="q2" vid="PSA 62:6">eya ta nyemaʋuʋu o.<verse eid="PSA 62:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 62:7"/>Nye xɔxɔ kple bubu ku ɖe Mawu ŋu,</para>
  <para style="q2" vid="PSA 62:7">eyae nye nye agakpe sesẽ kple nye sitsoƒe.<verse eid="PSA 62:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 62:8"/>O! Mi dukɔwo, miɖo dzi ɖe eŋu ɣe sia ɣi;</para>
  <para style="q2" vid="PSA 62:8">mitsɔ miaƒe hiahiãwo kɔ ɖe edzi,</para>
  <para style="q2" vid="PSA 62:8">elabena Mawue nye míaƒe sitsoƒe. <char style="qs">Sela</char><verse eid="PSA 62:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 62:9"/>Vavã, ƒuƒu ko ame gbɔlowo nye,</para>
  <para style="q2" vid="PSA 62:9">eye alakpa nye ame siwo nye ame ŋkutawo,</para>
  <para style="q1" vid="PSA 62:9">elabena ne woda wo le nudanu dzi la,</para>
  <para style="q2" vid="PSA 62:9">tofloko ko wonye,</para>
  <para style="q2" vid="PSA 62:9">eye wo katã ƒuƒu ko wonye.<verse eid="PSA 62:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 62:10"/>Migaɖo ŋu ɖe amebaba ŋu,</para>
  <para style="q2" vid="PSA 62:10">alo akpɔ dzidzɔ ɖe nu siwo wofi la ŋuti o.</para>
  <para style="q1" vid="PSA 62:10">Togbɔ be wò kesinɔnuwo dzi ɖe edzi hã la,</para>
  <para style="q2" vid="PSA 62:10">mègatsɔ wò dzi da ɖe wo dzi o.<verse eid="PSA 62:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 62:11"/>Mawu gblɔ nya ɖeka,</para>
  <para style="q2" vid="PSA 62:11">eye mese nu eve le eme be,</para>
  <para style="q1" vid="PSA 62:11">“Wò, O Mawu, ɖeka koe sesẽ,<verse eid="PSA 62:11"/></para>
  <para style="q2">
    <verse number="12" style="v" sid="PSA 62:12"/>eye O Aƒetɔ, wò la lɔlɔ̃ bɔ ɖe asiwò.</para>
  <para style="q1" vid="PSA 62:12">Vavã, àɖo eteƒe na ame</para>
  <para style="q2" vid="PSA 62:12">sia ame ɖe nu si wòwɔ la nu.”<verse eid="PSA 62:12"/></para>
  <chapter eid="PSA 62"/>
  <chapter number="63" style="c" sid="PSA 63"/>
  <para style="cl">Psalmo 63</para>
  <para style="d">David ƒe ha. Ekpae esi wòle Yuda gbegbe.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 63:1"/>O! Mawu, wòe nye nye Mawu,</para>
  <para style="q2" vid="PSA 63:1">mele diwòm vevie;</para>
  <para style="q1" vid="PSA 63:1">tsikɔ le nye luʋɔ wum ɖe ŋuwò,</para>
  <para style="q2" vid="PSA 63:1">nye ameti blibo la mele diwòm,</para>
  <para style="q1" vid="PSA 63:1">le kuɖiɖinyigba si ƒu kplakplakpla,</para>
  <para style="q2" vid="PSA 63:1">eye tsi aɖeke meli o la dzi.<verse eid="PSA 63:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 63:2"/>Mekpɔ wò le kɔkɔeƒe la,</para>
  <para style="q2" vid="PSA 63:2">eye mekpɔ wò ŋusẽ kple wò ŋutikɔkɔe.<verse eid="PSA 63:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 63:3"/>Esi wò lɔlɔ̃ nyo wu agbe ta la,</para>
  <para style="q2" vid="PSA 63:3">nye nuyiwo ado wò ɖe dzi.<verse eid="PSA 63:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 63:4"/>Makafu wò, zi ale si mele agbe,</para>
  <para style="q2" vid="PSA 63:4">eye mado nye asiwo ɖe dzi le wò ŋkɔ me.<verse eid="PSA 63:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 63:5"/>Nye luʋɔ aɖi ƒo abe nuɖuɖu nyuitɔ kekeakee wòɖu ene;</para>
  <para style="q2" vid="PSA 63:5">hadzidzi anɔ nu nam, eye nye nu adzi kafukafuhawo na wò.<verse eid="PSA 63:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 63:6"/>Le nye aba dzi, meɖoa ŋku dziwò,</para>
  <para style="q2" vid="PSA 63:6">mebua ŋutiwò le nye ŋunɔɣi le zã me.<verse eid="PSA 63:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 63:7"/>Esi nènye nye xɔnametɔ ta la,</para>
  <para style="q2" vid="PSA 63:7">madzi ha le wò aʋala ƒe vɔvɔli te.<verse eid="PSA 63:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 63:8"/>Nye luʋɔ ku ɖe ŋuwò goŋgoŋgoŋ,</para>
  <para style="q2" vid="PSA 63:8">eye wò ɖusibɔ lém ɖe te.<verse eid="PSA 63:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 63:9"/>Woatsrɔ̃ ame siwo le nye agbe yome tim,</para>
  <para style="q2" vid="PSA 63:9">woayi ɖe keke anyigba la ƒe tume ke.<verse eid="PSA 63:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 63:10"/>Woatsɔ wo ade asi na yi,</para>
  <para style="q2" vid="PSA 63:10">eye woazu nuɖuɖu na amegaxiwo.<verse eid="PSA 63:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 63:11"/>Ke fia la akpɔ dzidzɔ le Mawu me;</para>
  <para style="q2" vid="PSA 63:11">ame siwo katã kaa atam le Mawu ƒe ŋkɔ me la akafui,</para>
  <para style="q2" vid="PSA 63:11">ke woamia nu na alakpatɔwo.<verse eid="PSA 63:11"/></para>
  <chapter eid="PSA 63"/>
  <chapter number="64" style="c" sid="PSA 64"/>
  <para style="cl">Psalmo 64</para>
  <para style="d">David ƒe ha na hɛnɔ la.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 64:1"/>O! Mawu, ɖo tom, esi meɖe nye kuxiwo na wò;</para>
  <para style="q2" vid="PSA 64:1">kpɔ nye agbe ta tso futɔ siwo le ŋɔdzi dom nam la ƒe asi me.<verse eid="PSA 64:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 64:2"/>Ɣlam tso ame vɔ̃ɖiwo ƒe nugbeɖoɖo</para>
  <para style="q2" vid="PSA 64:2">kple ame vlo mawo ƒe howɔwɔ me.<verse eid="PSA 64:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 64:3"/>Wonyrea woƒe aɖewo abe yi ene,</para>
  <para style="q2" vid="PSA 64:3">eye wodzidzea woƒe nyawo ɖe ame dzi</para>
  <para style="q2" vid="PSA 64:3">abe aŋutrɔ siwo nu aɖi le la ene.<verse eid="PSA 64:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 64:4"/>Wodea xa hedaa aŋutrɔ ame maɖifɔ la,</para>
  <para style="q2" vid="PSA 64:4">eye wodanɛ zi ɖeka vɔvɔ̃manɔŋutɔe.<verse eid="PSA 64:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 64:5"/>Wodea dzi ƒo na wo nɔewo</para>
  <para style="q2" vid="PSA 64:5">le woƒe nu vɔ̃ɖi ɖoɖowo me,</para>
  <para style="q1" vid="PSA 64:5">woƒoa nu tso ale si woatre mɔ ɖe vivime</para>
  <para style="q2" vid="PSA 64:5">la ŋuti gblɔna be, “Ame kae le ekpɔ ge?”<verse eid="PSA 64:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 64:6"/>Woɖoa nu vɔ̃ɖi hegblɔna le eŋuti be,</para>
  <para style="q2" vid="PSA 64:6">“Míewɔ ɖoɖo deŋgɔ la vɔ!”</para>
  <para style="q2" vid="PSA 64:6">Vavãe, ame ƒe susu kple dzi me nye ayenuwɔƒe,<verse eid="PSA 64:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 64:7"/>gake Mawu ada aŋutrɔ wo</para>
  <para style="q2" vid="PSA 64:7">eye wòalɔ wo zi ɖeka kpoyi woamu adze anyi.<verse eid="PSA 64:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 64:8"/>Ana woawo ŋutɔ ƒe aɖe nade wo nya me</para>
  <para style="q2" vid="PSA 64:8">eye wòahe wo ade tsɔtsrɔ̃ me.</para>
  <para style="q2" vid="PSA 64:8">Ame siwo katã akpɔ wo la aʋuʋu ta ɖe wo ŋu fewuɖutɔe.<verse eid="PSA 64:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 64:9"/>Tete vɔvɔ̃ aɖo amegbetɔƒomea katã;</para>
  <para style="q2" vid="PSA 64:9">woado Mawu ƒe dɔwɔwɔwo ɖe dzi,</para>
  <para style="q2" vid="PSA 64:9">eye woade ŋugble le nu si wòwɔ la ŋuti.<verse eid="PSA 64:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 64:10"/>Ame dzɔdzɔe akpɔ dzidzɔ le Yehowa me, eye wòasii atso.</para>
  <para style="q2" vid="PSA 64:10">Ame siwo katã dza le woƒe dzi me la akafui!<verse eid="PSA 64:10"/></para>
  <chapter eid="PSA 64"/>
  <chapter number="65" style="c" sid="PSA 65"/>
  <para style="cl">Psalmo 65</para>
  <para style="d">David ƒe ha na hɛnɔ la.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 65:1"/>O! Mawu, kafukafu le lalawòm le Zion;</para>
  <para style="q2" vid="PSA 65:1">wòe míaxe míaƒe adzɔgbeɖefewo na.<verse eid="PSA 65:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 65:2"/>O! Wò ame si sea gbedodoɖa,</para>
  <para style="q2" vid="PSA 65:2">gbɔwòe amewo katã ava.<verse eid="PSA 65:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 65:3"/>Esi nu vɔ̃ do agba ɖe mía dzi la,</para>
  <para style="q2" vid="PSA 65:3">ètsɔ míaƒe dzidadawo ke mí.<verse eid="PSA 65:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 65:4"/>Woayra ame siwo nètia,</para>
  <para style="q2" vid="PSA 65:4">eye nèkplɔ wo vɛ be woanɔ wò xɔxɔnuwo!</para>
  <para style="q1" vid="PSA 65:4">Ètsɔ wò aƒe me,</para>
  <para style="q2" vid="PSA 65:4">wò gbedoxɔ kɔkɔe la me nu nyuiwo ɖi ƒoe na mí.<verse eid="PSA 65:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 65:5"/>Èna ŋuɖoɖo mí to dzɔdzɔenyenye ƒe ŋɔdzidɔwo me,</para>
  <para style="q2" vid="PSA 65:5">O, Mawu míaƒe xɔnametɔ,</para>
  <para style="q1" vid="PSA 65:5">anyigba ƒe mlɔenu ke,</para>
  <para style="q2" vid="PSA 65:5">kple atsiaƒu siwo le didiƒe ke la katã ƒe mɔkpɔkpɔ.<verse eid="PSA 65:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 65:6"/>Wò ame si na towo va dzɔ to wò ŋusẽ me,</para>
  <para style="q2" vid="PSA 65:6">eye nètsɔ ŋusẽ bla ali dzii,<verse eid="PSA 65:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 65:7"/>wò ame si tsi atsiaƒu ƒe hoowɔwɔ</para>
  <para style="q2" vid="PSA 65:7">kple ƒutsotsoe dzeagbowo</para>
  <para style="q2" vid="PSA 65:7">kpakple dukɔwo ƒe ʋunyaʋunyawo nu.<verse eid="PSA 65:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 65:8"/>Ame siwo le didiƒe la vɔ̃ wò nukunuwo;</para>
  <para style="q2" vid="PSA 65:8">èna dzidzɔhawo ɖi tso afi si ɣe dzena tsona</para>
  <para style="q2" vid="PSA 65:8">kple afi si wòɖoa to ɖo.<verse eid="PSA 65:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 65:9"/>Èlé be na anyigba,</para>
  <para style="q2" vid="PSA 65:9">de aɖui wòsui nyuie, eye nède tsii fũu.</para>
  <para style="q1" vid="PSA 65:9">Tsi yɔ Mawu ƒe tɔʋuwo banaa,</para>
  <para style="q2" vid="PSA 65:9">ne wòana bli eƒe dukɔ,</para>
  <para style="q2" vid="PSA 65:9">elabena nenema nèɖoe.<verse eid="PSA 65:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 65:10"/>Ède tsi eƒe boliƒowo,</para>
  <para style="q2" vid="PSA 65:10">eye nègbã kpoteƒewo wozu sɔsɔe.</para>
  <para style="q1" vid="PSA 65:10">Ètsɔ agbafie bɔbɔ anyigba lae,</para>
  <para style="q2" vid="PSA 65:10">eye nèyra eƒe nukuwo.<verse eid="PSA 65:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 65:11"/>Ètsɔ wò kesinɔnu gbogboawo ɖo atsyɔ̃e na ƒe la,</para>
  <para style="q2" vid="PSA 65:11">eye wò agblekekewo yɔ gbagba.<verse eid="PSA 65:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 65:12"/>Lãnyiƒe siwo le gbegbe la yɔ gbagba,</para>
  <para style="q2" vid="PSA 65:12">eye wotsɔ aseyetsotso ta na togbɛwo.<verse eid="PSA 65:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 65:13"/>Gbe damawo dzi yɔ fũu kple lãhawo,</para>
  <para style="q2" vid="PSA 65:13">eye balimewo ƒe afi sia afi yɔ kple bli;</para>
  <para style="q2" vid="PSA 65:13">wo katã do dzidzɔɣli, eye wodzi ha.<verse eid="PSA 65:13"/></para>
  <chapter eid="PSA 65"/>
  <chapter number="66" style="c" sid="PSA 66"/>
  <para style="cl">Psalmo 66</para>
  <para style="d">Ha na hɛnɔ la.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 66:1"/>Mi anyigbawo katã mido ɣli,</para>
  <para style="q2" vid="PSA 66:1">mitso aseye ɖe Mawu ŋu!<verse eid="PSA 66:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 66:2"/>Midzi eƒe ŋkɔ ƒe ŋutikɔkɔe ƒe ha;</para>
  <para style="q2" vid="PSA 66:2">mikafu Mawu ƒe gãnyenye!<verse eid="PSA 66:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 66:3"/>Migblɔ na Mawu be,</para>
  <para style="q2" vid="PSA 66:3">“Wò dɔwɔwɔwo dziŋɔ loo!</para>
  <para style="q1" vid="PSA 66:3">Wò ŋusẽ tri akɔ ale gbegbe be,</para>
  <para style="q2" vid="PSA 66:3">wò futɔwo de ta agu na wò.<verse eid="PSA 66:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 66:4"/>Anyigba la katã de ta agu na wò,</para>
  <para style="q2" vid="PSA 66:4">wole kafukafuha dzim na wò,</para>
  <para style="q2" vid="PSA 66:4">wole kafukafuha dzim na wò ŋkɔ.” <char style="qs">Sela</char><verse eid="PSA 66:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 66:5"/>Va, nàkpɔ nu si Mawu wɔ,</para>
  <para style="q2" vid="PSA 66:5">ale si le amegbetɔwo ta wòwɔ ŋɔdzidɔ geɖewo!<verse eid="PSA 66:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 66:6"/>Etrɔ atsiaƒu wòzu anyigba ƒuƒui,</para>
  <para style="q2" vid="PSA 66:6">wozɔ afɔ to tsi la titina;</para>
  <para style="q2" vid="PSA 66:6">miva míatso aseye le eya amea me.<verse eid="PSA 66:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 66:7"/>Ele fia ɖum kple eƒe ŋusẽ tegbee,</para>
  <para style="q2" vid="PSA 66:7">eƒe ŋku le dukɔwo ta kpɔm,</para>
  <para style="q2" vid="PSA 66:7">aglãdzela aɖeke megatso ɖe eŋuti o. <char style="qs">Sela</char><verse eid="PSA 66:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 66:8"/>O! Mi dukɔwo, mikafu míaƒe Mawu la;</para>
  <para style="q2" vid="PSA 66:8">mina eƒe kafukafu nade dzi woase.<verse eid="PSA 66:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 66:9"/>Eyae kpɔ míaƒe agbe ta,</para>
  <para style="q2" vid="PSA 66:9">eye mena míaƒe afɔ ɖiɖi o.<verse eid="PSA 66:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 66:10"/>Elabena O Mawu, wòe do mí kpɔ,</para>
  <para style="q2" vid="PSA 66:10">wòe lolõ mí abe klosalo ene.<verse eid="PSA 66:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 66:11"/>Wòe de mí gaxɔ me,</para>
  <para style="q2" vid="PSA 66:11">eye nèdo agba ɖe megbe na mí.<verse eid="PSA 66:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 66:12"/>Èna amewo zɔ míaƒe ta dzi,</para>
  <para style="q2" vid="PSA 66:12">eye míeto dzo me kple tɔ me,</para>
  <para style="q1" vid="PSA 66:12">gake èkplɔ mí va anyigba</para>
  <para style="q2" vid="PSA 66:12">si dzi nuwo do agbogbo ɖo fũu.<verse eid="PSA 66:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 66:13"/>Mava wò gbedoxɔ me kple numevɔsa,</para>
  <para style="q2" vid="PSA 66:13">eye maxe nye adzɔgbeɖefewo na wò,<verse eid="PSA 66:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 66:14"/>adzɔgbe siwo nye nuyi ɖe,</para>
  <para style="q2" vid="PSA 66:14">eye nye nu ɖe gbeƒã wo, esi meɖo xaxa me.<verse eid="PSA 66:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 66:15"/>Matsɔ lã damiwo kple agbowo asa numevɔe na wò,</para>
  <para style="q2" vid="PSA 66:15">hekpe ɖe nyitsuwo kple gbɔ̃wo ŋuti. <char style="qs">Sela</char><verse eid="PSA 66:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 66:16"/>Miva se, mí ame siwo katã vɔ̃a Mawu;</para>
  <para style="q2" vid="PSA 66:16">mina magblɔ nu siwo wòwɔ nam la na mi.<verse eid="PSA 66:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 66:17"/>Metsɔ nye nu do ɣli nɛ,</para>
  <para style="q2" vid="PSA 66:17">eƒe kafukafu le nye aɖe dzi.<verse eid="PSA 66:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 66:18"/>Ɖe mena nɔƒe nu vɔ̃ le nye dzi me la,</para>
  <para style="q2" vid="PSA 66:18">ne Aƒetɔ la meɖo tom o,<verse eid="PSA 66:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 66:19"/>gake Mawu ɖo tom vavã,</para>
  <para style="q2" vid="PSA 66:19">eye wòse nye gbe le gbedodoɖa me.<verse eid="PSA 66:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 66:20"/>Woakafu Mawu, ame si medo toku nye gbedodoɖa,</para>
  <para style="q2" vid="PSA 66:20">alo te eƒe lɔlɔ̃ ɖa le gbɔnye o!<verse eid="PSA 66:20"/></para>
  <chapter eid="PSA 66"/>
  <chapter number="67" style="c" sid="PSA 67"/>
  <para style="cl">Psalmo 67</para>
  <para style="d">Ha na hɛnɔ la. Woadzii ɖe kasaŋku ŋu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 67:1"/>Mawu, ve mía nu, eye nàyra mí,</para>
  <para style="q2" vid="PSA 67:1">na wò mo naklẽ ɖe mía dzi, <char style="qs">Sela</char><verse eid="PSA 67:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 67:2"/>Ale be woanya wò mɔwo le anyigba dzi</para>
  <para style="q2" vid="PSA 67:2">kple wò xɔxɔ le dukɔwo dome.<verse eid="PSA 67:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 67:3"/>O! Mawu, dukɔwo akafu wò,</para>
  <para style="q2" vid="PSA 67:3">anyigbadzidukɔwo katã akafu wò.<verse eid="PSA 67:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 67:4"/>Dukɔwo akpɔ dzidzɔ, adzi ha, atso aseye,</para>
  <para style="q2" vid="PSA 67:4">elabena èɖu dukɔwo dzi le dzɔdzɔenyenye me,</para>
  <para style="q2" vid="PSA 67:4">eye nèkplɔ anyigbadzidukɔwo. <char style="qs">Sela</char><verse eid="PSA 67:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 67:5"/>Mawu, dukɔwo katã akafu wò;</para>
  <para style="q2" vid="PSA 67:5">wòe dukɔwo katã akafu.<verse eid="PSA 67:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 67:6"/>Ekema anyigba ana woaxa eƒe nukuwo fũu, eye Mawu,</para>
  <para style="q2" vid="PSA 67:6">míaƒe Mawu la ayra mí.<verse eid="PSA 67:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 67:7"/>Mawu ayra mí, eye anyigba</para>
  <para style="q2" vid="PSA 67:7">ƒe mlɔenutɔwo katã avɔ̃e.<verse eid="PSA 67:7"/></para>
  <chapter eid="PSA 67"/>
  <chapter number="68" style="c" sid="PSA 68"/>
  <para style="cl">Psalmo 68</para>
  <para style="d">David ƒe ha na hɛnɔ la.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 68:1"/>Mawu tso, na wò futɔwo naka hlẽ,</para>
  <para style="q2" vid="PSA 68:1">na wò ketɔwo nasi le nuwò.<verse eid="PSA 68:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 68:2"/>Gbɔ wo ɖa abe ale si ya gbɔa dzudzɔ dzonae ene.</para>
  <para style="q2" vid="PSA 68:2">Abe ale si yɔkumi lolõna le dzo nu ene la,</para>
  <para style="q2" vid="PSA 68:2">nenema ame vɔ̃ɖiwo atsrɔ̃e le Mawu ŋkume.<verse eid="PSA 68:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 68:3"/>Ke ame dzɔdzɔewo ya akpɔ dzidzɔ,</para>
  <para style="q2" vid="PSA 68:3">atso aseye le Mawu ŋkume;</para>
  <para style="q2" vid="PSA 68:3">na woakpɔ dzidzɔ, eye woatu aglo.<verse eid="PSA 68:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 68:4"/>Midzi ha na Mawu,</para>
  <para style="q2" vid="PSA 68:4">midzi kafukafuha na eƒe ŋkɔ,</para>
  <para style="q2" vid="PSA 68:4">mido ame si le lilikpowo dzi gbɔna la ɖe dzi,</para>
  <para style="q2" vid="PSA 68:4">eŋkɔe nye Yehowa, eye mitso aseye le eŋgɔ;<verse eid="PSA 68:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 68:5"/>eya ame si nye tɔ na tɔmanɔsitɔwo,</para>
  <para style="q2" vid="PSA 68:5">ahosiwo ta ʋlila, eye wònye Mawu si le enɔƒe kɔkɔe la.<verse eid="PSA 68:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 68:6"/>Mawu kplɔa ame siwo tsi akogo la dea ƒomewo me,</para>
  <para style="q2" vid="PSA 68:6">enana ablɔɖe gamenɔlawo, eye wodzia dzidzɔhawo.</para>
  <para style="q2" vid="PSA 68:6">Ke ame dzeaglãwo la, egblẽa wo ɖe kuɖiɖinyigba dzi.<verse eid="PSA 68:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 68:7"/>O! Mawu, ne èdo dze wò dukɔ la ŋgɔ,</para>
  <para style="q2" vid="PSA 68:7">hezɔ to gbegbe la, <char style="qs">Sela</char><verse eid="PSA 68:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 68:8"/>anyigba ʋuʋu, dziƒowo dza tsi bɔbɔbɔ le Mawu,</para>
  <para style="q2" vid="PSA 68:8">si nɔ Sinai la ŋkume, le Mawu,</para>
  <para style="q2" vid="PSA 68:8">Israel ƒe Mawu la ŋkume.<verse eid="PSA 68:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 68:9"/>O! Mawu, èna tsi dza fũu,</para>
  <para style="q2" vid="PSA 68:9">eye nèna wò domenyinu si nu ti kɔ na</para>
  <para style="q2" vid="PSA 68:9">belibelibeli la gakpɔ ŋusẽ.<verse eid="PSA 68:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 68:10"/>Mawu, wò amewo yi ɖanɔ edzi,</para>
  <para style="q2" vid="PSA 68:10">eye tso wò nu gbogboawo me, èna nu ame dahewo.<verse eid="PSA 68:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 68:11"/>Aƒetɔ ɖe gbeƒã nya la,</para>
  <para style="q2" vid="PSA 68:11">eye ameha gã aɖe do ɣli kplii be,<verse eid="PSA 68:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 68:12"/>“Fiawo kple aʋakɔwo, misi kaba,</para>
  <para style="q2" vid="PSA 68:12">elabena amewo le afunyinuwo ham le asaɖawo me.<verse eid="PSA 68:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 68:13"/>Esi miele alɔ̃ dɔm le lãkpowo dome la,</para>
  <para style="q2" vid="PSA 68:13">wotsɔ klosalo fa ɖe nye ahɔnɛ ƒe aʋala ŋu,</para>
  <para style="q2" vid="PSA 68:13">eye wotsɔ sika si le keklẽm la fa ɖe eƒe fuwo ŋuti.”<verse eid="PSA 68:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 68:14"/>Esi Ŋusẽkatãtɔ la kaka anyigbadzifiawo hlẽ la,</para>
  <para style="q2" vid="PSA 68:14">enɔ abe tsikpee dza ɖe Zalmɔn dzi ene.<verse eid="PSA 68:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 68:15"/>Basan towo ƒe dzedzeme</para>
  <para style="q2" vid="PSA 68:15">kple kɔkɔme nya kpɔ ŋutɔ;</para>
  <para style="q2" vid="PSA 68:15">to tsaklitsakliwo Basan toawo nye.<verse eid="PSA 68:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 68:16"/>O! To tsaklitsakliwo,</para>
  <para style="q2" vid="PSA 68:16">nu ka ta mietsɔ ŋuʋaʋã ƒe ŋku</para>
  <para style="q1" vid="PSA 68:16">le to si Mawu tia be wòanye yeƒe fiazikpui ƒe nɔƒe</para>
  <para style="q2" vid="PSA 68:16">kple Yehowa ŋutɔ ƒe nɔƒe tegbee la kpɔmii?<verse eid="PSA 68:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 68:17"/>Mawu ƒe tasiaɖamwo nye akpe nanewo</para>
  <para style="q2" vid="PSA 68:17">kple akpe teƒe akpewo;</para>
  <para style="q2" vid="PSA 68:17">Aƒetɔ la tso Sinai va ɖo eƒe teƒe kɔkɔe la.<verse eid="PSA 68:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 68:18"/>Esi nèlia yi dzi la, ètɔ ka aboyomewo hekplɔ dzoe,</para>
  <para style="q2" vid="PSA 68:18">èxɔ nunana tso amewo gbɔ,</para>
  <para style="q1" vid="PSA 68:18">tso aglãdzelawo gɔ̃ hã gbɔ, be wò,</para>
  <para style="q2" vid="PSA 68:18">O! Yehowa Mawu, àte ŋu anɔ afi ma.<verse eid="PSA 68:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 68:19"/>Kafukafu woana Aƒetɔ, Mawu míaƒe Ɖela,</para>
  <para style="q2" vid="PSA 68:19">ame si tsɔa míaƒe agbawo gbe sia gbe. <char style="qs">Sela</char><verse eid="PSA 68:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 68:20"/>Míaƒe Mawu nye Mawu si xɔna na ame;</para>
  <para style="q2" vid="PSA 68:20">ɖeɖe tso ku me vana to Aƒetɔ Yehowa ko dzi.<verse eid="PSA 68:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 68:21"/>Vavã, Mawu agbã ta na eƒe futɔwo</para>
  <para style="q2" vid="PSA 68:21">kple dzodome na ame siwo gale woƒe nu vɔ̃wo dzi yim.<verse eid="PSA 68:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 68:22"/>Aƒetɔ la gblɔ be,</para>
  <para style="q2" vid="PSA 68:22">“Makplɔ wo vɛ tso Basan;</para>
  <para style="q2" vid="PSA 68:22">makplɔ wo ado goe tso atsiaƒu ƒe gogloƒe ke,<verse eid="PSA 68:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 68:23"/>be nàklɔ afɔ ɖe wò futɔwo ƒe ʋu me,</para>
  <para style="q2" vid="PSA 68:23">eye wò avuwo ƒe aɖewo hã nakpɔ wo tɔ gome.”<verse eid="PSA 68:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 68:24"/>O! Mawu, wole míaƒe azɔlime kpɔm,</para>
  <para style="q2" vid="PSA 68:24">wole ale si nye Mawu</para>
  <para style="q2" vid="PSA 68:24">kple fianye zɔ ge ɖe kɔkɔeƒe lae la kpɔm.<verse eid="PSA 68:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 68:25"/>Woɖo ɖe fli me, hadzilawo le ŋgɔgbe,</para>
  <para style="q2" vid="PSA 68:25">hafialawo ɖo, eye ɖetugbi siwo</para>
  <para style="q2" vid="PSA 68:25">le axatsɛ ƒom la tsɔ wo ɖe dome.<verse eid="PSA 68:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 68:26"/>Mikafu Mawu le ameha gã la dome.</para>
  <para style="q2" vid="PSA 68:26">Mikafu Yehowa le Israelviwo ƒe takpekpe me.<verse eid="PSA 68:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 68:27"/>Kpɔ ɖa, Benyamin ƒe to si nye suetɔ lae le ŋgɔ na wo,</para>
  <para style="q2" vid="PSA 68:27">Yuda ƒe dumegã gbogboawo le afi ma,</para>
  <para style="q2" vid="PSA 68:27">eye Zebulon kple Naftali ƒe amegãwo hã le afi ma.<verse eid="PSA 68:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 68:28"/>O! Mawu, yɔ wò ŋusẽ vɛ;</para>
  <para style="q2" vid="PSA 68:28">O! Mawu, ɖe wò ŋusẽ fia mí abe tsã ene.<verse eid="PSA 68:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 68:29"/>Le wò Yerusalem gbedoxɔ ta la,</para>
  <para style="q2" vid="PSA 68:29">fiawo atsɔ nunanawo vɛ na wò.<verse eid="PSA 68:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 68:30"/>Blu ɖe lã wɔadã siwo le aƒlawo me</para>
  <para style="q2" vid="PSA 68:30">kple nyitsuwo ƒe ha siwo le dukɔwo ƒe nyiviwo dome la ta.</para>
  <para style="q1" vid="PSA 68:30">Netsɔ klosalokɔ gãwo vɛ le ɖokuibɔbɔ me.</para>
  <para style="q2" vid="PSA 68:30">Kaka dukɔ siwo aʋawɔwɔ doa dzidzɔ na.<verse eid="PSA 68:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 68:31"/>Ame dɔdɔwo atso Egipte ava,</para>
  <para style="q2" vid="PSA 68:31">eye Kus abɔbɔ eɖokui ɖe Mawu te.<verse eid="PSA 68:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 68:32"/>O! Mi anyigbadzifiaɖuƒewo,</para>
  <para style="q2" vid="PSA 68:32">midzi ha na Mawu,</para>
  <para style="q2" vid="PSA 68:32">midzi kafukafuha na Aƒetɔ la, <char style="qs">Sela</char><verse eid="PSA 68:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 68:33"/>Eya ame si nɔ blemalilikpowo dzi,</para>
  <para style="q2" vid="PSA 68:33">eye wòɖe gbe kple gbe sesẽ aɖe.<verse eid="PSA 68:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 68:34"/>Miɖe gbeƒã Mawu ƒe ŋusẽ,</para>
  <para style="q2" vid="PSA 68:34">ame si ƒe atsyɔ̃ le Israel dzi,</para>
  <para style="q2" vid="PSA 68:34">eye eƒe ŋusẽ le dziŋgɔli ŋu.<verse eid="PSA 68:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 68:35"/>O! Mawu, ŋɔdzi le ŋuwò le wò kɔkɔeƒe la;</para>
  <para style="q2" vid="PSA 68:35">Israel ƒe Mawu la na ŋusẽ</para>
  <para style="q2" vid="PSA 68:35">kple ŋutete eƒe dukɔ la.</para>
  <para style="b" vid="PSA 68:35"/>
  <para style="q1" vid="PSA 68:35">Woakafu Mawu!<verse eid="PSA 68:35"/></para>
  <chapter eid="PSA 68"/>
  <chapter number="69" style="c" sid="PSA 69"/>
  <para style="cl">Psalmo 69</para>
  <para style="d">David ƒe ha na hɛnɔ la. Woadzii ɖe “Dzogbenya” ƒe gbeɖiɖi nu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 69:1"/>Mawu, ɖem,</para>
  <para style="q2" vid="PSA 69:1">elabena tsi ɖɔ ɖe ŋunye va se ɖe nye kɔgbɔ ke.<verse eid="PSA 69:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 69:2"/>Meɖo ba yi ɖe tome ke,</para>
  <para style="q2" vid="PSA 69:2">afi si afɔɖoƒe mele o.</para>
  <para style="q1" vid="PSA 69:2">Meɖo tɔ goglowo me;</para>
  <para style="q2" vid="PSA 69:2">tsi ɖɔ to tanye.<verse eid="PSA 69:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 69:3"/>Medo ɣli be woaxɔ nam,</para>
  <para style="q2" vid="PSA 69:3">ale nu ti kɔ nam, eye nye ve me hã ƒu kplakplakpla.</para>
  <para style="q1" vid="PSA 69:3">Mekpɔ mɔ na Mawu ʋuu,</para>
  <para style="q2" vid="PSA 69:3">eye ɖeɖi te nye ŋkuwo ŋu.<verse eid="PSA 69:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 69:4"/>Ame siwo lé fum ɖe nanekemawɔmawɔ ta la</para>
  <para style="q2" vid="PSA 69:4">sɔ gbɔ wu nye taɖa.</para>
  <para style="q1" vid="PSA 69:4">Amewo lé fum yakatsyɔ,</para>
  <para style="q2" vid="PSA 69:4">eye woti yonyeme be woatsrɔ̃m.</para>
  <para style="q1" vid="PSA 69:4">Ale meɖo nu si nyemefi o la eteƒe dzizizitɔe.<verse eid="PSA 69:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 69:5"/>O! Mawu, ènya nye bometsitsi,</para>
  <para style="q2" vid="PSA 69:5">eye nye fɔɖiɖi mele ɣaɣla ɖe wò o.<verse eid="PSA 69:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 69:6"/>O! Aƒetɔ, Yehowa Ŋusẽkatãtɔ,</para>
  <para style="q2" vid="PSA 69:6">mègana ame siwo ƒe mɔkpɔkpɔ</para>
  <para style="q2" vid="PSA 69:6">le mewò la naɖu ŋukpe le tanye o.</para>
  <para style="q1" vid="PSA 69:6">O! Israel ƒe Mawu, ame siwo le diwòm la,</para>
  <para style="q2" vid="PSA 69:6">mègana ŋu nakpe wo le tanye o.<verse eid="PSA 69:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 69:7"/>Tawòe wodo vlom ɖo,</para>
  <para style="q2" vid="PSA 69:7">eye ŋukpe tsyɔ mo nam.<verse eid="PSA 69:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 69:8"/>Menye amedzro na nye ŋutɔ nɔvinye ŋutsuwo</para>
  <para style="q2" vid="PSA 69:8">kple ame manyamanya na danyevi ŋutsuwo.<verse eid="PSA 69:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 69:9"/>Elabena lɔlɔ̃ na wò aƒe zu dzo ge ɖe menye,</para>
  <para style="q2" vid="PSA 69:9">eye ame siwo dzu wò la ƒe dzudzu va dzinye.<verse eid="PSA 69:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 69:10"/>Esi mefa avi, tsi nu dɔ la,</para>
  <para style="q2" vid="PSA 69:10">vlododo boŋ wozu nam;<verse eid="PSA 69:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 69:11"/>esi meta akpanya la,</para>
  <para style="q2" vid="PSA 69:11">mezu nu ɖikokoe na amewo.<verse eid="PSA 69:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 69:12"/>Ame siwo nɔ anyi ɖe agbo nu la ɖe alɔme le ŋunye,</para>
  <para style="q2" vid="PSA 69:12">eye ahamulawo kekeake hã kpa ha dem.<verse eid="PSA 69:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 69:13"/>O! Yehowa, medo gbe ɖa na wò le wò amenuveɣi;</para>
  <para style="q2" vid="PSA 69:13">O! Mawu, le wò lɔlɔ̃ gã la ta,</para>
  <para style="q2" vid="PSA 69:13">tɔ nam kple wò xɔname si medana le edzi o.<verse eid="PSA 69:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 69:14"/>Ɖem tso agbi me,</para>
  <para style="q2" vid="PSA 69:14">mègana mayi to o,</para>
  <para style="q1" vid="PSA 69:14">ɖem le ame siwo lé fum la ƒe asi me,</para>
  <para style="q2" vid="PSA 69:14">tso tɔ goglowo me.<verse eid="PSA 69:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 69:15"/>Mègana tsi naɖɔ to tanye,</para>
  <para style="q2" vid="PSA 69:15">alo gogloƒe namim, eye ʋe globo natu eƒe nu ɖe dzinye o.<verse eid="PSA 69:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 69:16"/>O! Yehowa, tɔ nam, le wò lɔlɔ̃ deto la ta,</para>
  <para style="q2" vid="PSA 69:16">eye trɔ ɖe ŋutinye le wò nublanuikpɔkpɔ gã la ta.<verse eid="PSA 69:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 69:17"/>Mègaɣla wò mo ɖe wò dɔla o;</para>
  <para style="q2" vid="PSA 69:17">ke boŋ tɔ nam kaba, elabena meɖo xaxa me.<verse eid="PSA 69:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 69:18"/>Te ɖe ŋunye, eye nàxɔ nam,</para>
  <para style="q2" vid="PSA 69:18">ɖem le nye ketɔwo ta.<verse eid="PSA 69:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 69:19"/>Ènya ale si wodo vlom,</para>
  <para style="q2" vid="PSA 69:19">ɖi gbɔ̃m, eye wodo ŋu kpem;</para>
  <para style="q2" vid="PSA 69:19">nye futɔwo katã le ŋkuwò me.<verse eid="PSA 69:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 69:20"/>Vlododo na nye dzi gbã,</para>
  <para style="q2" vid="PSA 69:20">eye mezu xɔnamemanɔsitɔ;</para>
  <para style="q1" vid="PSA 69:20">mekpɔ mɔ na babadoname,</para>
  <para style="q2" vid="PSA 69:20">gake ɖeke meli o.</para>
  <para style="q1" vid="PSA 69:20">Mekpɔ mɔ na akɔfalawo,</para>
  <para style="q2" vid="PSA 69:20">gake nyemekpɔ ɖeke o.<verse eid="PSA 69:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 69:21"/>Wotsɔ veve de nye nuɖuɖu me,</para>
  <para style="q2" vid="PSA 69:21">eye esi tsikɔ wum la, wotsɔ aha tsitsi nam be mano.<verse eid="PSA 69:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 69:22"/>Woƒe kplɔ̃ si woɖo na wo la nezu mɔ na wo;</para>
  <para style="q2" vid="PSA 69:22">nezu teƒeɖoɖo kple mɔ na wo.<verse eid="PSA 69:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 69:23"/>Woƒe ŋkuwo dzi nedo viviti be,</para>
  <para style="q2" vid="PSA 69:23">womagate ŋu akpɔ nu o,</para>
  <para style="q2" vid="PSA 69:23">eye na woƒe dzi me naɖo kpo tegbee.<verse eid="PSA 69:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 69:24"/>Trɔ wò dziku kɔ ɖe wo dzi,</para>
  <para style="q2" vid="PSA 69:24">eye nàna wò dɔmedzoe helĩhelĩ nalé wo.<verse eid="PSA 69:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 69:25"/>Woƒe nɔƒe neɖi gbɔlo;</para>
  <para style="q2" vid="PSA 69:25">mègana be ame aɖeke neganɔ woƒe agbadɔwo me o.<verse eid="PSA 69:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 69:26"/>Elabena woti ame siwo ŋu nède abii la yome,</para>
  <para style="q2" vid="PSA 69:26">eye wole nu ƒom le ame siwo nèwɔ nuvevii la ƒe vevesese ŋu.<verse eid="PSA 69:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 69:27"/>Bu fɔ wo, eye nàgabu fɔ wo ɖe edzi;</para>
  <para style="q2" vid="PSA 69:27">mègana woakpɔ gome le wò xɔname me o.<verse eid="PSA 69:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 69:28"/>Tutu woƒe ŋkɔwo ɖa le agbegbalẽ la me,</para>
  <para style="q2" vid="PSA 69:28">eye mègana woaŋlɔ woƒe ŋkɔ ɖe</para>
  <para style="q2" vid="PSA 69:28">ame dzɔdzɔewo dome o.<verse eid="PSA 69:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 69:29"/>Mele vevesese kple nuxaxa me;</para>
  <para style="q2" vid="PSA 69:29">O! Mawu, na wò xɔname natɔ kpɔ ƒo xlãm.<verse eid="PSA 69:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 69:30"/>Matsɔ hadzidzi akafu Mawu ƒe ŋkɔ,</para>
  <para style="q2" vid="PSA 69:30">eye madoe ɖe dzi kple akpedada.<verse eid="PSA 69:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 69:31"/>Esia adze Yehowa ŋu wu nyi,</para>
  <para style="q2" vid="PSA 69:31">eye wòado dzidzɔ nɛ wu nyitsu</para>
  <para style="q2" vid="PSA 69:31">kple eƒe dzowo kpakple eƒe afɔkliwo.<verse eid="PSA 69:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 69:32"/>Hiãtɔwo akpɔe ahatso aseye,</para>
  <para style="q2" vid="PSA 69:32">eye mi ame siwo dia Mawu la,</para>
  <para style="q2" vid="PSA 69:32">míaƒe dziwo nenɔ agbe ɖaa!<verse eid="PSA 69:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 69:33"/>Yehowa ɖoa to hiãtɔwo,</para>
  <para style="q2" vid="PSA 69:33">eye medoa vlo eƒe ame siwo le aboyome o.<verse eid="PSA 69:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 69:34"/>Dziƒo kple anyigba nekafui,</para>
  <para style="q2" vid="PSA 69:34">atsiaƒuwo kple nu siwo katã ʋãna le wo me,<verse eid="PSA 69:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 69:35"/>elabena Mawu aɖe Zion,</para>
  <para style="q2" vid="PSA 69:35">eye wòagbugbɔ Yuda ƒe duwo atso.</para>
  <para style="q1" vid="PSA 69:35">Ekema amewo aɖanɔ afi ma, axɔe wòazu wo tɔ;<verse eid="PSA 69:35"/></para>
  <para style="q2">
    <verse number="36" style="v" sid="PSA 69:36"/>eƒe dɔlawo ƒe viwo atsɔe anyi domee,</para>
  <para style="q2" vid="PSA 69:36">eye ame siwo lɔ̃ eƒe ŋkɔ la anɔ afi ma.<verse eid="PSA 69:36"/></para>
  <chapter eid="PSA 69"/>
  <chapter number="70" style="c" sid="PSA 70"/>
  <para style="cl">Psalmo 70</para>
  <para style="d">David ƒe ha na hɛnɔ la. Kukuɖeɖe.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 70:1"/>O! Mawu, netsɔ nàɖem;</para>
  <para style="q2" vid="PSA 70:1">O! Yehowa, va kaba nàxɔ nam.<verse eid="PSA 70:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 70:2"/>Ŋukpe kple tɔtɔ neva ame siwo</para>
  <para style="q2" vid="PSA 70:2">le nye agbe yome tim la dzi.</para>
  <para style="q1" vid="PSA 70:2">Ame siwo le nye gbegblẽ dim la</para>
  <para style="q2" vid="PSA 70:2">negbugbɔ ɖe megbe kple ŋukpe.<verse eid="PSA 70:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 70:3"/>Na be ame siwo le gbɔgblɔm be,</para>
  <para style="q2" vid="PSA 70:3">“Ɛhɛ̃! Ɛhɛ̃!” la</para>
  <para style="q2" vid="PSA 70:3">natrɔ megbe adzo kple ŋukpe.<verse eid="PSA 70:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 70:4"/>Ke ame siwo dia wò la netso aseye;</para>
  <para style="q2" vid="PSA 70:4">woakpɔ dzidzɔ le mewò,</para>
  <para style="q1" vid="PSA 70:4">eye ame siwo lɔ̃a wò xɔname la negblɔ ɖaa be,</para>
  <para style="q2" vid="PSA 70:4">“Woado Mawu ɖe dzi ɖaa!”<verse eid="PSA 70:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 70:5"/>Ke nye la, O Mawu, meda ahe, eye hiã tum,</para>
  <para style="q2" vid="PSA 70:5">eya ta va gbɔnye kaba.</para>
  <para style="q1" vid="PSA 70:5">O! Yehowa, mègahe ɖe megbe o,</para>
  <para style="q2" vid="PSA 70:5">elabena wòe nye nye xɔnametɔ kple nye Ɖela.<verse eid="PSA 70:5"/></para>
  <chapter eid="PSA 70"/>
  <chapter number="71" style="c" sid="PSA 71"/>
  <para style="cl">Psalmo 71</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 71:1"/>O! Yehowa, mewòe mebe ɖo,</para>
  <para style="q2" vid="PSA 71:1">mègana ŋu nakpem akpɔ gbeɖe o.<verse eid="PSA 71:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 71:2"/>Xɔ nam, eye nàɖem le wò dzɔdzɔenyenye la ta;</para>
  <para style="q2" vid="PSA 71:2">trɔ wò to ɖe gbɔnye, eye nàxɔ nam.<verse eid="PSA 71:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 71:3"/>Nye sitsoƒe ƒe agakpe,</para>
  <para style="q2" vid="PSA 71:3">afi si mate ŋu abe ɖo ɣe sia ɣi.</para>
  <para style="q1" vid="PSA 71:3">Ɖe gbe be woaxɔ nam,</para>
  <para style="q2" vid="PSA 71:3">elabena wòe nye nye agakpe kple mɔ sesẽ.<verse eid="PSA 71:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 71:4"/>O! Nye Mawu, ɖem tso ame vɔ̃ɖiwo ƒe asi me,</para>
  <para style="q2" vid="PSA 71:4">eye nàɖem tso nu tovo wɔlawo</para>
  <para style="q2" vid="PSA 71:4">kple ŋutasẽlawo ƒe fego me.<verse eid="PSA 71:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 71:5"/>Elabena tso ɣe aɖe ɣi ke, wòe nye nye mɔkpɔkpɔ</para>
  <para style="q2" vid="PSA 71:5">kple nye dzideƒo tso nye ɖekakpuime ke,</para>
  <para style="q2" vid="PSA 71:5">O! Aƒetɔ Yehowa.<verse eid="PSA 71:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 71:6"/>Tso nye dzigbe ke,</para>
  <para style="q2" vid="PSA 71:6">wò ko ŋu meku ɖo,</para>
  <para style="q1" vid="PSA 71:6">elabena wòe ɖem tso danye ƒe dɔ me,</para>
  <para style="q2" vid="PSA 71:6">eya ta makafu wò ɖaa.<verse eid="PSA 71:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 71:7"/>Mezu nu maɖinu na ame geɖewo,</para>
  <para style="q2" vid="PSA 71:7">gake wòe nye nye mɔ sesẽ.<verse eid="PSA 71:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 71:8"/>Wò kafukafu yɔ nye nu me,</para>
  <para style="q2" vid="PSA 71:8">eye meɖea gbeƒã wò atsyɔ̃ŋkeke blibo la.<verse eid="PSA 71:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 71:9"/>Mègatsɔm ƒu gbe, ne meku amegã o,</para>
  <para style="q2" vid="PSA 71:9">eye mègagblẽm ɖi ne ŋusẽ vɔ le ŋunye o.<verse eid="PSA 71:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 71:10"/>Elabena nye futɔwo ƒo nu tsi tsitre ɖe ŋunye,</para>
  <para style="q2" vid="PSA 71:10">eye ame siwo le lalam be yewoawum la,</para>
  <para style="q2" vid="PSA 71:10">wɔ ɖeka ɖo nugbe ɖe ŋunye.<verse eid="PSA 71:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 71:11"/>Wogblɔ be, “Mawu gblẽe ɖi, míti eyome,</para>
  <para style="q2" vid="PSA 71:11">míalée, elabena ame aɖeke mava axɔ nɛ o.”<verse eid="PSA 71:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 71:12"/>O! Mawu, mèganɔ adzɔge tso gbɔnye o,</para>
  <para style="q2" vid="PSA 71:12">O! Nye Mawu, va kaba nàxɔ nam.<verse eid="PSA 71:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 71:13"/>Na be nunyetsolawo natsrɔ̃ kple ŋukpe,</para>
  <para style="q2" vid="PSA 71:13">eye nàna be vlododo kple ŋukpe natsyɔ</para>
  <para style="q2" vid="PSA 71:13">ame siwo di be yewoawɔ nuvevim la dzi.<verse eid="PSA 71:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 71:14"/>Ke nye ya la, mɔkpɔkpɔ anɔ asinye ɖaa,</para>
  <para style="q2" vid="PSA 71:14">eye makafu wò, agakafu wò ɖe edzi.<verse eid="PSA 71:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 71:15"/>Nye nu aɖe gbeƒã wò dzɔdzɔenyenye</para>
  <para style="q2" vid="PSA 71:15">kple wò xɔname ŋkeke blibo la,</para>
  <para style="q2" vid="PSA 71:15">togbɔ be nyemenya eƒe kpekpeme o hã.<verse eid="PSA 71:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 71:16"/>Mava aɖe gbeƒã wò nu dzɔatsuwo,</para>
  <para style="q2" vid="PSA 71:16">O Aƒetɔ Yehowa.</para>
  <para style="q1" vid="PSA 71:16">Maɖe gbeƒã wò dzɔdzɔenyenye,</para>
  <para style="q2" vid="PSA 71:16">wò ɖeka tɔ ko.<verse eid="PSA 71:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 71:17"/>O! Mawu; tso nye ɖekakpuime ke,</para>
  <para style="q2" vid="PSA 71:17">nèfia num, eye va se ɖe egbe la,</para>
  <para style="q2" vid="PSA 71:17">mele gbeƒã ɖem wò nu dzɔatsuwo.<verse eid="PSA 71:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 71:18"/>O! Mawu, ne metsi,</para>
  <para style="q2" vid="PSA 71:18">ƒo wɔ hã la, mègagblẽm ɖi o,</para>
  <para style="q1" vid="PSA 71:18">va se ɖe esime maɖe gbeƒã wò ŋusẽ</para>
  <para style="q2" vid="PSA 71:18">na dzidzime si ava dzɔ</para>
  <para style="q2" vid="PSA 71:18">kple wò ŋusẽ na ame siwo woava dzi.<verse eid="PSA 71:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 71:19"/>O! Mawu, wò dzɔdzɔenyenye yi ɖatɔ dziŋgɔli ke,</para>
  <para style="q2" vid="PSA 71:19">wò ame si wɔ nu dzɔatsu geɖewo.</para>
  <para style="q2" vid="PSA 71:19">O! Mawu, ame kae le abe wò ene?<verse eid="PSA 71:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 71:20"/>Togbɔ be èna mekpɔ xaxa geɖe kple vevesese hã la,</para>
  <para style="q2" vid="PSA 71:20">àgaɖo nye agbe te, eye àva kplɔm</para>
  <para style="q2" vid="PSA 71:20">ado goe tso anyigba ƒe tume ke.<verse eid="PSA 71:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 71:21"/>Àdzi nye bubu ɖe edzi,</para>
  <para style="q2" vid="PSA 71:21">eye àgafa akɔ nam.<verse eid="PSA 71:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 71:22"/>O! Nye Mawu, makafu wò kple kasaŋku</para>
  <para style="q2" vid="PSA 71:22">le wò nuteƒewɔwɔ ta;</para>
  <para style="q1" vid="PSA 71:22">madzi kafukafuha na wò kple gasaŋku,</para>
  <para style="q2" vid="PSA 71:22">O! Israel ƒe Kɔkɔetɔ.<verse eid="PSA 71:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 71:23"/>Nye nuyiwo ado dzidzɔɣli,</para>
  <para style="q2" vid="PSA 71:23">ne mele kafukafuhawo dzim na wò,</para>
  <para style="q2" vid="PSA 71:23">nye ame si nèɖe.<verse eid="PSA 71:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 71:24"/>Nye aɖe agblɔ wò dzɔdzɔenyenye</para>
  <para style="q2" vid="PSA 71:24">ƒe dɔwo ŋkeke blibo la,</para>
  <para style="q1" vid="PSA 71:24">elabena ŋukpe kple tɔtɔ va</para>
  <para style="q2" vid="PSA 71:24">ame siwo di be yewoawɔ nuvevim la dzi.<verse eid="PSA 71:24"/></para>
  <chapter eid="PSA 71"/>
  <chapter number="72" style="c" sid="PSA 72"/>
  <para style="cl">Psalmo 72</para>
  <para style="d">Ha na Solomo.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 72:1"/>O! Mawu, tsɔ wò afia nyui tsotso do na fia la,</para>
  <para style="q2" vid="PSA 72:1">kple wò dzɔdzɔenyenye na fiavi la.<verse eid="PSA 72:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 72:2"/>Adrɔ̃ ʋɔnu na wò dukɔ la le dzɔdzɔenyenye me,</para>
  <para style="q2" vid="PSA 72:2">eye wòatso afia nyui na ame siwo ƒe dzi gbã la.<verse eid="PSA 72:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 72:3"/>Towo atsɔ kesinɔnuwo vɛ na wò dukɔ,</para>
  <para style="q2" vid="PSA 72:3">eye togbɛwo atsɔ dzɔdzɔenyenye ƒe kutsetse vɛ na wo.<verse eid="PSA 72:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 72:4"/>Aʋli ame siwo ƒe dzi gbã la ta,</para>
  <para style="q2" vid="PSA 72:4">axɔ na hiãtɔwo ƒe viwo,</para>
  <para style="q2" vid="PSA 72:4">eye wòagbã ameteɖetola la nyanyanya.<verse eid="PSA 72:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 72:5"/>Zi ale si ɣe kple ɣleti li la,</para>
  <para style="q2" vid="PSA 72:5">anɔ te le dzidzimewo katã me.<verse eid="PSA 72:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 72:6"/>Anɔ abe tsidzadza ɖe anyigba si dzi woƒo gbe le</para>
  <para style="q2" vid="PSA 72:6">kple agbafie si dza ɖe anyigba hede tsii ene.<verse eid="PSA 72:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 72:7"/>Ame dzɔdzɔewo ayi ŋgɔ le eƒe ɣeyiɣiwo me,</para>
  <para style="q2" vid="PSA 72:7">eye kesinɔnuwo ado agbogbo va se ɖe esime ɣleti magaɖi o.<verse eid="PSA 72:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 72:8"/>Aɖu fia tso atsiaƒu ƒe go sia dzi ayi go kemɛ dzi,</para>
  <para style="q2" vid="PSA 72:8">tso tɔsisi to ase ɖe anyigba la ƒe mlɔenuwo ke.<verse eid="PSA 72:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 72:9"/>Dukɔ siwo le gbegbe la ade ta agu nɛ,</para>
  <para style="q2" vid="PSA 72:9">eye eƒe futɔwo aɖuɖɔ ʋuʋudedi.<verse eid="PSA 72:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 72:10"/>Tarsis fia kple didiƒe ƒutatɔwo ahe adzɔ vɛ nɛ,</para>
  <para style="q2" vid="PSA 72:10">eye Sieba kple Seba fiawo atsɔ nunanawo vɛ nɛ.<verse eid="PSA 72:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 72:11"/>Fiawo katã ade ta agu nɛ,</para>
  <para style="q2" vid="PSA 72:11">eye dukɔwo katã asubɔe,<verse eid="PSA 72:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 72:12"/>elabena aɖe hiãtɔ si le avi fam</para>
  <para style="q2" vid="PSA 72:12">kple wɔmenɔ si xɔnametɔ aɖeke meli na o.<verse eid="PSA 72:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 72:13"/>Akpɔ nublanui na ame gblɔewo kple hiãtɔwo,</para>
  <para style="q2" vid="PSA 72:13">eye wòaɖe ame dahewo tso ku me.<verse eid="PSA 72:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 72:14"/>Aɖe wo le teteɖeanyi kple ŋutasesẽ me,</para>
  <para style="q2" vid="PSA 72:14">elabena woƒe ʋu xɔ asi le eŋkume.<verse eid="PSA 72:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 72:15"/>Fia la nenɔ agbe tegbee!</para>
  <para style="q2" vid="PSA 72:15">Wonetsɔ Seba sika nɛ.</para>
  <para style="q1" vid="PSA 72:15">Amewo nedo gbe ɖa ɖe eta ɖaa,</para>
  <para style="q2" vid="PSA 72:15">eye wòayra ŋkeke blibo la.<verse eid="PSA 72:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 72:16"/>Bli nedo agbogbo ɖe anyigba la katã dzi;</para>
  <para style="q2" vid="PSA 72:16">eye neʋã ɖe togbɛwo katã dzi.</para>
  <para style="q1" vid="PSA 72:16">Blitiawo netri abe Lebanontɔwo ene,</para>
  <para style="q2" vid="PSA 72:16">eye woanɔ abe gbe le gbedzi ene.<verse eid="PSA 72:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 72:17"/>Eƒe ŋkɔ nenɔ anyi ɖaa,</para>
  <para style="q2" vid="PSA 72:17">eye nenɔ anyi zi ale si ɣe le keklẽm.</para>
  <para style="b" vid="PSA 72:17"/>
  <para style="q1" vid="PSA 72:17">Woayra dukɔwo katã to eya amea dzi,</para>
  <para style="q2" vid="PSA 72:17">eye woayɔe be yayratɔ.<verse eid="PSA 72:17"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 72:18"/>Woakafu Yehowa Mawu,</para>
  <para style="q2" vid="PSA 72:18">Israel ƒe Mawu la,</para>
  <para style="q2" vid="PSA 72:18">eya ame si ko wɔa nu dzɔatsuwo.<verse eid="PSA 72:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 72:19"/>Woakafu eƒe ŋkɔ si ŋu ŋutikɔkɔe</para>
  <para style="q2" vid="PSA 72:19">le la tso mavɔ me yi ɖe mavɔ me;</para>
  <para style="q1" vid="PSA 72:19">eƒe ŋutikɔkɔe neyɔ anyigba blibo la dzi.</para>
  <para style="qc" vid="PSA 72:19">Amen, ɛ̃, Amen.<verse eid="PSA 72:19"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 72:20"/>Esiawo wu Yese ƒe vi, David ƒe gbedodoɖawo nu.<verse eid="PSA 72:20"/></para>
  <chapter eid="PSA 72"/>
  <chapter number="73" style="c" sid="PSA 73"/>
  <para style="ms">Agbalẽ etɔ̃lia</para>
  <para style="mr">
    <ref loc="PSA 73-89">Psalmowo 73–89</ref></para>
  <para style="cl">Psalmo 73</para>
  <para style="d">Asaf ƒe ha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 73:1"/>Vavã, Mawu wɔ nyui na Israel</para>
  <para style="q2" vid="PSA 73:1">kple ame siwo dza le woƒe dzi me.<verse eid="PSA 73:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 73:2"/>Ke nye la, nye afɔ ɖiɖi kloe,</para>
  <para style="q2" vid="PSA 73:2">eye esusɔ vie ko medze anyi.<verse eid="PSA 73:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 73:3"/>Elabena mebiã ŋu ɖokuiŋudzela esi mekpɔ</para>
  <para style="q2" vid="PSA 73:3">ale si nu le edzi dzem na ame vɔ̃ɖiwoe.<verse eid="PSA 73:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 73:4"/>Hiãkame aɖeke mele wo dzi o,</para>
  <para style="q2" vid="PSA 73:4">eye wole lãmesẽ kple dedinɔnɔ me.<verse eid="PSA 73:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 73:5"/>Wovo tso agba siwo tena ɖe amewo dzi la me,</para>
  <para style="q2" vid="PSA 73:5">eye amegbetɔwo ƒe hiãtuame aɖeke mele wo dzi o.<verse eid="PSA 73:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 73:6"/>Eya ta dada nye woƒe kɔga,</para>
  <para style="q2" vid="PSA 73:6">eye wodo nu vɔ̃ɖi wɔwɔ abe awu ene.<verse eid="PSA 73:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 73:7"/>Dzidada dona tso woƒe dzi si ku atri la me,</para>
  <para style="q2" vid="PSA 73:7">eye seɖoƒe meli na woƒe susu ƒe nu vɔ̃ɖiwo ɖoɖo o.<verse eid="PSA 73:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 73:8"/>Woɖua fewu, ƒoa nu vlodoametɔe,</para>
  <para style="q2" vid="PSA 73:8">eye le woƒe dada me la, woklẽa ŋku ɖe amewo be woabɔbɔ na wo.<verse eid="PSA 73:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 73:9"/>Woƒe nuwo xɔ dziƒo wɔ wo tɔe,</para>
  <para style="q2" vid="PSA 73:9">eye woƒe aɖewo xɔ anyigba wòzu wo tɔ.<verse eid="PSA 73:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 73:10"/>Eya ta woƒe amewo trɔ ɖe wo gbɔ,</para>
  <para style="q2" vid="PSA 73:10">eye wono tsi fũu.<verse eid="PSA 73:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 73:11"/>Wogblɔ be, “Aleke Mawu awɔ anya?</para>
  <para style="q2" vid="PSA 73:11">Ɖe nunya le Dziƒoʋĩtɔ la sia?”<verse eid="PSA 73:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 73:12"/>Aleae ame vɔ̃ɖiwo le,</para>
  <para style="q2" vid="PSA 73:12">wole ablɔɖe me ɣe sia ɣi, eye wodzia woƒe kesinɔnuwo ɖe edzi.<verse eid="PSA 73:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 73:13"/>Nyateƒee, dzodzro ko wònye be mewɔ nye dzi dzadzɛ,</para>
  <para style="q2" vid="PSA 73:13">eye dzodzroe meklɔ nye asi ɖe fɔmaɖimaɖi me.<verse eid="PSA 73:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 73:14"/>Mekpea fu ŋkeke blibo la,</para>
  <para style="q2" vid="PSA 73:14">eye ŋdi sia ŋdi wohea to nam.<verse eid="PSA 73:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 73:15"/>Ɖe megblɔ be,</para>
  <para style="q2" vid="PSA 73:15">“Ale maƒo nui nye si” la,</para>
  <para style="q2" vid="PSA 73:15">anye ne mede viwòwo asi.<verse eid="PSA 73:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 73:16"/>Enye teteɖeanyi gã aɖe te menɔ</para>
  <para style="q2" vid="PSA 73:16">esi medze agbagba be mase nu siawo gɔme,<verse eid="PSA 73:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 73:17"/>va se ɖe esime mege ɖe Mawu ƒe Kɔkɔeƒe la,</para>
  <para style="q2" vid="PSA 73:17">tete mese afi si woawu nu ɖo la gɔme.<verse eid="PSA 73:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 73:18"/>Vavã, ètsɔ wo ɖo didiƒe,</para>
  <para style="q2" vid="PSA 73:18">eye nètsɔ wo xlã ɖe anyi wogblẽ keŋkeŋ.<verse eid="PSA 73:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 73:19"/>Aleke wohetsrɔ̃ kpata ale,</para>
  <para style="q2" vid="PSA 73:19">ŋɔdzi kplɔ wo dzoe kaba ŋutɔ!<verse eid="PSA 73:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 73:20"/>O! Aƒetɔ, abe ale si drɔ̃e nɔna ne</para>
  <para style="q2" vid="PSA 73:20">ame nyɔ tso alɔ̃ me ene la,</para>
  <para style="q2" vid="PSA 73:20">do vlo wo abe drɔ̃e manyatalenu ene.<verse eid="PSA 73:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 73:21"/>Esi nye dzi bi ɖe dɔ me nam,</para>
  <para style="q2" vid="PSA 73:21">eye nye gbɔgbɔ se veve la,<verse eid="PSA 73:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 73:22"/>mezu bometsila kple numanyala,</para>
  <para style="q2" vid="PSA 73:22">eye mele abe lã tagbɔkukutɔ ene le ŋkuwò me.<verse eid="PSA 73:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 73:23"/>Ke mele gbɔwò ɣe sia ɣi,</para>
  <para style="q2" vid="PSA 73:23">eye nèlé nye ɖusibɔ ɖe asi.<verse eid="PSA 73:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 73:24"/>Èkplɔm le wò aɖaŋudede nu,</para>
  <para style="q2" vid="PSA 73:24">eye àkplɔm emegbe ayi wò ŋutikɔkɔe mee.<verse eid="PSA 73:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 73:25"/>Ame kae le dziƒo nam, negbe wò ko?</para>
  <para style="q2" vid="PSA 73:25">Naneke mele anyigba si medi kpe ɖe ŋuwò o.<verse eid="PSA 73:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 73:26"/>Nye ŋutilã kple nye dzi nu ava yi,</para>
  <para style="q2" vid="PSA 73:26">gake Mawue nye nye dzi ƒe ŋusẽ</para>
  <para style="q2" vid="PSA 73:26">kple nye gomekpɔkpɔ tegbetegbe.<verse eid="PSA 73:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 73:27"/>Ame siwo le adzɔge tso gbɔwò la atsrɔ̃,</para>
  <para style="q2" vid="PSA 73:27">elabena ètsrɔ̃ ame siwo katã meto nyateƒe na wo o.<verse eid="PSA 73:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 73:28"/>Ke nye ya la, enyo be mate ɖe Mawu ŋu.</para>
  <para style="q2" vid="PSA 73:28">Aƒetɔ Yehowae mewɔ nye sitsoƒee,</para>
  <para style="q2" vid="PSA 73:28">maxlẽ wò nuwɔwɔwo katã afia.<verse eid="PSA 73:28"/></para>
  <chapter eid="PSA 73"/>
  <chapter number="74" style="c" sid="PSA 74"/>
  <para style="cl">Psalmo 74</para>
  <para style="d">Asaf ƒe nufiameha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 74:1"/>O! Mawu, nu ka ŋuti nègble mí ɖi ɖikaa?</para>
  <para style="q2" vid="PSA 74:1">Nu ka ta wò dɔmedzoe bi ɖe wò alẽ siwo le wò lãnyiƒe ŋuti?<verse eid="PSA 74:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 74:2"/>Ɖo ŋku ame siwo nèƒle le blema,</para>
  <para style="q2" vid="PSA 74:2">dukɔ si nye wò domenyinu,</para>
  <para style="q2" vid="PSA 74:2">ame siwo nèɖe kple Zion, to afi si nènɔ la dzi.<verse eid="PSA 74:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 74:3"/>Trɔ ɖe gli siwo gbã ɖikaɖika la ŋu,</para>
  <para style="q2" vid="PSA 74:3">gbegblẽ siawoe futɔ la he va wò teƒe kɔkɔe lae.<verse eid="PSA 74:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 74:4"/>Wò futɔwo le gbe ɖem le afi si nèdo go mí le;</para>
  <para style="q2" vid="PSA 74:4">wova tsi woƒe aflaga ɖe teƒe la be wòanye dzesi anɔ afi ma.<verse eid="PSA 74:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 74:5"/>Wole nu wɔm abe ŋutsu siwo lé fia ɖe asi</para>
  <para style="q2" vid="PSA 74:5">le ave dodowo me be woalã atiwo ene.<verse eid="PSA 74:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 74:6"/>Wotsɔ woƒe fiawo kple yiwo dza aɖaŋu</para>
  <para style="q2" vid="PSA 74:6">siwo wowɔ ɖe gliawo ŋu.<verse eid="PSA 74:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 74:7"/>Wotɔ dzo wò kɔkɔeƒe la wòbi va anyigba,</para>
  <para style="q2" vid="PSA 74:7">eye wodo gu teƒe si wò Ŋkɔ nɔna.<verse eid="PSA 74:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 74:8"/>Wogblɔ le woƒe dzi me be,</para>
  <para style="q2" vid="PSA 74:8">“Míagbã wo gudugudu!”</para>
  <para style="q1" vid="PSA 74:8">Wotɔ dzo teƒe sia teƒe si wosubɔa Mawu le,</para>
  <para style="q2" vid="PSA 74:8">le anyigba dzi.<verse eid="PSA 74:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 74:9"/>Womegawɔa nukunu aɖeke na mí o;</para>
  <para style="q2" vid="PSA 74:9">womegblẽ nyagblɔɖila aɖeke ɖi o</para>
  <para style="q2" vid="PSA 74:9">eye mía dometɔ aɖeke menya ɣeyiɣi si nu sia nu ava yi o.<verse eid="PSA 74:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 74:10"/>O! Mawu, ɣe ka ɣi futɔ la aɖu fewu</para>
  <para style="q2" vid="PSA 74:10">le ŋuwò ase ɖo?</para>
  <para style="q2" vid="PSA 74:10">Ɖe ketɔ la ado vlo wò ŋkɔ tegbeea?<verse eid="PSA 74:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 74:11"/>Nu ka ta nèhe wò asi, wò nuɖusi ɖe megbe ɖo?</para>
  <para style="q2" vid="PSA 74:11">Ɖe wò asi doe le wò awu te, eye nàtsrɔ̃ wo!<verse eid="PSA 74:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 74:12"/>Ke wò la, O Mawu, wòe nye fianye tso blema ke;</para>
  <para style="q2" vid="PSA 74:12">wòe tsɔ ɖeɖe va anyigba la dzi.<verse eid="PSA 74:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 74:13"/>Wòe tsɔ wò ŋusẽ ma atsiaƒu,</para>
  <para style="q2" vid="PSA 74:13">eye nègbã tɔmelã dziŋɔwo ƒe ta le tsiwo me.<verse eid="PSA 74:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 74:14"/>Wòe gbã Leviatan ƒe ta,</para>
  <para style="q2" vid="PSA 74:14">eye nètsɔe wɔ nuɖuɖui na gbemelãwo.<verse eid="PSA 74:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 74:15"/>Wòe ʋu nu le tsitsetsewo</para>
  <para style="q2" vid="PSA 74:15">kple tɔʋuwo nu wosi bababa,</para>
  <para style="q2" vid="PSA 74:15">eye wòe na tɔ siwo sina ɖaa la mie.<verse eid="PSA 74:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 74:16"/>Ŋkeke nye tɔwò, eye zã hã tɔwòe;</para>
  <para style="q2" vid="PSA 74:16">wòe wɔ ɣe kple ɣleti.<verse eid="PSA 74:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 74:17"/>Wòe ɖo liƒo na anyigba,</para>
  <para style="q2" vid="PSA 74:17">eye wòe wɔ vuvɔŋɔli kple dzomeŋɔli.<verse eid="PSA 74:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 74:18"/>O! Yehowa, ɖo ŋku ale si futɔ la do vlo wò</para>
  <para style="q2" vid="PSA 74:18">kple ale si bometsilawo ɖe alɔme le wò ŋkɔ ŋuti la dzi.<verse eid="PSA 74:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 74:19"/>Mègatsɔ wò akpakpa ƒe agbe de asi na lãwɔadãwo o,</para>
  <para style="q2" vid="PSA 74:19">eye mègaŋlɔ wò hiãtɔwo ƒe gbe be ɖikaa o.<verse eid="PSA 74:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 74:20"/>Tsɔ ɖe le wò nubabla la me,</para>
  <para style="q2" vid="PSA 74:20">elabena ŋutasesẽ ƒe wɔnawo yɔ anyigba la ƒe ɣaɣlɛƒewo fũu.<verse eid="PSA 74:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 74:21"/>Mègana ame siwo wote ɖe anyi la</para>
  <para style="q2" vid="PSA 74:21">nate gbugbɔɖemegbe kple ŋukpe o;</para>
  <para style="q2" vid="PSA 74:21">ke boŋ ame dahewo kple hiãtɔwo nekafu wò ŋkɔ.<verse eid="PSA 74:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 74:22"/>O! Mawu, tso eye nàʋli wò bubu ta;</para>
  <para style="q2" vid="PSA 74:22">ɖo ŋku ale si bometsilawo le alɔme ɖem</para>
  <para style="q2" vid="PSA 74:22">le ŋuwò ŋkeke blibo lae dzi.<verse eid="PSA 74:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 74:23"/>Mègado toku wò futɔwo ƒe ʋunyaʋunyawɔwɔ,</para>
  <para style="q2" vid="PSA 74:23">kple wò ketɔwo ƒe howɔwɔ si le dzi dem ɖaa la o.<verse eid="PSA 74:23"/></para>
  <chapter eid="PSA 74"/>
  <chapter number="75" style="c" sid="PSA 75"/>
  <para style="cl">Psalmo 75</para>
  <para style="d">Asaf ƒe ha na hɛnɔ la, ne woadzii ɖe “Mègagblẽ nu o” ƒe gbeɖiɖi nu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 75:1"/>O! Mawu, míeda akpe na wò,</para>
  <para style="q2" vid="PSA 75:1">míeda akpe na wò, elabena wò ŋkɔ tsɔ ɖe mía gbɔ,</para>
  <para style="q2" vid="PSA 75:1">eye amewo le wò nukunuwo xlẽm fia.<verse eid="PSA 75:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 75:2"/>Ègblɔ be, “Meɖo ɣeyiɣi da ɖi,</para>
  <para style="q2" vid="PSA 75:2">elabena nyee adrɔ̃ ʋɔnu le dzɔdzɔenyenye me.<verse eid="PSA 75:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 75:3"/>Ne anyigba kple edzinɔlawo ʋuʋu kpekpekpe la,</para>
  <para style="q2" vid="PSA 75:3">nyee léa eƒe sɔtiwo ɖe asi sesĩe. <char style="qs">Sela</char><verse eid="PSA 75:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 75:4"/>Megblɔ na ɖokuiŋudzelawo be,</para>
  <para style="q2" vid="PSA 75:4">‘Midzudzɔ dada,’</para>
  <para style="q1" vid="PSA 75:4">eye na ame vɔ̃ɖi be,</para>
  <para style="q2" vid="PSA 75:4">‘Mègakɔ wò dzo ɖe dzi o.<verse eid="PSA 75:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 75:5"/>Mègakɔ wò dzowo ɖe dzi ɖe dziƒo ŋu o,</para>
  <para style="q2" vid="PSA 75:5">eye mègahe ve hafi nànɔ nu ƒom o.’ ”<verse eid="PSA 75:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 75:6"/>Dodoɖedzi metsoa ɣedzeƒe,</para>
  <para style="q2" vid="PSA 75:6">ɣetoɖoƒe alo gbegbe vana na ame o,<verse eid="PSA 75:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 75:7"/>ke boŋ Mawue nye afiatsola,</para>
  <para style="q2" vid="PSA 75:7">eɖea ame sia le zi dzi,</para>
  <para style="q2" vid="PSA 75:7">eye wòdoa ame kemɛ ɖe dzi.<verse eid="PSA 75:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 75:8"/>Kplu aɖe le Yehowa ƒe asi me,</para>
  <para style="q2" vid="PSA 75:8">wain si lɔ fu ɖe nu, eye wotsɔ nu ʋeʋĩ tɔtɔe la le eme;</para>
  <para style="q1" vid="PSA 75:8">ekui na ame vɔ̃ɖi siwo le anyigba dzi,</para>
  <para style="q2" vid="PSA 75:8">wonoe, no ahaƒã si le egɔme la hã ƒiaƒiaƒia.<verse eid="PSA 75:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 75:9"/>Ke nye la, manɔ esia gblɔm ɖaa be;</para>
  <para style="q2" vid="PSA 75:9">madzi kafukafuha na Yakob ƒe Mawu la;<verse eid="PSA 75:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 75:10"/>maŋe ame vɔ̃ɖiwo ƒe dzowo,</para>
  <para style="q2" vid="PSA 75:10">ke woado ame dzɔdzɔewo ƒe dzowo ɖe dzi.<verse eid="PSA 75:10"/></para>
  <chapter eid="PSA 75"/>
  <chapter number="76" style="c" sid="PSA 76"/>
  <para style="cl">Psalmo 76</para>
  <para style="d">Asaf ƒe ha na hɛnɔ la. Woadzii ɖe kasaŋku ŋu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 76:1"/>Wonya Mawu le Yuda,</para>
  <para style="q2" vid="PSA 76:1">eye eƒe ŋkɔ lolo le Israel.<verse eid="PSA 76:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 76:2"/>Eƒe agbadɔ le Salem,</para>
  <para style="q2" vid="PSA 76:2">eye eƒe nɔƒe le Zion.<verse eid="PSA 76:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 76:3"/>Afi ma wòŋe aŋutrɔ bibiwo,</para>
  <para style="q2" vid="PSA 76:3">akpoxɔnuwo kple yiwo le, nu siwo nye aʋawɔnuwo. <char style="qs">Sela</char><verse eid="PSA 76:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 76:4"/>Keklẽ geɖe ƒo xlã wò,</para>
  <para style="q2" vid="PSA 76:4">eye nènya kpɔ sãsãsã wu to siwo me adelã le fũu la.<verse eid="PSA 76:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 76:5"/>Woha kalẽtɔwo, wodɔ woƒe alɔ̃ mamlɛtɔ;</para>
  <para style="q2" vid="PSA 76:5">aʋawɔla siawo dometɔ ɖeka pɛ</para>
  <para style="q2" vid="PSA 76:5">hã magate ŋu akɔ eƒe asiwo dzi o.<verse eid="PSA 76:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 76:6"/>O! Yakob ƒe Mawu, esi nèblu ko la,</para>
  <para style="q2" vid="PSA 76:6">sɔ kple tasiaɖam siaa tɔ ɖe teƒe ɖeka.<verse eid="PSA 76:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 76:7"/>Wò ko wòle be woavɔ̃.</para>
  <para style="q2" vid="PSA 76:7">Ame ka ate ŋu anɔ te ɖe nuwò ne èdo dɔmedzoe?<verse eid="PSA 76:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 76:8"/>Èɖe gbeƒã wò afiatsotso tso dziƒo,</para>
  <para style="q2" vid="PSA 76:8">anyigba vɔ̃, eye wòzi ɖoɖoe.<verse eid="PSA 76:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 76:9"/>O! Mawu, esi nètso be yeatso afia,</para>
  <para style="q2" vid="PSA 76:9">aɖe anyigba la ƒe hiãtɔwo la,</para>
  <para style="q2" vid="PSA 76:9">nu sia nu zi ɖoɖoe. <char style="qs">Sela</char><verse eid="PSA 76:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 76:10"/>Vavã, wò dziku helĩhelĩ ɖe amewo ŋu,</para>
  <para style="q2" vid="PSA 76:10">he kafukafu vɛ na wò, eye ame siwo tsi agbe</para>
  <para style="q2" vid="PSA 76:10">le wò dziku la megbe la dze akɔ anyi.<verse eid="PSA 76:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 76:11"/>Miɖe adzɔgbe na Yehowa, miaƒe Mawu la,</para>
  <para style="q2" vid="PSA 76:11">eye mixe adzɔgbeɖefeawo;</para>
  <para style="q1" vid="PSA 76:11">anyigba siwo katã ƒo xlã mi la</para>
  <para style="q2" vid="PSA 76:11">netsɔ nunanawo vɛ na Ame si wòle be woavɔ̃ la.<verse eid="PSA 76:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 76:12"/>Etsi dziɖulawo ƒe gbɔgbɔ nu;</para>
  <para style="q2" vid="PSA 76:12">anyigbadzifiawo katã vɔ̃nɛ.<verse eid="PSA 76:12"/></para>
  <chapter eid="PSA 76"/>
  <chapter number="77" style="c" sid="PSA 77"/>
  <para style="cl">Psalmo 77</para>
  <para style="d">Asaf ƒe ha na Hɛnɔ Yedutun.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 77:1"/>Medo ɣli na Mawu be wòaxɔ nam;</para>
  <para style="q2" vid="PSA 77:1">medo ɣli na Mawu be wòaɖo tom.<verse eid="PSA 77:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 77:2"/>Esi meɖo xaxa me la, medi Aƒetɔ la;</para>
  <para style="q2" vid="PSA 77:2">le zã me la, meke nye abɔwo me, gake ɖeɖi mete wo ŋu o,</para>
  <para style="q2" vid="PSA 77:2">eye nye luʋɔ gbe akɔfafaxɔxɔ.<verse eid="PSA 77:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 77:3"/>O! Mawu, meɖo ŋku dziwò, eye meɖe hũu.</para>
  <para style="q2" vid="PSA 77:3">Mele ŋeŋem, eye nu te nye gbɔgbɔ ŋu. <char style="qs">Sela</char><verse eid="PSA 77:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 77:4"/>Èna nye ŋkuwo gbe miamia;</para>
  <para style="q2" vid="PSA 77:4">fuɖeɖewo sɔ gbɔ ale gbegbe be</para>
  <para style="q2" vid="PSA 77:4">nyemate ŋu aƒo nu o.<verse eid="PSA 77:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 77:5"/>Mebu gbe aɖe gbe ŋkekewo</para>
  <para style="q2" vid="PSA 77:5">kple blemaƒewo ŋu.<verse eid="PSA 77:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 77:6"/>Tete meɖo ŋku ha siwo medzina le zã me la dzi.</para>
  <para style="q2" vid="PSA 77:6">Nye dzi gbã, eye nye gbɔgbɔ bia be:<verse eid="PSA 77:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 77:7"/>“Ɖe Aƒetɔ la agbe ame tegbetegbea?</para>
  <para style="q2" vid="PSA 77:7">Ɖe magave ame nu akpɔ oa?<verse eid="PSA 77:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 77:8"/>Ɖe eƒe lɔlɔ̃ si meʋãna o la vɔ tegbetegbea?</para>
  <para style="q2" vid="PSA 77:8">Ɖe eƒe ŋugbedodo vɔ hena ɣeyiɣiawo katã?<verse eid="PSA 77:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 77:9"/>Ɖe Mawu ŋlɔ nublanuikpɔkpɔ bea?</para>
  <para style="q2" vid="PSA 77:9">Ɖe wòɖo asi eƒe dɔmenyonyo dzi le dɔmedzoe ta?” <char style="qs">Sela</char><verse eid="PSA 77:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 77:10"/>Tete megblɔ be,</para>
  <para style="q2" vid="PSA 77:10">“Dziƒoʋĩtɔ la ƒe nuɖusi ƒe ƒewo ko maƒo koko na.”<verse eid="PSA 77:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 77:11"/>Maɖo ŋku Yehowa ƒe nuwɔwɔwo dzi,</para>
  <para style="q2" vid="PSA 77:11">ɛ̃, maɖo ŋku nukunu siwo nèwɔ le blema la dzi.<verse eid="PSA 77:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 77:12"/>Made ŋugble le wò dɔwɔwɔwo katã ŋu,</para>
  <para style="q2" vid="PSA 77:12">eye mabu ta me le wò nuwɔwɔ dzɔatsuwo ŋu.<verse eid="PSA 77:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 77:13"/>O! Mawu, wò mɔwo le kɔkɔe</para>
  <para style="q2" vid="PSA 77:13">mawu kae lolo abe míaƒe Mawu la ene?<verse eid="PSA 77:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 77:14"/>Wòe nye Mawu si wɔ nukunuwo,</para>
  <para style="q2" vid="PSA 77:14">eye nèɖe wò ŋusẽ fia le dukɔwo dome.<verse eid="PSA 77:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 77:15"/>Ètsɔ wò abɔ sesẽ la ɖe wò dukɔ la,</para>
  <para style="q2" vid="PSA 77:15">ame siwo nye Yakob kple Yosef ƒe dzidzimeviwo. <char style="qs">Sela</char><verse eid="PSA 77:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 77:16"/>O! Mawu, tsiwo kpɔ wò,</para>
  <para style="q2" vid="PSA 77:16">tsiwo kpɔ wò, eye woŋe,</para>
  <para style="q2" vid="PSA 77:16">gogloƒewo ke hã dzo nyanyanya.<verse eid="PSA 77:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 77:17"/>Lilikpo ɖuɖu tsi bababa,</para>
  <para style="q2" vid="PSA 77:17">dziŋgɔli ɖe gbe, eye wò aŋutrɔwo klẽ dzo bibibi, yi gagbɔ.<verse eid="PSA 77:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 77:18"/>Wose wò gbeɖeɖe le yali me,</para>
  <para style="q2" vid="PSA 77:18">wò dzikedzo klẽ ɖe xexea me,</para>
  <para style="q2" vid="PSA 77:18">eye anyigba ʋuʋu hedzo nyanyanya.<verse eid="PSA 77:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 77:19"/>Wò mɔ to atsiaƒu me, eye wò toƒe</para>
  <para style="q2" vid="PSA 77:19">le tɔ gãwo me, gake womekpɔa wò afɔteƒe o.<verse eid="PSA 77:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 77:20"/>Èkplɔ wò dukɔ abe alẽha ene,</para>
  <para style="q2" vid="PSA 77:20">to Mose kple Aron ƒe asiwo dzi.<verse eid="PSA 77:20"/></para>
  <chapter eid="PSA 77"/>
  <chapter number="78" style="c" sid="PSA 78"/>
  <para style="cl">Psalmo 78</para>
  <para style="d">Asaf ƒe nufiameha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 78:1"/>O! Nye dukɔ, mise nye nufiame,</para>
  <para style="q2" vid="PSA 78:1">eye miɖo to nye numenyawo.<verse eid="PSA 78:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 78:2"/>Make nye nu, aƒo nu le lododowo me.</para>
  <para style="q2" vid="PSA 78:2">Magblɔ nu siwo le ɣaɣla,</para>
  <para style="q2" vid="PSA 78:2">nu siwo li tso blema ke.<verse eid="PSA 78:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 78:3"/>Nu siwo míese, eye míenya,</para>
  <para style="q2" vid="PSA 78:3">nu siwo mía fofowo tsɔ tu xoe na mí.<verse eid="PSA 78:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 78:4"/>Míawo míaɣlae ɖe mía viwo o,</para>
  <para style="q2" vid="PSA 78:4">ke boŋ míagblɔ Yehowa ƒe dɔwɔwɔ</para>
  <para style="q2" vid="PSA 78:4">siwo dze na kafukafu,</para>
  <para style="q1" vid="PSA 78:4">eƒe ŋusẽ kple nukudɔ</para>
  <para style="q2" vid="PSA 78:4">siwo wòwɔ la na megbeviwo.<verse eid="PSA 78:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 78:5"/>Ewɔ ɖoɖowo na Yakob,</para>
  <para style="q2" vid="PSA 78:5">eye wòɖo se anyi ɖe Israel,</para>
  <para style="q1" vid="PSA 78:5">se siwo ŋu wòde se na</para>
  <para style="q2" vid="PSA 78:5">mía fofowo be woafia wo viwo,<verse eid="PSA 78:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 78:6"/>ale be dzidzime megbetɔwo hã nanya wo,</para>
  <para style="q2" vid="PSA 78:6">eye vi siwo womedzi haɖe o hã nanya wo,</para>
  <para style="q2" vid="PSA 78:6">ne woawo hã nafia wo viwo.<verse eid="PSA 78:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 78:7"/>Ekema woatsɔ woƒe mɔkpɔkpɔ ada ɖe Mawu dzi,</para>
  <para style="q2" vid="PSA 78:7">eye womaŋlɔ eƒe nuwɔwɔwo be o,</para>
  <para style="q2" vid="PSA 78:7">ke boŋ woalé eƒe sewo me ɖe asi.<verse eid="PSA 78:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 78:8"/>Ke womanɔ abe wo fofo kɔlialiatɔwo,</para>
  <para style="q2" vid="PSA 78:8">dzidzime dzeaglã,</para>
  <para style="q1" vid="PSA 78:8">ame siwo ƒe dzi meku ɖe Mawu ŋu o,</para>
  <para style="q2" vid="PSA 78:8">eye woƒe gbɔgbɔ meto nyateƒe nɛ o la ene o.<verse eid="PSA 78:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 78:9"/>Togbɔ be aŋutrɔwo le Efraimtɔwo si hã la,</para>
  <para style="q2" vid="PSA 78:9">wotrɔ megbe si dzo le aʋakpegbe.<verse eid="PSA 78:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 78:10"/>Womelé Mawu ƒe nubabla me ɖe asi o,</para>
  <para style="q2" vid="PSA 78:10">eye wogbe be yewomanɔ agbe ɖe eƒe se la nu o.<verse eid="PSA 78:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 78:11"/>Woŋlɔ nu si wòwɔ la be,</para>
  <para style="q2" vid="PSA 78:11">esiwo nye nukunu siwo wòɖe fia wo.<verse eid="PSA 78:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 78:12"/>Ewɔ nukunu le wo fofowo ŋkume</para>
  <para style="q2" vid="PSA 78:12">le Egiptenyigba dzi,</para>
  <para style="q2" vid="PSA 78:12">le Zoan nuto me.<verse eid="PSA 78:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 78:13"/>Ema atsiaƒu, hekplɔ wo to emee,</para>
  <para style="q2" vid="PSA 78:13">eye wòna tsi la tɔ dzɔ kã abe glikpɔ ene.<verse eid="PSA 78:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 78:14"/>Etsɔ lilikpo kplɔ woe le ŋkeke me,</para>
  <para style="q2" vid="PSA 78:14">eye wòtsɔ dzo keklẽ kplɔ woe le zã me.<verse eid="PSA 78:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 78:15"/>Efe agakpe me le gbegbe,</para>
  <para style="q2" vid="PSA 78:15">eye wòna tsi wo wòsɔ gbɔ</para>
  <para style="q2" vid="PSA 78:15">abe atsiaƒumetsiwo ene.<verse eid="PSA 78:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 78:16"/>Ena tsi do tso agakpe me</para>
  <para style="q2" vid="PSA 78:16">eye tsi la si bababa abe tɔsisiwo ene.<verse eid="PSA 78:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 78:17"/>Ke woyi edzi gawɔ nu vɔ̃ ɖe eŋu,</para>
  <para style="q2" vid="PSA 78:17">eye wodze aglã ɖe Dziƒoʋĩtɔ la ŋu le gbedzi.<verse eid="PSA 78:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 78:18"/>Wotsɔ woƒe lɔlɔ̃nu te Mawu kpɔ,</para>
  <para style="q2" vid="PSA 78:18">esi wobia nuɖuɖu si le wo dzrom vevie.<verse eid="PSA 78:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 78:19"/>Woƒo nu tsi tsitre ɖe Mawu ŋu be,</para>
  <para style="q2" vid="PSA 78:19">“Ɖe Mawu ate ŋu aɖo kplɔ̃ na mí le gbedzia?<verse eid="PSA 78:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 78:20"/>Esi wòtsɔ nu ƒo agakpe la, tsi do bababa,</para>
  <para style="q2" vid="PSA 78:20">eye tɔʋuwo si kplakplakpla.</para>
  <para style="q1" vid="PSA 78:20">Gake ɖe wòate ŋu ana nuɖuɖu mía?</para>
  <para style="q2" vid="PSA 78:20">Ate ŋu ana lã eƒe dukɔa?”<verse eid="PSA 78:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 78:21"/>Esi Yehowa se wo ŋkɔ la, dzi kui vevie;</para>
  <para style="q2" vid="PSA 78:21">eƒe dzo bi ɖe Yakob ŋu,</para>
  <para style="q2" vid="PSA 78:21">eye eƒe dɔmedzoe de dzi ɖe Israel ŋu,<verse eid="PSA 78:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 78:22"/>elabena womexɔ Mawu dzi se,</para>
  <para style="q2" vid="PSA 78:22">alo ka ɖe eƒe xɔname dzi o.<verse eid="PSA 78:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 78:23"/>Ke hã la, eɖe gbe na lilikpowo le dzi,</para>
  <para style="q2" vid="PSA 78:23">eye wòʋu dziƒo ƒe ʋɔtruwo,<verse eid="PSA 78:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 78:24"/>ena mana dza tso dziƒo na dukɔ la be woaɖu,</para>
  <para style="q2" vid="PSA 78:24">eye wòna bli wo tso dziƒo.<verse eid="PSA 78:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 78:25"/>Amegbetɔ ɖu mawudɔlawo ƒe nuɖuɖu,</para>
  <para style="q2" vid="PSA 78:25">eye wòɖo nuɖuɖu si sinu wohiã la ɖe wo.<verse eid="PSA 78:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 78:26"/>Etu ka ɣedzeƒeya tso dziƒo,</para>
  <para style="q2" vid="PSA 78:26">eye wòkplɔ dzigbeya kple eƒe ŋusẽ.<verse eid="PSA 78:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 78:27"/>Ena lã dza ɖe wo dzi abe ʋuʋudedi ene,</para>
  <para style="q2" vid="PSA 78:27">eye xe dzodzoewo abe ƒutake ene.<verse eid="PSA 78:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 78:28"/>Ena woge dze woƒe asaɖa me,</para>
  <para style="q2" vid="PSA 78:28">eye woƒo xlã woƒe agbadɔwo.<verse eid="PSA 78:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 78:29"/>Ale woɖui ʋuu heɖi ƒo taŋ,</para>
  <para style="q2" vid="PSA 78:29">elabena ewɔ nu si dzrom wole la dzi na wo.<verse eid="PSA 78:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 78:30"/>Ke hafi nuɖuɖu si wodzro la navɔ,</para>
  <para style="q2" vid="PSA 78:30">eye esi wògale nu me na wo ko la,<verse eid="PSA 78:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 78:31"/>Mawu ƒe dɔmedzoe bi ɖe wo ŋu;</para>
  <para style="q2" vid="PSA 78:31">ewu ame sesẽwo le wo dome,</para>
  <para style="q2" vid="PSA 78:31">eye wòlã Israel ɖekakpuiwo ƒu anyi.<verse eid="PSA 78:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 78:32"/>To nu siawo katã gbɔ hã la,</para>
  <para style="q2" vid="PSA 78:32">wogayi nu vɔ̃ wɔwɔ dzi,</para>
  <para style="q1" vid="PSA 78:32">eye togbɔ be ewɔ nukunuwo hã la,</para>
  <para style="q2" vid="PSA 78:32">womexɔe se o.<verse eid="PSA 78:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 78:33"/>Ale wòna woƒe ŋkekewo wu nu nanekemakpɔkpɔe,</para>
  <para style="q2" vid="PSA 78:33">eye woƒe ƒewo wu nu le ŋɔdzi me.<verse eid="PSA 78:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 78:34"/>Ɣe sia ɣi si ke Mawu wu wo ko la,</para>
  <para style="q2" vid="PSA 78:34">wodinɛ, eye wogatrɔna ɖe eŋu kple vevidodo.<verse eid="PSA 78:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 78:35"/>Woɖoa ŋku edzi be Mawue nye woƒe Agakpe,</para>
  <para style="q2" vid="PSA 78:35">eye Mawu Dziƒoʋĩtɔ lae nye woƒe Ɖela.<verse eid="PSA 78:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 78:36"/>Ke emegbe la, wotsɔa woƒe nu flunɛ,</para>
  <para style="q2" vid="PSA 78:36">eye wotsɔa woƒe aɖe daa alakpa nɛ.<verse eid="PSA 78:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 78:37"/>Woƒe dziwo meku ɖe eŋu vavã o,</para>
  <para style="q2" vid="PSA 78:37">eye womewɔ eƒe nubabla dzi le nyateƒe me o.<verse eid="PSA 78:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 78:38"/>Gake ekpɔ nublanui na wo;</para>
  <para style="q2" vid="PSA 78:38">etsɔ woƒe vodadawo ke wo, eye metsrɔ̃ wo o.</para>
  <para style="q1" vid="PSA 78:38">Zi geɖe la, eɖoa asi eƒe dziku dzi,</para>
  <para style="q2" vid="PSA 78:38">eye menaa eƒe dɔmedzoe katã bina o.<verse eid="PSA 78:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 78:39"/>Eɖo ŋku edzi be ŋutilã ko wonye,</para>
  <para style="q2" vid="PSA 78:39">eye wonye ya si ƒona yina gake megatrɔna gbɔna o.<verse eid="PSA 78:39"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 78:40"/>Zi nenie womedze aglã ɖe eŋu le gbedzi,</para>
  <para style="q2" vid="PSA 78:40">eye womedo vevesese nɛ le kuɖiɖinyigba dzi o!<verse eid="PSA 78:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 78:41"/>Enuenu wotea Mawu kpɔna,</para>
  <para style="q2" vid="PSA 78:41">eye wodoa dziku na Israel ƒe Kɔkɔetɔ la.<verse eid="PSA 78:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 78:42"/>Womeɖo ŋku eƒe ŋusẽ dzi,</para>
  <para style="q2" vid="PSA 78:42">gbe si gbe wòɖe wo tso ŋutasẽla ƒe asi me,<verse eid="PSA 78:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 78:43"/>gbe si gbe wòɖe eƒe nukudzesiwo fia</para>
  <para style="q2" vid="PSA 78:43">le Egipte kple eƒe nukudɔwo fia le Zoan nuto me o.<verse eid="PSA 78:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 78:44"/>Etrɔ woƒe tɔsisiwo wozu ʋu,</para>
  <para style="q2" vid="PSA 78:44">eye womete ŋu no woƒe tɔʋumetsi o.<verse eid="PSA 78:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 78:45"/>Eɖo togbato ƒe ha gã aɖe ɖe wo dome,</para>
  <para style="q2" vid="PSA 78:45">woɖu wo kple akpɔkplɔwo wogblẽ woƒe nuwo.<verse eid="PSA 78:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 78:46"/>Etsɔ woƒe nukuwo na ʋetrawo</para>
  <para style="q2" vid="PSA 78:46">kple woƒe kutsetsewo na ʋetsuviwo.<verse eid="PSA 78:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 78:47"/>Egblẽ woƒe waingblewo kple kpetsi,</para>
  <para style="q2" vid="PSA 78:47">eye woƒe gbotiwo kple tsidzadza sesẽ.<verse eid="PSA 78:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 78:48"/>Etsɔ woƒe nyihawo na kpetsi,</para>
  <para style="q2" vid="PSA 78:48">eye wòtsɔ woƒe lãhawo na dzikedzo.<verse eid="PSA 78:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 78:49"/>Eɖo eƒe dɔmedzoe nyanyra,</para>
  <para style="q2" vid="PSA 78:49">dziku helĩhelĩ, xaxa kple fuwɔame,</para>
  <para style="q2" vid="PSA 78:49">siwo nye mawudɔla siwo gblẽa nu la ɖe wo.<verse eid="PSA 78:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 78:50"/>Eɖe mɔ ɖi na eƒe dɔmedzoe;</para>
  <para style="q2" vid="PSA 78:50">meɖe woƒe agbe tso ku me o,</para>
  <para style="q2" vid="PSA 78:50">ke boŋ etsɔ wo de asi na dɔvɔ̃.<verse eid="PSA 78:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 78:51"/>Ewu Egiptetɔwo ƒe ŋgɔgbevi</para>
  <para style="q2" vid="PSA 78:51">siwo nye woƒe ŋutsunyenye</para>
  <para style="q2" vid="PSA 78:51">ƒe kutsetse gbãtɔwo le Ham gbadɔwo te.<verse eid="PSA 78:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 78:52"/>Gake ekplɔ eƒe dukɔ la abe lãhawo ene,</para>
  <para style="q2" vid="PSA 78:52">eye wòkplɔ wo abe alẽwo ene to gbedzi.<verse eid="PSA 78:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 78:53"/>Ekplɔ wo le dedinɔnɔ me, ale be womevɔ̃ o,</para>
  <para style="q2" vid="PSA 78:53">gake ƒu la tsyɔ woƒe futɔwo dzi.<verse eid="PSA 78:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 78:54"/>Ale wòkplɔ wo va eƒe anyigba kɔkɔe la ƒe liƒo dzi,</para>
  <para style="q2" vid="PSA 78:54">va tonyigba si eƒe nuɖusi xɔ la gbɔ.<verse eid="PSA 78:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 78:55"/>Enya dukɔwo le wo ŋgɔ,</para>
  <para style="q2" vid="PSA 78:55">eye wòma woƒe anyigba na wo be</para>
  <para style="q1" vid="PSA 78:55">wòanye woƒe domenyinu,</para>
  <para style="q2" vid="PSA 78:55">eye wòna Israel ƒe toawo nɔ woƒe aƒewo me.<verse eid="PSA 78:55"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 78:56"/>Ke wote Mawu kpɔ,</para>
  <para style="q2" vid="PSA 78:56">wodze aglã ɖe Dziƒoʋĩtɔ la ŋu,</para>
  <para style="q2" vid="PSA 78:56">eye womelé eƒe sewo me ɖe asi o.<verse eid="PSA 78:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 78:57"/>Abe wo fofowo ene la,</para>
  <para style="q2" vid="PSA 78:57">womeɖo to o, wowɔ nu dzimaxɔsetɔe,</para>
  <para style="q1" vid="PSA 78:57">eye wole abe dati doagblɔ ene,</para>
  <para style="q2" vid="PSA 78:57">elabena womate ŋu aka ɖe wo dzi o.<verse eid="PSA 78:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 78:58"/>Wotsɔ woƒe nuxeƒewo do dɔmedzoe nɛ,</para>
  <para style="q2" vid="PSA 78:58">eye woƒe legbawo na ŋuʋaʋã tso le eya amea me.<verse eid="PSA 78:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 78:59"/>Esi Mawu se wo ŋkɔ la, dzi kui vevie ŋutɔ,</para>
  <para style="q2" vid="PSA 78:59">eye wògbe Israel keŋkeŋ.<verse eid="PSA 78:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 78:60"/>Ale wògblẽ agbadɔ si le Silo la ɖi,</para>
  <para style="q2" vid="PSA 78:60">agbadɔ si wòtu ɖe amegbetɔwo dome.<verse eid="PSA 78:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 78:61"/>Eɖo nubablaɖaka si nye eƒe ŋusẽ la ɖe aboyome,</para>
  <para style="q2" vid="PSA 78:61">eye wòtsɔ eƒe atsyɔ̃nu de asi na futɔ la.<verse eid="PSA 78:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 78:62"/>Etsɔ eƒe dukɔ de asi na yi,</para>
  <para style="q2" vid="PSA 78:62">eye wòdo dɔmedzoe vevie ɖe</para>
  <para style="q2" vid="PSA 78:62">eƒe domenyinu la ŋu.<verse eid="PSA 78:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 78:63"/>Ena dzo fia eƒe ɖekakpuiwo,</para>
  <para style="q2" vid="PSA 78:63">eye womedzi srɔ̃ɖeha na eƒe ɖetugbiwo o.<verse eid="PSA 78:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 78:64"/>Wotsɔ woƒe nunɔlawo de asi na yi,</para>
  <para style="q2" vid="PSA 78:64">eye avi bu ɖe woƒe ahosiwo.<verse eid="PSA 78:64"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 78:65"/>Tete Aƒetɔ la nyɔ tso alɔ̃ me abe ale si aha kɔna</para>
  <para style="q2" vid="PSA 78:65">le mo na ame si no wain mu la ene.<verse eid="PSA 78:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 78:66"/>Enya eƒe futɔwo do ɖe megbe,</para>
  <para style="q2" vid="PSA 78:66">eye wòdo ŋukpe mavɔ wo.<verse eid="PSA 78:66"/></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 78:67"/>Emegbe la, wògbe nu le Yosef ƒe agbadɔwo gbɔ,</para>
  <para style="q2" vid="PSA 78:67">eye metia Efraim ƒe to la o.<verse eid="PSA 78:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 78:68"/>Ke boŋ etia Yuda ƒe to la,</para>
  <para style="q2" vid="PSA 78:68">esi nye Zion to si wòlɔ̃na vevie.<verse eid="PSA 78:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 78:69"/>Etu eƒe kɔkɔeƒe la abe kɔkɔƒe ene,</para>
  <para style="q2" vid="PSA 78:69">eye abe anyigba si wòli kee tegbetegbe ene.<verse eid="PSA 78:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 78:70"/>Etia David dɔla,</para>
  <para style="q2" vid="PSA 78:70">eye wòɖee le alẽkpo me;<verse eid="PSA 78:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 78:71"/>tso alẽkplɔdɔ me, eye wòkplɔe vɛ be wòakplɔ eƒe dukɔ,</para>
  <para style="q2" vid="PSA 78:71">Yakob kple eƒe domenyinu, Israel.<verse eid="PSA 78:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 78:72"/>David kpɔ wo dzi le dzi dzɔdzɔe me,</para>
  <para style="q2" vid="PSA 78:72">eye wòkplɔ wo le aɖaŋu me.<verse eid="PSA 78:72"/></para>
  <chapter eid="PSA 78"/>
  <chapter number="79" style="c" sid="PSA 79"/>
  <para style="cl">Psalmo 79</para>
  <para style="d">Asaf ƒe ha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 79:1"/>O! Mawu, dukɔwo nye zi ɖe wò domenyinu la dzi,</para>
  <para style="q2" vid="PSA 79:1">wodo gu wò gbedoxɔ kɔkɔe la,</para>
  <para style="q2" vid="PSA 79:1">eye wogbã Yerusalem wòzu anyiglagoe.<verse eid="PSA 79:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 79:2"/>Wotsɔ wò dɔlawo ƒe kukuawo</para>
  <para style="q2" vid="PSA 79:2">na dziƒoxewo abe nuɖuɖu ene,</para>
  <para style="q1" vid="PSA 79:2">eye wotsɔ wò ame kɔkɔeawo ƒe ŋutilã</para>
  <para style="q2" vid="PSA 79:2">na anyigbadzilã wɔadãwo.<verse eid="PSA 79:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 79:3"/>Wokɔ woƒe ʋu ɖi abe tsi ene ƒo xlã Yerusalem,</para>
  <para style="q2" vid="PSA 79:3">eye ame aɖeke meli aɖi ame kukuawo o.<verse eid="PSA 79:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 79:4"/>Míezu fewuɖunu na míaƒe aƒelikawo,</para>
  <para style="q2" vid="PSA 79:4">eye míezu alɔmeɖenu kple vlodonu na ame siwo ƒo xlã mí.<verse eid="PSA 79:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 79:5"/>O! Yehowa, va se ɖe ɣe ka ɣi?</para>
  <para style="q2" vid="PSA 79:5">Ɖe nàdo dɔmedzoe tegbeea?</para>
  <para style="q2" vid="PSA 79:5">Va se ɖe ɣe ka ɣi wò ŋuʋaʋã abi abe dzo ene?<verse eid="PSA 79:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 79:6"/>Trɔ wò dziku helĩhelĩ la kɔ ɖe dukɔ</para>
  <para style="q2" vid="PSA 79:6">siwo menya wò o la dzi</para>
  <para style="q2" vid="PSA 79:6">kple fiaɖuƒe siwo meyɔa wò ŋkɔ o la dzi.<verse eid="PSA 79:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 79:7"/>Elabena wovuvu Yakob,</para>
  <para style="q2" vid="PSA 79:7">eye wogbã eƒe denyigba.<verse eid="PSA 79:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 79:8"/>Mègawɔ na mí ɖe mía fofowo ƒe nu vɔ̃ nu o;</para>
  <para style="q2" vid="PSA 79:8">na wò nublanuikpɔkpɔ nava do go mí kaba,</para>
  <para style="q2" vid="PSA 79:8">elabena míeɖo xaxa gã aɖe me.<verse eid="PSA 79:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 79:9"/>O! Mawu, mía Ɖela,</para>
  <para style="q2" vid="PSA 79:9">kpe ɖe mía ŋu le wò ŋkɔ ƒe bubu ta.</para>
  <para style="q1" vid="PSA 79:9">Ɖe mí, eye nàtsɔ míaƒe nu vɔ̃wo</para>
  <para style="q2" vid="PSA 79:9">ake mí le wò ŋkɔ la ta.<verse eid="PSA 79:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 79:10"/>Nu ka ŋuti dukɔwo agblɔ be,</para>
  <para style="q2" vid="PSA 79:10">“Afi ka woƒe Mawu la le?”</para>
  <para style="b" vid="PSA 79:10"/>
  <para style="q1" vid="PSA 79:10">Le míawo ŋutɔ ƒe ŋkume, na dukɔwo nanya be,</para>
  <para style="q2" vid="PSA 79:10">èbia hlɔ̃ na wò dɔla siwo ƒe ʋu wokɔ ɖi.<verse eid="PSA 79:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 79:11"/>Aʋaléleawo ƒe ŋeŋe neɖo gbɔwò,</para>
  <para style="q2" vid="PSA 79:11">tsɔ wò asi ƒe ŋusẽ ɖe</para>
  <para style="q2" vid="PSA 79:11">ame siwo wotso kufia na.<verse eid="PSA 79:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 79:12"/>O! Aƒetɔ, ɖo vlo, si míaƒe aƒelikawo</para>
  <para style="q2" vid="PSA 79:12">do wò la teƒe na wo zi adre.<verse eid="PSA 79:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 79:13"/>Ekema mí wò dukɔ,</para>
  <para style="q2" vid="PSA 79:13">wò lãnyiƒe ƒe alẽwo akafu wò tegbee,</para>
  <para style="q1" vid="PSA 79:13">eye tso dzidzime yi dzidzime</para>
  <para style="q2" vid="PSA 79:13">míaɖe wò kafukafu afia.<verse eid="PSA 79:13"/></para>
  <chapter eid="PSA 79"/>
  <chapter number="80" style="c" sid="PSA 80"/>
  <para style="cl">Psalmo 80</para>
  <para style="d">Asaf ƒe ha na hɛnɔ la. Woadzii ɖe “Nubabla ƒe Dzogbenya” ƒe gbeɖiɖi nu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 80:1"/>O, Israel ƒe Kplɔla, ɖo to mí,</para>
  <para style="q2" vid="PSA 80:1">wò ame si kplɔ Yosef ƒe dzidzimeviwo abe lãha ene;</para>
  <para style="q1" vid="PSA 80:1">wò ame si nɔ anyi ɖe kerubiwo titina gli,</para>
  <para style="q2" vid="PSA 80:1">klẽ <verse eid="PSA 80:1"/><verse number="2" style="v" sid="PSA 80:2"/>le Efraim, Benyamin kple Manase ŋgɔ.</para>
  <para style="q1" vid="PSA 80:2">Nyɔ wò ŋusẽ,</para>
  <para style="q2" vid="PSA 80:2">va nàxɔ na mí.<verse eid="PSA 80:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 80:3"/>O! Mawu, gaɖo mí te;</para>
  <para style="q2" vid="PSA 80:3">na wò mo naklẽ ɖe mía dzi,</para>
  <para style="q2" vid="PSA 80:3">be míakpɔ xɔxɔ.<verse eid="PSA 80:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 80:4"/>O! Yehowa, Mawu Ŋusẽkatãtɔ,</para>
  <para style="q2" vid="PSA 80:4">va se ɖe ɣe ka ɣi wò dɔmedzoe abi ɖe</para>
  <para style="q2" vid="PSA 80:4">wò dukɔ ƒe gbedodoɖa ŋu?<verse eid="PSA 80:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 80:5"/>Èna aɖatsibolo wo woɖu,</para>
  <para style="q2" vid="PSA 80:5">eye nèna aɖatsi wo wono taŋtaŋ.<verse eid="PSA 80:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 80:6"/>Ètsɔ mí wɔ dzrewɔnui na míaƒe aƒelikawo,</para>
  <para style="q2" vid="PSA 80:6">eye míaƒe futɔwo ɖe alɔme le mía ŋu.<verse eid="PSA 80:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 80:7"/>O! Mawu, Ŋusẽkatãtɔ, gaɖo mí te;</para>
  <para style="q2" vid="PSA 80:7">na wò mo naklẽ ɖe mía dzi,</para>
  <para style="q2" vid="PSA 80:7">be míakpɔ xɔxɔ.<verse eid="PSA 80:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 80:8"/>Ètsɔ wainka tso Egipte,</para>
  <para style="q2" vid="PSA 80:8">ènya dukɔwo, eye nèdoe.<verse eid="PSA 80:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 80:9"/>Èdzra eŋuti ɖo nyuie,</para>
  <para style="q2" vid="PSA 80:9">eye wòto ke hevu tsyɔ anyigba.<verse eid="PSA 80:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 80:10"/>Edo vɔvɔli ɖe towo tame</para>
  <para style="q2" vid="PSA 80:10">eye wòɖe alɔ de sedati kɔkɔwo tame.<verse eid="PSA 80:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 80:11"/>Eɖe alɔ yi ɖe keke ƒuta ke,</para>
  <para style="q2" vid="PSA 80:11">eye eƒe kewo yi ɖe keke Frat tɔsisi la nu ke.<verse eid="PSA 80:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 80:12"/>Nu ka ŋuti nègbã kpɔ le eŋu,</para>
  <para style="q2" vid="PSA 80:12">ale be ame siwo to afi ma yi la fɔ wain tsetsewo?<verse eid="PSA 80:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 80:13"/>Gbehawo nya avuzi le edzi,</para>
  <para style="q2" vid="PSA 80:13">eye gbemelãwo ɖui.<verse eid="PSA 80:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 80:14"/>Trɔ va mía gbɔ, O Mawu, Ŋusẽkatãtɔ!</para>
  <para style="q2" vid="PSA 80:14">Do kɔ ɖa tso dziƒo, eye nàkpɔ nu!</para>
  <para style="q1" vid="PSA 80:14">Kpɔ wainka sia ta,<verse eid="PSA 80:14"/></para>
  <para style="q2">
    <verse number="15" style="v" sid="PSA 80:15"/>ke si wò nuɖusi do,</para>
  <para style="q2" vid="PSA 80:15">viŋutsu si wò ŋutɔ nèhe wòtsi.<verse eid="PSA 80:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 80:16"/>Wolã wò wainka,</para>
  <para style="q2" vid="PSA 80:16">wotɔ dzoe, eye wò mokaname na wò amewo tsrɔ̃.<verse eid="PSA 80:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 80:17"/>Wò asi nenɔ ŋutsu si le wò nuɖusime,</para>
  <para style="q2" vid="PSA 80:17">amegbetɔvi si nènyi na ɖokuiwò la dzi.<verse eid="PSA 80:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 80:18"/>Ekema míatrɔ le yowòme o;</para>
  <para style="q2" vid="PSA 80:18">gbɔ agbe mí, eye míayɔ wò ŋkɔ.<verse eid="PSA 80:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 80:19"/>O! Yehowa, Mawu Ŋusẽkatãtɔ, gaɖo mí te;</para>
  <para style="q2" vid="PSA 80:19">na wò mo nàklẽ ɖe mía dzi be míakpɔ xɔxɔ.<verse eid="PSA 80:19"/></para>
  <chapter eid="PSA 80"/>
  <chapter number="81" style="c" sid="PSA 81"/>
  <para style="cl">Psalmo 81</para>
  <para style="d">Asaf ƒe ha na hɛnɔ la. Woadzii ɖe <char style="tl">gitit</char> ƒe gbeɖiɖi nu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 81:1"/>Midzi ha, mikpɔ dzidzɔ ɖe Mawu, míaƒe ŋusẽ la ŋu,</para>
  <para style="q2" vid="PSA 81:1">eye mitso aseye kple ɣli ɖe Yakob ƒe Mawu la ŋu!<verse eid="PSA 81:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 81:2"/>Mido ha ɖa, xatsɛwo neɖi,</para>
  <para style="q2" vid="PSA 81:2">miƒo kasaŋku kple gakasaŋku siwo ƒe gbe me kɔ.<verse eid="PSA 81:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 81:3"/>Miku lãdzokpẽwo le Dzinu Yeye dzi</para>
  <para style="q2" vid="PSA 81:3">kple ne dzinu sɔ tegblẽe le míaƒe ŋkekenyuiɖugbe.<verse eid="PSA 81:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 81:4"/>Esia nye se na Israel kple ɖoɖo na Yakob ƒe Mawu la.<verse eid="PSA 81:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 81:5"/>Esi Mawu tso ɖe Egiptetɔwo ŋu la,</para>
  <para style="q2" vid="PSA 81:5">eɖoe anyi be wòanye se na Yosef,</para>
  <para style="b" vid="PSA 81:5"/>
  <para style="q1" vid="PSA 81:5">afi si míese gbegbɔgblɔ si gɔme míese o la le:<verse eid="PSA 81:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 81:6"/>Egblɔ be, “Meɖe agba la ɖa le woƒe abɔta,</para>
  <para style="q2" vid="PSA 81:6">eye woɖe woƒe asiwo ɖa le kusi la ŋuti.<verse eid="PSA 81:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 81:7"/>Mieyɔm le miaƒe xaxa me, eye mexɔ na mi.</para>
  <para style="q2" vid="PSA 81:7">Metɔ na mi le dziɖegbelilikpo la me.</para>
  <para style="q2" vid="PSA 81:7">Medo mi kpɔ le Meriba tsi la gbɔ. <char style="qs">Sela</char><verse eid="PSA 81:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 81:8"/>Mísee, o nye dukɔ, maxlɔ̃ nu mi.</para>
  <para style="q2" vid="PSA 81:8">O! Israel, nenye ɖe nàɖo tom ɖe!<verse eid="PSA 81:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 81:9"/>Dzromawu aɖeke maganɔ dowòme o;</para>
  <para style="q2" vid="PSA 81:9">màgade ta agu na mawu tutɔ aɖeke o.<verse eid="PSA 81:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 81:10"/>Nyee nye Yehowa, wò Mawu,</para>
  <para style="q2" vid="PSA 81:10">ame si kplɔ wò do goe tso Egipte.</para>
  <para style="q2" vid="PSA 81:10">Ke wò nu baa, eye mana wòayɔ.<verse eid="PSA 81:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 81:11"/>“Ke nye dukɔ meɖo to nye gbe o;</para>
  <para style="q2" vid="PSA 81:11">Israel gbe, mebɔbɔ eɖokui nam o,<verse eid="PSA 81:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 81:12"/>eya ta meɖe asi le wo ŋu na</para>
  <para style="q2" vid="PSA 81:12">woƒe dzi sesẽwo, ne woadze nu</para>
  <para style="q2" vid="PSA 81:12">siwo woawo ŋutɔ ɖo la yome.<verse eid="PSA 81:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 81:13"/>“Ɖe wònye nye dukɔ aɖo tom,</para>
  <para style="q2" vid="PSA 81:13">eye Israel nazɔ nye mɔwo dzi la,<verse eid="PSA 81:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 81:14"/>aleke nyemahabɔbɔ woƒe futɔwo ɖe anyii kaba,</para>
  <para style="q2" vid="PSA 81:14">eye nyemahakɔ nye asiwo dzi ɖe woƒe ketɔwo ŋui o!<verse eid="PSA 81:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 81:15"/>Ame siwo lé fu Yehowa la ada alakpa le eŋkume,</para>
  <para style="q2" vid="PSA 81:15">eye woƒe tohehe anɔ anyi tegbee.<verse eid="PSA 81:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 81:16"/>Ke míaɖu bliwɔ nyuitɔ,</para>
  <para style="q2" vid="PSA 81:16">eye matsɔ kpetomenyitsi aɖi ƒoe na mi.”<verse eid="PSA 81:16"/></para>
  <chapter eid="PSA 81"/>
  <chapter number="82" style="c" sid="PSA 82"/>
  <para style="cl">Psalmo 82</para>
  <para style="d">Asaf ƒe ha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 82:1"/>Mawu nɔ zi me na takpekpe gã la,</para>
  <para style="q2" vid="PSA 82:1">eye wòdrɔ̃ ʋɔnu le “mawuwo” dome.<verse eid="PSA 82:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 82:2"/>“Va se ɖe ɣe ka ɣi miaʋli ame baɖa la ta,</para>
  <para style="q2" vid="PSA 82:2">eye miatso afia ade ame vɔ̃ɖi la dzi?” <char style="qs">Sela</char><verse eid="PSA 82:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 82:3"/>“Miʋli ame gblɔewo kple tsyɔ̃eviwo ta,</para>
  <para style="q2" vid="PSA 82:3">eye miwɔ dɔmenyo na hiãtɔwo kple ame siwo wote ɖe to.<verse eid="PSA 82:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 82:4"/>Mixɔ na ame gblɔewo kple hiãtɔwo,</para>
  <para style="q2" vid="PSA 82:4">eye miɖe wo tso ame vɔ̃ɖiwo ƒe asi me.<verse eid="PSA 82:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 82:5"/>“Womenya naneke o, womese naneke gɔme o.</para>
  <para style="q2" vid="PSA 82:5">Wole zɔzɔm le blukɔ me,</para>
  <para style="q2" vid="PSA 82:5">eye anyigba ƒe agunuwo katã ʋuʋu.<verse eid="PSA 82:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 82:6"/>“Megblɔ be, ‘Mawuwoe mienye;</para>
  <para style="q2" vid="PSA 82:6">mi katã mienye Dziƒoʋĩtɔ la ƒe viŋutsuwo’,<verse eid="PSA 82:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 82:7"/>gake miaku abe amegbetɔwo ko ene</para>
  <para style="q2" vid="PSA 82:7">eye miatsi aʋa abe fia ɖe sia ɖe ko ene.”<verse eid="PSA 82:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 82:8"/>O! Mawu, tso, eye nàdrɔ̃ ʋɔnu anyigba la</para>
  <para style="q2" vid="PSA 82:8">elabena dukɔwo katã nye wò domenyinu.<verse eid="PSA 82:8"/></para>
  <chapter eid="PSA 82"/>
  <chapter number="83" style="c" sid="PSA 83"/>
  <para style="cl">Psalmo 83</para>
  <para style="d">Asaf ƒe ha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 83:1"/>O! Mawu, mègazi kpi o,</para>
  <para style="q2" vid="PSA 83:1">O! Mawu, mègazi ɖoɖoe o,</para>
  <para style="q2" vid="PSA 83:1">mèganɔ anyi kpoo o.<verse eid="PSA 83:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 83:2"/>Kpɔ ale si wò futɔwo le nyanyram ɖa,</para>
  <para style="q2" vid="PSA 83:2">kpɔ ale si wò ketɔwo kɔ ta dzii ɖa.<verse eid="PSA 83:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 83:3"/>Wole nu baɖa ɖom ɖe wò dukɔ ŋu le ayeme,</para>
  <para style="q2" vid="PSA 83:3">eye woɖo nugbe ɖe ame siwo nèlɔ̃na la ŋu.<verse eid="PSA 83:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 83:4"/>Wogblɔ be, “Miva, míatsrɔ̃ wo, be womaganye dukɔ o,</para>
  <para style="q2" vid="PSA 83:4">eye womagaɖo ŋku Israel ƒe ŋkɔ dzi akpɔ gbeɖe o.”<verse eid="PSA 83:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 83:5"/>Wotsɔ tameɖoɖo ɖeka de adaŋu,</para>
  <para style="q2" vid="PSA 83:5">eye wobla ɖe ŋuwò,<verse eid="PSA 83:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 83:6"/>ame siwo le Edom ƒe agbadɔwo me,</para>
  <para style="q2" vid="PSA 83:6">Ismaelitɔwo, Moabtɔwo, Hagritɔwo,<verse eid="PSA 83:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 83:7"/>Gebalitɔwo, Amonviwo, Amalekitɔwo,</para>
  <para style="q2" vid="PSA 83:7">Filistitɔwo kple ame siwo tso Tiro.<verse eid="PSA 83:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 83:8"/>Asiria gɔ̃ hã kpe ɖe wo ŋu,</para>
  <para style="q2" vid="PSA 83:8">be wòado alɔ Lot ƒe dzidzimeviwo. <char style="qs">Sela</char><verse eid="PSA 83:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 83:9"/>Wɔ wo abe ale si nèwɔ Midian,</para>
  <para style="q2" vid="PSA 83:9">Sisera kple Yabin le Kison tɔsisi la to ene,<verse eid="PSA 83:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 83:10"/>ame siwo tsrɔ̃ le Endor,</para>
  <para style="q2" vid="PSA 83:10">eye wole abe gbeɖuɖɔ ene le anyigba.<verse eid="PSA 83:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 83:11"/>Wɔ woƒe bubumewo abe Oreb kple Zeb ene,</para>
  <para style="q2" vid="PSA 83:11">eye woƒe dumegãwo abe Zeba kple Zalmuna ene,<verse eid="PSA 83:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 83:12"/>ame siwo gblɔ be,</para>
  <para style="q2" vid="PSA 83:12">“Mina míaxɔ Mawu ƒe lãnyiƒewo.”<verse eid="PSA 83:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 83:13"/>O! Nye Mawu, wɔ wo abe betsyo</para>
  <para style="q2" vid="PSA 83:13">kple blitsa si ya lɔ ɖe nu ene.<verse eid="PSA 83:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 83:14"/>Abe ale si dzo biaa ave,</para>
  <para style="q2" vid="PSA 83:14">alo dzo ƒe aɖe tɔa dzo towo ene la,<verse eid="PSA 83:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 83:15"/>nenemae nàti wo yomee kple wò ya sesẽ,</para>
  <para style="q2" vid="PSA 83:15">eye nàdo ŋɔdzi na wo kple wò ahom.<verse eid="PSA 83:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 83:16"/>Tsɔ ŋukpe tsyɔ mo na wo,</para>
  <para style="q2" vid="PSA 83:16">ale be amewo nadi wò ŋkɔ, O Yehowa.<verse eid="PSA 83:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 83:17"/>Na ŋukpe nalé wo,</para>
  <para style="q2" vid="PSA 83:17">woƒe mo natsi dãa, eye wonetsrɔ̃ le ŋukpe me.<verse eid="PSA 83:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 83:18"/>Na woanya be wò, ame si ŋkɔe nye Yehowa la,</para>
  <para style="q2" vid="PSA 83:18">wò koe nye Dziƒoʋĩtɔ la ɖe anyigba blibo la dzi.<verse eid="PSA 83:18"/></para>
  <chapter eid="PSA 83"/>
  <chapter number="84" style="c" sid="PSA 84"/>
  <para style="cl">Psalmo 84</para>
  <para style="d">Korah ƒe viwo ƒe ha na hɛnɔ la. Woadzii ɖe <char style="tl">gitit</char> ƒe gbeɖiɖi nu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 84:1"/>O! Yehowa, Dziƒoʋakɔwo ƒe Aƒetɔ,</para>
  <para style="q2" vid="PSA 84:1">wò nɔƒe dzeani loo!<verse eid="PSA 84:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 84:2"/>Yehowa, wò xɔxɔnuwo</para>
  <para style="q2" vid="PSA 84:2">le nye luʋɔ dzrom kutɔkutɔe.</para>
  <para style="q1" vid="PSA 84:2">Nye dzi kple ŋutilã</para>
  <para style="q2" vid="PSA 84:2">le vivi dom ɖe Mawu gbagbe la ŋu.<verse eid="PSA 84:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 84:3"/>O! Yehowa, Dziƒoʋakɔwo ƒe Aƒetɔ,</para>
  <para style="q2" vid="PSA 84:3">Fianye kple Mawunye,</para>
  <para style="q1" vid="PSA 84:3">sagbadre gɔ̃ hã kpɔ nɔƒe,</para>
  <para style="q2" vid="PSA 84:3">eye atsutsrɔe wɔ atɔ na eɖokui,</para>
  <para style="q1" vid="PSA 84:3">afi si wòatsɔ viawo ada ɖo,</para>
  <para style="q2" vid="PSA 84:3">be wòate ɖe wò vɔsamlekpui la ŋu.<verse eid="PSA 84:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 84:4"/>Woayra ame siwo nɔa wò aƒe me la,</para>
  <para style="q2" vid="PSA 84:4">elabena wole kafuwòm ɖaa. <char style="qs">Sela</char><verse eid="PSA 84:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 84:5"/>Woayra ame siwo ƒe ŋusẽ le mewò,</para>
  <para style="q2" vid="PSA 84:5">ame siwo ƒe dzi ku ɖe xɔsemɔzɔzɔ ŋuti.<verse eid="PSA 84:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 84:6"/>Ne woto Baka Balime la,</para>
  <para style="q2" vid="PSA 84:6">wowɔnɛ wòzua tsidzɔƒewo,</para>
  <para style="q2" vid="PSA 84:6">eye kelemetsi tsyɔa edzi kple yayra.<verse eid="PSA 84:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 84:7"/>Wole azɔli dzi tso ŋusẽ me yi ŋusẽ me va se ɖe</para>
  <para style="q2" vid="PSA 84:7">esime wo dometɔ ɖe sia ɖe nado ɖe Mawu ŋkume le Zion.<verse eid="PSA 84:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 84:8"/>Yehowa, Mawu Ŋusẽkatãtɔ;</para>
  <para style="q2" vid="PSA 84:8">O! Yakob ƒe Mawu,</para>
  <para style="q2" vid="PSA 84:8">ɖo to nye gbedodoɖa. <char style="qs">Sela</char><verse eid="PSA 84:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 84:9"/>O! Mawu, nye kɔ nàkpɔ míaƒe akpoxɔnu,</para>
  <para style="q2" vid="PSA 84:9">eye nakpɔ wò amesiamina la kple amenuveve.<verse eid="PSA 84:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 84:10"/>Ŋkeke ɖeka le wò xɔxɔnu nyo wu akpe le afi aɖe;</para>
  <para style="q2" vid="PSA 84:10">enyo be manye agbonudzɔla</para>
  <para style="q1" vid="PSA 84:10">le Mawu ƒe aƒe me wu be manɔ</para>
  <para style="q2" vid="PSA 84:10">ame vɔ̃ɖi ƒe agbadɔ me,<verse eid="PSA 84:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 84:11"/>elabena Yehowa Mawue nye ɣe kple akpoxɔnu.</para>
  <para style="q2" vid="PSA 84:11">Yehowae naa amenuveve kple bubu,</para>
  <para style="q1" vid="PSA 84:11">eye metea nu nyui ame siwo fɔɖiɖi</para>
  <para style="q2" vid="PSA 84:11">mele woƒe zɔzɔme ŋu o.<verse eid="PSA 84:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 84:12"/>O! Yehowa, Dziƒoʋakɔwo ƒe Aƒetɔ,</para>
  <para style="q2" vid="PSA 84:12">woayra ŋutsu si ɖoa dzi ɖe ŋuwò la.<verse eid="PSA 84:12"/></para>
  <chapter eid="PSA 84"/>
  <chapter number="85" style="c" sid="PSA 85"/>
  <para style="cl">Psalmo 85</para>
  <para style="d">Korah ƒe viwo ƒe ha na hɛnɔ la.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 85:1"/>O! Yehowa, èɖe amenuveve fia wò anyigba;</para>
  <para style="q2" vid="PSA 85:1">ègaɖo Yakob ƒe nunyonamewo te.<verse eid="PSA 85:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 85:2"/>Ètsɔ wò dukɔ la ƒe vodada kee,</para>
  <para style="q2" vid="PSA 85:2">eye nètsyɔ nu woƒe nu vɔ̃wo katã dzi. <char style="qs">Sela</char><verse eid="PSA 85:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 85:3"/>Èɖe asi le wò dzikudodo helĩhelĩ ŋuti</para>
  <para style="q2" vid="PSA 85:3">eye nèdzudzɔ dɔmedzoe kaɖikaɖi dodo.<verse eid="PSA 85:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 85:4"/>O! Mawu, míaƒe Ɖela, gaɖo mí te,</para>
  <para style="q2" vid="PSA 85:4">míaƒe nu meganɔ dzi kum na wò o.<verse eid="PSA 85:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 85:5"/>Ɖe nàdo dɔmedzoe ɖe mía ŋu ɖikaa?</para>
  <para style="q2" vid="PSA 85:5">Ɖe nàdidi wò dɔmedzoe la</para>
  <para style="q2" vid="PSA 85:5">wòazɔ ato dzidzimewo katã mea?<verse eid="PSA 85:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 85:6"/>Màgagbɔ agbe mí,</para>
  <para style="q2" vid="PSA 85:6">be wò dukɔ nàkpɔ dzidzɔ ɖe ŋuwò oa?<verse eid="PSA 85:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 85:7"/>O! Yehowa, ɖe wò lɔlɔ̃ si meʋãna o la fia mí,</para>
  <para style="q2" vid="PSA 85:7">eye nàna wò xɔname mí.<verse eid="PSA 85:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 85:8"/>Maɖo to ase nya si Yehowa Mawu agblɔ;</para>
  <para style="q2" vid="PSA 85:8">edo ŋutifafa ƒe ŋugbe na eƒe dukɔ,</para>
  <para style="q1" vid="PSA 85:8">eƒe ame kɔkɔewo, gake ɖeko mègana</para>
  <para style="q2" vid="PSA 85:8">woatrɔ ayi bometsitsi gbɔ o.<verse eid="PSA 85:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 85:9"/>Vavã eƒe ɖeɖe tsɔ ɖe ame siwo vɔ̃nɛ la gbɔ,</para>
  <para style="q2" vid="PSA 85:9">ale be eƒe ŋutikɔkɔe nanɔ míaƒe anyigba dzi.<verse eid="PSA 85:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 85:10"/>Lɔlɔ̃ kple nuteƒewɔwɔ do go wo nɔewo,</para>
  <para style="q2" vid="PSA 85:10">eye dzɔdzɔenyenye kple ŋutifafa gbugbɔ nu na wo nɔewo.<verse eid="PSA 85:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 85:11"/>Nuteƒewɔwɔ mie tso anyigba me,</para>
  <para style="q2" vid="PSA 85:11">eye dzɔdzɔenyenye do mo ɖa kpɔ anyigba tso dziƒo.<verse eid="PSA 85:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 85:12"/>Yehowa ana nu si nyo la mí vavã,</para>
  <para style="q2" vid="PSA 85:12">eye míaƒe anyigba atse eƒe ku.<verse eid="PSA 85:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 85:13"/>Dzɔdzɔenyenye le eŋgɔ,</para>
  <para style="q2" vid="PSA 85:13">eye wòle mɔ tam na eƒe afɔtoƒewo.<verse eid="PSA 85:13"/></para>
  <chapter eid="PSA 85"/>
  <chapter number="86" style="c" sid="PSA 86"/>
  <para style="cl">Psalmo 86</para>
  <para style="d">David ƒe gbedodoɖa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 86:1"/>Ɖo tom, O Yehowa, eye nàtɔ nam,</para>
  <para style="q2" vid="PSA 86:1">elabena meda ahe, eye hiã tum.<verse eid="PSA 86:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 86:2"/>Kpɔ nye agbe ta,</para>
  <para style="q2" vid="PSA 86:2">elabena metsɔ ɖokuinye na wò.</para>
  <para style="q1" vid="PSA 86:2">Wòe nye nye Mawu,</para>
  <para style="q2" vid="PSA 86:2">eya ta ɖe wò dɔla si ɖo dzi ɖe ŋuwò.<verse eid="PSA 86:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 86:3"/>O! Aƒetɔ, kpɔ nye nublanui,</para>
  <para style="q2" vid="PSA 86:3">elabena mele yɔwòm ŋkeke blibo la.<verse eid="PSA 86:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 86:4"/>O! Aƒetɔ, tsɔ dzidzɔ vɛ na wò dɔla,</para>
  <para style="q2" vid="PSA 86:4">elabena wòe medo nye luʋɔ ɖe dzi na.<verse eid="PSA 86:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 86:5"/>O! Aƒetɔ, ènyo, eye nètsɔna kena,</para>
  <para style="q2" vid="PSA 86:5">lɔlɔ̃ bɔ ɖe asiwò na ame siwo katã yɔa wò.<verse eid="PSA 86:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 86:6"/>O! Yehowa, se nye gbedodoɖa,</para>
  <para style="q2" vid="PSA 86:6">eye nàlé to ɖe nye nublanuiɣli ŋu.<verse eid="PSA 86:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 86:7"/>Le nye xaxagbe, mayɔ wò elabena àtɔ nam.<verse eid="PSA 86:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 86:8"/>O! Aƒetɔ aɖeke megale mawuawo dome abe wò ene o;</para>
  <para style="q2" vid="PSA 86:8">nuwɔna aɖeke mesɔ kple tɔwò o.<verse eid="PSA 86:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 86:9"/>O! Aƒetɔ, dukɔ siwo katã nèwɔ la ava asubɔ</para>
  <para style="q2" vid="PSA 86:9">le ŋkuwò me, eye woatsɔ ŋutikɔkɔe ana wò ŋkɔ.<verse eid="PSA 86:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 86:10"/>Elabena èlolo, eye nèwɔ nu dzɔatsuwo;</para>
  <para style="q2" vid="PSA 86:10">wò koe nye Mawu.<verse eid="PSA 86:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 86:11"/>O! Yehowa, fia wò mɔm,</para>
  <para style="q2" vid="PSA 86:11">eye mazɔ le wò nyateƒe la me;</para>
  <para style="q1" vid="PSA 86:11">tsɔ dzi si to mɔ ɖeka la nam,</para>
  <para style="q2" vid="PSA 86:11">ale be mavɔ̃ wò ŋkɔ.<verse eid="PSA 86:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 86:12"/>Makafu wò, O Aƒetɔ, nye Mawu,</para>
  <para style="q2" vid="PSA 86:12">kple nye dzi blibo.</para>
  <para style="q2" vid="PSA 86:12">Mado wò ŋkɔ ɖe dzi tegbee,<verse eid="PSA 86:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 86:13"/>elabena wò lɔlɔ̃ nam lolo ŋutɔ,</para>
  <para style="q2" vid="PSA 86:13">eye nèɖem tso keke tsiẽƒe ʋĩi ke.<verse eid="PSA 86:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 86:14"/>O! Mawu, dadalawo tso ɖe ŋunye,</para>
  <para style="q2" vid="PSA 86:14">ŋutasẽlawo ƒe ha ti nye agbe yome,</para>
  <para style="q2" vid="PSA 86:14">eye wonye ŋutsu siwo mebu wò ɖe naneke me o.<verse eid="PSA 86:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 86:15"/>O! Aƒetɔ, ke wò la,</para>
  <para style="q2" vid="PSA 86:15">Mawu si kpɔa nublanui,</para>
  <para style="q1" vid="PSA 86:15">eye wòvea ame nu lae nènye,</para>
  <para style="q2" vid="PSA 86:15">mèdoa dɔmedzoe kabakaba o,</para>
  <para style="q2" vid="PSA 86:15">lɔlɔ̃ bɔ ɖe asiwò, eye nèwɔa nuteƒe.<verse eid="PSA 86:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 86:16"/>Trɔ ɖe ŋutinye, eye nàkpɔ nublanui nam;</para>
  <para style="q2" vid="PSA 86:16">na wò ŋusẽ wò dɔla, eye nàɖe viwò ŋutsu nuteƒewɔla.<verse eid="PSA 86:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 86:17"/>Ɖe wò nyuiwɔwɔ ƒe dzesi fiam,</para>
  <para style="q2" vid="PSA 86:17">be nye futɔwo nakpɔe, eye ŋu nakpe wo,</para>
  <para style="q2" vid="PSA 86:17">elabena o Yehowa, wòe kpe ɖe ŋunye, eye nèfa akɔ nam.<verse eid="PSA 86:17"/></para>
  <chapter eid="PSA 86"/>
  <chapter number="87" style="c" sid="PSA 87"/>
  <para style="cl">Psalmo 87</para>
  <para style="d">Korah ƒe viwo ƒe ha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 87:1"/>Eɖo eƒe agunu anyi ɖe to Kɔkɔe la dzi.<verse eid="PSA 87:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 87:2"/>Yehowa lɔ̃ Zion ƒe agbowo</para>
  <para style="q2" vid="PSA 87:2">wu Yakob ƒe nɔƒewo katã.<verse eid="PSA 87:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 87:3"/>O! Mawu ƒe du,</para>
  <para style="q2" vid="PSA 87:3">wogblɔ nu nyui geɖewo tso ŋuwò. <char style="qs">Sela</char><verse eid="PSA 87:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 87:4"/>“Maŋlɔ Rahab kple Babilon ƒe ŋkɔ ɖe</para>
  <para style="q2" vid="PSA 87:4">ame siwo nyam la dome,</para>
  <para style="q1" vid="PSA 87:4">nenema kee nye Filistia kple Tiro hekpe ɖe Kus ŋuti,</para>
  <para style="q2" vid="PSA 87:4">magblɔ be, ‘Wodzi esia le Zion.’ ”<verse eid="PSA 87:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 87:5"/>Vavã, woagblɔ le Zion ŋu be,</para>
  <para style="q2" vid="PSA 87:5">“Wodzi esia kple ekemɛ le afi ma,</para>
  <para style="q2" vid="PSA 87:5">eye Dziƒoʋĩtɔ la ŋutɔ aɖo egɔme anyi.”<verse eid="PSA 87:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 87:6"/>Yehowa aŋlɔ ɖe dukɔwo ƒe agbalẽ me be,</para>
  <para style="q2" vid="PSA 87:6">“Wodzi esia le Zion.” <char style="qs">Sela</char><verse eid="PSA 87:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 87:7"/>Ne wole ha dzim la, woadzi ha be,</para>
  <para style="q2" vid="PSA 87:7">“Nye agunuwo katã le mewò.”<verse eid="PSA 87:7"/></para>
  <chapter eid="PSA 87"/>
  <chapter number="88" style="c" sid="PSA 88"/>
  <para style="cl">Psalmo 88</para>
  <para style="d">Korah ƒe viwo ƒe ha na hɛnɔ la. Enye nufiameha si Ezrahitɔ Heman kpa; woadzii ɖe <char style="tl">Mahalat Leanot</char> ƒe gbeɖiɖi nu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 88:1"/>O! Yehowa, Mawu si ɖem,</para>
  <para style="q2" vid="PSA 88:1">mele ɣli dom le ŋkuwò me zã kple keli.<verse eid="PSA 88:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 88:2"/>Nye gbedodoɖa nede gbɔwò,</para>
  <para style="q2" vid="PSA 88:2">ƒu to anyi ɖe nye kokoƒoƒo ŋu,<verse eid="PSA 88:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 88:3"/>elabena nye luʋɔ yɔ fũu kple xaxawo,</para>
  <para style="q2" vid="PSA 88:3">eye nye agbe ɖo kudo nu.<verse eid="PSA 88:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 88:4"/>Wobum ɖe ame siwo yi aʋlime la dome;</para>
  <para style="q2" vid="PSA 88:4">mele abe ŋutsu si si ŋusẽ mele o la ene.<verse eid="PSA 88:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 88:5"/>Woɖem ɖe aga da ɖe ame kukuwo dome,</para>
  <para style="q2" vid="PSA 88:5">eye mele abe ame siwo wowu wole yɔdo me la ene,</para>
  <para style="q1" vid="PSA 88:5">ame siwo dzi miagaɖo ŋkui o,</para>
  <para style="q2" vid="PSA 88:5">eye woɖe wo ɖa le wò dzikpɔkpɔ te.<verse eid="PSA 88:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 88:6"/>Ètsɔm de ʋe goglotɔ me,</para>
  <para style="q2" vid="PSA 88:6">yi ɖe keke viviti tsiɖitsiɖi me.<verse eid="PSA 88:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 88:7"/>Wò dziku helĩhelĩ le dzinye vevie,</para>
  <para style="q2" vid="PSA 88:7">eye nètsɔ wò ƒutsotsoewo tsyɔ dzinye. <char style="qs">Sela</char><verse eid="PSA 88:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 88:8"/>Èxɔ xɔ̃nye veviwo le asinye,</para>
  <para style="q2" vid="PSA 88:8">eye nètsɔm wɔ ŋunyɔnu na wo.</para>
  <para style="q1" vid="PSA 88:8">Ètsɔm da ɖe xaxɛƒe, nyemate ŋu asi o,<verse eid="PSA 88:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="PSA 88:9"/>eye nuxaxa wɔe be nye ŋkuwo dzi tsyɔ.</para>
  <para style="b" vid="PSA 88:9"/>
  <para style="q1" vid="PSA 88:9">O! Yehowa, mele yɔwòm gbe sia gbe,</para>
  <para style="q2" vid="PSA 88:9">eye meke nye abɔwo me na wò.<verse eid="PSA 88:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 88:10"/>Ɖe nàte ŋu aɖe wò nukunuwo afia ame kukua?</para>
  <para style="q2" vid="PSA 88:10">Ɖe ame siwo ku la ate ŋu atsi tsitre akafu wòa? <char style="qs">Sela</char><verse eid="PSA 88:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 88:11"/>Ɖe woaɖe gbeƒã wò lɔlɔ̃ le yɔdo me</para>
  <para style="q2" vid="PSA 88:11">kple wò nuteƒewɔwɔ le tsiẽƒea?<verse eid="PSA 88:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 88:12"/>Ɖe woanya nu le wò nukunuwo ŋu le viviti me,</para>
  <para style="q2" vid="PSA 88:12">alo le wò dzɔdzɔenyenyedɔwo ŋu le anyigba manyamanya dzia?<verse eid="PSA 88:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 88:13"/>Ke wò, o Yehowae,</para>
  <para style="q2" vid="PSA 88:13">mele ɣli dom na be nàxɔ nam,</para>
  <para style="q2" vid="PSA 88:13">eye le ŋdi me la, nye gbedodoɖa neva gbɔwò.<verse eid="PSA 88:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 88:14"/>O! Yehowa, nu ka ta nègbem,</para>
  <para style="q2" vid="PSA 88:14">eye nèɣla wò mo ɖem ɖo?<verse eid="PSA 88:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 88:15"/>Tso nye ɖekakpuime ke, mekpe hiã,</para>
  <para style="q2" vid="PSA 88:15">eye meɖo kudo nu,</para>
  <para style="q1" vid="PSA 88:15">mekpe fu le wò ŋɔdzidodowo ta,</para>
  <para style="q2" vid="PSA 88:15">eye dzi ɖe le ƒonye.<verse eid="PSA 88:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 88:16"/>Wò dziku helĩhelĩ tsyɔ dzinye,</para>
  <para style="q2" vid="PSA 88:16">eye wò ŋɔdzi gblẽ donyeme.<verse eid="PSA 88:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 88:17"/>Woƒo xlãm ŋkeke blibo la abe tsiɖɔɖɔ ene,</para>
  <para style="q2" vid="PSA 88:17">eye wonye tsyɔ dzinye.<verse eid="PSA 88:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 88:18"/>Èɖe nye zɔhɛwo kple xɔ̃nyewo ɖa le ŋunye,</para>
  <para style="q2" vid="PSA 88:18">eye vivitie nye xɔ̃nye si tsɔ ɖe gbɔnye.<verse eid="PSA 88:18"/></para>
  <chapter eid="PSA 88"/>
  <chapter number="89" style="c" sid="PSA 89"/>
  <para style="cl">Psalmo 89</para>
  <para style="d">Ezrahitɔ Etan ƒe nufiameha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 89:1"/>Madzi ha le Mawu ƒe lɔlɔ̃ gã la ŋu ɖaa,</para>
  <para style="q1" vid="PSA 89:1">matsɔ nye nu aɖe gbeƒã wò</para>
  <para style="q2" vid="PSA 89:1">nuteƒewɔwɔ tso dzidzime yi dzidzime.<verse eid="PSA 89:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 89:2"/>Maɖe gbeƒã be wò lɔlɔ̃ li ke tegbee,</para>
  <para style="q2" vid="PSA 89:2">eye nèɖo wò nuteƒewɔwɔ anyi ɖe dziƒo ŋutɔŋutɔ.<verse eid="PSA 89:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 89:3"/>Ègblɔ be, “Mebla nu kple nye ame tiatia,</para>
  <para style="q2" vid="PSA 89:3">meka atam na David, nye dɔla be,<verse eid="PSA 89:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 89:4"/>‘Maɖo wò ƒome anyi tegbee,</para>
  <para style="q2" vid="PSA 89:4">eye mana wò fiazikpui nali ke na dzidzimewo katã.’ ” <char style="qs">Sela</char><verse eid="PSA 89:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 89:5"/>O! Yehowa, dziƒowo le wò nukunuwo kafum,</para>
  <para style="q2" vid="PSA 89:5">kple wò nuteƒewɔwɔ hã</para>
  <para style="q2" vid="PSA 89:5">le ame kɔkɔewo ƒe hame.<verse eid="PSA 89:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 89:6"/>Elabena ame kae le dziŋgɔli me</para>
  <para style="q2" vid="PSA 89:6">si woatsɔ asɔ kple Yehowa?</para>
  <para style="q1" vid="PSA 89:6">Le nu gbagbe siwo le dziƒo dome la,</para>
  <para style="q2" vid="PSA 89:6">kae le abe Yehowa ene?<verse eid="PSA 89:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 89:7"/>Le ame kɔkɔewo ƒe adaŋudeha me la ŋɔdzi le Mawu ŋu ŋutɔ,</para>
  <para style="q2" vid="PSA 89:7">ŋɔdzi le eŋu wu ame siwo katã ƒo xlãe.<verse eid="PSA 89:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 89:8"/>O! Yehowa, Dziƒoʋakɔwo ƒe Mawu, ame kae ɖi wò?</para>
  <para style="q2" vid="PSA 89:8">O! Yehowa, wò la, ŋusẽtɔe nènye, eye wò nuteƒewɔwɔ ƒo xlã wò.<verse eid="PSA 89:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 89:9"/>Wòe ɖu atsiaƒu ƒe agbodzedze dzi,</para>
  <para style="q2" vid="PSA 89:9">ne ƒutsotsoewo le dzi dem la, ènana wodzea akɔ anyi.<verse eid="PSA 89:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 89:10"/>Ègbã Rahab gudugudu abe</para>
  <para style="q2" vid="PSA 89:10">ame siwo wowu la dometɔ ɖeka ene,</para>
  <para style="q2" vid="PSA 89:10">eye nètsɔ wò abɔ sesẽ kaka wò futɔwo.<verse eid="PSA 89:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 89:11"/>Dziƒowo nye tɔwò, anyigba hã tɔwòe;</para>
  <para style="q2" vid="PSA 89:11">wòe wɔ xexea me kple emenuwo katã.<verse eid="PSA 89:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 89:12"/>Wòe wɔ anyiehe kple dziehe;</para>
  <para style="q2" vid="PSA 89:12">ne Tabɔr kple Hermon se wò ŋkɔ ko la,</para>
  <para style="q2" vid="PSA 89:12">wodzia ha, tsoa aseye.<verse eid="PSA 89:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 89:13"/>Wotsɔ ŋusẽ de wò abɔ me,</para>
  <para style="q2" vid="PSA 89:13">eye wò asi sesẽ, wò nuɖusi de dzi.<verse eid="PSA 89:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 89:14"/>Woli wò fiazikpui anyi ɖe dzɔdzɔenyenye kple ʋɔnudɔdrɔ̃ dzi,</para>
  <para style="q2" vid="PSA 89:14">eye lɔlɔ̃ kple nuteƒewɔwɔ le zɔzɔm le ŋgɔwò.<verse eid="PSA 89:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 89:15"/>Woayra ame siwo srɔ̃ ale si woakafu wòe,</para>
  <para style="q2" vid="PSA 89:15">eye wozɔna le wò mo ƒe kekeli me, O Yehowa.<verse eid="PSA 89:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 89:16"/>Wotsoa aseye le wò ŋkɔ me ŋkeke blibo la,</para>
  <para style="q2" vid="PSA 89:16">eye wokpɔa dodoɖedzi le wò dzɔdzɔenyenye me.<verse eid="PSA 89:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 89:17"/>Elabena wòe nye woƒe ŋutikɔkɔe kple ŋusẽ,</para>
  <para style="q2" vid="PSA 89:17">eye to wò amenuveve me, nèkɔ míaƒe dzo ɖe dzi.<verse eid="PSA 89:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 89:18"/>Vavã, míaƒe akpoxɔnu nye Yehowa tɔ,</para>
  <para style="q2" vid="PSA 89:18">miaƒe fia nye Israel ƒe Kɔkɔetɔ la.<verse eid="PSA 89:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 89:19"/>Ɣe aɖe ɣi la, èƒo nu na wò</para>
  <para style="q2" vid="PSA 89:19">ame kɔkɔewo le ŋutega me be,</para>
  <para style="q1" vid="PSA 89:19">“Metrɔ ŋusẽ kɔ ɖe kalẽtɔ aɖe dzi;</para>
  <para style="q2" vid="PSA 89:19">medo ɖekakpui aɖe ɖe dzi le nye amewo dome.<verse eid="PSA 89:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 89:20"/>Meke ɖe David, nye dɔla</para>
  <para style="q2" vid="PSA 89:20">ŋu, eye mesi ami nɛ kple nye ami kɔkɔe.<verse eid="PSA 89:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 89:21"/>Nye asi alée ɖe asi,</para>
  <para style="q2" vid="PSA 89:21">le nyateƒe me, nye alɔ ado ŋusẽe.<verse eid="PSA 89:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 89:22"/>Futɔ aɖeke mazi edzi wòadzɔ ga nɛ o,</para>
  <para style="q2" vid="PSA 89:22">eye ame vɔ̃ɖi aɖeke matee ɖe to o.<verse eid="PSA 89:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 89:23"/>Mafanya eƒe futɔwo le eŋgɔ,</para>
  <para style="q2" vid="PSA 89:23">eye maƒo ame siwo tso ɖe eŋu la aƒu anyi.<verse eid="PSA 89:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 89:24"/>Nye lɔlɔ̃ si meʋãna o la anɔ anyi kplii,</para>
  <para style="q2" vid="PSA 89:24">eye woakɔ eƒe dzo ɖe dzi to nye ŋkɔ dzi.<verse eid="PSA 89:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 89:25"/>Makɔ eƒe asi dzi ɖe atsiaƒu dzi,</para>
  <para style="q2" vid="PSA 89:25">eye eƒe nuɖusi ɖe tɔsisiwo dzi.<verse eid="PSA 89:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 89:26"/>Ayɔm be, ‘Wòe nye Fofonye, nye Mawu,</para>
  <para style="q2" vid="PSA 89:26">nye Agakpe kple Ɖela.’<verse eid="PSA 89:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 89:27"/>Matsɔe awɔ nye ŋgɔgbevi</para>
  <para style="q2" vid="PSA 89:27">kple fia si wodo ɖe dzi wu</para>
  <para style="q2" vid="PSA 89:27">le anyigbadzifiawo katã dome.<verse eid="PSA 89:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 89:28"/>Malé nye lɔlɔ̃ nɛ me ɖe asi ɖaa,</para>
  <para style="q2" vid="PSA 89:28">eye nye nubabla kplii mada</para>
  <para style="q2" vid="PSA 89:28">le edzi akpɔ gbeɖe o.<verse eid="PSA 89:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 89:29"/>Maɖo eƒe ƒome anyi tegbee,</para>
  <para style="q2" vid="PSA 89:29">eye zi ale si dziƒo li la,</para>
  <para style="q2" vid="PSA 89:29">nenema ke eƒe fiazikpui hã anɔ anyii.<verse eid="PSA 89:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 89:30"/>“Ne viawo gblẽ nye sewo ɖi,</para>
  <para style="q2" vid="PSA 89:30">eye womewɔ nye ɖoɖowo dzi o,<verse eid="PSA 89:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 89:31"/>ne woda le nye sedede dzi,</para>
  <para style="q2" vid="PSA 89:31">eye wogbe nye gbeɖeɖewo dzi wɔwɔ la,<verse eid="PSA 89:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 89:32"/>ekema matsɔ ati ahe to na woe ɖe</para>
  <para style="q2" vid="PSA 89:32">woƒe nu vɔ̃wo ta, eye matsɔ ƒoƒo ahe to</para>
  <para style="q2" vid="PSA 89:32">na wo ɖe woƒe vodadawo ta,<verse eid="PSA 89:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 89:33"/>gake nyemaxɔ nye lɔlɔ̃ le esi,</para>
  <para style="q2" vid="PSA 89:33">alo ada le nye nuteƒewɔwɔ dzi o.<verse eid="PSA 89:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 89:34"/>Nyemagbe nye nubabla la dzi wɔwɔ o,</para>
  <para style="q2" vid="PSA 89:34">eye nyematrɔ nu si nye nu gblɔ la o.<verse eid="PSA 89:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 89:35"/>Meta nye kɔkɔenyenye zi ɖeka</para>
  <para style="q2" vid="PSA 89:35">hena ɣeyiɣiwo katã be,</para>
  <para style="q2" vid="PSA 89:35">nyemada alakpa na David o.<verse eid="PSA 89:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 89:36"/>Ke boŋ eƒe ƒome anɔ anyi tegbee,</para>
  <para style="q2" vid="PSA 89:36">eye eƒe fiazikpui ali ke</para>
  <para style="q2" vid="PSA 89:36">le nye ŋkume abe ɣe ene.<verse eid="PSA 89:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 89:37"/>Woaɖoe anyi ɖaa abe ɣleti,</para>
  <para style="q2" vid="PSA 89:37">ɖasefo nuteƒewɔla si le dziŋgɔli ŋu ene.” <char style="qs">Sela</char><verse eid="PSA 89:37"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 89:38"/>Gake ègbe, èdo vlo, eye nèdo dɔmedzoe ɖe wò</para>
  <para style="q2" vid="PSA 89:38">amesiamina ŋu vevie.<verse eid="PSA 89:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 89:39"/>Ète fli ɖe nu si nèbla kple wò dɔla me,</para>
  <para style="q2" vid="PSA 89:39">eye nèdo gu eƒe fiakuku, tsɔe ƒu gbe ɖe ke me.<verse eid="PSA 89:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 89:40"/>Ègbã eƒe gliwo,</para>
  <para style="q2" vid="PSA 89:40">eye nèwɔ eƒe mɔ sesẽwo wozu aƒedo.<verse eid="PSA 89:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 89:41"/>Ame siwo katã to afi ma la hae,</para>
  <para style="q2" vid="PSA 89:41">eye wòzu alɔmeɖenu na eƒe aƒelikawo.<verse eid="PSA 89:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 89:42"/>Èdo eƒe futɔwo ƒe nuɖusi ɖe dzi,</para>
  <para style="q2" vid="PSA 89:42">eye nèna eƒe ketɔwo katã tso aseye.<verse eid="PSA 89:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 89:43"/>Èna eƒe yi nu tsi, eye mèkpe ɖe eŋu</para>
  <para style="q2" vid="PSA 89:43">le aʋawɔwɔ me o.<verse eid="PSA 89:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 89:44"/>Èna eƒe ŋutikɔkɔe wu enu,</para>
  <para style="q2" vid="PSA 89:44">eye nètsɔ eƒe fiazikpui ƒu gbe ɖe anyigba.<verse eid="PSA 89:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 89:45"/>Èɖe eƒe ɖekakpuimeŋkekewo dzi kpɔtɔ,</para>
  <para style="q2" vid="PSA 89:45">eye nètsɔ ŋukpe tsyɔ nɛ abe avɔ ene. <char style="qs">Sela</char><verse eid="PSA 89:45"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 89:46"/>O! Yehowa va se ɖe ɣe ka ɣie?</para>
  <para style="q2" vid="PSA 89:46">Ɖe nàɣla ɖokuiwò tegbea?</para>
  <para style="q2" vid="PSA 89:46">Ɣe ka ɣi wò dziku abi abe dzo ene ase ɖo?<verse eid="PSA 89:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 89:47"/>Ɖo ŋku ale si nye agbe le du dzii la dzi.</para>
  <para style="q2" vid="PSA 89:47">Tofloko kae nye si, nèwɔ amegbetɔviwo na!<verse eid="PSA 89:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 89:48"/>Amegbetɔ kae anɔ agbe, eye maku o,</para>
  <para style="q2" vid="PSA 89:48">alo aɖe eɖokui tso tsiẽƒe ƒe ŋusẽ me? <char style="qs">Sela</char><verse eid="PSA 89:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 89:49"/>O! Aƒetɔ, afi ka wò lɔlɔ̃ gã tsãtɔ le,</para>
  <para style="q2" vid="PSA 89:49">wò lɔlɔ̃ si nye atam nèka na David</para>
  <para style="q2" vid="PSA 89:49">le wò nuteƒewɔwɔ me la le?<verse eid="PSA 89:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 89:50"/>Aƒetɔ, ɖo ŋku ale si woɖu fewu le wò dɔla ŋuti</para>
  <para style="q2" vid="PSA 89:50">kple ale si nye dzi tsɔ dukɔwo ƒe vlodoame la dzi.<verse eid="PSA 89:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 89:51"/>O! Yehowa, ɖo ŋku vlodoame si wò futɔwo tsɔ</para>
  <para style="q2" vid="PSA 89:51">le alɔme ɖem le wò amesiamina ƒe</para>
  <para style="q2" vid="PSA 89:51">afɔɖeɖe ɖe sia ɖe ŋuti la dzi.<verse eid="PSA 89:51"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 89:52"/>Woakafu Yehowa tegbetegbee!</para>
  <para style="qc" vid="PSA 89:52">Amen, ɛ̃, Amen.<verse eid="PSA 89:52"/></para>
  <chapter eid="PSA 89"/>
  <chapter number="90" style="c" sid="PSA 90"/>
  <para style="ms">Agbalẽ enelia</para>
  <para style="mr">
    <ref loc="PSA 90-106">Psalmowo 90–106</ref></para>
  <para style="cl">Psalmo 90</para>
  <para style="d">Mose, Mawu ƒe ame ƒe gbedodoɖa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 90:1"/>Yehowa, wòe nye míaƒe sitsoƒe</para>
  <para style="q2" vid="PSA 90:1">le dzidzimewo katã me.<verse eid="PSA 90:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 90:2"/>Hafi towo nava dzɔ,</para>
  <para style="q2" vid="PSA 90:2">alo hafi nàwɔ anyigba kple xexea me,</para>
  <para style="q2" vid="PSA 90:2">tso mavɔ me yi ɖe mavɔ me, wò koe nye Mawu.<verse eid="PSA 90:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 90:3"/>Ènana amegbetɔwo gatrɔna zua kewɔ, eye nègblɔna be,</para>
  <para style="q2" vid="PSA 90:3">“O! Amegbetɔviwo, mitrɔ zu kewɔ.”<verse eid="PSA 90:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 90:4"/>Elabena ƒe akpewo le ŋkuwò me</para>
  <para style="q2" vid="PSA 90:4">le abe etsɔ ŋkeke si va yi la ene,</para>
  <para style="q2" vid="PSA 90:4">alo abe ŋudzɔɣi le zã me ene.<verse eid="PSA 90:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 90:5"/>Èkplɔa amewo dzonae to ku me;</para>
  <para style="q2" vid="PSA 90:5">wole abe gbe mumu le ŋdi me ene.<verse eid="PSA 90:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 90:6"/>Togbɔ be emie le ŋdi yeyee hã la,</para>
  <para style="q2" vid="PSA 90:6">le fiẽ me la, eƒu, eye wòku.<verse eid="PSA 90:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 90:7"/>Wò dɔmedzoe la tsrɔ̃ mí</para>
  <para style="q2" vid="PSA 90:7">eye wò dɔmedzoe do ŋɔdzi na mí.<verse eid="PSA 90:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 90:8"/>Ètsɔ míaƒe vodadawo ɖo wò ŋkume</para>
  <para style="q2" vid="PSA 90:8">kple míaƒe nu vɔ̃ siwo míewɔ</para>
  <para style="q2" vid="PSA 90:8">le ɣaɣlaƒe la ɖo wò mo ƒe kekeli nu.<verse eid="PSA 90:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 90:9"/>Míaƒe ŋkekewo katã nu va yi le wò dziku ta,</para>
  <para style="q2" vid="PSA 90:9">eye míewu míaƒe ƒewo nu kple ŋeŋe.<verse eid="PSA 90:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 90:10"/>Míaƒe agbemeŋkekewo le ƒe blaadre,</para>
  <para style="q2" vid="PSA 90:10">alo blaenyi, gake ne ŋusẽ gale mía ŋutie nye ema,</para>
  <para style="q1" vid="PSA 90:10">elabena woƒe didi nye fuɖename kple aɖukliɖuɖu;</para>
  <para style="q2" vid="PSA 90:10">wo nu va yi kaba, eye míedzo.<verse eid="PSA 90:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 90:11"/>Ame kae nya wò dɔmedzoe ƒe ŋusẽ?</para>
  <para style="q2" vid="PSA 90:11">Elabena wò dziku nu sẽ abe ale si woavɔ̃ wòe ene.<verse eid="PSA 90:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 90:12"/>Fia ale si míaxlẽ míaƒe ŋkekewo dedie la mí,</para>
  <para style="q2" vid="PSA 90:12">ale be dzi si me dziƒonunya le la nasu mía si.<verse eid="PSA 90:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 90:13"/>O! Yehowa, bɔbɔ wò asi! Va se ɖe ɣe ka ɣi?</para>
  <para style="q2" vid="PSA 90:13">Kpɔ nublanui na wò dɔlawo.<verse eid="PSA 90:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 90:14"/>Tsɔ wò lɔlɔ̃ si meʋãna o la ɖi ƒoe na</para>
  <para style="q2" vid="PSA 90:14">mí le ŋdi me, be míadzi ha kple dzidzɔ,</para>
  <para style="q2" vid="PSA 90:14">eye míatso aseye le míaƒe ŋkekewo katã me.<verse eid="PSA 90:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 90:15"/>Na míatso aseye, ɖe ŋkeke siwo katã nètu nu kpli mí</para>
  <para style="q2" vid="PSA 90:15">kple ƒe siwo katã me nèhe fukpekpe va mía dzi la ta.<verse eid="PSA 90:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 90:16"/>Na woaɖe wò dɔwɔwɔwo afia wò dɔlawo</para>
  <para style="q2" vid="PSA 90:16">kple wò atsyɔ̃ afia wo viwo.<verse eid="PSA 90:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 90:17"/>Aƒetɔ, míaƒe Mawu, na wò amenuveve nanɔ mía dzi,</para>
  <para style="q2" vid="PSA 90:17">eye nàli ke míaƒe asinudɔwo na mí, ɛ̃,</para>
  <para style="q2" vid="PSA 90:17">míaƒe asinudɔwo, nàna woali ke nyuie.<verse eid="PSA 90:17"/></para>
  <chapter eid="PSA 90"/>
  <chapter number="91" style="c" sid="PSA 91"/>
  <para style="cl">Psalmo 91</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 91:1"/>Ame si nɔ Dziƒoʋĩtɔ la ƒe bebeƒe la</para>
  <para style="q2" vid="PSA 91:1">agbɔ ɖe eme le Ŋusẽkatãtɔ la ƒe vɔvɔli te.<verse eid="PSA 91:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 91:2"/>Magblɔ na Yehowa be, “Eyae nye nye sitsoƒe kple nye mɔ sesẽ,</para>
  <para style="q2" vid="PSA 91:2">nye Mawu si ŋu meku ɖo.”<verse eid="PSA 91:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 91:3"/>Vavã, aɖe wò le xevimɔtrela ƒe mɔ</para>
  <para style="q2" vid="PSA 91:3">kple dɔvɔ̃ dziŋɔ me.<verse eid="PSA 91:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 91:4"/>Atsɔ eƒe fuwo atsyɔ dziwò,</para>
  <para style="q2" vid="PSA 91:4">àkpɔ sitsoƒe le eƒe aʋala te,</para>
  <para style="q1" vid="PSA 91:4">eye eƒe nuteƒewɔwɔ anye wò akpoxɔnu</para>
  <para style="q2" vid="PSA 91:4">kple mɔxenu aƒo xlã wò.<verse eid="PSA 91:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 91:5"/>Màvɔ̃ zãmeŋɔdzi alo aŋutrɔ si le ʋɔ lũm le ŋkeke me,<verse eid="PSA 91:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 91:6"/>dɔvɔ̃ si le tsatsam le viviti me,</para>
  <para style="q2" vid="PSA 91:6">alo dɔxɔleameŋu si le nu gblẽm le ŋdɔ la o.<verse eid="PSA 91:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 91:7"/>Akpe adze anyi ɖe axawò,</para>
  <para style="q2" vid="PSA 91:7">eye akpe ewo ɖe wò nuɖusime,</para>
  <para style="q2" vid="PSA 91:7">ke wò la, mate ɖe ŋuwò o.<verse eid="PSA 91:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 91:8"/>Ɖeko nàkpɔe kple wò ŋkuwo,</para>
  <para style="q2" vid="PSA 91:8">eye àkpɔ ale si woahe to na ame vɔ̃ɖiwoe.<verse eid="PSA 91:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 91:9"/>Ne ètsɔ Dziƒoʋĩtɔ la, Yehowa,</para>
  <para style="q2" vid="PSA 91:9">ame si nye nye sitsoƒe wɔ nɔwòƒee la,<verse eid="PSA 91:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 91:10"/>ekema dzɔgbevɔ̃e maɖi kpe wò o,</para>
  <para style="q2" vid="PSA 91:10">eye gbegblẽ mate ɖe wò agbadɔ ŋu o,<verse eid="PSA 91:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 91:11"/>elabena ade se na eƒe dɔlawo tso ŋutiwò,</para>
  <para style="q2" vid="PSA 91:11">be woakpɔ tawò le wò mɔwo katã dzi.<verse eid="PSA 91:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 91:12"/>Woakɔ wò ɖe woƒe asiwo me,</para>
  <para style="q2" vid="PSA 91:12">be màtsɔ wò afɔ axlã ɖe kpe aɖeke o.<verse eid="PSA 91:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 91:13"/>Àɖo afɔ dzata kple ƒli dzi, eye ànya avuzi</para>
  <para style="q2" vid="PSA 91:13">le dzata dziŋɔ kple da vɔ̃ɖi dzi.<verse eid="PSA 91:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 91:14"/>Yehowa be, “Maɖee, elabena elɔ̃m,</para>
  <para style="q2" vid="PSA 91:14">madzɔ eŋu, elabena enya nye ŋkɔ.<verse eid="PSA 91:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 91:15"/>Ayɔm, eye matɔ nɛ;</para>
  <para style="q2" vid="PSA 91:15">manɔ anyi kplii le xaxa me,</para>
  <para style="q2" vid="PSA 91:15">maɖee, eye made bubu eŋuti.<verse eid="PSA 91:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 91:16"/>Matsɔ agbe didi aɖi ƒo nɛ,</para>
  <para style="q2" vid="PSA 91:16">eye maɖe nye xɔxɔ afiae.”<verse eid="PSA 91:16"/></para>
  <chapter eid="PSA 91"/>
  <chapter number="92" style="c" sid="PSA 92"/>
  <para style="cl">Psalmo 92</para>
  <para style="d">Ha si wokpa. Hadzidzi. Na Dzudzɔgbe ŋkeke la.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 92:1"/>Enyo be woakafu Yehowa,</para>
  <para style="q2" vid="PSA 92:1">eye woadzi ha na wò ŋkɔ, o Dziƒoʋĩtɔ,<verse eid="PSA 92:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 92:2"/>ne woaɖe gbeƒã wò lɔlɔ̃ le ŋdi me</para>
  <para style="q2" vid="PSA 92:2">kple wò nuteƒewɔwɔ le fiẽ me,<verse eid="PSA 92:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 92:3"/>ɖe ka ewo gakasaŋku</para>
  <para style="q2" vid="PSA 92:3">kple kasaŋku ƒe gbe vivi nu.<verse eid="PSA 92:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 92:4"/>O! Yehowa, èna mekpɔ dzidzɔ le wò nuwɔnawo ta.</para>
  <para style="q2" vid="PSA 92:4">Medzi ha tso aseye le wò asinudɔwo ta.<verse eid="PSA 92:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 92:5"/>O! Yehowa, wò dɔwɔwɔwo lolo loo,</para>
  <para style="q2" vid="PSA 92:5">aleke wò susuwo me goglo ale?<verse eid="PSA 92:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 92:6"/>Numanyala menya esia o,</para>
  <para style="q2" vid="PSA 92:6">eye bometsilawo mese egɔme o,<verse eid="PSA 92:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 92:7"/>be togbɔ be ame vɔ̃ɖi tsi mlɔmlɔmlɔ abe gbe ene,</para>
  <para style="q2" vid="PSA 92:7">eye nu tovo wɔlawo ƒo se hã la,</para>
  <para style="q2" vid="PSA 92:7">woatsrɔ̃ wo gbidigbidi.<verse eid="PSA 92:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 92:8"/>Ke wò, o Yehowa, woado wò ɖe dzi tegbetegbe.<verse eid="PSA 92:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 92:9"/>Vavã, wò futɔwo, o Yehowa,</para>
  <para style="q2" vid="PSA 92:9">atsrɔ̃ le nyateƒe me,</para>
  <para style="q2" vid="PSA 92:9">eye nu vlo wɔlawo katã aka ahlẽ gbẽe.<verse eid="PSA 92:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 92:10"/>Èkɔ nye dzo ɖe dzi abe to tɔ ene,</para>
  <para style="q2" vid="PSA 92:10">eye nèkɔ ami nyuitɔwo ɖe dzinye.<verse eid="PSA 92:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 92:11"/>Nye ŋkuwo kpɔ ale si woɖu nye ketɔwo dzii,</para>
  <para style="q2" vid="PSA 92:11">eye nye towo se ale si wonya avuzi</para>
  <para style="q2" vid="PSA 92:11">le nye futɔ vɔ̃ɖiwo dzii.<verse eid="PSA 92:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 92:12"/>Ame dzɔdzɔewo atsi abe ale si deti tsinae ene,</para>
  <para style="q2" vid="PSA 92:12">woatsi akɔ abe Lebanon ƒe sedati ene;<verse eid="PSA 92:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 92:13"/>ati siwo wodo ɖe Yehowa ƒe aƒe me,</para>
  <para style="q2" vid="PSA 92:13">woatsi nyuie le míaƒe Mawu la ƒe xɔxɔnu.<verse eid="PSA 92:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 92:14"/>Aleke gbegbe wotsii hã la,</para>
  <para style="q2" vid="PSA 92:14">woaganɔ tsetsem, eye woƒe aŋgbawo ada ama, eye womalũ xɛ o.<verse eid="PSA 92:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 92:15"/>Woaɖe gbeƒã be, “Yehowae nye dzɔdzɔetɔ;</para>
  <para style="q2" vid="PSA 92:15">eyae nye nye Agakpe, eye vɔ̃ɖinyenye aɖeke mele eme o.”<verse eid="PSA 92:15"/></para>
  <chapter eid="PSA 92"/>
  <chapter number="93" style="c" sid="PSA 93"/>
  <para style="cl">Psalmo 93</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 93:1"/>Yehowa le fia ɖum, eta gãnyenye,</para>
  <para style="q2" vid="PSA 93:1">Yehowa ta gãnyenye, eye ŋusẽ le esi.</para>
  <para style="q2" vid="PSA 93:1">Eli ke xexea me, maʋã o.<verse eid="PSA 93:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 93:2"/>Woɖo wò fiazikpui anyi tso blema ke,</para>
  <para style="q2" vid="PSA 93:2">eye nèli tso mavɔ me ke.<verse eid="PSA 93:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 93:3"/>Atsiaƒuwo dze agbo, o Yehowa,</para>
  <para style="q2" vid="PSA 93:3">atsiaƒuwo le ɣli dom,</para>
  <para style="q1" vid="PSA 93:3">atsiaƒuwo dze agbo,</para>
  <para style="q2" vid="PSA 93:3">eye woƒe tsotsoewo le ŋeŋem.<verse eid="PSA 93:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 93:4"/>Ke ètri akɔ wu tɔsisi gãwo ƒe gbeɖeɖe,</para>
  <para style="q2" vid="PSA 93:4">ètri akɔ wu atsiaƒu ƒe agbodzedze, ɛ̃,</para>
  <para style="q2" vid="PSA 93:4">Yehowa le dziƒo tri akɔ.<verse eid="PSA 93:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 93:5"/>Wò sewo le te goŋgoŋgoŋ;</para>
  <para style="q2" vid="PSA 93:5">O! Yehowa, kɔkɔenyenye ɖo atsyɔ̃</para>
  <para style="q2" vid="PSA 93:5">na wò aƒe ɣeawo katã ɣi.<verse eid="PSA 93:5"/></para>
  <chapter eid="PSA 93"/>
  <chapter number="94" style="c" sid="PSA 94"/>
  <para style="cl">Psalmo 94</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 94:1"/>O! Yehowa, Mawu si biaa hlɔ̃,</para>
  <para style="q2" vid="PSA 94:1">O! Mawu si biaa hlɔ̃, klẽ.<verse eid="PSA 94:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 94:2"/>Tso, o xexea me ƒe Ʋɔnudrɔ̃la,</para>
  <para style="q2" vid="PSA 94:2">ɖo nu si dadalawo wɔ la teƒe na wo.<verse eid="PSA 94:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 94:3"/>O! Yehowa, va se ɖe ɣe ka ɣi</para>
  <para style="q2" vid="PSA 94:3">ame vɔ̃ɖi la atso aseye?<verse eid="PSA 94:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 94:4"/>Wole nya tovowo gblɔm,</para>
  <para style="q2" vid="PSA 94:4">eye dada yɔ ame vɔ̃ɖiwo katã me fũu.<verse eid="PSA 94:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 94:5"/>O! Yehowa, wogbã wò dukɔ la nyanyanya,</para>
  <para style="q2" vid="PSA 94:5">wote wò domenyinu la ɖe to.<verse eid="PSA 94:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 94:6"/>Wowu ahosiwo kple amedzrowo,</para>
  <para style="q2" vid="PSA 94:6">eye wowu tsyɔ̃eviwo hã.<verse eid="PSA 94:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 94:7"/>Wogblɔ be, “Yehowa mele ekpɔm o,</para>
  <para style="q2" vid="PSA 94:7">Yakob ƒe Mawu la metsɔ ɖeke le eme o.”<verse eid="PSA 94:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 94:8"/>Mikpɔ nyuie, mi gegeme siwo le dukɔ la me,</para>
  <para style="q2" vid="PSA 94:8">mi bometsilawo, ɣe ka ɣi miadze nunya?<verse eid="PSA 94:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 94:9"/>Ɖe eya ame si wɔ to la mase nu oa?</para>
  <para style="q2" vid="PSA 94:9">Ɖe eya ame si wɔ ŋku la makpɔ nu oa?<verse eid="PSA 94:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 94:10"/>Ɖe eya ame si hea to na dukɔwo la mahe to oa?</para>
  <para style="q2" vid="PSA 94:10">Ɖe eya ame si fiaa nu ame la, ahiã na nunya?<verse eid="PSA 94:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 94:11"/>Yehowa nya amegbetɔ ƒe susu,</para>
  <para style="q2" vid="PSA 94:11">eye wònya be tofloko ko wònye.<verse eid="PSA 94:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 94:12"/>O, Yehowa, woayra ame si nèhe to na,</para>
  <para style="q2" vid="PSA 94:12">ame si nèfia nui tso wò se la me,<verse eid="PSA 94:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 94:13"/>eye nèna gbɔdzɔe tso dzɔgbevɔ̃eŋkekewo me,</para>
  <para style="q2" vid="PSA 94:13">va se ɖe esime wòɖe ʋe na ame vɔ̃ɖiwo.<verse eid="PSA 94:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 94:14"/>Elabena Yehowa magbe eƒe dukɔ la o,</para>
  <para style="q2" vid="PSA 94:14">eye magblẽ eƒe domenyinu ɖi o.<verse eid="PSA 94:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 94:15"/>Woagaɖo ʋɔnudɔdrɔ̃ anyi ɖe dzɔdzɔenyenye dzi,</para>
  <para style="q2" vid="PSA 94:15">eye ame siwo katã ƒe dzi to mɔ ɖeka la adze eyome.<verse eid="PSA 94:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 94:16"/>Ame ka atso ɖe ame vɔ̃ɖiwo ŋu nam?</para>
  <para style="q2" vid="PSA 94:16">Ame ka atsi tsitre ɖe nu tovo wɔlawo ŋu ɖe nunye?<verse eid="PSA 94:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 94:17"/>Ɖe menye Yehowae kpe ɖe ŋunye o la,</para>
  <para style="q2" vid="PSA 94:17">anye ne eteƒe madidi o la, manɔ ɖoɖoezizi me le tsiẽƒe.<verse eid="PSA 94:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 94:18"/>Esi medo ɣli be,</para>
  <para style="q2" vid="PSA 94:18">“Nye afɔ le ɖiɖim” la, wò lɔlɔ̃,</para>
  <para style="q2" vid="PSA 94:18">O! Yehowa, de megbe nam.<verse eid="PSA 94:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 94:19"/>Esi dzitsitsi yɔ menye la,</para>
  <para style="q2" vid="PSA 94:19">wò akɔfaname he dzidzɔ vɛ na nye luʋɔ.<verse eid="PSA 94:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 94:20"/>Ɖe fiazikpui madzɔmadzɔ</para>
  <para style="q2" vid="PSA 94:20">si hea hiãkame vɛ to</para>
  <para style="q2" vid="PSA 94:20">eƒe sededewo me la ate ŋu ade ha kpli wòa?<verse eid="PSA 94:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 94:21"/>Wowɔa ɖeka ɖe ame dzɔdzɔewo ŋu,</para>
  <para style="q2" vid="PSA 94:21">eye wotsoa kufia na ame maɖifɔ.<verse eid="PSA 94:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 94:22"/>Gake Yehowae nye nye mɔ sesẽ,</para>
  <para style="q2" vid="PSA 94:22">nye Mawu kple agakpe si nye nye sitsoƒe.<verse eid="PSA 94:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 94:23"/>Aɖo woƒe nu vɔ̃wo teƒe na wo,</para>
  <para style="q2" vid="PSA 94:23">eye wòatsrɔ̃ wo le woƒe vɔ̃ɖinyenye ta, ɛ̃,</para>
  <para style="q2" vid="PSA 94:23">Yehowa, míaƒe Mawu la atsrɔ̃ wo.<verse eid="PSA 94:23"/></para>
  <chapter eid="PSA 94"/>
  <chapter number="95" style="c" sid="PSA 95"/>
  <para style="cl">Psalmo 95</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 95:1"/>Miva, mina míatso aseye ɖe Yehowa ŋu,</para>
  <para style="q2" vid="PSA 95:1">eye míado dzidzɔɣli ɖe míaƒe xɔxɔ ƒe Agakpe la ŋu.<verse eid="PSA 95:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 95:2"/>Mina míado ɖe eŋkume kple akpedada,</para>
  <para style="q2" vid="PSA 95:2">eye míadoe ɖe dzi to saŋku kple hadzidzi me.<verse eid="PSA 95:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 95:3"/>Elabena Yehowae nye Mawu gã la,</para>
  <para style="q2" vid="PSA 95:3">eye wònye fiagã si ƒo mawuwo katã ta.<verse eid="PSA 95:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 95:4"/>Anyigba ƒe gogloƒewo le eƒe asi me,</para>
  <para style="q2" vid="PSA 95:4">eye towo ƒe tsutsueƒe ke hã nye etɔ.<verse eid="PSA 95:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 95:5"/>Atsiaƒu hã nye etɔ,</para>
  <para style="q2" vid="PSA 95:5">elabena eyae wɔe, eye eƒe asie wɔ anyigba ƒuƒui hã.<verse eid="PSA 95:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 95:6"/>Miva, mina míabɔbɔ ade ta agu nɛ,</para>
  <para style="q2" vid="PSA 95:6">eye mina míadze klo ɖe</para>
  <para style="q2" vid="PSA 95:6">Yehowa, mía Wɔla la ƒe ŋkume.<verse eid="PSA 95:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 95:7"/>Elabena eyae nye míaƒe Mawu,</para>
  <para style="q2" vid="PSA 95:7">eye míenye amewo le eƒe lãnyiƒe,</para>
  <para style="q2" vid="PSA 95:7">kple lãha le eƒe dzikpɔkpɔ te.</para>
  <para style="b" vid="PSA 95:7"/>
  <para style="q1" vid="PSA 95:7">Egbe, ne miese eƒe gbe la,<verse eid="PSA 95:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 95:8"/>migasẽ miaƒe dzi me abe ale si miewɔ le Meriba</para>
  <para style="q2" vid="PSA 95:8">kple ale si miewɔ gbe ma gbe le Masa le gbea dzi ene o.<verse eid="PSA 95:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 95:9"/>Afi mae mia fofowo,</para>
  <para style="q2" vid="PSA 95:9">togbɔ be wokpɔ nu si mewɔ hã la,</para>
  <para style="q2" vid="PSA 95:9">wodom kpɔ, eye wotem kpɔ le.<verse eid="PSA 95:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 95:10"/>Medo dɔmedzoe ɖe dzidzime ma ŋu ƒe blaene sɔŋ,</para>
  <para style="q2" vid="PSA 95:10">megblɔ be, “Wonye ame siwo ƒe dzi tra mɔ,</para>
  <para style="q2" vid="PSA 95:10">eye womenya nye mɔwo o.”<verse eid="PSA 95:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 95:11"/>Ale le nye dɔmedzoe me, meka atam be,</para>
  <para style="q2" vid="PSA 95:11">“Womayi ɖe nye dzudzɔ la me gbeɖe o.”<verse eid="PSA 95:11"/></para>
  <chapter eid="PSA 95"/>
  <chapter number="96" style="c" sid="PSA 96"/>
  <para style="cl">Psalmo 96</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 96:1"/>Midzi ha yeye na Yehowa;</para>
  <para style="q2" vid="PSA 96:1">Mi anyigbawo katã, midzi ha na Yehowa.<verse eid="PSA 96:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 96:2"/>Midzi ha na Yehowa, mikafu eƒe ŋkɔ;</para>
  <para style="q2" vid="PSA 96:2">miɖe gbeƒã eƒe xɔxɔ gbe sia gbe.<verse eid="PSA 96:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 96:3"/>Miɖe eƒe Ŋutikɔkɔefia le dukɔwo dome</para>
  <para style="q2" vid="PSA 96:3">kple eƒe nukudɔwo fia le anyigbadzitɔwo katã dome.<verse eid="PSA 96:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 96:4"/>Elabena Yehowa lolo,</para>
  <para style="q2" vid="PSA 96:4">eye wòdze kafukafu ŋutɔ;</para>
  <para style="q2" vid="PSA 96:4">ele be woavɔ̃e wu mawuwo katã.<verse eid="PSA 96:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 96:5"/>Dukɔwo ƒe mawuwo nye legbawo,</para>
  <para style="q2" vid="PSA 96:5">ke Yehowae wɔ dziƒowo.<verse eid="PSA 96:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 96:6"/>Atsyɔ̃ kple gãnyenye le eŋgɔ,</para>
  <para style="q2" vid="PSA 96:6">eye ŋusẽ kple ŋutikɔkɔe le eƒe kɔkɔeƒe la me.<verse eid="PSA 96:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 96:7"/>O! Mi dukɔwo ƒe ƒomewo,</para>
  <para style="q2" vid="PSA 96:7">mitsɔ ŋutikɔkɔe kple ŋusẽ na Yehowa.<verse eid="PSA 96:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 96:8"/>Mitsɔ ŋutikɔkɔe si dze eƒe ŋkɔ la nɛ,</para>
  <para style="q2" vid="PSA 96:8">eye mitsɔ vɔsanuwo va eƒe xɔxɔnuwoe.<verse eid="PSA 96:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 96:9"/>Misubɔ Yehowa le eƒe kɔkɔenyenye ƒe atsyɔ̃ me,</para>
  <para style="q2" vid="PSA 96:9">eye anyigba katã nedzo nyanyanya le eŋkume.<verse eid="PSA 96:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 96:10"/>Migblɔ le dukɔwo dome be, “Yehowae le fia ɖum.”</para>
  <para style="q2" vid="PSA 96:10">Eɖo xexea me gɔme anyi goŋgoŋgoŋ, mate ŋu aʋã o;</para>
  <para style="q2" vid="PSA 96:10">eye adrɔ̃ ʋɔnu amewo ameŋkumemakpɔmakpɔtɔe.<verse eid="PSA 96:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 96:11"/>Mina dziƒowo natso aseye, anyigba nekpɔ dzidzɔ,</para>
  <para style="q2" vid="PSA 96:11">atsiaƒu kple emenuwo katã neɖe gbe,<verse eid="PSA 96:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 96:12"/>eye gbegbe kple emenuwo katã netso aseye.</para>
  <para style="q2" vid="PSA 96:12">Ekema avemetiwo adzi ha atso aseye;<verse eid="PSA 96:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 96:13"/>woadzi ha le Yehowa ŋgɔ, elabena egbɔna,</para>
  <para style="q2" vid="PSA 96:13">eye wògbɔna ʋɔnu drɔ̃ ge.</para>
  <para style="q1" vid="PSA 96:13">Adrɔ̃ ʋɔnu xexea me le dzɔdzɔenyenye me</para>
  <para style="q2" vid="PSA 96:13">kple dukɔwo le nyateƒe me.<verse eid="PSA 96:13"/></para>
  <chapter eid="PSA 96"/>
  <chapter number="97" style="c" sid="PSA 97"/>
  <para style="cl">Psalmo 97</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 97:1"/>Yehowa le fia ɖum, anyigba nekpɔ dzidzɔ,</para>
  <para style="q2" vid="PSA 97:1">eye ƒutadu siwo le didiƒe ke la netso aseye.<verse eid="PSA 97:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 97:2"/>Lilikpowo kple blukɔ tsiɖitsiɖi ƒo xlãe,</para>
  <para style="q2" vid="PSA 97:2">eye dzɔdzɔenyenye kple afia nyui tsotso nye</para>
  <para style="q2" vid="PSA 97:2">eƒe fiazikpui ƒe gɔmeɖokpe.<verse eid="PSA 97:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 97:3"/>Dzo le bibim le eŋgɔ,</para>
  <para style="q2" vid="PSA 97:3">eye wòle eƒe futɔwo fiam le akpa sia akpa.<verse eid="PSA 97:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 97:4"/>Eƒe dzikedzo si akaɖi ɖe xexea me,</para>
  <para style="q2" vid="PSA 97:4">eye anyigba kpɔe heʋuʋu heyeheye.<verse eid="PSA 97:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 97:5"/>Towo lolo abe yɔkumi ene le Yehowa ŋgɔ, ɛ̃,</para>
  <para style="q2" vid="PSA 97:5">le anyigba ƒe Aƒetɔ la ŋkume.<verse eid="PSA 97:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 97:6"/>Dziƒowo le gbeƒã ɖem eƒe dzɔdzɔenyenye,</para>
  <para style="q2" vid="PSA 97:6">eye dukɔwo katã kpɔ eƒe ŋutikɔkɔe.<verse eid="PSA 97:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 97:7"/>Ŋukpe lé aklamakpakpɛsubɔlawo katã,</para>
  <para style="q2" vid="PSA 97:7">ame siwo tsɔa legbawo ƒoa adegbee,</para>
  <para style="q2" vid="PSA 97:7">ke misubɔe, mi mawuwo katã!<verse eid="PSA 97:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 97:8"/>Zion see, dzi dzɔe, eye Yuda ƒe kɔƒewo hã tso aseye</para>
  <para style="q2" vid="PSA 97:8">le wò afia nyui tsotsowo ta, o Yehowa.<verse eid="PSA 97:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 97:9"/>O! Yehowa, wò koe nye Dziƒoʋĩtɔ ɖe anyigba la katã dzi,</para>
  <para style="q2" vid="PSA 97:9">eye wodo wò ɖe dzi gbɔ mawuwo katã ta sãsãsã.<verse eid="PSA 97:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 97:10"/>Mi ame siwo lɔ̃a Yehowa la, mitsri vɔ̃,</para>
  <para style="q2" vid="PSA 97:10">elabena edzɔa etɔ siwo wɔa nuteƒe la ƒe agbe ŋuti,</para>
  <para style="q2" vid="PSA 97:10">eye wòɖea woƒe agbe tso ame vɔ̃ɖiwo ƒe asi me.<verse eid="PSA 97:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 97:11"/>Kekeli klẽna ɖe ame dzɔdzɔewo dzi, eye dzidzɔkpɔkpɔ yɔa</para>
  <para style="q2" vid="PSA 97:11">ame siwo ƒe dzi to mɔ ɖeka la ƒe dziwo me.<verse eid="PSA 97:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 97:12"/>Mi ame dzɔdzɔewo, mitso aseye le Yehowa me,</para>
  <para style="q2" vid="PSA 97:12">eye mikafu eƒe ŋkɔ kɔkɔe la.<verse eid="PSA 97:12"/></para>
  <chapter eid="PSA 97"/>
  <chapter number="98" style="c" sid="PSA 98"/>
  <para style="cl">Psalmo 98</para>
  <para style="d">Hadzidzi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 98:1"/>Midzi ha yeye na Yehowa, elabena ewɔ nu dzɔatsuwo;</para>
  <para style="q2" vid="PSA 98:1">eƒe nuɖusi kple eƒe abɔ kɔkɔe la wɔ ɖeɖedɔ nɛ.<verse eid="PSA 98:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 98:2"/>Yehowa na wonya eƒe ɖeɖe, eye wòklo nu</para>
  <para style="q2" vid="PSA 98:2">le eƒe dzɔdzɔenyenye dzi na dukɔwo.<verse eid="PSA 98:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 98:3"/>Eɖo ŋku eƒe lɔlɔ̃</para>
  <para style="q2" vid="PSA 98:3">kple nuteƒewɔwɔ dzi na Israel ƒe aƒe la,</para>
  <para style="q1" vid="PSA 98:3">eye anyigba ƒe mlɔenu ke hã</para>
  <para style="q2" vid="PSA 98:3">kpɔ míaƒe Mawu la ƒe ɖeɖe.<verse eid="PSA 98:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 98:4"/>Mi anyigbawo katã,</para>
  <para style="q2" vid="PSA 98:4">mido dzidzɔɣli na Yehowa,</para>
  <para style="q2" vid="PSA 98:4">migli kple hadzidzi kple saŋkuƒoƒo.<verse eid="PSA 98:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 98:5"/>Midzi ha na Yehowa kple kasaŋku,</para>
  <para style="q2" vid="PSA 98:5">mitsɔ kasaŋku, hadzidzi,<verse eid="PSA 98:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 98:6"/>kpẽkuku kple lãdzokuku</para>
  <para style="q2" vid="PSA 98:6">kpakple dzidzɔɣli do ɖe Yehowa, fia la ŋkume.<verse eid="PSA 98:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 98:7"/>Mina atsiaƒu kple nu siwo katã le eme la nado ɣli,</para>
  <para style="q2" vid="PSA 98:7">anyigba kple edzinɔlawo katã hã.<verse eid="PSA 98:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 98:8"/>Mina tɔsisiwo naƒo asikpe,</para>
  <para style="q2" vid="PSA 98:8">eye towo katã nadzi ha ɖekae le dzidzɔkpɔkpɔ ta.<verse eid="PSA 98:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 98:9"/>Wonedzi ha le Yehowa ŋkume,</para>
  <para style="q2" vid="PSA 98:9">elabena eva ʋɔnu drɔ̃ ge anyigba la.</para>
  <para style="q1" vid="PSA 98:9">Adrɔ̃ ʋɔnu anyigba la le dzɔdzɔenyenye me</para>
  <para style="q2" vid="PSA 98:9">kple dukɔwo ameŋkumemakpɔmakpɔtɔe.<verse eid="PSA 98:9"/></para>
  <chapter eid="PSA 98"/>
  <chapter number="99" style="c" sid="PSA 99"/>
  <para style="cl">Psalmo 99</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 99:1"/>Yehowa le fia ɖum, dukɔwo nedzo nyanyanya,</para>
  <para style="q2" vid="PSA 99:1">enɔ eƒe fiazikpui dzi gli le kerubiwo dome,</para>
  <para style="q2" vid="PSA 99:1">anyigba neʋuʋu.<verse eid="PSA 99:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 99:2"/>Yehowa nye gã le Zion,</para>
  <para style="q2" vid="PSA 99:2">ekɔ gbɔ dukɔwo katã ta.<verse eid="PSA 99:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 99:3"/>Wonekafu wò ŋkɔ gã,</para>
  <para style="q2" vid="PSA 99:3">dziŋɔ la, eya amea le kɔkɔe.<verse eid="PSA 99:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 99:4"/>Fia la nye ŋusẽtɔ,</para>
  <para style="q2" vid="PSA 99:4">elɔ̃a afia nyui tsotso,</para>
  <para style="q1" vid="PSA 99:4">wò la, èɖo dzɔdzɔenyenye anyi,</para>
  <para style="q2" vid="PSA 99:4">eye nèwɔ nu si le dzɔdzɔe le Yakob me.<verse eid="PSA 99:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 99:5"/>Mido Yehowa, míaƒe Mawu la</para>
  <para style="q2" vid="PSA 99:5">ɖe dzi, eye mide ta agu ɖe eƒe afɔ nu,</para>
  <para style="q2" vid="PSA 99:5">elabena eya amea le kɔkɔe.<verse eid="PSA 99:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 99:6"/>Mose kple Aron le eƒe nunɔlawo dome;</para>
  <para style="q2" vid="PSA 99:6">Samuel le ame siwo yɔ eƒe ŋkɔ la dome;</para>
  <para style="q2" vid="PSA 99:6">woyɔ Yehowa ŋkɔ, eye wòtɔ na wo.<verse eid="PSA 99:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 99:7"/>Eƒo nu na wo tso lilikpo dodo me,</para>
  <para style="q2" vid="PSA 99:7">eye wolé se kple ɖoɖo siwo wòtsɔ na wo la me ɖe asi.<verse eid="PSA 99:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 99:8"/>O! Yehowa, míaƒe Mawu, wòe tɔ na wo;</para>
  <para style="q2" vid="PSA 99:8">togbɔ be èhe to na wo</para>
  <para style="q1" vid="PSA 99:8">le woƒe nu tovowo ta hã la,</para>
  <para style="q2" vid="PSA 99:8">ènye tsɔtsɔke ƒe Mawu na Israel.<verse eid="PSA 99:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 99:9"/>Mido Yehowa, miaƒe Mawu la ɖe dzi,</para>
  <para style="q2" vid="PSA 99:9">eye misubɔe le eƒe to kɔkɔe la dzi,</para>
  <para style="q2" vid="PSA 99:9">elabena Yehowa, míaƒe Mawu la le kɔkɔe.<verse eid="PSA 99:9"/></para>
  <chapter eid="PSA 99"/>
  <chapter number="100" style="c" sid="PSA 100"/>
  <para style="cl">Psalmo 100</para>
  <para style="d">Hadzidzi Akpedaha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 100:1"/>Mi anyigbawo katã,</para>
  <para style="q2" vid="PSA 100:1">mido dzidzɔɣli ɖe Yehowa ŋu.<verse eid="PSA 100:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 100:2"/>Misubɔ Yehowa kple dzidzɔ,</para>
  <para style="q2" vid="PSA 100:2">eye mitsɔ aseyetsohawo do ɖe eŋkume.<verse eid="PSA 100:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 100:3"/>Minyae be Yehowae nye Mawu.</para>
  <para style="q2" vid="PSA 100:3">Eyae wɔ mí, eye míenye etɔ,</para>
  <para style="q2" vid="PSA 100:3">eƒe amewo kple alẽwo le eƒe lãnyiƒe míenye.<verse eid="PSA 100:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 100:4"/>Mige ɖe eƒe agbowo me kple akpedada,</para>
  <para style="q2" vid="PSA 100:4">eƒe xɔxɔnuwo kple kafukafu;</para>
  <para style="q2" vid="PSA 100:4">mida akpe nɛ, eye mikafu eƒe eŋkɔ.<verse eid="PSA 100:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 100:5"/>Elabena Yehowa nyo, eye eƒe lɔlɔ̃ li ɖaa;</para>
  <para style="q2" vid="PSA 100:5">nenema kee eƒe nuteƒewɔwɔ hã nɔa anyi</para>
  <para style="q2" vid="PSA 100:5">tso dzidzime yi dzidzime.<verse eid="PSA 100:5"/></para>
  <chapter eid="PSA 100"/>
  <chapter number="101" style="c" sid="PSA 101"/>
  <para style="cl">Psalmo 101</para>
  <para style="d">David ƒe ha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 101:1"/>O! Yehowa, madzi ha le wò lɔlɔ̃</para>
  <para style="q2" vid="PSA 101:1">kple afia nyui tsotso ŋuti,</para>
  <para style="q2" vid="PSA 101:1">eye madzi kafukafuha na wò.<verse eid="PSA 101:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 101:2"/>Makpɔ nyuie be menɔ agbe si ŋu mokaka mele o,</para>
  <para style="q2" vid="PSA 101:2">eya ta gbe ka gbe nàva asrãm kpɔ?</para>
  <para style="b" vid="PSA 101:2"/>
  <para style="q1" vid="PSA 101:2">Mazɔ le aƒenye me</para>
  <para style="q2" vid="PSA 101:2">kple dzi si ŋuti mokaka mele o.<verse eid="PSA 101:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 101:3"/>Nyematsɔ nu si me vɔ̃ le la aɖo nye ŋkume o.</para>
  <para style="b" vid="PSA 101:3"/>
  <para style="q2" vid="PSA 101:3">Metsri xɔsemanɔsitɔwo ƒe nuwɔnawo,</para>
  <para style="q2" vid="PSA 101:3">womalé ɖe ŋunye o.<verse eid="PSA 101:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 101:4"/>Ame siwo ƒe dzi to vo la, ate ɖa xaa tso gbɔnye,</para>
  <para style="q2" vid="PSA 101:4">kadodo aɖeke mele nye kple nu vɔ̃ɖi dome o.<verse eid="PSA 101:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 101:5"/>Made ga nu na ame si ƒo ɖi ehavi ƒe ŋkɔ le bebeme,</para>
  <para style="q2" vid="PSA 101:5">eye ame si ŋku gã le esi</para>
  <para style="q1" vid="PSA 101:5">eye wòdana le dzi me la,</para>
  <para style="q2" vid="PSA 101:5">eya nyematɔ ɖe egbɔ o.<verse eid="PSA 101:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 101:6"/>Nye ŋku anɔ nuteƒewɔlawo ŋu</para>
  <para style="q2" vid="PSA 101:6">le anyigba dzi, be woanɔ anyi kplim.</para>
  <para style="q1" vid="PSA 101:6">Ame si fɔɖiɖi mele eƒe zɔzɔme ŋu o la,</para>
  <para style="q2" vid="PSA 101:6">anye nye nunɔla.<verse eid="PSA 101:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 101:7"/>Ame si nye ameblela la, manɔ aƒenye me o,</para>
  <para style="q2" vid="PSA 101:7">eye ame si daa alakpa la matsi tsitre ɖe ŋkunye me o.<verse eid="PSA 101:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 101:8"/>Ŋdi sia ŋdi la, mana ame vɔ̃ɖi siwo</para>
  <para style="q2" vid="PSA 101:8">le anyigba dzi la nazi ɖoɖoe.</para>
  <para style="q1" vid="PSA 101:8">Maɖe nu tovo wɔla ɖe sia ɖe ɖa</para>
  <para style="q2" vid="PSA 101:8">le Yehowa ƒe du la me.<verse eid="PSA 101:8"/></para>
  <chapter eid="PSA 101"/>
  <chapter number="102" style="c" sid="PSA 102"/>
  <para style="cl">Psalmo 102</para>
  <para style="d">Hiãtɔ aɖe ƒe gbedodoɖa, esi nu te eŋu, eye wòfa konyi le Yehowa ŋkume.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 102:1"/>O! Yehowa, se nye gbedodoɖa,</para>
  <para style="q2" vid="PSA 102:1">eye nye kokoƒoƒo hena kpekpeɖeŋu neɖo gbɔwò.<verse eid="PSA 102:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 102:2"/>Mègaɣla wò ŋkume ɖem,</para>
  <para style="q2" vid="PSA 102:2">ne mele xaxa me o.</para>
  <para style="q1" vid="PSA 102:2">Trɔ wò to ɖe gbɔnye,</para>
  <para style="q2" vid="PSA 102:2">eye ne meyɔ wò la, nàtɔ nam kaba.<verse eid="PSA 102:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 102:3"/>Elabena nye ŋkekewo nu va yi abe dzudzɔ ene,</para>
  <para style="q2" vid="PSA 102:3">eye nye ƒuwo xɔ dzo hẽe abe dzokpo ene.<verse eid="PSA 102:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 102:4"/>Nye dzi xɔ abi, eye wòyrɔ abe gbe ene.</para>
  <para style="q2" vid="PSA 102:4">Meŋlɔ nye nuɖuɖu gɔ̃ hã be.<verse eid="PSA 102:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 102:5"/>Le nye ŋeŋe sesĩe ta la,</para>
  <para style="q2" vid="PSA 102:5">meɖi ku zu ƒu ɖeɖe.<verse eid="PSA 102:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 102:6"/>Mele abe ʋlukuku si le gbegbe ene,</para>
  <para style="q2" vid="PSA 102:6">alo abe ʋlukuku si le gli gbagbãwo tome ene.<verse eid="PSA 102:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 102:7"/>Mele ŋu le aba dzi,</para>
  <para style="q2" vid="PSA 102:7">eye mele abe xevi si tsi akogo le xɔ tame ene.<verse eid="PSA 102:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 102:8"/>Nye futɔwo le alɔme ɖem</para>
  <para style="q2" vid="PSA 102:8">le ŋunye ŋkeke blibo la,</para>
  <para style="q1" vid="PSA 102:8">eye ame siwo tso ɖe ŋunye</para>
  <para style="q2" vid="PSA 102:8">la tsɔ nye ŋkɔ wɔ ɖiŋudonui.<verse eid="PSA 102:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 102:9"/>Elabena meɖu dzowɔ abe nuɖuɖu ene,</para>
  <para style="q2" vid="PSA 102:9">eye metsɔ aɖatsi tɔtɔ nye nunonoe,<verse eid="PSA 102:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 102:10"/>le wò dziku helĩhelĩ la ta</para>
  <para style="q2" vid="PSA 102:10">elabena èdom ɖe dzi,</para>
  <para style="q2" vid="PSA 102:10">eye nètsɔm ƒu gbe ɖe adzɔge.<verse eid="PSA 102:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 102:11"/>Nye ŋkekewo le abe fiẽ ƒe vɔvɔli ene,</para>
  <para style="q2" vid="PSA 102:11">eye meyrɔ abe gbe ene.<verse eid="PSA 102:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 102:12"/>O! Yehowa, wò la èle fia ɖum tegbetegbe,</para>
  <para style="q2" vid="PSA 102:12">eye wò ŋkɔxɔxɔ li tso dzidzime yi dzidzime.<verse eid="PSA 102:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 102:13"/>Ke wò la àtso,</para>
  <para style="q2" vid="PSA 102:13">akpɔ nublanui na Zion,</para>
  <para style="q1" vid="PSA 102:13">elabena ɣeyiɣi de be nàve enu, ɛ̃,</para>
  <para style="q2" vid="PSA 102:13">ɣeyiɣi ɖoɖi la de.<verse eid="PSA 102:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 102:14"/>Elabena eƒe kpewo xɔ asi le wò dɔlawo gbɔ,</para>
  <para style="q2" vid="PSA 102:14">eye eƒe ʋuʋudedi gɔ̃ hã ʋãa</para>
  <para style="q2" vid="PSA 102:14">nublanuikpɔkpɔ le wo me.<verse eid="PSA 102:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 102:15"/>Dukɔwo avɔ̃ Yehowa ƒe ŋkɔ,</para>
  <para style="q2" vid="PSA 102:15">eye anyigbadzifiawo katã ade bubu wò ŋutikɔkɔe ŋu.<verse eid="PSA 102:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 102:16"/>Elabena Yehowa agbugbɔ Zion atso,</para>
  <para style="q2" vid="PSA 102:16">eye wòado le eƒe ŋutikɔkɔe me.<verse eid="PSA 102:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 102:17"/>Aɖo hiãtɔwo ƒe gbedodoɖa ŋu,</para>
  <para style="q2" vid="PSA 102:17">eye mado vlo woƒe kokoƒoƒo o.<verse eid="PSA 102:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 102:18"/>Miŋlɔ esia ɖi hena dzidzime siwo ava dzɔ,</para>
  <para style="q2" vid="PSA 102:18">ale be ame siwo womedzi haɖe o</para>
  <para style="q2" vid="PSA 102:18">la nakafu Yehowa be:<verse eid="PSA 102:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 102:19"/>“Yehowa kpɔ nu tso eƒe kɔkɔeƒe la,</para>
  <para style="q2" vid="PSA 102:19">eye wòkpɔ anyigba tso dziƒo,<verse eid="PSA 102:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 102:20"/>be wòase gamenɔlawo ƒe ŋeŋe,</para>
  <para style="q2" vid="PSA 102:20">eye wòaɖe ga ame siwo wotso kufia na.”<verse eid="PSA 102:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 102:21"/>Ale woaɖe gbeƒã Yehowa ƒe ŋkɔ le Zion</para>
  <para style="q2" vid="PSA 102:21">kple eƒe kafukafu le Yerusalem,<verse eid="PSA 102:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 102:22"/>ne dukɔwo kple fiaɖuƒewo</para>
  <para style="q2" vid="PSA 102:22">ƒo ƒu be woasubɔ Yehowa.<verse eid="PSA 102:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 102:23"/>Eŋe nye ŋusẽ le nye agbemɔ dzi,</para>
  <para style="q2" vid="PSA 102:23">eye wòɖe nye ŋkekewo dzi kpɔtɔ,<verse eid="PSA 102:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 102:24"/>eya ta megblɔ be, “O! Nye Mawu,</para>
  <para style="q2" vid="PSA 102:24">mègakplɔm dzoe le nye ŋkekewo ƒe titina o,</para>
  <para style="q2" vid="PSA 102:24">wò ame si ƒe ƒewo li tso dzidzime yi dzidzime.<verse eid="PSA 102:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 102:25"/>Le gɔmedzedzea me la, èɖo anyigba ƒe agunu anyi,</para>
  <para style="q2" vid="PSA 102:25">eye dziƒowo nye wò asinudɔwɔwɔ.<verse eid="PSA 102:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 102:26"/>Woatsrɔ̃, ke wò ya ànɔ anyi ɖaa;</para>
  <para style="q2" vid="PSA 102:26">woanyunyɔ abe avɔ ene,</para>
  <para style="q1" vid="PSA 102:26">eye àɖɔli wo abe avɔ ene</para>
  <para style="q2" vid="PSA 102:26">ahatsɔ wo aƒu gbe.<verse eid="PSA 102:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 102:27"/>Ke wò la, ègale ale si nènɔ,</para>
  <para style="q2" vid="PSA 102:27">eye wò ƒewo mawu enu akpɔ o.<verse eid="PSA 102:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 102:28"/>Wò dɔlawo ƒe viwo anɔ ŋkuwò me,</para>
  <para style="q2" vid="PSA 102:28">eye woaɖo woƒe dzidzimeviwo anyi le ŋkuwò me.”<verse eid="PSA 102:28"/></para>
  <chapter eid="PSA 102"/>
  <chapter number="103" style="c" sid="PSA 103"/>
  <para style="cl">Psalmo 103</para>
  <para style="d">David ƒe ha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 103:1"/>O! Nye luʋɔ, kafu Yehowa;</para>
  <para style="q2" vid="PSA 103:1">nu siwo katã le menye la,</para>
  <para style="q2" vid="PSA 103:1">mikafu eƒe ŋkɔ kɔkɔe la.<verse eid="PSA 103:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 103:2"/>O! Nye luʋɔ, kafu Yehowa,</para>
  <para style="q2" vid="PSA 103:2">eye mègaŋlɔ nu nyui siwo katã</para>
  <para style="q2" vid="PSA 103:2">wòwɔ na wò la be o.<verse eid="PSA 103:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 103:3"/>Ame si tsɔ wò vodadawo katã kea wò,</para>
  <para style="q2" vid="PSA 103:3">eye wòdaa gbe le wò dɔlélewo katã ŋu.<verse eid="PSA 103:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 103:4"/>Ame si ɖea wò agbe tso ʋe me,</para>
  <para style="q2" vid="PSA 103:4">eye wòtsɔa lɔlɔ̃ kple nublanuikpɔkpɔ ɖɔna na wò.<verse eid="PSA 103:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 103:5"/>Ame si tsɔa nu nyuiwo ɖia ƒo na wò didiwo,</para>
  <para style="q2" vid="PSA 103:5">ale be wò ɖekakpuinyenye gaɖoa yeye me abe hɔ̃ tɔ ene.<verse eid="PSA 103:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 103:6"/>Yehowa lɔ̃a nu dzɔdzɔe wɔwɔ,</para>
  <para style="q2" vid="PSA 103:6">eye wòtsoa afia na ame siwo katã wote ɖe anyi.<verse eid="PSA 103:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 103:7"/>Ena Mose nya eƒe mɔwo,</para>
  <para style="q2" vid="PSA 103:7">eye wòna Israelviwo nya eƒe nuwɔwɔwo.<verse eid="PSA 103:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 103:8"/>Yehowa kpɔa nublanui, eye wòvea ame nu,</para>
  <para style="q2" vid="PSA 103:8">medoa dɔmedzoe kabakaba o, eye lɔlɔ̃ bɔ ɖe esi.<verse eid="PSA 103:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 103:9"/>Metsɔa nya ɖe ame ŋu ɣe sia ɣi,</para>
  <para style="q2" vid="PSA 103:9">alo léa dɔmedzoe ɖi ɖikaa o.<verse eid="PSA 103:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 103:10"/>Mewɔna na mí ɖe míaƒe nu vɔ̃wo nu,</para>
  <para style="q2" vid="PSA 103:10">alo ɖoa eteƒe na mí ɖe míaƒe vodadawo nu o.<verse eid="PSA 103:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 103:11"/>Elabena abe ale si dziƒo kɔ tso anyigba gbɔe ene la,</para>
  <para style="q2" vid="PSA 103:11">nenemae eƒe lɔlɔ̃ loloe na ame siwo vɔ̃nɛ.<verse eid="PSA 103:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 103:12"/>Abe ale si ɣedzeƒe didii tso ɣetoɖoƒe gbɔ ene la,</para>
  <para style="q2" vid="PSA 103:12">nenemae wòte míaƒe dzidadawo ɖa tso mía gbɔe.<verse eid="PSA 103:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 103:13"/>Abe ale si fofo ƒe dɔ me trɔna ɖe viawo ŋuti ene la,</para>
  <para style="q2" vid="PSA 103:13">nenemae Yehowa kpɔa nublanui na ame siwo vɔ̃nɛ,<verse eid="PSA 103:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 103:14"/>elabena enya ale si wowɔ mí,</para>
  <para style="q2" vid="PSA 103:14">eye eɖo ŋku edzi be ʋuʋudedi ko míenye.<verse eid="PSA 103:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 103:15"/>Amegbetɔ ƒe ŋkekewo le abe gbe ene,</para>
  <para style="q2" vid="PSA 103:15">edzena abe seƒoƒo le gbedzi ene;<verse eid="PSA 103:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 103:16"/>ya ƒona toa edzi, eye meganɔa anyi o,</para>
  <para style="q2" vid="PSA 103:16">womegaɖoa ŋku eteƒe gɔ̃ hã dzi o.<verse eid="PSA 103:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 103:17"/>Gake tso mavɔ me yi ɖe mavɔ me, Yehowa ƒe lɔlɔ̃ li</para>
  <para style="q2" vid="PSA 103:17">kple ame siwo vɔ̃nɛ, eye eƒe dzɔdzɔenyenye nɔa anyi</para>
  <para style="q2" vid="PSA 103:17">kple wo viwo ƒe viwo<verse eid="PSA 103:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 103:18"/>kpakple ame siwo léa eƒe nubabla me ɖe asi,</para>
  <para style="q2" vid="PSA 103:18">eye woɖoa ŋku edzi wɔna ɖe eƒe sewo dzi.<verse eid="PSA 103:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 103:19"/>Yehowa ɖo eƒe fiazikpui anyi ɖe dziƒo,</para>
  <para style="q2" vid="PSA 103:19">eye eƒe fiaɖuƒe le wo katã dzi ɖum.<verse eid="PSA 103:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 103:20"/>Mi eƒe dɔlawo, mikafu Yehowa,</para>
  <para style="q2" vid="PSA 103:20">mi ŋusẽtɔ siwo wɔa eƒe lɔlɔ̃nu,</para>
  <para style="q2" vid="PSA 103:20">eye miewɔa eƒe nya dzi.<verse eid="PSA 103:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 103:21"/>Mikafu Yehowa,</para>
  <para style="q2" vid="PSA 103:21">mi eƒe dziƒoʋakɔwo katã,</para>
  <para style="q2" vid="PSA 103:21">mi eƒe dɔla siwo wɔa eƒe lɔlɔ̃nu.<verse eid="PSA 103:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 103:22"/>Mikafu Yehowa,</para>
  <para style="q2" vid="PSA 103:22">mi eƒe dɔwɔwɔwo katã,</para>
  <para style="q2" vid="PSA 103:22">le afi sia afi, le eƒe dziɖuɖu te.</para>
  <para style="b" vid="PSA 103:22"/>
  <para style="q1" vid="PSA 103:22">O! Nye luʋɔ, kafu Yehowa.<verse eid="PSA 103:22"/></para>
  <chapter eid="PSA 103"/>
  <chapter number="104" style="c" sid="PSA 104"/>
  <para style="cl">Psalmo 104</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 104:1"/>O! Luʋɔnye, kafu Yehowa.</para>
  <para style="b" vid="PSA 104:1"/>
  <para style="q1" vid="PSA 104:1">O! Yehowa, nye Mawu, èlolo loo;</para>
  <para style="q2" vid="PSA 104:1">èɖo atsyɔ̃, eye nèta gãnyenye.<verse eid="PSA 104:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 104:2"/>Etsyɔ kekeli abe avɔ ene,</para>
  <para style="q2" vid="PSA 104:2">ehe dziƒo me abe avɔgbadɔ ene,<verse eid="PSA 104:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 104:3"/>eye wòɖo eƒe dziƒoxɔwo ƒe sɔtiwo</para>
  <para style="q2" vid="PSA 104:3">ƒe agunu anyi ɖe woƒe tsiwo dzi.</para>
  <para style="q1" vid="PSA 104:3">Etsɔ lilikpowo wɔ eƒe tasiaɖam,</para>
  <para style="q2" vid="PSA 104:3">eye wònɔ ya ƒe aʋalawo dzi.<verse eid="PSA 104:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 104:4"/>Yae nye eƒe dɔtsɔlawo,</para>
  <para style="q2" vid="PSA 104:4">eye dzo ƒe aɖewo nye eƒe dɔlawo.<verse eid="PSA 104:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 104:5"/>Eɖo anyigba anyi ɖe eƒe gɔmeɖokpe dzi,</para>
  <para style="q2" vid="PSA 104:5">eya ta maʋã akpɔ gbeɖe o.<verse eid="PSA 104:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 104:6"/>Ètsɔ gogloƒewo tsyɔ nɛ abe avɔ ene,</para>
  <para style="q2" vid="PSA 104:6">eye tsiawo tɔ ɖe toawo tame.<verse eid="PSA 104:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 104:7"/>Ke esi nèblu la, tsiawo si,</para>
  <para style="q2" vid="PSA 104:7">eye esi nèɖe gbe la, wolé du tsɔ.<verse eid="PSA 104:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 104:8"/>Wosi to towo tame,</para>
  <para style="q2" vid="PSA 104:8">heva to balimewo, va ɖo teƒe si nètia na wo la.<verse eid="PSA 104:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 104:9"/>Èɖo liƒo si dzi womate ŋu adze to o la na wo,</para>
  <para style="q2" vid="PSA 104:9">eye womagakaka axɔ anyigba dzi akpɔ gbeɖe o.<verse eid="PSA 104:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 104:10"/>Ena tsitsetsewo kɔ ɖe agawo me,</para>
  <para style="q2" vid="PSA 104:10">eye wosi to towo dome.<verse eid="PSA 104:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 104:11"/>Wonaa tsi gbemelãwo,</para>
  <para style="q2" vid="PSA 104:11">eye wotsia gbetedziwo ƒe tsikɔwuame nu.<verse eid="PSA 104:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 104:12"/>Dziƒoxeviwo wɔa atɔ ɖe tsisisiawo to,</para>
  <para style="q2" vid="PSA 104:12">eye wodzia ha le atilɔwo dzi.<verse eid="PSA 104:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 104:13"/>Edea tsi towo tso eƒe xɔ dzigbemetɔ me;</para>
  <para style="q2" vid="PSA 104:13">eƒe dɔ ƒe kutsetse ɖia ƒo na anyigba.<verse eid="PSA 104:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 104:14"/>Ena gbe mie na nyihawo,</para>
  <para style="q2" vid="PSA 104:14">eye wòƒãa nuku na amegbetɔ be wòaxa,</para>
  <para style="q2" vid="PSA 104:14">ale wòna nuɖuɖu do tso anyigba la me na wo;<verse eid="PSA 104:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 104:15"/>wain si doa dzidzɔ na ame ƒe dzi,</para>
  <para style="q2" vid="PSA 104:15">ami si ana be eƒe mo nanɔ keklẽm</para>
  <para style="q2" vid="PSA 104:15">kple abolo si alé eƒe dzi ɖe te.<verse eid="PSA 104:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 104:16"/>Wode tsi Yehowa ƒe atiawo nyuie,</para>
  <para style="q2" vid="PSA 104:16">Lebanon ƒe sedati siwo wòdo.<verse eid="PSA 104:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 104:17"/>Afi mae xeviwo wɔ woƒe atɔwo ɖo,</para>
  <para style="q2" vid="PSA 104:17">eye aŋɔɣi wɔ eƒe nɔƒe ɖe gbotiwo me.<verse eid="PSA 104:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 104:18"/>To kɔkɔwo nye gbemegbɔ̃wo tɔ,</para>
  <para style="q2" vid="PSA 104:18">eye agakpewo tome zu bebeƒe na hlɔ̃madɛwo.<verse eid="PSA 104:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 104:19"/>Ɣleti dea vovototo ɣeyiɣiwo dome,</para>
  <para style="q2" vid="PSA 104:19">eye ɣe nya ɣeyiɣi si wòaɖo to.<verse eid="PSA 104:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 104:20"/>Ètsɔ viviti vɛ, eye wòzu zã, ale lã siwo katã</para>
  <para style="q2" vid="PSA 104:20">le ave me la doa go.<verse eid="PSA 104:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 104:21"/>Dzatawo ɖea gbe na nuléle,</para>
  <para style="q2" vid="PSA 104:21">eye wodia woƒe nuɖuɖu tso Mawu gbɔ.<verse eid="PSA 104:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 104:22"/>Ɣe dzena, eye wotrɔna dzona ɖamlɔa woƒe dowo me.<verse eid="PSA 104:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 104:23"/>Tete ame do go yi dɔ me,</para>
  <para style="q2" vid="PSA 104:23">yi ɖe eƒe dɔ gbɔ va se ɖe fiẽ.<verse eid="PSA 104:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 104:24"/>O! Yehowa, wò dɔwɔwɔwo sɔ gbɔ loo!</para>
  <para style="q2" vid="PSA 104:24">Èwɔ wo katã le nunya deto me,</para>
  <para style="q2" vid="PSA 104:24">anyigba dzi yɔ fũu kple wò nuwɔwɔwo.<verse eid="PSA 104:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 104:25"/>Atsiaƒue nye ekem, elolo hekeke,</para>
  <para style="q2" vid="PSA 104:25">lã siwo mele xexlẽme o la yɔe,</para>
  <para style="q1" vid="PSA 104:25">nenema kee nye nu gbagbe bubuwo hã,</para>
  <para style="q2" vid="PSA 104:25">suewo kple gãwo siaa.<verse eid="PSA 104:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 104:26"/>Meliwo zɔa edzi yina,</para>
  <para style="q2" vid="PSA 104:26">gagbɔna, eye afii mae boso si nèwɔ la hã le.<verse eid="PSA 104:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 104:27"/>Esiawo katã le asiwò nu kpɔm be</para>
  <para style="q2" vid="PSA 104:27">nàna nuɖuɖu yewo le wo naɣi.<verse eid="PSA 104:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 104:28"/>Ne èna wo la, woƒonɛ ƒu;</para>
  <para style="q2" vid="PSA 104:28">eye ne èʋu wò asi la, ètsɔa nu nyui ɖia ƒo na wo.<verse eid="PSA 104:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 104:29"/>Ke ne èɣla wò mo la,</para>
  <para style="q2" vid="PSA 104:29">ŋɔdzi léa wo, eye ne èxɔ woƒe gbɔgbɔ le wo si la,</para>
  <para style="q2" vid="PSA 104:29">wokuna, trɔna zua kewɔ.<verse eid="PSA 104:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 104:30"/>Ne èdɔ wò Gbɔgbɔ ɖa la,</para>
  <para style="q2" vid="PSA 104:30">wodzɔna, eye nèwɔa anyigba ƒe ŋkume yeyee.<verse eid="PSA 104:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 104:31"/>Yehowa ƒe ŋutikɔkɔe nenɔ anyi tegbee.</para>
  <para style="q2" vid="PSA 104:31">Yehowa nekpɔ dzidzɔ le eƒe dɔwɔwɔwo ŋu,<verse eid="PSA 104:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 104:32"/>eya ame si do mo ɖe anyigba dzi, eye anyigba dzo nyanyanya;</para>
  <para style="q2" vid="PSA 104:32">eya ame si ka asi towo ŋu, eye wotu dzudzɔ.<verse eid="PSA 104:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 104:33"/>Madzi ha na Yehowa le nye agbemeŋkekewo katã me,</para>
  <para style="q2" vid="PSA 104:33">eye zi ale si mele agbe la,</para>
  <para style="q2" vid="PSA 104:33">madzi kafukafuha na nye Mawu la.<verse eid="PSA 104:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 104:34"/>Nye ŋugbledede nedze eŋu,</para>
  <para style="q2" vid="PSA 104:34">esi mele dzidzɔ kpɔm le Yehowa me.<verse eid="PSA 104:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 104:35"/>Ke nu vɔ̃ wɔlawo netsrɔ̃ ɖa le anyigba dzi,</para>
  <para style="q2" vid="PSA 104:35">eye ame vɔ̃ɖiwo maganɔ anyi o.</para>
  <para style="b" vid="PSA 104:35"/>
  <para style="q1" vid="PSA 104:35">O! Luʋɔnye, kafu Yehowa.</para>
  <para style="b" vid="PSA 104:35"/>
  <para style="q1" vid="PSA 104:35">Mikafu Yehowa.<verse eid="PSA 104:35"/></para>
  <chapter eid="PSA 104"/>
  <chapter number="105" style="c" sid="PSA 105"/>
  <para style="cl">Psalmo 105</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 105:1"/>Mida akpe na Yehowa,</para>
  <para style="q2" vid="PSA 105:1">miyɔ eƒe ŋkɔ, eye miɖe gbeƒã nu</para>
  <para style="q2" vid="PSA 105:1">siwo wòwɔ la le dukɔwo dome.<verse eid="PSA 105:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 105:2"/>Midzi ha nɛ, midzi kafukafuha nɛ,</para>
  <para style="q2" vid="PSA 105:2">miɖe gbeƒã eƒe nukunuwɔwɔwo.<verse eid="PSA 105:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 105:3"/>Miƒo adegbe le eƒe ŋkɔ kɔkɔe la ŋu,</para>
  <para style="q2" vid="PSA 105:3">mina ame siwo dia Yehowa la ƒe dzi natso aseye.<verse eid="PSA 105:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 105:4"/>Midi Yehowa, mibia eƒe ŋusẽ,</para>
  <para style="q2" vid="PSA 105:4">midi eƒe ŋkume ɖaa.<verse eid="PSA 105:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 105:5"/>Miɖo ŋku nukunu siwo wòwɔ,</para>
  <para style="q2" vid="PSA 105:5">eƒe dzesiwo kple eƒe ʋɔnudɔdrɔ̃wo dzi.<verse eid="PSA 105:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 105:6"/>O! Eƒe dɔla Abraham ƒe dzidzimeviwo.</para>
  <para style="q2" vid="PSA 105:6">O! Yakob ƒe viwo, ame siwo wòtia.<verse eid="PSA 105:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 105:7"/>Eyae nye Yehowa, míaƒe Mawu la,</para>
  <para style="q2" vid="PSA 105:7">eƒe ʋɔnudɔdrɔ̃ xɔ anyigba la katã dzi la me.<verse eid="PSA 105:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 105:8"/>Eɖoa ŋku eƒe nubabla</para>
  <para style="q2" vid="PSA 105:8">kple se siwo wòde</para>
  <para style="q2" vid="PSA 105:8">na dzidzime akpewo la dzi ɖaa,<verse eid="PSA 105:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 105:9"/>eyae nye nu si wòbla kple Abraham</para>
  <para style="q2" vid="PSA 105:9">kple atam si wòka na Isak.<verse eid="PSA 105:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 105:10"/>Eɖo kpe edzi na Yakob abe sedede ene,</para>
  <para style="q2" vid="PSA 105:10">eye na Israel abe nubabla mavɔ ene be,<verse eid="PSA 105:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 105:11"/>“Wòe matsɔ Kanaanyigba la na,</para>
  <para style="q2" vid="PSA 105:11">abe wò domenyinu ene.”<verse eid="PSA 105:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 105:12"/>Ke esi wonye ame ʋɛ aɖewo ko,</para>
  <para style="q2" vid="PSA 105:12">womesɔ gbɔ o,</para>
  <para style="q2" vid="PSA 105:12">eye wonye amedzrowo le anyigba dzi la,<verse eid="PSA 105:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 105:13"/>wotsa tso dukɔ me yi dukɔ me,</para>
  <para style="q2" vid="PSA 105:13">tso fiaɖuƒe ɖeka me yi bubu me.<verse eid="PSA 105:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 105:14"/>Meɖe mɔ be ame aɖeke nate wo ɖe anyi o,</para>
  <para style="q2" vid="PSA 105:14">le wo ta, wòka mo na fiawo be,<verse eid="PSA 105:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 105:15"/>“Migaka asi nye amesiaminawo ŋu o,</para>
  <para style="q2" vid="PSA 105:15">eye migawɔ nu vevi nye nyagblɔɖilawo o.”<verse eid="PSA 105:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 105:16"/>Ena dɔ to ɖe anyigba la dzi,</para>
  <para style="q2" vid="PSA 105:16">eye wògblẽ woƒe nuɖuɖukpɔtsoƒewo katã,<verse eid="PSA 105:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 105:17"/>ke edɔ ŋutsu aɖe si woyɔna be Yosef,</para>
  <para style="q2" vid="PSA 105:17">ame si wodzra abe kluvi ene la ɖe wo ŋgɔ.<verse eid="PSA 105:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 105:18"/>Wode kunyowu afɔ nɛ,</para>
  <para style="q2" vid="PSA 105:18">wode abi eŋu, eye wotsɔ gakɔsɔkɔsɔ de kɔ nɛ,<verse eid="PSA 105:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 105:19"/>va se ɖe esime nya si wògblɔ ɖi la va eme,</para>
  <para style="q2" vid="PSA 105:19">eye va se ɖe esime Yehowa ƒe nya</para>
  <para style="q2" vid="PSA 105:19">naɖo kpe edzi, be nya si wògblɔ la nye nyateƒe.<verse eid="PSA 105:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 105:20"/>Fia la dɔ ame woyi ɖaɖee le game,</para>
  <para style="q2" vid="PSA 105:20">eye dukɔ la dziɖula na ablɔɖee.<verse eid="PSA 105:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 105:21"/>Etsɔe ɖo amegãe ɖe eƒe aƒe nu,</para>
  <para style="q2" vid="PSA 105:21">eye wònye eƒe nunɔamesiwo katã dzikpɔla,<verse eid="PSA 105:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 105:22"/>be wòade dɔ asi na eƒe dɔnunɔlawo ale si dze eŋu,</para>
  <para style="q2" vid="PSA 105:22">eye wòafia nunya eƒe dumegãwo.<verse eid="PSA 105:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 105:23"/>Ale Israel ge ɖe Egiptenyigba dzi,</para>
  <para style="q2" vid="PSA 105:23">eye Yakob nɔ Hamnyigba dzi abe amedzro ene.<verse eid="PSA 105:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 105:24"/>Yehowa na eƒe dukɔ la dzi ɖe edzi,</para>
  <para style="q2" vid="PSA 105:24">eye wòna wosɔ gbɔ fũu akpa na woƒe futɔwo,<verse eid="PSA 105:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 105:25"/>ame siwo ƒe dzi wòtrɔ be woalé fu eƒe dukɔ la,</para>
  <para style="q2" vid="PSA 105:25">eye woaɖo nugbe ɖe eƒe dɔlawo ŋu.<verse eid="PSA 105:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 105:26"/>Edɔ Mose, eƒe dɔla kple Aron, eƒe ame tiatia ɖa.<verse eid="PSA 105:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 105:27"/>Wowɔ eƒe dzesi gãwo le wo dome</para>
  <para style="q2" vid="PSA 105:27">kple eƒe nukunuwo le Hamnyigba dzi.<verse eid="PSA 105:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 105:28"/>Eɖo viviti ɖa, eye anyigba la dzi do blukɔ</para>
  <para style="q2" vid="PSA 105:28">elabena ɖe wometsi tsitre ɖe eƒe nyawo ŋu oa?<verse eid="PSA 105:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 105:29"/>Ena woƒe tsiwo trɔ zu ʋu,</para>
  <para style="q2" vid="PSA 105:29">eye to esia me woƒe tɔmelãwo ku.<verse eid="PSA 105:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 105:30"/>Ena woƒe anyigba la dzi yɔ fũu kple akpɔkplɔwo,</para>
  <para style="q2" vid="PSA 105:30">esiwo ge ɖe woƒe dumegãwo ƒe xɔgãwo me ke.<verse eid="PSA 105:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 105:31"/>Eƒo nu, eye tagbatsutsu kple togbato ƒe ha gã aɖe va xɔ</para>
  <para style="q2" vid="PSA 105:31">woƒe dukɔ la katã me.<verse eid="PSA 105:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 105:32"/>Etrɔ woƒe tsidzadza wòzu kpetsi,</para>
  <para style="q2" vid="PSA 105:32">eye dzikedzo kpe ɖe eŋuti</para>
  <para style="q2" vid="PSA 105:32">le woƒe anyigba blibo la dzi.<verse eid="PSA 105:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 105:33"/>Eƒo woƒe wainkawo kple gbotiwo ƒu anyi,</para>
  <para style="q2" vid="PSA 105:33">eye wòmu ati siwo le woƒe dukɔ me la ƒu anyi.<verse eid="PSA 105:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 105:34"/>Eƒo nu, eye ʋetsuviwo va ƒo ɖi,</para>
  <para style="q2" vid="PSA 105:34">nenema kee nye abɔ gbogbo aɖewo hã;<verse eid="PSA 105:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 105:35"/>woɖu numiemie mumu ɖe sia ɖe le woƒe anyigba la dzi,</para>
  <para style="q2" vid="PSA 105:35">eye woɖu nuku ɖe sia ɖe si le bo dzi hã.<verse eid="PSA 105:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 105:36"/>Emegbe la, eƒo ŋgɔgbevi siwo katã</para>
  <para style="q2" vid="PSA 105:36">le woƒe anyigba dzi la ƒu anyi,</para>
  <para style="q2" vid="PSA 105:36">esiwo nye woƒe ŋutsunyenye ƒe kutsetse gbãtɔwo.<verse eid="PSA 105:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 105:37"/>Ke ekplɔ Israel do goe, wodo agba kple klosalo kple sika,</para>
  <para style="q2" vid="PSA 105:37">eye ame beli aɖeke menɔ woƒe toawo dome o.<verse eid="PSA 105:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 105:38"/>Egipte kpɔ dzidzɔ esi wodo go dzo,</para>
  <para style="q2" vid="PSA 105:38">elabena Israel ƒe ŋɔdzi lé wo.<verse eid="PSA 105:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 105:39"/>Ekeke lilikpo ɖe wo dzi abe avɔ ene,</para>
  <para style="q2" vid="PSA 105:39">eye wòna dzo wo be wòanye akaɖi na wo le zã me.<verse eid="PSA 105:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 105:40"/>Wobiae, eye wòna tegliwo woɖu,</para>
  <para style="q2" vid="PSA 105:40">eye wòtsɔ dziƒobolo ɖi ƒo na woe.<verse eid="PSA 105:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 105:41"/>Eʋu agakpe la, tsi do na wo bababa,</para>
  <para style="q2" vid="PSA 105:41">eye wòsi to gbegbe la abe tɔsisi ene.<verse eid="PSA 105:41"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 105:42"/>Elabena eɖo ŋku eƒe ŋugbe kɔkɔe si wòdo na</para>
  <para style="q2" vid="PSA 105:42">eƒe dɔla Abraham la dzi.<verse eid="PSA 105:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 105:43"/>Ekplɔ eƒe dukɔ la do goe kple aseyetsotso,</para>
  <para style="q2" vid="PSA 105:43">eƒe ame tiatiawo kple dzidzɔɣli.<verse eid="PSA 105:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 105:44"/>Etsɔ dukɔwo ƒe anyigbawo na wo,</para>
  <para style="q2" vid="PSA 105:44">eye nu si ame bubuwo ku kutri kpɔ la</para>
  <para style="q2" vid="PSA 105:44">va zu domenyinu na wo.<verse eid="PSA 105:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 105:45"/>Ale be woalé eƒe ɖoɖowo me ɖe asi,</para>
  <para style="q2" vid="PSA 105:45">eye woawɔ eƒe sewo dzi.</para>
  <para style="b" vid="PSA 105:45"/>
  <para style="q1" vid="PSA 105:45">Mikafu Yehowa.<verse eid="PSA 105:45"/></para>
  <chapter eid="PSA 105"/>
  <chapter number="106" style="c" sid="PSA 106"/>
  <para style="cl">Psalmo 106</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 106:1"/>Mikafu Yehowa.</para>
  <para style="b" vid="PSA 106:1"/>
  <para style="q1" vid="PSA 106:1">Mida akpe na Yehowa,</para>
  <para style="q2" vid="PSA 106:1">elabena eƒe dɔ me nyo, eye eƒe lɔlɔ̃ li ɖaa.<verse eid="PSA 106:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 106:2"/>Ame kae ate ŋu aɖe gbeƒã Yehowa ƒe nu dzɔatsu</para>
  <para style="q2" vid="PSA 106:2">siwo wòwɔ alo akafui wòade go?<verse eid="PSA 106:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 106:3"/>Woayra ame siwo léa dzɔdzɔenyenye me ɖe asi,</para>
  <para style="q2" vid="PSA 106:3">ame siwo wɔa nu si nyo la ɣe sia ɣi.<verse eid="PSA 106:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 106:4"/>O! Yehowa, ɖo ŋku dzinye ne èle wò dukɔ la nu vem,</para>
  <para style="q2" vid="PSA 106:4">va kpe ɖe ŋunye ne èle wo ɖem,<verse eid="PSA 106:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 106:5"/>be nye hã makpɔ gome le wò ame tiatiawo ƒe dzidzedzekpɔkpɔ me,</para>
  <para style="q2" vid="PSA 106:5">be makpɔ dzidzɔ kple wò dukɔ la,</para>
  <para style="q2" vid="PSA 106:5">eye mawɔ ɖeka kple wò domenyinu la, akafu wò.<verse eid="PSA 106:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 106:6"/>Míewɔ nu vɔ̃ abe mía fofowo ke ene;</para>
  <para style="q2" vid="PSA 106:6">míewɔ nu tovo, eye míewɔ nu vɔ̃ɖi.<verse eid="PSA 106:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 106:7"/>Esi mía fofowo nɔ Egipte la,</para>
  <para style="q2" vid="PSA 106:7">womebu wò nukunuwo ŋu o;</para>
  <para style="q2" vid="PSA 106:7">womeɖo ŋku wò dɔmenyo gbogboawo dzi o,</para>
  <para style="q1" vid="PSA 106:7">ke boŋ wodze aglã le ƒu la to,</para>
  <para style="q2" vid="PSA 106:7">le Ƒu Dzĩ la to,<verse eid="PSA 106:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 106:8"/>gake eɖe wo le eƒe ŋkɔ la ta,</para>
  <para style="q2" vid="PSA 106:8">be wòana woanya eƒe ŋusẽ triakɔ la.<verse eid="PSA 106:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 106:9"/>Eblu ɖe Ƒu Dzĩ la ta, eye wòmie;</para>
  <para style="q2" vid="PSA 106:9">ale wòkplɔ wo to ƒugɔme abe tagba ƒuƒui ene.<verse eid="PSA 106:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 106:10"/>Eɖe wo tso futɔ la ƒe asi me,</para>
  <para style="q2" vid="PSA 106:10">eye ketɔ la ƒe asimee wòxɔ wo le.<verse eid="PSA 106:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 106:11"/>Tsi la ŋe tsyɔ wo yometilawo dzi,</para>
  <para style="q2" vid="PSA 106:11">eye ɖeka pɛ gɔ̃ hã metsi agbe o.<verse eid="PSA 106:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 106:12"/>Tete woxɔ eƒe ŋugbedodowo dzi se,</para>
  <para style="q2" vid="PSA 106:12">eye wodzi ha kafui.<verse eid="PSA 106:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 106:13"/>Kasia woŋlɔ nu si wòwɔ la be xoxo,</para>
  <para style="q2" vid="PSA 106:13">eye womelala xɔ aɖaŋu tso egbɔ o.<verse eid="PSA 106:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 106:14"/>Le gbea dzi la, wodzro nu vevie,</para>
  <para style="q2" vid="PSA 106:14">eye le gbegbe la, wote Mawu kpɔ.<verse eid="PSA 106:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 106:15"/>Ale wòtsɔ nu si biam wole la na wo,</para>
  <para style="q2" vid="PSA 106:15">gake eɖo dɔvɔ̃ ɖe wo dome.<verse eid="PSA 106:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 106:16"/>Woʋã ŋu Mose kple Aron le asaɖa la me,</para>
  <para style="q2" vid="PSA 106:16">ame si ŋuti wokɔ na Yehowa.<verse eid="PSA 106:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 106:17"/>Anyigba ke nu mi Datan,</para>
  <para style="q2" vid="PSA 106:17">eye wòɖi Abiram kple eyomedzelawo agbagbe.<verse eid="PSA 106:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 106:18"/>Dzo va fia wo yomedzelawo,</para>
  <para style="q2" vid="PSA 106:18">eye dzo ƒe aɖewo fia ame vɔ̃ɖiawo.<verse eid="PSA 106:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 106:19"/>Wowɔ nyivi le Horeb to la gbɔ,</para>
  <para style="q2" vid="PSA 106:19">eye wosubɔ legba si wowɔ kple ga.<verse eid="PSA 106:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 106:20"/>Wotsɔ woƒe Ŋutikɔkɔe ɖɔli nyitsu si ɖua gbe.<verse eid="PSA 106:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 106:21"/>Woŋlɔ Mawu si ɖe wo la be,</para>
  <para style="q2" vid="PSA 106:21">Mawu si wɔ nu gãwo na wo le Egipte<verse eid="PSA 106:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 106:22"/>kple dzesiwo le Hamnyigba dzi</para>
  <para style="q2" vid="PSA 106:22">kple ŋɔdzinuwo le Ƒu Dzĩ la to.<verse eid="PSA 106:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 106:23"/>Eya ta wògblɔ be, yele wo tsrɔ̃ ge.</para>
  <para style="q2" vid="PSA 106:23">Ɖe Mose, eƒe ame tiatia la</para>
  <para style="q1" vid="PSA 106:23">metsi tsitre ɖe gbagbãƒe la hexe mɔ na</para>
  <para style="q2" vid="PSA 106:23">eƒe dziku helĩhelĩ la o la, anye ne etsrɔ̃ wo.<verse eid="PSA 106:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 106:24"/>Wodo vlo anyigba dzeani la,</para>
  <para style="q2" vid="PSA 106:24">eye womexɔ eƒe ŋugbedodo dzi se o.<verse eid="PSA 106:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 106:25"/>Wolĩ liʋĩliʋĩ le woƒe agbadɔwo me,</para>
  <para style="q2" vid="PSA 106:25">eye womeɖo to Yehowa o.<verse eid="PSA 106:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 106:26"/>Eya ta wòdo eƒe asiwo ɖe dzi ka atam na wo</para>
  <para style="q2" vid="PSA 106:26">be yele nana ge wo katã natsrɔ̃ ɖe gbea dzi,<verse eid="PSA 106:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 106:27"/>woƒe dzidzimeviwo atsi dukɔwo dome,</para>
  <para style="q2" vid="PSA 106:27">eye yeakaka wo ɖe anyigbawo dzi.<verse eid="PSA 106:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 106:28"/>Wotsɔ Baal Peor ƒe kɔkuti ku kɔ na wo ɖokuiwo,</para>
  <para style="q2" vid="PSA 106:28">eye woɖu nu siwo wotsɔ sa vɔ̃e na mawu siwo me agbe mele o.<verse eid="PSA 106:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 106:29"/>Wotsɔ woƒe nu vɔ̃ɖiawo do dɔmedzoe na Yehowa,</para>
  <para style="q2" vid="PSA 106:29">eye dɔvɔ̃ gbã gboo ɖe wo dome.<verse eid="PSA 106:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 106:30"/>Gake Finehas tsi tsitre hetso nya me,</para>
  <para style="q2" vid="PSA 106:30">tete dɔvɔ̃ la nu tso.<verse eid="PSA 106:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 106:31"/>Wobu esia dzɔdzɔenyenye nɛ</para>
  <para style="q2" vid="PSA 106:31">hena dzidzime mavɔ siwo ava dzɔ.<verse eid="PSA 106:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 106:32"/>Le Meriba tsiawo gbɔ,</para>
  <para style="q2" vid="PSA 106:32">wodo dɔmedzoe na Yehowa,</para>
  <para style="q2" vid="PSA 106:32">eye Mose kpɔ nya le woawo ta.<verse eid="PSA 106:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 106:33"/>Elabena wodze aglã ɖe Mawu ƒe Gbɔgbɔ ŋuti,</para>
  <para style="q2" vid="PSA 106:33">eye nya vlowo ge le Mose nu.<verse eid="PSA 106:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 106:34"/>Wometsrɔ̃ ameawo abe ale si Yehowa de se na wo ene o,<verse eid="PSA 106:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 106:35"/>ke boŋ wotsaka kple dukɔwo,</para>
  <para style="q2" vid="PSA 106:35">eye wosrɔ̃ woƒe kɔnyinyiwo.<verse eid="PSA 106:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 106:36"/>Wosubɔ woƒe legbawo,</para>
  <para style="q2" vid="PSA 106:36">esi zu mɔ me woge ɖo.<verse eid="PSA 106:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 106:37"/>Wotsɔ woƒe ŋutsuviwo</para>
  <para style="q2" vid="PSA 106:37">kple woƒe nyɔnuviwo sa vɔe na gbɔgbɔ vɔ̃wo.<verse eid="PSA 106:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 106:38"/>Wokɔ ʋu maɖifɔ ɖi,</para>
  <para style="q2" vid="PSA 106:38">wo viŋutsuwo kple wo vinyɔnuwo ƒe ʋu,</para>
  <para style="q1" vid="PSA 106:38">ame siwo wotsɔ sa vɔe na Kanaan legbawo,</para>
  <para style="q2" vid="PSA 106:38">eye wotsɔ woƒe ʋu gblẽ kɔ ɖo na anyigba la.<verse eid="PSA 106:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 106:39"/>Woƒo ɖi wo ɖokuiwo to nu si wowɔ la me,</para>
  <para style="q2" vid="PSA 106:39">eye to woƒe nuwɔnawo me,</para>
  <para style="q2" vid="PSA 106:39">wotsɔ wo ɖokuiwo wɔ gbolowoe,<verse eid="PSA 106:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 106:40"/>eya ta Yehowa do dɔmedzoe ɖe eƒe dukɔ ŋuti,</para>
  <para style="q2" vid="PSA 106:40">eye wònyɔ ŋu eƒe domenyinu.<verse eid="PSA 106:40"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 106:41"/>Etsɔ wo de asi na dukɔwo,</para>
  <para style="q2" vid="PSA 106:41">eye woƒe futɔwo ɖu fia ɖe wo dzi.<verse eid="PSA 106:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 106:42"/>Woƒe futɔwo te wo ɖe to,</para>
  <para style="q2" vid="PSA 106:42">eye wotsɔ wo de woƒe ŋusẽ te.<verse eid="PSA 106:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 106:43"/>Eɖe wo zi geɖe,</para>
  <para style="q2" vid="PSA 106:43">gake woɖoe kplikpaa be yewoadze aglã,</para>
  <para style="q1" vid="PSA 106:43">eye wovɔ le eme keŋkeŋ</para>
  <para style="q2" vid="PSA 106:43">le woƒe nu vɔ̃ me.<verse eid="PSA 106:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 106:44"/>Ke ekpɔ woƒe hiã la ɖa,</para>
  <para style="q2" vid="PSA 106:44">esi wòse woƒe ɣlidodo;<verse eid="PSA 106:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 106:45"/>le wo ta, eɖo ŋku eƒe nubabla la dzi,</para>
  <para style="q2" vid="PSA 106:45">eye wòɖe asi le eƒe tameɖoɖo ŋu le eƒe lɔlɔ̃ gã la ta.<verse eid="PSA 106:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 106:46"/>Ena ame siwo katã ɖe aboyo wo</para>
  <para style="q2" vid="PSA 106:46">la kpɔ nublanui na wo.<verse eid="PSA 106:46"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 106:47"/>O! Yehowa, míaƒe Mawu,</para>
  <para style="q2" vid="PSA 106:47">ɖe mí, eye nàƒo mía nu ƒu tso dukɔwo dome,</para>
  <para style="q1" vid="PSA 106:47">be míada akpe na wò ŋkɔ kɔkɔe la,</para>
  <para style="q2" vid="PSA 106:47">eye míaƒo adegbe le wò kafukafu ŋu.<verse eid="PSA 106:47"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 106:48"/>Woakafu Yehowa, Israel ƒe Mawu la,</para>
  <para style="q2" vid="PSA 106:48">tso mavɔ me yi mavɔ me.</para>
  <para style="b" vid="PSA 106:48"/>
  <para style="q1" vid="PSA 106:48">Dukɔ blibo la nàgblɔ be, “Amen!”</para>
  <para style="b" vid="PSA 106:48"/>
  <para style="q1" vid="PSA 106:48">Mikafu Yehowa.<verse eid="PSA 106:48"/></para>
  <chapter eid="PSA 106"/>
  <chapter number="107" style="c" sid="PSA 107"/>
  <para style="ms">Agbalẽ atɔ̃lia</para>
  <para style="mr">
    <ref loc="PSA 107-150">Psalmowo 107–150</ref></para>
  <para style="cl">Psalmo 107</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 107:1"/>Mida akpe na Yehowa,</para>
  <para style="q2" vid="PSA 107:1">elabena enyo, eye eƒe lɔlɔ̃ li ɖaa.<verse eid="PSA 107:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 107:2"/>Ame siwo Yehowa ɖe la negblɔ esia;</para>
  <para style="q2" vid="PSA 107:2">ame siwo wòɖe tso futɔ la ƒe asi me,<verse eid="PSA 107:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 107:3"/>ame siwo nu wòƒo ƒui tso anyigbawo dzi,</para>
  <para style="q2" vid="PSA 107:3">tso ɣedzeƒe kple ɣetoɖoƒe, anyiehe kple dziehe.<verse eid="PSA 107:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 107:4"/>Ame aɖewo tsa tsaglãla le gbedzi kple gbedadaƒo,</para>
  <para style="q2" vid="PSA 107:4">eye womekpɔ mɔ si woato ayi du aɖe si me woanɔ la o.<verse eid="PSA 107:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 107:5"/>Dɔ kple tsikɔ wu wo,</para>
  <para style="q2" vid="PSA 107:5">eye nu te woƒe luʋɔ ŋu le wo me.<verse eid="PSA 107:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 107:6"/>Tete wodo ɣli yɔ Yehowa le woƒe xaxa la me,</para>
  <para style="q2" vid="PSA 107:6">eye wòɖe wo le woƒe hiã la me.<verse eid="PSA 107:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 107:7"/>Ekplɔ wo tẽe yi</para>
  <para style="q2" vid="PSA 107:7">ɖe du aɖe si me woanɔ.<verse eid="PSA 107:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 107:8"/>Woneda akpe na Yehowa le eƒe lɔlɔ̃ si meʋãna o</para>
  <para style="q2" vid="PSA 107:8">la ta kple eƒe nukudɔ siwo wòwɔna na amewo la ta.<verse eid="PSA 107:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 107:9"/>Elabena etsɔa nu nyuiwo ɖia ƒoe na</para>
  <para style="q2" vid="PSA 107:9">ame siwo dɔ kple tsikɔ le wuwum.<verse eid="PSA 107:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 107:10"/>Ame aɖewo nɔ viviti kple blukɔ tsiɖitsiɖi me,</para>
  <para style="q2" vid="PSA 107:10">gamenɔla siwo le fu kpem le gakɔsɔkɔsɔwo me,<verse eid="PSA 107:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 107:11"/>elabena wodze aglã ɖe Mawu ƒe nyawo ŋuti,</para>
  <para style="q2" vid="PSA 107:11">eye wodo vlo Dziƒoʋĩtɔ la ƒe aɖaŋudede.<verse eid="PSA 107:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 107:12"/>Eya ta wòtsɔ wo de asi na dɔ sesẽ wɔwɔ,</para>
  <para style="q2" vid="PSA 107:12">womu sɔgɔsɔgɔsɔgɔ, eye ame aɖeke meli akpe ɖe wo ŋu o.<verse eid="PSA 107:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 107:13"/>Tete wodo ɣli na Yehowa le woƒe xaxa la me,</para>
  <para style="q2" vid="PSA 107:13">eye wòɖe wo le woƒe hiã la me.<verse eid="PSA 107:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 107:14"/>Eɖe wo le viviti kple blukɔ tsiɖitsiɖitsiɖi la me,</para>
  <para style="q2" vid="PSA 107:14">eye wòtso woƒe gakɔsɔkɔsɔwo.<verse eid="PSA 107:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 107:15"/>Woneda akpe na Yehowa le eƒe lɔlɔ̃ si meʋãna o</para>
  <para style="q2" vid="PSA 107:15">la ta kple eƒe nukudɔ siwo wòwɔna na amewo la ta,<verse eid="PSA 107:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 107:16"/>elabena eŋe akɔbligbowo,</para>
  <para style="q2" vid="PSA 107:16">eye wòlã gayibɔ ƒe gametiwo me.<verse eid="PSA 107:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 107:17"/>Wo dometɔ aɖewo zu bometsilawo to</para>
  <para style="q2" vid="PSA 107:17">woƒe aglãdzenuwo wɔwɔ me,</para>
  <para style="q2" vid="PSA 107:17">eye wokpe fu le woƒe dzidadawo ta.<verse eid="PSA 107:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 107:18"/>Wonyɔ ŋu nuɖuɖu ɖe sia ɖe,</para>
  <para style="q2" vid="PSA 107:18">eye woɖo ku ƒe agbowo nu.<verse eid="PSA 107:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 107:19"/>Wodo ɣli na Yehowa le woƒe xaxa la me,</para>
  <para style="q2" vid="PSA 107:19">eye wòɖe wo le woƒe hiã la me.<verse eid="PSA 107:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 107:20"/>Edɔ eƒe nya ɖa, eye wòyɔ dɔ wo,</para>
  <para style="q2" vid="PSA 107:20">heɖe wo tso tsiẽƒe.<verse eid="PSA 107:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 107:21"/>Woneda akpe na Yehowa le eƒe lɔlɔ̃ si meʋãna o</para>
  <para style="q2" vid="PSA 107:21">la ta kple eƒe nukudɔ siwo wòwɔna na amewo la ta.<verse eid="PSA 107:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 107:22"/>Wonesa akpedavɔ nɛ,</para>
  <para style="q2" vid="PSA 107:22">eye woaɖe eƒe dɔwɔwɔwo afia to aseyetsohawo me.<verse eid="PSA 107:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 107:23"/>Ame aɖewo le meli me zɔ atsiaƒu dzi,</para>
  <para style="q2" vid="PSA 107:23">wonye asitsalawo le tɔ gãwo dzi.<verse eid="PSA 107:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 107:24"/>Wokpɔ Yehowa ƒe dɔwɔwɔwo,</para>
  <para style="q2" vid="PSA 107:24">wokpɔ eƒe nukudɔwo le atsiaƒu gɔme,<verse eid="PSA 107:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 107:25"/>elabena eƒo nu, elɔ ahom kɔ ɖe ƒu la dzi,</para>
  <para style="q2" vid="PSA 107:25">eye eƒe tsotsoewo dze agbo.<verse eid="PSA 107:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 107:26"/>Woyi dziƒo boo, eye wogadze eme</para>
  <para style="q2" vid="PSA 107:26">le gogloƒe ke, ale le woƒe agbe ƒe xaxa me,</para>
  <para style="q2" vid="PSA 107:26">woƒe dzideƒo lolo gbana.<verse eid="PSA 107:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 107:27"/>Wole mumum sɔgɔsɔgɔsɔgɔ,</para>
  <para style="q2" vid="PSA 107:27">le nu klim abe ame siwo mu aha ene,</para>
  <para style="q2" vid="PSA 107:27">eye womegale naneke gɔme sem o.<verse eid="PSA 107:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 107:28"/>Tete wodo ɣli na Yehowa le woƒe xaxa la me,</para>
  <para style="q2" vid="PSA 107:28">eye wòɖe wo le woƒe hiã la me.<verse eid="PSA 107:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 107:29"/>Etsi ahom la nu wòzi ɖoɖoe abe dalĩ dom wole ene,</para>
  <para style="q2" vid="PSA 107:29">eye ƒutsotsoeawo hã ɖo to kpoo.<verse eid="PSA 107:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 107:30"/>Wokpɔ dzidzɔ esi wòdze kɔ anyi,</para>
  <para style="q2" vid="PSA 107:30">eye wòkplɔ wo va se ɖe</para>
  <para style="q2" vid="PSA 107:30">esime wova ɖo afi si wodi be yewoanɔ.<verse eid="PSA 107:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 107:31"/>Woneda akpe na Yehowa le eƒe lɔlɔ̃ si meʋãna o la ta</para>
  <para style="q2" vid="PSA 107:31">kple eƒe nukudɔ siwo wòwɔna na amewo la ta.<verse eid="PSA 107:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 107:32"/>Wonedoe ɖe dzi le dukɔ la ƒe ƒuƒoƒo me,</para>
  <para style="q2" vid="PSA 107:32">eye woakafui le dumegãwo ƒe takpekpe me.<verse eid="PSA 107:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 107:33"/>Etrɔ tɔsisiwo wozu gbegbe</para>
  <para style="q2" vid="PSA 107:33">kple tsidzɔƒewo wozu kuɖiɖinyigba,<verse eid="PSA 107:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 107:34"/>eye agbledeƒe zu dzeƒi le ame siwo</para>
  <para style="q2" vid="PSA 107:34">le teƒe ma ƒe nu vɔ̃ɖi wɔwɔ ta.<verse eid="PSA 107:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 107:35"/>Etrɔ gbegbe wòzu tɔʋu,</para>
  <para style="q2" vid="PSA 107:35">eye kuɖiɖinyigba zu tsidzɔƒe;<verse eid="PSA 107:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 107:36"/>afi mae wòkplɔ dɔwuitɔwo be woava nɔ,</para>
  <para style="q2" vid="PSA 107:36">eye wotso du si me woanɔ.<verse eid="PSA 107:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 107:37"/>Woƒã nukuwo ɖe agble me,</para>
  <para style="q2" vid="PSA 107:37">wode waingblewo, eye wotse ku geɖe hena xaxa.<verse eid="PSA 107:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 107:38"/>Eyra wo, eye woƒe xexlẽme dzi ɖe edzi ŋutɔ.</para>
  <para style="q2" vid="PSA 107:38">Nenema ke mena woƒe lãhawo dzi ɖe kpɔtɔ o.<verse eid="PSA 107:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 107:39"/>Tete wozu ʋɛ, wobɔbɔ wo ɖe anyi le teteɖeanyi,</para>
  <para style="q2" vid="PSA 107:39">dzɔgbevɔ̃e kple nuxaxa me;<verse eid="PSA 107:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 107:40"/>eye eya ame si trɔa vlododo kɔna ɖe ame ŋkutawo dzi la,</para>
  <para style="q2" vid="PSA 107:40">wɔe be wole tsaglãla tsam le gbegbe afi si mɔtoƒe aɖeke mele o.<verse eid="PSA 107:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 107:41"/>Ke ekɔ hiãtɔwo ɖe dzi tso woƒe hiã me,</para>
  <para style="q2" vid="PSA 107:41">eye wòna woƒe ƒome dzi ɖe edzi abe lãhawo ene.<verse eid="PSA 107:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 107:42"/>Ame dzɔdzɔe kpɔe,</para>
  <para style="q2" vid="PSA 107:42">eye wòkpɔ dzidzɔ, gake ame vɔ̃ɖiwo katã mia woƒe nu.<verse eid="PSA 107:42"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 107:43"/>Ame si nye nunyala la,</para>
  <para style="q2" vid="PSA 107:43">neɖo to nu siawo, eye wòabu Yehowa ƒe lɔlɔ̃ deto la ŋuti.<verse eid="PSA 107:43"/></para>
  <chapter eid="PSA 107"/>
  <chapter number="108" style="c" sid="PSA 108"/>
  <para style="cl">Psalmo 108</para>
  <para style="d">Hadzidzi. David ƒe ha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 108:1"/>O! Mawu, nye dzi le te goŋgoŋgoŋ.</para>
  <para style="q2" vid="PSA 108:1">Madzi ha, aƒo saŋku kple nye luʋɔ blibo.<verse eid="PSA 108:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 108:2"/>Saŋku kple kasaŋku,</para>
  <para style="q2" vid="PSA 108:2">minyɔ! Manyɔ fɔŋli.<verse eid="PSA 108:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 108:3"/>O! Yehowa, makafu wò le dukɔwo dome,</para>
  <para style="q2" vid="PSA 108:3">eye madzi ha le ŋuwò le anyigbadzitɔwo dome,<verse eid="PSA 108:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 108:4"/>elabena wò lɔlɔ̃ de blibo,</para>
  <para style="q2" vid="PSA 108:4">hekɔ wu dziƒowo, eye wò nuteƒewɔwɔ yi ɖatɔ lilikpowo.<verse eid="PSA 108:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 108:5"/>O! Mawu, woado wò ɖe dzi agbɔ dziƒowo ŋu,</para>
  <para style="q2" vid="PSA 108:5">eye na wò ŋutikɔkɔe naxɔ anyigba blibo la dzi.<verse eid="PSA 108:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 108:6"/>Ɖe mí, eye nàkpe ɖe mía ŋu kple wò nuɖusibɔ,</para>
  <para style="q2" vid="PSA 108:6">be ame siwo nèlɔ̃ vevie la nakpɔ ɖeɖe.<verse eid="PSA 108:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 108:7"/>Mawu ƒo nu tso eƒe kɔkɔeƒe la be,</para>
  <para style="q2" vid="PSA 108:7">“Mama Sekem le dziɖuɖu me,</para>
  <para style="q2" vid="PSA 108:7">eye madzidze Sukɔt Balime.<verse eid="PSA 108:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 108:8"/>Gilead nye tɔnye, Manase hã tɔnyee;</para>
  <para style="q2" vid="PSA 108:8">nye gakukue nye Efraim,</para>
  <para style="q2" vid="PSA 108:8">eye Yuda nye nye fiatikplɔ.<verse eid="PSA 108:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 108:9"/>Moab nye nye tsiletɔkpo,</para>
  <para style="q2" vid="PSA 108:9">matsɔ nye atokota aƒu gbe ɖe Edom dzi,</para>
  <para style="q2" vid="PSA 108:9">eye mado dziɖuɖuɣli ɖe Filistia ŋu.”<verse eid="PSA 108:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 108:10"/>Ame ka akplɔm ayi du sesẽ la mee?</para>
  <para style="q2" vid="PSA 108:10">Ame ka akplɔm ayi Edom?<verse eid="PSA 108:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 108:11"/>O! Mawu, ɖe menye wòe oa?</para>
  <para style="q2" vid="PSA 108:11">Nu ka wɔ nègbe mí,</para>
  <para style="q2" vid="PSA 108:11">eye mègadona kple míaƒe aʋakɔwo o?<verse eid="PSA 108:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 108:12"/>Kpe ɖe mía ŋu ɖe míaƒe futɔwo ŋuti,</para>
  <para style="q2" vid="PSA 108:12">elabena èna amegbetɔ ƒe kpekpeɖeŋu mele nemi hã me o.<verse eid="PSA 108:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 108:13"/>Ne Mawu le mía dzi la, míaɖu dzi,</para>
  <para style="q2" vid="PSA 108:13">eye wòafanya míaƒe futɔwo ɖe eƒe afɔ te.<verse eid="PSA 108:13"/></para>
  <chapter eid="PSA 108"/>
  <chapter number="109" style="c" sid="PSA 109"/>
  <para style="cl">Psalmo 109</para>
  <para style="d">David ƒe ha na hɛnɔ la.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 109:1"/>O! Mawu, wò ame si mekafu,</para>
  <para style="q2" vid="PSA 109:1">mègazi ɖoɖoe o,<verse eid="PSA 109:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 109:2"/>elabena ame vɔ̃ɖiwo kple alakpatɔwo,</para>
  <para style="q2" vid="PSA 109:2">ke woƒe nuwo ɖe ŋutinye,</para>
  <para style="q2" vid="PSA 109:2">eye wogblɔ nya ɖe ŋunye kple alakpaɖewo.<verse eid="PSA 109:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 109:3"/>Wotsɔ fulényawo ƒo xlãm;</para>
  <para style="q2" vid="PSA 109:3">wotso ɖe ŋunye nanekemawɔmawɔe.<verse eid="PSA 109:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 109:4"/>Wotsɔ fɔbubu nam ɖe nye lɔlɔ̃ teƒe,</para>
  <para style="q2" vid="PSA 109:4">ke nye la, ame si doa gbe ɖa vevie lae menye.<verse eid="PSA 109:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 109:5"/>Wotsɔ vɔ̃ ɖo nyui teƒe nam,</para>
  <para style="q2" vid="PSA 109:5">eye wotsɔ fuléle ɖo nye lɔlɔ̃ teƒe.<verse eid="PSA 109:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 109:6"/>Tia ame vɔ̃ɖi aɖe wòatso ɖe eŋu;</para>
  <para style="q2" vid="PSA 109:6">eye na amenutsola natsi tsitre ɖe eƒe nuɖusime.<verse eid="PSA 109:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 109:7"/>Ne wodrɔ̃ ʋɔnui la,</para>
  <para style="q2" vid="PSA 109:7">woneɖe agɔdzedze nɛ,</para>
  <para style="q2" vid="PSA 109:7">eye eƒe gbedodoɖawo nebu fɔe.<verse eid="PSA 109:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 109:8"/>Eƒe ŋkekewo nenɔ ʋɛ</para>
  <para style="q2" vid="PSA 109:8">eye ame bubu naxɔ eƒe amekplɔdɔ awɔ.<verse eid="PSA 109:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 109:9"/>Viawo nezu tsyɔ̃eviwo,</para>
  <para style="q2" vid="PSA 109:9">eye srɔ̃a nezu ahosi.<verse eid="PSA 109:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 109:10"/>Viawo nenɔ tsaglãla tsam, anɔ nu biam;</para>
  <para style="q2" vid="PSA 109:10">wonenya wo do goe le woƒe aƒe gbagbãwo me.<verse eid="PSA 109:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 109:11"/>Fetɔ aɖe nexɔ eƒe nunɔmesiwo katã,</para>
  <para style="q2" vid="PSA 109:11">eye amedzrowo neha nu siwo wòwɔ dɔ kpɔ.<verse eid="PSA 109:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 109:12"/>Ame aɖeke megave enu loo,</para>
  <para style="q2" vid="PSA 109:12">alo akpɔ nublanui na eƒe tsyɔ̃eviwo o.<verse eid="PSA 109:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 109:13"/>Eƒe dzidzimeviwo netsrɔ̃,</para>
  <para style="q2" vid="PSA 109:13">eye woaɖe woƒe ŋkɔwo ɖa le dzidzime si gbɔna la me.<verse eid="PSA 109:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 109:14"/>Woneɖo ŋku fofoawo ƒe vodadawo dzi</para>
  <para style="q2" vid="PSA 109:14">le Yehowa ŋkume, eye womegatutu dadaa</para>
  <para style="q2" vid="PSA 109:14">ƒe nu vɔ̃ ɖa akpɔ gbeɖe o.<verse eid="PSA 109:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 109:15"/>Woƒe nu vɔ̃wo nenɔ Yehowa ŋkume ɖaa,</para>
  <para style="q2" vid="PSA 109:15">ale be wòaɖe woƒe ŋkɔ ɖa le anyigba dzi,<verse eid="PSA 109:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 109:16"/>elabena mebu dɔmenyowɔwɔ ŋuti kpɔ o,</para>
  <para style="q2" vid="PSA 109:16">ke boŋ eƒo hiãtɔ,</para>
  <para style="q2" vid="PSA 109:16">ame dahe kple ame si ƒe dzi gbã la ƒu anyi woku.<verse eid="PSA 109:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 109:17"/>Elɔ̃a ɖiŋudodo, eya ta ɖiŋudodo neva eya ŋutɔ ƒe ta dzi;</para>
  <para style="q2" vid="PSA 109:17">amewo yayra medoa dzidzɔ nɛ o,</para>
  <para style="q2" vid="PSA 109:17">eya ta yayra nete ɖa xaa tso eya ŋutɔ gbɔ.<verse eid="PSA 109:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 109:18"/>Etsɔ ɖiŋudodo do abe awu ene,</para>
  <para style="q2" vid="PSA 109:18">wòge ɖe eƒe lãme abe tsi ene,</para>
  <para style="q2" vid="PSA 109:18">eye wòɖo eƒe ƒuwo me abe ami ene,<verse eid="PSA 109:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 109:19"/>eya ta netae abe avɔ ene,</para>
  <para style="q2" vid="PSA 109:19">eye nebla ali dzi nɛ abe alidziblaka ene tegbetegbe.<verse eid="PSA 109:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 109:20"/>Esia nenye fe si Yehowa axe na nunyetsolawo</para>
  <para style="q2" vid="PSA 109:20">kple ame siwo gblɔa nya vɔ̃ ɖe ŋutinye.<verse eid="PSA 109:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 109:21"/>Ke wò la, o Aƒetɔ Yehowa,</para>
  <para style="q2" vid="PSA 109:21">wɔ nyui nam le wò ŋkɔ la ta,</para>
  <para style="q2" vid="PSA 109:21">ɖem le wò lɔlɔ̃ si wɔa nyui la ta,<verse eid="PSA 109:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 109:22"/>elabena hiãtɔ kple ame dahe menye,</para>
  <para style="q2" vid="PSA 109:22">eye nye dzi xɔ abi le menye.<verse eid="PSA 109:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 109:23"/>Nunye yi abe vɔvɔli le fiẽ me ene</para>
  <para style="q2" vid="PSA 109:23">eye woʋuʋum abe ʋetsuvi ene.<verse eid="PSA 109:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 109:24"/>Le nutsitsidɔ ta la,</para>
  <para style="q2" vid="PSA 109:24">nye klowo zu belie,</para>
  <para style="q2" vid="PSA 109:24">eye meɖi ku glaglaglã.<verse eid="PSA 109:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 109:25"/>Mezu alɔmeɖenu na nunyetsolawo,</para>
  <para style="q2" vid="PSA 109:25">eye woʋuʋua ta ne wokpɔm.<verse eid="PSA 109:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 109:26"/>O! Yehowa, nye Mawu,</para>
  <para style="q2" vid="PSA 109:26">kpe ɖe ŋunye, ɖem le wò lɔlɔ̃ la ta.<verse eid="PSA 109:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 109:27"/>O! Yehowa, wonenya be to wò asi dzie nèwɔ esia.<verse eid="PSA 109:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 109:28"/>Woaƒo fi ade ame, ke wò la àyra ame,</para>
  <para style="q2" vid="PSA 109:28">ne wotso ɖe ŋunye la, ŋu akpe wo,</para>
  <para style="q2" vid="PSA 109:28">ke wò dɔla ya atso aseye.<verse eid="PSA 109:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 109:29"/>Nunyetsolawo ado vlododo abe awu ene,</para>
  <para style="q2" vid="PSA 109:29">eye wòata ŋukpe abe avɔ ene.<verse eid="PSA 109:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 109:30"/>Matsɔ nye nu ado Yehowa ɖe dzi,</para>
  <para style="q2" vid="PSA 109:30">eye le ameha gã la dome, makafui,<verse eid="PSA 109:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 109:31"/>elabena etsi tsitre ɖe hiãtɔ la ƒe nuɖusime,</para>
  <para style="q2" vid="PSA 109:31">be yeaɖe eƒe agbe tso ame siwo bu fɔ̃e la ƒe asi me.<verse eid="PSA 109:31"/></para>
  <chapter eid="PSA 109"/>
  <chapter number="110" style="c" sid="PSA 110"/>
  <para style="cl">Psalmo 110</para>
  <para style="d">David ƒe ha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 110:1"/>Yehowa gblɔ na nye Aƒetɔ la be,</para>
  <para style="b" vid="PSA 110:1"/>
  <para style="q1" vid="PSA 110:1">“Nɔ anyi ɖe nye nuɖusime,</para>
  <para style="q2" vid="PSA 110:1">va se ɖe esime matsɔ wò futɔwo</para>
  <para style="q2" vid="PSA 110:1">awɔ wò afɔɖodzinui.”<verse eid="PSA 110:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 110:2"/>Yehowa adidi wò ŋusẽ ƒe fiatikplɔ ɖe edzi tso Zion,</para>
  <para style="q2" vid="PSA 110:2">eye àɖu fia le wò futɔwo dome.<verse eid="PSA 110:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 110:3"/>Wò aʋakɔwo alɔ̃ faa ade megbe na wò le wò aʋakpegbe.</para>
  <para style="q2" vid="PSA 110:3">Ànɔ atsyɔ̃ɖoɖo kɔkɔe,</para>
  <para style="q1" vid="PSA 110:3">si do go tso fɔŋli ƒe dɔ me ke la me,</para>
  <para style="q2" vid="PSA 110:3">axɔ wò ɖekakpuimezãmu.<verse eid="PSA 110:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 110:4"/>Yehowa ka atam,</para>
  <para style="q2" vid="PSA 110:4">eye matrɔ eƒe susu akpɔ o, be</para>
  <para style="q1" vid="PSA 110:4">“Wòe nye nunɔla tegbee,</para>
  <para style="q2" vid="PSA 110:4">le Melkizedek ƒe ɖoɖo la nu.”<verse eid="PSA 110:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 110:5"/>Aƒetɔ la le wò nuɖusime,</para>
  <para style="q2" vid="PSA 110:5">agbã fiawo nyanyanya le eƒe dɔmedzoeŋkeke la dzi.<verse eid="PSA 110:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 110:6"/>Adrɔ̃ ʋɔnu dukɔwo, eye wòali kɔ woƒe kukuawo,</para>
  <para style="q2" vid="PSA 110:6">nenema ke wòagbã dziɖulawo le anyigba blibo la dzi.<verse eid="PSA 110:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 110:7"/>Ano tsi le tɔʋu si le mɔto la me,</para>
  <para style="q2" vid="PSA 110:7">eya ta afɔ eƒe ta dzi.<verse eid="PSA 110:7"/></para>
  <chapter eid="PSA 110"/>
  <chapter number="111" style="c" sid="PSA 111"/>
  <para style="cl">Psalmo 111</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 111:1"/>Mikafu Yehowa.</para>
  <para style="b" vid="PSA 111:1"/>
  <para style="q1" vid="PSA 111:1">Mado Yehowa ɖe dzi kple nye dzi blibo</para>
  <para style="q2" vid="PSA 111:1">le ame dzɔdzɔewo ƒe adaŋudeha me kple amehawo dome.<verse eid="PSA 111:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 111:2"/>Yehowa ƒe dɔwɔwɔwo lolo kpem;</para>
  <para style="q2" vid="PSA 111:2">ame siwo wodoa dzidzɔ na la bua wo ŋuti.<verse eid="PSA 111:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 111:3"/>Ŋutikɔkɔe kple atsyɔ̃ nye eƒe nuwɔwɔwo,</para>
  <para style="q2" vid="PSA 111:3">eye eƒe dzɔdzɔenye li tegbee.<verse eid="PSA 111:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 111:4"/>Ena woɖo ŋku eƒe nukudɔwo dzi;</para>
  <para style="q2" vid="PSA 111:4">Yehowa nye amenuvela kple nublanuikpɔla.<verse eid="PSA 111:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 111:5"/>Enaa nuɖuɖu ame siwo vɔ̃nɛ,</para>
  <para style="q2" vid="PSA 111:5">eye wòɖoa ŋku eƒe nubabla dzi tegbetegbe.<verse eid="PSA 111:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 111:6"/>Eɖe eƒe dɔwɔwɔwo ƒe ŋusẽ fia eƒe dukɔ la</para>
  <para style="q2" vid="PSA 111:6">eye wòtsɔ dukɔ bubuwo ƒe anyigba na wo.<verse eid="PSA 111:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 111:7"/>Eƒe asinudɔwɔwɔwo le eteƒe, eye wodzɔ;</para>
  <para style="q2" vid="PSA 111:7">nenema ke woate ŋu aka ɖe eƒe sewo hã dzii,<verse eid="PSA 111:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 111:8"/>elabena wole te tso mavɔ me yi ɖe mavɔ me,</para>
  <para style="q2" vid="PSA 111:8">eye wòde sewo le nuteƒewɔwɔ kple dzɔdzɔenyenye me.<verse eid="PSA 111:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 111:9"/>Eɖo ɖeɖe ɖi na eƒe dukɔ,</para>
  <para style="q2" vid="PSA 111:9">eɖo eƒe nubabla anyi tegbee,</para>
  <para style="q2" vid="PSA 111:9">eye eƒe ŋkɔ le kɔkɔe; ŋɔdzi hã le eŋu.<verse eid="PSA 111:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 111:10"/>Yehowa vɔvɔ̃e nye nunya ƒe gɔmedzedze,</para>
  <para style="q2" vid="PSA 111:10">eye ame siwo katã léa eƒe sewo me ɖe asi</para>
  <para style="q2" vid="PSA 111:10">la, gɔmesese nyui sua wo si.</para>
  <para style="q2" vid="PSA 111:10">Eya tɔe nye kafukafu tegbee.<verse eid="PSA 111:10"/></para>
  <chapter eid="PSA 111"/>
  <chapter number="112" style="c" sid="PSA 112"/>
  <para style="cl">Psalmo 112</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 112:1"/>Mikafu Yehowa.</para>
  <para style="b" vid="PSA 112:1"/>
  <para style="q1" vid="PSA 112:1">Woayra ŋutsu si vɔ̃a Yehowa,</para>
  <para style="q2" vid="PSA 112:1">eye wòkpɔa dzidzɔ vevie le eƒe sewo ŋu.<verse eid="PSA 112:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 112:2"/>Viawo anye ŋusẽtɔwo le anyigba la dzi,</para>
  <para style="q2" vid="PSA 112:2">eye woayra dzi dzɔdzɔetɔwo ƒe dzidzime.<verse eid="PSA 112:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 112:3"/>Kesinɔnu kple nu nyuiwo le eƒe aƒe me,</para>
  <para style="q2" vid="PSA 112:3">eye eƒe dzɔdzɔenyenye nɔa anyi ɖikaa.<verse eid="PSA 112:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 112:4"/>Le viviti me gɔ̃ hã la,</para>
  <para style="q2" vid="PSA 112:4">kekeli klẽna na ame dzɔdzɔewo,</para>
  <para style="q1" vid="PSA 112:4">nenema ke wònɔna na ame si vea ame nu,</para>
  <para style="q2" vid="PSA 112:4">kpɔa nublanui, eye wòwɔa nu dzɔdzɔe.<verse eid="PSA 112:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 112:5"/>Nyui ava na ame si nyoa dɔ me, doa nugbana faa,</para>
  <para style="q2" vid="PSA 112:5">eye wòwɔa eƒe nuwo to mɔ dzɔdzɔe dzi.<verse eid="PSA 112:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 112:6"/>Vavã, maʋã akpɔ o;</para>
  <para style="q2" vid="PSA 112:6">woaɖo ŋku ame dzɔdzɔe dzi tegbee.<verse eid="PSA 112:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 112:7"/>Mavɔ̃ na nya vɔ̃ sese o,</para>
  <para style="q2" vid="PSA 112:7">eƒe dzi li ke, eye wòkana ɖe Yehowa dzi.<verse eid="PSA 112:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 112:8"/>Mavɔ̃ naneke o, elabena dzi le eƒo;</para>
  <para style="q2" vid="PSA 112:8">eye mlɔeba la, akpɔ eƒe futɔwo ta ɖa le dziɖuɖu me.<verse eid="PSA 112:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 112:9"/>Ema eƒe kesinɔnuwo na ame dahewo fũu,</para>
  <para style="q2" vid="PSA 112:9">eƒe dzɔdzɔenyenye li tegbee,</para>
  <para style="q2" vid="PSA 112:9">eye woakɔ eƒe dzo ɖe dzi bobobo le bubu me.<verse eid="PSA 112:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 112:10"/>Ame vɔ̃ɖi akpɔe, eye dzi akui,</para>
  <para style="q2" vid="PSA 112:10">aɖu aɖukli, avɔ le eme keŋkeŋkeŋ.</para>
  <para style="q2" vid="PSA 112:10">Ame vɔ̃ɖiwo ƒe dzimedidiwo azu tofloko.<verse eid="PSA 112:10"/></para>
  <chapter eid="PSA 112"/>
  <chapter number="113" style="c" sid="PSA 113"/>
  <para style="cl">Psalmo 113</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 113:1"/>Mikafu Yehowa.</para>
  <para style="b" vid="PSA 113:1"/>
  <para style="q1" vid="PSA 113:1">O! Mi Yehowa ƒe dɔlawo,</para>
  <para style="q2" vid="PSA 113:1">mikafui, mikafu Yehowa ƒe ŋkɔ.<verse eid="PSA 113:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 113:2"/>Woakafu Yehowa ƒe ŋkɔ</para>
  <para style="q2" vid="PSA 113:2">tso fifia yi ɖe mavɔ me ke.<verse eid="PSA 113:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 113:3"/>Woakafu Yehowa ƒe ŋkɔ</para>
  <para style="q2" vid="PSA 113:3">tso ɣeyiɣi si ɣe adze va se ɖe esi wòaɖo to ɖe afi si wòɖoa to ɖo.<verse eid="PSA 113:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 113:4"/>Yehowa nye gã ɖe dukɔwo katã dzi,</para>
  <para style="q2" vid="PSA 113:4">eye eƒe ŋutikɔkɔe gbɔ dziƒowo ta.<verse eid="PSA 113:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 113:5"/>Ame kae le abe Yehowa,</para>
  <para style="q2" vid="PSA 113:5">míaƒe Mawu la ene, ame si nɔ anyi ɖe fiazikpui dzi le dziƒo,<verse eid="PSA 113:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="PSA 113:6"/>eye wòbɔbɔ be yeakpɔ dziƒowo kple anyigba ɖa?<verse eid="PSA 113:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 113:7"/>Efɔ ame dahe ɖe tsitre tso ke me,</para>
  <para style="q2" vid="PSA 113:7">eye wòfɔ hiãtɔ ɖe dzi tso dzowɔ me;<verse eid="PSA 113:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 113:8"/>hetsɔ wo ɖo dumegãwo xa,</para>
  <para style="q2" vid="PSA 113:8">ɛ̃, woƒe dumegãwo xa.<verse eid="PSA 113:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 113:9"/>Ame si na konɔ nɔa eƒe aƒe me,</para>
  <para style="q2" vid="PSA 113:9">hekpɔa dzidzɔ abe viwo dada ene.</para>
  <para style="b" vid="PSA 113:9"/>
  <para style="q1" vid="PSA 113:9">Mikafu Yehowa.<verse eid="PSA 113:9"/></para>
  <chapter eid="PSA 113"/>
  <chapter number="114" style="c" sid="PSA 114"/>
  <para style="cl">Psalmo 114</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 114:1"/>Esi Israel do go tso Egipte,</para>
  <para style="q2" vid="PSA 114:1">esi Yakob ƒe aƒe la do go</para>
  <para style="q2" vid="PSA 114:1">tso gbe bubu gblɔlawo dome la,<verse eid="PSA 114:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 114:2"/>Yuda zu Mawu ƒe kɔkɔeƒe,</para>
  <para style="q2" vid="PSA 114:2">eye Israel zu eƒe fiaɖuƒe.<verse eid="PSA 114:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 114:3"/>Atsiaƒu kpɔe, eye wòsi dzo,</para>
  <para style="q2" vid="PSA 114:3">Yɔdan tɔsisi hã te yi megbe.<verse eid="PSA 114:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 114:4"/>Towo ti kpo abe agbowo ene,</para>
  <para style="q2" vid="PSA 114:4">eye togbɛwo abe alẽviwo ene.<verse eid="PSA 114:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 114:5"/>O! Atsiaƒu, nu ka ta nèsi ɖo,</para>
  <para style="q2" vid="PSA 114:5">O! Yɔdan tɔsisi, nu ka ta nète yi megbe ɖo?<verse eid="PSA 114:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 114:6"/>Mi towo, nu ka ta mieti kpo abe agbowo ene,</para>
  <para style="q2" vid="PSA 114:6">eye mi togbɛwo abe alẽviwo ene ɖo?<verse eid="PSA 114:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 114:7"/>O! Anyigba, dzo nyanyanya le Aƒetɔ la ŋkume,</para>
  <para style="q2" vid="PSA 114:7">le Yakob ƒe Mawu la ŋkume,<verse eid="PSA 114:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 114:8"/>eya ame si trɔ agakpe wòzu tɔʋu</para>
  <para style="q2" vid="PSA 114:8">kple agakpe sesẽ wòzu tsidzɔƒe.<verse eid="PSA 114:8"/></para>
  <chapter eid="PSA 114"/>
  <chapter number="115" style="c" sid="PSA 115"/>
  <para style="cl">Psalmo 115</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 115:1"/>Menye míawoe o, o Yehowa, menye míawoe o,</para>
  <para style="q2" vid="PSA 115:1">ke boŋ ŋutikɔkɔe la nye wò ŋkɔ tɔ,</para>
  <para style="q2" vid="PSA 115:1">le wò lɔlɔ̃ kple nuteƒewɔwɔ ta.<verse eid="PSA 115:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 115:2"/>Nu ka ta dukɔwo le gbɔgblɔm be,</para>
  <para style="q2" vid="PSA 115:2">“Afi ka woƒe Mawu la le?”<verse eid="PSA 115:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 115:3"/>Míaƒe Mawu la le dziƒo,</para>
  <para style="q2" vid="PSA 115:3">eye nu sia nu si dze eŋu lae wòwɔna,<verse eid="PSA 115:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 115:4"/>gake woawo ya ƒe legbawo nye klosalo kple sika,</para>
  <para style="q2" vid="PSA 115:4">eye amegbetɔ ƒe asiwoe wɔ wo,<verse eid="PSA 115:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 115:5"/>eya ta nu li na wo,</para>
  <para style="q2" vid="PSA 115:5">gake womate ŋu aƒo nu o, ŋku li na wo,</para>
  <para style="q2" vid="PSA 115:5">gake womate ŋu akpɔ nu o;<verse eid="PSA 115:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 115:6"/>to li na wo,</para>
  <para style="q2" vid="PSA 115:6">gake womesea nu o, ŋɔti li na wo,</para>
  <para style="q2" vid="PSA 115:6">gake womeʋẽa nu sena o;<verse eid="PSA 115:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 115:7"/>asi li na wo,</para>
  <para style="q2" vid="PSA 115:7">gake wometea nu kpɔna o, afɔ li na wo,</para>
  <para style="q2" vid="PSA 115:7">gake womate ŋu azɔ loo, alo aƒo nu to ve me o.<verse eid="PSA 115:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 115:8"/>Ame siwo wɔ wo la, anɔ abe woawo ke ene,</para>
  <para style="q2" vid="PSA 115:8">eye nenema kee nye ame siwo tsɔ woƒe mɔkpɔkpɔ da ɖe wo dzi.<verse eid="PSA 115:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 115:9"/>O! Israel ƒe aƒe, ɖo dzi ɖe Yehowa ŋu,</para>
  <para style="q2" vid="PSA 115:9">eyae nye wò kpeɖeŋutɔ kple akpoxɔnu.<verse eid="PSA 115:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 115:10"/>O! Aron ƒe aƒe,</para>
  <para style="q2" vid="PSA 115:10">ɖo dzi ɖe Yehowa ŋu,</para>
  <para style="q2" vid="PSA 115:10">eyae nye wò kpeɖeŋutɔ kple akpoxɔnu.<verse eid="PSA 115:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 115:11"/>Mi ame siwo vɔ̃nɛ, miɖo dzi ɖe Yehowa ŋu,</para>
  <para style="q2" vid="PSA 115:11">eyae nye miaƒe kpeɖeŋutɔ kple akpoxɔnu.<verse eid="PSA 115:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 115:12"/>Yehowa ɖo ŋku mía dzi,</para>
  <para style="q2" vid="PSA 115:12">eya ta ayra mí.</para>
  <para style="q1" vid="PSA 115:12">Ayra Israel ƒe aƒe la,</para>
  <para style="q2" vid="PSA 115:12">ayra Aron ƒe aƒe la,<verse eid="PSA 115:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 115:13"/>ayra ame siwo vɔ̃a Yehowa,</para>
  <para style="q2" vid="PSA 115:13">suewo kple gãwo siaa.<verse eid="PSA 115:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 115:14"/>Yehowa nana miadzi ɖe edzi,</para>
  <para style="q2" vid="PSA 115:14">miawo ŋutɔwo kple mia viwo.<verse eid="PSA 115:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 115:15"/>Yehowa neyra mi,</para>
  <para style="q2" vid="PSA 115:15">eya dziƒo kple anyigba Wɔla.<verse eid="PSA 115:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 115:16"/>Dziƒo kɔkɔtɔ nye Yehowa,</para>
  <para style="q2" vid="PSA 115:16">Wɔla la tɔ, ke etsɔ anyigba na amegbetɔ.<verse eid="PSA 115:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 115:17"/>Menye ame kukuwoe kafua Yehowa o,</para>
  <para style="q2" vid="PSA 115:17">menye ame siwo zi ɖoɖoe le aʋlimee o;<verse eid="PSA 115:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 115:18"/>ke boŋ mí ame siwo doa Yehowa</para>
  <para style="q2" vid="PSA 115:18">ɖe dzi fifia kple ɖaasi lae.</para>
  <para style="b" vid="PSA 115:18"/>
  <para style="q1" vid="PSA 115:18">Mikafu Yehowa.<verse eid="PSA 115:18"/></para>
  <chapter eid="PSA 115"/>
  <chapter number="116" style="c" sid="PSA 116"/>
  <para style="cl">Psalmo 116</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 116:1"/>Melɔ̃ Yehowa, elabena ese nye gbe;</para>
  <para style="q2" vid="PSA 116:1">ese nye avifafa be wonekpɔ nublanui nam.<verse eid="PSA 116:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 116:2"/>Esi wòtrɔ to ɖe gbɔnye ta la,</para>
  <para style="q2" vid="PSA 116:2">mayɔe zi ale si mele agbe.<verse eid="PSA 116:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 116:3"/>Ku ƒe kawo blam, eye tsiẽƒe ƒe vevesese va dzinye.</para>
  <para style="q2" vid="PSA 116:3">Hiã tum, eye nuxaxa va dzinye.<verse eid="PSA 116:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 116:4"/>Tete meyɔ Yehowa ƒe ŋkɔ be,</para>
  <para style="q2" vid="PSA 116:4">“O! Yehowa, ɖem!”<verse eid="PSA 116:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 116:5"/>Yehowa nye amenuvetɔ kple dzɔdzɔetɔ;</para>
  <para style="q2" vid="PSA 116:5">míaƒe Mawu la yɔ fũu kple nublanuikpɔkpɔ.<verse eid="PSA 116:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 116:6"/>Yehowa kpɔa ame siwo fa tu le dzi me la ta;</para>
  <para style="q2" vid="PSA 116:6">esi menɔ hiahiã gã aɖe me la, eɖem le eme.<verse eid="PSA 116:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 116:7"/>O! Luʋɔnye, gagbɔ ɖe eme,</para>
  <para style="q2" vid="PSA 116:7">elabena Yehowa nyo dɔ me na wò.<verse eid="PSA 116:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 116:8"/>O! Yehowa, wòe ɖe nye luʋɔ tso ku me,</para>
  <para style="q2" vid="PSA 116:8">nye ŋkuwo tso aɖatsi si me,</para>
  <para style="q2" vid="PSA 116:8">nye afɔwo tso anyidzedze me;<verse eid="PSA 116:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 116:9"/>be mate ŋu azɔ le Yehowa ŋkume</para>
  <para style="q2" vid="PSA 116:9">le agbagbeawo ƒe anyigba dzi.<verse eid="PSA 116:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 116:10"/>Mexɔe se, eya ta megblɔ be,</para>
  <para style="q2" vid="PSA 116:10">“Wokaa hiãm ŋutɔ.”<verse eid="PSA 116:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 116:11"/>Eye le nye moya me, megblɔ be,</para>
  <para style="q2" vid="PSA 116:11">“Amegbetɔwo katã nye aʋatsokalawo.”<verse eid="PSA 116:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 116:12"/>Aleke mawɔ aɖo dɔmenyo</para>
  <para style="q2" vid="PSA 116:12">siwo katã Yehowa wɔ nam la teƒe nɛ?<verse eid="PSA 116:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 116:13"/>Makɔ xɔxɔ ƒe kplu la ɖe dzi,</para>
  <para style="q2" vid="PSA 116:13">eye mayɔ Yehowa ƒe ŋkɔ.<verse eid="PSA 116:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 116:14"/>Maxe nye adzɔgbeɖefe na Yehowa</para>
  <para style="q2" vid="PSA 116:14">le eƒe dukɔ blibo la ŋkume.<verse eid="PSA 116:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 116:15"/>Eƒe ame kɔkɔewo ƒe ku nye nu xɔasi</para>
  <para style="q2" vid="PSA 116:15">le Yehowa ŋkume.<verse eid="PSA 116:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 116:16"/>O! Yehowa, menye wò dɔla vavã,</para>
  <para style="q2" vid="PSA 116:16">wò dɔlae menye,</para>
  <para style="q1" vid="PSA 116:16">wò subɔla ƒe viŋutsue menye,</para>
  <para style="q2" vid="PSA 116:16">eye nèɖem tso nye gakɔsɔkɔsɔ siwo blam la me.<verse eid="PSA 116:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 116:17"/>Masa akpedavɔ na wò,</para>
  <para style="q2" vid="PSA 116:17">eye mayɔ Yehowa ƒe ŋkɔ.<verse eid="PSA 116:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 116:18"/>Maxe nye adzɔgbeɖefe na Yehowa,</para>
  <para style="q2" vid="PSA 116:18">le eƒe dukɔ blibo la ŋkume,<verse eid="PSA 116:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 116:19"/>le Yehowa ƒe aƒe ƒe xɔxɔnuwo,</para>
  <para style="q2" vid="PSA 116:19">le mia dome, o Yerusalem.</para>
  <para style="b" vid="PSA 116:19"/>
  <para style="q1" vid="PSA 116:19">Mikafu Yehowa.<verse eid="PSA 116:19"/></para>
  <chapter eid="PSA 116"/>
  <chapter number="117" style="c" sid="PSA 117"/>
  <para style="cl">Psalmo 117</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 117:1"/>Mi dukɔwo katã, mikafu Yehowa;</para>
  <para style="q2" vid="PSA 117:1">midoe ɖe dzi, mi ame siwo katã le anyigba dzi.<verse eid="PSA 117:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 117:2"/>Elabena eƒe lɔlɔ̃ na mí sɔ gbɔ ŋutɔ,</para>
  <para style="q2" vid="PSA 117:2">eye Yehowa ƒe nuteƒewɔwɔ li tegbee.</para>
  <para style="b" vid="PSA 117:2"/>
  <para style="q1" vid="PSA 117:2">Mikafu Yehowa.<verse eid="PSA 117:2"/></para>
  <chapter eid="PSA 117"/>
  <chapter number="118" style="c" sid="PSA 118"/>
  <para style="cl">Psalmo 118</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 118:1"/>Mida akpe ne Yehowa,</para>
  <para style="q2" vid="PSA 118:1">elabena eƒe dɔ me nyo, eye eƒe lɔlɔ̃ li ɖaa.<verse eid="PSA 118:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 118:2"/>Israel negblɔ be;</para>
  <para style="q2" vid="PSA 118:2">“Eƒe lɔlɔ̃ li ɖaa.”<verse eid="PSA 118:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 118:3"/>Aron ƒe aƒe la negblɔ be;</para>
  <para style="q2" vid="PSA 118:3">“Eƒe lɔlɔ̃ li ɖaa.”<verse eid="PSA 118:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 118:4"/>Ame siwo vɔ̃a Yehowa la negblɔ be,</para>
  <para style="q2" vid="PSA 118:4">“Eƒe lɔlɔ̃ li ɖaa.”<verse eid="PSA 118:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 118:5"/>Le nye vevesese me, medo ɣli yɔ Yehowa,</para>
  <para style="q2" vid="PSA 118:5">etɔ nam, eye wòɖe gam.<verse eid="PSA 118:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 118:6"/>Yehowa li kplim, eya ta nyemavɔ̃ o.</para>
  <para style="q2" vid="PSA 118:6">Nu ka amegbetɔ awɔm?<verse eid="PSA 118:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 118:7"/>Yehowa li kplim, eyae nye nye xɔnametɔ.</para>
  <para style="q2" vid="PSA 118:7">Makpɔ nye futɔwo ta ɖa le dziɖuɖu me.<verse eid="PSA 118:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 118:8"/>Enyo be woatsɔ Yehowa awɔ sitsoƒee</para>
  <para style="q2" vid="PSA 118:8">wu, be woaɖo ŋu ɖe amegbetɔ ŋu.<verse eid="PSA 118:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 118:9"/>Enyo be woatsɔ Yehowa awɔ sitsoƒee wu, be</para>
  <para style="q2" vid="PSA 118:9">woaɖo ŋu ɖe dumegãwo ŋu.<verse eid="PSA 118:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 118:10"/>Dukɔwo katã ɖe to ɖem,</para>
  <para style="q2" vid="PSA 118:10">gake le Yehowa ƒe ŋkɔ me,</para>
  <para style="q2" vid="PSA 118:10">metsrɔ̃ wo katã.<verse eid="PSA 118:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 118:11"/>Woɖe to ɖem,</para>
  <para style="q2" vid="PSA 118:11">gake le Yehowa ƒe ŋkɔ me,</para>
  <para style="q2" vid="PSA 118:11">metsrɔ̃ wo katã.<verse eid="PSA 118:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 118:12"/>Woƒo kɔ ɖe ŋunye abe anyiwo ene,</para>
  <para style="q2" vid="PSA 118:12">gake wo nu va yi kaba abe ŋuvedzo ene;</para>
  <para style="q2" vid="PSA 118:12">ɛ̃, Yehowa ƒe ŋkɔ mee metsrɔ̃ wo le.<verse eid="PSA 118:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 118:13"/>Wotu asim do ɖe megbe,</para>
  <para style="q2" vid="PSA 118:13">eye medze anyi kloe,</para>
  <para style="q2" vid="PSA 118:13">gake Yehowa xɔ nam.<verse eid="PSA 118:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 118:14"/>Yehowae nye nye ŋusẽ kple nye ha,</para>
  <para style="q2" vid="PSA 118:14">eye wòzu nye xɔname.<verse eid="PSA 118:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 118:15"/>Aseyetsotso kple dziɖuɣli le ɖiɖim</para>
  <para style="q2" vid="PSA 118:15">le ame dzɔdzɔewo ƒe agbadɔ me be,</para>
  <para style="q1" vid="PSA 118:15">“Yehowa ƒe nuɖusi wɔ nu dzɔatsuwo!<verse eid="PSA 118:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="PSA 118:16"/>Yehowa ƒe nuɖusi le dzi bobobo!</para>
  <para style="q2" vid="PSA 118:16">Yehowa ƒe nuɖusi wɔ nu dzɔatsuwo!”<verse eid="PSA 118:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 118:17"/>Nyemaku o,</para>
  <para style="q2" vid="PSA 118:17">ke boŋ manɔ agbe,</para>
  <para style="q2" vid="PSA 118:17">eye maɖe gbeƒã nu siwo Yehowa wɔ.<verse eid="PSA 118:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 118:18"/>Yehowa he to nam vevie,</para>
  <para style="q2" vid="PSA 118:18">gake metsɔm de asi na ku o.<verse eid="PSA 118:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 118:19"/>Miʋu dzɔdzɔenyenye ƒe agbowo nam,</para>
  <para style="q2" vid="PSA 118:19">mage ɖe eme, eye mada akpe na Yehowa.<verse eid="PSA 118:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 118:20"/>Esiae nye Yehowa ƒe agbo,</para>
  <para style="q2" vid="PSA 118:20">afi si dzɔdzɔetɔwo ato age ɖe eme.<verse eid="PSA 118:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 118:21"/>Mada akpe na wò,</para>
  <para style="q2" vid="PSA 118:21">elabena èɖo tom, eye nèzu nye xɔname.<verse eid="PSA 118:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 118:22"/>Kpe si xɔtulawo gbe la,</para>
  <para style="q2" vid="PSA 118:22">eyae va zu dzogoedzikpe.<verse eid="PSA 118:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 118:23"/>Yehowae wɔ esia,</para>
  <para style="q2" vid="PSA 118:23">eye wònye nukunu le míaƒe ŋkume.<verse eid="PSA 118:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 118:24"/>Esia nye ŋkeke si Yehowa wɔ,</para>
  <para style="q2" vid="PSA 118:24">mina míakpɔ dzidzɔ, atso aseye le eme.<verse eid="PSA 118:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 118:25"/>O! Yehowa, ɖe mí, o Yehowa,</para>
  <para style="q2" vid="PSA 118:25">na wòadze edzi na mí dzro.<verse eid="PSA 118:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 118:26"/>Woayra ame si gbɔna le Yehowa ƒe ŋkɔ me.</para>
  <para style="q2" vid="PSA 118:26">Míeyra wò tso Yehowa ƒe aƒe me.<verse eid="PSA 118:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 118:27"/>Yehowae nye Mawu,</para>
  <para style="q2" vid="PSA 118:27">eye wòna eƒe kekeli klẽ ɖe mía dzi.</para>
  <para style="q1" vid="PSA 118:27">Mitsɔ miaƒe atilɔwo ɖe asi ne</para>
  <para style="q2" vid="PSA 118:27">miage ɖe ŋkekenyuiɖulawo ƒe</para>
  <para style="q2" vid="PSA 118:27">hame ayi ɖe keke vɔsamlekpui la ƒe dzowo gbɔ.<verse eid="PSA 118:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 118:28"/>Wòe nye nye Mawu, eya ta mada akpe na wò;</para>
  <para style="q2" vid="PSA 118:28">wòe nye nye Mawu, eya ta mado wò ɖe dzi.<verse eid="PSA 118:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 118:29"/>Mida akpe na Yehowa, elabena eƒe dɔ me nyo,</para>
  <para style="q2" vid="PSA 118:29">eye eƒe lɔlɔ̃ li tegbetegbe.<verse eid="PSA 118:29"/></para>
  <chapter eid="PSA 118"/>
  <chapter number="119" style="c" sid="PSA 119"/>
  <para style="cl">Psalmo 119</para>
  <para style="qa">א Aleph</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 119:1"/>Woayra ame siwo kpɔtsɔtsɔ mele woƒe mɔwo ŋu o,</para>
  <para style="q2" vid="PSA 119:1">ame siwo zɔna ɖe Yehowa ƒe se la nu.<verse eid="PSA 119:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 119:2"/>Woayra ame siwo léa eƒe ɖoɖowo me ɖe asi,</para>
  <para style="q2" vid="PSA 119:2">eye wodinɛ kple woƒe dzi blibo.<verse eid="PSA 119:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 119:3"/>Womewɔa vɔ̃ aɖeke o;</para>
  <para style="q2" vid="PSA 119:3">ke boŋ wozɔna le eƒe mɔwo dzi.<verse eid="PSA 119:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 119:4"/>Èwɔ se siwo dzi wòle be</para>
  <para style="q2" vid="PSA 119:4">woawɔ ɖo blibo la da ɖi.<verse eid="PSA 119:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 119:5"/>O! Ɖe nye mɔwo li ke sesĩe</para>
  <para style="q2" vid="PSA 119:5">le wò sewo dzi wɔwɔ me la, anyo ŋutɔ.<verse eid="PSA 119:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 119:6"/>Ekema ŋu makpem ne mebu wò sewo katã ŋu o.<verse eid="PSA 119:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 119:7"/>Makafu wò le dzi dzɔdzɔe me,</para>
  <para style="q2" vid="PSA 119:7">ne mele wò se dzɔdzɔeawo srɔ̃m.<verse eid="PSA 119:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 119:8"/>Mawɔ ɖe wò sededewo dzi,</para>
  <para style="q2" vid="PSA 119:8">eya ta mègagblẽm ɖi keŋkeŋ o.<verse eid="PSA 119:8"/></para>
  <para style="qa">ב Beth</para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 119:9"/>Aleke ɖekakpui awɔ,</para>
  <para style="q2" vid="PSA 119:9">be eƒe mɔ dzi nanɔ dzadzɛe ɣe sia ɣi?</para>
  <para style="q2" vid="PSA 119:9">To agbenɔnɔ ɖe wò nya la nu mee.<verse eid="PSA 119:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 119:10"/>Madi wò kple nye dzi blibo,</para>
  <para style="q2" vid="PSA 119:10">eya ta mègana matra tso wò sewo gbɔ o.<verse eid="PSA 119:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 119:11"/>Meɣla wò nya ɖe nye dzi me,</para>
  <para style="q2" vid="PSA 119:11">be nyemawɔ nu vɔ̃ ɖe ŋuwò o.<verse eid="PSA 119:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 119:12"/>O! Yehowa, woakafu wò ɖaa;</para>
  <para style="q2" vid="PSA 119:12">fia wò sededewom.<verse eid="PSA 119:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 119:13"/>Matsɔ nye nu axlẽ se siwo katã</para>
  <para style="q2" vid="PSA 119:13">do tso wò nu me la afia.<verse eid="PSA 119:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 119:14"/>Melé wò ɖoɖowo me ɖe asi dzidzɔtɔe,</para>
  <para style="q2" vid="PSA 119:14">abe ale si ame kpɔa dzidzɔ ɖe</para>
  <para style="q2" vid="PSA 119:14">kesinɔnu gbogbowo ŋu ene.<verse eid="PSA 119:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 119:15"/>Mede ŋugble le wò ɖoɖowo ŋu,</para>
  <para style="q2" vid="PSA 119:15">eye melé ŋku ɖe wò mɔwo ŋu.<verse eid="PSA 119:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 119:16"/>Wò sededewo doa dzidzɔ nam,</para>
  <para style="q2" vid="PSA 119:16">nyemaŋlɔ wò nya la be o.<verse eid="PSA 119:16"/></para>
  <para style="qa">ג Gimel</para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 119:17"/>Wɔ nyui na wò dɔla, be manɔ agbe.</para>
  <para style="q2" vid="PSA 119:17">Mawɔ wò nya la dzi.<verse eid="PSA 119:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 119:18"/>Ʋu nye ŋkuwo be makpɔ</para>
  <para style="q2" vid="PSA 119:18">nukunuwo le wò se la me.<verse eid="PSA 119:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 119:19"/>Amedzroe menye le anyigba dzi,</para>
  <para style="q2" vid="PSA 119:19">eya ta mègaɣla wò sededewo ɖem o.<verse eid="PSA 119:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 119:20"/>Nu te nye luʋɔ ŋu,</para>
  <para style="q2" vid="PSA 119:20">le wò sewo yometiti ɣe sia ɣi ta.<verse eid="PSA 119:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 119:21"/>Èka mo na dadalawo,</para>
  <para style="q2" vid="PSA 119:21">ame siwo woƒo fi de,</para>
  <para style="q2" vid="PSA 119:21">eye wotra tso wò sewo gbɔ.<verse eid="PSA 119:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 119:22"/>Ɖe ŋukpe kple vlododo ɖa le ŋunye,</para>
  <para style="q2" vid="PSA 119:22">elabena melé wò sewo me ɖe asi.<verse eid="PSA 119:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 119:23"/>Togbɔ be dziɖulawo nɔ anyi ɖe teƒe ɖeka,</para>
  <para style="q2" vid="PSA 119:23">eye wole ŋunye gblẽm hã la,</para>
  <para style="q2" vid="PSA 119:23">wò dɔla ade ŋugble le wò sededewo ŋu.<verse eid="PSA 119:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 119:24"/>Wò ɖoɖowo dzɔa dzi nam;</para>
  <para style="q2" vid="PSA 119:24">wonye nye aɖaŋuɖolawo.<verse eid="PSA 119:24"/></para>
  <para style="qa">ד Daleth</para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 119:25"/>Wotsɔm mlɔ anyigba le ke me,</para>
  <para style="q2" vid="PSA 119:25">kpɔ nye agbe ta le wò nya la nu.<verse eid="PSA 119:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 119:26"/>Mexlẽ nye mɔwo fia, eye nèɖo tom.</para>
  <para style="q2" vid="PSA 119:26">Fia wò sededewom.<verse eid="PSA 119:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 119:27"/>Na mase wò sewo ƒe nufiafia gɔme;</para>
  <para style="q2" vid="PSA 119:27">ekema made ŋugble le wò nukunuwo ŋu.<verse eid="PSA 119:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 119:28"/>Nuxaxa na nye luʋɔ gbɔdzɔ;</para>
  <para style="q2" vid="PSA 119:28">do ŋusẽm le wò nya la nu.<verse eid="PSA 119:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 119:29"/>Ɖem le alakpamɔwo dzi,</para>
  <para style="q2" vid="PSA 119:29">eye nàve nunye to wò se la dzi.<verse eid="PSA 119:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 119:30"/>Metia nyateƒe ƒe mɔ,</para>
  <para style="q2" vid="PSA 119:30">eye nye dzi ku ɖe wò sewo ŋu.<verse eid="PSA 119:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 119:31"/>Meku ɖe wò sewo ŋu vevie,</para>
  <para style="q2" vid="PSA 119:31">o Yehowa, eya ta mègana ŋu nakpem o.<verse eid="PSA 119:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 119:32"/>Mele du dzi le wò sewo ƒe mɔ dzi,</para>
  <para style="q2" vid="PSA 119:32">elabena èna nye dzi gbɔ ɖe me.<verse eid="PSA 119:32"/></para>
  <para style="qa">ה He</para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 119:33"/>O, Yehowa, fia ale si madze wò sededewo yomee lam,</para>
  <para style="q2" vid="PSA 119:33">ekema malé wo me ɖe asi va se ɖe nuwuwu.<verse eid="PSA 119:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 119:34"/>Na gɔmesesem, ekema malé wò se la me ɖe asi,</para>
  <para style="q2" vid="PSA 119:34">eye mawɔ edzi kple nye dzi blibo.<verse eid="PSA 119:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 119:35"/>Dam ɖe wò sededewo ƒe mɔ dzi,</para>
  <para style="q2" vid="PSA 119:35">elabena afi ma mekpɔa dzidzɔ le.<verse eid="PSA 119:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 119:36"/>Trɔ nye dzi ɖe wò sewo ŋu,</para>
  <para style="q2" vid="PSA 119:36">ke menye ɖe ɖokuitɔdidi ƒe viɖe ŋu o.<verse eid="PSA 119:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 119:37"/>Ɖe nye ŋku ɖa le nu maɖinuwo ŋu,</para>
  <para style="q2" vid="PSA 119:37">eye nàɖe nye agbe le wò nya la nu.<verse eid="PSA 119:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 119:38"/>Wɔ wò ŋugbedodo la dzi na wò dɔla,</para>
  <para style="q2" vid="PSA 119:38">ale be woavɔ̃ wò.<verse eid="PSA 119:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 119:39"/>Ɖe ŋukpe si vɔ̃m mele la ɖa,</para>
  <para style="q2" vid="PSA 119:39">elabena wò sewo nyo.<verse eid="PSA 119:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 119:40"/>Mele wò sewo dim vevie ŋutɔ!</para>
  <para style="q2" vid="PSA 119:40">Le wò dzɔdzɔenyenye ta, ɖe nye agbe.<verse eid="PSA 119:40"/></para>
  <para style="qa">ו Waw</para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 119:41"/>O! Yehowa, wò lɔlɔ̃ si meʋãna o</para>
  <para style="q2" vid="PSA 119:41">la neva gbɔnye;</para>
  <para style="q1" vid="PSA 119:41">nenema kee nye wò xɔname hã</para>
  <para style="q2" vid="PSA 119:41">le wò ŋugbedodo la nu,<verse eid="PSA 119:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 119:42"/>ekema maɖo eŋu na ame si le alɔme ɖem le ŋunye,</para>
  <para style="q2" vid="PSA 119:42">elabena meka ɖe wò nya dzi.<verse eid="PSA 119:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 119:43"/>Mègaɖe nyateƒe ƒe nya la le nye nu me o,</para>
  <para style="q2" vid="PSA 119:43">elabena meda nye mɔkpɔkpɔ ɖe wò sewo dzi.<verse eid="PSA 119:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 119:44"/>Mawɔ ɖe wò se la dzi ɣe sia ɣi,</para>
  <para style="q2" vid="PSA 119:44">tso mavɔ me yi ɖe mavɔ me.<verse eid="PSA 119:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 119:45"/>Mazɔ le ablɔɖe me,</para>
  <para style="q2" vid="PSA 119:45">elabena medi wò ɖoɖowo yomemɔ.<verse eid="PSA 119:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 119:46"/>Maƒo nu tso wò sewo ŋu</para>
  <para style="q2" vid="PSA 119:46">le fiawo ŋkume, eye ŋu makpem o.<verse eid="PSA 119:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 119:47"/>Wò sededewo doa dzidzɔ nam,</para>
  <para style="q2" vid="PSA 119:47">elabena melɔ̃a wo.<verse eid="PSA 119:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 119:48"/>Medo nye asiwo ɖe dzi na wò sedede siwo melɔ̃ la,</para>
  <para style="q2" vid="PSA 119:48">eye mede ŋugble le wò sededewo ŋu.<verse eid="PSA 119:48"/></para>
  <para style="qa">ז Zayin</para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 119:49"/>Ɖo ŋku nya si nègblɔ na wò dɔla la dzi,</para>
  <para style="q2" vid="PSA 119:49">elabena ètsɔ mɔkpɔkpɔ de menye.<verse eid="PSA 119:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 119:50"/>Esiae nye nye akɔfafa le nye fukpekpe me,</para>
  <para style="q2" vid="PSA 119:50">be wò ŋugbedodo ɖe nye agbe.<verse eid="PSA 119:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 119:51"/>Dadalawo ɖua fewu le ŋunye faa,</para>
  <para style="q2" vid="PSA 119:51">gake nyemetrɔ le wò se la yome o.<verse eid="PSA 119:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 119:52"/>O! Yehowa, meɖo ŋku wò blemasewo dzi,</para>
  <para style="q2" vid="PSA 119:52">elabena mekpɔa akɔfafa le wo me.<verse eid="PSA 119:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 119:53"/>Ŋɔdzi lém le ame vɔ̃ɖiwo ta,</para>
  <para style="q2" vid="PSA 119:53">ame siwo gbe nu le wò se la gbɔ.<verse eid="PSA 119:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 119:54"/>Afi sia afi si medze la,</para>
  <para style="q2" vid="PSA 119:54">wò sewo nyea nye ha ƒe tanya.<verse eid="PSA 119:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 119:55"/>O! Yehowa, le zã me la, meɖoa ŋku wò ŋkɔ dzi,</para>
  <para style="q2" vid="PSA 119:55">eye malé wò sewo me ɖe asi.<verse eid="PSA 119:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 119:56"/>Esia nye tɔnye gome,</para>
  <para style="q2" vid="PSA 119:56">elabena mewɔa wò ɖoɖowo dzi.<verse eid="PSA 119:56"/></para>
  <para style="qa">ח Heth</para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 119:57"/>O! Yehowa, wòe nye nye gomekpɔkpɔ,</para>
  <para style="q2" vid="PSA 119:57">eya ta medo ŋugbe be mawɔ ɖe wò nyawo dzi.<verse eid="PSA 119:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 119:58"/>Medi wò ŋkume kple nye dzi blibo,</para>
  <para style="q2" vid="PSA 119:58">eya ta ve nunye le wò ŋugbedodo la nu.<verse eid="PSA 119:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 119:59"/>Melé ŋku ɖe nye mɔwo ŋu,</para>
  <para style="q2" vid="PSA 119:59">eye metrɔ nye afɔ ɖe wò nuɖoanyiwo ŋu.<verse eid="PSA 119:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 119:60"/>Maɖe abla, nyemahe ɖe megbe o,</para>
  <para style="q2" vid="PSA 119:60">be mawɔ ɖe wò sededewo dzi.<verse eid="PSA 119:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 119:61"/>Togbɔ be ame vɔ̃ɖiwo blam kple ka hã la,</para>
  <para style="q2" vid="PSA 119:61">nyemaŋlɔ wò sewo be o.<verse eid="PSA 119:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 119:62"/>Mefɔ le zãtitina be mada akpe</para>
  <para style="q2" vid="PSA 119:62">na wò ɖe wò se dzɔdzɔeawo ta.<verse eid="PSA 119:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 119:63"/>Menye xɔ̃ na ame siwo katã vɔ̃a wò</para>
  <para style="q2" vid="PSA 119:63">kple ame siwo katã dze wò sewo yome.<verse eid="PSA 119:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 119:64"/>O! Yehowa, anyigba dzi yɔ fũu</para>
  <para style="q2" vid="PSA 119:64">kple wò lɔlɔ̃, eya ta fia wò sededewom.<verse eid="PSA 119:64"/></para>
  <para style="qa">ט Teth</para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 119:65"/>O! Yehowa, wɔ nyui na wò dɔla</para>
  <para style="q2" vid="PSA 119:65">le wò nya la nu.<verse eid="PSA 119:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 119:66"/>Fia nunya kple afia nyui tsotsom,</para>
  <para style="q2" vid="PSA 119:66">elabena mexɔ wò sededewo dzi se.<verse eid="PSA 119:66"/></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 119:67"/>Hafi woava aka hiãm la,</para>
  <para style="q2" vid="PSA 119:67">metra mɔ, ke azɔ la, meɖo to wò nya la.<verse eid="PSA 119:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 119:68"/>Wò la, ènyo, eye nu si nèwɔ la hã nyo,</para>
  <para style="q2" vid="PSA 119:68">eya ta fia wò sededewom.<verse eid="PSA 119:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 119:69"/>Togbɔ be dadalawo tsɔ alakpa sisi ɖe ŋunye keŋ hã la,</para>
  <para style="q2" vid="PSA 119:69">melé wò sewo me ɖe asi kple nye dzi blibo.<verse eid="PSA 119:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 119:70"/>Woƒe dzi ku atri, eye megasea naneke o,</para>
  <para style="q2" vid="PSA 119:70">ke nye la, mekpɔa dzidzɔ ɖe wò se la ŋu.<verse eid="PSA 119:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 119:71"/>Enyo be woka hiãm,</para>
  <para style="q2" vid="PSA 119:71">ale be mate ŋu asrɔ̃ wò sededewo.<verse eid="PSA 119:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 119:72"/>Se siwo do tso wò nu me la xɔ asi nam wu</para>
  <para style="q2" vid="PSA 119:72">sika kple klosalo akpewo.<verse eid="PSA 119:72"/></para>
  <para style="qa">י Yodh</para>
  <para style="q1">
    <verse number="73" style="v" sid="PSA 119:73"/>Wò asie wɔm, eye wò asimee medo tso;</para>
  <para style="q2" vid="PSA 119:73">tsɔ gɔmesese nam, be masrɔ̃ wò sededewo.<verse eid="PSA 119:73"/></para>
  <para style="q1">
    <verse number="74" style="v" sid="PSA 119:74"/>Na ame siwo vɔ̃a wò la nakpɔ dzidzɔ ne wokpɔm,</para>
  <para style="q2" vid="PSA 119:74">elabena metsɔ nye mɔkpɔkpɔ da ɖe wò nya la dzi.<verse eid="PSA 119:74"/></para>
  <para style="q1">
    <verse number="75" style="v" sid="PSA 119:75"/>O! Yehowa, menya be wò sewo le dzɔdzɔe,</para>
  <para style="q2" vid="PSA 119:75">eye le wò dzɔdzɔenyenye la me, nèka hiãm.<verse eid="PSA 119:75"/></para>
  <para style="q1">
    <verse number="76" style="v" sid="PSA 119:76"/>Na be wò lɔlɔ̃ si meʋãna o la nanye nye akɔfafa,</para>
  <para style="q2" vid="PSA 119:76">le ŋugbe si nèdo na wò dɔla la ta.<verse eid="PSA 119:76"/></para>
  <para style="q1">
    <verse number="77" style="v" sid="PSA 119:77"/>Wò dɔmenyo neɖiɖi ɖe dzinye, be manɔ agbe,</para>
  <para style="q2" vid="PSA 119:77">elabena wò se lae nye nye dzidzɔ.<verse eid="PSA 119:77"/></para>
  <para style="q1">
    <verse number="78" style="v" sid="PSA 119:78"/>Na ŋu nakpe dadala,</para>
  <para style="q2" vid="PSA 119:78">le esi wòwɔ vɔ̃ ɖe ŋunye, nye nanekemawɔmawɔe;</para>
  <para style="q2" vid="PSA 119:78">ke nye la, made ŋugble le wò ɖoɖowo ŋu.<verse eid="PSA 119:78"/></para>
  <para style="q1">
    <verse number="79" style="v" sid="PSA 119:79"/>Na ame siwo vɔ̃a wò la natrɔ ɖe ŋunye,</para>
  <para style="q2" vid="PSA 119:79">ame siwo se wò nuɖoanyiwo gɔme.<verse eid="PSA 119:79"/></para>
  <para style="q1">
    <verse number="80" style="v" sid="PSA 119:80"/>Na kpɔtsɔtsɔ manɔ nye dzi ŋuti ɖe wò sededewo ŋu o,</para>
  <para style="q2" vid="PSA 119:80">ale be ŋu makpem o.<verse eid="PSA 119:80"/></para>
  <para style="qa">כ Kaph</para>
  <para style="q1">
    <verse number="81" style="v" sid="PSA 119:81"/>Nu ti kɔ na nye luʋɔ le wò ɖeɖedidi vevie ta,</para>
  <para style="q2" vid="PSA 119:81">gake metsɔ nye mɔkpɔkpɔ da ɖe wò nya la dzi.<verse eid="PSA 119:81"/></para>
  <para style="q1">
    <verse number="82" style="v" sid="PSA 119:82"/>Nu te nye ŋkuwo ŋu,</para>
  <para style="q2" vid="PSA 119:82">le mɔkpɔkpɔ na wò ŋugbedodo la ta.</para>
  <para style="q2" vid="PSA 119:82">Megblɔ be, “Ɣe ka ɣi nàfa akɔ nam?”<verse eid="PSA 119:82"/></para>
  <para style="q1">
    <verse number="83" style="v" sid="PSA 119:83"/>Togbɔ be mele abe waingolo</para>
  <para style="q2" vid="PSA 119:83">le dzudzɔ me ene hã la,</para>
  <para style="q2" vid="PSA 119:83">nyemeŋlɔ wò sededewo be o.<verse eid="PSA 119:83"/></para>
  <para style="q1">
    <verse number="84" style="v" sid="PSA 119:84"/>Va se ɖe ɣe ka ɣi wò dɔla alala?</para>
  <para style="q2" vid="PSA 119:84">Ɣe ka ɣi nàhe to na yonyemetilawo?<verse eid="PSA 119:84"/></para>
  <para style="q1">
    <verse number="85" style="v" sid="PSA 119:85"/>Dadalawo ɖe ʋe ɖi nam,</para>
  <para style="q2" vid="PSA 119:85">nu si tsi tsitre ɖe wò se la ŋu.<verse eid="PSA 119:85"/></para>
  <para style="q1">
    <verse number="86" style="v" sid="PSA 119:86"/>Wò sededewo katã nye nu si dzi woaka ɖo;</para>
  <para style="q2" vid="PSA 119:86">kpe ɖe ŋunye,</para>
  <para style="q2" vid="PSA 119:86">elabena amewo ti yonyeme susumanɔmetɔe.<verse eid="PSA 119:86"/></para>
  <para style="q1">
    <verse number="87" style="v" sid="PSA 119:87"/>Esusɔ vie woɖem ɖa le anyigba dzi kloe,</para>
  <para style="q2" vid="PSA 119:87">gake nyemeŋlɔ wò ɖoɖowo be o.<verse eid="PSA 119:87"/></para>
  <para style="q1">
    <verse number="88" style="v" sid="PSA 119:88"/>Le wò lɔlɔ̃ la ta, kpɔ nye agbe ta,</para>
  <para style="q2" vid="PSA 119:88">eye maɖo to se siwo do tso wò nu me.<verse eid="PSA 119:88"/></para>
  <para style="qa">ל Lamedh</para>
  <para style="q1">
    <verse number="89" style="v" sid="PSA 119:89"/>O! Yehowa, wò nya la nye nya mavɔ,</para>
  <para style="q2" vid="PSA 119:89">eli ke goŋgoŋgoŋ ɖe dziƒo.<verse eid="PSA 119:89"/></para>
  <para style="q1">
    <verse number="90" style="v" sid="PSA 119:90"/>Wò nuteƒewɔwɔ li le dzidzimewo katã;</para>
  <para style="q2" vid="PSA 119:90">wòe ɖo anyigba gɔme anyi, eye wòli ke ɖaa.<verse eid="PSA 119:90"/></para>
  <para style="q1">
    <verse number="91" style="v" sid="PSA 119:91"/>Wò sewo gali va se ɖe egbe,</para>
  <para style="q2" vid="PSA 119:91">elabena wòe nuwo katã subɔna.<verse eid="PSA 119:91"/></para>
  <para style="q1">
    <verse number="92" style="v" sid="PSA 119:92"/>Nenye ɖe wò se la menye nye dzidzɔ o la,</para>
  <para style="q2" vid="PSA 119:92">anye ne metsrɔ̃ le nye hiãkame me.<verse eid="PSA 119:92"/></para>
  <para style="q1">
    <verse number="93" style="v" sid="PSA 119:93"/>Nyemaŋlɔ wò ɖoɖowo be o,</para>
  <para style="q2" vid="PSA 119:93">elabena èkpɔ nye agbe ta to wo dzi.<verse eid="PSA 119:93"/></para>
  <para style="q1">
    <verse number="94" style="v" sid="PSA 119:94"/>Ɖem, elabena tɔwò menye,</para>
  <para style="q2" vid="PSA 119:94">elabena medi wò ɖoɖowo ƒe mɔ.<verse eid="PSA 119:94"/></para>
  <para style="q1">
    <verse number="95" style="v" sid="PSA 119:95"/>Ame vɔ̃ɖiwo le lalam be woatsrɔ̃m,</para>
  <para style="q2" vid="PSA 119:95">ke nye la, madzro wò sewo me.<verse eid="PSA 119:95"/></para>
  <para style="q1">
    <verse number="96" style="v" sid="PSA 119:96"/>Mekpɔ seɖoƒe na nu de blibo ɖe sia ɖe,</para>
  <para style="q2" vid="PSA 119:96">gake wò sededewo ya la, seɖoƒe meli na wo o.<verse eid="PSA 119:96"/></para>
  <para style="qa">מ Mem</para>
  <para style="q1">
    <verse number="97" style="v" sid="PSA 119:97"/>O, ale gbegbe mehelɔ̃ wò se lae!</para>
  <para style="q2" vid="PSA 119:97">Medea ŋugble le eŋuti ŋkeke blibo la.<verse eid="PSA 119:97"/></para>
  <para style="q1">
    <verse number="98" style="v" sid="PSA 119:98"/>Wò sededewo wɔm nunyalae wu nye futɔwo katã,</para>
  <para style="q2" vid="PSA 119:98">elabena wole gbɔnye ɖaa.<verse eid="PSA 119:98"/></para>
  <para style="q1">
    <verse number="99" style="v" sid="PSA 119:99"/>Gɔmesese su asinye wu nye nufialawo katã,</para>
  <para style="q2" vid="PSA 119:99">elabena medea ŋugble le wò ɖoɖowo ŋu.<verse eid="PSA 119:99"/></para>
  <para style="q1">
    <verse number="100" style="v" sid="PSA 119:100"/>Gɔmesese le asinye wu dumegãwo,</para>
  <para style="q2" vid="PSA 119:100">elabena mewɔ ɖe wò ɖoɖowo dzi.<verse eid="PSA 119:100"/></para>
  <para style="q1">
    <verse number="101" style="v" sid="PSA 119:101"/>Meɖe nye afɔ ɖa le mɔ vɔ̃ ɖe sia ɖe dzi,</para>
  <para style="q2" vid="PSA 119:101">ale be mawɔ ɖe wò nya la dzi.<verse eid="PSA 119:101"/></para>
  <para style="q1">
    <verse number="102" style="v" sid="PSA 119:102"/>Nyemedzo le wò sewo gbɔ o,</para>
  <para style="q2" vid="PSA 119:102">elabena wò ŋutɔe fia num.<verse eid="PSA 119:102"/></para>
  <para style="q1">
    <verse number="103" style="v" sid="PSA 119:103"/>Wò nyawo vivia nunye ŋutɔ,</para>
  <para style="q2" vid="PSA 119:103">eye wovivina le nye nu me wu anyitsi nyuitɔ!<verse eid="PSA 119:103"/></para>
  <para style="q1">
    <verse number="104" style="v" sid="PSA 119:104"/>Gɔmesese su asinye to wò sewo dzi,</para>
  <para style="q2" vid="PSA 119:104">eya ta metsri mɔ gɔglɔ̃ ɖe sia ɖe.<verse eid="PSA 119:104"/></para>
  <para style="qa">נ Nun</para>
  <para style="q1">
    <verse number="105" style="v" sid="PSA 119:105"/>Wò nya la nye akaɖi na nye afɔ</para>
  <para style="q2" vid="PSA 119:105">kple kekeli na nye mɔ.<verse eid="PSA 119:105"/></para>
  <para style="q1">
    <verse number="106" style="v" sid="PSA 119:106"/>Meka atam, eye meɖo kpe edzi be,</para>
  <para style="q2" vid="PSA 119:106">wò se dzɔdzɔewo yome ko manɔ.<verse eid="PSA 119:106"/></para>
  <para style="q1">
    <verse number="107" style="v" sid="PSA 119:107"/>Mekpe fu geɖe,</para>
  <para style="q2" vid="PSA 119:107">eya ta o Yehowa,</para>
  <para style="q1" vid="PSA 119:107">kpɔ nye agbe ta,</para>
  <para style="q2" vid="PSA 119:107">le wò nya la nu.<verse eid="PSA 119:107"/></para>
  <para style="q1">
    <verse number="108" style="v" sid="PSA 119:108"/>O! Yehowa, xɔ kafukafu si nye nu dzra ɖo ɖi la,</para>
  <para style="q2" vid="PSA 119:108">eye nàfia wò sewom.<verse eid="PSA 119:108"/></para>
  <para style="q1">
    <verse number="109" style="v" sid="PSA 119:109"/>Togbɔ be metsɔ nye agbe ɖo nye asiƒome enuenu hã la,</para>
  <para style="q2" vid="PSA 119:109">nyemaŋlɔ wò se la be o.<verse eid="PSA 119:109"/></para>
  <para style="q1">
    <verse number="110" style="v" sid="PSA 119:110"/>Ame vɔ̃ɖi la tre mɔ nam,</para>
  <para style="q2" vid="PSA 119:110">gake nyemetra tso wò nuɖoanyiwo gbɔ o.<verse eid="PSA 119:110"/></para>
  <para style="q1">
    <verse number="111" style="v" sid="PSA 119:111"/>Wò ɖoɖowo nye nye domenyinu tegbee,</para>
  <para style="q2" vid="PSA 119:111">elabena wonye nye dzi ƒe dzidzɔ.<verse eid="PSA 119:111"/></para>
  <para style="q1">
    <verse number="112" style="v" sid="PSA 119:112"/>Nye dzi ku ɖe wò sededewo dzi</para>
  <para style="q2" vid="PSA 119:112">wɔwɔ ŋu va se ɖe nuwuwu.<verse eid="PSA 119:112"/></para>
  <para style="qa">ס Samekh</para>
  <para style="q1">
    <verse number="113" style="v" sid="PSA 119:113"/>Melé fu susuevetɔwo,</para>
  <para style="q2" vid="PSA 119:113">gake melɔ̃ wò se la.<verse eid="PSA 119:113"/></para>
  <para style="q1">
    <verse number="114" style="v" sid="PSA 119:114"/>Wòe nye nye sitsoƒe kple nye akpoxɔnu,</para>
  <para style="q2" vid="PSA 119:114">metsɔ nye mɔkpɔkpɔ de wò nya la me.<verse eid="PSA 119:114"/></para>
  <para style="q1">
    <verse number="115" style="v" sid="PSA 119:115"/>Mite ɖa le gbɔnye, mi nu vlo wɔlawo,</para>
  <para style="q2" vid="PSA 119:115">be mate ŋu alé nye Mawu ƒe sewo me ɖe asi!<verse eid="PSA 119:115"/></para>
  <para style="q1">
    <verse number="116" style="v" sid="PSA 119:116"/>Lém ɖe asi le wò ŋugbedodo la nu,</para>
  <para style="q2" vid="PSA 119:116">ekema manɔ agbe, eye mègana ŋu nakpem</para>
  <para style="q2" vid="PSA 119:116">le nye mɔkpɔkpɔ me o.<verse eid="PSA 119:116"/></para>
  <para style="q1">
    <verse number="117" style="v" sid="PSA 119:117"/>Lém ɖe te, ekema makpɔ ɖeɖe,</para>
  <para style="q2" vid="PSA 119:117">eye ɣe sia ɣi made bubu wò sededewo ŋu.<verse eid="PSA 119:117"/></para>
  <para style="q1">
    <verse number="118" style="v" sid="PSA 119:118"/>Ègbe nu le ame siwo katã tra mɔ tso</para>
  <para style="q2" vid="PSA 119:118">wò sededewo gbɔ la gbɔ,</para>
  <para style="q2" vid="PSA 119:118">elabena woƒe alakpadada nye nu dzodzro.<verse eid="PSA 119:118"/></para>
  <para style="q1">
    <verse number="119" style="v" sid="PSA 119:119"/>Ègbe nu le ame vɔ̃ɖi siwo katã</para>
  <para style="q2" vid="PSA 119:119">le anyigba dzi la gbɔ abe gbeɖuɖɔ ene,</para>
  <para style="q2" vid="PSA 119:119">eya ta melɔ̃ wò nuɖoanyiwo.<verse eid="PSA 119:119"/></para>
  <para style="q1">
    <verse number="120" style="v" sid="PSA 119:120"/>Nye lãme le ƒoƒom</para>
  <para style="q2" vid="PSA 119:120">le vɔvɔ̃ na wò ta,</para>
  <para style="q2" vid="PSA 119:120">eye nye mo wɔ yaa le wò sewo ta.<verse eid="PSA 119:120"/></para>
  <para style="qa">ע Ayin</para>
  <para style="q1">
    <verse number="121" style="v" sid="PSA 119:121"/>Mewɔ nu si dzɔ kple nu si le eteƒe,</para>
  <para style="q2" vid="PSA 119:121">eya ta mègaɖe asi le ŋunye na</para>
  <para style="q2" vid="PSA 119:121">ame siwo tem ɖe anyi la o.<verse eid="PSA 119:121"/></para>
  <para style="q1">
    <verse number="122" style="v" sid="PSA 119:122"/>Kpɔ wò dɔla la ƒe dedinɔnɔ gbɔ,</para>
  <para style="q2" vid="PSA 119:122">mègana dadalawo natem ɖe to o.<verse eid="PSA 119:122"/></para>
  <para style="q1">
    <verse number="123" style="v" sid="PSA 119:123"/>Nu te nye ŋkuwo ŋu le wò ɖeɖedidi ta.<verse eid="PSA 119:123"/></para>
  <para style="q1">
    <verse number="124" style="v" sid="PSA 119:124"/>Wɔ nu kple wò dɔla le wò lɔlɔ̃ ta,</para>
  <para style="q2" vid="PSA 119:124">eye nàfia wò sededewom.<verse eid="PSA 119:124"/></para>
  <para style="q1">
    <verse number="125" style="v" sid="PSA 119:125"/>Wò dɔlae menye,</para>
  <para style="q2" vid="PSA 119:125">eya ta na sidzedzem, be mase wò nuɖoanyiwo gɔme.<verse eid="PSA 119:125"/></para>
  <para style="q1">
    <verse number="126" style="v" sid="PSA 119:126"/>O! Yehowa, ɣeyiɣi de na wò be nàɖe afɔ,</para>
  <para style="q2" vid="PSA 119:126">elabena wole wò sewo tum.<verse eid="PSA 119:126"/></para>
  <para style="q1">
    <verse number="127" style="v" sid="PSA 119:127"/>Elabena melɔ̃ wò sewo wu</para>
  <para style="q2" vid="PSA 119:127">sika kple sika nyuitɔ.<verse eid="PSA 119:127"/></para>
  <para style="q1">
    <verse number="128" style="v" sid="PSA 119:128"/>Eye esi mebu wò ɖoɖowo katã be wole dzɔdzɔe ta la,</para>
  <para style="q2" vid="PSA 119:128">metsri mɔ gɔglɔ̃ ɖe sia ɖe.<verse eid="PSA 119:128"/></para>
  <para style="qa">פ Pe</para>
  <para style="q1">
    <verse number="129" style="v" sid="PSA 119:129"/>Wò sewo nye nuku,</para>
  <para style="q2" vid="PSA 119:129">eya ta meɖo to wo.<verse eid="PSA 119:129"/></para>
  <para style="q1">
    <verse number="130" style="v" sid="PSA 119:130"/>Kekeli vana ne woʋu go wò nyawo,</para>
  <para style="q2" vid="PSA 119:130">eye nugɔmesese sua ame gblɔewo gɔ̃ hã si.<verse eid="PSA 119:130"/></para>
  <para style="q1">
    <verse number="131" style="v" sid="PSA 119:131"/>Meke nu ɖe te hele gbɔgbɔm fuxefuxe,</para>
  <para style="q2" vid="PSA 119:131">le wò sewo dim vevie.<verse eid="PSA 119:131"/></para>
  <para style="q1">
    <verse number="132" style="v" sid="PSA 119:132"/>Trɔ ɖe ŋunye, eye nàkpɔ nye nublanui</para>
  <para style="q2" vid="PSA 119:132">abe ale si nèwɔnɛ ɖaa na</para>
  <para style="q2" vid="PSA 119:132">ame siwo lɔ̃a wò ŋkɔ la ene.<verse eid="PSA 119:132"/></para>
  <para style="q1">
    <verse number="133" style="v" sid="PSA 119:133"/>Na maɖe afɔ le wò nya la nu,</para>
  <para style="q2" vid="PSA 119:133">eye mègana nu vɔ̃ aɖeke naɖu dzinye o.<verse eid="PSA 119:133"/></para>
  <para style="q1">
    <verse number="134" style="v" sid="PSA 119:134"/>Ɖem tso amewo ƒe teteɖeanyi me,</para>
  <para style="q2" vid="PSA 119:134">be mawɔ ɖe wò ɖoɖowo dzi.<verse eid="PSA 119:134"/></para>
  <para style="q1">
    <verse number="135" style="v" sid="PSA 119:135"/>Na wò mo naklẽ na wò dɔla,</para>
  <para style="q2" vid="PSA 119:135">eye nàfia wò sededewom.<verse eid="PSA 119:135"/></para>
  <para style="q1">
    <verse number="136" style="v" sid="PSA 119:136"/>Aɖatsi le sisim le nye ŋkuwo me abe tɔʋu ene,</para>
  <para style="q2" vid="PSA 119:136">elabena womewɔ wò sewo dzi o.<verse eid="PSA 119:136"/></para>
  <para style="qa">צ Tsadhe</para>
  <para style="q1">
    <verse number="137" style="v" sid="PSA 119:137"/>O! Yehowa, wò la, dzɔdzɔetɔe nènye,</para>
  <para style="q2" vid="PSA 119:137">eye wò sewo hã le dzɔdzɔe.<verse eid="PSA 119:137"/></para>
  <para style="q1">
    <verse number="138" style="v" sid="PSA 119:138"/>Nu siwo nèɖo anyi hã la le dzɔdzɔe,</para>
  <para style="q2" vid="PSA 119:138">woaka ɖe wo dzi ɖikeke manɔmee.<verse eid="PSA 119:138"/></para>
  <para style="q1">
    <verse number="139" style="v" sid="PSA 119:139"/>Dzo si metsɔ ɖe ŋuwò la na megbɔdzɔ,</para>
  <para style="q2" vid="PSA 119:139">elabena nye futɔwo gbe nu le wò nyawo gbɔ.<verse eid="PSA 119:139"/></para>
  <para style="q1">
    <verse number="140" style="v" sid="PSA 119:140"/>Wodo wò ŋugbedodowo katã kpɔ nyuie,</para>
  <para style="q2" vid="PSA 119:140">eye wò dɔla lɔ̃ wo ŋutɔ.<verse eid="PSA 119:140"/></para>
  <para style="q1">
    <verse number="141" style="v" sid="PSA 119:141"/>Togbɔ be wodo vlom,</para>
  <para style="q2" vid="PSA 119:141">eye nyemele ɖeke me o hã la,</para>
  <para style="q2" vid="PSA 119:141">nyemeŋlɔ wò ɖoɖowo be o.<verse eid="PSA 119:141"/></para>
  <para style="q1">
    <verse number="142" style="v" sid="PSA 119:142"/>Wò dzɔdzɔenyenye li tso mavɔ me yi ɖe mavɔ me,</para>
  <para style="q2" vid="PSA 119:142">eye wò se la hã nye nyateƒe.<verse eid="PSA 119:142"/></para>
  <para style="q1">
    <verse number="143" style="v" sid="PSA 119:143"/>Fukpekpe kple xaxa va dzinye,</para>
  <para style="q2" vid="PSA 119:143">gake wò sededewo doa dzidzɔ nam.<verse eid="PSA 119:143"/></para>
  <para style="q1">
    <verse number="144" style="v" sid="PSA 119:144"/>Wò nuɖoanyiwo le dzɔdzɔe ɖaa,</para>
  <para style="q2" vid="PSA 119:144">eya ta na gɔmesesem, be manɔ agbe.<verse eid="PSA 119:144"/></para>
  <para style="qa">ק Qoph</para>
  <para style="q1">
    <verse number="145" style="v" sid="PSA 119:145"/>O! Yehowa, mele yɔwòm kple nye dzi blibo,</para>
  <para style="q2" vid="PSA 119:145">eya ta tɔ nam, eye mawɔ wò sededewo dzi.<verse eid="PSA 119:145"/></para>
  <para style="q1">
    <verse number="146" style="v" sid="PSA 119:146"/>Wòe meyɔ, xɔ nam,</para>
  <para style="q2" vid="PSA 119:146">eye malé wò ɖoɖoawo me ɖe asi.<verse eid="PSA 119:146"/></para>
  <para style="q1">
    <verse number="147" style="v" sid="PSA 119:147"/>Mefɔ hafi ŋu ke, eye medo ɣli be woaxɔ nam,</para>
  <para style="q2" vid="PSA 119:147">ke metsɔ nye mɔkpɔkpɔ da ɖe wò nya la dzi.<verse eid="PSA 119:147"/></para>
  <para style="q1">
    <verse number="148" style="v" sid="PSA 119:148"/>Nye ŋkuwo le te le zã blibo la katã me,</para>
  <para style="q2" vid="PSA 119:148">be made ŋugble le wò ŋugbedodowo ŋu.<verse eid="PSA 119:148"/></para>
  <para style="q1">
    <verse number="149" style="v" sid="PSA 119:149"/>Se nye gbe, le wò lɔlɔ̃ la ta,</para>
  <para style="q2" vid="PSA 119:149">O! Yehowa, ɖe nye agbe,</para>
  <para style="q2" vid="PSA 119:149">le wò sewo ƒe ɖoɖo nu.<verse eid="PSA 119:149"/></para>
  <para style="q1">
    <verse number="150" style="v" sid="PSA 119:150"/>Ame siwo le nu vɔ̃ɖiwo ɖom la gogo,</para>
  <para style="q2" vid="PSA 119:150">gake wodidi tso wò se la gbɔ.<verse eid="PSA 119:150"/></para>
  <para style="q1">
    <verse number="151" style="v" sid="PSA 119:151"/>O! Yehowa, ètsɔ ɖe gbɔnye ɖe!</para>
  <para style="q2" vid="PSA 119:151">Wò sededewo katã hã nye nyateƒe.<verse eid="PSA 119:151"/></para>
  <para style="q1">
    <verse number="152" style="v" sid="PSA 119:152"/>Mesrɔ̃ nu tso wò se la me gbe aɖe gbe ke,</para>
  <para style="q2" vid="PSA 119:152">be èɖo wo gɔme anyi be woanɔ anyi</para>
  <para style="q2" vid="PSA 119:152">tso mavɔ me yi ɖe mavɔ me.<verse eid="PSA 119:152"/></para>
  <para style="qa">ר Resh</para>
  <para style="q1">
    <verse number="153" style="v" sid="PSA 119:153"/>Kpɔ nye hiãtuame ɖa, eye nàɖem,</para>
  <para style="q2" vid="PSA 119:153">elabena nyemeŋlɔ wò se la be o.<verse eid="PSA 119:153"/></para>
  <para style="q1">
    <verse number="154" style="v" sid="PSA 119:154"/>Ʋli tanye, eye nàɖem,</para>
  <para style="q2" vid="PSA 119:154">kpɔ nye agbe ta le wò ŋugbedodo la nu.<verse eid="PSA 119:154"/></para>
  <para style="q1">
    <verse number="155" style="v" sid="PSA 119:155"/>Ɖeɖe le adzɔge na ame vɔ̃ɖiwo,</para>
  <para style="q2" vid="PSA 119:155">elabena womedia wò sededewo ƒe mɔ o.<verse eid="PSA 119:155"/></para>
  <para style="q1">
    <verse number="156" style="v" sid="PSA 119:156"/>O! Yehowa, wò nublanuikpɔkpɔ sɔ gbɔ,</para>
  <para style="q2" vid="PSA 119:156">eya ta kpɔ nye agbe ta le wò sewo nu.<verse eid="PSA 119:156"/></para>
  <para style="q1">
    <verse number="157" style="v" sid="PSA 119:157"/>Futɔ siwo ti yonyeme la sɔ gbɔ ŋutɔ,</para>
  <para style="q2" vid="PSA 119:157">gake nyemetrɔ le wò ɖoɖowo yome o.<verse eid="PSA 119:157"/></para>
  <para style="q1">
    <verse number="158" style="v" sid="PSA 119:158"/>Menyɔ ŋu xɔsemanɔsitɔwo,</para>
  <para style="q2" vid="PSA 119:158">elabena womewɔa wò nya la dzi o.<verse eid="PSA 119:158"/></para>
  <para style="q1">
    <verse number="159" style="v" sid="PSA 119:159"/>Kpɔ ale si melɔ̃ wò sewoe ɖa;</para>
  <para style="q2" vid="PSA 119:159">eya ta o Yehowa,</para>
  <para style="q2" vid="PSA 119:159">kpɔ nye agbe ta le wò lɔlɔ̃ la ta.<verse eid="PSA 119:159"/></para>
  <para style="q1">
    <verse number="160" style="v" sid="PSA 119:160"/>Wò nyawo katã nye nyateƒe,</para>
  <para style="q2" vid="PSA 119:160">eye wò dzɔdzɔenyenye ƒe sewo katã nye se mavɔwo.<verse eid="PSA 119:160"/></para>
  <para style="qa">ש Sin kple Shin</para>
  <para style="q1">
    <verse number="161" style="v" sid="PSA 119:161"/>Dziɖulawo tia nye agbe yome susumanɔŋutɔe,</para>
  <para style="q2" vid="PSA 119:161">gake nye dzi dzo nyanyanya le wò nya la ta.<verse eid="PSA 119:161"/></para>
  <para style="q1">
    <verse number="162" style="v" sid="PSA 119:162"/>Mekpɔ dzidzɔ le wò ŋugbedodo la me</para>
  <para style="q2" vid="PSA 119:162">abe ame si ke ɖe afunyinu gbogbo aɖe ŋu ene.<verse eid="PSA 119:162"/></para>
  <para style="q1">
    <verse number="163" style="v" sid="PSA 119:163"/>Metsri, eye menyɔ ŋu alakpa,</para>
  <para style="q2" vid="PSA 119:163">ke melɔ̃ wò se la.<verse eid="PSA 119:163"/></para>
  <para style="q1">
    <verse number="164" style="v" sid="PSA 119:164"/>Mekafua wò zi adre le ŋkeke me,</para>
  <para style="q2" vid="PSA 119:164">le wò se dzɔdzɔeawo ta.<verse eid="PSA 119:164"/></para>
  <para style="q1">
    <verse number="165" style="v" sid="PSA 119:165"/>Ame siwo lɔ̃a wò se la,</para>
  <para style="q2" vid="PSA 119:165">kpɔa ŋutifafa gã aɖe,</para>
  <para style="q2" vid="PSA 119:165">eye naneke mawɔ wo woakli nu o.<verse eid="PSA 119:165"/></para>
  <para style="q1">
    <verse number="166" style="v" sid="PSA 119:166"/>O! Yehowa, mele wò xɔxɔ lalam,</para>
  <para style="q2" vid="PSA 119:166">eye manɔ wò sededewo yome.<verse eid="PSA 119:166"/></para>
  <para style="q1">
    <verse number="167" style="v" sid="PSA 119:167"/>Mawɔ ɖe wò nuɖoanyiwo dzi,</para>
  <para style="q2" vid="PSA 119:167">elabena melɔ̃ wo ŋutɔ.<verse eid="PSA 119:167"/></para>
  <para style="q1">
    <verse number="168" style="v" sid="PSA 119:168"/>Mawɔ ɖe wò sewo kple ɖoɖowo dzi,</para>
  <para style="q2" vid="PSA 119:168">elabena nye mɔwo katã le nyanya na wò.<verse eid="PSA 119:168"/></para>
  <para style="qa">ת Taw</para>
  <para style="q1">
    <verse number="169" style="v" sid="PSA 119:169"/>O! Yehowa, nye ɣlidodo nede gbɔwò,</para>
  <para style="q2" vid="PSA 119:169">tsɔ gɔmesese nam le wò nya la nu.<verse eid="PSA 119:169"/></para>
  <para style="q1">
    <verse number="170" style="v" sid="PSA 119:170"/>Nye gbedodoɖawo nede gbɔwò;</para>
  <para style="q2" vid="PSA 119:170">ɖem le wò ŋugbedodo la ta.<verse eid="PSA 119:170"/></para>
  <para style="q1">
    <verse number="171" style="v" sid="PSA 119:171"/>Nye nuyiwo negbã go kple kafukafu,</para>
  <para style="q2" vid="PSA 119:171">elabena èfia wò sededewom.<verse eid="PSA 119:171"/></para>
  <para style="q1">
    <verse number="172" style="v" sid="PSA 119:172"/>Nye aɖe adzi ha le wò nya la ŋu,</para>
  <para style="q2" vid="PSA 119:172">elabena wò sededewo katã le dzɔdzɔe.<verse eid="PSA 119:172"/></para>
  <para style="q1">
    <verse number="173" style="v" sid="PSA 119:173"/>Wò asi nenɔ klalo akpe ɖe ŋunye,</para>
  <para style="q2" vid="PSA 119:173">elabena metia wò sewo.<verse eid="PSA 119:173"/></para>
  <para style="q1">
    <verse number="174" style="v" sid="PSA 119:174"/>O! Yehowa, wò xɔname le dzroyem vevie ŋutɔ,</para>
  <para style="q2" vid="PSA 119:174">elabena wò se lae nye nye dzidzɔ.<verse eid="PSA 119:174"/></para>
  <para style="q1">
    <verse number="175" style="v" sid="PSA 119:175"/>Na manɔ agbe, ne makafu wò,</para>
  <para style="q2" vid="PSA 119:175">eye na wò sewo nalém ɖe te.<verse eid="PSA 119:175"/></para>
  <para style="q1">
    <verse number="176" style="v" sid="PSA 119:176"/>Metra mɔ abe alẽ bubu ene.</para>
  <para style="q2" vid="PSA 119:176">Di wò dɔla la,</para>
  <para style="q2" vid="PSA 119:176">elabena nyemeŋlɔ wò sededewo be o.<verse eid="PSA 119:176"/></para>
  <chapter eid="PSA 119"/>
  <chapter number="120" style="c" sid="PSA 120"/>
  <para style="cl">Psalmo 120</para>
  <para style="d">Mɔzɔha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 120:1"/>Meyɔ Yehowa le nye xaxa me, eye wòtɔ nam.<verse eid="PSA 120:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 120:2"/>O! Yehowa, ɖem,</para>
  <para style="q2" vid="PSA 120:2">tso aʋatsonuyiwo kple alakpaɖewo ƒe asi me.<verse eid="PSA 120:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 120:3"/>O! Alakpaɖe, nu ka wòawɔ na wò,</para>
  <para style="q2" vid="PSA 120:3">eye nu ka wòatsɔ akpee na wò?<verse eid="PSA 120:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 120:4"/>Atsɔ aʋawɔla ƒe aŋutrɔ ɖaɖɛwo ahe to na</para>
  <para style="q2" vid="PSA 120:4">wòe kpe ɖe yɔkuti ƒe dzoka xɔxɔwo ŋuti.<verse eid="PSA 120:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 120:5"/>Baba nam be mele Mesek,</para>
  <para style="q2" vid="PSA 120:5">eye mele Kedar ƒe agbadɔwo me!<verse eid="PSA 120:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 120:6"/>Menɔ ame siwo lé fu ŋutifafa</para>
  <para style="q2" vid="PSA 120:6">la dome wòdidi fũu akpa.<verse eid="PSA 120:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 120:7"/>Ŋutifafamee menye,</para>
  <para style="q2" vid="PSA 120:7">gake ne meƒo nu la, woawo kpea aʋa.<verse eid="PSA 120:7"/></para>
  <chapter eid="PSA 120"/>
  <chapter number="121" style="c" sid="PSA 121"/>
  <para style="cl">Psalmo 121</para>
  <para style="d">Mɔzɔha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 121:1"/>Mewu mo dzi ɖe togbɛawo ŋu,</para>
  <para style="q2" vid="PSA 121:1">afi ka nye xɔname atso ava?<verse eid="PSA 121:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 121:2"/>Nye xɔname atso Yehowa,</para>
  <para style="q2" vid="PSA 121:2">ame si wɔ dziƒo kple anyigba la gbɔ.<verse eid="PSA 121:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 121:3"/>Mana wò afɔ naɖiɖi o,</para>
  <para style="q2" vid="PSA 121:3">eya ame si dzɔa ŋuwò la madɔ akɔlɔ̃e o.<verse eid="PSA 121:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 121:4"/>Vavã, eya ame si dzɔa Israel ŋu la,</para>
  <para style="q2" vid="PSA 121:4">madɔ akɔlɔ̃e loo, alo adɔ alɔ̃ o.<verse eid="PSA 121:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 121:5"/>Yehowae nye tawòkpɔla,</para>
  <para style="q2" vid="PSA 121:5">Yehowae nye wò vɔvɔli le wò nuɖusime<verse eid="PSA 121:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 121:6"/>eya ta ɣe maɖu wò le ŋkeke me loo,</para>
  <para style="q2" vid="PSA 121:6">alo ɣleti le zã me o.<verse eid="PSA 121:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 121:7"/>Yehowa aɖe wò le vɔ̃wo katã me,</para>
  <para style="q2" vid="PSA 121:7">eye wòakpɔ wò agbe ta.<verse eid="PSA 121:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 121:8"/>Yehowa adzɔ wò vava kple wò dzodzo ŋuti,</para>
  <para style="q2" vid="PSA 121:8">fifia yi ɖase mavɔmavɔ me.<verse eid="PSA 121:8"/></para>
  <chapter eid="PSA 121"/>
  <chapter number="122" style="c" sid="PSA 122"/>
  <para style="cl">Psalmo 122</para>
  <para style="d">David ƒe mɔzɔha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 122:1"/>Mekpɔ dzidzɔ kple ame siwo gblɔ nam be,</para>
  <para style="q2" vid="PSA 122:1">“Mina míayi Yehowa ƒe aƒe me.”<verse eid="PSA 122:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 122:2"/>O! Yerusalem,</para>
  <para style="q2" vid="PSA 122:2">míaƒe afɔwo le wò agbowo nu.<verse eid="PSA 122:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 122:3"/>Wotso Yerusalem, eye nèle abe du si tsyia ɖe</para>
  <para style="q2" vid="PSA 122:3">wo nɔewo nu ene.<verse eid="PSA 122:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 122:4"/>Afi ma to vovovoawo yina,</para>
  <para style="q2" vid="PSA 122:4">Yehowa ƒe toawo, be woakafu Yehowa,</para>
  <para style="q2" vid="PSA 122:4">le ɖoɖo si wòna Israel nu.<verse eid="PSA 122:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 122:5"/>Afi ma woɖo ʋɔnudrɔ̃zikpuiwo ɖo,</para>
  <para style="q2" vid="PSA 122:5">David ƒe aƒe la ƒe fiazikpuiwo.<verse eid="PSA 122:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 122:6"/>Mido gbe ɖa, abia ŋutifafa na Yerusalem be,</para>
  <para style="q2" vid="PSA 122:6">“Ame siwo lɔ̃ wò la nenɔ dedie.<verse eid="PSA 122:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 122:7"/>Ŋutifafa nenɔ wò gliwo me</para>
  <para style="q2" vid="PSA 122:7">kple dedinɔnɔ le wò fiasãwo me.”<verse eid="PSA 122:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 122:8"/>Le nɔvinye ŋutsuwo kple xɔ̃nyewo ta, magblɔ be,</para>
  <para style="q2" vid="PSA 122:8">“Ŋutifafa nenɔ mewò.”<verse eid="PSA 122:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 122:9"/>Le Yehowa,</para>
  <para style="q2" vid="PSA 122:9">míaƒe Mawu la ƒe aƒe la ta, madi dzidzedze na wò.<verse eid="PSA 122:9"/></para>
  <chapter eid="PSA 122"/>
  <chapter number="123" style="c" sid="PSA 123"/>
  <para style="cl">Psalmo 123</para>
  <para style="d">Mɔzɔha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 123:1"/>Mewu mo dzi na wò,</para>
  <para style="q2" vid="PSA 123:1">wò ame si ƒe fiazikpui le dziƒo.<verse eid="PSA 123:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 123:2"/>Abe ale si kluviwo kpɔa woƒe aƒetɔ ƒe asinu</para>
  <para style="q2" vid="PSA 123:2">kple kosiviwo ƒe ŋku nɔa woƒe aƒenɔ ƒe asinu kpɔmii ene la,</para>
  <para style="q1" vid="PSA 123:2">nenemae míele Yehowa, míaƒe Mawu la</para>
  <para style="q2" vid="PSA 123:2">ƒe asinu kpɔmii, va se ɖe esime wòakpɔ nublanui na mí.<verse eid="PSA 123:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 123:3"/>O! Yehowa, kpɔ nublanui na mí,</para>
  <para style="q2" vid="PSA 123:3">O! Kpɔ míaƒe nublanui,</para>
  <para style="q2" vid="PSA 123:3">elabena míenɔ te ɖe vlododo nu eteƒe didi.<verse eid="PSA 123:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 123:4"/>Míetsɔ dadalawo ƒe alɔmeɖeɖe gbogboawo,</para>
  <para style="q2" vid="PSA 123:4">eye míenɔ te ɖe ɖokuiŋudzelawo</para>
  <para style="q2" vid="PSA 123:4">ƒe vlodoame gbogboawo nu eteƒe didi.<verse eid="PSA 123:4"/></para>
  <chapter eid="PSA 123"/>
  <chapter number="124" style="c" sid="PSA 124"/>
  <para style="cl">Psalmo 124</para>
  <para style="d">David ƒe mɔzɔha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 124:1"/>Ne menye Yehowae le mía dzi o la,</para>
  <para style="q2" vid="PSA 124:1">Israel negblɔ be,<verse eid="PSA 124:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 124:2"/>“Ɖe menye Yehowae le mía dzi o la,</para>
  <para style="q2" vid="PSA 124:2">esi amegbetɔwo tso ɖe mía ŋu,<verse eid="PSA 124:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 124:3"/>eye woƒe dɔmedzoe bi ɖe mía ŋu la,</para>
  <para style="q2" vid="PSA 124:3">anye ne womi mí agbagbee,<verse eid="PSA 124:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 124:4"/>anye ne tsi ɖe mí</para>
  <para style="q2" vid="PSA 124:4">hesi to mía dzi,<verse eid="PSA 124:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 124:5"/>anye ne tɔ dzeagbowo</para>
  <para style="q2" vid="PSA 124:5">kplɔ mí dzoe.”<verse eid="PSA 124:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 124:6"/>Woakafu Yehowa,</para>
  <para style="q2" vid="PSA 124:6">ame si meɖe mɔ be woavuvu mí kple woƒe aɖu o.<verse eid="PSA 124:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 124:7"/>Míesi abe xevi si do le mɔtrela ƒe mɔka me la ene;</para>
  <para style="q2" vid="PSA 124:7">mɔka la tso, eye míesi dzo.<verse eid="PSA 124:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 124:8"/>Míaƒe xɔname le Yehowa,</para>
  <para style="q2" vid="PSA 124:8">dziƒo kple anyigba Wɔla la gbɔ.<verse eid="PSA 124:8"/></para>
  <chapter eid="PSA 124"/>
  <chapter number="125" style="c" sid="PSA 125"/>
  <para style="cl">Psalmo 125</para>
  <para style="d">Mɔzɔha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 125:1"/>Ame siwo ɖoa dzi ɖe Yehowa ŋu la</para>
  <para style="q2" vid="PSA 125:1">le abe Zion to si meʋãna o,</para>
  <para style="q2" vid="PSA 125:1">eye wònɔa anyi ɖikaa la ene.<verse eid="PSA 125:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 125:2"/>Abe ale si towo ƒo xlã Yerusalem ene la,</para>
  <para style="q2" vid="PSA 125:2">nenema Yehowa ƒo xlã eƒe dukɔ lae,</para>
  <para style="q2" vid="PSA 125:2">tso fifia yi ɖe mavɔ me.<verse eid="PSA 125:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 125:3"/>Ame vɔ̃ɖiwo ƒe fiatikplɔ manɔ anyigba si</para>
  <para style="q2" vid="PSA 125:3">woka na ame dzɔdzɔewo la dzi o,</para>
  <para style="q1" vid="PSA 125:3">ne menye nenema o la,</para>
  <para style="q2" vid="PSA 125:3">ame dzɔdzɔewo ava tsɔ woƒe asi awɔ nu vɔ̃ɖii.<verse eid="PSA 125:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 125:4"/>O! Yehowa, wɔ nyui na nu nyui wɔlawo,</para>
  <para style="q2" vid="PSA 125:4">ame siwo ƒe dzi to mɔ ɖeka.<verse eid="PSA 125:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 125:5"/>Ke ame siwo trɔ ɖe mɔ gɔglɔ̃ dzi la,</para>
  <para style="q2" vid="PSA 125:5">Yehowa atsɔ wo aƒu gbe, kpe ɖe nu vɔ̃ɖi wɔlawo ŋu.</para>
  <para style="b" vid="PSA 125:5"/>
  <para style="q1" vid="PSA 125:5">Ŋutifafa nenɔ Israel dzi.<verse eid="PSA 125:5"/></para>
  <chapter eid="PSA 125"/>
  <chapter number="126" style="c" sid="PSA 126"/>
  <para style="cl">Psalmo 126</para>
  <para style="d">Mɔzɔha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 126:1"/>Esi Yehowa kplɔ aboyomeyilawo gbɔe va Zion la,</para>
  <para style="q2" vid="PSA 126:1">míenɔ abe drɔ̃ekulawo ene.<verse eid="PSA 126:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 126:2"/>Nukoko yɔ míaƒe nu me fũu,</para>
  <para style="q2" vid="PSA 126:2">eye dzidzɔhawo yɔ míaƒe aɖewo dzi.</para>
  <para style="q1" vid="PSA 126:2">Tete wogblɔ le dukɔwo dome be,</para>
  <para style="q2" vid="PSA 126:2">“Yehowa wɔ nu gã na wo ameawo.”<verse eid="PSA 126:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 126:3"/>Nyateƒee, Yehowa wɔ nu gãwo na mí,</para>
  <para style="q2" vid="PSA 126:3">eya ta dzidzɔ yɔ mía me.<verse eid="PSA 126:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 126:4"/>O! Yehowa, gaɖo míaƒe nunyonamewo te,</para>
  <para style="q2" vid="PSA 126:4">abe tɔʋu si le Gbegbe ene.<verse eid="PSA 126:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 126:5"/>Ame siwo ƒã nu kple aɖatsi la,</para>
  <para style="q2" vid="PSA 126:5">axa nu kple dzidzɔhawo.<verse eid="PSA 126:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 126:6"/>Ame si do go le nukuwo ƒãm kple aɖatsi la</para>
  <para style="q2" vid="PSA 126:6">atrɔ agbɔ kple dzidzɔhawo, atsɔ lu bablawo agbɔe.<verse eid="PSA 126:6"/></para>
  <chapter eid="PSA 126"/>
  <chapter number="127" style="c" sid="PSA 127"/>
  <para style="cl">Psalmo 127</para>
  <para style="d">Solomo ƒe mɔzɔha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 127:1"/>Ne Yehowa metu xɔ o la,</para>
  <para style="q2" vid="PSA 127:1">etulawo le agbagba dzem dzodzro.</para>
  <para style="q1" vid="PSA 127:1">Ne Yehowa medzɔ du la ŋu o la,</para>
  <para style="q2" vid="PSA 127:1">dzodzroe dua ŋu dzɔlawo le ŋudzɔ.<verse eid="PSA 127:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 127:2"/>Dzodzroe miefɔna kaba le ŋdi,</para>
  <para style="q2" vid="PSA 127:2">henɔa agbagba dzem</para>
  <para style="q1" vid="PSA 127:2">le nu si miaɖu la ŋuti va se ɖe fiẽ,</para>
  <para style="q2" vid="PSA 127:2">ke ame siwo wòlɔ̃na la,</para>
  <para style="q2" vid="PSA 127:2">enana wodɔa alɔ̃ ɖina ɖe eme.<verse eid="PSA 127:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 127:3"/>Viŋutsuwo nye domenyinu tso Yehowa gbɔ,</para>
  <para style="q2" vid="PSA 127:3">eye viwo nye fetu tso eya amea gbɔ.<verse eid="PSA 127:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 127:4"/>Viŋutsu siwo ame aɖe dzi le eƒe ɖekakpuime la,</para>
  <para style="q2" vid="PSA 127:4">le abe aŋutrɔ le kalẽtɔ si ene.<verse eid="PSA 127:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 127:5"/>Woayra ŋutsu si ƒe daku me wole fũu.</para>
  <para style="q2" vid="PSA 127:5">Ŋu makpe wo o,</para>
  <para style="q2" vid="PSA 127:5">ne woawo kple futɔwo wɔ avu le agbo la me.<verse eid="PSA 127:5"/></para>
  <chapter eid="PSA 127"/>
  <chapter number="128" style="c" sid="PSA 128"/>
  <para style="cl">Psalmo 128</para>
  <para style="d">Mɔzɔha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 128:1"/>Woayra ame siwo vɔ̃a Yehowa,</para>
  <para style="q2" vid="PSA 128:1">ame siwo zɔna le eƒe mɔwo dzi.<verse eid="PSA 128:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 128:2"/>Àɖu wò ŋutɔ wò dɔwɔwɔ ƒe kutsetse,</para>
  <para style="q2" vid="PSA 128:2">eye yayra kple dzidzedze anye tɔwò gome.<verse eid="PSA 128:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 128:3"/>Srɔ̃wò anɔ abe wainka si tse kplanyaa la ene anɔ aƒewò me;</para>
  <para style="q2" vid="PSA 128:3">viwò ŋutsuwo anɔ abe amitiɖɔmi ene le wò kplɔ̃ ŋu godoo.<verse eid="PSA 128:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 128:4"/>Kpɔ ɖa, aleae woyraa</para>
  <para style="q2" vid="PSA 128:4">ŋutsu si vɔ̃a Yehowa lae.<verse eid="PSA 128:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 128:5"/>Yehowa neyra wò tso Zion le wò agbemeŋkekewo katã me,</para>
  <para style="q2" vid="PSA 128:5">eye àkpɔ Yerusalem ƒe dzidzedze.<verse eid="PSA 128:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 128:6"/>Ànɔ agbe akpɔ viwòwo ƒe viwo.</para>
  <para style="q2" vid="PSA 128:6">Ŋutifafa nenɔ Israel dzi.<verse eid="PSA 128:6"/></para>
  <chapter eid="PSA 128"/>
  <chapter number="129" style="c" sid="PSA 129"/>
  <para style="cl">Psalmo 129</para>
  <para style="d">Mɔzɔha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 129:1"/>Wotem ɖe anyi ale gbegbe tso nye ɖekakpuime ke.</para>
  <para style="q2" vid="PSA 129:1">Israel negblɔ be,<verse eid="PSA 129:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 129:2"/>“Wotem ɖe anyi ale gbegbe tso nye ɖekakpuime ke,</para>
  <para style="q2" vid="PSA 129:2">gake womeɖu dzinye o.<verse eid="PSA 129:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 129:3"/>Agbleŋlɔlawo ŋlɔ nye dzimegbe,</para>
  <para style="q2" vid="PSA 129:3">eye woɖe boliƒowo wodidi,<verse eid="PSA 129:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 129:4"/>gake Yehowa nye dzɔdzɔetɔ,</para>
  <para style="q2" vid="PSA 129:4">etso kam tso ame vɔ̃ɖiwo ƒe babla me.”<verse eid="PSA 129:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 129:5"/>Na be ame siwo katã tsri Zion la,</para>
  <para style="q2" vid="PSA 129:5">nagbugbɔ ɖe megbe kple ŋukpe.<verse eid="PSA 129:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 129:6"/>Na be woanɔ abe gbe si wotsɔ gbã xɔe ene,</para>
  <para style="q2" vid="PSA 129:6">gbe si yrɔna, hafi ayi miemie ge.<verse eid="PSA 129:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 129:7"/>Ale gbetsola mate ŋu atsoe alɔ ɖe asime loo,</para>
  <para style="q2" vid="PSA 129:7">alo ame si le elɔm la, nayi elɔ ge ɖe abɔdome o.<verse eid="PSA 129:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 129:8"/>Ame siwo to afi ma yi la megagblɔ be,</para>
  <para style="q2" vid="PSA 129:8">“Yehowa ƒe yayra nenɔ dziwò;</para>
  <para style="q2" vid="PSA 129:8">míeyra wò le Yehowa ƒe ŋkɔ me” o.<verse eid="PSA 129:8"/></para>
  <chapter eid="PSA 129"/>
  <chapter number="130" style="c" sid="PSA 130"/>
  <para style="cl">Psalmo 130</para>
  <para style="d">Mɔzɔha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 130:1"/>O! Yehowa, mele koko ƒom na wò tso nye dzi me ke.<verse eid="PSA 130:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 130:2"/>O! Aƒetɔ, ɖo to nye gbe.</para>
  <para style="q2" vid="PSA 130:2">Wò to nenɔ te nàse nye nublanuiɣli.<verse eid="PSA 130:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 130:3"/>O! Yehowa, ne àlé amewo</para>
  <para style="q2" vid="PSA 130:3">ƒe nu vɔ̃wo ɖe agbalẽ me ada ɖi la,</para>
  <para style="q2" vid="PSA 130:3">O! Aƒetɔ, ame ka ate ŋu anɔ te?<verse eid="PSA 130:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 130:4"/>Ke wò la, tsɔtsɔke le gbɔwò,</para>
  <para style="q2" vid="PSA 130:4">eya ta wovɔ̃a wò ɖo.<verse eid="PSA 130:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 130:5"/>Mele Yehowa ƒe asinu kpɔm,</para>
  <para style="q2" vid="PSA 130:5">nye luʋɔ le lalam,</para>
  <para style="q2" vid="PSA 130:5">eye metsɔ nye mɔkpɔkpɔ da ɖe eƒe nya dzi.<verse eid="PSA 130:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 130:6"/>Nye luʋɔ le lalam na Aƒetɔ la wu</para>
  <para style="q2" vid="PSA 130:6">ale si zãɖialawo kpɔa mɔ na ŋu ƒe keke;</para>
  <para style="q2" vid="PSA 130:6">mebe wu ale si zãɖialawo kpɔa mɔ na ŋu ƒe keke.<verse eid="PSA 130:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 130:7"/>O! Israel, tsɔ wò mɔkpɔkpɔ da ɖe Yehowa dzi,</para>
  <para style="q2" vid="PSA 130:7">elabena lɔlɔ̃ matrɔ le Yehowa si,</para>
  <para style="q2" vid="PSA 130:7">eye ɖeɖe blibo le eya amea gbɔ.<verse eid="PSA 130:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 130:8"/>Eya ŋutɔ aɖe Israel</para>
  <para style="q2" vid="PSA 130:8">tso eƒe nu vɔ̃wo katã me.<verse eid="PSA 130:8"/></para>
  <chapter eid="PSA 130"/>
  <chapter number="131" style="c" sid="PSA 131"/>
  <para style="cl">Psalmo 131</para>
  <para style="d">David ƒe Mɔzɔha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 131:1"/>O! Yehowa, dada mele nye dzi me o,</para>
  <para style="q2" vid="PSA 131:1">eye ŋku gã hã mele tanye o.</para>
  <para style="q1" vid="PSA 131:1">Nyemetsɔa ɖeke le nya gãwo me loo,</para>
  <para style="q2" vid="PSA 131:1">alo ƒoa ta ɖe nu siwo wɔ nuku nam akpa la me o,<verse eid="PSA 131:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 131:2"/>gake mena nye luʋɔ zi ɖoɖoe,</para>
  <para style="q2" vid="PSA 131:2">heli kpoo abe ale si ɖevi si ɖi no la nɔa dadaa ƒe akɔnu ene,</para>
  <para style="q2" vid="PSA 131:2">eye nye luʋɔ le abe ɖevi si ɖi no la ene.<verse eid="PSA 131:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 131:3"/>O! Israel, tsɔ wò mɔkpɔkpɔ da ɖe Yehowa dzi,</para>
  <para style="q2" vid="PSA 131:3">tso fifia yi ɖase ɖe mavɔmavɔ me ke.<verse eid="PSA 131:3"/></para>
  <chapter eid="PSA 131"/>
  <chapter number="132" style="c" sid="PSA 132"/>
  <para style="cl">Psalmo 132</para>
  <para style="d">Mɔzɔha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 132:1"/>O! Yehowa, ɖo ŋku David</para>
  <para style="q2" vid="PSA 132:1">kple fukpekpe siwo katã me wòto la dzi.<verse eid="PSA 132:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 132:2"/>Eka atam na Yehowa, eye wòɖe adzɔgbe</para>
  <para style="q2" vid="PSA 132:2">na Yakob ƒe Ŋusẽtɔ la be,<verse eid="PSA 132:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 132:3"/>“Nyemage ɖe aƒenye me,</para>
  <para style="q2" vid="PSA 132:3">alo aɖamlɔ nye aba dzi o.<verse eid="PSA 132:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 132:4"/>Nyemana nye ŋkuwo nadɔ alɔ̃,</para>
  <para style="q2" vid="PSA 132:4">alo nye aɖaba nadɔ akɔlɔ̃e o,<verse eid="PSA 132:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 132:5"/>va se ɖe esime mekpɔ teƒe na Yehowa</para>
  <para style="q2" vid="PSA 132:5">kple nɔƒe na Yakob ƒe ŋusẽtɔ la.”<verse eid="PSA 132:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 132:6"/>Míesee le Efrata, eye míedo goe le Yaar gbegbe be,<verse eid="PSA 132:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 132:7"/>“Mina míayi ɖe enɔƒe,</para>
  <para style="q2" vid="PSA 132:7">mina míade ta agu ɖe eƒe afɔɖodzinu ŋgɔ.<verse eid="PSA 132:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 132:8"/>O! Yehowa, tso, ne nàva wò gbɔɖemeƒe,</para>
  <para style="q2" vid="PSA 132:8">wò kple wò ŋusẽ ƒe nubablaɖaka la gbɔ.<verse eid="PSA 132:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 132:9"/>Wò nunɔlawo nedo dzɔdzɔenyenye ƒe awu,</para>
  <para style="q2" vid="PSA 132:9">eye wò ame kɔkɔewo nedzi ha le dzidzɔkpɔkpɔ ta.”<verse eid="PSA 132:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 132:10"/>Le David, wò dɔla ta la,</para>
  <para style="q2" vid="PSA 132:10">mègagbe wò amesiamina la o.<verse eid="PSA 132:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 132:11"/>Yehowa ka atam na David;</para>
  <para style="q2" vid="PSA 132:11">eka atam vavã si matu o la be,</para>
  <para style="q1" vid="PSA 132:11">“Matsɔ wò ŋutɔ wò dzidzimevi aɖo fiae ɖe wò fiazikpui dzi.<verse eid="PSA 132:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 132:12"/>Nenema ke ne viwò ŋutsuwo lé nye nubabla</para>
  <para style="q2" vid="PSA 132:12">kple nye se siwo mefia wo me ɖe asi la,</para>
  <para style="q1" vid="PSA 132:12">ekema wo viwo anɔ wò fiazikpui dzi tso</para>
  <para style="q2" vid="PSA 132:12">mavɔ me yi ɖe mavɔ me.”<verse eid="PSA 132:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 132:13"/>Elabena Yehowa tia Zion,</para>
  <para style="q2" vid="PSA 132:13">eye wòtiae be wòanye ye nɔƒe be,<verse eid="PSA 132:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 132:14"/>“Esia nye nye gbɔɖemeƒe tso</para>
  <para style="q2" vid="PSA 132:14">mavɔ me yi ɖe mavɔ me,</para>
  <para style="q1" vid="PSA 132:14">afi siae manɔ fiazikpui dzi le gli,</para>
  <para style="q2" vid="PSA 132:14">elabena nye ŋutɔe tiae.”<verse eid="PSA 132:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 132:15"/>Matsɔ nu nyui geɖewo ayrae,</para>
  <para style="q2" vid="PSA 132:15">eye matsɔ nuɖuɖu aɖi ƒoe na eƒe ame dahewo.<verse eid="PSA 132:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 132:16"/>Mado xɔxɔ ƒe awu na eƒe nunɔlawo,</para>
  <para style="q2" vid="PSA 132:16">eye eƒe ame kɔkɔewo adzi ha le dzidzɔkpɔkpɔ ta tegbetegbe.<verse eid="PSA 132:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 132:17"/>“Le afi sia, mana dzo nado na David,</para>
  <para style="q2" vid="PSA 132:17">eye masi akaɖi aɖo anyi na nye amesiamina la.<verse eid="PSA 132:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 132:18"/>Matsɔ ŋukpe ado na eƒe futɔwo,</para>
  <para style="q2" vid="PSA 132:18">ke fiakuku si anɔ eƒe ta la, anɔ keklẽm.”<verse eid="PSA 132:18"/></para>
  <chapter eid="PSA 132"/>
  <chapter number="133" style="c" sid="PSA 133"/>
  <para style="cl">Psalmo 133</para>
  <para style="d">David ƒe Mɔzɔha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 133:1"/>Aleke wohenyo, eye wòvivinae,</para>
  <para style="q2" vid="PSA 133:1">ne nɔviwo nɔ teƒe ɖeka le ɖekawɔwɔ me!<verse eid="PSA 133:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 133:2"/>Ele abe ami xɔasi si wokɔ ɖe ta me,</para>
  <para style="q2" vid="PSA 133:2">eye wòtsra va kɔ ɖe ge me ene,</para>
  <para style="q1" vid="PSA 133:2">ɛ̃, etsra kɔ ɖe Aron ƒe ge me hetsyɔ ɖe</para>
  <para style="q2" vid="PSA 133:2">eƒe awu ƒe kɔme.<verse eid="PSA 133:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 133:3"/>Ele abe Hermon zãmue</para>
  <para style="q2" vid="PSA 133:3">le dzadzam ɖe Zion to dzi ene,</para>
  <para style="q1" vid="PSA 133:3">elabena afi mae Yehowa kɔ yayra</para>
  <para style="q2" vid="PSA 133:3">kple agbe gɔ̃ hã ɖo tegbetegbe.<verse eid="PSA 133:3"/></para>
  <chapter eid="PSA 133"/>
  <chapter number="134" style="c" sid="PSA 134"/>
  <para style="cl">Psalmo 134</para>
  <para style="d">Mɔzɔha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 134:1"/>Mikafu Yehowa, mi eƒe dɔlawo katã,</para>
  <para style="q2" vid="PSA 134:1">mi ame siwo subɔna</para>
  <para style="q2" vid="PSA 134:1">le Yehowa ƒe aƒe me le zã me.<verse eid="PSA 134:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 134:2"/>Mido miaƒe asiwo ɖe dzi</para>
  <para style="q2" vid="PSA 134:2">le kɔkɔeƒe la me, eye mikafu Yehowa.<verse eid="PSA 134:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 134:3"/>Yehowa, dziƒo kple anyigba Wɔla,</para>
  <para style="q2" vid="PSA 134:3">neyra mi tso Zion.<verse eid="PSA 134:3"/></para>
  <chapter eid="PSA 134"/>
  <chapter number="135" style="c" sid="PSA 135"/>
  <para style="cl">Psalmo 135</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 135:1"/>Mikafu Yehowa.</para>
  <para style="b" vid="PSA 135:1"/>
  <para style="q1" vid="PSA 135:1">Mikafu Yehowa ƒe ŋkɔ,</para>
  <para style="q2" vid="PSA 135:1">mikafui, mi Yehowa ƒe dɔlawo.<verse eid="PSA 135:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 135:2"/>Mi ame siwo subɔna le Yehowa ƒe aƒe me,</para>
  <para style="q2" vid="PSA 135:2">le míaƒe Mawu la ƒe xɔxɔnuwo.<verse eid="PSA 135:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 135:3"/>Mikafu Yehowa,</para>
  <para style="q2" vid="PSA 135:3">elabena Yehowa nyo;</para>
  <para style="q1" vid="PSA 135:3">midzi ha na eƒe ŋkɔ,</para>
  <para style="q2" vid="PSA 135:3">elabena esia vivina.<verse eid="PSA 135:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 135:4"/>Elabena Yehowa tia Yakob be wòanye ye tɔ,</para>
  <para style="q2" vid="PSA 135:4">eye wòtia Israel be wòanye yeƒe domenyinu xɔasi la.<verse eid="PSA 135:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 135:5"/>Menya be Yehowa lolo,</para>
  <para style="q2" vid="PSA 135:5">eye míaƒe Aƒetɔ la lolo wu mawuwo katã.<verse eid="PSA 135:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 135:6"/>Yehowa wɔa nu sia nu si dze eŋu</para>
  <para style="q2" vid="PSA 135:6">le dziƒo kple anyigba,</para>
  <para style="q2" vid="PSA 135:6">le atsiaƒuwo me kple woƒe gogloƒewo katã.<verse eid="PSA 135:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 135:7"/>Enaa lilikpo hona tso anyigba ƒe mlɔenu ke,</para>
  <para style="q2" vid="PSA 135:7">edɔa dzikedzo be wòava kple tsidzadza,</para>
  <para style="q2" vid="PSA 135:7">eye wòɖea yaƒoƒo ɖe go tso eƒe nudzraɖoƒewo.<verse eid="PSA 135:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 135:8"/>Eƒo Egipte ƒe ŋgɔgbeviwo ƒu anyi;</para>
  <para style="q2" vid="PSA 135:8">amegbetɔwo kple lãwo siaa ƒe ŋgɔgbeviwo.<verse eid="PSA 135:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 135:9"/>O! Egipte, edɔ eƒe dzesiwo</para>
  <para style="q2" vid="PSA 135:9">kple nukunuwo ɖo ɖe mía dome,</para>
  <para style="q2" vid="PSA 135:9">ɖe Farao kple eƒe dɔlawo katã ŋu.<verse eid="PSA 135:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 135:10"/>Eƒo dukɔ geɖewo ƒu anyi,</para>
  <para style="q2" vid="PSA 135:10">eye wòwu fia sesẽwo.<verse eid="PSA 135:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 135:11"/>Ewu Sixɔn, Amoritɔwo ƒe fia,</para>
  <para style="q2" vid="PSA 135:11">Ɔg, Basantɔwo ƒe fia</para>
  <para style="q2" vid="PSA 135:11">kple Kanaan fiawo katã,<verse eid="PSA 135:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 135:12"/>eye wòtsɔ woƒe anyigba wɔ domenyinu,</para>
  <para style="q2" vid="PSA 135:12">na eƒe dukɔ Israel.<verse eid="PSA 135:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 135:13"/>O! Yehowa, wò ŋkɔ li tegbetegbe,</para>
  <para style="q2" vid="PSA 135:13">o Yehowa, èxɔ ŋkɔ le dzidzimewo katã me.<verse eid="PSA 135:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 135:14"/>Elabena Yehowa atso afia na eƒe dukɔ,</para>
  <para style="q2" vid="PSA 135:14">eye wòakpɔ nublanui na eƒe dɔlawo.<verse eid="PSA 135:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 135:15"/>Dukɔwo ƒe legbawo nye klosalo kple sika,</para>
  <para style="q2" vid="PSA 135:15">amegbetɔ ƒe asinudɔwɔwɔwo wonye.<verse eid="PSA 135:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 135:16"/>Nu li na wo, gake womeƒoa nu o, ŋku li na wo</para>
  <para style="q2" vid="PSA 135:16">gake womekpɔa nu o,<verse eid="PSA 135:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 135:17"/>to li na wo, gake womesea nu loo,</para>
  <para style="q2" vid="PSA 135:17">alo gbɔna to woƒe nu me o.<verse eid="PSA 135:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 135:18"/>Ame siwo wɔ wo la anɔ abe woawo ke ene,</para>
  <para style="q2" vid="PSA 135:18">eye nenema kee nye ame siwo katã ɖoa dzi ɖe wo ŋu.<verse eid="PSA 135:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 135:19"/>O! Israel ƒe aƒe, mikafu Yehowa,</para>
  <para style="q2" vid="PSA 135:19">O! Aron ƒe aƒe, mikafu Yehowa,<verse eid="PSA 135:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 135:20"/>O! Levi ƒe aƒe, mikafu Yehowa,</para>
  <para style="q2" vid="PSA 135:20">eye mi ame siwo vɔ̃nɛ la, mikafu Yehowa.<verse eid="PSA 135:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 135:21"/>Woakafu Yehowa tso Zion,</para>
  <para style="q2" vid="PSA 135:21">eya ame si nɔ Yerusalem.</para>
  <para style="b" vid="PSA 135:21"/>
  <para style="q1" vid="PSA 135:21">Mikafu Yehowa!<verse eid="PSA 135:21"/></para>
  <chapter eid="PSA 135"/>
  <chapter number="136" style="c" sid="PSA 136"/>
  <para style="cl">Psalmo 136</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 136:1"/>Mida akpe na Yehowa, elabena enyo.</para>
  <para style="qr" vid="PSA 136:1">Eƒe lɔlɔ̃ li ɖaa.<verse eid="PSA 136:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 136:2"/>Mida akpe na mawuwo dzi Mawu la,</para>
  <para style="qr" vid="PSA 136:2">Elabena eƒe lɔlɔ̃ li ɖaa.<verse eid="PSA 136:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 136:3"/>Mida akpe na aƒetɔwo dzi Aƒetɔ la,</para>
  <para style="qr" vid="PSA 136:3">Elabena eƒe lɔlɔ̃ li ɖaa.<verse eid="PSA 136:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 136:4"/>Eya ɖeka hɔ̃ɔ koe wɔa nukunu dzɔatsuwo,</para>
  <para style="qr" vid="PSA 136:4">Elabena eƒe lɔlɔ̃ li ɖaa.<verse eid="PSA 136:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 136:5"/>Eya ame si tsɔ eƒe nugɔmesese wɔ dziƒowoe,</para>
  <para style="qr" vid="PSA 136:5">Elabena eƒe lɔlɔ̃ li ɖaa.<verse eid="PSA 136:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 136:6"/>Ame si keke anyigba ɖe tsiwo dzi,</para>
  <para style="qr" vid="PSA 136:6">Elabena eƒe lɔlɔ̃ li ɖaa.<verse eid="PSA 136:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 136:7"/>Ame si wɔ nu keklẽ gãwo,</para>
  <para style="qr" vid="PSA 136:7">Elabena eƒe lɔlɔ̃ li ɖaa.<verse eid="PSA 136:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 136:8"/>Be ɣe naɖu ŋkeke dzi,</para>
  <para style="qr" vid="PSA 136:8">Elabena eƒe lɔlɔ̃ li ɖaa.<verse eid="PSA 136:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 136:9"/>Be ɣleti kple ɣletiviwo naɖu zã dzi,</para>
  <para style="qr" vid="PSA 136:9">Elabena eƒe lɔlɔ̃ li ɖaa.<verse eid="PSA 136:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 136:10"/>Eya ame si ƒo Egiptetɔwo ƒe ŋgɔgbeviwo ƒu anyi,</para>
  <para style="qr" vid="PSA 136:10">Elabena eƒe lɔlɔ̃ li ɖaa.<verse eid="PSA 136:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 136:11"/>Eye wòkplɔ Israel do goe le wo dome,</para>
  <para style="qr" vid="PSA 136:11">Elabena eƒe lɔlɔ̃ li ɖaa.<verse eid="PSA 136:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 136:12"/>Kple asi sesẽ kple abɔ si wòdo ɖe dzi,</para>
  <para style="qr" vid="PSA 136:12">Elabena eƒe lɔlɔ̃ li ɖaa.<verse eid="PSA 136:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 136:13"/>Eya ame si ma Ƒu Dzĩ la ɖe eve,</para>
  <para style="qr" vid="PSA 136:13">Elabena eƒe lɔlɔ̃ li ɖaa.<verse eid="PSA 136:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 136:14"/>Eye wòkplɔ Israel to eƒe titina,</para>
  <para style="qr" vid="PSA 136:14">Elabena eƒe lɔlɔ̃ li ɖaa.<verse eid="PSA 136:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 136:15"/>Ke ekplɔ Farao kple eƒe aʋakɔ la de Ƒu Dzĩ la me,</para>
  <para style="qr" vid="PSA 136:15">Elabena eƒe lɔlɔ̃ li ɖaa.<verse eid="PSA 136:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 136:16"/>Eya ame si kplɔ eƒe dukɔ la to gbedzi,</para>
  <para style="qr" vid="PSA 136:16">Elabena eƒe lɔlɔ̃ li ɖaa.<verse eid="PSA 136:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 136:17"/>Ame si ƒo fia gãwo ƒu anyi,</para>
  <para style="qr" vid="PSA 136:17">Elabena eƒe lɔlɔ̃ li ɖaa.<verse eid="PSA 136:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 136:18"/>Eye wòwu fia sesẽwo,</para>
  <para style="qr" vid="PSA 136:18">Elabena eƒe lɔlɔ̃ li ɖaa.<verse eid="PSA 136:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 136:19"/>Sixɔn, Amoritɔwo ƒe fia,</para>
  <para style="qr" vid="PSA 136:19">Elabena eƒe lɔlɔ̃ li ɖaa<verse eid="PSA 136:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 136:20"/>kple Ɔg, Basantɔwo ƒe fia,</para>
  <para style="qr" vid="PSA 136:20">Elabena eƒe lɔlɔ̃ li ɖaa.<verse eid="PSA 136:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 136:21"/>Eye wòtsɔ woƒe anyigba wɔ domenyinu,</para>
  <para style="qr" vid="PSA 136:21">Elabena eƒe lɔlɔ̃ li ɖaa.<verse eid="PSA 136:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 136:22"/>Domenyinu na eƒe dɔla, Israel,</para>
  <para style="qr" vid="PSA 136:22">Elabena eƒe lɔlɔ̃ li ɖaa.<verse eid="PSA 136:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 136:23"/>Eya ame si ɖo ŋku mía dzi,</para>
  <para style="q2" vid="PSA 136:23">esime wobɔbɔ mí ɖe anyi,</para>
  <para style="qr" vid="PSA 136:23">Elabena eƒe lɔlɔ̃ li ɖaa.<verse eid="PSA 136:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 136:24"/>Eye wòɖe mí tso míaƒe futɔwo ƒe asi me,</para>
  <para style="qr" vid="PSA 136:24">elabena eƒe lɔlɔ̃ li ɖaa.<verse eid="PSA 136:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 136:25"/>Eya ame si naa nuɖuɖu nu gbagbe ɖe sia ɖe,</para>
  <para style="qr" vid="PSA 136:25">Elabena eƒe lɔlɔ̃ li ɖaa.<verse eid="PSA 136:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 136:26"/>Mida akpe na Dziƒo Mawu la,</para>
  <para style="qr" vid="PSA 136:26">Elabena eƒe lɔlɔ̃ li ɖaa.<verse eid="PSA 136:26"/></para>
  <chapter eid="PSA 136"/>
  <chapter number="137" style="c" sid="PSA 137"/>
  <para style="cl">Psalmo 137</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 137:1"/>Babilonia tɔsisiwo toe míenɔ,</para>
  <para style="q2" vid="PSA 137:1">hɛnɔ avi fam,</para>
  <para style="q2" vid="PSA 137:1">esi míeɖo ŋku Zion dzi.<verse eid="PSA 137:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 137:2"/>Míetsɔ míaƒe kasaŋkuwo ku</para>
  <para style="q2" vid="PSA 137:2">amuti siwo le afi ma,<verse eid="PSA 137:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 137:3"/>elabena afi mae ame siwo ɖe</para>
  <para style="q2" vid="PSA 137:3">aboyo mí la bia ha tso mía si le;</para>
  <para style="q1" vid="PSA 137:3">ame siwo wɔ fu mí la bia</para>
  <para style="q2" vid="PSA 137:3">dzidzɔhawo tso mía si hegblɔ be,</para>
  <para style="q2" vid="PSA 137:3">“Midzi Zion hawo dometɔ ɖeka na mí!”<verse eid="PSA 137:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 137:4"/>Aleke miadzi Yehowa ƒe hawo</para>
  <para style="q2" vid="PSA 137:4">le dzronyigba dzi?<verse eid="PSA 137:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 137:5"/>O! Yerusalem, ne meŋlɔ wò be la,</para>
  <para style="q2" vid="PSA 137:5">nye nuɖusibɔ nèŋlɔ eƒe ŋusẽ be,<verse eid="PSA 137:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 137:6"/>eye nye aɖe nelé ɖe nye nu me,</para>
  <para style="q2" vid="PSA 137:6">ne nyemeɖo ŋku dziwò o,</para>
  <para style="q1" vid="PSA 137:6">ne nyemebu Yerusalem,</para>
  <para style="q2" vid="PSA 137:6">nye dzidzɔ kɔkɔtɔ kekeake o.<verse eid="PSA 137:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 137:7"/>O! Yehowa, ɖo ŋku nu si Edomtɔwo wɔ la dzi,</para>
  <para style="q2" vid="PSA 137:7">gbe si gbe wogbã Yerusalem.</para>
  <para style="q1" vid="PSA 137:7">Wodo ɣli be, “Mimui ƒu anyi,</para>
  <para style="q2" vid="PSA 137:7">migbãe, va se ɖe eƒe gɔmeɖokpewo dzi ke!”<verse eid="PSA 137:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 137:8"/>O! Babilonia vinyɔnu,</para>
  <para style="q2" vid="PSA 137:8">woɖo wò ɖi na tsɔtsrɔ̃,</para>
  <para style="q1" vid="PSA 137:8">woayra ame si aɖo nu si nèwɔ</para>
  <para style="q2" vid="PSA 137:8">mí la teƒe na wò,<verse eid="PSA 137:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 137:9"/>ame si alé wò vidzĩwo</para>
  <para style="q2" vid="PSA 137:9">axlã ɖe agakpewo.<verse eid="PSA 137:9"/></para>
  <chapter eid="PSA 137"/>
  <chapter number="138" style="c" sid="PSA 138"/>
  <para style="cl">Psalmo 138</para>
  <para style="d">David ƒe ha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 138:1"/>O! Yehowa, makafu wò kple nye dzi blibo;</para>
  <para style="q2" vid="PSA 138:1">madzi wò kafukafuha le mawuwo ŋkume.<verse eid="PSA 138:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 138:2"/>Made ta agu do ɖe wò gbedoxɔ kɔkɔe la gbɔ,</para>
  <para style="q2" vid="PSA 138:2">eye makafu wò ŋkɔ,</para>
  <para style="q1" vid="PSA 138:2">le wò lɔlɔ̃ kple nuteƒewɔwɔ ta,</para>
  <para style="q2" vid="PSA 138:2">elabena èkɔ, wò ŋkɔ kple wò nya</para>
  <para style="q2" vid="PSA 138:2">gbɔ nu sia nu ta sãsãsã.<verse eid="PSA 138:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 138:3"/>Ètɔ nam esi meyɔ wò, eye nède dzi ƒo nam,</para>
  <para style="q2" vid="PSA 138:3">hedo ŋusẽ nye dzi.<verse eid="PSA 138:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 138:4"/>O! Yehowa, anyigbadzifiawo katã akafu wò,</para>
  <para style="q2" vid="PSA 138:4">ne wose wò numenya.<verse eid="PSA 138:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 138:5"/>Na woadzi ha le Yehowa ƒe mɔwo ŋu,</para>
  <para style="q2" vid="PSA 138:5">elabena Yehowa ƒe ŋutikɔkɔe lolo.<verse eid="PSA 138:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 138:6"/>Togbɔ be Yehowa le dzi me ke hã la, ekpɔa ame dahewo gbɔ,</para>
  <para style="q2" vid="PSA 138:6">ke edzea si dadala tso adzɔge.<verse eid="PSA 138:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 138:7"/>Togbɔ be mele zɔzɔm le xaxa me hã la,</para>
  <para style="q2" vid="PSA 138:7">èkpɔ nye agbe ta, eye nèkɔ wò asi dzi do ɖe</para>
  <para style="q1" vid="PSA 138:7">nye futɔwo ƒe dɔmedzoe ŋu,</para>
  <para style="q2" vid="PSA 138:7">hetsɔ wò nuɖusi xɔ nam.<verse eid="PSA 138:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 138:8"/>Yehowa ana eƒe ta me si wòɖo ɖe ŋunye la nava eme.</para>
  <para style="q2" vid="PSA 138:8">O! Yehowa, wò lɔlɔ̃ li ɖaa,</para>
  <para style="q2" vid="PSA 138:8">mègagblẽ wò asinudɔwɔwɔwo ɖi o.<verse eid="PSA 138:8"/></para>
  <chapter eid="PSA 138"/>
  <chapter number="139" style="c" sid="PSA 139"/>
  <para style="cl">Psalmo 139</para>
  <para style="d">David ƒe ha na hɛnɔ la.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 139:1"/>O! Yehowa, èdzro menye, eye nènyam.<verse eid="PSA 139:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 139:2"/>Ènya nye anyinɔnɔ kple nye tsitretsitsi,</para>
  <para style="q2" vid="PSA 139:2">eye nènya nye susuwo tso adzɔge ke.<verse eid="PSA 139:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 139:3"/>Ènya nye godoɣi kple nye anyimlɔɣi,</para>
  <para style="q2" vid="PSA 139:3">ale nènya nye mɔwo katã nyuie.<verse eid="PSA 139:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 139:4"/>O! Yehowa, hafi nya aɖe nava nye aɖe dzi la,</para>
  <para style="q2" vid="PSA 139:4">ènya nya la katã xoxo.<verse eid="PSA 139:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 139:5"/>Ètsɔm ɖe tome,</para>
  <para style="q2" vid="PSA 139:5">le megbe kple ŋgɔ siaa, eye nèɖo wò asi dzinye.<verse eid="PSA 139:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 139:6"/>Nunya sia wɔ nuku nam akpa,</para>
  <para style="q2" vid="PSA 139:6">nyemate ŋu aɖo afi ma o,</para>
  <para style="q2" vid="PSA 139:6">elabena ekɔkɔ nam akpa.<verse eid="PSA 139:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 139:7"/>Afi ka madzo le wò Gbɔgbɔ la gbɔ ayi?</para>
  <para style="q2" vid="PSA 139:7">Afi ka masi atso wò ŋkume ayi?<verse eid="PSA 139:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 139:8"/>Ne meyi dziƒo la, èle afi ma,</para>
  <para style="q2" vid="PSA 139:8">ne meɖo nye mlɔƒe ɖe gogloƒewo hã la, èle afi ma.<verse eid="PSA 139:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 139:9"/>Ne medzo yi yame le fɔŋli ƒe aʋalawo dzi,</para>
  <para style="q2" vid="PSA 139:9">ne meyi ɖanɔ atsiaƒu ƒe mlɔenu ke hã la,<verse eid="PSA 139:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 139:10"/>wò asi akplɔm,</para>
  <para style="q2" vid="PSA 139:10">eye wò nuɖusi além ɖe asi sesĩe.<verse eid="PSA 139:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 139:11"/>Ne megblɔ be, “Vavã, viviti la ana maɣla,</para>
  <para style="q2" vid="PSA 139:11">eye kekeli azu zã aƒo xlãm” la,<verse eid="PSA 139:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 139:12"/>viviti la gɔ̃ hã mado blukɔ na wò o,</para>
  <para style="q2" vid="PSA 139:12">zã aklẽ na wò abe ŋkeke ene,</para>
  <para style="q2" vid="PSA 139:12">elabena viviti le na wò abe kekeli ene.<verse eid="PSA 139:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 139:13"/>Elabena wòe wɔ nye ememe ke;</para>
  <para style="q2" vid="PSA 139:13">eye nèlém ƒo ƒu ɖe danye ƒe dɔ me.<verse eid="PSA 139:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 139:14"/>Mekafu wò, elabena èwɔm ŋɔdzitɔe kple nukutɔe.</para>
  <para style="q2" vid="PSA 139:14">Wò dɔwɔwɔwo nye nukunu,</para>
  <para style="q2" vid="PSA 139:14">menya esia nyuie.<verse eid="PSA 139:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 139:15"/>Nye ameti blibo la, mele ɣaɣla ɖe wò o,</para>
  <para style="q2" vid="PSA 139:15">esi nèwɔm le ɣaɣlaƒe.</para>
  <para style="q1" vid="PSA 139:15">Esi wolɔ̃m ɖe wo nɔewo me</para>
  <para style="q2" vid="PSA 139:15">le anyigba ƒe gogloƒe la,<verse eid="PSA 139:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 139:16"/>wò ŋkuwo kpɔ ale si menye ʋukɔe.</para>
  <para style="q2" vid="PSA 139:16">Ŋkeke siwo katã woɖo nam la,</para>
  <para style="q1" vid="PSA 139:16">woŋlɔ wo ɖe wò agbalẽ me</para>
  <para style="q2" vid="PSA 139:16">hafi ŋkeke gbãtɔ dze egɔme.<verse eid="PSA 139:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 139:17"/>O! Mawu, wò susuwo xɔ asi nam ŋutɔ!</para>
  <para style="q2" vid="PSA 139:17">Wò susuwo sɔ gbɔ loo!<verse eid="PSA 139:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 139:18"/>Ne mebe maxlẽ wo la,</para>
  <para style="q2" vid="PSA 139:18">woasɔ gbɔ wu ke.</para>
  <para style="q1" vid="PSA 139:18">Ne menyɔ tso alɔ̃ me la,</para>
  <para style="q2" vid="PSA 139:18">megale gbɔwò ko.<verse eid="PSA 139:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 139:19"/>O! Mawu, negbe ɖe nàtsrɔ̃ ame vɔ̃ɖiwo hafi!</para>
  <para style="q2" vid="PSA 139:19">Mite ɖa le gbɔnye, mi hlɔ̃dolawo!<verse eid="PSA 139:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 139:20"/>Woƒoa nu tso ŋutiwò kple susu baɖa,</para>
  <para style="q2" vid="PSA 139:20">wò futɔwo wɔa wò ŋkɔ ŋu dɔ yakayaka.<verse eid="PSA 139:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 139:21"/>O! Yehowa, ɖe nyemelé fu ame siwo lé fu wò,</para>
  <para style="q2" vid="PSA 139:21">eye menyɔ ŋu ame siwo tso ɖe ŋuwò oa?<verse eid="PSA 139:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 139:22"/>Fuléle koe le asinye na wo,</para>
  <para style="q2" vid="PSA 139:22">eye mebu wo nye ketɔwoe.<verse eid="PSA 139:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 139:23"/>Dzro menye, o Mawu, eye nànya nye dzi;</para>
  <para style="q2" vid="PSA 139:23">dom kpɔ, eye nànya nye susu si tsi dzodzodzoe.<verse eid="PSA 139:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 139:24"/>Kpɔe ɖa be mɔtatra aɖe le menye hã,</para>
  <para style="q2" vid="PSA 139:24">eye nàkplɔm to mɔ mavɔtɔ la dzi.<verse eid="PSA 139:24"/></para>
  <chapter eid="PSA 139"/>
  <chapter number="140" style="c" sid="PSA 140"/>
  <para style="cl">Psalmo 140</para>
  <para style="d">David ƒe ha na hɛnɔ la.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 140:1"/>O! Yehowa, ɖem tso ame vɔ̃ɖiwo ƒe asi me</para>
  <para style="q2" vid="PSA 140:1">eye dzɔ ŋunye le ŋutsu ŋutasẽlawo ta,<verse eid="PSA 140:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 140:2"/>ame siwo ɖoa nu vɔ̃ɖiwo ɖe woƒe dzi me,</para>
  <para style="q2" vid="PSA 140:2">eye wodoa aʋa gbe sia gbe.<verse eid="PSA 140:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 140:3"/>Wonyre woƒe aɖewo wole ɖaɖam abe da tɔ ene,</para>
  <para style="q2" vid="PSA 140:3">eye da ƒe aɖi le woƒe nuyiwo ŋu. <char style="qs">Sela</char><verse eid="PSA 140:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 140:4"/>O! Yehowa, ɖem tso ame vɔ̃ɖiwo ƒe asi me,</para>
  <para style="q2" vid="PSA 140:4">dzɔ nye agbe ŋu le ŋutsu ŋutasẽlawo ta,</para>
  <para style="q2" vid="PSA 140:4">ame siwo ɖo be woaɖe afɔ le tenye.<verse eid="PSA 140:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 140:5"/>Dada tre mɔ da ɖe ɣaɣlaƒe nam,</para>
  <para style="q2" vid="PSA 140:5">woɖo ɖɔ, keke eme da ɖi nam</para>
  <para style="q2" vid="PSA 140:5">eye wotre azãwo da ɖe nye toƒe. <char style="qs">Sela</char><verse eid="PSA 140:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 140:6"/>O! Yehowa, megblɔ na wò be,</para>
  <para style="q2" vid="PSA 140:6">“Wòe nye nye Mawu.”</para>
  <para style="q1" vid="PSA 140:6">See, o Yehowa,</para>
  <para style="q2" vid="PSA 140:6">se nye nublanuiɣli.<verse eid="PSA 140:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 140:7"/>O! Aƒetɔ Yehowa, nye Ɖela sesẽ,</para>
  <para style="q2" vid="PSA 140:7">ame si ɖɔ gakuku nam le aʋakpegbe.<verse eid="PSA 140:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 140:8"/>O! Yehowa, mègana ame vɔ̃ɖiwo ƒe didi nava eme na wo o,</para>
  <para style="q2" vid="PSA 140:8">eye mègana woƒe ɖoɖowo nadze edzi na wo o,</para>
  <para style="q2" vid="PSA 140:8">ne menye nenema o la, woanɔ dadam. <char style="qs">Sela</char><verse eid="PSA 140:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 140:9"/>Na fukpekpe si ame siwo ɖe to ɖem</para>
  <para style="q2" vid="PSA 140:9">ƒe nuyiwo he vɛ la, nanye tsyɔ woƒe ta dzi.<verse eid="PSA 140:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 140:10"/>Na dzoka xɔxɔwo nadza ɖe wo dzi;</para>
  <para style="q2" vid="PSA 140:10">wonetsɔ wo ƒu gbe ɖe dzo me</para>
  <para style="q2" vid="PSA 140:10">kple ʋe globowo me, eye womegafɔ akpɔ gbeɖe o.<verse eid="PSA 140:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 140:11"/>Ŋutsu ameŋugblẽlawo megali ke ɖe anyigba dzi o,</para>
  <para style="q2" vid="PSA 140:11">eye gbegblẽ neva ŋutsu ŋutasẽlawo dzi.<verse eid="PSA 140:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 140:12"/>Menya be Yehowa tsoa afia na ame dahewo,</para>
  <para style="q2" vid="PSA 140:12">eye wòxɔa nya ɖe hiãtɔwo nu.<verse eid="PSA 140:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 140:13"/>Ame dzɔdzɔewo akafu wò ŋkɔ vavã,</para>
  <para style="q2" vid="PSA 140:13">eye dzi dzɔdzɔetɔwo anɔ ŋkuwò me ɖaa.<verse eid="PSA 140:13"/></para>
  <chapter eid="PSA 140"/>
  <chapter number="141" style="c" sid="PSA 141"/>
  <para style="cl">Psalmo 141</para>
  <para style="d">David ƒe ha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 141:1"/>O! Yehowa, mele yɔwòm, va gbɔnye kaba.</para>
  <para style="q2" vid="PSA 141:1">Se nye gbe, ne meyɔ wò.<verse eid="PSA 141:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 141:2"/>Nye gbedodoɖa neva gbɔwò abe dzudzɔ ʋeʋĩ ene,</para>
  <para style="q2" vid="PSA 141:2">eye na be nye asi siwo medo ɖe dzi la, nanɔ</para>
  <para style="q2" vid="PSA 141:2">na wò abe fiẽvɔsa ene.<verse eid="PSA 141:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 141:3"/>O! Yehowa, ɖo dzɔla nye nu ŋu,</para>
  <para style="q2" vid="PSA 141:3">eye nɔ ŋudzɔ ɖe nye nuyi ƒe ʋɔtru ŋu.<verse eid="PSA 141:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 141:4"/>Mègana be woahe nye dzi ɖe nu vɔ̃ɖi ŋuti,</para>
  <para style="q2" vid="PSA 141:4">be mayi gome kpɔ ge</para>
  <para style="q1" vid="PSA 141:4">le nu vɔ̃ɖi wɔwɔ me kple ŋutsu,</para>
  <para style="q2" vid="PSA 141:4">nu vɔ̃ɖi wɔlawo o, eye mègaɖe mɔ be maɖu woƒe nuɖuɖu viviwo o.<verse eid="PSA 141:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 141:5"/>Na ame dzɔdzɔe naƒom, enye dɔmenyo wòwɔ nam,</para>
  <para style="q2" vid="PSA 141:5">na wòaka mo nam, enye ami wòsi ɖe ta nam.</para>
  <para style="q1" vid="PSA 141:5">Nye ta magbe exɔxɔ o.</para>
  <para style="q2" vid="PSA 141:5">Gake nye gbedodoɖa tsia tsitre ɖe ame vɔ̃ɖiwo ƒe wɔnawo ŋu ɖaa,<verse eid="PSA 141:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 141:6"/>woatutu woƒe dziɖulawo tso togbɛwo dzi aƒu agame,</para>
  <para style="q2" vid="PSA 141:6">eye ame vɔ̃ɖiwo anya be megblɔ nye nyawo memie ɖe eteƒe.<verse eid="PSA 141:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 141:7"/>Woagblɔ be, “Abe ale si ame ŋlɔa nu hedzoboa anyigbae ene la,</para>
  <para style="q2" vid="PSA 141:7">nenemae woakaka míaƒe ƒuwoe ɖe yɔdowo nu.”<verse eid="PSA 141:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 141:8"/>O! Aƒetɔ Yehowa, meda nye ŋkuwo ɖe dziwò,</para>
  <para style="q2" vid="PSA 141:8">mewòe mebe ɖo, mègatsɔm na ku o.<verse eid="PSA 141:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 141:9"/>Ɖem le mɔ siwo wotre nam la me,</para>
  <para style="q2" vid="PSA 141:9">tso mɔkli si nu tovo wɔlawo ɖo ɖi la me.<verse eid="PSA 141:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 141:10"/>Na ame vɔ̃ɖiwo naɖo woawo ŋutɔ ƒe ɖɔwo me,</para>
  <para style="q2" vid="PSA 141:10">ne matso eme ayi le dedinɔnɔ me.<verse eid="PSA 141:10"/></para>
  <chapter eid="PSA 141"/>
  <chapter number="142" style="c" sid="PSA 142"/>
  <para style="cl">Psalmo 142</para>
  <para style="d">David ƒe nufiameha esi wònɔ agado me. Gbedodoɖa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 142:1"/>Medo ɣli na Yehowa sesĩe,</para>
  <para style="q2" vid="PSA 142:1">eye mekɔ nye gbe dzi na Yehowa be wòakpɔ nye nublanui.<verse eid="PSA 142:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 142:2"/>Metrɔ nye nuxaxawo kɔ ɖe eŋkume,</para>
  <para style="q2" vid="PSA 142:2">eye metrɔ nye vevesesewo kɔ ɖe eya amea gbɔ.<verse eid="PSA 142:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 142:3"/>Ne nu ti kɔ na nye gbɔgbɔ le menye la,</para>
  <para style="q2" vid="PSA 142:3">wò koe nya nye mɔ.</para>
  <para style="q1" vid="PSA 142:3">Ŋutsuwo tre mɔ</para>
  <para style="q2" vid="PSA 142:3">ɖe mɔ si metona la dzi nam.<verse eid="PSA 142:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 142:4"/>Trɔ ɖe nye ɖusime ne nàkpɔ;</para>
  <para style="q2" vid="PSA 142:4">ame aɖeke metsɔ ɖeke le eme nam o.</para>
  <para style="q1" vid="PSA 142:4">Bebeƒe aɖeke meli nam o,</para>
  <para style="q2" vid="PSA 142:4">eye ame aɖeke metsɔ ɖeke le eme nam o.<verse eid="PSA 142:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 142:5"/>O! Yehowa, wòe mele ɣli dom na.</para>
  <para style="q2" vid="PSA 142:5">Megblɔ be, “Wòe nye nye sitsoƒe,</para>
  <para style="q2" vid="PSA 142:5">kple nye gome le agbagbeawo ƒe anyigba dzi.”<verse eid="PSA 142:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 142:6"/>Ɖo to nye ɣlidodo,</para>
  <para style="q2" vid="PSA 142:6">elabena meɖo xaxa me ŋutɔ.</para>
  <para style="q1" vid="PSA 142:6">Ɖem tso ame siwo le yonyeme tim la ƒe asi me,</para>
  <para style="q2" vid="PSA 142:6">elabena wosesẽ nam akpa.<verse eid="PSA 142:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 142:7"/>Ɖem tso nye gaxɔ me,</para>
  <para style="q2" vid="PSA 142:7">be makafu wò ŋkɔ.</para>
  <para style="q1" vid="PSA 142:7">Ekema ame dzɔdzɔewo aɖe to ɖem,</para>
  <para style="q2" vid="PSA 142:7">le wò nyui si nèwɔ nam la ta.<verse eid="PSA 142:7"/></para>
  <chapter eid="PSA 142"/>
  <chapter number="143" style="c" sid="PSA 143"/>
  <para style="cl">Psalmo 143</para>
  <para style="d">David ƒe ha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 143:1"/>O! Yehowa, se nye gbedodoɖa,</para>
  <para style="q2" vid="PSA 143:1">lé to ɖe nye nublanuiɣli ŋu,</para>
  <para style="q1" vid="PSA 143:1">eye nàxɔ nam le wò nuteƒewɔwɔ</para>
  <para style="q2" vid="PSA 143:1">kple dzɔdzɔenyenye ta.<verse eid="PSA 143:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 143:2"/>Mègabu fɔ wò dɔla o,</para>
  <para style="q2" vid="PSA 143:2">elabena amegbetɔ aɖeke</para>
  <para style="q2" vid="PSA 143:2">mele dzɔdzɔe le ŋkuwò me o.<verse eid="PSA 143:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 143:3"/>Futɔ la ti yonyeme,</para>
  <para style="q2" vid="PSA 143:3">egbãm ɖe anyigba,</para>
  <para style="q1" vid="PSA 143:3">eye wòna menɔ viviti me abe</para>
  <para style="q2" vid="PSA 143:3">ame siwo ku xoxo va yi la ene.<verse eid="PSA 143:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 143:4"/>Nu te nye gbɔgbɔ ŋu le menye,</para>
  <para style="q2" vid="PSA 143:4">eye nye dzi wɔ yaa le menye.<verse eid="PSA 143:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 143:5"/>Meɖo ŋku blemaŋkekeawo dzi,</para>
  <para style="q2" vid="PSA 143:5">hede ŋugble le wò dɔwɔwɔwo katã ŋuti,</para>
  <para style="q2" vid="PSA 143:5">eye mebu nu siwo wò asiwo wɔ la ŋuti.<verse eid="PSA 143:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 143:6"/>Mekeke nye abɔwo me na wò,</para>
  <para style="q2" vid="PSA 143:6">eye nye luʋɔ ƒe ve me ƒu ɖe ŋuwò</para>
  <para style="q2" vid="PSA 143:6">abe kuɖiɖinyigba ene. <char style="qs">Sela</char><verse eid="PSA 143:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 143:7"/>O! Yehowa, tɔ nam kaba,</para>
  <para style="q2" vid="PSA 143:7">elabena nu te nye gbɔgbɔ ŋu.</para>
  <para style="q1" vid="PSA 143:7">Mègaɣla wò mo ɖem o,</para>
  <para style="q2" vid="PSA 143:7">ne menye nenema o la,</para>
  <para style="q2" vid="PSA 143:7">manɔ abe ame siwo yi aʋlime ene.<verse eid="PSA 143:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 143:8"/>Na ŋdi natsɔ wò lɔlɔ̃ si meʋãna o</para>
  <para style="q2" vid="PSA 143:8">la ƒe nya vɛ nam,</para>
  <para style="q2" vid="PSA 143:8">elabena dziwòe meka ɖo.</para>
  <para style="q1" vid="PSA 143:8">Fia mɔ si mato lam,</para>
  <para style="q2" vid="PSA 143:8">elabena wòe medo nye luʋɔ ɖe dzi na.<verse eid="PSA 143:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 143:9"/>O! Yehowa, ɖem tso nye futɔwo ƒe asi me,</para>
  <para style="q2" vid="PSA 143:9">elabena mewòe mebe ɖo.<verse eid="PSA 143:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 143:10"/>Fiam ale si mawɔ wò lɔlɔ̃nu,</para>
  <para style="q2" vid="PSA 143:10">elabena wòe nye nye Mawu;</para>
  <para style="q1" vid="PSA 143:10">na wò Gbɔgbɔ nyui la nakplɔm</para>
  <para style="q2" vid="PSA 143:10">to anyigba sɔsɔe dzi.<verse eid="PSA 143:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 143:11"/>O! Yehowa, le wò ŋkɔ la ta,</para>
  <para style="q2" vid="PSA 143:11">kpɔ nye agbe ta,</para>
  <para style="q1" vid="PSA 143:11">le wò dzɔdzɔenyenye ta,</para>
  <para style="q2" vid="PSA 143:11">ɖem le xaxa me.<verse eid="PSA 143:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 143:12"/>Le wò lɔlɔ̃ si meʋãna o la ta, mia nu na nye futɔwo;</para>
  <para style="q2" vid="PSA 143:12">tsrɔ̃ nye ketɔwo katã,</para>
  <para style="q2" vid="PSA 143:12">elabena wò dɔlae menye.<verse eid="PSA 143:12"/></para>
  <chapter eid="PSA 143"/>
  <chapter number="144" style="c" sid="PSA 144"/>
  <para style="cl">Psalmo 144</para>
  <para style="d">David ƒe ha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 144:1"/>Woakafu Yehowa, nye Agakpe la,</para>
  <para style="q2" vid="PSA 144:1">ame si fia aʋawɔwɔ nye asi kple asibidɛwo.<verse eid="PSA 144:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 144:2"/>Enye nye Mawu lɔlɔ̃tɔ kple nye mɔ sesẽ,</para>
  <para style="q2" vid="PSA 144:2">nye sitsoƒe kple nye xɔnametɔ kpakple nye akpoxɔnu,</para>
  <para style="q1" vid="PSA 144:2">nye Mawu si me mebe ɖo,</para>
  <para style="q2" vid="PSA 144:2">ame si bɔbɔ nye dukɔ ɖe tenye.<verse eid="PSA 144:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 144:3"/>O! Yehowa, nu kae nye amegbetɔ be nètsɔ ɖe le eme nɛ</para>
  <para style="q2" vid="PSA 144:3">kple amegbetɔvi be nèbua eŋuti?<verse eid="PSA 144:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 144:4"/>Amegbetɔ le abe gbɔgbɔ ko ene,</para>
  <para style="q2" vid="PSA 144:4">eye eƒe ŋkekewo le abe vɔvɔli si va yina kaba la ene.<verse eid="PSA 144:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 144:5"/>O! Yehowa, dze wò dziƒowo ne nàɖi va,</para>
  <para style="q2" vid="PSA 144:5">eye nàka asi towo ŋu, be woatu dzudzɔ.<verse eid="PSA 144:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 144:6"/>Dɔ dzikedzo ɖa woakaka futɔwo,</para>
  <para style="q2" vid="PSA 144:6">da wò aŋutrɔ, eye nàtsrɔ̃ wo.<verse eid="PSA 144:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 144:7"/>Do wò asi ɖa tso dziƒo nàxɔ nam,</para>
  <para style="q2" vid="PSA 144:7">eye nàɖem tso tsi sesẽwo</para>
  <para style="q2" vid="PSA 144:7">kple amedzrowo ƒe asi me,<verse eid="PSA 144:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 144:8"/>ame siwo ƒe nu me yɔ fũu kple alakpa,</para>
  <para style="q2" vid="PSA 144:8">eye woƒe nuɖusi blea ame.<verse eid="PSA 144:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 144:9"/>O! Mawu, madzi ha yeye na wò,</para>
  <para style="q2" vid="PSA 144:9">matsɔ kasaŋku, ka ewo tɔ aƒo ha na wò,<verse eid="PSA 144:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 144:10"/>wò ame si na dziɖuɖu fiawo,</para>
  <para style="q2" vid="PSA 144:10">eye nèɖe wo dɔla David tso yi vɔ̃ɖi ƒe asi me.<verse eid="PSA 144:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 144:11"/>Xɔ nam, eye nàɖem tso amedzrowo ƒe asi me,</para>
  <para style="q2" vid="PSA 144:11">ame siwo ƒe nu me yɔ fũu kple alakpa,</para>
  <para style="q2" vid="PSA 144:11">eye woƒe nuɖusi blea ame.<verse eid="PSA 144:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 144:12"/>Ekema mía viŋutsuwo</para>
  <para style="q2" vid="PSA 144:12">le woƒe ɖekakpuime,</para>
  <para style="q2" vid="PSA 144:12">anɔ abe ati siwo wode tsii nyuie ene,</para>
  <para style="q1" vid="PSA 144:12">eye mía vinyɔnuwo anɔ abe sɔti si ŋu</para>
  <para style="q2" vid="PSA 144:12">wota nu ɖo hetsɔ ɖo atsyɔ̃e na fiasã ene.<verse eid="PSA 144:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 144:13"/>Míaƒe avawo ayɔ fũu</para>
  <para style="q2" vid="PSA 144:13">kple nuku vovovowo.</para>
  <para style="q1" vid="PSA 144:13">Míaƒe alẽwo adzi ɖe edzi le akpewo</para>
  <para style="q2" vid="PSA 144:13">kple akpe ewowo me le míaƒe lãnyiƒewo.<verse eid="PSA 144:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 144:14"/>Nenema ke míaƒe nyiwo atsɔ agba kpekpewo vɛ.</para>
  <para style="q2" vid="PSA 144:14">Ale gli gbagbã maganɔ anyi o,</para>
  <para style="q1" vid="PSA 144:14">aboyomeyiyi maganɔ anyi o,</para>
  <para style="q2" vid="PSA 144:14">eye xaxa ƒe avifafa magaɖi le míaƒe mɔtatawo dzi azɔ o.<verse eid="PSA 144:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 144:15"/>Woayra dukɔ si wòava eme na alea le nyateƒe me;</para>
  <para style="q2" vid="PSA 144:15">Woayra dukɔ si ƒe Mawue nye Yehowa.<verse eid="PSA 144:15"/></para>
  <chapter eid="PSA 144"/>
  <chapter number="145" style="c" sid="PSA 145"/>
  <para style="cl">Psalmo 145</para>
  <para style="d">David ƒe kafukafuha.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 145:1"/>Mado wò ɖe dzi, nye Mawu, fia la.</para>
  <para style="q2" vid="PSA 145:1">Makafu wò ŋkɔ tso mavɔ me yi ɖe mavɔ me.<verse eid="PSA 145:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 145:2"/>Makafu wò gbe sia gbe,</para>
  <para style="q2" vid="PSA 145:2">eye mado wò ŋkɔ ɖe dzi tso mavɔ me yi ɖe mavɔ me.<verse eid="PSA 145:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 145:3"/>Gãe nye Yehowa, eye eya koe dze na kafukafu,</para>
  <para style="q2" vid="PSA 145:3">elabena ame aɖeke mate ŋu anya</para>
  <para style="q2" vid="PSA 145:3">eƒe gãnyenye ƒe goglome o.<verse eid="PSA 145:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 145:4"/>Dzidzime ɖeka akafu wò dɔwɔwɔwo</para>
  <para style="q2" vid="PSA 145:4">na dzidzime bubu, eye woatu xo</para>
  <para style="q2" vid="PSA 145:4">le wò nu dzɔatsuwo ŋu.<verse eid="PSA 145:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 145:5"/>Woaƒo nu le wò gãnyenye</para>
  <para style="q2" vid="PSA 145:5">ƒe atsyɔ̃ɖoɖo ƒe ŋutikɔkɔe ŋuti,</para>
  <para style="q2" vid="PSA 145:5">eye made ŋugble le wò dɔwɔwɔ wɔnukuwo ŋuti.<verse eid="PSA 145:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 145:6"/>Woaƒo nu le wò ŋɔdzidɔwɔwɔwo ƒe ŋusẽ ŋuti,</para>
  <para style="q2" vid="PSA 145:6">eye maɖe gbeƒã wò nuwɔwɔ dzɔatsuwo.<verse eid="PSA 145:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 145:7"/>Woaɖu wò nyuiwɔwɔ gbogboawo ƒe azã,</para>
  <para style="q2" vid="PSA 145:7">eye woadzi ha atso aseye le wò dzɔdzɔenyenye ŋuti.<verse eid="PSA 145:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 145:8"/>Yehowa nye amenuvela kple nublanuikpɔla;</para>
  <para style="q2" vid="PSA 145:8">medoa dɔmedzoe kabakaba o, eye lɔlɔ̃ bɔ ɖe esi.<verse eid="PSA 145:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 145:9"/>Yehowa nyoa dɔ me na ame sia ame,</para>
  <para style="q2" vid="PSA 145:9">eye wòkpɔa nublanui na ame siwo katã wòwɔ.<verse eid="PSA 145:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 145:10"/>O! Yehowa, ame siwo katã nèwɔ la akafu wò,</para>
  <para style="q2" vid="PSA 145:10">eye wò ame kɔkɔewo ado wò ɖe dzi.<verse eid="PSA 145:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 145:11"/>Woaƒo nu le wò fiaɖuƒe la ƒe ŋutikɔkɔe ŋu,</para>
  <para style="q2" vid="PSA 145:11">eye woagblɔ nya tso wò ŋusẽ ŋuti,<verse eid="PSA 145:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 145:12"/>ale be amewo katã nanya wò nuwɔwɔ dzɔatsuwo</para>
  <para style="q2" vid="PSA 145:12">kple wò fiaɖuƒe ƒe ŋutikɔkɔe ƒe atsyɔ̃.<verse eid="PSA 145:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 145:13"/>Wò fiaɖuƒe la nye fiaɖuƒe mavɔ,</para>
  <para style="q2" vid="PSA 145:13">eye wò fiaɖuɖu anɔ anyi le dzidzimewo katã me.</para>
  <para style="b" vid="PSA 145:13"/>
  <para style="q1" vid="PSA 145:13">Yehowa awɔ nuteƒe le eƒe ŋugbedodowo katã me,</para>
  <para style="q2" vid="PSA 145:13">eye wòaɖe lɔlɔ̃ afia ame siwo katã wòwɔ.<verse eid="PSA 145:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 145:14"/>Yehowa léa ame siwo katã dze anyi la ɖe asi,</para>
  <para style="q2" vid="PSA 145:14">eye wòfɔa ame siwo katã wobɔbɔ ɖe anyi la ɖe dzi.<verse eid="PSA 145:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 145:15"/>Ŋkuwo katã le wò asinu kpɔm,</para>
  <para style="q2" vid="PSA 145:15">eye nèna nuɖuɖu wo le enaɣi.<verse eid="PSA 145:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 145:16"/>Èʋu wò asiwo me, eye nètsɔ nu gbagbe</para>
  <para style="q2" vid="PSA 145:16">ɖe sia ɖe ƒe nu si wòdi la nɛ.<verse eid="PSA 145:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 145:17"/>Yehowa nye dzɔdzɔetɔ le eƒe mɔwo katã dzi,</para>
  <para style="q2" vid="PSA 145:17">eye wòlɔ̃a eƒe nu siwo katã wòwɔ.<verse eid="PSA 145:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 145:18"/>Yehowa tsɔ ɖe ame siwo yɔnɛ la gbɔ,</para>
  <para style="q2" vid="PSA 145:18">ame siwo katã yɔnɛ le nyateƒe me.<verse eid="PSA 145:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 145:19"/>Ewɔa ame siwo vɔ̃nɛ la ƒe dzimedidiwo na wo,</para>
  <para style="q2" vid="PSA 145:19">esea woƒe ɣlidodo, eye wòɖea wo.<verse eid="PSA 145:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 145:20"/>Yehowa kpɔa ame siwo katã lɔ̃nɛ la ta,</para>
  <para style="q2" vid="PSA 145:20">gake atsrɔ̃ ame vɔ̃ɖiwo katã.<verse eid="PSA 145:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 145:21"/>Nye nu agblɔ Yehowa ƒe kafukafu.</para>
  <para style="q2" vid="PSA 145:21">Nu gbagbe ɖe sia ɖe nekafu eƒe ŋkɔ kɔkɔe la</para>
  <para style="q2" vid="PSA 145:21">tso mavɔ me yi ɖe mavɔ me.<verse eid="PSA 145:21"/></para>
  <chapter eid="PSA 145"/>
  <chapter number="146" style="c" sid="PSA 146"/>
  <para style="cl">Psalmo 146</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 146:1"/>Mikafu Yehowa.</para>
  <para style="b" vid="PSA 146:1"/>
  <para style="q1" vid="PSA 146:1">O! luʋɔnye, kafu Yehowa.<verse eid="PSA 146:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 146:2"/>Makafu Yehowa le nye agbemeŋkekewo katã me.</para>
  <para style="q2" vid="PSA 146:2">Madzi kafukafuha na nye Mawu la, zi ale si mele agbe.<verse eid="PSA 146:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 146:3"/>Migaɖo dzi ɖe dziɖulawo ŋu o,</para>
  <para style="q2" vid="PSA 146:3">eye migaka ɖe amegbetɔ kodzogbea,</para>
  <para style="q2" vid="PSA 146:3">si mate ŋu axɔ na ame o la dzi o.<verse eid="PSA 146:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 146:4"/>Ne woƒe gbɔgbɔ do go</para>
  <para style="q2" vid="PSA 146:4">le wo me la, wogatrɔna zua kewɔ,</para>
  <para style="q1" vid="PSA 146:4">gbe ma gbe ke woƒe ɖoɖo</para>
  <para style="q2" vid="PSA 146:4">siwo katã wowɔ la zua tofloko.<verse eid="PSA 146:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 146:5"/>Woayra ame si ƒe xɔnametɔ nye Yakob ƒe Mawu la,</para>
  <para style="q2" vid="PSA 146:5">eye eƒe mɔkpɔkpɔ le Yehowa, eƒe Mawu la me.<verse eid="PSA 146:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 146:6"/>Eya ame si wɔ dziƒo kple anyigba,</para>
  <para style="q2" vid="PSA 146:6">atsiaƒu kple nu siwo katã le eme,</para>
  <para style="q2" vid="PSA 146:6">Yehowa nye nuteƒewɔla tegbetegbe.<verse eid="PSA 146:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 146:7"/>Etsoa afia na ame siwo wote ɖe anyi,</para>
  <para style="q2" vid="PSA 146:7">eye wònaa nuɖuɖu dɔwuitɔwo.</para>
  <para style="q1" vid="PSA 146:7">Yehowae naa ablɔɖe gamenɔlawo.<verse eid="PSA 146:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 146:8"/>Yehowa ʋua ŋku na ŋkuagbãtɔwo,</para>
  <para style="q1" vid="PSA 146:8">Yehowa fɔa ame siwo wote ɖe anyi la ɖe dzi,</para>
  <para style="q2" vid="PSA 146:8">Yehowa lɔ̃a ame dzɔdzɔewo ƒe nya.<verse eid="PSA 146:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 146:9"/>Yehowa kpɔa amedzrowo ta,</para>
  <para style="q2" vid="PSA 146:9">eye wònye tsyɔ̃eviwo kple ahosiwo hã ta kpɔla.</para>
  <para style="q2" vid="PSA 146:9">Ke etɔtɔa ame vɔ̃ɖiwo ƒe mɔwo.<verse eid="PSA 146:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 146:10"/>Yehowa le fia ɖum tso mavɔ me yi ɖe mavɔ me.</para>
  <para style="q2" vid="PSA 146:10">O! Zion, wò Mawu la aɖu fia le dzidzimewo katã me.</para>
  <para style="b" vid="PSA 146:10"/>
  <para style="q1" vid="PSA 146:10">Mikafu Yehowa.<verse eid="PSA 146:10"/></para>
  <chapter eid="PSA 146"/>
  <chapter number="147" style="c" sid="PSA 147"/>
  <para style="cl">Psalmo 147</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 147:1"/>Mikafu Yehowa.</para>
  <para style="b" vid="PSA 147:1"/>
  <para style="q1" vid="PSA 147:1">Aleke mehenyoe be woadzi kafukafuha na míaƒe Mawu la o!</para>
  <para style="q2" vid="PSA 147:1">Aleke wòhevivina, eye wòdze be woakafui!<verse eid="PSA 147:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 147:2"/>Yehowa gbugbɔ tso Yerusalem du la,</para>
  <para style="q2" vid="PSA 147:2">eye wòkplɔ Israel ƒe aboyomewo gbɔe.<verse eid="PSA 147:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 147:3"/>Eda gbe le ame siwo ƒe dzi gbã la ŋu,</para>
  <para style="q2" vid="PSA 147:3">eye wòbla woƒe abiwo na wo.<verse eid="PSA 147:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 147:4"/>Eyae ɖo xexlẽme na ɣletiviwo,</para>
  <para style="q2" vid="PSA 147:4">eye wòyɔa ɖe sia ɖe ƒe ŋkɔ.<verse eid="PSA 147:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 147:5"/>Gãe nye míaƒe Aƒetɔ la,</para>
  <para style="q2" vid="PSA 147:5">eye eƒe ŋusẽ tri akɔ ŋutɔ,</para>
  <para style="q2" vid="PSA 147:5">seɖoƒe meli na eƒe gɔmesese o.<verse eid="PSA 147:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 147:6"/>Yehowa kpɔa ame siwo bɔbɔa wo ɖokui la dzi,</para>
  <para style="q2" vid="PSA 147:6">ke etsɔ ame vɔ̃ɖi ya xlã ɖe anyigba.<verse eid="PSA 147:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 147:7"/>Midzi ha na Yehowa kple akpedada,</para>
  <para style="q2" vid="PSA 147:7">eye miƒo ha na míaƒe Mawu la kple kasaŋku.<verse eid="PSA 147:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 147:8"/>Etsɔa lilikpo xea yamee,</para>
  <para style="q2" vid="PSA 147:8">eye wònana tsi dzana ɖe anyigba la dzi hewɔnɛ be</para>
  <para style="q2" vid="PSA 147:8">gbe miena ɖe togbɛwo dzi.<verse eid="PSA 147:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 147:9"/>Enaa nuɖuɖu nyiwo</para>
  <para style="q2" vid="PSA 147:9">kple akpaviã siwo le xɔxlɔ̃m nɛ.<verse eid="PSA 147:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 147:10"/>Eƒe dzidzɔ mele sɔ ƒe ŋusẽ me loo,</para>
  <para style="q2" vid="PSA 147:10">alo amegbetɔ ƒe afɔ me o;<verse eid="PSA 147:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 147:11"/>ke boŋ Yehowa ƒe dzidzɔkpɔkpɔ le ame siwo vɔ̃nɛ la me,</para>
  <para style="q2" vid="PSA 147:11">ame siwo tsɔa woƒe mɔkpɔkpɔ dana ɖe eƒe lɔlɔ̃ si meʋãna o la dzi.<verse eid="PSA 147:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 147:12"/>O! Yerusalem, do Yehowa ɖe dzi,</para>
  <para style="q2" vid="PSA 147:12">O! Zion, kafu wò Mawu la,<verse eid="PSA 147:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 147:13"/>elabena eyae glã wò agbowo ƒe gametiwo,</para>
  <para style="q2" vid="PSA 147:13">eye wòyra ame siwo le mewò.<verse eid="PSA 147:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 147:14"/>Ena ŋutifafa le wò liƒowo dzi,</para>
  <para style="q2" vid="PSA 147:14">eye wòtsɔ mɔlu nyuitɔ ɖi ƒo na wòe.<verse eid="PSA 147:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 147:15"/>Eɖo eƒe sedede ɖe anyigba la dzi,</para>
  <para style="q2" vid="PSA 147:15">eye eƒe nya kaka kple du ɖo teƒewo.<verse eid="PSA 147:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 147:16"/>Ekaka tsikpe abe ɖetifu ene,</para>
  <para style="q2" vid="PSA 147:16">eye wòkaka afu abe dzofi ene.<verse eid="PSA 147:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 147:17"/>Eɖo kpetsi ɖe anyigba abe kpekui ene.</para>
  <para style="q2" vid="PSA 147:17">Ame ka ate ŋu anɔ te ɖe wò ya fafɛ la nu?<verse eid="PSA 147:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 147:18"/>Edɔ eƒe nya ɖa, eye wòlolo wo.</para>
  <para style="q2" vid="PSA 147:18">Ede ŋusẽ eƒe yawo me, eye tsiwo de asi sisi me.<verse eid="PSA 147:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 147:19"/>Eɖe eƒe nya fia Yakob eye wòɖe eƒe sewo</para>
  <para style="q2" vid="PSA 147:19">kple sededewo fia Israel.<verse eid="PSA 147:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 147:20"/>Mewɔ esia na dukɔ bubu aɖeke o,</para>
  <para style="q2" vid="PSA 147:20">eye womenya eƒe sewo o.</para>
  <para style="b" vid="PSA 147:20"/>
  <para style="q1" vid="PSA 147:20">Mikafu Yehowa.<verse eid="PSA 147:20"/></para>
  <chapter eid="PSA 147"/>
  <chapter number="148" style="c" sid="PSA 148"/>
  <para style="cl">Psalmo 148</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 148:1"/>Mikafu Yehowa.</para>
  <para style="b" vid="PSA 148:1"/>
  <para style="q1" vid="PSA 148:1">Mikafu Yehowa tso dziƒowo,</para>
  <para style="q2" vid="PSA 148:1">mikafui le kɔkɔƒewo le dzi me.<verse eid="PSA 148:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 148:2"/>Mi eƒe dɔlawo katã mikafui,</para>
  <para style="q2" vid="PSA 148:2">dziƒoʋakɔwo hã mikafui.<verse eid="PSA 148:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 148:3"/>Ɣe kple ɣleti nekafui,</para>
  <para style="q2" vid="PSA 148:3">mikafui, mi ɣletivi keklẽwo.<verse eid="PSA 148:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 148:4"/>Mi dziƒo kɔkɔtɔwo, mikafui,</para>
  <para style="q2" vid="PSA 148:4">eye mi tsi siwo le alilĩa tame hã mikafui.<verse eid="PSA 148:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 148:5"/>Wo katã nekafu Yehowa ƒe ŋkɔ,</para>
  <para style="q2" vid="PSA 148:5">elabena eɖe gbe, eye wova dzɔ.<verse eid="PSA 148:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 148:6"/>Etsɔ wo ɖo wo nɔƒe tso mavɔ me yi ɖe mavɔ me,</para>
  <para style="q2" vid="PSA 148:6">ede se si nu mayi akpɔ gbeɖe o.<verse eid="PSA 148:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 148:7"/>Mikafu Yehowa tso anyigba,</para>
  <para style="q2" vid="PSA 148:7">mi nuwɔwɔ gã siwo le atsiaƒu me kple gogloƒewo katã.<verse eid="PSA 148:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 148:8"/>Dzikedzo kple kpetsi,</para>
  <para style="q2" vid="PSA 148:8">tsikpe kple lilikpowo, ahomya si wɔ eƒe lɔlɔ̃nu,<verse eid="PSA 148:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 148:9"/>mi towo kple togbɛwo katã,</para>
  <para style="q2" vid="PSA 148:9">atikutsetsetiwo kple sedatiwo katã,<verse eid="PSA 148:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 148:10"/>gbemelãwo kple nyiwo katã,</para>
  <para style="q2" vid="PSA 148:10">nuwɔwɔ suewo kple xe dzodzoewo,<verse eid="PSA 148:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 148:11"/>anyigbadzifiawo kple dukɔwo katã,</para>
  <para style="q2" vid="PSA 148:11">mi dumegãwo kple dziɖula siwo katã le anyigba dzi,<verse eid="PSA 148:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 148:12"/>ɖekakpuiwo kple ɖetugbiwo,</para>
  <para style="q2" vid="PSA 148:12">ame tsitsiwo kple ɖeviwo siaa nekafui.<verse eid="PSA 148:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 148:13"/>Mikafu Yehowa ƒe ŋkɔ,</para>
  <para style="q2" vid="PSA 148:13">elabena eƒe ŋkɔ ɖeɖe koe de dzi,</para>
  <para style="q2" vid="PSA 148:13">eye eƒe atsyɔ̃ le anyigba kple dziƒowo tame.<verse eid="PSA 148:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 148:14"/>Ena dzo aɖe do na eƒe dukɔ,</para>
  <para style="q2" vid="PSA 148:14">esi nye Israel,</para>
  <para style="q1" vid="PSA 148:14">eƒe ame kɔkɔewo katã ƒe kafukafu,</para>
  <para style="q2" vid="PSA 148:14">ame siwo tsɔ ɖe eƒe dzi gbɔ.</para>
  <para style="b" vid="PSA 148:14"/>
  <para style="q1" vid="PSA 148:14">Mikafu Yehowa.<verse eid="PSA 148:14"/></para>
  <chapter eid="PSA 148"/>
  <chapter number="149" style="c" sid="PSA 149"/>
  <para style="cl">Psalmo 149</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 149:1"/>Mikafu Yehowa.</para>
  <para style="b" vid="PSA 149:1"/>
  <para style="q1" vid="PSA 149:1">Midzi ha yeye na Yehowa,</para>
  <para style="q2" vid="PSA 149:1">midzi eƒe kafukafuha le ame kɔkɔewo ƒe asaɖa me.<verse eid="PSA 149:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 149:2"/>Israel nekpɔ dzidzɔ le woƒe Wɔla me,</para>
  <para style="q2" vid="PSA 149:2">Zionviwo netso aseye ɖe woƒe fia la ŋu.<verse eid="PSA 149:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 149:3"/>Wonekafu eƒe ŋkɔ kple ɣeɖuɖu,</para>
  <para style="q2" vid="PSA 149:3">eye woneƒo ha nɛ kple asiʋuiwo kple kasaŋku.<verse eid="PSA 149:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 149:4"/>Elabena Yehowa do dzidzɔ ɖe eƒe dukɔ ŋu,</para>
  <para style="q2" vid="PSA 149:4">eye wòtsɔ ɖeɖe ɖɔ na ame gblɔewo.<verse eid="PSA 149:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 149:5"/>Ame kɔkɔewo nekpɔ dzidzɔ le eƒe bubu me,</para>
  <para style="q2" vid="PSA 149:5">eye woadzi ha kple dzidzɔ le woƒe abawo dzi.<verse eid="PSA 149:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 149:6"/>Mawu kafukafu nenɔ woƒe nu me,</para>
  <para style="q2" vid="PSA 149:6">eye wòanye yi nuevee anɔ woƒe asiwo me,<verse eid="PSA 149:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 149:7"/>ne woatsɔ abia hlɔ̃ dukɔwo,</para>
  <para style="q2" vid="PSA 149:7">eye woatsɔe ahe toe na amewo,<verse eid="PSA 149:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 149:8"/>ne woabla woƒe fiawo kple gakɔsɔkɔsɔ,</para>
  <para style="q2" vid="PSA 149:8">eye woade kunyowu woƒe bubumewo,<verse eid="PSA 149:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 149:9"/>ne woawɔ fɔ si wobu wo, woŋlɔ da ɖi ɖe wo ŋu la dzi.</para>
  <para style="q2" vid="PSA 149:9">Esia nye eƒe ame kɔkɔewo katã ƒe ŋutikɔkɔe.</para>
  <para style="b" vid="PSA 149:9"/>
  <para style="q1" vid="PSA 149:9">Mikafu Yehowa.<verse eid="PSA 149:9"/></para>
  <chapter eid="PSA 149"/>
  <chapter number="150" style="c" sid="PSA 150"/>
  <para style="cl">Psalmo 150</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 150:1"/>Miakafu Yehowa.</para>
  <para style="b" vid="PSA 150:1"/>
  <para style="q1" vid="PSA 150:1">Mikafu Mawu le eƒe Kɔkɔeƒe la me.</para>
  <para style="q2" vid="PSA 150:1">Mikafui le eƒe dziƒo sesẽ la me.<verse eid="PSA 150:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 150:2"/>Mikafui le eƒe ŋusẽdɔwo ta.</para>
  <para style="q2" vid="PSA 150:2">Mikafui le eƒe gãnyenye si ƒo wo katã ta la ta.<verse eid="PSA 150:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 150:3"/>Mitsɔ kpẽkuku kafui.</para>
  <para style="q2" vid="PSA 150:3">Mitsɔ saŋku kple kasaŋku kafui.<verse eid="PSA 150:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 150:4"/>Mikafui kple asiʋui kple ɣeɖuɖu.</para>
  <para style="q2" vid="PSA 150:4">Mikafui kple kasaŋkuƒoƒo kple dzekuku.<verse eid="PSA 150:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 150:5"/>Mikafui kple ayawagba eve</para>
  <para style="q2" vid="PSA 150:5">siwo wotsɔna nɔa wo nɔewo ƒomii.</para>
  <para style="q1" vid="PSA 150:5">Ɛ̃, mikafui kple ayawagba eve</para>
  <para style="q2" vid="PSA 150:5">siwo ƒe gbe ɖina sesĩe.<verse eid="PSA 150:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 150:6"/>Nu sia nu si me gbɔgbɔ le la, nekafu Yehowa.</para>
  <para style="b" vid="PSA 150:6"/>
  <para style="q1" vid="PSA 150:6">Mikafu Yehowa!<verse eid="PSA 150:6"/></para>
  <chapter eid="PSA 150"/>
</usx>
