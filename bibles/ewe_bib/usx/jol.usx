<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JOL" style="id">- Biblica® Open Ewe Contemporary Scriptures 2020</book>
  <para style="h">Yoel</para>
  <para style="toc1">Yoel ƒe agbalẽ</para>
  <para style="toc2">Yoel</para>
  <para style="toc3">Yol</para>
  <para style="mt1">Yoel</para>
  <para style="mt2">ƒe agbalẽ</para>
  <chapter number="1" style="c" sid="JOL 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1"/>Esiae nye gbedeasi si va na Yoel, Petuel ƒe vi, tso Yehowa gbɔ.<verse eid="JOL 1:1"/></para>
  <para style="b"/>
  <para style="s1">Ʋetsuviwo ƒe vava</para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 1:2"/>Miɖo to afii, mi Israel ƒe ame tsitsiwo!</para>
  <para style="q2" vid="JOL 1:2">Mi anyigbadzitɔwo, mise nya sia ɖa.</para>
  <para style="q1" vid="JOL 1:2">Le miaƒe agbemeŋkekewo katã me ɖe,</para>
  <para style="q2" vid="JOL 1:2">miese nya sia tɔgbi kpɔa?<verse eid="JOL 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 1:3"/>Mitsɔe xlɔ̃ nu mia viwoe</para>
  <para style="q2" vid="JOL 1:3">eye woawo hã nagblɔe na wo viwo</para>
  <para style="q2" vid="JOL 1:3">ne wòazu xotunya tso dzidzime yi dzidzime.<verse eid="JOL 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 1:4"/>Nu siwo ʋetsuviwo ƒe ha gã agblẽ ɖi la,</para>
  <para style="q2" vid="JOL 1:4">ʋetsuviwo aɖui,</para>
  <para style="q1" vid="JOL 1:4">nu siwo ʋetsuviwo agblẽ ɖi la,</para>
  <para style="q2" vid="JOL 1:4">ʋetrawo aɖui, eye nu siwo ʋetrawo agblẽ ɖi la,</para>
  <para style="q2" vid="JOL 1:4">abɔwo aɖui.<verse eid="JOL 1:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 1:5"/>Minyɔ, mi ahanomunɔwo,</para>
  <para style="q2" vid="JOL 1:5">ne miafa avi hehehe,</para>
  <para style="q1" vid="JOL 1:5">mi waintsunolawo,</para>
  <para style="q2" vid="JOL 1:5">mifa avi, elabena woɖe wain le miaƒe nu me,</para>
  <para style="q1" vid="JOL 1:5">eye miagakpɔ wain yeye ano o!<verse eid="JOL 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 1:6"/>Dukɔ gã aɖe va xɔ anyigba la katã dzi.</para>
  <para style="q2" vid="JOL 1:6">Ŋɔdzi le wo ŋu ŋutɔ</para>
  <para style="q2" vid="JOL 1:6">eye ame aɖeke mate ŋu axlẽ wo o,</para>
  <para style="q1" vid="JOL 1:6">evɔ woƒe aɖuwo hã le ɖaɖam abe dzatatsu ƒe aɖuwo</para>
  <para style="q2" vid="JOL 1:6">kple dzatanɔ ƒe tsyowo ene!<verse eid="JOL 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 1:7"/>Wogblẽ nye waingble dome.</para>
  <para style="q2" vid="JOL 1:7">Wogblẽ nye gbotiwo,</para>
  <para style="q1" vid="JOL 1:7">wokuko tsro le atilɔwo ŋuti ƒiaƒiaƒia eye wofu ɣie.<verse eid="JOL 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 1:8"/>Mifa konyi abe ale si ɖetugbi si</para>
  <para style="q2" vid="JOL 1:8">ƒe ŋugbetɔsrɔ̃ ku la wɔnɛ ene.<verse eid="JOL 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 1:9"/>Nuɖuvɔsa kple nunovɔsa le Yehowa ƒe gbedoxɔ me nu tso;</para>
  <para style="q2" vid="JOL 1:9">ale dɔwuame to na nunɔlaawo</para>
  <para style="q1" vid="JOL 1:9">kple ame siwo subɔna le Yehowa ƒe aƒe me</para>
  <para style="q2" vid="JOL 1:9">eye wole konyi fam.<verse eid="JOL 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 1:10"/>Agblewo ɖi gbɔlo, anyigba ƒu kplakplakpla,</para>
  <para style="q2" vid="JOL 1:10">bliwo dome gblẽ,</para>
  <para style="q2" vid="JOL 1:10">wain yeye megali o, eye ami hã nu tso.<verse eid="JOL 1:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 1:11"/>Azɔ mi agbledelawo,</para>
  <para style="q2" vid="JOL 1:11">dzika netso mia ƒo, eye mialulũ,</para>
  <para style="q1" vid="JOL 1:11">mi waingbledelawo,</para>
  <para style="q2" vid="JOL 1:11">mifa avi sesĩe.</para>
  <para style="q1" vid="JOL 1:11">Mifa avi ɖe lu kple ƒo hã ta</para>
  <para style="q2" vid="JOL 1:11">elabena nuŋeŋe nu tso le agble me.<verse eid="JOL 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 1:12"/>Wainkawo ku, gboti yrɔ,</para>
  <para style="q2" vid="JOL 1:12">yevuboɖatiwo ƒu,</para>
  <para style="q1" vid="JOL 1:12">detiwo kple atɔtɔŋutiwo</para>
  <para style="q2" vid="JOL 1:12">kple agblemetiwo katã kura hã ku.</para>
  <para style="q1" vid="JOL 1:12">Amegbetɔ ƒe dzidzɔ ɖe sia ɖe nu tso.<verse eid="JOL 1:12"/></para>
  <para style="s1">Yɔyɔ hena dzimetɔtrɔ</para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 1:13"/>O mi nunɔlawo, mita akpanya eye mixa nu.</para>
  <para style="q2" vid="JOL 1:13">Mifa avi, mi ame siwo subɔna le vɔsamlekpui la ŋgɔ,</para>
  <para style="q1" vid="JOL 1:13">mitsi ŋu dɔ miafa avi zã blibo la katã,</para>
  <para style="q2" vid="JOL 1:13">mi ame siwo subɔna le nye Mawu ŋkume.</para>
  <para style="q1" vid="JOL 1:13">Elabena womagatsɔ nuɖuvɔsa</para>
  <para style="q2" vid="JOL 1:13">kple nunovɔsa va miaƒe Mawu la ƒe aƒe me o.<verse eid="JOL 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 1:14"/>Miɖo nutsitsidɔ kɔkɔe</para>
  <para style="q2" vid="JOL 1:14">eye miyɔ takpekpe tɔxɛ.</para>
  <para style="q1" vid="JOL 1:14">Miyɔ ame tsitsiwo</para>
  <para style="q2" vid="JOL 1:14">kple anyigbadzinɔlawo katã yi ɖe Yehowa, miaƒe Mawu la</para>
  <para style="q2" vid="JOL 1:14">ƒe gbedoxɔ me eye miafa avi le afi ma na Yehowa.<verse eid="JOL 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 1:15"/>O ŋkeke ma!</para>
  <para style="q2" vid="JOL 1:15">Elabena Yehowa ƒe ŋkeke la tu aƒe.</para>
  <para style="q1" vid="JOL 1:15">Ava abe gbegblẽ ene tso Ŋusẽkatãtɔ la gbɔ.<verse eid="JOL 1:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 1:16"/>Ɖe nuɖuɖuwo mevɔ le mia ŋkume eye dzidzɔ</para>
  <para style="q2" vid="JOL 1:16">kple aseyetsotso le miaƒe Mawu la</para>
  <para style="q2" vid="JOL 1:16">ƒe gbedoxɔ me mawu enu oa?<verse eid="JOL 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 1:17"/>Nukuwo ƒaƒã ɖe woƒe gowo me,</para>
  <para style="q2" vid="JOL 1:17">blivawo kple texɔwo tsi ƒuƒlu</para>
  <para style="q1" vid="JOL 1:17">eye bli matsimatsiwo ku, heƒu ɖe bo dzi.<verse eid="JOL 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 1:18"/>Nyiwo le ŋeŋem,</para>
  <para style="q2" vid="JOL 1:18">nyihawo le nu kpɔm nublanuitɔe,</para>
  <para style="q1" vid="JOL 1:18">elabena nuɖuɖu meli na wo o,</para>
  <para style="q2" vid="JOL 1:18">eye alẽhawo le fu kpem.<verse eid="JOL 1:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 1:19"/>Yehowa, xɔ na mí!</para>
  <para style="q2" vid="JOL 1:19">Elabena dzo bi gbe damawo,</para>
  <para style="q1" vid="JOL 1:19">eye dzo ƒe aɖe fia atiwo katã le gbedzi.<verse eid="JOL 1:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 1:20"/>Gbemelãwo gɔ̃ hã le ɣli dom be nàxɔ na yewo,</para>
  <para style="q2" vid="JOL 1:20">elabena tsi mie le tɔʋuwo me,</para>
  <para style="q2" vid="JOL 1:20">dzo bi gbe siwo le lãnyiƒewo keŋ.<verse eid="JOL 1:20"/></para>
  <chapter eid="JOL 1"/>
  <chapter number="2" style="c" sid="JOL 2"/>
  <para style="s1">Ʋetsuviwo ƒe ha gã aɖe</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 2:1"/>Miku kpẽ le Zion!</para>
  <para style="q2" vid="JOL 2:1">Miku aʋadzedze ƒe kpẽ la be</para>
  <para style="q2" vid="JOL 2:1">woasee le nye to kɔkɔe la dzi!</para>
  <para style="b" vid="JOL 2:1"/>
  <para style="q1" vid="JOL 2:1">Anyigbadzitɔwo katã nedzo nyanyanya kple vɔvɔ̃,</para>
  <para style="q2" vid="JOL 2:1">elabena Yehowa ƒe ŋkeke la tu aƒe vɔ.<verse eid="JOL 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 2:2"/>Anye viviti kple blukɔ ƒe ŋkeke,</para>
  <para style="q2" vid="JOL 2:2">eye lilikpo kple viviti tsiɖitsiɖi ado.</para>
  <para style="q1" vid="JOL 2:2">Abe ale si ŋdikekeli klẽna ɖe towo tame ene la,</para>
  <para style="q2" vid="JOL 2:2">nenema ke aʋakɔ gã sẽŋu aɖe avae.</para>
  <para style="q1" vid="JOL 2:2">Ame siawo la, womekpɔ wo tɔgbi kpɔ o,</para>
  <para style="q2" vid="JOL 2:2">eye womagakpɔ wo tɔgbi kpɔ</para>
  <para style="q2" vid="JOL 2:2">le xexea me ƒe dzidzimewo dome o!<verse eid="JOL 2:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 2:3"/>Dzo bibi le nu fiam le wo ŋgɔ</para>
  <para style="q2" vid="JOL 2:3">eye dzo ƒe aɖewo le wo megbe.</para>
  <para style="q1" vid="JOL 2:3">Anyigba la le ŋgɔ abe Edenbɔ ene</para>
  <para style="q2" vid="JOL 2:3">gake ezua gbegbe le wo megbe.</para>
  <para style="q2" vid="JOL 2:3">Naneke mate ŋu asi le enu o.<verse eid="JOL 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 2:4"/>Wodzena abe sɔwo ene</para>
  <para style="q2" vid="JOL 2:4">eye woƒua du abe sɔdolawo ene.<verse eid="JOL 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 2:5"/>Wole kpo tim le towo tame,</para>
  <para style="q2" vid="JOL 2:5">woƒe afɔziwo le ɖiɖim abe tasiaɖamwo tɔ ene</para>
  <para style="q2" vid="JOL 2:5">eye abe dzoe le gbe ƒuƒu bim ene.</para>
  <para style="q1" vid="JOL 2:5">Wole du ƒum abe asrafo kalẽtɔwoe</para>
  <para style="q2" vid="JOL 2:5">le du dzi yina ɖe aʋa ene.<verse eid="JOL 2:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 2:6"/>Dukɔwo kpɔe hedzo nyanyanya</para>
  <para style="q2" vid="JOL 2:6">eye woƒe mowo fu tititi le vɔvɔ̃ ta.<verse eid="JOL 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 2:7"/>Wozɔ yi ŋgɔ kple kalẽ abe aʋawɔlawo ene</para>
  <para style="q2" vid="JOL 2:7">eye woflɔ gliawo abe asrafowo ene.</para>
  <para style="q1" vid="JOL 2:7">Wo katã yi ŋgɔgbe eye ɖeke meto miame alo ɖusime o.<verse eid="JOL 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 2:8"/>Ɖeke mebe ɖe nɔvia xa o.</para>
  <para style="q2" vid="JOL 2:8">Ame sia ame le enɔƒe pɛpɛpɛ</para>
  <para style="q1" vid="JOL 2:8">Aʋawɔnu aɖeke mate ŋu</para>
  <para style="q2" vid="JOL 2:8">anɔ te ɖe wo ŋu o.<verse eid="JOL 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 2:9"/>Wo katã lũ ɖe du la dzi;</para>
  <para style="q2" vid="JOL 2:9">woflɔ gli la zɔ etame hege ɖe aƒewo</para>
  <para style="q1" vid="JOL 2:9">kple xɔwo me abe ale si fiafitɔ toa fesre nue ene.<verse eid="JOL 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 2:10"/>Anyigba ʋuʋu kpekpekpe</para>
  <para style="q2" vid="JOL 2:10">eye dziƒo dzo nyanyanya le wo ŋgɔ.</para>
  <para style="q1" vid="JOL 2:10">Ɣe kple ɣleti do viviti eye ɣletiviwo megaklẽ o.<verse eid="JOL 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 2:11"/>Yehowa ŋutɔ le eƒe aʋakɔ la ŋgɔ le gbe ɖem.</para>
  <para style="q2" vid="JOL 2:11">Esiae nye eƒe aʋakɔ gã la eye ame siwo</para>
  <para style="q2" vid="JOL 2:11">le eƒe gbeɖeɖe dzi wɔm la nye ame sesẽwo.</para>
  <para style="q1" vid="JOL 2:11">Yehowa ƒe ŋkeke la anye ŋkeke gã,</para>
  <para style="q2" vid="JOL 2:11">ŋɔdzi kple vɔvɔ̃ anɔ eŋu.</para>
  <para style="q2" vid="JOL 2:11">Ame kae ate ŋu anɔ te ɖe enu?<verse eid="JOL 2:11"/></para>
  <para style="s1">Mitrɔ dzi me</para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 2:12"/>“Eya ta Yehowa be,</para>
  <para style="q2" vid="JOL 2:12">‘Mitrɔ ɖe ŋunye azɔ,</para>
  <para style="q2" vid="JOL 2:12">kple miaƒe dzi blibo.</para>
  <para style="q1" vid="JOL 2:12">Miva kple nutsitsidɔ,</para>
  <para style="q2" vid="JOL 2:12">avifafa kple konyifafa.’ ”<verse eid="JOL 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 2:13"/>Midze miaƒe dziwo,</para>
  <para style="q2" vid="JOL 2:13">menye miaƒe awuwo o.</para>
  <para style="q1" vid="JOL 2:13">Mitrɔ ɖe Yehowa, miaƒe Mawu la</para>
  <para style="q2" vid="JOL 2:13">ŋu, elabena amenuveve</para>
  <para style="q2" vid="JOL 2:13">kple nublanuikpɔkpɔ bɔ ɖe esi.</para>
  <para style="q1" vid="JOL 2:13">Medoa dziku kabakaba o,</para>
  <para style="q2" vid="JOL 2:13">eƒe dɔ me nyo, eye metsia dzi be yeahe to na ame o.<verse eid="JOL 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 2:14"/>Ame kae nya be ɖewohĩ atrɔ ave mía nu</para>
  <para style="q2" vid="JOL 2:14">eye wòagblẽ yayra ɖi na mí?</para>
  <para style="q1" vid="JOL 2:14">Ekema míagatsɔ nuɖuvɔsa</para>
  <para style="q2" vid="JOL 2:14">kple nunovɔsa vɛ na Yehowa, mia Mawu la.<verse eid="JOL 2:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 2:15"/>Miku kpẽ le Zion!</para>
  <para style="q2" vid="JOL 2:15">Miɖo nutsitsidɔ kɔkɔe eye miyɔ takpekpe tɔxɛ.<verse eid="JOL 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 2:16"/>Miƒo ameawo nu ƒu;</para>
  <para style="q2" vid="JOL 2:16">mikɔ ameha la ŋuti, ame tsitsiwo,</para>
  <para style="q2" vid="JOL 2:16">ɖeviwo kple vi nonowo siaa.</para>
  <para style="q1" vid="JOL 2:16">Ŋugbetɔsrɔ̃ nedo tso eƒe xɔ me</para>
  <para style="q2" vid="JOL 2:16">eye ŋugbetɔ nedo go tso xɔ gã me.<verse eid="JOL 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 2:17"/>Nunɔla siwo subɔna le Yehowa ŋkume la</para>
  <para style="q2" vid="JOL 2:17">netsi tsitre ɖe ameawo kple vɔsamlekpui la dome,</para>
  <para style="q1" vid="JOL 2:17">afa avi ado gbe ɖa be, “Yehowa, kpɔ nublanui na wò dukɔ;</para>
  <para style="q2" vid="JOL 2:17">mègana wò domenyinu nazu fewuɖunu</para>
  <para style="q2" vid="JOL 2:17">kple ŋukpenanu le dukɔwo dome o.</para>
  <para style="q1" vid="JOL 2:17">Nu ka ta dukɔwo anɔ gbɔgblɔm be,</para>
  <para style="q2" vid="JOL 2:17">‘Afi ka woƒe Mawu la le?’ ”<verse eid="JOL 2:17"/></para>
  <para style="s1">Yehowa ƒe ŋuɖoɖo</para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 2:18"/>Ekema Yehowa aʋã ŋu ɖe dukɔ la nu,</para>
  <para style="q2" vid="JOL 2:18">eye wòakpɔ nublanui na eƒe amewo.<verse eid="JOL 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JOL 2:19"/>Yehowa aɖo eŋu be,</para>
  <para style="q1" vid="JOL 2:19">“Kpɔ ɖa, mele bli,</para>
  <para style="q2" vid="JOL 2:19">wain yeye kple ami ɖom ɖe mi be miaɖi ƒo.</para>
  <para style="q2" vid="JOL 2:19">Nyemagawɔ mi mianye fewuɖunu na dukɔwo azɔ o.<verse eid="JOL 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 2:20"/>“Maɖe asrafo siwo tso dzigbeme la ɖa le mia gbɔ,</para>
  <para style="q2" vid="JOL 2:20">matrɔ wo aɖo ɖe kuɖiɖinyigba kple gbegbe.</para>
  <para style="q1" vid="JOL 2:20">Matsɔ ŋgɔgbenɔlawo ade ɣedzeƒeƒu la me</para>
  <para style="q2" vid="JOL 2:20">eye matsɔ megbenɔlawo ade ɣetoɖoƒeƒu la me.</para>
  <para style="q2" vid="JOL 2:20">Ale woƒe ʋeʋẽ kũu la axɔ anyigba la dzi.”</para>
  <para style="b" vid="JOL 2:20"/>
  <para style="q1" vid="JOL 2:20">Vavã, Yehowa wɔ nukunu triakɔ aɖe.<verse eid="JOL 2:20"/></para>
  <para style="q2">
    <verse number="21" style="v" sid="JOL 2:21"/>Nye dukɔ, mègavɔ̃ o;</para>
  <para style="q2" vid="JOL 2:21">kpɔ dzidzɔ eye nàtso aseye azɔ</para>
  <para style="q1" vid="JOL 2:21">elabena Yehowa wɔ nukunu gãwo na wò.<verse eid="JOL 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOL 2:22"/>Mi gbemelãwo katã, migavɔ̃ o,</para>
  <para style="q2" vid="JOL 2:22">elabena lãnyiƒewo agada ama abe tsã ene.</para>
  <para style="q1" vid="JOL 2:22">Atiwo agatse ku eye gbotiwo kple wainkawo</para>
  <para style="q2" vid="JOL 2:22">agatse kplanyaa abe tsã ene.<verse eid="JOL 2:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOL 2:23"/>O, mi Ziontɔwo, dzi nedzɔ mi le Yehowa,</para>
  <para style="q2" vid="JOL 2:23">miaƒe Mawu la me!</para>
  <para style="q1" vid="JOL 2:23">Elabena tsidzadza si wòɖo ɖa la nye</para>
  <para style="q2" vid="JOL 2:23">eƒe tsɔtsɔke ƒe dzesi.</para>
  <para style="q1" vid="JOL 2:23">Adame kple kelemetsiwo adza ɖe ɖoɖo nu pɛpɛpɛ.<verse eid="JOL 2:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOL 2:24"/>Lu ayɔ lugbɔƒe fũu, eye wain</para>
  <para style="q2" vid="JOL 2:24">kple ami asɔ gbɔ ɖe nudzraɖoƒewo.<verse eid="JOL 2:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="JOL 2:25"/>“Magaɖo ƒe siwo ʋetsuviwo, ʋetrawo,</para>
  <para style="q2" vid="JOL 2:25">abɔwo kple ŋɔwo ɖu nu la teƒe na mi.</para>
  <para style="q1" vid="JOL 2:25">Woawoe nye nye aʋakɔ gã si medɔ ɖe mia ŋu.<verse eid="JOL 2:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOL 2:26"/>Miaɖu nu aɖi ƒo abe tsã ene</para>
  <para style="q2" vid="JOL 2:26">eye miakafu Yehowa, miaƒe Mawu la.</para>
  <para style="q1" vid="JOL 2:26">Miakafu Yehowa, miaƒe Mawu la ƒe ŋkɔ,</para>
  <para style="q2" vid="JOL 2:26">ame si wɔ nukunu siawo katã na mi.</para>
  <para style="q1" vid="JOL 2:26">Ŋu magakpe nye dukɔ azɔ o.<verse eid="JOL 2:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOL 2:27"/>Mianyae be mele afii le nye dukɔ Israel dome,</para>
  <para style="q2" vid="JOL 2:27">eye mianyae hã be nye Yehowa,</para>
  <para style="q2" vid="JOL 2:27">ɖeka hɔ̃ɔ koe nye miaƒe Mawu.</para>
  <para style="q1" vid="JOL 2:27">Ŋu magakpe nye dukɔ la azɔ o.<verse eid="JOL 2:27"/></para>
  <para style="s1">Yehowa ƒe ŋkeke</para>
  <para style="q1">
    <verse number="28" style="v" sid="JOL 2:28"/>“Le nu siawo megbe la,</para>
  <para style="q2" vid="JOL 2:28">matrɔ nye Gbɔgbɔ akɔ ɖe amewo katã dzi!</para>
  <para style="q1" vid="JOL 2:28">Mia viŋutsuwo kple nyɔnuwo agblɔ nya ɖi,</para>
  <para style="q2" vid="JOL 2:28">miaƒe ame tsitsiwo aku drɔ̃ewo</para>
  <para style="q2" vid="JOL 2:28">eye miaƒe ɖekakpuiwo akpɔ ŋutegawo.<verse eid="JOL 2:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOL 2:29"/>Matrɔ nye Gbɔgbɔ la akɔ ɖe nye subɔlawo katã dzi,</para>
  <para style="q2" vid="JOL 2:29">ŋutsuwo kple nyɔnuwo siaa dzi le ŋkeke mawo me<verse eid="JOL 2:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOL 2:30"/>eye mana dzesi wɔnukuwo nado ɖe dziƒo</para>
  <para style="q2" vid="JOL 2:30">kple anyigba dzi, siwo anye ʋu,</para>
  <para style="q2" vid="JOL 2:30">dzo kple dzudzɔ babla kɔtɔɔ.<verse eid="JOL 2:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOL 2:31"/>Ɣe ado viviti eye ɣleti atrɔ zu ʋu hafi Aƒetɔ la ƒe ŋkeke gã,</para>
  <para style="q2" vid="JOL 2:31">dziŋɔ la nava ɖo.<verse eid="JOL 2:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOL 2:32"/>Ame sia ame si yɔa Aƒetɔ la ƒe ŋkɔa la,</para>
  <para style="q2" vid="JOL 2:32">akpɔ ɖeɖe eye xɔname anɔ Zion towo dzi</para>
  <para style="q1" vid="JOL 2:32">kple Yerusalem kple ame siwo Aƒetɔ yɔ la dome</para>
  <para style="q2" vid="JOL 2:32">abe ale si Aƒetɔ la do ŋugbee la ene.<verse eid="JOL 2:32"/></para>
  <chapter eid="JOL 2"/>
  <chapter number="3" style="c" sid="JOL 3"/>
  <para style="s1">Ʋɔnudɔdrɔ̃ dukɔawo</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 3:1"/>“Le ŋkeke mawo kple ɣe ma ɣi me ne megaɖo Yuda</para>
  <para style="q2" vid="JOL 3:1">kple Yerusalem te la,<verse eid="JOL 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 3:2"/>maƒo dukɔwo nu ƒu ɖe Yehosafat ƒe Balime</para>
  <para style="q2" vid="JOL 3:2">eye madrɔ̃ ʋɔnu wo le afi ma</para>
  <para style="q1" vid="JOL 3:2">le nye amewo kple nye domenyinu Israel ta,</para>
  <para style="q2" vid="JOL 3:2">elabena wokaka nye domenyinu la ɖe dukɔwo dome</para>
  <para style="q2" vid="JOL 3:2">eye woma nye anyigba.<verse eid="JOL 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 3:3"/>“Wodzidze nu ɖe nye dukɔ dzi</para>
  <para style="q2" vid="JOL 3:3">eye woma nye amewo.</para>
  <para style="q1" vid="JOL 3:3">Wotsɔ ŋutsuviwo ɖɔli gbolowoe</para>
  <para style="q2" vid="JOL 3:3">eye wotsɔ nyɔnuviwo na ɖe wain si woano amu ta.<verse eid="JOL 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JOL 3:4"/>“Tiro kple Sidon kple Filistitɔwo ƒe duwo katã, ɖe miele didim be miabia hlɔ̃ mahã? Mikpɔ nyuie elabena nye asi atre tsɔtsɔ na mi eye nu si mieɖo la atrɔ adze miawo ŋutɔ ƒe ta dzi.<verse eid="JOL 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JOL 3:5"/>“Mieva lɔ nye klosalo kple sika kple nye kesinɔnu veviwo tsɔ yi ɖe miaƒe trɔ̃wo ƒe xɔwo mee. <verse eid="JOL 3:5"/><verse number="6" style="v" sid="JOL 3:6"/>Miedzra Yudatɔwo kple Yerusalemtɔwo na Trɔ̃subɔlawo eye wokplɔ wo dzoe le woawo ŋutɔ ƒe anyigba dzi yi didiƒe ke. <verse eid="JOL 3:6"/><verse number="7" style="v" sid="JOL 3:7"/>Gake magakplɔ wo agbɔe tso teƒe siwo katã wokplɔ wo yii eye maɖo nu vɔ̃ siwo katã miewɔ la teƒe na mi. <verse eid="JOL 3:7"/><verse number="8" style="v" sid="JOL 3:8"/>Matsɔ mia viŋutsuwo kple nyɔnuwo adzra na Yudatɔwo eye woawo hã adzra wo na Sabeatɔwo le didiƒe ke. Yehowae gblɔe.<verse eid="JOL 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 3:9"/>“Miɖe gbeƒã nu sia le dukɔwo dome be,</para>
  <para style="q2" vid="JOL 3:9">‘Midzra ɖo na aʋawɔwɔ!’</para>
  <para style="q1" vid="JOL 3:9">Mitia miaƒe asrafo kalẽtɔwo,</para>
  <para style="q2" vid="JOL 3:9">miƒo miaƒe aʋawɔlawo katã nu ƒu na aʋawɔwɔ.<verse eid="JOL 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 3:10"/>Mitsɔ miaƒe agblenuwo tu aʋawɔyiwoe</para>
  <para style="q2" vid="JOL 3:10">eye mitsɔ miaƒe hɛ gobɛwo tu akplɔwoe.</para>
  <para style="q1" vid="JOL 3:10">Ame gblɔewo negblɔ be,</para>
  <para style="q2" vid="JOL 3:10">‘Miawoe nye ŋusẽtɔwo.’<verse eid="JOL 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 3:11"/>Mi dukɔ siwo kaka ɖe afi sia afi,</para>
  <para style="q2" vid="JOL 3:11">miƒo mia ɖokuiwo nu ƒu ne miava.</para>
  <para style="b" vid="JOL 3:11"/>
  <para style="q1" vid="JOL 3:11">“O Yehowa, dɔ wò aʋakɔwo be woaɖiɖi ava anyi!<verse eid="JOL 3:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 3:12"/>“Miƒo dukɔwo nu ƒu;</para>
  <para style="q2" vid="JOL 3:12">mikplɔ wo va Yehosafat ƒe Balimee,</para>
  <para style="q1" vid="JOL 3:12">afi ma manɔ adrɔ̃ ʋɔnu wo katã.<verse eid="JOL 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 3:13"/>Azɔ nukuxahɛ newɔ eƒe dɔ</para>
  <para style="q2" vid="JOL 3:13">elabena nukuawo tsi vɔ</para>
  <para style="q2" vid="JOL 3:13">hele lalam na nuŋeɣi.</para>
  <para style="q1" vid="JOL 3:13">Miva, mifanya waintsetseawo,</para>
  <para style="q2" vid="JOL 3:13">elabena wainfiaƒe la yɔ,</para>
  <para style="q1" vid="JOL 3:13">eye waindzraɖoƒe la yɔ gbagba,</para>
  <para style="q2" vid="JOL 3:13">elabena woƒe nu tovowo wɔwɔ sɔ gbɔ.”<verse eid="JOL 3:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 3:14"/>Ame akpe akpewo le Nyametsotso ƒe Balime</para>
  <para style="q2" vid="JOL 3:14">elabena Yehowa ƒe Ŋkeke la tu aƒe le Nyametsotso Balime la.<verse eid="JOL 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 3:15"/>Ɣe kple ɣleti ado viviti eye ɣletiviwo magaklẽ o.<verse eid="JOL 3:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="JOL 3:16"/>Yehowa aɖe gbe tso Zion</para>
  <para style="q2" vid="JOL 3:16">eye eƒe gbe aɖi tso Yerusalem</para>
  <para style="q2" vid="JOL 3:16">eye dziƒo kple anyigba ade asi ʋuʋu me.</para>
  <para style="q1" vid="JOL 3:16">Ke Yehowa anye sitsoƒe na eƒe amewo</para>
  <para style="q2" vid="JOL 3:16">kple mɔ sesẽ na eƒe dukɔ Israel.<verse eid="JOL 3:16"/></para>
  <para style="s1">Yayra na Mawu ƒe amewo</para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 3:17"/>“Mlɔeba la, miava nya be</para>
  <para style="q2" vid="JOL 3:17">nyee nye Yehowa, miaƒe Mawu,</para>
  <para style="q2" vid="JOL 3:17">si le Zion, nye To Kɔkɔe la dzi.</para>
  <para style="q1" vid="JOL 3:17">Yerusalem azu kɔkɔeƒe;</para>
  <para style="q2" vid="JOL 3:17">ɣeyiɣi li gbɔna esi dutasrafowo</para>
  <para style="q2" vid="JOL 3:17">magakpɔ mɔ aho aʋa ɖe eŋu o.<verse eid="JOL 3:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 3:18"/>“Le ɣe ma ɣi me la, wain yeye anɔ tsyɔtsyɔm tso towo ŋuti</para>
  <para style="q2" vid="JOL 3:18">eye nyinotsi anɔ sisim bababa tso togbɛwo tame.</para>
  <para style="q1" vid="JOL 3:18">Tsi ayɔ Yɔdan tɔʋuwo me banaa,</para>
  <para style="q2" vid="JOL 3:18">eye tsi asi tso Yehowa ƒe gbedoxɔ la me ade tsi Sitim ƒe Balime.<verse eid="JOL 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 3:19"/>Egipte azu aƒedo eye Edom azu gbegbe</para>
  <para style="q2" vid="JOL 3:19">elabena wowɔ vɔ̃ ɖe Yudatɔwo ŋuti,</para>
  <para style="q1" vid="JOL 3:19">eye wokɔ ʋu maɖifɔwo ɖi le du mawo me.<verse eid="JOL 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 3:20"/>Ke Yuda anɔ anyi tegbetegbe,</para>
  <para style="q2" vid="JOL 3:20">eye Yerusalem anɔ anyi tso dzidzime yi dzidzime.<verse eid="JOL 3:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 3:21"/>Mahe to na Egiptetɔwo kple Edomtɔwo</para>
  <para style="q2" vid="JOL 3:21">ɖe woƒe ʋu maɖifɔ kɔkɔɖi ta.”</para>
  <para style="b" vid="JOL 3:21"/>
  <para style="qc" vid="JOL 3:21">Yehowa le Zion.<verse eid="JOL 3:21"/></para>
  <chapter eid="JOL 3"/>
</usx>
