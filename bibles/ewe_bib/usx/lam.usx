<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LAM" style="id">- Biblica® Open Ewe Contemporary Scriptures 2020</book>
  <para style="h">Konyifahawo</para>
  <para style="toc1">Yeremia ƒe Konyifahawo</para>
  <para style="toc2">Konyifahawo</para>
  <para style="toc3">Kon</para>
  <para style="mt2">Yeremia ƒe</para>
  <para style="mt1">Konyifahawo</para>
  <chapter number="1" style="c" sid="LAM 1"/>
  <para style="s1">Du si ɖi gbɔlo</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 1:1"/>“Aleke du si yɔ fũu</para>
  <para style="q2" vid="LAM 1:1">kple amewo tsã la ɖi gbɔlo ale!</para>
  <para style="q1" vid="LAM 1:1">Du si nye du gã le duwo dome la le azɔ</para>
  <para style="q2" vid="LAM 1:1">abe ahosi ene!</para>
  <para style="q2" vid="LAM 1:1">Duwo ƒe Fianyɔnu zu kluvi egbe.<verse eid="LAM 1:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 1:2"/>“Ele avi fam hehehe le zã me</para>
  <para style="q2" vid="LAM 1:2">eye aɖatsi tsi alɔgo dzi nɛ.</para>
  <para style="q1" vid="LAM 1:2">Eƒe ahiãvi gbogboawo dometɔ aɖeke meli afa akɔ nɛ o.</para>
  <para style="q2" vid="LAM 1:2">Xɔlɔ̃ lɔlɔ̃wo katã trɔ le eyome hezu eƒe futɔwo.<verse eid="LAM 1:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 1:3"/>“Le teteɖeanyi kple dzizizidɔ sesẽwo megbe la,</para>
  <para style="q2" vid="LAM 1:3">Yuda yi ɖe aboyo me.</para>
  <para style="q1" vid="LAM 1:3">Ele dukɔwo dome</para>
  <para style="q2" vid="LAM 1:3">gake mekpɔ gbɔɖemeƒe o.</para>
  <para style="q1" vid="LAM 1:3">Ame siwo katã le eyome tim la ke ɖe eŋu le xaxa me.<verse eid="LAM 1:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 1:4"/>“Zion mɔwo le konyi fam</para>
  <para style="q2" vid="LAM 1:4">elabena ame aɖeke megazɔa wo dzi yina ɖe</para>
  <para style="q2" vid="LAM 1:4">eƒe azãwo ɖuƒe o.</para>
  <para style="q1" vid="LAM 1:4">Eƒe agbowo gbã, eye eƒe nunɔlawo le hũu ɖem.</para>
  <para style="q2" vid="LAM 1:4">Eƒe ɖetugbiwo le konyi fam</para>
  <para style="q2" vid="LAM 1:4">eye eya ŋutɔ le veve helĩhelĩ me.<verse eid="LAM 1:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 1:5"/>“Eƒe futɔwo zu edziɖulawo</para>
  <para style="q2" vid="LAM 1:5">eye eƒe ketɔwo ɖe dzi ɖi.</para>
  <para style="q1" vid="LAM 1:5">Yehowa do hiã nɛ le eƒe nu vɔ̃ gbogboawo ta.</para>
  <para style="q2" vid="LAM 1:5">Viawo yi ɖe aboyo me,</para>
  <para style="q2" vid="LAM 1:5">eye wozu aʋaléleawo le futɔwo ŋgɔ.<verse eid="LAM 1:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 1:6"/>“Zion vinyɔnu ƒe atsyɔ̃wo katã dzo le eŋu.</para>
  <para style="q2" vid="LAM 1:6">Eƒe dumegãwo le abe zi siwo mekpɔ gbeɖuƒe aɖeke o,</para>
  <para style="q2" vid="LAM 1:6">eye le gbɔdzɔgbɔdzɔ me wosi le wo yometilawo ŋgɔ ene.<verse eid="LAM 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 1:7"/>“Yerusalem ɖo ŋku eƒe kesinɔnu siwo nɔ</para>
  <para style="q2" vid="LAM 1:7">esi le blemaŋkekewo me la dzi,</para>
  <para style="q1" vid="LAM 1:7">le eƒe xaxa kple tsaglalãtsatsa ƒe ŋkekewo me.</para>
  <para style="q2" vid="LAM 1:7">Esi eƒe amewo dze futɔwo ƒe asi me la,</para>
  <para style="q2" vid="LAM 1:7">ame aɖeke meli akpe ɖe eŋu o.</para>
  <para style="q1" vid="LAM 1:7">Eƒe futɔwo nye kɔ kpɔe eye wokoe le eƒe aƒedozuzu ta.<verse eid="LAM 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 1:8"/>“Yerusalem ƒe nu vɔ̃wo lolo eya ta wòzu ame makɔmakɔ.</para>
  <para style="q2" vid="LAM 1:8">Ame siwo dea bubu eŋu tsã la le vlo domi,</para>
  <para style="q2" vid="LAM 1:8">elabena wokpɔ eƒe amame,</para>
  <para style="q2" vid="LAM 1:8">eya ŋutɔ ɖe hũu hetrɔ dzo.<verse eid="LAM 1:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 1:9"/>“Eƒe ɖiƒoƒo lé ɖe eƒe avɔto,</para>
  <para style="q2" vid="LAM 1:9">elabena mebu etsɔ me kpɔ o.</para>
  <para style="q1" vid="LAM 1:9">Eƒe anyidzedze wɔ nuku</para>
  <para style="q2" vid="LAM 1:9">eye ame aɖeke meli si afa akɔ nɛ o.</para>
  <para style="b" vid="LAM 1:9"/>
  <para style="q1" vid="LAM 1:9">“O, Yehowa, nye kɔ, kpɔ nye vevesese ɖa</para>
  <para style="q2" vid="LAM 1:9">elabena ketɔ la ɖu dzi.”<verse eid="LAM 1:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 1:10"/>Futɔ la do asi ɖe eƒe kesinɔnuwo katã gbɔ;</para>
  <para style="q2" vid="LAM 1:10">ekpɔ trɔ̃subɔdukɔwo,</para>
  <para style="q1" vid="LAM 1:10">ame siwo mèɖe mɔ be woage ɖe wò asaɖa me o la</para>
  <para style="q2" vid="LAM 1:10">ge ɖe wò kɔkɔeƒe la.<verse eid="LAM 1:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 1:11"/>Eƒe amewo katã le tsatsam le abolo dim kple ŋeŋe,</para>
  <para style="q2" vid="LAM 1:11">wotsɔa woƒe kesinɔnu veviwo ɖɔa li nuɖuɖu be woanɔ agbe.</para>
  <para style="q1" vid="LAM 1:11">“O, Yehowa, kpɔ ale si wodo vlom la ɖa.”<verse eid="LAM 1:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 1:12"/>“Mi ame siwo katã to afi ma yi,</para>
  <para style="q2" vid="LAM 1:12">ɖe mewɔ naneke na mi oa?</para>
  <para style="q1" vid="LAM 1:12">Mitsa ŋku miakpɔe ɖa!</para>
  <para style="q2" vid="LAM 1:12">Ɖe fukpekpe aɖe le abe esi wohe va dzinye,</para>
  <para style="q1" vid="LAM 1:12">esi Yehowa he va dzinye le</para>
  <para style="q2" vid="LAM 1:12">eƒe dziku helĩhelĩ ƒe ŋkekewo me la enea?<verse eid="LAM 1:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 1:13"/>“Eɖo dzo ɖa tso dziƒo,</para>
  <para style="q2" vid="LAM 1:13">ena wòɖiɖi ɖe nye ƒuwo me.</para>
  <para style="q1" vid="LAM 1:13">Eɖo ɖɔ na nye afɔwo</para>
  <para style="q2" vid="LAM 1:13">eye wògbugbɔm ɖe megbe.</para>
  <para style="q1" vid="LAM 1:13">Ewɔm mezu gbegbe heku</para>
  <para style="q2" vid="LAM 1:13">ƒenyi ŋkeke blibo la katã.<verse eid="LAM 1:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 1:14"/>“Ebla nye nu vɔ̃wo abe kɔkuti ene,</para>
  <para style="q2" vid="LAM 1:14">etsɔ eƒe asiwo lɔ̃e wode nu wo nɔewo me.</para>
  <para style="q1" vid="LAM 1:14">Woɖiɖi ɖe nye kɔʋume</para>
  <para style="q2" vid="LAM 1:14">eye Aƒetɔ la ɖe nye ŋusẽ ɖa.</para>
  <para style="q1" vid="LAM 1:14">Etsɔm de asi na ame siwo nu nyemate ŋu anɔ te ɖo o.<verse eid="LAM 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 1:15"/>“Aƒetɔ la gbe nu</para>
  <para style="q2" vid="LAM 1:15">le kalẽtɔ siwo katã le donyeme la gbɔ,</para>
  <para style="q1" vid="LAM 1:15">eɖo aʋakɔ ɖa</para>
  <para style="q2" vid="LAM 1:15">be woato nye ɖekakpuiwo nyanyanya.</para>
  <para style="q1" vid="LAM 1:15">Le eƒe wainfiaƒe,</para>
  <para style="q2" vid="LAM 1:15">Aƒetɔ la fanya Yuda Vinyɔnuwo.<verse eid="LAM 1:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 1:16"/>“Esia ta mefa avi</para>
  <para style="q2" vid="LAM 1:16">eye nye ŋkuwo fa aɖatsi blobloblo.</para>
  <para style="q1" vid="LAM 1:16">Ame aɖeke metsɔ ɖe gbɔnye afa akɔ nam o</para>
  <para style="q2" vid="LAM 1:16">eye ame aɖeke meli si agbɔ agbe nye luʋɔ o.</para>
  <para style="q1" vid="LAM 1:16">Vinyewo zu hiãtɔwo</para>
  <para style="q2" vid="LAM 1:16">elabena futɔ ƒe alɔ yi dzi.”<verse eid="LAM 1:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 1:17"/>Zion ke eƒe abɔwo me gake</para>
  <para style="q2" vid="LAM 1:17">ame aɖeke meli si afa akɔ nɛ o.</para>
  <para style="q1" vid="LAM 1:17">Yehowa gblɔ nya ɖi ɖe Yakob ŋu be</para>
  <para style="q2" vid="LAM 1:17">eƒe aƒelikawo nanye eƒe futɔwo</para>
  <para style="q2" vid="LAM 1:17">eye Yerusalem va zu</para>
  <para style="q2" vid="LAM 1:17">ŋunyɔnu le wo dome.<verse eid="LAM 1:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 1:18"/>“Yehowa le dzɔdzɔe,</para>
  <para style="q2" vid="LAM 1:18">gake metsi tsitre ɖe eƒe se la ŋu.</para>
  <para style="q1" vid="LAM 1:18">Miɖo to, mi amewo katã,</para>
  <para style="q2" vid="LAM 1:18">mikpɔ nye fukpekpewo ɖa.</para>
  <para style="q1" vid="LAM 1:18">Nye ɖekakpuiwo kple ɖetugbiwo katã</para>
  <para style="q2" vid="LAM 1:18">yi aboyo me.<verse eid="LAM 1:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 1:19"/>“Meyɔ xɔ̃nyewo</para>
  <para style="q2" vid="LAM 1:19">gake woflum.</para>
  <para style="q1" vid="LAM 1:19">Nye nunɔlawo kple dumegãwo siaa</para>
  <para style="q2" vid="LAM 1:19">tsrɔ̃ le dua me</para>
  <para style="q1" vid="LAM 1:19">esime wonɔ tsatsam le nuɖuɖu dim</para>
  <para style="q2" vid="LAM 1:19">be woaɖu atsi agbe.<verse eid="LAM 1:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 1:20"/>“O Yehowa, kpɔ ale si metsi dzodzodzoe ɖa!</para>
  <para style="q2" vid="LAM 1:20">Nye ameti blibo la metɔtɔ</para>
  <para style="q1" vid="LAM 1:20">eye nye dzi hã le fu ɖem nam</para>
  <para style="q2" vid="LAM 1:20">elabena medze aglã vevie.</para>
  <para style="q1" vid="LAM 1:20">Yi le nu gblẽm le gota;</para>
  <para style="q2" vid="LAM 1:20">eye le eme la, ku koe li.<verse eid="LAM 1:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 1:21"/>“Amewo se nye ŋeŋe</para>
  <para style="q2" vid="LAM 1:21">gake ame aɖeke meli afa akɔ nam o.</para>
  <para style="q1" vid="LAM 1:21">Nye futɔwo katã se nye dzɔgbevɔ̃eŋkɔ</para>
  <para style="q2" vid="LAM 1:21">eye wodzɔ dzi le nu si nèwɔ ta.</para>
  <para style="q1" vid="LAM 1:21">Na be ŋkeke si ƒe gbeƒã nèɖe la nava</para>
  <para style="q2" vid="LAM 1:21">be woawo hã nanɔ abe nye ene.<verse eid="LAM 1:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 1:22"/>“Na be woƒe nu vɔ̃ɖi wɔwɔwo katã nava ŋkuwò me;</para>
  <para style="q2" vid="LAM 1:22">wɔ na wo</para>
  <para style="q1" vid="LAM 1:22">abe ale si nèwɔm</para>
  <para style="q2" vid="LAM 1:22">le nye nu vɔ̃wo katã ta la ene.</para>
  <para style="q1" vid="LAM 1:22">Nye hũuɖeɖe sɔ gbɔ</para>
  <para style="q2" vid="LAM 1:22">eye nu te nye dzi ŋuti.”<verse eid="LAM 1:22"/></para>
  <chapter eid="LAM 1"/>
  <chapter number="2" style="c" sid="LAM 2"/>
  <para style="s1">Mawu ƒe nyagblɔɖiwo va eme</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 2:1"/>Aleke Aƒetɔ la tsɔ eƒe dzikulilikpo</para>
  <para style="q2" vid="LAM 2:1">tsyɔ Zion vinyɔnu dzi nye esi!</para>
  <para style="q1" vid="LAM 2:1">Etsɔ Israel ƒe atsyɔ̃ tso dziƒo xlã ɖe anyigba dzi</para>
  <para style="q2" vid="LAM 2:1">eye meɖo ŋku eƒe afɔɖodzinu dzi le</para>
  <para style="q2" vid="LAM 2:1">eƒe dzikudogbe o.<verse eid="LAM 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 2:2"/>Aƒetɔ la gblẽ Yakob ƒe</para>
  <para style="q2" vid="LAM 2:2">nɔƒewo katã nublanuimakpɔmakpɔtɔe.</para>
  <para style="q1" vid="LAM 2:2">Eye le eƒe dziku me</para>
  <para style="q2" vid="LAM 2:2">wògbã Yuda vinyɔnu ƒe mɔ sesẽwo ƒu anyi.</para>
  <para style="q1" vid="LAM 2:2">Egbã eƒe fiaɖuƒe kple eƒe dumegãwo ƒu anyi le vlododo me.<verse eid="LAM 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 2:3"/>Etsɔ dziku helĩhelĩ helã</para>
  <para style="q2" vid="LAM 2:3">Israel ƒe dzo ɖe sia ɖe ɖa.</para>
  <para style="q1" vid="LAM 2:3">Esi futɔwo gbɔna mía gbɔ la,</para>
  <para style="q2" vid="LAM 2:3">eɖe eƒe nuɖusibɔ ɖa.</para>
  <para style="q1" vid="LAM 2:3">Ebi le Yakob me abe dzo bibi si fia</para>
  <para style="q2" vid="LAM 2:3">nu sia nu si ƒo xlãe la ene.<verse eid="LAM 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 2:4"/>Ehe eƒe da me abe futɔ ene</para>
  <para style="q2" vid="LAM 2:4">eye eƒe nuɖusibɔ le klalo.</para>
  <para style="q1" vid="LAM 2:4">Ewu ame siwo katã nyo na</para>
  <para style="q2" vid="LAM 2:4">eƒe ŋku abe ale si futɔ wɔnɛ ene.</para>
  <para style="q1" vid="LAM 2:4">Etrɔ eƒe dziku kɔ ɖe</para>
  <para style="q2" vid="LAM 2:4">Zion vinyɔnu ƒe agbadɔ dzi abe dzo ene.<verse eid="LAM 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 2:5"/>Aƒetɔ la zu futɔ eye wòtsrɔ̃ Israel.</para>
  <para style="q1" vid="LAM 2:5">Etsrɔ̃ eƒe fiasãwo katã</para>
  <para style="q2" vid="LAM 2:5">eye wògbã eƒe mɔ sesẽwo ƒu anyi.</para>
  <para style="q1" vid="LAM 2:5">Edzi Yuda vinyɔnu ƒe nuxaxa</para>
  <para style="q2" vid="LAM 2:5">kple konyifafa ɖe edzi.<verse eid="LAM 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 2:6"/>Ekaka eƒe nɔƒe abe ale si</para>
  <para style="q2" vid="LAM 2:6">wokakaa kpɔ le abɔ ŋu ene</para>
  <para style="q2" vid="LAM 2:6">hegblẽ eƒe takpeƒe.</para>
  <para style="q1" vid="LAM 2:6">Yehowa na Zion ŋlɔ eƒe ŋkekenyuiwo</para>
  <para style="q2" vid="LAM 2:6">kple Dzudzɔgbewo be</para>
  <para style="q1" vid="LAM 2:6">eye le eƒe dziku helĩhelĩ me</para>
  <para style="q2" vid="LAM 2:6">wòdo vlo fia la kple nunɔla siaa.<verse eid="LAM 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 2:7"/>Aƒetɔ la gbe nu le eƒe vɔsamlekpui</para>
  <para style="q2" vid="LAM 2:7">kple eƒe kɔkɔeƒe la gbɔ.</para>
  <para style="q1" vid="LAM 2:7">Etsɔ eƒe fiasãwo ƒe gliwo de asi na eƒe futɔwo</para>
  <para style="q2" vid="LAM 2:7">eye wodo ɣli sesĩe le Yehowa ƒe gbedoxɔ me</para>
  <para style="q2" vid="LAM 2:7">abe le ŋkekenyuiɖugbe ene.<verse eid="LAM 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 2:8"/>Yehowa ɖoe kplikpaa be</para>
  <para style="q2" vid="LAM 2:8">yeagbã gli le Zion vinyɔnu ŋu.</para>
  <para style="q1" vid="LAM 2:8">Etsɔ nudzidzeka ɖo eŋu</para>
  <para style="q2" vid="LAM 2:8">eye mehe eƒe asi ɖe megbe o,</para>
  <para style="q2" vid="LAM 2:8">ke boŋ egbãe gudugudu.</para>
  <para style="q1" vid="LAM 2:8">Ena be kpoƒuƒuwo kple gliwo siaa xa nu</para>
  <para style="q2" vid="LAM 2:8">eye wo kple eve la siaa mu dze anyi.<verse eid="LAM 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 2:9"/>Eƒe agbowo ɖo do ɖe anyigba</para>
  <para style="q2" vid="LAM 2:9">eye wòŋe eƒe gametiwo</para>
  <para style="q2" vid="LAM 2:9">kple gakpo siwo ŋu wobla wo ɖo.</para>
  <para style="q1" vid="LAM 2:9">Woɖe aboyo eƒe fia</para>
  <para style="q2" vid="LAM 2:9">kple dumegãwo ɖo ɖe dukɔwo dome,</para>
  <para style="q1" vid="LAM 2:9">se la megali o eye eƒe Nyagblɔɖilawo hã</para>
  <para style="q2" vid="LAM 2:9">megaxɔa ɖeɖefia tso Yehowa gbɔ o.<verse eid="LAM 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 2:10"/>Zion vinyɔnu ƒe dumegãwo nɔ anyi</para>
  <para style="q2" vid="LAM 2:10">ɖe anyigba le ɖoɖoezizi gã me.</para>
  <para style="q1" vid="LAM 2:10">Wolɔ dzofi kɔ ɖe tame</para>
  <para style="q2" vid="LAM 2:10">eye wota akpanya.</para>
  <para style="q1" vid="LAM 2:10">Ke Yerusalem ɖetugbiwo ya de mo to.<verse eid="LAM 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 2:11"/>Avifafa na nu te nye ŋkuwo ŋu,</para>
  <para style="q2" vid="LAM 2:11">nye lãme katã ʋu dzo ɖe menye,</para>
  <para style="q1" vid="LAM 2:11">nye dzi lolõ hekɔ ɖe anyigba,</para>
  <para style="q2" vid="LAM 2:11">elabena wotsrɔ̃ nye amewo,</para>
  <para style="q1" vid="LAM 2:11">eye nu ti kɔ na ɖeviwo</para>
  <para style="q2" vid="LAM 2:11">kple vidzĩwo siaa le dua ƒe kpɔdomewo.<verse eid="LAM 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 2:12"/>Wobia wo dadawo be,</para>
  <para style="q2" vid="LAM 2:12">“Afi ka abolo kple wain le?”</para>
  <para style="q1" vid="LAM 2:12">Elabena nu te wo ŋu le dua ƒe kpɔdomewo</para>
  <para style="q2" vid="LAM 2:12">abe ame siwo ŋu wode abi ene</para>
  <para style="q2" vid="LAM 2:12">eye woƒe agbe nu tso le wo dadawo ƒe akɔnu.<verse eid="LAM 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 2:13"/>Nya ka magblɔ na wò?</para>
  <para style="q2" vid="LAM 2:13">O Yerusalem vinyɔnu,</para>
  <para style="q2" vid="LAM 2:13">nu ka matsɔ asɔ kpli wò?</para>
  <para style="q1" vid="LAM 2:13">Nu ka magblɔ be ele abe wò ene,</para>
  <para style="q2" vid="LAM 2:13">ne mafa akɔ na wò,</para>
  <para style="q1" vid="LAM 2:13">O Zion vinyɔnu si menya ŋutsu o?</para>
  <para style="q2" vid="LAM 2:13">Wò abiwo goglo abe atsiaƒu ene,</para>
  <para style="q2" vid="LAM 2:13">ame ka ate ŋu ayɔ dɔ wò?<verse eid="LAM 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 2:14"/>Wò nyagblɔɖilawo ƒe ɖeɖefiawo</para>
  <para style="q2" vid="LAM 2:14">nye alakpa kple yakanyawo,</para>
  <para style="q1" vid="LAM 2:14">womeɖe wò nu vɔ̃wo fia wò,</para>
  <para style="q2" vid="LAM 2:14">be womagaɖo wò ɖe aboyo me o.</para>
  <para style="q1" vid="LAM 2:14">Ke gbedeasi si wona mi la nye aʋatso</para>
  <para style="q2" vid="LAM 2:14">eye wòkplɔ mi trae.<verse eid="LAM 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 2:15"/>Ame siwo katã va toa wò mɔ dzi yina la</para>
  <para style="q2" vid="LAM 2:15">si akpe ɖe ŋuwò,</para>
  <para style="q1" vid="LAM 2:15">woɖua fewu heʋuʋua ta ɖe wò</para>
  <para style="q2" vid="LAM 2:15">Yerusalem vinyɔnu ŋu be,</para>
  <para style="q1" vid="LAM 2:15">“Du siae woyɔna be tugbefia</para>
  <para style="q2" vid="LAM 2:15">kple anyigba blibo la ƒe dzidzɔa?”<verse eid="LAM 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 2:16"/>Wò futɔwo katã ke woƒe nuwo baa ɖe ŋuwò,</para>
  <para style="q2" vid="LAM 2:16">woɖua fewu eye woɖua aɖukli ɖe ŋuwò be,</para>
  <para style="q1" vid="LAM 2:16">“Míemi eya amea agbagbe.</para>
  <para style="q2" vid="LAM 2:16">Esiae nye ŋkeke si míele mɔ kpɔm na,</para>
  <para style="q2" vid="LAM 2:16">enyo be míele agbe kpɔ eteƒe.”<verse eid="LAM 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 2:17"/>Yehowa wɔ nu si wòɖo,</para>
  <para style="q2" vid="LAM 2:17">ena eƒe nya si wògblɔ ɖi</para>
  <para style="q2" vid="LAM 2:17">gbe aɖe gbe ʋĩi la va eme.</para>
  <para style="q1" vid="LAM 2:17">Etsɔ mi ƒu gbe nublanuimakpɔmakpɔtɔe,</para>
  <para style="q2" vid="LAM 2:17">ena futɔwo kpɔ dzidzɔ le miaƒe anyidzedze ta</para>
  <para style="q2" vid="LAM 2:17">eye wòkɔ míaƒe futɔwo ƒe dzo ɖe dzi bobobo.<verse eid="LAM 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 2:18"/>Ameawo ƒe dzi le ɣli dom na Aƒetɔ la.</para>
  <para style="q2" vid="LAM 2:18">O Zion vinyɔnu ƒe gli,</para>
  <para style="q1" vid="LAM 2:18">na be wò aɖatsiwo nasi</para>
  <para style="q2" vid="LAM 2:18">abe tɔsisi ene zã kple keli,</para>
  <para style="q1" vid="LAM 2:18">mègana gbɔdzɔe ɖokuiwò</para>
  <para style="q2" vid="LAM 2:18">alo ana dzudzɔ wò ŋkuwo o.<verse eid="LAM 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 2:19"/>Fɔ, fa avi le zã me,</para>
  <para style="q2" vid="LAM 2:19">dze egɔme ne zãdzɔɣi ƒe ga ƒo,</para>
  <para style="q1" vid="LAM 2:19">trɔ wò dzi kɔ ɖe Aƒetɔ la ƒe ŋkume abe tsi ene.</para>
  <para style="q2" vid="LAM 2:19">Tsɔ wò abɔwo do ɖe dzi</para>
  <para style="q1" vid="LAM 2:19">nɛ le viwòwo ƒe agbe ta,</para>
  <para style="q2" vid="LAM 2:19">ame siwo dɔwuame</para>
  <para style="q2" vid="LAM 2:19">na wole kukum le kpɔdomewo.<verse eid="LAM 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 2:20"/>“O Yehowa, ɖo ŋku anyi nàkpɔ nu.</para>
  <para style="q2" vid="LAM 2:20">Ame ka nèwɔ alea kpɔ?</para>
  <para style="q1" vid="LAM 2:20">Ɖe nyɔnuwo aɖu woƒe dɔmevi,</para>
  <para style="q2" vid="LAM 2:20">vi siwo dzi wokpɔa?</para>
  <para style="q1" vid="LAM 2:20">Ɖe wòle be woawu nunɔla</para>
  <para style="q2" vid="LAM 2:20">kple Nyagblɔɖila le Aƒetɔ la ƒe kɔkɔeƒea?<verse eid="LAM 2:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 2:21"/>“Ɖeviwo kple tsitsiawo siaa</para>
  <para style="q2" vid="LAM 2:21">ɖo baba ɖe anyigba le kpɔdomewo,</para>
  <para style="q2" vid="LAM 2:21">nye ɖekakpuiwo kple ɖetugbiwo tsi yi nu.</para>
  <para style="q1" vid="LAM 2:21">Ewu wo le wò dzikudogbe,</para>
  <para style="q2" vid="LAM 2:21">etsrɔ̃ wo nublanuimakpɔmakpɔtɔe.<verse eid="LAM 2:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 2:22"/>“Abe ale si nèyɔa amewo hena ŋkekenyuiɖuɖu ene la,</para>
  <para style="q2" vid="LAM 2:22">nenemae nèyɔ ŋɔdzi be wòaƒo xlãm godoo.</para>
  <para style="q1" vid="LAM 2:22">Le Yehowa ƒe dzikuŋkekea dzi la,</para>
  <para style="q2" vid="LAM 2:22">ame aɖeke mesi alo tsi agbe o.</para>
  <para style="q1" vid="LAM 2:22">Ame siwo mehe eye menyi la</para>
  <para style="q2" vid="LAM 2:22">nye futɔ tsrɔ̃ wo katã.”<verse eid="LAM 2:22"/></para>
  <chapter eid="LAM 2"/>
  <chapter number="3" style="c" sid="LAM 3"/>
  <para style="s1">Mawu ƒe lɔlɔ̃ si li tegbee</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 3:1"/>Nyee nye ŋutsu si kpe fu le eƒe dziku ƒe ameƒoti te.<verse eid="LAM 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 3:2"/>Enyam ɖe nu eye wòna mezɔ viviti me,</para>
  <para style="q2" vid="LAM 3:2">menye kekeli me o;<verse eid="LAM 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 3:3"/>Vavã etrɔ eƒe asiwo ɖe ŋutinye atraɖii</para>
  <para style="q2" vid="LAM 3:3">le ŋkeke blibo la me.<verse eid="LAM 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 3:4"/>Ena be nye ŋutilã kple nye ŋutigbalẽ do xoxo</para>
  <para style="q2" vid="LAM 3:4">eye wògbã ƒu ɖe lãme nam.<verse eid="LAM 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 3:5"/>Eva dze dzinye eye wòtsɔ veve helĩhelĩ</para>
  <para style="q2" vid="LAM 3:5">kple fukpekpe tɔ kpɔ ɖe ŋunye.<verse eid="LAM 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 3:6"/>Ena menɔ viviti me</para>
  <para style="q2" vid="LAM 3:6">abe ame siwo ku gbe aɖe gbe ke ene.<verse eid="LAM 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 3:7"/>Etɔ kpɔ ƒo xlãm ale be nyemate ŋu asi o,</para>
  <para style="q2" vid="LAM 3:7">eɖom anyi kple gakɔsɔkɔsɔ.<verse eid="LAM 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 3:8"/>Ne meyɔe alo do ɣli be wòaxɔ nam gɔ̃ hã la,</para>
  <para style="q2" vid="LAM 3:8">edoa ʋɔ ɖe nye gbedodoɖa nu.<verse eid="LAM 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 3:9"/>Etsɔ kpe gãwo xe mɔ me nam</para>
  <para style="q2" vid="LAM 3:9">eye wòglɔ̃ nye mɔwo.<verse eid="LAM 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 3:10"/>Abe sisiblisi si de xa ɖi</para>
  <para style="q2" vid="LAM 3:10">kple dzata si le adeklo dzi ene la,<verse eid="LAM 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 3:11"/>ehem ɖa le mɔ me eye wòvuvum,</para>
  <para style="q2" vid="LAM 3:11">hegblẽm ɖi kpeɖeŋutɔmanɔsitɔe.<verse eid="LAM 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 3:12"/>Evu eƒe da me eye wòdzidze</para>
  <para style="q2" vid="LAM 3:12">eƒe dati ɖe dzinye.<verse eid="LAM 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 3:13"/>Etsɔ aŋutrɔwo le eƒe daku me tsɔ ŋɔ nye dzi.<verse eid="LAM 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 3:14"/>Mezu nu ɖikokoe le nye amewo katã dome,</para>
  <para style="q2" vid="LAM 3:14">woɖua fewu le ŋunye to hadzidzi me ŋkeke blibo la katã.<verse eid="LAM 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 3:15"/>Etsɔ ama veve ɖi ƒo nam</para>
  <para style="q2" vid="LAM 3:15">eye wòkpe veve nam meno.<verse eid="LAM 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 3:16"/>Etsɔ kpe ŋe aɖu nam</para>
  <para style="q2" vid="LAM 3:16">eye wòfanyam ɖe kewɔ me.<verse eid="LAM 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 3:17"/>Woxɔ ŋutifafa le asinye,</para>
  <para style="q2" vid="LAM 3:17">meŋlɔ nu si dzɔgbenyui nye la be.<verse eid="LAM 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 3:18"/>Eya ta megblɔ be,</para>
  <para style="q2" vid="LAM 3:18">“Nye atsyɔ̃nu yi eye nu siwo katã</para>
  <para style="q2" vid="LAM 3:18">mele mɔ kpɔm na tso Yehowa gbɔ la hã nu va yi.”<verse eid="LAM 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 3:19"/>Meɖo ŋku nye hiã, tsaglalãtsatsa,</para>
  <para style="q2" vid="LAM 3:19">dzigbagbã kple vevesese dzi.<verse eid="LAM 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 3:20"/>Meɖo ŋku wo katã dzi nyuie</para>
  <para style="q2" vid="LAM 3:20">eye nye luʋɔ bɔbɔ eɖokui le menye.<verse eid="LAM 3:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 3:21"/>Ke esia dzi meɖo ŋkue</para>
  <para style="q2" vid="LAM 3:21">eye mɔkpɔkpɔ ɖo asinye:<verse eid="LAM 3:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 3:22"/>Le Yehowa ƒe lɔlɔ̃ deto la ta wometsrɔ̃ mí o</para>
  <para style="q2" vid="LAM 3:22">elabena eƒe nublanuikpɔkpɔ mevɔna o.<verse eid="LAM 3:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="LAM 3:23"/>Wozua yeye ŋdi sia ŋdi,</para>
  <para style="q2" vid="LAM 3:23">wò nuteƒewɔwɔ lolo ŋutɔ.<verse eid="LAM 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="LAM 3:24"/>Megblɔ na ɖokuinye be,</para>
  <para style="q2" vid="LAM 3:24">“Yehowae nye nye gomekpɔkpɔ,</para>
  <para style="q2" vid="LAM 3:24">eya ta manɔ esinu kpɔm.”<verse eid="LAM 3:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="LAM 3:25"/>Yehowa ƒe dɔ me nyo na ame siwo tsɔ</para>
  <para style="q2" vid="LAM 3:25">woƒe mɔkpɔkpɔ da ɖe edzi,</para>
  <para style="q2" vid="LAM 3:25">kple ame siwo dinɛ vevie.<verse eid="LAM 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="LAM 3:26"/>Enyo be woalala le ɖoɖoezizi me</para>
  <para style="q2" vid="LAM 3:26">na Yehowa ƒe ɖeɖe.<verse eid="LAM 3:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="LAM 3:27"/>Enyo na ame be wòatsɔ kɔkuti le ɖekakpuime.<verse eid="LAM 3:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="LAM 3:28"/>Nenɔ anyi le ɖoɖoezizi me</para>
  <para style="q2" vid="LAM 3:28">elabena Yehowae tsɔ kɔkuti la da ɖe edzi.<verse eid="LAM 3:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="LAM 3:29"/>Netsɔ eƒe mo ƒo ɖe ke me,</para>
  <para style="q2" vid="LAM 3:29">ɖewohĩ mɔkpɔkpɔ gali.<verse eid="LAM 3:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="LAM 3:30"/>Neɖo to me anyi na ame si le eƒo ge</para>
  <para style="q2" vid="LAM 3:30">eye ŋukpe neyɔe fũu.<verse eid="LAM 3:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="LAM 3:31"/>Elabena Aƒetɔ la metsɔa ame ƒua gbe ɖikaa o<verse eid="LAM 3:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="LAM 3:32"/>Togbɔ be ehea nuxaxa vɛ hã la,</para>
  <para style="q2" vid="LAM 3:32">egakpɔa nublanui na ame,</para>
  <para style="q2" vid="LAM 3:32">eye eƒe lɔlɔ̃ si nu metsina gbeɖe o la de to ŋutɔ.<verse eid="LAM 3:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="LAM 3:33"/>Elabena mehea fukpekpe kple nuxaxa vaa amegbetɔviwo dzi ɖe dzidzɔ teƒe o.<verse eid="LAM 3:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="LAM 3:34"/>Woafanya anyigbadzigamenɔlawo katã kple afɔ.<verse eid="LAM 3:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="LAM 3:35"/>Ne woagbe nu si nye ame tɔ la</para>
  <para style="q2" vid="LAM 3:35">tsɔtsɔ nɛ le Dziƒoʋĩtɔ la ŋkume,<verse eid="LAM 3:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="LAM 3:36"/>eye wotrɔ gbo ame dzɔdzɔe ƒe nya;</para>
  <para style="q2" vid="LAM 3:36">ɖe Aƒetɔ la makpɔ esiawo oa?<verse eid="LAM 3:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="LAM 3:37"/>Ame ka aƒo nu eye wòava eme,</para>
  <para style="q2" vid="LAM 3:37">ne menye Aƒetɔ lae ɖe gbe o?<verse eid="LAM 3:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="LAM 3:38"/>Ɖe menye Dziƒoʋĩtɔ la ƒe nu mee dzɔgbevɔ̃enyawo</para>
  <para style="q2" vid="LAM 3:38">kple dzidzɔnyawo siaa doa go tsona oa?<verse eid="LAM 3:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="LAM 3:39"/>Nu ka ta amegbetɔ ahe nya ne</para>
  <para style="q2" vid="LAM 3:39">wohe to nɛ ɖe eƒe nu vɔ̃wo ta?<verse eid="LAM 3:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="LAM 3:40"/>Mina míalé ŋku ɖe míaƒe zɔzɔme ŋu ne míado wo akpɔ</para>
  <para style="q2" vid="LAM 3:40">eye mina míatrɔ ɖe Yehowa ŋu.<verse eid="LAM 3:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="LAM 3:41"/>Mina míado míaƒe dziwo</para>
  <para style="q2" vid="LAM 3:41">kple asiwo ɖe Mawu gbɔ le dziƒo ahagblɔ bena:<verse eid="LAM 3:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="LAM 3:42"/>“Míewɔ nu vɔ̃ hedze aglã</para>
  <para style="q2" vid="LAM 3:42">eye mètsɔe ke mi o.<verse eid="LAM 3:42"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="43" style="v" sid="LAM 3:43"/>“Ètsɔ dziku tsyɔ ɖokuiwò dzi</para>
  <para style="q2" vid="LAM 3:43">eye nèti mía yome hewu mí nublanuimakpɔmakpɔtɔe.<verse eid="LAM 3:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="LAM 3:44"/>Ètsɔ lilikpo tsyiɔ ɖokuiwò dzi ale be,</para>
  <para style="q2" vid="LAM 3:44">gbedodoɖa aɖeke mate ŋu aɖo gbɔwò o.<verse eid="LAM 3:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="LAM 3:45"/>Ètsɔ mí wɔ ŋunyɔnu</para>
  <para style="q2" vid="LAM 3:45">kple gbeɖuɖɔe le dukɔwo dome.<verse eid="LAM 3:45"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="46" style="v" sid="LAM 3:46"/>“Míaƒe futɔwo katã ke nu baa ɖe mía ŋuti.<verse eid="LAM 3:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="LAM 3:47"/>Ŋɔdzi lé mí; míedze ʋe me eye tsɔtsrɔ̃</para>
  <para style="q2" vid="LAM 3:47">kple gbegblẽ va mía dzi.”<verse eid="LAM 3:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="LAM 3:48"/>Nye ŋkuwo le aɖatsi fam yoyoyo</para>
  <para style="q2" vid="LAM 3:48">elabena wotsrɔ̃ nye amewo.<verse eid="LAM 3:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="LAM 3:49"/>Nye ŋkuwo le aɖatsi fam ɖaa,</para>
  <para style="q2" vid="LAM 3:49">enu gbe tsotso,<verse eid="LAM 3:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="LAM 3:50"/>va se ɖe esime Yehowa aɖo ŋku anyi tso dziƒo akpɔe.<verse eid="LAM 3:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="LAM 3:51"/>Nu si mekpɔ la na nye luʋɔ xa nu</para>
  <para style="q2" vid="LAM 3:51">ɖe nyɔnu siwo katã le nye dua me la ta.<verse eid="LAM 3:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="LAM 3:52"/>Ame siwo nye nye futɔwo madzemadzee la</para>
  <para style="q2" vid="LAM 3:52">ɖem ɖe nu abe xevi ene.<verse eid="LAM 3:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="LAM 3:53"/>Wodze agbagba be woatso nye agbe nu</para>
  <para style="q2" vid="LAM 3:53">le vudo me eye wofɔ kpe ƒum.<verse eid="LAM 3:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="LAM 3:54"/>Tsi fie le tanye eye mesusu be evɔ nam.<verse eid="LAM 3:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="LAM 3:55"/>O Yehowa, wò ŋkɔe meyɔ le vudoa ƒe gogloƒe ke.<verse eid="LAM 3:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="LAM 3:56"/>Èse nye kukuɖeɖe be,</para>
  <para style="q2" vid="LAM 3:56">“Mègado toku nye ɣlidodo</para>
  <para style="q2" vid="LAM 3:56">eye nàgbe akɔfafa nam o.”<verse eid="LAM 3:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="LAM 3:57"/>Ète va gbɔnye esi meyɔ wò eye nègblɔ be,</para>
  <para style="q2" vid="LAM 3:57">“Mègavɔ̃ o.”<verse eid="LAM 3:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="LAM 3:58"/>O, Aƒetɔ, èxɔ nye nya ɖe akɔ</para>
  <para style="q2" vid="LAM 3:58">eye nèɖe nye agbe.<verse eid="LAM 3:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="LAM 3:59"/>Wò ŋutɔ èkpɔ, O Yehowa,</para>
  <para style="q2" vid="LAM 3:59">vɔ̃ si wowɔ ɖe ŋutinye.</para>
  <para style="q2" vid="LAM 3:59">Na nye nya nadzɔ!<verse eid="LAM 3:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="LAM 3:60"/>Èkpɔ woƒe hlɔ̃biabia ƒe kpekpeme</para>
  <para style="q2" vid="LAM 3:60">kple nugbe siwo woɖo ɖe ŋunye.<verse eid="LAM 3:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="LAM 3:61"/>O Yehowa, èse woƒe dzudzuwo</para>
  <para style="q2" vid="LAM 3:61">kple nu siwo katã woɖo ɖe ŋunye<verse eid="LAM 3:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="LAM 3:62"/>kple nye futɔwo ƒe dalĩdodo</para>
  <para style="q2" vid="LAM 3:62">kple nuƒoƒo le ŋunye ŋkeke blibo la.<verse eid="LAM 3:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="LAM 3:63"/>Nye kɔ nàkpɔ wo ɖa!</para>
  <para style="q2" vid="LAM 3:63">Wole anyinɔƒe o, wole tsitrenu o,</para>
  <para style="q2" vid="LAM 3:63">woɖua fewu le ŋunye le woƒe hadzidziwo me.<verse eid="LAM 3:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="LAM 3:64"/>O Yehowa, xe fe si dze wo la na wo,</para>
  <para style="q2" vid="LAM 3:64">ɖe nu siwo woƒe asiwo wɔ la ta.<verse eid="LAM 3:64"/></para>
  <para style="q1">
    <verse number="65" style="v" sid="LAM 3:65"/>Tsɔ nutsyɔnu tsyɔ woƒe dziwo dzi</para>
  <para style="q2" vid="LAM 3:65">eye nàna be wò fiƒode nanɔ wo dzi!<verse eid="LAM 3:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="LAM 3:66"/>Ti wo yome kple dziku</para>
  <para style="q2" vid="LAM 3:66">eye nàtsrɔ̃ wo le Yehowa ƒe dziƒo te.<verse eid="LAM 3:66"/></para>
  <chapter eid="LAM 3"/>
  <chapter number="4" style="c" sid="LAM 4"/>
  <para style="s1">Zion ƒe tohehe</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 4:1"/>Aleke sika bu eƒe keklẽ</para>
  <para style="q2" vid="LAM 4:1">eye sika nyui nyɔ vĩ ale!</para>
  <para style="q1" vid="LAM 4:1">Wokaka kpe kɔkɔeawo ɖe kpɔdome</para>
  <para style="q2" vid="LAM 4:1">ƒe dzogoewo katã dzi.<verse eid="LAM 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 4:2"/>Aleke Zion viŋutsu vevi</para>
  <para style="q2" vid="LAM 4:2">siwo ŋu kpekpeme nɔ tsã abe sika ene la,</para>
  <para style="q2" vid="LAM 4:2">le azɔ abe anyize si nye zemela ƒe asinudɔwɔwɔ ene!<verse eid="LAM 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 4:3"/>Amegaxiwo kekeake gɔ̃ hã naa no wo viwo wonona</para>
  <para style="q2" vid="LAM 4:3">gake nye amewo va zu ŋlɔmitɔwo</para>
  <para style="q2" vid="LAM 4:3">abe tsatsaboli le dzogbe ene.<verse eid="LAM 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 4:4"/>Tsikɔ na be vidzĩwo ƒe aɖe lé ɖe nu me na wo;</para>
  <para style="q2" vid="LAM 4:4">ɖevi suewo bia abolo kple kukuɖeɖe</para>
  <para style="q2" vid="LAM 4:4">gake ame aɖeke meli ana wo o.<verse eid="LAM 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 4:5"/>Ame siwo ɖu nu vivi kpeɖiwo tsã la,</para>
  <para style="q2" vid="LAM 4:5">zu ame ɖigbɔ̃wo le kpɔdomewo.</para>
  <para style="q1" vid="LAM 4:5">Ame siwo ta ago veviwo tsã la,</para>
  <para style="q2" vid="LAM 4:5">mlɔ gbeɖuɖɔ me fifia.<verse eid="LAM 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 4:6"/>Nye amewo ƒe tohehe lolo wu Sodom tɔ,</para>
  <para style="q2" vid="LAM 4:6">du si wogbã ƒu anyi le aɖabaƒoƒo ɖeka me</para>
  <para style="q2" vid="LAM 4:6">eye asi aɖeke meli akpe ɖe eŋu o.<verse eid="LAM 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 4:7"/>Woƒe dumegãwo da dzo wu sno,</para>
  <para style="q2" vid="LAM 4:7">wofu wu nyinotsi,</para>
  <para style="q1" vid="LAM 4:7">woƒe ŋutilã biã wu soe</para>
  <para style="q2" vid="LAM 4:7">eye woƒe dzedzeme le abe gbloti ene.<verse eid="LAM 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 4:8"/>Ke azɔ la, wonyɔ wu zemabi</para>
  <para style="q2" vid="LAM 4:8">eye ame aɖeke gɔ̃ hã medzea si wo le kpɔdomewo o.</para>
  <para style="q1" vid="LAM 4:8">Woƒe ŋutigbalẽ lé ɖe woƒe ƒu ŋuti kpaɖii,</para>
  <para style="q2" vid="LAM 4:8">eye woƒu abe nake ene.<verse eid="LAM 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 4:9"/>Ame siwo tsi yi nu la tɔ nyo wu</para>
  <para style="q2" vid="LAM 4:9">ame siwo ku ɖe dɔwuame ta.</para>
  <para style="q1" vid="LAM 4:9">Elabena dɔwuame na wogbɔdzɔ,</para>
  <para style="q2" vid="LAM 4:9">heɖiku glãŋui,</para>
  <para style="q2" vid="LAM 4:9">le agblemenuku ƒe anyimanɔmanɔ ta.<verse eid="LAM 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 4:10"/>Nyɔnu siwo ame ƒe nu wɔa nublanui na la tsɔ</para>
  <para style="q2" vid="LAM 4:10">woawo ŋutɔ ƒe asiwo lé wo viwo ɖa,</para>
  <para style="q2" vid="LAM 4:10">eye wozu nuɖuɖu na wo esi wonɔ nye amewo tsrɔ̃m.<verse eid="LAM 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 4:11"/>Yehowa nyɔ eƒe dziku ƒe aɖi katã</para>
  <para style="q2" vid="LAM 4:11">eye wòtrɔ eƒe dɔmedzoe helĩhelĩ kɔ ɖi.</para>
  <para style="q1" vid="LAM 4:11">Edo dzo ɖe Zion</para>
  <para style="q2" vid="LAM 4:11">eye wòfia eƒe gɔmeɖokpewo.<verse eid="LAM 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 4:12"/>Anyigbadzifiawo mexɔe se kaka,</para>
  <para style="q2" vid="LAM 4:12">amewo nayi exɔ ge ase be,</para>
  <para style="q1" vid="LAM 4:12">futɔwo kple ketɔwo ate ŋu age ɖe</para>
  <para style="q2" vid="LAM 4:12">Yerusalem ƒe agbowo me o.<verse eid="LAM 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 4:13"/>Gake edzɔ, le eƒe Nyagblɔɖilawo ƒe nu vɔ̃</para>
  <para style="q2" vid="LAM 4:13">kple eƒe nunɔlawo ƒe nu tovowo ta,</para>
  <para style="q2" vid="LAM 4:13">ame siwo kɔ ame dzɔdzɔewo ƒe ʋu ɖe dua me.<verse eid="LAM 4:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 4:14"/>Azɔ wole asi tsam le kpɔdomewo</para>
  <para style="q2" vid="LAM 4:14">abe ŋkuagbãtɔwo ene.</para>
  <para style="q1" vid="LAM 4:14">Woƒo ʋu ale gbegbe be,</para>
  <para style="q2" vid="LAM 4:14">ame aɖeke medo dzi ka asi woƒe awuwo ŋuti o.<verse eid="LAM 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 4:15"/>Amewo doa ɣli ɖe wo ta be,</para>
  <para style="q2" vid="LAM 4:15">“Midzo le afi sia!</para>
  <para style="q1" vid="LAM 4:15">Mi ame makɔmakɔwo!</para>
  <para style="q2" vid="LAM 4:15">Mite yi! Mite yi!</para>
  <para style="q1" vid="LAM 4:15">Migaka asi mía ŋuti o!”</para>
  <para style="q2" vid="LAM 4:15">Ke esi wosi dzo le tsaglãla tsam la,</para>
  <para style="q1" vid="LAM 4:15">amewo le dukɔwo me gblɔna na wo be,</para>
  <para style="q2" vid="LAM 4:15">“Womate ŋu aganɔ teƒe sia o.”<verse eid="LAM 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 4:16"/>Yehowa ŋutɔe kaka wo,</para>
  <para style="q2" vid="LAM 4:16">megale wo ta kpɔm o.</para>
  <para style="q1" vid="LAM 4:16">Womegadea bubu nunɔlawo ŋu</para>
  <para style="q2" vid="LAM 4:16">alo vea dumegãwo nu o.<verse eid="LAM 4:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 4:17"/>Gawu la, ɖeɖi te míaƒe ŋkuwo ŋu</para>
  <para style="q2" vid="LAM 4:17">esi wole mɔ kpɔm na kpekpeɖeŋu si meli o;</para>
  <para style="q1" vid="LAM 4:17">tso míaƒe gbetakpɔxɔwo me,</para>
  <para style="q2" vid="LAM 4:17">míekpɔ mɔ na dukɔ si mate ŋu</para>
  <para style="q2" vid="LAM 4:17">aɖe mí o la be wòava.<verse eid="LAM 4:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 4:18"/>Amewo le ŋku lém ɖe míaƒe afɔɖeɖe</para>
  <para style="q2" vid="LAM 4:18">ɖe sia ɖe ŋu ale gbegbe be,</para>
  <para style="q1" vid="LAM 4:18">míagate ŋu ado go azɔ</para>
  <para style="q2" vid="LAM 4:18">le míaƒe ablɔwo dzi o.</para>
  <para style="q1" vid="LAM 4:18">Míaƒe nuwuwu tu aƒe,</para>
  <para style="q2" vid="LAM 4:18">woxlẽ míaƒe ŋkekewo</para>
  <para style="q2" vid="LAM 4:18">elabena míaƒe nuwuwu va ɖo.<verse eid="LAM 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 4:19"/>Ame siwo le mía yome tim la</para>
  <para style="q2" vid="LAM 4:19">ɖia du wu hɔ̃ le yame;</para>
  <para style="q1" vid="LAM 4:19">woti mía yome le towo dzi</para>
  <para style="q2" vid="LAM 4:19">eye wode xa ɖi na mí le gbegbe.<verse eid="LAM 4:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 4:20"/>Yehowa ƒe amesiamina la,</para>
  <para style="q2" vid="LAM 4:20">si nye míaƒe agbegbɔgbɔ gɔ̃ hã ge ɖe woƒe mɔ me.</para>
  <para style="q1" vid="LAM 4:20">Míebu xaa be le eƒe vɔvɔli te la,</para>
  <para style="q2" vid="LAM 4:20">míanɔ dedie le dukɔwo dome.<verse eid="LAM 4:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 4:21"/>O, Edom vinyɔnu, tso aseye,</para>
  <para style="q2" vid="LAM 4:21">wò ame si le Uznyigba dzi.</para>
  <para style="q1" vid="LAM 4:21">Gake wòe woatsɔ kplu la ade asi na,</para>
  <para style="q2" vid="LAM 4:21">amu wò eye woaɖe ama wò.<verse eid="LAM 4:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 4:22"/>O, Zion vinyɔnu, wò tohehe awu enu,</para>
  <para style="q2" vid="LAM 4:22">wò aboyomenɔnɔ magadzi ɖe edzi o.</para>
  <para style="q1" vid="LAM 4:22">Gake O, Edom vinyɔnu ahe to na wò nu vɔ̃wo</para>
  <para style="q2" vid="LAM 4:22">eye wòaɖe wò vɔ̃ɖinyenye ɖe go.<verse eid="LAM 4:22"/></para>
  <chapter eid="LAM 4"/>
  <chapter number="5" style="c" sid="LAM 5"/>
  <para style="s1">Kukuɖeɖe na nublanuikpɔkpɔ</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 5:1"/>O, Yehowa, ɖo ŋku nu si dzɔ ɖe mía dzi la dzi,</para>
  <para style="q2" vid="LAM 5:1">ɖo ŋku anyi eye nàkpɔ míaƒe ŋukpe ɖa.<verse eid="LAM 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 5:2"/>Wotsɔ míaƒe domenyinu,</para>
  <para style="q2" vid="LAM 5:2">na amedzrowo eye wotsɔ míaƒe aƒewo</para>
  <para style="q2" vid="LAM 5:2">na du bubu me tɔwo.<verse eid="LAM 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 5:3"/>Míezu tsyɔ̃eviwo kple tɔmanɔsitɔwo</para>
  <para style="q2" vid="LAM 5:3">eye mía nɔwo zu ahosiwo.<verse eid="LAM 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 5:4"/>Ɖe míedzea tsi hafi nona</para>
  <para style="q2" vid="LAM 5:4">eye ɖe míeƒlea míawo ŋutɔ ƒe nake.<verse eid="LAM 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 5:5"/>Ame siwo ti mía yome la gogo,</para>
  <para style="q2" vid="LAM 5:5">ɖeɖi te mía ŋu, ke gbɔɖeme meli o.<verse eid="LAM 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 5:6"/>Míetsɔ mía ɖokui dzra na Egipte</para>
  <para style="q2" vid="LAM 5:6">kple Asiria be míakpɔ abolo aɖu.<verse eid="LAM 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 5:7"/>Mía fofowo wɔ nu vɔ̃ eye womegale agbe o</para>
  <para style="q2" vid="LAM 5:7">gake woƒe tohehe va mía dzi.<verse eid="LAM 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 5:8"/>Kluviwo ɖu amegã ɖe mía dzi</para>
  <para style="q2" vid="LAM 5:8">eye ame aɖeke meli axɔ mí le woƒe asi me o.<verse eid="LAM 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 5:9"/>Míetsɔ míaƒe agbe ɖo anyi hafi kpɔa abolo ɖuna,</para>
  <para style="q2" vid="LAM 5:9">le yi si le gbegbe la ta.<verse eid="LAM 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 5:10"/>Míaƒe ŋutilã xɔ dzo abe kpodzo ene</para>
  <para style="q2" vid="LAM 5:10">eye asrã lé mí le dɔwuame ta.<verse eid="LAM 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 5:11"/>Wogblẽ Zion nyɔnuwo</para>
  <para style="q2" vid="LAM 5:11">kple ɖetugbi manyaŋutsuwo le Yuda duwo me.<verse eid="LAM 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 5:12"/>Wobla dumegãwo tsɔ ku ati</para>
  <para style="q2" vid="LAM 5:12">eye womede bubu ame tsitsiwo ŋu o.<verse eid="LAM 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 5:13"/>Ɖekakpuiwo le te tum atraɖii,</para>
  <para style="q2" vid="LAM 5:13">eye ŋutsuviwo le ŋeŋem le nakegba te.<verse eid="LAM 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 5:14"/>Ame tsitsiwo vɔ le agbonu</para>
  <para style="q2" vid="LAM 5:14">eye ɖekakpuiwo ƒe hadzidzi nu tso.<verse eid="LAM 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 5:15"/>Dzidzɔ vavã dzo le míaƒe dziwo me</para>
  <para style="q2" vid="LAM 5:15">eye míaƒe ɣeɖuɖu trɔ zu nuxaxa.<verse eid="LAM 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 5:16"/>Fiakuku ge le ta na mí.</para>
  <para style="q2" vid="LAM 5:16">Baba na mí elabena míewɔ nu vɔ̃!<verse eid="LAM 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 5:17"/>Le esia ta míaƒe dziwo le nu xam,</para>
  <para style="q2" vid="LAM 5:17">le nu siawo ta míaƒe ŋkuwo dzi tsyɔ,<verse eid="LAM 5:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 5:18"/>Elabena Zion to tsi ƒuƒlu</para>
  <para style="q2" vid="LAM 5:18">eye amegaxiwo koe le fefem le afi ma.<verse eid="LAM 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 5:19"/>O, Yehowa, èle fia ɖum tegbee,</para>
  <para style="q2" vid="LAM 5:19">wò fiazikpui li ke tso dzidzime yi dzidzime.<verse eid="LAM 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 5:20"/>Nu ka ta nèŋlɔa mí be ɣe sia ɣi?</para>
  <para style="q2" vid="LAM 5:20">Nu ka ta nègblẽ mi ɖi eteƒe didi alea?<verse eid="LAM 5:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 5:21"/>O Yehowa, trɔ mí ɖe ɖokuiwò ŋu</para>
  <para style="q2" vid="LAM 5:21">be míate ŋu atrɔ agbɔ,</para>
  <para style="q2" vid="LAM 5:21">wɔ míaƒe ŋkekewo yeye abe le blema ene.<verse eid="LAM 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 5:22"/>Ne menye ɖe nègbe mí keŋkeŋ,</para>
  <para style="q2" vid="LAM 5:22">eye nèdo dziku ɖe mía ŋu wu ale si dze hã o.<verse eid="LAM 5:22"/></para>
  <chapter eid="LAM 5"/>
</usx>
