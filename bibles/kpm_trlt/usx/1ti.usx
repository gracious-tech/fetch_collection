  <book code="1TI" style="id">EN_TRLT kpm_Koho_ltr Sat Jul 12 2025 10:05:57 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">1 Timothy</para>
  <para style="toc1">Sră Pơyoa dơ̆ dul Timôthe</para>
  <para style="toc2">1 Timôthe</para>
  <para style="toc3">1Ti</para>
  <para style="mt">1 Timôthe</para>
  <chapter number="1" style="c" sid="1TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1" />Pol, cro gơnoăr bơtău dơng Yang Dŏng-Klàs Jesu dê jăt jơno gơnoăr pơđơ Yang Tơm Trồ dê, Yang Dŏng-Klàs ƀòn mơ̆n, la Yang Dŏng-Klàs Jesu, jơno cang-kơnơm ƀòn mơ̆n, <verse eid="1TI 1:1" /><verse number="2" style="v" sid="1TI 1:2" />pơyoa ma Timôthe, kon ngăn ăñ dê nơ̆m jơno don: Dăn kon dî jơno sơmah, jơno kơloh-kơlài, jơno lơngăp-lơnge bơh Yang Tơm Trồ, la Bàp î Yang Dŏng-Klàs Jesu, Yang ƀòn mơ̆n.<verse eid="1TI 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3" />Jăt gư̆ptî jơno ăñ sŏng bơtău tơngkah kon lơh tơm tô̆ ăñ swà gung trôh Maseđoan, kon ăm wăl cĕ nơ̆m Ephesô lơi pơđơ ma lơ̆gay cro năy ơ̆ dî bơtău jơno pơđơ nde, <verse eid="1TI 1:3" /><verse number="4" style="v" sid="1TI 1:4" />kŭng bư̆ng kơlôi-sơnư̆ng trôh lơ̆gay jơno gơlîng-gơlang gư̆m lơ̆gay sră cêh sơnăn nŏk-noi ơ̆ lơ̆, la lơ̆gay jơno lơh gôjîng tơmbơkai ơ̆ lơh kwơ găy ma bră ăt-bồ hîh Yang Tơm Trồ, la bră lơh bơh jơno don. <verse eid="1TI 1:4" /><verse number="5" style="v" sid="1TI 1:5" />Mơya tơnggumăy jơno gơnoăr pơđơ dô la jơno kơñ-kơloh tơlôh bơh nùs sang-goh î nùs-nhơ̆m niem băl î jơno tơpăt-ngăn, <verse eid="1TI 1:5" /><verse number="6" style="v" sid="1TI 1:6" />mà du pơnah cro, bơh sơloah tơnggumăy, sŏng lơi căư lơ̆gay jơno dô lơi kơlôi trôh bră bơyê jơno wì-lơngôh, <verse eid="1TI 1:6" /><verse number="7" style="v" sid="1TI 1:7" />kơñ lơh jîng cro bơtău jơno-bơlăm, tơm tô̆ ơ̆ wơng lơ̆gay jơno sătan mơ̆n tơs hala jơno sătan gô lơh nên.<verse eid="1TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8" />Mơya, ƀòn mơ̆n gư̆t lah jơno-bơlăm la niem dilah cro găy ngui gô dubă niem tơpăt, <verse eid="1TI 1:8" /><verse number="9" style="v" sid="1TI 1:9" />bơh gư̆t jơno dô, gư̆n la jơno bơlăm ơ̆ dî ăn ma cro tơpăt-durư̆ng, mà e ma cro ơ̆ jăt jơno-bơlăm î cro tơmdră, cro ơ̆ don jơno î tồi-glài, cro ơ̆ don Yang î cro tìs-glài î Yang, cro tơngsơ̆t bàp î tơngsơ̆t mơi, cro tơngsơ̆t cro, <verse eid="1TI 1:9" /><verse number="10" style="v" sid="1TI 1:10" />cro rês-àr bơnan, cro-klo adoă cro-klo cro-ua adoă cro-ua, cro kơ̆p kơntô̆ng brău cro, cro tơs blăc, cro lơh cư̆ng-tang blăc, î lơ̆gay jơno nde găy tơmdră î jơno ƀăn mơntău tơpăt-ngăn, <verse eid="1TI 1:10" /><verse number="11" style="v" sid="1TI 1:11" />jăt bơh Jơno Niem gơklŏ Yang Tơm Trồ dê păl jong-rơ, la jơno mà ăñ sŏng dî jao.<verse eid="1TI 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12" />Ăñ ưnngai Bơtao e gơnoăr pran ma ăñ, rơ̆ la Yang Dŏng-Klàs Jesu, Yang ƀòn mơ̆n, bơh Kơnràñ sŏng swì nên ăñ la don-tơpăt, tơm tô̆ ăn lơi ăñ lơh nơ̆m gơnoăr bră, <verse eid="1TI 1:12" /><verse number="13" style="v" sid="1TI 1:13" />bulah bơh lai ăñ la cro tìs-glài î Yang Tơm Trồ, kơ̆p rôn-bơklơ̆n î bờk-mơsăk, mơya ăñ sŏng dî kơloh-kơlài bơh tơm tô̆ ndăng ơ̆ wơng gư̆t, ăñ sŏng lơh nơ̆m jơno ơ̆ don. <verse eid="1TI 1:13" /><verse number="14" style="v" sid="1TI 1:14" />Mơya, jơno sơmah Yang ƀòn mơ̆n la dubă tơngkah-tơngkăñ khăi ngăn băl î jơno don gư̆m jơno kơñ-kơloh nơ̆m Yang Dŏng-Klàs Jesu.<verse eid="1TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 1:15" />Jơno Bơtău dô la don nên ngăn gư̆m păl dî dưñ-lăñ wêl-tăl, rơ̆ la: “Yang Dŏng-Klàs Jesu sŏng trôh nơ̆m dunya lơi dŏng-klàs cro glài” — mà nơ̆m gư̆n ăñ la cro bơlăm-găl. <verse eid="1TI 1:15" /><verse number="16" style="v" sid="1TI 1:16" />Mơya, tài bơh jơno dô ăñ sŏng dî kơloh-kơlài, rơ̆ la lơi Yang Dŏng-Klàs Jesu digơlăn sơđah tơlôh lơ̆gay nùs kŏng-ăt nơ̆m ăñ, cro glài bờk-mơsăk bơlăm-găl, gư̆ptî du rồp sơntu ma tơmpôl cro rơp don anẵu Kơnràñ lơi dî jơno jîng miek miek. <verse eid="1TI 1:16" /><verse number="17" style="v" sid="1TI 1:17" />Dăn jơno jong-rơ î jơno gơklŏ gôtrê ma Bơtao lơ̆gay kơp rai, la Yang Tơm Trồ nư̆ng dul hôm miek miek ơ̆ sơ̆t, ơ̆ tơmpơl dî trôh dî miek miek ơ̆ lôi. Amen.<verse eid="1TI 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18" />Timôthe, kon ăñ, ăñ jao jơno gơnoăr pơđơ dô ma kon, jăt lơ̆gay jơno cro gơnoăr-hwơr bơh lai sŏng tơs bơh kon, lơi kơnơm bơh gư̆n, kon digơlăn mơ̆t tơmlơh nơ̆m jơno tơmlơh dơng-ryŭ, <verse eid="1TI 1:18" /><verse number="19" style="v" sid="1TI 1:19" />tơm tô̆ prăp jư jơno don î nùs-nhơ̆m niem, mà du êt cro, bơh lơi căư, sŏng lơh jơno don sătan kŏng krăm ha-ău, <verse eid="1TI 1:19" /><verse number="20" style="v" sid="1TI 1:20" />nơ̆m khà gư̆n la Himene î Aleksandrơ, la tơmpôl cro mà ăñ sŏng phi jao ma Satan lơi ƀòn gô digơlăn bơtê gư̆t lơi ơ̆ tìs-glài î Yang Tơm Trồ.<verse eid="1TI 1:20" /></para>
  <chapter eid="1TI 1" />
  <chapter number="2" style="c" sid="1TI 2" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1" />Gư̆n-jîng, lai ngăn, ăñ bơtău tơngkah lơ̆gay jơno răc-dăn, hôi-dăn, hôi-dăn ala, ưnngai ma lơ̆gay cro, <verse eid="1TI 2:1" /><verse number="2" style="v" sid="1TI 2:2" />ma lơ̆gay bơtao î lơ̆gay cro ndăng ăm nơ̆m gơnoăr ăt-bồ, lơi ƀòn mơ̆n digơlăn jîng du rai-jîng lơngăp-lơnge î lơnge nơ̆m jơno don-duh î iyŏ ngăn nơ̆m lơ̆gay jơno. <verse eid="1TI 2:2" /><verse number="3" style="v" sid="1TI 2:3" />Gư̆n la jơno niem î iyŏ ngăn sơđàp măt Yang Tơm Trồ, Yang Dŏng-Klàs ƀòn mơ̆n, <verse eid="1TI 2:3" /><verse number="4" style="v" sid="1TI 2:4" />la Bơtao kơp kơñ lơ̆gay cro dî dŏng-klàs î swà trôh anẵu wơng gư̆t jơno-tơpăt. <verse eid="1TI 2:4" /><verse number="5" style="v" sid="1TI 2:5" />Bơh tom nư̆ng du hôi Yang Tơm Trồ î du hôi Bơtao ăm nơ̆m nhòng Yang Tơm Trồ î kon-mơnùs, gư̆n la Yang Dŏng-Klàs Jesu, la mơnùs; <verse eid="1TI 2:5" /><verse number="6" style="v" sid="1TI 2:6" />la Bơtao sŏng phi sătan mơ̆n lơh jơno ăn tơwai-glài ma lơ̆gay cro, gư̆ptî jơno cư̆ng-tang nơ̆m ñăm tô̆ tơnge, <verse eid="1TI 2:6" /><verse number="7" style="v" sid="1TI 2:7" />bơh jơno cư̆ng-tang gư̆n mà ăñ sŏng dî pồ lơh jîng cro bơtău jơno niem î cro gơnoăr bơtău dơng — ăñ tơs ngăn nơ̆m Yang Dŏng-Klàs, ăñ ơ̆ tơs blăc — rơ̆ la lơh jîng cro bơtău ma lơ̆gay cro lang bol bơdih bơh jơno don î jơno-tơpăt.<verse eid="1TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8" />Gư̆n-jîng, ăñ kơp kơñ tơmpôl cro klo ăm nơ̆m kơp anẵu păl hôi-dăn, e tê niem lơhiê cŭngsî bư̆ng dôh nùs î tơmbơkai <verse eid="1TI 2:8" /><verse number="9" style="v" sid="1TI 2:9" />jăt gư̆p tîgư̆n, lơ̆gay cro-ua păl mhơ̆ her sătan mơ̆n nơ̆m ôi-ao dubă dî păl î nùs kŏng-ăt î tơng-êt să, ơ̆-iyŏ bơh î bră tơmpă sŏ, dẵu màh, lô̆ mang, hala ôi-ao màng-ryŭ, <verse eid="1TI 2:9" /><verse number="10" style="v" sid="1TI 2:10" />mà bơh î lơ̆gay jơno găy iyŏ ngăn her î cro-ua sơnăn dêh să gô la cro duh kơ̆mbrit Yang Tơm Trồ kơnơm bơh bră niem-lơhơn.<verse eid="1TI 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 2:11" />Cro-ua păl bơtê nơ̆m jơno ăm-ƀơt, nơ̆m jơno don-duh wêl-tăl. <verse eid="1TI 2:11" /><verse number="12" style="v" sid="1TI 2:12" />Pơnah nde, ăñ ơ̆ e gơnoăr cro-ua ƀăn mơntău hala ngui jơno gơnoăr pơđơ nơ̆m cro-klo, mà păl ăm-ƀơt. <verse eid="1TI 2:12" /><verse number="13" style="v" sid="1TI 2:13" />Bơh Ađam sŏng dî mon bơjîng lai, sŏng gư̆n gư̆n trôh Eba, <verse eid="1TI 2:13" /><verse number="14" style="v" sid="1TI 2:14" />gừn Ađam ơ̆ kŏng jơno pơlum, mơya cro-ua la cro kŏng jơno pơlum swà trôh anẵu tìs-glài. <verse eid="1TI 2:14" /><verse number="15" style="v" sid="1TI 2:15" />Mơya, cro-ua rơp dî dŏng-klàs kơnơm bơh bră bơda kon, dilah ƀòn gô kư̆ ăm nơ̆m jơno don, jơno kơñ-kơloh î jơno sang-goh, î nùs-nhơ̆m tơng-êt să.<verse eid="1TI 2:15" /></para>
  <chapter eid="1TI 2" />
  <chapter number="3" style="c" sid="1TI 3" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1" />Jơno dô la păl don nên-nôn ngăn “Dilah cro găy gư̆n kơñ lơh jîng cro jư mpôl, gừn cro rơ̆ kơp kơñ du bră niem.” <verse eid="1TI 3:1" /><verse number="2" style="v" sid="1TI 3:2" />Gư̆n-jîng, cro jư mpôl păl la cro ơ̆ dî anẵu găy ƀoah dî, bo-klo nư̆ng sî du hôi bo-ua, gư̆t kơhea, gư̆t jư să, rơndăp tăp seng, gư̆t wă-rẵu năc, dî gơnoăr ƀăn mơntău, <verse eid="1TI 3:2" /><verse number="3" style="v" sid="1TI 3:3" />ơ̆ jròk ñô alăk, ơ̆ lơh rhŭng-rhăng, mà păl niem-lơhơn, lơbăn-niem, ơ̆ ham-hà jên-priè, <verse eid="1TI 3:3" /><verse number="4" style="v" sid="1TI 3:4" />ăt-bồ niem hîh nhă mơ̆n, dî kon so don-duh î lơ̆gay nùs kingam <verse eid="1TI 3:4" /><verse number="5" style="v" sid="1TI 3:5" />(bơh dilah du hôi cro ơ̆ gư̆t ăt-bồ hîh nhă mơ̆n, gừn amơh cro rơ̆ rơp rong-siem Hîh Jư̆m Goh Yang Tơm Trồ dê?), <verse eid="1TI 3:5" /><verse number="6" style="v" sid="1TI 3:6" />ơ̆-iyŏ la cro don Yang mhăy, lơi cro rơ̆ ơ̆ pơnhừ-să mà kŏng nơ̆m jơno cahrña gư̆ptî cà-ràk. <verse eid="1TI 3:6" /><verse number="7" style="v" sid="1TI 3:7" />Tơblơ̆ wăl, cro jư mpôl kŭng păl dî jơno lơh cư̆ng niem î cro makin Hîh Jư̆m Goh, lơi cro rơ̆ ơ̆ duh nơ̆m jơno tơngyŏ-tơnghiel î jơno ƀai kơ̆ndăp cà-ràk dê.<verse eid="1TI 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8" />Jăt gư̆p tîgư̆n, lơ̆gay cro dŏng gar hîh jư̆m păl jư jơno tơs, ơ̆ tơs bea dẵư, ơ̆ jròt ñô alăk, ơ̆ ham-hà, <verse eid="1TI 3:8" /><verse number="9" style="v" sid="1TI 3:9" />prăp jư jơno ndăp-ndơ jơno don bơh î nùs-nhơ̆m sang-goh. <verse eid="1TI 3:9" /><verse number="10" style="v" sid="1TI 3:10" />Pơnah nde, ƀòn gô kŭng păl dî lòng lai, sŏng bơh gư̆n lơi ƀòn gô duh bră tơm tô̆ ơ̆ kŏng ƀoah-đas.<verse eid="1TI 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 3:11" />Tơmpôl bo-ua kŭng tîgư̆n, păl jư jơno tơs, ơ̆ tơs bờk, niem-lơhơn, gư̆m don-tơpăt nơ̆m lơ̆gay jơno.<verse eid="1TI 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 3:12" />Lơ̆gay cro dŏng gar hîh jư̆m păl la bo-klo nư̆ng du hôi bo-ua, ăt-bồ niem kon so î lơ̆gay hîh nhă mơ̆n. <verse eid="1TI 3:12" /><verse number="13" style="v" sid="1TI 3:13" />Bơh tơmpôl cro duh bră niem iyà wăl ma sătan mơ̆n tieng pơndrơ niem î nùs don pran-kơdăng nơ̆m jơno don anẵu Yang Dŏng-Klàs Jesu.<verse eid="1TI 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14" />Ăñ cêh nhẵư jơno dô ma kon, kơp kơñ trôh còp kon khơñ ngăn, <verse eid="1TI 3:14" /><verse number="15" style="v" sid="1TI 3:15" />mơya dilah ăñ ƀăt trôh, gừn kon digơlăn păl gư̆t lơh tîgay nơ̆m hîh Yang Tơm Trồ dê, mà rơ̆ la Hîh Jư̆m Goh Yang Tơm Trồ jîng miek, jrŏng î mơnang jơno-tơpăt dê. <verse eid="1TI 3:15" /><verse number="16" style="v" sid="1TI 3:16" />Jơno ndăp-ndơ gôtrê bơh jơno don-duh la dơng mang ngăn ơ̆ tơmbơkai dî, la:</para>
  <para style="q2" vid="1TI 3:16">“Bơtao dî sơđah tơlôh nhòng să-jăn,</para>
  <para style="q2" vid="1TI 3:16">dî sơnăn tơpăt-durư̆ng nơ̆m Yang hwîng Goh,</para>
  <para style="q2" vid="1TI 3:16">dî lăng tơmpơl bơh cro gơndrơh,</para>
  <para style="q2" vid="1TI 3:16">dî tơs tơnggư̆t nhòng lơ̆gay lang bol,</para>
  <para style="q2" vid="1TI 3:16">dî don kơnơm nơ̆m dunya,</para>
  <para style="q2" vid="1TI 3:16">dî iyà swà cŭngsî nhòng jơno gơklŏ.”<verse eid="1TI 3:16" /></para>
  <chapter eid="1TI 3" />
  <chapter number="4" style="c" sid="1TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1" />Yang Hwîng tơs nê̆-năn lah nơ̆m tô̆ tơnge ma-ngkơi dô, khăi cro rơp lơi căư jơno don, kơnău jăt lơ̆gay jơno cà pơlum î gung duh-khoai cà-ràk dê, <verse eid="1TI 4:1" /><verse number="2" style="v" sid="1TI 4:2" />bơh jơno ma blăc tơmpôl blăc blơ̆, nùs-nhơ̆m tơmpôl ƀòn gư̆n kŏng kră kơdăng, <verse eid="1TI 4:2" /><verse number="3" style="v" sid="1TI 4:3" />tơm tô̆ khă bră tơmhòp bo, dăn ăt sa lơ̆gay jơno sa mà Yang Tơm Trồ mon bơjîng lơi dưñ-lăñ î nùs gư̆t ưnngai bơh cro don-kơnơm î wơng gư̆t jơno tơpăt-ngăn. <verse eid="1TI 4:3" /><verse number="4" style="v" sid="1TI 4:4" />Bơh lơ̆gay jơno bơh Yang Tơm Trồ bơjîng la niem lơhơn, gừn ơ̆ tom jơno găy păl mbư̆ng lơi căư tơm tô̆ dî dưñ-lăñ bơh î nùs ưnngai, <verse eid="1TI 4:4" /><verse number="5" style="v" sid="1TI 4:5" />bơh jơno sa dî lơh sang-goh kơnơm bơh jơno tơs Yang Tơm Trồ î jơno hôi-dăn.<verse eid="1TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6" />Tơm tô̆ ăn lơ̆gay jơno gư̆n sơđàp măt oh mi rôh lŏ, kon rơp la cro dê̆-gơna lơbăn-niem Yang Dŏng-Klàs Jesu dê, dî rong-siem bơh jơno don î bơh jơno bơtău niem-lơhơn mà kon sŏng don jăt. <verse eid="1TI 4:6" /><verse number="7" style="v" sid="1TI 4:7" />Mơya lơi căư cĕ lơ̆gay bră dơm lơh lîng-lang tơmpôl mò kra dê. Ala sơgư̆n, bơtê cĕ sătan mơ̆n nhòng jơno don-duh, <verse eid="1TI 4:7" /><verse number="8" style="v" sid="1TI 4:8" />bơh “jơno bơtê să-jăn gừn dî kwơ nơ̆m du êt tô̆ tơnge, mơya bơtê nùs don-duh gừn dî kwơ ma lơ̆gay bră, bơh tom jơno hăư ma rai dô î rai ma-ngkơi.” <verse eid="1TI 4:8" /><verse number="9" style="v" sid="1TI 4:9" />Jơno gư̆n la păl don kơnơm nên-nôn ngăn î păl dưñ-lăñ wêl-tăl, <verse eid="1TI 4:9" /><verse number="10" style="v" sid="1TI 4:10" />tài bơh jơno dô mà ƀòn mơ̆n sơòs-sơngeh lơh bră î tơmlơh, bơh ƀòn mơ̆n ăn jơno cang-kơnơm anẵu Yang Tơm Trồ jîng miek, Kơnràñ la Yang Dŏng-Klàs lơ̆gay kơp cro, sơm ngăn la cro don Yang.<verse eid="1TI 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11" />Bơtău tơngkah cĕ î ƀăn mơntău lơ̆gay jơno gư̆n. <verse eid="1TI 4:11" /><verse number="12" style="v" sid="1TI 4:12" />Bư̆ng lơi cro găy lăng ơ̆săp-ơ̆său rai pơnu kon, mà păl lơh krơh ma lơ̆gay cro don Yang, nơ̆m jơno tơs, nơ̆m jơno bră lơh, nơ̆m jơno kơñ-kơloh, nơ̆m jơno don, nơ̆m jơno sang-goh. <verse eid="1TI 4:12" /><verse number="13" style="v" sid="1TI 4:13" />Jơdeh-jơdai cĕ nơ̆m bră đŏk sră, bơtău tơngkah, ƀăn mơntău trôh dî jơ ăñ trôh. <verse eid="1TI 4:13" /><verse number="14" style="v" sid="1TI 4:14" />Bư̆ng hwơbê̆ jơno sơmah ăm nhòng kon, la jơno sơmah sŏng dî e ma kon kơnơm bơh jơno tơs cro gơnoăr-hwơr, băl î jơno ăn tê lơ̆gay cro kwăng kra.<verse eid="1TI 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 4:15" />Bơtê cĕ lơ̆gay jơno gư̆n, lăng nê̆-năn cĕ nơ̆m gô, lơi jơno sî nge sî gư̆t kon gôjîng loh-lang sơđàp măt lơ̆gay cro. <verse eid="1TI 4:15" /><verse number="16" style="v" sid="1TI 4:16" />Kơhea cĕ să tơm kon î bră ƀăn mơntău. Păl kơđư̆ng-bơkhê nơ̆m lơ̆gay bră gư̆n, bơh lơh tîgư̆n rơp dŏng-klàs dî băl î sătan mơ̆n gư̆m tơmpôl cro kơnău kon.<verse eid="1TI 4:16" /></para>
  <chapter eid="1TI 4" />
  <chapter number="5" style="c" sid="1TI 5" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1" />Bư̆ng kơjơ̆ dẵư î tơmpôl ông dơng năm, mơya păl ƀăn tơngkah ƀòn gô gư̆ptî bàp, cro pơnu gừn gư̆ptî oh mi, <verse eid="1TI 5:1" /><verse number="2" style="v" sid="1TI 5:2" />tơmpôl mò dơng năm gừn gư̆ptî mơi, lơ̆gay cro-ua drôh gừn gư̆ptî rôh lŏ, nơ̆m jơno sang-goh wêl-tăl.<verse eid="1TI 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3" />Kingam cĕ lơ̆gay cro mơ̆ndro — lơ̆gay cro mơ̆ndro ngăn. <verse eid="1TI 5:3" /><verse number="4" style="v" sid="1TI 5:4" />Mơya dilah cro-ua mơ̆ndro găy dî kon hala so, gừn lai ngăn kon so ƀòn gô păl bơtê lơi kingam cro hîh nhă mơ̆n dê, î e nùs tăm wăl ma cro lơh mơi lơh bàp gư̆n, bơh dô la jơno iyŏ ngăn sơđàp măt Yang Tơm Trồ. <verse eid="1TI 5:4" /><verse number="5" style="v" sid="1TI 5:5" />Mơya, cro-ua mơ̆ndro ngăn gừn nư̆ng du hôi mơ̆n, gừn ăm cang-kơnơm anẵu Yang Tơm Trồ, î jơh nùs nơ̆m jơno răc-dăn î hôi-dăn tơnge-tơmăng. <verse eid="1TI 5:5" /><verse number="6" style="v" sid="1TI 5:6" />Hôm cro jôi jăt jơno sơhờp-sờhơn gừn sŏng sơ̆t, bulah la hôm jîng. <verse eid="1TI 5:6" /><verse number="7" style="v" sid="1TI 5:7" />Kŭng tơs wăl cĕ lơ̆gay gơnoăr pơđơ dô, lơi ƀòn gô digơlăn ơ̆ tom anẵu găy ƀoah-đas dî. <verse eid="1TI 5:7" /><verse number="8" style="v" sid="1TI 5:8" />Mơya dilah cro găy gư̆n ơ̆ rcăng ma cro găp să gô, mà lai ngăn la cro hîh nhă gô, gừn cro rơ̆ sŏng khan lơi căư jơno don î la cro bờk rlo ma cro ơ̆ don.<verse eid="1TI 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9" />Du hôi cro-ua mơ̆ndro păl dî cêh sơnăn gừn ơ̆ êt rlo pro-jư̆t năm, la bo-ua nư̆ng du hôi bo-klo, <verse eid="1TI 5:9" /><verse number="10" style="v" sid="1TI 5:10" />dî swì lăng bơh lơ̆gay bră niem; mò tom rong-siem kon so ya, mò tom wă-rẵu năc ya, mò tom rao jư̆ng lơ̆gay cro sang-goh ya, mò tom tơmdŏng cro gleh-glăr ya, mò tom jơh nùs î lơ̆gay bră niem ya.<verse eid="1TI 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 5:11" />Mơya khan cĕ lơ̆gay cro-ua mơ̆ndro hôm kơmom, bơh tơm tô̆ lơ̆gay jơno ham-kơñ kơp kơñ ñă tơmdră î Yang Dŏng-Klàs, gừn ƀòn gô rơp kơñ tơmhòp wăl, <verse eid="1TI 5:11" /><verse number="12" style="v" sid="1TI 5:12" />dưñ-lăñ jơno cahrña bơh ƀòn gô sŏng lơi căư jơno tơm hăư-băl bơh sơm mơ̆n dê. <verse eid="1TI 5:12" /><verse number="13" style="v" sid="1TI 5:13" />Mơya, ƀòn gô kŭng rơp dơm nơ̆m jơno alah-atà, kư̆ swà lơ̆ hîh dô hîh dă, mà ơ̆ nư̆ng jơno dơm alah-atà, mơya hôm tơs tơmhồc î kơñ sơlah nơ̆m bră cro nde, tơs lơ̆gay jơno ơ̆ păl tơs. <verse eid="1TI 5:13" /><verse number="14" style="v" sid="1TI 5:14" />Gư̆n-jîng, ăñ kơñ lơ̆gay cro-ua mơ̆ndro hôm kơmom jôi bo cĕ, bơda kon, rong-siem hîh nhă mơ̆n, lơi ơ̆ lơh tô̆ lơwah ma cro lơh bờk tơngyŏ-tơnghiel. <verse eid="1TI 5:14" /><verse number="15" style="v" sid="1TI 5:15" />Bơh du pơnah cro sŏng tơmcơlah swà jăt Satan lờt.<verse eid="1TI 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TI 5:16" />Dilah cro-ua don jăt Yang găy dî cro-ua mơ̆ndro nhòng hîh, gừn tơmdŏng cĕ ƀòn gô, î bư̆ng lơi Hîh Jư̆m Goh kŏng jơno kơjơ̆, lơi ma Hîh Jư̆m Goh digơlăn tơmdŏng lơ̆gay cro-ua mơ̆ndro ngăn.<verse eid="1TI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17" />Lơ̆gay cro kwăng kra găy jăk ăt-bồ dî lăng la păl kingam lơ̆gay jơno, lai ngăn la tơmpôl cro kŏng sơòs-sơngeh nhòng Jơno Yang î jơno ƀăn mơntău. <verse eid="1TI 5:17" /><verse number="18" style="v" sid="1TI 5:18" />Bơh Sră-Goh bơtău: “Mê bư̆ng kơtrơ̆p kơ̆mbung lamău tơm tô̆ gô ndăng jă kôi,” gừn “Cro lơh bră dî păl î jên tơnge mơ̆n dê.” <verse eid="1TI 5:18" /><verse number="19" style="v" sid="1TI 5:19" />Bư̆ng dưñ-lăñ jơno yă yom tơmdră wăl du hôi cro kwăng kra, dilah ơ̆ tom bea hala păy hê cro lơh cư̆ng. <verse eid="1TI 5:19" /><verse number="20" style="v" sid="1TI 5:20" />Ƀoah-đas cĕ cro tìs-glài sơđàp măt lơ̆gay cro lơi tơmpôl cro hôm wăl digơlăn kŭng gư̆t kơ̆mbrit. <verse eid="1TI 5:20" /><verse number="21" style="v" sid="1TI 5:21" />Ăñ jơh nùs ƀăn tơngkah kon sơđàp măt Yang Tơm Trồ î Yang Dŏng-Klàs Jesu, băl î lơ̆gay cro gơndrơh dî săc-rwơh, lah kon păl prăp jư lơ̆gay gơnoăr pơđơ dô mà ơ̆ ping ngglăm tơngoh î kŭng ơ̆ lơh jơno găy bơh jơno tơmpẵu.<verse eid="1TI 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1TI 5:22" />Bư̆ng kađa ăn tê cŭngsî cro găy, kŭng bư̆ng dubă băl nơ̆m tồi-glài cro nde. Jư cĕ sătan mơ̆n sang lơhiê.<verse eid="1TI 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23" />Kon bư̆ng ñô sî dà gời, mà ñô cĕ dư̆ng-iè alăk tài bơh klô̆ng kon î lơ̆gay jơno kòp jê kư̆ tơmtom.<verse eid="1TI 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24" />Tồi-glài du pơnah cro gừn nê̆-năn, iyà trôh anẵu jơno kŏng cahrña, mơya kŭng tom lơ̆gay glài dî tơs tơlôh makin ma-ngkơi jơ kŏng cahrña. <verse eid="1TI 5:24" /><verse number="25" style="v" sid="1TI 5:25" />Jăt gư̆p tîgư̆n, kŭng tom lơ̆gay bră niem gừn lơh nê̆-năn, hôm lơ̆gay bră ơ̆ tơs tơlôh gừn ơ̆ dî kư̆ ămpôn ndăp.<verse eid="1TI 5:25" /></para>
  <chapter eid="1TI 5" />
  <chapter number="6" style="c" sid="1TI 6" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1" />Kơp cro găy ndăng ăm nteàh yô ngăl dê̆-gơna, păl lăng cro pơnhơm mơ̆n la păl jơh nùs kingam, lơi sơnăn Yang Tơm Trồ î jơno ƀăn mơntău ơ̆ kŏng tơngyŏ-tơnghiel. <verse eid="1TI 6:1" /><verse number="2" style="v" sid="1TI 6:2" />Pơnah nde, lơ̆gay cro dê̆-gơna dî tơmpôl cro pơnhơm la cro don Yang, ơ̆ dî tài bơh gô la oh mi mà lăng ơ̆săp-ơ̆său, mơya păl duh bră khăi rlo te, bơh ƀòn gô la cro don Yang î cro dî kơñ-kơloh, cro dưñ-lăñ jơno duh bră. Kon păl ƀăn mơntău î tơngkah lơ̆gay jơno rơ̆.<verse eid="1TI 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 6:3" />Dilah cro găy ƀăn mơntău gung duh-khoai nde gư̆m ơ̆ don jăt lơ̆gay jơno dî kwơ, rơ̆ la jơno tơs Yang ƀòn mơ̆n dê, la Yang Dŏng-Klàs Jesu, băl î jơno bơtău pơđơ gôtrê bơh jơno don-duh, <verse eid="1TI 6:3" /><verse number="4" style="v" sid="1TI 6:4" />gừn cro gư̆n la cro pơnhừ-să, ơ̆ gư̆t wơng jơno găy, mà dî nùs kơp kơñ kòp jê nơ̆m nhòng bră tơmbơkai î tơmlơh bơh jơno pha-lĭn, bơh gư̆n gôjîng tơm jơno tơmngañ, tơmpìt, tơs bờk, kơlôi-sơnư̆ng bờk, <verse eid="1TI 6:4" /><verse number="5" style="v" sid="1TI 6:5" />ơ̆ tơmrơm băl, nhòng tơmpôl cro kŏng ôm-lề nơ̆m tơngoh î kŏng prŏi ha-ău jơno-tơpăt, lăng jơno don-duh la jơno jôi công nha.<verse eid="1TI 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 6:6" />Mơya jơno don-duh băl î jơno niem-nùs la công nha dơng. <verse eid="1TI 6:6" /><verse number="7" style="v" sid="1TI 6:7" />Bơh ƀòn mơ̆n ơ̆ iyà jơno găy mơ̆t nơ̆m dunya, gư̆n-jîng ƀòn mơ̆n kŭng ơ̆ digơlăn iyà dî jơno găy swà dî. <verse eid="1TI 6:7" /><verse number="8" style="v" sid="1TI 6:8" />Pơnah nde, tơm tô̆ dî jơno sa, ôi-ao, gừn ƀòn mơ̆n rơp dî niem-nùs î lơ̆gay jơno rơ̆. <verse eid="1TI 6:8" /><verse number="9" style="v" sid="1TI 6:9" />Hôm tơmpôl cro kơñ sơlôh gôjîng kơnhơ̆p-mơ̆nda gừn tơmơ̆t nơ̆m jơno pơlum î jơno ƀai kơ̆ndăp, î khăi jơno ham-kơñ wì gơla, roh-rùi, rơ̆ la lơ̆gay jơno tơmơ̆t cro nơ̆m jơno roh gời î roh làt. <verse eid="1TI 6:9" /><verse number="10" style="v" sid="1TI 6:10" />Bơh tơm reh wêl-tăl kơp jơno bờk-mơsăk la ham-hà jên-priè, mà du pơnah cro, bơh kơp kơñ dî gô, sŏng kŏng pơlum tơlôh bơh sơ jơno don gừn lơh ma sătan gô khăi jơno sơòs-sơngeh.<verse eid="1TI 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11" />Mơya ơ kon, cro Yang Tơm Trồ dê, pleh wĭc cĕ lơ̆gay jơno gư̆n, mà tơte jăt jơno tơpăt-durư̆ng, jơno don-duh, jơno don, jơno kơñ-kơloh, nùs ăt-ăl, î niem-lơhơn. <verse eid="1TI 6:11" /><verse number="12" style="v" sid="1TI 6:12" />Tơmlơh cĕ nhòng jơno tơmlơh niem-lơhơn jơno don dê, jư bơkhê cĕ jơno jîng miek miek, la jơno mà kon sŏng dî hôi jà trôh gừn sŏng tơs tơlôh jơno tơs niem sơđàp măt khăi cro lơh cư̆ng. <verse eid="1TI 6:12" /><verse number="13" style="v" sid="1TI 6:13" />Ăñ e gơnoăr pơđơ ma kon sơđàp măt Yang Tơm Trồ, Bơtao lơh ma lơ̆gay jơno dî jîng, î sơđàp măt Yang Dŏng-Klàs Jesu, Bơtao tơs tơlôh jơno tơs niem sơđàp măt Ƀônsơ Pilat, <verse eid="1TI 6:13" /><verse number="14" style="v" sid="1TI 6:14" />lah kon păl prăp jư jơno pơđơ bơlăm dô dubă wêl-tăl, ơ̆ tom anẵu găy ƀoah-đas dî, trôh dî nge sơđah tơlôh Yang ƀòn mơ̆n, la Yang Dŏng-Klàs Jesu, <verse eid="1TI 6:14" /><verse number="15" style="v" sid="1TI 6:15" />la Bơtao mà Yang Tơm Trồ Dơng Rlo păl jong-rơ gư̆m nư̆ng dul, la Bơtao lơ̆gay Bơtao î la Yang lơ̆gay Yang, rơp rang sơđah nơ̆m ñăm tô̆ tơnge, <verse eid="1TI 6:15" /><verse number="16" style="v" sid="1TI 6:16" />nư̆ng du hôi Kơnràñ jîng miek ơ̆ sơ̆t, ăm nhòng jơno ang ơ̆ trôh en dî, la Bơtao ơ̆ cro găy lăng tơmpơl, kŭng ơ̆ cro găy digơlăn tơmpơl dî; dăn jơno kingam î jơno gơnăp-gơnoăr miek miek gôtrê ma Kơnràñ. Amen.<verse eid="1TI 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17" />Bơtău tơngkah cĕ cro kơnhơ̆p nơ̆m rai dô bư̆ng pơnhừ-să, kŭng bư̆ng cang-kơnơm anẵu jên-priè ơ̆ nê̆-năn, mà cang-kơnơm cĕ anẵu Yang Tơm Trồ, Bơtao e ma ƀòn mơ̆n lơ̆gay jơno dubă tơngkah-tơngkăñ lơi sơhờp-sờhơn, <verse eid="1TI 6:17" /><verse number="18" style="v" sid="1TI 6:18" />î pơđơ ƀòn gô lơh jơno niem, tơngkah-tơngkăñ nơ̆m bră niem, dî nùs sơmah-sơmai, rcăng tơmpà, <verse eid="1TI 6:18" /><verse number="19" style="v" sid="1TI 6:19" />ăn lơi ma să tơm mơ̆n du mơnang niem-lơhơn ma lơ̆gay jơno mơñ trôh, lơi ƀòn gô digơlăn jư bơkhê jơno jîng ngăn.<verse eid="1TI 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20" />Ơ Timôthe, kon lăng jư cĕ jơno dî jao ma kon, pleh cĕ lơ̆gay jơno lîng-lang sơmơ̆-sơmĭñ jăt dunya, î lơ̆gay jơno tơmbơkai sơnăn dêh gô la jăk-sai, <verse eid="1TI 6:20" /><verse number="21" style="v" sid="1TI 6:21" />mà du pơnah cro, bơh tơs tơnggư̆t tîgư̆n, sŏng swà tơblơ̆ wăl jơno don.</para>
  <para style="p" vid="1TI 6:21">Dăn jơno sơmah ăm băl î lơ̆gay oh mi roh lŏ.<verse eid="1TI 6:21" /></para>
  <chapter eid="1TI 6" />
</usx>