<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JON" style="id" />
  <para style="h">Jon</para>
  <para style="toc1">lqiṣeṯ n yuwnes</para>
  <para style="toc2">Jona</para>
  <para style="toc3">JON</para>
  <para style="mt1">lqiṣeṯ n yuwnes</para>
  <chapter number="1" style="c" sid="JON 1" />
  <para style="s">yuwnes iruggel al terciyc</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 1:1" />ijuwas yuwa lliy diyma yella y yuwnes memmis n amittay: <verse eid="JON 1:1" /><verse number="2" style="v" sid="JON 1:2" />«kker ureḥ al ninwa, al aydin n tmura temeqqart. mlesen: &lt; rreṯ lbaluwem. rahiy rebbiy izer g ccer lliy teteggem. &gt; »<verse eid="JON 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JON 1:3" />yuwnes yekker. amma yerwel al terciyc lliy tebƹed af ninwa. ireḥ al tmura n yafa mani yufa lbabur tateffeγ al terciyc. ixelleṣ, yerkeb yid ibeḥḥaren diyes bac witegc lliy yuwayas fellas lliy diyma yella.<verse eid="JON 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 1:4" />yaxy yenkiy lliy diyma yella aḍu d meqqar af iylel yeggi lƹefrit qwi almiy ḥeḍerbac taterez lbabur. <verse eid="JON 1:4" /><verse number="5" style="v" sid="JON 1:5" />xleƹen ibeḥḥaren, aḏ yeqqim kul yjen sisen iḍelleb g rebbiys aḏ luḥen lliy yusi g lbabur lkul bac atxef. amma yuwnes yusi yezwa g lbabur yeṭṭes tirrist temeqqart.<verse eid="JON 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JON 1:6" />yaxy yusesd rreyes ysekri aḏ yuwayas: «cbiḵ teṭṭeseḏ zeγ? kker zzal y rebbiyḵ, balekc aγenyesmuqel aḏ winetmitic.»<verse eid="JON 1:6" /></para>
  <para style="s">igga n lqurƹeṯ</para>
  <para style="p">
    <verse number="7" style="v" sid="JON 1:7" />aḏ uwan ibeḥḥaren y beƹeḍhum: «yya aneg lqurƹeṯ bac anessen mam yuγaneγd ayuh n nnaḥes.» ggen lqurƹeṯ, yaxy tused af yuwnes.<verse eid="JON 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JON 1:8" />uwanas: «mleneγ maγer yuseneγd ayuh n nnaḥs? d matta ṣeneƹtiḵ? manis tusid? d mentan lebladiḵ? aḏ d mam middeniḵ?»<verse eid="JON 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 1:9" />yaxy yerrasen: «neči d ƹebreni, aḏ sseneγ lliy diyma yella; rebbiy n ujenna lliy yeggi iylel aḏ tammurt.»<verse eid="JON 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 1:10" />beƹd mag yuwayasen lliy netta wiyeggic matta yexs lliy diyma yella aḏ yerwel, ugeḏḏen ibeḥḥaren ggeṯ aḏ uwanas: «maγer witteggic s dwiys.»<verse eid="JON 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JON 1:11" />mniyn yusi lmuj irenni sesetnent: «matta aneg diyeḵ bac ayers iylel.» <verse eid="JON 1:11" /><verse number="12" style="v" sid="JON 1:12" />yuwayasen: «luweḥtiḏ g iylel ṭuruh ayers, ṯabet ayuh n lƹefrit yekkerewemd afelxaḍertiw.» <verse eid="JON 1:12" /><verse number="13" style="v" sid="JON 1:13" />amma ibeḥḥaren ggen ljehdesen bac aḏeṣlen al cceṭ lekenti wiquddenc asaṣlen afelxaḍert lmuj yusi irenni. <verse eid="JON 1:13" /><verse number="14" style="v" sid="JON 1:14" />yaxy ṣeyḥen y lliy diyma yella, uwan: «ayya lliy diyma yella wiγentedjac anemmuṯ afelxaḍert n ayuh n argaz, witegc g tḵerminenneγ iḏemmen n wuh lliy wiγenyeggi ḥaja. rahiy d cek d rebbiy lliy diyma yella lliy texseḏ amyuh.» <verse eid="JON 1:14" /><verse number="15" style="v" sid="JON 1:15" />qamen yuwnes luḥent g iylel, yaxy yersa lmujis. <verse eid="JON 1:15" /><verse number="16" style="v" sid="JON 1:16" />fehhen irgazen aḏ ugeḏḏen ggeṯ aḏ aγresen y lliy diyma yella aḏ uƹeḏen bac asγersen lweƹdeṯ iḍen beƹdin. <verse eid="JON 1:16" /><verse number="17" style="v" sid="JON 1:17" />aḏ yenkiy lliy diyma yella trebit temeqqart bac atebleƹ yuwnes. aḏ yeqqim g jaris 3 d ussanaṯ s iḍenesen.<verse eid="JON 1:17" /></para>
  <chapter eid="JON 1" />
  <chapter number="2" style="c" sid="JON 2" />
  <para style="s">tẓalliṯ n yuwnes</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 2:1" />yeẓẓul yuwnes g jjar n trabit y rebbiys, lliy diyma yella.<verse eid="JON 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JON 2:2" />yuwa:</para>
  <para style="q2" vid="JON 2:2">«ayya lliy diyma yella.</para>
  <para style="q2" vid="JON 2:2">ṣeyḥeγ al γareḵ seg ḍḍiqiw.</para>
  <para style="q2" vid="JON 2:2">yaxy terridiḏ.</para>
  <para style="q2" vid="JON 2:2">seg amas n burriƹ n temettent zwikγaḵ,</para>
  <para style="q2" vid="JON 2:2">yaxy teslidiḏ.<verse eid="JON 2:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="JON 2:3" />tluweḥdiḏ al aman</para>
  <para style="q2" vid="JON 2:3">lliy aγreqqen g amas n iylel,</para>
  <para style="q2" vid="JON 2:3">nnaḍḍen siyi aman.</para>
  <para style="q2" vid="JON 2:3">hejmen fella lemwejiḵ imeqqaren lkul.<verse eid="JON 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JON 2:4" />ḥsebγaḵ tzaƹzeqdiḏ seg zzaṯiḵ.</para>
  <para style="q2" vid="JON 2:4">zeƹma taquddeγ tijekkelt iḍen</para>
  <para style="q2" vid="JON 2:4">azreγ lheyekeliḵ meqdus.<verse eid="JON 2:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="JON 2:5" />creqeγ, aman imeqqaren nnaḍḍen siyi,</para>
  <para style="q2" vid="JON 2:5">telga tuḏen ixfiw.<verse eid="JON 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JON 2:6" />al adug n lqeƹ n lejbal udiγ.</para>
  <para style="q2" vid="JON 2:6">ddunyeṯ teqeṣ defferiw leblejjeṯis y diyma.</para>
  <para style="b" vid="JON 2:6" />
  <para style="q2" vid="JON 2:6">amma cek tsefeγdiḏ</para>
  <para style="q2" vid="JON 2:6">derreγ seg ayuh n leqber,</para>
  <para style="q2" vid="JON 2:6">ayya lliy diyma yella; d rebbiyw.<verse eid="JON 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JON 2:7" />mniyn tleqfeγ, cek lliy tusid af lbaliw,</para>
  <para style="q2" vid="JON 2:7">ayya lliy diyma yella. tẓalliṯiw tuli al γareḵ,</para>
  <para style="q2" vid="JON 2:7">al meqdus lheyekliḵ.<verse eid="JON 2:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JON 2:8" />diyes seg midden, midden tẓallan y leṣnam.</para>
  <para style="q2" vid="JON 2:8">aḏ tedjan lliy yetquddu atenisemneƹ.<verse eid="JON 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JON 2:9" />amma neči, taxγerseγ aḏ neči ḥemdeγ.</para>
  <para style="q2" vid="JON 2:9">lliy uƹeḏḏeγ siyes tateggeγ,</para>
  <para style="q2" vid="JON 2:9">rahiy d cek lliy tesemneƹeḏ, ayya lliy diyma yella.»<verse eid="JON 2:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="JON 2:10" />yaxy yuwa lliy diyma yella y trabit. «luwḥ yuwnes al cceṭ.» tluweḥi.<verse eid="JON 2:10" /></para>
  <chapter eid="JON 2" />
  <chapter number="3" style="c" sid="JON 3" />
  <para style="s">yuwnes ireḥ al ninwa</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 3:1" />yuwa lliy diyma yella y yuwnes tijekkelt iḍen. <verse eid="JON 3:1" /><verse number="2" style="v" sid="JON 3:2" />«kker ureḥ al ninwa, al aydin n tmura temeqqart temeldasen matta mmeleγ.»<verse eid="JON 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JON 3:3" />yaxy yekker yuwnes ireḥ al ninwa mammeḵ yuwayas lliy diyma yella. aḏ tusi ninwa d temura temeqqart widdic temura am nettaṯ tqimen 3 d ussanaṯ bac atetqedƹen lkul. <verse eid="JON 3:3" /><verse number="4" style="v" sid="JON 3:4" />yuḏef yuwnes al tmura diyn yeyyur diyes ijuwas, yuḏel yetberreḥ: «beƹd 40 d ussanaṯ tatehdem ayuh n tmura.»<verse eid="JON 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JON 3:5" />yaxy umennen midden n ninwa s dwiy n rebbiy, aḏ ƹelqen uẓwum. aḏ ireḍḍen ṣireḍ n leḥzen lkulhum imeqqaren aḏ imeckunen.<verse eid="JON 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JON 3:6" />mniyn yesla lmelek n ninwa ayuh n dwiy, yekker s nnaj lƹercis yekkes lbasis n lḥukem, aḏ yireḍ ṣireḍ n leḥzen, aḏ ygeƹmez af iγeḍ. <verse eid="JON 3:6" /><verse number="7" style="v" sid="JON 3:7" />aḏ yuwayasen aberḥen g ninwa lkul:</para>
  <para style="p" vid="JON 3:7">«yuweyawem lmelk aḏ midden lliy nnaḍḍen siyes. yexs azumen midden aḏ zweyil. tulli aḏ tfwunesin wiferrednec aḏ wisesnec aman. <verse eid="JON 3:7" /><verse number="8" style="v" sid="JON 3:8" />aḏ yexs midden aḏ zwayel lkul aḍirden ṣireḍ n leḥzen. we ajehan y rebbiy, we abeṭlen igga n ccer aḏ ḍḍulem. <verse eid="JON 3:8" /><verse number="9" style="v" sid="JON 3:9" />belekci rebbiy wiγenytegc lliy yuwa g uγeccecis aḏ winetmettic.»<verse eid="JON 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 3:10" />mniyn yezra rebbiy matta ggen aḏ mammeḵ beṭlen ccer lliy wsiyn tteggen diyes ybeṭṭel aḏ wisenyeggic ccer lliy yuwa tasentiḏyeg.<verse eid="JON 3:10" /></para>
  <chapter eid="JON 3" />
  <chapter number="4" style="c" sid="JON 4" />
  <para style="s">yuwnes iγeccec</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 4:1" />lekinti yuwnes wiyerlic af ayuh xlaṣ aḏ iγeccec. <verse eid="JON 4:1" /><verse number="2" style="v" sid="JON 4:2" />aḏ yuwa y lliy diyma yella:</para>
  <para style="p" vid="JON 4:2">«ayya lliy diyma yella, s manis usiγ g tammurtiw senneγ lliy tayṣar ayuh, afelxaḍert n ayuh rweleγ ƹlewleh al terciyc. neči senneγ lliy cek d rebbiy ḥniyn aḏ rḥiym, witetγeccecec fiseƹ aḏ nnaƹemtiḵ ggeṯ. aḏ maḏabik abeṭleḏ igga n leƹqeb lliy tuwiḏ tasentiḏegeḏ. <verse eid="JON 4:2" /><verse number="3" style="v" sid="JON 4:3" />ṭuruh ayya lliy diyma telliḏ, awyiḏ. lukan ametteγ xiyr.» <verse eid="JON 4:3" /><verse number="4" style="v" sid="JON 4:4" />yaxy yuwayas lliy diyma yella: «yenda γareḵ lḥeq aγeccecceḏ.»<verse eid="JON 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JON 4:5" />yusi yuwnes yeffeγ seg ninwa. aḏ yeggi lmesqef mcerqas aḏ ygeƹmez aduggis yesugum man ayṣar y aydin n tmura. <verse eid="JON 4:5" /><verse number="6" style="v" sid="JON 4:6" />yseγmyed rebbiy lliy diyma yella ḥaja am leqṭenyeṯ teƹla iṭer n yuwnes bac asteg ṭṭel we ayettu lhemmis. yaxy yefreḥ yuwnes ggeṯ siyes. <verse eid="JON 4:6" /><verse number="7" style="v" sid="JON 4:7" />lekenti al ača tajji bekri yenkiy rebbiy tekeča tehjem af tuwh lliy teγmiyed. teqqur ƹlewleh. <verse eid="JON 4:7" /><verse number="8" style="v" sid="JON 4:8" />beƹd ilay n tufuyt, yenkiy rebbiy aḍu d cerqi yezγel. tezwa lbeqleṯ af iγef n yuwnes almiy ḥeḍrebac tayeddex. yeḍleb temettent. yuwa: «lukan ametteγ xiyr.»<verse eid="JON 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 4:9" />yuwayas rebbiy: «yenda γareḵ lḥeq aγeccecceḏ afelxaḍert n tuwh lliy teqqur.» yerras yuwnes: «γari lḥeq. we aḍelbeγ temettent zada.»<verse eid="JON 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 4:10" />yuwayas lliy diyma yella: «ḥekker mammeḵ cek tesxeffeḏ af tuwh lliy wisteggiḏ ḥaja aḏ witetsemeγrec, amma teγmiyed g yiḍ yjen aḏ temmuṯ g wissen. <verse eid="JON 4:10" /><verse number="11" style="v" sid="JON 4:11" />mammeḵ zeγ wisexfexc neči af ninwa, ayuh n tmura temeqqart lliy diyes iṭer n 120,000 d midden lliy wisinenc lxiyr seg ccer, aḏ diyes zwayel ggeṯ zada.»<verse eid="JON 4:11" /></para>
  <chapter eid="JON 4" />
</usx>