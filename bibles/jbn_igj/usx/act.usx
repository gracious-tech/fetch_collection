<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ACT" style="id" />
  <para style="h">Acts</para>
  <para style="toc1">lxedmeṯ n imersal</para>
  <para style="toc2">Acts</para>
  <para style="toc3">ACT</para>
  <para style="mt1">lxedmeṯ n imersal</para>
  <chapter number="1" style="c" sid="ACT 1" />
  <para style="s">40 d ussanaṯ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1" />ay ṯawufiylis, g lektabiw mezwar awiγaḵ af mag yeggi aḏ yuwa yesuwƹ lkul s manis yenkiyi rebbiy <verse eid="ACT 1:1" /><verse number="2" style="v" sid="ACT 1:2" />almiy isaly rebbiy al ujenna beƹd mag yuca luṣeyaṯis s lquweṯ n rruwḥ lqudus y imersal lliy iwezayin.<verse eid="ACT 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 1:3" />aḏ yeḍherresend ggeṯ g rbƹiyn d ussanaṯ beƹd temettentis. aḏ yucesen ggeṯ d lemayer lliy sseḵenneṯ lliy netta nembelḥeq yedder. aḏ yufleyasen af lmelekuwt n rebbiy. <verse eid="ACT 1:3" /><verse number="4" style="v" sid="ACT 1:4" />ijuwas, mniyn yusi itet yiḏesen, yuwa:</para>
  <para style="p" vid="ACT 1:4">«witeffeγc seg uwrceliym, qimeṯ diyes, sugmeṯ almiy ayentem lweƹd n rebbiy babenneγ mammeḵ uwiγawem. <verse eid="ACT 1:4" /><verse number="5" style="v" sid="ACT 1:5" />lliy yaḥya izizdi midden s aman amma kennim beƹd ussan tazizedyem s rruwḥ lqudus.»<verse eid="ACT 1:5" /></para>
  <para style="s">ilay n lmesiyḥ al ujenna</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6" />mniyn mleymen sesetnent lliy wsiyn yiḏes: «ayya siydneγ, yaxy g ussan diyn tarreḏ lḥukem y aṯ israyil.» <verse eid="ACT 1:6" /><verse number="7" style="v" sid="ACT 1:7" />yerrasen:</para>
  <para style="p" vid="ACT 1:7">«wiγerwem ima tasnem lmuḥan aḏ lweqt lliy yeggi rebbiy babenneγ s lqudretis. <verse eid="ACT 1:7" /><verse number="8" style="v" sid="ACT 1:8" />lekenti talqim lquweṯ we ḏulem d ccuhhaḏiw g uwrceliym, aḏ lyehuwdiya lkul aḏ ssamira, aḏ g leḍraf n tammurt almiy tayezwa fellewem rruwḥ lqudus.»<verse eid="ACT 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 1:9" />beƹd ayuh n dwiy, zrent yetteli al ujenna almiy tuḏenni tesḥabt. <verse eid="ACT 1:9" /><verse number="10" style="v" sid="ACT 1:10" />mniyn nihnin smuqulen al ujenna lliy itelyas, ḍhernesend sen irgazen s leḥwayej d imellalen. <verse eid="ACT 1:10" /><verse number="11" style="v" sid="ACT 1:11" />yaxy uwanasen: «ayya ijeliyliyen, maγer tesmuqulem amyuh al ujenna? rahiy yesuwƹ lliy yuli al ujenna tadyer siyes mammeḵ tezrimt itelyas.»<verse eid="ACT 1:11" /></para>
  <para style="s">awazi n mam tayeγ g umkan n yehuwḏa.</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12" />aḏ rrend imersal al uwrceliym seg jbel n uzemmur lliy yusi yeqreb ggeṯ aḏ tquddun asreḥḥen ḥetta as n sebbeṯ lliy wsiyn wuḏeyen wizrefenc diyes. <verse eid="ACT 1:12" /><verse number="13" style="v" sid="ACT 1:13" />mniyn uṣelnas, uliyen al leƹli mani wsiyn tqiman, aḏ nihnin d buṭrus aḏ yuwḥenna aḏ yeƹquwb aḏ andrawus aḏ filibbus aḏ tuwma aḏ berṯelmawus aḏ metta aḏ yeƹquwb memmis n ḥelfi aḏ simƹan lliy inaγγer af lbladis aḏ yehuwḏa uwas n yeƹquwb. <verse eid="ACT 1:13" /><verse number="14" style="v" sid="ACT 1:14" />aḏ wsiyn tẓallan diyma jmiyƹ, nihnin aḏ tiseḏnan, aḏ meryem yedjis n yesuwƹ aḏ yeṯmas. <verse eid="ACT 1:14" /><verse number="15" style="v" sid="ACT 1:15" />aḏ ijuwas mleymen ḥeḍerbac 100 uƹecrin seg indin lliy umennen. yaxy yebbed jaresen buṭrus yuwa:<verse eid="ACT 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 1:16" />«ayya yeṯma, yexs ayentem lliy yuwayi rruwḥ lqudus af imi n dawud af yehuwḏa lliy yuγettend bac aṭfen yesuwƹ. <verse eid="ACT 1:16" /><verse number="17" style="v" sid="ACT 1:17" />yehuwḏa yusi d yjen sineγ aḏ ybeccer iḏenneγ. <verse eid="ACT 1:17" /><verse number="18" style="v" sid="ACT 1:18" />s iflusen lliy yelqayin af lƹemeltis yeṣγa mezdeγ. yaxy yuda diyes af uḏmis. imir jaris. feγend lemṣernis lkul. <verse eid="ACT 1:18" /><verse number="19" style="v" sid="ACT 1:19" />slen midden n uwrceliym lkul s aydin, semman mezdeγis: &lt; mezdeγ n iḏemmen. &gt; <verse eid="ACT 1:19" /><verse number="20" style="v" sid="ACT 1:20" />amyuh iṣar lliy yetweri g lektab n lmezamir.</para>
  <para style="p" vid="ACT 1:20" />
  <para style="q1" vid="ACT 1:20">&lt;tatexreb tezeqqas</para>
  <para style="q1" vid="ACT 1:20">aḏ wisekken diyes ḥed.</para>
  <para style="q1" vid="ACT 1:20">tayeγ mkanis yjen iḍen. &gt;<verse eid="ACT 1:20" /></para>
  <para style="p" />
  <para style="p">
    <verse number="21" style="v" sid="ACT 1:21" />yexs anweza mam ayecheḏ iḏenneγ af tneḵri n yesuwƹ seg irgazen lliy wsiyn iḏenneγ, <verse eid="ACT 1:21" /><verse number="22" style="v" sid="ACT 1:22" />mniyn yusi siydneγ yesuwƹ jarenneγ, seg as lliy izizedyi diyes yaḥya al as lliy isalyi diyes rebbiy al ujenna.»<verse eid="ACT 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23" />yaxy uwanas lliy ḥderren af sen irgazen, nihnin d yuwsef lliy sγuyunas bersabas aḏ mmelnas yustus, aḏ matteyas. <verse eid="ACT 1:23" /><verse number="24" style="v" sid="ACT 1:24" />aḏ ẓullen, uwan: «ay rebbiy lliy tesenneḏ matta g ulawen n midden lkul. siḵnaneγ mentan tweziḏ seg ayuh n sen irgazen, <verse eid="ACT 1:24" /><verse number="25" style="v" sid="ACT 1:25" />bac aybeccer iḏenneγ we aydel d mersul g umkan n yehuwḏa lliy yufa mag yestahel.» <verse eid="ACT 1:25" /><verse number="26" style="v" sid="ACT 1:26" />yaxy ggen lqurƹeṯ. tused af matteyas. rnint y imersal lliy wsiyn ḥdac.<verse eid="ACT 1:26" /></para>
  <chapter eid="ACT 1" />
  <chapter number="2" style="c" sid="ACT 2" />
  <para style="s">tezuggiṯ n rruwḥ lqudus</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1" />g tfeṣka n as 50, wsiyn lmumniyn lkul mleymen g umkan yjen. <verse eid="ACT 2:1" /><verse number="2" style="v" sid="ACT 2:2" />yaxy slen lḥes qwi yused seg ujenna amellaḵ d aḍu mqqar yetzeffer g lḥuc lliy llan diyes. <verse eid="ACT 2:2" /><verse number="3" style="v" sid="ACT 2:3" />aḏ zren timsi tetlebleb am ilsawen. aḏ yezwa af kul yjen sisen iles. <verse eid="ACT 2:3" /><verse number="4" style="v" sid="ACT 2:4" />yaxy čuren lkulhum s rruwḥ lqudus. ḏwellen duggan s lγawi iḍen lliy yseḥfedasen rruwḥ lqudus mammeḵ aḏuflayen sisneṯ.<verse eid="ACT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5" />aḏ yusi diyes g uwrceliym lweqt ḏḏin ggeṯ d wuḏeyen deynin seg indin lliy usennesd seg lbulden lkul. <verse eid="ACT 2:5" /><verse number="6" style="v" sid="ACT 2:6" />mniyn slen lḥes meqqar, usnesend midden. yaxy miren imewnesen afelxaḍert kul yjen yesγda disen duggan s leγutis. <verse eid="ACT 2:6" /><verse number="7" style="v" sid="ACT 2:7" />fehhen nyeƹdel aḏ sestenen beƹḍhum:</para>
  <para style="p" vid="ACT 2:7">«yaxy muc inuh lkul lliy ddugan seg ljeliyl? <verse eid="ACT 2:7" /><verse number="8" style="v" sid="ACT 2:8" />mammeḵ zeγ yeseγda kul yjen sineγ leγweṯ n tammurt lliy yluled diyes? <verse eid="ACT 2:8" /><verse number="9" style="v" sid="ACT 2:9" />rahiy diyes jarenneγ, iferritiyen aḏ imeddiyen aḏ iƹellamiyen aḏ seg indin lliy seknen jar lwiḏan aḏ lyehuwdiya aḏ kebbudukiya aḏ bunṭus aḏ asiya, <verse eid="ACT 2:9" /><verse number="10" style="v" sid="ACT 2:10" />aḏ fiyrijiya aḏ bemfiyliya aḏ miṣr aḏ lqirineya g liybiya. aḏ jarenneγ ggeṯ usend seg ruwma <verse eid="ACT 2:10" /><verse number="11" style="v" sid="ACT 2:11" />seg wuḏeyen aḏ lliy ḏwellen d wuḏeyen aḏ ikerritiyen aḏ ibiyeṯen. aḏ qa neccin neseγda disen duggananeγ s dwiyneγ af lmuƹjizaṯ lliy yeggineṯ rebbiy.»<verse eid="ACT 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 2:12" />yaxy fehhen aḏ ttumehemcen sestunen g beƹeḍhum: «matta lmeƹnas ayuh.» <verse eid="ACT 2:12" /><verse number="13" style="v" sid="ACT 2:13" />aḏ yella mam yuwa aḏ netta yeddeṣ: «inuh skerren.»<verse eid="ACT 2:13" /></para>
  <para style="s">lxuṭbeṯ temezwert n buṭrus</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14" />yebbed buṭrus netta aḏ imersal ttenyaṯ lliy wsiyn ḥadec. iṣeddeƹ yuwa y midden:</para>
  <para style="p" vid="ACT 2:14">«ayya wuḏeyen, ayya lliy seknen g uwrceliym lkul, sseγdeṯ dwiyw bac asnem leḥqiqeṯ. <verse eid="ACT 2:14" /><verse number="15" style="v" sid="ACT 2:15" />inuh wiskirenc mammeḵ teḥsabem. rahiy wicci d tisseƹ n tajji. <verse eid="ACT 2:15" /><verse number="16" style="v" sid="ACT 2:16" />lakin d ayuh lliy yuwa fellas nnabiy yuwiyl:<verse eid="ACT 2:16" /></para>
  <para style="p" />
  <para style="q1">
    <verse number="17" style="v" sid="ACT 2:17" />yemmal rebbiy:</para>
  <para style="q2" vid="ACT 2:17">&lt;g ussan lliy tadesen</para>
  <para style="q2" vid="ACT 2:17">tasezwiγ rruwḥiw af midden lkul.</para>
  <para style="q2" vid="ACT 2:17">we aḏulen d lenbiya,</para>
  <para style="q2" vid="ACT 2:17">ṭarwiwiṯuwem aḏ yessiṯuwem.</para>
  <para style="q2" vid="ACT 2:17">we azren imezyennuwem tirejlin.</para>
  <para style="q2" vid="ACT 2:17">aḏ iwessernuwem atentezren g iḍeṣ.<verse eid="ACT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 2:18" />g ussan diyn tasezwiγ rruwḥiw</para>
  <para style="q2" vid="ACT 2:18">af lliy umennen siyi lkul,</para>
  <para style="q2" vid="ACT 2:18">af irgazen aḏ tiseḏnan,</para>
  <para style="q2" vid="ACT 2:18">we aḏulen d lenbiya.<verse eid="ACT 2:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="ACT 2:19" />taggeγ leγrayeb g ujenna nnaj</para>
  <para style="q2" vid="ACT 2:19">aḏ lmuƹjizaṯ d lemayer af tammurt dday.</para>
  <para style="q2" vid="ACT 2:19">iḏamen aḏ timsi aḏ sḥab n dduxan.<verse eid="ACT 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ACT 2:20" />aḏ qebbel man adyas as n rebbiy as diyn meqqar,</para>
  <para style="q2" vid="ACT 2:20">tayebbes ddu n tufuyt</para>
  <para style="q2" vid="ACT 2:20">tatezweγ teziri am iḏamen.<verse eid="ACT 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ACT 2:21" />aḏ kul yjen ayeṭṭef g rebbiy ayemneƹ. &gt;<verse eid="ACT 2:21" /></para>
  <para style="b" />
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22" />ayya aṯ israyil, sseγdeṯ ayuh n dwiy: rahiy yesuwƹ nnaṣiriy yeggi rebbiy af ifesnis lmuƹjizaṯ. aḏ yeggi jarewem leγrayeb aḏ lemayer mammeḵ tessennem. <verse eid="ACT 2:22" /><verse number="23" style="v" sid="ACT 2:23" />lekinti yedjawem rebbiy lliy yessen kul cey, afelxaḍert yexs amyuh ateṭfem we atṣelbem we atenγem s ifesn n weribekkaḍen. <verse eid="ACT 2:23" /><verse number="24" style="v" sid="ACT 2:24" />aḏ rebbiy ysekri seg jar lliy mmuṯen aḏ ysefγi seg uγenna n tmettent afelxaḍert temettent witetequdduc atetṭef γares. <verse eid="ACT 2:24" /><verse number="25" style="v" sid="ACT 2:25" />dawud yuwa g umkan n yesuwƹ:</para>
  <para style="b" vid="ACT 2:25" />
  <para style="q2" vid="ACT 2:25">&lt;zerreγ g rebbiy zzaṯiw diyma,</para>
  <para style="q2" vid="ACT 2:25">yella af liminiw bac wituṭṭixc.<verse eid="ACT 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 2:26" />afelxaḍert n aydin yefreḥ uliw</para>
  <para style="q2" vid="ACT 2:26">ysebbeḥ ilsiw.</para>
  <para style="q2" vid="ACT 2:26">tariḥeγ aḏ neči ssugumeγ.<verse eid="ACT 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 2:27" />wiltetedjic g burriƹ n temettent,</para>
  <para style="q2" vid="ACT 2:27">wiltetarric neči meqdusiḵ d ijdi g leqber,<verse eid="ACT 2:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ACT 2:28" />tsiḵendiḏ abriyḏ ṣbiḥ n temeddurt,</para>
  <para style="q2" vid="ACT 2:28">taferḥeγ ggeṯ afelxaḍert telliḏ diyma iḏiy. &gt;<verse eid="ACT 2:28" /></para>
  <para style="b" />
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29" />ayya yeṯma, ṭuruh tafenemleγ ayuh n dwiy zzaṯ midden lkul; babenneγ dawud yemmuṯ aḏ yemmunbel, aḏ lqebris yella al as wuh. <verse eid="ACT 2:29" /><verse number="30" style="v" sid="ACT 2:30" />dawud nnabiy yessen lliy rebbiy yedjullas af lliy tadyas seg lxelfis lmesiyḥ we aygeƹmez af lƹercis. <verse eid="ACT 2:30" /><verse number="31" style="v" sid="ACT 2:31" />yuflay af tneḵri n lmesiyḥ lliy isiḵenasted rebbiy aḏ yuwa lliy netta wiyetγimic g burriƹ n temettent aḏ wititarric d ijdi g leqber. <verse eid="ACT 2:31" /><verse number="32" style="v" sid="ACT 2:32" />rahiy ayuh n yesuwƹ ysekri rebbiy seg tmettent aḏ neccin lkulna d cuhhaḏ. <verse eid="ACT 2:32" /><verse number="33" style="v" sid="ACT 2:33" />mniyn iqamy rebbiy yeggi af liminis. yelqa s babis rruwḥ lqudus lliy yuƹeḏḏi siyes. aḏ ysezwad fellenneγ ayuh n rruwḥ lqudus. aḏ lliy tzarrem diyes ṭuruh diyneγ, aḏ teseγdim diyes. rahiy siyes netta. <verse eid="ACT 2:33" /><verse number="34" style="v" sid="ACT 2:34" />rahiy dawud wiyulic al ujenna. aḏ netta yuwa:</para>
  <para style="b" vid="ACT 2:34" />
  <para style="q2" vid="ACT 2:34">yuwa rebbiy y siydi:</para>
  <para style="q2" vid="ACT 2:34">&lt;geƹmez af almiyniw,<verse eid="ACT 2:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ACT 2:35" />bac aggeγ leƹdaḵ adug iderniḵ. &gt;<verse eid="ACT 2:35" /></para>
  <para style="b" />
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36" />yexs asnem yeqƹeḏ, ayya aṯ israyil lkul. rebbiy yeggi yesuwƹ wuh lliy tediyem kennim g ifesnis imesmeren af ṣṣelib d siydnas aḏ d lmesiyḥ.»<verse eid="ACT 2:36" /></para>
  <para style="s">imesiḥiyen imezweren</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37" />mniyn slen lliy ḥderren ayuh n dwiy aḏ γennan ulawnesen, sesetnen buṭrus aḏ imersal ttenyaṯ: «matta aneg ayya ayeṯmeneγ.»<verse eid="ACT 2:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 2:38" />yaxy yerrasen buṭrus: «tabeṯ. aḏ adj ayettuzizdi kul yjen siwem we ayemen s ism n yesuwƹ lmesiyḥ, bac afenyeγfer ibekkaḍnuwem we afenyuc rruwḥ lqudus d lhediyeṯ. <verse eid="ACT 2:38" /><verse number="39" style="v" sid="ACT 2:39" />ayuh n lweƹd y kennim aḏ y ṭarwiwiṯuwem aḏ y lliy bƹeḏḏen lkul, aḏ y indin lkul lliy tasenyesγuy rebbiynaγ.»<verse eid="ACT 2:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40" />aḏ yerniy yuflay buṭrus y midden aḏ isiḵnasen g lxuṭbeṯ, yuwa: «fγeṯ seg ayuh n midden lliy ƹerḍen y rebbiy bac amenƹem.» <verse eid="ACT 2:40" /><verse number="41" style="v" sid="ACT 2:41" />lliy slen dwiys ttuzizdyen, aḏ rnin as diyn 3,000 d lmumnin.<verse eid="ACT 2:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 2:42" />aḏ wsiyn lkulhum seγdan g dwiy n imersal diyma, dderren jmiyƹ, tzunun g aγrum aḏ tẓallan.<verse eid="ACT 2:42" /></para>
  <para style="p" />
  <para style="p">
    <verse number="43" style="v" sid="ACT 2:43" />mniyn mmugneṯ lmuƹjizaṯ aḏ lemayer aḏ leγrayeb ggeṯ af ifesn n imersal, ugeḏḏen midden lkul. <verse eid="ACT 2:43" /><verse number="44" style="v" sid="ACT 2:44" />lliy umennen wsiyn am argaz yjen aḏ yusi kul ciysen jmiyƹ, <verse eid="ACT 2:44" /><verse number="45" style="v" sid="ACT 2:45" />aḏ wsiyn zenzan lliy γarsen bac azunen iflusen jaresen feleḥsab n mag yesetḥeq kul yjen sisen, <verse eid="ACT 2:45" /><verse number="46" style="v" sid="ACT 2:46" />aḏ ttesend kul as al lheykel. aḏ tetten jmiyƹ g tzaγwinesen aḏ nihnin crehhen aḏ freḥḥen, <verse eid="ACT 2:46" /><verse number="47" style="v" sid="ACT 2:47" />aḏ tsebḥen y rebbiy. aḏ wsiyn ƹejben y midden. aḏ yusi rebbiy kul as irenni midden y lmumnin lliy menƹen.<verse eid="ACT 2:47" /></para>
  <chapter eid="ACT 2" />
  <chapter number="3" style="c" sid="ACT 3" />
  <para style="s">meclul lliy yekker yeggur</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1" />ijuwas ireḥ buṭrus aḏ yuwḥenna al lheykel bac azellen tẓalliṯ n tmeddiṯ. <verse eid="ACT 3:1" /><verse number="2" style="v" sid="ACT 3:2" />aḏ af lbab n lheykel lliy mmelnas imi lliy yezƹem yusi yetgeƹmaz argaz d meclul s manis yluled. aḏ wsiyn midden kul as teγentiḏ bac ayeḍleb ṣṣedqeṯ seg indin lliy teḏfen al lheykel.<verse eid="ACT 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 3:3" />mniyn yezra buṭrus aḏ yuwḥenna taḏeḏfen yeḍleb s γarsen ṣṣedqeṯ. <verse eid="ACT 3:3" /><verse number="4" style="v" sid="ACT 3:4" />yaxy smuqelnas yeqƹeḏ, aḏ yuwayas buṭrus: «smuqleneγ.» <verse eid="ACT 3:4" /><verse number="5" style="v" sid="ACT 3:5" />yaxy yerceq ṭiṭawinis disen. yesugum asucen ṣṣedqeṯ. <verse eid="ACT 3:5" /><verse number="6" style="v" sid="ACT 3:6" />yuwayas buṭrus: «wiγri la lfejreṯ la wureγ. lekenti tafuceγ lliy γari; s ysem n yesuwƹ lmesiyḥ lliy seg nnaṣira, yya kker yyur.» <verse eid="ACT 3:6" /><verse number="7" style="v" sid="ACT 3:7" />aḏ s fusis limina ysekri.</para>
  <para style="p" vid="ACT 3:7">yaxy ƹlewleh uzellen iḏemmen g idernis aḏ inerzewnis. <verse eid="ACT 3:7" /><verse number="8" style="v" sid="ACT 3:8" />ineggez yebbed yuḏel yeggur aḏ iƹedda yiḏesen al lheykel aḏ netta yeggur yetneggez aḏ yetsebbeḥ y rebbiy. <verse eid="ACT 3:8" /><verse number="9" style="v" sid="ACT 3:9" />zrent midden lkul lliy llan diyn yeggur yetsebbeḥ. <verse eid="ACT 3:9" /><verse number="10" style="v" sid="ACT 3:10" />mniyn ufent d aydin n neḍlab meclul lliy yusi diyma yetgeƹmaz zzaṯ lbab miren imewenesen aḏ wifhimenc mammeḵ iṣar aydin.<verse eid="ACT 3:10" /></para>
  <para style="s">lxuṭbeṯ n buṭrus g lheykel</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11" />mniyn yusi aydin n argaz ikerci g buṭrus aḏ yuwḥenna, fehhen midden. aḏ fzeƹen mleymen fellasen g lburṭal n suleyman. <verse eid="ACT 3:11" /><verse number="12" style="v" sid="ACT 3:12" />mniyn yezra aydin, yuweyasen buṭrus:</para>
  <para style="p" vid="ACT 3:12">«ayya aṯ israyil maγer tfehhem afelxaḍert n ayuh? aḏ maγer tesmuqulmaneγ amellaḵ s lquderteneγ naγ s dyenteneγ nerry yeggur? <verse eid="ACT 3:12" /><verse number="13" style="v" sid="ACT 3:13" />rahiy rebbiy n ibrahiym aḏ isḥaq aḏ yeƹquwb, rebbiy n ibabnneγ imejjed memmis yesuwƹ lliy tucimt kennim s ifesnuwem al tmettent aḏ ternim tluzzem biylaṭus lliy yusi tatiseyyeb bac atyenγ.<verse eid="ACT 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 3:14" />rahiy d kennim lliy tluzzem biylaṭus bac ayenγ meqdus ṣbiḥ aḏ teḍlebbem seyyeb n yjen ineγ g umkanis. <verse eid="ACT 3:14" /><verse number="15" style="v" sid="ACT 3:15" />aḏ tenγim lliy yettuc g temeddurt, lekenti rebbiy ysekri seg jar indin lliy mmuṯen aḏ neccin anecheḏ af aydin. <verse eid="ACT 3:15" /><verse number="16" style="v" sid="ACT 3:16" />aḏ s liyman s ismis, yerra ismis lquweṯ y ayuh n argaz lliy tessennemt aḏ tzarrem diyes. rahiy liyman s yesuwƹ yucas ṣṣeḥeṯ kamla zzaṯuwem.<verse eid="ACT 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17" />neči sseneγ, ay ya yeṯma lliy kennim aḏ imeqqernuwem witeggimc yiḏes teṣbiḥt afelxaḍert witsinemc. <verse eid="ACT 3:17" /><verse number="18" style="v" sid="ACT 3:18" />amyuh rebbiy yeggi matta yuwa af imewen n lenbiya lkul seg lemmi lliy lmesiyḥ lliy yenkiy tayettuƹeḏḏeb. <verse eid="ACT 3:18" /><verse number="19" style="v" sid="ACT 3:19" />tabeṯ y rebbiy teḏwelmas bac afenyeγfer ibekkaḍnuwem. we afendesen ussan n lefrej s rebbiy. <verse eid="ACT 3:19" /><verse number="20" style="v" sid="ACT 3:20" />we afenyenkiy tijekkelt iḍen yesuwƹ lmesiyḥ lliy iwezeyewemtiḏ. <verse eid="ACT 3:20" /><verse number="21" style="v" sid="ACT 3:21" />afelxaḍert lazem ayeqqim lmesiyḥ g ujenna almiy adyas lweqt lliy tayferrej diyes rebbiy af ddunyeṯ mammeḵ yuwa af imewen n lenbiyas ṣbiḥen s luwel.<verse eid="ACT 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 3:22" />yusi muwsa yuwa: «rahiy lliy diyma yella tafenyenkiy seg yeṯmewem nnabiy am neči. ggeṯ lliy tafenimel lkul. <verse eid="ACT 3:22" /><verse number="23" style="v" sid="ACT 3:23" />aḏ lliy witegc s dwiys ayemmukes seg midden n rebbiy.»<verse eid="ACT 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 3:24" />aḏ af ayuh n ussan uwan lenbiya lkul seg ṣemwyil al lliy usend beƹdis. <verse eid="ACT 3:24" /><verse number="25" style="v" sid="ACT 3:25" />y kennim lliy yuƹeḏ siyes rebbiy lenbiya. aḏ kennim d iwriṯen n lƹehd lliy yeggi rebbiy yid ibabnuwem. yuwa y ibrahiym: «s lxelfiḵ tanumreγ midden lkul n tammurt.» <verse eid="ACT 3:25" /><verse number="26" style="v" sid="ACT 3:26" />amyuh yenkiy rebbiy memmis y kennim d imezweren bac afeninumer we afenyer af igga n bekkeḍu.»<verse eid="ACT 3:26" /></para>
  <chapter eid="ACT 3" />
  <chapter number="4" style="c" sid="ACT 4" />
  <para style="s">buṭrus aḏ yuwḥenna g lmejmeƹ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1" />mniyn wsiyn buṭrus aḏ yuwḥenna duggan y midden, usennesend lkuhhan aḏ meqqar n iƹessasen n lheykel aḏ iṣedduwqiyiyen. <verse eid="ACT 4:1" /><verse number="2" style="v" sid="ACT 4:2" />γecceccen afelxaḍert buṭrus aḏ yuwḥenna wsiyn seƹzamen aḏ mmelen y midden lliy tneḵri n lliy mmuṯen d leḥqiqeṯ madam yekker yesuwƹ. <verse eid="ACT 4:2" /><verse number="3" style="v" sid="ACT 4:3" />yaxy ṭfenten luḥenten g lḥebs al ača afelxaḍert yusi d ggiḍ. <verse eid="ACT 4:3" /><verse number="4" style="v" sid="ACT 4:4" />aḏ wsiyn ggeṯ seg indin lliy slen lxuṭbeṯ umennen almiy ḏwelen lmumnin ḥaḍrebac 5,000 seg irgazen.<verse eid="ACT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5" />al ača tajji mleymen g uwrceliym imeqqaren n wuḏeyen aḏ iwessaren aḏ lliy seḥfeḍen g cceriyƹeṯ. <verse eid="ACT 4:5" /><verse number="6" style="v" sid="ACT 4:6" />aḏ yiḏesen ḥennan rreyes n lkuhhan aḏ qayafa aḏ yuwḥenna aḏ skender aḏ nnasenesen lkul. <verse eid="ACT 4:6" /><verse number="7" style="v" sid="ACT 4:7" />yaxy sγuyen y buṭrus aḏ yuwḥenna sesetnenten: «mam yucewem lquweṯ bac aggem ayuh aḏ s ysem n mam teggimt.»<verse eid="ACT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 4:8" />yečur buṭrus seg rruwḥ lqudus yuwayasen:</para>
  <para style="p" vid="ACT 4:8">«ayya imeqqaren n cceƹb, ayya iwesserenis, <verse eid="ACT 4:8" /><verse number="9" style="v" sid="ACT 4:9" />kan tesestunem diyneγ as wuh afelxaḍert n lxiyr lliy neggi y ayuh n umeclul bac asnem mammeḵ yeḥla, <verse eid="ACT 4:9" /><verse number="10" style="v" sid="ACT 4:10" />yexs asnem lkulkum aḏ aṯ israyil lkul lliy s ysem n yesuwƹ lmesiyḥ nnaṣiriy lliy teṣlebbemt aḏ lliy ysekri rebbiy seg jar lliy mmuṯen. rahiy s ismis yebbed ayuh n umeclul zzaṯuwem yeḥla. <verse eid="ACT 4:10" /><verse number="11" style="v" sid="ACT 4:11" />rahiy yesuwƹ am aḍγaγ lliy tluḥemt ayya ibennayen. yeḏwel netta d lsas meqqar n terkineṯ. <verse eid="ACT 4:11" /><verse number="12" style="v" sid="ACT 4:12" />aḏ widdic mam yesemneƹ kan netta afelxaḍert widdic ysem iḍen adug jenna yuci rebbiy y midden bac anemneƹ siyes.»<verse eid="ACT 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13" />yaxy fehhen lliy ḥderren seg ṯṯiqeṯ n buṭrus aḏ yuwḥenna g imanesen afelxaḍert ssenen lliy nihnin wiƹzimenc aḏ seg ssayer n midden. aḏ fhemmen lliy nihnin wsiyn yid yesuwƹ. <verse eid="ACT 4:13" /><verse number="14" style="v" sid="ACT 4:14" />aḏ afelxaḍert zren meclul yebbed yiḏesen wiquddenc arren af buṭrus aḏ yuwḥenna.<verse eid="ACT 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 4:15" />amma uwanasen afγen seg lmejlis bac amcewren jaresen. <verse eid="ACT 4:15" /><verse number="16" style="v" sid="ACT 4:16" />aḏ uwan: «matta aneg s ayuh n sen n irgazen? zzaṯ midden n uwrceliym tṣar af ifesnesen lmuƹjizaṯ aḏ lemayer. winetqudduc anmel lliy nettaṯ d tikerkas. <verse eid="ACT 4:16" /><verse number="17" style="v" sid="ACT 4:17" />amma bac wisellenc midden lkul s ayuh n dwiy yexs atenneseggeḏ bac maƹadc aḏuflayen y midden af ayuh n ysem beƹd as wuh.» <verse eid="ACT 4:17" /><verse number="18" style="v" sid="ACT 4:18" />wembeƹd uγentend aḏ uwanasen «widugeṯec y midden aḏ wisenseḥfeḍec ism n yesuwƹ xlaṣ.»<verse eid="ACT 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 4:19" />lekenti buṭrus aḏ yuwḥenna uwan: «mleṯ lḥeq zzaṯ rebbiy. s dwiy n mam yexs aneg? s dwiywem naγ s dwiy n rebbiy? <verse eid="ACT 4:19" /><verse number="20" style="v" sid="ACT 4:20" />rahiy winetqudduc anbeṭṭel dwiy af lliy nezri aḏ nesli.»<verse eid="ACT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 4:21" />yaxy djullen disen imeqqaren n lmejlis man γiyr man atenƹeqben aḏ sibyenten afelxaḍert ugeḏḏen seg midden lliy wsiyn lkulhum tsebḥen y rebbiy af lmuƹjizaṯ lliy zrenteṯ. <verse eid="ACT 4:21" /><verse number="22" style="v" sid="ACT 4:22" />aḏ argaz lliy yeḥla ifaṯ 40 d isuggasen.<verse eid="ACT 4:22" /></para>
  <para style="s">tẓalliṯ n lmumnin</para>
  <para style="p" />
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23" />mniyn siybenten, buṭrus aḏ yuwḥenna ḏwellen ƹlewleh al yeṯmesen ƹeweḏnesen matta uwanasen imeqqaren n lkuhhan aḏ iwessaren. <verse eid="ACT 4:23" /><verse number="24" style="v" sid="ACT 4:24" />beƹd mag slen dwiysen, zullen y rebbiy s ul yjen uwan:</para>
  <para style="p" vid="ACT 4:24">«ay rebbiy lliy iteg kulci aḏ lliy yeggi jenna aḏ tammurt aḏ iylel aḏ lliy disen lkul, <verse eid="ACT 4:24" /><verse number="25" style="v" sid="ACT 4:25" />ayya lliy tuwiḏ s rruwḥ lqudus af imi n babenneγ dawud lliy d lƹebdiḵ:</para>
  <para style="p" vid="ACT 4:25" />
  <para style="q2" vid="ACT 4:25">&lt;af rebbiy maγer midden n lummem lkul thadjan?</para>
  <para style="q2" vid="ACT 4:25">s lbaṭel y beƹeḍhum tewecucen?<verse eid="ACT 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 4:26" />lemluk n tammurt aḏ imeqqarnis</para>
  <para style="q2" vid="ACT 4:26">mleymen af lliy diyma yella</para>
  <para style="q2" vid="ACT 4:26">lliy iwazayi taḥerben. &gt;<verse eid="ACT 4:26" /></para>
  <para style="p" />
  <para style="p">
    <verse number="27" style="v" sid="ACT 4:27" />aḏ yentem ayuh n dwiy nembelḥeq dehnit mniyn mleymen hiyruwdus aḏ biylaṭus benṭy yid midden n israyil aḏ midden ttaniyeṯ bac aḥerben memmiḵ yesuwƹ meqdus lliy teggit d lmesiyḥ. <verse eid="ACT 4:27" /><verse number="28" style="v" sid="ACT 4:28" />aḏ ggen yiḏes lliy s lqudertiḵ texseḏ aḏ tesmuḏeḏ ayṣar.<verse eid="ACT 4:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 4:29" />ṭuruh smuqel ay rebbiy mammeḵ segeḏen diyneγ. aḏ ucaneγ lquweṯ bac anṣaṣel dwiḵ menγir tiwdi. <verse eid="ACT 4:29" /><verse number="30" style="v" sid="ACT 4:30" />aḏ zzel fusiḵ bac aḥlan midden we aṣerneṯ lmuƹjizaṯ d lemayer aḏ leγrayeb s ysem n yesuwƹ memmiḵ meqdus.»<verse eid="ACT 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 4:31" />beƹd mag zullen yerjij mkan lliy wsiyn diyes aḏ čuren lkul s rruwḥ lqudus, aḏ uḏellen tbecren s dwiy n rebbiy menγer tiwdi.<verse eid="ACT 4:31" /></para>
  <para style="s">lmumnin tzunun kul ciy jaresen</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32" />aḏ wsiyn lmumnin kul ciysen jmiyƹ, amellaḵ γarsen ul yjen naγ nihnin d argaz yjen. aḏ ḥetta d yjen sisen wiyemmil af ḥaja γares nnuw weḥdi amma yusi kulci jaresen d ccerkeṯ. <verse eid="ACT 4:32" /><verse number="33" style="v" sid="ACT 4:33" />aḏ wsiyn imersal tbecren s tneḵri n yesuwƹ aḏ yiḏesen lquweṯ n rebbiy. aḏ nnaƹmeṯ temeqqart tzugga fellasen lkul. <verse eid="ACT 4:33" /><verse number="34" style="v" sid="ACT 4:34" />aḏ willic jaresen mam meḥtaj afelxaḍert indin lliy γarsen imezdeγen naγ tizeγwin wsiyn zenzan mag γarsen aḏ tucen lḥeqqis <verse eid="ACT 4:34" /><verse number="35" style="v" sid="ACT 4:35" />y imersal. aḏ nihnin tzununt af lliy setḥeqqen af leḥsab n mag yelzemmasen.<verse eid="ACT 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36" />aḏ sisen yuwsef lliy semment imersal bernaba yeƹni memmis n ucejjeƹ aḏ netta seg leƹcireṯ n lawiy seg qubruṣ. <verse eid="ACT 4:36" /><verse number="37" style="v" sid="ACT 4:37" />yusi γares mezdeγ, yezenzy yuγed lḥeqqis yuci y imersal.<verse eid="ACT 4:37" /></para>
  <chapter eid="ACT 4" />
  <chapter number="5" style="c" sid="ACT 5" />
  <para style="s">ḥenaniya aḏ ṣeffira</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1" />lekenti yella yjen ismis ḥenaniya yemfehem netta aḏ lehlis ṣeffira, yezenza mezdeγis. <verse eid="ACT 5:1" /><verse number="2" style="v" sid="ACT 5:2" />amma yewya fercu seg iflusnis aḏ yuca lliy yefdelled y imersal.<verse eid="ACT 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 5:3" />yaxy yuwayas buṭrus: «ay ḥenaniya, maγer tedjiḏ cciyḍan ayečar uliḵ aḏ teskerekseḏ af rruwḥ lqudus. aḏ tedjiḏ fercu n iflusen γareḵ? <verse eid="ACT 5:3" /><verse number="4" style="v" sid="ACT 5:4" />yaxy muc γareḵ lḥeq witzenzic? aḏ kan tezenzet muc γareḵ lḥeq awyeḏ iflusnis lkul y cek weḥdeḵ? maγer zeγ tesmuḏeḏ af uγuccu? rahiy amyuh cek witeskerkisec af midden amma af rebbiy teskerekseḏ.»<verse eid="ACT 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 5:5" />mniyn yesla ḥenaniya ayuh n dwiy, yuda ƹlewleh yemmuṯ. yaxy ugeḏḏen ggeṯ midden lliy slen s aydin. <verse eid="ACT 5:5" /><verse number="6" style="v" sid="ACT 5:6" />aḏ kkeren imezyanen kefnen ḥenaniya. aḏ awyent nbellent.<verse eid="ACT 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7" />aḏ beƹd 3 seƹat, tused leƹyal n ḥenaniya aḏ nettaṯ witesinc mag iṣar. <verse eid="ACT 5:7" /><verse number="8" style="v" sid="ACT 5:8" />yaxy ysesetniṯ buṭrus: «mliḏ. yaxy s ayuh n iflusen akehaw tezenzem mezdeγ.» trras: «s ayuh n ssum nezenzy.»<verse eid="ACT 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 5:9" />yuwayas buṭrus: «maγer tesmuḏeḏ cem aḏ argazim atetƹeddim af rruwḥ n rebbiy? qa zeγ rrend imezyanen lliy nbellen argazim. tamuyen cemmin zada.» <verse eid="ACT 5:9" /><verse number="10" style="v" sid="ACT 5:10" />yaxy ƹlewleh tuda zzaṯ buṭrus temmuṯ.</para>
  <para style="p" vid="ACT 5:10">mniyn uḏeffen imezyanen ufenteṯ temmuṯ. awyenteṯ nbelenteṯ tman argazis. <verse eid="ACT 5:10" /><verse number="11" style="v" sid="ACT 5:11" />yaxy rjijen lmumnin n lmejmeƹ lkul aḏ midden lkul lliy slen s aydin zada.<verse eid="ACT 5:11" /></para>
  <para style="s">temeddurt n imersal aḏ lmumnin</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12" />aḏ af ifesn n imersal uqeƹneṯ ggeṯ d lmuƹjizaṯ d lemayer aḏ leγrayeb zzaṯ midden. lmumnin temleyamen jmiyƹ g lburṭal n suleyman. <verse eid="ACT 5:12" /><verse number="13" style="v" sid="ACT 5:13" />aḏ s tiwdi, wiqud ḥetta d yjen seg indin lliy wicci wuminenc ayeḏef yiḏesen. amma wsiyn midden lkul cekren disen.<verse eid="ACT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 5:14" />aḏ yuḏel leƹded n lmumnin irenni afelxaḍert umennen ggeṯ d irgazen aḏ d tiseḏnan. <verse eid="ACT 5:14" /><verse number="15" style="v" sid="ACT 5:15" />aḏ wsiyn midden ssuffuγen g imuḍanesen al barra af sserresen belekci adyas af yjen sisen ṭṭel n buṭrus almiy tayƹedda we ayeḥla. <verse eid="ACT 5:15" /><verse number="16" style="v" sid="ACT 5:16" />midden lliy mlaymen seg tmurewin aḏ leḥwem lliy qrebneṯ al uwrceliym wsiyn tasend aḏ teγend imuḍanesen aḏ lliy stemelken bac aḥlan.<verse eid="ACT 5:16" /></para>
  <para style="p" />
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17" />yaxy meqqar n lkuhhan aḏ lliy nnaḍḍen siyes seg indin lliy d iṣedduwqiyiyen nγerren seg imersal. <verse eid="ACT 5:17" /><verse number="18" style="v" sid="ACT 5:18" />aḏ ṭfenten ggenten g lḥebs. <verse eid="ACT 5:18" /><verse number="19" style="v" sid="ACT 5:19" />lekenti g yiḍ imir lmleyka n rebbiy lbiban n lḥebs bac afγen aḏ yuwayasen: <verse eid="ACT 5:19" /><verse number="20" style="v" sid="ACT 5:20" />«ureḥeṯ al lheykel tebeddem tuflayem y midden af lebcareṯ n tmeddurt tejdit lkul.» <verse eid="ACT 5:20" /><verse number="21" style="v" sid="ACT 5:21" />yaxy ggen s dwiys. reḥḥen al lheykel tajji bekri seḥfeḍen g midden.</para>
  <para style="p" vid="ACT 5:21">aḏ wsiyn rrayes n lkuhhan aḏ lliy yiḏes mleymen g lmejles. aḏ ḥderren diyes iwessaren n aṯ israyil. aḏ nkiyyen iƹessasen bac adeγen imersal seg lḥbes. <verse eid="ACT 5:21" /><verse number="22" style="v" sid="ACT 5:22" />lekenti witenufin. aḏ usend uwan y lliy g lmejles. <verse eid="ACT 5:22" /><verse number="23" style="v" sid="ACT 5:23" />«rahiy nufa lbiban n lḥebs ṣleḥḥen yeqƹeḏ aḏ iƹessasen bbedden zzaṯesen, lekenti mniyn nmir winufi ḥetta d yjen jaj.» <verse eid="ACT 5:23" /><verse number="24" style="v" sid="ACT 5:24" />yaxy ifeh meqqar n iƹessasen n lheykel aḏ imeqqaren n lkuhhan mniyn slen ayuh n dwiy aḏ sesetnen beƹeḍhum: «mani taneṣel zeƹma.»<verse eid="ACT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 5:25" />yaxy yused yjen al lmejles yuwa: «rahiy indin lliy teggimten g lḥebs llan g lheykel seḥfeḍen g midden.» <verse eid="ACT 5:25" /><verse number="26" style="v" sid="ACT 5:26" />ireḥ meqqar n iƹessasen netta aḏ irgazenis uγend imersal s ufercu afelxaḍert ugeḏḏen atenḥedfen midden.<verse eid="ACT 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 5:27" />mniyn bbedden zzaṯ lmejles ysesetnin rreyes n lkuhhan. <verse eid="ACT 5:27" /><verse number="28" style="v" sid="ACT 5:28" />yuwa: «nuweyewem yesaq aseḥefdem s ysem n ayuh n argaz, lekenti witedjim mani witseƹezmem g uwrceliym, aḏ texsem aggem iḏemenis g tḵerminneγ.»<verse eid="ACT 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 5:29" />yerras buṭrus aḏ imersal:</para>
  <para style="p" vid="ACT 5:29">«yexs aneg lliy yexs rebbiy muc lliy xsen midden. <verse eid="ACT 5:29" /><verse number="30" style="v" sid="ACT 5:30" />rahiy rebbiy n ibabnenneγ ysekker yesuwƹ lliy tƹelqemt af ṣṣelib aḏ tenγimt. <verse eid="ACT 5:30" /><verse number="31" style="v" sid="ACT 5:31" />lekenti rebbiy yselyi af liminis aḏ yeggi d lmelek lliy taysemneƹ aṯ israyil. we ayteba fellesen we asenyeγfer ubekkeḍu. <verse eid="ACT 5:31" /><verse number="32" style="v" sid="ACT 5:32" />aḏ neccin ncehheḏ af ayuh. aḏ rruwḥ lqudus lliy yenkiyi rebbiy y lliy tteggen s dwiys ycehheḏ zada.»<verse eid="ACT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33" />mniyn slen lliy mleymen ayuh n dwiy, γecceccen ggeṯ aḏ smuḏen af tmenγiwt n imersal. <verse eid="ACT 5:33" /><verse number="34" style="v" sid="ACT 5:34" />lekenti yjen seg lmejles ismis γemelayil aḏ netta yeseƹzam g cceriyƹeṯ aḏ ydebbeƹ g iferysiyyen aḏ xsent midden lkul, yebbed yuwayasen asefγen imersal ferru. <verse eid="ACT 5:34" /><verse number="35" style="v" sid="ACT 5:35" />wembeƹd, yuwa y lliy g lmjles;</para>
  <para style="p" vid="ACT 5:35">«ayya aṯ israyil, rreṯ lbaluwem aggem y ayuh n irgazen lliy tesmuḏem fellas. <verse eid="ACT 5:35" /><verse number="36" style="v" sid="ACT 5:36" />kennim tetesmitim lliy yeḍherred ṯuwdas aḏ yuwa lliy netta d mebruk aḏ ḏbeƹƹent 400 lekenti mniyn yemmuneγ mferqen lliy debƹen diyes aḏ ykemmel kul ciy. <verse eid="ACT 5:36" /><verse number="37" style="v" sid="ACT 5:37" />aḏ yused zada yehuwḏa jeliyliy g lweqt n uƹuddu n midden. yenzeγ ggeṯ d midden bac atḏebƹen. mniyn yemmuṯ mferqen lliy wsiyn debƹen diyes zada. <verse eid="ACT 5:37" /><verse number="38" style="v" sid="ACT 5:38" />amma ṭuruh tafenemleγ beƹdeṯ af ayuh n irgazen tedjemten af lkifesen. kan ayuh n rray naγ ayuh n igga s midden ṭuru ayehdem weḥdes. <verse eid="ACT 5:38" /><verse number="39" style="v" sid="ACT 5:39" />amma kan ayuh s rebbiy. rahiy witetquddumc xlaṣ beddem zzaṯis naγ adlem d leƹda n rebbiy zada.»<verse eid="ACT 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 5:40" />yaxy uγen lliy g lmejles s dwiys aḏ sγuyen y imersal wettenten s ṣṣuwṭ aḏ uwanasen wiseƹzemec s ysem n yesuwƹ wembeƹd seybenten.<verse eid="ACT 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="ACT 5:41" />lekenti imersal ffeγen seg lmejles freḥḥen afelxaḍert ufin imanesen stehelen bac atteƹben afelxaḍert n ysem n yesuwƹ. <verse eid="ACT 5:41" /><verse number="42" style="v" sid="ACT 5:42" />aḏ kul as g lheykel aḏ tzaγwin wsiyn seḥfeḍen aḏ tbecren lliy yesuwƹ d netta d lmesiyḥ menγir beṭṭel.<verse eid="ACT 5:42" /></para>
  <chapter eid="ACT 5" />
  <chapter number="6" style="c" sid="ACT 6" />
  <para style="s">awazi n 7 y uƹawen n imersal</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1" />ussan diyn rnin tlamḏa. aḏ xernennen wuḏeyen iberraniyen af ibeldiyen afelxaḍert tedjelinesen wileqinec lbayesneṯ seg lƹineṯ lliy ttucenteṯ kul as.<verse eid="ACT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 6:2" />yaxy sγuyen imersal af tlamḏa uwanasen: «widyettic siyes anedj beccer s lmesiyḥ bac anelha s uca n lƹineṯ. <verse eid="ACT 6:2" /><verse number="3" style="v" sid="ACT 6:3" />ayya yeṯmenneγ wazeṯ 7 siwem d ṣbiḥen aḏ čuren s rruwḥ lqudus aḏ tmesniwt bac aggen ayuh n lxeḏmeṯ. <verse eid="ACT 6:3" /><verse number="4" style="v" sid="ACT 6:4" />we anelha neccin s tẓalliṯ aḏ ubeccer.»<verse eid="ACT 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 6:5" />yeƹjebbesen ayuh n dwiy. yaxy wazan istifanus aḏ netta yečur s liyman aḏ rruwḥ lqudus, aḏ filibbus, aḏ burxurus, aḏ nikenur, aḏ tiymun, aḏ berminas, aḏ niqulawus lliy seg anṭakiya yeḏwel d uḏay. <verse eid="ACT 6:5" /><verse number="6" style="v" sid="ACT 6:6" />aḏ uyenten al imersal lliy ẓullen aḏ ggen ifesnesen fellasen. <verse eid="ACT 6:6" /><verse number="7" style="v" sid="ACT 6:7" />aḏ yerniy dwiy n rebbiy yuṣel al ggeṯ d midden. aḏ rnin ggeṯ lliy ḥefden g uwrceliym. qbellen ggeṯ d lkuhhan s yesuwƹ aḏ umennen.<verse eid="ACT 6:7" /></para>
  <para style="s">iṭṭaf n istifanus</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8" />istifanus lliy yečur s nnaƹmeṯ n rebbiy aḏ lqudretis, yusi yetteg leƹjayeb aḏ lmuƹjizaṯ d lemayer zzaṯ midden. <verse eid="ACT 6:8" /><verse number="9" style="v" sid="ACT 6:9" />yaxy bbedenas irgazen n lmejmeƹ n leḥrar lliy wsiyn d ičiwen lliy usend seg lqiriniya aḏ liskenderiya aḏ midden iḍen seg kilikiya aḏ asiya. aḏ qqimen tkaceḥen diyes. <verse eid="ACT 6:9" /><verse number="10" style="v" sid="ACT 6:10" />lekenti wiquddenc rren af lḥikemtis aḏ rruwḥ lliy ydugga af imis. <verse eid="ACT 6:10" /><verse number="11" style="v" sid="ACT 6:11" />yaxy ucen iflusen y lbeƹḍ n midden bac amlen lliy nihnin slen istifanus ideƹƹu g muwsa aḏ rebbiy.<verse eid="ACT 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 6:12" />aḏ čuren fellas ulawen n midden aḏ iwesseren aḏ lliy seḥfeḍen g cceriyƹeṯ. yaxy ṭṭefent. aḏ awyent al lmejles meqqar.<verse eid="ACT 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 6:13" />aḏ uγend mam yecheḏ felles s tkerkas. aḏ uwan lliy netta diyma ideƹƹu g lheykel aḏ cceriyƹeṯ. <verse eid="ACT 6:13" /><verse number="14" style="v" sid="ACT 6:14" />aḏ uwan: «neslas yemmal: &lt; rahiy yesuwƹ nnaṣiriy tayehdem lheykel we aybeddel lefrayeḍ lliy yucenextend muwsa. &gt; » <verse eid="ACT 6:14" /><verse number="15" style="v" sid="ACT 6:15" />mniyn smuqelnas lliy llan g lmejles meqqar lkul zren uḏmis yetreq amellaḵ d uḏem n lmleyka.<verse eid="ACT 6:15" /></para>
  <chapter eid="ACT 6" />
  <chapter number="7" style="c" sid="ACT 7" />
  <para style="s">lxuṭbeṯ n istifanus</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1" />ysesten rreyes n lkuhhan istifanus: «ayuh n dwiy lliy uwant fellaḵ nembelḥeq naγ aha.» <verse eid="ACT 7:1" /><verse number="2" style="v" sid="ACT 7:2" />yaxy yerras:</para>
  <para style="p" vid="ACT 7:2">«ayya yeṯma, ayya iḏbaba, sseγdeṯ: yeḍherred rebbiy n lmejd y babenneγ ibrahiym g tammurt lliy jar lwiḏan, qebbel man ayerzef we ayesken g ḥaran. <verse eid="ACT 7:2" /><verse number="3" style="v" sid="ACT 7:3" />yuwayas rebbiy: «ffeγ seg tammurtiḵ aḏ midniḵ treḥḥeḏ al tammurt lliy taftedsiḵneγ.» <verse eid="ACT 7:3" /><verse number="4" style="v" sid="ACT 7:4" />yeggi s dwiys. yeffeγ seg tammurt n ikeldaniyen. yesken g ḥaran almiy yemmuṯ babis.</para>
  <para style="p" vid="ACT 7:4">wembeƹd yuγettiḏ rebbiy al ayuh n mkan lliy tseknem diyes ṭuruh. <verse eid="ACT 7:4" /><verse number="5" style="v" sid="ACT 7:5" />aḏ wisyucic ḥetta ciy seg lmelk n ddunyeṯ. wisyucic ḥetta d cebber n tammurt deh. amma yuƹeḏ tasyuc tammurt tuwh y netta aḏ ṭarwas beƹdis. aḏ netta yusi wicci wiγrec imeckenen. <verse eid="ACT 7:5" /><verse number="6" style="v" sid="ACT 7:6" />yuwayas rebbiy lliy ṭarwa n ṭarwas taƹanan seg lγurbeṯ g tammurt muc nnasen 400 d isuggasen. we aḏulen d lƹebiyd we aḏellen. <verse eid="ACT 7:6" /><verse number="7" style="v" sid="ACT 7:7" />lekenti taƹeqbeγ indin lliy tateneggen d lƹebiyd. wembeƹd tafγen bac adesen alzellen g ayuh n mkan.<verse eid="ACT 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 7:8" />aḏ yuwa rebbiy y ibrahiym aydehher ṭarwas d lemereṯ n lƹehd lliy yeggi yiḏes. yaxy ydehher ibrahiym isḥaq g as ṯṯamen. aḏ ydehher isḥaq memmis yeƹquwb. aḏ ydehher yeƹquwb ṭarwas s ṯnac aḏ nihnin d ibaben n aṯ israyil.<verse eid="ACT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9" />aḏ ibaben n aṯ israyil lliy nihnin d aweṯen n yuwsef nγerren siyes. aḏ zenzent d lƹebd g miṣr. lekenti rebbiy yusi yiḏes. <verse eid="ACT 7:9" /><verse number="10" style="v" sid="ACT 7:10" />aḏ ysemenƹi seg lmṣayeb lkul lliy ƹeddaneṯ af ixfis aḏ yucas nnaƹmeṯ aḏ tmesniwt zzaṯ ferƹuwn lmelek n miṣr. yaxy yeggi d lḥakem af miṣr aḏ af leqṣuris.<verse eid="ACT 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 7:11" />aḏ tƹedda af miṣr aḏ kenƹan zemmeṯ aḏ ḍḍiq d meqqar. yaxy wiḏufinc ibabnenneγ man ačan. <verse eid="ACT 7:11" /><verse number="12" style="v" sid="ACT 7:12" />yesla yeƹquwb lliy g miṣr diyes irden, yenkiyas ibabnenneγ tijekkelt temezwert. <verse eid="ACT 7:12" /><verse number="13" style="v" sid="ACT 7:13" />mniyn iƹaweḏ yenkiyin tijekkelt iḍen, yuwayasen yuwsef d mam netta. aḏ yesla ferƹuwn s leṣel n yuwsef.<verse eid="ACT 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 7:14" />yenkiy yuwsef y babis bac adyas al miṣr netta aḏ nnasenis lliy wsiyn lkulhum 75. <verse eid="ACT 7:14" /><verse number="15" style="v" sid="ACT 7:15" />yused yeƹquwb al miṣr. aḏ yqqim diyes netta aḏ ibabnenneγ almiy muṯen. <verse eid="ACT 7:15" /><verse number="16" style="v" sid="ACT 7:16" />aḏ ḥewlenten al cakiym. aḏ dfenenten g leqber lliy yesγi ibrahiym s lfejreṯ af leƹcireṯ n ḥamura bab n cakiym.<verse eid="ACT 7:16" /></para>
  <para style="p" />
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17" />mniyn ḥaḍarbac tayeg rebbiy lliy yuƹeḏ siyes ibrahiym, yusi leƹded n israyiliyen yerniy ggeṯ g miṣr. <verse eid="ACT 7:17" /><verse number="18" style="v" sid="ACT 7:18" />aḏ yused lmelk d jdiḏ wiyiwiḍc af yuwsef. <verse eid="ACT 7:18" /><verse number="19" style="v" sid="ACT 7:19" />yaxy iƹeddayiṯ af ibabnenneγ aḏ idurrin almiy selmen g imeckenesen bac ammuṯen.<verse eid="ACT 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 7:20" />ussan diyn yluled muwsa. aḏ yusi yezƹem ggeṯ. rebbent ibabnis 3 chuwr γarsen. <verse eid="ACT 7:20" /><verse number="21" style="v" sid="ACT 7:21" />mniyn yemluweḥ, testebnat yellis n ferƹuwn tessima diyes am memmis. <verse eid="ACT 7:21" /><verse number="22" style="v" sid="ACT 7:22" />yeḥfeḍ muwsa leƹlum n miṣr lkul yeḏwel d lfeleḥ g dwiy aḏ lxeḏmeṯ.<verse eid="ACT 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 7:23" />mniyn yeḏwel lƹemris 40 d isuggasen, yexderras ijuwas bac ayḥekker leḥwal n yeṯmas seg aṯ israyil. <verse eid="ACT 7:23" /><verse number="24" style="v" sid="ACT 7:24" />yaxy yezra yjen yetcaṯ diyes miṣri, iḥama fellas, iwet miṣri yenγi. <verse eid="ACT 7:24" /><verse number="25" style="v" sid="ACT 7:25" />aḏ idun lliy yeṯmas tafehmen lliy rebbiy tatenisemneƹ af ifesnis. lekenti nihnin wifhimenc.<verse eid="ACT 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 7:26" />al ača, yufa sen sisen tnuγun, yserḥin. aḏ yuwayasen: &lt; ayya irgazen kennim d aweṯen, ima teteṯƹeddim af beƹeḍkum. &gt;<verse eid="ACT 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 7:27" />yaxy lliy yeḍlem rnawis iduzzi yuwayas: &lt; mam yeggaḵ fellenneγ d rreyes aḏ d lqaḍi jarenneγ? <verse eid="ACT 7:27" /><verse number="28" style="v" sid="ACT 7:28" />yaxy texseḏ altenγeḏ mammeḵ tenγiḏ miṣri aseneṭ?&gt; <verse eid="ACT 7:28" /><verse number="29" style="v" sid="ACT 7:29" />mniyn yesla muwsa ayuh n dwiy yerwel seg miṣr, ireḥ al midyan mani yedder d aγrib. aḏ diyes yuγed sen imeckenen.<verse eid="ACT 7:29" /></para>
  <para style="p" />
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30" />beƹd 40 d isuggasen, mniyn yusi muwsa g ṣṣeḥreṯ n siyna, yeḍherresd lmleyka n rebbiy g uhebluj n timsi seg tceƹƹelt teseγa. <verse eid="ACT 7:30" /><verse number="31" style="v" sid="ACT 7:31" />ifeh muwsa mniyn yezra aydin. aḏ mniyn ireḥ bac ayḥekker, yesla rebbiy yemmalas: <verse eid="ACT 7:31" /><verse number="32" style="v" sid="ACT 7:32" />&lt;neči d rebbiy n ibabniḵ, rebbiy n ibrahiym aḏ isḥaq aḏ yeƹquwb. &gt; yaxy yerjij muwsa aḏ wiqudc ayerni ayḥekker.<verse eid="ACT 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 7:33" />yuwayas rebbiy: &lt; kkes lbeleγtiḵ rahiy cek g mkan d meqdus. <verse eid="ACT 7:33" /><verse number="34" style="v" sid="ACT 7:34" />rahiy neči zriγ leƹḏab n cceƹbiw g miṣr, aḏ sliγ kuttusen. yaxy zwiγd bac atensemenƹeγ. yya yella, qa tafnekyeγ al miṣr. &gt;<verse eid="ACT 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35" />rahiy muwsa lliy wirlinc siyes midden aḏ uwanas: &lt; mam yeggaḵ d rreyes fellenneγ aḏ d lqaḍi jarenneγ?&gt; d netta lliy yenkiyi rebbiy d rreyes bac atenisemneƹ aḏ yiḏes lmelek n rebbiy lliy yeḍherresd g tceƹƹelt.<verse eid="ACT 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 7:36" />aḏ yseffeγ midden seg miṣr aḏ netta iteg g lmuƹjizaṯ d lemayer aḏ leγrayeb diyes aḏ g iylel zuggaγ aḏ g ṣṣeḥreṯ n siyna 40 d isuggasen. <verse eid="ACT 7:36" /><verse number="37" style="v" sid="ACT 7:37" />aḏ muwsa d netta lliy yuwa y aṯ israyil: &lt; rahiy rebbiy tafenyenkiy yjen seg yeṯmewem d nnabiy am neči. &gt; <verse eid="ACT 7:37" /><verse number="38" style="v" sid="ACT 7:38" />d netta lliy yusi yiḏesen g lmejmeƹ g ṣṣeḥreṯ. aḏ d netta lliy yusi yid lmleyka n rebbiy lliy yduggeyas af jbel n siynay. aḏ d netta lliy yelqa s γares dwiy n tmeddurt bac aγentiḏiseṣel. <verse eid="ACT 7:38" /><verse number="39" style="v" sid="ACT 7:39" />amma ibabnenneγ bbedenas aḏ wiqqilen atḏebƹen. aḏ smuḏen taḏulen al miṣr.<verse eid="ACT 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 7:40" />aḏ uwan y haruwn asenyegga irebbiyen bac ayuren zzaṯesen. aḏ uwanas: &lt; rahiy winessinc mag iṣar y ayuh n muwsa lliy ysefγeneγ seg miṣr. &gt; <verse eid="ACT 7:40" /><verse number="41" style="v" sid="ACT 7:41" />yaxy ggen ṣembeṯ am ugenduz g ussan diyn aḏ aγresnas. aḏ freḥḥen s mag ggen.<verse eid="ACT 7:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 7:42" />yaxy yedjin rebbiy tẓallan y iṯran n ujenna mammeḵ yetweri g lektub n lenbiya:</para>
  <para style="p" vid="ACT 7:42" />
  <para style="q2" vid="ACT 7:42">&lt;yaxy teγresemiḏ g ṣṣeḥreṯ naγ tucimiḏ lweƹdeṯ</para>
  <para style="q2" vid="ACT 7:42">g ayuh n 40 d isuggasen ay ya aṯ israyil?<verse eid="ACT 7:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="ACT 7:43" />aha, amma tqamem lƹecceṯ n lmuluk,</para>
  <para style="q2" vid="ACT 7:43">aḏ ṣembeṯ n iṯri n remfan lliy d rebbiywem.</para>
  <para style="q2" vid="ACT 7:43">ayuh n leṣnam lliy teggimten d irebbiyen tetzellimesen.</para>
  <para style="q2" vid="ACT 7:43">qa tafenzeƹezqeγ al mkan yebƹeḏ iṭer n babel. &gt;<verse eid="ACT 7:43" /></para>
  <para style="p" />
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44" />aḏ qamen ibabnenneγ g ṣṣeḥreṯ lƹecceṯ n lƹehd lliy yuwa rebbiy y muwsa bac atetyeg mammeḵ isiḵnas. <verse eid="ACT 7:44" /><verse number="45" style="v" sid="ACT 7:45" />wembeƹd uḏeffen siyes al ayuh n tammurt mniyn yusi yecuwƹ d lqeydesen. aḏ yusi rebbiy izeƹzeq lliy seknen diyes seg zzaṯesen. aḏ teqqim diyn al ussan n dawud. <verse eid="ACT 7:45" /><verse number="46" style="v" sid="ACT 7:46" />dawud lliy yerla felles rebbiy aḏ yeḍleb: &lt; ay rebbiy n yeƹquwb, adj afeggeγ mkan d meqdus. &gt; <verse eid="ACT 7:46" /><verse number="47" style="v" sid="ACT 7:47" />aḏ iṣar ayuh af ffus n suleyman lliy yebna lheykel.<verse eid="ACT 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 7:48" />lekenti rebbiy lliy yeƹla wisekkenc g lbni lliy ggenten ifesn n midden mammeḵ yuwa af imi n nnabiy.<verse eid="ACT 7:48" /></para>
  <para style="p" />
  <para style="q1">
    <verse number="49" style="v" sid="ACT 7:49" />&lt;jenna d lkursiyiw,</para>
  <para style="q2" vid="ACT 7:49">tammurt d teƹeffest n dariw.</para>
  <para style="q2" vid="ACT 7:49">matta zeγ teltebnim?</para>
  <para style="q2" vid="ACT 7:49">matta taggem bac alireyeḥ?<verse eid="ACT 7:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="ACT 7:50" />yenda muc s fusiw ggiγ ayuh n iḥjeyen lkul. &gt; »<verse eid="ACT 7:50" /></para>
  <para style="p" />
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51" />aḏ yuwa istifanus: «ayya lliy ixfewnewem qṣeḥḥen, ayya lliy ulawnewem aḏ tmezuγinuwem qeṣen am lkuffar. kennim tetḥarabem g rruwḥ lqudus am ibabnuwem. <verse eid="ACT 7:51" /><verse number="52" style="v" sid="ACT 7:52" />mantan seg lenbiya yemneƹ seg ḍulmesen? nihnin nγen lliy usend tbecren s ysa n lliy weḥdes d ṣbiḥ. aḏ kennim tucimt bac atenγen. <verse eid="ACT 7:52" /><verse number="53" style="v" sid="ACT 7:53" />rahiy kennim telqim cceriyƹeṯ seg ifesn n lmleyka aḏ witeggimc siyes.»<verse eid="ACT 7:53" /></para>
  <para style="s">temettent n istifanus</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54" />mniyn slen lliy ḥderren dwiys, teḍresen ggeṯ aḏ aqimen tmeγzezen felles. <verse eid="ACT 7:54" /><verse number="55" style="v" sid="ACT 7:55" />yečur s rruwḥ lqudus. iqam istifanus ixfis al ujenna. yaxy yezra lmejd n rebbiy aḏ yesuwƹ yebbed af liminis. <verse eid="ACT 7:55" /><verse number="56" style="v" sid="ACT 7:56" />yuwa: «zerreγ g ujenna imir aḏ lliy yeḏwel d bnaḏem yebbed af limin n rebbiy.»<verse eid="ACT 7:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="ACT 7:57" />yaxy ṣleḥen timezuγinesen, aḏ ṣeyḥen jmiyƹ. aḏ hjemen felles g lweqt yjen. <verse eid="ACT 7:57" /><verse number="58" style="v" sid="ACT 7:58" />zeƹezqent seg tmura bac tḥdefent s iḍγaγen. aḏ ccuhhaḏ kkesen ibernesesen zzaṯ yjen d mezyan ismis cawel.<verse eid="ACT 7:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="ACT 7:59" />mniyn wsiyn ḥedfen diyes yusi netta yemmal: «ay siydneγ yesuwƹ, qbel rruwḥiw.» <verse eid="ACT 7:59" /><verse number="60" style="v" sid="ACT 7:60" />aḏ yesjeḏ, yuwa s ṣṣut qwi: «ay rebbiy, wisenḥesebc ayuh n bekkeḍu.» mniyn yuwa ayuh qebesneṯ ṭiṭawinis.<verse eid="ACT 7:60" /></para>
  <chapter eid="ACT 7" />
  <chapter number="8" style="c" sid="ACT 8" />
  <para style="p" />
  <para style="s">cawel iḍellem g lliy tbecren s linjiyl</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1" />yerla cawel af tmenγiwt n istifanus. seg aydin n as yuḏel ḍḍulem d meqqar af lmejmeƹ n lmumnin g uwrceliym. aḏ mferqen g leḍraf n lyehuwdiya aḏ ssamira. aḏ wiqqimen diyn kan imersal. <verse eid="ACT 8:1" /><verse number="2" style="v" sid="ACT 8:2" />amma istifanus dfenent lbeƹḍ n lliy ittegeḏen seg rebbiy. aḏ ƹiden felles ggeṯ.<verse eid="ACT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 8:3" />aḏ cawel yusi yexs ayekkes lmejmeƹ n lmumnin. aḏ yusi iṭenneḍ seg lḥuc al lḥuc yetkerker g irgazen aḏ tseḏnan, iḥebbes disen. <verse eid="ACT 8:3" /><verse number="4" style="v" sid="ACT 8:4" />indin lliy mferqen wsiyn treḥḥen seg umkan al umkan tbecren. <verse eid="ACT 8:4" /><verse number="5" style="v" sid="ACT 8:5" />ireḥ filibbus al tmura g ljiheṯ n ssamira aḏ yuḏel yetbeccer s lmesiyḥ. <verse eid="ACT 8:5" /><verse number="6" style="v" sid="ACT 8:6" />yaxy ucennas midden timezuγinesen afelxaḍert slen s lmuƹjizaṯ aḏ lemayer lliy yeggineṯ naγ afelxaḍert zrenten s ṭiṭewinesen. <verse eid="ACT 8:6" /><verse number="7" style="v" sid="ACT 8:7" />aḏ wsiyn lejnun lliy skenen lbeƹḍ n midden tṣeyḥen aḏ tefγen sisen. aḏ ggeṯ d lliy uḍennen s ccaq aḏ lƹeybin ḥlan. <verse eid="ACT 8:7" /><verse number="8" style="v" sid="ACT 8:8" />yaxy freḥḥen midden n tmura lkul.<verse eid="ACT 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9" />aḏ yusi diyes g aydin n tmura seḥḥar ismis simƹan, yetteg ssuḥer. aḏ midden n ssamira tqiman fehhen almiy zren aydin. aḏ yettera imanis d lhedreṯ temeqqart. <verse eid="ACT 8:9" /><verse number="10" style="v" sid="ACT 8:10" />aḏ wsiyn midden lkul seγdan dwiys aḏ mmalen: «ayuh n argaz netta d lqudreṯ temeqqart n rebbiy.»<verse eid="ACT 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 8:11" />aḏ sseγdan g dwiys afelxaḍert yesḥerin s mag yetteg. <verse eid="ACT 8:11" /><verse number="12" style="v" sid="ACT 8:12" />amma mniyn ybecrin filibbus s lmelekuwt n rebbiy aḏ s ysem n yesuwƹ lmesiyḥ, ttuzizdyen lkul am irgazen am tseḏnan. <verse eid="ACT 8:12" /><verse number="13" style="v" sid="ACT 8:13" />ḥetta simƹan yumen aḏ yettuzizdi aḏ yeqqim yetḥaḏa g filibbus. mniyn yezra lmuƹjizaṯ d lemayer aḏ leƹjayeb ifeh.<verse eid="ACT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14" />mniyn slen imersal g uwrceliym lliy midden n ssamira qbellen dwiy n rebbiy aḏ umennen siyes, nkiynasen buṭrus aḏ yuwḥenna. <verse eid="ACT 8:14" /><verse number="15" style="v" sid="ACT 8:15" />ẓullen afelxaḍresen g ssamira bac asenyuc rebbiy rruwḥ lqudus. <verse eid="ACT 8:15" /><verse number="16" style="v" sid="ACT 8:16" />afelxaḍert wicci wiyezwic af ḥetta d yjen sisen. amma wsiyn ttuzizdyen s ism siydneγ yesuwƹ. <verse eid="ACT 8:16" /><verse number="17" style="v" sid="ACT 8:17" />lweqteḏin buṭrus aḏ yuwḥenna ggen ifesnesen fellasen. yaxy yezwad fellasen rruwḥ lqudus.<verse eid="ACT 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18" />yezra simƹan lliy rruwḥ lqudus yezwa af indin lliy umennen mniyn ggen imersal fellesen ifesnesen. ireḥ al buṭrus aḏ yuwḥenna yeƹereḍ fellasen iflusen aḏ yuwayasen: <verse eid="ACT 8:18" /><verse number="19" style="v" sid="ACT 8:19" />&lt;uctiḏ ḥetta neči ayuh n lqudreṯ bac ayezwa rruwḥ lqudus af lliy aggeγ felles fusiw. &gt;<verse eid="ACT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 8:20" />yuwayas buṭrus: «γez ifluseniḵ temmuṯeṯ cek yiḏesen. yenda teḥsebeḏ tetqudduḏ aṣγeḏ uca n rebbiy s iflusen? <verse eid="ACT 8:20" /><verse number="21" style="v" sid="ACT 8:21" />rahiy wiγreḵc lḥeq aḏ lbay g ayuh, afelxaḍert uliḵ muc ṣafi yid rebbiy. <verse eid="ACT 8:21" /><verse number="22" style="v" sid="ACT 8:22" />tab af ccer lliy teggit, teḍelbeḏ rebbiy balek afyeγfer lliy tesmuḏet g uliḵ. <verse eid="ACT 8:22" /><verse number="23" style="v" sid="ACT 8:23" />rahiy neči sseneγ lliy cek tetƹeddiḏ g lemrar n lḥuseḏ, aḏ tkeḏfeḏ s ubekkeḍu.»<verse eid="ACT 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 8:24" />yuwa simƹan: «ẓelleṯ kennim afelxaḍriw bac wiyesezwic fella leƹqab lliy tuflayem felles.»<verse eid="ACT 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 8:25" />seṣlen buṭrus aḏ yuwḥenna tufleyt n rebbiy aḏ becren siyes dinet qebbel man ḏwellen al uwrceliym. aḏ g ubriḏesen becren ggeṯ d lḥumaṯ g ljiheṯ n ssamira.<verse eid="ACT 8:25" /></para>
  <para style="s">filibbus yetqeddes g luzir n lmelikeṯ n lḥebeca.</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26" />wembeƹd, yuflay lmleyka n rebbiy y filibbus yuwayas: «kker yyur al lqibelt g ubriḏ n ṣṣeḥreṯ jar uwrceliym aḏ γezza.» <verse eid="ACT 8:26" /><verse number="27" style="v" sid="ACT 8:27" />yaxy ireḥ.</para>
  <para style="p" vid="ACT 8:27">aḏ ilaqa yjen seg lḥebeca xṣenṭ aḏ d luzir n lexzineṯ al kendaka lmelika n lḥebeca. yused al uwrceliym bac ayḥidj we ayezzul diyes. <verse eid="ACT 8:27" /><verse number="28" style="v" sid="ACT 8:28" />mniyn yusi netta g ubriḏis al lḥebeca af tekerriṭis iƹezzem g lektab n nnabiy icƹeya.<verse eid="ACT 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 8:29" />yuwa lmleyka y filibbus: «qreb teyureḏ yid ayuh n tkerriṭ.» <verse eid="ACT 8:29" /><verse number="30" style="v" sid="ACT 8:30" />yaxy ireḥḥas filibbus aḏ yeslas iƹezzem g lektab n icƹeya. aḏ yuwayas: «tfehmeḏ g mag tƹezmeḏ naγ aha?»<verse eid="ACT 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 8:31" />yerras, «mammeḵ tafehmeγ iḏa wilisiḵen ḥetta ḥed.» aḏ yuwa y filibbus ayeli we ayerkeb yiḏes.<verse eid="ACT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 8:32" />aḏ yusi yuṣel g leƹzem n lektab al ayuh:</para>
  <para style="q2" vid="ACT 8:32">«am tilli awyent al teγrest,</para>
  <para style="q2" vid="ACT 8:32">am izmer lliy yesusum zzaṯ lliy tatyeqreḍ</para>
  <para style="q2" vid="ACT 8:32">wiymirc imis</para>
  <para style="q2" vid="ACT 8:32">wiyewi ḥaja.<verse eid="ACT 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="ACT 8:33" />rahiy yetweḍlem ggeṯ.</para>
  <para style="q2" vid="ACT 8:33">wisucenc lḥeqqis.</para>
  <para style="q2" vid="ACT 8:33">mam yetquddu ayuflay af ṭarwas?</para>
  <para style="q2" vid="ACT 8:33">rahiy muksent seg tammurt.»<verse eid="ACT 8:33" /></para>
  <para style="p" />
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34" />aḏ ysesten luzir filibbus: «mliḏ af mam ydugga nnabiy deh? yaxy af imanis naγ af yjen iḍen.» <verse eid="ACT 8:34" /><verse number="35" style="v" sid="ACT 8:35" />yaxy yuḏel yetbeccer diyes s yesuwƹ seg lektab n ayuh n nnabiy.<verse eid="ACT 8:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 8:36" />mniyn tusi tekerriṭ teggur sisen uṣellen al mkan diyes aman. yuwa luzir, «qa aman, maγer wiltezizdeyec?» <verse eid="ACT 8:36" /><verse number="37" style="v" sid="ACT 8:37" />yerras filibbus: «tetqudduḏ aggeḏ ayuh kan uliḵ yečur s liyman.» yuwa luzir: «neči umenneγ lliy yesuwƹ lmesiyḥ am memmis n rebbiy.» <verse eid="ACT 8:37" /><verse number="38" style="v" sid="ACT 8:38" />aḏ ysebbed tekerriṭ, zwan al aman jmiyƹ, aḏ izizdi filibbus y lwuzir.<verse eid="ACT 8:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 8:39" />aḏ s manis ffeγen seg aman yexdef lmleyka n rebbiy filibbus. aḏ wityufi lwuzir, amma ykemmel abriyḏis aḏ netta yefreḥ.<verse eid="ACT 8:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 8:40" />amma filibbus zrent g cduwd, wembeƹd yeqqim yeggur yetbeccer g tmurewin lkul almiy yuṣel al lqeyṣeriya.<verse eid="ACT 8:40" /></para>
  <chapter eid="ACT 8" />
  <chapter number="9" style="c" sid="ACT 9" />
  <para style="s">liyman n cawel</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1" />cawel lliy yusi iγella aḏ yetjella tayenγ tlamḏa n siydneγ. ireḥ al rrayes n lkuhhan. <verse eid="ACT 9:1" /><verse number="2" style="v" sid="ACT 9:2" />yeḍlebi. yuwayas ayeri y lmejmeƹ n wuḏeyen g dimecq bac atƹewnen af iṭṭaf n irgazen aḏ tseḏnan lkul lliy debƹen g ayuh n abriyḏ. we atendeγen ketfen al uwrceliym. <verse eid="ACT 9:2" /><verse number="3" style="v" sid="ACT 9:3" />yerzef. mniyn ḥeḍerbac tayeṣel al dimecq, iwelƹej fellas ddu seg ujenna. <verse eid="ACT 9:3" /><verse number="4" style="v" sid="ACT 9:4" />yaxy yuda af tammurt. yesla mam yemmalas: «cawel ay cawel, maγer tḍelmeḏ diyi.»<verse eid="ACT 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 9:5" />ysesetni cawel: «d mam cek ay siydi.»</para>
  <para style="p" vid="ACT 9:5">yaxy yerras: «neči d yesuwƹ lliy tḍelmeḏ diyes, al lemmi teqimeḏ teḥrenneḏ am aγyul.» <verse eid="ACT 9:5" /><verse number="6" style="v" sid="ACT 9:6" />yuwa cawel aḏ netta yeterjiji: «ayya siydneγ matta taxseḏ ggeγ?» yerras: «kker aḏef al tmura yella mam tafimel metta taggeḏ.»<verse eid="ACT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 9:7" />amma indin lliy wsiyn yid cawel bkemmen fehhen afelxaḍert slen ṣṣut aḏ wizrin ḥed. <verse eid="ACT 9:7" /><verse number="8" style="v" sid="ACT 9:8" />yekker cawel, imir ṭiṭawinis lekenti wiyezri ḥaja. yaxy nzeγent seg fusis, seḏfent al dimecq. <verse eid="ACT 9:8" /><verse number="9" style="v" sid="ACT 9:9" />mani yeqqim 3 d ussanaṯ wizerc aḏ witet wises.<verse eid="ACT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10" />aḏ yusi g dimecq yjen seg tlamḏa ismis ḥenaniya yusesd siydneγ g tirjelt yesγuyas: «ay ḥanenya.» yaxy yeweyas «qa usiγd ay siydneγ.»<verse eid="ACT 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 9:11" />yaxy yuwayas siydneγ: «ureḥ al ccareƹ lliy lmmelnas ccareƹ lliy yeqƹeḏ. aḏ sesten af argaz seg ṭersuws ismis cawel. yella yetẓella ṭuruh g tzaqqa n yehuwḏa. <verse eid="ACT 9:11" /><verse number="12" style="v" sid="ACT 9:12" />aḏ yusi cawel yezra g tirjelt argaz ismis ḥenaniya tayeḏef felles we ayeg felles fusis, ayeḏwel izer.»<verse eid="ACT 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13" />yuwa ḥenaniya: «lekenti ay siydneγ uwaniḏ ggeṯ n midden af ḍḍulem meqqar lliy yeggi y lliy umennen siyeḵ g uwrceliym. <verse eid="ACT 9:13" /><verse number="14" style="v" sid="ACT 9:14" />aḏ mammeḵ ucennas imeqqaren n lkuhhan lḥeq bac ayeṭṭef kul yjen iḍelleb g rebbiy s ismiḵ.»<verse eid="ACT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 9:15" />yaxy yuwayas siydneγ: «kker ureḥ rahiy waziγ ayuh n argaz bac aysaṣel ismiw y midden ttanyaṯ aḏ y lmulukesen aḏ y aṯ israyil. <verse eid="ACT 9:15" /><verse number="16" style="v" sid="ACT 9:16" />aḏ tassiḵneγ mennit yexs ayettuƹeḏeb afelxaḍert n ismiw.»<verse eid="ACT 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17" />ireḥ ḥenaniya, yuḏef al tzaqqa n yehuwḏa, yeggi fusis af cawel, yuwa: «ay cawel uwa. rahiy siydneγ yesuwƹ lliy yeḍherreḵd g ubriḏ yenkiyiḏ al γareḵ bac aḏuleḏ tzarreḏ we ačareḏ s rruwḥ lqudus.»<verse eid="ACT 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 9:18" />yaxy ƹlewleh tuda seg ṭiṭawin n cawel ḥaja am tiqecriwin yeḏwel izer. aḏ yekker yettuzizdi. <verse eid="ACT 9:18" /><verse number="19" style="v" sid="ACT 9:19" />aḏ yeča, terred diyes rruwḥ. aḏ yeqqim ussan yid tlamḏa g dimecq.<verse eid="ACT 9:19" /></para>
  <para style="s">cawel yetbeccer s lmesiyḥ g dimecq</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 9:20" />ƹlewleh yuḏel yetbeccer g lemjameƹ n wuḏeyen yemmal: rahiy yesuwƹ am memmis n rebbiy. <verse eid="ACT 9:20" /><verse number="21" style="v" sid="ACT 9:21" />fehhen midden uwan: yaxy muc d wuh lliy yusi ineq g lliy tbecren s ysem n yesuwƹ g uwrceliym? yaxy muc d netta lliy yused al deh bac atenyeṭṭef we ateniwi ketfen al imeqqaren n lkuhhan?<verse eid="ACT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 9:22" />amma netta yeḏwel d lfeleḥ g ubeccer. aḏ yeqqes imewen n wuḏeyen lliy dderen g dimecq s lḥikemtis. aḏ yusi yeseḵen lliy yesuwƹ netta d lmesiyḥ.<verse eid="ACT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23" />aḏ beƹd ussan d iziraren, smuḏen wuḏeyen g dimecq atenγen. <verse eid="ACT 9:23" /><verse number="24" style="v" sid="ACT 9:24" />yaxy ifeq sisen. aḏ nihnin wsiyn tƹussun ggiḍ uggas af lbiban n tmura bac atenγen almiy tayeffeγ seg yjen sisen. <verse eid="ACT 9:24" /><verse number="25" style="v" sid="ACT 9:25" />yaxy uwynt lbeƹḍ n tlamḏa ggiḍ. ggent g isni. aḏ sezwent s tzarwin s nnaj ssuwr.<verse eid="ACT 9:25" /></para>
  <para style="s">cawel g uwrceliym</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26" />mniyn yuṣel al uwrceliym, ireḥ al tlamḏa lekenti ugeḏḏen siyes afelxaḍert wuminenc lliy netta yeḏwel d tilmiḏ. <verse eid="ACT 9:26" /><verse number="27" style="v" sid="ACT 9:27" />yaxy yewyi bernaba al imersal. aḏ yuwayasen mammeḵ yeḍherresd siydneγ g ubriḏ aḏ yuflayas. aḏ mammeḵ yuḏel yetbeccer s ysem n yesuwƹ man γiyr tiwdi g dimecq.<verse eid="ACT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 9:28" />yuḏel yetreḥ yettesed yiḏesen g uwrceliym yetbeccer s ysem n siydneγ yesuwƹ. <verse eid="ACT 9:28" /><verse number="29" style="v" sid="ACT 9:29" />aḏ yusi yetkaceḥ g wuḏeyen n lyuwnan. yaxy smuḏen tatenγen. <verse eid="ACT 9:29" /><verse number="30" style="v" sid="ACT 9:30" />mniyn slen yeṯmas awyent al lmersa n lqeyṣeriya. aḏ nkiyyent al ṭersuws.<verse eid="ACT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31" />aḏ lweqt ḏḏin yusi lmejmeƹ n lmumniyn g lyehuwdiya aḏ ljeliyl aḏ ssamira af xiyr ƹlihi. aḏ yṯqewa g liyman aḏ tiwdi seg rebbiy aḏ yerniy lƹeded n lmumniyn s rruwḥ lqudus.<verse eid="ACT 9:31" /></para>
  <para style="s">buṭrus g llud aḏ yafa</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32" />aḏ buṭrus lliy yusi irezzef s umkan al umkan ireḥ al lmumnin g ludda. <verse eid="ACT 9:32" /><verse number="33" style="v" sid="ACT 9:33" />aḏ yufa dinet meclul ismis iniyas γares 8 d isuggesen yezzel. <verse eid="ACT 9:33" /><verse number="34" style="v" sid="ACT 9:34" />yuwayas: «ay iniyas yseḥleyaḵ yesuwƹ lmesiyḥ. kker layem tesuytiḵ weḥdeḵ.» yekker ƹlewleh.<verse eid="ACT 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 9:35" />yaxy zrent lliy seknen lkul g ludda aḏ g ljiheṯ n caruwn, aḏ umennen s siydneγ.<verse eid="ACT 9:35" /></para>
  <para style="p" />
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36" />aḏ tusi g yafa ijeṯ seg tlamḏa ismis ṭabiyṯa, aḏ lmeƹnas teγzelt. aḏ tusi telha diyma g igga n lxiyr aḏ ƹawn n iqellilen. <verse eid="ACT 9:36" /><verse number="37" style="v" sid="ACT 9:37" />yaxy temmuṯ ussan diyn, sirdenteṯ. aḏ ggenteṯ g lbiyt nnaj leƹli. <verse eid="ACT 9:37" /><verse number="38" style="v" sid="ACT 9:38" />mniyn slen tlamḏa lliy buṭrus g ludda, nkiynas sen irgazen tjehanas mmalen «aseneγd ṭuruh.» <verse eid="ACT 9:38" /><verse number="39" style="v" sid="ACT 9:39" />yekker ireḥḥesen.</para>
  <para style="p" vid="ACT 9:39">mniyn yuṣel, uwyent al leƹli. yaxy ƹerḍentas tedjalin tƹeyeḍneṯ seḵnentas g tsuriyin aḏ leḥweyej lliy tusi ṭabiyṯa tgenna disen.<verse eid="ACT 9:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 9:40" />yaxy yuwayasen afγen seg lbiyt, yesjeḏ yetẓella. wembeƹd yenneḍ al lliy temmuṯ yuwayas: «ay ṭabiyṯa kker.» yaxy tmir ṭiṭawinis. mniyn tezri tgeƹmez.<verse eid="ACT 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="ACT 9:41" />yezellas fusis. ysekriṯ. aḏ yesγuy y lmumnin aḏ tedjalin yeresnted tedder. <verse eid="ACT 9:41" /><verse number="42" style="v" sid="ACT 9:42" />yaxy slen midden g yafa s ayuh n lmuƹjizaṯ aḏ umennen s siydneγ ggeṯ sisen. <verse eid="ACT 9:42" /><verse number="43" style="v" sid="ACT 9:43" />aḏ yeqqim buṭrus g yafa ussan al yjen d debbeγ ismis simƹan.<verse eid="ACT 9:43" /></para>
  <chapter eid="ACT 9" />
  <chapter number="10" style="c" sid="ACT 10" />
  <para style="s">buṭrus aḏ kurniylus</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1" />yella yjen g lqeyṣeriya d lqayed n 100 ismis kurniylus seg lferqeṯ teṭalyenit. <verse eid="ACT 10:1" /><verse number="2" style="v" sid="ACT 10:2" />yusi yettegeḏ seg rebbiy netta aḏ nnasnis lkul, yetṣeddeq af midden s ul d meqqar aḏ yetẓella diyma y rebbiy.<verse eid="ACT 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 10:3" />ijuwas yid maḍi 3 yezra lmleyka n rebbiy yuḏef fellas aḏ yesγuyas: «kurniylus.» <verse eid="ACT 10:3" /><verse number="4" style="v" sid="ACT 10:4" />yaxy yesmuqel al lmleyka aḏ netta yeterjiji aḏ ysesetni: «mag llan, ay siydi?»</para>
  <para style="p" vid="ACT 10:4">yerras: «rahiy tẓalliṯiḵ aḏ ṣedeqtiḵ tuli al rebbiy. aḏ netta wiyettuc lliy teggiḏ ayuh lkul. <verse eid="ACT 10:4" /><verse number="5" style="v" sid="ACT 10:5" />nkiy irgazen al yafa tesγuyeḏ y simƹan buṭrus, <verse eid="ACT 10:5" /><verse number="6" style="v" sid="ACT 10:6" />lliy yella g tzaqqa n simƹan debbeγ tman iylel. rahiy netta tafimel matta aggeḏ.»<verse eid="ACT 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 10:7" />mniyn ireḥ lmleyka n rebbiy lliy yusi yduggeyas, yesγuy y sen seg ixuddimnis aḏ ƹesekri yettegeḏ seg rebbiy yusi seg indin lliy diyma yiḏes. <verse eid="ACT 10:7" /><verse number="8" style="v" sid="ACT 10:8" />yuwayasen af lliy iṣar lkul. aḏ yenkiyin al yafa.<verse eid="ACT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9" />al ača, mniyn qrebben irgazen diyn seg yafa, azguwas, yuli buṭrus al nnaj lḥiḍ bac ayeẓẓal. <verse eid="ACT 10:9" /><verse number="10" style="v" sid="ACT 10:10" />yaxy yelluz. mniyn tegnas man ayeč, yeffeγ seg ayuh n ddunyeṯ. <verse eid="ACT 10:10" /><verse number="11" style="v" sid="ACT 10:11" />aḏ yezra amellaḵ g tirjelt: jenna imir aḏ ḥaja d temeqqart am leqmac yeqqen seg leḍrafis tzugga af tammurt. <verse eid="ACT 10:11" /><verse number="12" style="v" sid="ACT 10:12" />aḏ netta yečur seg lḥiwan n tammurt lkul aḏ luhuwc lkul am tlefsiwin aḏ iciwciwen n ujenna lkul. <verse eid="ACT 10:12" /><verse number="13" style="v" sid="ACT 10:13" />aḏ yesγuyas ṣṣut: «ay buṭrus kker aγres tečeḏ.»<verse eid="ACT 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 10:14" />lekenti buṭrus yerras: «ay rebbiy. rahiy neči ƹemris wičiγ ḥaja ḥram naγ tenjes.»<verse eid="ACT 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 10:15" />yuwayas ṣṣut: «lliy ysenedfi rebbiy witerrac cek yenjes.»<verse eid="ACT 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 10:16" />aḏ yemƹaweḏ ayuh n dwiy 3 merrat wembeƹd yuli aydin n leqmac al ujenna ƹlewleh.<verse eid="ACT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17" />yeṯḥeyyer buṭrus aḏ yeqqim yetxemmem af lmeƹna n tirjelt lliy yezriṯ. yaxy irgazen lliy yenkiyin kurniylus sesetnen af tzaqqa n simƹan aḏ bbedden zzaṯ lbab. <verse eid="ACT 10:17" /><verse number="18" style="v" sid="ACT 10:18" />sestunen af simƹan buṭrus, yella diyn naγ aha.<verse eid="ACT 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 10:19" />aḏ yusi buṭrus lweqteḏin yetxemmem g tirjeltis, yaxy yuwayas rruwḥ lqudus: «diyes 3 sestunen fellaḵ. <verse eid="ACT 10:19" /><verse number="20" style="v" sid="ACT 10:20" />zweyasen treḥḥeḏ yiḏesen aḏ uliḵ metheni. rahiy d neči nkiyyexten.»<verse eid="ACT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 10:21" />yaxy yezweyasen yuwa: «d neči lliy truzum felles, matta texsem?»<verse eid="ACT 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 10:22" />uwanas: «kernilus lqayed n 100, aydin n argaz ṣbiḥ lliy iteggeḏ seg rebbiy. aḏ wuḏeyen lkul cekren diyes. yuwayas lmleyka n rebbiy afyesγuy al tzaqqas we ayseγd man amleḏ.»<verse eid="ACT 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 10:23" />yeƹreḍ fellasen buṭrus aṭsen γares. aḏ tajji ireḥ yiḏesen netta aḏ lbeƹḍ n aweṯen seg yafa. <verse eid="ACT 10:23" /><verse number="24" style="v" sid="ACT 10:24" />uṣellen al lqeyṣeriya g as wissen. aḏ kurniylus yusi yesugum disen netta aḏ irnawenis aḏ leṣḥabis lkul.<verse eid="ACT 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 10:25" />mniyn yuḏef buṭrus, yeƹreḍas kurniylus aḏ yezwa af ifedenis zzaṯis. <verse eid="ACT 10:25" /><verse number="26" style="v" sid="ACT 10:26" />yaxy ysekri buṭrus yuwa: «kker. rahiy neči d bnaḏem am cek.»<verse eid="ACT 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 10:27" />yuḏef al tzaqqa aḏ netta ydugga yiḏes, yaxy yezra ggeṯ d midden. <verse eid="ACT 10:27" /><verse number="28" style="v" sid="ACT 10:28" />yuwa: «kennim tessennem lliy mam d uḏay wiγric lḥeq ayeḏef al tzaqqa n yjen muc d uḏay naγ ayeqqim yiḏes. lekenti rebbiy yseḥefdiḏ lliy widdis ḥetta d bnaḏem yenjes naγ iwessex. <verse eid="ACT 10:28" /><verse number="29" style="v" sid="ACT 10:29" />afelxaḍert n ayuh usiγewemd ƹlewleh mniyn tesγuymiḏ. y matta tesγuymiḏ?»<verse eid="ACT 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 10:30" />yerras kurniylus:</para>
  <para style="p" vid="ACT 10:30">«diyes 4 d ussanaṯ ṭuruh, usiγ tẓalliγ am lweqt wuh g tzaqqaw tẓalliṯ n maḍi 3. yaxy yeḍherriḏd argaz yireḍ ṣireḍ yetreq. <verse eid="ACT 10:30" /><verse number="31" style="v" sid="ACT 10:31" />yuweyiḏ: &lt; rahiy tẓalliṯiḵ aḏ ṣedeqtiḵ tuli al rebbiy, aḏ wiytettuc ayuh lkul. <verse eid="ACT 10:31" /><verse number="32" style="v" sid="ACT 10:32" />nkiy irgazen al yafa tesγuyeḏ y simƹan buṭrus, lliy yella g tzaqqa n simƹan dbebeγ tman iylel. rahiy netta tafimel matta aggeḏ. &gt;<verse eid="ACT 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 10:33" />yaxy nkiyyeγ ƹlewleh sγuyγaḵ, aḏ barekelehu fik lliy tusid. aḏ neccin lkul nella deh zzaṯ rebbiy bac anesseγd matta yuweyaḵ rebbiy.»<verse eid="ACT 10:33" /></para>
  <para style="s">lxuṭbeṯ n buṭrus g tzaqqa n kurniylus.</para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34" />yuḏel buṭrus dwiys, yuwa;</para>
  <para style="p" vid="ACT 10:34">«fhemeγ ṭuruh lliy rebbiy wiyesmuqulc al uḏmewen. <verse eid="ACT 10:34" /><verse number="35" style="v" sid="ACT 10:35" />aḏ irella af midden lkul lliy ttegeḏen siyes aḏ yetteg lxiyr. <verse eid="ACT 10:35" /><verse number="36" style="v" sid="ACT 10:36" />aḏ yenkiy tufleytis y aṯ israyil yetbeccer disen s slam n yesuwƹ lmesiyḥ, siydnas n midden lkul. <verse eid="ACT 10:36" /><verse number="37" style="v" sid="ACT 10:37" />ṯabet teslim s mag iṣar g ljeliyl aḏ yuṣel al lyehuwdiya beƹd zizdi lliy ybeccer siyes yaḥya. <verse eid="ACT 10:37" /><verse number="38" style="v" sid="ACT 10:38" />rahiy inumer rebbiy yesuwƹ nnaṣiriy s rruwḥ lqudus aḏ yucas quddu. yuḏel iṭenneḍ seg mkan al mkan iteg g lxiyr aḏ yesseḥla g lliy yeγlebin cciyḍan afelxaḍert rebbiy yusi yiḏes. <verse eid="ACT 10:38" /><verse number="39" style="v" sid="ACT 10:39" />aḏ neccin d cuhhaḏ af lliy yeggi lkul g lyehuwdiya aḏ g uwrceliym. aḏ nembelḥeq nγent af ṣṣelib. <verse eid="ACT 10:39" /><verse number="40" style="v" sid="ACT 10:40" />lekenti rebbiy ysekri seg tmettent g as wi 3 , aḏ isiḵni y cuhhaḏ <verse eid="ACT 10:40" /><verse number="41" style="v" sid="ACT 10:41" />lliy iwezayin seg midden aḏ y neccin akehaw lliy neča neswa yiḏes beƹd mag yekker seg tmettent.<verse eid="ACT 10:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 10:42" />wembeƹd yuweyaneγ anbeccer midden siyes we anecheḏ lliy d netta lliy yeggi rebbiy bac ayḥaseb lliy dderen aḏ lliy mmuṯen. <verse eid="ACT 10:42" /><verse number="43" style="v" sid="ACT 10:43" />y netta cehden lenbiya lkul. rahiy lliy yumen siyes tasyeγfer rebbiy ibekkaḍnis s ismis.»<verse eid="ACT 10:43" /></para>
  <para style="s">tezuggiṯ n rruwḥ lqudus af lliy muc d wuḏeyen.</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44" />mniyn yusi buṭrus ydugga yezwa rruwḥ lqudus af indin lliy wsiyn seγdan diyes lkul. <verse eid="ACT 10:44" /><verse number="45" style="v" sid="ACT 10:45" />yaxy fehhen lmumnin n wuḏeyen lliy usend yid buṭrus afelxaḍert rruwḥ lqudus yezwa ḥetta af lliy muc d wuḏeyen. <verse eid="ACT 10:45" /><verse number="46" style="v" sid="ACT 10:46" />aḏ slenesen duggan s lγawi iḍen aḏ tsebḥen y rebbiy.</para>
  <para style="p" vid="ACT 10:46">yaxy yuwa buṭrus: <verse eid="ACT 10:46" /><verse number="47" style="v" sid="ACT 10:47" />«wiyetquddu ḥetta d yjen atenyer af zizdi s aman afelxaḍert rruwḥ lqudus yezwa fellasen mammeḵ yezwa fellenneγ.» <verse eid="ACT 10:47" /><verse number="48" style="v" sid="ACT 10:48" />aḏ yuwayasen attuzizden s ysem n yesuwƹ lmesiyḥ. aḏ uwanas ayeqqim jaresen ussan.<verse eid="ACT 10:48" /></para>
  <chapter eid="ACT 10" />
  <chapter number="11" style="c" sid="ACT 11" />
  <para style="s">buṭrus iƹeweḏ af mag iṣar</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1" />slen imersal aḏ aweṯen g lyehuwdiya lliy midden muc d wuḏeyen qbellen dwiy n rebbiy. <verse eid="ACT 11:1" /><verse number="2" style="v" sid="ACT 11:2" />mniyn yuṣel buṭrus al uwrceliym, kacḥent indin lliy mmalen s dhur aḏ uwanas: <verse eid="ACT 11:2" /><verse number="3" style="v" sid="ACT 11:3" />«mammeḵ tuḏeffeḏ al tzaqqa n midden widehrenc aḏ tečiḏ yiḏesen.»<verse eid="ACT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 11:4" />yaxy yuwayasen buṭrus af mag iṣar lkul:<verse eid="ACT 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 11:5" />«feγeγ seg ayuh n ddunyeṯ mniyn usiγ tẓalliγ g yafa aḏ zriγ g tirjelt ḥaja am leqmac d meqqar leḍrafis qqennen izugga al γari seg ujenna. <verse eid="ACT 11:5" /><verse number="6" style="v" sid="ACT 11:6" />mniyn ḥekreγ g amasis, zriγ lḥiwan n tammurt aḏ lḥuwc am tlefsiwin aḏ iciwciwen n ujenna. <verse eid="ACT 11:6" /><verse number="7" style="v" sid="ACT 11:7" />aḏ sliγ mam yemmeliḏ: «ay buṭrus, kker aγres tečeḏ.»<verse eid="ACT 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 11:8" />rriγas: «ay rebbiy. rahiy neči ƹemris witciγ ḥaja ḥram naγ tenjes.»<verse eid="ACT 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 11:9" />yaxy yuweyiḏ ṣṣut: «lliy ysenedfi rebbiy witerrac cek yenjes.» <verse eid="ACT 11:9" /><verse number="10" style="v" sid="ACT 11:10" />aḏ yemƹaweḏ ayuh n dwiy 3 merrat, wembeƹd yuli leqmac aḏ lliy diyes lkul al ujenna.<verse eid="ACT 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 11:11" />g lweqt ḏḏin, 3 lliy nkiyyenten seg lqeyṣeriya uṣellen al tzaqqa lliy neči usiγ diyes. <verse eid="ACT 11:11" /><verse number="12" style="v" sid="ACT 11:12" />aḏ yuweyiḏ rruwḥ lqudus: «ureḥ yiḏesen man γiyr tiwdi aḏ uliḵ metheni.» yaxy reḥḥeγ aḏ iḏiy 6 seg aweṯen. nuḏef al tzaqqa n argaz diyn. <verse eid="ACT 11:12" /><verse number="13" style="v" sid="ACT 11:13" />yuweyaneγ mammeḵ yezra lmleyka g tzaqqas. yemmalas: «nkiy irgazen al yafa tesγuyeḏ y simƹan lliy mmelnas buṭrus. <verse eid="ACT 11:13" /><verse number="14" style="v" sid="ACT 11:14" />aḏ netta tafimel dwiy afisemneƹ cek aḏ nesniḵ lkul.»<verse eid="ACT 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 11:15" />mniyn uḏelleγ duggiγ yezwa fellasen rruwḥ lqudus mammeḵ yezwa fellenneγ tijekkelt temezwert. <verse eid="ACT 11:15" /><verse number="16" style="v" sid="ACT 11:16" />yaxy smitiγd mag yuweyaneγ siydneγ: «rahiy yaḥya izizdi midden s aman amma kennim tattuzizedyem s rruwḥ lqudus.» <verse eid="ACT 11:16" /><verse number="17" style="v" sid="ACT 11:17" />mala kan rebbiy yucasen ayuh n nnaƹmeṯ am nnaƹmeṯ lliy yuceneγtiḏ mniyn numen s siydneγ yesuwƹ lmesiyḥ, d mammun neči bac asenekseγ lliy yucesen rebbiy.»<verse eid="ACT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 11:18" />mniyn slen ayuh n dwiy, susmen. aḏ sebḥen y rebbiy. aḏ uwan: «mala rebbiy yuca nnaƹmeṯ n ttubeṯ ḥetta y lliy muc d wuḏeyen bac alqan temeddurt.»<verse eid="ACT 11:18" /></para>
  <para style="s">lmejmeƹ n anṭakiya.</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19" />lmumnin lliy mferqen g tammurt beƹd temettent n istifanus afelxaḍert n ḍḍulem beƹdis, uṣellen al finiyqiya aḏ qubruṣ aḏ anṭakiya. aḏ wsiyn tbecren kan g wuḏeyen af mag iṣar y siydneγ yesuwƹ.<verse eid="ACT 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 11:20" />lekenti lbeƹḍ sisen, aḏ nihnin g leṣel seg qubruṣ aḏ lqirineya, uṣellen al anṭakiya uḏellen tbecren s siydneγ yesuwƹ ḥetta g midden lliy duggan s leγweṯ n lyuwnan. <verse eid="ACT 11:20" /><verse number="21" style="v" sid="ACT 11:21" />aḏ tusi lquweṯ n rebbiy yiḏesen. yaxy umennen s siydneγ ggeṯ d midden. <verse eid="ACT 11:21" /><verse number="22" style="v" sid="ACT 11:22" />slen lmejmeƹ n uwrceliym s aydin. yaxy nkiyyen bernaba al anṭakiya.<verse eid="ACT 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 11:23" />mniyn yuṣel aḏ yezra nnaƹmeṯ lliy yuciṯ rebbiy, yefreḥ aḏ yuwayasen aṣebren yid rebbiy s ulawen čuren d liyman. <verse eid="ACT 11:23" /><verse number="24" style="v" sid="ACT 11:24" />aḏ yusi bernaba d argaz d ṣbiḥ aḏ yčur s rruwḥ lqudus aḏ s liyman. aḏ af ifesnis umennen ggeṯ d midden.<verse eid="ACT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25" />aḏ ireḥ bernaba al ṭersuws bac ayurzu af cawel. <verse eid="ACT 11:25" /><verse number="26" style="v" sid="ACT 11:26" />mniyn yufi, yuγettiḏ al anṭakiya mani wsiyn temlaqan yid lmejmeƹ n lmuminin suggas kamel. seḥfaḍen g ggeṯ d midden. aḏ g anṭakiya d tijekkelt temezwert lliy ttusemman diyes tlamḏa d lmesiyḥiyin.<verse eid="ACT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27" />g ussan diyn, usend seg uwrceliym lbeƹḍ n lliy ydugga rebbiy af imewnesen al anṭakiya. <verse eid="ACT 11:27" /><verse number="28" style="v" sid="ACT 11:28" />aḏ yiḏesen yjen ismis aγabuws. aḏ yusi rruwḥ yuḥayas lliy tayṣar llaz d meqqar g leblad lkul. aḏ iṣar ayuh n llaz nembelḥeq g lƹehd n lqeyṣer kuludiyus. <verse eid="ACT 11:28" /><verse number="29" style="v" sid="ACT 11:29" />aḏ smuḏen tlamḏa bac ayuc kul yjen sisen lliy yetquddu we atnekyen d lemƹuneṯ y aweṯen g lyehuwdiya. <verse eid="ACT 11:29" /><verse number="30" style="v" sid="ACT 11:30" />leymen aydin aḏ nkiyyent al izmimen n lmejmuƹ n lmuminin g lyehuwdiya yid bernaba aḏ cawel.<verse eid="ACT 11:30" /></para>
  <chapter eid="ACT 11" />
  <chapter number="12" style="c" sid="ACT 12" />
  <para style="s">temettent n yeƹquwb</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1" />lweqt ḏḏin, yuḏel lmelek hiyruwdus iḍellem nyeƹdel g lmejmeƹ. <verse eid="ACT 12:1" /><verse number="2" style="v" sid="ACT 12:2" />yenγa yeƹquwb uwas n yuwḥenna s ssiyf. <verse eid="ACT 12:2" /><verse number="3" style="v" sid="ACT 12:3" />mniyn yufa lliy ayuh freḥḥen siyes wuḏeyen, yetṭef buṭrus zada g ussan n tfeṣka n tqurset. <verse eid="ACT 12:3" /><verse number="4" style="v" sid="ACT 12:4" />beƹd mag yṭṭefi, yeggi g lḥebs tƹussun felles 4 n terbaƹin kul ijeṯ diyes 4 n irgazen. aḏ yusi yesmuḏ tayeḥkem fellas zzaṯ wuḏeyen beƹd tfeṣka n uƹeddi.<verse eid="ACT 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 12:5" />yeggi g lḥebs. aḏ lmejmeƹ n lmumnin wsiyn tjahan y rebbiy g tẓaliṯsen bac ayferej fellas.<verse eid="ACT 12:5" /></para>
  <para style="s">seffeγ n buṭrus seg lḥebs.</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6" />g yiḍ lliy yesmuḏ diyes hiyruwdus tayeḥkem af buṭrus, yusi wuhnit yeṭṭes jar sen irgazen aḏ ikettef s sen n tseleslin. aḏ yusi zzaṯ lbab diyes iƹessesen tƹussun af lḥebs. <verse eid="ACT 12:6" /><verse number="7" style="v" sid="ACT 12:7" />yeḍherred lmleyka n rebbiy, aḏ iwelƹej ddu g lbiyt, iwet lmleyka buṭrus af ljenbis ysekri. aḏ yuwayas: «kker fiseƹ.»</para>
  <para style="p" vid="ACT 12:7">yaxy udaneṯ tiseleslin seg ifesnis. <verse eid="ACT 12:7" /><verse number="8" style="v" sid="ACT 12:8" />aḏ yuwayas lemleka: «qqen leḥzamiḵ, tirdeḏ ṣebeṭiḵ.» yeqqen aḏ yireḍ. aḏ yuwayas: «ireḍ bernusiḵ teḏbeƹdiḏ.» <verse eid="ACT 12:8" /><verse number="9" style="v" sid="ACT 12:9" />yeffeγ buṭrus ydebbeƹ diyes. aḏ netta yeḥsab lliy netta g tirjelt. aḏ wiyessinc lliy matta iṣaras af ffus n lmleyka nembelḥeq. <verse eid="ACT 12:9" /><verse number="10" style="v" sid="ACT 12:10" />ƹeddan seg azzaṯ n mkan n uƹussu mezwar aḏ wissen. mniyn uṣellen al lbab n lḥebs lliy yusi d uzzal, yugay al tmura imir weḥdes. aḏ ffeγen. aḏ beƹed mag uṣellen al lexer n ccareƹ yedjiy lmleyka ireḥ.<verse eid="ACT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11" />lweqt ḏḏin, yerresd y buṭrus ccahed n lƹqel yuwa: «ṭuruh umenneγ lliy rebbiy yenkiy lmleykes ysemenƹiḏ seg hiyruwdus aḏ mag xsen wuḏeyen.» <verse eid="ACT 12:11" /><verse number="12" style="v" sid="ACT 12:12" />mniyn yefhem aydin, ireḥ al tzaqqa n meryem yedjis n yuwḥenna lliy mmelnas merqes mani mleymen ggeṯ d lmumnin ḍelben g rebbiy.<verse eid="ACT 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 12:13" />mniyn iwet af lbab berrani, tused texuddimt ismis rewda bac atḥaker d mammun. <verse eid="ACT 12:13" /><verse number="14" style="v" sid="ACT 12:14" />tefhem ṣṣut n buṭrus. yaxy seg lfreḥtis tetuw, witmirc lbab amma treḥ tetbeccer g lliy llan jaj s isas.<verse eid="ACT 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 12:15" />yaxy uwanas «cem tetxerfeḏ.» lekenti tuweyasen: «aha rahiy nembelḥeq.» yaxy uwan: «balek d lmleyka n buṭrus.» <verse eid="ACT 12:15" /><verse number="16" style="v" sid="ACT 12:16" />amma buṭrus yeqqim yečaṯ g lbab almiy mirnas. zrent fehhen.<verse eid="ACT 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 12:17" />yaxy yuwayasen s fusis bac asusmen. aḏ yeḥkeyasen mammeḵ ysefγiy rebbiy seg lḥebs. aḏ yuwa «mleṯ y yeƹquwb aḏ aweṯen af ayuh.» aḏ yeffeγ ireḥ al mkan iḍen.<verse eid="ACT 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18" />mniyn yeṣbeḥ, uḏeffen iƹesekriyen g beƹeḍhum aḏ qqimen sestunen: «matta iṣar y buṭrus.» <verse eid="ACT 12:18" /><verse number="19" style="v" sid="ACT 12:19" />mniyn yuwayasen hiyruwdus aγtettiḏ aḏ wityufi, ysesten iƹessesen aḏ yeḥkem s tmenγiwtesen. wembeƹd iḥewel hiyruwdus seg lyehuwdiya aḏ yesken g lqeyṣeriya.<verse eid="ACT 12:19" /></para>
  <para style="s">temettent n hiyruwdus</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20" />aḏ yusi iγeccec af midden n ṣuwr aḏ ṣeyda. yaxy ugeḏḏen aḏ nkiyyen mam ireḥ al bilastus maqqar n ixuddimenis ḍelben g smaḥ, afelxaḍert wsiyn dderen seg lxiyr n lmemelkeṯ n hiyruwdus.<verse eid="ACT 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 12:21" />as lliy tayqabel hiyruwdus indin lliy nkiyyenten yireḍ lbasis n lmuluk aḏ ygeƹmez af lƹercis yetteg g lxiṭab. <verse eid="ACT 12:21" /><verse number="22" style="v" sid="ACT 12:22" />yaxy ṣedƹen midden: «ayuh d ṣṣut n yjen seg irebbiyen muc d ṣṣut n lƹebd.» <verse eid="ACT 12:22" /><verse number="23" style="v" sid="ACT 12:23" />yefreḥ hiyruwdus aḏ wiyeḥmiḏc rebbiy. yaxy iwettiy lmleyka n rebbiy ƹlewleh. aḏ hjemneṯ felles tikečewin yemmuṯ.<verse eid="ACT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24" />amma dwiy n rebbiy yuṣel al ggeṯ d midden. <verse eid="ACT 12:24" /><verse number="25" style="v" sid="ACT 12:25" />aḏ wsiyn bernaba aḏ cawel ggen lwajbesen g uwrceliym. aḏ rrend al anṭakiya aḏ yiḏesen yuwḥenna lliy mmelnas merqes.<verse eid="ACT 12:25" /></para>
  <chapter eid="ACT 12" />
  <chapter number="13" style="c" sid="ACT 13" />
  <para style="s">bernaba aḏ cawel</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1" />aḏ yusi diyes g lmejmeƹ n lmumnin n anṭakiya indin lliy ydugga rebbiy af imewnesen aḏ lmuƹelmin lliy sisen: bernaba aḏ cawel aḏ cemƹuwn lliy mmelnas ṣeṭṭaf aḏ lukyuws lqirineyiy aḏ meneyin lliy yetturebba g temeckis yid hiyruwdus lḥakem n ljeliyl. <verse eid="ACT 13:1" /><verse number="2" style="v" sid="ACT 13:2" />ijuwas, mniyn wsiyn ẓwumen aḏ tẓallan y rebbiy. yuweyasen rruwḥ lqudus: «dejtiḏ bernaba aḏ cawel bac aggen lliy tasenemleγ fellas.» <verse eid="ACT 13:2" /><verse number="3" style="v" sid="ACT 13:3" />aḏ beƹd mag ẓwumen aḏ ẓullen, ggen fellesen s sen ifesnesen aḏ nkiyyenten.<verse eid="ACT 13:3" /></para>
  <para style="s">g iylel al qubruṣ</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4" />bernaba aḏ cawel lliy yenkiyin rruwḥ lqudus, reḥḥen al lmers n seluwkiya. aḏ s yin qdeƹen iylel al qubruṣ. <verse eid="ACT 13:4" /><verse number="5" style="v" sid="ACT 13:5" />mniyn uṣelnas, zwan g selamis aḏ uḏellen tbecren s dwiy n rebbiy g lemjameƹ n wuḏeyen. aḏ yusi yiḏesen yuwḥenna yetƹawen disen.<verse eid="ACT 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6" />yyuren almiy uṣellen al bafuws. aḏ diyn laqan seḥḥar d uḏay yerra imanis d nnabiy ismis beryesuwƹ. <verse eid="ACT 13:6" /><verse number="7" style="v" sid="ACT 13:7" />aḏ yusi diyma yid serjiyus bulus lḥakem n qubruṣ lliy γares lefker. yesγuy y bernaba aḏ cawel bac aysel dwiy n rebbiy. <verse eid="ACT 13:7" /><verse number="8" style="v" sid="ACT 13:8" />yaxy yebbedesen seḥḥar lumas aḏ ayuh d ismis g leγweṯ n lyuwnan, bac witadjic lḥakem ayemen.<verse eid="ACT 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 13:9" />lekenti cawel lliy ismis yeḏwel d buwlus yečur s rruwḥ lqudus aḏ yesmuqelas aḏ yuwayas: <verse eid="ACT 13:9" /><verse number="10" style="v" sid="ACT 13:10" />«ayya cciyḍan, ayya lliy yečur d aγuccu aḏ leḥrefeṯ, ayya leƹdu n ṣbiḥen. yaxy witesmuḏec abeṭleḏ seƹwej n ibriyḏen n rebbiy? <verse eid="ACT 13:10" /><verse number="11" style="v" sid="ACT 13:11" />rahiy ṭuruh tayezzel rebbiy fusis we afyeƹma. aḏ taqimeḏ witzerrec al lemmi.»</para>
  <para style="p" vid="ACT 13:11">yaxy ƹlewleh tezwa af ṭiṭawinis ḍbabeṯ n tellest. yuḏel yetberbec af mam atyenzeγ seg fusis. <verse eid="ACT 13:11" /><verse number="12" style="v" sid="ACT 13:12" />mniyn yezra lḥakem mag iṣar, yumen beƹd mag ifeh seg seḥfeḍ af siydneγ.<verse eid="ACT 13:12" /></para>
  <para style="s">tmura n anṭakiya n bisidiya</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13" />buwlus aḏ lliy yiḏes, rzeffen g iylel seg bafuws al burja g bemfiyliya. aḏ diyn yedjin yuwḥenna aḏ yeḏwel al uwrceliym. <verse eid="ACT 13:13" /><verse number="14" style="v" sid="ACT 13:14" />amma nihnin rzeffen seg burja al tmura n anṭakiya n bisidiya. aḏ uḏeffen geƹemzen g lmejmeƹ n wuḏeyen as n sebbeṯ.<verse eid="ACT 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 13:15" />aḏ beƹd leƹzem n cceriyƹeṯ n muwsa aḏ lektub n lenbiya, nkiynasen imeqqaren n lmejmeƹ. aḏ uwanasen: «kan γarwem man mlem y ayuh n midden uflayeṯ.»<verse eid="ACT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 13:16" />yebbed buwlus. iqam fusis bac asusmen. yuwa: «sseγdeṯ ayya aṯ israyil aḏ ayya lliy tetegeḏem seg rebbiy: <verse eid="ACT 13:16" /><verse number="17" style="v" sid="ACT 13:17" />rahiy rebbiy n cceƹb n israyil iwaza ibabnenneγ. aḏ yeggisen ccan g lγurebtesen g miṣr. wembeƹd ysefγin s uquddus meqqar. <verse eid="ACT 13:17" /><verse number="18" style="v" sid="ACT 13:18" />aḏ yeḥmel leƹwejesen 40 d isuggasen g ṣṣeḥreṯ. <verse eid="ACT 13:18" /><verse number="19" style="v" sid="ACT 13:19" />imukes 7 n lecƹuwb seg kenƹan aḏ yucasen temurtesen.<verse eid="ACT 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 13:20" />aḏ ayuh lkul iṣar g 450 d isuggasen lliy beƹdesen yeggasen lḥukem n lquḍat. lexrani disen d ṣemwyil nnabiy <verse eid="ACT 13:20" /><verse number="21" style="v" sid="ACT 13:21" />lliy uwanas aṯ israyil ggeneγ lmelek. yaxy yeggisen rebbiy cawel memmis n qeys seg leƹcireṯ n benyamin lliy yeḥkemmin 40 d isuggasen. <verse eid="ACT 13:21" /><verse number="22" style="v" sid="ACT 13:22" />wembeƹd imuksi. aḏ yeggi g umkanis dawud lliy yuwa felles: &lt; rahiy ufiγ dawud memmis n yessa, d argaz yecreh fellas uliw aḏ tayeg matta xseγ lkul. &gt;<verse eid="ACT 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 13:23" />aḏ mammeḵ yuƹeḏ, yenkiy rebbiy y aṯ israyil seg ṭarwa n dawud yesuwƹ bac atenisemneƹ. <verse eid="ACT 13:23" /><verse number="24" style="v" sid="ACT 13:24" />aḏ yused qebbel yesuwƹ yaḥya lliy yusi yemmel y midden ateben we attuzizedyen. <verse eid="ACT 13:24" /><verse number="25" style="v" sid="ACT 13:25" />mniyn ḥaḍerbac taykemmel yaḥya lxeḏmtis, yuwa: «d mam teḥsebmiḏ? rahiy muc d neči tafensemenƹeγ. amma tadyas yjen beƹdiw, wistehlexc ḥetta amireγ tinelwin n ṣebbeṭis.»<verse eid="ACT 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26" />ayya yeṯma, ay ṭarwa n ibrahiym, aḏ ayya lliy tetegeḏem seg rebbiy. rahiy y neccin yenkiy rebbiy ayuh n tuflayt n mneƹ. <verse eid="ACT 13:26" /><verse number="27" style="v" sid="ACT 13:27" />rahiy midden n uwrceliym aḏ imeqqernis wisinenc d mam yesuwƹ. aḏ wifhimenc dwiy n lenbiya lliy ƹezmen diyes kul sebbeṯ. amma tememmen lliy yetwari mniyn ḥkemmen af yesuwƹ s tmettent.<verse eid="ACT 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 13:28" />aḏ nihnin lliy wiquddenc aṯebten felles ḥetta d bekkeḍu, uwan y biylaṭus atyenγ. <verse eid="ACT 13:28" /><verse number="29" style="v" sid="ACT 13:29" />aḏ beƹd mag ggen diyes lliy yetweri felles sezwent s nnaj ṣṣelib n lluwḥ aḏ nbellent g leqber. <verse eid="ACT 13:29" /><verse number="30" style="v" sid="ACT 13:30" />lekenti rebbiy ysekri seg lmuta. <verse eid="ACT 13:30" /><verse number="31" style="v" sid="ACT 13:31" />aḏ yeḍherred ggeṯ d ussan y indin lliy wsiyn diyma yiḏes seg ljeliyl al uwrceliym. aḏ nihnin ṭuruh cehden felles zzaṯ midden.<verse eid="ACT 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 13:32" />aḏ neccin ṭuruh netbeccer diwem: lliy yuƹeḏ siyes rebbiy ibabnenneγ, <verse eid="ACT 13:32" /><verse number="33" style="v" sid="ACT 13:33" />yentem y neccin ṭarwesen mniyn ysekker yesuwƹ mammeḵ yuwa g lmezmur wissen:</para>
  <para style="p" vid="ACT 13:33" />
  <para style="q2" vid="ACT 13:33">&lt;d cekkin d memmi,</para>
  <para style="q2" vid="ACT 13:33">as uh neči ggiγaḵ d lwali,</para>
  <para style="q2" vid="ACT 13:33">neči am babeḵ. &gt;<verse eid="ACT 13:33" /></para>
  <para style="p" />
  <para style="p">
    <verse number="34" style="v" sid="ACT 13:34" />amma mammeḵ ysekker rebbiy yesuwƹ seg lliy mmuṯen aḏ wiyedjic lbednis ayemmuc, yella g ayuh n dwiy:</para>
  <para style="p" vid="ACT 13:34" />
  <para style="q2" vid="ACT 13:34">&lt;tafenuceγ tinemmirin timeqdusin</para>
  <para style="q2" vid="ACT 13:34">lliy nembelḥeq</para>
  <para style="q2" vid="ACT 13:34">lliy uƹeḏḏeγ sisneṯ dawud. &gt;<verse eid="ACT 13:34" /></para>
  <para style="p" />
  <para style="p">
    <verse number="35" style="v" sid="ACT 13:35" />aḏ yemmal dawud g lmezmur iḍen:</para>
  <para style="p" vid="ACT 13:35" />
  <para style="p" vid="ACT 13:35">&lt;witetadjic meqdusiḵ ayemmutc. &gt;<verse eid="ACT 13:35" /></para>
  <para style="p" />
  <para style="p">
    <verse number="36" style="v" sid="ACT 13:36" />aḏ yemmuṯ dawud beƹd mag yeggi mammeḵ yexs rebbiy g ussanis. aḏ yemmudfen yid ibabenis. aḏ yemmutc lbednis. <verse eid="ACT 13:36" /><verse number="37" style="v" sid="ACT 13:37" />amma lliy ysekri rebbiy wiyemmutc lbednis xlaṣ.<verse eid="ACT 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 13:38" />yexs asnem ayya yeṯma lliy s ysem n yesuwƹ wuh ybecrewem rebbiy s aγfar n ibekkaḍn. <verse eid="ACT 13:38" /><verse number="39" style="v" sid="ACT 13:39" />aḏ siyes kul yjen yumen tayemneƹ seg mag witqudc ḥetta cceriyƹeṯ n muwsa atsemneƹ siyes lkul. <verse eid="ACT 13:39" /><verse number="40" style="v" sid="ACT 13:40" />rreṯ lbaluwem ayezwa fellewem ƹeqeb lliy yused g lektub n lenbiya:<verse eid="ACT 13:40" /></para>
  <para style="p" />
  <para style="q1">
    <verse number="41" style="v" sid="ACT 13:41" />&lt;smuqleṯ ayya lliy teteṯhezzim,</para>
  <para style="q2" vid="ACT 13:41">ṯƹejbeṯ temettem.</para>
  <para style="q2" vid="ACT 13:41">taggeγ ussan uh iḥajeyen</para>
  <para style="q2" vid="ACT 13:41">lukan afenemlen fellasen</para>
  <para style="q2" vid="ACT 13:41">witetṣedqemc. &gt; »<verse eid="ACT 13:41" /></para>
  <para style="p" />
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42" />mniyn wsiyn tefγen seg lmejmeƹ, uwan lliy muc d wuḏeyen y buwlus aḏ bernaba aderren bac asenuflayen af aydin g as n sebbeṯ lliy tadyas. <verse eid="ACT 13:42" /><verse number="43" style="v" sid="ACT 13:43" />beƹd lijtimaƹ ḏebƹenten ggeṯ d wuḏeyen aḏ d lliy ḏwellen d wuḏeyen seg indin lliy tẓallan. yaxy uḏellen dugganesen aḏ tcejƹen disen bac aṣebren af nnaƹmeṯ n rebbiy.<verse eid="ACT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44" />g sebbeṯ lliy beƹdis, mleymen midden n aydin n tmura teqrib lkulhum bac aslen dwiy n rebbiy. <verse eid="ACT 13:44" /><verse number="45" style="v" sid="ACT 13:45" />mniyn zren wuḏeyen midden lliy ggeṯ, nγerren aḏ uḏellen tbeddan y buwlus aḏ deƹunas.<verse eid="ACT 13:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="ACT 13:46" />yaxy man γiyr tiwdi uwan buwlus aḏ bernaba y wuḏeyen:</para>
  <para style="p" vid="ACT 13:46">«rahiy yexs aneḏel afenenbeccer kennim s dwiy n rebbiy. lekenti witteqqilem atseγdem. aḏ yeḍeherred lliy kennim witestehlemc temeddurt n diyma. qa neccin netbeccer g lliy muc d wuḏeyen.<verse eid="ACT 13:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="ACT 13:47" />rahiy rebbiy iweṣṣeyeneγ, yuwa:</para>
  <para style="p" vid="ACT 13:47" />
  <para style="q1" vid="ACT 13:47">&lt;ggiγaḵ d ddu y midden lkul lliy muc d wuḏeyen</para>
  <para style="q1" vid="ACT 13:47">bac asenteγeḏ mneƹ</para>
  <para style="q1" vid="ACT 13:47">g leḍraf n tammurt lkul. &gt; »<verse eid="ACT 13:47" /></para>
  <para style="p" />
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48" />mniyn slen lliy muc d wuḏeyen aydin, freḥḥen aḏ mejden dwiy n rebbiy. aḏ umennen indin lliy iwazayin rebbiy y tmeddurt n diyma.<verse eid="ACT 13:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="ACT 13:49" />aḏ am idin slen midden s dwiy n rebbiy g ljiheṯ teḏḏin lkul. <verse eid="ACT 13:49" /><verse number="50" style="v" sid="ACT 13:50" />lekenti wuḏeyen ḥemcen tiseḏnan lliy lebas ƹlihum aḏ lliy tẓalleneṯ aḏ imeqqaren n tmura. yaxy durren buwlus aḏ bernaba. aḏ zeƹezqenten s yin.<verse eid="ACT 13:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 13:51" />yaxy ffeγen buwlus aḏ bernaba s γarsen aḏ zelzen fellasen lγubreṯ n idernesen. aḏ reḥḥen al tmura n yquniya.<verse eid="ACT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="ACT 13:52" />amma tlamḏa čuren s rruwḥ lqudus aḏ freḥḥen ggeṯ.<verse eid="ACT 13:52" /></para>
  <chapter eid="ACT 13" />
  <chapter number="14" style="c" sid="ACT 14" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1" />g yquniya, yuḏef buwlus aḏ bernaba al lmejmeƹ n wuḏeyen am lƹadeṯ. aḏ uḏellen seƹzamen yeqƹeḏ almiy umennen s dwiysen ggeṯ seg wuḏeyen aḏ lyuwnaniyen. <verse eid="ACT 14:1" /><verse number="2" style="v" sid="ACT 14:2" />lekenti indin lliy wuminenenc seg wuḏeyen ḥemcen lliy muc d wuḏeyen af aweṯen.<verse eid="ACT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 14:3" />amma buwlus aḏ bernaba qqimen diyn ggeṯ tbecren s siydneγ man γiyr tiwdi. aḏ siydneγ lliy yusi yiḏesen, yucesen lqudreṯ af igga n leƹjayeb aḏ lmuƹjizaṯ d lemayer bac aḏemnen midden s tuflayt n nnaƹemtis.<verse eid="ACT 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 14:4" />yaxy mzunen midden n yquniya af sen; sisen mam yused aḏ wuḏeyen. aḏ sisen mam yused aḏ ayuh n sen n imersal. <verse eid="ACT 14:4" /><verse number="5" style="v" sid="ACT 14:5" />smuḏen midden lliy muc d wuḏeyen aḏ wuḏeyen aḏ imeqqarensen aṯƹeddan af ayuh n sen n imersal we atenḥedfen s iḍγaγen,<verse eid="ACT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 14:6" />slen sisen. aḏ rwellen al tmurewin n listera aḏ derba aḏ leḍrefsen g likeniya. <verse eid="ACT 14:6" /><verse number="7" style="v" sid="ACT 14:7" />aḏ qqimen tbecren diyn.<verse eid="ACT 14:7" /></para>
  <para style="s">tmura n listera</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8" />aḏ yusi g tmura n listera meclul wiyeyyurc xlaṣ s manis yluled. <verse eid="ACT 14:8" /><verse number="9" style="v" sid="ACT 14:9" />mniyn yusi yeseγda g dwiy n buwlus, yesmuqlas buwlus. aḏ yefhem lliy liymanis tatiseḥla. <verse eid="ACT 14:9" /><verse number="10" style="v" sid="ACT 14:10" />yaxy yesγuyas: «kker bbed af iderniḵ.» ineggez argaz. aḏ yekker yeggur.<verse eid="ACT 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 14:11" />mniyn zren midden aydin, ṣedƹen s leγweṯ telekwenit uwan: «irebbiyenesen zwand jerenneγ g tteṣwireṯ n bnaḏem.» <verse eid="ACT 14:11" /><verse number="12" style="v" sid="ACT 14:12" />aḏ semman bernaba zeyus lliy d rebbiy n iyuwnaniyen, aḏ buwlus hermes, lliy yusi d mersulis afelxaḍert yusi yedugga.<verse eid="ACT 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 14:13" />aḏ yused lkahen n zeyus seg lmeƹebdis lliy yusi af imi n tmura netta aḏ midden s leṭwaq n lwerd aḏ ifwunesen bac atenγersen y buwlus aḏ bernaba. <verse eid="ACT 14:13" /><verse number="14" style="v" sid="ACT 14:14" />mniyn slen bernaba aḏ buwlus, skeṣen leḥweyjesen s lγiḍ. aḏ uḏeffen amas n midden.<verse eid="ACT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 14:15" />qqimen tleƹelṭen aḏ mmelen: «maγer teteggem amyuh? rahiy neccin d midden am kennim. nused afenenbeccer bac abeṭlem ayuh n iḥejeyen. we ḏulem al rebbiy lliy yedder diyma aḏ lliy yeggi jenna aḏ tammurt aḏ iylel aḏ lliy disen lkul. <verse eid="ACT 14:15" /><verse number="16" style="v" sid="ACT 14:16" />aḏ yedja midden imezweren aḏebƹen matta xsen. <verse eid="ACT 14:16" /><verse number="17" style="v" sid="ACT 14:17" />lekenti yucesen ggeṯ d lemayer lliy sseḵenneṯ lliy netta d rebbiy; am nnaƹmeṯ lliy itucewemted: anzar lliy seg ujenna, aḏ lumasem n lγelleṯ, aḏ uču lliy yesecbeƹewem bac aferḥen ulawnewem.»<verse eid="ACT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 14:18" />aḏ s ayuh n dwiy lkul qudden arren midden af teγrest.<verse eid="ACT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19" />wembeƹd usend wuḏeyen seg anṭakiya aḏ yquniya nnaḍḍen s midden. yaxy qqimen ḥedfen g buwlus almiy yuda ḥsebent yemmuṯ aḏ kerekrent al barra n tmura. <verse eid="ACT 14:19" /><verse number="20" style="v" sid="ACT 14:20" />mniyn nnaḍḍen siyes tlamḏa, yekker. yeḏwel al tmura. aḏ al ača yerzef netta aḏ bernaba al derba.<verse eid="ACT 14:20" /></para>
  <para style="p" />
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21" />aḏ becren middenis lliy ḏwellen ggeṯ sisen d tlamḏa. wembeƹd ḏwellen al listera aḏ yquniya aḏ al anṭakiya. <verse eid="ACT 14:21" /><verse number="22" style="v" sid="ACT 14:22" />aḏ g ayuh n imuḵan lkul wsiyn tcejƹen g tlamḏa aḏ melnasen aṣebren af liyman aḏ lliy iḏaf al lmelekuwt n rebbiy widyettic menγir leƹḏab aḏ tƹeb. <verse eid="ACT 14:22" /><verse number="23" style="v" sid="ACT 14:23" />aḏ ggen y tlamḏa izmimen g kul lmejmeƹ. wembeƹd ẓullen aḏ nihnin ẓwumen aḏ djen midden lkul jar ifesn n siydneγ lliy umennen siyes.<verse eid="ACT 14:23" /></para>
  <para style="s">g iylel al qubruṣ</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 14:24" />aḏ rzeffen seg ljiheṯ n bisidiya al bemfiyliya. <verse eid="ACT 14:24" /><verse number="25" style="v" sid="ACT 14:25" />aḏ becren s linjiyl n rebbiy g burja wembeƹd rzeffen al lmers n ttaliya. <verse eid="ACT 14:25" /><verse number="26" style="v" sid="ACT 14:26" />aḏ s yin uliyen g lbabur bac aḏulen al anṭakiya. ayuh n anṭakiya lliy diyes beqqenten lmumnin s lxiyr aḏ nnaƹmeṯ n rebbiy qebbel man arezfen bac aggen lwejbesen lliy ggent ṭuruh kamel.<verse eid="ACT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 14:27" />mniyn uṣellen sγuyen y lliy g lmejmeƹ aḏ uwanasen af lliy yeggi rebbiy sisen aḏ lliy imir lbab n liyman ḥetta y lliy muc d wuḏeyen. <verse eid="ACT 14:27" /><verse number="28" style="v" sid="ACT 14:28" />aḏ qqimen diyn yid tlamḏa ggeṯ d ussan.<verse eid="ACT 14:28" /></para>
  <chapter eid="ACT 14" />
  <chapter number="15" style="c" sid="ACT 15" />
  <para style="nb">
    <verse number="1" style="v" sid="ACT 15:1" />usend lbeƹḍ n wuḏeyen seg lyehuwdiya al anṭakiya. aḏ uḏellen seḥfeḍen g aweṯen mmalen: «rahiy witmenƹemc kan almiy addehrem af leḥsab n cceriyƹeṯ n muwsa.» <verse eid="ACT 15:1" /><verse number="2" style="v" sid="ACT 15:2" />yaxy ƹandenten buwlus aḏ bernaba ggeṯ. aḏ beƹd keceḥ, smuḏen lmumnin anekyen buwlus aḏ bernaba al uwrceliym aḏ lbeƹḍ n lmumnin tteniyeṯ bac aḥekren ayuh n lmucekleṯ nihnin yid imersal aḏ izmimen.<verse eid="ACT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 15:3" />aḏ ceyƹenten tlamḏa. rzeffen al uwrceliym beƹd mag ƹeddan af finiyqiya aḏ ssamira. aḏ uwan y aweṯen disneṯ: «ḥetta lliy muc d wuḏeyen umennen s lmesiyḥ.» yaxy sefrḥen aweṯen s ayuh ggeṯ. <verse eid="ACT 15:3" /><verse number="4" style="v" sid="ACT 15:4" />mniyn uṣellen al uwrceliym, freḥḥen sisen lmejmeƹ aḏ imersal aḏ izmimen. aḏ uwan buwlus aḏ bernaba y inuh matta yeggi rebbiy af ifesnesen lkul. <verse eid="ACT 15:4" /><verse number="5" style="v" sid="ACT 15:5" />lekenti lmuminin lliy debƹen g iferryisiyen bbedden aḏ uwan: «yexs aggen lmumnin lliy muc d wuḏeyen s cceriyƹeṯ n muwsa we addehren.»<verse eid="ACT 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6" />yaxy mleymen imersal aḏ izmimen y dwiy af ayuh. <verse eid="ACT 15:6" /><verse number="7" style="v" sid="ACT 15:7" />aḏ beƹd mag uflayen af ayuh ggeṯ, yuwa buṭrus: ay ya yeṯma kennim tessennem lliy rebbiy iwazayiḏ s luwel bac aseṣleγ lebcareṯ y lliy muc d wuḏeyen bac aḏamnen siyes. <verse eid="ACT 15:7" /><verse number="8" style="v" sid="ACT 15:8" />aḏ rebbiy lliy yessen matta g ulawen yecheḏ lliy netta yeqbelin madam yucesen rruwḥ lqudus mammeḵ yuceneγtiḏ. <verse eid="ACT 15:8" /><verse number="9" style="v" sid="ACT 15:9" />rahiy netta yerreneγ kifkif madam ysendef ulawnesen s liyman.<verse eid="ACT 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 15:10" />mala maγer witetegemc matta yexs rebbiy? aḏ texsem aggem af tḵermin n tlamḏa ḥaja wiquddenc ibabnenneγ atqamen aḏ winqudc neccin zada. <verse eid="ACT 15:10" /><verse number="11" style="v" sid="ACT 15:11" />rahiy neccin nesteƹqaḏ lliy tanemneƹ neccin yid nihnin s nnaƹmeṯ n siydneγ yesuwƹ.<verse eid="ACT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12" />lweqt ḏḏin, susmen midden lkul. aḏ aqimen sseγdan g buwlus aḏ bernaba lliy dugganesen af lmuƹjizaṯ aḏ lemayer aḏ leƹjayeb lliy sarneṯ af ifesnesen jar lliy muc d wuḏeyen.<verse eid="ACT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 15:13" />beƹd mag kemlen dwiy yuwa yeƹquwb:<verse eid="ACT 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 15:14" />«sseγdeṯ ay yeṯma, yuweyawem simƹan mammeḵ yesmuqel rebbiy al lliy muc d wuḏeyen bac ayweza sisen cceƹb y netta. <verse eid="ACT 15:14" /><verse number="15" style="v" sid="ACT 15:15" />mammeḵ uwan fellas lenbiya aḏ yetweri g lektab.<verse eid="ACT 15:15" /></para>
  <para style="p" />
  <para style="q1">
    <verse number="16" style="v" sid="ACT 15:16" />&lt;beƹd ayuh tadereγ al tezeqqa n dawud</para>
  <para style="q2" vid="ACT 15:16">lliy tehdem tateterreγ.</para>
  <para style="q2" vid="ACT 15:16">taleymeγ iḍγaγen n lsisanis</para>
  <para style="q2" vid="ACT 15:16">we atenerreγ.<verse eid="ACT 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 15:17" />bac alderen midden lkul</para>
  <para style="q2" vid="ACT 15:17">midden lliy muc d wuḏeyen talzellen.<verse eid="ACT 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 15:18" />amyuh yuwa rebbiy s luwel. &gt;<verse eid="ACT 15:18" /></para>
  <para style="p" />
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19" />afelxaḍert n ayuh yexs winetṣeƹebc af lliy umennen seg lliy muc d wuḏeyen. <verse eid="ACT 15:19" /><verse number="20" style="v" sid="ACT 15:20" />amma asennari we asennenmel abeṭlen uču n yssum lliy tucent y leṣnam aḏ zna aḏ uču n lliy yexneq aḏ iḏemmen.<verse eid="ACT 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 15:21" />afelxaḍert cceriyƹeṯ n muwsa s luwel seḥfeḍen diyes g tmurewin lkul. aḏ ƹezmenteṯ g lemjameƹ kul sebbeṯ.»<verse eid="ACT 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22" />lweqt ḏḏin, mfehmen imersal aḏ izmimen aḏ midden lkul bac anekyen irgazen s γarsen yid buwlus aḏ bernaba al anṭakiya. ayuh n sen nihnin d yehuwḏa lliy mmelnas bersaba aḏ siyla lliy γarsen lqimeṯ temeqqart jar aweṯen.<verse eid="ACT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 15:23" />aḏ urinasen: «slam seg awaṯenuwem, imersal aḏ izmimen al awaṯen lkul seg indin lliy muc d wuḏeyen g anṭakiya aḏ suwrya aḏ kilikiya.<verse eid="ACT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 15:24" />nesla lliy lbeƹḍ n midden s γarneγ usnewemd man γiyr man asennenmel aḏ ḥeyrnawem s dwiysen. <verse eid="ACT 15:24" /><verse number="25" style="v" sid="ACT 15:25" />yaxy nemfahem lkulna tanwaza awaṯen we atennenki al γarwem nihnin yid bernaba aḏ buwlus lγaliyen fellenneγ. <verse eid="ACT 15:25" /><verse number="26" style="v" sid="ACT 15:26" />aḏ nihnin ucen imanesen y lxeḏmeṯ n siydneγ yesuwƹ lmesiyḥ. <verse eid="ACT 15:26" /><verse number="27" style="v" sid="ACT 15:27" />aḏ qa nenkiy yehuwḏa aḏ siyla bac afenseṣlen matta nexs s imewnesen.<verse eid="ACT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 15:28" />rahiy neccin am rruwḥ lqudus winγic anṯeqqel afellawem s iḥajeyen bexlaf ayuh n lwajeb. <verse eid="ACT 15:28" /><verse number="29" style="v" sid="ACT 15:29" />yexs abeṭlem uču n yessum lliy yetweγres y leṣnam aḏ iḏemmen aḏ yssum n lliy yexneq. we abeṭlem zna. aḏ kan teggim ayuh rahiy teggim teṣbiḥt.</para>
  <para style="p" vid="ACT 15:29">afenyedj rebbiy.»<verse eid="ACT 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30" />yaxy rzeffen al anṭakiya mani sγuyen y midden bac amleymen. aḏ seṣelnasen lejwab. <verse eid="ACT 15:30" /><verse number="31" style="v" sid="ACT 15:31" />mniyn ƹzement freḥḥen s ucejjeƹ lliy diyes. <verse eid="ACT 15:31" /><verse number="32" style="v" sid="ACT 15:32" />aḏ wsiyn yehuwḏa aḏ siyla, ydugga rebbiy af imewnesen zada, nṣeḥen aweṯen ggeṯ aḏ cejƹenten.<verse eid="ACT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 15:33" />beƹd ussan, ceyƹenten midden bac aḏulen al lliy nkiyyenten. <verse eid="ACT 15:33" /><verse number="34" style="v" sid="ACT 15:34" />lekenti siyla yeƹjebbas qimi g anṭakiya. <verse eid="ACT 15:34" /><verse number="35" style="v" sid="ACT 15:35" />aḏ qqimen diyn buwlus aḏ bernaba seƹzamen aḏ tbecren s dwiy n siydneγ aḏ yiḏesen ggeṯ d midden tbecren.</para>
  <para style="p" vid="ACT 15:35">buwlus aḏ bernaba mferqen<verse eid="ACT 15:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36" />beƹd ussan, yuwa buwlus y bernaba: «yya anreḥ anḥekker lḥal n aweṯeneγ g tmurewin lkul lliy nbeccer disneṯ s dwiy n siydneγ.» <verse eid="ACT 15:36" /><verse number="37" style="v" sid="ACT 15:37" />yaxy yuwa bernaba: «yya anwiy iḏenneγ yuwḥenna lliy mmelnas merqes.» <verse eid="ACT 15:37" /><verse number="38" style="v" sid="ACT 15:38" />lekenti buwlus wiyeqqil afelxaḍert yuwḥenna yedjin weḥdesen g bemfiyliya aḏ witeniƹewenc g ubeccer.<verse eid="ACT 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 15:39" />yaxy mkecḥen almiy mferqen. aḏ yewya bernaba merqes yeqdeƹ iylel al qubruṣ. <verse eid="ACT 15:39" /><verse number="40" style="v" sid="ACT 15:40" />aḏ yewya buwlus siyla yiḏes yerzef beƹd mag baqqent aweṯen s lxiyr aḏ nnaƹmeṯ n rebbiy. <verse eid="ACT 15:40" /><verse number="41" style="v" sid="ACT 15:41" />ireḥ al suwrya aḏ kilikiya bac ayṯebbet liyman n lemjameƹ n lmuminin.<verse eid="ACT 15:41" /></para>
  <chapter eid="ACT 15" />
  <chapter number="16" style="c" sid="ACT 16" />
  <para style="s">timuṯawus tayreḥ yid buwlus aḏ siyla</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1" />yuṣel buwlus al derba aḏ al listera lliy yusi diyes yjen seg tlamḏa ismis timuṯawus. yedjis seg wuḏeyen lliy menen aḏ babis d yuwnaniy. <verse eid="ACT 16:1" /><verse number="2" style="v" sid="ACT 16:2" />aḏ wsiyn aweṯen g listera aḏ yquniya cekren g timuṯawus. <verse eid="ACT 16:2" /><verse number="3" style="v" sid="ACT 16:3" />yaxy yecreh buwlus af iweyis yiḏes y ubeccer. aḏ idehri afelxaḍert wsiyn wuḏeyen g aydin n umkan ssenen lliy babis d yuwnaniy. <verse eid="ACT 16:3" /><verse number="4" style="v" sid="ACT 16:4" />aḏ buwlus aḏ ayuh n aweṯen nnaḍḍen s umkan al umkan tbecren s luwṣayaṯ lliy mfehmen fellesneṯ imersal aḏ izmimen g uwrceliym bac aggen sisneṯ midden. <verse eid="ACT 16:4" /><verse number="5" style="v" sid="ACT 16:5" />aḏ yusi liyman n lemjameƹ n lmuminin yeteṯquwa aḏ leƹdedesen imeγγer as baƹd as.<verse eid="ACT 16:5" /></para>
  <para style="s">qdeƹ n iylel al meqduniya</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6" />yuwayasen rruwḥ lqudus witbecrenc s siydneγ g asiya. yaxy rzeffen al fiyrijiya aḏ γelaṭya. <verse eid="ACT 16:6" /><verse number="7" style="v" sid="ACT 16:7" />mniyn uṣellen al leḥduḏ n miysiya, nnaḍḍen al biyṯiniya. lekenti rruwḥ n yesuwƹ yuwayasen wisteḏfenc. <verse eid="ACT 16:7" /><verse number="8" style="v" sid="ACT 16:8" />yaxy ƹeddan af miysiya g ubriḏesen al lmers n teruwas. <verse eid="ACT 16:8" /><verse number="9" style="v" sid="ACT 16:9" />yiḍ diyn, yezra buwlus g tirjelt argaz seg meqduniya yetjeheyas, yemmal: «qdeƹ iylel al meqduniya tƹewendeneγ.»<verse eid="ACT 16:9" /></para>
  <para style="s">buwlus aḏ siyla g filibbi</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 16:10" />lweqt ḏḏin, nefhem lliy rebbiy yexs anbeccer g meqduniya. yaxy nesmuḏ asenreḥ fiseƹ.<verse eid="ACT 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11" />nuli g lbabur seg lmers n teruwas al samuṯraki. aḏ al ača nkemmel terzeft al lmers n niyabuwlis. <verse eid="ACT 16:11" /><verse number="12" style="v" sid="ACT 16:12" />aḏ s yin al filibbi temeqqart n tmurewin n meqduniya lliy steƹemrenteṯ iruwmiyen. aḏ neqqim diyes ussan. <verse eid="ACT 16:12" /><verse number="13" style="v" sid="ACT 16:13" />as n sebbeṯ, neffeγ seg tmura al cceṭ n lwaḏ balek anef mkan lliy lmeḏḏen wuḏeyen tẓallan diyes. aḏ neqqim ndugga y tseḏnan lliy mleyemneṯ. <verse eid="ACT 16:13" /><verse number="14" style="v" sid="ACT 16:14" />aḏ jaresneṯ ijeṯ seg tmura n ṯiyatira tezenza g leqmac d ḥbari. tetzella diyma y rebbiy aḏ ismis liydiya. aḏ nettaṯ tusi teseγda diyneγ. yaxy imir rebbiy ulis bac ataqbel dwiy n buwlus. <verse eid="ACT 16:14" /><verse number="15" style="v" sid="ACT 16:15" />mniyn zizdines nettaṯ aḏ middenis, tjeheyaneγ bac anreḥ al γares, tuwa: «kan tufim lliy neči nembelḥeq umenneγ s siydneγ ḏfeṯ al tzaqqaw.» yaxy nƹedda.<verse eid="ACT 16:15" /></para>
  <para style="s">seffeγ n rruwḥ seg ijeṯ d teteggezt.</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16" />ijuwas, mniyn tanreḥ aneẓẓal, teƹreḍḍeneγ ijeṯ yeskenniṯ rruwḥ n uteggez. aḏ wsiyn lesyaḏis rebḥen ggeṯ d iflusen seg tegzis. <verse eid="ACT 16:16" /><verse number="17" style="v" sid="ACT 16:17" />aḏ tuḏel teggur deffer buwlus aḏ defereneγ tetṣeyyeḥ: «ayuh n midden d leƹbaḏ n rebbiy lliy yeƹla, tafensiḵnen abriyḏ n mneƹ.» <verse eid="ACT 16:17" /><verse number="18" style="v" sid="ACT 16:18" />aḏ teqqim tetteg amyuh ussan almiy iγeccec buwlus ggeṯ. aḏ yenneḍ al rruwḥ lliy diyes yuwayas: «s ysem n yesuwƹ lmesiyḥ ffeγ siyes.» yeffeγ ƹlewleh.<verse eid="ACT 16:18" /></para>
  <para style="s">buwlus aḏ siyla g lḥebs</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 16:19" />mniyn ufen lesyaḏis lmeṣwarsen ykemmel, ṭṭefen buwlus aḏ siyla awyenten al ssaḥeṯ temeqqart bac aḥekmen fellasen. <verse eid="ACT 16:19" /><verse number="20" style="v" sid="ACT 16:20" />aḏ awan y lḥukkam: «ayuh n sen n irgazen d wuḏeyen aḏ tteggen g lehrej d meqqar g tmurenneγ. <verse eid="ACT 16:20" /><verse number="21" style="v" sid="ACT 16:21" />mmalen y midden aggen iḥejeyen yexs witenqebelc aḏ wintegc sisen necci lliy d iruwmeyen.» <verse eid="ACT 16:21" /><verse number="22" style="v" sid="ACT 16:22" />yaxy γecceccen midden fellasen. aḏ skeṣnasen lḥukkam leḥweyjesen. aḏ ḥkemmen fellasen s lfelqeṯ. <verse eid="ACT 16:22" /><verse number="23" style="v" sid="ACT 16:23" />wettenten s ṣṣut ggeṯ. aḏ ggenten g lḥebs. aḏ uwan y uƹessas meqqar n lḥebs ayƹus yeqƹeḏ. <verse eid="ACT 16:23" /><verse number="24" style="v" sid="ACT 16:24" />yeggi ayuh n argaz mammeḵ uwanas; yeggin g lḥebs n jaj. aḏ yeggisen idernesen g tilweḥin.<verse eid="ACT 16:24" /></para>
  <para style="s">mneƹ n uƹessas aḏ middenis.</para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25" />azgenyeḍ, mniyn yusi buwlus aḏ siyla tẓallan aḏ tsebḥen y rebbiy s izli aḏ imeḥbas seγdan disen, <verse eid="ACT 16:25" /><verse number="26" style="v" sid="ACT 16:26" />yuqeƹ zelzal d meqqar. ixelxel lsisan n lḥebs. aḏ imir lbibanis aḏ iqqan n imeḥbas lkul.<verse eid="ACT 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 16:27" />yesfeqqed aƹessas meqqar yid zelzal. mniyn yezra lbiban miren yeḥsab imeḥbas rwellen. yenzeγγed ssiyfis bac ayenγ imanis. <verse eid="ACT 16:27" /><verse number="28" style="v" sid="ACT 16:28" />lekenti buwlus iṣeddeƹ: «wineγc imaniḵ. rahiy lkulna nella deh.»<verse eid="ACT 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29" />yaxy yeḍleb nnir. aḏ ineggez al jaj aḏ netta yeterjiji. yezzel azzaṯ buwlus aḏ siyla. <verse eid="ACT 16:29" /><verse number="30" style="v" sid="ACT 16:30" />aḏ ysefγin al barra ysesetnin: «ay ya lmuƹelmin, matta yexs aggeγ bac amenƹeγ?»<verse eid="ACT 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 16:31" />uwanas: «men s siydneγ yesuwƹ amenƹeḏ cek aḏ neseniḵ.»<verse eid="ACT 16:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 16:32" />wembeƹd becrent netta aḏ lliy yiḏes s dwiy n siydneγ. <verse eid="ACT 16:32" /><verse number="33" style="v" sid="ACT 16:33" />yaxy yewyin iddin ƹlewleh idewayin. aḏ zizdines netta aḏ nnasenis lkul. <verse eid="ACT 16:33" /><verse number="34" style="v" sid="ACT 16:34" />aḏ yewyin al tzaqqas. yeggasen ṭṭewleṯ n uču. aḏ yefreḥ ggeṯ netta aḏ nnasnis afelxaḍert umennen s rebbiy.<verse eid="ACT 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35" />tajji nkiyyen lḥukkam iƹesekriyen bac mlen y umeqqar n iƹessasen aysiyeb buwlus aḏ siyla. <verse eid="ACT 16:35" /><verse number="36" style="v" sid="ACT 16:36" />yuwa ƹessas y buwlus: «nkiyyeniḏ lḥukkam bac afensiybeγ, fγeṯ af imanuwem ṭuruh wittegeṯec.»<verse eid="ACT 16:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37" />yaxy iγeccec buwlus yuwa y lliy usend: «wetneneγ zzaṯ midden menγir lḥukem aḏ neccin d iruwmeyen. aḏ gnaneγ g lḥebs. mammeḵ aγensiben man γiyr man snen midden lkul. aha, yexs adesen nihnin we aγensiben.»<verse eid="ACT 16:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 16:38" />aḏ uwan iƹesekriyen y lḥukkam af mag yuwa buwlus. yaxy ugeḏḏen mniyn slen lliy nihnin d iruwmeyen. <verse eid="ACT 16:38" /><verse number="39" style="v" sid="ACT 16:39" />aḏ usend ḍelben g smaḥ. aḏ seybenten. aḏ uwanasen afγen seg tmura diyn. <verse eid="ACT 16:39" /><verse number="40" style="v" sid="ACT 16:40" />yeffeγ buwlus aḏ siyla seg lḥebs. aḏ reḥḥen al tzaqqa n liydiya, mani ufen aweṯen aḏ cejƹenten. wembeƹd ffeγen seg tmura.<verse eid="ACT 16:40" /></para>
  <chapter eid="ACT 16" />
  <chapter number="17" style="c" sid="ACT 17" />
  <para style="s">buwlus aḏ siyla g tesaluniki</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1" />yuṣel buwlus aḏ siyla al tesaluniki lliy yusi diyes lmejmeƹ n wuḏeyen beƹd mag ƹeddan af mfibuliys aḏ buluniya. <verse eid="ACT 17:1" /><verse number="2" style="v" sid="ACT 17:2" />yaxy ireḥḥas buwlus am lƹadeṯ aḏ yeqqim yetkaceḥ disen s dwiy lliy g lektab 3 n sebbeṯaṯ. <verse eid="ACT 17:2" /><verse number="3" style="v" sid="ACT 17:3" />aḏ yusi iƹezzem g lektab aḏ yetfesresen lliy lmesiyḥ lazem ayettuƹeḏeb we ayekker seg jar lliy mmuṯen. aḏ yuwa: «rahiy lmesiyḥ lliy tesugumem diyes netta d yesuwƹ lliy tbecreγ diwem siyes ṭuruh.» <verse eid="ACT 17:3" /><verse number="4" style="v" sid="ACT 17:4" />yaxy crehhen ulawen n lbeƹḍ seg lliy ḥderren aḏ umennen. aḏ ḏbeƹen buwlus aḏ siyla. aḏ yusi iḏsen ggeṯ d iyuwnaniyen lliy wsiyn tẓallan y rebbiy aḏ ggeṯ d tiseḏnan timurkentiyen.<verse eid="ACT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5" />yaxy nγerren wuḏeyen lliy wuminenc. aḏ laymen lbeƹḍ n lliy thummuwn seg irgazen aḏ midden bac aggen lehrej we aṣeyḥen g tmura. aḏ fzeƹen lkulhum al lḥuc n yasuwn xsen aṭfen buwlus aḏ siyla bac atensbedden azzaṯ cceƹb. <verse eid="ACT 17:5" /><verse number="6" style="v" sid="ACT 17:6" />mniyn witenufin diyn kerkeren yasuwn aḏ lbeƹḍ n aweṯen al lḥukkam n tmura. aḏ cken uwan: «rahiy ayuh n sen n irgazen lliy qlebben ddunyeṯ usend al tmurenneγ zada. <verse eid="ACT 17:6" /><verse number="7" style="v" sid="ACT 17:7" />aḏ yefreḥ sisen yasuwn g tzaqqas. aḏ nihnin lkulhum witeggenc s dwiy n lqeyṣer. aḏ tbecren s lmelek iḍen ismis yesuwƹ.»<verse eid="ACT 17:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 17:8" />yaxy ugeḏḏen midden aḏ lḥukkam mniyn slen ayuh. <verse eid="ACT 17:8" /><verse number="9" style="v" sid="ACT 17:9" />aḏ lqan af yasuwn lekfaleṯ bac atsiben netta aḏ lliy yiḏes.<verse eid="ACT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10" />g yiḍ ceyƹen aweṯen buwlus aḏ siyla al biyriya. mniyn uṣelnas, reḥḥen al lmejmeƹ n wuḏeyen diyes. <verse eid="ACT 17:10" /><verse number="11" style="v" sid="ACT 17:11" />aḏ wsiyn uḏeynis xiyr n wuḏeyen n tesaluniki. aḏ qbellen dwiy n rebbiy aḏ nihnin crehhen fellas ggeṯ. aḏ uḏellen ƹezmen g lektab kul as bac aḥekren dwiy n buwlus ṣḥiḥ naγ aha. <verse eid="ACT 17:11" /><verse number="12" style="v" sid="ACT 17:12" />yaxy umennen ggeṯ sisen. aḏ umennen seg iyuwnaniyen ggeṯ d tseḏnan n imurkentiyen aḏ irgazen.<verse eid="ACT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 17:13" />slen wuḏeyen n tesaluniki lliy buwlus yella yetbeccer g biyriya. yaxy iweḍḍent. aḏ qqimen tḥercen g midden fellasen.<verse eid="ACT 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 17:14" />yaxy ƹlewleh awyen aweṯen buwlus al iylel bac ayerzef. aḏ yeqqim siyla aḏ timuṯawus diyn. <verse eid="ACT 17:14" /><verse number="15" style="v" sid="ACT 17:15" />reḥḥen aweṯen yid buwlus almiy seṣlent al ṯiyna. wembeƹd rrend. aḏ yusi buwlus iweṣṣeyin bac amlen y siyla aḏ timuṯawus aḍewden felles fiseƹ.<verse eid="ACT 17:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16" />mniyn yusi yesugum disen g ṯiyna, yufa tmura tečur d leṣnam. yaxy iγeccec. <verse eid="ACT 17:16" /><verse number="17" style="v" sid="ACT 17:17" />yuḏel yetkeceḥ g wuḏeyen aḏ g lliy muc d wuḏeyen seg indin lliy tẓallan g lmejmeƹ. aḏ ydugga zada y lliy yetemleqa yiḏesen kul as g ssaḥeṯ n tmura. <verse eid="ACT 17:17" /><verse number="18" style="v" sid="ACT 17:18" />mniyn uflayen yiḏes lbeƹḍ seg tlamḏa n biquwr, aḏ lbeƹḍ n iriweqiyen, uwan lbeƹḍ sisen: «af matta ydugga ayuh n argaz lliy ilsis diyma iṭenneḍ zeƹma.»</para>
  <para style="p" vid="ACT 17:18">aḏ uwan ttenyaṯ lliy rahiy yetbeccer s ysem n irebbiyen iḍen. afelxaḍert yusi yduggeyasen af yesuwƹ aḏ tneḵris.<verse eid="ACT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 17:19" />yaxy awyent al aryubaγus. aḏ uwanas: «nexs anessen d matta ayuh n lmeḏheb jdiḏ lliy tetbecreḏ siyes. <verse eid="ACT 17:19" /><verse number="20" style="v" sid="ACT 17:20" />rahiy neseγda diyeḵ temeleḏ g dwiy aγrib nexs atnefhem.» <verse eid="ACT 17:20" /><verse number="21" style="v" sid="ACT 17:21" />aḏ wsiyn midden n ṯiyna aḏ lliy seknen diyes seg iγriben tƹeddan g lweqtesen duggan naγ sseγdan g ḥaja d jdiḏ.<verse eid="ACT 17:21" /></para>
  <para style="s">lxuṭbeṯ n buwlus g aryubaγus</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22" />yebbed buwlus g amas n aryubaγus yuwa:</para>
  <para style="p" vid="ACT 17:22">«ay midden n ṯiyna ufiγwem deynin ggeṯ g kul ciy. <verse eid="ACT 17:22" /><verse number="23" style="v" sid="ACT 17:23" />mniyn neči tendeγ g tmurewem, aḏ smuquleγ al lemƹebduwem, ufiγ ḥetta mkan n teγrest yuri fellas: &lt; al rebbiy lliy winessinc ismis. &gt; mala s ayuh n rebbiy lliy tetzellimas aḏ witsinemc ismis neči tbecreγ diwem. <verse eid="ACT 17:23" /><verse number="24" style="v" sid="ACT 17:24" />rahiy netta wisekkenc g lemƹebed lliy bnenten ifesn n midden afelxaḍert netta d rebbiy n ujenna aḏ tammurt. aḏ d netta yeggi ddunyeṯ aḏ lliy diyes lkul. <verse eid="ACT 17:24" /><verse number="25" style="v" sid="ACT 17:25" />witeḥtaq ḥaja s γarwem, afelxaḍert d netta lliy ituc y midden lkul temeddurt aḏ rruwḥ aḏ kul ciy. <verse eid="ACT 17:25" /><verse number="26" style="v" sid="ACT 17:26" />aḏ yeggi midden lkul seg yjen. aḏ ysesknin g tammurt lkul.</para>
  <para style="p" vid="ACT 17:26">aḏ yeggi s luwel lweqt n tmedurtesen aḏ leḥduḏ n temurinsen, <verse eid="ACT 17:26" /><verse number="27" style="v" sid="ACT 17:27" />bac aḏurzun af rebbiy we atefen. rahiy netta yella yid kul yjen sineγ, <verse eid="ACT 17:27" /><verse number="28" style="v" sid="ACT 17:28" />afelxaḍert</para>
  <para style="p" vid="ACT 17:28" />
  <para style="q1" vid="ACT 17:28">&lt;siyes netedder aḏ neggur aḏ nella. &gt;</para>
  <para style="p" vid="ACT 17:28">naγ mammeḵ uwan lbeƹḍ seg irgezenuwem lliy tinyen:</para>
  <para style="q1" vid="ACT 17:28">&lt;neccin zada d ṭarwas. &gt;<verse eid="ACT 17:28" /></para>
  <para style="p" />
  <para style="p">
    <verse number="29" style="v" sid="ACT 17:29" />mala medam neccin d ṭarwa n rebbiy yexs wintegc rebbiy am ṣnem s wureγ naγ s lfejreṯ naγ seg iḍγaγen yetquddu kul yjen atyeg mammeḵ yexs. <verse eid="ACT 17:29" /><verse number="30" style="v" sid="ACT 17:30" />rahiy rebbiy lliy wifeniḥesebc af ussan lliy tusim witsinemc disen ismis, yesγuyu ṭuruh af midden lkul bac adesen we ateben, <verse eid="ACT 17:30" /><verse number="31" style="v" sid="ACT 17:31" />afelxaḍert yeggi as y leḥsab y lliy g ddunyeṯ lkul s lƹedl af ffus n yjen iwezayi. aḏ yuca lemerṯ y midden lkul mniyn ysekri seg tmettent.»<verse eid="ACT 17:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32" />mniyn slen lbeƹḍ n midden s tneḵri beƹd temettent, qqimen teṯhezzan. lekenti midden iḍen uwan y buwlus: «nexs aγentufleyeḏ af ayuh tijekkelt iḍen.» <verse eid="ACT 17:32" /><verse number="33" style="v" sid="ACT 17:33" />aḏ amyuh yeffeγ buwlus s γarsen. <verse eid="ACT 17:33" /><verse number="34" style="v" sid="ACT 17:34" />aḏ diyes mam yumen aḏ yeḏbeƹ buwlus, aḏ sisen dyunisyus lliy yusi d yjen seg irgezen n lmejles n aryubaγus aḏ temeṭṭuṯ ismis damariys aḏ lbeƹḍ n midden.<verse eid="ACT 17:34" /></para>
  <chapter eid="ACT 17" />
  <chapter number="18" style="c" sid="ACT 18" />
  <para style="s">g kurinṯus</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1" />beƹdin yeffeγ buwlus seg ṯiyna ireḥ al kurinṯus. <verse eid="ACT 18:1" /><verse number="2" style="v" sid="ACT 18:2" />aḏ yufa dinet uḏay ismis akiyla seg bunṭus, lliy seddiγ yused seg iyṭalya netta aḏ lehlis briskilla afelxaḍert lqeyṣer kuludiyus izeƹzeq wuḏeyen seg ruwma. yaxy ireḥḥesen buwlus. <verse eid="ACT 18:2" /><verse number="3" style="v" sid="ACT 18:3" />aḏ afelxaḍert yusi am nihnin iṣenneƹ g lƹecceṯ, yeqqim γarsen ixeddem yiḏesen. <verse eid="ACT 18:3" /><verse number="4" style="v" sid="ACT 18:4" />aḏ yusi kul sebbeṯ yetkacḥ lliy ḥderren g lmejmeƹ bac aḏemnen wuḏeyen aḏ iyuwnaniyen.<verse eid="ACT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5" />mniyn uṣelnas siyla aḏ timuṯawus seg meqduniya, yeqqim buwlus yetbeccer akehaw aḏ yeseḵan y wuḏeyen lliy yesuwƹ d netta d lmesiyḥ. <verse eid="ACT 18:5" /><verse number="6" style="v" sid="ACT 18:6" />lekenti bbedenas. aḏ uḏellen tsubbun. yaxy yezelz fellasen leḥweyjis yuwayasen: «bekkeḍuwem g teḵrumtuwem. rahiy neči xaṭini. aḏ s ṭuruh tabecreγ lliy muc d wuḏeyen.» <verse eid="ACT 18:6" /><verse number="7" style="v" sid="ACT 18:7" />aḏ iḥwel al tzaqqa n yjen muc d uḏay yetzella y rebbiy ismis tiyṭus yustus. aḏ tusi tezeqqas tman lmejmeƹ. <verse eid="ACT 18:7" /><verse number="8" style="v" sid="ACT 18:8" />yaxy yumen s siydneγ krisbus meqqar n lmejmeƹ netta aḏ nnasnis lkul. aḏ slen ggeṯ d midden seg kurinṯus beccer n buwlus. yaxy umennen aḏ ttuzizdin.<verse eid="ACT 18:8" /></para>
  <para style="s">uflay, wisusumc</para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9" />ijenyeḍ, yezra buwlus siydneγ g tirjelt yemmalas: «witegeḏec, uflay, wisusumc. <verse eid="ACT 18:9" /><verse number="10" style="v" sid="ACT 18:10" />rahiy lliγ iḏeḵ. aḏ wiyetquddu ḥetta d yjen afidur afelxaḍert γari midden ggeṯ g ayuh n tmura.» <verse eid="ACT 18:10" /><verse number="11" style="v" sid="ACT 18:11" />yaxy yeqqim buwlus g kurenṯus suggas aḏ wezgen yesseḥfaḍ g midden g dwiy n rebbiy.<verse eid="ACT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12" />mniyn yusi lḥakem ruwmani γaliyun iḥekkem g xaya, mleymen wuḏeyen jmiyƹ af buwlus, awyent al lmeḥkmeṯ. <verse eid="ACT 18:12" /><verse number="13" style="v" sid="ACT 18:13" />aḏ ckan siyes uwan: «ayuh n argaz yexs midden afγen seg cceriyƹeṯ n muwsa we adbeƹen breḏ d jdid.» <verse eid="ACT 18:13" /><verse number="14" style="v" sid="ACT 18:14" />aḏ qebbel man ayuflay buwlus, yuwa γaliyun: «ayya wuḏeyen, lukan d ljerimeṯ naγ d temenγiwt rahiy taḥekmeγ jarewem s lƹedl. <verse eid="ACT 18:14" /><verse number="15" style="v" sid="ACT 18:15" />amma madam lmucekleṯ d kaceḥ s tuflayin aḏ ismewen aḏ criƹtuwem, debreṯ ixfewnuwem weḥduwem. neči wiγisexc aḥekmeγ g ayuh n lemcakel.» <verse eid="ACT 18:15" /><verse number="16" style="v" sid="ACT 18:16" />aḏ izeƹezqin seg lmeḥekmeṯ. <verse eid="ACT 18:16" /><verse number="17" style="v" sid="ACT 18:17" />yaxy ṭefen sustanis meqqar n lmejmeƹ wettent zzaṯ lmeḥekmeṯ. lekenti γaliyun wisenyeggi ḥaja.<verse eid="ACT 18:17" /></para>
  <para style="s">buwlus yetreḥ seg umkan al umkan yetcejjeƹ aweṯen</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18" />yeqqim buwlus g kurinṯus ggeṯ. wembeƹd yerzef af iylel al suwrya aḏ yiḏes briskilla aḏ akiyla. aḏ qebbel man ayerzef, yekkes udjufis g tmura n kenxiriya afelxaḍert yusi yuƹeḏ siyes rebbiy. <verse eid="ACT 18:18" /><verse number="19" style="v" sid="ACT 18:19" />mniyn uṣellen al afsus, yedjin diyes buwlus aḏ yuḏef al lmejmeƹ yetkeceḥ g wuḏeyen. <verse eid="ACT 18:19" /><verse number="20" style="v" sid="ACT 18:20" />yaxy uwanas ayeqqim γarsen iṭer lekenti wiyeqqil. <verse eid="ACT 18:20" /><verse number="21" style="v" sid="ACT 18:21" />aḏ yuwayasen: «tafenderreγ kan yexs rebbiy.» aḏ yeffeγ seg afsus af iylel. <verse eid="ACT 18:21" /><verse number="22" style="v" sid="ACT 18:22" />aḏ yezwa g lmers n lqeyṣeriya. yuli ysellem af aweṯen n lmejmeƹ diyes. wembeƹd ireḥ al anṭakiya. <verse eid="ACT 18:22" /><verse number="23" style="v" sid="ACT 18:23" />yeqqim diyes fercu. wembeƹd yenneḍ g γelaṭya aḏ fiyrijiya. yetcejjeƹ g aweṯen seg umkan al umkan.<verse eid="ACT 18:23" /></para>
  <para style="s">buwlus g afsus aḏ axaya</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24" />aḏ yused al afsus uḏay yluled g liskenderiya. aḏ ydugga yeqƹeḏ. aḏ yessen lektab n rebbiy ggeṯ ismis buwlus. <verse eid="ACT 18:24" /><verse number="25" style="v" sid="ACT 18:25" />yusi yessen abriyḏ n siydneγ. aḏ yuḏel ixeṭṭeb s cjaƹeṯ temeqqart aḏ yesseḥfaḍ g leḥqeyeq af yesuwƹ yeqƹeḏ. lekenti netta yusi wiyessin kan zizdi n yaḥya. <verse eid="ACT 18:25" /><verse number="26" style="v" sid="ACT 18:26" />aḏ yuḏel ydugga g lmejmeƹ s cjaƹeṯ. yaxy slennas akiyla aḏ briskilla awyent al γarsen aḏ siḵennas abriyḏ n rebbiy yeqƹeḏ. <verse eid="ACT 18:26" /><verse number="27" style="v" sid="ACT 18:27" />aḏ yesmuḏ buwlus terzeft al xaya. yaxy cejƹent aweṯen aḏ nkiyyen y aweṯen g xaya bac aferḥen siyes. mniyn yuṣel al diyn iƹawen ggeṯ lliy umennen s nnaƹmeṯ lliy yucas rebbiy. <verse eid="ACT 18:27" /><verse number="28" style="v" sid="ACT 18:28" />afelxaḍert yusi s lemayer lliy itucineṯ seg lektab iteqqes g imewn n wuḏeyen zzaṯ midden. aḏ yeseḵenasen lliy yesuwƹ netta d lmesiyḥ.<verse eid="ACT 18:28" /></para>
  <chapter eid="ACT 18" />
  <chapter number="19" style="c" sid="ACT 19" />
  <para style="s">buwlus g afsus</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1" />mniyn yusi buwlus g kurinṯus, yuṣel buwlus al afsus beƹd mag iƹedda af imuḵan lliy ƹlan g amas n leblad. aḏ g afsus yufa lbeƹḍ n tlamḏa. <verse eid="ACT 19:1" /><verse number="2" style="v" sid="ACT 19:2" />yaxy ysesetnin: «yezwa fellewem rruwḥ lqudus mniyn tumennem naγ aha.» rennas: «aha, aḏ wineslic s rruwḥ lqudus xlaṣ.» <verse eid="ACT 19:2" /><verse number="3" style="v" sid="ACT 19:3" />yuwayasen: «mammeḵ zeγ tetuzizedyem.» uwanas: «feleḥsab n uzizdi n yaḥya.» <verse eid="ACT 19:3" /><verse number="4" style="v" sid="ACT 19:4" />yaxy yuwa buwlus: «yusi yaḥya yezizdi g midden d lemereṯ n ttubtesen aḏ yemmalesen aḏemnen s lliy tadyas beƹdis, yeƹni s yesuwƹ.» <verse eid="ACT 19:4" /><verse number="5" style="v" sid="ACT 19:5" />mniyn slen ayuh n dwiy, ttuzizdyen s ysem n siydneγ yesuwƹ. <verse eid="ACT 19:5" /><verse number="6" style="v" sid="ACT 19:6" />yeggi buwlus ifesnis fellasen. yaxy yezwa fellasen rruwḥ lqudus. aḏ uḏellen duggan s lγawi iḍen aḏ yuflay rebbiy af imewnesen. <verse eid="ACT 19:6" /><verse number="7" style="v" sid="ACT 19:7" />aḏ yusi leƹded n irgazen ṯnac.<verse eid="ACT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8" />yeqqim buwlus 3 chuwr yetreḥ al lmejmeƹ n wuḏeyen ydugga jhar aḏ yetneqec af lḥqeyeq n lmelekuwt n rebbiy bac aḏamnen lliy ḥderren. <verse eid="ACT 19:8" /><verse number="9" style="v" sid="ACT 19:9" />lekenti ggeṯ d midden seqeṣḥen ixfewensen aḏ wiwuminenc. aḏ uḏellen deƹun g abriyḏ n rebbiy zzaṯ lliy mleymen diyn. yaxy yebƹeḏ buwlus fellasen aḏ yeqqim netta aḏ tlamḏa yetneqec kul as g lmejles n yjen ismis tiyranuws. <verse eid="ACT 19:9" /><verse number="10" style="v" sid="ACT 19:10" />yeqqim am idin sen isuggesen. aḏ amyuh yuṣel dwiy n rebbiy al wuḏeyen aḏ iyuwnaniyen n asiya lkul. <verse eid="ACT 19:10" /><verse number="11" style="v" sid="ACT 19:11" />yusi rebbiy iteg lmuƹjizaṯ timeqqarin af ifesn n buwlus. <verse eid="ACT 19:11" /><verse number="12" style="v" sid="ACT 19:12" />almiy ḏwellen midden ugayen timeḥrmin naγ tiḥezemiyin lliy yeṭṭef disneṯ aḏ teggentent af imuḍan. aḏ wsiyn ayuh n imuḍan ḥellan s aydin aḏ tefγen sisen lerwaḥ lliy wiḥlin.<verse eid="ACT 19:12" /></para>
  <para style="s">ṭerwa n sikaw</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 19:13" />lbeƹḍ n wuḏeyen lliy ttenden zeƹzaqen g lejnun seg imuḍan smuḏen taggen ayuh s ysem n yesuwƹ. aḏ nihnin mmalen: «ffeγ s ysem n yesuwƹ lliy yetbeccer siyes buwlus.»<verse eid="ACT 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 19:14" />aḏ yusi jaresen 7 d ṭarwa n yjen seg imeqqaren n lkuhhan ismis sikaw, <verse eid="ACT 19:14" /><verse number="15" style="v" sid="ACT 19:15" />yaxy yerrasen rruwḥ lliy wiyeḥli: «yesuwƹ neči sennext, aḏ buwlus senγ d mam netta, lekenti kennim d mam.» <verse eid="ACT 19:15" /><verse number="16" style="v" sid="ACT 19:16" />wembeƹd yehjem fellesen argaz lliy yella diyes rruwḥ yeγlebin. rwellen d iƹeryanen s lejruḥesen seg tzaqqa lliy wsiyn diyes.<verse eid="ACT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 19:17" />slen s aydin wuḏeyen aḏ iyuwnaniyen lliy seknen g afsus lkul. aḏ ugeḏḏen lkulhum. aḏ yeṯmejiḏ ysem n siydneγ yesuwƹ. <verse eid="ACT 19:17" /><verse number="18" style="v" sid="ACT 19:18" />aḏ usend ggeṯ seg indin lliy umennen. steƹrefen s mag ggen. <verse eid="ACT 19:18" /><verse number="19" style="v" sid="ACT 19:19" />aḏ uḏellen ggeṯ d yseḥḥeren ḥerqen g lektubesen zzaṯ midden. aḏ ƹudden midden ssum n ayuh n lektub ufent 50,000 d imeḥbuben n lfejreṯ. <verse eid="ACT 19:19" /><verse number="20" style="v" sid="ACT 19:20" />aḏ amyuh yusi dwiy n rebbiy iteṣel al midden. aḏ treni lqutis.<verse eid="ACT 19:20" /></para>
  <para style="s">lehrej g afsus.</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21" />beƹd ayuh, yesmuḏ buwlus terzeft al uwrceliym af abriyḏ n meqduniya aḏ xaya. aḏ yuwa: «yexs beƹd man aqimeγ diyes areḥeγ al ruwma zada.» <verse eid="ACT 19:21" /><verse number="22" style="v" sid="ACT 19:22" />yenkiy al meqduniya sen seg lliy tƹewenen diyes nihnin d timuṯawus aḏ resṭus. aḏ yerniy yeqqim netta fercu g asiya.<verse eid="ACT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23" />lweqt ḏḏin, yuqeƹ lehrej d meqqar g afsus afelxaḍert n yeh n abriyḏ jdiḏ. <verse eid="ACT 19:23" /><verse number="24" style="v" sid="ACT 19:24" />yusi diyes yjen d ṣeyγi ismis dimitiryus iṣenneƹ g lmeƹbed d imeckunen n rṭamiys seg lfejreṯ. aḏ yetṣewer seg aydin netta aḏ ixedemnis ggeṯ d iflusen. <verse eid="ACT 19:24" /><verse number="25" style="v" sid="ACT 19:25" />yesγuy af ixedemnis aḏ lliy teggen am netta, yuwayasen: «kennim tessennem lliy lmeṣwereneγ meqqar seg ayuh n lxeḏmeṯ. <verse eid="ACT 19:25" /><verse number="26" style="v" sid="ACT 19:26" />aḏ kennim tzarrem aḏ teseγdim mammeḵ ayuh n buwlus iḍeyyeƹ midden ggeṯ g afsus aḏ asiya lkul, aḏ isiḵnasen lliy teswireṯ lliy nteggin s ifesnenneγ muc d teswireṯ n rebbiy. <verse eid="ACT 19:26" /><verse number="27" style="v" sid="ACT 19:27" />aḏ ayuh muc taγenidur g lmeṣwereneγ akehaw. amma tayerra midden hejmen af lmeƹbed n rebbiynaγ temeqqart rṭamiys we tuda lhibtis g ijdi. we aymukes qedsis aḏ nettaṯ tẓallenas midden n asiya aḏ ddunyeṯ lkul.»<verse eid="ACT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28" />mniyn slen ixeddemen aḏ midden ayuh, γecceccen aḏ qqimen tṣeyḥen: «temeqqart rṭamiys rebbiy n afsus.» <verse eid="ACT 19:28" /><verse number="29" style="v" sid="ACT 19:29" />yekṯered lehrej g tmura lkul. aḏ hjemen ggeṯ d midden af γayus aḏ rsterxus imeqduniyen lliy rezfen aḏ buwlus. aḏ kerekrenten al ssaḥeṯ n urar.<verse eid="ACT 19:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 19:30" />yesmuḏ buwlus tayeffeγ al midden. lekenti tlamḏa witedjin. <verse eid="ACT 19:30" /><verse number="31" style="v" sid="ACT 19:31" />aḏ nkiynas leṣḥabis seg imeqqaren n asiya bac wiyetriḥc al ssaḥeṯ n urar. aḏ wiyetxeṭirc s imanis.<verse eid="ACT 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 19:32" />wsiyn midden wisinenc matta diyes aḏ y matta mleymen. aḏ kul yjen yemmal ḥaja.<verse eid="ACT 19:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 19:33" />aḏ yusi yid midden uḏay ismis skender duzzent wuḏeyen al zzaṯ bac ayuflay. yaxy iqam fusis bac asusmen midden. <verse eid="ACT 19:33" /><verse number="34" style="v" sid="ACT 19:34" />lekenti midden fhemmen lliy netta d uḏay. aḏ qqimen tṣedƹen seƹtin: «temeqqart rṭamiys rebbiy n afsus.»<verse eid="ACT 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35" />g lexxer, lƹumda n tmura yuwayasen arsen. yaxy uγen rrayis. aḏ yuwa: «ya midden n afsus mam wiyessinc lliy afsus tetƹussu af lmeƹbed n rṭamiys aḏ ṣnemmis lliy yezwad seg ujenna? <verse eid="ACT 19:35" /><verse number="36" style="v" sid="ACT 19:36" />aḏ madam ayuh widdic ccek, yexs arsem. aḏ witetegemc ḥaja man γiyr man axememem. <verse eid="ACT 19:36" /><verse number="37" style="v" sid="ACT 19:37" />rahiy tuγimd ayuh n sen n irgazen aḏ nihnin wisriqenc lmeƹbed aḏ wiḏƹunc y rṭamiys rebbiywem.<verse eid="ACT 19:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 19:38" />aḏ kan dimitiryus aḏ lliy yiḏes γarsen ckayeṯ, qa γarneγ lemḥakem aḏ lḥukkam. adj areḥen ackan. <verse eid="ACT 19:38" /><verse number="39" style="v" sid="ACT 19:39" />aḏ kan γarwem ckayeṯ iḍen. rahiy yexs ḥekmen felles g lmejles ḥeqqani. <verse eid="ACT 19:39" /><verse number="40" style="v" sid="ACT 19:40" />naγ anemḥakem lkulna afelxaḍert negga lehrej aḏ neccin wiγernexc ḥaja anemleyem afelxaḍrtis.» <verse eid="ACT 19:40" /><verse number="41" style="v" sid="ACT 19:41" />beƹda mag yuwa ayuh, yuwayasen aruḥen.<verse eid="ACT 19:41" /></para>
  <chapter eid="ACT 19" />
  <chapter number="20" style="c" sid="ACT 20" />
  <para style="s">g meqduniya aḏ lyuwnan</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1" />beƹd mag iƹedda lehrej, yesγuy buwlus y tlamḏa. icejƹin aḏ yuwayasen b islema. ireḥ al meqduniya. <verse eid="ACT 20:1" /><verse number="2" style="v" sid="ACT 20:2" />aḏ yeqqim iṭenneḍ diyes yeseƹzam g midden. aḏ g laxer yuṣel al lyuwnan. <verse eid="ACT 20:2" /><verse number="3" style="v" sid="ACT 20:3" />yeqqim diyes 3 chuwr. mniyn yusi ijerra g imanis y terzeft af iylel al suwrya, yesla lliy wuḏeyen smuḏen tatenγen. yaxy yeḏwel al abriyḏ n meqduniya. <verse eid="ACT 20:3" /><verse number="4" style="v" sid="ACT 20:4" />aḏ yerzef yiḏes subeterus memmis n birrus seg biyriya, aḏ rsterxus aḏ sekundus seg tesaluniki, aḏ γayus seg derba, aḏ tixukus aḏ trufimus seg asiya, aḏ timuṯawus. <verse eid="ACT 20:4" /><verse number="5" style="v" sid="ACT 20:5" />aḏ inuh lkul sbeqnaneγ. aḏ sugemneneγ g teruwas. <verse eid="ACT 20:5" /><verse number="6" style="v" sid="ACT 20:6" />neqqim ussan n tfeṣka n tqurset g filibbi. wembeƹd, neqdeƹ iylel aḏ nuṣel al teruwas g 5 d ussanaṯ. aḏ neqqim diyn 7 d ussanaṯ.<verse eid="ACT 20:6" /></para>
  <para style="s">buwlus ysekker tixus g teruwas.</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7" />as n lḥed nemleyem bac anzun aγrum, yuḏel buwlus yetbeccer g midden. aḏ afelxaḍert yesmuḏ terzeft al ača yeqqim ixeṭṭeb al zgenyeḍ. <verse eid="ACT 20:7" /><verse number="8" style="v" sid="ACT 20:8" />aḏ nusi nemleyem g leƹli diyes ggeṯ d inerren sseγan. <verse eid="ACT 20:8" /><verse number="9" style="v" sid="ACT 20:9" />aḏ yusi diyes afrux ismis tixus ygeƹmez g cebbak. yaxy inuddem. yeγlebbi iḍeṣ. yuda seg ṯeleṯ. yemmuṯ mniyn yusi buwlus ydugga. <verse eid="ACT 20:9" /><verse number="10" style="v" sid="ACT 20:10" />yezwa buwlus iγemri yuwa: «wittegeṯec. rahiy wicci diyes rruwḥ.» <verse eid="ACT 20:10" /><verse number="11" style="v" sid="ACT 20:11" />aḏ beƹd mag yuli buwlus izuneneγ aγrum. aḏ yeča. ykemmel dwiys al lefjer. yerzef. <verse eid="ACT 20:11" /><verse number="12" style="v" sid="ACT 20:12" />amma afrux uγentiḏ yedder. aḏ freḥḥen ggeṯ.<verse eid="ACT 20:12" /></para>
  <para style="s">seg teruwas al militus</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13" />amma neccin nerkeb lbabur al ssus lliy tansugem diyes buwlus. we atenwi afelxaḍert yesmuḏ tasedyas yeggur. <verse eid="ACT 20:13" /><verse number="14" style="v" sid="ACT 20:14" />mniyn yiweḍ, nserekbi g lbabur nerzef al lmers n militus. <verse eid="ACT 20:14" /><verse number="15" style="v" sid="ACT 20:15" />aḏ s yin nkemmel terzeft. al ača nƹedda af ljezireṯ n xiyus. aḏ g as wi 3 nƹedda tman ljezireṯ n samusa. aḏ nuṣel g as wis 4 al militus. <verse eid="ACT 20:15" /><verse number="16" style="v" sid="ACT 20:16" />aḏ yusi buwlus yesmuḏ wiyetbeddic g afsus bac wiyetƹeṭṭelc g asiya afelxaḍert yusi yetluffu bac ayeṣel al uwrceliym g tfeṣka n as n 50 beƹd tfeṣka n uƹeddi.<verse eid="ACT 20:16" /></para>
  <para style="s">dwiy n buwlus aḏ lemcayex n afsus</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17" />seg militus yenkiy buwlus yesγuyu y izmimen n lmejmeƹ n lmuminin n afsus. <verse eid="ACT 20:17" /><verse number="18" style="v" sid="ACT 20:18" />mniyn usennesd, yuwayasen:</para>
  <para style="p" vid="ACT 20:18">«tessennem matta ggiγ iḏuwem seg as mezwar lliy uḏeffeγ diyes al asiya. <verse eid="ACT 20:18" /><verse number="19" style="v" sid="ACT 20:19" />rahiy usiγ xedmeγ g rebbiy menγir ckar n imaniw. aḏ s ggeṯ d leƹyaḍ. aḏ neči tƹaniγ seg wuḏeyen. <verse eid="ACT 20:19" /><verse number="20" style="v" sid="ACT 20:20" />aḏ kul ḥaja tafentenfeƹ seḥfeḍγewemted zzaṯ midden aḏ seg lḥuc al lḥuc. <verse eid="ACT 20:20" /><verse number="21" style="v" sid="ACT 20:21" />aḏ usiγ mmeleγ y wuḏeyen aḏ iyuwnaniyen ateben al rebbiy, we aḏemnen s siydneγ yesuwƹ lmesiyḥ.<verse eid="ACT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 20:22" />yuweyiḏ rruwḥ lqudus: &lt; yexs areḥeḏ al uwrceliym. &gt; aḏ wisinnexc matta yesugum diyi dinet. <verse eid="ACT 20:22" /><verse number="23" style="v" sid="ACT 20:23" />lekenti diyma rruwḥ lqudus yemmeliḏ g kul timura udefγes lliy lḥebs aḏ lemcakel ssugumen diyi g uwrceliym. <verse eid="ACT 20:23" /><verse number="24" style="v" sid="ACT 20:24" />amma neči witegiḏexc af imaniw madam xseγ aggeγ lwejbiw we akemleγ lxeḏmeṯ lliy yucited siydneγ yesuwƹ bac acehdeγ we abecreγ s nnaƹmeṯ n rebbiy.<verse eid="ACT 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25" />neči sseneγ lliy maƹedc azrem uḏmiw beƹd as uh. aḏ neči usiγ tendeγ jerewem tbecreγ s lmelkuwt n rebbiy. <verse eid="ACT 20:25" /><verse number="26" style="v" sid="ACT 20:26" />mala qa tafenemleγ as uh: rahiy iḏemnuwem muc g teḵrumtiw <verse eid="ACT 20:26" /><verse number="27" style="v" sid="ACT 20:27" />afelxaḍert ggiγ ljehdiw bac afenseṣleγ matta yexs rebbiy lkul. <verse eid="ACT 20:27" /><verse number="28" style="v" sid="ACT 20:28" />mala rreṯ lbaluwem af imanuwem aḏ af midden lliy yeggiwem rruwḥ lqudus d izmimen fellasen. aḏ rreṯ lbaluwem af lmejmeƹ n lmuminin lliy rebbiy yuca afelxaḍertis iḏemmen n memmis.<verse eid="ACT 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 20:29" />rahiy neči sseneγ lliy beƹd terzeftiw, taḏeḏfen jarewem leḏyub iweƹerren lliy wisexfenc af tulli. <verse eid="ACT 20:29" /><verse number="30" style="v" sid="ACT 20:30" />aḏ midden siwem takren we aseḥefden midden iḥejeyen wiḥlin bac akerekren tlamḏa defferesen. <verse eid="ACT 20:30" /><verse number="31" style="v" sid="ACT 20:31" />afelxaḍert n ayuh, rreṯ lbaluwem yeqƹeḏ. aḏ smitaṯ lliy neči 3 d isuggesen wilbeṭlexc anṣeḥ n midden ggiḍ, uggas, aḏ neči tƹideγ afelxaḍertwem.<verse eid="ACT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32" />ṭuruh tafenedjeγ y rebbiy aḏ nnaƹmeṯ n dwiys. rahiy netta yetquddu ayerni liymanuwem we afenyuc lwerṯ jar lliy mqudsen siyes lkul. <verse eid="ACT 20:32" /><verse number="33" style="v" sid="ACT 20:33" />wiḍmiƹeγ ḥetta d ijuwas g lfejreṯ naγ g wureγ naγ g ṣireḍ s midden. <verse eid="ACT 20:33" /><verse number="34" style="v" sid="ACT 20:34" />aḏ kennim tessennem lliy neči xdemmeγ s ifesniw inuh bac ačaγ we asečeγ lliy iḏiy. <verse eid="ACT 20:34" /><verse number="35" style="v" sid="ACT 20:35" />aḏ siḵenγawem yeqƹeḏ mammeḵ aneg bac anƹawen lliy stehlen ƹewen. we adnesmita dwiy n yesuwƹ lliy yuwa: &lt; lferḥ g uca iṭer n leqqu. &gt; »<verse eid="ACT 20:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36" />aḏ beƹd ayuh yezwa buwlus af ifednis yeqqim yetẓella yiḏesen. <verse eid="ACT 20:36" /><verse number="37" style="v" sid="ACT 20:37" />aḏ ƹiden lkulhum ggeṯ. aḏ γemrent. aḏ beḥbent nyeƹdel.<verse eid="ACT 20:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 20:38" />ḥzennen ggeṯ afelxaḍert yuwayasen lliy maƹedc atezren. aḏ ceyƹent al lbabur.<verse eid="ACT 20:38" /></para>
  <chapter eid="ACT 20" />
  <chapter number="21" style="c" sid="ACT 21" />
  <para style="s">g ṣuwr</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1" />beƹd mag neffeγ s γarsen, nreḥ gedged g leqbeleṯ n kuws. aḏ alača nuṣel al ljezireṯ n rudes. aḏ s yin nreḥ al lmers n batra. <verse eid="ACT 21:1" /><verse number="2" style="v" sid="ACT 21:2" />lliy nufa diyes lbabur tatreḥ al finiyqiya. nerkeb diyes. <verse eid="ACT 21:2" /><verse number="3" style="v" sid="ACT 21:3" />mniyn nusi g lbabur al suwrya teḍhereneγd qubruṣ af lisar. nfeṯiṯ, nuṣel al ṣuwr lliy tafrγen diyes lbabur. <verse eid="ACT 21:3" /><verse number="4" style="v" sid="ACT 21:4" />lweqt ḏḏin, nurzu af tlamḏa. aḏ neqqim yiḏesen 7 d ussanaṯ. aḏ wsiyn neṣḥen g buwlus bac wiyetriḥc al uwrceliym mammeḵ yemmelesen rruwḥ lqudus. <verse eid="ACT 21:4" /><verse number="5" style="v" sid="ACT 21:5" />beƹd mag tkeml ljumƹa, ceyeƹenneγ s tseḏnenesen aḏ ṭarwiwiṯesen al barra n tmura. aḏ nezwa af ifednneγ af cceṭ n iylel neẓẓul. <verse eid="ACT 21:5" /><verse number="6" style="v" sid="ACT 21:6" />nsellem af beƹeḍna, nerkeb. amma nihnin ruḥen al tzaγwinesen.<verse eid="ACT 21:6" /></para>
  <para style="s">g bitulimayes</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7" />aḏ seg ṣuwr nerzef g iylel al bitulimayes lliy neqqim diyes ijuwas yid aweṯen. <verse eid="ACT 21:7" /><verse number="8" style="v" sid="ACT 21:8" />al ača nreḥ al lqeyṣeriya aḏ nezwa d leḍyuf g tzaqqa n filibbus lliy yetbeccer. aḏ netta d yjen seg 7 lliy wezenten g uwrceliym. <verse eid="ACT 21:8" /><verse number="9" style="v" sid="ACT 21:9" />aḏ yusi γares 4 n tmeckenin tiqeyyarin ydugga rebbiy af imewnesneṯ.<verse eid="ACT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 21:10" />neqqim γares ussan. mniyn nella diyn yuseneγd yjen seg indin lliy ydugga rebbiy af imewnesen ismis aγabuws. aḏ netta seg lyehuwdiya. <verse eid="ACT 21:10" /><verse number="11" style="v" sid="ACT 21:11" />iqam leḥzam n buwlus. yeqqen ifesnis al idernis siyes. yuwa: «yemmal rruwḥ lqudus lliy bab n ayuh n leḥzam tatketfen wuḏeyen amyuh g uwrceliym, we atucen y lliy muc d wuḏeyen.» <verse eid="ACT 21:11" /><verse number="12" style="v" sid="ACT 21:12" />mniyn nesla ayuh nuḏel neccin aḏ lliy ḥderren diyn nemmal y buwlus witreḥec al uwrceliym. <verse eid="ACT 21:12" /><verse number="13" style="v" sid="ACT 21:13" />leken netta yuweyaneγ: «cbikum tetƹidem aḏ tseḥeqmiḏ g lufeḏiw? neči muc rliγ bac alketfen g uwrceliym akehaw, amma rliγ zada bac ametteγ diyes afelxaḍert n ysem n yesuwƹ siydneγ.»<verse eid="ACT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 21:14" />mniyn winqudc asenbeddel rreyis, nsusem. aḏ nuwa: «adj ayeg rebbiy matta yexs.»<verse eid="ACT 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15" />aḏ beƹd ussan, nejra imanneγ y terzeft. aḏ nreḥ al uwrceliym. <verse eid="ACT 21:15" /><verse number="16" style="v" sid="ACT 21:16" />raḥen iḏenneγ tlamḏa seg lqeyṣeriya bac aγenuyen al tzaqqa n menasuwn qubruṣiy lliy netta d telmiḏ d qdim.<verse eid="ACT 21:16" /></para>
  <para style="s">g uwrceliym</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17" />mniyn nuṣel al uwrceliym freḥḥen sineγ aweṯen. <verse eid="ACT 21:17" /><verse number="18" style="v" sid="ACT 21:18" />al ača ireḥ iḏenneγ buwlus bac anleqa yeƹquwb. aḏ wsiyn izmimen n lmejmeƹ lkul ḥderren. <verse eid="ACT 21:18" /><verse number="19" style="v" sid="ACT 21:19" />ysellem fellasen buwlus aḏ yuḏel yduggeyasen af mag yeggi rebbiy jar lliy muc d wuḏeyen af ifesnis. <verse eid="ACT 21:19" /><verse number="20" style="v" sid="ACT 21:20" />mniyn slen lliy yuwa, ḥmeḏḏen rebbiy. aḏ uwanas: «tezriḏ cek ayya aweṯeneγ lliy umennen seg wuḏeyen d lelaf aḏ lkulhum neγren af cceriyƹeṯ n muwsa. <verse eid="ACT 21:20" /><verse number="21" style="v" sid="ACT 21:21" />slen lliy cek temeleḏ y wuḏeyen lliy rzeffen: adjen cceriyƹeṯ n muwsa, aḏ maƹedc addehren ṭarwesen, we abeṭlen leƹweyeḏ tiqdimin.<verse eid="ACT 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 21:22" />mammeḵ taneg zeγ, aḏ nihnin labudda taslen lliy cek tusid al deh? <verse eid="ACT 21:22" /><verse number="23" style="v" sid="ACT 21:23" />mala agg lliy tafenmel felles; rahiy γarneγ 4 n irgazen uƹeḏen rebbiy. <verse eid="ACT 21:23" /><verse number="24" style="v" sid="ACT 21:24" />awyin treḥḥeḏ al lheykel. ƹuwum cek yiḏesen bac asebbeƹḏ. aḏ ḏfeƹ lḥeq n uγerreƹ n ixfewnesen, bac asennen midden lkul lliy dwiy lliy slent fellaḵ d tikerkas. aḏ lliy cekkin am nihnin debƹeḏ g abriyḏ n cceriyƹeṯ.<verse eid="ACT 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 21:25" />aḏ mammeḵ tesenneḏ nenkiy y lmumnin lliy muc d wuḏeyen lejwab. netweṣṣa disen bac abeṭlen uču n teγrest lliy y leṣnam, aḏ uču n iḏemmen, aḏ uču n yessum n lḥiwan lliy yexneq aḏ abeṭlen zna.»<verse eid="ACT 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26" />al ača yewya buwlus aydin n 4 n irgazen. aḏ beƹd mag ƹewmen lkulhum, yuḏef al lheykel bac aymel lemmi takemlen ussan n sebbeƹ bac aḏucen teγrest n kul yjen sisen.<verse eid="ACT 21:26" /></para>
  <para style="s">iṭṭaf n buwlus</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27" />mniyn ḥeḍerbac takemlen 7 d ussanaṯ, zren lbeƹḍ n wuḏeyen seg asiya buwlus g lheykel. yaxy ḥercen diyes midden. aḏ ṭṭefent. <verse eid="ACT 21:27" /><verse number="28" style="v" sid="ACT 21:28" />aḏ nihnin wsiyn tṣedƹen: «fezƹeṯ ayya aṯ israyil. rahiy d wuh d argaz lliy yetḍeyƹ g midden g imuḵan lkul s diyn d lexṭer af middenneγ aḏ cceriyƹteneγ aḏ af ayuh n mkan. aḏ iṭer n ayuh rahiy yseḏef iyuwnaniyen al lheykel aḏ ysenjes ayuh n mkan meqdus.» <verse eid="ACT 21:28" /><verse number="29" style="v" sid="ACT 21:29" />afelxaḍert zren yiḏes g tmura trufimus lliy seg afsus, ḥsebent yseḏfi yiḏes al lheykel.<verse eid="ACT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30" />ƹlewleh kkeren midden n temura lkul hjemen af buwlus bac ateṭeṭefen. aḏ sefγent seg lheykel aḏ ṣleḥḥen lbiban. <verse eid="ACT 21:30" /><verse number="31" style="v" sid="ACT 21:31" />mniyn ḥeḍrbac tatenγen, yesla lqayed n laf lliy lehrej g uwrceliym lkul. <verse eid="ACT 21:31" /><verse number="32" style="v" sid="ACT 21:32" />yaxy yewya iƹesekriyen aḏ lquyyad n almiyyaṯ ireḥasen fiseƹ.</para>
  <para style="p" vid="ACT 21:32">mniyn zrent midden am idin beṭlen iwat n buwlus. <verse eid="ACT 21:32" /><verse number="33" style="v" sid="ACT 21:33" />ireḥḥas lqayed n lef. yeṭṭefi. aḏ yuwa y iƹesekriyen atnezγen s tseleslin. aḏ yeqqim yesestun: «d mam netta. aḏ matta yeggi.» <verse eid="ACT 21:33" /><verse number="34" style="v" sid="ACT 21:34" />aḏ wsiyn kul yjen yemmalas ḥaja. mniyn wiqudc aysel we yefhem afelxaḍert diyes lehrej ggeṯ, yuwayasen atuyen al lmuƹesker. <verse eid="ACT 21:34" /><verse number="35" style="v" sid="ACT 21:35" />mniyn uṣellen siyes al druj qament bac atsemenƹen seg iwat n midden lliy dduzun. <verse eid="ACT 21:35" /><verse number="36" style="v" sid="ACT 21:36" />aḏ wsiyn debƹen disen aḏ tṣedƹen: «nγet.»<verse eid="ACT 21:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37" />qebbel man ayeḏef buwlus al lmuƹesker, yuwa s leγweṯ n lyuwnan y lqayed n lef: «tqudduγ afemleγ ḥaja?»</para>
  <para style="p" vid="ACT 21:37">yaxy yuwayas lqayed: «teddugiḏ leγweṯ n lyuwnan? <verse eid="ACT 21:37" /><verse number="38" style="v" sid="ACT 21:38" />mala muc d cek d aydin n umiṣri lliy yeggi lehrej g tmura seg lemmi, aḏ yeffeγ al lexla s 4000 d lmujermin lliy neqen g midden.» <verse eid="ACT 21:38" /><verse number="39" style="v" sid="ACT 21:39" />yaxy yuwa buwlus: «aha, neči d uḏay seg ṭersuws. aḏ nettaṯ d temura temeqqart g ljiheṯ n kilikiya. γari lḥeq am iruwmiyen. aggeḏ lemruweṯ, djiḏ aḏuflayeγ y midden.»<verse eid="ACT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 21:40" />yaxy yedjiy. yebbed buwlus af druj ycala s fusis y midden bac asusmen. mniyn susmen yuḏel yduggeyasen s leγweṯ teƹebrenit, yemmal:<verse eid="ACT 21:40" /></para>
  <chapter eid="ACT 21" />
  <chapter number="22" style="c" sid="ACT 22" />
  <para style="s">defeƹ n buwlus zzaṯ wuḏeyen</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1" />«ayya aweṯen, ayya iḏbaba, sseγdeṯ ṭuruh difeƹiw af imaniw.» <verse eid="ACT 22:1" /><verse number="2" style="v" sid="ACT 22:2" />mniyn ufent yduggeyasen s leγweṯ teƹebrenit, rnin susmen. yaxy yuwa:<verse eid="ACT 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 22:3" />«neči d uḏay, luleγd g ṭersuws lliy tella g kilikiya. lekenti turebbiγ g ayuh n tmura. aḏ ƹzemmeγ af γemelayil terbiyeṯ n cceriyƹeṯ n ibabnneγ. aḏ usiγ witeqqexc g rebbiy am kennim ṭuruh.<verse eid="ACT 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 22:4" />aḏ usiγ durruγ g ayuh n abriyḏ. aḏ xseγ anγeγ lliy debƹen diyes; tezeleγ deffer irgazen aḏ tseḏnan aḏ tegexten g lḥebs. <verse eid="ACT 22:4" /><verse number="5" style="v" sid="ACT 22:5" />rrayes n lkuhhan aḏ izmimen d cuhhaḏ af ayuh n dwiy. rahiy awyiγ s γarsen lejwabaṯ al yeṯmesen g dimecq bac alƹewnen af iṭṭaf n indin lliy diyn. we atendeγeγ al uwrceliym bac atuƹeqben. <verse eid="ACT 22:5" /><verse number="6" style="v" sid="ACT 22:6" />zzel, mniyn ḥeḍerbac tadeṣleγ al dimecq, iwelƹej fella ddu d meqqar seg ujenna. <verse eid="ACT 22:6" /><verse number="7" style="v" sid="ACT 22:7" />yaxy udiγ af tammurt. aḏ sliγ ṣṣut yemmeliḏ: &lt; cawel, cawel, maγer tḍelmeḏ diyi. &gt;<verse eid="ACT 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 22:8" />rriγas: &lt; d mam cek ay siydneγ. &gt; yuwa: &lt; neči d yesuwƹ nnaṣiriy lliy tḍelmeḏ diyes. &gt; <verse eid="ACT 22:8" /><verse number="9" style="v" sid="ACT 22:9" />aḏ lliy wsiyn iḏiy zren ddu. amma wislinc ṣṣut lliy yduggeyiḏ.<verse eid="ACT 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 22:10" />yaxy sesetneγ: &lt; matta aggeγ ay siydneγ?&gt;</para>
  <para style="p" vid="ACT 22:10">yerriḏ: &lt; kker aḏef al dimecq aḏ diyn tafemlen man aggeḏ. &gt; <verse eid="ACT 22:10" /><verse number="11" style="v" sid="ACT 22:11" />aḏ nzeγniḏ lliy iḏiy seg fusiw afelxaḍert usiγ wizerrexc beƹd mag zriγ aydin n ddu lliy ijehher.<verse eid="ACT 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12" />yusi g dimecq argaz ismis ḥenaniya iteggeḏ seg rebbiy mammeḵ tuwa cceriyƹeṯ aḏ cekren diyes wuḏeyen n dimecq. <verse eid="ACT 22:12" /><verse number="13" style="v" sid="ACT 22:13" />yusiḏd. yebbed. yuwa: &lt; ayya uwa cawel smuqel. &gt; yaxy ḏwelleγ zerreγ. aḏ zrixt zzaṯiw. <verse eid="ACT 22:13" /><verse number="14" style="v" sid="ACT 22:14" />aḏ yuwa: &lt; rebbiy n ibabnenneγ iwezayeḵ bac asneḏ matta yexs we azreḏ weddin lliy d ḥeqqani we asleḏ ṣṣutis. <verse eid="ACT 22:14" /><verse number="15" style="v" sid="ACT 22:15" />rahiy tastedleḏ d ccehed bac amleḏ y midden lkul af lliy tezrit aḏ teslit. <verse eid="ACT 22:15" /><verse number="16" style="v" sid="ACT 22:16" />amma ṭuruh matta tesugumeḏ? kker bac attuzizdiḏ. aḏ zelz ibekkaḍniḵ, teḍelbeḏ s ismis bac afyeγfer rebbiy. &gt;<verse eid="ACT 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17" />beƹd ayuh, rriγd al uwrceliym. mniyn usiγ tẓalliγ g lheykel feγeγ seg ayuh n ddunyeṯ. <verse eid="ACT 22:17" /><verse number="18" style="v" sid="ACT 22:18" />yaxy zriγ siydneγ yemmeliḏ: &lt; ffeγ fiseƹ seg uwrceliym. rahiy middenis wilγisenc abecreḏ siyi. &gt;<verse eid="ACT 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 22:19" />awiγas: &lt; ay siydneγ rahiy ssenen lliy neči usiγ ruzzuγ g lemjameƹ af lliy umennen siyeḵ bac atenḥebseγ we atenwetteγ s ṣṣut. <verse eid="ACT 22:19" /><verse number="20" style="v" sid="ACT 22:20" />aḏ ḥderreγ mniyn yemmuṯ istifanus lliy yetbeccer siyeḵ. aḏ rliγ af tmenγiwtis. aḏ ƹusseγ af leḥweyej n lliy nγent. &gt;<verse eid="ACT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 22:21" />lekenti yeweyiḏ: &lt; kker tafnekyeγ yebƹeḏ, al midden iḍen muc d wuḏeyen. &gt; »<verse eid="ACT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22" />aḏ wsiyn midden seγdan g mag yemmal. amma mniyn yuflay af midden lliy muc d wuḏeyen, ṣedƹen: «nγ ayuh n argaz, wiyestehelc temeddurt.» <verse eid="ACT 22:22" /><verse number="23" style="v" sid="ACT 22:23" />aḏ uḏellen tṣeyḥen aḏ tcalan s leḥweyjesen aḏ tcetƹen g ijdi al nnaj.<verse eid="ACT 22:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 22:24" />yaxy yuwa lqayed n laf y iƹesekrinis aseḏfen buwlus al jaj, we atwetten s ṣṣuwṭ bac asennen maγer midden tṣeyḥen amyuh.<verse eid="ACT 22:24" /></para>
  <para style="s">buwlus d ruwmey</para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 22:25" />mniyn qqenent bac atwetten, yuwa buwlus y lqayed n 100 lliy tmas: «yaxy yettesed siyes g lqanuwn n ruwma iwat n yjen d ruwmey qebbel man aḥekmem fellas.»<verse eid="ACT 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 22:26" />mniyn yesla lqayed n 100 aydin, ireḥ al lliy anjis yuwa: «matta tetteggeḏ cek? ayuh n argaz d ruwmey.»<verse eid="ACT 22:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 22:27" />yaxy ireḥ bac ayṯebbet weḥdes. aḏ ysesten buwlus: «cek nembelḥeq d ruwmey.» yuwayas «ayya.»<verse eid="ACT 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 22:28" />yaxy yuwa lqayed n lef: «neči ḏfeƹƹeγ ggeṯ d iflusen bac aḏuleγ d ruwmani.» yaxy yuwa buwlus: «neči luleγd d ruwmani.»<verse eid="ACT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 22:29" />lweqt ḏḏin bƹeḏḏen felles iƹesekriyen lliy wsiyn tatwetten. aḏ mniyn iṯebbet lqayed n laf lliy netta d ruwmey, yugeḏ ggeṯ afelxaḍert iketfi s tseleslin.<verse eid="ACT 22:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30" />al ača, yesγuy lqayed n laf af imeqqaren n lkuhhan aḏ lliy g lmejles, bac ayessen leḥqiqeṯ n buwlus lliy imiras iqqanis aḏ ysebeddi zzaṯesen.<verse eid="ACT 22:30" /></para>
  <chapter eid="ACT 22" />
  <chapter number="23" style="c" sid="ACT 23" />
  <para style="s">buwlus zzaṯ lmejles n wuḏeyen</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1" />yesmuqel buwlus al lmejles, yuwa: «ay ya yeṯma. rahiy ḏbeƹeγ rebbiy s uliw aḏ nnitiw al ssuh.»<verse eid="ACT 23:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 23:2" />yaxy yuwa ḥenaniya rrayes n lkuhhan y yjen seg indin lliy bbedden tmas aywet buwlus af imis. <verse eid="ACT 23:2" /><verse number="3" style="v" sid="ACT 23:3" />yuwayas buwlus: «afiwet rebbiy, ayya lliy yezƹem s barra, cqal cek tgeƹemzeḏ bac aḥekmeḏ s cceriyƹeṯ. yaxy txelfeteṯ aḏ tuwidasen alwetten.»<verse eid="ACT 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4" />uwanas lliy bbedden dinet: «yenda tedeƹuḏ g rrayes n lkuhhan n rebbiy.» <verse eid="ACT 23:4" /><verse number="5" style="v" sid="ACT 23:5" />yerrasen buwlus: «rahiy wisinnexc lliy netta d rrayes n lkuhhan, ayya yeṯma. yetweri g lektab: &lt; wideƹƹuc y rrayes n cceƹbiḵ. &gt; »<verse eid="ACT 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6" />afelxaḍert buwlus yusi yessen lliy g lmejles iṣedduwqiyiyen aḏ iferryisiyen, iṣeddeƹ: «ay y yeṯma, neči d ferryisi memmis n ferryisi aḏ ṭuruh taḥekmen fella afelxaḍert temneγ lliy diyes tneḵri beƹd temettent.»<verse eid="ACT 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 23:7" />mniyn slen ayuh n dwiy, yuqeƹ xaṣem jar iṣedduwqiyiyen n lmejles aḏ iferryisiyenis. aḏ mzunen af sen, <verse eid="ACT 23:7" /><verse number="8" style="v" sid="ACT 23:8" />afelxaḍert iṣedduwqiyiyen witemnenc s tneḵri aḏ lmleyka aḏ lerwaḥ. amma iferryisiyen temnen sisen lkul. <verse eid="ACT 23:8" /><verse number="9" style="v" sid="ACT 23:9" />yuli ṣyaḥ, aḏ bbedden lbeƹḍ n lliy seḥfeḍen g cceriyƹeṯ seg iferysiyyen uwan: «γarneγ neccin, ayuh n argaz wiyeggi ḥaja, balek yuflayas rruwḥ naγ lmleyka.»<verse eid="ACT 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 23:10" />yerniy nuγu jaresen almiy yugeḏ lqayed n laf zunen buwlus af sen. yaxy yuwa y iƹesekriyen azwan we atxedfen we aterren al lmuƹesker. <verse eid="ACT 23:10" /><verse number="11" style="v" sid="ACT 23:11" />iddin, yeḍherred siydneγ y buwlus yuwayas: «witeggac. rahiy mammeḵ techeḏdiḏ g uwrceliym taltcehdeḏ g ruwma zada.»<verse eid="ACT 23:11" /></para>
  <para style="s">wuḏeyen smuḏen tanγen buwlus.</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12" />tajji, mfehmen lbeƹḍ n wuḏeyen af tmenγiwtis. aḏ djullen: «wintet winses kan almiy nenγi.» <verse eid="ACT 23:12" /><verse number="13" style="v" sid="ACT 23:13" />aḏ inuh wsiyn iṭer n 40. <verse eid="ACT 23:13" /><verse number="14" style="v" sid="ACT 23:14" />reḥḥen al imeqqaren n lkuhhan aḏ iwasseren. aḏ djullen: «rahiy winetḏeweq ḥetta ciy kan almiy nenγi.» <verse eid="ACT 23:14" /><verse number="15" style="v" sid="ACT 23:15" />aḏ kennim lliy d ixfewen n lmejles tetqudum amlem y lqayed n laf afentiḏyenkiy ača. we arrem imanuwem tatsestnem yeqƹeḏ. we atnenγ neccin qebbel man ayeṣel al deh.<verse eid="ACT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16" />lekenti ayuh n lexber yesla siyes memmis n xutis n buwlus. yaxy ireḥḥas al lmuƹesker. yuwayas af mag smuḏnas. <verse eid="ACT 23:16" /><verse number="17" style="v" sid="ACT 23:17" />aḏ yesγuy buwlus af yjen seg lquyyad n almiyyaṯ. yuwayas aywiy aydin n umezyan al lqayed n laf bac asimel af ḥaja.<verse eid="ACT 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 23:18" />yaxy yewyi. aḏ yuwa y lqayed n lef: «yesγuyiḏ meḥbus buwlus. yuweyiḏ afdeγeγ ayuh n umezyan afelxaḍert γares man afimel.»<verse eid="ACT 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 23:19" />yeṭṭef lqayed n laf amezyan diyn seg fusis qqimen weḥdesen, yuwayas: «matta texseḏ altemleḏ.»<verse eid="ACT 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20" />yerras: «rahiy wuḏeyen smuḏen tanγen buwlus. aḏ tafemlen asentiḏerreḏ. we arren imanesen taƹewden atsesetenen yeqƹeḏ. <verse eid="ACT 23:20" /><verse number="21" style="v" sid="ACT 23:21" />wisentiḏugeyc afelxaḍert iṭer n 40 d irgazen djullen witeten wisesen kan almiy nγent. aḏ jren imanesen bac atenγen. aḏ ṭuruh ssugumen asentiḏuyeḏ.»<verse eid="ACT 23:21" /></para>
  <para style="s">liysiyas yenkiy buwlus al filiks</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 23:22" />yenkiy lqayed n laf amezyan ayreweḥ beƹd mag yuwayas: «wimmal y ḥed af lliy tewidiḏ.»<verse eid="ACT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23" />aḏ yesγuy y sen seg lquyyad n almiyyaṯ yuwayasen: «jreṯ mitin d iƹesekriyen bac areḥen al lqeyṣeriya g ttesƹa n ggiḍ. aḏ yiḏesen 70 seg lfursan aḏ mitin seg indin lliy tḥereben s rrumḥ. <verse eid="ACT 23:23" /><verse number="24" style="v" sid="ACT 23:24" />aḏ zwayel y userkeb n buwlus bac ayeṣel labas al lḥakem filiks.»<verse eid="ACT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 23:25" />aḏ yuri y lḥakem lejwab yemmal diyes:<verse eid="ACT 23:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 23:26" />«seg kuludiyus liysiyas slam al lḥakem meqqar filiks.<verse eid="ACT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 23:27" />ayuh n argaz ṭṭefent wuḏeyen. aḏ smuḏen tatenγen. aḏ sliγ lliy netta d ruwmey, reḥḥeγ fiseƹ neči aḏ iƹesekriyen semenƹext. <verse eid="ACT 23:27" /><verse number="28" style="v" sid="ACT 23:28" />aḏ uwyixt al lmejlesesen bac asneγ tuhemtis. <verse eid="ACT 23:28" /><verse number="29" style="v" sid="ACT 23:29" />aḏ ufiγ lliy netta methum s uṯƹeddi af cceriyƹeṯ n muwsa. amma yeḍherriḏd lliy netta wiyeggi ḥaja bac ayetweḥbes naγ ayemmunγ.<verse eid="ACT 23:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 23:30" />aḏ sliγ lliy wuḏeyen smuḏen tatenγen. yaxy nkiyγeḵtiḏ ƹlewleh. aḏ uwiγ y lliy ckan siyes adesen ackan γareḵ. afyedj rebbiy.»<verse eid="ACT 23:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31" />amyuh awyen iƹesekriyen buwlus ggiḍ al antiybetris mammeḵ yuwayasen lqayed n lef. <verse eid="ACT 23:31" /><verse number="32" style="v" sid="ACT 23:32" />aḏ tajji rrend al lmuƹesker. aḏ djen lfursan areḥen yid buwlus. <verse eid="ACT 23:32" /><verse number="33" style="v" sid="ACT 23:33" />mniyn uṣellen al lqeyṣeriya, ucent y lḥakem netta aḏ lejwab.<verse eid="ACT 23:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 23:34" />yeƹzem lejwab. aḏ ysesten buwlus af lebladis. mniyn yesla lliy netta seg kilikiya, <verse eid="ACT 23:34" /><verse number="35" style="v" sid="ACT 23:35" />yuwayas: «taḥekreγ lmuckeltiḵ almiy usend lliy tackan siyeḵ.» aḏ yuwa y iƹesekriyinis aggen buwlus g leqṣer n hiyruwdus we aƹussen felles.<verse eid="ACT 23:35" /></para>
  <chapter eid="ACT 23" />
  <chapter number="24" style="c" sid="ACT 24" />
  <para style="s">ckeyeṯ n wuḏeyen s buwlus</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1" />aḏ beƹd 5 d ussanaṯ, usend al lqeyṣeriya midden diyes jaresen: ḥenaniya rrayes n lkuhhan aḏ lbeƹḍ n iwessaren aḏ lmuḥami ismis tertullus bac ackan y lḥakem s buwlus. <verse eid="ACT 24:1" /><verse number="2" style="v" sid="ACT 24:2" />yaxy yesγuy lḥakem y buwlus. aḏ yuḏel tertullus yetehhem diyes, yuwa:</para>
  <para style="p" vid="ACT 24:2">«rahiy d cek lliy tuγideneγd slam, aḏ s γareḵ ayuh n lxiyr lliy yella diyes cceƹb. <verse eid="ACT 24:2" /><verse number="3" style="v" sid="ACT 24:3" />afelxaḍert n ayuh lkul, nerla. aḏ wintetuc lfeḍliḵ diyma aḏ g imuḵan lkul. <verse eid="ACT 24:3" /><verse number="4" style="v" sid="ACT 24:4" />bac wifetqelqexc s dwiy ggeṯ, qa ayuh d ckeyteneγ; aggeḏ lemruweṯ seγdeneγ: <verse eid="ACT 24:4" /><verse number="5" style="v" sid="ACT 24:5" />nufa ayuh n argaz yesefsaḏ. aḏ tayeg nuγu jar wuḏeyen g ddunyeṯ lkul. aḏ netta d zmim n lmeḏheb n nnaṣirey. <verse eid="ACT 24:5" /><verse number="6" style="v" sid="ACT 24:6" />mniyn yesmuḏ aynejjes lheykel, neṭṭefi. aḏ nesmuḏ tatenḥekem af leḥsab n cceriyƹeteneγ. <verse eid="ACT 24:6" /><verse number="7" style="v" sid="ACT 24:7" />lekenti liysiyas lqayed n laf yused yewyi seg ifesnenneγ b ssiyf. <verse eid="ACT 24:7" /><verse number="8" style="v" sid="ACT 24:8" />aḏ yuwa y lliy tackan siyes adesen ackan zzaṯiḵ. aḏ tetqudduḏ weḥdeḵ ṭuruh asneḏ leḥqiqtis lkul, kan atsestneḏ af ayuh.» <verse eid="ACT 24:8" /><verse number="9" style="v" sid="ACT 24:9" />aḏ rnin wuḏeyen lliy usend lkul uwan am idin.<verse eid="ACT 24:9" /></para>
  <para style="s">defeƹ n buwlus zzaṯ filiks</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10" />ihuz lḥakem ixfis y buwlus bac aydefeƹ af imanis. yaxy yuwa:</para>
  <para style="p" vid="ACT 24:10">«neči sseneγ lliy cek tḥekmeḏ jarenneγ seglemi, aḏ freḥeγ lliy tadefƹeγ af imaniw zzaṯiḵ.<verse eid="ACT 24:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 24:11" />aḏ cek tetqudduḏ asneḏ lliy wiγri kan 12 d ussanaṯ g uwrceliym lliy usiγesd y tẓalliṯ. <verse eid="ACT 24:11" /><verse number="12" style="v" sid="ACT 24:12" />aḏ wilyezri ḥetta d yjen seg wuḏeyen xlaṣ g lheykel tkecaḥeγ naγ g lemjameƹ aḏ tmura mmeleγ y midden aggen lehrej. <verse eid="ACT 24:12" /><verse number="13" style="v" sid="ACT 24:13" />aḏ nihnin witquddunc afsiḵnen ṭuruh lliy matta mmelent fella nembelḥeq.<verse eid="ACT 24:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 24:14" />lekenti tasteƹerfeγ zzaṯiḵ lliy neči tẓalliγ y rebbiy n ibabniw feleḥsab n lmeḏheb lliy mmelen fellas d lbedƹeṯ. aḏ lliy neči temneγ s lliy yetweri g cceriyƹeṯ aḏ lektub n lenbiya. <verse eid="ACT 24:14" /><verse number="15" style="v" sid="ACT 24:15" />aḏ γari ṯṯiqeṯ g rebbiy mammeḵ nihnin γarsen ṯṯiqeṯ diyes, lliy netta taysekker lliy mmuṯen lkul, ṣbiḥen aḏ lliy wiḥlin. <verse eid="ACT 24:15" /><verse number="16" style="v" sid="ACT 24:16" />afelxaḍert n aydin teggeγ g ljehdiw bac adreγ diyma s ul d ṣbiḥ zzaṯ rebbiy aḏ midden.<verse eid="ACT 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17" />beƹd isuggesen, rriγd al uwrceliym aḏ iḏiy iflusen y uƹewen n cceƹbiw aḏ bac aḏuceγ teγrest y rebbiy. <verse eid="ACT 24:17" /><verse number="18" style="v" sid="ACT 24:18" />mniyn usiγ g lheykel, zren matta teggeγ lbeƹḍ n wuḏeyen seg asiya. aḏ neči lweqt ḏḏin usiγ zizdiyeγ. aḏ widdic midden mlaymen fella. aḏ widdusixc teggeγ g lehrej.<verse eid="ACT 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 24:19" />lukan mag mmelent nembelḥeq. rahiy usend ckanaḵ siyi mammeḵ lmeḏḏen midden teggen. <verse eid="ACT 24:19" /><verse number="20" style="v" sid="ACT 24:20" />ṭuruh mmel y inuh afemlen af bekkeḍu lliy ṯebtent fellamnin bbeddeγ azzaṯ lmejlesesen, <verse eid="ACT 24:20" /><verse number="21" style="v" sid="ACT 24:21" />bexlaf mag uwixt neči mniyn ṣedƹeγ jaresen: &lt; kennim taletḥekmem as wuh afelxaḍert temneγ s tneḵri n lliy mmuṯen. &gt; »<verse eid="ACT 24:21" /></para>
  <para style="s">buwlus g lḥebs n lqeyṣeriya</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22" />filiks lliy yusi yessen ayuh n abriyḏ, mniyn yesla dwiy n buwlus, yedja lḥukem al lweqt iḍen. aḏ yuwa y lliy usend ackan: «taḥekmeγ jarewem almiy yused lqayed liysiyas.» <verse eid="ACT 24:22" /><verse number="23" style="v" sid="ACT 24:23" />aḏ yuwa y lqayed n 100 ayeg buwlus adug ƹussu. we aydel γares fercu n lḥurriyeṯ. we adjen irnewnis asdesen we aseggen mag yexs.<verse eid="ACT 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24" />beƹd ussan yused filiks aḏ yiḏes lehlis lliy tusi d tuḏeyt aḏ ismis drussila. yesγuy y buwlus. aḏ yeqqim yeseγda g dwiys af liyman s lmesiyḥ yesuwƹ. <verse eid="ACT 24:24" /><verse number="25" style="v" sid="ACT 24:25" />mniyn yuflay buwlus af lḥeq aḏ iṭṭaf n bnaḏem y imanis af ccer, aḏ af leḥsab lliy tadyas, yerjij filiks. aḏ yuwa y buwlus: «ureḥ ṭuruh. aḏ almiy ufiγ lweqt tafesγuyeγ tijekkelt iḍen.» <verse eid="ACT 24:25" /><verse number="26" style="v" sid="ACT 24:26" />aḏ yusi filiks yeḍmeƹ tasyeḏfeƹ buwlus iflusen bac atiseyyeb. aḏ yeqqim yesγuyuyas seƹat. aḏ ydugga yiḏes.<verse eid="ACT 24:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 24:27" />ydja filiks buwlus g lḥebs sen isuggesen afelxaḍert yexs arlan fellas wuḏeyen. wembeƹd yused lḥakem iḍen ismis burkiyus festus.<verse eid="ACT 24:27" /></para>
  <chapter eid="ACT 24" />
  <chapter number="25" style="c" sid="ACT 25" />
  <para style="s">buwlus yeḍleb ƹeweḏ n lḥukem zzaṯ lqeyṣer</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1" />beƹd mag yuṣel festus al lqeyṣeriya s 3 d ussanaṯ, ireḥ al uwrceliym. <verse eid="ACT 25:1" /><verse number="2" style="v" sid="ACT 25:2" />yaxy usend imeqqaren n lkuhhan aḏ imeqqaren n wuḏeyen ckanas s buwlus. <verse eid="ACT 25:2" /><verse number="3" style="v" sid="ACT 25:3" />aḏ jahanas asentiḏyeγ al uwrceliym. aḏ smuḏen tatenγen g ubriḏ. <verse eid="ACT 25:3" /><verse number="4" style="v" sid="ACT 25:4" />yaxy yuwayasen festus lliy buwlus yexs ayeqqim g lḥebs n lqeyṣeriya, aḏ lliy netta tayeḏwel al diyn fiseƹ. <verse eid="ACT 25:4" /><verse number="5" style="v" sid="ACT 25:5" />aḏ yuwa: «areḥen iḏiy imeqqernuwem aḏ ken ayuh n argaz γares bekkeḍu yexs attehmen siyes zzaṯiw.»<verse eid="ACT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6" />yeqqim festus g uwrceliym 8 naγ 10 d ussanaṯ, yeḏwel beƹdesen al lqeyṣeriya. aḏ al ača n iṣalis, ygeƹmez bac ayeḥkem aḏ yuwayasen adeγen buwlus. <verse eid="ACT 25:6" /><verse number="7" style="v" sid="ACT 25:7" />mniyn uγentiḏ, mleymen fellas wuḏeyen lliy usend seg uwrceliym. aḏ tehment ggeṯ menγir man aḏucen ḥetta d lemereṯ. <verse eid="ACT 25:7" /><verse number="8" style="v" sid="ACT 25:8" />yaxy yuflay buwlus, aḏ ydafeƹ af imanis: «wiggixc bekkeḍu g lḥeq n cceriyƹeṯ n wuḏeyen, naγ g lḥeq n lheykel, naγ g lḥeq n lqeyṣer.»<verse eid="ACT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9" />festus lliy yexs arlan fellas wuḏeyen, ysesten buwlus: «texseḏ areḥeḏ al uwrceliym we aḥekmeγ fellaḵ diyn.» <verse eid="ACT 25:9" /><verse number="10" style="v" sid="ACT 25:10" />yerras buwlus: «neči ṭuruh bbeddeγ zzaṯ lmeḥkmeṯ n lqeyṣer, lliy zzaṯis yexs aḥekmem fella. neči wiggiγ ḥaja y wuḏeyen aḏ cek tesenneḏ ayuh nyeƹdel. <verse eid="ACT 25:10" /><verse number="11" style="v" sid="ACT 25:11" />lukan ggiγ ḥaja yexs altenγem afelxaḍris. rahiy wiruglexc seg tmettent. aḏ madam inuh wiγersen ḥetta d tiḥudjet fella ḥetta d jen wiγres lḥeq alyuc y nihnin bac aḥekmen fella. xseγ ateli ckeytiw al lqeyṣer.»<verse eid="ACT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 25:12" />ycawer festus lliy tƹewenen diyes. aḏ yuwa y buwlus: «madam texseḏ atali ckeytiḵ al lqeyṣer, mala al lqeyṣer tareḥeḏ.»<verse eid="ACT 25:12" /></para>
  <para style="s">buwlus aḏ lmelek aγribas.</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13" />beƹd ussan, yused lmelek aγribas aḏ xutis berniki al lqeyṣeriya bac aselmen af festus. <verse eid="ACT 25:13" /><verse number="14" style="v" sid="ACT 25:14" />aḏ qqimen ussan. yaxy yuwa festus y lmelek af lmucekleṯ n buwlus:</para>
  <para style="p" vid="ACT 25:14">«diyes argaz yedjiy filiks g lḥbes. <verse eid="ACT 25:14" /><verse number="15" style="v" sid="ACT 25:15" />mniyn reḥḥeγ al uwrceliym, ckaniḏ siyes imeqqaren n lkuhhan aḏ iwesseren n wuḏeyen. aḏ uwaniḏ: «ḥkem fellas.» <verse eid="ACT 25:15" /><verse number="16" style="v" sid="ACT 25:16" />yaxy uwiγesen rahiy muc d leƹweyeḏ n ruwma lḥukem af yjen qebbel man ayebbed netta aḏ lliy yecka siyes zzaṯ lḥakem bac ayqud aydefeƹ af imanis.<verse eid="ACT 25:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 25:17" />mniyn usend, geƹemzeγ al ača ƹlewleh y lḥukem. aḏ sγuyeγ af buwlus. <verse eid="ACT 25:17" /><verse number="18" style="v" sid="ACT 25:18" />mniyn bbedden bac acken siyes, witehmen s ḥetta ḥaja seg lliy ḍunnext. <verse eid="ACT 25:18" /><verse number="19" style="v" sid="ACT 25:19" />amma kacḥent g lemcakel n ddinesen aḏ af argaz ismis yesuwƹ nihnin mmelen yemmuṯ aḏ netta yemmal yedder. <verse eid="ACT 25:19" /><verse number="20" style="v" sid="ACT 25:20" />yaxy wiḏufiγ mammeḵ aggeγ. aḏ uwiγ y buwlus ayreḥ al uwrceliym bac ayemḥakem diyn. <verse eid="ACT 25:20" /><verse number="21" style="v" sid="ACT 25:21" />lekenti yeḍleb bac ayemḥakem zzaṯ lqeyṣer. yaxy ggiγ fellas iƹessasen almiy atnekyeγ al lqeyṣer.»<verse eid="ACT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22" />yuwa aγribas y festus: «xseγ sleγ mag yemmal ayuh n argaz.» yaxy yerras: «ača taseγdeḏ dwiys.»<verse eid="ACT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23" />aḏ al ača, yurreḏid aγribas aḏ berniki aḏ yiḏesen ggeṯ d lƹesker. seḏfenten al mkan n useγdi. aḏ yiḏesen imeqqaren n midden aḏ lguyyad n lelaf. aḏ yuwa festus aγted buwlus. <verse eid="ACT 25:23" /><verse number="24" style="v" sid="ACT 25:24" />mniyn uγentiḏ, yuwa festus:</para>
  <para style="p" vid="ACT 25:24">«ayya lmelk aγribas, ayya lsiyeḏ lliy ḥderren, qa d wuh argaz lliy ckaniḏ siyes wuḏeyen lkul g uwrceliym aḏ deh. aḏ nihnin tṣedƹen: &lt; nγi. &gt; <verse eid="ACT 25:24" /><verse number="25" style="v" sid="ACT 25:25" />aḏ ufiγ amellaḵ wiyeggi ḥaja yestahel temenγiwt afelxaḍris. lekenti netta yeḍleb bac ayemḥakem zzaṯ lqeyṣer. aḏ smuḏeγ tastiḏnekyeγ.<verse eid="ACT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 25:26" />lekenti wiγri ḥetta ḥaja teṣḥiḥ tqudduγ ateteryeγ y lqeyṣer af lmuckeltis. aḏ uγiγtiḏ al deh zzaṯuwem, aḏ belexeṣ zzaṯiḵ ayya lmelek aγribas, balek aḏafeγ man aḏaryeγ y lqeyṣer beƹd man aslem ckayeṯ. <verse eid="ACT 25:26" /><verse number="27" style="v" sid="ACT 25:27" />afelxaḍert widyettic siyes anekyeγ meḥbus al lqeyṣer menγir man asemlleγ d matta tuhemtis.»<verse eid="ACT 25:27" /></para>
  <chapter eid="ACT 25" />
  <chapter number="26" style="c" sid="ACT 26" />
  <para style="s">buwlus yedefeƹ af imanis zzaṯ aγribas</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1" />yuwa aγribas y buwlus: «qa neseγda, defeƹ af imaniḵ.»</para>
  <para style="p" vid="ACT 26:1">yaxy iqam buwlus fusis yuḏel ydugga, yuwa:<verse eid="ACT 26:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 26:2" />«ay ya lmelek aγribas, freḥeγ lliy tadefƹeγ af imaniw zzaṯiḵ, we arreγ af lliy tehemniḏ siyes wuḏeyen lkul. <verse eid="ACT 26:2" /><verse number="3" style="v" sid="ACT 26:3" />aḏ cek tesenneḏ leƹweydesen aḏ kecḥesen. aggeḏ lemruweṯ wesseƹ lbaliḵ iḏiy.<verse eid="ACT 26:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4" />rahiy wuḏeyen ssenen mammeḵ usiγ, afelxaḍert ddereγ jar middeniw g uwrceliym smanis d meckun. <verse eid="ACT 26:4" /><verse number="5" style="v" sid="ACT 26:5" />aḏ madam ssenniḏ amyuh, lukan xsen lḥeq rahiy cheḏḏen lliy neči d ferryisiyi, debƹeγ g lmeḏheb lliy yuƹer g ddinenneγ. <verse eid="ACT 26:5" /><verse number="6" style="v" sid="ACT 26:6" />aḏ kennim tetḥekamem diyi as uh afelxaḍert ssugumeγ ayeg rebbiy lliy yuƹeḏ siyes ibabnenneγ.<verse eid="ACT 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 26:7" />aḏ wecci leƹcayer 12 n ceƹbenneγ tẓallan ggiḍ uggas, aḏ ssugumen rebbiy ayeg lweƹdis. afelxaḍert n ayuh n usugem tehemniḏ wuḏeyen, ayya lmelek. <verse eid="ACT 26:7" /><verse number="8" style="v" sid="ACT 26:8" />maγer witetemnemc lliy rebbiy taysekker lliy mmuṯen?<verse eid="ACT 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9" />usiγ ḥsabeγ lliy yexs ggeγ ljehdiw g uḥareb n ysem n yesuwƹ nnaṣiriy. <verse eid="ACT 26:9" /><verse number="10" style="v" sid="ACT 26:10" />qqimeγ tḥerebeγ disen g uwrceliym beƹd mag ucenniḏ imeqqaren n lkuhhan lḥeq bac aggeγ ayuh. aḏ ggiγ ggeṯ d lmuminin g lḥebs. aḏ usiγ twefeqeγ almiy cewereniḏ g lmejles af tmenγiwt n yjen sisen. <verse eid="ACT 26:10" /><verse number="11" style="v" sid="ACT 26:11" />aḏ ƹeḏbexten zzaṯ lemjameƹ lkul bac akefren b ssiyf. aḏ kerhexten almiy reḥḥeγ tezeleγ fellasen g tmurewin lliy bƹeḏneṯ.<verse eid="ACT 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12" />mniyn lqiγ seg imeqqaren n lkuhhan lḥeq bac areḥeγ al dimecq g ljurtesen, <verse eid="ACT 26:12" /><verse number="13" style="v" sid="ACT 26:13" />zzel zriγ, ayya lmelek, g ubriḏ ddu yetreq iṭer n ddu n tufuyt yetwelƹej fella aḏ af lliy iḏiy. <verse eid="ACT 26:13" /><verse number="14" style="v" sid="ACT 26:14" />nuda lkulna af tammurt, sliγ ṣṣut yesγuyuyiḏ s leγweṯ teƹebrenit yemmal: &lt; cawel, ay cawel maγer tetḥerebeḏ diyi, al lemmi taqimeḏ teḥreneḏ am aγyul. &gt;<verse eid="ACT 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 26:15" />yaxy sesetneγ &lt;d mam cek ay ya siydi?&gt;</para>
  <para style="p" vid="ACT 26:15">yuweyiḏ: &lt; neči d yesuwƹ lliy tḍelmeḏ diyes. <verse eid="ACT 26:15" /><verse number="16" style="v" sid="ACT 26:16" />kker bbed af iderniḵ. rahiy ḍherγeḵd bac afeggeγ d xdimiw. we adleḏ d ccehed fella s ayuh n tirjelt lliy tezridiḏ diyes ṭuruh, aḏ s tirejlin lliy teltezreḏ disneṯ beƹd as uh.<verse eid="ACT 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 26:17" />rahiy tafsemenƹeγ seg wuḏeyen aḏ seg midden iḍen lliy tafnekyeγ al γarsen ṭuruh, <verse eid="ACT 26:17" /><verse number="18" style="v" sid="ACT 26:18" />bac asentmireḏ ṭiṭewinesen we afγen seg tellest al ddu, aḏ seg lḥukem n cciyḍan al lḥukem n rebbiy, we atweγefren ibekkaḍnesen, we aydel γarsen mkan jar indin lliy ṯqedsen s liymansen siyi. &gt;<verse eid="ACT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19" />aḏ seg lweqt ḏḏin wiggiγ ken mag yuweyiḏ fellas siydneγ g tirjelt, ayya lmelek aγribas. <verse eid="ACT 26:19" /><verse number="20" style="v" sid="ACT 26:20" />uḏelleγ becreγ midden n dimecq, aḏ midden n uwrceliym beƹdesen, aḏ indin n lyehuwdiya lkulha, wembeƹd becreγ ḥetta midden lliy muc d wuḏeyen. aḏ awiγasen lkulhum ateben, we aḏulen al rebbiy we aggen lxiyr bac atṣeḥ ttubtesen.<verse eid="ACT 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 26:21" />aḏ afelxaḍert becreγ lliy muc d wuḏeyen, ṭṭefniḏ wuḏeyen g lheykel aḏ smuḏen talenγen. <verse eid="ACT 26:21" /><verse number="22" style="v" sid="ACT 26:22" />lekenti rebbiy yesteḥfeḍ fella al ssuh. aḏ s uƹewnis netta tbeddiγ zzaṯ iqellilen aḏ zzaṯ imaqqaren d ccehed af lḥeq. aḏ witeffeγeγc af mag yuwa muwsa aḏ lenbiya lkul; <verse eid="ACT 26:22" /><verse number="23" style="v" sid="ACT 26:23" />yuƹeḏ rebbiy tayenkiy lmesiyḥ we ayḥus aγenna. we ayekker d mezwar seg jar lliy mmuṯen. we aybeccer s ddu ceƹbenneγ aḏ midden lliy muc d wuḏeyen.»<verse eid="ACT 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24" />mniyn yuṣel buwlus g ddifaƹis al ayuh n dwiy, iṣeddeƹ festus yuwa: «tehbelleḏ ay buwlus, neƹtis lƹezmiḵ yseheblaḵ.»<verse eid="ACT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 26:25" />yaxy yuwa buwlus: «ayya lḥkem festus neči wihbilexc, neči dduggiγ g dwiy n lḥeq aḏ ṣwab. <verse eid="ACT 26:25" /><verse number="26" style="v" sid="ACT 26:26" />aḏ lmelk lliy duggiγas ṭuruh yessen ayuh n iḥejeyen lliy duggiγ fellasen. aḏ neči sseneγ lliy yesla sisen lkul afelxaḍert wiṣerenc g tellest.<verse eid="ACT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 26:27" />ayya lmelk aγribas, tetemneḏ s lenbiya? neči senneγ lliy cek tetmneḏ sisen.»<verse eid="ACT 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 26:28" />yaxy yerras aγribas: «yenda g ufercu n lweqt texseḏ alterreḏ d lmesiyḥiy.»<verse eid="ACT 26:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 26:29" />yuwa buwlus: «g ggeṯ naγ g frcu n lweqt kifkif. rahiy tẓalliγ y rebbiy afelxaḍriḵ aḏ afelxaḍert n inuh lkul bac ḏulen am neči amma menγir ayuh n tseleslin.»<verse eid="ACT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30" />beƹd ayuh yekker lmelek aḏ lḥakem aḏ berniki aḏ lliy ḥderren. <verse eid="ACT 26:30" /><verse number="31" style="v" sid="ACT 26:31" />ffeγen seg mkan diyn aḏ nihnin mmelen y beƹeḍhum: «ayuh n argaz wiyeggi ḥaja yestahel afelxaḍertis temettent naγ lḥebs.»<verse eid="ACT 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 26:32" />aḏ yuwa aγribas y festus: «lukan muc ayuh n argaz yexs atali ckeytis al lqeyṣer rahiy nseybi.»<verse eid="ACT 26:32" /></para>
  <chapter eid="ACT 26" />
  <chapter number="27" style="c" sid="ACT 27" />
  <para style="s">terzeft al iyṭalya g iylel</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1" />smuḏen anerzef al iyṭalya af iylel. aḏ yusi yetƹussu af buwlus aḏ lbeƹḍ n imeḥbas iḍen lqayed n 100 ismis yulyus seg lfirqeṯ n uγusṭus. <verse eid="ACT 27:1" /><verse number="2" style="v" sid="ACT 27:2" />nerkeb g lbabur tused seg dremita tatenneḍ af lemmerasi n asiya. aḏ ireḥ iḏenneγ rsterxus seg tesaluniki n meqduniya.<verse eid="ACT 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 27:3" />al ača, nuṣel al ṣeyda. aḏ yeggi yulyus ṣbiḥ yid buwlus, yedjiy ayreḥ al leṣḥabis bac asucen matta yexs. <verse eid="ACT 27:3" /><verse number="4" style="v" sid="ACT 27:4" />aḏ neffeγ seg ṣeyda g iylel af cceṭ g ttega n qubruṣ afelxaḍert aḍu yusi s zzaṯ. <verse eid="ACT 27:4" /><verse number="5" style="v" sid="ACT 27:5" />neqdeƹ iylel lliy tman kilikiya aḏ bemfiyliya. nuṣel al lmers n miyra g liykiya. <verse eid="ACT 27:5" /><verse number="6" style="v" sid="ACT 27:6" />aḏ diyn, yufa lqayed n 100 lbabur tused seg liskenderiya. aḏ tatreḥ al iyṭalya. yselyeneγ diyes.<verse eid="ACT 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 27:7" />teyyur lbabur s ufercu ussan. aḏ s ljehed d mmeqqer neqreb seg lmers n kiniydus. lekenti aḍu wiγenyedjic ankemmel abriyḏenneγ. yaxy nreḥ g ttega n ljezirṯ n keriyta beƹd mag nƹedda af iγef n selemuwni. <verse eid="ACT 27:7" /><verse number="8" style="v" sid="ACT 27:8" />aḏ beƹd mag neyyur cceṭ cceṭ s tƹeb, nuṣel al mkan mmelnas lmers lliy yezƹem tman tmura n lisaya.<verse eid="ACT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9" />nḍeyyeƹ ggeṯ d lweqt aḏ iƹedda nefdu. aḏ teḏwel terzeft g iylel tuƹer beƹd mag ƹeddan ussan n uẓwum n tkuffart g lexriyf. yaxy yuwa buwlus y ibeḥḥaren n leflukeṯ: <verse eid="ACT 27:9" /><verse number="10" style="v" sid="ACT 27:10" />«ayya irgezen. rahiy terzeftenneγ ṭuruh d lexṭer d meqqar af lbabur aḏ lliy diyes aḏ af tmeddurtenneγ zada.» <verse eid="ACT 27:10" /><verse number="11" style="v" sid="ACT 27:11" />lekenti lqayed n 100 yusi ydebbeƹ g dwiy n lqubṭan n lbabur aḏ lmulatis muc g dwiy n buwlus.<verse eid="ACT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 27:12" />aḏ afelxaḍert ayuh n lmers wiṣelleḥc aqimi diyes g tejrest, cerehen lγalebiyeṯ n midden af terzeft bac aḏeṣlen al lmers n fiyniks lliy g keriyta. aḏ lliy tmir af lqibelt mγerreb aḏ mbeḥḥer mγerreb bac aƹeddan diyes tejrest. <verse eid="ACT 27:12" /><verse number="13" style="v" sid="ACT 27:13" />aḏ yekkerred aḍu seg lqibelt, ḥseben ibeḥḥaren tateniduz al lmers n fiyniks. yaxy qamen lmugleƹ aḏ yyuren tman cceṭ n keriyta.<verse eid="ACT 27:13" /></para>
  <para style="s">aḍu meqqar, lƹefrit.</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 27:14" />lekenti ƹlewleh aḍu d meqqar mmelnas cerqi beḥri yekkerred seg amas n ljezireṯ. <verse eid="ACT 27:14" /><verse number="15" style="v" sid="ACT 27:15" />yaxy iduz lbabur lliy witqudc atebbed zzaṯ aḍu lliy yewyeneγ<verse eid="ACT 27:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 27:16" />al ttega n ljezireṯ d temeckunt ismis kuwda. aḏ beƹd tƹeb nqud aner lbabur n usemneƹ al umkanis. <verse eid="ACT 27:16" /><verse number="17" style="v" sid="ACT 27:17" />aḏ fiseƹ ggen ibeḥḥaren lazem. sunden tizerwin af lbabur. aḏ lewḥen lmugleƹ afelxaḍert ugeḏḏen ateniwi aḍu al ijdi n cceṭ n liybiya. aḏ yeqqim aḍu yetares g lbabur.<verse eid="ACT 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 27:18" />yerniy aḍu fellenneγ ggeṯ. yaxy al ača, uḏellen senkazen seg leƹbeyeṯ n lbabur. <verse eid="ACT 27:18" /><verse number="19" style="v" sid="ACT 27:19" />aḏ g as wi 3 , lewḥen reγleṯ n lbabur s ifesnesen. <verse eid="ACT 27:19" /><verse number="20" style="v" sid="ACT 27:20" />ƹeddan ussan winezric disen tufuyt aḏ iṯran. aḏ yeqqim aḍu almiy neḥseb maƹdc anemneƹ.<verse eid="ACT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21" />aḏ wsiyn lliy rezfen g ayuh n lbabur beṭlen uču ussan. yaxy yusesend buwlus yuwa:</para>
  <para style="p" vid="ACT 27:21">«ay y irgazen, tezrim mammeḵ yexs aslem dwiyw aḏ witrezfemc seg keriyta bac amenƹem seg lexṭer aḏ lexsareṯ. <verse eid="ACT 27:21" /><verse number="22" style="v" sid="ACT 27:22" />lekenti ṭuruh tafenemleγ, witegeḏec. rahiy wiyetmetti ḥetta d yjen siwem. amma lbabur akehaw taterez.<verse eid="ACT 27:22" /></para>
  <para style="p" />
  <para style="p">
    <verse number="23" style="v" sid="ACT 27:23" />yeḍherriḏd yiḍ wuh lmleyka s rebbiy lliy d rebbiyw aḏ y netta neči tẓalliγ. <verse eid="ACT 27:23" /><verse number="24" style="v" sid="ACT 27:24" />yuweyiḏ: &lt; witegeḏec ay buwlus, lazem tabeddeḏ zzaṯ lqeyṣer, aḏ rebbiy yucaḵ temeddurt n lliy rezfen iḏeḵ lkul. &gt; <verse eid="ACT 27:24" /><verse number="25" style="v" sid="ACT 27:25" />witegeḏec ayya irgazen. rahiy temneγ s rebbiy, aḏ mammeḵ yuweyiḏ tayṣar. <verse eid="ACT 27:25" /><verse number="26" style="v" sid="ACT 27:26" />lekenti lazem tatemluweḥ lbabur al ijeṯ seg ljuzur.»<verse eid="ACT 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27" />zegenyeḍ, beƹd 14 n iḍan, yusi aḍu yugay diyneγ g iylel n driya al mani winessinc, ḥseben ibeḥḥaren lliy neccin neqreb seg lber. <verse eid="ACT 27:27" /><verse number="28" style="v" sid="ACT 27:28" />yaxy qasen ndeq n iylel ufent 20 d tiddiyaṯ. aḏ beƹd fercu ƹewden qasen ufent 15 d tiddiyaṯ. <verse eid="ACT 27:28" /><verse number="29" style="v" sid="ACT 27:29" />aḏ ugeḏḏen ateḏƹes lbabur al iḍγaγen. yaxy sezwanas deferris 4 n lemgeleƹ ssugumen g tajji meḥterin.<verse eid="ACT 27:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 27:30" />aḏ smuḏen ibeḥḥaren tarulen seg lbabur, we asezwan lbabur n mneƹ. aḏ rren imanesen tasezwan lemgeleƹ s zzaṯ. <verse eid="ACT 27:30" /><verse number="31" style="v" sid="ACT 27:31" />yuwa buwlus y lqayed n 100 aḏ iƹesekriyen: «kan witγiminc ayuh n ibeḥḥaren g lbabur, witmenƹemc.» <verse eid="ACT 27:31" /><verse number="32" style="v" sid="ACT 27:32" />yaxy qdeƹen iƹesekriyen tizerwin n lbabur n mneƹ. djenteṯ atuda g aman.<verse eid="ACT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33" />mniyn ḥeḍrbac tayeṣbeḥ, yuwa buwlus y midden lkul ačan: «rahiy γarwem 14 d ussanaṯ tesugumem g tiwdi aḏ witečim disen ḥaja. <verse eid="ACT 27:33" /><verse number="34" style="v" sid="ACT 27:34" />yellaṯ čeṯ bac aquddem amenƹem. rahiy wixesser ḥetta d yjen siwem ḥetta zzaw seg ixfis.»<verse eid="ACT 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 27:35" />aḏ iqam aγrum. yerza yuḏel itet beƹd mag yeḥmeḏ rebbiy zzaṯ midden lkul. <verse eid="ACT 27:35" /><verse number="36" style="v" sid="ACT 27:36" />yaxy ṭmanen lkulhum. aḏ čen. <verse eid="ACT 27:36" /><verse number="37" style="v" sid="ACT 27:37" />aḏ nusi g lbabur 276. <verse eid="ACT 27:37" /><verse number="38" style="v" sid="ACT 27:38" />aḏ beƹd mag cbeƹan, lewḥen irden g iylel bac asenekzen seg leƹbeyeṯ n lbabur.<verse eid="ACT 27:38" /></para>
  <para style="s">aḏƹas n lbabur.</para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39" />mniyn yeṣbeḥ, wiquddenc ibeḥḥaren asennen mkan lliy llan diyes. amma zren lxeliyj af cceṭ. aḏ smuḏen taḏersen lbabur al γares kan qudden. <verse eid="ACT 27:39" /><verse number="40" style="v" sid="ACT 27:40" />yaxy qdeƹen tizerwin n lemgeleƹ. aḏ djenteṯ atreḥ. aḏ miren tizerwin n ddefeṯ bac aquden adersen lbabur. aḏ qamnas craƹis mzzaṯ. aḏ yyuren al cceṭ yeduzzu disen aḍu. <verse eid="ACT 27:40" /><verse number="41" style="v" sid="ACT 27:41" />lekenti lbabur tuṣel al mkan jar sen lwiḏan. yaxy yendeq zzaṯis g ijdi. aḏ yuḏel lbaqis yetrezza s lquweṯ n lemwaj.<verse eid="ACT 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42" />aḏ smuḏen iƹesekriyen anγen imeḥbas bac wiyetƹewem ḥetta d yjen sisen al cceṭ we ayerwel. <verse eid="ACT 27:42" /><verse number="43" style="v" sid="ACT 27:43" />lekenti lqayed n 100 lliy yexs aysemneƹ buwlus wiyedjic iƹesekrinis aggen matta axsen. aḏ yuwa y lliy tquddun aƹumen areḥen al cceṭ qebbel ttenyaṯ. <verse eid="ACT 27:43" /><verse number="44" style="v" sid="ACT 27:44" />aḏ lliy witquddunc aƹewmen asreḥḥen af tilweḥin n lbabur naγ af lliy yefdelled siyes. aḏ amyuh uṣellen lkul al cceṭ labas ƹlihum.<verse eid="ACT 27:44" /></para>
  <chapter eid="ACT 27" />
  <chapter number="28" style="c" sid="ACT 28" />
  <para style="s">g malṭa.</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1" />beƹd mag nemneƹ, nefhem lliy cceṭ lliy n uṣellas netta d ljezireṯ n malṭa. <verse eid="ACT 28:1" /><verse number="2" style="v" sid="ACT 28:2" />freḥḥen sineγ ggeṯ middenis lliy seknen g ayuh n ljezireṯ aḏ afelxaḍert yusi d anzar aḏ ṣqiƹ siγneneγ timsi. aḏ ḍeyefneneγ.<verse eid="ACT 28:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 28:3" />iqam buwlus aγil n isγaren ilewḥin g timsi. yaxy teffeγed telefsa seg timsi tƹelleq g fusis afelxaḍert tezγel. <verse eid="ACT 28:3" /><verse number="4" style="v" sid="ACT 28:4" />zren midden n malṭa telefsa g fusis. yaxy uwan y beƹeḍhum: «lazem ayuh n argaz yenγa rruwḥ. aḏ rebbiy n lƹedel wityedjic ayeder beƹd mag yemneƹ seg iylel.»<verse eid="ACT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 28:5" />lekenti buwlus yezelz telefsa g timsi menγir man asyeṭra ḥaja. <verse eid="ACT 28:5" /><verse number="6" style="v" sid="ACT 28:6" />aḏ qqimen ssugumen ggeṯ ayenfex ysumis naγ ayemmuṯ. lekenti wisyeṭri ḥaja. yaxy ḥsebent d yjen seg irebbiyen.<verse eid="ACT 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7" />aḏ yusi tman n aydin n mkan imezdeγen n lḥakem n ljezireṯ; bubliyus. yaxy yesγuyaneγ aḏ yefreḥ sineγ 3 d ussanaṯ. <verse eid="ACT 28:7" /><verse number="8" style="v" sid="ACT 28:8" />aḏ yusi babis n bubliyus yuḍen s leḥmu aḏ tezla n jjar. yaxy iƹeddeyas buwlus. yeẓẓul. aḏ yeggi fellas ifesnis, yseḥleyi.<verse eid="ACT 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 28:9" />aḏ beƹd mag iṣar ayuh, ḏwellen imuḍan n ljezireṯ tesnesd aḏ ḥellan. <verse eid="ACT 28:9" /><verse number="10" style="v" sid="ACT 28:10" />yaxy ucnaneγ ggeṯ d lehdaya. mniyn nsegeḏ, ucneneγ matta yelzemeneγ y trzefteneγ.<verse eid="ACT 28:10" /></para>
  <para style="s">seg malṭa al ruwma.</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11" />aḏ beƹd 3 chuwr, nerzef af lbabur tused seg liskenderiya. diyes lƹelem fellas tteṣwereṯ n sen n irebbiyen mmalnasen itumiyen. aḏ tusi tƹedda tejrest g malṭa. <verse eid="ACT 28:11" /><verse number="12" style="v" sid="ACT 28:12" />mniyn nuṣel al tmura n sirakusa, neqqim diyes 3 d ussanaṯ. <verse eid="ACT 28:12" /><verse number="13" style="v" sid="ACT 28:13" />wembeƹd nerzef cceṭ cceṭ almiy nuṣel tmura n riγiyun. alača yekkerred aḍu d qebli. yaxy nuṣel al tmura n buṭiyuli g as wiṯleṯ. <verse eid="ACT 28:13" /><verse number="14" style="v" sid="ACT 28:14" />dinet nufa lbeƹḍ n aweṯen lliy djulneneγ bac aneqqim yiḏesen. neqqim 7 d ussanaṯ. aḏ amyuh nuṣel al ruwma.<verse eid="ACT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 28:15" />mniyn slen aweṯen sineγ, ffeγen bac aγenƹerden g sseḥeṯ n abbiyus aḏ g mkan malnes lefnadeq n 3. yezrin buwlus yeḥmeḏ rebbiy aḏ yeṯcejjeƹ.<verse eid="ACT 28:15" /></para>
  <para style="s">buwlus g ruwma.</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 28:16" />mniyn nuḏef al ruwma, yedja lqayed n 100 buwlus ayesken g tzaqqa netta aḏ uƹesekri lliy yetƹussu fellas.<verse eid="ACT 28:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17" />beƹd 3 n ussan, yesγuy buwlus y imeqqaren n wuḏeyen. yuwayasen:</para>
  <para style="p" vid="ACT 28:17">«ayya aweṯen, neči wieggiγ ḥaja y cceƹb naγ y leƹweyeḏ n ibabnenneγ. amma wuḏeyen ḥbesniḏ g uwrceliym. aḏ ucenniḏ y iruwmeyen. <verse eid="ACT 28:17" /><verse number="18" style="v" sid="ACT 28:18" />sestenniḏ. aḏ usend talsiben afelxaḍert wiṭṭifen fellaḥaja stehleγ fellas temettent. <verse eid="ACT 28:18" /><verse number="19" style="v" sid="ACT 28:19" />lekenti wuḏeyen wiqqilen. yaxy ḍlebbeγ ateli ckeytiw al lqeyṣer.</para>
  <para style="p" vid="ACT 28:19">aḏ ayuh muc lmeƹnas lliy neči tackiγ s middeniw. <verse eid="ACT 28:19" /><verse number="20" style="v" sid="ACT 28:20" />afelxaḍert n ayuh sγuyγawem bac afenezreγ we afenuflayeγ. rahiy neči ketfeγ s ayuh n tselselt afelxaḍert ssugumeγ g lliy nesugum diyes neccin aṯ israyil.»<verse eid="ACT 28:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21" />yaxy uwanas: «wiγendyusi fellaḵ ḥetta d lejwab seg lyehuwdiya. aḏ wiγendyusi ḥed seg yeṯmenneγ bac aγenyuflay fellaḵ naγ ayecka siyeḵ. <verse eid="ACT 28:21" /><verse number="22" style="v" sid="ACT 28:22" />lekenti neccin nexs anseγd rreyiḵ. rahiy nessen lliy midden g imuḵen lkul wilγisenc ayuh n lmeḏheb.»<verse eid="ACT 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23" />aḏ tefqen tamleqan as iḍen. g aydin n as, usend nihnin aḏ ggeṯ d midden al tzaqqa n buwlus. yeqqim yduggeyasen seg tajji al tmeddiṯ bac asenisiḵen lmelekuwt n rebbiy we aḏemnen s mag yetwari af yesuwƹ g cceriyƹeṯ n muwsa aḏ lektub n lenbiya.<verse eid="ACT 28:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 28:24" />aḏ sisen mam yumen s dwiys. aḏ sisen mam wiyuminc. <verse eid="ACT 28:24" /><verse number="25" style="v" sid="ACT 28:25" />mzunen. aḏ reḥḥen beƹd mag yuwayasen: «γares lḥeq rruwḥ lqudus mniyn yuwa y ibabnuwem af iles n nnabiy icƹeya:<verse eid="ACT 28:25" /></para>
  <para style="p" />
  <para style="q1">
    <verse number="26" style="v" sid="ACT 28:26" />&lt;ureḥ al ayuh n cceƹb temeldas:</para>
  <para style="q2" vid="ACT 28:26">temesliwt taslem, lekinti witfehmemc.</para>
  <para style="q2" vid="ACT 28:26">smuqel tasmuqlem. amma witzerremc<verse eid="ACT 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 28:27" />ul n ayuh cceƹb yeqṣeḥ.</para>
  <para style="q2" vid="ACT 28:27">timzuγinesen ṯqelneṯ.</para>
  <para style="q2" vid="ACT 28:27">qeṣen ṭiṭewinesen bac wizzerenc,</para>
  <para style="q2" vid="ACT 28:27">timezuγinesen bac wisellenc,</para>
  <para style="q2" vid="ACT 28:27">ulawnesen bac wilfehmenc.</para>
  <para style="q2" vid="ACT 28:27">wiltisenc bac atenseḥliγ. &gt; »<verse eid="ACT 28:27" /></para>
  <para style="p" />
  <para style="p">
    <verse number="28" style="v" sid="ACT 28:28" />aḏ yextem buwlus dwiys s tmuli n ayuh:</para>
  <para style="p" vid="ACT 28:28">«yexs asnem mala lliy rebbiy yenkiy lebcareṯ n mneƹis y midden lliy muc d wuḏeyen. aḏ nihnin taslen dwiys we atḏebƹen.» <verse eid="ACT 28:28" /><verse number="29" style="v" sid="ACT 28:29" />mniyn yuwa ayuh n dwiy, ffeγen s γares wuḏeyen aḏ nihnin temxeṣamen. <verse eid="ACT 28:29" /><verse number="30" style="v" sid="ACT 28:30" />yeqqim buwlus sen n isuggesen kamlin g tzaqqa lliy yekreyiṯ. aḏ yusi iferreḥ s lliy ttesend al γares lkul. <verse eid="ACT 28:30" /><verse number="31" style="v" sid="ACT 28:31" />yetbeccer s lmelekuwt n rebbiy. aḏ yeseƹzam af siydneγ yesuwƹ lmesiyḥ menγir tiwdi naγ mam asimel maγer.<verse eid="ACT 28:31" /></para>
  <chapter eid="ACT 28" />
</usx>