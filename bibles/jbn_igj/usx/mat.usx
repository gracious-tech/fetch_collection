<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id" />
  <para style="h">Matt</para>
  <para style="toc1">lebcareṯ mammeḵ yuγetted metta</para>
  <para style="toc2">Matt</para>
  <para style="toc3">MAT</para>
  <para style="mt1">lebcareṯ mammeḵ yuγetted metta</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">leṣel n yesuwƹ lmesiyḥ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />ayuh d zmem n leṣel n yesuwƹ lmesiyḥ memmis n dawud, memmis n ibrahiym.<verse eid="MAT 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 1:2" />ibrahiym ixelfed isḥaq, aḏ isḥaq ixelfed yeƹquwb, aḏ yeƹquwb ixelfed yehuwḏa aḏ yeṯmas. <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />aḏ yehuwḏa ixelfed fareṣ aḏ zareḥ seg ṯamar. aḏ fareṣ ixelfed ḥeṣruwn aḏ ḥeṣruwn ixelfed ram.<verse eid="MAT 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 1:4" />ram ixelfed ƹemminedab lliy ixelfed neḥcuwn lliy ixelfed selmun. <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />selmun ixelfed buƹez seg rahab lliy ixelfed ƹubid seg raƹuṯ, aḏ ƹubid ixelfed yessa. <verse eid="MAT 1:5" /><verse number="6" style="v" sid="MAT 1:6" />aḏ yessa ixelfed dawud lmelek,</para>
  <para style="p" vid="MAT 1:6">aḏ dawud ixelfed suleyman seg lliy tusi d lƹileṯ n uriyya. <verse eid="MAT 1:6" /><verse number="7" style="v" sid="MAT 1:7" />aḏ suleyman ixelfed reḥebƹam lliy ixelfed abiyya lliy ixelfed ssa. <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />aḏ ssa ixelfed yehucafaṭ lliy ixelfed yuram lliy ixelfed ƹuziyya.<verse eid="MAT 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 1:9" />aḏ ƹuziyya ixelfed yuṯam lliy ixelfed ḥaz lliy ixelfed ḥizqiyya. <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />aḏ ḥizqiyya ixelfed menessa lliy ixelfed amun lliy ixelfed yuciyya. <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />aḏ yuciyya ixelfed yekunya aḏ yeṯmas g ussan n iwey n wuḏeyen al babel.<verse eid="MAT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12" />beƹd iwey n wuḏeyen al babel yekunya ixelfed ceƹeltiyel lliy ixelfed zerubabel. <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />aḏ zerubabel ixelfed abihud lliy ixelfed ƹelyeqima lliy ixelfed ƹazur. <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />aḏ ƹazur ixelfed ṣaduq lliy ixelfed ƹexim lliy ixelfed ƹeliyud. <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />aḏ ƹeliyud ixelfed liƹazer lliy ixelfed mettan lliy ixelfed yeƹquwb. <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />aḏ yeƹquwb ixelfed yuwsef argaz n meryem lliy tuγed yesuwƹ lliy mmelnas lmesiyḥ.<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />aḏ leƹded n llejyal seg ussan ibrahiym al ussan n dawud 14 n jiyl, aḏ seg ussan n dawud al ussan n iwey n wuḏeyen al babel 14 n jiyl, aḏ seg ussan n iwey n wuḏeyen al babel al lmesiyḥ 14 n jiyl.<verse eid="MAT 1:17" /></para>
  <para style="s">tleliṯ n yesuwƹ lmesiyḥ</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />qa mammeḵ yluled yesuwƹ lmesiyḥ. tusi yedjis meryem temuxdeb y yuwsef aḏ qebbel man anejfen tqam ara seg rruwḥ lqudus. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />aḏ afelxaḍert yuwsef yusi d lƹeqel wiyeqqil atetyefḍeḥ aḏ ixemmem atettiseyyeb g cceḥden. <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />aḏ mniyn yusi yetxemmem g aydin yeḍherresd lmleyka s rebbiy g tirjelt yemmal: «ay yuwsef memmis n indin lliy ixelfed dawud; witteggec aγed meryem tesliṯiḵ al tzaqqaḵ, afelxaḍert lliy tatteru siyes netta seg rruwḥ lqudus. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />qa tatteru afrux aḏ cek tatsemmiḏ yesuwƹ, afelxaḍert d netta lliy taysemneƹ midnis seg ibekkaḍnesen.»<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />am ayuh lkul yentem lliy yuwayi rebbiy af imi n nnabiy lliy yuwa seg lemmi:<verse eid="MAT 1:22" /></para>
  <para style="p" />
  <para style="q1">
    <verse number="23" style="v" sid="MAT 1:23" />«qa teqiyert tatqam ara,</para>
  <para style="q2" vid="MAT 1:23">we ateru afrux,</para>
  <para style="q2" vid="MAT 1:23">we asesγuyen ƹimmanuyel.»</para>
  <para style="q2" vid="MAT 1:23">lliy lmeƹnes, rebbiy iḏenneγ.<verse eid="MAT 1:23" /></para>
  <para style="p" />
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />mniyn yekker yuwsef, yeggi lliy yuwayas felles lmleyka n rebbiy, yuγed tesliṯtis al tezeqqas. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />lekenti wiyuḏifc felles almiy tiru afrux, ysemmeyi yesuwƹ.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">zyereṯ n lliy smuqulen s iṯren</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />beƹd mag yluled yesuwƹ g biytleḥm lliy tella g lyehuwdiya g lƹehd n lmelek hiyruwdus, usend al uwrceliym s mcerreq lbeƹḍ n lliy smuqulen s iṯren. <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />sestunen: «mani yella wuh lliy yluled d lmelek n wuḏeyen? rahiy nezra iṯris yuliyed mcerreq nused bac asnesjeḏ.» <verse eid="MAT 2:2" /><verse number="3" style="v" sid="MAT 2:3" />mniyn yesla lmelek hiyruwdus aydin n dwiy yerjij aḏ terjij yiḏes uwrceliym lkul. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />yaxy yesγuy y imeqqaren n lkuhhan n wuḏeyen aḏ lliy seḥfeḍen g cceriyƹeṯ ysestnin: «mani tadilel lmesiyḥ.» <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />rennes: «g biytleḥm, seg lyehuwdiya. rahiy yused g lkitab af imi n nnabiy seg lemmi:<verse eid="MAT 2:5" /></para>
  <para style="p" />
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />&lt;ay biytleḥm seg tammurt n yehuwḏa,</para>
  <para style="q2" vid="MAT 2:6">cemmin muc d lqel n imuḵen g yehuwḏa.</para>
  <para style="q2" vid="MAT 2:6">afelxaḍert siyem tadyeffeγ lḥakem</para>
  <para style="q2" vid="MAT 2:6">lliy tayelha s cceƹbiw israyil. &gt; »<verse eid="MAT 2:6" /></para>
  <para style="p" />
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />yaxy yesγuy hiyruwdus y lliy smuqlen s iṯren g cceḥden ysestnin af lweqt lliy yeḍherred diyes iṯri. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />wembeƹd yenkiyin al biytleḥm yuwayasen: «ureḥeṯ turzum nyeƹdel af afrux aḏ almiy atefem mmeltiḏ bac areḥeγ neči zada assejdeγ.» <verse eid="MAT 2:8" /><verse number="9" style="v" sid="MAT 2:9" />mniyn slen lliy yuwa lmelek reḥḥen af imenesen. yaxy iṯri lliy zrent qebbel mcerreq yeḍherred zzaṯesen yeggur almiy yuṣel al umkan lliy diyes afrux yebbed anjis. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />mniyn zren iṯri freḥḥen ggeṯ. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />ƹeddan al lḥuc ufen afrux yid yedjis meryem. yaxy ssjeḏnes, wembeƹd miren lefniqesen ucennas lhdayeṯ n wureγ aḏ lbxur aḏ lmur. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />wembeƹd zren mam yuwayasen g tirjelt wiḏḏuglec al hiyruwdus. yaxy rewḥen al lbledesen seg abriyḏ iḍen.<verse eid="MAT 2:12" /></para>
  <para style="s">truwla al miṣr</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />beƹd mag ruḥen lliy smuqlen s iṯren, yeḍherred lmleyka n rebbiy y yuwsef g tirjelt, yuwayas: «kker terruleḏ s wefrux aḏ yedjis al miṣr, teqimeḏ diyes almiy afemleγ rred. rahiy hiyruwdus tayurzu af wefrux bac atyenγ.» <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />yaxy yekker yuwsef yiḍ diyn yerwel s wefrux aḏ yedjis al miṣr. <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />aḏ yeqqim diyes almiy yemmuṯ hiyruwdus. am ayuh yentem lliy yuwa felles rebbiy af imi n nnabiy lliy yuwa seg lemmi:</para>
  <para style="p" vid="MAT 2:15" />
  <para style="q1" vid="MAT 2:15">«seg miṣr sγuyeγ y memmi.»<verse eid="MAT 2:15" /></para>
  <para style="p" />
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />mniyn yefhem hiyruwdus lliy indin lliy smuqlen s iṯren ṯmesxren felles teḍras ggeṯ. yaxy yenkiy mam yenγa imeckenen lliy g biytleḥm aḏ lliy tmas lkul seg lliy lƹemris sen n isuggesen naγ qel af lḥsab n lweqt lliy yeḍherred diyes iṯri mammeḵ uwan lliy smuqlen s iṯren. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />amyuh yentem lliy yuwa felles nnabiy irmiya seg lemmi:<verse eid="MAT 2:17" /></para>
  <para style="p" />
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />«ṣeyyeḥ yuli seg rrama:</para>
  <para style="q2" vid="MAT 2:18">leƹyeḍ aḏ sgujder d meqqar ggeṯ,</para>
  <para style="q2" vid="MAT 2:18">raḥil tetƹeyyeḍ af ṭarwas</para>
  <para style="q2" vid="MAT 2:18">witqebbelc ƹezzi afelxaḍert reḥḥen.»<verse eid="MAT 2:18" /></para>
  <para style="s">riri seg miṣr al nnaṣira</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />weqt lliy yemmuṯ lmelek hiyruwdus yeḍherred lmleyka n rebbiy y yuwsef g tirjelt g miṣr, <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />yuwayas: «kker teḏḏuleḏ s wefrux aḏ yedjis al tammurt n israyil. rahiy yemmuṯ lliy yexs atyenγ.» <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />yaxy yekker yeḏwel s wefrux aḏ yedjis al tammurt n israyil. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />lekenti weqt lliy yesla lliy arxilawus d lmelek af lyehuwdiya beƹd babis hiyruwdus, yugeḏ ayreḥ al dinet, aḏ yusesd lweḥy g tirjelt: «barra al leḍraf n ljeliyl.» <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />yaxy yuṣel al lḥumeṯ ismis nnaṣira. yesken diyes. amyuh yentem lliy uwant lenbiya seg lemmi.</para>
  <para style="q1" vid="MAT 2:23">«rahiy tatsemmen d nnaṣiriy.»<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">yaḥya lmeƹmedan</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />g aydin n ussan yeḍherred yaḥya lmeƹmedan g lexla n lyehuwdiya yetbeccer: <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />yemmal: «tabeṯ rahiy yeqrebbed lmelekuwt n ujenna.» <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />aḏ yaḥya d netta lliy yufley felles nnabiy icƹeya seg lemmi yuwa:</para>
  <para style="p" vid="MAT 3:3" />
  <para style="q2" vid="MAT 3:3">«lḥes n yjen yesγuyu g lexla.</para>
  <para style="q2" vid="MAT 3:3">&lt;seḥedreṯ abriyḏ n rebbiy,</para>
  <para style="q2" vid="MAT 3:3">terrem ibriyḏnis qƹeḏḏen. &gt; »<verse eid="MAT 3:3" /></para>
  <para style="p" />
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />aḏ yusi yaḥya yireḍ meryul seg luber n lγem. aḏ iḥezzem s lḥzam n ylim. aḏ itet g ijraḏ aḏ temamt n lγabeṯ. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />yaxy ffeγnes midden n uwrceliym aḏ lyehuwdiya lkulha aḏ lḥumaṯ lliy tman lurdun lkul. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />aḏ wsiyn tzizdiyen af fusis g lweḏ n lurdun, aḏ ttesteƹƹerfen s bekkeḍunsen.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />mniyn yezra yaḥya ggeṯ d iferysiyyen aḏ d iṣedduwqiyiyen ttesend bac azizdiyen yuwayasen:</para>
  <para style="p" vid="MAT 3:7">«ay ṭarwa n tlefsiwin, mam yseḥefdewem arulem amyuh seg aγeccec lliy tadyas. <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />yexs siḵeneṯ ttuwbtwem s igga n ḥaja teṣbiḥet. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />aḏ withenneṯec imanuwem aḏ kennim temmelem: &lt; ibrahiym d babenneγ. &gt; rahiy rebbiy yetquddu ayseffeγ seg iḍγaγen imeckenen y ibrahiym. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />qa lbelṭeṯ tella adug iderren n cjer. aḏ kul ccejreṯ witettuc lγelleṯ teṣbiḥt atemmuqdeƹ we atemluweḥ g timsi.<verse eid="MAT 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11" />neči tzizdiyeγ diwem s aman bac atebem, lekenti lliy tadyas beƹdiw yetquddu iṭriw, aḏ neči wistehlexc aqameγ ṣṣebaṭis. netta tafennizizdi s rruwḥ lqudus aḏ timsi. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />rahiy netta iqam meydu g fusis, tayzuzer lliy g ssilγeγis lkul we aylayem irdnis g lmexzen amma sfaf tatyeḥreq s timsi wittetbessiyc.»<verse eid="MAT 3:12" /></para>
  <para style="s">zizdi n yesuwƹ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />wembeƹd yused yesuwƹ seg ljeliyl al lweḏ n lurdun ireḥ al yaḥya bac ayezizdi af fusis. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />lekinti yaḥya wiyeqqil aḏ yuwayas: «d neči lliy yexs afdeseγ we azizdiyeγ af fusiḵ aḏ cek tusidiḏ.» <verse eid="MAT 3:14" /><verse number="15" style="v" sid="MAT 3:15" />yerras yesuwƹ: «zizdiyiḏ bac aytem lxiyr lliy yexs rebbiy atneg.» yerla yaḥya yeggi mammeḵ yuwayas. <verse eid="MAT 3:15" /><verse number="16" style="v" sid="MAT 3:16" />mniyn izizdi yesuwƹ yeffeγ seg aman, ƹlewleh ujenna imires, yezra rruwḥ n rebbiy izugged aḏ yersa felles am tmella. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />aḏ yemmusel ṣṣut seg ujenna yemmal: «wuh d memmi ḥbibiw lliy freḥeγ siyes lferḥ lkul.»<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">lblis yetjerreb g yesuwƹ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />wembeƹd yuwya rruwḥ lqudus yesuwƹ al lexla bac atijerreb lblis. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />beƹd mag iẓwum rbƹiyn d ussanaṯ aḏ iḍaneṯ, yelluz. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />yaxy yusesd lliy tatijerreb, yuwayas: «kan cek d memmis n rebbiy mmel y ayuh n teḍγeγt ateḏwel d aγrum.» <verse eid="MAT 4:3" /><verse number="4" style="v" sid="MAT 4:4" />yaxy yerras: «rahiy yetweri:</para>
  <para style="p" vid="MAT 4:4" />
  <para style="q1" vid="MAT 4:4">&lt;muc s aγrum weḥdes itedder bnaḏem,</para>
  <para style="q1" vid="MAT 4:4">lekinti s kul tuflayt teteffeγ seg imi n rebbiy. &gt; »<verse eid="MAT 4:4" /></para>
  <para style="p" />
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />wembeƹd yewyi lblis al tmura temeqdust. aḏ ysebbeddyi af lḥacit n lheykel. <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />aḏ yuwayas: «kan cek d memmis n rebbiy, suda imaniḵ al dday, afelxaḍert yetweri:</para>
  <para style="q1" vid="MAT 4:6">&lt;yetweṣṣa lmlayektis siyeḵ,</para>
  <para style="q1" vid="MAT 4:6">bac afqamen af ifesnesen</para>
  <para style="q1" vid="MAT 4:6">aḏ witečiṯec dariḵ al aḍγaγ. &gt; »<verse eid="MAT 4:6" /></para>
  <para style="p" />
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />yaxy yuwayas yesuwƹ: «aḏ yetweri zada:</para>
  <para style="p" vid="MAT 4:7" />
  <para style="p" vid="MAT 4:7">witjerrebc rebbiy, rebbiyḵ.»<verse eid="MAT 4:7" /></para>
  <para style="p" />
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />wembeƹd yewyi lblis al iγef n jbel yeƹla ggeṯ. aḏ isiḵnas lmemmelek timeqqarin n ddunyeṯ lkul. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />aḏ yuwayas:</para>
  <para style="p" vid="MAT 4:9" />
  <para style="p" vid="MAT 4:9">«afuceγ tinuh lkul kan tezwiḏ aḏ tesjeḏdiḏ.»<verse eid="MAT 4:9" /></para>
  <para style="p" />
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />yaxy yuwayas yesuwƹ: «barra ayya cciyḍan. rahiy yetweri:</para>
  <para style="p" vid="MAT 4:10" />
  <para style="q1" vid="MAT 4:10">&lt;y rebbiy rebbiyḵ sjeḏ,</para>
  <para style="q1" vid="MAT 4:10">aḏ y netta weḥdes zzal. &gt; »<verse eid="MAT 4:10" /></para>
  <para style="p" />
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />yaxy yedjiy lblis. aḏ lbeƹḍ n lmleyka usennesd, ttegnes mag yexs.<verse eid="MAT 4:11" /></para>
  <para style="s">yesuwƹ yḏuggel al ljeliyl</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />mniyn yesla lliy yaḥya ṭṭefent yeḏwel al ljiheṯ n ljeliyl. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />yeffeγ seg nnaṣira. ireḥ al kefrnaḥuwm lliy tella af cceṭ n iylel g leḥduḏ n zebuwluwn aḏ neftaliy. yeqqim diyes. <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />amyuh yentem lliy yuwa felles seg lemmi icƹeya nnabiy:<verse eid="MAT 4:14" /></para>
  <para style="p" />
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />&lt;tammurt n zebuwluwn aḏ tammurt n neftaliy</para>
  <para style="q2" vid="MAT 4:15">af abriyḏ n iylel deffer lwaḏ n lurdun,</para>
  <para style="q2" vid="MAT 4:15">g lblad n ljeliyl lliy seknen diyes iγriben,<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />midden lliy geƹmzen g itellest</para>
  <para style="q2" vid="MAT 4:16">zren ddu d meqqar</para>
  <para style="q2" vid="MAT 4:16">aḏ lliy geƹmzen af tammurt n tmettent aḏ ṭṭellis</para>
  <para style="q2" vid="MAT 4:16">yuliyed fellesen ddu. &gt;<verse eid="MAT 4:16" /></para>
  <para style="p" />
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />s lweqt ḏḏin yuḏel yesuwƹ yetbeccer yemmal: «tabeṯ rahiy yeqrebbed lmelekuwt n ujenna.»<verse eid="MAT 4:17" /></para>
  <para style="s">yesuwƹ yesγuyu af tlamḏa imezweren</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />mniyn yusi yesuwƹ yeggur af cceṭ n iylel n ljeliyl yezra sen aweṯen nihnin d simƹan lliy mmelnas buṭrus aḏ andrawus uwas ḥedfen g rredj g iylel afelxaḍert wsiyn d iṣiyyeden. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />yaxy yuweyesen: «yya ḏbeƹtiḏ afenerreγ d ṣeyyaḏen y midden.» <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />djen rredj ḏbeƹƹent. <verse eid="MAT 4:20" /><verse number="21" style="v" sid="MAT 4:21" />yyuren s yin yaxy zren sen n aweṯen iḍen, nihnin d yeƹquwb memmis n zebediy aḏ uwas yuwḥenna, g lflukeṯ nihnin aḏ babesen treqƹen g iredjen. yuwayasen atḏebƹen. <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />yaxy djen babesen aḏ lflukeṯ, ḏbeƹent ƹlewleh.<verse eid="MAT 4:22" /></para>
  <para style="s">yesuwƹ yesseḥfaḍ aḏ yesseḥla g imuḍan</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />aḏ yusi yesuwƹ iṭenneḍ g ljeliyl lkulha yesseḥfaḍ g wuḏeyen lliy mleymen g lmejmeƹ. aḏ yesγuyu s lbcareṯ n lmelekuwt. aḏ yesseḥla seg aṭṭen lkul midden. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />yaxy slen siyes g suwrya lkul. awyennas midden imuḍanesen lliy tƹanen seg aṭṭan aḏ uγenna ggeṯ, aḏ lliy kesbes b ismelleh meskunin aḏ lliy γarsen lmeṣṣebyen aḏ lliy mculen. yseḥleyin lkul. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />ḏbeƹent midden ggeṯ seg ljeliyl aḏ dekabuli aḏ uwrceliym aḏ lyehuwdiya aḏ lliy deffer lwaḏ n lurdun.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">lxuṭbeṯ af jbel</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />mniyn yezra midden, yuli al jbel ygeƹmez. yaxy qrebnes tlamḏes. <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />yaxy yuḏel yesseḥfaḍ disen:<verse eid="MAT 5:2" /></para>
  <para style="s">lferḥeṯ nembelḥeq</para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />&lt;ayya sseƹdessen lliy fehmen s rruwḥ lliy nihnin tteḥtaqen rebbiy.</para>
  <para style="q2" vid="MAT 5:3">rahiy y nihnin lmelekuwt n ujenna.<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />ayya sseƹdessen lliy tƹiden af imanesen.</para>
  <para style="q2" vid="MAT 5:4">rahiy tatennisefreḥ rebbiy.<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />ayya sseƹdessen lliy ƹeqlin.</para>
  <para style="q2" vid="MAT 5:5">rahiy tawerṯen tammurt.<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />ayya sseƹdessen lliy lluzen aḏ lliy ffuḏen al abriyḏ ṣbiḥ.</para>
  <para style="q2" vid="MAT 5:6">rahiy tacebƹen.<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />ayya sseƹdessen lliy sexfen af midden.</para>
  <para style="q2" vid="MAT 5:7">rahiy tatenyerḥem rebbiy.<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />ayya sseƹdessen lliy ulawnesen d imellalen.</para>
  <para style="q2" vid="MAT 5:8">rahiy tazren rebbiy.<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />ayya sseƹdessen lliy tteγend g slam y midden.</para>
  <para style="q2" vid="MAT 5:9">rahiy tattusemman d ṭarwa n rebbiy.<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />ayya sseƹdessen lliy mdurren afelxaḍert n abriyḏ ṣbiḥ.</para>
  <para style="q2" vid="MAT 5:10">rahiy y nihnin lmelekuwt n ujenna.<verse eid="MAT 5:10" /></para>
  <para style="p" />
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />ayya sseƹduwem kan ḏƹunewem midden aḏ durnewem aḏ uwan fellawem ggeṯ d dwiy s tikerkas afelxaḍrtiw. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />fferḥeṯ tinyem. rahiy ṯwebwem g ujenna d meqqar. amyuh mdurren lenbiya qebluwem. &gt;<verse eid="MAT 5:12" /></para>
  <para style="s">tisent n tammurt aḏ ddu n ddunyeṯ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />kennim g ddunyeṯ am tisent g uču. aḏ kan tisent witmeleḥc mammeḵ tasner melḥis? aḏ ateḏwel maƹadc tṣelleḥ kan yuleweḥ al barra we atetƹefsen midden.<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />kennim d ddu n ddunyeṯ, tetḍharemd s ybeƹeḏ am tmura lliy tella nnaj almiyraz. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />midden almiy asseγen g nnir witeggenc adug lgelbeṯ amma ateggent af mkan yeƹla bac ayḍewa y midden lkul lliy g lḥuc. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />amyuh yexs adlem. djeṯ ayḍewa dduwem zzaṯ midden, bac azren ṣbiḥ lliy teggimt we amejden babuwem lliy g ujenna.<verse eid="MAT 5:16" /></para>
  <para style="s">rray n lmesiyḥ g cceriyƹeṯ</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />balek amlem lliy neči usiγd bac akseγ cceriyƹeṯ n muwsa naγ lliy uγentiḏ lenbiya. rahiy widdusixc bac akseγ lekenti usiγd bac atemmemmeγ lliy uγentiḏ. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />lḥeq afenemleγ. ḥetta kan tammurt aḏ ujenna muksen, wiyetmukus ḥetta d lḥerf naγ d tinuqtet ijeṯ seg cceriyƹeṯ almiy yentem kul ciy.<verse eid="MAT 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 5:19" />rahiy kul yjen aytu ijeṯ seg ayuh n luwṣayaṯ timeckunin, aḏ ayṣeḥfeḍ midden bac aggen mammeḵ iteg, taydel wiyγerc ḥetta d lqimeṯ g lmelekuwt n ujenna. amma lliy ayeg sisneṯ aḏ atentyeṣeḥfeḍ y midden atdel lqimtis d temeqqart g lmelekuwt n ujenna. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />qa tafenemleγ turuh. rahiy kan wiyernic lxiyruwem af lxiyr n lliy seḥfeḍen g cceriyƹeṯ aḏ iferysiyyen witeteḏfemc al lmelekuwt n ujenna xlaṣ.<verse eid="MAT 5:20" /></para>
  <para style="s">aγeccec</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />tessennem lliy cceriyƹeṯ n muwsa tuwa y imezweren: «wineγc, aḏ lliy yenγa yestahel lmuḥakmeṯ.» <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />amma neči afenemleγ: «kul yjen ayγeccec af uwas yestahel lmuḥakmeṯ, aḏ mam aymel y uwas: ya ḍeyeƹ, yestahel tebeddiṯ zzaṯ lmeḥkemeṯ temeqqart. aḏ lliy asimel: ay yeγyul, yestahel timsi n jhennem.<verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />kan tusid s lweƹḏtiḵ al mkan n teγrest aḏ dinet tesmitiḏ lliy jareḵd aḏ uwaḵ ḥaja, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />adj lweƹeḏtiḵ zzaṯ mkan n teγrest. treḥḥeḏ tserliḏ uwaḵ saƹa, wembeƹd rred tuceḏ lweƹeḏtiḵ.<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />serla aγrimiḵ fiseƹ g ubriḏ al lmeḥekmeṯ qebbel man afiwiy aγrimiḵ al lqaḍi lliy afyuc y mam afyeg g lḥebs. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />aḏ lḥeq afemleγ. rahiy witettefγec seg lḥebs almiy axelṣeḏ lliy fellaḵ lkul.<verse eid="MAT 5:26" /></para>
  <para style="s">zna</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />rahiy tessennem lliy cceriyƹeṯ n muwsa tuwa: «wizennac.» <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />amma neči afenemleγ: kul yjen ayesmuqel al temeṭṭuṯ bac ayeṯmetteƹ rahiy yezna siyes g ulis. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />kan ṭiṭiḵ n limin tafetseγleḍ, ksiṯ aḏ luḥiṯ. rahiy mukes n ṭiṭ aḏ bƹeḏ af jehennem xiyr n iḏef al γares siyes. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />aḏ kan fusiḵ n limin tafiseγleḍ. rahiy ikkesis aḏ bƹeḏ af jehennem xiyr n iḏef al γares siyes.»<verse eid="MAT 5:30" /></para>
  <para style="s">tulfa</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />tuwa zada: «lliy yellaf y lehlis asyuc tḥudjet n tulfa.» <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />amma neči afenemleγ: «kul yjen yellaf y lehlis man γiyr man atezna rahiy tatetiluz bac atezna. aḏ mam yenjef ijeṯ tellef. rahiy tayezna.»<verse eid="MAT 5:32" /></para>
  <para style="s">witjelleṯec xlaṣ</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />tessennem lliy cceriyƹeṯ n muwsa tuwa y imezweren: «witrezzeṯec tjelliṯuwem, amma weffaṯ s lliy tuƹeḏḏemt y rebbiy.» <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />neči afenemleγ: «witjelleṯec xlaṣ la s ujenna afelxaḍert d lƹerc n rebbiy. <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />la s tammurt afelxaḍert tella adug iderenis. la s uwrceliym afelxaḍert d tmura n lmelek meqqar. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />witjellac s ixfiḵ afelxaḍert witetqudduc rreḏ zzaw seg udjufis d mellal naγ d ṣeṭṭaf. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />adj aydel dwiywem: ih, kan ih, naγ aha kan aha. amma lliy ayerni af aydin rahiy wiyeḥli.»<verse eid="MAT 5:37" /></para>
  <para style="s">ṯṯar</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />tessennem lliy cceriyƹeṯ n muwsa tuwa: «ṭiṭ s ṭiṭ aḏ ssin s ssin.» <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />amma neči afenemleγ: «wittereṯec ccer s ccer, lekenti lliy iwetteḵ af lxenk n limin sundas lxenk ttani. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />aḏ mam yexs afixeṣem bac aywiy lḥweyjiḵ rni djes tlebetiḵ. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />aḏ mam iluzzeḵ bac ayureḏ yiḏes almiyl, yyur yiḏes milin. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />mam yeḍleb s γareḵ ḥaja ucested. aḏ mam yused ayerdel s γareḵ witerrac am idin.»<verse eid="MAT 5:42" /></para>
  <para style="s">temexsiwt n laƹda</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />aḏ tessennem lliy cceriyƹeṯ n muwsa tuwa: «xs rnewiḵ aḏ kkereh leƹduḵ.» <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />amma neči afenemleγ: xseṯ laƹduwem, aḏ numreṯ lliy leƹnen diwem, ggeṯ ṣbiḥ yid indin lliy wifenγisenc, ḍelbeṯ lxiyr y lliy ddurrun diwem <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />bac adlem d ṭarwa n babewem lliy g ujenna. rahiy netta yetḍewa s tufuytis af ṣbiḥen aḏ af lliy wiḥlin, aḏ yesezwa anzar af ṣbiḥen aḏ af lliy wiḥlin. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />kan texsem lliy xsennewem matta ṯwebwem zeγ? rahiy ḥetta lliy yetlayem g ḍḍeribeṯ iteg amyuh. <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />aḏ kan tefreḥḥem s yeṯmewem akehaw, matta teggim zeγ yuƹer? rahiy ayuh tteggent ḥetta lliy witemnenc s rebbiy. <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />yellaṯ kennim ḏuleṯ kamlin mammeḵ babuwem n ujenna kamel.<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">ṣṣedqeṯ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />rreṯ lbaluwem aggem lxiyr zzaṯ midden bac afennezren. kan teggim amyuh wiγerwemc ṯweb al babewem lliy g ujenna.<verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />kan tṣedqeḏ af yjen witegc ṭbel mammeḵ tteggen lliy xsen atenzren midden g lmjameƹ aḏ ibriyḏen, bac atencekren midden. lḥeq afenemleγ: «rahiy lqan ṯwebsen.»<verse eid="MAT 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 6:3" />amma cekkin almiy taṣedqeḏ witedjac fusiḵ zelmaḍ ayessen mag yettuc ffus n limin. <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />yexs addel ṣedeqtiḵ g cceḥdan aḏ babiḵ lliy g ujenna d netta lliy izer matta yeḥrez. netta lliy tafyuc ṯwebiḵ.<verse eid="MAT 6:4" /></para>
  <para style="s">tẓalliṯ lliy yseḥfediṯ yesuwƹ y tlamḏes</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />lemmi tetẓellim witteggic am indin lliy sseḵanen g imanesen aḏ lliy xsen adlen bbedden g lmjameƹ aḏ g ibriyḏen bac atenezren midden. lḥeq afenemleγ. rahiy lqan ṯwebsen.<verse eid="MAT 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 6:6" />amma cekkin almiy teẓelleḏ, ḏef al lbiytiḵ. arr lbab fellaḵ. ẓẓal y ibabiḵ lliy witeḍhirc. aḏ babiḵ lliy yessen matta teḥrezeḏ netta lliy tafyuc ṯwebiḵ.<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />lemmi tetẓellim witƹeweḏic dwiy am idin mammeḵ tteggen lliy ẓullen y lleṣnem. rahiy nihnin ddunun lliy s uƹeweḏ n dwiy ggeṯ talqen lliy ḍelben. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />witteggec am nihnin afelxaḍert babewem yessen matta texsem qebbel man atḍelbem.<verse eid="MAT 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9" />amma ẓelleṯ amyuh.</para>
  <para style="p" vid="MAT 6:9" />
  <para style="q2" vid="MAT 6:9">&lt;ay rebbiy babenneγ lliy g ujenna,</para>
  <para style="q2" vid="MAT 6:9">ayemqudes ismiḵ.<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />adyas lmelekuwtiḵ,</para>
  <para style="q2" vid="MAT 6:10">we aydel mag texseḏ af tammurt</para>
  <para style="q2" vid="MAT 6:10">mammeḵ yella g ujenna<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />ucaneγ kul as man aγenyekfa seg aγrum.<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />aγferaneγ ibekkaḍnenneγ,</para>
  <para style="q2" vid="MAT 6:12">mammeḵ netsameḥ neccin</para>
  <para style="q2" vid="MAT 6:12">lliy γelden iḏenneγ.<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />aḏ wiγentedjac anuda g ccer,</para>
  <para style="q2" vid="MAT 6:13">amma semmenƹaneγ seg cciyḍan.<verse eid="MAT 6:13" /></para>
  <para style="p" />
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />kan tsemḥem midden af aγleḍesen, afenyeγfer babewem lliy g ujenna ibekkaḍnuwem. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />aḏ kan witsemḥemc midden wifenniγefferc babewem lliy g ujenna ibekkaḍnuwem. &gt;<verse eid="MAT 6:15" /></para>
  <para style="s">zumu</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />lemmi aẓwumem witkecceccec mammeḵ tteggen lliy xsen asiḵnen imanesen, tkecceccen bac asiḵnen y midden lliy nihnin zumen. lḥeq afenemleγ: rahiy nihnin lqan ṯwebsen. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />almiy aẓwumeḏ sireḏ uḏmiḵ teggeḏ ifuḥan y ixfiḵ <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />bac asiḵeneḏ uẓwumiḵ muc y midden amma y babiḵ lliy witzerrec diyes. aḏ netta lliy yessen matta yeḥrez. tafyuc ṯweb.<verse eid="MAT 6:18" /></para>
  <para style="s">lkenz lliy nembelḥeq</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />wiḥḥerzec lkenz g ddunyeṯ mani atyeč ssus, we atyeḏen ṣdiḏ, we aḏeγzen felles ysereqen. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />amma aḥḥerzeṯ lkenz g ujenna mani wityetteč ssus, aḏ witaḏenc ṣdiḏ, aḏ witeγezenc felles ysereqen. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />rahiy mani yella lkenziḵ yella uliḵ.<verse eid="MAT 6:21" /></para>
  <para style="s">ṭiṭ d nnir n bnaḏem</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />ṭiṭ d nnir n bnaḏem. kan uliḵ d meqqar aḏ witḥesdec, tadleḏ tetreqeḏ. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />amma kan teteγeḏ s ṭiṭ. rahiy tadreḏ g ttellest. aḏ kan ṭiṭiḵ tuwyeḵ al tellest. rahiy tellestiḵ d ttemeqqart.<verse eid="MAT 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />wiyetqudduc ḥetta d yjen ayeḏbeƹ sen g lweqt yjen, afelxaḍert tayexs yjen sisen iṭer n ttani we atyeḏbeƹ. witquddemc aƹebdem rebbiy aḏ iflusen g lweqt yjen.<verse eid="MAT 6:24" /></para>
  <para style="s">rebbiy ilehha sineγ</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />turuh tafenmleγ: «witteggec lhem n ddunyeṯ af tḵerminuwem, wimelec matta taneč naγ matta tansu naγ matta tanireḍ. rahiy temeddurt xiyr n uču aḏ lbden xiyr n uṣireḍ. <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />smuqleṯ al iciwciwen g ujenna. rahiy nihnin la ḵerzen la medjren la tlayemen g itxubay. aḏ babewem lliy g ujenna iṭaγesend lqesmesen. rahiy kennim xiyr n iciwciwen ggeṯ.<verse eid="MAT 6:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 6:27" />mam siwem s uxemmemmis yetquddu ayerni g lƹemris ḥetta ssaƹeṯ ijeṯ? <verse eid="MAT 6:27" /><verse number="28" style="v" sid="MAT 6:28" />aḏ maγer tetxemmemmem af uṣireḍ? smuqleṯ al ayuh n tnuwarin n lγabeṯ. rahiy nihintin la teƹebneṯ la ttelemneṯ. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />lekenti tafenemleγ: «ḥetta suleyman g lmejdis meqqar wiyeriḍc ḥaja yezƹem am ijeṯ sisneṯ.» <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />kan rebbiy amyuh yeṣereḍ g rbiƹ n lγabeṯ lliy yetrefref ijuwas aḏ yetemluweḥ al ača g timsi. muc kennim bjel bac afenisireḍ? ayya lliy liymanuwem ḍƹiyf.<verse eid="MAT 6:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 6:31" />witteggec lhem n ddunyeṯ af tḵerminuwem, wimelec matta aneč, naγ matta ansu, naγ matta anireḍ? <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />ayuh n iḥajeyen lkul ttezelen fellesen midden lliy witemnenc s rebbiy. rahiy babewem lliy yella g ujenna yessen lliy tetestḥeqqemt lkul. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />amma kennim zleṯ deffer lmelekuwt n rebbiy aḏ matta yexs. aḏ netta ta yerniy afenyuc ayuh n iḥajeyen lkul.<verse eid="MAT 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 6:34" />witxemmemmec af ača. rahiy lliy n ača djet y ača. wireniṯec y kul as lhem af lliy diyes.»<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">wiḥekmec af ttenyaṯ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />«wiḥekmec af midden bac wiḥekmc fellewem rebbiy. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />rahiy mammeḵ tḥekemem af midden rebbiy tayḥekm fellewem. aḏ mammeḵ tesmuqelmasen tafenyesmuqel rebbiy.<verse eid="MAT 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3" />maγer tzarreḏ tesfeft g ṭiṭ n uwaḵ, lekenti witzerc sγer lliy g ṭiṭiḵ? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />mammeḵ temmaleḏ y uwaḵ: &lt; djiḏ asefγeγ tesfeft seg ṭiṭiḵ. &gt; aḏ witettaric lbaliḵ al sγer lliy g ṭiṭiḵ. <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />ayya lliy tseḵaneḏ g imaniḵ, seffeγ saƹa sγer seg ṭiṭiḵ bac azerreḏ yeqƹeḏ mammeḵ akseḏ tesfeft seg ṭiṭ n uwaḵ.<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />wittucec matta yemquddes y iṭṭan naγ anden fellawem we afenmezemzen. aḏ witluḥec ljuher zzaṯ iḥellufen, naγ atrefsen adug idernesen.<verse eid="MAT 7:6" /></para>
  <para style="s">rebbiy ituc y mam iḍelbi</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />mleṯ: &lt; uceneγ. &gt; afenyuc rebbiy, urzuṯ, aḏefem, uwatteṯ af lbab afennimir. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />rahiy lliy aymel uciḏ ayelqa, aḏ lliy ayurzu ayef, aḏ lliy aywet af lbab aymir zzaṯis. <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />zeƹma almiy yjen siwem yeḍlebi memmis g aγrum tasyuc aḍγaγ? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />naγ almiy yeḍlebi g trebit zeƹma tasyuc telefsa? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />kan kennim lliy witteḥlim tessennem mammeḵ aḏucem y ṭarwiwiṯuwem ḥaja teṣbiḥt. rahiy babuwem lliy g ujenna bjel bac ayuc ḥaja d ṣbiḥ y lliy ḍelben diyes.<verse eid="MAT 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />ggeṯ yid midden mammeḵ texsem aggen midden iḏuwem. rahiy d ayuh d matta yused g cceriyƹeṯ n muwsa aḏ g lliy uγentiḏ lenbiya.<verse eid="MAT 7:12" /></para>
  <para style="s">lbab lliy yeḍyeq</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />ḏfeṯ seg lbab lliy yeḍyeq. rahiy lbab lliy yugay al tmettant yuseƹ aḏ abriyḏis yezhel, aḏ ggeṯ d midden tƹeddan siyes. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />mennit naγ mennit yeḍyeq aḏ yuƹer abriyḏ lliy yugay al tmeddurt, aḏ fercu d midden ttefent.<verse eid="MAT 7:14" /></para>
  <para style="s">seg lγeltesen atensnem</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />rreṯ lbaluwem seg lliy tteren imanesen d lenbiya s tkerkas. atesnawemd am izmaren. lekenti nihnin s jjaj d leḏyub tmetrecen. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />seg lγeltesen atensnem. yaxy tesekkumt tattaru tizurin? naγ teceƹƹelt tattaγed imečan? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />amyuh, kul ccejreṯ teṣbiḥt tettuc lγelleṯ teṣbiḥt, amma ccejreṯ lliy witteḥli rahiy tettuc lγelleṯ witḥeli. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />ccejreṯ teṣbiḥt witettuc lγelleṯ witteḥli, aḏ ccejreṯ lliy witḥeli witettuc lγelleṯ teṣbiḥt. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />aḏ kul ccejreṯ witettuc lγelleṯ teṣbiḥt atemmuqdaƹ we atemluweḥ g timsi. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />amyuh seg lγeltesen atensnem.<verse eid="MAT 7:20" /></para>
  <para style="s">s igga muc s dwiy</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />muc kul yjen yemmaliḏ: &lt; ayya siydneγ. &gt; am idin, tayeḏef al lmelekuwt n ujenna lekenti lliy iteg mag yexs baba lliy g ujenna tasyeḏef. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />as diyn talemlen ggeṯ d midden: &lt; ayya siydneγ ayya siydneγ. yaxy muc s ismiḵ nufley y midden aḏ s ismiḵ nzeƹzeq cyaḍen, aḏ s ismiḵ negga lmuƹjizaṯ ggeṯ. &gt; <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />lekenti lweqt ḏḏin tasenemleγ: &lt; wifensineγc xlaṣ, beƹdeṯ fella ayya lliy tteggen ibekkaḍn. &gt;<verse eid="MAT 7:23" /></para>
  <para style="s">tenfust n tezeqqa lliy tebna af ṣṣeḥ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />kul yjen aysel dwiyw wuhnit we ayeg felles netta am argaz yessen ayebna tezeqqas af ṣṣeḥ. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />yaxy yezwad anzar, uzellen aman, yekkerred aḍu, wetten ayuh n tzaqqa. lekenti witudic afelxaḍert tebna af ṣṣeḥ.<verse eid="MAT 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 7:26" />aḏ kul yjen aysel dwiyw wuhnit aḏ witegc siyes, netta am argaz wiysenc. yebna tezeqqas af tammurt d safi. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />yaxy yezwad anzar, uzellen aman, yekkerred aḍu, wetten aydin n tzaqqa tuda lkulha.» <verse eid="MAT 7:27" /><verse number="28" style="v" sid="MAT 7:28" />mniyn ykemmel yesuwƹ dwiys ṯƹejben midden seg lqudretis af seḥfeḍ. <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />afelxaḍert rebbiy yuces lqudreṯ bac atenyesseḥfaḍ s γares muc am indin lliy seḥfeḍen g cceriyƹeṯ.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">yesuwƹ yesseḥla lliy yejdem</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />mniyn yezwa seg jbel ḏbeƹƹent ggeṯ d midden. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />yaxy argaz yejdem yusesd. yesjeḏḏas. yuwayas: «ayya siydneγ kan cek texseḏ rahiy tetqudduḏ ltseḥliḏ we altmukkeseḏ njestiw.» <verse eid="MAT 8:2" /><verse number="3" style="v" sid="MAT 8:3" />yaxy yezzel fusis, yeṭṭef diyes, yuwa: «ih xseγ, turuh aḥliḏ.» ƹlewleh imukes ljdam n wargaz. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />aḏ yuwayas yesuwƹ: «arr lbaliḵ wimmal y ḥed, amma barra bac afizer lkahen we ayecheḏ, aḏ uc lweƹdeṯ lliy yuwa felles muwsa bac asennen midden lliy cek teḥliḏ.»<verse eid="MAT 8:4" /></para>
  <para style="s">seḥli n xdim n lqayed n 100</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />mniyn yuḏef yesuwƹ al tmura n kefrnaḥuwm, yusesd yjen d lqayed n 100 g ljiyc n ruwma yetjeheyas. <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />yemmal: «ayya siydneγ rahiy xdimiw yemcul aḏ yuγa mkanis g tzaqqa, aḏ γares ggeṯ d aγenna.»<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />yaxy yuwayas yesuwƹ: «tareḥeγ atseḥliγ.»<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />yerras lqayed n 100: «ayya siydneγ neči wistehlexc bac aḏeḏfeḏ al tzaqqaw. amma mmel tuflayt akehaw bac ayeḥla xdimiw. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />neči γari mam iḥekkem diyi, aḏ γari zada irgazen ḥekmeγ disen, lemmi mleγ y yjen sisen: &lt; barra. &gt; ayreḥ, naγ y ttani: &lt; sed. &gt; adyas. aḏ y xdimiw: &lt; agg ayuh. &gt; ayeg.»<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />mniyn yesla yesuwƹ aydin yeṯƹejjeb aḏ yuwa y lliy debƹen diyes: «lḥeq afenemleγ: wiḏḏufixc ḥetta d yjen seg israyil yesteƹqeḏ diyi am ayuh n argaz.» <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />aḏ zada afenemleγ: «ggeṯ d midden iberiyen tadesen s mcerreq aḏ mγerreb we afraḥen yid ibrahiym aḏ isḥaq aḏ yeƹquwb g lmelekuwt n ujenna. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />amma israyiliyen lliy yusi γaresen lḥeq aḏeḏfen al lmelekuwt tamlewḥen gi tellest n barra mani taƹeyyeden we aγezzen cwerbesen s uγenna.»<verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />yuwa yesuwƹ y lqayed n 100: «barra. rahiy rebbiy tafyuc lliy teḍlebaḏ afelxaḍert tumeneḏ.» aḏ g lweqt ḏḏin, yeḥla xdimis.<verse eid="MAT 8:13" /></para>
  <para style="s">temeḥliwt n tensibt n buṭrus</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />aḏ ireḥ yesuwƹ al lḥuc n buṭrus, yufa tensibtis tezzel g umkanis γares lḥmu. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />yaxy yeṭṭef g fusis, ireḥ lḥmu fellas, tekker teteggasen matta xsen.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />ina n tfuyt, uγennesd midden ggeṯ seg indin lliy ttwesknen s cyaḍen. aḏ yusi yezzeƹzeq g cyaḍen s tuflayt, aḏ yseḥla imuḍan lkul <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />amyuh yentem lliy yuwa felles seg almiy nnabiy icƹeya:</para>
  <para style="p" vid="MAT 8:17" />
  <para style="q1" vid="MAT 8:17">«netta iƹana</para>
  <para style="q1" vid="MAT 8:17">aḏ yuḍen g umkanenneγ.»<verse eid="MAT 8:17" /></para>
  <para style="s">ssum n weḏbaƹ n yesuwƹ</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />mniyn yezra yesuwƹ midden amleymen tmas yuwa y tlamḏes aqedƹen iylel al lḥacit ttani. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />yaxy yeqrebbesd yjen seg lliy seḥfeḍen g cceriyƹeṯ yuwayas: «ayya lmuƹellem, tareḥeγ iḏeḵ mani tareḥeḏ.»<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />yaxy yerras yesuwƹ: «ṯƹaleb γarsen iburriƹen, aḏ iciwciwen lliy g ujenna γarsen nguwen amma neči lliy yeḏwel d bnaḏem wiγric mkan aseḏkiγ al γares ixfiw.»<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />aḏ yuwayas yjen iḍen seg tlamḏes: «ayya siydneγ djiḏ areḥeγ saƹa anebleγ baba.»<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />yaxy yerras yesuwƹ: «yya iḏiy tedjeḏ lliy mmuṯen aneblen lliy mmuṯnasen.»<verse eid="MAT 8:22" /></para>
  <para style="s">yesuwƹ yesserkaḥ g aḍu</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />wembeƹd yuli al leflukeṯ, aḏ ḏbeƹƹent tlamḏes. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />yaxy yekkerred aḍu d meqqar g iylel almiy ḥeḍerbac tenbelen aman lflukeṯ.</para>
  <para style="p" vid="MAT 8:24">aḏ yusi netta yeṭṭes. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />reḥnas tlamḏes fiseƹ ssekkeren diyes mmalen: «ayya siydneγ semmenƹaneγ rahiy tanemmeṯ.» <verse eid="MAT 8:25" /><verse number="26" style="v" sid="MAT 8:26" />yaxy yuwayasen: «maγer tugeḏḏem? ayya lliy liymanuwem ḍƹiyf.» wembeƹd yekker yezher af aḍu aḏ iylel. yaxy yersa aḍu. <verse eid="MAT 8:26" /><verse number="27" style="v" sid="MAT 8:27" />yaxy ṯƹejben midden uwan: «zeƹma d mam wuhnit bac asyeγ rrey aḍu aḏ iylel?»<verse eid="MAT 8:27" /></para>
  <para style="s">zeƹzeq n cyaḍen aḏ aγreq n iḥellufen</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />mniyn yuṣel yesuwƹ al lḥacit ttani g lḥumeṯ n ijedriyen laqent sen irgazen skenenten cyaḍen aḏ nihnin ffaγen seg amas n leqbur, aḏ nihnin d iweƹƹeren ggeṯ, aḏ ḥetta d yjen wiyetquddu ayƹedda seg aydin n abriyḏ. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />aḏ fiseƹ ṣeyḥen: «matta texseḏ s γarneγ ay memmis n rebbiy? yaxy tusid al dehnit qebbel lweqt bac aγenteƹeḏbeḏ?»<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />aḏ tusi tereslit n iḥellufen tferreḏ tmasen. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />yaxy uwan cyaḍen y yesuwƹ: «kan texseḏ aγenetzeƹzqeḏ, nekyaneγ al ayuh n treslit n iḥellufen.» <verse eid="MAT 8:31" /><verse number="32" style="v" sid="MAT 8:32" />yuwayasen: «berreṯ.» ffaγen aḏ ḥewlen al treslit n iḥellufen. yaxy uzellen iḥellufen fiseƹ aḏ udan s nnaj jbel g iylel aγreqqen diyes.<verse eid="MAT 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 8:33" />aḏ rwellen lliy sefreḏen s iḥellufen al tmura aḏ uwan af mag iṣar lkul y lliy ttwesknen. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />yaxy feγend midden n tmura bac aleqan yesuwƹ. mniyn zrent uwanas ayeffeγ s γarsen.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">temeḥliwt n umeclul</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />wembeƹd yuli yesuwƹ af leflukeṯ yeqdeƹ iylel yeḏwel al lḥumtis. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />yaxy usend midden uγend meclul yezzel. mniyn yezra yesuwƹ liymanesen, yuwa y umeclul: «witteggec ay memmi. rahiy ttweγferen ibekkaḍniḵ.» <verse eid="MAT 9:2" /><verse number="3" style="v" sid="MAT 9:3" />uwan lbeƹḍ n lliy seḥfeḍen g cceriyƹeṯ y imanesen: «rahiy yeṯƹedda af rebbiy.» <verse eid="MAT 9:3" /><verse number="4" style="v" sid="MAT 9:4" />yefhem yesuwƹ lliy txemmemmen diyes, ysestnin: «maγer ulawnewem txemmemmen g ccer? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />mantan yezhel iṭer immal ttweγfereneḵ ibekkaḍniḵ naγ immal n kker yyur? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />lekenti uwiγ ayuh bac asnem lliy tqudduγ neči lliy yeḏwel d bnaḏem aγfreγ bekkeḍu g tammurt.» lweqt ḏḏin, yuwa y umeclul: «kker qam tesuytiḵ truḥeḏ al lḥuciḵ.» <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />yekker, iruweḥ al lḥucis. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />mniyn zren midden aydin, fehhen aḏ mejden rebbiy lliy yuca y bnaḏem am ayuh n uquddu.<verse eid="MAT 9:8" /></para>
  <para style="s">yesuwƹ yesγuyu af metta</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />iƹedda yesuwƹ tman mkan n ulayem n ḍḍereyeb, yezra yjen seg indin lliy tlayemen g ḍḍereyeb, ismis metta ygaƹmez dinet. yaxy yuwayas: «ḏbeƹiḏ.» yekker yeḏbeƹi. <verse eid="MAT 9:9" /><verse number="10" style="v" sid="MAT 9:10" />mniyn yusi yesuwƹ yenneḍ af ṭṭewleṯ netta aḏ midden gi tzaqqa n metta, usend ggeṯ seg indin lliy tlayemen ḍḍereyeb aḏ lliy wiḥlin nnaḍḍen yid yesuwƹ aḏ tlamḏes af ṭṭewleṯ bac ačan. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />zren iferysiyyen aydin, uwan y tlamḏes: «maγer itet lmuƹelmewem yid indin lliy tlayemen g ḍḍereyeb, aḏ wiḥlin.» <verse eid="MAT 9:11" /><verse number="12" style="v" sid="MAT 9:12" />yesla yesuwƹ dwiysen, yuwa: «muc lliy wuḍinenc xsen ḍbib amma lliy uḍennen. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />berreṯ ḥfdeṯ lmeƹna n dwiy n rebbiy: &lt; rahiy neči xseγ rreḥmeṯ muc lweƹdeṯ. &gt; neči widdusixc bac aṣelḥeγ lliy tḥasben imanesen d ṣbiḥen, amma usiγd bac aṣelḥeγ lliy sennen imanesen γalṭin.»<verse eid="MAT 9:13" /></para>
  <para style="s">dwiy af uzum</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />wembeƹd yyuren tlamḏ n yaḥya al yesuwƹ sestunen diyes: «maγer witẓwumenc tlamḏeḵ aḏ neccin aḏ iferysiyyen netẓwumu.» <verse eid="MAT 9:14" /><verse number="15" style="v" sid="MAT 9:15" />yuwayasen yesuwƹ</para>
  <para style="p" vid="MAT 9:15">«ẓeƹma lliy g temeγra tẓwumen madam laƹrus jaresen? lekenti tadesen ussan aydel disen laƹrus yemqam seg jaresen lweqt ḏḏin taẓwumen.<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />ḥetta d yjen wiyetreqqeƹ ḥaja teqdimt s lqmac jdiḏ afelxaḍert truqƹet tejdit tatenzeγ qdim we ayeḏwel burriƹ d meqqar iṭer.<verse eid="MAT 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 9:17" />midden witeggenc crab jdiḏ g lmezweḏ d qdim afelxaḍert ttegeḏen ayekkeṣ lmezweḏ we ayefseḏ aḏ aywezzeƹ crab. lekenti tteggen crab jdiḏ g lmezweḏ jdiḏ bac asteḥfden af crab aḏ lmezweḏ jmiyƹ.»<verse eid="MAT 9:17" /></para>
  <para style="s">yesuwƹ yesseder yellis n yjen seg imeqqaren</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />mniyn netta yemmal g ayuh n dwiy, yusesd meqqar n lmjameƹ yesjeḏ zzeṯis yuwa: <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />«yelli turuh temmuṯ, amma sed agg felles fusiḵ adj atekker.» yekker yesuwƹ yeḏbeƹƹi aḏ yiḏes tlamḏes.<verse eid="MAT 9:19" /></para>
  <para style="s">temeḥliwt n lliy iḏemnis ttezelen</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />diyes temeṭṭuṯ γares 12 d isuggasen iḏemnis tezzalen. tusesd al yesuwƹ teṭṭef g temma n rdis s deffer, <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />afelxaḍert tuwa y imanis: «lukan aṭfeγ ḥetta g temma n rdis aḥliγ.» <verse eid="MAT 9:21" /><verse number="22" style="v" sid="MAT 9:22" />yaxy yenneḍ yesuwƹ yezriṯ, yuwa: «ay yelli, witteggec. rahiy liymanim yseḥlayem.» teḥla temeṭṭuṯ seg lweqt ḏḏin. <verse eid="MAT 9:22" /><verse number="23" style="v" sid="MAT 9:23" />mniyn yuḏef yesuwƹ al tezeqqa n umeqqar n lmjemeƹ aḏ yezra lliy čeṯen g tcebbebt aḏ lliy sgujduren. <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />yuwa: «rewḥeṯ. rahiy tefruxt wittemmuṯc lekenti teṭṭes.» ṣṣen felles. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />ysefγ midden aḏ yuḏef yeṭṭef tefruxt seg fusis tekker. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />aḏ slen s ayuh midden lkul g aydin n lblad.<verse eid="MAT 9:26" /></para>
  <para style="s">yesuwƹ yesseḥla sen ileƹmayen</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />mniyn yesuwƹ yekker tayreweḥ s yin ḏbeƹƹent sen ileƹmayen tṣeyḥen mmalen: «reḥmaneγ ay memmis n dawud.» <verse eid="MAT 9:27" /><verse number="28" style="v" sid="MAT 9:28" />ḏbeƹent ḥetta mniyn yuḏef al lḥuc. yaxy ysestnin: «tetemnem lliy neči tqudduγ aggeγ ayuh?» uwanas: «ayya, ayya siydneγ.» <verse eid="MAT 9:28" /><verse number="29" style="v" sid="MAT 9:29" />yeggi ifesnis af ṭiṭewinesen yuwa: «tafenyuc rebbiy af lḥsab n liymanuwem.» <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />yaxy mirneṯ ṭiṭewinesen. aḏ yesuwƹ yuwayasen: «rreṯ lbaluwem ammelem y ḥed.» <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />lekenti reḥḥen uwan y midden lkul g aydin n lblad.<verse eid="MAT 9:31" /></para>
  <para style="s">bekkuc lliy yufley</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />mniyn seddiγ ffeγen yen n sen, uγennesd midden bekkuc yeskenni cciyḍan. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />yesuwƹ izeƹzeq cciyḍan yuflay bekkuc. yaxy fehhen midden uwan: «ƹemris winezri am ayuh xlaṣ g israyil.» <verse eid="MAT 9:33" /><verse number="34" style="v" sid="MAT 9:34" />amma iferysiyyen uwan: «rahiy netta yezzeƹzeq g cyaḍen s rreys n cyaḍen.»<verse eid="MAT 9:34" /></para>
  <para style="s">ṣṣabeṯ temeqqart aḏ ixeddamen d fercu</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />yesuwƹ iṭenneḍ g itmurewin aḏ lḥumaṯ lkul. yesseḥfaḍ g lmjameƹ n wuḏeyen aḏ yetbeccer s lmelekuwt aḏ yesseḥla g midden seg ṭṭan lkul. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />yezra midden yesxef fellesen afelxaḍert wsiyn weddren tumexujen am tulli lliy widdic mam aysefreḏ sisneṯ. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />lweqt ḏḏin yuwa y tlamḏes: «diyes midden ggeṯ sugumen mam ateniwi al lmelekuwt n ujenna am ṣṣabeṯ n timzin lliy tejra y tmira γiyr widdic mam atetilayem. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />ḍlbeṯ s rebbiy asenyenkiy lliy lhan sisen we asensiḵnen abriyḏ n lmelekuwt n ujenna.»<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">imersal 12</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />wembeƹd yesγuy af tlamḏes lliy nihnin 12. yucesen lqudreṯ af cyaḍen bac atenzeƹezqen we aseḥlen lliy uḍennen. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />qa inuh d ismawen n imersal 12: simƹan lliy mmalnas buṭrus, aḏ andrawus uwas, aḏ yeƹquwb memmis n zebediy aḏ yuwḥenna uwas, <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />aḏ filibbus aḏ berṯelmawus, aḏ tuwma, aḏ metta lliy yetlayem g ḍḍeribeṯ, aḏ yeƹquwb memmis n ḥelfa, aḏ teddawus, <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />aḏ simƹan lliy inaγγer af lbladis, aḏ yehuwḏa lliy mmelnas lesxeryuwṭiyi, aḏ lliy tayxan yesuwƹ.<verse eid="MAT 10:4" /></para>
  <para style="s">yesuwƹ inekki g imersal</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />ayuh n imersal 12 yenkiyin yesuwƹ aḏ iweṣṣayin yuwa:</para>
  <para style="p" vid="MAT 10:5">«witreḥec al lliy muc d wuḏeyen, aḏ witteḏfec timurawin n ssamira. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />amma ureḥeṯ al israyiliyen lliy weddren am tulli. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />lemmi teggurem becreṯ temlem: &lt; rahiy yeqrebbed lmelekuwt n ujenna. &gt; <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />lliy uḍennen seḥlaten, aḏ lliy mmuṯen sekretten, aḏ lliy jdemmen kkestasen njestesen, aḏ cyaḍen zeƹzqetten. aḏ mammeḵ yucewem rebbiy s blac uceṯ s blac. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />wugeyec iḏuwem iflusen naγ wureγ, aḏ lfejreṯ aḏ nḥas. <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />almiy tarezfem wugeyec teckert naγ ttebdileṯ n uṣireḍ aḏ ssebaṭ aḏ ageṭṭum iḍen. rahiy rebbiy tafenyuc matta teteḥteqemt.<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />aḏ kul man aḏeḏfem al tmura naγ al lḥumeṯ urzuṯ diyes af mam iferreḥ siwem teqqimem γares dinet almiy aruḥem. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />lemmi aḏeḏfem al tezeqqas selmeṯ af middenes. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />kan midden n aydin n tezeqqa stahelen nembelḥeq adj ayezwa slam n rebbiy fellesen. amma kan wistehlenc afenedyer slamwem. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />kan ḥetta ḥed g tzaqqa naγ g tmura wiyefreḥ siwem aḏ wiyesseγd dwiywem, fγeṯ s yin tezzelzem lγubreṯ n idernuwem. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />lḥeq afenemleγ. rahiy lḥaleṯ n seduwm aḏ ƹemuwra xiyr n lḥaleṯ n aydin n tmura g as n lḥesab.<verse eid="MAT 10:15" /></para>
  <para style="s">tƹeb lliy yesugum g tlamḏa</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />qa neči tafennekiyeγ am izmaren jar leḏyub. rreṯ lbaluwem am tilefsiwin teqqimem ƹeqlin am tmelliwin. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />rreṯ lbaluwem seg midden. rahiy tafennuwyen al lmḥakem we afenwetten s ṣṣuwṭ g lmjameƹesen. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />we afennuyen bac abeddem zzaṯ lḥukkam aḏ lmuluk afelxaḍriw. we acehdem iḏiy zzaṯ wuḏeyen aḏ zzaṯ midden ttaniyeṯ lkul. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />lemmi afenneṭfen, witteḥterec mammeḵ aḏuflayem naγ matta temlem. rahiy lweqt ḏḏin tafenyisiḵen rebbiy man amlem. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />muc kennim lliy taḏuflayem amma d rruwḥ n babewem lliy tayuflay af imewenuwem.<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />tayuc kul yjen uwas y tmettant, ahuwnen ibaban ṭarwesen, we anden imeckenen af ibabnesen atennenγen. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />we afenkerhen midden lkul afelxaḍert n ismiw, lekenti lliy ayeṣber al llexert ayemnaƹ. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />kan durnewem g itmura seg tmurewin, rruleṯ al γiyris. lḥeq afenemleγ: witetriḥemc al tmurewin n israyil lkul qebbel man adaseγ neči lliy yeḏwel d bnaḏem.<verse eid="MAT 10:23" /></para>
  <para style="s">witegeḏec</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />lliy yeseƹzam xiyr n tilmiḏes, aḏ ṣeyed xiyr n xdimis. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />lukan aydel tilmiḏ am lliy yeseƹzam diyes yeziyas, lukan aydel xdim am siydis yeziyas. kan nihnin uwan y bab n tzaqqa: &lt; ay beƹelzebul. &gt; nihnin ṯabet subben nnasnis lkul.<verse eid="MAT 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />wittegeṯec sisen, afelxaḍert wiyetqimi ḥaja g cceḥden aḏ lliy yeḥrez tadyeḍher. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />lliy mmelγawem felles g itellest amlet g ddu, aḏ lliy tsellem diyes d awecwec amlet af leḥyuḍ. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />wittegeṯec seg indin lliy neγγen lbden akehaw afelxaḍert witquddunc anγen rruwḥ. amma gdaṯ seg lliy yetquddu ayenγ rruwḥ aḏ lbden jmiyƹ g jhennem. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />yaxy muc nezzen sen iciwciwen s lfrenk yjen? aḏ witutṭi ḥetta d yjen sisen al tammurt man γiyr man ayessen siyes babewem. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />amma kennim rebbiy yessen ḥetta lƹeded n udjuf n ixfewnewem lkul. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />mala wittegeṯec. rahiy kennim xiyr n ggeṯ d iciwciwen.<verse eid="MAT 10:31" /></para>
  <para style="s">steƹref s lmesiyḥ naγ tettuytis</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />kul yjen ayesteƹref siyyi zzaṯ midden, steƹrfeγ siyes neči zzaṯ baba lliy g ujenna. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />aḏ kul yjen wiyesteƹrifc siyyi zzaṯ midden, wisteƹrifexc neči siyes zzaṯ baba lliy g ujenna.<verse eid="MAT 10:33" /></para>
  <para style="s">yesuwƹ aḏ midden</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />widdunnuṯec lliy usiγd bac aggeγ slam af tammurt. widdusixc bac aggeγ slam amma uγiγd nuγu. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />usiγd bac arreγ kul yjen yetnuγu yid babis, we asnuγeγ tefruxt yid yedjis, we asnuγeγ tesliṯ yid teḏuggaltis. <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />amyuh addel jar irnawen leƹdaweṯ.<verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />memmun yexs babis naγ yedjis iṭriw wilyestahelc. aḏ mam yexs memmis naγ yellis iṭriw wilyestahelc. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />aḏ mam wiyetqudduc ayeṣber af lƹeḏeb n ṣṣelib, wilyestahelc. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />lliy ikerc g tmeddurtis atetyexser, aḏ lliy yexser temeddurtis afelxaḍriw tatetyerbeḥ.<verse eid="MAT 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />lliy yeqbellewem yeqbelliḏ. aḏ lliy yeqbelliḏ yeqbel lliy yenkiyiḏ. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />lliy yefreḥ s nnabiy afelxaḍert netta d nnabiy. rahiy tayelqa ṯweb n nnabiy. aḏ mam yefreḥ s argaz d ṣbiḥ afelxaḍert netta d ṣbiḥ. rahiy tayelqa ṯweb n yjen d ṣbiḥ. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />aḏ kul yjen yuca ḥetta kan lkas n aman yebreḏ y yjen seg ayuh n imeckunen afelxaḍert netta d tilmiḏiw, lḥeq afenemleγ: rahiy ṯwebis wiyetḍiƹc xlaṣ.»<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">yesuwƹ aḏ yuwḥenna lmeƹmedan</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />beƹd mag ykemmel yesuwƹ aweṣṣi n tlamḏes lliy nihnin 12. iḥewel s yin ireḥ yesseḥfaḍ aḏ yetbeccer g tmurewin. <verse eid="MAT 11:1" /><verse number="2" style="v" sid="MAT 11:2" />mniyn yesla yaḥya lliy yusi g lḥebs matta yeggi lmesiyḥ, yenkiyas lbeƹḍ n tlamḏes. <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />yesestun: «d cekkin d lmesiyḥ lliy tadyas naγ ansugem γiyriḵ?» <verse eid="MAT 11:3" /><verse number="4" style="v" sid="MAT 11:4" />yaxy yerrasen yesuwƹ yuwa: «berreṯ, amlet y yaḥya lliy teslim aḏ lliy tezrim: <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />lliy aƹman zren, aḏ lƹeybin yyuren, aḏ lliy jdemmen ḥlan aḏ tmukes njestasen, aḏ ibekkucen uflayen, aḏ lliy mmuṯen kkeren, aḏ lbcereṯ tetaṣel al iqellilen. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />ayya sseƹdis lliy witetmukuc ṯiqtis diyi.» <verse eid="MAT 11:6" /><verse number="7" style="v" sid="MAT 11:7" />mniyn ffeγen tlamḏa n yaḥya, yuḏel yesuwƹ ydugga af yaḥya y midden yemmal:</para>
  <para style="p" vid="MAT 11:7">«af matta truzum g ṣṣeḥreṯ? yenda truzum af teqeṣbayt yethuzzu diyes aḍu? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />naγ truzum af argaz ireḍ lḥweyej ṣbiḥen? rahiy lliy reḍen g lḥweyej ṣbiḥen llan g leqṣur n lmluk. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />mala matta texsem azrem γaḍih? kan texsem azrem nnabiy. rahiy netta iṭer n nnabiy. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />aḏ d netta lliy yetweri felles g lktab: «qa tanekyeγ zzaṯiḵ mersuliw lliy tafiseḥder abriyḏiḵ.» <verse eid="MAT 11:10" /><verse number="11" style="v" sid="MAT 11:11" />lḥeq afenemleγ: widuγineṯ tiseḏnan xlaṣ yjen xiyr n yaḥya lmeƹmedan g ddunyeṯ. lekenti meckun g lmelekuwt n ujenna xiris.<verse eid="MAT 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 11:12" />rahiy s manis yuḏel yaḥya lmeƹmedan yetbeccer, uḏellen midden tzaḥamen af imi n lmelekuwt n ujenna aḏ kul yjen sisen yexs ayeḏef d mezwar, <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />afelxaḍert cceriyƹeṯ n muwsa aḏ lenbiya lkul becren s lmelekuwt n ujenna lliy yeḍherred seg ussan n yaḥya. <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />kan texsem aḏemnem. rahiy yaḥya wuh d netta d iyliya lliy tesugumem diyes adyer. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />sseγdeṯ yeqƹeḏ kan γarwem timezzuγin.<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />s mam tacebheγ ayuh n ljiyl? nihnin am imeckenen geƹmzen g amas n lḥumeṯ. sγuyun af beƹḍhum mmalen:<verse eid="MAT 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17" />&lt;nwettewem lmegrun, witerqisemc.</para>
  <para style="q2" vid="MAT 11:17">nesgujder zzaṯuwem witƹidemc. &gt;<verse eid="MAT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 11:18" />yused yaḥya lliy yetzumu aḏ wisesc crab. yaxy uwan: &lt; cciyḍan yeskenni. &gt; <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />wembeƹd usiγd neči lliy yeḏwel d bnaḏem tetteγ, sesseγ. yaxy uwan &lt;ayuh d argaz itet ggeṯ, aḏ yses g crab aḏ d ṣṣaḥeb n lliy tlayemen g ḍḍereyeb aḏ lliy γelden. &gt; lekenti lḥekmeṯ n rebbiy tatetesnen almiy zeren lfeyettis.»<verse eid="MAT 11:19" /></para>
  <para style="s">tmurewin lliy wittebenc</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />wembeƹd yuḏel yesuwƹ iḥemmeq af tmurewin lliy zrenneṯ ggeṯ seg lmuƹjizaṯis afelxaḍert midnesneṯ wittebenc.<verse eid="MAT 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 11:21" />yuwa: «y ḥlilek ay kurezin, y ḥlilek ay biyt ṣeyda, lukan yeggi rebbiy g ṣuwr aḏ ṣeyda matta yeggi diwem seg lmuƹjizaṯ rahiy taben midnesneṯ s luwel aḏ ireḍḍen ibercucen aḏ cetƹen iγeḍ af ixfewensen. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />lekenti tafenemleγ. rahiy lḥaleṯ n ṣuwr aḏ ṣeyda taddel xiyruwem g as n lḥesab.<verse eid="MAT 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 11:23" />aḏ cem ay kefrnaḥuwm, yenda tuliyyeḏ al ujenna? aha, qa tazwiḏ al lqeƹ n burriƹ n temettent. lmuƹjizaṯ lliy tezritent, lukan tezrineṯ seduwm. rahiy teqqim al as wuh. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />lekenti afenemleγ: as n lḥesab lḥeltwem taddel ḥref n lḥaleṯ n seduwm.»<verse eid="MAT 11:24" /></para>
  <para style="s">rebbiy yesiḵen y izeweliyen lliy yusi yecḥeḏḏi fellasen</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />aḏ g lweqt ḏḏin, yuflay yesuwƹ yuwa:</para>
  <para style="p" vid="MAT 11:25">«fḥemdeγ ay baba, rebbiy n ujenna aḏ tammurt, afelxaḍert teḥrezeḏ ayuh af lḥukema aḏ ifqihen aḏ tsiḵnet y lliy yetjed fellesen kul ciy am imeckenen. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />ay baba, amyuh mammeḵ texseḏ iṣar.»<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />«rahiy yuciḏ baba kul ciy. widdis ḥetta d yjen yeseniḏ nembelḥeq am baba. aḏ widdis ḥetta d yjen yessen baba nembelḥeq am neči. aḏ indin lliy tasentiḏsiḵneγ senent zada.<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />sted al γari, afenriḥeγ, ayya lliy taƹbin lkul seg ṯqel meqqar lliy af irewenwem. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />qameṯ sdeliw, ḥefdeṯ fella. rahiy neči d lƹeqel aḏ uliw d ṣbiḥ, iḏiy taṯhennan ulawnewem. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />sdel lliy s γari yezhel qamis, aḏ ṯqel lliy tafentiḏuceγ yexfif.»<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">dwiy af as n sebbeṯ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />lweqt ḏḏin iƹedda yesuwƹ jar imezdeγen as n sebbeṯ. yaxy lluzen tlamḏes uḏellen tqeṭfen g tisbulin n irden tteten. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />mniyn zrenten iferysiyyen uwanas: «qa tlamḏeḵ tteggen lliy ḥram igges as n sebbeṯ.» <verse eid="MAT 12:2" /><verse number="3" style="v" sid="MAT 12:3" />yerrasen.</para>
  <para style="p" vid="MAT 12:3">«yaxy witeƹzimemc matta yeggi dawud aḏ lliy yiḏes mniyn lluzen? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />yuḏef al tezeqqa n rebbiy. yeča tqurset n ṣṣedqeṯ lliy yusi učus ḥram felles aḏ af lliy yiḏes, kan lkuhhan akhaw tqudden atečen. <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />naγ witeƹzimemc g cceriyƹeṯ n muwsa lliy lkuhhan xeḏmen g lheykel ḥetta g as n sebbeṯ, aḏ ayuh yusi γarsen muc d bekkeḍu? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />lekenti afenemleγ: qa yella dehnit mammun d meqqar iṭer n lheykel. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />aḏ luken tefhemmem lmeƹna n dwiy n rebbiy: &lt; neči xseγ rreḥmeṯ muc lweƹdeṯ. &gt; rahiy witteḥkimemc af lliy wiγersenc bekkeḍu. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />aḏ neči lliy yeḏwel d bnaḏem d bab n sebbeṯ.»<verse eid="MAT 12:8" /></para>
  <para style="s">temeḥliwt g as n sebbeṯ</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />wembeƹd iḥewel s yin yuḏef al lmjameƹesen. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />aḏ diyes argaz fusis yeqqur. aḏ weqt lliy smuḏen iferysiyyen attehmen, mleymen fellas sestnent: «yaxy ḥlal seḥli n imuḍan as n sebbeṯ.» <verse eid="MAT 12:10" /><verse number="11" style="v" sid="MAT 12:11" />yerrasen: «kan yjen siwem γares izmer yjen aḏ yudayes g burriƹ as n sebbeṯ. yaxy muc tatisemneƹ we atyeṭṭef? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />aḏ kennim tessennem lliy bnaḏem xiyr n izmer ggeṯ. mala igga n lxiyr as n sebbeṯ ḥlal.» <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />wembeƹd yuwa y argaz: «zzel fusiḵ.» yezzeliṯ. yaxy teḥla, teḏwel lebas ƹliha am ttani.<verse eid="MAT 12:13" /></para>
  <para style="s">lliy yuwa fellas nnabiy icƹeya nembelḥeq</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 12:14" />lekenti iferysiyyen ffeγen, mleymen af yesuwƹ bac atenγen. <verse eid="MAT 12:14" /><verse number="15" style="v" sid="MAT 12:15" />yesla sisen yeffeγ s yin aḏ ḏbeƹƹent ggeṯ d midden, yseḥlayin lkul. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />aḏ yuweyesen: «rreṯ lbaluwem amlem d mam neči.» <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />amyuh yentem lliy yused af imi n nnabiy icƹeya lliy yuwa seg lemmi:<verse eid="MAT 12:17" /></para>
  <para style="p" />
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />«qa wuhnit d lƹebdiw lliy wezixt.</para>
  <para style="q2" vid="MAT 12:18">aḏ lliy xsext,</para>
  <para style="q2" vid="MAT 12:18">siyes ferḥeγ ggeṯ.</para>
  <para style="q2" vid="MAT 12:18">tasezwiγ fellas rruwḥiw</para>
  <para style="q2" vid="MAT 12:18">bac aymel af lḥeq y midden ttaniyeṯ.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />wiyetnuγuc, wiyetṣedeƹc,</para>
  <para style="q2" vid="MAT 12:19">aḏ wisseγdi ḥetta d yjen ṣṣutis g ubriḏ.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />wiyetrezic teqeṣbeyt ḥetta lukan teceqqeq,</para>
  <para style="q2" vid="MAT 12:20">aḏ wiyesbessic teftilt ḥetta lukan teddexen</para>
  <para style="q2" vid="MAT 12:20">almiy adyeḍher lḥeq,<verse eid="MAT 12:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="MAT 12:21" />we asteƹqeḏen midden g ismis.»<verse eid="MAT 12:21" /></para>
  <para style="s">yesuwƹ yid beƹelzebul</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />wembeƹd uγennesd argaz yeƹma aḏ d bekkuc aḏ yeskenni cciyḍan, yseḥlayi, yeḏwel izer aḏ ydugga. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />ṯƹejben midden lkul uwan: «balek wuh d memmis n dawud.» <verse eid="MAT 12:23" /><verse number="24" style="v" sid="MAT 12:24" />mniyn iferysiyyen slen ayuh uwan: «wiyezzeƹziq cyaḍen kan s beƹelzebul meqqar n cyaḍen.» <verse eid="MAT 12:24" /><verse number="25" style="v" sid="MAT 12:25" />yesla yesuwƹ dwiysen. yaxy yuweyasen:</para>
  <para style="p" vid="MAT 12:25">«kul lmemlekeṯ atnuγun ṭarwes g beƹḍhum tatexreb. aḏ kul tmura naγ tezeqqa atnuγun ṭarwes tatuda. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />kan cciyḍan ayzeƹzeq cciyḍan tanuγun, almiy nuγun mammeḵ zeγ tateqqim lmemlektesen? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />aḏ kan neči zeƹzaqeγ g cyaḍen s beƹelzebul, ṭarwawem s mam tzaƹzeqenten? ayuh yeseḵen lliy dwiywem γaleṭ. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />lekenti kan s rruwḥ n rebbiy zeƹzaqeγ g cyaḍen. rahiy lmelekuwt n rebbiy yusewemd turuh. <verse eid="MAT 12:28" /><verse number="29" style="v" sid="MAT 12:29" />mmeltiḏ mammeḵ yetquddu yjen ayeḏef al lḥuc n yjen qwey we aywiy lliy diyes. rahiy wiyetqudduc ayeg amyuh kan wiyeqqinc qwi diyn qebbel.<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />lliy muc iḏiy rahiy d ḍḍeddiw, aḏ mam wiyetleyimc iḏiy yetferreq. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />afelxaḍert n ayuh afenemleγ: rahiy kul bekkeḍu aḏ aγlaḍ iγefri rebbiy y midden. amma tikerkas af rruwḥ lqudus wittiγefferc rebbiy. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />aḏ mam yuwa tuflayt fella neči lliy yeḏwel d bnaḏem astedyeγfer rebbiy. amma lliy yuwa tuflayt af rruwḥ lqudus wisteddiγefferc rebbiy g ddunyeṯ aḏ g laxert.<verse eid="MAT 12:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />kan ccejreṯ teṣbiḥt, tatuc lγelleṯ teṣbiḥt. amma kan ccejreṯ witteḥli tatuc lγelleṯ witteḥli. seg lγelleṯ asnem ccejreṯ. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />ay ṭarwa n tlefsiwin. mammeḵ tetqudum aḏ kennim witteḥlim aḏuflayem dwiy d ṣbiḥ? rahiy imi ydugga s matta yetfaḍ af ul. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />bnaḏem ṣbiḥ, seg ṣbiḥ lliy g ulis yettefγed matta d ṣbiḥ. aḏ bnaḏem lliy wiyeḥli yettefγed seg ulis matta wiyeḥli. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />amma tafenemleγ: as n lḥsab midden tamḥesben af dwiy n lbaṭel lkul. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />rahiy s dwiḵ amenƹeḏ naγ aḥesleḏ.»<verse eid="MAT 12:37" /></para>
  <para style="s">iferysiyyen ḍelben lmuƹjizaṯ</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />lweqt ḏḏin rennas lbeƹḍ n lliy seḥfeḍen g cceriyƹeṯ aḏ iferysiyyen uwan: «ayya lmuƹellem, nexs anzer lmuƹjizaṯ teteggetteṯ.» <verse eid="MAT 12:38" /><verse number="39" style="v" sid="MAT 12:39" />yaxy yuwayasen:</para>
  <para style="p" vid="MAT 12:39">«ljiyl lkafer lliy wiyeḥli idelleb g lmuƹjizaṯ. aḏ wisentetis kan lmuƹjizaṯ n nnabiy yuwnes. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />aḏ mammeḵ yeqqim yuwnes g jjar n trabit 3 d ussan aḏ iḍanaṯ, amyuh taqimeγ neči lliy yeḏwel d bnaḏem g jjar n tammurt 3 d ussan aḏ iḍanaṯ. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />takeren midden n ninwa as n lḥsab g uḏem n ayuh n ljiyl we acehden fellas, afelxaḍert nihnin taben mniyn yeḥmeqqesen yuwnes. aḏ qa turuh diyes mammun d meqqar iṭer aḏ xiyr n yuwnes. <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />tatekker lmelikeṯ n lqibelt g uḏem n ayuh n ljiyl as n leḥsab we atecheḏ fellas, afelxaḍert tused seg ṭṭerf n tammurt bac atesseγd y dwiy n suleyman. aḏ qa turuh diyes mam d meqqar iṭer aḏ xiyr n suleyman.<verse eid="MAT 12:42" /></para>
  <para style="s">riri n cciyḍan lliy yesken g midden</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />almiy ayeffeγ rruwḥ lliy yesken argaz seg midden ayenneḍ g lexla iruzzu af rreḥeṯ, lekenti witetyettifc. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />aymel: &lt; taḏuleγ al umkaniw lliy feγeγ siyes. &gt; we asyeḏwel, atyaf d lfareγ, yefreḍ yezƹem. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />we ayreḥ, we adyeγ yiḏes 7 d lerwaḥ iḍen wiḥlin iṭris, we aḏeḏfen lkul we aseknen g aydin n argaz. we addel lḥaleṯ n ayuh n argaz ḥref n lḥaltis temezwert. aḏ amyuh taddel lḥaleṯ n ayuh n ljiyl lliy wiyeḥli.»<verse eid="MAT 12:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />mniyn netta yusi ydugga y midden, yedjis aḏ yeṯmas wsiyn sugumen lberra xsen asufleyen. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />yaxy yuwayas yjen seg lliy ḥderren: «qa yedjiḵ aḏ ayeṯmaḵ bbedden barra axsen aḵuflayen.»<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />yerras: «d mam yemma? d mam yeṯma.» <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />aḏ yezzel fusis al tlamḏes yuwa: «inuh d yemma aḏ d yeṯma, <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />afelxaḍert kul yjen ayeg matta yexs baba lliy g ujenna netta d uwa aḏ weltma aḏ yemma.»<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">tenfust n lliy izerreƹ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />as diyn yeffeγ yesuwƹ seg tezeqqa ireḥ ygeƹmez af lḥacit n iylel. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />mlaymen felles midden ggeṯ almiy yuli al leflukeṯ ygeƹmez. aḏ bbedden midden af cceṭ. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />isiḵnesen ggeṯ d iḥajeyen s tinfes, yuwa:</para>
  <para style="p" vid="MAT 13:3">«yella yjen yeffeγ bac ayezreƹ, <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />mniyn netta izerreƹ tuda fercu n zzerriƹeṯ af ibriyḏen, usend iciwciwen čenteṯ. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />aḏ yuda lbeƹḍ siyes af tammurt diyes ggeṯ d iḍγaγen aḏ fercu n ijdi s nnaj. yaxy aγmiyented fiseƹ afelxaḍert ijdis yusi d fercu. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />mniyn tezγel tufuyt, ḥereqneṯ aḏ mmuṯneṯ afelxaḍert wiγarsnec leƹruq. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />aḏ yuda lbeƹḍ siyes jar ysennanen. yaxy mγeren ysennanen sγarentent. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />aḏ yuda lbeƹḍ siyes g tammurt teṣbiḥt. seg inuh yella lliy yuca 100 deqsis, aḏ yella lliy yuca 60 deqsis. aḏ yella lliy yuca 30 deqsis. <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />sseγdeṯ kan γarwem timezzuγin.»<verse eid="MAT 13:9" /></para>
  <para style="s">maγer yuflay lmesiyḥ s tinfes</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />yaxy usennesd tlamḏa sesetnent: «maγer tetdugidasen s tinfes?» <verse eid="MAT 13:10" /><verse number="11" style="v" sid="MAT 13:11" />yuwa</para>
  <para style="p" vid="MAT 13:11">«afelxaḍert isiḵenewem rebbiy lliy yeḥrez g lmelekuwt n ujenna. amma nihnin wisenisiḵenc aydin. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />rahiy lliy γares ayerni rebbiy asyuc we ayfaḍ, amma lliy wiγrec, ḥetta lliy yusi γares astiḏimukes. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />afelxaḍert n ayuh duggiγasen s tinfes. rahiy nihnin smuqulen man γiyr man azren, aḏ sellen man γiyr man asseγdan we afehmen. <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />amyuh yentem fellasen mag yuwa icƹeya seg lemmi:</para>
  <para style="p" vid="MAT 13:14" />
  <para style="q2" vid="MAT 13:14">&lt;temesliwt tsellem aḏ witfehmemc,</para>
  <para style="q2" vid="MAT 13:14">smuqul tesmuqulem aḏ witzerremc.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />afelxaḍert ul n ayuh n cceƹb yeḏwel d zuwer,</para>
  <para style="q2" vid="MAT 13:15">timezuγinesen ḏqelneṯ,</para>
  <para style="q2" vid="MAT 13:15">aḏ qebsen ṭiṭewinesen</para>
  <para style="q2" vid="MAT 13:15">bac wizzerenc sisneṯ,</para>
  <para style="q2" vid="MAT 13:15">aḏ wisellenc s tmuzzuγinesen,</para>
  <para style="q2" vid="MAT 13:15">aḏ wilfehmenc s ulawnesen,</para>
  <para style="q2" vid="MAT 13:15">wilderren al γari</para>
  <para style="q2" vid="MAT 13:15">bac atenseḥliγ. &gt;<verse eid="MAT 13:15" /></para>
  <para style="p" />
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />amma kennim ay yesseƹduwem s ṭiṭewin lliy zerneṯ, aḏ s tmezzuγin lliy seγdaneṯ. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />lḥeq afenemleγ, mennit naγ mennit ṯmennan lenbiya aḏ midden ṣbiḥen bac azren lliy tzarrem wizrinc, we aslen lliy tsellem wislinc.»<verse eid="MAT 13:17" /></para>
  <para style="s">siḵen n tenfust n lliy izerreƹ</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />«sseγdeṯ kennim lmeƹna n tenfust n lliy izerreƹ:<verse eid="MAT 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 13:19" />kul yjen aysel tuflayt n lmelekuwt aḏ witettifehhemc adyas cciyḍan ayexdef lliy yemmuzreƹ g ulis; ayuh d lliy yemmuzreƹ af ibriyḏen. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />amma lliy yemmuzreƹ af tammurt diyes ggeṯ d iḍγaγen; aydin d lliy aysel tuflayt we ayefreḥ siyes fiseƹ. <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />lekenti witettegc γares leƹruq, we ateqqim kan fercu, almiy ayuqeƹ ḍḍiq aḏ ḍḍulem afelxaḍert n tuflayt diyn ayuda.<verse eid="MAT 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 13:22" />amma lliy yemmuzreƹ jar ysennanen, netta d lliy yeseγda y tuflayt, lekenti lhem n lweqt aḏ temexsiwt n ddunyeṯ xenqen tuflayt diyn witettuc lγelleṯ. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />amma lliy yemmuzreƹ g tammurt teṣbiḥt, netta d lliy ayeṣeγd y tuflayt we atetyefhem. netta lliy tettuc zriyetis deqsis 100 naγ 60 naγ 30.»<verse eid="MAT 13:23" /></para>
  <para style="s">tenfust n irden aḏ irden n ileƹman</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />yerniy yuwayasen tenfust iḍen. yuwa:</para>
  <para style="p" vid="MAT 13:24">«lmelekuwt n ujenna am bnaḏem yezreƹ zzerriƹeṯ teṣbiḥt g umezdeγis. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />mniyn midden ṭṭesen, yused leƹduwis yezreƹ irden n ileγman g umezdeγ ireḥ.<verse eid="MAT 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 13:26" />aḏ mniyn aγmiyend irden aḏ ggen tisbulin ḍherend yiḏesen irden n ileγman. <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />yaxy reḥḥen ičiwen n bab n lḥuc, uwanas: &lt; ayya siydneγ muc tezreƹƹeḏ mezdeγiḵ s zzerriƹeṯ teṣbiḥt? manis zeγ usend ayuh n irden n ileγman?&gt;<verse eid="MAT 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28" />yerrasen: &lt; yjen d leƹdu yeggi ayuh. &gt;</para>
  <para style="p" vid="MAT 13:28">yaxy sesetnent: &lt; texseḏ anreḥ we anqelleƹ aydin n irden n ileγman?&gt;<verse eid="MAT 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29" />yaxy yerrasen: &lt; aha, naγ aksem irden ṣbiḥen almiy tetteksem irden n ileγman. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />djetten ameγren jmiyƹ al lweqt n mjar. aḏ lweqt ḏḏin amleγ y lliy tamejren: mjreṯ irden n ileγman teggemt d iguḏeyen bac ayemmuḥreq qebbel. wembeƹd mejreṯt irden ṣbiḥen teggemt g lmexzniw. &gt; »<verse eid="MAT 13:30" /></para>
  <para style="s">tenfust n zzerriƹeṯ n lxerweƹ</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />yerniy yucesen tenfust iḍen yuwa:</para>
  <para style="p" vid="MAT 13:31">«lmelekuwt n ujenna am zzerriƹeṯ n lxerweƹ yewyiṯ yjen yezreƹƹiṯ g umezdeγis. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />aḏ ayuh n zzerriƹeṯ lliy nettaṯ d ttemeckunt g zzerriƹeṯ lkul, almiy tatemγer tateḏwel temeqqart iṭer n lliy yeγmiyed g umezdeγ lkul we ateḏwel am ccejreṯ. we adesen iciwciwen aggen ngunesen af isγernis.»<verse eid="MAT 13:32" /></para>
  <para style="s">tenfust n lxmireṯ</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />yerniy yucesen tenfust iḍen, yuwa:</para>
  <para style="p" vid="MAT 13:33">«lmelekuwt n ujenna am lxmireṯ tewyiṯ temeṭṭuṯ terwiyeṯ g 3 n ṯṯemneṯ n ren. yaxy yuli lƹjin lkul.» <verse eid="MAT 13:33" /><verse number="34" style="v" sid="MAT 13:34" />af ayuh n iḥajeyen lkul yuflay yesuwƹ y midden s tinfes lliy wisenyufley kan sisneṯ. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />amyuh yentem lliy yused af imi n nnabiy lliy yuwa seg lemmi:</para>
  <para style="p" vid="MAT 13:35" />
  <para style="q1" vid="MAT 13:35">&lt;taḏufleyeγ s tinfes,</para>
  <para style="q1" vid="MAT 13:35">we asiḵneγ lliy yusi yeḥrez</para>
  <para style="q1" vid="MAT 13:35">seg luwel n ddunyeṯ. &gt;<verse eid="MAT 13:35" /></para>
  <para style="s">siḵen n tenfust n irden aḏ irden n ileγman</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />wembeƹd yedja yesuwƹ midden iruweḥ. yaxy reḥnas tlamḏes, uwanas: «siḵnaneγ tenfust n irden n ileγman lliy g umezdeγ.» <verse eid="MAT 13:36" /><verse number="37" style="v" sid="MAT 13:37" />yerrasen:</para>
  <para style="p" vid="MAT 13:37">«lliy izerreƹ zzerriƹeṯ teṣbiḥt netta d lliy yeḏwel d bnaḏem. <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />aḏ mezdeγ netta d ddunyeṯ. aḏ zzerriƹeṯ teṣbiḥt nettaṯ d ṭarwa n lmelekuwt. aḏ irden n ileγman d ṭarwa n umelƹun. <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />aḏ leƹdu lliy yezreƹ irden n ileγman netta d lblis. aḏ lweqt n mjar netta d laxer n ddunyeṯ. aḏ lliy medjren nihnin d lemleyka.<verse eid="MAT 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40" />aḏ mammeḵ mjeren irden n ileγman bac atenḥerqen s timsi, amyuh tayṣar g laxer n ddunyeṯ. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />tayenkiy lliy yeḏwel d bnaḏem lmlayektis asefγen seg lmelekuwtis lliy ssefsaḏen aḏ lliy tteggen g ubekkeḍu. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />we atenluḥen g timsi temeqqart, aḏ dinet ƹeyyeḍ aḏ aγezzi n cwerb s uγenna. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />lweqt ḏḏin tatreqqen ṣbiḥen am tufuyt g lmelekuwt n babesen. kan γarwem timezzuγin sseγdeṯ.»<verse eid="MAT 13:43" /></para>
  <para style="s">tenfust n lkenz aḏ tenfust n teƹqiqt</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />«lmelekuwt n ujenna am lkenz yenbel g umezdeγ. yufi argaz iƹeweḏ yenbelliy aḏ seg lferḥetis ireḥ yezenz lliy γares lkul yesγi aydin n umezdeγ.<verse eid="MAT 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />aḏ lmelekuwt n ujenna am yjen d ttajr yusi iruzzu af iḍγaγen ṣbiḥen. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />aḏ smanis yufa teƹqiqt teṣbiḥt ggeṯ ireḥ yezenz lliy γares lkul yeṣγiṯ.<verse eid="MAT 13:46" /></para>
  <para style="s">tenfust n rredj</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />aḏ lmelekuwt n ujenna am rredj sensent g iylel. yaxy yečur seg lenweƹ n tirubey lkul. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />mniyn yečur nzeγent iṣeyaḍen al cceṭ, geƹemzen aḏ laymen lliy d ṣbiḥ g isnayen, aḏ luḥen lliy wiyeḥli al barra. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />amyuh tayṣar g laxer n ddunyeṯ; tadesen lmemlayka asefγen lliy wiḥlin seg amas n ṣbiḥen. <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />we atenluḥen g amas n timsi temeqqart mani diyes ƹeyyeḍ aḏ aγezzi n cwerb s uγenna.»<verse eid="MAT 13:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />yuwayasen: «tefhemmem ayuh lkul.» uwanas: «ayya, nefhem.»<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />yaxy yuwa: «afelxaḍert n ayuh, lliy yeḏwel d tilmiḏ n lmelekuwt n ujenna seg indin lliy seḥfeḍen g cceriyƹeṯ netta am bab n lḥuc lliy yesufuγ seg ḏxirtis jdiḏ aḏ qdim.»<verse eid="MAT 13:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />aḏ beƹd mag ykemmel yesuwƹ ayuh n tinfes iruweḥ s yin. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />aḏ mniyn yeḏwel al lḥumtis yuḏel yesseḥfaḍ g wuḏeyen g lmjameƹsen. yaxy ṯƹejben aḏ uwan jarsen: «manis γares ayuh n tmesniwt aḏ ayuh n lmuƹjizaṯ? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />yaxy muc netta d memmis n unejjar? muc yedjis ammelnas meryem, aḏ yeṯmas: d yeƹquwb aḏ yuwsef aḏ simƹan aḏ yehuwḏa? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />muc tiseṯmas lkul dderneṯ jarneγ? s manis γares ayuh lkul.» <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />aḏ stehzen af dwiys.</para>
  <para style="p" vid="MAT 13:57">yaxy yesuwƹ yuwayasen: «nnabiy wiγaresc lleqder g lḥumtis aḏ g lḥucis.» <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />aḏ wiyeggi dinet kan fercu d lmuƹjizaṯ, afelxaḍert wuminenc siyes.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="nb">
    <verse number="1" style="v" sid="MAT 14:1" />g aydin n lweqt yesla hiyruwdus lḥakem n ljalil s yesuwƹ. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />yaxy yuwa y ixedemnis: «qa wuh d yaḥya lmeƹmedan, yekker seg lliy mmuṯen. afelxaḍert n ayuh iteg g lmuƹjizaṯ.»<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />yusi qebbel, hiyruwdus yeṭṭef yaḥya, yeqqeni s tselslin, yeggi g lḥebs <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />afelxaḍert yusi yaḥya yemmalas. ḥram fellaḵ lliy tenjefd hiyruwdiya lehlis n uwas filibbus lliy yusi yedder. <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />hiyruwdus yusi yexs ayenγ yaḥya, lekinti yugeḏ seg midden afelxaḍert yusi yaḥya γarsen d nnabiy.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />aḏ g umessi lliy teggent as n tlaliṯ n hiyruwdus, terqeṣ yellis n hirudiyya g amas. yaxy teƹjebbas y hiyruwdus. <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />yedjul tasyuc matta tateḍleb. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />aḏ beƹd mag čawer yedjis, tuweyas: «aγiḏd al dehnit af ṭbeq iγef n yaḥya lmeƹmedan.»<verse eid="MAT 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 14:9" />yaxy yeḥzen lmelek lekenti yuwayasen asucen matta texs, afelxaḍert yedjul af aydin zzaṯ lliy nnaḍḍen yiḏes. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />yenkiy mam ireḥ lḥebs yeqdeƹ iγef n yaḥya. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />aḏ uγentiḏ af ṭbeq, ucent y tefruxt tewyi al yedjis. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />usend tlamḏa n yaḥya qamen tiddis nbalenteṯ. wembeƹd reḥḥen uwan y yesuwƹ.<verse eid="MAT 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />mniyn yesla yesuwƹ aydin, yerkeb g leflukeṯ ireḥ weḥdes al umkan widdis ḥed. yaxy slen siyes midden ḏbeƹent af idernesen seg timurawin. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />yezwa yesuwƹ al cceṭ yezra midden ggeṯ yesxef fellesen yseḥla imuḍanesen.<verse eid="MAT 14:14" /></para>
  <para style="s">yesuwƹ yesseča g 5,000 d midden</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />temeddiṯ usennesd tlamḏes uwanas: «ayuh n umkan widdis ḥaja aḏ as ireḥ, adj areḥen midden al tmurewin bac asγen man ačan.»<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />lekenti yesuwƹ yuwayasen: «muc lazem areḥen uctasen kennim ačan.»<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />yaxy uwan: «wiγernexc dehnit kan 5 d tiqurseṯin aḏ sen n trubay.» <verse eid="MAT 14:17" /><verse number="18" style="v" sid="MAT 14:18" />yuwa: «aγtettend al deh.» <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />aḏ yuwa y midden: «ndeṯ y uču af rbiƹ.» wembeƹd iqam aydin 5 n tiqurseṯin aḏ sen n trubay. yesmuqel al ujenna, yeḍleb rebbiy bac anumerneṯ. yerza tiqurseṯin, yucineṯ y tlamḏes, ferqentent af midden.<verse eid="MAT 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 14:20" />čen lkul cbeƹan, wembeƹd qamen tlamḏa 12 d tiƹellagin ƹebbenneṯ seg lliy yefdelled.<verse eid="MAT 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 14:21" />aḏ wsiyn lliy čen teqrib 5000 d irgazen man γiyr imeckenen aḏ tiseḏnan.<verse eid="MAT 14:21" /></para>
  <para style="s">yesuwƹ yeggur af aman</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />aḏ yuwa yesuwƹ y tlamḏes arekben ƹlewleh g lflukeṯ we atsebqen al lḥacit ttani n iylel. aḏ yeqqim netta bac ayenkiy midden aruḥen. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />aḏ beƹd mag rewḥen midden yuli al jbel bac ayeẓẓal weḥdes, mniyn tuda tufuyt yusi weḥdes dinet.<verse eid="MAT 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 14:24" />aḏ tusi leflukeṯ n tlamḏa g amas n iylel čeṯen diyes lemwaj al deh aḏ deh, afelxaḍert aḍu yusi s zzaṯ. <verse eid="MAT 14:24" /><verse number="25" style="v" sid="MAT 14:25" />aḏ lexra n yeḍ yused yesuwƹ al tlamḏes yeggur af aman. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />mniyn zrent yeggur af aman rjijen uwan: «rahiy d lxyal.» aḏ ṣeyḥen s tiwdi.<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />yaxy ƹlewleh yufleyasen yesuwƹ, yuwa: «sezreṯ ulawnewem, wittegeṯec. rahiy d neči.»<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />yuwa buṭrus: «siydneγ, kan d cekkin nembelḥeq, mliḏ afdeseγ ggwureγ af aman.»<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />yuwayas yesuwƹ: «yya.» yezwa buṭrus seg leflukeṯ yeyyur af aman ireḥ al yesuwƹ.<verse eid="MAT 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 14:30" />lekenti mniyn iḥus s aḍu yugeḏ, yuḏel iγerreq. yaxy yuwa: «ayya siydneγ semenƹiḏ.»<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />ƹlewleh yezzel yesuwƹ fusis yeṭṭefi, yuwayas: «ayya lliy liymaniḵ ḍƹiyf, maγer tcukkeḏ diyi.»<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />mniyn uleyyen al leflukeṯ, yersa aḍu. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />yaxy usend lliy g leflukeṯ sjeḏnas, uwanas: «cek nembelḥeq d memmis n rebbiy.»<verse eid="MAT 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />aḏ mniyn qdaƹen al ljiheṯ ttani n iylel, zwan g lḥumeṯ n jinnisaret. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />fhemment midden n aydin n lḥumeṯ, becren s iṣalis imuḵen lliy tmas. yaxy uγennesd imuḍanesen lkul. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />aḏ ḍlebben siyes atenyedj aṭfen g temma n rdis akehaw. aḏ lliy ṭṭefen diyes lkul ḥlan.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">dwiy n rebbiy xiyr n lmaḏ n midden</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />aḏ yyuren al yesuwƹ lbeƹḍ n lliy seḥfeḍen g cceriyƹeṯ aḏ iferysiyyen seg uwrceliym, sesetnent: <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />«maγer witeggenc tlamḏeḵ mammeḵ nufa iwessarenneγ tteggen? wisseriḏenc ifesnesen qebbel uču.» <verse eid="MAT 15:2" /><verse number="3" style="v" sid="MAT 15:3" />yaxy yerrasen:</para>
  <para style="p" vid="MAT 15:3">«maγer witetegemc kennim s dwiy n rebbiy bac asteḥefdem af matta telmeḏem? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />rahiy rebbiy iweṣṣa, yuwa: &lt; agg teṣbiḥt y babiḵ aḏ yedjiḵ. kul yjen ayeḏƹu babis naγ y yedjis ayemmunγ. &gt; <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />lekenti kennim temmalem: &lt; mam yuwa y babis naγ yedjis: «lliy usiγ tafentiḏuceγ usixt y lheykel.» <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />amyuh yetquddu maƹedc ayuc babis aḏ yedjis. &gt; kennim s ayuh tetteksem mag yuwa rebbiy bac asteḥefdem af matta telmeḏem teteggemt. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />ayya lliy texsem asiḵnem y midden matta teteggem. γares lḥeq icƹeya lliy yuwa fellewem:<verse eid="MAT 15:7" /></para>
  <para style="p" />
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />&lt;ayuh n cceƹb yettesed iḏiy s imis,</para>
  <para style="q2" vid="MAT 15:8">amma ulis yebƹeḏ fella ggeṯ<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />afelxaḍert wiseḥfiḍen kan af luwṣayaṯ n midden.</para>
  <para style="q2" vid="MAT 15:9">rahiy tẓalliṯesen y neči s lbaṭl. &gt; »<verse eid="MAT 15:9" /></para>
  <para style="s">matta yesenzes bnaḏem</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />wembeƹd yesγuy y midden yuwayasen: «sseγdeṯ, tefehmem: <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />rahiy muc lliy iteḏef al imi yesenzes bnaḏem. amma lliy iteffeγ seg imi yenezzesi.» <verse eid="MAT 15:11" /><verse number="12" style="v" sid="MAT 15:12" />yaxy usennesd tlamḏes uwanas: «tesenneḏ lliy ayuh n dwiy γecceccen siyes iferysiyyen.» <verse eid="MAT 15:12" /><verse number="13" style="v" sid="MAT 15:13" />yerrasen: «kul cejreṯ witetyezzuc baba lliy g ujenna tatmukes. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />djetten weḥdesen. rahiy nihnin wizzerenc aḏ ttersen g lliy wizzerenc. aḏ kan yjen wizerc itares g ttani wizerc tawdan jmiyƹ g burriƹ.» <verse eid="MAT 15:14" /><verse number="15" style="v" sid="MAT 15:15" />yuwayas buṭrus: «siḵnaneγ mammeḵ ayuh n tenfust.» <verse eid="MAT 15:15" /><verse number="16" style="v" sid="MAT 15:16" />yaxy yerras:</para>
  <para style="p" vid="MAT 15:16">«yenda ḥetta kennim witfehmemc zada? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />yenda witsinemc lliy uču lliy itaḏef al imi yetreḥ al jjar wembeƹd al lmeyyali? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />amma lliy itefγed seg imi itased seg ul aḏ d netta lliy yesenzes bnaḏem. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />rahiy seg ul ttesented lexdayer lliy wiḥlineṯ am temenγiwt aḏ zina aḏ lefsaḏ aḏ sserqeṯ aḏ chedeṯ n zzur aḏ dwiy g midden. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />ayuh d iḥajeyen lliy tnezzesen bnaḏem. amma uču man γiyr asireḏ n ifesn wiyetnezzesc bnaḏem.»<verse eid="MAT 15:20" /></para>
  <para style="s">liyman n tmeṭṭuṯ tekenƹanit</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />wembeƹd yeffeγ yesuwƹ seg aydin n mkan ireḥ al lḍraf n ṣuwr aḏ ṣeyda lliy middenisen muc d uḏeyin. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />yaxy temeṭṭuṯ tekenƹanit s yin tusesd tetṣeyyeḥ: «rreḥmiḏ ayya siydneγ ay memmis n dawud. yelli tetƹana ggeṯ. yeskenniṯ cciyḍan.» <verse eid="MAT 15:22" /><verse number="23" style="v" sid="MAT 15:23" />lekenti wisyerri ḥetta tuflayt. yaxy usend tlamḏes mmelnas tƹewaḏen: «ggas mag texs. rahiy nettaṯ tetṣeyyeḥ deferrenneγ.»<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />yaxy yerrasen: «rahiy yenkiyiḏ rebbiy kan al midden lliy weddren am tulli seg aṯ israyil.»<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />lekenti temeṭṭuṯ teqrebesd tesjeḏ tuweyas: «ƹewniḏ ayya siydneγ.»<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />yaxy yerras: «muc d ṣwab mam aywiy aγrum n imeckennis we atidileweḥ y ijriwen n iṭṭan.»<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />tuwa: «γareḵ lḥeq ayya siydneγ lekenti ijriwen n iṭṭan tteten seg ifetfuten n aγrum lliy tṭuṭan seg uču n iḏbabenesen.»<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />yaxy yerras yesuwƹ: «ayya temeṭṭuṯ liymanim d meqqar. tamyuc rebbiy lliy teḍlebbeḏ.» yaxy teḥla yellis ƹlewleh.<verse eid="MAT 15:28" /></para>
  <para style="s">yesuwƹ yseḥla ggeṯ seg ljeliyl</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />wembeƹd ireḥ yesuwƹ s yin al iylel n ljeliyl. yuli al jbel ygeƹmez dinet. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />uγennesd midden ggeṯ d lƹeybin aḏ lliy meclulin aḏ ileƹmayen aḏ ibekkucen aḏ imuḍan ttenyaṯ. ggenten zzaṯis, yseḥlayin. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />yaxy fehhen midden mniyn zren ibekkucen duggan aḏ imeclulen ḥlan aḏ lƹeybin gguren yeqƹeḏ aḏ lliy wizzerenc zerren. aḏ mejden rebbiy n israyil.<verse eid="MAT 15:31" /></para>
  <para style="s">yesuwƹ yesseča 4,000</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />yesγuy yesuwƹ af tlamḏes yuwa: «rahiy sexxefniḏ ayuh n midden. γarsen ṭuruh 3 d ussanaṯ iḏiy aḏ willic man ačan. ykemmel uču lliy uγentiḏ yiḏesen. neči wilγisexc aruḥen lluzen, balek witquddunc aḏeṣlen.»<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />yaxy tlamḏes uwan: «s manis tadnaγ g ayuh n lxla tiqurseṯin keffeneṯ y ayuh n midden lkul.»<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />ysesetnin: «mennit γarwem d tiqurseṯin?» uwanas: «7 aḏ trubay timeckunin.»<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />yaxy yuwa y midden anden y uču af tammurt. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />wembeƹd iqam aydin n tiqurseṯin aḏ aydin n trubay. yeḥmeḏ rebbiy, yerza aγrum, yuci y tlamḏes, ferqent af midden.<verse eid="MAT 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 15:37" />čen midden almiy cebƹen. wembeƹd qamen tlamḏes 7 n isnin ƹebbenneṯ seg tiqurseṯin lliy fdelented.<verse eid="MAT 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 15:38" />aḏ wsiyn lliy čen 4000 d irgazen man γiyr tiseḏnan aḏ imeckenen.<verse eid="MAT 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 15:39" />wembeƹd ydjin aruḥen. yuli al leflukeṯ. ireḥ al tmura n mejdan.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">iferryisiyen ḍelben g lmuƹjizaṯ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />usend lbeƹḍ n iferysiyyen aḏ iṣedduwqiyiyen al yesuwƹ bac atseḥṣlen, uwanas: «aγaneγd lmuƹjizaṯ seg ujenna.» <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />yerrasen:</para>
  <para style="p" vid="MAT 16:2">«almiy yezweγ jenna yid ina n tufuyt, temmalem: &lt; tayeṯfeja lḥal. &gt; <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />aḏ almiy yezweγ yezdef jenna tajji temmalem: &lt; ssuh d as n anzar. &gt; tetesnem mammeḵ taydel as seg ujenna. amma witetquddumc afehmem lmuƹjizaṯiw lliy yeseḵen disneṯ rebbiy g ayuh n ussan. <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />ljiyl lkafer lliy wiyeḥli idelleb g lmuƹjizaṯ. amma wisentetis kan lmuƹjizaṯ n nnabiy yuwnes.» wembeƹd ireḥ yedjin.<verse eid="MAT 16:4" /></para>
  <para style="s">tenfust n lxmireṯ n iferysiyyen aḏ iṣedduwqiyiyen</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />mniyn uṣellen tlamḏes al ljiheṯ ttani ttun awyen aγrum. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />lweqt ḏḏin yuwa yesuwƹ: «rreṯ lbaluwem seg lexmireṯ n iferysiyyen aḏ iṣedduwqiyiyen.» <verse eid="MAT 16:6" /><verse number="7" style="v" sid="MAT 16:7" />yaxy uḏellen sestunen g beƹḍhum: «ima yuwa ayuh, balek afelxaḍert widnuγic iḏenneγ aγrum.» <verse eid="MAT 16:7" /><verse number="8" style="v" sid="MAT 16:8" />yefhemin yesuwƹ yuwayasen:</para>
  <para style="p" vid="MAT 16:8">«ayya lliy liymanuwem ḍƹiyf, maγer tetxemmemmem g aγrum? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />yaxy wicci witefhimemc? naγ tettum aydin n 5 n tiqurseṯin lliy seccebƹeneṯ 5000, aḏ mennit tƹebbim d tiƹellegin seg lfeḍlesneṯ? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />naγ tettum aydin n 7 n tiqurseṯin lliy secbƹeneṯ 4000, aḏ mennit d isnen tƹebbim seg lfaḍlesneṯ? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />mammeḵ witfehmemc lliy neči widdugixc af aγrum mniyn uwiγawem: rreṯ lbaluwem seg lxmireṯ n iferysiyyen aḏ iṣedduwqiyiyen?» <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />lweqt ḏḏin fhemmen lliy netta yexs asenimel: «rreṯ lbaluwem seg seƹzem n iferysiyyen aḏ iṣedduwqiyiyen.»<verse eid="MAT 16:12" /></para>
  <para style="s">cekkin d lmesiyḥ memmis n rebbiy lliy yedder</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />mniyn yuṣel yesuwƹ al leḍraf n qeyṣeriya filibbi, ysesten tlamḏes: «matta mmalen midden fella neči lliy yeḏwel d bnaḏem.» <verse eid="MAT 16:13" /><verse number="14" style="v" sid="MAT 16:14" />uwanas: «lbeƹḍ mmalen cek d yaḥya lmeƹmedan, aḏ lbeƹḍ ammalen cek d nnabiy iyliya, aḏ ttenyaṯ mmalen: cek d nnabiy irmiya naγ d yjen seg lenbiya.» <verse eid="MAT 16:14" /><verse number="15" style="v" sid="MAT 16:15" />ysesetnin: «aḏ kennim matta temmalem fella.» <verse eid="MAT 16:15" /><verse number="16" style="v" sid="MAT 16:16" />yerras simƹan buṭrus, yuwa: «cek d lmesiyḥ memmis n rebbiy lliy yedder.» <verse eid="MAT 16:16" /><verse number="17" style="v" sid="MAT 16:17" />yuwayas yesuwƹ:</para>
  <para style="p" vid="MAT 16:17">«ayya sseƹdiḵ ay simƹan memmis n yuwnes. ayuh isiḵneḵtiḏ baba lliy g ujenna muc d bnaḏem. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />aḏ neči zada afemleγ: cekkin d teḍγeγt aḏ af ayuh n teḍγeγt taggeγ lmejmeƹ y neči lliy ḥetta burriƹ n temettent wiγarc ssulṭeṯ felles. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />aḏ tafuceγ tinisa n lmelekuwt n ujenna aḏ sulṭeṯ n uḥellel aḏ uḥerrem g tammurt aḏ ujenna.» <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />wembeƹd yuwa y tlamḏes: «rreṯ lbaluwem amlem y ḥed lliy d neči d lmesiyḥ.»<verse eid="MAT 16:20" /></para>
  <para style="s">lmesiyḥ yedugga af tmettentis aḏ tineḵris</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />seg lweqt ḏḏin yuḏel yesuwƹ yemmal y tlamḏes lliy yelzemmas ayreḥ al uwrceliym, we yeƹena seg uƹeḏḏeb af ifesn n iwessaren aḏ imeqqaren n lkuhhan aḏ lliy seḥfeḍen g cceriyƹeṯ, we ayemmunγ. aḏ g as wi 3 tayekker. <verse eid="MAT 16:21" /><verse number="22" style="v" sid="MAT 16:22" />yaxy yenzaγiy buṭrus af ljiheṯ yuwayas: «ḥacaḵ, ayya siydneγ kan afiṣar ayuh.» <verse eid="MAT 16:22" /><verse number="23" style="v" sid="MAT 16:23" />yenneḍ yesuwƹ al buṭrus yuwayas: «bƹeḏ seg zzaṯiw, ayya cciyḍan, cekkin d ymir zzaṯiw afelxaḍert cekkin tdebƹeḏ matta xsen midden aḏ tettetuḏ matta yexs rebbiy.»<verse eid="MAT 16:23" /></para>
  <para style="s">matta tayestenfeƹ bnaḏem lmi yexser imanis?</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />wembeƹd yuwa yesuwƹ y tlamḏes:</para>
  <para style="p" vid="MAT 16:24">«lliy yexs ayeyyur defferiw, yexs ayettu imanis we ayeṣber af lƹeḏeb n ṣṣelib we alyeḏbeƹ. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />kul yjen yexs ayesteḥfeḍ af imanis tayexser, lekenti lliy tayexser imanis afelxaḍriw, tatetyaf. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />matta tayestenfeƹ bnaḏem kan yerbeḥ ddunyeṯ lkul aḏ yexser imanis? rahiy ḥetta cey wiyetquddu astadyer.<verse eid="MAT 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 16:27" />neči lliy yeḏwel d bnaḏem tadeseγ yid lmejd n baba aḏ lmleykas. we aḏuceγ y kul yjen lliy yestahel. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />lḥeq afenemleγ: lbeƹḍ n lliy bbedden deh witmetinc qebbel man alzren neči lliy yeḏwel d bnaḏem tteseγd am lmelik.»<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">lmejd n yesuwƹ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />wembeƹd 6 d ussanaṯ yewya yesuwƹ buṭrus aḏ yeƹquwb aḏ yuwḥenna uwas. yuli sisen weḥdesen al ljbel. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />yeṯbeddel zzaṯesen. yeḏwel uḏmis yetreq am tufuyt aḏ lḥweyjis d imellelen am ddu.<verse eid="MAT 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 17:3" />yaxy ḍhernesend muwsa aḏ iliyya duggan yiḏes. <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />ƹelewleh yuwa buṭrus y yesuwƹ: «ayya siydneγ mennit d ṣbiḥ lukan aneqqim deh. kan texseḏ aggeγ dehnit 3 n lƹecceṯ: ijeṯ y cek, ijeṯ y muwsa, ijeṯ y iliyya.»<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />mniyn netta ydugga tuḏennin tesḥabt tetreq. yaxy slen mam yemmel seg amasis: «qa wuh d memmi lliy xsext, lliy freḥeγ siyes ggeṯ. sseγdeṯ dwiys.» <verse eid="MAT 17:5" /><verse number="6" style="v" sid="MAT 17:6" />mniyn slennes udan af uḏmewnesen terjijin ggeṯ. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />yaxy yeqrebbasen yesuwƹ yeṭṭef disen yuwayasen: «kkreṯ wittegeṯec.» <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />smuqlen al nnaj. zren yesuwƹ weḥdes.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />mniyn nihnin zuggan seg jbel iweṣṣeyin yesuwƹ yuwa: «wimmeleṯc ḥaja af lliy tezrimt almiy akereγ neči lliy yeḏwel d bnaḏem seg jar lliy mmuṯen.»<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />yaxy sesetnent tlamḏes: «maγer zeγ mmalen lliy seḥfeḍen g cceriyƹeṯ, iliyya tadyas qebbel.»<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />yerrasen: «nembelḥeq. rahiy iliyya tadyas qebbel we ayejra kul ciy. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />lekenti afenemleγ: rahiy iliyya yused beƹda amma wisteƹerfenc siyes. aḏ ggen diyes mayuƹmal. aḏ amyuh ḥetta neči lliy yeḏwel d bnaḏem tamdwureγ s ifesnesen zada.» <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />lweqt ḏḏin fhemmen lliy netta yufleyasen af yaḥya lmeƹmedan.<verse eid="MAT 17:13" /></para>
  <para style="s">yesuwƹ yesseḥla frux diyes cciyḍan</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />mniyn uṣellen al midden, yeyyur argaz al yesuwƹ yezwa af ifednis zzaṯis. <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />yuwa: «ayya siydneγ rḥem memmi. rahiy yuḍen s lmeṣṣebyen, aḏ netta yetƹana ggeṯ aḏ seƹat iṭṭuṭa g timsi, seƹat g aman. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />aḏ uγiγtiḏ al tlamḏeḵ wiquddenc atseḥlan.»<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />yaxy yuwa yesuwƹ: «ayya ljiyl lliy witemenc aḏ lliy yeƹwej al lemmi taqimeγ iḏewem? al lemmi tafenḥemleγ? aγtettiḏ al dehnit.» <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />yezher yesuwƹ af cciyḍan. yeffeγ seg afrux. yeḥla seg lweqt ḏḏin.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />wembeƹd usend tlamḏa al yesuwƹ weḥdesen sesetnent: «maγer winqudc neccin anzeƹzeq cciyḍan.»<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />yerrasen:</para>
  <para style="p" vid="MAT 17:20">«s lqelleṯ n liymanuwem. lḥeq afenemleγ: lukan γarwem liyman am tḥebuṯ n lxerweƹ rahiy amlem y ayuh n jbel: &lt; ḥewel s yeh al γaḍih. &gt; ayḥuwel, we aquddem kul ciy. <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />amma ayuh n nnuƹ n cyaḍen wiyetemzeƹzeq kan s tẓalliṯ aḏ uẓum.»<verse eid="MAT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />mniyn wsiyn mleymen g ljeliyl, yuwa yesuwƹ y tlamḏes: «neči lliy yeḏwel d bnaḏem talṭfen midden. <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />we alenγen aḏ g as ṯaleṯ talisekker rebbiy.» yaxy ḥzennen ggeṯ.<verse eid="MAT 17:23" /></para>
  <para style="s">yesuwƹ ydeffeƹ g ḍḍeribeṯ n lheykel</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />mniyn uṣellen al kefrnaḥuwm, usend lliy tlayemen g ḍḍeribeṯ n lheykel. uwanas y buṭrus: «yaxy lmuƹlmewem wituc sen drehem?» yerrasen: «ituc.»<verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />aḏ s manis yuḏef buṭrus al lḥuc, ysesetni yesuwƹ: «man mleḏ af lmuluk, s mammun tlayemen g ḍḍeribeṯ? yenda tleyemen diyes, seg ibeldiyen naγ seg iγriben?»<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />yerras buṭrus: «seg iγriben.» yaxy yuwa yesuwƹ: «mala ibeldiyen γarsen lḥeq widefƹenc. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />lekenti bac winseγliḍc ayuh n midden ureḥ al iylel. tluḥeḏ teṣennertiḵ. teṭfeḏ trebit. trebit temezwert lliy tateffeγ. miras imis. taḏefeḏ diyes ṣurdi lqimtis 4 drahem. awyiy teḏefƹeḏ ḍḍeribeṯ fella aḏ fellaḵ.»<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">meqqar g lmelekuwt n ujenna</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />lweqt ḏḏin usend tlamḏa n yesuwƹ sestunen diyes: «d mam zeγ meqqar g lmelekuwt n ujenna.» <verse eid="MAT 18:1" /><verse number="2" style="v" sid="MAT 18:2" />yaxy yesγuy y afrux d meckun yesbeddi jerasen, <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />yuwa:</para>
  <para style="p" vid="MAT 18:3">«lḥeq afenemleγ, kan witḏuglemc am imeckenen, witeteḏfemc al lmelekuwt n ujenna xlaṣ. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />lliy yeṯweḍeƹ am ayuh n wefrux rahiy d netta d meqqar g lmelekuwt n ujenna. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />aḏ lliy ayefreḥ s ayuh n afrux afelxaḍertiw. rahiy yefreḥ siyi.<verse eid="MAT 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />amma lliy ayseγleḍ yjen seg ayuh n ifrex lliy umennen siyi. rahiy lukan asƹelqen g teḵrumtis ƹeqqa n lemdar we atseγerqen g tebḥirt xiyr n lliy atiƹeqeb rebbiy af ayuh n bekkeḍu. <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />ayya lwilesen midden seg seγleḍ. rahiy seγleḍ yella diyma g ddunyeṯ. aḏ ayya lwilis lliy tayseγleḍ midden.<verse eid="MAT 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8" />kan fusiḵ naγ dariḵ tafiseγleḍ qedƹi aḏ lewḥi. rahiy iḏef al temeddurt n ujenna am idin xiyr n iḏaf sisen al jhennem lliy treq diyma. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />kan ṭiṭiḵ taftseγleḍ, ksiṯ aḏ luḥiṯ. rahiy ikkesis aḏ iḏaf al temeddurt n ujenna am idin xiyr n iḏaf siyes al jhennem lliy treq diyma.<verse eid="MAT 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />rreṯ lbaluwem aḥeqrem yjen seg ayuh n imeckunen. rahiy neči tafenemleγ: lmleykesen smuqulen diyma al uḏem n baba g ujenna.<verse eid="MAT 18:10" /></para>
  <para style="s">tenfust n izmer lliy iwedder</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 18:11" />rahiy neči lliy yeḏwel d bnaḏem usiγd bac asemneƹeγ lliy weddren. <verse eid="MAT 18:11" /><verse number="12" style="v" sid="MAT 18:12" />man amlem g yjen; yusi γares 100 d izmeren. ireḥ yjen sisen: yaxy muc tayedj aydin 99 g jbel we ayreḥ ayurzu af lliy iwedder? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />lḥeq afenemleγ: kan yufi tayefreḥ siyes iṭer n freḥis s aydin 99 lliy widdrenc. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />aḏ amyuh wiγisc babuwem lliy g ujenna aywedder yjen seg ayuh n imeckunen.<verse eid="MAT 18:14" /></para>
  <para style="s">kan yeγleḍ iḏeḵ uwaḵ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />kan yeγleḍ iḏeḵ uwaḵ ureḥ lummi aḏ kennim weḥduwem. kan yesla dwiḵ. rahiy terbeḥet. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />amma kan wiyeslic dwiḵ, awi iḏeḵ yjen naγ sen seg ayeṯmaḵ bac acehden af mag iṣar as iḍen. <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />kan wiyeqqil ayeγ s dwiysen, ḥerrec siyes al lmejmeƹ. aḏ kan wiyeqqil ayeγ s dwiy n lmejmeƹ zada. ḥesbi am lliy yetzella y ṣneb naγ am lliy yetlayem g ḍḍeribeṯ.<verse eid="MAT 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />lḥeq afenemleγ: γarwem ssulṭeṯ n uḥellel aḏ uḥerrem g tammurt aḏ ujenna. <verse eid="MAT 18:18" /><verse number="19" style="v" sid="MAT 18:19" />we afenemleγ zada: kan mfehmen sen siwem af tammurt af mehma ḥaja aḏ ḍlebenteṯ g tẓalliṯesen. rahiy baba lliy g ujenna tasentedyuc. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />mani mlaymen sen naγ 3 s ismiw. rahiy ḥetta neči lliγ yiḏesen.»<verse eid="MAT 18:20" /></para>
  <para style="s">tenfust n usameḥ n ttanyaṯ</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />lweqt ḏḏin yusesd buṭrus ysesetni: «ayya siydneγ mennit yexs asemḥeγ uwa almiy yeγleḍ iḏiy? yaxy yexs atsemḥeγ 7 merrat?» <verse eid="MAT 18:21" /><verse number="22" style="v" sid="MAT 18:22" />yerras yesuwƹ:</para>
  <para style="p" vid="MAT 18:22">«muc 7 merrat akehaw amma 70 merrat deqqes n 7 merrat. <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />afelxaḍert n ayuh lmelekuwt n ujenna am lmelek yexs ayḥaseb ixedemnis af ṣṣabeṯ.<verse eid="MAT 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 18:24" />aḏ mniyn yuḏel yetḥasab disen uγennesd yjen xeṣnas 10,000 d idinaren n lfejreṯ. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />aḏ afelxaḍert wiγrec s matta tayxelleṣ swalis yuwayasen siydis atzenzen netta aḏ lehlis aḏ ṭarwas aḏ lliy γares bac ayxelleṣ swalis.<verse eid="MAT 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26" />lekenti xdim yezwa zzaṯis yesjeḏ yuwa: &lt; ayya siydneγ sugmiḏ ussan afxelṣeγ g swal lkul. &gt; <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />yaxy yesxef aydin n lmelek fellas, yseybi, isamḥi g swal.<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />lekenti mniyn yeffeγ aydin n xdim ireḥ al yjen seg iqrinnis yexs fellas 100 d idinaren. yeṭṭefi, yexneqqi, yuwayas: &lt; ḏfeƹ lliy xsext fellaḵ. &gt;<verse eid="MAT 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29" />yezwa qrinnis af ifednis zzaṯis yetjeheyas yemmal: &lt; sugmiḏ ussan fxelṣeγ. &gt; <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />lekenti wiyeqqil atiseyyeb aḏ yerniy yeḥebsi bac atixelleṣ.<verse eid="MAT 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 18:31" />mniyn zren ixdimen mag iṣar, ḥzennen aḏ reḥḥen uwan y siydsen af mag iṣar. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />yaxy yesγuyas siydis yuwayas: &lt; ayya lliy witeḥliḏ, swaliḵ lkul sameḥγeḵ diyes afelxaḍert tjahidiḏ. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />yaxy muc yexs areḥmeḏ qriniḵ mammeḵ rḥemγaḵ neči?&gt; <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />aḏ mniyn teḍras y siydis yeggi g lḥebs almiy ayxelleṣ swalis. <verse eid="MAT 18:34" /><verse number="35" style="v" sid="MAT 18:35" />amyuh tafenyeg baba lliy g ujenna kan wisameḥc kul yjen siwem uwas seg ulis.»<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="nb">
    <verse number="1" style="v" sid="MAT 19:1" />beƹd mag ykemmel yesuwƹ dwiys, yeffeγ seg ljeliyl bac ayreḥ al lyehuwdiya deffer lweḏ n lurdun. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />aḏ ḏbeƹent ggeṯ d midden. yaxy yseḥla imuḍanesen.<verse eid="MAT 19:2" /></para>
  <para style="s">siḵen yesuwƹ af tilfa</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />usennesd lbeƹḍ n iferysiyyen bac atjerben. yaxy sestnent: «yenda ḥlal y argaz bac ayellef y lehlis af mehma ḥaja.»<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />yaxy yuwayasen: «yenda witeƹzimemc lliy rebbiy yeggi bnaḏem s luwel d argaz yid temeṭṭuṯ <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />aḏ yuwa: &lt; afelxaḍert n aydin itedja argaz babis aḏ yedjis aḏ ydebbeƹ lehlis, we aḏulen aydin n argaz aḏ tmeṭṭuṯ d yjen. <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />aḏ beƹdis maƹedc d sen amma d yjen. aḏ ḥram af bnaḏem ayferreq jar lliy yejmeƹin rebbiy. &gt; »<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />yaxy sesetnent: «mala maγer yuwa muwsa: &lt; uceṯ y tmeṭṭuṯ tḥudjet n tulfes almiy tatetzeƹezqem?&gt; »<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />yerrasen: «afelxaḍert ulawnewem d izuweren yedjawem muwsa alfem y tseḏnenuwem. lekenti ayuh wiyusic g luwel. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />tafenemleγ: lliy yellaf y lehlis muc afelxaḍert n zna, aḏ yenjef γiyris. rahiy yezna.»<verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />yaxy uwan tlamḏes: «kan ayuh d lḥal n argaz yid lehlis, muc lqelleṯ n tnedjift xiyr?»<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />yaxy yerrasen: «ayuh n dwiy witqeblen kan lliy yucesen rebbiy lqudreṯ fellas. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />rahiy lbeƹḍ n lliy twexṣen tlalend am idin, aḏ lbeƹḍ sisen xṣenten midden. aḏ lbeƹḍ sisen winejfenc afelxaḍert n lmelekuwt n ujenna. lliy iqud ayeqbel ayuh adj atyeqbel.»<verse eid="MAT 19:12" /></para>
  <para style="s">yesuwƹ yetnumer g imeckenen</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />wembeƹd uγennesd midden imeckenen bac ayeg fellesen ifesnis we asenyeḍleb lberekeṯ n rebbiy. yaxy zheren fellesen tlamḏes. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />lekenti yesuwƹ yuwa: «djetten aldesen witenterreṯec afelxaḍert lmelekuwt n ujenna y lliy am nihnin.» <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />yeggi ifesnis fellesen. ireḥ s yin.<verse eid="MAT 19:15" /></para>
  <para style="s">mezyan murkenti</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />yaxy yusesd mezyan yesestun: «ayya lmuƹellem, matta yexs aggeγ d ṣbiḥ bac alqiγ temeddurt n diyma.»<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />yaxy yerras: «maγer tesestuneḏ diyi af lliy d ṣbiḥ? diyes yjen akehaw d ṣbiḥ. lekenti kan texseḏ aḏeḏfeḏ al tmeddurt agg s luwṣayaṯ.»<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />ysesten: «mentan luwṣayaṯ?»</para>
  <para style="p" vid="MAT 19:18">yerras yesuwƹ: «wineγc, wizennac, wisereqc, wiceheḏc s kerkas. <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />agg ṣbiḥ y babiḵ aḏ yedjiḵ, xs midden am imaniḵ.» <verse eid="MAT 19:19" /><verse number="20" style="v" sid="MAT 19:20" />yuwayas mezyan: «inuh lkul ggixten s manis d meckun. matta wicci zeγ?»<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />yerras yesuwƹ: «kan texseḏ adleḏ kamel, ureḥ zenz lliy γareḵ lkul tferqet af izeweliyen bac aydel y cek lkenz n ujenna. wembeƹd sed teḏbeƹdiḏ.» <verse eid="MAT 19:21" /><verse number="22" style="v" sid="MAT 19:22" />mniyn yesla mezyen ayuh n dwiy, yeffeγ yeḥzen afelxaḍert γares lmal ggeṯ.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />yuwa yesuwƹ y tlamḏes: «lḥeq afenemleγ: yuƹer af lliy lebas ƹlih iḏaf al lmelekuwt n ujenna. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />we afenemleγ zada. iḏaf n lγem g ṭiṭ n tsiniṯ yezhel iṭer n iḏaf n lliy lebas ƹlih al lmelekuwt n rebbiy.»<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />yaxy ṯƹejben ggeṯ tlamḏes mniyn slen aydin n dwiy, aḏ sesetnen: «mala mam yetquddu ayemneƹ.»<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />yaxy yesmuqlesen, yuwayasen: «ayuh al midden widyettic, amma al rebbiy kul ciy yettesed.»<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />lweqt ḏḏin yuwa buṭrus: «qa neccin nedja kul ciy neḏbeƹaḵ, matta zeγ tanelqa?»<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />yaxy yuweyesen yesuwƹ:</para>
  <para style="p" vid="MAT 19:28">«lḥeq afenemleγ: almiy tageƹemzeγ neči lliy yeḏwel d bnaḏem af lƹerciw g ddunyeṯ tejdit, tageƹemzem kennim lliy teḏbeƹmiḏ af 12 d leƹruc, we aḥekmem g leƹceyer n israyil lliy nihintin 12. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />rahiy kul yjen yedja tizeγwinis naγ yeṯmas naγ tiseṯmes naγ babis naγ yedjs naγ imeckennis naγ temmurinis afelxaḍert n ismiw, ayelqa 100 deqqes n lliy yedja, we ayerreṯ temeddurt n diyma. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />lekenti ggeṯ d imezweren ḏuglen d imeddefren aḏ ggeṯ d imeddefren ḏuglen d imezweren.»<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">tenfust n lliy xeḏmen g ijenni n tzurin</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />rahiy lmelekuwt n ujenna am yjen d bab n imezdeγen ybekker bac adyeγ mam ayexdem g ijennis n tzurin. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />aḏ yeṯfahem yiḏesen bac ayuc y kul yjen sisen dinar g as, yenkiyin al ijennis.<verse eid="MAT 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3" />wembeƹd yeffeγ yid ttesƹa, yufa mam yesugum g lxdemeṯ g amas lḥumeṯ. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />yaxy yuwayasen: «ureḥeṯ kennim zada xedmeṯ g ijenniw we afenxelṣeγ yeqƹeḏ.» yaxy reḥḥen.<verse eid="MAT 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 20:5" />aḏ iƹaweḏ yeffeγ azguwas aḏ yid maḍi 3 yerniy yenkiy ixeddamen iḍen al ijennis.<verse eid="MAT 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 20:6" />aḏ yid lxemsa n tmeddiṯ yeffeγ yufa ixeddamen iḍen man γiyr lxeḏmeṯ. ysesetnin: «maγer tetbeddim deh as kamel man γiyr lxeḏmeṯ?»<verse eid="MAT 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7" />yaxy uwanas: «afelxaḍert wiγenisexdem ḥed.» yuwayasen: «berreṯ kennim zada al ijenniw.»<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />ina n tufuyt yuwa bab n ijenni y lliy mesteklef γares: «sγuy af ixeddamen tucdasen iflusnesen, aḏ ḏel s lliy usend d imeddefren.» <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />yaxy usend lliy xdemen seg lxemsa yelqa kul yjen sisen dinar.<verse eid="MAT 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 20:10" />aḏ mniyn usend lliy uḏellen lxeḏmeṯ d imezweren ḥseben talqan iṭer n tteniyeṯ. yaxy yelqa kul yjen sisen dinar. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />aḏ mniyn leqqan g iflusen, meremren af bab n imezdeγen. <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />uwan: «rahiy inuh xdemen ssaƹeṯ ijeṯ aḏ cek tucidesen am neccin lliy nkennes as kamel g teffuyt.»<verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />yerra y yjen sisen: «neči wifeḍlimexc ayya ṣṣeḥbiw. muc neṯfahem af udinar? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />lqa lḥeqqiḵ treḥḥeḏ af imaniḵ. neči xseγ aḏuceγ y ayuh n umeddefer am cek. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />yaxy wiγric lḥeq aggeγ g iflusniw mammeḵ xseγ? naγ cek teḥseḏetten afelxaḍert uliw d meqqar? <verse eid="MAT 20:15" /><verse number="16" style="v" sid="MAT 20:16" />amyuh ḏuglen imeddeferen d imezweren aḏ imezweren d imeddeferen.»<verse eid="MAT 20:16" /></para>
  <para style="s">yesuwƹ yetxebber tijekkelt tisleṯa af tmettentis</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />mniyn yusi yesuwƹ yeggur al uwrceliym, yeqqim netta aḏ ṯnac seg tlamḏes weḥdesen g ubriḏ, yuwayasen:<verse eid="MAT 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 20:18" />«qa neccin taneli al uwrceliym, mani taluwyen midden neči lliy yeḏwel d bnaḏem we alucen y imeqqaren n lkuhhan aḏ lliy seḥfeḍen g cceriyƹeṯ, bac aḥekmen fella s tmettent, <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />we aleggen jar ifesn n iberraniyen bac aṯhezzan fella we alwetten s ṣṣut we alƹelqen af ṣṣelib. lekenti g as wi 3 takreγ.»<verse eid="MAT 20:19" /></para>
  <para style="s">lmeṭleb n yedj n yuwḥenna aḏ yeƹquwb</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />teqrebesd yedj n ṭarwa n zebediy aḏ nihnin yiḏes, tesjeḏ bac ateḍleb ḥaja. <verse eid="MAT 20:20" /><verse number="21" style="v" sid="MAT 20:21" />yaxy yuwayas: «matta texseḏ.» terras: «agg ṭarwaw inuh, yjen af liminiḵ, yjen af llisariḵ g lmemlektiḵ.» <verse eid="MAT 20:21" /><verse number="22" style="v" sid="MAT 20:22" />yaxy yuwayasen yesuwƹ: «kennim witsinemc matta tḍelbem. zeƹma taquddem aswem seg lkas lliy sesseγ siyes we aṣebrem?» rennas: «ih, netquddu.» <verse eid="MAT 20:22" /><verse number="23" style="v" sid="MAT 20:23" />yuwayasen: «lkasiw taswem siyes we atuƹeḏbem amma geƹmez af liminiw naγ af llisariw witettuceγ kan y lliy yejrayi baba y nihnin.» <verse eid="MAT 20:23" /><verse number="24" style="v" sid="MAT 20:24" />mniyn slen tlamḏes 10 ttenyaṯ uγen g lxeḍresen seg aydin 2 n aweṯen. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />yaxy yesγuyasen yesuwƹ lkul yuwa:</para>
  <para style="p" vid="MAT 20:25">«tessennem lliy lḥukkam n midden ttaniyeṯ ḥekmen disen aḏ imeqqernesen ḍelmen disen. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />amma kennim yexs witegc am ayuh jarewem, lliy yexs ayeḏwel d meqqar jarwem, yexs afenidel d xeddam. <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />aḏ lliy yexs aydel d mezwar jarwem, yexs afenidel d xdim, <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />amyuh neči lliy yeḏwel d bnaḏem usiγd bac axedmeγ muc bac alxedmen, we afdiγ midden s imaniw.»<verse eid="MAT 20:28" /></para>
  <para style="s">seḥli n sen ileƹmayen g riḥa</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />mniyn yeffeγ yesuwƹ aḏ tlamḏes seg riḥa, ḏbeƹƹent ggeṯ d midden. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />aḏ wsiyn sen ileƹmayen geƹemzen af lḥacit n abriyḏ. mniyn slen lliy yesuwƹ iƹedda s tmesen, ṣeyḥen: «reḥmeneγ ayya siydneγ ay memmis n dawud.» <verse eid="MAT 20:30" /><verse number="31" style="v" sid="MAT 20:31" />lekinti midden zheren fellasen bac asusmen. yaxy rnin ṣeyḥen iṭer: «reḥmeneγ ayya siydneγ, ay memmis n dawud.» <verse eid="MAT 20:31" /><verse number="32" style="v" sid="MAT 20:32" />yebbed yesuwƹ. yesγuyasen. aḏ ysestnin: «matta texsem afeneggeγ.» <verse eid="MAT 20:32" /><verse number="33" style="v" sid="MAT 20:33" />uwanas: «nexs aγentereḏ nzer, ayya siydneγ.» <verse eid="MAT 20:33" /><verse number="34" style="v" sid="MAT 20:34" />yesxef fellasen, yeggi ifesnis af ṭiṭewinesen. yaxy ƹlewleh ḏwellen zerren, aḏ yyuren deferris.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">yesuwƹ yetteḏef al uwrceliym</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />mniyn qrebben al uwrceliym uṣellen al lḥumeṯ n beyt faji g jbel n uzemmur. yenkiy yesuwƹ sen seg tlamḏes, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />yuwayasen: «ḏfeṯ al lḥumeṯ lliy zzaṯuwem. taḏefem teγyult teqqen nettaṯ aḏ ljeḥcis miretten aγetetend al γari. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />kan yeƹreḍḍewem ḥed, meltas, rebbiy iteḥteqineṯ. atennisiyyeb ƹlewleh.» <verse eid="MAT 21:3" /><verse number="4" style="v" sid="MAT 21:4" />aḏ iṣar ayuh bac ayentem lliy yuwayi yjen seg lenbiya seg lemmi:<verse eid="MAT 21:4" /></para>
  <para style="p" />
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />«becreṯ midden n ṣihyuwn:</para>
  <para style="q2" vid="MAT 21:5">qa lmelekwem tafendyas d lƹaqel af teγyult;</para>
  <para style="q2" vid="MAT 21:5">af ljeḥc memmis n teγyult</para>
  <para style="q2" vid="MAT 21:5">lliy tteggen fellas sdel.»<verse eid="MAT 21:5" /></para>
  <para style="p" />
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />yaxy reḥḥen aydin sen tlamḏa, ggen lliy yuwayasen yesuwƹ. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />uγend teγyult aḏ ljeḥc. ggen fellesen lḥweyjesen. yaxy yerkeb yesuwƹ. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />aḏ uḏellen ggeṯ d midden ttesun g ubriḏ s lḥweyjesen aḏ midden iḍen qedƹen g tizin n tiγliwin. ttesun sisen g abriyḏ. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />aḏ wsiyn ayuh n midden lliy gguren zzaṯ yesuwƹ aḏ lliy gguren g ljurtis, tṣedƹen:</para>
  <para style="q2" vid="MAT 21:9">«lmejd y memmis n dawud,</para>
  <para style="q2" vid="MAT 21:9">aynumer rebbiy lliy yused s ysem n rebbiy,</para>
  <para style="q2" vid="MAT 21:9">lmejd y lliy g ujenna.»<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />mniyn yuḏef yesuwƹ al uwrceliym terjij tmura lkulha, aḏ sesetnen middenis beƹeḍhum: «d mam wuhnit.» <verse eid="MAT 21:10" /><verse number="11" style="v" sid="MAT 21:11" />yaxy rennasen midden: «wuh d yesuwƹ nnabiy lliy seg nnaṣira g ljeliyl.»<verse eid="MAT 21:11" /></para>
  <para style="s">zeƹzeq n lliy zenzan g lheykel</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />wembeƹd yuḏef yesuwƹ al lheykel izeƹzeq siyes lliy zenzan naγ seγen lkul, aḏ yeqleb ṭwawel n lliy tṣerfen g iflusen aḏ lliy zenzan g itmelliwin. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />yuwa: «yetweri; tezeqqew y tẓalliṯ, lekenti kennim teggimteṯ d ddemus n ysereqen.» <verse eid="MAT 21:13" /><verse number="14" style="v" sid="MAT 21:14" />aḏ g lheykel usennesd ilƹemeyen aḏ d lƹeybin yseḥleyin. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />mniyn zren mag yeggi aḏ imeckenen lliy g lheykel mmalen: «lmejd y memmis n dawud.» γecceccen imeqqaren n lkuhhan aḏ lliy seḥfeḍen g cceriyƹeṯ. <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />uwanas: «tesliḏ matta mmalen midden.» yerrasen yesuwƹ: «sliyγ, yaxy witeƹzimemc xlas lliy yetweri: &lt; tseḥefdeḏ imeckenen aḏ lliy seffen mammeḵ asebḥen?&gt; » <verse eid="MAT 21:16" /><verse number="17" style="v" sid="MAT 21:17" />wembeƹd yeffeγ seg tmura, ireḥ al lḥumeṯ n biyt ƹenya yensa diyes.<verse eid="MAT 21:17" /></para>
  <para style="s">yesuwƹ yelƹen temeṭciṯ</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />al ača tajji mniyn yerred al tmura yelluz <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />yezra temeṭciṯ af lḥacit n abriyḏ, ireḥḥes, lekenti wiyufi felles kan tiwerqay. yeḏƹu fellas, yuwa: «maƹadc aḏerweḏ xlaṣ beƹed as wuh.» yaxy teqqur temeṭciṯ ƹlewleh. <verse eid="MAT 21:19" /><verse number="20" style="v" sid="MAT 21:20" />mniyn zren tlamḏes aydin ṯƹejben, uwan: «ya, mammeḵ teqqur ayuh n temeṭciṯ ƹlewleh.» <verse eid="MAT 21:20" /><verse number="21" style="v" sid="MAT 21:21" />yaxy yerrasen: «lḥeq afenemleγ: kan γarwem liyman aḏ witetcukkumc, tetqudum aggem iṭer n lliy ggiγ y ayuh tmečiṯ. ḥetta kan amlem y ayuh n jbel: &lt; mukes temlewḥeḏ g iylel. &gt; ayṣar lliy tuwim. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />aḏ lliy atḍelbem g tẓalliṯ s liyman atelqim.»<verse eid="MAT 21:22" /></para>
  <para style="s">lḥukem n yesuwƹ</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />mniyn yuṣel al lheykel, yuḏel yesseḥfaḍ, usennesd imeqqaren n lkuhhan aḏ iwessaren n midden. sesetnent: «d mam cek bac aggeḏ ayuh? aḏ mam yucaḵ ayuh n ssulṭeṯ.» <verse eid="MAT 21:23" /><verse number="24" style="v" sid="MAT 21:24" />yaxy yerrasen yesuwƹ yuwa: «neči zada tafensesteneγ af ḥaja ijeṯ turuh, kan tjawebmiḏ fellas, afenemleγ maγer teggeγ g ayuh: <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />mam yenkiy yaḥya bac ayzizdi y midden? d rebbiy yenkiy naγ d midden.» yaxy qqimen mmalen jaresen: «kan nuweyas: &lt; d rebbiy yenkiy,. &gt; taγennimel: &lt; maγer wituminemc siyes zeγ?&gt; <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />aḏ kan nuweyas: &lt; d midden,. &gt; balek ahejmen fellenneγ midden inuh afelxaḍert mmalen lliy yaḥya d nnabiy.» <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />yaxy uwanas: «winessinc.» yerrasen: «mala ḥetta neči wifenemmilexc man yuciḏ lḥeq bac aggeγ lliy teggext.»<verse eid="MAT 21:27" /></para>
  <para style="s">tenfust n bab n ijenni aḏ sen seg ṭerwas</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />«lekenti man amlem? yusi diyes yjen γares sen n imeckenen. ireḥ al yjen sisen yuwayas: &lt; as wuh ureḥ axdem g ijenni n tizuriniw. &gt; <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />yuwayas: &lt; maƹini. &gt; lekenti beƹd yendem ireḥ al ijenni. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />yekker argaza diyn ireḥ al memmis wissen yuwayas mammeḵ yuwa y umezwar. yerras: &lt; bahi ay baba. &gt; lekenti wiriḥc ayexdem. <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />mentan sisen mala yeggi s dwiy n babis?» yaxy uwan: «mezwar.» yuwa yesuwƹ:</para>
  <para style="p" vid="MAT 21:31">«lḥeq afenemleγ: lliy tlayemen g ḍrayeb aḏ lliy zenneneṯ taḏeḏafen qebluwem al lmelekuwt n rebbiy. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />yuγewemd yaḥya abriyḏ n lḥeq, wituminemc siyes. lekenti lliy tlayemen g ḍrayeb aḏ lliy zenneneṯ umennen siyes. aḏ baqi kennim witendimemc aḏ wituminemc.»<verse eid="MAT 21:32" /></para>
  <para style="s">tenfust n ifelleḥen</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />sseγdeṯ tenfust iḍen:</para>
  <para style="p" vid="MAT 21:33">«yezzu yjen d bab n lmelk ijenni n tizurin. yeggis tkeṯert aḏ yeγez diyes lmeṣert aḏ yebna diyes tγurfet yuƹussu. wembeƹd yuca ijenni y ifelleḥen s lbey, yerzef.<verse eid="MAT 21:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 21:34" />mniyn yused lweqt n tizurin, yenkiy ičiwnis bac adeγen lγelleṯ. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />lekenti ifelleḥen ṭṭefen ičiwen aḏ wetten yjen sisen, aḏ nγen wissen aḏ ḥdefen wi 3 s iḍγaγen. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />wembeƹd yenkiy ičiwen iḍen iṭer n imezweren. lekenti ggenesen ifelleḥen mammeḵ ggen y imezweren.<verse eid="MAT 21:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 21:37" />aḏ g lexxer yenkiyesen memmis, yuwa: «taḏegden s memmi.» <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />mniyn zrent uwan y beƹeḍhum: «d wuh lliy tatyureṯ, yya atnenγ bac anwiy terektis.» <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />ṭṭefent sefγent seg ijenni nγent. <verse eid="MAT 21:39" /><verse number="40" style="v" sid="MAT 21:40" />mala almiy tadyer bab n ijenni, matta tayeg y aydin n ifelleḥen.» <verse eid="MAT 21:40" /><verse number="41" style="v" sid="MAT 21:41" />rennas: «indin lliy wiḥlin yexs atenyenγ we ayuc ijenni y ifelleḥen iḍen bac asucen lγelleṯ g lweqtis.» <verse eid="MAT 21:41" /><verse number="42" style="v" sid="MAT 21:42" />yaxy yuweyesen yesuwƹ: «yenda witeƹzimemc lliy yetweri g lektab:</para>
  <para style="p" vid="MAT 21:42" />
  <para style="q2" vid="MAT 21:42">&lt;aḍγaγ lliy luḥent ibennayen</para>
  <para style="q2" vid="MAT 21:42">yeḏwel netta d lsas meqqar n terkineṯ.</para>
  <para style="q2" vid="MAT 21:42">aḏ ayuh lkul s rebbiy</para>
  <para style="q2" vid="MAT 21:42">amma neccin nufiy d leγribeṯ. &gt;<verse eid="MAT 21:42" /></para>
  <para style="p" />
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />afelxaḍert n ayuh afenemleγ: lmelekuwt n rebbiy tafentiḏyekkes rebbiy we atyuc y midden iḍen bac aḏucen lγeltis. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />aḏ kul yjen ayuda af ayuh n aḍγaγ ayerrez, aḏ lliy ayuda felles ayuh n aḍγaγ atyezd d izeḍ.» <verse eid="MAT 21:44" /><verse number="45" style="v" sid="MAT 21:45" />mniyn slen imeqqaren n lkuhhan aḏ iferysiyyen aydin tinfes fhemmen lliy netta ydugga fellesen nihnin. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />smuḏen tateṭfen lekenti ugeḏḏen seg midden afelxaḍert mmelen felles d nnabiy.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">tenfust n ibay n temeγra n memmis n lmelek</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />yerniy yesuwƹ yuflay s tinfes, yuwa:<verse eid="MAT 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 22:2" />«lmelekuwt n ujenna am yjen d lmelek yeggi ibay n tmeγra n memmis. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />yenkiy ixdimnis bac aseḥedren midden y tmeγra. lekenti wiqqilen midden adesen. <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />iƹaweḏ lmelek yenkiy ixdimnis tijekkelt iḍen, yuwayasen: &lt; mleṯ y lliy tseḥedremten: qa messi yḥder ifwunesen aḏ igendaz lliy quwen aγresexten aḏ kul ciy yejra. ḥderted g umkanuwem. &gt;<verse eid="MAT 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5" />lekenti lliy yseḥedrin widdusinc. yjen ireḥ al umezdeγis. yjen ireḥ al teḥnuṯis. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />amma ttenyaṯ ṭṭefen ixdimen n lmelek subenten aḏ nγenten.<verse eid="MAT 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 22:7" />yaxy iγeccec lmelek. yenkiy ljiycis yenγa indin lliy nγen ixdimnis aḏ yeḥreqesen tmuresen. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />wembeƹd yuwa y ixdimnis: &lt; messi n tmeγra yeḥdered amma lliy tseḥedremten wistehlenc. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />ureḥeṯ al lmjameƹ n ibriyḏen, aḏ kul yjen atefem sγuytas al umessi n tmeγra. &gt; <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />yaxy ffeγen ixdimen al ibriyḏen. kercen g lliy ufenten lkul, ṣbiḥen aḏ lliy wiḥlin almiy tƹebba tezeqqa n tmeγra s midden.<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />mniyn yuḏef lmelek bac ayreḥeb s midden, yezra yjen wiyiriḍc lḥweyej n tmeγra. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />yaxy yuwayas: &lt; ayya argaz mammeḵ tuḏeffeḏ al deh aḏ cek witiriḍec lḥweyej n tmeγra?&gt; lekenti ttani isusem. <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />yaxy yuwa lmelek y ixdemnis: &lt; qntes ifesnis aḏ idernis tluḥemt g tellest al barra mani diyes yyeḍ aḏ aγezzi n cwerb s uγenna. &gt; <verse eid="MAT 22:13" /><verse number="14" style="v" sid="MAT 22:14" />rahiy lliy yesγuyasen rebbiy ggeṯ, amma lliy iwezeyin d fercu.»<verse eid="MAT 22:14" /></para>
  <para style="s">ḏfeƹ n ḍḍeribeṯ y lmelek n iruwmeyen</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />yaxy iferysiyyen mfehmen bac aseḥṣlen yesuwƹ s dwiys. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />aḏ nkiynes lbeƹḍ n tlamḏesen nihnin aḏ midden seg lḥizb n hiyruwdus, bac atsesetenen: «ayya lmuƹellem nessen lliy cek witeskerkisec aḏ teseḥfaḍeḏ y midden abriyḏ n rebbiy yeqƹeḏ. aḏ witettegiḏec s ḥetta d yjen aḏ witetteggec leḥsab y lquweṯ n lbeƹḍ n midden. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />mlaneγ zeγ matta lquliḵ; ḥlal uca n ḍḍeribeṯ y lmelek n iruwmeyen naγ ḥram.»<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />yaxy yefhem yesuwƹ matta smuḏen, yuwa: «ayya lliy texsem asiḵnem imanuwem, maγer taxsem altseḥeslem? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />siḵentid flus seg iflusen lliy tettucem sisen ḍḍeribeṯ.» yaxy zelnas dinar. <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />ysesetnin: «d mam wuh g tteṣwireṯ, aḏ n mam ayuh n nqiceṯ.»<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />uwanas: «n lmelek iruwmeyen.» yuwayasen: «mala uceṯ lliy n lmelek iruwmeyen y lmelek n iruwmeyen, aḏ lliy n rebbiy y rebbiy.» <verse eid="MAT 22:21" /><verse number="22" style="v" sid="MAT 22:22" />mniyn slen aydin n dwiy fehhen. reḥḥen djent dinet.<verse eid="MAT 22:22" /></para>
  <para style="s">sekker n lliy mmuṯen</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />as diyn usennesd lbeƹḍ n iṣedduwqiyiyen lliy witemnenc stneḵri n lliy mmuṯen, sesetnent:<verse eid="MAT 22:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 22:24" />«ayya lmuƹellem, yuwa muwsa: «almiy yemmuṯ yjen aḏ widdixellefc imeckenen, yexs ayenjef uwas tedjeltis we ayqeyeḍ imeckenen s ysem n uwas.»<verse eid="MAT 22:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 22:25" />yusi γarneγ 7 d aweṯen. yenjef mezweresen yemmuṯ aḏ netta wiγrec imeckenen yedja lehlis y uwas. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />aḏ am idin yeṯmas: wissen aḏ wi 3 al wis 7 . <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />aḏ beƹdesen lkul temmuṯ zada aydin temeṭṭuṯ. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />mala as n tneḵri, y mam taddel ayuh n temeṭṭuṯ afelxaḍert tusi d lehliṯesen lkul.» <verse eid="MAT 22:28" /><verse number="29" style="v" sid="MAT 22:29" />yuweyesen yesuwƹ:</para>
  <para style="p" vid="MAT 22:29">«kennim twedrem afelxaḍert witfehmemc lktab aḏ quddu n rebbiy. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />rahiy midden as n tneḵri winejfenc aḏ wisenjefenc. amma nihnin tadlen am lmleyka n rebbiy g ujenna. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />amma af tneḵri n lliy mmuṯen, yaxy witeslimc matta yuwa rebbiy g lkitab: <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />&lt;neči d rebbiy n ibrahiym aḏ d rebbiy n isḥaq aḏ d rebbiy n yeƹquwb?&gt; rahiy rebbiy muc d rebbiy n lliy mmuṯen amma d rebbiy n lliy dderen s liymanisen.» <verse eid="MAT 22:32" /><verse number="33" style="v" sid="MAT 22:33" />mniyn slen midden ayuh n dwiy fehhen seg seḥefdis.<verse eid="MAT 22:33" /></para>
  <para style="s">luwṣayaṯ temeqqart</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />mniyn slen iferysiyyen lliy yesuwƹ yeqqes imewen n iṣedduwqiyiyen mleymen jmiyƹ. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />aḏ ysesetni yjen sisen, aḏ netta yessen cceriyƹeṯ bac atiseḥṣel: <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />«d matta zeγ luwṣayaṯ temeqqart lliy g cceriyƹeṯ ayya lmuƹellem.» <verse eid="MAT 22:36" /><verse number="37" style="v" sid="MAT 22:37" />yerras yesuwƹ:</para>
  <para style="p" vid="MAT 22:37">«xs rebbiyḵ s lliy diyeḵ lkul s uliḵ aḏ ruwḥiḵ aḏ lfiqriḵ. <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />ayuh d luwṣayaṯ temeqqart temezwert. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />aḏ tisneṯ am nettaṯ. xs midden am imaniḵ. <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />cceriyƹeṯ n muwsa aḏ lektub n lenbiya seg ayuh n sent luwṣayaṯ.»<verse eid="MAT 22:40" /></para>
  <para style="s">lmesiyḥ aḏ dawud</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />mniyn wsiyn iferysiyyen mleymen ysesetnin yesuwƹ: <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />«matta lqulewem g lmesiyḥ, al mammun yḏuggel?» uwanas: «netta seg ṭarwa n dawud.» <verse eid="MAT 22:42" /><verse number="43" style="v" sid="MAT 22:43" />yaxy ysesetnin: «mala mammeḵ zeγ ysemat dawud d rebbiys mniyn yuwa s rruwḥ?<verse eid="MAT 22:43" /></para>
  <para style="p" />
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />&lt;yuwa rebbiy y siydiw:</para>
  <para style="q2" vid="MAT 22:44">«geƹmez af liminiw</para>
  <para style="q2" vid="MAT 22:44">bac aggeγ leƹadaḵ</para>
  <para style="q2" vid="MAT 22:44">adug iderniḵ?»&gt;<verse eid="MAT 22:44" /></para>
  <para style="p" />
  <para style="p">
    <verse number="45" style="v" sid="MAT 22:45" />kan dawud yetsemmayi d siydiw lmesiyḥ mammeḵ zeγ taydel d yjen seg ṭarwas?» <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />yaxy wiqud ḥetta d yjen asyer ḥetta tuflayt ijeṯ, aḏ seg as diyn wiqud ḥetta d yjen atisesten af ḥaja.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">yesuwƹ yemmal y midden arren lbalisen seg indin lliy seḥfeḍen g cceriyƹeṯ aḏ iferryisiyen</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />yuflay yesuwƹ y midden aḏ tlamḏes. <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />yuwa:</para>
  <para style="p" vid="MAT 23:2">«lliy seḥfeḍen g cceriyƹeṯ aḏ iferysiyyen γarsen lḥeq aften g umkan n muwsa. aγeṯ dwiysen, teggem matta mmelenwem. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />amma witteggec lliy tteggent afelxaḍert nihnin witeggenc s dwiysen.<verse eid="MAT 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 23:4" />aḏ nihnin tteqnen ikemmusen ḏqellen aḏ tteggenten af tiγerdin n midden amma nihnin wilγisenc aṭfen disen ḥetta s iḍuḍenesen. <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />aḏ kul ḥaja tteggenteṯ, tteggenteṯ bac atenezren midden. rahiy nihnin sseƹreḍen tiƹeṣebin lliy teggentent y tẓalliṯ aḏ g temma n leḥweyjesen. <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />aḏ xsen imkanen imezweren g imesiwen, aḏ uḏem n lmejmeƹ almiy mleymen midden. <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />aḏ xsen mam aysellem fellesen g ibriyḏen, we asensγuyen midden ayya lmuƹellem.<verse eid="MAT 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8" />amma kennim witedjeṯ ḥed afenyesγuy ayya lmuƹellem afelxaḍert lmuƹelmuwem d yjen aḏ kennim lkul d aweṯen. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />aḏ wisγuyṯ y ḥetta ḥed af tammurt ay baba afelxaḍert γarwem bab yjen, aḏ netta d lliy yella g ujenna. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />aḏ witedjeṯ ḥetta d yjen afenyesγuy ya lqayed afelxaḍert γarwem lqayd yjen aḏ netta d lmesiyḥ. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />aḏ lliy yexs ayeḏwel d meqqar jarewem yexs afenidel d xeddam. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />kul yjen ayeg tinzar ayetweḥqer. aḏ kul yjen ayerla midden we aydel am nihnin ayseƹla rebbiy g ccanis.<verse eid="MAT 23:12" /></para>
  <para style="s">yesuwƹ iḥemmeq af lliy seḥfeḍen g cceriyƹeṯ aḏ iferryisiyen</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />lekenti ya ḥlilkum ayya lliy teseḥfeḍem g cceriyƹeṯ aḏ ayya iferysiyyen lliy texsem asiḵnem imanuwem. rahiy kennim tetteqsem g lmelekuwt n ujenna g uḏem n midden. la tetteḏefmas kennim la tettedjim mam asyeḏef. <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />ya ḥlilkum ayya lliy texsem asiḵnem imanuwem. rahiy kennim tbelƹem g lmal n tedjelin aḏ kennim tetẓellim tẓalliṯ tezirert bac afennezren midden. afelxaḍert n aydin tafeniḥeseb iṭer n ttenyaṯ.<verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />ya ḥlilkum ayya lliy texsem asiḵnem imanuwem. rahiy trezfem g iylel aḏ tammurt bac arnim ḥetta yjen y leƹdeduwem. aḏ almiy afenyḏbeƹ yjen, aterrem seg iḏbab n jhennem iṭruwem.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />ya ḥlilkum ayya lliy tnezγem g midden aḏ kennim witzerremc. temmelem lliy yedjul s lheykel tjelliṯis wiḥeyyer atetyerza. amma lliy yedjul s wureγ n lheykel yexs wiyetrezic tjelliṯis. <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />ayya lliy witsinemc aḏ d ileƹmayen. mentan d meqqar iṭer wureγ naγ lheykel lliy iterra wureγ d meqdus?<verse eid="MAT 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 23:18" />aḏ temmelem lliy yedjul s mkan n teγrest tjelliṯis wiḥeyyer atetyerz, amma lliy yedjul s lweƹdeṯ lliy felles. yexs wiyetrezic tjelliṯis. <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />ayya lliy d ileƹmayen mentan d meqqar iṭer, lweƹdeṯ naγ mkan n teγrest lliy iterra lweƹdeṯ d temqudust. <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />lliy yedjul s mkan n teγrest. rahiy yedjul siyes aḏ s lliy anjis lkul. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />aḏ lliy yedjul s lheykel. rahiy yedjul siyes aḏ s rebbiy lliy ysekken diyes. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />aḏ lliy yedjul s ujenna. rahiy yedjul s lƹerc n rebbiy aḏ s rebbiy lliy ygeƹmez felles.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />ya ḥlilkum ayya lliy texsem asiḵnem imanuwem. rahiy kennim tettucem lƹcur n nnaƹnaƹ aḏ n ḥebet ḥlewa aḏ icemmen amma tettum lefrayeḍ lliy g cceriyƹeṯ n muwsa: lƹedl aḏ rreḥmeṯ aḏ lemeneṯ. yexs ggem inuh aḏ witettetumc ttaniyeṯ. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />ayya lliy tnezγem g midden aḏ kennim witzerremc. rahiy kennim tetṣeffim aman seg zuγlen amma tbelƹem lγem.<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />ya ḥlilkum ayya lliy texsem asiḵnem imanuwem. rahiy tesendafem lkas aḏ tḥedduqt s barra aḏ nihnin ƹebban s mag teḍmeƹem diyes aḏ tesreqemt. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />ayya ferrisi lliy wizerc, sendef lkas s jjaj saƹa bac ayendaf s barra.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />ya ḥlilkum ayya lliy texsem asiḵnem imanuwem. rahiy kennim am leqbur lliy ḏhennen s ukenkil. tteḍherend s barra zƹemen aḏ nihnin s jjaj ƹebban s ixsan n lliy mmuṯen aḏ kul ḥaja tenzes. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />amyuh kennim tetteḍheremd d ṣbiḥen amma kennim tečurem s tmexsiwt n usiḵen n imanuwem aḏ ccer.<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />ya ḥlilkum ayya lliy texsem asiḵnem imanuwem. rahiy kennim tbennim leqbur n lenbiya aḏ tseryem g leqbur n ṣbiḥen. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />aḏ temmalem: «lukan nedder g ussan n ibabenenneγ, winsezzelc yiḏesen iḏemmen n lenbiya.» <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />s ayuh n dwiy tecehdem lliy kennim d ṭarwa n indin lliy nγen lenbiya. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />mala kemleṯ matta uḏelent ibabnuwem bac ayemγer guḏa n ibekkaḍnuwem. <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />ay tilefsiwin, ay ṭarwa n tlefsiwin, mammeḵ tarulem seg jhennem? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />qa neči tafennekiyeγ lenbiya aḏ lliy ssenen aḏ lliy seḥfeḍen g cceriyƹeṯ. lekenti tanγem aḏ taṣelbem lbeƹḍ sisen. aḏ tatenwettem s ṣṣut g lemjameƹ aḏ tatenzeƹezqem seg tmura al tmura.» <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />afenemleγ taydel g tḵerminuwem iḏemmen ṣbiḥen lliy wezƹen af tammurt seg iḏemmen n habil ṣbiḥ al iḏemmen n zekeriyya memmis n berxiyya lliy tenγimt jar lheykel aḏ mkan n teγrest. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />lḥeq afenemleγ rahiy leƹqab n aydin lkul tayezwa af ayuh n ljiyl.<verse eid="MAT 23:36" /></para>
  <para style="s">yesuwƹ yedjella g uwrceliym</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />ayya uwrceliym, ayya uwrceliym, ayya lliy tneγγeḏ g lenbiya aḏ tḥedfeḏ lliy yenkiyen rebbiy. mennit agγ bac aleymeγ ṭarwam, mammeḵ tetteg tyazit iflusinis adug frewnis, lekenti witteqqilem. <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />qa lḥewecwem taxerben we aqimen am idin. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />afenemleγ: «maƹadc altezrem xlaṣ al ussan lliy tamlem:</para>
  <para style="q1" vid="MAT 23:39">aynumer rebbiy</para>
  <para style="q1" vid="MAT 23:39">lliy yused s ysem n rebbiy.»<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">lmesiyḥ yetxebber af hdam n lheykel</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />wembeƹd yeffeγ yesuwƹ seg lheykel. mniyn ireḥ s yin usennesd tlamḏes uwanas: «smuqel al ayuh n lheykel mennit yezƹem.» <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />yaxy yuwayasen: «tzarrem ayuh n lbni lkul? lḥeq afenemleγ: rahiy tayuda lkul aḏ wiyetγimi siyes ḥetta d aḍγaγ af aḍγaγ.»<verse eid="MAT 24:2" /></para>
  <para style="s">lemereṯ n ukemmel n ddunyeṯ</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />mniyn yusi yesuwƹ ygeƹmez af jbel n uzemmur, usennesd tlamḏes weḥdesen uwanas: «mlaneγ lemmi tayṣar ayuh? aḏ d matta lemereṯ n uririḵ aḏ n ukemmel n ddunyeṯ.» <verse eid="MAT 24:3" /><verse number="4" style="v" sid="MAT 24:4" />yaxy yerrasen yesuwƹ:</para>
  <para style="p" vid="MAT 24:4">«rreṯ lbaluwem, wifenyetḍeyyeƹ ḥetta d yjen. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />rahiy ggeṯ tadesen s ismiw aḏ kul yjen sisen yemmel: &lt; d neči d lmesiyḥ. &gt; we aḍeyƹen ggeṯ d midden.<verse eid="MAT 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 24:6" />aḏ taslem s leḥrub aḏ lexbar n leḥrub. witegeḏec. yexs ayṣar ayuh lkul, aḏ baqi wecci muc d laxer n ddunyeṯ. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />aḏ tatehjem lummeṯ af lummeṯ, aḏ lmemelkeṯ af lmemelkeṯ. we alezen midden we aterjij tammurt g ggeṯ d imuḵen. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />aḏ ayuh lkul am aγenna mezwar n ara.<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />lweqt ḏḏin tafennucen midden y uƹeḏḏeb, we afenenγen, we afenkerhen midden lkul afelxaḍert n ismiw. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />we afγen ggeṯ seg liyman, we axanen beƹeḍhum, we akerhen beƹeḍhum. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />we adḍehren ggeṯ d lliy tteren imanesen d lenbiya we aḍeyƹen ggeṯ d midden. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />almiy ayeƹem ccer atenkez temexsiwt jar midden. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />lekenti tayemneƹ lliy ayeṣber al laxer. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />aḏ lebcareṯ n lmelekuwt taslen siyes midden lkul. we alcehden g tammurt lkul. beƹd ayuh atkemmel ddunyeṯ.<verse eid="MAT 24:14" /></para>
  <para style="s">ḍḍiq meqqar</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />lemmi tazrem lkufer lliy tateggen g amas n mkan meqdus we ayesenjes lheykel mammeḵ yuwa fellas denyal nnabiy, rreṯ lbaluwem almiy taƹezmem bac afehmem <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />lweqt ḏḏin yexs rulen lliy g ljiheṯ n lyehuwdiya al lejbal. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />aḏ lliy yella al nnaj lḥiḍis wizuggic bac aywiy lliy g lḥucis. <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />aḏ lliy yella g umezdeγ yexs wiḏuggelc bac aywiy tlebetis. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />aḏ d timeγben lliy tteruneṯ aḏ lliy ssesfaneṯ ussan diyn. <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />ḍelbeṯ rebbiy bac widelc rweluwem g tejrest naγ g sebbeṯ. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />rahiy tayṣar lweqt ḏḏin ḍḍiq d meqqar wiṣarc am netta xlaṣ seg tlaliṯ n ddunyeṯ al ṭuruh. aḏ wiyetṣerc beƹdis zada. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />ussan diyn rebbiy tatenyeg d igezzulen bac amenƹen lliy iwezayin. lukan rebbiy witenyetegc d igezzulen wiyetqimi ḥetta d yjen yedder.<verse eid="MAT 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23" />lweqt ḏḏin kan yuweyawem yjen: &lt; qa lmesiyḥ deh naγ diyn. &gt; witemnec. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />rahiy tadḍehren idjalen aḏ lliy tteren imanesen d lenbiya we aggen lmuƹjizaṯ timeqqarin aḏ leƹjayeb bac aḍeyƹen ḥetta lliy iwezayin rebbiy kan qudden. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />qa neči uwiγawem af ayuh qebbel man ayṣar. <verse eid="MAT 24:25" /><verse number="26" style="v" sid="MAT 24:26" />mala kan uwanawem midden: &lt; qa lmesiyḥ yella g lexla. &gt; wistefγec naγ: &lt; qa yella g tzaγwin al jaj. &gt; witentemnec. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />rahiy mammeḵ yetwelƹej lberq s mcerreq al mγerreb, am idin tteseγd neči lliy yeḏwel d bnaḏem. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />rahiy lbizan temlayemen mani diyes ljifeṯ.»<verse eid="MAT 24:28" /></para>
  <para style="s">lliy yeḏwel d bnaḏem tadyas tijekkelt iḍen</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />«ƹlewleh beƹd aydin n ḍḍiq g ussan diyn</para>
  <para style="q1" vid="MAT 24:29">tatan tufuyt we atetweγ teziri,</para>
  <para style="q1" vid="MAT 24:29">we awdan iṯran seg ujenna,</para>
  <para style="q1" vid="MAT 24:29">we ayxelxel rebbiy jenna.<verse eid="MAT 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30" />lweqt ḏḏin tateḍher lemereṯ n isaw neči lliy yeḏwel d bnaḏem g ujenna. we aƹeyedneṯ leqbayel lliy g tammurt lkul. we alzren midden neči lliy yeḏwel d bnaḏem tteseγd seg ujenna s uquddu aḏ lmejd d imeqqaren. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />we ankiyγ lmleykew ṣuḍen g lbuwq d meqqar we aleymen lliy wezixten seg leḍraf n ddunyeṯ lkul.<verse eid="MAT 24:31" /></para>
  <para style="s">ḥefdeṯ seg tmečiṯ</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />ḥefdeṯ af tmečiṯ ayuh n tenfust. almiy uzellen aman g isγernis aḏ ulyented tiwerqayis tasnem lliy nefdu ḥeḍerbac. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />am idin almiy tazrim ayuh n iḥajeyen lkul yexs asnem lliy d aydin d lweqt n isses. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />lḥeq afenemleγ, ayuh n ljiyl wiyetkemmelc xlaṣ almiy aṣaren ayuh n iḥajeyen lkul. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />jenna aḏ tammurt tamuksen amma dwiyw tayeqqim diyma.<verse eid="MAT 24:35" /></para>
  <para style="s">aydin n as wityessin ḥetta d yjen</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />amma aydin n as aḏ aydin nessaƹeṯ witenyessin ḥed, la seg midden, la seg lmleyka n ujenna kan babenneγ weḥdes. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />aḏ mammeḵ tusi ddunyeṯ g ussan n nuwḥ taddel am idin almiy tteseγd neči lliy yeḏwel d bnaḏem. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />qebbel ṭṭufan wsiyn midden tetten, sessen, nejfen aḏ senjafen al lemmi yusesend as lliy yuḏef diyes nuwḥ al lbabur. <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />aḏ yehjem ṭṭufan aḏ nihnin lhan, yewyin lkul. amyuh tayṣar almiy tteseγd neči lliy yeḏwel d bnaḏem.<verse eid="MAT 24:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 24:40" />lweqt ḏḏin seg sen irgazen g umezdeγ yjen, yjen tatuwyen ttani tatedjen. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />aḏ seg sen tseḏnan zeḍneṯ af tessirt ijeṯ, tawyen ijeṯ sisneṯ we adjen ttani. <verse eid="MAT 24:41" /><verse number="42" style="v" sid="MAT 24:42" />mala sehreṯ, terrem lbaluwem, afelxaḍert witsinemc lemmi tadyer siydwem. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />aḏ mammeḵ tsennem, lukan bab n lḥuc yessen lemmi tayehjem fellas lliy tatyesreq. rahiy yeqqim yettera lbalis aḏ wiyedjic mam ayeḏef al lḥucis. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />mala jreṯ imanuwem zada afelxaḍert neči lliy yeḏwel d bnaḏem tadereγ g lweqt lliy widyettic af lbaluwem.<verse eid="MAT 24:44" /></para>
  <para style="s">tenfust n xdim lliy wisereqc</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />yella ca xdim wisereqc aḏ frih tatyeg siydis bac ayuc y midnis uču g lweqtis? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />ayya sseƹdis aydin n xdim lliy adyas siydis we atyaf iteg g aydin n lxeḏmeṯ. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />lḥeq afenemleγ rahiy tatyeg af lmelkis lkul. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />kan yella xdim wiyeḥli aḏ yuwa g ulis: &lt; siydiw tayƹeṭṭel wicci widyetteric. &gt; <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />aḏ yuḏel yečaṯ ixdimen lliy am netta yses yid imeskar. <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />siydis tadyer g as aḏ seƹeṯ widetisenc af lbalis. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />we atizeƹzeq we asyeg mammeḵ yeggi y lliy siḵenen g imanesen. we aydel dinet yyeḍ aḏ aγezzi n icwerba s uγenna.»<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">tenfust n 10 n tqeyyarin</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />lmelekuwt n ujenna am 10 n tqeyyarin qamneṯ inernesneṯ reḥneṯ bac aƹreḍneṯ y leƹruws. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />aḏ disneṯ 5 frihat aḏ 5 aha. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />yaxy qamneṯ tindin lliy wissinnec inernesneṯ s uḏi lliy disen akehaw. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />amma tindin lliy ssenneṯ awyenneṯ iḏesneṯ uḏi g lmaƹuwn.<verse eid="MAT 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 25:5" />mniyn iƹeṭṭel leƹruws, nudemneṯ aḏ ṭṭeṣneṯ lkulhum. <verse eid="MAT 25:5" /><verse number="6" style="v" sid="MAT 25:6" />yid azgen n yeḍ sleneṯ ṣeyyeḥ: «qa yused leƹruws neggezmeṯ bac atleqqaneṯ.»<verse eid="MAT 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7" />yaxy kkerneṯ tiqeyyarin lkul jreneṯ inerrenesneṯ. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />aḏ uwaneṯ lliy wissinnec y lliy frihat: &lt; ucemteneγ fercu n uḏi s γarḵmeṯ. rahiy inernenneγ tbessan. &gt;<verse eid="MAT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9" />yaxy rrentasneṯ lliy frihat: &lt; balek wiγennikeffic. amma ureḥmeṯ al lliy yezenza g uḏi teseγmeṯ. &gt;<verse eid="MAT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10" />lekenti mniyn reḥneṯ bac aseγneṯ, yuṣel leƹruws. aḏ uḏefneṯ yiḏes al tzaqqa n tmeγra lliy ḥderneṯ. yaxy yeqqes lbab <verse eid="MAT 25:10" /><verse number="11" style="v" sid="MAT 25:11" />wembeƹd rrented tiqeyyarin ttanyaṯ uwaneṯ: «ayya siydneγ ayya siydneγ mireneγ lbab.»<verse eid="MAT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12" />yaxy yuwa: «lḥeq afentemleγ. neči wifentessineγ.»<verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />rreṯ lbaluwem mala afelxaḍert witisinemc aydin n as, aḏ aydin n ssaƹeṯ.<verse eid="MAT 25:13" /></para>
  <para style="s">tenfust n lemeneṯ n ttujar</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />lmelekuwt n ujenna am yjen tayerzef. yesγuy af ixdimnis. yedjasen iflusnis d lemeneṯ. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />yuca y yjen sisen 5 d lweznaṯ. aḏ y wissen 2 lweznaṯ. aḏ y attani lweznaṯ 1, y kul yjen felḥaseb n lqudretis. wembeƹd yerzef.<verse eid="MAT 25:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 25:16" />aḏ ƹlewleh ireḥ weddin lliy γares 5 d lweznaṯ yseγ, yezenza sisneṯ, yerbeḥ 5 iḍen. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />aḏ am idin yeggi weddin lliy γares senneṯ. yerbeḥ senneṯ iḍen. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />amma weddin lliy yelqa lweznaṯ ijeṯ ireḥ yeγez burriƹ yenbeliṯ diyes.<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />beƹd isuggasen d iziraren yerred bab n ixdimen. yesγuy fellasen bac atenniḥaseb. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />yusesd wuddin lliy yelqa 5 d lweznaṯ. yucas 5 n lweznaṯ ttanyaṯ. yuwayas: «ay siydi, cek tucidiḏ 5 n lweznaṯ, aḏ qa tinuh d 5 iḍen rbeḥextent.»<verse eid="MAT 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21" />yuwayas siydis: «teggiḏ teṣbiḥt ayya ixdim ṣbiḥ aḏ lliy d ṯṯiqeṯ. cek testeḥfdeḏ af ufercu. tarniγ aggeγ jar ifesniḵ lliy iṭer n ayuh. sed freḥ iḏiy.»<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />wembeƹd yusesd lliy yelqa senneṯ. yuwayas: «ay siydi, cek tucidiḏ senneṯ. aḏ qa tinuh d senneṯ iḍen rbeḥextent.»<verse eid="MAT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23" />yuwayas siydis: «teggiḏ teṣbiḥt ayya ixdim ṣbiḥ aḏ lliy d ṯṯiqeṯ. cek testeḥfdeḏ af ufercu. tarniγ aggeγ jar ifesniḵ lliy iṭer n ayuh. sed freḥ iḏiy.»<verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />wembeƹd yusesd lliy yelqa lweznaṯ ijeṯ yuwa: «ay siydi ssenγaḵ tuƹerreḏ. tmeddejreḏ lliy ḵrezen ttaniyeṯ. aḏ tetleyameḏ lγaleṯ n lliy zzun ttaniyeṯ. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />yaxy ugeḏḏeγ, reḥḥeγ nbelleγ lwezentiḵ g tammurt. qa ayuh d lementiḵ.»<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />yerras siydis: «ayya ixdim lliy wiyeḥli aḏ d buxli. mala tesnneḏ lliy neči meddejreγ mag ḵrezent ttaniyeṯ, aḏ tleyameγ seg lliy zzunt ttaniyeṯ? <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />muc xiyr lukan teggiḏ iflusniw g lbenkeṯ bac atenelqiγ nihnin aḏ lfeyedtesen.»<verse eid="MAT 25:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 25:28" />wembeƹd yuwa y ixdimnis: «kstas lweznaṯ, tucemteṯ y lliy γares 10. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />lliy γares tarniγ asuceγ almiy ayfaḍ. amma lliy wiγrec tasekseγ ḥetta lliy yusi γares. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />amma ayuh n xdim lliy wiyeḥli zeƹzeqet al tellest barra mani diyes ƹeyyeḍ aḏ aγezzi n cwerb s uγenna.»<verse eid="MAT 25:30" /></para>
  <para style="s">lliy yeḏwel d bnaḏem tayeḥkem af midden lkul</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />«almiy tadereγ neči lliy yeḏwel d bnaḏem s lmejdiw aḏ iḏiy lmleykew lkul, tageƹemzeγ af lƹerc n lmejdiw. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />we amleymen zzaṯiw midden lkul. we aferqeγ jarsen mammeḵ yetferreq lliy yesefraḏ jar tulli aḏ teγatin.<verse eid="MAT 25:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 25:33" />we aysebbed tulli af liminis aḏ tiγatin af lisaris. <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />wembeƹd aymel lmelek y lliy af liminis: «sted ayya lliy inumrewem baba, bac awerṯem lmelekuwt lliy yejreyewemtiḏ rebbiy s manis yeggi ddunyeṯ. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />afelxaḍert mniyn lluzeγ tsetecmiḏ, aḏ mniyn ffuḏeγ tsessumiḏ, aḏ mniyn usiγ d aγrib tseskenmiḏ jarwem. <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />aḏ mniyn usiγ d ƹeryan teksimiḏ, aḏ mniyn uḍenneγ tehwim fella, aḏ mniyn usiγ ḥbesseγ tusimiḏ.»<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />yaxy rennas ṣbiḥen: «ayya siydneγ lemmi nezraḵ telluzeḏ nsečaḵ? naγ nezreḵ teffuḏeḏ nseswaḵ? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />naγ lemmi nufaḵ d aγrib nseseknaḵ jerenneγ? aḏ d ƹeryan nekseyaḵ? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />naγ lemmi nezraḵ tuḍenneḏ naγ teḥbeseḏ nuseḵd?»<verse eid="MAT 25:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40" />yaxy asenyer lmelek: «lḥeq afenemleγ. madam teggim ayuh y yjen seg yeṯma imeckunen inuh, teggimt y neči.»<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />wembeƹd aymel y lliy af lisaris: «beƹdeṯ fella ayya cyaḍen al timsi n diyma lliy tejra y leblis aḏ ixedemnis. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />afelxaḍert mniyn lluzeγ wiltsečemc. aḏ mniyn ffuḏeγ wiltsswemc. <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />mniyn usiγ d aγrib wiltseseknemc jarewem, aḏ mniyn usiγ d ƹeryan wilteksimc aḏ mniyn usiγ uḍenneγ aḏ ḥbesseγ wiltusimc.»<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />yaxy aserren inuh we amlen: «ayya siydneγ lemmi nezraḵ telluzeḏ naγ teffuḏeḏ naγ d aγrib naγ d ƹeryan naγ tuḍenneḏ naγ teḥbeseḏ aḏ wifnexdimc.»<verse eid="MAT 25:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45" />yaxy asenyer: «lḥeq afenemleγ. madam witeggimc ayuh y yjen seg ayuh imeckunen, witeggimc y neči.» <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />we areḥen inuh al uƹeḏḏeb n diyma, aḏ ṣbiḥen al tmeddurt n diyma.»<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">wuḏeyen smuḏen af tmenγiwt n yesuwƹ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />mniyn ykemmel yesuwƹ ayuh n dwiy lkul, yuwa y tlamḏes: <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />«kennim tessennem lliy beƹd ača d tfeṣka n uƹeddi. aḏ diyes talucen neči lliy yeḏwel d bnaḏem bac atweṣelbeγ.» <verse eid="MAT 26:2" /><verse number="3" style="v" sid="MAT 26:3" />lweqt ḏḏin mleymen imeqqaren n lkuhhan aḏ iwessaren n cceƹb g tzaqqa n qayafa rreys n lkuhhan. <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />aḏ mfehmen bac aṭfen yesuwƹ s lḥileṯ we atenγen. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />uwan: «yexs wintegc ayuh g tfeṣka naγ adekkeren midden g uḏemewenneγ.»<verse eid="MAT 26:5" /></para>
  <para style="s">nγal n ifuḥan af iγef n yesuwƹ</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />mniyn yusi yesuwƹ g beyt ƹenya al simƹan mejdum. <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />tusesd temeṭṭuṯ tqam tebuqqelt n ifuḥan aγlan. tenγelliṯ af ixfis aḏ netta yeḏka itet. <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />yaxy γecceccen tlamḏ fellas uwan: «maγer ayuh n umermeḏ? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />muc xiyr lukan tezenza ayuh n ifuḥan s ggeṯ d iflusen aḏ tucin y lliy d izeweliyen?» <verse eid="MAT 26:9" /><verse number="10" style="v" sid="MAT 26:10" />mniyn yesla yesuwƹ s ayuh n dwiy yuwayasen:</para>
  <para style="p" vid="MAT 26:10">«maγer diyes tetqelqem g ayuh n tmeṭṭuṯ? rahiy teggiḏ ḥaja teṣbiḥt. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />aḏ izeweliyen llan iḏuwem diyma amma neči witγimixc iḏuwem diyma. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />nettaṯ mniyn tenγel ifuḥan af ixfiw, tegga aydin bac altejra y nbal. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />lḥeq afenemleγ: mani abceren s linjiyl g tammurt lkul yexs aḏuflayem af lliy tegga ayuh n tmeṭṭuṯ bac adesmitan midden diyma matta tegga.»<verse eid="MAT 26:13" /></para>
  <para style="s">lexyeneṯ n yehuwḏa</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />lweqt ḏḏin ireḥ yjen seg ṯnac ismis yehuwḏa lesxeryuwṭiyi al imeqqaren n lkuhhan. <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />yuwa: «mennit altucem bac afentiḏuceγ.» yaxy uzennas 30 d lmeḥbub n lfejreṯ. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />aḏ seg lweqt ḏḏin yuḏel yehuwḏa yesugum lemmi ayweta bac asentiḏyuc.<verse eid="MAT 26:16" /></para>
  <para style="s">messi n tfeṣka n uƹeddi yid tlamḏes</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />g as mezwar n ussan n qursetin, reḥḥen tlamḏa al yesuwƹ sestunen: «mani texseḏ afneg messi n tfeṣka n uƹeddi.»<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />yuwayasen: «ƹeddaṯ al tmura, treḥḥem al flan, temmelmas: &lt; lmuƹelemneγ yuwayaḵ: «ssaƹtiw tused aḏ γareḵ taggeγ tfeṣka n uƹeddi neči yid tlamḏew.»&gt; » <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />reḥḥen ggen mammeḵ yuwayasen yesuwƹ. aḏ jren messi n tfeṣka n uƹeddi dinet.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />temeddiṯ yeḏka netta aḏ aydin n ṯnac bac ayeč. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />mniyn wsiyn tetten, yuwa: «lḥeq afenemleγ: yjen siwem talyezenz.»<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />yaxy ḥzennen ggeṯ aḏ yuḏel kul yjen sisen yesestun diyes: «mahu muc d neči, ayya siydneγ.»<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />yaxy yerrasen: «lliy yenqeƹ fusis iḏiy g tḥedduqt d netta lliy talyezenz. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />rahiy neči lliy yeḏwel d bnaḏem taliṣar lliy yetweriyiḏ. lekenti y ḥlilu weddin lliy s fusis talyezenz neči lliy yeḏwel d bnaḏem y ttenyaṯ. lukan widdilulc xiras.»<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />yaxy issestni yehuwḏa lliy tatyezenz: «mahu muc d neči, ayya lmuƹellem.» yerras: «cek tewiḏ amyuh.»<verse eid="MAT 26:25" /></para>
  <para style="s">messi n tfeṣka n uƹeddi</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />mniyn tteten, iqam yesuwƹ tqurset inumriṯ. yerza siyes, yuca y lliy yiḏes. yuwa: «lqeṯ čeṯ ayuh d ysumiw.»<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />wembeƹd iqam lkas. yeḥmeḏ rebbiy. aḏ yucesen. yuwa: «sweṯ siyes lkulkum. <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />ayuh d iḏemniw lliy n lƹehd jdiḏ aḏ lliy tawezzeƹen bac atweγfren ibekkaḍn n ggeṯ d midden. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />lekenti afenemleγ. neči wissesexc beƹd as wuh seg aman n ayuh n tzuriṯ almiy atenseweγ iḏewem d ijdiḏen g lmelekuwt n baba.» <verse eid="MAT 26:29" /><verse number="30" style="v" sid="MAT 26:30" />wembeƹd qesden aḏ ffaγen al jbel n uzemmur.<verse eid="MAT 26:30" /></para>
  <para style="s">yesuwƹ yemmal lliy buṭrus tatyenker</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />lweqt ḏḏin yuwayasen yesuwƹ: «yiḍ wuh tadjem siyi lkulkum mammeḵ yetweri:</para>
  <para style="p" vid="MAT 26:31" />
  <para style="q1" vid="MAT 26:31">&lt;tawetteγ lliy yesefraḏ</para>
  <para style="q1" vid="MAT 26:31">we arulen izmeren n treslit. &gt;<verse eid="MAT 26:31" /></para>
  <para style="p" />
  <para style="p">
    <verse number="32" style="v" sid="MAT 26:32" />lekenti beƹd man kreγ tafensebqeγ al ljeliyl.» <verse eid="MAT 26:32" /><verse number="33" style="v" sid="MAT 26:33" />yaxy yuweyas buṭrus: «neči witedjixc siyeḵ ḥetta lukan adjen siyeḵ midden lkul.» <verse eid="MAT 26:33" /><verse number="34" style="v" sid="MAT 26:34" />yerras yesuwƹ: «lḥeq afemleγ. yiḍ diyn qebbel man ayedden yeziḍ, cek taltnekreḏ 3 merrat.» <verse eid="MAT 26:34" /><verse number="35" style="v" sid="MAT 26:35" />yuwa buṭrus: «ḥetta lukan amuṯeγ iḏeḵ, wifnekrexc xlaṣ.» yaxy uwan tlamḏes lkulhum am idin.<verse eid="MAT 26:35" /></para>
  <para style="s">tẓalliṯ n yesuwƹ g jeṯimani</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />wembeƹd ireḥ yesuwƹ netta yid tlamḏes al ijenni mmelnas jeṯimani. yaxy yuwayasen: «geƹemzeṯ deh jeresd man areḥeγ al γaḍih aẓelleγ.»<verse eid="MAT 26:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 26:37" />aḏ yewya yiḏes buṭrus yid ṭarwa n zebediy aḏ yuḏellas xemmem aḏ leḥzen. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />yaxy yuwa: «neči lḥisis tametteγ s lḥezen. qimeṯ shreṯ iḏiy.»<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />yebƹeḏ fellesen fercu yesjeḏ. yetẓella aḏ yemmal: «ay baba kan witḥireḏ sebƹeḏ fella leƹḏeb n ayuh n lkas, lekenti mammeḵ texseḏ muc mammeḵ xseγ neči.»<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />aḏ yeḏwel al tlamḏes yufin tṭeṣen. yaxy yuwa y buṭrus: «turuh amyuh, witquddemc asehrem iḏiy ḥetta ssaƹeṯ ijeṯ. <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />sehreṯ teẓellem bac wifenyeγlebc cciyḍan. texsem lxiyr amma witetquddumc aṭfem imanuwem af ccer.»<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />aḏ ireḥ yeẓẓal tijekkelt iḍen. yuwa: «ay baba kan lazem asweγ ayuh n lkas, adj ayṣar lliy texseḏ.»<verse eid="MAT 26:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43" />iƹaweḏ yeḏwel al tlamḏes yufin ṭṭesen zada afelxaḍert yeγlebin iḍeṣ. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />yedjin, yeḏwel yetẓella tijekkelt ti 3 aḏ yetƹaweḏ g dwiy lliy yuwat.<verse eid="MAT 26:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45" />wembeƹd yeḏwel al tlamḏes yuwa: «ṭseṯ ṭuruh aḏ reyḥeṯ. tused ssaƹtiw aḏ qa talzenzen neči lliy yeḏwel d bnaḏem y weribekkaḍen. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />kkreṯ anreḥ. qa yused lliy talyezenz y nihnin.»<verse eid="MAT 26:46" /></para>
  <para style="s">iṭṭaf n yesuwƹ</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />mniyn netta ydugga, yehuwḏa lliy netta d yjen seg ṯnac yexleḍed aḏ yiḏes ggeṯ d midden γarsen lesyuf aḏ igeḍman, nkiyyenten imeqqaren n lkuhhan aḏ iwessaren n midden. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />yusi lliy tasentiḏyezenz yucesen lemereṯ. yuwayasen: «lliy tatbeḥbiγ, d netta, ṭfet.»<verse eid="MAT 26:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 26:49" />yeqreb al yesuwƹ ƹlewleh, yuwa: «fislamtiḵ ay yelmuƹellem.» aḏ ibeḥbayi.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />yaxy yuwayas yesuwƹ: «ayya ṣṣeḥbiw y ma tusid.» yaxy qrebben midden tṭefen yesuwƹ. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />yaxy yjen seg indin lliy wsiyn yid yesuwƹ, yezzel fusis, yenzeγ ssiyfis, iwet xdim n rreys n lkuhhan yeqdeƹas temezuγtis.<verse eid="MAT 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52" />yuwayas yesuwƹ: «arr ssiyfiḵ al umkanis. lliy yetcerreƹ g ccif tayemunγ siyes. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />naγ teḥsabeḏ neči witqudduxc aḍelbeγ baba bac alyenkiy iṭer n ṯnac d lejyuc seg lmleyka? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />lekenti mammeḵ tayentem lliy yetweri g lkitab. lliy tzarrem diyes ṭuruh lazem ayṣar.»<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />wembeƹd yuflay yesuwƹ y midden yuwa: «amellaḵ taṭfem ssareq, teffaγem s lesyuf aḏ igeḍman bac alteṭfem. ussan diyn lkul usiγ jarewem sseḥfaḍeγ g lheykel aḏ wilteṭifemc. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />laken iṣar ayuh bac ayentem lliy uriyent lenbiya.»</para>
  <para style="p" vid="MAT 26:56">lweqt ḏḏin rwellen tlamḏes lkulhum djent.<verse eid="MAT 26:56" /></para>
  <para style="s">lmuḥekmeṯ zzaṯ imeqqaren n wuḏeyen</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />lliy ṭṭefen yesuwƹ awyent al qayafa rreys n lkuhhan lliy mleymen γares iwessaren aḏ lliy seḥfeḍen g cceriyƹeṯ. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />aḏ yeḏbeƹi buṭrus al tzaqqa n rreys n lkuhhan s yebƹeḏ. wembeƹd yuḏef al jaj, ygeƹmez jar lliy tƹussun bac ayḥekker man ayṣar. <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />imeqqaren n lkuhhan aḏ iwessaren lkulhum ḥderren g lmejles ruzzun af mam ayecheḏ s lbaṭel af yesuwƹ bac aḥekmen fellas s tmettant. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />lekenti jar indin lliy usend acehden s lbaṭel wiḏufinc mam ayecheḏ mammeḵ xsen. aḏ g laxer qrebben sen sisen. <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />uwan: «wuhnit yuwa: &lt; neči tqudduγ ahedmeγ lheykel n rebbiy we atebniγ g 3 d ussanaṯ. &gt; »<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />yaxy yebbed rreys n lkuhhan ysesetn yesuwƹ: «man mleḏ g ayuh n dwiy.» <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />lekenti yesuwƹ isusem. yaxy rreys n lkuhhan ysesetni: «afjehiγ s rebbiy lliy yedder mleneγ: cek d lmesiyḥ memmis n rebbiy naγ aha?»<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />yerras yesuwƹ: «ayuh ṣḥiḥ. amma afenemleγ zada,</para>
  <para style="q1" vid="MAT 26:64">s ṭuruh taltezrem neči lliy yeḏwel d bnaḏem</para>
  <para style="q1" vid="MAT 26:64">af limin n rebbiy bab n lqudreṯ.</para>
  <para style="q1" vid="MAT 26:64">taltezrem tteseγd af sḥab n ujenna.»<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />yaxy yeskeṣ rreys n lkuhhan leḥweyjis yuwa: «yeṯƹedda af rebbiy. muc lazem lechuḏ. aḏ qa kennim teslim mammeḵ yeṯƹedda af rebbiy. <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />matta lquluwem.» uwan: «yestahel temettent.» <verse eid="MAT 26:66" /><verse number="67" style="v" sid="MAT 26:67" />yaxy skufsen af uḏmis. wettent aḏ lbeƹḍ n midden selfeqnas. <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />aḏ nihnin mmalen: «tagzaneγ ayya lmesiyḥ; mam iwettaḵ.»<verse eid="MAT 26:68" /></para>
  <para style="s">yenker buṭrus temesniwt n yesuwƹ</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />lweqt ḏḏin yusi buṭrus ygeƹmez g tesqift. yaxy tusesd texdimt tuwa: «ḥetta cek tusid yid yesuwƹ lliy seg ljeliyl.» <verse eid="MAT 26:69" /><verse number="70" style="v" sid="MAT 26:70" />yaxy yenker buṭrus zzaṯ midden yuwa: «wisinnexc af matta teddugiḏ.» <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />wembeƹd yeffeγ al imi n lḥuc. tezri texdimt iḍen. tuwa y midden lliy tmas: «ḥetta wuh yusi yid yesuwƹ lliy seg nnaṣira.» <verse eid="MAT 26:71" /><verse number="72" style="v" sid="MAT 26:72" />yaxy yenker buṭrus tijekkelt iḍen, yedjul: «aydin n argaz witsineγ.» <verse eid="MAT 26:72" /><verse number="73" style="v" sid="MAT 26:73" />wembeƹd reḥḥen lliy bbedden diyn al buṭrus uwanas: «rahiy cek nembelḥeq d yjen sisen. nesenaḵ seg leγutiḵ.» <verse eid="MAT 26:73" /><verse number="74" style="v" sid="MAT 26:74" />yuḏel buṭrus ileƹen. yedjella, yemmal: «neči witsineγ.» yaxy ƹlewleh yedden yaziḍ. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />aḏ yesmited buṭrus tufleyt n yesuwƹ lliy yuwa: «qebbel man ayedden yeziḍ taltnekreḏ 3 merrat.» yaxy yeffeγ al barra iƹeyyeḍ ƹeyyeḍ s tnixsist.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">sellem n yesuwƹ al biylaṭus</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />tajji bekri mleymen tijekkelt iḍen imeqqaren n lkuhhan aḏ iwessaren n midden. aḏ mfehmen bac anγen yesuwƹ. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />wembeƹd qqenent. aḏ awyent ucent y biylaṭus lwali lliy teggiy ruwma.<verse eid="MAT 27:2" /></para>
  <para style="s">yehuwḏa yenγa imanis</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />mniyn yezra yehuwḏa lliy yezenzesentiḏ mammeḵ ḥkemmen fellas, yendem aḏ yerra aydin n 30 n imeḥbuben n lfejreṯ y imeqqaren n lkuhhan aḏ iwessaren. <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />aḏ yuwa: «aγleḍeγ zenezγawem iḏemmen n yjen xaṭih.» yaxy rennas: «neccin ayuh wiγenyethemc. ayuh d lmuckeltiḵ cek.» <verse eid="MAT 27:4" /><verse number="5" style="v" sid="MAT 27:5" />yaxy yluweḥ aydin n imeḥbuben n lfejreṯ g lheykel. ireḥ yexneq imanis. <verse eid="MAT 27:5" /><verse number="6" style="v" sid="MAT 27:6" />qamen imeqqaren n lkuhhan aydin n imeḥbuben n lfejreṯ. uwan: «ayuh n iflusen d ssum n iḏemmen. ḥram ateneg g ṣṣenduq n lheykel.» <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />aḏ beƹd mag cawren beƹḍhum, sγen mezdeγ n lliy ixeddem g lfuxar bac aydel d ljebbeneṯ y iγriben. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />aḏ afelxaḍert n ayuh wecci mezdeγ diyn al ṭuruh mmelnas mezdeγ n iḏemmen. <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />amyuh yentem lliy yuwa nnabiy irmiya seg lemmi:</para>
  <para style="q2" vid="MAT 27:9">«awyen aydin n 30 n imeḥbuben n lfejreṯ</para>
  <para style="q2" vid="MAT 27:9">lliy ucent aṯ israyil d ssumis<verse eid="MAT 27:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 27:10" />sγen sisen mezdeγ n lliy ixeddem g lfuxar</para>
  <para style="q2" vid="MAT 27:10">mammeḵ yuwayiḏ rebbiy.»<verse eid="MAT 27:10" /></para>
  <para style="s">biylaṭus yesestun g yesuwƹ</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />aḏ yebbed yesuwƹ zzaṯ lwali biylaṭus. ysesetni lwali: «yenda cek d lmelek n wuḏeyen.» yerras: «cekkin tewiḏ ayuh amma much mammeḵ teḥsebeḏ.» <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />aḏ wsiyn imeqqaren n lkuhhan aḏ iwessaren n midden tehmen diyes aḏ netta isusem witerric fellasen. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />yaxy yuwayas biylaṭus: «yenda witsellec mag mmelen diyeḵ.» <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />lekenti yesuwƹ wisyerri ḥetta d tuflayt. yaxy ifeh lwali nyeƹdel.<verse eid="MAT 27:14" /></para>
  <para style="s">lḥukem af yesuwƹ s tmettent</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />aḏ yusi lwali yelmeḏ yetsiyeb kul tfeṣka yjen seg imeḥbas lliy texterent midden. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />aḏ yusi lweqt ḏḏin diyes yjen yeḥbes ismis barebbes senent lkulhum. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />mniyn mleymen yuwayasen biylaṭus: «mam texsem afensiybeγ; barebbes naγ yesuwƹ lliy mmalnas lmesiyḥ.» <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />aḏ netta yessen lliy nihnin uγenestiḏ afelxaḍert ḥseḏent.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />mniyn yusi ygeƹmez af lkursi n ḥukem tenkiyas lehlis temmal: «arr lbaliḵ ggeḏ ḥaja y weddin lliy xaṭih. ugeḏḏeγ as wuh ggeṯ afelxaḍert xertleγ siyes.»<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />lekenti imeqqaren n lkuhhan aḏ iwessaren uwan y midden asemlen aysiyeb barebbes we ayenγ yesuwƹ. <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />iƹeweḏ ysesetnin biylaṭus: «mentan sisen texsem afensiybeγ.»</para>
  <para style="p" vid="MAT 27:21">yaxy rennas: «barebbes.»<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />yerniy ysesetnin: «mala man aggeγ y yesuwƹ lliy mmalnas lmesiyḥ.»</para>
  <para style="p" vid="MAT 27:22">rennas lkulhum: «ṣelbi.»<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />yaxy ysesten: «matta yeggi wiyeḥli.»</para>
  <para style="p" vid="MAT 27:23">rnin ṣeyḥen: «ṣelbi.»<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />mniyn yufa lliy widdic lfeydeṯ aḏ ḥaḍerbac midden tadekren g uḏmis. yuγed aman aḏ isireḏ ifesnis zzaṯsen lkul. aḏ yuwa: «iḏemmen n ayuh n argaz muc g teḵrumtiw. ggeṯ lliy texsem.»<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />rennas midden lkul: «iḏemnis g itḵerminneγ neccin aḏ tḵermin n ṭarweneγ.» <verse eid="MAT 27:25" /><verse number="26" style="v" sid="MAT 27:26" />yaxy yseybasen barebbes. amma yesuwƹ iwettiy s ṣṣut wembeƹd yucesentiḏ bac atṣelben.<verse eid="MAT 27:26" /></para>
  <para style="s">iƹessekriyyen teṯhzan s yesuwƹ</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />yaxy kerkren iƹessekriyyen n lwali yesuwƹ al tzaqqa n lḥkumeṯ aḏ mleymen fellas iƹessekriyyen n lfirqeṯ lkulhum. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />yaxy kkesnas lḥweyjis aḏ ireḍnas rdi d zuggaγ. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />aḏ ḏran ṭṭuq seg ysennanen ggent af ixfis aḏ ggenas teqeṣbeyt g fusis n limin aḏ rkeƹen zzaṯis teṯhezzan fellas ammalen: «sselam ayya lmelek n wuḏeyen.» <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />aḏ skufsen fellas. aḏ kkesnas teqeṣbayt wettent siyes af ixfis. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />aḏ beƹd mag ƹeddan fellas lgustu, kkesnas rdi. ireḍnas leḥweyjis aḏ awyent bac atṣeliben.<verse eid="MAT 27:31" /></para>
  <para style="s">yesuwƹ af ṣṣelib</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />mniyn nihnin tkerkren diyes, ufen argaz seg lqirineya ismis simƹan zheren fellas bac ayqam ṣṣelib.<verse eid="MAT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 27:33" />weqt lliy uṣellen al umkan ismis ljuljuṯa, lmeƹnas mkan n ixsan n iγef. <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />ucen y yesuwƹ crab yizay bac aysu. iḏewqi lekinti wiyeqqil atisu.<verse eid="MAT 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35" />yaxy ṣlebbent aḏ ggen lqurƹeṯ af lḥweyjis. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />aḏ geƹemzen dinet tƹussun fellas. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />aḏ ggen nnaj ixfis af ṣleb lblakeṯ. turi fellas lƹemeltis: «ayuh d yesuwƹ lmelek n wuḏeyen.» <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />aḏ ṣlebben yiḏes sen n iquṭƹiyen. yjen af limin yjen af lisar.<verse eid="MAT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39" />aḏ wsiyn lliy tƹeddan deƹƹun diyes aḏ ṣunuḍen g ixfewnesen. <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />aḏ mmalen: «ayya lliy tayehdem lheykel we atyebna g 3 d ussanaṯ semneƹ imaniḵ, kan cek d memmis n rebbiy. zwa s nnaj ṣṣelib.»<verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />aḏ ṯmesxren fellas zada imeqqaren n lkuhhan aḏ lliy seḥfeḍen g cceriyƹeṯ aḏ iwessaren. uwan: <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />«ysemneƹ ttenyaṯ amma wiyetqudduc aysemneƹ imanis. yaxy netta d lmelek n israyil? mmaltas ayezwa ṭuruh s nnaj ṣṣelib bac anamen siyes. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />yeṯwekkel af rebbiy aḏ yuwa: &lt; neči d memmis n rebbiy. &gt; adj atisemneƹ mala kan yexsi.» <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />aḏ wsiyn iquṭƹiyen lliy tweṣelben yiḏes mmalnas am ayuh n dwiy.<verse eid="MAT 27:44" /></para>
  <para style="s">yesuwƹ yesufuγ g rruwḥ</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />aḏ seg zguwas al madi sleṯa tezwad tellest af tammurt lkulha. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />yid leqrabeṯ n maḍi 3 izewek yesuwƹ zewek d meqqar: «liy, liy lima cebeqteni.» yeƹni: «ay rebbiy ay rebbiy maγer tedjiḏ siyi?»<verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />mniyn slennas lbeƹḍ n lliy bbedden diyn uwan: «yesγuyu af liyya.» <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />yaxy yuzzel yjen sisen iqam tenecceft yseγemsiṯ g lxel. yeggiṯ af teqeṣbayt yezlasted bac aysu.<verse eid="MAT 27:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 27:49" />lekenti ttenyaṯ uwanas: «dji weḥdes. adj anḥekker zeƹma tadyas liyya bac atisemneƹ.» <verse eid="MAT 27:49" /><verse number="50" style="v" sid="MAT 27:50" />yaxy izewek yesuwƹ tijekkelt iḍen zewek d meqqar aḏ yseffeγ rruwḥ.<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />lweqt dyin yekkeṣ star n lheykel af sen s nnaj al dday. aḏ terjij tammurt, aḏ miren iḍγaγen. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />leqbur miren aḏ ggeṯ d lmumnin lliy wsiyn ṭṭesen kkeren sisen. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />mniyn ffaγend seg leqbur, uḏeffen al tmura temeqdust beƹd mag yekker yesuwƹ. aḏ ggeṯ d midden zrenten.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />amma lqayed n 100 aḏ iƹssekrinis lliy wsiyn tƹussun af yesuwƹ ugeḏḏen ggeṯ mniyn zren tammurt teterjij aḏ mag iṣar. yaxy uwan: «wuh nembelḥeq d memmis n rebbiy.»<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />aḏ ggeṯ d tiseḏnan lliy usineṯ ḏebeƹneṯ g yesuwƹ seg ljeliyl bac atexdemneṯ. tḥekerneṯ af yebƹeḏ matta yetṣar. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />aḏ jaresneṯ meryem lliy seg lmejdel aḏ meryem yedj n yeƹquwb aḏ yuwsef aḏ yedj n ṭarwa n zebediy.<verse eid="MAT 27:56" /></para>
  <para style="s">nbal n yesuwƹ</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />temeddiṯ, yused argaz d murkenti seg lḥumeṯ n rrama ismis yuwsef yusi seg tlamḏa n yesuwƹ. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />ireḥ al biylaṭus yeḍleb lfriseṯ n yesuwƹ. yaxy yuwayasen biylaṭus: «uctestiḏ.» <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />yaxy yewya yuwsef lfriseṯ ikkefniṯ s lkettan ṣbiḥ. <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />aḏ yeggi g lqebris jdiḏ lliy yeγezzi g iḍγaγen. aḏ ikerkeb aḍγaγ d meqqar yeqqes siyes imi n leqber ireḥ af imanis.<verse eid="MAT 27:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="MAT 27:61" />aḏ usineṯ dinet meryem lliy seg mejdel aḏ meryem ttani geƹmezneṯ g leqbeleṯ n leqber.<verse eid="MAT 27:61" /></para>
  <para style="s">ƹussu af leqber</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />al ača as n sebbeṯ, reḥḥen imeqqaren n lkuhhan aḏ iferysiyyen jmiyƹ al biylaṭus. <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />uwanas: «ayya lmelek nesmitad lliy wuddin lliy yetḍeyyeƹ g midden yuwa mniyn yusi yedder: &lt; neči beƹd 3 d ussanaṯ takreγ. &gt; <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />mlasen aƹussen af leqber nyeƹdel al as wi 3 bac wittisenc tlamḏes atserqen we amlen y midden: &lt; yekker seg jar lliy mmuṯen. &gt; we aydel ḍeyyeƹ lexrani iṭer n umezwar.»<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />yaxy yerrasen biylaṭus: «γarwem iƹessasen. berreṯ tƹussem mammeḵ texsem.» <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />reḥḥen qeṣen leqber nyeƹdel. aḏ melsen aḍγaγ aḏ ggen iƹessasen.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">yesuwƹ yekker seg jar lliy mmuṯen</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />aḏ g as mezwar n ljumƹa beƹd as n sebbeṯ, treḥ meryem lliy seg lmejdel yid meryem ttani bac aḥekkerneṯ leqber. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />yaxy terjij tammurt nyeƹdel afelxaḍert yezwad lmleyka n rebbiy seg ujenna. yused, ikerkeb aḍγaγ aḏ ygeƹmez fellas. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />yusi aydin n lmleyka yetwelƹej am lberq aḏ leḥweyjis d imellalen am ṯṯelj. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />mniyn zrent indin lliy tƹussun af leqber udan af tammurt amellaḵ mmuṯen.<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />yaxy iṭemmen lmleyka aydin sen tseḏnan, yuwa: «witegeḏmec. neči sseneγ lliy kennimeṯ truzumeṯ af yesuwƹ lliy yetweṣleb. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />netta wiyelli deh. yekker. semted ḥekermeṯ mkan lliy yusi diyes. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />ureḥmeṯ fiseƹ mmelmeṯ y tlamḏes; yekker seg jar lliy mmuṯen. aḏ qa netta tafenyesbeq al ljeliyl. dinet tatezrem. qa neči uwiγaḵmeṯ.»<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />yaxy reḥneṯ aydin sen tseḏnan fiseƹ seg mkan n leqber aḏ nihintin ugeḏneṯ aḏ freḥneṯ ggeṯ. aḏ uzzelneṯ al tlamḏes bac abeccerneṯ. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />qa yeḍheresneṯ yesuwƹ. yuwa: «fislamtiḵmeṯ.» yaxy reḥḥentas aḏ ṭṭefneṯ g idernis aḏ sjeḏentas. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />yaxy yuweyesneṯ yesuwƹ: «witegeḏmec. ureḥmeṯ mmelmeṯ y yeṯma alleqqan g ljeliyl. aḏ dinet talezren.»<verse eid="MAT 28:10" /></para>
  <para style="s">tikerkas n wuḏeyen</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />mniyn usineṯ tiseḏnan ggurneṯ g ubriḏ, reḥḥen lbeƹḍ n lliy tƹussun al tmura uwan y imeqqaren n lkuhhan af mag iṣar. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />yaxy mleymen imeqqaren n lkuhhan aḏ iwessaren bac amcewren af ayuh lliy iṣar. aḏ ucen ggeṯ d iflusen y aydin n iƹessesen. <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />aḏ uwanasen: «mleṯ y midden: &lt; tlamḏes usend sreqqent mniyn yeγlebaneγ iḍeṣ. &gt; <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />aḏ kan yuṣel lexbar al lwali andefaƹ fellawem bac wifenyetṣar ḥaja.» <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />yaxy lqan iflusen. aḏ ggen mammeḵ uwanasen imeqqaren n lkuhhan aḏ iwessaren. aḏ ayuh n dwiy yeqqim jar wuḏeyen al as wuh.<verse eid="MAT 28:15" /></para>
  <para style="s">lmesiyḥ yeḍherred y tlamḏes</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />amma aydin n tlamḏa lliy wsiyn ḥdac reḥḥen al ljeliyl, al jbel lliy isiḵnesentiḏ yesuwƹ. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />mniyn zrent sjeḏnas. lekenti lbeƹḍesen cukken. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />yaxy yeqreb yesuwƹ yufleyasen yuwa:</para>
  <para style="p" vid="MAT 28:18">«yuciḏ rebbiy ssulṭaṯ af ujenna aḏ tammurt lkul. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />ureḥeṯ mala seƹezmeṯ midden lliy g tammurt lkul aḏ zizdiytasen s ysem n baba rebbiy aḏ memmis aḏ rruwḥ lqudus. <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />aḏ seḥfeḍtasen bac aggen s lliy weṣṣiγawem. qa neči tadleγ iḏuwem diyma almiy atkemmel ddunyeṯ.»<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>