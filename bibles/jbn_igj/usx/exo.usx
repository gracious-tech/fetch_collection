<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EXO" style="id" />
  <para style="h">Exod</para>
  <para style="toc1">iffeγ n aṯ israyil seg miṣr</para>
  <para style="toc2">Exod</para>
  <para style="toc3">EXO</para>
  <para style="mt1">iffeγ n aṯ israyil seg miṣr</para>
  <chapter number="1" style="c" sid="EXO 1" />
  <para style="s">imiṣriyen merjen g aṯ israyil</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 1:1" />ṭarwa n yeƹquwb lliy mmalnas zada aṯ israyil, usend yiḏes s nesnesen al miṣr. <verse eid="EXO 1:1" /><verse number="2" style="v" sid="EXO 1:2" />nihnin d rewbiyn aḏ cemƹuwn aḏ lawiy aḏ yehuwḏa. <verse eid="EXO 1:2" /><verse number="3" style="v" sid="EXO 1:3" />aḏ yesaker aḏ zebuwluwn aḏ benyamin. <verse eid="EXO 1:3" /><verse number="4" style="v" sid="EXO 1:4" />aḏ dan aḏ neftaliy aḏ jaḏ aḏ uciyr. <verse eid="EXO 1:4" /><verse number="5" style="v" sid="EXO 1:5" />aḏ s yuwsef lliy yedder g miṣr, ṭarwa n yeƹquwb aḏ ṭarwesen lkul wsiyn 70.<verse eid="EXO 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 1:6" />wembeƹd yemmuṯ yuwsef aḏ yeṯmas aḏ iqrinnis lkul. <verse eid="EXO 1:6" /><verse number="7" style="v" sid="EXO 1:7" />aḏ rnin aṯ israyil. irewen ggeṯ aḏ yeḏwel leƹdedesen d meqqar ggeṯ lmi tečur sisen tammurt.<verse eid="EXO 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 1:8" />beƹd isuggesen, yeḥkem lmelek d jdiḏ g miṣr. wiyiwiḍc af yuwsef. <verse eid="EXO 1:8" /><verse number="9" style="v" sid="EXO 1:9" />yuwa y midden lliy nneḍḍen siyes:</para>
  <para style="p" vid="EXO 1:9">«qa aṯ israyil ggeṯ aḏ qwenneγ. <verse eid="EXO 1:9" /><verse number="10" style="v" sid="EXO 1:10" />yexs anḥekker mammeḵ asenneg bac wirenninc aḏ wittisenc yid leƹdanneγ almiy iṣar nuγu, naγ aγenḥerben we arulen seg tammurtenneγ.»<verse eid="EXO 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 1:11" />yaxy ggenten adug ṭiṭewin n lliy ssexdemen midden bac atensexdmen b siyf g lxeḏmeṯ lliy tuƹer. aḏ bnan sen tmurewin; fiyṯuwm aḏ reƹmesis bac adelneṯ d lemxazen y ferƹuwn. <verse eid="EXO 1:11" /><verse number="12" style="v" sid="EXO 1:12" />lekenti kul man rnin asenmerjen tesensen rnin akeṯren almiy ḏwellen imiṣriyen ttegeḏen sisen. <verse eid="EXO 1:12" /><verse number="13" style="v" sid="EXO 1:13" />aḏ rnin g mrejesen iṭer s lxeḏmeṯ lliy tuƹer man γiyr man asexfen fellasen. <verse eid="EXO 1:13" /><verse number="14" style="v" sid="EXO 1:14" />aḏ teḏwel temeddurt n aṯ israyil tseḥḥeq lufaḏ s lxeḏmeṯ temeqqart lliy yexs atetteggen; am rway n teγuri aḏ igga n ṭṭuwb aḏ knes g lxeḏmeṯ n imezdeγen lkul. aḏ sexdementen imiṣriyen man γiyr man asexfen fellasen g ayuh n lxeḏmeṯ lliy tuƹer lkul.<verse eid="EXO 1:14" /></para>
  <para style="s">temenγiwt n imeckenen</para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 1:15" />wembeƹd yesγuy lmelk n miṣr y sen tƹebraniyin; cifra aḏ fuwƹa lliy usineṯ serewneṯ g tseḏnan aḏ yuweyesneṯ: <verse eid="EXO 1:15" /><verse number="16" style="v" sid="EXO 1:16" />«ḥekermeṯ almiy diyes ijeṯ tatiru, kan jjar d afrux neγmet, amma kan d tefruxt dejmetteṯ atedder.»<verse eid="EXO 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 1:17" />lekenti aydin n sen tseḏnan lliy serewneṯ usineṯ tegeḏneṯ seg rebbiy aḏ wigginec s dwiy n lmelek. aḏ djenneṯ imeckenen dderen. <verse eid="EXO 1:17" /><verse number="18" style="v" sid="EXO 1:18" />yaxy yesγuyesneṯ lmelek ysesetnineṯ: «maγer teggimeṯ ayuh aḏ tedjimeṯ imeckenen dderen?»<verse eid="EXO 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 1:19" />rentas: «afelxaḍert tiƹebraniyin resneṯ yezhel muc am timiṣriyin. rahiy tṭeruneṯ qebbel man aneṣel al γaresneṯ.» <verse eid="EXO 1:19" /><verse number="20" style="v" sid="EXO 1:20" />aḏ yerniy leƹded n israyiliyen. aḏ yeḏwel d meqqar ggeṯ. yaxy ynumer rebbiy ayuh n sen tseḏnan, <verse eid="EXO 1:20" /><verse number="21" style="v" sid="EXO 1:21" />yucesneṯ mam aƹemmeren tizegwinesneṯ afelxaḍert ugeḏneṯ siyes.<verse eid="EXO 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 1:22" />wembeƹd yuwa ferƹuwn y midden lkul: «lewḥeṯ g lwaḏ n niyl kul afrux d ƹebreni yluled. amma timeckunin adj dderneṯ.»<verse eid="EXO 1:22" /></para>
  <chapter eid="EXO 1" />
  <chapter number="2" style="c" sid="EXO 2" />
  <para style="s">tleliṯ n muwsa</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 2:1" />yenjef yjen seg ifrex n leƹcireṯ n lawiy ijeṯ seg tifrexis. <verse eid="EXO 2:1" /><verse number="2" style="v" sid="EXO 2:2" />yaxy tqam rra tuγed afrux. mniyn tufi yezƹem teḥrezzi 3 chuwr. <verse eid="EXO 2:2" /><verse number="3" style="v" sid="EXO 2:3" />mniyn maƹadc tetquddu ateḥrez tegga lgruz ƹriḍ seg tqeṣbeyin n lberdi teḏhenni s lguṭran aḏ tessuṣ diyes afrux teggiy g amas n tqeṣbayin af lḥacit n lwaḏ. <verse eid="EXO 2:3" /><verse number="4" style="v" sid="EXO 2:4" />aḏ tebbed weltmas s yebƹeḏ tetḥekkar man asyeṭra.<verse eid="EXO 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 2:5" />mniyn tused yellis n ferƹuwn bac atƹewem g lwaḏ, aḏ tiqrinnis ggurneṯ af lḥacitis, tezra aydin n lgruz jar tiqeṣbeyin. yaxy tenki tečiwtis bac atiḏeγ. <verse eid="EXO 2:5" /><verse number="6" style="v" sid="EXO 2:6" />tmir lgruz yeffeγed diyes meckun aḏ netta d afrux yetƹeyyeḍ. yaxy ysexfas tuwa: «ayuh d yjen seg ifrex n iƹebraniyen.»<verse eid="EXO 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 2:7" />yaxy tused weltmas n ufrux, tuwa y yellis n ferƹuwn: «areḥeγ amesγuyeγ y tmeṭṭuṯ teƹebrenit bac atsessef.» <verse eid="EXO 2:7" /><verse number="8" style="v" sid="EXO 2:8" />terras yellis n ferƹuwn: «barra.» treḥ tesγuy y yedj n ufrux. <verse eid="EXO 2:8" /><verse number="9" style="v" sid="EXO 2:9" />tuweyas yellis n ferƹuwn: «xxen ayuh n afrux. sesfitiḏ we amxelṣex.» telqa temeṭṭuṯ afrux tesessaf diyes. <verse eid="EXO 2:9" /><verse number="10" style="v" sid="EXO 2:10" />mniyn yemγer teri y yellis n ferƹuwn. testebnayi aḏ tsemmeyi d muwsa, tuwa: «sefγeγt seg aman.»<verse eid="EXO 2:10" /></para>
  <para style="s">rwel n muwsa</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 2:11" />beƹd mag yemγer muwsa ireḥ ijuwas bac ayḥekker yeṯmas iƹebraniyen we ayzer mag tƹanen. yaxy yezra argaz d miṣri yečaṯ g yjen d ƹebreni. <verse eid="EXO 2:11" /><verse number="12" style="v" sid="EXO 2:12" />yesmuqel muwsa al deh aḏ al deh, mniyn wiyufi ḥed yenγa aydin n umiṣri aḏ yenbelliy adug ijdi. <verse eid="EXO 2:12" /><verse number="13" style="v" sid="EXO 2:13" />al ača yeffeγ aḏ yufa sen d iƹebraniyen tnuγun. yaxy yuwa y lliy d ḍḍelem: «ima tečeṯeṯ g memmis n ƹemmiḵ.» <verse eid="EXO 2:13" /><verse number="14" style="v" sid="EXO 2:14" />yerras: «mam yeggaḵ d rreys bac aḥekmeḏ jarenneγ? yaxy tesmuḏeḏ taltenγeḏ ḥetta neči mammeḵ tenγiḏ miṣri.» yugeḏ muwsa aḏ yuwa y imanis: «rahiy lexbar yeffeγed.» <verse eid="EXO 2:14" /><verse number="15" style="v" sid="EXO 2:15" />yesla ferƹuwn, yesmuḏ tayenγ muwsa, lekenti muwsa yerwel. aḏ ireḥ al tammurt n midyan. mniyn yuṣel ygeƹmez tman anu.<verse eid="EXO 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 2:16" />aḏ yusi diyes yjen d lkahen n midyan γares 7 n temickanin usented bac ačarneṯ aman we aƹebbeneṯ ifedjeyen bac asesuneṯ tulli n babesneṯ. <verse eid="EXO 2:16" /><verse number="17" style="v" sid="EXO 2:17" />yaxy usend lbeƹḍ seg indin lliy sefreḏen zeƹezqentent, lekenti muwsa yseswesneṯ tulinesneṯ. <verse eid="EXO 2:17" /><verse number="18" style="v" sid="EXO 2:18" />mniyn ḏwelneṯ timeckunin al babesneṯ lliy ismis reƹuyil, ysesetnineṯ: «mammeḵ terimted bekri as wuh.» <verse eid="EXO 2:18" /><verse number="19" style="v" sid="EXO 2:19" />uwantas: «rahiy argaz d miṣri ysemenƹaneγ seg lliy sefreḏen aḏ yečurenneγ aman aḏ ysessu tullineγ zada.» <verse eid="EXO 2:19" /><verse number="20" style="v" sid="EXO 2:20" />yaxy yuweyesneṯ: «mani yella? maγer tedjimet diyn? ureḥmeṯ sγuyemtas bac ayeč.» <verse eid="EXO 2:20" /><verse number="21" style="v" sid="EXO 2:21" />afelxaḍert freḥen siyes ggeṯ, yerla muwsa bac ayesken yid ayuh n argaz. wembeƹd yucas yellis ṣefuwra. <verse eid="EXO 2:21" /><verse number="22" style="v" sid="EXO 2:22" />yaxy tuγesd afrux ysemmeyi jercuwm, afelxaḍert yuwa: «usiγ d aγrib g tammurt muc d tammurtiw.»<verse eid="EXO 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 2:23" />aḏ beƹd isuggesen d iziraren yemmuṯ lmelk n miṣr. aḏ qqimen aṯ israyil tkuttun seg lxeḏmeṯ lliy tuƹer aḏ tzawken. yaxy yesla rebbiy zwikesen. <verse eid="EXO 2:23" /><verse number="24" style="v" sid="EXO 2:24" />yeslesen rebbiy aḏ wiyettuc lƹehdis y ibrahiym aḏ isḥaq aḏ yeƹquwb. <verse eid="EXO 2:24" /><verse number="25" style="v" sid="EXO 2:25" />aḏ yesmuqel al aṯ israyil sexefnas.<verse eid="EXO 2:25" /></para>
  <chapter eid="EXO 2" />
  <chapter number="3" style="c" sid="EXO 3" />
  <para style="s">rebbiy yeḍherred y muwsa</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 3:1" />yusi muwsa yesefraḏ s tulli n nsibis yeṯruwn lkahen n midyan. ijuwas yures tullis al ṭṭerf n ṣṣeḥreṯ almiy yuṣel al ḥuwrib lliy d jbel n rebbiy. <verse eid="EXO 3:1" /><verse number="2" style="v" sid="EXO 3:2" />aḏ dinet g uleblub n timsi g amas n teceƹƹelt yeḍherresd lemleyka n lliy diyma yella. yesmuqel muwsa yufa teceƹƹelt teseγa man γiyr man ateḥreq. <verse eid="EXO 3:2" /><verse number="3" style="v" sid="EXO 3:3" />yuwa g ulis: «maγer zƹema witḥereqc ayuh n tceƹƹelt? tareḥeγ aḥekreγ ayuh n leγribeṯ.»<verse eid="EXO 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 3:4" />mniyn yezra lliy diyma yella muwsa yeqrebbed, yesγuyas lliy diyma yella seg amas n teceƹelt: «muwsa, muwsa.» yerras: «yinƹem.»<verse eid="EXO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 3:5" />yuwayas: «witicefc al dehnit. kkes lbeleγt. mkan lliy tebbedded diyes d tammurt temeqdust.» <verse eid="EXO 3:5" /><verse number="6" style="v" sid="EXO 3:6" />yaxy yuwayas: «neči d rebbiy n ibabniḵ, rebbiy n ibrahiym aḏ rebbiy n isḥaq aḏ rebbiy n yeƹquwb.» lweqt ḏḏin yeḥrez muwsa uḏmis afelxaḍert yugeḏ ayesmuqel al rebbiy.<verse eid="EXO 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 3:7" />yuwayas lliy diyma yella:</para>
  <para style="p" vid="EXO 3:7">«rahiy neči zriγ ḏḏul n middeniw g miṣr aḏ sliyγ zwiksen afelxaḍert lliy ssexdemen disen d iweƹƹeren aḏ senneγ s leƹḏebesen. <verse eid="EXO 3:7" /><verse number="8" style="v" sid="EXO 3:8" />aḏ zwiγd bac atensemenƹeγ seg ifesn n imiṣriyen.</para>
  <para style="p" vid="EXO 3:8">we atensefγeγ seg aydin n tammurt al tammurt teṣbiḥt aḏ tuseƹ aḏ tečur d aγi aḏ tamemt, mani dderen ikenƹaniyen aḏ lḥeyṯiyin aḏ lemuwriyin aḏ lferiziyin aḏ lḥwiyin aḏ lyebuwsyin. <verse eid="EXO 3:8" /><verse number="9" style="v" sid="EXO 3:9" />al ṭuruh yetteṣliḏ zwik n aṯ israyil aḏ zerreγ mammeḵ imiṣriyen merjen disen. <verse eid="EXO 3:9" /><verse number="10" style="v" sid="EXO 3:10" />ureḥ al ferƹuwn bac asefγeḏ middeniw aṯ israyil seg miṣr.»<verse eid="EXO 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 3:11" />yaxy yuwa muwsa: «d mam neči bac areḥeγ al ferƹuwn? mammeḵ tasefγeγ aṯ israyil seg miṣr?»<verse eid="EXO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 3:12" />yerras rebbiy: «neči tadleγ iḏeḵ. we aydel ayuh d lemereṯ lliy neči nkiyγaḵ. almiy tasefγeḏ aṯ israyil talteƹebdem af ayuh n jbel.»<verse eid="EXO 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 3:13" />yuwa muwsa: «iḏa reḥḥeγ al aṯ israyil we asenemleγ: &lt; rahiy rebbiy n ibabenneγ yenkiḏ al γarwem. &gt; talsesetnen: &lt; d matta ismis?&gt; matta tasenemleγ?»<verse eid="EXO 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 3:14" />yerras rebbiy. «neči lliy lliγ.»</para>
  <para style="p" vid="EXO 3:14">aḏ yerniy: «amyuh asentemleḏ: &lt; weddin lliy yesemma imanis: «neči lliγ» d netta yenkiyiḏ al γarwem. &gt; »<verse eid="EXO 3:14" /></para>
  <para style="s">lweƹd n usemneƹ n aṯ israyil</para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 3:15" />yerniy yuwa y muwsa: «amyuh amleḏ y aṯ israyil: &lt; yenkiyiḏ al γarwem lliy diyma yella, rebbiy n ibabnuwem, rebbiy n ibrahiym aḏ rebbiy n isḥaq aḏ rebbiy n yeƹquwb. &gt; ayuh d ismiw diyma. ayuh d ism lliy yexs alsγuyen siyes lliy tadasen beƹduwem.<verse eid="EXO 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 3:16" />ureḥ laym iwessaren n israyil temeldasen: &lt; lliy diyma yella, rebbiy n ibabnuwem, rebbiy n ibrahiym aḏ isḥaq aḏ yeƹquwb yeḍherrid, yuwa: «rahiy nembelḥeq neči rriγ lbaliw mag iṣerewem g miṣr <verse eid="EXO 3:16" /><verse number="17" style="v" sid="EXO 3:17" />afelxaḍert n ayuh smuḏeγ tafensefγeγ seg ḏḏul n miṣr al tammurt n ikenƹaniyen aḏ lḥeyṯiyin aḏ lemuwriyin aḏ lferiziyin aḏ lḥwiyin aḏ lyebuwsyin, al tammurt lliy tečur d aγi aḏ tamemt.»&gt;<verse eid="EXO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 3:18" />taseγden iwessaren dwiḵ we abeddeḏ cek yiḏesen zzaṯ lmelek n miṣr we astemlem: &lt; rahiy lliy diyma yella, rebbiy n iƹebraniyen yuseneγd. mala djenneγ anreḥ tiḵli n 3 yyam g ṣṣeḥreṯ bac aneγres y lliy diyma yella rebbiynaγ. &gt; <verse eid="EXO 3:18" /><verse number="19" style="v" sid="EXO 3:19" />lekenti sseneγ lliy lmelek n miṣr wifenyetedjic areḥem ḥetta kan iwettiy ffus d meqqar. <verse eid="EXO 3:19" /><verse number="20" style="v" sid="EXO 3:20" />s fusiw tawetteγ miṣr s lwiliw lkul. wembeƹd afenyedj areḥem.<verse eid="EXO 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 3:21" />we aserliγ imiṣriyen fellewem aḏ witetriḥemc s ifesnuwem d lferγi almiy tarezfem. <verse eid="EXO 3:21" /><verse number="22" style="v" sid="EXO 3:22" />yexs ateḍleb kul ijeṯ siwem seg tmiṣrit lliy tseken γares naγ deljertis ṣiγeṯ n lfejreṯ aḏ wureγ aḏ leḥweyej bac atenirden ṭarwiwiṯuwem. amyuh taselbem imiṣriyen.»<verse eid="EXO 3:22" /></para>
  <chapter eid="EXO 3" />
  <chapter number="4" style="c" sid="EXO 4" />
  <para style="s">lliy dima yella yuca y muwsa lemereṯ n nnubuwṯ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 4:1" />amma muwsa yuwa: «matta zeγ kan wilsedqenc naγ wiqqilen alseγden aḏ uwan: &lt; rahiy lliy diyma yella wifdyeḍherc. &gt; »<verse eid="EXO 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 4:2" />ysesteny lliy diyma yella: «d matta tdin lliy g ufusiḵ.» yuwayas: «d tereṭṭa.»<verse eid="EXO 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 4:3" />yuwayas: «luḥiṯ af tammurt.» yaxy iluḥiṯ, teḏwel d telefsa tmereḏ. yexleƹ siyes muwsa. <verse eid="EXO 4:3" /><verse number="4" style="v" sid="EXO 4:4" />yuwa lliy diyma yella y muwsa: «zzel fusiḵ aṭfiyṯ seg ddilis.» yezzel muwsa fusis yeṭṭefiṯ teḏwel d tereṭṭa g fusis. <verse eid="EXO 4:4" /><verse number="5" style="v" sid="EXO 4:5" />yuwa lliy diyma yella: «agg ayuh bac aḏemnen lliy ggiγax d nnabiy. rahiy neči d lliy diyma yella lliy sennent ibabnuwem, rebbiy n ibrahiym aḏ isḥaq aḏ yeƹquwb.»<verse eid="EXO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 4:6" />yerniy yuwa lliy diyma yella: «seḏef fusiḵ g lxebuniḵ.» yseḏef fusis g lxebunis. yuwayas rebbiy: «seffeγ.» yseffeγ fusis. yaxy yufa fusis yeḏwel yejdem d millel am ṯṯelj.<verse eid="EXO 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 4:7" />yuwayas rebbiy: «ri al lxebuniḵ.» yaxy yeriy al lxebunis tijekkelt iḍen, lemmi ysefγiy yufa fusis yqeƹed am lbqiyeṯ n lbednis.<verse eid="EXO 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 4:8" />aḏ yuwa lliy diyma yella: «iḏa wifsedqenc naγ wirrinc lbalisen y lmuƹjizaṯ tmezwert n teretta tasedqen wisneṯ n ffus lliy yejdem. <verse eid="EXO 4:8" /><verse number="9" style="v" sid="EXO 4:9" />kan wisedqenc ayuh n senneṯ aḏ wislinic dwiḵ, čar fercu seg aman n lwaḏ tenγelet af tammurt lliy teqqur. aḏulen aman lliy tečureten seg lwaḏ d iḏemmen nnaj tammurt.»<verse eid="EXO 4:9" /></para>
  <para style="s">muwsa yenzeγ imanis aḏ rebbiy yenkiy yiḏes haruwn</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 4:10" />yuwa muwsa y lliy diyma yella: «seγed ay rebbiy, neči s luwel widdugixc yeqƹeḏ aḏ qqimeγ am idin ḥetta beƹd mag tuflayeḏ y lƹebdiḵ. neči dwiyw ƹaṭel aḏ ilsiw yeḏqel.» <verse eid="EXO 4:10" /><verse number="11" style="v" sid="EXO 4:11" />yaxy yuwayas lliy diyma yella: «d mam lliy yseḥfeḍ dwiy y bnaḏem. aḏ d mam itedjay d bekkuc naγ d laƹmey naγ izer. yaxy muc d neči? <verse eid="EXO 4:11" /><verse number="12" style="v" sid="EXO 4:12" />amma ṭuruh barra. taseḥfdeγ imiḵ dwiy we afsiḵneγ matta amleḏ.» <verse eid="EXO 4:12" /><verse number="13" style="v" sid="EXO 4:13" />lekinti muwsa yerras: «ay rebbiy fjahiγ bac anekyeḏ mam texseḏ xlafiw.» <verse eid="EXO 4:13" /><verse number="14" style="v" sid="EXO 4:14" />iγeccec ggeṯ lliy diyma yella af muwsa. yuwa</para>
  <para style="p" vid="EXO 4:14">«muc haruwn d uwaḵ? neči sseneγ lliy netta yetquddu dwiy. qa tadyas afileqa. lweqt lliy tafyzer tayfreḥ ulis. <verse eid="EXO 4:14" /><verse number="15" style="v" sid="EXO 4:15" />afenƹewneγ af dwiy we afenseḥefdeγ matta aggem. stuflayeḏ we stemleḏ man aymel. <verse eid="EXO 4:15" /><verse number="16" style="v" sid="EXO 4:16" />rahiy ayufley netta y midden g umkaniḵ, ayuflay s ismiḵ. aḏ cekkin am rebbiy lliy itucas lweḥy. <verse eid="EXO 4:16" /><verse number="17" style="v" sid="EXO 4:17" />tewyeḏ g fusiḵ ayuh n tereṭṭa bac aggeḏ siyes lmuƹjizaṯ.» yerla muwsa bac ayeg mag yuwayas rebbiy.<verse eid="EXO 4:17" /></para>
  <para style="s">ireḥ muwsa al middenis mammeḵ lliy dima yella yuwidas</para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 4:18" />yeḏwel muwsa al yeṯruwn nsibis, yuwayas: «djiḏ areḥeγ al middeniw g miṣr aḥekker kan wicci dderen.» yerras yeṯruwn: «barra af lamen.» <verse eid="EXO 4:18" /><verse number="19-23" style="v" sid="EXO 4:19-23" />yuwa lliy diyma yella tjekkelt iḍen y muwsa g midyan.</para>
  <para style="p" vid="EXO 4:19-23">«barra aḏwel al miṣr. rahiy mmuṯen lliy wsiyn xsen afenγen, smanis aḏuleḏ al miṣr smited bac asiḵneḏ zzaṯ ferƹuwn ayuh lƹjayeb lliy uciγaḵ lquweṯ af iggasenneṯ. lekinti djuleγ taseqsḥeγ yxfis aḏ wiyetseyebc middeniw, mles rahiy israyiliyen d terwew imezwern. seyyeb terwew, adj alezzalen. senneγ witteqileḏ atensiybeḏ, afelxaḍert n ayuh tanγeγ terweḵ imezweren.» yaxy yewya muwsa lehlis aḏ ṭarwas yserkiben af iγyal yeffeγ sisen al miṣr aḏ iqam tereṭṭa n lmuƹjizaṯ n rebbiy zada.<verse eid="EXO 4:19-23" /></para>
  <para style="s">ṣefuwra ddeher memmis aḏ tsemneƹ argazis</para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 4:24" />yaxy g abriyḏ tman mkan n uriyeḥ yeƹreḍas lliy diyma yella. yexs atyenγ afelxaḍert widehherc memmis. <verse eid="EXO 4:24" /><verse number="25" style="v" sid="EXO 4:25" />yaxy tqam ṣefuwra aḍγaγ n ṣṣem teqdeƹ siyes telecluct n memmis, teṭṭef siyes iderren n muwsa temmal: «cek nembelḥeq d lƹruws n iḏemmen y neči.» <verse eid="EXO 4:25" /><verse number="26" style="v" sid="EXO 4:26" />tuwa: «d lƹruws n iḏemmen.» afelxaḍert uwan amyuh s ddeher. yaxy yerla fellas lliy diyma yella.<verse eid="EXO 4:26" /></para>
  <para style="s">muwsa yessaḵen g lmuƹjizaṯ y iwessaren bac ayseyyeb midden</para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 4:27" />yuwa lliy diyma yella y haruwn: «ureḥ al ṣṣeḥereṯ bac aḏefḏ muwsa.» yaxy ireḥ ileqay tman jbel n rebbiy ybeḥbayi. <verse eid="EXO 4:27" /><verse number="28" style="v" sid="EXO 4:28" />yuwa muwsa y haruwn af dwiy n lliy diyma yella lkul lliy yuwayestiḏ aḏ matta yuwayas agg. <verse eid="EXO 4:28" /><verse number="29" style="v" sid="EXO 4:29" />wembeƹd usend muwsa yid haruwn al miṣr laymen iwessaren n aṯ israyil lkul. <verse eid="EXO 4:29" /><verse number="30" style="v" sid="EXO 4:30" />yaxy yuwayasen haruwn af matta yuwa lliy diyma yella y muwsa lkul. aḏ yeggi muwsa zzaṯesen lmuƹjizaṯ. <verse eid="EXO 4:30" /><verse number="31" style="v" sid="EXO 4:31" />yaxy umennen siyes midden, mniyn slen lliy lliy diyma yella yesmuqlesen aḏ yezra ḏḏulsen, ṭebsen tezellen y rebbiy.<verse eid="EXO 4:31" /></para>
  <chapter eid="EXO 4" />
  <chapter number="5" style="c" sid="EXO 5" />
  <para style="s">muwsa aḏ haruwn bbedden zzaṯ ferƹuwn</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 5:1" />wembeƹd reḥḥen muwsa aḏ haruwn al ferƹuwn uwanas: «yenkiyaneγ lliy diyma yella, rebbiy n israyiliyen. yuweyaḵ: &lt; seyyeb midniw adj alẓallen g ṣṣeḥreṯ. &gt; » <verse eid="EXO 5:1" /><verse number="2" style="v" sid="EXO 5:2" />yaxy yuwa ferƹuwn: «d mam netta lliy diyma yella bac aggeγ lliy yemmal we asiybeγ aṯ israyil? witsineγ aḏ witensiybeγc.» <verse eid="EXO 5:2" /><verse number="3" style="v" sid="EXO 5:3" />wembeƹd uwan: «rahiy rebbiy n iƹebraniyen yeḍherneγ. yexs aγentedjeḏ anyuwr tiḵli n 3 d ussan g ṣṣeḥreṯ bac aneγres y lliy diyma yella. kan wiγentedjac areḥ. rahiy taysezwa fellenneγ lwaf naγ taγenyenγ s ssiyf.» <verse eid="EXO 5:3" /><verse number="4" style="v" sid="EXO 5:4" />yaxy yuwa lmelik n miṣr y muwsa aḏ haruwn: «maγer teƹeṭlem midden af lecγalesen. ḏuleṯ al lxeḏmtewem lliy tuƹer. <verse eid="EXO 5:4" /><verse number="5" style="v" sid="EXO 5:5" />qa ayuh n midden rnin ṭuruh. maγer texsem atenriḥem seg lxeḏmeṯsen.»<verse eid="EXO 5:5" /></para>
  <para style="s">yerniy ferƹuwn lxeḏmeṯ y aṯ israyil</para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 5:6" />as diyn yuwa ferƹuwn y lliy ssexdemen g midden aḏ ccefan.<verse eid="EXO 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 5:7" />«maƹdec aḏucem y midden lluwm bac aggen ṭṭuwb mammeḵ tetcmasen qebbel. adj areḥen nihnin weḥdesen aleymen lluwm. <verse eid="EXO 5:7" /><verse number="8" style="v" sid="EXO 5:8" />aḏ meltesen ggen ṭṭuwb n lƹadeṯ wisenkizenc siyes, rahum d ibuxliyen, afelxaḍert n aydin tṣeyḥen mmalen: &lt; djenneγ anreḥ aneγres y rebbiynaγ. &gt; <verse eid="EXO 5:8" /><verse number="9" style="v" sid="EXO 5:9" />rnitasen lxeḏmeṯ bac alhan diyes aḏ wiseγdenc tikerkas n ayuh n irgazen.»<verse eid="EXO 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 5:10" />yaxy ffeγen lliy ssexdemen g midden aḏ ccifan tberḥen jar midden: «ayuh mag yuwa ferƹuwn: &lt; wifentuc lluwm. <verse eid="EXO 5:10" /><verse number="11" style="v" sid="EXO 5:11" />berreṯ kennim laymet mani tufimt aḏ witsenkezemc seg lƹded n ṭṭuwb af lƹadeṯ. &gt; »<verse eid="EXO 5:11" /></para>
  <para style="s">midden tlayemen lgac</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 5:12" />mferqen midden g tammurt n miṣr lkul bac aleymen lgac g lƹuwḍ n lluwm. <verse eid="EXO 5:12" /><verse number="13" style="v" sid="EXO 5:13" />aḏ wsiyn lliy ssexdemen disen mmalnasen tƹaweḏen: «kemleṯ lxeḏmtwem, lxeḏmeṯ n kul as g asis mammeḵ yusi mniyn diyes lluwm.» <verse eid="EXO 5:13" /><verse number="14" style="v" sid="EXO 5:14" />imiṣriyen lliy ssexdemen g aṯ israyil wetten ccifan n israyiliyen s ṣṣuwṭ af ixfewnesen aḏ nihnin mmalnesen: «maγer witkemlemc ṭṭuwb lliy yexs ateggem sennat aḏ as wuh mammeḵ tusim teteggem diyes qebbel.»<verse eid="EXO 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 5:15" />yaxy usend ccifan n israyiliyen y ferƹuwn uwan: «maγer tetteggeḏ amyuh s lƹbaḏiḵ? <verse eid="EXO 5:15" /><verse number="16" style="v" sid="EXO 5:16" />rahiy nihnin wiγentucenc lluwm aḏ xsennenneγ aneg ṭṭuwb am lƹadeṯ. qa čaṯen diyneγ s ṣṣuwṭ. rahiy ḏnub nnasen muc d nnaγ.»<verse eid="EXO 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 5:17" />yaxy yuwayasen: «kennim d ibuxliyen witxedmemc, haka ƹlac temmalem: &lt; djenneγ anreḥ aneγres y lliy diyma yella. &gt; <verse eid="EXO 5:17" /><verse number="18" style="v" sid="EXO 5:18" />yya ureḥeṯ xedmeṯ. wifentucenc lluwm aḏ yexs aggem ṭṭuwb kamel am lƹadeṯ.»<verse eid="EXO 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 5:19" />yaxy ccifan n yxeddemen ufen imanesen g lmuckleṯ temeqqart lemmi slen lliy yexs aggen ṭṭuwb am lƹadeṯ kul as weḥdes wisenkizenc siyes ḥetta d fercu. <verse eid="EXO 5:19" /><verse number="20" style="v" sid="EXO 5:20" />mniyn fγen s ferƹuwn ufen muwsa aḏ haruwn bbedden ssugumen disen. <verse eid="EXO 5:20" /><verse number="21" style="v" sid="EXO 5:21" />yaxy uwanasen: «afenyenγa rebbiy incella. rahiy smanis tusimeneγd krehnaneγ ferƹuwn aḏ midden lliy nnaḍḍen siyes. xesa fercu anγennenneγ s ssiyf.»<verse eid="EXO 5:21" /></para>
  <para style="s">yexernen muwsa y rebbiy</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 5:22" />yaxy yeḏwel muwsa al lliy diyma yella, yuwa: «maγer ddureḏ middeniḵ, ay rebbiy? maγer tenkidiḏ?» <verse eid="EXO 5:22" /><verse number="23" style="v" sid="EXO 5:23" />«smanis usiγd bac aḏuflayeγ y ferƹuwn s ismiḵ, yuḏel netta yedurru g midden. aḏ cek witensemneƹc.»<verse eid="EXO 5:23" /></para>
  <chapter eid="EXO 5" />
  <chapter number="6" style="c" sid="EXO 6" />
  <para style="nb">
    <verse number="1" style="v" sid="EXO 6:1" />yerra lliy diyma yella y muwsa.</para>
  <para style="p" vid="EXO 6:1">«qa tazreḏ mammeḵ taƹeqbeγ ferƹuwn. rahiy tateluzeγ s ffus quwiy bac ateniseyyeb we atenizeƹzeq.»<verse eid="EXO 6:1" /></para>
  <para style="s">rebbiy yuƹeḏ muwsa s uƹaqeb n ferƹuwn</para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 6:2" />aḏ yuwa rebbiy y muwsa.</para>
  <para style="p" vid="EXO 6:2">«neči d lliy diyma yella, <verse eid="EXO 6:2" /><verse number="3" style="v" sid="EXO 6:3" />ḍhereγd y ibrahiym aḏ isḥaq aḏ yeƹquwb d rebbiy yetqud kul cey. amma witsinenc ismiw d lliy diyma yella. <verse eid="EXO 6:3" /><verse number="4" style="v" sid="EXO 6:4" />aḏ ggiγ yiḏesen lƹehd bac asennuceγ tammurt n kenƹan mani sekenen diyes am ibariyen. <verse eid="EXO 6:4" /><verse number="5" style="v" sid="EXO 6:5" />aḏ qqimeγ seγdiγ g kuttu n aṯ israyil lliy ḏwellen d ičiwen n imiṣriyn. aḏ teggeγ ṭuruh lliy uƹeḏḏeγ siyes ibabenwem.<verse eid="EXO 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 6:6" />mala mlasen: &lt; neči d lliy diyma yella aḏ d neči takseγ fellawem ḏḏulem n imiṣriyen we afensemenƹeγ seg lƹubuditesen, we azleγ fusiw afensefγeγ s lḥukem qwi. <verse eid="EXO 6:6" /><verse number="7" style="v" sid="EXO 6:7" />smiteṯ lliy kennim d middeniw, aḏ neči d rebbiywem. tafensemneƹeγ seg imiṣriyen we asnem lliy neči d lliy diyma yella, rebbiywem. <verse eid="EXO 6:7" /><verse number="8" style="v" sid="EXO 6:8" />we afenuwyeγ al tammurt lliy djuleγ tatettuceγ, y ibrahiym aḏ isḥaq aḏ yeƹquwb, we afentedduceγ d lmemelkeṯ, neči d lliy diyma yella. &gt; » <verse eid="EXO 6:8" /><verse number="9" style="v" sid="EXO 6:9" />slen aṯ israyil ayuh n dwiy af imi n muwsa, lekinti wiquddenc rren lbalesen afelxaḍert wsiyn tƹanen seg ḏḏul lliy irenni.<verse eid="EXO 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 6:10" />wembeƹd yuwa lliy diyma yella y muwsa, <verse eid="EXO 6:10" /><verse number="11" style="v" sid="EXO 6:11" />«ureḥ abbed zzaṯ ferƹuwn lmelek n miṣr temldas aysiyb aṯ israyil seg tammurtis.» <verse eid="EXO 6:11" /><verse number="12" style="v" sid="EXO 6:12" />yaxy yerras muwsa: «qa, ḥetta aṯ israyil wiqqilen alseγden, mammeḵ zeγ texseḏ ferƹuwn alyesseγd. aḏ neči ilsiw yeḏqel.»<verse eid="EXO 6:12" /></para>
  <para style="s">leṣel n muwsa aḏ haruwn</para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 6:13" />rahiy yuflay lliy diyma yella am idin y muwsa aḏ haruwn. yuwayasen aḏulen al aṯ israyil aḏ ferƹuwn lmelek n miṣr bac aysiyb aṯ israyil seg tammurt n miṣr. <verse eid="EXO 6:13" /><verse number="14" style="v" sid="EXO 6:14" />inuh d nihnin d imeqqaren n lƹcayer seg aṯ israyil lemmi fγented.</para>
  <para style="p" vid="EXO 6:14">ṭarwa n rewbiyn bedri n israyil nihnin ḥenuk aḏ feluw aḏ ḥeṣruwn aḏ kermiy, tinuh d lƹcayer n rewbiyn.<verse eid="EXO 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 6:15" />ṭarwa n cemƹuwn, nihnin yemuwyl aḏ yamin aḏ uhed aḏ yekiyn aḏ ṣuwḥer aḏ cawel lliy netta d memmis n tkenƹanit, tinuh d lƹcayer n cemƹuwn.<verse eid="EXO 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 6:16" />inuh d ismawen n ṭarwa n lawiy feleḥsab n lƹcayresen, jercuwn aḏ qehat aḏ merary. aḏ yedder lawiy 100 we 7 we 30 d isuggesen.<verse eid="EXO 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 6:17" />amma ṭarwa n jercuwn feleḥsab n lƹcayresen nihnin libniy aḏ cemƹiy.<verse eid="EXO 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 6:18" />aḏ ṭarwa n qehat nihnin ƹemram aḏ yeṣhar aḏ ḥebruwn aḏ ƹuzyel. aḏ qehat yedder 100 we 3 we 30 d isuggasen.<verse eid="EXO 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 6:19" />aḏ ṭarwa n merary nihnin meḥliy aḏ muwciy. tinuh d lƹcayer n ilawiyyen mammeḵ luwlend.<verse eid="EXO 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 6:20" />yenjef ƹemram ƹemtis yuwkabed tuγesd haruwn aḏ muwsa aḏ ƹemram yedder 100 we 7 we 30 d isuggasen.<verse eid="EXO 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 6:21" />aḏ ṭarwa n yeṣhar nihnin quwreḥ aḏ nafaju aḏ ḏikri.<verse eid="EXO 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 6:22" />aḏ ṭarwa n ƹuzyel nihnin d micayil aḏ lṣafan aḏ sitriy.<verse eid="EXO 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 6:23" />yenjef haruwn licabeƹ yellis n ƹemminedab aḏ nettaṯ d weltmas n neḥcuwn tuγesd nadab aḏ abiyhuw aḏ liƹazer aḏ iṯamer.<verse eid="EXO 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 6:24" />aḏ ṭarwa n quwreḥ nihnin d ciru aḏ lqanet aḏ abiyasaf aḏ tinuh d lƹcayer n lquwreḥiyen.<verse eid="EXO 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 6:25" />liƹazer memmis n haruwn yenjef ijeṯ seg yessis n fuwṭiyel tuγesd finḥas.<verse eid="EXO 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 6:26" />inuh d haruwn aḏ muwsa lliy yuwayasen lliy diyma yella: &lt; sefγeṯ aṯ israyil seg tammurt n miṣr af lḥsab n lfireqsen. &gt; <verse eid="EXO 6:26" /><verse number="27" style="v" sid="EXO 6:27" />rahiy muwsa aḏ haruwn d nihnin lliy uwan y ferƹuwn lmelik n miṣr bac aysiyeb aṯ israyil seg miṣr.<verse eid="EXO 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 6:28" />mniyn yuflay lliy diyma yella y muwsa g tammurt n miṣr, <verse eid="EXO 6:28" /><verse number="29" style="v" sid="EXO 6:29" />yuwa «neči d lliy diyma yella, mmel y ferƹuwn lliy tafemleγ lkul.» <verse eid="EXO 6:29" /><verse number="30" style="v" sid="EXO 6:30" />aḏ yusi yerras muwsa: «neči ilsiw yeḏqel, mammeḵ talyeseγd ferƹuwn.»<verse eid="EXO 6:30" /></para>
  <chapter eid="EXO 6" />
  <chapter number="7" style="c" sid="EXO 7" />
  <para style="nb">
    <verse number="1" style="v" sid="EXO 7:1" />yuwa lliy diyma yella y muwsa</para>
  <para style="p" vid="EXO 7:1">«neči uciγeḵ lquweṯ af dwiy s ismiw zzaṯ ferƹuwn. aḏ yexs aḏuceḏ y haruwn lḥeq bac ayufley g umkaniḵ. <verse eid="EXO 7:1" /><verse number="2" style="v" sid="EXO 7:2" />aḏ yexs astemleḏ lliy tafemleγ lkul. aḏ netta ayuflay y ferƹuwn we aysiyeb aṯ israyil seg tammurtis. <verse eid="EXO 7:2" /><verse number="3" style="v" sid="EXO 7:3" />lekinti kul man ayseqṣeḥ ferƹuwn ixfis, asiḵenneγ lmuƹjizaṯiw g tammurt uh. <verse eid="EXO 7:3" /><verse number="4" style="v" sid="EXO 7:4" />γiyr ferƹuwn wifenyeseγdic, lweqt ḏḏin tawetteγ miṣr we asefγeγ middeniw, israyiliyen s lquweṯ n leḥkam d imeqqaren <verse eid="EXO 7:4" /><verse number="5" style="v" sid="EXO 7:5" />bac asennen imiṣriyen lliy d neči d lliy diyma yella aḏ lliy ddunyeṯ nnuw.» <verse eid="EXO 7:5" /><verse number="6" style="v" sid="EXO 7:6" />yaxy ggen muwsa aḏ haruwn mammeḵ yuwayasen lliy diyma yella. <verse eid="EXO 7:6" /><verse number="7" style="v" sid="EXO 7:7" />yusi muwsa γares ṯmaniyn d isuggasen aḏ haruwn γares 3 we ṯmaniyn d isuggasen weqt lliy uflayen y ferƹuwn.<verse eid="EXO 7:7" /></para>
  <para style="s">tiṯa tmezwert; aman ḏuglen d iḏemmen</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 7:8" />yuwa lliy diyma yella y muwsa aḏ haruwn. <verse eid="EXO 7:8" /><verse number="9" style="v" sid="EXO 7:9" />«weqt lliy ayeḍleb ferƹuwn s γarwem we afennimel siḵentid lγribtwem, mleḏ y haruwn: &lt; qam tereṭṭa n lmuƹjizaṯ tluwḥeteṯ zzaṯ ferƹuwn. &gt; ateḏwel d telefsa.» <verse eid="EXO 7:9" /><verse number="10" style="v" sid="EXO 7:10" />yaxy bbedden muwsa aḏ haruwn zzaṯ ferƹuwn aḏ ggen mammeḵ yuwa lliy diyma yella, yluweḥ haruwn tereṭṭes zzaṯ ferƹuwn aḏ midden lliy nnaḍḍen siyes, teḏwel d telefsa. <verse eid="EXO 7:10" /><verse number="11" style="v" sid="EXO 7:11" />yaxy yesγuy ferƹuwn af lƹulema nnas aḏ yseḥernis, ggen yseḥḥeren n miṣr mammeḵ yeggi haruwn. <verse eid="EXO 7:11" /><verse number="12" style="v" sid="EXO 7:12" />yluweḥ kul yjen tereṭṭas teḏwel d telefsa, lekinti tereṭṭa n muwsa tebleƹ tireḍwinesen. <verse eid="EXO 7:12" /><verse number="13" style="v" sid="EXO 7:13" />aḏ iγef n ferƹuwn yerniy yeqṣeḥ, wiyeqqil ayseγd dwiysen mammeḵ yuwa lliy diyma yella.<verse eid="EXO 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 7:14" />wembeƹd yuwa lliy diyma yella y muwsa,</para>
  <para style="p" vid="EXO 7:14">«rahiy iγef n ferƹuwn yeqṣeḥ aḏ wiyteqelc aysiyeb midden. <verse eid="EXO 7:14" /><verse number="15" style="v" sid="EXO 7:15" />bbed zzaṯ ferƹuwn ača almiy tayeffeγ al aman, bbed bac atleqiḏ af lḥacit n lwaḏ. aḏ qam g fusiḵ tereṭṭa lliy teḏwel d telefsa, <verse eid="EXO 7:15" /><verse number="16" style="v" sid="EXO 7:16" />mles, &lt;rahiy lliy diyma yella, rebbiy n iƹebraniyen yenkiyiḏ al γareḵ, yuwayeḵ: «siyyeb middeniw bac alzellen g ṣṣeḥreṯ.» aḏ qa cek al ṭuruh witteqqileḏc aggeḏ s dwiys.<verse eid="EXO 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 7:17" />mala sseγd mag yemmal lliy diyma yella: «lemmi tezreḏ matta ggiγ diyeḵ, tasneḏ lliy neči d lliy diyma yella, qa tawetteγ s ayuh n tereṭṭa aman n lwaḏ aḏuwelen d iḏemmen. <verse eid="EXO 7:17" /><verse number="18" style="v" sid="EXO 7:18" />we atemmuṯ trabit we ayenten lwaḏ we aƹefen imiṣriyen tissi n amanis.»&gt; » <verse eid="EXO 7:18" /><verse number="19" style="v" sid="EXO 7:19" />aḏ yuwa lliy diyma yella y muwsa</para>
  <para style="p" vid="EXO 7:19">«mmel y haruwn: &lt; qam tereṭṭa n lmuƹjizaṯ, tezleḏ fusiḵ al aman n imiṣriyen aḏ lwiḏanesen aḏ tijennesen aḏ iγlanensen aḏ tixubey n amanesen. &gt; aḏulen lkul d iḏemmen we adlen d iḏemmen g tammurt n miṣr lkul ḥetta g reγleṯ n lluwḥ aḏ reγleṯ n iḍγaγen.»<verse eid="EXO 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 7:20" />amyuh ggen muwsa aḏ haruwn mammeḵ yuwa lliy diyma yella; iqam haruwn tereṭṭa iwet siyes aman n lwaḏ zzaṯ ferƹuwn aḏ midden lliy nnaḍḍen siyes, ḏwellen aman n lwaḏ lkul d iḏemmen. <verse eid="EXO 7:20" /><verse number="21" style="v" sid="EXO 7:21" />aḏ temmuṯ trabitis lkul. yenten lwaḏ aḏ wiquddenc imiṣriyen aswen siyes. aḏ teḏwel tammurt n miṣr lkul d iḏemmen. <verse eid="EXO 7:21" /><verse number="22" style="v" sid="EXO 7:22" />amyuh ggen yseḥḥeren n miṣr zada, yerniy yeqṣeḥ iγef n ferƹuwn aḏ wiyeqqil ayseγd dwiysen, mammeḵ yuwa lliy diyma yella.<verse eid="EXO 7:22" /></para>
  <para style="s">ferƹuwn yetƹaneḏ</para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 7:23" />wembeƹd iruweḥ ferƹuwn al lḥucis am laḵ wiṣar ḥaja. <verse eid="EXO 7:23" /><verse number="24" style="v" sid="EXO 7:24" />aγezzen imiṣriyen lkul iburriƹen tman lwaḏ ruzzun af aman n tissi afelxaḍert wilquddenc aswen aman n lwaḏ. <verse eid="EXO 7:24" /><verse number="25" style="v" sid="EXO 7:25" />aḏ ƹeddan 7 d ussan s manis iwet lliy diyma yella aman n lwaḏ.<verse eid="EXO 7:25" /></para>
  <chapter eid="EXO 7" />
  <chapter number="8" style="c" sid="EXO 8" />
  <para style="s">tiṯa tisneṯ; iffeγ n tijran</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 8:1" />lliy diyma yella yuwa y muwsa tijekkelt iḍen.</para>
  <para style="p" vid="EXO 8:1">«bbed zzaṯ ferƹuwn temeldas: &lt; yuweyaḵ lliy diyma yella: «seyyeb middeniw adj alzellen. <verse eid="EXO 8:1" /><verse number="2" style="v" sid="EXO 8:2" />kan witensibec tawetteγ leḍraf n lbladiḵ s tijran. <verse eid="EXO 8:2" /><verse number="3" style="v" sid="EXO 8:3" />we ayfaḍ lwaḏ s tijran lliy tafeγneṯ we aḏeḏefneṯ al lqeṣriḵ aḏ mkaniḵ aḏ lituḵ aḏ ḥetta al ṭabuntiḵ aḏ timeƹjniniḵ. aḏ am idin taḏeḏefneṯ al tzaγwin n midden lliy nnaḍḍen siyiḵ aḏ tzaγwin n cceƹbiḵ. <verse eid="EXO 8:3" /><verse number="4" style="v" sid="EXO 8:4" />we aḏelineṯ fellaḵ aḏ af cceƹbiḵ aḏ af midden lliy nnaḍḍen siyiḵ lkul.»&gt; » <verse eid="EXO 8:4" /><verse number="5" style="v" sid="EXO 8:5" />aḏ yuwa lliy diyma yella y muwsa,</para>
  <para style="p" vid="EXO 8:5">«mmel y haruwn ayezel fusis s tereṭṭa n lmuƹjizaṯ af lwiḏan aḏ iγlanen aḏ igelmemen we ayseffeγ tijran g tammurt n miṣr lkul.» <verse eid="EXO 8:5" /><verse number="6" style="v" sid="EXO 8:6" />yezzel haruwn fusis af aman, yaxy usented tijran uḏenneṯ tammurt n miṣr. <verse eid="EXO 8:6" /><verse number="7" style="v" sid="EXO 8:7" />aḏ yseḥḥeren imiṣriyen ggen am haruwn. selyen tijran af tammurt n miṣr.<verse eid="EXO 8:7" /></para>
  <para style="s">ferƹuwn yuƹeḏ s useyyeb n midden</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 8:8" />wembeƹd yesγuy ferƹuwn y muwsa aḏ haruwn yuwayasen: «zelleṯ y lliy diyma yella bac aywiy tijran fella aḏ af middeniw we asiybeγ israyiliyen bac aḏucen lweƹdeṯ y lliy diyma yella.»<verse eid="EXO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 8:9" />yaxy yerra muwsa y ferƹuwn: «mliḏ lemmi texseḏ azelleγ afelxaḍertiḵ aḏ afelxaḍert n midden lliy nnaḍḍen siyiḵ aḏ cceƹbiḵ bac amukesneṯ tijran lliy tmaḵ aḏ g tzaγwiniḵ witqimaneṯ kan tindin lliy g lwaḏ.»<verse eid="EXO 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 8:10" />yaxy yuwa ferƹuwn: «ača.» yerras muwsa: «taggeγ mammeḵ tewiḏ bac asneḏ lliy widdic mam am lliy diyma yella, rebbiynaγ g lqudretis. <verse eid="EXO 8:10" /><verse number="11" style="v" sid="EXO 8:11" />we areḥneṯ tijran s tmaḵ aḏ seg tzaγwiniḵ aḏ seg midden lliy nnaḍḍen siyiḵ aḏ cceƹbiḵ, witqimaneṯ kan g lwaḏ.»<verse eid="EXO 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 8:12" />beƹd mag ireḥ muwsa aḏ haruwn seg tzaγwin n ferƹuwn yezzul muwsa y lliy diyma yella afelxaḍert n tijran lliy yseliyneṯ y ferƹuwn. <verse eid="EXO 8:12" /><verse number="13" style="v" sid="EXO 8:13" />yaxy yeggi lliy diyma yella mammeḵ yeḍleb muwsa, yenγa tijran lkul g tzaγwin aḏ leḥwec aḏ imezdeγen. <verse eid="EXO 8:13" /><verse number="14" style="v" sid="EXO 8:14" />laymentent d iguḏeyen d imeqqaren almiy texmer sisneṯ tammurt. <verse eid="EXO 8:14" /><verse number="15" style="v" sid="EXO 8:15" />lemmi yezra ferƹuwn lliy lwaf ykemmel yseqṣeḥ ixfis aḏ yeḏwel g dwiys mammeḵ yuwa lliy diyma yella y muwsa qebbel aḏ witenyedjic areḥen.<verse eid="EXO 8:15" /></para>
  <para style="s">tiṯa ṯaleṯ; tewecwect</para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 8:16" />yaxy yuwa lliy diyma yella y muwsa: «mmel y haruwn ayezel fusis s tereṭṭa n lmuƹjizaṯ we aywet siyes ijdi n tammurt bac ayeḏwel d tewecwect g miṣr lkul.» <verse eid="EXO 8:16" /><verse number="17" style="v" sid="EXO 8:17" />amyuh ggen. yezzel haruwn fusis s treṭṭa n lmuƹjizaṯ, iwet ijdi n tammurt. yeḏwel ayuh n ijdi lkul d twecwect. yaxy tuḏen tewecwect midden aḏ zwayel g miṣr lkul. <verse eid="EXO 8:17" /><verse number="18" style="v" sid="EXO 8:18" />lekenti yseḥḥeren n ferƹuwn wiquddenc asefγen seg tammurt tewecwect lliy tuḏen midden aḏ zwayel mammeḵ ggen haruwn aḏ muwsa.<verse eid="EXO 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 8:19" />yaxy uwan yseḥḥeren y ferƹuwn: «ayuh willi kan d igga n rebbiy.» lekinti iγef n ferƹuwn yeqqim yeqṣeḥ aḏ wiyeslic dwiy n muwsa aḏ haruwn, mammeḵ yuwa lliy diyma yella.<verse eid="EXO 8:19" /></para>
  <para style="s">tiṯa rrabƹa; tiresliyin n izan</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 8:20" />yuwa lliy diyma yella y muwsa,</para>
  <para style="p" vid="EXO 8:20">«kker taji bekri tebbedded zzaṯ ferƹuwn almiy tayeffeγ al aman tameldas af imi n haruwn: &lt; yuweyaḵ lliy diyma yella, seyyeb middeniw adj alzellen, <verse eid="EXO 8:20" /><verse number="21" style="v" sid="EXO 8:21" />kan witetsiybec middeniw tanekyeγ tiresliyin n izan ffeleḵ aḏ af midden lliy nnaḍḍen siyiḵ aḏ af cceƹbiḵ aḏ leqṣuriḵ we aƹebban izan tizeγwin n imiṣriyen we aḏeḏnen tammurt lliy seknen diyes.<verse eid="EXO 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 8:22" />lekinti as diyn g tammurt n jasan mani ysekken middeniw witadjiγ ḥetta d izi bac asneḏ lliy neči d lliy diyma yella, d rebbiy lliy iḥekm ḥetta g tammurt ayuh. <verse eid="EXO 8:22" /><verse number="23" style="v" sid="EXO 8:23" />we asemenƹeγ middeniw seg izan lliy tadesen y midden lliy nnaḍḍen siyiḵ. ayuh n lmuƹjizaṯ tatṣar ača. &gt; »<verse eid="EXO 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 8:24" />amyuh yeggi lliy diyma yella. hjemneṯ tiresliyin timeqqarin n izan af leqṣer n ferƹuwn aḏ tizeγwin n midden lliy nnaḍḍen siyes aḏ tammurt n miṣr lkul. yaxy temdur tammurt ggeṯ s izan.<verse eid="EXO 8:24" /></para>
  <para style="s">ferƹuwn yuƹeḏ tijekkelt iḍen s useyyeb n midden</para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 8:25" />yenkiy yesγuwy ferƹuwn y muwsa aḏ haruwn. yewayasen: «ureḥeṯ taγersem y rebbiywem lekinti g tammurt n miṣr.»<verse eid="EXO 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 8:26" />yerras muwsa af imi n haruwn mammeḵ yelmeḏ: «ayuh widyettic, afelxaḍert teγresetenneγ y lliy diyma yella, d ljifeṯ al imiṣriyen, kan anuc ayuh n teγrest lliy witetqeblenc imiṣriyen. rahiy taγenḥedfen s iḍγaγen. <verse eid="EXO 8:26" /><verse number="27" style="v" sid="EXO 8:27" />lekinti anreḥ tiḵli n 3 d ussan g ṣṣeḥreṯ bac anuc teγrest y rebbiynaγ mammeḵ yuweyaneγ.»<verse eid="EXO 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 8:28" />yaxy yuwa ferƹuwn: «tafensiybeγ bac aγersem y lliy diyma yella, rebbiywem g ṣṣeḥreṯ, lekinti witreḥec yebƹeḏ. aḏ ẓelleṯ afelxaḍertiw.»<verse eid="EXO 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 8:29" />yerras muwsa: «s manis afγeγ azelleγ y lliy diyma yella. aḏ ača areḥen izan fellaḵ aḏ af midden lliy nnaḍḍen siyiḵ aḏ af cceƹbiḵ. lekinti yexs witḏuglec g dwiḵ. aḏ yexs asiybeḏ midden bac aγresen y lliy diyma yella.»<verse eid="EXO 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 8:30" />yedj muwsa ferƹuwn, yezzul y lliy diyma yella. <verse eid="EXO 8:30" /><verse number="31" style="v" sid="EXO 8:31" />yuca lliy diyma yella y muwsa matta yeḍleb. yaxy reḥḥen izan af ferƹuwn aḏ cceƹbis aḏ midden lliy nnaḍḍen siyes, wiyeqim ḥetta d izi. <verse eid="EXO 8:31" /><verse number="32" style="v" sid="EXO 8:32" />lekinti iγef n ferƹuwn yeqṣeḥ tjekkelt iḍen, wifukc sraḥ n midden.<verse eid="EXO 8:32" /></para>
  <chapter eid="EXO 8" />
  <chapter number="9" style="c" sid="EXO 9" />
  <para style="s">tiṯa lxamsa; lwaf n zwayel</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 9:1" />yuwa lliy diyma yella y muwsa.</para>
  <para style="p" vid="EXO 9:1">«mmel y ferƹuwn matta uwiγeḵ, dwiy n lliy diyma yella, rebbiy n iƹebraniyen: &lt; seyyeb midniw bac alzellen. <verse eid="EXO 9:1" /><verse number="2" style="v" sid="EXO 9:2" />kan wittaqileḏ atensiybeḏ aḏ tetṭefeten γareḵ, <verse eid="EXO 9:2" /><verse number="3" style="v" sid="EXO 9:3" />rahiy ffus n lliy diyma yella tayenγ zwayeliḵ lliy g imezdeγen, seg tγallin aḏ iγyal aḏ ileγman aḏ ifwunesen aḏ tulli s lwaf d meqqar ggeṯ. <verse eid="EXO 9:3" /><verse number="4" style="v" sid="EXO 9:4" />amma zwayel n israyil tatendjeγ dderen aḏ wiyetmettic ḥetta cey y aṯ israyil. <verse eid="EXO 9:4" /><verse number="5" style="v" sid="EXO 9:5" />aḏ ayuh tateggeγ ača. &gt; » <verse eid="EXO 9:5" /><verse number="6" style="v" sid="EXO 9:6" />al ača yeggi lliy diyma yella ayuh, mmuneṯ zwayel n imiṣriyen lkul amma zwayel n israyiliyen wittemuṯ sisneṯ ḥetta d ijeṯ. <verse eid="EXO 9:6" /><verse number="7" style="v" sid="EXO 9:7" />yenkiy ferƹuwn bac ayṯebbet, yaxy yufa zwayel n aṯ israyil wittemuṯ sisneṯ ḥetta d ijeṯ, lekinti baqi yseqṣeḥ ixfis ḥetta beƹd mag yezra ayuh. aḏ wiseyyebc midden.<verse eid="EXO 9:7" /></para>
  <para style="s">tiṯa ssadisa; nbaṯeṯ n lqiḥ uliyend</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 9:8" />yuwa lliy diyma yella y muwsa aḏ haruwn.</para>
  <para style="p" vid="EXO 9:8">«qameṯ tikemcet, tikemcet seg iγeḍ n tinnurt, we aycetteƹ muwsa ayuh n iγeḍ al ujenna zzaṯ ferƹuwn. <verse eid="EXO 9:8" /><verse number="9" style="v" sid="EXO 9:9" />tarreγ ayuh n iγeḍ d lγubareṯ we ateḏen tammurt n miṣr lkul bac adtali d nbaṯaṯ n lqiḥ y midden aḏ zwayel.» <verse eid="EXO 9:9" /><verse number="10" style="v" sid="EXO 9:10" />yaxy qamen iγiḍ seg tinurin aḏ bbedden zzaṯ ferƹuwn. aḏ icettiƹy muwsa al ujenna yeḏwel d nbaṯaṯ n lqiḥ, uliyend y midden aḏ zwayel. <verse eid="EXO 9:10" /><verse number="11" style="v" sid="EXO 9:11" />ḥetta yseḥḥeren n miṣr ḏwellen tƹenan seg nbaṯaṯ am imiṣriyen lkul almiy wiquddenc abedden zzaṯ muwsa. <verse eid="EXO 9:11" /><verse number="12" style="v" sid="EXO 9:12" />lekinti rebbiy yseqṣeḥ iγef n ferƹuwn, wiyeqqil ayseγd y dwiysen mammeḵ yuwa lliy diyma yella y muwsa.<verse eid="EXO 9:12" /></para>
  <para style="s">tiṯa ssabƹa; tebruri</para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 9:13" />wembeƹd yuwa lliy diyma yella y muwsa.</para>
  <para style="p" vid="EXO 9:13">«kker tajji bekri bbed zzaṯ ferƹuwn tseṣeldas dwiyw: &lt; neči rebbiy n iƹebraniyen, seyyeb middeniw adj alzellen. <verse eid="EXO 9:13" /><verse number="14" style="v" sid="EXO 9:14" />rahiy tijekkelt tuwh tafwetteγ s lwifan imeqqaren cekkin aḏ midden lliy nnaḍḍen siyiḵ aḏ cceƹbiḵ bac asneḏ lliy widdic mam am neči g ddunyeṯ. <verse eid="EXO 9:14" /><verse number="15" style="v" sid="EXO 9:15" />rahiy neči usiγ tqudduγ azleγ fusiw we afmukseγ seg tammurt cek aḏ middeniḵ lkul s lwaf. <verse eid="EXO 9:15" /><verse number="16" style="v" sid="EXO 9:16" />lekinti djiγaḵ teddereḏ bac afsiḵneγ lquwtiw we aslen midden mennit d megger neči g tammurt lkul.<verse eid="EXO 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 9:17" />qa cek wecci tḥeqreḏ g middeniw aḏ witettaqlec atensiybeḏ. <verse eid="EXO 9:17" /><verse number="18" style="v" sid="EXO 9:18" />afelxaḍert n ayuh tasezwiγ ača tebruri temeqqart lliy ƹemris witezri miṣr am nettaṯ s manis tuḏel. <verse eid="EXO 9:18" /><verse number="19" style="v" sid="EXO 9:19" />nkiy ṭuruh tlaymeḏ zwayeliḵ aḏ matta γareḵ lkul g umezdeγ afelxaḍert lliy yeqqim diyes seg midden naγ seg zwayel aḏ wiyeteḏefc al jaj tatezwa fellas tebruri temeqqart we ayemmeṯ. &gt; » <verse eid="EXO 9:19" /><verse number="20" style="v" sid="EXO 9:20" />seg midden n ferƹuwn diyes midden ugeḏḏen s dwiy n rebbiy aḏ seḏefen ixudimnesen aḏ zwayelesen al tizeγwin. <verse eid="EXO 9:20" /><verse number="21" style="v" sid="EXO 9:21" />amma lliy ṯhezzan af dwiy n rebbiy djen ixudimenesen aḏ zwayelesen g umezdeγ.<verse eid="EXO 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 9:22" />yuwa lliy diyma yella y muwsa: «zzel fusiḵ al ujenna bac atezwa tebruri temeqqart af tammurt n miṣr lkul, seg irgazen aḏ zwayel aḏ rbiƹ g umezdeγen.» <verse eid="EXO 9:22" /><verse number="23" style="v" sid="EXO 9:23" />yezzel muwsa tereṭṭes al ujenna, yenkiy lliy diyma yella rreƹd aḏ tebruri aḏ treƹediyen timeqqarin af tammurt. <verse eid="EXO 9:23" /><verse number="24" style="v" sid="EXO 9:24" />tezwa tebruri temeqqart g lweqt yjen nettaṯ yid rreƹd s timsi, lliy ƹemris witezri miṣr s manis tuḏel d lummeṯ. <verse eid="EXO 9:24" /><verse number="25" style="v" sid="EXO 9:25" />tezwa tebruri g miṣr lkul. aḏ twet kul ḥaja g imezdeγen seg midden aḏ zwayel aḏ rbiƹ lliy yγemyed aḏ cjer lkul. <verse eid="EXO 9:25" /><verse number="26" style="v" sid="EXO 9:26" />amma tammurt n jasan mani seknen israyiliyen witzwic diyes tebruri.<verse eid="EXO 9:26" /></para>
  <para style="s">ferƹuwn yuƹeḏ tijekkelt wi 3 s useyyeb n midden</para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 9:27" />yaxy yenkiy ferƹuwn, yesγuwy y muwsa aḏ haruwn yuwayasen: «neči aγleḍeγ tijekkelt tuwh. rahiy γares lḥeq ayeg ayuh. neči aḏ middeniw wineḥli. <verse eid="EXO 9:27" /><verse number="28" style="v" sid="EXO 9:28" />ḍlbeṯ rebbiy bac ayesbed tebruri aḏ rreƹd. qa tafensiybeγ. rahiy maƹedc arnim dehnit ḥetta d fercu.»<verse eid="EXO 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 9:29" />yaxy yerras muwsa: «s manis afγeγ seg tmura tazleγ fusiw y lliy diyma yella bac aybeṭṭel rreƹd we aykef anzar we asneḏ lliy rebbiy iteg matta yexs g tammurtis. <verse eid="EXO 9:29" /><verse number="30" style="v" sid="EXO 9:30" />lekinti sseneγ lliy cek aḏ midden lliy nnaḍḍen siyiḵ wecci witettegiḏemc seg lliy diyma yella.» <verse eid="EXO 9:30" /><verse number="31" style="v" sid="EXO 9:31" />g lweqt wuh tefduxt aḏ timzin fseḏen afelxaḍert timzin usineṯ d tisbulin aḏ tefduxt tnewer. <verse eid="EXO 9:31" /><verse number="32" style="v" sid="EXO 9:32" />amma irden lliy qṣeḥḥen aḏ irden lliy dderen wimdurenc afelxaḍert wicci wimγirenc.<verse eid="EXO 9:32" /></para>
  <para style="s">iγef n ferƹuwn yeqṣeḥ</para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 9:33" />yeffeγ muwsa seg tmura n ferƹuwn, yezzel fusis y lliy diyma yella, yaxy ysebbed rreƹd aḏ tebruri lliy tusi tzugga af tammurt. <verse eid="EXO 9:33" /><verse number="34" style="v" sid="EXO 9:34" />lemmi yezra ferƹuwn anzar aḏ tebruri aḏ rreƹd beṭlen yeγleḍ, yseqṣeḥ ixfis netta aḏ midden lliy nnaḍḍen siyes tijekkelt iḍen. <verse eid="EXO 9:34" /><verse number="35" style="v" sid="EXO 9:35" />amyuh yseqṣeḥ ferƹuwn ixfis aḏ wiseyyebc aṯ israyil mammeḵ yuwa rebbiy af imi n muwsa.<verse eid="EXO 9:35" /></para>
  <chapter eid="EXO 9" />
  <chapter number="10" style="c" sid="EXO 10" />
  <para style="s">muwsa aḏ haruwn ḍelben seyyeb n midden tijekkelt iḍen</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 10:1" />aḏ yuwa lliy diyma yella y muwsa.</para>
  <para style="p" vid="EXO 10:1">«bbed zzaṯ ferƹuwn afelxaḍert seqeṣḥeγ ixfis aḏ ixfewen n midden lliy nnaḍḍen siyes bac aggeγ lmuƹjizaṯiw tinuh zzaṯesen. <verse eid="EXO 10:1" /><verse number="2" style="v" sid="EXO 10:2" />aḏ bac amleḏ y ṭarwaḵ aḏ ṭarwa n ṭarwaḵ mammeḵ ƹeqbeγ imiṣriyen, aḏ af lmuƹjizaṯ lliy ggixtent zzaṯesen bac asnem lliy d neči d lliy diyma yella, rebbiywem.»<verse eid="EXO 10:2" /></para>
  <para style="s">muwsa yeseggeḏ g ferƹuwn s ljraḏ</para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 10:3" />bbedden muwsa aḏ haruwn zzaṯ ferƹuwn uwanas.</para>
  <para style="p" vid="EXO 10:3">«sseγd dwiy n rebbiy n iƹebraniyen. rahiy yuwayeḵ: &lt; al lemmi teqimeḏ witetteqleḏc altḏebƹeḏ? siyyeb middeniw adj alezzalen. <verse eid="EXO 10:3" /><verse number="4" style="v" sid="EXO 10:4" />kan witensibec, tanekyeγ ljraḏ ača f lḍraf n tammurtiḵ. <verse eid="EXO 10:4" /><verse number="5" style="v" sid="EXO 10:5" />we ayeḏen uḏem n tammurt almiy wiyetquddu ḥetta d yjen atettizer we ayeč lliy tfedli tebruri aḏ ṭiṭawin lliy wetneṯ g cjer n imezdeγnuwem. <verse eid="EXO 10:5" /><verse number="6" style="v" sid="EXO 10:6" />we ayečar tizeγwiniḵ aḏ tzaγwin n midden lliy nnaḍḍen siyiḵ aḏ tzaγwin n imiṣriyen lkul. rahiy ayuh ƹemris wislin siyes ibabniḵ aḏ iḥniniḵ s manis skennen g ayuh n tammurt al ṭuruh. &gt; »</para>
  <para style="p" vid="EXO 10:6">wembeƹd yeffeγ seg tzaγwin n ferƹuwn. <verse eid="EXO 10:6" /><verse number="7" style="v" sid="EXO 10:7" />yaxy uwanas midden lliy nnaḍḍen siyes: «al lemmi tayeqqim ayuh n argaz yebbedeneγ am usennan? seyyeb midden bac azellen y lliy diyma yella, rebbiysen. yaxy wicci witsinec lliy miṣr texreb.»<verse eid="EXO 10:7" /></para>
  <para style="s">ferƹuwn yexs ayseyyeb irgazen akehaw</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 10:8" />yaxy sγuyen y muwsa aḏ haruwn bac abedden tijekkelt iḍen zzaṯ ferƹuwn. aḏ yuwayasen: «berreṯ azzelleṯ y lliy diyma yella, rebbiywem, amma mam tayreḥ.»<verse eid="EXO 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 10:9" />yerras muwsa: «tarreḥ lkulna s imezyenneneγ aḏ iwesernenneγ, s imeckenneneγ aḏ tmeckenineneγ, s zwayelenneγ aḏ tresliyineneγ afelxaḍert yexs aneg tfeṣka y lliy diyma yella.»<verse eid="EXO 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 10:10" />yeṣṣa ferƹuwn, yuwa: «adj afenniƹewen lliy diyma yella zeγ mammeḵ taxsem afensiybeγ s tiseḏnanuwem aḏ imeckenuwem. rahiy kennim tesmuḏem af ccer. <verse eid="EXO 10:10" /><verse number="11" style="v" sid="EXO 10:11" />aha, adj areḥen irgazen akehaw azellen y lliy diyma yella, muc d ayuh lliy texsem.» wembeƹd zeƹezqenten seg zzaṯ n ferƹuwn.<verse eid="EXO 10:11" /></para>
  <para style="s">tiṯa ṯṯemna: ahjam n ljraḏ</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 10:12" />yuwa lliy diyma yella y muwsa: «zzel fusiḵ af tammurt n miṣr adj ayezwa ljraḏ we atetyeḏen we ayeč rbiƹ lliy tfedli tebruri.»<verse eid="EXO 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 10:13" />yezzel muwsa tereṭṭes af tammurt n miṣr. yenkiy lliy diyma yella fellesen aḍu d cerqi g as diyn aḏ yiḍ diyn lkul. aḏ af tajji yuγed ljraḏ. <verse eid="EXO 10:13" /><verse number="14" style="v" sid="EXO 10:14" />tečur siyes tammurt n miṣr aḏ yezwa f lḍrafis lkul d tiresliyin timeqqarin. widyusic am nihintin qebbel aḏ widyettic am nihintin beƹd. <verse eid="EXO 10:14" /><verse number="15" style="v" sid="EXO 10:15" />yuḏen uḏem n tammurt almiy teḏwel d teṣeṭṭeft. aḏ yeča rbiƹ lliy diyes lkul aḏ lγelleṯ n cjer lliy tedja tebruri. aḏ witteqqim ḥetta d ḥaja tezizewt af cjer aḏ g imezdaγen n miṣr lkul. <verse eid="EXO 10:15" /><verse number="16" style="v" sid="EXO 10:16" />yaxy fiseƹ yesγuy ferƹuwn y muwsa aḏ haruwn, yuwayasen: «rahiy aγleḍeγ yid lliy diyma yella, rebbiywem, yid iḏuwem. <verse eid="EXO 10:16" /><verse number="17" style="v" sid="EXO 10:17" />semaḥtiḏ tijekkelt tuwh af bekkeḍu. rahiy ceƹfeγ meƹdc aƹewdeγ. tezellem y lliy diyma yella, rebbiywem bac ayekkes fella ayuh n lmuṣiybeṯ lliy tnaq.»<verse eid="EXO 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 10:18" />yaxy iruweḥ muwsa s ferƹuwn, yezzul y lliy diyma yella. <verse eid="EXO 10:18" /><verse number="19" style="v" sid="EXO 10:19" />yenkiy lliy diyma yella aḍu d meqqar s mγerreb. yefreḍ ljraḏ ilewḥi g iylel zuggaγ. aḏ witteqqim ḥetta d tejraḏt g tammurt n miṣr. <verse eid="EXO 10:19" /><verse number="20" style="v" sid="EXO 10:20" />lekenti lliy diyma yella yseqṣeḥ iγef n ferƹuwn aḏ wiseyyebc aṯ israyil.<verse eid="EXO 10:20" /></para>
  <para style="s">tiṯa tesƹa: isa n tellest teṣeṭṭeft</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 10:21" />yaxy yuwa lliy diyma yella y muwsa: «zzel fusiḵ al ujenna adj atƹam tellest af tammurt n miṣr almiy midden taḏulen ttesnen abriyḏesen s uberbuc.» <verse eid="EXO 10:21" /><verse number="22" style="v" sid="EXO 10:22" />yaxy yezzel muwsa fusis al ujenna. tezwa tellest temeqqart af miṣr lkul 3 d ussan. <verse eid="EXO 10:22" /><verse number="23" style="v" sid="EXO 10:23" />wiqudc disen ḥetta ḥed ayzer uwas naγ ayeffeγ seg umkanis ussan diyn. lekenti ddu wecci yṣeγa mani seknen aṯ israyil.<verse eid="EXO 10:23" /></para>
  <para style="s">ferƹuwn yexs aysiyeb midden s lecruḍ</para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 10:24" />yesγuy ferƹuwn y muwsa yuwa: «ureḥeṯ tẓallem y lliy diyma yella, kennim aḏ imeckenuwem. amma djeṯ zweyluwem aḏ tiresliyinuwem deh.» <verse eid="EXO 10:24" /><verse number="25" style="v" sid="EXO 10:25" />yaxy yuwa muwsa: «yexs aγentedjeḏ anewyi man aneγres y lliy diyma yella we asneḥreq. <verse eid="EXO 10:25" /><verse number="26" style="v" sid="EXO 10:26" />afelxaḍert n ayuh tareḥneṯ iḏenneγ tullineγ aḏ wiyetγimi ḥetta ciy sisenneṯ. yexs anextar sisneṯ man anuc y lliy diyma yella, rebbiynaγ. aḏ winessinc mantan tasneγres kan almiy nuṣel al γaḍih.»<verse eid="EXO 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 10:27" />lekenti lliy diyma yella yseqṣeḥ iγef n ferƹuwn, yaxy witenniseyyebc. <verse eid="EXO 10:27" /><verse number="28" style="v" sid="EXO 10:28" />yuwa ferƹuwn y muwsa: «ffeγ fella, arr lbaliḵ af imaniḵ, witbeddac zzaṯiw tijekkelt iḍen. rahiy as lliy tezreḏ uḏmiw tameteḏ.»<verse eid="EXO 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 10:29" />yaxy yuwa muwsa: «bahi, d ṣbiḥ mag tuwiḏ. wizerrexc uḏmiḵ tijekkelt iḍen.»<verse eid="EXO 10:29" /></para>
  <chapter eid="EXO 10" />
  <chapter number="11" style="c" sid="EXO 11" />
  <para style="s">muwsa yseggeḏ ferƹuwn s tiṯa lexraniya</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 11:1" />aḏ yuwa lliy diyma yella y muwsa:</para>
  <para style="p" vid="EXO 11:1">«teqqim rziyeṯ ijeṯ, tawetteγ siyes ferƹuwn aḏ imiṣriyen. beƹdis tafenniseyyeb s yeh. we afenizeƹzeq lkulkum. <verse eid="EXO 11:1" /><verse number="2" style="v" sid="EXO 11:2" />mmel ṭuruh y israliyen; tiseḏnan aḏ irgazen ayeḍleb kul yjen sisen s ljaris wureγ aḏ lfejreṯ.» <verse eid="EXO 11:2" /><verse number="3" style="v" sid="EXO 11:3" />aḏ lliy diyma yella yerra imiṣriyen rlan af midden. aḏ muwsa yeḏwel d argaz d ṣbiḥ aḏ d meqqar al imiṣriyen aḏ al midden lliy nnaḍḍen s ferƹuwn.<verse eid="EXO 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 11:4" />yaxy yberreḥ muwsa zzaṯ ferƹuwn yuwa.</para>
  <para style="p" vid="EXO 11:4">«ayuh mag yemmal lliy diyma yella: &lt; taƹeddiγ yid zgen yeḍ g amas n miṣr. <verse eid="EXO 11:4" /><verse number="5" style="v" sid="EXO 11:5" />tanγeγ ibedriyen lkul g tammurt n miṣr seg bedri n ferƹuwn lliy af lƹerc al ubedri n tetciwt lliy tezzaḍ af tessirt aḏ ijjaren imezweren n zwayel. <verse eid="EXO 11:5" /><verse number="6" style="v" sid="EXO 11:6" />we ayeli ṣeyyeḥ d meqqar g miṣr lkul wizrinc am netta qebbel aḏ wizrinc am netta beƹd.<verse eid="EXO 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 11:7" />amma jar israyiliyen winebbeḥ ḥetta d yeddi af lƹebd naγ af zeyleṯ aḏ lweqt ḏḏin asnem lliy neči weziγ israyiliyen seg imiṣriyen. &gt; » <verse eid="EXO 11:7" /><verse number="8" style="v" sid="EXO 11:8" />aḏ yuwa muwsa y ferƹuwn: «lweqt ḏḏin, aldesen middeniḵ lkul inuh we aṭebsen zzaṯiw we amlen: &lt; ureḥ cek aḏ indin lliy debƹen diyeḵ seg midden. &gt; lweqt ḏḏin areḥeγ.» iγeccec muwsa yeƹdel, yeffeγ s ferƹuwn. <verse eid="EXO 11:8" /><verse number="9" style="v" sid="EXO 11:9" />yuwa lliy diyma yella y muwsa: «rahiy ferƹuwn wiyeqqil ayeṣeγd dwiywem bac arnineṯ lmuƹjizaṯiw g tammurt n miṣr.» <verse eid="EXO 11:9" /><verse number="10" style="v" sid="EXO 11:10" />aḏ ggen muwsa aḏ haruwn layaṯ lkul zzaṯ ferƹuwn lekenti lliy diyma yella yseqṣeḥ ixfis aḏ wiseyyebc aṯ israyil seg tzaγwin n miṣr.<verse eid="EXO 11:10" /></para>
  <chapter eid="EXO 11" />
  <chapter number="12" style="c" sid="EXO 12" />
  <para style="s">yeggi rebbiy lferḍ n tfeṣka n teγrest</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 12:1" />yuwa lliy diyma yella y muwsa aḏ haruwn g tammurt n miṣr:<verse eid="EXO 12:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 12:2" />«seg as uh taydel γarwem ayuh n cehher d mezwar n isuggasen aḏ d iγef n lechur. <verse eid="EXO 12:2" /><verse number="3" style="v" sid="EXO 12:3" />g as lƹacer n ayuh n cehher yexs aywiy kul yjen sisen izmer y lƹiltis af leḥsab n tzaγwin n ibaben, izmer y kul lƹeyleṯ. <verse eid="EXO 12:3" /><verse number="4" style="v" sid="EXO 12:4" />kan izmer ggeṯ af lƹilt ḏḏin, yexs atzun izmer nettaṯ yid lƹileṯ lliy tmas af leḥsab n mennit tquddun ačan middenis. <verse eid="EXO 12:4" /><verse number="5" style="v" sid="EXO 12:5" />aḏ yexs aydel izmer d ḏker aḏ d ssenwi. aḏ widdis ḥetta d lula atextarem seg tulli naγ seg teγaṭin.<verse eid="EXO 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 12:6" />we ayeqqim γarwem al as n 4ṭac seg ayuh n cehher. kennim ya aṯ israyil yexs aγersem izmaren as diyn temeddiṯ. <verse eid="EXO 12:6" /><verse number="7" style="v" sid="EXO 12:7" />aḏ aqemem iḏamen ateneggem af limin aḏ uzelmaḍ aḏ nnaj imi n tzaqqa lliy tačam diyes. <verse eid="EXO 12:7" /><verse number="8" style="v" sid="EXO 12:8" />yiḍ diyn, yexs ačam yessum d lmecwa netta yid tqurset lliy widdic lexmireṯ yid lexḍar lliy izeyen. <verse eid="EXO 12:8" /><verse number="9" style="v" sid="EXO 12:9" />witetemc siyes yedder naγ ydab lekenti d lmecwa; ixfis aḏ idernis aḏ teddewertis. <verse eid="EXO 12:9" /><verse number="10" style="v" sid="EXO 12:10" />yexs ačam siyes yiḍ diyn. aḏ lliy yefdelled al ača atḥerqem tajji. <verse eid="EXO 12:10" /><verse number="11" style="v" sid="EXO 12:11" />yexs ajrim imanuwem y iffeγ, we ačam fiseƹ aḏ kennim tḥezmem, tireḍḍem ṣbebtwem, aḏ teṭṭefem iγeḏmenuwem. amyuh tajrim imanuwem y uƹeddiw.<verse eid="EXO 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 12:12" />aḏ g ayuh n yiḍ taƹeddiγ g amas n miṣr we anγeγ ibedriyen lliy diyes lkul n midden naγ n zwayel. we asezwiγ leƹqabiw af irebbiyen n imiṣriyen. rahiy neči d lliy diyma yella.<verse eid="EXO 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 12:13" />lemmi azreγ iḏamen aƹeddiγ af imaniw aḏ witzuggic fellawem lmuṣiybeṯ n tmettent lliy tatezwa af tammurt n miṣr. rahiy s lemereṯ n iḏamen lliy af tzaγwinuwem tamenƹem.<verse eid="EXO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 12:14" />smitaṯ ayuh n as. tferḥem diyes. rahiy d tfeṣka y lliy diyma yella. aḏ d lwajeb n diyma, ateggem kennim aḏ ṭarwiwiṯuwem lliy tadesen beƹduwem lkul.<verse eid="EXO 12:14" /></para>
  <para style="s">ljumƹa n tfeṣka n tqurset</para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 12:15" />7 d ussan aggem tfeṣka. ačam disen tqurset. aḏ yexs asefγem lexmireṯ seg tzaγwinuwem g as mezwar. aḏ kul yjen ayeč ḥaja s lexmireṯ g ljumƹa diyn aymukes seg aṯ israyil. <verse eid="EXO 12:15" /><verse number="16" style="v" sid="EXO 12:16" />g as mezwar aḏ as wi 7, amleqim we aẓellem. aḏ yexs witetteggem disen ḥaja kan jerru n učuwem.<verse eid="EXO 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 12:17" />aḏ aggem tfeṣka n tqurset bac adesmitim ayuh n as lliy sefγeγ diyes leƹceyeruwem seg tammurt n miṣr. ggeṯ as wuh d tfeṣka kul suggas af tmeddurt n lejyaluwem lliy tadesen. <verse eid="EXO 12:17" /><verse number="18" style="v" sid="EXO 12:18" />aḏ seg tmeddiṯ n as 14 n cehher mezwar al tmeddiṯ n as 21 siyes, ačam tqurset. <verse eid="EXO 12:18" /><verse number="19" style="v" sid="EXO 12:19" />7 d ussan yexs aydel widdic lexmireṯ g tizeγwinuwem. iḏa yjen ayeč uču s lexmireṯ aymukes seg aṯ israyil, israyiliyen aḏ lliy ḏbeƹenten kifkif. <verse eid="EXO 12:19" /><verse number="20" style="v" sid="EXO 12:20" />ljmuƹ tuwh witetteṯc ḥaja s lexmireṯ mani treḥḥem.»<verse eid="EXO 12:20" /></para>
  <para style="s">yuwa muwsa y aṯ israyil af teγrest n izmer n tfeṣka</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 12:21" />wembeƹd yesγuy muwsa</para>
  <para style="p" vid="EXO 12:21">«ya iwessaren n aṯ israyil, sseγdeṯ man mleγ, beƹd ussan tanefeγ, xtareṯ izmaren af leḥsab n leƹyeluwem teγersem izmer n tfeṣka. <verse eid="EXO 12:21" /><verse number="22" style="v" sid="EXO 12:22" />wembeƹd qameṯ timeṣleḥṭ n zufa teneqƹemteṯ g iḏamen lliy g lmaƹuwn. teḏehnem siyes limin aḏ uzelmaḍ aḏ nnaj n imi n tzaqqa. aḏ witeffeγ ḥetta d yjen siwem seg tzaqqas al tajji,<verse eid="EXO 12:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 12:23" />afelxaḍert lliy diyma yella tayƹedda g yiḍ bac ayenγ imiṣriyen. weqt lliy ayzer iḏamen af imi n tzaqqa ayƹedda af imanis aḏ witedjic lmeleyka n temettent aḏeḏfen al tizeγwinuwem bac afennineγ.<verse eid="EXO 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 12:24" />aḏ ayuh d lwajeb fellawem aḏ af ṭarwiwiṯuwem y diyma. <verse eid="EXO 12:24" /><verse number="25" style="v" sid="EXO 12:25" />lemmi aḏeḏfem al tammurt lliy yuƹeḏ siyes lliy diyma yella bac afentedyuc, aggem ayuh n lwajeb. <verse eid="EXO 12:25" /><verse number="26" style="v" sid="EXO 12:26" />aḏ lemmi afensestenen ṭarwiwiṯuwem matta lmeƹnas ayuh n lferḍ <verse eid="EXO 12:26" /><verse number="27" style="v" sid="EXO 12:27" />atenjewbem lweqt ḏḏin: &lt; ayuh d teγrest n tfeṣka n iffeγ y lliy diyma yella lliy iƹedda af imewen n tzaγwin n aṯ israyil g miṣr mniyn yenγa imiṣriyen. aḏ ysemneƹ tizeγwinneγ. &gt; » yaxy rkeƹen midden, ḥmeḏḏen rebbiy. <verse eid="EXO 12:27" /><verse number="28" style="v" sid="EXO 12:28" />yaxy reḥḥen aṯ israyil ggen mammeḵ yuwa lliy diyma yella y muwsa aḏ haruwn gedged.<verse eid="EXO 12:28" /></para>
  <para style="s">tiṯa lƹecra temettent n ibedriyen</para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 12:29" />zgen yeḍ, yenγa lliy diyma yella ibedriyen n imiṣriyen lkul; seg ubedri n ferƹuwn lliy iḥekkem, al ubedri n lliy yella g lḥebs aḏ ibedriyen n zwayel lkul zada. <verse eid="EXO 12:29" /><verse number="30" style="v" sid="EXO 12:30" />yaxy sfeqqend ferƹuwn aḏ midden lliy nnaḍḍen siyes aḏ imiṣriyen lkul. aḏ yuḏel ṣyaḥ d meqqar g tammurt n miṣr afelxaḍert wiyeqqimc diyes ḥetta d lḥuc widdic mam yemmuṯ. <verse eid="EXO 12:30" /><verse number="31" style="v" sid="EXO 12:31" />yiḍ diyn, yesγuy ferƹuwn y muwsa aḏ haruwn, yuwa: «kkreṯ afγeṯ seg miṣr kennim yid aṯ israyil, treḥḥem tezzalem y lliy diyma yella mammeḵ tuwim. <verse eid="EXO 12:31" /><verse number="32" style="v" sid="EXO 12:32" />awyeṯ iḏuwem tulliwem aḏ tifunasinuwem mammeḵ tuwim. aḏ ḍelbeṯ rebbiy bac ayerla fella.» <verse eid="EXO 12:32" /><verse number="33" style="v" sid="EXO 12:33" />yaxy uwan imiṣriyen y israyiliyen: «luffeṯ imanuwem, fγeṯ s yeh naγ anemmuṯ lkul.»<verse eid="EXO 12:33" /></para>
  <para style="s">iffeγ n aṯ israyil seg miṣr</para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 12:34" />yaxy ggen midden leƹjinesen g timeƹejnin man γiyr lexmireṯ aḏ ggenten d ikemmusen, qamenten af ixrumensen, nihnin aḏ leḥeyweyjisen. <verse eid="EXO 12:34" /><verse number="35" style="v" sid="EXO 12:35" />aḏ ḍlebben s imiṣriyen lfejreṯ aḏ wureγ aḏ leḥwayej mammeḵ yuwa muwsa. <verse eid="EXO 12:35" /><verse number="36" style="v" sid="EXO 12:36" />aḏ yeggi rebbiy mammeḵ rlan imiṣriyen af aṯ israyil, aḏ ucnasen lliy ḍlebben lkul. aḏ amyuh sleben imiṣriyen. <verse eid="EXO 12:36" /><verse number="37" style="v" sid="EXO 12:37" />reḥḥen aṯ israyil seg reƹmesis al sekkuwt aḏ wsiyn ḥeḍerbac set 100 d lalafaṯ n irgazen lliy gguren bexlaf tiseḏnan aḏ imeckenen. <verse eid="EXO 12:37" /><verse number="38" style="v" sid="EXO 12:38" />reḥḥen yiḏesen ggeṯ d midden iḍen aḏ izmeren aḏ tifwunesin aḏ zwayel. <verse eid="EXO 12:38" /><verse number="39" style="v" sid="EXO 12:39" />ggen leƹjin lliy awyent yiḏesen seg miṣr d tqurset afelxaḍert yusi wiyulic mniyn ttuzeƹezqen seg miṣr fiseƹ aḏ wiquddenc aseḥedren učunesen.<verse eid="EXO 12:39" /></para>
  <para style="s">lesbar n tfeṣka n teγrest</para>
  <para style="p">
    <verse number="40-51" style="v" sid="EXO 12:40-51" />aḏ g as diyn lliy wiyetmuttuc, ffaγen midden lkul n aṯ israyil seg tammurt n miṣr. aḏ mammeḵ iƹedda rebbiy yiḍ diyn kamel yesufuγ disen seg miṣr, yexs nihnin aszellen we adesmitan yiḍ kamel matta yeggisen kul suggas. yuwayasen lliy diyma yella,</para>
  <para style="p" vid="EXO 12:40-51">«ayuh d lesbar n tfeṣka n teγrest; witet ḥetta d yjen siyes kan israyiliyen.</para>
  <para style="p" vid="EXO 12:40-51">aḏ kul ačiw tesγimt s lfejreṯ ayeč siyes beƹd man addehrem. lliy ysekken iḏuwem naγ ixeddem γarwem witeč siyes.</para>
  <para style="p" vid="EXO 12:40-51">yexs atečem al jaj. aḏ witsufuγemc al barra, aḏ witrezzemc siyes ḥetta d gerguj. aḏ yexs midden n aṯ israyil ateggen d tfeṣka jemiƹ.</para>
  <para style="p" vid="EXO 12:40-51">kan yexs yjen muc d israyiliy ysekken jarwem, ayeg tfeṣka n teγrest y lliy diyma yella, yexs aydehher leḏkur lkul lliy g lḥucis wembeƹd ayeg tfeṣka, we aydel am israyiliyen. aḏ witet siyes ḥetta d yjen widehherc. ayuh d cceriyƹeṯ y israyiliyen aḏ iberraniyen lliy jarwem.» yaxy ggen israyiliyen lkul mammeḵ yuwa lliy diyma yella y muwsa aḏ haruwn. as diyn, yseffeγ lliy diyma yella aṯ israyil seg tammurt n miṣr. ḥekreṯ mammeḵ ysefγin rebbiy af leḥsab n leƹceyresen beƹd mag qqimen g miṣr 430 d isuggasen.<verse eid="EXO 12:40-51" /></para>
  <chapter eid="EXO 12" />
  <chapter number="13" style="c" sid="EXO 13" />
  <para style="s">yexs aṯ israyil smiten matta yeggi rebbiy lmi teggen tfeṣka n tqurset</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 13:1" />yuwa lliy diyma yella y muwsa: <verse eid="EXO 13:1" /><verse number="2" style="v" sid="EXO 13:2" />adj ibedriyen lkul n aṯ israyil y neči; am ibedriyen n midden am ijerren imezweren n zwayel.<verse eid="EXO 13:2" /></para>
  <para style="b" />
  <para style="s">aṯ israyil yexs aḏucen ibedriyen y rebbiy</para>
  <para style="p">
    <verse number="3-16" style="v" sid="EXO 13:3-16" />muwsa isixen dwiy n rebbiy, yuwa: «almiy afiseḏef lliy diyma yella al tammurt n ikenƹaniyen mammeḵ yedjullaḵ aḏ yedjul y babniḵ bac afentedyuc, yexs aḏuceḏ y lliy diyma yella kul bedri, aḏ kul jjar d mezwar n zwayeliḵ. amma jjar mezwar n iγyal atefdiḏ s ƹelluc naγ atenγeḏ. we afdiḏ am idin kul bedri seg ṭarwaḵ.</para>
  <para style="p" vid="EXO 13:3-16">lemmi afisesten mammeḵ as iḍen: &lt; matta lmeƹnas ayuh?&gt; asterreḏ: &lt; rahiy s lqudertis ysefγaneγ lliy diyma yella seg miṣr lliy nusi diyes d ičiwen. aḏ lemmi iƹaneḏ ferƹuwn aḏ wiyeqqil aγeniseyyeb, yenγa lliy diyma yella ibedriyen lkul n midden aḏ zwayel g miṣr. afelxaḍert n ayuh attuceγ ijjaren imezweren n zweyliw aḏ feddiγ kul bedri seg ṭarwew.</para>
  <para style="p" vid="EXO 13:3-16">we aydel ayuh n lwajeb am lemereṯ teteḍhered af fusiḵ aḏ af ujebbuhiḵ bac adnesmita mammeḵ rebbiy ysefγaneγ seg miṣr s ffus qwi. &gt; »</para>
  <para style="b" vid="EXO 13:3-16" />
  <para style="p" vid="EXO 13:3-16">«smiteṯ ayuh n as lliy ysefγawem diyes lliy diyma yella s ffus qwi seg miṣr lliy tusim diyes d ičiwen. afelxaḍert n ayuh witetteṯc aγrum s lexmireṯ g ussan n tfeṣka. rahiy g as uh seg cehher n abiyb kennim tefγem. almiy afenniseḏef lliy diyma yella al tammurt n ikenƹaniyen aḏ iḥeyṯiyin aḏ lemuwriyin aḏ lḥwiyin aḏ lyebuwsyin, tammurt teḏḏin lliy tetcur d aγi aḏ d tamemt, aḏ lliy yedjul rebbiy y ibabnuwem tafentedyuc, yexs aggem ayuh n tfeṣka g ayuh n cehher.</para>
  <para style="p" vid="EXO 13:3-16">7 d ussan witetettemc disen aγrum s lexmireṯ. aḏ g as 7 amleqim we aẓellem y lliy diyma yella. 7 d ussan ačam disen tqurset aḏ witetḥerzemc ḥaja texmer naγ diyes lexmireṯ g tammurtuwem lkul. g ussan n tfeṣka yexs asiḵneḏ y memmiḵ we astemleḏ: «yexs aneg ayuh n lwajeb bac adnesmita lliy rebbiy ysefγeneγ seg miṣr.»</para>
  <para style="p" vid="EXO 13:3-16">we aydel ayuh n lwajeb am lemereṯ teteḍhered af fusiḵ aḏ af ujebbuhiḵ bac aḏufleyeḏ af cceriyƹeṯ n lliy diyma yella y terweḵ we asentsiḵneḏ mammeḵ ysefγaḵ lliy diyma yella seg miṣr s ffus qwi. we aggeḏ ayuh n lwajeb tijekkelt kul suggas g lweqtis.»<verse eid="EXO 13:3-16" /></para>
  <para style="s">aṯ israyil debƹen g ugeṭṭum n sḥab aḏ timsi lliy yeggi rebbiy</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 13:17" />lemmi yseyyeb ferƹuwn midden, witenyuwyic rebbiy g ubriḏ n felesṭiyn lliy d yezzul bac wineddemenc midden iḏa kan tṣar lḥerb aḏ wiḏuggelenc al miṣr. <verse eid="EXO 13:17" /><verse number="18" style="v" sid="EXO 13:18" />lekenti yuwya rebbiy midden g ubriḏ n ṣṣeḥreṯ lliy tman iylel zuggaγ. aḏ ffaγen aṯ israyil seg miṣr metselḥyin, jran y unuγu. <verse eid="EXO 13:18" /><verse number="19" style="v" sid="EXO 13:19" />yewya muwsa ixsan n yuwsef yiḏes afelxaḍert yedjul y iḥeninin n aṯ israyil bac awyen ixsenis yiḏesen, lemmi yuwa: «rahiy tafenismuqel rebbiy we afenniƹewen aḏ almiy tafγem, awyeṯ iḏuwem ixseniw seg ayuh n mkan.»<verse eid="EXO 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 13:20" />segden seg sekkuwt lliy g miṣr. ggen lmuxeyyem g iṯam af ṭṭerf n ṣṣeḥreṯ. <verse eid="EXO 13:20" /><verse number="21" style="v" sid="EXO 13:21" />ug as yusi lliy diyma yella zzaṯesen g ugeṭṭum n sḥab bac asenisiḵen abriyḏ aḏ g yiḍ g ugeṭṭum n timsi bac asenyeg ddu. <verse eid="EXO 13:21" /><verse number="22" style="v" sid="EXO 13:22" />aḏ wimukesc ageṭṭum n sḥab ug as aḏ ugeṭṭum n timsi g yiḍ seg zzaṯ n midden.<verse eid="EXO 13:22" /></para>
  <chapter eid="EXO 13" />
  <chapter number="14" style="c" sid="EXO 14" />
  <para style="s">aṯ israyil mlayemen g leqbeleṯ n fnaheḥiruwṯ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 14:1" />yuwa lliy diyma yella y muwsa:<verse eid="EXO 14:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 14:2" />«mmel y aṯ israyil aḏulen we amlaymen tman n fnaheḥiruwṯ, jar mejdel aḏ iylel, aḏ g leqbeleṯ n beƹl ṣefuwn aggen lmuxeyyem af cceṭ n iylel. <verse eid="EXO 14:2" /><verse number="3" style="v" sid="EXO 14:3" />bac adyas g lbal n ferƹuwn lliy kennim treḥḥem aḏ witquddemc fγem seg ṣṣeḥreṯ. <verse eid="EXO 14:3" /><verse number="4" style="v" sid="EXO 14:4" />aḏ aseqeṣḥeγ iγef n ferƹuwn bac ayeγ ljurtuwem. we asensiḵneγ mammeḵ niči d meqqar feleḥsabis aḏ feleḥsab n ljiycis. we asennen imiṣriyen lliy neči d lliy diyma yella.» aḏ amyuh reḥḥen israyiliyen al cceṭ n iylel.<verse eid="EXO 14:4" /></para>
  <para style="s">ferƹuwn itezzel deffer aṯ israyil</para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 14:5" />mniyn uwan y lmelek n miṣr: «qa ayuh aṯ israyil rwellen lkul.» nnaḍḍen ferƹuwn aḏ lliy yiḏes g dwiysen, aḏ uwan: «cbineγ zeγ, nsiyeb ičiwenneγ aṯ israyil.» <verse eid="EXO 14:5" /><verse number="6" style="v" sid="EXO 14:6" />yaxy yejra tekerrit yuwya middenis yiḏes. <verse eid="EXO 14:6" /><verse number="7" style="v" sid="EXO 14:7" />iḥerrej set 100 d tikerriṭin n lḥerb aḏ lebqiyeṯ n tkerriṭin n miṣr aḏ yserkeb fellesneṯ lliy tḥereben. <verse eid="EXO 14:7" /><verse number="8" style="v" sid="EXO 14:8" />aḏ yseqṣeḥ lliy diyma yella iγef n ferƹuwn lmelek n miṣr, yeḏbeƹ aṯ israyil lliy ffaγen seg miṣr zzaṯ midden aḏ ixfewnesen al nnaj. <verse eid="EXO 14:8" /><verse number="9" style="v" sid="EXO 14:9" />aḏ yyuren imiṣriyen defferesen s tγallin n ferƹuwn lkul aḏ tikerriṭinis aḏ iterresnis aḏ lejyucis. yaxy iweḍḍenten aḏ nihnin mlaymen tman iylel, leqrebeṯ n fnaheḥiruwṯ g leqbeleṯ n beƹl ṣefuwn.<verse eid="EXO 14:9" /></para>
  <para style="s">muwsa iḍelleb ƹawen n rebbiy</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 14:10" />lemmi yeqrebbed ferƹuwn, smuqlen aṯ israyil yaxy zren imiṣriyen ttezelen defferesen, rjijen s tiwdi aḏ ṣeyḥen ḍlebben g lliy diyma yella atenisemneƹ. <verse eid="EXO 14:10" /><verse number="11" style="v" sid="EXO 14:11" />uwan y muwsa: «yaxy miṣr widdic ljebbeneṯ? maγer tseffeγdaneγ bac anemmuṯ g ṣṣeḥreṯ? imetta tseffeγdaneγ seg miṣr? <verse eid="EXO 14:11" /><verse number="12" style="v" sid="EXO 14:12" />neccin nusi nemmelaḵ g miṣr: &lt; djenneγ d ičiwen y imiṣriyen. &gt; weƹla tedjidaneγ am idin xiyr n tmettent g ṣṣeḥreṯ.» <verse eid="EXO 14:12" /><verse number="13" style="v" sid="EXO 14:13" />yaxy yuwa muwsa y cceƹb: witegeḏec, jreṯ imanuwem, ḥekreṯ mammeḵ tafennisemneƹ lliy diyma yella as uh afelxaḍert imiṣriyen lliy tzarrem disen ṭuruh maƹadc atenezrem xlaṣ. <verse eid="EXO 14:13" /><verse number="14" style="v" sid="EXO 14:14" />rahiy lliy diyma yella tayḥereb g umkanuwem, amma kennim susmeṯ ṭuruh.<verse eid="EXO 14:14" /></para>
  <para style="s">ageṭṭum n sḥab jar aṯ israyil aḏ imiṣriyen</para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 14:15" />yuwa lliy diyma yella y muwsa: «cbiḵ tesugumeḏ g uƹawniw akehaw? yella, mmel y aṯ israyil ayuren. <verse eid="EXO 14:15" /><verse number="16" style="v" sid="EXO 14:16" />qam tereṭṭeḵ tezleḏ fusiḵ siyes al iylel bac atmireḏ we ayuren aṯ israyil g amas n iylel af tammurt. <verse eid="EXO 14:16" /><verse number="17" style="v" sid="EXO 14:17" />qa neči taseqṣeḥeγ ixfewen n imiṣriyen we afenḏebƹen we amγereγ afelḥsab n ferƹuwn we ahelkeγ tikerriṭinis aḏ iterresnis. <verse eid="EXO 14:17" /><verse number="18" style="v" sid="EXO 14:18" />we asennen imiṣriyen lliy neči d lliy diyma yella almiy ameγreγ afelḥsab n ferƹuwn we ahelkeγ tikerriṭinis aḏ iterresnis.»<verse eid="EXO 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 14:19" />mniyn yeḏwel lmleyka n rebbiy lliy yusi yeggur zzaṯ aṯ israyil defferesen, iḥewel ageṭṭum n sḥab defferesen zada. <verse eid="EXO 14:19" /><verse number="20" style="v" sid="EXO 14:20" />aḏ yused ageṭṭum n sḥab jar ljiyc n imiṣriyen aḏ ljiyc n israyiliyen. aḏ netta yusi d tellest af imiṣriyen, d ddu af israyiliyen. aḏ wiyeqrib ḥetta d yjen sisen al ttani yiḍ kamel.<verse eid="EXO 14:20" /></para>
  <para style="s">aṯ israyil qedƹen g iylel zuggaγ</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 14:21" />yezzel muwsa fusis af iylel. aḏ s aḍu d cerqi qewi iduz rebbiy aman al deffer aḏ ysenzeḥ iylel. yeggi abriyḏ g amas n aman. <verse eid="EXO 14:21" /><verse number="22" style="v" sid="EXO 14:22" />yaxy ƹeddan israyiliyen g amas n iylel af tammurt teqṣeḥ aḏ wsiyn aman am ssuwr af limin aḏ uzelmaḍ.<verse eid="EXO 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 14:23" />yaxy iweḍḍenten imiṣriyen aḏ uγen ljurtesen al amas n iylel s tγallin n ferƹuwn aḏ tkerriṭinis aḏ iterresnis. <verse eid="EXO 14:23" /><verse number="24" style="v" sid="EXO 14:24" />qebbel lefjer yesmuqel lliy diyma yella s nnaj ugeṭṭum n sḥab aḏ timsi al imiṣriyen. yaxy uḏeffen beƹeḍhum s tiwdi. <verse eid="EXO 14:24" /><verse number="25" style="v" sid="EXO 14:25" />yerra leƹjali n tkerriṭin wigurnec aḏ imiṣriyen nezγen disneṯ b siyef, almiy uwan: «yya anerwel seg israyiliyen. rahiy lliy diyma yella yetḥarab yiḏesen.»<verse eid="EXO 14:25" /></para>
  <para style="s">temettent n ljeyc n ferƹuwn</para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 14:26" />yuwa lliy diyma yella y muwsa: «zzel fusiḵ af aman, adj aƹamen af imiṣriyen aḏ tkerriṭinesen aḏ iteresnesen.» <verse eid="EXO 14:26" /><verse number="27" style="v" sid="EXO 14:27" />yaxy yezzel muwsa fusis nnaj aman. tajji bekri yeḏwel iylel al umkanis af imiṣriyen lliy wsiyn ruglen bac afγen. lekenti rebbiy ilewḥin g aman. <verse eid="EXO 14:27" /><verse number="28" style="v" sid="EXO 14:28" />ḏwellen aman al mkanesen. seγreqen tikerriṭin aḏ iteresen aḏ ljiyc lkul n ferƹuwn lliy uγen ljurreṯ n aṯ israyil g iylel. aḏ wiyemniƹc sisen ḥetta d yjen. <verse eid="EXO 14:28" /><verse number="29" style="v" sid="EXO 14:29" />amma israyiliyen yyuren af tammurt teqṣeḥ g amas n iylel aḏ wsiyn aman am ssuwr af liminesen aḏ uzelmeḍesen.<verse eid="EXO 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 14:30" />am idin ysemneƹ lliy diyma yella israyiliyen as diyn seg ifesn n imiṣriyen. aḏ zren tisqiḏin n imiṣriyen mluweḥneṯ af cceṭ n iylel. <verse eid="EXO 14:30" /><verse number="31" style="v" sid="EXO 14:31" />lemmi zren israyiliyen mennit nettaṯ temeqqart lquweṯ lliy iḥareb siyes lliy diyma yella imiṣriyen, ugeḏḏen midden seg lliy diyma yella aḏ umennen siyes aḏ s muwsa lƹebdis.<verse eid="EXO 14:31" /></para>
  <chapter eid="EXO 14" />
  <chapter number="15" style="c" sid="EXO 15" />
  <para style="s">muwsa yetsebbeḥ s ulalen</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 15:1" />wembeƹd uḏellen atinyen muwsa aḏ aṯ israyil s ayuh n sebbeḥ y lliy diyma yella aḏ nihnin mmalen:</para>
  <para style="b" vid="EXO 15:1" />
  <para style="q1" vid="EXO 15:1">«ttiniyeγ y lliy diyma yella</para>
  <para style="q2" vid="EXO 15:1">afelxaḍert netta nnaj kul ciy.</para>
  <para style="q2" vid="EXO 15:1">terras aḏ tγaliṯ yluweḥ g iylel.<verse eid="EXO 15:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="EXO 15:2" />lliy diyma yella d lquwtiw.</para>
  <para style="q2" vid="EXO 15:2">y netta diyma taḏinyeγ.</para>
  <para style="q2" vid="EXO 15:2">y rebbiy lliy ysemenƹiḏ tasebḥeγ.</para>
  <para style="q2" vid="EXO 15:2">netta d rebbiyw</para>
  <para style="q2" vid="EXO 15:2">aḏ rebbiy n baba tatƹeḍmeγ.<verse eid="EXO 15:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="EXO 15:3" />lliy diyma yella d lmuḥareb d mqqar;</para>
  <para style="q2" vid="EXO 15:3">lliy diyma yella ismis.<verse eid="EXO 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EXO 15:4" />yluweḥ tikerriṭin n ferƹuwn aḏ ljeycis g iylel.</para>
  <para style="q2" vid="EXO 15:4">yseγreq ṣbiḥen n lguyyadis g iylel zuggaγ.<verse eid="EXO 15:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="EXO 15:5" />hjemen fellasen aman ggeṯ,</para>
  <para style="q2" vid="EXO 15:5">zwan al dday am iḍγaγen.<verse eid="EXO 15:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="EXO 15:6" />mennit qwi fusiḵ n limin,</para>
  <para style="q2" vid="EXO 15:6">ay lliy diyma yella.</para>
  <para style="q2" vid="EXO 15:6">siyes tenγiḏ leƹdu.<verse eid="EXO 15:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="EXO 15:7" />aḏ s lquweṯ n lhibtiḵ</para>
  <para style="q2" vid="EXO 15:7">tṣudiḏ lliy tḥaraben diyeḵ.</para>
  <para style="q2" vid="EXO 15:7">tenkiyeḏ aγeccecciḵ</para>
  <para style="q2" vid="EXO 15:7">tečiten am uču n timsi g sfaf.<verse eid="EXO 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="EXO 15:8" />s ḍuḵ meqqar tlayemeḏ aman</para>
  <para style="q2" vid="EXO 15:8">tsebbedeḏ lemwaj g amas n iylel</para>
  <para style="q2" vid="EXO 15:8">d lmudaf y imiṣriyen.<verse eid="EXO 15:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="EXO 15:9" />yeḏbeƹneγ lƹdu bac aγenyeṭef</para>
  <para style="q2" vid="EXO 15:9">we aγennimukes lliy γarneγ</para>
  <para style="q2" vid="EXO 15:9">we ayebreḏ lγidis</para>
  <para style="q2" vid="EXO 15:9">we aycerƹ ssiyfis.<verse eid="EXO 15:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="EXO 15:10" />tenkiyeḏ aḍuḵ.</para>
  <para style="q2" vid="EXO 15:10">ƹamen fellasen aman.</para>
  <para style="q2" vid="EXO 15:10">aγreqqen am rṣaṣ g tebḥirt.<verse eid="EXO 15:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="EXO 15:11" />ay rebbiy, mam am cek jar irebbiyen?</para>
  <para style="q2" vid="EXO 15:11">mam d meqqar am cek?</para>
  <para style="q2" vid="EXO 15:11">mam yestahel ckar am cek?</para>
  <para style="q2" vid="EXO 15:11">mam yetquddu ayeg lmuƹjizaṯ am cek?<verse eid="EXO 15:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="EXO 15:12" />tezzeleḏ liminiḵ, yaxy tebleƹin tammurt.<verse eid="EXO 15:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="EXO 15:13" />tureseḏ s nnaƹemtiḵ cceƹb lliy tesγit,</para>
  <para style="q2" vid="EXO 15:13">s lqudertiḵ tsiḵendas</para>
  <para style="q2" vid="EXO 15:13">abriyḏ n mkaniḵ temeqdust.<verse eid="EXO 15:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="EXO 15:14" />we aslen midden ttaniyeṯ we aḏegḏen.</para>
  <para style="q2" vid="EXO 15:14">we aterny tiwdi n lliy sekenen g tammurt n felesṭiyn.<verse eid="EXO 15:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="EXO 15:15" />asteγerben imeqqaren n aduwm.</para>
  <para style="q2" vid="EXO 15:15">aḏegḏen lquyyad n muwab,</para>
  <para style="q2" vid="EXO 15:15">we ammuṯen midden n kenƹan lkul s tiwdi.<verse eid="EXO 15:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="EXO 15:16" />tƹam fellesen tiwdi</para>
  <para style="q2" vid="EXO 15:16">jmeḏḏen am iḍγaγen s lqudreṯ n fusiḵ,</para>
  <para style="q2" vid="EXO 15:16">almiy iƹedda cceƹbiḵ</para>
  <para style="q2" vid="EXO 15:16">lliy teṣγit ay lliy diyma yella.<verse eid="EXO 15:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="EXO 15:17" />tatenuwyeḏ, we atenezzuḏ</para>
  <para style="q2" vid="EXO 15:17">g ljbel lliy tuƹeḏḏeḏ siyes</para>
  <para style="q2" vid="EXO 15:17">twezit d mkaniḵ meqdus.<verse eid="EXO 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="EXO 15:18" />lliy diyma yella iḥekm g tduniyeṯ y diyma.»<verse eid="EXO 15:18" /></para>
  <para style="b" />
  <para style="s">ulalen n meryem</para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 15:19" />mniyn uḏefneṯ tγallin n ferƹuwn aḏ tikerriṭinis aḏ iterresnis al iylel, ƹamen fellesen aman. amma aṯ israyil yyuren af tammurt g amasis. <verse eid="EXO 15:19" /><verse number="20" style="v" sid="EXO 15:20" />ḥetta tiseḏnan am irgazen sebḥeneṯ. tqam meryem nnabiyya aḏ nettaṯ d weltmas n haruwn lbendir g fusis, yaxy ḏbeƹenteṯ tiseḏnan lkul s lbnader reqqeṣneṯ aḏ tinineṯ. <verse eid="EXO 15:20" /><verse number="21" style="v" sid="EXO 15:21" />aḏ tusi meryem tetterra fellesneṯ:</para>
  <para style="b" vid="EXO 15:21" />
  <para style="q2" vid="EXO 15:21">«inimeṯ y rebbiy afelxaḍert netta nnaj kul ciy,</para>
  <para style="q2" vid="EXO 15:21">tγelliṯ aḏ uterras yluweḥ g iylel.»<verse eid="EXO 15:21" /></para>
  <para style="s">aman lliy izayen g ṣṣeḥreṯ n cuwr</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 15:22" />wembeƹd yerzef muwsa s aṯ israyil seg iylel zuggaγ aḏ reḥḥen al ṣṣeḥreṯ n cuwr. qqimen gguren diyes 3 d ussanaṯ lekinti wiḏufinc aman. <verse eid="EXO 15:22" /><verse number="23" style="v" sid="EXO 15:23" />lemmi uṣellen al mara wiquddenc aswen amanis afelxaḍert izeyen. aḏ semmenteṯ mara. <verse eid="EXO 15:23" /><verse number="24" style="v" sid="EXO 15:24" />yaxy xernennen midden af muwsa uwan «matta tansu?»<verse eid="EXO 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 15:25" />yeḍleb muwsa lliy diyma yella. yaxy isiḵnas ccejreṯ. yluweḥ muwsa sγer siyes g aman, ḏwellen d leḥlu. aḏ dinet yeggi rebbiy y midden cceriyƹeṯ aḏ lesbar aḏ limtiḥan. <verse eid="EXO 15:25" /><verse number="26" style="v" sid="EXO 15:26" />yuwa: «kan teslim dwiyw neči lliy d rebbiywem, aḏ teggim lliy netta d lḥeq zzaṯiw, aḏ teḏbeƹem luwṣayaṯiw, aḏ testeḥefdem af lefreyḍiw lkul, tafensemenƹeγ seg ṭṭan lliy wetteγ siyes imiṣriyen. rahiy neči d rebbiy lliy afeniseḥla.» <verse eid="EXO 15:26" /><verse number="27" style="v" sid="EXO 15:27" />wembeƹd uṣellen al iyliym mani diyes 12 d ṭiṭawin aḏ 70 d tiγliwin. ggen lmuxeyyem tman ṭiṭawin n aman.<verse eid="EXO 15:27" /></para>
  <chapter eid="EXO 15" />
  <chapter number="16" style="c" sid="EXO 16" />
  <para style="s">midden txernenen af muwsa g ṣṣeḥreṯ n siyna</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 16:1" />ḥewlen aṯ israyil seg iyliym. aḏ uḏeffen al ṣṣeḥreṯ n siyna jar iyliym aḏ jbel n siynay g as n zgen n cehher wi 2 g usuggas, beƹd ifaγesen seg miṣr. <verse eid="EXO 16:1" /><verse number="2" style="v" sid="EXO 16:2" />g aydin n ṣṣeḥreṯ xernennen israyiliyen af muwsa aḏ haruwn. <verse eid="EXO 16:2" /><verse number="3" style="v" sid="EXO 16:3" />aḏ uwanas: «texsem aγentenγem? weƹla lliy diyma yella yenγeneγ g tammurt n miṣr. γaḍih nusi netgeƹmaz tman tinḥasin n yssum aḏ nettat aγrum almiy necbeƹ. qa kennim tseffeγmaneγ seg miṣr al ṣṣeḥreṯ bac aγentenγem s llaz.»<verse eid="EXO 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 16:4" />yaxy yuwa lliy diyma yella y muwsa: «qa neči tasezwiγ fellewem anzar n aγrum seg ujenna. we abyen midden lliy yelzemmasen y kul as weḥdes. amyuh tatenjerbeγ, we aḥekreγ yenda tayuren g ubriḏiw naγ aha. <verse eid="EXO 16:4" /><verse number="5" style="v" sid="EXO 16:5" />aḏ g as 6, almiy taggen man ačan, atefen deqqes mertin n lliy tleyement kul as.»<verse eid="EXO 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 16:6" />yaxy uwan muwsa aḏ haruwn y midden n aṯ israyil lkul: «temeddiṯ tesnem lliy lliy diyma yella d netta lliy ysefγawem seg tammurt n miṣr. <verse eid="EXO 16:6" /><verse number="7" style="v" sid="EXO 16:7" />tajji tazrem lquweṯ n lliy diyma yella, afelxaḍert yesla xernennuwem fellas. rahiy af lliy diyma yella tetxernennem muc fellenneγ. d mam neccin bac axernennem fellenneγ.» <verse eid="EXO 16:7" /><verse number="8" style="v" sid="EXO 16:8" />yuwa zada: «qa kennim tasnem lliy netta d lliy diyma yella almiy afenyuc yessum temeddiṯ bac ačam aḏ aγrum tajji bac acebƹem. netta yesla xernennuwem fellas, d matta neccin? rahiy kennim tetxernennem af lliy diyma yella.»<verse eid="EXO 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 16:9" />afelxaḍert ayuh yuwa muwsa y haruwn: «mmel y aṯ israyil abedden zzaṯ lliy diyma yella.» <verse eid="EXO 16:9" /><verse number="10" style="v" sid="EXO 16:10" />aḏ lemmi yusi haruwn ydugga y midden n aṯ israyil smuqlen al ṣṣeḥreṯ, yaxy zren lmejd n lliy diyma yella yeḍherred g sḥab.<verse eid="EXO 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 16:11" />yuwa lliy diyma yella y muwsa <verse eid="EXO 16:11" /><verse number="12" style="v" sid="EXO 16:12" />«sliγ xernen n aṯ israyil, mlasen: temeddiṯ tačam yessum aḏ tajji tacebƹem seg aγrum. we asnem lliy neči d lliy diyma yella n ddunyeṯ aḏ rebbiywem.»<verse eid="EXO 16:12" /></para>
  <para style="s">aγrum n lmen aḏ yessum n sselwa</para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 16:13" />tmeddiṯ diyn usented timelliwin n sselwa čurneṯ lmuxeyyem bac atentečen midden. aḏ g tajji tuḏen ndaweṯ tammurt lliy tenneḍ siyes. <verse eid="EXO 16:13" /><verse number="14" style="v" sid="EXO 16:14" />aḏ lemmi tmukes ndaweṯ, fehhen midden. rahiy yeqqim uḏem n tammurt yuḏen s ḥaja tewerqiqt ggeṯ am tqecra aḏ temelelt am ṯṯelj. <verse eid="EXO 16:14" /><verse number="15" style="v" sid="EXO 16:15" />aḏ lemmi zrent aṯ israyil, uwan y beƹeḍhum: &lt; menhu. &gt; yeƹni: &lt; d matta ayuh?&gt; afelxaḍert wisinenc d matta. yaxy yuwayasen muwsa: «ayuh d aγrum n lliy diyma yella lliy yucawemtiḏ bac atečem. <verse eid="EXO 16:15" /><verse number="16" style="v" sid="EXO 16:16" />yuweyawem lliy diyma yella: &lt; kul yjen ayebbi siyes lliy yelzemmas; y kul yjen lgelbeṯ af leḥsab n middenis lliy dderen yiḏes g lƹectis. &gt; »<verse eid="EXO 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 16:17" />ggen aṯ israyil mammeḵ yuwa rebbiy. yella sisen mam yebbi ggeṯ aḏ sisen mam yebbi fercu. <verse eid="EXO 16:17" /><verse number="18" style="v" sid="EXO 16:18" />lekenti lemmi keylent s lgelbeṯ, widyefdilc y mam yebbi ggeṯ aḏ wiyxeṣc y mam yebbi fercu. yebbi kul yjen matta yetet gedged.<verse eid="EXO 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 16:19" />yuwayasen muwsa: «ḥetta d yjen wiyetḥerzi siyes al tajji.» <verse eid="EXO 16:19" /><verse number="20" style="v" sid="EXO 16:20" />aḏ yella mam wiyeslic dwiy n muwsa aḏ ifeddel siyes al tajji. yaxy yeggi tiketcawin, yerci. iγeccec fellasen muwsa. <verse eid="EXO 16:20" /><verse number="21" style="v" sid="EXO 16:21" />aḏ yusi kul yjen yettebbi tajji lliy yelzemmas. aḏ almiy atezγel tufuyt ayḏab lliy yefdelled seg lmen af tammurt.<verse eid="EXO 16:21" /></para>
  <para style="s">uču n as n sebbeṯ</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 16:22" />aḏ g as 6 wsiyn tebyen aγrum mertin deqqes n kul as, yeƹni gelbtin y kul yjen. aḏ usend imeqqaren n aṯ israyil ƹewden y muwsa lliy zrent. <verse eid="EXO 16:22" /><verse number="23" style="v" sid="EXO 16:23" />yaxy yuwayasen: «yemmal lliy diyma yella: ača taydel d as n rraḥeṯ, d sebbeṯ d meqdus y lliy diyma yella. ggeṯ aγrum lliy yelzemmewem, teserγem lliy ikeffeyewem. aḏ lliy yefdelled siyes djet al tajji.»<verse eid="EXO 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 16:24" />aḏ lliy djent siyes al tajji mammeḵ yuwa muwsa, wiyercic, aḏ wiyeggic tikečawin. <verse eid="EXO 16:24" /><verse number="25" style="v" sid="EXO 16:25" />yuwa muwsa: «as uh, čeṯ ayuh lliy yefdelled. rahiy as uh d sebbeṯ d meqdus y lliy diyma yella aḏ witettifemc diyes uču af tammurt. <verse eid="EXO 16:25" /><verse number="26" style="v" sid="EXO 16:26" />6 d ussanaṯ atebbiyem. aḏ as wis 7 d sebbeṯ aḏ witettifemc diyes uču.»<verse eid="EXO 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 16:27" />lekenti diyes midden sisen ffeγen bac abyen. yaxy wiḏufin ḥaja. <verse eid="EXO 16:27" /><verse number="28" style="v" sid="EXO 16:28" />wembeƹd yuwa lliy diyma yella y muwsa: «al lemmi taqimen witetteggenc ayuh n midden s luwṣayaṯ n cceriyƹeṯiw? <verse eid="EXO 16:28" /><verse number="29" style="v" sid="EXO 16:29" />ḥekreṯ, neči ggiγawem as n sebbeṯ d rreḥeṯ. rahiy ttucγawem as 6 aγrum deqqes mertin n ussan ttenyaṯ. as wis 7 yexs ayeqqim kul yjen g umkanis aḏ witeffeγc siyes.» <verse eid="EXO 16:29" /><verse number="30" style="v" sid="EXO 16:30" />yaxy riḥen midden as 7.<verse eid="EXO 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 16:31" />aḏ semman aṯ israyil ayuh n uču d &lt;lmen. &gt; aḏ yusi d mellal am tḥebuṯin n jelejlan. aḏ lmeṭeƹmis am tqurset s tamemt. <verse eid="EXO 16:31" /><verse number="32" style="v" sid="EXO 16:32" />yuwa muwsa: «yemmal rebbiy: &lt; steḥefdeṯ af čariṯ n lgelbeṯ siyes bac azren imeckenuwem aγrum lliy sečγewemtiḏ g ṣṣeḥreṯ mniyn seffeγγewem seg tammurt n miṣr. &gt; »<verse eid="EXO 16:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 16:33" />yuwa muwsa y haruwn: «awi teƹbert teggeḏ diyes deqqes n lgelbeṯ seg lmen. teggetteṯ zzaṯ lliy diyma yella bac atdel teḥrez y lejyaluwem.» <verse eid="EXO 16:33" /><verse number="34" style="v" sid="EXO 16:34" />mammeḵ yuwa lliy diyma yella y muwsa, yused as lliy diyes yeggiṯ haruwn tman n luwṣayaṯ bac asteḥefden fellas. <verse eid="EXO 16:34" /><verse number="35" style="v" sid="EXO 16:35" />dderen israyiliyen af lmen 40 d isuggasen almiy dusen al leḍraf n kenƹan lliy diyes ssukkan. <verse eid="EXO 16:35" /><verse number="36" style="v" sid="EXO 16:36" />aḏ lgelbeṯ netta d leƹcur n layfa.<verse eid="EXO 16:36" /></para>
  <chapter eid="EXO 16" />
  <chapter number="17" style="c" sid="EXO 17" />
  <para style="s">aman tefγen seg teḍγeγt</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 17:1" />ḥewlen aṯ israyil g ṣṣeḥreṯ n siyna. gguren tbeddan mammeḵ yexs lliy diyma yella almiy ggen lmuxeymesen g rafidim mani wiḏufinc man aswen. <verse eid="EXO 17:1" /><verse number="2" style="v" sid="EXO 17:2" />yaxy mxeṣmen midden yid muwsa uwanas: «ucaneγ aman y tissi. muc cek temeleḏ: &lt; rebbiy yella iḏenneγ. &gt; » yerrasen muwsa: «maγer tetxaṣamem diyi? aḏ maγer tetjerbem g lliy diyma yella.»<verse eid="EXO 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 17:3" />γaḍih xernennen midden af muwsa afelxaḍert wsiyn ffuḏen: «maγer tsefeγdeneγ seg miṣr? yenda bac aγentenγeḏ dehnit neccin aḏ ṭarwiwiṯenneγ aḏ zwayelenneγ s ffeḏ.» <verse eid="EXO 17:3" /><verse number="4" style="v" sid="EXO 17:4" />yaxy izewek muwsa yuwa y lliy diyma yella: «matta aggeγ yid ayuh n midden? rahiy ḥeḍerbac talḥedfen s iḍγaγen.»<verse eid="EXO 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 17:5" />yerras lliy diyma yella: «yyur zzaṯ midden. we areḥen iḏeḵ lbeƹḍ n iwessaren seg aṯ israyil. aḏ yexs aqemeḏ tereṭṭeḵ lliy twetteḏ siyes lwaḏ. <verse eid="EXO 17:5" /><verse number="6" style="v" sid="EXO 17:6" />qa neči bbeddeγ zzaṯiḵ af teḍγeγt g ḥuwrib. awet teḍγeγt afγen siyes aman bac aswen midden.» aḏ am idin yeggi muwsa zzaṯ iwessaren n aṯ israyil. <verse eid="EXO 17:6" /><verse number="7" style="v" sid="EXO 17:7" />semman mkan diyn messeh aḏ meribeh, yeƹni limtiḥan aḏ lxasem, afelxaḍert jerben lliy diyma yella lemmi uwan: «zeƹma lliy diyma yella yella jarenneγ naγ aha.»<verse eid="EXO 17:7" /></para>
  <para style="s">israyiliyen rbaḥen iƹemlaqen</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 17:8" />usend iƹemlaqen bac aḥarben israyiliyen g rafidim. <verse eid="EXO 17:8" /><verse number="9" style="v" sid="EXO 17:9" />yaxy yuwa muwsa y yjen seg irgazenis yecuwƹ: «weza iterrasen seg midden bac areḥen aḥerben iḏeḵ iƹemlaqen. aḏ qa neči tabeddeγ ača af iγef n ddehreṯ aḏ tereṭṭa n lmuƹjizaṯ g ufusiw.» <verse eid="EXO 17:9" /><verse number="10" style="v" sid="EXO 17:10" />iḥareb yecuwƹ iƹemlaqen mammeḵ yuwa muwsa. amma muwsa aḏ haruwn aḏ yjen ismis ḥuwr uliyen nnaj ddehreṯ. <verse eid="EXO 17:10" /><verse number="11" style="v" sid="EXO 17:11" />almiy muwsa ayqam fusis arebḥen israyiliyen, lekinti almiy aysezwa fusis arebḥen iƹemlaqen. <verse eid="EXO 17:11" /><verse number="12" style="v" sid="EXO 17:12" />mniyn yeƹya muwsa, qamen haruwn aḏ ḥuwr aḍγaγ ggenestiḏ bac aygeƹmez fellas. aḏ rfeḏḏen y ifesnis; kul yjen yerfeḏ y yeffus. aḏ amyuh qqimen ifesnis zzelen al ina n teffuyt. <verse eid="EXO 17:12" /><verse number="13" style="v" sid="EXO 17:13" />yaxy yerbeḥ yecuwƹ iƹemlaqen aḏ ljiycesen s ssiyf.<verse eid="EXO 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 17:14" />yuwa lliy diyma yella y muwsa: «ri ayuh bac witettunc midden. taƹezmet af yecuwƹ. rahiy takseγ iƹemlaqen seg lduniyeṯ.» <verse eid="EXO 17:14" /><verse number="15" style="v" sid="EXO 17:15" />yeggi muwsa mkan n teγrest y lliy diyma yella. ysemmayi: «lliy diyma yella nesi.» yeƹni: «lliy diyma yella d leƹlemmiw.» <verse eid="EXO 17:15" /><verse number="16" style="v" sid="EXO 17:16" />yuwa: «afelxaḍert yella mam icereƹ fusis af lliy diyma yella, lliy diyma yella tayḥareb iƹemlaqen ljiyl beƹd ljiyl.»<verse eid="EXO 17:16" /></para>
  <chapter eid="EXO 17" />
  <chapter number="18" style="c" sid="EXO 18" />
  <para style="s">yeṯruwn nsib n muwsa yused bac ayṭul fellas</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 18:1" />yeṯruwn lkahen n midyan, aḏ nsib n muwsa yesla mag yeggi lliy diyma yella y muwsa aḏ cceƹbis, aḏ mammeḵ iṣefγin seg miṣr. <verse eid="EXO 18:1" /><verse number="2" style="v" sid="EXO 18:2" />yuwya ṣefuwra lehlis n muwsa lliy yusi yerriṯ al babis. <verse eid="EXO 18:2" /><verse number="3" style="v" sid="EXO 18:3" />aḏ yiḏes ṭarwas s sen, yjen ismis jircuwm aḏ lmeƹnas d aγrib afelxaḍert muwsa yuwa: «usiγ sekneγ g tammurt aγriba.» <verse eid="EXO 18:3" /><verse number="4" style="v" sid="EXO 18:4" />aḏ ysem n wissen liƹazer aḏ lmeƹnas. &lt;lliy diyma yella yetƹawen diyi. &gt; afelxaḍert muwsa yuwa: «rebbiy n baba iƹewniḏ aḏ ysemenƹiḏ seg ssiyf n ferƹuwn.»<verse eid="EXO 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 18:5" />yused yeṯruwn, nsib n muwsa, al lmuxeyyem tman jbel n rebbiy. yuγesd ṭarwas aḏ lehlis. <verse eid="EXO 18:5" /><verse number="6" style="v" sid="EXO 18:6" />yenkiy y muwsa mam yuwayas: «neči d nsibiḵ. usiγd aḏ iḏiy ṭarwaḵ aḏ lehliḵ.»<verse eid="EXO 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 18:7" />yaxy muwsa ireḥ fiseƹ bac ayeƹreḍ y nsibis. aḏ iṭebbes zzaṯis, ibeḥbayi, ysesten kul yjen sisen ttani af leḥwal. aḏ ƹeddan al lƹecceṯ. <verse eid="EXO 18:7" /><verse number="8" style="v" sid="EXO 18:8" />yuwa muwsa y nsibis af mag yeggi lliy diyma yella g ferƹuwn aḏ imiṣriyen bac aysemneƹ israyiliyen, aḏ af tƹeb lliy zrent g ubriḏ, aḏ mammeḵ ysemenƹin lliy diyma yella siyes.<verse eid="EXO 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 18:9" />mniyn yesla yeṯruwn aydin, yefreḥ lliy rebbiy yeggi lxiyr y aṯ israyil aḏ ysemenƹin seg ifesn n imiṣriyen. <verse eid="EXO 18:9" /><verse number="10" style="v" sid="EXO 18:10" />yuwa yeṯruwn: «aynumer lliy diyma yella lliy ysemenƹewem seg ifesn n imiṣriyen aḏ n ferƹuwn, aḏ yseffeγ cceƹb s adug imiṣriyen. <verse eid="EXO 18:10" /><verse number="11" style="v" sid="EXO 18:11" />aḏ ṭuruh sseneγ lliy lliy diyma yella d meqqar iṭer n irebbiyen lkul, afelxaḍert iƹeqb imiṣriyen s lqudretis mniyn wsiyn ḍelmen g israyiliyen.» <verse eid="EXO 18:11" /><verse number="12" style="v" sid="EXO 18:12" />yeṯruwn nsib n muwsa yeγres man ayeḥreq y rebbiy aḏ yeγressas man ačan. yaxy usend haruwn aḏ iwessaren n aṯ israyil al nsib n muwsa bac ačan yiḏes zzaṯ lliy diyma yella.<verse eid="EXO 18:12" /></para>
  <para style="s">muwsa yeggi s dwiy n nsibis aḏ iwaza lḥukkam</para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 18:13" />tajji ygeƹmez muwsa weḥdes bac ayeḥkem jar midden lliy qqimen. ssugumen s tajji al tmeddiṯ. <verse eid="EXO 18:13" /><verse number="14" style="v" sid="EXO 18:14" />mniyn yezra nsibis aydin yuwayas: «matta tetteggeḏ g midden? maγer tetgeƹmezeḏ weḥdeḵ bac aḥekmeḏ jaresen? aḏ midden tγiman γareḵ s tajji al tmeddiṯ.»<verse eid="EXO 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 18:15" />yerras muwsa: «afelxaḍert midden ttesend al γari bac asennen matta yexs lliy diyma yella ateggen. <verse eid="EXO 18:15" /><verse number="16" style="v" sid="EXO 18:16" />aḏ lemmi yuqeƹ jaresen nuγu ttesniḏ bac aḥekmeγ jaresen we asensiḵneγ cceriyƹeṯ n rebbiy.»<verse eid="EXO 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 18:17" />yaxy yuwa nsibis.</para>
  <para style="p" vid="EXO 18:17">«amyuh muc d ṣbiḥ. <verse eid="EXO 18:17" /><verse number="18" style="v" sid="EXO 18:18" />rahiy taƹyiḏ cek aḏ ayuh n midden lliy iḏeḵ. ayuh ggeṯ fellaḵ, witetqudduc ateggeḏ weḥdeḵ. <verse eid="EXO 18:18" /><verse number="19" style="v" sid="EXO 18:19" />ṣeγdiḏ afemleγ af nṣiḥtiw, rebbiy afiƹawen. yexs adleḏ d mersul jar rebbiy aḏ midden bac asetseṣlleḏ ckeyaṯesen. <verse eid="EXO 18:19" /><verse number="20" style="v" sid="EXO 18:20" />seḥefdasen lwajeb aḏ cceriyƹeṯis, tsiḵendasen abriyḏ lliy yexs ayuren diyes aḏ matta yexs ggen.<verse eid="EXO 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 18:21" />aḏ waza seg cceƹb irgazen γarsen lhibeṯ aḏ ssenen lliy diyma yella aḏ ttegeḏen siyes aḏ widemƹenc bac ateneggeḏ af ixfawen n luluf aḏ almiyyaṯ aḏ txemsinin aḏ tƹecreyin. <verse eid="EXO 18:21" /><verse number="22" style="v" sid="EXO 18:22" />we aḥekmen jar midden g iḥajeyen imeckunen diyma. amma ckayaṯ timeqqarin aftendaγen. rahiy amyuh tasenekzen fellaḵ tƹeb. <verse eid="EXO 18:22" /><verse number="23" style="v" sid="EXO 18:23" />kan teggiḏ amyuh aḏ mammeḵ yexs rebbiy, aquddeḏ aggeḏ lxeḏemtiḵ lkul we arewḥen midden labas ƹlihum.»<verse eid="EXO 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 18:24" />yesla muwsa nṣiḥeṯ n nsibis. yeggi matta yuwayas. <verse eid="EXO 18:24" /><verse number="25" style="v" sid="EXO 18:25" />aḏ iwaza seg israyiliyen irgazen d ṣbiḥen. yeggin af ixfewen n luluf aḏ almiyyaṯ aḏ txemsinin aḏ tƹecreyin. <verse eid="EXO 18:25" /><verse number="26" style="v" sid="EXO 18:26" />wsiyn ḥekmen jar midden g ckayaṯ timeckunin aḏ ugayen al muwsa tindin lliy uƹerneṯ fellesen.<verse eid="EXO 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 18:27" />wembeƹd yceyyeƹ muwsa nsibis. yeḏwel al tammurtis.<verse eid="EXO 18:27" /></para>
  <chapter eid="EXO 18" />
  <chapter number="19" style="c" sid="EXO 19" />
  <para style="s">muwsa aḏ midden uṣellen al adug n jbel siynay</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 19:1" />mniyn yluled yyur wi 3 beƹd iffeγ seg tammurt n miṣr uṣellen al lexla n siynay. <verse eid="EXO 19:1" /><verse number="2" style="v" sid="EXO 19:2" />ffeγen israyiliyen seg rafidim usend al dinet. aḏ ggen lmuxeymesen adug jbel. <verse eid="EXO 19:2" /><verse number="3" style="v" sid="EXO 19:3" />ireḥ muwsa bac ayezel y rebbiy. yaxy yesγuyas lliy diyma yella seg jbel: «amyuh amleḏ y midden n aṯ israyil, ṭarwa n yeƹquwb:<verse eid="EXO 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 19:4" />tezrim s ṭiṭewinuwem matta ggiγ g miṣr, aḏ mammeḵ sefγawem siyes. aḏ rriγ rrelbaliw fellawem al deh mammeḵ tteren lbizan lbalisen af terwiwiṯesen lliy ḥefden g taḍuri. <verse eid="EXO 19:4" /><verse number="5" style="v" sid="EXO 19:5" />rahiy ddunyeṯ lkul nnuw. kan kennim tsellem dwiyw aḏ teteggem s lƹehdiw, tadlem y neči weḥdi mendun midden lkul. <verse eid="EXO 19:5" /><verse number="6" style="v" sid="EXO 19:6" />we adlem y neči d lmemelkeṯ n lkuhhan aḏ d lummeṯ temeqdust. ayuh d dwiy lliy yexs atemleḏ y aṯ israyil.»<verse eid="EXO 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 19:7" />aḏ yesγuy muwsa y iwessaren n aṯ israyil, yeƹzem fellesen lliy iweṣṣeyi siyes lliy diyma yella. <verse eid="EXO 19:7" /><verse number="8" style="v" sid="EXO 19:8" />yaxy uwan midden: «taneg lliy yuwayaneγ felles lliy diyma yella lkul.» isaṣel muwsa dwiysen y lliy diyma yella.<verse eid="EXO 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 19:9" />yuwa lliy diyma yella y muwsa: «qa neči tadezwiγ g sḥab d ṣeṭṭaf we afuflayeγ bac aleslen midden we aḏemnen siyeḵ diyma,.» yaxy isaṣel muwsa dwiy n midden al lliy diyma yella tijekkelt iḍen.<verse eid="EXO 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 19:10" />yuwayas lliy diyma yella.</para>
  <para style="p" vid="EXO 19:10">«ureḥ al midden temeldasen azizdiyen as uh aḏ ača, we asirden leḥweyjesen <verse eid="EXO 19:10" /><verse number="11" style="v" sid="EXO 19:11" />bac aseḥedren imenesen y as wi 3 afelxaḍert g as wi 3 tazwiγ zzaṯ midden nnaj jbel n siynay.<verse eid="EXO 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 19:12" />teggeḏ lḥed yenneḍ af jbel bac witƹeddinc midden. temeldasen: &lt; rreṯ lbaluwem witelyic al jbel, aḏ witeṭfec diyes. &gt; rahiy kul yjen ayeṭṭef diyes ayemmuṯ. <verse eid="EXO 19:12" /><verse number="13" style="v" sid="EXO 19:13" />kul yjen seg midden naγ seg zwayel yeṭṭef diyes, yexs ateḥedfen s iḍγaγen naγ s sham almiy ayemmuṯ aḏ witneγγenc s ifesnesen. aḏ lemmi ayemmusel lḥes n lbuwq, atenedjeḏ aqerben al jbel.»<verse eid="EXO 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 19:14" />aḏ beƹd mag yezwa muwsa seg jbel al midden isizdyin. aḏ sirden leḥweyjesen. <verse eid="EXO 19:14" /><verse number="15" style="v" sid="EXO 19:15" />yuwayasen: «seḥedreṯ imanuwem y as wi 3 aḏ witeṭfeṯc g tseḏnanuwem.»<verse eid="EXO 19:15" /></para>
  <para style="s">muwsa aḏ midden bbedden adug jbel</para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 19:16" />g as wis 3 tajji yused rreƹd aḏ lberqa d meqqar. aḏ yezwad sḥab yerdem af jbel. aḏ yemmusel lḥes d meqqar n lbuwq. yaxy rjijen midden lkul lliy g lmuxeyyem. <verse eid="EXO 19:16" /><verse number="17" style="v" sid="EXO 19:17" />yseffeγ muwsa midden seg lmuxeyyem bac abedden adug jbel we alaqen rebbiy. <verse eid="EXO 19:17" /><verse number="18" style="v" sid="EXO 19:18" />aḏ yusi jbel n siynay yuḏen lkul s dduxan afelxaḍert lliy diyma yella yezwa felles g amas n timsi. aḏ yuliyed dduxanis am dduxan n tfuwrent. aḏ yerjij jbel lkul ggeṯ. <verse eid="EXO 19:18" /><verse number="19" style="v" sid="EXO 19:19" />mniyn yerniy lḥes n lbuwq, yusi muwsa ydugga y rebbiy, aḏ yeterrayas rebbiy s rreƹd.<verse eid="EXO 19:19" /></para>
  <para style="s">lliy dima yella yesγuy y muwsa bac ayeli al jbel</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 19:20" />mniyn yezwa lliy diyma yella af iγef n jbel n siynay, yesγuy y muwsa bac ayeli af iγef n jbel. yaxy yuliyas. <verse eid="EXO 19:20" /><verse number="21" style="v" sid="EXO 19:21" />yuwayas lliy diyma yella: «zwa al midden tedjuleḏ disen bac witteliyenc y tmezriwtiw af jbel. kan uliyen. rahiy tamuṯen sisen ggeṯ. <verse eid="EXO 19:21" /><verse number="22" style="v" sid="EXO 19:22" />aḏ lkuhhan lliy taqerben al γari, nihnin zada yexs azizdiyen, naγ atenenγeγ.»<verse eid="EXO 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 19:23" />yaxy yuwa muwsa y lliy diyma yella: «witquddunc midden aḏelyen al jbel n siynay afelxaḍert cek tluzdaneγ aneg leḥduḏ af jbel bac wistƹeddinc.» <verse eid="EXO 19:23" /><verse number="24" style="v" sid="EXO 19:24" />yaxy yerras lliy diyma yella: «zwa teselyeḏ uwaḵ haruwn iḏeḵ, amma midden aḏ lkuhhan wiltelyenc naγ atenenγeγ.»<verse eid="EXO 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 19:25" />yezwa muwsa al midden, yuwayasen matta yuwa rebbiy.<verse eid="EXO 19:25" /></para>
  <chapter eid="EXO 19" />
  <chapter number="20" style="c" sid="EXO 20" />
  <para style="s">10 n luwṣayaṯ zweneṯ s rebbiy af muwsa</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 20:1" />yuwa rebbiy ayuh n dwiy lkul:<verse eid="EXO 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 20:2" />«neči d lliy diyma yella, rebbiyḵ lliy ysefγaḵ seg tammurt n miṣr, mani tusid txedmeḏ am ačiw.<verse eid="EXO 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 20:3" />witegc irebbiyen iḍen zzaṯiw.<verse eid="EXO 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 20:4" />witegc ṣembeṯ y cekkin seg iḥejeyen lliy llan g ujenna nnaj, naγ n lliy llan g tammurt dday, naγ n lliy llan g aman adug tammurt. <verse eid="EXO 20:4" /><verse number="5" style="v" sid="EXO 20:5" />wisejeḏc y nihintin, aḏ wisentzellec afelxaḍert d neči d rebbiy, rebbiyḵ. rahiy neči d ḥezzar atƹeqabeγ g imeckenen af ubekkeḍu n ibabenesen lliy wilγisen al ljiyl wi 3 aḏ wis 4 . <verse eid="EXO 20:5" /><verse number="6" style="v" sid="EXO 20:6" />we aḏuceγ nnaƹmeṯ y 1000 n lejyal seg midden lliy xsenniḏ aḏ teggen s dwiyw.<verse eid="EXO 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 20:7" />witjellac am idin s ismiw neči rebbiyḵ. rahiy atƹaqbeγ lliy yetjella s ismiw am idin.<verse eid="EXO 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 20:8" />yexs adesmitid as n sebbeṯ, we atqedseḏ y rebbiy. <verse eid="EXO 20:8" /><verse number="9" style="v" sid="EXO 20:9" />6 d ussanaṯ axedmeḏ, we aggeḏ disen lecγaliḵ lkul. <verse eid="EXO 20:9" /><verse number="10" style="v" sid="EXO 20:10" />amma as 7 ateggeḏ d sebbeṯ y neči, rebbiyḵ, witeg diyes ḥetta d lxeḏmeṯ, cek aḏ memmiḵ aḏ yelliḵ aḏ ačiwiḵ aḏ tečiwtiḵ aḏ zeyeltiḵ aḏ lliy seknen γareḵ, <verse eid="EXO 20:10" /><verse number="11" style="v" sid="EXO 20:11" />numreγ as n sebbeṯ aḏ ggixt d meqdus. rahiy neči ggiγ jenna aḏ tammurt aḏ iylel aḏ lliy disen lkul g 6 d ussanaṯ aḏ reyḥeγ g as 7.<verse eid="EXO 20:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 20:12" />agg teṣbiḥt y babiḵ aḏ yedjiḵ bac adreḏ ggeṯ g tammurt lliy tafteduciγ neči, rebbiyḵ.<verse eid="EXO 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 20:13" />wineγc<verse eid="EXO 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 20:14" />wizennac<verse eid="EXO 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 20:15" />witeḵerc<verse eid="EXO 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 20:16" />wiceheḏc s tkerkas af ljariḵ<verse eid="EXO 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 20:17" />widemmeƹc g lḥuc n ljariḵ naγ g lehlis naγ g ačiwis naγ g tečiwtis naγ g fwunesis naγ g aγyulis naγ g ḥaja seg lliy γares.»<verse eid="EXO 20:17" /></para>
  <para style="s">midden ugeḏḏen asenyuflay rebbiy</para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 20:18" />mniyn zren midden lberq aḏ dduxan af jbel, aḏ slen rreƹd aḏ lḥes n lbuwq, rjijen s tiwdi aḏ bbedden s yebƹeḏ. <verse eid="EXO 20:18" /><verse number="19" style="v" sid="EXO 20:19" />aḏ uwan y muwsa: «uflayeneγ cek. qa neseγda diyeḵ. kan yeqqim rebbiy yduggeyeneγ. rahiy tanemmuṯ s tiwdi.»<verse eid="EXO 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 20:20" />yaxy yerrasen muwsa: «wittegeṯec. rahiy rebbiy yused bac afenijerreb, we asnem lqutis bac witγeldemc.» <verse eid="EXO 20:20" /><verse number="21" style="v" sid="EXO 20:21" />aḏ mniyn wsiyn midden bbedden s yebƹeḏ, yeqreb muwsa al tellest teṣeṭṭeft mani yusi rebbiy<verse eid="EXO 20:21" /></para>
  <para style="s">lebni n mkan n teγrest d ṣeyyeḥ</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 20:22" />aḏ yuwa lliy diyma yella y muwsa</para>
  <para style="p" vid="EXO 20:22">«saṣel dwiyw al aṯ israyil: kennim tezrim s ṭiṭewinuwem mammeḵ ufleyγawem seg ujenna. <verse eid="EXO 20:22" /><verse number="23" style="v" sid="EXO 20:23" />maƹedc ggem irebbiyen seg lfejreṯ naγ seg wureγ bac asentezellem iḏiy.<verse eid="EXO 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 20:24" />gtiḏ mkan n teγrest seg ijdi, bac aγersem fellas man aḥerqem aḏ teγrest n slemeṯ seg tulliwem aḏ ifwunesenuwem. we afendeseγ we afennumreγ g imkanen lkul lliy taggeγ disen mam ayenṭeq s ismiw. <verse eid="EXO 20:24" /><verse number="25" style="v" sid="EXO 20:25" />aḏ kan teggimiḏ mkan n teγrest seg iḍγaγen, witteggec seg iḍγaγen wejhen. rahiy almiy twejhetten tanejsen. <verse eid="EXO 20:25" /><verse number="26" style="v" sid="EXO 20:26" />aḏ witteggec druj y mkan n teγrest bac aḏelyem siyes naγ aqimem d iƹeryanen fellas.»<verse eid="EXO 20:26" /></para>
  <chapter eid="EXO 20" />
  <chapter number="21" style="c" sid="EXO 21" />
  <para style="s">leḥkam n ičiwen</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 21:1" />«ayuh d lesbar lliy yexs aggen aṯ israyil sisen. <verse eid="EXO 21:1" /><verse number="2" style="v" sid="EXO 21:2" />kan γareḵ ačiw d ƹebreni, yexs ayeqqim γareḵ 6 d isuggasen ixeddem. aḏ g suggas wi 7 atedjeḏ ayreḥ af imanis man γiyr man alqiḏ ḥeqqis. <verse eid="EXO 21:2" /><verse number="3" style="v" sid="EXO 21:3" />kan tesγit d ƹezri, atsibeḏ weḥdes, amma kan teṣγit s lehlis, yexs asiybeḏ lehlis yiḏes. <verse eid="EXO 21:3" /><verse number="4" style="v" sid="EXO 21:4" />kan ysenejfi amis aḏ tuγesd lehlis ifrex aḏ tifrex. rahiy aydin n tmeṭṭuṯ aḏ aydin n imeckenen aqimen y amis we atiseyyeb weḥdes.<verse eid="EXO 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 21:5" />lekenti kan ayuh n ačiw yuwa: «xseγ amiw aḏ lehliw aḏ ṭarwaw, aḏ wiγisexc aḏuleγ ḥur weḥdi aḏ xseγ aqimeγ iḏsen amyuh.» <verse eid="EXO 21:5" /><verse number="6" style="v" sid="EXO 21:6" />yexs atiwiy amis al lmejles n lḥukem bac acehden fellas. aḏ dinet atisebbed al lbab naγ al lxeddis we asyesnuqeb temezuγtis s tsubla, we ayeḏwel seg lweqt ḏḏin d ačiwis y diyma.<verse eid="EXO 21:6" /></para>
  <para style="s">leḥkam n tečiwt</para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 21:7" />kan yezenz yjen yellis d tečiwt, witetsibenc ḥurra mammeḵ teggen y ačiw. <verse eid="EXO 21:7" /><verse number="8" style="v" sid="EXO 21:8" />ḥetta kan yeṣγiṯ amis bac atetyerni y tseḏnanis. aḏ wembeƹd wisteƹjibc. rahiy wiγrec lḥeq atetyezzenz y iγriben naγ ayerla bac babis atetiṣeγ afelxaḍert ixaniṯ aḏ witetyenjifc. <verse eid="EXO 21:8" /><verse number="9" style="v" sid="EXO 21:9" />kan yeṣγiṯ bac atetisenjef y memmis, yexs atetyeg am yellis. <verse eid="EXO 21:9" /><verse number="10" style="v" sid="EXO 21:10" />kan yerniy yenjef fellas ijeṯ iḍen, yexs wisenkizc y tmezwert g uču naγ g uṣireḍ naγ g iḍeṣ. <verse eid="EXO 21:10" /><verse number="11" style="v" sid="EXO 21:11" />rahiy kan ysenkzas g yjen seg ayuh n 3, yexs atetyedja atreḥ af imanis man γiyr man ayelqa lḥeqqis.<verse eid="EXO 21:11" /></para>
  <para style="s">leḥkam n tmenγiwt</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 21:12" />lliy ayenγ yjen iḍen yexs ayemmunγ. <verse eid="EXO 21:12" /><verse number="13" style="v" sid="EXO 21:13" />kan wisyeƹni aḏ yenγi afelxaḍert yetweriyas. rahiy neči tasixeneγ al mani tayerwel. <verse eid="EXO 21:13" /><verse number="14" style="v" sid="EXO 21:14" />amma lliy yesmuḏ af udurru n yjen iḍen aḏ yenγi belƹani, yexs ateṭfeḏ bac atenγeḏ ḥetta lukan yerwel al imkaniw imeqdusen.<verse eid="EXO 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 21:15" />kul yjen aywet babis naγ yedjis ayemmunγ. <verse eid="EXO 21:15" /><verse number="16-17" style="v" sid="EXO 21:16-17" />kul yjen ayeḏƹu y babis naγ y yedjis ayemmunγ. aḏ kul yjen ayexdef yjen iḍen bac atyezzenz naγ bac atyeg d ačiwis ayemmunγ.<verse eid="EXO 21:16-17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 21:18" />kan nnuγen sen irgazen, yaxy iwet yjen sisen ttani s aḍγaγ naγ s lbunyeṯ idurry, <verse eid="EXO 21:18" /><verse number="19" style="v" sid="EXO 21:19" />aḏ yekker lliy yemdur yeggur af tluggeḥit, witeggen ḥaja y lliy idurry amma yexs atixelleṣ g ussan lliy wiyexdimc disen we atidewa af leḥsebis.<verse eid="EXO 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 21:20" />kan iwet yjen ačiwis naγ tečiwtis s ugeṭṭum almiy yemmuṯ ayemƹaqeb. <verse eid="EXO 21:20" /><verse number="21" style="v" sid="EXO 21:21" />amma kan yedder aydin n ačiw beƹd iwat as naγ sen rahiy witƹaqibenc amis afelxaḍert ačiw nnas.<verse eid="EXO 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 21:22" />kan nnuγen irgazen aḏ duzzen temeṭṭuṯ, yaxy temezda tekker lebas, ayeḏfeƹ lliy iduzziṯ leγremeṯ lliy yeḍlebbiṯ argazis beƹd man ayeḥkem lqaḍi. <verse eid="EXO 21:22" /><verse number="23" style="v" sid="EXO 21:23" />amma kan temdur temeṭṭuṯ nyeƹdel, aggen y lliy iduzziṯ mammeḵ yeggas: kan yenγiṯ atenγen, <verse eid="EXO 21:23" /><verse number="24" style="v" sid="EXO 21:24" />kan yeƹwerras ṭiṭ aseƹman ṭiṭis netta zada. kan imuksas ssin naγ ffus naγ dder aseggen mammeḵ yeggas. <verse eid="EXO 21:24" /><verse number="25" style="v" sid="EXO 21:25" />aḏ am idin aseggen: tiqqaḍ s tiqqaḍ, ljerḥ s ljerḥ, rdex s rdex.<verse eid="EXO 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 21:26" />kan iwet yjen ačiwis naγ tečiwtis yeƹmeyas ṭiṭis, yexs atiseyyeb d leγremeṯ n ṭiṭis lliy yeƹmeyested. <verse eid="EXO 21:26" /><verse number="27" style="v" sid="EXO 21:27" />aḏ kan iwet yjen ačiwis naγ tečiwtis yerzas ssinis, yexs atiseyyeb d leγremeṯ n lliy yerzas.<verse eid="EXO 21:27" /></para>
  <para style="p" />
  <para style="s">lqanuwn af iḏbab n zwayel</para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 21:28" />kan yengez fwunes argaz naγ temeṭṭuṯ yenγi, yexs ayemuḥedef s iḍγaγen almiy ayemmuṯ, we ayemluweḥ yessumis, amma lmulatis wisteteggem ḥaja. <verse eid="EXO 21:28" /><verse number="29" style="v" sid="EXO 21:29" />amma kan ayuh n ufwunes d aweƹƹer aḏ ineggez diyma, aḏ lmulatis lliy yessen siyes wityeṭṭifc, kan yengez argaz naγ temeṭṭuṯ yenγi, yexs atḥedfen we anγen lmulatis zada. <verse eid="EXO 21:29" /><verse number="30" style="v" sid="EXO 21:30" />amma kan lmulatis yetquddu ayefda imanis, yexs ayeḏfeƹ lliy ḍlebbent fellas. <verse eid="EXO 21:30" /><verse number="31" style="v" sid="EXO 21:31" />kan fwunes yengez afrux naγ tefruxt, yexs aggen diyes ayuh n leḥkam. <verse eid="EXO 21:31" /><verse number="32" style="v" sid="EXO 21:32" />kan yengez fwunes ačiw naγ tečiwt yenγi, yexs lmulatis ayuc y bab n ačiw 30 seg umeḥbub n lfejreṯ, we ayemuḥdef fwunes almiy ayemmuṯ.<verse eid="EXO 21:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 21:33" />kan yella mam yeγez anu naγ imir anus yedjiy man γiyr ddan, yaxy yuda diyes aγyul naγ fwunes, yemmuṯ, <verse eid="EXO 21:33" /><verse number="34" style="v" sid="EXO 21:34" />yexs ayeḏfeƹ lmulatis y bab n zeyleṯ ssumis, we aywiy netta zeyelteḏin.<verse eid="EXO 21:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 21:35" />kan yengez fwunes n yjen fwunes n yjen iḍen yenγi, yexs azenzen fwunes lliy yedder we azunen lḥeqqis we azunen fwunes lliy yemmuṯ. <verse eid="EXO 21:35" /><verse number="36" style="v" sid="EXO 21:36" />amma kan fwunes ineggez s luwel aḏ lmulatis yessen siyes aḏ wityeqqinc. rahiy yexs ayuc fwunesis lliy d ṣbiḥ we aywiy fwunes lliy yemmuṯ.<verse eid="EXO 21:36" /></para>
  <chapter eid="EXO 21" />
  <chapter number="22" style="c" sid="EXO 22" />
  <para style="s">leḥkam n sserqeṯ aḏ lmelk</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 22:1" />kan yesreq yjen fwunes naγ izmer yeγressy naγ yezenzy, yexs ayuc y lmulatis 5 n ifwunesen naγ 4 n iƹelwac.» <verse eid="EXO 22:1" /><verse number="2" style="v" sid="EXO 22:2" />«kan lliy yserreq ṭṭefent g yiḍ, yaxy wettent nγent, areḥen iḏemnis am idin. <verse eid="EXO 22:2" /><verse number="3" style="v" sid="EXO 22:3" />amma kan ṭṭefent beƹd ilay n tufuyt, yaxy nγent. γaresen middenis lḥeq bac rren tṯar y lliy yenγi. sereq zada yexs ayƹeweḍ y lliy yetwesreq, kan wiγrec man ayuc, ayemmunz bac ayxelleṣ sereqtis. <verse eid="EXO 22:3" /><verse number="4" style="v" sid="EXO 22:4" />kan lliy yemmusreq ufent γares yedder d fwunes naγ d aγyul naγ d izmer yexs ayuc sereq y lmulatis deqqes n lḥeqqis mertin.<verse eid="EXO 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 22:5" />kan yella mam yedja zweylis ferden g umezdeγ n ljaris naγ g tzurinis, yexs asyƹeweḍ seg lγelleṯ teṣbiḥt n umezdeγis naγ n tzurinis.<verse eid="EXO 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 22:6" />kan yella mam yessiγ timsi g ysennenen, yaxy treḥ s yin al nwader n irden naγ al tirni naγ al imendi lliy g imezdeγen, yexs ayƹeweḍ lexsareṯ.<verse eid="EXO 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 22:7" />kan yedja yjen lemeneṯ d lfejreṯ naγ d wureγ al ṣṣeḥbis, yaxy temusreq, ayuc sereq almiy yemuṭef deqsis mertin. <verse eid="EXO 22:7" /><verse number="8" style="v" sid="EXO 22:8" />kan witṭifenc lliy yesreq, yexs lliy yelqa lemeneṯ ayedjul zzaṯ lemeḥkmeṯ lliy muc d netta yesreq lemeneṯ n ṣṣeḥbis.<verse eid="EXO 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 22:9" />kan yella mam iḥaz ḥaja muc nnas, seg leḥweyej naγ seg iγyal naγ seg tulli naγ seg ifwunesen naγ ḥaja lliy treḥ y lmulatis, aḏ kul yjen sisen yemmal: &lt; nnuw neči. &gt; yexs bbedden s ssen zzaṯ lqaḍi, aḏ lliy adyeḍher lliy netta d sereq ayƹeweḍ y ttani deqqes n lliy yewiy mertin.<verse eid="EXO 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 22:10" />kan yella mam yedja aγyul naγ fwunes naγ zeyleṯ al yjen, yaxy yemmuṯ naγ yemdur naγ yetwesreq g lγefleṯ. <verse eid="EXO 22:10" /><verse number="11" style="v" sid="EXO 22:11" />yexs lliy yelqa lemeneṯ ayedjal s rebbiy lliy muc d netta lliy yewya matta yedja γares ljaris. aḏ yexs ttani ayerla s ayuh n djelliṯ aḏ wiḍellebc leγremeṯ. <verse eid="EXO 22:11" /><verse number="12" style="v" sid="EXO 22:12" />amma kan zeyleṯ tetwesreq s γares afelxaḍert wiyerric lbalis, yexs ayƹeweḍ y ṣṣeḥbis. <verse eid="EXO 22:12" /><verse number="13" style="v" sid="EXO 22:13" />kan aydin n zeyleṯ čenteṯ lehweyec, yexs adyeγ lebqitis d lemereṯ, aḏ s ayuh wituc leγremeṯ.<verse eid="EXO 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 22:14" />kan yerdel yjen ḥaja s ṣṣeḥbis, yaxy terrez naγ temmuṯ γares aḏ lmulatis wiyelli, yexs ayuc leγremeṯ y lmulatis. <verse eid="EXO 22:14" /><verse number="15" style="v" sid="EXO 22:15" />amma kan temdur zzaṯ lmulatis, ttani wisyettuc ḥaja. amma zeyleṯ naγ ḥaja yuγetted s lekri. rahiy lekri d lƹuḍ n lexsareṯ.<verse eid="EXO 22:15" /></para>
  <para style="s">leḥkam jar midden</para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 22:16" />kan yella mam yenneḍ s ijeṯ d teqiyyert, yetṭes yiḏes, yexs asyuc ccerd we atetyenjef. <verse eid="EXO 22:16" /><verse number="17" style="v" sid="EXO 22:17" />ḥetta kan babis wiyeqqil astedisenjef, yexs asyuc ccerd n tqiyarin.<verse eid="EXO 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 22:18" />kul ijeṯ tetteg ssuḥer, yexs atemunγ.<verse eid="EXO 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 22:19" />kul yjen ayestefƹel g lbeqmeṯ, yexs ayemmunγ.<verse eid="EXO 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 22:20" />kul yjen ayuc lweƹdeṯ muc y rebbiy, yexs aymunγ.<verse eid="EXO 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 22:21" />witḍeyeqec lliy muc siwem aḏ witeṯƹeddeṯec fellas. rahiy kennim zada tusim d iγriben g miṣr.<verse eid="EXO 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 22:22" />widurruc tedjalin naγ leytam, <verse eid="EXO 22:22" /><verse number="23" style="v" sid="EXO 22:23" />afelxaḍert kan durretten taḍelben ƹewniw, we asenesleγ. <verse eid="EXO 22:23" /><verse number="24" style="v" sid="EXO 22:24" />we aγeccecceγ, we afenenγeγ s ssiyf, we aḏwelneṯ tiseḏnanuwem tedjalin aḏ terwewem d litama.<verse eid="EXO 22:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 22:25" />kan terdelleḏ iflusen y yjen d zeweli seg midniw lliy tmaḵ, yexs witleqqic fellas zzayeḏ mammeḵ tteggen lliy ttucen s lintiris. <verse eid="EXO 22:25" /><verse number="26" style="v" sid="EXO 22:26" />kan telqiḏ lbas n yjen d rhen n slef, yexs astiḏerreḏ aḏ ina n tufuyt, <verse eid="EXO 22:26" /><verse number="27" style="v" sid="EXO 22:27" />afelxaḍert d aydin lliy yeqqimas, kan teksdestiḏ matta tayreḍ almiy tayeṭṭes? rahiy kan yeqqim am idin, tayƹiyeḍ, aḏ kan iƹeyyeḍ tasesleγ afelxaḍert neči d rebbiy rḥiym.<verse eid="EXO 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 22:28" />wileƹƹenc aḏ wideƹƹuc y lliy ḥekmen diwem.<verse eid="EXO 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 22:29" />yexs altuceḏ lfal n lγeltiḵ seg nnader aḏ seg uḏi. aḏ altuceḏ bedri seg ṭarwaḵ. <verse eid="EXO 22:29" /><verse number="30" style="v" sid="EXO 22:30" />aḏ am idin aggeḏ s ibedriyen n ifwunesen aḏ tulli, bedri atedjeḏ ljumƹa yid yedjis wembeƹd altiḏuceḏ.<verse eid="EXO 22:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 22:31" />we adlem d cceƹbiw d meqdus, witettec yessum n mag yemmuč seg lḥuwc g ṣṣeḥreṯ amma uceṯ y iṭṭan.»<verse eid="EXO 22:31" /></para>
  <chapter eid="EXO 22" />
  <chapter number="23" style="c" sid="EXO 23" />
  <para style="s">leḥkam n lƹedl aḏ rreḥmeṯ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 23:1" />wiseγdeṯec y dwiy n tkerkas, wittesec yid lliy ycehheḏ s zzur.<verse eid="EXO 23:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 23:2" />widebbeƹc midden ḥetta lukan lkulhum teggen g ccer. aḏ witbeddelc cheddiḵ bac aseγeldeḏ al qaḍi. <verse eid="EXO 23:2" /><verse number="3" style="v" sid="EXO 23:3" />wittesc yid uzeweli afelxaḍert netta d zewali.<verse eid="EXO 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 23:4" />kan tufiḏ aγyul n leƹduwiḵ iḍeƹ, restiḏ. <verse eid="EXO 23:4" /><verse number="5" style="v" sid="EXO 23:5" />kan tezriḏ aγyul n leƹduḵ yuda adug ḏqel, witreḥec qebbel man atƹewneḏ af usekker n aγyulis.<verse eid="EXO 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 23:6" />uc lḥeq y fqir mammeḵ tetuceḏt y lliy d murkenti almiy teḥekmeḏ jaresen. <verse eid="EXO 23:6" /><verse number="7" style="v" sid="EXO 23:7" />wittehemc midden s lbaṭel bac ayḥkem lqaḍi s temenγiwt af ṣbiḥ aḏ lliy xaṭih. reḥi witsemiḥexc lliy yecheḏ s lbaṭel.<verse eid="EXO 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 23:8" />willeqqac recweṯ, afelxaḍert teṭaqeṣ ṭiṭawin n lqaḍi aḏ tetbeddel chedeṯ n ṣbiḥen.<verse eid="EXO 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 23:9" />witḍeyeqec aγrib. rahiy tessennem matta yetḥussu lxeḍert tusim d iγriben g tammurt n miṣr.<verse eid="EXO 23:9" /></para>
  <para style="s">cceriyƹeṯ n sebbeṯ aḏ isuggasen imeqdusen</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 23:10" />ḵrez tammurtiḵ temejretteṯ 6 d isuggasen. <verse eid="EXO 23:10" /><verse number="11" style="v" sid="EXO 23:11" />amma g suggas wi 7, yexs atetriḥeḏ bac aḏefen izeweliyen man ačan aḏ lliy adyefdel siyes atečen leḥweyec. aḏ am idin ggeḏ g tzuriniḵ aḏ uzemmuriḵ.<verse eid="EXO 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 23:12" />yexs axedmeḏ 6 d ussanaṯ, we areyḥeḏ g as wi 7, bac ayriyeḥ aγyuliḵ aḏ ufwunesiḵ, we ayefreḥ memmis n tečiwtiḵ aḏ leγrib.<verse eid="EXO 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 23:13" />ggeṯ matta uwiγawem lkul. aḏ witzelleṯec y irebbiyen iḍen, aḏ wineṭqec s ismewnesen.<verse eid="EXO 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 23:14" />kul suggas yexs alteggeḏ 3 n tfeṣkiwin. <verse eid="EXO 23:14" /><verse number="15" style="v" sid="EXO 23:15" />tfeṣka temezwert d tfeṣka n tqurset, g lmuḥan lliy uwiγaḵ felles 7 d ussanaṯ g zgen n cehher n abiyb ačaḏ tqurset, afelxaḍert g ayuh n cehher teffeγem seg tammurt n miṣr. aḏ yexs wildyettisc ḥetta d yjen ifesnis d lferγiyn.<verse eid="EXO 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 23:16" />beƹdis alteggeḏ tfeṣka n mjar, lliy yexs aḏuceḏ diyes lfal n lliy teḵrezzet g umezdeγiḵ. aḏ alteggeḏ tfeṣka n xzan g laxer n lexriyf almiy teleymeḏ lγelleṯ n umezdeγiḵ.<verse eid="EXO 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 23:17" />aḏ 3 merrat g usuggas yexs abedden irgazen zzaṯ neči rebbiysen.<verse eid="EXO 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 23:18" />wiltuc iḏemmen n ḍḥiyeṯ yid aγrum yexmer. aḏ wisensac teḏumt n lliy teγresset y neči al tajji.<verse eid="EXO 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 23:19" />yexs altuceḏ lfal n lγelleṯ n umezdeγiḵ y neči rebbiywem. aḏ yexs witserγic iγid g aγi n yedjis d suḥar bac arnin tulliwem.<verse eid="EXO 23:19" /></para>
  <para style="s">rebbiy yuƹeḏ tayer lbalis af middenis</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 23:20" />qa neči tanekyeγ zzaṯiḵ lmleyka. tayer lbalis fellaḵ. we afiwiy al tammurt lliy seḥderγeḵted. <verse eid="EXO 23:20" /><verse number="21" style="v" sid="EXO 23:21" />rreṯ lbaluwem al dwiys. rahiy kan witgemc siyes wiyetsemeḥc ibekkaḍnuwem. ismiw yiḏes. <verse eid="EXO 23:21" /><verse number="22" style="v" sid="EXO 23:22" />amma kan ttewƹet aḏ teggiḏ lliy uwiγaḵ, taƹeddiγ lliy yetƹeda diyeḵ we aḥerbeγ lliy yetḥereb diyeḵ. <verse eid="EXO 23:22" /><verse number="23" style="v" sid="EXO 23:23" />rahiy lmleyka tayeyyur zzaṯiḵ. we afiseḏef al tammurt n lemuwriyin aḏ iḥeyṯiyin aḏ lferiziyyin aḏ ikenƹaniyen aḏ lḥwiyin aḏ lyebuwsyin lliy tatenekseγ seg ddunyeṯ.<verse eid="EXO 23:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 23:24" />witsejdeḏc y rebbiynesen naγ asentezelleḏ. witegc mammeḵ tteggen. yexs atenmukseḏ we arzeḏ leṣnemesen. <verse eid="EXO 23:24" /><verse number="25" style="v" sid="EXO 23:25" />amma y neči weḥdi rebbiywem, yexs altezellem bac anumreγ učuḵ aḏ tissiḵ we amukseγ ṭṭan seg tzaγwinuwem. <verse eid="EXO 23:25" /><verse number="26" style="v" sid="EXO 23:26" />witadjiγ ḥetta d ijeṯ witeteruc naγ atemmezda g tammurtiḵ we afedjeγ dreḏ ggeṯ.<verse eid="EXO 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 23:27" />taggeγ lhibtiw zzaṯiḵ, we anenγeγ s tiwdi indin lliy tbeddan zzaṯiḵ we aseruleγ leƹdaḵ zzaṯiḵ. <verse eid="EXO 23:27" /><verse number="28" style="v" sid="EXO 23:28" />we anekyeγ tizizweṯin n iγyal zzaṯiḵ bac azeƹzeqeγ lḥwiyin aḏ ikenƹaniyen aḏ lḥeyṯiyin seg zzaṯiḵ. <verse eid="EXO 23:28" /><verse number="29" style="v" sid="EXO 23:29" />lekenti witenzeƹziqexc g usuggas yjen bac witxellac ddunyeṯ aḏ wikeṯrenc fellaḵ luḥuwc. <verse eid="EXO 23:29" /><verse number="30" style="v" sid="EXO 23:30" />amma tatenzeƹezqeγ s ufercu almiy rnim we awerṯem tammurt.<verse eid="EXO 23:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 23:31" />we aḏulen leḥduḏ n tammurtiḵ seg iylel zuggaγ al cceṭ n felesṭiyn aḏ seg ṣṣeḥreṯ al lwaḏ n lfurat, we afuceγ ssulṭeṯ af midden lliy seknen diyes we atenzeƹezqeḏ seg zzaṯiḵ. <verse eid="EXO 23:31" /><verse number="32" style="v" sid="EXO 23:32" />witegc yiḏesen naγ yid rebbiysen almiyṯaq. <verse eid="EXO 23:32" /><verse number="33" style="v" sid="EXO 23:33" />witentadjac dren g tammurtiḵ bac wifseγliḍenc iḏiy rebbiy yeggi lƹehd yid midden<verse eid="EXO 23:33" /></para>
  <chapter eid="EXO 23" />
  <chapter number="24" style="c" sid="EXO 24" />
  <para style="nb">
    <verse number="1" style="v" sid="EXO 24:1" />wembeƹd yuwa lliy diyma yella y muwsa: «lliy al γari, cek aḏ haruwn aḏ nadab aḏ abiyhuw aḏ 70 seg iwessaren n aṯ israyil yexs altsejdem s yebƹeḏ. <verse eid="EXO 24:1" /><verse number="2" style="v" sid="EXO 24:2" />we aqimen bƹeḏḏen fella, aḏ wiltqerbenc kan cek weḥdeḵ aḏ witaly iḏeḵ ḥetta ḥed seg cceƹb.»<verse eid="EXO 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 24:3" />yused muwsa al midden, yuwayasen af mag yuwa rebbiy lkul, yaxy uwanas: «taneg lliy yuwa rebbiy lkul.» <verse eid="EXO 24:3" /><verse number="4" style="v" sid="EXO 24:4" />yuri muwsa luwṣayaṯ n lliy diyma yella. aḏ yekker tajji yeggi mkan n teγrest y rebbiy adug jbel aḏ ysebbed 12 d tiγuγa d igeḍman felleḥseb n leƹceyer n aṯ israyil. <verse eid="EXO 24:4" /><verse number="5" style="v" sid="EXO 24:5" />aḏ yenkiy imezyanen seg aṯ israyil bac aḥerqen teγrest y rebbiy we asγersen seg ifwunesen teγrest n slemeṯ. <verse eid="EXO 24:5" /><verse number="6" style="v" sid="EXO 24:6" />wembeƹd yeggi muwsa zgen n iḏemmen g ibriqen aḏ lbaqi irucci af mkan n teγrest. <verse eid="EXO 24:6" /><verse number="7" style="v" sid="EXO 24:7" />aḏ yeƹzem luwṣayaṯ n rebbiy af midden, yaxy uwan: «lliy yuwa rebbiy tatneg.»<verse eid="EXO 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 24:8" />wembeƹd iruc iḏemmen af midden, yuwa: «qa ayuh d iḏemmen n lƹehd lliy yeggi rebbiy iḏuwem mammeḵ yuwa.»<verse eid="EXO 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 24:9" />amyuh yuli muwsa netta aḏ haruwn aḏ nadab aḏ abiyhuw aḏ 70 seg iwessaren n aṯ israyil. <verse eid="EXO 24:9" /><verse number="10" style="v" sid="EXO 24:10" />yaxy zren rebbiy n aṯ israyil yebbed af ḥaja seg lyaquwt tezizewt tlemmeƹ am ujenna. <verse eid="EXO 24:10" /><verse number="11" style="v" sid="EXO 24:11" />lekenti rebbiy wiyenγic imeqqaren n aṯ israyil, amma yedjin zerren diyes aḏ nihnin tteten, sessen.<verse eid="EXO 24:11" /></para>
  <para style="s">muwsa yuli al jbel</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 24:12" />yuwa lliy diyma yella y muwsa: «ali al jbel tmaw, teqimeḏ dinet. rahiy tafuceγ luwṣayaṯiw aḏ cceriyƹeṯiw lliy uriyextent af sen tγuγa, bac atentseḥefdeḏ y midden.»<verse eid="EXO 24:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 24:13" />yaxy yekker muwsa yuli al jbel n rebbiy netta aḏ yecuwƹ lliy yetƹewen diyes. <verse eid="EXO 24:13" /><verse number="14" style="v" sid="EXO 24:14" />yuwa muwsa y iwessaren n aṯ israyil: «sugemteneγ deh almiy adner. aḏ qa haruwn aḏ ḥuwr jarewem. aḏ lliy yexs ḥaja asenimel y nihnin.»<verse eid="EXO 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 24:15" />aḏ mniyn yuli muwsa al jbel, yuḏen sḥab jbel lkul. <verse eid="EXO 24:15" /><verse number="16" style="v" sid="EXO 24:16" />yezwad lmejd n rebbiy af jbel n siynay. yuḏenny sḥab 6 d ussanaṯ. aḏ g as wi 7 yesγuy rebbiy af muwsa seg amas n sḥab. <verse eid="EXO 24:16" /><verse number="17" style="v" sid="EXO 24:17" />aḏ yeḍherred lmejd n rebbiy y aṯ israyil am timsi tetheblej af iγef n jbel. <verse eid="EXO 24:17" /><verse number="18" style="v" sid="EXO 24:18" />amyuh yuḏef muwsa g amas n sḥab. aḏ yerniy yuli al jbel mani yeqqim 40 d ussan aḏ iḍan.<verse eid="EXO 24:18" /></para>
  <chapter eid="EXO 24" />
  <chapter number="25" style="c" sid="EXO 25" />
  <para style="s">ṣeddeq y lebni n lƹecceṯ y rebbiy</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 25:1" />yuwa lliy diyma yella y muwsa: <verse eid="EXO 25:1" /><verse number="2" style="v" sid="EXO 25:2" />«mmel y aṯ israyil aleymen ṣṣedqeṯ, seg indin lliy crehhen af ucas. <verse eid="EXO 25:2" /><verse number="3" style="v" sid="EXO 25:3" />yexs aleymeḏ s γarsen, wureγ aḏ lfejreṯ aḏ nḥas, <verse eid="EXO 25:3" /><verse number="4" style="v" sid="EXO 25:4" />aḏ ulman d izizewen aḏ d iḥberiyen aḏ d izuggaγen, aḏ ustu n tefduxt aḏ ulman n udjuf n tiγeṭiyn. <verse eid="EXO 25:4" /><verse number="5" style="v" sid="EXO 25:5" />aḏ ilimen n iberkas ṣbeγγen d izuggaγen, aḏ ilimen n trebit temeqqart lliy man γiyr tqecra aḏ isγaren n ssenṭ. <verse eid="EXO 25:5" /><verse number="6" style="v" sid="EXO 25:6" />aḏ uḏi y useγi n nnir aḏ ifuḥan y uḏi meqdus aḏ lebxuwr. <verse eid="EXO 25:6" /><verse number="7" style="v" sid="EXO 25:7" />aḏ tiƹqiqin tiṣbiḥin n ljizƹ, aḏ tiƹqiqin tiṣbiḥin iḍen y sray n rdi n lkuhhan aḏ tmeṣdurtis. <verse eid="EXO 25:7" /><verse number="8" style="v" sid="EXO 25:8" />mlasen aleggen tezeqqa temeqdust mani aqimeγ jaresen. <verse eid="EXO 25:8" /><verse number="9" style="v" sid="EXO 25:9" />we altedeggen nettaṯ yid iḥejeyenis mammeḵ taḵtendsiḵneγ.»<verse eid="EXO 25:9" /></para>
  <para style="s">ttebuwt n lƹehd</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 25:10" />yexs aggeḏ ttebuwt seg isγaren n ssenṭ, ṭṭulis 2 derƹan aḏ wezgen aḏ leƹerḍis am lƹelwis dereƹ aḏ wezgen. <verse eid="EXO 25:10" /><verse number="11" style="v" sid="EXO 25:11" />we atγelfeḏ s wureγ ṣbiḥ s jjaj aḏ barra, we asteggeḏ lḥacit n wureγ. <verse eid="EXO 25:11" /><verse number="12" style="v" sid="EXO 25:12" />we asteggeḏ 4 n tḥelqeṯin n wureγ we atenteggeḏ af treknis, kul senneṯ s ljiheṯ. <verse eid="EXO 25:12" /><verse number="13" style="v" sid="EXO 25:13" />we aggeḏ sen igeḍman seg isγaren n ssenṭ, we atenγelfeḏ s wureγ, <verse eid="EXO 25:13" /><verse number="14" style="v" sid="EXO 25:14" />wembeƹd atenseḏfeḏ g aydin n tḥelqeṯin n ttebuwt bac atqamem sisen. <verse eid="EXO 25:14" /><verse number="15" style="v" sid="EXO 25:15" />aḏ yexs aqimen igeḍman diyn g tḥelqeṯin, witmukusenc sisneṯ xlaṣ. <verse eid="EXO 25:15" /><verse number="16" style="v" sid="EXO 25:16" />we aggeḏ tiḍγaγin n luwṣayaṯ lliy tafuceγ g ttebuwt.<verse eid="EXO 25:16" /></para>
  <para style="s">rebbiy yessaḵen y muwsa mammeḵ ayeg sen iqeruwbin aḏ ddan n ttebuwt</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 25:17" />we aggeḏ ddan seg wureγ ṣbiḥ. netta d lƹerc n rreḥmeṯ. ṭṭulis derƹin aḏ wezgen aḏ lƹerḍis dereƹ aḏ wezgen. <verse eid="EXO 25:17" /><verse number="18" style="v" sid="EXO 25:18" />we aneḥteḏ f leḍrafis sen iqeruwbin n wureγ. <verse eid="EXO 25:18" /><verse number="19" style="v" sid="EXO 25:19" />we aydel kul lqeruwb af ṭṭerf n ddan, we adlen mmuneḥten seg wureγ n ddan aḏ lṣeqqen diyes. <verse eid="EXO 25:19" /><verse number="20" style="v" sid="EXO 25:20" />we adlen mqeblen, aḏ frewnesen lliy sreḏḏen tteḏnen ddan lliy smuqulnas. <verse eid="EXO 25:20" /><verse number="21" style="v" sid="EXO 25:21" />we aggeḏ ayuh n ddan nnaj ttebuwt lliy teggeḏ diyes tiḍγaγin n luwṣayaṯ lliy tafuceγ. <verse eid="EXO 25:21" /><verse number="22" style="v" sid="EXO 25:22" />aḏ diyn tafezreγ jar aydin sen iqeruwbin s nnaj ddan n ttebuwt n luwṣayaṯ. aḏ tafemleγ af matta tatemleḏ y aṯ israyil lkul.<verse eid="EXO 25:22" /></para>
  <para style="s">rebbiy yessaḵen y muwsa mammeḵ ayeg ṭṭewleṯ n tqurset temeqdust</para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 25:23" />we arniḏ aggeḏ ṭṭewleṯ seg isγaren n ssenṭ, ṭṭulis sen leḏruƹ, aḏ lƹerḍis dereƹ, aḏ lƹulwis dereƹ aḏ wezgen. <verse eid="EXO 25:23" /><verse number="24" style="v" sid="EXO 25:24" />we atetγelfeḏ s wureγ, we asteggeḏ lḥacit n wureγ. <verse eid="EXO 25:24" /><verse number="25" style="v" sid="EXO 25:25" />we aggeḏ af lejnabis lḥacit iḍen am lgafun lƹelwis 4 n idudan aḏ lḥacitis d wureγ zada. <verse eid="EXO 25:25" /><verse number="26" style="v" sid="EXO 25:26" />we astneγleḏ 4 n tḥelqeṯin n wureγ, we astendeggeḏ af treken n idernis adug lḥacit. <verse eid="EXO 25:26" /><verse number="27" style="v" sid="EXO 25:27" />we adelneṯ ayuh n tḥelqeṯin d imuḵan n sen igeḍman lliy taqemem sisen ṭṭewleṯ. <verse eid="EXO 25:27" /><verse number="28" style="v" sid="EXO 25:28" />we aggeḏ igeḍman seg isγaren n ssenṭ, we atenγelfeḏ s wureγ bac aqemen sisen ṭṭewleṯ. <verse eid="EXO 25:28" /><verse number="29" style="v" sid="EXO 25:29" />amma tiḥeḏweq n ṭṭewleṯ, aḏ tbesis, aḏ lkisanis, aḏ ibriqnis lliy taneγlem sisen, yexs ateneggeḏ seg wureγ ṣbiḥ. <verse eid="EXO 25:29" /><verse number="30" style="v" sid="EXO 25:30" />we aggeḏ tqurset n ṣṣedqeṯ zzaṯiw af ayuh n ṭṭewleṯ diyma.<verse eid="EXO 25:30" /></para>
  <para style="s">rebbiy yessaḵen y muwsa mammeḵ ayeg lefnar</para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 25:31" />we aneḥteḏ seg ṭṭerf yjen n wureγ ṣbiḥ nnir s tqeƹetis aḏ daris aḏ lkisanis aḏ nnuweris aḏ tiwerqay n nnuweris. <verse eid="EXO 25:31" /><verse number="32" style="v" sid="EXO 25:32" />we adefγen seg dder lliy g amas 6 n isγaren kul 3 seg ljiheṯ, <verse eid="EXO 25:32" /><verse number="33" style="v" sid="EXO 25:33" />we aydel kul lkas s tnuwertis aḏ tewerqitis g ṭṭerf n kul sγer seg ayuh n 6. <verse eid="EXO 25:33" /><verse number="34" style="v" sid="EXO 25:34" />aḏ ayuh n nnir diyes 4 n lkisan am tzalluzin s twerqeyesen aḏ nuweresen g dder lliy g amas. <verse eid="EXO 25:34" /><verse number="35" style="v" sid="EXO 25:35" />aḏ g dder lliy g amas adug kul sen isγaren yexs ggeḏ tewerqit. <verse eid="EXO 25:35" /><verse number="36" style="v" sid="EXO 25:36" />we aydel dder n nnir aḏ tiwerqayis aḏ isγarnis lkulhum d ṭṭerf yjen seg wureγ ṣbiḥ.<verse eid="EXO 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="EXO 25:37" />we aggeḏ 7 n lkisan y tiftal, we atenserseḏ af nnir bac aḍawan al zzaṯ. <verse eid="EXO 25:37" /><verse number="38" style="v" sid="EXO 25:38" />we aggeḏ zada iγemdanis aḏ tḥeḏweqis n iγeḍ seg wureγ ṣbiḥ. <verse eid="EXO 25:38" /><verse number="39" style="v" sid="EXO 25:39" />yexs aggeḏ ayuh n nnir aḏ lliy yiḏes lkul seg lweznaṯ ijeṯ n wureγ ṣbiḥ. <verse eid="EXO 25:39" /><verse number="40" style="v" sid="EXO 25:40" />aḏ yexs aggeḏ kul ciy mammeḵ siḵenγaḵtiḏ dehnit af jbel.<verse eid="EXO 25:40" /></para>
  <chapter eid="EXO 25" />
  <chapter number="26" style="c" sid="EXO 26" />
  <para style="s">rebbiy yessaḵen y muwsa mammeḵ ayeg ddan n lƹecceṯ temeqdust</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 26:1" />nsej 10 n stareṯ seg ustu n tefduxt ṣbiḥ aḏ ulman d izizewen aḏ d iḥberiyen aḏ d izuggaγen. aḏ ṭrez fellas tṣawer n sen iqeruwbin. <verse eid="EXO 26:1" /><verse number="2" style="v" sid="EXO 26:2" />ṭṭul n kul star 28 d leḏruƹ aḏ lƹerḍis 4 ḏruƹ, aḏ ayuh d leqyas n stareṯ lkul. <verse eid="EXO 26:2" /><verse number="3" style="v" sid="EXO 26:3" />we aqneḏ kul 5 n stareṯ g beƹeḍhum, <verse eid="EXO 26:3" /><verse number="4" style="v" sid="EXO 26:4" />we aggeḏ g ṭṭerf n stareṯ imezweren lliy qqennen tiḥelqeṯin n ulman izizawen, aḏ af ṭṭerf n stareṯ ttenyaṯ lliy qqennen zada, <verse eid="EXO 26:4" /><verse number="5" style="v" sid="EXO 26:5" />we aydel y kul ṭṭerf sisen 50 d tiḥelqeṯin n ulman ijeṯ g leqbeleṯ n ttani. <verse eid="EXO 26:5" /><verse number="6" style="v" sid="EXO 26:6" />we aggeḏ 50 d iγesmeren n wureγ bac aṭfeḏ sisen aydin n sen leḍraf bac aḏulen d ddan yjen y lƹecceṯ.<verse eid="EXO 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 26:7" />we aggeḏ ddan wissen y leƹecceṯ seg 11 d stareṯ n uzeṭṭi n udjuf n tγaṭin. <verse eid="EXO 26:7" /><verse number="8" style="v" sid="EXO 26:8" />kul star sisen ṭṭulis 30 d leḏruƹ aḏ lƹerḍis 4 ḏruƹ. <verse eid="EXO 26:8" /><verse number="9" style="v" sid="EXO 26:9" />we aqneḏ 5 n stareṯ imezweren bac aḏulen d ṭṭerf yjen, we aggeḏ am idin s 6 lliy fdellend. lekenti yexs aḏeḍiḏ star wi 6 bac aydel am star n imi zzaṯ lƹecceṯ. <verse eid="EXO 26:9" /><verse number="10" style="v" sid="EXO 26:10" />we aggeḏ 50 d tiḥelqeṯin n ulman g ṭṭerf n stareṯ imezweren aḏ 50 g ṭṭerf n stareṯ ttenyaṯ. <verse eid="EXO 26:10" /><verse number="11" style="v" sid="EXO 26:11" />we aggeḏ 50 d iγesmeren n nḥas, aṭfeḏ sisen tiḥelqeṯin n ulman n leḍraf bac aḏulen stareṯ d ddan wissen y lƹecceṯ. <verse eid="EXO 26:11" /><verse number="12" style="v" sid="EXO 26:12" />we adjeḏ zgen n star seg ddan wissen yerxa bac ayeḏen laxer n lƹecceṯ. <verse eid="EXO 26:12" /><verse number="13" style="v" sid="EXO 26:13" />aḏ dereƹ lliy yefdelled siyes s yeh aḏ s yeh, yexs aterxiḏ felnejnab n lƹecceṯ. <verse eid="EXO 26:13" /><verse number="14" style="v" sid="EXO 26:14" />we aḏeḏneḏ lƹecceṯ s nnaj s ilimen n iberkas ḏhennen d izuggaγen aḏ njesen ilimen n trebit temeqqart lliy man γiyr tqecra.<verse eid="EXO 26:14" /></para>
  <para style="s">rebbiy yessaḵan y muwsa mammeḵ ayeg leḥyuḍ n lƹecceṯ</para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 26:15" />amma leḥyuḍ ateneggeḏ s tqafeṣ seg isγaren n ssenṭ bbedneṯ. <verse eid="EXO 26:15" /><verse number="16" style="v" sid="EXO 26:16" />ṭṭul n kul teqfiṣeṯ sisneṯ 10 ḏruƹ aḏ lƹerḍis dereƹ aḏ wezgen. <verse eid="EXO 26:16" /><verse number="17" style="v" sid="EXO 26:17" />we aggeḏ y kul teqfiṣeṯ sen derren, yjen g leqbeleṯ n ttani. <verse eid="EXO 26:17" /><verse number="18" style="v" sid="EXO 26:18" />ljiheṯ teqeblit aggeḏ diyes 20 d tqafeṣ. <verse eid="EXO 26:18" /><verse number="19" style="v" sid="EXO 26:19" />we aggeḏ 40 d tiqeƹƹeḏin n lfejreṯ adug ayuh n tqafeṣ, sen n tqeƹƹeḏin y iderren n kul teqfiṣeṯ. <verse eid="EXO 26:19" /><verse number="20" style="v" sid="EXO 26:20" />we aggeḏ g ljiheṯ wisneṯ tebeḥrit 20 d tqafeṣ, <verse eid="EXO 26:20" /><verse number="21" style="v" sid="EXO 26:21" />asenteggeḏ 40 d tiqeƹƹeḏin n lfejreṯ, bac aydel sen tqeƹƹeḏin y sen derren n kul teqfiṣeṯ. <verse eid="EXO 26:21" /><verse number="22" style="v" sid="EXO 26:22" />amma lḥiḍ medeffer, aγerbi n lƹecceṯ asteggeḏ 6 n tqafeṣ. <verse eid="EXO 26:22" /><verse number="23" style="v" sid="EXO 26:23" />we aggeḏ sen tqafeṣ y kul terkineṯ seg treken timedefferin. <verse eid="EXO 26:23" /><verse number="24" style="v" sid="EXO 26:24" />we adelneṯ lṣeqneṯ s dday al nnaj mani taggeḏ lḥelqeṯ ijeṯ y kul terkineṯ. <verse eid="EXO 26:24" /><verse number="25" style="v" sid="EXO 26:25" />we aydel g ljiheṯ teγerbit diyes 8 n tqafeṣ aḏ 16 d tiqeƹƹeḏin senneṯ y kul teqfiṣeṯ.<verse eid="EXO 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 26:26" />we aggeḏ lweseṭ seg isγaren n ssenṭ, 5 y tqafeṣ n ljiheṯ teqeblit n lƹecceṯ, <verse eid="EXO 26:26" /><verse number="27" style="v" sid="EXO 26:27" />aḏ 5 y tqafeṣ n ljiheṯ tbeḥrit n lƹecceṯ aḏ 5 y tqafeṣ n ljiheṯ temedeffert s mγerreb. <verse eid="EXO 26:27" /><verse number="28" style="v" sid="EXO 26:28" />we addel lweseṭeṯ temamest tatƹedda g amas n tqafeṣ seg ṭṭerf al ṭṭerf. <verse eid="EXO 26:28" /><verse number="29" style="v" sid="EXO 26:29" />we aγelfeḏ tqafeṣ s wureγ, we asenteggeḏ tiḥelqeṯin n wureγ mani aḏeḏefneṯ lweseṭ, we aγelfeḏ lweseṭ zada s wureγ. <verse eid="EXO 26:29" /><verse number="30" style="v" sid="EXO 26:30" />aḏ amyuh yexs aggeḏ lƹecceṯ temeqdust mammeḵ siḵenγeḵted dehnit af jbel.<verse eid="EXO 26:30" /></para>
  <para style="s">rebbiy yessaḵen y muwsa mammeḵ ayeg star g amas n lƹecceṯ temeqdust</para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 26:31" />we aggeḏ star seg ustu n tefduxt aḏ ulman d izizewen aḏ d iḥberiyen aḏ d izuggaγen fellasen tṣewer n iqeruwbin. <verse eid="EXO 26:31" /><verse number="32" style="v" sid="EXO 26:32" />we atƹelqeḏ af 4 n tireslin seg isγaren n ssenṭ γelfeneṯ s wureγ, aḏ beddeneṯ af 4 n tqeƹƹeḏin n lfejreṯ, disneṯ 4 n lemxeṭef. <verse eid="EXO 26:32" /><verse number="33" style="v" sid="EXO 26:33" />we aƹelqeḏ star g iγesmeren, we aseḏfeḏ ttebuwt lliy diyes tiḍγaγin n luwṣayaṯ deffer star diyn lliy taydel jar lquds aḏ lquds n leqdas. <verse eid="EXO 26:33" /><verse number="34" style="v" sid="EXO 26:34" />we aggeḏ ddan af ttebuwt n luwṣayaṯ g lquds n leqdas. <verse eid="EXO 26:34" /><verse number="35" style="v" sid="EXO 26:35" />we asebeddeḏ ṭṭewleṯ s barra y star g ljiheṯ tebeḥrit aḏ g leqbeleṯ n nnir lliy yella g lqibelt.<verse eid="EXO 26:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 26:36" />we aggeḏ star yeṭrez y imi n lƹecceṯ seg ulman d izizewen aḏ d iḥberiyen aḏ d izuggaγen aḏ ustu n tefduxt. <verse eid="EXO 26:36" /><verse number="37" style="v" sid="EXO 26:37" />we aggeḏ y star 5 n tireslin seg isγaren n ssenṭ γelfeneṯ s wureγ beddeneṯ af 5 n tqeƹƹeḏin n nḥas. aḏ disneṯ 5 n lemxeṭef n wureγ.<verse eid="EXO 26:37" /></para>
  <chapter eid="EXO 26" />
  <chapter number="27" style="c" sid="EXO 27" />
  <para style="s">rebbiy yessaḵen y muwsa mammeḵ ayeg mkan n teγrest</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 27:1" />yexs aggeḏ mkan n teγrest seg isγaren n ssenṭ, seṭeḥtis timrebbeƹt, ṭṭulis aḏ lƹerḍis 5 ḏruƹ, aḏ lƹulwis 3 ḏruƹ. <verse eid="EXO 27:1" /><verse number="2" style="v" sid="EXO 27:2" />we asteggeḏ 4 n leqruwn af trakenis. yexs ateneggeḏ lṣeqqen diyes. we atγelfeḏ lkul s nḥas.<verse eid="EXO 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 27:3" />we aggeḏ seg nḥas reγeltis lkul, ibunyen y ulayem n iγeḍ, aḏ tiγenjeyin y uƹebbi n iγeḍ aḏ tmeƹejnin aḏ uzzal y umukes n yssum aḏ tmejemrinis.<verse eid="EXO 27:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 27:4" />we asteggeḏ rredj n nḥas. diyes 4 n tḥelqeṯin n nḥas af treknis. <verse eid="EXO 27:4" /><verse number="5" style="v" sid="EXO 27:5" />we ateggeḏ adug lḥacit n mkan n teγrest mammeḵ ayeṣel al zegnis.<verse eid="EXO 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 27:6" />we asteggeḏ sen igeḍman seg isγaren n ssenṭ we atenγelfeḏ s nḥas. <verse eid="EXO 27:6" /><verse number="7" style="v" sid="EXO 27:7" />we aseḏfeḏ igeḍman diyn g tḥelqeṯin af lejnab n mkan n teγrest bac ateqemem sisen. <verse eid="EXO 27:7" /><verse number="8" style="v" sid="EXO 27:8" />we aydel mkan n teγrest lliy seg isγaren d lfareγ g amas mammeḵ siḵenγeḵtiḏ dehnit af jbel.<verse eid="EXO 27:8" /></para>
  <para style="s">siḵen n stareṯ n ussetur</para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 27:9" />we aggeḏ settur yenneḍ af amas lḥuc s stareṯ n ustu n tefduxt ṣbiḥ ṭṭulis 100t n dereƹ seg ljiheṯ teqeblit. <verse eid="EXO 27:9" /><verse number="10" style="v" sid="EXO 27:10" />s 20 d tireslin aḏ 20 d tiqeƹƹeḏin n nḥas aḏ lemxeṭef aḏ uzzelaṯ d lfejreṯ. <verse eid="EXO 27:10" /><verse number="11" style="v" sid="EXO 27:11" />aḏ am idin ljiheṯ tebeḥrit, ṭṭulis 100t n dereƹ aḏ tireslinis 20 bbedneṯ af 20 d tiqeƹƹeḏin n nḥas aḏ lemxeṭfis aḏ uzzelaṯis d lfejreṯ.<verse eid="EXO 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 27:12" />amma lƹerḍ n lḥuc s mγerreb ṭṭul n staris 50 dereƹ, aḏ iƹelleq af 10 n tireslin bbedneṯ af 10 n tqeƹƹeḏin, <verse eid="EXO 27:12" /><verse number="13" style="v" sid="EXO 27:13" />we aydel lƹerḍ n lḥuc s mcerreq 50 dereƹ. <verse eid="EXO 27:13" /><verse number="14" style="v" sid="EXO 27:14" />we aydel ṭṭul n stareṯ af jneb mezwar n imi n lḥuc 15 n dereƹ, ƹelqen af 3 n tireslin yid 3 n tqeƹƹeḏin. <verse eid="EXO 27:14" /><verse number="15" style="v" sid="EXO 27:15" />aḏ deqsis taydel ṭṭul n stareṯ n jneb wissen n imi n lḥuc lliy tatuƹelqen zada af 3 n tireslin bbedneṯ af 3 n tqeƹƹeḏin.<verse eid="EXO 27:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 27:16" />amma ṭṭul n stareṯ n imi 20 dereƹ seg ustu n tefduxt ṣbiḥ yezda s ulman d izizewen aḏ d iḥberiyen aḏ d izuggaγen, ƹelqen af 4 n tireslin bbedneṯ af 4 n tqeƹƹeḏin. <verse eid="EXO 27:16" /><verse number="17" style="v" sid="EXO 27:17" />we adlen af tireslin n lḥuc uzzalaṯ n lfejreṯ s lemxeṭef n lfejreṯ aḏ tqeƹƹeḏin n nḥas. <verse eid="EXO 27:17" /><verse number="18" style="v" sid="EXO 27:18" />we aydel ṭṭul n amas lḥuc 100 n dereƹ, aḏ lƹerḍis 50 aḏ leƹlu n stareṯis 5 d leḏruƹ seg ustu n tefduxt aḏ tiqeƹdinis d nḥas. <verse eid="EXO 27:18" /><verse number="19" style="v" sid="EXO 27:19" />aḏ yexs addel reγleṯ lliy txedmem siyes g lḥuc lkulha seg nḥas, aḏ ṭwalaṯ n lƹecceṯ aḏ ṭwalaṯ n lḥuc zada.<verse eid="EXO 27:19" /></para>
  <para style="s">uḏi n useγi n nnir</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 27:20" />we amleḏ y aṯ israyil afdeγen uḏi n nḍuḥ y useγi n nnir diyma. <verse eid="EXO 27:20" /><verse number="21" style="v" sid="EXO 27:21" />yexs haruwn aḏ ṭarwas lhan s useγi n nnir seg tmeddiṯ al tajji zzaṯ rebbiy g lƹecceṯ n umlaqi s barra y star lliy zzaṯ ttebuwt n luwṣayaṯ. we aydel ayuh d lwajeb af aṯ israyil ljiyl beƹd ljiyl diyma.<verse eid="EXO 27:21" /></para>
  <chapter eid="EXO 27" />
  <chapter number="28" style="c" sid="EXO 28" />
  <para style="s">rdawaṯ n lkuhhan</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 28:1" />we altwaziḏ haruwn uwaḵ aḏ ṭarwas; nadab aḏ abiyhuw aḏ liƹazer aḏ iṯamer bac adlen d lkuhhan seg aṯ israyil. <verse eid="EXO 28:1" /><verse number="2" style="v" sid="EXO 28:2" />we aggeḏ y uwaḵ haruwn ṣireḍ d meqdus bac asyerni lwehreṯ aḏ lmejd. <verse eid="EXO 28:2" /><verse number="3" style="v" sid="EXO 28:3" />temleḏ y kul yjen seg indin lliy uciγasen rruwḥ n uquddu g uzeṭṭi bac aggen ṣireḍ n haruwn bac aydel y neči d lkahen. <verse eid="EXO 28:3" /><verse number="4" style="v" sid="EXO 28:4" />qa d ayuh lliy yexs aggen seg uṣireḍ y haruwn; tmeṣdurt aḏ rdi aḏ tḏellukt aḏ tsurit s llexṭuṭ aḏ tezmelt aḏ cemleṯ. yexs ateneggen d ṣireḍ d meqdus y haruwn aḏ ṭarwas bac aledlen d lkuhhan. <verse eid="EXO 28:4" /><verse number="5" style="v" sid="EXO 28:5" />aḏ yexs atenneszen seg tnelwin n wureγ aḏ ulman d izizewen aḏ d iḥberiyen aḏ d izuggaγen aḏ seg ustu n tefduxt ṣbiḥ.<verse eid="EXO 28:5" /></para>
  <para style="s">rdi naγ lefuwd</para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 28:6" />amma rdi adj ategnan indin lliy tquddun agenna seg tnelwin n wureγ aḏ ulman d izizewen aḏ d iḥberiyen aḏ d izuggaγen aḏ seg ustu n tefduxt lliy yeḏra yeqƹeḏ. <verse eid="EXO 28:6" /><verse number="7" style="v" sid="EXO 28:7" />we aqnen leḍrafis s nnaj bac adyas af tγerdin.<verse eid="EXO 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 28:8" />aḏ leḥzemis aydel yelṣeq diyes. aḏ yemmug am netta seg tnelwin n wureγ aḏ ulman d izizewen aḏ d iḥberiyen aḏ d izuggaγen aḏ seg ustu n tefduxt ṣbiḥ.<verse eid="EXO 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 28:9" />we aneqceḏ af sen tγuγa n ljizeƹ ismawen n ṭarwa n yeƹquwb. <verse eid="EXO 28:9" /><verse number="10" style="v" sid="EXO 28:10" />kul 6 sisen af tγuγa af leḥsab n as n tleliṯesen. <verse eid="EXO 28:10" /><verse number="11" style="v" sid="EXO 28:11" />we aḏeγzeḏ ismawen n aṯ israyil af tγuγa mammeḵ iteg lliy ineqqec af txuṯam n uṣeḥḥeḥ. tegetent g lḥaweci n wureγ. <verse eid="EXO 28:11" /><verse number="12" style="v" sid="EXO 28:12" />we aggeḏ ayuh n tγuγa af tγerdin n lufud bac adleneṯ d tγuγa n usmiti y aṯ israyil. we ayqam haruwn ismawnesen af tγerdinis y usmita zzaṯ rebbiy. <verse eid="EXO 28:12" /><verse number="13" style="v" sid="EXO 28:13" />we aggeḏ sent leḥluq n wureγ, <verse eid="EXO 28:13" /><verse number="14" style="v" sid="EXO 28:14" />aḏ sen tselslin seg wureγ ṣbiḥ ḏreneṯ am tezra bac atentƹelqeḏ g leḥluq.<verse eid="EXO 28:14" /></para>
  <para style="s">temeṣdurt n lḥukem</para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 28:15" />mmel y lliy gennan yeqƹeḏ agnan tmeṣdurt n lḥukem bac ayssen siyes haruwn matta yexs rebbiy. atetteggen mammeḵ ggen lufud seg tnelwin n wureγ aḏ ulman d izizewen aḏ d iḥberiyen aḏ d izuggaγen aḏ ustu n tefduxt ṣbiḥ. <verse eid="EXO 28:15" /><verse number="16" style="v" sid="EXO 28:16" />we addel timrebbeƹt aḏ ṭuḍi af sen aḏ ṭṭulis am lƹerḍis cebber. <verse eid="EXO 28:16" /><verse number="17" style="v" sid="EXO 28:17" />we asteggeḏ 4 n ḏuren n tγuγa tiṣbiḥin; ḏur mezwar d leƹqiq zuggaγ aḏ lyaquwt awreγ aḏ zmurreḏ, <verse eid="EXO 28:17" /><verse number="18" style="v" sid="EXO 28:18" />ḏur wissen d lburehman aḏ lyaquwt zizaw aḏ leƹqiq mellal, <verse eid="EXO 28:18" /><verse number="19" style="v" sid="EXO 28:19" />ḏur wi 3 seg tγuγa n ƹin lhir aḏ lyecmu aḏ jemmectu. <verse eid="EXO 28:19" /><verse number="20" style="v" sid="EXO 28:20" />ḏur 4 seg tγuγa n zberjeḏ aḏ lyecb aḏ ljizƹ. amyuh ateneggeḏ g lḥacit n wureγ. <verse eid="EXO 28:20" /><verse number="21" style="v" sid="EXO 28:21" />we aḏeγzeḏ af kul tγuγa teṣbiḥt ysem n yjen seg 12 n aṯ israyil mammeḵ aγezzen af txeṯemt n uṣeḥḥeḥ.<verse eid="EXO 28:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 28:22" />we aggeḏ y tmeṣdurt sen tseleslin ḏreneṯ seg wureγ ṣbiḥ am tezra lliy teḏra. <verse eid="EXO 28:22" /><verse number="23" style="v" sid="EXO 28:23" />we aggeḏ g ṭṭerf n tmeṣdurt sen tḥelqeṯin n wureγ. <verse eid="EXO 28:23" /><verse number="24" style="v" sid="EXO 28:24" />we aqneḏ tiseleslin lliy ḏreneṯ g tḥelqeṯin n tmeṣdurt. <verse eid="EXO 28:24" /><verse number="25" style="v" sid="EXO 28:25" />we atenteqneḏ g tḥelqeṯin n tγerdin n lufud s zzaṯ.<verse eid="EXO 28:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 28:26" />we aggeḏ sen tḥelqeṯin n wureγ g ṭṭerf n tmeṣdurt s jjaj mani telṣeq af rdi. <verse eid="EXO 28:26" /><verse number="27" style="v" sid="EXO 28:27" />we aggeḏ sen tḥelqeṯin iḍen n wureγ adug ṣder mani inetged leḥzam. <verse eid="EXO 28:27" /><verse number="28" style="v" sid="EXO 28:28" />we atenteqneḏ al tḥelqeṯin n tmeṣdurt s ulman izizewen lliy ḏren, bac ateqqim temeṣdurt nnaj rdi aḏ witettuṭṭic.<verse eid="EXO 28:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 28:29" />we ayqam haruwn ismawen n aṯ israyil g tmeṣdurt n lḥukem af ulis d smiti diyma zzaṯ rebbiy almiy tayeḏef al lquds. <verse eid="EXO 28:29" /><verse number="30" style="v" sid="EXO 28:30" />we aggeḏ g tmeṣdurt luwriym aḏ ttemiym bac ateniqam haruwn af ulis almiy tayebbed zzaṯ rebbiy. aḏ amyuh aywiy haruwn diyma af ṣedris d lemereṯ n lḥukem bac ayssen lxiyr n aṯ israyil.<verse eid="EXO 28:30" /></para>
  <para style="s">tḏellukt</para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 28:31" />amma tḏellukt yexs addel lkulha seg leqmac d zizew. <verse eid="EXO 28:31" /><verse number="32" style="v" sid="EXO 28:32" />γares imi n iγef g amas aḏ lburcman yeṣḥiḥ bac witetkeṣṣic. <verse eid="EXO 28:32" /><verse number="33" style="v" sid="EXO 28:33" />aḏ adrjeḥneṯ g ṭṭerfis s dday tirummanin s ulman d izizewen aḏ d iḥberiyen aḏ d izuggaγen, we aƹelqeḏ jareseneṯ dnaden n wureγ. <verse eid="EXO 28:33" /><verse number="34" style="v" sid="EXO 28:34" />jar kul sen tirummanin dendan. aḏ yexs ateneggeḏ lkul af ṭṭerf n tḏellukt. <verse eid="EXO 28:34" /><verse number="35" style="v" sid="EXO 28:35" />we ayireḍ haruwn tḏellukt kul man ayeḏef y lxeḏmeṯ, we ayemmusel lḥes n dnaden g iḏafis aḏ iffaγis al lquds zzaṯ rebbiy bac wiyetmettic.<verse eid="EXO 28:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 28:36" />we aggeḏ teḥdit n wureγ ṣbiḥ, teγzeḏ fellas mammeḵ yetweγez af txaṯemt n uṣeḥḥeḥ: «lquds y rebbiy.» <verse eid="EXO 28:36" /><verse number="37" style="v" sid="EXO 28:37" />teqnetteṯ s tnelli tezizewt af tezmelt n haruwn s zzaṯ. <verse eid="EXO 28:37" /><verse number="38" style="v" sid="EXO 28:38" />we addel diyma af ujebbuh n haruwn, bac ayqam bekkeḍu n aṯ israyil almiy ucen y rebbiy teγrest witeqƹic. aḏ yexs haruwn ayeg teḥdit diyma almiy tayebbed zzaṯ rebbiy bac ayerla rebbiy fellasen.<verse eid="EXO 28:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="EXO 28:39" />we aggeḏ tsurit s llexṭuṭ aḏ tezmelt y haruwn seg leqmac n tefduxt, amma cemleṯ yexs atetṭerzeḏ ṭrizeṯ teṣbiḥt. <verse eid="EXO 28:39" /><verse number="40" style="v" sid="EXO 28:40" />we aggeḏ zada y ṭarwa n haruwn tisuriyin aḏ cmali aḏ tizmelin bac asenterniḏ lmejd aḏ lwehreṯ. <verse eid="EXO 28:40" /><verse number="41" style="v" sid="EXO 28:41" />we atenṣirdeḏ y haruwn aḏ ṭarwas. we aneγleḏ uḏi n uzemmur af ixfewnesen. we ateneggeḏ y lxeḏemtiw, we atenqedseḏ bac aḏulen d lkuhhan y neči.<verse eid="EXO 28:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="EXO 28:42" />we asenteggeḏ yserwalen n tefduxt bac asetren imanesen seg irewnesen al teγmiwinesen. <verse eid="EXO 28:42" /><verse number="43" style="v" sid="EXO 28:43" />yexs atenirden haruwn aḏ ṭarwas adug tisuriyinesen almiy taḏeḏfen al lƹecceṯ n umlaqi aḏ almiy taqerben al mkan n teγrest bac aggen lwejbesen g lquds. aḏ amyuh wilγeldenc aḏ witmetinc. we aydel ayuh d lferḍ diyma af haruwn aḏ ṭarwas ljiyl beƹd ljiyl.<verse eid="EXO 28:43" /></para>
  <chapter eid="EXO 28" />
  <chapter number="29" style="c" sid="EXO 29" />
  <para style="s">qeddes n lkuhhan</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 29:1" />ayuh matta yexs aggeḏ bac arreḏ haruwn aḏ ṭarwas d lkuhhaniw. adeγeḏ fwunes aḏ sen iberkas widdisenc lula. <verse eid="EXO 29:1" /><verse number="2" style="v" sid="EXO 29:2" />we aggeḏ s ren n irden yeldeḍ aḏ uḏi tqurset man γiyr lexmireṯ we aƹejneḏ ren s uḏi bac aggeḏ tqurset iḍen man γiyr lexmireṯ aḏ aggeḏ tqurset n ṭedjen teḏhen s uḏi man γiyr lexmireṯ. <verse eid="EXO 29:2" /><verse number="3" style="v" sid="EXO 29:3" />we ateneggeḏ g tƹellegt ijeṯ we atenuceḏ y rebbiy nihnin aḏ ufwunes aḏ sen iberkas. <verse eid="EXO 29:3" /><verse number="4" style="v" sid="EXO 29:4" />wembeƹd asγuyeḏ y haruwn aḏ ṭarwas al imi n lƹecceṯ n umlaqi we asentemleḏ azizdiyen s aman. <verse eid="EXO 29:4" /><verse number="5" style="v" sid="EXO 29:5" />we asṣirdeḍ haruwn tsurit aḏ tḏellukt aḏ lufud aḏ tmeṣdurt we aqneḏ lufud s leḥzam lliy yeṭrez. <verse eid="EXO 29:5" /><verse number="6" style="v" sid="EXO 29:6" />we asteggeḏ tezmelt af ixfis, we asteggeḏ s zzaṯ teḥdit temeqdust. <verse eid="EXO 29:6" /><verse number="7" style="v" sid="EXO 29:7" />we aqemeḏ uḏi meqdus atneγleḏ af ixfis bac atnumreḏ.<verse eid="EXO 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 29:8" />wembeƹd asγuyeḏ af ṭarwas we asentirḍeḏ tisuriyin n lkuhhan, <verse eid="EXO 29:8" /><verse number="9" style="v" sid="EXO 29:9" />aḏ cmalisen aḏ tizmelinesen bac aḏulen d lkuhhaniw y diyma. aḏ amyuh arreḏ haruwn aḏ ṭarwas d lkuhhan.<verse eid="EXO 29:9" /></para>
  <para style="s">teγrest y umukes n ubekkeḍu</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 29:10" />wembeƹd sebbed fwunes zzaṯ lƹecceṯ n umlaqi bac aggen haruwn aḏ ṭarwas ifesnesen s sen af ixfis. <verse eid="EXO 29:10" /><verse number="11" style="v" sid="EXO 29:11" />we atγerseḏ zzaṯ rebbiy af imi n lƹecceṯ n umlaqi. <verse eid="EXO 29:11" /><verse number="12" style="v" sid="EXO 29:12" />we awyeḏ seg iḏemmen n ufwunes, we ateggeḏ af leqruwn n mkan n teγrest s daḍiḵ, we aneγleḏ lliy yefdelled g tqeƹatis. <verse eid="EXO 29:12" /><verse number="13" style="v" sid="EXO 29:13" />wembeƹd aqemeḏ rdi n duwert aḏ teḏumt n tessa aḏ tijjal s teḏumtesen we atenḥerqeḏ af umkan n teγrest. <verse eid="EXO 29:13" /><verse number="14" style="v" sid="EXO 29:14" />amma yessum n ufwunes aḏ ylimis aḏ lusexis atenḥerqeḏ s barra y lmuxeyyem. rahiy netta d teγrest d tekuffert.<verse eid="EXO 29:14" /></para>
  <para style="s">ḥreq n uberkus mezwar y rebbiy</para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 29:15" />we adeγeḏ yjen seg iberkas bac aggen haruwn aḏ ṭarwas ifesnesen s sen af ixfis. <verse eid="EXO 29:15" /><verse number="16" style="v" sid="EXO 29:16" />atγerseḏ we arucceḏ seg iḏemnis af 4 n lejnab n mkan n teγrest. <verse eid="EXO 29:16" /><verse number="17" style="v" sid="EXO 29:17" />we ateqedƹeḏ, we asirdeḏ leḍrafis idexleniyen aḏ idernis we ateneggeḏ nihnin yid ixfis yid yessumis nnaj mkan n teγrest. <verse eid="EXO 29:17" /><verse number="18" style="v" sid="EXO 29:18" />we astesiγeḏ timsi af mkan n teγrest, we addel rriḥtis d ṣṣedqeṯ n ḥreq y rebbiy bac ayerla. rahiy d ṣṣedqeṯ n ḥreq y rebbiy.<verse eid="EXO 29:18" /></para>
  <para style="s">berkus n uqeddes n haruwn aḏ ṭarwas</para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 29:19" />we adeγeḏ berkus wissen bac aggen haruwn aḏ ṭarwas ifesnesen s sen af ixfis. <verse eid="EXO 29:19" /><verse number="20" style="v" sid="EXO 29:20" />wembeƹd atγerseḏ we aqemeḏ seg iḏemnis. ateggeḏ af tleflufin n tmezzuγin n limin n haruwn aḏ ṭarwas, aḏ af idudan imeqqaren n ifesnesen n limin, aḏ af tifdinin timeqqarin n idernesen limin. we arucceḏ iḏemmen af 4 n lejnab n mkan n teγrest. <verse eid="EXO 29:20" /><verse number="21" style="v" sid="EXO 29:21" />we aqemeḏ fercu seg iḏemmen lliy af mkan n teγrest aḏ seg uḏi meqdus we aqeṭreḏ siyes af haruwn aḏ ṭarwas aḏ af leḥweyjesen bac amqudsen nihnin aḏ leḥweyjesen y rebbiy.<verse eid="EXO 29:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 29:22" />we awyeḏ teḏumt n berkus aḏ llitis aḏ uselsu aḏ teḏumt n tessa aḏ tijjal aḏ teḏumt lliy fellesneṯ aḏ lektef n limin afelxaḍert netta d berkus n uqeddes n lkuhhan.<verse eid="EXO 29:22" /></para>
  <para style="s">ṣṣedqeṯ y userli n rebbiy</para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 29:23" />we aqemeḏ tqurset ijeṯ aḏ ijeṯ seg tiqurset lliy teƹjenteṯ s uḏi aḏ tqurset n ṭedjen ijeṯ seg tƹellegt lliy teggiteṯ zzaṯ rebbiy. <verse eid="EXO 29:23" /><verse number="24" style="v" sid="EXO 29:24" />we ateneggeḏ lkulhum jar ifesn n haruwn aḏ ṭarwas bac atenderejḥen zzaṯ rebbiy. <verse eid="EXO 29:24" /><verse number="25" style="v" sid="EXO 29:25" />wembeƹd atenelqiḏ s γarsen we asentessiγeḏ af mkan n teγrest bac ateli rriḥeṯ we ayerla rebbiy. rahiy d ṣṣedqeṯ n ḥreq y rebbiy. <verse eid="EXO 29:25" /><verse number="26" style="v" sid="EXO 29:26" />we aqemeḏ ṣder n uberkus n uqeddes n haruwn we atderejḥeḏ zzaṯ rebbiy. we aydel aydin d lbeyiḵ seg teγrest. <verse eid="EXO 29:26" /><verse number="27" style="v" sid="EXO 29:27" />aḏ yexs aqedseḏ ṣder aḏ lektef n uberkus n uqeddes n haruwn aḏ ṭarwas lliy derejḥenten zzaṯiw <verse eid="EXO 29:27" /><verse number="28" style="v" sid="EXO 29:28" />bac adlen d lbay n haruwn aḏ ṭarwas. aḏ d lwajeb af aṯ israyil y diyma atucen d lbay n lkuhhan seg teγrest n slemeṯ lliy tatetucen y rebbiy.<verse eid="EXO 29:28" /></para>
  <para style="s">mammeḵ aqedsem lkuhhan ijdiḏen seg ṭerwa n haruwn</para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 29:29" />aḏ aḥḥerzeṯ leḥweyej imeqdusen n haruwn bac aggem mam beƹdis d lkahen seg ṭarwas we aneγlem uḏi meqdus af ixfewnesen bac atenqedsem. <verse eid="EXO 29:29" /><verse number="30" style="v" sid="EXO 29:30" />aḏ yexs lliy tadyas beƹdis d meqqar n lkuhhan atenyireḍ 7 d ussanaṯ almiy tayeḏef al lƹecceṯ n umlaqi bac ayeḏwel d lkahen y rebbiy g umeqdus.<verse eid="EXO 29:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 29:31" />we awyeḏ yessum n uberkus n uqeddes we atesdiybeḏ g umkan d meqdus. <verse eid="EXO 29:31" /><verse number="32" style="v" sid="EXO 29:32" />aḏ yexs haruwn aḏ ṭarwas atečen netta aḏ tiqurset lliy g tƹellegt af imi n lƹecceṯ n umlaqi. <verse eid="EXO 29:32" /><verse number="33" style="v" sid="EXO 29:33" />witet siyes ḥetta d yjen afelxaḍert d meqdus. yexs weḥdesen ačan siyes afelxaḍert netta d tekuffert n ibekkaḍnesen bac aḏulen d lkuhhan. <verse eid="EXO 29:33" /><verse number="34" style="v" sid="EXO 29:34" />aḏ kan yefdelled fercu seg yessum n uqeddes naγ seg tiqurset al tajji, yexs atḥerqeḏ s timsi. witet siyes ḥed afelxaḍert d meqdus.<verse eid="EXO 29:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 29:35" />amyuh aggeḏ y haruwn aḏ ṭarwas mammeḵ uwiγeḵ, atenqedseḏ 7 d ussanaṯ bac atenerreḏ d lkuhhan. <verse eid="EXO 29:35" /><verse number="36" style="v" sid="EXO 29:36" />aγerseḏ kul as disen fwunes d teγrest d tekuffert. we aqedseḏ mkan n teγrest s teγrest d tekuffert aḏ nγal n uḏi. <verse eid="EXO 29:36" /><verse number="37" style="v" sid="EXO 29:37" />7 d ussanaṯ aγerseḏ d tekuffert af mkan n teγrest we atqedseḏ bac aydel d lquds n leqdas. aḏ kul ḥed naγ ḥaja ayeṭṭef diyes ayeḏwel d meqdus.<verse eid="EXO 29:37" /></para>
  <para style="s">matta yexs aγersen kul as</para>
  <para style="p">
    <verse number="38" style="v" sid="EXO 29:38" />yexs aγerseḏ af mkan n teγrest sen iberkas kul as diyma. <verse eid="EXO 29:38" /><verse number="39" style="v" sid="EXO 29:39" />yjen ateγerseḏ tajji aḏ yjen temeddiṯ. <verse eid="EXO 29:39" /><verse number="40" style="v" sid="EXO 29:40" />we aḏuceḏ kul yjen sisen yid lgelbeṯ seg ren lleṭuḍ lliy yerwi s litreṯ aḏ wezgen n uḏi n uzemmur, we aneγleḏ fellas deqsis d crab. <verse eid="EXO 29:40" /><verse number="41" style="v" sid="EXO 29:41" />we aγerseḏ berkus wissen temeddiṯ. we atuceḏ netta aḏ ren lleṭuḍ d ṣṣedqeṯ n tiγwaw aḏ crab mammeḵ teggiḏ tajji bac ateli rriḥeṯ n ṣṣedqeṯ we ayerla rebbiy. rahiy nettaṯ d ṣṣedqeṯ n ḥreq y rebbiy.<verse eid="EXO 29:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="EXO 29:42" />we aḥerqem amyuh diyma zzaṯ rebbiy af tmeddurt n lejyeluwem af imi n lƹecceṯ n umlaqi mani tafleqiγ aḏ mani duggiγaḵ. <verse eid="EXO 29:42" /><verse number="43" style="v" sid="EXO 29:43" />aḏ mani tamleqiγ yid aṯ israyil zada, we ayemqudes mkan s lmejdiw.<verse eid="EXO 29:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="EXO 29:44" />we aqedseγ lƹecceṯ n umlaqi aḏ mkan n teγrest mammeḵ taqedseγ haruwn aḏ ṭarwas d lkuhhan. <verse eid="EXO 29:44" /><verse number="45" style="v" sid="EXO 29:45" />we asekneγ jar aṯ israyil we asenedleγ d rebbiy, <verse eid="EXO 29:45" /><verse number="46" style="v" sid="EXO 29:46" />bac asennen lliy d neči d rebbiy, rebbiysen lliy sefγexten seg miṣr bac asekneγ jaresen. rahiy neči d lliy diyma yella, rebbiysen.<verse eid="EXO 29:46" /></para>
  <chapter eid="EXO 29" />
  <chapter number="30" style="c" sid="EXO 30" />
  <para style="s">mkan n ubexxer</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 30:1" />we aggeḏ seg isγaren n ssenṭ mkan n ubexxer. <verse eid="EXO 30:1" /><verse number="2" style="v" sid="EXO 30:2" />yexs aydel d imrebbeƹ ṭṭulis am lƹerḍis dereƹ, aḏ lƹulwis sen leḏruƹ, aḏ leqrunis lṣeqqen diyes. <verse eid="EXO 30:2" /><verse number="3" style="v" sid="EXO 30:3" />we atγelfeḏ lkul s wureγ ṣbiḥ; seṭeḥtis aḏ lejnabis aḏ leqrunis, we asteggeḏ lḥacit n wureγ. <verse eid="EXO 30:3" /><verse number="4" style="v" sid="EXO 30:4" />aḏ adug lḥacit yexs aggeḏ sen tḥelqeṯin g kul jneb bac aḏeḏfen disneṯ igeḍman n uqami <verse eid="EXO 30:4" /><verse number="5" style="v" sid="EXO 30:5" />lliy yexs ateneggeḏ seg isγaren n ssenṭ we atenγelfeḏ s wureγ. <verse eid="EXO 30:5" /><verse number="6" style="v" sid="EXO 30:6" />yexs aserseḏ mkan n ubexxer g leqbeleṯ n star lliy zzaṯ ttebuwt n luwṣayaṯ. aḏ g leqbeleṯ n ddan n ttebuwt mani tafleqiγ af lƹerc n rreḥmeṯ.<verse eid="EXO 30:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 30:7" />yexs aybexxer haruwn kul tajji almiy taysendef nnir, <verse eid="EXO 30:7" /><verse number="8" style="v" sid="EXO 30:8" />aḏ temeddiṯ almiy tayessiγ nnir zada. aḏ yexs ayeqqim ayuh n lebxuwr yesseγa diyma azzaṯ rebbiy. ayuh d lwajeb fellewem ljiyl beƹd ljiyl. <verse eid="EXO 30:8" /><verse number="9" style="v" sid="EXO 30:9" />wiḥerreqc af ayuh n mkan n ubexxer aγrib naγ teγrest n ḥreq naγ ṣṣedqeṯ n tiγwaw naγ ṣṣedqeṯ n nγal. <verse eid="EXO 30:9" /><verse number="10" style="v" sid="EXO 30:10" />we ayruc haruwn af leqrunis seg iḏemmen n teγrest d tekuffert tijekkelt ijeṯ g usuggas bac atyqedes. ayuh d lwajeb seg ljiyl al ljiyl afelxaḍert netta d lquds n leqdas y rebbiy.<verse eid="EXO 30:10" /></para>
  <para style="s">tekuffert n teḵrumt</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 30:11" />yuwa lliy diyma yella y muwsa: <verse eid="EXO 30:11" /><verse number="12" style="v" sid="EXO 30:12" />«almiy taƹuddeḏ aṯ israyil, yexs kul yjen sisen alyeḏfeƹ tekuffert af imanis bac wisendyettic lwaf g lweqt n uƹuddu. <verse eid="EXO 30:12" /><verse number="13" style="v" sid="EXO 30:13" />qa matta yexs alucen lliy ḥuḍḍen y uƹuddu; 6 d legremaṯ n lfejreṯ afelḥesab n almiyzan n ccaqel meqdus. <verse eid="EXO 30:13" /><verse number="14" style="v" sid="EXO 30:14" />kul yjen iḥuḍ y uƹuddu seg indin lliy γarsen 20 d isuggasen naγ iṭer yexs alyuc tekuffert n teḵrumtis. <verse eid="EXO 30:14" /><verse number="15" style="v" sid="EXO 30:15" />we aḏefƹen midden lkul kifkif; la ayerni lliy labas ƹlih, la aysenqez lliy wiγrec afelxaḍert nettaṯ d tekuffert n tḵermin y neči. <verse eid="EXO 30:15" /><verse number="16" style="v" sid="EXO 30:16" />aḏ ayuh n lfejreṯ lliy tatleymeḏ seg uƹuddu yexs atetṣerfeḏ af lƹecceṯ n umlaqi bac adesmitan aṯ israyil tekuffert n tḵerminesen zzaṯiw.»<verse eid="EXO 30:16" /></para>
  <para style="s">fedja n uzizdi</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 30:17" />yuwa lliy diyma yella y muwsa: <verse eid="EXO 30:17" /><verse number="18" style="v" sid="EXO 30:18" />«agg fedja n nḥas. teserset jar lƹecceṯ n umlaqi aḏ mkan n teγrest. tečaret s aman <verse eid="EXO 30:18" /><verse number="19" style="v" sid="EXO 30:19" />bac asirden haruwn aḏ ṭarwas ifesnesen aḏ idernesen siyes. <verse eid="EXO 30:19" /><verse number="20" style="v" sid="EXO 30:20" />yexs asirden leḍrefesen almiy taḏeḏfen al lƹecceṯ n umlaqi naγ taḏucen teγrest n ḥreq af mkan n teγrest bac witmetinc. <verse eid="EXO 30:20" /><verse number="21" style="v" sid="EXO 30:21" />rahiy yexs asirden idernesen aḏ ifesnesen bac witmetinc. we aydel ayuh d lwajeb diyma af haruwn aḏ ṭarwas ljiyl beƹd ljiyl.»<verse eid="EXO 30:21" /></para>
  <para style="s">igga n uḏi meqdus</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 30:22" />yuwa lliy diyma yella y muwsa: <verse eid="EXO 30:22" /><verse number="23" style="v" sid="EXO 30:23" />«aγed ifuḥan ṣbiḥen; 6 kilu n lmur ṣbiḥ lliy d ṣerṣur, aḏ 3 kilu n lqerfeṯ, aḏ 3 kilu seg tqeṣbeyin n leqṭenyeṯ lliy fewḥa, <verse eid="EXO 30:23" /><verse number="24" style="v" sid="EXO 30:24" />aḏ 6 kilu seg leqmari afelḥesab n almiyzan n ccaqel meqdus, aḏ 6 litrat n uḏi n uzemmur ṣbiḥ. <verse eid="EXO 30:24" /><verse number="25" style="v" sid="EXO 30:25" />teggeḏ siyes uḏi meqdus yuqedes aḏ faweḥ aḏ d ṣbiḥ mammeḵ yetquddu atyeg lliy d lfeleḥ g uxelleḍ n lebxuwr bac aydel d uḏi meqdus yuqedes. <verse eid="EXO 30:25" /><verse number="26" style="v" sid="EXO 30:26" />we adehneḏ siyes lƹecceṯ n umlaqi aḏ ttebuwt n luwṣayaṯ, <verse eid="EXO 30:26" /><verse number="27" style="v" sid="EXO 30:27" />aḏ ṭṭewleṯ aḏ reγeltis, aḏ nnir aḏ reγeltis, aḏ mkan n ubexxer, <verse eid="EXO 30:27" /><verse number="28" style="v" sid="EXO 30:28" />aḏ mkan n teγrest aḏ reγeltis, aḏ ufedja aḏ tqeƹetis. <verse eid="EXO 30:28" /><verse number="29" style="v" sid="EXO 30:29" />atenqedseḏ we aḏulen d lquds n leqdas. aḏ kul ḥaja ateṭṭef disen ateḏwel temeqdust.<verse eid="EXO 30:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 30:30" />we adehneḏ haruwn aḏ ṭarwas we atenqedseḏ bac aḏulen d lkuhhaniw. <verse eid="EXO 30:30" /><verse number="31" style="v" sid="EXO 30:31" />we amleḏ y aṯ israyil: &lt; rahiy ayuh n uḏi y rebbiy d uḏi d meqdus yuqedes ljiyl beƹd ljiyl. &gt; <verse eid="EXO 30:31" /><verse number="32" style="v" sid="EXO 30:32" />wienneγlec siyes af ḥed iḍen aḏ witteggec s leqyeseṯis uḏi am netta. rahiy netta d meqdus. aḏ yexs adesmitim diyma lliy netta d meqdus. <verse eid="EXO 30:32" /><verse number="33" style="v" sid="EXO 30:33" />rahiy kul yjen ayeg am ayuh n uḏi naγ ayeḏhen siyes yjen muc seg lkuhhan ayemmuxdef seg middenis.»<verse eid="EXO 30:33" /></para>
  <para style="s">mammeḵ yexs aggen lebxuwr</para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 30:34" />yuwa lliy diyma yella y muwsa: «aγed seg ayuh n leƹqaqer deqqes n beƹeḍhum; almiyƹeṯ, aḏ nnad, aḏ lqinneṯ lliy fewḥa, aḏ lluban ṣbiḥ. <verse eid="EXO 30:34" /><verse number="35" style="v" sid="EXO 30:35" />aḏ xeldin s tisent we aggeḏ sisen lbxur d ṣbiḥ aḏ d meqdus, mammeḵ iteg lliy d lfeleḥ g uxelleḍ n lebxuwr. <verse eid="EXO 30:35" /><verse number="36" style="v" sid="EXO 30:36" />we azdeḏ fercu siyes we ateggeḏ zzaṯ ttebuwt g lƹecceṯ n umlaqi mani tafleqiγ. we aydel d lquds n leqdas γarwem zada. <verse eid="EXO 30:36" /><verse number="37" style="v" sid="EXO 30:37" />aḏ witeg ḥetta d yjen leqyeseṯis g igga n lebxuwr am netta. we aydel γarwem d meqdus y neči weḥdi. <verse eid="EXO 30:37" /><verse number="38" style="v" sid="EXO 30:38" />rahiy kul yjen ayeg lebxuwr am netta bac atycum ayemmukes seg middenis.»<verse eid="EXO 30:38" /></para>
  <chapter eid="EXO 30" />
  <chapter number="31" style="c" sid="EXO 31" />
  <para style="s">semmi n indin lliy tabnan meqdus</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 31:1" />aḏ yuwa lliy diyma yella y muwsa:<verse eid="EXO 31:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 31:2" />«qa neči waziγ beṣleyil memmis n uwriy aḏ memmis n memmis n ḥuwr seg lƹerc n yehuwḏa, aḏ sγuyγas s ismis. <verse eid="EXO 31:2" /><verse number="3" style="v" sid="EXO 31:3" />rahiy čurext seg rruwḥiw aḏ uciγas lefker aḏ temesniwt aḏ uquddu n ṣnayeƹ lkul, <verse eid="EXO 31:3" /><verse number="4" style="v" sid="EXO 31:4" />bac ayxeṭṭeṭ iḥejeyen lliy tatenyeg seg wureγ aḏ lfejreṯ aḏ nḥas, <verse eid="EXO 31:4" /><verse number="5" style="v" sid="EXO 31:5" />aḏ bac ayeṣqel ljuher we atyesry, aḏ bac ayeqdeƹ isγaren we ayeg kul ciy.<verse eid="EXO 31:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 31:6" />aḏ waziγ ahuwlyab memmis n xiysamak seg lƹerc n dan bac atiƹawen. aḏ uciγ y sṭaweṯ lkul quddu widdic am netta bac aggen lliy uwiγaḵ fellas lkul; <verse eid="EXO 31:6" /><verse number="7" style="v" sid="EXO 31:7" />lƹecceṯ n umlaqi, aḏ ttebuwt n luwṣayaṯ s ddan lliy anjis, aḏ reγleṯ n lƹecceṯ lkul, <verse eid="EXO 31:7" /><verse number="8" style="v" sid="EXO 31:8" />aḏ ṭṭewleṯ aḏ reγeltis, aḏ nnir meqdus n wureγ aḏ reγeltis, aḏ mkan n ubexxer, <verse eid="EXO 31:8" /><verse number="9" style="v" sid="EXO 31:9" />aḏ mkan n teγrest aḏ reγeltis. aḏ ufedja n uzizdi aḏ tqeƹetis. <verse eid="EXO 31:9" /><verse number="10" style="v" sid="EXO 31:10" />aḏ leḥweyej lliy zden yeqƹeḏ; leḥweyej imeqdusen n haruwn aḏ ṭarwas lkuhhan lliy reḍenten almiy taggen lwajeb g umeqdus. <verse eid="EXO 31:10" /><verse number="11" style="v" sid="EXO 31:11" />aḏ uḏi meqdus. aḏ lebxuwr lliy faweḥ. yexs aggen ayuh lkul mammeḵ siḵenγaḵ.»<verse eid="EXO 31:11" /></para>
  <para style="s">steḥfeḍ af as n sebbeṯ</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 31:12" />yuwa lliy diyma yella y muwsa:<verse eid="EXO 31:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 31:13" />«mmel y aṯ israyil: steḥefdeṯ af ussaniw, ussan n sebbeṯ afelxaḍert nihnin d lemerṯ n lƹehd lliy jarenneγ y diyma, bac asnem lliy neči d rebbiy lliy yetqeddes diwem.<verse eid="EXO 31:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 31:14" />steḥefdeṯ af as n sebbeṯ. rahiy d meqdus γarwem. kul yjen ayeṯƹedda af as n sebbeṯ naγ ayexdem diyes ayemmuṯ we ayemmuxdef seg middenis. <verse eid="EXO 31:14" /><verse number="15" style="v" sid="EXO 31:15" />axedmem 6 d ussanaṯ amma as n sebbeṯ rahiy d rreḥeṯ temeqdust y neči. aḏ kul yjen ayexdem diyes ayemmunγ.<verse eid="EXO 31:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 31:16" />rahiy aṯ israyil yexs asteḥefden af sebbeṯ we aferḥen siyes g lejyelesen lkul, aḏ ayuh d lƹehd y diyma. <verse eid="EXO 31:16" /><verse number="17" style="v" sid="EXO 31:17" />rahiy ayuh d lemereṯ n lƹehd jariḏd iḏuwem y diyma, afelxaḍert g 6 d ussanaṯ ggiγ tammurt aḏ ujenna aḏ g as wi 7 kemleγ.»<verse eid="EXO 31:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 31:18" />aḏ lemmi ykemmel rebbiy dwiys y muwsa g jbel n siynay, yucas sen tγuγa n luwṣayaṯ. aḏ nihintin d lelwaḥ seg tiḍγaγin urineṯ s ffus n rebbiy.<verse eid="EXO 31:18" /></para>
  <chapter eid="EXO 31" />
  <chapter number="32" style="c" sid="EXO 32" />
  <para style="s">haruwn iteg g ufwunes n wureγ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 32:1" />mniyn ufen midden lliy muwsa iƹeṭṭel af jbel, mlaymen af haruwn uwanas: «kker ggeneγ rebbiy adj ayeyyur zzaṯenneγ. rahiy winessinc matta yeṭra y ayuh n muwsa lliy ysefγaneγ seg miṣr.»<verse eid="EXO 32:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 32:2" />yuwayasen haruwn: «kseṯ tibelluṭin n wureγ n tseḏnanuwem aḏ imeckenuwem aḏ yessiṯuwem tucmitend.» <verse eid="EXO 32:2" /><verse number="3" style="v" sid="EXO 32:3" />yaxy ksentent aḏ uγnestend. <verse eid="EXO 32:3" /><verse number="4" style="v" sid="EXO 32:4" />yelqeyineṯ s γarsen, iḏewbineṯ, yenγel sisneṯ fwunes. aḏ lweqt ḏḏin uwan: «ayuh d rebbiywem, ayya aṯ israyil, lliy ysefγawem seg miṣr.»<verse eid="EXO 32:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 32:5" />aḏ lemmi yezra haruwn aydin yeggi mkan n teγrest zzaṯ fwunes, yuwa: «ača d tfeṣka y rebbiy.» <verse eid="EXO 32:5" /><verse number="6" style="v" sid="EXO 32:6" />yaxy al ača tajji bekren midden ucen ṣṣedqeṯ n ḥreq aḏ aγresnas teγrest n slemeṯ. aḏ freḥḥen, čen, swen, wembeƹd kkeren tureren tbereṭƹen.<verse eid="EXO 32:6" /></para>
  <para style="s">tẓalliṯ n muwsa</para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 32:7" />yuwa lliy diyma yella y muwsa:</para>
  <para style="p" vid="EXO 32:7">«kker tezwiḏ. rahiy midden lliy tsefγten seg miṣr kferren. <verse eid="EXO 32:7" /><verse number="8" style="v" sid="EXO 32:8" />rahiy fiseƹ ttun ubriḏ lliy uwiγasen atḏebƹen. aḏ ggen fwunes s wureγ tẓallenas. γarresnas, aḏ mmalen: &lt; ayuh d rebbiywem, ayya aṯ israyil, lliy ysefγewem seg miṣr. &gt; »<verse eid="EXO 32:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 32:9" />aḏ yuwa lliy diyma yella y muwsa: «zriγ ṭuruh mennit d mƹendi ayuh n cceƹb aḏ ixfis yeqṣeḥ. <verse eid="EXO 32:9" /><verse number="10" style="v" sid="EXO 32:10" />mala djiḏ g uγeccecciw bac atenkemleγ, we aggeγ seg ṭarwaḵ cceƹb d meqqar.»<verse eid="EXO 32:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 32:11" />lekenti muwsa yezzul y rebbiy, aḏ ijeheyas:</para>
  <para style="p" vid="EXO 32:11">«maγer taγecceceḏ af cceƹbiḵ lliy tsefγet seg miṣr s lquweṯ temeqqart aḏ ffus yetquddu? <verse eid="EXO 32:11" /><verse number="12" style="v" sid="EXO 32:12" />maγer tacemteḏ diyneγ imiṣriyen bac amlen: &lt; rebbiysen yeggiṯ disen, ysefγin s yeh bac atenyenγ jar lejbal we atenimukes seg tammurt. &gt; ay rebbiy witγeccec, aḏ wisezwac af middeniḵ ayuh n leƹqab.<verse eid="EXO 32:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 32:13" />smitad lweƹdiḵ y leƹbidiḵ ibrahiym aḏ isḥaq aḏ israyil lliy tedjuldasen s imaniḵ, tuwidasen: &lt; tarniγ ṭarwawem am iṯran n ujenna, we afenuceγ ayuh n tammurt lliy uƹeḏḏeγ siyes y diyma. &gt; » <verse eid="EXO 32:13" /><verse number="14" style="v" sid="EXO 32:14" />yaxy yesxef rebbiy aḏ wisezwic leƹqab lliy yseggeḏ siyes middenis.<verse eid="EXO 32:14" /></para>
  <para style="s">muwsa yerza tilweḥin n luwṣayaṯ aḏ yezda fwunes</para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 32:15" />wembeƹd yezwa muwsa, yerred seg jbel aḏ netta iqam sen tilweḥin n luwṣayaṯ lliy teγez af uḏmewnesneṯ lkul tira. <verse eid="EXO 32:15" /><verse number="16" style="v" sid="EXO 32:16" />aḏ yusi rebbiy d netta lliy yeggi tilweḥin diyn aḏ yeγez fellesneṯ tira.<verse eid="EXO 32:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 32:17" />aḏ yesla yecuwƹ ṣeyyeḥ n midden, yuwa: «ayuh d lḥes n lḥerb g lmuxeyyem.»<verse eid="EXO 32:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 32:18" />yaxy yerras muwsa:</para>
  <para style="q1" vid="EXO 32:18">«ayuh muc d lḥes n rbaḥ naγ n lexsareṯ.</para>
  <para style="q1" vid="EXO 32:18">lliy seγdiγ diyes d lḥes n izli.»<verse eid="EXO 32:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 32:19" />aḏ mniyn yeqreb muwsa al lmuxeyyem aḏ yezra fwunes aḏ rqiṣ iγeccec aḏ yluweḥ tilweḥin diyn seg fusis yerzineṯ adug jbel. <verse eid="EXO 32:19" /><verse number="20" style="v" sid="EXO 32:20" />wembeƹd yewya fwunes n wureγ yeḥreqqi aḏ yezdi almiy yeḏwel yeldeḍ icetƹy af aman aḏ yewyasen aswen siyes b ssiyf.<verse eid="EXO 32:20" /></para>
  <para style="s">ilawiyyen tḥemen af cceriyƹeṯ</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 32:21" />aḏ yuwa muwsa y haruwn: «matta ggennaḵ ayuh n midden bac asenteγeḏ ayuh n ubekkeḍu meqqar.»<verse eid="EXO 32:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 32:22" />yaxy yerras haruwn: «witγeccec fella. ayya ami. rahiy cek tesenneḏ mennit wiyeḥli ayuh n cceƹb. <verse eid="EXO 32:22" /><verse number="23" style="v" sid="EXO 32:23" />uwaniḏ: &lt; ggeneγ rebbiy bac ayeyyur zeṯeneγ. rahiy winessinc mag yeṭra y ayuh n muwsa lliy ysefγeneγ seg miṣr. &gt; <verse eid="EXO 32:23" /><verse number="24" style="v" sid="EXO 32:24" />yaxy uwiγasen: &lt; lliy γares wureγ atyekkes we altiḏyuc. &gt; aḏ ggixt g timsi. yaxy yeffeγed ayuh n ufwunes.»<verse eid="EXO 32:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 32:25" />aḏ yezra muwsa midden lhan g lefseḏesen beƹd mag yedjin haruwn ggen lliy xsen aḏ ḏwellen d lmeḍeḥkeṯ n leƹdasen. <verse eid="EXO 32:25" /><verse number="26" style="v" sid="EXO 32:26" />yebbed af imi n lmuxeyyem, yuwa: «lliy ydebbeƹ g rebbiy adyas al deh.» yaxy mleymen fellas ilawiyyen.<verse eid="EXO 32:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 32:27" />yuwayasen: «ayuh mag yemmal rebbiy y aṯ israyil: adj ayqam kul yjen siwem ssiyfis, ureḥeṯ tesemd g lmuxeyyem s imi al imi tenγem lliy feseden ḥetta kan d uwaṯuwem naγ d ṣeḥbuwem naγ d rnawewem.» <verse eid="EXO 32:27" /><verse number="28" style="v" sid="EXO 32:28" />yaxy ggen ilawiyyen mag yuwa muwsa, aḏ mmunγen as diyn 3000 seg midden. <verse eid="EXO 32:28" /><verse number="29" style="v" sid="EXO 32:29" />lweqt ḏḏin yuwa muwsa y ilawiyyen: «as wuh tqedsem imanuwem y lxeḏmeṯ n rebbiy. aḏ ayuh yeṯkelfewem yeγla, afelxaḍert yella siwem mam yenγa uwas, aḏ yella jarewem mam yenγa memmis. adj afenyuc rebbiy tenemmirtis as wuh.»<verse eid="EXO 32:29" /></para>
  <para style="s">tẓalliṯ tisneṯ n muwsa</para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 32:30" />aḏ al ača yuwa muwsa y midden: «rahiy teggim bekkeḍu d meqqar. qa neči taḏelyeγ bac azelleγ y rebbiy. belekci afenyeγfer.» <verse eid="EXO 32:30" /><verse number="31" style="v" sid="EXO 32:31" />aḏ yeḏwel muwsa al rebbiy. yezzul, yuwa: «ay rebbiy rahiy midden ḥeccemniḏ iḏeḵ aḏ ggen bekkeḍu d meqqar aḏ rebbiy iḍen seg wureγ. <verse eid="EXO 32:31" /><verse number="32" style="v" sid="EXO 32:32" />afjahiγ ay rebbiy; aγefresen. kan wisentγefrec rni ksiḏ ḥetta neči seg lektabiḵ.»<verse eid="EXO 32:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 32:33" />yerra rebbiy y muwsa: «lliy yeggi bekkeḍu atmukseγ weḥdes seg lkitabiw. <verse eid="EXO 32:33" /><verse number="34" style="v" sid="EXO 32:34" />amma ṭuruh ureḥ. res cceƹb al mkan lliy uwiγaḵ fellas. qa lmleykew yeggur zzaṯiḵ, lekenti taƹeqbeγ g as n lḥukmiw cceƹb lliy yeggi bekkeḍu.»<verse eid="EXO 32:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 32:35" />aḏ ysezwa rebbiy af midden lwaf d leƹqab afelxaḍert uwan y haruwn asenyeg fwunes bac aszellen.<verse eid="EXO 32:35" /></para>
  <chapter eid="EXO 32" />
  <chapter number="33" style="c" sid="EXO 33" />
  <para style="s">rebbiy yetjeddeḏ g lƹehd yid aṯ israyil</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 33:1" />aḏ yuwa lliy diyma yella y muwsa:</para>
  <para style="p" vid="EXO 33:1">«ffeγ seg ayuh n mkan cek aḏ midden lliy tsefγetten seg miṣr. treḥḥeḏ al tammurt lliy djuleγ y ibrahiym aḏ isḥaq aḏ yeƹquwb bac atettuceγ y ṭarwiwiṯesen. <verse eid="EXO 33:1" /><verse number="2" style="v" sid="EXO 33:2" />aḏ tanekyeγ lemleykaw zzaṯiḵ, we azeƹezqeγ ikenƹaniyen aḏ lemuwriyen aḏ lḥeyṯiyin aḏ lferiziyyin aḏ lḥwiyin aḏ lyebuwsyin. <verse eid="EXO 33:2" /><verse number="3" style="v" sid="EXO 33:3" />kennim ureḥeṯ al aydin n tammurt lliy tečur s aγi aḏ tamemt. amma neči wiggurexc iḏuwem naγ afenenγeγ g ubriḏ afelxaḍert ixfewnuwem qṣeḥḥen.»<verse eid="EXO 33:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 33:4" />aḏ mniyn slen midden ayuh n dwiy aweƹƹar, uḏellen sgujduren aḏ wiyesri ḥetta d yjen sisen, <verse eid="EXO 33:4" /><verse number="5" style="v" sid="EXO 33:5" />afelxaḍert qebbel man aḥeznen yuwa lliy diyma yella y muwsa: «mmel y aṯ israyil; rahiy kennim d midden ixfewnesen qṣeḥḥen. kan aqimeγ jarewem ḥetta fercu afenenγeγ. amma ṭuruh mukseṯ sreyuwem almiy aḥekreγ man aggeγ iḏuwem.» <verse eid="EXO 33:5" /><verse number="6" style="v" sid="EXO 33:6" />yaxy beṭlen midden sray mniyn ffeγen seg jbel n ḥuwrib.<verse eid="EXO 33:6" /></para>
  <para style="s">lƹecceṯ n umlaqi</para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 33:7" />aḏ yusi muwsa yettaγed lƹecceṯ yessersayiṯ yebƹeḏ s barra y lmuxeyyem. aḏ ysemmeyiṯ d lƹecceṯ n umlaqi. aḏ kul yjen yexs ayeẓẓal y rebbiy ayreḥ al lƹecceṯ n umlaqi s barra y lmuxeyyem. <verse eid="EXO 33:7" /><verse number="8" style="v" sid="EXO 33:8" />aḏ kul man ayreḥ muwsa al lƹecceṯ n umlaqi, wsiyn midden tbeddan af imawen n leƹecceṯesen smuqulnas almiy asyeḏef. <verse eid="EXO 33:8" /><verse number="9" style="v" sid="EXO 33:9" />aḏ kul man asyeḏef muwsa, adyezwa ageṭṭum n sḥab zzaṯ imis, we ayuflay rebbiy y muwsa. <verse eid="EXO 33:9" /><verse number="10" style="v" sid="EXO 33:10" />aḏ kul man azren midden ageṭṭum n sḥab af imi n lƹecceṯ n umlaqi, aysejḏ kul yjen sisen y rebbiy zzaṯ lƹectis.<verse eid="EXO 33:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 33:11" />aḏ yusi rebbiy ydugga y muwsa aḏ netta iqably mammeḵ duggan midden y beƹeḍhum. aḏ almiy ayreḥ muwsa al lmuxeyyem, ayeqqim g lƹecceṯ mezyen yecuwƹ memmis n nuwn lliy yetƹawen diyes.<verse eid="EXO 33:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 33:12" />yuwa muwsa y rebbiy: «qa cek tewidiḏ: &lt; res ayuh n cceƹb. &gt; lekenti wiltuwic mam tanekyeḏ iḏiy. aḏ tuwidiḏ: &lt; rahiy ssenγaḵ s ismiḵ aḏ rliγ fellaḵ. &gt; <verse eid="EXO 33:12" /><verse number="13" style="v" sid="EXO 33:13" />mala kan terliḏ fella mammeḵ tewiḏ, siḵniḏ abriyḏiḵ bac afsenneγ iṭer we afserliγ. aḏ smitad zada lliy ayuh n midden d middeniḵ.»<verse eid="EXO 33:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 33:14" />yaxy yerras rebbiy: «rahiy taywureγ neči iḏeḵ, we afriḥeγ.»<verse eid="EXO 33:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 33:15" />yerras muwsa: «kan witteggurec cek iḏenneγ, wiγenseffeγc s yeh, <verse eid="EXO 33:15" /><verse number="16" style="v" sid="EXO 33:16" />zeγ mammeḵ tassenen midden ttaniyeṯ lliy cekkin terḥemdeneγ aḏ terliḏ? rahiy tiḵliḵ iḏenneγ d lemerṯ lliy cek twezideneγ seg midden n tammurt.»<verse eid="EXO 33:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 33:17" />yaxy yerra rebbiy y muwsa: «taggeγ lliy teḍlebbet, afelxaḍert rliγ fellaḵ aḏ ssenγaḵ s ismiḵ.»<verse eid="EXO 33:17" /></para>
  <para style="s">muwsa yexs ayzer lmejd n rebbiy</para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 33:18" />yuwa muwsa: «siḵniḏ ay rebbiy lmejdiḵ.»<verse eid="EXO 33:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 33:19" />yaxy yuwa rebbiy:</para>
  <para style="p" vid="EXO 33:19">«tazreḏ nnaƹemtiw, we asleḏ ismiw; neči d lliy diyma yella. rahiy sxafiw aḏ reḥemtiw y mam xseγ.» <verse eid="EXO 33:19" /><verse number="20" style="v" sid="EXO 33:20" />aḏ yerniy yuwa: «lekenti witzerrec uḏmiw afelxaḍert bnaḏem lliy ayzer uḏmiw witedderc.»<verse eid="EXO 33:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 33:21" />wembeƹd yuwa rebbiy: «qa yella mkan tmaw, bbed af aydin n teḍγeγt temeqqart, <verse eid="EXO 33:21" /><verse number="22" style="v" sid="EXO 33:22" />aḏ lemmi tayƹedda lmejdiw afeggeγ g tḥufret n teḍγeγt, we afḥerzeγ s fusiw almiy aƹeddiγ, <verse eid="EXO 33:22" /><verse number="23" style="v" sid="EXO 33:23" />wembeƹd akseγ fusiw, we azreḏ leqfew, amma witzerrec uḏmiw.»<verse eid="EXO 33:23" /></para>
  <chapter eid="EXO 33" />
  <chapter number="34" style="c" sid="EXO 34" />
  <para style="s">tiḍγaγin tijdiḏin n luwṣayaṯ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 34:1" />aḏ yuwa lliy diyma yella y muwsa: «qdeƹ sen tiḍγaγin am tmezwerin bac aḏeryeγ fellaseneṯ lliy yusi yuri af tmezwerin lliy terzitent. <verse eid="EXO 34:1" /><verse number="2" style="v" sid="EXO 34:2" />jra imaniḵ bac aḏelyeḏ al jbel n siynay tajji bekri we abeddeḏ zzaṯiw anjis. <verse eid="EXO 34:2" /><verse number="3" style="v" sid="EXO 34:3" />yexs witaly iḏeḵ ḥetta d yjen, aḏ wiyetγimi ḥetta d yjen af jbel. aḏ wiferdenc izmeren naγ tifwunesin tman jbel.»<verse eid="EXO 34:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 34:4" />yeggi muwsa sen tilweḥin s iḍγaγen am tmezwerin. aḏ al ača tajji, ybekker yuli af jbel n siynay aḏ tiḍγaγin g ufusis, mammeḵ yuwayas rebbiy.<verse eid="EXO 34:4" /></para>
  <para style="s">tezuggiṯ n rebbiy</para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 34:5" />yaxy yezwad lliy diyma yella g sḥab, yebbed muwsa zzaṯis, aḏ yenṭaqed s ysem n lliy diyma yella. <verse eid="EXO 34:5" /><verse number="6" style="v" sid="EXO 34:6" />iƹedda lliy diyma yella zzaṯ muwsa yemmal: «neči d lliy diyma yella, rebbiy ḥniyn aḏ rḥiym, witetγeccecec fiseƹ γari ggeṯ lḥeq aḏ nnaƹmeṯ. <verse eid="EXO 34:6" /><verse number="7" style="v" sid="EXO 34:7" />ttuceγ nnaƹemtiw y luluf n lejyal. aḏ γefreγ y lliy tteggen bekkeḍu aḏ lliy widebƹenc dwiyw aḏ lliy aγelḍen, amma witedjixc lliy yeggi bekkeḍu man γiyr ƹaqeb. aḏ debƹeγ bekkeḍu n ibaben g imeckenesen al ljiyl wi 3 aḏ wis 4.»<verse eid="EXO 34:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 34:8" />yaxy yesjeḏ muwsa ƹlewleh. <verse eid="EXO 34:8" /><verse number="9" style="v" sid="EXO 34:9" />aḏ yuwa: «kan terḥemdiḏ aḏ terliḏ fella ay rebbiy, yyur iḏenneγ. nembelḥeq ayuh n midden ixfewnesen qṣeḥḥen. amma ggeḏ lemruweṯ aγfer bekkeḍunneγ aḏ aγleḍeneγ tegdeneγ d cceƹbiḵ diyma.»<verse eid="EXO 34:9" /></para>
  <para style="s">lƹehd n rebbiy aḏ luwṣayaṯis tijekkelt iḍen</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 34:10" />aḏ yuwa rebbiy y muwsa:</para>
  <para style="p" vid="EXO 34:10">«qa neči taggeγ lƹehd, we asiḵneγ zzaṯ middeniḵ lkul lmuƹjizaṯ wizrinc am nihintin g tammurt, bac azren midden iḍen lliy taflaqen matta taggeγ iḏeḵ igga n lliy diyma yella. <verse eid="EXO 34:10" /><verse number="11" style="v" sid="EXO 34:11" />amma yexs aggeḏ lliy uwiγaḵ fellas as wuh. qa neči tazeƹezqeγ seg zzaṯiḵ lemuwriyin aḏ ikenƹaniyen aḏ lḥeyṯiyin aḏ lferiziyin aḏ lḥwiyin aḏ lyebuwsyin.<verse eid="EXO 34:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 34:12" />rreṯ lbaluwem aggem lƹehd yid midden n tammurt lliy tasteḏfem naγ afenseḥeslen. <verse eid="EXO 34:12" /><verse number="13" style="v" sid="EXO 34:13" />amma yexs ahedmem mkan n teγrestesen, we arzem leṣnemesen, we aqedƹem tireslinesen lliy d leṣnam n ƹecira. <verse eid="EXO 34:13" /><verse number="14" style="v" sid="EXO 34:14" />rreṯ lbaluwem azellem y rebbiy xlefiw afelxaḍert neči d lliy diyma yella d ḥezzar, wiγisc mam yiḏes.<verse eid="EXO 34:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 34:15" />rreṯ lbaluwem aggem lƹehd yid lliy seknen g tammurt ḏḏin, afelxaḍert almiy taggen bekkeḍu n tẓalliṯ y rebbiysen we asγersen, tafenesγuyen bac ačam seg teγrestesen, <verse eid="EXO 34:15" /><verse number="16" style="v" sid="EXO 34:16" />we asenejfem imeckenuwem seg yessiṯesen, we atensunden bac azellen y rebbiysneṯ.<verse eid="EXO 34:16" /></para>
  <para style="s">siḵen n tfeṣkiwin n aṯ israyil</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 34:17" />arr lbaliḵ aggeḏ ṣembaṯ d irebbiyen ḥetta lukan tenγelletent d nγal g lqaleb.<verse eid="EXO 34:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 34:18" />ggeṯ tfeṣka n tqurset, ačam diyes tqurset man γiyr lexmireṯ 7 d ussanaṯ g cehher n abiyb mammeḵ uwiγawem, afelxaḍert g ayuh n cehher teffeγem seg miṣr.<verse eid="EXO 34:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 34:19" />ibedriyen lkul y neči, aḏ ijerren imezweren n zwayeliḵ aḏ tifwunesniḵ aḏ izmerniḵ.<verse eid="EXO 34:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 34:20" />ijerren imezweren n iγyal atenefdiḏ s iƹelwac naγ atenenγeḏ. aḏ bedriḵ atefdiḏ s uƹelluc zada.</para>
  <para style="p" vid="EXO 34:20">witbeddeṯc zzaṯiw aḏ ifesnuwem d lferγiyn man γiyr ṣṣedqeṯ.<verse eid="EXO 34:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 34:21" />yexs axedmeḏ 6 d ussanaṯ we ariḥeḏ as wi 7 ḥetta lukan d ussan n uṯfelleḥ aḏ mjar.<verse eid="EXO 34:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 34:22" />we aggem tfeṣka n ljumƹeyaṯ g ussan imezweren n mjar aḏ cicel n irden, aḏ tfeṣka n xzan beƹd leyem n lγelleṯ lkul g laxer n usuggas.<verse eid="EXO 34:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 34:23" />irgazen lkul yexs abedden g diyn 3 merrat zzaṯ rebbiy n aṯ israyil. <verse eid="EXO 34:23" /><verse number="24" style="v" sid="EXO 34:24" />qa tazeƹezqeγ midden ttenyaṯ seg zzaṯuwem we asewesƹeγ tammurtuwem aḏ widemmeƹ ḥetta d yjen diyes almiy tadesem abeddem zzaṯiw 3 merrat g usuggas.<verse eid="EXO 34:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 34:25" />wiltuc ḥetta ciy diyes lexmireṯ yid teγrest. aḏ witedjeṯec al ača tajji seg teγrest n usmiti n uƹeddi n rebbiy.<verse eid="EXO 34:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 34:26" />yexs adeγeḏ al tzaqqa n rebbiy lfal n lγelleṯ n tammurtiḵ.</para>
  <para style="p" vid="EXO 34:26">aḏ wiserγac iγid g aγi n yedjis.»<verse eid="EXO 34:26" /></para>
  <para style="s">uḏem n muwsa lliy ilemmeƹ</para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 34:27" />aḏ yerniy rebbiy yuwa: «ri ayuh n dwiy afelxaḍert diyes lecruḍ n lƹehd lliy ggixt iḏeḵ aḏ yid aṯ israyil.»<verse eid="EXO 34:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 34:28" />aḏ yeqqim muwsa zzaṯ rebbiy 40 d ussanaṯ s iḍenesen, wiyečic, wiyeswic. aḏ yuri lƹehd lliy netta d luwṣayaṯ lƹecra af aydin n tiḍγaγin. <verse eid="EXO 34:28" /><verse number="29" style="v" sid="EXO 34:29" />aḏ mniyn yezwa muwsa seg jbel g ifesnis tiḍγaγin n lƹehd. wiyerric lbalis al uḏmis lliy yetreq afelxaḍert yusi ydugga yid rebbiy. <verse eid="EXO 34:29" /><verse number="30" style="v" sid="EXO 34:30" />aḏ lemmi yezra haruwn aḏ aṯ israyil uḏem n muwsa yetreq am idin ugeḏḏen aseqerben. <verse eid="EXO 34:30" /><verse number="31" style="v" sid="EXO 34:31" />yaxy yesγuyasen muwsa, yeḏwellas haruwn yid iwessaren n aṯ israyil, yufleyasen. <verse eid="EXO 34:31" /><verse number="32" style="v" sid="EXO 34:32" />wembeƹd qrebnas aṯ israyil lkul, yuwayasen af luwṣayaṯ lkul lliy yuwa fellesneṯ rebbiy af jbel n siynay.<verse eid="EXO 34:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 34:33" />mniyn ykemmel muwsa dwiys yiḏesen, yeggi af uḏmis lburqeƹ. <verse eid="EXO 34:33" /><verse number="34" style="v" sid="EXO 34:34" />yusi itekkes almiy ydugga yid rebbiy. wembeƹd yetreḥ bac aymel y aṯ israyil af matta yuwa rebbiy. <verse eid="EXO 34:34" /><verse number="35" style="v" sid="EXO 34:35" />aḏ afelxaḍert zerren midden n aṯ israyil uḏem n muwsa yetreq, yusi netta iterra lburqeƹ af uḏmis al lweqt lliy tayeḏef diyes al lƹecceṯ bac ayuflay yid rebbiy.<verse eid="EXO 34:35" /></para>
  <chapter eid="EXO 34" />
  <chapter number="35" style="c" sid="EXO 35" />
  <para style="s">lqanuwn n as n sebbeṯ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 35:1" />yesγuy muwsa y midden n aṯ israyil lkul yuwayasen: «ayuh matta yuweyawem rebbiy bac ateggem:<verse eid="EXO 35:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 35:2" />yexs axedmem 6 d ussanaṯ, we aggem as 7 d rreḥeṯ d meqdus y neči. aḏ kul yjen ayexdem diyes ayemmuṯ. <verse eid="EXO 35:2" /><verse number="3" style="v" sid="EXO 35:3" />aḏ wiseγeṯec timsi g leḥwecuwem as n sebbeṯ.»<verse eid="EXO 35:3" /></para>
  <para style="s">leyem n iḥejeyen lliy tabnan sisen meqdus</para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 35:4" />wembeƹd yuwa muwsa y midden n aṯ israyil lkul: «ayuh mag yuwa rebbiy:<verse eid="EXO 35:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 35:5" />&lt;uceṯ ṣṣedqeṯ y neči, kul yjen yecreh af ucas alyuc lliy yexs; d wureγ naγ d lfejreṯ naγ d nḥas. <verse eid="EXO 35:5" /><verse number="6" style="v" sid="EXO 35:6" />aḏ ulman d izizewen aḏ d iḥberiyen aḏ d izuggaγen, aḏ ustu n tefduxt aḏ ulman n udjuf n tγaṭin. <verse eid="EXO 35:6" /><verse number="7" style="v" sid="EXO 35:7" />aḏ ilimen n iberkas aḏ ilimen n trebit temeqqart lliy man γiyr tqecra aḏ isγaren n ssenṭ. <verse eid="EXO 35:7" /><verse number="8" style="v" sid="EXO 35:8" />aḏ uḏi yuseγi n nnir, aḏ ifuḥan y uḏi meqdus aḏ lebxuwr. <verse eid="EXO 35:8" /><verse number="9" style="v" sid="EXO 35:9" />aḏ tiƹqiqin n ljizƹ aḏ tγuγa tiṣbiḥin iḍen y sray n rdi aḏ tmeṣdurt. &gt;<verse eid="EXO 35:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 35:10" />aḏ yexs kul sṭa siwem yetquddu igga n ḥaja adyas bac ayeg matta yuwa rebbiy; <verse eid="EXO 35:10" /><verse number="11" style="v" sid="EXO 35:11" />lƹecceṯ aḏ seqfis aḏ lemxeṭfis aḏ tqafeṣis aḏ lweseṭis aḏ tireslinis s tqeƹeṯinesen. <verse eid="EXO 35:11" /><verse number="12" style="v" sid="EXO 35:12" />aḏ ttebuwt aḏ igeḍmanis, aḏ ddan n tkuffert, aḏ star lliy yeḥrez ttebuwt, <verse eid="EXO 35:12" /><verse number="13" style="v" sid="EXO 35:13" />aḏ ṭṭewleṯ aḏ igeṭṭumnis, aḏ reγeltis lkul, aḏ tqurset n ṣṣedqeṯ. <verse eid="EXO 35:13" /><verse number="14" style="v" sid="EXO 35:14" />aḏ nnir n useγi aḏ reγeltis aḏ uḏi n useγi, <verse eid="EXO 35:14" /><verse number="15" style="v" sid="EXO 35:15" />aḏ mkan n ubexxer aḏ igeṭṭumnis, aḏ uḏi meqdus, aḏ lebxuwr lliy faweḥ, aḏ star n imi n lƹecceṯ, <verse eid="EXO 35:15" /><verse number="16" style="v" sid="EXO 35:16" />aḏ mkan n teγrest aḏ rredjis n nḥas aḏ igeṭṭumnis aḏ reγeltis lkul, aḏ fedja n uzizdi aḏ tqeƹetis, <verse eid="EXO 35:16" /><verse number="17" style="v" sid="EXO 35:17" />aḏ settur n amas lḥuc aḏ tireslinis, aḏ tiqeƹeṯin n tireslin, aḏ star n imi n amas lḥuc, <verse eid="EXO 35:17" /><verse number="18" style="v" sid="EXO 35:18" />aḏ ṭweleṯ n lƹecceṯ aḏ amas lḥuc aḏ tzarwinesen, <verse eid="EXO 35:18" /><verse number="19" style="v" sid="EXO 35:19" />aḏ ṣireḍ n haruwn lkahen. aḏ ṣireḍ meqdus n ṭarwas, aḏ ṣireḍ n uzeṭṭi y lxeḏmeṯ g umeqdus.»<verse eid="EXO 35:19" /></para>
  <para style="s">leyem n ṣṣedqeṯ</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 35:20" />reḥḥen israyiliyen seg zzaṯ n muwsa beƹd mag slen dwiy n rebbiy. <verse eid="EXO 35:20" /><verse number="21" style="v" sid="EXO 35:21" />aḏ usend indin lliy uwanasen ulawnesen aḏ lliy ydab lxeḍresen uγend ṣṣedqeṯ y rebbiy bac abnan lƹecceṯ n umlaqi aḏ reγleḏ n lxeḏmeṯ diyes, aḏ bac aggen ṣireḍ meqdus. <verse eid="EXO 35:21" /><verse number="22" style="v" sid="EXO 35:22" />aḏ usend irgazen aḏ tseḏnan lliy ulawnesen d imeqqaren ttucen g tiḥdidin aḏ tibelluṭin aḏ txuṯam aḏ smesem aḏ iḥejeyen iḍen n wureγ. aḏ wureγ lkul lliy uγentiḏ ucent d ṣṣedqeṯ y rebbiy. <verse eid="EXO 35:22" /><verse number="23" style="v" sid="EXO 35:23" />aḏ indin lliy γarsen ulman d izizewen aḏ d iḥberiyen aḏ izuggaγen, aḏ ustu n tefduxt aḏ ulman n udjuf n tγeṭṭin, aḏ ilimen n iberkas, aḏ ilimen n trebit temeqqart lliy man γiyr tqecra ucenten y rebbiy zada. <verse eid="EXO 35:23" /><verse number="24" style="v" sid="EXO 35:24" />aḏ sisen mam yuca lfejreṯ aḏ nḥas, aḏ kul yjen yufa γares isγaren n ssenṭ ṣelḥen y igga n ḥaja yucin y rebbiy d ṣṣedqeṯ.<verse eid="EXO 35:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 35:25" />aḏ lemneṯ tiseḏnan lliy ḥeḏqat lkul ulman d izizewen aḏ d iḥberiyen aḏ d izuggaγen, aḏ ustu n tefduxt aḏ uγentend. <verse eid="EXO 35:25" /><verse number="26" style="v" sid="EXO 35:26" />aḏ lemneṯ lḥeḏqat seg tiseḏnan lliy uwanesneṯ ulawnesneṯ ulman seg udjuf n tγeṭṭin.<verse eid="EXO 35:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 35:27" />aḏ ucen imeqqaren n aṯ israyil tiƹqiqin n ljizƹ aḏ tiƹqiqin tiṣbiḥin y sray n rdi aḏ tmeṣdurt. <verse eid="EXO 35:27" /><verse number="28" style="v" sid="EXO 35:28" />aḏ ifuḥan aḏ uḏi y useγi aḏ uḏi meqdus aḏ lebxuwr. <verse eid="EXO 35:28" /><verse number="29" style="v" sid="EXO 35:29" />aḏ amyuh irgazen aḏ tseḏnan n aṯ israyil lkul lliy ydab lxeḍresen ucen iḥejeyen y rebbiy bac aggen lliy yuwa lliy diyma yella y muwsa fellas.<verse eid="EXO 35:29" /></para>
  <para style="s">beṣleyil aḏ ahuwlyab taḏeḏlen lxeḏmeṯ</para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 35:30" />aḏ yuwa muwsa y aṯ israyil:</para>
  <para style="p" vid="EXO 35:30">«qa rebbiy iwaza beṣleyil memmis n uwriy aḏ memmis n memmis n ḥuwr seg lƹerc n yehuwḏa aḏ yesγuyas s ismis. <verse eid="EXO 35:30" /><verse number="31" style="v" sid="EXO 35:31" />yečury s rruwḥis, aḏ yucas lefker aḏ uquddu aḏ tmesniwt n ṣnayeƹ lkul <verse eid="EXO 35:31" /><verse number="32" style="v" sid="EXO 35:32" />bac ayxeṭṭeṭ iḥejeyen lliy tatenyeg s ifesnis seg wureγ aḏ lfejreṯ aḏ nḥas, <verse eid="EXO 35:32" /><verse number="33" style="v" sid="EXO 35:33" />aḏ bac ayeṣqel ljuher we atyesry, aḏ bac ayeqdeƹ isγaren we ayeg kul ciy. <verse eid="EXO 35:33" /><verse number="34" style="v" sid="EXO 35:34" />aḏ yucas rebbiy netta aḏ ahuwlyab memmis n xiysamak seg lƹerc n dan quddu n useḥfeḍ n ttenyaṯ. <verse eid="EXO 35:34" /><verse number="35" style="v" sid="EXO 35:35" />aḏ yerrin d lfelḥin iṭer n midden bac aḏeγzen ljuher, we aqedƹen isγaren, we azden, we aṭerzen zeṭṭi seg ulman d izizewen aḏ d iḥberiyen aḏ d izuggaγen aḏ seg ustu n tefduxt, we aggen ṣnayeƹ lkul n uzeṭṭi. aḏ yerrin tquddun ṣnayeƹ lkul aḏ yucesen quddu bac axeṭṭeṭen.»<verse eid="EXO 35:35" /></para>
  <chapter eid="EXO 35" />
  <chapter number="36" style="c" sid="EXO 36" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 36:1" />«beṣleyil aḏ ahuwlyab aḏ staweṯ lliy yucesen rebbiy lefeker aḏ quddu n igga n tezeqqa temeqdust yexs aggen lxeḏmeṯ lliy yuwa felles rebbiy aḏ mammeḵ yuweyasen.»<verse eid="EXO 36:1" /></para>
  <para style="s">ddel g lebni</para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 36:2" />wembeƹd yesγuy muwsa af beṣleyil aḏ ahuwlyab aḏ af kul sṭa yucas rebbiy quddu aḏ lliy yuwayas ulis ayeg ḥaja bac aggen matta yuwa rebbiy. <verse eid="EXO 36:2" /><verse number="3" style="v" sid="EXO 36:3" />aḏ uwyen s muwsa lliy ucent midden lkul bac ggen meqdus. aḏ qqimen midden tteγend g ṣṣedqeṯ y rebbiy kul tajji. <verse eid="EXO 36:3" /><verse number="4" style="v" sid="EXO 36:4" />yaxy usend staweṯ lliy teggen g umeqdus al muwsa, <verse eid="EXO 36:4" /><verse number="5" style="v" sid="EXO 36:5" />uwanas: «rahiy midden uγend iṭer n lliy nestḥeq y igga n mag yuwa rebbiy.»<verse eid="EXO 36:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 36:6" />yaxy yuwayasen muwsa amlen y midden: «maƹedc adeγem ṣṣedqeṯ y rebbiy.» yaxy beṭlen midden iγa. <verse eid="EXO 36:6" /><verse number="7" style="v" sid="EXO 36:7" />aḏ yusi lliy leyment ikeffa y igga n mag yuwa rebbiy we adyefdel<verse eid="EXO 36:7" /></para>
  <para style="s">igga n ṣqef n umeqdus</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 36:8" />sṭaweṯ imeqqaren ggen sqef n lƹecceṯ seg ulman d izizewen aḏ d iḥberiyen aḏ d izuggaγen aḏ seg ustu n tefduxt. nsezzen 10 n stareṯ n uzeṭṭi ggen disen tṣawer n lqeruwb. <verse eid="EXO 36:8" /><verse number="9" style="v" sid="EXO 36:9" />aḏ wsiyn stareṯ lkul d deqqes yjen; ṭṭulesen 28 d leḏruƹ aḏ lƹerḍesen 4 d leḏruƹ. <verse eid="EXO 36:9" /><verse number="10" style="v" sid="EXO 36:10" />aḏ gnan kul 5 n stareṯ g beƹeḍhum ljenb al ljenb. <verse eid="EXO 36:10" /><verse number="11" style="v" sid="EXO 36:11" />aḏ ggen tiḥelqeṯin n ulman izizewen af ṭṭerf lexrani n stareṯ imezweren, aḏ af ṭṭerf mezwar n stareṯ ttenyaṯ. <verse eid="EXO 36:11" /><verse number="12" style="v" sid="EXO 36:12" />aḏ yusi af kul ṭṭerf 50 d tiḥelqeṯin n ulman ijeṯ g leqbeleṯ n ttani. <verse eid="EXO 36:12" /><verse number="13" style="v" sid="EXO 36:13" />aḏ ggen 50 d iγesmaren n wureγ bac aṭfen sisen aydin n sen leḍruf n stareṯ bac adlen d yjen.<verse eid="EXO 36:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 36:14" />aḏ zden ḥdac d stareṯ seg ulman n udjuf n tγeṭṭin bac adlen d sqef wissen y lƹecceṯ. <verse eid="EXO 36:14" /><verse number="15" style="v" sid="EXO 36:15" />aḏ wsiyn ayuh n ḥdac lkul d leqyas yjen; ṭṭulesen 30 d ḏreƹeṯ aḏ lƹerḍesen 4 ḏruƹ. <verse eid="EXO 36:15" /><verse number="16" style="v" sid="EXO 36:16" />aḏ qqennen 5 n stareṯ imezweren jneb al jneb g beƹeḍhum aḏ ggen am idin s 6 ttenyaṯ. <verse eid="EXO 36:16" /><verse number="17" style="v" sid="EXO 36:17" />aḏ ggen 50 d tiḥelqeṯin af ṭṭerf yjen n stareṯ imezweren aḏ 50 af ṭṭerf yjen n stareṯ ttenyaṯ. <verse eid="EXO 36:17" /><verse number="18" style="v" sid="EXO 36:18" />aḏ ggen 50 d iγesmeren n nḥas bac aṭfen sisen stareṯ lbeƹeḍhum bac adlen d sqef wissen y lƹecceṯ. <verse eid="EXO 36:18" /><verse number="19" style="v" sid="EXO 36:19" />aḏ uḏnenteṯ s ilimen n iberkas ṣbeγγen s uzuggaγ aḏ njesen ggen ilimen n trabit temmeqqer lliy man γiyr tqecera.<verse eid="EXO 36:19" /></para>
  <para style="s">sebbed n leḥyuḍ n lƹecceṯ</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 36:20" />aḏ ggen leḥyuḍ n lƹecceṯ s tqafeṣ seg isγaren n ssenṭ bbedneṯ. <verse eid="EXO 36:20" /><verse number="21" style="v" sid="EXO 36:21" />ṭṭul n kul teqfiṣeṯ sisneṯ 12 ḏruƹ aḏ lƹerḍis dereƹ aḏ wezgen. <verse eid="EXO 36:21" /><verse number="22" style="v" sid="EXO 36:22" />aḏ kul teqfiṣeṯ γares sen iderren yjen g leqbeleṯ n ttani bac aṭṭefneṯ tqafeṣ g beƹeḍhum. amyuh ggen tqafeṣ lkul n lƹecceṯ. <verse eid="EXO 36:22" /><verse number="23" style="v" sid="EXO 36:23" />aḏ ggen lḥiḍ qebli seg 20 d tqafeṣ. <verse eid="EXO 36:23" /><verse number="24" style="v" sid="EXO 36:24" />aḏ 40 d tiqeƹƹeḏin n lfejreṯ y dernesneṯ, sen tqeƹeṯin y kul teqfiṣeṯ. <verse eid="EXO 36:24" /><verse number="25" style="v" sid="EXO 36:25" />aḏ y lḥiḍ beḥri ggen 20 d tqafeṣ zada. <verse eid="EXO 36:25" /><verse number="26" style="v" sid="EXO 36:26" />aḏ 40 d tiqeƹƹeṯin n lfejreṯ senneṯ y kul teqfiṣeṯ. <verse eid="EXO 36:26" /><verse number="27" style="v" sid="EXO 36:27" />amma lḥiḍ medeffer lliy s mγerreb ggenas 6 n tqafeṣ. <verse eid="EXO 36:27" /><verse number="28" style="v" sid="EXO 36:28" />aḏ sen tqafeṣ y treken timedefferin. <verse eid="EXO 36:28" /><verse number="29" style="v" sid="EXO 36:29" />aḏ kul ijeṯ sisneṯ tusi d senneṯ lṣeqneṯ s dday al nnaj al tḥelqet temezwert. amyuh ggen y terkineṯ tisneṯ. <verse eid="EXO 36:29" /><verse number="30" style="v" sid="EXO 36:30" />aḏ lḥiḍ medeffer diyes 8 n tqafeṣ aḏ 16 d tiqeƹeṯin n lfejreṯ, senneṯ y kul teqfiṣeṯ weḥdes.<verse eid="EXO 36:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 36:31" />aḏ ggen lweseṭ seg isγaren n ssenṭ, 5 y lḥiḍ qebli. <verse eid="EXO 36:31" /><verse number="32" style="v" sid="EXO 36:32" />aḏ 5 y lḥiḍ beḥri, aḏ 5 n lweseṭ y tqafeṣ n lḥiḍ aγerbi. <verse eid="EXO 36:32" /><verse number="33" style="v" sid="EXO 36:33" />aḏ lwesṭeṯ temamasin ateḏefneṯ g amas n tqafeṣ seg ṭṭerf al ṭṭerf. <verse eid="EXO 36:33" /><verse number="34" style="v" sid="EXO 36:34" />aḏ γelfen tqafeṣ aḏ lweseṭ s wureγ. aḏ ggen tiḥelqeṯin n wureγ mani adesneṯ lweseṭ.<verse eid="EXO 36:34" /></para>
  <para style="s">igga n star mames n lƹecceṯ</para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 36:35" />aḏ ggen star mames n lƹecceṯ seg uzeṭṭi n ulman d izizewen aḏ d iḥberiyen aḏ d izuggaγen aḏ ustu n tefduxt. ggenas tṣawer n lqeruwb. <verse eid="EXO 36:35" /><verse number="36" style="v" sid="EXO 36:36" />aḏ ggenas 4 n tireslin seg isγaren n ssenṭ lliy γelfen s wureγ aḏ disneṯ lemxeṭef n wureγ. ayuh n tirsal abedneṯ af tqeƹeḏin n lfejreṯ. <verse eid="EXO 36:36" /><verse number="37" style="v" sid="EXO 36:37" />aḏ zden star y imi n lƹecceṯ s ulman d izizewen aḏ d iḥberiyen aḏ d izuggaγen aḏ seg ustu n tefduxt. <verse eid="EXO 36:37" /><verse number="38" style="v" sid="EXO 36:38" />ayuh n star γares 5 n tireslin s lemxeṭef aḏ ixfewn aḏ uzzelaṯ n wureγ aḏ 5 n tqeƹƹeḏin n nḥas.<verse eid="EXO 36:38" /></para>
  <chapter eid="EXO 36" />
  <chapter number="37" style="c" sid="EXO 37" />
  <para style="s">igga n ttebuwt</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 37:1" />aḏ yeggi beṣleyil ttebuwt seg isγaren n ssenṭ, ṭṭulis sen leḏruƹ aḏ wezgen aḏ lƹerḍis am lƹulwis dereƹ aḏ wezgen. <verse eid="EXO 37:1" /><verse number="2" style="v" sid="EXO 37:2" />iγelfy s jjaj aḏ barra s wureγ ṣbiḥ aḏ yeggas lḥacit n wureγ. <verse eid="EXO 37:2" /><verse number="3" style="v" sid="EXO 37:3" />aḏ 4 n tḥelqeṯin yeggineṯ af treknis kul senneṯ g ljeheṯ, <verse eid="EXO 37:3" /><verse number="4" style="v" sid="EXO 37:4" />aḏ sen igeḍman seg isγaren n ssenṭ iγelfin s wureγ ṣbiḥ. <verse eid="EXO 37:4" /><verse number="5" style="v" sid="EXO 37:5" />aḏ yseḏfin g tḥelqeṯin n lejnab n ttebuwt bac atqamen sisen. <verse eid="EXO 37:5" /><verse number="6" style="v" sid="EXO 37:6" />aḏ yeggi beṣleyil ddan seg wureγ ṣbiḥ ṭṭulis sen leḏruƹ aḏ wezgen aḏ lƹerḍis dereƹ aḏ wezgen. <verse eid="EXO 37:6" /><verse number="7" style="v" sid="EXO 37:7" />aḏ yenḥet g ddan sen iqeruwbin, kul yjen sisen af ṭṭerf n ddan. <verse eid="EXO 37:7" /><verse number="8" style="v" sid="EXO 37:8" />kul lqeruwb af yjen n ṭṭerf mmuneḥten siyes aḏ bbedden af leḍrafis. <verse eid="EXO 37:8" /><verse number="9" style="v" sid="EXO 37:9" />aḏ wsiyn metqeblin, aḏ lejneḥeṯesen sreḏḏen al nnaj bac aggen ṭṭel af ddan lliy uḏmewnesen smuqulnas.<verse eid="EXO 37:9" /></para>
  <para style="s">igga n ṭṭewleṯ</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 37:10" />aḏ yeggi ṭṭewleṯ seg isγaren n ssenṭ ṭṭulis sen leḏruƹ aḏ lƹerḍis dereƹ aḏ lƹulwis dereƹ aḏ wezgen. <verse eid="EXO 37:10" /><verse number="11" style="v" sid="EXO 37:11" />iγelfiṯ s wureγ ṣbiḥ aḏ yeggas lḥacit teƹla seg wureγ. <verse eid="EXO 37:11" /><verse number="12" style="v" sid="EXO 37:12" />aḏ yeggas lḥacit iḍen am lgafun lƹulwis 4 n idudan aḏ lḥacitis d wureγ zada. <verse eid="EXO 37:12" /><verse number="13" style="v" sid="EXO 37:13" />aḏ yenγellas 4 n tḥelqeṯin, yeggineṯ af idernis 4 adug lḥacit. <verse eid="EXO 37:13" /><verse number="14" style="v" sid="EXO 37:14" />aḏ nihintin d imuḵan n igeḍman lliy taqamen ṭṭewleṯ sisen. <verse eid="EXO 37:14" /><verse number="15" style="v" sid="EXO 37:15" />aḏ yeggi igeḍman seg isγaren n ssenṭ lliy γelfen s wureγ y uqami n ṭṭewleṯ. <verse eid="EXO 37:15" /><verse number="16" style="v" sid="EXO 37:16" />aḏ seg wureγ ṣbiḥ yeggi tiḥeḏweq n ṭṭewleṯ aḏ tbesis aḏ lkisanis aḏ ibriqnis lliy taneγlen sisen matta taḏucen.<verse eid="EXO 37:16" /></para>
  <para style="s">igga n nnir</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 37:17" />aḏ yeggi nnir seg wureγ ṣbiḥ. aḏ yenḥet teqeƹetis aḏ daris aḏ lkisanis aḏ isγernis aḏ nnuweris seg ṭṭerf yjen. <verse eid="EXO 37:17" /><verse number="18" style="v" sid="EXO 37:18" />diyes 6 n isγaren, kul 3 seg ljiheṯ. <verse eid="EXO 37:18" /><verse number="19" style="v" sid="EXO 37:19" />aḏ g kul sγer 3 n lkisan am tzalluzin s twerqeyesen aḏ nuweresen. <verse eid="EXO 37:19" /><verse number="20" style="v" sid="EXO 37:20" />aḏ af dder lliy amas diyes 4 n lkisan am tzalluzin s nuweresen aḏ twerqeyesen. <verse eid="EXO 37:20" /><verse number="21" style="v" sid="EXO 37:21" />aḏ g ayuh n dder lliy g amas seg kul tewerqit yseffeγ sen isγaren. am idin yeggi aydin 6 n isγaren. <verse eid="EXO 37:21" /><verse number="22" style="v" sid="EXO 37:22" />aḏ yeggi dder aḏ tiwerqayis aḏ isγernis lkulhum d ṭṭerf yjen seg wureγ ṣbiḥ. <verse eid="EXO 37:22" /><verse number="23" style="v" sid="EXO 37:23" />aḏ yeggas 7 n lkisan y tiftal aḏ iγemdenesen aḏ tbesi n iγeḍ seg wureγ ṣbiḥ. <verse eid="EXO 37:23" /><verse number="24" style="v" sid="EXO 37:24" />aḏ yeggi nnir aḏ reγeltis lkul seg 36 d lkiluwaṯ n wureγ ṣbiḥ.<verse eid="EXO 37:24" /></para>
  <para style="s">igga n mkan n ubexxer</para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 37:25" />aḏ yeggi mkan n ubexxer seg isγaren n ssenṭ, d imrebbeƹ ṭṭulis aḏ lƹerḍis dereƹ aḏ lƹulwis sen leḏruƹ. aḏ leqrunis lṣeqqen diyes. <verse eid="EXO 37:25" /><verse number="26" style="v" sid="EXO 37:26" />aḏ iγelfy lkul s wureγ ṣbiḥ, seṭeḥtis aḏ lejnabis aḏ leqrunis. aḏ yeggas lḥacit n wureγ. <verse eid="EXO 37:26" /><verse number="27" style="v" sid="EXO 37:27" />aḏ yeggas 4 n tḥelqeṯin n wureγ adug lḥacitis, kul senneṯ g jneb bac adesen disneṯ igeḍman lliy tatqamen sisen. <verse eid="EXO 37:27" /><verse number="28" style="v" sid="EXO 37:28" />aḏ yeggi igeḍman seg isγaren n ssenṭ aḏ iγelfin s wureγ.<verse eid="EXO 37:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 37:29" />aḏ yeggi uḏi meqdus aḏ lebxuwr lliy faweḥ mammeḵ iteggy lliy yetquddu axelleḍ n lbxur.<verse eid="EXO 37:29" /></para>
  <chapter eid="EXO 37" />
  <chapter number="38" style="c" sid="EXO 38" />
  <para style="s">igga n umkan n teγrest</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 38:1" />aḏ yeggi mkan n teγrest seg isγaren n ssenṭ, seṭeḥtis timrebbeƹt ṭṭulis aḏ lƹerḍis 5 d leḏruƹ aḏ lƹulwis 3 d leḏruƹ. <verse eid="EXO 38:1" /><verse number="2" style="v" sid="EXO 38:2" />aḏ yeggas leqruwn lṣeqqen g treknis seg aydin n isγaren aḏ iγelfy s nḥas. <verse eid="EXO 38:2" /><verse number="3" style="v" sid="EXO 38:3" />aḏ seg nḥas yeggas reγeltis lkul, ibunyen y ulayem n iγeḍ aḏ tγenjeyin y uƹebbi n iγeḍ aḏ timeƹejnin aḏ uzzelaṯ y umukes n yessum aḏ timejemrin. <verse eid="EXO 38:3" /><verse number="4" style="v" sid="EXO 38:4" />aḏ yeggas rredj n nḥas, yeggi adug lḥacit s dday g zegnis. <verse eid="EXO 38:4" /><verse number="5" style="v" sid="EXO 38:5" />aḏ yeggi af leḍrfis 4 n tḥelqeṯin n nḥas bac adesen disneṯ igeḍman, <verse eid="EXO 38:5" /><verse number="6" style="v" sid="EXO 38:6" />lliy yeggin seg isγaren n ssenṭ aḏ iγelfin s nḥas. <verse eid="EXO 38:6" /><verse number="7" style="v" sid="EXO 38:7" />aḏ yseḏef aydin sen igeḍman g tḥelqeṯin bac aqamen sisen mkan n teγrest. yusi ayuh n mkan n teγrest d lferγ g amas aḏ yemmug seg isγaren.<verse eid="EXO 38:7" /></para>
  <para style="s">igga n ufedja n uzizdi</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 38:8" />aḏ yeggi fedja n uzizdi aḏ tqeƹetis seg nḥas. yeggi beƹd mag ysezzel tisiṯin n nḥas lliy uγentend tiseḏnan. aḏ nihintin bbedneṯ zzaṯ imi n lƹecceṯ n umlaqi bac aƹewenneṯ.<verse eid="EXO 38:8" /></para>
  <para style="s">igga n amas n lḥuc n umeqdus</para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 38:9" />aḏ yeggi beṣleyil stareṯ seg ustu n tefduxt, ṭṭulesen 100t n dereƹ bac atensunden af amas n lḥuc seg ljiheṯ teqeblit. <verse eid="EXO 38:9" /><verse number="10" style="v" sid="EXO 38:10" />20 d tireslin abeddeneṯ af 20 d tiqeƹeṯin n nḥas aḏ disen lemxeṭef aḏ uzzelaṯ n lfejreṯ. <verse eid="EXO 38:10" /><verse number="11" style="v" sid="EXO 38:11" />am idin yeggi g ljiheṯ tebeḥrit, stareṯ n 100t n dereƹ af 20 tireslin aḏ 20 tiqeƹeḏin seg nḥas. amma lemxeṭef aḏ uzzelaṯ seg lfejreṯ.<verse eid="EXO 38:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 38:12" />amma ljiheṯ teγerbit yusi ṭṭul n stereṯis 50 d leḏruƹ ƹelqen af 10 n tireslin aḏ 10 n tiqeƹeṯin. aḏ lemxeṭefsen aḏ uzzelaṯsen d lfejreṯ. <verse eid="EXO 38:12" /><verse number="13" style="v" sid="EXO 38:13" />am idin ṭṭul n stareṯ n ljiheṯ tecerqit wsiyn 50 d ḏreƹaṯ. <verse eid="EXO 38:13" /><verse number="14" style="v" sid="EXO 38:14" />aḏ yusi ṭṭul n stareṯ af lqibelt n imi n amas lḥuc 15 d dereƹ. aḏ ƹelqen af 3 n tireslin s 3 n tqeƹeḏin. <verse eid="EXO 38:14" /><verse number="15" style="v" sid="EXO 38:15" />aḏ am idin wsiyn stareṯ af ljiheṯ tebeḥrit n imi. ṭṭulesen 15 n dereƹ. aḏ ƹelqen af 3 n tireslin s 3 n tqeƹeṯin. <verse eid="EXO 38:15" /><verse number="16" style="v" sid="EXO 38:16" />aḏ wsiyn stareṯ lliy nnaḍḍen af amas lḥuc lkul seg ustu n tefduxt teṣbiḥet. <verse eid="EXO 38:16" /><verse number="17" style="v" sid="EXO 38:17" />aḏ yeggi tiqeƹeṯin n tireslin lkul seg nḥas aḏ lemxeṭfesneṯ aḏ uzzelaṯsneṯ seg lfejreṯ. aḏ ixfewen n tireslin lkul d lfejreṯ. aḏ usineṯ tireslin ṭṭefneṯ g beƹeḍhum s uzzelaṯ n lfejreṯ.<verse eid="EXO 38:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 38:18" />aḏ yusi lƹerḍ n star n imi n amas lḥuc 20 d leḏruƹ aḏ lƹulwis 5 ḏruƹ am leƹlu n stareṯ n amas lḥuc lkul. aḏ ggent seg ulman d izizewen aḏ d iḥberiyen aḏ d izuggaγen aḏ ustu n tefduxt. <verse eid="EXO 38:18" /><verse number="19" style="v" sid="EXO 38:19" />aḏ yusi iƹelleq af lemxeṭef n lfejreṯ g 4 tireslin n lfejreṯ aḏ tiqeƹeṯinesneṯ d nḥas. aḏ wsiyn ixfewen n tireslin aḏ uzzeleṯesneṯ seg lfejreṯ. <verse eid="EXO 38:19" /><verse number="20" style="v" sid="EXO 38:20" />amma ṭwelaṯ n lƹecceṯ aḏ amas lḥuc lliy yenneḍ siyes wsiyn d nḥas.<verse eid="EXO 38:20" /></para>
  <para style="s">leqyesaṯ n iḥejeyen lliy ggenten y lebni n umeqdus</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 38:21" />qa ayuh d leqyesaṯ n iḥejeyen lliy ƹuddenten ilawiyyen mammeḵ yuwa muwsa y iṯamer memmis n haruwn lkahen bac ateneggen g lebni n umeqdus lliy diyes luwṣayaṯ. <verse eid="EXO 38:21" /><verse number="22" style="v" sid="EXO 38:22" />aḏ yusi beṣleyil memmis n uwriy aḏ memmis n memmis n ḥuwr seg leƹcirṯ n yehuwḏa d netta lliy yeggi mag yuwa lliy diyma yella y muwsa lkul. <verse eid="EXO 38:22" /><verse number="23" style="v" sid="EXO 38:23" />aḏ yusi yetƹawen diyes ahuwlyab memmis n xiysamak seg leƹcireṯ n dan lliy yusi d lfeleḥ g iγγaz aḏ g rcam n tṣawer aḏ g ṭrizeṯ s ulman d izizewen aḏ d iḥberiyen aḏ d izuggaγen af ustu n tefduxt.<verse eid="EXO 38:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 38:24" />aḏ yusi almiyzan lkul n wureγ lliy derejḥent midden zzaṯ rebbiy d ṣṣedqeṯ bac ggen siyes lebni n umeqdus 29 d lweznaṯ aḏ 730 n ceqlaṯ afelḥesab n almiyzan n ccaqel meqdus, yeƹni 1053 kilu.<verse eid="EXO 38:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 38:25" />amma almiyzan n lfejreṯ lliy ḏfeƹenteṯ midden d tekuffert n tkerminesen mniyn ƹuddenten tusi 100 d lweznaṯ aḏ 1,775 d ceqlaṯ afelḥesab n almiyzan n ccaqel meqdus, yeƹni 3,621 kilu. <verse eid="EXO 38:25" /><verse number="26" style="v" sid="EXO 38:26" />d lwajeb, kul yjen yuṣel 20 d isuggasen naγ iṭer yuca zgen n ceqel afelḥesab n almiyzan n ccaqel meqdus. aḏ wsiyn lliy mƹudden 603,550 d irgazen.<verse eid="EXO 38:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 38:27" />aḏ yusi almiyzan n lfejreṯ lliy ggenteṯ g nγal n tqeƹeṯin n umequs aḏ tqeƹeṯin n tireslin n stereṯis 100 d lweznaṯ, yeƹni 3,600 d lkiluwaṯ, yeƹni lweznaṯ ijeṯ y kul teqeƹet, teqrib 36 kilu. <verse eid="EXO 38:27" /><verse number="28" style="v" sid="EXO 38:28" />amma lliy yefdelled seg lfejreṯ lliy netta 1,775 d ceqlaṯ, yeƹni 21 kilu. ggen siyes lemxeṭef aḏ uzzelaṯ aḏ ixfawen n tireslin.<verse eid="EXO 38:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 38:29" />aḏ yusi almiyzan n nḥas lliy derejḥent midden d ṣṣedqeṯ zzaṯ rebbiy 70 d lweznaṯ aḏ 2,400 d ceqlaṯ, yeƹni 2,549 kilu. <verse eid="EXO 38:29" /><verse number="30" style="v" sid="EXO 38:30" />aḏ siyes yenγel tiqeƹeṯin n imi n lƹecceṯ n umlaqi aḏ mkan n teγrest aḏ rredjis aḏ reγeltis lkul. <verse eid="EXO 38:30" /><verse number="31" style="v" sid="EXO 38:31" />aḏ tqeƹeṯin n amas lḥuc lliy yenneḍ af lƹecceṯ aḏ tqeƹeṯin n imis aḏ ṭwelaṯ n lƹecceṯ aḏ ṭwelaṯ n amas lḥuc lliy yenneḍ siyes.<verse eid="EXO 38:31" /></para>
  <chapter eid="EXO 38" />
  <chapter number="39" style="c" sid="EXO 39" />
  <para style="s">lḥweyej n haruwn aḏ lkuhhan</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 39:1" />aḏ ggen seg ulman d izizewen aḏ d iḥberiyen aḏ d izuggaγen leḥweyej n lkuhhan bac atenirden g umeqdus. aḏ ggen leḥweyej imeqdusen n haruwn mammeḵ yuwa lliy diyma yella y muwsa.<verse eid="EXO 39:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 39:2" />aḏ ggen lufud seg tnelwin n wureγ aḏ ulman d izizewen aḏ d iḥberiyen aḏ d izuggaγen aḏ ustu n tefduxt. <verse eid="EXO 39:2" /><verse number="3" style="v" sid="EXO 39:3" />aḏ ggen tiḥdidin n wureγ aḏ kessen sisneṯ tinelwin bac atentezdden jar ulman izizewen aḏ iḥberiyen aḏ izuggaγen aḏ ustu n tefduxt mammeḵ yercem yjen d lfeleḥ. <verse eid="EXO 39:3" /><verse number="4" style="v" sid="EXO 39:4" />aḏ ggen y lufud sen tγerdin lṣeqneṯ bac adyas yeqƹeḏ af tγerdin n lliy tatyireḍ. <verse eid="EXO 39:4" /><verse number="5" style="v" sid="EXO 39:5" />aḏ leḥzamis lliy siyes ggent yeqƹeḏ seg aydin n ulman d izizewen aḏ d iḥberiyen aḏ d izuggaγen aḏ ustu n tefduxt aḏ tnelwin n wureγ mammeḵ yuwa lliy diyma yella y muwsa.<verse eid="EXO 39:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 39:6" />aḏ ggen sent tγuγa n ljizƹ g sent leḥweci n wureγ. aḏ aγezzen fellesneṯ ismawen n aṯ israyil mammeḵ tteγzen af txaṯemt n uṣeḥḥeḥ. <verse eid="EXO 39:6" /><verse number="7" style="v" sid="EXO 39:7" />aḏ ggentent af tγerdin n lufud mammeḵ yuwa lliy diyma yella y muwsa d tγuγa n usmiti y aṯ israyil.<verse eid="EXO 39:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 39:8" />aḏ ggen tmeṣdurt mammeḵ yercem yjen d lfeleḥ am lufud seg tnelwin n wureγ aḏ ulman d izizewen aḏ d iḥberiyen aḏ d izuggaγen aḏ ustu n tefduxt. <verse eid="EXO 39:8" /><verse number="9" style="v" sid="EXO 39:9" />aḏ tusi tmeṣdurt timrebbeƹt ṭṭulis aḏ lƹerḍis cebber aḏ tuḍi. <verse eid="EXO 39:9" /><verse number="10" style="v" sid="EXO 39:10" />aḏ tesri s 4 n ḏuren n tγuγa tiṣbiḥin; ḏur mezwar seg leƹqiq zuggaγ aḏ lyequt awreγ aḏ zmurruḏ. <verse eid="EXO 39:10" /><verse number="11" style="v" sid="EXO 39:11" />ḏur wissen d lbehreman aḏ lyaquwt zizew aḏ leƹqiq mellal. <verse eid="EXO 39:11" /><verse number="12" style="v" sid="EXO 39:12" />ḏur wi 3 seg ƹin lhir aḏ lyecmu aḏ lejemectu. <verse eid="EXO 39:12" /><verse number="13" style="v" sid="EXO 39:13" />ḏur wis 4 seg zberjeḏ aḏ ljizƹ aḏ lyecb. we aggentent lkul g leḥweci n wureγ. <verse eid="EXO 39:13" /><verse number="14" style="v" sid="EXO 39:14" />aḏ yeγez af kul tγuγa sisneṯ ysem n yjen seg aṯ israyil lliy nihnin 12 mammeḵ aγzenten af txaṯemt n uṣeḥḥeḥ.<verse eid="EXO 39:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 39:15" />aḏ ggen af tmeṣdurt sen n tseleslin seg wureγ ṣbiḥ ḏreneṯ am tezra. <verse eid="EXO 39:15" /><verse number="16" style="v" sid="EXO 39:16" />aḏ ggen sent leḥluq atṭefneṯ g leḍraf n tmeṣdurt s leḥwaci n wureγ. <verse eid="EXO 39:16" /><verse number="17" style="v" sid="EXO 39:17" />aḏ qqennen aydin n sen tseleslin n wureγ lliy ḏreneṯ g aydin sen tḥelqeṯin af ṭṭerf n tmeṣdurt. <verse eid="EXO 39:17" /><verse number="18" style="v" sid="EXO 39:18" />aḏ qqennen tiseleslin diyn g leḥwaci aḏ g tγerdin n lufud s zzaṯ. <verse eid="EXO 39:18" /><verse number="19" style="v" sid="EXO 39:19" />aḏ am idin ggen sen tḥelqeṯin n wureγ af ṭṭerf n tmeṣdurt s jjaj mani telṣeq af lufud. <verse eid="EXO 39:19" /><verse number="20" style="v" sid="EXO 39:20" />aḏ ggen sen tḥelqeṯin iḍen adug ṣder nnaj mkan lliy inetged diyes leḥzam lliy ggent yeqƹeḏ. <verse eid="EXO 39:20" /><verse number="21" style="v" sid="EXO 39:21" />aḏ qqennen tiḥelqeṯin n tmeṣdurt g tḥelqeṯin lliy nnaj leḥzam s ulman d izizewen ḏren bac ateqqim temeṣdurt nnaj leḥzam aḏ witetmukusc seg lufud. aḏ amyuh ggen temeṣdurt mammeḵ yuwa lliy diyma yella y muwsa.<verse eid="EXO 39:21" /></para>
  <para style="s">tḏellukt</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 39:22" />aḏ ggen tḏellukt d tezizewt mammeḵ iteg nessaz d lfeleḥ. <verse eid="EXO 39:22" /><verse number="23" style="v" sid="EXO 39:23" />aḏ yusi diyes imi n iγef g amas aḏ lburcman yeṣḥiḥ ggeṯ bac witetkeṣṣic. <verse eid="EXO 39:23" /><verse number="24" style="v" sid="EXO 39:24" />aḏ derjeḥneṯ g ṭṭerfis s dday tirummanin lliy ggentent seg ulman d izizewen aḏ d iḥberiyen aḏ d izuggaγen aḏ ustu n tefduxt. <verse eid="EXO 39:24" /><verse number="25" style="v" sid="EXO 39:25" />aḏ ggen jareseneṯ dnaden n wureγ ṣbiḥ. <verse eid="EXO 39:25" /><verse number="26" style="v" sid="EXO 39:26" />aḏ yusi jar kul sen tirummanin dendan af ddureṯ n tḏellukt s dday lliy reḍenteṯ almiy teggen lwajeb. amyuh ggen tḏellukt mammeḵ yuwa lliy diyma yella y muwsa.<verse eid="EXO 39:26" /></para>
  <para style="s">tisuriyin n haruwn aḏ ṭerwas</para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 39:27" />aḏ ggen tisuriyin n haruwn aḏ ṭarwas seg zeṭṭi n ustu n tefduxt. <verse eid="EXO 39:27" /><verse number="28" style="v" sid="EXO 39:28" />aḏ tezmelt aḏ tiƹeṣṣabin n lekbabes aḏ yserwalen ggenten lkul seg ustu n tefduxt. <verse eid="EXO 39:28" /><verse number="29" style="v" sid="EXO 39:29" />aḏ cemleṯ ggenteṯ seg ustu n tefduxt aḏ ulman d izizewen aḏ d iḥberiyen aḏ d izuggaγen mammeḵ iteg ṭerraz d lfeleḥ. amyuh ggenten mammeḵ yuwa lliy diyma yella y muwsa. <verse eid="EXO 39:29" /><verse number="30" style="v" sid="EXO 39:30" />aḏ ggen teḥdit n tezmelt seg wureγ ṣbiḥ aḏ aγezzen fellas mammeḵ af txaṯemt n uṣeḥḥeḥ: «iqeddes y lliy diyma yella.» <verse eid="EXO 39:30" /><verse number="31" style="v" sid="EXO 39:31" />aḏ qnenteṯ s tenelli tezizewt af tezmelt n haruwn s zzaṯ. amyuh ggenteṯ mammeḵ yuwa lliy diyma yella y muwsa.<verse eid="EXO 39:31" /></para>
  <para style="s">tmam n igga n umeqdus aḏ numris</para>
  <para style="p">
    <verse number="32" style="v" sid="EXO 39:32" />amyuh yentem igga n lƹecceṯ n umlaqi lkul. ggenteṯ aṯ israyil mammeḵ yuwa lliy diyma yella y muwsa. <verse eid="EXO 39:32" /><verse number="33" style="v" sid="EXO 39:33" />aḏ uγend lƹecceṯ al muwsa s reγeltis lkul; lemxeṭfis aḏ tqafeṣis aḏ lwesṭis aḏ tireslinis aḏ tiqeƹeṯinis. <verse eid="EXO 39:33" /><verse number="34" style="v" sid="EXO 39:34" />aḏ seqfis lliy seg ilimen n iberkas ṣbeγγen s uzuggaγ aḏ sqeffis lliy seg ilimen n trebit temeqqart lliy man γiyr tqecra, aḏ star lliy jar meqdus aḏ lquds n leqdas. <verse eid="EXO 39:34" /><verse number="35" style="v" sid="EXO 39:35" />aḏ ttebuwt n luwṣayaṯ aḏ igeṭṭumnis aḏ ddanis lliy d lƹerc n rreḥmeṯ. <verse eid="EXO 39:35" /><verse number="36" style="v" sid="EXO 39:36" />aḏ ṭṭewleṯ s reγeltis lkul aḏ tqurset n ṣṣedqeṯ. <verse eid="EXO 39:36" /><verse number="37" style="v" sid="EXO 39:37" />aḏ nnir n wureγ ṣbiḥ aḏ lkisanis aḏ reγeltis lkul aḏ uḏi n useγi. <verse eid="EXO 39:37" /><verse number="38" style="v" sid="EXO 39:38" />aḏ mkan n ubexxer lliy d wureγ aḏ uḏi meqdus aḏ lebxuwr lliy faweḥ aḏ star n imi n lƹecceṯ. <verse eid="EXO 39:38" /><verse number="39" style="v" sid="EXO 39:39" />aḏ mkan n teγrest lliy d nḥas s rredjis lliy d nḥas aḏ igeṭṭumnis aḏ reγeltis lkul aḏ ufedja n uzizdi aḏ tqeƹetis. <verse eid="EXO 39:39" /><verse number="40" style="v" sid="EXO 39:40" />aḏ stareṯ n amas lḥuc aḏ tireslinis aḏ tiqeƹeṯinis, aḏ star n imi n amas lḥuc aḏ tzarwinis aḏ ṭweleṯis aḏ reγleṯ n lxeḏmeṯ g lƹecceṯ n umlaqi. <verse eid="EXO 39:40" /><verse number="41" style="v" sid="EXO 39:41" />aḏ leḥweyej lliy arqemmen y lxeḏmeṯ g umeqdus; leḥwayej imeqdusen n haruwn lkahen, aḏ leḥwayej n ṭarwas lkuhhan.<verse eid="EXO 39:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="EXO 39:42" />amyuh ggen aṯ israyil lxeḏmeṯ lkul mammeḵ yuwa lliy diyma yella y muwsa. <verse eid="EXO 39:42" /><verse number="43" style="v" sid="EXO 39:43" />aḏ yesmuqel muwsa al lliy ggent lkul, yufa lliy nihnin ggent mammeḵ yuwa rebbiy, yaxy inumrin.<verse eid="EXO 39:43" /></para>
  <chapter eid="EXO 39" />
  <chapter number="40" style="c" sid="EXO 40" />
  <para style="s">sebbed n tezeqqa temeqdust aḏ numris</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 40:1" />aḏ yuwa lliy diyma yella y muwsa:<verse eid="EXO 40:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 40:2" />«yexs asebeddeḏ lƹecceṯ n umlaqi, lƹecceṯ temeqdust g as mezwar n cehher mezwar n suggas ƹebri. <verse eid="EXO 40:2" /><verse number="3" style="v" sid="EXO 40:3" />we aggeḏ diyes ttebuwt n luwṣayaṯ we ateḥerzeḏ s star. <verse eid="EXO 40:3" /><verse number="4" style="v" sid="EXO 40:4" />we aseḏfeḏ ṭṭewleṯ we atetseḥedreḏ. aḏ aseḏfeḏ nnir we asiγeḏ lkisanis. <verse eid="EXO 40:4" /><verse number="5" style="v" sid="EXO 40:5" />we aserseḏ mkan n ubexxer lliy d wureγ zzaṯ ttebuwt n luwṣayaṯ lliy yella deffer star. we aƹelqeḏ star n imi n lƹecceṯ.<verse eid="EXO 40:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 40:6" />we aserseḏ mkan n teγrest zzaṯ imi n lƹecceṯ n umlaqi. <verse eid="EXO 40:6" /><verse number="7" style="v" sid="EXO 40:7" />we aserseḏ fedja n uzizdi jar lƹecceṯ aḏ mkan n teγrest, aḏ čary s aman. <verse eid="EXO 40:7" /><verse number="8" style="v" sid="EXO 40:8" />we aggeḏ stareṯ n amas lḥuc lliy yenneḍ s lƹecceṯ, we aƹelqeḏ star n imis.<verse eid="EXO 40:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 40:9" />we adehneḏ s uḏi meqdus we aqedseḏ siyes lƹecceṯ aḏ reγeltis lliy diyes lkul bac addel y neči. <verse eid="EXO 40:9" /><verse number="10" style="v" sid="EXO 40:10" />am idin aqedseḏ mkan n teγrest aḏ reγeltis lkul we atqedseḏ bac aydel d lquds n leqdas. <verse eid="EXO 40:10" /><verse number="11" style="v" sid="EXO 40:11" />we adehneḏ fedja n uzizdi aḏ tqeƹetis bac atqedseḏ zada.<verse eid="EXO 40:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 40:12" />we adeγeḏ haruwn aḏ ṭarwas al imi n lƹecceṯ n umlaqi we asentzizdyeḏ. <verse eid="EXO 40:12" /><verse number="13" style="v" sid="EXO 40:13" />we asṣirdeḍ haruwn leḥweyjis imeqdusen we asneγleḏ uḏi bac atqedseḏ we aydel d lkahen y neči. <verse eid="EXO 40:13" /><verse number="14" style="v" sid="EXO 40:14" />we adeγeḏ ṭarwas we asentirḍeḏ tisuriyinesen zada. <verse eid="EXO 40:14" /><verse number="15" style="v" sid="EXO 40:15" />we asentneγleḏ we atenqedseḏ mammeḵ teggiḏ y babesen bac adlen d lkuhhan y neči. aḏ s uqeddes amyuh awerṯen lkehenut ljiyl beƹd ljiyl.» <verse eid="EXO 40:15" /><verse number="16" style="v" sid="EXO 40:16" />aḏ yeggi muwsa lliy yuwa fellas rebbiy lkul.<verse eid="EXO 40:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 40:17" />as diyn, g as mezwar n cehher mezwar n usuggas wissen ysebbed lƹecceṯ. <verse eid="EXO 40:17" /><verse number="18" style="v" sid="EXO 40:18" />yesers tiqeƹeḏinis aḏ ysebbed tqafeṣis aḏ lewasṭis aḏ tireslinis. <verse eid="EXO 40:18" /><verse number="19" style="v" sid="EXO 40:19" />aḏ yeggi sqef nnaj lƹecceṯ. aḏ yuḏenniṯ mammeḵ yuwa rebbiy.<verse eid="EXO 40:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 40:20" />aḏ yewya tilweḥin n luwṣayaṯ yeggineṯ g ttebuwt aḏ yeggi igeḍman af lejnab ttebuwt. aḏ yeggi anjis lƹerc n rreḥmeṯ. <verse eid="EXO 40:20" /><verse number="21" style="v" sid="EXO 40:21" />aḏ yewya ttebuwt al lquds n leqdas aḏ yeggi star zzaṯis. amyuh yeggi ttebuwt mammeḵ yuwa rebbiy.<verse eid="EXO 40:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 40:22" />aḏ yeggi ṭṭewleṯ g lƹecceṯ n umlaqi g ljiheṯ tebeḥrit n tzaqqa s barra y star. <verse eid="EXO 40:22" /><verse number="23" style="v" sid="EXO 40:23" />aḏ yeggi muwsa tqurset temeqdust af ṭṭawleṯ zzaṯ lliy diyma yella mammeḵ yuwayas. <verse eid="EXO 40:23" /><verse number="24" style="v" sid="EXO 40:24" />aḏ yeggi nnir g lƹecceṯ n umlaqi g ljiheṯ teqblit aḏ g leqbeleṯ n ṭṭewleṯ. <verse eid="EXO 40:24" /><verse number="25" style="v" sid="EXO 40:25" />aḏ yessiγas lkisanis zzaṯ rebbiy. amyuh yeggi nnir mammeḵ yuwayas.<verse eid="EXO 40:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 40:26" />aḏ yeggi mkan n ubexxer lliy d wureγ g lƹecceṯ n umlaqi zzaṯ star. <verse eid="EXO 40:26" /><verse number="27" style="v" sid="EXO 40:27" />aḏ yeḥreq diyes lebxuwr faweḥ mammeḵ yuwayas lliy diyma yella. <verse eid="EXO 40:27" /><verse number="28" style="v" sid="EXO 40:28" />aḏ yeggi star n imi n lƹecceṯ.<verse eid="EXO 40:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 40:29" />aḏ yeggi mkan n teγrest g imi lḥuc n lƹecceṯ n umlaqi. aḏ yeγres y rebbiy aḏ yeḥreqqas. aḏ yuca y rebbiy ṣṣedqeṯ n tiγwaw. mammeḵ yuwa lliy diyma yella y muwsa. <verse eid="EXO 40:29" /><verse number="30" style="v" sid="EXO 40:30" />aḏ yeggi fedja n uzizdi jar lƹecceṯ n umlaqi aḏ mkan n teγrest. aḏ yečury s aman y uzizdi. <verse eid="EXO 40:30" /><verse number="31" style="v" sid="EXO 40:31" />bac aysireḏ muwsa aḏ haruwn aḏ ṭarwas leḍrefesen s amanis. <verse eid="EXO 40:31" /><verse number="32" style="v" sid="EXO 40:32" />sirden leḍrefesen diyes. aḏ yexs atensirden kul man aḏeḏfen al lƹecceṯ n umlaqi naγ aqrebben al mkan n teγrest. amyuh ggen mammeḵ yuwa lliy diyma yella y muwsa.<verse eid="EXO 40:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 40:33" />aḏ iṣunuḍ muwsa s stareṯ af amas lḥuc lliy yenneḍ s lƹecceṯ aḏ mkan n teγrest. aḏ iƹelleq star n imis s mcerreq. amyuh ykemmel muwsa lxeḏmeṯ lkul.<verse eid="EXO 40:33" /></para>
  <para style="s">lmejd n rebbiy yuḏen tezeqqas</para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 40:34" />yaxy ƹlewleh tuḏen tesḥebt lƹecceṯ n umlaqi. aḏ yečuriṯ lmejd n lliy diyma yella. <verse eid="EXO 40:34" /><verse number="35" style="v" sid="EXO 40:35" />wiqudc muwsa ayeḏef al lƹecceṯ n umlaqi afelxaḍert tesḥebt tezwa fellas. aḏ lmejd n lliy diyma yella yčuriṯ.<verse eid="EXO 40:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 40:36" />kul man atmukes tesḥebt s nnaj lƹecceṯ wsiyn aṯ israyil rezfen. <verse eid="EXO 40:36" /><verse number="37" style="v" sid="EXO 40:37" />amma kan witmukesc tesḥebt wsiyn tqiman diyn almiy tmukes. <verse eid="EXO 40:37" /><verse number="38" style="v" sid="EXO 40:38" />aḏ tusi tesḥebt n lliy diyma yella tetteḏen lƹecceṯ ug as. aḏ tetreq am timsi g yiḍ zzaṯ ṭiṭawin n aṯ israyil mani rzeffen.<verse eid="EXO 40:38" /></para>
  <chapter eid="EXO 40" />
</usx>