<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- Wale Magar Kham</book>
  <para style="h">युहन्ना</para>
  <para style="toc3">युहन्ना</para>
  <para style="toc2">युहन्ना</para>
  <para style="toc1">युहन्नाये ओसोरो चाव सोर</para>
  <para style="mt2">यूहन्नाले लेखेको सुसमाचार</para>
  <para style="mt1">युहन्नाये ओसोरो चाव सोर</para>
  <para style="imt">कितापलाई सरेःने</para>
  <para style="ip">आव साःरौ न्यामला चार गोटा कितापरंकामटा टोबो ची। जोये येसु मसिहलो उजीबनलो ओबारेलं बर्नन डोवये। नो भरिलाई स्यान्टैलाई गोस्पल हैवार्सिये। नोलो ओमाने चाव सोर टाये। आव कितापरं येसु ओनाव छिन्डे मत्ती, मर्कुस, लुका सोनो युहन्नाराई यासोरो ची। युहन्नाये ओसोरो चाव सोर, येसु ओजर्मीवकाम ठोकै ९० साल छिन्डे युहन्नाये ओसोरो ची। आव कितापटं सर्सिव माले, हैनि पनि किताप सर्ने ओतरिका युहन्नालो पैला, डोस्रा सोनो तेस्रा उचिठीसं भ्याबिछु मिलिये। कोइ डोङ्का किताप सर्ने मीराई याबिचार अनंसार युहन्ना एफिसंसला सहरलं उलिज़्याव। हैजैडे आव किताप एफिसंसलं सर्सिव टाव ढुव।</para>
  <para style="ip">युहन्नाये चावसं बुझैडेज़ हैवार्डेले आव कितापये हैवार्ने ओपान्ज़्याव रोः आवज़, मीरंलाई ऐटाव बिस्वास डाने सायटा डोवये कि येसुज़ मसिह ची, होसोनो येसुज़ ज्युङडा परमेस्वरलो ओज़ाची। ऐटाव बिस्वास डोकं येसुलो उमिनङाम गे जीबन गेडैये। आव किताप यहुडी सोनो उरु स्यान्टै मीराई यापरिःनेलो लागिटं सर्सिव ची। युहन्नाये ओसोरो चाव सोर उरु सोम्बऱ्याङ चाव सोररंकाम जामा छुटं ले। युहन्नाये येसुये ओपाङो सात्रोटं माङ्क बुरु येसुये ओडोव अचम्बला येःनटं जोर डोवये। येसुलो बप्तिस्मा सोनो उपरिछ्या स्यानाव मुख्या येःनलो ओबारेलं पनि युहन्नालो आव चाव ओसोरटं सर्सिव माले।</para>
  <para style="iot">आव ज्युङला बिसयेरं</para>
  <para style="io1">१. युहन्नाये चाव सोर ओठालिव <char style="ior"><ref loc="JHN 1:1-18">१:१-१८</ref></char></para>
  <para style="io1">२. होकाम येसुये ओडोव बनै भ्या अचम्बला येःनराई याबारेलं सर्डेनोयो। <char style="ior"><ref loc="JHN 1:19-12:50">१:१९—१२:५०</ref></char></para>
  <para style="io1">३. होकाम नोये येसुलो उजीबनला स्यान्टै घटनाराई याबारेलं सर्डेनोयो। जोये येसुलो उसिने सोनो फरि ज्युङडा ओटानेलो ओबारेलं हैवार्ये। <char style="ior"><ref loc="JHN 13:1-20:31">१३:१—२०:३१</ref></char></para>
  <para style="io1">४. युहन्नाये उकिताप सर्ने २१ अड्यालं खेमोये। नलं येसुलो सिडे ज्युङडा ओटाने बारेलं सोनो येसुये कै-कै झैडे डर्सन ओयोव आवलो उडारनलो लागिटं टोबो घटनालो ओबयान डोवये होसोनो उकितापये ओपैज़्याव रोः हैवार्ये।</para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s">जीबनज़ बचन</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1" />डोङ्क बचन लेव, बचन परमेस्वरसं लेव, होसोनो बचन परमेस्वर लेव। <verse eid="JHN 1:1" /><verse number="2" style="v" sid="JHN 1:2" />ओल डोङ्क परमेस्वरसं लेव।<verse eid="JHN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 1:3" />स्यान्टै बस्त परमेस्वरये ओलज़ उसिर्जोयो होसोनो ओल उसिर्जोयोकाम कडि बस्त पनि ओबाठङ मासिर्जिये। <verse eid="JHN 1:3" /><verse number="4" style="v" sid="JHN 1:4" />ओल्स जीबन लेव, होकाम नो जीबन मीराई याज्योती लेव। <verse eid="JHN 1:4" /><verse number="5" style="v" sid="JHN 1:5" />नो ज्योती अन्ड्यारोलं चम्किये, होकाम अन्ड्यारो नोसं माझ्याङडुये।<verse eid="JHN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6" />परमेस्वरङाम परिःङसिव टोबो मी लेव, नोलो उमिन युहन्ना लेव। <verse eid="JHN 1:6" /><verse number="7" style="v" sid="JHN 1:7" />नोये मीरंलाई नो उज्यालोलो ओबारेलं गोहाइ यानेलो लागिटं ओराव, कडालेकं स्यान्टै मीराई नोलो ओसोर ठैडे बिस्वास गोडोरंकं। <verse eid="JHN 1:7" /><verse number="8" style="v" sid="JHN 1:8" />हो ओलज़ नो ज्योती माङ्क बुरु नो ज्योतीलो गोहाइ याने ओराव। <verse eid="JHN 1:8" /><verse number="9" style="v" sid="JHN 1:9" />स्यान्टै मीरंलाई उज्यालो याने सत्य ज्योती प्रिठीबीलं रारिज़्या।<verse eid="JHN 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 1:10" />नो प्रिठीबीलंज़ लेव, प्रिठीबी नो लेवङामज़ उसिर्जिव, हैटानि पनि प्रिठीबीये नोलाई मासरेवये। <verse eid="JHN 1:10" /><verse number="11" style="v" sid="JHN 1:11" />नो ओल उमीरं लेवकंज़ ओराव, होटानि पनि उमीराई ओललाई ग्रहन माडोरंये। <verse eid="JHN 1:11" /><verse number="12" style="v" sid="JHN 1:12" />होकाम जोराई येसुलाई ग्रहन डाडे ओल उमिन्ट बिस्वास याडोरं, नोरंलाई होये परमेस्वरलो ओसन्तान टाने अडिकार ओयोवरं। <verse eid="JHN 1:12" /><verse number="13" style="v" sid="JHN 1:13" />नोरं न झीङाम, न क्याङलो इछ्याङाम, होसोनो न कोइ मीलो उइछ्याङाम जर्मीव टारंये बुरु नोरं के परमेस्वरङाम जर्मीवरं टारंये।<verse eid="JHN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14" />होकाम बचन क्याङ टाडे डया सोनो सत्यये ब्यालडे गेखार्ल बास ओडोव। गे येसुलो ओमहिमा गेरोःङो, नो महिमा बाबुङाम राःव टोबोयाज़ ओज़ालो स्याव लेव।<verse eid="JHN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15" />युहन्नाये येसुलो ओबारेलं गोहाइ यावग्यान डाडे कस्सिडे किःडे हैओडोवरं, “येसु नो मीज़, जोलो ओबारेलं ङा हैङावारो, ‘ङा भन्डा छिन्डे राने ङा भन्डा पनि घ्योव ले, कडालेकं नो ङा भन्डा ङाडेकामज़ लेव।’”<verse eid="JHN 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 1:16" />नो लेवङामटा पुरा डयाये गे टोबो डया तर्ट छुटं डया डैडेगेनै। <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />कडालेकं न्याम मोसाङाम यासिव लेव, हैनि पनि डया सोनो सत्यके येसु ख्रीस्टङाम ओराव। <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />परमेस्वरलाई काङ्कायेज़ खर्कज़ यारोःङो माले। बाबुसं लिज़्याव टोबो याज़ ज़ाये परमेस्वरलाई सटन्डे नोयो।<verse eid="JHN 1:18" /></para>
  <para style="s">बप्तिस्मा याने युहन्नालो ओसोर</para>
  <para style="r">
    <ref loc="MAT 3:1-12">मत्ती ३:१-१२</ref>; <ref loc="MRK 1:1-8">मर्कुस १:१-८</ref>; <ref loc="LUK 3:1-18">लुका ३:१-१८</ref></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />यरुसलेमला यहुडी अडिकारीराई सेवा डोने मीरं सोनो लेबीरंलाई नो लेवकं “नङ काङ्का?” वार्डे पजोयो यापरिःङोरं, होकाम युहन्नालो ओगोहाइ ऐटाव लेव। <verse eid="JHN 1:19" /><verse number="20" style="v" sid="JHN 1:20" />नोये होरंलाई जबाफ योने ओभनो ङाम्यो मावार्ये, “ङा ख्रीस्ट माङ्कची ओवारो।”<verse eid="JHN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21" />होकाम नो राव मीराई युहन्नालाई यापजोयो, “होकाम नङ काङ्का? नङ एलिया रो?”</para>
  <para style="q1" vid="JHN 1:21">नोये हैओवारो “ङा माङ्कची।”</para>
  <para style="q2" vid="JHN 1:21">“होकाम नङ अगमबक्ता रो?”</para>
  <para style="q2" vid="JHN 1:21">नोये जबाफ ओयोवरं, “माङ्कची।”<verse eid="JHN 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22" />नोराई नोलाई हैयाडोव, “नङ काङ्का गेलाई हैगडासिके, गेलाई परिःङनेरंलाई गे जबाफ याव गिढुकं। नङ नबारेलं नङ कैनंवार?”<verse eid="JHN 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23" />नोये हैओवारो यसैया अगमबक्ताये हैओवारो मान्टि,</para>
  <para style="q1" vid="JHN 1:23">“घ्योव प्रभुलो ओयेम तयार झैच्यो”</para>
  <para style="q2" vid="JHN 1:23">वार्डे जङ्गललं किःने ङा टोबो मीलो ओगा ची।<verse eid="JHN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24" />नोरं फरिसीराई यापरिःङो सोर रैने मीरं लेवरं। <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />होकाम नोराई नोलाई यापजोयो “नङ ख्रीस्ट पनि माङ्क, एलिया पनि माङ्क, नो अगमबक्ता पनि माङ्क याटाखे भने कडाने बप्तिस्मा नयोज़्यावरं?”<verse eid="JHN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26" />युहन्नाये नोरंलाई हैओडोवरं, “ङाके रीःये बप्तिस्मा ङायोरं, बुरु जेखार्ल टोबो च्याङसिव लिज़्या, नोलाई जे जेमसरेये। <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />ङा भन्डा झिन्डे राःने नोज़। ङा नोलो ओपनैलो ओटस्मा पलाने हाडङ्का पनि ङाम्ले।”<verse eid="JHN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28" />आव रोः यर्डन भै होपंटं बेठानियालं ओटाव, नलं युहन्नाये बप्तिस्मा ओयोज़्यावरं।<verse eid="JHN 1:28" /></para>
  <para style="s">परमेस्वरलो ओमार</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />ओपराटि युहन्नाये येसुलाई ओललेवडे ओराज़्याव रःङडे हैओवारो, “रःङच्यो प्रिठीबीला पापलाम छुटैडे लाङने परमेस्वरलो ओमार! <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />नो होज़, जोलो ओबारेलं ङा हैङावारो, ‘ङा भन्डा टोबो मी रानेले, नो ङा भन्डा घ्योव ले, कडालेकं नो ङा भन्डा ङाडेकामज़ लेव।’ <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />नो काङ्का ङा नोलाई ङासरेव मालेव, बुरु नोलाई इस्राएलला मीराई गसरेरंकं वार्डेज़ रीःलो बप्तिस्मा याये-याये ङाराव।”<verse eid="JHN 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32" />युहन्नाये ऐवार्डे गोहाइ ओयोव, “ङा चोखो आत्मालाई परिवा स्यानाव स्वर्गटाम झरिडे राडे येसुलो ओतर्ट उचुङो ङारोःङो। <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />ङा नोलाई ङासरेव माले, बुरु जोये ङालाई रीःये बप्तिस्मा योरं वार्डे उपरिःङसोङो, होयेज़ ङालाई हैओडाङो, ‘जोलो ओतर्ट चोखो आत्मालाई नङ झरिडे चुङोग्यान ओडोज़्याव रःङनेनले, चोखो आत्माये बप्तिस्मा याने नोज़।’ <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />ङा ङारोःङोले, होसोनो गोहाइ ङायोवले, परमेस्वरलो ओज़ा नोज़।”<verse eid="JHN 1:34" /></para>
  <para style="s">येसुलो ङाडेका उसिसरं</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />फरि ओपराटि युहन्ना उसिसरंकाम नेम्लोसं च्याङसिडे उलिज़्याकं। <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />नोये येसुलाई ओनाज़्याव रःङडे हैओवारो, “रःङच्यो परमेस्वरलो ओमार!”<verse eid="JHN 1:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37" />नोये ऐओवार्ज़्याव ठैडे नो नेम्लो उसिसनि येसुलो उझिन्ट नेनाव। <verse eid="JHN 1:37" /><verse number="38" style="v" sid="JHN 1:38" />येसुये वोल्डे ओरोःङो, होकाम नोनिलाई उझिन-उझिन नेराज़्याव रःङडे नोनिलाई ओपजोयोनि, “जिन कडि जिखिमज़्याव?”</para>
  <para style="p" vid="JHN 1:38">नोनि येसुलाई हैनेडोव, “रब्बी (आवलो ओमाने, गुरबा), नङ काङ नलिज़्याव?”<verse eid="JHN 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39" />येसुये नोनिलाई हैओडोवनि, “गराचिनके, होकाम जिन रःङने जेले।” नोनि नेनाव होकाम येसु ओबासिज़्याव पो नेरोःङो। नोनि नो छ्याम येसुसंज़ नेबासिव, कडालेकं ठोकै चार बजिडे उलिज़्याव।<verse eid="JHN 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40" />युहन्नाये हैओवार्ज़्याव रोः ठैने सोनो येसुलो उझिन-उझिन बाने नो नेबऱ्याङनिकाम टोबो सिमोन पत्रुसलो ओभाइ अन्ड्रियास लेव। <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />होकाम नो ङाःडे ओडाज्यु सिमोनसं नेडैसिव, होकाम होलाई हैओडोव “गिन मसिहलाई (नोलो ओमाने ख्रीस्ट) गेडोयो।” <verse eid="JHN 1:41" /><verse number="42" style="v" sid="JHN 1:42" />नोये सिमोनलाई येसु लेवकं ओरोयो।</para>
  <para style="p" vid="JHN 1:42">येसुये नोलाई ओरोःङो होकाम हैओडोव, “नङ युहन्नालो ओज़ा सिमोनज़, नङलाई केफास (नोलो ओमाने, पहर) डासिने नले।”<verse eid="JHN 1:42" /></para>
  <para style="s">येसुये फिलिप सोनो नठानेललाई उखुलोनि</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />नोलो ओपराटि येसुये गालीललं नाने युङ ओडोव। होकाम फिलिपसं डैसिडे येसुये नोलाई हैओडोव, “ङाछिन्ट गरानके।” <verse eid="JHN 1:43" /><verse number="44" style="v" sid="JHN 1:44" />अन्ड्रियास सोनो पत्रुस मान्टि फिलिप पनि बेठसेडा गाउँलाज़ लेव। <verse eid="JHN 1:44" /><verse number="45" style="v" sid="JHN 1:45" />फिलिपये नठानेलसं डैसिडे हैओडोव, “नोलो ओबारेलं मोसाये न्यामटं सोनो अगमबक्ताराई पनि सर्डे यानैज़्याव, हो नो योसेफलो ओज़ा नासरतला येसुलाई गे गेडोयो।”<verse eid="JHN 1:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46" />नठानेलये नोलाई हैओडोव, “कडा नासरतलाम पनि चाव रोः राव ढुव डोरो?”</para>
  <para style="p" vid="JHN 1:46">फिलिपये नोलाई जबाफ ओयोव, “राडे गरःङरिके।”<verse eid="JHN 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47" />येसुये नठानेललाई ओललेवडे ओराज़्याव रःङडे नोलो ओबारेलं हैओवारो, “टोबो पक्का इस्राएलीलाई रःङच्यो, नोलो उयुङलं कडि छल कपटज़ माले।”<verse eid="JHN 1:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48" />नठानेलये ओपजोयो, “नङ ङालाई कैजैडे नसरेसोङो?”</para>
  <para style="p" vid="JHN 1:48">येसुये नोलाई जबाफ याडे हैओडोव, “फिलिपये नङलाई उखुल्सनज़्याव भन्डा ङाःडे, डीलो उसिङ खङलं ङा नङलाई ङारःङसोनो।”<verse eid="JHN 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49" />नठानेलये येसुलाई हैओडोव, “रब्बी, नङ परमेस्वरलो ओज़ाज़, नङ इस्राएलला राजाज़।”<verse eid="JHN 1:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50" />येसुये नोलाई जबाफ याडे ऐओडोव “ङा नङलाई डीलो उसिङ खङलं ङारःङसोनो ङावारोयेज़ नङ बिस्वास नडोव? नङ आव भन्डा अजं घ्योव रोःरं रःङनेनले।” <verse eid="JHN 1:50" /><verse number="51" style="v" sid="JHN 1:51" />होकाम येसुये नोरंलाई हैओडोवरं, “डस्साज़ ङा जेलाई हैङाडाच्यो, जे स्वर्ग ओफैसिज़्याव सोनो परमेस्वरलो ओकटंवालरंलाई स्वर्गडे यानाज़्याव सोनो मानवालो ओज़ा लेवटं याराज़्याव रःङनेजेले।”<verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s">काना नाङखारला बेह्याँ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />सोङलाका गालीलला काना नाङखारलं टोबो बेह्याँ लेव। येसुलो वामा पनि नलं लेव। <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />येसु सोनो उसिसरंलाई पनि नो बेह्याँलं खुल्डे यानैज़्यावरं। <verse eid="JHN 2:2" /><verse number="3" style="v" sid="JHN 2:3" />अङ्गुरलो उरीः ओखेमो पाना येसुलो वामाये येसुलाई हैओडोव, “नोरासंके अङ्गुरलो उरीः माले।”<verse eid="JHN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4" />येसुये वामालाई हैओडोव, “ए आमा<note caller="+" style="f"><char style="fr" closed="false">२:४ </char><char style="ft" closed="false">मान डाडे ओपाङो आखर</char></note>, ङा कडि डाने ङालाई हैटाडाङ। ङाबेला अजं माराटा।”<verse eid="JHN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5" />येसुलो वामाये नौकररंलाई हैओडोवरं, “जे येसुये हैओवारो स्यानाव झैच्यो।”<verse eid="JHN 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6" />होकाम यहुडीराई चोखैसिने याचलनलो लागिटं रीः गप्ने लुङलो छ गोटा मान्ठरं नैसिव लेवरं नलं ठोकै बीस तीस पाठी नाये। <verse eid="JHN 2:6" /><verse number="7" style="v" sid="JHN 2:7" />येसुये नोरंलाई हैओडोवरं, “मान्ठरं रीःये सब्यालच्यो।” नोराई मान्ठलो ओया समंज़ रीःये यासब्यालो। <verse eid="JHN 2:7" /><verse number="8" style="v" sid="JHN 2:8" />येसुये नोरंलाई हैओडोवर, “टिगिडा वाप्डे आव बिह्याँ भोजला मुख्या लेवकं गलाङच्योके।” नोराई नो यालाङो। <verse eid="JHN 2:8" /><verse number="9" style="v" sid="JHN 2:9" />बिह्याँ भोजला मुख्याये नो रीः ओडारो, नो के आबो अङ्गुरलो उरीः टाडे उलिज़्याव। नो काङाम ओराव नोलाई ठा मालेव, बुरु रीः गप्ने नौकररंलाई याज़ ठा लेव। होकाम भोजला मुख्याये डुलाहालाई खुल्डे हैओडोव, <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />“स्यान्टै मीराई ङाःडे चाव अङ्गुरलो उरीः योरंये होकाम मीराई बनै याओँव पाना माडारो अङ्गुरलो उरीः योरंये। नङके चाव अङ्गुरलो उरीः आर्क समंज़ जोगैडे नैडेननै।”<figure style="fig" alt="Filling water in the stone jars" file="lb00135c.tif" size="col" copy="Horace Knowles ©" ref="२:७">लुङलो जालं रीः याझाज़्याव</figure><verse eid="JHN 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11" />येसुये ओडोव येःनरं मढ्येलाम आव गालीलला काना नाङखारला येसुलो पैलाला अचम्बला चिन्न लेव। ऐजैडे येसुये ओमहिमा ओसोटोनो, होकाम येसुलो उसिसराई येसुलाई बिस्वास याडोव।<verse eid="JHN 2:11" /></para>
  <para style="s">येसु प्रार्ठना डोने ज़ीःमडे ओनाव</para>
  <para style="r">
    <ref loc="MAT 21:12-13">मत्ती २१:१२-१३</ref>; <ref loc="MRK 11:15-17">मर्कुस १1:१५-१७</ref>; <ref loc="LUK 19:45-46">लुका १९:४५-४६</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12" />होकाम येसु वामा, ओभाइरं सोनो उसिसरासं कफर्नहुमलं याझरिव, होकाम जामा डिन समं नलं यालेव।<verse eid="JHN 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />यहुडीराई निस्तार यापर्ब राने नजिकज़ लेव होकाम येसु याडे यरुसलेमडे उपुलुव। <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />येसुये प्रार्ठना डोने ज़ीःमलं मीराई यिःङ, भेडा, परिवा यायेज़्याव सोनो यालंःङज़्याव होसोनो पैसा याटोःज़्याव ओडैरिवरं। <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />होकाम चीःङलो टोबो कोर्रा झैडे येसुये प्रार्ठना डोने ज़ीःमलाम नो स्यान्टैरंलाई, नोराई याभेडारं सोनो याःयिःङःरंलाई समं ओरोवरं, होसोनो पैसा टोनेराई यापैसा घोप्टैड्यारंडे नोराई याटेबल पल्टैडे ओयोवरं। <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />परिवा येनेरंलाई येसुये हैओडोवरं, “आलाम आव स्यान्टै लाङच्यो। ङा ङाबाबुलो उज़ीःमलाई बैपारलो ज़ीःम टाझैच्यो।” <verse eid="JHN 2:16" /><verse number="17" style="v" sid="JHN 2:17" />येसुलो उसिसराई सास्त्रटा सर्सिव आव रोः याचेटोयो, “नज़ीःमला जोसये ङालाई सचाङनेले।”<note caller="+" style="x"><char style="xo" closed="false">2:१७ </char><char style="xt" closed="false"><ref loc="PSA 69:9">भजनरं ६९:९</ref></char></note><verse eid="JHN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18" />यहुडीराई येसुलाई हैयाडोव, “नङ आव येःन कडि अडिकारये नडोज़्याव प्रमानलो लागिटं गेलाई कडि चिन्न सटन्डे नयासि?”<verse eid="JHN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19" />येसुये नोरंलाई जबाफ ओयोवरं, “आव प्रार्ठना डोने ज़ीःमलाई गटैच्योके, होकाम ङा सोङलाका तयार झैनेङाले।”<verse eid="JHN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20" />होकाम यहुडीराई हैयावारो, “आव प्रार्ठना डोने ज़ीःमलाई झैने छेयालिस बर्स ओलागिव, होकाम नङ आवलाई सोङलाका तयार नझैडु डोरो?” <verse eid="JHN 2:20" /><verse number="21" style="v" sid="JHN 2:21" />जो प्रार्ठना डोने ज़ीःमलो ओबारेलं येसुये ओपाङो, हो येसुलो ओक्याङ लेव। <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />येसु सिवलाम ज्युङडा ओटाव, होकाम येसुये हैओवारो आव रोः उसिसराई याचेटोयो, होकाम नोराई सास्त्र सोनो येसुये ओपाङो बचनटं बिस्वास याडोव।<verse eid="JHN 2:22" /></para>
  <para style="s">मीरं खैटाव टारंये येसुये सोनोये</para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />होकाम निस्तार पर्बला भोजलो बेलाकं येसु यरुसलेमलंज़ लेव, होकाम येसुये ओडोज़्याव चिन्नरं रःङडे भ्या मीराई येसुलो उमिन्ट बिस्वास याडोव। <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />कडालेकं येसुये स्यान्टै मीरं खैटाव टारंये वार्डे सोनोये हैजैडे येसु नोराई याभर मापरिये। <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />येसुलाई मीलो ओबारेलं काङ्कायेज़ पोयो परिने मालेव, कडालेकं मीलो उयुङलं कडि टाये, नो येसुये ओल्ज़ सोनोये।<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s">येसु सोनो निकोडेमस</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />निकोडेमस उमिन लेव टोबो फरिसी लेव। नो यहुडीराई यासेःर लेव। <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />नो रिलं येसु लेवकं ओराव, होकाम येसुलाई हैओडोव, “गुरबा, गे गेसन नङ परमेस्वरङाम गेलाई पैने नरावज़, कडावार्क परमेस्वर मीसं मालेखे भने नङ नडोज़्याव आव चिन्नरं काङ्कायेज़ माडोडुव।”<verse eid="JHN 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3" />येसुये नोलाई जबाफ ओयोव, “डस्साज़ ङा नङलाई हैङाडान, कोइ मी साःरौ टाडे माजर्मीखे भने नोये परमेस्वरलो ओराज्य मारःङढुव।”<verse eid="JHN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4" />निकोडेमसये येसुलाई हैओडोव, “मी बड्डाडे कैजैडे जर्मीसिडु ड? सै वामालो ओकोखंलं फरि टखेप पसिडे जर्मीडु डोरो?”<verse eid="JHN 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5" />येसुये जबाफ ओयोव, “डस्साज़ ङा नङलाई हैङाडानज़्या कोइ रीः सोनो आत्माङाम माजर्मीखे भने हो परमेस्वरलो ओराज्यलं मापसिडु। <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />कडालेकं क्याङटाम जर्मीव क्याङज़, होसोनो चोखो आत्माङाम जर्मीव आत्माज़। <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" />ङा नङलाई साःरौ टाडे जर्मीने पानो ङाडानकं अचम्ब टाटाङन। <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" />बतास जोडे ओमन लागि होडेज़ बगिये। नङ बतासलो ओगा याज़ नठैये, होकाम नो काङाम ओराज़्याव होसोनो कान्डे ओनाज़्याव, नो नमसंनये। आत्माङाम जर्मीव स्यान्टै मीरं हैटावज़ टारंये।”<verse eid="JHN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9" />निकोडेमसये येसुलाई ओपजोयो, “आव कैझैडे टाव ढुव?”<verse eid="JHN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10" />येसुये नोलाई जबाफ ओयोव, “नङ इस्राएलला यागुर टाडे पनि आव रोः नम्बुझिये? <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" />डस्साज़ ङा नङलाई हैङाडान, गे जो गेसन हो हैगेवार्ये, होसोनो गे जो गेरोःङो होज़ गोहाइ गेयोये, हैनि पनि जे गेगोहाइ जिम्पतिये। <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />ङा जेलाई प्रिठीबीला रोः हैङाडाच्योकं पनि जे बिस्वास जेमडाये, होकाम जेलाई स्वर्गटा रोः हैङाडाच्योखे भने कैजैडे बिस्वास जेडा? <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" />स्वर्गटाम झरिडे राने मानवालो ओज़ा बाहेक काङ्का पनि स्वर्गटं उपुलुव माले।<verse eid="JHN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 3:14" />जोझैडे बनलं मोसाये गुललाई ओछेनो, हैजैडेज़ मानवालो ओज़ा छेन्सिव परिये, <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />होसोनो जो-जोये होलाई बिस्वास डोरं होराई खर्कज़ मासिने जीबन डैनेलेरं।” <verse eid="JHN 3:15" /><verse number="16" style="v" sid="JHN 3:16" />“कडालेकं परमेस्वरये प्रिठीबीलाई ऐटाव मया ओडोव, परमेस्वरये टोबोका टोबो ओज़ालाई ओयोव, ओललाई बिस्वास डाने काङ्का पनि नास टाटाकं, बुरु नोये खर्कज़ माखेम्ने जीबन ओडोयोकं। <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" />कडावार्क परमेस्वरये प्रिठीबीलाई डोसि ठहरैने वार्डे ओज़ालाई प्रिठीबीलं उपरिःङो माङ्क बुरु प्रिठीबी ओज़ाङाम ओबान्चिकं वार्डे उपरिःङो।<verse eid="JHN 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 3:18" />जोये येसुलाई बिस्वास डोव, नो डोसि ठहरिने माले, बुरु बिस्वास माडानेके ङाडेज़ डोसि ठहरिडेले, कडालेकं नोये परमेस्वरलो टोबोका टोबो ओज़ालो उमिन्ट बिस्वास ओडोव माले। <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" />फासिला आवज़ उज्यालो प्रिठीबीलं राडेले, होकाम मीराई उज्यालोलाई भन्डा बुरु अन्ड्यारोलाई मया याडोव, कडालेकं नोराई यायेःन माचाव लेव। <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" />माचाव येःन डाने स्यान्टैरं उज्यालोलाई घिनैरंये, होकाम उज्यालोटं मारारं, मानिके नोराई यायेःन रःन्नेले। <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" />सत्यलं बाने मी उज्यालोटं रानेले, होकाम ऐजैडे नोये ओडोव येःनरं परमेस्वरङाम डासिवज़ वार्ने स्यान्टै रःन्नेले।”<verse eid="JHN 3:21" /></para>
  <para style="s">येसु सोनो युहन्ना</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />होकाम येसु उसिसरासं यहुडिया प्रडेसलं ओनाव, होकाम नलं नोरासं जामा डिन ओलेव, होसोनो मीरंलाई बप्तिस्मा ओयोवरं। <verse eid="JHN 3:22" /><verse number="23" style="v" sid="JHN 3:23" />युहन्नाये पनि सालीमलो ओछ्योकं एनोनलं बप्तिस्मा ओयोज़्यावरं, कडालेकं नलं बनै भ्या रीःलेव। नलं मीरं राडे बप्तिस्मा रैरंये। <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" />नो बेला समं युहन्ना झ्यालखानालं उम्परिटाव।<verse eid="JHN 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 3:25" />नो बेलाकंज़ युहन्नालो उसिसरं टोबो यहुडीसं चोखैसिनेलो ओबारेलं यायुसिज़्याव। <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />युहन्ना लेवकं राडे नोराई युहन्नालाई हैयाडोव, “गुरबा यर्डन भै होपंटं जो नङसं लेव, जोलो ओबारेलं नङ गोहाइ नयोव, रःङखेने, नोये बप्तिस्मा योज़्यावरं, स्यान्टै नो लेवकं नाज़्यारं।”<verse eid="JHN 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27" />युहन्नाये जबाफ ओयोवरं, “मीलाई स्वर्गटाम मायाया समं नोये कडिज़ माडोयोये। <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" />‘ङा ख्रीस्ट माङ्कची, बुरु ङालाई नो भन्डा ङाःडे परिःङसिव ची’ वार्ने ङागोहाइरं जेज़। <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />जोसं डुलही लिज़्या, डुलाहा नोज़। डुलाहालो ओनै नोज़ जो ओल्स ओछ्योकं च्याङसिव टाये, नोलो ओगा ठोयो होकाम बनै रेङये। हैजैडे आव ङाखुसि आबो पुरा टाडेले <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />येसु बडिने बुरु ङा के घटिनाव परिये।”<verse eid="JHN 3:30" /></para>
  <para style="s">नो स्वर्गटाम ओराव</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />“रोटाम रारिज़्याव स्यान्टैराई भन्डा घ्योव ले। प्रिठीबीलाम टाने प्रिठीबीलोज़, होसोनो प्रिठीबीला रोःज़ पाङये। स्वर्गटाम राने स्यान्टैराई भन्डा घ्योव ले। <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />नोये जो रःङडे सोनो ठैडे नोयो, होलो ओगोहाइज़ योवये, हैनि पनि नोलो ओगोहाइ काङ्कायेज़ मापतिरं। <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />जोये नोलो ओगोहाइ पतिव, नोये परमेस्वर सत्य ले वार्ने रोःलो प्रमान योवये। <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />कडालेकं जोलाई परमेस्वरये उपरिःङो, नोये परमेस्वरलो ओपाङ पाङये, कडालेकं परमेस्वरये नोलाई ओआत्मा योवये। <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" />बाबुये ओज़ालाई मया डोवये, होकाम स्यान्टै बस्तज़ उकुइटं याडेनोयो। <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />जोये ओज़ालाई बिस्वास डोवये, नोसं खर्कज़ मासिने जीबन ले। जोये ओज़ालो ओरोः माठोयोये, नोये जीबन रःङने माले, बुरु परमेस्वरलो उरिस नोलाई एकसप्ड्या रानेले।”<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s">येसु सोनो सामरी मेमा</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />युहन्नाये भन्डा येसुये भ्या उसिसरं झैज़्यावरं होसोनो बप्तिस्मा पनि योज़्यावरं वार्ने रोः फरिसीराई याठोयो। <verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />(येसुये ओल माङ्क उसिसराई बप्तिस्मा यायोज़्यावरं।) <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />येसुये आव रोः ठा ओसोनो, होकाम यहुडिया राःडे फरि गालीललं ओवोलो। <verse eid="JHN 4:3" /><verse number="4" style="v" sid="JHN 4:4" />गालीललं नाकं सामरिया प्रडेसलाग्यान नाने टाये।<verse eid="JHN 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 4:5" />होकाम येसु सामरियाला सुखार वार्ने नाङखारलं ओकेरिव। आव नाङखार याकुबये ओज़ा योसेफलाई ओयोव येःङलो ओछ्योकं परिये। <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />नलं याकुबलो उचुन्डा लेव। येसु बाडे ओठाकिवये नो चुन्डालो ओछ्योकं चुङडे उलिज़्याव। नो बेलाकं ठोकै डोपहर टाडे उलिज़्याव।<verse eid="JHN 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7" />टोबो सामरी मेमा नकं रीः गप्ने ओराव। येसुये नोलाई हैओडोव, “ङालाई रीः ओँने गयाङ्के।” <verse eid="JHN 4:7" /><verse number="8" style="v" sid="JHN 4:8" />येसुलो उसिसरं गाउँलं ज़्याने ज़्याव लःङने नाडे यालिज़्याव।<verse eid="JHN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9" />होकाम सामरी मेमाये येसुलाई हैओडोव, “नङ यहुडी टाडे पनि ङा सामरी मेमालो ङाकुइटाम कैजैडे रीः नोओँ?” (यहुडीराई सामरीरासं कडि समन्डज़ मानैरंये।)<verse eid="JHN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10" />येसुये नोलाई हैओडोव, “नङ परमेस्वरलो ओबरडान सोनो नङसं रीः निःने मीलाई नसरेखिन नङ ओल्स निःने नलेव, होकाम नोये नङलाई जीबन याने रीः यायानो हो।”<verse eid="JHN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11" />नो मेमाये येसुलाई हैओडोव, “ए प्रभु नङसं वाप्ने जा माले, होकाम चुन्डालं पनि रीः भ्या मेलं लिज़्या। होकाम नङ काङाम जीबन याने रीः नरै? <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />होकाम नङ गेसाखा याकुब भन्डा घ्योव नलिज़्याव डोरो? होये गेलाई आव चुन्डा झैडे ओयासिव, होकाम ओल सोनो ओसन्तानराई, ओलाला-बालाराई आव चुन्डाला रीः याओँव।”<verse eid="JHN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13" />येसुये नोलाई हैओडोव, “आव रीः ओँनेरं स्यान्टै फरि रीःछोने लेरं <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />बुरु जोये ङा ङायोज़्याव रीः ओँव नो खर्कज़ रीः छोने माले। जो रीः ङा नोलाई ङायो, हो खर्कज़ मासाने जीबनलो मुल टानेले!”<verse eid="JHN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15" />नो मेमाये येसुलाई हैओडोव, “ए प्रभु ङालाई नो रीः याङ, होकाम ङा खर्कज़ रीः छोने ङाम्ले, होसोनो आकं रीः गपरिने टाटाकं।”<verse eid="JHN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16" />येसुये नोलाई हैओडोव, “गनानके, नरेलाई खुल्डे गरैके।”<verse eid="JHN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17" />नो मेमाये हैओवारो, “ङारे माले।”</para>
  <para style="p" vid="JHN 4:17">येसुये नोलाई हैओडोव, “नरे माले वार्डे नङ ठीकंज़ हैनवार्खे, <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" />कडालेकं नङके पाँसगोटा नरेरं टाडे लेरं, होसोनो जो आर्क नङसं लिज़्या, नो नरे माङ्क ची। नङ आव डस्साज़ हैनोवारो।”<verse eid="JHN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19" />नो मेमाये येसुलाई हैओडोव, “ए प्रभु नङ अगमबक्ताज़ टाके। <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />गे सामरी गेसाखाराई आव डान्डाटं परमेस्वरलाई आराढना याडोव, होकाम जे यहुडीराई हैजेवार्ज़्या, आराढना डाने पोके यरुसलेम ची।”<verse eid="JHN 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21" />येसुये नोलाई हैओडोव, “ए मेमा, ङालाई बिस्वास डाङ नो बेला रारिज़्या, बाबुलो ओआराढना न आव डान्डाटं, न यरुसलेमलं टानेले। <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" />जे जो आराढना जेडोज़्या हो जेमसनये। गे जो आराढना गेडाज़्या हो गेसन्ज़्या, कडालेकं छुट्काराके यहुडीरंङाम राये। <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />हैनि पनि बेला राज़्या, नो बेला आर्कज़ ची, पक्का आराढना डानेराई बाबुलाई आत्मालं सोनो सत्यलं आराढना डाने लेरं। कडावार्क एटानाव आराढना डाने मीरंलाईज़ बाबुये खिमोरंये। <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />परमेस्वर आत्माज़, होसोनो परमेस्वरलो ओभक्तराई आत्मा सोनो सत्यलं आराढना डाव परिये।”<verse eid="JHN 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25" />नो मेमाये येसुलाई हैओडोव, “ङा ङासंन, मसिह रा होकाम होयेज़ गेलाई स्यान्टै रोः हैडानेले।”<verse eid="JHN 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26" />येसुये नो मेमालाई हैओडोव, “नङसं पाङज़्याव ङा होज़।”<verse eid="JHN 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27" />हो बेलाकंज़ येसुलो उसिसरं याराव, होकाम येसुलाई टोबो मेमासं रोः ओडोज़्याव रःङडे छक्क यापरिव, हैनि पनि “नङलाई कडि ओचाहिज़्याव? होकाम नङ नो मेमासं कडाने रोः नोडोज़्याव?” वार्डे काङ्कायेज़ मापजैरंये।<verse eid="JHN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28" />होकाम नो मेमाये ओघारि राःडे नाङखारडे ओनाव होकाम मीरंलाई हैओडोवरं, <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />“गराच्योके, टोबो मीलाई रःङच्यो, जोये ङाडोव स्यान्टै येःन ङालाई हैओडाङो। सै नोज़ ख्रीस्ट के माङ्क?” <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />होकाम नोरं नाङखारलाम पुलुडे येसु लेवकं यानाव।<verse eid="JHN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31" />नो बेलाकंज़ उसिसराई येसुलाई ऐवार्डे बिन्ती डोडे यापजोयो, “रब्बी, ज़्याव गोज़्योके।”<verse eid="JHN 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32" />होकाम येसुये नोरंलाई हैओडोवरं, “ङासं ज़्याने ज़्याव लिज़्या, नो जेलाई ठा माले।”<verse eid="JHN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33" />हैजैडे उसिसराई या-याज़ ऐयावारो, “काङ्काये येसुलाई ज़्याव रैडे यायोव सै कडि?”<verse eid="JHN 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34" />येसुये नोरंलाई हैओडोवरं, “ङालाई परिःङनेलो उइछ्या स्यानाव डाने, सोनो होलो ओयेःन पुरा डानेज़ ङा ङाज़्याव ची। <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" />कडा जे हैजेमवार्ये डोरो, ‘अजं चार मैना बाङ्कि लिज़्या, होकाम बालि क्याने बेला रा?’ ङा जेलाई हैङाडाच्यो, जे येःङडे रःङच्यो, बाली मिन्डे क्याने टाडेले। <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" />जोये बालि क्यावये होये ज्याला डोयोये, होकाम खर्कज़ मासिने जीबन डैने लागिटं अन्न डुपोये, होकाम वाने सोनो क्यानेनि बोलोङ रेङनिये। <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" />कडावार्क ‘टोबोये वावये, होकाम छुटंये क्यावये’ वार्ने बचन सत्य टाये। <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" />ङा जेलाई नलं क्याव ङापरिःङच्यो नलं जे डुखं जेडाव माले। उरुराई डुखं डाडेनैरं, होकाम नोराई याडोव डुखंलो ओज्याला जे डैडेजेनै।”<verse eid="JHN 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />“ङा जो ङाडोव येसुये ङालाई स्यान्टै हैओडाङो” वार्ने नो मेमालो ओगोहाइये ओडोव कारनये नो नाङखारला भ्याबिछु सामरीराई येसुलाई बिस्वास याडोव। <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />हैजैडे सामरीरं येसु लेवकं याराव, होकाम नोराई येसुलाई यासं लेने वार्डे बिन्ती याडोव, होकाम येसु नलं नेःला ओलेव।<verse eid="JHN 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 4:41" />होकाम येसुलो ओबचनलो कारनये उरु भ्या मीराई येसुलाई बिस्वास याडोव। <verse eid="JHN 4:41" /><verse number="42" style="v" sid="JHN 4:42" />नो मेमालाई नोराई हैयाडोव, “आबो नङ हैनवारो रोःये गे बिस्वास गेडोव माङ्क बुरु गे गेज़ गेठोयो कारनये डस्साज़ प्रिठीबीलाई जोगैने नोज़ वार्डे गे सन्डे गेनै।”<verse eid="JHN 4:42" /></para>
  <para style="s">कप्तानलो खेपा ओज़ा ओसोमो</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />नेःलाका नलाम पुलुडे येसु गालीललं ओनाव। <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" />येसुये ओल्ज़ गोहाइ ओयोव, अगमबक्ताये ओल ओडेसलं मान माडोयो। <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" />होकाम येसु गालीललं ओराव, येसुये यरुसलेमला पर्ब बेलाकं जो येःन ओडोव हो स्यान्टै येःन यारोःङोये गालीलला मीराई येसुलाई ओमान याडोड्योव, कडालेकं नोरं पनि पर्बटं राव लेवरं।<verse eid="JHN 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46" />होकाम फरि येसु गालीलला काना वार्ने नाङखारलं ओराव, नलं येसुये ङाःडेज़ रीःलाई अङ्गुरलो उरीः ओझोयो। कफर्नहुमलं टोबो घ्योव कप्तान लेव, नोलो खेपा ओज़ा ठलिव लेव। <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />येसु यहुडियालाम गालीललं राडेले वार्ने ठैडे नो येसु लेवकं ओराव, होकाम राडे ङाज़ालाई ससमड्याङ वार्डे येसुलाई बिन्ती ओडोव, कडावार्क नोलो ओज़ा सिने ओपान्ज़्याव। <verse eid="JHN 4:47" /><verse number="48" style="v" sid="JHN 4:48" />येसुये नोलाई हैओडोव, “जे चिन्न सोनो अचम्बला येःनरं जेमरःङया समं ओजमाज़ बिस्वास जेमडा।”<verse eid="JHN 4:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49" />नो घ्योव कप्तानये येसुलाई हैओडोव, “ए प्रभु ङाज़ा सिने भन्डा ङाडेज़ राङन।”<verse eid="JHN 4:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50" />येसुये नोलाई हैओडोव, “गनानके, नज़ा सम्नेले।” येसुये नोलाई हैओडोव बचन नो मीये बिस्वास ओडोव, होकाम ओनाव।<verse eid="JHN 4:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 4:51" />होकाम नो येमकं ओनाज़्याकं नोलो ओनौकरये नोसं डैसिडे नज़ाके यासम्डु वार्डे नोलाई हैओडोव।<verse eid="JHN 4:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 4:52" />खाडंङ बजियालं ओसोमो वार्डे नोलाई ओपजैकं नो नौकरये हैओवारो, “आज्यो लाकं एक बजिकाम नोलाई जोरोये ओराःव।” <verse eid="JHN 4:52" /><verse number="53" style="v" sid="JHN 4:53" />येसुये नोलाई “नज़ा सम्नेले” हैओडोव बेलाकंज़ ओलेवलेव वार्डे कप्तानये ठा ओसोनो। होकाम ओल सोनो उज़ीःमला स्यान्टै ओझानराई बिस्वास याडोव।<verse eid="JHN 4:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54" />यहुडियालाम गालीललं राडे येसुये ओडोव आव डोस्रा चिन्न लेव।<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s">रीःलो कुन्डलं सम्ने</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />होकाम, येसु यहुडीराई यापर्बटं यरुसलेमलं ओनाव। <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />यरुसलेमलं भेडा उमिन लेव झलालो ओछ्योकं टोबो कुन्ड ले, नोलो ओगोराटं पाँस गोटा मैरा लेव, नोलाई हिब्रुङाम बेठस्डा डोरंये। <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />नलं स्यान्टै किसिमला रोगीरं, अन्डलारं, लङ्गरारं, आढा याक्याङ सिवरं गलङडे लेरंये। नोरं रीः खाबलाकं छल्किने हो समय केनरंये। <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />कडावार्क स्यान्टैराई भन्डा घ्योव प्रभुलो टोबो ओकटंवाल बेला-बेलाकं रीःलो कुन्डलं झरिडे रीः हल्लैडेवरंये, होकाम रीः उछल्किव पाना जो ङाडे रीःलं पसि, जोस्याव रोगोये ठलिव मी पनि नो समये। <note caller="+" style="f"><char style="fr" closed="false">५:४ </char><char style="ft" closed="false">कोइ पुरानो सर्सिव कितापयालं आव बचन माले</char></note><verse eid="JHN 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 5:5" />नलं अरतिस बर्सकाम ठलिव टोबो मी लेव। <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />येसुये नोलाई नलं गलङडे उलिज़्याव ओरोःङो नो भ्या समंज़ नेटानाव ठलिवज़ ओलेवलेव वार्ने ठा सन्डे येसुये नोलाई हैओडोव, “नङ सम्ने नुयुङ उलिज़्याव रो?”<verse eid="JHN 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7" />रोगीये येसुलाई हैओडोव, “अँ, प्रभु जो बेला रीः छल्किये ङालाई रीःलो कुन्डलं झाने काङ्का ङामीरं मालेरं, ङा ङानाज़्याकंज़ ङा भन्डा ङाःडे छुटं मी रीःलं नाये।”<verse eid="JHN 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8" />येसुये नोलाई हैओडोव, “च्याङसिडे नटान सोचैडे नान।” <verse eid="JHN 5:8" /><verse number="9" style="v" sid="JHN 5:9" />होपानाज़ नो मी ओसोमो, होकाम ओटान घुर्डे नो मी ओनाव।</para>
  <para style="p" vid="JHN 5:9">नोछ्याम यहुडीरं यानाःसिने डिन लेव। <verse eid="JHN 5:9" /><verse number="10" style="v" sid="JHN 5:10" />हैजैडे नो समो मीलाई यहुडीराई हैयाडोव, “आव के नाःसिने डिन ची, नङलाई टान घुर्ने अडिकार माले।”<verse eid="JHN 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11" />होये नोरंलाई जबाफ ओयोवरं, “जोये ङालाई ओससम्सोङो होयेज़ हैओडाङो, ‘नटान घुर्डे नान।’”<verse eid="JHN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12" />होराई नोलाई यापजोयो, “नङलाई टान घुर्डे बाङन डाने काङ्का?” <verse eid="JHN 5:12" /><verse number="13" style="v" sid="JHN 5:13" />नो समो मीये नो काङ्का वार्डे मासरेवये, कडालेकं नलं बनै भ्या मीरं यालेवये येसु नलाम नाडे खेम्डे उलिज़्याव।<verse eid="JHN 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14" />होकाम येसुये नोलाई प्रार्ठना डोने ज़ीःमलं डैसिडे हैओडोव, “रःङ, नङ सम्डेनले फरि पाप टाडो, होकाम नङलाई अजं भ्या माचाव टाटाकं।” <verse eid="JHN 5:14" /><verse number="15" style="v" sid="JHN 5:15" />ङालाई ससम्नेके येसु ची ओलेवलेव वार्डे नो मीये नाडे यहुडीरंलाई हैओडोवरं।<verse eid="JHN 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 5:16" />आव कारनये यहुडीराई येसुलाई सहतैने सुरु याडोव, कडालेकं येसुये आव येःन यहुडीरं नाःसिने डिन छ्याम ओडोव। <verse eid="JHN 5:16" /><verse number="17" style="v" sid="JHN 5:17" />होकाम येसुये नोरंलाई हैओडोवरं, “ङा ङाबाबुये आर्क समं येःन डोज़्याव, ङा पनि येःन ङाडोज़्या।”<verse eid="JHN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 5:18" />हैजैडे यहुडीराई येसुलाई सैःने कोसिस याडोव, कडावार्क येसुये यहुडीरं नाःसिने डिन लो ओन्याम ओममानिवयाज़ माङ्क, बुरु ओल परमेस्वरसं बराबर झैसिडे परमेस्वरलाई ङाबाबु ओवारो।<verse eid="JHN 5:18" /></para>
  <para style="s">ओज़ालो ओअडिकार</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />येसुये नोरंलाई हैओडोवरं, “सत्य रोः ङा जेलाई हैङाडाच्यो, ओज़ाये ओबाठङ कडि पनि माडोडुव, बुरु बाबुये जो ओडोज़्याव रोःङो हो मान्त्राज़ डोवये, कडालेकं बाबुये जो डोवये ओज़ाये होज़ डोवये। <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />कडालेकं ओबाबुये ओज़ालाई मया डोवये, होसोनो ओबाबुये ओल्ज़ ओडोज़्याव स्यान्टै येःन ओज़ालाई सटन्ड्योवये। आव भन्डा घ्योव येःन ओबाबुये ओज़ालाई डोव परिःङनेले, होकाम जे अचम्ब टानेजेले। <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />कडालेकं बाबुये जो झैडे सिवरंलाई सिवलाम ज्युङडा झैडे ओसोचोयोरं होकाम नोरंलाई जीबन योवरंये, हैजैडेज़ ओज़ाये पनि जोलाई इछ्या डोव, होलाई जीबन योवये। <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />कडालेकं बाबुये काङ्कालो उनियाज़ माडोवये, हैनि पनि स्यान्टै निया डाने येःन ओज़ालाई याडेनोयो, <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />कडालेकं स्यान्टैये ओज़ालाई ओमानिरंकं, जो झैडे नोराई बाबुलाई मानिरंये। ओज़ालाई मामानिनेराई ओल्लाई परिःङने ओबाबुलाई पनि मामानिरंये।”<verse eid="JHN 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24" />“सत्य रोः ङा जेलाई हैङाडाच्यो, जोये ङाबचन ठोयोये होसोनो ङालाई परिःङनेलाई बिस्वास डोव, नोसं खर्कज़ मासिने जीबन ले, बुरु नो सिनेङाम जीबनलं पसिडेले। <verse eid="JHN 5:24" /><verse number="25" style="v" sid="JHN 5:25" />सत्य रोः ङा जेलाई हैङाडाच्यो, नो समय रारिज़्या, नो समय आर्कज़, होकाम सिवराई परमेस्वरलो ओज़ालो ओगा ठैनेलेरं, नो ठैनेरं बान्चिने लेरं। <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />कडालेकं बाबुसंज़ जीबन ओलेव, होमान्टि ओज़ालाई पनि ओल्सज़ जीबनलो उरुप टाने अडिकार याडेनोयो। <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />होकाम नोलाई निया डाने अडिकार याडेनोयो, कडालेकं नो मानवालो ओज़ा ची।” <verse eid="JHN 5:27" /><verse number="28" style="v" sid="JHN 5:28" />“आवटं अचम्ब टामानिच्यो, कडालेकं समय राज़्या, खाडरला लिज़्यावरं स्यान्टैये नोलो ओगा ठैनेलेरं, <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" />होकाम चाव येःन डानेरं जीबनलो लागिटं सिवलाम ज्युङडा टानेलेरं, होसोनो माचाव येःन डानेरं डन्ड डैनेलो लागिटं सिवलाम ज्युङडा टानेलेरं।”<verse eid="JHN 5:29" /></para>
  <para style="s">येसुलो ओसाची</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 5:30" />“ङा ङाज़ कडिज़ ङामडोडु। जोस्याव ङाठै, होस्यावज़ निया ङाडोये, होकाम ङानिया ठीकंज़ ठहरिये, कडालेकं ङा ङाइछ्या माङ्क, बुरु ङालाई परिःङनेलो उइछ्या ङामानिये।”<verse eid="JHN 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31" />होकाम ङा ङाबारेलं गोहाइ ङायोखे भने ङागोहाइ सत्य माटाये। <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />ङाबारेलं गोहाइ याने छुटं लिज़्या, ङा ङासंन, ङाबारेलं होये जो गोहाइ योवये, नो गोहाइ सत्य ठहरिये। <verse eid="JHN 5:32" /><verse number="33" style="v" sid="JHN 5:33" />“जे युहन्ना लेवकं मीरंलाई पजोयो जिपरिःङोरं, होकाम होये सत्यलो गोहाइ याडेनोयो। <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />ङालाई काङ्का पनि मीलो ओसाची माचाहिये, बुरु जे छुट्कारा डोयोजिढुकं वार्डे ङा आव रोः हैङावार्ज़्या। <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />युहन्ना चाङने सोनो चम्किने टुकि लेव, होकाम जे नोलो उउज्यालोटं टिगिडा टानि पनि जेरेङो।”<verse eid="JHN 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 5:36" />“होकाम ङासं जो गोहाइ लिज़्या, नो युहन्नालो भन्डा घ्योव ले। कडावार्क जो येःनरं पुरा डाने बाबुये ङालाई याडेनैसोङो, नो येःन ङा ङाडोज़्या, होकाम नोराईज़ बाबुये ङालाई उपरिःङसोङो वार्डे ङाबारेलं गोहाइ योज़्यारं। <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" />ङालाई परिःङने ङाबाबुयेज़ ङाबारेलं गोहाइ याडेनोयो। नोलो ओगा जे खर्कज़ जेठोयो माले, होसोनो नोलो उरुप खर्कज़ जेरोःङो माले। <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />नोलो ओबचन जेलेवकं मारहिये, कडालेकं जोलाई नोये उपरिःङो, नोलाई जे बिस्वास जेमडाये। <verse eid="JHN 5:38" /><verse number="39" style="v" sid="JHN 5:39" />जे सास्त्रटं जिखिमये, कडालेकं नटं खर्कज़ मासिने जीबन डैसि वार्डे हैजेवार्ये। ङा ङाबारेलं गोहाइ याने नो सास्त्रज़, <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />हो टानि पनि जे जीबन डैने ङालेवकं जेमराये।”<verse eid="JHN 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41" />“ङा मीराई याडोव महिमा ग्रहन ङामडो, <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />बुरु परमेस्वरलो ओमया जे जियुङलं माले वार्डे ङा ङासंन। <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />ङा ङाबाबुलो उमिन्ट ङाराव ची, हैनि पनि जे ङालाई ग्रहन जेमडाङये। छुटं कोइ ओल उमिनसंज़ याराखे भने होलाई ग्रहन डानेजेले। <verse eid="JHN 5:43" /><verse number="44" style="v" sid="JHN 5:44" />जे कैजैडे बिस्वास जेडाडु, होकाम जे-जेज़ जेमान जिखिमसिये, होकाम नो महिमालाई जे वोल्डे पनि जेमरःङये, जो टोबोज़ाज़ परमेस्वर लेवङाम राये?” <verse eid="JHN 5:44" /><verse number="45" style="v" sid="JHN 5:45" />“आव टासमझिच्यो, कि ङा बाबुलो ओङाःकं जेलाई डोस लैनेङाले। जेलाई डोस लैनेके मोसा लिज़्या, नोसं जे आस डाडे जेनै। <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />कडालेकं जे मोसालाई बिस्वास जेडाखिन्के ङालाई पनि बिस्वास जेडाङखेहो, कडालेकं मोसाये ङाबारेलं सर्डेनोयो। <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />हैनि पनि जे होये ओसोरो रोःरं बिस्वास जेमडाखे भने, ङारोःटं कैजैडे बिस्वास जेडा?”<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s">येसुये पाँस हजारलाई ओसयावरं</para>
  <para style="r">
    <ref loc="MAT 14:13-21">मत्ती १४:१३-२१</ref>; <ref loc="MRK 6:30-44">मर्कुस ६:३०-४४</ref>; <ref loc="LUK 9:10-17">लुका ९:१०-१७</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />येसुये आवरोः ओपाङो झिन्डे गालील, याडोज़्याव तिबेरियास समन्डर होपंटं ओनाव। <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />होकाम बनै भ्या मीराई टोबो यासमुह येसुलो उझिन्ट ओनाव, कडालेकं येसुये रोगीरंलाई ओससोमो चिन्नरं नोराई रःङडे यानैज़्याव। <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />येसु डान्डाटं ओनाव, होकाम उसिसरासं हो डान्डाटंज़ ओलेव। <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />यहुडीराई यापर्ब, निस्तार पर्ब नजिककंज़ राडे उलिज़्याव। <verse eid="JHN 6:4" /><verse number="5" style="v" sid="JHN 6:5" />होकाम येसुये आडेहोडे ओरःङकं टोबो बनै घ्योव मीराई यासमुह ओल्लेवडे ओराज़्याव रःङडे फिलिपलाई हैओडोव, “आवरंलाई ज़्याव यानेरं लागिटं गे काङाम बरे लःङने?” <verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />येसुये फिलिपलाई जान्चीनेलो लागिटं आव रोः हैओडोव, कडालेकं येसुये जो येःन ओडोरिज़्याव, हो येसुलाई ठा लेव।<verse eid="JHN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7" />फिलिपये येसुलाई जबाफ ओयोव, “स्यान्टैरंलाई टिगिडा-टिगिडा याडैनि पनि नेसै चान्डीलो पैसालो बरेये पनि नोरंलाई डुम्ने माले।”<verse eid="JHN 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8" />येसुलो उसिसरं मड्यलाम टोबो, सिमोन पत्रुसलो ओभाइ अन्ड्रियासये हैओवारो, <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />“आकं टोबो छोऱ्या लिज़्या, नोसं चिकालो पाँस गोटा बरे सोनो नेबऱ्याङ ङाः लिज़्या। होकाम आढङ भ्याराई यालागिटं आडियाँ याज़ कडि डुमकेड?”<verse eid="JHN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10" />येसुये हैओवारो, “मीरंलाई चुङो गपंरिःङच्योरं के।” नो बाङलं बनै भ्या छि लेव। होकाम ठोकै पाँस हजारया खेपारं नलं याचुङो। <verse eid="JHN 6:10" /><verse number="11" style="v" sid="JHN 6:11" />होकाम येसुये बरे रैडे, परमेस्वरलाई ढन्याबाड ओयोव झिन्डे चुङोरंलाई भाडे ओयोवरं, होकाम हैजैडेज़ ङाः पनि भाडे ओयोवरं। नोराई याज़्योडुने भरिज़ याज़्योव। <verse eid="JHN 6:11" /><verse number="12" style="v" sid="JHN 6:12" />होकाम नोरं ज़्याडे यावाःङो, येसुये उसिसरंलाई हैओडोवरं, “येःलो कुत्रारं गुडुपच्योके, नो खेर टानाकं।” <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />ज़्यानेराई यासयःलो चिकालो नो पाँस गोटा बरेलो उकुत्रा नोराई याडुपो होकाम बारं फुङ्गा ओब्यालो।<verse eid="JHN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14" />आव कारनये येसुये ओडोव आव चिन्न रःङडे नो मीराई हैयावारो, “प्रिठीबीलं राने अगमबक्ता डस्साज़ येसुज़ ओलेव लेव।” <verse eid="JHN 6:14" /><verse number="15" style="v" sid="JHN 6:15" />नोराई राडे येसुलाई जबरजस्ति लाङडे राजा झैने पान्ज़्यार वार्ने रोः ठा सन्डे येसु फरि ओबाठङ डान्डाटं ओनाव।<verse eid="JHN 6:15" /></para>
  <para style="s">येसु रीः तर्ट ओबाव</para>
  <para style="r">
    <ref loc="MAT 14:21-23">मत्ती १४:२१-२३</ref>; <ref loc="MRK 6:45-52">मर्कुस ६:४५-५२</ref></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />रिःम्डे ओटाव पाना येसुलो उसिसरं डहडे यानाव। <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />होकाम डोङ्गाटं पुलुडे नोरं समन्डर होपंटं कफर्नहुमडे यानाव। नो बेलाकं अन्ड्यारो टाडे उलिज़्याव, नो बेला समं येसु नोराई लेवकं ओमकेरिटाव। <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />होकाम घ्योव बतास उचलिवये, डहला रीःलो ओछल्का छल्किने ओपान्ज़्याव। <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />पाँस छ किलो मिटर डोङ्गा चलैडे यानाव झिन्डे नोराई येसुलाई डहला रीःतर्ट बाडे डोङ्गालो ओछ्योकं ओकेरिव यारोःङो, होकाम नोरं याछेव। <verse eid="JHN 6:19" /><verse number="20" style="v" sid="JHN 6:20" />होकाम येसुये नोरंलाई हैओडोवरं, “ङा ची, टाछेच्यो।” <verse eid="JHN 6:20" /><verse number="21" style="v" sid="JHN 6:21" />नोरं खुसि टाडे येसुलाई डोङ्गाटं यासुचुनो, होकाम नोरं यानाज़्याव पोडे डोङ्गा होपान्त्राज़ ओकेरिव।<verse eid="JHN 6:21" /></para>
  <para style="s">मीराई येसुलाई याखिमो</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />समन्डर होपटा रहिव बनै भ्या मीराई ओपराटि नकं टोबोज़ाज़ डोङ्गा यारोःङो। नोरंलाई ठा लेव, येसु उसिसरासं डोङ्गाटं ओमनाव, बुरु येसुलो उसिसरंमान्त्रायाज़ यानाव। <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />होकाम प्रभुये ढन्याबाड याडे बरे ज़्योव ओयोवरं पोकं तिबेरियास ङाम उरु डोङ्गारं याकेराव। <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />येसु सोनो उसिसरं नलं यामलेव ठा सन्डे नो मीराई येसुलाई खिम्ने डोङ्गाटं पुलुडे कफर्नहुमडे यानाव।<verse eid="JHN 6:24" /></para>
  <para style="s">येसु जीबन याने बरे</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25" />नोराई येसुलाई डह होपंटं डैडे नोलाई यापजोयो, “रब्बी, नङ आकं खर्क नराव?”<verse eid="JHN 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26" />येसुये नोरंलाई जबाफ याडे हैओडोवरं, “सत्य रोः ङा, जेलाई हैङाडाच्यो, जे चिन्नरं रःङडे, माङ्क बुरु जिफु टस्सि बरे जेज़्यावये ङालाई जिखिमसङज़्याव ची। <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />नास टाने ज़्यावलो लागिटं डुखं टाडाच्यो, बुरु खर्कज़ मासिने जीबन समं रहिने ज़्यावलो लागिटं डुखं डाच्यो, नो ज़्याव मानवालो ओज़ाये जेलाई याने ले। कडालेकं परमेस्वर बाबुये नोलो ओक्याङटं ओछाप लैडेनैड्योव।”<verse eid="JHN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28" />नोराई येसुलाई हैयाडोव, “परमेस्वरलो उयुङ्का येःन डानेलो लागिटं गे कडि डाव परिये?”<verse eid="JHN 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29" />येसुये नोरंलाई हैओडोवरं, “परमेस्वरलो ओयेःन आवज़ जोलाई होये उपरिःङो होलाई बिस्वास डाच्यो।”<verse eid="JHN 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30" />आव कारनये नोराई येसुलाई हैयाडोव, “नङ कडि चिन्न नसंटन, हो गेरःङ, होकाम नङलाई बिस्वास गेडान? खै नङ कडि येःन नोडो? <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />गे गिज्यु-ज्यु बाज्युराई मरुभुमिलं मन्न याज़्योव, एटाव सर्सिवले, ‘परमेस्वरये नोरंलाई ज़्यानेलो लागिटं स्वर्गटाम बरे ओयोवरं।’”<verse eid="JHN 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32" />येसुये नोरंलाई हैओडोवरं, “सत्य रोः, ङा जेलाई हैङाडाच्यो, जेलाई स्वर्गटाम बरे याने मोसा माङ्क, बुरु स्वर्गटाम जेलाई सड्डेका बरे याने ङाबाबु ची। <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />कडालेकं परमेस्वरलो ओबरे नोज़, जो स्वर्गटाम झरिडे राये, होकाम प्रिठीबीलाई जीबन योवये।”<verse eid="JHN 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34" />नोराई येसुलाई हैयाडोव, “प्रभु, आव बरे गेलाई एकसप्ड्याज़ यासि।”<verse eid="JHN 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35" />येसुये नोरंलाई हैओडोवरं, “जीबन याने बरे ङाज़। ङा लेवकं राने करेने माले, होसोनो ङालाई बिस्वास डाने खर्कज़ रीः छोने माले। <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" />बुरु ङा जेलाई हैडाडेङानैच्यो, जे ङालाई रःङडे पनि बिस्वास जेमडाङये। <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />बाबुये ङालाई ओयाङोरं भरि स्यान्टै ङा लेवकं रानेलेरं, होकाम ङा लेवकं रानेरंलाई ङा ओजमाज़ राःने ङामलेरं। <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />ङा स्वर्गटाम झरिडे ङाइछ्या पुरा झैने ङाराव माङ्क, बुरु ङालाई परिःङनेलो उइछ्या पुरा झैने ङाराव ची। <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />होसोनो ङालाई परिःङनेलो उइछ्या आवज़, नोये ङालाई ओयाङो भरिरंलाई काङ्कालाई पनि ङा गोमैने टाटाकं, बुरु नोरंलाई आखिरला डिनलं ज्युङडा झोयो ङाढुकं। <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />कडालेकं ङाबाबुलो उइछ्या आवज़, ओज़ालाई रःङने सोनो नोलाई बिस्वास डाने स्यान्टैये खर्कज़ मासिने जीबन ओडैरंकं, होकाम ङा नोलाई आखिरला डिनलं ज्युङडा झैनेङाले।”<verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />यहुडीरं येसुलो उबिरोडलं गनगन यालेव, कडालेकं येसुये हैओवारो, “स्वर्गटाम झरिडे राव बरे ङाज़।” <verse eid="JHN 6:41" /><verse number="42" style="v" sid="JHN 6:42" />नोराई हैयावारो, “आव योसेफलो ओज़ा येसु माङ्क? आवलो ओबाबु सोनो वामालाई गे गेमसरेये डोरो? आर्क आवये कैजैडे ‘स्वर्गटाम झरिडे ङाराव ची वार्डे हैओवार्ज़्याव?’”<verse eid="JHN 6:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43" />येसुये नोरंलाई हैओडोवरं, “जे-जेज़ गनगन टालेच्यो। <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />ङालाई परिःङने बाबुये ङालेवङं राने युङ मायोवरंखे भने काङ्का पनि ङा लेवकं माराडु, होकाम ङा लेवङ रानेरंलाई आखिरला डिनलं ज्युङडा झैनेरं ङाले। <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />‘होकाम नो स्यान्टैरं परमेस्वरसं पैसिने लेरं वार्डे अगमबक्ताराई यापोस्टोकोटं सर्सिवले।’ जो बाबुलो उसिछ्या ठैडे पैसिये नो ङा लेवकं राःये। <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" />बाबुलाई काङ्काये पनि ओरोःङो माले, जो परमेस्वरङाम रावले, होये मान्त्रा बाबुलाई ओरोःङोले। <verse eid="JHN 6:46" /><verse number="47" style="v" sid="JHN 6:47" />जेलाई ङा सत्य रोः हैङाडाच्यो, जोये बिस्वास डोवये नोसं खर्कज़ मासिने जीबन ले। <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />जीबन याने बरे ङाज़। <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />जेसाखा पुर्खाराई मरुभुमिलं मन्न याज़्योरं, होटानि पनि नोरं सिडे यानारं। <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />स्वर्गटाम झरिडे राने बरे आवज़, जोये आव ज़्योव हो सिने माले। <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />स्वर्गटाम झरिडे राःव ज्युङडा बरे ङाज़। कोइये आव बरे याज़्योव भने नो खर्कज़ सिने माले। होकाम ङा प्रिठीबीलाई याने ङावार्ज़्याव बरे, ङाक्याङज़, ऐझैडे प्रिठीबीये जीबन गोडोयोकं वार्डे ङा ङाक्याङ यानेङाले।”<verse eid="JHN 6:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52" />होकाम यहुडीरं या-याज़ छलफल याडोव, “आव मीये कैजैडे ओक्याङ गेलाई ज़्याव यासिढुव?”<verse eid="JHN 6:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53" />येसुये नोरंलाई हैओडोवरं, “डस्साज़ ङा जेलाई हैङाडाच्यो, जे मानवालो ओज़ालो ओक्याङ जेमज़्याखे भने होसोनो नोलो ओक्याङटा झी जेमओँखे भने, जे खर्कज़ मासिने जीबन डैने जेमले। <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" />ङाक्याङ ज़्योने सोनो ङाक्याङटा झी ओँनेसं खर्कज़ मासिने जीबन ले, होकाम ङा नोलाई आखिरला डिनलं ज्युङडा झैनेङाले। <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />कडालेकं ङाक्याङ डस्साज़ ज़्याने ज़्याव ज़, होसोनो ङाक्याङटा झी डस्साज़ ओँने बस्तज़। <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />ङाक्याङ ज़्याने, सोनो ङाक्याङटा झी ओँने ङासं<note caller="+" style="f"><char style="fr" closed="false">६:५६ </char><char style="ft" closed="false">ङान्यामलं रहिने</char></note> टानेले, होकाम ङा नोसं टानेङाले। <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />जोझैडे बाबुये ङालाई उपरिःङसोङो, होकाम ङाबाबुये ओडोव कारनये ङा ङाबान्चि, हैजैडेज़ ङालाई ज़्याने पनि ङा ङाकारनये बान्चिनेले। <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />स्वर्गटाम राव बरे नेटाव माङ्कची, नो गेसाखा पुर्खाराई याज़्योनि पनि सिडे यानारं। आव बरे ज़्याने मी एकसप्ड्या बान्चिनेले।”<verse eid="JHN 6:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 6:59" />येसुये आव रोः कफर्नहुमला यहुडीरं डुप्सिने ज़ीःमलं सिछ्या ओयोरंकं हैओडोवरं ची।<verse eid="JHN 6:59" /></para>
  <para style="s">खाबलाकं माखेम्ने जीबनला बचन</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />आव रोः ठैडे येसुलो उसिसरंकाम भ्याये हैयावारो, “आव बचनके बनै कर्रा ची लिज़्या, काङ्काये आव बचन ठैडुव ड?”<verse eid="JHN 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61" />होकाम येसुलो उसिसरं आव बारेलं गन-गन वार्ज़्यारं वार्ने सन्डे येसुये नोरंलाई हैओडोवरं, “होकाम आवरोः जेलागिटं बनै कर्रा ओटाज़्याव रो? <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />जे मानवालो ओज़ालाई ङाःडे जोङ लेव होङ उपुलुज़्याव जेरःङखे भने कै नि? <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />जीबन यानेके आत्मा ची, क्याङलो सक्तिके कडिज़ माङ्कची। जो बचन ङा जेसं ङापाङो, नो जीबन सोनो आत्मा ज़। <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />बुरु जेमड्यलाम कोइ-कोइरं लिज़्यारं, जोराई ङालाई बिस्वास माडाङरंये।” कडालेकं बिस्वास माडोनेरं काङ्का-काङ्कारं, होसोनो येसुलाई ढोका याने काङ्का टानेले वार्ने येसुलाई ङाडेङामज़ ठा लेव। <verse eid="JHN 6:64" /><verse number="65" style="v" sid="JHN 6:65" />होकाम येसुये हैओडोवरं, “ऐझैडेज़ ङा जेलाई हैङाडाच्योव ची, ‘होकाम बाबु लेवङाम मायासिव यालेखे भने काङ्का मी पनि ङा लेवकं माराडु।’”<verse eid="JHN 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66" />आव रोः याठोयो झिन्डे येसुलो उसिसरंकाम भ्यारं यावोलो, होकाम येसुसं बोलोङ बाने याराःव। <verse eid="JHN 6:66" /><verse number="67" style="v" sid="JHN 6:67" />येसुये बारं जनारंलाई हैओडोवरं, “कडा जे पनि ङालाई राःडे जेना रो?”<verse eid="JHN 6:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68" />सिमोन पत्रुसये जबाफ ओयोव, “ए प्रभु गे काङ्का लेवकं नाने? नङसंके खर्कज़ मासिने जीबनलो बचन लिज़्या <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />नो गे बिस्वास डाडेगेनै, होसोनो सन्डेगेनै, नङ परमेस्वरलो चोखो मीज़।”<verse eid="JHN 6:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70" />येसुये नोरंलाई जबाफ ओयोवरं, “कडा ङाज़ जे बारं जनारंलाई ङारुजिच्योव माङ्क डोरो? होसोनो जे काम टोबोके सैतान ची।” <verse eid="JHN 6:70" /><verse number="71" style="v" sid="JHN 6:71" />आव रोः येसुये सिमोन इस्करियोतलो ओज़ा यहुडालो ओबारेलं हैओवारो, कडालेकं बारं जनारंलाम टोबो टाडे पनि नोये येसुलाई ढोका याने ओपान्ज़्याव।<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s">येसु सोनो ओभाइरं</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />होकाम येसु गालीलयालंज़ उडुलिव, येसुये यहुडियाडे नाने युङ माडोवये, कडालेकं यहुडीराई येसुलाई सैःने यापान्ज़्याव। <verse eid="JHN 7:1" /><verse number="2" style="v" sid="JHN 7:2" />नो बेलाकं यहुडीराई छाप्रा झैडे यामानिने यापर्ब नजिकज़ ओराज़्याव। <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />हैजैडे येसुलो ओभाइराई येसुलाई हैयाडोव, “आव पो राःडे यहुडिया गनानके, होकाम नङ नोडोज़्याव येःनरं नसिसराई पनि गरःङरंकं। <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />जो मीये मिन कमैने युङ डोव, होये गुप्तलं येःन माडोव। नङ आव येःनरं नोडोज़्या नङ प्रिठीबीलाई सटन।” <verse eid="JHN 7:4" /><verse number="5" style="v" sid="JHN 7:5" />कडालेकं येसुलो ओभाइरं पनि येसुलाई बिस्वास यामडोज़्याव।<verse eid="JHN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6" />येसुये नोरंलाई हैओडोवरं, “ङा अजं समं ठीकं ङाबेला माराटा, बुरु जेलागिटं के स्यान्टै बेलाज़ ठीकंज़ लिज़्या। <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />प्रिठीबीये जेलाई हेला माडाच्योवये, बुरु ङालाई के हेला डाङो, कडावार्क प्रिठीबीये ओडोव येःन माचाव लिज़्या वार्डे ओबारेलं हैङावार्ज़्या। <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />जे आव पर्बलं गनाच्योके। ङा आव पर्बलं ङाम्ना, कडालेकं ङा ङाबेला अजं पुरा माटाटा।” <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />नोरंलाई ऐडारंडे येसु गालीललंज़ ओलेव।<verse eid="JHN 7:9" /></para>
  <para style="s">येसु छाप्रा बासला पर्बलं</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />येसुलो ओभाइरं पर्बलं यानाव येसु पनि सतन्सिडे माङ्क, मोःसिडे ओनाव। <verse eid="JHN 7:10" /><verse number="11" style="v" sid="JHN 7:11" />पर्बलं यहुडी अगंवाराई येसुलाई याखिमज़्याव, होसोनो “येसु काङ लिज़्या?” वार्डे यापजैज़्याव।<verse eid="JHN 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12" />मीराई याखार्ल येसुलो ओबारेलं छलफल ओटारिव। कोइये हैयावार्ज़्याव, “नो चाव मीज़।” उरुराई हैयावार्ज़्याव, “माङ्क, आव मीये मीरंलाई अलंमलं झैज़्यावरं।” <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />हैनि पनि यहुडी अगंवाराई याछ्यासैये येसुलो ओबारेलं काङ्का पनि खुल्लालं याम्पाङज़्याव।<verse eid="JHN 7:13" /></para>
  <para style="s">पर्बटं येसुलो उसिछ्या</para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />पर्ब खार्ल येसु प्रार्ठना डोने ज़ीःमलं उपसिव, होकाम सिछ्या ओयोवरं। <verse eid="JHN 7:14" /><verse number="15" style="v" sid="JHN 7:15" />यहुडी अगंवारं अचम्ब टाडे ऐयावारो, “कडिज़ मापरिःडे आवये कैजैडे आडङ बिड्या ओपैसिव?”<verse eid="JHN 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16" />होकाम येसुये नोरंलाई ऐवार्डे जबाफ ओयोवरं, “ङा ङासिछ्या ङामीज़ माङ्क, नोलो ची, जोये ङालाई उपरिःङसोङो। <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />कोइ मीये परमेस्वरलो उइछ्या मानिने युङ याडोवखे भने, ङासिछ्या परमेस्वरङाम सै ङा ङाज़ ङापाङो नो हो मीये सन्नेले। <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />जोये ओल उयुङङाम पाङये, होये ओल ओमहिमा खिमोये, बुरु जोये ओललाई परिःङनेलो ओमहिमा खिमो, हो सत्य मीज़, होसोनो नोसं छल कपट माटाये। <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" />कडा मोसाये जेलाई न्याम ओयाच्योव माङ्क डोरो? हैटानि पनि जे काङ्काये पनि नो न्याम जेममानिये। जे कडाने ङालाई सैःने जेपानसङज़्याव?”<verse eid="JHN 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20" />माहुले मीराई जबाफ यायोव, “नङलाई ज़्याः लागिडेले। काङ्काये नङलाई सैःने ओपान्सन्ज़्याव?”<verse eid="JHN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21" />येसुये नोरंलाई जबाफ यारंडे हैओडोवरं, “ङा टोबो अचम्बला येःन ङाडोव, होकाम जे स्यान्टै आव रोःटं छक्क जिपरिज़्या। <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />मोसाये जेलाई खतनालो न्याम याडे नैचेव (हो के, नो मोसाङाम के माङ्क, बुरु साखा पुर्खाङाम ची), होटानि पनि जे नाःसिने डिन छ्याम पनि जे मीरंलाई खतना जेजैरंये। <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" />मोसालो ओन्याम भङ्ग टाटाकं वार्डे कोइ मीये नाःसिने डिनछ्याम खतना याडोवखे भने, ङा टोबो मीलाई यहुडीरं यानाःसिने डिनछ्याम पुरा ङाससोमो वार्डे जे ङासं रिस जेडोज़्याव? <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />मी रःङडे माङ्क बुरु चावसं निया डोच्यो।”<verse eid="JHN 7:24" /></para>
  <para style="s">होकाम नो ख्रीस्ट रो</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />यरुसलेमला कोइ-कोइ मीराई हैयावारो, “होकाम आव नो मी माङ्कडोरो, जोलाई यहुडी अगंवाराई सैःने यापान्ज़्याव? <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />रङःच्योखेने आव के स्यान्टै मीराई याङाःकंज़ ची पाङज़्या, हैनि पनि नोराई आवलाई कैज़ माडोरंये! सै आवज़ ख्रीस्ट वार्डे यहुडी सेःरराई डस्साज़ ठा यासोनो? <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />बुरु गेलाई ठा ले, आव मी काङाम ओराव। डस्साका ख्रीस्ट ओराव बेलाकं, नो काङाम ओराव वार्डे काङ्कायेज़ ठा सन्नेमाले।”<verse eid="JHN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28" />होकाम येसुये प्रार्ठना डोने ज़ीःमलं ओपैज़्यारंकं, कस्सिडे किःडे हैओडोवरं, “होकाम जे ङालाई डस्साज़ जेसरेःसङ? होसोनो ङा काङाम ङाराव नो पनि जेसन? ङा ङाइछ्याये ङाराव माङ्क ची, बुरु जोये ङालाई उपरिःङसोङो नो सत्यले। जे नोलाई जेमसरेये, <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />बुरु ङा नोलाई ङासरेये, कडालेकं ङा नो लेवङामज़ ङाराव ची, होसोनो नोये ङालाई उपरिःङसोङो ची।”<verse eid="JHN 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30" />हैजैडे नोराई येसुलाई क्योःने यापानो, हैनि पनि काङ्कायेज़ माक्योडुरंये, कडालेकं येसुलो ओबेला अजं ओमराटाव। <verse eid="JHN 7:30" /><verse number="31" style="v" sid="JHN 7:31" />हैनि पनि नला लिज़्याव माहुले मीरंकाम भ्या मीराई येसुलाई बिस्वास याडोव। नोराई हैयावारो, “जो बेलाकं ख्रीस्ट रा, होकं आवये ओडोव भन्डा भ्या चिन्नरं होये डोवके डोरो?”<verse eid="JHN 7:31" /></para>
  <para style="s">येसुलाई क्योःने वार्डे सिफाइँरंलाई यापरिःङोरं</para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />माहुले मीराई येसुलो ओरोः याडोज़्याव फरिसीराई याठोयो। होकाम मुख्या सेवा डोने मीराई सोनो फरिसीराई येसुलाई क्योःने मन्डिरला पालेरंलाई यापरिःङोरं। <verse eid="JHN 7:32" /><verse number="33" style="v" sid="JHN 7:33" />येसुये हैओडोवरं, “अजं जामा समं ङा जेसंज़ ङाले, होकाम ङा ङालाई परिःङने लेवङ नानेङाले। <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />जे ङालाई खिम्नेजेले, हैनि पनि ङालाई डैने जेमले, होसोनो जोङ ङा ङाले होङ जे जेमराडु।”<verse eid="JHN 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35" />होकाम यहुडीराई या-याज़ हैयावारो, “आव कान्डे नाने ओपान्ज़्याव, होकाम गे आवलाई माडैनेगेले? सै आवये ग्रीकराई याखार्ल चित्राङ पुत्राङ टाडे लिज़्याव यहुडीरं लेवकं नाडे ग्रीकरंलाई पैनेरं ओपान्ज़्याव? <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />आवये हैओवार्ज़्याव रोःलो ओमाने कडि? ‘जे ङालाई खिम्ने जेले, हैटानि पनि ङालाई डैने जेमले, होसोनो जोङ ङा ङाले, जे जेमराडु?’”<verse eid="JHN 7:36" /></para>
  <para style="s">जीबनला भैये ओयोने रीः</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />नो पर्ब ओखेमरिव बेलाकं, पर्बलो मुख्या डिनछ्याम, येसु च्याङसिडे कस्सिडे किःडे ऐओवारो, “कोइ मी रीः याछो भने ङा लेवकं राडे रीः ओओँवकं। <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />जोये ङालाई बिस्वास डाङो, सास्त्रये हैओवारो स्यानाव ‘नोलो उयुङलाम जीबन याने भैरं बगिडे पुलुने लेरं।’” <verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />आव रोः येसुये चोखो आत्मालो ओबारेलं हैओवारो, नो चोखो आत्मा येसुलाई बिस्वास डानेराई डैने लेव। कडालेकं आर्क समं चोखो आत्मा यासिव मालेव, कडालेकं येसुलो ओमहिमा ओमटाटाव।<verse eid="JHN 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />आव रोः ठैने कोइ-कोइ मीये हैयावारो, “आव के डस्साज़ अगमबक्ताज़ ओलेवलेव।”<verse eid="JHN 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41" />उरुराई हैयावारो, “आव के ख्रीस्ट ची।”</para>
  <para style="p" vid="JHN 7:41">होकाम कोइ-कोइराई हैयावारो, “कडा ख्रीस्ट गालीललाम राने माङ्क डोरो? <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />ख्रीस्ट के डाउडलो ओसन्तानलाम सोनो डाउडलो ओनाङखार बेठलेहेमलाम रा वार्डे सास्त्रटं सर्सिव माले डोरो?” <verse eid="JHN 7:42" /><verse number="43" style="v" sid="JHN 7:43" />येसुलो ओकारनये ऐजैडे मीराई याखार्ल फाटो ओटाव। <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />नोरंकाम कोइ-कोइराई येसुलाई क्योःने यापानो, हैनि पनि काङ्काये पनि येसुलाई माक्योडुरंये।<verse eid="JHN 7:44" /></para>
  <para style="s">यहुडी अगंवाराई बिस्वास यामडोव</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />होकाम मन्डिरला पालेरं सोनो मुख्या सेवा डोने मीरं फरिसीरं लेवकं याराव। नोराई आवरंलाई हैयाडोवरं “जे नोलाई कडा जेमरै?”<verse eid="JHN 7:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46" />पालेराई जबाफ यायोवरं, “आव मीये स्यावके खर्कज़ काङ्का मीये पनि मापाङये!”<verse eid="JHN 7:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47" />फरिसीराई नोरंलाई हैयाडोवरं, “जेलाई पनि मुर्ख ओझैच्योव सै कडि? <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />कडा गेसेःररं सोनो फरिसीरं कोइराई नोलाई बिस्वास डाडेयानैज़्याव डोरो? <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />आव माहुले मीरं जोराई न्याम मासनरं, हैटानि पनि नोरं सराप लागिवरं ची।”<verse eid="JHN 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50" />नोरंकाम टोबो निकोडेमस, जो ङाडे टखेप येसुलाई डैने ओनाव, नोये हैओवारो, <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />“कडा, गे गेन्यामये ङाःडे मीराई यागोहाइ माठैडे, सोनो नोये कडि डाडेनोयो हो मासन्डे नोलाई डोसि ठहरैडुव?”<verse eid="JHN 7:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52" />नोराई नोलाई जबाफ यायोव, “कडा नङ पनि गालीलला रो? सास्त्र चावसं परिःन, होकाम नङ रःङने नले, गालीललाम अगमबक्ता मारा।” <verse eid="JHN 7:52" /><verse number="53" style="v" sid="JHN 7:53" />होकाम स्यान्टै याज़ीःम-याज़ीःमडे यानाव।<verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="s">ब्यभिचार ओडोज़्याकं क्योसिव</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1" />स्यान्टै मीरं याज़ीःम-याज़ीःमडे यानाव। होकाम येसु जैतुन डान्डाटं ओनाव। <verse eid="JHN 8:1" /><verse number="2" style="v" sid="JHN 8:2" />फरि छकाल्ने येसु प्रार्ठना डोने ज़ीःमलं वोल्डे ओराव, होकाम स्यान्टै मीरं येसु लेवकं याराव, होकाम येसुये चुङडे नोरंलाई ओपोयोरं। <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />न्याम पैनेरं सोनो फरिसीराई ब्यभिचार ओडोज़्याकं क्योसिव टोबो मेमालाई यारोयो, होकाम नोलाई मीराई याखार्ल यासच्यानो। <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />नोराई येसुलाई हैयाडोव, “गुरबा आव मेमा ब्यभिचार ओडोज़्याकं ओक्योसिव। <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />न्यामटं ऐटावरंलाई लुङये झोम्ने आग्या मोसाये गेलाई याडेनैसिव। नङ आवलो ओबारेलं कै नवार?”<note caller="+" style="x"><char style="xo" closed="false">८:५ </char><char style="xt" closed="false"><ref loc="LEV 20:10">लेबी २०:१०</ref>; <ref loc="DEU 22:22-24">न्याम २२:२२-२४</ref> </char></note> <verse eid="JHN 8:5" /><verse number="6" style="v" sid="JHN 8:6" />नोराई येसुलाई जान्चीने सोनो येसुलाई आरोप लैसिडु सै वार्डे ऐ यावारो। होकाम येसुये घोम लेडे नामलं उकुइसैये ओसोरो। <verse eid="JHN 8:6" /><verse number="7" style="v" sid="JHN 8:7" />नोराई येसुलाई पजोयोका-पजोयो याझोयो, होकाम येसु ठ लेडे च्याङसिडे नोरंलाई हैओडोवरं, “जे भरिलाम जोये खर्कज़ पाप ओडोव माले, होये आव मेमालाई ङाडे लुङये ओझोमोकं।” <verse eid="JHN 8:7" /><verse number="8" style="v" sid="JHN 8:8" />होकाम येसुये फरि घोम लेडे उकुइसैये नामलं ओसोरो। <verse eid="JHN 8:8" /><verse number="9" style="v" sid="JHN 8:9" />नोराई आवरोः याठोयो, होकाम सेःरङाम टोबोनि टोबो आलिज़ा समं स्यान्टै यानाव, होकाम येसुनि नो मेमासं नेबाठङ राःडे याख्यानोयोरं, नो मेमा येसुलो ओङाःकं च्याङसिडेज़ ओलेव। <verse eid="JHN 8:9" /><verse number="10" style="v" sid="JHN 8:10" />येसुये नो मेमालाई ठ लेडे रःङडे हैओडोव, “ए मेमा, नोरं कान्डे यानाव? कडा काङ्कायेज़ नङलाई सजै मायानरंये?”<verse eid="JHN 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11" />नो मेमाये हैओवारो, “प्रभु, काङ्कायेज़ मायाङरंये।” येसुये हैओडोव, “ङा पनि नङलाई सजै ङामयान। गनानके फरि पाप टाडो।”]<note caller="+" style="f"><char style="fr" closed="false">८:११ </char><char style="ft" closed="false">कोइ पुरानो कुइये सर्सिव कितापयालं आव खन्ड छुटं पोलं नैसिव ले</char></note><verse eid="JHN 8:11" /></para>
  <para style="s">येसु सङसारला ज्योती</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />येसुये फरि नोरंलाई हैओडोवरं, “ङा प्रिठीबीला ज्योती ची। ङाछिन्ट राने अन्ड्यारोलं बाने माले, बुरु नोये जीबनला ज्योती डैनेले।”<verse eid="JHN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13" />होकाम फरिसीराई येसुलाई हैयाडोव, “नङ नबारेलं नङज़ गोहाइ नयोज़्या। नगोहाइ सत्य माठहरि।”<verse eid="JHN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14" />येसुये जबाफ ओयोवरं, “ङा ङाबारेलं गोहाइ ङायोनि, पनि ङागोहाइ सत्यले। ङा ठा ङासंन, ङा काङाम ङाराव, होसोनो कान्डे ङानारिज़्या। बुरु जे जेमसन, ङा काङाम ङाराव, होसोनो कान्डे ङानाज़्या। <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />जे मी रःङडे निया जेडाये। ङा काङ्कालो ओनिया ङामडोये। <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />ङा निया ङाडोखे भने पनि, ङा निया सत्य ठहरिये। कडालेकं निया डाने ङा ङाबाठङ ङाम्ले, बुरु ङा सोनो ङालाई परिःङने ङाबाबु ङासंले <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />जे जेन्यामटं पनि नेबऱ्याङ मीलो ओगोहाइ सत्य ठहरिये वार्डे सर्सिवले। <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />ङाबारेलं ङाज़ गोहाइ ङायोये, होसोनो ङालाई परिःङने ङाबाबुये ङाबारेलं गोहाइ योवये।”<verse eid="JHN 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19" />नोराई येसुलाई हैयाडोव, “नबाबु काङ उलिज़्याव?”</para>
  <para style="p" vid="JHN 8:19">येसुये जबाफ ओयोवरं, “जे न ङालाई जेसरेःसङ न ङाबाबुलाई। जे ङालाई जेसरेसङखिन्के ङाबाबुलाई पनि जेसरेखेहो।” <verse eid="JHN 8:19" /><verse number="20" style="v" sid="JHN 8:20" />येसुये आव रोः प्रार्ठना डोने ज़ीःमलं ओपैरंकं भेटी चरैने जालो ओछ्योकं हैओवारो। होकाम काङ्कायेज़ येसुलाई माक्योरंये, कडालेकं येसुलो ओबेला अजं ओमराटाव।<verse eid="JHN 8:20" /></para>
  <para style="s">जोडे ङा ङानारिज़्या होङ जे जेमनाडु</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />येसुये फरि नोरंलाई हैओडोवरं, “ङा ङाना होकाम जे ङालाई खिम्ने जेले, होकाम जे जेपापलंज़ सिने जेले। जोङ ङा ङाना जे जेमराडु।”<verse eid="JHN 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22" />यहुडीराई हैयावारो, “आवये के सैसिने ओपान्ज़्याव सै कडि? कडालेकं आवये ‘जोङ ङा ङाना जे जेमराडु’ वार्डे हैवार्ज़्या।”<verse eid="JHN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23" />होकाम येसुये नोरंलाई हैओडोवरं, “जे मेलारं ची। ङा रोटा ची। जे आव प्रिठीबीलारं ची। ङा आव प्रिठीबीला माङ्क ची। <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />ङा जेलाई हैङाडाच्योज़्या, ‘जे जेपापलंज़ सिने जेले’ कडालेकं ‘ङा होज़<note caller="+" style="f"><char style="fr" closed="false">८:२४ </char><char style="ft" closed="false">परमेस्वरलो उमिनकामटा टोबो मिन</char></note>’ वार्डे जे बिस्वास जेमडाखे भने जेपापलंज़ सिने जेले।”<verse eid="JHN 8:24" /></para>
  <para style="r">
    <ref loc="JHN 4:26">युहन्ना ४:२६</ref>; <ref loc="EXO 3:14">बाने ३:१४</ref></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25" />नोराई येसुलाई यापजोयो, “नङ काङ्का खेने?”</para>
  <para style="p" vid="JHN 8:25">येसुये नोरंलाई हैओडोवरं, “ङा होज़, आव रोः जेलाई पैलाकामज़ हैङाडाच्योज़्या। <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />ङा जेलाई डोसैने सोनो निया डाने भ्याज़ लिज़्या। हैनि पनि ङालाई परिःङने सत्य ले, होसोनो हो लेवङाम ङा जो ङाठोयो हो रोःज़ ङा प्रिठीबीलाई हैङाडोज़्या।”<verse eid="JHN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27" />बाबुलो ओबारेलं येसुये हैओवार्ज़्याव ची वार्डे नोराई माबुझिरंये। <verse eid="JHN 8:27" /><verse number="28" style="v" sid="JHN 8:28" />हैजैडे येसुये हैओवारो, “होकाम जे मानवालो ओज़ालाई याडे छेन्ने जेले, ‘ङाज़’ वार्डे जे ठा सन्ने जेले, ङा ङाअडिकारये कडिज़ ङामडो, बुरु बाबुये ओपैसोङो रोःरं ङापाङज़्याव वार्डे सन्ने जेले। <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />ङालाई परिःङने ङासंज़ लिज़्या। नोये ङालाई ङाबाठङ मारासोङोये, कडालेकं ङा एकसप्ड्याज़ नोलाई खुसि झैने येःन ङाडोये।”<verse eid="JHN 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 8:30" />येसुये आव रोः ओपाङ्क भ्या मीराई येसुलाई बिस्वास याडोव।<verse eid="JHN 8:30" /></para>
  <para style="s">सत्यये नङलाई छुट्कारा यानो</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />येसुये ओललाई बिस्वास डाने यहुडीरंलाई हैओडोवरं, “जे ङाबचनलं जेरंहिखे भने जे डस्साज़ ङासिसरंज़। <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" />होकाम जे सत्य कडि वार्डे सन्ने जेले, होकाम सत्यये जेलाई छुट्कारा झैनेले।”<verse eid="JHN 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33" />नोराई येसुलाई जबाफ यायोव, “गे अब्राहामलो ओसन्तानरं ची, होसोनो आर्क समं काङ्कालो ओकमारा गेटाव माले। ‘जे छुट्कारा टाने जेले’ वार्डे कैजैडे हैजेवार्ज़्याव?”<verse eid="JHN 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34" />येसुये नोरंलाई जबाफ ओयोवरं, “डस्साज़ ङा जेलाई हैङाडाच्यो, पाप डाने स्यान्टै पापलो ओकमारारंज़। <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" />कमारा एकसप्ड्या ज़ीःमकं मालेये, बुरु ज़ाके एकसप्ड्याज़ ज़ीःमकं लेये। <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />हैजैडेज़ परमेस्वरलो ओज़ाये जेलाई छुट्कारा याझैच्योव भने जे पक्काज़ छुट्कारा डैने जेले। <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" />ङा ङासंन जे अब्राहामलो ओसन्तानरंज़। हैनि पनि जे ङालाई सैःने जेपान्सङज़्या, कडालेकं ङाबचनये जेलेवकं पो माडोयोये। <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />जो-जो ङा ङाबाबुलो ओङाःकं रःङडेङानै, होज़ ङा हैङावारंये। जे पनि जोज़ जेबाबु लेवङाम जेठोयो, होज़ जेडोये।”<verse eid="JHN 8:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39" />नोराई येसुलाई हैयाडोव, “गेबाबुके अब्राहाम ची।”</para>
  <para style="p" vid="JHN 8:39">येसुये नोरंलाई हैओडोवरं, “जे अब्राहामलो ओसन्तानरं जेटाखिन्के, अब्राहामये जो येःन ओडोव हो डाने जेलेव। <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" />ङा परमेस्वरङाम ङाठोयो सत्य रोः जेलाई हैङाडाच्योज़्या, बुरु आर्क जे ङालाई सैःने जेपान्सङज़्या। अब्राहामये ऐटाव येःन ओडोव माले। <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />जेबाबुये जो येःन ओडोव जे हो येःनज़ जेडोज़्या।”</para>
  <para style="p" vid="JHN 8:41">नोराई येसुलाई हैयाडोव, “गे ब्यभिचारङाम जर्मीव नामऱ्यारं माङ्कची! गेबाबु टोबोज़ ले, हो परमेस्वरज़।”<verse eid="JHN 8:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42" />येसुये नोरंलाई हैओडोवरं, “परमेस्वर जेबाबु ओटाखिन्के जे ङालाई मया जेडाङखेहो, कडालेकं ङा परमेस्वर लेवङाम ङाराव ची। ङा ङाइछ्याये ङाराव माङ्क, बुरु परमेस्वरये ङालाई उपरिःङसोङो ची। <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" />ङा हैङावार्ज़्याव जे कडा जेमबुझि? कडालेकं जे ङाबचन जेमठैडुये। <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" />जे के जेबाबु सैतानसंकारं ची, होसोनो जेबाबुलो उइछ्या पुरा झैने जे इछ्या जेडोज़्या। नो के सुरुङामज़ हत्यारा लेव, होसोनो नोलाई सत्यसं कडि वास्टाज़ माले। कडालेकं नोसं कडि सत्यज़ माले। नोये ढुटोयोये, नो ओल ओबानि स्यानावज़ पाङये, कडालेकं नो ढुटुवाज़ होसोनो ढुटुवालो ओबाबु ची। <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />ङा सत्य ङापाङये, हैजैडे जे ङालाई बिस्वास जेमडाङये। <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" />जे भरिलाम काङ्काये ङालाई पापलो डोस लैसङडुव? होकाम ङा सत्य ङापाङखे भने, कडा जे ङालाई बिस्वास जेमडाङ? <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" />जो परमेस्वरलोज़, होये परमेस्वरलो ओपाङ ठोयोये। जे परमेस्वरलो माङ्करं ची, हैजैडे जे जेमठैये।”<verse eid="JHN 8:47" /></para>
  <para style="s">येसु सोनो अब्राहाम</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />यहुडीराई येसुलाई जबाफ यायोव, “कडा गे हैगेवारो गेरोः ठीकं माङ्क, सै नङ सामरी ड होकाम नङलाई ज़्याः लागिडे उलिज़्याव?”<verse eid="JHN 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49" />येसुये जबाफ ओयोवरं, “ङालाई ज़्याः मालागिये, बुरु ङा ङाबाबुलो ओमान ङाडोये, होकाम जे के ङालाई मान जेमडाङये। <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />ङा ङामहिमा ङामखिम, टोबो लिज़्या जोये महिमा खिमोये होसोनो फासिला डोवये। <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" />डस्साज़ ङा जेलाई हैङाडाच्यो, कोइये ङाबचन याठोयो भने नो खर्कज़ सिने माले।”<verse eid="JHN 8:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52" />यहुडीराई येसुलाई हैयाडोव, “आबो गेलाई पक्काज़ ठा ओटाव, नङलाई ज़्याः लागिडे उलिज़्यावज़। अब्राहाम उसिव, अगमबक्तारं पनि यासिरं, नङ हैनवार्ज़्या, ‘कोइये ङाबचन याठोयो भने नो खर्कज़ सिने माले।’ <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />कडा नङ गेसाखा अब्राहाम भन्डा घ्योव डोरो? होके यासि, होसोनो अगमबक्तारं पनि यासिरं। नङ नङलाई काङ्का वार्डे हैनवार्ज़्याव?”<verse eid="JHN 8:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54" />येसुये जबाफ ओयोवरं, “होकाम ङा ङामहिमा ङाज़ ङाडोखे भने ङामहिमा सोजोज़ टाये। ङालाई महिमा याने ङाबाबु लिज़्या, जोलाई जे ‘गेपरमेस्वर’ हैजेवार्ये। <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />जे होलाई जेसरेव माले, बुरु ङा होलाई ङासरेये। ङा होलाई ङामसरेये ङावार्खे भने जे स्याव डुटाहा ठहरिने ङाले। हैनि पनि ङा होलाई ङासरेये, होसोनो होलो ओबचन ङाठैये। <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />जे जेसाखा अब्राहाम ङासमय रःङनेलो लागिटं बनै खुसि ओटाव, नोये ङाराने डिन रःङने आसये बनै ओरेङो।”<verse eid="JHN 8:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57" />हैजैडे यहुडीराई येसुलाई हैयाडोव, “नङके अजं पचास बर्सज़ नमयोटा, होकाम नङ अब्राहामलाई नरोःङोले?”<verse eid="JHN 8:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58" />येसुये नोरंलाई हैओडोवरं, “सत्य रोः ङा जेलाई हैङाडाच्यो, अब्राहाम ओलेव भन्डा ङाडेङामज़ ङा ङालिज़्या।”<verse eid="JHN 8:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 8:59" />होकाम नोराई येसुलाई लुङ टिडे झोम्ने यापानो, होकाम येसु मोसिडे प्रार्ठना डोने ज़ीःमलाम पाखाडे पुलुडे ओनाव।<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s">येसुये ओजर्मनकामटा अन्डलालाई ओससोमो</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />नलाग्यान्ट ओनाज़्याकं येसुये ओजर्मनकामज़ अन्डलाव टोबो अन्डलालाई ओरोःङो। <verse eid="JHN 9:1" /><verse number="2" style="v" sid="JHN 9:2" />उसिसराई येसुलाई यापजोयो, “रब्बी, काङ्काये पाप ओडोव, आवये सै आवलो वामा-ओबाबुये, होकाम आव अन्डला उजर्मिव?”<verse eid="JHN 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3" />येसुये जबाफ ओयोवरं, “न आवये पाप ओडोव न आवलो वामा ओबाबुये, बुरु आवलाई ससम्डे परमेस्वरलो ओसक्तिला येःन आव मीलो उजीबनटं गरःनकं वार्डे <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />ङालाई परिःङनेलो ओयेःन गेसं बेला उलिज़्याकंज़ डाव परिये। रि ओटाकंके, काङ्कायेज़ येःन माडोडुव। <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" />ङा आव प्रिठीबीलं ङालेव समं ङा प्रिठीबीला ज्योती ची।”<verse eid="JHN 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6" />आव रोः हैवार्डे येसुये नामलं उट्युलो, होकाम उट्युलये गम मुछिडे चिरिव झैडे उमिटं सेःडे ओयोव। <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" />होकाम येसुये नोलाई हैओडोव, “गनानके, सिलोआमलो (जोलो ओमाने, परिःङसिव) कुन्डलं नाडे हुर।” नोये नाडे उहुरो, होकाम रःङने टाडे ओवोलो।<verse eid="JHN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8" />होकाम नोलो उछिमेकिराई जोराई नोलाई ङाःडे नोलाई भीख उनिज़्याव यारोःङो होराई हैयावारो, “कडा चुङडे भीख निःने मी आव माङ्क?”<verse eid="JHN 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 9:9" />कोइ-कोइये हैयावारो, “आव होज़।”</para>
  <para style="p" vid="JHN 9:9">उरुराई हैयावारो, “माङ्क, आव के नो स्यावज़ रःनज़्या।”</para>
  <para style="p" vid="JHN 9:9">नोये हैओवारो, “ङा होज़।”<verse eid="JHN 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10" />होकाम नोराई होलाई यापजोयो, “नमि कैजैडे ओफैसिवखेने?”<verse eid="JHN 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11" />नोये जबाफ ओयोवरं, “येसु वार्ने टोबो मीये गम मुछिडे ङामिटं सेःडे ङालाई हैओडाङो, ‘सिलोआमलं नाडे हुर।’ नाडे ङाहुरो होकाम ङा रःङने ङाटाव।”<verse eid="JHN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12" />नोराई नोलाई हैयाडोव, “नो काङ उलिज़्यावखेने?”</para>
  <para style="p" vid="JHN 9:12">नोये हैओवारो, “ङा ठा ङाम्सन।”<verse eid="JHN 9:12" /></para>
  <para style="s">फरिसीराई सम्नेलो ओबारेलं यापजोयो</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />हो अन्डला मीलाई नोराई फरिसीरं लेवकं यारोयो। <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />जो छ्याम येसुये गम मुछिडे हिला झैडे नोलो उमिलङटं सेःडे उमिलङ फैडेओयोव होछ्याम यहुडीरं यानाःसिने डिन लेव। <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />फरिसीराई नोलाई यापजोयो, “नङ कैजैडे रःङने नटाव?” नोये होरंलाई हैओडोवरं, “येसुये गम मुछिडे ङामिलङटं सेःडे ओयाङो, होकाम ङा ङाछेलाव होकाम रःङने ङाटाव।”<verse eid="JHN 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16" />कोइ-कोइ फरिसीराई हैयावारो, “नो मी परमेस्वर लेवङाम राव माङ्कची, कडावार्क नोये नाःसिने डिन मामानिवये।”</para>
  <para style="p" vid="JHN 9:16">होकाम उरुराई हैयावारो, “पापी मीये कैजैडे एटाव चिन्नरं डोडुव?” होकाम नोरं या-याज़ युसिने सुरु याडोव।<verse eid="JHN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17" />नोराई नो अन्डलालाई यापजोयो, “नो मीये नमि फैडेओयानो लेव आबो होलो ओबारेलं नङ कैनंवार?”</para>
  <para style="p" vid="JHN 9:17">नोये जबाफ ओयोवरं, “नो के अगमबक्ता ची ओलेवलेव।”<verse eid="JHN 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18" />उमि फैसिव मीलो वामा-ओबाबुलाई खुल्डे यामपजैया समं यहुडी अगंवाराई नो अन्डला ओलेव होकाम रःङने ओटाव वार्डे बिस्वास माडोरंये। <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />होकाम नोराई वामानि ओबाबुनिलाई यापजोयोरं, “आव जेज़ारो आव अन्डलाज़ उजर्मिव वार्डे जिन हैजेवार्डु? होकाम आबो कैजैडे रःङडुने ओटाव?”<verse eid="JHN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20" />नोलो वामा-ओबाबुनि नोरंलाई हैनेडोवरं, “गिन ठा गेसन आव गेज़ाज़, होसोनो अन्डलाज़ उजर्मिव। <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />होकाम आबो आव कैजैडे रःङडुने ओटाव गिन गेम्सन, होसोनो आवलो उमि काङ्काये फैडेओयोव नो पनि गिन गेम्सन। आवलो उउमेर योडेले, आवलाईज़ पजैच्यो। ओबारेलं नो ओल्ज़ पाङनेले।” <verse eid="JHN 9:21" /><verse number="22" style="v" sid="JHN 9:22" />नोलो वामा-ओबाबुनि आव रोः हैनेवारो, कडावार्क नोनि यहुडी अगंवारासं नेछेव। कडालेकं कोइराई येसुके ख्रीस्ट ची वार्डे स्वीकार याडोरं भने, नोलाई यहुडीरं याडुप्सिने ज़ीःमलाम पुलैने वार्डे यहुडीराई ङाडेज़ सल्ला डाडे यानैज़्याव। <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />हैजैडे ज़ नोलो वामा ओबाबुनि ऐ नेवारो, “आवलो उउमेर योडेले आवलाईज़ पजैच्यो।”<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />होकाम नोराई नो अन्डला मीलाई फरि टखेप खुल्डे हैयाडोव, “परमेस्वरलाई महिमा यो। गे ठा गेसन आव मीके पापी ची।”<verse eid="JHN 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25" />नोये जबाफ ओयोवरं, नो पापी सै माङ्क, ङा ङाम्सन। टोबो रोःयाज़ ङा ङासंन ङा अन्डला ङालेव, आबो ङारःङज़्या।<verse eid="JHN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26" />होकाम नोराई नोलाई हैयाडोव, “होये नङलाई कै ओझैसोनो? होये नमि कैजैडे फैडेओयानो?”<verse eid="JHN 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27" />नोये नोरंलाई जबाफ ओयोवरं, “ङा जेलाई आछ्याज़ हैङाडाच्योव, जे जेमठैये। आबो फरि कडाने ठैने जेपान्ज़्याव? जे पनि नोलो उसिस टाने जेपान्ज़्याव सै कडि?”<verse eid="JHN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28" />नोराई नोलाई गाल डाडे हैयाडोव, “नङ ची नोलो उसिस, बुरु गेके मोसालो उसिसरं ची। <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />गेलाई ठा ले मोसासंके परमेस्वर ओपाङो लेव, बुरु गेलाई ठा माले आव मी काङा याटाया।”<verse eid="JHN 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30" />नो मीये नोरंलाई जबाफ यारंडे हैओडोवरं, “खैटाव अचम्बला रोः! नो काङाम ओराव जे जेमसन्ये, बुरु होये ङामि फैडेओयाङो। <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />गे गेसन परमेस्वरये पापीराई यारोः माठोयोये, बुरु परमेस्वरलो ओछ्या डाने सोनो परमेस्वरलो उइछ्या मानिने मीलो ओरोः परमेस्वरये ठोयोये। <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />प्रिठीबी सुरु ओटावकामटा एटाव जर्मीव अन्डलालो उमिलङ काङ्कायेज़ फैडेओयोव रोः खर्कज़ माठैसिये। <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />होकाम आव मी परमेस्वरङाम ओमराव टावसं नोये कडिज़ माडाडुने लेव।”<verse eid="JHN 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34" />नोराई नोलाई जबाफ याडे हैयाडोव, “नङके पापलं जर्मीडे पापलंज़ नघ्योव ची, होकाम कडाने नङ गेलाई पैने नपानसिज़्याव?” होकाम नोराई नो मीलाई यहुडीरं याडुप्सिने ज़ीःमलाम पाखाडे यापुलोयो।<verse eid="JHN 9:34" /></para>
  <para style="s">आत्माला अन्डला</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />नोराई नो समो अन्डला मीलाई पाखाडे यापुलोयो वार्ने येसुये ओठोयो, होकाम नोसं डैसिडे येसुये हैओडोव, “होकाम नङ मानवालो ओज़ालाई बिस्वास नोडो?”<verse eid="JHN 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36" />नोये जबाफ याडे हैओवारो, “प्रभु हो काङ्का? ङा नोलाई बिस्वास डानेङाले?”<verse eid="JHN 9:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37" />येसुये नोलाई हैओडोव, “नङ नोलाई रःङडेननै, नङसं पाङने होज़।”<verse eid="JHN 9:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38" />होकाम नोये हैओवारो, “प्रभु ङा बिस्वास ङाडो” होकाम नोये येसुलाई ढो ओडोव।<verse eid="JHN 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39" />होकाम येसुये हैओवारो, “ङा नियालो लागिटं आव प्रिठीबीलं ङाराव, होकाम मारःङनेराई गरःङरंकं होसोनो रःङनेरं अन्डला ओटारंकं।”<verse eid="JHN 9:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40" />आव रोः ठैडे येसुलो ओछ्योकं लिज़्याव कोइ-कोइ फरिसीराई येसुलाई हैयाडोव, “कडा होकाम गे पनि अन्डलारंज़ रो?”<verse eid="JHN 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41" />येसुये नोरंलाई हैओडोवरं, “जे अन्डलारं जेटाखिन्के पापलो डोसि टानेजेमलेव, बुरु जे ‘गेरःङज़्या’ जेवार्ज़्या, हैजैडे जे पापीज़ जिलिज़्या।”<verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s">ग्वालालो ओसात्रो</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />सत्य रोः, ङा जेलाई हैङाडाच्यो, “जो भेडा गोठोलं झला फैडे मापसिडे बार पाडे पसिये, नो चोर सोनो डाङ्कु ची, <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" />बुरु झला येमङाम गोठोलं पसिने के भेडा ग्वालाज़। <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" />गोठो गुनेये नोलाई झला फैड्योवये, होकाम भेडाराई नोलो ओगा ठैरंये, होसोनो नोये ओभेडारंलाई यामिन पान्डे खुलोरंये, होकाम नोरंलाई पाखाडे लाङोरंये। <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />नोये स्यान्टै भेडारंलाई पाखाडे उपुलोयोरं पाना, नो भेडाराई याङा-याङा नाये, होकाम भेडारं नोलो उछिन-उछिन नारंये, कडालेकं भेडाराई नोलो ओगा सरेःरंये। <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />बुरु यामसःरेव मीलो उछिन्ट भेडारं मानारंये, भेडारं नोलाई रःङडे ढोङने लेरं। कडालेकं मासरेसिव मीलो ओगा भेडाराई मासरेरंये।” <verse eid="JHN 10:5" /><verse number="6" style="v" sid="JHN 10:6" />येसुये नोरंलाई आव सात्रो झाडेओयोवरं, हैटानि पनि येसुये नोरंलाई हैओडोवरं रोः नोराई माबुझिरंये।<verse eid="JHN 10:6" /></para>
  <para style="s">येसु चाव ग्वाला</para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />हैजैडे येसुये नोरंलाई हैओडोवरं, “सत्य रोः, ङा जेलाई हैङाडाच्यो, भेडाराई याझलायेम ङाज़। <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />ङा भन्डा ङाडे रावरं स्यान्टै चोर सोनो डाङ्कुरं ची, भेडाराई नोराई यारोः माठैरंये। <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />झला ङाज़ ची, कोइ मी ङालेवङाम ज़ीःमलं यापसि भने नो बान्चिनेले, होकाम गोठोलं सोनो पाखाडे राने-नाने डानेले, होसोनो ज़्याव डैनेले। <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />चोर के कुने, सैःने सोनो नास झैने मान्त्रायाज़ राये। ङा के नोराई जीबन गडैरंकं होकाम नो बनै भ्या गडैरंकं वार्डे ङाराव।” <figure style="fig" alt="Shepherd with his sheep in sheepfold" file="lb00014c.tif" size="col" copy="Horace Knowles ©" ref="१०:७">भेडाबाक्रा गोठोङ ओभेडारासं ग्वाला</figure><verse eid="JHN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11" />ङा के चाव ग्वाला ची। चाव ग्वालाये ओभेडाराई यालागिटं उज्यु पनि झावये। <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />भाराला नैसिव मी के भेडाराई याग्वाला माटाये। नो के ब्वाङसा ओराज़्याव रःङडे भेडारंलाई राःडे नो ढोङ्ये, होकाम ब्वाङसाये भेडारंलाई क्योःडे लाङोरंये, होसोनो भेडारं चित्राङ पुत्राङ जोयोरंये। <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />नो ढोङ्ये कडालेकं नो के भाराला मी ची, नो भेडाराई कडि यावास्टाज़ माडोव। <verse eid="JHN 10:13" /><verse number="14" style="v" sid="JHN 10:14" />“ङा चाव ग्वाला ची, ङा ङाभेडारंलाई ङासरेरंये, होसोनो ङाभेडाराई ङालाई सरेसङरंये। <verse eid="JHN 10:14" /><verse number="15" style="v" sid="JHN 10:15" />कैजैडे बाबुये ङालाई सरेसोङो, ङा पनि बाबुलाई ङासरेये, होसोनो ङा भेडाराई यालागिटं ङाज्यु पनि ङाजा।” <verse eid="JHN 10:15" /><verse number="16" style="v" sid="JHN 10:16" />“ङा उरु ङाभेडारं पनि लेरं, नोरं आव गोठोलारं माङ्करं ची। नोरंलाई पनि ङा रोयो परिज़्यारं, होकाम नोरं टोबो बगालज़ टाने लेरं, होसोनो टोबो गोठोलाज़ टानेरं ले।<verse eid="JHN 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 10:17" />बाबुये ङालाई आव कारनये मया डाङोये, कडावार्क ङा ङापोहोन फरि सोवोल्डे रैने झैडे ङायोज़्या। <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />काङ्काये पनि ङा लेवङाम ङापोहोन लाङो माढुव, बुरु ङा ङाइछ्याये ङापोहोन ङायो। ङापोहोन योने अडिकार ङासंज़ ले, होसोनो फरि सवोल्डे रैने अडिकार पनि ङासंज़ ले। आव ङा ङाबाबुङाम ङाडोयो आग्या ची।”<verse eid="JHN 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19" />आव बचनलो ओकारनये यहुडीरं फरि यायुसिव। <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />नोरं भ्याबिछोये ऐयावार्ज़्याव, “आवलाईके ज़्याः ची लागिडेले, होसोनो आव माल्ङग्याडे ची ले। जे आवलो ओरोः कडाने जेठैज़्याव?”<verse eid="JHN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21" />उरुराई हैयावार्ज़्याव, “ज़्याः लागिव मीलो ओरोः ऐटाव माटाये। होकाम भुतंये अन्डलाराई यामि फैडुव डोरो?”<verse eid="JHN 10:21" /></para>
  <para style="s">येसुलाई याममानिव</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />यरुसलेमलं मन्डिर सुम्पिने पर्ब लेव। आव युङःडा बेलाकं लेव। <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />येसु प्रार्ठना डोने ज़ीःम ज्युङलं सोलोमन याडोज़्याव मैराटं आडेहोडे ओबाज़्याव। <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />यहुडीरं चारकोनाङाम डुप्सिडे येसुलाई याखार्ल झाडे यापजोयो, “खर्का समं नङ गेलाई डोमनलं ननैसि? नङ ख्रीस्टज़ टावसं गेलाई प्रस्टज़ हैडासि।”<verse eid="JHN 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25" />येसुये नोरंलाई जबाफ याडे हैओडोवरं, “ङा जेलाई हैडाडे ङाखेम्च्योव ची, जे बिस्वासज़ जेमडाये। ङा बाबुलो उमिन्ट जो येःन ङाडोये, नो येःनयेज़ ङागोहाइ योवये। <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />हैनि पनि जे बिस्वास जेमडाये, कडालेकं जे ङाभेडारं माङ्करं ची।” <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />“ङाभेडाराई ङा गा ठैरंये, हैजैडे नोरंलाई ङा ङासरेरंये, होसोनो नोरं ङाछिन्ट रारंये। <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />नोरंलाई ङा खर्कज़ मासिने जीबन ङायोरं, होकाम नोरं खर्कज़ नास टाने मालेरं, होसोनो नोरंलाई काङ्काये पनि ङाकुइटाम नानडे लाङने मालेरं। <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" />ङाबाबुये नो ङालाई याडेनैसोङो; होके स्यान्टैराई भन्डा घ्योव ची ले। बाबुलो उकुइटाम काङ्कायेज़ नानडे लाङने मालेरं। <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" />बाबुसं गिन टोबोनि ज़।”<verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />यहुडीराई येसुलाई फरि लुङ टिडे झोम्ने यापानो। <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />येसुये नोरंलाई हैओडोवरं, “ङा जेलाई ङाबाबु लेवङाम बनै भ्या चाव येःन डाडे सटन्डे ङायाच्योव, होकाम काव येःन जेमन मालागिडे ङालाई लुङये झोम्ने जेपान्सङज़्याव?”<verse eid="JHN 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33" />यहुडीराई येसुलाई जबाफ यायोव, “चाव येःनलो ओलागिटं गे नङलाई लुङये गेमझोमसन, बुरु परमेस्वरलो उबिरोड नडोव कारनये, कडालेकं नङ मी टाडे पनि नङलाई परमेस्वर नजैज़्या।”<verse eid="JHN 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34" />येसुये नोरंलाई जबाफ ओयोवरं, “कडा जेन्यामटं सर्सिव माले, ‘ङा हैङावारो, जे के डेवतारं ची?’ <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" />जोराई लेवकं परमेस्वरलो ओबचन ओराव, नोरं डेवता याटारं भने ढर्मसास्त्र झुठा माटाये, <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />बाबुये चोखो झैडे प्रिठीबीलं उपरिःङो मीये ‘ङा परमेस्वरलो ओज़ा ची’ ओवार्क कैजैडे परमेस्वरलो उबिरोड ओटाव? <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" />होकाम ङा ङाडोज़्याव येःन ङाबाबुलो माटाखे भने ङालाई बिस्वास टाडाङ्च्यो। <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />होसोनो ङा ङाबाबुलो ओयेःन ङाडोये हैटानि पनि जे ङालाई बिस्वास जेमडाङखे भने आव येःनरंलाई के बिस्वास डाच्यो, होकाम जे ठा सन्नेजेले होसोनो बुझिनेजेले, बाबु ङासं उलिज़्याव, सोनो ङा बाबुसं।”<verse eid="JHN 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 10:39" />नोराई फरि येसुलाई क्योःने यापानो, होकाम येसु नोराई याकुइटाम हाइसिडे ओनाव।<verse eid="JHN 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40" />होकाम येसु फरि यर्डन भै होपंटं ओनाव, नटं युहन्नाये ङाडे बप्तिस्मा ओयोज़्यावरं, होकाम येसु नङंज़ ओलेव। <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />बनै भ्या मीरं येसु लेवकं याराज़्याव, होकाम नोराई हैयावारो, “युहन्नाये कडि चिन्नरं माडोवये, हैनि पनि युहन्नाये आवलो ओबारेलं जो-जो हैओवारो नो सत्यज़ ओलेवलेव।” <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />होकाम नलं भ्या मीराई येसुलाई बिस्वास याडोव।<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s">लाजरस उसिव</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />लाजरस उमिन लेव टोबो मी ठलिडे उलिज़्याव। नो मरियम सोनो नोलो ओनाना मार्ठानि नेगाउँ बेठानियाला लेव। <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" />प्रभुलाई मङ-मङ बासिने ठी ठिडे ओखङटं ओचेमये सिड्याने मरियम आवज़। आवलो ओभाइ लाजरस ठलिव लेव। <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />आव नाना बैनीनि येसु लेवकं ऐवार्डे सोर निपरिःङो, “प्रभु, जोलाई नङ मया नडोये, नो ठलिडे ले।”<verse eid="JHN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4" />होकाम येसुये आव ठैडे हैओवारो, “आव जोरोये मी मासोयो, बुरु आव परमेस्वरलो ओमहिमा टाने लागिटं ची, कडालेकं आव मीटाम परमेस्वरलो ओज़ालो ओमहिमा गटाकं।”<verse eid="JHN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 11:5" />येसुये मार्ठा, सोनो नोलो ओबैनी होसोनो लाजरसलाई मया डोवरंये, <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />हैटानि पनि लाजरस ठलिज़्या वार्ने ठैडे येसु जोङ उलिज़्याव, होङ अजं नेला ओलेव। <verse eid="JHN 11:6" /><verse number="7" style="v" sid="JHN 11:7" />होकाम येसुये उसिसरंलाई हैओडोवरं, “बा आबो गे फरि यहुडियालं वोल्डे गेनाके।”<verse eid="JHN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8" />उसिसराई येसुलाई हैयाडोव, “रब्बी, बाभाज़ यहुडीराई नङलाई लुङये झोम्ने यापानसोनो, होकाम फरि नङ नलंज़ नना?”<verse eid="JHN 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9" />येसुये जबाफ ओयोवरं, “कडा लाभरिलं बारं घन्टा माटाये डोरो? लाकं बानेलो ओखङ टुःम्ने माले, कडालेकं नोये आव प्रिठीबीला ज्योती रःङज़्याव, <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />हैनि पनि रिलं बानेलो ओखङ टुःमये, कडालेकं नो मीसं उज्यालो माटाये।” <verse eid="JHN 11:10" /><verse number="11" style="v" sid="JHN 11:11" />होकाम येसुये नोरंलाई हैओडोवरं, “गेनै लाजरस ङल्डेले, नोलाई सोचैने ङा नलं ङाना।”<verse eid="JHN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12" />येसुलाई उसिसराई हैयाडोव, “प्रभु, नो ङःल्डे ओलेखिन्के सम्नेले।”<verse eid="JHN 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 11:13" />येसुये नो सिडे उलिज़्याव रोः हैओवारो, होकाम उसिसराई उमिरं राडे ङल्डे उलिज़्याव वार्डे हैओवार्ज़्याव वार्डे यासुन्चीव। <verse eid="JHN 11:13" /><verse number="14" style="v" sid="JHN 11:14" />येसुये नोरंलाई प्रस्ट झैडे हैओडोवरं, “लाजरस सिडेले। <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />जे ङालाई बिस्वास डाङच्यो वार्डे ङा नलं चानो ङाम्नाव। जो ओटानि पनि ङा खुसि ङालिज़्या बा गे नो लेवकं गेनाके।”<verse eid="JHN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16" />होकाम डिडुमस याडोज़्याव ठोमाये ओनैरंलाई हैओडोवरं, “बा, गे पनि गेनाके, होकाम येसुसंज़ सिने टानि पनि गेसिके।”<verse eid="JHN 11:16" /></para>
  <para style="s">येसु सिडे ज्युङडाटाने सोनो जीबन</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />येसुरं याकेरिव, होकाम लाजरसलाई खाडरलं यानोयो चार डिन टाडे उलिज़्याव येसुये ठा ओसोनो। <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />बेठानिया यरुसलेमकाम नजिकज़ ठोकै सोङ किलो मिटर याज़ टाडा टाये। <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />भ्या यहुडीरं मार्ठा सोनो मरियम लेवकं राडे यालिज़्याव। कडालेकं नोनि नेभाइ उसिव डुखंलं सम्झैने राडे यालिज़्याव।<verse eid="JHN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 11:20" />येसु राज़्या वार्ने ठैडे मार्ठा नाडे येसुलाई ओडैनाव। मरियम ज़ीःमकंज़ ओलेव। <verse eid="JHN 11:20" /><verse number="21" style="v" sid="JHN 11:21" />होकाम मार्ठाये येसुलाई हैओडोव, “प्रभु, नङ आकं नलेखिन्के ङाभाइ मासि हो। <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />आबो पनि ङा ङासंन, नङ परमेस्वरसं जो ननिः, परमेस्वरये नङलाई यानेले।”<verse eid="JHN 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23" />येसुये नोलाई हैओडोव, “नभाइ फरि ज्युङडा टानेले।”<verse eid="JHN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24" />मार्ठाये येसुलाई हैओडोव, “ङा ङासंन, नो आखिरला ज्युङडा टाने डिनलं फरि सिवलाम ज्युङडा टाडे सोनेले।”<verse eid="JHN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25" />येसुये नोलाई हैओडोव, “सिवलाम ज्युङडा झैने सोनो जीबन ङाज़ ची। ङालाई बिस्वास डाने उसिनि पनि ज्युङडा टानेले। <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />होसोनो ङालाई बिस्वास डाडे बान्चिने मी खर्कज़ सिने माले। होकाम नङ आवरोः बिस्वास नोडो?”<verse eid="JHN 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27" />मार्ठाये येसुलाई हैओडोव, “अँ प्रभु, ङा बिस्वास ङाडो, नङ प्रिठीबीला राने परमेस्वरलो ओज़ा ख्रीस्टज़।”<verse eid="JHN 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28" />आडङ हैवार्डे नो ओनाव, होकाम ओबैनी मरियमलाई खुल्डे खुसुक्क हैओडोव, “गुरबा ओकेरिव, नङलाई खुल्सनज़्याव।” <verse eid="JHN 11:28" /><verse number="29" style="v" sid="JHN 11:29" />आवरोः ठैडे मरियम चानोज़ च्याङसिडे येसु लेवकं ओनाव। <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />नो बेला समं येसु नाङखारलं ओमकेरिटाव, येसु नो पोकंज़ उलिज़्याव जोकं मार्ठाये येसुलाई ओख्यानोयो। <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />नोलाई सम्झैने ज़ीःमलं राव यहुडीरं मरियम ठर्च्याङसिडे पाखाडे ओनाज़्याव रःङडे, आव के नो खाडरलं नाडे ओघर्नाज़्याव ची वार्डे, नोलो उझिन-उझिन यानाव।<verse eid="JHN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32" />होकाम मरियम येसु उलिज़्याव पोकं राडे येसुलाई ओरोःङो, होकाम ऐवार्डे येसुलो ओखङटं उफुलुप्सिव, “ए प्रभु, नङ आकं नलेखिन्के ङाभाइ मासि हो।”<verse eid="JHN 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33" />नो ओघर्ज़्याव होकाम नोसं राने यहुडीरं पनि याघर्ज़्याव येसुये ओरोःङो, होकाम येसु आत्मालं बनै ओसोगो हाइडे बनै डुखि ओटाव। <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />येसुये नोरंलाई ओपजोयोरं, “जे नोलाई काङं नैडे जेनैज़्याव?”</para>
  <para style="p" vid="JHN 11:34">नोराई येसुलाई हैयाडोव, “प्रभु, राडे गरःङरिके।”<verse eid="JHN 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35" />येसु ओघोरो। <verse eid="JHN 11:35" /><verse number="36" style="v" sid="JHN 11:36" />हैजैडे यहुडीराई हैयावारो, “रःङच्यो येसुये नोलाई खाडंङ मया ओडोज़्याव लेव।”<verse eid="JHN 11:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37" />कोइ-कोइराई हैयावारो, “आवये अन्डलारंलाई यामि फैड्योरं आव मीलाई पनि सिवङाम माबचैडुव डोरो?”<verse eid="JHN 11:37" /></para>
  <para style="s">येसुये लाजरसलाई ज्युङडा ओझोयो</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />होकाम येसु फरि बनै ओसोगो हाइडे खाडरलं ओनाव। आव खाडर टोबो उडारलं लेव। नोलो ओयाटं टोबो पल्याटाये कप्सिव लेव। <verse eid="JHN 11:38" /><verse number="39" style="v" sid="JHN 11:39" />येसुये हैओवारो, “पल्याटा होडे झाच्यो।”</para>
  <para style="p" vid="JHN 11:39">सिव मीलो ओनाना मार्ठाये येसुलाई हैओडोव, “ए प्रभु, आबला समं के नो असिङःरने यापान्डुव हो, कडालेकं नो उसिव चार डिन याटाडु।”<verse eid="JHN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40" />येसुये नोलाई हैओडोव, “कडा ङा नङलाई हैङाडानो माङ्क, ‘नङ बिस्वास नडोखे भने परमेस्वरलो ओमहिमा रःङनेनले?’” <verse eid="JHN 11:40" /><verse number="41" style="v" sid="JHN 11:41" />नोराई पल्याटा याहायो। होकाम येसुये स्वर्गडे रःङडे हैओवारो, “ए बाबु, ङा नङलाई ढन्याबाड ङायान, कडालेकं नङ ङाबिन्ती नोठोयो। <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" />ङालाई ठाले ङाबिन्ती एकसप्ड्याज़ नठैये। हैनि पनि आका च्याङसिडे लिज़्याव माहुले मीराई यालागिटं ङा आव हैङावार्ज़्याव ची, कडालेकं नङ ङालाई नपरिःङसोङो ची वार्डे नोराई बिस्वास गोडोरंकं।”<verse eid="JHN 11:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 11:43" />आव रोः हैओवारो पाना येसु कस्सिडे उकिःव, “लाजरस, पाखाडे पुलुडे गरानके।” <verse eid="JHN 11:43" /><verse number="44" style="v" sid="JHN 11:44" />नो सिव मी नोलो ओखङ-उकुइ पट्टीये पोसिव सोनो ओङाः रुमालये कप्सिव सोनो क्वाये लुम्बैसिवज़ पाखाडे पुलुडे ओराव। येसुये नोरंलाई हैओडोवरं, “नोलो ओबन्डन पलाड्याच्यो, होकाम नोलाई नाव याच्यो।”<verse eid="JHN 11:44" /></para>
  <para style="s">येसुलाई सैःने जाल याडोव</para>
  <para style="r">
    <ref loc="MAT 26:1-5">मत्ती २६:१-५</ref>; <ref loc="MRK 14:1-2">मर्कुस १४:१-२</ref>; <ref loc="LUK 21:1-2">लुका २१:१-२</ref></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />मरियम लेवकं राव भ्या यहुडीराई येसुये ओडोव येःन रःङडे येसुलाई बिस्वास याडोव। <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />नोरं कोइ-कोइरं फरिसीरं लेवङ यानाव, होकाम येसुये ओडोव येःनरं हैयाडोवरं।<verse eid="JHN 11:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 11:47" />होकाम मुख्या सेवा डोने मीरं सोनो फरिसीराई घ्योव यासभाला सडस्यारंलाई याखुलोरं होकाम नोरंलाई हैयाडोवरं, “आबो गे कै लेने? कडालेकं आव मीये भ्या चिन्नरं डोज़्याव। <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />आवलाई सोजोज़ राःने याटा भने स्यान्टैये आवलाई बिस्वास डानेलेरं होकाम रोमीरं राडे गे चोखो गेमन्डिरं सोनो गेडेसलाई नास जैनेलेरं।”<verse eid="JHN 11:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49" />नोरंकाम टोबो कैयाफा, नो बर्सला मुख्या सेवा डोने मी लेव, नोये होरंलाई हैओडोवरं, “आव कडि ओटाज़्याव वार्डे जे कडिज़ जेमसन! <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />स्यान्टै डेसज़ नास टाने भन्डा बुरु मीराई यालागिटं टोबो मी सिनेज़ जेलागिटं चाव टानेले वार्डे जे जेमबुझि।” <verse eid="JHN 11:50" /><verse number="51" style="v" sid="JHN 11:51" />नोये आव ओल्ज़ हैओवारो माङ्क, बुरु नो बर्सला मुख्या सेवा डोने मी ओटावये डेसराई यालागिटं येसु सिव परिये वार्ने अगमबानी ओपाङो ची। <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />डेसलो ओलागिटंया मान्त्रा नोये आव हैओवारो माङ्क, बुरु चित्राङ पुत्राङ टाव परमेस्वरलो ओसन्तानरंलाई टोबोकं डुप्नेरं लागिटं आव हैओवारो।<verse eid="JHN 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 11:53" />ऐझैडेज़ नो छ्यामकाम नोराई येसुलाई सैःने सल्ला याडोव। <verse eid="JHN 11:53" /><verse number="54" style="v" sid="JHN 11:54" />हैजैडे येसु फरि यहुडीराई याखार्ल सतन्सिडे माबाये, येसु उसिसरासं मरुभुमिलो ओछ्योकं लिज़्याव एफ्राईम वार्ने सहरलं ओनाव, होकाम नलंज़ ओलेव।<verse eid="JHN 11:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55" />यहुडीराई निस्तार-यापर्ब नजिकंज़ ओराज़्याव, होकाम गाउँ-गाउँलाम बनै भ्या मीरं या-यालाई चोखैने वार्डे निस्तार-पर्ब सुरुटाने भन्डा ङाडेज़ यरुसलेमडे यानाव। <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />नोराई येसुलाई याखिमो, होकाम नोरं प्रार्ठना डोने ज़ीःमलं च्याङसिडे यालिज़्याकं या-याज़ हैयावारो, “जेलाई खैटाव लागिज़्या, नो पर्बलं राके डोरो?” <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />मुख्या सेवा डोने मीरं सोनो फरिसीराई येसुलाई क्योःने वार्डे नो काङ लिज़्या, कोइये ठा जेसनखे भने सोर डाच्यो वार्डे आग्या यायोवरं।<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s">बेठानियालं येसुलो पैला अभिसेक</para>
  <para style="r">
    <ref loc="MAT 26:6-13">मत्ती २६:६-१३</ref>; <ref loc="MRK 14:3-9">मर्कुस १४:३-९</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />निस्तार पर्बलो छ डिन ओङाःडेज़ येसु बेठानियालं ओराव। येसुये सिवलाम ज्युङडा ओझोयो लाजरस नलं लेये। <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />नोराई येसुलो ओलागिटं रिःम्डेका ज़्याव तयार याजोयो। मार्ठाये ज़्याव ओभाज़्याव, लाजरस पनि येसु सोनो उसिसरासं बोलोङ चुङसिडे ओज़्योज़्याव। <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" />होकाम मरियमये टमानाया बनै मङगो जटामसीलो मङ-मङ बसैने ठी रैडे येसुलो ओखङटं उठिड्योव, होसोनो येसुलो ओखङ ओचेमये सिडेओयोव, होकाम ठीलो ओबासनाये ज़ीःमज़ मङ-मङ ओबासिव। <verse eid="JHN 12:3" /><verse number="4" style="v" sid="JHN 12:4" />येसुलाई सक्योःने येसुलो टोबो उसिस, यहुडा इस्करियोतये हैओवारो, <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />“आव ठी सोङसय चान्डीलो ढ्याकलं येडे नो पैसा गरिबरंलाई यारंखिन माटारो?” <verse eid="JHN 12:5" /><verse number="6" style="v" sid="JHN 12:6" />नोये गरिबराई याख्यालं डाडे हैओवारो माङ्क, कडावार्क नो चोर लेव, होकाम पैसा नैने ठैलीलो जिम्मा नोलो उकुइटं लेव, नोये नलाम कुवये। <figure style="fig" alt="Alabaster jars" file="hk00142c.tif" size="col" copy="Horace Knowles ©" ref="१२:3">ठी झाने लुङलो जारं</figure><verse eid="JHN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7" />येसुये हैओवारो, “आवलाई कैज़ टाडाच्यो, ङा ङासिका ठिने ठी आर्कज़ ठिसङज़्याव ठिव याच्यो। <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />कडालेकं गरिबरं के एकसप्ड्याज़ जेसंज़ लेरं, ङा के एकसप्ड्या जेसं ङाम्ले।”<verse eid="JHN 12:8" /></para>
  <para style="s">लाजरसलाई सैःने योजना</para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />यहुडीराई टोबो घ्योव यासमुहये येसु नलं लिज़्या वार्ने ठा यासोनो, होकाम येसुलो ओलागिटंया मान्त्रा माङ्क, येसुये सिवलाम ज्युङडा ओझोयो लाजरसलाई पनि रःङने वार्डे नोरं राडेयालिज़्याव। <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />हैजैडे मुख्या सेवा डोने मीराई लाजरसलाई पनि सैःने सल्ला याडोव। <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />कडालेकं नोलो ओकारनये भ्या यहुडीरं छुटिडे नाडे येसुलाई बिस्वास याडोव।<verse eid="JHN 12:11" /></para>
  <para style="s">यरुसलेमलं येसु राजा मान्टि ओनाव</para>
  <para style="r">
    <ref loc="MAT 21:1-11">मत्ती २१:१-११</ref>; <ref loc="MRK 11:1-11">मर्कुस १1:१-११</ref>; <ref loc="LUK 19:28-40">लुका १९:२८-४०</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />ओपराटि पर्बला राने माहुले मीराई येसु यरुसलेमडे राज़्या वार्ने याठोयो, <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />होकाम मीरं येसुलाई ओमान डाडे ढन्याबाड याडे खजुरलो ओखाररं रैडे किःये-किःये याराव, “होसन्ना! रेङो नो घ्योव प्रभुलो उमिनङाम राःने इस्राएलला राजा!”<verse eid="JHN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 12:14" />होकाम टोबो बाभाका माडाहिसिव गडाहा डैडे येसु होटं उपुलुव, ऐटाव सर्सिवले,<verse eid="JHN 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15" />“सियोनला सहर, टाछेङंन।</para>
  <para style="q1" vid="JHN 12:15">गरःङके नराजा गडाहालो ओज़ा</para>
  <para style="q2" vid="JHN 12:15">चेब्डे राज़्या।”<verse eid="JHN 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16" />आव रोः येसुलो उसिसराई ङाःडेके माबुझिरंये। येसुलो ओमहिमा ओटाव पाना आव रोः येसुलो ओबारेलं सर्सिव ची ओलेव, होसोनो आव येःन येसुलो ओलागिटं नोराई याडोव ची वार्ने नोराई याबुझिव।<verse eid="JHN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17" />येसुये लाजरसलाई खाडरलाम खुल्डे सिवलाम ज्युङडा ओझैज़्याकं येसुसं लेव माहुले मीराई येसुये कडि-कडि येःन ओडोव हो यहुडीरंकाम उरुका मीरंलाई हैयाडोवरं। <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />येसुये ऐटाव चिन्न डाडेनोयो वार्ने याठोयोये पनि माहुले मीराई येसुलाई डैने यानाव। <verse eid="JHN 12:18" /><verse number="19" style="v" sid="JHN 12:19" />होकाम फरिसीरं या-याज़ टोबोये छुटंलाई हैयाडोव, “आबो, जेलेवङाम कडिज़ टाने माले। जेरःङज़्या, प्रिठीबीला स्यान्टै मीरं नोलो उझिन्ट यानाडुरं!”<verse eid="JHN 12:19" /></para>
  <para style="s">कोइ-कोइ ग्रीक मीरं येसुसं याडैसिरिव</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />पर्बटं परमेस्वरलो ओआराढना डाने नानेरं कोइ-कोइरं ग्रीकरं पनि लेवरं। <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />नोरं गालीलला बेठसेडालं फिलिप लेवकं राडे ऐ वार्डे बिन्ती याडोव, “अँ प्रभु, गे येसुसं डैसिने गेवार्ज़्या।”<verse eid="JHN 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 12:22" />फिलिपये नाडे अन्ड्रियासलाई हैओडोव, होकाम अन्ड्रियास सोनो फिलिपनि नाडे येसुलाई हैनेडोव। <verse eid="JHN 12:22" /><verse number="23" style="v" sid="JHN 12:23" />येसुये नोनिलाई जबाफ ओयोवनि, “मानवालो ओज़ालो ओमहिमा टाने बेला केरिडेले। <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />सत्य रोः ङा जेलाई हैङाडाच्यो, पिमालो उढुर नामलं टेःडे मासिखे भने नो टोबोज़ाज़ रहिये। नो यासिखे भने नोये भ्या ओसै झावये। <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" />उज्युलो मया डानेये उजीबन नास झोयोये, उज्युलाई आव प्रिठीबीलं मया माडानेये खर्कज़ मासिने जीबनलो लागिटं चावसं नैेनेले <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" />कोइये ङासेवा याडोव भने नो ङाछिन्ट ओराकं होसोनो ङा जोङ ङाले, ङासेवा डोने मी पनि होङंज़ लेनेले। कोइये ङासेवा याडोव भने बाबुये नोलो ओमान नैड्यानेले।”<verse eid="JHN 12:26" /></para>
  <para style="s">येसुये ओल उसिने बारेलं हैओवारो</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27" />“आबो आव ङायुङ छेडे आटिज़्या, ङा कै वार्ने कै वार्ने ङाटाज़्या, ‘ए बाबु, ङालाई आव समयलाम जोगैसङ ङावार रो?’ माङ्क, आव डुखं डैने वार्डेज़ ङा आव सङसारलं राडेङाले। <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />ए बाबु, नङ नमिनलो ओमहिमा डो।”</para>
  <para style="p" vid="JHN 12:28">होकाम स्वर्गटाम ऐटाव पाङसिज़्याव गा ओठोयो, “ङा नो महिमा डाडेङानै, होकाम फरि डानेङाले।”<verse eid="JHN 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 12:29" />नला लिज़्याव मीराई आव रोः ठैडे ऐयावारो, “आव नम उगर्जिज़्याव ची!” उरुराई हैयावारो, “स्वर्गटा कटंवाल नोसं ओपाङज़्याव ची!”<verse eid="JHN 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30" />येसुये नोरंलाई जबाफ ओयोवरं, “आव गा ङालागिटं ओराव माङ्क, जेलागिटं ची। <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />आबो आव प्रिठीबीलाई निया टानेले। आव प्रिठीबीला सेःर ख्यासिनेले। <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />जो बेलाकं ङा प्रिठीबीलाम ङाछेन्सी, ङा स्यान्टै मीरंलाई ङालेवडे सेःलनेरंङाले।” <verse eid="JHN 12:32" /><verse number="33" style="v" sid="JHN 12:33" />येसु खैटाव टाडे सिने, हो चिन्न यानेरं लागिटं येसुये ऐओवारो।<verse eid="JHN 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34" />माहुले मीराई येसुलाई यापजोयो, “ख्रीस्टके एकसप्ड्याज़ ज्युङडा टानेले वार्ने गे न्यामटाम ठैडेगेनै। नङ कैजैडे हैनवार्डु, मानवालो ओज़ा छेन्सिवज़ परि? आव मानवालो ओज़ा काङ्का?”<verse eid="JHN 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35" />येसुये नोरंलाई हैओडोवरं, “अजं जामा समं ज्योती जेसं लिज़्या। ज्योती जेसं ओलेव समं आडेहोडे बाच्यो, कडालेकं अन्ड्यारोये जेलाई टाकपच्योवकं। कोइ अन्ड्यारोलं याबा भने, नोये ङा कान्डे ङानाज़्या, वार्ने ठा मासोनो। <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" />जोका समं ज्योती जेसं ले ज्योतीलाई बिस्वास डाच्यो, होसोनो जे ज्योतीला मीरं टाच्यो।”</para>
  <para style="s" vid="JHN 12:36">मीराई येसुलाई बिस्वास यामडोव</para>
  <para style="p" vid="JHN 12:36">आढङ ओपाङो पान्त्रा येसु ओनाव होकाम नो मीरासं मोःसिडे ओलेव। <verse eid="JHN 12:36" /><verse number="37" style="v" sid="JHN 12:37" />येसुये नोराई याङाःकं बनै भ्या एटानाव अचम्बला चिन्नरं ओसोटोनो, हैओटानि पनि नोराई येसुलाई बिस्वास माडोरंये। <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />कडालेकं यसैया अगमबक्तालो ओबचन पुरा ओटाव,</para>
  <para style="q1" vid="JHN 12:38">“ए घ्योव प्रभु, गे हैगेडोवरं सोरटं काङ्काये बिस्वास ओडोव ड?</para>
  <para style="q2" vid="JHN 12:38">होसोनो स्यान्टैराई भन्डा घ्योवलो ओपाखुराटा ओसा काङ्कालाई ओसटनो ड?”<note caller="+" style="x"><char style="xo" closed="false">1२:3८ </char><char style="xt" closed="false"><ref loc="ISA 53:1">यसैया ५३:१</ref></char></note><verse eid="JHN 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 12:39" />हैजैडे नोराई बिस्वास माडोरंये, कडालेकं यसैयाये फरि ऐवार्डे ले,<verse eid="JHN 12:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40" />“परमेस्वरये नोराई यामिलङ मारःन्ने झैडे नैड्योवरं,</para>
  <para style="q2" vid="JHN 12:40">होसोनो नोराई यायुङ खाव झैडे नैड्योवरं।</para>
  <para style="q1" vid="JHN 12:40">हैजैडे नोराई यामिलङये टारःङरंकं,</para>
  <para style="q2" vid="JHN 12:40">होसोनो याडिमाकये टाबुझिरंकं,</para>
  <para style="q2" vid="JHN 12:40">मानि नोरं वोल्ने लेरं,</para>
  <para style="q2" vid="JHN 12:40">परमेस्वरये हैवार्डेले होकाम ङा नोरंलाई ससोमो ङाढु।”<verse eid="JHN 12:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 12:41" />यसैयाये आव रोः हैओवारो, कडालेकं नोये येसुलो ओमहिमा ओरोःङो होसोनो येसुलो ओबारेलं हैओवारो।<verse eid="JHN 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42" />हैटानि पनि भ्या यहुडीराई याअगंवाराई येसुलाई बिस्वास याडोव, बुरु फरिसीराई सेवा डोने ज़ीःमलाम पुलैसिरं सै वार्ने याछ्यासैये नो काङ्कालाई पनि हैमाडोरंये। <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />कडालेकं परमेस्वरङाम डैसिव महिमा भन्डा मीरं लेवङाम डैने महिमालाई नोराई भ्या मया डोरंये।<verse eid="JHN 12:43" /></para>
  <para style="s">येसुये एकसप्ड्याज़ निया डोवये</para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />येसुये कस्सिडे किःडे हैओडोवरं, “ङालाई बिस्वास डानेये ङालाईयाज़ माङ्क ङालाई परिःङनेलाई बिस्वास डोवये। <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />जोये ङालाई रःङसोङो होये ङालाई परिःङनेलाई पनि रोःङोये। <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />ङा प्रिठीबीलं ज्योती टाडे ङाराव ची, कडालेकं ङालाई बिस्वास डाने अन्ड्यारोलं टारंहिकं। <verse eid="JHN 12:46" /><verse number="47" style="v" sid="JHN 12:47" />जोये ङापाङ ठैडे पनि मामानिव, ङा नोलो ओनिया ङाम्डो। कडालेकं ङा प्रिठीबीलो ओनिया डाने ङाराव माङ्क, प्रिठीबीलाई जोगैने ङाराव ची। <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />ङालाई मामानिने सोनो ङापाङ माठैनेराई यालागिटं टोबो निया डाने मी ले। ङा ङापाङो बचनयेज़ आखिरला डिनलं नोराई यानिया डानेले। <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />कडालेकं ङा ङाज़ ङापाङज़्याव माङ्कची, ङा कैवार्ने, सोनो कडि पाङने, हो ङालाई परिःङने बाबुये ङालाई आग्या याङोये। <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />ङा ङासंन, बाबुलो ओपाङ खर्कज़ मासिने जीबन ची। हैजैडे ङा जो ङापाङ, बाबुये ङालाई ओयाङो आग्याज़ ङापाङये।”<verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s">येसुये उसिसराई याखङ हुर्डेओयोवरं</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />निस्तार पर्बलो ओङाःडेज़ आव प्रिठीबीलाम भासिडे बाबु लेवडे नाने बेला रा वार्ने येसुये ठा ओसोनो, प्रिठीबीला लिज़्याव उमी भरिरंलाई मया डारंडे येसुये आखिर समंज़ मया ओडोवरं।<verse eid="JHN 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2" />होकाम रिःम्डेका ज़्याव ज़्याने बेलाकं सैतानये सिमोनलो ओज़ा यहुडा इस्करियोतलो उयुङलं येसुलाई सक्योःने बिचार ङाडेकामज़ झाडे ओनैड्योज़्याव। <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />बाबुये स्यान्टै रोः ओल उकुइटं सुम्पिडेनैड्योव, होसोनो ओल परमेस्वरलो ओतराफङामज़ ओराव ची, होसोनो परमेस्वर लेवडेज़ नारिज़्या वार्ने रोः येसुये सन्डे ओनैज़्याव। <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />होकाम येसु ज़्याव ज़्याने पोलाम च्याङसिडे, ओतर्टा ओक्वा पिःडे टोबोकं नैडे टोबो टौल्या ओवाङलं ओमन्ठैसिव। <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />होकाम येसुये पराटलं रीः ओठोरो, होकाम उसिसराई याखङ हुर्ने सुरु ओडोव, होकाम ओवाङलं मन्ठैसिडे उलिज़्याव टौल्याये उसिड्योवरं। <verse eid="JHN 13:5" /><verse number="6" style="v" sid="JHN 13:6" />सिमोन पत्रुस लेवकं येसु ओकेरिकं, नोये येसुलाई हैओडोव, “प्रभु, होकाम नङ ङाखङ नुहुर्रिज़्याव रो?”<verse eid="JHN 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7" />येसुये नोलाई जबाफ ओयोव, “ङा कडि ङाझैज़्या नङ आर्क नमसंन, बुरु नङ छिन्डे बुझिनेनले।”<verse eid="JHN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8" />पत्रुसये येसुलाई हैओडोव, “नङ खर्कज़ ङाखङ हुर्ने माटाये।” येसुये जबाफ ओयोव,</para>
  <para style="p" vid="JHN 13:8">“ङा नखङ ङामहुर्ड्यान्खे भने झिन्डे समं नङ ङासिस नम्टाडु।”<verse eid="JHN 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9" />सिमोन पत्रुसये येसुलाई हैओडोव, “ए प्रभु, ङाखङया मान्त्रा माङ्क, ङाकुइ सोनो ङाङैः पनि हुर्ड्याङ।”<verse eid="JHN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 13:10" />येसुये नोलाई हैओडोव, “हुर्सिव मीलाई ओखङयाज़ हुर्ड्यानि पनि टाये, नो स्यान्टै चोखोज़ ले। जे चोखोज़ जिलिज़्या, हैनि पनि स्यान्टैरंके माङ्क।” <verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />कडालेकं येसुलाई ढोका यानेलाई येसुये सरेःडे ओनैज़्याव। हैजैडे येसुये हैओवार्ज़्याव, “जे स्यान्टै चोखो जेमले।”<verse eid="JHN 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12" />नोराई याखङ हुर्डे खेम्डे ओतर्टा ओक्वा क्वाइसिडे येसु फरि उचुङो। होकाम येसुये नोरंलाई हैओडोवरं, “जे जेसन, ङा जेलागिटं कडि येःन ङाडोव? <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />जे ङालाई ‘गुर सोनो प्रभु’ जेडाङये, नो जे ठीकंज़ हैजेवार्ज़्या, कडालेकं ङा होज़।” <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />ङा जिगुरबा सोनो जेप्रभु टाडे पनि जेखङ ङाहुर्ज़्या जे पनि टोबोये छुटंलाई ओखङ हुर्ड्याच्यो, <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />कडालेकं ङा जेलाई टोबो येःन डाडे पैडे ङानैच्यो, होकाम ङा जोस्याव जेलागिटं ङाडोव, जे पनि हैटावज़ डाच्यो। <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" />सत्य रोः ङा जेलाई हैङाडाच्यो, नौकर ओसाहु भन्डा घ्योव माटाये, होसोनो सोर सठैने सोर परिःङने भन्डा घ्योव माटाये। <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />होकाम जे आव रोः जेसनखे भने सोनो नो जेडोखेभने, जे बनै चाव येःन डाने मीरं टानेजेले।<verse eid="JHN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18" />“ङा जे स्यान्टैराई जेबारेलं हैङावार्ज़्याव माङ्क, ङा जोलाई रुजिडेङानै होलाई ङा ङासरे। बुरु सास्त्रता रोः पुरा गटाकं वार्डे आव ओटाव, ‘ङाबरे ज़्यानेयज़ ङालाई लाटैये उठिन्सोङो।’ <verse eid="JHN 13:18" /><verse number="19" style="v" sid="JHN 13:19" />आव टाने भन्डा ङाःडे आर्कज़ ङा जेलाई हैङाडाच्यो, कडालेकं नो ओटारिकं ङा होज़ वार्डे जेलाई बिस्वास गलागिकं। <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" />डस्साज़ ङा जेलाई हैङाडाच्यो, ‘जोलाई ङा ङापरिःङज़्या, होलाई ग्रहन डानेये ङालाई पनि ग्रहन डानेले, होसोनो ङालाई ग्रहन डानेये ङालाई परिःङनेलाई पनि ग्रहन डोवये।’”<verse eid="JHN 13:20" /></para>
  <para style="s">येसु ओल ओक्योसिने बारेलं भबिस्यबानी</para>
  <para style="r">
    <ref loc="MAT 26:20-25">मत्ती २६:२०-२५</ref>; <ref loc="MRK 14:17-21">मर्कुस १४:१७-२१</ref>; <ref loc="LUK 21:21-23">लुका २१:२१-२३</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />आव रोः हैओवारो मान्त्रा येसु ओआत्मालं बनै डुखि टाडे सोनो गोहाइ याडे हैओवारो, “डस्साज़ ङा जेलाई हैङाडाच्यो, जेकाम टोबोये ङालाई सोक्योःनेले।”<verse eid="JHN 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22" />येसुये काङ्कालो ओबारेलं हैओवार्ज़्याव वार्डे सङ्खा डाडे उसिसराई या-याज़ यारःङसिव। <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />येसुलो उसिसरंकाम येसुये मया ओडोज़्याव उसिस येसुलो ओछ्योकं अडैसिडे चुङडे उलिज़्याव। <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />होकाम सिमोन पत्रुसये नोलाई साहान डाडे ओपजोयो, “येसुये आव काङ्कालो ओबारेलं हैओवार्ज़्याव येसुलाई पजै?”<verse eid="JHN 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25" />येसुलो ओछातीटं ऐजैडे अडैसिडेज़ नोये येसुलाई ओपजोयो, “प्रभु, हो काङ्का?”<verse eid="JHN 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26" />येसुये जबाफ ओयोव, “जोलाई ङा बरेलो उकुत्रा छोयेडे ङायो, नो होज़।” होकाम येसुये बरेलो उकुत्रा ओछोयो होकाम नो सिमोनलो ओज़ा यहुडा इस्करियोतलाई ओयोव। <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />बरेलो उकुत्रा ओज़्योव पाना सैतान नो लेवटं ओनाव। होकाम येसुये नोलाई हैओडोव, “नङलाई जो डोने लिज़्या, हो चानोज़ गोडोके।” <verse eid="JHN 13:27" /><verse number="28" style="v" sid="JHN 13:28" />येसुये नोलाई कडाने ऐओडोव वार्डे ज़्याव ज़्याने चुङोराई काङ्काये पनि माबुझिरंये। <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />कडालेकं कोइ-कोइराई ऐटाव यासुन्चीव, यहुडासं पैसा नैने ठैली लिज़्या, हैजैडे येसुये नोलाई पर्बटा चाहिने सामान गलोङोकं, सै नोये गरिबरंलाई टिगिडा योरं हैओडोज़्याव वार्ने याबुझिव।<verse eid="JHN 13:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 13:30" />होकाम बरेलो उकुत्रा ओज़्योव पाना यहुडा इस्करियोत होपानाज़ पाखाडे उपुलुव। नो बेलाकं रि टाडे उलिज़्याव।<verse eid="JHN 13:30" /></para>
  <para style="s">साःरौ आग्या</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />होकाम नो पाखाडे ओनाव पाना येसुये हैओवारो, “आबो मानवालो ओज़ालो ओमहिमा टाडेले, होसोनो परमेस्वर नोलेवटं महिमीत टाडे ले। <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" />परमेस्वर मानवालो ओज़ाटं महिमा डैडे यानोयो खे भने परमेस्वरये ओल्सज़ नोलाई महिमीत झैनेले, होकाम परमेस्वरये आव येःन चानोज़ डोनेले।” <verse eid="JHN 13:32" /><verse number="33" style="v" sid="JHN 13:33" />“ए ङाबाल्खरं, टडेसयाज़ ङा जेसं ङालिज़्या! जे आबो ङालाई खिम्नेजेले, होसोनो यहुडीरंलाई ङा हैङाडोवरं मान्टि, आबो जेलाई पनि हैङाडाच्यो, ‘जोङ ङा ङानाज़्या, जे जेमराडु।’ <verse eid="JHN 13:33" /><verse number="34" style="v" sid="JHN 13:34" />टोबो साःरौ आग्या ङा जेलाई ङायाच्यो जे टोबोये छुटंलाई मया डाच्यो। जेलाई ङा जोस्यानाव मया ङाडाच्योज़्या, टोबोये छुटंलाई पनि हैटाव मयाज़ डाच्यो। <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />होकाम जे टोबोये छुटंलाई मया जेडाखे भने, आवटाम ज़ स्यान्टैये सन्नेलेरं, जे ङासिसरंज़।”<verse eid="JHN 13:35" /></para>
  <para style="s">पत्रुसये स्वीकार माडाने बारेलं येसुलो ओभबिस्यबानी</para>
  <para style="r">
    <ref loc="MAT 26:31-35">मत्ती २६:३१-३५</ref>; <ref loc="MRK 14:27-31">मर्कुस १४:२७-३१</ref>; <ref loc="LUK 21:31-34">लुका २१:३१-३४</ref></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />सिमोन पत्रुसये येसुलाई हैओडोव, “ए प्रभु नङ कान्डे नारिज़्याव?”</para>
  <para style="p" vid="JHN 13:36">येसुये जबाफ ओयोव, “ङा जोङ ङानारिज़्या, नङ आर्क ङाछिन्ट नमराडु, बुरु झिन्डेके नङ ङाछिन्टज़ रानेनले।”<verse eid="JHN 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37" />पत्रुसये येसुलाई हैओडोव, “प्रभु, ङा आर्कज़ कडा नछिन्ट ङामराडु? नलागिटं ङा ङाज्यु पनि झाने ङाले।”<verse eid="JHN 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38" />येसुये जबाफ ओयोव, “होकाम नङ ङालागिटं नज्यु पनि नजा? डस्साज़ ङा नङलाई हैङाडान, नङ ङालाई सोङखेप नोलाई ङासरेः वार्डे हैनमवार्या समं भाले कोँने माले।”<verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s">येसु बाबु लेवडे नाने येम</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />“जे जियुङ हरेस टासटेच्यो। जे परमेस्वरलाई बिस्वास जेडाये, ङालाई पनि बिस्वास डाङच्यो। <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />ङाबाबुलो उज़ीःमङ मी लेने पो बनै भ्या ले। हैटाव भ्या पो ओम्लेखिन, ङा जेलाई हैङामडाच्यो हो, ङा जेलागिटं पो तयार झैने ङानारिज़्या। <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />होकाम नाडे ङा जेलागिटं पो तयार ङाजोयोपाना ङा फरि रानेङाले, होकाम जेलाई ङासं लाङनेङाले, होसोनो ङा जोङ ङाले, जे पनि होङ लेनेजेले। <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />जोङ ङा ङानारिज़्या, जे होङ नाने येम जेसनये।”<verse eid="JHN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5" />ठोमाये येसुलाई हैओडोव, “ए प्रभु, नङ कान्डे ननारिज़्याव, गे गेम्सन, होकाम गे कैजैडे येम गेटंकं?”<verse eid="JHN 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6" />येसुये नोलाई हैओडोव, “सत्य, येम सोनो जीबन ङाज़ ची। काङ्का पनि उरु काङाम बाबु लेवकं माराडु। <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />जे ङालाई जेसरेसङखिन्के, ङाबाबुलाई पनि सरेने जेलेव। आबोकाम के ङाबाबुलाई पनि जेसरे, होसोनो होलाई पनि रःङडेजेनै।”<verse eid="JHN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8" />फिलिपये येसुलाई हैओडोव, “ए प्रभु, गेलाई बाबु सटन्ड्यासि। आडङ ओटाखिन्के गेलाई टा।”<verse eid="JHN 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9" />येसुये नोलाई हैओडोव, “फिलिप, भ्या डिन समं ङा जेसं ङालिज़्या, होटानि पनि नङ ङालाई नमसरेसङये? जोये ङालाई रःङडेनैसोङो, होये बाबुलाई पनि रःङडे नोयो। नङ कैजैडे हैनवार्ज़्याव, ‘गेलाई बाबु सटन्ड्यासि वार्डे?’ <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />ङा बाबुसं ङाले होसोनो बाबु ङासं ले बाबु सोनो ङा टोबोज़ वार्डे नङ कडा बिस्वास नम्डो? जो रोः ङा जेलाई हैङाडाच्यो, नो ङाअडिकारये ङापाङज़्याव माङ्क बुरु ङासं बास डोज़्याव बाबुये ओयेःन डोवये। <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />ङा बाबुसं ङाले, होसोनो बाबु ङासं ले वार्डे ङापाङो रोःटं बिस्वास डाङच्यो। है ओमटानि पनि आव ङा ङाडोव येःनरं रःङडे बिस्वास डाच्यो।”<verse eid="JHN 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 14:12" />“डस्साज़, ङा जेलाई हैङाडाच्यो, जोये ङालाई बिस्वास डाङो, होये ङाडोव येःन पनि डानेले, होसोनो नो भन्डा घ्योव येःन पनि डानेले, कडालेकं ङा बाबु लेवडे ङानारिज़्या। <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />जे ङामिनङाम जोज़ जिनिःनि पनि ङा ङाडोव येःनटाम बाबुलो ओमहिमा गटाकं वार्डे ङा ओज़ाये नो डानेङाले। <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />जे ङामिनङाम जो बस्त जिनिःनि पनि ङा नो डाड्यानेङाले।”<verse eid="JHN 14:14" /></para>
  <para style="s">चोखो आत्मालो कबंल</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />जे ङालाई मया जेडाङखे भने ङाआग्यारं मानिनेजेले। <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />होकाम ङा बाबुसं बिन्ती डानेङाले, होकाम बाबुये जेलाई गैने टोबो छुटंलाई परिःङनेले, होसोनो नो जेसं एकसप्ड्याज़ लेने ले। <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />आव सत्यला आत्मा ची, जोलाई प्रिठीबीये ग्रहन माडोडुव, कडालेकं प्रिठीबीये नोलाई न रोःङो न सरेवये। जे नोलाई जेसरेये, कडालेकं नो जेसं बास डोवये, होसोनो नो जियुङलं बास डानेले।<verse eid="JHN 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 14:18" />“ङा जेलाई टुहुरा राःने ङाम्ले। ङा जे लेवकं रानेङाले। <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />आबो जामाका प्रिठीबीये ङालाई रःङने माले, हैटानि पनि जे ङालाई रःङनेजेले। ङा ज्युङडा ङालेवये, जे पनि ज्युङडा लेनेजेले। <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />नो छ्याम जे सन्नेजेले, ङा ङाबाबुसं, जे ङासं, होसोनो ङा जेसं ङालिज़्या गे टोबोरंज़।<verse eid="JHN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 14:21" />ङालाई मया डाने नोज़ जोसं ङाआग्या लिज़्या होकाम नोये नो मानिवये। होसोनो ङालाई मया डानेलाई ङाबाबुये मया डोवये। ङा नोलाई मया डानेङाले, होसोनो ङा ङालाईज़ नो लेवकं सतन्नेङाले।”<verse eid="JHN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22" />यहुडा इस्करियोत के माङ्क छुटं यहुडाये येसुलाई हैओडोव, “प्रभु, नङ कैनवार्ज़्याव, नङ नङलाईज़ गेलेवटं नसंटन, होसोनो प्रिठीबीलाई के माङ्क?”<verse eid="JHN 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23" />येसुये नोलाई जबाफ याडे हैओडोव, “जोये ङालाई मया डाङो, नोये ङाबचन पनि मानिनेले, होसोनो ङाबाबुये नोलाई मया डानेले, होकाम गे नो लेवकं राने गेले, होसोनो नोसं बासिनेगेले। <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />ङालाई मया माडानेये ङाबचन पनि मामानिवये। जो बचन जे जेठैज़्या, नो ङाबचन माङ्क, नो ङालाई परिःङने ङाबाबुलो ची।”<verse eid="JHN 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25" />“आव रोः ङा जेसं ङालिज़्याकंज़ ङा जेलाई हैङाडाच्यो। <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />गैने चोखो आत्मा, जोलाई बाबुये ङामिनङाम परिःङनेले, नोये जेलाई स्यान्टै रोः पैनेले, होसोनो ङा जेलाई हैङाडाच्योव स्यान्टै रोः जेलाई सम्झैनेले।<verse eid="JHN 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 14:27" />सान्ति ङा जेसं ङाख्यानै। ङा ङासान्ति जेलाई ङायाच्यो। प्रिठीबीये ओयाच्योव स्याव ङा जेलाई ङामयाच्योव। जियुङ डुखि टाटाकं होसोनो टाछेच्यो।” <verse eid="JHN 14:27" /><verse number="28" style="v" sid="JHN 14:28" />“ङा आलाम ‘ङानारिज़्या, होकाम फरि जेलेवकं वोल्डे जेलेवकं रानेङाले’ वार्डे हैङावारो रोः के जे ठैडेज़ जेनै। जे ङालाई मया जेडाङो टावसं ङाबाबु लेवकं ङानारिज़्या ङावार्ज़्याव ठैडे जे जेरेङखे हो, कडालेकं बाबु ङा भन्डा घ्योव ले। <verse eid="JHN 14:28" /><verse number="29" style="v" sid="JHN 14:29" />आबो आव टाने भन्डा ङाडेज़ ङा जेलाई हैडाडे ङानैच्योव, जोकं आव टा जे बिस्वास डाच्यो। <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" />आबो ङा जेसं भ्या पाङने ङाम्ले, कडालेकं आव प्रिठीबीला सासंक रारिज़्या। ङालाई नोलो ओसक्तिये कैज़ माजैसङढुव। <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />हैटानि पनि ङा बाबुलाई मया ङाडोये, बाबुये ङालाई जोस्याव अरैडे नैसोङो होस्याव ङाडो वार्डे प्रिठीबीये ओसोनोकं।</para>
  <para style="p" vid="JHN 14:31">गच्याङसिच्योके गे आलाम गेनाके।”<verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s">येसु असली अङ्गुरलो ओलंरा</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />सड्डेका अङ्गुरलो ओलंरा ङाज़ ची, ङाबाबुके किसान ची। <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />ङासं लेने स्यान्टै हाङ्गारं जोये ओसै माजाव होलाई बाबुये पोलोये होसोनो ओसै झाने स्यान्टै हाङ्गारंलाई झन भ्या गसैरंकं वार्डे बाबुये चावसं छान्टिवये। <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />ङा जेलाई हैङाडाच्योव बचनये जे ङाडेज़ चोखो टाडे जेले। <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />ङासं टोबोटं लेच्यो, ङा जेसं टोबोटं लेनेङाले। जो स्याव अङ्गुरलो ओहाङ्गा उसिङटं मालेखे भने नो ओहाङ्गाये ओबाठङ ओसै माजाडुव, हो मान्टिज़ जे पनि ङासं जेमलेखे भने जे पनि जेसै जेमजाडु।<verse eid="JHN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5" />“अङ्गुरलो मुल ओलंरा ङाज़ ची, जे के ओहाङ्गारं ची। कोइ ङासं टोबोटं याले भने, होसोनो ङा नोसं टोबोटं ङालेखे भने, नोये भ्या ओसै ससैने ले, कडावार्क ङाकाम भासिडे जे कडि पनि जेमझैडु। <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />कोइ मी ङासं टोबोटं मालेखे भने, हो नो हाङ्गा मान्टि टाने ले जो पाखाडे मिल्कैसिने ले, होकाम नो ठङ्ये। एटानाव हाङ्गारंलाई मीराई डुपरंये होकाम मेःल ख्यारंये, होकाम नो चाङडे खेम्ये। <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />जे ङासं जेलेखे भने, होसोनो ङापाङो रोःरं जेसं यालेखे भने, जेलाई जो जेइछ्या लागि निःच्यो, होकाम नो जेलागिटं टानेले। <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" />जे भ्या सै सैडे ङासिसरं ची वार्ने प्रमान जेजैखे भने आवटंज़ ङा ङाबाबुलो ओमहिमा टाने ले।”<verse eid="JHN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 15:9" />“बाबुये जोस्याव ङालाई मया डाङोये, ङा पनि जेलाई मया ङाडाच्यो। जे ङामयाटं लेच्यो। <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />होकाम ङाआग्या जेमानिखे भने जे ङामयाटं लेनेजेले, जोस्याव ङा ङाबाबुलो ओआग्या ङामानिज़्या होसोनो ङाबाबुलो ओमयाटंज़ ङालिज़्या। <verse eid="JHN 15:10" /><verse number="11" style="v" sid="JHN 15:11" />ङा आव रोः जेलाई आव कारनये हैङाडाच्योज़्या, ङा ङाआनन्ड जेसं ओलेकं, होकाम जे जेआनन्ड पुरा ओटाकं।”<verse eid="JHN 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 15:12" />“ङाआग्या आवज़, ङा जेलाई जोस्याव मया ङाडाच्योव, जे पनि जे-जेज़ होस्याव मया डासिच्यो। <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" />ओनैराई यालागिटं उज्यु सुम्पिने भन्डा घ्योव मया उरु काङ्कालोज़ माटाये। <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" />ङा जेलाई जो आग्या ङायाच्यो, नो जे जेमानिखे भने, जे ङा ङानैरं ची। <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />आबोकाम ङा जेलाई नौकर ङाम्डाच्यो, कडालेकं नोलो ओसाहुये कडि डोव नौकरये मासोनोये। ङा के जेलाई ङानैरं ङाडाच्योज़्या, कडालेकं जो ङा ङाबाबु लेवङाम ङाठोयो, नो स्यान्टै जेलाई हैडाडे ङानैच्योव। <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" />ङालाई जे जेरुजिसोङो माङ्कची, ङा जेलाई ङारुजिच्योव ची होकाम जेलाई ङा ङारुजिच्योव, होकाम जे नाडे बनै भ्या सैच्यो, होकाम जेसं नो जेसै एकसप्ड्याज़ ओलेकं हैजैडे जे बाबुसं ङामिनङाम जो जिनिः बाबुये जेलाई हो यानेले। <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />ङा जेलाई आव आग्या ङायाच्योज़्या, टोबोये छुटंलाई मया डासिच्यो।”<verse eid="JHN 15:17" /></para>
  <para style="s">प्रिठीबीलो हेला</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />“प्रिठीबीये जेलाई याघिनैच्योव भने, जे ठा सन्च्यो, जेलाई घिनैने भन्डा ङाडे नोये ङालाई घिनैडेनैसोङो। <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />जे आव प्रिठीबीलारं जेटाखिन्के प्रिठीबीला मीराई जेलाई आपना मानिडे मया डाने यालेव। जे आव प्रिठीबीलारं माङ्कची। जेलाई प्रिठीबीलाम ङा ङारुजिच्योव ची, हैजैडे प्रिठीबीला लेने मीराई जेलाई घिनैच्योरंये। <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" />ङा जेलाई हैङाडाच्योव बचन चेटैच्यो, ‘नौकर ज़ीःमला साहु भन्डा घ्योव माटाये।’ नोराई ङालाईज़ सहटैसङज़्यारं भने जेलाई पनि सटैनेज़ लेरं होकाम नोराई ङासिछ्या यामानिरंखे भने जेसिछ्या पनि मानिने लेरं। <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />बुरु आव स्यान्टै नोराई ङामिनलो ओकारनये जेलाई डानेलेरं, कडालेकं नोराई ङालाई परिःङनेलाई मासरेरंये।”<verse eid="JHN 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 15:22" />ङा ङामराखिन सोनो नोरंलाई हैमाडोरंखिन के नोरं पापलो डोसि माटाने यालेव, आबोके यापापलो लागिटं नोरंलाई कडि बाहानाज़ माले। <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" />जोये ङालाई घिनैसोङो, होये ङाबाबुलाई पनि घिनोयोये। <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />ङा जो येःन ङाडोव हो नोराई यारःङखिन्के नोरं पापलो डोस मालागिने ओलेव बुरु नोराई ङालाई सोनो ङाबाबुलाई घिनैसिरंये। आबो नोराई ङालाई सोनो ङाबाबुलाई नेबऱ्याङलाईज़ रःङडे नैसिरं होसोनो घिनैडेनैसिरं। <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />न्यामटा सर्सिव आव बचन पुरा टानेलो लागिटं आव ओटाव, “नोराई ङालाई सोझोज़ याघिनैसोङो।”<verse eid="JHN 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26" />“ङा बाबुलो ओतराफङाम जेलाई गगैच्योवकं वार्डे सत्यला आत्मा जेलेवकं परिःङनेङाले, होकाम नोयेज़ ङा ङाबारेलं गोहाइ यानेले। <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />जे सुरुकामज़ ङासं जेलेवये, जे पनि ङासाचीरंज़।”<verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1" />जे जिबिस्वास टाघटिकं वार्डेज़ ङा आव रोः जेलाई हैङाडाच्योज़्याव ची। <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />नोराई जेलाई यहुडीरं याडुप्सिने ज़ीःमलाम पुलैने लेरं। डस्साज़ एटाव समय रारिज़्या, जेलाई सैःनेये परमेस्वरलो ओसेवा ङाडोज़्या वार्डे सुन्चीने ले। <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />नोराई आव येःन डानेलेरं, कडालेकं नोराई बाबुलाई यासरेव माले, होसोनो ङालाई पनि मासरेसङरंये। <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />आव रोः ङा जेलाई हैङाडाच्योव, जोकं नो समय रा, होकं जेलाई कैङाडाच्योव हो जे चेटैने जेले।</para>
  <para style="s" vid="JHN 16:4">चोखो आत्मालो ओयेःन</para>
  <para style="p" vid="JHN 16:4">ङाःडे जेलाई आव रोः हैङाम्डाच्योये, कडालेकं हो बेलाकं ङा जेसंज़ ङालेव। <verse eid="JHN 16:4" /><verse number="5" style="v" sid="JHN 16:5" />“आबो ङा ङालाई परिःङने लेवडे ङानारिज़्या, ‘नङ कान्डे ननारिज़्याव?’ वार्डे जे काङ्काये पनि ङालाई जेमपजैसङये। <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />होटानि पनि ङा जेलाई आव रोः हैङाडाच्योव कारनये जे जियुङ सोगोये ब्यालडे ले। <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />होटानि पनि ङा जेलाई सत्य रोः हैङाडाच्यो, ङा ङानावज़ जेलाई फाइडा टानेले। कडालेकं ङा ङाम्नाखे भने, जेलाई गैने जेलेवकं राने माले। ङानाखे भने ङा नोलाई जेलेवकं परिःङने ङाले। <verse eid="JHN 16:7" /><verse number="8" style="v" sid="JHN 16:8" />जोकं नो रा, नोये प्रिठीबीला मीरंलाई पापलो ओबारेलं, सत्यलो ओबारेलं होसोनो परमेस्वरये ओडोने नियालो ओबारेलं नोरं गलत लेरं वार्डे प्रमान यानेले। <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />नोरं पापलो ओबारेलं गलत लेरं कडालेकं नोराई ङालाई बिस्वास माडाङरंये, <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />नोये परमेस्वरलो ओङाःकं कडि रोः सत्यले नोज़ सटोनोये, कडालेकं ङा बाबु लेवकं ङाना, होकाम फरि जे ङालाई खर्क पनि रःङने जेमले। <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />होसोनो परमेस्वरलो उनियालो ओबारेलं, कडालेकं आव प्रिठीबीला सेःरलाई सजै याने टाडेले।”<verse eid="JHN 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12" />“ङा जेलाई हैडाने रोः अजं भ्याज़ लिज़्या, आर्क जे नो रोः जेमसहिडु। <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" />जोकं नो सत्यलो आत्मा रानेले, होकं नोये जेलाई स्यान्टै सत्यलं बैने ले। नो ओल उयुङलाम पाङने माले। नोये जो ठोयो, हो जेलाई हैडाने ले, होसोनो टारिने रोःरं जेलाई हैडाने ले। <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />ङा हैङावारो रोःरं जेलाई हैडाडे नोये ङामहिमा डाने ले। <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />बाबुसं लिज़्याव भरि स्यान्टै ङामीज़। हैजैडे ङा हैङावार्ज़्याव, जो ङासं लेव रोःर हो ङालेवङाम रैडे सत्यला आत्माये जेलाई हैडानेले।”<verse eid="JHN 16:15" /></para>
  <para style="s">डुखं सोनो सुखं</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16" />“जामाका जे ङालाई रःङने जेमले, होकाम जामाका ङालाई फरि रःङने जेले।”<verse eid="JHN 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17" />होकाम येसुलो कोइ-कोइ उसिसराई या-याज़ हैयावारो, “येसुये गेलाई आव कै ओडासिज़्याव? ‘जामाका जे ङालाई रःङने जेमले, होकाम फरि जामाका जे ङालाई रःङने जेले,’ कडालेकं ‘ङा बाबु लेवडे ङानारिज़्या।’” <verse eid="JHN 16:17" /><verse number="18" style="v" sid="JHN 16:18" />नोराई हैयावारो, “येसुये ‘जामाका’ ओवारो कडि? गे गेम्सन, येसुये कैओवार्ज्याव।”<verse eid="JHN 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19" />नोराई येसुलाई पजैने युङ डोज़्यारं वार्ने रोः येसुलाई ठा ओटाव, होकाम येसुये हैओवारो, “‘जामाका जे ङालाई रःङने जेमले, होसोनो जामाका ङालाई रःङनेजेले’ वार्ने रोःलो ओमाने कडि वार्ने बारेलं जे कडि रोः छलफल जेडोज़्याव? <verse eid="JHN 16:19" /><verse number="20" style="v" sid="JHN 16:20" />डस्साज़, ङा जेलाई हैङाडाच्यो, जे घर्ने सोनो जेसोगो हाइने जेले, हैटानि पनि प्रिठीबी रेङनेले। जे जेसोगो हाइने जेले, होकाम जेसोगो रेङनेलं फेरैसिने ले। <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />बाल्ख जर्मैने बेलाकं मेमालाई बनै डुखं टाये कडालेकं नोलो ओबेला राव टाये, हैटानि पनि नोये बाल्ख जर्मोयोये, होकाम नोये नो डुखंलाई माचेटोयोये कडालेकं प्रिठीबीलं टोबो बाल्खलो ओजर्म ओटाव वार्ने रोःये नो बनै रेङये। <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />होमान्टिज़ आर्क जेलाई सोगो लागि, ङा फरि जेलाई रःङने ङाले, होसोनो जियुङ बनै आनन्ड टानेले। काङ्काये पनि जेआनन्ड जे लेवकाम नान्ने माले।<verse eid="JHN 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 16:23" />नो छ्याम जे ङालाई कडिज़ पजैने जेमले। डस्साज़ ङा जेलाई हैङाडाच्यो, जे ङामिनङाम बाबुसं जो जिनिः, होये नो जेलाई यानेले। <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />आर्क समं जे ङामिनङाम कडिज़ झिनिःव माले। निःच्यो, होकाम जे डैने जेले। हैजैडे जे जेआनन्ड पुरा ओटाकं।”<verse eid="JHN 16:24" /></para>
  <para style="s">प्रिठीबी तर्ट झ्याङने</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />“आव रोः ङा जेलाई उखानङाम हैडाडे ङानैच्यो। बुरु समय रारिज़्या, आबो ङा जेसं फरि उखानङाम पाङनेङाम्ले, बाबुलो ओबारेलं जेलाई प्रस्टज़ हैङाडाच्यो। <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />नो छ्याम जेज़ ङामिनङाम बाबुसं निःने जेले। ङा जेलागिटं बाबुसं बिन्ती डाड्यानेङाले वार्डे जेलाई हैङामडाच्यो, <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />कडालेकं बाबुये ओल्ज़ जेलाई मया डाच्योव, कडावार्क जे ङालाई मया डाडे जेनैसङ, होसोनो ङा परमेस्वरङाम ङाराव वार्डे बिस्वास डाडेजेनैसङ। <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />ङा बाबु लेवङाम प्रिठीबीलं राडे ङाले, होकाम प्रिठीबीलाई राःडे ङा फरि बाबु लेवडे ङानारिज़्या।”<verse eid="JHN 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29" />उसिसराई हैयावारो, “आबो नङ प्रस्टज़ नपाङज़्या, उखानङाम माङ्क। <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />आबो गे गिबुझिखे, नङ स्यान्टै रोःज़ नसनये, नङलाई काङ्काये पजोयो परिने माले। हैजैडे गे बिस्वास गेडा, नङ परमेस्वरङाम नराव ज़।”<verse eid="JHN 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31" />येसुये नोरंलाई जबाफ ओयोवरं, “कडा जे आबो बिस्वास जेडा? <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />रःङच्यो, समय रारिज़्या, डस्साज़ राडे ले, जे चित्राङ पुत्राङ टाडे जेपोडे ज़ नाने जेले होकाम ङालाई ङाबाठङ राःने जेलेसङ। होटानि पनि ङा ङाबाठङ ङाम्ले, कडालेकं बाबु ङासं लिज़्या। <verse eid="JHN 16:32" /><verse number="33" style="v" sid="JHN 16:33" />ङा जेलाई आव रोः आव कारनये हैङाडाच्योज़्या, ङा लेवकं जेलाई सान्ति ओटाकं। प्रिठीबीलं जेलाई आफट बिफट राने ले, हिक्मत डाच्यो, ङा प्रिठीबीलाई हारैडे ङानै।”<verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s">उसिसराई यालागिटं येसुलो ओप्रार्ठना</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />आव रोः हैवार्डे ओखेमो पाना येसुये स्वर्गडे रःङडे हैओवारो, “ए बाबु, समय केरिडे ले, नज़ालो ओमहिमा ओटाकं, होसोनो नज़ाये नमहिमा ओसोटोनोकं। <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />नङ नज़ालाई स्यान्टै मीराई याक्याङ तर्ट अडिकार याडे ननै, कडालेकं नङ नयोव खर्कज़ माखेम्ने जीबन स्यान्टै मीरंलाई ओयोडुवरंकं वार्डे। <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />आबो खर्कज़ मासिने जीबन आवज़, नोराई नङ, टोबोज़ाज़ सत्य परमेस्वरलाई ओसरेःसनरंकं, होसोनो नङ नपरिःङो येसु ख्रीस्टलाई गसरेरंकं। <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />जो येःन नङ ङालाई नयाङो, नो पुरा झैडे ङा नङलाई प्रिठीबीलं नमहिमा टाने झैडेङानै। <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />आबो ए बाबु, प्रिठीबी उसिर्जिने भन्डा ङाडे नङाःकं ङा जो ङामहिमा लेव, हैजैडे हो महिमा ङालाई याङ।”<verse eid="JHN 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6" />“प्रिठीबीलाम जो मीरं ङालाई नयाङोरं, नोरंलाई ङा नमिन सटन्डे ङानैड्योरं। नोरं नमीरंज़, नोरंलाई नङ ङालाई नयाङोरं, होकाम नोराई नबचन ठैज़्यारं। <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />होकाम नोराई नङ ङालाई नयाङो स्यान्टै रोः नङ लेवङाम राव ची वार्डे याबुझिव। <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />कडालेकं जो बचन नङ ङालाई नयाङो, ङा नोरंलाई याडेङानैरं, होकाम नोराई नो ग्रहन डाडे नैरं। ङा नङ लेवङाम ङाराव ची वार्ने नोराई डस्साज़ सन्डेनैरं, होसोनो नङ ङालाई नपरिःङसोङो ची वार्डे नोराई बिस्वास डाडेनैरं।<verse eid="JHN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 17:9" />ङा नोराई यालागिटं बिन्ती प्रार्ठना ङाडोये, प्रिठीबीलो ओलागिटं ङा बिन्ती प्रार्ठना ङाम्डो, हैनि पनि नोराई यालागिटं, जोरंलाई नङ ङालाई याडे ननैसङ। कडालेकं नोरं नङ नमीरंज़। <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />ङा लेवकं स्यान्टै जो लिज़्या नमीज़, होसोनो नङसं जो लिज़्या ङामीज़। ङा ङामहिमा नोरं लेवटं रःन्डेले।” <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />“ङा नङ लेवङ ङारारिज़्या। आबो ङा प्रिठीबीलं भ्या समय समं लेनेङामले। हैनि पनि नो मीरंके प्रिठीबीलंज़ लेनेलेरं। ए चोखो बाबु, नोरंलाई चावसं जोगैरं। नोरंलाई नमिनलो ओसक्तिये चावसं नैरं जो मिन ङालाई याडे ननैसङ, नङ सोनो ङा टोबो गेटाव मान्टिज़ नोरं पनि टोबोज़ टानेलेरं। <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" />जोका समं ङा नोरासं ङालेव, नङ ङालाई नयाङो नमिनङाम नोरंलाई ङाजोगोयोरं। नोरंमढ्येलाम बिनासलो ओज़ा बाहेक उरु काङ्का पनि नास माटारंये, कडावार्क सास्त्र पुरा टाव परिने लेव।”<verse eid="JHN 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 17:13" />“आबो ङा नङ लेवङ ङारारिज़्या, ङा प्रिठीबीलं ङालेकं आव रोः ङा ङापाङये, ङा ङाआनन्ड नोराई यायुङलं स्यान्टै किसिमये पुरा ओटाकं। <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />ङा नोरंलाई नपोयो बचन ङायोवरं, प्रिठीबीये नोरंलाई उघिनोयोरं कडावार्क नोरं ङा मान्टि प्रिठीबीलारं माङ्करं ची। <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" />नङ नोरंलाई प्रिठीबीलाम लाङरं वार्डे ङा बिन्ती प्रार्ठना ङामडो, नोरंलाई डुस्टङाम चावसं नैरं। <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />नोरं प्रिठीबीलारं माङ्करं ची, जो स्याव ङा पनि प्रिठीबीला माङ्क। <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" />नोरंलाई सत्यलं चोखो झैरं, नबचन सत्य ची। <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />जो स्याव नङ ङालाई प्रिठीबीलं नपरिःङसोङो, ङा पनि नोरंलाई प्रिठीबीलं परिःङडेङानैरं। <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />नोराई यालागिटं ङा ङालाईज़ चोखो ङाजैज़्या, कडालेकं नोरं पनि सत्यलं चोखो गटारंकं।”<verse eid="JHN 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20" />“ङा आवराई यालागिटंया मान्त्रा बिन्ती ङाम्डो, आवराई यालाङो सोर ठैडे ङालाई बिस्वास डानेराई यालागिटं पनि बिन्ती ङाडो, <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" />कडालेकं नोरं स्यान्टै टोबो गटारंकं। ए बाबु, जोस्याव नङ ङासं नलिज़्या, होसोनो ङा नङसं, हैजैडे नोरं पनि गेलेवडे गटारंकं, होसोनो नङ ङालाई नपरिःङसोङो वार्डे प्रिठीबीये बिस्वास गोडोवकं। <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />जो महिमा नङ ङालाई नयाङो, ङा नोरंलाई याडे ङानैरं कडावार्क गे टोबो गेटाव मान्टि नोरं पनि टोबो गटारंकं। <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />ङा नोरासं, नङ ङासं, होकाम नोरं पुराज़ टोबो ओटारंकं, होसोनो नङ ङालाई नपरिःङसोङो ची, ङालाई मया नडाङो स्याव नङ नोरंलाई पनि मया नडोवरंज़ वार्डे प्रिठीबीये ओसोनोकं।”<verse eid="JHN 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 17:24" />“बाबु, ङा इछ्या ङाडो, नङ ङालाई नयाङो मीरं ङा जोङ ङाले ङासंज़ ओलेरंकं, होसोनो ङामहिमा ओरःङरंकं, जो महिमा, प्रिठीबी उसिर्जिव भन्डा ङाःडेकाम ज़ ङालाई मया नडाङो कारनये नङ ङालाई नयाङो ची।”<verse eid="JHN 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 17:25" />“नङ सहि निया डाने बाबु, प्रिठीबीये नङलाई मासरेःसोनो, ङा के नङलाई ङासरेःसन, होसोनो नङ ङालाई नपरिःङसोङो ची वार्डे आवराई सनरंये। <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />नङ ङालाई नडाङो मया नोराई लेवटं पनि ओलेकं, होकाम ङा नोरं लेवटं लेव ङाढुकं वार्डे नोराई नङलाई सःरेडुने ङाझैसोनो होसोनो अजं पनि यासरेडुने ङाझैसन्ज़्या।”<verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s">येसुलाई याक्योव</para>
  <para style="r">
    <ref loc="MAT 26:47-56">मत्ती २६:४७-५६</ref>; <ref loc="MRK 14:43-50">मर्कुस १४:४३-५०</ref>; <ref loc="LUK 22:47-53">लुका २२:४७-५३</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />आव रोः हैओवारो पाना येसु उसिसरासं किड्रोन खोल्सा होपंटं ओनाव। नटं टोबो बगैचा लेव। येसु उसिसरासं नो बगैचालं उपसिव। <verse eid="JHN 18:1" /><verse number="2" style="v" sid="JHN 18:2" />येसुलाई सक्योःने यहुडाये पनि नो पो टकंडे ओनैज़्याव, कडालेकं येसु उसिसरासं ङाडेखिन पनि नलं डुप्सिरंये <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />होकाम भाङ, राङ्का सोनो हत्यार्र रोयो सिफाइँरं टपल्टन होसोनो मुख्या सेवा डोने मीरं सोनो फरिसीराई यापरिःङो चौकिडाररं रैडे यहुडा नलं पुलुडे याङाःकं ओराव। <verse eid="JHN 18:3" /><verse number="4" style="v" sid="JHN 18:4" />होकाम उज्युटं परिने स्यान्टै रोः ठा सन्डे येसु ङाःडे ओराव, होकाम नोरंलाई हैओडोवरं, “जे काङ्कालाई जिखिमज़्याव?”<verse eid="JHN 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5" />नोराई येसुलाई हैयाडोव, “नासरतला येसुलाई।”</para>
  <para style="p" vid="JHN 18:5">येसुये नोरंलाई हैओडोवरं, “ङा होज़।” येसुलाई सक्योःने यहुडा पनि नोरासंज़ च्याङसिडे उलिज़्याव। <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />येसुये नोरंलाई “ङा हो ज़” ओडोवरं, होपाना नोरं याछिन्डे याखोर्सिव, होकाम नामलं यापाव। <verse eid="JHN 18:6" /><verse number="7" style="v" sid="JHN 18:7" />फरि येसुये नोरंलाई ओपजोयोरं, “जे काङ्कालाई जिखिम्ज़्याव?”</para>
  <para style="p" vid="JHN 18:7">नोराई हैयावारो, “नासरतला येसुलाई।”<verse eid="JHN 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8" />येसुये जबाफ ओयोवरं, “ङा जेलाई हैङाडाच्योडुखे, ङा होज़। हैजैडे जे ङालाई जेखिम्सङखे भने आव मीरंलाई राःच्योरं।”<verse eid="JHN 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 18:9" />“नङ ङालाई नयाङो मीरं टोबोलाई पनि ङा ङामसमैरंये” वार्डे येसुये हैओवारो बचन पुरा ओटाकं वार्डे आव ओटाव।<verse eid="JHN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10" />सिमोन पत्रुसये ओल्स लिज़्याव तरवाल हाइडे मुख्या सेवा डोने मीलो ओकमारालाई वोर्टा ओना च्वाट्टै पल्डे ओयोव। नो कमारालो उमिन माल्खस लेव। <verse eid="JHN 18:10" /><verse number="11" style="v" sid="JHN 18:11" />येसुये पत्रुसलाई हैओडोव, “तरवाल उसिपलं झा। कडा बाबुये ङालाई ओयाङो कटौरा ङा माओँने डोरो?”<verse eid="JHN 18:11" /></para>
  <para style="s">येसु हन्नासलो ओङाःकं</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />हो पाना सिफाइँराई यापल्टन, नोराई यासेःरं, सोनो यहुडीराई याचौकिडारराई येसुलाई याक्योव, होकाम येसुलाई याकिव। <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />ङाःडे येसुलाई हन्नास लेवकं यालाङो, नो आव सालला मुख्या सेवा डोने मीराई यासेःर कैयाफालो ओमामा लेव। <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" />आव नो कैयाफाज़, जोये “जनताराई यालागिटं टोबो मी सिनेज़ ठीकं टाये” वार्डे यहुडीरंलाई सल्ला ओयोवरं।<verse eid="JHN 18:14" /></para>
  <para style="s">पत्रुसलो इन्कार</para>
  <para style="r">
    <ref loc="MAT 26:69-70">मत्ती २६:६९-७०</ref>; <ref loc="MRK 14:66-68">मर्कुस १४:६६-६८</ref>; <ref loc="LUK 22:55-57">लुका २२:५५-५७</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />सिमोन पत्रुस सोनो येसुलो टोबो उसिस येसुलो उछिनटं नेनाव। नो टोबो येसुलो उसिस, मुख्या सेवा डोने मीसं सरेःसिव लेवनि, होकाम येसुसं मुख्या सेवा डोने मीलो ओठारालं उपसिव। <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />पत्रुस पाखाकं झला येमकं च्याङसिडे उलिज़्याव। येसुलो टोबो उसिस मुख्या सेवा डोने मीसं सरेःसिव लेव, नो पाखा पुलुडे झला येमका लेने चौकिडार्नी लुज़ालाई हैडाडे पत्रुसलाई ज़ीःमलं ओरोयो। <verse eid="JHN 18:16" /><verse number="17" style="v" sid="JHN 18:17" />होकाम झला येमका चौकिडार्नी लिज़्याव नो नौकर्नी लुज़ाये पत्रुसलाई हैओडोव, “कडा आव मीलो उसिसरंकाम टोबो नङ पनि रो?</para>
  <para style="p" vid="JHN 18:17">पत्रुसये हैओवारो, ङा माङ्कची।”<verse eid="JHN 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18" />नलं कमारारं सोनो चौकिडाररं च्याङसिडे मेःलो ओराहा यामुन्सिज़्याव। कडालेकं ज़ीःमो लेव। होकाम पत्रुस पनि नोरासं च्याङसिडे मेः उमुनसिव।<verse eid="JHN 18:18" /></para>
  <para style="s">येसुलाई सेवा डोने मीराई यासेःरये रोः ओपजोयो</para>
  <para style="r">
    <ref loc="MAT 26:59-66">मत्ती २६:५९-६६</ref>; <ref loc="MRK 14:55-64">मर्कुस १४:५५-६४</ref>; <ref loc="LUK 22:66-71">लुका २२:६६-७१</ref></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />आबो मुख्या सेवा डोने मीये येसुलो उसिसरं सोनो उसिछ्यालो ओबारेलं ओपजोयो। <verse eid="JHN 18:19" /><verse number="20" style="v" sid="JHN 18:20" />येसुये नोलाई जबाफ ओयोव, “ङा प्रिठीबीलं स्यान्टै मीराई याङाःकंज़ हैङावार्ज़्या। ङा एकसप्ड्याज़ यहुडीरं याडुप्सिने ज़ीःम सोनो प्रार्ठना डोने ज़ीःमलं सिछ्या याडेङानैरं, नलं स्यान्टै यहुडीरं डुप्सिरंये। ङा गुप्तलं कडिज़ हैङावारो माले। <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />ङालाई कडाने नपजैसङज़्याव? ङा नोरंलाई कै ङाडोवरं हो ठैनेरंलाई ज़ पजैरं। ङा हैङावारो रोः आवरंलाई ठा ले।”<verse eid="JHN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22" />येसुये आव रोः हैओवार्ज़्याकं चौकिडारकाम टोबोये येसुलाई ऐवार्डे लपंटाये ओझाड्योव, “कडाने मुख्या सेवा डोने मीसं ऐजैडे नपाङज़्याव?”<verse eid="JHN 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23" />येसुये नोलाई हैओडोव, “ङा गल्ति ङापाङखिन नोलो ओप्रमान गोयोके, ङा ठीकं ज़ ङापाङखिन ङालाई कडाने नपोसङज़्याव?”<verse eid="JHN 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 18:24" />होकाम हन्नासये येसुलाई किसिवज़ मुख्या सेवा डोने मी कैयाफा लेवकं उपरिःङो।<verse eid="JHN 18:24" /></para>
  <para style="s">पत्रुसये येसुलाई फरि इन्कार ओडोव</para>
  <para style="r">
    <ref loc="MAT 26:71-75">मत्ती २६:७१-७५</ref>; <ref loc="MRK 14:69-72">मर्कुस १४:६९-७२</ref>; <ref loc="LUK 22:58-62">लुका २२:५८-६२</ref></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />सिमोन पत्रुस च्याङसिडे मेः उमुनसिज़्याकं। नोराई नोलाई हैयाडोव, “कडा नोलो उसिसरंकाम टोबो नङ पनि माङ्क?”</para>
  <para style="p" vid="JHN 18:25">नोये इन्कार डाडे हैओवारो, “ङा माङ्कची।”<verse eid="JHN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26" />मुख्या सेवा डोने मीलो ओकमारारंकाम टोबो, जोलो ओआफन्त मीलो ओना पत्रुसये ओपोलो, नोये ओपजोयो, “कडा ङा नङलाई नोसं बगैचालं ङामरःङसोनो डोरो?”<verse eid="JHN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 18:27" />होकाम फरि पत्रुसये इन्कार ओडोव। होपानाज़ भाले ओकोवो।<verse eid="JHN 18:27" /></para>
  <para style="s">पिलातसलो ओङाःकं येसु</para>
  <para style="r">
    <ref loc="MAT 27:1-2">मत्ती २७:१-२</ref>,<ref loc="MAT 27:11-14">११-१४</ref>; <ref loc="MRK 15:1-5">मर्कुस १५:१-५</ref>; <ref loc="LUK 23:1-5">लुका २३:१-५</ref></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />होकाम नोराई येसुलाई कैयाफालो उज़ीःमलाम रोमीराई याहाकिमलो ओडरबारडे यालाङो। हो बेलाकं छकाल्ने टाडे उलिज़्याव। याचलन अनंसार चोखो माटाडे निस्तार पर्बला ज़्याने बस्त ज़्याव गेम्डै वार्ने याछ्यासैये यहुडी अगंवारं डरबार ज्युङलं मापसिरंये। <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />हैजैडे नोराई लेवकं पाखाकं पुलुडे राडे पिलातसये हैओवारो, “आव मीलो उबिरोडलं जे कडि डोस जेलै?”<verse eid="JHN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30" />नोराई होलाई हैयाडोव, “आव मी अपराडी ओमटाखिन्के गे नङ लेवकं सुम्पिने गेम्लेव।”<verse eid="JHN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31" />पिलातसये नोरंलाई हैओडोवरं, “जे आवलाई लाङच्यो होकाम जे जेन्याम अनंसारज़ आवलो उनिया डाच्यो।”</para>
  <para style="p" vid="JHN 18:31">यहुडीराई नोलाई हैयाडोव, “कोइ मीलाई सैःने अडिकार गेलाई माले।” <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" />येसुलो उसिने खैटाव किसिमये टानेले नोलो उचिन्न याडे येसुये हैओवारो बचन पुरा ओटाकं वार्डे एटाव ओटाव।<note caller="+" style="x"><char style="xo" closed="false">1८:3२ </char><char style="xt" closed="false"><ref loc="JHN 3:14">युहन्ना ३:१४</ref>; <ref loc="JHN 12:32">१२:३२</ref> </char></note><verse eid="JHN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33" />पिलातस फरि ज़ीःमलं उपसिव, होकाम येसुलाई खुल्डे हैओडोव, “कडा नङ यहुडीराई याराजा रो?”<verse eid="JHN 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34" />येसुये जबाफ ओयोव, “नङज़ हैनवार्ज़्या, सै ङाबारेलं नङलाई उरुका काङ्काये हैओडानो?”<verse eid="JHN 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35" />पिलातसये जबाफ ओयोव, “कडा ङा यहुडी डोरो? नडेसलाराई सोनो मुख्या सेवा डोने मीराई नङलाई ङाकुइटं यासुम्पिसोनो। नङ कडि नझोयो?”<verse eid="JHN 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36" />येसुये जबाफ ओयोव, “ङा ङाराज्य आव प्रिठीबीला माङ्कची। ङा ङाराज्य आव प्रिठीबीला ओटाखिन्के ङासेवा डानेरं ङालागिटं खप्सिने यालेव। होसोनो ङा यहुडीराई याकुइटं परिने ङाम्लेव। ङा ङाराज्य आव प्रिठीबीला माङ्कची।”<verse eid="JHN 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37" />पिलातसये येसुलाई ओपजोयो, “कडा नङ राजाज़?”</para>
  <para style="p" vid="JHN 18:37">येसुये जबाफ ओयोव, “ङा राजाज़ वार्डे नङज़ हैनवार्ज़्या। आवलो ओलागिटंज़ ङा ङाजर्मीव, होसोनो आवलो ओलागिटं सत्यलो ओगोहाइ याने ङा आव प्रिठीबीलं ङाराव ची। जो सत्य लेवडे झैसि, नोये ङा ङागा ठोयो।”<verse eid="JHN 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38" />पिलातसये येसुलाई ओपजोयो,</para>
  <para style="s" vid="JHN 18:38">येसुलाई यासोयो</para>
  <para style="r" vid="JHN 18:38">
    <ref loc="MAT 27:15-31">मत्ती २७:१५-३१</ref>; <ref loc="MRK 15:6-20">मर्कुस १५:६-२०</ref>; <ref loc="LUK 23:13-25">लुका २३:१३-२५</ref></para>
  <para style="p" vid="JHN 18:38">“सत्य कडि?” आढङ हैवार्डे पिलातस यहुडीरं लेवडे पुलुडे ओनाव, होकाम नोरंलाई हैओडोवरं, “ङा आवलो कडि ओगल्तिज़ ङाम्डैये। <verse eid="JHN 18:38" /><verse number="39" style="v" sid="JHN 18:39" />निस्तार पर्बटं ङा जेलागिटं टोबो कैतीलाई राःड्याने चलन ले। होकाम कडा जे कडि जेपान, सै यहुडीराई याराजालाई ङाराड्याच्यो?”<verse eid="JHN 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40" />नोरं फरि ऐवार्डे याकिःव, “आवलाई माङ्क, बारब्बालाई।” बारब्बा डाङ्कु लेव।<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="s">येसुलाई क्रुसटं टाङ्गिने डन्ड आग्या</para>
  <para style="r">
    <ref loc="MAT 27:15-31">मत्ती २७:१५-३१</ref>; <ref loc="MRK 15:6-20">मर्कुस १५:६-२०</ref>; <ref loc="LUK 23:13-25">लुका २३:१३-२५</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />होकाम पिलातसये येसुलाई लाङडे कोर्राये पोःवो उपरिःङोरं। <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />होसोनो सिफाइँराई ज़ुलाई गुठैडे मुकुट झैडे येसुलाई ओङैःटं यासजाव, होकाम येसुलाई निलल्याव रङ्गला क्वा याक्वायो, <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />होकाम येसुलो ओछ्योकं राडे हैयाडोव, “जडं, यहुडीराई याराजा!” होकाम नोराई येसुलाई लपंटाये झाडे यायोव।<verse eid="JHN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4" />फरि पाखाडे पुलुडे पिलातसये नोरंलाई हैओडोवरं, “रःङच्यो, ङा आवलाई पाखाकं जे लेवकंज़ ङारैज़्या, जेलाई हैङाडाच्योज़्या, ङा आवलो ओगल्ति कडिज़ ङाम्डैये।” <verse eid="JHN 19:4" /><verse number="5" style="v" sid="JHN 19:5" />होकाम ज़ुलो पगरि सोनो निलल्याव रङ्गला क्वा क्वाइसिव येसु पाखाडे ओराव, होकाम पिलातसये नोरंलाई हैओडोवरं, “गरःङच्योके, आव मीलाई!”<verse eid="JHN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6" />मुख्या सेवा डोने मीरं सोनो चौकिडारराई येसुलाई यारोःङो, नोराई ऐवार्डे याकिःव, “नोलाई क्रुसटं टाङ्गि, नोलाई क्रुसटं टाङ्गि!”</para>
  <para style="p" vid="JHN 19:6">पिलातसये नोरंलाई हैओडोवरं, “जेज़ आवलाई लाङडे क्रुसटं टाङगिच्यो, कडालेकं ङा आवलो कडि ओगल्ति ङामडैये!”<verse eid="JHN 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7" />यहुडीराई नोलाई जबाफ यायोव, “गे टोबो गेन्याम ले, हो न्यामये ओवारो मान्टि आव सिवज़ परिये, कडावार्क आवये ओललाई परमेस्वरलो ओज़ा हैवार्ज़्या।”<verse eid="JHN 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8" />आव रोः ठैडे पिलातस झनज़ बनै ओछेव। <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />नो फरि ज़ीःमलं उपसिव होकाम येसुलाई ओपजोयो, “नङ काङा?”</para>
  <para style="p" vid="JHN 19:9">येसुये नोलाई कडि जबाफज़ मायोवये। <verse eid="JHN 19:9" /><verse number="10" style="v" sid="JHN 19:10" />हैजैडे पिलातसये येसुलाई हैओडोव, “कडा नङ ङासं नम्पाङ? नङलाई राःने अडिकार ङाकुइटंज़ ले, होसोनो नङलाई क्रुसटं टाङ्गिने पनि ङाकुइटंज़ले वार्ने नङ नमसंनये?”<verse eid="JHN 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11" />येसुये जबाफ ओयोव, “नङलाई रोटाम मायासिव टावसं ङातर्ट कडि नअडिकार टाने मालेव। हैजैडे ङालाई नकुइटं सुम्पिने मीरं अजं भ्या पापलो डोसि टारंये।”<verse eid="JHN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12" />होकाम पिलातसये येसुलाई राःने बनै कोसिस ओडोव। यहुडीरं ऐवार्डे याकिव, “नङ आव मीलाई नराःखे भने नङ कैसरलो ओनै माङ्कची। ङा के राजा ची वार्नेरं स्यान्टै कैसरलो उबिरोडलं टारंये।”<verse eid="JHN 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13" />पिलातसये आव रोः ठैडे येसुलाई पाखाडे ओरोयो, होकाम नो “लुङलो पल्याटा” याडोज़्याव निया डोने पोलं उचुङो, नोलाई हिब्रुङाम गब्बठा डोरंये। <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />नो बेला निस्तार पर्बलो तयार टाने डिन लेव। लाका ठोकै बारं बजिव लेव। पिलातसये यहुडीरंलाई हैओडोवरं, “जेराजालाई गरःङच्योके!”<verse eid="JHN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15" />नोरं ऐवार्डे याकिःव, “नोलाई सैः, नोलाई सैः, नोलाई क्रुसटं टाङ्गि!”</para>
  <para style="p" vid="JHN 19:15">पिलातसये नोरंलाई ओपजोयोरं, “कडा ङा जेराजालाई क्रुसटं ङाटाङ्गि?”</para>
  <para style="p" vid="JHN 19:15">मुख्या सेवा डोने मीराई जबाफ यायोव, “कैसरकाम उरु गेराजा माले।”<verse eid="JHN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 19:16" />होकाम नोये येसुलाई क्रुसटं टाङ्गिने नोराई याकुइटं सुम्पिडे ओयोवरं।</para>
  <para style="s" vid="JHN 19:16">येसु क्रुसटं</para>
  <para style="r" vid="JHN 19:16">
    <ref loc="MAT 27:32-44">मत्ती २७:३२-४४</ref>; <ref loc="MRK 15:21-32">मर्कुस १५:२१-३२</ref>; <ref loc="LUK 23:26-43">लुका २३:२६-४३</ref></para>
  <para style="p" vid="JHN 19:16">हैजैडे सिफाइँराई येसुलाई जिम्मा यारोयो।<verse eid="JHN 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 19:17" />येसुये उक्रुस ओलज़ घुर्डे खप्परे वार्ने डान्डाटं ओनाव, (जोलाई हिब्रुङाम “गलगठा” डोरंये)। <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />नटं नोराई येसुलाई क्रुसटं याटाङ्गिव होसोनो येसुसं उरु नेबऱ्याङनिलाई पनि याटाङ्गिव, टोबोलाई टफडे सोनो टोबोलाई छुटंडे, मान्झलं येसुलाई। <verse eid="JHN 19:18" /><verse number="19" style="v" sid="JHN 19:19" />पिलातसये टोबो डोस पत्र पनि ओसोरो, नो क्रुसटं टाङगिडे ओयोव। नटं एटाव सर्सिव लेव, “नासरतला येसु यहुडीराई याराजा।” <verse eid="JHN 19:19" /><verse number="20" style="v" sid="JHN 19:20" />आबो भ्या यहुडीराई नो यापरिव, कडालेकं येसु क्रुसटं टाङगिसिव पो सहरकाम नजिकंज़ लेव। आव हिब्रुङाम, ल्याटिनङाम सोनो ग्रीक पाङङाम सर्सिव लेव। <verse eid="JHN 19:20" /><verse number="21" style="v" sid="JHN 19:21" />यहुडीराई मुख्या सेवा डोने मीराई पिलातसलाई हैयाडोव, “‘यहुडीराई याराजा’ वार्ने माङ्क, ‘आवये ङा यहुडीराई याराजा ओवारो’ वार्डे सर।”<verse eid="JHN 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22" />पिलातसये जबाफ ओयोवरं, “ङा जो ङासर्खे, ङासर्खे।”<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />होकाम सिफाइँराई येसुलाई क्रुसटं याटाङगिरं, होकाम नोराई येसुलो ओक्वा रैडे स्यान्टै सिफाइँरंलाई टभाग-टभाग टाने झैडे चार भाग याजोयो। येसुलो ओतर्टा ओक्वा पनि यालाङो, नो क्वा उसिउनि मालेव रोङाम मेङा समंज़ रःसिव लेव। <verse eid="JHN 19:23" /><verse number="24" style="v" sid="JHN 19:24" />हैजैडे नोराई या-याज़ हैयावारो, “आव माचीने, होकाम आव काङ्कालो टाने वार्डे गोला गेझाके।” चोखो सास्त्र पुरा गटाकं वार्डेज़ आव ओटाव।</para>
  <para style="q1" vid="JHN 19:24">“नोराई ङाक्वा या-याज़ याभारं,</para>
  <para style="q2" vid="JHN 19:24">होसोनो ओतर्टा क्वाटं गोला याझाव।”<verse eid="JHN 19:24" /></para>
  <para style="m">
    <verse number="25" style="v" sid="JHN 19:25" />हैजैडे सिफाइँराई आव येःन याडोव।</para>
  <para style="p" vid="JHN 19:25">येसुलो उक्रुसलो ओछ्योकं येसुलो वामा, सोनो वामालो ओबैनी, क्लोपासलो ओज्या मरियम सोनो मरियम मग्डलिनीरं च्याङसिडे यालिज़्याव। <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />येसुये वामालाई सोनो ओल मया ओडोज़्याव उसिसलाई ओछ्योकं च्याङसिडे निलिज़्याव ओरोःङोनि, होकाम येसुये वामालाई हैओडोव, “आमा, गरःङके नज़ालाई!”<verse eid="JHN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 19:27" />होकाम नो उसिसलाई पनि येसुये हैओडोव, “रःङ, नामा!” नो बेलाकामज़ येसुलो नो उसिसये होलाई उज़ीःमकं ओलाङो।<verse eid="JHN 19:27" /></para>
  <para style="s">येसु उसिव</para>
  <para style="r">
    <ref loc="MAT 27:45-56">मत्ती २७:४५-५६</ref>; <ref loc="MRK 15:33-41">मर्कुस १५:३३-४१</ref>; <ref loc="LUK 23:44-49">लुका २३:४4-४९</ref></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />होकाम येसुये स्यान्टै रोः याखेम वार्ने सन्डे चोखो सास्त्र पुरा ओटाकं वार्डे ऐओवारो, “ङालाई रीः याछो।”<verse eid="JHN 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 19:29" />नकं टोबो जालं स्युरो सिर्का नैसिव लेव। होकाम स्युरोलं छिमसिव रुइलो टोबो भुटुने हिसपलो ओहाङ्गाटं झाडे नोराई येसुलो ओयाःकं यालाङड्योव। <verse eid="JHN 19:29" /><verse number="30" style="v" sid="JHN 19:30" />येसुये स्युरो सिर्का ओओँव, होकाम येसुये हैओवारो, “आबो याखेम,”</para>
  <para style="p" vid="JHN 19:30">होकाम येसुये ओङैः उझुन्डोयो होकाम ओसं ओफ्याव।<verse eid="JHN 19:30" /></para>
  <para style="s">येसुलो ओकोखालं भाला रुपिडे यायोव</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />नो छ्याम तयार टाने डिन सुक्रबार लेव। हैजैडे यहुडीराई यानाःसिने डिन छ्याम सिव मीराई याक्याङ क्रुसटं राःने चाव माटाये वार्डे पिलातसलाई बिन्ती याडोव, होसोनो नोराई याखङ केःड्यारंडे नोराई यामोरो लाङने वार्डे यानिःव। <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />होकाम सिफाइँरं राडे येसुसं क्रुसटं टाङ्गिसिवनि नेखङ याकेःड्योवरं, ङाःडे टोबोलो, होकाम फरि छुटंलो। <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />नोरं येसु लेवकं राडे नोराई यारोःङो, येसुलो ओसं ङाःडेज़ फ्याडे ओलेवये येसुलो ओखङ माकेःरये। <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />सिफाइँरंकाम टोबोये येसुलो ओकोखालं भालाये ओघोचोयो, होपानाज़ झी सोनो ज़न्ज़ारी ओराव। <verse eid="JHN 19:34" /><verse number="35" style="v" sid="JHN 19:35" />जेलाई बिस्वास गटाकं वार्डे आव रःङनेये घटना जोस्यानाव ओटाव हैटावज़ गोहाइ पाङडेले, होकाम नोये ओपाङो सत्यज़ ले, होकाम सत्यज़ ङापाङज़्या वार्डे नोये सोनोये। <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />“नोलो टोबो उरुज़ क्याःने माले” वार्ने सास्त्रटा बचन पुरा गटाकं वार्डे आव ओटारिव।<note caller="+" style="x"><char style="xo" closed="false">1९:3६ </char><char style="xt" closed="false"><ref loc="PSA 34:20">भजनरं ३४:२०</ref></char></note> <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" />होकाम फरि छुटं टोठोकं सास्त्रये हैवार्ये, “जोलाई नोराई घोचैडे नैरं, नोराई होलाई रःङने लेरं।”<note caller="+" style="x"><char style="xo" closed="false">1९:3७ </char><char style="xt" closed="false"><ref loc="ZEC 12:10">जकरिया १२:१०</ref></char></note><verse eid="JHN 19:37" /></para>
  <para style="s">येसुलाई यागाडिव</para>
  <para style="r">
    <ref loc="MAT 27:57-61">मत्ती २७:५७-६१</ref>; <ref loc="MRK 15:42-47">मर्कुस १५:४२-४७</ref>; <ref loc="LUK 23:50-56">लुका २३:५०-५६</ref></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />होकाम अरिमाठियाला योसेफ, जो यहुडी अगंवाराई याछ्यासैये गुप्तलंया मान्त्रा येसुलो उसिस लेव, नोये पिलातसलाई येसुलो ओक्याङ लाङो ङाडैकं वार्डे बिन्ती ओडोव। पिलातसये गलाङके वार्डे हैओडोव। होकाम नोये राडे येसुलो ओक्याङ ओलाङो। <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" />ङाःडे रिलं येसुलाई डैनाने निकोडेमस पनि योसेफसं ठोकै तेत्तिस किलोया मुर्र सोनो एलवालो उसिङटाम झैसिव चाव बसैने अत्तर बराईसिव मसला डाडे नकं ओराव। <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />ऐजैडे नोनि येसुलो ओक्याङ यहुडीराई गाडिने याचलन मान्टि मङ-मङ बसैने मसलासं सुति क्वाटं नेपोव। <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />येसु क्रुसटं ओटाङगिसिव पोलं टोबो बाङ लेव। नो बाङलं खर्कज़ काङ्कालाईज़ मानैसिव टोबो साःरौ खाडर लेव। <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />कडावार्क यहुडीराई तयार टाने डिन लेव, होसोनो नो खाडर पनि नजिककंज़ लेव, होकाम नोराई येसुलाई नो खाडरलंज़ यानोयो।<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s">रितो खाडर</para>
  <para style="r">
    <ref loc="MAT 28:1-8">मत्ती २८:१-८</ref>; <ref loc="MRK 16:1-8">मर्कुस १६:१-८</ref>; <ref loc="LUK 24:1-12">लुका २४:१-१२</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />सातालो पैला डिनछ्याम छकाल्ने जुसुमुसु उलिज़्याकंज़ मरियम मग्डलिनी खाडरलं ओराव, होकाम नोये पल्याटा खाडरलाम टङडे हाइसिव ओरोःङो। <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />नो सिमोन पत्रुस सोनो येसुये मया ओडोज़्याव उसिस लेवकं ज़ोःये-ज़ोःये ओनाव होकाम नोये हैओवारो, “नोराई प्रभुलाई खाडरलाम लाङडेची नैरं, प्रभुलाई काङं नैडे यानैज़्याव हो गेलाई ठा माले।”<verse eid="JHN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3" />होकाम पत्रुस सोनो टोबो प्रभुलो उसिसनि पाखा पुलुडे खाडरडे नेनाव। <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />नोनि बोलोङज़ नेज़ोःव, टोबो येसुलो उसिसये पत्रुसलाई ख्यानैडे खाडरलं ङाःडेज़ ओकेरिव। <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />खाडरलं घोम लेडे ओरःङकं, नोये ङाःडेङा पोसिव सुतिलो क्वारं याज़ ख्यासिव ओरोःङो, नो खाडरलं मापसिये। <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />सिमोन पत्रुस नोलो उछिन-उछिन ओराव, होकाम खाडरलं उपसिव, होकाम नोये पनि सुतिलो मोरो पोसिव क्वारंया मान्त्रा ख्यासिव ओरोःङो। <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />येसुलो ओङैःटा पोसिव रुमाल नो सुतिलो क्वारासं मालेव, अलगंज़ पटैडे टोबो पोकं नैसिव उलिज़्याव। <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />होकाम खाडरलं ङाःडे केरिव येसुलो उसिस पनि खाडरलं उपसिव, होकाम नोये नो रःङडे बिस्वास ओडोव। <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />कडालेकं नोराई येसु सिवलाम ज्युङडा टाडे सोनेज़ले वार्ने सास्त्रटा बचन आर्क समं यामबुझिटाव। <verse eid="JHN 20:9" /><verse number="10" style="v" sid="JHN 20:10" />होकाम नो येसुलो उसिसरं वोल्डे याज़ीःमडे यानाव।<verse eid="JHN 20:10" /></para>
  <para style="s">येसु मरियम मग्डलिनी लेवकं ओसंतन्सिव</para>
  <para style="r">
    <ref loc="MAT 28:9-10">मत्ती २८:९-१०</ref>; <ref loc="MRK 16:9-11">मर्कुस १६:९-११</ref></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11" />मरियम खाडरकाम पाखाकं च्याङसिडे ओघर्ज़्याव। नोये घोरोग्यान घोम लेडे खाडरलं ओरोःङो, <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />नलं येसुलो सिव ओक्याङ नैसिव लेव, नलं पलाङो क्वा क्वाइसिव नेबऱ्याङ स्वर्गटा कटंवालनि टोबो ओङैः लेव पोडे सोनो टोबो ओखङ लेव पोडे चुङडे निलिज़्याव नोये ओरोःङोनि। <verse eid="JHN 20:12" /><verse number="13" style="v" sid="JHN 20:13" />नोनि मरियमलाई हैनेडोव, “मेमा, कडाने नघरज़्याव?”</para>
  <para style="p" vid="JHN 20:13">नोये नोनिलाई हैओडोवनि, “नोराई ङाप्रभुलाई लाङडेनैरं, होसोनो होलाई काङ नैडेयानैज़्याव ङा ङामसन।”<verse eid="JHN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 20:14" />आडङ हैवार्डे नो उझिन्डे ओवलो, होकाम नोये येसुलाई च्याङसिडे उलिज़्याव ओरोःङो, हैनि पनि नो येसुज़ वार्डे मासरेवये। <verse eid="JHN 20:14" /><verse number="15" style="v" sid="JHN 20:15" />येसुये नोलाई हैओडोव, “ए मेमा, नङ कडाने नघरज़्याव? काङ्कालाई नखिम्ज़्याव?”</para>
  <para style="p" vid="JHN 20:15">नोये येसुलाई बगैचा रःङने मी ची वार्डे हैओडोव, “ए प्रभु नङ येसुलाई आलाम नलाङो टावसं, काङं नैडे ननैज़्याव ङालाई हैडाङ, होकाम ङा येसुलाई लाङने ङाले।”<verse eid="JHN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16" />येसुये नोलाई हैओडोव, “मरियम!”</para>
  <para style="p" vid="JHN 20:16">नोये वोल्डे येसुलाई हिब्रुङाम हैओडोव, “रब्बोनी,” “ए गुरबा!”<verse eid="JHN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17" />येसुये नोलाई हैओडोव, “ङालाई छुवज़ टाछुसङ, कडावार्क ङा आर्क समं बाबु लेवकं ङामनाटा। ङाभाइरं लेवकं नाडे नोरंलाई हैडोरं, ‘ङाबाबु सोनो जेबाबु होसोनो ङापरमेस्वर सोनो जेपरमेस्वर लेवकं ङानारिज़्या।’”<verse eid="JHN 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18" />मरियम मग्डलिनी ओनाव होकाम येसुलो उसिसरंलाई हैओडोवरं, “ङा प्रभुलाई ङारोःङो।” होसोनो येसुये हैओवारो रोः नोरंलाई नोये हैओडोवरं।<verse eid="JHN 20:18" /></para>
  <para style="s">येसु उसिसरं लेवकं ओसंतन्सिव</para>
  <para style="r">
    <ref loc="MAT 28:16-20">मत्ती २८:१६-२०</ref>; <ref loc="MRK 16:14-18">मर्कुस १६:१४-१८</ref>; <ref loc="LUK 24:36-49">लुका २४:३६-४९</ref></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />नो आइतबार छ्याम सातालो पैला डिन रिःम्डे, यहुडीराई याछ्यासैये येसुलो उसिसरं झला रुःप्डे ज़ीःमलं चुङडे यालिज़्याकं, येसु राडे नोराई याखार्ल ओच्याङसिव, होकाम नोरंलाई हैओडोवरं, “जेलाई सान्ति!” <verse eid="JHN 20:19" /><verse number="20" style="v" sid="JHN 20:20" />आडङ हैवार्डे येसुये नोरंलाई उकुइ सोनो ओकोखा पनि सटन्डे ओयोवरं। प्रभुलाई रःङडे उसिसरं बनै यारेङो। <verse eid="JHN 20:20" /><verse number="21" style="v" sid="JHN 20:21" />होकाम येसुये फरि नोरंलाई हैओडोवरं, “जेलाई सान्ति! जोस्याव बाबुये ङालाई उपरिःङसोङो, हैजैडे ङा पनि जेलाई ङापरिःङच्यो।” <verse eid="JHN 20:21" /><verse number="22" style="v" sid="JHN 20:22" />आडङ हैवार्डे येसुये नोरंलाई ओसये उमुयोरं होकाम हैओडोवरं, “चोखो आत्मा हाँ। <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" />जोराई यापाप छेमा जेडा, नोराई यापाप छेमा टाये, होसोनो जोराई यापाप जे छेमा जेमडा होराई यापाप छेमा टाने माले।”<verse eid="JHN 20:23" /></para>
  <para style="s">येसु सोनो ठोमा</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />येसु ओराज़्याकं बारं जना उसिसरंकाम टोबो, डिडुमस वार्ने ठोमा नोरासं मालेव। <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />हैजैडे उरु येसुलो उसिसराई नोलाई हैयाडोव, “गेके प्रभुलाई गेरोःङो।”</para>
  <para style="p" vid="JHN 20:25">नोये होरंलाई हैओडोवरं, “जोका समं ङा येसुलो उकुइटा कान्टिलो उकुङ ङामरःङ, होसोनो कान्टि ठुकिसिव पोलं ङाकुइसै ङामझा, ओकोखालं ङाकुइ ङामझा, होका समं ङा बिस्वास ङामडो।”<verse eid="JHN 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26" />आठ डिन येसुलो उसिसरं ज़ीःमलं लेवरं। ठोमा पनि नोरासं लेव। झलारं स्यान्टै रुप्सिव लेव, येसु ज़ीःमलं उपसिव, होकाम याखार्ल च्याङसिडे हैओवारो, “जेलाई सान्ति!” <verse eid="JHN 20:26" /><verse number="27" style="v" sid="JHN 20:27" />होकाम येसुये ठोमालाई हैओडोव, “नकुइसै आलं टा, होसोनो ङाकुइरं रःङ। नकुइये ङाकोखा छाप। सङ्खा टाडो बिस्वासी टान।”<verse eid="JHN 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28" />ठोमाये येसुलाई हैओडोव, “ङाप्रभु सोनो ङापरमेस्वर!”<verse eid="JHN 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29" />येसुये नोलाई हैओडोव, “नङ ङालाई नरःङसोङो कारनये ङालाई बिस्वास नडाङो ची? रेङोरं ची नोरं, जोराई ङालाई यारःङसोङो माले, होटानि पनि बिस्वास डोरंये।”<verse eid="JHN 20:29" /></para>
  <para style="s">युहन्नाये आव किताप कडाने ओसोरो</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />येसुये उरु भ्या चिन्नरं उसिसराई याङाःकं ओडोव, नो आव कितापटं सर्सिव माले। <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />बुरु आव रोः आव कारनये सर्सिव ची, जे येसु परमेस्वरलो ओज़ा ख्रीस्टज़ वार्डे बिस्वास डाच्यो, होसोनो बिस्वासङाम येसुलो उमिनङाम जे जीबन जेडैकं।<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s">येसु सात जना उसिसराई याङाःकं ओसंतन्सिव</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />होकाम तिबेरियास समन्डरलो ओगोराटं उसिसराई याङाःकं येसु ओसंतन्सिव। येसुये ओललाई ऐजैडे टखेप फरि ओसोटोनो। <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />सिमोन पत्रुस, डिडुमस वार्ने ठोमा, गालीलला काना नाङखारला नठानेल, जब्डियालो नेबऱ्याङ ओज़ानि होसोनो उसिसरंकाम नेबऱ्याङनि टोबोकं लेवनि। <verse eid="JHN 21:2" /><verse number="3" style="v" sid="JHN 21:3" />सिमोन पत्रुसये नोरंलाई हैओडोवरं, “ङा ङाः सैःने ङानाज़्या।” नोराई नोलाई हैयाडोव, “गे पनि नङसं गेरा।” नोरं नाडे डोङ्गाटं यापुलुव, नो रिलं नोराई कडिज़ माक्योरंये। <verse eid="JHN 21:3" /><verse number="4" style="v" sid="JHN 21:4" />उज्यालो ओटारिज़्याकं, येसु समन्डर गोराटं च्याङसिडे उलिज़्याव। येसुलो उसिसराई नो येसुज़ वार्डे मासरेरंये। <verse eid="JHN 21:4" /><verse number="5" style="v" sid="JHN 21:5" />येसुये नोरंलाई हैओडोवरं, “ढापा मीरं, जेसं टिगिडा ङाः लिज़्या रो?”</para>
  <para style="p" vid="JHN 21:5">नोराई येसुलाई जबाफ यायोव, “माले।”<verse eid="JHN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6" />येसुये नोरंलाई हैओडोवरं, “जाल डोङ्गाकाम वोःरडे ख्याच्यो, होकाम डैने जेले।” होकाम नोराई जाल याख्याव, ङाःरं बनै भ्या यापरिवये नोराई जाल मासेल्डुरंये।<verse eid="JHN 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7" />येसुये मया ओडोज़्याव उसिसये पत्रुसलाई हैओडोव, “नो के प्रभु ची ओलेव लेव।” “नो प्रभुज़ ओलेव लेव” वार्ने ठैडे सिमोन पत्रुस ओतर्टा ओक्वा ओवाङलं ओपोव, कडालेकं नोये ओक्वा पिःडे ओनैज़्याव, होकाम समन्डरलं फालओजाव। <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />उरु उसिसरं डोङ्गाटंज़ चुङडे ङाःये ब्यालो जाल सेःल्डे यारोयो। नोरं समन्डर गोराटाम भ्या टाडाके माङ्क, ठोकै टसय मिटरया लेव। <verse eid="JHN 21:8" /><verse number="9" style="v" sid="JHN 21:9" />नोरं ओगोराटं याझरिवपाना नोराई मेःलो भुभुरालं ङाः हिप्सिव सोनो बरे यारोःङो। <verse eid="JHN 21:9" /><verse number="10" style="v" sid="JHN 21:10" />येसुये नोरंलाई हैओडोवरं, “जे बाभा जेक्योव ङाः टिगिडा गरैच्योके।”<verse eid="JHN 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 21:11" />होकाम सिमोन पत्रुस डोङ्गाटं पुलुडे टसय त्रिपन्न गोटा घ्यो-घ्योव ङाःराई ब्यालो जाल पाखाटं सेःल्डे ओरोयो, आडङ भ्या ओटानि पनि जाल माचीये। <verse eid="JHN 21:11" /><verse number="12" style="v" sid="JHN 21:12" />येसुये नोरंलाई हैओडोवरं, “राडे गकैच्योके।” उसिसरंकाम काङ्काये पनि “नङ काङ्का?” वार्डे पजैने आँट माडोरंये, कडावार्क नोराई नो प्रभुज़ वार्डे यासोनो। <verse eid="JHN 21:12" /><verse number="13" style="v" sid="JHN 21:13" />येसु राडे बरे रैडे नोरंलाई ओयोवरं, होसोनो ङाः पनि ओयोवरं।<verse eid="JHN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 21:14" />सिवलाम ज्युङडा टाडे ओसोव छिन्डे येसु उसिसराई लेवकं ओसंतन्सिज़्याव आव तेस्रा पाला लेव।<verse eid="JHN 21:14" /></para>
  <para style="s">येसु सोनो पत्रुस</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />नोराई ज़्याडे याखेमो पाना येसुये सिमोन पत्रुसलाई हैओडोव, “युहन्नालो ओज़ा सिमोन, कडा नङ आवराई भन्डा भ्या मया नडाङ रो?”</para>
  <para style="p" vid="JHN 21:15">नोये हैओवारो, “अँ प्रभु, नङज़ नसन, ङा नङलाई मया ङाडान।”</para>
  <para style="p" vid="JHN 21:15">येसुये नोलाई हैओडोव, “ङापाठारंलाई ज़्याव योरं।” <verse eid="JHN 21:15" /><verse number="16" style="v" sid="JHN 21:16" />येसुये फरि टखेप नोलाई हैओडोव, “युहन्नालो ओज़ा सिमोन, कडा नङ ङालाई मया नडाङ रो?”</para>
  <para style="p" vid="JHN 21:16">नोये येसुलाई हैओडोव, “अँ प्रभु, नङ नसनये, ङा नङलाई मया ङाडान।”</para>
  <para style="p" vid="JHN 21:16">येसुये नोलाई हैओडोव, “ङाभेडारंलाई रःङरं।” <verse eid="JHN 21:16" /><verse number="17" style="v" sid="JHN 21:17" />येसुये नोलाई फरि सोङ्खेपका पनि हैओडोव, “युहन्नालो ओज़ा सिमोन, कडा नङ ङालाई मया नडाङ रो?”</para>
  <para style="p" vid="JHN 21:17">पत्रुस डुखि ओटाव, कडावार्क येसुये नोलाई सोङ्खेपका पनि नोलाई “कडा नङ ङालाई मया नडाङ रो?” हैओडोव। नोये येसुलाई हैओडोव, “प्रभु, नङ स्यान्टै रोःज़ नसनये। ङा नङलाई मया ङाडान वार्डे नङलाई ठाले।”</para>
  <para style="p" vid="JHN 21:17">येसुये नोलाई हैओडोव, “ङाभेडारंलाई ज़्याव ओँव योरं। <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" />डस्साज़, ङा नङलाई हैङाडान, जोकं नङ ढापा नलेव नङ नङज़ नवाम्फो नपोसिये, होसोनो जोङ नमन लागि होङ ननाये। नङ बड्डा टानेनले, होकं नङ नकुइ पलाडे सहयोग निःने नले, होकाम उरुराई नवाम्फो पोड्याने लेरं, होसोनो जोङ नाने नुयुङ माले होङ लाङने लेरं।” <verse eid="JHN 21:18" /><verse number="19" style="v" sid="JHN 21:19" />“खैटाव किसिमये पत्रुस सिडे परमेस्वरलो ओमहिमा डानेले, नोलो लागिटं येसुये आव हैओवारो।” आडङ हैवार्डे येसुये नोलाई हैओडोव, “ङाछिन्ट राङन।”<verse eid="JHN 21:19" /></para>
  <para style="s">येसु सोनो छुटं उसिस</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />पत्रुसये उझिन्डे वोल्डे ओरःङकं येसुये मया ओडोज़्याव येसुलो उसिस उछिन-उछिन ओराज़्याव ओरोःङो। नोयेज़ रिम्डेका काङ ज़्याने बेलाकं येसुलो ओछातीटं अडैसिडे, “प्रभु, नङलाई सक्योःने काङ्का?” वार्डे ओपजोयो। <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />नोलाई रःङडे पत्रुसये येसुलाई हैओडोव, “प्रभु, आवलाई कैटा?”<verse eid="JHN 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22" />येसुये पत्रुसलाई हैओडोव, “ङा ङामराया समं नोये ओकेनसोङोकं वार्ने ङायुङ ओलेनि पनि नङलाई कैओटाव ड? नङ ङाछिन्ट राङन।”<verse eid="JHN 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 21:23" />हैजैडे नो येसुलो उसिस मासि वार्ने रोः नोराई याभाइराई याखार्ल ओफैलिव। येसुये नो मासि वार्डे हैओवारो माङ्क, “ङा ङामराया समं ओकेनसोङोकं वार्ने ङायुङ ओलेनि पनि नङलाई कैओटाव ड?” हैओवारो।<verse eid="JHN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24" />आव नो येसुलो उसिसज़, जोये आव रोः हैवार्डे गोहाइ योज़्याव, नोये आव रोः सर्डेनोयो, होकाम गे गेसन नोलो ओगोहाइ सत्यले।<verse eid="JHN 21:24" /></para>
  <para style="s">मुख्या रोःरं</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />येसुये उरु पनि भ्या येःन ओडोव। नो स्यान्टै येःनराई याबारेलं सर्खिनके, ङालाई ऐटाव लागिज़्या, नोलो ओबारेलं सर्सिव कितापरं प्रिठीबी भरि पनि मासुनरं हो।<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>