<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- Wale Magar Kham</book>
  <para style="h">मर्कुस</para>
  <para style="toc3">मर्कुस</para>
  <para style="toc2">मर्कुस</para>
  <para style="toc1">मर्कुसये ओसोरो चाव सोर</para>
  <para style="mt2">मर्कूसले लेखेको सुसमाचार</para>
  <para style="mt1">मर्कुसये ओसोरो चाव सोर</para>
  <para style="imt">कितापलाई सरेःने</para>
  <para style="ip">साःरौ बाचाटा चारगोटा चाव सोरला कितापरंलाम मर्कुसये ओसोरो चाव सोर टोबो एटाव बचन ची जोये येसुलो उजीबनलो ओबयान डोवये। आव चारगोटा कितापरंलाई चाव सोरला कितापरं डोसिरंये होकाम आवलाई चाव सोर पनि डासिये। आव चारगोटा कितापरं येसु उसिव छिन्डे मत्ती, मर्कुस, लुका सोनो युहन्नाराई यासोरो ची। मर्कुसये ओसोरो किताप चारगोटा चाव सोररंकाम स्यान्टैराई भन्डा आलिज़ा ची। ऐटाव बिस्वास पनि डासिये, येसु उजर्मीव झिन्डे ६५ काम ७० बर्स खार्ल, स्यान्टै भन्डा ङाःडे सर्सिव ची। बाइबल सन्ने भ्या मीराई आव किताप रोमलं सर्सिव वार्रये, होकाम आवलो ओकारन रोमला लेव ख्रीस्ट्यानरंलाई साःरौ हिक्मत यानेलो लागिटं सर्सिव लेव।</para>
  <para style="ip">मर्कुसलाई, युहन्ना मर्कुस वार्डे पनि सरेःसिये, आव प्रेरित पावल सोनो बारनाबासनि नेनै लेव। हैनि पनि नोलो ओसेवासं ओडोव बेलाका रोःलाई कितापटं ओसोरो ची। मर्कुसलो उकितापये सिसरं झैने सोनो येसु फरि ओराने बेलाका रोःरं पैने बारेलं भ्या जोर यासिवले, ओनैरासं याभासिकं बनै डुखि ओटाव। <char style="xt"><ref loc="ACT 13:13">प्रेरित १३:१३</ref></char> होकाम फरि मर्कुसये बारनाबाससं ओसेवा सुरु ओडोव। <char style="xt"><ref loc="ACT 15:37-39">प्रेरित १५:3७-३९</ref></char> मर्कुसलाई पत्रुसलो ङनसिव ओनै पनि डोरंये। <char style="xt"><ref loc="1PE 5:13">१ पत्रुस ५:१३</ref></char> हैनि पनि मर्कुस येसुलो उजीबन उमिलंङयेज़ रःङने मी माङ्कची, बाइबल बारेलं बुझिव मीराई हैवार्रये, मर्कुसये उकितापटा ओसोरो रोःरं पत्रुसलो उजीबन गोहाइ ठैडे हो अनंसार सर्सिव ले।</para>
  <para style="iot">आव ज्युङला बिसयेरं</para>
  <para style="io1">१. मर्कुसलो उकितापलाई सरेःने। <char style="ior"><ref loc="MRK 1:1-13">१:१-१३</ref> </char></para>
  <para style="io">२. गालीललं येसुये ओडोव सेवालो ओबारेलं। <char style="ior"><ref loc="MRK 1:14-8:21">१:१४—८:२१</ref> </char></para>
  <para style="io1">३. येसु यरुसलेमडे ओनाव बारेलं। <char style="ior"><ref loc="MRK 8:21-10:52">८:२१—१०:५२</ref></char></para>
  <para style="io1">४. येसु यरुसलेमलं सोनो सिडे सिवलाम ज्युङडाटाने बेला समं <char style="ior"><ref loc="MRK 11:1-16:8">११:१—१६:८</ref></char></para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s">बप्तिस्मा याने युहन्नालो ओसोर</para>
  <para style="r">
    <ref loc="MAT 3:1-12">मत्ती ३:१-१२</ref>; <ref loc="LUK 3:1-18">लुका ३:१-१८</ref>; <ref loc="JHN 1:19-28">युहन्ना १:१९-२८</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />परमेस्वरलो ओज़ा येसु ख्रीस्टलो चाव ओसोर ऐजैडे सुरु ओटाव। <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />यसैया अगमबक्तालो उकितापटं एटाव सर्सिवले,</para>
  <para style="q1" vid="MRK 1:2">“रःङ, ङा ङाकटंवाललाई नङ भन्डा ङाःडे ङापरिःङ,</para>
  <para style="q2" vid="MRK 1:2">नोये नयेम तयार झैनेले।<note caller="+" style="x"><char style="xo" closed="false">1:२ </char><char style="xt" closed="false"><ref loc="MAL 3:1">मलाकी ३:१</ref></char></note><verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />कडिज़ मालेव बनलं टोबो किःज़्याव मीलो ओगा,</para>
  <para style="q2" vid="MRK 1:3">‘प्रभुलो ओलागिटं डोहा झैच्यो,</para>
  <para style="q2" vid="MRK 1:3">नोलो ओलागिटं येमरं सिडा झैच्यो!’”<note caller="+" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">यसैया ४०:३</ref></char></note><verse eid="MRK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4" />बप्तिस्मा झैने युहन्ना बनलं ओरोःनो नलं मीरंलाई बप्तिस्मा झोयोग्यान ऐ वार्डे प्रचार ओडोज़्याव, “जेपापलाम वोल्च्यो होसोनो बप्तिस्मा टाच्यो होकाम परमेस्वरये जेपाप छेमा डाड्यानेले।” <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />नो लेवकं स्यान्टै यहुडिया प्रडेस सोनो यरुसलेम सहरला लेने मीरं पुलुडे युहन्ना लेवकं याराव। नोराई यापापरं स्वीकार डाडे नोलो उकुइटाम यर्डन भैलं बप्तिस्मा याटाव।<verse eid="MRK 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6" />युहन्नाये उँटलो उमुःलये झैसिव क्वा क्वाइसिये, ओवाङलं छालालो वाम्फो पोसिये, सलंह कैडे सोनो बन राबं ज़्याडे लेये।<note caller="+" style="x"><char style="xo" closed="false">1:६ </char><char style="xt" closed="false"><ref loc="2KI 1:8">२ राजा १:८</ref> </char></note> <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />नोये ऐ वार्डे प्रचार ओडोव, “जो ङा भन्डा झिन्डे रानेले, हो ङा भन्डा पनि बनै ओसक्ति लेव ची ले, ङा के घोम लेडे नोलो ओपनैलो ओटस्मा पलाने हाडङका पनि ङाम्ले। <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />जेलाई ङा रीःये बप्तिस्मा झैडेङानैच्यो, हैनि पनि नोये जेलाई चोखो आत्माये बप्तिस्मा<note caller="+" style="f"><char style="fr" closed="false">1:८ </char><char style="fq" closed="false">बप्तिस्मा </char><char style="ft" closed="false">रीःल डुबैने</char></note> झैनेले।”<verse eid="MRK 1:8" /></para>
  <para style="s">येसुलो बप्तिस्मा सोनो परिछ्या</para>
  <para style="r">
    <ref loc="MAT 3:13-17">मत्ती ३:१३-१७</ref>; <ref loc="MAT 4:1-11">४:१-११</ref>; <ref loc="LUK 3:21-22">लुका ३:२१-२२</ref>; <ref loc="LUK 4:1-13">४:१-१३</ref></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />हो बेलाकं ऐ ओटाव येसु गालील प्रडेसला नासरत सहरलाम राडे युहन्नालो उकुइटाम यर्डन भैलं बप्तिस्मा ओटाव। <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />रीःलाम पुलुडे ओरावपानाज़ येसुये स्वर्ग ओफैसिव सोनो आत्मालाई परिवालो उरुपलं ओल लेवकं ओराज़्याव ओरोःङो। <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />होकामटानि स्वर्गटाम परमेस्वरलो टोबो एटाव ओगा ओराव, “नङ ङायुङ्का ङाज़ाची ङा नङसं बनै खुसि ङाले।”<note caller="+" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="GEN 21:2">सिर्जिव २१:२</ref>; <ref loc="PSA 2:7">भजनरं २:७</ref>; <ref loc="ISA 42:1">यसैया ४२:१</ref>; <ref loc="MAT 12:18">मत्ती १२:१८</ref>; <ref loc="MRK 9:7">मर्कुस ९:७</ref> </char></note><verse eid="MRK 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />आत्माये येसुलाई होपानाज़ कडिज़ मालेव बनलं ओलाङो। <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />येसु चालीस डिन समं कडिज़ मालेव बनलं ओलेव। होबेलाकं सैतानये<note caller="+" style="f"><char style="fr" closed="false">1:१३ </char><char style="fq" closed="false">सैतान </char><char style="ft" closed="false">ज़्याःराई यासेःर</char></note> परिछ्या ओडोव। येसु बनला बनकररासं बोलोङ ओलेव, होकाम स्वर्गटा कटंवालराई ओसेवा बनै याडोव।<verse eid="MRK 1:13" /></para>
  <para style="s">येसुये चार जना जलाहारिरंलाई उखुलोरं</para>
  <para style="r">
    <ref loc="MAT 4:18-21">मत्ती ४:१८-२१</ref>; <ref loc="LUK 5:1-11">लुका ५:१-११</ref>; <ref loc="JHN 1:35-42">युहन्ना १:३५-४२</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />होकाम युहन्ना झ्यालखानालं ओखोरसिव छिन्डे येसु गालीललं ओराव। होकाम परमेस्वरलो चाव ओसोर प्रचार ओडोव। <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />येसुये हैओवारो, “बेला याटाडु, परमेस्वरलो ओराज्य नजिकं राडेले। जेपापलाम वोल्च्यो, होकाम चाव सोरटं बिस्वास डाच्यो।”<note caller="+" style="x"><char style="xo" closed="false">1:१५ </char><char style="xt" closed="false"><ref loc="MAT 3:2">मत्ती ३:२</ref> </char></note><verse eid="MRK 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />येसु गालीलला समन्डरलो ओगोराटाग्यान ओनाज़्याकं सिमोन सोनो ओभाइ अन्ड्रियासलाई समन्डरलं जाल नेख्याज़्याव ओरोःङोनि। कडालेकं होनि जालाहारिनि लेवनि। <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />नोनिलाई येसुये हैओडोवनि, “ङाछिन्ट राचीन ङा जिनलाई मीराई याजालाहारि ङाझैचिन।” <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />नोनि होपानाज़ नेजालरं राःडे, येसुलो उझिन्ट नेनाव।<verse eid="MRK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19" />होकाम जामा होसैकं ओनाकं येसुये जब्डियालो ओज़ानि याकुब सोनो ओभाइ युहन्नालाई डोङ्गाटं चुङडे जाल निरुपज़्याव ओरोःङोनि। <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />येसुये होनिलाई होपानाज़ उखुलोनि, होनि नेबाबु जब्डियालाई येःन डोनेरासं डोङ्गाटंज़ राःडे येसुलो उझिन्ट नेनाव।<verse eid="MRK 1:20" /></para>
  <para style="s">भुत आत्मा लागिव मी</para>
  <para style="r">
    <ref loc="LUK 4:31-37">लुका ४:३१-३७</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />येसु सोनो उसिसरं कफर्नहुमलं यानाव, होकाम नाःसिने डिन छ्याम<note caller="+" style="f"><char style="fr" closed="false">1:२१ </char><char style="ft" closed="false">नाःसिने डिन सातालो आखिरला डिन। आव छ्याम यहुडीरं स्यान्टै यायेःन राःडे नासिरंये होसोनो परमेस्वरलो ओमहिमा डोरं।</char></note> यहुडीरं याडुप्सिने ज़ीःमलं<note caller="+" style="f"><char style="fr" closed="false">1:२१ </char><char style="ft" closed="false">यहुडीरं डुप्सिने ज़ीःम</char></note> पसिडे ओपोयोरं। <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />होला मीरं येसुये ओपोयो रोः ठैडे बक्क याटाव। कडालेकं येसुये होला मीरंलाई न्याम पैने मीरं मान्टि माङ्क, बुरु अडिकारसं ओपोयोरं।<note caller="+" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="MAT 7:28-29">मत्ती ७:२८-२९</ref> </char></note><verse eid="MRK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23" />हो बेलाकं नो यहुडीरं याडुप्सिने ज़ीःमलं टोबो माचाव आत्माये ओडापो मी लेव। नोये किःडे हैओवारो, <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />“ए नासरतला येसु, गेसं नमी कडि उलिज़्याव? नङ गेलाई नास झैने वार्डे नराव रो? ङा नङलाई ङासरेसन, नङ परमेस्वरलो चोखो उमीज़ ची।”<note caller="+" style="x"><char style="xo" closed="false">1:२४ </char><char style="xt" closed="false"><ref loc="MAT 2:23">मत्ती २:२३</ref></char></note><verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />होकाम येसुये नोलाई ऐ वार्डे ओहक्लोयो, “गाइगुइ टालेन, नोलो ओक्याङटाम पुलुडेनान।”<verse eid="MRK 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26" />हो मीलाई फङ-फङ टडे कस्सिडे किःडे नो माचाव आत्मा हो मीलो ओक्याङटाम पुलुडे ओनाव। <verse eid="MRK 1:26" /><verse number="27" style="v" sid="MRK 1:27" />होकाम होला मीरं बनै अचम्ब याटाव, होकाम यायाज़ ऐ वार्डे यापजैसिव, “आव कडि? आव के साःरौ सिछ्या ची ओलेवलेव। आवये के माचाव आत्मारंलाई पनि अडिकारसंची अरैज़्यावरं, होकाम होराई आवये ओअरैरंकं पनि याठैज़्याव ची ओलेव।”<verse eid="MRK 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28" />होकाम चानोज़ येसुये ओडोव येःनलो ओबयान गालील प्रडेस आसै-होसैयालं स्यान्टैडे ओफैलिव।<verse eid="MRK 1:28" /></para>
  <para style="s">येसुये बनै भ्या मीरं ओससोमो</para>
  <para style="r">
    <ref loc="MAT 8:14-17">मत्ती ८:१४-१७</ref>; <ref loc="LUK 4:38-41">लुका ४:३८-४१</ref></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />होकाम येसु यहुडीरं याडुप्सिने ज़ीःमलाम चानोज़ पुलुडे याकुब सोनो युहन्नानिसं सिमोन सोनो अन्ड्रियासनि निज़ीःमलं ओनाव। <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />सिमोनलो उमैज्यु ओजोरोये ठाला टिकिडे ओनैज़्याव, होकाम होला मीरं येसुलाई चानोज़ हो रोः हैयाडोव। <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />येसु नोलो ओछ्योकं ओनाव, होकाम उकुइटाम क्योःडे ओसोचोयो। होकाम होमान्त्राज़ ओजोरोये ओराःव, होकाम सोडे येसुलो ओसेवा ओडोव।<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />होछ्याम रिःमडे निमी उनुपो छिन्डे मीराई ठलिवरं सोनो माचाव आत्माये ओडापोरं स्यान्टैरंलाईज़ येसु लेवकं यारोयोरं। <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />नो सहरला स्यान्टै मी भरि झलायेमलं डुप्सिडे यालिज़्याव। <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />भ्या किसिमला रोगो लागिव बनै भ्या मीरंलाई येसुये ओससोमोरं, होकाम बनै भ्या ज़्याःरं उपुलोयोरं, हो ज़्याःराई येसुलाई यासंरेवये येसुये नो ज़्याःरंलाई ओजमाज़ पाङो मायोवरंये।<verse eid="MRK 1:34" /></para>
  <para style="s">येसुये गालीललं प्रचार ओडोव</para>
  <para style="r">
    <ref loc="LUK 4:42-44">लुका ४:४२-४४</ref></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />येसु छकाल्ने मिरःन्ने भन्डा भ्या ङाःडेज़ सोडे पाखाङ काङ्काज़ मालेव पोलं नाडे प्रार्ठना ओडोव। <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />होकाम सिमोनये ओल्स लेव ओनैरासं येसुलाई खिम्ने पाखाङ यानाव। <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />होकाम येसुलाई याडोयोपान्ट्रा नोराई हैयाडोव, “स्यान्टै मीराई नङलाई खिम्सनज़्यारं।”<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />होकाम येसुये नोरंलाई हैओडोवरं, “गराच्योके गे नजिकयाला उरुका नाङखारयालं गेनाके, होकाम नलं नाडे ङा प्रचार डोवङाडैकं, कडालेकं ङा आवलो ओलागिटंज़ ङाराव ची।”<verse eid="MRK 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 1:39" />होकाम येसुये होला गालील प्रडेसयाला यहुडीरं याडुप्सिने ज़ीःमयालं प्रचार डोडे ओबारिव बेलाकं ज़्याःरं पनि बनै उपुलोयोरं।<note caller="+" style="x"><char style="xo" closed="false">1:39 </char><char style="xt" closed="false"><ref loc="MAT 4:23">मत्ती ४:२३</ref>; <ref loc="MAT 9:35">९:३५</ref> </char></note><verse eid="MRK 1:39" /></para>
  <para style="s">येसुये टोबो मीलाई ओससोमो</para>
  <para style="r">
    <ref loc="MAT 8:1-4">मत्ती ८:१-४</ref>; <ref loc="LUK 5:12-16">लुका ५:१२-१६</ref></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />होकाम टोबो कुःरिये येसु लेवकं राडे उघुन्डा टिकिसिडे ऐ वार्डे बिन्ती ओडोव, “नइछ्या यालेखे भने नङ ङालाई ससमडुने नले।”<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />होकाम उयुङ नाडे हो मीलाई उकुइये छुडे, हैओडोव, “ङा इछ्या ङाडो, नङ गसमङनके।” <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />होमान्त्राज़ नो मीलो ओक्याङटा कोःरो ओमाःव, होकाम ओसोमो। <verse eid="MRK 1:42" /><verse number="43" style="v" sid="MRK 1:43" />होकाम होमान्त्राज़ येसुये होलाई ऐटाव कर्रा आग्या याडे उपरिःङो, <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />“रःङ, आव रोः नङ काङ्कालाई पनि हैटाडोरं, नङ सेवा डोने मीराई लेवकं नाडे सतन्सिनान होकाम नसमो रोः मीरंलाई प्रमान गटाकं वार्डे मोसालो ओआग्य अनंसार भेटी चरैडे चोखैसिने नान।”<note caller="+" style="x"><char style="xo" closed="false">1:44 </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">लेबी १४:१-३२</ref> </char></note><verse eid="MRK 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45" />होकाम हो मी पुलुडे नाडे येसुलो ओरोः माठैडे ओसोमो रोः स्यान्टैरंलाई प्रचार ओडोवरं, होकारनये येसु सहरलं सटनसिडे माबाडुये, होकाम मीरं मालेव पोयालं ओलेव। हैनि पनि मीरं चारकोनाङाम येसु लेवकं याराव।<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s">येसुये टोबो नसालो रोगो लागिव मीलाई ओससोमो</para>
  <para style="r">
    <ref loc="MAT 9:1-8">मत्ती ९:१-८</ref>; <ref loc="LUK 5:17-26">लुका ५:१७-२६</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />जामा डिनका येसु कफर्नहुमलं वोल्डे ओराव, होकाम होला मीरं येसु ज़ीःमलंज़ लिज़्या वार्ने रोः याठोयो। <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />होलं बनै भ्या मीरं याडुप्सिव होकाम ज़ीःमलं मासुन्डे झला येमकाम पाखाङ पनि पोज़ माडैरंये, येसुये होला मीरंलाई परमेस्वरलो ओबारेलं प्रचार ओडोज़्याव। <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />होकाम चार जना मीरं टोबो नसालो रोगो लागिव मीलाई घुर्डे येसु लेवकं यारोयो। <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />नलं बनै भ्या मीरं लेवरं हैजैडे हो मीलाई येसुलो ओछ्योकं मारैडुडे हो मीराई येसु उलिज़्याव सोराटं रोटं छाने कोडे, होलाम नसालो रोगो लागिव मीलाई ऐस्याडे उलिज़्याव ओटानसंज़ मेलं याकेव। <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />येसुये नो मीराई याबिस्वास रंःङडे नसालो रोगो लागिव मीलाई हैओडोव, “ए ङाज़ा नपाप छेमा याटाडु।”<verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />नकं नेबऱ्याङया सास्त्रटा न्याम पैने मीरं चुङडे यालिज़्याव, होरं यायुङलं एटाव बिचार याडोज़्याव, <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />“आव मीये कडाने ऐ लेडे ओपाङज़्याव? आव के परमेस्वरलो उबिज्याट ची। टोबो, परमेस्वरकाम उरु काङ्काये पाप छेमा डोडुवडं?”<verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />होकाम होरं एटाव बिचार डोज़्यारं वार्डे होपानाज़ येसुये ओआत्मालं सन्डे हैओवारो, “जे कडाने जियुङलं एटाव बिचार जेडोज़्याव? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />नसालो रोगो लागिव मीलाई ‘नपाप छेमा याटा’ हैडोने सजालो सै ‘सोङन, होकाम नटान छेन्डे नान’ हैडोने, कडि सजालो टा? <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />मानवालो ओज़ालाई प्रिठीबीलं पाप छेमा डोने अडिकार ले वार्ने रोः सन्डेनैच्यो।” होकाम येसुये हो नसालो रोगो लागिव मीलाई हैओडोव, <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />“ङा नङलाई हैङाडानज़्या, गोसोनके, नटान गछेन्के, होकाम नज़ीःमडे गनानके।”<verse eid="MRK 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12" />नो मी सोडे, चानोज़ ओटान छेन्डे हो मीराई याङाःकाम ओनाव। होला स्यान्टै मी भरि बक्क टाडे हैयावारो, “एटावके खर्कज़ गेरोःङो माले” वार्डे परमेस्वरलो ओप्रसन्सा याडोव।<verse eid="MRK 2:12" /></para>
  <para style="s">येसुये लेबीलाई उखुलो</para>
  <para style="r">
    <ref loc="MAT 9:9-13">मत्ती ९:९-१३</ref>; <ref loc="LUK 5:27-32">लुका ५:२७-३२</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />येसु फरि टखेप गालील डहंलो ओगोराटं ओनाव। होकं बनै भ्या मीरं येसु लेवकं याराव, होकाम येसुये हो मीरंलाई ओपोयोरं। <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />होकाम येसु ओनाज़्याकं अल्फयसलो ओज़ा लेबीलाई सिरमा डुप्नेराई यापोलं चुङसिडे उलिज़्याव ओरोःङो, होकाम नोलाई हैओडोव, “ङाछिन्ट गराङन्के।” हो च्याङसिडे येसुलो उझिन्ट ओराव।<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />होकाम येसु लेबीलो उज़ीःमलं काङ ज़्याने चुङडे उलिज़्याकं बनै भ्या सिरमा डुप्नेरं सोनो पापीरं पनि येसु सोनो उसिसरासं चुङडे यालिज़्याव। कडालेकं येसुलो उझिन्ट नाने मीरं बनै भ्या लेवरं। <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />येसुये पापीरं सोनो सिरमा डुप्नेरासं चुङडे ओज़्योज़्याव रःङडे फरिसी<note caller="+" style="f"><char style="fr" closed="false">२:१६ </char><char style="fq" closed="false">फरिसी </char><char style="ft" closed="false">येसुलो ओसमयका पैने मीरं</char></note>रासंका न्याम पैने मीराई येसुलो उसिसरंलाई हैयाडोवरं, “नोये कडाने सिरमा डुप्नेरं सोनो उरु पापीरासं चुङडे ओज़्योज़्याव?”<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />हो ठैडे येसुये नो मीरंलाई हैओडोवरं, “माठलिवरंलाई बैड माचाहिये, रोगीरंलाई याज़ चाहिये। ङा सहि मीराई यालागिटं ङाराव माङ्क, ङा के पापीरंलाई खुल्ने ङाराव ची।”<verse eid="MRK 2:17" /></para>
  <para style="s">उपासिने बारेलं प्रस्न</para>
  <para style="r">
    <ref loc="MAT 9:14-17">मत्ती ९:१४-१७</ref>; <ref loc="LUK 5:33-39">लुका ५:३३-३९</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />टखेप बप्तिस्मा याने युहन्नालो उसिसरं सोनो फरिसीरं उपासिडे यालिज़्याव। नेबऱ्याङया मीरं राडे येसुलाई हैयाडोव, “युहन्नालो उसिसरं सोनो फरिसीराई यासिसरं उपासिरंये होकाम नङ नसिसरं कडा माउपासिरं?”<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />येसुये होरंलाई हैओडोवरं, “डुलाहा जन्तिरासं उलिज़्याकंज़ जन्तिरं उपासिरं डोरो? डुलाहा जन्तिरासं ओलेव समं नोरं माउपासिरंये <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />होकाम बेला रानेले, जोकं डुलाहालाई जन्तिराई लेवकाम टाडा झैनेलेरं, होकं होरं उपासिनेलेरं।”<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />“काङ्कायेज़ पुरानो क्वाटं साःरौ क्वालो टाला माटालिव, मानिके पुरानो क्वा चिडे टालिसिव टाला सेलसिडे हाइसिये, होकाम चिउ झन माचाव रंःनये। <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />काङ्कायेज़ आलो मड्डलाई पुरानो पिर्गुललं माझाव, मानिके हो मड्डये छालालो पिर्गुललाई अचीचिवये, होकाम पिर्गुल सोनो मड्ड नेबऱ्याङज़ खेर्डे नाये। हैजैडे आलो मड्डलाई साःरौ जालंज़ नैसिये।”<figure style="fig" alt="Wineskin bag" file="lb00145c.tif" size="col" copy="Horace Knowles ©" ref="२:२१">पिर्गुल</figure><verse eid="MRK 2:22" /></para>
  <para style="s">नाःसिने छ्यामका प्रभु</para>
  <para style="r">
    <ref loc="MAT 12:1-14">मत्ती १२:१-१४</ref>; <ref loc="LUK 6:1-11">लुका ६:१-११</ref></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />टछा नाःसिने डिन छ्याम येसु उसिसरासं अन्न लेव येःङलाग्यानटं यानाज़्याव। होलाग्यानटं यानाज़्याकं उसिसराई याबै-याबैटं अन्नलो ओबाला याटिव। <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />नो रःङडे फरिसीराई येसुलाई हैयाडोव, “रःङखेने, नाःसिने डिन छ्याम जो माडोने वार्सिवले आवरं कडाने होज़ याडोज़्याव?”<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />येसुये होरंलाई हैओडोवरं, “जो बेलाकं डाउड सोनो ओल्स लिज़्यावरं ज़्याव माडैडे याकरेव बेलाकं डाउड कै ओलेव? कडा जे खर्कज़ जिम्परिये रो? <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />मुख्या सेवा डोने मी अबियाठारलो ओपालालं डाउड परमेस्वरलो उज़ीःमलं उपसिव, होकाम परमेस्वरलाई चरैःसिव बरे ओज़्योव, नो बरे मुख्या सेवा डोने मीकाम उरु काङ्कायेज़ ज़्याने माटाये, हो बरे ओल्स लेनेरंलाई पनि ओयोवरं।”<verse eid="MRK 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />होरंलाई येसुये हैओडोवरं, “नाःसिने डिन मीलो ओलागिटं टाव ची, मीलाई नाःसिने डिनलो ओलागिटं झैसिव माङ्कची। <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />हैजैडेज़ मानवालो ओज़ा नाःसिने डिन छ्यामका पनि प्रभु ची।”<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s">उकुइ स्याङो मी</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />होकामटानि फरि टखेप येसु यहुडीरं याडुप्सिने ज़ीःमलं ओनाव। होलं टोबो उकुइ स्याङो मी लेव। <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />कैलेकं नाःसिने डिनछ्याम हो मीलाई याससोमोखे भने आरोप लैने वार्डे मीरं येसुलो उचिवारे चुङडे यालिज़्याव। <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />होकाम येसुये उकुइ स्याङो मीलाई हैओडोव, “ङाःङ गरानके।” <verse eid="MRK 3:3" /><verse number="4" style="v" sid="MRK 3:4" />होकाम येसुये नो मीरंलाई हैओडोवरं, “नाःसिने डिन छ्याम चाव येःन डोने सै माचाव येःन डोने, पोहोन जोगैने सै नास झैने कडि येःन चाव?”</para>
  <para style="p" vid="MRK 3:4">होकाम नोरं काङ्का पनि गाइगुइ मालेरंये। <verse eid="MRK 3:4" /><verse number="5" style="v" sid="MRK 3:5" />नो मीराई यायुङ खाव उलिज़्याव रःङडे येसुये उयुङ माचाव झैडे होला स्यान्टै मीरंलाई उरिसैये टखेप ओरोःङोरं, होकाम हो मीलाई ऐ ओडोव, “नकुइ गपंलाके।” होये उकुइ ओपंलाव होकाम उकुइ ओसोमो। <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />होकाम फरिसीरं होलाम पुलुडे नाडे कैजैडे येसुलाई नास झैने वार्डे नोराई चानोज़ हेरोडलो उमीरासं डुप्सिडे येसुलो उबिरोडलं सल्ला याडोव।<verse eid="MRK 3:6" /></para>
  <para style="s">डह गोराटं माहुले मीरं</para>
  <para style="r">
    <ref loc="MAT 12:15-16">मत्ती १२:१५-१६</ref>; <ref loc="LUK 6:17-19">लुका ६:१७-१९</ref></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />येसु उसिसरासं गालील डह लेवडे ओनाव, होकाम गालीललाम माहुले मीरं येसुलो उझिन्ट यहुडिया, <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />यरुसलेम, इडुमीआ प्रडेसलाम, यर्डन भै होपटा टुरोस सोनो सीडोनलो ओछ्योयालाम माहुले मीरं येसुये ओडोव अचम्बला येःनलो ओबारेलं ठैडे येसु लेवकं याराव। <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />माहुले मीराई ओललाई टासिरंकं वार्डे उसिसरंलाई ओलागिटं टोबो आलिज़ा डोङ्गा तयारं झोयो उपरिःङोरं। <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />येसुये बनै भ्या मीरंलाई ओससोमो कारनये रोगो लागिव मी भरिये येसुलाई छुने वार्डे बनै के-केः याछुइसिरिव। <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />जोकं माचाव आत्माराई येसुलाई रःङरं, होकंज़ येसुलो ओङाःकं फुलुप्सिडे ऐ वार्डे किःरंये, “नङ परमेस्वरलो ओज़ा ची।”<verse eid="MRK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12" />होकाम येसुये, आव ङाडोव येःनटं ङामिन टारैच्यो वार्डे होरंलाई कर्रा आग्या ओयोवरं।<verse eid="MRK 3:12" /></para>
  <para style="s">बारं जना प्रेरितरं ओझोयोरं</para>
  <para style="r">
    <ref loc="MAT 10:1-4">मत्ती १०:१-४</ref>; <ref loc="LUK 6:12-16">लुका ६:१२-१६</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />होकामटानि येसु डान्डाटं पुलुडे उयुङ्का मीरंलाई उखुलोरं, होकाम होरं येसु लेवकं याराव। <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />येसुये ओल्स लेने लागिटं सोनो प्रचार डोव परिःङनेलो लागिटं बारं जनारंलाई उरुजिवरं। होकाम येसुये होरंलाई प्रेरित यामिन नैडेओयोवरं। <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />होकाम होरंलाई ज़्याःरंलाई हाइने अडिकार पनि ओयोवरं।<verse eid="MRK 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16" />हो बारंजना प्रेरितरं आवरंज़ सिमोन, जोलाई येसुये उमिन पत्रुस ओनैड्योव, <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />जब्डियालो ओज़ा याकुब सोनो याकुबलो ओभाइ युहन्नानिलाई बोअनर्गेस वार्ने मिन ओनैड्योवनी। आवलो ओमाने गर्जिनेलो ओज़ारं टाये। <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />अन्ड्रियास, फिलिप, बारठोलोमाइ, मत्ती, ठोमा, अल्फयसलो ओज़ा याकुब, ठेडियस, सिमोन कनानी, <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />होसोनो यहुडा इस्करियोत, जोये येसुलाई ढोका ओयोव।<verse eid="MRK 3:19" /></para>
  <para style="s">येसु सोनो बालजिबुल</para>
  <para style="r">
    <ref loc="MAT 12:21-23">मत्ती १२:२१-२३</ref>; <ref loc="LUK 11:14-21">लुका ११:१४-२१</ref></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />होकाम येसु फरि ज़ीःमडे ओनाव। फरि पनि मीरं बनै भ्या याडुप्सिव, येसु सोनो उसिसराई काङज़ ज़्याव माडैरंये। <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />आव रोः ठैडे येसुलो उज़ीःमलारं, येसुलाई चनरिःने याराव, कडालेकं मीराई येसुलाई उडिमाक ओपोकं माले वार्डे हैयाडोज़्याव।<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />यरुसलेमलाम राव सास्त्रटा न्याम पैने मीराई हैयावारो, “नोसं बालजिबुल लिज़्या, हो ज़्याःराई यासेःर मुन्घुलो ओसक्तिये ज़्याःरंलाई पुलैज़्यावरं।”<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />होकाम येसुये होरंलाई ओछ्योकं खुल्डे सात्रोङाम हैओडोवरं, “सैतानये सैतानलाई कैजैडे हाइडुव?” <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />कोइ राज्यलं या-याज़ मामिलिरंखे भने हो राज्य नास टाडे नाये। <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />कोइ ज़ीःमलं पनि या-याज़ मामिलिरंखे भने हो ज़ीःम पनि नास टाडे नाये। <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />कडालेकं ज़्याःये ज़्याःलो उबिरोडि टाडे फुट यारोयोखे भने नो नास टाये, कडावार्क होलो नास टाने ओबेला राव टाये।<verse eid="MRK 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27" />काङ्कायेज़ बल्ल्या मीलाई माकीडे उज़ीःमलं पसिडे ओढन पैसा मालुटिडुव। ङाःडे नोये नो बल्ल्या मीलाई किडे मान्त्राज़ नो मीलो उज़ीःम लुटिडुव। <verse eid="MRK 3:27" /><verse number="28" style="v" sid="MRK 3:28" />ङा डस्साज़ जेलाई हैङाडाच्योज़्या, मीलो स्यान्टै ओपाप छेमा टाने ले, सोनो परमेस्वरलो उबिरोड डोनेलाई छेमा टानेले, <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />हैनि पनि चोखो आत्मालो उबिरोड डाडे बिज्यात झैनेलाई, खर्कज़ छेमा टाने माले, कडालेकं हो मी खर्कज़ छेमा माटाने पापी येःन्ट डोसि टानेले। <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />मीराई “आवसं माचाव आत्मा लिज़्या” वार्डे येसुलाई हैयाडोव कारनये आव रोः ओपाङो।<verse eid="MRK 3:30" /></para>
  <para style="s">येसुलो वामा सोनो ओभाइरं</para>
  <para style="r">
    <ref loc="MAT 12:46-50">मत्ती १२:४६-५०</ref>; <ref loc="LUK 8:19-21">लुका ८:१९-२१</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />होकाम येसुलो वामा सोनो ओभाइरं राडे, पाखाङज़ च्याङसिडे येसुलाई खुल्ने वार्डे मी यापरिःङो। <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />येसुलो ओछ्योयालं माहुले मीरं चुङडे यालिज़्याकं हो मीराई येसुलाई हैयाडोव, “रःङखेने नामा, नभाइरं सोनो नबैनीरं नङलाई पाखाङ खिम्सनज़्यारं।”<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />येसुये नोरंलाई हैओडोवरं, “ङामा सोनो ङाभाइरं काङ्कारं?” <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />होकाम होकाला मीरं लेवडे रःङडे येसुये हैओवारो, “गरःङच्योरंके, आवरंज़ ङामा सोनो ङाभाइरं। <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />कडालेकं जोरं परमेस्वरलो उइछ्या अनंसार बारं होरंज़ ङामा, ङाभाइरं सोनो ङाबैनीरं।”<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">ढुर वानेलो ओसात्रो</para>
  <para style="r">
    <ref loc="MAT 13:1-23">मत्ती १३:१-२३</ref>; <ref loc="LUK 8:4-15">लुका ८:४-१५</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />येसु फरि गालील डहंलो ओछ्योकं चुङडे पैने सुरु ओडोव, हो बेलाकं ओछ्योयालं बनै भ्या मीरं याडुप्सिव। मीरं आढङ भ्या लेवरं, येसु डहला टोबो डोङ्गाटं पुलुडे होटंज़ उचुङो। होकाम मी भरि डहंलो ओछ्योकं नामलं च्याङसिव लेवरं। <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />येसुये सात्रोङाम नोरंलाई भ्या रोः ओपोयोरं। येसुये ऐ वार्डे सिछ्या ओयोवरं,<verse eid="MRK 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 4:3" />“ठैच्यो! टोबो ढुर वाने मी ढुर वाने ओनाव। <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />ढुर ओवाज़्याकं कोइ येम छ्योयालं याटेःव, नो येमछ्योयाला टेःव ढुररं बाज़ारं राडे याज़्योव। <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />कोइ ढुर ढान्ड लेव येःङलं याटेःव, गम टिगिडा टाडे चानोज़ उपरिव। <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />निमीये उहिपो बेलाकं ओजरा नामलं भ्या मागाडिसिव टाडे चानोज़ ओठोङो। <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />कोइ ढुररं ज़ु घार्ल याटेःव। होकाम ज़ुरं घ्योडे नोलाई याछ्यापो होकाम पिपिरुरु टाडे ओसै माझाडे ओडान्ठ्या याटाव। <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />होकाम कोइ ढुर के गमस्यालं ओटेःव। परिडे घ्योडे ओसै बनै झाडे कोइये तीस गुना, कोइ साठी गुना कोइये, सय गुना बनै ओसोयो।”<verse eid="MRK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9" />येसुये होला ठैनेरंलाई हैओडोवरं, “जो मीलो ओना ले हो मीये ओठोयोकं।”<verse eid="MRK 4:9" /></para>
  <para style="s">सात्रोङाम कडाने पाङने</para>
  <para style="r">
    <ref loc="MAT 13:10-17">मत्ती १३:१०-१७</ref>; <ref loc="LUK 8:9-10">लुका ८:९-१०</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />येसु ओबाठंङ उलिज़्याकं मीरं यानाव झिन्डे बारं जना उसिसरं सोनो ओल्स बारिज़्याव मीराई येसुलाई नझाव सात्रोलो ओमाने कडि वार्डे यापजोयो। <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />येसुये होरंलाई हैओडोवरं, “जेलाई परमेस्वरलो ओराज्यला गुप्त रोःरं स्यान्टै प्रस्टज़ यासिव लिज़्या,” बुरु यहुडीरंकाम उरुका मीरंलाई के सात्रोङामज़ हैडाने टाज़्या। <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />हैजैडे,</para>
  <para style="q1" vid="MRK 4:12">नो मीराई भाल्सिने के भाल्सिज़्यारं,</para>
  <para style="q2" vid="MRK 4:12">हैनि पनि मारःङरंये।</para>
  <para style="q1" vid="MRK 4:12">ठैने के ठैज़्यारं,</para>
  <para style="q2" vid="MRK 4:12">हैनि पनि माबुझिरंये।</para>
  <para style="q1" vid="MRK 4:12">नेटाव याम्टाखिनके, परमेस्वर लेवडे यायुङ यासोवोलरंहो,</para>
  <para style="q2" vid="MRK 4:12">होकाम नोये यापाप छेमा याडोड्योवरंहो।<note caller="+" style="x"><char style="xo" closed="false">४:१२ </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">यसैया ६:९-१०</ref> </char></note><verse eid="MRK 4:12" /></para>
  <para style="s">ढुर वाने सात्रोलो ओमाने</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />येसुये नो मीरंलाई हैओडोवरं, “जे आव सात्रोलो ओमाने जेमसनये? आव सात्रोलो ओमाने जेमसनखे भने छुटं सात्रोरं झन कैजैडे जेसन्केड? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />ढुर वानेये परमेस्वरलो ओपाङ वावये। <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />कोइ मीरं येम छ्योयाला वासिव ढुर स्यानाव टारंये। नोरं परमेस्वरलो ओपाङ याठोयोपानाज़ यायुङला वासिव बचनलो ढुर सैतानये लाङोये। <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />हैजैडेज़ ढान्डला परिव ढुर स्यानाव मीरं एटाव टारं, जोराई बचन ठैरंये होमान्त्राज़ रेङये-रेङये यायुङलं नैरंये। <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />होकाम नोराई याजरा याम्झावये नोरं भ्या माटिकिडुरं। होकाम बचनलो ओकारनये डुखं डैरं होसोनो सहटैसिव निःरं, नोरं चानोज़ ढलिरंये। <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />ज़ुराई याघार्ला परिव ढुर नोरंज़, जोराई परमेस्वरलो ओपाङ ठैरं, <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />होकाम आव प्रिठीबीला चिन्ता, ढन सोनो उरु रोःराई यालोभये बचनलाई मेःरंये, होकाम ओडान्ठ्या ओटाव स्याव टारंये। <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />चाव गमस्या लेव येःङलं वासिवरं नोरंज़ जोराई परमेस्वरलो ओपाङ ठैडे हो अनंसार बाडे तीस, साठी सोनो सय गुना यासै झारंये।”<verse eid="MRK 4:20" /></para>
  <para style="s">डियाटोटा नैसिव टुक्कि</para>
  <para style="r">
    <ref loc="LUK 8:16-18">लुका ८:१६-१८</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />येसुये हो मीरंलाई टोबो एटाव सात्रो झाडे ओयोवरं, “काङ्का मीये पनि भाङ खाङडे पराटये माकपो होसोनो खाटं डुङलं मानोयो। होकाम नोये डियाटोटं नैने वार्डेज़ माखाङोये डोरो? <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />हो मान्टि जो बस्त मोःडे नैसिवले हो पाखाटं रःन्नेले, जो बस्त कप्सिव ले हो फैसिनेले। <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />जो मीलो ठैने ओना ले होये ओठोयोकं।”<verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />येसुये फरि नोरंलाई हैओडोवरं, “जे जो रोः जेठैज़्या नो रोः चावसं ठैच्यो। जो जालाम जे फोडे जेयोज़्यारं हो जालामज़ फोडे जे पनि डैनेजेले। होकाम जे झन भ्या डैनेजेले। <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />कडालेकं जोसं लिज़्या होये उरु पनि डैनेले, होकाम जोसं माले होसं लिज़्याव पनि नान्सिने ले।”<verse eid="MRK 4:25" /></para>
  <para style="s">सम्फरिव ढुरलो ओसात्रो</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />येसुये फरि ऐ ओवारो, “परमेस्वरलो ओराज्य एटाव ची, टोबो मीये येःङलं ढुर वावये, <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />होकाम नो मी रिलं ओइस्यानि पनि, लाकं सन्सिव ओलेनि पनि नो ढुर लाकं रिलं परिये, घ्योये। नो ढुर कैजैडे परिडे ओघ्योज़्याव हो नो मीये मासोनो। <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />येःङये ओल्ज़ नो पिमा ढुरलाई सपरिवये होकामटा ङाःडे कोङ्कल्याडे घ्योडे ओबाला ठाङ्डे ओसै झावये। <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />अन्न उमिःनो मान्त्रा नो मीये हङस्याये क्यावये, कडालेकं बाली सयारिने बेला राव टाये।”<verse eid="MRK 4:29" /></para>
  <para style="s">सुरसुङलो उढुर</para>
  <para style="r">
    <ref loc="MAT 13:31-32">मत्ती १३:३१-३२</ref>,<ref loc="MAT 13:34">३४</ref>; <ref loc="LUK 13:18-19">लुका १३:१८-१९</ref></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />येसुये फरि हैओवारो, “परमेस्वरलो ओराज्यलाई गे कडिसं गेडान्जिके? होसोनो कडि सात्रो झाडे आवलो ओमाने ङापलाड्याच्यो के? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />परमेस्वरलो ओराज्य टोबो सुरसुङलो उढुर स्यानाव लिज़्या, नो येःङलं वासिये। स्यान्टैराई भन्डा आलिज़ा ढुर आवलोज़ ओटानि पनि <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />नो नामलं वासिये होकाम नो परिडे घ्योये, स्यान्टै ङःनराई याबिरवा भन्डा नो घ्योव टाये, होसोनो घ्यो-घ्योव ओखार ओखिर झावये होकाम नमटा भुर्ज़्याव बाज़ारं ओछायाँलं याज़ीःम झैरंये।”<verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />मीराई याबुझिडुव समं परमेस्वरलो ओपाङ गुबुझिरंकं वार्डे एटाव बनै भ्या सात्रोङाम नोरंलाई ओपोयोरं। <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />येसुये सात्रो माझाडे मीरंलाई मापोयोरंये, उसिसरंलाईयाज़ याबाठङ यालेकं नो सात्रोलो ओमाने खुलिड्योवरंये।<verse eid="MRK 4:34" /></para>
  <para style="s">येसुये घुइरंलाई ओठकनोयो</para>
  <para style="r">
    <ref loc="MAT 8:18">मत्ती ८:१८</ref>,<ref loc="MAT 8:23-27">२३-२७</ref>; <ref loc="LUK 8:21-25">लुका ८:२१-२५</ref></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />हो छ्याम रीःमडे येसुये उसिसरंलाई हैओडोवरं, “बा, गे डहं होपंटं गेनाके।” <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />माहुले मीरासं याभासिव पाना येसु जो डोङ्गाटं पुलुडे उलिज़्याव हो डोङ्गाटंज़ चुसिडे उसिसरासं यानाव यासं उरु डोङ्गारं पनि लेवरं। <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />यानाज़्याकं बनै घ्योव घुइरं राडे डोङ्गालाई रीःलं पल्टैने ओपानो रीःलो ओछल्का डोङ्गालं पसिडे डोङ्गालाई बुडैने ओपानो। <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />होबेलाकं येसु डोङ्गाटं उझिन्ङ उगुम झैडे ऐस्याडे ङःल्डे उलिज़्याव। उसिसराई येसुलाई सोचैडे हैयाडोव “गुरबा गे के बुडिडे गिसिरिडुखे वार्ने नङलाई चिन्ता माले?”<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />येसु सनसिडे च्याङसिडे घुइरंलाई हक्लैडे रीःलाई पनि “चिम लेन! गाइगुइटालेङन” वार्डे आग्या ओयोव। होकाम बतासं ओठकंनिव, रीः पनि ओअडिव। होकाम स्यान्टै च्याम-चिम ओटाव। <verse eid="MRK 4:39" /><verse number="40" style="v" sid="MRK 4:40" />येसुये नोरंलाई हैओडोवरं “जे कडाने जेछेज़्याव? जेसं बिस्वासज़ उम्लिज़्यावरो?”<verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />नोरं बनै छेडे या याज़ हैयावारो, आव मी काङ्का? घुइरंये सोनो रीःलो ओछल्काये पनि ओपाङची ठैज़्यारं।<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s">येसुये माचाव आत्मा लेव मीलाई ससोमोये</para>
  <para style="r">
    <ref loc="MAT 8:28-34">मत्ती ८:२८-३४</ref>; <ref loc="LUK 8:26-39">लुका ८:२६-३९</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />येसुरं उसिसरासं गालील डह होपंटं गेरासेनस प्रडेसलं याराव। <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />येसु डोङ्गाटाम उझरिवपानाज़ माचाव आत्माये क्योःडे ओनैज़्याव टोबो मी खाडर लेव पोलाम राडे येसुसं ओडैसिव। <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />नो मी एकसप्ड्या खाडरयालंज़ लेये। नोलाई काङ्काये पनि साङ्गलये माकीडुरंये। <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />नो मीलाई भ्या पालाज़ क्योःडे साङ्गलये किडे हलालं झासिव लेव। साङ्गलये याकिनि पनि पाटा नि पटं छाङडे हलारं पनि केःडे ख्याने सक्ति लेव, हैजैडे काङ्कायेज़ माक्योःडुरंये। <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />नो, लाकं रिलं एकसप्ड्याज़ खाडरयालं, डान्डायालं किःवग्यान ओक्याङयालं लुङये रुमडे बारिये।<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />नोये येसुलाई टाडाङं ओरोःङोपानाज़ ज़ोरिडे उघुन्डा टिकिडे ओखङटाम ढो ओडोव। <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />बनै कस्सिडे किःडे ऐ ओवारो, “ए घ्योव परमेस्वरलो ओज़ा येसु, ङा नङसं कडि समन्ड उलिज़्याव ड? परमेस्वरलो उमिनङाम ङा नङलाई हैङाडान, ङालाई डुखं टायाङ।” <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />कडालेकं येसुये होलाई ए माचाव आत्मा नो मीलो ओक्याङटाम पुलुङंन वार्डे ङाःडेज़ हैडाडे ओनैज़्याव।<verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />येसुये नोलाई हैओडोव, “नमिन कडि?”</para>
  <para style="p" vid="MRK 5:9">नोये हैओवारो, “ङा ङामिन के ‘फौजी’ ची गे के बनै भ्या ची गेले।” <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />नो माचाव आत्माराई येसुलाई ऐ वार्डे बनै बिन्ती याडोव, गेलाई आव पोलाम टापुलैसि।<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />नो बेलाकंज़ याछ्योका डान्डाटं घ्योव टबगाल वोरं यालाज़्याव। <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />नो माचाव आत्माराई येसुलाई “गेलाई नो वोराई याक्याङटं नाव गयासिके गे नोराई लेवटंज़ गेपंसि” वार्डे बिन्ती याडोव। <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />येसुये नोरंलाई गनाच्योके वार्डे हैओडोरंकं नो माचाव आत्मारं नो मीलो ओक्याङटाम पुलुडे वोराई याक्याङटं यापसिव। होमान्त्राज़ नो वोरं डान्डाटाम मेडे उरालाडे गुर्किडे रहलं टेःडे होलंज़ बुडिडे यासिव। नो वोराई याबगाललं नेहजारया लेवरं।<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />नो रःङडे वो ग्वालारं याछ्यासैये ढोङ्डे सहर, नाङखारयालं बात्रा याडोनाव। नो रोः ठैने भरि कै ओटाव वार्डे यारःङरिव। <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />नो मीरं येसु लेवकं याराकं नो फौजी ज़्याः लागिव मी ज़्याःराई राःडे ओक्वारं क्वाइसिडे चावसंज़ सम्डे चाव युङसं चुङडे उलिज़्याव रःङडे रःङने मीरं बनै याछेव। <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />नो रःङनाव मी भरिये मारःङनाव मीरंलाई ज़्याः लागिव मीलाई सोनो वोरंलाई कै ओटाव वार्डे हैयाडोनावरं।<verse eid="MRK 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 5:17" />हैजैडे आव गेरासेनस प्रडेसलाम पुलुडे गनानके वार्डे येसुलाई बिन्ती याडोव।<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />येसु डोङ्गाटं उपुलुनारिज़्याकं नो ज़्याः लागिव मीये ङालाई पनि नङसं लाङसंङ वार्डे बिन्ती ओडोव।<verse eid="MRK 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 5:19" />येसुये नो माचाव आत्माये ओडापो मीलाई ओल्स लाङने माभनड्योवये “बुरु नङ नज़ीःमडे नाडे ननै नमीरंलाई प्रभुये ङालाई डया डाडे बनै घ्योव येःन ओडाड्याङो वार्डे हैडोनारं” वार्डे येसुये हैओडोव।<verse eid="MRK 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 5:20" />हैजैडे नो मी डेकापोलिस नाङखार भरिलं नाडे येसुये ओलागिटं डाडेओयोव बनै घ्योव येःनलो प्रचार ओडोनाव। नो रोः ठैने मी भरि बनै अचम्बज़ याटाव।<verse eid="MRK 5:20" /></para>
  <para style="s">याइरसलो मेमा ओज़ा सोनो येसुलो ओक्वा छुने मेमा</para>
  <para style="r">
    <ref loc="MAT 9:18-26">मत्ती ९:१८-२६</ref>; <ref loc="LUK 8:40-56">लुका ८:४०-५६</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />येसु फरि डोङ्गाटंज़ वोल्डे डह आफंटं ओराकं बनै भ्या मीरं ओछ्योयालं याडुप्सिव। ओल डह छ्योकंज़ उलिज़्याव। <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />नो बेलाकंज़ यहुडीरं याडुप्सिने ज़ीःमला टोबो याइरस उमिन लेव सेःर मी राडे, येसुलाई रःङडे येसुलो ओखङटंज़ उफुलुप्सिव, <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />“ज़ीमज़ा मेमाङाज़ा सिनेपान्ज़्या राडे नोलो ओक्याङटं नकुइ नैडे नयोखिन नो सम्डे बान्चिने ले” वार्डे बिन्ती ओडोव।<verse eid="MRK 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24" />येसु नो मीसंज़ ओनाव। बनै भ्या मीरं येसुलो उझिन-उझिन आसै-होसै यालं केःकेः याछुइसिनाव।<verse eid="MRK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25" />नो मीराई याखार्ल बार बर्सकाम्टानि ओक्याङटाम झी भोने रोगो लागिव टोबो मेमा पनि लेव। <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />नो मेमा सम्नेलो लागिटं बैडरं लेवकं नाडे ओल्स लिज़्याव स्यान्टै ओढन सम्पति खेम्डे पनि मासमये झन भ्या ठलिडे उलिज़्याव। <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />येसुलो ओबारेलं नो मेमाये ठैडेओनैज़्याव, हैजैडे मीराई याखार्ल पसिडे येसुलो उझिनङाम राडे ओक्वाटं उछुव। <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />नो मेमाये उयुङ-उयुङलं, “येसुलो ओक्वाटं मान्त्राज़ छुवङाडैनि पनि ङासम” वार्डे हैओवारो।<verse eid="MRK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29" />येसुलो ओक्वा उछुवपानाज़ नो मेमालो ओक्याङटाम झी भोने रोगो ओसोमो, नो रोगो ओसोमो ओक्याङटंज़ ठा ओसोनो।<verse eid="MRK 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 5:30" />होपानाज़ येसुये ओक्याङटाम सक्ति उपुलुव ठा ओसोनो होकाम उझिन्डे न्याःडे “काङ्काये ङाक्वा उछुड्याङो?” वार्डे हैओडोवरं।<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />येसुलो उसिसराई आला मीरं केःकेः छुइसिवलं पनि नङ कडि “काङ्काये ङालाई उछुसोङो?” नवार्ज़्याव वार्डे हैयाडोव।<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />होकाम ङालाई छुने काङ्का वार्डे येसुये आडे होडे ओरोःङो। <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />नो मेमाये ङासमडुखे वार्ने सन्डे छेडे गुये-गुये राडे येसुलो ओखङटं फुलुप्सिडे ओललाई कै ओटाव नो स्यान्टै सत्य रोः येसुलाई हैओडोव। <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />येसुये हैओडोव, “ए मेमाङाज़ा नबिस्वासयज़ नङलाई ससम्डे नैसोनो। चावसं नान। नो रोगो ओसम्क।”<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />येसु नो मेमासं ओपाङज़्याकज़ यहुडीरं याडुप्सिने ज़ीःमला सेःर मीलो उज़ीःमङाम मीरं राडे “आबो गुरबालाई कडाने डुखं नयोज़्याव? मेमा नज़ा के यासिडु” वार्डे हैयाडोव।<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />नो मीराई यापाङ माठैडे येसुये यहुडीरं याडुप्सिने ज़ीःमला सेःर मी याइरसलाई “टाछेन बिस्वास याज़ डो” वार्डे हैओडोव। <verse eid="MRK 5:36" /><verse number="37" style="v" sid="MRK 5:37" />येसुये पत्रुस, याकुब सोनो याकुबलो ओभाइ युहन्नालाई याज़ ओल्स ओलाङोरं, उरुकारंलाई मालाङोरंये। <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />येसुरं यहुडीरं याडुप्सिने ज़ीःमला सेःर मीलो उज़ीःमकं याकेराकं मीरं बनै कस्सिडे याघरज़्याव येसुये ओरोःङो। <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />येसु नो ज़ीःमलं पसिडे होला घर्ज़्याव मीरंलाई हैओडोवर, “जे कडाने जेघर्ज़्याव? आव लुज़ा सिव माङ्कची ऐज़ ऐस्याडे उलिज़्याव ची।”<verse eid="MRK 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40" />येसुलो ओपाङ ठैडे मीरं बनै यासाःव। येसुये मी भरिरंलाई पाखाडे पुलैडे लुज़ालो ओबाबु, वामा सोनो सोमबऱ्याङ उसिसरंलाई लाङडे लुज़ा लेव पोकं यानाव। <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />नो लुज़ालो उकुइटं क्योःडे येसुये हैओडोव, “तालिता कुमी।” तालिता कुमीलो ओमाने ए बची गोसोनके।<verse eid="MRK 5:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42" />होपानाज़ नो लुज़ा ठर्च्याङसिडे आडे होडे ओबारिव। नो लुज़ा बारं बर्सका लेव। नो रःङडे मीरं बनै अचम्ब याटाव। <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />होकाम येसुये ओल्स लेनेरंलाई ऐ वार्डे कर्रा आग्या ओयोवरं, “आव रोः काङ्कालाईज़ हैटाडाच्योरं” होकाम फरि हैओडोवर, “आव लुज़ालाई ज़्याने ज़्याव रैडे याच्यो।”<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s">नासरतलं येसुलाई बिस्वास माडोरंये</para>
  <para style="r">
    <ref loc="MAT 13:53-58">मत्ती १३:५३-५८</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />येसु नलाम पुलुडे ओनाङखारलंज़ ओनाव। उसिसरं पनि ओल्सज़ यानाव <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />नाःसिने डिन छ्याम यहुडीरं याडुप्सिने ज़ीःमलं येसुये स्यान्टैरंलाई ओपोयोरं। नो रोः ठैने भ्या मीरं बनै अचम्ब टाडे हैयावारो, “आव मीये आव रोः काङाम ओसोनो? आवलाई यासिव ग्यान खैटानाव? खैटाव सक्तिला येःनरं आवलो उकुइटाम टाज़्यारं? <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />आव नो सिङ टुःने येःन डोने मी माङ्क डोरो? आव के मरियमलो ओज़ा याकुब, योसेफ, यहुडा सोनो सिमोनराई याडाज्यु माङ्कडोरो? आवलो ओबैनीरं गेसंज़ याम्लिज़्याव डोरो?” होकाम हैलेडे नोरं येसुलाई बिस्वास डोने माभनरंये।<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />येसुये नोरंलाई हैओडोवरं, “अगमबक्तालाई ओडेसलं, ओभाइरं सोनो उज़ीःमला मीराई मान्त्रा ओमान माडाड्योरं, उरुकाराई के ओमानज़ डाड्योरं।”<verse eid="MRK 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 6:5" />हैजैडे नलं येसुये टोबो नेम्लो याजोरो राव मीरंलाई याक्याङटं उकुइये छुडे ओससोमोरंकाम, उरु कडि सक्तिला येःन पनि माडोडुवये। <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />नोराई बिस्वास याम्डोव रःङडे येसु बनै अचम्बज़ ओटाव। होकाम येसुये उरु नाङखार-नाङखारयालं नाडे परमेस्वरलो ओबचन ओपैनावरं।<verse eid="MRK 6:6" /></para>
  <para style="s">येसुये बार जना उसिसरंलाई उपरिःङोरं</para>
  <para style="r">
    <ref loc="MAT 10:1">मत्ती १०:१</ref>,<ref loc="MAT 10:5-15">५-१५</ref>; <ref loc="LUK 9:1-6">लुका ९:१-६</ref></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 6:7" />नो बेलाकं येसुये बारं जना उसिसरंलाई ओल लेवकं खुल्डे नोरंलाई नेबऱ्याङ-नेबऱ्याङ झैडे माचाव आत्मारंलाई पुलैने अडिकार याडे उपरिःङोरं। <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />नोरंलाई येसुये हैओडोवरं, “येमटं जेनाकं जेसं बरे, ज़ःन सोनो जेवाम्फोटं पैसा कडिज़ टालाङच्यो, बुरु टोबो झुइ याज़ लाङच्यो। <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />जेखङटं चपल सोनो जेक्याङटा क्वासंयाज़ नाच्यो।” वार्डे हैओडोवर। <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />फरि येसुये नोरंलाई ऐ वार्डे अरैडे उपरिःङोरं, “जे जो ज़ीःमलं जेना नो नाङखारलाम जेमनाया समं हो ज़ीःमलंज़ लेच्यो। <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />जेलाई कोइराई जेमान माडाड्याच्योरंखे भने, जेपाङ माठैड्याच्योरंखे भने नो पोलाम जिपुलुकं नोराई याबिरोडलं गोहाइ याने जेखङटा ढुइरं पनि होकंज़ ठरैडे ख्यानैड्याच्योरं।”<verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />नोरं नाडे जे जेपापलाम वोल्च्यो वार्डे प्रचार याडोव। <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />नोराई बनै भ्या ज़्याःरंलाई यापुलुयोरं, बनै भ्या ठलिव मीरंलाई परमेस्वरलो ओमिननि जैतुनलो उठी ठिडे याससोमोरं।<verse eid="MRK 6:13" /></para>
  <para style="s">बप्तिस्मा झैने युहन्नालाई यासोःयो</para>
  <para style="r">
    <ref loc="MAT 14:1-12">मत्ती १४:१-१२</ref>; <ref loc="LUK 9:7-9">लुका ९:७-९</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />येसुलो उमिन चारकोना प्रचार ओटाव, हेरोड राजाये पनि ओठोयो। नो बेलाकं येसुलो ओरोः चारकोनाडेज़ स्यान्टैराई बात्रा याडोज़्याव। कोइराईची “बप्तिस्मा याने युहन्ना सिवलाम ज्युङडा ओटाव ची हैजैडे एटानाव सक्तिला येःन ओटाज़्याव यावार्ज़्याव।”<verse eid="MRK 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15" />कोइराईची “आव के एलिया ची” यावार्ज़्याव।</para>
  <para style="p" vid="MRK 6:15">कोइरं के फरि “आव के डोङ्का अगमबक्ता स्यानाव टोबो अगमबक्ता ची” ऐ यावार्ज़्याव।<verse eid="MRK 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16" />हेरोडये आव रोः ओठोयो, होकाम हैओवारो, “जोलो ओङैः पोलो ङापरिःङोरं, हो युहन्नाके फरि सिवलाम ज्युङडा ओटाव ची ओलेव।” <verse eid="MRK 6:16" /><verse number="17" style="v" sid="MRK 6:17" />कडालेकं हेरोडये ओभाइ फिलिपलो ओज्या हेरोडियासलाई रैडे ओनैज़्याव। होलो ओपाङ ठैडे युहन्नालाई क्योःव परिःङरंडे किडे झ्यालखानालं झाडे ओनैज़्याव। <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />होकाम युहन्नाये नो हेरोड राजालाई हैओडोज़्याव, “नङ नभाइलो ओज्यालाई रैने चाव माङ्कची।”<verse eid="MRK 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19" />हैजैडे हेरोडियासये युहन्नासं इख नैडे नोलाई सैःने ओपान्ज़्याव। हैनि पनि सैःने मौका ओमडैटाव। <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />कडालेकं ओल हेरोड राजाये युहन्ना के बनै सहि सोनो चोखो मी ची वार्डे छेडे उलिज़्याव। हैजैडे नोये युहन्नालाई जोगैडे ओनैज़्याव। युहन्नालो ओपाङ ठैडे हेरोड राजालो उयुङ माचाव ओटानि पनि बनै ठैने युङ डोवये।<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />टछा हेरोडलो ओजर्म डिन मानिने बेला ओराव, नो छ्याम बनै घ्योव भोज ओयोवरं नो भोजलं घ्यो-घ्योव प्रडानरं, फौजीला हाकिमरं सोनो गालीलला बनै घ्यो-घ्योव मीरंलाई उखुलोरं। <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />नो बेलाकंज़ हेरोडियासलो मेमाओज़ा नो भोज ज़्यानेराई लेवकं नाडे ओस्याःव। स्याःडे स्यान्टैरंलाई खुसि ओझोयोरं, राजा हेरोड सोनो ओपाहुनारं बनै खुसि याटाव। होकाम राजाये नो लुज़ालाई हैओडोव, “नङ नइछ्या कडि लिज़्या हो गनिःके होकाम ङा होज़ ङायान।” <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />“नङलाई टभा ङाराज्ये टानि ङायान” वार्डे कबंल पनि ओडोव।<verse eid="MRK 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24" />होकाम नो लुज़ा वामा लेवकं नाडे “ङा कडि ङानिःके आमा?” वार्डे हैओडोव। वामाये “नो बप्तिस्मा झैने युहन्नालो ओङैः नीः” वार्डे हैओडोव।<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />नो लुज़ा चानोज़ राजा लेवकं नाडे ङालाई नो बप्तिस्मा झैने युहन्नालो ओङैः टाठीलं झाडे याङ वार्डे हैओडोव।<verse eid="MRK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26" />नो लुज़ालो ओपाङ ठैडे राजालो उयुङ माचाव ओटाव, ओपाहुनाराई याङाःकं कबंल ओयोवये नो लुज़ालो ओपाङ ओठोयो। <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />हैजैडे राजाये उसिफाइँरंलाम टोबोलाई खुल्डे झ्यालला लिज़्याव बप्तिस्मा याने युहन्नालो ओङैः रै वार्डे हैओडोव, नो झ्यालखानालं नाडे युहन्नालो ओङैः पल्डे, <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />टाठीलं झाडे नो लुज़ालाई रैडे ओयोव नो लुज़ाये फरि वामालाई लाङडे ओयोव। <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />छिन्डे युहन्नालो उसिसरं नो रोः ठैडे राडे युहन्नालो ओमोरोःलाई लाङडे खाडरलं यागाडिनाव।<verse eid="MRK 6:29" /></para>
  <para style="s">येसुये पाँस हजारलाई ङाः सोनो बरे ओयोवरं</para>
  <para style="r">
    <ref loc="MAT 14:13-21">मत्ती १४:१३-२१</ref>; <ref loc="LUK 9:10-17">लुका ९:१०-१७</ref>; <ref loc="JHN 6:5-13">युहन्ना ६:५-१३</ref></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />येसुये प्रचार डोने उपरिःङोरं नो प्रेरितरं वोल्डे राडे ओल लेवकं डुप्सिडे याडोव येःन भरि, सोनो यापैसिव रोः भरि हैयाडोव। <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />होकाम येसुये नोरंलाई, “जे पनि ङासं गराच्योके, टोबोकं मीरं मालेव पोयालं नाडे जामा जेनाःसिके” वार्डे हैओडोवर। कडालेकं आडे होडे बाने मीरं बनै भ्या लेवरं, हैजैडे नोरं काङ ज़्याने पनि यामढाज़्याव। <verse eid="MRK 6:31" /><verse number="32" style="v" sid="MRK 6:32" />हैजैडे येसु उसिसरासं डोङ्गाटं पुलुडे मीरं मालेव टोबो पोकं यानाव।<verse eid="MRK 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33" />बनै भ्या मीराई येसुरं यानाज़्याव यारोःङो नोरं येसुरंज़ वार्डे सरेःडे चानो-चानोज़ ज़ोनाडे येसुरंलाई ख्यानैडे पनि याङाःडेज़ याकेव। <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />येसु डोङ्गा टाम उझरिवपानाज़ बनै भ्या माहुले मीरं यालिज़्याव ओरोःङोरं, नो मीरंलाई याग्वाला मालेव भेडारं मान्टिव ओरोःङोरं, होकाम बनै उयुङ नाडे येसुये नो मीरंलाई बनै भ्या रोःरं ओपोयोरं।<verse eid="MRK 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 6:35" />नम उनुपरिव बेलाकं उसिसरं राडे येसुलाई हैयाडोव, “आव मीरं मालेव पोलं नम यानुपरिडु। <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />मीरंलाई गपंरिःङरंके, आसै-होसैयाला नाङखारयालं नाडे ज़्याव लःङडे गज़्योरंकं।”<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />येसुये उसिसरंलाई “नो मीरंलाई जेज़ ज़्याव याच्योरं।” वार्डे हैओडोवरं नोराई येसुलाई हैयाडोव,</para>
  <para style="p" vid="MRK 6:37">“गे नोरंलाई नेःसै पैसालो बरे लःङडे ज़्याव यानेरं डोरो?”<verse eid="MRK 6:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38" />येसुये उसिसरंलाई “जेसं खागोटा बरे लिज़्या? रःङच्यो?” वार्डे हैडोवरं।</para>
  <para style="p" vid="MRK 6:38">नोराई “पाँस गोटा बरे सोनो नेबऱ्याङ ङाः याज़ लिज़्या” वार्डे हैयाडोव।<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />येसुये उसिसरंलाई नो मीरंलाई पिङो छि लेव बाङलं टाना-टाना झैडे सुचुनो उपरिःङोरं। <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />नो मीरं सय-सय सोनो पचास-पचास जना झैसिडे टाना-टाना याचुङो <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />येसुये नो पाँस गोटा बरे सोनो नेबऱ्याङ ङाः छेन्डे स्वर्गडे रःङडे आसिक ओयोव, होकाम बरे ओकेःव, आव मीराई याङाः-याङाःकं नैड्याच्योरं वार्डे उसिसरंलाई ओयोवरं, नो नेबऱ्याङ ङाः पनि स्यान्टैलाई भाडे ओयोवरं। <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />स्यान्टैरं ज़्याडे यावाःङो। <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />होकाम येसुलो उसिसराई येःलो बरे सोनो ङाःलो उकुत्रारं बारं फुङ्गा याडुपो। <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />नो ज़्याव ज़्याने खेपारंया मान्त्राज़ पाँस हजार लेवरं।<verse eid="MRK 6:44" /></para>
  <para style="s">येसु रीः तर्ट ओबाव</para>
  <para style="r">
    <ref loc="MAT 14:21-36">मत्ती १४:२१-३६</ref>; <ref loc="JHN 6:16-21">युहन्ना ६:१६-२१</ref></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />येसुये उसिसरंलाई चानोज़ होपंटं बेठसेडालं ओल भन्डा ङाःडेज़ डोङ्गाटं उपरिःङोरं, ओल होला लेव माहुले मीरासं याभासिव। <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />नोरासं भासिडे येसु डान्डाटं प्रार्ठना डोने ओनाव।<verse eid="MRK 6:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 6:47" />रिःमडे ओटारिज़्याकं डोङ्गा समन्डरलो ओमान्जलं केनाडे उलिज़्याव, येसु ओबाठङज़ पाखाटं नामलं उलिज़्याव। <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />येसुलो उसिसरंलाई डोङ्गा चलैने बनै डुखं ओटाज़्याव येसुये ओरोःङोरं, कडालेकं बतासं बिप्याङाम ओराज़्याव। छकाल्ने ठोकै तीन बजे काम छ बजेयालं येसु समन्डरलं रीः तर्ट बाडे ओराज़्याव, होकाम नोरंलाई ख्यानैने ओपानज़्याकं, <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />नोरं येसुलाई समन्डर तर्ट बाडे ओराज़्याव रःङडे आव के भुत ची वार्डे याकीःव। <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />कडालेकं येसुलाई रःङडे स्यान्टै याछेव।</para>
  <para style="p" vid="MRK 6:50">ओल चानोज़ नोरंलाई “जियुङलं हिक्मत डोच्यो टाछेच्यो ङा ची” वार्डे हैओडोवरं। <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />ओल डोङ्गाटं उपुलुव मान्त्राज़ बतासं उठकंनिव, आव रःङडे उसिसरं बनै अचम्ब याटाव, <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />कडालेकं नोराई येसुये पाँस हजाररंलाई ओपर्भयो पाँस गोटा बरेलो ओबारेला रोःलो ओमाने यामबुझिटाव, कडालेकं नोराई यायुङ बनै खाव टाडे उलिज़्याव।<verse eid="MRK 6:52" /></para>
  <para style="s">येसुये गनेसेरेतलं ठलिवरंलाई ओससोमोरं</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />समन्डर होपंटं यानाकं नाम याडोयोमान्त्रा डोङ्गालाई ओछ्योटं नैडे नोरं गनेसरेत वार्ने पोलं याकेरिव। <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />नोरं डोङ्गाटाम याझरिवपानाज़ होला लेव मीराई येसुलाई यासःरेव, <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />आसै-होसैका छेत्रयालं नोरं ज़ोःये-ज़ोःये यानाव, नङं येसु लिज़्या वार्ने ठैडे, नलं ठलिवरंलाई टानटं झाडे यारोयोरं। <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />होकाम सहरयालं, नाङखारयालं, मीरं यालिज़्याव पो यालं जोकं-जोकं येसु ना होकं-होकं मीराई ठलिवरंलाई बजारयालं टोबोकं डुप्डे यानोयोरं, होकाम येसुलो ओक्वालो उफुर्का छुव गेडैकं वार्डे येसुलाई बिन्ती याडोव, येसुलो ओक्वालो उफुर्का छुने भरि स्यान्टै यासमो।<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s">पुर्खाराई यासिछ्या</para>
  <para style="r">
    <ref loc="MAT 15:1-20">मत्ती १५:१-२०</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />यरुसलेमङाम राव नेबऱ्याङया फरिसीरं सोनो न्याम पैने मीरं येसुलो ओछ्योयालं याडुप्सिव। <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />येसुलो कोइ-कोइ उसिसरं याकुइ माहुरसिडे काङ याज़्योज़्याव यारोःङो।<verse eid="MRK 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3" />फरिसीरं सोनो यहुडीरं नोराई यासाखा पुर्खाकामटाज़ चावसं याकुइ माहुरसिडे कडिज़ माज़्याने याचलन लेव। <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />बजारलाम यारोयो बस्तरं चावसं छेडे याज़ चलैरंये। होसोनो बजारलाम राडे चावसं हुर्सिडे याज़ कडिरं ज़्योरंये। नोराई उरु याचलन एटाव समं यामानिज़्याव खुरीरं, जारं, टानरं, सोनो काङ्सा जारं पनि सिल्ने याचलन लेव।<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />हैजैडे फरिसीरं सोनो सास्त्रटा न्याम पैने मीराई येसुलाई यापजोयो, “नसिसराई कडा गेसाखा पुर्खाकामटा राव चलन अनंसारला जीबनलं यामबाज़्याव? कडा आवराई याकुइ माहुरसिडेज़ ज़्योरं?”<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />होकाम येसुये नोरंलाई हैओडोवरं, “जे मान्टिव कैफटिराई यालागिटं यसैयाये ङाःडेज़ ऐ लेडे ठीकंज़ अगमबानी ओडोव! ऐटाव सर्सिवले,<note caller="+" style="x"><char style="xo" closed="false">७:६ </char><char style="xt" closed="false"><ref loc="ISA 29:13">यसैया २९:१३</ref></char></note></para>
  <para style="q1" vid="MRK 7:6">‘आव मीराई यायाःये मान्त्राज़ ङामान नैड्याङज़्यारं,</para>
  <para style="q2" vid="MRK 7:6">हैनि पनि यायुङ के ङाकाम टाडाज़ लिज़्या।<verse eid="MRK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7" />नोराई, सोजोज़ ङामहिमा डोज़्यारं,</para>
  <para style="q2" vid="MRK 7:7">हैनि पनि नोराई यासिछ्या मीराई यापोयो तरिकायाज़ची।’<verse eid="MRK 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8" />हैजैडे जे परमेस्वरलो ओन्यामलाई राःडे झन मीराई यापोयो चलनलं जेबाज़्या।”<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />येसुये नोरंलाई हैओडोवरं, “जे जेचलनलाई मानिनेलो लागिटं खाडंङ चलाकसं परमेस्वरलो ओन्यामलाई जेराःज़्या। <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />कडालेकं मोसाये हैओवारो ले, ‘जेआमा, जेबाबुलाई मान याच्योरं, होसोनो जोये वामा, ओबाबुलाई बिरोड डाडे माचाव रोः पाङ नो मीलाई सोःयोज़ परिये।’ <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />कोइ मीये ओबाबु वामालाई जिन ङालेवङाम डैने फाइडा स्यान्टै परमेस्वरलाई चरैःसिव ची ले वार्डे हैयावार भने, <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />जे नो मीलाई ओबाबुनि वामानि कडि नेसेवाज़ डोव जेमयोये। <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />हैजैडे जे जेसाखा जेपुर्खाकाम्टा चलिडे राज़्याव चलनलाई मानिडे परमेस्वरलो ओपाङलाई फालिम जेजैज़्या। एटानाव उरु भ्या येःनरं जेडोज़्या।”<verse eid="MRK 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />येसुये माहुले मीरंलाई फरि ओल लेवकं खुल्डे नोरंलाई ऐ ओडोवरं, “जे स्यान्टैये ङारोः ठैच्यो होकाम चावसं बुझिच्यो। <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />एटानाव कडि रोःज़ माले जो पाखाङाम मीलो उज्युङलं पसिडे मीलाई बलेने, मीलो युङलाम पाखाडे पुलुज़्याव रोःराई ची मीलाई माचाव झैरंये। <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />जोलो ठैने ओना ले होये चावसं ओठोयोकं।”<note caller="+" style="f"><char style="fr" closed="false">७:१६ </char><char style="ft" closed="false">कोइ कुइये सर्सिव ग्रीक लिपिटं आव बचन सर्सिव माले।</char></note><verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />माहुले मीरंलाई राःडे येसु ज़ीःमलं उपसिव पानाज़ येसुलो उसिसराई ओललाई आव सात्रोलो ओबारेलं यापजोयो। <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />येसुये नोरंलाई हैओडोवरं, “जे पनि अजं माबुझिव जिलिज़्याव? जो पाखाङाम मीलो उफुलं पसिये, नोये मीलाई बलेडे माचाव झोयो वार्ने जे जेमसन? <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />कडालेकं नो उयुङलं माङ्क, उफुलं पसिये, होकाम पाखाडे पुलुये।” हैजैडे येसुये स्यान्टै ज़्याव भरिज़ चोखोले वार्डे हैओडोवरं।<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />येसुये हैओडोवरं, “मी लेवटाम जो पाखाडे पुलुये होयेज़ मीलाई बलेडे माचाव झोयोये। <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />कडालेकं मीलो युङलाम माचाव सुन्चीने, ब्यभिचार डोने, कुने, मी सैःने, छुटं मेमारं लेवडे नाने, <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />लोभ, माचाव येःन, छल, कोभाज्याङ लेने, खिस, बिरोड, घ्योव झैसिने, मुर्ख पुलुये। <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />एटाव स्यान्टै माचाव रोःरंज़ मीलो युङलाम पुलुडे मीलाई बलेरं।”<verse eid="MRK 7:23" /></para>
  <para style="s">टोबो मेमालो उबिस्वास</para>
  <para style="r">
    <ref loc="MAT 15:21-28">मत्ती १५:२१-२८</ref></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />येसु नलाम पुलुडे टुरोस सोनो सिडोननि नेसान्डिडे नाडे टोबो ज़ीःमलं उपसिव। आलं ङाराव काङ्कायेज़ ठा टासनरंकं वार्डे हैओवारो, हैनि पनि मोसिडे मालेडुये। <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />नो बेलाकंज़ टोबो मेमाये येसुलो ओबारेलं ओठोयो होकाम राडे येसुलो ओखङटं उफुलुप्सिव। नो मेमालो मेमा ओज़ालाई माचाव आत्माये क्योःडे ओनैज़्याव। <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />नो मेमा सिरियाला फोनिके वार्ने पोलं जर्मीव लेव नो मेमा यहुडी मालेव। नो मेमाये येसुलाई मेमाङाज़ालो ओक्याङटाम ज़्याःरं हाइड्यो वार्डे बिन्ती ओडोव। <verse eid="MRK 7:26" /><verse number="27" style="v" sid="MRK 7:27" />येसुये नो मेमालाई हैओडोव, “ङाःडे छोऱ्या लुज़ारंलाई ज़्याव योरं, कडालेकं छोऱ्या लुज़ाराई याबरे रैडे काःरंलाई ख्याड्याने चाव माङ्कची।”<verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />नो मेमाये हैओडोव, “होज़ प्रभु, काःराई पनि छोऱ्या लुज़ाराई टेबलटाम मेलं यासंटेःव ज़्योरंसानि।”<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />येसुये नो मेमालाई हैओडोव, “नङ ऐ नवारोयेज़ नज़ा यासम्डु। नज़ालो ओक्याङटाम ज़्याः पुलुडे यानाडु।”<verse eid="MRK 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30" />नो मेमा ज़ीःमकं ओनाकं के ओज़ालाई खाटंटं घ्याङसिडे उलिज़्याव ओडैनाव, ओक्याङटाम ज़्याः पुलुडे नाडे उलिज़्याव ओरोःङो।<verse eid="MRK 7:30" /></para>
  <para style="s">येसुये भैरा सोनो लाटालाई ससोमोये</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />होकाम येसु टुरोसलाम पुलुडे डस सहरलो ओछेत्रला डेकापोलिस येम टाडे सीडोनलो ओसान्डिलो ओमान्जलाग्यान टाडे गालील डहंलं ओनाव। <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />नला मीराई टोबो ओना माठोयो सोनो ओयाः मापाङो मीलाई येसु लेवकं यारोयो, होकाम आवलो ओक्याङटं नकुइ नैडेगोयोके वार्डे बिन्ती याडोव।<verse eid="MRK 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 7:33" />येसुये नो मीलाई माहुले मीराई याखार्लाम जामा होसैकं सुनसान पोकं लाङडे उकुइसै नोलो ओनालं झाडे ओयोव। होकाम ट्युल्डे नोलो ओसेटं छाप्डे ओयोव। <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />होकाम स्वर्गडे रःङडे खेव ओसं चेङडे नोलाई, “इफ्फाता,” हैओडोव। आवलो ओमाने “ओफैसिकं।”<note caller="+" style="f"><char style="fr" closed="false">७:3४ </char><char style="ft" closed="false">नना, नयाः ओफैसिकं।</char></note><verse eid="MRK 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 7:35" />होपानाज़ नो मीलो ओना ओफैसिव, होसोनो नोलो ओसेलो ओबन्डन ओपलासिव होकाम नो चावसंज़ ओपाङो। <verse eid="MRK 7:35" /><verse number="36" style="v" sid="MRK 7:36" />“आव काङ्कालाईज़ हैटाडाच्यो” वार्डे येसुये नोरंलाई हैओडोवरं। जतिज़ मीरंलाई हैटालेच्यो डोवरं, नोरं झन-झन बनै बात्रा याडोव। <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />मीरं बनै अचम्ब टाडे बक्क टाडे हैयावारो, “आवये स्यान्टै रोः ठीकंज़ डोज़्याव। आवये याना माठोयोरंलाई याना फैडे ओयोज़्यावरं यायाः मापाङोरंलाई पाङडुने समं झैज़्यावरं।”<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">येसुये चार हजार मीरंलाई ओपर्भयोरं</para>
  <para style="r">
    <ref loc="MAT 15:29-39">मत्ती १५:२९-३९</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />हो डिन छ्याम फरि पनि माहुले मीरं याडुप्सिव, होरासं ज़्याने कडिज़ मालेव। होकाम येसुये उसिसरंलाई ओल लेवकं खुल्डे हैओडोवरं, <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />“आव माहुल्ये मीरंलाई रःङडे ङायुङ नाज़्या कडालेकं आवरं ङासं यालेव आछिम सोङला याटाडु होसोनो आवरासं ज़्याने कडि पनि माले। <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />होकाम आवरंलाई करेसंज़ ज़ीःमडे ङापरिःङरंखे भने के येमयालं बेहोस टाडे ढलिने लेरं आवरं कोइ कोइरं के टाडाङाम राव लिज़्यारं।”<verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />येसुलो उसिसराई येसुलाई हैयाडोव, “आव कडिज़ मालेव बनलं आवरंलाई कैजैडे बरे यानेरं?”<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />येसुये उसिसरंलाई ओपजोयोरं, “जेसं खागोटा बरे उलिज़्याव?”</para>
  <para style="p" vid="MRK 8:5">नोराई हैयाडोव, “सात गोटा लिज़्या”<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />येसुये हो माहुल्ये मीरंलाई नामलं चुङो उपरिःङोरं, होकाम सात गोटा बरे उकुइटं छेन्डे ढन्याबाड ओयोवपाना बरे केःडे, मीरंलाई भाड्याच्योरं वार्डे उसिसरंलाई हैओडोवरं, उसिसराई बरे लाङडे मीरंलाई याभाड्योवरं। <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />नोरासं टिगिडा आलिलिज़ा ङाःरं पनि लेवरं, नो पनि येसुये आसिक याडे नोराई याङाःकंज़ नोयो उपरिःङोरं। <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />होकाम हो मीरं ज़्याडे, यावाःङो। ओयेःलं याडुप्क घ्योव फुङ्गालं सात फुङ्गा ओटाव। <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />होल चार हजारया मीरं लेवरं। होकाम येसुये नो मीरंलाई उपरिःङोरं। <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />होपाना येसु उसिसरासं डोङ्गाटं पुलुडे डलमनुठा वार्ने जिल्लालं ओनाव।<verse eid="MRK 8:10" /></para>
  <para style="s">फरिसीराई चिन्न यानिःव</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />फरिसीरं येसु लेवकं राडे होसं यायुसिव, होकाम येसुलाई जान्चिनेलो लागिटं स्वर्गटाम टोबो चिन्न यानिःव। <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />येसुये खेव ओसं चेङडे होरंलाई हैओडोवरं, “आव पुस्ताये कडाने चिन्न उखिम्ज़्याव? डस्साज़, ङा जेलाई हैङाडाच्योज़्या, आव पुस्तालाई चिन्नलो उमिन्ट कडि पनि यासिने माले।”<verse eid="MRK 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 8:13" />होकाम येसुये होरंलाई राःडे फरि पनि डोङ्गाटं चुङडे समन्डर होपंटं ओनाव।<verse eid="MRK 8:13" /></para>
  <para style="s">फरिसीराई सोनो हेरोडलो ओखमीर</para>
  <para style="r">
    <ref loc="MAT 16:5-12">मत्ती १६:५-१२</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />येसुलो उसिसरं यासं बरे लाङने मेःडेयानैज़्याव, होकाम डोङ्गाटं यासं टोबोज़ाज़ बरे लेव। <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />येसुये उसिसरंलाई ऐ वार्डे चेतावनी ओयोवरं, “जे फरिसीराई याखमिर सोनो हेरोडलो ओखमीरटाम जोगिडे लेच्यो।”<verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />होकाम होरं गेसं बरे ओम्लेवये येसुये एटाव ओपाङज़्याव वार्डे या-याज़ यापाङो।<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />येसुये आव रोः सन्डे होरंलाई हैओडोवरं, “जेसं बरे माले वार्डे कडाने जेपाङज़्याव? जे अजं पनि जेमठैज़्याव, सै जिमबुझिज़्याव? कडा जियुङ खाव टाडे उलिज़्याव रो? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />जिमिलङ लेडे पनि जेमरःङडुज़्याव? जेना लेडे पनि जेमठैडुज़्याव? जे जेमचेटैज़्याव रो? <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />ङा पाँस गोटा बरे पांँस हजार मीराई याखार्ल ङा केःव बेलाकं, खागोटा फुङ्गालं बरेलो कुत्रा जिडुपो?”</para>
  <para style="p" vid="MRK 8:19">नोराई येसुलाई हैयाडोव, “बारं फुङ्गा।”<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />“होकाम सात गोटा बरे चार हजार मीराई याखार्ल ङाकेःव बेलाकं, खागोटा फुङ्गालं बरेलो उकुत्रा जिडुपो?”</para>
  <para style="p" vid="MRK 8:20">होराई येसुलाई हैयाडोव, “घ्यो-घ्योव सात फुङ्गा।”<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />येसुये उसिसरंलाई हैओडोवरं, “होकाम जे अजं पनि जिमबुझिज़्याव?”<verse eid="MRK 8:21" /></para>
  <para style="s">बेठसेडाला अन्डला मी ओसोमो</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />होकाम येसु बेठसेडालं ओराव। मीरं टोबो अन्डला मीलाई येसु लेवकं रैडे, नो मीलाई येसुये गुछुड्यासिवकं वार्डे बिन्ती याडोव। <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />येसुये हो मीलाई उकुइटाम चेङडे नाङखारलाम टङकं ओरोयो, होकाम उमिलङटं ट्युल्डे ओक्याङटं उकुइ नैडे होलाई ओपजोयो, “नङ कडिरं नमरःङज़्या?”<verse eid="MRK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24" />होकाम हो मीये याडे रःङडे हैओवारो, “ङा मीरंलाई सिङरं स्याव याबारिज़्याव ङारःङज़्या।”<verse eid="MRK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25" />होकाम येसुये फरि हो मीलो उमिलङटं उकुइये उछुकं, हो मीलो उमिलङ ओफैसिव होकाम स्यान्जाति चावसं रःङने ओटाव। <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />येसुये होलाई नाङखारलं मापसिडे उज़ीःमडे उपरिःङो।<verse eid="MRK 8:26" /></para>
  <para style="s">पत्रुसये येसुलाई मसिह वार्डे बिस्वास ओडोव</para>
  <para style="r">
    <ref loc="MAT 16:13-16">मत्ती १६:१३-१६</ref>; <ref loc="LUK 9:18-21">लुका ९:१८-२१</ref></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />येसु सोनो उसिसरं कैसरिया फिलिपलो ओनाङखारलं यानाव। येमकं यानाज़्याकं येसुये उसिसरंलाई ऐ वार्डे ओपंजोयोरं, “मीराई ङालाई कै डाङज़्यारं ङा काङ्का?”<verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />नोराई येसुलाई हैयाडोव, “कोइरं वार्र, ‘बप्तिस्मा झैने युहन्ना।’ उरुराई ‘एलिया।’ यहुडीरंकाम उरुका मीरं हैवाररं, अगमबक्तारंलाम टोबो।”<verse eid="MRK 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29" />होकाम येसुये उसिसरंलाई ओपंजोयोरं, “जे कै जेवारये, ङा काङ्का?”</para>
  <para style="p" vid="MRK 8:29">पत्रुसये येसुलाई हैओडोव, “नङ ख्रीस्टज़।”<verse eid="MRK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30" />येसुये नोरंलाई ङाबारेलं काङ्कालाई पनि हैटाडाच्योरं वार्डे आग्या ओयोवरं!<verse eid="MRK 8:30" /></para>
  <para style="s">ओडैने डुखं सोनो उसिने ओबारेलं येसु ओपाङो</para>
  <para style="r">
    <ref loc="MAT 16:21-28">मत्ती १६:२१-२८</ref>; <ref loc="LUK 9:21-27">लुका ९:२१-२७</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />“मानवालो ओज़ाये बनै भ्या डुखं डैने, होसोनो यहुडी नेतारं, मुख्या सेवा डोने मीरं सोनो न्याम पैने मीरंङाम हेलाहारी टाडे होराई याकुइटाम सिनेले होकाम सोङलाका ज्युङडा टाडे सोनेज़ ले” वार्डे होरंलाई ओपोयोरं। <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />हैजैडे आव रोः येसुये चावसं बुझैडे हैओडोवरं। आव रोः ठैडे पत्रुसये येसुलाई टङडे लाङडे ओहक्लोयो। <verse eid="MRK 8:32" /><verse number="33" style="v" sid="MRK 8:33" />होकाम येसु उसिसराई लेवडे वोल्डे रःङडे, पत्रुसलाई ऐ वार्डे ओहक्लोयो, “ए सैतान, नङ ङाछ्योकाम होडे नान, कडालेकं नयुङ परमेस्वर लेवडे माले, बुरु मीराई लेवडे ची लिज़्या।”<verse eid="MRK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />होकाम येसुये उसिसरासं माहुले मीरंलाई ओछ्योकं खुल्डे हैओडोवरं, “कोइ मी ङाछिन्ट राने युङ याडोवखे भने हो मीये ओल्स लिज़्याव स्यान्टै राःडे उक्रुस घुर्डे ङाछिन्ट ओराकं। <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />कडालेकं जोये ओपोहोन जोगैने युङ डोव होये हो गोमैनेले, ङालागिटं सोनो चाव सोरलो ओलागिटं जोये उजीबन गोमोयो होये हो जोगैनेले। <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />कडालेकं मीये स्यान्टै सङसार उकुइटं रैडे ओपोहोन याझाव भने कडि फाइडा याटाया ड? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />होसोनो मीये ओपोहोनलो ओपोलं कडि योडुव ड? <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />आव बनै ब्यभिचारी सोनो पापी पुस्तालं जोये ङासं सोनो ङाबचनसं ओलाजं हायो, होलाई मानवालो ओज़ाये पनि ओबाबुलो ओमहिमाटं चोखो कटंवालरासं ओराकं होसं ओलाजं हाइनेले।”<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />होकाम येसुये नोरंलाई हैओडोवरं, “डस्साज़, ङा जेलाई हैङाडाच्यो, आका च्याङसिवरंकाम कोइ-कोइरं परमेस्वरलो ओराज्य सक्तिसं ओराज़्याव यामरःङया समं सिने मालेरं।”<verse eid="MRK 9:1" /></para>
  <para style="s">येसुलो उरुप उफिरिव</para>
  <para style="r">
    <ref loc="MAT 17:1-13">मत्ती १७:१-१३</ref>; <ref loc="LUK 9:28-36">लुका ९:२८-३६</ref></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />होकाम छ डिन झिन्डे येसुये पत्रुस, याकुब सोनो युहन्नालाई ओल्स टोबो झेनो डान्डाटं ओलाङोरं होटं येसुरं याज़ लेवरं, होकाम होराई याङाःकंज़ येसुलो उरुप छुट्टभान्ट्याव ओटाव। <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />होकाम येसुलो ओक्वा टक पलाङो मिलङ झिने ओटाव, ऐटाव पलाङो ओटाव, प्रिठीबीलं काङ्का मीये पनि क्वा छेडे हैटाव माझैडुव। <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />होकाम सोमबऱ्याङ उसिसराई एलिया सोनो मोसानि येसुसं नेपाङज़्याव यारोःङो। <verse eid="MRK 9:4" /><verse number="5" style="v" sid="MRK 9:5" />पत्रुसये येसुलाई हैओडोव “रब्बी, गे आटं गेलेव बनै चाव याटा। गे आटं सोमबऱ्याङ गोठो गेझैके, टोबो नलागिटं, नेबऱ्याङ मोसा सोनो एलियानी नेलागिटं।” <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />पत्रुस सोनो ओल्स लेनेरं बनै याछेव कडि पाङने हो नोराई मासनरंये।<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />होकाम टोबो बाडल राडे होरंलाई ओकपोरं, हो बाडलटाम टोबो ऐटाव गा ओठोयो, “आव के ङा ङायुङ्का ङाज़ाची, जे आवलो ओपाङ ठैच्यो।” <verse eid="MRK 9:7" /><verse number="8" style="v" sid="MRK 9:8" />होकाम होपानाज़ आडेहोडे यारःङकं येसुलाई याज़ यासं यारोःङो।<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />येसुरं डान्डाटाम याझरिज़्याकं यायेम्बैटं येसुये होरंलाई आग्या ओयोवरं “मानवालो ओज़ा सिडे ज्युङडा ओम्टाया समं आव जेरोःङो रोः भरि काङ्कालाईज़ हैटाडाच्यो।”<verse eid="MRK 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10" />होराई नो रोः यायुङलंज़ यानोयो, सिडे ज्युङडा टाने ओवारो कडि वार्डे या-याज़ यापाङो। <verse eid="MRK 9:10" /><verse number="11" style="v" sid="MRK 9:11" />होकाम नोरं आव रोः येसुलाई यापजोयो, “ङाःडे एलिया राव परिये वार्डे सास्त्रटा न्याम पैने मीराई कडाने हैयावार्ज़्यावखेने?”<verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />येसुये हैओडोवर “पक्काज़ एलिया ङाःडे रा, होकाम स्यान्टै रोः फरि झोयो। होकाम मानवालो ओज़ाये बनै भ्या डुखं डैडे उरुराईङाम हेलाहारी टानेले वार्डे सास्त्रटं कडाने सर्सिव उलिज़्यावखेने? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />ङा जेलाई हैङाडाच्यो, एलिया राडेयाखेम्डु, होसोनो एलियालो ओबारेलं सर्सिव स्यानाव, एलियासं नोराई जो यायुङये सुन्चिव होज़ यालेव।”<verse eid="MRK 9:13" /></para>
  <para style="s">माचाव आत्माये ओडापो छोऱ्या ओसोमो</para>
  <para style="r">
    <ref loc="MAT 17:14-21">मत्ती १७:१४-२१</ref>; <ref loc="LUK 9:37-43">लुका ९:३७-४३</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />येसु सोनो सोमबऱ्याङ उसिसरं बाङ्की उसिसरं लेवकं वोल्डे याराकं माहुले मीराई नोरंलाई घिरिडे न्याम पैने मीरासं बनै यायुसिज़्याव येसुये ओरोःङो। <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />स्यान्टै मीराई येसुलाई यारोःङोपानाज़ बक्क टाडे येसु लेवडे गुरक्याटं ज़ोरिडे ढो याडोव। <verse eid="MRK 9:15" /><verse number="16" style="v" sid="MRK 9:16" />येसुये नोरंलाई ओपंजोयोरं, “जे आवरासं कडाने जियुसिज़्याव?”<verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />नो माहुल्ये मीरंकाम टोबोये येसुलाई हैओडोव, “गुरबा ङाज़ालाई मापाङ्ने माचाव आत्माये क्योःडे नोयो, होकाम नङ लेवकं रैडेङानै। <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />जोकं नो माचाव आत्माये ङाज़ालाई क्योःवये। होकाम छोऱ्यालाई नामलं टवये, होसोनो छोऱ्याये ओयाःलाम फेन राःवये, होकाम ओहा कट्र सपिडे गेखेङ्टेङ टाये, ङा नसिसरंलाई नो माचाव आत्मा पुलैच्यो वार्डे बिन्ती ङाडोवरं, नोराई माढुरंये।”<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />होकाम येसुये नोरंलाई हैओडोवर “ए बिस्वास माडोने पुस्ता, ङा जेसं खर्का समं ङालेके? ङा जेलाई खर्का समं ङासहिच्योके? नो छोऱ्यालाई आकं रैच्यो।” <verse eid="MRK 9:19" /><verse number="20" style="v" sid="MRK 9:20" />हो छोऱ्यालाई येसु लेवकं यारैज़्याकं येसुलाई ओरोःङोपानाज़ हो माचाव आत्माये छोऱ्यालाई ल-ल ओटंव, छोऱ्या नामलं टसिडे ओयाःलाम फेन पुलैडे नाम्ल फर्लिङ-फर्लिङ उपल्टिव।<verse eid="MRK 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 9:21" />येसुये छोऱ्यालो ओबाबुलाई ओपजोयो, “खाबलाकाम आव छोऱ्यालाई ऐ ओटाव?”</para>
  <para style="p" vid="MRK 9:21">छोऱ्यालो ओबाबुये हैओडोव “ज़ीमज़ा ओलेवकामज़। <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />ङाज़ालाई सैःने लागिटं नो आत्माये गरि मेःलं गरि रीःलं ख्यावये। नङ ससोमो नढुखे भने, नयुङ नाडे गेलाई सायता गयासिके!”<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />येसुये छोऱ्यालो ओबाबुलाई हैओडोव, “‘नङ नढुखिन!’ वार्डे नो कै नवार्ज़्याव? बिस्वास डोनेराई यालागिटं स्यान्टै रोःज़ टाये।”<verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />होपानाज़ छोऱ्यालो ओबाबुये कीःडे हैओवारो “ङा बिस्वास ङाडो। ङा कम्जोर ङाबिस्वास बडैने ङालाई सायता डाङ।”<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />होकाम माहुले मीरं बोलोङ गुरक्याटं याराज़्याव रःङडे येसुये हो माचाव आत्मालाई ऐ वार्डे ओहक्लोयो, “ए मापाङने सोनो भैरा आत्मा, ङा नङलाई आग्या ङायान, नो छोऱ्याटाम पुलुडे रान, होकाम खर्क पनि नो लेवटं टानान।”<verse eid="MRK 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26" />होकाम हो माचाव आत्मा चीर-चीर किःडे छोऱ्यालाई फङ-फङ टडे उपुलुव, होकाम हो छोऱ्या लल्याट्रो ओटाव, भ्या बिछुराई के उसिव ची वार्डे हैयावारो। <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />होकाम येसुये हो छोऱ्यालाई उकुइटं क्योःडे पङ्ल्याङ ओसोचोयो, होकाम छोऱ्या ओच्याङसिव।<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />होकाम येसुरं ज़ीःमडे यानाव येसुलो उसिसराई ओबाठङ ओलेकं येसुलाई ऐ लेडे यापजोयो, “गे नो माचाव आत्मालाई कडा गेमहाइडुखेने?”<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />येसुये नोरंलाई हैओडोवरं, “आव खाले माचाव आत्मालाई खेपैने प्रार्ठनाये याज़ खेपैसिडु।”<verse eid="MRK 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />होकामटानि येसुरं होलाम पुलुडे गालीललाग्यान यानाव। गे आलं गिलिज़्याव रोः काङ्कायेज़ टासनरंकं वार्ने येसुलो उयुङ लेव, <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />कडालेकं येसुये उसिसरंलाई ओपैज़्यारंकं हैओडोवरं, “मानवालो ओज़ा मीराई याकुइटं सुम्पिसिनेले, होकाम होराई नोलाई सैःनेलेरं, होकाम उसिव झिन्डे सोङलाका ज्युङडा टाडे सोनेले।”<verse eid="MRK 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 9:32" />येसुये ओपाङो आव रोः उसिसराई माबुझिरंये, होकाम येसुसं पजैने पनि याछेव।<verse eid="MRK 9:32" /></para>
  <para style="s">स्यान्टैराई भन्डा घ्योव काङ्का?</para>
  <para style="r">
    <ref loc="MAT 18:1-5">मत्ती १८:१-५</ref>; <ref loc="LUK 9:46-48">लुका ९:४६-४८</ref></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />येसु सोनो उसिसरं कफर्नहुम नाङखारलं याराव, ज़ीःमकं यालिज़्याकं येसुये नोरंलाई ओपंजोयोरं, “येम्ट जेराकं कडि रोः जेपाङरिज़्याव?”<verse eid="MRK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 9:34" />होकाम होरं कडिज़ मापाङरंये, कडालेकं होरं येम्ट “गे भरिलाम स्यानटैराई भन्डा घ्योव काङ्का?” वार्डे या-या यायुसिव। <verse eid="MRK 9:34" /><verse number="35" style="v" sid="MRK 9:35" />होकाम येसु चुङडे बारंजना उसिसरंलाई खुल्डे नोरंलाई हैओडोवरं, “जो मी पैला टाने युङ डोव, हो स्यान्टैराई भन्डा आलिज़ा टाडे यासेवा डोव परिये।” <verse eid="MRK 9:35" /><verse number="36" style="v" sid="MRK 9:36" />होकाम येसुये टोबो आलिज़ा बाल्खलाई रैडे उसिसराई याखार्ल उसुचुनो, होकाम बाल्खलाई ओघोन्ट रैडे उसिसरंलाई हैओडोवरं, <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />“जोये एटाव आलिज़ा बाल्खराईलाम टोबोलाई ङामिन्ट ग्रहन डोव होये ङालाईज़ ग्रहन डाङो, होकाम जोये ङालाई ग्रहन डाङो होये ङालाई माङ्कची, ङालाई परिःङनेलाई ग्रहन डोवये।”<verse eid="MRK 9:37" /></para>
  <para style="s">जो गेबिरोडलं माले हो गे लेवडे ले</para>
  <para style="r">
    <ref loc="LUK 9:49-50">लुका ९:४९-५०</ref></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />युहन्नाये येसुलाई हैओडोव, “गुरबा टोबो मीये नमिनङाम ज़्याःरं उपुलैज़्यावरं गे गेरोःङो। गे हो मीलाई नेटाव येःन टाडो वार्डे हैगेडोव, कडालेकं हो मी गेसंका माङ्कची।”<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />होकाम येसुये हैओडोवरं, “हो मीलाई टावोङच्यो, कडालेकं ङामिन्टाम सक्तिला येःन डोनेये झिन्डे ङाबिरोडलं चानो माचाव पाङने माले। <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />कडालेकं जो गेबिरोडलं माले हो गिज्युङङाम झैसिये। <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />कडालेकं जोये जेलाई जे ख्रीस्टसंकारं ची वार्डे जेलाई ङामिनङाम टुखुरि रीः ओंँव यायाच्योव भने, डस्साज़ ङा जेलाई हैङाडाच्यो हो मीये पक्काज़ उईनाम डैनेले।”<verse eid="MRK 9:41" /></para>
  <para style="s">पाप डोव परिःङने कारन</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />“जोये ङालाई बिस्वास डोने आलिज़ारंलाम टोबोलाई पाप डोव परिःङो, होलाई के टोबो घ्योव रान्ठै ओढेङलं झुन्डैडे समन्डरलं ख्यानि पनि चाव याटाहो। <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />होकाम नकुइये नङलाई पाप डोव यापरिःङसोनोखे भने होलाई कटंडे ख्या। नेबऱ्याङ कुइसं नर्गला मासिने मेःलं नाने भन्डा के टोबो कुइ मालेव खर्कज़ मासिने जीबन डैने नलागिटं चाव टाये <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />नर्गलं के रुईर पनि मासिरं, मेः पनि मासिये।<note caller="+" style="f"><char style="fr" closed="false">९:44 </char><char style="ft" closed="false">आव कोइ-कोइ ग्रीक कुइये सर्सिव कितापटंयाज़ ले</char></note> <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />नखङये नङलाई पाप डोव यापरिःङसोनोखे भने होलाई पल्डे ख्या। नेबऱ्याङ खङसं नर्गलं नाने भन्डा के टोबो खङ मालेव खर्कज़ मासिने जीबन डैने नलागिटं चाव। <note caller="+" style="f"><char style="fr" closed="false">९:४५ </char><char style="ft" closed="false">आव कोइ-कोइ ग्रीक कुइये सर्सिव कितापटंयाज़ ले</char></note> <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />नर्गलं रुइरं पनि मासिरंये मेः पनि मासिये <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />नमिलंङये नङलाई पाप डोव यापरिःङसोनोखे भने नोलाई हाइडे ख्या। नेबऱ्याङ मिलङसं नर्गलं नाने भन्डा के टोबो मिलङसं परमेस्वरलो ओराज्यलं नाने नलागिटं चाव टाये। <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />नर्गलं रुइरं पनि मासिरंये मेः पनि मासिये।”<verse eid="MRK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49" />“कडालेकं स्यान्टैलाई मेःयेज़ चोखो झोयोये होमान्टिज़ सापिये चरैसिव बस्तरं चोखो झोयोये।”<verse eid="MRK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50" />“सापि चाव टाये, सापिलो ओडार यानाखे भने फरि कडिये डारो झैने? जे स्यान्टैरं नै-नैलं सापि स्याव डारो टाच्यो, होकाम सान्तिसं लेच्यो।”<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s">ज्यारि भासिने</para>
  <para style="r">
    <ref loc="MAT 19:1-9">मत्ती १९:१-९</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />हो पोलाई राःडे यर्डन भै होपंटं यहुडिया छेत्रलं येसु ओनाव होकाम माहुले मीरं येसु लेवकं याराव, होकाम येसुये ओचलन अनंसार होरंलाई ओपोयोरं।<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />फरिसीरं राडे येसुलाई ऐ वार्डे याजान्चिव, “होकाम कोइ खेपाये ओज्यासं भासिने चाव सै माचाव?”<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />येसुये होरंलाई हैओडोवरं, “मोसाये जेलाई कडि आग्या ओयाच्योव?”<verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />फरिसीराई हैयावारो, “टोबो कागतटं भरपाई सर्डे ज्यारि भासिने टाये वार्डे मोसाये आग्या याडेनोयो।”<verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />होकाम येसुये नोरंलाई हैओडोवरं, “जेलाई पैने बनै ढौ ओटावये मोसाये नो न्याम सर्डे ओयाच्योव। <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />सास्त्रटं सर्सिव ले, ‘सङसार ओटावकामज़ परमेस्वरये नोनिलाई खेपा सोनो मेमा ओझोयोनि ची।’ <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />हैजैडेज़ खेपा मीये ओबाबु वामालाई राःडे ओज्यासं मिलिडे ओलेकं, <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />होकाम नो ज्यारि टोबो ज्यु टाने लेनि। नो ज्यारिनि नेम्लो माङ्क, बुरु टोबो ज्युज़ टाने लेनि। <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />हैजैडे परमेस्वरये जोलाई ज्यारि झैडे नोयोरं, मीराई होरंलाई टाछुटैरंकं।”<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />ज़ीःमकं याराव छिन्डे आव रोः फरि येसुलाई उसिसराई यापजोयो। <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />येसुये उसिसरंलाई हैओडोवरं, “जोये ओज्यालाई राःडे छुटंसं बिह्याँ डोव, होये ओज्यालो उबिरोडलं ब्यभिचार डोवये। <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />होकाम मेमाये पनि ओरेसं भासिडे छुटं खेपासं बिह्याँ याडोवखे भने, हो मेमाये ब्यभिचार ओडोव टाये।”<verse eid="MRK 10:12" /></para>
  <para style="s">आलिज़ा बाल्खरंलाई येसुये आसिक योवरंये</para>
  <para style="r">
    <ref loc="MAT 19:13-15">मत्ती १९:१३-१५</ref>; <ref loc="LUK 18:15-17">लुका १८:१५-१७</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />मीराई आलिज़ा छोऱ्या लुज़ारंलाई येसुये छुडेगयासिवकं वार्डे ओङाःकं यारोयोरं, होकाम उसिसराई होरंलाई याहक्लोयोरं। <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />हो रःङडे येसु उरिसिव, होकाम उसिसरंलाई हैओडोवरं, “आलिज़ा बाल्खरंलाई ङालेवकं राव याच्योरं, नोरंलाई टावोङच्योरं, कडालेकं परमेस्वरलो ओराज्य आव स्यानावराईज़। <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />डस्साज़ ङा जेलाई हैङाडाच्योज़्या, जोये परमेस्वरलो ओराज्यलाई टोबो आलिज़ा बाल्खलाई स्यानाव ग्रहन माडोव, नो खर्कज़ परमेस्वरलो ओराज्यलं पसिडुने माले।” <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />होकाम येसुये बाल्खरंलाई ओघोन्ल रैडे याङैःटं उकुइ नैडे आसिक ओयोवरं।<verse eid="MRK 10:16" /></para>
  <para style="s">टोबो ढापा ढनी मी</para>
  <para style="r">
    <ref loc="MAT 19:16-30">मत्ती १९:१६-३०</ref>; <ref loc="LUK 18:18-30">लुका १८:१८-३०</ref></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />येसु येम्ट ओनाज़्याकं, टोबो मी ज़ोरिडे येसुलो ओङाःकं उघुन्डाये ओच्याङसिव, होकाम येसुलाई ओपजोयो, “ए चाव गुरबा, खर्कज़ मासिने जीबन डैने ङा कडि येःन डोने टाये?”<verse eid="MRK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18" />येसुये हो मीलाई हैओडोव, “नङ ङालाई कडाने चाव नडाङज़्याव? टोबो परमेस्वर काम काङ्काज़ चाव मालेरं। <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />नङ न्यामरं के नसनये, हत्या टाडो, ब्यभिचार टाडो, टाकुङंन, झुठ गोहाइ टायो, टाडुटै, नबाबु सोनो नामालाई मान योनि।”<verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />होकाम हो मीये येसुलाई हैओडोव, “गुरबा आव स्यान्टै के ङा आलिज़ा ङालेवकामज़ डाडे ङाराव ची।”<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />येसुये हो मीलाई ओरोःङो, होकाम मया डाडे हैओडोव “नङ नजीबनलं टोबो रोः माडुमो लिज़्या। गनानके, नाडे नङसं कडि-कडि लिज़्या स्यान्टै येडे गरिबरंलाई गयोरंके, होकाम नङ नो सम्पति स्वर्गटं डैने नले। होकाम राडे ङाछिन्ट नराके।” <verse eid="MRK 10:21" /><verse number="22" style="v" sid="MRK 10:22" />होकाम आव रोःये हो मी डुखि ओटाव, होकाम ओसोगो हाइडे ओनाव, कडालेकं हो मीसं भ्या ढन सम्पति लेव।<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />होकाम आडे होडे रःङडे येसुये उसिसरंलाई हैओडोवरं, “ढनी मीरंलाई परमेस्वरलो ओराज्यलं पसिने खाडंङ ढौ लिज़्या।”<verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />येसुये हैओवारो आव रोःटं उसिसरं अचम्ब याटाव। होकाम येसुये फरि नोरंलाई हैओडोवरं, “ए बाल्खरं परमेस्वरलो ओराज्यलं नाने खाडंङ ढौ लिज़्या। <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />ढनी मी परमेस्वरलो ओराज्यलं पसिने भन्डा के उँटलाई गपलो उकुङलं पसिने सजालो टाये।” <figure style="fig" alt="Merchant leading a camel outside a city wall and gate" file="hk00041c.tif" size="col" copy="Horace Knowles ©" ref="१०:२५">सहरला पगार सोनो झलाकाम पाखाङ उँट डाडे बाज़्याव बैपारी</figure><verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />येसुलो उसिसरं बनै अचम्ब टाडे येसुलाई हैयाडोव, “हो टावसं बान्चिने काङ्काखेने?”<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />येसुये उसिसरंलाई रःङडे हैओडोवरं, “मीराईङाम आव माटाडु, बुरु परमेस्वरङाम टाव ढुव, कडालेकं परमेस्वरये स्यान्टै रोः डोडुव।”<verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />पत्रुसये येसुलाई हैओडोव, “रःङखेने, गे स्यान्जाति राःडे नछिन्ट गेबाज़्या।”<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />येसुये हैओडोवरं, “डस्साज़ ङा जेलाई हैङाडाच्योज़्या, जोये ङालागिटं सोनो चाव सोरलो ओलागिटं, उज़ीःम ओडाज्यु भाइ, ओनाना बैनी, वामा ओबाबु ओज़ारं सोनो ओढन सम्पति राःव, <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />होसोनो हो सहटैसिव निःनेले होकाम नोसंज़ सय गुना भ्या ज़ीःम, डाज्यु भाइ, नाना बैनी, आमा, ज़ारं सोनो जग्गा जमिन नो बेलाकंज़ डैनेले, होकाम राने जुगुलं खर्कज़ मासिने जीबन डैनेले। <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />होकाम ङाःडेङारं छिन्ङ सोनो छिन्ङारं ङाःङ टानेलेरं।”<verse eid="MRK 10:31" /></para>
  <para style="s">येसु सोङ्खेपका फरि उसिने बारेलं भबिस्यबानी ओडोव</para>
  <para style="r">
    <ref loc="MAT 20:17-19">मत्ती २०:१७-१९</ref>; <ref loc="LUK 18:31-33">लुका १८:३१-३३</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />येसु उसिसरासं यरुसलेमडे नाने येमलाग्यान्ट यानाज़्याकं, येसु नोराई याङा-याङा ओनाज़्याव। उसिसरं अचम्ब टाव लेवरं, होकाम उरु छिन्टा रानेरं छेव लेवरं। होकाम येसुये बार जना उसिस भरिरंलाई टङकं लाङरंडे ओल उज्युटं टारिने रोःलो ओबारेलं उसिसरंलाई हैओडोवरं। <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />येसुये हैओवारो, “रःङच्यो, गे यरुसलेमडे गेनाज़्या। होङं मानवालो ओज़ालाई मुख्या सेवा डोनेराई सोनो सास्त्रटा न्याम पैने मीराई लेवङ सुम्पिसिने ले, होकाम नोराई होलाई सैःने सजै यानेलेरं, होकाम नोराई यहुडीरंकाम उरुका मीराई याकुइटं सुम्पिड्यानेलेरं। <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />होकाम होराई नोलाई उल्ली नि गिल्ली डाडे त्युःल्नेलेरं, होकाम कोर्राये यापोःव पाना नोलाई सैःनेलेरं। होकाम उसिव सोङलाका नो फरि ज्युङडा टाडे सोने ले।”<verse eid="MRK 10:34" /></para>
  <para style="s">याकुब सोनो युहन्नानि बिन्ती नेडोव</para>
  <para style="r">
    <ref loc="MAT 20:20-28">मत्ती २०:२०-२८</ref></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />जब्डियालो ओज़ानि, याकुब सोनो युहन्नानि येसु लेवकं राडे हैनेवारो, “गुरबा गिन नङसं जो गिनिः होज़ झैड्यासि वार्ने गिइच्छया लिज़्या।”<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />येसुये होनिलाई ओपजोयोनि, “जेलागिटं ङा कडि झैड्याने वार्ने जियुङलं लिज़्या?”<verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />होनि येसुलाई हैनेडोव, “नमहिमाला राज्यलं गिनलाई नङसंज़ टोबो वोःर्डे टोबोलाई डाबऱ्याडे लेव यासि।”<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />येसुये नोनिलाई हैओडोवनि, “जिन कडि जिनिःज़्याव हो जिन जेमसन। होकाम ङा जो डुखंलो कचौरालाम ङाओँ, हो कचौरालाम जिन जेओँडु? होसोनो ङा जो बप्तिस्मा ङाटारिज़्या हो जिन जेटाडु?”<verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />नोनि येसुलाई हैनेडोव, “गिन गिढु।”</para>
  <para style="p" vid="MRK 10:39">येसुये नोनिलाई हैओडोवनि, “जो कचौरालाम ङा ङाओँ हो कचौरालामज़ जिन पनि ओँनेजेले, जो बप्तिस्मा ङा ङाटारिज़्या हो बप्तिस्मा जिन पनि टानेजेले। <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />हैनि पनि वोःर्डे सोनो डाबऱ्याडे चुङो याने ङा ङाकुइटं माले, आव के जो-जोराई यालागिटं तयार झैसिव लिज़्या, होराई यालागिटंज़ ची।”<verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />आव ठैडे डस जना उसिसरं याकुब सोनो युहन्नासं याभर्किव। <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />होकाम येसुये स्यान्टै उसिसरंलाई खुल्डे हैओडोवरं, “जे जेसनये यहुडीरंकाम उरुका मीराई याखार्ल सासंन डोनेराई नो यहुडीरंकाम उरुका मीराई यातर्ट सासंन चलैरंये। होकाम होराई यासेःरराई फरि होराई यातर्ट अडिकार चलैरंये। <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />जे नेटाव टाटाच्यो। बुरु जेलाम काङ्काये घ्योव टाने पानो, हो जेसेवा डोने ओटाकं। <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />होकाम जेलाम काङ्का पैला टाने बिचार डोव, हो स्यान्टैराई याकमारा ओटाकं, <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />कडालेकं मानवालो ओज़ा सेवा डैने वार्डे माङ्क, बुरु सेवा डोने सोनो स्यानटैराई यापापलो ओझोलो लागिटं ओपोहोन याने ओराव ची।”<verse eid="MRK 10:45" /></para>
  <para style="s">अन्डला बारतिमै ओसोमो</para>
  <para style="r">
    <ref loc="MAT 20:29-34">मत्ती २०:२९-३४</ref>; <ref loc="LUK 18:35-43">लुका १८:३५-४३</ref></para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />होकाम येसु सोनो उसिसरं यरीहो सहरलं याराव, येसु उसिसरासं सोनो माहुले मीरासं यरीहोलाम उपुलुज़्याकं तिमैलो ओज़ा बारतिमै, टोबो अन्डला भिखारी, येमलो ओगोराटं चुङडे उलिज़्याव। <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />नोये आव के नासरतला येसु ची ओलेव वार्डे ओठोयो, होकाम किःडे हैओवारो, “ए येसु, डाउडलो ओज़ा, ङालाई डया डाङ।”<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />होकाम भ्या मीराई हो मीलाई टापाङ्ङन वार्डे याहक्लोयो। होकाम नो अजं कस्सिडे किःडे हैओवारो, “ए डाउडलो ओज़ा ङालाई डया डाङ।”<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />होकाम येसु ठन अडिडे हैओडोवरं, “नोलाई खुल्च्यो।”</para>
  <para style="p" vid="MRK 10:49">होकामटानि होराई नो अन्डलालाई ऐ वार्डे याखुलो, “हिक्मत डोडे च्याङसिडे गराङन्के, येसुये नङलाई खुल्सनज़्याव।” <verse eid="MRK 10:49" /><verse number="50" style="v" sid="MRK 10:50" />होकाम ओक्वा हुँइख्याडे नो ठरच्याङसिडे येसु लेवकं ओराव।<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />येसुये नोलाई हैओडोव, “नङलाई कडि ओचाहिज़्याव, नलागिटं ङा कडि झैने?”</para>
  <para style="p" vid="MRK 10:51">हो मीये येसुलाई हैओडोव, “रब्बी ङामिलङ फरि ओरःनकं।”<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />होकाम येसुये नो मीलाई हैओडोव, “नयेम्डे गनानके। नबिस्वासये नङलाई ससम्डेनैसोनो।”</para>
  <para style="p" vid="MRK 10:52">होकाम होमान्त्राज़ नोलो उमिलंङ ओरोःनो, होकाम येम्ट येसुलो उछिन-उछिन ओनाव।<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">यरुसलेमलं येसु राजा मान्टि उपसिनाव</para>
  <para style="r">
    <ref loc="MAT 21:1-11">मत्ती २१:१-११</ref>; <ref loc="LUK 19:29-38">लुका १९:२९-३८</ref>; <ref loc="JHN 12:12-15">युहन्ना १२:१२-१५</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />येसुरं यरुसलेम सहरलो ओछ्योका जैतुन डान्डा लेवका बेठफागे सोनो बेठानिया वार्ने पोकं याकेरिव, होकाम येसुये नेबऱ्याङ उसिसनिलाई ऐ वार्डे उपरिःङोनि, <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />“जिन ङाःङ लेव नाङखारलं नाचिन होल जेनाज़्याकं टोबो माडाहिसिव गडाहालो ओपाठालाई डैने जेले। होलाई पलाडे आकं रैचीन। <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />कोइराई ‘आव कडि जेझैज़्याव?’ हैयावार्खेभने, प्रभुलाई आव चाहिज़्या, प्रभुये चानोज़ सवोल्नेले वार्डे हैडाचिनरं।”<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />होकाम नोनि नेनाव, टोबो येमका ज़ीःम छ्योकं झलायेम ङाःकं नो माडाहिसिव गडाहा पाठा सुर्सिव नेडोयो, होकामटानि नोलाई नेपलाव। <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />होका च्याङसिव मीराईलाम कोइ कोइराई नोनिलाई यापजोयोरं, “आव माडाहिसिव गडाहालाई पलाडे कडि जेझैज़्याव?”<verse eid="MRK 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 11:6" />नोनि येसुये ओपोयोनि स्यावज़ हैनेडोवरं, होकामटानि नो मीराई नोनिलाई नाव यायोवरं। <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />नोनि गडाहालाई येसु लेवकं नेरोयो, होकाम याक्वारं हाइडे गडाहा तर्ट याटानो, होकाम येसु होटं उचुङो। <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />भ्याबिछुराई याक्वा सोनो कोइ-कोइराई बाङलाम छि ख्वान्डे रैडे येम्ल याटानो। <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />होकाम येसुलो ओङाः उछिन बानेरं ऐ वार्डे याकिःव, “होसन्ना येसु के! रेङो ची, जो स्यान्टैराई भन्डा घ्योव प्रभुलो उमिन्ट रा! <verse eid="MRK 11:9" /><verse number="10" style="v" sid="MRK 11:10" />रेङो ओटाकं गेपुर्खा डाउडलो राने ओराज्य, बनै घ्योव स्वर्गटं होसन्ना!”<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />येसु यरुसलेमलं राडे प्रार्ठना डोने ज़ीःमलं उपसिव। होकाम येसुये होकाला स्यान्टै बस्तरं ओरोःङो पाना रिःम्डे कुबुला ओटावये बार जना उसिसरासं बेठानिया वार्ने नाङखारडे यानाव।<verse eid="MRK 11:11" /></para>
  <para style="s">येसुये डीलो उसिङलाई सराप ओयोव</para>
  <para style="r">
    <ref loc="MAT 21:12-17">मत्ती २१:१२-१७</ref>,<ref loc="MAT 21:18-21">१८-२१</ref>; <ref loc="LUK 19:45-47">लुका १९:४५-४७</ref>; <ref loc="JHN 2:13-16">युहन्ना २:१३-१६</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />ओपराटि येसु सोनो उसिसरं बेठानिया नाङखारलाम यावोलकं येसु ओकंरेव। <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />होकाम टाडाङाम ओख्या लेव डीलो उसिङ रःङडे होटं ओसै मलिज़्या वार्डे येसु सिङ खङकं ओनाव, होकाम हो सिङटं ओख्याकाम कडिज़ मालेव, नो बेलाकं डी सैने बेला मालेव।<verse eid="MRK 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 11:14" />होकाम येसुये हो सिङ्लाई, “आबो खर्कज़ मीराई नसै टाज़्योरंकं।” वार्डे हैओडोव उसिसराई याठोयो।<verse eid="MRK 11:14" /></para>
  <para style="s">येसु प्रार्ठना डोने ज़ीःमलं ओनाव</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />होकाम यरुसलेमलं केडे येसु प्रार्ठना डोने ज़ीःमलं उपसिव, होकाम होलं सामान लःङने सोनो येनेरंलाई होलाम उपुलोयोरं पैसा टोःनेराई याटेबंल सोनो परिवा येनेरं चुङसिडे यालिज़्याव पिर्कारं पल्टैडे ओयोवरं। <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />येसुये प्रार्ठना डोने ज़ीःमलाम काङ्कालाई पनि कडि सामानज़ लाङो मायोवरंये। <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />होकाम येसुये ऐलेडे ओपोयोरं, “कडा ‘ङा ङाज़ीःम स्यान्टै डेसराई यालागिटं प्रार्ठनालो ज़ीःम टानेले वार्डे सर्सिव माले?’ बुरु जे के आव पोलाई डाङ्कुरं याडुप्सिने पो ची झैडे जेनै।”<verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />हो रोः ठैडे मुख्या सेवा डोने मीरं सोनो सास्त्रटा न्याम पैने मीरं येसुलाई कैजैडे सैःने वार्डे उपाय याखिमरिव। कडालेकं होरं येसुसं छेरंये, कडालेकं माहुल्ये मीराई येसुये ओपोयोरं ठैडे अचम्ब टाडे यालिज़्याव।<verse eid="MRK 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19" />रीःम्डे येसु सोनो उसिसरं सहरलाम टङडे यानाव।<verse eid="MRK 11:19" /></para>
  <para style="s">ठोङो डीलो उसिङटाम पैसिने रोः</para>
  <para style="r">
    <ref loc="MAT 21:18-21">मत्ती २१:१८-२१</ref></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />छकाल्ने फरि येसु सोनो उसिसरं हो येमज़ यावोलज़्याकं डीलो उसिङलाई ओजरालामज़ राःङो यारोःङो। <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />होकाम पत्रुसये होछ्यामका रोः ओचेटोयो, होकामटानि पत्रुसये येसुलाई हैओडोव, “रब्बी नङ सराप झाडे नोयोव डीलो उसिङके राःङडे ची ले।”<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />येसुये नोरंलाई जबाफ याडे हैओडोवरं, “परमेस्वरटं बिस्वास नैच्यो <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />डस्साज़ ङा जेलाई हैङाडाच्यो, कोइये यायुङलं सङ्खा माडाडे पाङसिव रोः पुरा टाये वार्डे बिस्वास डोडे आव डान्डा चिसिडे समन्डरलं नान हैयाडोरंखे भने नोलो ओलागिटं नैटावज़ टानेले। <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />हैजैडेज़ ङा जेलाई हैङाडाच्यो, जे जेप्रार्ठनालं जो जिनीःनी पनि हो गेडैडुखे वार्डे बिस्वास डाच्यो, होकाम हो जे डैने जेले। <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />जे प्रार्ठना डोने जेच्याङसिव बेलाकं, कोइ मीरासं माचाव रोः यालेखे भने छेमा याच्योरं, कडावार्क स्वर्गटा लिज़्याव जेबाबुये पनि जेसंका माचाव रोः छेमा ओडाच्योवकं <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />मानि छेमा जेमयोखे भने, स्वर्गटा लेने जेपरमेस्वरये पनि जेसंका अपराडरं छेमा याने माले।”<note caller="+" style="f"><char style="fr" closed="false">१1:२६ </char><char style="ft" closed="false">कोइ कुइये सर्सिव कितापटं आव सर्सिव माले</char></note><note caller="+" style="x"><char style="xo" closed="false">11:२६ </char><char style="xt" closed="false"><ref loc="MAT 6:14-15">मत्ती ६:१४-१५</ref></char></note><verse eid="MRK 11:26" /></para>
  <para style="s">येसुलो ओअडिकार बारेलं प्रस्न</para>
  <para style="r">
    <ref loc="MAT 21:23-27">मत्ती २१:२३-२७</ref>; <ref loc="LUK 20:1-8">लुका २०:१-८</ref></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />येसुरं फरि यरुसलेमला प्रार्ठना डोने ज़ीःमलं राडे आडे होडे ओबारिज़्याकं मुख्या सेवा डोने मीरं, सास्त्रटा न्याम पैने मीरं, सोनो यहुडी नेतारं, येसु लेवकं याराव। <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />होराई येसुलाई यापजोयो, “कडि अडिकारये नङ आव येःनरं नोडोज़्याव? आव येःनरं डोने अडिकार नङलाई काङ्काये ओयानो?”<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />येसुये नोरंलाई हैओडोवरं, “ङा जेलाई टोबो रोः ङापजैच्यो, हो रोःलो ओजबाफ याङच्यो, होकाम कडि अडिकारये ङा आव येःन ङाडोज़्याव, ङा जेलाई हैङाडाच्यो। <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />युहन्नाये ओयोव बप्तिस्मा स्वर्गटाम सै मीराई लेवङाम, ङालाई हैगडाङच्योके।”<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />होकाम नोरं ऐवार्डे या-याज़ यापाङो, “‘स्वर्गटाम’ वार्ने याटाखे भने ‘जे कडा युहन्नालाई बिस्वास जेमडा’ ऐवार्ने ले। <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />‘मीराई लेवङाम’ हैवार्ने वार्क” नोरं होला मीरासं याछेव। कडालेकं स्यान्टैरं युहन्नालाई डस्साका अगमबक्ता वार्डे बिस्वास डोरंये। <verse eid="MRK 11:32" /><verse number="33" style="v" sid="MRK 11:33" />होकाम होराई येसुलाई हैयाडोव, “गेलाई ठा माले।”</para>
  <para style="p" vid="MRK 11:33">येसुये होरंलाई हैओडोवरं, “ङा पनि कडि अडिकारये आव येःन ङाडोज़्या हो ङा जेलाई हैङाम्डाच्यो।”<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">अङ्गुर येःङ अडिया वानेराई यासात्रो</para>
  <para style="r">
    <ref loc="MAT 21:33">मत्ती २१:३३</ref>; <ref loc="LUK 20:9-12">लुका २०:९-१२</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />येसुये नोरंलाई सात्रोङाम हैओडोवरं, “टोबो मीये येःङलं अङ्गुर रुपिडे चारकोनाङाम बार ओबारिव, अङ्गुर पेने टोबो कोलो ओठाङो। होकाम अङ्गुरलो उरीः ठाङ्ने टोबो खाल्टा ओघोव। होकाम टोबो टान्ड झैडे नोये अङ्गुर येःङ अडिया वानेराई याकुइटं राःडे, ओल छुटं डेसडे ओनाव। <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />अङ्गुर फ्याने बेलाकं हो मीये टोबो ओनौकरलाई अङ्गुर येःङलं अडिया वानेराई लेवङं ओभागला अङ्गुर चनाव उपरिःङो। <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />होकाम होराई नो नौकरलाई क्योःडे यापोःव होकाम रितो उकुइ यासोवलो। <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />फरि नोये नोराई लेवङ छुटं ओनौकरलाई उपरिःङो, होलाई पनि नोराई ओङैःटं पोःडे बिज्यात याझोयो। <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />हो येःङ साहुये फरि पनि टोबो ओनौकरलाई उपरिःङो, होकाम होलाई यासोःयो, होकाम उरु भ्यारंलाई पनि उपरिःङोरं, नोरंलाई पनि कोइरंलाई यापोःवरं कोइरंलाई, यासोःयोरं।<verse eid="MRK 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6" />ओल्स टोबो उयुङ्का ओज़ा लेव, ‘नोराई ङाज़ालाई के मान योरंके’ वार्डे स्यान्टैराई भन्डा याछिन्डे नो ओज़ालाई उपरिःङो।<verse eid="MRK 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 12:7" />होकाम हो अडिया वानेरं ऐ वार्डे यापाङसिव, ‘आव के अङ्स ज़्याने ओज़ाची। गराच्योके, आवलाई गेसैःके होकाम ओसम्पति गेमीज़ टानेले।’ <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />होकाम नोराई होलाई क्योःडे सैःडे, हो अङ्गुर येःङलाम पाखाङ याख्यानाव।”<verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />होकाम येसुये फरि हैओडोवर, “अङ्गुर येःङलो ओसाहु कै लेके? अङ्गुर येःङलो ओसाहु रानेले होकाम नो अडिया वानेरंलाई सैःनेरंले, होकाम अङ्गुर येःङ छुटंरंलाई यानेले। <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />जे सास्त्रटा आव बचन जिपरिव माले?</para>
  <para style="q1" vid="MRK 12:10">‘जो लुङलाई ज़ीःम झैनेराई फालिम याझोयो</para>
  <para style="q2" vid="MRK 12:10">हो लुङज़ उगुर लुङ ओटाव।<note caller="+" style="x"><char style="xo" closed="false">1२:१० </char><char style="xt" closed="false"><ref loc="PSA 118:21-23">भजनरं ११८:२१-२३</ref></char></note><verse eid="MRK 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11" />आव के स्यान्टैराई भन्डा घ्योव प्रभुङाम टाव ची,</para>
  <para style="q2" vid="MRK 12:11">होकाम गे गेरःङकं आव अचम्बलाची ले!’”<verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />होकामटानि होराई येसुलाई क्योःने यापानो, कडालेकं आव सात्रो येसुये नोराई याबिरोडलं हैओवारो वार्डे याबुझिव। होकाम नोरं माहुल्ये मीरासं याछेवये नोराई येसुलाई होकंज़ राःडे यानाव।<verse eid="MRK 12:12" /></para>
  <para style="s">कैसरलाई सिरमा फोने बारेलं येसुलाई यापजोयो</para>
  <para style="r">
    <ref loc="MAT 21:15-21">मत्ती २१:१५-२१</ref>; <ref loc="LUK 20:20-26">लुका २०:२०-२६</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />होकाम छिन्डे येसुलाई ओल ओपाङो रोःटंज़ फसैने वार्डे नोराई फरिसीरं सोनो हेरोडीरंलाम कोइ-कोइ मीरं येसु लेवङं यापरिःङोरं। <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />नोरं होकं राडे येसुलाई हैयाडोव, “गुरबा गेलाई ठाज़ ले, नङ सत्यज़ नले, होकाम नङ मीराई कै वार्रके वार्ने रोःलो ओवास्ता नम्डोये कडालेकं नङ मी रःङडे येःन नम्डोये बुरु परमेस्वरलो ओयेम चावसं नपैरंये। हैगवार्ङनके, कैसरलाई सिरमा फोने टाये सै माटाये? <verse eid="MRK 12:14" /><verse number="15" style="v" sid="MRK 12:15" />गे सिरमा फोने सै माफोने?”</para>
  <para style="p" vid="MRK 12:15">येसुये नोराई याकैफट ठा सन्डे हैओडोवरं, “जे ङालाई कडाने जेजान्चिसङज़्याव? टोबो पैसा आकं रैडे सटन्च्यो।”<verse eid="MRK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 12:16" />होराई टोबो पैसा यारोयो। होकाम येसुये होरंलाई हैओडोवरं, “आवटा लिज़्याव सुरुप सोनो छाप काङ्कालो?”</para>
  <para style="p" vid="MRK 12:16">होराई येसुलाई हैयाडोव, “कैसरलो।”<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />होकाम येसुये होरंलाई हैओडोवरं, “कैसरलो कैसरलाई याच्यो, परमेस्वरलो परमेस्वरलाई याच्यो।” होरं येसुलो ओरोः ठैडे अचम्ब याटाव।<verse eid="MRK 12:17" /></para>
  <para style="s">सिडे ज्युङडा टावराई याबारेलं येसुलाई यापजोयो</para>
  <para style="r">
    <ref loc="MAT 21:23-33">मत्ती २१:२३-३३</ref>; <ref loc="LUK 20:27-38">लुका २०:२७-३८</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />सिवलाम ज्युङडा माटारंये वार्ने सडुकीरं येसु लेवकं याराव, होकाम येसुलाई यापजोयो, <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />“गुरबा मोसाये गेलाई सर्डे नैड्यासिव, कोइ मीलो ओडाज्यु बिना सन्तान सिडे ओज्यालाई याख्यानोयोखे भने, ओभाइये नो मेमालाई लाङ्डे ओडाज्युलो ओसन्तान ओझोयोकं। <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />टोबो ज़ीःमलं सात भाइ लेवरं। जेठाये टोबो ज्या ओरोयो, होकाम हो बिना सन्तानज़ उसिव। <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />होकाम माईलाये हो मेमालाई बिह्याँ ओडोव, हो पनि बिना सन्तानज़ उसिव। होकाम साइँलाये पनि हो मेमालाईज़ बिह्याँ ओडोव। <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />होकाम सात भाइराईज़ हो मेमासं बिह्याँ याडोव हैनि पनि यासन्तान माटाये। होकाम छिन्डे हो मेमा पनि उसिव। <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />आबो सिवलाम ज्युङडा याटाकं हो मेमा काङ्कालो ओज्या टा के? कडालेकं हो मेमासं सात भाइराईज़ बिह्याँ याडोव।”<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />होकाम येसुये नोरंलाई हैओडोवरं, “जेअलमलिज़्याव आव कारन माङ्कडोरो, न जे सास्त्र जेसनये न परमेस्वरलो ओसक्तिलाई जेसनये? <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />कडालेकं सिवलाम नोरं फरि ज्युङडा याटाकं, नोरं खेपा मेमा काङ्काराई पनि बिह्याँ माडोरंये, होकाम होरं स्वर्गटा लेने स्वर्गटा कटंवाल स्यानाव टारंये। <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />सिवलाम ज्युङडा टाने रोःटं जे मोसालो ओपोस्टोकोटं जिपरिव माले? कैजैडे जे चाङज़्याव पठरक्यालो बारेलं सर्सिव खन्डलं परमेस्वरये मोसालाई हैओडोव, ‘ङा अब्राहामलो ओपरमेस्वर, इसहाकलो ओपरमेस्वर सोनो याकुबलो ओपरमेस्वर ची।’ <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />परमेस्वर सिवराई यापरमेस्वर माङ्कची, ज्युङडाराई यापरमेस्वर ची, जे चब्बनैज़ अलमल टाडे जेले।”<verse eid="MRK 12:27" /></para>
  <para style="s">स्यान्टैराई भन्डा घ्योव आग्या</para>
  <para style="r">
    <ref loc="MAT 21:34-40">मत्ती २१:३४-४०</ref></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />सास्त्रटा न्याम पैने मीरंलाम टोबो ओराव, होकाम नोरं या-याज़ यायुसिज़्याव ओठोयो। येसुये मीरंलाई मिलिव जबाफज़ ओयोज़्यावरं रःङडे हो मीये येसुलाई ओपजोयो, “स्यान्टै आग्या भरिलाम घ्योव आग्या काव?”<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />येसुये हैओडोव, “स्यान्टैराई भन्डा घ्योव आग्या आवज़ ‘ए इस्राएल आव ठै, स्यान्टैराई भन्डा घ्योव प्रभु गेपरमेस्वर टोबो याज़ ले। <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />नङ प्रभु नपरमेस्वरलाई स्यान्टै नयुङये, स्यान्टै नज्युये, स्यान्टै नडिमाकये सोनो स्यान्टै नसक्तिये मया डो।’ <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />होकाम डोस्रा मुख्या आग्या आवज़, ‘नङ नछिमेकीलाई नङस्यावज़ मया डो।’ आव भन्डा घ्योव आग्या छुटं माले।”<verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />नो सास्त्रटा न्याम पैने मीये येसुलाई हैओडोव, “गुरबा नङ सत्यज़ नपाङखे, प्रभु परमेस्वर टोबो याज़ले, हो प्रभु परमेस्वरकाम छुटं काङ्काज़ माले। <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />परमेस्वरलाई स्यान्टै युङये, स्यान्टै डिमाकये, सोनो स्यान्टै सक्तिये मया डो, होसोनो नछिमेकीलाई नङलाई स्यावज़ मया डो वार्ने आग्यारं स्यान्टै सघाडे चरैसिव सोनो बलिडानरं भन्डा पनि बनै चाव ची।”<verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />नो मी बनै बुड्यालो हिसापये ओपाङो ठैडे येसुये नोलाई हैओडोव, “नङ परमेस्वरलो ओराज्यकाम टाडा नम्ले।” होकाम येसुलाई कडि रोःरं पजैने काङ्कालो उहिक्मतज़ माराये।<verse eid="MRK 12:34" /></para>
  <para style="s">ख्रीस्ट काङ्कालो ओज़ा</para>
  <para style="r">
    <ref loc="MAT 21:41-46">मत्ती २१:४१-४६</ref>; <ref loc="MAT 23:1-36">२३:१-३६</ref>; <ref loc="LUK 20:41-47">लुका २०:४१-४७</ref></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />होकाम येसुये प्रार्ठना डोने ज़ीःमलं ओपैज़्यारंकं हैओवारो, “ख्रीस्ट डाउडलो ओज़ा ची वार्डे सास्त्रटा न्याम पैने मीराई कैजैडे हैयावारो? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />कडालेकं डाउडये ओल्ज़ चोखो आत्माङाम हैवार्डेले,<note caller="+" style="x"><char style="xo" closed="false">1२:3६ </char><char style="xt" closed="false"><ref loc="PSA 110:1">भजनरं ११०:१</ref></char></note></para>
  <para style="q1" vid="MRK 12:36">‘स्यान्टैराई भन्डा घ्योव प्रभुये ङाप्रभुलाई हैओडोव,</para>
  <para style="q2" vid="MRK 12:36">नङ वोःर्डेङा ङाकुइडे चुङङन,</para>
  <para style="q2" vid="MRK 12:36">जोका समं नसुतंररंलाई</para>
  <para style="q1" vid="MRK 12:36">नखङ पाइतला ढुङलं ङामनैरं।’<verse eid="MRK 12:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 12:37" />होकाम डाउडये ओल्ज़ होलाई ‘प्रभु’ याडोवखे भने, काङामटानि नो डाउडलो ओज़ा ओटाव?”</para>
  <para style="s" vid="MRK 12:37">येसुये न्याम पैनेरंलाई चेतावनी ओयोवरं</para>
  <para style="p" vid="MRK 12:37">होकाम होला माहुल्ये मीराई येसुलो ओपाङ बनै खुसि टाडे याठोयो।<verse eid="MRK 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />होकाम ओपैज़्यारंकं येसुये हैओवारो, “सास्त्रटा न्याम पैने मीरासं जोगैसिडे लेच्यो। नोरं खेव क्वा क्वाइसिडे आडे होडे डुलिने सोनो बजारलं ढो डैने, चाव ङप्सिरंये। <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />होसोनो यहुडीरं याडुप्सिने ज़ीःमला मान डैने पो सोनो भट्यारयालं मान डैने पो खिमरंये। <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />नोराई रान्डिनिराई याज़ीःम लुटिरंये, होकाम लोकोचार झैनेलो लागिटं टब्बनखिव प्रार्ठना डोरंये। ऐटाव मीराई बनै घ्योव डन्ड डैनेलेरं।”<verse eid="MRK 12:40" /></para>
  <para style="s">रान्डिनिलो ओभेटी</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />होकाम येसु प्रार्ठना डोने ज़ीःमला भेटी चरैःने छ्योकं उचुङो, होकाम स्यान्टैराई भेटी चरैःने जालं भेटी याझाज़्याव ओरोःङो। भ्या ढनी मीराई भ्या पैसा याचरोःयो। <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />होकाम टोबो गरिब रान्डिनिये राडे ताम्बालो नेबऱ्याङ छिनछिने पैसा रैडे टपैसा झैडे ओचरोःयो।<verse eid="MRK 12:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 12:43" />येसुये उसिसरंलाई ओल लेवकं खुल्डे हैओडोवरं, “डस्साज़ ङा जेलाई हैङाडाच्यो, भेटी चरैःने जालं स्यान्टैराई भन्डा भ्या आव गरिब रान्डिनिये ओचरोयो। <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />कडावार्क स्यान्टैराई यासं भ्या लेव होकाम भ्याज़ याचरोयो, हैनि पनि आव मेमाये के ओल्स ओमलेवछन्डानि पनि स्यान्टै ओकमै भरि ओचरोःयो।”<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">येसुये प्रार्ठना डोने ज़ीःम नास टाने बारेलं भबिस्यबानी ओपाङो</para>
  <para style="r">
    <ref loc="MAT 24:1-51">मत्ती २४:१-५१</ref>; <ref loc="LUK 21:5-36">लुका २१:५-३६</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />येसु प्रार्ठना डोने ज़ीःमलाम उपुलुज़्याकं, उसिसरंलाम टोबोये हैओडोव, “रःङखेने गुरबा, खा बनै चाव ज़ीःमरं सोनो बडा-बडाठासा लुङरं।”<verse eid="MRK 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2" />येसुये नो उसिसलाई हैओडोव, “नङ आव नरःङज़्याव घ्यो-घ्योव ज़ीःमरं के स्यान्टै टैःडे टोबो लुङ तर्ट छुटं लुङ पनि रहिनेमाले।”<verse eid="MRK 13:2" /></para>
  <para style="s">समस्यारं सोनो सतावट</para>
  <para style="r">
    <ref loc="MAT 24:3-13">मत्ती २४:३-१३</ref>; <ref loc="LUK 21:7-19">लुका २१:७-१९</ref></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />प्रार्ठना डोने ज़ीःम ङाःका जैतुन डान्डाटं येसु चुङडे उलिज़्याकं उसिसरं पत्रुस, याकुब, युहन्ना सोनो अन्ड्रियासरं याबाठङ येसु लेवकं राडे येसुलाई यापजोयो, <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />“गेलाई हैगडासिके, आव स्यान्टै घटनारं खर्क टानेलेरं? आव स्यान्टै रोःरं टाने बेलाकं खेटाव-खेटाव चिन्नरं टाने लेरं?”<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />येसुये उसिसरंलाई हैओडोवरं, “होस्यार लेच्यो, जेलाई काङ्काराई पनि टाछकैच्योरंकं। <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />भ्या मीरं ङामिन डाडे ‘ङा होज़’ वार्डे रानेलेरं, होकाम भ्यारंलाई झुकैने लेरं। <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />होकाम जे लराईलो ओगा सोनो ओसोर ठैने जेले हो बेलाकं जे टाछेच्यो। ऐटाव घटनारं के टानेज़ लेरं। हैनि पनि आखिरला डिन राने अजं पनि बाङ्कीज़ लिज़्या। <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />कडालेकं टोबो डेस छुटं डेससं खप्सिनेले, राज्य राज्यलं झगरा टानेले। कोइ-कोइ पोलं भुम्चाल नानेले, अनिकाल पनि टानेले। आव के मेमारं कोना याचुङ्सिरीका डुखं ओटारिका मान्टिव डुखं ओटारिज़्याव ची।”<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />“जे जेलागिटं होस्यार लेच्यो। होराई जेलाई अड्डालं झानेलेरं। जे यहुडीरं याडुप्सिने ज़ीःमलं लाफरा कैने जेले। होकाम घ्योव हाकिमरं सोनो राजाराई याङाःकं ङाबारेलं नोरंलाई गोहाइ याने ङासाची टाडे च्याङसिने जेले। <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />होकाम ङाःडे स्यान्टै डेसला मीरंलाई चाव सोर सठोयोज़ परिये। <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />होकाम मीराई जेलाई क्योःडे अड्डालं लाङने लेरं, हो बेलाकं ङाःडेकामज़ कडि गेपाङ्के वार्डे चिन्ता टाडाच्यो। होकाम हो बेलाकं जेलाई जो हैडासिनेले होज़ पाङच्यो। कडालेकं पाङने जे माङ्क चोखो आत्मा जियुङलाम पाङ्नेले।”<verse eid="MRK 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 13:12" />“टोबो भाइये छुटं भाइलाई ढोका याडे सोःयो परिःङनेलेरं। हैजैडेज़ बाबुये पनि ओज़ारंलाई सोःयो परिःङनेलेरं। जारं यामा याबाबुराई याबिरोडलं च्याङसिने लेरं, होकाम सोःयो परिःङने लेरं। <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />होकाम ङामिन्ट जेलाई स्यान्टैराई घिनैने लेरं। हैनि पनि जो झिन्डे समं बिस्वासलं रहिनेले होज़ बान्चिने ले।”<verse eid="MRK 13:13" /></para>
  <para style="s">छे-छेङप्सिव माचाव बस्त</para>
  <para style="r">
    <ref loc="DAN 11:31">डानिएल ११:३१</ref>; <ref loc="DAN 12:11">१२:११</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />जे छे-छेङप्सिव माचाव बस्तलाई जोकं मालेने होकं ओलेव जेरःङ (परिःनेये उबुझिवकं), होकाम यहुडियाला लिज़्यावरं डान्डाडे ओढोङरंकं। <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />ज़ीःमलो तालटं लेनेरं मेलं टाझरिरंकं, होसोनो याज़ीःमलाम कडिरं हाइने वार्डे ज़ीःमलं टापसिरंकं। <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />येःङला लेनेरं याक्वा चनाने ज़ीःम्डे टावोलरंकं। <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />हैनि पनि चब्बनैला छे-छे ङप्सिव टानेले! नो बेलाका मुऱ्या लेवरं सोनो नुन सोवैने बाल्ख याज़ा लेव मेमारंलाई। <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />नेटाव युःङडाकं टाटाकं वार्डे प्रार्ठना डोच्यो। <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />कडालेकं नो बेलाकं ऐटाव घ्योव आफट रानेले, परमेस्वरये सुरुला स्रिस्टी ओझोयोकाम आर्क समं खर्कज़ ओटाव माले, होसोनो खर्क टाने पनि माले। <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />परमेस्वरये नेटाव डिनरं ओम्घटैखिन्के मीरं काङ्का पनि माबान्चिरं, हैजैडे ओल उरुजिव उमीराई याकारनये नेटाव डिनरं घटैडेनोयो।<verse eid="MRK 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21" />“नो बेलाकं कोइराई जेलाई ख्रीस्ट के आङं लिज़्या नि होङं ची लिज़्या याडाच्योरं भने टापतिच्यो। <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />कडालेकं नो बेलाकं झुठा ख्रीस्टरं सोनो झुठा अगमबक्तारं टाने लेरं, अजं याढुव समं परमेस्वरये उरुजिवरंलाई झुकैनेलो लागिटं चिन्नरं सटन्ने लेरं, होकाम अचम्बला येःनरं पनि डोनेलेरं। <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />हैजैडे जे के होस्यार लेच्यो। सन्डे नैच्यो, ङा जेलाई स्यान्टै रोःरं ङाःडेकामज़ हैङाडाच्योज़्या।”<verse eid="MRK 13:23" /></para>
  <para style="s">मानवालो ओज़ा राने बेला</para>
  <para style="r">
    <ref loc="MAT 24:29-31">मत्ती २४:२९-३१</ref>; <ref loc="LUK 21:25-28">लुका २१:२५-२८</ref></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />“हो बेलाकं नो बनै घ्योव आफंटला समय ओटाव झिन्डे निमी पनि अन्ड्यारो टाने ले, स्यावैये पनि ओचमक यानेमाले, <verse eid="MRK 13:24" /><verse number="25" style="v" sid="MRK 13:25" />सोरोरं नम्टाम नाम्ल टेःनेलेरं, होसोनो नम्टा लिज़्याव सक्तिला येःनरं खल्बल टाने लेरं। <verse eid="MRK 13:25" /><verse number="26" style="v" sid="MRK 13:26" />होबेलाकं मीरं मानवालो ओज़ालाई सक्ति सोनो महिमासं बाडलटं ओराज़्याव रःङनेलेरं। <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />होकाम होये कटंवालरंलाई परिःङडे प्रिठीबीलो ओछ्योङाम नमलो ओछ्योसमं चारडेसाङाम उरुजिवरंलाई डुप्नेरंले।”<verse eid="MRK 13:27" /></para>
  <para style="s">डीलो उसिङटाम पैसिने रोः</para>
  <para style="r">
    <ref loc="MAT 24:32-35">मत्ती २४:३२-३५</ref>; <ref loc="LUK 21:29-33">लुका २१:२९-३३</ref></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />“डीलो उसिङ रःङडे पैसिच्यो। नो सिङलो ओखार झ्याव टाडे ओपलाःव ख्या ओराःव रःङडे उभ्यालि ओलागिवची वार्डे जे ठा जेसनये। <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />हैजैडेज़ जे पनि आव घटनारं ओटाव जेरोःङोपाना बेलाके याटाडु, बुरु नो के झलायेमकंज़ लिज़्या वार्ने सन्ने जेले। <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />ङा जेलाई डस्साज़ हैङाडाच्योज़्या, आव स्यान्टै घटनारं टाडे याम्खेमया समं आव पुस्ता खेम्ने माले। <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />नम सोनो प्रिठीबी खेम्डे नानेले हैनि पनि ङाबचन खर्कज़ खेम्ने माले।”<verse eid="MRK 13:31" /></para>
  <para style="s">नो डिन सोनो बेला काङ्कालाईज़ ठा माले</para>
  <para style="r">
    <ref loc="MAT 24:36-44">मत्ती २४:३६-४४</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />“नो छ्याम सोनो नो बेला खाबला रा वार्ने बाबु परमेस्वरकाम उरुराई मासनरं, न स्वर्गटं लेने कटंवालरं, न मानवालो ओज़ाये। <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />होस्यार लेच्यो, टाङःलच्यो, कडालेकं हो बेला खाबला रा जे ठा जेमसन। <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />आव के टोबो साहुये ओनौकररंलाई ज़ीःमला स्यान्टै येःनरं याजिम्मा-याजिम्मालं यारंडे चौकिडारलाई एकसप्ड्या जागा लेन वार्डे अरैडे ओल छुटं डेसडे ओनाव स्यानावची।” <verse eid="MRK 13:34" /><verse number="35" style="v" sid="MRK 13:35" />“हैजैडेज़ जे पनि जागा लेच्यो, कडालेकं ज़ीःम साहु रीःम्डे सै, आढा रिलं सै, भालेकोकं सै, छकाल्ने खाबला रा जे ठा जेमसन। <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />मानिके ज़ीःम साहु अम्ल्याङसानि ओराकं जेलाई ङःल्डे जिलिज़्याव डैरिच्योवके। <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />ङा जेलाई जो हैङाडाच्योज़्या हो स्यान्टैलाईज़ हैङाडोरं ‘जागा लेच्यो!’”<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">येसुलो उबिरोडलं छल</para>
  <para style="r">
    <ref loc="MAT 26:1-16">मत्ती २६:१-१६</ref>; <ref loc="LUK 21:1-6">लुका २१:१-६</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />होकाम नेलाका निस्तार सोनो खमिर माबराईसिव बरे ज़्याने पर्ब लेव। मुख्या सेवा डोने मीरं सोनो सास्त्रटा न्याम पैने मीराई येसुलाई कैजैडे छल डाडे क्योःडे सैःने वार्डे डाउँ यारःङज़्याव। <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />कडालेकं नोराई याबिचार पर्ब बेलाकं यासैसिखे भने मीरं भ्या हुलडङ्गा डोरं वार्ने लेव।<verse eid="MRK 14:2" /></para>
  <para style="s">येसु बेठानियालं अभिसेक</para>
  <para style="r">
    <ref loc="MAT 26:6-13">मत्ती २६:६-१३</ref>; <ref loc="JHN 12:1-8">युहन्ना १२:१-८</ref></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />बेठानियालं सिमोन याडोज़्याव टोबो कुःरिलो उज़ीःमलं ज़्याव ओज़्योनाकं टोबो मेमा जटामसीलो चोखो, मोङ्गोः अत्तर सिङ्गमरमरलो सिसालं झाडे ओरोयो। होकाम हो सिसा पाडे होला मङमङबासिव अत्तर येसुलो ओङैःटं ठरडे ओयोव। <verse eid="MRK 14:3" /><verse number="4" style="v" sid="MRK 14:4" />होकाम कोइ-कोइ मीरं यारिसैये या-याज़ यापाङसिरं, “एटाव चाव मङमङबासिव अत्तर कडाने खेर ओख्याज़्याव? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />आव अत्तर के सोङसय पैसालो भन्डा भ्यालं येडे, नो पैसा गरिबरंलाई यावढुसि।” होकाम नोराई हो मेमालाई बिरोड याडोव। <figure style="fig" alt="Jars with spikenard" file="hk00117c.tif" size="col" copy="Horace Knowles ©" ref="१४:3">चाव बसैने ठी झाने जारं</figure><verse eid="MRK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6" />होकाम येसुये हैओडोवरं, “आवलाई टाचंलैच्यो, कडाने जेसहटैज़्याव? आवये ङालाई चाव झैडे नैसोङो। <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />कडालेकं गरिबरं के एकसप्ड्या जेसंज़ टारंये, होकाम जेलाई जो बेलाकं जेमन लागि हो बेलाकंज़ जेगैडुरं। होकाम ङा के एकसप्ड्या जेसं ङाम्टा। <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />आव मेमाये जो डोडुज़्याव हो डाडेनोयो। आवये ङाक्याङ गाडिनेलो लागिटं ङाःडेज़ चाव बसैने अत्तर ठिडे तयार झैडे नैसोङो। <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />जेलाई ङा डस्साज़ हैङाडाच्योज़्या, सङसारलं जोङ-जोङ चाव सोर सठैनासी होङ-होङ आव मेमाये ओडोव येःनलो ओबात्रा आवलो ओसम्झनालो लागिटं टानेले।”<verse eid="MRK 14:9" /></para>
  <para style="s">यहुडा येसुलाई क्योःने येःन्ट ओठोम्सिव</para>
  <para style="r">
    <ref loc="MAT 26:14-16">मत्ती २६:१४-१६</ref>; <ref loc="LUK 21:3-6">लुका २१:३-६</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />होकाम येसुलो बारंजना उसिसरंलाम टोबो यहुडा इस्करियोत वार्नेये येसुलाई याकुइटं ढोका याडे सोक्योःने वार्डे मुख्या सेवा डोने मीरं लेवङ ओनाव। <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />आव ठैडे नोरं बनै यारेङो, होकाम नोलाई पैसा याने कबंल पनि यानोयो। होकाम येसुलाई कैजैडे ढोका याडे क्योःने वार्डे चाव मौका खिम्डे याबारिव।<verse eid="MRK 14:11" /></para>
  <para style="s">येसुये उसिसरासं निस्तार पर्बटा भोज ओज़्योव</para>
  <para style="r">
    <ref loc="MAT 26:17-35">मत्ती २६:१७-३५</ref>; <ref loc="LUK 21:7-23">लुका २१:७-२३</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />खमिर माबराईसिव बरे ज़्याने पर्बलो पैला डिन छ्याम, नोराई निस्तार पर्बटा भेडा पाठालो मार यापलो पान्त्रा उसिसराई यापजोयो, “नइछ्या कडि लिज़्या? नलागिटं निस्तार पर्बटा भोज काङं झैने?”<verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />होकाम उसिसरंलाम नेबऱ्याङनिलाई ऐ डाडे उपरिःङोनि, “सहरलं नाचिन, होकाम रीःलो घारी घुरो टोबो मी जिनसं डैसिने ले, होकाम होलो उझिन-उझिन नाचिन। <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />हो मी जो ज़ीःमलं पसिना, हो ज़ीःमला मीलाई हैडाचिन, ‘गुरबाये हैवार्ज़्या’ ङासिसरासं निस्तार पर्बटा भोज ज़्योने ङापाहुना कोठा काङ उलिज़्याव? <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />होकाम होये जिनलाई सजैडे नैसिव ओतर्टा तालटा टोबो घ्योव कोठा सतन्ड्याने ले, हो कोठालंज़ जिन गेलागिटं भोज ज़्याने पो तयार झैचिन।”<verse eid="MRK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16" />होकाम उसिसनि सहरलं नेनाव, होल येसुये हैओवारो स्यानाव नेडोयो, होकाम उसिसनि निस्तार पर्बटा भोज तयार नेझोयो।<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />रिःम्डे बारंजना उसिसरासं ज़ीःमलं ओराव। <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />स्यान्टै चुसिडे भोज याज़्योज़्याकं येसुये हैओडोवरं, “ङा जेलाई डस्साज़ हैङाडाच्योज़्या, जे आकं ङासं ज़्योज़्याव बरिलाम टोबोये ङालाई ढोका याडे सोक्योःने ले।”<verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />उसिसरं स्यान्टै डुखि याटाव, होकाम टोबोनि टोबोये है यावारो, “हो मी ङा रो?”<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />येसुये नोरंलाई हैओडोवरं, “बारंजनालाम टोबो, जोये ङासं टाठीलं बरे छोइज़्याव। <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />कडालेकं मानवालो ओज़ालाई ओबारेलं सास्त्रटं सर्सिव मान्टिवज़ टानेले। होकाम बनै माचाव टानेले नो मीलाई जोये मानवालो ओज़ालाई ढोका योवये, नो मी के ओम्जर्मीखिन् पनि याटाहो।”<verse eid="MRK 14:21" /></para>
  <para style="s">प्रभु भोज</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />होकं ज़्यावग्यान याडोज़्याकं येसुये उकुइटं बरे रैडे आसिक निःडे, बरे केःडे नोरंलाई यावग्यान डाडे हैओडोवरं, “हाँ आव ङाक्याङ ची।”<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />होकाम कचौरा रैडे परमेस्वरलाई ढन्याबाड ओयोवपाना नोरंलाई ओयोवरं, होकाम नोरं स्यान्टैराई होलाम याओँव। <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" />होकाम येसुये नोरंलाई हैओडोवरं, “आव साःरौ न्यामटा ङा ङाझी, जो भ्या मीराई यालागिटं बगैसिये। <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />ङा जेलाई डस्साज़ हैङाडाच्यो, परमेस्वरलो ओराज्यला नो साःरौ अङ्गुरलो उरीः ङामओँया समं ङा फरि अङ्गुरलो उरीः ओँने ङाम्ले।”<verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />होकाम टोबो ढन्यबाडलो भजन गीतं गैडे होलाम पुलुडे जैतुन डान्डाडे यानाव।<verse eid="MRK 14:26" /></para>
  <para style="s">पत्रुसये ईन्कार ओडोने बारेलं येसुलो ओबभिस्याबानी</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />येसुये उसिसरंलाई हैओडोवरं, “जे स्यान्टैये ङालाई राःडे ढोङने जेले, कडालेकं ऐटाव सर्सिव ले, ‘ङा ग्वालालाई पोःने ङाले, होकाम भेडारं चित्राङ पुत्राङ टानेलेरं।’ <verse eid="MRK 14:27" /><verse number="28" style="v" sid="MRK 14:28" />होकाम ङा सिवलाम ज्युङडा ङाटावमान्त्रा जे भन्डा ङाःडे ङा गालीललं नानेङाले।”<verse eid="MRK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29" />पत्रुसये हैओडोव, “स्यान्टैराई याराःसन्नि पनि ङा के नङलाई राःने ङाम्ले।”<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />होकाम येसुये हैओडोव, “ङा डस्साज़ हैङाडानज़्या आछिम रिलं भाले नेखेप ओम्कोडे नङ ङालाई सोङखेप इन्कार डोने नले।”<verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />होकाम पत्रुसये झन कस्सिडे हैओवारो, “नङसं बोलोङ सिने टानि पनि ङा नङलाई ईन्कार डोने ङाम्ले।” होकाम फरि स्यान्टै उसिसराईज़ नो रोः है यावारो।<verse eid="MRK 14:31" /></para>
  <para style="s">येसु गेतसमनी बगैचालं प्रार्ठना ओडोव</para>
  <para style="r">
    <ref loc="MAT 26:36-46">मत्ती २६:३६-४६</ref>; <ref loc="LUK 22:39-46">लुका २२:३९-४६</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />होकाम गेतसमनी उमिन लेव पोलं येसुरं यानाव, होलं नाडे उसिसरंलाई हैओडोवरं, “ङा प्रार्ठना ङाडोव समं जे आकंज़ लेच्यो।” <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />होकाम येसुये पत्रुस, याकुब, सोनो युहन्नालाई ओल्सज़ ओलाङोरं, होकाम येसुये चब्बनै उयुङ माचाव ओझोयो। <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />येसुये नोरंलाई हैओडोवरं, “ङायुङ माचाव टाज़्या होसोनो ङा सिया-सियाज़ ङाटाज़्या। जे आकंज़ लेडे जागा लेच्यो।”<verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />होकाम जामा होसै नाडे नामलं उफुलुप्सिव। ओटाखिन आव बेला ङालेवङं टाराकं वार्डे प्रार्ठना ओडोव। <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />होकाम येसुये हैओवारो, “अब्बा, बाबु नलागिटंके स्यान्टै रोः टानेज़ले। आव कचौरा ङालेवङं टाराकं। हैनि पनि ङावारो मान्टिव माङ्क नवारो स्यानाव ओटाकं।”<verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />येसु फरि वोल्डे ओराकं उसिसरंलाई ङःल्डे यालिज़्याव ओडैरिवरं। होकाम पत्रुसलाई हैओडोव, “सिमोन, नङ ङःल्डे नलिज़्यावरो? टघन्टा पनि माङःल्डे नम्लेडु? <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />माङःल्डे लेच्यो, प्रार्ठना डोच्यो, जे परिछ्यालं टापरिच्यो। आत्माके डस्साज़ तयार लिज़्या, बुरु क्याङ कम्जोर लिज़्या।”<verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />फरि टखेप हो प्रार्ठनाज़ ओडोनाव। <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />फरि ओराव होकाम नोरंलाई ङःल्डे यालिज़्याव ओडैरिवरं, कडालेकं नोराई यामिलङ यामिरंये चब्बनै लठ्ठ टाडे यालिज़्याव, होकं ओललाई कडि जबाफ याने वार्ने पनि मासुन्चिडुरंये।<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />येसु सोङ्खेपका फरि ओराव, होकाम नोरंलाई हैओडोवरं, “जे अजं पनि ङःल्डेज़ जिलिज़्याव? जेनासिज़्याव? आबो याटा, बेला याटाडु, आबो रःङच्यो मानवालो ओज़ा पापीराई याकुइटं क्योःसिरिज़्या। <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />गोसोच्योके बा। ङालाई ढोका याने मी आकंज़ लिज़्या।”<verse eid="MRK 14:42" /></para>
  <para style="s">येसुलाई याक्योव</para>
  <para style="r">
    <ref loc="MAT 26:47-56">मत्ती २६:४७-५६</ref>; <ref loc="LUK 22:47-53">लुका २२:४७-५३</ref></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />येसु ओपाङज़्याकं बारं जना उसिसरंलाम टोबो यहुडा इस्करियोत याडोज़्याव उसिस होकं ओराव। मुख्या सेवा डोने मीरं, यहुडी नेतारं सोनो सास्त्रटा न्याम पैने मीराई यापरिःङो टच्छर मीरं याकुइटं तरवाल, सोनो डेङ्ना डाडे होकं याराव। <verse eid="MRK 14:43" /><verse number="44" style="v" sid="MRK 14:44" />येसुलाई ढोका यानेये हो मीरंलाई टोबो एटानाव साहान डाडे ओनैज़्यावरं, “जो मीलाई ङा म्वाइ ङाडो हो मीज़, होलाईज़ क्योःडे लाङच्यो।”<verse eid="MRK 14:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45" />होकाम यहुडा इस्करियोत येसु लेवकं नाडे “ए रब्बी” वार्डे म्वाइ ओडोव। <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />होकाम होराई येसुलाई याकुइ झाडेज़ याक्योःव। <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />होला लेव मीरंलाम टोबोये तरवाल हाइडे, मुख्या सेवा डोने मीलो ओनौकरलाई ओना च्वाट्ट पल्डेओयोव। <verse eid="MRK 14:47" /><verse number="48" style="v" sid="MRK 14:48" />येसुये नोरंलाई हैओडोवरं, “होकाम जे ङालाई डाङ्कुरंलाई मान्टि तरवालरं, डेङ्नारं रैडे जेक्योःरिसङ्ज़्याव? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />डिनकापटि प्रार्ठना डोने ज़ीःमजिलं ङापैरिकंके जेसंज़ ङालेव, होकं के जेमक्योसङ्ये, बुरु सास्त्र पुरा ओटाकं।”<verse eid="MRK 14:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50" />होकाम स्यान्टै उसिसरं ओल्लाई राःडे याढोङो।<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />ओक्याङटं टोबो सुतिलो क्वाये याज़ मन्ठैसिव टोबो ढापा मी येसुलो उझिन्ट ओराव। नोराई हो ढापा मीलाई क्योःने यापानो। <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />हो मी ओक्वा होकंज़ राःडे नाङ्ग्याज़ ओढोङो।<verse eid="MRK 14:52" /></para>
  <para style="s">यहुडीराई घ्योव याडुप्सिने ज़ीःम ङाःकं येसु</para>
  <para style="r">
    <ref loc="MAT 26:57-68">मत्ती २६:५७-६८</ref>; <ref loc="LUK 22:66-71">लुका २२:६६-७१</ref>; <ref loc="JHN 18:13">युहन्ना १८:१३</ref>; <ref loc="JHN 14">१४</ref>; <ref loc="JHN 18:19-24">१८:१९-२४</ref></para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />होकाम नोराई येसुलाई मुख्या सेवा डोने मीरं लेवङ यालाङो, होल मुख्या सेवा डोने मीरं, यहुडीराई यानेतारं, सोनो सास्त्रटा न्याम पैने मीरं डुप्सिव लेवरं। <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />पत्रुस मुख्या सेवा डोने मीलो ओठारालं टाडाङामज़ येसुलो उझिन-उझिन ओराव, होकाम होलं सिफाइँरासं चुसिडे मेः उमुन्सिव। <verse eid="MRK 14:54" /><verse number="55" style="v" sid="MRK 14:55" />आबो मुख्या सेवा डोने मी सोनो स्यान्टै यहुडीरं याडुप्सिने घ्योव ज़ीःमला मीराई येसुलाई सैःने वार्डे, उबिरोडलं गोहाइ याखिमो, हैनि पनि कडिज़ माडैरंये। <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />भ्या मीरं येसुलो उबिरोडलं झुठा गोहाइ यायोरं हैनि पनि नोराई यागोहाइज़ मामिलिये।<verse eid="MRK 14:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57" />कोइ-कोइरं उबिरोडलं च्याङडे ऐ वार्डे झुठा गोहाइ पनि यायोव। <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />“आवये ऐ ओवारो पनि गेठोयो, ‘मीराई याकुइये याझोयो आव प्रार्ठना डोने ज़ीःम ङा टैःनेङाले, होकाम नो प्रार्ठना डोने ज़ीःम सोङलाका तयार झैने ङाले।’ जो प्रार्ठना डोने ज़ीःम मीराई याझोयो माङ्क।” <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />होकाम आवटं पनि स्यान्टैराई यागोहाइ टोबो नास्याव माटाये।<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />होकाम मुख्या सेवा डोने मीये याखार्ल च्याङसिडे येसुलाई ओपजोयो, “होकाम आवराई याडोसैसन्ज़्याव डोसलो ओजवाफ नङसं कडिज़ माले? आव मीराई नबिरोडलं यायोव जबाफ कडि?”<verse eid="MRK 14:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="MRK 14:61" />येसु गाइगुइ मालेडे कडि जबाफ पनि मायोवये। मुख्या सेवा डोने मीये फरि ओपजोयो, “होकाम नङ चोखो परमेस्वरलो ओज़ा ख्रीस्ट रो?”<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />येसुये हैओवारो, “अँ ङाज़, होकाम जे मानवालो ओज़ालाई स्यान्टैराई भन्डा चोखो परमेस्वरलो ओसक्तिसं वोःरडेङा उकुइ लेवडे चुङडे नम्टा बाडलटं ओराज़्याव रःङने जेले।”<verse eid="MRK 14:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63" />होकाम मुख्या सेवा डोने मीये ओक्वा चिडे हैओवारो, “गेलाई उरु साचीरं कडाने ओचाहिवडं?” <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />परमेस्वरलाई बिरोड ओडोज़्यावके जेठैखेसानि ड। जे जिबिचार कडि लिज़्या?</para>
  <para style="p" vid="MRK 14:64">होकाम नो स्यान्टैराई येसुलाई अपराडी ठहरैडे सैःने समंका सजै याने याठहरोयो। <verse eid="MRK 14:64" /><verse number="65" style="v" sid="MRK 14:65" />कोइ कोइराई येसुलाई यात्युलो, होकाम कोइराई येसुलाई ओङा लुःमडे ऐ वार्डे यागिल्लैयो, “अगमबानी गपाङ्ङनके नङलाई काङ्काये ओपोःसोनो।” होकाम सिफाइँराई येसुलाई याजिम्मालं रैडे घुस्सा घुस्साये याढिङ्गोयो।<verse eid="MRK 14:65" /></para>
  <para style="s">पत्रुसये येसुलाई ईन्कार ओडोव</para>
  <para style="r">
    <ref loc="MAT 26:69-75">मत्ती २६:६९-७५</ref>; <ref loc="LUK 22:56-62">लुका २२:५६-६२</ref>; <ref loc="JHN 18:15-18">युहन्ना १८:१५-१८</ref>,<ref loc="JHN 18:25-27">२५-२७</ref></para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />पत्रुस मेलं ठारालं चुङडे उलिज़्याकं मुख्या सेवा डोने मीलो टोबो ओनौकर्नी होकं ओराव, <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />होकाम पत्रुसये मेः उमुन्सिज़्याकं होकं उलिज़्याव रःङडे हो मेमाये हैओडोव, “नङ पनि नासरतला येसुसं नलेवसानी।”<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />होकाम पत्रुसये ऐ लेडे ईन्कार ओडोव, “आव कै नवार्ज़्याव, न ङासंन न ङाबुझि।” होकाम नो पाखाडे पुलुने मुल झलालेवडे ओनाव। होकाम भाले ओकोव।<verse eid="MRK 14:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69" />नौकर्नीये फरि पत्रुसलाई रःङडे होला च्याङसिव मीरंलाई हैओडोवरं, “नोरंलाम टोबो आव पनि होज़।” <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />पत्रुसये फरि ईन्कार ओडोव।</para>
  <para style="p" vid="MRK 14:70">होकाम टढेसका आसै-होसै च्याङसिव मीराई पत्रुसलाई फरि यापजैरं, “डस्साज़ नङ पनि नोराईङाम टोबोज़ कडालेकं नङ पनि गालीलीज़।”<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />होकाम पत्रुसये ओललाई सरापिडे किऱ्या ज़्योडे हैओवारो, “जे काङ्कालो ओरोः जेडोज़्याव हो मीलाई ङा ङाम्सरे।”<verse eid="MRK 14:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72" />होकाम होमान्त्राज़ नेकराङ भाले ओकोव, पत्रुसलाई येसुये हैओडोव रोः ओचेटोयो, “भाले नेकराङ कोँने भन्डा ङाःडे नङ ङालाई सोङखेप ईन्कार डोने नले।” होकाम नो रोःलाई चेटैडे पत्रुस ढर-ढर ओघोरो।<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">पिलातसलो ओङाःकं येसु</para>
  <para style="r">
    <ref loc="MAT 27:11-31">मत्ती २७:११-३१</ref>; <ref loc="LUK 23:2-3">लुका २३:२-३</ref>; <ref loc="LUK 23:18-25">२३:१८-२५</ref>; <ref loc="JHN 18:28-40">युहन्ना १८:२८-४०</ref>; <ref loc="JHN 19:1-16">१९:१-१६</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />छकाल्ने ओटाव पाना मुख्या सेवा डोने मीरं, यहुडी नेतारं, सास्त्रटा न्याम पैने मीरं सोनो स्यान्टै यहुडीरं याडुप्सिने ज़ीःमला स्यान्टै मीराई सल्ला डाडे येसुलाई किडे पिलातस लेवङ लाङडे यासुम्पिव।<verse eid="MRK 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 15:2" />पिलातसये येसुलाई ओपजोयो, “होकाम नङ यहुडीराई याराजा रो?” येसुये जबाफ ओयोव, “नङ हैनवार्ज़्याव स्यानावज़।”<verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />मुख्या सेवा डोने मीराई येसुलाई बनै भ्या रोःटं याडोसोयो। <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />पिलातसये येसुलाई फरि ओपजोयो, “होकाम नङसं कडि जबाफज़ माले रो? नोराई नबिरोड डाडे खाडंङ डोसैसन्ज़्यारं।”<verse eid="MRK 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5" />होकाम येसुये फरि पनि कडि जबाफज़ मायोवये, पिलातस पनि बक्क ओटाव।<verse eid="MRK 15:5" /></para>
  <para style="s">येसुलाई सैःने डन्ड</para>
  <para style="r">
    <ref loc="MAT 27:15-26">मत्ती २७:१५-२६</ref>; <ref loc="LUK 23:13-25">लुका २३:१३-२५</ref>; <ref loc="JHN 18:39-19:16">युहन्ना १८:३९—१९:१६</ref></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />निस्तार पर्ब बेलाकं प्रजाराई राःने यावारो टोबो कैतीलाई पिलातसये ङाःडेकामज़ राःड्यानेरं चलन लेव। <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />हुलडङ्गा ओटाव बेलाकं मी सैःने हत्यारारं झ्यालखानालं लेवरं। होरंलाम बारब्बा याडोज़्याव टोबो कैती पनि होल लेव। <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />मीरं राडे पिलातसलाई ओचलन अनंसार कैती राःड्याने वार्डे बिन्ती याडोव। <verse eid="MRK 15:8" /><verse number="9" style="v" sid="MRK 15:9" />नोरंलाई पिलातसये ओपंजोयोरं, “होकाम ङा यहुडीराई याराजालाई राःडेङायाच्यो वार्ने जियुङलं उलिज़्याव रो?” <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />कडालेकं इख डाडेज़ मुख्या सेवा डोने मीराई येसुलाई पिलातस लेवङ यासुम्पिव, वार्ने रोः पिलातसलाई ङाःडेज़ ठा लेव।<verse eid="MRK 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11" />बुरु बारब्बालाई राःड्यासिच्यो वार्डे मुख्या सेवा डोने मीराई होला मीरंलाई याचम्कोयोरं।<verse eid="MRK 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 15:12" />पिलातसये फरि नोरंलाई ओपंजोयोरं,</para>
  <para style="q1" vid="MRK 15:12">“जोलाई जे यहुडीराई याराजा जेडोज़्या, जे हैगवार्च्योके होलाई ङा कै झैने?”<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />नोरं फरि कस्सिडे किःडे हैयावारो, “नोलाई क्रुसटं टाङ्गि।”<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />पिलातसये नोरंलाई हैओडोवर, “कडा? आवये कडि अपराड डाडे ओनैज़्यावड?” होरं झन कस्सि-कस्सिडे याकिःव, “नोलाई क्रुसटं टाङ्गि।”<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />होकाम पिलातसये माहुल्ये मीरंलाई सोन्टोको झैनेरं वार्डे बारब्बालाई राःडे ओयोवरं, होकाम येसुलाई कोर्राये पोःडे क्रुसटं टाङगिव उपरिःङोरं।<verse eid="MRK 15:15" /></para>
  <para style="s">सिफाइँराई येसुलाई यागिल्लोयो</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />सिफाइँराई येसुलाई प्रेटोरियान याडोज़्याव घ्योव ज़ीःमलं यालाङो, होकाम सिफाइँराई पल्टनला स्यान्टैलाईज़ याडुपोरं। <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />होकाम नोराई येसुलाई निल्ल्याव क्वा याक्वायो। होकाम ज़ुलो ओखारलाई पगरि झैडे ओङैःटं यासंजाव। <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />होकाम सिफाईँराई, “यहुडीराई याराजालाई जय!” वारोग्यान सलाम डोवग्यान याडोव। <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />होकाम ओङैःटं ज़िःङलो भाटाये पोःवग्यान, त्युलो ग्यान डाडे याघुन्डा टिकिसिडे ढो पनि याडोव। <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />होकाम येसुलो उगिल्ला याडोवमान्त्रा ओक्याङटाम निल्ल्याव क्वा याहाइड्योव, होकाम येसुलाई ओक्वाज़ याक्वायो। होकाम येसुलाई क्रुसटं टाङ्गिने पाखाडे यालाङो।<verse eid="MRK 15:20" /></para>
  <para style="s">येसुलाई क्रुसटं याझुन्डोयो</para>
  <para style="r">
    <ref loc="MAT 27:32-44">मत्ती २७:३२-४४</ref>; <ref loc="LUK 23:33-34">लुका २३:३३-३४</ref>; <ref loc="JHN 19:17-27">युहन्ना १९:१७-२७</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />होकाम अलेकजेन्डर सोनो रुफसलो ओबाबु, कुरेनीलं लेने सिमोनलाई नाङखारलाम ओराज़्याकं येम्ट डैडे येसुलो उक्रुस जबरजस्ति सुघुर्ने वार्डे याक्योःव। <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />होकाम नोराई येसुलाई गलगठा वार्ने पोलं यालाङो। गलगठालो ओमाने “खप्पर लेव पो” टाये। <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />होकाम नोराई येसुलाई मुर्र बराईसिव अङ्गुरलो मड्ड यायोव, हैनि पनि येसुये नो माओँवये। <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />नोराई येसुलाई क्रुसटं याटाङगिव। होकाम नोराई येसुलो ओक्वा भाने, वार्डे याखार्ल गोला याझाव। <verse eid="MRK 15:24" /><verse number="25" style="v" sid="MRK 15:25" />नोराई येसुलाई क्रुसटं याटाङगिज़्याकं छकाल्नेका नौ बजिव लेव। <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />येसुलाई याडोसोयो डोस पाटीटं “यहुडीराई याराजा” सर्सिव लेव <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />नोराई येसुसं नेबऱ्याङ डाङ्कुरंलाई पनि क्रुसटं याटाङगिवरं, येसुकाम टोबोलाई वोःरडे, छुटंलाई डाबऱ्याडे। <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />सास्त्रटा बचन ऐ झैडे पुरा ओटाव, “येसु अपराडीलं उगनिसिव।”<note caller="+" style="f"><char style="fr" closed="false">१५:२८ </char><char style="ft" closed="false">आव बचन कोइ कुइये सर्सिव कागत यालं माले लुका २1:3७</char></note><verse eid="MRK 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29" />होलाग्यान्ट बाने मीराई याङैः हल्लैडे ऐ लेडे उबिरोड डाडे यागिल्लोयो, “डे! नङ माङ्कडोरो प्रार्ठना डोने ज़ीःम टैःडे सोङलाका तयार झैने, <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />क्रुसटाम झरिडे राडे नङ नङलाईज़ गबचैके।”<verse eid="MRK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31" />हैजैडे मुख्या सेवा डोने मीरं सोनो सास्त्रटा न्याम पैने मीरं ऐ लेडे ख्याल याडोव, “आवये उरुरंलाई ओबोचोयोरं हैनि पनि ओललाई के माबचैडुवये। <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />आव इस्राएलला याराजा, ख्रीस्ट आबो क्रुसटाम वोल्डे ओराकं, होकाम गे नोलाई रःङडे बिस्वास डोनेगेले।” ओल्स क्रुसटा टाङ्गिसिवनि पनि निगिल्लोयो।<verse eid="MRK 15:32" /></para>
  <para style="s">येसु उसिव</para>
  <para style="r">
    <ref loc="MAT 27:45-56">मत्ती २७:४५-५६</ref>; <ref loc="LUK 23:44-49">लुका २३:४4-४९</ref>; <ref loc="JHN 19:28-30">युहन्ना १९:२८-३०</ref></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />बार बजे काम तीन बजे समं स्यान्टै डेस भरि अन्ड्यारो ओटाव। <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />तीन बजेयालं येसु ऐ लेडे कस्सिडे उकिःव, “इलोई-इलोई लामा सबखठनी?” आवलो ओमाने, “ए ङापरमेस्वर ए ङापरमेस्वर नङ ङालाई कडाने नराःसोङो?”<verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />होकाला लेवराई कोइ कोइराई आव ठैडे हैयावारो, “ठैच्यो खेने नोये एलियालाई उखुल्ज़्याव।” <verse eid="MRK 15:35" /><verse number="36" style="v" sid="MRK 15:36" />होकाम टोबो मी गुर-गुर ज़ोःनाडे टोबो भुटुने सिर्कालं छिमडे टोबो खेव ज़िःङटाम ओयोव, “डे, रःङनेडाइ कडिग्यान एलियाये आवलाई झारैरिव सै?”<verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />येसु कस्सिडे उकिःव होकाम ओसं ओफ्याव।<verse eid="MRK 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38" />होकाम प्रार्ठना डोने ज़ीःमला क्वालो बार रोटाम मेलं समं चिडे नेफंलाङ ओटाव। <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />येसुलो ओसं ऐ टाडे ओफ्याव रःङडे येसुलो ओछ्योका च्याङसिव कप्तानये हैओवारो, “आव के डस्साज़ परमेस्वरलो ओज़ाची ओलेवलेव।”<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />होकं टाडाङाम रःङने, कोइ-कोइ मेमारं पनि लेवरं। नोरंलाम मरियम मग्डलिनी, आलिज़ा याकुब, योसेफलो वामा मरियम सोनो सलोमी लेवरं। <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />येसु गालीललं ओलेव बेलाकं नोरं येसुलो उझिन्ट बारिरंये। होकाम ओसेवा पनि डोरंये। येसुसं यरुसलेमलं रावरं भ्या मेमारं पनि लेवरं।<verse eid="MRK 15:41" /></para>
  <para style="s">येसुलाई गाडिसिव</para>
  <para style="r">
    <ref loc="MAT 27:56-61">मत्ती २७:५६-६१</ref>; <ref loc="LUK 23:50-56">लुका २३:५०-५६</ref>; <ref loc="JHN 19:38-42">युहन्ना १९:३८-४२</ref></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />तयार टाने डिन छ्याम (नाःसिने छ्यामलो ओङाटा छ्याम), रिःम्डे ओटारिज़्याकं। <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />घ्योव सभाला ओमान लेव मी अरिमाठियाला योसेफये परमेस्वरलो ओराज्य राने येम ओरःङज़्याव, होये माछेडे पिलातस लेवङं नाडे पिलातससं येसुलो सिव ओक्याङ उनीःव। <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />येसु ङाःडेज़ उसिव ची लेव वार्ने रोः ठैडे पिलातस अचम्ब ओटाव। होकाम पिलातसये कप्तानलाई खुल्डे येसु उसिव सै उम्सिव वार्डे ओपजोयो। <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />येसु उसिव रोः कप्तानये हैओडोव मान्त्रा पिलातसये योसेफलाई येसुलो सिव ओक्याङ गलाङके ओडोव। <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />होकाम योसेफये सुतिलो क्वा लःङडे येसुलो सिव ओक्याङ क्रुसटाम मेलं झारैडे क्वाटं पोडे लुङ खुलिडे झैसिव खाडरलं ओनोयो, नो खाडरलो ओयाःलाई टोबो पल्याटाये ओकोपो। <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />मरियम मग्डलिनी सोनो योसेफलो वामा मरियमनि येसुलाई गाडिसिव पो रःङडेज़ नेनैज़्याव।<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">येसु फरि ज्युङडा ओटाव</para>
  <para style="r">
    <ref loc="MAT 24:1-8">मत्ती २४:१-८</ref>; <ref loc="LUK 24:1-12">लुका २४:१-१२</ref>; <ref loc="JHN 20:1-20">युहन्ना २०:१-२०</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />नाःसिने डिन ओखेमो पान्त्रा मरियम मग्डलिनी सोनो याकुबलो वामा मरियम, होसोनो सलोमीराई येसुलो ओक्याङटं ठिड्याने वार्डे चाव बसैने ठी यालोःङो। <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />साताका पैला डिन छ्याम छकाल्ने निमी ओपलेरिज़्याकं नोरं खाडरलं यानाव। <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />होकाम नोराई हैयावारो, “गेलाई खाडरलो ओयाः कप्सिव लुङ काङ्काये फैड्यासिवके?”<verse eid="MRK 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 16:4" />नोराई याडे यारःङकं खाडर कप्सिव लुङ फैसिव उलिज़्याव यारोःङो नो लुङ बनै घ्योव लेव। <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />नोरं खाडर लेवकं यानाकं टक-टक पलाङो खेव क्वा क्वाइसिव टोबो ढापा मीलाई खाडरकाम वोःरडे चुङडे उलिज़्याव यारोःङो, नेटानाव रःङडे नोरं बनै छक्क याटाव।<verse eid="MRK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6" />हो ढापा मीये नोरंलाई हैओडोवरं, “अचम्ब टाटाच्यो, जे क्रुसटं टाङगिडे यासोयो नासरतला येसुलाई जिखिम्ज़्याव माङ्क डोरो। नो के सिवलाम ज्युङडा याटाडु, आलं माले। नोलाई यानोयो पोलं गरःङरिच्योके। <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />गनाच्योके, नाडे उसिसरंलाई सोनो पत्रुसलाई हैडाच्यो। येसु जेङाः-जेङाः गालीललं नारिज़्या। येसुये जेलाई हैओडाच्योव मान्टि जे होलाई नलं डैने जेले।”<verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />होकाम नो मेमारं येसुलो रितो ओखाडरलाम पुलुडे आव मी के खर्कज़ मासिने ची ओलेव वार्डे ज़ोःये-ज़ोःये यानाव, कडालेकं नोरं येसु सिडे ज्युङडा ओटाव ओखाडर पो रःङडे याछ्यासैये करिङ-करिङ यागुज़्याव। होकाम नोरं डस्साज़ छेडे नो रोः उसिसरंलाई सोनो पत्रुसलाई काङ्कालाईज़ हैमाडोरंये।<verse eid="MRK 16:8" /></para>
  <para style="s">
    <note caller="+" style="f">
      <char style="fr" closed="false">१६:९ </char>
      <char style="ft" closed="false">कोइ पुरानो कुइये सर्सिव कितापयालं याज़ आव डैसिये </char>
    </note>येसु मरियम मग्डलिनी लेवङ ओसंतन्सिव</para>
  <para style="r">
    <ref loc="MAT 28:9-20">मत्ती २८:९-२०</ref>; <ref loc="LUK 24:13-43">लुका २४:१३-४३</ref>; <ref loc="JHN 20:11-23">युहन्ना २०:११-२३</ref>; <ref loc="ACT 1:4-11">प्रेरित १:४-११</ref></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />साताका पैला डिन छ्याम छकाल्ने येसु ज्युङडा ओटाव पान्त्रा मरियम मग्डलिनी लेवङ ओसंतन्सिव। ङाःडे नो लेवङाम येसुये सातगोटा ज़्याःरं ओहायोरं। <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />नो मरियमये येसु ज्युङडा ओटाव रोः उसिसरंलाई हैओडोवरं। नोरं लाम्सी-लाम्सी याघरज़्याव। <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />येसु ज्युङडा टाडे मरियम लेवङं ओसंतन्सिव वार्ने सोर याठैकं उसिसराई मापतिरंये।<verse eid="MRK 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />होकाम येसुलो नेबऱ्याङ उसिसनि नाङखारडे नेनाज़्याकं नोनि लेवङ येसु छुटं उरुप रैडे ओसंतन्सिव। <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />होकाम नोनि वोल्डे नाडे उरुरंलाई पनि हैनेडोवरं। होकाम नोराई नोनि नेरोः पनि मापतिरंये।<verse eid="MRK 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />झिन्डे येसु एघार जना उसिसराई काङ याज़्योज़्याव बेलाकं ओसंतन्सिव। होकाम नोराई येसु ज्युङडा ओटाव नो रोः यामपतिव रःङडे ओहकलोयोरं, कडालेकं नोराई यायुङ खाव टाडेउलिज़्याव। होसोनो येसु सिवलाम ज्युङडा ओटाव झिन्डे ओल्लाई रःङनेराई यारोः उसिसराई यामपटिव। <verse eid="MRK 16:14" /><verse number="15" style="v" sid="MRK 16:15" />येसुये नोरंलाई हैओडोवरं, “जे प्रिठीबीला स्यान्टै पोलं नाडे परमेस्वरये उसिर्जोयो स्यान्टै मीरंलाई चाव सोर सठैच्योरं। <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />बिस्वास डोनेरं सोनो बप्तिस्मा टानेरं, पापलाम बान्चिनेलेरं। बुरु बिस्वास माडोनेरं डोसि ठहरिडे सजै डैने लेरं। <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />बिस्वास डोनेरासं ऐटाव चिन्नरं टानेले येसुलो उमिन्ट ज़्याःर सोढोङने लेरं, होसोनो नोरं साःरौ पाङ पनि पाङने लेरं। <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />नोराई गुलरं क्योःनेलेरं होसोनो सिने वासं याज़ोनि पनि नोरं कैज़ टाने मालेरं। नोराई ठलिव मीराई याक्याङटं याकुइ नैने लेरं, होकाम नोरं सम्ने लेरं।”<verse eid="MRK 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />होकाम प्रभु येसु नोरासं ओपाङो मान्त्रा स्वर्गडे ओछेनसिव, होकाम परमेस्वरलो वोःरडेङा उकुइडे उचुङो। <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />उसिसराई आव रोः चारकोना यासंठोयो। नोराई आव येःन याडोकं प्रभुये पनि ओगयोरं। होकाम चिन्नरं सटन्डे प्रभुलो ओपाङलाई अजं पक्का याझोयो।<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>