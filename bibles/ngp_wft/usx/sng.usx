<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="SNG" style="id">- Ngulu Bible Version</book>
  <para style="h">Ukemi Wedi</para>
  <para style="toc1">UKEMI WEDI</para>
  <para style="toc2">Ukemi wedi</para>
  <para style="mt3">Ukem</para>
  <para style="mt1">UKEMI WEDI</para>
  <para style="imt">Ulongoelo wa Ukemi Wedi Ukemi wedi ni kitabu kikulonga mbuli za lukunde lwa mgosi na mvele kwa Waizilaeli. Kitabu iki chadahika chawandikagwa ni want'hu wengi we hengi. Mwo ulosi we Kiyahudi ziyuko mbuli enga 'ukemi wedi' hegu 'seuta ywa maseuta' ikanda ni enga kugamba, ukemi utunyiswe mwo ukemi wose', hegu 'seuta mkulu mwa maseuta wose.' Kitabu chakonga kwa kumtambula seuta Selemani. Ukemi wedi 1:1, Mna ino hiyo kugamba yehe niye akiwandikaga. Yadahika kugamba kitabu iki chawandikagwa ni mnt'hu mtuhu akataila kuika lukumbusa lwa seuta Selemani. Wamanyi we zimbuli ze kibibilia hawamanyize kugamba kitabu icho chawandikagwa ini. Mna vadahika kugamba kitabu iki chawandikagwa mwe miyaka ya 970 na 931 umwo Kilisito andaga akei kwelekwa, mna niyo chombokelwa vedi mwe miyaka mituhu kulongole. Ukemi wedi ni kitabu kimemile nt'hogola za lukunde mwa mgosi na mvele. Mwe kitabu iki chose chasimuila mbuli za mgosi na mvele ivo wakukeunga. Kwa lupisi lwi hengi mndani mwe simulizi ino wambuya wo mbwanga na wadya wo mwana kike walangiliza hamwenga ne mila ya lukunde ikugendeela. Ukemi 1:8. Wamanyi wengi wazumilana kugamba kikulu mwe simulizi ye kitabu iki imwo mnango wa 8 no msafa wa 5 kubula msafa wa 7. Mwe misafa iyo mvele agamba lukunde luna udahi enga file. Lukunde ni kint'hu kina ludole lutendese chakiiva kwa kundani mwo moyo, hukudaha kudikindila ivo kikuunga. Vadahika nivo vikuleka akakanya nk'hanana nt'hatu kugamba want'hu wasekwimula lukunde umwo lupisi lwakwe lukei kubula, Ukemi wedi 2:7; 3:5; 8:4.</para>
  <para style="iot">Yemndani kwa ugihi</para>
  <para style="io">Zina dye kitabu, di mwe mnango 1:1 .</para>
  <para style="io">Ukemi wa nk'hongo mnango 1:2 kubula 2:7.</para>
  <para style="io">Ukemi wa kaidi mnango 2:8 kubula 3:5.</para>
  <para style="io">Ukemi wa katatu, mnango wa 3:6 kubula 5:1.</para>
  <para style="io">Ukemi wa kane, mnango 5:2 na 6:3.</para>
  <para style="io">Ukemi wa shano, mnango 6:4 na 8:4.</para>
  <para style="io">Uheelo wo ukemi uno wo Umbwiya mwo mnango 8:5 kubula 8:14.</para>
  <chapter number="1" style="c" sid="SNG 1" />
  <para style="s">Ukemi wa nk'hongo</para>
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1" />Ukemi wa Selemani utendesa wedi kujink'ha ukemi wose.<verse eid="SNG 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 1:2" />Uninonele no mnomo wako,</para>
  <para style="q" vid="SNG 1:2">kwaviya lukunde lwako lwanitenda ninde na kinyemi kujink'ha divai.<verse eid="SNG 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 1:3" />Mhemp'he wako wevika vedi,</para>
  <para style="q" vid="SNG 1:3">naho zina dyako ni enga mhemp'he ugidigwe.</para>
  <para style="q" vid="SNG 1:3">Nivo vikuleka wali wakuungisa.<verse eid="SNG 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 1:4" />Sunguza kuniguha kiitanye,</para>
  <para style="q" vid="SNG 1:4">seuta kanigala kwe chumba chakwe.</para>
  <para style="q" vid="SNG 1:4">naho nekikuonele kinyemi na kukwangila.</para>
  <para style="q" vid="SNG 1:4">nekitunye lukunde lwako kujink'ha divai.</para>
  <para style="q" vid="SNG 1:4">kaula ivo viwagilwe kwa wavele kukuungisa.<verse eid="SNG 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 1:5" />Nyuwe wavele wa Yelusalemu,</para>
  <para style="q" vid="SNG 1:5">miye ni mtitu mna ni mbwanga.</para>
  <para style="q" vid="SNG 1:5">enga mahema ya Kedali,</para>
  <para style="q" vid="SNG 1:5">naho enga mapazia ya Selemani.<verse eid="SNG 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 1:6" />Msekunikaulisa kwajili yo utitu wangu,</para>
  <para style="q" vid="SNG 1:6">kwaviya zuwa nidyo dilekile handa mtitu.</para>
  <para style="q" vid="SNG 1:6">wandugu zangu waniihiya.</para>
  <para style="q" vid="SNG 1:6">wanitendaga mwamizi mwe migunda ye mizabibu.</para>
  <para style="q" vid="SNG 1:6">mna mgunda wangu mwenye we mizabibu hiukaulise.<verse eid="SNG 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 1:7" />Unigambile weye huungise.</para>
  <para style="q" vid="SNG 1:7">Wadimila hii fyo dye zingoto zako?</para>
  <para style="q" vid="SNG 1:7">Naho nouzihumuze hii ikabula nomsi?</para>
  <para style="q" vid="SNG 1:7">Nii miye huzungule</para>
  <para style="q" vid="SNG 1:7">mwa mafyo ya wadimi watuhu?<verse eid="SNG 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 1:8" />Weye humanyize kugamba kuhombweela kujink'ha wavele wose?</para>
  <para style="q" vid="SNG 1:8">Genda utimile difyo dya vibehela,</para>
  <para style="q" vid="SNG 1:8">ukazunguile mani ye vibehela vako,</para>
  <para style="q" vid="SNG 1:8">hagihigihi ha mahema ya wadimi.<verse eid="SNG 1:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="SNG 1:9" />Weye hukuungisa.</para>
  <para style="q" vid="SNG 1:9">Hikuliganyiza na falasi vele dya Falao ikugendeza gali dya nk'hondo.<verse eid="SNG 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 1:10" />Ziheleni zako zakutenda uhomboele,</para>
  <para style="q" vid="SNG 1:10">singo yako nayo ikanda na mikufu ya yombe.<verse eid="SNG 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 1:11" />Mna nekikudamanyile mikufu ya zahabu.</para>
  <para style="q" vid="SNG 1:11">hamwenga na mahambo ya masawa.<verse eid="SNG 1:11" /></para>
  <para style="s">Mtumizwa</para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 1:12" />Seuta umwo andaga mwe difumbi dyakwe,</para>
  <para style="q" vid="SNG 1:12">mavuta yangu yo mhemp'he yenezaga mhemp'he kila hant'hu.<verse eid="SNG 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 1:13" />Myangu nimuungise kwangu ni enga mhemp'he ukwitangwa manemane,</para>
  <para style="q" vid="SNG 1:13">umwo akanda mgati mwe kifua changu.<verse eid="SNG 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 1:14" />Myangu hukuungisa ni enga kabwali,</para>
  <para style="q" vid="SNG 1:14">kakubwalika mwe nk'honde ze mizabibu uko Engedi.<verse eid="SNG 1:14" /></para>
  <para style="sp">Mgosi</para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 1:15" />Kaula ivo wili mbwanga.</para>
  <para style="q" vid="SNG 1:15">Meso yako ni enga ya suwa.<verse eid="SNG 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 1:16" />Kaula ivo uwagilwe weye hukuungisa,</para>
  <para style="q" vid="SNG 1:16">naho ubwanga wako hiubweda,</para>
  <para style="q" vid="SNG 1:16">lusazi lwetu nalo ni enga mani yekwani.<verse eid="SNG 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="SNG 1:17" />Mikola ye nyumba yetu neinde ya maziti yakwitangwa mielezi.</para>
  <para style="q" vid="SNG 1:17">mp'handa zakwe nezinde za maziti yakwitangwa mibeloshi.<verse eid="SNG 1:17" /></para>
  <chapter eid="SNG 1" />
  <chapter number="2" style="c" sid="SNG 2" />
  <para style="q">
    <verse number="1" style="v" sid="SNG 2:1" />Miye ni bwali dikulawa Shaloini</para>
  <para style="q" vid="SNG 2:1">naho ni enga bwali kulawa kwe dikolongo.<verse eid="SNG 2:1" /></para>
  <para style="sp">Mgosi</para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 2:2" />Enga dikwani mgati mwe miwamba ngoma.</para>
  <para style="q" vid="SNG 2:2">Nivo eli uyo humuungisa mwa watuhu.<verse eid="SNG 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 2:3" />Enga mpela mwe miti ya kwe mbago.</para>
  <para style="q" vid="SNG 2:3">nivo eli uyo humuunga mwa wabwanga,</para>
  <para style="q" vid="SNG 2:3">nna kinyemi hwikala hasi ye kizuli chakwe,</para>
  <para style="q" vid="SNG 2:3">kunda kwako hagihi na miye ni enga kudya tunda dimwiile.<verse eid="SNG 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 2:4" />Aniguhaga mpaka kwe chumba che fugo.</para>
  <para style="q" vid="SNG 2:4">kunilagisa lukunde lutendese enga kilagiso kwangu.<verse eid="SNG 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 2:5" />Niguse kwa zabibu.</para>
  <para style="q" vid="SNG 2:5">unigele ludole kwa ludyo lwa matunda yakwitangwa matofaa,</para>
  <para style="q" vid="SNG 2:5">kwaviya hyaganika kwa kumuungisa.<verse eid="SNG 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 2:6" />Mtwi wangu ugonela nt'hendelo ya kumoso,</para>
  <para style="q" vid="SNG 2:6">na mkono wo kulume nawo wanikumbatila.<verse eid="SNG 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 2:7" />Nawakanya nyuwe wandele wa Yelusalemu,</para>
  <para style="q" vid="SNG 2:7">enga ivo keli kapala hegu mbala,</para>
  <para style="q" vid="SNG 2:7">msekusongeza hegu kwimula lukunde,</para>
  <para style="q" vid="SNG 2:7">mpaka aho lupisi lwakwe lukeza kubula.<verse eid="SNG 2:7" /></para>
  <para style="s">Ukemi wa kaidi</para>
  <para style="sp">Mvele</para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 2:8" />Neva izwi dya miyangu humuungisa,</para>
  <para style="q" vid="SNG 2:8">hiza na nguluko naho haguluka mwo mnima</para>
  <para style="q" vid="SNG 2:8">akazunguluka mwe vigulu.<verse eid="SNG 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 2:9" />Myangu humuungisa ni enga kapala naho enga swala.</para>
  <para style="q" vid="SNG 2:9">kakimala hagihi no lukandula lwetu,</para>
  <para style="q" vid="SNG 2:9">akasungila mwe dilanga,</para>
  <para style="q" vid="SNG 2:9">akaunga kuona kundani.<verse eid="SNG 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 2:10" />Myangu nimuugise anigambaga na kunikemela.</para>
  <para style="sp" vid="SNG 2:10">Mgosi</para>
  <para style="q" vid="SNG 2:10">Inuka elo myangu hukuungisa</para>
  <para style="q" vid="SNG 2:10">So elo kikeitile.<verse eid="SNG 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 2:11" />Kaula lupisi lwa masika lwomboka,</para>
  <para style="q" vid="SNG 2:11">fula nazo zisila.<verse eid="SNG 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="SNG 2:12" />Mabwali yasuka kila hant'hu,</para>
  <para style="q" vid="SNG 2:12">na lupisi lwa kukema lubula,</para>
  <para style="q" vid="SNG 2:12">izwi dyevika mpaka kwe migunda yetu.<verse eid="SNG 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 2:13" />Miti ya mitini ikonga kuiva,</para>
  <para style="q" vid="SNG 2:13">mizabibu nayo isuka,</para>
  <para style="q" vid="SNG 2:13">naho yalava mhemp'he wedi.</para>
  <para style="q" vid="SNG 2:13">Soo elo myangu hukuungisa kijatilane.<verse eid="SNG 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 2:14" />Weye ni enga suwa ikefisile,</para>
  <para style="q" vid="SNG 2:14">mndani mwe zimp'hako zo luwe.</para>
  <para style="q" vid="SNG 2:14">Hake hukaule futa yako, nive diizwi dyako</para>
  <para style="q" vid="SNG 2:14">kwaviya izwi dyako dyedi, futa yako nayo ihomboela.<verse eid="SNG 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 2:15" />Kuna want'hu wamwenga wekale enga vikuli vidodo,</para>
  <para style="q" vid="SNG 2:15">unase kuvileka vinikump'hukile.<verse eid="SNG 2:15" /></para>
  <para style="sp">Mvele</para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 2:16" />Uyo myangu humuunga ni ywangu miye name ni ywakwe.</para>
  <para style="q" vid="SNG 2:16">Yehe adima ngoto zakwe mwa mani yadegede.<verse eid="SNG 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="SNG 2:17" />Mpaka aho zuwa dikant'hont'homoka</para>
  <para style="q" vid="SNG 2:17">na vizuli vikahauka.</para>
  <para style="q" vid="SNG 2:17">Uya kwangu weye hukuungisa.</para>
  <para style="q" vid="SNG 2:17">unde enga kapala naho enga swala mnanga mwo mnima wa Beteli.<verse eid="SNG 2:17" /></para>
  <chapter eid="SNG 2" />
  <chapter number="3" style="c" sid="SNG 3" />
  <para style="q">
    <verse number="1" style="v" sid="SNG 3:1" />Umwo nagonile mwo lusazi lwangu</para>
  <para style="q" vid="SNG 3:1">Nehilota hamzungula myangu humuungisa mwo moyo wangu.</para>
  <para style="q" vid="SNG 3:1">Namzungulaga mna himpatile.<verse eid="SNG 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 3:2" />Nenukaga hazunguluka mwo mzi,</para>
  <para style="q" vid="SNG 3:2">mwe sila na hata mwe sila mp'handa.</para>
  <para style="q" vid="SNG 3:2">Hamzungula yudya humuungisa.</para>
  <para style="q" vid="SNG 3:2">Namzungulaga mna himpatile.<verse eid="SNG 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 3:3" />Wamizi awo wakazunguluka mwo mzi wanionaga.</para>
  <para style="q" vid="SNG 3:3">Umwo wakazunguluka mwo mzi nawauzaga.</para>
  <para style="q" vid="SNG 3:3">“Togoleni mmuona myangu humuungisa?”<verse eid="SNG 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 3:4" />Ivo nize najike kulagana nawo namuonaga uyo humuunga.</para>
  <para style="q" vid="SNG 3:4">Namtozaga naho himlekile ahalawe.</para>
  <para style="q" vid="SNG 3:4">Mpaka aho namwigalaga kaya kwa mnala.<verse eid="SNG 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 3:5" />Nawakanya nyuwe wavele wa Yelusalemu.</para>
  <para style="q" vid="SNG 3:5">Enga ivo ili mbala na nt'hohe msekumunk'hilwa na uhabwasi,</para>
  <para style="q" vid="SNG 3:5">mpaka aho lupisi lukeza kubula<verse eid="SNG 3:5" /></para>
  <para style="s">Ukemi wa katatu</para>
  <para style="sp">Wavele</para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 3:6" />Ni kint'hu chani kikulawa kwe dijangwa enga mnala wo mosi,</para>
  <para style="q" vid="SNG 3:6">kina mhemp'he wedi wo ubani na manemane,</para>
  <para style="q" vid="SNG 3:6">na mavumba ayo yakutagwa ni wachuuzi?<verse eid="SNG 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 3:7" />Kaula Selemani kenulwa mwe difumbi dyakwe dyo useuta,</para>
  <para style="q" vid="SNG 3:7">akazungulukwa ni wamizi milongo mtandatu,</para>
  <para style="q" vid="SNG 3:7">na watowani wadahi wa Izilaeli.<verse eid="SNG 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 3:8" />Wose ni wadahi wa kutowana na sime.</para>
  <para style="q" vid="SNG 3:8">kila yumwenga ywawe ni mdahi wa nk'hondo.</para>
  <para style="q" vid="SNG 3:8">naho kila yumwenga ana sime,</para>
  <para style="q" vid="SNG 3:8">mwo kukeika lumwe umwo wanakump'hukilwa nekilo.<verse eid="SNG 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 3:9" />Seuta Selemani enulagwa mwe difumbi dyo useuta,</para>
  <para style="q" vid="SNG 3:9">difumbi didamanywe kwa mbao zedi kulawa Lebanoni.<verse eid="SNG 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 3:10" />Mikimailo yakwe yagubikagwa na masawa,</para>
  <para style="q" vid="SNG 3:10">mp'hapi zakwe zihambwa kwa zahabu,</para>
  <para style="q" vid="SNG 3:10">hant'hu ha kwikaila hagubikagwa kwa kitambala cha zambalau,</para>
  <para style="q" vid="SNG 3:10">wasumaga vedi kwa kiwalo cha lukunde na wavele wa Yelusalemu.<verse eid="SNG 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 3:11" />Soni elo nyuwe wavele wa Sihoni mumkaule seuta Selemani,</para>
  <para style="q" vid="SNG 3:11">kavalwa taji iyo nine aikaga mwo mtwi wakwe</para>
  <para style="q" vid="SNG 3:11">mwe dizuwa idyo alombaga,</para>
  <para style="q" vid="SNG 3:11">idyo moyo wakwe wandaga na kinyemi.<verse eid="SNG 3:11" /></para>
  <chapter eid="SNG 3" />
  <chapter number="4" style="c" sid="SNG 4" />
  <para style="sp">Mgosi</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 4:1" />Ikindedi myangu hukuungisa kuhobweela!</para>
  <para style="q" vid="SNG 4:1">Naho meso yako yedi yagubikwe ne dishela,</para>
  <para style="q" vid="SNG 4:1">fili zako ni enga fyo dya mbuzi zikupilikapilika,</para>
  <para style="q" vid="SNG 4:1">mbuzi zikuseela mwo mnima wa Gileadi.<verse eid="SNG 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 4:2" />Meno yako yang'alisa enga fyo dya myate ya ngoto,</para>
  <para style="q" vid="SNG 4:2">zikant'higwe mazoya haluse ivi,</para>
  <para style="q" vid="SNG 4:2">zikulawa kwo kogela.</para>
  <para style="q" vid="SNG 4:2">kila imwenga ikanda na mapasa</para>
  <para style="q" vid="SNG 4:2">hauhali mwate wa ngoto hata umwenga hewiina mwana.<verse eid="SNG 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 4:3" />Milomo yako ni enga luzi lwink'hundu.</para>
  <para style="q" vid="SNG 4:3">Naho mnomo wako uwagiliswa,</para>
  <para style="q" vid="SNG 4:3">funda zako nazo zigubikwe nu ushungi wako,</para>
  <para style="q" vid="SNG 4:3">ni enga komamanga dituligwe hagati.<verse eid="SNG 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 4:4" />Singo yako ni enga mnala wa Daudi</para>
  <para style="q" vid="SNG 4:4">uwo uzengigwe vedi kwajili ya kuikila vitoanilo.</para>
  <para style="q" vid="SNG 4:4">Mwo mnala zitungikwe ngula alufu imwenga, zose zikanda za watowani wadahi.<verse eid="SNG 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 4:5" />Matombo yako ni enga wana swala waidi mapasa,</para>
  <para style="q" vid="SNG 4:5">izo zikudya hana mani yadegede.<verse eid="SNG 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 4:6" />Nenikale mwo mnima kukulawa mavuta ya mhemp'he,</para>
  <para style="q" vid="SNG 4:6">mwe kagulu kana ubani,</para>
  <para style="q" vid="SNG 4:6">kubula aho kukatandazuka,</para>
  <para style="q" vid="SNG 4:6">ne diziza nadyo dikahalawa.<verse eid="SNG 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 4:7" />Weye myangu hukuungisa kutendesa kuhombweela.</para>
  <para style="q" vid="SNG 4:7">Naho miye hikuona lema dyodyose.<verse eid="SNG 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 4:8" />Mtumizwa ywangu soo, kihalawe Lebanoni,</para>
  <para style="q" vid="SNG 4:8">kiileke hale Lebanoni,.</para>
  <para style="q" vid="SNG 4:8">Seela kulawa kwo lunenengwa lwo mnima wa Amana,</para>
  <para style="q" vid="SNG 4:8">kulawa kwe milima ya Senili na Helimoni,</para>
  <para style="q" vid="SNG 4:8">kulawa mwe zimp'hanga uko zikwikala simba na suwi.<verse eid="SNG 4:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 4:9" />Weye mtumizwa ywangu kuubwedeza umoyo wangu,</para>
  <para style="q" vid="SNG 4:9">kwa kunikaula lumwenga du,</para>
  <para style="q" vid="SNG 4:9">na kwa usalu wako uwo wa mwe singo.<verse eid="SNG 4:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 4:10" />Weye mtumizwa ywangu, lukunde lwako hiluonesa mwiile,</para>
  <para style="q" vid="SNG 4:10">kwaviya lukunde lwako luna mwiile kujink'ha divai,</para>
  <para style="q" vid="SNG 4:10">mhemp'he wako nawo wevika kujink'ha vilungo vovose.<verse eid="SNG 4:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 4:11" />Milomo yako yadondomosa uki.</para>
  <para style="q" vid="SNG 4:11">Lulimi lwako enga lugeligwa uki na mele,</para>
  <para style="q" vid="SNG 4:11">mhemp'he wedi we zisuke zako nawo ni enga miti ya Lebanoni.<verse eid="SNG 4:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="SNG 4:12" />Weye mtumizwa ywangu hukuungisa ni enga kiunga kizungulusilwe mnulu.</para>
  <para style="q" vid="SNG 4:12">weye ni enga n'choko ya mazi igubikwe na ngubiko,<verse eid="SNG 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 4:13" />Weye ni enga kiunga cha makomamanga</para>
  <para style="q" vid="SNG 4:13">kina matunda yedi kujink'ha yose,</para>
  <para style="q" vid="SNG 4:13">hamwenga na miti ya hina na nalido,<verse eid="SNG 4:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 4:14" />na nado na zafalani na sombasomba na mdalasini</para>
  <para style="q" vid="SNG 4:14">hegu mavumba ye hengi.</para>
  <para style="q" vid="SNG 4:14">Manemane na udi, vakula uumwo,</para>
  <para style="q" vid="SNG 4:14">ikanda ni hamwenga ne miti mituhu ina mhemp'he.<verse eid="SNG 4:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 4:15" />Weye ywi n'choko ya kiunga,</para>
  <para style="q" vid="SNG 4:15">sima dya mazi yo ugima,</para>
  <para style="q" vid="SNG 4:15">vizuto vikuseela kulawa mwo mnima wa Lebanoni.<verse eid="SNG 4:15" /></para>
  <para style="sp">Mvele</para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 4:16" />Soo weye mp'heho kulawa kwa mweye mzi, wize nawe mp'heho kulawa kwa mkoma mahanya,</para>
  <para style="q" vid="SNG 4:16">mvumile mwe kiunga changu,</para>
  <para style="q" vid="SNG 4:16">mhemp'he wakwe wenele mwe kiunga,</para>
  <para style="q" vid="SNG 4:16">yudya humuungisa engile mwe kiunga chakwe,</para>
  <para style="q" vid="SNG 4:16">akadye matunda yemwiile yemwe kiunga.<verse eid="SNG 4:16" /></para>
  <chapter eid="SNG 4" />
  <chapter number="5" style="c" sid="SNG 5" />
  <para style="sp">Mgosi</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 5:1" />Nengila mwe kiunga changu,</para>
  <para style="q" vid="SNG 5:1">mkazangu humuungisa,</para>
  <para style="q" vid="SNG 5:1">naduganya manemane na vilungo vina mhemp'he,</para>
  <para style="q" vid="SNG 5:1">nadya kivuna changu cha uki,</para>
  <para style="q" vid="SNG 5:1">nanywa divai yangu na mele.</para>
  <para style="q" vid="SNG 5:1">Wambuya zangu</para>
  <para style="q" vid="SNG 5:1">wambuya zangu iteni mkadye no kunywa</para>
  <para style="q" vid="SNG 5:1">Naho mnywelese nyuwe wambuya zangu.<verse eid="SNG 5:1" /></para>
  <para style="s">Ukemi wa kane</para>
  <para style="sp">Mvele</para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 5:2" />Nagonaga mna moyo wangu wandaga meso,</para>
  <para style="q" vid="SNG 5:2">tegeleza! Miyangu humuungisa aunga nimkomoele,</para>
  <para style="q" vid="SNG 5:2">nikomoele mkazangu hukuungisa.</para>
  <para style="q" vid="SNG 5:2">Suwa yangu heiina lema,</para>
  <para style="q" vid="SNG 5:2">kwaviya mtwi wangu ujabala na mnyuzu,</para>
  <para style="q" vid="SNG 5:2">fili zangu nazo ni mnyuzu ya nekilo.<verse eid="SNG 5:2" /></para>
  <para style="sp">Mvele</para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 5:3" />Hihambula kale mavalo yangu</para>
  <para style="q" vid="SNG 5:3">neniyavale vivihi naho?</para>
  <para style="q" vid="SNG 5:3">Hihaka kale mazi viga vangu,</para>
  <para style="q" vid="SNG 5:3">nii naho nivigele usavu?<verse eid="SNG 5:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="SNG 5:4" />Aho niyo myangu humuungisa atoza ulwivi,</para>
  <para style="q" vid="SNG 5:4">moyo wangu nawo niyo wanda na kinyemi.<verse eid="SNG 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 5:5" />Nenukaga na kumkomoela ulwivi myangu nimuungise.</para>
  <para style="q" vid="SNG 5:5">Mikono yangu imema mavuta ya mhemp'he,</para>
  <para style="q" vid="SNG 5:5">vidole vangu navo vadondomosaga mavuta ya mhemp'he,</para>
  <para style="q" vid="SNG 5:5">umwo naditozaga didanga hakomola ulwivi.<verse eid="SNG 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 5:6" />Namkomoelaga ulwivi myangu nimuungise,</para>
  <para style="q" vid="SNG 5:6">mna andaga kaita kale,</para>
  <para style="q" vid="SNG 5:6">moyo wangu wandaga na kinyulu umwo ahalawaga,</para>
  <para style="q" vid="SNG 5:6">namzungulaga mna himpatile,</para>
  <para style="q" vid="SNG 5:6">himwitanga mna hanitike.<verse eid="SNG 5:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="SNG 5:7" />Wamizi wo mzi wanionaga,</para>
  <para style="q" vid="SNG 5:7">umwo wakazunguluka mwo mzi,</para>
  <para style="q" vid="SNG 5:7">wanitoaga na kunilumiza,</para>
  <para style="q" vid="SNG 5:7">na kunihoka divalo dyangu.<verse eid="SNG 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 5:8" />Nawakanya nyuwe wavele wa Yelusalemu</para>
  <para style="q" vid="SNG 5:8">mkamuona uyo humuungisa,</para>
  <para style="q" vid="SNG 5:8">mgambeni nahuma kwajili ya lukunde lwakwe.<verse eid="SNG 5:8" /></para>
  <para style="sp">Wavele</para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 5:9" />Weye uhombweele kujink'ha wavele wose.</para>
  <para style="q" vid="SNG 5:9">Uyo ukumuunga evivihi kujink'ha wagosi wose</para>
  <para style="q" vid="SNG 5:9">vikukutenda ulombeze ivo mwo moyo wako?<verse eid="SNG 5:9" /></para>
  <para style="s">Weyangu</para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 5:10" />Myangu humuungisa hi ubwanga uwo, naho ana ludole.</para>
  <para style="q" vid="SNG 5:10">Mwa wagosi alufu mlongo, yehe ni mdahi ekedu.<verse eid="SNG 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 5:11" />Mtwi wakwe wedi enga wa zahabu yedi,</para>
  <para style="q" vid="SNG 5:11">fili zakwe zikebilingabilinga,</para>
  <para style="q" vid="SNG 5:11">nt'hitu tilili enga kungulu.<verse eid="SNG 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 5:12" />Meso yakwe yalem'huka enga suwamanga ihank'handa ha kazuto,</para>
  <para style="q" vid="SNG 5:12">suwamanga ihakile mele niyo akimala mnk'handa mwa kazuto.<verse eid="SNG 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 5:13" />Funda zakwe ziwagilwa enga kiunga cha vilungo,</para>
  <para style="q" vid="SNG 5:13">vikulava mhemp'he,</para>
  <para style="q" vid="SNG 5:13">Milomo yakwe yedi enga zani dikwitangwa yungiyungi,</para>
  <para style="q" vid="SNG 5:13">dikutomosa mavuta ya mhemp'he.<verse eid="SNG 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 5:14" />Mikono yakwe iumbigwa vedi, ni enga nk'home ya zahabu,</para>
  <para style="q" vid="SNG 5:14">ihambigwe kwa madini yakwitangwa klisolito.</para>
  <para style="q" vid="SNG 5:14">Umwili wakwe ni enga hembe dya nt'hembo ditoigwe msasa,</para>
  <para style="q" vid="SNG 5:14">dihambagwe kwa madini yakwitangwa yakuti samawi.<verse eid="SNG 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 5:15" />Viga vakwe ni enga mikimailo ya maiwe yakwitangwa alabasta,</para>
  <para style="q" vid="SNG 5:15">ikimigwe kwe visimiko va zahabu ikukizwe.</para>
  <para style="q" vid="SNG 5:15">kakimala aho enga mnima wa Lebanoni,</para>
  <para style="q" vid="SNG 5:15">ni yedi enga miti ikwitangwa mielezi.<verse eid="SNG 5:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 5:16" />Mbuli nyingi akuzilonga ni zedi vitendese</para>
  <para style="q" vid="SNG 5:16">ikindedi yehe kawagilisa,</para>
  <para style="q" vid="SNG 5:16">uyu humuungisa niye miyangu,</para>
  <para style="q" vid="SNG 5:16">naho uyu niye mbwiyangu,</para>
  <para style="q" vid="SNG 5:16">nyuwe wavele wa Yelusalemu.<verse eid="SNG 5:16" /></para>
  <chapter eid="SNG 5" />
  <chapter number="6" style="c" sid="SNG 6" />
  <para style="sp">Wavele wa Yelusalemu</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 6:1" />Weye mvele uhombweele,</para>
  <para style="q" vid="SNG 6:1">kaitahi uyo ukumuunga?</para>
  <para style="q" vid="SNG 6:1">Kahinga hii uyo ukumuungisa,</para>
  <para style="q" vid="SNG 6:1">vileke kikwambize weye mwo kumzungula?<verse eid="SNG 6:1" /></para>
  <para style="sp">Mvele</para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 6:2" />Uyo humuunga kaita mwe kiunga chakwe</para>
  <para style="q" vid="SNG 6:2">Aho ikudegeda vihandwa,</para>
  <para style="q" vid="SNG 6:2">yehe awadimila ngoto zakwe,</para>
  <para style="q" vid="SNG 6:2">na kuduganya mani yadegede.<verse eid="SNG 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 6:3" />Miye ni ywakwe naye ywangu.</para>
  <para style="q" vid="SNG 6:3">Azidimila zingoto zakwe mwa mani yadegede.<verse eid="SNG 6:3" /></para>
  <para style="s">Wila wa shano</para>
  <para style="sp">Mgosi</para>
  <para style="p">
    <verse number="4" style="v" sid="SNG 6:4" />Weye hukuungisa uywedi enga mzi ukwitangwa Tiliza</para>
  <para style="q" vid="SNG 6:4">kuhombweela enga mzi wa Yelusalemu,</para>
  <para style="q" vid="SNG 6:4">watisa enga fyo dya watowani dinule bendela.<verse eid="SNG 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 6:5" />hake kaula kunk'handa</para>
  <para style="q" vid="SNG 6:5">ukanikaula wanigela kiyangayanga,</para>
  <para style="q" vid="SNG 6:5">fili zako ni enga za fyo dya mbuzi,</para>
  <para style="q" vid="SNG 6:5">zikuseela mwo mnima wa Gileadi.<verse eid="SNG 6:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 6:6" />Meno yako yangala enga ye difyo dya ngoto,</para>
  <para style="q" vid="SNG 6:6">zikulawa kwo kogelezwa,</para>
  <para style="q" vid="SNG 6:6">izo kila imwenga ikanda na mapasa,</para>
  <para style="q" vid="SNG 6:6">naho haihali ikale ikedu.<verse eid="SNG 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 6:7" />Funda zakwe zigubikwe ni valo ni enga mavuta ya mhemp'he</para>
  <para style="q" vid="SNG 6:7">zigubikwe nu ushungi wakwe.<verse eid="SNG 6:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 6:8" />Vadahika weyaho malikia milongo mtandatu na wawele milongo mnane,</para>
  <para style="q" vid="SNG 6:8">hamwenga na wali na mazanga hewekuwazika!<verse eid="SNG 6:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 6:9" />Mna suwamanga yangu ikint'hile ni imwenga du,</para>
  <para style="q" vid="SNG 6:9">naho uyo niye akuuungiswa ni nine,</para>
  <para style="q" vid="SNG 6:9">uyo niye abwedeswe nu umwelesi,</para>
  <para style="q" vid="SNG 6:9">wandele wamkaula niyo wamwink'ha zina niye mvikilwa,</para>
  <para style="q" vid="SNG 6:9">malikia na wawele wamuona,</para>
  <para style="q" vid="SNG 6:9">niyo wamtunya kwa ukemi wakagamba,<verse eid="SNG 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 6:10" />Niani uyu ifuta yakwe enga mgingu?</para>
  <para style="q" vid="SNG 6:10">Ywedi enga mnenge,</para>
  <para style="q" vid="SNG 6:10">ung'azi wakwe nao enga zuwa,</para>
  <para style="q" vid="SNG 6:10">amweka mweka enga nt'hondo mwo ulanga?<verse eid="SNG 6:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 6:11" />Hingila mwe kiunga cha miti ya milozi,</para>
  <para style="q" vid="SNG 6:11">nikaule masukiza ya mwe dikolongo,</para>
  <para style="q" vid="SNG 6:11">na kukaula uneva mizabibu isuka,</para>
  <para style="q" vid="SNG 6:11">mikomamanga nayo uneva yabwalika.<verse eid="SNG 6:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 6:12" />Handa nikei kubunk'hula,</para>
  <para style="q" vid="SNG 6:12">zifanyanyi zangu ziniika mgatigati mwa magali ya nk'hondo</para>
  <para style="q" vid="SNG 6:12">yakugendezwa ni falasi.<verse eid="SNG 6:12" /></para>
  <para style="sp">Wavele wa Yelusalemu</para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 6:13" />Uya weye mvele wa Shulami</para>
  <para style="q" vid="SNG 6:13">vileke kikukaule.</para>
  <para style="q" vid="SNG 6:13">Nii mwaunga mnikaule miye Mshulami,</para>
  <para style="q" vid="SNG 6:13">enga mwaunga mkaule wila wa mahanaimu</para>
  <para style="q" vid="SNG 6:13">mwa mafyo maidi ya watowani?<verse eid="SNG 6:13" /></para>
  <chapter eid="SNG 6" />
  <chapter number="7" style="c" sid="SNG 7" />
  <para style="sp">Mnt'hu</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 7:1" />Lwayo lwako luwagilisa</para>
  <para style="q" vid="SNG 7:1">weye mwana kiseuta,</para>
  <para style="q" vid="SNG 7:1">viga vako mwe ivo uvaile vilatu hiutana uwo,</para>
  <para style="q" vid="SNG 7:1">enga iwe dya yombe kulu disanigwe ni msani mdahi.<verse eid="SNG 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 7:2" />Lukuvu lwako ni enga lwiga,</para>
  <para style="q" vid="SNG 7:2">Holwikuswesa divai ihanganywe,</para>
  <para style="q" vid="SNG 7:2">Zinda zako nazo enga kiumbiko cha ngano,</para>
  <para style="q" vid="SNG 7:2">kizungulusilwe mani yakwitangwa yungiyungi.<verse eid="SNG 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 7:3" />Matombo yako ni enga swala mapasa,</para>
  <para style="q" vid="SNG 7:3">naho ni enga mbala mbili.<verse eid="SNG 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 7:4" />Singo yako ni enga mnala wa mp'hembe ya nt'hembo,</para>
  <para style="q" vid="SNG 7:4">Meso yako ni enga vizuto va mzi Heliboni,</para>
  <para style="q" vid="SNG 7:4">hagihi no lwivi lwa Bet Labi,</para>
  <para style="q" vid="SNG 7:4">mp'hula yako ni enga mnala wa Lebanoni,</para>
  <para style="q" vid="SNG 7:4">uwo ukukaula mwo mzi wa Damesiki. q <verse eid="SNG 7:4" /><verse number="5" style="v" sid="SNG 7:5" />Mtwi wako enga nu mnima wa Kalimeli,</para>
  <para style="q" vid="SNG 7:5">Fili zako zikebilingabilinga enga zambalau,</para>
  <para style="q" vid="SNG 7:5">uwedi wako wadaha kumtaha hata seuta.<verse eid="SNG 7:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="SNG 7:6" />Kaula ivo wili ywedi naho kuhombweela,</para>
  <para style="q" vid="SNG 7:6">kwa lukunde lwako lwedi.<verse eid="SNG 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 7:7" />Weye kuumbigwa vedi enga mti wa mtende,</para>
  <para style="q" vid="SNG 7:7">matombo yako ni enga tambi dya nt'hende.<verse eid="SNG 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 7:8" />Nagambaga nenikwele mwo mtende uwo niyo natoza matambi yakwe,</para>
  <para style="q" vid="SNG 7:8">matombo yako yande enga matambi ya zabibu,</para>
  <para style="q" vid="SNG 7:8">muye wako nawo unde enga mhemp'he wa tunda dikwitangwa matofaa,<verse eid="SNG 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 7:9" />mnomo wako nawo unde enga divai yedi,</para>
  <para style="q" vid="SNG 7:9">yaseela mp'halahole mpaka kwa uyo miyangu humuungisa.</para>
  <para style="q" vid="SNG 7:9">yetika mwo mnomo wakwe na mwa meno yakwe.<verse eid="SNG 7:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 7:10" />Miye ni ywakwe uyo humuungisa,</para>
  <para style="q" vid="SNG 7:10">yehe naye anionela nk'wina.<verse eid="SNG 7:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 7:11" />Soo weye hukuungisa, wize kiite kwo mgunda,</para>
  <para style="q" vid="SNG 7:11">kikaike wikazi, kikekale kwe zikaya.<verse eid="SNG 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 7:12" />Nekisunguze vileke kiite kwe migunda ya mizabibu,</para>
  <para style="q" vid="SNG 7:12">kikakaule uneva ibwalika,</para>
  <para style="q" vid="SNG 7:12">naho uneva mabwali yakwe yakonga kugubuka,</para>
  <para style="q" vid="SNG 7:12">na uneva mikomamanga ikonga kulava mabwali,</para>
  <para style="q" vid="SNG 7:12">uko nuko nohulagise lukunde lwangu.<verse eid="SNG 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 7:13" />Mhemp'he wedi umema,</para>
  <para style="q" vid="SNG 7:13">hagihi no lwivi lwetu yeyaho matunda yedi ye hengi,</para>
  <para style="q" vid="SNG 7:13">yose mahya naho yamwenga ya mazuwa ya kunyuma,</para>
  <para style="q" vid="SNG 7:13">ayo yose hwikile weye miyangu hukuungisa.<verse eid="SNG 7:13" /></para>
  <chapter eid="SNG 7" />
  <chapter number="8" style="c" sid="SNG 8" />
  <para style="p">
    <verse number="1" style="v" sid="SNG 8:1" />Vandile enga mkulu ywangu,</para>
  <para style="q" vid="SNG 8:1">uyo onk'hezwagwa ni mnala,</para>
  <para style="q" vid="SNG 8:1">Ivo hata uneva nadugane na weye kuse,</para>
  <para style="q" vid="SNG 8:1">Nehikukumbatila naho hehali naakafanyanya kugamba hidamanya vihile.<verse eid="SNG 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 8:2" />Hegu nehikulongoza mpaka kwe kaya kwa mnala,</para>
  <para style="q" vid="SNG 8:2">yehe anihinize lukunde</para>
  <para style="q" vid="SNG 8:2">Hegu nehikwink'ha divai yedi,</para>
  <para style="q" vid="SNG 8:2">naho nehikwink'ha divai yangu ya makomamanga.<verse eid="SNG 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 8:3" />Mkono wako wa kumoso wi hasi yo mtwi wangu</para>
  <para style="q" vid="SNG 8:3">na mkono wako wa kulume wanikumbatila.<verse eid="SNG 8:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="SNG 8:4" />Nawakanya nyuwe wavele wa Yelusalemu,</para>
  <para style="q" vid="SNG 8:4">msekwiingila mwo kukeunga, mpaka lupisi lukeza kubula.<verse eid="SNG 8:4" /></para>
  <para style="s">Ukemi wa mtandatu</para>
  <para style="sp">Wavele wa Yelusalemu</para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 8:5" />Niani uyu akulawa kwe nyika</para>
  <para style="q" vid="SNG 8:5">uku akamwigamila uyo akumuunga</para>
  <para style="sp" vid="SNG 8:5">Mvele</para>
  <para style="q" vid="SNG 8:5">Hasi yo mti wa matofaa aho nyokwe akwinulaga ubovu</para>
  <para style="q" vid="SNG 8:5">Hadya nyokwe aonaga usungu</para>
  <para style="q" vid="SNG 8:5">na nyokwe hadya akwingilaga nyumba.<verse eid="SNG 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 8:6" />Nitowe enga kilagiso mwo moyo wako</para>
  <para style="q" vid="SNG 8:6">enga lagiso mwo mkono wako</para>
  <para style="q" vid="SNG 8:6">kwaviya lukunde luna ludole enga file</para>
  <para style="q" vid="SNG 8:6">finju nazo ni enga kikuta</para>
  <para style="q" vid="SNG 8:6">ukoka enga moto ivo ukukweela vitendese.</para>
  <para style="q" vid="SNG 8:6">Wakweela enga lubalula<verse eid="SNG 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 8:7" />Mazi mengi hayakudaha kuuzima lukunde</para>
  <para style="q" vid="SNG 8:7">malawo nayo hayakudaha kuuzima</para>
  <para style="q" vid="SNG 8:7">Enga ivo mnt'hu akageza kugula lukunde</para>
  <para style="q" vid="SNG 8:7">icho naapate ni lubezo du.<verse eid="SNG 8:7" /></para>
  <para style="s">Wandugu wo mvele</para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 8:8" />Kinanae lumbu dyetu mdodo</para>
  <para style="q" vid="SNG 8:8">uyo heenati kukula</para>
  <para style="q" vid="SNG 8:8">Togola kimtendelei lumbu dyetu</para>
  <para style="q" vid="SNG 8:8">umwo anatumizwa?<verse eid="SNG 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 8:9" />Uneva andile lukandula</para>
  <para style="q" vid="SNG 8:9">nekimzengela mnala wa masawa</para>
  <para style="q" vid="SNG 8:9">Hegu uneva andile enga lwivi</para>
  <para style="q" vid="SNG 8:9">nekimwiika kwa mbao za mielezi,<verse eid="SNG 8:9" /></para>
  <para style="sp">Mvele</para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 8:10" />Miye nehinda lukandula</para>
  <para style="q" vid="SNG 8:10">Na matombo yangu ni enga minala yakwe</para>
  <para style="q" vid="SNG 8:10">Mwe meso yakwe nehinda</para>
  <para style="q" vid="SNG 8:10">enga mta kwigala utondowazi.<verse eid="SNG 8:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 8:11" />Selemani andaga na mgunda wa mizabibu</para>
  <para style="q" vid="SNG 8:11">hant'hu hakwitangwa Baal Hamoni</para>
  <para style="q" vid="SNG 8:11">adiink'hizaga kwa walimi</para>
  <para style="q" vid="SNG 8:11">kila yumwenga enk'hizaga matundu alufu imwenga.<verse eid="SNG 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 8:12" />Migunda yangu ye mizabibu ni yangu</para>
  <para style="q" vid="SNG 8:12">uwo mgunda wangu mwenye</para>
  <para style="q" vid="SNG 8:12">Ivo weye Selemani wikale na matundu yako</para>
  <para style="q" vid="SNG 8:12">Na kila mnimi wa matunda ekale na magana maidi yakwe.<verse eid="SNG 8:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 8:13" />Weye wili mwo mgunda</para>
  <para style="q" vid="SNG 8:13">wambwiya zangu weva izwi dyako</para>
  <para style="q" vid="SNG 8:13">Ivo miye name nitegeleze izwi dyakwe<verse eid="SNG 8:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 8:14" />Sunguza kwiza weye hukuungisa</para>
  <para style="q" vid="SNG 8:14">guluka enga dondolo ikukwela mnanga mwo mnima ina miti ikulava mhemp'he.<verse eid="SNG 8:14" /></para>
  <chapter eid="SNG 8" />
</usx>