<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JON" style="id">- Nguu Bible Version</book>
  <para style="h">YONA</para>
  <para style="toc1">Kitabu kiwandikwe ni Yona</para>
  <para style="toc2">Yona</para>
  <para style="toc3">Yon</para>
  <para style="mt2">KITABU KIWANDIKWE NI YONA</para>
  <para style="mt1">YONA</para>
  <para style="imt">ULONGOELO</para>
  <chapter number="1" style="c" sid="JON 1" />
  <para style="s">Yona amnyilika Zumbe</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 1:1" />Zuwa dimwenga Zumbe Mnungu amgambaga Yona, mwana Amitai kugamba, <verse eid="JON 1:1" /><verse number="2" style="v" sid="JON 1:2" />“Inuka wiite Ninawi, mzi udya mkulu ukawakanye kwaviya u wihi wawe utendesa.”<verse eid="JON 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JON 1:3" />Mna Yona akonga kuita nt'hendelo nt'huhu vileke amnyilike Zumbe. Aseelaga mpaka Yafa, niyo aona meli ikwiita Talishishi. Alihaga matundu niyo akwela mwe meli no kutamba nayo kwiita Talashishi vileke amnyilike Zumbe.<verse eid="JON 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 1:4" />Mna Zumbe egalaga nk'hung'unt'ho nk'hulu mwe bahali niyo kwanda na mjubwaniso. Niyo meli yanda hagihi na kubogozoko. <verse eid="JON 1:4" /><verse number="5" style="v" sid="JON 1:5" />Watafi wose mwe meli wogohaga, kila yumwenga amwiile mlungu, niyo waduula mapeto yawe mwe bahali vileke meli ihuhe.</para>
  <para style="p" vid="JON 1:5">Mna Yona engilaga nt'hendelo nt'huhu ya kundani mwe meli, niyo agona nt'hongo fofofo. <verse eid="JON 1:5" /><verse number="6" style="v" sid="JON 1:6" />Mlongoza meli niyo ambasa na kumgamba, “Wagonai? Inuka umlombeze mlungu ywako, hegu naakionele mbazi na kukiyokola ugima wetu.”<verse eid="JON 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JON 1:7" />Want'hu wose mwe meli niyo wagambana, “Haluse kitowe simbi kimanye buli idyi dikipata kwa masa yaani.” Ivo niyo watoa simbi niyo yamgweela Yona.<verse eid="JON 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JON 1:8" />Aho niyo wamgamba. “Haluse, kigambile! Niani akukigaila makunt'ho aya yose? Ndima yako ni iihi? Isi yako niihi? Weye ywi kabila dyani?”<verse eid="JON 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 1:9" />Yona niyo awahitula, “Miye ni Mwibulania, namvika Zumbe, Mnungu Muumbi ywe bahali ne isi.”<verse eid="JON 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 1:10" />Niyo Yona awagamba nehamnyilika Zumbe. Weze weve ivo want'hu wagohesaga, niyo wamgamba “Kudamanya mbuli iihise!”<verse eid="JON 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JON 1:11" />Ibahali yagendeelaga kunda na mjubwaniso mkulu. Ivo want'hu niyo wamuuza Yona, “Kikutende vivihi vileke bahali itondowale?”<verse eid="JON 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JON 1:12" />Yona niyo awahitula, “Niguheni mniduule mwe bahali, ibahali neitondowale kwaviya naona kugamba ni miye chotoko cho mjubwaniso uno.”<verse eid="JON 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JON 1:13" />Walongoza meli hawamduulaga, vituhu vakwe wagezaga kuiyogola imeli ibule mwe isi inyaile, mna wadundugaga kwaviya bahali neindilisa na mjubwaniso kujink'ha hadya nk'hongo. <verse eid="JON 1:13" /><verse number="14" style="v" sid="JON 1:14" />Ivo, niyo wamwiila Zumbe Mnungu wakagamba, “Zumbe Mnungu chakulombeza, usekukikoma kwa kuulava ugima wa mnt'hu uyu, hegu usekulihiza kwa kumkoma mnt'hu heina masa, weye Mnungu udamanye ivo viwagilwe.” <verse eid="JON 1:14" /><verse number="15" style="v" sid="JON 1:15" />Ivo wamguhaga Yona no kumduula kuse ye meli, aaho bahali niyo yatondowala. <verse eid="JON 1:15" /><verse number="16" style="v" sid="JON 1:16" />Mbuli iyo yawatendaga wandima we meli wamogohese Zumbe niyo wamlavila malavo na kumwiikila kilapi.<verse eid="JON 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JON 1:17" />Niyo, Zumbe asigiila samaki nk'hulu immele Yona. Yona andaga mwe zinda ze samaki kwa mazuwa matatu kilo na msi.<verse eid="JON 1:17" /></para>
  <chapter eid="JON 1" />
  <chapter number="2" style="c" sid="JON 2" />
  <para style="s">Yona amlombeza Zumbe Mnungu</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 2:1" />Umwo Yona andaga mndani mwe zinda ze samaki amlombezaga Zumbe Mnungu ywakwe. <verse eid="JON 2:1" /><verse number="2" style="v" sid="JON 2:2" />Akagamba,</para>
  <para style="q" vid="JON 2:2">“Zumbe nakwitangaga kwajili ya makunt'ho yangu,</para>
  <para style="q" vid="JON 2:2">naho niyo waniva</para>
  <para style="q" vid="JON 2:2">kulawa kwo mnyongomela wa wabanike</para>
  <para style="q" vid="JON 2:2">nakuiilaga kuunga wambizi nawe wanivaga.<verse eid="JON 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JON 2:3" />Waniduulaga hasi kundani mwe bahali,</para>
  <para style="q" vid="JON 2:3">ukwo nazungulukwagwa ni mazi mengi,</para>
  <para style="q" vid="JON 2:3">mjubwaniso wako una udahi</para>
  <para style="q" vid="JON 2:3">yombokaga mnanga mwangu.<verse eid="JON 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JON 2:4" />Nafanyanya hiduulwa hale</para>
  <para style="q" vid="JON 2:4">na weye,</para>
  <para style="q" vid="JON 2:4">naho henidahe kuiona naho Nyumba yako ikukile.<verse eid="JON 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JON 2:5" />Mazi nayanizunguluka niyo yanisesela,</para>
  <para style="q" vid="JON 2:5">bahali neinigubika pele</para>
  <para style="q" vid="JON 2:5">niyo amani ye mwe bahali nayazinganizaga umtwi.<verse eid="JON 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JON 2:6" />Nehiseela mpaka hasi kukongela milima,</para>
  <para style="q" vid="JON 2:6">kwe isi ina nk'hili zivugalwe ulo na ulo. Nuko kugamba mwe isi ya want'hu wabanike</para>
  <para style="q" vid="JON 2:6">Mna weye Zumbe Mnungu ywangu</para>
  <para style="q" vid="JON 2:6">nokunikweza handa mgima kulawa kwe dibome.<verse eid="JON 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JON 2:7" />“Muye wangu umwo wandile ukanifosa</para>
  <para style="q" vid="JON 2:7">nehikukumbukila weye Zumbe</para>
  <para style="q" vid="JON 2:7">Niyo wakwiva ukulombeza kwangu</para>
  <para style="q" vid="JON 2:7">ukwo kwe Nyumba yako Ikukile.<verse eid="JON 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JON 2:8" />Want'hu wakuvika milungu,</para>
  <para style="q" vid="JON 2:8">wakepagula hale no uwedi wawe.<verse eid="JON 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JON 2:9" />Mna miye hakema wila wa nt'hogola</para>
  <para style="q" vid="JON 2:9">nohulavile malavo,</para>
  <para style="q" vid="JON 2:9">na kukint'hiza vilapi changu kwako.</para>
  <para style="q" vid="JON 2:9">Mnungu niye akuyokola.”<verse eid="JON 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 2:10" />Ivo Zumbe Mnungu aigambaga idya isamaki ink'hulu imtahike Yona mwe isi inyaile, nayo niyo yamtahika.<verse eid="JON 2:10" /></para>
  <chapter eid="JON 2" />
  <chapter number="3" style="c" sid="JON 3" />
  <para style="s">Yona aita Ninawi</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 3:1" />Zumbe Mnungu alongaga na Yona kaidi naho, <verse eid="JON 3:1" /><verse number="2" style="v" sid="JON 3:2" />niyo amgamba, “Ita Ninawi, udya mzi mkulu, ukawabilikize want'hu ulosi uwo hwink'hile.”<verse eid="JON 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JON 3:3" />Ivo, Yona niyo aita Ninawi enga ivo Zumbe Mnungu amsigiile. Mzi wa Ninawi wandaga ukulisa, ukuguha mazuwa matatu kuubinda. <verse eid="JON 3:3" /><verse number="4" style="v" sid="JON 3:4" />Yona akongaga kwingila mwo mzi wa Ninawi, eze agende lugendo lwa zuwa dimwenga akongaga kubilikiza akagamba. “Yonomboka mazuwa milongo mine Ninawi neibanangwe!”<verse eid="JON 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JON 3:5" />Ivo, want'hu wa Ninawi wauhuwilaga ulosi wa Mnungu, niyo watowa lugong'ondo kila yumwenga, mkulu na mdodo wafunge naho wavale magunia kulagisa kugamba wakweiila.<verse eid="JON 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JON 3:6" />Umwo seuta ywa Ninawi eze eve zimbuli izi, enukaga mwe difumbi dyakwe dye kiseuta, nokuhambula valo dyakwe dye kiseuta, niyo avala gunia no kwikala mwa maivu. <verse eid="JON 3:6" /><verse number="7" style="v" sid="JON 3:7" />Seuta awatowela lugong'ondo wekazi wa Ninawi akagamba. “Miye seuta, hamwenga na wakulu wayangu, nalava sigilizi ino. Hasekunda na mnt'hu yeyose, hegu mfugwa wowose akuunga adye kint'hu chochose. Ni mwiko kudya hegu kunywa. <verse eid="JON 3:7" /><verse number="8" style="v" sid="JON 3:8" />Want'hu wose na makala yose wavale magunia. Kila mnt'hu amlombeze na kumwiila Mnungu kwa kindedi. <verse eid="JON 3:8" /><verse number="9" style="v" sid="JON 3:9" />Mafani Zumbe Mnungu adaha kuhitula fanyanyi zakwe, no kuleka kukiihiya, naswe niyo chahona!”<verse eid="JON 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 3:10" />Mnungu eze aone ivo wadamanye, na ivo waulekaga uwihi wawe, niyo ahitula zifanyanyi zakwe na kuleka kuwatenda enga ivo nakaunga awatende.<verse eid="JON 3:10" /></para>
  <chapter eid="JON 3" />
  <chapter number="4" style="c" sid="JON 4" />
  <para style="s">Yona amuonela maya Zumbe</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 4:1" />Mna mbuli iyo haimwelele Yona hata ludodo, niyo ingilisa maya. <verse eid="JON 4:1" /><verse number="2" style="v" sid="JON 4:2" />Ivo alombezaga akagamba, “Zumbe, togola, izo hiyo mbuli ziya nafanyanye kugamba noudamanye umwo nandile nikei kuhalawa kaya? Nivo valekile hanyilikila Talishishi. Nehimanya kugamba weye ywi Mnungu ywedi na mta mbazi, hukusunguza kwiihiwa naho una lukunde holukusila. Wadaha kuhitula zifanyanyi zako usekusengela. <verse eid="JON 4:2" /><verse number="3" style="v" sid="JON 4:3" />Haluse elo, Mnungu uuse ugima wangu, kwaviya, ni vedi nibanike kujink'ha kunda mgima.”<verse eid="JON 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 4:4" />Mnungu naye niyo amhitula Yona. “Wagamba wadamanya vedi kuihiwa?”<verse eid="JON 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JON 4:5" />Niho Yona ahalawa kuse ulailo wa zuwa wo mzi. Aho niyo akezengela kaheha no kwikala kundani kwa kaheha akagojela kuona idyo nediupate mzi wa Ninawi. <verse eid="JON 4:5" /><verse number="6" style="v" sid="JON 4:6" />Zumbe Mnungu ahotezaga mzabibu niyo wakukula na kumdamanyila mp'heho Yona vileke umhunguile makunt'ho yakwe. Yona niyo nakawelelwa vitendese mzabibu uwo. <verse eid="JON 4:6" /><verse number="7" style="v" sid="JON 4:7" />Mna zuwa dya kaidi, kwize kuche, Mnungu niyo avigamba sondo iubebete mzabibu uwo, niyo wanyala. <verse eid="JON 4:7" /><verse number="8" style="v" sid="JON 4:8" />Zuwa dize dyalike, Mnungu niyo aleta heho dina kizihuye kulawa kwe dijangwa, zuwa niyo dyamoka Yona mwo mtwi niyo anda hagihi na kuzehuka, aonagao ni vedi abanike niyo agamba, “Ni vedi nibanike kujink'ha kunda mgima.”<verse eid="JON 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 4:9" />Mna Mnungu niyo amgamba Yona, “Togola, wafanyanya wadamanya vedi kuihiwa kwajili ya uwo mzabibu?”</para>
  <para style="p" vid="JON 4:9">Yona niyo ahitula, “Heiye, naona maya hata nnabanika!”<verse eid="JON 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 4:10" />Aho Zumbe Mnungu niyo amgamba Yona, “Mzabibu uwo nouhota na kukula kwa kilo kimwenga, kilo kitimile nounyala. Weye huudamanyile kint'hu chochose, naho huuhandile. Nii wauonela mbazi? <verse eid="JON 4:10" /><verse number="11" style="v" sid="JON 4:11" />Togola, hivo vedi kwangu kuonela mbazi mzi wa Ninawi, udya mzi mkulu una wana magana gana na magana milongo miidi hamwenga na makala?”<verse eid="JON 4:11" /></para>
  <chapter eid="JON 4" />
</usx>