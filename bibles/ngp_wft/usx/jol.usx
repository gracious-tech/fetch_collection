<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JOL" style="id">YOL - Ngulu Bible Version</book>
  <para style="h">YOELI</para>
  <para style="toc1">Kitabu kiwandikwe ni Joeli</para>
  <para style="toc2">Joeli</para>
  <para style="toc3">Joe</para>
  <para style="mt2">KITABU KIWANDIKWE NI YOELI</para>
  <para style="mt1">YOELI</para>
  <para style="imt">ULONGOELO</para>
  <chapter number="1" style="c" sid="JOL 1" />
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1" />Uno nuwo Ulosi wa Zumbe Mnungu wamwiziilaga Yoeli mwana Patueli.<verse eid="JOL 1:1" /></para>
  <para style="s">Sige zagwa mwe isi</para>
  <para style="q">
    <verse number="2" style="v" sid="JOL 1:2" />Tegelezeni nyuwe wadala,</para>
  <para style="q" vid="JOL 1:2">tegelezeni nyose mkwikala mwe isi ya Yuda.</para>
  <para style="q" vid="JOL 1:2">Togoleni kwalailaga kint'hu chochose mwe isi enga iki mwo wikazi wenyu</para>
  <para style="q" vid="JOL 1:2">hegu mwo lupisi lwa wakale wenyu?<verse eid="JOL 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOL 1:3" />Wagambileni wana wenyu mbuli ino,</para>
  <para style="q" vid="JOL 1:3">naho wana wenyu wawagambile wana wawe,</para>
  <para style="q" vid="JOL 1:3">wana wawe nawo wawagambile cheleko kikwiza.<verse eid="JOL 1:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="JOL 1:4" />Yasigazwe ni matuluma ya sige</para>
  <para style="q" vid="JOL 1:4">yadigwa ni matuluma ya ngeda</para>
  <para style="q" vid="JOL 1:4">naho yasigazwe ni matuluma ye zingeda</para>
  <para style="q" vid="JOL 1:4">yadigwa ni matuluma ya mp'hasi,</para>
  <para style="q" vid="JOL 1:4">yasigazwe ni matuluma ya mp'hasi</para>
  <para style="q" vid="JOL 1:4">yadigwa ni matuluma ya mahalala.<verse eid="JOL 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOL 1:5" />Nyuwe wakozi leukweni mwuile,</para>
  <para style="q" vid="JOL 1:5">gutileni nyuwe nyose wakozi we divai</para>
  <para style="q" vid="JOL 1:5">kwaviya zabibu zo kudamanyila divai mp'ya zibanangwa.<verse eid="JOL 1:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="JOL 1:6" />Wank'hondo enga fyo dya sige waibananga isi yetu,</para>
  <para style="q" vid="JOL 1:6">wana ludole lukulu naho wabinda wingi</para>
  <para style="q" vid="JOL 1:6">meno yawe enga ya simba</para>
  <para style="q" vid="JOL 1:6">ngeso zawe enga za simba vele.<verse eid="JOL 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOL 1:7" />Wabananga mizabibu yetu,</para>
  <para style="q" vid="JOL 1:7">naho wafunc'ha mitini yetu</para>
  <para style="q" vid="JOL 1:7">wayagomola magome yawe</para>
  <para style="q" vid="JOL 1:7">no kuyaduula hasi</para>
  <para style="q" vid="JOL 1:7">niyo matambi yasigala heyeina kint'hu.<verse eid="JOL 1:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="JOL 1:8" />Nyuwe want'hu ileni enga mwali na mazanga availe gunia,</para>
  <para style="q" vid="JOL 1:8">akuhongeza file ya mgosi amtumize.<verse eid="JOL 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOL 1:9" />Malavo ya nk'hande na ya vokunywa</para>
  <para style="q" vid="JOL 1:9">havihali mwe Nyumba ya Zumbe Mnungu.</para>
  <para style="q" vid="JOL 1:9">Walavant'hambiko wahongeza kwaviya waswesa cho kumlavila Zumbe Mnungu.<verse eid="JOL 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOL 1:10" />Nk'honde zibanika,</para>
  <para style="q" vid="JOL 1:10">sanga inyala</para>
  <para style="q" vid="JOL 1:10">nk'hande zibanangwa</para>
  <para style="q" vid="JOL 1:10">divai imp'ya ibanangwa</para>
  <para style="q" vid="JOL 1:10">mavuta ye mizeituni hayahali.<verse eid="JOL 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOL 1:11" />Mnde ne kinyulu nyuwe walimi,</para>
  <para style="q" vid="JOL 1:11">ileni nyuwe wandima we nk'honde ye mizabibu,</para>
  <para style="q" vid="JOL 1:11">ngano na shaili zibanika</para>
  <para style="q" vid="JOL 1:11">ulozo wose mwe nk'honde ubanangwa.<verse eid="JOL 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOL 1:12" />Mizabibu ne mikuyu inyuluka,</para>
  <para style="q" vid="JOL 1:12">miti yose ya matunda inyuluka niyo yafa.</para>
  <para style="q" vid="JOL 1:12">Kinyemi cha want'hu kihauswa.<verse eid="JOL 1:12" /></para>
  <para style="s">Lugong'ondo lwa kweiila</para>
  <para style="p">
    <verse number="13" style="v" sid="JOL 1:13" />Valeni magunia mhongeze,</para>
  <para style="q" vid="JOL 1:13">ileni nyuwe wandima wa hant'hu hakulavila nt'hambiko</para>
  <para style="q" vid="JOL 1:13">Iteni kwe Nyumba ya Mnungu mkacheleze mkahongeza.</para>
  <para style="q" vid="JOL 1:13">Haihali nk'hande hegu divai ya kumlavila Mnungu ywenyu.<verse eid="JOL 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOL 1:14" />Wagambeni want'hu wafunge.</para>
  <para style="q" vid="JOL 1:14">Itanga mdugano ukukile,</para>
  <para style="q" vid="JOL 1:14">waduganyeni vilongozi</para>
  <para style="q" vid="JOL 1:14">na want'hu wose wa isi ya Yuda</para>
  <para style="q" vid="JOL 1:14">kwe Nyumba ya Zumbe Mnungu ywenyu,</para>
  <para style="q" vid="JOL 1:14">niyo mwa mwiila.<verse eid="JOL 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOL 1:15" />Hangi suwe wenye kwe dizuwa diya!</para>
  <para style="q" vid="JOL 1:15">Kwaviya zuwa dyo usengelo dya Zumbe dihagihi,</para>
  <para style="q" vid="JOL 1:15">nedize enga ubanangi kulawa kwa Mta Udahi wose.<verse eid="JOL 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOL 1:16" />Ulozo wetu ubanangwa</para>
  <para style="q" vid="JOL 1:16">ha meso yetu,</para>
  <para style="q" vid="JOL 1:16">kinyemi na kwanga</para>
  <para style="q" vid="JOL 1:16">mwe nyumba ya Mnungu havihali.<verse eid="JOL 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOL 1:17" />Mbeyu ziola hasi mwe sanga inyaile</para>
  <para style="q" vid="JOL 1:17">nc'hanja nazo hazina kint'hu</para>
  <para style="q" vid="JOL 1:17">gulu dyo kuikila ulozo dibanika</para>
  <para style="q" vid="JOL 1:17">kwaviya hahana ulozo wo kuika.<verse eid="JOL 1:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOL 1:18" />Makala yailisa!</para>
  <para style="q" vid="JOL 1:18">mafyo ya Ng'ombe yangadika,</para>
  <para style="q" vid="JOL 1:18">kwaviya yaswesa nk'hande,</para>
  <para style="q" vid="JOL 1:18">heiye, mafyo ya ngoto nayo yangadika.<verse eid="JOL 1:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOL 1:19" />Naila kwa weye Zumbe Mnungu,</para>
  <para style="q" vid="JOL 1:19">kwaviya ludyo lwe mifugwa ne miti inyala</para>
  <para style="q" vid="JOL 1:19">iivo moto nawo woka miti yose mwe zink'honde.<verse eid="JOL 1:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOL 1:20" />Hata makala mbago yose yakwiila weye,</para>
  <para style="q" vid="JOL 1:20">vizuto va mazi vinyala</para>
  <para style="q" vid="JOL 1:20">kwaviya moto uhiilisa mani yose uko kwe mbago.<verse eid="JOL 1:20" /></para>
  <chapter eid="JOL 1" />
  <chapter number="2" style="c" sid="JOL 2" />
  <para style="s">Makanyo mwe zuwa dya Zumbe</para>
  <para style="q">
    <verse number="1" style="v" sid="JOL 2:1" />Toweni gunda uko Sayuni,</para>
  <para style="q" vid="JOL 2:1">Toweni lukunga mwo mnima wangu ukukile,</para>
  <para style="q" vid="JOL 2:1">Wakaya wose wa mwe isi ya Yuda wazingize,</para>
  <para style="q" vid="JOL 2:1">Kwaviya zuwa dya usengeelo wa Zumbe Mnugu dyeza,</para>
  <para style="q" vid="JOL 2:1">Kwaviya zuwa idyo dihagihi.<verse eid="JOL 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOL 2:2" />Nedinde zuwa dya ziza na kinyulu,</para>
  <para style="q" vid="JOL 2:2">Zuwa dya mavunde na ziza kulu.</para>
  <para style="q" vid="JOL 2:2">Wank'hondo enga fyo kulu dya sige dihagihi,</para>
  <para style="q" vid="JOL 2:2">enga ziza dikugubika milima.</para>
  <para style="q" vid="JOL 2:2">Hainati ilaile hata zuwa dimwenga,</para>
  <para style="q" vid="JOL 2:2">naho heioneke naho</para>
  <para style="q" vid="JOL 2:2">mwe vyeleko vose vikwiza.<verse eid="JOL 2:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="JOL 2:3" />Enga ivo moto ukoka pele.</para>
  <para style="q" vid="JOL 2:3">Fyo idyo nivo dikubananga kila kint'hu kulongole kwakwe.</para>
  <para style="q" vid="JOL 2:3">Na kuleka kunyuma kila kint'hu kikahya,</para>
  <para style="q" vid="JOL 2:3">umo dikanda hadinati komboka isi ni enga kiunga cha Edeni,</para>
  <para style="q" vid="JOL 2:3">mna dinomboka, isi yanda jangwa.</para>
  <para style="q" vid="JOL 2:3">Hahana kikudaha kudinyilika.<verse eid="JOL 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOL 2:4" />Waoneka enga falasi,</para>
  <para style="q" vid="JOL 2:4">waguluka enga falasi za nk'hondo.<verse eid="JOL 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOL 2:5" />Wakapilikapilika kulanga mwo mnima,</para>
  <para style="q" vid="JOL 2:5">walava izwi enga magali yakugendezwa ni falasi,</para>
  <para style="q" vid="JOL 2:5">wavumila enga moto wa mani yanyaile,</para>
  <para style="q" vid="JOL 2:5">wakepanga enga fyo kulu dya watowani wakeikile lumwe kwa nk'hondo.<verse eid="JOL 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOL 2:6" />Fyo idyo dikanda hagihi want'hu wengilwa ni wogofi,</para>
  <para style="q" vid="JOL 2:6">futa zose zihuza kwa kogoha.<verse eid="JOL 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOL 2:7" />Watoana enga watowani,</para>
  <para style="q" vid="JOL 2:7">wakwela mwo lukazi enga watowani.</para>
  <para style="q" vid="JOL 2:7">Wose wakup'huka kwa hamwenga,</para>
  <para style="q" vid="JOL 2:7">hahali hata yumwenga ywawe akuhitula sila.<verse eid="JOL 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOL 2:8" />Hahali yumwenga akumsindika miyawe.</para>
  <para style="q" vid="JOL 2:8">Kila yumwenga atimila sila yakwe.</para>
  <para style="q" vid="JOL 2:8">Womboka hagati ya watowani wanavitowanilo,</para>
  <para style="q" vid="JOL 2:8">naho hahana akudaha kuwakindila.<verse eid="JOL 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOL 2:9" />Waukump'hukila mzi,</para>
  <para style="q" vid="JOL 2:9">wakwela mwo lukazi,</para>
  <para style="q" vid="JOL 2:9">wakwela mwe nyumba</para>
  <para style="q" vid="JOL 2:9">wakehenyeza mwe dilanga enga wabavi.<verse eid="JOL 2:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="JOL 2:10" />Isi yose yazingiza hameso yawe,</para>
  <para style="q" vid="JOL 2:10">mbingu nazo zasingisika,</para>
  <para style="q" vid="JOL 2:10">zuwa no mnenge vigelwa ziza,</para>
  <para style="q" vid="JOL 2:10">nt'hondo zaleka kwalika.<verse eid="JOL 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOL 2:11" />Zumbe awenk'ha sigilizi watoani wakwe kwa izwi kulu,</para>
  <para style="q" vid="JOL 2:11">watoani wakwe wandilisa wengi naho wana udahi,</para>
  <para style="q" vid="JOL 2:11">wakumzumila hawakuwazika.</para>
  <para style="q" vid="JOL 2:11">Kindedi zuwa dya Zumbe kulu naho dyatisa!</para>
  <para style="q" vid="JOL 2:11">Niani akudaha kufinyiliza?<verse eid="JOL 2:11" /></para>
  <para style="s">Lekeni wavu wenyu</para>
  <para style="q">
    <verse number="12" style="v" sid="JOL 2:12" />Mna Zumbe Mnungu agamba,</para>
  <para style="q" vid="JOL 2:12">“Niuiyeni miye kwa mioyo yenyu yose,</para>
  <para style="q" vid="JOL 2:12">fungeni naho muile na kunda na kinyulu.<verse eid="JOL 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOL 2:13" />Msekutatula suke zenyu du kulagisa kugamba mkweiila,</para>
  <para style="q" vid="JOL 2:13">mna kweiileni mwe miyoyo yenyu.”</para>
  <para style="b" vid="JOL 2:13" />
  <para style="q" vid="JOL 2:13">Muwiyeni Zumbe Mnungu ywenyu.</para>
  <para style="q" vid="JOL 2:13">Kwaviya yehe kandilisa ywedi naho ana mbazi,</para>
  <para style="q" vid="JOL 2:13">hiyo mhufu wa maya,</para>
  <para style="q" vid="JOL 2:13">mazuwa yose ana udahi wa kulekela masa na kuleka kusengela. <verse eid="JOL 2:13" /><verse number="14" style="v" sid="JOL 2:14" />Mafani Zumbe Mnugu ywenyu naahituke,</para>
  <para style="q" vid="JOL 2:14">na kuwavikilani kwa ulozo,</para>
  <para style="q" vid="JOL 2:14">nomdahe kumlavila malavo ya nk'hande na vo kunywa. <verse eid="JOL 2:14" /><verse number="15" style="v" sid="JOL 2:15" />Toweni gunda mwo mnima wa Sayuni!</para>
  <para style="q" vid="JOL 2:15">Muwagambe want'hu wafunge,</para>
  <para style="q" vid="JOL 2:15">wadamanye mdugano ukukile.<verse eid="JOL 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOL 2:16" />Waduganyeni want'hu,</para>
  <para style="q" vid="JOL 2:16">muwakukize want'hu awo,</para>
  <para style="q" vid="JOL 2:16">duganyeni wadala vilongozi,</para>
  <para style="q" vid="JOL 2:16">duganyeni wana</para>
  <para style="q" vid="JOL 2:16">hata wana wakonk'ha,</para>
  <para style="q" vid="JOL 2:16">walombi wafose mwe zinyumba zawe.</para>
  <para style="q" vid="JOL 2:16">Hamwenga na mlombigwa.<verse eid="JOL 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOL 2:17" />Walavant'hambiko wakumdamanyila ndima Zumbe hagati ye nk'hili ye Nyumba ya Zumbe na hant'hu ha kulavila nt'hambiko,</para>
  <para style="q" vid="JOL 2:17">waile wakagamba,</para>
  <para style="q" vid="JOL 2:17">“Weye Zumbe, waonele mbazi want'hu wako.</para>
  <para style="q" vid="JOL 2:17">Usekuwaleka want'hu wa si nt'huhu wakibele na kukiseka</para>
  <para style="q" vid="JOL 2:17">wakagamba, ‘Ekuhi Mnungu ywenyu?’ ”<verse eid="JOL 2:17" /></para>
  <para style="s">Zumbe ayokola</para>
  <para style="q">
    <verse number="18" style="v" sid="JOL 2:18" />Aho niho Zumbe naalagise lukunde kwajili ye isi yakwe</para>
  <para style="q" vid="JOL 2:18">na kuwaonela mbazi want'hu wakwe.<verse eid="JOL 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOL 2:19" />Zumbe Mnugu niyo ahitula na kuwagamba want'hu wakwe.</para>
  <para style="q" vid="JOL 2:19">Haluse neniwenk'he ngano na divai na mavuta ya zeituni,</para>
  <para style="q" vid="JOL 2:19">nyuwe mdye mwigute.</para>
  <para style="q" vid="JOL 2:19">Henileke naho nyuwe</para>
  <para style="q" vid="JOL 2:19">mbeligwe ni isi nt'huhu. <verse eid="JOL 2:19" /><verse number="20" style="v" sid="JOL 2:20" />Neniwause wank'hondo awo walaile mkoma mahanya,</para>
  <para style="q" vid="JOL 2:20">neniwatende wanyilike mpaka kwe dijangwa.</para>
  <para style="q" vid="JOL 2:20">Wank'hondo wandile kulongole neniwatende waduulwe mwe bahali ifile,</para>
  <para style="q" vid="JOL 2:20">na wadya wandile kunyuma mwe bahali ya Meditelania.</para>
  <para style="q" vid="JOL 2:20">Vimba vawe nevinunk'he</para>
  <para style="q" vid="JOL 2:20">neni wabanange kwa yadya yose wawatendeleni.<verse eid="JOL 2:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="JOL 2:21" />Nyuwe want'hu wa mwe isi msekogoha,</para>
  <para style="q" vid="JOL 2:21">mna mnde na kinyemi na kwanga,</para>
  <para style="q" vid="JOL 2:21">kwaviya Zumbe kadamanya mbuli nk'hulu.<verse eid="JOL 2:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOL 2:22" />Nyuwe makala msekogoha,</para>
  <para style="q" vid="JOL 2:22">kwaviya mani ya kwembago yanda yekwani,</para>
  <para style="q" vid="JOL 2:22">miti nayo yeleka matunda yedi,</para>
  <para style="q" vid="JOL 2:22">mizabibu na mikuyu yelekesa.<verse eid="JOL 2:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOL 2:23" />Nyuwe want'hu wa Sayuni indeni na kinyemi.</para>
  <para style="q" vid="JOL 2:23">Mnde na kinyemi kwajili ya Zumbe Mnungu ywenyu,</para>
  <para style="q" vid="JOL 2:23">kwaviya yehe kawenk'hani fula mkuziunga.</para>
  <para style="q" vid="JOL 2:23">Fula za vuli zink'hintile kwa lupisi lwakwe na masika yank'hintile kwa lupisi na mnwati kwa lupisi lwakwe enga ivo zandaga nk'hongo.<verse eid="JOL 2:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOL 2:24" />Hant'hu ho kuhetela ingano nahameme ngano,</para>
  <para style="q" vid="JOL 2:24">vint'hu vo kukingila nevimeme divai na mavuta ya zeituni.<verse eid="JOL 2:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOL 2:25" />Name neniwavuzileni idya miyaka idigwe ni sige,</para>
  <para style="q" vid="JOL 2:25">na kila kint'hu kidigwe ni ngeda na halala.</para>
  <para style="q" vid="JOL 2:25">Ni miye naditumile kwenyu idyo difyo dikulu.<verse eid="JOL 2:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOL 2:26" />Nomdye nk'hande niyo mwasigaza.</para>
  <para style="q" vid="JOL 2:26">Nomditogole zina dya Zumbe Mnungu ywenyu,</para>
  <para style="q" vid="JOL 2:26">uyo atendile mbuli za kwehela.</para>
  <para style="q" vid="JOL 2:26">Naho want'hu wangu hawabeligwe mbwitu.<verse eid="JOL 2:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOL 2:27" />Nyuwe Waizilaeli,</para>
  <para style="q" vid="JOL 2:27">nommanye kugamba miye ni hamwenga na nyuwe,</para>
  <para style="q" vid="JOL 2:27">na kugamba miye ni Zumbe Mnungu ywenu.</para>
  <para style="q" vid="JOL 2:27">Hahana mtuhu enga weye.</para>
  <para style="q" vid="JOL 2:27">Want'hu wangu hawabeligwe mbwitu.<verse eid="JOL 2:27" /></para>
  <para style="s">Zuwa dya Zumbe</para>
  <para style="q">
    <verse number="28" style="v" sid="JOL 2:28" />Naho akajika nenigele Muye ywangu mwa want'hu wose.</para>
  <para style="q" vid="JOL 2:28">Wana wa kilume na we kike nawalonge ulosi wa Mnungu,</para>
  <para style="q" vid="JOL 2:28">wadala wenyu nawalote sozi zikulawa kwa Mnungu,</para>
  <para style="q" vid="JOL 2:28">wabwanga wenyu nawo nawaone maona.<verse eid="JOL 2:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOL 2:29" />Naho mwo lupisi ludya nenigele Muye ywangu,</para>
  <para style="q" vid="JOL 2:29">hata mwa watumwa wagosi kwa wavele. <verse eid="JOL 2:29" /><verse number="30" style="v" sid="JOL 2:30" />“Name nenilagise vilagiso va kweehela,</para>
  <para style="q" vid="JOL 2:30">mwe mbingu na mwe isi,</para>
  <para style="q" vid="JOL 2:30">sakame na moto na mavunde ya mosi.<verse eid="JOL 2:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JOL 2:31" />Zuwa nedihitulwe kunda ziza,</para>
  <para style="q" vid="JOL 2:31">mnenge nounde wink'hundu enga sakame,</para>
  <para style="q" vid="JOL 2:31">umwo zuwa dikulu dya Zumbe dikutisa dikei kwiza.<verse eid="JOL 2:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="JOL 2:32" />Mna</para>
  <para style="q" vid="JOL 2:32">mnt'hu yeyose akuunga alombeze kwa zina dya Zumbe nayokolwe,</para>
  <para style="q" vid="JOL 2:32">enga ivo Zumbe Mnungu alongile.</para>
  <para style="q" vid="JOL 2:32">‘Wamwenga mwo mzi wa Yelusalemu, nawanyilike</para>
  <para style="q" vid="JOL 2:32">awo wadya miye Mnungu niwasagule.’ ”<verse eid="JOL 2:32" /></para>
  <chapter eid="JOL 2" />
  <chapter number="3" style="c" sid="JOL 3" />
  <para style="s">Mnungu naasengele want'hu wa si</para>
  <para style="q">
    <verse number="1" style="v" sid="JOL 3:1" />Zumbe Mnungu agamba,</para>
  <para style="q" vid="JOL 3:1">“Mwe mazuwa yakwiza no lupisi lukwiza,</para>
  <para style="q" vid="JOL 3:1">neniwambize want'hu wa Yuda na Yelusalemu wekale vedi.<verse eid="JOL 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOL 3:2" />Neniziduganye si zose,</para>
  <para style="q" vid="JOL 3:2">nenizigale kwe dikolongo dikwitangwa Mnungu asengeela.</para>
  <para style="q" vid="JOL 3:2">Uko neniwasengele want'hu</para>
  <para style="q" vid="JOL 3:2">kwa yadya ziwatendele want'hu wangu Izilaeli,</para>
  <para style="q" vid="JOL 3:2">kwaviya wawasambaza want'hu wangu mwe zi isi nt'huhu,</para>
  <para style="q" vid="JOL 3:2">niyo waipanga isi yangu.<verse eid="JOL 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOL 3:3" />Wawatoelaga simbi want'hu wangu wakaule akuunga apate watumwa,</para>
  <para style="q" vid="JOL 3:3">na kuwataga wabwanga vileke wapate mapamp'he,</para>
  <para style="q" vid="JOL 3:3">naho wawataga wandele</para>
  <para style="q" vid="JOL 3:3">vileke walihile divai.<verse eid="JOL 3:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="JOL 3:4" />“Nyuwe nanywe mwaungaga mnitendelei, want'hu wa Tilo na Sidoni na si zose za Filisti? Haluse nomnilihize kikoda? Uneva nomnilihize kikoda, miye neniwalihizeni kikoda aaho! <verse eid="JOL 3:4" /><verse number="5" style="v" sid="JOL 3:5" />Mguha matundu yangu na zahabu yangu naho mguha vint'hu vangu vedi ivo huunga na kuvigala mwe zinyumba zenyu zo kuvikila.” <verse eid="JOL 3:5" /><verse number="6" style="v" sid="JOL 3:6" />Want'hu wa Yuda na want'hu wa Yelusalemu muwataga kwa Wagiliki vileke mpate kuwasamiza hale na isi yawe. <verse eid="JOL 3:6" /><verse number="7" style="v" sid="JOL 3:7" />Haluse neniwavuze want'hu wangu kulawa uko muwatagile name neniwalihize kikoda kwa iki mdamanye. <verse eid="JOL 3:7" /><verse number="8" style="v" sid="JOL 3:8" />Neniwatende wana wenyu wabwanga na wandele na kuwataga kwa want'hu wa Yuda nawo nawawatagile want'hu wa Sheba, isi ya hale. Miye Zumbe Mnungu hilonga. <verse eid="JOL 3:8" /><verse number="9" style="v" sid="JOL 3:9" />“Wagambileni want'hu wa si nt'huhu mbuli ino,</para>
  <para style="q" vid="JOL 3:9">‘mkeike lumwe kwajili ya nk'hondo,</para>
  <para style="q" vid="JOL 3:9">wetangeni watowani wenyu,</para>
  <para style="q" vid="JOL 3:9">watowani wose wakeduganye,</para>
  <para style="q" vid="JOL 3:9">waite kulongole.<verse eid="JOL 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOL 3:10" />Saneni magembe yenyu yande mabamba,</para>
  <para style="q" vid="JOL 3:10">hengo zenyu zinde mikuki.</para>
  <para style="q" vid="JOL 3:10">Hata wasokezi wagambe.</para>
  <para style="q" vid="JOL 3:10">Hata suwe ni watowani.<verse eid="JOL 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOL 3:11" />Tenda nguzu mwize nyuwe si zose we nt'hendelo zose,</para>
  <para style="q" vid="JOL 3:11">mkeike hamwenga mwe dikolongo.’ ”</para>
  <para style="q" vid="JOL 3:11">Weye Zumbe uwaseleze watoani wako wose wawatoe.<verse eid="JOL 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOL 3:12" />“Si zikeike lumwe,</para>
  <para style="q" vid="JOL 3:12">yeze mwe dikolongo dikwitangwa</para>
  <para style="q" vid="JOL 3:12">Zumbe Mnungu Akusengela,</para>
  <para style="q" vid="JOL 3:12">kwaviya uko miye Mnungu,</para>
  <para style="q" vid="JOL 3:12">nenikale kusengela isi zose zihagihi. <verse eid="JOL 3:12" /><verse number="13" style="v" sid="JOL 3:13" />Haluse guheni hengo kwajili yo kuvuna,</para>
  <para style="q" vid="JOL 3:13">kwaviya haluse uvuni ubula,</para>
  <para style="q" vid="JOL 3:13">wajatangizeni enga zabibu,</para>
  <para style="q" vid="JOL 3:13">izo zimemile divai. q Uwihi wawe utendesa,</para>
  <para style="q" vid="JOL 3:13">enga mabiga yamemese.”<verse eid="JOL 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOL 3:14" />Wanda wengi mafyo makulu kwa mafyo makulu,</para>
  <para style="q" vid="JOL 3:14">mwe dikolongo dya Kusengela,</para>
  <para style="q" vid="JOL 3:14">kwaviya zuwa dyo usengelo dya Zumbe dihagihi.<verse eid="JOL 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOL 3:15" />Zuwa na mnenge zigelwa ziza,</para>
  <para style="q" vid="JOL 3:15">nt'hondo nazo nezileka kunda no ung'azi.<verse eid="JOL 3:15" /></para>
  <para style="s">Mnungu awavikila want'hu wakwe</para>
  <para style="q">
    <verse number="16" style="v" sid="JOL 3:16" />Zumbe naabume kulawa Sayuni</para>
  <para style="q" vid="JOL 3:16">naho naalave izwi kulawa Yelusalemu</para>
  <para style="q" vid="JOL 3:16">mbingu na isi nevizingize</para>
  <para style="q" vid="JOL 3:16">Mna Zumbe naande unyilikilo wa want'hu wakwe</para>
  <para style="q" vid="JOL 3:16">gomela ditogile dya want'hu Izilaeli.<verse eid="JOL 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOL 3:17" />Aho niho want'hu wa Izilaeli nommanye kugamba, Zumbe Mnungu ywenyu</para>
  <para style="q" vid="JOL 3:17">ekala Sayuni, mnima ukukile</para>
  <para style="q" vid="JOL 3:17">Yelusalemu neinde ukuka</para>
  <para style="q" vid="JOL 3:17">wageni hawautahe naho.<verse eid="JOL 3:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="JOL 3:18" />Naho mwe dizuwa idyo milima neigubikwe ni mizabibu</para>
  <para style="q" vid="JOL 3:18">naho nokundilise na ng'ombe zina mele.</para>
  <para style="q" vid="JOL 3:18">nokunde na mazi mengi mwe mito ya Yuda.</para>
  <para style="q" vid="JOL 3:18">Mazi mengi nayalawe mwe Nyumba ya Zumbe,</para>
  <para style="q" vid="JOL 3:18">nayomele dikolongo dya Shitimu.<verse eid="JOL 3:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="JOL 3:19" />“Misili neinde heiina kint'hu</para>
  <para style="q" vid="JOL 3:19">Edomu nayo neitende jangwa</para>
  <para style="q" vid="JOL 3:19">kwaviya nawawakump'hukila want'hu wa Yuda</para>
  <para style="q" vid="JOL 3:19">naho nawawakoma want'hu heweina masa mwe isi yawe.<verse eid="JOL 3:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOL 3:20" />Yuda naikalwe ni want'hu ulo na ulo</para>
  <para style="q" vid="JOL 3:20">Yelusalemu neinde uuko vyeleoko vose.<verse eid="JOL 3:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOL 3:21" />Neni walekele want'hu wangu wa Yuda masa yawe ayo nandaga hinati kuwalekela.</para>
  <para style="q" vid="JOL 3:21">Miye Zumbe nenitende wikazi wangu hamwenga na want'hu wangu.”<verse eid="JOL 3:21" /></para>
  <chapter eid="JOL 3" />
</usx>