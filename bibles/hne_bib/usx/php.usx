<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHP" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  
  <para style="h">फिलिप्पी</para>
  <para style="toc1">फिलिप्पी के कलीसिया ला पौलुस के चिट्ठी</para>
  <para style="toc2">फिलिप्पी</para>
  <para style="toc3">फिलि</para>
  <para style="mt1">फिलिप्पी</para>
  <para style="mt2">के कलीसिया ला पौलुस के चिट्ठी</para>
  <chapter number="1" style="c" sid="PHP 1" />
  <para style="po">
    <verse number="1" style="v" sid="PHP 1:1" />मसीह यीसू म फिलिप्पी सहर के जम्मो संत, कलीसिया के अगुवा अऊ डीकनमन ला,</para>
  <para style="po" vid="PHP 1:1">मसीह यीसू के सेवक पौलुस अऊ तीमुथियुस कोति ले ये चिट्ठी मिलय।<verse eid="PHP 1:1" /></para>
  <para style="po">
    <verse number="2" style="v" sid="PHP 1:2" />हमर ददा परमेसर अऊ परभू यीसू मसीह ले तुमन ला अनुग्रह अऊ सांति मिलय।<verse eid="PHP 1:2" /></para>
  <para style="s1">धनबाद अऊ पराथना</para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3" />जब भी मेंह तुमन ला सुरता करथंव, मेंह अपन परमेसर ला धनबाद देथंव। <verse eid="PHP 1:3" /><verse number="4" style="v" sid="PHP 1:4" />मेंह हमेसा अपन जम्मो पराथना म तुमन जम्मो झन बर आनंद के संग पराथना करथंव। <verse eid="PHP 1:4" /><verse number="5" style="v" sid="PHP 1:5" />काबरकि सुरू ले लेके अब तक तुमन सुघर संदेस के परचार म सहभागी रहे हवव। <verse eid="PHP 1:5" /><verse number="6" style="v" sid="PHP 1:6" />अऊ मोला ये बात के भरोसा हवय कि जऊन ह तुमन म ये बने काम सुरू करे हवय, ओह येला मसीह यीसू के आय के दिन तक पूरा करही।<verse eid="PHP 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PHP 1:7" />येह मोर बर उचित ए कि मेंह तुमन जम्मो झन के बारे म ये किसम ले सोचंव, काबरकि तुमन मोर हिरदय म बसे हवव; अऊ चाहे मेंह जेल म रहंव या सुघर संदेस के बचाव अऊ सुघर संदेस ला मजबूत करे म रहंव, तुमन जम्मो झन मोर संग परमेसर के अनुग्रह म भागीदार हवव। <verse eid="PHP 1:7" /><verse number="8" style="v" sid="PHP 1:8" />परमेसर ह मोर गवाह ए कि कइसने मेंह मसीह यीसू के मया के संग, तुमन जम्मो झन ला चाहथंव।<verse eid="PHP 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PHP 1:9" />मोर ये पराथना अय कि तुम्हर मया ह गियान अऊ समझ के संग अऊ बढ़त जावय, <verse eid="PHP 1:9" /><verse number="10" style="v" sid="PHP 1:10" />ताकि तुमन समझ सकव कि का ह सबले बने ए अऊ तुमन मसीह के आय के दिन तक सुध अऊ निरदोस बने रहव, <verse eid="PHP 1:10" /><verse number="11" style="v" sid="PHP 1:11" />अऊ धरमीपन के ओ फर ले भर जावव, जऊन ह यीसू मसीह के जरिये आथे, अऊ ये किसम ले परमेसर के महिमा अऊ परसंसा होवय।<verse eid="PHP 1:11" /></para>
  <para style="s1">पौलुस के जेल म रहई ले सुघर संदेस फईलथे</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12" />हे भाईमन हो, मेंह चाहथंव कि तुमन जानव कि जऊन कुछू मोर ऊपर बीते हवय, ओह सही म सुघर संदेस के बढ़ती म मददगार होईस। <verse eid="PHP 1:12" /><verse number="13" style="v" sid="PHP 1:13" />एकर नतीजा ये होईस कि महल के जम्मो सिपाही<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false">या </char><char style="fq" closed="false">जम्मो </char><char style="fqa" closed="false">महल</char></note> अऊ आने जम्मो झन म ये बात ह साफ हो गे हवय कि मेंह मसीह खातिर जेल म हवंव। <verse eid="PHP 1:13" /><verse number="14" style="v" sid="PHP 1:14" />मोर जेल म रहे के कारन, बहुंते भाईमन के परभू ऊपर बिसवास ह बढ़ गे हवय अऊ ओमन परमेसर के बचन ला अऊ साहसी अऊ निडर होके सुनावत हवंय।<verse eid="PHP 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 1:15" />येह सच ए कि कुछू झन जलन अऊ झगरा के कारन मसीह के परचार करथें, पर आने मन भले मनसा ले परचार करथें। <verse eid="PHP 1:15" /><verse number="16" style="v" sid="PHP 1:16" />ये मनखेमन मया म अइसने करथें, काबरकि येमन जानथें कि सुघर संदेस के बचाव खातिर मेंह जेल म रखे गे हवंव। <verse eid="PHP 1:16" /><verse number="17" style="v" sid="PHP 1:17" />पहिलेवाले मनखेमन ईमानदारी से नइं, पर सुवारथी भावना ले मसीह के परचार करथें। ओमन सोचथें कि जब मेंह जेल म हवंव, त मोर बर ओमन समस्या खड़े कर सकथें। <verse eid="PHP 1:17" /><verse number="18" style="v" sid="PHP 1:18" />पर कोनो बात नइं! बने बात ये अय कि हर किसम ले, चाहे गलत मनसा ले या सही मनसा ले, मसीह के परचार होवथे। अऊ एकरे कारन मेंह आनंदित हवंव।</para>
  <para style="p" vid="PHP 1:18">हव, मेंह हमेसा आनंदित रहिहूं। <verse eid="PHP 1:18" /><verse number="19" style="v" sid="PHP 1:19" />काबरकि मेंह जानत हंव कि तुम्हर पराथना के जरिये अऊ यीसू मसीह के आतमा के मदद के दुवारा, मेंह छूट जाहूं।<note caller="+" style="f"><char style="fr" closed="false">1:19 </char><char style="fq" closed="false">मेंह छूट जाहूं </char><char style="ft" closed="false">के मतलब </char><char style="fqa" closed="false">पौलुस के जेल ले छूटना </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">ओकर उद्धार </char><char style="ft" closed="false">घलो हो सकथे।</char></note> <verse eid="PHP 1:19" /><verse number="20" style="v" sid="PHP 1:20" />मोर दिली ईछा अऊ आसा हवय कि मेंह बिलकुल झन लजावंव, पर मोर करा पूरा हिम्मत रहय, ताकि मोर देहें म हमेसा मसीह के बड़ई होवत रहय, चाहे मोर जिनगी रहय या मर जावंव। <verse eid="PHP 1:20" /><verse number="21" style="v" sid="PHP 1:21" />काबरकि मोर बर जीयत रहई मसीह अय अऊ मर जवई फायदा के बात अय। <verse eid="PHP 1:21" /><verse number="22" style="v" sid="PHP 1:22" />यदि मेंह सरीर म होके जीयत रहिथंव, त एकर मतलब मोर मेहनत ह फर लानही, तभो ले मेंह नइं जानत हंव कि मेंह कते ला चुनंव? <verse eid="PHP 1:22" /><verse number="23" style="v" sid="PHP 1:23" />मेंह दूनों के मांझा म अधर म लटके हवंव। मोर जी ह तो चाहथे कि मेंह जावंव अऊ मसीह के संग रहंव, जऊन ह बहुंत बने बात अय, <verse eid="PHP 1:23" /><verse number="24" style="v" sid="PHP 1:24" />पर येह तुम्हर बर जादा जरूरी अय कि मेंह देहें म जीयत रहंव। <verse eid="PHP 1:24" /><verse number="25" style="v" sid="PHP 1:25" />मोला एकर भरोसा हवय कि मेंह बने रहिहूं, अऊ मेंह तुमन जम्मो झन संग बिसवास म तुम्हर बढ़ती अऊ आनंद खातिर जीयत रहिहूं। <verse eid="PHP 1:25" /><verse number="26" style="v" sid="PHP 1:26" />ताकि तुम्हर संग मोर फेर रहे के दुवारा, मसीह यीसू म तुम्हर आनंद ह मोर कारन अऊ बढ़ जावय।<verse eid="PHP 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PHP 1:27" />कुछू भी होवय, तुम्हर चालचलन ह मसीह के सुघर संदेस के लईक रहय। तब चाहे, मेंह आके तुमन ला देखंव, चाहे झन आवंव, पर मेंह तुम्हर बारे म सिरिप ये सुनंव कि तुमन एके आतमा म अटल खड़े हवव अऊ एक मन होके, सुघर संदेस के बिसवास खातिर बहुंत मेहनत करत हवव। <verse eid="PHP 1:27" /><verse number="28" style="v" sid="PHP 1:28" />तुमन कोनो भी किसम ले, ओमन ले झन डरव, जऊन मन तुम्हर बिरोध करथें। येह ओमन बर एक चिनहां ए कि ओमन नास हो जाहीं अऊ तुमन उद्धार पाहू। अऊ येह परमेसर के दुवारा होही। <verse eid="PHP 1:28" /><verse number="29" style="v" sid="PHP 1:29" />काबरकि मसीह कोति ले, तुमन ला ये मऊका देय गे हवय कि न सिरिप तुमन ओकर ऊपर बिसवास करव, पर ओकर बर दुख घलो उठावव। <verse eid="PHP 1:29" /><verse number="30" style="v" sid="PHP 1:30" />तुमन घलो ओहीच लड़ई लड़त हवव, जऊन ला तुमन पहिली मोला लड़त देख चुके हवव, अऊ जइसने कि तुमन सुनत हवव, मेंह अभी घलो लड़त हवंव।<verse eid="PHP 1:30" /></para>
  <chapter eid="PHP 1" />
  <chapter number="2" style="c" sid="PHP 2" />
  <para style="s1">मसीह के दीनता के नकल करई</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1" />एकरसेति, कहूं मसीह म तुम्हर करा कोनो उत्साह हवय, कहूं ओकर मया म तुमन ला कोनो सांति मिले हवय, कहूं पबितर आतमा के संग तुम्हर कोनो संगति हवय, कहूं तुमन म कोनो दया अऊ सहानुभूति हवय, <verse eid="PHP 2:1" /><verse number="2" style="v" sid="PHP 2:2" />त तुमन ये बातमन ला करे के दुवारा मोर आनंद ला पूरा करव कि तुमन एके मन के रहव, तुमन म एके मया रहय अऊ तुमन आतमा म एक होके एके उदेस्य बर जीयव। <verse eid="PHP 2:2" /><verse number="3" style="v" sid="PHP 2:3" />सुवारथीपन या बेकार के घमंड म पड़के कुछू झन करव, पर नमरता से आने मन ला अपनआप ले उत्तम समझव। <verse eid="PHP 2:3" /><verse number="4" style="v" sid="PHP 2:4" />तुमन ले हर एक झन सिरिप अपन हित के ही नइं, पर आने मन के हित के घलो खियाल रखय।<verse eid="PHP 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PHP 2:5" />जइसने मसीह यीसू के सुभाव रिहिस, वइसने तुम्हर सुभाव घलो होवय।<verse eid="PHP 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PHP 2:6" />मसीह करा परमेसर के जम्मो सुभाव रिहिस,</para>
  <para style="q2" vid="PHP 2:6">फेर ओह अपनआप ला परमेसर के बरोबर रखे के काबिल नइं समझिस,<verse eid="PHP 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PHP 2:7" />पर, ओह जम्मो चीज ला तियाग दीस,</para>
  <para style="q2" vid="PHP 2:7">अऊ सेवक के जम्मो सुभाव ला लीस</para>
  <para style="q2" vid="PHP 2:7">अऊ मनखे के रूप धरके जनमिस।<verse eid="PHP 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PHP 2:8" />अऊ ओह मनखे के रूप म परगट होके</para>
  <para style="q2" vid="PHP 2:8">अपनआप ला दीन-हीन करिस,</para>
  <para style="q2" vid="PHP 2:8">अऊ इहां तक हुकूम मानिस कि मिरतू,</para>
  <para style="q3" vid="PHP 2:8">हां ओह कुरूस के मिरतू ला घलो सह लीस।<verse eid="PHP 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PHP 2:9" />एकरसेति, परमेसर ह ओला अति महान करिस,</para>
  <para style="q2" vid="PHP 2:9">अऊ ओला ओ नांव दीस, जऊन ह जम्मो नांव ले उत्तम ए।<verse eid="PHP 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PHP 2:10" />ताकि स्वरग अऊ धरती अऊ धरती के खाल्हे म,</para>
  <para style="q2" vid="PHP 2:10">हर एक झन यीसू के नांव म माड़ी टेकंय,<verse eid="PHP 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PHP 2:11" />अऊ परमेसर ददा के महिमा खातिर,</para>
  <para style="q2" vid="PHP 2:11">हर एक झन ये मान लेवय कि यीसू मसीह ह परभू ए।<verse eid="PHP 2:11" /></para>
  <para style="s1">तारा के सहीं चमकव</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12" />एकरसेति, मोर मयारू संगवारीमन हो, जइसने तुमन हमेसा हुकूम मानत आय हवव, जब मेंह तुम्हर संग रहेंव, पर अब, जब मेंह तुम्हर ले दूरिहा हवंव, त तुमन डरत अऊ कांपत, अऊ जादा अपन उद्धार के काम म लगे रहव। <verse eid="PHP 2:12" /><verse number="13" style="v" sid="PHP 2:13" />काबरकि येह परमेसर ही अय, जऊन ह तुमन म काम करथे कि तुमन ओकर सही उदेस्य के मुताबिक ईछा करव अऊ काम करव।<verse eid="PHP 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 2:14" />बिगर कुड़कुड़ाय या बिगर बहस करे, जम्मो काम ला करव, <verse eid="PHP 2:14" /><verse number="15" style="v" sid="PHP 2:15" />ताकि तुमन निरदोस, अऊ सही मनखे बनव अऊ बेईमान अऊ भ्रस्ट मनखेमन के ये संसार म परमेसर के निरदोस संतान बने रहव।<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 32:5">ब्यव 32:5</ref></char></char></note> ओमन के बीच म, तुमन अकास के तारामन के सहीं चमकव। <verse eid="PHP 2:15" /><verse number="16" style="v" sid="PHP 2:16" />जिनगी के बचन ला कसके थामे रहव, ताकि मसीह के दिन म, मेंह घमंड कर सकंव कि मोर दऊड़ या मोर मेहनत ह बेकार नइं गीस। <verse eid="PHP 2:16" /><verse number="17" style="v" sid="PHP 2:17" />पर कहूं बलिदान म, मोर खून ह एक भेंट के रूप म ढारे जाथे अऊ तुम्हर बिसवास ले परमेसर के सेवा होथे, त मेंह खुस हवंव अऊ तुमन जम्मो झन के संग आनंद मनाथंव। <verse eid="PHP 2:17" /><verse number="18" style="v" sid="PHP 2:18" />वइसने तुमन घलो खुस होवव अऊ मोर संग आनंद मनावव।<verse eid="PHP 2:18" /></para>
  <para style="s1">तीमुथियुस अऊ इपफ्रुदीतुस</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19" />परभू यीसू म मोला आसा हवय कि मेंह तीमुथियुस ला तुम्हर करा जल्दी पठोहूं, ताकि जब मोला तुम्हर खबर मिलय, त मेंह घलो आनंदित होवंव। <verse eid="PHP 2:19" /><verse number="20" style="v" sid="PHP 2:20" />मोर करा ओकर सहीं अऊ कोनो नइं ए, जऊन ह सही म तुम्हर मामला म रूचि रखथे। <verse eid="PHP 2:20" /><verse number="21" style="v" sid="PHP 2:21" />काबरकि हर एक झन अपन खुद के खियाल रखथें, यीसू मसीह के बारे म नइं। <verse eid="PHP 2:21" /><verse number="22" style="v" sid="PHP 2:22" />पर तुमन जानथव कि तीमुथियुस ह ये साबित कर चुके हवय अऊ जइसने एक बेटा ह अपन ददा संग सेवा करथे, वइसने ओह मोर संग सुघर संदेस के काम म सेवा करे हवय। <verse eid="PHP 2:22" /><verse number="23" style="v" sid="PHP 2:23" />एकरसेति, जतेक जल्दी मोला ये मालूम होही कि मोर संग का होवइया हवय, मेंह ओला तुम्हर करा पठोय के आसा करथंव। <verse eid="PHP 2:23" /><verse number="24" style="v" sid="PHP 2:24" />अऊ मोला परभू म भरोसा हवय कि मेंह घलो जल्दी आहूं।<verse eid="PHP 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHP 2:25" />पर में सोचथंव कि इपफ्रुदीतुस ला तुम्हर करा वापिस पठोना जरूरी ए, जऊन ह कि मोर भाई, सहकरमी अऊ संगी योद्धा ए अऊ ओह तुम्हर संदेसिया घलो ए, जऊन ला तुमन मोर सेवा-टहल करे बर पठोय रहेव। <verse eid="PHP 2:25" /><verse number="26" style="v" sid="PHP 2:26" />ओकर मन ह तुमन जम्मो झन म लगे रहिथे अऊ ओह बियाकुल हवय काबरकि तुमन सुने रहेव कि ओह बेमार रिहिस। <verse eid="PHP 2:26" /><verse number="27" style="v" sid="PHP 2:27" />सही म, ओह बेमार रिहिस, इहां तक कि ओह लगभग मरइया रिहिस। पर परमेसर ह ओकर ऊपर दया करिस, अऊ सिरिप ओकर ऊपर ही नइं, पर मोर ऊपर घलो दया करिस कि मोला दुख के ऊपर दुख झन होवय। <verse eid="PHP 2:27" /><verse number="28" style="v" sid="PHP 2:28" />एकरसेति, मेंह ओला तुम्हर करा पठोय बर अऊ जादा उत्सुक हवंव, ताकि जब तुमन ओला फेर देखव, त खुस होवव अऊ मोर फिकर घलो कम होवय। <verse eid="PHP 2:28" /><verse number="29" style="v" sid="PHP 2:29" />परभू म, बड़े आनंद सहित, ओकर सुवागत करव, अऊ ओकर सहीं मनखेमन के आदर करव, <verse eid="PHP 2:29" /><verse number="30" style="v" sid="PHP 2:30" />काबरकि मसीह के काम खातिर, अपन जिनगी ला जोखिम म डालके, ओह मरे सहीं हो गे रिहिस, ताकि ओह मोर ओ जरूरत ला पूरा करय, जऊन ला तुमन नइं कर सकेव।<verse eid="PHP 2:30" /></para>
  <chapter eid="PHP 2" />
  <chapter number="3" style="c" sid="PHP 3" />
  <para style="s1">मनखे के काम ऊपर भरोसा नइं</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1" />कुछू घलो होवय, हे मोर भाईमन हो, परभू म आनंदित रहव। तुमन ला ओहीच बात फेर लिखे म, मोला कोनो तकलीफ नइं होवय अऊ येमा तुम्हर भलई हवय। <verse eid="PHP 3:1" /><verse number="2" style="v" sid="PHP 3:2" />ओ कुकुरमन ले सचेत रहव। येमन ओ मनखे अंय, जऊन मन खराप काम करथें अऊ देहें के अंगमन ला काट-छांट करथें। <verse eid="PHP 3:2" /><verse number="3" style="v" sid="PHP 3:3" />काबरकि खतना वाले मनखे तो सिरिप हमन अन, जऊन मन परमेसर के अराधना पबितर आतमा के दुवारा करथन अऊ मसीह यीसू म महिमा करथन अऊ देहें के ऊपर भरोसा नइं करन— <verse eid="PHP 3:3" /><verse number="4" style="v" sid="PHP 3:4" />हालाकि मोर करा अइसने भरोसा करे के कारन हवय।</para>
  <para style="p" vid="PHP 3:4">कहूं कोनो ये सोचथे कि ओकर करा देहें के ऊपर भरोसा करे के कारन हवय, त मोर करा जादा कारन हवय: <verse eid="PHP 3:4" /><verse number="5" style="v" sid="PHP 3:5" />जनम के आठवां दिन म मोर खतना होईस। मेंह इसरायल के बंस अऊ बिनयामीन के गोत्र के अंव। मेंह इबरीमन के इबरी अंव। मूसा के कानून के मुताबिक मेंह एक फरीसी अंव। <verse eid="PHP 3:5" /><verse number="6" style="v" sid="PHP 3:6" />यदि तुमन जोस के बारे कहिथव, त मेंह कलीसिया के एक सतानेवाला रहेंव। मूसा के कानून के धरमीपन के बारे यदि तुमन कहिथव, त मेंह निरदोस अंव।<verse eid="PHP 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PHP 3:7" />पर जऊन कुछू घलो मोर फायदा के रिहिस, मेंह अब ओला मसीह के हित म हानि समझथंव। <verse eid="PHP 3:7" /><verse number="8" style="v" sid="PHP 3:8" />वास्तव म, मसीह यीसू, मोर परभू ला जाने के महानता के तुलना म, मेंह हर एक बात ला एक हानि समझथंव। मसीह यीसू, मोर परभू के हित म, मेंह जम्मो बात के हानि उठाय हवंव अऊ मेंह ओ बातमन ला कचरा समझथंव, ताकि मेंह मसीह ला पा जावंव, <verse eid="PHP 3:8" /><verse number="9" style="v" sid="PHP 3:9" />अऊ ओकर संग एक हो जावंव अऊ येह मोर खुद के धरमीपन ले नइं, जऊन ह कि मूसा के कानून ला पालन करे ले आथे, पर येह मसीह म बिसवास के जरिये—ओ धरमीपन ले अय, जऊन ह परमेसर करा ले आथे अऊ येह बिसवास के दुवारा अय। <verse eid="PHP 3:9" /><verse number="10" style="v" sid="PHP 3:10" />मेंह मसीह ला अऊ ओकर फेर जी उठे के सामर्थ ला जाने चाहथंव अऊ मेंह ओकर दुख-पीरा म भागी होय चाहथंव अऊ मेंह ओकर मिरतू म ओकर सहीं बने चाहथंव, <verse eid="PHP 3:10" /><verse number="11" style="v" sid="PHP 3:11" />ताकि कोनो घलो किसम ले, मेंह घलो मरे मन ले जी उठंव।<verse eid="PHP 3:11" /></para>
  <para style="s1">निसाना कोति बढ़ई</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12" />मेंह ये नइं कहंव, कि ये जम्मो ला पहिले ही पा चुके हवंव या मेंह सिद्ध हो चुके हवंव, पर मेंह ओला पाय बर आघू बढ़त हवंव, जेकर खातिर मसीह यीसू ह मोला अपन बनाय हवय। <verse eid="PHP 3:12" /><verse number="13" style="v" sid="PHP 3:13" />हे भाईमन हो, मेंह ये नइं सोचत हंव कि मेंह येला पा चुके हवंव। पर मेंह एक काम करथंव: पाछू के बातमन ला भुला के, मेंह आघू के चीज ला पाय बर बढ़त जावत हंव। <verse eid="PHP 3:13" /><verse number="14" style="v" sid="PHP 3:14" />निसाना के तरफ मेंह दऊड़े चले जावत हंव, ताकि ओ ईनाम ला जीतंव, जेकर खातिर परमेसर ह मोला मसीह यीसू म ऊपर स्वरग म बलाय हवय।<verse eid="PHP 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 3:15" />हमन म जतेक झन आतमिक रूप ले समझदार हवन, एहीच बिचार रखना चाही। अऊ कहूं कोनो बात म तुम्हर अलग बिचार हवय, त ओ बात ला घलो, परमेसर ह तुम्हर बर परगट कर दीही। <verse eid="PHP 3:15" /><verse number="16" style="v" sid="PHP 3:16" />जऊन ला हमन पा चुके हवन, आवव, हमन सिरिप ओकरे मुताबिक जिनगी बितावन।<verse eid="PHP 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 3:17" />हे भाईमन हो, आने मन के संग मिलके मोर नकल करव, अऊ ओमन ऊपर धियान देवव, जऊन मन ओ नमूना के मुताबिक जिनगी बितावत हवंय, जऊन ला हमन तुमन ला देय हवन। <verse eid="PHP 3:17" /><verse number="18" style="v" sid="PHP 3:18" />काबरकि, जइसने मेंह तुमन ला पहिली अकसर कहे हवंव अऊ अब फेर मेंह रो-रोके कहथंव कि कतको झन मसीह के कुरूस के बईरी सहीं जिनगी जीयथें। <verse eid="PHP 3:18" /><verse number="19" style="v" sid="PHP 3:19" />ओमन के अन्त ह बिनास अय। ओमन के ईस्वर ह ओमन के पेट अय, अऊ ओमन अपन कलंक के काम ला अपन महिमा समझथें। ओमन के मन ह संसारिक बात म लगे रहिथे। <verse eid="PHP 3:19" /><verse number="20" style="v" sid="PHP 3:20" />पर हमर देस ह स्वरग अय। अऊ हमन उत्साह के संग उहां ले एक उद्धार करइया याने परभू यीसू मसीह के बाट जोहथन, <verse eid="PHP 3:20" /><verse number="21" style="v" sid="PHP 3:21" />जऊन ह सामर्थ के दुवारा हमर नासमान देहें ला बदल दीही अऊ ओमन ओकर महिमामय देहें सहीं हो जाहीं। अऊ येह ओहीच सामर्थ ए, जेकर दुवारा, ओह हर एक चीज ला अपन अधीन कर लेथे।<verse eid="PHP 3:21" /></para>
  <chapter eid="PHP 3" />
  <chapter number="4" style="c" sid="PHP 4" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1" />एकरसेति, हे मोर भाईमन हो! तुमन ले मेंह मया करथंव अऊ तुमन म मोर जी लगे रहिथे। तुमन मोर आनंद अऊ मोर मुकुट अव। हे मयारू संगवारीमन, अइसनेच तुमन परभू के बिसवास म मजबूत बने रहव।<verse eid="PHP 4:1" /></para>
  <para style="s1">उत्साह के बचन</para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 4:2" />मेंह यूओदिया ले बिनती करथंव अऊ सुन्तुखे ले घलो बिनती करथंव कि तुमन परभू म एक-दूसर के संग एक मन होके रहव। <verse eid="PHP 4:2" /><verse number="3" style="v" sid="PHP 4:3" />अऊ हे सच्चा सहकरमी, मेंह तोर ले घलो कहथंव कि तेंह ये माईलोगनमन के मदद कर, काबरकि येमन मोर संग सुघर संदेस ला फईलाय म, क्लेमेंस अऊ मोर ओ जम्मो सहकरमीमन संग मेहनत करे हवंय, जेमन के नांव जिनगी के किताब म लिखे हवय।<verse eid="PHP 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PHP 4:4" />परभू म सदा आनंदित रहव। मेंह येला फेर कहथंव: आनंदित रहव! <verse eid="PHP 4:4" /><verse number="5" style="v" sid="PHP 4:5" />जम्मो झन जान जावंय कि तुमन नम्र मनखे अव। परभू ह लकठा म हवय। <verse eid="PHP 4:5" /><verse number="6" style="v" sid="PHP 4:6" />कोनो बात के फिकर झन करव, पर हर एक बात म, पराथना अऊ निबेदन के दुवारा, धनबाद के संग तुमन अपन बिनती ला परमेसर के आघू म रखव। <verse eid="PHP 4:6" /><verse number="7" style="v" sid="PHP 4:7" />तब परमेसर के सांति, जऊन ह मनखे के समझ के बाहिर अय, तुम्हर हिरदय अऊ मन के रखवारी मसीह यीसू म करही।<verse eid="PHP 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PHP 4:8" />आखिर म, हे भाईमन हो, जऊन बात ह सच ए, जऊन बात ह आदर के लईक ए, जऊन बात ह सही ए, जऊन बात ह निरमल ए, जऊन बात ह मयारू ए, जऊन बात ह मन ला भाथे—यदि कोनो बात ह उत्तम या परसंसा के लईक ए, त अइसने बात के बारे म सोचव। <verse eid="PHP 4:8" /><verse number="9" style="v" sid="PHP 4:9" />जऊन बात तुमन मोर ले सीखे हवव या मोर ले पाय हवव या मोर ले सुने हवव या मोर म देखे हवव, ओकरेच मुताबिक चलव। अऊ सांति के परमेसर ह तुमन के संग रहिही।<verse eid="PHP 4:9" /></para>
  <para style="s1">दान के खातिर धनबाद</para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10" />मेंह परभू म बहुंत आनंदित हवंव कि आखिर म, तुमन फेर एक बार मोर फिकर करे हवव। वास्तव म, तुमन मोर फिकर करत तो रहेव, पर येला परगट करे के तुमन ला मऊका नइं मिलत रिहिस। <verse eid="PHP 4:10" /><verse number="11" style="v" sid="PHP 4:11" />मेंह ये बात एकरसेति नइं कहथंव कि मोला कोनो चीज के घटी हवय, काबरकि कोनो घलो दसा म मेंह संतोस रहना सीख ले हवंव। <verse eid="PHP 4:11" /><verse number="12" style="v" sid="PHP 4:12" />मेंह जानथंव कि घटी म रहे के मतलब का होथे। मेंह ये घलो जानथंव कि बेसी म रहे के का मतलब होथे। मेंह कोनो भी दसा म संतोस रहे के भेद ला सीख गे हवंव; चाहे मेंह भरपेट खावंव या भूखा रहंव, चाहे मोर करा बहुंत रहय या मेंह घटी म रहंव। <verse eid="PHP 4:12" /><verse number="13" style="v" sid="PHP 4:13" />जऊन ह मोला ताकत देथे, ओकर जरिये, मेंह हर चीज ला कर सकथंव।<verse eid="PHP 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 4:14" />तभो ले, तुमन बने करेव कि मोर तकलीफ म मदद करेव। <verse eid="PHP 4:14" /><verse number="15" style="v" sid="PHP 4:15" />हे फिलिप्पीमन, जइसने कि तुमन जानथव कि सुघर संदेस के परचार के सुरूआती दिन म, जब मेंह मकिदुनिया प्रदेस ले चलेंव, त सिरिप तुम्हर छोंड़ अऊ कोनो घलो कलीसिया देय अऊ लेय के मामला म मोर मदद नइं करिस। <verse eid="PHP 4:15" /><verse number="16" style="v" sid="PHP 4:16" />अऊ त अऊ जब मेंह थिस्सलुनीके सहर म रहेंव अऊ मोला घटी रिहिस, त तुमन बार-बार मोर करा मदद पठोय रहेव। <verse eid="PHP 4:16" /><verse number="17" style="v" sid="PHP 4:17" />अइसने बात नो हय कि मेंह दान चाहथंव, पर मेंह चाहथंव कि तुमन अइसने काम करव, जऊन ह तुम्हर जिनगी के खाता म जोड़े जावय। <verse eid="PHP 4:17" /><verse number="18" style="v" sid="PHP 4:18" />मेंह जम्मो चीज ला पा गे हवंव, बल्कि मोला जरूरत ले जादा मिल गे हवय। तुमन इपफ्रुदीतुस के हांथ म जऊन भेंट ला पठोय रहेव, ओला पाके मोर मन ह संतोस हो गे हवय। ओमन एक खुसबूदार भेंट, गरहन करे लईक बलिदान अंय, जेकर ले परमेसर ला खुसी होथे। <verse eid="PHP 4:18" /><verse number="19" style="v" sid="PHP 4:19" />अऊ मोर परमेसर ह मसीह यीसू म अपन महिमामय धन के मुताबिक तुम्हर जम्मो जरूरत ला पूरा करही।<verse eid="PHP 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PHP 4:20" />परमेसर, हमर ददा के महिमा जुग-जुग होवय। आमीन।<verse eid="PHP 4:20" /></para>
  <para style="b" />
  <para style="s1">आखिरी जोहार</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21" />जम्मो संतमन ला, जऊन मन मसीह यीसू म हवंय, जोहार कहव।</para>
  <para style="p" vid="PHP 4:21">जऊन भाईमन मोर संग इहां हवंय, ओमन तुमन ला जोहार कहत हवंय।<verse eid="PHP 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PHP 4:22" />इहां के जम्मो संत, खास करके जऊन मन महाराजा के घराना के अंय, तुमन ला जोहार कहत हवंय।<verse eid="PHP 4:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="PHP 4:23" />परभू यीसू मसीह के अनुग्रह तुम्हर आतमा के संग रहय। आमीन।<note caller="+" style="f"><char style="fr" closed="false">4:23 </char><char style="ft" closed="false">कुछू हस्तलिपि म </char><char style="fqa" closed="false">आमीन </char><char style="ft" closed="false">सबद नइं ए</char></note><verse eid="PHP 4:23" /></para>
  <chapter eid="PHP 4" />
</usx>