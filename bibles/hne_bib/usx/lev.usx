<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LEV" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  
  <para style="h">लैव्य-ब्यवस्था</para>
  <para style="toc1">लैव्य-ब्यवस्था के किताब</para>
  <para style="toc2">लैव्य-ब्यवस्था</para>
  <para style="toc3">लैव्य</para>
  <para style="mt1">लैव्य-ब्यवस्था</para>
  <para style="mt2">के किताब</para>
  <chapter number="1" style="c" sid="LEV 1" />
  <para style="s1">होम-बलिदान</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 1:1" />यहोवा ह मूसा ला बलाईस अऊ मिलापवाला तम्बू ले ओला कहिस, <verse eid="LEV 1:1" /><verse number="2" style="v" sid="LEV 1:2" />“इसरायलीमन ले गोठिया अऊ ओमन ला ये कह: ‘जब तुमन म ले कोनो मनखे यहोवा बर कोनो बलिदान चघाय बर लानथे, त ओह बलिदान के रूप म कोनो पसु ला, गाय-बईला या भेड़-बकरी के झुंड म ले लेके आवय।<verse eid="LEV 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 1:3" />“ ‘कहूं बलिदान ह गाय-बईला के झुंड म ले होम-बलिदान ए, त तें निरदोस नर पसु ला बलिदान करबे। ये बलिदान ह मिलापवाला तम्बू के प्रवेस दुवार म चघाय जावय, ताकि यहोवा ह येला गरहन करय। <verse eid="LEV 1:3" /><verse number="4" style="v" sid="LEV 1:4" />तें अपन हांथ ओ होम-बलिदान के पसु के मुड़ ऊपर रखबे, त ये बलिदान ह तोर कोति ले तोर पछतावा के रूप म गरहन करे जाही। <verse eid="LEV 1:4" /><verse number="5" style="v" sid="LEV 1:5" />तेंह यहोवा के आघू म बछवा ला बलि करबे, अऊ तब हारून के बेटामन, जऊन मन पुरोहित अंय, ओकर लहू ला लानहीं अऊ ओ बेदी के चारों कोति छिंचहीं, जऊन ह मिलापवाला तम्बू के प्रवेस दुवार म हवय। <verse eid="LEV 1:5" /><verse number="6" style="v" sid="LEV 1:6" />तब तें होम-बलिदान करे गे ओ पसु के चमड़ी ला निकाल देबे अऊ ओ पसु के कुटा-कुटा कर देबे। <verse eid="LEV 1:6" /><verse number="7" style="v" sid="LEV 1:7" />हारून पुरोहित के बेटामन बेदी म आगी जलाहीं अऊ आगी ऊपर लकरी ला रचहीं। <verse eid="LEV 1:7" /><verse number="8" style="v" sid="LEV 1:8" />तब हारून के ओ बेटामन, जऊन मन पुरोहित अंय, ओ पसु के कुटामन ला मुड़ अऊ चरबी समेत बेदी ऊपर बरत लकरी म रखहीं। <verse eid="LEV 1:8" /><verse number="9" style="v" sid="LEV 1:9" />तेंह ओ पसु के पेट भीतर के चीजमन ला अऊ गोड़मन ला पानी म धो डारबे, अऊ पुरोहित ह ये जम्मो ला बेदी म जला देवय। येह यहोवा बर एक महकत सुख-देवइया, एक होम-बलिदान, अऊ एक जेवन-बलिदान होही।<verse eid="LEV 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 1:10" />“ ‘कहूं बलिदान ह भेड़-बकरी के झुंड म ले एक होम-बलिदान अय, त तें भेड़ या बोकरा म ले बिगर दोसवाला नर ला बलिदान करबे। <verse eid="LEV 1:10" /><verse number="11" style="v" sid="LEV 1:11" />तेंह येला बेदी के उत्तर कोति यहोवा के आघू म बलि करबे, अऊ हारून के बेटामन, जऊन मन पुरोहित अंय, ओकर लहू ला बेदी के चारों कोति छिंचहीं। <verse eid="LEV 1:11" /><verse number="12" style="v" sid="LEV 1:12" />तब तें ओ पसु के कुटा-कुटा कर देबे, अऊ पुरोहित ह ओ पसु के कुटामन ला मुड़ अऊ चरबी समेत बेदी ऊपर बरत लकरी म रखय। <verse eid="LEV 1:12" /><verse number="13" style="v" sid="LEV 1:13" />तेंह ओ पसु के पेट भीतर के अंगमन ला अऊ गोड़मन ला पानी म धो डारबे, अऊ पुरोहित ह ओ जम्मो ला लानके बेदी म जला देवय। येह यहोवा बर एक महकत सुख-देवइया, एक होम-बलिदान, अऊ एक जेवन-बलिदान होही।<verse eid="LEV 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 1:14" />“ ‘कहूं यहोवा बर बलिदान ह चिरई के होम-बलिदान अय, त तें पंड़की या परेवा पीला के बलिदान चघाबे। <verse eid="LEV 1:14" /><verse number="15" style="v" sid="LEV 1:15" />पुरोहित ह ओला बेदी म लानय अऊ ओकर घेंच ला मुरकेट के मुड़ ला अलग करय अऊ ओला बेदी म जलावय; ओकर लहू ला बेदी के बाजू म गिरावय। <verse eid="LEV 1:15" /><verse number="16" style="v" sid="LEV 1:16" />ओह घेंच के थैली अऊ पांखी ला निकालय अऊ ओमन ला बेदी के पूरब कोति राख डारे के जगह म फटिक देवय। <verse eid="LEV 1:16" /><verse number="17" style="v" sid="LEV 1:17" />तब ओह दूनों डेना ला धरके चीरय, पर पूरा अलग झन करय, अऊ तब पुरोहित ह ओला बेदी म रखके बरत लकरी म जलावय। येह यहोवा बर एक महकत सुख-देवइया, एक होम-बलिदान अऊ एक जेवन-बलिदान होही।<verse eid="LEV 1:17" /></para>
  <chapter eid="LEV 1" />
  <chapter number="2" style="c" sid="LEV 2" />
  <para style="s1">अन्न-बलिदान</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 2:1" />“ ‘जब कोनो मनखे यहोवा करा अन्न-बलिदान लानथे, त ओकर बलिदान ह बहुंत चिक्कन पीसान के होना चाही। ओह ओकर ऊपर जैतून तेल डारके ओमा धूप घलो रखय, <verse eid="LEV 2:1" /><verse number="2" style="v" sid="LEV 2:2" />अऊ ओला हारून के ओ बेटामन करा ले जावय, जऊन मन पुरोहित अंय। पुरोहित ह ओ तेल अऊ धूप मिले मैदा ला एक मुठा भरके निकालय, अऊ ओला एक सुरता-देवइया हिस्सा के रूप म बेदी म जलावय कि येह यहोवा बर एक महकत सुख-देवइया, अन्न-बलिदान ठहिरय। <verse eid="LEV 2:2" /><verse number="3" style="v" sid="LEV 2:3" />बाकि बांचे अन्न-बलिदान ह हारून अऊ ओकर बेटामन के अय; येह जेवन-बलिदान के सबले पबितर भाग अय, जेला यहोवा ला चघाय जाथे।<verse eid="LEV 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 2:4" />“ ‘यदि तें भट्ठी म पके अन्न-बलिदान लानथस, त येह बहुंत चिक्कन पीसान के होना चाही: येह जैतून तेल म सनाय अखमीरी मोटा रोटी होवय या फेर जैतून तेल म चुपराय अखमीरी पातर रोटी होवय। <verse eid="LEV 2:4" /><verse number="5" style="v" sid="LEV 2:5" />यदि तुम्हर अन्न-बलिदान ह तवा म पके हवय, त येह तेल म सनाय बहुंत चिक्कन पीसान के बने अखमीरी रोटी होवय। <verse eid="LEV 2:5" /><verse number="6" style="v" sid="LEV 2:6" />तुमन ओला कुटा-कुटा करके ओकर ऊपर तेल डारव; येह एक अन्न-बलिदान अय। <verse eid="LEV 2:6" /><verse number="7" style="v" sid="LEV 2:7" />कहूं तुम्हर अन्न-बलिदान ह कढ़ई म चुरे हवय, त ओला बहुंत चिक्कन पीसान अऊ थोरकन तेल म बनाय जावय। <verse eid="LEV 2:7" /><verse number="8" style="v" sid="LEV 2:8" />ये चीजमन ले बने अन्न-बलिदान ला यहोवा करा लानव; ओला पुरोहित ला सऊंप देवव अऊ पुरोहित ह ओला बेदी मेर ले जावय। <verse eid="LEV 2:8" /><verse number="9" style="v" sid="LEV 2:9" />पुरोहित ह अन्न-बलिदान म ले सुरता-देवइया हिस्सा ला निकालय अऊ ओला बेदी म जला देवय कि ओह यहोवा बर एक महकत सुख-देवइया, जेवन-बलिदान ठहिरय। <verse eid="LEV 2:9" /><verse number="10" style="v" sid="LEV 2:10" />बाकि बांचे अन्न-बलिदान ह हारून अऊ ओकर बेटामन के अय; येह जेवन-बलिदान के सबले पबितर भाग अय, जेला यहोवा ला चघाय जाथे।<verse eid="LEV 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 2:11" />“ ‘यहोवा करा लाने गय हर एक अन्न-बलिदान बिगर खमीर के बनाय जावय, काबरकि यहोवा ला चघाय जेवन-बलिदान म, तुमन ला कोनो खमीर या मंधरस जलाना नइं ए। <verse eid="LEV 2:11" /><verse number="12" style="v" sid="LEV 2:12" />तुमन येमन ला पहिली फर के बलिदान के रूप म यहोवा करा लान सकत हव, पर ओमन ला एक महकत सुख-देवइया बलिदान के रूप म बेदी ऊपर झन चघाय जावय। <verse eid="LEV 2:12" /><verse number="13" style="v" sid="LEV 2:13" />अपन जम्मो अन्न-बलिदान ला नूनचूर करव। अपन परमेसर के संग बांधे करार के नून<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false">स्थायी करार; <char style="xt"><ref loc="NUM 18:19">गन 18:19</ref></char> अऊ <char style="xt"><ref loc="2CH 13:5">2 इति 13:5</ref></char> म घलो</char></note> ला अपन अन्न-बलिदान ले अलग झन करव; अपन जम्मो बलिदान म नून मिलावव।<verse eid="LEV 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 2:14" />“ ‘कहूं तुमन पहिली-फसल के अन्न-बलिदान यहोवा करा लानथव, त आगी म भूंजे नवां अनाज के कुचरे बालीमन ला अन्न-बलिदान करव। <verse eid="LEV 2:14" /><verse number="15" style="v" sid="LEV 2:15" />तुमन येमा तेल अऊ धूप डारव; येह एक अन्न-बलिदान ए। <verse eid="LEV 2:15" /><verse number="16" style="v" sid="LEV 2:16" />तब पुरोहित ह तेल अऊ जम्मो धूप के संग कुचरे अनाज के सुरता-देवइया हिस्सा ला जला देवय कि येह यहोवा बर जेवन-बलिदान ठहिरय।<verse eid="LEV 2:16" /></para>
  <chapter eid="LEV 2" />
  <chapter number="3" style="c" sid="LEV 3" />
  <para style="s1">मेल-बलिदान</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 3:1" />“ ‘कहूं तुम्हर चढ़ावा ह मेल-बलिदान ए, अऊ ओला बरदी म ले चघावव, चाहे ओह नर या मादा होवय, त यहोवा के आघू म निरदोस पसु ला ही चघावव। <verse eid="LEV 3:1" /><verse number="2" style="v" sid="LEV 3:2" />ओह अपन हांथ ला चढ़ावा पसु के मुड़ म मढ़ावय अऊ ओला मिलापवाला तम्बू के प्रवेस दुवार म पूजय; फेर हारून के बेटा, जऊन मन पुरोहित अंय, ओकर लहू ला बेदी के ऊपर जम्मो कोति छिंच देवंय। <verse eid="LEV 3:2" /><verse number="3" style="v" sid="LEV 3:3" />अऊ ओह मेल-बलिदान के चढ़ावा म ले यहोवा बर होम-बलिदान करय याने ओ चरबी जेकर ले पोटामन ढंकाय रहिथे अऊ ओ जम्मो चरबी जेकर ले पोटामन लपटाय रहिथें, <verse eid="LEV 3:3" /><verse number="4" style="v" sid="LEV 3:4" />अऊ दूनों गुरदा अऊ ओमन के ऊपर के चरबी जऊन ह कनिहां के तीर म रहिथे, अऊ गुरदा समेत करेजा के सबले बने भाग, ये जम्मो ला ओह अलग करय। <verse eid="LEV 3:4" /><verse number="5" style="v" sid="LEV 3:5" />हारून के बेटामन ये जम्मो ला बेदी म ओ होम-बलिदान के ऊपर जला देवंय, जऊन ह आगी के ऊपर के लकरी म हवय। येह यहोवा बर महकत सुख-देवइया एक जेवन-बलिदान ठहिरही।<verse eid="LEV 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 3:6" />“ ‘कहूं तेंह यहोवा बर कोनो पसु म ले मेल-बलिदान चघाथस, त ओ चढ़ावा ह बिगर दोसवाला नर या मादा पसु हो। <verse eid="LEV 3:6" /><verse number="7" style="v" sid="LEV 3:7" />कहूं तेंह मेढ़ा-पीला चघावत हस, त ओ चढ़ावा ला यहोवा के आघू म चघा। <verse eid="LEV 3:7" /><verse number="8" style="v" sid="LEV 3:8" />मिलापवाला तम्बू के आघू म अपन हांथ ला चढ़ावा पसु के मुड़ ऊपर मढ़ाके ओला पूज दे। फेर हारून के बेटामन ओकर लहू ला बेदी म चारों कोति छिंचंय। <verse eid="LEV 3:8" /><verse number="9" style="v" sid="LEV 3:9" />तें मेल-बलिदान म ले यहोवा बर एक जेवन-बलिदान लान: येह चरबी अय, याने कि मंझरेटा हाड़ा के तीर ले अलग करे गय चरबी भरे पुंछी, अऊ ओ चरबी जेकर ले पोटामन तोपाय रहिथें, अऊ ओ जम्मो चरबी जऊन ह पोटामन म लपटाय रहिथे। <verse eid="LEV 3:9" /><verse number="10" style="v" sid="LEV 3:10" />अऊ दूनों गुरदा अऊ ओकर ऊपर के चरबी जऊन ह कनिहां के तीर म रहिथे अऊ गुरदा समेत करेजा के सबले बने भाग, ये जम्मो ला तेंह अलग करबे। <verse eid="LEV 3:10" /><verse number="11" style="v" sid="LEV 3:11" />अऊ पुरोहित ह येमन ला लेके बेदी म जलावय; येह यहोवा बर एक जेवन-बलिदान ठहिरही।<verse eid="LEV 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 3:12" />“ ‘कहूं तोर चढ़ावा ह बोकरा होवय, त ओला यहोवा के आघू म चघा। <verse eid="LEV 3:12" /><verse number="13" style="v" sid="LEV 3:13" />तेंह मिलापवाला तम्बू के आघू म चढ़ावा पसु के मुड़ म अपन हांथ ला मढ़ाके ओला पूज दे, अऊ हारून के बेटामन ओकर लहू ला बेदी म जम्मो कोति छिंच देवंय। <verse eid="LEV 3:13" /><verse number="14" style="v" sid="LEV 3:14" />तें ओमा ले अपन चढ़ावा ला यहोवा बर जेवन-बलिदान करके चघा, याने ओ चरबी जेकर ले पोटामन तोपाय रहिथें, अऊ ओ जम्मो चरबी जऊन ह पोटामन म लपटाय रहिथे, <verse eid="LEV 3:14" /><verse number="15" style="v" sid="LEV 3:15" />अऊ दूनों गुरदा अऊ ओकर ऊपर के चरबी जऊन ह कनिहां के तीर म रहिथे, अऊ गुरदा समेत करेजा के सबले बने भाग, ये जम्मो ला तेंह अलग करबे। <verse eid="LEV 3:15" /><verse number="16" style="v" sid="LEV 3:16" />तब पुरोहित ह ओमन ला बेदी म जेवन-बलिदान के रूप म जलावय; येह सुख-देवइया सुगंध ठहिरय। जम्मो चरबी ह यहोवा के ही अय।<verse eid="LEV 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 3:17" />“ ‘जिहां कहूं भी तुमन रहव, येह अवइया पीढ़ी-पीढ़ी बर हमेसा के एक बिधि ठहिरय। तुमन चरबी अऊ लहू ला कभू झन खाहू।’ ”<verse eid="LEV 3:17" /></para>
  <chapter eid="LEV 3" />
  <chapter number="4" style="c" sid="LEV 4" />
  <para style="s1">पाप-बलिदान</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 4:1" />फेर यहोवा ह मूसा ला कहिस, <verse eid="LEV 4:1" /><verse number="2" style="v" sid="LEV 4:2" />“इसरायलीमन ला ये कह: ‘जब कोनो अनजाने म कोनो पाप करथे अऊ ओ काम करथे, जऊन ह यहोवा के कोनो हुकूम के बिरूध अय—<verse eid="LEV 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 4:3" />“ ‘कहूं अभिसिक्त पुरोहित ह अइसने पाप करय, जेकर ले मनखेमन दोसी ठहिरंय, त अपन पाप के खातिर, ओह यहोवा करा एक निरदोस बछवा पाप-बलिदान<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सुधिकरन-बलिदान</char></note> के रूप म लानय। <verse eid="LEV 4:3" /><verse number="4" style="v" sid="LEV 4:4" />ओह ओ बछवा ला मिलापवाला तम्बू के प्रवेस दुवार म यहोवा के आघू म लानय अऊ ओकर मुड़ म अपन हांथ रखय अऊ बछवा ला यहोवा के आघू म बलि करय। <verse eid="LEV 4:4" /><verse number="5" style="v" sid="LEV 4:5" />तब अभिसिक्त पुरोहित ह बछवा के थोरकून लहू ला लेके मिलापवाला तम्बू म जावय। <verse eid="LEV 4:5" /><verse number="6" style="v" sid="LEV 4:6" />ओह अपन अंगठी ला लहू म बुड़ोके पबितर-स्थान के परदा के सामने यहोवा के आघू म सात बार छिंचय। <verse eid="LEV 4:6" /><verse number="7" style="v" sid="LEV 4:7" />तब पुरोहित ह ओ लहू म ले थोरकून ला लेके कहरत धूप के बेदी के ओ सींगमन म लगावय, जऊन ह मिलापवाला तम्बू म यहोवा के आघू म हवय। बछवा के बांचे जम्मो लहू ला, ओह होम-बलिदान के बेदी के खाल्हे म रितो देवय, जऊन ह मिलापवाला तम्बू के प्रवेस दुवार म हवय। <verse eid="LEV 4:7" /><verse number="8" style="v" sid="LEV 4:8" />ओह पाप-बलिदान के बछवा के जम्मो चरबी ला निकाल देवय—याने कि पेट भीतर के अंगमन के जम्मो चरबी, <verse eid="LEV 4:8" /><verse number="9" style="v" sid="LEV 4:9" />अऊ दूनों गुरदा अऊ ओकर ऊपर के चरबी जऊन ह कनिहां के तीर म रहिथे, अऊ करेजा के सबले बने भाग, जऊन ला ओह गुरदा संग अलग करही— <verse eid="LEV 4:9" /><verse number="10" style="v" sid="LEV 4:10" />जइसने कि मेल-बलिदान के बलि के बईला ले चरबी ला अलग करे जाथे। तब पुरोहित ह येमन ला होम-बलिदान के बेदी म जला देवय। <verse eid="LEV 4:10" /><verse number="11" style="v" sid="LEV 4:11" />पर बछवा के खाल अऊ ओकर जम्मो मांस, अऊ मुड़, गोड़मन ला, पेट भीतर के अंग अऊ पोटा ला— <verse eid="LEV 4:11" /><verse number="12" style="v" sid="LEV 4:12" />याने कि बछवा के जम्मो बांचे भाग ला ओह डेरा के बाहिर ओ जगह म ले जावय, जेला बिधि-बिधान ले सुध करे गे हवय अऊ जिहां राख ला डारे जाथे, अऊ उहां राख ऊपर लकरी रखके ओमा येला जला देवय।<verse eid="LEV 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 4:13" />“ ‘कहूं जम्मो इसरायली समाज अनजाने म कोनो पाप करथे अऊ अइसने काम करथे, जऊन ह यहोवा के हुकूम के बिरूध अय, हालाकि पूरा समाज ये बात ले अनजान रहिथे, पर जब ओमन अपन अपराध ला जानथें <verse eid="LEV 4:13" /><verse number="14" style="v" sid="LEV 4:14" />अऊ ओमन ला अपन करे गे पाप के पता चलथे, त जम्मो समाज ह एक ठन बछवा ला पाप-बलिदान के रूप म मिलापवाला तम्बू के आघू म लेके जावय, <verse eid="LEV 4:14" /><verse number="15" style="v" sid="LEV 4:15" />अऊ समाज के अगुवामन यहोवा के आघू म ओ बछवा के मुड़ म अपन हांथ रखंय अऊ यहोवा के आघू म ओ बछवा के बलि करे जावय। <verse eid="LEV 4:15" /><verse number="16" style="v" sid="LEV 4:16" />तब अभिसिक्त पुरोहित ह बछवा के लहू म ले थोरकून ला मिलापवाला तम्बू म ले जावय। <verse eid="LEV 4:16" /><verse number="17" style="v" sid="LEV 4:17" />ओह अपन अंगठी ला लहू म बुड़ोके परदा के सामने म सात बार यहोवा के आघू म छिंचय। <verse eid="LEV 4:17" /><verse number="18" style="v" sid="LEV 4:18" />ओह ओ लहू म ले थोरकून लेके बेदी के ओ सींगमन म लगावय, जऊन ह यहोवा के आघू म मिलापवाला तम्बू म हवय। बाकि बांचे जम्मो लहू ला ओह होम-बलिदान के बेदी के खाल्हे म रितो देवय, जऊन ह मिलापवाला तम्बू के मुंहटा म हवय। <verse eid="LEV 4:18" /><verse number="19" style="v" sid="LEV 4:19" />ओह बछवा के जम्मो चरबी ला निकाल लेवय अऊ ओ चरबी ला बेदी म जला देवय, <verse eid="LEV 4:19" /><verse number="20" style="v" sid="LEV 4:20" />अऊ ओह ये बछवा के संग ठीक वइसनेच करय, जइसने पाप-बलिदान के बछवा ला करे रिहिस। ये किसम ले पुरोहित ह इसरायली समाज बर प्रायस्चित करय, अऊ समाज के पाप छेमा करे जाही। <verse eid="LEV 4:20" /><verse number="21" style="v" sid="LEV 4:21" />तब ओह बछवा ला डेरा के बाहिर ले जावय अऊ ओला वइसने ही जलावय, जइसने ओह पहिली बछवा ला जलाय रिहिस। येह समाज बर पाप-बलिदान अय।<verse eid="LEV 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 4:22" />“ ‘जब कोनो अगुवा ह अनजाने म पाप करथे अऊ ओ काम करथे, जऊन ह यहोवा, ओकर परमेसर के हुकूम के बिरूध अय, पर जब ओह अपन अपराध ला महसूस करथे <verse eid="LEV 4:22" /><verse number="23" style="v" sid="LEV 4:23" />अऊ ओला अपन करे गे पाप के पता चलथे, त ओह एक ठन निरदोस बोकरा ला बलिदान के रूप म लानय। <verse eid="LEV 4:23" /><verse number="24" style="v" sid="LEV 4:24" />ओह बोकरा के मुड़ म अपन हांथ ला रखय अऊ ओला यहोवा के आघू म ओ जगह म बलि करय, जिहां होम-बलिदान के पसु ला बलि करे जाथे। येह एक पाप-बलिदान अय। <verse eid="LEV 4:24" /><verse number="25" style="v" sid="LEV 4:25" />तब पुरोहित ह अपन अंगठी म पाप-बलिदान के पसु के थोरकून लहू ला लेवय अऊ ओला होम-बलिदान के बेदी के सींगमन म लगावय अऊ बाकि बांचे लहू ला बेदी के खाल्हे म रितो देवय। <verse eid="LEV 4:25" /><verse number="26" style="v" sid="LEV 4:26" />ओह जम्मो चरबी ला बेदी म वइसने जलावय, जइसने ओह मेल-बलिदान के चरबी ला जलाय रिहिस। ये किसम ले पुरोहित ह ओ अगुवा के पाप बर प्रायस्चित के बिधि ला पूरा करही, अऊ परमेसर ह ओकर पाप ला छेमा करही।<verse eid="LEV 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 4:27" />“ ‘यदि समाज के कोनो मनखे अनजाने म कोनो पाप करथे अऊ ओ काम करथे, जऊन ह यहोवा के हुकूम के बिरूध अय, पर जब ओह अपन अपराध ला महसूस करथे <verse eid="LEV 4:27" /><verse number="28" style="v" sid="LEV 4:28" />अऊ ओला अपन करे गे पाप के पता चलथे, त ओह अपन करे गे पाप के खातिर एक ठन निरदोस छेरी<note caller="+" style="f"><char style="fr" closed="false">4:28 </char><char style="ft" closed="false">मतलब, बरई या पठिया</char></note> बलिदान के रूप म लानय। <verse eid="LEV 4:28" /><verse number="29" style="v" sid="LEV 4:29" />ओह अपन हांथ ला ओ पाप-बलिदान के पसु के मुड़ म रखय अऊ येला होम-बलिदान करे के जगह म बलि करय। <verse eid="LEV 4:29" /><verse number="30" style="v" sid="LEV 4:30" />तब पुरोहित ह अपन अंगठी म ओकर थोरकून लहू ला लेवय अऊ ओला होम-बलिदान के बेदी के सींगमन म लगावय अऊ बाकि बांचे लहू ला बेदी के खाल्हे म रितो देवय। <verse eid="LEV 4:30" /><verse number="31" style="v" sid="LEV 4:31" />ओ मनखे ह जम्मो चरबी ला अलग करय, जइसने कि मेल-बलिदान के पसु के चरबी ला अलग करे जाथे, अऊ पुरोहित ह ओला बेदी म जला देवय ताकि ओह यहोवा बर सुख-देवइया एक सुगंध होवय। ये किसम ले पुरोहित ह ओ मनखे के पाप बर प्रायस्चित के बिधि ला पूरा करही, अऊ परमेसर ह ओकर पाप ला छेमा करही।<verse eid="LEV 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 4:32" />“ ‘कहूं कोनो अपन पाप-बलिदान बर मेढ़ा-पीला के झुंड म ले कोनो पसु ला लानथे, त ओह एक निरदोस भेड़ी-पीला ला लानय। <verse eid="LEV 4:32" /><verse number="33" style="v" sid="LEV 4:33" />ओह ओ भेड़ी-पीला के मुड़ म अपन हांथ ला रखय अऊ ओला पाप-बलिदान बर ओ जगह म बलि करय, जिहां होम-बलिदान के पसु ला बलि करे जाथे। <verse eid="LEV 4:33" /><verse number="34" style="v" sid="LEV 4:34" />तब पुरोहित ह अपन अंगठी म पाप-बलिदान के पसु के थोरकून लहू ला लेवय अऊ ओला होम-बलिदान के बेदी के सींगमन म लगावय अऊ बाकि बांचे लहू ला बेदी के खाल्हे म रितो देवय। <verse eid="LEV 4:34" /><verse number="35" style="v" sid="LEV 4:35" />तब ओ मनखे ह जम्मो चरबी ला अलग करय, जइसने कि मेल-बलिदान के मेढ़ा-पीला के चरबी ला अलग करे जाथे, अऊ पुरोहित ह ओला बेदी म यहोवा ला चघाय जेवन-बलिदान के ऊपर जलावय। ये किसम ले पुरोहित ह ओ मनखे दुवारा करे गे पाप ले प्रायस्चित के बिधि ला पूरा करय, अऊ परमेसर ह ओकर पाप ला छेमा करही।<verse eid="LEV 4:35" /></para>
  <chapter eid="LEV 4" />
  <chapter number="5" style="c" sid="LEV 5" />
  <para style="p">
    <verse number="1" style="v" sid="LEV 5:1" />“ ‘कहूं कोनो मनखे ह कोनो घटना ला देखे रहिथे या ओ घटना ला जानत रहिथे, पर जब गवाह के रूप म ओकर ले ओ घटना के बारे म पुछे जाथे, अऊ यदि ओह कुछू नइं बतावय, त ओह पाप करथे, अऊ ओला जिम्मेदार ठहिराय जाही।<verse eid="LEV 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="LEV 5:2" />“ ‘कहूं कोनो मनखे ला पता चलथे कि ओमन दोसी अंय—यदि ओमन असुध चीज ला अनजाने म छू लेथें (चाहे असुध जंगली पसु के लास या घरेलू-पसु के लास होवय, या भुइयां म रेंगइया कोनो असुध जीव-जन्तु के लास होवय) अऊ ओ मनखेमन नइं जानंय कि ओमन संस्कारिक रूप ले असुध हो गे हवंय, पर जब ओमन अपन दोस ला जानथें; <verse eid="LEV 5:2" /><verse number="3" style="v" sid="LEV 5:3" />या कहूं ओमन मनखे के कोनो असुध चीज ला अनजाने म छूथें (कोनो घलो चीज, जऊन ह ओला असुध करथे), पर जब ओमन ला ये बात के पता चलथे अऊ अपन गलती ला महसूस करथें; <verse eid="LEV 5:3" /><verse number="4" style="v" sid="LEV 5:4" />या कहूं कोनो मन बिगर सोचे-बिचारे अनजाने म कोनो काम ला करे के किरिया खाथें, चाहे ओ भलई के काम हो या बुरई के (दूनों बात म लापरवाही से किरिया खाथें), पर जब ओमन ला ये बात के पता चलथे अऊ ओमन अपन गलती ला महसूस करथें। <verse eid="LEV 5:4" /><verse number="5" style="v" sid="LEV 5:5" />जब कोनो मनखे ला पता चलथे कि ये बातमन के कोनो एक ठन म घलो ओह दोसी अय, त ओह जऊन गलती करके पाप करे हवय, ओला मान लेवय। <verse eid="LEV 5:5" /><verse number="6" style="v" sid="LEV 5:6" />जऊन पाप ओह करे हवय, ओकर दंड के रूप म, ओह बरदी म ले एक ठन मेढ़ी-पीला या छेरी, यहोवा करा पाप-बलिदान<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सुधिकरन-बलिदान</char></note> के रूप म लानय; अऊ पुरोहित ह ओकर पाप के खातिर पछताप के बिधि ला पूरा करय।<verse eid="LEV 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 5:7" />“ ‘पर कहूं कोनो भेड़ी-पीला नइं चढ़ा सकय, त अपन पाप के दंड के रूप म, ओह यहोवा करा दू ठन पंड़की या दू ठन परेवा पीला ले आवय—एक ठन ला पाप-बलिदान बर अऊ दूसर ला होम-बलिदान करे बर। <verse eid="LEV 5:7" /><verse number="8" style="v" sid="LEV 5:8" />ओह ओमन ला पुरोहित करा ले आवय अऊ पुरोहित ह पहिले एक ठन ला पाप-बलिदान बर चघावय। ओह ओ चिरई के घेंच ले ओकर मुड़ ला मुरकेट देवय, पर ओला पूरा अलग झन करय, <verse eid="LEV 5:8" /><verse number="9" style="v" sid="LEV 5:9" />अऊ ओह ओ पाप-बलिदान के लहू म ले थोरकून लेके बेदी के बगल म छिंचय; बाकि बांचे लहू ला बेदी के खाल्हे म रितो देवय। येह एक पाप-बलिदान अय। <verse eid="LEV 5:9" /><verse number="10" style="v" sid="LEV 5:10" />पुरोहित ह तब दूसर चिरई ला बताय गे बिधि के मुताबिक होम-बलिदान के रूप म चघावय अऊ पुरोहित ह ओकर करे गे पाप बर प्रायस्चित के बिधि ला पूरा करय, अऊ परमेसर ह ओकर पाप ला छेमा करही।<verse eid="LEV 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 5:11" />“ ‘पर कहूं ओह दू ठन पंड़की या परेवा के दू ठन पीला घलो नइं दे सकय, त ओह अपन पाप के खातिर चघाय बर एपा<note caller="+" style="f"><char style="fr" closed="false">5:11 </char><char style="ft" closed="false">1.6 किलोग्राम</char></note> के दसवां भाग बहुंत चिक्कन पीसान पाप-बलिदान के रूप म ले आवय। ओह ओमा जैतून तेल या धूप झन डालय, काबरकि ओह एक पाप-बलिदान अय। <verse eid="LEV 5:11" /><verse number="12" style="v" sid="LEV 5:12" />ओह ओला पुरोहित करा लानय अऊ पुरोहित ह ओमा ले अपन मुठा भरके सुरता-देवइया हिस्सा के रूप म लेवय अऊ ओला बेदी म यहोवा ला चघाय अन्न-बलिदान के ऊपर जलावय। येह एक पाप-बलिदान अय। <verse eid="LEV 5:12" /><verse number="13" style="v" sid="LEV 5:13" />ये किसम ले, पुरोहित ह ओकर खातिर, ओकर दुवारा करे गय येमा के कोनो पाप बर प्रायस्चित के बिधि ला पूरा करही, अऊ परमेसर ह ओकर पाप ला छेमा करही। बाकि बांचे बलिदान ह पुरोहित के होही, जइसने कि अन्न-बलिदान के बिधि म होथे।’ ”<verse eid="LEV 5:13" /></para>
  <para style="s1">दोस-बलिदान</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 5:14" />फेर यहोवा ह मूसा ला कहिस: <verse eid="LEV 5:14" /><verse number="15" style="v" sid="LEV 5:15" />“कहूं कोनो यहोवा के कोनो पबितर चीज के संबंध म अनजाने म पाप करथे, अऊ यहोवा के नजर म बेईमान ठहिरथे, त ओमन भेड़-बकरी के झुंड ले, दंड के रूप म एक ठन निरदोस मेढ़ा यहोवा करा लानंय अऊ पबितर-स्थान के सेकेल<note caller="+" style="f"><char style="fr" closed="false">5:15 </char><char style="ft" closed="false">लगभग 12 ग्राम</char></note> के मुताबिक, ओह चांदी म उचित दाम के होवय। येह एक दोस-बलिदान अय। <verse eid="LEV 5:15" /><verse number="16" style="v" sid="LEV 5:16" />जऊन पबितर चीज के बिसय म ओमन पाप करे हवंय, ओमन ओकर भरपई जरूर करंय; दंड के रूप म, ओ चीज के दाम म पांचवां भाग अऊ बढ़ाके ओमन ओ जम्मो ला पुरोहित ला देवंय। पुरोहित ह ओमन बर मेढ़ा ला दोस-बलिदान के रूप म चघाके प्रायस्चित के बिधि ला पूरा करही, अऊ परमेसर ह ओमन के पाप ला छेमा करही।<verse eid="LEV 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 5:17" />“कहूं कोनो पाप करथे अऊ ओ काम करथे, जऊन ह यहोवा के हुकूम के बिरूध अय, चाहे ओह ओ काम ला अनजाने म करय, तभो ले ओह दोसी अय अऊ ओह ओ काम बर जिम्मेदार ठहिरही। <verse eid="LEV 5:17" /><verse number="18" style="v" sid="LEV 5:18" />एकरसेति ओह दोस-बलिदान के रूप म बरदी म ले एक ठन निरदोस मेढ़ा पुरोहित करा लानय अऊ ओह उचित दाम के होवय। ये किसम ले, पुरोहित ह ओकर बर, ओकर दुवारा अनजाने म करे गय गलती खातिर प्रायस्चित के बिधि ला पूरा करही, अऊ परमेसर ह ओकर पाप ला छेमा करही। <verse eid="LEV 5:18" /><verse number="19" style="v" sid="LEV 5:19" />येह एक दोस-बलिदान अय; ओह यहोवा के बिरूध म गलत करके दोसी ठहिरे हवय।”<verse eid="LEV 5:19" /></para>
  <chapter eid="LEV 5" />
  <chapter number="6" style="c" sid="LEV 6" />
  <para style="p">
    <verse number="1" style="v" sid="LEV 6:1" />फेर यहोवा ह मूसा ला कहिस: <verse eid="LEV 6:1" /><verse number="2" style="v" sid="LEV 6:2" />“कहूं कोनो मनखे ह पाप करथे अऊ यहोवा के नजर म बेईमान ठहिरथे, याने कि अपन परोसी ला धोखा देथे या ओकर सामान के गलत उपयोग करथे या ओकर सामान के चोरी करथे, या अपन परोसी ला ठगथे, <verse eid="LEV 6:2" /><verse number="3" style="v" sid="LEV 6:3" />या ओह कोनो गंवाय चीज ला पाके ओकर बिसय म लबारी मारथे, या मनखेमन के करे गे कोनो पाप के बारे म झूठ-मूठ के किरिया खाथे— <verse eid="LEV 6:3" /><verse number="4" style="v" sid="LEV 6:4" />जब ओह येमा के कोनो घलो पाप करथे अऊ अपन दोस ला महसूस करथे, त जरूरी अय कि जऊन चीज ला ओह चोराय रिहिस या लूटे रिहिस, या ओकर भरोसा म रखे चीज ला ले लेय रिहिस, या ओ गंवाय चीज जऊन ला ओह पाय रिहिस, <verse eid="LEV 6:4" /><verse number="5" style="v" sid="LEV 6:5" />या कोनो चीज जेकर बारे म झूठ-मूठ के किरिया खाय रिहिस, ओ जम्मो चीज के पूरा भरपई करय, अऊ ओ चीज के जऊन कीमत होही, ओकर पांचवां भाग ओमा जोड़के ओकर मालिक ला ओ जम्मो चीज ओ दिन दे देवय, जऊन दिन ओह अपन दोस-बलिदान चघावय। <verse eid="LEV 6:5" /><verse number="6" style="v" sid="LEV 6:6" />अऊ दंड के रूप म, यहोवा ला चघाय बर ओह अपन दोस-बलिदान पुरोहित करा लानय, अऊ ये दोस-बलिदान बरदी म ले एक ठन निरदोस मेढ़ा होवय अऊ ओह उचित दाम के होवय। <verse eid="LEV 6:6" /><verse number="7" style="v" sid="LEV 6:7" />ये किसम ले, पुरोहित ह ओकर बर यहोवा के आघू म प्रायस्चित के बिधि ला पूरा करही, अऊ जऊन घलो काम ला करके ओह दोसी ठहिरे होही, परमेसर ह ओला ओकर बर छेमा करही।”<verse eid="LEV 6:7" /></para>
  <para style="s1">होम-बलिदान</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 6:8" />फेर यहोवा ह मूसा ला कहिस: <verse eid="LEV 6:8" /><verse number="9" style="v" sid="LEV 6:9" />“हारून अऊ ओकर बेटामन ला ये हुकूम दे: ‘होम-बलिदान करे बर ये नियम अय: होम-बलिदान ह बेदी के चूल्हा म रात भर, बिहनियां होवत तक रहय, अऊ बेदी म के आगी ह बरत रहय। <verse eid="LEV 6:9" /><verse number="10" style="v" sid="LEV 6:10" />पुरोहित ह तब अपन मलमल के ओनहा ला पहिरय अऊ अपन देहें म मलमल के कच्छा घलो पहिरय अऊ बेदी म जलाय होम-बलिदान के राख ला उठाके बेदी के बाजू म रखय। <verse eid="LEV 6:10" /><verse number="11" style="v" sid="LEV 6:11" />तब ओह अपन ओनहा ला उतारके आने ओनहा पहिरय, अऊ राख ला डेरा के बाहिर अइसन जगह म ले जावय, जऊन ह बिधि के मुताबिक साफ हवय। <verse eid="LEV 6:11" /><verse number="12" style="v" sid="LEV 6:12" />बेदी के आगी ह बरत रहय; येह झन बुतावय। पुरोहित ह रोज बिहनियां ओमा लकरी डालय अऊ होम-बलिदान ला आगी म सही ढंग ले रखय अऊ ओकर ऊपर मेल-बलिदान के चरबी ला जलावय। <verse eid="LEV 6:12" /><verse number="13" style="v" sid="LEV 6:13" />बेदी म हमेसा आगी बरतेच रहय; येह कभू झन बुतावय।<verse eid="LEV 6:13" /></para>
  <para style="s1">अन्न-बलिदान</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 6:14" />“ ‘अन्न-बलिदान करे बर ये नियम अय: हारून के बेटामन ओ बलिदान ला बेदी के आघू म यहोवा करा लानंय। <verse eid="LEV 6:14" /><verse number="15" style="v" sid="LEV 6:15" />पुरोहित ह ओ अन्न-बलिदान म ले अपन मुठा भरके बहुंत चिक्कन पीसान अऊ थोरकून जैतून तेल अऊ संग म जम्मो धूप ला लेवय, अऊ सुरता-देवइया हिस्सा ला बेदी ऊपर जलावय, जेह यहोवा बर सुख-देवइया एक सुगंध होही। <verse eid="LEV 6:15" /><verse number="16" style="v" sid="LEV 6:16" />ओमा के बाकि बांचे चीज ला हारून अऊ ओकर बेटामन खावंय। पर येला ओमन पबितर-स्थान के छेत्र म बिगर खमीर के खावंय; ओमन येला मिलापवाला तम्बू के अंगना म खावंय। <verse eid="LEV 6:16" /><verse number="17" style="v" sid="LEV 6:17" />येला खमीर के संग झन पकाय जावय; मोला चघाय गे जेवन-बलिदान के ओमन के बांटा के रूप म, मेंह येला दे हवंव। येह पाप-बलिदान अऊ दोस-बलिदान सहीं महा पबितर अय। <verse eid="LEV 6:17" /><verse number="18" style="v" sid="LEV 6:18" />हारून के बंस म के कोनो घलो पुरूस येला खा सकत हें, तुम्हर अवइया जम्मो पीढ़ी बर, यहोवा ला चघाय गे जेवन-बलिदान म ले, येह हमेसा ओमन के बांटा होही। जऊन कुछू घलो ओ बलिदान के चीजमन ला छू लेथे, ओह पबितर हो जाही।<note caller="+" style="f"><char style="fr" closed="false">6:18 </char><char style="ft" closed="false">जऊन कोनो ओला छूथे, ओह जरूर पबितर होवय</char></note>’ ”<verse eid="LEV 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 6:19" />यहोवा ह मूसा ला ये घलो कहिस, <verse eid="LEV 6:19" /><verse number="20" style="v" sid="LEV 6:20" />“जऊन दिन हारून अऊ ओकर बेटामन म ले काकरो अभिसेक करे जावय, ओ दिन ओह अपन बेटामन के संग यहोवा करा ये बलिदान लेके आवय: एपा के दसवां हिस्सा<note caller="+" style="f"><char style="fr" closed="false">6:20 </char><char style="ft" closed="false">लगभग 1.6 किलोग्राम</char></note> के बरोबर बहुंत चिक्कन पीसान नियमित अन्न-बलिदान के रूप म, आधा बिहनियां अऊ आधा संझा के बेरा चघावय। <verse eid="LEV 6:20" /><verse number="21" style="v" sid="LEV 6:21" />येला तेल के संग तवा म चुरोय जावय; येला बने करके मिलाय जावय अऊ ये अन्न-बलिदान ला कुटा-कुटा करके चघावय; येह यहोवा बर सुख-देवइया एक सुगंध होही। <verse eid="LEV 6:21" /><verse number="22" style="v" sid="LEV 6:22" />ओकर जऊन बेटा ह अभिसिक्त पुरोहित के रूप म ओकर जगह ला लीही, ओही ह ओ बलिदान ला तियार करय। येह यहोवा के हमेसा के बांटा अय अऊ येला पूरा जलाय जावय। <verse eid="LEV 6:22" /><verse number="23" style="v" sid="LEV 6:23" />पुरोहित के हर एक अन्न-बलिदान ला पूरा जलाय जावय; येला झन खाय जावय।”<verse eid="LEV 6:23" /></para>
  <para style="s1">पाप-बलिदान</para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 6:24" />फेर यहोवा ह मूसा ला कहिस, <verse eid="LEV 6:24" /><verse number="25" style="v" sid="LEV 6:25" />“हारून अऊ ओकर बेटामन ला कह: ‘पाप-बलिदान करे के नियम ये अय: पाप-बलिदान के पसु ला यहोवा के आघू म ओही जगह म बलि करे जावय, जऊन जगह म होम-बलिदान के पसु ला बलि करे जाथे। येह महा पबितर अय। <verse eid="LEV 6:25" /><verse number="26" style="v" sid="LEV 6:26" />जऊन पुरोहित ह पाप-बलिदान ला चघाथे, ओही ह ओला खावय। ओला पबितर-स्थान के छेत्र म याने कि मिलापवाला तम्बू के अंगना म खाय जावय। <verse eid="LEV 6:26" /><verse number="27" style="v" sid="LEV 6:27" />जऊन कुछू घलो ओकर मांस ला छू लेथे, ओह पबितर हो जाही, अऊ यदि लहू के कोनो छींटा ह ओनहा म लग जावय, त ओला पबितर-स्थान के छेत्र म धोय जावय। <verse eid="LEV 6:27" /><verse number="28" style="v" sid="LEV 6:28" />जऊन माटी के बरतन म ओ मांस ला रांधे जाथे, ओला टोर दिये जावय; पर कहूं ओ मांस ला कांस के बरतन म रांधे जाथे, त बरतन ला मांजके पानी म धोय जावय। <verse eid="LEV 6:28" /><verse number="29" style="v" sid="LEV 6:29" />पुरोहित परिवार के कोनो घलो मरद ओला खा सकत हें; येह महा पबितर अय। <verse eid="LEV 6:29" /><verse number="30" style="v" sid="LEV 6:30" />पर जऊन पाप-बलिदान के पसु के लहू ला मिलापवाला तम्बू के भीतर पबितर स्थान म प्रायस्चित करे बर लाय जाथे, ओकर मांस ला झन खाय जावय; ओला आगी म जला दिये जावय।<verse eid="LEV 6:30" /></para>
  <chapter eid="LEV 6" />
  <chapter number="7" style="c" sid="LEV 7" />
  <para style="s1">दोस-बलिदान</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 7:1" />“ ‘दोस-बलिदान करे के ये नियम अय, अऊ ये बलिदान ह महा पबितर अय: <verse eid="LEV 7:1" /><verse number="2" style="v" sid="LEV 7:2" />जऊन जगह म होम-बलिदान के पसु ला बलि करे जाथे, ओही जगह म दोस-बलिदान के पसु ला घलो बलि करे जावय अऊ ओकर लहू ला बेदी के चारों कोति छिंचे जावय। <verse eid="LEV 7:2" /><verse number="3" style="v" sid="LEV 7:3" />ओमा के जम्मो चरबी ला चघाय जावय: याने कि चरबीवाला पुंछी अऊ ओ चरबी, जऊन ह पेट के अंगमन ला तोपे रहिथे, <verse eid="LEV 7:3" /><verse number="4" style="v" sid="LEV 7:4" />दूनों गुरदा अऊ ओमन के ऊपर के चरबी, जऊन ह कनिहां के तीर म रहिथे अऊ करेजा के निकले भाग, जऊन ला गुरदामन समेत अलग करे जावय। <verse eid="LEV 7:4" /><verse number="5" style="v" sid="LEV 7:5" />पुरोहित ह ओमन ला बेदी म यहोवा ला चघाय जेवन-बलिदान के रूप म जला देवय। येह एक दोस-बलिदान अय। <verse eid="LEV 7:5" /><verse number="6" style="v" sid="LEV 7:6" />पुरोहित के परिवार के कोनो घलो मरद येला खा सकत हे, पर येला पबितर-स्थान म खाय जावय। येह महा पबितर अय।<verse eid="LEV 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 7:7" />“ ‘पाप-बलिदान<note caller="+" style="f"><char style="fr" closed="false">7:7 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सुधिकरन-बलिदान</char><char style="ft" closed="false">; <char style="xt" link-href="LEV 7:37"><ref loc="LEV 7:37">पद 37</ref></char> म घलो</char></note> अऊ दोस-बलिदान दूनों म ओहीच कानून लागू होथे: येमन ओ पुरोहित के होथें, जऊन ह ओमन के संग प्रायस्चित के बिधि ला पूरा करथे। <verse eid="LEV 7:7" /><verse number="8" style="v" sid="LEV 7:8" />जऊन पुरोहित ह काकरो बर होम-बलिदान चघाथे, ओ पुरोहित ह बलिदान के पसु के खाल ला अपन बर रख सकत हे। <verse eid="LEV 7:8" /><verse number="9" style="v" sid="LEV 7:9" />हर अन्न-बलिदान, जऊन ह चूल्हा के आंच म सेंके जाथे या कढ़ई या तवा म पकाय जाथे, ओह ओहीच पुरोहित के होही, जऊन ह ओला चघाथे, <verse eid="LEV 7:9" /><verse number="10" style="v" sid="LEV 7:10" />अऊ हर एक अन्न-बलिदान, चाहे ओह जैतून तेल म सनाय होवय या सूखा होवय, ओह हारून के जम्मो बेटामन ला बरोबर-बरोबर बांटा म मिलय।<verse eid="LEV 7:10" /></para>
  <para style="s1">मेल-बलिदान</para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 7:11" />“ ‘जब कोनो मनखे यहोवा ला मेल-बलिदान चघाथे, त ओकर नियम ये अय:<verse eid="LEV 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 7:12" />“ ‘कहूं ओह येला धनबाद देय बर चघाथे, त ये धनबाद-बलिदान के संग, ओह जैतून तेल म सनाय बिगर खमीर के बने मोटा-मोटा रोटी, बिगर खमीर के बने तेल म चुपरे पातर-पातर रोटी, अऊ बने ढंग से गुंथाय अऊ तेल म सनाय बहुंत चिक्कन पीसान के बने मोटा-मोटा रोटी चघावय। <verse eid="LEV 7:12" /><verse number="13" style="v" sid="LEV 7:13" />धनबाद के मेल-बलिदान के संग, ओह खमीर मिले मोटा-मोटा रोटी के चढ़ावा चघावय। <verse eid="LEV 7:13" /><verse number="14" style="v" sid="LEV 7:14" />ओह हर किसम के रोटी म ले एक-एक ठन रोटी बलिदान के रूप म लानय; येह यहोवा के हिस्सा होही; येह ओ पुरोहित के अय, जऊन ह मेल-बलिदान के लहू ला बेदी के चारों कोति छिंचथे। <verse eid="LEV 7:14" /><verse number="15" style="v" sid="LEV 7:15" />धनबाद के मेल-बलिदान के मांस ला ओहीच दिन खाय जावय, जऊन दिन ओला चघाय जाथे; बिहनियां होवत तक ओमा ले कुछू झन बांचय।<verse eid="LEV 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 7:16" />“ ‘पर, कहूं, ओकर बलिदान ह बदना के कारन या स्वेच्छा-बलिदान होवय, त जऊन दिन बलिदान चघाय जावय, ओहीच दिन ओला खाय जावय, पर कुछू बांच जावय, त ओला ओकर दूसर दिन खाय जावय। <verse eid="LEV 7:16" /><verse number="17" style="v" sid="LEV 7:17" />यदि बलिदान के कुछू मांस ह तीसर दिन तक बांचे रहिथे, त ओला आगी म जला दिये जावय। <verse eid="LEV 7:17" /><verse number="18" style="v" sid="LEV 7:18" />कहूं मेल-बलिदान म के कोनो मांस ला तीसर दिन खाय जाथे, त ओ बलिदान चघोइया ला गरहन नइं करे जावय। येला ओकर हित म नइं गने जावय, काबरकि येह असुध हो गे हवय; जऊन मनखे ह येमा के कुछू चीज ला खाथे, ओला ओकर बर जिम्मेदार ठहिराय जाही।<verse eid="LEV 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 7:19" />“ ‘यदि मांस ह कोनो अइसने चीज ले छू जाथे, जऊन ह बिधि के मुताबिक असुध अय, त ओ मांस ला झन खाय जावय; ओला आगी म जला दिये जावय। दूसर मांस ला बिधि के मुताबिक सुध मनखे ह खा सकथे। <verse eid="LEV 7:19" /><verse number="20" style="v" sid="LEV 7:20" />पर कहूं कोनो मनखे असुध होके यहोवा ला चघाय गे मेल-बलिदान के मांस ला खाथे, त ओह अपन मनखेमन के समाज ले अलग करे जावय। <verse eid="LEV 7:20" /><verse number="21" style="v" sid="LEV 7:21" />अऊ कहूं कोनो असुध चीज ला छूथे—चाहे मनखे के असुधता होवय या असुध पसु होवय या भुइयां म रेंगइया कोनो असुध जीव होवय—अऊ तब यहोवा ला चघाय गे मेल-बलिदान के मांस म ले खाथे, त ओ मनखे घलो अपन मनखेमन के समाज ले अलग करे जावय।’ ”<verse eid="LEV 7:21" /></para>
  <para style="s1">लहू अऊ चरबी खवई मना ए</para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 7:22" />फेर यहोवा ह मूसा ला कहिस, <verse eid="LEV 7:22" /><verse number="23" style="v" sid="LEV 7:23" />“इसरायलीमन ला कह: ‘तुमन कोनो पसु के चरबी ला झन खावव, भेड़ होवय या बोकरा। <verse eid="LEV 7:23" /><verse number="24" style="v" sid="LEV 7:24" />जऊन पसु ह अपनआप मर गे हे या जऊन पसु ला कोनो जंगली पसु चीर-फार दे हे, ओकर चरबी ला कोनो आने काम म लाय जा सकत हे, पर तुमन ओला झन खाहू। <verse eid="LEV 7:24" /><verse number="25" style="v" sid="LEV 7:25" />जऊन मनखे ह ओ पसु के चरबी ला खाथे, जेकर ले यहोवा बर जेवन-बलिदान चघाय जा सकथे, त ओ मनखे ह अपन मनखेमन ले अलग करे जावय। <verse eid="LEV 7:25" /><verse number="26" style="v" sid="LEV 7:26" />अऊ तुमन जिहां कहूं घलो रहव, कोनो चिरई या पसु के लहू ला झन खावव। <verse eid="LEV 7:26" /><verse number="27" style="v" sid="LEV 7:27" />ओ मनखे, जऊन ह लहू ला खाथे, ओह अपन मनखेमन ले अलग करे जावय।’ ”<verse eid="LEV 7:27" /></para>
  <para style="s1">पुरोहितमन के बांटा</para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 7:28" />फेर यहोवा ह मूसा ला कहिस, <verse eid="LEV 7:28" /><verse number="29" style="v" sid="LEV 7:29" />“इसरायलीमन ला कह: ‘ओ मनखे, जऊन ह यहोवा बर मेल-बलिदान लानथे, ओह मेल-बलिदान के एक भाग ला यहोवा बर अपन बलिदान के रूप म लानय। <verse eid="LEV 7:29" /><verse number="30" style="v" sid="LEV 7:30" />ओह अपनेच हांथ ले यहोवा बर जेवन-बलिदान चघावय; ओह चरबी ला छाती के समेत लानय, अऊ छाती ला हलाय-बलिदान के रूप म यहोवा के आघू म हलावय। <verse eid="LEV 7:30" /><verse number="31" style="v" sid="LEV 7:31" />पुरोहित ह चरबी ला बेदी म जलावय, पर छाती ह हारून अऊ ओकर बेटामन के अय। <verse eid="LEV 7:31" /><verse number="32" style="v" sid="LEV 7:32" />तुमन अपन मेल-बलिदान के जेवनी जांघ ला पुरोहित ला ओकर हिस्सा के रूप म देवव। <verse eid="LEV 7:32" /><verse number="33" style="v" sid="LEV 7:33" />हारून के जऊन बेटा ह मेल-बलिदान के लहू अऊ चरबी ला चघाथे, ओह जेवनी जांघ ला अपन बांटा के रूप म रखय। <verse eid="LEV 7:33" /><verse number="34" style="v" sid="LEV 7:34" />इसरायलीमन के मेल-बलिदान म ले, हलाय गय छाती अऊ चघाय गय जांघ ला, मेंह लेय हंव अऊ येमन ला हारून पुरोहित अऊ ओकर बेटामन ला देय हंव कि इसरायलीमन कोति ले, येह हमेसा ओमन के बांटा होवय।’ ”<verse eid="LEV 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 7:35" />येह यहोवा ला चघाय गे जेवन-बलिदान के ओ बांटा अय, जऊन ला हारून अऊ ओकर बेटामन ला ओ दिन दिये गीस, जऊन दिन ओमन पुरोहित के रूप म यहोवा के सेवा करे बर लाने गीन। <verse eid="LEV 7:35" /><verse number="36" style="v" sid="LEV 7:36" />जऊन दिन ओमन के अभिसेक करे गीस, ओहीच दिन यहोवा ह हुकूम दीस कि इसरायलीमन येला पीढ़ी दर पीढ़ी ओमन ला ओमन के बांटा के रूप म हमेसा देवंय।<verse eid="LEV 7:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LEV 7:37" />येमन होम-बलिदान, अन्न-बलिदान, पाप-बलिदान, दोस-बलिदान, अभिसेक-बलिदान अऊ मेल-बलिदान के नियम अंय, <verse eid="LEV 7:37" /><verse number="38" style="v" sid="LEV 7:38" />जेला यहोवा ह मूसा ला सीनय के सुन्ना जगह म सीनय के पहाड़ ऊपर ओ दिन दीस, जऊन दिन ओह इसरायलीमन ला यहोवा करा ओमन के बलिदान लाने के हुकूम दीस।<verse eid="LEV 7:38" /></para>
  <chapter eid="LEV 7" />
  <chapter number="8" style="c" sid="LEV 8" />
  <para style="s1">हारून अऊ ओकर बेटामन के अभिसेक</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 8:1" />फेर यहोवा ह मूसा ला कहिस, <verse eid="LEV 8:1" /><verse number="2" style="v" sid="LEV 8:2" />“हारून अऊ ओकर बेटामन ला, ओमन के ओनहा ला, अभिसेक के तेल ला, पाप-बलिदान बर एक ठन निरदोस बछवा ला, दू ठन निरदोस मेढ़ा अऊ ओ टुकनी, जऊन म बिगर खमीर के बने रोटी हवय, ये जम्मो ला ले आन, <verse eid="LEV 8:2" /><verse number="3" style="v" sid="LEV 8:3" />अऊ इसरायल के पूरा सभा ला मिलापवाला तम्बू के मुंहटा म बला ले।” <verse eid="LEV 8:3" /><verse number="4" style="v" sid="LEV 8:4" />मूसा ह यहोवा के हुकूम के मुताबिक करिस, अऊ सभा ह मिलापवाला तम्बू के मुंहटा म जूर गीस।<verse eid="LEV 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 8:5" />मूसा ह सभा के मनखेमन ला कहिस, “जऊन काम करे के हुकूम यहोवा ह देय हवय, ओह ये अय।” <verse eid="LEV 8:5" /><verse number="6" style="v" sid="LEV 8:6" />तब मूसा ह हारून अऊ ओकर बेटामन ला सामने लानके ओमन ला पानी ले नहवाईस। <verse eid="LEV 8:6" /><verse number="7" style="v" sid="LEV 8:7" />ओह हारून ला अंगरखा पहिराईस, अऊ ओकर कनिहां म कमरबंध लपेटिस, ओला बागा पहिराके ओकर ऊपर एपोद पहिराईस। ओह सुघरता से बुने गय कमरबंध ले एपोद ला कसके बांध दीस। <verse eid="LEV 8:7" /><verse number="8" style="v" sid="LEV 8:8" />तब ओह छातीबंध ला ओकर ऊपर लगाके छातीबंध म ऊरीम अऊ तुम्मीम लगा दीस। <verse eid="LEV 8:8" /><verse number="9" style="v" sid="LEV 8:9" />फेर ओह ओकर मुड़ म पागा घलो पहिराईस अऊ पागा के आघू म सोन के पट्टी याने कि पबितर मुकुट ला लगाईस, जइसने कि यहोवा ह मूसा ला हुकूम देय रिहिस।<verse eid="LEV 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 8:10" />तब मूसा ह अभिसेक के तेल ला लीस, अऊ पबितर-तम्बू अऊ जऊन कुछू ओमा रिहिस, ओ जम्मो ला अभिसेक करके ओमन के संस्कार करिस। <verse eid="LEV 8:10" /><verse number="11" style="v" sid="LEV 8:11" />ओह थोरकून तेल लेके बेदी के ऊपर सात बार छिंचिस, बेदी अऊ ओकर जम्मो सामान ला अऊ तसला अऊ ओकर खुरामन ला घलो पबितर करे बर ओमन के अभिसेक करिस। <verse eid="LEV 8:11" /><verse number="12" style="v" sid="LEV 8:12" />ओह अभिसेक के कुछू तेल ला हारून के मुड़ म रितोईस अऊ ओला पबितर करे बर ओकर अभिसेक करिस। <verse eid="LEV 8:12" /><verse number="13" style="v" sid="LEV 8:13" />तब ओह हारून के बेटामन ला आघू म लानके ओमन ला अंगरखा पहिराईस, कनिहां म कमरबंध बांधिस अऊ मुड़ म टोपी पहिराईस जइसने कि यहोवा ह मूसा ला हुकूम देय रिहिस।<verse eid="LEV 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 8:14" />ओह तब पाप-बलिदान बर बछवा ला लानिस, अऊ हारून अऊ ओकर बेटामन पाप-बलिदान के बछवा के मुड़ म अपन हांथ रखिन। <verse eid="LEV 8:14" /><verse number="15" style="v" sid="LEV 8:15" />मूसा ह ओ बछवा ला बलि करिस, अऊ अपन अंगठी म बछवा के थोरकून लहू लेके बेदी के जम्मो सींगमन म लगाईस, अऊ बेदी ला सुध करिस। बाकि बांचे लहू ला ओह बेदी के खाल्हे म रितो दीस। ये किसम ले ओह प्रायस्चित करे बर बेदी ला पबितर करिस। <verse eid="LEV 8:15" /><verse number="16" style="v" sid="LEV 8:16" />मूसा ह पेट के भीतरी भाग के जम्मो चरबी ला लीस अऊ करेजा के लम्बा निकले भाग, अऊ चरबी सहित दूनों गुरदा ला घलो लीस, अऊ ओमन ला बेदी म जला दीस। <verse eid="LEV 8:16" /><verse number="17" style="v" sid="LEV 8:17" />पर बछवा अऊ ओकर खाल अऊ ओकर मांस अऊ ओकर पोटा ला डेरा के बाहिर जला दीस, जइसने कि यहोवा ह मूसा ला हुकूम देय रिहिस।<verse eid="LEV 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 8:18" />ओह तब होम-बलिदान बर मेढ़ा ला लानिस, अऊ हारून अऊ ओकर बेटामन ओ मेढ़ा के मुड़ म अपन हांथ रखिन। <verse eid="LEV 8:18" /><verse number="19" style="v" sid="LEV 8:19" />तब मूसा ह मेढ़ा ला बलि करिस अऊ ओकर लहू ला लेके बेदी के चारों मुड़ा छिंचिस। <verse eid="LEV 8:19" /><verse number="20" style="v" sid="LEV 8:20" />ओह मेढ़ा ला कुटा-कुटा करिस अऊ ओकर मुड़ अऊ कुटामन ला अऊ चरबी ला जला दीस। <verse eid="LEV 8:20" /><verse number="21" style="v" sid="LEV 8:21" />ओह पेट भीतर के चीजमन ला अऊ गोड़मन ला पानी म धोईस अऊ पूरा मेढ़ा ला बेदी म जला दीस। येह यहोवा ला चघाय बर एक होम-बलिदान, एक सुख-देवइया सुगंध, एक जेवन-बलिदान होईस, जइसने कि यहोवा ह मूसा ला हुकूम देय रिहिस।<verse eid="LEV 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 8:22" />ओह तब दूसर मेढ़ा ला याने कि अभिसेक करे के मेढ़ा ला लानिस अऊ हारून अऊ ओकर बेटामन ओ मेढ़ा के मुड़ म अपन हांथ रखिन। <verse eid="LEV 8:22" /><verse number="23" style="v" sid="LEV 8:23" />मूसा ह ओ मेढ़ा ला बलि करिस अऊ ओकर कुछू लहू ला लेके हारून के जेवनी कान ऊपर, जेवनी हांथ के अंगठा ऊपर अऊ जेवनी गोड़ के अंगठा ऊपर लगाईस। <verse eid="LEV 8:23" /><verse number="24" style="v" sid="LEV 8:24" />मूसा ह हारून के बेटामन ला घलो आघू म लानिस अऊ कुछू लहू ला ओमन के जेवनी कान ऊपर, ओमन के जेवनी हांथ के अंगठा ऊपर अऊ ओमन के जेवनी गोड़ के अंगठा ऊपर लगाईस। तब मूसा ह बांचे लहू ला बेदी के चारों मुड़ा म छिंच दीस। <verse eid="LEV 8:24" /><verse number="25" style="v" sid="LEV 8:25" />ओकर बाद, ओह चरबी, चरबीवाला पुंछी, पेट के भीतरी भाग के चरबी, करेजा के लम्बा निकले भाग, चरबी समेत दूनों गुरदा अऊ ओकर जेवनी जांघ ला लीस। <verse eid="LEV 8:25" /><verse number="26" style="v" sid="LEV 8:26" />अऊ यहोवा के आघू म माढ़े बिगर खमीर के बनाय गे टुकनी के रोटी म ले ओमा के एक गोल रोटी, जैतून तेल म सनाय एक ठन मोटा रोटी, अऊ एक ठन पातर रोटी लीस, अऊ ओह येमन ला चरबीवाले भाग अऊ जेवनी जांघ ऊपर रख दीस। <verse eid="LEV 8:26" /><verse number="27" style="v" sid="LEV 8:27" />तब ओह ये जम्मो ला हारून अऊ ओकर बेटामन के हांथ म रखिस अऊ ओमन येला यहोवा के आघू म एक हलाय-बलिदान के रूप म हलाईन। <verse eid="LEV 8:27" /><verse number="28" style="v" sid="LEV 8:28" />तब मूसा ह येला ओमन के हांथ ले लेय लीस अऊ येला होम-बलिदान के ऊपर बेदी म यहोवा बर एक सुख-देवइया सुगंध के रूप म, अभिसेक-बलिदान, एक जेवन-बलिदान करके जला दीस। <verse eid="LEV 8:28" /><verse number="29" style="v" sid="LEV 8:29" />मूसा ह छाती ला घलो लीस, जऊन ह अभिसेक मेढ़ा के ओकर बांटा रिहिस, अऊ ओला यहोवा के आघू म एक हलाय-बलिदान के रूप म हलाईस, जइसने कि यहोवा ह मूसा ला हुकूम देय रिहिस।<verse eid="LEV 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 8:30" />तब मूसा ह बेदी म ले कुछू अभिसेक के तेल अऊ कुछू लहू लीस अऊ ओला हारून अऊ ओकर ओनहामन म अऊ ओकर बेटामन अऊ ओमन के ओनहामन म छिंचिस। ये किसम ले ओह हारून अऊ ओकर ओनहामन के, अऊ ओकर बेटामन अऊ ओमन के ओनहामन के संस्कार करिस।<verse eid="LEV 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 8:31" />मूसा ह तब हारून अऊ ओकर बेटामन ला कहिस, “मिलापवाला तम्बू के प्रवेस दुवार म ओ मांस ला रांधव अऊ ओला अभिसेक-बलिदान के टुकनी के रोटी संग उहां खावव, जइसने कि परमेसर ह हुकूम देय रिहिस: ‘हारून अऊ ओकर बेटामन भेंट के चीजमन ला खावंय।’ <verse eid="LEV 8:31" /><verse number="32" style="v" sid="LEV 8:32" />तब जऊन मांस अऊ रोटी बांच जाथे, ओला जला देवंव। <verse eid="LEV 8:32" /><verse number="33" style="v" sid="LEV 8:33" />तुमन सात दिन तक मिलापवाला तम्बू के मुंहटा के बाहिर झन जावव, जब तक कि तुम्हर अभिसेक के दिन ह पूरा नइं हो जावय, काबरकि तुम्हर अभिसेक ह सात दिन तक चलही। <verse eid="LEV 8:33" /><verse number="34" style="v" sid="LEV 8:34" />आज जऊन कुछू करे गीस, येला करे के हुकूम यहोवा ह देय रिहिस, ताकि तुम्हर प्रायस्चित के बिधि पूरा होवय। <verse eid="LEV 8:34" /><verse number="35" style="v" sid="LEV 8:35" />तुम्हर बर ये जरूरी ए कि तुमन मिलापवाला तम्बू के मुंहटा म रात अऊ दिन सात दिन तक ठहिरव अऊ यहोवा जइसने कहे हवय, वइसने करव, ताकि तुमन झन मरव; काबरकि मोला अइसने ही हुकूम दिये गे हवय।”<verse eid="LEV 8:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LEV 8:36" />हारून अऊ ओकर बेटामन ओ जम्मो चीज करिन, जेकर हुकूम यहोवा ह मूसा के दुवारा देय रिहिस।<verse eid="LEV 8:36" /></para>
  <chapter eid="LEV 8" />
  <chapter number="9" style="c" sid="LEV 9" />
  <para style="s1">पुरोहितमन के सेवकई के सुरूआत</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 9:1" />आठवां दिन मूसा ह हारून अऊ ओकर बेटामन ला अऊ इसरायल के अगुवामन ला बलाईस। <verse eid="LEV 9:1" /><verse number="2" style="v" sid="LEV 9:2" />अऊ ओह हारून ला कहिस, “पाप-बलिदान बर एक ठन बिगर दोस के बछवा अऊ होम-बलिदान करे बर एक ठन बिगर दोस के मेढ़ा ला लेके यहोवा के आघू म चघा। <verse eid="LEV 9:2" /><verse number="3" style="v" sid="LEV 9:3" />तब इसरायलीमन ला ये कह: ‘तुमन पाप-बलिदान करे बर एक ठन बोकरा अऊ होम-बलिदान बर एक ठन बछवा अऊ एक ठन बिगर दोस के मेढ़ा-पीला ला ले आवव। <verse eid="LEV 9:3" /><verse number="4" style="v" sid="LEV 9:4" />अऊ यहोवा के आघू म चघाय बर मेल-बलिदान के खातिर एक ठन बछवा अऊ एक ठन मेढ़ा अऊ जैतून तेल म सनाय अन्न-बलिदान ले आवव, काबरकि यहोवा ह आज तुमन करा परगट होही।’ ”<verse eid="LEV 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 9:5" />मूसा ह जऊन कुछू लाने के हुकूम देय रिहिस, ओमन ओला मिलापवाला तम्बू के आघू म ले आईन, अऊ पूरा सभा ह लकठा म आके यहोवा के आघू म ठाढ़ हो गीस। <verse eid="LEV 9:5" /><verse number="6" style="v" sid="LEV 9:6" />तब मूसा ह कहिस, “येह ओ काम ए, जऊन ला करे के हुकूम यहोवा ह तुमन ला देय हवय, जेकर ले यहोवा के महिमा तुमन म परगट होवय।”<verse eid="LEV 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 9:7" />तब मूसा ह हारून ला कहिस, “यहोवा के हुकूम के मुताबिक बेदी करा आ अऊ अपन पाप-बलिदान अऊ अपन होम-बलिदान ला चघा अऊ अपन अऊ मनखेमन बर प्रायस्चित कर; मनखेमन बर चढ़ावा ला चघा अऊ ओमन बर प्रायस्चित कर।”<verse eid="LEV 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 9:8" />अऊ हारून ह बेदी करा आके ओ बछवा ला जऊन ह ओकर पाप-बलिदान के खातिर रिहिस, बलि करिस। <verse eid="LEV 9:8" /><verse number="9" style="v" sid="LEV 9:9" />हारून के बेटामन ओकर करा लहू ला ले गीन अऊ ओह ओ लहू म अपन अंगठी ला बुड़ोके बेदी के सींगमन म चुपरिस अऊ बांचे लहू ला बेदी के खाल्हे म रितो दीस। <verse eid="LEV 9:9" /><verse number="10" style="v" sid="LEV 9:10" />पाप-बलिदान के चरबी, गुरदामन ला अऊ करेजा के सबले बने भाग ला ओह बेदी म जला दीस, जइसे कि यहोवा ह मूसा ला हुकूम देय रिहिस, <verse eid="LEV 9:10" /><verse number="11" style="v" sid="LEV 9:11" />पर ओह मांस अऊ खाल ला डेरा के बाहिर म जलाईस।<verse eid="LEV 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 9:12" />तब ओह होम-बलिदान के पसु के बलि चघाईस अऊ हारून के बेटामन लहू ला ओकर हांथ म दीन अऊ ओह ओला बेदी के ऊपर जम्मो कोति छिंच दीस। <verse eid="LEV 9:12" /><verse number="13" style="v" sid="LEV 9:13" />तब ओमन होम-बलिदान के पसु ला कुटा-कुटा करके मुड़ समेत ओकर हांथ म दे दीन अऊ ओह ओमन ला बेदी म जला दीस। <verse eid="LEV 9:13" /><verse number="14" style="v" sid="LEV 9:14" />ओह पेट के भीतरी भागमन ला अऊ गोड़मन ला धोके ओमन ला होम-बलिदान के ऊपर बेदी म जला दीस।<verse eid="LEV 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 9:15" />तब हारून ह मनखेमन के बलिदान ला लानके अऊ पाप-बलिदान के बोकरा ला, जऊन ह मनखेमन के खातिर रिहिस, लेके ओला बलि करिस अऊ पहिली बलि असन ओला पाप-बलिदान खातिर चघाईस।<verse eid="LEV 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 9:16" />तब होम-बलिदान के पसु ला घलो लकठा म लानके बिधि-बिधान के मुताबिक बलिदान चघाईस। <verse eid="LEV 9:16" /><verse number="17" style="v" sid="LEV 9:17" />फेर ओह बिहनियां के होम-बलिदान के अलावा अन्न-बलिदान ला लकठा म लानके ओमा ले मुठा भर बलिदान ला बेदी म जला दीस।<verse eid="LEV 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 9:18" />ओकर बाद ओह बछवा अऊ मेढ़ा ला, जऊन ह मनखेमन कोति ले मेल-बलिदान रिहिस, बलि करिस अऊ हारून के बेटामन लहू ला ओकर हांथ म दीन अऊ ओह ओला बेदी म जम्मो कोति छिंच दीस। <verse eid="LEV 9:18" /><verse number="19" style="v" sid="LEV 9:19" />पर ओमन बछवा अऊ मेढ़ा के चरबी, मोटहा पुंछी, अऊ चरबी के परत, गुरदा अऊ करेजा के सबले बने भाग— <verse eid="LEV 9:19" /><verse number="20" style="v" sid="LEV 9:20" />येमन ला छाती म मढ़ा दीन, अऊ तब हारून ह ओमन ला बेदी म जला दीस। <verse eid="LEV 9:20" /><verse number="21" style="v" sid="LEV 9:21" />छाती अऊ जेवनी जांघ ला हारून ह मूसा के हुकूम के मुताबिक हलाय-बलिदान के रूप म यहोवा के आघू म हलाईस।<verse eid="LEV 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 9:22" />तब हारून ह ओमन कोति हांथमन ला लमाके ओमन ला आसीस दीस, अऊ पाप-बलिदान, होम-बलिदान, अऊ मेल-बलिदान ला चघाके बेदी करा ले खाल्हे उतर आईस।<verse eid="LEV 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 9:23" />फेर मूसा अऊ हारून मिलापवाला तम्बू म गीन। जब ओमन उहां ले निकलिन, त ओमन मनखेमन ला आसीस दीन; अऊ यहोवा के महिमा जम्मो मनखेमन ऊपर परगट होईस। <verse eid="LEV 9:23" /><verse number="24" style="v" sid="LEV 9:24" />तब यहोवा के आघू ले आगी निकलके चरबी समेत होम-बलिदान ला बेदी म भसम कर दीस। जब मनखेमन ये देखिन, त ओमन जय-जयकार के नारा लगाईन अऊ मुहूं के भार गिरके यहोवा ला दंडवत करिन।<verse eid="LEV 9:24" /></para>
  <chapter eid="LEV 9" />
  <chapter number="10" style="c" sid="LEV 10" />
  <para style="s1">नादाब अऊ अबीहू के मऊत</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 10:1" />तब नादाब अऊ अबीहू नांव के हारून के बेटामन अपन-अपन धूपदान ला लेके ओमन म आगी भरिन अऊ धूप डारिन; अऊ ओ आगी ला यहोवा ला चघाईन, जेकर हुकूम यहोवा ह नइं देय रिहिस। <verse eid="LEV 10:1" /><verse number="2" style="v" sid="LEV 10:2" />एकरसेति यहोवा करा ले आगी निकलिस अऊ ओमन ला जला दीस अऊ ओमन यहोवा के आघू म मर गीन। <verse eid="LEV 10:2" /><verse number="3" style="v" sid="LEV 10:3" />मूसा ह तब हारून ला कहिस, “येह ओ बात ए, जऊन ला यहोवा ह कहिस:</para>
  <para style="q1" vid="LEV 10:3">“ ‘जऊन मन मोर लकठा म आथें</para>
  <para style="q2" vid="LEV 10:3">ओमन के आघू म में पबितर साबित होहूं;</para>
  <para style="q1" vid="LEV 10:3">जम्मो मनखेमन के आघू म</para>
  <para style="q2" vid="LEV 10:3">मोर आदर होही।’ ”</para>
  <para style="m" vid="LEV 10:3">हारून ह तब चुपेचाप रिहिस।<verse eid="LEV 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 10:4" />मूसा ह हारून के कका उजीएल के बेटा मिसाएल अऊ एलसाफान ला बलाईस, अऊ ओमन ला कहिस, “इहां आवव, अऊ अपन चचेरा-भाईमन के देहें ला पबितर-स्थान के आघू ले उठाके डेरा के बाहिर ले जावव।” <verse eid="LEV 10:4" /><verse number="5" style="v" sid="LEV 10:5" />तब मूसा के हुकूम के मुताबिक ओमन आईन अऊ ओमन ला ओमन के अंगरखा समेत डेरा के बाहिर ले गीन।<verse eid="LEV 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 10:6" />तब मूसा ह हारून अऊ ओकर आने बेटा एलिआजर अऊ ईतामार ला कहिस, “तुमन अपन मुड़ के चुंदी ला खुला झन छोंड़व अऊ अपन ओनहा ला झन चीरव;<note caller="+" style="f"><char style="fr" closed="false">10:6 </char><char style="ft" closed="false">ओनहा चिरई ह दुख परगट करे के तरीका ए</char></note> नइं तो तुमन घलो मर जाहू अऊ जम्मो मनखेमन के ऊपर यहोवा के गुस्सा भड़कही। पर तुम्हर रिस्तेदार, याने कि जम्मो इसरायलीमन ओमन बर सोक मनावंय, जऊन मन ला यहोवा ह आगी म नास कर दे हवय। <verse eid="LEV 10:6" /><verse number="7" style="v" sid="LEV 10:7" />तुमन मिलापवाला तम्बू के मुंहटा के बाहिर झन जावव, नइं तो तुमन घलो मर जाहू, काबरकि यहोवा के अभिसेक के तेल तुमन ऊपर लगे हवय।” ओमन मूसा के कहे मुताबिक करिन।<verse eid="LEV 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 10:8" />तब यहोवा ह हारून ला कहिस, <verse eid="LEV 10:8" /><verse number="9" style="v" sid="LEV 10:9" />“जब कभू तें अऊ तोर बेटामन मिलापवाला तम्बू म जाथव, त तुमन अंगूर के मंद या कोनो अऊ किसम के मंद पीके झन जावव, नइं तो तुमन मर जाहू। येह तुम्हर अवइया पीढ़ी के मनखेमन बर हमेसा के बिधि-बिधान अय, <verse eid="LEV 10:9" /><verse number="10" style="v" sid="LEV 10:10" />ताकि तुमन पबितर अऊ सधारन म, सुध अऊ असुध म फरक कर सकव, <verse eid="LEV 10:10" /><verse number="11" style="v" sid="LEV 10:11" />अऊ इसरायलीमन ला ओ जम्मो बिधिमन ला सिखो सकव, जेमन ला यहोवा ह मूसा के दुवारा ओमन ला देय हवय।”<verse eid="LEV 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 10:12" />मूसा ह हारून अऊ ओकर बांचे बेटा एलिआजर अऊ ईतामार ला कहिस, “बिगर खमीर ले बने जऊन जेवन-बलिदान यहोवा ला चघाय गे रिहिस, ओमा के बांचे अन्न-बलिदान ला लेवव अऊ ओला बेदी के बाजू म खावव, काबरकि ओह महा पबितर अय। <verse eid="LEV 10:12" /><verse number="13" style="v" sid="LEV 10:13" />येला तुमन पबितर-स्थान के छेत्र म खावव, काबरकि येह यहोवा ला चघाय जेवन-बलिदान म ले तोर अऊ तोर बेटामन के बांटा ए, अऊ मोला अइसने हुकूम मिले हवय। <verse eid="LEV 10:13" /><verse number="14" style="v" sid="LEV 10:14" />पर हलाय गे छाती अऊ अरपन करे गे जांघ ला तुमन अऊ तुम्हर बेटा-बेटीमन खा सकत हें। ओमन ला बिधि के मुताबिक साफ करे गे जगह म खावव; काबरकि ओ चीजमन इसरायलीमन के मेल-बलिदान के तुम्हर बांटा के रूप म, तुमन अऊ तुम्हर लइकामन ला दिये गे हवय। <verse eid="LEV 10:14" /><verse number="15" style="v" sid="LEV 10:15" />चघाय गे जांघ अऊ हलाय गे छाती ला जेवन-बलिदान के चरबीवाले भागमन के संग लाय जावय, अऊ येमन ला हलाय-बलिदान के रूप म यहोवा के आघू म हलाय जावय। येह तुम्हर अऊ तुम्हर लइकामन के हमेसा के बांटा होही, जइसने कि यहोवा ह हुकूम दे हवय।”<verse eid="LEV 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 10:16" />जब मूसा ह पाप-बलिदान के बोकरा के बारे म पुछताछ करिस, त पता चलिस कि ओला तो जला देय गे हवय; येकरे कारन ओह हारून के बांचे बेटामन एलिआजर अऊ ईतामार ऊपर गुस्सा होईस, अऊ ओमन ले पुछिस, <verse eid="LEV 10:16" /><verse number="17" style="v" sid="LEV 10:17" />“तुमन पाप-बलिदान के मांस ला पबितर-स्थान के छेत्र म काबर नइं खायेव? येह महा पबितर अय; येह एकर खातिर देय गे रिहिस कि यहोवा के आघू म सभा बर प्रायस्चित करके ओमन के दोस ला दूर करे जावय। <verse eid="LEV 10:17" /><verse number="18" style="v" sid="LEV 10:18" />जब एकर लहू ला पबितर स्थान के भीतर म लाने ही नइं गीस, त तुमन ला बोकरा के मांस ला पबितर-स्थान के छेत्र म खाना रिहिस, जइसने कि मेंह तुमन ला हुकूम देय रहेंव।”<verse eid="LEV 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 10:19" />हारून ह मूसा ला जबाब दीस, “आज ही ओमन अपन पाप-बलिदान अऊ होम-बलिदान यहोवा के आघू म चघाय हवंय, पर अइसने बात मोर संग होईस। कहूं में आज पाप-बलिदान के मांस ला खाय रहितंय, त का यहोवा के आघू म ये बने बात होतिस?” <verse eid="LEV 10:19" /><verse number="20" style="v" sid="LEV 10:20" />जब मूसा ह ये सुनिस, त ये बात ओला बने लगिस।<verse eid="LEV 10:20" /></para>
  <chapter eid="LEV 10" />
  <chapter number="11" style="c" sid="LEV 11" />
  <para style="s1">सुध अऊ असुध जेवन</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 11:1" />यहोवा ह मूसा अऊ हारून ला कहिस, <verse eid="LEV 11:1" /><verse number="2" style="v" sid="LEV 11:2" />“इसरायलीमन ला कहव: ‘भुइयां के ऊपर जतेक जीयत पसुमन हवंय, ओमा ले तुमन येमन ला खा सकत हव: <verse eid="LEV 11:2" /><verse number="3" style="v" sid="LEV 11:3" />तुमन कोनो भी अइसने पसु ला खा सकत हव, जेकर फटे खुर हवय अऊ ओह पागुर करथे।<verse eid="LEV 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 11:4" />“ ‘कुछू पसुमन होथें, जऊन मन या तो सिरिप पागुर करथें या फेर सिरिप फटे खुर के होथें; ओमन ला तुमन झन खाहू। ऊंट—हालाकि येह पागुर करथे, पर येकर खुर फटे नइं रहय; येह तुम्हर बर बिधि के मुताबिक असुध अय। <verse eid="LEV 11:4" /><verse number="5" style="v" sid="LEV 11:5" />कबर-बिज्जू<note caller="+" style="f"><char style="fr" closed="false">11:5 </char><char style="ft" closed="false">सापान; भालू के सहीं एक जंगली पसु</char></note>—हालाकि येह पागुर करथे, पर येकर खुर फटे नइं रहय; येह तुम्हर बर असुध अय। <verse eid="LEV 11:5" /><verse number="6" style="v" sid="LEV 11:6" />खरगोस—हालाकि येह पागुर करथे, पर येकर खुर फटे नइं रहय; येह तुम्हर बर असुध अय। <verse eid="LEV 11:6" /><verse number="7" style="v" sid="LEV 11:7" />अऊ सूरा घलो—हालाकि येकर खुर ह फटे रहिथे, पर येह पागुर नइं करय; येह तुम्हर बर असुध अय। <verse eid="LEV 11:7" /><verse number="8" style="v" sid="LEV 11:8" />तुमन ये पसुमन के मांस झन खावव या ओमन के लास ला झन छुवव; ओमन तुम्हर बर असुध अंय।<verse eid="LEV 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 11:9" />“ ‘समुंदर अऊ नदी के पानी म जतेक जीयत जीव-जन्तु हवंय, ओमा के जेकर पंख अऊ बिस्सर छिलका होथे, ओमन ला तुमन खा सकत हव। <verse eid="LEV 11:9" /><verse number="10" style="v" sid="LEV 11:10" />पर समुंदर अऊ नदी के ओ जम्मो जीव-जन्तु, जेकर पंख अऊ बिस्सर छिलका नइं होवय—चाहे उड़नेवाला जीव होवंय या पानी के दूसर जीयत जीव-जन्तु होवंय—तुमन ओमन ला असुध समझव। <verse eid="LEV 11:10" /><verse number="11" style="v" sid="LEV 11:11" />अऊ जब तुमन ओमन ला असुध समझथव, त तुमन ओमन के मांस ला झन खावव; तुमन ओमन के लास ला घलो असुध समझव। <verse eid="LEV 11:11" /><verse number="12" style="v" sid="LEV 11:12" />पानी के कोनो घलो जीयत जन्तु, जेकर पंख अऊ बिस्सर छिलका नइं होवय, ओह तुम्हर दुवारा असुध समझे जावय।<verse eid="LEV 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 11:13" />“ ‘येमन ओ चिरई अंय, जेमन ला तुमन असुध समझव अऊ झन खावव, काबरकि ओमन असुध अंय: चील, गिधवा, करिया गिधवा, <verse eid="LEV 11:13" /><verse number="14" style="v" sid="LEV 11:14" />लाल चील, कोनो भी किसम के करिया चील, <verse eid="LEV 11:14" /><verse number="15" style="v" sid="LEV 11:15" />कोनो भी किसम के कऊआ <verse eid="LEV 11:15" /><verse number="16" style="v" sid="LEV 11:16" />सींगवाला उल्लू, चिचियानेवाला उल्लू, समुंदरी चिरई, कोनो भी किसम के बाज, <verse eid="LEV 11:16" /><verse number="17" style="v" sid="LEV 11:17" />छोटे घुघवा, हाड़गील, बड़े घुघवा, <verse eid="LEV 11:17" /><verse number="18" style="v" sid="LEV 11:18" />सफेद घुघवा, सुनसान जगह के घुघवा, समुंदरी बाज, <verse eid="LEV 11:18" /><verse number="19" style="v" sid="LEV 11:19" />सारस, कोनो भी किसम के कोकड़ा, टिटहरी अऊ चमगीदड़।<verse eid="LEV 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 11:20" />“ ‘जम्मो उड़नेवाला कीरामन, जऊन मन चारों गोड़ म रेंगथें, ओमन तुम्हर बर असुध अंय। <verse eid="LEV 11:20" /><verse number="21" style="v" sid="LEV 11:21" />पर कुछू उड़नेवाला कीरा, जेमन चारों गोड़ म रेंगथें, ओमन ला खा सकत हव: जेमन के गोड़मन भुइयां म कूदे-फांदे बर जूरे होथे। <verse eid="LEV 11:21" /><verse number="22" style="v" sid="LEV 11:22" />येमन ला खा सकत हव—कोनो घलो किसम के टिड्डी, फनगे, झिंगुर अऊ फांफा। <verse eid="LEV 11:22" /><verse number="23" style="v" sid="LEV 11:23" />पर आने जम्मो किसम के उड़नेवाला कीरा, जेमन के चार गोड़ हवय, ओमन ला तुमन असुध समझव।<verse eid="LEV 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 11:24" />“ ‘तुमन ये काम करे के दुवारा अपनआप ला असुध ठहिराहू; जऊन कोनो ओमन के लास ला छूथे, ओह संझा के होवत तक असुध ठहिरही। <verse eid="LEV 11:24" /><verse number="25" style="v" sid="LEV 11:25" />जऊन कोनो ओमन के कोनो लास ला उठाथे, त ओह अपन ओनहा ला धोवय, अऊ संझा के होवत ले असुध ठहिरय।<verse eid="LEV 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 11:26" />“ ‘हर ओ पसु, जेकर खुर फटे नइं ए या जेह पागुर नइं करय, ओह तुम्हर बर असुध अय; जऊन कोनो ओमन के कोनो घलो लास ला छूथे, ओह असुध ठहिरही। <verse eid="LEV 11:26" /><verse number="27" style="v" sid="LEV 11:27" />चारों गोड़ म रेंगइया जम्मो पसु, जेमन अपन पंजा म रेंगथें, ओमन तुम्हर बर असुध अंय। जऊन कोनो ओमन के लास ला छूथे, ओह संझा के होवत ले असुध ठहिरही। <verse eid="LEV 11:27" /><verse number="28" style="v" sid="LEV 11:28" />जऊन कोनो ओमन के लास ला उठाथे, ओह अपन ओनहा ला धोवय, अऊ संझा के होवत ले असुध ठहिरय। ये पसुमन तुम्हर बर असुध अंय।<verse eid="LEV 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 11:29" />“ ‘भुइयां म रेंगइया पसु म ले, येमन तुम्हर बर असुध अंय: नेवला, मुसवा, कोनो घलो किसम के बड़े टेटका, <verse eid="LEV 11:29" /><verse number="30" style="v" sid="LEV 11:30" />छिपकली, गोइहा, भीथी के टेटका, सांडा अऊ छोटे टेटका <verse eid="LEV 11:30" /><verse number="31" style="v" sid="LEV 11:31" />भुइयां म रेंगइया जम्मो पसुमन ले, येमन तुम्हर बर असुध अंय। जऊन कोनो येमन के लास ला छूथे, ओह संझा के होवत ले असुध ठहिरही। <verse eid="LEV 11:31" /><verse number="32" style="v" sid="LEV 11:32" />जब येमन म के कोनो ह मर जाथे, अऊ ओह कोनो चीज के ऊपर गिरथे, त ओ चीज ह असुध ठहिरही, ओह कोनो घलो चीज होवय, चाहे ओह कठवा के बने होवय, या ओनहा, या खाल, या बोरा के बने होवय। ओला पानी म डारे जावय अऊ संझा के होवत ले ओह असुध ठहिरही, अऊ तब ओह सुध हो जाही। <verse eid="LEV 11:32" /><verse number="33" style="v" sid="LEV 11:33" />यदि ये पसु म के कोनो ह माटी के कोनो बरतन म गिरथे, त ओ बरतन के जम्मो चीज ह असुध ठहिरही; तुमन ओ बरतन ला टोर देवव। <verse eid="LEV 11:33" /><verse number="34" style="v" sid="LEV 11:34" />कोनो किसम के जेवन, जेला तुमन खा सकत हव, पर यदि ओह अइसने बरतन के पानी म छू जाथे, त ओ जेवन ह असुध अय, अऊ कहूं अइसने बरतन म कोनो पीये के चीज हवय, त ओह घलो असुध अय। <verse eid="LEV 11:34" /><verse number="35" style="v" sid="LEV 11:35" />ओमन के लास म के कोनो भाग ह येमा के कोनो चीज म गिर जावय, चाहे ओह चूल्हा होवय या रांधे के बरतन, ओला टोर दिये जावय। ओमन असुध अंय, अऊ तुमन ओमन ला असुध समझव। <verse eid="LEV 11:35" /><verse number="36" style="v" sid="LEV 11:36" />पर सोता या तरिया, जेमा पानी ह संकलाथे, यदि कोनो मरे पसु ओमा मिलथे, त ओ पानी ह सुध रहिथे, फेर जऊन कोनो येमन के लास ला छूथे, ओह असुध ठहिरही। <verse eid="LEV 11:36" /><verse number="37" style="v" sid="LEV 11:37" />कहूं कोनो लास ह कोनो किसम के बीजा ऊपर गिरथे, जेला बोये बर रखे गे हवय, त ओ बीजा ह सुध बने रहिही। <verse eid="LEV 11:37" /><verse number="38" style="v" sid="LEV 11:38" />फेर कहूं बीजा ऊपर पानी डारे गे हवय अऊ कोनो लास ह ओमा गिर जाथे, त ओ बीजा ह तुम्हर बर असुध अय।<verse eid="LEV 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 11:39" />“ ‘कोनो पसु, जेला खाय के अनुमति तुमन ला हवय, यदि ओह मर जाथे, अऊ जऊन कोनो ओकर लास ला छूथे, ओह संझा के होवत ले असुध ठहिरही। <verse eid="LEV 11:39" /><verse number="40" style="v" sid="LEV 11:40" />जऊन कोनो ओकर लास म ले कुछू खाथे, ओह अपन ओनहा ला धोवय, अऊ ओह संझा के होवत ले असुध ठहिरही। जऊन कोनो ओकर लास ला उठावय, ओह घलो अपन ओनहा ला धोवय, अऊ ओह संझा के होवत ले असुध ठहिरही।<verse eid="LEV 11:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LEV 11:41" />“ ‘भुइयां म रेंगइया जम्मो जीव ला असुध समझे जावय; ओमन ला झन खाय जावय। <verse eid="LEV 11:41" /><verse number="42" style="v" sid="LEV 11:42" />तुमन भुइयां म रेंगइया कोनो जीव या परानी ला झन खावव, चाहे ओह पेट के भार रेंगथे या चारों गोड़ म या अब्बड़ अकन गोड़ म रेंगथे; येह असुध अय। <verse eid="LEV 11:42" /><verse number="43" style="v" sid="LEV 11:43" />येमा के कोनो घलो जीव के दुवारा अपनआप ला असुध झन करव। तुमन कोनो घलो हालत म अपनआप ला ओमन के दुवारा असुध झन करव या ओमन के दुवारा असुध झन होवव। <verse eid="LEV 11:43" /><verse number="44" style="v" sid="LEV 11:44" />मेंह यहोवा तुम्हर परमेसर अंव; अपनआप ला सुध करव अऊ पबितर बनव, काबरकि मेंह पबितर अंव। भुइयां म रेंगइया कोनो घलो जीव के दुवारा अपनआप ला असुध झन करव। <verse eid="LEV 11:44" /><verse number="45" style="v" sid="LEV 11:45" />मेंह यहोवा अंव, जऊन ह तुमन ला मिसर देस ले निकालके लाने हंव कि मेंह तुम्हर परमेसर होवंव; एकरसेति तुमन पबितर बनव, काबरकि मेंह पबितर अंव।<verse eid="LEV 11:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LEV 11:46" />“ ‘पसु, चिरई, पानी म रेंगइया-बुलइया जम्मो जीव अऊ भुइयां म रेंगइया जम्मो परानी के बिसय म इही ह नियम अय। <verse eid="LEV 11:46" /><verse number="47" style="v" sid="LEV 11:47" />येह जरूरी अय कि तुमन सुध अऊ असुध म भेद करव, अऊ खाय जानेवाला जीयत परानी अऊ नइं खाय जानेवाला परानीमन ला जानव।’ ”<verse eid="LEV 11:47" /></para>
  <chapter eid="LEV 11" />
  <chapter number="12" style="c" sid="LEV 12" />
  <para style="s1">छेवारी होय के बाद सुध होवई</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 12:1" />यहोवा ह मूसा ला कहिस, <verse eid="LEV 12:1" /><verse number="2" style="v" sid="LEV 12:2" />“इसरायलीमन ला कह: ‘ओ माईलोगन, जऊन ह देहें म होके बेटा ला जनम देथे, ओह सात दिन तक बिधि के मुताबिक असुध रहिही, जइसने कि ओह माहवारी के समय म असुध रहिथे। <verse eid="LEV 12:2" /><verse number="3" style="v" sid="LEV 12:3" />जनमे बेटा के आठवां दिन म खतना करे जावय। <verse eid="LEV 12:3" /><verse number="4" style="v" sid="LEV 12:4" />ओकर बाद ओ छेवारीन ह अपन बहत लहू ले सुध होय बर तैंतीस दिन तक अगोरय। जब तक ओकर सुध होय के दिन ह पूरा नइं हो जावय, तब तक ओह न तो कोनो पबितर चीज ला छुवय अऊ न ही पबितर-स्थान म जावय। <verse eid="LEV 12:4" /><verse number="5" style="v" sid="LEV 12:5" />कहूं ओ माईलोगन ह बेटी ला जनम देथे, तब ओह दू हप्ता तक असुध रहिही, जइसने कि माहवारी के समय म रहिथे। तब ओह अपन बहत लहू ले सुध होय बर छैंसठ दिन तक अगोरय।<verse eid="LEV 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 12:6" />“ ‘जब ओ छेवारीन के सुध होय के दिन ह पूरा हो जावय, चाहे ओला बेटा होय रहय या बेटी, ओह होम-बलिदान बर एक बछर के मेढ़ा-पीला अऊ पाप-बलिदान बर एक ठन परेवा पीला या एक ठन पंड़की मिलापवाला तम्बू म पुरोहित करा लानय। <verse eid="LEV 12:6" /><verse number="7" style="v" sid="LEV 12:7" />तब पुरोहित ह ओ माईलोगन बर प्रायस्चित के नियम ला पूरा करे बर ओमन ला यहोवा के आघू म चघावय, अऊ तब ओह अपन बहत लहू ले बिधि के मुताबिक सुध हो जाही।</para>
  <para style="p" vid="LEV 12:7">“ ‘येमन छेवारीन बर बिधि अंय, जऊन ह कोनो बेटा या बेटी ला जनम देथे। <verse eid="LEV 12:7" /><verse number="8" style="v" sid="LEV 12:8" />पर कहूं ओ छेवारीन ह मेढ़ा-पीला नइं दे सकय, त ओह पंड़की के एक जोड़ा या दू ठन परेवा पीला लेके आवय, जेमा के एक ठन ह होम-बलिदान अऊ दूसर ह पाप-बलिदान के रूप म चघाय जावय। ये किसम ले, पुरोहित ह ओकर बर प्रायस्चित के बिधि ला पूरा करही, अऊ ओह सुध हो जाही।’ ”<verse eid="LEV 12:8" /></para>
  <chapter eid="LEV 12" />
  <chapter number="13" style="c" sid="LEV 13" />
  <para style="s1">असुध चमड़ी के बेमारी के बारे म बिधि</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 13:1" />यहोवा ह मूसा अऊ हारून ला फेर कहिस, <verse eid="LEV 13:1" /><verse number="2" style="v" sid="LEV 13:2" />“जब कोनो मनखे के चमड़ी म सूजन या चकत्ता या चमकत कोनो दाग होवय, जऊन ह चमड़ी के कोनो असुध करइया बेमारी हो सकत हे, त ओला हारून पुरोहित या ओकर पुरोहित बेटामन<note caller="+" style="f"><char style="fr" closed="false">13:2 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">संतानमन</char></note> म ले एक झन करा लाने जावय। <verse eid="LEV 13:2" /><verse number="3" style="v" sid="LEV 13:3" />पुरोहित ह ओकर चमड़ी के बेमारी के जांच करय, अऊ यदि बेमारी के जगह के रूआंमन सफेद हो गे हवंय अऊ बेमारी ह ओकर देहें के चमड़ी ले गहरा दिखय, त येह एक चमड़ी के असुध करइया बेमारी अय। जब पुरोहित ह ओ मनखे के जांच कर लेवय, तब ओह ओला बिधि मुताबिक असुध ठहिरावय। <verse eid="LEV 13:3" /><verse number="4" style="v" sid="LEV 13:4" />कहूं ओ चमकत दाग ह सफेद हवय, पर चमड़ी ले गहरा नइं दिखथे अऊ उहां के रूआंमन सफेद नइं होय हवंय, त पुरोहित ह ओ बेमारीवाला मनखे ला सात दिन तक अलग रखय। <verse eid="LEV 13:4" /><verse number="5" style="v" sid="LEV 13:5" />सातवां दिन, पुरोहित ह ओला फेर जांचय, अऊ यदि ओह देखय कि दाग म कोनो बदलाव नइं ए अऊ बेमारी ह चमड़ी म नइं बगरे हे, त पुरोहित ह ओला अऊ सात दिन तक अलग रखय। <verse eid="LEV 13:5" /><verse number="6" style="v" sid="LEV 13:6" />सातवां दिन, पुरोहित ह ओला फेर जांचय, अऊ कहूं दाग के चमकई ह कम हो गे हवय अऊ चमड़ी म नइं बगरे हवय, तब पुरोहित ह ओला सुध ठहिरावय; येह सिरिप एक चकत्ता अय। ओह अपन ओनहा ला धोवय, अऊ ओह सुध हो जाही। <verse eid="LEV 13:6" /><verse number="7" style="v" sid="LEV 13:7" />पर पुरोहित ला देखाय अऊ सुध ठहिराय के बाद, यदि ओकर चमड़ी म चकत्ता ह बगर जाथे, त ओ मनखे ह फेर पुरोहित करा जावय। <verse eid="LEV 13:7" /><verse number="8" style="v" sid="LEV 13:8" />पुरोहित ह ओ मनखे के जांच करय, अऊ कहूं चकत्ता ह चमड़ी म बगर गे हवय, तब पुरोहित ह ओला असुध ठहिरावय; येह चमड़ी के एक असुध करइया बेमारी अय।<verse eid="LEV 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 13:9" />“जब कोनो मनखे ला चमड़ी के असुध करइया बेमारी हवय, त ओला पुरोहित करा लाने जावय। <verse eid="LEV 13:9" /><verse number="10" style="v" sid="LEV 13:10" />पुरोहित ह ओला जांचय, अऊ कहूं चमड़ी के सूजनवाले जगह ह सफेद हो गे हवय अऊ उहां के रूआंमन घलो सफेद हो गे हवंय, अऊ ओ सूजन के जगह म मांस दिखथे, <verse eid="LEV 13:10" /><verse number="11" style="v" sid="LEV 13:11" />त येह एक पुराना चमड़ी के रोग अय, अऊ पुरोहित ह ओला असुध ठहिरावय। ओह ओला अलग झन रखय, काबरकि ओ मनखे ह पहिले से ही असुध हवय।<verse eid="LEV 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 13:12" />“कहूं बेमारी ह मनखे के जम्मो चमड़ी म बगर गे हवय, अऊ पुरोहित ह देखथे कि ओ मनखे के मुड़ ले लेके गोड़ तक जम्मो चमड़ी म बेमारी हो गे हवय, <verse eid="LEV 13:12" /><verse number="13" style="v" sid="LEV 13:13" />त पुरोहित ह ओला धियान से जांचय, अऊ यदि बेमारी ह ओकर जम्मो देहें म हो गे हवय, त ओह ओ मनखे ला सुध ठहिरावय। जब ओकर पूरा देहें ह सफेद हो गे हवय, त ओह सुध अय। <verse eid="LEV 13:13" /><verse number="14" style="v" sid="LEV 13:14" />पर जब कभू ओकर चमड़ी म मांस दिखे लगय, तब ओह असुध ठहिरही। <verse eid="LEV 13:14" /><verse number="15" style="v" sid="LEV 13:15" />जब पुरोहित ह ओमा मांस देखथे, त ओह ओ मनखे ला असुध ठहिरावय। खुला मांस ह असुध अय; ओला एक असुध करइया बेमारी हवय। <verse eid="LEV 13:15" /><verse number="16" style="v" sid="LEV 13:16" />कहूं ओ खुला मांस ह ठीक होके सफेद हो जाथे, त ओ मनखे ह पुरोहित करा जावय। <verse eid="LEV 13:16" /><verse number="17" style="v" sid="LEV 13:17" />पुरोहित ह ओकर जांच करय, अऊ कहूं घाव ह सफेद हो गे हवय, त पुरोहित ह ओ बिमरहा मनखे ला सुध ठहिरावय; तब ओह सुध हो जाही।<verse eid="LEV 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 13:18" />“जब काकरो चमड़ी म फोड़ा हवय अऊ ओह बने हो जाथे, <verse eid="LEV 13:18" /><verse number="19" style="v" sid="LEV 13:19" />अऊ ओ फोड़ा के जगह म सफेद सूजन या लाल-सफेद दाग दिखथे, त ओह अपनआप ला पुरोहित ला देखावय। <verse eid="LEV 13:19" /><verse number="20" style="v" sid="LEV 13:20" />पुरोहित ह येकर जांच करय, अऊ कहूं ओ दाग ह चमड़ी ले जादा गहिरा दिखय अऊ येमा के रूआंमन सफेद हो गे हवंय, त पुरोहित ह ओ मनखे ला असुध ठहिरावय। येह चमड़ी के असुध करइया बेमारी अय, जऊन ह फोड़ा म ले फूटके निकले हवय। <verse eid="LEV 13:20" /><verse number="21" style="v" sid="LEV 13:21" />पर यदि, जब पुरोहित ह येकर जांच करथे, अऊ ओला येमा सफेद रूआं नइं दिखय अऊ येह चमड़ी ले गहिरा नइं ए अऊ ओकर चमक ह कम हो गे हवय, त पुरोहित ह ओला सात दिन तक अलग रखय। <verse eid="LEV 13:21" /><verse number="22" style="v" sid="LEV 13:22" />पर कहूं येह चमड़ी म बगरत हवय, तब पुरोहित ह ओला असुध ठहिरावय; येह एक असुध करइया बेमारी अय। <verse eid="LEV 13:22" /><verse number="23" style="v" sid="LEV 13:23" />पर कहूं दाग ह नइं बदले हवय अऊ येह नइं बगरे हवय, त येह सिरिप फोड़ा के एक दाग अय, अऊ पुरोहित ह ओ मनखे ला सुध ठहिरावय।<verse eid="LEV 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 13:24" />“जब कोनो मनखे के चमड़ी ह जर जाथे अऊ ओ जरे जगह के मांस म लाल-सफेद या सफेद दाग दिखथे, <verse eid="LEV 13:24" /><verse number="25" style="v" sid="LEV 13:25" />तब पुरोहित ह ओ दाग के जांच करय। अऊ कहूं दाग म के रूआंमन सफेद हो गे हवंय अऊ येह चमड़ी ले गहिरा हो गे हवय, त येह एक असुध करइया बेमारी अय, जऊन ह ओ जरे के जगह म फूटके निकले हवय। पुरोहित ह ओ मनखे ला असुध ठहिरावय; येह एक चमड़ी के असुध करइया रोग अय। <verse eid="LEV 13:25" /><verse number="26" style="v" sid="LEV 13:26" />पर कहूं पुरोहित ह येकर जांच करथे अऊ ओ दाग म कोनो सफेद रूआं नइं दिखय अऊ यदि येह चमड़ी ले गहिरा नइं हवय अऊ येकर चमक ह कम हो गे हवय, त पुरोहित ह ओ मनखे ला सात दिन तक अलग रखय। <verse eid="LEV 13:26" /><verse number="27" style="v" sid="LEV 13:27" />सातवां दिन पुरोहित ह ओ मनखे के जांच करय, अऊ कहूं बेमारी ह चमड़ी म बगरत हवय, त पुरोहित ह ओ मनखे ला असुध ठहिरावय; येह चमड़ी के एक असुध करइया बेमारी अय। <verse eid="LEV 13:27" /><verse number="28" style="v" sid="LEV 13:28" />फेर कहूं ओ दाग ह नइं बदले हवय अऊ चमड़ी म नइं बगरे हवय अऊ ओकर चमक ह कम हो गे हवय, त येह जरे के कारन एक सूजन अय, अऊ पुरोहित ह ओ मनखे ला सुध ठहिरावय; येह जरे के सिरिप एक दाग अय।<verse eid="LEV 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 13:29" />“कहूं कोनो आदमी या माईलोगन के मुड़ या थोथना म कोनो घाव हवय, <verse eid="LEV 13:29" /><verse number="30" style="v" sid="LEV 13:30" />त पुरोहित ह ओ घाव के जांच करय अऊ कहूं येह चमड़ी ले गहिरा दिखय, अऊ येमा के रूआं ह पीला रंग के अऊ पातर दिखय, त पुरोहित ह ओला असुध ठहिरावय; येह मुड़ या थोथना म चमड़ी के एक असुध करइया बेमारी अय। <verse eid="LEV 13:30" /><verse number="31" style="v" sid="LEV 13:31" />पर यदि, जब पुरोहित ह घाव ला जांच करथे, अऊ येह चमड़ी ले गहिरा नइं दिखय अऊ उहां करिया रूआं नइं ए, त पुरोहित ह ओ मनखे ला सात दिन तक अलग रखय। <verse eid="LEV 13:31" /><verse number="32" style="v" sid="LEV 13:32" />सातवां दिन, पुरोहित ह ओकर घाव के जांच करय, अऊ कहूं येह नइं बगरे हवय, अऊ येमा कोनो पीला रंग के रूआं नइं ए अऊ येह चमड़ी ले गहिरा नइं दिखय, <verse eid="LEV 13:32" /><verse number="33" style="v" sid="LEV 13:33" />त ओ आदमी या माईलोगन ह ओ घाव के जगह ला छोंड़के अपन बाल मुड़ा लेवय, अऊ पुरोहित ह ओला अऊ सात दिन तक अलग रखय। <verse eid="LEV 13:33" /><verse number="34" style="v" sid="LEV 13:34" />फेर सातवां दिन, पुरोहित ह ओ घाव के जांच करय अऊ कहूं येह चमड़ी म नइं बगरे हवय अऊ चमड़ी ले गहिरा नइं दिखय, त पुरोहित ह ओ मनखे या माईलोगन ला सुध ठहिरावय। ओह अपन ओनहा ला धोवय, अऊ ओह सुध हो जाही। <verse eid="LEV 13:34" /><verse number="35" style="v" sid="LEV 13:35" />पर सुध ठहिराय जाय के बाद, कहूं घाव ह चमड़ी म बगरथे, <verse eid="LEV 13:35" /><verse number="36" style="v" sid="LEV 13:36" />त पुरोहित ह ओकर जांच करय, अऊ कहूं ओह देखथे कि घाव ह चमड़ी म बगर गे हवय, त ओला घाव के जगह म पीला रूआं देखे के जरूरत नइं ए; ओह असुध अय। <verse eid="LEV 13:36" /><verse number="37" style="v" sid="LEV 13:37" />पर कहूं पुरोहित ह देखथे कि घाव ह नइं बदले हे, अऊ यदि येमा करिया रूआं जाम गे हे, त फेर ओ आदमी या माईलोगन ह बने हो गे हवय। ओह सुध अय, अऊ पुरोहित ह ओला सुध ठहिरावय।<verse eid="LEV 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LEV 13:38" />“जब कोनो आदमी या माईलोगन के चमड़ी म सफेद दाग हवय, <verse eid="LEV 13:38" /><verse number="39" style="v" sid="LEV 13:39" />त पुरोहित ह ओकर जांच करय, अऊ कहूं ओकर दागमन हल्का सफेद हवंय, त येह नुकसान नइं करइया दाग अय, जऊन ह चमड़ी म निकले हवय; ओ मनखे ह सुध अय।<verse eid="LEV 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LEV 13:40" />“कोनो मनखे के मुड़ के चुंदी ह झर गे हवय अऊ ओह चंदुआ अय, त अइसने मनखे ह सुध अय। <verse eid="LEV 13:40" /><verse number="41" style="v" sid="LEV 13:41" />कहूं कोनो मनखे के मुड़ के आघू के चुंदी झर गे हवय, त ओह माथा के चंदुआ अय; ओह सुध अय। <verse eid="LEV 13:41" /><verse number="42" style="v" sid="LEV 13:42" />पर कहूं ओकर चंदुआ मुड़ या चंदुआ माथा म लाल-सफेद रंग के घाव हवय, त येह ओकर मुड़ या माथा म निकले एक असुध करइया बेमारी अय। <verse eid="LEV 13:42" /><verse number="43" style="v" sid="LEV 13:43" />पुरोहित ह ओ मनखे के जांच करय अऊ कहूं ओकर मुड़ या माथा के फूले घाव ह लाल-सफेद रंग के चमड़ी के एक असुध करइया बेमारी सहीं अय, <verse eid="LEV 13:43" /><verse number="44" style="v" sid="LEV 13:44" />त ओ मनखे ला बेमारी हो गे हे अऊ ओह असुध अय। ओकर मुड़ या माथा म घाव के कारन, पुरोहित ह ओला असुध ठहिरावय।<verse eid="LEV 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LEV 13:45" />“जऊन मनखे म अइसने असुध बेमारी हवय, ओह चिरहा-फटहा ओनहा पहिरय; ओकर चुंदी ह छरियाय रहय अऊ अपन चेहरा के खाल्हे भाग ला तोप के ओह चिचियावय, ‘असुध! असुध!’ <verse eid="LEV 13:45" /><verse number="46" style="v" sid="LEV 13:46" />जब तक ओ मनखे म बेमारी हवय, तब तक ओह असुध रहिथे। ओह अकेला रहय; ओह डेरा के बाहिर म रहय।<verse eid="LEV 13:46" /></para>
  <para style="s1">असुध ओनहा या चाम के बारे म बिधि</para>
  <para style="p">
    <verse number="47" style="v" sid="LEV 13:47" />“जब कोनो ओनहा ह असुध करइया बेमारी ले खराप हो जावय—चाहे ओ ओनहा ह ऊन के होवय या मलमल के होवय, <verse eid="LEV 13:47" /><verse number="48" style="v" sid="LEV 13:48" />मलमल या ऊन के बिनाय या गंथाय कोनो चीज होवय, चाम या चाम के बने कोनो चीज होवय— <verse eid="LEV 13:48" /><verse number="49" style="v" sid="LEV 13:49" />कहूं ओ ओनहा, चाम, बिनाय या गंथाय चीज, या कोनो चाम ले बने चीज के ओ बेमारीवाला भाग ह हरियर या लाली रंग के दिखय, त येह असुध करइया फफूंदी अय अऊ येला पुरोहित ला देखाय जावय। <verse eid="LEV 13:49" /><verse number="50" style="v" sid="LEV 13:50" />पुरोहित ह बेमारी लगे भाग ला जांचय अऊ ओ चीज ला सात दिन तक अलग रखय। <verse eid="LEV 13:50" /><verse number="51" style="v" sid="LEV 13:51" />सातवां दिन पुरोहित ह येकर फेर जांच करय, अऊ कहूं ओ बेमारी ह ओनहा, बिनाय या गंथाय चीज म, या चाम म बगर गे हवय, चाहे ओकर कोनो घलो उपयोग होथे, येह लगातार बने रहइया एक असुध बेमारी अय; ओ चीज ह असुध अय। <verse eid="LEV 13:51" /><verse number="52" style="v" sid="LEV 13:52" />ओह ओ ओनहा, ऊन या मलमल के बिनाय या गंथाय चीज, या कोनो चाम के बने चीज, जऊन ह खराप हो गे हवय, ओला जला देवय; काबरकि ओ असुध करइया फफूंदी ह लगातार बने रहिथे; ओ चीज ला जला दिये जावय।<verse eid="LEV 13:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LEV 13:53" />“पर कहूं पुरोहित ह येला जांच करय, अऊ फफूंदी ह ओ ओनहा म, बिनाय या गंथाय चीज म, या चाम के चीज म नइं बगरे हवय, <verse eid="LEV 13:53" /><verse number="54" style="v" sid="LEV 13:54" />त पुरोहित ह हुकूम देवय कि जऊन चीज ह खराप होय हवय, ओला धोय जावय। तब ओह ओ चीज ला सात दिन तक अलग रखय। <verse eid="LEV 13:54" /><verse number="55" style="v" sid="LEV 13:55" />ओ चीज ला धोय के बाद, पुरोहित ह ओला फेर जांच करय, अऊ कहूं फफूंदी म कोनो बदलाव नइं दिखय, अऊ हालाकि येह नइं बगरे हवय, तभो ले येह असुध अय। येला जला देवय, चाहे ओ चीज के कोनो घलो भाग खराप होय हवय। <verse eid="LEV 13:55" /><verse number="56" style="v" sid="LEV 13:56" />पर यदि पुरोहित ह येला जांच करथे, अऊ ओ चीज ला धोय के बाद, फफूंदी के चमक ह कम हो गे हवय, त ओह ओ ओनहा, चाम, या बिनाय या गंथाय चीज के ओ खराप हिस्सा ला चीरके अलग कर देवय। <verse eid="LEV 13:56" /><verse number="57" style="v" sid="LEV 13:57" />पर कहूं ओ बेमारी ओनहा म, बुने या गंथाय चीज म, या चाम के बने चीज म फेर दिखथे, त येह एक बगरनेवाला फफूंदी अय; अऊ ओ फफूंदीवाले चीज ला जला दिये जावय। <verse eid="LEV 13:57" /><verse number="58" style="v" sid="LEV 13:58" />कहूं कोनो ओनहा, बिनाय या गंथाय चीज, या चाम के कोनो चीज ला धोय गे हवय, अऊ ओमा के फफूंदी ह खतम हो गे हवय, त ओ चीज ला फेर धोय जावय। तब येह सुध होही।”<verse eid="LEV 13:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LEV 13:59" />ऊन या मलमल के ओनहा, बिनाय या गंथाय चीज, या चाम ले बने कोनो चीज म लगे फफूंद ला सुध या असुध ठहिराय के नियम येमन अंय।<verse eid="LEV 13:59" /></para>
  <chapter eid="LEV 13" />
  <chapter number="14" style="c" sid="LEV 14" />
  <para style="s1">असुध चमड़ी के बेमारी ले सुध होवई</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 14:1" />यहोवा ह मूसा ला कहिस, <verse eid="LEV 14:1" /><verse number="2" style="v" sid="LEV 14:2" />“जब कोनो बिमरहा मनखे ला पुरोहित करा लाय जाथे, त ओकर बिधि के मुताबिक सुध होय के नियम ये अंय: <verse eid="LEV 14:2" /><verse number="3" style="v" sid="LEV 14:3" />पुरोहित ह डेरा के बाहिर जावय अऊ ओकर जांच करय। यदि ओह असुध करइया चमड़ी के बेमारी ले बने हो गे हवय, <verse eid="LEV 14:3" /><verse number="4" style="v" sid="LEV 14:4" />त पुरोहित ह हुकूम देवय कि ओ मनखे ला सुध ठहिराय बर दू ठन जीयत अऊ सुध चिरई, देवदार के लकरी, लाल रंग के सूंत अऊ जूफा लाने जावय। <verse eid="LEV 14:4" /><verse number="5" style="v" sid="LEV 14:5" />तब पुरोहित ह हुकूम देवय कि माटी के बरतन म ताजा पानी के ऊपर एक ठन चिरई ला बलि करे जावय। <verse eid="LEV 14:5" /><verse number="6" style="v" sid="LEV 14:6" />ओह तब ओ जीयत चिरई ला लेवय अऊ ओला देवदार के लकरी, लाल सूंत अऊ जूफा के संग ताजा पानी के ऊपर बलि करे गय चिरई के लहू म बुड़ोवय। <verse eid="LEV 14:6" /><verse number="7" style="v" sid="LEV 14:7" />तब ओह ओ मनखे ला असुध करइया बेमारी ले सुध ठहिराय बर ओकर ऊपर सात बार छिंचय, अऊ तब ओला सुध ठहिरावय। ओकर बाद, ओ जीयत चिरई ला खुला जगह म छोंड़ देवय।<verse eid="LEV 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 14:8" />“तब ओ मनखे जऊन ला सुध ठहिराय जाथे, ओह अपन ओनहा ला धोवय, अपन जम्मो चुंदी ला कतरावय अऊ पानी म नहावय; तब ओह बिधि के मुताबिक सुध होही। एकर बाद, ओह डेरा के भीतर आ सकत हे, पर सात दिन तक, ओह अपन तम्बू ले बाहिर रहय। <verse eid="LEV 14:8" /><verse number="9" style="v" sid="LEV 14:9" />सातवां दिन ओह अपन जम्मो चुंदी ला मुड़वावय; ओह अपन मुड़, अपन दाढ़ी अऊ अपन भौंह के चुंदी अऊ बाकि चुंदी ला कतरावय। तब ओह अपन ओनहा ला धोवय अऊ पानी म नहावय, अऊ तब ओह सुध होही।<verse eid="LEV 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 14:10" />“आठवां दिन, ओह एक-एक बछर के दू ठन निरदोस मेढ़ा-पीला अऊ एक बछर के एक ठन निरदोस भेड़ी-पीला लेके आवय अऊ अन्न-बलिदान बर संग म जैतून तेल म सनाय एक एपा के तीन-दसवां<note caller="+" style="f"><char style="fr" closed="false">14:10 </char><char style="ft" closed="false">लगभग 5 किलोग्राम</char></note> भाग बढ़िया पीसान लानय अऊ लोज भर<note caller="+" style="f"><char style="fr" closed="false">14:10 </char><char style="ft" closed="false">लगभग 0.3 लीटर; <char style="xt" link-href="LEV 14:12"><ref loc="LEV 14:12">पद 12</ref></char>, <char style="xt" link-href="LEV 14:15"><ref loc="LEV 14:15">15</ref></char>, <char style="xt" link-href="LEV 14:21"><ref loc="LEV 14:21">21</ref></char> अऊ <char style="xt" link-href="LEV 14:24"><ref loc="LEV 14:24">24</ref></char> म घलो</char></note> तेल घलो लानय। <verse eid="LEV 14:10" /><verse number="11" style="v" sid="LEV 14:11" />ओ पुरोहित जऊन ह सुध ठहिराथे, ओह ओ मनखे ला अऊ ओकर बलिदानमन ला यहोवा के आघू म मिलापवाला तम्बू के मुंहटा करा लानय।<verse eid="LEV 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 14:12" />“तब पुरोहित ह एक ठन मेढ़ा-पीला ला लेवय अऊ ओला दोस-बलिदान के रूप म, आधा लीटर तेल के संग यहोवा ला चघावय; ओह हलाय-बलिदान के रूप म ओमन ला यहोवा के आघू म हलाय। <verse eid="LEV 14:12" /><verse number="13" style="v" sid="LEV 14:13" />ओह मेढ़ा-पीला ला पबितर-स्थान के छेत्र म बलि करय, जिहां पाप-बलिदान अऊ होम-बलिदान के पसु ला बलि करे जाथे। पाप-बलिदान सहीं, दोस-बलिदान ह घलो पुरोहित के बांटा अय; येह महा पबितर अय। <verse eid="LEV 14:13" /><verse number="14" style="v" sid="LEV 14:14" />पुरोहित ह दोस-बलिदान के कुछू लहू ला लेवय अऊ सुध होवइया मनखे के जेवनी कान के टीप म, ओकर जेवनी हांथ के अंगठा म अऊ ओकर जेवनी गोड़ के अंगठा म लगावय। <verse eid="LEV 14:14" /><verse number="15" style="v" sid="LEV 14:15" />पुरोहित ह तब ओ आधा लीटर तेल म ले थोरकून लेवय अऊ अपन डेरी हांथ के हथेली म ढारय, <verse eid="LEV 14:15" /><verse number="16" style="v" sid="LEV 14:16" />अऊ ओह अपन जेवनी हांथ के अंगठा के बाद वाले अंगठी ला डेरी हांथ के हथेली के तेल म बुड़ोवय, अऊ अपन अंगठी ले ओमा के कुछू तेल यहोवा के आघू म सात बार छिंचय। <verse eid="LEV 14:16" /><verse number="17" style="v" sid="LEV 14:17" />अपन हथेली म बांचे कुछू तेल ला पुरोहित ह ओ सुध होवइया मनखे के जेवनी कान के टीप म, ओकर जेवनी हांथ के अंगठा म अऊ जेवनी गोड़ के अंगठा म, अऊ दोस-बलिदान के लहू के ऊपर म लगावय। <verse eid="LEV 14:17" /><verse number="18" style="v" sid="LEV 14:18" />अपन हथेली म बांचे तेल ला, पुरोहित ह सुध होवइया मनखे के मुड़ म डार देवय अऊ यहोवा के आघू म ओ मनखे बर प्रायस्चित के बिधि ला पूरा करय।<verse eid="LEV 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 14:19" />“तब पुरोहित ह पाप-बलिदान चघावय अऊ ओ मनखे ला ओकर असुधता ले सुध करे बर प्रायस्चित के बिधि ला पूरा करय। ओकर बाद, पुरोहित ह होम-बलिदान के पसु ला बलि करय <verse eid="LEV 14:19" /><verse number="20" style="v" sid="LEV 14:20" />अऊ येला अन्न-बलिदान के संग बेदी म चघावय, अऊ ओ मनखे बर प्रायस्चित के बिधि ला पूरा करय, अऊ ओह सुध ठहिरही।<verse eid="LEV 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 14:21" />“पर, कहूं, ओह गरीब अय अऊ अतेक नइं दे सकय, त ओह अपन प्रायस्चित करे बर एक ठन मेढ़ा-पीला दोस-बलिदान के रूप म हलाय बर लेवय, अऊ संग म अन्न-बलिदान बर तेल म सनाय एपा के दसवां भाग<note caller="+" style="f"><char style="fr" closed="false">14:21 </char><char style="ft" closed="false">लगभग 1.6 किलोग्राम</char></note> बहुंत बढ़िया पीसान अऊ आधा लीटर तेल लेवय, <verse eid="LEV 14:21" /><verse number="22" style="v" sid="LEV 14:22" />अऊ अपन हैसियत के मुताबिक, ओह दू ठन पंड़की या दू ठन परेवा पीला लानय; येमा के एक ठन ह पाप-बलिदान अऊ दूसर ह होम-बलिदान बर होही।<verse eid="LEV 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 14:23" />“आठवां दिन ओह ये जम्मो ला अपन सुध होय बर मिलापवाला तम्बू के मुंहटा म यहोवा के आघू म पुरोहित करा लानय। <verse eid="LEV 14:23" /><verse number="24" style="v" sid="LEV 14:24" />पुरोहित ह दोस-बलिदान के रूप म मेढ़ा-पीला ला आधा लीटर तेल के संग लेवय, अऊ ओमन ला हलाय-बलिदान के रूप म यहोवा के आघू म हलावय। <verse eid="LEV 14:24" /><verse number="25" style="v" sid="LEV 14:25" />ओह दोस-बलिदान बर मेढ़ा-पीला ला बलि करय अऊ येमा के कुछू लहू ला लेवय अऊ सुध होवइया मनखे के जेवनी कान के टीप म, ओकर जेवनी हांथ के अंगठा म अऊ जेवनी गोड़ के अंगठा म लगावय। <verse eid="LEV 14:25" /><verse number="26" style="v" sid="LEV 14:26" />पुरोहित ह कुछू तेल ला अपन डेरी हांथ के हथेली म ढारय, <verse eid="LEV 14:26" /><verse number="27" style="v" sid="LEV 14:27" />अऊ अपन जेवनी हांथ के अंगठा के बाजू वाले अंगठी म हथेली के कुछू तेल ला लेके यहोवा के आघू म सात बार छिंचय। <verse eid="LEV 14:27" /><verse number="28" style="v" sid="LEV 14:28" />तब पुरोहित ह अपन हथेली के कुछू तेल ला लेके ओ जगह म लगावय, जऊन जगह म ओह दोस-बलिदान के लहू ला लगाथे—याने कि सुध होवइया मनखे के जेवनी कान के टीप म, ओकर जेवनी हांथ के अंगठा म अऊ जेवनी गोड़ के अंगठा म लगावय। <verse eid="LEV 14:28" /><verse number="29" style="v" sid="LEV 14:29" />अपन हथेली म बांचे तेल ला पुरोहित ह ओ सुध होवइया मनखे के मुड़ म ढारय, ताकि यहोवा के आघू म ओ मनखे के प्रायस्चित के बिधि ह पूरा होवय। <verse eid="LEV 14:29" /><verse number="30" style="v" sid="LEV 14:30" />तब ओह अपन हैसियत के मुताबिक पंड़कीमन या परेवा-पीलामन ला चघावय, <verse eid="LEV 14:30" /><verse number="31" style="v" sid="LEV 14:31" />एक ठन ला पाप-बलिदान अऊ दूसर ला होम-बलिदान के रूप म, अन्न-बलिदान के संग चघावय। ये किसम ले, सुध होवइया मनखे के तरफ ले, पुरोहित ह यहोवा के आघू म प्रायस्चित के बिधि ला पूरा करही।”<verse eid="LEV 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 14:32" />येमन ओ मनखे बर सुध होय के नियम अंय, जऊन ला असुध करइया चमड़ी के बेमारी हवय अऊ ओमन गरीब अंय।<verse eid="LEV 14:32" /></para>
  <para style="s1">घर के असुध बेमारी ले सुध होवई</para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 14:33" />यहोवा ह मूसा अऊ हारून ला कहिस, <verse eid="LEV 14:33" /><verse number="34" style="v" sid="LEV 14:34" />“जब तुमन कनान देस म हबरहू, जेला मेंह तुमन ला तुम्हर अधिकार म देवत हंव, अऊ कहूं मेंह ओ देस म कोनो घर म बगरनेवाला बेमारी भेजंव, <verse eid="LEV 14:34" /><verse number="35" style="v" sid="LEV 14:35" />त ओ घर के मालिक ह जाके पुरोहित ला बतावय, ‘मेंह अपन घर म अइसन चीज देखे हंव, जऊन ह असुध करइया फफूंदी सहीं लगथे।’ <verse eid="LEV 14:35" /><verse number="36" style="v" sid="LEV 14:36" />एकर पहिली कि पुरोहित ह ओ घर म जाके बेमारी के जांच करय, ओह घर के सामान ला खाली करे के हुकूम देवय, ताकि घर के कोनो चीज असुध झन ठहिरय। एकर बाद, पुरोहित ह घर भीतर जाके जांच करय। <verse eid="LEV 14:36" /><verse number="37" style="v" sid="LEV 14:37" />ओह भीथीमन म बेमारी के जांच करय, अऊ यदि येह हरियर या लाल रंग के हवय अऊ भीथी के सतह ले धंसे सहीं दिखय, <verse eid="LEV 14:37" /><verse number="38" style="v" sid="LEV 14:38" />त पुरोहित ह घर ले बाहिर मुंहटा म जाके, ओ घर ला सात दिन बर बंद कर देवय। <verse eid="LEV 14:38" /><verse number="39" style="v" sid="LEV 14:39" />सातवां दिन, पुरोहित ह आके ओ घर के जांच करय। कहूं बेमारी ह घर के भीथीमन म बगर गे हवय, <verse eid="LEV 14:39" /><verse number="40" style="v" sid="LEV 14:40" />त पुरोहित ह हुकूम देवय कि जऊन पथरामन दूसित हो गे हवंय, ओमन ला निकालके सहर के बाहिर कोनो असुध जगह म फटिक दिये जावय। <verse eid="LEV 14:40" /><verse number="41" style="v" sid="LEV 14:41" />ओह घर के भीतर के चारों कोति के भीथी ला खुरचय अऊ खुरचे माटी ला सहर के बाहिर, कोनो असुध जगह म डार देवय। <verse eid="LEV 14:41" /><verse number="42" style="v" sid="LEV 14:42" />तब ओह निकाले गे पथरामन के जगह म आने पथरा लगावय अऊ ताजा गारा लेके घर ला छाबय।<verse eid="LEV 14:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LEV 14:43" />“घर के पथरामन ला बदले, घर ला खुरचे अऊ छाबे के बाद, कहूं असुध करइया फफूंदी ह फेर दिखथे, <verse eid="LEV 14:43" /><verse number="44" style="v" sid="LEV 14:44" />त पुरोहित ह घर भीतरी जाके जांच करय। अऊ, कहूं फफूंदी ह घर म बगर गे हवय, त येह लगातार बने रहइया असुध करइया फफूंदी अय; ओ घर ह असुध अय। <verse eid="LEV 14:44" /><verse number="45" style="v" sid="LEV 14:45" />ओ घर ला गिरा दिये जावय—ओकर पथरा, लकरी अऊ घर के जम्मो मलमा ला सहर के बाहिर कोनो असुध जगह म ले जावय।<verse eid="LEV 14:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LEV 14:46" />“जब घर ह बंद रहिथे, ओ समय यदि कोनो घर के भीतर जाथे, त ओह संझा के होवत तक असुध ठहिरय। <verse eid="LEV 14:46" /><verse number="47" style="v" sid="LEV 14:47" />ओ मनखे जऊन ह ओ घर म सुतथे या खाथे, ओह अपन ओनहा ला जरूर धोवय।<verse eid="LEV 14:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LEV 14:48" />“पर कहूं पुरोहित ह भीतर म आके जांच करथे अऊ देखथे कि घर ला फेर से छाबे के बाद, फफूंदी ह नइं बगरे हवय, त ओह ओ घर ला सुध ठहिरावय, काबरकि असुध करइया फफूंदी ह खतम हो गे हवय। <verse eid="LEV 14:48" /><verse number="49" style="v" sid="LEV 14:49" />अऊ ओ घर ला सुध करे बर, ओह दू ठन चिरई, देवदार के लकरी, लाल सूंत अऊ जूफा लेवय। <verse eid="LEV 14:49" /><verse number="50" style="v" sid="LEV 14:50" />ओह एक ठन माटी के बरतन म ताजा पानी के ऊपर एक ठन चिरई ला बलि करय। <verse eid="LEV 14:50" /><verse number="51" style="v" sid="LEV 14:51" />तब ओह ओ जीयत चिरई के संग देवदार के लकरी, जूफा, लाल सूंत ला लेवय अऊ येमन ला बलि करे गे चिरई के लहू म अऊ ताजा पानी म बुड़ोवय अऊ घर म सात बार छिंचय। <verse eid="LEV 14:51" /><verse number="52" style="v" sid="LEV 14:52" />ओह ओ घर ला चिरई के लहू, ताजा पानी, जीयत चिरई, देवदार के लकरी, जूफा अऊ लाल सूंत के दुवारा सुध करय। <verse eid="LEV 14:52" /><verse number="53" style="v" sid="LEV 14:53" />तब ओह जीयत चिरई ला सहर के बाहिर खुला जगह म छोंड़ देवय। ये किसम ले ओह घर बर प्रायस्चित के बिधि ला पूरा करही, अऊ ओ घर ह सुध हो जाही।”<verse eid="LEV 14:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="LEV 14:54" />कोनो असुध करइया चमड़ी के बेमारी, घाव, <verse eid="LEV 14:54" /><verse number="55" style="v" sid="LEV 14:55" />ओनहा या घर म असुध करइया फफूंदी, <verse eid="LEV 14:55" /><verse number="56" style="v" sid="LEV 14:56" />सूजन, चकत्ता, या चमकत दाग के बिसय म ये नियम अंय। <verse eid="LEV 14:56" /><verse number="57" style="v" sid="LEV 14:57" />ये बिधिमन के दुवारा पता चलथे कि कोनो चीज ह सुध हवय या असुध।</para>
  <para style="p" vid="LEV 14:57">असुध करइया चमड़ी के बेमारी अऊ असुध करइया फफूंदी के बिसय म ये नियम अंय।<verse eid="LEV 14:57" /></para>
  <chapter eid="LEV 14" />
  <chapter number="15" style="c" sid="LEV 15" />
  <para style="s1">देहें ले निकले चीज जेकर से असुधता होथे</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 15:1" />यहोवा ह मूसा अऊ हारून ला फेर कहिस, <verse eid="LEV 15:1" /><verse number="2" style="v" sid="LEV 15:2" />“इसरायलीमन ले गोठियावव अऊ ओमन ला कहव: ‘जब कोनो मनखे के देहें ले असामान्‍य रूप म कुछू चीज निकलथे, त ओ चीज ह असुध अय। <verse eid="LEV 15:2" /><verse number="3" style="v" sid="LEV 15:3" />चाहे ओ चीज ह ओकर देहें ले लगातार निकलत रहय या बंद हो जावय, येह ओला असुध करही। ये किसम ले, ओकर देहें ले निकले चीज ह ओला असुध करही:<verse eid="LEV 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 15:4" />“ ‘जऊन बिस्तर म धातवाले ह सुतथे, ओह असुध हो जाही, अऊ जऊन कोनो चीज म ओह बईठथे, ओह घलो असुध हो जाही। <verse eid="LEV 15:4" /><verse number="5" style="v" sid="LEV 15:5" />जऊन कोनो ओकर बिस्तर ला छूथे, ओह अपन ओनहा ला धोवय अऊ पानी ले नहावय, अऊ ओह संझा के होवत तक असुध ठहिरही। <verse eid="LEV 15:5" /><verse number="6" style="v" sid="LEV 15:6" />जऊन कोनो ओ चीज म बईठथे, जेमा धातवाले ह बईठे रिहिस, त ओह अपन ओनहा ला धोवय अऊ पानी ले नहावय, अऊ ओह संझा के होवत तक असुध ठहिरही।<verse eid="LEV 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 15:7" />“ ‘जऊन कोनो धातवाले ला छू लेथे, ओह अपन ओनहा ला धोवय अऊ पानी ले नहावय, अऊ ओह संझा के होवत तक असुध ठहिरही।<verse eid="LEV 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 15:8" />“ ‘कहूं कोनो धातवाले ह कोनो सुध मनखे ऊपर थूक देथे, त ओह अपन ओनहा ला धोवय अऊ पानी ले नहावय, अऊ ओह संझा के होवत तक असुध ठहिरही।<verse eid="LEV 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 15:9" />“ ‘धातवाले ह जऊन चीज म बईठके सवारी करथे, ओ आसन ह असुध ठहिरय, <verse eid="LEV 15:9" /><verse number="10" style="v" sid="LEV 15:10" />अऊ जऊन ह कोनो चीज ला, जेह ओकर खाल्हे म रिहिस, छू लेथे, त ओह संझा के होवत तक असुध ठहिरही; जऊन कोनो ओ चीजमन ला उठाथे, ओह अपन ओनहा ला धोवय अऊ पानी ले नहावय, अऊ ओह संझा के होवत तक असुध ठहिरही।<verse eid="LEV 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 15:11" />“ ‘जऊन कोनो मनखे ला धातवाले ह पानी म हांथ धोये बिगर छू लेथे, त ओह अपन ओनहा ला धोवय अऊ पानी ले नहावय, अऊ ओह संझा के होवत तक असुध ठहिरही।<verse eid="LEV 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 15:12" />“ ‘धातवाले ह माटी के कोनो बरतन ला छू लेथे, त ओ बरतन ला फोर दिये जावय, अऊ कठवा के बने जम्मो चीज ला पानी म धोय जावय।<verse eid="LEV 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 15:13" />“ ‘जब धातवाले ह अपन तकलीफ ले बने हो जाथे, तब ओह बिधि मुताबिक अपन सुध होय के सात दिन गन लेवय; तब ओह अपन ओनहा ला धोवय अऊ ताजा पानी म नहावय, अऊ ओह सुध हो जाही। <verse eid="LEV 15:13" /><verse number="14" style="v" sid="LEV 15:14" />आठवां दिन ओह दू ठन पंड़की या दू ठन परेवा पीला लेवय अऊ मिलापवाला तम्बू के मुंहटा म यहोवा के आघू म जाके ओमन ला पुरोहित ला देवय। <verse eid="LEV 15:14" /><verse number="15" style="v" sid="LEV 15:15" />पुरोहित ह ओमा ले एक ठन ला पाप-बलिदान बर अऊ दूसर ला होम-बलिदान बर चघावय। ये किसम ले, पुरोहित ह ओ मनखे बर ओकर धात के रोग के कारन यहोवा के आघू म प्रायस्चित के बिधि ला पूरा करही।<verse eid="LEV 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 15:16" />“ ‘जब कोनो आदमी के बीर्य ह निकल जावय, त ओह पानी म पूरा नहावय, अऊ ओह संझा के होवत तक असुध ठहिरही। <verse eid="LEV 15:16" /><verse number="17" style="v" sid="LEV 15:17" />कोनो ओनहा या चाम के चीज, जऊन म बीर्य लगे हवय, ओला पानी म धोय जावय, अऊ येह संझा के होवत तक असुध ठहिरही। <verse eid="LEV 15:17" /><verse number="18" style="v" sid="LEV 15:18" />जब कोनो आदमी के सारीरिक संबंध कोनो माईलोगन के संग होथे अऊ बीर्य निकलथे, त ओ दूनों झन पानी म नहावंय, अऊ ओमन संझा के होवत तक असुध ठहिरहीं।<verse eid="LEV 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 15:19" />“ ‘जब कोनो माईलोगन ला मासिक धरम होवय, त ओ समय म ओह सात दिन तक असुध ठहिरही, अऊ जऊन कोनो ओला छूथे, ओह संझा के होवत तक असुध ठहिरही।<verse eid="LEV 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 15:20" />“ ‘अपन मासिक धरम के समय, ओह जऊन चीज म सुतथे, ओ चीज ह असुध ठहिरही, अऊ जऊन चीज म ओह बईठथे, ओह घलो असुध ठहिरही। <verse eid="LEV 15:20" /><verse number="21" style="v" sid="LEV 15:21" />जऊन कोनो ओ माईलोगन के बिस्तर ला छूथे, ओह असुध ठहिरही; ओह अपन ओनहा ला धोवय अऊ पानी म नहावय अऊ ओह संझा के होवत तक असुध ठहिरही। <verse eid="LEV 15:21" /><verse number="22" style="v" sid="LEV 15:22" />जऊन कोनो अइसने कोनो चीज ला छू लेथे, जेमा ओ माईलोगन ह बईठे रिहिस, त ओह असुध ठहिरही; ओह अपन ओनहा ला धोवय अऊ पानी म नहावय, अऊ ओह संझा के होवत तक असुध ठहिरही। <verse eid="LEV 15:22" /><verse number="23" style="v" sid="LEV 15:23" />चाहे येह बिस्तर होवय या कोनो अऊ चीज, जेमा ओ माईलोगन ह बईठे रिहिस, जब कोनो येला छू लेथे, त ओह संझा के होवत तक असुध ठहिरही।<verse eid="LEV 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 15:24" />“ ‘कहूं कोनो आदमी ह ओकर संग सारीरिक संबंध बनाथे अऊ ओ माईलोगन के मासिक धरम के लहू ह ओला लग जाथे, त ओ आदमी ह सात दिन तक असुध हो जाही; अऊ जऊन बिस्तर म ओह सुतथे, ओह घलो असुध ठहिरही।<verse eid="LEV 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 15:25" />“ ‘जब कोनो माईलोगन ला ओकर मासिक धरम के समय ले जादा दिन तक लहू बोहावत रहिथे या ओकर मासिक धरम के समय के बाद घलो ओकर लहू बोहावत रहिथे, त जब तक ओकर लहू बोहावत रहिही, तब तक ओह वइसने ही असुध ठहिरही, जइसने कि अपन मासिक धरम के दिन म ठहिरथे। <verse eid="LEV 15:25" /><verse number="26" style="v" sid="LEV 15:26" />जऊन बिस्तर म ओह अइसने लहू बोहाय के दिन म सुतथे, त ओ बिस्तर घलो असुध ठहिरही, जइसने कि ओकर मासिक धरम के समय म असुध ठहिरथे, अऊ ओ माईलोगन जऊन चीज म बईठथे, ओ चीज ह घलो असुध ठहिरही, जइसने कि ओकर मासिक धरम के दिन म ठहिरथे। <verse eid="LEV 15:26" /><verse number="27" style="v" sid="LEV 15:27" />जऊन कोनो ओ चीजमन ला छूथे, ओह असुध ठहिरही; ओह अपन ओनहा ला धोवय अऊ पानी म नहावय, अऊ ओह संझा के होवत तक असुध ठहिरही।<verse eid="LEV 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 15:28" />“ ‘जब ओ माईलोगन ह अपन लहू बोहाय ले सुध हो जाथे, त ओह सात दिन गनय, अऊ ओकर बाद बिधि के मुताबिक ओह सुध हो जाही। <verse eid="LEV 15:28" /><verse number="29" style="v" sid="LEV 15:29" />आठवां दिन ओह दू ठन पंड़की या दू ठन परेवा पीला लेवय अऊ ओमन ला मिलापवाला तम्बू के मुंहटा म पुरोहित करा लानय। <verse eid="LEV 15:29" /><verse number="30" style="v" sid="LEV 15:30" />पुरोहित ह एक ठन चिरई ला पाप-बलिदान अऊ दूसर ला होम-बलिदान के रूप म चघावय। ये किसम ले, पुरोहित ह ओकर लहू बोहाय के असुधता के सेति यहोवा के आघू म ओकर बर प्रायस्चित के बिधि ला पूरा करही।<verse eid="LEV 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 15:31" />“ ‘तुमन इसरायलीमन ला ओ चीजमन ले अलग रखव, जऊन चीजमन ओमन ला असुध करथें, नइं तो ओमन मोर निवास के जगह,<note caller="+" style="f"><char style="fr" closed="false">15:31 </char><char style="ft" closed="false">या </char><char style="fq" closed="false">मोर </char><char style="fqa" closed="false">पबितर-तम्बू</char></note> जऊन ह ओमन के बीच हवय, ओला असुध करहीं अऊ ओकरे कारन अपन असुधता म मर जाहीं।’ ”<verse eid="LEV 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 15:32" />धात के बिमरहा, अऊ जऊन आदमी के बीर्य ह निकल जाथे, जेकर ले ओह असुध ठहिरथे, <verse eid="LEV 15:32" /><verse number="33" style="v" sid="LEV 15:33" />ओ माईलोगन जऊन ह मासिक धरम के कारन असुध हवय, कोनो आदमी के बीर्य निकलय या माईलोगन के लहू बोहावय, या कोनो आदमी, जऊन ह असुध माईलोगन संग सारीरिक संबंध बनाथे, ये जम्मो बर ये बिधिमन अंय।<verse eid="LEV 15:33" /></para>
  <chapter eid="LEV 15" />
  <chapter number="16" style="c" sid="LEV 16" />
  <para style="s1">प्रायस्चित के दिन</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 16:1" />जब हारून के दू झन बेटामन यहोवा के आघू म जाके मर गीन,<note caller="+" style="f"><char style="fr" closed="false">16:1 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="LEV 10:1-2">लैव्य 10:1‑2</ref></char></char></note> त एकर बाद यहोवा ह मूसा ले गोठियाईस। <verse eid="LEV 16:1" /><verse number="2" style="v" sid="LEV 16:2" />यहोवा ह मूसा ला कहिस, “अपन भाई हारून ला कह कि ओह सन्दूक के ऊपर बने प्रायस्चित के ढकना के आघू, परदा के भीतर महा पबितर स्थान म, घेरी-बेरी झन आवय, नइं तो ओह मर जाही, काबरकि मेंह प्रायस्चित के ढकना के ऊपर बादर म परगट होहूं।<verse eid="LEV 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 16:3" />“हारून ह महा पबितर स्थान म ये किसम ले आवय: जरूरी अय कि ओह पहिले पाप-बलिदान के खातिर एक ठन जवान बछवा अऊ होम-बलिदान के खातिर एक ठन मेढ़ा ला लेके आवय। <verse eid="LEV 16:3" /><verse number="4" style="v" sid="LEV 16:4" />ओह मलमल के पबितर अंगरखा अऊ अपन देहें म मलमल के कच्छा पहिरय अऊ मलमल के कमरबंध कसके मलमल के पागा बांधय। येमन पबितर ओनहा अंय। ओह पानी म नहाके ही येमन ला पहिरय। <verse eid="LEV 16:4" /><verse number="5" style="v" sid="LEV 16:5" />फेर ओह इसरायली समाज ले पाप-बलिदान के खातिर दू ठन बोकरा अऊ होम-बलिदान के चढ़ावा खातिर एक ठन मेढ़ा लेवय।<verse eid="LEV 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 16:6" />“तब हारून ह ओ पाप-बलिदान के बछवा ला जऊन ह ओकरे खातिर अय, चघाके अपन अऊ अपन परिवार बर प्रायस्चित करय। <verse eid="LEV 16:6" /><verse number="7" style="v" sid="LEV 16:7" />तब ओह ओ दूनों बोकरामन ला लेके मिलापवाला तम्बू के मुंहटा म यहोवा के आघू म ठाढ़ करय। <verse eid="LEV 16:7" /><verse number="8" style="v" sid="LEV 16:8" />हारून ह दूनों बोकरामन बर चिट्ठी डालय, याने कि एक चिट्ठी यहोवा बर अऊ दूसर चिट्ठी अजाजेल<note caller="+" style="f"><char style="fr" closed="false">16:8 </char><char style="ft" closed="false">पाप ला दूरिहा ले जवइया बोकरा; <char style="xt" link-href="LEV 16:10"><ref loc="LEV 16:10">पद 10</ref></char>अऊ <char style="xt" link-href="LEV 16:26"><ref loc="LEV 16:26">26</ref></char>म घलो</char></note> बर। <verse eid="LEV 16:8" /><verse number="9" style="v" sid="LEV 16:9" />जऊन बोकरा बर यहोवा के नांव के चिट्ठी निकलय, ओला हारून ह पाप-बलिदान बनाके चघावय। <verse eid="LEV 16:9" /><verse number="10" style="v" sid="LEV 16:10" />पर जऊन बोकरा बर अजाजेल के नांव के चिट्ठी निकलय, ओला यहोवा के आघू म जीयत ठाढ़ करे जावय ताकि ओकर दुवारा प्रायस्चित करे बर ओला सुन्ना जगह म अजाजेल के रूप म भेजे जावय।<verse eid="LEV 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 16:11" />“तब हारून ह पाप-बलिदान के ओ बछवा ला, जऊन ह ओकरेच बर अय, लानके अपन घराना बर प्रायस्चित करय। ओह ओ पाप-बलिदान के बछवा ला, जऊन ह ओकरेच बर अय, बलि करय। <verse eid="LEV 16:11" /><verse number="12" style="v" sid="LEV 16:12" />अऊ ओह यहोवा के आघू बेदी म के बरत कोइला ले भरे धूपदान अऊ दू मुठा चिक्कन पिसे खुसबूवाला धूप ला लेके परदा के भीतर जावय। <verse eid="LEV 16:12" /><verse number="13" style="v" sid="LEV 16:13" />ओह ओ धूप ला यहोवा के आघू म आगी के ऊपर डारय, जेकर ले धूप के कुहरा ह करार कानून के पटियामन ऊपर प्रायस्चित के ढकना ला भर लेवय, ताकि ओह झन मरय। <verse eid="LEV 16:13" /><verse number="14" style="v" sid="LEV 16:14" />फेर ओह बछवा के लहू म ले थोरकून ला लेके अंगठी ले प्रायस्चित के ढकना के ऊपर सामने म छिंचय अऊ ओ लहू म ले थोरकून ला प्रायस्चित के ढकना के आघू म घलो अंगठी ले सात बार छिंचय।<verse eid="LEV 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 16:15" />“तब ओह पाप-बलिदान के ओ बोकरा ला, जऊन ह मनखेमन बर अय, बलि करय अऊ ओकर लहू ला परदा के भीतर लावय अऊ ये लहू के संग वइसनेच करय, जइसे बछवा के लहू के संग करे रिहिस। ओह येला प्रायस्चित के ढकना के ऊपर अऊ ओकर आघू म छिंचय। <verse eid="LEV 16:15" /><verse number="16" style="v" sid="LEV 16:16" />इसरायलीमन के असुधता अऊ बिदरोह के कारन, अऊ जऊन कुछू पाप ओमन करे हवंय, ओकर कारन, ओह ये किसम ले महा पबितर स्थान बर प्रायस्चित करय। ओह मिलापवाला तम्बू बर घलो, जऊन ह ओमन के असुधता म ओमन के बीच म रहिथे, अइसने ही करय। <verse eid="LEV 16:16" /><verse number="17" style="v" sid="LEV 16:17" />जब हारून ह प्रायस्चित करे बर महा पबितर स्थान म जावय, त जब तक ओह अपन, अपन घराना अऊ इसरायल के जम्मो समाज बर प्रायस्चित करके बाहिर नइं निकलय, तब तक कोनो मनखे मिलापवाला तम्बू म झन रहय।<verse eid="LEV 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 16:18" />“तब ओह बाहिर निकलके ओ बेदी के तीर म जावय, जऊन ह यहोवा के आघू म हवय अऊ ओकरे बर प्रायस्चित करय, याने बछवा अऊ बोकरा दूनों के लहू म ले थोरकून ला लेके बेदी के सींगमन म जम्मो कोति लगावय। <verse eid="LEV 16:18" /><verse number="19" style="v" sid="LEV 16:19" />अऊ अपन अंगठी ले ओ लहू म ले थोरकून लेके बेदी ऊपर सात बार छिंचके, ओला इसरायलीमन के असुधता ले सुध अऊ पबितर करय।<verse eid="LEV 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 16:20" />“जब हारून ह महा पबितर स्थान, मिलापवाला तम्बू, अऊ बेदी बर प्रायस्चित कर डारय, तब ओ जीयत बोकरा ला तीर म लावय। <verse eid="LEV 16:20" /><verse number="21" style="v" sid="LEV 16:21" />तब हारून ह जीयत बोकरा के मुड़ के ऊपर अपन दूनों हांथ ला मढ़ावय अऊ ओकर ऊपर इसरायलीमन के जम्मो अधरम अऊ ओमन के जम्मो अपराध अऊ पाप ला मान लेवय। ओह ओमन ला ओ बोकरा के मुड़ म डारके ओला एक झन मनखे के हांथ ले, जऊन ला इही काम बर रखे गय हवय, सुन्ना जगह म भेज देवय। <verse eid="LEV 16:21" /><verse number="22" style="v" sid="LEV 16:22" />ओ बोकरा ह ओमन के जम्मो अधरम ला अपन ऊपर बोहके कोनो सुन्ना जगह म चल दीही। ओ मनखे ह ओ बोकरा ला सुन्ना जगह म छोंड़ देवय।<verse eid="LEV 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 16:23" />“तब हारून ह मिलापवाला तम्बू म आके मलमल के ओ जम्मो ओनहा, जऊन ला ओह महा पबितर स्थान म जाय के बेरा पहिरे रिहिस, ओमन ला ओही मेर छोंड़ देवय। <verse eid="LEV 16:23" /><verse number="24" style="v" sid="LEV 16:24" />फेर ओह पबितर-स्थान के छेत्र म पानी ले नहाके अपनेच ओनहा ला पहिर लेवय अऊ बाहिर म आके अपन बर अऊ मनखेमन बर घलो होम-बलिदान चघाके अपन बर अऊ मनखेमन बर प्रायस्चित करय। <verse eid="LEV 16:24" /><verse number="25" style="v" sid="LEV 16:25" />अऊ पाप-बलिदान के चरबी ला ओह बेदी म जलावय।<verse eid="LEV 16:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 16:26" />“जऊन मनखे ह बोकरा ला अजाजेल के रूप म छोंड़े हवय, ओह अपन ओनहा ला धोवय, पानी ले नहावय, तभे डेरा के भीतर आवय। <verse eid="LEV 16:26" /><verse number="27" style="v" sid="LEV 16:27" />पर पाप-बलिदान के बछवा अऊ पाप-बलिदान के बोकरा, जेकर लहू ला महा पबितर स्थान म प्रायस्चित करे बर लाने गे रिहिस, ओमन ला डेरा के बाहिर म ले जाके ओकर खाल, मांस, अऊ गोबर ला आगी म जलाय जावय। <verse eid="LEV 16:27" /><verse number="28" style="v" sid="LEV 16:28" />तब ओमन ला जरोइया ह अपन ओनहा ला धोवय अऊ पानी ले नहावय। एकर बाद ही ओह डेरा के भीतर आवय।<verse eid="LEV 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 16:29" />“येह तुम्हर बर एक ठन सदा के बिधि ठहिरय: हर साल सातवां महिना के दसवां दिन तुमन अपनआप के इनकार करव।<note caller="+" style="f"><char style="fr" closed="false">16:29 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">जरूर उपास करव</char></note> ओ दिन कोनो मनखे, कहूं ओह देस म जनमे मनखे होवय या तुम्हर बीच म रहइया परदेसी, कोनो काम-बुता झन करहू। <verse eid="LEV 16:29" /><verse number="30" style="v" sid="LEV 16:30" />काबरकि इही दिन तुमन ला सुध करे के खातिर तुम्हर बर प्रायस्चित करे जाही, अऊ तुमन अपन जम्मो पापमन ले यहोवा के आघू म सुध ठहिरहू। <verse eid="LEV 16:30" /><verse number="31" style="v" sid="LEV 16:31" />ये दिन ह बिसराम के दिन अय, अऊ जरूरी अय कि तुमन अपनआप के इनकार करव।<note caller="+" style="f"><char style="fr" closed="false">16:31 </char><char style="ft" closed="false">उपास करव अऊ पूरा बिसराम करव</char></note> येह सदा के एक बिधि अय। <verse eid="LEV 16:31" /><verse number="32" style="v" sid="LEV 16:32" />अऊ जऊन पुरोहित ला अपन ददा के जगह म महा पुरोहित के रूप म काम करे बर अभिसेक अऊ संस्कार करे गे हवय, ओही ह प्रायस्चित करय। ओह मलमल के ओनहा याने पबितर ओनहा ला पहिरके <verse eid="LEV 16:32" /><verse number="33" style="v" sid="LEV 16:33" />जम्मो महा पबितर स्थान, मिलापवाला तम्बू, अऊ बेदी बर प्रायस्चित करय। ओह पुरोहित अऊ समाज के जम्मो सदस्य बर घलो प्रायस्चित करय।<verse eid="LEV 16:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LEV 16:34" />“येह तुम्हर बर सदा के बिधि ठहिरय कि इसरायलीमन बर एक बछर म एक बार ओमन के जम्मो पाप बर प्रायस्चित करे जावय।”</para>
  <para style="p" vid="LEV 16:34">अऊ जइसे यहोवा ह मूसा ला हुकूम देय रिहिस, वइसनेच करे गीस।<verse eid="LEV 16:34" /></para>
  <chapter eid="LEV 16" />
  <chapter number="17" style="c" sid="LEV 17" />
  <para style="s1">लहू खाय बर मनाही</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 17:1" />यहोवा ह मूसा ला कहिस, <verse eid="LEV 17:1" /><verse number="2" style="v" sid="LEV 17:2" />“हारून अऊ ओकर बेटामन ला अऊ जम्मो इसरायलीमन ला कह: ‘यहोवा ह ये हुकूम दे हवय: <verse eid="LEV 17:2" /><verse number="3" style="v" sid="LEV 17:3" />यदि कोनो इसरायली मनखे कोनो बछवा, मेढ़ा-पीला या बोकरा ला डेरा के भीतर या डेरा के बाहिर बलि चघाथे, <verse eid="LEV 17:3" /><verse number="4" style="v" sid="LEV 17:4" />पर ओला मिलापवाला तम्बू के मुंहटा करा यहोवा के पबितर-तम्बू के आघू म यहोवा ला बलि चघाय बर नइं लानय, त ओ मनखे ह लहू बहाय के दोसी समझे जाही; ओ मनखे ह लहू बहाय हवय; ओला अपन मनखेमन के समाज ले अलग करे जावय। <verse eid="LEV 17:4" /><verse number="5" style="v" sid="LEV 17:5" />ये बिधि के कारन ये अय ताकि इसरायलीमन अपन बलिदान यहोवा करा लानंय, पर खुला जगह म बलिदान झन करंय। ओमन अपन बलिदान ला मिलापवाला तम्बू के मुंहटा म पुरोहित करा लानके मेल-बलिदान के रूप म यहोवा ला चघावंय। <verse eid="LEV 17:5" /><verse number="6" style="v" sid="LEV 17:6" />पुरोहित ह लहू ला मिलापवाला तम्बू के मुंहटा म यहोवा के बेदी के चारों कोति छिंचय अऊ चरबी ला यहोवा बर सुख-देवइया सुगंध के रूप म जलावय। <verse eid="LEV 17:6" /><verse number="7" style="v" sid="LEV 17:7" />ओमन बोकरा के मूरतीमन<note caller="+" style="f"><char style="fr" closed="false">17:7 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">परेतमन</char></note> ला कोनो बलिदान झन चघावंय, काबरकि अइसने करके ओमन बेभिचारी के सहीं ठहिरथें। येह पीढ़ी दर पीढ़ी ओमन के हमेसा के बिधि ठहिरय।’<verse eid="LEV 17:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 17:8" />“ओमन ला कह: ‘कोनो इसरायली या ओमन के बीच म रहइया कोनो परदेसी ह होम-बलिदान या बलि चघाथे, <verse eid="LEV 17:8" /><verse number="9" style="v" sid="LEV 17:9" />अऊ ओला मिलापवाला तम्बू के मुंहटा म यहोवा करा लानके नइं चघावय, त ओ मनखे ला इसरायली मनखेमन के समाज ले अलग करे जावय।<verse eid="LEV 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 17:10" />“ ‘कोनो इसरायली या ओमन के बीच म रहइया कोनो परदेसी, जऊन ह लहू ला खाथे, त मेंह ओला मनखेमन के बीच ले अलग कर दूहूं। <verse eid="LEV 17:10" /><verse number="11" style="v" sid="LEV 17:11" />काबरकि परानी के परान ह लहू म रहिथे, अऊ येला मेंह तुमन ला एकरसेति दे हंव कि तुमन बेदी म अपन बर प्रायस्चित के बिधि ला पूरा करव; काबरकि ये लहू ही मनखे के जिनगी के प्रायस्चित ला पूरा करथे। <verse eid="LEV 17:11" /><verse number="12" style="v" sid="LEV 17:12" />एकरसेति मेंह इसरायलीमन ला कहिथंव, “न तो तुमन, अऊ न ही तुम्हर बीच म रहइया कोनो परदेसी लहू ला खावय।”<verse eid="LEV 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 17:13" />“ ‘कोनो इसरायली या तुम्हर बीच म रहइया कोनो परदेसी कोनो अइसने पसु या चिरई के सिकार करथे, जऊन ला खाय जा सकत हे, त पहिले ओकर लहू ला बहाके माटी म ढांप दिये जावय, <verse eid="LEV 17:13" /><verse number="14" style="v" sid="LEV 17:14" />काबरकि हर एक जीव के परान ह ओकर लहू म होथे। एकरसेति मेंह इसरायलीमन ला कहे हंव, “तुमन कोनो जीव के लहू ला झन खावव, काबरकि हर एक जीव के परान ह ओकर लहू म होथे; जऊन कोनो ओला खाथे, ओला समाज ले अलग करे जावय।”<verse eid="LEV 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 17:15" />“ ‘कोनो मनखे, चाहे ओह देस म जनमे होवय या परदेसी, यदि ओह पहिले से मरे पसु या कोनो जंगली पसु के दुवारा चिरे-फारे पसु के मांस ला खाथे, त ओला अपन ओनहा ला धोना अऊ पानी म नहाना चाही, अऊ ओह संझा के होवत तक बिधि मुताबिक असुध रहिही; तब ओह सुध होही। <verse eid="LEV 17:15" /><verse number="16" style="v" sid="LEV 17:16" />पर कहूं ओह अपन ओनहा ला नइं धोही अऊ नइं नहाही, त ओह दोसी ठहिरही।’ ”<verse eid="LEV 17:16" /></para>
  <chapter eid="LEV 17" />
  <chapter number="18" style="c" sid="LEV 18" />
  <para style="s1">गैरकानूनी सारीरिक संबंध</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 18:1" />यहोवा ह मूसा ला कहिस, <verse eid="LEV 18:1" /><verse number="2" style="v" sid="LEV 18:2" />“इसरायलीमन ले बात कर अऊ ओमन ला कह: ‘मेंह यहोवा तुम्हर परमेसर अंव। <verse eid="LEV 18:2" /><verse number="3" style="v" sid="LEV 18:3" />तुमन वइसने झन करव, जइसने ओमन मिसर देस म करथें, जिहां तुमन रहत रहेव, अऊ तुमन वइसने झन करव, जइसने ओमन कनान देस म करथें, जिहां मेंह तुमन ला लावत हंव। ओमन के रीति-रिवाज म झन चलव। <verse eid="LEV 18:3" /><verse number="4" style="v" sid="LEV 18:4" />तुमन मोर कानून ला मानव अऊ धियान से मोर बिधि-बिधान म चलव। मेंह यहोवा तुम्हर परमेसर अंव। <verse eid="LEV 18:4" /><verse number="5" style="v" sid="LEV 18:5" />मोर बिधि-बिधान अऊ कानून म चलव, काबरकि जऊन मनखे ह ओमन के पालन करही, ओह ओमन के दुवारा जीयत रहिही। मेंह यहोवा अंव।<verse eid="LEV 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 18:6" />“ ‘तुमन म ले कोनो अपन नजदीकी रिस्तेदार के संग सारीरिक संबंध झन बनावय। मेंह यहोवा अंव।<verse eid="LEV 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 18:7" />“ ‘अपन दाई के संग सारीरिक संबंध बनाय के दुवारा अपन ददा के अनादर झन करव। ओह तो तुम्हर दाई ए; ओकर संग सारीरिक संबंध झन बनावव।<verse eid="LEV 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 18:8" />“ ‘अपन सौतेली दाई के संग घलो सारीरिक संबंध झन बनावव; येह तुम्हर ददा के अनादर होही।<verse eid="LEV 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 18:9" />“ ‘तुमन अपन बहिनी के संग सारीरिक संबंध झन बनावव, चाहे ओह तुम्हर ददा के बेटी होवय या तुम्हर दाई के बेटी, चाहे ओह ओही घर म जनमे होवय या कहूं मेर अऊ।<verse eid="LEV 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 18:10" />“ ‘अपन बेटा के बेटी या अपन बेटी के बेटी संग सारीरिक संबंध झन बनावव; एकर दुवारा तुम्हर अनादर होही।<verse eid="LEV 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 18:11" />“ ‘यदि तुम्हर ददा ह आने घरवाली लानथे अऊ ओह बेटी जनमथे, त ओ बेटी संग घलो सारीरिक संबंध झन बनावव; ओह तुम्हर बहिनी अय।<verse eid="LEV 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 18:12" />“ ‘अपन फूफू के संग सारीरिक संबंध झन बनावव, काबरकि ओह तुम्हर ददा के नजदीकी रिस्तेदार अय।<verse eid="LEV 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 18:13" />“ ‘अपन मौसी के संग सारीरिक संबंध झन बनावव, काबरकि ओह तुम्हर दाई के नजदीकी रिस्तेदार अय।<verse eid="LEV 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 18:14" />“ ‘अपन कका के घरवाली संग सारीरिक संबंध बनाय के दुवारा अपन कका के अनादर झन करव, काबरकि ओकर घरवाली ह तो तुम्हर काकी अय।<verse eid="LEV 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 18:15" />“ ‘अपन बेटा के घरवाली संग सारीरिक संबंध झन बनावव, ओह तो तुम्हर बेटा के घरवाली अय। ओकर संग सारीरिक संबंध झन बनावव।<verse eid="LEV 18:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 18:16" />“ ‘अपन भऊजी या भाई-बहू के संग सारीरिक संबंध झन बनावव, एकर दुवारा भाई के अनादर होही।<verse eid="LEV 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 18:17" />“ ‘कोनो माईलोगन अऊ ओकर बेटी दूनों के संग सारीरिक संबंध झन बनावव। न तो ओ माईलोगन के बेटा के बेटी, अऊ न ही ओ माईलोगन के बेटी के बेटी संग सारीरिक संबंध बनावव; काबरकि ओमन ओकर नजदीकी रिस्तेदार अंय। अइसने करई ह दुस्टता अय।<verse eid="LEV 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 18:18" />“ ‘अपन घरवाली के जीते-जीयत अपन साली ला घलो घरवाली बनाके ओकर संग सारीरिक संबंध झन बनावव।<verse eid="LEV 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 18:19" />“ ‘कोनो माईलोगन के मासिक धरम के असुधता के समय, ओकर संग सारीरिक संबंध झन बनावव।<verse eid="LEV 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 18:20" />“ ‘अपन परोसी के घरवाली के संग सारीरिक संबंध बनाके अपनआप ला अऊ ओला असुध झन करव।<verse eid="LEV 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 18:21" />“ ‘अपन लइकामन ले कोनो ला भी मोलेक देवता बर बलि झन चघावव, काबरकि एकर ले तुम्हर परमेसर के नांव अपबितर होही। में यहोवा अंव।<verse eid="LEV 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 18:22" />“ ‘तुमन कोनो आदमी के संग सारीरिक संबंध झन बनावव, जइसने कि तुमन कोनो माईलोगन के संग बनाथव। येह घिनौना काम अय।<verse eid="LEV 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 18:23" />“ ‘कोनो पसु के संग पसुगमन करके अपनआप ला असुध झन करव। कोनो माईलोगन ह कोनो पसु के संग सारीरिक संबंध बनाय बर अपनआप ला झन देवय; येह अपनआप ला अपबितर करई अय।<verse eid="LEV 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 18:24" />“ ‘अइसने कोनो घलो काम करके अपनआप ला असुध झन करव, काबरकि अइसने काम करके जऊन जाति के मनखेमन अपनआप ला असुध करे हवंय, ओ जम्मो जातिमन ला मेंह तुम्हर आघू ले निकालनेवाला हंव। <verse eid="LEV 18:24" /><verse number="25" style="v" sid="LEV 18:25" />इहां तक कि देस ह असुध हो गीस; एकरसेति मेंह ओला ओकर पाप के सेति दंड दे हंव, जेकर ले ओ देस ह उहां के रहइयामन ला स्वीकार नइं करिस। <verse eid="LEV 18:25" /><verse number="26" style="v" sid="LEV 18:26" />पर तुमन मोर बिधि अऊ कानूनमन ला मानव। तुमन म ले कोनो घलो, चाहे ओह कोनो देस म जनमे मनखे होवय या तुम्हर बीच म रहइया कोनो परदेसी, ये घिनौना काम झन करय, <verse eid="LEV 18:26" /><verse number="27" style="v" sid="LEV 18:27" />काबरकि जऊन मनखेमन तुम्हर पहिली ये देस म रहत रिहिन, ओमन ये काम करत रिहिन, जेकर ले देस ह असुध हो गीस। <verse eid="LEV 18:27" /><verse number="28" style="v" sid="LEV 18:28" />अऊ यदि तुमन देस ला असुध करथव, त येह तुमन ला घलो स्वीकार नइं करही, जइसने येह ओमन ला स्वीकार नइं करिस, जऊन मन तुम्हर पहिली इहां रिहिन।<verse eid="LEV 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 18:29" />“ ‘जऊन मनखे ह येमा के कोनो घलो घिनौना काम करथे, ओला अपन मनखेमन के समाज ले निकाल दिये जावय। <verse eid="LEV 18:29" /><verse number="30" style="v" sid="LEV 18:30" />एकरसेति मोर हुकूममन ला मानव अऊ कोनो ओ घिनौना रीति-रिवाज ला झन मानव, जऊन ला मनखेमन तुम्हर आय के पहिली मानत रिहिन अऊ ओमन के संग अपनआप ला असुध झन करव। मेंह यहोवा तुम्हर परमेसर अंव।’ ”<verse eid="LEV 18:30" /></para>
  <chapter eid="LEV 18" />
  <chapter number="19" style="c" sid="LEV 19" />
  <para style="s1">किसम-किसम के कानून</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 19:1" />फेर यहोवा ह मूसा ला कहिस, <verse eid="LEV 19:1" /><verse number="2" style="v" sid="LEV 19:2" />“इसरायलीमन के जम्मो सभा ले गोठिया अऊ ओमन ला कह: ‘पबितर बनव, काबरकि में, यहोवा तुम्हर परमेसर ह पबितर अंव।<verse eid="LEV 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 19:3" />“ ‘तुमन म ले हर एक झन अपन दाई अऊ ददा के आदर करव, अऊ तुमन मोर बिसराम दिनमन ला मानव। मेंह यहोवा तुम्हर परमेसर अंव।<verse eid="LEV 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 19:4" />“ ‘तुमन मूरतीमन कोति झन लहुंटव अऊ अपन बर धातु के देवता झन बनावव। मेंह यहोवा तुम्हर परमेसर अंव।<verse eid="LEV 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 19:5" />“ ‘जब तुमन यहोवा ला मेल-बलिदान चघावव, त अइसने चघावव कि येह तुम्हर खातिर गरहन करे जावय। <verse eid="LEV 19:5" /><verse number="6" style="v" sid="LEV 19:6" />जऊन दिन तुमन ओला चघावव, ओही दिन या ओकर दूसर दिन ओला खाय जावय; कोनो चीज तीसर दिन तक बांच जावय, त ओला आगी म जला दिये जावय। <verse eid="LEV 19:6" /><verse number="7" style="v" sid="LEV 19:7" />यदि ओमा के कुछू ला तीसर दिन खाय जाथे, त ओह असुध अय अऊ ओला नइं गरहन करे जावय। <verse eid="LEV 19:7" /><verse number="8" style="v" sid="LEV 19:8" />जऊन कोनो ओला खाथे, ओह दोसी ठहिरही, काबरकि ओह यहोवा के पबितर चीज ला अपबितर करे हवय; ओला अपन मनखेमन के समाज ले निकाल दिये जावय।<verse eid="LEV 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 19:9" />“ ‘अपन देस म रहे के बाद, जब तुमन अपन भुइयां के फसल ला लुवव, त अपन खेत के कोना-कोना तक जम्मो ला झन लुवव या लुवाय फसल के गिरे-परे बालमन ला झन संकेलव। <verse eid="LEV 19:9" /><verse number="10" style="v" sid="LEV 19:10" />तुमन अपन अंगूर के बारी म दूसर बार अंगूर टोरे बर झन जावव या अंगूर के बारी म झरे अंगूरमन ला झन संकेलव। ओमन ला गरीब अऊ परदेसीमन बर छोंड़ दव। मेंह यहोवा तुम्हर परमेसर अंव।<verse eid="LEV 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 19:11" />“ ‘तुमन चोरी झन करव।</para>
  <para style="p" vid="LEV 19:11">“ ‘लबारी झन मारव।</para>
  <para style="p" vid="LEV 19:11">“ ‘एक-दूसर ला धोखा झन देवव।<verse eid="LEV 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 19:12" />“ ‘मोर नांव म लबारी किरिया झन खावव अऊ ये किसम ले अपन परमेसर के नांव ला अपबितर झन करव। मेंह यहोवा अंव।<verse eid="LEV 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 19:13" />“ ‘अपन परोसी ला झन ठगव या ओला झन लूटव।</para>
  <para style="p" vid="LEV 19:13">“ ‘बनिहार के बनी रात भर याने कि बिहनियां तक अपन करा रोकके झन रखव।<verse eid="LEV 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 19:14" />“ ‘भैंरा मनखे ला सराप झन देवव या अंधरा के आघू म हपटे बर कुछू झन मढ़ावव, पर अपन परमेसर के भय मानव। मेंह यहोवा अंव।<verse eid="LEV 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 19:15" />“ ‘नियाय ला झन बिगाड़व। गरीब के संग पखियपात या बड़े मनखे के मुहूं-देखी नियाय झन करव, पर अपन परोसी के सही-सही नियाय करव।<verse eid="LEV 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 19:16" />“ ‘अपन मनखेमन के बीच म लबारी बात झन फईलावव।</para>
  <para style="p" vid="LEV 19:16">“ ‘अपन परोसी के हतिया करे के उपाय झन करव।<note caller="+" style="f"><char style="fr" closed="false">19:16 </char><char style="ft" closed="false">अइसने कोनो काम झन करव, जेकर से तुम्हर परोसी के जिनगी खतरा म पड़य</char></note> मेंह यहोवा अंव।<verse eid="LEV 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 19:17" />“ ‘अपन मन म अपन संगी इसरायली ले घिन झन करव। अपन परोसी ला खुले मन से डांटव, ताकि तुमन ओमन के अपराध म भागी झन होवव।<verse eid="LEV 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 19:18" />“ ‘काकरो ले बदला झन लेवव या अपन मनखेमन के बीच म कोनो बर बईरता झन रखव, पर अपन परोसी ले अपन सहीं मया करव। मेंह यहोवा अंव।<verse eid="LEV 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 19:19" />“ ‘मोर बिधिमन ला मानव।</para>
  <para style="p" vid="LEV 19:19">“ ‘आने-आने जाति के पसुमन म संबंध झन करावव।</para>
  <para style="p" vid="LEV 19:19">“ ‘अपन खेत म दू किसम के बीजा एक संग झन बोवव।</para>
  <para style="p" vid="LEV 19:19">“ ‘दू किसम के चीज ले बने ओनहा ला झन पहिरव।<verse eid="LEV 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 19:20" />“ ‘कोनो गुलाम माईलोगन, जेकर मंगनी कोनो मनखे के संग हो गे हवय, पर ओ कुंवारी ला दाम देके नइं छोंड़ाय गे हवय या ओला सुतंतर नइं करे गे हवय; ओकर संग यदि कोनो मनखे ह सारीरिक संबंध बनाथे, त ओमन ला दंड<note caller="+" style="f"><char style="fr" closed="false">19:20 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">छानबीन करे जावय</char></note> तो दिये जावय, पर ओमन झन मार डारे जावंय, काबरकि ओ कुंवारी ला सुतंतर नइं करे गे रिहिस। <verse eid="LEV 19:20" /><verse number="21" style="v" sid="LEV 19:21" />ओ आदमी ह मिलापवाला तम्बू के मुंहटा म यहोवा करा दोस-बलिदान बर एक ठन मेढ़ा लेके आवय। <verse eid="LEV 19:21" /><verse number="22" style="v" sid="LEV 19:22" />पुरोहित ह ओ दोस-बलिदान के मेढ़ा ला यहोवा के आघू म चघाके ओ मनखे के पाप के प्रायस्चित के बिधि ला पूरा करय, तब ओह जऊन पाप करे हवय, ओह छेमा करे जाही।<verse eid="LEV 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 19:23" />“ ‘जब तुमन कनान देस म आवव अऊ उहां कोनो किसम के फर के रूख लगावव, त ओकर फर ला बरजे<note caller="+" style="f"><char style="fr" closed="false">19:23 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">खतनारहित</char></note> कस समझव। तीन बछर ले ओ फर ला तुमन बरजीत समझव; ओला झन खावव। <verse eid="LEV 19:23" /><verse number="24" style="v" sid="LEV 19:24" />चौथा साल ओकर जम्मो फर यहोवा के इस्तुति के बलिदान बर पबितर ठहिरही। <verse eid="LEV 19:24" /><verse number="25" style="v" sid="LEV 19:25" />तब पांचवां साल तुमन ओकर फर ला खा सकत हव। ये किसम ले तुम्हर फसल म बढ़ोतरी होही। मेंह यहोवा तुम्हर परमेसर अंव।<verse eid="LEV 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 19:26" />“ ‘तुमन कोनो घलो मांस ला लहू के संग झन खावव।</para>
  <para style="p" vid="LEV 19:26">“ ‘जादू-टोना झन करव या सुभ-असुभ घरी ला झन मानव।<verse eid="LEV 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 19:27" />“ ‘अपन मुड़ के किनारे के चुंदी ला झन कटावव या अपन दाढ़ी के तीर के बाल ला झन कतरावव।<verse eid="LEV 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 19:28" />“ ‘कोनो मरे मनखे बर अपन देहें ला झन काटव या अपन देहें म गोदना झन गोदावव। मेंह यहोवा अंव।<verse eid="LEV 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 19:29" />“ ‘अपन बेटी ला बेस्या बनाय के दुवारा ओकर अपमान झन करव, नइं तो देस ह बेस्या के काम के कारन बुरई ले भर जाही।<verse eid="LEV 19:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 19:30" />“ ‘मोर बिसराम दिनमन ला मानव अऊ मोर पबितर-स्थान के आदर करव। मेंह यहोवा अंव।<verse eid="LEV 19:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 19:31" />“ ‘बईगामन अऊ भूत-परेत साधोइयामन करा झन जावव, काबरकि तुमन ओमन के दुवारा असुध हो जाहू। मेंह यहोवा तुम्हर परमेसर अंव।<verse eid="LEV 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 19:32" />“ ‘डोकरामन के आघू म उठके ठाढ़ हो जावव; सियानमन के आदर करव अऊ अपन परमेसर के भय मानव। मेंह यहोवा अंव।<verse eid="LEV 19:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 19:33" />“ ‘जब कोनो परदेसी तुम्हर देस म तुम्हर संग रहिथे, त ओकर संग गलत बरताव झन करव। <verse eid="LEV 19:33" /><verse number="34" style="v" sid="LEV 19:34" />जब कोनो परदेसी तुम्हर बीच म रहत हवय, त ओकर संग वइसने बरताव करव, जइसने कि तुमन देसी मनखे के संग करथव। ओकर ले अपन सहीं मया करव, काबरकि तुमन घलो मिसर देस म परदेसी होके रहेव। मेंह यहोवा तुम्हर परमेसर अंव।<verse eid="LEV 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 19:35" />“ ‘जब तुमन कोनो चीज ला नापथव, तऊलथव या गनथव, त ये काम ला ईमानदारी से करव। <verse eid="LEV 19:35" /><verse number="36" style="v" sid="LEV 19:36" />लम्बई नापे के सही पैमाना, भार तऊले बर सही तराजू, मात्रा जाने बर सही एपा<note caller="+" style="f"><char style="fr" closed="false">19:36 </char><char style="ft" closed="false">एपा ह अनाज नापे के 22 लीटर के साधन अय</char></note> अऊ सही हीन<note caller="+" style="f"><char style="fr" closed="false">19:36 </char><char style="ft" closed="false">हीन तरल चीज नापे के साधन अय</char></note> के उपयोग करव। मेंह यहोवा तुम्हर परमेसर अंव, जऊन ह तुमन ला मिसर देस ले निकालके लानिस।<verse eid="LEV 19:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LEV 19:37" />“ ‘मोर जम्मो बिधि-बिधान अऊ मोर जम्मो कानून ला मानव अऊ ओमन के पालन करव। मेंह यहोवा अंव।’ ”<verse eid="LEV 19:37" /></para>
  <chapter eid="LEV 19" />
  <chapter number="20" style="c" sid="LEV 20" />
  <para style="s1">पाप के दंड</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 20:1" />फेर यहोवा ह मूसा ला कहिस, <verse eid="LEV 20:1" /><verse number="2" style="v" sid="LEV 20:2" />“इसरायलीमन ला कह: ‘इसरायल म रहइया कोनो इसरायली या कोनो परदेसी, जऊन ह अपन कोनो लइका ला, मोलेक देवता ला बलिदान चघाथे, त ओह मार डारे जावय। समाज के मनखेमन ओला पथरवाह करके मार डारंय। <verse eid="LEV 20:2" /><verse number="3" style="v" sid="LEV 20:3" />मेंह खुद ओ मनखे के बिरोध म होके ओला ओकर मनखेमन ले मिटा दूहूं; काबरकि मोलेक ला अपन लइका बलिदान करके, ओह मोर पबितर-स्थान ला असुध अऊ मोर पबितर नांव ला अपबितर करे हवय। <verse eid="LEV 20:3" /><verse number="4" style="v" sid="LEV 20:4" />कहूं समाज के मनखेमन अपन आंखी मुंद लेथें, जब ओ मनखे ह अपन कोनो लइका मोलेक ला बलिदान करथे अऊ यदि ओला मार नइं डारंय, <verse eid="LEV 20:4" /><verse number="5" style="v" sid="LEV 20:5" />त मेंह खुद ओ मनखे अऊ ओकर परिवार के बिरोध म होके ओमन ला ओमन के मनखेमन ले अलग कर दूहूं अऊ संग म ओ जम्मो झन ला घलो, जऊन मन ओकर संग देके मोलेक के पाछू चले के दुवारा बेस्या सहीं काम करथें।<verse eid="LEV 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 20:6" />“ ‘जऊन मनखे ह बईगा अऊ भूत-परेत साधोइयामन के पाछू चलके बेस्या सहीं काम करथे, ओकर बिरोध म होके, मेंह ओला ओकर मनखेमन ले अलग कर दूहूं।<verse eid="LEV 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 20:7" />“ ‘एकरसेति अपनआप ला पबितर काम बर अलग करव अऊ पबितर बनव, काबरकि मेंह यहोवा तुम्हर परमेसर अंव। <verse eid="LEV 20:7" /><verse number="8" style="v" sid="LEV 20:8" />मोर बिधि-बिधान ला मानव अऊ ओमन के पालन करव। मेंह यहोवा अंव, जऊन ह तुमन ला पबितर करथे।<verse eid="LEV 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 20:9" />“ ‘जऊन मनखे अपन ददा या दाई ला सराप देथे, ओह मार डारे जावय। ओह अपन ददा या दाई ला सराप देय हवय, एकरसेति ओकर लहू के दोस ओकरेच मुड़ म पड़ही।<verse eid="LEV 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 20:10" />“ ‘कहूं कोनो मनखे कोनो आने मनखे के घरवाली संग—अपन परोसी के घरवाली संग बेभिचार करथे, त ओ बेभिचारी अऊ बेभिचारिन दूनों झन मार डारे जावंय।<verse eid="LEV 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 20:11" />“ ‘कहूं कोनो मनखे ह अपन ददा के घरवाली के संग सारीरिक संबंध बनाथे, त ओह अपन ददा के अनादर करे हवय। ओ मनखे अऊ ओ माईलोगन दूनों झन मार डारे जावंय; ओमन के लहू के दोस ओमन के मुड़ म ही पड़ही।<verse eid="LEV 20:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 20:12" />“ ‘कहूं कोनो मनखे अपन बहुरिया<note caller="+" style="f"><char style="fr" closed="false">20:12 </char><char style="ft" closed="false">बेटा के घरवाली</char></note> संग सारीरिक संबंध बनाथे, त ओ दूनों झन मार डारे जावंय। ओमन असुध काम करे हवंय; ओमन के लहू के दोस ओमन के मुड़ म ही पड़ही।<verse eid="LEV 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 20:13" />“ ‘कहूं कोनो आदमी ह कोनो आदमी संग सारीरिक संबंध बनाथे, जइसने कि कोनो माईलोगन संग बनाय जाथे, त ओ दूनों झन घिन काम करे हवंय। ओमन मार डारे जावंय; ओमन के लहू के दोस ओमन के मुड़ म ही पड़ही।<verse eid="LEV 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 20:14" />“ ‘कहूं कोनो मनखे ह कोनो माईलोगन अऊ ओकर दाई दूनों ले बिहाव करथे, त येह दुस्ट काम अय। ओ मनखे अऊ ओ दूनों माईलोगन ला आगी म जला दिये जावय, ताकि तुम्हर बीच म दुस्ट काम झन होवय।<verse eid="LEV 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 20:15" />“ ‘कहूं कोनो मनखे ह पसु के संग सारीरिक संबंध बनाथे, त ओ मनखे ह मार डारे जावय, अऊ ओ पसु ला घलो मार डारव।<verse eid="LEV 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 20:16" />“ ‘कहूं कोनो माईलोगन ह कोनो पसु करा जाके ओकर संग कुकरम करथे, त ओ माईलोगन अऊ ओ पसु दूनों ला मार डारव। ओमन मार डारे जावंय; ओमन के लहू ह ओमन के मुड़ म ही पड़ही।<verse eid="LEV 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 20:17" />“ ‘कहूं कोनो मनखे ह अपन बहिनी ले बिहाव करथे—चाहे ओह ओकर ददा के बेटी होवय या ओकर दाई के बेटी, अऊ ओकर संग सारीरिक संबंध बनाथे, त येह एक कलंक ए। ओ दूनों झन ला खुलेआम ओमन के मनखेमन ले अलग करे जावय। ओह अपन बहिनी के अनादर करे हवय अऊ ओह दोसी ठहिरही।<verse eid="LEV 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 20:18" />“ ‘कहूं कोनो मनखे ह कोनो माईलोगन के मासिक धरम के समय ओकर संग सारीरिक संबंध बनाथे, त ओह ओ माईलोगन के लहू बहई ला उघारे हवय, अऊ ओ माईलोगन घलो अपन लहू बहई ला उघारे हवय। एकरसेति ओ दूनों झन अपन मनखेमन ले अलग करे जावंय।<verse eid="LEV 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 20:19" />“ ‘अपन मौसी या फूफू के संग सारीरिक संबंध झन बनावव, काबरकि ओह एक नजदीकी रिस्तेदार के अनादर होही; अऊ ओ दूनों दोसी ठहिरहीं।<verse eid="LEV 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 20:20" />“ ‘कहूं कोनो मनखे अपन काकी के संग सारीरिक संबंध बनाथे, त ओह अपन कका के अनादर करथे। ओमन दोसी ठहिरहीं; ओमन बिगर संतान के मर जाहीं।<verse eid="LEV 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 20:21" />“ ‘कहूं कोनो मनखे अपन भाई के घरवाली ले बिहाव करथे, त येह एक असुधता के काम अय; ओह अपन भाई के अनादर करे हवय। ओमन के कोनो संतान नइं होवय।<verse eid="LEV 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 20:22" />“ ‘मोर जम्मो बिधि अऊ हुकूममन ला मानव अऊ ओमन के पालन करव, ताकि जऊन देस म मेंह तुमन ला रहे बर लावत हंव, उहां ले तुमन अलग झन करे जावव। <verse eid="LEV 20:22" /><verse number="23" style="v" sid="LEV 20:23" />तुमन ओ जाति के मनखेमन के रीति-रिवाज के मुताबिक झन चलहू, जेला मेंह तुम्हर आघू ले निकालनेवाला हंव। काबरकि ओमन ये जम्मो काम करे हवंय, एकरसेति मेंह ओमन ले घिन करथंव। <verse eid="LEV 20:23" /><verse number="24" style="v" sid="LEV 20:24" />पर मेंह तुमन ला कहे हंव, “ओमन के देस ह तुम्हर अधिकार म होही; मेंह ये देस, जेमा दूध अऊ मंधरस बहुंतायत म हवय,<note caller="+" style="f"><char style="fr" closed="false">20:24 </char><char style="ft" closed="false">बहुंत उपजाऊ भुइयां</char></note> तुम्हर अधिकार म दे दूहूं।” मेंह यहोवा तुम्हर परमेसर अंव, जऊन ह तुमन ला आने देस के मनखेमन ले अलग करे हवय।<verse eid="LEV 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 20:25" />“ ‘एकरसेति तुमन सुध अऊ असुध पसु म, अऊ सुध अऊ असुध चिरईमन म भेद करव। तुमन कोनो अइसने पसु या चिरई या भुइयां म रेंगइया जीव के दुवारा अपनआप ला असुध झन करव, जऊन मन ला मेंह तुम्हर बर असुध ठहिराके अलग करे हंव। <verse eid="LEV 20:25" /><verse number="26" style="v" sid="LEV 20:26" />तुमन मोर बर पबितर बने रहव, काबरकि में यहोवा ह पबितर अंव, अऊ मेंह तुमन ला आने देस के मनखेमन ले अलग करे हंव कि तुमन मोर बने रहव।<verse eid="LEV 20:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 20:27" />“ ‘कोनो आदमी या माईलोगन, जऊन ह तुम्हर बीच म बईगा या भूत-परेत साधे के काम करथे, ओह मार डारे जावय। तुमन ओला पथरवाह करके मार डारव; ओकर लहू के दोस ओकरेच मुड़ म ही पड़ही।’ ”<verse eid="LEV 20:27" /></para>
  <chapter eid="LEV 20" />
  <chapter number="21" style="c" sid="LEV 21" />
  <para style="s1">पुरोहितमन बर नियम</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 21:1" />फेर यहोवा ह मूसा ला कहिस, “हारून के बेटा, जऊन मन पुरोहित अंय, ओमन ला कह: ‘कहूं तुम्हर मनखेमन ले कोनो मर जावय, त ओकर कारन पुरोहित ह अपनआप ला असुध झन करय; <verse eid="LEV 21:1" /><verse number="2" style="v" sid="LEV 21:2" />सिरिप अपन नजदीकी रिस्तेदार, याने कि अपन दाई या ददा, अपन बेटा या बेटी, अपन भाई, <verse eid="LEV 21:2" /><verse number="3" style="v" sid="LEV 21:3" />या अपन कुंवारी बहिनी, जऊन ह ओकर भरोसा म हवय काबरकि ओकर घरवाला नइं ए—येमन के मरे म ओह अपनआप ला असुध कर सकत हे। <verse eid="LEV 21:3" /><verse number="4" style="v" sid="LEV 21:4" />जऊन मनखेमन बिहाव के कारन ओकर रिस्तेदार अंय, ओमन बर ओह अपनआप ला असुध झन करय अऊ ये किसम ले अपबितर झन होवय।<verse eid="LEV 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 21:5" />“ ‘पुरोहितमन अपन मुड़ झन मुड़ावंय या दाढ़ी के तीर ला झन कतरावंय या अपन देहें ला झन चिरंय-फारंय। <verse eid="LEV 21:5" /><verse number="6" style="v" sid="LEV 21:6" />ओमन अपन परमेसर बर पबितर बने रहंय अऊ अपन परमेसर के नांव ला अपबितर झन करंय। काबरकि ओमन यहोवा बर जेवन-बलिदान याने कि अपन परमेसर बर जेवन चघाथें; एकरसेति ओमन पबितर बने रहंय।<verse eid="LEV 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 21:7" />“ ‘ओमन अइसने माईलोगन से बिहाव झन करंय, जऊन ह बेस्या के काम करके असुध हो गे हवय या ओमन अइसने कोनो माईलोगन ले बिहाव झन करंय, जऊन ला ओकर घरवाला ह तलाक दे देय हवय, काबरकि पुरोहितमन अपन परमेसर बर पबितर अंय। <verse eid="LEV 21:7" /><verse number="8" style="v" sid="LEV 21:8" />ओमन ला पबितर जानव, काबरकि ओमन तुम्हर परमेसर ला जेवन चघाथें। ओमन ला पबितर समझव, काबरकि में यहोवा ह पबितर अंव—में जऊन ह तुमन ला पबितर करथंव।<verse eid="LEV 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 21:9" />“ ‘कहूं कोनो पुरोहित के बेटी ह बेस्या बनके अपनआप ला अपबितर करथे, त ओह अपन ददा ऊपर कलंक लगाथे; ओला आगी म जलाय जावय।<verse eid="LEV 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 21:10" />“ ‘अपन भाईमन म जऊन ह महा पुरोहित होवय, जेकर मुड़ म अभिसेक के तेल रितोय गे हवय अऊ जऊन ला पुरोहित के ओनहा पहिरे बर अभिसेक करे गे हवय, ओह अपन मुड़ के चुंदी ला झन छरियावय या ओह अपन ओनहा ला झन चीरय। <verse eid="LEV 21:10" /><verse number="11" style="v" sid="LEV 21:11" />ओह ओ जगह म झन जावय, जिहां लास रखे हवय। इहां तक कि ओह अपन ददा या दाई बर घलो अपनआप ला असुध झन करय; <verse eid="LEV 21:11" /><verse number="12" style="v" sid="LEV 21:12" />ओह अपन परमेसर के पबितर-स्थान ला झन छोंड़य या येला अपबितर झन करय, काबरकि ओह अपन परमेसर के अभिसेक के तेल दुवारा अलग करे गे हवय। मेंह यहोवा अंव।<verse eid="LEV 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 21:13" />“ ‘ओह कुंवारी ले ही बिहाव करय। <verse eid="LEV 21:13" /><verse number="14" style="v" sid="LEV 21:14" />ओह कोनो बिधवा, कोनो तलाकसुदा माईलोगन, या बेस्या काम ले अपबितर होय माईलोगन ले बिहाव झन करय, पर अपन मनखेमन ले सिरिप कोनो कुंवारी ले बिहाव करय, <verse eid="LEV 21:14" /><verse number="15" style="v" sid="LEV 21:15" />ताकि ओकर लइका ह ओकर मनखेमन के बीच म असुध झन होवय। में यहोवा अंव, जऊन ह ओला पबितर बनाथंव।’ ”<verse eid="LEV 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 21:16" />फेर यहोवा ह मूसा ला कहिस, <verse eid="LEV 21:16" /><verse number="17" style="v" sid="LEV 21:17" />“हारून ला ये कह: ‘तोर बंस के पीढ़ी-पीढ़ी म कहूं कोनो मनखे म कोनो सारीरिक दोस होवय, त ओह अपन परमेसर ला बलिदान चघाय बर लकठा म झन आवय। <verse eid="LEV 21:17" /><verse number="18" style="v" sid="LEV 21:18" />कोनो घलो मनखे, जेमा दोस हवय, ओह लकठा म झन आवय: चाहे ओह अंधरा या खोरवा, बिगड़े चेहरा, या खराप अंग वाला होवय, <verse eid="LEV 21:18" /><verse number="19" style="v" sid="LEV 21:19" />या ओह गोड़ या हांथ ले लूलवा होवय, <verse eid="LEV 21:19" /><verse number="20" style="v" sid="LEV 21:20" />या कुबड़ा या बवना, या जेकर आंखी म कोनो दोस होवय, या जेकर घाव ह पक गे हवय या घाव ले पीब निकलत हवय या जेकर अंडकोस ह पिचके होवय। <verse eid="LEV 21:20" /><verse number="21" style="v" sid="LEV 21:21" />हारून पुरोहित के बंस म ले कोनो घलो, जेकर म कोनो सारीरिक दोस हवय, ओह यहोवा ला जेवन-बलिदान चघाय बर लकठा म झन आवय; काबरकि ओमा दोस हवय, ओह अपन परमेसर के जेवन चघाय बर लकठा म झन आवय। <verse eid="LEV 21:21" /><verse number="22" style="v" sid="LEV 21:22" />ओह अपन परमेसर के महा पबितर जेवन अऊ संग म पबितर जेवन ला खा सकत हे। <verse eid="LEV 21:22" /><verse number="23" style="v" sid="LEV 21:23" />पर ओमा सारीरिक दोस होय के कारन, ओह परदा के लकठा म या बेदी करा झन जावय, नइं तो मोर पबितर-स्थान ह अपबितर हो जाही। में यहोवा अंव, जऊन ह ओमन ला पबितर बनाथंव।’ ”<verse eid="LEV 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 21:24" />ये किसम ले मूसा ह ये बात हारून अऊ ओकर बेटामन ला अऊ जम्मो इसरायलीमन ला बताईस।<verse eid="LEV 21:24" /></para>
  <chapter eid="LEV 21" />
  <chapter number="22" style="c" sid="LEV 22" />
  <para style="p">
    <verse number="1" style="v" sid="LEV 22:1" />फेर यहोवा ह मूसा ला कहिस, <verse eid="LEV 22:1" /><verse number="2" style="v" sid="LEV 22:2" />“हारून अऊ ओकर बेटामन ला कह कि ओमन ओ पबितर बलिदानमन के संग आदर के बरताव करंय, जऊन ला इसरायलीमन मोला अरपन करथें, ताकि ओमन मोर पबितर नांव ला अपबितर झन करंय। मेंह यहोवा अंव।<verse eid="LEV 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 22:3" />“ओमन ला कह: ‘तुम्हर अवइया पीढ़ीमन म, कहूं तुम्हर बंस के कोनो मनखे असुध हवय अऊ तभो ले ओह ओ पबितर बलिदान के लकठा म आथे, जऊन ला इसरायलीमन यहोवा बर अरपन करथें, त ओ मनखे ला मोर आघू ले अलग करे जावय। मेंह यहोवा अंव।<verse eid="LEV 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 22:4" />“ ‘यदि हारून के बंस म ले कोनो ला असुध चमड़ी के बेमारी या धात के रोग हवय, त ओह जब तक सुध नइं हो जावय, तब तक ओह पबितर बलिदान के चीजमन ला झन खावय। ओह तब घलो असुध होही यदि ओह कोनो अइसने चीज ला छूथे, जऊन ह लास के दुवारा या बीर्य निकले मनखे के दुवारा असुध हो गे हवय, <verse eid="LEV 22:4" /><verse number="5" style="v" sid="LEV 22:5" />या कहूं ओह कोनो रेंगइया जीव ला छूथे, जऊन ह ओला असुध करथे, या कोनो मनखे जऊन ह ओला असुध करथे, चाहे ओह कोनो घलो किसम के असुधता होवय। <verse eid="LEV 22:5" /><verse number="6" style="v" sid="LEV 22:6" />जऊन मनखे अइसने कोनो चीज ला छूथे, ओह संझा के होवत तक असुध रहिही। ओह तब तक पबितर बलिदान के कोनो चीज ला झन खावय, जब तक ओह पानी ले नइं नहा लेवय। <verse eid="LEV 22:6" /><verse number="7" style="v" sid="LEV 22:7" />बेर बुड़े के बाद, ओह सुध हो जाही, अऊ एकर बाद ओह पबितर बलिदान म ले खा सकत हे, काबरकि येह ओकर जेवन अय। <verse eid="LEV 22:7" /><verse number="8" style="v" sid="LEV 22:8" />ओह अपनआप मरे या जंगली पसु के दुवारा चिरे-फारे कोनो पसु ला झन खावय, नइं तो ओह असुध हो जाही। मेंह यहोवा अंव।<verse eid="LEV 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 22:9" />“ ‘पुरोहितमन मोर ये किसम ले सेवा करंय कि ओमन दोसी झन ठहिरंय, नइं तो अनादर करे के कारन मर जाहीं। मेंह यहोवा अंव, जऊन ह ओमन ला पबितर करथंव।<verse eid="LEV 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 22:10" />“ ‘पुरोहित के परिवार के छोंड़ कोनो आने मनखे पबितर बलिदान ला झन खावय, चाहे ओह पुरोहित के पहुना होवय या ओकर बनिहार, ओह कोनो पबितर चीज ला झन खावय। <verse eid="LEV 22:10" /><verse number="11" style="v" sid="LEV 22:11" />पर कोनो पुरोहित ह कोनो गुलाम ला पईसा देके बिसा लेथे या कोनो गुलाम ह पुरोहित के घर म जनमे हवय, त ओ गुलाम ह ओमा ले खा सकत हे। <verse eid="LEV 22:11" /><verse number="12" style="v" sid="LEV 22:12" />कहूं कोनो पुरोहित के बेटी ह अइसने मनखे ले बिहाव करथे, जऊन ह पुरोहित नो हय, त पुरोहित के ओ बेटी ह पबितर बलिदान के कोनो चीज ला झन खावय। <verse eid="LEV 22:12" /><verse number="13" style="v" sid="LEV 22:13" />पर कहूं कोनो पुरोहित के बेटी ह बिधवा हो जाथे या ओला ओकर घरवाला छोंड़ देथे अऊ ओकर लोग-लइका नइं रहंय अऊ ओह अपन जवानी के दिन म अपन ददा के घर म फेर आके रहिथे, त ओह अपन ददा के जेवन ला खा सकत हे, पर कोनो आने मनखे ओमा ले झन खावय।<verse eid="LEV 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 22:14" />“ ‘कहूं कोनो मनखे अनजाने म पबितर बलिदान के चीज ला खा लेथे, त ओह ओ बलिदान के कीमत संग ओकर पांचवां भाग बढ़ाके पुरोहित ला भरपई कर देवय। <verse eid="LEV 22:14" /><verse number="15" style="v" sid="LEV 22:15" />इसरायलीमन जऊन पबितर बलिदान यहोवा ला चघाथें, ओला पुरोहितमन इसरायलीमन ला खाय के अनुमति देके अपबितर झन करंय, <verse eid="LEV 22:15" /><verse number="16" style="v" sid="LEV 22:16" />नइं तो ओमन दोसी ठहिरहीं अऊ ओमन ला दाम चुकाना पड़ही। मेंह यहोवा अंव, जऊन ह ओमन ला पबितर करथंव।’ ”<verse eid="LEV 22:16" /></para>
  <para style="s1">बलिदान जऊन ला गरहन नइं करे जावय</para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 22:17" />फेर यहोवा ह मूसा ला कहिस, <verse eid="LEV 22:17" /><verse number="18" style="v" sid="LEV 22:18" />“हारून अऊ ओकर बेटामन ला अऊ जम्मो इसरायलीमन ले गोठिया अऊ ओमन ला कह: ‘तुमन म ले कोनो—चाहे इसरायली होवय या इसरायल म रहइया कोनो परदेसी—यदि ओह यहोवा ला होम-बलिदान के भेंट चघाथे, चाहे ओह बदना के होवय या स्वेच्छा-बलिदान के होवय, <verse eid="LEV 22:18" /><verse number="19" style="v" sid="LEV 22:19" />त ओह पसु, भेड़ या बोकरा म ले निरदोस नर पसु होवय, ताकि येह तुम्हर कोति ले गरहन करे जावय। <verse eid="LEV 22:19" /><verse number="20" style="v" sid="LEV 22:20" />जऊन पसु म कोनो दोस होवय, ओला झन लानव, काबरकि ओह तुम्हर कोति ले गरहन नइं करे जावय। <verse eid="LEV 22:20" /><verse number="21" style="v" sid="LEV 22:21" />जब कोनो अपन बिसेस बदना या स्वेच्छा-बलिदान ला पूरा करे बर गाय-बईला या भेड़-बकरी म ले कोनो पसु ला यहोवा करा मेल-बलिदान चघाय बर लानथे, त गरहन करे बर जरूरी अय कि ओ पसु ह बिगर दोस के होवय। <verse eid="LEV 22:21" /><verse number="22" style="v" sid="LEV 22:22" />जऊन पसु ह अंधरा या चोट खाय या अपंग होवय, या जेमा गांठ, या पके या बहत घाव होवय, अइसने पसु ला यहोवा बर बलि झन चघावव। अइसने कोनो पसु ला यहोवा बर जेवन-बलिदान के रूप म बेदी ऊपर झन रखव। <verse eid="LEV 22:22" /><verse number="23" style="v" sid="LEV 22:23" />तुमन कोनो कुरूप बईला या भेड़ ला अपन स्वेच्छा-बलिदान के रूप म चघा सकत हव, पर येह बदना पूरा होय के बलिदान के रूप म गरहन नइं होवय। <verse eid="LEV 22:23" /><verse number="24" style="v" sid="LEV 22:24" />जऊन पसु के अंडकोस ह चोट खाय, कुचराय, फटे या कटे हवय, ओला तुमन यहोवा बर झन चघावव। तुमन अपन देस म अइसन बलिदान के काम झन करव, <verse eid="LEV 22:24" /><verse number="25" style="v" sid="LEV 22:25" />अऊ तुमन न तो अइसने पसु ला कोनो परदेसी के हांथ ले लेवव अऊ न ही ओला अपन परमेसर के जेवन के रूप म चघावव। ओह तुम्हर बर गरहन नइं होवय, काबरकि ओह कुरूप हे अऊ ओमा दोस हवय।’ ”<verse eid="LEV 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 22:26" />फेर यहोवा ह मूसा ला कहिस, <verse eid="LEV 22:26" /><verse number="27" style="v" sid="LEV 22:27" />“जब कोनो बछवा, मेढ़ा-पीला या छेरी-पीला के जनम होवय, त ओह सात दिन तक अपन दाई के संग म रहय। आठवां दिन ले, ओह यहोवा बर जेवन-बलिदान के रूप म गरहन करे जावय। <verse eid="LEV 22:27" /><verse number="28" style="v" sid="LEV 22:28" />चाहे गाय होवय या भेड़, ओला अऊ ओकर पीला ला एक ही दिन म झन मारव।<verse eid="LEV 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 22:29" />“जब तुमन यहोवा ला धनबाद-बलिदान चघाथव, त ये किसम ले चघावव कि ओह तुम्हर कोति ले गरहन करे जावय। <verse eid="LEV 22:29" /><verse number="30" style="v" sid="LEV 22:30" />ओला ओहीच दिन खाय जावय; ओमा के कोनो चीज बिहान होवत तक झन बांचय। मेंह यहोवा अंव।<verse eid="LEV 22:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 22:31" />“मोर हुकूममन ला मानव अऊ ओमन के पालन करव। मेंह यहोवा अंव। <verse eid="LEV 22:31" /><verse number="32" style="v" sid="LEV 22:32" />मोर पबितर नांव ला अपबितर झन करहू, काबरकि जरूरी अय कि मेंह इसरायलीमन के दुवारा पबितर माने जावंव। मेंह यहोवा अंव, जऊन ह तुमन ला पबितर करिस, <verse eid="LEV 22:32" /><verse number="33" style="v" sid="LEV 22:33" />अऊ जऊन ह तुमन ला मिसर देस ले निकालके लानिस ताकि तुम्हर परमेसर होवय। मेंह यहोवा अंव।”<verse eid="LEV 22:33" /></para>
  <chapter eid="LEV 22" />
  <chapter number="23" style="c" sid="LEV 23" />
  <para style="s1">ठहिराय गे तिहारमन</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 23:1" />फेर यहोवा ह मूसा ला कहिस, <verse eid="LEV 23:1" /><verse number="2" style="v" sid="LEV 23:2" />“इसरायलीमन ले गोठिया अऊ ओमन ला कह: ‘येमन मोर ठहिराय तिहार, यहोवा के ठहिराय तिहार अंय, जेकर तुमन पबितर सभा के रूप म घोसना करव।<verse eid="LEV 23:2" /></para>
  <para style="s2">बिसराम दिन</para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 23:3" />“ ‘हर हप्ता छै दिन बुता करे जावय, पर सातवां दिन एक बिसराम के दिन, एक पबितर सभा के दिन अय। जिहां घलो रहव, तुमन ओ दिन कोनो घलो किसम के बुता-काम झन करव; येह यहोवा बर बिसराम के दिन अय।<verse eid="LEV 23:3" /></para>
  <para style="s2">फसह अऊ अखमीरी रोटी के तिहार</para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 23:4" />“ ‘येमन यहोवा के ठहिराय तिहार, पबितर सभा अंय, जेकर तुमन ओमन के ठहिराय समय म घोसना करव: <verse eid="LEV 23:4" /><verse number="5" style="v" sid="LEV 23:5" />हर साल पहिली महिना के चौदहवां दिन के बेर बुड़े के बाद यहोवा के फसह तिहार सुरू होथे। <verse eid="LEV 23:5" /><verse number="6" style="v" sid="LEV 23:6" />ओहीच महिना के पंदरहवां दिन यहोवा के अखमीरी रोटी के तिहार सुरू होथे; सात दिन तक तुमन बिगर खमीर के बने रोटी खावव। <verse eid="LEV 23:6" /><verse number="7" style="v" sid="LEV 23:7" />ये तिहार के पहिली दिन तुमन एक पबितर सभा करव, अऊ ओ दिन तुमन रोजमर्रा के काम झन करव। <verse eid="LEV 23:7" /><verse number="8" style="v" sid="LEV 23:8" />पर सातों दिन तुमन यहोवा ला जेवन-बलिदान चघावव। अऊ सातवां दिन एक पबितर सभा करव अऊ ओ दिन रोजमर्रा के काम झन करव।’ ”<verse eid="LEV 23:8" /></para>
  <para style="s2">पहिली फर के बलिदान</para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 23:9" />यहोवा ह मूसा ला कहिस, <verse eid="LEV 23:9" /><verse number="10" style="v" sid="LEV 23:10" />“इसरायलीमन ले गोठिया अऊ ओमन ला कह: ‘जब तुमन ओ देस म जावव, जऊन ला मेंह तुमन ला देवइया हंव अऊ उहां जब फसल काटव, त लुए गय पहिली-फसल के एक करपा तुमन पुरोहित करा लानव। <verse eid="LEV 23:10" /><verse number="11" style="v" sid="LEV 23:11" />पुरोहित ह ओ करपा ला यहोवा के आघू म हलावय कि ओह तुम्हर बर गरहन करे जावय; पुरोहित ह ओला बिसराम दिन के दूसर दिन हलावय। <verse eid="LEV 23:11" /><verse number="12" style="v" sid="LEV 23:12" />जऊन दिन तुमन ओ करपा ला हलावव, ओ दिन एक बछर के निरदोस मेढ़ा-पीला ला तुमन यहोवा ला होम-बलिदान के रूप म चघावव, <verse eid="LEV 23:12" /><verse number="13" style="v" sid="LEV 23:13" />अऊ ओकर संग म जैतून तेल म सनाय बहुंत बढ़िया पीसान के एक एपा के दू-दसवां भाग<note caller="+" style="f"><char style="fr" closed="false">23:13 </char><char style="ft" closed="false">लगभग 3.2 किलोग्राम; <char style="xt" link-href="LEV 23:17"><ref loc="LEV 23:17">पद 17</ref></char> म घलो</char></note> अन्न-बलिदान के रूप म यहोवा ला चघावव; येह यहोवा बर सुख-देवइया सुगंधवाला एक जेवन-बलिदान होही, अऊ एकर संग म एक हीन के चौथा भाग<note caller="+" style="f"><char style="fr" closed="false">23:13 </char><char style="ft" closed="false">लगभग 1 लीटर</char></note> अंगूर के मंद पेय-बलिदान के रूप म चघावव। <verse eid="LEV 23:13" /><verse number="14" style="v" sid="LEV 23:14" />जब तक तुमन अपन परमेसर करा ये बलिदान नइं ले जावव, ओ दिन तक तुमन कोनो रोटी, या भुने या नवां अन्न झन खावव। तुमन जिहां घलो रहव, येह तुम्हर पीढ़ी-पीढ़ी तक हमेसा के बिधि ठहिरय।<verse eid="LEV 23:14" /></para>
  <para style="s2">सप्ताहमन के तिहार</para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 23:15" />“ ‘बिसराम दिन के दूसर दिन, याने कि जऊन दिन तुमन हलाय-बलिदान के करपा ला लानेव, ओ दिन ले लेके पूरा सात हप्ता गन लेवव। <verse eid="LEV 23:15" /><verse number="16" style="v" sid="LEV 23:16" />सातवां बिसराम दिन के दूसर दिन तक याने पचास दिन गनव, अऊ ओ पचासवां दिन यहोवा ला नवां अन्न के बलिदान चघावव। <verse eid="LEV 23:16" /><verse number="17" style="v" sid="LEV 23:17" />तुमन जिहां घलो रहव, बहुंत बढ़िया पीसान के एपा के दू-दसवां भाग ले बने दू ठन रोटी लानव, जऊन म खमीर मिले रहय अऊ येला पहिली-फसल के हलाय-बलिदान के रूप म यहोवा ला चघावव। <verse eid="LEV 23:17" /><verse number="18" style="v" sid="LEV 23:18" />अऊ ओ रोटी के संग एक-एक बछर के सात ठन निरदोस मेढ़ा-पीला, एक ठन जवान बछवा अऊ दू ठन मेढ़ा चघावव। येमन यहोवा बर ओमन के अन्न-बलिदान अऊ पेय-बलिदान के संग एक होम-बलिदान होहीं अऊ येह यहोवा बर महकत सुख-देवइया एक जेवन-बलिदान होही। <verse eid="LEV 23:18" /><verse number="19" style="v" sid="LEV 23:19" />तब तुमन पाप-बलिदान बर एक ठन बोकरा अऊ मेल-बलिदान बर एक-एक बछर के दू ठन मेढ़ा-पीला चघावव। <verse eid="LEV 23:19" /><verse number="20" style="v" sid="LEV 23:20" />पुरोहित ह पहिली-फसल के रोटी संग, ओ दूनों मेढ़ा-पीला ला हलाय-बलिदान के रूप म यहोवा के आघू म हलावय। ओमन यहोवा बर पबितर बलिदान अऊ पुरोहित के बांटा अंय। <verse eid="LEV 23:20" /><verse number="21" style="v" sid="LEV 23:21" />ओहीच दिन तुमन एक पबितर सभा के हांका परवाव अऊ कोनो रोजमर्रा के काम झन करव। तुमन जिहां घलो रहव, येह तुम्हर पीढ़ी-पीढ़ी तक हमेसा के बिधि ठहिरय।<verse eid="LEV 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 23:22" />“ ‘जब तुमन अपन भुइयां के फसल लुवव, त अपन खेत के एकदम तीर के फसल ला झन लुवव अऊ गिरे बालमन ला झन संकेलव। ओमन ला गरीब अऊ तुम्हर बीच म रहइया परदेसीमन बर छोंड़ दव। मेंह यहोवा तुम्हर परमेसर अंव।’ ”<verse eid="LEV 23:22" /></para>
  <para style="s2">तुरही के तिहार</para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 23:23" />फेर यहोवा ह मूसा ला कहिस, <verse eid="LEV 23:23" /><verse number="24" style="v" sid="LEV 23:24" />“इसरायलीमन ला कह: ‘हर साल सातवां महिना के पहिली दिन तुम्हर बर बिसराम दिन होवय, अऊ ओ दिन पबितर सभा जूरय अऊ तुरही बजाके आनंद मनावय। <verse eid="LEV 23:24" /><verse number="25" style="v" sid="LEV 23:25" />ओ दिन रोजमर्रा के काम झन करव, पर यहोवा बर एक जेवन-बलिदान चघावव।’ ”<verse eid="LEV 23:25" /></para>
  <para style="s2">प्रायस्चित के दिन</para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 23:26" />फेर यहोवा ह मूसा ला कहिस, <verse eid="LEV 23:26" /><verse number="27" style="v" sid="LEV 23:27" />“ओ सातवां महिना के दसवां दिन ह प्रायस्चित के दिन अय। ओ दिन पबितर सभा करे जावय अऊ अपनआप के इनकार करव<note caller="+" style="f"><char style="fr" closed="false">23:27 </char><char style="ft" closed="false">या </char><char style="fq" closed="false">अऊ </char><char style="fqa" closed="false">उपास करव</char></note> अऊ यहोवा ला जेवन-बलिदान चघावव। <verse eid="LEV 23:27" /><verse number="28" style="v" sid="LEV 23:28" />ओ दिन तुमन कोनो काम-बुता झन करव, काबरकि ओह प्रायस्चित के दिन अय, अऊ यहोवा तुम्हर परमेसर के आघू म तुम्हर बर प्रायस्चित करे जाही। <verse eid="LEV 23:28" /><verse number="29" style="v" sid="LEV 23:29" />ओ दिन जऊन मन अपनआप के इनकार नइं करंय, ओमन अपन मनखेमन के समाज ले अलग करे जावंय। <verse eid="LEV 23:29" /><verse number="30" style="v" sid="LEV 23:30" />जऊन मनखे ह ओ दिन कोनो किसम के काम-बुता करथे, ओला मेंह ओकर मनखेमन के बीच ले नास कर दूहूं। <verse eid="LEV 23:30" /><verse number="31" style="v" sid="LEV 23:31" />तुमन कोनो घलो किसम के काम झन करहू। तुमन जिहां घलो रहव, येह पीढ़ी-पीढ़ी तक तुम्हर बर हमेसा के बिधि होवय। <verse eid="LEV 23:31" /><verse number="32" style="v" sid="LEV 23:32" />येह तुम्हर बर बिसराम दिन अय, अऊ तुमन अपनआप के इनकार करव। ओ महिना के नौवां दिन के संझा ले लेके दूसर दिन के संझा तक तुमन अपन बिसराम दिन माने करव।”<verse eid="LEV 23:32" /></para>
  <para style="s2">पबितर-तम्बूमन के तिहार</para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 23:33" />फेर यहोवा ह मूसा ला कहिस, <verse eid="LEV 23:33" /><verse number="34" style="v" sid="LEV 23:34" />“इसरायलीमन ला कह: ‘सातवां महिना के पंदरहवां दिन यहोवा के पबितर-तम्बूमन के तिहार सुरू होथे अऊ येह सात दिन तक चलथे। <verse eid="LEV 23:34" /><verse number="35" style="v" sid="LEV 23:35" />पहिली दिन पबितर सभा होवय; ओ दिन कोनो काम झन करव। <verse eid="LEV 23:35" /><verse number="36" style="v" sid="LEV 23:36" />ये सातों दिन यहोवा ला जेवन-बलिदान चघावव, अऊ आठवां दिन तुमन पबितर सभा करव अऊ यहोवा ला जेवन-बलिदान चघावव। येह तिहार खतम करे के बिसेस सभा अय; ओ दिन रोजमर्रा के काम झन करव।<verse eid="LEV 23:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LEV 23:37" />(“ ‘येमन यहोवा के ठहिराय तिहारमन अंय, जेमन ला तुमन पबितर सभा के रूप म घोसना करव ताकि यहोवा बर जेवन-बलिदान—याने कि होम-बलिदान अऊ अन्न-बलिदान, चढ़ावा अऊ पेय-बलिदान हर दिन के जरूरत के मुताबिक लाय जावय। <verse eid="LEV 23:37" /><verse number="38" style="v" sid="LEV 23:38" />ये बलिदानमन ओ बलिदानमन के अलावा होहीं, जऊन ला तुमन यहोवा के बिसराम दिन अऊ तुम्हर भेंट अऊ तुम्हर बदना अऊ स्वेच्छा-बलिदान के रूप म यहोवा ला चघाहू।)<verse eid="LEV 23:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 23:39" />“ ‘जब तुमन भुइयां के ऊपज ला संकेल डारव, तब सातवां महिना के पंदरहवां दिन ले सुरू करके सात दिन तक यहोवा के तिहार मनावव; पहिला दिन ह बिसराम दिन अय, अऊ आठवां दिन घलो बिसराम दिन अय। <verse eid="LEV 23:39" /><verse number="40" style="v" sid="LEV 23:40" />पहिला दिन तुमन घना रूख के डारामन ला याने कि खजूर, सरई अऊ आने पानवाला रूख के डारामन ला लेके यहोवा तुम्हर परमेसर के आघू म सात दिन तक आनंद मनावव। <verse eid="LEV 23:40" /><verse number="41" style="v" sid="LEV 23:41" />तुमन येला हर साल सात दिन तक यहोवा बर तिहार के रूप म मनाय करव। येह तुम्हर पीढ़ी-पीढ़ी तक हमेसा के बिधि होवय; हर साल सातवां महिना म ये तिहार ला मनावव। <verse eid="LEV 23:41" /><verse number="42" style="v" sid="LEV 23:42" />सात दिन तक तुमन कुंदरा म रहव: जम्मो देस म जनमे इसरायलीमन अइसने कुंदरा म रहंय, <verse eid="LEV 23:42" /><verse number="43" style="v" sid="LEV 23:43" />ताकि तुम्हर बंस के मनखेमन जान सकंय कि जब मेंह इसरायलीमन ला मिसर देस ले निकालके लानत रहेंव, त ओमन ला मेंह कुंदरामन म रखे रहेंव। मेंह यहोवा तुम्हर परमेसर अंव।’ ”<verse eid="LEV 23:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LEV 23:44" />ये किसम ले, मूसा ह इसरायलीमन ला यहोवा के ठहिराय तिहारमन ला बताईस।<verse eid="LEV 23:44" /></para>
  <chapter eid="LEV 23" />
  <chapter number="24" style="c" sid="LEV 24" />
  <para style="s1">यहोवा के आघू म जैतून तेल अऊ रोटी</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 24:1" />यहोवा ह मूसा ला कहिस, <verse eid="LEV 24:1" /><verse number="2" style="v" sid="LEV 24:2" />“इसरायलीमन ला हुकूम दे कि ओमन अंजोर करे बर जैतून के पेरके निकाले सुध तेल लानंय ताकि दीयामन हरदम बरत रहंय। <verse eid="LEV 24:2" /><verse number="3" style="v" sid="LEV 24:3" />परदा के बाहिर जऊन ह मिलापवाला तम्बू म करार कानून के सन्दूक ला ओधा करथे, उहां हारून ह यहोवा के आघू म संझा ले बिहान होवत तक लगातार दीयामन के देखरेख करय। येह पीढ़ी-पीढ़ी तक हमेसा के बिधि होवय। <verse eid="LEV 24:3" /><verse number="4" style="v" sid="LEV 24:4" />ओ दीया जऊन मन सुध सोन के दीवट म यहोवा के आघू म हवंय, ओमन के लगातार देखरेख करे जावय।<verse eid="LEV 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 24:5" />“बहुंत बढ़िया पीसान के बारह ठन रोटी सेंकके बनावव अऊ हर एक रोटी ह एपा के दू-दसवां भाग<note caller="+" style="f"><char style="fr" closed="false">24:5 </char><char style="ft" closed="false">लगभग 3.2 किलोग्राम</char></note> म बनाय जावय। <verse eid="LEV 24:5" /><verse number="6" style="v" sid="LEV 24:6" />तुमन ओमन ला सुध सोन के मेज ऊपर दू जगह म, याने एक-एक जगह म छै-छै ठन करके यहोवा के आघू म रख देवव। <verse eid="LEV 24:6" /><verse number="7" style="v" sid="LEV 24:7" />दूनों जगह म सुध धूप रखव, कि ओह रोटी के सेति सुरता-देवइया हिस्सा अऊ यहोवा बर जेवन-बलिदान होवय। <verse eid="LEV 24:7" /><verse number="8" style="v" sid="LEV 24:8" />ये रोटी ला हमेसा के करार के रूप म इसरायलीमन कोति ले हर बिसराम के दिन लगातार यहोवा के आघू म रखे जावय। <verse eid="LEV 24:8" /><verse number="9" style="v" sid="LEV 24:9" />ये रोटी ह हारून अऊ ओकर बेटामन के अय अऊ ओमन येला पबितर-स्थान के छेत्र म खावंय, काबरकि येह यहोवा ला चघाय जेवन-बलिदान के ओमन के हमेसा के महा पबितर भाग अय।”<verse eid="LEV 24:9" /></para>
  <para style="s1">परमेसर के निन्दा करइया ला मिरतू-दंड</para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 24:10" />एक इसरायली माईलोगन के बेटा, जेकर ददा ह मिसरी रिहिस, इसरायली मनखेमन के बीच म चल दीस, अऊ डेरा म इसरायली माईलोगन के ओ बेटा अऊ एक इसरायली के बीच झगरा हो गीस। <verse eid="LEV 24:10" /><verse number="11" style="v" sid="LEV 24:11" />ओ इसरायली माईलोगन के बेटा ह सराप देके यहोवा के नांव के निन्दा करे लगिस। एकरसेति ओला मनखेमन मूसा करा ले गीन। (ओकर दाई के नांव सलोमीत रिहिस, जऊन ह दान के गोत्र के दिबरी के बेटी रिहिस।) <verse eid="LEV 24:11" /><verse number="12" style="v" sid="LEV 24:12" />मनखेमन ओकर बारे म यहोवा के ईछा के पता चलत तक ओला हवालात म रखिन।<verse eid="LEV 24:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 24:13" />तब यहोवा ह मूसा ला कहिस, <verse eid="LEV 24:13" /><verse number="14" style="v" sid="LEV 24:14" />“ओ निन्दा करइया ला डेरा के बाहिर ले जा। अऊ जतेक झन ओला सराप देवत सुने हवंय, ओमन अपन हांथ ओकर मुड़ म रखंय, अऊ जम्मो सभा के मनखेमन ओला पथरवाह करंय। <verse eid="LEV 24:14" /><verse number="15" style="v" sid="LEV 24:15" />तेंह इसरायलीमन ला कह: ‘जऊन कोनो अपन परमेसर ला सराप देथे, ओह दोसी ठहिराय जाही; <verse eid="LEV 24:15" /><verse number="16" style="v" sid="LEV 24:16" />जऊन कोनो यहोवा के नांव के निन्दा करथे, ओह मार डारे जावय। जम्मो सभा के मनखेमन ओला पथरा फेंक-फेंकके मारंय। चाहे कोनो परदेसी होवय या देसी मनखे होवय, जब कोनो घलो मनखे परमेसर के नांव के निन्दा करथे, त ओह मार डारे जावय।<verse eid="LEV 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 24:17" />“ ‘जऊन मनखे कोनो आने मनखे के परान ले लेथे, त ओह मार डारे जावय। <verse eid="LEV 24:17" /><verse number="18" style="v" sid="LEV 24:18" />जऊन मनखे कोनो आने मनखे के पसु के परान ले लेथे, त ओह ओकर भरपई दूसर पसु देके करय। <verse eid="LEV 24:18" /><verse number="19" style="v" sid="LEV 24:19" />जब कोनो मनखे ह अपन परोसी के देहें ला चोट पहुंचाथे, त ओला घलो ओही किसम ले चोट पहुंचाय जावय: <verse eid="LEV 24:19" /><verse number="20" style="v" sid="LEV 24:20" />हाड़ा टोरई के बलदा हाड़ा टोरई, आंखी के बलदा आंखी, दांत के बलदा दांत। जऊन मनखे ह जइसने चोट कोनो आने मनखे ला देय हवय, ओला घलो वइसनेच चोट पहुंचाय जावय। <verse eid="LEV 24:20" /><verse number="21" style="v" sid="LEV 24:21" />कोनो मनखे ह कोनो पसु ला मार डारथे, त ओ मनखे ह ओकर भरपई जरूर करय, पर जऊन मनखे ह कोनो आने मनखे ला मार डारथे, त ओला घलो मार डारे जावय। <verse eid="LEV 24:21" /><verse number="22" style="v" sid="LEV 24:22" />चाहे परदेसी होवय या देसी मनखे, जम्मो बर तुम्हर ओहीच कानून होवय। मेंह यहोवा तुम्हर परमेसर अंव।’ ”<verse eid="LEV 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 24:23" />तब मूसा ह इसरायलीमन ले बात करिस, अऊ ओमन ओ निन्दा करइया ला डेरा के बाहिर ले गीन अऊ ओला पथरवाह करिन। इसरायलीमन वइसनेच करिन, जइसने यहोवा ह मूसा ला हुकूम दे रिहिस।<verse eid="LEV 24:23" /></para>
  <chapter eid="LEV 24" />
  <chapter number="25" style="c" sid="LEV 25" />
  <para style="s1">बिसराम बछर</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 25:1" />यहोवा ह सीनय परबत ऊपर मूसा ला कहिस, <verse eid="LEV 25:1" /><verse number="2" style="v" sid="LEV 25:2" />“इसरायलीमन ले गोठिया अऊ ओमन ला कह: ‘जब तुमन ओ देस म जावव, जऊन ला मेंह तुमन ला देवइया हंव, त ओ देस ह खुद यहोवा बर एक बिसराम बछर ला मानय। <verse eid="LEV 25:2" /><verse number="3" style="v" sid="LEV 25:3" />तुमन छै बछर ले अपन खेत ला बोवव, अऊ छै बछर ले अपन अंगूर के बारी के नारमन ला छांटव अऊ ओमन के फर ला संकेलव, <verse eid="LEV 25:3" /><verse number="4" style="v" sid="LEV 25:4" />पर सातवां बछर ह भुइयां बर बिसराम के बछर होवय; येह यहोवा के नांव म बिसराम के बछर अय। ये साल न तो अपन खेत ला बोवव, अऊ न ही अपन अंगूर के बारी के नारमन ला छांटव। <verse eid="LEV 25:4" /><verse number="5" style="v" sid="LEV 25:5" />खेत म जऊन कुछू अपनआप बाढ़थे, ओला झन लुवव या परिया छोंड़े गे अंगूर के नारमन के फर ला झन संकेलव। भुइयां ला एक बछर के बिसराम मिलय। <verse eid="LEV 25:5" /><verse number="6" style="v" sid="LEV 25:6" />बिसराम बछर के समय भुइयां म जऊन घलो ऊपज अपनआप होथे, ओह तुम्हर बर जेवन होही—तुम्हर, तुम्हर सेवक या सेविका, बनिहार अऊ तुम्हर बीच म कुछू समय तक रहइया मनखेमन बर जेवन होही, <verse eid="LEV 25:6" /><verse number="7" style="v" sid="LEV 25:7" />अऊ ओह तुम्हर पसु अऊ तुम्हर देस के जंगली पसुमन के घलो जेवन होही। भुइयां म जऊन घलो ऊपज अपनआप होथे, ओला खाय जा सकत हे।<verse eid="LEV 25:7" /></para>
  <para style="s1">जुबली के बछर</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 25:8" />“ ‘तुमन सात बिसराम बछर गनव—सात बछर के सात गुना—ताकि उनचास बछर म सात बिसराम बछर होवय। <verse eid="LEV 25:8" /><verse number="9" style="v" sid="LEV 25:9" />तब तुमन पचासवां साल के सातवां महिना के दसवां दिन याने प्रायस्चित के दिन अपन पूरा देस म तुरही फुंकवाव। <verse eid="LEV 25:9" /><verse number="10" style="v" sid="LEV 25:10" />ओ पचासवां बछर ला पबितर मानव अऊ देस म रहइया जम्मो झन के छुटकारा के घोसना करव। येह तुम्हर बर जुबली बछर होही; तुमन म ले हर एक झन अपन परिवारिक संपत्ति अऊ अपन खुद के कुल म लहुंटय। <verse eid="LEV 25:10" /><verse number="11" style="v" sid="LEV 25:11" />तुम्हर बर ये पचासवां बछर ह जुबली बछर होवय; तुमन न तो बोवव, अऊ न ही अपनआप जामे फसल ला लुवव, अऊ न ही बिगर छांटे अंगूर के नार म फरे फर ला टोरव। <verse eid="LEV 25:11" /><verse number="12" style="v" sid="LEV 25:12" />काबरकि येह जुबली बछर अय अऊ येह तुम्हर बर पबितर होवय। जऊन ऊपज तुम्हर करा सीधा खेत ले लाय जाथे, सिरिप ओला खावव।<verse eid="LEV 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 25:13" />“ ‘ये जुबली बछर म हर एक मनखे अपन खुद के भुइयां म लहुंटय।<verse eid="LEV 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 25:14" />“ ‘कहूं तुमन अपन कोनो मनखे ला भुइयां बेचथव या ओकर ले भुइयां बिसाथव, त एक-दूसर ले फायदा झन लेवव। <verse eid="LEV 25:14" /><verse number="15" style="v" sid="LEV 25:15" />जुबली बछर के बाद, जतका बछर बीत गे होवय, ओकर गनती के आधार म तुमन अपन मनखेमन ले भुइयां बिसावव। अऊ ओमन फसल लुए बर बांचे बछर के गनती के आधार म अपन भुइयां ला तुम्हर करा बेचंय। <verse eid="LEV 25:15" /><verse number="16" style="v" sid="LEV 25:16" />जतका जादा बछर बांचे रहय, ओतका जादा दाम बढ़ावव, अऊ जतका कम बछर बांचे रहय, ओतका ही दाम घटावव, काबरकि सही म जऊन चीज ह बेचे जावत हे, ओह बछर के हिसाब से ओकर फसल अय। <verse eid="LEV 25:16" /><verse number="17" style="v" sid="LEV 25:17" />एक-दूसर ले फायदा झन लेवव, पर अपन परमेसर के भय मानव। मेंह यहोवा तुम्हर परमेसर अंव।<verse eid="LEV 25:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 25:18" />“ ‘मोर बिधिमन ला मानव अऊ धियान देके मोर कानूनमन के पालन करव, त तुमन निडर होके देस म बसे रहिहू। <verse eid="LEV 25:18" /><verse number="19" style="v" sid="LEV 25:19" />तब भुइयां ह अपन फसल उपजाही, अऊ तुमन पेट भर खाहू अऊ उहां निडर बसे रहिहू। <verse eid="LEV 25:19" /><verse number="20" style="v" sid="LEV 25:20" />तुमन पुछ सकत हव, “यदि सातवां बछर म, हमन नइं बोवन या अपन फसल ला नइं लुवन, त ओ बछर म, हमन का ला खाबो?” <verse eid="LEV 25:20" /><verse number="21" style="v" sid="LEV 25:21" />मेंह छठवां बछर म अइसने आसीस दूहूं कि भुइयां ह ओ साल तीन बछर के बरोबर फसल दीही। <verse eid="LEV 25:21" /><verse number="22" style="v" sid="LEV 25:22" />जब तुमन आठवां बछर म बोवई करव, त जुन्ना फसल<note caller="+" style="f"><char style="fr" closed="false">25:22 </char><char style="ft" closed="false">छठवां बछर के फसल</char></note> म ले तब तक खावत रहव, जब तक कि नौवां बछर के फसल के लुवई नइं हो जावय।<verse eid="LEV 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 25:23" />“ ‘भुइयां ला सब दिन बर झन बेचव, काबरकि भुइयां ह मोर अय अऊ तुमन मोर भुइयां म परदेसी अऊ अजनबी के सहीं रहिथव। <verse eid="LEV 25:23" /><verse number="24" style="v" sid="LEV 25:24" />ओ जम्मो भुइयां, जऊन ह तुम्हर अधिकार म हवय, ओकर छुटकारा के परबंध जरूर करव।<verse eid="LEV 25:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 25:25" />“ ‘कहूं तुम्हर कोनो संगी इसरायली गरीब हो जावय अऊ अपन कुछू संपत्ति ला बेचय, त ओकर सबले नजदीकी रिस्तेदार ह आवय अऊ ओ बेचे गय चीज ला छोंड़ावय। <verse eid="LEV 25:25" /><verse number="26" style="v" sid="LEV 25:26" />कहूं ओकर बर छुड़ानेवाला कोनो नइं ए, पर बाद म, जब ओह खुद धनवान हो जाथे अऊ ओकर करा ओला छोंड़ाय बर धन हो जाथे, <verse eid="LEV 25:26" /><verse number="27" style="v" sid="LEV 25:27" />त ओह ओ संपत्ति के बेचे जाय के पाछू के बछर के हिसाब से दाम तय करय अऊ ओ दाम बेचे गय मनखे ला वापिस कर देवय; ओह तब फेर अपन संपत्ति म काबिज हो सकथे। <verse eid="LEV 25:27" /><verse number="28" style="v" sid="LEV 25:28" />पर कहूं ओकर करा अतका पूंजी नइं ए कि ओह फेर अपन संपत्ति ला बिसा सकय, त फेर ओ संपत्ति ह बिसइया के ही अधिकार म जुबली बछर तक रहिही। ओ संपत्ति ला जुबली बछर म वापिस करे जाही, अऊ तब ओह अपन संपत्ति म अधिकार कर सकत हे।<verse eid="LEV 25:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 25:29" />“ ‘कोनो मनखे दीवारवाले सहर म घर बेचथे, त बेचे जाय के पाछू एक बछर तक ओकर करा छोंड़ाय के अधिकार रहिथे। ओ एक साल म बेचइया ह अपन घर ला छोंड़ा सकत हे। <verse eid="LEV 25:29" /><verse number="30" style="v" sid="LEV 25:30" />कहूं ओ एक बछर के पूरा होवत तक ओ घर ला छोंड़ाय नइं जावय, त दीवारवाले सहर के ओ घर ह सब दिन बर बिसइया अऊ ओकर संतानमन के हो जाही। येला जुबली बछर म झन वापिस करे जावय। <verse eid="LEV 25:30" /><verse number="31" style="v" sid="LEV 25:31" />पर बिगर दीवार के गांवमन के घरमन ला देस के खेत सहीं समझे जावय। ओमन ला छोंड़ाय जा सकत हे, अऊ ओमन ला जुबली बछर म वापिस कर दिये जावय।<verse eid="LEV 25:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 25:32" />“ ‘लेवीमन ला अपन अधिकार के लेवी सहरमन म हमेसा अपन घर ला छोंड़ाय के अधिकार हवय। <verse eid="LEV 25:32" /><verse number="33" style="v" sid="LEV 25:33" />एकरसेति लेवीमन के संपत्ति ह छोंड़ाय जा सकत हे—याने कि ओमन के अधिकार के सहर म बेचे गय कोनो घर—अऊ ये घर ह जुबली बछर म वापिस करे जावय, काबरकि इसरायलीमन के बीच, लेवीमन के सहर के घरमन लेवीमन के संपत्ति अंय। <verse eid="LEV 25:33" /><verse number="34" style="v" sid="LEV 25:34" />पर ओमन के नगर के चरागन ह झन बेचे जावय; काबरकि येमा ओमन के हमेसा के अधिकार हवय।<verse eid="LEV 25:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 25:35" />“ ‘कहूं तुम्हर कोनो संगी इसरायली गरीब हो जाथे, अऊ तुम्हर बीच म ओकर दुरदसा होवय, त तुमन ओकर मदद करव, जइसने कि तुमन कोनो परदेसी अऊ अजनबी ला करथव, ताकि ओह तुम्हर बीच म रह सकय। <verse eid="LEV 25:35" /><verse number="36" style="v" sid="LEV 25:36" />तुमन ओकर ले बियाज झन लेवव या ओकर ले कोनो फायदा झन लेवव, पर अपन परमेसर के भय मानव, ताकि ओह तुम्हर बीच म रह सकय। <verse eid="LEV 25:36" /><verse number="37" style="v" sid="LEV 25:37" />तुमन ओला न तो बियाज म पईसा उधार देवव अऊ न ही फायदा लेके ओला जेवन के कोनो चीज बेचव। <verse eid="LEV 25:37" /><verse number="38" style="v" sid="LEV 25:38" />मेंह यहोवा तुम्हर परमेसर अंव, जऊन ह तुमन ला मिसर देस ले निकालके लानेंव, ताकि तुमन ला कनान देस देवंव अऊ तुम्हर परमेसर होवंव।<verse eid="LEV 25:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 25:39" />“ ‘कहूं तुम्हर कोनो संगी इसरायली गरीब हो जाथे अऊ अपनआप ला तुम्हर हांथ म बेच देथे, त तुमन ओकर ले गुलाम सहीं काम झन करावव। <verse eid="LEV 25:39" /><verse number="40" style="v" sid="LEV 25:40" />ओकर संग बनिहार या तुम्हर बीच म कुछू समय तक रहइया मनखे सहीं बरताव करव; ओह तुम्हर बर जुबली बछर तक काम करय। <verse eid="LEV 25:40" /><verse number="41" style="v" sid="LEV 25:41" />तब ओह अऊ ओकर लइकामन छोंड़ दिये जावंय, ताकि ओमन अपन गोत्र अऊ अपन पुरखामन के संपत्ति करा वापिस जा सकंय। <verse eid="LEV 25:41" /><verse number="42" style="v" sid="LEV 25:42" />काबरकि इसरायलीमन मोर सेवक अंय, जऊन मन ला मेंह मिसर देस ले निकालके लानेंव; ओमन ला गुलाम के रूप म झन बेचे जावय। <verse eid="LEV 25:42" /><verse number="43" style="v" sid="LEV 25:43" />ओमन ऊपर कठोरता से सासन झन करव, पर अपन परमेसर के भय मानव।<verse eid="LEV 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LEV 25:44" />“ ‘तुम्हर पुरूस अऊ महिला गुलाममन तुम्हर चारों कोति के आनजात के होवंय, जेमन ला तुमन गुलाम के रूप म बिसावव। <verse eid="LEV 25:44" /><verse number="45" style="v" sid="LEV 25:45" />जऊन मन तुम्हर बीच म कुछू समय बर रहत हवंय अऊ ओमन के कुल के सदस्य, जऊन मन तुम्हर देस म जनमे हवंय, येमा के कुछू झन ला घलो तुमन बीसा सकत हव, अऊ ओमन तुम्हर संपत्ति हो जाहीं। <verse eid="LEV 25:45" /><verse number="46" style="v" sid="LEV 25:46" />तुमन ओमन ला अपन लइकामन बर उत्तराधिकार म मिले संपत्ति के रूप म वसीयत कर सकत हव अऊ ओमन ला जिनगी भर गुलाम बना सकत हव, पर तुमन अपन संगी इसरायलीमन ऊपर कठोरता से सासन झन करव।<verse eid="LEV 25:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LEV 25:47" />“ ‘कहूं तुम्हर बीच म रहइया कोनो परदेसी धनी हो जाथे अऊ तुम्हर कोनो संगी इसरायली गरीब हो जाथे अऊ अपनआप ला ओ परदेसी या परदेसी के गोत्र के कोनो सदस्य करा बेच देथे, <verse eid="LEV 25:47" /><verse number="48" style="v" sid="LEV 25:48" />त अपनआप ला बेचे के बाद, ओकर करा छुटकारा के अधिकार रहिथे। ओकर कोनो रिस्तेदार ओला छोंड़ा सकत हे: <verse eid="LEV 25:48" /><verse number="49" style="v" sid="LEV 25:49" />ओकर कोनो कका या चचेरा-भाई या ओकर गोत्र म ओकर कोनो खून के रिस्तेदार ओला छोंड़ा सकत हे। या कहूं ओह धनी हो जाथे, त ओह अपनआप ला छोंड़ा सकत हे। <verse eid="LEV 25:49" /><verse number="50" style="v" sid="LEV 25:50" />ओह अपन बिसइया के संग अपन बेचे जाय के बछर ले जुबली बछर तक गनय। ओ गने गय बछर म एक बनिहार के कतेक बनी होथे, ओकर मुताबिक ओकर छोंड़ाय जाय के दाम होवय। <verse eid="LEV 25:50" /><verse number="51" style="v" sid="LEV 25:51" />कहूं जादा बछर बांचे हवय, त ओकर बर दिये गय दाम के एक बड़े भाग ला अपन छुटकारा बर लहुंटा देवय। <verse eid="LEV 25:51" /><verse number="52" style="v" sid="LEV 25:52" />कहूं जुबली बछर बर सिरिप थोरकून बछर बांचे हवय, त ओमन ओकर हिसाब लगावंय अऊ ओकर मुताबिक ओकर छुटकारा के दाम चुकावंय। <verse eid="LEV 25:52" /><verse number="53" style="v" sid="LEV 25:53" />ओला साल दर साल बनिहार के सहीं समझे जावय; तुमन ये बात के धियान रखव कि ओकर मालिक ह ओकर ऊपर कठोरता से सासन झन करय।<verse eid="LEV 25:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="LEV 25:54" />“ ‘कहूं कोनो इसरायली येमा के कोनो घलो किसम ले छोंड़ाय नइं जावय, त ओला अऊ ओकर लइकामन ला जुबली बछर म छोंड़ दिये जावय, <verse eid="LEV 25:54" /><verse number="55" style="v" sid="LEV 25:55" />काबरकि इसरायलीमन सेवक के रूप म मोर अंय। ओमन मोर सेवक अंय, जऊन मन ला मेंह मिसर देस ले निकालके लानेंव। मेंह यहोवा तुम्हर परमेसर अंव।<verse eid="LEV 25:55" /></para>
  <chapter eid="LEV 25" />
  <chapter number="26" style="c" sid="LEV 26" />
  <para style="s1">हुकूम माने के ईनाम</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 26:1" />“ ‘तुमन अपन बर मूरती झन बनावव या अपन बर कोनो फोटू या कोनो पबितर पथरा झन ठाढ़ करव, अऊ अपन देस म दंडवत करे बर तुमन तरासके बनाय गय कोनो पथरा झन रखव। मेंह यहोवा तुम्हर परमेसर अंव।<verse eid="LEV 26:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="LEV 26:2" />“ ‘मोर बिसराम दिनमन ला मानव अऊ मोर पबितर-स्थान के आदर करव। मेंह यहोवा अंव।<verse eid="LEV 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 26:3" />“ ‘कहूं तुमन मोर बिधिमन म चलहू अऊ मोर हुकूममन के धियान से पालन करहू, <verse eid="LEV 26:3" /><verse number="4" style="v" sid="LEV 26:4" />त मेंह तुम्हर बर सही रितु म बरसा भेजहूं, अऊ भुइयां ह अपन फसल उपजाही अऊ रूखमन अपन फर दीहीं। <verse eid="LEV 26:4" /><verse number="5" style="v" sid="LEV 26:5" />तुम्हर मिंजई के काम ह चलते रहिही, जब तक कि अंगूर टोरे के समय नइं आ जावय अऊ अंगूर टोरई ह लगातार चलते रहिही, जब तक कि बोये के समय ह नइं आ जावय, अऊ तुमन भरपेट भोजन करहू अऊ अपन देस म सुरकछित बसे रहिहू।<verse eid="LEV 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 26:6" />“ ‘मेंह देस म सुख-सांति दूहूं, अऊ तुमन अराम से सुतहू अऊ तुमन ला कोनो डरवइया नइं होहीं। मेंह देस म ले हिंसक जंगली पसुमन ला निकाल दूहूं, अऊ तुम्हर देस म कोनो तलवार ले नइं मारे जाही। <verse eid="LEV 26:6" /><verse number="7" style="v" sid="LEV 26:7" />तुमन अपन बईरीमन के पीछा करहू अऊ ओमन तुम्हर आघू म तलवार ले मारे जाहीं। <verse eid="LEV 26:7" /><verse number="8" style="v" sid="LEV 26:8" />तुमन के पांच झन ह सौ झन ला अऊ तुमन के सौ झन ह दस हजार ला भगाहीं, अऊ तुम्हर बईरीमन तुम्हर आघू म तलवार ले मारे जाहीं।<verse eid="LEV 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 26:9" />“ ‘मेंह तुम्हर ऊपर दया करहूं अऊ तुमन ला फलवंत करहूं अऊ तुमन ला गनती म बढ़ाहूं, अऊ मेंह अपन करार ला तुम्हर संग पूरा करहूं। <verse eid="LEV 26:9" /><verse number="10" style="v" sid="LEV 26:10" />नवां फसल ला रखे बर जब तुमन बीते बछर के फसल ला हटाहू, तब भी तुमन जुन्ना फसल ला खावत रहिहू। <verse eid="LEV 26:10" /><verse number="11" style="v" sid="LEV 26:11" />मेंह तुम्हर बीच म अपन निवास के जगह<note caller="+" style="f"><char style="fr" closed="false">26:11 </char><char style="ft" closed="false">या </char><char style="fq" closed="false">अपन </char><char style="fqa" closed="false">पबितर-तम्बू रखहूं</char></note> बनाहूं, अऊ मेंह तुमन ले घिन नइं करहूं। <verse eid="LEV 26:11" /><verse number="12" style="v" sid="LEV 26:12" />मेंह तुम्हर बीच म चले-फिरे करहूं अऊ तुम्हर परमेसर होहूं, अऊ तुमन मोर मनखे होहू। <verse eid="LEV 26:12" /><verse number="13" style="v" sid="LEV 26:13" />मेंह यहोवा तुम्हर परमेसर अंव, जऊन ह तुमन ला मिसर देस ले निकालके लानेंव, ताकि तुमन मिसरी मनखेमन के गुलाम झन बने रहव; मेंह तुम्हर जुड़ा के डांड़ी ला टोर दे हंव अऊ तुमन ला अइसने कर दे हंव कि तुमन मुड़ उठाके चल सकव।<verse eid="LEV 26:13" /></para>
  <para style="s1">हुकूम नइं माने के दंड</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 26:14" />“ ‘पर कहूं तुमन मोर नइं सुनहू अऊ ये जम्मो हुकूममन के पालन नइं करहू, <verse eid="LEV 26:14" /><verse number="15" style="v" sid="LEV 26:15" />अऊ कहूं तुमन मोर बिधिमन ला गरहन नइं करहू अऊ मोर कानून ले घिन करहू अऊ मोर जम्मो हुकूममन ला नइं मानहू अऊ ये किसम ले मोर करार ला टोर दूहू, <verse eid="LEV 26:15" /><verse number="16" style="v" sid="LEV 26:16" />त फेर मेंह तुम्हर संग अइसन करहूं: मेंह तुम्हर ऊपर अचानक आतंक, नास करइया बेमारी अऊ जर लानहूं, जेकर ले तुम्हर आंखी ह नइं दिखही अऊ तुमन अब्बड़ दुख पाहू। तुम्हर बीज बोवई ह घलो बेकार होही, काबरकि ओला तुम्हर बईरीमन खा डारहीं। <verse eid="LEV 26:16" /><verse number="17" style="v" sid="LEV 26:17" />मेंह तुम्हर बिरोध म हो जाहूं, जेकर ले तुमन अपन बईरीमन ले हार जाहू; जऊन मन तुम्हर ले घिन करथें, ओमन तुम्हर ऊपर सासन करहीं, अऊ जब तुम्हर कोनो पीछा नइं करत होही, तभो ले तुमन भागहू।<verse eid="LEV 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 26:18" />“ ‘ये जम्मो बात होय के बाद घलो, कहूं तुमन मोर नइं सुनहू, त मेंह तुम्हर पाप बर तुमन ला सात गुना दंड दूहूं। <verse eid="LEV 26:18" /><verse number="19" style="v" sid="LEV 26:19" />मेंह तुम्हर जिद्द ले भरे घमंड ला टोर दूहूं अऊ तुम्हर ऊपर अकास ला लोहा सहीं अऊ तुम्हर खाल्हे के भुइयां ला कांसा सहीं कर दूहूं। <verse eid="LEV 26:19" /><verse number="20" style="v" sid="LEV 26:20" />तुम्हर मेहनत ह बेकार जाही, काबरकि न तो तुम्हर भुइयां म फसल होही अऊ न ही तुम्हर देस के रूखमन म फर लगही।<verse eid="LEV 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 26:21" />“ ‘कहूं तुमन मोर बिरोध म चलतेच रहिहू अऊ मोर बात ला नइं सुनहू, त मेंह तुम्हर पापमन के मुताबिक तुम्हर दुख ला सात गुना बढ़ाहूं। <verse eid="LEV 26:21" /><verse number="22" style="v" sid="LEV 26:22" />मेंह तुम्हर बीच म जंगली जानवर भेजहूं, अऊ ओमन तुम्हर लइकामन ला धरके ले जाहीं, तुम्हर पसुमन ला मार डारहीं अऊ तुम्हर गनती ला अतका कम कर दीहीं कि तुम्हर सड़कमन सुन्ना हो जाहीं।<verse eid="LEV 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 26:23" />“ ‘एकर बाद घलो, यदि तुमन मोर ताड़ना ले नइं सुधरहू अऊ मोर बिरोध म चलते रहिहू, <verse eid="LEV 26:23" /><verse number="24" style="v" sid="LEV 26:24" />त मेंह घलो तुम्हर बिरोध म हो जाहूं अऊ तुम्हर पाप के सेति तुम्हर ऊपर सात गुना दुख-तकलीफ लानहूं। <verse eid="LEV 26:24" /><verse number="25" style="v" sid="LEV 26:25" />अऊ करार ला टोरे के बदला म, मेंह तुम्हर ऊपर तलवार चलवाहूं। जब तुमन अपन-अपन सहर म वापिस जाहू, त मेंह तुम्हर बीच म महामारी लानहूं, अऊ तुमन ला बईरी के हांथ म कर दिये जाही। <verse eid="LEV 26:25" /><verse number="26" style="v" sid="LEV 26:26" />जब में तुम्हर रोटी आय के जरिया ला बंद कर देवंव, तब दस माईलोगनमन एक ठन चूल्हा म रोटी बनाहीं, अऊ ओमन तुमन ला तऊलके थोर-थोर रोटी दीहीं। तुमन खाहू, पर तुम्हर पेट नइं भरही।<verse eid="LEV 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 26:27" />“ ‘ये जम्मो होय के बाद घलो, कहूं तुमन मोर नइं सुनहू अऊ मोर बिरोध म चलते रहिहू, <verse eid="LEV 26:27" /><verse number="28" style="v" sid="LEV 26:28" />त गुस्सा होके मेंह तुम्हर बिरोध म होहूं, अऊ में खुद तुम्हर पाप बर तुमन ला सात गुना दंड दूहूं। <verse eid="LEV 26:28" /><verse number="29" style="v" sid="LEV 26:29" />तुमन अपन बेटा-बेटीमन के मांस खाहू। <verse eid="LEV 26:29" /><verse number="30" style="v" sid="LEV 26:30" />मेंह तुम्हर ऊंच जगहमन<note caller="+" style="f"><char style="fr" closed="false">26:30 </char><char style="ft" closed="false">अराधना के ऊंच </char><char style="fq" closed="false">जगहमन</char></note> ला गिरा दूहूं, तुम्हर धूप के बेदीमन ला नास कर दूहूं अऊ तुम्हर लासमन ला तुम्हर निरजीव मूरतीमन ऊपर कुढ़ो दूहूं, अऊ मेंह तुम्हर ले घिन करहूं। <verse eid="LEV 26:30" /><verse number="31" style="v" sid="LEV 26:31" />मेंह तुम्हर सहरमन ला खंडहर बना दूहूं अऊ तुम्हर पबितर-स्थानमन ला उजार दूहूं अऊ तुम्हर बलिदान के सुख-देवइया सुगंध ले मोला कोनो खुसी नइं होही। <verse eid="LEV 26:31" /><verse number="32" style="v" sid="LEV 26:32" />मेंह खुद तुम्हर देस ला उजार दूहूं, ताकि उहां बसे तुम्हर बईरीमन डरा जाहीं। <verse eid="LEV 26:32" /><verse number="33" style="v" sid="LEV 26:33" />मेंह तुमन ला जाति-जाति के मनखेमन के बीच तितिर-बितिर कर दूहूं अऊ अपन तलवार खींचके निकालहूं अऊ तुम्हर पीछा करहूं। तुम्हर देस ह सुन्ना हो जाही अऊ तुम्हर सहरमन नास हो जाहीं। <verse eid="LEV 26:33" /><verse number="34" style="v" sid="LEV 26:34" />तब, जब ये देस ह उजरे रहिही अऊ तुमन अपन बईरीमन के देस म रहिहू, तब ये देस ह अपन बिसराम बछरमन के आनंद मनाही; देस ह अराम करही अऊ अपन बिसराम बछर के आनंद उठाही। <verse eid="LEV 26:34" /><verse number="35" style="v" sid="LEV 26:35" />जतेक समय तक येह बीरान रहिही, ओह येकर सुसताय के समय होही, काबरकि जब तुमन येमा रहत रहेव, त बिसराम बछर म येला सुसताय बर नइं मिलिस।<verse eid="LEV 26:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LEV 26:36" />“ ‘तुमन म के जऊन मन बांच गे हवंय, ओमन ला अपन बईरीमन के देस म अइसने डरपोक बना दूहूं कि हवा चले के कारन पान के खड़खड़ाय के अवाज सुनके ओमन भागहीं। ओमन अइसने भागहीं, मानो कोनो तलवार लेके ओमन के पीछा करत हे, अऊ ओमन गिर पड़हीं, हालाकि कोनो ओमन के पीछा नइं करत होही। <verse eid="LEV 26:36" /><verse number="37" style="v" sid="LEV 26:37" />ओमन एक-दूसर के ऊपर गिरहीं, मानो कोनो तलवार ले बांचे बर भागत हवय, हालाकि कोनो घलो ओमन के पीछा नइं करत होही। एकरसेति तुमन अपन बईरीमन के सामना नइं कर सकहू। <verse eid="LEV 26:37" /><verse number="38" style="v" sid="LEV 26:38" />तुमन आने जाति के मनखेमन के बीच म नास हो जाहू; तुम्हर बईरीमन के भुइयां ह तुमन ला खा जाही। <verse eid="LEV 26:38" /><verse number="39" style="v" sid="LEV 26:39" />तुमन म जऊन मन बांचे हवंय, ओमन अपन पाप के कारन अपन बईरीमन के देस म नास हो जाहीं; ओमन अपन पुरखामन के पाप के कारन घलो नास हो जाहीं।<verse eid="LEV 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LEV 26:40" />“ ‘पर कहूं ओमन अपन अऊ अपन पुरखामन के पाप ला मान लीहीं—याने कि मोर बर ओमन के बिसवासघात अऊ ओमन के बईरता ला, <verse eid="LEV 26:40" /><verse number="41" style="v" sid="LEV 26:41" />जेकर कारन मेंह ओमन के बिरोध म हो गेंव अऊ मेंह ओमन ला ओमन के बईरीमन के देस म भेज देंव—तब जब ओमन के कठोर हिरदय ह नरम हो जावय अऊ ओमन अपन पाप के दाम चुकावंय, <verse eid="LEV 26:41" /><verse number="42" style="v" sid="LEV 26:42" />त मेंह याकूब के संग मोर करार अऊ इसहाक के संग मोर करार अऊ अब्राहम के संग मोर करार ला सुरता करहूं, अऊ मेंह ये देस ला घलो सुरता करहूं। <verse eid="LEV 26:42" /><verse number="43" style="v" sid="LEV 26:43" />काबरकि ओमन के दुवारा ओ देस ह छोंड़ दिये गे होही अऊ ओमन के छोंड़ दिये गय समय म देस ह अपन बिसराम के आनंद उठाही। ओमन अपन पाप के दाम चुकाहीं, काबरकि ओमन मोर कानूनमन ला नइं मानिन अऊ मोर बिधिमन ले घिन करिन। <verse eid="LEV 26:43" /><verse number="44" style="v" sid="LEV 26:44" />तभो ले, ये जम्मो होय के बाद, जब ओमन अपन बईरीमन के देस म होवंय, त मेंह ओमन ला नइं छोंड़ देवंव अऊ न ही ओमन ले अइसने घिन करंव कि ओमन के संग मोर करार ला टोरके ओमन ला पूरा नास कर देवंव। मेंह यहोवा, ओमन के परमेसर अंव। <verse eid="LEV 26:44" /><verse number="45" style="v" sid="LEV 26:45" />पर ओमन के भलई बर, मेंह ओमन के पुरखामन के संग मोर करार ला सुरता करहूं, जेमन ला मेंह जाति-जाति के मनखेमन के देखत म मिसर देस ले बाहिर निकाल लानेंव, ताकि मेंह ओमन के परमेसर होवंव। मेंह यहोवा अंव।’ ”<verse eid="LEV 26:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LEV 26:46" />येमन बिधि, कानून अऊ नियम अंय, जऊन ला यहोवा ह सीनय पहाड़ म अपन अऊ इसरायलीमन के बीच म मूसा के दुवारा ठहिराईस।<verse eid="LEV 26:46" /></para>
  <chapter eid="LEV 26" />
  <chapter number="27" style="c" sid="LEV 27" />
  <para style="s1">जऊन ह यहोवा के अय, ओकर छुटकारा</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 27:1" />फेर यहोवा ह मूसा ला कहिस, <verse eid="LEV 27:1" /><verse number="2" style="v" sid="LEV 27:2" />“इसरायलीमन ले गोठिया अऊ ओमन ला कह: ‘यदि कोनो मनखे ह कोनो मनखे ला यहोवा ला अरपन करे के बिसेस मन्नत मानथे अऊ यदि ये मन्नत ह ओ मनखे के बरोबर कीमत देय के दुवारा होवय, <verse eid="LEV 27:2" /><verse number="3" style="v" sid="LEV 27:3" />त बीस ले साठ बछर के आदमी के कीमत पबितर-स्थान के सेकेल<note caller="+" style="f"><char style="fr" closed="false">27:3 </char><char style="ft" closed="false">एक सेकेल ह लगभग 12 ग्राम के बरोबर होथे।</char></note> के मुताबिक चांदी के पचास सेकेल ठहिरावव; <verse eid="LEV 27:3" /><verse number="4" style="v" sid="LEV 27:4" />अऊ माईलोगन के कीमत तीस सेकेल<note caller="+" style="f"><char style="fr" closed="false">27:4 </char><char style="ft" closed="false">लगभग 345 ग्राम</char></note> ठहिरावव; <verse eid="LEV 27:4" /><verse number="5" style="v" sid="LEV 27:5" />पांच ले बीस बछर के मनखे के कीमत—यदि ओह बाबू-पीला अय, त ओकर कीमत बीस सेकेल अऊ यदि ओह नोनी-पीला अय, त ओकर कीमत दस सेकेल ठहिरावव; <verse eid="LEV 27:5" /><verse number="6" style="v" sid="LEV 27:6" />एक महिना ले लेके पांच बछर तक के मनखे के कीमत—यदि ओह बाबू-पीला अय, त ओकर कीमत चांदी के पांच सेकेल<note caller="+" style="f"><char style="fr" closed="false">27:6 </char><char style="ft" closed="false">लगभग 58 ग्राम</char></note> अऊ यदि नोनी-पीला अय, त ओकर कीमत चांदी के तीन सेकेल<note caller="+" style="f"><char style="fr" closed="false">27:6 </char><char style="ft" closed="false">लगभग 35 ग्राम</char></note> ठहिरावव; <verse eid="LEV 27:6" /><verse number="7" style="v" sid="LEV 27:7" />साठ बछर या ओकर ले जादा उमर के मनखे के कीमत—यदि आदमी अय, त ओकर कीमत पंदरह सेकेल अऊ माईलोगन अय, त ओकर कीमत दस सेकेल ठहिरावव। <verse eid="LEV 27:7" /><verse number="8" style="v" sid="LEV 27:8" />कहूं कोनो मनखे ह अतका गरीब अय कि ओह ठहिराय गय कीमत ला नइं पटा सकय, त अरपन करे गय मनखे ला पुरोहित करा लाने जावय अऊ पुरोहित ह ओकर कीमत मन्नत मनइया के हैसियत के मुताबिक ठहिराही।<verse eid="LEV 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 27:9" />“ ‘कहूं कोनो मनखे के मन्नत ह कोनो पसु अय, जऊन ला यहोवा बर बलिदान के रूप म दिये जा सकत हे, त यहोवा ला दिये गय अइसने पसु ह पबितर हो जाथे। <verse eid="LEV 27:9" /><verse number="10" style="v" sid="LEV 27:10" />ओ मनखे ह ओला फेर कोनो किसम ले झन बदलय; खराप के बदले बढ़िया ला या बढ़िया के बदले खराप ला झन देवय; कहूं ओह एक पसु के बदला म आने पसु देवय, त पहिली अऊ बदला म दिये गय पसु, दूनों पबितर हो जाथें। <verse eid="LEV 27:10" /><verse number="11" style="v" sid="LEV 27:11" />कहूं ओह बिधि के मुताबिक कोनो असुध पसु के मन्नत माने हवय, जऊन ला यहोवा बर बलिदान के रूप म नइं दिये जा सकय, त ओ पसु ला पुरोहित करा लाने जावय, <verse eid="LEV 27:11" /><verse number="12" style="v" sid="LEV 27:12" />अऊ पुरोहित ह ओ पसु ला जांचके बढ़िया या खराप ठहिराही। ओकर बाद, जऊन घलो कीमत पुरोहित ह ठहिरावय, ओकर ओतकेच कीमत होही। <verse eid="LEV 27:12" /><verse number="13" style="v" sid="LEV 27:13" />कहूं ओकर मालिक ह ओ पसु ला छोंड़ाय चाहथे, त ओह पुरोहित के दुवारा ठहिराय गे कीमत म पांचवां भाग अऊ देके ओला छोंड़ा सकत हे।<verse eid="LEV 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 27:14" />“ ‘कहूं कोनो मनखे अपन घर ला पबितर चीज के रूप म यहोवा ला अरपन करय, त पुरोहित ह ओ घर के जांच करके ओला बढ़िया या खराप बतावय। ओकर बाद, जऊन घलो कीमत पुरोहित ह ठहिरावय, ओकर ओतकेच कीमत होही। <verse eid="LEV 27:14" /><verse number="15" style="v" sid="LEV 27:15" />कहूं अरपन करइया ह अपन घर ला छोंड़ाय चाहथे, त ओह ठहिराय गे कीमत म पांचवां भाग अऊ देवय, त ओ घर ह फेर ओकर हो जाही।<verse eid="LEV 27:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 27:16" />“ ‘कहूं कोनो मनखे ह अपन परिवारिक भुइयां के कुछू भाग ला यहोवा बर अरपन करथे, त ओमा बोये बर जतका बीजा के जरूरत होथे, ओकर मुताबिक ओ भाग के कीमत तय करे जावय—एक होमेर<note caller="+" style="f"><char style="fr" closed="false">27:16 </char><char style="ft" closed="false">लगभग 135 किलोग्राम</char></note> जौ बीजा के चांदी के पचास सेकेल। <verse eid="LEV 27:16" /><verse number="17" style="v" sid="LEV 27:17" />कहूं ओह जुबली बछर म अपन कोनो खेत अरपन करय, त ओकर ठहिराय गे कीमत ह ओहीच रहय। <verse eid="LEV 27:17" /><verse number="18" style="v" sid="LEV 27:18" />पर कहूं ओह जुबली बछर के पाछू अपन कोनो खेत ला अरपन करथे, त अवइया जुबली बछर बर जतका बछर बांचे हवय, ओकर मुताबिक पुरोहित ह ओ खेत के कीमत ठहिरावय, अऊ येकर ठहिराय गे कीमत ह कम हो जाही। <verse eid="LEV 27:18" /><verse number="19" style="v" sid="LEV 27:19" />कहूं खेत ला अरपन करइया ह ओ खेत ला छोंड़ाय बर चाहथे, त ओह ठहिराय गे कीमत म पांचवां भाग अऊ देवय, त ओ खेत ह फेर ओकरेच हो जाही। <verse eid="LEV 27:19" /><verse number="20" style="v" sid="LEV 27:20" />पर कहूं ओह ओ खेत ला नइं छोंड़ावय, या यदि ओह ओला कोनो आने मनखे ला बेच देवय, त ओ खेत ह फेर कभू छोंड़ाय नइं जा सकय। <verse eid="LEV 27:20" /><verse number="21" style="v" sid="LEV 27:21" />जब ओ खेत ह जुबली बछर म छूट जावय, त ओह यहोवा ला अरपित खेत सहीं पबितर हो जाही; अऊ ओह पुरोहित के संपत्ति हो जाही।<verse eid="LEV 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 27:22" />“ ‘कहूं कोनो मनखे ह कोनो बिसाय खेत ला यहोवा ला अरपन करथे, जऊन ह कि ओकर पुरखा के खेत नो हय, <verse eid="LEV 27:22" /><verse number="23" style="v" sid="LEV 27:23" />त अवइया जुबली बछर के मुताबिक पुरोहित ह ओकर कीमत ठहिरावय, अऊ मालिक ह ओहीच दिन यहोवा ला चघाय गे पबितर चीज के रूप म ओ कीमत ला दे देवय। <verse eid="LEV 27:23" /><verse number="24" style="v" sid="LEV 27:24" />जुबली बछर म ओ खेत ला ओ मनखे ला लहुंटा दिये जावय, जेकर ले ओला बिसाय गे रिहिस, ओ मनखे ला जेकर ओ खेत रिहिस। <verse eid="LEV 27:24" /><verse number="25" style="v" sid="LEV 27:25" />जब कोनो चीज के कीमत ठहिराय जाथे, ओ कीमत ह पबितर-स्थान के सेकेल मुताबिक ठहिराय जावय, सेकेल ह बीस गेराह<note caller="+" style="f"><char style="fr" closed="false">27:25 </char><char style="ft" closed="false">एक गेराह ह लगभग 0.6 ग्राम होथे।</char></note> के ठहिरय।<verse eid="LEV 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 27:26" />“ ‘कोनो मनखे कोनो पसु के पहिलांत पीला ला अरपन झन करय, काबरकि पहिली जनमे के कारन ओ पीला ह पहिले ही यहोवा के हो जाथे; चाहे ओह कोनो बईला होवय या कोनो भेड़, येह यहोवा के अय। <verse eid="LEV 27:26" /><verse number="27" style="v" sid="LEV 27:27" />यदि ओह कोनो असुध पसु अय, त ओकर ठहिराय गे कीमत म पांचवां भाग अऊ देके ओला फेर वापिस बिसाय जा सकथे। कहूं ओ पसु ह छोंड़ाय नइं जावय, त ओकर ठहिराय गे कीमत के मुताबिक ओला बेच दिये जावय।<verse eid="LEV 27:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 27:28" />“ ‘पर जब कोनो मनखे अपन कोनो चीज ला यहोवा ला अरपित करथे—चाहे ओह मनखे होवय या पसु या पुरखा के खेत—ओह न तो बेचे जावय अऊ न ही छोंड़ाय जावय; अइसने अरपन करे गय हर एक चीज यहोवा बर महा पबितर अय।<verse eid="LEV 27:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 27:29" />“ ‘जऊन मनखे ला नास करे बर अरपित करे गे हवय, ओला छोंड़ाय झन जावय; ओह मार डारे जावय।<verse eid="LEV 27:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 27:30" />“ ‘भुइयां के हर एक चीज के दसमांस, चाहे माटी ले उपजाय बीजा होवय या रूख के फर, ओह यहोवा के अय; ओह यहोवा बर पबितर अय। <verse eid="LEV 27:30" /><verse number="31" style="v" sid="LEV 27:31" />जऊन कोनो अपन दसमांस म ले कुछू भाग ला छोंड़ाय चाहथे, त ओकर कीमत म पांचवां भाग जादा देके ओला छोंड़ा सकथे। <verse eid="LEV 27:31" /><verse number="32" style="v" sid="LEV 27:32" />गाय-बईला या भेड़-बकरी के झुंड के दसमांस<note caller="+" style="f"><char style="fr" closed="false">27:32 </char><char style="ft" closed="false">घरेलू-पसुमन के दसमांस</char></note>—हर एक झुंड के दसवां पसु, जऊन ह चरवाहा के गने जाय के बेरा ओकर लउठी के तरी ले निकलथे, ओह यहोवा बर पबितर ठहिरही। <verse eid="LEV 27:32" /><verse number="33" style="v" sid="LEV 27:33" />कोनो घलो मनखे बढ़िया या खराप होय के चिंता झन करय अऊ न ही ओमा कोनो अदला-बदली करय। कहूं कोनो मनखे अदला-बदली करथे, त ओ पसु अऊ ओकर बदले म दिये गय पसु, दूनों पबितर हो जाथें अऊ ओमन ला छोंड़ाय नइं जा सकय।’ ”<verse eid="LEV 27:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LEV 27:34" />येमन ओ हुकूम अंय, जऊन ला यहोवा ह सीनय पहाड़ म मूसा ला इसरायलीमन बर दीस।<verse eid="LEV 27:34" /></para>
  <chapter eid="LEV 27" />
</usx>