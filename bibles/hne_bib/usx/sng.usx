<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="SNG" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  <para style="h">उत्तम गीत</para>
  <para style="toc1">उत्तम गीत सुलेमान के</para>
  <para style="toc2">उत्तम गीत</para>
  <para style="toc3">उत्तम</para>
  <para style="mt1">उत्तम गीत</para>
  <para style="mt2">सुलेमान के</para>
  <chapter number="1" style="c" sid="SNG 1"/>
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1"/>सुलेमान के उत्तम गीत।<verse eid="SNG 1:1"/></para>
  <para style="b"/>
  <para style="sp">दुलहिन</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 1:2"/>ओह अपन मुहूं ले मोर चूमा लेवय—</para>
  <para style="q2" vid="SNG 1:2">काबरकि तोर मया ह अंगूर के मंद ले जादा खुसी देथे।<verse eid="SNG 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 1:3"/>तोर इतर के खुसबू ह बने लगथे;</para>
  <para style="q2" vid="SNG 1:3">तोर नांव ह ढारे गय इतर के सहीं अय।</para>
  <para style="q2" vid="SNG 1:3">एकरसेति जवान माईलोगनमन तोर ले मया करथें!<verse eid="SNG 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 1:4"/>मोला अपन संग ले चल—आ हमन भाग जावन!</para>
  <para style="q2" vid="SNG 1:4">राजा ह मोला अपन कमरा म ले जावय।</para>
  <para style="sp" vid="SNG 1:4">सहेलीमन</para>
  <para style="q1" vid="SNG 1:4">हमन तोर म आनंद अऊ खुसी मनाथन;</para>
  <para style="q2" vid="SNG 1:4">हमन अंगूर के मंद ले जादा तोर मया के गुनगान करबो।</para>
  <para style="sp" vid="SNG 1:4">दुलहिन</para>
  <para style="q1" vid="SNG 1:4">ओमन तोर ले मया करके सही करथें!<verse eid="SNG 1:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 1:5"/>हे यरूसलेम के बेटीमन,</para>
  <para style="q2" vid="SNG 1:5">मेंह कारी तो हंव, फेर सुघर हंव,</para>
  <para style="q1" vid="SNG 1:5">केदार<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">केदार ह इसमायल के एक गोत्र रिहिस; देखव (<char style="xt"><ref loc="GEN 25:13">उत 25:13</ref></char>; <char style="xt"><ref loc="ISA 21:16-17">यसा 21:16‑17‑17</ref></char>; <char style="xt"><ref loc="PSA 120:5">भजन 120:5</ref></char>); येमन खास करके करिया तम्बू म निवास करंय</char></note> के तम्बूमन सहीं कारी,</para>
  <para style="q2" vid="SNG 1:5">सुलेमान के तम्बू के परदामन सहीं।<verse eid="SNG 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 1:6"/>मोला एकटक झन देख, काबरकि मेंह कारी हंव।</para>
  <para style="q2" vid="SNG 1:6">काबरकि मेंह सूरज ले झोला गे हंव।</para>
  <para style="q1" vid="SNG 1:6">मोर भाईमन मोर ले गुस्सा करिन</para>
  <para style="q2" vid="SNG 1:6">अऊ ओमन मोला अंगूर के बारीमन के रखवारीन बना दीन;</para>
  <para style="q2" vid="SNG 1:6">मेंह अपन खुद के अंगूर के बारी के रखवारी नइं करेंव।<verse eid="SNG 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 1:7"/>मोला बता, तें मोर मयारू,</para>
  <para style="q2" vid="SNG 1:7">अपन भेड़-बकरीमन ला कहां चराथस?</para>
  <para style="q2" vid="SNG 1:7">अऊ मंझनियां तेंह ओमन ला कहां सुरताय बर रखथस?</para>
  <para style="q1" vid="SNG 1:7">तोर संगीमन के भेड़-बकरीमन के बाजू म,</para>
  <para style="q2" vid="SNG 1:7">मेंह काबर घूंघट ढांके माईलोगन सहीं होवंव?<verse eid="SNG 1:7"/></para>
  <para style="sp">सहेलीमन</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 1:8"/>हे सबले सुघर माईलोगन, कहूं तेंह नइं जानत हस,</para>
  <para style="q2" vid="SNG 1:8">त भेड़मन के खुर के चिनहां ला देखत चल</para>
  <para style="q1" vid="SNG 1:8">अऊ चरवाहामन के तम्बूमन के तीर म</para>
  <para style="q2" vid="SNG 1:8">अपन छेरी-पीलामन ला चरा।<verse eid="SNG 1:8"/></para>
  <para style="sp">दूल्हा</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 1:9"/>हे मोर मयारू, मेंह तोर तुलना</para>
  <para style="q2" vid="SNG 1:9">फिरौन के रथमन म फंदाय घोड़ामन के बीच एक घोड़ी ले करथंव।<verse eid="SNG 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 1:10"/>तोर गाल ह कनफूली के संग,</para>
  <para style="q2" vid="SNG 1:10">अऊ तोर घेंच ह जेवर ले पीरोय हार के संग सुघर लगथे।<verse eid="SNG 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 1:11"/>हमन तोर बर चांदी के जड़े</para>
  <para style="q2" vid="SNG 1:11">सोन के कनफूली बनवाबो।<verse eid="SNG 1:11"/></para>
  <para style="sp">दुलहिन</para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 1:12"/>राजा ह जब अपन मेज करा बईठे रिहिस,</para>
  <para style="q2" vid="SNG 1:12">त मोर इतर ह अपन खुसबू फईलाईस।<verse eid="SNG 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 1:13"/>मोर मयारू ह मोर बर लोहबान के छोटे खुसबू के थैली सहीं अय,</para>
  <para style="q2" vid="SNG 1:13">जऊन ह मोर छाती के बीच म रहिथे।<verse eid="SNG 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 1:14"/>मोर मयारू ह मोर बर मेंहदी के फूलमन के गुच्छा सहीं अय,</para>
  <para style="q2" vid="SNG 1:14">जऊन ह एन-गदी<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="fq" closed="false">एन-गदी </char><char style="ft" closed="false">ह मिरतू सागर के दक्खिन-पछिम किनारा म छइहांवाले एक उपजाऊ जगह अय, जिहां पानी के सोत हवय</char></note> के अंगूर के बारीमन म मिलथे।<verse eid="SNG 1:14"/></para>
  <para style="sp">दूल्हा</para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 1:15"/>हे मोर मयारू, तें कतेक सुघर हस!</para>
  <para style="q2" vid="SNG 1:15">सिरतों म, कतेक सुघर हस!</para>
  <para style="q2" vid="SNG 1:15">तोर आंखीमन पंड़की के सहीं हवंय।<verse eid="SNG 1:15"/></para>
  <para style="sp">दुलहिन</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 1:16"/>हे मोर मयारू, तें कतेक सुघर हस!</para>
  <para style="q2" vid="SNG 1:16">सिरतों म, कतेक मोह लेनेवाला हस!</para>
  <para style="q2" vid="SNG 1:16">अऊ हमर दसना ह ताजा हवय।<verse eid="SNG 1:16"/></para>
  <para style="sp">दूल्हा</para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 1:17"/>हमर घरमन के कड़ीमन देवदार के,</para>
  <para style="q2" vid="SNG 1:17">अऊ हमर छानी के लकड़ीमन घलो देवदार के अंय।<verse eid="SNG 1:17"/></para>
  <chapter eid="SNG 1"/>
  <chapter number="2" style="c" sid="SNG 2"/>
  <para style="sp">दुलहिन</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 2:1"/>में सारोन<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="fq" closed="false">सारोन </char><char style="ft" closed="false">इसरायल के भूमध्य सागर के किनारा के इलाका (देखव <char style="xt"><ref loc="ISA 35:2">यसा 35:2</ref> अऊ <ref loc="ISA 65:10">65:10</ref></char>)</char></note> के गुलाब,</para>
  <para style="q2" vid="SNG 2:1">अऊ घाटीमन के कुमुदिनी फूल अंव।<verse eid="SNG 2:1"/></para>
  <para style="sp">दूल्हा</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 2:2"/>मोर मयारू ह जवान माईलोगन के बीच म,</para>
  <para style="q2" vid="SNG 2:2">कांटामन के बीच म कुमुदिनी फूल सहीं अय।<verse eid="SNG 2:2"/></para>
  <para style="sp">दुलहिन</para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 2:3"/>जइसने कि जंगल के रूखमन के बीच म एक सेव के रूख,</para>
  <para style="q2" vid="SNG 2:3">वइसने ही मोर मयारू ह जवानमन के बीच म अय।</para>
  <para style="q1" vid="SNG 2:3">मोला ओकर छइहां म बईठके खुसी मिलथे,</para>
  <para style="q2" vid="SNG 2:3">अऊ ओकर फर के सुवाद ह मोला मीठ लगथे।<verse eid="SNG 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 2:4"/>ओह मोला भोज के घर म ले जावय,</para>
  <para style="q2" vid="SNG 2:4">अऊ ओकर मया के धजा ह मोर ऊपर होवय।<verse eid="SNG 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 2:5"/>मोला किसमिस के दाना ले ताकत देवव,</para>
  <para style="q2" vid="SNG 2:5">अऊ सेव के फर ले मोला तरो-ताजा करव,</para>
  <para style="q2" vid="SNG 2:5">काबरकि मेंह मया म दुरबल हो गे हवंव।<verse eid="SNG 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 2:6"/>ओकर डेरी हांथ ह मोर मुड़ के तरी म हवय,</para>
  <para style="q2" vid="SNG 2:6">अऊ ओकर जेवनी हांथ ह मोला पोटारथे।<verse eid="SNG 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 2:7"/>हे यरूसलेम के बेटीमन, मेंह तुमन ला</para>
  <para style="q2" vid="SNG 2:7">सुघर छोटे हिरन अऊ भांठा के हिरनीमन के किरिया खवाके कहत हंव:</para>
  <para style="q1" vid="SNG 2:7">जब तक मया ह खुदे नइं जाग उठय,</para>
  <para style="q2" vid="SNG 2:7">तब तक तुमन ओला झन भड़कावव या जगावव।<verse eid="SNG 2:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 2:8"/>सुन! हे मोर मयारू!</para>
  <para style="q2" vid="SNG 2:8">देख! ओह आवत हे,</para>
  <para style="q1" vid="SNG 2:8">ओह पहाड़मन ला पार करके,</para>
  <para style="q2" vid="SNG 2:8">पहाड़ीमन ले उछलत-कूदत आवत हे।<verse eid="SNG 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 2:9"/>मोर मयारू ह सुघर छोटे हिरन या जवान बारासींगा सहीं अय।</para>
  <para style="q2" vid="SNG 2:9">देखव! ओह हमर दीवार के पाछू म ठाढ़े हवय,</para>
  <para style="q1" vid="SNG 2:9">ओह खिड़की म ले देखत हे,</para>
  <para style="q2" vid="SNG 2:9">ओह जालीमन म ले झांकत हे।<verse eid="SNG 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 2:10"/>मोर मयारू ह मोर ले गोठियाईस अऊ कहिस,</para>
  <para style="q2" vid="SNG 2:10">“हे मोर मयारू, उठ!</para>
  <para style="q2" vid="SNG 2:10">हे मोर सुघर जन, मोर संग चल।<verse eid="SNG 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 2:11"/>देख, जड़काला ह बीत गे;</para>
  <para style="q2" vid="SNG 2:11">अऊ बारिस ह घलो खतम हो गीस अऊ चल दीस।<verse eid="SNG 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 2:12"/>धरती म फूलमन फूलथें;</para>
  <para style="q2" vid="SNG 2:12">गाना गाय के समय आ गे हवय,</para>
  <para style="q1" vid="SNG 2:12">हमर भुइयां म पंड़कीमन के</para>
  <para style="q2" vid="SNG 2:12">गुटरे के बोली सुनई देवत हे।<verse eid="SNG 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 2:13"/>अंजीर के रूख म ओकर छोटे फर लगे के सुरू हो गे हवय;</para>
  <para style="q2" vid="SNG 2:13">अंगूर के नारमन म फूले फूल के खुसबू बगरत हवय।</para>
  <para style="q1" vid="SNG 2:13">हे मोर मयारू! उठ, आ;</para>
  <para style="q2" vid="SNG 2:13">मोर सुघर जन, मोर संग चल।”<verse eid="SNG 2:13"/></para>
  <para style="sp">दूल्हा</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 2:14"/>हे मोर पंड़की! चट्टानमन के दरार म,</para>
  <para style="q2" vid="SNG 2:14">पहाड़मन के छुपे के जगह म,</para>
  <para style="q1" vid="SNG 2:14">मोला अपन चेहरा देखा,</para>
  <para style="q2" vid="SNG 2:14">मोला अपन बोली सुना;</para>
  <para style="q1" vid="SNG 2:14">काबरकि तोर बोली ह गुरतूर हवय,</para>
  <para style="q2" vid="SNG 2:14">अऊ तोर चेहरा ह सुघर हवय।<verse eid="SNG 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 2:15"/>हमर बर कोलिहामन ला पकड़व,</para>
  <para style="q2" vid="SNG 2:15">ओ नान-नान कोलिहामन ला</para>
  <para style="q1" vid="SNG 2:15">जऊन मन अंगूर के बारीमन ला उजारथें,</para>
  <para style="q2" vid="SNG 2:15">काबरकि हमर अंगूर के बारीमन म फूल आवत हवंय।<verse eid="SNG 2:15"/></para>
  <para style="sp">दुलहिन</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 2:16"/>मोर मयारू ह मोर अय अऊ मेंह ओकर अंव;</para>
  <para style="q2" vid="SNG 2:16">ओह भेड़-बकरी ला कुमुदिनी फूलमन के बीच म चराथे।<verse eid="SNG 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 2:17"/>संझा के होवत ले</para>
  <para style="q2" vid="SNG 2:17">अऊ जब तक छइहां ह लम्बा होके मिटा नइं जावय,</para>
  <para style="q1" vid="SNG 2:17">लहुंट आ, हे मोर मयारू,</para>
  <para style="q2" vid="SNG 2:17">अऊ सुघर छोटे हिरन सहीं हो जा</para>
  <para style="q1" vid="SNG 2:17">या बेतेर के पहाड़ीमन के</para>
  <para style="q2" vid="SNG 2:17">जवान बारासींगा सहीं हो जा।<verse eid="SNG 2:17"/></para>
  <para style="b"/>
  <chapter eid="SNG 2"/>
  <chapter number="3" style="c" sid="SNG 3"/>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 3:1"/>में रोज रात भर ओला अपन बिस्तर म खोजेंव,</para>
  <para style="q2" vid="SNG 3:1">जऊन ला मोर हिरदय ह मया करथे।</para>
  <para style="q2" vid="SNG 3:1">मेंह ओला खोजेंव, फेर ओला नइं पायेंव।<verse eid="SNG 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 3:2"/>अब मेंह उठहूं अऊ सहर म,</para>
  <para style="q2" vid="SNG 3:2">येकर गली अऊ चऊकमन म ओला खोजहूं;</para>
  <para style="q1" vid="SNG 3:2">मेंह ओला खोजहूं, जेला मेंह दिल से मया करथंव।</para>
  <para style="q2" vid="SNG 3:2">एकरसेति मेंह ओला खोजेंव, पर ओह नइं मिलिस।<verse eid="SNG 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 3:3"/>जऊन पहरा देवइयामन सहर के पहरा देवत किंदरत रहिथें,</para>
  <para style="q2" vid="SNG 3:3">ओमन ला मेंह भेंटेंव,</para>
  <para style="q2" vid="SNG 3:3">अऊ मेंह ओमन ला पुछेंव “का तुमन ओला देखे हव, जेला मेंह दिल से मया करथंव?”<verse eid="SNG 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 3:4"/>मेंह ओमन ले थोरकून दूरिहा गे रहेंव</para>
  <para style="q2" vid="SNG 3:4">कि मोला ओह मिलिस, जेला मेंह अपन दिल से मया करथंव।</para>
  <para style="q1" vid="SNG 3:4">मेंह ओला पोटार लेंव अऊ ओला जावन नइं देंव</para>
  <para style="q2" vid="SNG 3:4">जब तक कि मेंह ओला अपन दाई के घर म नइं ले गेंव,</para>
  <para style="q2" vid="SNG 3:4">याने अपन दाई के घर म, जऊन ह मोला अपन गरभ म रखे रिहिस।<verse eid="SNG 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 3:5"/>हे यरूसलेम के बेटीमन, मेंह तुमन ला सुघर छोटे हिरन</para>
  <para style="q2" vid="SNG 3:5">अऊ भांठा के हिरनीमन के किरिया खवाके कहत हंव:</para>
  <para style="q1" vid="SNG 3:5">जब तक मया ह खुदे नइं जाग उठय</para>
  <para style="q2" vid="SNG 3:5">तब तक तुमन ओला झन भड़कावव या जगावव।<verse eid="SNG 3:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 3:6"/>येह का ए, जऊन ह कुहरा के खंभा सहीं</para>
  <para style="q2" vid="SNG 3:6">सुन्ना जगह ले आवत हे;</para>
  <para style="q1" vid="SNG 3:6">येह गंधरस अऊ लोहबान के खुसबू ले भरे हवय</para>
  <para style="q2" vid="SNG 3:6">अऊ बेपारीमन के जम्मो मसाला ले बने हवय?<verse eid="SNG 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 3:7"/>देखव, येह तो सुलेमान के पालकी अय,</para>
  <para style="q2" vid="SNG 3:7">साठ जन योद्धा ओला पहरा देवत चलत हें,</para>
  <para style="q2" vid="SNG 3:7">अऊ येमन इसरायल के सूरबीर अंय,<verse eid="SNG 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 3:8"/>ओ जम्मो के जम्मो तलवार धरे हवंय</para>
  <para style="q2" vid="SNG 3:8">अऊ लड़ई म अनुभवी अंय,</para>
  <para style="q1" vid="SNG 3:8">हर एक के बाजू म तलवार बंधाय हवय,</para>
  <para style="q2" vid="SNG 3:8">अऊ ओमन रथिया के खतरा के सामना करे बर तियार हवंय।<verse eid="SNG 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 3:9"/>राजा सुलेमान ह अपन बर पालकी बनवाय हवय;</para>
  <para style="q2" vid="SNG 3:9">ओह लबानोन के लकड़ी ले येला बनवाय हवय।<verse eid="SNG 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 3:10"/>ओह येकर खंभामन ला चांदी ले,</para>
  <para style="q2" vid="SNG 3:10">अऊ ओकर आधार ला सोन ले बनवाय हवय।</para>
  <para style="q1" vid="SNG 3:10">ओकर बईठे के जगह ला बैंगनी ओनहा ले बनवाय हवय,</para>
  <para style="q2" vid="SNG 3:10">ओकर भीतर के जगह ला मया ले सजाय गे रहय।</para>
  <para style="q1" vid="SNG 3:10">हे यरूसलेम के बेटीमन, <verse eid="SNG 3:10"/><verse number="11" style="v" sid="SNG 3:11"/>बाहिर निकलव,</para>
  <para style="q2" vid="SNG 3:11">अऊ तुमन देखव, हे सियोन के बेटीमन।</para>
  <para style="q1" vid="SNG 3:11">मुकुट पहिरे सुलेमान राजा ला देखव,</para>
  <para style="q2" vid="SNG 3:11">ओ मुकुट, जेला ओकर दाई ह</para>
  <para style="q1" vid="SNG 3:11">ओला ओकर बिहाव के दिन पहिराईस,</para>
  <para style="q1" vid="SNG 3:11">ओ दिन, जब ओकर मन ह आनंदित रिहिस।<verse eid="SNG 3:11"/></para>
  <chapter eid="SNG 3"/>
  <chapter number="4" style="c" sid="SNG 4"/>
  <para style="s1">दूल्हा</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 4:1"/>हे मोर मयारू, तेंह कतेक सुघर हस!</para>
  <para style="q2" vid="SNG 4:1">सच म, कतेक सुघर हस!</para>
  <para style="q2" vid="SNG 4:1">तोर घूंघट के भीतर तोर आंखी ह पंड़की के सहीं अय।</para>
  <para style="q1" vid="SNG 4:1">तोर चुंदी ह गिलाद के पहाड़ीमन ले उतरत</para>
  <para style="q2" vid="SNG 4:1">छेरीमन के बरदी सहीं अय।<verse eid="SNG 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 4:2"/>तोर दांतमन अभीच ऊन कतरे भेड़मन के बरदी सहीं अंय,</para>
  <para style="q2" vid="SNG 4:2">जऊन ह नहा-खोरके ऊपर आवत हवय।</para>
  <para style="q1" vid="SNG 4:2">जेमा ले हर एक के जुड़वां हवय;</para>
  <para style="q2" vid="SNG 4:2">ओमा के कोनो अकेला नइं ए।<verse eid="SNG 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 4:3"/>तोर ओंठ ह सिन्दूरी रंग के फीता सहीं अय;</para>
  <para style="q2" vid="SNG 4:3">तोर मुहूं ह मनमोहना अय।</para>
  <para style="q1" vid="SNG 4:3">घूंघट के भीतर तोर कनपटी ह</para>
  <para style="q2" vid="SNG 4:3">अनार के आधा कुटा के सहीं दिखथे।<verse eid="SNG 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 4:4"/>तोर घेंच ह दाऊद के मीनार सहीं अय,</para>
  <para style="q2" vid="SNG 4:4">जऊन ह पथरा ला रचके बनाय गे हवय;</para>
  <para style="q1" vid="SNG 4:4">जेकर ऊपर हजार ढालमन टंगाय हवंय,</para>
  <para style="q2" vid="SNG 4:4">अऊ ओ जम्मो ढालमन सूरबीरमन के अंय।<verse eid="SNG 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 4:5"/>तोर दूनों स्तन हिरन के दू ठन पीलामन के सहीं अंय,</para>
  <para style="q2" vid="SNG 4:5">हिरन के दू ठन जुड़वां पीला सहीं,</para>
  <para style="q2" vid="SNG 4:5">जऊन मन कुमुदिनी फूलमन के बीच म चरथें।<verse eid="SNG 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 4:6"/>जब तक दिन जुड़ा नइं जावय</para>
  <para style="q2" vid="SNG 4:6">अऊ छइहां ह लम्बा होके मिटा नइं जावय,</para>
  <para style="q1" vid="SNG 4:6">तब तक में लोहबान के पहाड़</para>
  <para style="q2" vid="SNG 4:6">अऊ धूप के पहाड़ी ऊपर जाहूं।<verse eid="SNG 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 4:7"/>हे मोर मयारू, तेंह एकदम सुघर हस;</para>
  <para style="q2" vid="SNG 4:7">तोर म कोनो कमी नइं ए।<verse eid="SNG 4:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 4:8"/>हे मोर दुलहिन, लबानोन ले मोर संग आ,</para>
  <para style="q2" vid="SNG 4:8">लबानोन ले मोर संग आ।</para>
  <para style="q1" vid="SNG 4:8">अमाना के टीप ले,</para>
  <para style="q2" vid="SNG 4:8">सनीर, याने कि हेरमोन के टीप ले खाल्हे उतर,</para>
  <para style="q1" vid="SNG 4:8">सेरमन के मांद ले</para>
  <para style="q2" vid="SNG 4:8">अऊ चीतवामन के पहाड़ी डेरामन ले चले आ।<verse eid="SNG 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 4:9"/>हे मोर बहिनी, मोर दुलहिन, तेंह तो मोर मन ला मोही डारे;</para>
  <para style="q2" vid="SNG 4:9">अपन आंखी के एक नजर ले,</para>
  <para style="q1" vid="SNG 4:9">अपन माला के एक ही हीरा ले,</para>
  <para style="q2" vid="SNG 4:9">मोर मन ला मोही डारे।<verse eid="SNG 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 4:10"/>हे मोर बहिनी, मोर दुलहिन, तोर मया ह कतेक खुसी देवत हे!</para>
  <para style="q2" vid="SNG 4:10">तोर मया ह अंगूर के मंद ले घलो बढ़के खुसी देवत हे,</para>
  <para style="q1" vid="SNG 4:10">अऊ तोर इतर के खुसबू ह</para>
  <para style="q2" vid="SNG 4:10">कोनो मसाला के खुसबू ले घलो जादा बने अय!<verse eid="SNG 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 4:11"/>हे मोर दुलहिन, तोर ओंठ ले मधु-छत्ता के सहीं मिठास ह चूहथे,</para>
  <para style="q2" vid="SNG 4:11">तोर जीभ के तरी म मंधरस अऊ दूध के मिठास हवय।</para>
  <para style="q1" vid="SNG 4:11">तोर ओनहा के खुसबू ह</para>
  <para style="q2" vid="SNG 4:11">लबानोन के खुसबू सहीं अय।<verse eid="SNG 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 4:12"/>हे मोर बहिनी, मोर दुलहिन, तेंह एक ताला लगे बारी के सहीं अस;</para>
  <para style="q2" vid="SNG 4:12">तेंह बंद करे गय एक झरना अऊ मुहर लगे सोता अस।<verse eid="SNG 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 4:13"/>तोर पऊधामन अनार के एक बारी अंय,</para>
  <para style="q2" vid="SNG 4:13">जेमा सबले बढ़िया फर,</para>
  <para style="q2" vid="SNG 4:13">मेंहदी अऊ गुलमेंहदी,<verse eid="SNG 4:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 4:14"/>गुलमेंहदी अऊ केसर,</para>
  <para style="q2" vid="SNG 4:14">तेजपान अऊ दालचीनी,</para>
  <para style="q2" vid="SNG 4:14">खुसबूवाला जम्मो किसम के रूख,</para>
  <para style="q2" vid="SNG 4:14">लोहबान अऊ मुसब्बर</para>
  <para style="q2" vid="SNG 4:14">अऊ जम्मो किसम के बढ़िया मसाला के रूख हवंय।<verse eid="SNG 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 4:15"/>तेंह फव्वारा के बारी अस,</para>
  <para style="q2" vid="SNG 4:15">तेंह बहत पानी के कुआं</para>
  <para style="q2" vid="SNG 4:15">अऊ लबानोन ले बोहावत पानी के धार अस।<verse eid="SNG 4:15"/></para>
  <para style="sp">दुलहिन</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 4:16"/>हे उत्तर कोति के पवन, जाग,</para>
  <para style="q2" vid="SNG 4:16">अऊ हे दक्खिन कोति के पवन, आ!</para>
  <para style="q1" vid="SNG 4:16">मोर बारी म बह</para>
  <para style="q2" vid="SNG 4:16">ताकि येकर खुसबू ह हर जगह बगरय।</para>
  <para style="q1" vid="SNG 4:16">मोर मयारू ह ओकर बारी म आवय</para>
  <para style="q2" vid="SNG 4:16">अऊ येकर मनचाहे फरमन ला खावय।<verse eid="SNG 4:16"/></para>
  <chapter eid="SNG 4"/>
  <chapter number="5" style="c" sid="SNG 5"/>
  <para style="sp">दूल्हा</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 5:1"/>हे मोर बहिनी, मोर दुलहिन, मेंह अपन बारी म आ गे हंव;</para>
  <para style="q2" vid="SNG 5:1">मेंह अपन लोहबान ला अपन मसाला संग संकेल ले हंव।</para>
  <para style="q1" vid="SNG 5:1">मेंह मंधरस सहित अपन मधु-छत्ता ला खा ले हंव;</para>
  <para style="q2" vid="SNG 5:1">मेंह अपन अंगूर के मंद अऊ दूध पी ले हंव।</para>
  <para style="sp" vid="SNG 5:1">सहेलीमन</para>
  <para style="q1" vid="SNG 5:1">हे सहेलीमन खावव अऊ पीयव;</para>
  <para style="q2" vid="SNG 5:1">अपन बड़े मया से पीयव।<verse eid="SNG 5:1"/></para>
  <para style="s1">दुलहिन</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 5:2"/>में तो सुते रहेंव, पर मोर मन ह जागत रिहिस।</para>
  <para style="q2" vid="SNG 5:2">सुन! मोर मयारू ह कपाट ला खटखटावत हे अऊ कहत हे,</para>
  <para style="q1" vid="SNG 5:2">“हे मोर बहिनी, मोर मयारू,</para>
  <para style="q2" vid="SNG 5:2">मोर पंड़की, मोर उत्तम जन! मोर बर कपाट ला खोल।</para>
  <para style="q1" vid="SNG 5:2">मोर मुड़ ह ओस म,</para>
  <para style="q2" vid="SNG 5:2">अऊ मोर चुंदी ह रथिया के नमी म भीग गे हवय।”<verse eid="SNG 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 5:3"/>मेंह अपन ओनहा ला उतार चुके हंव—</para>
  <para style="q2" vid="SNG 5:3">का ओला फेर पहिर लंव?</para>
  <para style="q1" vid="SNG 5:3">मेंह अपन गोड़ ला धो डारे हंव—</para>
  <para style="q2" vid="SNG 5:3">का ओला फेर मईला करंव?<verse eid="SNG 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 5:4"/>मोर मयारू ह अपन हांथ ले कपाट के सिटकिनी ला धक्का देवथे;</para>
  <para style="q2" vid="SNG 5:4">मोर हिरदय ह ओकर मया बर छलकत हे।<verse eid="SNG 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 5:5"/>मेंह अपन मयारू बर कपाट ला खोले बर उठेंव,</para>
  <para style="q2" vid="SNG 5:5">अऊ मोर हांथ ले लोहबान चूहत रिहिस,</para>
  <para style="q1" vid="SNG 5:5">मोर अंगठीमन ले लोहबान ह</para>
  <para style="q2" vid="SNG 5:5">बेड़ी के मुठ म बह गीस।<verse eid="SNG 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 5:6"/>मेंह अपन मयारू बर कपाट ला खोलेंव,</para>
  <para style="q2" vid="SNG 5:6">पर मोर मयारू ह वापिस चल देय रिहिस; ओह चले गीस।</para>
  <para style="q2" vid="SNG 5:6">ओकर जाय ले मोर मन ह बियाकुल होईस।</para>
  <para style="q1" vid="SNG 5:6">मेंह ओला खोजेंव, पर नइं पायेंव।</para>
  <para style="q2" vid="SNG 5:6">मेंह ओला बलाएंव, पर ओह जबाब नइं दीस।<verse eid="SNG 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 5:7"/>जब पहरेदारमन सहर म पहरा देवत रिहिन,</para>
  <para style="q2" vid="SNG 5:7">त ओमन मोला भेंटिन।</para>
  <para style="q1" vid="SNG 5:7">ओमन मोला मारिन अऊ मोला घायल कर दीन;</para>
  <para style="q2" vid="SNG 5:7">ओ सहर के दीवारमन के पहरेदारमन,</para>
  <para style="q2" vid="SNG 5:7">मोर ओढ़ना ला लूटके ले गीन।<verse eid="SNG 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 5:8"/>हे यरूसलेम के बेटीमन, तुमन मोर ले वायदा करव—</para>
  <para style="q2" vid="SNG 5:8">कहूं तुमन ला मोर मयारू ह मिल जावय,</para>
  <para style="q1" vid="SNG 5:8">त तुमन ओला बताहू</para>
  <para style="q2" vid="SNG 5:8">कि मोला मया के रोग हो गे हवय।<verse eid="SNG 5:8"/></para>
  <para style="s1">सहेलीमन</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 5:9"/>हे माईलोगन म परम सुन्दरी,</para>
  <para style="q2" vid="SNG 5:9">तोर मयारू ह आने मन ले कोन बात म उत्तम हवय?</para>
  <para style="q1" vid="SNG 5:9">तोर मयारू ह कोन बात म आने मन ले बने अय,</para>
  <para style="q2" vid="SNG 5:9">कि तेंह हमन ला अइसने वायदा करवात हस?<verse eid="SNG 5:9"/></para>
  <para style="sp">दुलहिन</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 5:10"/>मोर मयारू ह हंसमुख अऊ चमकीला ए,</para>
  <para style="q2" vid="SNG 5:10">ओह दस हजार मनखे म उत्तम अय।<verse eid="SNG 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 5:11"/>ओकर मुड़ ह सुध सोन के सहीं अय;</para>
  <para style="q2" vid="SNG 5:11">ओकर चुंदी ह लहर सहीं</para>
  <para style="q2" vid="SNG 5:11">अऊ कऊआ सहीं करिया हवय।<verse eid="SNG 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 5:12"/>ओकर आंखीमन पंड़कीमन सहीं अंय</para>
  <para style="q2" vid="SNG 5:12">जऊन मन बोहावत पानी के तीर म,</para>
  <para style="q1" vid="SNG 5:12">दूध म धोवाके,</para>
  <para style="q2" vid="SNG 5:12">माला म पीरोय जेवर सहीं कतार म हवंय।<verse eid="SNG 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 5:13"/>ओकर गालमन खुसबू देवत</para>
  <para style="q2" vid="SNG 5:13">मसाला के दसना सहीं अंय।</para>
  <para style="q1" vid="SNG 5:13">ओकर ओंठ ह कुमुदिनी फूल सहीं अय</para>
  <para style="q2" vid="SNG 5:13">जेमा ले लोहबान चूहत रहिथे।<verse eid="SNG 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 5:14"/>ओकर बाहांमन पुखराज ले सजे</para>
  <para style="q2" vid="SNG 5:14">सोन के छड़ सहीं अंय।</para>
  <para style="q1" vid="SNG 5:14">ओकर देहें ह नीलमनि ले सजे</para>
  <para style="q2" vid="SNG 5:14">चमकत हाथी-दांत सहीं अय।<verse eid="SNG 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 5:15"/>ओकर गोड़मन सुध सोन के नीव म बईठाय</para>
  <para style="q2" vid="SNG 5:15">संगमरमर के खंभामन सहीं अंय।</para>
  <para style="q1" vid="SNG 5:15">ओकर रूप ह लबानोन के सहीं हवय,</para>
  <para style="q2" vid="SNG 5:15">अऊ देवदार के सहीं मनोहर हवय।<verse eid="SNG 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 5:16"/>ओकर मुहूं<note caller="+" style="f"><char style="fr" closed="false">5:16 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">गोठ</char></note> के अपन मिठास हवय;</para>
  <para style="q2" vid="SNG 5:16">ओह हर किसम ले मयारू ए।</para>
  <para style="q1" vid="SNG 5:16">हे यरूसलेम के बेटीमन,</para>
  <para style="q2" vid="SNG 5:16">येह मोर मयारू ए अऊ येह मोर संगी अय।<verse eid="SNG 5:16"/></para>
  <chapter eid="SNG 5"/>
  <chapter number="6" style="c" sid="SNG 6"/>
  <para style="sp">सहेलीमन</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 6:1"/>हे माईलोगन म परम सुन्दरी,</para>
  <para style="q2" vid="SNG 6:1">तोर मयारू ह कहां चल दीस?</para>
  <para style="q1" vid="SNG 6:1">तोर मयारू ह कते अंग चल दीस,</para>
  <para style="q2" vid="SNG 6:1">बता कि हमन घलो तोर संग ओला खोजन?<verse eid="SNG 6:1"/></para>
  <para style="sp">दुलहिन</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 6:2"/>मोर मयारू ह खाल्हे अपन बारी कोति गे हवय</para>
  <para style="q2" vid="SNG 6:2">जिहां मसाला के पऊधामन के क्यारी हवय,</para>
  <para style="q1" vid="SNG 6:2">ओह बारी म भेड़-बकरी चराय बर</para>
  <para style="q2" vid="SNG 6:2">अऊ कुमुदिनी फूल बटोरे बर गे हवय।<verse eid="SNG 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 6:3"/>मेंह अपन मयारू के अंव अऊ मोर मयारू ह मोर अय;</para>
  <para style="q2" vid="SNG 6:3">ओह भेड़-बकरी ला कुमुदिनी फूलमन के बीच म चराथे।<verse eid="SNG 6:3"/></para>
  <para style="sp">दूल्हा</para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 6:4"/>हे मोर मयारू, तें तिरसा<note caller="+" style="f"><char style="fr" closed="false">6:4 </char><char style="ft" closed="false">तिरसा ह उत्तरी इसरायल के पहिले के राजधानी रिहिस; देखव <char style="xt"><ref loc="1KI 14:17">1 राजा 14:17</ref> अऊ <ref loc="1KI 15:33">15:33</ref></char></char></note> के सहीं सुघर,</para>
  <para style="q2" vid="SNG 6:4">यरूसलेम के सहीं मनभावन,</para>
  <para style="q2" vid="SNG 6:4">अऊ धजा फहरावत सेना सहीं सानदार हस।<verse eid="SNG 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 6:5"/>अपन नजर ला मोर कोति ले हटा ले;</para>
  <para style="q2" vid="SNG 6:5">काबरकि ओमन मोला अभिभूत कर देथें।</para>
  <para style="q1" vid="SNG 6:5">तोर चुंदी ह गिलाद पहाड़ ले उतरत</para>
  <para style="q2" vid="SNG 6:5">छेरीमन के बरदी सहीं अय।<verse eid="SNG 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 6:6"/>तोर दांतमन नहा-खोरके ऊपर आवत</para>
  <para style="q2" vid="SNG 6:6">भेड़मन के बरदी सहीं अंय,</para>
  <para style="q1" vid="SNG 6:6">जेमा ले हर एक के जुड़वां हवय,</para>
  <para style="q2" vid="SNG 6:6">अऊ ओमा के कोनो नइं गंवाय हवय।<verse eid="SNG 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 6:7"/>तोर घूंघट के भीतर तोर कनपटी ह</para>
  <para style="q2" vid="SNG 6:7">अनार के आधा फर के सहीं अय।<verse eid="SNG 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 6:8"/>उहां साठ झन रानी,</para>
  <para style="q2" vid="SNG 6:8">अऊ अस्सी झन रखैल,</para>
  <para style="q2" vid="SNG 6:8">अऊ अब्बड़ अकन कुंवारी नोनीमन हो सकथें;<verse eid="SNG 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 6:9"/>पर मोर पंड़की, मोर सिद्ध जन ह तो अनोखा अय,</para>
  <para style="q2" vid="SNG 6:9">ओह तो अपन दाई के एकलऊती बेटी अय,</para>
  <para style="q2" vid="SNG 6:9">अऊ अपन जनम देवइया दाई के दुलारी अय।</para>
  <para style="q1" vid="SNG 6:9">जवान माईलोगनमन ओला देखिन अऊ ओला धइन कहिन;</para>
  <para style="q2" vid="SNG 6:9">रानीमन अऊ रखैलमन ओकर बड़ई करिन।<verse eid="SNG 6:9"/></para>
  <para style="sp">सहेलीमन</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 6:10"/>येह कोन ए, जेकर सोभा बिहान पाय के सोभा सहीं हवय,</para>
  <para style="q2" vid="SNG 6:10">चंदा के सहीं साफ-सुघर, सूरज के सहीं चमकीला,</para>
  <para style="q2" vid="SNG 6:10">अऊ धजा धरे सेनामन सहीं सोभायमान हवय?<verse eid="SNG 6:10"/></para>
  <para style="sp">दुलहिन</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 6:11"/>मेंह अखरोट के बारी म गेंव</para>
  <para style="q2" vid="SNG 6:11">कि घाटी म नवां बढ़त रूख-रई ला देखंव,</para>
  <para style="q1" vid="SNG 6:11">अऊ देखंव कि अंगूर के नारमन म पीका आवत हे कि नइं</para>
  <para style="q2" vid="SNG 6:11">या अनार के रूख म फूल फूलत हे कि नइं।<verse eid="SNG 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 6:12"/>एकर पहिली कि में ये बात ला समझतेंव,</para>
  <para style="q2" vid="SNG 6:12">मोर मन ह मोला मोर मनखेमन के राजसी रथमन म लगा दीस।<verse eid="SNG 6:12"/></para>
  <para style="sp">सहेलीमन</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 6:13"/>लहुंट आ, लहुंट आ, हे सुलाम के माईलोगन;</para>
  <para style="q2" vid="SNG 6:13">लहुंट आ, लहुंट आ, कि हमन तोला एकटक देखन!</para>
  <para style="sp" vid="SNG 6:13">दूल्हा</para>
  <para style="q1" vid="SNG 6:13">दू ठन दलमन<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">महनैम, देखव <char style="xt"><ref loc="GEN 32:2">उत 32:2</ref></char></char></note> के नाचा ला देखे सहीं,</para>
  <para style="q2" vid="SNG 6:13">तुमन सुलाम के माईलोगन ला एकटक काबर देखहू?<verse eid="SNG 6:13"/></para>
  <para style="b"/>
  <chapter eid="SNG 6"/>
  <chapter number="7" style="c" sid="SNG 7"/>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 7:1"/>हे राजकुमारी, कतेक सुघर लगत हें,</para>
  <para style="q2" vid="SNG 7:1">पनही पहिरे तोर पांवमन!</para>
  <para style="q1" vid="SNG 7:1">तोर सुघर गोड़मन अइसे जेवर के सहीं अंय,</para>
  <para style="q2" vid="SNG 7:1">जऊन ला कोनो कारीगर ह अपन हांथ ले बनाय हवय।<verse eid="SNG 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 7:2"/>तोर पेट के बोर्री ह गोल कटोरा के सहीं अय,</para>
  <para style="q2" vid="SNG 7:2">जेमा मसाला मिले मंद के कमी कभू नइं होवय;</para>
  <para style="q1" vid="SNG 7:2">तोर पेट ह गहूं के कुढ़ा के सहीं अय,</para>
  <para style="q2" vid="SNG 7:2">जऊन ह चारों कोति कुमुदिनी फूल ले सजे हवय।<verse eid="SNG 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 7:3"/>तोर दूनों स्तन हिरन के दू ठन पीलामन के सहीं अंय,</para>
  <para style="q2" vid="SNG 7:3">हिरन के दू ठन जुड़वां पीला सहीं।<verse eid="SNG 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 7:4"/>तोर घेंच ह हाथी-दांत के मीनार के सहीं अय।</para>
  <para style="q1" vid="SNG 7:4">तोर आंखी ह हेसबोन<note caller="+" style="f"><char style="fr" closed="false">7:4 </char><char style="fq" closed="false">हेसबोन </char><char style="ft" closed="false">ह यरदन घाटी के पूरब कोति मोआब देस म एक सहर अय</char></note> के ओ कुंड के सहीं अय</para>
  <para style="q2" vid="SNG 7:4">जऊन ह बेथ-रब्बीम के कपाट के लकठा म हवय।</para>
  <para style="q1" vid="SNG 7:4">तोर नाक ह लबानोन के ओ मीनार के सहीं अय</para>
  <para style="q2" vid="SNG 7:4">जेकर मुंहटा ह दमिस्क कोति हवय।<verse eid="SNG 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 7:5"/>तोर मुड़ ह करमेल पहाड़ के सहीं तोला सोभा देवत हे।</para>
  <para style="q2" vid="SNG 7:5">तोर मुड़ के घुंघराली चुंदी ह राजसी कपड़ा के सूंत सहीं हवय;</para>
  <para style="q2" vid="SNG 7:5">राजा तो तोर बेनीमन म मोहा गे हवय।<verse eid="SNG 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 7:6"/>हे मोर मयारू, तेंह कतेक सुघर</para>
  <para style="q2" vid="SNG 7:6">अऊ अपन खुसी के संग कतेक मनमोहनी अस!<verse eid="SNG 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 7:7"/>तोर डीलडौल ह खजूर के रूख के सही अय,</para>
  <para style="q2" vid="SNG 7:7">अऊ तोर स्तन ह खजूर के झोंथामन सहीं अय।<verse eid="SNG 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 7:8"/>मेंह कहेंव, “में खजूर के रूख म चघहूं;</para>
  <para style="q2" vid="SNG 7:8">मेंह ओकर फर ला धर लूहूं।”</para>
  <para style="q1" vid="SNG 7:8">तोर स्तन ह अंगूर के झोंथामन सहीं होवय,</para>
  <para style="q2" vid="SNG 7:8">तोर सांस के महक ह सेव फर के सहीं होवय,<verse eid="SNG 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 7:9"/>अऊ तोर मुहूं ह खांटी अंगूर के मंद सहीं होवय।</para>
  <para style="s1" vid="SNG 7:9">दुलहिन</para>
  <para style="q2" vid="SNG 7:9">अंगूर के मंद ह सीधा जाके</para>
  <para style="q2" vid="SNG 7:9">मोर मयारू के ओंठ अऊ दांत ऊपर धीरे-धीरे बोहावय।<verse eid="SNG 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 7:10"/>मेंह अपन मयारू के अंव,</para>
  <para style="q2" vid="SNG 7:10">अऊ ओह मोर लालसा करत रहिथे।<verse eid="SNG 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 7:11"/>हे मोर मयारू, आ, हमन गांव के खेत कोति जावन,</para>
  <para style="q2" vid="SNG 7:11">आ, गांव म हमन अपन रात बितावन।<verse eid="SNG 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 7:12"/>आ, हमन बिहनियां उठके अंगूर के बारी म जावन</para>
  <para style="q2" vid="SNG 7:12">अऊ ये देखन कि अंगूर के नार म फूल धरत हे कि नइं,</para>
  <para style="q1" vid="SNG 7:12">ओमन के कलीमन खिलत हें कि नइं,</para>
  <para style="q2" vid="SNG 7:12">अऊ अनार फूल खिलत हें कि नइं—</para>
  <para style="q2" vid="SNG 7:12">उहां मेंह तोला अपन मया दूहूं।<verse eid="SNG 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 7:13"/>दूदा फर<note caller="+" style="f"><char style="fr" closed="false">7:13 </char><char style="ft" closed="false">अइसे बिसवास करे जाथे कि ये फर ला खाय ले सारीरिक संबंध अऊ जननसक्ति बढ़थे; <char style="xt"><ref loc="GEN 30:14-16">उत 30:14‑16</ref></char></char></note> ह अपन खुसबू बगरावत हे,</para>
  <para style="q2" vid="SNG 7:13">अऊ हमर मुंहटामन म जम्मो किसम के उत्तम फर हवंय,</para>
  <para style="q1" vid="SNG 7:13">नवां अऊ जुन्ना दूनों,</para>
  <para style="q2" vid="SNG 7:13">हे मोर मयारू, मेंह येला तोर बर कुढ़ोके रखे हंव।<verse eid="SNG 7:13"/></para>
  <para style="b"/>
  <chapter eid="SNG 7"/>
  <chapter number="8" style="c" sid="SNG 8"/>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 8:1"/>कास, तेंह मोर भाई के सहीं होते,</para>
  <para style="q2" vid="SNG 8:1">जऊन ह मोर दाई के छाती ले दूध पीये रिहिस।</para>
  <para style="q1" vid="SNG 8:1">तब, कहूं मेंह तोला बाहिर म भेंटतेंव,</para>
  <para style="q2" vid="SNG 8:1">त में तोला चूमतेंव,</para>
  <para style="q2" vid="SNG 8:1">अऊ कोनो मोला तुछ नइं समझतिन।<verse eid="SNG 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 8:2"/>मेंह तोला डहार देखातेंव</para>
  <para style="q2" vid="SNG 8:2">अऊ तोला अपन दाई के घर म ले आतेंव—</para>
  <para style="q2" vid="SNG 8:2">जऊन ह मोला सिखोय हवय।</para>
  <para style="q1" vid="SNG 8:2">मेंह तोला पीये बर मसाला मिले अंगूर के मंद देतेंव,</para>
  <para style="q2" vid="SNG 8:2">अऊ अपन अनार के रस घलो देतेंव।<verse eid="SNG 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 8:3"/>ओकर डेरी हांथ मोर मुड़ के तरी म हवय</para>
  <para style="q2" vid="SNG 8:3">अऊ ओकर जेवनी हांथ ह मोला पोटारथे।<verse eid="SNG 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 8:4"/>हे यरूसलेम के बेटीमन, मेंह तुमन ला किरिया खवाके कहत हंव:</para>
  <para style="q2" vid="SNG 8:4">जब तक मया ह खुदे नइं जाग उठय,</para>
  <para style="q2" vid="SNG 8:4">तब तक तुमन ओला झन भड़कावव या जगावव।<verse eid="SNG 8:4"/></para>
  <para style="s1">सहेलीमन</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 8:5"/>येह कोन ए जऊन ह अपन मयारू ऊपर मुड़ टेके</para>
  <para style="q2" vid="SNG 8:5">सुनसान जगह ले चले आवत हे?</para>
  <para style="sp" vid="SNG 8:5">दुलहिन</para>
  <para style="q1" vid="SNG 8:5">सेव रूख के तरी म मेंह तोला जगांय;</para>
  <para style="q2" vid="SNG 8:5">उहां तोर दाई ह तोला गरभ म धरिस,</para>
  <para style="q2" vid="SNG 8:5">उहां ओह पीरा सहके तोला जनम दीस।<verse eid="SNG 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 8:6"/>तें मोला मुहर के सहीं अपन हिरदय म लगा ले,</para>
  <para style="q2" vid="SNG 8:6">अऊ मुहर के सहीं अपन बाहां म लगा ले;</para>
  <para style="q1" vid="SNG 8:6">काबरकि मया ह मिरतू के सहीं बलवान ए,</para>
  <para style="q2" vid="SNG 8:6">येकर जलन ह कबर के सहीं निरदयी अय।</para>
  <para style="q1" vid="SNG 8:6">येह धधकत आगी सहीं बरथे,</para>
  <para style="q2" vid="SNG 8:6">येह एक बड़े जुवाला सहीं बरथे।<verse eid="SNG 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 8:7"/>पानी के बाढ़ ह घलो मया ला नइं बुता सकय;</para>
  <para style="q2" vid="SNG 8:7">नदीमन येला बहाके नइं ले जा सकंय।</para>
  <para style="q1" vid="SNG 8:7">यदि कोनो अपन घर के जम्मो संपत्ति ला</para>
  <para style="q2" vid="SNG 8:7">मया के बदला म दे देवय,</para>
  <para style="q2" vid="SNG 8:7">तभो ले ओ संपत्ति ला बहुंत तुछ समझे जाही।<verse eid="SNG 8:7"/></para>
  <para style="sp">सहेलीमन</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 8:8"/>हमर एक छोटे बहिनी हवय,</para>
  <para style="q2" vid="SNG 8:8">ओकर छाती ह अभी नइं बढ़े हवय।</para>
  <para style="q1" vid="SNG 8:8">जऊन दिन हमर बहिनी के बारे म गोठियाय जाही,</para>
  <para style="q2" vid="SNG 8:8">ओ दिन हमन ओकर बर का करबो?<verse eid="SNG 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 8:9"/>कहूं ओह दीवार होतिस,</para>
  <para style="q2" vid="SNG 8:9">त हमन ओकर ऊपर चांदी के मीनार बनातेंन।</para>
  <para style="q1" vid="SNG 8:9">कहूं ओह कपाट होतिस,</para>
  <para style="q2" vid="SNG 8:9">त हमन देवदार रूख के पल्ला ले ओला बंद करतेंन।<verse eid="SNG 8:9"/></para>
  <para style="s1">दुलहिन</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 8:10"/>मेंह एक दीवार अंव,</para>
  <para style="q2" vid="SNG 8:10">अऊ मोर छातीमन मीनार के सहीं अंय।</para>
  <para style="q1" vid="SNG 8:10">ये किसम ले मेंह ओकर आंखी म</para>
  <para style="q2" vid="SNG 8:10">संतोस देवई सहीं हो गे हंव।<verse eid="SNG 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 8:11"/>बाल-हामोन म सुलेमान के एक ठन अंगूर के बारी रिहिस;</para>
  <para style="q2" vid="SNG 8:11">ओह अपन अंगूर के बारी ला किरायादारमन ला दे दीस।</para>
  <para style="q1" vid="SNG 8:11">ये ठहिराय गीस कि हर किरायादार ह फर के बदले</para>
  <para style="q2" vid="SNG 8:11">चांदी के एक हजार सेकेल<note caller="+" style="f"><char style="fr" closed="false">8:11 </char><char style="ft" closed="false">लगभग 12 किलोग्राम; <char style="xt" link-href="SNG 8:12"><ref loc="SNG 8:12">पद 12</ref></char> म घलो; एक सेकेल याने कि एक दिन के बनी</char></note> दीही।<verse eid="SNG 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 8:12"/>पर मोर खुद के अंगूर के बारी ह तो मोर अय अऊ मेंह येला कोनो ला भी दे सकत हंव;</para>
  <para style="q2" vid="SNG 8:12">हे सुलेमान, एक हजार सेकेल तो तोर बर अय,</para>
  <para style="q2" vid="SNG 8:12">अऊ दू सौ सेकेल ओमन बर अय, जऊन मन येकर फर के देखरेख करथें।<verse eid="SNG 8:12"/></para>
  <para style="sp">दूल्हा</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 8:13"/>तें जो बारीमन म,</para>
  <para style="q2" vid="SNG 8:13">अपन सहेलीमन संग रहिथस,</para>
  <para style="q2" vid="SNG 8:13">मोला तोर अवाज सुनन दे!<verse eid="SNG 8:13"/></para>
  <para style="sp">दुलहिन</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 8:14"/>हे मोर मयारू, जल्दी आ,</para>
  <para style="q2" vid="SNG 8:14">अऊ छोटे सुघर हिरन सहीं हो जा</para>
  <para style="q1" vid="SNG 8:14">या मसाला ले भरे पहाड़मन ऊपर</para>
  <para style="q2" vid="SNG 8:14">जवान बारासींगा सहीं हो जा।<verse eid="SNG 8:14"/></para>
  <chapter eid="SNG 8"/>
</usx>
