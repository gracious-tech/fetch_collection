<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HOS" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  <para style="h">होसे</para>
  <para style="toc1">होसे के किताब</para>
  <para style="toc2">होसे</para>
  <para style="toc3">होसे</para>
  <para style="mt1">होसे</para>
  <para style="mt2">के किताब</para>
  <chapter number="1" style="c" sid="HOS 1"/>
  <para style="p">
    <verse number="1" style="v" sid="HOS 1:1"/>यहूदा के राजा उजियाह, योताम, आहाज, अऊ हिजकियाह के सासन के समय, अऊ इसरायल के राजा यहोआस के बेटा यरोबाम के सासन के समय, यहोवा के बचन बेरी के बेटा होसे करा आईस।<verse eid="HOS 1:1"/></para>
  <para style="b"/>
  <para style="s1">होसे के घरवाली अऊ लइकामन</para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 1:2"/>जब यहोवा ह होसे के जरिये गोठियाय के सुरू करिस, त ओह होसे ले कहिस, “जाके एक बेस्या ले बिहाव कर ले, अऊ ओकर ले लइका जनमा, काबरकि एक बेभिचारी घरवाली के सहीं ये देस ह यहोवा ले बिसवासघात करके अपराधी हो गे हवय।” <verse eid="HOS 1:2"/><verse number="3" style="v" sid="HOS 1:3"/>एकरसेति होसे ह जाके दिबलैम के बेटी गोमेर ले बिहाव कर लीस, अऊ ओह होसे कोति ले देहें म होईस अऊ ओह एक बेटा जनमिस।<verse eid="HOS 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 1:4"/>तब यहोवा ह होसे ले कहिस, “ओकर नांव यिजरेल रख, काबरकि बहुंत जल्दी, मेंह येहू के घराना ला यिजरेल म करे गे मारकाट बर दंड दूहूं, अऊ मेंह इसरायल राज के अन्त कर दूहूं। <verse eid="HOS 1:4"/><verse number="5" style="v" sid="HOS 1:5"/>ओ दिन मेंह यिजरेल के घाटी म इसरायल के धनुस ला टोरहूं।”<verse eid="HOS 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HOS 1:6"/>गोमेर ह फेर देहें म होईस अऊ एक बेटी ला जनम दीस। तब यहोवा ह होसे ले कहिस, “ओकर नांव लो-रूहामा<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="fq" closed="false">लो-रूहामा </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">मयारू नो हय</char></note> रख, काबरकि मेंह अब इसरायल के घराना ला मया नइं देखावंव, अऊ ओमन ला कोनो किसम ले छेमा नइं करंव। <verse eid="HOS 1:6"/><verse number="7" style="v" sid="HOS 1:7"/>पर मेंह यहूदा के घराना ला मया देखाहूं; अऊ ओमन ला बचाहूं—ये बचाव न तो धनुस, तलवार या लड़ई के दुवारा, या घोड़ामन अऊ घुड़सवारमन के दुवारा होही, पर में, यहोवा ओमन के परमेसर ओमन ला बचाहूं।”<verse eid="HOS 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HOS 1:8"/>जब गोमेर ह लो-रूहामा के दूध ला छुड़ाईस, तब ओह देहें म होके एक अऊ बेटा ला जनम दीस। <verse eid="HOS 1:8"/><verse number="9" style="v" sid="HOS 1:9"/>तब यहोवा ह कहिस, “एकर नांव लो-अम्मी<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="fq" closed="false">लो-अम्मी </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">मोर मनखे नो हंय</char></note> रख, काबरकि तुमन मोर मनखे नो हव, अऊ मेंह तुम्हर परमेसर नो हंव।<verse eid="HOS 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="HOS 1:10"/>“तभो ले इसरायलीमन के संखिया समुंदर तीर के बालू असन होही, जेमन ला नापे या गने नइं जा सकय। ओ ठऊर जिहां ओमन ला ये कहे गे रिहिस, ‘तुमन मोर मनखे नो हव, ओही जगह म, ओमन ला जीयत परमेसर के संतान कहे जाही।’ <verse eid="HOS 1:10"/><verse number="11" style="v" sid="HOS 1:11"/>यहूदी अऊ इसरायलीमन एक संग जूरहीं; ओमन इकट्ठा होके अपन बर एक अगुवा ठहिराहीं अऊ देस ले निकल आहीं, काबरकि यिजरेल के ओ दिन ह महान दिन होही।<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="HOS 1:10">1:10</ref>, <ref loc="HOS 1:11">11</ref></char> ला 2:1,2 गने गे हवय</char></note><verse eid="HOS 1:11"/></para>
  <chapter eid="HOS 1"/>
  <chapter number="2" style="c" sid="HOS 2"/>
  <para style="p">
    <note caller="+" style="f">
      <char style="fr" closed="false">2 </char>
      <char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="HOS 2:1-23">2:1‑23</ref></char> ला 2:3‑25 गने गे हवय</char>
    </note> <verse number="1" style="v" sid="HOS 2:1"/>“अपन भाईमन ले कहव, ‘मोर मनखे,’ अऊ अपन बहिनीमन ले कहव, ‘मोर मयारू।’<verse eid="HOS 2:1"/></para>
  <para style="s1">इसरायल के दंड अऊ पुनरस्थापना</para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 2:2"/>“अपन दाई ला दबकार, ओला दबकार,</para>
  <para style="q2" vid="HOS 2:2">काबरकि ओह मोर घरवाली नो हय,</para>
  <para style="q2" vid="HOS 2:2">अऊ मेंह ओकर घरवाला नो हंव।</para>
  <para style="q1" vid="HOS 2:2">ओह अपन चेहरा ले छिनारीपन</para>
  <para style="q2" vid="HOS 2:2">अऊ अपन छातीमन के बीच ले बिसवासघात ला हटा लेवय।<verse eid="HOS 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 2:3"/>नइं तो मेंह ओकर ओनहा ला उतारके अइसने नंगरी कर दूहूं</para>
  <para style="q2" vid="HOS 2:3">जइसने ओह अपन जनम के बेरा म रिहिस;</para>
  <para style="q1" vid="HOS 2:3">में ओला मरू-भुइयां असन बना दूहूं,</para>
  <para style="q2" vid="HOS 2:3">ओला सूखा भुइयां म बदल दूहूं</para>
  <para style="q2" vid="HOS 2:3">अऊ ओला पीयास ले मार डारहूं।<verse eid="HOS 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 2:4"/>ओकर लइकामन बर मेंह अपन मया नइं देखाहूं,</para>
  <para style="q2" vid="HOS 2:4">काबरकि ओमन बेभिचार ले जनमे लइका अंय।<verse eid="HOS 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 2:5"/>ओमन के दाई ह छिनारी करे हवय</para>
  <para style="q2" vid="HOS 2:5">अऊ ओह ओमन ला कलंक ले अपन गरभ म धारन करिस।</para>
  <para style="q1" vid="HOS 2:5">ओह कहिस, ‘मेंह अपन मया करइयामन के पाछू जाहूं,</para>
  <para style="q2" vid="HOS 2:5">जऊन मन मोला रोटी-पानी,</para>
  <para style="q2" vid="HOS 2:5">मोर ऊन अऊ सन के कपड़ा, मोर जैतून तेल अऊ मोर मंद देथें।’<verse eid="HOS 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 2:6"/>एकरसेति, मेंह ओकर रद्दा ला कंटिली झाड़ीमन ले घेर दूहूं,</para>
  <para style="q2" vid="HOS 2:6">मेंह ओकर आघू म बाड़ा ठाढ़ कर दूहूं ताकि ओला रसता झन मिलय।<verse eid="HOS 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 2:7"/>ओह अपन मया करइयामन के पीछा करही पर ओमन ला पकड़ नइं सकही;</para>
  <para style="q2" vid="HOS 2:7">ओह ओमन ला खोजही पर ओमन नइं मिलहीं।</para>
  <para style="q1" vid="HOS 2:7">तब ओह कहिही,</para>
  <para style="q2" vid="HOS 2:7">‘मेंह पहिले के सहीं अपन घरवाला करा लहुंट जाहूं,</para>
  <para style="q2" vid="HOS 2:7">काबरकि मोर तब के दसा ह अभी के दसा ले बने रिहिस।’<verse eid="HOS 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 2:8"/>ओह ये बात ला नइं माने हे कि ओह मेंहीच रहेंव</para>
  <para style="q2" vid="HOS 2:8">जऊन ह ओला अनाज, नवां अंगूर के मंद अऊ तेल दीस,</para>
  <para style="q1" vid="HOS 2:8">जऊन ह ओकर ऊपर खुले मन ले सोन अऊ चांदी लुटाईस—</para>
  <para style="q2" vid="HOS 2:8">जेकर उपयोग ओमन बाल देवता बर करिन।<verse eid="HOS 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 2:9"/>“एकरसेति मेंह अपन अनाज ला ले लूहूं जब ओह पाक जाही,</para>
  <para style="q2" vid="HOS 2:9">अऊ अपन नवां अंगूर के मंद ला ले लूहूं जब ओह तियार हो जाही।</para>
  <para style="q1" vid="HOS 2:9">मेंह अपन ऊन अऊ सन के कपड़ा ला वापिस ले लूहूं,</para>
  <para style="q2" vid="HOS 2:9">जऊन ला मेंह ओकर देहें ला ढांपे बर दे रहेंव।<verse eid="HOS 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 2:10"/>एकरसेति अब मेंह ओकर फूहड़पन ला</para>
  <para style="q2" vid="HOS 2:10">ओकर मया करइयामन के आघू म उघारहूं;</para>
  <para style="q2" vid="HOS 2:10">अऊ कोनो ओला मोर हांथ ले छोंड़ाय नइं सकहीं।<verse eid="HOS 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 2:11"/>मेंह ओकर जम्मो उत्सव मनई ला बंद कर दूहूं:</para>
  <para style="q2" vid="HOS 2:11">ओकर हर बछर के तिहार, ओकर नवां चंदा के उत्सव,</para>
  <para style="q2" vid="HOS 2:11">ओकर बिसराम दिनमन ला—ओकर जम्मो ठहिराय तिहारमन ला बंद कर दूहूं।<verse eid="HOS 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 2:12"/>मेंह ओकर अंगूर के नार अऊ ओकर अंजीर के रूखमन ला बरबाद कर दूहूं</para>
  <para style="q2" vid="HOS 2:12">जेकर बारे म ओह कहिथे कि येह मोर मया करइयामन के दुवारा दिये गे मजदूरी अय;</para>
  <para style="q1" vid="HOS 2:12">मेंह ओमन ला झाड़-झंखाड़ बना दूहूं,</para>
  <para style="q2" vid="HOS 2:12">अऊ जंगली पसुमन ओमन ला चर डारहीं।<verse eid="HOS 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 2:13"/>मेंह ओला ओ बातमन बर सजा दूहूं</para>
  <para style="q2" vid="HOS 2:13">कि ओह बाल देवतामन बर धूप जलाईस;</para>
  <para style="q1" vid="HOS 2:13">ओह अपनआप ला नथनी अऊ गहनामन ले सजाईस,</para>
  <para style="q2" vid="HOS 2:13">अऊ अपन मया करइयामन के पाछू गीस,</para>
  <para style="q2" vid="HOS 2:13">पर मोला ओह भुला गीस,” यहोवा ह घोसना करत हे।<verse eid="HOS 2:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 2:14"/>“एकरसेति, अब मेंह ओला ललचाहूं;</para>
  <para style="q2" vid="HOS 2:14">मेंह ओला सुनसान जगह म ले जाहूं</para>
  <para style="q2" vid="HOS 2:14">अऊ ओकर ले कोमल मन ले गोठियाहूं।<verse eid="HOS 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 2:15"/>उहां मेंह ओला ओकर अंगूर के बारीमन ला लहुंटा दूहूं,</para>
  <para style="q2" vid="HOS 2:15">अऊ आकोर<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="fq" closed="false">आकोर </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">समस्या</char></note> के घाटी ला आसा के दुवार बना दूहूं।</para>
  <para style="q1" vid="HOS 2:15">उहां ओह अइसने जबाब दीही, जइसने ओह अपन जवानी के दिन म देवत रिहिस,</para>
  <para style="q2" vid="HOS 2:15">याने कि जइसने ओह मिसर देस ले निकलके आय के बेरा देवत रिहिस।”<verse eid="HOS 2:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 2:16"/>यहोवा ह घोसना करत हे,</para>
  <para style="q2" vid="HOS 2:16">“ओ दिन, तेंह मोला ‘मोर घरवाला’ कहिबे;</para>
  <para style="q2" vid="HOS 2:16">तेंह मोला फेर कभू ‘अपन मालिक’ नइं कहिबे।<verse eid="HOS 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 2:17"/>मेंह ओकर मुहूं ले बाल देवतामन के नांव ला मिटा दूहूं;</para>
  <para style="q2" vid="HOS 2:17">ओमन के नांव फेर कभू नइं लिये जाही।<verse eid="HOS 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="HOS 2:18"/>ओ दिन मेंह ओमन बर</para>
  <para style="q2" vid="HOS 2:18">जंगली जानवर, अकास के चिरई</para>
  <para style="q2" vid="HOS 2:18">अऊ भुइयां म रेंगइया जन्तुमन के संग एक करार करहूं।</para>
  <para style="q1" vid="HOS 2:18">धनुस अऊ तलवार अऊ लड़ई ला</para>
  <para style="q2" vid="HOS 2:18">मेंह देस ले खतम कर दूहूं,</para>
  <para style="q2" vid="HOS 2:18">ताकि मनखेमन निडर होके अराम करंय।<verse eid="HOS 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="HOS 2:19"/>मेंह तोला हमेसा के खातिर बिहाव के बचन दूहूं;</para>
  <para style="q2" vid="HOS 2:19">मेंह तोला धरमीपन अऊ नियाय,</para>
  <para style="q2" vid="HOS 2:19">मया अऊ करूना के संग बिहाव के बचन दूहूं।<verse eid="HOS 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="HOS 2:20"/>में तोला सच्चई के संग बिहाव के बचन दूहूं,</para>
  <para style="q2" vid="HOS 2:20">अऊ तेंह यहोवा ला जान लेबे।”<verse eid="HOS 2:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="HOS 2:21"/>यहोवा ह घोसना करत हे—</para>
  <para style="q2" vid="HOS 2:21">“ओ दिन मेंह जबाब दूहूं,</para>
  <para style="q1" vid="HOS 2:21">मेंह अकास-मंडल ला जबाब दूहूं,</para>
  <para style="q2" vid="HOS 2:21">अऊ ओमन धरती ला जबाब दीहीं;<verse eid="HOS 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="HOS 2:22"/>अऊ धरती ह अनाज,</para>
  <para style="q2" vid="HOS 2:22">नवां अंगूर के मंद अऊ जैतून के तेल ला जबाब दीही,</para>
  <para style="q2" vid="HOS 2:22">अऊ ओमन यिजरेल<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="fq" closed="false">यिजरेल </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">परमेसर ह लगाथे</char></note> ला जबाब दीहीं।<verse eid="HOS 2:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="HOS 2:23"/>मेंह ओला अपन बर देस म लगाहूं;</para>
  <para style="q2" vid="HOS 2:23">मेंह ओकर ऊपर अपन मया देखाहूं, जऊन ला मेंह अपन मयारू नइं कहंव।</para>
  <para style="q1" vid="HOS 2:23">ओ मनखे जऊन मन मोर नइं कहे जावंय, ओमन ला मेंह कहिहूं, ‘तुमन मोर मनखे अव’;</para>
  <para style="q2" vid="HOS 2:23">अऊ ओमन कहिहीं, ‘तेंह हमर परमेसर अस।’ ”<verse eid="HOS 2:23"/></para>
  <chapter eid="HOS 2"/>
  <chapter number="3" style="c" sid="HOS 3"/>
  <para style="s1">होसे के अपन घरवाली के संग समझौता</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 3:1"/>यहोवा ह मोर ले कहिस, “जा अऊ अपन मया अपन घरवाली ला फेर देखा, हालाकि ओला कोनो अऊ मनखे ह मया करथे अऊ ओह एक छिनार अय। ओकर ले अइसन मया कर, जइसन यहोवा ह इसरायलीमन ले करथे, हालाकि इसरायलीमन आने देवतामन कोति जाके पबितर किसमिस के टिकियामन ले मया करथें।”<verse eid="HOS 3:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 3:2"/>एकरसेति मेंह ओला चांदी के पंदरह सेकेल<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">लगभग 170 ग्राम</char></note> अऊ लगभग एक होमेर अऊ एक लेथेक<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">एक होमेर अऊ एक लेथेक लगभग 195 किलोग्राम होथे</char></note> जौ देके बिसा लेंव। <verse eid="HOS 3:2"/><verse number="3" style="v" sid="HOS 3:3"/>तब मेंह ओला कहेंव, “तोला मोर संग बहुंत दिन तक रहना हे; तोला बेस्या नइं बनना हे या कोनो मनखे के संग सारीरिक संबंध नइं बनाना हे, अऊ मेंह घलो तोर संग अइसनेच बरताव करहूं।”<verse eid="HOS 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 3:4"/>काबरकि इसरायलीमन बहुंत दिन तक बिगर राजा या हाकिम, बिगर बलि या पबितर पथरा, बिगर एपोद या घर-देवता के रहिहीं। <verse eid="HOS 3:4"/><verse number="5" style="v" sid="HOS 3:5"/>ओकर बाद इसरायलीमन लहुंटहीं अऊ यहोवा, अपन परमेसर अऊ अपन राजा, दाऊद ला खोजहीं। ओमन आखिरी के दिनमन म कांपत यहोवा करा अऊ ओकर आसीस पाय बर आहीं।<verse eid="HOS 3:5"/></para>
  <chapter eid="HOS 3"/>
  <chapter number="4" style="c" sid="HOS 4"/>
  <para style="s1">इसरायल के ऊपर आरोप</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 4:1"/>हे इसरायलीमन, यहोवा के बचन ला सुनव,</para>
  <para style="q2" vid="HOS 4:1">काबरकि तुमन, जऊन मन ये देस म रहिथव</para>
  <para style="q2" vid="HOS 4:1">तुम्हर ऊपर यहोवा ह एक आरोप लगइया हवय:</para>
  <para style="q1" vid="HOS 4:1">ये देस के रहइयामन म परमेसर बर</para>
  <para style="q2" vid="HOS 4:1">न तो कुछू बिसवासयोग्यता, न कुछू मया अऊ न ही परमेसर ला माने के कुछू बात हवय।<verse eid="HOS 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 4:2"/>इहां सिरिप सराप देवई, लबारी बात, हतिया करई,</para>
  <para style="q2" vid="HOS 4:2">चोरी-चकारी अऊ बेभिचार हवय;</para>
  <para style="q1" vid="HOS 4:2">ओमन जम्मो कानून ला टोरथें,</para>
  <para style="q2" vid="HOS 4:2">अऊ खून के ऊपर खून करत रहिथें।<verse eid="HOS 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 4:3"/>एही कारन अय कि ये देस ह सूखा जाथे,</para>
  <para style="q2" vid="HOS 4:3">अऊ येमा जम्मो रहइयामन बेकार हो जाथें;</para>
  <para style="q1" vid="HOS 4:3">भुइयां के पसु, अकास के चिरई</para>
  <para style="q2" vid="HOS 4:3">अऊ समुंदर के मछरीमन नास हो जाथें।<verse eid="HOS 4:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 4:4"/>“पर कोनो मनखे दोस झन लगावय,</para>
  <para style="q2" vid="HOS 4:4">न ही कोनो मनखे आने ऊपर आरोप लगावय,</para>
  <para style="q1" vid="HOS 4:4">काबरकि तोर मनखेमन ओमन के सहीं अंय</para>
  <para style="q2" vid="HOS 4:4">जऊन मन पुरोहितमन ऊपर दोस लगाथें।<verse eid="HOS 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 4:5"/>तेंह रात-दिन ठोकर खाथस,</para>
  <para style="q2" vid="HOS 4:5">अऊ तोर संग अगमजानीमन घलो ठोकर खाथें।</para>
  <para style="q1" vid="HOS 4:5">एकरसेति मेंह तोर दाई ला नास कर दूहूं—<verse eid="HOS 4:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="HOS 4:6"/>मोर मनखेमन गियान के कमी के कारन नास होथें।</para>
  <para style="b" vid="HOS 4:6"/>
  <para style="q1" vid="HOS 4:6">“काबरकि तेंह गियान ला अस्वीकार करे हस,</para>
  <para style="q2" vid="HOS 4:6">एकरसेति मेंह घलो तोला अपन पुरोहित के रूप म अस्वीकार करत हंव;</para>
  <para style="q1" vid="HOS 4:6">काबरकि तेंह अपन परमेसर के कानून ऊपर धियान नइं दे हवस,</para>
  <para style="q2" vid="HOS 4:6">त मेंह घलो तोर लइकामन ऊपर धियान नइं दूहूं।<verse eid="HOS 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 4:7"/>जतेक जादा पुरोहित रिहिन,</para>
  <para style="q2" vid="HOS 4:7">ओतेक जादा ओमन मोर बिरूध म पाप करिन;</para>
  <para style="q2" vid="HOS 4:7">ओमन अपन महिमामय परमेसर के बदला म कलंकित चीज ला अपना लीन।<verse eid="HOS 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 4:8"/>पुरोहितमन मोर मनखेमन के पाप के कमई ला खाथें</para>
  <para style="q2" vid="HOS 4:8">अऊ ओमन मोर मनखेमन के दुस्टता के मजा लेथें।<verse eid="HOS 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 4:9"/>अऊ येह अइसने होही: जइसने मनखेमन के दसा, वइसने पुरोहितमन के दसा।</para>
  <para style="q2" vid="HOS 4:9">मेंह ओ दूनों ला ओमन के चालचलन के सजा दूहूं,</para>
  <para style="q2" vid="HOS 4:9">अऊ ओमन ला ओमन के काम के बदला दूहूं।<verse eid="HOS 4:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 4:10"/>“ओमन खाना तो खाहीं, पर ओमन करा परयाप्त खाना नइं होही;</para>
  <para style="q2" vid="HOS 4:10">ओमन बेस्यागमन करहीं, पर बाढ़हीं नइं,</para>
  <para style="q1" vid="HOS 4:10">काबरकि ओमन यहोवा ला छोंड़ दे हवंय<verse eid="HOS 4:10"/></para>
  <para style="q2">
    <verse number="11" style="v" sid="HOS 4:11"/>ताकि ओमन बेस्यागमन कर सकंय;</para>
  <para style="q1" vid="HOS 4:11">पुराना मंद अऊ नवां मंद</para>
  <para style="q2" vid="HOS 4:11">ओमन के समझ ला भ्रस्ट कर देथे।<verse eid="HOS 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 4:12"/>मोर मनखेमन कठवा के एक मूरती ले सलाह लेथें,</para>
  <para style="q2" vid="HOS 4:12">अऊ अगम बतइया के लउठी ओमन के अगम के बात ला बताथे।</para>
  <para style="q1" vid="HOS 4:12">बेभिचार के एक आतमा ह ओमन ला बहका देथे;</para>
  <para style="q2" vid="HOS 4:12">ओमन अपन परमेसर के संग बिसवासघात करथें।<verse eid="HOS 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 4:13"/>ओमन पहाड़ के टीप म बलिदान चघाथें</para>
  <para style="q2" vid="HOS 4:13">अऊ पहाड़ीमन ऊपर,</para>
  <para style="q1" vid="HOS 4:13">बलूत रूख, चिनार रूख अऊ एला रूखमन के खाल्हे म, जिहां बने छइहां होथे,</para>
  <para style="q2" vid="HOS 4:13">उहां होम-बलिदान चघाथें।</para>
  <para style="q1" vid="HOS 4:13">ये खातिर तुम्हर बेटीमन छिनारी करे बर जाथें</para>
  <para style="q2" vid="HOS 4:13">अऊ तुम्हर बहुमन बेभिचार करथें।<verse eid="HOS 4:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 4:14"/>“जब तुम्हर बेटीमन छिनारी करे बर जाहीं</para>
  <para style="q2" vid="HOS 4:14">त में ओमन ला सजा नइं दूहूं,</para>
  <para style="q1" vid="HOS 4:14">अऊ न ही तुम्हर बहुमन ला सजा दूहूं,</para>
  <para style="q2" vid="HOS 4:14">जब ओमन बेभिचार करहीं,</para>
  <para style="q1" vid="HOS 4:14">काबरकि आदमीमन खुद बेस्यामन के संग रहिथें</para>
  <para style="q2" vid="HOS 4:14">अऊ देवालय के बेस्यामन संग बलि चघाथें—</para>
  <para style="q2" vid="HOS 4:14">नासमझ मनखेमन नास हो जाहीं!<verse eid="HOS 4:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 4:15"/>“हे इसरायल, हालाकि तेंह बेभिचार करथस,</para>
  <para style="q2" vid="HOS 4:15">पर यहूदा ला दोसी झन होवन दे।</para>
  <para style="b" vid="HOS 4:15"/>
  <para style="q1" vid="HOS 4:15">“न तो गिलगाल जावव;</para>
  <para style="q2" vid="HOS 4:15">अऊ न ही ऊपर बेत-आवेन<note caller="+" style="f"><char style="fr" closed="false">4:15 </char><char style="fq" closed="false">बेत-आवेन </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">दुस्टता के घर; (बेतेल बर एक अपमानित नांव अऊ बेतेल के मतलब होथे </char><char style="fqa" closed="false">परमेसर के घर)</char></note> ला जावव।</para>
  <para style="q2" vid="HOS 4:15">अऊ न ही ये कसम खावव, ‘यहोवा के जिनगी के कसम।’<verse eid="HOS 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 4:16"/>इसरायलीमन जिद्दी बछरू</para>
  <para style="q2" vid="HOS 4:16">असन जिद्दी अंय।</para>
  <para style="q1" vid="HOS 4:16">तब यहोवा ह ओमन ला चरागन म</para>
  <para style="q2" vid="HOS 4:16">मेढ़ा-पीलामन सहीं कइसे चरा सकत हे?<verse eid="HOS 4:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 4:17"/>एपरैम ह मूरतीमन के संगवारी हो गे हवय;</para>
  <para style="q2" vid="HOS 4:17">ओला अकेला छोंड़ दव!<verse eid="HOS 4:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="HOS 4:18"/>अऊ त अऊ जब ओमन के मंद ह खतम हो जाथे,</para>
  <para style="q2" vid="HOS 4:18">तब घलो ओमन बेस्यागमन करत रहिथें;</para>
  <para style="q2" vid="HOS 4:18">ओमन के सासन करइयामन लज्जा के काम ले मया करथें।<verse eid="HOS 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="HOS 4:19"/>बवंडर ह ओमन ला उड़ाके ले जाही,</para>
  <para style="q2" vid="HOS 4:19">अऊ ओमन के बलिदानमन के खातिर ओमन ला सरमिंदा होना पड़ही।<verse eid="HOS 4:19"/></para>
  <chapter eid="HOS 4"/>
  <chapter number="5" style="c" sid="HOS 5"/>
  <para style="s1">इसरायल के बिरूध नियाय</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 5:1"/>“हे पुरोहितमन, ये बात ला सुनव!</para>
  <para style="q2" vid="HOS 5:1">हे इसरायलीमन, धियान देवव!</para>
  <para style="q1" vid="HOS 5:1">हे राज-घराना, सुनव!</para>
  <para style="q2" vid="HOS 5:1">ये नियाय ह तुम्हर बिरूध हवय:</para>
  <para style="q1" vid="HOS 5:1">तुमन मिसपा म एक फांदा बन गे हवव,</para>
  <para style="q2" vid="HOS 5:1">तुमन ताबोर पहाड़ म बिछाय एक जाल अव।<verse eid="HOS 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 5:2"/>बिदरोहीमन घोर हतिया करे हवंय।</para>
  <para style="q2" vid="HOS 5:2">में ओ जम्मो झन के ताड़ना करहूं।<verse eid="HOS 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 5:3"/>मेंह एपरैम के जम्मो बात ला जानत हंव;</para>
  <para style="q2" vid="HOS 5:3">इसरायल के बात मोर ले छिपे नइं ए।</para>
  <para style="q1" vid="HOS 5:3">हे एपरैम, तेंह अब बेस्यागमन म लग गे हवस;</para>
  <para style="q2" vid="HOS 5:3">इसरायल ह भ्रस्ट हो गे हवय।<verse eid="HOS 5:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 5:4"/>“ओमन के काम ओमन ला</para>
  <para style="q2" vid="HOS 5:4">ओमन के परमेसर कोति फिरन नइं देवय।</para>
  <para style="q1" vid="HOS 5:4">बेस्यागमन के आतमा ओमन के दिल म हवय;</para>
  <para style="q2" vid="HOS 5:4">ओमन यहोवा ला नइं मानंय।<verse eid="HOS 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 5:5"/>इसरायल के घमंड ह ओमन के बिरूध म गवाही देवत हे;</para>
  <para style="q2" vid="HOS 5:5">इसरायलीमन, अऊ त अऊ एपरैम घलो अपन पाप म लड़खड़ावत हवंय;</para>
  <para style="q2" vid="HOS 5:5">यहूदा घलो ओमन के संग लड़खड़ावत हे।<verse eid="HOS 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 5:6"/>जब ओमन अपन भेड़-बकरी अऊ गाय-बईलामन के झुंड ला लेके</para>
  <para style="q2" vid="HOS 5:6">यहोवा के खोज म जाथें,</para>
  <para style="q1" vid="HOS 5:6">त यहोवा ह ओमन ला नइं मिलय;</para>
  <para style="q2" vid="HOS 5:6">काबरकि ओह अपनआप ला ओमन ले अलग कर ले हवय।<verse eid="HOS 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 5:7"/>ओमन यहोवा के संग बिसवासघात करे हवंय;</para>
  <para style="q2" vid="HOS 5:7">ओमन अवैध लइका जनमाथें।</para>
  <para style="q1" vid="HOS 5:7">जब ओमन नवां चंदा के भोज के उत्सव मनाहीं,</para>
  <para style="q2" vid="HOS 5:7">त ओह ओमन के खेतमन ला नास कर दीही।<note caller="+" style="f"><char style="fr" closed="false">5:7 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">ओमन के नवां चंदा के भोज ह ओमन ला खा जाही</char></note><verse eid="HOS 5:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 5:8"/>“गिबा नगर म तुरही ला बजावव,</para>
  <para style="q2" vid="HOS 5:8">अऊ रामा नगर म नरसिंगा फूंकव।</para>
  <para style="q1" vid="HOS 5:8">बेत-आवेन नगर म लड़ई बर ऊंचहा अवाज म ललकारव;</para>
  <para style="q2" vid="HOS 5:8">हे बिनयामीन, हमर अगुवई कर।<verse eid="HOS 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 5:9"/>हिसाब करे के दिन</para>
  <para style="q2" vid="HOS 5:9">एपरैम ह उजड़ जाही।</para>
  <para style="q1" vid="HOS 5:9">इसरायल के गोत्रमन के बीच</para>
  <para style="q2" vid="HOS 5:9">मेंह ओही बात के घोसना करहूं, जेकर होना निस्चित ए।<verse eid="HOS 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 5:10"/>यहूदा के अगुवामन ओमन के जइसे अंय</para>
  <para style="q2" vid="HOS 5:10">जऊन मन सीमना के पथरामन ला हटाथें।</para>
  <para style="q1" vid="HOS 5:10">मोर कोरोध ह ओमन ऊपर</para>
  <para style="q2" vid="HOS 5:10">पानी के बाढ़ सहीं भड़कही।<verse eid="HOS 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 5:11"/>एपरैम ला सताय जाथे,</para>
  <para style="q2" vid="HOS 5:11">ओला नियाय म कुचरे गे हवय,</para>
  <para style="q2" vid="HOS 5:11">काबरकि ओह मूरतीमन के पाछू जाय बर ठान ले हवय।<verse eid="HOS 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 5:12"/>मेंह एपरैम बर एक कीरा के असन,</para>
  <para style="q2" vid="HOS 5:12">अऊ यहूदा के मनखेमन बर सड़ाहट के असन अंव।<verse eid="HOS 5:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 5:13"/>“जब एपरैम ह अपन रोग,</para>
  <para style="q2" vid="HOS 5:13">अऊ यहूदा ह अपन घाव ला देखिस,</para>
  <para style="q1" vid="HOS 5:13">तब एपरैम ह अस्सूर कोति गीस,</para>
  <para style="q2" vid="HOS 5:13">अऊ बड़े राजा ले मदद बर बिनती करिस।</para>
  <para style="q1" vid="HOS 5:13">पर ओह तुमन ला न तो चंगा कर सकथे,</para>
  <para style="q2" vid="HOS 5:13">अऊ न ही तुम्हर घावमन ला ठीक कर सकथे।<verse eid="HOS 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 5:14"/>काबरकि मेंह एपरैम बर एक सिंह,</para>
  <para style="q2" vid="HOS 5:14">अऊ यहूदा बर एक बड़े सिंह सहीं हो जाहूं।</para>
  <para style="q1" vid="HOS 5:14">मेंह ओमन ला चीरके कुटा-कुटा कर दूहूं अऊ चले जाहूं;</para>
  <para style="q2" vid="HOS 5:14">मेंह ओमन ला उठाके ले जाहूं, अऊ ओमन ला बचानेवाला कोनो नइं होहीं।<verse eid="HOS 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 5:15"/>जब तक ओमन अपन अपराध ला मान नइं लीहीं</para>
  <para style="q2" vid="HOS 5:15">अऊ मोर करा लहुंटके नइं आहीं</para>
  <para style="q2" vid="HOS 5:15">मेंह अपन ठऊर म नइं लहुंटहूं—</para>
  <para style="q1" vid="HOS 5:15">अपन दुरगति के बेरा</para>
  <para style="q2" vid="HOS 5:15">ओमन मन लगाके मोर खोज करहीं।”<verse eid="HOS 5:15"/></para>
  <chapter eid="HOS 5"/>
  <chapter number="6" style="c" sid="HOS 6"/>
  <para style="s1">पछताप नइं करइया इसरायल</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 6:1"/>“आवव, हमन यहोवा कोति लहुंटन।</para>
  <para style="q1" vid="HOS 6:1">ओह हमन ला चीरके कुटा-कुटा कर दे हवय</para>
  <para style="q2" vid="HOS 6:1">पर ओह हमन ला चंगा करही;</para>
  <para style="q1" vid="HOS 6:1">ओह हमन ला चोट पहुंचाय हवय</para>
  <para style="q2" vid="HOS 6:1">पर ओहीच ह हमर घावमन म मरहम पट्टी करही।<verse eid="HOS 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 6:2"/>दू दिन के बाद ओह हमन म सुधार लानही;</para>
  <para style="q2" vid="HOS 6:2">अऊ तीसर दिन ओह हमन ला पहिले सहीं कर दीही,</para>
  <para style="q2" vid="HOS 6:2">ताकि हमन ओकर आघू म बने रहन।<verse eid="HOS 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 6:3"/>आवव, हमन यहोवा ला मान लेवन;</para>
  <para style="q2" vid="HOS 6:3">आवव, हमन ओला जाने बर कोसिस करन।</para>
  <para style="q1" vid="HOS 6:3">जइसन कि सूरज के निकलई ह निस्चित अय,</para>
  <para style="q2" vid="HOS 6:3">वइसने ही ओह घलो निस्चय परगट होही;</para>
  <para style="q1" vid="HOS 6:3">ओह हमर करा ठंड के बरसात सहीं,</para>
  <para style="q2" vid="HOS 6:3">बसन्त रितु के ओ बरसात सहीं आही, जऊन ह धरती ला पलोथे।”<verse eid="HOS 6:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 6:4"/>“हे एपरैम, मेंह तोर बर का कर सकत हंव?</para>
  <para style="q2" vid="HOS 6:4">हे यहूदा, मेंह तोर बर का कर सकत हंव?</para>
  <para style="q1" vid="HOS 6:4">तुम्हर मया ह बिहनियां के कुहरा के असन,</para>
  <para style="q2" vid="HOS 6:4">बड़े बिहनियां पड़नेवाला ओ ओस असन अय, जऊन ह गायब हो जाथे।<verse eid="HOS 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 6:5"/>ये खातिर मेंह तुमन ला अपन अगमजानीमन के दुवारा काटके कुटा-कुटा कर डारेंव,</para>
  <para style="q2" vid="HOS 6:5">मेंह अपन मुहूं के बात ले तुमन ला मार डारेंव—</para>
  <para style="q2" vid="HOS 6:5">तब मोर नियाय ह सूरज के सहीं आघू बढ़थे।<verse eid="HOS 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 6:6"/>काबरकि मेंह बलिदान ले नइं, पर दया ले,</para>
  <para style="q2" vid="HOS 6:6">अऊ होम-बलिदान के बदला परमेसर ला माने ले खुस होथंव।<verse eid="HOS 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 6:7"/>पर आदम<note caller="+" style="f"><char style="fr" closed="false">6:7 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">मानव-जाति</char></note> असन, ओमन करार ला टोर दे हवंय;</para>
  <para style="q2" vid="HOS 6:7">ओमन उहां मोर संग बिसवासघात करे रिहिन।<verse eid="HOS 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 6:8"/>गिलाद दुस्ट काम करइयामन के एक सहर अय,</para>
  <para style="q2" vid="HOS 6:8">उहां लहू ले भरे मनखेमन के चले के निसान हवय।<verse eid="HOS 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 6:9"/>जइसने लुटेरामन अपन सिकार बर लुकाके घात म रहिथें,</para>
  <para style="q2" vid="HOS 6:9">वइसनेच पुरोहितमन के दल ह करथे;</para>
  <para style="q1" vid="HOS 6:9">ओमन अपन दुस्ट योजना ला पूरा करत</para>
  <para style="q2" vid="HOS 6:9">सकेम सहर के रद्दा म हतिया करथें।<verse eid="HOS 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 6:10"/>इसरायल म मेंह एक भयानक चीज देखे हंव:</para>
  <para style="q2" vid="HOS 6:10">उहां एपरैम ला बेस्यागमन बर दिये जाथे,</para>
  <para style="q2" vid="HOS 6:10">अऊ इसरायल ह असुध होथे।<verse eid="HOS 6:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 6:11"/>“हे यहूदा, तोर बर घलो</para>
  <para style="q2" vid="HOS 6:11">कटनी के एक समय ठहिराय गे हवय।</para>
  <para style="b" vid="HOS 6:11"/>
  <para style="q1" vid="HOS 6:11">“जब मेंह अपन मनखेमन के बने दिनमन ला लहुंटा लाहूं,<verse eid="HOS 6:11"/></para>
  <chapter eid="HOS 6"/>
  <chapter number="7" style="c" sid="HOS 7"/>
  <para style="q2">
    <verse number="1" style="v" sid="HOS 7:1"/>जब भी मेंह इसरायल ला चंगा करहूं,</para>
  <para style="q1" vid="HOS 7:1">त एपरैम के पापमन ला बताय जाही</para>
  <para style="q2" vid="HOS 7:1">अऊ सामरिया के अपराधमन परगट होहीं।</para>
  <para style="q1" vid="HOS 7:1">ओमन धोखा देय के काम करथें,</para>
  <para style="q2" vid="HOS 7:1">चोरमन घरमन म चोरी करथें,</para>
  <para style="q2" vid="HOS 7:1">लुटेरामन गलीमन म लूटमार करथें;<verse eid="HOS 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 7:2"/>पर ओमन ये नइं समझंय</para>
  <para style="q2" vid="HOS 7:2">कि में ओमन के जम्मो दुस्ट काममन ला सुरता रखथंव।</para>
  <para style="q1" vid="HOS 7:2">ओमन के पापमन ओमन ला पूरा खा जाथें;</para>
  <para style="q2" vid="HOS 7:2">ओमन के काम हमेसा मोर नजर म बने रहिथें।<verse eid="HOS 7:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 7:3"/>“ओमन राजा ला अपन दुस्टता,</para>
  <para style="q2" vid="HOS 7:3">अऊ हाकिममन ला अपन लबारी बातमन ले खुस रखथें।<verse eid="HOS 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 7:4"/>ओमन जम्मो के जम्मो बेभिचारी अंय,</para>
  <para style="q2" vid="HOS 7:4">एक बरत चूल्हा के सहीं</para>
  <para style="q1" vid="HOS 7:4">जेकर आगी ला रोटी बनइया ह तब तक तेज नइं करय</para>
  <para style="q2" vid="HOS 7:4">जब तक कि ओह पीसान ला सानके पकाय बर तियार नइं कर लेवय।<verse eid="HOS 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 7:5"/>हमर राजा के तिहार के दिन</para>
  <para style="q2" vid="HOS 7:5">हाकिममन मंद पीके चूर हो जाथें,</para>
  <para style="q2" vid="HOS 7:5">अऊ ओह ठट्ठा करइयामन संग सामिल हो जाथे।<verse eid="HOS 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 7:6"/>ओमन के मन ह चूल्हा सहीं अय;</para>
  <para style="q2" vid="HOS 7:6">ओमन ओकर करा सडयंत्र रचके जाथें।</para>
  <para style="q1" vid="HOS 7:6">ओमन के लालसा रात भर सुलगत रहिथे;</para>
  <para style="q2" vid="HOS 7:6">अऊ बिहनियां आगी के लपट सहीं धधकथे।<verse eid="HOS 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 7:7"/>ओमन जम्मो के जम्मो चूल्हा असन गरम हवंय;</para>
  <para style="q2" vid="HOS 7:7">ओमन अपन सासन करइयामन ला भसम कर देथें।</para>
  <para style="q1" vid="HOS 7:7">ओमन के जम्मो राजामन मारे जाथें,</para>
  <para style="q2" vid="HOS 7:7">अऊ ओमा के कोनो घलो मोला नइं पुकारंय।<verse eid="HOS 7:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 7:8"/>“एपरैम ह देस-देस के मनखेमन संग घुल-मिल जाथे;</para>
  <para style="q2" vid="HOS 7:8">एपरैम एक सपाट रोटी सहीं अय, जऊन ला पलटे नइं गे हवय।<verse eid="HOS 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 7:9"/>परदेसीमन ओकर ताकत के सोसन करथें,</para>
  <para style="q2" vid="HOS 7:9">पर ओह ये बात ला नइं समझय।</para>
  <para style="q1" vid="HOS 7:9">ओकर चुंदी ह पाकत हवय,</para>
  <para style="q2" vid="HOS 7:9">पर ओह येला धियान नइं देवय।<verse eid="HOS 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 7:10"/>इसरायल के अहंकार ह ओकर बिरूध म गवाही देथे,</para>
  <para style="q2" vid="HOS 7:10">पर ये जम्मो बात के बावजूद</para>
  <para style="q1" vid="HOS 7:10">ओह यहोवा अपन परमेसर करा लहुंटके नइं आवय</para>
  <para style="q2" vid="HOS 7:10">या ओला नइं खोजय।<verse eid="HOS 7:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 7:11"/>“एपरैम ह एक पंड़की चिरई असन अय,</para>
  <para style="q2" vid="HOS 7:11">जऊन ह आसानी से धोखा खाथे अऊ निरबुद्धि अय—</para>
  <para style="q1" vid="HOS 7:11">ओमन मदद बर मिसर ला बलात हें,</para>
  <para style="q2" vid="HOS 7:11">अब अस्सूर कोति जावत हें।<verse eid="HOS 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 7:12"/>जब ओमन जाहीं, त मेंह ओमन ऊपर अपन जाल डारहूं;</para>
  <para style="q2" vid="HOS 7:12">मेंह ओमन ला अकास के चिरईमन ला गिराय सहीं खाल्हे म गिरा दूहूं।</para>
  <para style="q1" vid="HOS 7:12">जब मेंह सुनहूं कि ओमन एक संग झुंड म जूरथें, त मेंह ओमन ला पकड़ लूहूं।<verse eid="HOS 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 7:13"/>ओमन ऊपर हाय,</para>
  <para style="q2" vid="HOS 7:13">काबरकि ओमन मोर ले अलग हो गे हवंय!</para>
  <para style="q1" vid="HOS 7:13">ओमन के सतियानास होवय,</para>
  <para style="q2" vid="HOS 7:13">काबरकि ओमन मोर बिरूध बिदरोह करे हवंय!</para>
  <para style="q1" vid="HOS 7:13">मेंह ओमन ला छोंड़ाय के ईछा करथंव</para>
  <para style="q2" vid="HOS 7:13">पर ओमन मोर बारे म झूठ बोलथें।<verse eid="HOS 7:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 7:14"/>ओमन मोला अपन पूरा मन ले नइं पुकारंय</para>
  <para style="q2" vid="HOS 7:14">पर अपन बिस्तर म पड़े बिलाप करथें।</para>
  <para style="q1" vid="HOS 7:14">अनाज अऊ नवां अंगूर के मंद बर</para>
  <para style="q2" vid="HOS 7:14">ओमन अपन देवतामन ले बिनती करत अपनआप ला घायल करथें,</para>
  <para style="q2" vid="HOS 7:14">पर ओमन मोर ले दूरिहा रहिथें।<verse eid="HOS 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 7:15"/>मेंह ओमन ला सिकछा देंव अऊ ओमन के हांथ ला मजबूत करेंव,</para>
  <para style="q2" vid="HOS 7:15">पर ओमन मोर बिरूध सडयंत्र करथें।<verse eid="HOS 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 7:16"/>ओमन सर्वोच्च परमेसर कोति नइं फिरंय;</para>
  <para style="q2" vid="HOS 7:16">ओमन अइसन धनुस असन अंय, जऊन म दोस हवय।</para>
  <para style="q1" vid="HOS 7:16">ओमन के अगुवामन घमंड ले भरे बात के कारन</para>
  <para style="q2" vid="HOS 7:16">तलवार ले मारे जाहीं।</para>
  <para style="q1" vid="HOS 7:16">एकरे कारन ओमन ला मिसर देस म</para>
  <para style="q2" vid="HOS 7:16">ठट्ठा म उड़ाय जाही।<verse eid="HOS 7:16"/></para>
  <chapter eid="HOS 7"/>
  <chapter number="8" style="c" sid="HOS 8"/>
  <para style="s1">इसरायल के फर भोगई</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 8:1"/>“तुरही ला अपन ओंठ म रखव!</para>
  <para style="q2" vid="HOS 8:1">एक गिधवा ह यहोवा के घर ऊपर हवय</para>
  <para style="q1" vid="HOS 8:1">काबरकि मोर मनखेमन मोर करार ला टोरे हवंय</para>
  <para style="q2" vid="HOS 8:1">अऊ मोर कानून के बिरूध बिदरोह करे हवंय।<verse eid="HOS 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 8:2"/>इसरायल ह मोला पुकारके कहत हे,</para>
  <para style="q2" vid="HOS 8:2">‘हे हमर परमेसर, हमन तोला मानथन!’<verse eid="HOS 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 8:3"/>पर इसरायल ह भलई ला अस्वीकार करे हवय;</para>
  <para style="q2" vid="HOS 8:3">एक बईरी ह ओकर पीछा करही।<verse eid="HOS 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 8:4"/>ओमन मोर बिगर सहमती के राजामन ला ठहिराथें,</para>
  <para style="q2" vid="HOS 8:4">ओमन बिगर मोर सहमती के हाकिममन ला चुनथें।</para>
  <para style="q1" vid="HOS 8:4">ओमन अपन सोन अऊ चांदी ले</para>
  <para style="q2" vid="HOS 8:4">अपन बिनास बर</para>
  <para style="q2" vid="HOS 8:4">मूरतीमन ला बनाथें।<verse eid="HOS 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 8:5"/>हे सामरिया, अपन बछवा के मूरती ला बाहिर फटिक दे!</para>
  <para style="q2" vid="HOS 8:5">मोर गुस्सा ओमन ऊपर भड़कत हे।</para>
  <para style="q1" vid="HOS 8:5">ओमन कब तक सुध होय के काबिल नइं होहीं?<verse eid="HOS 8:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="HOS 8:6"/>ओमन इसरायल के अंय!</para>
  <para style="q1" vid="HOS 8:6">ये बछवा—एक कारीगर ह येला बनाय हवय;</para>
  <para style="q2" vid="HOS 8:6">येह परमेसर नो हय।</para>
  <para style="q1" vid="HOS 8:6">सामरिया के ओ बछवा ला</para>
  <para style="q2" vid="HOS 8:6">कुटा-कुटा कर दिये जाही।<verse eid="HOS 8:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 8:7"/>“ओमन हवा ला बोथें,</para>
  <para style="q2" vid="HOS 8:7">अऊ बवंडर रूपी फसल लूथें।</para>
  <para style="q1" vid="HOS 8:7">फसल के डंठल म बाली नइं ए;</para>
  <para style="q2" vid="HOS 8:7">येमा ले पीसान नइं मिलय।</para>
  <para style="q1" vid="HOS 8:7">कहूं येकर ले अनाज पईदा होतिस,</para>
  <para style="q2" vid="HOS 8:7">त परदेसीमन ओला खा जातिन।<verse eid="HOS 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 8:8"/>इसरायल ला लील लिये गे हवय;</para>
  <para style="q2" vid="HOS 8:8">अब ओह जाति-जाति के मनखेमन के बीच म अइसन हवय</para>
  <para style="q2" vid="HOS 8:8">जऊन ला कोनो पसंद नइं करंय।<verse eid="HOS 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 8:9"/>काबरकि ओमन एक भटके जंगली गदहा सहीं</para>
  <para style="q2" vid="HOS 8:9">अस्सूर देस चले गे हवंय।</para>
  <para style="q2" vid="HOS 8:9">एपरैम ह अपनआप ला मयारूमन के हांथ म बेच दे हवय।<verse eid="HOS 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 8:10"/>हालाकि ओमन अपनआप ला जाति-जाति के मनखेमन के बीच म बेच दे हवंय,</para>
  <para style="q2" vid="HOS 8:10">तभो ले मेंह अब ओमन ला एक संग इकट्ठा करहूं।</para>
  <para style="q1" vid="HOS 8:10">सक्तिसाली राजा के सताव के कारन</para>
  <para style="q2" vid="HOS 8:10">ओमन नास होय लगहीं।<verse eid="HOS 8:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 8:11"/>“हालाकि एपरैम ह पाप-बलिदान बर बहुंत अकन बेदीमन ला बनाईस,</para>
  <para style="q2" vid="HOS 8:11">पर ये बेदीमन ओकर पाप करे के कारन बन गे हवंय।<verse eid="HOS 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 8:12"/>मेंह ओमन बर अपन कानून के बहुंत बात लिखेंव,</para>
  <para style="q2" vid="HOS 8:12">पर ओमन ओ बातमन ला बाहिर के समझिन।<verse eid="HOS 8:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 8:13"/>हालाकि ओमन भेंट के रूप म बलिदान चघाथें,</para>
  <para style="q2" vid="HOS 8:13">अऊ हालाकि ओमन मांस खाथें,</para>
  <para style="q2" vid="HOS 8:13">पर यहोवा ह ओमन ले खुस नइं ए।</para>
  <para style="q1" vid="HOS 8:13">अब ओह ओमन के दुस्टता के काममन ला सुरता करही</para>
  <para style="q2" vid="HOS 8:13">अऊ ओमन के पाप खातिर सजा दीही:</para>
  <para style="q2" vid="HOS 8:13">ओमन मिसर देस ला लहुंटहीं।<verse eid="HOS 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 8:14"/>इसरायल ह अपन बनानेवाला ला भुला गे हवय</para>
  <para style="q2" vid="HOS 8:14">अऊ महलमन ला बनाय हवय;</para>
  <para style="q2" vid="HOS 8:14">यहूदा ह बहुंते नगरमन ला किलाबंदी करे हवय।</para>
  <para style="q1" vid="HOS 8:14">पर मेंह ओमन के सहरमन म आगी लगा दूहूं</para>
  <para style="q2" vid="HOS 8:14">जेकर ले ओमन के गढ़मन जलके भसम हो जाहीं।”<verse eid="HOS 8:14"/></para>
  <chapter eid="HOS 8"/>
  <chapter number="9" style="c" sid="HOS 9"/>
  <para style="s1">इसरायल ला सजा</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 9:1"/>हे इसरायल, आनंद झन मना;</para>
  <para style="q2" vid="HOS 9:1">आने देसमन सहीं आनंद म मगन झन हो।</para>
  <para style="q1" vid="HOS 9:1">काबरकि तेंह अपन परमेसर के संग बिसवासघात करे हवस;</para>
  <para style="q2" vid="HOS 9:1">तेंह हर एक कोठार म</para>
  <para style="q2" vid="HOS 9:1">बेस्यागमन के कमई ला पसंद करथस।<verse eid="HOS 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 9:2"/>कोठार अऊ अंगूर के रसकुंडमन ले मनखेमन ला खाना नइं मिलय;</para>
  <para style="q2" vid="HOS 9:2">नवां अंगूर के मंद घलो ओमन ला नइं मिलही।<verse eid="HOS 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 9:3"/>ओमन<note caller="+" style="f"><char style="fr" closed="false">9:3 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">इसरायल के मनखेमन</char></note> यहोवा के देस म रहे बर नइं पाहीं;</para>
  <para style="q2" vid="HOS 9:3">एपरैम ह मिसर देस ला लहुंट जाही</para>
  <para style="q2" vid="HOS 9:3">अऊ अस्सूर म ओमन असुध चीजमन ला खाहीं।<verse eid="HOS 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 9:4"/>ओमन यहोवा ला अंगूर के मंद के भेंट नइं चघाहीं,</para>
  <para style="q2" vid="HOS 9:4">अऊ न ही ओमन के बलिदान ले परमेसर ह खुस होही।</para>
  <para style="q1" vid="HOS 9:4">ओ किसम के बलिदान ओमन बर सोक करइयामन के रोटी सहीं अय;</para>
  <para style="q2" vid="HOS 9:4">ओला खवइया जम्मो झन असुध हो जाहीं।</para>
  <para style="q1" vid="HOS 9:4">ये जेवन ह ओमन के खुद बर होही;</para>
  <para style="q2" vid="HOS 9:4">येला यहोवा के मंदिर म नइं लाय जाही।<verse eid="HOS 9:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 9:5"/>तुमन अपन ठहिराय तिहारमन के दिन,</para>
  <para style="q2" vid="HOS 9:5">यहोवा के भोजमन के दिन म का करहू?<verse eid="HOS 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 9:6"/>कहूं ओमन बिनास के दिन बच निकलथें,</para>
  <para style="q2" vid="HOS 9:6">त मिसर देस ह ओमन ला इकट्ठा करही,</para>
  <para style="q2" vid="HOS 9:6">अऊ मेमफीस<note caller="+" style="f"><char style="fr" closed="false">9:6 </char><char style="fq" closed="false">मेमफीस </char><char style="ft" closed="false">येह पुराना मिसर देस के उत्तरी राजधानी रिहिस</char></note> के निवासीमन ओमन ला माटी दीहीं।</para>
  <para style="q1" vid="HOS 9:6">कंटिली झाड़ीमन ओमन के चांदी के चीजमन ला ले लीहीं,</para>
  <para style="q2" vid="HOS 9:6">अऊ ओमन के तम्बूमन म कांटामन उगहीं।<verse eid="HOS 9:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 9:7"/>सजा के दिनमन आवत हवंय,</para>
  <para style="q2" vid="HOS 9:7">बदला लेय के दिनमन लकठा म हवंय।</para>
  <para style="q2" vid="HOS 9:7">ये बात ला इसरायल जान लेवय।</para>
  <para style="q1" vid="HOS 9:7">काबरकि तुम्हर पापमन बहुंत हवंय</para>
  <para style="q2" vid="HOS 9:7">अऊ तुम्हर बईरता बहुंत जादा हवय,</para>
  <para style="q1" vid="HOS 9:7">अगमजानी ला मुरूख,</para>
  <para style="q2" vid="HOS 9:7">अऊ आतमा ले उकसाय मनखे ला बइहा समझे जाथे।<verse eid="HOS 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 9:8"/>अगमजानी ह मोर परमेसर के संग</para>
  <para style="q2" vid="HOS 9:8">एपरैम के ऊपर पहरेदार हवय,</para>
  <para style="q1" vid="HOS 9:8">तभो ले ओकर जम्मो रद्दा म फांदा लगे हवय,</para>
  <para style="q2" vid="HOS 9:8">अऊ ओकर परमेसर के घर म बईरता हवय।<verse eid="HOS 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 9:9"/>ओमन गिबा के समय के सहीं</para>
  <para style="q2" vid="HOS 9:9">बहुंत भ्रस्टाचार म पड़े हवंय।</para>
  <para style="q1" vid="HOS 9:9">परमेसर ह ओमन के दुस्ट काममन ला सुरता करही</para>
  <para style="q2" vid="HOS 9:9">अऊ ओमन के पाप बर ओमन ला सजा दीही।<verse eid="HOS 9:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 9:10"/>“मेंह इसरायल ला अइसने पायेंव,</para>
  <para style="q2" vid="HOS 9:10">जइसने कोनो ला निरजन जगह म अंगूर मिलथे;</para>
  <para style="q1" vid="HOS 9:10">जब मेंह तुम्हर पुरखामन ला देखेंव,</para>
  <para style="q2" vid="HOS 9:10">त येह अंजीर के रूख म लगे सुरूआती फर ला देखे सहीं रिहिस।</para>
  <para style="q1" vid="HOS 9:10">पर जब ओमन बाल-पेओर पहाड़ म आईन,</para>
  <para style="q2" vid="HOS 9:10">त ओमन ओ लज्जा के मूरती बर अपनआप ला पबितर करिन</para>
  <para style="q2" vid="HOS 9:10">अऊ ओमन ओतेक दुस्ट हो गीन, जतेक ओमन ओ चीजमन<note caller="+" style="f"><char style="fr" closed="false">9:10 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">मूरतीमन</char></note> ले मया करत रिहिन।<verse eid="HOS 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 9:11"/>एपरैम के गौरव ह चिरई असन उड़ जाही—</para>
  <para style="q2" vid="HOS 9:11">न तो काकरो जनम होही, न कोनो देहें म होही, अऊ न ही कोनो ला गरभ ठहिरही।<verse eid="HOS 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 9:12"/>चाहे ओमन अपन लइकामन के पालन-पोसन करंय, त घलो,</para>
  <para style="q2" vid="HOS 9:12">मेंह हर एक ला ओमन ले लेय लूहूं।</para>
  <para style="q1" vid="HOS 9:12">ओमन ऊपर हाय</para>
  <para style="q2" vid="HOS 9:12">जब मेंह ओमन ले दूरिहा हो जावंव!<verse eid="HOS 9:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 9:13"/>मेंह एपरैम ला सूर के सहीं</para>
  <para style="q2" vid="HOS 9:13">मनभावन जगह म बसे हुए देखे हंव।</para>
  <para style="q1" vid="HOS 9:13">पर एपरैम ह अपन लइकामन ला</para>
  <para style="q2" vid="HOS 9:13">बध करइया करा ले आही।”<verse eid="HOS 9:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 9:14"/>हे यहोवा, ओमन ला दे—</para>
  <para style="q2" vid="HOS 9:14">तेंह ओमन ला का देबे?</para>
  <para style="q1" vid="HOS 9:14">ओमन ला अइसन गरभ दे, जेकर ले गरभपात हो जाथे</para>
  <para style="q2" vid="HOS 9:14">अऊ अइसन थन दे, जेकर ले दूध नइं आवय।<verse eid="HOS 9:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 9:15"/>“गिलगाल सहर म ओमन के जम्मो दुस्ट काम के कारन,</para>
  <para style="q2" vid="HOS 9:15">उहां मेंह ओमन ले घिन करेंव।</para>
  <para style="q1" vid="HOS 9:15">ओमन के पापमय काममन के खातिर,</para>
  <para style="q2" vid="HOS 9:15">मेंह ओमन ला अपन घर ले निकाल दूहूं।</para>
  <para style="q1" vid="HOS 9:15">मेंह ओमन ले अब मया नइं रखहूं;</para>
  <para style="q2" vid="HOS 9:15">ओमन के जम्मो अगुवामन बिदरोही अंय।<verse eid="HOS 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 9:16"/>एपरैम ला बेमारी लग गे हवय,</para>
  <para style="q2" vid="HOS 9:16">ओमन के जरी ह सूखा गीस,</para>
  <para style="q2" vid="HOS 9:16">ओमन म फर नइं लगय।</para>
  <para style="q1" vid="HOS 9:16">चाहे ओमन लइकामन ला जनमांय घलो,</para>
  <para style="q2" vid="HOS 9:16">तभो ले मेंह ओमन के पाले-पोसे लइकामन ला मार डारहूं।”<verse eid="HOS 9:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 9:17"/>मोर परमेसर ह ओमन ला स्वीकार नइं करही</para>
  <para style="q2" vid="HOS 9:17">काबरकि ओमन ओकर बात ला नइं माने हवंय;</para>
  <para style="q2" vid="HOS 9:17">ओमन जाति-जाति के मनखेमन के बीच म भटकत फिरहीं।<verse eid="HOS 9:17"/></para>
  <para style="b"/>
  <chapter eid="HOS 9"/>
  <chapter number="10" style="c" sid="HOS 10"/>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 10:1"/>इसरायल ह एक ठन बढ़त अंगूर के नार रिहिस;</para>
  <para style="q2" vid="HOS 10:1">ओह अपन बर फर देवत रिहिस।</para>
  <para style="q1" vid="HOS 10:1">जइसन-जइसन ओकर फरमन बढ़त गीन,</para>
  <para style="q2" vid="HOS 10:1">ओह अऊ जादा बेदीमन<note caller="+" style="f"><char style="fr" closed="false">10:1 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">मूरती-पूजा के बेदीमन</char></note> ला बनाईस;</para>
  <para style="q1" vid="HOS 10:1">जइसन-जइसन ओकर देस उन्नति करत गीस,</para>
  <para style="q2" vid="HOS 10:1">ओह अपन पबितर पथरामन ला सजाईस।<verse eid="HOS 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 10:2"/>ओमन के मन ह धोखेबाज ए,</para>
  <para style="q2" vid="HOS 10:2">अऊ अब ओमन अपन अपराध के सजा जरूर पाहीं।</para>
  <para style="q1" vid="HOS 10:2">यहोवा ह ओमन के बेदीमन ला गिरा दीही</para>
  <para style="q2" vid="HOS 10:2">अऊ ओमन के पबितर पथरामन ला नास कर दीही।<verse eid="HOS 10:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 10:3"/>तब ओमन कहिहीं, “हमर कोनो राजा नइं एं</para>
  <para style="q2" vid="HOS 10:3">काबरकि हमन यहोवा के आदर नइं करेंन।</para>
  <para style="q1" vid="HOS 10:3">पर कहूं हमर कोनो राजा होतिस घलो,</para>
  <para style="q2" vid="HOS 10:3">त ओह हमर बर का करतिस?”<verse eid="HOS 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 10:4"/>ओमन बहुंत अकन वायदा करथें,</para>
  <para style="q2" vid="HOS 10:4">झूठा किरिया खाथें</para>
  <para style="q2" vid="HOS 10:4">अऊ करार करथें;</para>
  <para style="q1" vid="HOS 10:4">ये खातिर नांगर जोते खेत म उगे</para>
  <para style="q2" vid="HOS 10:4">जहरिला कांदी सहीं मुकदमामन होय लगथें।<verse eid="HOS 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 10:5"/>जऊन मनखेमन सामरिया सहर म रहिथें</para>
  <para style="q2" vid="HOS 10:5">ओमन बेत-आवेन के बछवा के मूरती के कारन डरात हवंय।</para>
  <para style="q1" vid="HOS 10:5">एकर मनखेमन एकर बर बिलाप करहीं,</para>
  <para style="q2" vid="HOS 10:5">अऊ अइसने ही एकर मूरती-पूजा करइया पुरोहितमन घलो करहीं,</para>
  <para style="q1" vid="HOS 10:5">जऊन मन कि पहिले एकर वैभव ऊपर आनंद मनात रिहिन,</para>
  <para style="q2" vid="HOS 10:5">काबरकि येला ओमन ले छीनके बंधुवई म ले लिये गे हवय।<verse eid="HOS 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 10:6"/>येला बड़े राजा ला भेंट के रूप म देय बर</para>
  <para style="q2" vid="HOS 10:6">अस्सूर देस ला ले जाय जाही।</para>
  <para style="q1" vid="HOS 10:6">एपरैम ला लज्जित करे जाही;</para>
  <para style="q2" vid="HOS 10:6">इसरायल घलो बाहिरी मनखेमन संग अपन नाता के कारन लज्जित होही।<verse eid="HOS 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 10:7"/>सामरिया के राजा ला अइसन नास करे जाही,</para>
  <para style="q2" vid="HOS 10:7">जइसन रूख के एक छोटे डारा ह पानी के बहाव म नास हो जाथे।<verse eid="HOS 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 10:8"/>बुरई के ऊंच ठऊरमन नास करे जाहीं—</para>
  <para style="q2" vid="HOS 10:8">येह इसरायल के पाप अय।</para>
  <para style="q1" vid="HOS 10:8">कांटावाले पऊधा अऊ झाड़ीमन उगहीं</para>
  <para style="q2" vid="HOS 10:8">अऊ ओमन के बेदीमन ला ढांप लीहीं।</para>
  <para style="q1" vid="HOS 10:8">तब ओमन पहाड़मन ले कहिहीं, “हमन ला ढांप लेवव!”</para>
  <para style="q2" vid="HOS 10:8">अऊ पहाड़ीमन ले कहिहीं, “हमर ऊपर गिर जावव!”<verse eid="HOS 10:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 10:9"/>“हे इसरायल, तेंह गिबा के समय ले पाप करत आय हवस,</para>
  <para style="q2" vid="HOS 10:9">अऊ तेंह अभी घलो ओहीच म बने हवस।</para>
  <para style="q1" vid="HOS 10:9">का दुस्ट काम करइयामन गिबा म</para>
  <para style="q2" vid="HOS 10:9">फेर लड़ई म नइं फंसहीं?<verse eid="HOS 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 10:10"/>जब मोर ईछा होही, तब मेंह ओमन ला दंड दूहूं;</para>
  <para style="q2" vid="HOS 10:10">आनजातमन, ओमन के दू गुना पाप के कारन</para>
  <para style="q2" vid="HOS 10:10">ओमन ला बंधन म डारे बर ओमन के बिरूध म इकट्ठा होहीं।<verse eid="HOS 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 10:11"/>एपरैम ह एक सिखोय गय बछिया अय</para>
  <para style="q2" vid="HOS 10:11">जऊन ला अनाज मिंजई बने लगथे;</para>
  <para style="q1" vid="HOS 10:11">एकरसेति मेंह ओकर सुघर घेंच म</para>
  <para style="q2" vid="HOS 10:11">एक ठन जुड़ा ला रखहूं।</para>
  <para style="q1" vid="HOS 10:11">मेंह एपरैम ला चलाहूं,</para>
  <para style="q2" vid="HOS 10:11">यहूदा ला नांगर जोतना जरूरी अय,</para>
  <para style="q2" vid="HOS 10:11">अऊ जरूरी अय कि याकूब ह ढेला फोरय।<verse eid="HOS 10:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 10:12"/>अपन बर धरमीपन के बीजा ला बोवव,</para>
  <para style="q2" vid="HOS 10:12">निस्कपट मया के फसल काटव,</para>
  <para style="q1" vid="HOS 10:12">अऊ बिगर जोताय खेत के माटी ला फोरव;</para>
  <para style="q2" vid="HOS 10:12">काबरकि येह यहोवा के खोज म रहे के समय ए,</para>
  <para style="q1" vid="HOS 10:12">जब तक कि ओह आके</para>
  <para style="q2" vid="HOS 10:12">तुम्हर ऊपर धरमीपन के बारिस नइं करय।<verse eid="HOS 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 10:13"/>पर तुमन दुस्टता के बीजा लगाय हवव,</para>
  <para style="q2" vid="HOS 10:13">अऊ बुरई के फसल काटे हवव,</para>
  <para style="q2" vid="HOS 10:13">तुमन धोखा के फर ला खाय हवव।</para>
  <para style="q1" vid="HOS 10:13">काबरकि तुमन अपन खुद के सक्ति</para>
  <para style="q2" vid="HOS 10:13">अऊ अपन बहुंत अकन योद्धामन ऊपर भरोसा रखे रहेव।<verse eid="HOS 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 10:14"/>तुम्हर मनखेमन के बिरूध लड़ई के ललकार होही,</para>
  <para style="q2" vid="HOS 10:14">ताकि तुम्हर जम्मो गढ़मन ला नास कर दिये जावय—</para>
  <para style="q1" vid="HOS 10:14">जइसन कि लड़ई के दिन, सलमन ह बेथ-आरबेल ला नास करिस,</para>
  <para style="q2" vid="HOS 10:14">जब दाईमन ला ओमन के लइकामन के संग भुइयां म पटकके मार डारे गे रिहिस।<verse eid="HOS 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 10:15"/>हे बेतेल, तोर संग घलो अइसनेच होही,</para>
  <para style="q2" vid="HOS 10:15">काबरकि तेंह बहुंत दुस्ट काम करे हवस।</para>
  <para style="q1" vid="HOS 10:15">जब बिहनियां होही,</para>
  <para style="q2" vid="HOS 10:15">इसरायल के राजा ला पूरा नास कर दिये जाही।<verse eid="HOS 10:15"/></para>
  <chapter eid="HOS 10"/>
  <chapter number="11" style="c" sid="HOS 11"/>
  <para style="s1">इसरायल बर परमेसर के मया</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 11:1"/>“जब इसरायल ह लइका रिहिस, त मेंह ओला मया करेंव,</para>
  <para style="q2" vid="HOS 11:1">अऊ मिसर देस ले मेंह अपन बेटा ला बलांय।<verse eid="HOS 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 11:2"/>पर जतेक जादा ओमन ला बलाय गीस,</para>
  <para style="q2" vid="HOS 11:2">ओतेक जादा ओमन मोर ले दूरिहा होवत गीन।</para>
  <para style="q1" vid="HOS 11:2">ओमन बाल देवतामन बर बलि चघाईन</para>
  <para style="q2" vid="HOS 11:2">अऊ ओमन मूरतीमन के आघू म धूप जलाईन।<verse eid="HOS 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 11:3"/>ओह में रहेंव, जऊन ह एपरैम ला</para>
  <para style="q2" vid="HOS 11:3">हांथ धरके रेंगे बर सिखोईस;</para>
  <para style="q1" vid="HOS 11:3">पर ओमन ये बात ला नइं जानिन</para>
  <para style="q2" vid="HOS 11:3">कि ओह मेंहीच रहेंव, जऊन ह ओमन ला चंगा करिस।<verse eid="HOS 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 11:4"/>मेंह मानव रूपी दया के डोरी ला,</para>
  <para style="q2" vid="HOS 11:4">मया के बंधन म गुंथके ओमन के अगुवई करेंव।</para>
  <para style="q1" vid="HOS 11:4">ओमन बर मेंह अइसने रहेंव,</para>
  <para style="q2" vid="HOS 11:4">जइसने कोनो छोटे लइका ला गाल तक ऊपर उठाथे,</para>
  <para style="q2" vid="HOS 11:4">अऊ मेंह खाल्हे निहरके ओमन ला जेवन करायेंव।<verse eid="HOS 11:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 11:5"/>“का ओमन मिसर देस नइं लहुंटहीं</para>
  <para style="q2" vid="HOS 11:5">अऊ का अस्सूर के राजा ओमन ऊपर राज नइं करही</para>
  <para style="q2" vid="HOS 11:5">काबरकि ओमन पछताप करे नइं चाहंय?<verse eid="HOS 11:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 11:6"/>ओमन के सहरमन म एक तलवार चमकही;</para>
  <para style="q2" vid="HOS 11:6">ओह ओमन के लबरा अगमजानीमन ला मार डारही</para>
  <para style="q2" vid="HOS 11:6">अऊ ओमन के योजनामन ला खतम कर दीही।<verse eid="HOS 11:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 11:7"/>मोर मनखेमन मोर ले दूरिहा होय के ठान ले हवंय।</para>
  <para style="q2" vid="HOS 11:7">हालाकि ओमन मोला सर्वोच्च परमेसर कहिथें,</para>
  <para style="q2" vid="HOS 11:7">तभो ले मेंह ओमन के कोनो किसम ले परसंसा नइं करहूं।<verse eid="HOS 11:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 11:8"/>“हे एपरैम, मेंह तोला कइसे छोंड़ सकत हंव?</para>
  <para style="q2" vid="HOS 11:8">हे इसरायल, मेंह तोला कोनो अऊ ला कइसे सऊंप दंव?</para>
  <para style="q1" vid="HOS 11:8">मेंह तोर संग अदमा नगर असन बरताव कइसे कर सकत हंव?</para>
  <para style="q2" vid="HOS 11:8">मेंह तोला सबोईम नगर के असन कइसे बना सकत हंव?</para>
  <para style="q1" vid="HOS 11:8">मोर हिरदय ह मोर भीतर म बदल गे हवय;</para>
  <para style="q2" vid="HOS 11:8">मोर जम्मो करूना जाग गे हवय।<verse eid="HOS 11:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 11:9"/>मेंह अपन भयंकर कोरोध ला भड़कन नइं दंव,</para>
  <para style="q2" vid="HOS 11:9">न ही मेंह एपरैम ला फेर नास करहूं।</para>
  <para style="q1" vid="HOS 11:9">काबरकि मेंह मनखे नइं, परमेसर अंव—</para>
  <para style="q2" vid="HOS 11:9">तुम्हर बीच एक पबितर जन।</para>
  <para style="q2" vid="HOS 11:9">मेंह ओमन के सहरमन के बिरूध नइं आवंव।<verse eid="HOS 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 11:10"/>ओमन यहोवा के पाछू चलहीं;</para>
  <para style="q2" vid="HOS 11:10">ओह एक सिंह सहीं गरजही।</para>
  <para style="q1" vid="HOS 11:10">जब ओह गरजही,</para>
  <para style="q2" vid="HOS 11:10">त ओकर लइकामन कांपत पछिम दिग ले आहीं।<verse eid="HOS 11:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 11:11"/>ओमन मिसर देस ले,</para>
  <para style="q2" vid="HOS 11:11">गौरइया चिरईमन सहीं कांपत,</para>
  <para style="q2" vid="HOS 11:11">अऊ अस्सूर देस ले पंड़की असन पांखी फड़फड़ावत आहीं।</para>
  <para style="q1" vid="HOS 11:11">मेंह ओमन ला ओमन के घरमन म बसाहूं,”</para>
  <para style="q2" vid="HOS 11:11">यहोवा ह घोसना करत हे।<verse eid="HOS 11:11"/></para>
  <para style="s1">इसरायल के पाप</para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 11:12"/>एपरैम ह मोर चारों कोति लबारी के,</para>
  <para style="q2" vid="HOS 11:12">अऊ इसरायल ह धोखा के कुढ़ा लगा दे हवय।</para>
  <para style="q1" vid="HOS 11:12">अऊ यहूदा ह उदंड होके परमेसर के बिरूध हवय,</para>
  <para style="q2" vid="HOS 11:12">अऊ त अऊ ओह बिसवासयोग्य पबितर जन के बिरूध हवय।<note caller="+" style="f"><char style="fr" closed="false">11:12 </char><char style="ft" closed="false">इबरानी म ये पद (<char style="xt"><ref loc="HOS 11:12">11:12</ref></char>) ला 12:1 म गने गे हवय</char></note><verse eid="HOS 11:12"/></para>
  <chapter eid="HOS 11"/>
  <chapter number="12" style="c" sid="HOS 12"/>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 12:1"/>एपरैम<note caller="+" style="f"><char style="fr" closed="false">12:1 </char><char style="ft" closed="false">इसरायली मनखे</char></note> ह हवा ला खाथे;</para>
  <para style="q2" vid="HOS 12:1">ओह पूरा दिन पूरब के हवा के पीछा करथे</para>
  <para style="q2" vid="HOS 12:1">अऊ अपन लबारी गोठ अऊ हिंसा ला बढ़ावत रहिथे।</para>
  <para style="q1" vid="HOS 12:1">ओह अस्सूर देस के संग करार करथे</para>
  <para style="q2" vid="HOS 12:1">अऊ मिसर देस ला जैतून के तेल पठोथे।<verse eid="HOS 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 12:2"/>यहूदा के बिरूध यहोवा के आरोप हे;</para>
  <para style="q2" vid="HOS 12:2">ओह याकूब<note caller="+" style="f"><char style="fr" closed="false">12:2 </char><char style="fq" closed="false">याकूब </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">ओह एड़ी ला धरथे, </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">ओह फायदा उठाथे </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">ओह धोखा देथे</char></note> ला ओकर चालचलन के मुताबिक सजा दीही</para>
  <para style="q2" vid="HOS 12:2">अऊ ओकर काममन के मुताबिक ओला बदला दीही।<verse eid="HOS 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 12:3"/>अपन दाई के कोख ही म, ओह अपन भाई के एड़ी ला पकड़ ले रिहिस;</para>
  <para style="q2" vid="HOS 12:3">एक मनखे के रूप म ओह परमेसर के संग लड़िस।<note caller="+" style="f"><char style="fr" closed="false">12:3 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="GEN 25:26">उत 25:26</ref>; <ref loc="GEN 32:24">32:24</ref></char></char></note><verse eid="HOS 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 12:4"/>ओह स्वरगदूत के संग लड़िस अऊ स्वरगदूत ऊपर जय पाईस;</para>
  <para style="q2" vid="HOS 12:4">ओह रोईस अऊ ओकर ले किरपा करे बर बिनती करिस।</para>
  <para style="q1" vid="HOS 12:4">बेतेल म ओह परमेसर ले मिलिस</para>
  <para style="q2" vid="HOS 12:4">अऊ उहां ओह ओकर ले गोठियाईस—<verse eid="HOS 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 12:5"/>यहोवा, सर्वसक्तिमान परमेसर,</para>
  <para style="q2" vid="HOS 12:5">यहोवा ओकर नांव अय।<verse eid="HOS 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 12:6"/>पर ये जरूरी अय कि तें अपन परमेसर करा लहुंट आ;</para>
  <para style="q2" vid="HOS 12:6">मया अऊ नियाय के काम करते रह,</para>
  <para style="q2" vid="HOS 12:6">अऊ हमेसा अपन परमेसर ऊपर भरोसा रख।<verse eid="HOS 12:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 12:7"/>बेपारी ह नाप-तौल म बेईमानी करथे</para>
  <para style="q2" vid="HOS 12:7">अऊ छल-कपट करई ओला बने लगथे।<verse eid="HOS 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 12:8"/>एपरैम ह ये घमंड करथे,</para>
  <para style="q2" vid="HOS 12:8">“मेंह बहुंत धनवान अंव, मेंह धनी हो गे हवंव।</para>
  <para style="q1" vid="HOS 12:8">मोर जम्मो संपत्ति के संग ओमन</para>
  <para style="q2" vid="HOS 12:8">मोर म कोनो अपराध या पाप नइं पाहीं।”<verse eid="HOS 12:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 12:9"/>“जब ले तेंह मिसर देस ले निकलके आय</para>
  <para style="q2" vid="HOS 12:9">में यहोवा तोर परमेसर अंव;</para>
  <para style="q1" vid="HOS 12:9">मेंह फेर तोला तम्बूमन म बसाहूं,</para>
  <para style="q2" vid="HOS 12:9">जइसन कि तुम्हर ठहिराय तिहार के दिनमन म होवत रिहिस।<verse eid="HOS 12:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 12:10"/>मेंह अगमजानीमन ले गोठियांय,</para>
  <para style="q2" vid="HOS 12:10">ओमन ला कतको दरसन देखांय</para>
  <para style="q2" vid="HOS 12:10">अऊ ओमन के जरिये पटंतर कहेंव।”<verse eid="HOS 12:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 12:11"/>का गिलाद सहर ह दुस्ट ए?</para>
  <para style="q2" vid="HOS 12:11">येकर मनखेमन बेकार अंय!</para>
  <para style="q1" vid="HOS 12:11">का ओमन गिलगाल म बईलामन के बलिदान करथें?</para>
  <para style="q2" vid="HOS 12:11">ओमन के बेदीमन जोते गय खेत म</para>
  <para style="q2" vid="HOS 12:11">पथरामन के ढेर सहीं होहीं।<verse eid="HOS 12:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 12:12"/>याकूब ह अराम देस ला भाग गीस;</para>
  <para style="q2" vid="HOS 12:12">इसरायल ह एक घरवाली पाय बर सेवा करिस,</para>
  <para style="q2" vid="HOS 12:12">अऊ ओकर दाम चुकाय बर ओह भेड़मन ला चराईस।<verse eid="HOS 12:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 12:13"/>यहोवा ह इसरायल ला मिसर ले निकाले बर एक अगमजानी के उपयोग करिस,</para>
  <para style="q2" vid="HOS 12:13">एक अगमजानी के दुवारा ओह ओकर खियाल रखिस।<verse eid="HOS 12:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 12:14"/>पर एपरैम ह यहोवा के कोरोध ला बहुंत भड़काय हवय;</para>
  <para style="q2" vid="HOS 12:14">ओकर परभू ह ओकर दुवारा करे गय खून के दोस ओकरे ऊपर रहन दीही</para>
  <para style="q2" vid="HOS 12:14">अऊ ओकर अनादर करे के कारन ओकर ले बदला लीही।<verse eid="HOS 12:14"/></para>
  <chapter eid="HOS 12"/>
  <chapter number="13" style="c" sid="HOS 13"/>
  <para style="s1">इसरायल के बिरूध यहोवा के कोरोध</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 13:1"/>जब एपरैम ह गोठियावय, त मनखेमन कांपंय;</para>
  <para style="q2" vid="HOS 13:1">ओह इसरायल म बड़े आदमी रिहिस।</para>
  <para style="q2" vid="HOS 13:1">पर ओह बाल देवता के अराधना करे के दोसी होईस अऊ मर गीस।<verse eid="HOS 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 13:2"/>अब ओमन अऊ जादा पाप करत हें;</para>
  <para style="q2" vid="HOS 13:2">ओमन अपन चांदी ले अपन बर मूरती बनाथें,</para>
  <para style="q1" vid="HOS 13:2">मूरतीमन म बुद्धिमानी से कारीगरी करे गे हवय,</para>
  <para style="q2" vid="HOS 13:2">ये जम्मो सिल्पकारमन के काम अय।</para>
  <para style="q1" vid="HOS 13:2">ये मनखेमन के बारे म कहे जाथे,</para>
  <para style="q2" vid="HOS 13:2">“ओमन मानव बलि चघाथें!</para>
  <para style="q2" vid="HOS 13:2">ओमन बछवा के मूरतीमन ला चूमथें!”<verse eid="HOS 13:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 13:3"/>ये खातिर ओमन बिहनियां के कुहरा,</para>
  <para style="q2" vid="HOS 13:3">बड़े बिहनियां पड़े ओस सहीं अंय, जऊन ह अइसन गायब होथे,</para>
  <para style="q2" vid="HOS 13:3">जइसन कोठार ले भूंसी ह हवा म उड़ियाथे,</para>
  <para style="q2" vid="HOS 13:3">जइसन खिड़की ले धुआं बाहिर निकल जाथे।<verse eid="HOS 13:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 13:4"/>“पर मेंह तब ले यहोवा तोर परमेसर अंव,</para>
  <para style="q2" vid="HOS 13:4">जब ले तें मिसर देस ले निकलके आय।</para>
  <para style="q1" vid="HOS 13:4">तें मोर छोंड़ कोनो अऊ ला परमेसर करके झन मानबे,</para>
  <para style="q2" vid="HOS 13:4">मोला छोंड़ कोनो अऊ उद्धार करइया नइं ए।<verse eid="HOS 13:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 13:5"/>मेंह उजाड़ निरजन जगह म,</para>
  <para style="q2" vid="HOS 13:5">गरमी ले तपत देस म तोर खियाल रखेंव।<verse eid="HOS 13:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 13:6"/>जब मेंह ओमन ला जेवन करांय, त ओमन खाके अघा गीन;</para>
  <para style="q2" vid="HOS 13:6">जब ओमन खाके अघा गीन, त ओमन घमंडी हो गीन;</para>
  <para style="q2" vid="HOS 13:6">तब ओमन मोला बिसरा दीन।<verse eid="HOS 13:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 13:7"/>एकरसेति मेंह ओमन बर एक सिंह असन होहूं;</para>
  <para style="q2" vid="HOS 13:7">एक चीतवा के असन मेंह ओमन के रद्दा म घात म रहिहूं।<verse eid="HOS 13:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 13:8"/>मेंह ओ माई भालू सहीं बनहूं, जेकर लइकामन ला छीन लिये गे हवय,</para>
  <para style="q2" vid="HOS 13:8">मेंह ओमन ऊपर हमला करहूं अऊ ओमन ला फाड़ डालहूं;</para>
  <para style="q1" vid="HOS 13:8">एक सिंह असन ओमन ला फाड़ डालहूं—</para>
  <para style="q2" vid="HOS 13:8">एक जंगली पसु ह ओमन ला फाड़के अलग-अलग कर दीही।<verse eid="HOS 13:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 13:9"/>“हे इसरायल, तोर बिनास होईस,</para>
  <para style="q2" vid="HOS 13:9">काबरकि तेंह मोर बिरूध, अपन मददगार के बिरूध हवस।<verse eid="HOS 13:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 13:10"/>तोर राजा कहां हवय, कि ओह तोला बचावय?</para>
  <para style="q2" vid="HOS 13:10">कहां हवंय तोर जम्मो नगरमन के सासन करइयामन,</para>
  <para style="q1" vid="HOS 13:10">जेमन के बारे म तेंह कहे रहे,</para>
  <para style="q2" vid="HOS 13:10">‘मोला एक राजा अऊ हाकिम दे’?<verse eid="HOS 13:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 13:11"/>एकरसेति कोरोध म आके मेंह तोला एक राजा देंव,</para>
  <para style="q2" vid="HOS 13:11">अऊ अपन कोरोध म ही मेंह ओला हटा देंव।<verse eid="HOS 13:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 13:12"/>एपरैम के अपराध बहुंत हो गे हवय,</para>
  <para style="q2" vid="HOS 13:12">ओकर पाप के हिसाब-किताब रखाय हवय।<verse eid="HOS 13:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 13:13"/>ओला एक माईलोगन के लइका जनमाय सहीं पीरा होही,</para>
  <para style="q2" vid="HOS 13:13">पर ओह बिगर बुद्धि के एक लइका ए;</para>
  <para style="q1" vid="HOS 13:13">जब जनमे के बेरा होथे,</para>
  <para style="q2" vid="HOS 13:13">त ओला गरभ ले बाहिर आय के गियान नइं रहय।<verse eid="HOS 13:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 13:14"/>“मेंह ये मनखेमन ला कबर के सक्ति ले छुटकारा दूहूं;</para>
  <para style="q2" vid="HOS 13:14">मेंह ओमन ला मिरतू ले बचाहूं।</para>
  <para style="q1" vid="HOS 13:14">हे मिरतू, कहां हवय तोर महामारीमन?</para>
  <para style="q2" vid="HOS 13:14">हे कबर, कहां हवय तोर बिनास?</para>
  <para style="b" vid="HOS 13:14"/>
  <para style="q1" vid="HOS 13:14">“मेंह कुछू करूना नइं करंव,<verse eid="HOS 13:14"/></para>
  <para style="q2">
    <verse number="15" style="v" sid="HOS 13:15"/>चाहे एपरैम ह अपन भाईमन के बीच म उन्नति करे।</para>
  <para style="q1" vid="HOS 13:15">एक पूरब के हवा यहोवा कोति ले</para>
  <para style="q2" vid="HOS 13:15">मरू-भुइयां ले आही;</para>
  <para style="q1" vid="HOS 13:15">ओकर सोता ले पानी निकलई बंद हो जाही</para>
  <para style="q2" vid="HOS 13:15">अऊ ओकर कुआं ह सूखा जाही।</para>
  <para style="q1" vid="HOS 13:15">ओकर गोदाम म रखे</para>
  <para style="q2" vid="HOS 13:15">जम्मो कीमती चीजमन ला लूट लिये जाही।<verse eid="HOS 13:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 13:16"/>जरूरी अय कि सामरिया के मनखेमन अपन अपराध के दंड भोगंय,</para>
  <para style="q2" vid="HOS 13:16">काबरकि ओमन अपन परमेसर ले बिदरोह करे हवंय।</para>
  <para style="q1" vid="HOS 13:16">ओमन तलवार ले मारे जाहीं;</para>
  <para style="q2" vid="HOS 13:16">ओमन के छोटे लइकामन ला भुइयां म पटक दिये जाही,</para>
  <para style="q2" vid="HOS 13:16">अऊ ओमन के गरभवती माईलोगनमन के पेट ला चीर दिये जाही।”<note caller="+" style="f"><char style="fr" closed="false">13:16 </char><char style="ft" closed="false">इबरानी म ये पद (<char style="xt"><ref loc="HOS 13:16">13:16</ref></char>) ला 14:1 म गने गे हवय</char></note><verse eid="HOS 13:16"/></para>
  <chapter eid="HOS 13"/>
  <chapter number="14" style="c" sid="HOS 14"/>
  <para style="s1">आसीस पाय बर पछताप</para>
  <para style="q1">
    <note caller="+" style="f">
      <char style="fr" closed="false">14 </char>
      <char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="HOS 14:1-9">14:1‑9</ref></char> ला 14:2‑10 गने गे हवय</char>
    </note> <verse number="1" style="v" sid="HOS 14:1"/>हे इसरायल, यहोवा अपन परमेसर करा लहुंट आ।</para>
  <para style="q2" vid="HOS 14:1">तोर पापमन तोर पतन होय के कारन अंय!<verse eid="HOS 14:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 14:2"/>यहोवा के बातमन ला मान</para>
  <para style="q2" vid="HOS 14:2">अऊ ओकर मेर लहुंट आ।</para>
  <para style="q1" vid="HOS 14:2">ओकर ले बिनती करके कह:</para>
  <para style="q2" vid="HOS 14:2">“हमर जम्मो पापमन ला छेमा कर</para>
  <para style="q1" vid="HOS 14:2">अऊ अनुग्रह के संग हमन ला गरहन कर,</para>
  <para style="q2" vid="HOS 14:2">कि हमन अपन मुहूं ले धनबाद रूपी भेंट चघा सकन।<verse eid="HOS 14:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 14:3"/>अस्सूर ह हमर उद्धार नइं कर सकय;</para>
  <para style="q2" vid="HOS 14:3">हमन लड़ई के घोड़ामन ऊपर सवार नइं होवन।</para>
  <para style="q1" vid="HOS 14:3">हमन अपन हांथ ले बनाय मूरतीमन ला</para>
  <para style="q2" vid="HOS 14:3">फेर कभू नइं कहन ‘हमर देवता’,</para>
  <para style="q2" vid="HOS 14:3">काबरकि अनाथ ला तोर ले ही करूना मिलथे।”<verse eid="HOS 14:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 14:4"/>यहोवा ह कहिथे, “मेंह ओमन के हठी सुभाव ला ठीक करहूं</para>
  <para style="q2" vid="HOS 14:4">अऊ खुला रूप ले ओमन ले मया करहूं,</para>
  <para style="q2" vid="HOS 14:4">काबरकि मोर कोरोध ह ओमन के ऊपर ले हट गे हवय।<verse eid="HOS 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 14:5"/>मेंह इसरायल बर ओस असन होहूं;</para>
  <para style="q2" vid="HOS 14:5">ओह कुमुदिनी फूल असन खिलही।</para>
  <para style="q1" vid="HOS 14:5">लबानोन के देवदार रूख असन</para>
  <para style="q2" vid="HOS 14:5">ओकर जरीमन खाल्हे गहिरा म जाहीं;<verse eid="HOS 14:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="HOS 14:6"/>ओकर कोअंर पीकामन बाढ़हीं।</para>
  <para style="q1" vid="HOS 14:6">ओकर सोभा एक जैतून रूख सहीं होही,</para>
  <para style="q2" vid="HOS 14:6">अऊ ओकर खुसबू लबानोन के देवदार रूख सहीं होही।<verse eid="HOS 14:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 14:7"/>मनखेमन फेर ओकर छइहां म निवास करहीं;</para>
  <para style="q2" vid="HOS 14:7">ओमन अनाज के असन बाढ़हीं,</para>
  <para style="q1" vid="HOS 14:7">ओमन अंगूर के नार असन फूलहीं-फरहीं—</para>
  <para style="q2" vid="HOS 14:7">इसरायल के खियाती ह लबानोन के अंगूर के मंद कस होही।<verse eid="HOS 14:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 14:8"/>हे एपरैम, मूरतीमन ले अब मोर का काम?</para>
  <para style="q2" vid="HOS 14:8">मेंह ओला जबाब दूहूं अऊ ओकर खियाल रखहूं।</para>
  <para style="q1" vid="HOS 14:8">मेंह बाढ़त सनोवर के रूख असन अंव;</para>
  <para style="q2" vid="HOS 14:8">तोर म फर धरई ह मोर कारन होथे।”<verse eid="HOS 14:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 14:9"/>बुद्धिमान कोन ए? ओमन ला ये बातमन के अनुभव करन दव।</para>
  <para style="q2" vid="HOS 14:9">समझदार कोन ए? ओमन ला समझन दव।</para>
  <para style="q1" vid="HOS 14:9">यहोवा के रद्दामन सही अंय;</para>
  <para style="q2" vid="HOS 14:9">धरमीमन ओमा चलथें,</para>
  <para style="q2" vid="HOS 14:9">पर बिदरोही मनखेमन ओमा ठोकर खाके गिरथें।<verse eid="HOS 14:9"/></para>
  <chapter eid="HOS 14"/>
</usx>
