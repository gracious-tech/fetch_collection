<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CH" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  
  <para style="h">1 इतिहास</para>
  <para style="toc1">इतिहास के पहिला किताब</para>
  <para style="toc2">1 इतिहास</para>
  <para style="toc3">1 इति</para>
  <para style="mt1">इतिहास</para>
  <para style="mt2">के पहिला किताब</para>
  <chapter number="1" style="c" sid="1CH 1" />
  <para style="s1">आदम ले अब्राहम तक के बंसावली</para>
  <para style="s2">नूह के बेटामन तक</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 1:1" />आदम, सेत, एनोस,<verse eid="1CH 1:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 1:2" />केनान, महललेल, येरेद,<verse eid="1CH 1:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 1:3" />हनोक, मतूसेलह, लेमेक,</para>
  <para style="li1" vid="1CH 1:3">नूह।<verse eid="1CH 1:3" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="4" style="v" sid="1CH 1:4" />नूह के बेटामन: सेम, हाम अऊ येपेत।<verse eid="1CH 1:4" /></para>
  <para style="s2">येपेतीमन</para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 1:5" />येपेत के बेटामन:<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="fq" closed="false">बेटामन </char><char style="ft" closed="false">के मतलब </char><char style="fqa" closed="false">संतानमन </char><char style="ft" closed="false">हो सकथे</char></note></para>
  <para style="li2" vid="1CH 1:5">गोमेर, मागोग, मादै, यावान, तूबल, मेसेक अऊ तीरास।<verse eid="1CH 1:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 1:6" />गोमेर के बेटामन:</para>
  <para style="li2" vid="1CH 1:6">असकनज, रीपत अऊ तोगरमा।<verse eid="1CH 1:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 1:7" />यावान के बेटामन:</para>
  <para style="li2" vid="1CH 1:7">एलीसाह, तरसीस, कित्ती अऊ रोदानीमन।<verse eid="1CH 1:7" /></para>
  <para style="s2">हामीमन</para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 1:8" />हाम के बेटामन:</para>
  <para style="li2" vid="1CH 1:8">कूस, मिसर, पूत अऊ कनान।<verse eid="1CH 1:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 1:9" />कूस के बेटामन:</para>
  <para style="li2" vid="1CH 1:9">सबा, हवीला, सबता, रामा अऊ सबतका।</para>
  <para style="li1" vid="1CH 1:9">रामा के बेटामन:</para>
  <para style="li2" vid="1CH 1:9">सेबा अऊ ददान।<verse eid="1CH 1:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 1:10" />कूस ह निमरोद के ददा रिहिस;</para>
  <para style="li2" vid="1CH 1:10">निमरोद ह धरती म पहिला बड़े बीर होईस।<verse eid="1CH 1:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 1:11" />मिसर ह</para>
  <para style="li2" vid="1CH 1:11">लूदी, अनामी, लहाबी, नपतूही, <verse eid="1CH 1:11" /><verse number="12" style="v" sid="1CH 1:12" />पतरूसी, कसलूही (जेकर ले पलिस्तीमन आईन) अऊ कपतोरी मनखेमन के ददा रिहिस।<verse eid="1CH 1:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 1:13" />कनान के बड़े बेटा सीदोन रिहिस,</para>
  <para style="li2" vid="1CH 1:13">तेकर पाछू हित्ती, <verse eid="1CH 1:13" /><verse number="14" style="v" sid="1CH 1:14" />यबूसी, अमोरी, गिरगासी, <verse eid="1CH 1:14" /><verse number="15" style="v" sid="1CH 1:15" />हिब्बी, अरकी, सीनी, <verse eid="1CH 1:15" /><verse number="16" style="v" sid="1CH 1:16" />अरवदी, समारी, अऊ हमातीमन घलो होईन।<verse eid="1CH 1:16" /></para>
  <para style="s2">सेमीमन</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 1:17" />सेम के बेटामन:</para>
  <para style="li2" vid="1CH 1:17">एलाम, अस्सूर, अर्पछद, लूद अऊ अराम।</para>
  <para style="li1" vid="1CH 1:17">अराम के बेटामन:</para>
  <para style="li2" vid="1CH 1:17">ऊस, हूल, गेतेर अऊ मेसेक।<verse eid="1CH 1:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 1:18" />अर्पछद ह सेलह के ददा रिहिस,</para>
  <para style="li2" vid="1CH 1:18">अऊ सेलह ह एबेर के ददा रिहिस।<verse eid="1CH 1:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 1:19" />एबेर के दू झन बेटा होईन:</para>
  <para style="li2" vid="1CH 1:19">एक के नांव पेलेग<note caller="+" style="f"><char style="fr" closed="false">1:19 </char><char style="fq" closed="false">पेलेग </char><char style="ft" closed="false">के मतलब </char><char style="fqa" closed="false">बंटवारा</char></note> रखे गीस, काबरकि ओकर समय म धरती ह बंट गीस; ओकर भाई के नांव योकतान रिहिस।<verse eid="1CH 1:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 1:20" />योकतान ह</para>
  <para style="li2" vid="1CH 1:20">अलमोदाद, सेलेप, हसरमावेत, येरह <verse eid="1CH 1:20" /><verse number="21" style="v" sid="1CH 1:21" />हदोराम, ऊजाल, दिकला, <verse eid="1CH 1:21" /><verse number="22" style="v" sid="1CH 1:22" />ओबाल, अबीमाएल, सेबा, <verse eid="1CH 1:22" /><verse number="23" style="v" sid="1CH 1:23" />ओपीर हवीला अऊ योबाब के ददा रिहिस। ये जम्मो योकतान के बेटा रिहिन।<verse eid="1CH 1:23" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="24" style="v" sid="1CH 1:24" />सेम, अर्पछद, सेलह,<verse eid="1CH 1:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 1:25" />एबेर, पेलेग, रू,<verse eid="1CH 1:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 1:26" />सरूग, नाहोर, तेरह<verse eid="1CH 1:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 1:27" />अऊ अब्राम (जेह अब्राहम घलो कहाथे)।<verse eid="1CH 1:27" /></para>
  <para style="s1">अब्राहम के परिवार</para>
  <para style="lh">
    <verse number="28" style="v" sid="1CH 1:28" />अब्राहम के बेटामन: इसहाक अऊ इसमायल।<verse eid="1CH 1:28" /></para>
  <para style="s2">हाजिरा के बंस</para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 1:29" />ओमन के बंस येमन रिहिन:</para>
  <para style="li2" vid="1CH 1:29">इसमायल के बड़े बेटा नबायोत, तब केदार, अदबेल, मिबसाम, <verse eid="1CH 1:29" /><verse number="30" style="v" sid="1CH 1:30" />मिस्मा, दूमा, मस्सा, हदद, तेमा, <verse eid="1CH 1:30" /><verse number="31" style="v" sid="1CH 1:31" />यतूर, नापीस अऊ केदमा।</para>
  <para style="lf" vid="1CH 1:31">येमन इसमायल के बेटा रिहिन।<verse eid="1CH 1:31" /></para>
  <para style="s2">कतूरा के बंसज</para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 1:32" />अब्राहम के रखैल कतूरा के बेटामन:</para>
  <para style="li2" vid="1CH 1:32">जिमरान, योकसान, मदान, मिदयान, यिसबाक अऊ सूह।</para>
  <para style="li1" vid="1CH 1:32">योकसान के बेटामन:</para>
  <para style="li2" vid="1CH 1:32">सेबा अऊ ददान।<verse eid="1CH 1:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 1:33" />मिदयान के बेटामन:</para>
  <para style="li2" vid="1CH 1:33">एपा, एपेर, हनोक, अबीदा अऊ एलदा।</para>
  <para style="lf" vid="1CH 1:33">ये जम्मो कतूरा के बंसज रिहिन।<verse eid="1CH 1:33" /></para>
  <para style="s2">सारा के बंसज</para>
  <para style="lh">
    <verse number="34" style="v" sid="1CH 1:34" />अब्राहम ह इसहाक के ददा रिहिस।</para>
  <para style="li1" vid="1CH 1:34">इसहाक के बेटामन:</para>
  <para style="li2" vid="1CH 1:34">एसाव अऊ इसरायल।<verse eid="1CH 1:34" /></para>
  <para style="s1">एसाव के बेटामन</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 1:35" />एसाव के बेटामन:</para>
  <para style="li2" vid="1CH 1:35">एलीपज, रूएल, यूस, यालाम अऊ कोरह।<verse eid="1CH 1:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 1:36" />एलीपज के बेटामन:</para>
  <para style="li2" vid="1CH 1:36">तेमान, ओमार, सपो, गाताम अऊ कनज;</para>
  <para style="li2" vid="1CH 1:36">अऊ तिमना<note caller="+" style="f"><char style="fr" closed="false">1:36 </char><char style="ft" closed="false">एलीपज के रखैल</char></note> कोति ले अमालेक।<verse eid="1CH 1:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 1:37" />रूएल के बेटामन:</para>
  <para style="li2" vid="1CH 1:37">नहत, जेरह, सम्मा अऊ मिज्जा।<verse eid="1CH 1:37" /></para>
  <para style="s2">सेईर के मनखेमन एदोम म</para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 1:38" />सेईर के बेटामन:</para>
  <para style="li2" vid="1CH 1:38">लोतान, सोबाल, सिबोन, अना, दीसोन, एसेर अऊ दीसान।<verse eid="1CH 1:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 1:39" />लोतान के बेटामन:</para>
  <para style="li2" vid="1CH 1:39">होरी अऊ होमाम। तिमना ह लोतान के बहिनी रिहिस।<verse eid="1CH 1:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 1:40" />सोबाल के बेटामन:</para>
  <para style="li2" vid="1CH 1:40">आलवान, मानहत, एबाल, सपो अऊ ओनाम।</para>
  <para style="li1" vid="1CH 1:40">सिबोन के बेटामन:</para>
  <para style="li2" vid="1CH 1:40">अय्या अऊ अना।<verse eid="1CH 1:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 1:41" />अना के बेटा:</para>
  <para style="li2" vid="1CH 1:41">दीसोन।</para>
  <para style="li1" vid="1CH 1:41">दीसोन के बेटामन:</para>
  <para style="li2" vid="1CH 1:41">हेमदान,<note caller="+" style="f"><char style="fr" closed="false">1:41 </char><char style="ft" closed="false">कतको इबरानी हस्तलिपि म </char><char style="fqa" closed="false">हमरान</char></note> एसबान, यितरान अऊ करान।<verse eid="1CH 1:41" /></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 1:42" />एसेर के बेटामन:</para>
  <para style="li2" vid="1CH 1:42">बिलहान, जाबान अऊ अकान।</para>
  <para style="li1" vid="1CH 1:42">दीसान<note caller="+" style="f"><char style="fr" closed="false">1:42 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="GEN 36:28">उत 36:28</ref></char>; इबरानी म </char><char style="fqa" closed="false">दीसोन</char></note> के बेटामन:</para>
  <para style="li2" vid="1CH 1:42">ऊस अऊ अरान।<verse eid="1CH 1:42" /></para>
  <para style="s2">एदोम के सासन करइयामन</para>
  <para style="lh">
    <verse number="43" style="v" sid="1CH 1:43" />कोनो इसरायली राजा के एदोम म राज करे के पहिली येमन ओ राजा रिहिन, जेमन एदोम म राज करिन:</para>
  <para style="li1" vid="1CH 1:43">बेओर के बेटा बेला, जेकर सहर के नांव दिनहाबा रखे गीस।<verse eid="1CH 1:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 1:44" />बेला के मरे के बाद, ओकर जगह म बोसरा के रहइया जेरह के बेटा योबाब राजा बनिस।<verse eid="1CH 1:44" /></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 1:45" />योबाब के मरे के बाद, तेमानीमन के देस के हूसाम ओकर जगह म राजा होईस।<verse eid="1CH 1:45" /></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 1:46" />जब हूसाम ह मर गीस, त बदद के बेटा हदद ओकर जगह म राजा होईस: येह ओही अय, जऊन ह मोआब के देस म मिदयानीमन ला हराईस। ओकर सहर के नांव अबीत रखे गीस।<verse eid="1CH 1:46" /></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 1:47" />हदद के मरे के बाद, मसरेका नगर के रहइया समला ह ओकर जगह म राजा होईस।<verse eid="1CH 1:47" /></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 1:48" />जब समला ह मर गीस, त साऊल ह ओकर जगह म राजा होईस, जेह नदी<note caller="+" style="f"><char style="fr" closed="false">1:48 </char><char style="ft" closed="false">संभवतः फरात नदी</char></note> के तीर म बसे रहोबोत नगर के रिहिस।<verse eid="1CH 1:48" /></para>
  <para style="li1">
    <verse number="49" style="v" sid="1CH 1:49" />साऊल के मरे के बाद, अकबोर के बेटा बाल-हानान ओकर जगह म राजा होईस।<verse eid="1CH 1:49" /></para>
  <para style="li1">
    <verse number="50" style="v" sid="1CH 1:50" />बाल-हानान के मरे के बाद, ओकर जगह म हदद राजा होईस। ओकर सहर के नांव पाऊ रखे गीस, अऊ ओकर घरवाली के नांव महेतबेल रिहिस, जऊन ह मतरेद के बेटी अऊ मे-जाहब के नतनीन रिहिस। <verse eid="1CH 1:50" /><verse number="51" style="v" sid="1CH 1:51" />हदद घलो मर गीस।</para>
  <para style="b" vid="1CH 1:51" />
  <para style="lh" vid="1CH 1:51">एदोम के मुखियामन येमन रिहिन:</para>
  <para style="li1" vid="1CH 1:51">तिमना, अलबा, यतेत, <verse eid="1CH 1:51" /><verse number="52" style="v" sid="1CH 1:52" />ओहोलीबामा, एला, पीनोन, <verse eid="1CH 1:52" /><verse number="53" style="v" sid="1CH 1:53" />कनज, तेमान, मिबसार, <verse eid="1CH 1:53" /><verse number="54" style="v" sid="1CH 1:54" />मगदीएल अऊ ईराम।</para>
  <para style="lf" vid="1CH 1:54">येमन एदोम के मुखिया रिहिन।<verse eid="1CH 1:54" /></para>
  <chapter eid="1CH 1" />
  <chapter number="2" style="c" sid="1CH 2" />
  <para style="s1">इसरायल के बेटामन</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 2:1" />येमन इसरायल के बेटा रिहिन: रूबेन, सिमोन, लेवी, यहूदा, इस्साकार, जबूलून, <verse eid="1CH 2:1" /><verse number="2" style="v" sid="1CH 2:2" />दान, यूसुफ, बिनयामीन, नपताली, गाद अऊ आसेर।<verse eid="1CH 2:2" /></para>
  <para style="s1">यहूदा ले</para>
  <para style="s2">हेसरोन के बेटामन तक</para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 2:3" />यहूदा के बेटामन:</para>
  <para style="li2" vid="1CH 2:3">एर, ओनान, अऊ सेलह। ओकर ये तीनों बेटामन एक कनानी माईलोगन, जऊन ह सूआ के बेटी रिहिस, ओकर ले जनमे रिहिन।</para>
  <para style="li2" vid="1CH 2:3">(यहूदा के पहिलांत बेटा एर ह यहोवा के नजर म दुस्ट मनखे रिहिस, ये खातिर यहोवा ह ओला मार दीस।)<verse eid="1CH 2:3" /></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 2:4" />यहूदा के बहू तामार ह यहूदा कोति ले पेरेस अऊ जेरह ला जनम दीस।</para>
  <para style="lf" vid="1CH 2:4">ओकर कुल पांच झन बेटा होईन।<verse eid="1CH 2:4" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="5" style="v" sid="1CH 2:5" />पेरेस के बेटामन:</para>
  <para style="li2" vid="1CH 2:5">हेसरोन अऊ हामूल।<verse eid="1CH 2:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 2:6" />जेरह के बेटामन:</para>
  <para style="li2" vid="1CH 2:6">जिमरी, एतान, हेमान, कलकोल अऊ दारा। जम्मो मिलाके पांच झन बेटा रिहिन।<verse eid="1CH 2:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 2:7" />करमी के बेटा:</para>
  <para style="li2" vid="1CH 2:7">आकार,<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="fq" closed="false">आकार </char><char style="ft" closed="false">ला यहोसू के किताब म </char><char style="fqa" closed="false">आकान </char><char style="ft" closed="false">कहे गे हवय</char></note> येह अरपन करे गे चीज के बारे म बिसवासघात करके इसरायलीमन ला दुख देवइया होईस।<verse eid="1CH 2:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 2:8" />एतान के बेटा:</para>
  <para style="li2" vid="1CH 2:8">अजरयाह।<verse eid="1CH 2:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 2:9" />हेसरोन के बेटामन:</para>
  <para style="li2" vid="1CH 2:9">यरहमेल, राम अऊ कालेब।<verse eid="1CH 2:9" /></para>
  <para style="s2">हेसरोन ले जनमे राम के बेटा</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 2:10" />राम ह अमीनादाब के ददा रिहिस,</para>
  <para style="li1" vid="1CH 2:10">अऊ अम्मीनादाब ह नहसोन के ददा रिहिस, जऊन ह यहूदा के मनखेमन के मुखिया होईस।<verse eid="1CH 2:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 2:11" />नहसोन ह सलमोन के ददा रिहिस</para>
  <para style="li1" vid="1CH 2:11">अऊ सलमोन ह बोअज के ददा रिहिस,<verse eid="1CH 2:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 2:12" />बोअज ह ओबेद के ददा रिहिस</para>
  <para style="li1" vid="1CH 2:12">अऊ ओबेद ह यिसै के ददा रिहिस।<verse eid="1CH 2:12" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="13" style="v" sid="1CH 2:13" />यिसै के पहिलांत बेटा</para>
  <para style="li2" vid="1CH 2:13">एलीआब रिहिस; दूसर बेटा अबीनादाब रिहिस,</para>
  <para style="li2" vid="1CH 2:13">तीसरा बेटा सिमा, <verse eid="1CH 2:13" /><verse number="14" style="v" sid="1CH 2:14" />चौथा बेटा नतनेल,</para>
  <para style="li2" vid="1CH 2:14">पांचवां रदै, <verse eid="1CH 2:14" /><verse number="15" style="v" sid="1CH 2:15" />छठवां ओसेम</para>
  <para style="li2" vid="1CH 2:15">अऊ सातवां दाऊद रिहिस।<verse eid="1CH 2:15" /></para>
  <para style="li2">
    <verse number="16" style="v" sid="1CH 2:16" />ओमन के बहिनीमन सरूयाह अऊ अबीगैल रिहिन।</para>
  <para style="li3" vid="1CH 2:16">सरूयाह के तीन झन बेटा होईन: अबीसै, योआब अऊ असाहेल।<verse eid="1CH 2:16" /></para>
  <para style="li3">
    <verse number="17" style="v" sid="1CH 2:17" />अबीगैल ह अमासा के दाई रिहिस, जेकर ददा इसमायली येतेर रिहिस।<verse eid="1CH 2:17" /></para>
  <para style="s2">हेसरोन के बेटा कालेब</para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 2:18" />हेसरोन के बेटा कालेब के घरवाली अजूबा (अऊ यरीओत) ले ओकर बेटामन जनमे रिहिन, जेमन के नांव रिहिस:</para>
  <para style="li2" vid="1CH 2:18">येसेर, सोबाब अऊ अरदोन।<verse eid="1CH 2:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 2:19" />जब अजूबा मर गीस तब कालेब ह एपरात ले बिहाव करिस, जेकर ले हूर जनमिस।<verse eid="1CH 2:19" /></para>
  <para style="li2">
    <verse number="20" style="v" sid="1CH 2:20" />हूर ह ऊरी के ददा रिहिस अऊ ऊरी ह बसलेल के।<verse eid="1CH 2:20" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="21" style="v" sid="1CH 2:21" />बाद म, हेसरोन, अपन साठ बरस के उमर म गिलाद के ददा माकीर के बेटी ले बिहाव करिस, जेकर ले सगूब जनमिस।<verse eid="1CH 2:21" /></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 2:22" />सगूब ह याईर के ददा रिहिस जेकर गिलाद देस म तेईस ठन सहर रिहिस।<verse eid="1CH 2:22" /></para>
  <para style="li2">
    <verse number="23" style="v" sid="1CH 2:23" />(पर गसूर अऊ अराम, हव्वोत-याईर के बस्ती अऊ गांवमन के संगे-संग कनात ऊपर घलो कब्जा कर लीन, ये जम्मो साठ ठन सहर रिहिन।)</para>
  <para style="lf" vid="1CH 2:23">ये जम्मो गिलाद के ददा माकीर के संतान रिहिन।<verse eid="1CH 2:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 2:24" />कालेब-एपराता म हेसरोन के मरे के बाद, हेसरोन के घरवाली, अबियाह ह तकोआ के ददा असहूर ला जनम दीस।<verse eid="1CH 2:24" /></para>
  <para style="s2">हेसरोन के बेटा यरहमेल</para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 2:25" />हेसरोन के बड़े बेटा यरहमेल के बेटामन:</para>
  <para style="li2" vid="1CH 2:25">ओकर बड़े बेटा राम, बूना, ओरेन, ओसेम अऊ अहियाह। <verse eid="1CH 2:25" /><verse number="26" style="v" sid="1CH 2:26" />यरहमेल के एक झन अऊ घरवाली रिहिस, जेकर नांव अतारा रिहिस; ओह ओनाम के दाई रिहिस।<verse eid="1CH 2:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 2:27" />यरहमेल के बड़े बेटा राम के बेटामन:</para>
  <para style="li2" vid="1CH 2:27">मास, यामीन अऊ एकेर।<verse eid="1CH 2:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 2:28" />ओनाम के बेटामन:</para>
  <para style="li2" vid="1CH 2:28">सम्मै अऊ यादा।</para>
  <para style="li1" vid="1CH 2:28">सम्मै के बेटामन:</para>
  <para style="li2" vid="1CH 2:28">नादाब अऊ अबीसूर। <verse eid="1CH 2:28" /><verse number="29" style="v" sid="1CH 2:29" />अबीसूर के घरवाली के नांव अबीहैल रिहिस, जेकर ले अहबान अऊ मोलीद जनमिन।<verse eid="1CH 2:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 2:30" />नादाब के बेटामन:</para>
  <para style="li2" vid="1CH 2:30">सेलेद अऊ अप्पैम। सेलेद ह बिना कोनो लइका के मर गीस।<verse eid="1CH 2:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 2:31" />अप्पैम के बेटा:</para>
  <para style="li2" vid="1CH 2:31">यिसी जऊन ह सेसान के ददा रिहिस। सेसान ह अहलै के ददा रिहिस।<verse eid="1CH 2:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 2:32" />सम्मै के भाई यादा के बेटामन:</para>
  <para style="li2" vid="1CH 2:32">येतेर अऊ योनातन। येतेर बिगर संतान के मर गीस।<verse eid="1CH 2:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 2:33" />योनातन के बेटामन:</para>
  <para style="li2" vid="1CH 2:33">पेलेत अऊ जाजा।</para>
  <para style="lf" vid="1CH 2:33">येमन यरहमेल के संतान रिहिन।<verse eid="1CH 2:33" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="34" style="v" sid="1CH 2:34" />सेसान के कोनो बेटा नइं रिहिन, सिरिप बेटी रिहिन।</para>
  <para style="li2" vid="1CH 2:34">ओकर यरहा नांव के एक झन मिसरी सेवक रिहिस। <verse eid="1CH 2:34" /><verse number="35" style="v" sid="1CH 2:35" />सेसान ह अपन बेटी के बिहाव अपन सेवक यरहा के संग कर दीस, जेकर ले अत्तै जनमिस।<verse eid="1CH 2:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 2:36" />अत्तै ह नातान के ददा रिहिस,</para>
  <para style="li1" vid="1CH 2:36">नातान ह जाबाद के ददा रिहिस,<verse eid="1CH 2:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 2:37" />जाबाद ह एपलाल के ददा रिहिस,</para>
  <para style="li1" vid="1CH 2:37">एपलाल ह ओबेद के,<verse eid="1CH 2:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 2:38" />ओबेद ह येहू के,</para>
  <para style="li1" vid="1CH 2:38">येहू ह अजरयाह के,<verse eid="1CH 2:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 2:39" />अजरयाह ह हेलेस के,</para>
  <para style="li1" vid="1CH 2:39">हेलेस ह एलासा के<verse eid="1CH 2:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 2:40" />एलासा ह सिसमै के,</para>
  <para style="li1" vid="1CH 2:40">सिसमै ह सल्लूम के,<verse eid="1CH 2:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 2:41" />सल्लूम ह यकमयाह के,</para>
  <para style="li1" vid="1CH 2:41">यकमयाह ह एलीसामा के।<verse eid="1CH 2:41" /></para>
  <para style="s2">कालेब के बंस</para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 2:42" />यरहमेल के भाई कालेब के बेटामन:</para>
  <para style="li2" vid="1CH 2:42">ओकर बड़े बेटा मेसा, जऊन ह जीप के ददा रिहिस,</para>
  <para style="li2" vid="1CH 2:42">अऊ ओकर बेटा मारेसा जऊन ह हेबरोन के ददा रिहिस।<verse eid="1CH 2:42" /></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 2:43" />हेबरोन के बेटामन:</para>
  <para style="li2" vid="1CH 2:43">कोरह, तप्पूह, रेकेम अऊ सेमा।<verse eid="1CH 2:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 2:44" />सेमा ह रहम के ददा रिहिस,</para>
  <para style="li2" vid="1CH 2:44">अऊ रहम ह योरकाम के।</para>
  <para style="li1" vid="1CH 2:44">रेकेम ह सम्मै के ददा रिहिस।<verse eid="1CH 2:44" /></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 2:45" />सम्मै के बेटा माओन होईस</para>
  <para style="li2" vid="1CH 2:45">अऊ माओन ह बेत-सूर के ददा रिहिस।<verse eid="1CH 2:45" /></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 2:46" />कालेब के रखैल एपा ले</para>
  <para style="li2" vid="1CH 2:46">हारान, मोसा अऊ गाजेज जनमिन।</para>
  <para style="li2" vid="1CH 2:46">हारान ह गाजेज के ददा रिहिस।<verse eid="1CH 2:46" /></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 2:47" />याहदै के बेटामन:</para>
  <para style="li2" vid="1CH 2:47">रेगेम, योताम, गेसान, पेलेत, एपा अऊ साप।<verse eid="1CH 2:47" /></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 2:48" />कालेब के रखैल माका ह</para>
  <para style="li2" vid="1CH 2:48">सेबेर अऊ तिरहाना के दाई रिहिस।<verse eid="1CH 2:48" /></para>
  <para style="li2">
    <verse number="49" style="v" sid="1CH 2:49" />ओह मदमन्ना के ददा, साप ला</para>
  <para style="li2" vid="1CH 2:49">अऊ मकबेना अऊ गिबा के ददा, सेवा ला घलो जनम दीस।</para>
  <para style="li1" vid="1CH 2:49">कालेब के बेटी अकसा रिहिस।<verse eid="1CH 2:49" /></para>
  <para style="lf">
    <verse number="50" style="v" sid="1CH 2:50" />येमन कालेब के बंसज रिहिन।</para>
  <para style="b" vid="1CH 2:50" />
  <para style="li1" vid="1CH 2:50">एपराता के बड़े बेटा हूर के बेटामन:</para>
  <para style="li2" vid="1CH 2:50">किरयत-यारीम के ददा सोबाल, <verse eid="1CH 2:50" /><verse number="51" style="v" sid="1CH 2:51" />बैतलहम के ददा सलमा अऊ बेत-गादेर के ददा हारेप।<verse eid="1CH 2:51" /></para>
  <para style="li1">
    <verse number="52" style="v" sid="1CH 2:52" />किरयत-यारीम के ददा सोबाल के बंस म येमन रिहिन:</para>
  <para style="li2" vid="1CH 2:52">हारोएह, आधा मनुहोतीमन, <verse eid="1CH 2:52" /><verse number="53" style="v" sid="1CH 2:53" />अऊ किरयत-यारीम के कुल: येतेरी, पूती, सूमाती अऊ मिसराई। येमन ले सोराती अऊ एसताओली निकलिन।<verse eid="1CH 2:53" /></para>
  <para style="li1">
    <verse number="54" style="v" sid="1CH 2:54" />सलमा के बंसज:</para>
  <para style="li2" vid="1CH 2:54">बैतलहम, नतोपाती, अतरोत-बेत-योआब, आधा मानहतीमन, सोरी, <verse eid="1CH 2:54" /><verse number="55" style="v" sid="1CH 2:55" />अऊ याबेस नगर म रहइया लेखकमन के कुल: तिराती, सिमाती, अऊ सूकाती। येमन केनी अंय, जेमन रेकाब के परिवार के मूल पुरूस हम्मत के बंस म ले आईन।<verse eid="1CH 2:55" /></para>
  <chapter eid="1CH 2" />
  <chapter number="3" style="c" sid="1CH 3" />
  <para style="s2">दाऊद के बेटामन</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 3:1" />दाऊद के बेटा, जेमन ओकर ले हेबरोन नगर म जनमिन:</para>
  <para style="b" vid="1CH 3:1" />
  <para style="li1" vid="1CH 3:1">ओकर पहिलांत बेटा अमनोन रिहिस, जऊन ह यिजरेल सहर के अहीनोअम ले जनमे रिहिस;</para>
  <para style="li1" vid="1CH 3:1">दूसर बेटा दानिएल जऊन ह करमेल नगर के अबीगैल ले जनमे रिहिस;<verse eid="1CH 3:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 3:2" />तीसर, अबसालोम, गसूर के राजा तलमै के बेटी माका के बेटा;</para>
  <para style="li1" vid="1CH 3:2">चौथा अदोनियाह, हगीत के बेटा;<verse eid="1CH 3:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 3:3" />पांचवां सपतयाह, अबीतल के बेटा;</para>
  <para style="li1" vid="1CH 3:3">अऊ छठवां यितराम, जऊन ह ओकर एगला नांव के घरवाली ले जनमे रिहिस।<verse eid="1CH 3:3" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="4" style="v" sid="1CH 3:4" />दाऊद के ये छै बेटा हेबरोन म जनमे रिहिन, जिहां ओह सात बरस अऊ छै महिना राज करिस।</para>
  <para style="b" vid="1CH 3:4" />
  <para style="b" vid="1CH 3:4" />
  <para style="lh" vid="1CH 3:4">दाऊद ह यरूसलेम म तैंतीस बरस राज करिस, <verse eid="1CH 3:4" /><verse number="5" style="v" sid="1CH 3:5" />अऊ येमन ओ लइकामन के नांव अंय, जेमन उहां ओकर ले जनमिन:</para>
  <para style="b" vid="1CH 3:5" />
  <para style="li1" vid="1CH 3:5">सम्मू<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">सिमा</char></note>, सोबाब, नातान अऊ सुलेमान। ये चारों अमीएल के बेटी बतसेबा ले जनमिन।<verse eid="1CH 3:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 3:6" />अऊ यिभार, एलीसू,<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="ft" closed="false">जादा इबरानी हस्तलिपि म </char><char style="fqa" closed="false">एलीसामा</char></note> एलीपेलेत, <verse eid="1CH 3:6" /><verse number="7" style="v" sid="1CH 3:7" />नोगह, नेपेग, यापी, <verse eid="1CH 3:7" /><verse number="8" style="v" sid="1CH 3:8" />एलीसामा, एलयादा अऊ एलीपेलेत—ये जम्मो नौ झन बेटा।<verse eid="1CH 3:8" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="9" style="v" sid="1CH 3:9" />ये जम्मो दाऊद के बेटा रिहिन, येमन ला छोंड़के ओकर रखैलमन ले घलो बेटा होईन। येमन के बहिनी तामार रिहिस।<verse eid="1CH 3:9" /></para>
  <para style="s2">यहूदा के राजामन</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 3:10" />सुलेमान के बेटा रहूबियाम रिहिस,</para>
  <para style="li1" vid="1CH 3:10">ओकर बेटा अबियाह,</para>
  <para style="li1" vid="1CH 3:10">ओकर ले आसा,</para>
  <para style="li1" vid="1CH 3:10">ओकर ले यहोसापात,<verse eid="1CH 3:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 3:11" />ओकर ले यहोराम,<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">योराम</char></note></para>
  <para style="li1" vid="1CH 3:11">ओकर ले अहजयाह,</para>
  <para style="li1" vid="1CH 3:11">ओकर ले योआस,<verse eid="1CH 3:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 3:12" />ओकर ले अमसयाह,</para>
  <para style="li1" vid="1CH 3:12">ओकर ले अजरयाह,</para>
  <para style="li1" vid="1CH 3:12">ओकर ले योताम,<verse eid="1CH 3:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 3:13" />ओकर ले आहाज,</para>
  <para style="li1" vid="1CH 3:13">ओकर ले हिजकियाह,</para>
  <para style="li1" vid="1CH 3:13">ओकर ले मनस्से,<verse eid="1CH 3:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 3:14" />ओकर ले आमोन</para>
  <para style="li1" vid="1CH 3:14">अऊ ओकर ले योसियाह जनमिस।<verse eid="1CH 3:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 3:15" />योसियाह के बेटामन:</para>
  <para style="li2" vid="1CH 3:15">ओकर पहिलांत बेटा योहानान,</para>
  <para style="li2" vid="1CH 3:15">दूसर बेटा यहोयाकीम,</para>
  <para style="li2" vid="1CH 3:15">तीसर बेटा सिदकियाह,</para>
  <para style="li2" vid="1CH 3:15">चौथा सल्लूम।<verse eid="1CH 3:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 3:16" />यहोयाकीम के बेटा</para>
  <para style="li2" vid="1CH 3:16">यहोयाकीन<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">यकुन्याह</char><char style="ft" closed="false">; <char style="xt" link-href="1CH 3:17"><ref loc="1CH 3:17">पद 17</ref></char> म घलो</char></note>,</para>
  <para style="li2" vid="1CH 3:16">ओकर बेटा सिदकियाह।<verse eid="1CH 3:16" /></para>
  <para style="s2">बंधुवई के बाद राज-परिवार</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 3:17" />यहोयाकीन जऊन ह बंदी रिहिस, ओकर संतान:</para>
  <para style="li2" vid="1CH 3:17">सालतीएल, <verse eid="1CH 3:17" /><verse number="18" style="v" sid="1CH 3:18" />मलकीराम, पदायाह, सेनसर, यकमयाह, होसामा अऊ नदबयाह।<verse eid="1CH 3:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 3:19" />पदायाह के बेटामन:</para>
  <para style="li2" vid="1CH 3:19">जरूब्बाबेल अऊ सिमी।</para>
  <para style="li1" vid="1CH 3:19">जरूब्बाबेल के बेटामन:</para>
  <para style="li2" vid="1CH 3:19">मसुल्लाम अऊ हननयाह। सलोमीत ह ओमन के बहिनी रिहिस। <verse eid="1CH 3:19" /><verse number="20" style="v" sid="1CH 3:20" />अऊ आने पांच झन घलो रिहिन: हसूबा, ओहेल, बेरेकियाह, हसदियाह अऊ यूसब-हेसेद।<verse eid="1CH 3:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 3:21" />हननयाह के संतान:</para>
  <para style="li2" vid="1CH 3:21">पलतयाह अऊ येसायाह, अऊ रपायाह के बेटामन, अरनान के बेटामन, ओबदयाह के बेटामन अऊ सेकनयाह के बेटामन।<verse eid="1CH 3:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 3:22" />सेकनयाह के संतान:</para>
  <para style="li2" vid="1CH 3:22">समायाह अऊ ओकर बेटामन: हतूस, इगाल, बारीह, नारयाह अऊ सापात—ये जम्मो छै झन।<verse eid="1CH 3:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 3:23" />नारयाह के बेटामन:</para>
  <para style="li2" vid="1CH 3:23">एलयोएनै, हिजकियाह अऊ अजरीकाम—जम्मो तीन झन।<verse eid="1CH 3:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 3:24" />एलयोएनै के बेटामन:</para>
  <para style="li2" vid="1CH 3:24">होदवियाह, एलियासीब, पलायाह, अक्कूब, योहानान, दलायाह अऊ अनानी—जम्मो सात झन।<verse eid="1CH 3:24" /></para>
  <chapter eid="1CH 3" />
  <chapter number="4" style="c" sid="1CH 4" />
  <para style="s2">यहूदा के आने कुल</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 4:1" />यहूदा के संतान:</para>
  <para style="li2" vid="1CH 4:1">पेरेस, हेसरोन, करमी, हूर अऊ सोबाल।<verse eid="1CH 4:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 4:2" />सोबाल के बेटा रायाह ले यहत, अऊ यहत ले अहूमै अऊ लहद जनमिन। येमन सोराती बंस के अंय।<verse eid="1CH 4:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 4:3" />येमन एताम के बेटा रिहिन:</para>
  <para style="li2" vid="1CH 4:3">यिजरेल, यिस्मा, अऊ यिद्बास। येमन के बहिनी के नांव हस्सलेलपोनी रिहिस। <verse eid="1CH 4:3" /><verse number="4" style="v" sid="1CH 4:4" />गदोर के ददा पनूएल, अऊ हूसा के ददा एजेर रिहिस।</para>
  <para style="li1" vid="1CH 4:4">येमन एपराता के बेटा हूर के संतान अंय जऊन ह बैतलहम के ददा रिहिस।<verse eid="1CH 4:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 4:5" />तकोआ के ददा असहूर के हेला अऊ नारा नांव के दू झन घरवाली रिहिन।<verse eid="1CH 4:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 4:6" />नारा ले अहुज्जाम, हेपेर, तेमनी अऊ हाहसतारी जनमिन। येमन नारा के बेटा रिहिन।<verse eid="1CH 4:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 4:7" />हेला के बेटामन:</para>
  <para style="li2" vid="1CH 4:7">सेरेत, सोहर, एतनान। <verse eid="1CH 4:7" /><verse number="8" style="v" sid="1CH 4:8" />अऊ कोस ले आनूब अऊ हस्सोबेबा जनमिन अऊ ओकर बंस म हारूम के बेटा अहरहेल के कुल भी जनमिन।<verse eid="1CH 4:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="1CH 4:9" />याबेस ह अपन भाईमन ले जादा नामी होईस। ओकर दाई ह ये कारन ले ओकर नांव याबेस राखिस, “मेंह येला दुख-पीरा ले जनमाय हंव।” <verse eid="1CH 4:9" /><verse number="10" style="v" sid="1CH 4:10" />याबेस ह इसरायल के परमेसर ला गोहार लगाईस, “बने होतिस कि तें मोला सही म आसीस देते अऊ मोर इलाका ला बढ़ाते अऊ तोर हांथ मोर संग रहितिस अऊ तें मोला हानि ले अइसन बचाते कि मेंह पीरा ले बांचे रहितंय।” अऊ परमेसर ह ओकर बिनती ला सुनिस।<verse eid="1CH 4:10" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="11" style="v" sid="1CH 4:11" />फेर सूहा के भाई कलूब ले एसतोन के ददा महीर जनमिस। <verse eid="1CH 4:11" /><verse number="12" style="v" sid="1CH 4:12" />एसतोन ह बेत-रापा, पासेह अऊ तहिन्ना के ददा रिहिस अऊ तहिन्ना ह ईर-नाहास के ददा रिहिस। येमन रेका नगर के मनखेमन रिहिन।<verse eid="1CH 4:12" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="13" style="v" sid="1CH 4:13" />कनज के बेटामन:</para>
  <para style="li2" vid="1CH 4:13">ओतनीएल अऊ सरायाह।</para>
  <para style="li1" vid="1CH 4:13">ओतनीएल के बेटामन:</para>
  <para style="li2" vid="1CH 4:13">हतत अऊ मोनोतै। <verse eid="1CH 4:13" /><verse number="14" style="v" sid="1CH 4:14" />मोनोतै ह ओपरा के ददा रिहिस।</para>
  <para style="li1" vid="1CH 4:14">सरायाह ले योआब जनमिस,</para>
  <para style="li2" vid="1CH 4:14">जऊन ह गे-हरासीम<note caller="+" style="f"><char style="fr" closed="false">4:14 </char><char style="fq" closed="false">गे-हरासीम </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">कुसल कारीगरमन के घाटी</char></note> के ददा रिहिस; येमन कारीगर रिहिन।<verse eid="1CH 4:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 4:15" />यपुन्ने के बेटा कालेब के बेटामन:</para>
  <para style="li2" vid="1CH 4:15">इरू, एला अऊ नाम।</para>
  <para style="li1" vid="1CH 4:15">एला के बेटा:</para>
  <para style="li2" vid="1CH 4:15">कनज।<verse eid="1CH 4:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 4:16" />यहल्लेलेल के बेटामन:</para>
  <para style="li2" vid="1CH 4:16">जीप, जीपा, तीरया अऊ असरेल।<verse eid="1CH 4:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 4:17" />एजरा के बेटामन:</para>
  <para style="li2" vid="1CH 4:17">येतेर, मेरेद, एपेर अऊ यालोन।</para>
  <para style="li1" vid="1CH 4:17">ओकर घरवाली ले मिरियम, सम्मै अऊ एसतमोआ के ददा यिसबह जनमिन। <verse eid="1CH 4:17" /><verse number="18" style="v" sid="1CH 4:18" />येमन फिरौन के बेटी बित्या के संतान रिहिन, जेला मेरेद ह बिहाव करे रिहिस।</para>
  <para style="li1" vid="1CH 4:18">ओकर यहूदीन घरवाली ले गदोर के ददा येरेद, सोको के ददा हेबेर अऊ जानोह के ददा यकुतिएल जनमिन।<verse eid="1CH 4:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 4:19" />होदियाह के घरवाली जऊन ह नहम के बहिनी रिहिस, ओकर बेटामन:</para>
  <para style="li2" vid="1CH 4:19">गेरेमी कीला के ददा, अऊ माकाती एसतमोआ<verse eid="1CH 4:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 4:20" />सीमोन के बेटामन:</para>
  <para style="li2" vid="1CH 4:20">अमनोन, रिन्ना, बेन-हानान अऊ तोलोन।</para>
  <para style="li1" vid="1CH 4:20">यिसी के संतान:</para>
  <para style="li2" vid="1CH 4:20">जोहेत अऊ बेन-जोहेत।<verse eid="1CH 4:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 4:21" />यहूदा के बेटा सेलह के संतान:</para>
  <para style="li2" vid="1CH 4:21">लेका के ददा एर, मारेसा के ददा लादा, अऊ बेत-असबे ले ओकर परिवार के बंसज जेमन मलमल के कपड़ा बनाय के बुता करंय।<verse eid="1CH 4:21" /></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 4:22" />योकीम अऊ कोजबा के मनखे अऊ योआस अऊ साराप जऊन मन मोआब म सासन करंय, अऊ यासुबी-लेहेम। (ये लेखा-जोखा पुराना जमाना के अय।) <verse eid="1CH 4:22" /><verse number="23" style="v" sid="1CH 4:23" />येमन कुम्हार रिहिन अऊ येमन नताईम अऊ गदेरा नगर म रहत रिहिन; येमन उहां रूकंय अऊ राजा बर काम करंय।<verse eid="1CH 4:23" /></para>
  <para style="s1">सिमोन</para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 4:24" />सिमोन के संतान:</para>
  <para style="li2" vid="1CH 4:24">नमूएल, यामीन, यारीब, जेरह अऊ साऊल;<verse eid="1CH 4:24" /></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 4:25" />साऊल के बेटा सल्लूम, सल्लूम के बेटा मिबसाम अऊ मिबसाम ले मिस्मा होईस।<verse eid="1CH 4:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 4:26" />मिस्मा के संतान:</para>
  <para style="li2" vid="1CH 4:26">हम्मूएल ओकर बेटा, जक्कूर ओकर बेटा, अऊ सिमी ओकर बेटा।<verse eid="1CH 4:26" /></para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" sid="1CH 4:27" />सिमी के सोलह झन बेटा अऊ छै बेटी रिहिन, लेकिन ओकर भाईमन के बहुंत लइका नइं रिहिन; एकरसेति ओकर कुल ह यहूदा के कुल असन नइं बाढ़िस। <verse eid="1CH 4:27" /><verse number="28" style="v" sid="1CH 4:28" />ओमन बेरसेबा, मोलादा, हसर-सूआल, <verse eid="1CH 4:28" /><verse number="29" style="v" sid="1CH 4:29" />बिलहा, एसेम, तोलाद, <verse eid="1CH 4:29" /><verse number="30" style="v" sid="1CH 4:30" />बतूएल, होरमा, सिकलग, <verse eid="1CH 4:30" /><verse number="31" style="v" sid="1CH 4:31" />बेत-मरकाबोत, हसर-सूसीम, बेत-बिरी अऊ सारैम म बस गीन। दाऊद के राज के समय तक येमन ओमन के नगर रिहिन। <verse eid="1CH 4:31" /><verse number="32" style="v" sid="1CH 4:32" />ओमन के गांव एताम, ऐन, रिम्मोन, तोकेन अऊ आसान नांव के पांच ठन नगर <verse eid="1CH 4:32" /><verse number="33" style="v" sid="1CH 4:33" />अऊ बालात<note caller="+" style="f"><char style="fr" closed="false">4:33 </char><char style="ft" closed="false">कुछू सेप्टाजिन्ट हस्तलिपि म (देखव <char style="xt"><ref loc="JOS 19:8">यहो 19:8</ref></char>); इबरानी म </char><char style="fqa" closed="false">बाल</char></note> तक ये नगरमन के आसपास के जम्मो गांव। ओमन के बसे के जगह येमन रिहिन।</para>
  <para style="b" vid="1CH 4:33" />
  <para style="lh" vid="1CH 4:33">अऊ ओमन बंसावली के लेखा-जोखा रखिन।<verse eid="1CH 4:33" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="34" style="v" sid="1CH 4:34" />मेसोबाब, यमलेक,</para>
  <para style="li1" vid="1CH 4:34">अमसयाह के बेटा योसा, <verse eid="1CH 4:34" /><verse number="35" style="v" sid="1CH 4:35" />योएल,</para>
  <para style="li1" vid="1CH 4:35">योसिब्याह के बेटा येहू, जऊन ह सरायाह के पोता अऊ असीएल के परपोता रिहिस,<verse eid="1CH 4:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 4:36" />अऊ एलयोएनै, अऊ याकोबा, यसोहायाह,</para>
  <para style="li1" vid="1CH 4:36">अऊ असायाह, अऊ अदीएल, अऊ यसीमीएल, अऊ बनायाह,<verse eid="1CH 4:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 4:37" />अऊ सिपी के बेटा जीजा, जऊन ह अल्लोन के बेटा, ओह यदायाह के बेटा, ओह सिमरी के बेटा, ओह समायाह के बेटा रिहिस।<verse eid="1CH 4:37" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="38" style="v" sid="1CH 4:38" />जऊन आदमीमन के नांव ऊपर लिखे गे हवय, ओमन अपन-अपन कुल के मुखिया रिहिन।</para>
  <para style="b" vid="1CH 4:38" />
  <para style="p" vid="1CH 4:38">अऊ ओमन के परिवारमन बहुंत बाढ़िस, <verse eid="1CH 4:38" /><verse number="39" style="v" sid="1CH 4:39" />अऊ येमन अपन भेड़-बकरीमन बर चरागन खोजे बर गदोर सहर के सीमना म घाटी के पूरब कोति तक गीन। <verse eid="1CH 4:39" /><verse number="40" style="v" sid="1CH 4:40" />अऊ ओमन बने-बने चरागन पाईन अऊ ओ देस ह लम्बा-चौड़ा, सांतिमय अऊ सांत रिहिस। पहिले उहां हाम के बंस के कुछू मनखेमन रहत रिहिन।<verse eid="1CH 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1CH 4:41" />जऊन आदमीमन के नांव ह सूची म लिखे गे रिहिस, ओमन यहूदा के राजा हिजकियाह के समय म आईन। ओमन हामीमन के निवास ऊपर अऊ उहां रहइया मूनीमन ऊपर घलो हमला कर दीन अऊ ओमन ला पूरा नास कर दीन, जेकर सबूत आज तक देखे जा सकत हे। तब ओमन ओमन के जगह म बस गीन काबरकि उहां ओमन के पसुमन बर चरागन रिहिस। <verse eid="1CH 4:41" /><verse number="42" style="v" sid="1CH 4:42" />अऊ ये सिमोनीमन के पांच सौ मनखे पलतयाह, नारयाह, रपायाह अऊ उजीएल नांव के यिसी के बेटामन के अगुवई म सेईर के पहाड़ी देस ऊपर हमला कर दीन। <verse eid="1CH 4:42" /><verse number="43" style="v" sid="1CH 4:43" />ओमन ओ अमालेकीमन ला मार डारिन, जेमन बांचके भाग गे रिहिन, अऊ ओमन आज तक उहां रहत हवंय।<verse eid="1CH 4:43" /></para>
  <chapter eid="1CH 4" />
  <chapter number="5" style="c" sid="1CH 5" />
  <para style="s1">रूबेन</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 5:1" />इसरायल के पहिलांत रूबेन के बेटामन (ओह पहिलांत रिहिस, पर जब ओह अपन ददा के बिछौना ला असुध करिस, त ओकर पहिलांत के अधिकार ला इसरायल के बेटा यूसुफ के बेटामन ला देय गीस; एकरसेति रूबेन के नांव ला ओकर जनम के अधिकार के मुताबिक बंसावली के लेखा-जोखा म नइं लिखे गीस, <verse eid="1CH 5:1" /><verse number="2" style="v" sid="1CH 5:2" />अऊ अपन भाईमन ले यहूदा के नांव ह सबले जादा मजबूती से चलिस अऊ ओकर ले एक सासन करइया निकलके आईस, पर पहिलांत के अधिकार यूसुफ ह पाईस)। <verse eid="1CH 5:2" /><verse number="3" style="v" sid="1CH 5:3" />इसरायल के पहिलांत रूबेन के बेटामन:</para>
  <para style="b" vid="1CH 5:3" />
  <para style="li2" vid="1CH 5:3">हनोक, पल्लू, हेसरोन अऊ करमी।<verse eid="1CH 5:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 5:4" />योएल के संतान:</para>
  <para style="li2" vid="1CH 5:4">योएल के बेटा समायाह, समायाह के बेटा गोग,</para>
  <para style="li2" vid="1CH 5:4">गोग के बेटा सिमी, <verse eid="1CH 5:4" /><verse number="5" style="v" sid="1CH 5:5" />सिमी के बेटा मीका,</para>
  <para style="li2" vid="1CH 5:5">मीका के बेटा रायाह, रायाह के बेटा बाल,<verse eid="1CH 5:5" /></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 5:6" />अऊ बाल के बेटा बेरा, जऊन ला अस्सूर के राजा तिगलत-पिलेसेर बंदी बनाके ले गीस। बेरा ह रूबेनीमन के एक अगुवा रिहिस।<verse eid="1CH 5:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 5:7" />ओमन के रिस्तेदारमन के नांव ओमन के कुल के मुताबिक बंसावली के सूची म लिखे गीस:</para>
  <para style="li2" vid="1CH 5:7">ओमन के मुखिया येइल, फेर जकरयाह, <verse eid="1CH 5:7" /><verse number="8" style="v" sid="1CH 5:8" />अऊ अजाज के बेटा बेला, जऊन ह सेमा के पोता अऊ योएल के परपोता रिहिस।</para>
  <para style="b" vid="1CH 5:8" />
  <para style="p" vid="1CH 5:8">ओमन अरोएर नगर ले लेके नबो पहाड़ अऊ बाल-मेओन सहर के छेत्र म बस गीन। <verse eid="1CH 5:8" /><verse number="9" style="v" sid="1CH 5:9" />पूरब कोति ओमन ओ निरजन जगह के किनारे तक के भुइयां ऊपर कब्जा कर लीन, जऊन ह फरात नदी तक फईले हवय, काबरकि ओमन के पसुमन के संखिया गिलाद देस म बाढ़ गे रिहिस।<verse eid="1CH 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 5:10" />साऊल के राज के समय म ओमन हगरीमन ले लड़ई करिन अऊ हगरीमन ओमन ले हार गीन; तब ओमन गिलाद के जम्मो पूरबी भाग के इलाका म हगरीमन के निवासमन ऊपर अधिकार कर लीन।<verse eid="1CH 5:10" /></para>
  <para style="s1">गाद</para>
  <para style="lh">
    <verse number="11" style="v" sid="1CH 5:11" />गादीमन ओमन के बाद सलका नगर तक बासान के इलाका म रहत रिहिन।<verse eid="1CH 5:11" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="12" style="v" sid="1CH 5:12" />योएल तो मुखिया रिहिस, अऊ दूसरा सापाम, तब यानै अऊ सापात, येमन बासान म रहंय।<verse eid="1CH 5:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 5:13" />परिवारमन के मुताबिक ओमन के रिस्तेदारमन:</para>
  <para style="li2" vid="1CH 5:13">मिकाएल, मसुल्लाम, सेबा, योरै, याकान, जिया अऊ एबेर—कुल सात झन।<verse eid="1CH 5:13" /></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 5:14" />येमन अबीहैल के बेटा रिहिन जऊन ह हूरी के बेटा रिहिस, हूरी ह योराह के बेटा, योराह ह गिलाद के बेटा, गिलाद ह मिकाएल के बेटा, मिकाएल ह यसीसै के बेटा, यसीसै ह यहदो के बेटा, यहदो ह बूज के बेटा रिहिस।<verse eid="1CH 5:14" /></para>
  <para style="li2">
    <verse number="15" style="v" sid="1CH 5:15" />येमन के परिवार के मुखिया अही रिहिस, जऊन ह अब्दीएल के बेटा अऊ गूनी के पोता रिहिस।<verse eid="1CH 5:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="1CH 5:16" />गादीमन बासान के गिलाद अऊ ओकर बाहिर म फईले गांवमन म, अऊ सारोन के जम्मो चरागनमन म रहत रिहिन, जऊन ह दूरिहा तक फईले रिहिस।<verse eid="1CH 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 5:17" />ये जम्मो के नांव बंसावली म यहूदा के राजा योताम अऊ इसरायल के राजा यरोबाम के सासनकाल म लिखे गीस।<verse eid="1CH 5:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="1CH 5:18" />रूबेनी, गादी, अऊ मनस्से के आधा गोत्र के 44,760 आदमीमन सेना म सेवा देय बर तियार रिहिन—येमन ढाल अऊ तलवार अऊ तीर चलाय म माहिर रिहिन, अऊ येमन लड़ई के सिकछा लेय रिहिन। <verse eid="1CH 5:18" /><verse number="19" style="v" sid="1CH 5:19" />ओमन हगरी, यतूर, नापीस अऊ नोदाब के बिरूध लड़ई करिन। <verse eid="1CH 5:19" /><verse number="20" style="v" sid="1CH 5:20" />ओमन के बिरूध लड़ई म येमन ला मदद मिले रिहिस अऊ परमेसर ह हगरीमन अऊ ओमन के जम्मो संगी सेना ला येमन के हांथ म कर दीस, काबरकि लड़ई के बेरा येमन परमेसर ला गोहारिन। अऊ ओह ओमन के पराथना ला सुनिस, काबरकि येमन ओकर ऊपर भरोसा रखिन। <verse eid="1CH 5:20" /><verse number="21" style="v" sid="1CH 5:21" />येमन हगरीमन के पसुमन ला छीन लीन—जेमा पचास हजार ऊंट, दू लाख पचास हजार भेड़, अऊ दू हजार गदहामन रिहिन। येमन एक लाख मनखेमन ला घलो बंदी बनाके ले गीन, <verse eid="1CH 5:21" /><verse number="22" style="v" sid="1CH 5:22" />अऊ आने बहुंते झन मारे गीन, काबरकि येह परमेसर के लड़ई रिहिस। येमन ओ जगह म बंधुवई के समय तक कब्जा बनाय रखिन।<verse eid="1CH 5:22" /></para>
  <para style="s1">मनस्से के आधा गोत्र</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23" />मनस्से के आधा गोत्र के मनखेमन के संखिया बहुंत रिहिस; ओमन ओ देस म बासान ले लेके बाल-हेरमोन तक बस गीन; बाल-हेरमोन ला सनीर (हेरमोन पहाड़) कहे जाथे।<verse eid="1CH 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 5:24" />ओमन के परिवारमन के मुखिया येमन रिहिन: एपेर, यिसी, एलीएल, अजरीएल, यरमियाह, होदवियाह अऊ यहदीएल। येमन बड़े बीर अऊ नामी मनखे अऊ अपन परिवारमन के मुखिया रिहिन। <verse eid="1CH 5:24" /><verse number="25" style="v" sid="1CH 5:25" />पर ओमन अपन पुरखामन के परमेसर ले बिसवासघात करिन अऊ ओ देस के ओ मनखेमन के देवतामन के पूजा करे के दुवारा अपनआप ले बेभिचार करिन, जेमन ला परमेसर ह ओमन के आघू ले नास कर देय रिहिस। <verse eid="1CH 5:25" /><verse number="26" style="v" sid="1CH 5:26" />एकरसेति इसरायल के परमेसर ह अस्सूर के राजा पूल (जेला अस्सूर के राजा तिगलत-पिलेसेर कहे जाथे) के मन ला उभारिस, जऊन ह रूबेनी, गादी, अऊ मनस्से के आधा गोत्र के मनखेमन ला बंधुवई म ले गीस। ओह ओमन ला हलह, हाबोर, हारा अऊ गोजान नदी करा ले गीस, जिहां ओमन आज तक हवंय।<verse eid="1CH 5:26" /></para>
  <chapter eid="1CH 5" />
  <chapter number="6" style="c" sid="1CH 6" />
  <para style="s1">लेवी</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 6:1" />लेवी के बेटामन:</para>
  <para style="li2" vid="1CH 6:1">गेरसोन, कहात अऊ मरारी।<verse eid="1CH 6:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 6:2" />कहात के बेटामन:</para>
  <para style="li2" vid="1CH 6:2">अमराम, ईसहार, हेबरोन अऊ उजीएल।<verse eid="1CH 6:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 6:3" />अमराम के संतान:</para>
  <para style="li2" vid="1CH 6:3">हारून, मूसा अऊ मिरियम।</para>
  <para style="li1" vid="1CH 6:3">हारून के बेटामन:</para>
  <para style="li2" vid="1CH 6:3">नादाब, अबीहू, एलिआजर अऊ ईतामार।<verse eid="1CH 6:3" /></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 6:4" />एलिआजर ह पीनहास के ददा रिहिस,</para>
  <para style="li2" vid="1CH 6:4">पीनहास ह अबीसू के ददा,<verse eid="1CH 6:4" /></para>
  <para style="li2">
    <verse number="5" style="v" sid="1CH 6:5" />अबीसू ह बुक्की के ददा,</para>
  <para style="li2" vid="1CH 6:5">बुक्की ह उज्जी के ददा,<verse eid="1CH 6:5" /></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 6:6" />उज्जी ह जरहयाह के ददा,</para>
  <para style="li2" vid="1CH 6:6">जरहयाह ह मरायोत के ददा,<verse eid="1CH 6:6" /></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 6:7" />मरायोत ह अमरयाह के ददा,</para>
  <para style="li2" vid="1CH 6:7">अमरयाह ह अहीतूब के ददा,<verse eid="1CH 6:7" /></para>
  <para style="li2">
    <verse number="8" style="v" sid="1CH 6:8" />अहीतूब ह सादोक के ददा,</para>
  <para style="li2" vid="1CH 6:8">सादोक ह अहीमास के ददा,<verse eid="1CH 6:8" /></para>
  <para style="li2">
    <verse number="9" style="v" sid="1CH 6:9" />अहीमास ह अजरयाह के ददा,</para>
  <para style="li2" vid="1CH 6:9">अजरयाह ह योहानान के ददा,<verse eid="1CH 6:9" /></para>
  <para style="li2">
    <verse number="10" style="v" sid="1CH 6:10" />योहानान ह अजरयाह के ददा</para>
  <para style="li2" vid="1CH 6:10">जऊन ह सुलेमान के यरूसलेम म बनाय गे भवन म पुरोहित के काम करय,<verse eid="1CH 6:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 6:11" />अजरयाह ह अमरयाह के ददा,</para>
  <para style="li2" vid="1CH 6:11">अमरयाह ह अहीतूब के ददा,<verse eid="1CH 6:11" /></para>
  <para style="li2">
    <verse number="12" style="v" sid="1CH 6:12" />अहीतूब ह सादोक के ददा,</para>
  <para style="li2" vid="1CH 6:12">सादोक ह सल्लूम के ददा,<verse eid="1CH 6:12" /></para>
  <para style="li2">
    <verse number="13" style="v" sid="1CH 6:13" />सल्लूम ह हिलकियाह के ददा,</para>
  <para style="li2" vid="1CH 6:13">हिलकियाह ह अजरयाह के ददा,<verse eid="1CH 6:13" /></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 6:14" />अजरयाह ह सरायाह के ददा,</para>
  <para style="li2" vid="1CH 6:14">अऊ सरायाह ह योसादाक<note caller="+" style="f"><char style="fr" closed="false">6:14 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">यहोसादाक</char></note> के ददा रिहिस।<verse eid="1CH 6:14" /></para>
  <para style="li2">
    <verse number="15" style="v" sid="1CH 6:15" />जब यहोवा ह यहूदा अऊ यरूसलेम ला नबूकदनेसर के दुवारा बंधुवई म भेज दीस, तब योसादाक घलो बंधुवई म चल दीस।<verse eid="1CH 6:15" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="16" style="v" sid="1CH 6:16" />लेवी के बेटामन:</para>
  <para style="li2" vid="1CH 6:16">गेरसोन, कहात अऊ मरारी।<verse eid="1CH 6:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 6:17" />गेरसोन<note caller="+" style="f"><char style="fr" closed="false">6:17 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">गेरसोम</char></note> के बेटामन के नांव ये रिहिस:</para>
  <para style="li2" vid="1CH 6:17">लिबनी अऊ सिमी।<verse eid="1CH 6:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 6:18" />कहात के बेटामन:</para>
  <para style="li2" vid="1CH 6:18">अमराम, ईसहार, हेबरोन अऊ उजीएल।<verse eid="1CH 6:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 6:19" />मरारी के बेटामन:</para>
  <para style="li2" vid="1CH 6:19">महली अऊ मूसी।</para>
  <para style="b" vid="1CH 6:19" />
  <para style="lh" vid="1CH 6:19">अपन-अपन ददा के परिवार के मुताबिक लेवीमन के कुल ये होईन:<verse eid="1CH 6:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 6:20" />गेरसोन के संतान:</para>
  <para style="li2" vid="1CH 6:20">लिबनी, लिबनी ले यहत,</para>
  <para style="li2" vid="1CH 6:20">ओकर ले जिम्मा, <verse eid="1CH 6:20" /><verse number="21" style="v" sid="1CH 6:21" />ओकर ले योआह,</para>
  <para style="li2" vid="1CH 6:21">योआह ले इद्दो, इद्दो ले जेरह,</para>
  <para style="li2" vid="1CH 6:21">जेरह ले यातरै।<verse eid="1CH 6:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 6:22" />कहात के संतान:</para>
  <para style="li2" vid="1CH 6:22">कहात के बेटा अमीनादाब, ओकर बेटा कोरह,</para>
  <para style="li2" vid="1CH 6:22">ओकर बेटा अस्सीर, <verse eid="1CH 6:22" /><verse number="23" style="v" sid="1CH 6:23" />ओकर बेटा एलकाना,</para>
  <para style="li2" vid="1CH 6:23">ओकर बेटा एबियासाप, ओकर बेटा अस्सीर,<verse eid="1CH 6:23" /></para>
  <para style="li2">
    <verse number="24" style="v" sid="1CH 6:24" />ओकर बेटा तहत, ओकर बेटा उरीएल,</para>
  <para style="li2" vid="1CH 6:24">ओकर बेटा उजियाह अऊ ओकर बेटा साऊल।<verse eid="1CH 6:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 6:25" />एलकाना के संतान:</para>
  <para style="li2" vid="1CH 6:25">अमासै अऊ अहीमोत,<verse eid="1CH 6:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 6:26" />ओकर बेटा एलकाना, ओकर बेटा सोपै,</para>
  <para style="li2" vid="1CH 6:26">ओकर बेटा नहत, <verse eid="1CH 6:26" /><verse number="27" style="v" sid="1CH 6:27" />ओकर बेटा एलीआब,</para>
  <para style="li2" vid="1CH 6:27">ओकर बेटा यरोहाम, ओकर बेटा एलकाना,</para>
  <para style="li2" vid="1CH 6:27">अऊ ओकर बेटा समूएल।<verse eid="1CH 6:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 6:28" />समूएल के बेटामन:</para>
  <para style="li2" vid="1CH 6:28">ओकर जेठा योएल</para>
  <para style="li2" vid="1CH 6:28">अऊ दूसरा अबियाह।<verse eid="1CH 6:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 6:29" />मरारी के संतान:</para>
  <para style="li2" vid="1CH 6:29">महली, ओकर बेटा लिबनी,</para>
  <para style="li2" vid="1CH 6:29">ओकर बेटा सिमी, ओकर बेटा उज्जा,<verse eid="1CH 6:29" /></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 6:30" />ओकर बेटा सिमा, ओकर बेटा हग्गियाह</para>
  <para style="li2" vid="1CH 6:30">अऊ ओकर बेटा असायाह।<verse eid="1CH 6:30" /></para>
  <para style="s2">मंदिर के संगीतकार</para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31" />यहोवा के भवन म सन्दूक ला रखे जाय के बाद, दाऊद ह यहोवा के भवन म संगीत के जिम्मेदारी जेमन ला दीस, ओमन ये अंय। <verse eid="1CH 6:31" /><verse number="32" style="v" sid="1CH 6:32" />जब तक सुलेमान ह यरूसलेम म यहोवा के मंदिर ला नइं बनवा लीस, तब तक येमन पबितर-तम्बू, मिलापवाला तम्बू के आघू म संगीत के दुवारा सेवा करिन। येमन ओमन के ऊपर लागू बिधि के मुताबिक अपन काम करिन।<verse eid="1CH 6:32" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="33" style="v" sid="1CH 6:33" />येमन ओ आदमी रिहिन, जेमन अपन बेटामन के संग सेवा करिन:</para>
  <para style="b" vid="1CH 6:33" />
  <para style="li1" vid="1CH 6:33">कहातीमन ले:</para>
  <para style="li2" vid="1CH 6:33">हेमान संगीतकार,</para>
  <para style="li2" vid="1CH 6:33">जऊन ह योएल के बेटा रिहिस, अऊ योएल ह समूएल के,<verse eid="1CH 6:33" /></para>
  <para style="li2">
    <verse number="34" style="v" sid="1CH 6:34" />समूएल ह एलकाना के, एलकाना ह यरोहाम के</para>
  <para style="li2" vid="1CH 6:34">यरोहाम ह एलीएल के, एलीएल ह तोह के,<verse eid="1CH 6:34" /></para>
  <para style="li2">
    <verse number="35" style="v" sid="1CH 6:35" />तोह ह सूप के, सूप ह एलकाना के,</para>
  <para style="li2" vid="1CH 6:35">एलकाना ह महत के, महत ह अमासै के,<verse eid="1CH 6:35" /></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 6:36" />अमासै ह एलकाना के, एलकाना ह योएल के,</para>
  <para style="li2" vid="1CH 6:36">योएल ह अजरयाह के, अजरयाह ह सपनयाह के,<verse eid="1CH 6:36" /></para>
  <para style="li2">
    <verse number="37" style="v" sid="1CH 6:37" />सपनयाह ह तहत के, तहत ह अस्सीर के,</para>
  <para style="li2" vid="1CH 6:37">अस्सीर ह एबियासाप के, एबियासाप ह कोरह के,<verse eid="1CH 6:37" /></para>
  <para style="li2">
    <verse number="38" style="v" sid="1CH 6:38" />कोरह ह ईसहार के, ईसहार ह कहात के,</para>
  <para style="li2" vid="1CH 6:38">कहात ह लेवी के, अऊ लेवी ह इसरायल के बेटा रिहिस;<verse eid="1CH 6:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 6:39" />अऊ हेमान के सहयोगी आसाप, जऊन ह ओकर जेवनी कोति रहिके सेवा करय:</para>
  <para style="li2" vid="1CH 6:39">आसाप ह बेरेकियाह के बेटा रिहिस, अऊ बेरेकियाह ह सिमा के,<verse eid="1CH 6:39" /></para>
  <para style="li2">
    <verse number="40" style="v" sid="1CH 6:40" />सिमा ह मिकाएल के, मिकाएल ह बासेयाह के,</para>
  <para style="li2" vid="1CH 6:40">बासेयाह ह मलकियाह के, <verse eid="1CH 6:40" /><verse number="41" style="v" sid="1CH 6:41" />मलकियाह ह एत्नी के,</para>
  <para style="li2" vid="1CH 6:41">एत्नी ह जेरह के, जेरह ह अदायाह के,<verse eid="1CH 6:41" /></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 6:42" />अदायाह ह एतान के, एतान ह जिम्मा के,</para>
  <para style="li2" vid="1CH 6:42">जिम्मा ह सिमी के, <verse eid="1CH 6:42" /><verse number="43" style="v" sid="1CH 6:43" />सिमी ह यहत के,</para>
  <para style="li2" vid="1CH 6:43">यहत ह गेरसोन के, अऊ गेरसोन ह लेवी के बेटा रिहिस;<verse eid="1CH 6:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 6:44" />अऊ ओमन के सहयोगी, मरारीमन ओकर डेरी कोति रहंय:</para>
  <para style="li2" vid="1CH 6:44">एतान ह कीसी के बेटा रिहिस, कीसी ह अब्दी के,</para>
  <para style="li2" vid="1CH 6:44">अब्दी ह मल्लूक के, <verse eid="1CH 6:44" /><verse number="45" style="v" sid="1CH 6:45" />मल्लूक ह हसबियाह के,</para>
  <para style="li2" vid="1CH 6:45">हसबियाह ह अमसयाह के, अमसयाह ह हिलकियाह के,<verse eid="1CH 6:45" /></para>
  <para style="li2">
    <verse number="46" style="v" sid="1CH 6:46" />हिलकियाह ह अमसी के, अमसी ह बानी के,</para>
  <para style="li2" vid="1CH 6:46">बानी ह सेमेर के, <verse eid="1CH 6:46" /><verse number="47" style="v" sid="1CH 6:47" />सेमेर ह महली के,</para>
  <para style="li2" vid="1CH 6:47">महली ह मूसी के, मूसी ह मरारी के,</para>
  <para style="li2" vid="1CH 6:47">अऊ मरारी ह लेवी के बेटा रिहिस।<verse eid="1CH 6:47" /></para>
  <para style="b" />
  <para style="p">
    <verse number="48" style="v" sid="1CH 6:48" />ओमन के संगी लेवीमन ला पबितर-तम्बू, परमेसर के भवन म आने जम्मो किसम के काम दिये गे रिहिस। <verse eid="1CH 6:48" /><verse number="49" style="v" sid="1CH 6:49" />पर सिरिप हारून अऊ ओकर बेटा अऊ ओकर संतानमन महा पबितर स्थान म करे गे जम्मो काम के संबंध म होम-बलिदान के बेदी अऊ धूप के बेदी म भेंट चघावंय अऊ इसरायलीमन बर प्रायस्चित करंय जइसन कि परमेसर के दास मूसा ह हुकूम दे रिहिस।<verse eid="1CH 6:49" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="50" style="v" sid="1CH 6:50" />हारून के संतान येमन रिहिन:</para>
  <para style="li2" vid="1CH 6:50">ओकर बेटा एलिआजर, ओकर बेटा पीनहास,</para>
  <para style="li2" vid="1CH 6:50">ओकर बेटा अबीसू, <verse eid="1CH 6:50" /><verse number="51" style="v" sid="1CH 6:51" />ओकर बेटा बुक्की,</para>
  <para style="li2" vid="1CH 6:51">ओकर बेटा उज्जी, ओकर बेटा जरहयाह,<verse eid="1CH 6:51" /></para>
  <para style="li2">
    <verse number="52" style="v" sid="1CH 6:52" />ओकर बेटा मरायोत, ओकर बेटा अमरयाह,</para>
  <para style="li2" vid="1CH 6:52">ओकर बेटा अहीतूब, <verse eid="1CH 6:52" /><verse number="53" style="v" sid="1CH 6:53" />ओकर बेटा सादोक,</para>
  <para style="li2" vid="1CH 6:53">ओकर बेटा अहीमास।<verse eid="1CH 6:53" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="54" style="v" sid="1CH 6:54" />ओमन के इलाका म ओमन के बसाहट के मुताबिक जऊन भाग ओमन ला दिये गीस, ओमन ये रिहिन (हारून के संतान, जेमन कहाती कुल के रिहिन, ओमन ला ये भाग दिये गीस, काबरकि पहिली चिट्ठी ओमन के नांव म निकलिस):<verse eid="1CH 6:54" /></para>
  <para style="li1">
    <verse number="55" style="v" sid="1CH 6:55" />ओमन ला चारों कोति के चरागन समेत यहूदा प्रदेस म हेबरोन मिलिस। <verse eid="1CH 6:55" /><verse number="56" style="v" sid="1CH 6:56" />(पर सहर के चारों कोति के खेत अऊ गांवमन ला यपुन्ने के बेटा कालेब ला दिये गीस।) <verse eid="1CH 6:56" /><verse number="57" style="v" sid="1CH 6:57" />हारून के संतानमन ला हेबरोन (एक सरन लेय के सहर), अऊ लिबना, यत्तीर, एसतमोआ <verse eid="1CH 6:57" /><verse number="58" style="v" sid="1CH 6:58" />हीलेन अऊ दबीर, <verse eid="1CH 6:58" /><verse number="59" style="v" sid="1CH 6:59" />आसान, यूता अऊ बेत-सेमेस अऊ ये सहरमन के संग ओमन के चरागनमन घलो दिये गीस।<verse eid="1CH 6:59" /></para>
  <para style="li1">
    <verse number="60" style="v" sid="1CH 6:60" />अऊ बिनयामीन के गोत्र म ले ओमन ला गिबोन, गेबा, आलेमेत अऊ अनातोत सहर ओमन के चरागनमन के संग दिये गीस।</para>
  <para style="lf" vid="1CH 6:60">कहाती कुल के मनखेमन के बीच बांटे गय नगरमन के कुल संखिया तेरह रिहिस।<verse eid="1CH 6:60" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="61" style="v" sid="1CH 6:61" />बाकि बांचे कहात के संतानमन ला मनस्से के आधा गोत्र के कुलमन ले दस नगर चिट्ठी डालके बांट दिये गीस।<verse eid="1CH 6:61" /></para>
  <para style="li1">
    <verse number="62" style="v" sid="1CH 6:62" />गेरसोन के संतानमन ला ओमन के कुलमन के मुताबिक इस्साकार, आसेर अऊ नपताली के गोत्र अऊ बासान म रहइया मनस्से के गोत्र के भाग म ले तेरह नगर मिलिस।<verse eid="1CH 6:62" /></para>
  <para style="li1">
    <verse number="63" style="v" sid="1CH 6:63" />मरारीमन के कुलमन के मुताबिक ओमन ला रूबेन, गाद अऊ जबूलून के गोत्र म ले बारह नगर चिट्ठी डालके बांट दिये गीस।<verse eid="1CH 6:63" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="64" style="v" sid="1CH 6:64" />इसरायलीमन लेवीमन ला ओ नगरमन ला चरागन समेत दीन।<verse eid="1CH 6:64" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="65" style="v" sid="1CH 6:65" />ओमन ला यहूदा, सिमोन अऊ बिनयामीन के गोत्र म ले ओ नगरमन चिट्ठी डालके दिये गीन, जेमन के नांव ऊपर दिये गे हवय।<verse eid="1CH 6:65" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="66" style="v" sid="1CH 6:66" />कहाती के कुछू कुलमन ला ओमन के इलाका के नगरमन के रूप म एपरैम के गोत्र ले दिये गीस।<verse eid="1CH 6:66" /></para>
  <para style="li1">
    <verse number="67" style="v" sid="1CH 6:67" />ये किसम ले ओमन ला एपरैम के पहाड़ी देस म सकेम सहर (सरन लेय के एक सहर), गेजेर, <verse eid="1CH 6:67" /><verse number="68" style="v" sid="1CH 6:68" />योकमाम, बेत-होरोन, <verse eid="1CH 6:68" /><verse number="69" style="v" sid="1CH 6:69" />अय्यालोन अऊ गत-रिम्मोन, ओमन के चरागन समेत मिलिस।<verse eid="1CH 6:69" /></para>
  <para style="li1">
    <verse number="70" style="v" sid="1CH 6:70" />मनस्से के आधा गोत्र म ले इसरायलीमन आनेर अऊ बिलाम, ओमन के चरागन समेत दीन; ये नगरमन बाकि बांचे कहाती के कुलमन ला मिलिस।<verse eid="1CH 6:70" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="71" style="v" sid="1CH 6:71" />गेरसोनीमन ला ये नगरमन मिलिन:</para>
  <para style="li1" vid="1CH 6:71">मनस्से के आधा गोत्र के कुल म ले ओमन बासान के गोलान अऊ असतारोत घलो पाईन, ये नगरमन के संग ओमन के चरागनमन घलो रिहिन;<verse eid="1CH 6:71" /></para>
  <para style="li1">
    <verse number="72" style="v" sid="1CH 6:72" />इस्साकार के गोत्र म ले ओमन केदेस, दाबरत, <verse eid="1CH 6:72" /><verse number="73" style="v" sid="1CH 6:73" />रामोत अऊ आनेम नगर पाईन, संग म ओमन के चरागनमन घलो रिहिन;<verse eid="1CH 6:73" /></para>
  <para style="li1">
    <verse number="74" style="v" sid="1CH 6:74" />आसेर के गोत्र म ले ओमन मासाल, अबदोन, <verse eid="1CH 6:74" /><verse number="75" style="v" sid="1CH 6:75" />हूकोक अऊ रहोब नगर पाईन, संग म ओमन के चरागनमन घलो रिहिन;<verse eid="1CH 6:75" /></para>
  <para style="li1">
    <verse number="76" style="v" sid="1CH 6:76" />अऊ नपताली के गोत्र म ले ओमन ला गलील के केदेस, हम्मोन अऊ किरयातैम नगर मिलिस, संग म ओमन के चरागनमन घलो रिहिन।<verse eid="1CH 6:76" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="77" style="v" sid="1CH 6:77" />मरारीमन (बाकि बांचे लेवीमन) ला ये नगरमन मिलिन:</para>
  <para style="li1" vid="1CH 6:77">जबूलून के गोत्र म ले ओमन योकनाम, करताह, रिम्मोन अऊ ताबोर नगर पाईन, संग म ओमन के चरागनमन घलो रिहिन;<verse eid="1CH 6:77" /></para>
  <para style="li1">
    <verse number="78" style="v" sid="1CH 6:78" />यरीहो के पूरब कोति यरदन नदी के ओ पार, रूबेन के गोत्र म ले ओमन ला निरजन जगह म बेसेर मिलिस, अऊ यहस, <verse eid="1CH 6:78" /><verse number="79" style="v" sid="1CH 6:79" />कदेमोत अऊ मेपात नगरमन के संग ओमन के चरागनमन घलो मिलिन;<verse eid="1CH 6:79" /></para>
  <para style="li1">
    <verse number="80" style="v" sid="1CH 6:80" />अऊ गाद के गोत्र म ले ओमन गिलाद के रामोत, महनैम, <verse eid="1CH 6:80" /><verse number="81" style="v" sid="1CH 6:81" />हेसबोन अऊ याजेर नगर पाईन, संग म ओमन के चरागनमन घलो रिहिन।<verse eid="1CH 6:81" /></para>
  <chapter eid="1CH 6" />
  <chapter number="7" style="c" sid="1CH 7" />
  <para style="s1">इस्साकार</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 7:1" />इस्साकार के बेटामन:</para>
  <para style="li2" vid="1CH 7:1">तोला, पुआ, यासूब अऊ सिमरोन—जम्मो चार झन रिहिन।<verse eid="1CH 7:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 7:2" />तोला के बेटामन:</para>
  <para style="li2" vid="1CH 7:2">उज्जी, रपायाह, यरीएल, यहमै, यिबसाम अऊ समूएल—येमन अपन-अपन परिवार के मुखिया रिहिन। दाऊद के राज के समय, तोला के संतानमन के गनती ओमन के बंसावली म बीर योद्धा के रूप म करे गीस अऊ दाऊद के समय म ओमन के संखिया 22,600 रिहिस।<verse eid="1CH 7:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 7:3" />उज्जी के बेटा:</para>
  <para style="li2" vid="1CH 7:3">यिजराहियाह।</para>
  <para style="li1" vid="1CH 7:3">यिजराहियाह के बेटामन:</para>
  <para style="li2" vid="1CH 7:3">मिकाएल, ओबदयाह, योएल अऊ यिसियाह। ये जम्मो पांच झन मुखिया रिहिन। <verse eid="1CH 7:3" /><verse number="4" style="v" sid="1CH 7:4" />ओमन के परिवार के बंसावली के मुताबिक, ओमन 36,000 आदमी रिहिन, जेमन लड़ई बर तियार रिहिन, काबरकि ओमन के बहुंत घरवाली अऊ लइकामन रिहिन।<verse eid="1CH 7:4" /></para>
  <para style="lf">
    <verse number="5" style="v" sid="1CH 7:5" />इस्साकार के जम्मो कुलमन ले ओमन के रिस्तेदार, जेमन योद्धा रिहिन, ओमन के बंसावली म लिखे नांव के मुताबिक ओमन के कुल संखिया 87,000 रिहिस।<verse eid="1CH 7:5" /></para>
  <para style="s1">बिनयामीन</para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 7:6" />बिनयामीन के तीन बेटामन:</para>
  <para style="li2" vid="1CH 7:6">बेला, बेकेर अऊ यदीएल।<verse eid="1CH 7:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 7:7" />बेला के बेटामन:</para>
  <para style="li2" vid="1CH 7:7">एसबोन, उज्जी, उजीएल, यरीमोत अऊ ईरी; येमन कुल पांच झन रिहिन अऊ येमन अपन-अपन परिवार के मुखिया रिहिन। ओमन के बंसावली म 22,034 योद्धामन के नांव लिखे गे रिहिस।<verse eid="1CH 7:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 7:8" />बेकेर के बेटामन:</para>
  <para style="li2" vid="1CH 7:8">जमीरा, योआस, एलिएजेर, एलयोएनै, ओमरी, यरेमोत, अबियाह, अनातोत अऊ आलेमेत। ये जम्मो झन बेकेर के बेटा रिहिन। <verse eid="1CH 7:8" /><verse number="9" style="v" sid="1CH 7:9" />ओमन के बंसावली म ओमन के परिवारमन के मुखियामन के नांव अऊ 20,200 योद्धामन के नांव लिखे गे रिहिस।<verse eid="1CH 7:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 7:10" />यदीएल के बेटा:</para>
  <para style="li2" vid="1CH 7:10">बिलहान।</para>
  <para style="li1" vid="1CH 7:10">बिलहान के बेटामन:</para>
  <para style="li2" vid="1CH 7:10">यूस, बिनयामीन, एहूद, कनाना, जेतान, तरसीस अऊ अहीसहर। <verse eid="1CH 7:10" /><verse number="11" style="v" sid="1CH 7:11" />यदीएल के ये जम्मो बेटामन अपन-अपन परिवारमन के मुखिया रिहिन। 17,200 योद्धामन लड़ई म जाय बर तियार रिहिन।<verse eid="1CH 7:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 7:12" />ईर के संतान सुप्पीम अऊ हुप्पीम अऊ अहेर के संतान हूसीमन रिहिन।<verse eid="1CH 7:12" /></para>
  <para style="s1">नपताली</para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 7:13" />नपताली के बेटामन:</para>
  <para style="li2" vid="1CH 7:13">यहसीएल, गूनी, येसेर अऊ सल्लूम—येमन बिलहा के संतान रिहिन।<verse eid="1CH 7:13" /></para>
  <para style="s1">मनस्से</para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 7:14" />मनस्से के संतान:</para>
  <para style="li2" vid="1CH 7:14">असरीएल ह ओकर अरामी रखैल कोति ले ओकर संतान रिहिस। ओ अरामी माईलोगन ह गिलाद के ददा माकीर ला घलो जनम दीस। <verse eid="1CH 7:14" /><verse number="15" style="v" sid="1CH 7:15" />माकीर ह हुप्पीमन अऊ सुप्पीममन के बीच ले अपन बर एक घरवाली बनाईस। माकीर के बहिनी के नांव माका रिहिस। ओकर आने संतान के नांव सलोफाद रिहिस, जेकर सिरिप बेटीमन रिहिन। <verse eid="1CH 7:15" /><verse number="16" style="v" sid="1CH 7:16" />माकीर के घरवाली माका ह एक बेटा ला जनम दीस, जेकर नांव पेरेस रखे गीस। ओकर भाई के नांव सेरेस रखे गीस, अऊ ऊलाम अऊ राकेम ओकर बेटामन रिहिन।<verse eid="1CH 7:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 7:17" />ऊलाम के बेटा:</para>
  <para style="li2" vid="1CH 7:17">बदान।</para>
  <para style="li1" vid="1CH 7:17">येमन गिलाद के बेटामन रिहिन अऊ गिलाद ह माकीर के बेटा अऊ मनस्से के पोता रिहिस।<verse eid="1CH 7:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 7:18" />ओकर बहिनी हम्मोलेकेत ह ईसहोद, अबिएजेर अऊ महला ला जनम दीस।<verse eid="1CH 7:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 7:19" />समीदा के बेटा येमन रिहिन:</para>
  <para style="li2" vid="1CH 7:19">अहियान, सकेम, लिखी, अऊ अनीआम।<verse eid="1CH 7:19" /></para>
  <para style="s1">एपरैम</para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 7:20" />एपरैम के संतानमन:</para>
  <para style="li2" vid="1CH 7:20">सूतेलह, ओकर बेटा बेरेद,</para>
  <para style="li2" vid="1CH 7:20">ओकर बेटा तहत, ओकर बेटा एलादा,</para>
  <para style="li2" vid="1CH 7:20">ओकर बेटा तहत, <verse eid="1CH 7:20" /><verse number="21" style="v" sid="1CH 7:21" />ओकर बेटा जाबाद,</para>
  <para style="li2" vid="1CH 7:21">अऊ ओकर बेटा सूतेलह।</para>
  <para style="li2" vid="1CH 7:21">(एजेर अऊ एलाद ला देस म ही जनमे गत के आदमीमन मार डारिन, जब ओमन ये मनखेमन के पसुमन ला पकड़के ले जाय बर आय रिहिन। <verse eid="1CH 7:21" /><verse number="22" style="v" sid="1CH 7:22" />ओमन के ददा एपरैम ह बहुंत दिन तक ओमन बर सोक मनाईस, अऊ ओकर रिस्तेदारमन ओला सांति देय बर आईन। <verse eid="1CH 7:22" /><verse number="23" style="v" sid="1CH 7:23" />तब ओह अपन घरवाली संग फेर संबंध बनाईस, अऊ ओकर घरवाली ह गरभवती होके एक झन बेटा ला जनम दीस। एपरैम ह ओकर नांव एकर खातिर बरीया<note caller="+" style="f"><char style="fr" closed="false">7:23 </char><char style="fq" closed="false">बरीया </char><char style="ft" closed="false">इबरानी म </char><char style="fq" closed="false">बिपत्ति </char><char style="ft" closed="false">के सहीं लगथे</char></note> रखिस, काबरकि ओकर परिवार म बिपत्ति पड़े रिहिस। <verse eid="1CH 7:23" /><verse number="24" style="v" sid="1CH 7:24" />ओकर बेटी सेरा रिहिस, जऊन ह खाल्हे अऊ ऊपर कोति के बेत-होरोन के संग म उज्जेन-सेरा ला घलो बनवाईस।)<verse eid="1CH 7:24" /></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 7:25" />ओकर बेटा रेपा रिहिस अऊ ओकर बेटा रेसेप,</para>
  <para style="li2" vid="1CH 7:25">ओकर बेटा तेलह, ओकर बेटा तहान,<verse eid="1CH 7:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 7:26" />ओकर बेटा लादान, ओकर बेटा अमीहूद,</para>
  <para style="li2" vid="1CH 7:26">ओकर बेटा एलीसामा, <verse eid="1CH 7:26" /><verse number="27" style="v" sid="1CH 7:27" />ओकर बेटा नून,</para>
  <para style="li2" vid="1CH 7:27">अऊ ओकर बेटा यहोसू रिहिस।<verse eid="1CH 7:27" /></para>
  <para style="lf">
    <verse number="28" style="v" sid="1CH 7:28" />ओमन के भुइयां अऊ बसे जगह म बेतेल अऊ ओकर आसपास के गांवमन, पूरब कोति नारान, गेजेर अऊ येकर गांवमन पछिम कोति, अऊ सकेम अऊ येकर गांवमन अय्या तक अऊ संग म अय्या के गांवमन घलो रिहिन। <verse eid="1CH 7:28" /><verse number="29" style="v" sid="1CH 7:29" />अऊ मनस्से के सीमना के तीरे-तीर बेत-सान, तानाक, मगिद्दो अऊ दोर सहरमन अऊ संग म ओमन के गांवमन घलो रिहिन। इसरायल के बेटा, यूसुफ के संतानमन ये नगरमन म रहत रिहिन।<verse eid="1CH 7:29" /></para>
  <para style="s1">आसेर</para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 7:30" />आसेर के बेटामन:</para>
  <para style="li2" vid="1CH 7:30">यिमना, इसवा, इसवी अऊ बरीया। अऊ ओमन के बहिनी के नांव सेरह रिहिस।<verse eid="1CH 7:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 7:31" />बरीया के बेटामन:</para>
  <para style="li2" vid="1CH 7:31">हेबेर अऊ मलकीएल, जऊन ह बिरजोत के ददा होईस।<verse eid="1CH 7:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 7:32" />हेबेर ह यपलेत, सोमेर, होताम, अऊ ओमन के बहिनी सूआ के ददा होईस।<verse eid="1CH 7:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 7:33" />यपलेत के बेटामन:</para>
  <para style="li2" vid="1CH 7:33">पासक, बिम्हाल अऊ अस्वात।</para>
  <para style="lf" vid="1CH 7:33">येमन यपलेत के बेटा रिहिन।<verse eid="1CH 7:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 7:34" />सोमेर के बेटामन:</para>
  <para style="li2" vid="1CH 7:34">अही, रोहगा, यहुब्बा अऊ अराम।<verse eid="1CH 7:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 7:35" />ओकर भाई हेलेम के बेटामन:</para>
  <para style="li2" vid="1CH 7:35">सोपह, यिमना, सेलेस अऊ आमाल।<verse eid="1CH 7:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 7:36" />सोपह के बेटामन:</para>
  <para style="li2" vid="1CH 7:36">सूह, हरनेपर, सूआल, बेरी, इमरा, <verse eid="1CH 7:36" /><verse number="37" style="v" sid="1CH 7:37" />बेसेर, होद, सम्मा, सिलसा, यितरान<note caller="+" style="f"><char style="fr" closed="false">7:37 </char><char style="ft" closed="false">संभवतः </char><char style="fqa" closed="false">येतेर </char><char style="ft" closed="false">के आने नांव</char></note> अऊ बेरा।<verse eid="1CH 7:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 7:38" />येतेर के बेटामन:</para>
  <para style="li2" vid="1CH 7:38">यपुन्ने, पिस्पा अऊ अरा।<verse eid="1CH 7:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 7:39" />उल्ला के बेटामन:</para>
  <para style="li2" vid="1CH 7:39">आरह, हन्नीएल अऊ रिस्या।<verse eid="1CH 7:39" /></para>
  <para style="lf">
    <verse number="40" style="v" sid="1CH 7:40" />ये जम्मो झन आसेर के संतान रिहिन अऊ येमन अपन-अपन परिवार के मुखिया, चुने आदमी, बीर योद्धा अऊ बहुंत बढ़िया अगुवा रिहिन। ओमन के बंसावली म लिखे गय, लड़ई बर तियार आदमीमन के संखिया 26,000 रिहिस।<verse eid="1CH 7:40" /></para>
  <chapter eid="1CH 7" />
  <chapter number="8" style="c" sid="1CH 8" />
  <para style="s1">बिनयामीनी साऊल के बंसावली</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 8:1" />बिनयामीन के बेटामन:</para>
  <para style="li2" vid="1CH 8:1">ओकर पहिलांत बेटा बेला,</para>
  <para style="li2" vid="1CH 8:1">दूसर बेटा असबेल, तीसर अहराह,<verse eid="1CH 8:1" /></para>
  <para style="li2">
    <verse number="2" style="v" sid="1CH 8:2" />चौथा नोहा अऊ पांचवां रापा।<verse eid="1CH 8:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 8:3" />बेला के बेटामन:</para>
  <para style="li2" vid="1CH 8:3">अद्दार, गेरा, अबीहूद, <verse eid="1CH 8:3" /><verse number="4" style="v" sid="1CH 8:4" />अबीसू, नामान, अहोह, <verse eid="1CH 8:4" /><verse number="5" style="v" sid="1CH 8:5" />गेरा, सपूपान अऊ हूराम।<verse eid="1CH 8:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 8:6" />येमन एहूद के संतान रिहिन, जेमन गेबा नगर म रहइयामन के परिवारमन के मुखिया रिहिन, अऊ येमन ला बंदी बनाके मानहत ले जाय गीस:<verse eid="1CH 8:6" /></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 8:7" />नामान, अहियाह, अऊ गेरा, जऊन ह ओमन ला बंदी बनाके ले गीस अऊ ओह उज्जा अऊ अहीहूद ला जनम दीस।<verse eid="1CH 8:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 8:8" />सहरैम के अपन घरवाली हूसीम अऊ बारा ला तलाक देय के बाद, मोआब देस म ओकर बेटामन जनमिन। <verse eid="1CH 8:8" /><verse number="9" style="v" sid="1CH 8:9" />ओकर घरवाली होदेस ले योबाब, सिब्या, मेसा, मल्काम, <verse eid="1CH 8:9" /><verse number="10" style="v" sid="1CH 8:10" />यूस, साकिया अऊ मिरमा जनमिन। येमन ओकर बेटामन रिहिन अऊ येमन अपन-अपन परिवार के मुखिया रिहिन। <verse eid="1CH 8:10" /><verse number="11" style="v" sid="1CH 8:11" />हूसीम ले अबीतूब अऊ एलपाल जनमिन।<verse eid="1CH 8:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 8:12" />एलपाल के बेटामन:</para>
  <para style="li2" vid="1CH 8:12">एबेर, मिसाम अऊ सेमेद (जऊन ह ओनो अऊ लोद सहर अऊ येमन के आसपास के गांवमन ला बसाईस), <verse eid="1CH 8:12" /><verse number="13" style="v" sid="1CH 8:13" />अऊ बरीया अऊ सेमा, जेमन अय्यालोन सहर म रहइयामन के परिवारमन के मुखिया रिहिन अऊ जेमन गत सहर के निवासीमन ला भगा दीन।<verse eid="1CH 8:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 8:14" />अहियो, सासक, यरेमोत, <verse eid="1CH 8:14" /><verse number="15" style="v" sid="1CH 8:15" />जबदयाह, अराद, एदेर, <verse eid="1CH 8:15" /><verse number="16" style="v" sid="1CH 8:16" />मिकाएल, यिस्पा, योहा; येमन बरीया के बेटा रिहिन।<verse eid="1CH 8:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 8:17" />जबदयाह, मसुल्लाम, हिजकी, हेबेर, <verse eid="1CH 8:17" /><verse number="18" style="v" sid="1CH 8:18" />यिसमरै, यिजलीया, योबाब; येमन एलपाल के बेटा रिहिन।<verse eid="1CH 8:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 8:19" />याकीम, जिकरी, जबदी, <verse eid="1CH 8:19" /><verse number="20" style="v" sid="1CH 8:20" />एलीएनै, सिल्लतै, एलीएल <verse eid="1CH 8:20" /><verse number="21" style="v" sid="1CH 8:21" />अदायाह, बरायाह अऊ सिमरात; येमन सिमी के बेटा रिहिन।<verse eid="1CH 8:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 8:22" />यिसपान, एबेर, एलीएल, <verse eid="1CH 8:22" /><verse number="23" style="v" sid="1CH 8:23" />अबदोन, जिकरी, हानान, <verse eid="1CH 8:23" /><verse number="24" style="v" sid="1CH 8:24" />हननयाह, एलाम, अन्तोतयाह, <verse eid="1CH 8:24" /><verse number="25" style="v" sid="1CH 8:25" />यिपदयाह अऊ पनूएल; येमन सासक के बेटा रिहिन।<verse eid="1CH 8:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 8:26" />समसरै, सहरयाह, अतलयाह, <verse eid="1CH 8:26" /><verse number="27" style="v" sid="1CH 8:27" />यारेसियाह, एलियाह अऊ जिकरी; येमन यरोहाम के बेटा रिहिन।<verse eid="1CH 8:27" /></para>
  <para style="lf">
    <verse number="28" style="v" sid="1CH 8:28" />ये जम्मो झन अपन-अपन परिवार के मुखिया रिहिन अऊ ओमन के बंसावली म ओमन के नांव मुखिया के रूप म लिखे गे रिहिस, अऊ ओमन यरूसलेम म रहत रिहिन।<verse eid="1CH 8:28" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="29" style="v" sid="1CH 8:29" />गिबोन के ददा येइल, गिबोन सहर म रहय।</para>
  <para style="li2" vid="1CH 8:29">ओकर घरवाली के नांव माका रिहिस। <verse eid="1CH 8:29" /><verse number="30" style="v" sid="1CH 8:30" />अऊ ओकर पहिलांत बेटा अबदोन रिहिस, फेर जूर, कीस, बाल, नेर, नादाब, <verse eid="1CH 8:30" /><verse number="31" style="v" sid="1CH 8:31" />गदोर, अहियो, जेकेर <verse eid="1CH 8:31" /><verse number="32" style="v" sid="1CH 8:32" />अऊ मिकलोत, जऊन ह सिमा के ददा रिहिस। येमन घलो अपन रिस्तेदारमन के लकठा म यरूसलेम म रहत रिहिन।<verse eid="1CH 8:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 8:33" />नेर ह कीस के ददा रिहिस, कीस ह साऊल के अऊ साऊल ह योनातन, मलकी-सुआ, अबीनादाब अऊ एस-बाल<note caller="+" style="f"><char style="fr" closed="false">8:33 </char><char style="ft" closed="false">येला </char><char style="fqa" closed="false">ईस-बोसेत </char><char style="ft" closed="false">घलो कहे जाथे</char></note> के ददा रिहिस।<verse eid="1CH 8:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 8:34" />योनातन के बेटा:</para>
  <para style="li2" vid="1CH 8:34">मरीब-बाल,<note caller="+" style="f"><char style="fr" closed="false">8:34 </char><char style="ft" closed="false">येला </char><char style="fqa" closed="false">मपीबोसेत </char><char style="ft" closed="false">घलो कहे जाथे</char></note> जऊन ह मीका के ददा रिहिस।<verse eid="1CH 8:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 8:35" />मीका के बेटामन:</para>
  <para style="li2" vid="1CH 8:35">पीतोन, मेलेक, तारे अऊ आहाज।<verse eid="1CH 8:35" /></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 8:36" />आहाज ह यहोआदा के ददा रिहिस, यहोआदा ह आलेमेत, अजमावेत अऊ जिमरी के ददा रिहिस, अऊ जिमरी ह मोसा के ददा रिहिस। <verse eid="1CH 8:36" /><verse number="37" style="v" sid="1CH 8:37" />मोसा ह बीना के ददा रिहिस; ओकर बेटा रापा, रापा के बेटा एलासा अऊ एलासा के बेटा आसेल रिहिस।<verse eid="1CH 8:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 8:38" />आसेल के छै बेटा रिहिन अऊ ये ओमन के नांव अंय:</para>
  <para style="li2" vid="1CH 8:38">अजरीकाम, बोकेरू, इसमायल, सारयाह, ओबदयाह अऊ हानान। ये जम्मो झन आसेल के बेटा रिहिन।<verse eid="1CH 8:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 8:39" />ओकर भाई एसेक के बेटामन:</para>
  <para style="li2" vid="1CH 8:39">ओकर पहिलांत बेटा ऊलाम, दूसर यूस अऊ तीसर एलीपेलेत। <verse eid="1CH 8:39" /><verse number="40" style="v" sid="1CH 8:40" />ऊलाम के बेटामन बीर योद्धा रिहिन अऊ धनुसधारी रिहिन। ओमन के बहुंत बेटा अऊ पोतामन रिहिन—कुल 150 जन।</para>
  <para style="li1" vid="1CH 8:40">येमन जम्मो बिनयामीन के संतान रिहिन।<verse eid="1CH 8:40" /></para>
  <para style="b" />
  <chapter eid="1CH 8" />
  <chapter number="9" style="c" sid="1CH 9" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1" />जम्मो इसरायलीमन के नांव बंसावली म इसरायल अऊ यहूदा के राजामन के किताब म लिखे गे हवय। ओमन के बिसवासघात करे के कारन ओमन ला बंधुवई म बेबिलोन देस ले जाय गीस।<verse eid="1CH 9:1" /></para>
  <para style="s1">यरूसलेम म मनखेमन</para>
  <para style="lh">
    <verse number="2" style="v" sid="1CH 9:2" />बंधुवई ले लहुंटे के बाद, सबले पहिले अपन-अपन नगर के अपन-अपन संपत्ति म फेर बसनेवालामन कुछू इसरायली, पुरोहित, लेवी अऊ मंदिर के सेवकमन रिहिन।<verse eid="1CH 9:2" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="3" style="v" sid="1CH 9:3" />यहूदा के गोत्र ले, बिनयामीन के गोत्र ले, अऊ एपरैम अऊ मनस्से के गोत्र ले जेमन यरूसलेम म रहत रिहिन, ओमन ये रिहिन:<verse eid="1CH 9:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 9:4" />यहूदा के बेटा पेरेस के एक संतान ऊतै रिहिस, जऊन ह अमीहूद के बेटा, अमीहूद ह ओमरी के बेटा, ओमरी ह इमरी के बेटा अऊ इमरी ह बानी के बेटा रिहिस।<verse eid="1CH 9:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 9:5" />सेलानीमन<note caller="+" style="f"><char style="fr" closed="false">9:5 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="NUM 26:20">गन 26:20</ref></char>; इबरानी म </char><char style="fqa" closed="false">सीलोनीमन</char></note> के बंस:</para>
  <para style="li2" vid="1CH 9:5">बड़े बेटा असायाह अऊ ओकर बेटामन।<verse eid="1CH 9:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 9:6" />जेरहीमन के बंस:</para>
  <para style="li2" vid="1CH 9:6">यूएल।</para>
  <para style="lf" vid="1CH 9:6">यहूदा के मनखेमन के संखिया 690 रिहिस।<verse eid="1CH 9:6" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="7" style="v" sid="1CH 9:7" />बिनयामीनीमन के बंस:</para>
  <para style="li1" vid="1CH 9:7">सल्लू, जऊन ह मसुल्लाम के बेटा, होदवियाह के पोता अऊ हस्सनूआ के परपोता रिहिस;<verse eid="1CH 9:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 9:8" />यिबनियाह, जऊन ह यरोहाम के बेटा रिहिस;</para>
  <para style="li1" vid="1CH 9:8">एला, जऊन ह उज्जी के बेटा अऊ मिकरी के पोता रिहिस;</para>
  <para style="li1" vid="1CH 9:8">अऊ मसुल्लाम, जऊन ह सपतयाह के बेटा, रूएल के पोता अऊ यिबनियाह के परपोता रिहिस।<verse eid="1CH 9:8" /></para>
  <para style="lf">
    <verse number="9" style="v" sid="1CH 9:9" />बिनयामीन के गोत्र के मनखेमन के ओमन के बंसावली म लिखे नांव के मुताबिक ओमन के संखिया 956 रिहिस। ये जम्मो आदमीमन अपन-अपन परिवार के मुखिया रिहिन।<verse eid="1CH 9:9" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="10" style="v" sid="1CH 9:10" />पुरोहितमन ले:</para>
  <para style="li1" vid="1CH 9:10">यदायाह; यहोयारीब; याकीन;<verse eid="1CH 9:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 9:11" />अजरयाह जऊन ह परमेसर के भवन के अधिकारी अऊ हिलकियाह के बेटा रिहिस, हिलकियाह ह मसुल्लाम के बेटा, मसुल्लाम ह सादोक के बेटा, सादोक ह मरायोत के बेटा अऊ मरायोत ह अहीतूब के बेटा रिहिस;<verse eid="1CH 9:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 9:12" />अऊ अदायाह, जऊन ह यरोहाम के बेटा रिहिस, यरोहाम ह पसहूर के बेटा, पसहूर ह मलकियाह के बेटा रिहिस;</para>
  <para style="li1" vid="1CH 9:12">अऊ मासै, जऊन ह अदीएल के बेटा, अदीएल ह यहसेरा के बेटा, यहसेरा ह मसुल्लाम के बेटा, मसुल्लाम ह मसिल्लेमीत के बेटा, मसिल्लेमीत ह इम्मेर के बेटा रिहिस।<verse eid="1CH 9:12" /></para>
  <para style="lf">
    <verse number="13" style="v" sid="1CH 9:13" />ओ पुरोहित, जेमन अपन-अपन परिवार के मुखिया रिहिन, ओमन के संखिया 1,760 रिहिस। ओमन योग्य मनखे रिहिन, अऊ परमेसर के भवन म सेवा करे बर जिम्मेदार रिहिन।<verse eid="1CH 9:13" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="14" style="v" sid="1CH 9:14" />लेवीमन ले:</para>
  <para style="li1" vid="1CH 9:14">समायाह, जऊन ह हस्सूब के बेटा रिहिस, हस्सूब ह अजरीकाम के बेटा, अजरीकाम ह हसबियाह के बेटा रिहिस अऊ येह एक मरारी रिहिस;<verse eid="1CH 9:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 9:15" />बकबक्कर, हेरेस अऊ गालाल अऊ मतनयाह, जऊन ह मीका के बेटा रिहिस, मीका ह जिकरी के बेटा, जिकरी ह आसाप के बेटा रिहिस;<verse eid="1CH 9:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 9:16" />ओबदयाह, जऊन ह समायाह के बेटा रिहिस, समायाह ह गालाल के बेटा, गालाल ह यदूतून के बेटा रिहिस;</para>
  <para style="li1" vid="1CH 9:16">अऊ बेरेकियाह, जऊन ह आसा के बेटा रिहिस, आसा ह एलकाना के बेटा रिहिस, जऊन ह नतोपातीमन के गांवमन म रहत रिहिस।<verse eid="1CH 9:16" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="17" style="v" sid="1CH 9:17" />दुवारपालमन:</para>
  <para style="li1" vid="1CH 9:17">सल्लूम, अक्कूब, तलमोन, अहीमन अऊ ओमन के संगी लेवीमन; सल्लूम ह येमन के मुखिया रिहिस <verse eid="1CH 9:17" /><verse number="18" style="v" sid="1CH 9:18" />अऊ ओह अब तक पूरब कोति राजा के दुवार करा तैनात रिहिस। लेवीमन के डेरा ले येमन दुवारपाल रिहिन।<verse eid="1CH 9:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 9:19" />सल्लूम, जऊन ह कोरे के बेटा, एबियासाप के पोता, अऊ कोरह के परपोता रिहिस, ओकर अऊ ओकर कोरही परिवार के ओकर संगी दुवारपालमन ऊपर तम्बू के दुवारमन के पहरेदारी करे के जिम्मेदारी रिहिस, जइसे कि ओमन के पुरखामन ऊपर यहोवा के निवास के प्रवेस दुवार के पहरेदारी करे के जिम्मेदारी रिहिस।<verse eid="1CH 9:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 9:20" />पहिले के समय म, एलिआजर के बेटा पीनहास ह दुवारपालमन के अधिकारी रिहिस, अऊ यहोवा ह ओकर संग रिहिस।<verse eid="1CH 9:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 9:21" />मसेलेमियाह के बेटा जकरयाह ह मिलापवाला तम्बू के प्रवेस दुवार करा दुवारपाल रिहिस।<verse eid="1CH 9:21" /></para>
  <para style="lf">
    <verse number="22" style="v" sid="1CH 9:22" />जऊन मन दुवारमन करा दुवारपाल के रूप म चुने गे रिहिन, ओमन के कुल संखिया 212 रिहिस। ओमन के नांव बंसावली के मुताबिक ओमन के गांवमन म लिखे गे रिहिस।</para>
  <para style="b" vid="1CH 9:22" />
  <para style="p" vid="1CH 9:22">दाऊद अऊ समूएल अगम-दरसी के दुवारा दुवारपालमन ला ओमन के भरोसा के पद म ठहिराय गे रिहिस <verse eid="1CH 9:22" /><verse number="23" style="v" sid="1CH 9:23" />ओमन अऊ ओमन के संतानमन यहोवा के भवन के दुवारमन म दुवारपालमन के अधिकारी रिहिन—भवन ला मिलापवाला तम्बू कहे जावय। <verse eid="1CH 9:23" /><verse number="24" style="v" sid="1CH 9:24" />दुवारपालमन चारों दिग म रिहिन: पूरब, पछिम, उत्तर अऊ दक्खिन। <verse eid="1CH 9:24" /><verse number="25" style="v" sid="1CH 9:25" />ओमन के संगी लेवीमन समय-समय म अपन-अपन गांवमन ले आवंय अऊ सात-सात दिन तक ओमन के काम म हांथ बटावंय। <verse eid="1CH 9:25" /><verse number="26" style="v" sid="1CH 9:26" />पर चार परधान दुवारपाल, जऊन मन लेवी रिहिन, ओमन ला परमेसर के भवन के कमरामन के अऊ खजानामन के जिम्मेदारी सऊंपे गे रिहिस। <verse eid="1CH 9:26" /><verse number="27" style="v" sid="1CH 9:27" />ओमन परमेसर के भवन के आसपास ही रथिया बितावंय, काबरकि ओमन ला ओकर पहरेदारी करना पड़य; अऊ रोज बिहनियां ओला खोले बर ओमन करा चाबी के जिम्मेदारी रहय।<verse eid="1CH 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 9:28" />ओमन म ले कुछू झन के ऊपर मंदिर के सेवा म उपयोग होवइया चीजमन के जिम्मेदारी रिहिस; ओमन ओ चीजमन ला गनंय, जब ओ चीजमन ला भीतर लाने जावय अऊ जब ओ चीजमन ला बाहिर लाने जावय। <verse eid="1CH 9:28" /><verse number="29" style="v" sid="1CH 9:29" />आने मन ला पबितर-स्थान के साजो-सामान अऊ आने जम्मो चीजमन के देखरेख करे बर ठहिराय गे रिहिस, येकर अलावा येमन ऊपर बिसेस पीसान अऊ अंगूर के मंद, अऊ जैतून तेल, धूप अऊ मसालामन के जिम्मेदारी रिहिस। <verse eid="1CH 9:29" /><verse number="30" style="v" sid="1CH 9:30" />पर कुछू पुरोहितमन मसाला तियार करे के काम करंय। <verse eid="1CH 9:30" /><verse number="31" style="v" sid="1CH 9:31" />मत्तितियाह नांव के एक लेवी, जऊन ह कोरही सल्लूम के पहिलांत बेटा रिहिस, ओकर ऊपर भेंट चघाय के रोटी ला सेंके के जिम्मेदारी रिहिस। <verse eid="1CH 9:31" /><verse number="32" style="v" sid="1CH 9:32" />ओमन के संगी लेवी, कुछू कहातीमन ऊपर हर बिसराम दिन म मेज ऊपर रखइया रोटी ला तियार करे के जिम्मेदारी रिहिस।<verse eid="1CH 9:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 9:33" />जेमन संगीतकार, लेवी परिवारमन के मुखिया रिहिन, ओमन मंदिर के कमरामन म रहंय अऊ ओमन आने काम नइं करंय, काबरकि ओमन रात अऊ दिन अपन काम बर जिम्मेदार रिहिन।<verse eid="1CH 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 9:34" />ये जम्मो झन अपन-अपन लेवी परिवार के मुखिया रिहिन; ओमन के बंसावली म ओमन के नांव मुखिया के रूप म लिखे गे रिहिस अऊ ओमन यरूसलेम म रहत रिहिन।<verse eid="1CH 9:34" /></para>
  <para style="s1">साऊल के बंसावली</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 9:35" />गिबोन के ददा येइल गिबोन सहर म रहय।</para>
  <para style="li2" vid="1CH 9:35">ओकर घरवाली के नांव माका रिहिस। <verse eid="1CH 9:35" /><verse number="36" style="v" sid="1CH 9:36" />ओकर पहिलांत बेटा अबदोन रिहिस, फेर जूर, कीस, बाल, नेर, नादाब, <verse eid="1CH 9:36" /><verse number="37" style="v" sid="1CH 9:37" />गदोर, अहियो, जकरयाह अऊ मिकलोत। <verse eid="1CH 9:37" /><verse number="38" style="v" sid="1CH 9:38" />मिकलोत ह सिमाम के ददा रिहिस। ओमन घलो अपन रिस्तेदारमन के लकठा म यरूसलेम म रहत रिहिन।<verse eid="1CH 9:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 9:39" />नेर ह कीस के ददा रिहिस, कीस ह साऊल के ददा रिहिस, अऊ साऊल ह योनातन, मलकी-सुआ, अबीनादाब, अऊ एस-बाल के ददा रिहिस।<verse eid="1CH 9:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 9:40" />योनातन के बेटा:</para>
  <para style="li2" vid="1CH 9:40">मरीब-बाल, जऊन ह मीका के ददा रिहिस।<verse eid="1CH 9:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 9:41" />मीका के बेटामन:</para>
  <para style="li2" vid="1CH 9:41">पीतोन, मेलेक, तारे अऊ आहाज।<verse eid="1CH 9:41" /></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 9:42" />आहाज ह यादा के ददा रिहिस, यादा ह आलेमेत, अजमावेत अऊ जिमरी के ददा रिहिस, अऊ जिमरी ह मोसा के ददा रिहिस। <verse eid="1CH 9:42" /><verse number="43" style="v" sid="1CH 9:43" />अऊ मोसा ह बीना के ददा रिहिस; अऊ बीना के बेटा रपायाह रिहिस, रपायाह के बेटा एलासा अऊ एलासा के बेटा आसेल रिहिस।<verse eid="1CH 9:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 9:44" />आसेल के छै बेटा रिहिन, अऊ ये ओमन के नांव अंय:</para>
  <para style="li2" vid="1CH 9:44">अजरीकाम, बोकेरू, इसमायल, सारयाह, ओबदयाह अऊ हानान। येमन आसेल के बेटा रिहिन।<verse eid="1CH 9:44" /></para>
  <chapter eid="1CH 9" />
  <chapter number="10" style="c" sid="1CH 10" />
  <para style="s1">साऊल ह अपनआप ला मार देथे</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1" />इही दौरान पलिस्तीमन इसरायलीमन ले लड़िन; इसरायलीमन ओमन ले हारके भाग गीन, अऊ बहुंते झन गिलबो नांव के पहाड़ म मारे गीन। <verse eid="1CH 10:1" /><verse number="2" style="v" sid="1CH 10:2" />पलिस्तीमन साऊल अऊ ओकर बेटामन के तेजी से पीछा करत रिहिन; अऊ ओमन ओकर बेटा योनातन, अबीनादाब अऊ मलकी-सुआ ला मार डारिन। <verse eid="1CH 10:2" /><verse number="3" style="v" sid="1CH 10:3" />साऊल के चारों कोति भयंकर लड़ई होय लगिस, अऊ जब धनुसधारीमन पीछा करके ओला घेर लीन, त ओमन ओला घायल कर दीन।<verse eid="1CH 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 10:4" />तब साऊल ह अपन हथियार ढोवइया ला कहिस, “अपन तलवार खींचके मोला भोंग दे, नइं तो ये खतनारहित मनखेमन आके मोर ठट्ठा करहीं।”</para>
  <para style="p" vid="1CH 10:4">पर ओकर हथियार ढोवइया ह डरके वइसने नइं करिस; तब साऊल ह अपन तलवार ला ठाढ़ करके ओकर ऊपर गिर गीस। <verse eid="1CH 10:4" /><verse number="5" style="v" sid="1CH 10:5" />जब हथियार ढोवइया ह देखिस कि साऊल ह मर गीस, त ओह घलो अपन तलवार ऊपर गिरके मर गीस। <verse eid="1CH 10:5" /><verse number="6" style="v" sid="1CH 10:6" />ये किसम ले साऊल अऊ ओकर तीनों बेटा मर गीन, अऊ ओकर घर के जम्मो झन एक संग मर गीन।<verse eid="1CH 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 10:7" />जब घाटी के जम्मो इसरायलीमन देखिन कि पूरा सेना के मनखेमन भाग गीन अऊ साऊल अऊ ओकर बेटामन मर गे हवंय, त ओमन अपन-अपन नगरमन ला छोंड़के भाग गीन। अऊ पलिस्तीमन आके ओ नगरमन ला अपन अधिकार म ले लीन।<verse eid="1CH 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8" />दूसर दिन जब पलिस्तीमन मरे मनखेमन के माल ला लूटे बर आईन, त ओमन ला साऊल अऊ ओकर बेटामन के लास गिलबो पहाड़ म मिलिस। <verse eid="1CH 10:8" /><verse number="9" style="v" sid="1CH 10:9" />ओमन साऊल के ओनहा ला उतारके ओकर मुड़ ला काटिन अऊ ओकर मुड़ ला ओकर हथियार संग ले गीन, अऊ पलिस्तीमन के पूरा देस म संदेसियामन ला पठोके अपन मूरती अऊ अपन मनखेमन के बीच ये संदेस के घोसना करवा दीन। <verse eid="1CH 10:9" /><verse number="10" style="v" sid="1CH 10:10" />ओमन साऊल के हथियार ला अपन देवतामन के मंदिर म रखिन अऊ ओकर मुड़ ला दागोन देवता के मंदिर म टांग दीन।<verse eid="1CH 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 10:11" />जब याबेस-गिलाद के जम्मो रहइयामन सुनिन कि पलिस्तीमन साऊल के संग का करे हवंय, <verse eid="1CH 10:11" /><verse number="12" style="v" sid="1CH 10:12" />त ओमन के जम्मो बहादुर आदमीमन गीन अऊ साऊल अऊ ओकर बेटामन के लास ला याबेस म ले आईन। तब ओमन साऊल अऊ ओकर बेटामन के हाड़ा ला याबेस म बड़े रूख के खाल्हे म गाड़ दीन, अऊ ओमन दुखी होके सात दिन तक उपास रखिन।<verse eid="1CH 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 10:13" />साऊल ह मर गीस, काबरकि ओह यहोवा के संग बिसवासघात करिस; ओह यहोवा के बचन के पालन नइं करिस; अऊ त अऊ ओह सलाह लेय बर एक भूतसिद्धी करइया ले मदद लीस, <verse eid="1CH 10:13" /><verse number="14" style="v" sid="1CH 10:14" />अऊ ओह यहोवा ले पुछताछ नइं करिस। एकरसेति यहोवा ह ओला मारके राज ला यिसै के बेटा दाऊद ला दे दीस।<verse eid="1CH 10:14" /></para>
  <chapter eid="1CH 10" />
  <chapter number="11" style="c" sid="1CH 11" />
  <para style="s1">दाऊद ह इसरायल के राजा बनथे</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1" />ओकर बाद जम्मो इसरायलीमन हेबरोन म दाऊद मेर आके कहिन, “सुन, हमन तोर खुद के मांस अऊ लहू अन। <verse eid="1CH 11:1" /><verse number="2" style="v" sid="1CH 11:2" />पहिले, जब साऊल ह राजा रिहिस, तब तेंहीच ह सैनिक अभियान म इसरायल के अगुवई करत रहय। अऊ यहोवा तोर परमेसर ह तोला कहे रिहिस, ‘तेंह मोर मनखे इसरायल के चरवाहा होबे, अऊ तेंह ओमन ऊपर सासन करबे।’ ”<verse eid="1CH 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 11:3" />जब इसरायल के जम्मो अगुवामन हेबरोन म राजा दाऊद करा आ गीन, त ओह हेबरोन म ओमन के संग यहोवा के आघू म एक करार करिस, अऊ समूएल के जरिये यहोवा के करे गय वायदा के मुताबिक, ओमन इसरायल ऊपर दाऊद ला राजा के रूप म अभिसेक करिन।<verse eid="1CH 11:3" /></para>
  <para style="s1">दाऊद ह यरूसलेम ऊपर जय पाथे</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4" />तब दाऊद ह जम्मो इसरायलीमन के संग यरूसलेम सहर गीस, (यरूसलेम ला यबूस घलो कहे जाथे)। जऊन यबूसीमन उहां रहत रिहिन, <verse eid="1CH 11:4" /><verse number="5" style="v" sid="1CH 11:5" />ओमन दाऊद ले कहिन, “तेंह इहां नइं आय पाबे।” तभो ले, दाऊद ह सियोन के गढ़ ऊपर कब्जा कर लीस—जऊन ह दाऊद के नगर अय।<verse eid="1CH 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 11:6" />दाऊद ह कहे रिहिस, “जऊन ह यबूसीमन ऊपर हमला करे म अगुवई करही, ओह मुखिया सेनापति होही।” तब सरूयाह के बेटा योआब ह सबले पहिले उहां गीस, अऊ ये किसम ले ओला सेनापति के पद दिये गीस।<verse eid="1CH 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 11:7" />तब दाऊद ह ओ गढ़ म रहे लगिस, अऊ ओकर खातिर ओला दाऊद के सहर कहे गीस। <verse eid="1CH 11:7" /><verse number="8" style="v" sid="1CH 11:8" />ओह एकर चारों कोति सहर ला बनाईस, छत ले लेके चारों कोति दीवार ला बनवाईस, जबकि योआब ह सहर के बाकि काम ला पूरा करिस। <verse eid="1CH 11:8" /><verse number="9" style="v" sid="1CH 11:9" />अऊ दाऊद ह अऊ जादा सक्तिसाली होवत गीस, काबरकि सर्वसक्तिमान यहोवा ह ओकर संग रिहिस।<verse eid="1CH 11:9" /></para>
  <para style="s1">दाऊद के बड़े सूरबीरमन</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10" />येमन दाऊद के बड़े सूरबीरमन के मुखिया रिहिन—यहोवा के वायदा के मुताबिक येमन जम्मो इसरायल के संग दाऊद के राज ला पूरा देस म फईलाय बर बहुंत सहयोग करिन— <verse eid="1CH 11:10" /><verse number="11" style="v" sid="1CH 11:11" />येह दाऊद के बड़े सूरबीरमन के सूची अय:</para>
  <para style="p" vid="1CH 11:11">एक हकमोनी के बेटा यासोबाम ह अधिकारीमन के मुखिया रिहिस; ओह तीन सौ आदमीमन ऊपर अपन बरछी उठाईस, अऊ ओमन ला एकेच मुकाबला म मार डारिस।<verse eid="1CH 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 11:12" />ओकर बाद अहोही दोदै के बेटा एलिआजर रिहिस, जऊन ह तीन बड़े योद्धा म ले एक झन रिहिस। <verse eid="1CH 11:12" /><verse number="13" style="v" sid="1CH 11:13" />ओह पस-दमीम म दाऊद के संग रिहिस, जब पलिस्तीमन उहां लड़ई बर जूरे रिहिन। ओ जगह जिहां जौ के फसल ले भरे एक खेत रिहिस, अऊ सेना ह पलिस्तीमन ले डरके भाग गीस। <verse eid="1CH 11:13" /><verse number="14" style="v" sid="1CH 11:14" />पर ओमन ओ खेत के बीच म ठाढ़ होके ओमन के सामना करिन। ओमन लड़िन अऊ पलिस्तीमन ला मार डारिन, अऊ यहोवा ह एक बड़े जीत देवाईस।<verse eid="1CH 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 11:15" />तीस मुखियामन ले तीन झन दाऊद करा चट्टान म आईन, जऊन ह अदुल्लाम के गुफा म रिहिस, जबकि पलिस्तीमन के एक दल ह रपाईम के घाटी म डेरा डाले रहय। <verse eid="1CH 11:15" /><verse number="16" style="v" sid="1CH 11:16" />ओ बेरा दाऊद ह गढ़ म रिहिस, अऊ पलिस्तीमन के गढ़ के सेना ह बैतलहम म रिहिस। <verse eid="1CH 11:16" /><verse number="17" style="v" sid="1CH 11:17" />दाऊद ला बहुंत पीयास लगिस, त ओह कहिस, “हाय, कोनो मोला बैतलहम के दुवार के लकठा के कुआं ले पानी लानके पीयावव!” <verse eid="1CH 11:17" /><verse number="18" style="v" sid="1CH 11:18" />तब ओ तीनों झन पलिस्तीमन के कतार ला टोरके बैतलहम के दुवार के लकठा के कुआं ले पानी निकालिन अऊ ओ पानी ला लेके दाऊद करा वापिस आ गीन। पर ओह ओ पानी ला पीये ले मना करिस; अऊ ओह ओ पानी ला यहोवा के आघू म ढार दीस। <verse eid="1CH 11:18" /><verse number="19" style="v" sid="1CH 11:19" />ओह कहिस, “परमेसर ह मोला अइसन काम करई ले दूरिहा रखय। का में ये आदमीमन के लहू पीयंव, जऊन मन अपन परान ला जोखिम म डालके उहां गे रिहिन?” काबरकि ओमन अपन परान ला जोखिम म डालके ओ पानी ला लाने रिहिन, एकरसेति ओह ओला नइं पीईस।</para>
  <para style="p" vid="1CH 11:19">ये तीनों बड़े सूरबीरमन के बीरता के काम अइसने रिहिस।<verse eid="1CH 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 11:20" />योआब के भाई अबीसै ह ओ तीनों झन के मुखिया रिहिस। ओह तीन सौ आदमीमन के बिरूध अपन बरछी उठाके ओमन ला मार डारिस, अऊ ये किसम ले ओह ओ तीनों के सहीं नामी हो गीस। <verse eid="1CH 11:20" /><verse number="21" style="v" sid="1CH 11:21" />ओला ओ तीनों ले दू गुना आदर मिलिस, अऊ ओह ओमन के सेनापति बनिस, हालाकि ओला ओ तीनों के बीच सामिल नइं करे गीस।<verse eid="1CH 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22" />यहोयादा के बेटा बनायाह ह कबसेल सहर के एक बड़े बीर रिहिस, अऊ ओह बहुंत बीरता देखाईस। ओह मोआब के दू झन सबले बड़े योद्धामन ला मार गिराईस। बरफ गिरे के दिन म, ओह खाल्हे एक खंचवा म उतरके एक सिंह ला घलो मार डारिस। <verse eid="1CH 11:22" /><verse number="23" style="v" sid="1CH 11:23" />अऊ ओह एक मिसरी मनखे ला मार डारिस, जऊन ह पांच क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">11:23 </char><char style="ft" closed="false">लगभग 7 फीट 6 ईंच</char></note> ऊंच रिहिस। हालाकि ओ मिसरी ह अपन हांथ म बुनकर के डोंगी असन एक ठन बरछी धरे रिहिस, पर बनायाह एक ठन बड़े लउठी लेके ओकर बिरूध गीस। ओह ओ मिसरी के हांथ ले बरछी ला छीन लीस अऊ ओकरेच बरछी ले ही ओला मार डारिस। <verse eid="1CH 11:23" /><verse number="24" style="v" sid="1CH 11:24" />यहोयादा के बेटा बनायाह के बीरता के काम अइसने रिहिस; ओह घलो ओ तीनों बड़े सूरबीरमन सहीं नामी रिहिस। <verse eid="1CH 11:24" /><verse number="25" style="v" sid="1CH 11:25" />ओला ओ तीस सूरबीरमन ले जादा आदर मिलिस, पर ओला ओ तीनों म सामिल नइं करे गीस। अऊ दाऊद ह ओला अपन अंग रकछकमन के मुखिया ठहिराईस।<verse eid="1CH 11:25" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="26" style="v" sid="1CH 11:26" />बड़े सूरबीरमन ये रिहिन:</para>
  <para style="b" vid="1CH 11:26" />
  <para style="li1" vid="1CH 11:26">योआब के भाई असाहेल,</para>
  <para style="li1" vid="1CH 11:26">बैतलहम के दोदो के बेटा एल्हानान,<verse eid="1CH 11:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 11:27" />हरोरी सम्मोत,</para>
  <para style="li1" vid="1CH 11:27">पलोनी हेलेस,<verse eid="1CH 11:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 11:28" />तकोआ ले इक्केस के बेटा ईरा,</para>
  <para style="li1" vid="1CH 11:28">अनातोत ले अबिएजेर,<verse eid="1CH 11:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 11:29" />हूसाती सिब्बकै,</para>
  <para style="li1" vid="1CH 11:29">अहोही ईलै,<verse eid="1CH 11:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 11:30" />नतोपाती महरै,</para>
  <para style="li1" vid="1CH 11:30">नतोपाती बाना के बेटा हेलेद,<verse eid="1CH 11:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 11:31" />बिनयामीन म गिबा ले रीबै के बेटा इतै,</para>
  <para style="li1" vid="1CH 11:31">पिरातोनी बनायाह,<verse eid="1CH 11:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 11:32" />गास के घाटीमन ले हूरै,</para>
  <para style="li1" vid="1CH 11:32">अरबात के अबीएल,<verse eid="1CH 11:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 11:33" />बहरूमी अजमावेत,</para>
  <para style="li1" vid="1CH 11:33">सालबोनी एल्यहबा,<verse eid="1CH 11:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 11:34" />गीजोनी हसेम के बेटामन,</para>
  <para style="li1" vid="1CH 11:34">हरारी सागे के बेटा योनातन,<verse eid="1CH 11:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 11:35" />हरारी साकार के बेटा अहीआम,</para>
  <para style="li1" vid="1CH 11:35">ऊर के बेटा एलीपाल,<verse eid="1CH 11:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 11:36" />मकेराती हेपेर,</para>
  <para style="li1" vid="1CH 11:36">पलोनी अहियाह,<verse eid="1CH 11:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 11:37" />करमेली हेसरो,</para>
  <para style="li1" vid="1CH 11:37">एजबै के बेटा नारै,<verse eid="1CH 11:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 11:38" />नातान के भाई योएल,</para>
  <para style="li1" vid="1CH 11:38">हगरी के बेटा मिभार,<verse eid="1CH 11:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 11:39" />अमोनी सेलेक,</para>
  <para style="li1" vid="1CH 11:39">बेरोती नहरै, जऊन ह सरूयाह के बेटा योआब के हथियार ढोवइया रिहिस,<verse eid="1CH 11:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 11:40" />येतेरी ईरा</para>
  <para style="li1" vid="1CH 11:40">येतेरी गारेब,<verse eid="1CH 11:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 11:41" />हित्ती उरियाह,</para>
  <para style="li1" vid="1CH 11:41">अहलै के बेटा जाबाद,<verse eid="1CH 11:41" /></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 11:42" />रूबेनी सीजा के बेटा अदीना, जऊन ह रूबेनीमन के मुखिया रिहिस, अऊ ये तीस झन ओकर संग रिहिन,<verse eid="1CH 11:42" /></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 11:43" />माका के बेटा हानान,</para>
  <para style="li1" vid="1CH 11:43">मितनी योसापात,<verse eid="1CH 11:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 11:44" />असतरोती उजियाह,</para>
  <para style="li1" vid="1CH 11:44">अरोएरी होताम के बेटा सामा अऊ येइल,<verse eid="1CH 11:44" /></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 11:45" />सिमरी के बेटा यदीएल</para>
  <para style="li1" vid="1CH 11:45">अऊ ओकर भाई तीसी योहा,<verse eid="1CH 11:45" /></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 11:46" />महवी के एलीएल,</para>
  <para style="li1" vid="1CH 11:46">एलनाम के बेटा यरीबै अऊ योसब्याह,</para>
  <para style="li1" vid="1CH 11:46">मोआबी यितमा,<verse eid="1CH 11:46" /></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 11:47" />एलीएल, ओबेद अऊ मसोबाई यासीएल।<verse eid="1CH 11:47" /></para>
  <chapter eid="1CH 11" />
  <chapter number="12" style="c" sid="1CH 12" />
  <para style="s1">योद्धामन दाऊद के संग मिल जाथें</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 12:1" />जब दाऊद ह सिकलग नगर म कीस के बेटा राजा साऊल के डर के मारे छिपे रिहिस, तब येमन ओ आदमी रिहिन, जेमन दाऊद करा आईन (येमन ओ योद्धामन के बीच म ले रिहिन, जेमन लड़ई म ओकर मदद करिन। <verse eid="1CH 12:1" /><verse number="2" style="v" sid="1CH 12:2" />येमन धनुस धरे रिहिन, अऊ जेवनी या डेरी हांथ ले तीर चलाय या गोफन के पथरा चलाय सकत रिहिन; येमन बिनयामीन के गोत्र ले साऊल के रिस्तेदार रिहिन):<verse eid="1CH 12:2" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="3" style="v" sid="1CH 12:3" />गिबाती समाआ के बेटामन अहीएजेर अऊ योआस; अहीएजेर ह ओमन के मुखिया रिहिस;</para>
  <para style="li1" vid="1CH 12:3">अजमावेत के बेटामन यजीएल अऊ पेलेत;</para>
  <para style="li1" vid="1CH 12:3">बराका अऊ अनातोती येहू, <verse eid="1CH 12:3" /><verse number="4" style="v" sid="1CH 12:4" />अऊ गिबोनी यिसमायाह, जऊन ह तीस म ले एक बड़े योद्धा रिहिस अऊ ओ तीस झन के एक अगुवा रिहिस;</para>
  <para style="li1" vid="1CH 12:4">फेर यरमियाह, यहजीएल, योहानान, गदेराती योजाबाद, <verse eid="1CH 12:4" /><verse number="5" style="v" sid="1CH 12:5" />एलूजै, यरीमोत, बाल्याह, समरयाह, हारूपी सपतयाह;<verse eid="1CH 12:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 12:6" />एलकाना, यिसियाह, अजरेल, योएजेर, यासोबाम, येमन जम्मो कोरहबंसी रिहिन;<verse eid="1CH 12:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 12:7" />अऊ गदोर नगर ले यरोहाम के बेटा योएला अऊ जबदयाह।<verse eid="1CH 12:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="1CH 12:8" />जब दाऊद ह निरजन प्रदेस म अपन गढ़ म रिहिस, त कुछू गादीमन अलग होके ओकर करा आ गीन। ओमन साहसी योद्धा रिहिन, लड़ई बर तियार अऊ ढाल अऊ बरछी चलाय म माहिर रिहिन। ओमन के मुहूं ह सिंह के मुहूं असन रिहिस, अऊ ओमन पहाड़ी हिरन असन तेज दऊड़नेवाला रिहिन।<verse eid="1CH 12:8" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="9" style="v" sid="1CH 12:9" />एजेर ह मुखिया रिहिस,</para>
  <para style="li1" vid="1CH 12:9">दूसरा ओबदयाह, तीसर एलीआब,<verse eid="1CH 12:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 12:10" />चौथा मिसमन्ना, पांचवां यरमियाह,<verse eid="1CH 12:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 12:11" />छठवां अत्तै, सातवां एलीएल,<verse eid="1CH 12:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 12:12" />आठवां योहानान, नौवां एलजाबाद,<verse eid="1CH 12:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 12:13" />दसवां यरमियाह अऊ गियारहवां मकबनै रिहिस।<verse eid="1CH 12:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="1CH 12:14" />ये गादीमन सेना के सेनापति रिहिन; ओमन म जऊन ह सबले छोटे रिहिस, ओह एक सौ के बराबर, अऊ जऊन ह सबले बड़े रिहिस ओह एक हजार के बराबर रिहिस। <verse eid="1CH 12:14" /><verse number="15" style="v" sid="1CH 12:15" />येमन ही ओ रिहिन, जेमन साल के पहिला महिना म यरदन नदी के ओ पार गीन, जब नदी म जम्मो किनारामन के ऊपर तक पानी बहत रिहिस, अऊ ओमन घाटीमन म रहइया जम्मो झन ला पूरब अऊ पछिम कोति भगा दीन।<verse eid="1CH 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 12:16" />यहूदा ले आने बिनयामीनी अऊ कुछू आदमीमन घलो दाऊद करा गढ़ म आईन। <verse eid="1CH 12:16" /><verse number="17" style="v" sid="1CH 12:17" />ओमन ले भेंट करे बर दाऊद निकलके गीस अऊ ओमन ला कहिस, “यदि तुमन मोर करा सांति के भाव म मोर मदद करे बर आय हव, त मेंह तियार हंव कि तुमन मोर संग जुड़ जावव। पर यदि तुमन धोखा देके मोला मोर बईरीमन के हांथ म पकड़वाय बर आय हवव, त हमर पुरखामन के परमेसर येला देखय अऊ तुम्हर नियाय करय, काबरकि मोर हांथमन कोनो गलत काम नइं करे हवंय।”<verse eid="1CH 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 12:18" />तब आतमा ह अमासै ऊपर आईस, जऊन ह तीस सूरबीरमन के मुखिया रिहिस, अऊ ओह कहिस,</para>
  <para style="q1" vid="1CH 12:18">“हे दाऊद, हमन तोर अन!</para>
  <para style="q2" vid="1CH 12:18">हे यिसै के बेटा! हमन तोर संग हवन!</para>
  <para style="q1" vid="1CH 12:18">तोला सफलता अऊ सफलता मिलय,</para>
  <para style="q2" vid="1CH 12:18">अऊ जऊन मन तोर मदद करथें, ओमन ला सफलता मिलय,</para>
  <para style="q3" vid="1CH 12:18">काबरकि तोर परमेसर तोर मदद करही।”</para>
  <para style="p" vid="1CH 12:18">एकर खातिर दाऊद ह ओमन ला स्वीकार करिस अऊ ओमन ला अपन हमला करइया दलमन के मुखिया बना दीस।<verse eid="1CH 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 12:19" />जब दाऊद ह पलिस्तीमन के संग साऊल के बिरूध लड़े बर गीस, मनस्से गोत्र के कुछू मनखे घलो आके दाऊद के संग मिल गीन। (ओह अऊ ओकर आदमीमन पलिस्तीमन के मदद नइं करिन, काबरकि, सलाह करे के बाद, पलिस्तीमन के सासकमन ओला वापिस भेज दीन। ओमन कहिन, “यदि ओह अपन मालिक संग मिल जाही, त ओह हमन के मुड़ ला कटवा दीही।”) <verse eid="1CH 12:19" /><verse number="20" style="v" sid="1CH 12:20" />जब दाऊद ह सिकलग गीस, त येमन मनस्से के ओ आदमीमन रिहिन, जेमन आके ओकर संग मिल गे रिहिन: अदना, योजाबाद, यदीएल, मिकाएल, योजाबाद, एलीहू अऊ सिल्लतै; येमन मनस्से के एक-एक हजार दल के मुखिया रिहिन। <verse eid="1CH 12:20" /><verse number="21" style="v" sid="1CH 12:21" />येमन हमला करइया दलमन के बिरूध दाऊद के मदद करिन, काबरकि ये जम्मो झन बीर योद्धा रिहिन, अऊ ओमन ओकर सेना म सेनापति रिहिन। <verse eid="1CH 12:21" /><verse number="22" style="v" sid="1CH 12:22" />दिनों-दिन आदमीमन दाऊद करा ओकर मदद करे बर आते रिहिन, जब तक कि ओकर करा एक बड़े सेना नइं हो गीस, परमेसर के सेना सहीं।<note caller="+" style="f"><char style="fr" closed="false">12:22 </char><char style="ft" closed="false">एक बड़े अऊ </char><char style="fqa" closed="false">सक्तिसाली सेना</char></note><verse eid="1CH 12:22" /></para>
  <para style="s1">आने मन हेबरोन म आके दाऊद के संग जुड़ गीन</para>
  <para style="lh">
    <verse number="23" style="v" sid="1CH 12:23" />येह ओ आदमीमन के संखिया ए, जेमन लड़ई बर हथियार बांधे हेबरोन म दाऊद करा आईन, ताकि यहोवा के कहे मुताबिक ओमन साऊल के राज ला दाऊद के हांथ म कर देवंय:<verse eid="1CH 12:23" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="24" style="v" sid="1CH 12:24" />यहूदा ले लड़ई बर ढाल अऊ बरछी लेके 6,800 हथियारवाले आदमी;<verse eid="1CH 12:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 12:25" />सिमोन ले लड़ई बर तियार योद्धामन 7,100;<verse eid="1CH 12:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 12:26" />लेवीमन ले 4,600 आदमी; <verse eid="1CH 12:26" /><verse number="27" style="v" sid="1CH 12:27" />हारून के परिवार के अगुवा यहोयादा ला मिलाके ओकर संग 3,700 आदमी, <verse eid="1CH 12:27" /><verse number="28" style="v" sid="1CH 12:28" />अऊ सादोक, एक बीर जवान योद्धा, अऊ ओकर संग ओकर परिवार के 22 अधिकारीमन;<verse eid="1CH 12:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 12:29" />साऊल के गोत्र, बिनयामीन ले 3,000; येमा के जादातर आदमीमन ओ समय तक साऊल के घराना के वफादार रिहिन;<verse eid="1CH 12:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 12:30" />एपरैम ले, बीर योद्धामन, अपन-अपन कुल म नामी रिहिन 20,800;<verse eid="1CH 12:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 12:31" />मनस्से के आधा गोत्र म ले, जेमन ला नामांकित करे गे रिहिस कि ओमन आके दाऊद ला राजा बनावंय 18,000;<verse eid="1CH 12:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 12:32" />इस्साकार ले, ओ आदमी, जेमन समय ला समझत रिहिन अऊ ये जानत रिहिन कि इसरायल ला का करना चाही 200 मुखियामन, संग म ओमन के अधीन ओमन के जम्मो रिस्तेदार।<verse eid="1CH 12:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 12:33" />जबूलून म ले, हर किसम के हथियार के संग लड़ई बर तियार अनुभवी सैनिक, जेमन पूरा वफादारी से दाऊद के मदद करे बर तियार रिहिन 50,000;<verse eid="1CH 12:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 12:34" />फेर नपताली म ले 1,000 अधिकारीमन ला मिलाके 37,000 आदमी, जेमन ढाल अऊ बरछी धरे रहंय;<verse eid="1CH 12:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 12:35" />दान म ले, लड़ई बर तियार आदमी 28,600;<verse eid="1CH 12:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 12:36" />अऊ आसेर म ले, लड़ई बर तियार अनुभवी सैनिक 40,000;<verse eid="1CH 12:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 12:37" />अऊ यरदन नदी के पूरब कोति रूबेन, गाद अऊ मनस्से के आधा गोत्र म ले, हर किसम के हथियार धरे आदमी 1,20,000 रिहिन।<verse eid="1CH 12:37" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="38" style="v" sid="1CH 12:38" />ये जम्मो के जम्मो योद्धा रिहिन अऊ अपन मरजी से सेना म मिले पद के मुताबिक सेवा करे बर तियार रिहिन।</para>
  <para style="b" vid="1CH 12:38" />
  <para style="p" vid="1CH 12:38">ओमन पूरा मनसा से दाऊद ला जम्मो इसरायल ऊपर राजा बनाय बर हेबरोन म आईन। बाकि बांचे जम्मो इसरायलीमन घलो दाऊद ला राजा बनाय बर एक हो गे रिहिन। <verse eid="1CH 12:38" /><verse number="39" style="v" sid="1CH 12:39" />आदमीमन उहां तीन दिन दाऊद के संग खावत-पीयत बिताईन, काबरकि ओमन के परिवार के मनखेमन<note caller="+" style="f"><char style="fr" closed="false">12:39 </char><char style="ft" closed="false">संगी इसरायलीमन</char></note> ओमन बर खाय-पीये के परबंध करिन। <verse eid="1CH 12:39" /><verse number="40" style="v" sid="1CH 12:40" />ओमन के दूरिहा-दूरिहा के पड़ोसी, जइसे कि इस्साकार, जबूलून अऊ नपताली गोत्र के मनखेमन घलो गदहा, ऊंट, खच्चर अऊ बईलामन के ऊपर खाय-पीये के सामान जोरके ओमन करा आईन। ओमा बहुंत अकन पीसान, अंजीर के टिकिया, किसमिस के टिकिया, अंगूर के मंद, जैतून तेल, गरूवा-बईला अऊ भेड़मन रिहिन, काबरकि इसरायल म आनंद मनाय जावत रिहिस।<verse eid="1CH 12:40" /></para>
  <chapter eid="1CH 12" />
  <chapter number="13" style="c" sid="1CH 13" />
  <para style="s1">सन्दूक ला वापिस लवई</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1" />कुछू समय बाद, दाऊद अपन हर एक अधिकारीमन ले, हजार-हजार के ऊपर ठहिराय सेनापति अऊ सौ-सौ के ऊपर ठहिराय सेनापतिमन ले सलाह-मसविरा करिस। <verse eid="1CH 13:1" /><verse number="2" style="v" sid="1CH 13:2" />ओह तब जम्मो इसरायली सभा ले कहिस, “यदि येह तुमन ला बने लगय अऊ यदि येह यहोवा हमर परमेसर के ईछा अय, त आवव, हमन दूरिहा-दूरिहा म बाकि बांचे हमर मनखेमन करा इसरायल के जम्मो इलाका म खबर पठोवन, अऊ ओमन के नगर अऊ चरागनमन म ओमन के संग रहइया पुरोहित अऊ लेवीमन करा घलो खबर पठोवन कि ओमन आवंय अऊ हमर संग सामिल हो जावंय। <verse eid="1CH 13:2" /><verse number="3" style="v" sid="1CH 13:3" />आवव, हमन अपन परमेसर के सन्दूक ला अपन इहां वापिस ले आवन, काबरकि साऊल के राज करे के दौरान हमन येकर बारे म पुछताछ नइं करेंन।” <verse eid="1CH 13:3" /><verse number="4" style="v" sid="1CH 13:4" />पूरा सभा ये बात म राजी रिहिस, काबरकि जम्मो मनखे ला ये बात बने लगिस।<verse eid="1CH 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 13:5" />तब किरयत-यारीम सहर ले परमेसर के सन्दूक ला लाने बर, दाऊद ह मिसर के सीहोर नदी ले लेके लेबो-हमात सहर तक जम्मो इसरायलीमन ला इकट्ठा करिस। <verse eid="1CH 13:5" /><verse number="6" style="v" sid="1CH 13:6" />दाऊद अऊ जम्मो इसरायलीमन यहूदा के बालाह (किरयत-यारीम) सहर करा गीन, ताकि ओ यहोवा परमेसर के सन्दूक ला ले आवंय, जऊन ह करूबमन के बीच म बिराजे हवय—ओ सन्दूक जेला यहोवा के नांव ले पुकारे जाथे।<verse eid="1CH 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 13:7" />ओमन परमेसर के सन्दूक ला एक ठन नवां गाड़ी म चढ़ाके अबीनादाब के घर ले निकालिन, अऊ उज्जा अऊ अहियो ओ गाड़ी ला हांकत रिहिन। <verse eid="1CH 13:7" /><verse number="8" style="v" sid="1CH 13:8" />दाऊद अऊ जम्मो इसरायलीमन परमेसर के आघू म तन-मन ले गीत गावत अऊ बीना, सारंगी, डफ, झांझ अऊ तुरही बजाके उत्सव मनात रिहिन।<verse eid="1CH 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 13:9" />जब ओमन कीदोन के कोठार मेर आईन, तब उज्जा ह सन्दूक ला संभाले बर अपन हांथ बढ़ाईस, काबरकि बईलामन लड़खड़ा गे रिहिन। <verse eid="1CH 13:9" /><verse number="10" style="v" sid="1CH 13:10" />तब यहोवा के कोरोध उज्जा के ऊपर भड़किस, अऊ ओह ओला मारिस, काबरकि ओह सन्दूक म अपन हांथ लगाय रिहिस। ओह ओहीच मेर परमेसर के आघू म मर गीस।<verse eid="1CH 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 13:11" />तब दाऊद ह गुस्सा होईस, काबरकि यहोवा के कोप ह उज्जा ऊपर भड़के रिहिस, अऊ आज तक ओ जगह ला पेरेस-उज्जा<note caller="+" style="f"><char style="fr" closed="false">13:11 </char><char style="fq" closed="false">पेरेस-उज्जा </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">उज्जा के बिरूध कोरोध</char></note> कहे जाथे।<verse eid="1CH 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 13:12" />ओ दिन दाऊद ह परमेसर ले डर गीस अऊ पुछिस, “मेंह परमेसर के सन्दूक ला कभू अपन इहां कइसे ला सकत हंव?” <verse eid="1CH 13:12" /><verse number="13" style="v" sid="1CH 13:13" />तब ओह सन्दूक ला अपन संग दाऊद के नगर म नइं ले गीस। पर ओह येला गत नगर के रहइया ओबेद-एदोम के घर ले गीस। <verse eid="1CH 13:13" /><verse number="14" style="v" sid="1CH 13:14" />अऊ परमेसर के सन्दूक ह ओबेद-एदोम के परिवार करा ओकर घर म तीन महिना तक रिहिस, अऊ यहोवा ह ओकर घराना अऊ ओकर जम्मो चीज ऊपर आसीस दीस।<verse eid="1CH 13:14" /></para>
  <chapter eid="1CH 13" />
  <chapter number="14" style="c" sid="1CH 14" />
  <para style="s1">दाऊद के घर अऊ परिवार</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1" />सूर के राजा हीराम ह दाऊद करा दूतमन ला पठोईस, अऊ संग म ओकर बर एक महल बनाय बर देवदार के लकड़ी अऊ राज-मिसतिरी अऊ बढ़ईमन ला घलो पठोईस। <verse eid="1CH 14:1" /><verse number="2" style="v" sid="1CH 14:2" />तब दाऊद ला निस्चय हो गे रिहिस कि यहोवा ह ओला इसरायल ऊपर राजा के रूप म इस्थिर करे हवय अऊ अपन मनखे इसरायलीमन के हित म ओकर राज ला बहुंत उठाय हवय।<verse eid="1CH 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 14:3" />यरूसलेम म दाऊद ह अऊ कतको माईलोगनमन ला अपन घरवाली बना लीस अऊ ओकर कतको बेटा अऊ बेटीमन पईदा होईन। <verse eid="1CH 14:3" /><verse number="4" style="v" sid="1CH 14:4" />येमन ओ लइकामन के नांव अंय, जेमन उहां ओकर ले जनमिन: सम्मू, सोबाब, नातान, सुलेमान, <verse eid="1CH 14:4" /><verse number="5" style="v" sid="1CH 14:5" />यिभार, एलीसू, एलपेलेत, <verse eid="1CH 14:5" /><verse number="6" style="v" sid="1CH 14:6" />नोगह, नेपेग, यापी, <verse eid="1CH 14:6" /><verse number="7" style="v" sid="1CH 14:7" />एलीसामा, बेल्यादा<note caller="+" style="f"><char style="fr" closed="false">14:7 </char><char style="fq" closed="false">बेल्यादा </char><char style="ft" closed="false">ह एक आने नांव ए </char><char style="fqa" closed="false">एलयादा</char></note> अऊ एलीपेलेत।<verse eid="1CH 14:7" /></para>
  <para style="s1">दाऊद ह पलिस्तीमन ला हराथे</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8" />जब पलिस्तीमन सुनिन कि जम्मो इसरायल के ऊपर राजा के रूप म दाऊद के अभिसेक करे गे हवय, त ओमन पूरा सेना लेके दाऊद के खोज म निकलिन, पर दाऊद ह येकर बारे म सुनिस अऊ ओमन के सामना करे बर निकलिस। <verse eid="1CH 14:8" /><verse number="9" style="v" sid="1CH 14:9" />पलिस्तीमन आके रपाईम के घाटी म धावा बोल दे रहंय। <verse eid="1CH 14:9" /><verse number="10" style="v" sid="1CH 14:10" />तब दाऊद ह परमेसर ले पुछताछ करिस, “का मेंह जाके पलिस्तीमन ऊपर हमला करंव? का तेंह ओमन ला मोर हांथ म कर देबे?”</para>
  <para style="p" vid="1CH 14:10">यहोवा ह ओला जबाब दीस, “जा, मेंह ओमन ला तोर हांथ म कर दूहूं।”<verse eid="1CH 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 14:11" />तब दाऊद अऊ ओकर आदमीमन बाल-परासीम नगर गीन, अऊ उहां दाऊद ह ओमन ला हरा दीस। ओह कहिस, “जइसे पानी के धारा ह फूट निकलथे, वइसे ही परमेसर ह मोर हांथ के दुवारा मोर बईरीमन ला फोर दे हवय।” एकरसेति ओ जगह ला बाल-परासीम<note caller="+" style="f"><char style="fr" closed="false">14:11 </char><char style="fq" closed="false">बाल-परासीम </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">परभू जऊन ह फोर देथे</char></note> कहे गीस। <verse eid="1CH 14:11" /><verse number="12" style="v" sid="1CH 14:12" />पलिस्तीमन उहां अपन देवतामन ला छोंड़ दे रिहिन, अऊ दाऊद ह हुकूम दीस कि ओमन ला आगी म जला देय जावय।<verse eid="1CH 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13" />एक बार फेर पलिस्तीमन घाटी ऊपर हमला करिन; <verse eid="1CH 14:13" /><verse number="14" style="v" sid="1CH 14:14" />तब दाऊद ह परमेसर ले फेर पुछताछ करिस, अऊ परमेसर ह जबाब दीस, “ओमन कोति सीधा झन जा, पर ओमन के चारों कोति घेरा डाल अऊ चिनार रूखमन के आघू म ओमन ऊपर हमला कर। <verse eid="1CH 14:14" /><verse number="15" style="v" sid="1CH 14:15" />जतेक जल्दी तेंह चिनार रूखमन के पान ऊपर म सेना के चले के खरखराहट ला सुनबे, त लड़ई करे बर निकलबे, काबरकि ओकर ये मतलब होही कि परमेसर ह पलिस्ती सेना ला मारे बर तोर आघू गे हवय।” <verse eid="1CH 14:15" /><verse number="16" style="v" sid="1CH 14:16" />तब दाऊद ह वइसे ही करिस, जइसे परमेसर ह ओला हुकूम देय रिहिस, अऊ ओमन पलिस्ती सेना ला पूरा गिबोन सहर ले लेके गेजेर नगर तक मार डारिन।<verse eid="1CH 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 14:17" />तब दाऊद के नांव हर देस म फईल गीस, अऊ यहोवा ह जम्मो जाति के मनखेमन के मन म दाऊद के डर पईदा कर दीस।<verse eid="1CH 14:17" /></para>
  <chapter eid="1CH 14" />
  <chapter number="15" style="c" sid="1CH 15" />
  <para style="s1">सन्दूक ला यरूसलेम लाय जाथे</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1" />दाऊद के नगर म अपन बर भवन बनवाय के बाद, दाऊद ह परमेसर के सन्दूक बर एक ठन जगह तियार करिस अऊ येकर बर एक ठन तम्बू खड़े करिस। <verse eid="1CH 15:1" /><verse number="2" style="v" sid="1CH 15:2" />तब दाऊद ह कहिस, “लेवीमन के छोंड़ अऊ कोनो परमेसर के सन्दूक ला उठाके झन ले जावंय, काबरकि यहोवा ह ओमन ला यहोवा के सन्दूक ला उठाके ले जाय बर अऊ ओकर आघू म हमेसा सेवा-टहल करे बर चुने हवय।”<verse eid="1CH 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 15:3" />तब दाऊद ह जम्मो इसरायलीमन ला यरूसलेम म ये खातिर इकट्ठा करिस कि यहोवा के सन्दूक ला ओ जगह म लानंय, जेला ओह येकर खातिर तियार करे रिहिस।<verse eid="1CH 15:3" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="4" style="v" sid="1CH 15:4" />दाऊद ह हारून के संतान अऊ लेवीमन ला इकट्ठा करिस:<verse eid="1CH 15:4" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="5" style="v" sid="1CH 15:5" />कहात के संतानमन ले,</para>
  <para style="li2" vid="1CH 15:5">उरीएल नांव के अगुवा अऊ ओकर 120 झन रिस्तेदार;<verse eid="1CH 15:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 15:6" />मरारी के संतानमन ले,</para>
  <para style="li2" vid="1CH 15:6">असायाह नांव के अगुवा अऊ ओकर 220 झन रिस्तेदार;<verse eid="1CH 15:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 15:7" />गेरसोन<note caller="+" style="f"><char style="fr" closed="false">15:7 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">गेरसोम</char></note> के संतानमन ले,</para>
  <para style="li2" vid="1CH 15:7">योएल नांव के अगुवा अऊ ओकर 130 झन रिस्तेदार;<verse eid="1CH 15:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 15:8" />एलीसापान के संतानमन ले,</para>
  <para style="li2" vid="1CH 15:8">समायाह नांव के अगुवा अऊ ओकर 200 रिस्तेदारमन;<verse eid="1CH 15:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 15:9" />हेबरोन के संतानमन ले,</para>
  <para style="li2" vid="1CH 15:9">एलीएल नांव के अगुवा अऊ ओकर 80 रिस्तेदारमन;<verse eid="1CH 15:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 15:10" />अऊ उजीएल के संतानमन ले,</para>
  <para style="li2" vid="1CH 15:10">अमीनादाब नांव के अगुवा अऊ ओकर 112 रिस्तेदारमन।<verse eid="1CH 15:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="1CH 15:11" />तब दाऊद ह सादोक अऊ अबियातार पुरोहितमन ला, अऊ उरीएल, असायाह, योएल, समायाह, एलीएल अऊ अमीनादाब नांव के लेवीमन ला बुलवाईस <verse eid="1CH 15:11" /><verse number="12" style="v" sid="1CH 15:12" />अऊ ओह ओमन ले कहिस, “तुमन तो लेवी परिवारमन के मुखिया अव; तुमन अऊ तुम्हर संगी लेवीमन अपनआप ला पबितर करव अऊ इसरायल के परमेसर यहोवा के सन्दूक ला ओ जगह म ले आवव, जेला मेंह येकर बर तियार करे हंव। <verse eid="1CH 15:12" /><verse number="13" style="v" sid="1CH 15:13" />काबरकि पहिली बार तुम, लेवीमन ओला उठाके नइं लानेव, एकर कारन यहोवा हमर परमेसर के गुस्सा हमर ऊपर भड़किस। हमन ओकर ले पुछताछ नइं करेंन कि बताय गय तरीका म येला कइसे करे जावय।” <verse eid="1CH 15:13" /><verse number="14" style="v" sid="1CH 15:14" />तब पुरोहित अऊ लेवीमन इसरायल के परमेसर, यहोवा के सन्दूक ला लाने बर अपनआप ला पबितर करिन। <verse eid="1CH 15:14" /><verse number="15" style="v" sid="1CH 15:15" />अऊ लेवीमन परमेसर के सन्दूक ला ओमा लगे डंडामन ला धरके उठाईन अऊ अपन कंधा म रखके ले चलिन, जइसे कि मूसा ह यहोवा के बचन मुताबिक हुकूम दे रिहिस।<verse eid="1CH 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 15:16" />दाऊद ह लेवीमन के अगुवामन ला कहिस कि ओमन अपन संगी लेवीमन ला संगीतकार ठहिरावंय ताकि ओमन आनंद के संग बाजा याने कि सारंगी, बीना अऊ झांझ बजावंय अऊ गावंय।<verse eid="1CH 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 15:17" />तब लेवीमन योएल के बेटा हेमान ला; ओकर रिस्तेदारमन ले बेरेकियाह के बेटा आसाप ला; अऊ ओमन के रिस्तेदार मरारीमन ले कुसायाह के बेटा एतान ला ठहिराईन। <verse eid="1CH 15:17" /><verse number="18" style="v" sid="1CH 15:18" />ओमन के संग ओमन के रिस्तेदार, जेमन ओकर बाद के पद म रिहिन: जकरयाह, बेन, याजीएल, समीरामोत, यहीएल, उन्नी, एलीआब, बनायाह, मासेयाह, मत्तितियाह, एलीपलेह, मिकनेयाह, अऊ ओबेद-एदोम अऊ येइल, जऊन मन दुवारपाल रिहिन।<verse eid="1CH 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 15:19" />हेमान, आसाप अऊ एतान नांव के संगीतकारमन कांसा के झांझमन ला बजावंय; <verse eid="1CH 15:19" /><verse number="20" style="v" sid="1CH 15:20" />जकरयाह, अजीएल, समीरामोत, यहीएल, उन्नी, एलीआब, मासेयाह, अऊ बनायाह, <char style="tl">अलामोत</char> नांव के राग म सारंगी ला बजावंय, <verse eid="1CH 15:20" /><verse number="21" style="v" sid="1CH 15:21" />अऊ मत्तितियाह, एलीपलेह, मिकनेयाह, ओबेद-एदोम, येइल अऊ अजजियाह, <char style="tl">सेमिनित</char> नांव के राग म अगुवई करत बीनामन ला बजावंय। <verse eid="1CH 15:21" /><verse number="22" style="v" sid="1CH 15:22" />कननियाह नांव के लेवी ह गवइयामन के मुखिया रिहिस; ओह ओकर जिम्मेदारी रिहिस, काबरकि ओह ओ काम म माहिर रिहिस।<verse eid="1CH 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 15:23" />बेरेकियाह अऊ एलकाना सन्दूक के दुवारपाल रिहिन। <verse eid="1CH 15:23" /><verse number="24" style="v" sid="1CH 15:24" />सबनियाह, योसापात, नतनेल, अमासै, जकरयाह, बनायाह अऊ एलिएजेर नांव के पुरोहितमन परमेसर के सन्दूक के आघू-आघू तुरही बजावंय। ओबेद-एदोम अऊ यहियाह घलो सन्दूक के दुवारपाल रिहिन।<verse eid="1CH 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 15:25" />ये किसम ले, दाऊद अऊ इसरायलीमन के अगुवा अऊ एक-एक हजार दल के सेनापतिमन चलिन कि ओमन यहोवा के करार के सन्दूक ला ओबेद-एदोम के घर ले आनंद के संग ले आवंय। <verse eid="1CH 15:25" /><verse number="26" style="v" sid="1CH 15:26" />काबरकि परमेसर ह ओ लेवीमन के मदद करिस, जेमन यहोवा के करार के सन्दूक ला उठाके ले जावत रिहिन, त सात ठन बईला अऊ सात ठन मेढ़ा ला बलि करे गीस। <verse eid="1CH 15:26" /><verse number="27" style="v" sid="1CH 15:27" />दाऊद ह सुघर मलमल के ओनहा पहिरे रिहिस, संग म सन्दूक उठाके ले जवइया जम्मो लेवीमन, अऊ संगीतकारमन, अऊ गीत गवइयामन के मुखिया कननियाह घलो सुघर मलमल के ओनहा पहिरे रिहिन। दाऊद ह मलमल के एक एपोद घलो पहिरे रिहिस। <verse eid="1CH 15:27" /><verse number="28" style="v" sid="1CH 15:28" />ये किसम ले, जम्मो इसरायलीमन यहोवा के करार के सन्दूक ला जय-जयकार करत, अऊ नरसिंगा, अऊ तुरही, अऊ झांझ अऊ सारंगी अऊ बीना बजात ले आईन।<verse eid="1CH 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 15:29" />जब यहोवा के करार के सन्दूक ह दाऊद के नगर म प्रवेस करत रिहिस, त साऊल के बेटी मीकल ह खिड़की ले झांकके देखिस। जब ओह दाऊद राजा ला नाचत अऊ खुसी मनात देखिस, त ओह अपन मन म ओला तुछ समझिस।<verse eid="1CH 15:29" /></para>
  <chapter eid="1CH 15" />
  <chapter number="16" style="c" sid="1CH 16" />
  <para style="s1">सन्दूक के आघू म सेवा करई</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1" />ओमन परमेसर के सन्दूक ला लानके ओ तम्बू के भीतर म रख दीन, जऊन ला दाऊद ह ओकर बर बनाय रिहिस, अऊ ओमन परमेसर के आघू म होम-बलिदान अऊ मेल-बलिदान चघाईन। <verse eid="1CH 16:1" /><verse number="2" style="v" sid="1CH 16:2" />जब दाऊद ह होम-बलिदान अऊ मेल-बलिदान चघा लीस, त ओह यहोवा के नांव म मनखेमन ला आसीस दीस। <verse eid="1CH 16:2" /><verse number="3" style="v" sid="1CH 16:3" />तब ओह हर एक इसरायली आदमी अऊ माईलोगन ला एक-एक ठन रोटी अऊ एक-एक ठन खजूर के टिकिया अऊ एक-एक ठन किसमिस के टिकिया बंटवाईस।<verse eid="1CH 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 16:4" />तब दाऊद ह कुछू लेवीमन ला ठहिराईस कि ओमन यहोवा के सन्दूक के आघू म यहोवा, इसरायल के परमेसर के इस्तुति, धनबाद अऊ परसंसा करे के दुवारा सेवा करंय: <verse eid="1CH 16:4" /><verse number="5" style="v" sid="1CH 16:5" />आसाप ह मुखिया रिहिस, अऊ ओकर बाद जकरयाह के पद रिहिस, फेर याजीएल, समीरामोत, यहीएल, मत्तितियाह, एलीआब, बनायाह, ओबेद-एदोम अऊ येइल रिहिन। येमन ला सारंगी अऊ बीना बजाना रिहिस, अऊ आसाप ला झांझ बजाना रिहिस, <verse eid="1CH 16:5" /><verse number="6" style="v" sid="1CH 16:6" />बनायाह अऊ यहजीएल नांव के पुरोहितमन ला परमेसर के करार के सन्दूक के आघू म लगातार तुरही बजाना रिहिस।<verse eid="1CH 16:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="1CH 16:7" />ओ दिन दाऊद ह आसाप अऊ ओकर सहायकमन ला ठहिराईस कि ओमन ये तरीका ले यहोवा के परसंसा करंय:<verse eid="1CH 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 16:8" />यहोवा के परसंसा करव, ओकर नांव के घोसना करव;</para>
  <para style="q2" vid="1CH 16:8">जाति-जाति के मनखेमन के बीच म ओकर करे गे काम ला बतावव।<verse eid="1CH 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 16:9" />ओकर गीत गावव, ओकर परसंसा के गीत गावव;</para>
  <para style="q2" vid="1CH 16:9">ओकर जम्मो अद्भूत काम के बखान करव।<verse eid="1CH 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 16:10" />ओकर पबितर नांव के महिमा होवय;</para>
  <para style="q2" vid="1CH 16:10">जऊन मन यहोवा के खोज करथें, ओमन के मन आनंदित होवय।<verse eid="1CH 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 16:11" />यहोवा अऊ ओकर बल के खोज म रहव;</para>
  <para style="q2" vid="1CH 16:11">हमेसा ओकर दरसन के खोज म रहव।<verse eid="1CH 16:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="1CH 16:12" />ओकर करे गे अद्भूत काम,</para>
  <para style="q2" vid="1CH 16:12">ओकर चमतकार, अऊ ओकर दिये गय नियाय ला सुरता करव,<verse eid="1CH 16:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 16:13" />हे ओकर सेवक, इसरायल के संतानमन,</para>
  <para style="q2" vid="1CH 16:13">हे ओकर चुने गय मनखे, याकूब के लइकामन।<verse eid="1CH 16:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 16:14" />ओह यहोवा हमर परमेसर ए;</para>
  <para style="q2" vid="1CH 16:14">जम्मो धरती म ओकर नियाय हवय।<verse eid="1CH 16:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="1CH 16:15" />ओह अपन करे गे करार,</para>
  <para style="q2" vid="1CH 16:15">हजार पीढ़ी के मनखेमन बर करे गे वायदा,<verse eid="1CH 16:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 16:16" />अब्राहम के संग करे गे करार,</para>
  <para style="q2" vid="1CH 16:16">इसहाक के संग खाय गे सपथ ला सदाकाल बर सुरता रखथे।<verse eid="1CH 16:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 16:17" />ओह येला याकूब के संग एक बिधि के रूप म,</para>
  <para style="q2" vid="1CH 16:17">इसरायल के संग हमेसा के एक करार के रूप म ये कहिके मजबूत करिस:<verse eid="1CH 16:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 16:18" />“तोला मेंह कनान देस दूहूं,</para>
  <para style="q2" vid="1CH 16:18">एक निज भाग के रूप म तोला ओह मिलही।”<verse eid="1CH 16:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="1CH 16:19" />जब ओमन गनती म थोरकन ही रिहिन,</para>
  <para style="q2" vid="1CH 16:19">वास्तव म थोरकन रिहिन, अऊ ओ देस म अजनबी रिहिन,<verse eid="1CH 16:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 16:20" />त ओमन एक जाति ले आने जाति,</para>
  <para style="q2" vid="1CH 16:20">अऊ एक राज ले दूसर राज म भटकत रिहिन।<verse eid="1CH 16:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 16:21" />पर परमेसर ह कोनो ला ओमन ला सताय नइं दीस;</para>
  <para style="q2" vid="1CH 16:21">ओमन के हित म, ओह राजामन ला दबकारिस:<verse eid="1CH 16:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 16:22" />“मोर अभिसिक्त मनखेमन ला झन छुवव;</para>
  <para style="q2" vid="1CH 16:22">मोर अगमजानीमन के कुछू हानि झन करव।”<verse eid="1CH 16:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="1CH 16:23" />हे धरती के जम्मो मनखेमन, यहोवा बर गीत गावव,</para>
  <para style="q2" vid="1CH 16:23">ओकर उद्धार के सुसमाचार हर दिन सुनात रहव।<verse eid="1CH 16:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 16:24" />जाति-जाति के मनखेमन के बीच म ओकर महिमा के,</para>
  <para style="q2" vid="1CH 16:24">अऊ जम्मो मनखेमन के बीच ओकर अद्भूत काम के बखान करव।<verse eid="1CH 16:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="1CH 16:25" />काबरकि यहोवा ह महान अऊ अति परसंसा के योग्य अय;</para>
  <para style="q2" vid="1CH 16:25">ओह जम्मो देवतामन ले जादा भय के योग्य अय।<verse eid="1CH 16:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 16:26" />काबरकि जाति-जाति के जम्मो देवतामन सिरिप मूरती अंय,</para>
  <para style="q2" vid="1CH 16:26">पर यहोवा ह स्वरग ला बनाईस।<verse eid="1CH 16:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 16:27" />सोभा अऊ वैभव ओकर आघू म हवय;</para>
  <para style="q2" vid="1CH 16:27">ताकत अऊ आनंद ओकर निवास स्थान म हवय।<verse eid="1CH 16:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="1CH 16:28" />हे जाति-जाति के जम्मो परिवारमन, यहोवा के बखान करव,</para>
  <para style="q2" vid="1CH 16:28">यहोवा के महिमा अऊ बल के बखान करव।<verse eid="1CH 16:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="1CH 16:29" />यहोवा के नांव के मुताबिक ओकर बखान करव;</para>
  <para style="q2" vid="1CH 16:29">भेंट लेके ओकर आघू म आवव।</para>
  <para style="q1" vid="1CH 16:29">पबितरता ले सोभायमान होके यहोवा के अराधना करव।<verse eid="1CH 16:29" /></para>
  <para style="q2">
    <verse number="30" style="v" sid="1CH 16:30" />हे धरती के जम्मो मनखेमन, ओकर आघू म कांपव!</para>
  <para style="q2" vid="1CH 16:30">संसार ला मजबूती से स्थापित करे गे हवय; येला हटाय नइं जा सकय।<verse eid="1CH 16:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="1CH 16:31" />अकास ह आनंद मनावय, धरती ह खुस होवय;</para>
  <para style="q2" vid="1CH 16:31">ओमन जाति-जाति के मनखेमन के बीच म कहंय, “यहोवा राज करथे!”<verse eid="1CH 16:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="1CH 16:32" />समुंदर अऊ ओमा के जम्मो चीजमन गरजंय;</para>
  <para style="q2" vid="1CH 16:32">भुइयां अऊ ओमा के हर एक चीज बहुंत आनंदित होवंय!<verse eid="1CH 16:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 16:33" />जंगल के रूखमन गीत गावंय,</para>
  <para style="q2" vid="1CH 16:33">ओमन यहोवा के आघू म आनंद के गीत गावंय,</para>
  <para style="q2" vid="1CH 16:33">काबरकि ओह धरती के नियाय करे बर आवत हे।<verse eid="1CH 16:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="1CH 16:34" />यहोवा ला धनबाद देवव, काबरकि ओह बने अय;</para>
  <para style="q2" vid="1CH 16:34">ओकर मया हमेसा बने रहिथे।<verse eid="1CH 16:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 16:35" />ओला पुकारव, “हमर उद्धार करइया परमेसर, हमन ला बचा;</para>
  <para style="q2" vid="1CH 16:35">हमन ला इकट्ठा कर अऊ हमन ला जाति-जाति के मनखेमन ले छुड़ा,</para>
  <para style="q1" vid="1CH 16:35">ताकि हमन तोर पबितर नांव ला धनबाद देवन,</para>
  <para style="q2" vid="1CH 16:35">अऊ तोर परसंसा म बड़ई करन।”<verse eid="1CH 16:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 16:36" />आदिकाल ले अनंतकाल तक,</para>
  <para style="q2" vid="1CH 16:36">यहोवा, इसरायल के परमेसर के परसंसा होवय।</para>
  <para style="m" vid="1CH 16:36">तब जम्मो मनखेमन कहिन, “आमीन” अऊ “यहोवा के परसंसा होवय।”<verse eid="1CH 16:36" /></para>
  <para style="b" />
  <para style="p">
    <verse number="37" style="v" sid="1CH 16:37" />तब दाऊद ह आसाप अऊ ओकर सहायकमन ला यहोवा के करार के सन्दूक के आघू म छोंड़ दीस, ताकि ओमन उहां हर दिन के जरूरत के मुताबिक लगातार सेवा करंय। <verse eid="1CH 16:37" /><verse number="38" style="v" sid="1CH 16:38" />ओह ओबेद-एदोम अऊ ओकर अड़सठ सहायकमन ला घलो ओमन के संग सेवा करे बर छोंड़ दीस। यदूतून के बेटा ओबेद-एदोम अऊ होसा घलो दुवारपाल रिहिन।<verse eid="1CH 16:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 16:39" />दाऊद ह सादोक पुरोहित अऊ ओकर संगी पुरोहितमन ला यहोवा के पबितर-तम्बू के आघू म, जऊन ह गिबोन के ऊंचहा जगह म हवय, ठहिरा दीस, <verse eid="1CH 16:39" /><verse number="40" style="v" sid="1CH 16:40" />ताकि ओमन लगातार बिहनियां अऊ संझा के बेरा, होम-बलिदान के बेदी म यहोवा ला होम-बलिदान चघावंय अऊ ये जम्मो काम यहोवा के कानून म लिखे मुताबिक करंय, जऊन ला यहोवा ह इसरायल ला देय रिहिस। <verse eid="1CH 16:40" /><verse number="41" style="v" sid="1CH 16:41" />ओमन के संग हेमान अऊ यदूतून अऊ बाकि बांचे ओ आने मन घलो रिहिन, जऊन मन ला नांव लेके चुने गे रिहिस, ताकि ओमन यहोवा के नांव के धनबाद ये किसम ले करंय, “ओकर मया सदाकाल तक बने रहिथे।” <verse eid="1CH 16:41" /><verse number="42" style="v" sid="1CH 16:42" />हेमान अऊ यदूतून के ऊपर तुरही अऊ झांझमन ला बजाय के अऊ पबितर गीत गाय के बेरा आने बाजामन ला बजाय के जिम्मेदारी रिहिस। यदूतून के बेटामन ला दुवार के रखवारी करे बर ठहिराय गे रिहिस।<verse eid="1CH 16:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 16:43" />तब जम्मो मनखेमन अपन-अपन घर चले गीन, अऊ दाऊद ह अपन परिवार ला आसीस देय बर अपन घर लहुंट गीस।<verse eid="1CH 16:43" /></para>
  <chapter eid="1CH 16" />
  <chapter number="17" style="c" sid="1CH 17" />
  <para style="s1">दाऊद बर परमेसर के वायदा</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1" />जब दाऊद ह अपन महल म रहे लगिस, त ओह नातान अगमजानी ला कहिस, “देख, मेंह देवदार रूख ले बने घर म रहत हंव, जबकि यहोवा के करार के सन्दूक ह एक तम्बू म हवय।”<verse eid="1CH 17:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 17:2" />नातान ह दाऊद ला कहिस, “जऊन कुछू तोर मन म हवय, ओला कर, काबरकि परमेसर ह तोर संग हवय।”<verse eid="1CH 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 17:3" />पर ओहीच रथिया परमेसर के ये बचन नातान मेर आईस:<verse eid="1CH 17:3" /></para>
  <para style="pm">
    <verse number="4" style="v" sid="1CH 17:4" />“जाके मोर सेवक दाऊद ला कह, ‘यहोवा ह ये कहत हे: तेंह ओ मनखे नो हस, जऊन ह मोर रहे बर घर बनाबे। <verse eid="1CH 17:4" /><verse number="5" style="v" sid="1CH 17:5" />जब ले मेंह इसरायल ला मिसर देस ले निकालके लाने हंव, ओ दिन ले लेके आज तक मेंह कोनो घर म नइं रहे हंव। मेंह एक तम्बू ले दूसर तम्बू, एक निवास ले दूसर निवास म रहत आय हंव। <verse eid="1CH 17:5" /><verse number="6" style="v" sid="1CH 17:6" />जिहां-जिहां मेंह जम्मो इसरायलीमन के संग गेंव, का मेंह कभू ओमन के ऊपर सासन करइयामन ले, जेमन ला मेंह अपन इसरायली मनखेमन ऊपर अगुवा ठहिराय रहेंव, ओमन ले कोनो ला अइसन बात कहेंव, “तेंह मोर बर देवदार लकड़ी के घर काबर नइं बनवाय?” ’<verse eid="1CH 17:6" /></para>
  <para style="pm">
    <verse number="7" style="v" sid="1CH 17:7" />“एकरसेति अब, मोर सेवक दाऊद ले कह, ‘सर्वसक्तिमान यहोवा ह ये कहत हे: मेंह तोला चरागन ले, भेड़-बकरीमन ला चराय के काम ले लेंव, अऊ मोर इसरायली मनखेमन ऊपर सासन करइया ठहिरांय। <verse eid="1CH 17:7" /><verse number="8" style="v" sid="1CH 17:8" />जिहां घलो तें गे, उहां में तोर संग रहेंव, अऊ मेंह तोर जम्मो बईरीमन ला तोर आघू ले नास कर देंव। अब मेंह तोर नांव ला धरती के सबले बड़े मनखेमन के नांव सहीं बड़े करहूं। <verse eid="1CH 17:8" /><verse number="9" style="v" sid="1CH 17:9" />अऊ मेंह अपन इसरायली मनखेमन बर एक जगह ठहिराहूं अऊ मेंह ओमन ला बसाहूं ताकि ओमन के अपन खुद के घर होवय अऊ ओमन फेर कभू एती-ओती झन होवंय। दुस्ट मनखेमन फेर ओमन ऊपर अतियाचार नइं करहीं, जइसने कि ओमन सुरू म करत रिहिन <verse eid="1CH 17:9" /><verse number="10" style="v" sid="1CH 17:10" />अऊ ओ बेरा ले करत आवत हें, जब मेंह अपन इसरायली मनखेमन ऊपर अगुवामन ला ठहिरांय। मेंह तोर जम्मो बईरीमन ला दबा दूहूं।</para>
  <para style="pm" vid="1CH 17:10">“ ‘मेंह तोला बतात हंव कि यहोवा ह तोर बर एक घर बनाही: <verse eid="1CH 17:10" /><verse number="11" style="v" sid="1CH 17:11" />जब तोर उमर ह पूरा हो जाही अऊ तेंह अपन पुरखामन संग मिल जाबे, त मेंह तोर संतान ला तोर जगह लेय बर ठाढ़ करहूं अऊ ओह तोर बेटामन ले एक झन होही, अऊ मेंह ओकर राज ला इस्थिर करहूं। <verse eid="1CH 17:11" /><verse number="12" style="v" sid="1CH 17:12" />ओही ह मोर बर एक घर बनाही, अऊ मेंह ओकर सिंघासन ला हमेसा बर इस्थिर करहूं। <verse eid="1CH 17:12" /><verse number="13" style="v" sid="1CH 17:13" />मेंह ओकर ददा होहूं, अऊ ओह मोर बेटा होही। मेंह ओकर ऊपर ले मोर मया ला कभू नइं हटाहूं, जइसे कि मेंह तोर ले पहिले के राजामन ले हटाय रहेंव। <verse eid="1CH 17:13" /><verse number="14" style="v" sid="1CH 17:14" />मेंह ओला मोर घर अऊ मोर राज ऊपर हमेसा बर इस्थिर करहूं; ओकर सिंघासन ह सदा बने रहिही।’ ”<verse eid="1CH 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 17:15" />नातान ह दरसन के हर एक बात दाऊद ला बता दीस।<verse eid="1CH 17:15" /></para>
  <para style="s1">दाऊद के पराथना</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16" />तब दाऊद राजा ह भीतर जाके यहोवा के आघू म बईठ गीस, अऊ कहिस:</para>
  <para style="pm" vid="1CH 17:16">“हे यहोवा, परमेसर, मेंह कोन अंव, अऊ मोर घराना का ए, कि तेंह मोला इहां तक लाने हस? <verse eid="1CH 17:16" /><verse number="17" style="v" sid="1CH 17:17" />अऊ हे मोर परमेसर, मानो येह तोर नजर म परयाप्त नइं रिहिस कि तेंह अपन सेवक के घराना के भविस्य के बारे म गोठियाय। हे यहोवा, परमेसर, तेंह मोला अइसे देखे हस, मानो मेंह मनखेमन म सबले ऊंच पदवाला अंव।<verse eid="1CH 17:17" /></para>
  <para style="pm">
    <verse number="18" style="v" sid="1CH 17:18" />“तेंह अपन सेवक ला जऊन आदर दे हस, ओकर बारे म दाऊद ह का कह सकत हे? काबरकि हे यहोवा, तेंह अपन सेवक ला जानत हस। <verse eid="1CH 17:18" /><verse number="19" style="v" sid="1CH 17:19" />अपन सेवक के हित म अऊ अपन ईछा के मुताबिक, तेंह ये बड़े काम करे हस अऊ ये जम्मो बड़े बातमन ला बताय हस।<verse eid="1CH 17:19" /></para>
  <para style="pm">
    <verse number="20" style="v" sid="1CH 17:20" />“हे यहोवा, जइसे कि हमन अपन कान ले सुने हवन, तोर सहीं अऊ कोनो नइं ए, अऊ तोला छोंड़ अऊ कोनो परमेसर नइं ए। <verse eid="1CH 17:20" /><verse number="21" style="v" sid="1CH 17:21" />अऊ तोर मनखे इसरायल के सहीं कोन हे—धरती ऊपर के एक जाति, जेला अपन नांव के खातिर तें परमेसर ह जाके छोंड़ाय, अऊ अपन मनखेमन के आघू ले जाति-जाति के मनखेमन ला निकालके बड़े अऊ अद्भूत काम करे, अऊ ओमन ला मिसर देस ले छोंड़ाय। <verse eid="1CH 17:21" /><verse number="22" style="v" sid="1CH 17:22" />तेंह अपन मनखे इसरायलीमन ला हमेसा बर अपन खुद के मनखे बनाय हस, अऊ हे यहोवा, तेंह ओमन के परमेसर बने हस।<verse eid="1CH 17:22" /></para>
  <para style="pm">
    <verse number="23" style="v" sid="1CH 17:23" />“अब, हे यहोवा, तेंह अपन सेवक अऊ ओकर घराना के बारे म जऊन वायदा करे हस, ओला सदाकाल तक बनाय रख। अपन वायदा के मुताबिक ही कर, <verse eid="1CH 17:23" /><verse number="24" style="v" sid="1CH 17:24" />ताकि येह स्थापित होवय अऊ तोर नांव ह सदाकाल बर महान रहय। तब मनखेमन कहिहीं, ‘सर्वसक्तिमान यहोवा, इसरायल ऊपर परमेसर ही इसरायल के परमेसर अय!’ अऊ तोर सेवक दाऊद के घराना ह तोर आघू म इस्थिर होही।<verse eid="1CH 17:24" /></para>
  <para style="pm">
    <verse number="25" style="v" sid="1CH 17:25" />“हे मोर परमेसर, तेंह येला अपन सेवक ऊपर परगट करे हस कि तेंह ओकर बर एक घर बनाबे। एकरसेति तोर सेवक ला तोर ले पराथना करे के हिम्मत मिले हवय। <verse eid="1CH 17:25" /><verse number="26" style="v" sid="1CH 17:26" />हे यहोवा, तेंह परमेसर अस! तेंह ये बने चीजमन के वायदा अपन सेवक ले करे हस। <verse eid="1CH 17:26" /><verse number="27" style="v" sid="1CH 17:27" />अब तेंह खुस होके अपन सेवक के घराना ला आसीस दे हस, कि येह तोर नजर म हमेसा बने रहय; काबरकि हे यहोवा, तेंह येला आसीस दे हस, अऊ येह हमेसा आसीसित होही।”<verse eid="1CH 17:27" /></para>
  <chapter eid="1CH 17" />
  <chapter number="18" style="c" sid="1CH 18" />
  <para style="s1">दाऊद के बिजय</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1" />कुछू समय के बाद, दाऊद ह पलिस्तीमन ला हराके ओमन ला अपन अधीन कर लीस, अऊ गत नगर अऊ ओकर आसपास के गांवमन ला पलिस्तीमन के हांथ ले छीन लीस।<verse eid="1CH 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 18:2" />दाऊद ह मोआबीमन ला घलो लड़ई म हराईस अऊ ओमन ओकर अधीन होके ओला कर पटाय लगिन।<verse eid="1CH 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3" />येकर छोंड़, दाऊद ह सोबा के राजा हददेजेर ला हमात के इलाका म हराईस, जब हददेजेर ह फरात नदी करा अपन स्मारक बनाय बर<note caller="+" style="f"><char style="fr" closed="false">18:3 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">अपन अधीन करे बर</char></note> जावत रिहिस। <verse eid="1CH 18:3" /><verse number="4" style="v" sid="1CH 18:4" />दाऊद ह ओकर एक हजार रथ, सात हजार सारथी अऊ बीस हजार पैदल सैनिकमन ला छीन लीस। ओह एक सौ रथवाले घोड़ामन ला छोंड़के बाकि जम्मो घोड़ामन के माड़ी के पाछू के नस ला कटवा दीस।<verse eid="1CH 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 18:5" />जब दमिस्क के अरामीमन सोबा के राजा हददेजेर के मदद करे बर आईन, त दाऊद ह ओमन के बाईस हजार मनखेमन ला मार डारिस। <verse eid="1CH 18:5" /><verse number="6" style="v" sid="1CH 18:6" />दाऊद ह दमिस्क के अरामी राज म सैनिक दलमन ला ठहिरा दीस, अऊ अरामीमन ओकर अधीन हो गीन अऊ ओला कर पटाय लगिन। दाऊद ह जिहां घलो गीस, यहोवा ह ओला जीतवाईस।<verse eid="1CH 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 18:7" />दाऊद ह हददेजेर के अधिकारीमन के सोन के ढालमन ला ले लीस अऊ ओ ढालमन ला यरूसलेम ले आईस। <verse eid="1CH 18:7" /><verse number="8" style="v" sid="1CH 18:8" />येकर अलावा, दाऊद ह हददेजेर के तेबह<note caller="+" style="f"><char style="fr" closed="false">18:8 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">तिभत</char></note> अऊ कून नांव के नगरमन ले बहुंत अकन कांसा ले आईस, जेकर उपयोग सुलेमान ह कांसा के हौद, खंभा अऊ कांसा के आने चीजमन ला बनाय म करिस।<verse eid="1CH 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9" />जब हमात के राजा तोऊ ह सुनिस कि दाऊद ह सोबा के राजा हददेजेर के पूरा सेना ला हरा दे हवय, <verse eid="1CH 18:9" /><verse number="10" style="v" sid="1CH 18:10" />त ओह अपन बेटा हदोराम ला दाऊद राजा करा पठोईस, ताकि ओह ओकर ले भेंट करके हददेजेर के ऊपर लड़ई म मिले जीत बर बधाई देवय, काबरकि हददेजेर ह तोऊ ले लड़ई करत रिहिस। हदोराम ह सोन, चांदी अऊ कांसा के जम्मो किसम के चीजमन ला लेके आईस।<verse eid="1CH 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 18:11" />दाऊद राजा ह ये चीजमन ला यहोवा बर अरपन कर दीस, जइसे कि ओह ओ चांदी अऊ सोन के संग करे रिहिस, जेला ओह ये जम्मो जाति—एदोम अऊ मोआब, अमोनी अऊ पलिस्ती, अऊ अमालेकीमन ले लेय रिहिस।<verse eid="1CH 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 18:12" />सरूयाह के बेटा अबीसै ह नून के घाटी म अठारह हजार एदोमीमन ला मार डारिस। <verse eid="1CH 18:12" /><verse number="13" style="v" sid="1CH 18:13" />ओह एदोम म सैनिक दलमन के पहरा बईठा दीस, अऊ जम्मो एदोमीमन दाऊद के अधीन हो गीन। दाऊद ह जिहां घलो गीस, यहोवा ह ओला जीतवाईस।<verse eid="1CH 18:13" /></para>
  <para style="s1">दाऊद के करमचारीमन</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 18:14" />दाऊद ह जम्मो इसरायल ऊपर राज करिस अऊ ओ काम करिस, जऊन ह ओकर जम्मो मनखेमन बर ठीक अऊ सही रिहिस।<verse eid="1CH 18:14" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="15" style="v" sid="1CH 18:15" />सरूयाह के बेटा योआब ह सेना के सेनापति रिहिस;</para>
  <para style="li1" vid="1CH 18:15">अहीलूद के बेटा यहोसापात ह इतिहास के लेखक रिहिस;<verse eid="1CH 18:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 18:16" />अहीतूब के बेटा सादोक अऊ अबियातार के बेटा अहीमेलेक<note caller="+" style="f"><char style="fr" closed="false">18:16 </char><char style="ft" closed="false">जादा इबरानी हस्तलिपि म </char><char style="fqa" closed="false">अबीमेलेक</char></note> पुरोहित रिहिन;</para>
  <para style="li1" vid="1CH 18:16">सावसा ह सचिव रिहिस;<verse eid="1CH 18:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 18:17" />यहोयादा के बेटा बनायाह ह करेती अऊ पलेतीमन के अधिकारी रिहिस;</para>
  <para style="li1" vid="1CH 18:17">अऊ दाऊद के बेटामन राजा करा मुखिया अधिकारी रिहिन।<verse eid="1CH 18:17" /></para>
  <chapter eid="1CH 18" />
  <chapter number="19" style="c" sid="1CH 19" />
  <para style="s1">दाऊद ह अमोनीमन ला हराथे</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1" />कुछू समय के बाद, अमोनीमन के राजा नाहास ह मर गीस, अऊ ओकर बेटा ओकर जगह म राजा बनिस। <verse eid="1CH 19:1" /><verse number="2" style="v" sid="1CH 19:2" />दाऊद ह सोचिस, “मेंह नाहास के बेटा हानून ऊपर दया करहूं, काबरकि ओकर ददा मोर ऊपर दया करे रिहिस।” एकरसेति दाऊद ह अपन एक परतिनिधि-मंडल ला हानून करा ओकर ददा के बारे म सहानुभूति परगट करे बर पठोईस।</para>
  <para style="p" vid="1CH 19:2">जब दाऊद के दूतमन अमोनीमन के देस म हानून करा सहानुभूति परगट करे बर आईन, <verse eid="1CH 19:2" /><verse number="3" style="v" sid="1CH 19:3" />त अमोनी सेनापतिमन हानून ला कहिन, “का तेंह ये सोचत हस कि दाऊद ह तोर संग सहानुभूति देखाय बर दूतमन ला पठोय के दुवारा तोर ददा के आदर करत हे? का ओकर दूतमन तोर करा सिरिप देस के खोजबीन अऊ भेद लेय बर अऊ येला उखान फेंके बर नइं आय हवंय?” <verse eid="1CH 19:3" /><verse number="4" style="v" sid="1CH 19:4" />एकरसेति हानून ह दाऊद के दूतमन ला पकड़ लीस, अऊ ओमन के बाल मुड़वाके ओमन के ओनहा ला कुलामन तक कटवा दीस अऊ ओमन ला वापिस भेज दीस।<verse eid="1CH 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 19:5" />जब एक मनखे ह आके दाऊद ला ओकर मनखेमन के बारे म बताईस, त ओह संदेसियामन ला ओमन ले मिले बर पठोईस, काबरकि ओमन के बहुंत बेजत्ती करे गे रिहिस। राजा ह ओमन करा ये खबर पठोईस, “जब तक तुम्हर दाढ़ी बाढ़ नइं जावय, तब तक तुमन यरीहो सहर म ठहिरे रहव, अऊ तब वापिस आ जावव।”<verse eid="1CH 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6" />जब अमोनीमन ला महसूस होईस कि ओमन दाऊद ला नराज कर दे हवंय, त हानून अऊ अमोनीमन लगभग एक हजार टेलेन्ट<note caller="+" style="f"><char style="fr" closed="false">19:6 </char><char style="ft" closed="false">लगभग 38 टन</char></note> चांदी अरम-नहरैम, अरम-माका अऊ सोबा ला देके रथ अऊ सारथीमन ला किराया म लीन। <verse eid="1CH 19:6" /><verse number="7" style="v" sid="1CH 19:7" />ओमन बत्तीस हजार रथ अऊ सारथीमन ला किराया म लीन, संग म माका के राजा ह अपन सेना लेके मेदबा नगर के लकठा म डेरा डालिस, जबकि अमोनीमन अपन-अपन नगर ले निकलके जूरिन अऊ लड़ई बर आघू बढ़िन।<verse eid="1CH 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 19:8" />ये सुनके, दाऊद ह योआब ला योद्धामन के जम्मो सेना के संग पठोईस। <verse eid="1CH 19:8" /><verse number="9" style="v" sid="1CH 19:9" />अमोनीमन बाहिर निकलिन अऊ अपन सहर के प्रवेस दुवार करा लड़ई बर कतार बांधिन, जबकि राजामन, जऊन मन लड़ई बर आय रिहिन, खुला मैदान म रिहिन।<verse eid="1CH 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 19:10" />योआब ह देखिस कि ओकर आघू अऊ पाछू दूनों कोति ओकर बिरूध लड़ई बर कतार बांधे गे हवय; त ओह इसरायल के सबले बढ़िया कुछू सैनिक दलमन ला चुनिस अऊ ओमन ला अरामीमन के बिरूध ठहिरा दीस। <verse eid="1CH 19:10" /><verse number="11" style="v" sid="1CH 19:11" />ओह बाकि बांचे आदमीमन ला अपन भाई अबीसै के अधीन कर दीस, अऊ ओमन ला अमोनीमन के बिरूध तैनात कर दीस। <verse eid="1CH 19:11" /><verse number="12" style="v" sid="1CH 19:12" />योआब ह कहिस, “यदि अरामीमन मोर ऊपर भारी होवन लगंय, त तुमन मोर मदद करे बर आहू; अऊ यदि अमोनीमन तुम्हर ऊपर भारी होवन लगहीं, त मेंह आके तुम्हर मदद करहूं। <verse eid="1CH 19:12" /><verse number="13" style="v" sid="1CH 19:13" />मजबूत बनव, अऊ आवव, हमन अपन मनखे अऊ अपन परमेसर के सहरमन बर हिम्मत से लड़ई करन। यहोवा ह ओही करही, जऊन ह ओकर नजर म सही अय।”<verse eid="1CH 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 19:14" />तब योआब अऊ ओकर संग के सैनिक दल अरामीमन ले लड़े बर आघू बढ़िन, अऊ अरामीमन ओकर आघू ले भाग गीन। <verse eid="1CH 19:14" /><verse number="15" style="v" sid="1CH 19:15" />जब अमोनीमन देखिन कि अरामीमन भागत हवंय, त ओमन घलो ओकर भाई अबीसै के आघू ले भागिन अऊ सहर के भीतर चल दीन। तब योआब ह यरूसलेम लहुंट गीस।<verse eid="1CH 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 19:16" />जब अरामीमन देखिन कि ओमन इसरायलीमन ले हार गे हवंय, त ओमन दूतमन ला पठोईन अऊ फरात नदी के ओ पार ले अरामीमन ला बुलवाईन, अऊ हददेजेर के सेना के सेनापति सोपक ओमन के अगुवई करत रहय।<verse eid="1CH 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 19:17" />जब दाऊद ला ये बात बताय गीस, त ओह जम्मो इसरायलीमन ला इकट्ठा करिस अऊ यरदन नदी के ओ पार गीस; ओह ओमन के बिरूध आघू बढ़िस अऊ ओमन के बिरूध लड़ई के दल बांधिस। दाऊद ह लड़ई म अरामीमन के सामना करे बर अपन दल बांधिस, अऊ ओमन ओकर ले लड़िन। <verse eid="1CH 19:17" /><verse number="18" style="v" sid="1CH 19:18" />पर ओमन इसरायलीमन के आघू ले भाग गीन, दाऊद ह ओमन के सात हजार सारथी अऊ चालीस हजार पैदल सैनिकमन ला मार डारिस। ओह ओमन के सेना के सेनापति सोपक ला घलो मार डारिस।<verse eid="1CH 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 19:19" />जब हददेजेर के सेवकमन देखिन कि ओमन इसरायलीमन ले हार गे हवंय, त ओमन दाऊद संग समझौता कर लीन अऊ ओकर अधीन हो गीन।</para>
  <para style="p" vid="1CH 19:19">ओकर बाद, अरामीमन अमोनीमन के फेर मदद करे नइं चाहिन।<verse eid="1CH 19:19" /></para>
  <chapter eid="1CH 19" />
  <chapter number="20" style="c" sid="1CH 20" />
  <para style="s1">रब्बा ऊपर कब्जा करे जवई</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1" />बसन्त के मौसम म, जब राजामन लड़ई करे बर निकलथें, त योआब ह सेना के अगुवई करत रिहिस। ओह अमोनीमन के देस ला उजाड़ दीस अऊ ओह रब्बा म जाके ओला अपन अधिकार म कर लीस, पर दाऊद ह यरूसलेम म ही रिहिस। योआब ह रब्बा ऊपर हमला करके ओला नास कर दीस। <verse eid="1CH 20:1" /><verse number="2" style="v" sid="1CH 20:2" />दाऊद ह ओमन के राजा<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="ft" closed="false">या ओमन के देवता </char><char style="fqa" closed="false">मिलकोम </char><char style="ft" closed="false">या ओला </char><char style="fqa" closed="false">मोलेक </char><char style="ft" closed="false">भी कहे जाथे</char></note> के मुड़ ले मुकुट ला ले लीस—येह सोन के बने रिहिस अऊ येकर वजन एक टेलेन्ट<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="ft" closed="false">लगभग 34 किलोग्राम</char></note> रिहिस, अऊ येमा कीमती पथरामन जड़े रिहिन—अऊ ये मुकुट ला दाऊद के मुड़ म रखे गीस। दाऊद ह ओ सहर ले बहुंत अकन सामान लूटके ले गीस <verse eid="1CH 20:2" /><verse number="3" style="v" sid="1CH 20:3" />अऊ उहां के मनखेमन ला बाहिर निकाल लीस अऊ ओमन ला आरी, रांपा अऊ टंगिया देके ओमन ले मजदूरी करवाईस। दाऊद ह अमोनी नगरमन के जम्मो मनखेमन के संग अइसने ही करिस। तब दाऊद अऊ ओकर पूरा सेना यरूसलेम लहुंट गीस।<verse eid="1CH 20:3" /></para>
  <para style="s1">पलिस्तीमन संग लड़ई</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4" />समय के बीतत, गेजेर नगर म पलिस्तीमन ले लड़ई होय लगिस। ओ बेरा हूसाती सिब्बकै ह सिप्पै ला मार डारिस, जऊन ह रपाईमन के एक संतान रिहिस, अऊ पलिस्तीमन अधीन म हो गीन।<verse eid="1CH 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 20:5" />पलिस्तीमन ले फेर एक लड़ई म, याईर के बेटा एल्हानान ह गत सहर के रहइया गोलियत के भाई लहमी ला मार डारिस, जेकर बरछी के मुठिया ह बुनकर के डोंगी सहीं रिहिस।<verse eid="1CH 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 20:6" />एक अऊ लड़ई गत म होईस, जिहां एक बहुंत बड़े डीलडौलवाला आदमी रिहिस, जेकर हर हांथ अऊ गोड़ म छै-छै ठन अंगरी रिहिस—कुल चौबीस ठन अंगरी। ओह घलो रापा के संतान रिहिस। <verse eid="1CH 20:6" /><verse number="7" style="v" sid="1CH 20:7" />जब ओह इसरायल ला ताना मारिस, त दाऊद के भाई सिमा के बेटा योनातन ह ओला मार डारिस।<verse eid="1CH 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 20:8" />येमन गत के रहइया रापा के संतान रिहिन, अऊ ओमन दाऊद अऊ ओकर आदमीमन के हांथ म मारे गीन।<verse eid="1CH 20:8" /></para>
  <chapter eid="1CH 20" />
  <chapter number="21" style="c" sid="1CH 21" />
  <para style="s1">दाऊद ह सैनिकमन के गनती करथे</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1" />सैतान ह इसरायल के बिरूध काम करे लगिस अऊ ओह दाऊद ला इसरायल के गनती करे बर उकसाईस। <verse eid="1CH 21:1" /><verse number="2" style="v" sid="1CH 21:2" />एकरसेति दाऊद ह योआब अऊ सेना के सेनापतिमन ला हुकूम दीस, “जावव अऊ बेरसेबा ले लेके दान तक इसरायलीमन के गनती करव अऊ आके मोला बतावव ताकि मेंह जानंव कि ओमन कतेक हवंय।”<verse eid="1CH 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 21:3" />पर योआब ह जबाब दीस, “यहोवा ह इसरायल के मनखेमन ला सौ गुना बढ़ावय। हे मोर मालिक, हे राजा, का ओ जम्मो मोर मालिक के अधीन नइं एं? मोर मालिक अइसे काबर करे चाहथे? ओह इसरायल ऊपर दोस लाने के कारन काबर बनय?”<verse eid="1CH 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 21:4" />राजा ह योआब के बात ला नइं मानिस; एकरसेति योआब ह उहां ले चल दीस अऊ जम्मो इसरायल देस म गीस अऊ तब यरूसलेम वापिस आ गीस। <verse eid="1CH 21:4" /><verse number="5" style="v" sid="1CH 21:5" />योआब ह दाऊद ला सैनिकमन के गनती बताईस: जम्मो इसरायल म गियारह लाख आदमी रिहिन, जऊन मन तलवार चला सकत रिहिन, येमा यहूदा के चार लाख सत्तर हजार मनखे घलो रिहिन।<verse eid="1CH 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 21:6" />पर योआब ह लेवी अऊ बिनयामीन के बंस के गनती नइं करिस, राजा के हुकूम ह ओला बने नइं लगत रिहिस। <verse eid="1CH 21:6" /><verse number="7" style="v" sid="1CH 21:7" />ये हुकूम ह परमेसर के नजर म घलो गलत रिहिस; एकरसेति ओह इसरायल ला सजा दीस।<verse eid="1CH 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 21:8" />तब दाऊद ह परमेसर ला कहिस, “मेंह अइसे करके बहुंत पाप करे हंव। अब, मेंह तोर ले बिनती करत हंव कि अपन सेवक के दोस ला दूर कर दे। मेंह एक बहुंत मुरूखता के काम करे हंव।”<verse eid="1CH 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 21:9" />यहोवा ह दाऊद के अगम-दरसी गाद ला कहिस, <verse eid="1CH 21:9" /><verse number="10" style="v" sid="1CH 21:10" />“जा अऊ दाऊद ला बता, ‘यहोवा ह ये कहत हे: मेंह तोर आघू म तीन बात रखत हंव। ओमा ले कोनो एक ठन ला चुन ले जेला में तोर बिरूध करहूं।’ ”<verse eid="1CH 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 21:11" />तब गाद ह दाऊद करा गीस अऊ ओला कहिस, “यहोवा ह ये कहत हे: ‘तेंह एक ठन ला चुन ले: <verse eid="1CH 21:11" /><verse number="12" style="v" sid="1CH 21:12" />तीन साल तक अकाल, तीन महिना तक तोर बईरीमन तोला तलवार ले नास करंय<note caller="+" style="f"><char style="fr" closed="false">21:12 </char><char style="ft" closed="false">(देखव <char style="xt"><ref loc="2SA 24:13">2 समू 24:13</ref></char>) </char><char style="fqa" closed="false">बईरीमन के आघू ले भगई</char></note>, या फेर तीन दिन तक यहोवा के तलवार चले—याने कि देस म महामारी फईलय अऊ यहोवा के दूत ह इसरायल के हर भाग ला नास करय।’ अब तें निरनय कर कि मेंह ओला का जबाब दंव, जऊन ह मोला पठोय हवय।”<verse eid="1CH 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 21:13" />दाऊद ह गाद ला कहिस, “मेंह बड़े संकट म पड़े हंव। मोला यहोवा के हांथ म पड़न दे, काबरकि ओकर दया बहुंत बड़े अय; पर मोला मनखेमन के हांथ म झन पड़न दे।”<verse eid="1CH 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 21:14" />तब यहोवा ह इसरायल ऊपर एक महामारी लानिस, अऊ इसरायल के सत्तर हजार मनखे मर गीन। <verse eid="1CH 21:14" /><verse number="15" style="v" sid="1CH 21:15" />अऊ परमेसर ह यरूसलेम ला नास करे बर एक स्वरगदूत ला पठोईस। पर जब स्वरगदूत ह नास करत रिहिस, त यहोवा ह येला देखिस अऊ बिपत्ति के बारे म ओकर मन ह पिघल गीस अऊ ओह मनखेमन ला नास करइया ओ स्वरगदूत ला कहिस, “बहुंत हो गे! अपन हांथ ला खींच ले।” ओ समय यहोवा के स्वरगदूत ह ओरनान नांव के एक यबूसी के कोठार म ठाढ़े रिहिस।<verse eid="1CH 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 21:16" />दाऊद ह आंखी उठाके देखिस कि यहोवा के दूत ह अकास अऊ धरती के बीच म एक तलवार खींचके खड़े रहय अऊ ओ तलवार ह यरूसलेम कोति बढ़े हवय। तब दाऊद अऊ अगुवामन बोरा के कपड़ा पहिरे मुहूं के बल गिरके दंडवत करिन।<verse eid="1CH 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 21:17" />दाऊद ह परमेसर ले कहिस, “का ओह में नो हंव, जऊन ह लड़ई म जवइया मनखेमन के गनती करे के हुकूम देय रहेंव? में, चरवाहा<note caller="+" style="f"><char style="fr" closed="false">21:17 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="2SA 24:17">2 समू 24:17</ref></char></char></note> ह पाप करे हंव अऊ गलत काम करे हंव। येमन तो भेड़ अंय। येमन का करे हवंय? हे यहोवा मोर परमेसर, तोर हांथ ह मोर अऊ मोर परिवार ऊपर उठे, पर तोर मनखेमन ऊपर ये महामारी झन रहय।”<verse eid="1CH 21:17" /></para>
  <para style="s1">दाऊद ह एक बेदी बनाथे</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18" />तब यहोवा के स्वरगदूत ह गाद ला हुकूम दीस कि ओह दाऊद ले कहय कि दाऊद ह जाके यबूसी ओरनान के कोठार म यहोवा बर एक बेदी बनावय। <verse eid="1CH 21:18" /><verse number="19" style="v" sid="1CH 21:19" />तब यहोवा के नांव म गाद के दुवारा कहे गे बात ला मानके दाऊद ह उहां गीस।<verse eid="1CH 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 21:20" />जब ओरनान ह गहूं ला मिंजत रिहिस, त ओह मुड़िस अऊ दूत ला देखिस; ओरनान के चार झन बेटा ओकर संग म रिहिन, अऊ ओमन दूत ला देखके लुका गीन। <verse eid="1CH 21:20" /><verse number="21" style="v" sid="1CH 21:21" />तब दाऊद ह ओरनान करा आईस अऊ जब ओरनान ह दाऊद ला देखिस, त ओह कोठार ला छोंड़के आईस अऊ भुइयां तक मुड़ नवाके दाऊद ला दंडवत करिस।<verse eid="1CH 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 21:22" />दाऊद ह ओला कहिस, “मोला तोर ये कोठार के जगह ला देय दे ताकि में इहां यहोवा बर एक बेदी बना सकंव, जेकर ले मनखेमन के महामारी ह खतम हो जावय। पूरा दाम लेके मोला ये जगह ला बेच दे।”<verse eid="1CH 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 21:23" />ओरनान ह दाऊद ले कहिस, “येला लेय ले! मोर मालिक राजा ला जइसे बने लगथे, वइसे करे। देख, मेंह होम-बलिदान बर बईला, लकरी बर दंवरी के चीज, अऊ अन्न-बलिदान बर गहूं दूहूं। मेंह ये जम्मो चीज दूहूं।”<verse eid="1CH 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 21:24" />पर दाऊद राजा ह ओरनान ला जबाब दीस, “नइं, मेंह पूरा दाम देके ही मानहूं। जऊन ह तोर ए, ओला मेंह यहोवा बर अइसने ही नइं ले लूहूं, अऊ न ही मुफत म कोनो होम-बलिदान चघाहूं।”<verse eid="1CH 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 21:25" />एकरसेति दाऊद ह ओरनान ला ओ जगह के दाम के रूप म छै सौ सेकेल<note caller="+" style="f"><char style="fr" closed="false">21:25 </char><char style="ft" closed="false">लगभग 6.9 किलोग्राम</char></note> सोन दीस। <verse eid="1CH 21:25" /><verse number="26" style="v" sid="1CH 21:26" />दाऊद ह उहां यहोवा बर एक बेदी बनाईस अऊ होम-बलिदान अऊ मेल-बलिदान चघाईस। दाऊद ह यहोवा ले पराथना करिस अऊ यहोवा ह ओकर जबाब होम-बलिदान के बेदी ऊपर स्वरग ले आगी गिराके दीस।<verse eid="1CH 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 21:27" />तब यहोवा ह दूत ले बात करिस, अऊ दूत ह अपन तलवार ला मियान म रख लीस। <verse eid="1CH 21:27" /><verse number="28" style="v" sid="1CH 21:28" />ओ बेरा, जब दाऊद ह देखिस कि यहोवा ह यबूसी ओरनान के कोठार म ओला जबाब दे हवय, त ओह उहां बलिदान चघाईस। <verse eid="1CH 21:28" /><verse number="29" style="v" sid="1CH 21:29" />यहोवा के पबितर-तम्बू, जेला मूसा ह निरजन जगह म बनाय रिहिस, अऊ होम-बलिदान के बेदी ओ बेरा गिबोन के ऊंचहा जगह म रिहिन। <verse eid="1CH 21:29" /><verse number="30" style="v" sid="1CH 21:30" />पर दाऊद ह परमेसर ले पुछे बर ओ बेदी के आघू म नइं जा सकिस, काबरकि ओह यहोवा के दूत के तलवार ले डरत रिहिस।<verse eid="1CH 21:30" /></para>
  <chapter eid="1CH 21" />
  <chapter number="22" style="c" sid="1CH 22" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1" />तब दाऊद ह कहिस, “यहोवा परमेसर के घर ला इहां होना हे अऊ इसरायल बर होम-बलिदान के बेदी ला घलो।”<verse eid="1CH 22:1" /></para>
  <para style="s1">मंदिर बर तियारी</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2" />दाऊद ह इसरायल म रहइया परदेसीमन ला इकट्ठा होय के हुकूम दीस, अऊ ओमन के बीच ले ओह परमेसर के घर बनाय बर पथरा कटइयामन ला ठहिराईस कि ओमन गढ़े गय पथरा तियार करंय। <verse eid="1CH 22:2" /><verse number="3" style="v" sid="1CH 22:3" />ओह दुवारमन के कपाट बर खीला बनाय बर अऊ जोड़ या पुरजा बर बहुंत अकन लोहा दीस, अऊ अतेक कांसा दीस कि ओला तऊले नइं जा सकय। <verse eid="1CH 22:3" /><verse number="4" style="v" sid="1CH 22:4" />ओह गनती के बाहिर देवदार के लकड़ी घलो दीस, काबरकि सीदोन अऊ सूर के मनखेमन दाऊद करा बहुंत अकन देवदार के लकड़ी ले आय रिहिन।<verse eid="1CH 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 22:5" />दाऊद ह अपनआप ले कहिस, “मोर बेटा सुलेमान ह अभी लइका अऊ अनुभवहीन हे, अऊ यहोवा बर जऊन घर बनाय जाना हे, ओह जम्मो जाति के मनखेमन के नजर म बहुंत सोभायमान, प्रसिद्ध अऊ भब्य होना चाही। एकरसेति मेंह येकर बर तियारी करहूं।” तब दाऊद ह अपन मरे के पहिली बहुंत तियारी करिस।<verse eid="1CH 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 22:6" />तब ओह अपन बेटा सुलेमान ला बलाईस अऊ ओला यहोवा, इसरायल के परमेसर बर एक घर बनाय के जिम्मेदारी दीस। <verse eid="1CH 22:6" /><verse number="7" style="v" sid="1CH 22:7" />दाऊद ह सुलेमान ला कहिस: “हे मोर बेटा, येह मोर मन म रिहिस कि मेंह यहोवा, मोर परमेसर के नांव बर एक घर बनावंव। <verse eid="1CH 22:7" /><verse number="8" style="v" sid="1CH 22:8" />पर यहोवा के ये बचन मोर करा आईस: ‘तेंह बहुंत खून बहाय हस अऊ बहुंत लड़ई लड़े हस। तेंह मोर नांव बर एक घर नइं बनाय सकबे, काबरकि मोर नजर म धरती ऊपर, तेंह बहुंत खून बहाय हस। <verse eid="1CH 22:8" /><verse number="9" style="v" sid="1CH 22:9" />पर तोर एक बेटा होही, जऊन ह सांति अऊ अराम के एक मनखे होही, अऊ मेंह ओला जम्मो कोति ले ओकर जम्मो बईरीमन ले अराम दूहूं। ओकर नांव सुलेमान<note caller="+" style="f"><char style="fr" closed="false">22:9 </char><char style="fq" closed="false">सुलेमान ह </char><char style="ft" closed="false">इबरानी भासा के </char><char style="fqa" closed="false">सांति </char><char style="ft" closed="false">सबद ले आय हे सहीं लगथे।</char></note> होही, अऊ मेंह ओकर राज के दौरान इसरायल ला सांति अऊ अराम दूहूं। <verse eid="1CH 22:9" /><verse number="10" style="v" sid="1CH 22:10" />ओह ओ मनखे होही, जऊन ह मोर नांव बर एक घर बनाही। ओह मोर बेटा होही, अऊ मेंह ओकर ददा होहूं। अऊ मेंह ओकर सिंघासन ला इसरायल के ऊपर हमेसा बर स्थापित करहूं।’<verse eid="1CH 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 22:11" />“अब, हे मोर बेटा, यहोवा ह तोर संग रहय, अऊ तोला सफलता मिलय अऊ तेंह यहोवा, तोर परमेसर के घर ला बना, जइसे कि ओह कहे हवय कि तेंह ओकर घर ला बनाबे। <verse eid="1CH 22:11" /><verse number="12" style="v" sid="1CH 22:12" />यहोवा ह तोला बुद्धि अऊ समझ देवय, जब ओह तोला इसरायल के ऊपर अधिकार देथे, ताकि तेंह यहोवा, तोर परमेसर के कानून के पालन कर सकस। <verse eid="1CH 22:12" /><verse number="13" style="v" sid="1CH 22:13" />तेंह तब सफल होबे, जब तेंह ओ नियम अऊ कानूनमन ला धियान देके मानबे, जेला यहोवा ह मूसा ला इसरायलीमन बर देय रिहिस। मजबूत अऊ साहसी बन। झन डर अऊ हिम्मत झन हार।<verse eid="1CH 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 22:14" />“मेंह बड़े तकलीफ उठाके यहोवा के मंदिर बर एक लाख टेलेन्ट<note caller="+" style="f"><char style="fr" closed="false">22:14 </char><char style="ft" closed="false">लगभग 3,750 टन</char></note> सोन, दस लाख टेलेन्ट<note caller="+" style="f"><char style="fr" closed="false">22:14 </char><char style="ft" closed="false">लगभग 37,500 टन</char></note> चांदी, कांसा अऊ लोहा अतेक जादा कि तऊल के बाहिर, अऊ लकड़ी अऊ पथरा के परबंध करे हंव। अऊ तेंह अऊ सामान लानके येला बढ़ा सकत हस। <verse eid="1CH 22:14" /><verse number="15" style="v" sid="1CH 22:15" />तोर करा बहुंत काम करइया हें: पथरा कटइया, राज-मिसतिरी अऊ बढ़ईमन संग म सोन अऊ चांदी, कांसा अऊ लोहा के हर काम करे के कुसल मनखेमन हवंय— <verse eid="1CH 22:15" /><verse number="16" style="v" sid="1CH 22:16" />गनती के बाहिर कारीगरमन हवंय। अब तेंह काम सुरू कर, अऊ यहोवा ह तोर संग रहय।”<verse eid="1CH 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17" />तब दाऊद ह इसरायल के जम्मो अगुवामन ला अपन बेटा सुलेमान के मदद करे बर हुकूम दीस। <verse eid="1CH 22:17" /><verse number="18" style="v" sid="1CH 22:18" />ओह ओमन ला कहिस, “का यहोवा, तुम्हर परमेसर ह तुम्हर संग नइं ए? अऊ का ओह तुमन ला जम्मो कोति ले अराम नइं दे हवय? काबरकि ओह ये देस के निवासीमन ला मोर हांथ म कर दे हवय, अऊ ये देस ह यहोवा अऊ ओकर मनखेमन के अधिकार म हवय। <verse eid="1CH 22:18" /><verse number="19" style="v" sid="1CH 22:19" />अब अपन मन अऊ आतमा ला यहोवा, अपन परमेसर के खोज म लगाय रखव। यहोवा परमेसर के पबितर-स्थान ला बनाय के काम सुरू करव, ताकि तुमन यहोवा के करार के सन्दूक अऊ परमेसर के पबितर चीजमन ला ओ मंदिर म ला सकव, जऊन ह कि यहोवा के नांव म बनाय जाही।”<verse eid="1CH 22:19" /></para>
  <chapter eid="1CH 22" />
  <chapter number="23" style="c" sid="1CH 23" />
  <para style="s1">लेवीमन</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1" />जब दाऊद ह बहुंत उमर के हो गीस अऊ डोकरा हो गीस, त ओह अपन बेटा सुलेमान ला इसरायल के ऊपर राजा बनाईस।<verse eid="1CH 23:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 23:2" />ओह इसरायल के जम्मो अगुवा अऊ संग म पुरोहित अऊ लेवीमन ला घलो इकट्ठा करिस। <verse eid="1CH 23:2" /><verse number="3" style="v" sid="1CH 23:3" />जतेक लेवी तीस साल या तीस साल के ऊपर के रिहिन, ओमन के गनती करे गीस, अऊ आदमीमन के कुल संखिया अड़तीस हजार होईस। <verse eid="1CH 23:3" /><verse number="4" style="v" sid="1CH 23:4" />दाऊद ह कहिस, “येमा के चौबीस हजार मनखेमन के ऊपर यहोवा के मंदिर के काम के जिम्मेदारी होही अऊ छै हजार मनखे अधिकारी अऊ नियाय करइया होहीं। <verse eid="1CH 23:4" /><verse number="5" style="v" sid="1CH 23:5" />चार हजार मनखेमन दुवारपाल अऊ चार हजार मनखेमन ओ बाजामन के संग यहोवा के महिमा करहीं, जेला मेंह ओ काम बर देय हवंव।”<verse eid="1CH 23:5" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="6" style="v" sid="1CH 23:6" />दाऊद ह लेवीमन ला लेवी के बेटा गेरसोन, कहात अऊ मरारी के नांव के मुताबिक अलग-अलग दल म बांट दीस।<verse eid="1CH 23:6" /></para>
  <para style="s1">गेरसोनीमन</para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 23:7" />गेरसोनीमन के बंसज:</para>
  <para style="li2" vid="1CH 23:7">लादान अऊ सिमी।<verse eid="1CH 23:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 23:8" />लादान के बेटामन:</para>
  <para style="li2" vid="1CH 23:8">पहिलऊठा यहीएल, तब जेताम अऊ फेर योएल—कुल तीन झन।<verse eid="1CH 23:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 23:9" />सिमी के बेटामन:</para>
  <para style="li2" vid="1CH 23:9">सलोमोत, हजीएल अऊ हारान—कुल तीन झन।</para>
  <para style="li2" vid="1CH 23:9">(येमन लादान के परिवारमन के मुखिया रिहिन।)<verse eid="1CH 23:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 23:10" />अऊ सिमी के बेटामन:</para>
  <para style="li2" vid="1CH 23:10">यहत, जीजा,<note caller="+" style="f"><char style="fr" closed="false">23:10 </char><char style="ft" closed="false"><char style="xt" link-href="1CH 23:11"><ref loc="1CH 23:11">पद 11</ref></char> भी देखव; जादा इबरानी लेखमन म जीना</char></note> यूस अऊ बरीया।</para>
  <para style="li2" vid="1CH 23:10">येमन सिमी के बेटा रिहिन—कुल चार झन।<verse eid="1CH 23:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 23:11" />(यहत पहिलऊठा रिहिस, अऊ जीजा ह दूसरा, पर यूस अऊ बरीया के जादा बेटा नइं रिहिन: एकरसेति येमन ला एक भाग के संग एक परिवार के रूप म गने गीस।)<verse eid="1CH 23:11" /></para>
  <para style="s1">कहातीमन</para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 23:12" />कहात के बेटामन:</para>
  <para style="li2" vid="1CH 23:12">अमराम, ईसहार, हेबरोन अऊ उजीएल—कुल चार झन।<verse eid="1CH 23:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 23:13" />अमराम के बेटामन:</para>
  <para style="li2" vid="1CH 23:13">हारून अऊ मूसा।</para>
  <para style="li2" vid="1CH 23:13">हारून ला अलग करे गीस, ओला अऊ ओकर संतानमन ला हमेसा बर, ताकि ओमन परम पबितर चीजमन ला पबितर ठहिरांय, यहोवा के आघू म बलिदान चघावंय, ओकर आघू म सेवा करंय अऊ ओकर नांव म हमेसा आसीस देवंय। <verse eid="1CH 23:13" /><verse number="14" style="v" sid="1CH 23:14" />परमेसर के जन मूसा के बेटामन ला लेवी बंस के एक भाग के रूप म गने गीस।<verse eid="1CH 23:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 23:15" />मूसा के बेटामन:</para>
  <para style="li2" vid="1CH 23:15">गेरसोम अऊ एलिएजेर।<verse eid="1CH 23:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 23:16" />गेरसोम के संतान:</para>
  <para style="li2" vid="1CH 23:16">सूबाएल ह पहिलऊठा रिहिस।<verse eid="1CH 23:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 23:17" />एलिएजेर के संतान:</para>
  <para style="li2" vid="1CH 23:17">रहबियाह ह पहिलऊठा रिहिस।</para>
  <para style="li2" vid="1CH 23:17">(एलिएजेर के अऊ कोनो बेटा नइं रिहिन, पर रहबियाह के बहुंत बेटा रिहिन।)<verse eid="1CH 23:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 23:18" />ईसहार के बेटामन:</para>
  <para style="li2" vid="1CH 23:18">सलोमीत ह पहिलऊठा रिहिस।<verse eid="1CH 23:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 23:19" />हेबरोन के बेटामन:</para>
  <para style="li2" vid="1CH 23:19">यरियाह ह पहिलऊठा, अमरयाह ह दूसरा,</para>
  <para style="li2" vid="1CH 23:19">यहजीएल ह तीसरा अऊ यकमाम ह चौथा।<verse eid="1CH 23:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 23:20" />उजीएल के बेटामन:</para>
  <para style="li2" vid="1CH 23:20">मीका ह पहिलऊठा अऊ यिसियाह ह दूसरा।<verse eid="1CH 23:20" /></para>
  <para style="s1">मरारीमन</para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 23:21" />मरारी के बेटामन:</para>
  <para style="li2" vid="1CH 23:21">महली अऊ मूसी।</para>
  <para style="li1" vid="1CH 23:21">महली के बेटामन:</para>
  <para style="li2" vid="1CH 23:21">एलिआजर अऊ कीस।<verse eid="1CH 23:21" /></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 23:22" />(एलिआजर के मिरतू बिगर कोनो बेटा के हो गीस: ओकर सिरिप बेटीमन रिहिन। कीस के बेटामन याने कि ओमन के चचेरा-भाईमन ओमन ले बिहाव कर लीन।)<verse eid="1CH 23:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 23:23" />मूसी के बेटामन:</para>
  <para style="li2" vid="1CH 23:23">महली, एदेर अऊ यरीमोत—कुल तीन झन रिहिन।<verse eid="1CH 23:23" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="24" style="v" sid="1CH 23:24" />येमन ओमन के परिवार के मुताबिक लेवी के संतान रिहिन—परिवार के मुखियामन के नांव लिखे गीस अऊ ओमन ला एक-एक करके गने गीस, याने कि ओ काम करइयामन, जेमन बीस साल या बीस साल ले जादा उमर के रिहिन अऊ यहोवा के मंदिर म सेवा करत रिहिन। <verse eid="1CH 23:24" /><verse number="25" style="v" sid="1CH 23:25" />काबरकि दाऊद ह कहे रिहिस, “जब यहोवा, इसरायल के परमेसर ह अपन मनखेमन ला अराम दे हवय अऊ यरूसलेम म हमेसा रहे बर आय हवय, <verse eid="1CH 23:25" /><verse number="26" style="v" sid="1CH 23:26" />त लेवीमन ला पबितर-तम्बू या येकर सेवा म उपयोग होवइया कोनो चीज ला अऊ ले जाय के जरूरत नइं ए।” <verse eid="1CH 23:26" /><verse number="27" style="v" sid="1CH 23:27" />दाऊद के पिछला निरदेस के मुताबिक बीस साल या बीस साल के ऊपर के लेवीमन के गनती करे गीस।<verse eid="1CH 23:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="1CH 23:28" />लेवीमन के काम ह यहोवा के मंदिर के सेवा म हारून के संतानमन के मदद करई रिहिस: याने कि अंगनामन के देखरेख करई, बाजू के कमरामन के देखरेख करई, जम्मो पबितर चीजमन के सुध करई अऊ परमेसर के घर म आने किसम के काम करई। <verse eid="1CH 23:28" /><verse number="29" style="v" sid="1CH 23:29" />ओमन मेज म सजे रोटी, अन्न-बलिदान बर बिसेस पीसान, बिगर खमीर के बनाय पातर रोटी, रोटी के सेंकई अऊ पीसान के मिलई, अऊ जम्मो चीजमन के मात्रा अऊ आकार के नाप-तौल के देखरेख करंय। <verse eid="1CH 23:29" /><verse number="30" style="v" sid="1CH 23:30" />ओमन ला यहोवा के धनबाद अऊ इस्तुति करे बर हर बिहनियां ठाढ़ होना घलो पड़य। ओमन सांझ के बेरा घलो वइसने करंय <verse eid="1CH 23:30" /><verse number="31" style="v" sid="1CH 23:31" />अऊ जब भी बिसराम दिन, नवां चंदा के तिहार अऊ ठहिराय तिहारमन म यहोवा ला होम-बलिदान चघाय जावय, ओमन वइसने ही करंय। ओमन सही संखिया म होके लगातार यहोवा के आघू म सेवा करंय अऊ ओमन येला ओमन बर ठहिराय गे नियम के मुताबिक करंय।<verse eid="1CH 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 23:32" />अऊ ये किसम ले लेवीमन मिलापवाला तम्बू बर, पबितर स्थान बर यहोवा के मंदिर के सेवा म अपन रिस्तेदार हारून के संतानमन के अधीन अपन जिम्मेदारी ला पूरा करंय।<verse eid="1CH 23:32" /></para>
  <chapter eid="1CH 23" />
  <chapter number="24" style="c" sid="1CH 24" />
  <para style="s1">पुरोहितमन के दल</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1" />हारून के संतानमन के दल येमन रिहिन:</para>
  <para style="p" vid="1CH 24:1">हारून के बेटामन नादाब, अबीहू, एलिआजर अऊ ईतामार रिहिन। <verse eid="1CH 24:1" /><verse number="2" style="v" sid="1CH 24:2" />पर नादाब अऊ अबीहू अपन ददा के मरे के पहिली मर गीन, अऊ ओमन के कोनो बेटा नइं रिहिन; एकरसेति एलिआजर अऊ ईतामार पुरोहित के रूप म सेवा करिन। <verse eid="1CH 24:2" /><verse number="3" style="v" sid="1CH 24:3" />एलिआजर के एक संतान सादोक अऊ ईतामार के एक संतान अहीमेलेक के मदद ले, दाऊद ह ओमन ला ओमन के सेवा के पद के मुताबिक दल-दल करके बांट दीस। <verse eid="1CH 24:3" /><verse number="4" style="v" sid="1CH 24:4" />एलिआजर के संतान म ईतामार के संतान ले जादा अगुवामन पाय गीन, अऊ ओमन ला ये किसम ले बांटे गीस: एलिआजर के संतान ले परिवारमन के सोलह जन मुखिया अऊ ईतामार के संतान ले परिवारमन के आठ जन मुखिया रिहिन। <verse eid="1CH 24:4" /><verse number="5" style="v" sid="1CH 24:5" />चिट्ठी निकाले के दुवारा बिगर भेदभाव के ओमन ला दल म बांट दिये गीस, काबरकि एलिआजर अऊ ईतामार दूनों के संतानमन ले पबितर-स्थान के अधिकारी अऊ परमेसर के अधिकारी ठहिराय गे रिहिन।<verse eid="1CH 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 24:6" />नतनेल के बेटा लेखक समायाह ह एक लेवी रिहिस, अऊ ओह ओमन के नांव राजा अऊ ये अधिकारीमन के आघू म लिख लीस: सादोक पुरोहित, अबियातार के बेटा अहीमेलेक, अऊ पुरोहित अऊ लेवीमन के परिवारमन के मुखियामन—एक परिवार एलिआजर के बंस ले अऊ एक परिवार ईतामार के बंस ले लिये गीस।<verse eid="1CH 24:6" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="7" style="v" sid="1CH 24:7" />पहिला चिट्ठी यहोयारीब के नांव,</para>
  <para style="li1" vid="1CH 24:7">दूसरा यदायाह,<verse eid="1CH 24:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 24:8" />तीसरा हारीम,</para>
  <para style="li1" vid="1CH 24:8">चौथा सोरीम,<verse eid="1CH 24:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 24:9" />पांचवां मलकियाह,</para>
  <para style="li1" vid="1CH 24:9">छठवां मियामीन,<verse eid="1CH 24:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 24:10" />सातवां हक्कोस,</para>
  <para style="li1" vid="1CH 24:10">आठवां अबियाह,<verse eid="1CH 24:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 24:11" />नौवां येहोसू,</para>
  <para style="li1" vid="1CH 24:11">दसवां सेकनयाह,<verse eid="1CH 24:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 24:12" />गियारहवां एलियासीब,</para>
  <para style="li1" vid="1CH 24:12">बारहवां याकीम,<verse eid="1CH 24:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 24:13" />तेरहवां हुपा,</para>
  <para style="li1" vid="1CH 24:13">चौदहवां येसेबाब,<verse eid="1CH 24:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 24:14" />पंदरहवां बिलगा,</para>
  <para style="li1" vid="1CH 24:14">सोलहवां इम्मेर,<verse eid="1CH 24:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 24:15" />सतरहवां हेजीर,</para>
  <para style="li1" vid="1CH 24:15">अठारहवां हपिसेस,<verse eid="1CH 24:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 24:16" />उन्नीसवां पतहियाह,</para>
  <para style="li1" vid="1CH 24:16">बीसवां यहेजकेल,<verse eid="1CH 24:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 24:17" />इक्कीसवां याकीन,</para>
  <para style="li1" vid="1CH 24:17">बाईसवां गामूल,<verse eid="1CH 24:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 24:18" />तेईसवां दलायाह,</para>
  <para style="li1" vid="1CH 24:18">चौबीसवां माजियाह के नांव निकलिस।<verse eid="1CH 24:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="1CH 24:19" />जब ओमन यहोवा के मंदिर म जावंय त येह ओमन के सेवा के ठहिराय गे पारी रिहिस अऊ येह ओमन के पुरखा हारून के दुवारा ओमन ला दिये ओ नियम के मुताबिक रिहिस, जेकर हुकूम यहोवा, इसरायल के परमेसर ह हारून ला देय रिहिस।<verse eid="1CH 24:19" /></para>
  <para style="s1">बाकि बचे लेवीमन</para>
  <para style="lh">
    <verse number="20" style="v" sid="1CH 24:20" />लेवी के बाकि बचे संतानमन:</para>
  <para style="b" vid="1CH 24:20" />
  <para style="li1" vid="1CH 24:20">अमराम के बेटामन ले सूबाएल;</para>
  <para style="li2" vid="1CH 24:20">सूबाएल के बेटामन ले येहदियाह।<verse eid="1CH 24:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 24:21" />रहबियाह के बेटामन ले, यिसियाह ह पहिलऊठा रिहिस।<verse eid="1CH 24:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 24:22" />ईसहारीमन ले: सलोमोत;</para>
  <para style="li2" vid="1CH 24:22">सलोमोत के बेटामन ले: यहत।<verse eid="1CH 24:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 24:23" />हेबरोन के बेटामन:</para>
  <para style="li2" vid="1CH 24:23">यरियाह ह पहिलऊठा, अमरयाह ह दूसरा, यहजीएल ह तीसरा अऊ यकमाम ह चौथा रिहिस।<verse eid="1CH 24:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 24:24" />उजीएल के बेटा: मीका;</para>
  <para style="li2" vid="1CH 24:24">मीका के बेटामन ले: सामीर।<verse eid="1CH 24:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 24:25" />मीका के भाई: यिसियाह;</para>
  <para style="li2" vid="1CH 24:25">यिसियाह के बेटामन ले: जकरयाह।<verse eid="1CH 24:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 24:26" />मरारी के बेटामन: महली अऊ मूसी।</para>
  <para style="li2" vid="1CH 24:26">याजियाह के बेटा: बेनो।<verse eid="1CH 24:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 24:27" />मरारी के बेटामन:</para>
  <para style="li2" vid="1CH 24:27">याजियाह ले: बेनो, सोहम, जक्कूर अऊ इबरी।<verse eid="1CH 24:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 24:28" />महली ले: एलिआजर, जेकर कोनो बेटा नइं रिहिन।<verse eid="1CH 24:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 24:29" />कीस ले: कीस के बेटा: यरहमेल।<verse eid="1CH 24:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 24:30" />अऊ मूसी के बेटामन: महली, एदेर अऊ यरीमोत।</para>
  <para style="b" vid="1CH 24:30" />
  <para style="lf" vid="1CH 24:30">अपन-अपन परिवार के मुताबिक येमन लेवी रिहिन।<verse eid="1CH 24:30" /></para>
  <para style="b" />
  <para style="p">
    <verse number="31" style="v" sid="1CH 24:31" />ओमन घलो अपन रिस्तेदार हारून के संतानमन सहीं दाऊद राजा अऊ सादोक, अहीमेलेक, अऊ पुरोहित अऊ लेवीमन के परिवारमन के मुखियामन के आघू म चिट्ठी निकालिन। सबले बड़े भाई के परिवारमन के संग अऊ सबले छोटे भाई के परिवारमन के संग एक समान बरताव करे गीस।<verse eid="1CH 24:31" /></para>
  <chapter eid="1CH 24" />
  <chapter number="25" style="c" sid="1CH 25" />
  <para style="s1">संगीतकारमन</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1" />राजा दाऊद ह सेना के सेनापतिमन के संग मिलके आसाप, हेमान अऊ यदूतून के कुछू बेटामन ला अलग करिस कि ओमन बीना, सारंगी अऊ झांझ बजाके अगमबानी के सेवकई करंय। जऊन मनखेमन ये सेवा करत रिहिन, ओमन के सूची ये अय:<verse eid="1CH 25:1" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="2" style="v" sid="1CH 25:2" />आसाप के बेटामन ले:</para>
  <para style="li2" vid="1CH 25:2">जक्कूर, यूसुफ, नतनयाह अऊ असरेला। आसाप के बेटामन आसाप के देखरेख म सेवा करंय अऊ आसाप ह राजा के देखरेख म अगमबानी करय।<verse eid="1CH 25:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 25:3" />यदूतून के बेटामन ले:</para>
  <para style="li2" vid="1CH 25:3">गदलयाह, जरी, येसायाह, सिमेई,<note caller="+" style="f"><char style="fr" closed="false">25:3 </char><char style="ft" closed="false">पद <char style="xt" link-href="1CH 25:17"><ref loc="1CH 25:17">17</ref></char> ला घलो देखव; कतको इबरानी हस्तलिपि म </char><char style="fq" closed="false">सिमेई </char><char style="ft" closed="false">नइं ए।</char></note> हसबियाह अऊ मत्तितियाह, कुल छै जन अपन ददा के देखरेख म रिहिन, जऊन ह यहोवा के धनबाद अऊ इस्तुति करे म बीना के उपयोग करय अऊ अगमबानी करय।<verse eid="1CH 25:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 25:4" />हेमान के बेटामन ले:</para>
  <para style="li2" vid="1CH 25:4">बुकियाह, मतनयाह, उजीएल, सूबाएल अऊ यरीमोत; हननयाह, हनानी, एलीआता, गिदलती अऊ रोमामती-एजेर; योसबकासा, मलोती, होतीर अऊ महजीओत। <verse eid="1CH 25:4" /><verse number="5" style="v" sid="1CH 25:5" />(ये जम्मो झन हेमान के बेटा रिहिन, जऊन ह राजा के अगम-दरसी रिहिस। येमन हेमान ला परमेसर के वायदा के जरिये मिले रिहिन ताकि ओमन परमेसर के नांव ला ऊंचहा करंय। परमेसर ह हेमान ला चौदह बेटा अऊ तीन बेटी दे रिहिस।)<verse eid="1CH 25:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="1CH 25:6" />ये जम्मो अपन ददा के देखरेख म यहोवा के मंदिर के संगीत दल के आदमीमन रिहिन, अऊ येमन परमेसर के घर म सेवकई बर झांझ, सारंगी अऊ बीना बजाके अराधना करंय।</para>
  <para style="p" vid="1CH 25:6">आसाप, यदूतून अऊ हेमान, राजा के देखरेख म काम करंय। <verse eid="1CH 25:6" /><verse number="7" style="v" sid="1CH 25:7" />अपन रिस्तेदारमन के संग—ये जम्मो झन यहोवा बर संगीत के गियानी अऊ कुसल संगीतकार रिहिन—ओमन के संखिया 288 रिहिस। <verse eid="1CH 25:7" /><verse number="8" style="v" sid="1CH 25:8" />जवान अऊ सियान एक समान, गुरू के संगे-संग चेला, ओ जम्मो झन ला जिम्मेदारी देय बर चिट्ठी निकाले गीस।<verse eid="1CH 25:8" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="9" style="v" sid="1CH 25:9" />पहिला चिट्ठी आसाप बर यूसुफ के नांव निकलिस,</para>
  <para style="li2" vid="1CH 25:9">ओकर बेटा अऊ रिस्तेदारमन<note caller="+" style="f"><char style="fr" closed="false">25:9 </char><char style="ft" closed="false">इबरानी म </char><char style="fq" closed="false">ओकर बेटा अऊ रिस्तेदारमन </char><char style="ft" closed="false">नइं ए</char></note> सहित ओमन 12<note caller="+" style="f"><char style="fr" closed="false">25:9 </char><char style="ft" closed="false">इबरानी म </char><char style="fq" closed="false">12 </char><char style="ft" closed="false">नइं ए</char></note> झन रिहिन;</para>
  <para style="li1" vid="1CH 25:9">दूसरा चिट्ठी गदलयाह के नांव निकलिस,</para>
  <para style="li2" vid="1CH 25:9">ओकर बेटा अऊ रिस्तेदारमन सहित ओमन 12 झन रिहिन;<verse eid="1CH 25:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 25:10" />तीसरा जक्कूर के नांव निकलिस,</para>
  <para style="li2" vid="1CH 25:10">ओकर बेटा अऊ रिस्तेदारमन सहित ओमन 12 झन रिहिन;<verse eid="1CH 25:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 25:11" />चौथा यिसरी<note caller="+" style="f"><char style="fr" closed="false">25:11 </char><char style="fq" closed="false">यिसरी </char><char style="ft" closed="false">ह </char><char style="fqa" closed="false">सेरी </char><char style="ft" closed="false">के आने नांव ए</char></note> के नांव निकलिस,</para>
  <para style="li2" vid="1CH 25:11">ओकर बेटा अऊ रिस्तेदारमन सहित ओमन 12 झन रिहिन;<verse eid="1CH 25:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 25:12" />पांचवां नतनयाह के नांव निकलिस,</para>
  <para style="li2" vid="1CH 25:12">ओकर बेटा अऊ रिस्तेदारमन सहित ओमन 12 झन रिहिन;<verse eid="1CH 25:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 25:13" />छठवां बुकियाह के नांव निकलिस,</para>
  <para style="li2" vid="1CH 25:13">ओकर बेटा अऊ रिस्तेदारमन सहित ओमन 12 झन रिहिन;<verse eid="1CH 25:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 25:14" />सातवां यसरेला के नांव निकलिस,</para>
  <para style="li2" vid="1CH 25:14">ओकर बेटा अऊ रिस्तेदारमन सहित ओमन 12 झन रिहिन;<verse eid="1CH 25:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 25:15" />आठवां येसायाह के नांव निकलिस,</para>
  <para style="li2" vid="1CH 25:15">ओकर बेटा अऊ रिस्तेदारमन सहित ओमन 12 झन रिहिन;<verse eid="1CH 25:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 25:16" />नवां मतनयाह के नांव निकलिस,</para>
  <para style="li2" vid="1CH 25:16">ओकर बेटा अऊ रिस्तेदारमन सहित ओमन 12 झन रिहिन;<verse eid="1CH 25:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 25:17" />दसवां सिमी के नांव निकलिस,</para>
  <para style="li2" vid="1CH 25:17">ओकर बेटा अऊ रिस्तेदारमन सहित ओमन 12 झन रिहिन;<verse eid="1CH 25:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 25:18" />गियारहवां अजरेल के नांव निकलिस,</para>
  <para style="li2" vid="1CH 25:18">ओकर बेटा अऊ रिस्तेदारमन सहित ओमन 12 झन रिहिन;<verse eid="1CH 25:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 25:19" />बारहवां हसबियाह के नांव निकलिस,</para>
  <para style="li2" vid="1CH 25:19">ओकर बेटा अऊ रिस्तेदारमन सहित ओमन 12 झन रिहिन;<verse eid="1CH 25:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 25:20" />तेरहवां सूबाएल के नांव निकलिस,</para>
  <para style="li2" vid="1CH 25:20">ओकर बेटा अऊ रिस्तेदारमन सहित ओमन 12 झन रिहिन;<verse eid="1CH 25:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 25:21" />चौदहवां मत्तितियाह के नांव निकलिस,</para>
  <para style="li2" vid="1CH 25:21">ओकर बेटा अऊ रिस्तेदारमन सहित ओमन 12 झन रिहिन;<verse eid="1CH 25:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 25:22" />पंदरहवां यरीमोत के नांव निकलिस,</para>
  <para style="li2" vid="1CH 25:22">ओकर बेटा अऊ रिस्तेदारमन सहित ओमन 12 झन रिहिन;<verse eid="1CH 25:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 25:23" />सोलहवां हननयाह के नांव निकलिस,</para>
  <para style="li2" vid="1CH 25:23">ओकर बेटा अऊ रिस्तेदारमन सहित ओमन 12 झन रिहिन;<verse eid="1CH 25:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 25:24" />सतरहवां योसबकासा के नांव निकलिस,</para>
  <para style="li2" vid="1CH 25:24">ओकर बेटा अऊ रिस्तेदारमन सहित ओमन 12 झन रिहिन;<verse eid="1CH 25:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 25:25" />अठारहवां हनानी के नांव निकलिस,</para>
  <para style="li2" vid="1CH 25:25">ओकर बेटा अऊ रिस्तेदारमन सहित ओमन 12 झन रिहिन;<verse eid="1CH 25:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 25:26" />उन्नीसवां मलोती के नांव निकलिस,</para>
  <para style="li2" vid="1CH 25:26">ओकर बेटा अऊ रिस्तेदारमन सहित ओमन 12 झन रिहिन;<verse eid="1CH 25:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 25:27" />बीसवां इलियाता के नांव निकलिस,</para>
  <para style="li2" vid="1CH 25:27">ओकर बेटा अऊ रिस्तेदारमन सहित ओमन 12 झन रिहिन;<verse eid="1CH 25:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 25:28" />इक्कीसवां होतीर के नांव निकलिस,</para>
  <para style="li2" vid="1CH 25:28">ओकर बेटा अऊ रिस्तेदारमन सहित ओमन 12 झन रिहिन;<verse eid="1CH 25:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 25:29" />बाईसवां गिदलती के नांव निकलिस,</para>
  <para style="li2" vid="1CH 25:29">ओकर बेटा अऊ रिस्तेदारमन सहित ओमन 12 झन रिहिन;<verse eid="1CH 25:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 25:30" />तेईसवां महजीओत के नांव निकलिस,</para>
  <para style="li2" vid="1CH 25:30">ओकर बेटा अऊ रिस्तेदारमन सहित ओमन 12 झन रिहिन;<verse eid="1CH 25:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 25:31" />चौबीसवां चिट्ठी रोमामती-एजेर के नांव निकलिस,</para>
  <para style="li2" vid="1CH 25:31">ओकर बेटा अऊ रिस्तेदारमन सहित ओमन 12 झन रिहिन।<verse eid="1CH 25:31" /></para>
  <chapter eid="1CH 25" />
  <chapter number="26" style="c" sid="1CH 26" />
  <para style="s1">दुवारपालमन</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 26:1" />दुवारपालमन के दल येमन रिहिन:</para>
  <para style="b" vid="1CH 26:1" />
  <para style="lh" vid="1CH 26:1">कोरहीमन ले:</para>
  <para style="li1" vid="1CH 26:1">कोरे के बेटा मसेलेमियाह, जऊन ह आसाप के संतानमन ले एक झन रिहिस। <verse eid="1CH 26:1" /><verse number="2" style="v" sid="1CH 26:2" />मसेलेमियाह के बेटामन:</para>
  <para style="li2" vid="1CH 26:2">पहिलऊठा बेटा जकरयाह, दूसरा यदीएल,</para>
  <para style="li2" vid="1CH 26:2">तीसरा जबदयाह, चौथा यतनिएल,<verse eid="1CH 26:2" /></para>
  <para style="li2">
    <verse number="3" style="v" sid="1CH 26:3" />पांचवां एलाम, छठवां यहोहानान</para>
  <para style="li2" vid="1CH 26:3">अऊ सातवां एलिहोएनै।<verse eid="1CH 26:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 26:4" />ओबेद-एदोम के घलो बेटामन रिहिन:</para>
  <para style="li2" vid="1CH 26:4">पहिलऊठा बेटा समायाह, दूसरा यहोजाबाद,</para>
  <para style="li2" vid="1CH 26:4">तीसरा योआह, चौथा साकार</para>
  <para style="li2" vid="1CH 26:4">पांचवां नतनेल, <verse eid="1CH 26:4" /><verse number="5" style="v" sid="1CH 26:5" />छठवां अमीएल,</para>
  <para style="li2" vid="1CH 26:5">सातवां इस्साकार अऊ आठवां पुलेताई।</para>
  <para style="li2" vid="1CH 26:5">(काबरकि परमेसर ह ओबेद-एदोम ला आसीस दे रिहिस।)<verse eid="1CH 26:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 26:6" />ओबेद-एदोम के बेटा समायाह के घलो बेटामन रिहिन, जऊन मन अपन ददा के परिवार म अगुवा रिहिन, काबरकि ओमन बहुंत योग्य आदमी रिहिन। <verse eid="1CH 26:6" /><verse number="7" style="v" sid="1CH 26:7" />समायाह के बेटामन:</para>
  <para style="li2" vid="1CH 26:7">ओतनी, रपाएल, ओबेद अऊ एलजाबाद;</para>
  <para style="li2" vid="1CH 26:7">ओकर रिस्तेदार एलीहू अऊ समाकियाह घलो योग्य आदमी रिहिन।<verse eid="1CH 26:7" /></para>
  <para style="lf">
    <verse number="8" style="v" sid="1CH 26:8" />ये जम्मो झन ओबेद-एदोम के संतान रिहिन; ओमन अऊ ओकर बेटामन अऊ ओमन के रिस्तेदारमन योग्य मनखे रिहिन अऊ ओमन म कोनो भी काम करे के ताकत रिहिस—ओबेद-एदोम के संतानमन के कुल संखिया 62 रिहिस।<verse eid="1CH 26:8" /></para>
  <para style="lf">
    <verse number="9" style="v" sid="1CH 26:9" />मसेलेमियाह के बेटा अऊ रिस्तेदारमन रिहिन, जऊन मन योग्य आदमी रिहिन—येमन कुल 18 झन रिहिन।<verse eid="1CH 26:9" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="10" style="v" sid="1CH 26:10" />मरारी के बंस के होसा के बेटामन:</para>
  <para style="li2" vid="1CH 26:10">पहिलऊठा बेटा सिमरी (हालाकि ओह पहिलऊठा नइं रिहिस, पर ओकर ददा ह ओला पहिलऊठा ठहिराय रिहिस),<verse eid="1CH 26:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 26:11" />दूसरा हिलकियाह, तीसरा तबलियाह</para>
  <para style="li2" vid="1CH 26:11">अऊ चौथा जकरयाह।</para>
  <para style="lf" vid="1CH 26:11">होसा के बेटा अऊ रिस्तेदारमन के कुल संखिया 13 रिहिस।<verse eid="1CH 26:11" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="12" style="v" sid="1CH 26:12" />ये दुवारपालमन के ये दलमन ला ओमन के रिस्तेदारमन के सहीं ओमन के अगुवामन के जरिये यहोवा के मंदिर म सेवा के जबाबदारी दिये जावत रिहिस। <verse eid="1CH 26:12" /><verse number="13" style="v" sid="1CH 26:13" />ओमन के परिवार के मुताबिक हर एक दुवार बर चिट्ठी निकाले गीस, जवान अऊ सियान जम्मो बर एक समान।<verse eid="1CH 26:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 26:14" />पूरब के दुवार के चिट्ठी सेलेमियाह<note caller="+" style="f"><char style="fr" closed="false">26:14 </char><char style="fq" closed="false">सेलेमियाह </char><char style="ft" closed="false">ह </char><char style="fqa" closed="false">मसेलेमियाह </char><char style="ft" closed="false">के आने नांव ए</char></note> के नांव निकलिस।</para>
  <para style="li1" vid="1CH 26:14">तब ओकर बेटा जकरयाह बर चिट्ठी निकाले गीस, जऊन ह एक बुद्धिमान सलाहकार रिहिस, अऊ ओकर नांव म उत्तर के दुवार के चिट्ठी निकलिस।<verse eid="1CH 26:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 26:15" />दक्खिन के दुवार के चिट्ठी ओबेद-एदोम के नांव निकलिस, अऊ भंडारघर के चिट्ठी ओकर बेटामन के नांव म आईस।<verse eid="1CH 26:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 26:16" />पछिम के दुवार अऊ ऊपर के सड़क म सलेकेत दुवार के चिट्ठी सुप्पीम अऊ होसा के नांव निकलिस।</para>
  <para style="b" vid="1CH 26:16" />
  <para style="lh" vid="1CH 26:16">पहरेदार ह पहरेदार के संग रहय:<verse eid="1CH 26:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 26:17" />पूरब म हर दिन छै लेवी रहंय,</para>
  <para style="li1" vid="1CH 26:17">उत्तर म हर दिन चार झन,</para>
  <para style="li1" vid="1CH 26:17">दक्खिन म हर दिन चार झन</para>
  <para style="li1" vid="1CH 26:17">अऊ भंडारघर म एक समय म दू झन।<verse eid="1CH 26:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 26:18" />पछिम कोति के अंगना बर चार झन सड़क म अऊ अंगना म ही दू झन रहंय।<verse eid="1CH 26:18" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="19" style="v" sid="1CH 26:19" />ये दुवारपालमन के दल रिहिन, जऊन मन कोरह अऊ मरारी के संतान रिहिन।<verse eid="1CH 26:19" /></para>
  <para style="s1">खजांची अऊ आने अधिकारीमन</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20" />ओमन के संगी लेवीमन के ऊपर परमेसर के घर के खजाना अऊ चघाय गे चीजमन के खजाना के जिम्मेदारी रिहिस।<verse eid="1CH 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 26:21" />लादान के संतान, जऊन मन लादान के जरिये गेरसोनी रिहिन अऊ जऊन मन गेरसोनी लादान के परिवारमन के मुखिया रिहिन, ओमन ये रिहिन—यहीएली, <verse eid="1CH 26:21" /><verse number="22" style="v" sid="1CH 26:22" />यहीएली के बेटा जेताम अऊ ओकर भाई योएल। येमन यहोवा के मंदिर के खजाना के अधिकारी रिहिन।<verse eid="1CH 26:22" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="23" style="v" sid="1CH 26:23" />अमरामी, ईसहारी, हेबरोनी अऊ उजीएलीमन ले:<verse eid="1CH 26:23" /></para>
  <para style="b" />
  <para style="li2">
    <verse number="24" style="v" sid="1CH 26:24" />मूसा के बेटा गेरसोम के एक संतान सूबाएल ह खजाना के मुखिया अधिकारी रिहिस। <verse eid="1CH 26:24" /><verse number="25" style="v" sid="1CH 26:25" />ओकर रिस्तेदार एलिएजेर के जरिये: ओकर बेटा रहबियाह, रहबियाह के बेटा येसायाह, येसायाह के बेटा योराम, योराम के बेटा जिकरी अऊ जिकरी के बेटा सलोमीत रिहिस।<verse eid="1CH 26:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 26:26" />(राजा दाऊद अऊ परिवारमन के मुखिया, जऊन मन हजार-हजार मनखे ऊपर सेनापति अऊ सौ-सौ मनखे ऊपर सेनापति रिहिन, अऊ सेना के आने सेनापति जऊन चीजमन ला चघाय रिहिन, ओ जम्मो चीज के खजाना के जिम्मेदारी सलोमीत अऊ ओकर रिस्तेदारमन के ऊपर रिहिस। <verse eid="1CH 26:26" /><verse number="27" style="v" sid="1CH 26:27" />लड़ई म लूटे गे कुछू चीजमन ला घलो ओमन यहोवा के मंदिर के सुधार के काम बर चघाय रिहिन। <verse eid="1CH 26:27" /><verse number="28" style="v" sid="1CH 26:28" />अऊ समूएल अगम-दरसी के दुवारा अऊ कीस के बेटा साऊल के दुवारा, नेर के बेटा अबनेर अऊ सरूयाह के बेटा योआब के दुवारा चघाय गे चीजमन, अऊ मंदिर के उपयोग बर चघाय गे आने जम्मो चीजमन के देखरेख के जिम्मेदारी सलोमीत अऊ ओकर रिस्तेदारमन के ऊपर रिहिस।)<verse eid="1CH 26:28" /></para>
  <para style="li2">
    <verse number="29" style="v" sid="1CH 26:29" />ईसहारीमन ले:</para>
  <para style="li2" vid="1CH 26:29">कननियाह अऊ ओकर बेटामन ला मंदिर के बाहिर इसरायल देस के ऊपर अधिकारी अऊ नियायधीस के काम करे बर ठहिराय गे रिहिस।<verse eid="1CH 26:29" /></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 26:30" />हेबरोनीमन ले:</para>
  <para style="li2" vid="1CH 26:30">हसबियाह अऊ ओकर रिस्तेदार, जऊन मन सतरह सौ योग्य आदमी रिहिन, ओमन इसरायल म यरदन नदी के पछिम कोति यहोवा के जम्मो काम अऊ राजा के सेवा बर जिम्मेदार रिहिन। <verse eid="1CH 26:30" /><verse number="31" style="v" sid="1CH 26:31" />हेबरोनीमन बर, ओमन के परिवारमन के बंसावली के मुताबिक यरियाह ह ओमन के मुखिया रिहिस।</para>
  <para style="li2" vid="1CH 26:31">(दाऊद के राज के चालीसवां साल म अभिलेखमन म खोजे गीस, अऊ गिलाद के याजेर नगर म हेबरोनीमन के बीच योग्य आदमीमन पाय गीन। <verse eid="1CH 26:31" /><verse number="32" style="v" sid="1CH 26:32" />यरियाह के सत्ताईस सौ रिस्तेदार रिहिन, जऊन मन योग्य आदमी रिहिन अऊ परिवारमन के मुखिया रिहिन, दाऊद राजा ह ओमन ला रूबेनी, गादी अऊ मनस्से के आधा बंस के ऊपर परमेसर ले संबंधित जम्मो काम बर अऊ राजा ले संबंधित काम बर अधिकारी ठहिराईस।)<verse eid="1CH 26:32" /></para>
  <chapter eid="1CH 26" />
  <chapter number="27" style="c" sid="1CH 27" />
  <para style="s1">सेना के दल</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 27:1" />येह इसरायलीमन के सूची अय—परिवारमन के मुखियामन, हजार-हजार मनखे ऊपर सेनापति, सौ-सौ मनखे ऊपर सेनापति, अऊ ओमन के अधिकारी, जऊन मन साल भर एक-एक महिना करके सैनिक दलमन ले संबंधित जम्मो काम म राजा के सेवा करंय। हर दल म 24,000 सैनिक रिहिन।<verse eid="1CH 27:1" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="2" style="v" sid="1CH 27:2" />पहिला महिना बर, पहिला दल के अधिकारी जबदीएल के बेटा यासोबाम रिहिस। ओकर दल म 24,000 सैनिक रिहिन <verse eid="1CH 27:2" /><verse number="3" style="v" sid="1CH 27:3" />ओह पेरेस के एक संतान रिहिस अऊ पहिला महिना बर जम्मो सैनिक अधिकारीमन के मुखिया रिहिस।<verse eid="1CH 27:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 27:4" />दूसरा महिना बर दल के अधिकारी दोदै नांव के अहोही रिहिस; मिकलोत ह ओकर दल के अगुवा रिहिस। ओकर दल म 24,000 सैनिक रिहिन।<verse eid="1CH 27:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 27:5" />तीसरा महिना बर, तीसरा सेनापति यहोयादा पुरोहित के बेटा बनायाह रिहिस। ओह मुखिया रिहिस अऊ ओकर दल म 24,000 सैनिक रिहिन। <verse eid="1CH 27:5" /><verse number="6" style="v" sid="1CH 27:6" />येह ओ बनायाह रिहिस, जऊन ह तीस बीरमन के बीच म एक बीर योद्धा रिहिस अऊ ओ तीस बीरमन के ऊपर रिहिस। ओकर बेटा अमीजाबाद ह ओकर दल के अगुवा रिहिस।<verse eid="1CH 27:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 27:7" />चौथा महिना बर, चौथा सेनापति योआब के भाई असाहेल रिहिस; ओकर बाद ओकर बेटा जबदयाह ह ओकर उत्तराधिकारी रिहिस। ओकर दल म 24,000 सैनिक रिहिन।<verse eid="1CH 27:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 27:8" />पांचवां महिना बर, पांचवां सेनापति समहूत नांव के ईसराही रिहिस। ओकर दल म 24,000 सैनिक रिहिन।<verse eid="1CH 27:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 27:9" />छठवां महिना बर, छठवां सेनापति तकोआ ले इक्केस के बेटा ईरा रिहिस। ओकर दल म 24,000 सैनिक रिहिन।<verse eid="1CH 27:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 27:10" />सातवां महिना बर, सातवां सेनापति हेलेस नांव के पलोनी रिहिस, जऊन ह एपरैम के बंस के रिहिस। ओकर दल म 24,000 सैनिक रिहिन।<verse eid="1CH 27:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 27:11" />आठवां महिना बर, आठवां सेनापति सिब्बकै नांव के हूसाती रिहिस, जऊन ह जेरही बंस के रिहिस। ओकर दल म 24,000 सैनिक रिहिन।<verse eid="1CH 27:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 27:12" />नौवां महिना बर, नौवां सेनापति अबिएजेर नांव के अनातोती रिहिस, जऊन ह बिनयामीन के बंस के रिहिस। ओकर दल म 24,000 सैनिक रिहिन।<verse eid="1CH 27:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 27:13" />दसवां महिना बर, दसवां सेनापति महरै नांव के नतोपाती रिहिस, जऊन ह जेरही बंस के रिहिस। ओकर दल म 24,000 सैनिक रिहिन।<verse eid="1CH 27:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 27:14" />गियारहवां महिना बर, गियारहवां सेनापति बनायाह नांव के पिरातोनी रिहिस, जऊन ह एपरैम के बंस के रिहिस। ओकर दल म 24,000 सैनिक रिहिन।<verse eid="1CH 27:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 27:15" />बारहवां महिना बर, बारहवां सेनापति हेल्दै नांव के नतोपाती रिहिस, जऊन ह ओतनीएल के परिवार के रिहिस। ओकर दल म 24,000 सैनिक रिहिन।<verse eid="1CH 27:15" /></para>
  <para style="s1">गोत्रमन के अगुवामन</para>
  <para style="lh">
    <verse number="16" style="v" sid="1CH 27:16" />इसरायल के गोत्रमन के अगुवामन:</para>
  <para style="b" vid="1CH 27:16" />
  <para style="li1" vid="1CH 27:16">रूबेनीमन ले: जिकरी के बेटा एलिएजेर;</para>
  <para style="li1" vid="1CH 27:16">सिमोनीमन ले: माका के बेटा सपतयाह;<verse eid="1CH 27:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 27:17" />लेवी ले: कमूएल के बेटा हसबियाह;</para>
  <para style="li1" vid="1CH 27:17">हारून ले: सादोक;<verse eid="1CH 27:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 27:18" />यहूदा ले: एलीहू नांव के दाऊद के एक भाई;</para>
  <para style="li1" vid="1CH 27:18">इस्साकार ले: मिकाएल के बेटा ओमरी;<verse eid="1CH 27:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 27:19" />जबूलून ले: ओबदयाह के बेटा यिसमायाह;</para>
  <para style="li1" vid="1CH 27:19">नपताली ले: अजरीएल के बेटा यरीमोत;<verse eid="1CH 27:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 27:20" />एपरैम ले: अजजियाह के बेटा होसे;</para>
  <para style="li1" vid="1CH 27:20">मनस्से के आधा गोत्र ले: पदायाह के बेटा योएल;<verse eid="1CH 27:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 27:21" />गिलाद म मनस्से के आधा गोत्र ले: जकरयाह के बेटा इद्दो;</para>
  <para style="li1" vid="1CH 27:21">बिनयामीन ले: अबनेर के बेटा यासीएल;<verse eid="1CH 27:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 27:22" />दान ले: यरोहाम के बेटा अजरेल।</para>
  <para style="b" vid="1CH 27:22" />
  <para style="lf" vid="1CH 27:22">येमन इसरायल के गोत्र के अगुवामन रिहिन।<verse eid="1CH 27:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="1CH 27:23" />दाऊद ह ओ मनखेमन ला गनती म नइं लीस, जेमन बीस साल या बीस साल ले छोटे रिहिन, काबरकि यहोवा ह वायदा करे रिहिस कि ओह इसरायल ला अकास के तारामन सहीं अनगिनत कर दीही। <verse eid="1CH 27:23" /><verse number="24" style="v" sid="1CH 27:24" />सरूयाह के बेटा योआब ह मनखेमन ला गने के सुरू करिस पर येला पूरा नइं करिस। ये गनती करे के कारन परमेसर के कोरोध इसरायल ऊपर भड़किस, अऊ दाऊद राजा के इतिहास के किताब म ये गनती ला नइं लिखे गीस।<verse eid="1CH 27:24" /></para>
  <para style="s1">राजा के अधिकारीमन</para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 27:25" />अदीएल के बेटा अजमावेत ह साही भंडारघरमन के अधिकारी रिहिस।</para>
  <para style="li1" vid="1CH 27:25">उजियाह के बेटा योनातन ह दूरिहा-दूरिहा जिला, नगर, गांव अऊ पहरेदारी के मीनारमन के अधिकारी रिहिस।<verse eid="1CH 27:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 27:26" />कलूब के बेटा एजरी ह भुइयां म खेती करइया मनखेमन के अधिकारी रिहिस।<verse eid="1CH 27:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 27:27" />रामाह के सिमी ह अंगूर के बारीमन के अधिकारी रिहिस।</para>
  <para style="li1" vid="1CH 27:27">सेपाम के जबदी ह अंगूर के बारी के ऊपज रखे के अंगूर के कुंडमन के अधिकारी रिहिस।<verse eid="1CH 27:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 27:28" />गेदेर के बाल-हानान ह पछिम के पहाड़ी इलाका म जैतून अऊ डूमर रूखमन के अधिकारी रिहिस।</para>
  <para style="li1" vid="1CH 27:28">योआस ह जैतून तेल के पूरती करे के अधिकारी रिहिस।<verse eid="1CH 27:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 27:29" />सारोन के सितरै ह सारोन के इलाका म घांस चरइया पसु के झुंडमन के अधिकारी रिहिस।</para>
  <para style="li1" vid="1CH 27:29">अदलै के बेटा सापात ह घाटीमन म पसु के झुंडमन के अधिकारी रिहिस।<verse eid="1CH 27:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 27:30" />इसमायली ओबील ह ऊंटमन के अधिकारी रिहिस।</para>
  <para style="li1" vid="1CH 27:30">मेरोनोत के येहदियाह ह गदहामन के अधिकारी रिहिस।<verse eid="1CH 27:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 27:31" />हगरी के याजीज ह भेड़-बकरी के झुंडमन के अधिकारी रिहिस।</para>
  <para style="lf" vid="1CH 27:31">ये जम्मो झन दाऊद राजा के संपत्ति के देखरेख बर ठहिराय गय अधिकारी रिहिन।<verse eid="1CH 27:31" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="32" style="v" sid="1CH 27:32" />दाऊद के कका योनातन ह एक सलाहकार रिहिस, जऊन ह एक समझदार मनखे अऊ लेखक रिहिस।</para>
  <para style="li1" vid="1CH 27:32">हकमोनी के बेटा यहीएल ह राजा के बेटामन के देखरेख करय।<verse eid="1CH 27:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 27:33" />अहीतोपेल ह राजा के सलाहकार रिहिस।</para>
  <para style="li1" vid="1CH 27:33">अरकी हूसै ह राजा के बिसवासयोग्य मनखे रिहिस।<verse eid="1CH 27:33" /></para>
  <para style="lf">
    <verse number="34" style="v" sid="1CH 27:34" />(अहीतोपेल के मरे के बाद यहोयादा अऊ अबियातार सलाहकार बनाय गीन; यहोयादा ह बनायाह के बेटा रिहिस।)</para>
  <para style="li1" vid="1CH 27:34">योआब ह साही सेना के सेनापति रिहिस।<verse eid="1CH 27:34" /></para>
  <chapter eid="1CH 27" />
  <chapter number="28" style="c" sid="1CH 28" />
  <para style="s1">मंदिर बर दाऊद के योजना</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1" />दाऊद ह इसरायल के जम्मो करमचारीमन ला यरूसलेम म जूरे के हुकूम दीस: येमा गोत्र के अधिकारीमन, राजा के सेवा दल के सेनापतिमन, हजार-हजार मनखेमन के ऊपर सेनापतिमन, सौ-सौ मनखेमन के ऊपर सेनापतिमन, जम्मो संपत्ति अऊ राजा अऊ ओकर बेटामन के पसु-धन बर ठहिराय गे अधिकारीमन, अऊ संग म महल के करमचारीमन, योद्धामन अऊ जम्मो बहादुर सैनिकमन रिहिन।<verse eid="1CH 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 28:2" />दाऊद राजा ह अपन गोड़ म ठाढ़ हो गीस अऊ कहिस: “हे मोर संगी इसरायली, मोर मनखेमन, मोर बात ला सुनव। ये बात मोर मन म रिहिस कि मेंह यहोवा के करार के सन्दूक बर अराम के एक जगह के रूप म, हमर परमेसर के गोड़ के चौकी बर एक घर बनावंव, अऊ मेंह येला बनाय बर योजना घलो बनाएंव। <verse eid="1CH 28:2" /><verse number="3" style="v" sid="1CH 28:3" />पर परमेसर ह मोला कहिस, ‘तेंह ओ मनखे नो हस, जऊन ह मोर नांव बर एक घर बनाही, काबरकि तेंह एक योद्धा अस अऊ तेंह बहुंत खून बहाय हस।’<verse eid="1CH 28:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 28:4" />“तभो ले इसरायल के परमेसर, यहोवा ह मोर पूरा परिवार ले मोला चुनिस कि मेंह इसरायल ऊपर हमेसा बर राजा बनंव। ओह यहूदा ला अगुवा के रूप म चुनिस, अऊ यहूदा के गोत्र ले ओह मोर परिवार ला चुनिस, अऊ मोर ददा के बेटामन ले ओह मोला जम्मो इसरायल ऊपर राजा बनाके खुस होईस। <verse eid="1CH 28:4" /><verse number="5" style="v" sid="1CH 28:5" />यहोवा ह मोला बहुंत बेटा दे हवय, अऊ मोर जम्मो बेटामन ले ओह मोर बेटा सुलेमान ला चुने हवय कि ओह इसरायल ऊपर यहोवा के राज के सिंघासन म बईठे। <verse eid="1CH 28:5" /><verse number="6" style="v" sid="1CH 28:6" />यहोवा ह मोला कहिस: ‘तोर बेटा सुलेमान ह ओ मनखे अय, जऊन ह मोर घर अऊ मोर अंगनामन ला बनाही, काबरकि मेंह ओला मोर बेटा होय बर चुन ले हंव, अऊ मेंह ओकर ददा होहूं। <verse eid="1CH 28:6" /><verse number="7" style="v" sid="1CH 28:7" />मेंह ओकर राज ला हमेसा बर स्थापित करहूं, यदि ओह मोर हुकूम अऊ कानूनमन के पालन करे ले पाछू नइं हटही, जइसे कि अभी करे जावथे।’<verse eid="1CH 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 28:8" />“एकरसेति अब मेंह जम्मो इसरायल अऊ यहोवा के सभा के आघू म, अऊ परमेसर के सुनत म तोला ये जिम्मेदारी देवत हंव: धियान देके यहोवा तोर परमेसर के जम्मो हुकूममन ला मान, ताकि ये बने देस म तोर अधिकार रहय अऊ तोर बाद तोर संतानमन ला तें ये देस ला हमेसा बर दे सकस।<verse eid="1CH 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 28:9" />“अऊ हे मोर बेटा सुलेमान, तें अपन ददा के परमेसर ला जान ले, अऊ पूरा हिरदय के भक्ति अऊ मन के ईछा ले ओकर सेवा कर, काबरकि यहोवा ह हर एक के मन ला जांचथे अऊ हर एक के ईछा अऊ हर एक के बिचार ला समझथे। यदि तें ओला खोजबे, त ओह तोला मिलही; पर यदि तें ओला तियाग देबे, त ओह तोला हमेसा बर छोंड़ दीही। <verse eid="1CH 28:9" /><verse number="10" style="v" sid="1CH 28:10" />अब बिचार कर, काबरकि यहोवा ह तोला चुने हवय कि तें पबितर-स्थान के रूप म एक घर बना। मजबूत बन अऊ ये काम ला कर।”<verse eid="1CH 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 28:11" />तब दाऊद ह अपन बेटा सुलेमान ला मंदिर के मंडप, येकर भवन, येकर भंडारघर, येकर ऊपरी भाग, येकर भीतर के कमरामन के अऊ प्रायस्चित करे के जगह के योजना ला सऊंप दीस। <verse eid="1CH 28:11" /><verse number="12" style="v" sid="1CH 28:12" />ओह ओला ओ जम्मो योजना ला सऊंप दीस, जेला परमेसर के आतमा ह यहोवा के मंदिर के अंगना अऊ आसपास के जम्मो कमरा बर, परमेसर के मंदिर के खजाना बर अऊ चघाय गे चीजमन के खजाना बर ओकर मन म डाले रिहिस। <verse eid="1CH 28:12" /><verse number="13" style="v" sid="1CH 28:13" />ओह ओला पुरोहित अऊ लेवीमन के दल बर, यहोवा के मंदिर म सेवा के जम्मो काम बर, संग म येकर सेवा म उपयोग होवइया जम्मो चीजमन के संबंध म निरदेस दीस। <verse eid="1CH 28:13" /><verse number="14" style="v" sid="1CH 28:14" />दाऊद ह आने-आने किसम के सेवा म उपयोग होवइया सोन के जम्मो चीजमन बर सोन के मात्रा तय करिस, अऊ ओह आने-आने किसम के सेवा म उपयोग होवइया चांदी के जम्मो चीजमन बर चांदी के मात्रा तय करिस: <verse eid="1CH 28:14" /><verse number="15" style="v" sid="1CH 28:15" />सोन के दीवट अऊ ओमन के दीयामन बर सोन के मात्रा, संग म हर एक दीवट अऊ ओकर दीयामन बर सोन के मात्रा; अऊ हर एक चांदी के दीवट अऊ ओकर दीयामन बर चांदी के मात्रा हर एक दीवट के उपयोग के मुताबिक तय करिस; <verse eid="1CH 28:15" /><verse number="16" style="v" sid="1CH 28:16" />भेंट चघाय रोटी के हर एक मेज बर सोन के मात्रा; चांदी के मेजमन बर चांदी के मात्रा; <verse eid="1CH 28:16" /><verse number="17" style="v" sid="1CH 28:17" />कांटा, छिड़काव के कटोरा अऊ मटकामन बर सुध सोन के मात्रा; हर एक सोन के बरतन बर सोन के मात्रा; हर एक चांदी के बरतन बर चांदी के मात्रा; <verse eid="1CH 28:17" /><verse number="18" style="v" sid="1CH 28:18" />अऊ धूप के बेदी बर चोखा सोन। ओह ओला रथ बनाय के योजना घलो दीस, याने कि सोन के करूब, जेकर डेनामन फईले रहंय अऊ यहोवा के करार के सन्दूक ला ढांपे रहंय।<verse eid="1CH 28:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 28:19" />दाऊद ह सुलेमान ला कहिस, “यहोवा के हांथ मोर ऊपर होय के कारन, मेंह ये जम्मो बात ला लिखके रखे हंव, अऊ ओह मोला येकर काबिल बनाईस कि मेंह योजना के जम्मो बात ला समझ सकेंव।”<verse eid="1CH 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 28:20" />दाऊद ह अपन बेटा सुलेमान ला ये घलो कहिस, “मजबूत अऊ साहसी बन, अऊ ये काम ला कर। झन डरा या निरास झन हो, काबरकि यहोवा परमेसर, मोर परमेसर ह तोर संग हवय। ओह तोला असफल नइं करय या ओह तोला नइं तियागय, जब तक कि यहोवा के मंदिर के सेवा बर जम्मो काम पूरा नइं हो जाही। <verse eid="1CH 28:20" /><verse number="21" style="v" sid="1CH 28:21" />पुरोहित अऊ लेवीमन के दलमन परमेसर के मंदिर के जम्मो काम बर तियार हवंय, अऊ कुसल मनखेमन अपन ईछा ले जम्मो काम म तोर मदद करहीं। करमचारी अऊ जम्मो मनखेमन तोर हर हुकूम ला मानहीं।”<verse eid="1CH 28:21" /></para>
  <chapter eid="1CH 28" />
  <chapter number="29" style="c" sid="1CH 29" />
  <para style="s1">मंदिर बनाय बर भेंट देवई</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1" />तब राजा दाऊद ह पूरा सभा के मनखेमन ला कहिस: “मोर बेटा सुलेमान, जेला परमेसर ह चुने हवय, ओह छोटे हवय अऊ ओला अनुभव घलो नइं ए। पर काम ह बड़े हे, काबरकि ये महल सहीं भवन ह मनखे बर नइं, पर यहोवा परमेसर बर बनही। <verse eid="1CH 29:1" /><verse number="2" style="v" sid="1CH 29:2" />मोर जम्मो साधनमन ले मेंह मोर परमेसर के मंदिर बर चीजमन ला दे हवंव—सोन के काम बर सोन, चांदी के काम बर चांदी, कांसा के काम बर कांसा, लोहा के काम बर लोहा अऊ लकड़ी के काम बर लकड़ी, संग म लगाय या जड़े बर गोमेदक, फिरोजा, कई रंग के कीमती पथरा, अऊ किसम-किसम के जम्मो सुघर पथरा अऊ संगमरमर के पथरा—ये जम्मो चीज भारी मात्रा म दे हवंव <verse eid="1CH 29:2" /><verse number="3" style="v" sid="1CH 29:3" />ओ हर एक चीज, जेला मेंह ये पबितर मंदिर बर मोर परमेसर के मंदिर के भक्ति म दे हवंव, येकर अलावा, मेंह अब मोर परमेसर के मंदिर बर अपन खुद के खजाना के सोन अऊ चांदी देवत हंव: <verse eid="1CH 29:3" /><verse number="4" style="v" sid="1CH 29:4" />याने कि तीन हजार सोन (ओपीर के सोन) के टेलेन्ट<note caller="+" style="f"><char style="fr" closed="false">29:4 </char><char style="ft" closed="false">लगभग 110 टन</char></note> अऊ सात हजार टेलेन्ट<note caller="+" style="f"><char style="fr" closed="false">29:4 </char><char style="ft" closed="false">लगभग 260 टन</char></note> सुध करे गे चांदी, भवन के दीवारमन म मढ़े बर, <verse eid="1CH 29:4" /><verse number="5" style="v" sid="1CH 29:5" />सोन के काम अऊ चांदी के काम बर, अऊ कारीगरमन के दुवारा करइया जम्मो काम बर दे हवंव। अब, आज कोन ह अपन ईछा ले अपनआप ला यहोवा बर समरपित करे चाहथे?”<verse eid="1CH 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 29:6" />तब परिवार के मुखियामन, इसरायल के गोत्र के अधिकारीमन, हजार-हजार दल के सेनापति अऊ सौ-सौ दल के सेनापतिमन, अऊ राजा के काम बर ठहिराय गे अधिकारीमन अपन-अपन ईछा ले दीन। <verse eid="1CH 29:6" /><verse number="7" style="v" sid="1CH 29:7" />ओमन परमेसर के मंदिर के काम बर पांच हजार टेलेन्ट<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">लगभग 190 टन</char></note> अऊ दस हजार दरकमोन<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">लगभग 84 किलोग्राम</char></note> सोन, दस हजार टेलेन्ट चांदी,<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">लगभग 380 टन</char></note> अठारह हजार टेलेन्ट<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">लगभग 675 टन</char></note> कांसा अऊ एक लाख टेलेन्ट<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">लगभग 3,800 टन</char></note> लोहा दीन। <verse eid="1CH 29:7" /><verse number="8" style="v" sid="1CH 29:8" />जेकर करा कीमती पथरामन रिहिन, ओमन ओ पथरामन ला यहोवा के मंदिर के खजाना म दे दीन, जऊन ह गेरसोनीमन के यहीएल के देखरेख म रिहिस। <verse eid="1CH 29:8" /><verse number="9" style="v" sid="1CH 29:9" />अपन अगुवामन के ईछा से देवई ला देखके, मनखेमन आनंद मनाईन, काबरकि ओमन खुले मन ले अऊ अपन ईछा ले यहोवा ला देय रिहिन। दाऊद राजा घलो बहुंत आनंद मनाईस।<verse eid="1CH 29:9" /></para>
  <para style="s1">दाऊद के पराथना</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10" />दाऊद ह जम्मो सभा के आघू म यहोवा के ये कहिके महिमा करिस,</para>
  <para style="q1" vid="1CH 29:10">“हे यहोवा, हमर ददा इसरायल के परमेसर,</para>
  <para style="q2" vid="1CH 29:10">अनादिकाल ले अनंतकाल तक,</para>
  <para style="q2" vid="1CH 29:10">तोर महिमा होवय।<verse eid="1CH 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 29:11" />हे यहोवा, महानता अऊ सामर्थ</para>
  <para style="q2" vid="1CH 29:11">अऊ महिमा अऊ गौरव अऊ सोभा तोर ए,</para>
  <para style="q2" vid="1CH 29:11">काबरकि स्वरग अऊ धरती म हर चीज ह तोर ए।</para>
  <para style="q1" vid="1CH 29:11">हे यहोवा, राज ह तोर ए;</para>
  <para style="q2" vid="1CH 29:11">तेंह जम्मो के ऊपर मुखिया के रूप म उठाय गे हस।<verse eid="1CH 29:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 29:12" />धन-संपत्ति अऊ आदर तोर करा ले आथे;</para>
  <para style="q2" vid="1CH 29:12">तेंह जम्मो चीज के ऊपर परभूता करथस।</para>
  <para style="q1" vid="1CH 29:12">जम्मो ला उठाय अऊ बल देय बर</para>
  <para style="q2" vid="1CH 29:12">तोर हांथ म बल अऊ सामर्थ हवय।<verse eid="1CH 29:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 29:13" />अब, हे हमर परमेसर, हमन तोला धनबाद,</para>
  <para style="q2" vid="1CH 29:13">अऊ तोर महिमामय नांव के इस्तुति करथन।<verse eid="1CH 29:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 29:14" />“पर मेंह कोन अंव, अऊ मोर मनखेमन कोन अंय, कि हमन अइसने उदार मन ले दे सकन? हर एक चीज तोर करा ले आथे, अऊ हमन तोला सिरिप ओही चीज दे हन, जऊन ह तोर ले हमर करा आथे। <verse eid="1CH 29:14" /><verse number="15" style="v" sid="1CH 29:15" />हमन तोर नजर म परदेसी अऊ अजनबी अन, जइसे कि हमर जम्मो पुरखामन रिहिन। धरती म हमर दिन ह बिगर आसा के एक छइहां सहीं अय। <verse eid="1CH 29:15" /><verse number="16" style="v" sid="1CH 29:16" />हे यहोवा हमर परमेसर, ये जम्मो बहुंत अकन चीज, जेला हमन तोर पबितर नांव बर एक भवन बनाय खातिर दे हवन, ये जम्मो चीज तोर करा ले आथे, अऊ ये जम्मो चीज तोर अय। <verse eid="1CH 29:16" /><verse number="17" style="v" sid="1CH 29:17" />हे मोर परमेसर, मेंह जानत हंव कि तेंह मन ला जांचथस अऊ ईमानदारी ले खुस होथस। ये जम्मो चीज मेंह अपन ईछा ले अऊ सही मनसा ले दे हवंव। अऊ अब मेंह आनंद के संग देखे हंव कि तोर मनखे, जऊन मन इहां हवंय, कइसे अपन ईछा ले तोला देय हवंय। <verse eid="1CH 29:17" /><verse number="18" style="v" sid="1CH 29:18" />हे यहोवा, हमर पुरखा अब्राहम, इसहाक अऊ इसरायल के परमेसर, ये ईछा अऊ बिचारमन ला अपन मनखेमन के मन म हमेसा बनाय रख, अऊ ओमन के मन ला अपन कोति लगाय रख। <verse eid="1CH 29:18" /><verse number="19" style="v" sid="1CH 29:19" />अऊ मोर बेटा सुलेमान ला भक्ति ले भरे अइसे मन दे कि ओह तोर हुकूम, कानून अऊ बिधिमन ला मानय अऊ ओ महल सहीं भवन ला बनाय बर हर काम करे, जेकर इंतजाम मेंह करे हवंव।”<verse eid="1CH 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 29:20" />तब दाऊद ह जम्मो सभा के मनखेमन ला कहिस, “यहोवा तुम्हर परमेसर के महिमा होवय।” तब ओमन जम्मो यहोवा, अपन पुरखामन के परमेसर के महिमा करिन; ओमन मुड़ नवाके, यहोवा अऊ राजा ला सास्टांग दंडवत करिन।<verse eid="1CH 29:20" /></para>
  <para style="s1">सुलेमान ला राजा के रूप म स्वीकार करई</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 29:21" />ओकर दूसर दिन, ओमन यहोवा ला बलिदान चघाईन अऊ ओकर करा होम-बलिदान लानिन: एक हजार बईला, एक हजार मेढ़ा अऊ एक हजार नर मेढ़ा-पीला, अऊ संग म ओमन के पेय-बलिदान, अऊ जम्मो इसरायल बर बहुंत अकन आने बलिदान। <verse eid="1CH 29:21" /><verse number="22" style="v" sid="1CH 29:22" />ओ दिन ओमन यहोवा के आघू म बहुंत आनंद सहित खाईन अऊ पीईन।</para>
  <para style="p" vid="1CH 29:22">तब ओमन दाऊद के बेटा सुलेमान ला दूसर बार राजा के रूप म स्वीकार करिन, अऊ यहोवा के आघू म ओला सासन करे बर अऊ सादोक ला पुरोहित के काम बर अभिसेक करिन। <verse eid="1CH 29:22" /><verse number="23" style="v" sid="1CH 29:23" />तब सुलेमान ह यहोवा के सिंघासन म अपन ददा दाऊद के जगह म राजा के रूप म बईठिस। ओह उन्नति करत गीस अऊ जम्मो इसरायल ह ओकर बात मानिस। <verse eid="1CH 29:23" /><verse number="24" style="v" sid="1CH 29:24" />जम्मो अधिकारी अऊ योद्धा, संग म राजा दाऊद के जम्मो बेटामन सुलेमान राजा के अधीन रहे के सपथ खाईन।<verse eid="1CH 29:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 29:25" />यहोवा ह सुलेमान ला जम्मो इसरायल के नजर म बहुंत बढ़ाईस अऊ ओला अइसे राजकीय सोभा दीस, जइसे ओकर पहिले इसरायल म कोनो राजा ला नइं देय रिहिस।<verse eid="1CH 29:25" /></para>
  <para style="s1">दाऊद के मिरतू</para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26" />यिसै के बेटा दाऊद ह जम्मो इसरायल के ऊपर राजा रिहिस। <verse eid="1CH 29:26" /><verse number="27" style="v" sid="1CH 29:27" />ओह इसरायल ऊपर चालीस साल तक राज करिस—सात साल हेबरोन सहर म अऊ तैंतीस साल यरूसलेम सहर म। <verse eid="1CH 29:27" /><verse number="28" style="v" sid="1CH 29:28" />ओह लम्बा जिनगी, धन अऊ आदरमान के आनंद उठाके बने बुढ़त काल म मरिस। ओकर बेटा सुलेमान ओकर जगह म राजा बनिस।<verse eid="1CH 29:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 29:29" />सुरू ले लेके आखिरी तक, दाऊद राजा के राज के घटनामन समूएल अगम-दरसी के अभिलेख, नातान अगमजानी के अभिलेख अऊ गाद अगम-दरसी के अभिलेख म लिखे गे हवंय, <verse eid="1CH 29:29" /><verse number="30" style="v" sid="1CH 29:30" />संग म ओकर राज अऊ सक्ति, अऊ ओकर आसपास के अऊ इसरायल के अऊ आने जम्मो देसमन के परिस्थिति के बारे म घलो लिखे गे हवय।<verse eid="1CH 29:30" /></para>
  <chapter eid="1CH 29" />
</usx>