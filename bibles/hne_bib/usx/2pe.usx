<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2PE" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  <para style="h">2 पतरस</para>
  <para style="toc1">पतरस के दूसरा चिट्ठी</para>
  <para style="toc2">2 पतरस</para>
  <para style="toc3">2 पत</para>
  <para style="mt1">पतरस</para>
  <para style="mt2">के दूसरा चिट्ठी</para>
  <chapter number="1" style="c" sid="2PE 1"/>
  <para style="po">
    <verse number="1" style="v" sid="2PE 1:1"/>ये चिट्ठी सिमोन पतरस के तरफ ले, जऊन ह यीसू मसीह के एक सेवक अऊ प्रेरित ए,</para>
  <para style="po" vid="2PE 1:1">ओमन ला मिलय, जऊन मन हमर परमेसर अऊ उद्धार करइया यीसू मसीह के धरमीपन के दुवारा हमरेच सहीं कीमती बिसवास ला पाय हवंय:<verse eid="2PE 1:1"/></para>
  <para style="po">
    <verse number="2" style="v" sid="2PE 1:2"/>तुमन ला परमेसर अऊ यीसू हमर परभू के गियान के जरिये, अनुग्रह अऊ सांति बहुंतायत ले मिलय।<verse eid="2PE 1:2"/></para>
  <para style="s1">बुलावा अऊ चुनाव के निस्चयता</para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 1:3"/>परमेसर के ईस्वरीय सामर्थ ह हमन ला ओ जम्मो चीज दे हवय, जेकर जरूरत हमन ला जिनगी अऊ भक्ति खातिर होथे अऊ येह हमन ला ओकर बारे म हमर गियान के जरिये मिले हवय, जऊन ह हमन ला अपन खुद के महिमा अऊ भलई के दुवारा बलाय हवय। <verse eid="2PE 1:3"/><verse number="4" style="v" sid="2PE 1:4"/>येमन के जरिये, ओह हमन ला अपन बहुंत महान अऊ कीमती परतिगियां दे हवय, ताकि ओमन के जरिये, तुमन ईस्वरीय सुभाव म सहभागी होवव, अऊ ओ बुरई के काम ले बच जावव, जऊन ह संसार म हवय अऊ खराप लालसा ले आथे।<verse eid="2PE 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2PE 1:5"/>एकरे कारन, तुमन हर किसम ले कोसिस करके अपन बिसवास म भलई, अऊ भलई म गियान, <verse eid="2PE 1:5"/><verse number="6" style="v" sid="2PE 1:6"/>अऊ गियान म संयम, अऊ संयम म भक्ति, <verse eid="2PE 1:6"/><verse number="7" style="v" sid="2PE 1:7"/>अऊ भक्ति म भाई-चारा के दया, अऊ भाई-चारा के दया म मया जोड़त जावव। <verse eid="2PE 1:7"/><verse number="8" style="v" sid="2PE 1:8"/>काबरकि कहूं ये गुन तुमन म रहिथें अऊ येमन बढ़त जाथें, त येमन तुमन ला हमर परभू यीसू मसीह के गियान म निठल्ला अऊ असफल नइं होवन देवंय। <verse eid="2PE 1:8"/><verse number="9" style="v" sid="2PE 1:9"/>पर जेकर म ये गुन नइं ए, ओला धुंधला दिखथे अऊ ओह अंधरा ए, अऊ ओह भुला गे हवय कि ओह अपन पहिली के पाप ले धोवाके साफ हो गे हवय।<verse eid="2PE 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 1:10"/>एकरसेति, हे मोर भाईमन, अपन बुलावा अऊ चुनाव ला निस्चित करे बर अऊ उत्सुक रहव, काबरकि कहूं तुमन अइसने करहू, त तुमन अपन बिसवास ले कभू नइं हटहू, <verse eid="2PE 1:10"/><verse number="11" style="v" sid="2PE 1:11"/>अऊ हमर परभू अऊ उद्धार करइया यीसू मसीह के सदाकाल के राज म तुम्हर जोरदार सुवागत होही।<verse eid="2PE 1:11"/></para>
  <para style="s1">परमेसर के बचन के अगमबानी</para>
  <para style="p">
    <verse number="12" style="v" sid="2PE 1:12"/>एकरसेति, मेंह तुमन ला हमेसा ये बातमन के सुरता करावत रहिहूं, हालाकि तुमन येमन ला जानथव अऊ ओ सच, जऊन ह तुम्हर करा हवय, ओमा तुमन मजबूत हो गे हवव। <verse eid="2PE 1:12"/><verse number="13" style="v" sid="2PE 1:13"/>मेंह सोचथंव कि मोर बर येह उचित ए कि जब तक मेंह ये देहें के तम्बू म रहत हवंव, तुम्हर सुरता ला ताजा करत रहंव, <verse eid="2PE 1:13"/><verse number="14" style="v" sid="2PE 1:14"/>काबरकि मेंह जानथंव कि मेंह ये देहें ला जल्दी छोंड़ दूहूं जइसने कि हमर परभू यीसू मसीह ह मोला बताय हवय। <verse eid="2PE 1:14"/><verse number="15" style="v" sid="2PE 1:15"/>अऊ मेंह ये बात के पूरा कोसिस करहूं कि मोर मरे के बाद, तुमन ये बातमन ला हमेसा सुरता करव।<verse eid="2PE 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2PE 1:16"/>जब हमन तुमन ला हमर परभू यीसू मसीह के सामर्थ अऊ अवई के बारे बताएंन, त हमन चतुरई ले गढ़े गय कहानीमन के नकल नइं करेंन, पर हमन यीसू के महिमा ला अपन आंखी ले देखे रहेंन। <verse eid="2PE 1:16"/><verse number="17" style="v" sid="2PE 1:17"/>काबरकि ओह, परमेसर ददा ले आदर अऊ महिमा पाईस, जब वैभवसाली महिमा ले ओकर करा ये कहिके अवाज आईस, “येह मोर मयारू बेटा ए; एकर ले मेंह बहुंत खुस हवंव।”<note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="MAT 17:5">मत्ती 17:5</ref>; <ref loc="MRK 9:7">मर 9:7</ref>; <ref loc="LUK 9:35">लूका 9:35</ref></char></char></note> <verse eid="2PE 1:17"/><verse number="18" style="v" sid="2PE 1:18"/>जब हमन पबितर पहाड़ ऊपर ओकर संग रहेंन, त हमन खुद ये अवाज ला सुनेंन, जऊन ह स्वरग ले आवत रिहिस।<verse eid="2PE 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2PE 1:19"/>अऊ हमर करा अगमजानीमन के बचन हवय, जऊन ह ये बात ला अऊ मजबूत करिस। तुमन एकर ऊपर धियान देके बने करहू। काबरकि येह एक दीया सहीं अय, जऊन ह एक अंधियार जगह म चमकत हवय, अऊ येह तब तक चमकथे, जब तक कि दिन नइं निकलय अऊ तुम्हर हिरदय म बिहनियां के तारा नइं निकल आवय। <verse eid="2PE 1:19"/><verse number="20" style="v" sid="2PE 1:20"/>सबले पहिली, तुमन ये बात ला जरूर समझ लेवव कि परमेसर के बचन म बताय अगम के बात ह काकरो खुद के बचन के बखान नो हय। <verse eid="2PE 1:20"/><verse number="21" style="v" sid="2PE 1:21"/>काबरकि अगमबानी के सुरूआत मनखे के ईछा ले कभू नइं होईस, पर मनखेमन पबितर आतमा के अगुवई म, परमेसर कोति ले बोलिन।<verse eid="2PE 1:21"/></para>
  <chapter eid="2PE 1"/>
  <chapter number="2" style="c" sid="2PE 2"/>
  <para style="s1">लबरा गुरूमन अऊ ओमन के बिनास</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 2:1"/>पर मनखेमन के बीच म लबरा अगमजानीमन घलो रिहिन अऊ ओही किसम ले तुम्हर बीच म लबरा गुरूमन होहीं। ओमन गुपत रूप ले बिनासकारी लबारी सिकछा ला तुम्हर बीच म लानहीं, अऊ त अऊ ओमन परमपरधान परभू के इनकार करहीं, जऊन ह ओमन ला बिसाय हवय अऊ ये किसम ले ओमन अपन ऊपर अचानक बिनास लानहीं। <verse eid="2PE 2:1"/><verse number="2" style="v" sid="2PE 2:2"/>बहुंते झन ओमन के खराप जिनगी के नकल करहीं, अऊ ओमन के कारन, सत के रसता के अनादर होही। <verse eid="2PE 2:2"/><verse number="3" style="v" sid="2PE 2:3"/>अपन लालच म, ये गुरूमन अपन खुद के बनाय कथा-कहानी के दुवारा तुम्हर ले फायदा उठाहीं। ओमन के दंड के फैसला बहुंत पहिली हो चुके हवय, अऊ ओमन के बिनास जरूर होही।<verse eid="2PE 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2PE 2:4"/>जब परमेसर ह ओ स्वरगदूतमन ला नइं छोंड़िस, जऊन मन पाप करे रिहिन, पर ओमन ला अंधियार के बंधना म रखके नरक पठो दीस, ताकि ओमन नियाय बर उहां बंदी रहंय। <verse eid="2PE 2:4"/><verse number="5" style="v" sid="2PE 2:5"/>जब परमेसर ह पहिली जुग के संसार ला नइं छोंड़िस, जब ओह जल-परलय ले भक्तिहीन मनखेमन ला नास करिस, पर ओह धरमीपन के परचारक—नूह अऊ सात झन आने मनखेमन ला बचाईस; <verse eid="2PE 2:5"/><verse number="6" style="v" sid="2PE 2:6"/>अऊ जब सजा के रूप म, परमेसर ह सदोम अऊ अमोरा सहरमन ला जलाके राख कर दीस, अऊ येला एक नमूना के रूप म रखिस—ये देखाय बर कि भक्तिहीन मनखेमन के का होवइया हवय; <verse eid="2PE 2:6"/><verse number="7" style="v" sid="2PE 2:7"/>अऊ जब ओह धरमी मनखे लूत ला बचाईस, जऊन ह दुस्ट मनखेमन के खराप चालचलन के कारन बहुंत दुखी रिहिस <verse eid="2PE 2:7"/><verse number="8" style="v" sid="2PE 2:8"/>(काबरकि ओ धरमी जन ह ओमन के बीच म रहत रिहिस अऊ ओमन के अधरम के काम ला देखके अऊ सुनके दिन ब दिन, अपन मन म पीरा के अनुभव करत रिहिस)— <verse eid="2PE 2:8"/><verse number="9" style="v" sid="2PE 2:9"/>जब अइसने बात ए, तब परभू ह जानथे कि धरमी मनखेमन ला परिछा म ले कइसने निकालथें अऊ अधरमीमन ला कइसने सजा देवत नियाय के दिन बर रखथें। <verse eid="2PE 2:9"/><verse number="10" style="v" sid="2PE 2:10"/>येह खास करके, ओमन बर सही ए, जऊन मन अपन पापमय सुभाव के खराप ईछा के मुताबिक चलथें अऊ अधिकारीमन ला तुछ समझथें।</para>
  <para style="p" vid="2PE 2:10">ये मनखेमन हिम्मती अऊ ढीठ अंय अऊ ओमन स्वरगीय जीवमन के बदनामी करे बर नइं डरंय; <verse eid="2PE 2:10"/><verse number="11" style="v" sid="2PE 2:11"/>जबकि स्वरगदूत, जऊन मन जादा बलवान अऊ सक्तिसाली अंय, परभू के आघू म अइसने जीवमन के बिरोध म बदनामी के दोस नइं लगावंय। <verse eid="2PE 2:11"/><verse number="12" style="v" sid="2PE 2:12"/>पर ये मनखेमन ओ बात के बदनामी करथें, जेला येमन समझंय नइं। येमन जंगली पसुमन सहीं बिगर बुद्धि के जीव अंय, जऊन मन कि सिरिप पकड़े जाय बर अऊ नास होय बर जनमे हवंय, अऊ ओमन पसु के सहीं नास घलो होहीं।<verse eid="2PE 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2PE 2:13"/>जऊन हानि येमन करे हवंय, ओकर परतिफल येमन ला मिलही। दिन-मंझनियां म खा-पीके मऊज करई, येमन ला बने लगथे। येमन कलंकित अऊ दूसित अंय अऊ जब येमन तुम्हर संग जेवनार करथें, त अपन खुसी म मऊज-मस्ती करथें। <verse eid="2PE 2:13"/><verse number="14" style="v" sid="2PE 2:14"/>येमन के आंखीमन छिनारीपन ले भरे हवंय; येमन पाप करई कभू बंद नइं करंय; येमन चंचल मनखेमन ला बहका लेथें; येमन के हिरदय ह लालच म महारथ हासिल करे हवय; येमन परमेसर दुवारा सरापित अंय। <verse eid="2PE 2:14"/><verse number="15" style="v" sid="2PE 2:15"/>येमन सही रसता ला छोंड़ दे हवंय अऊ भटकके येमन बओर के बेटा बिलाम के रसता म हो ले हवंय, जऊन ह गलत काम के बनी ला पसंद करिस। <verse eid="2PE 2:15"/><verse number="16" style="v" sid="2PE 2:16"/>पर ओला ओकर गलत काम बर एक गदही ह दबकारिस। गदही जऊन ह एक पसु अय अऊ गोठियाय नइं सकय, पर ओ गदही ह मनखे के अवाज म गोठियाईस अऊ ओ अगमजानी के बईहापन ला रोकिस।<verse eid="2PE 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 2:17"/>ये मनखेमन बिगर पानी के सोता अऊ गरेर ले उड़ाय गय बादर अंय। घोर अंधियार ह येमन बर रखे गे हवय। <verse eid="2PE 2:17"/><verse number="18" style="v" sid="2PE 2:18"/>काबरकि येमन जुच्छा अऊ घमंड ले भरे बात करथें अऊ अपन पापी सुभाव के छिनारी ईछा के दुवारा ओ मनखेमन ला फंसाथें, जऊन मन गलत काम करइयामन के संगति ला मुसकिल ले छोंड़के आय हवंय। <verse eid="2PE 2:18"/><verse number="19" style="v" sid="2PE 2:19"/>येमन ओमन ले सुतंतरता के वायदा करथें, जबकि येमन खुद भ्रस्ट जिनगी के गुलाम अंय, काबरकि जऊन चीज ह मनखे ऊपर काबू पा लेथे, मनखे ह ओ चीज के गुलाम हो जाथे। <verse eid="2PE 2:19"/><verse number="20" style="v" sid="2PE 2:20"/>कहूं ओमन हमर परभू अऊ उद्धार करइया यीसू मसीह ला जाने के दुवारा संसार के असुधता ले बच गे हवंय, पर ओमन फेर ओमा फंसके ओकर बस म हो जाथें, त ओमन के दसा ह आखिरी म, ओमन के सुरू के दसा ले घलो अऊ खराप हो जाही। <verse eid="2PE 2:20"/><verse number="21" style="v" sid="2PE 2:21"/>ओमन बर बने होतिस कि ओमन धरमीपन के रसता ला नइं जाने रहितिन, एकर बदले कि ओला जाने के बाद, पबितर हुकूम के पालन नइं करई, जऊन ह ओमन ला दिये गे रिहिस। <verse eid="2PE 2:21"/><verse number="22" style="v" sid="2PE 2:22"/>ओमन बर ये कहावत सही बईठथे: “कुकुर ह अपन उछरे चीज ला खाय बर फेर लहुंटके आथे,”<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="ft" closed="false"><char style="xt"><ref loc="PRO 26:11">नीति 26:11</ref></char></char></note> अऊ “नहलाय-धूलाय माई सूरा ह चीखला म लोटे बर फेर चले जाथे।”<verse eid="2PE 2:22"/></para>
  <chapter eid="2PE 2"/>
  <chapter number="3" style="c" sid="2PE 3"/>
  <para style="s1">परभू के दिन</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 3:1"/>हे मयारू संगवारीमन हो, येह दूसरा चिट्ठी ए, जऊन ला मेंह तुमन ला लिखत हवंव। मेंह दूनों चिट्ठी ये सुरता कराय बर लिखे हवंव कि तुमन सही सोच-बिचार म बढ़त जावव। <verse eid="2PE 3:1"/><verse number="2" style="v" sid="2PE 3:2"/>मेंह चाहथंव कि तुमन ओ बचनमन ला सुरता करव, जऊन ह बहुंत पहिली पबितर अगमजानीमन के दुवारा कहे गे रिहिस अऊ हमर परभू अऊ उद्धार करइया के हुकूम ला सुरता करव, जऊन ह तुमन ला प्रेरितमन के जरिये दिये गे रिहिस।<verse eid="2PE 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 3:3"/>सबले पहिली, तुमन ये जरूर समझ लेवव कि आखिरी के दिन म ठट्ठा करइयामन आहीं अऊ ठट्ठा करत अपन खुद के खराप ईछा ला पूरा करहीं। <verse eid="2PE 3:3"/><verse number="4" style="v" sid="2PE 3:4"/>ओमन कहिहीं, “ओह आय के वायदा करे रिहिस, पर का होईस ओकर अवई के? हमर पुरखामन के मरे के समय ले, हर एक चीज ह वइसनेच हवय, जइसने ये संसार के सुरू ले रिहिस।” <verse eid="2PE 3:4"/><verse number="5" style="v" sid="2PE 3:5"/>पर ओमन जानबूझके ये बात ला भुला जाथें कि बहुंत पहिली, परमेसर के बचन के दुवारा अकासमन बनाय गीन अऊ धरती ह पानी म ले अऊ पानी के संग बनाय गीस। <verse eid="2PE 3:5"/><verse number="6" style="v" sid="2PE 3:6"/>पानी के दुवारा ही ओ समय के संसार म भयंकर बाढ़ आईस अऊ ओह नास हो गीस। <verse eid="2PE 3:6"/><verse number="7" style="v" sid="2PE 3:7"/>ओहीच बचन के दुवारा, ये समय के अकासमन अऊ धरती ला आगी म नास करे बर बचाके रखे गे हवय। ओमन नियाय के दिन बर अऊ भक्तिहीन मनखेमन के बिनास बर रखे गे हवंय।<verse eid="2PE 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2PE 3:8"/>पर हे मयारू संगवारीमन हो, ये बात ला झन भूलव: परभू के नजर म एक दिन ह एक हजार साल सहीं अय, अऊ एक हजार साल ह एक दिन सहीं अय। <verse eid="2PE 3:8"/><verse number="9" style="v" sid="2PE 3:9"/>परभू ह अपन वायदा ला पूरा करे बर देरी नइं करय, जइसने कि कुछू मनखेमन समझत हवंय। पर ओह तुम्हर संग धीरज धरे हवय, अऊ नइं चाहथे कि कोनो नास होवंय, पर ओह चाहथे कि हर एक झन ला पछताप करे के मऊका मिलय।<verse eid="2PE 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 3:10"/>पर परभू के दिन ह चोर के सहीं अचानक आ जाही। अकासमन एक गरजन के संग गायब हो जाहीं। सार-तत्व मन आगी के दुवारा नास हो जाहीं। धरती अऊ येमा करे गय जम्मो काम ला जला दिये जाही।<verse eid="2PE 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2PE 3:11"/>जब हर चीज ह, ये किसम ले नास करे जाही, त तुमन ला चाही कि पबितर अऊ भक्तिमय जिनगी जीयव, <verse eid="2PE 3:11"/><verse number="12" style="v" sid="2PE 3:12"/>जइसने कि तुमन परमेसर के दिन के बाट जोहथव अऊ भरसक कोसिस करथव कि येह जल्दी आवय। ओ दिन, अकासमन आगी म जरके नास हो जाहीं, अऊ सार-तत्व मन गरमी के मारे टघल जाहीं। <verse eid="2PE 3:12"/><verse number="13" style="v" sid="2PE 3:13"/>पर परमेसर के परतिगियां के मुताबिक, हमन एक नवां अकास अऊ नवां धरती के बाट जोहथन, जिहां सिरिप धरमीपन होही।<verse eid="2PE 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2PE 3:14"/>एकरसेति, हे मयारू संगवारीमन हो, जब तुमन ये बात के बाट जोहथव, त भरसक कोसिस करव कि तुमन निस्कलंक अऊ निरदोस पाय जावव अऊ तुमन ला ओकर संग सांति मिलय। <verse eid="2PE 3:14"/><verse number="15" style="v" sid="2PE 3:15"/>अपन मन म ये समझ लेवव कि हमर परभू के धीरज के मतलब उद्धार होथे, जइसने कि हमर मयारू भाई पौलुस घलो परमेसर के दुवारा दिये बुद्धि के मुताबिक तुमन ला लिखे हवय। <verse eid="2PE 3:15"/><verse number="16" style="v" sid="2PE 3:16"/>ओह अपन जम्मो चिट्ठी म, ये बातमन ला बतावत ओही किसम ले लिखथे। ओकर चिट्ठीमन म कुछू अइसने बातमन हवंय, जऊन ला समझना कठिन ए। अगियानी अऊ अस्थिर मनखेमन एकर गलत मतलब निकालथें, जइसने कि ओमन परमेसर के बचन के आने भागमन ला घलो करथें, अऊ ये किसम ले ओमन अपन बिनास करथें।<verse eid="2PE 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 3:17"/>एकरसेति, हे मयारू संगवारीमन हो, जब तुमन ला पहिले ही चेताय गे हवय, त सचेत रहव ताकि तुमन दुस्ट मनखेमन के बहकावा म झन आवव अऊ अपन बिसवास के स्थिरता ला झन गंवावव। <verse eid="2PE 3:17"/><verse number="18" style="v" sid="2PE 3:18"/>पर हमर परभू अऊ उद्धार करइया यीसू मसीह के अनुग्रह अऊ गियान म बाढ़त जावव।</para>
  <para style="b" vid="2PE 3:18"/>
  <para style="b" vid="2PE 3:18"/>
  <para style="p" vid="2PE 3:18">ओकर महिमा अभी अऊ सदाकाल तक होवत रहय! आमीन।<verse eid="2PE 3:18"/></para>
  <chapter eid="2PE 3"/>
</usx>
