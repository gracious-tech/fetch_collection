<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LAM" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  <para style="h">बिलापगीत</para>
  <para style="toc1">बिलापगीत के किताब</para>
  <para style="toc2">बिलापगीत</para>
  <para style="toc3">बिला</para>
  <para style="mt1">बिलापगीत</para>
  <para style="mt2">के किताब</para>
  <chapter number="1" style="c" sid="LAM 1"/>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 1:1"/>सहर<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">यरूसलेम सहर</char></note> ह कइसे निरजन हो गे हवय,</para>
  <para style="q2" vid="LAM 1:1">एक समय रिहिस जब येह मनखेमन ले भरे रहय!</para>
  <para style="q1" vid="LAM 1:1">कइसे बिधवा के सहीं हो गे हवय,</para>
  <para style="q2" vid="LAM 1:1">जऊन ह एक समय देस-देस के मनखेमन के बीच म महान रिहिस!</para>
  <para style="q1" vid="LAM 1:1">ओ जऊन ह राजमन के बीच म रानी रिहिस</para>
  <para style="q2" vid="LAM 1:1">अब गुलाम बन गे हवय।<verse eid="LAM 1:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 1:2"/>रथिया ओह फूट-फूटके रोथे,</para>
  <para style="q2" vid="LAM 1:2">ओकर गाल म आंसू बहत रहिथे।</para>
  <para style="q1" vid="LAM 1:2">ओकर जम्मो मयारूमन के बीच म</para>
  <para style="q2" vid="LAM 1:2">ओला कोनो सांतवना देवइया नइं एं।</para>
  <para style="q1" vid="LAM 1:2">ओकर जम्मो संगीमन ओला धोखा दे हवंय;</para>
  <para style="q2" vid="LAM 1:2">ओमन ओकर बईरी बन गे हवंय।<verse eid="LAM 1:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 1:3"/>दुख अऊ कठोर मेहनत के बाद,</para>
  <para style="q2" vid="LAM 1:3">यहूदा ह बंधुवई म चले गे हवय।</para>
  <para style="q1" vid="LAM 1:3">ओह जाति-जाति के मनखेमन के बीच म रहिथे;</para>
  <para style="q2" vid="LAM 1:3">ओला अराम के जगह नइं मिलय।</para>
  <para style="q1" vid="LAM 1:3">ओकर दुख के बेरा म, ओकर पीछा करइयामन</para>
  <para style="q2" vid="LAM 1:3">ओला पकड़ ले हवंय।<verse eid="LAM 1:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 1:4"/>सियोन के रसतामन बिलाप के अंय,</para>
  <para style="q2" vid="LAM 1:4">काबरकि ठहिराय गे तिहारमन म ओकर करा कोनो नइं आवंय।</para>
  <para style="q1" vid="LAM 1:4">ओकर जम्मो प्रवेस दुवारमन सुन्ना परे हवंय,</para>
  <para style="q2" vid="LAM 1:4">ओकर पुरोहितमन कराहथें,</para>
  <para style="q1" vid="LAM 1:4">ओकर जवान माईलोगनमन दुख मनाथें,</para>
  <para style="q2" vid="LAM 1:4">अऊ ओह खुद बहुंत पीरा म हवय।<verse eid="LAM 1:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 1:5"/>ओकर बईरीमन ओकर मालिक बन गे हवंय;</para>
  <para style="q2" vid="LAM 1:5">ओकर बईरीमन अराम म हवंय।</para>
  <para style="q1" vid="LAM 1:5">यहोवा ह ओकर ऊपर दुख लाने हवय</para>
  <para style="q2" vid="LAM 1:5">काबरकि ओह बहुंत पाप करे हवय।</para>
  <para style="q1" vid="LAM 1:5">ओकर लइकामन ला बईरीमन</para>
  <para style="q2" vid="LAM 1:5">अपन बंधुवई म ले गे हवंय।<verse eid="LAM 1:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 1:6"/>बेटी सियोन के पूरा वैभव ह</para>
  <para style="q2" vid="LAM 1:6">चले गे हवय।</para>
  <para style="q1" vid="LAM 1:6">ओकर हाकिममन ओ हिरन सहीं हो गे हवंय</para>
  <para style="q2" vid="LAM 1:6">जेला चरागन नइं मिलय;</para>
  <para style="q1" vid="LAM 1:6">कमजोरी म ओमन</para>
  <para style="q2" vid="LAM 1:6">अपन पीछा करइया के आघू ले भाग जाथें।<verse eid="LAM 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 1:7"/>अपन पीरा अऊ एती-ओती भटके के दिन म</para>
  <para style="q2" vid="LAM 1:7">यरूसलेम ह ओ जम्मो खजाना ला सुरता करथे</para>
  <para style="q2" vid="LAM 1:7">जऊन ह पुराना जमाना म ओकर रिहिस।</para>
  <para style="q1" vid="LAM 1:7">जब ओकर मनखेमन बईरीमन के हांथ म पड़िन,</para>
  <para style="q2" vid="LAM 1:7">त ओकर मदद करइया कोनो नइं रिहिन।</para>
  <para style="q1" vid="LAM 1:7">ओकर बईरीमन ओला देखिन</para>
  <para style="q2" vid="LAM 1:7">अऊ ओकर बिनास ऊपर हंसिन।<verse eid="LAM 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 1:8"/>यरूसलेम ह बहुंत पाप करे हवय</para>
  <para style="q2" vid="LAM 1:8">अऊ एकरसेति ओह असुध हो गे हवय।</para>
  <para style="q1" vid="LAM 1:8">ओ जम्मो जऊन मन ओकर आदर करंय, ओमन अब ओला तुछ समझथें,</para>
  <para style="q2" vid="LAM 1:8">काबरकि ओ जम्मो झन ओला नंगरी देखे हवंय;</para>
  <para style="q1" vid="LAM 1:8">ओह खुदे कराहथे</para>
  <para style="q2" vid="LAM 1:8">अऊ मुहूं ला आने कोति कर लेथे।<verse eid="LAM 1:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 1:9"/>ओकर गंदगी ह ओकर लंहगा म रहिथे;</para>
  <para style="q2" vid="LAM 1:9">ओह अपन भविस्य ऊपर बिचार नइं करिस।</para>
  <para style="q1" vid="LAM 1:9">ओकर पतन ह चकित करनेवाला रिहिस;</para>
  <para style="q2" vid="LAM 1:9">ओला सांतवना देवइया कोनो नइं रिहिन।</para>
  <para style="q1" vid="LAM 1:9">“हे यहोवा, मोर पीरा ला देख,</para>
  <para style="q2" vid="LAM 1:9">काबरकि बईरी ह जय पाय हवय।”<verse eid="LAM 1:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 1:10"/>बईरी ह ओकर जम्मो खजाना ऊपर</para>
  <para style="q2" vid="LAM 1:10">हांथ डाले हवय;</para>
  <para style="q1" vid="LAM 1:10">ओह मूरती-पूजा करइया जातिमन ला</para>
  <para style="q2" vid="LAM 1:10">ओकर पबितर-स्थान म घुसत देखिस—</para>
  <para style="q1" vid="LAM 1:10">ओमन जेमन ला तेंह अपन सभा म</para>
  <para style="q2" vid="LAM 1:10">आय बर मना करे रहय।<verse eid="LAM 1:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 1:11"/>ओकर जम्मो मनखेमन कराहथें</para>
  <para style="q2" vid="LAM 1:11">जइसे ओमन जेवन के खोज म हवंय;</para>
  <para style="q1" vid="LAM 1:11">ओमन जेवन के बदले अपन खजाना के चीजमन ला दे देथें</para>
  <para style="q2" vid="LAM 1:11">ताकि अपनआप ला जिंदा रख सकंय।</para>
  <para style="q1" vid="LAM 1:11">“हे यहोवा, देख अऊ बिचार कर,</para>
  <para style="q2" vid="LAM 1:11">काबरकि मोला तुछ समझे जावत हे।”<verse eid="LAM 1:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 1:12"/>“तुमन जम्मो, जऊन मन ये रसता ले होके निकलथव, का तुमन बर येह कुछू नो हय?</para>
  <para style="q2" vid="LAM 1:12">अपन आसपास धियान से देखव।</para>
  <para style="q1" vid="LAM 1:12">का मोर दुख सहीं कोनो दुख हवय</para>
  <para style="q2" vid="LAM 1:12">अइसन दुख, जऊन ह मोर ऊपर पड़े हवय,</para>
  <para style="q1" vid="LAM 1:12">जेला यहोवा ह अपन भयंकर कोप के दिन म</para>
  <para style="q2" vid="LAM 1:12">मोर ऊपर लानिस?<verse eid="LAM 1:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 1:13"/>“ऊंच जगह ले यहोवा ह</para>
  <para style="q2" vid="LAM 1:13">मोर हाड़ामन म आगी लगाईस।</para>
  <para style="q1" vid="LAM 1:13">ओह मोर गोड़ बर एक जाल बिछाईस</para>
  <para style="q2" vid="LAM 1:13">अऊ मोला वापिस लहुंटा दीस।</para>
  <para style="q1" vid="LAM 1:13">ओह मोला पूरा दिन बर</para>
  <para style="q2" vid="LAM 1:13">अकेला अऊ दुरबल कर दीस।<verse eid="LAM 1:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 1:14"/>“मोर पापमन ला एक जुड़ा म बांध दिये गे हवय;</para>
  <para style="q2" vid="LAM 1:14">यहोवा ह अपन हांथ ले ओमन ला एक संग गांथे हवय।</para>
  <para style="q1" vid="LAM 1:14">ओमन ला मोर घेंच म टांग दिये गे हवय,</para>
  <para style="q2" vid="LAM 1:14">अऊ परभू ह मोर बल ला घटा दे हवय।</para>
  <para style="q1" vid="LAM 1:14">ओह मोला ओमन के हांथ म देय दे हवय</para>
  <para style="q2" vid="LAM 1:14">जेमन के मेंह सामना नइं कर सकंव।<verse eid="LAM 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 1:15"/>“परभू ह मोर बीच म</para>
  <para style="q2" vid="LAM 1:15">जम्मो सूरबीरमन ला अयोग्य कर दे हवय;</para>
  <para style="q1" vid="LAM 1:15">ओह मोर जवानमन ला कुचरे बर</para>
  <para style="q2" vid="LAM 1:15">मोर बिरूध एक सेना पठोय हवय।</para>
  <para style="q1" vid="LAM 1:15">परभू ह रसकुंड म अंगूर ला कुचरे सहीं</para>
  <para style="q2" vid="LAM 1:15">कुंवारी बेटी यहूदा ला कुचरे हवय।<verse eid="LAM 1:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 1:16"/>“येकरे कारन मेंह रोथंव</para>
  <para style="q2" vid="LAM 1:16">अऊ मोर आंखीमन ले आंसू ढरत रहिथे।</para>
  <para style="q1" vid="LAM 1:16">मोला सांतवना देय बर लकठा म कोनो नइं एं,</para>
  <para style="q2" vid="LAM 1:16">मोर आतमा ला सांत करइया कोनो नइं एं।</para>
  <para style="q1" vid="LAM 1:16">मोर लइकामन निसहाय हो गे हवंय</para>
  <para style="q2" vid="LAM 1:16">काबरकि बईरी ह जय पाय हवय।”<verse eid="LAM 1:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 1:17"/>सियोन ह अपन हांथमन ला फईलाथे,</para>
  <para style="q2" vid="LAM 1:17">पर ओला सांतवना देवइया कोनो नइं एं।</para>
  <para style="q1" vid="LAM 1:17">यहोवा ह याकूब बर हुकूम दे हवय</para>
  <para style="q2" vid="LAM 1:17">कि ओकर परोसीमन ओकर बईरी बन जावंय;</para>
  <para style="q1" vid="LAM 1:17">यरूसलेम ह ओमन के बीच म</para>
  <para style="q2" vid="LAM 1:17">एक असुध चीज बन गे हवय।<verse eid="LAM 1:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 1:18"/>“यहोवा ह धरमी अय,</para>
  <para style="q2" vid="LAM 1:18">तभो ले मेंह ओकर हुकूम के बिरूध बिदरोह करेंव।</para>
  <para style="q1" vid="LAM 1:18">हे जम्मो मनखेमन, तुमन सुनव;</para>
  <para style="q2" vid="LAM 1:18">मोर पीरा ला देखव।</para>
  <para style="q1" vid="LAM 1:18">मोर जवान मनखे अऊ जवान माईलोगनमन</para>
  <para style="q2" vid="LAM 1:18">बंधुवई म चले गे हवंय।<verse eid="LAM 1:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 1:19"/>“मेंह अपन संगीमन ला बलांय</para>
  <para style="q2" vid="LAM 1:19">पर ओमन मोला धोखा दीन।</para>
  <para style="q1" vid="LAM 1:19">मोर पुरोहित अऊ मोर अगुवामन</para>
  <para style="q2" vid="LAM 1:19">सहर म नास हो गीन</para>
  <para style="q1" vid="LAM 1:19">जब ओमन अपनआप ला जिंदा रखे बर</para>
  <para style="q2" vid="LAM 1:19">जेवन के खोज म रिहिन।<verse eid="LAM 1:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 1:20"/>“हे यहोवा, देख, मेंह कतेक पीरा म हंव!</para>
  <para style="q2" vid="LAM 1:20">मेंह भीतरे-भीतर तकलीफ म हंव,</para>
  <para style="q1" vid="LAM 1:20">अऊ मेंह अपन हिरदय म बिचलित हंव,</para>
  <para style="q2" vid="LAM 1:20">काबरकि मेंह सबले जादा बिदरोह करे हंव।</para>
  <para style="q1" vid="LAM 1:20">बाहिर तो, तलवार ह सोकित करथे;</para>
  <para style="q2" vid="LAM 1:20">भीतर म, सिरिप मिरतू हवय।<verse eid="LAM 1:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 1:21"/>“मनखेमन मोर कलहरई ला सुने हवंय,</para>
  <para style="q2" vid="LAM 1:21">पर मोला सांतवना देवइया कोनो नइं एं।</para>
  <para style="q1" vid="LAM 1:21">मोर जम्मो बईरीमन मोर दुख के बारे म सुने हवंय;</para>
  <para style="q2" vid="LAM 1:21">तेंह जऊन काम करे हस, ओकर ऊपर ओमन आनंद मनाथें।</para>
  <para style="q1" vid="LAM 1:21">बने होतिस, यदि तेंह ओ दिन ला लानते, जेकर घोसना तेंह करे हवस</para>
  <para style="q2" vid="LAM 1:21">ताकि ओमन मोर सहीं हो जावंय।<verse eid="LAM 1:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 1:22"/>“ओमन के जम्मो दुस्टता तोर आघू म आ जावय;</para>
  <para style="q2" vid="LAM 1:22">ओमन के संग वइसे बरताव कर</para>
  <para style="q1" vid="LAM 1:22">जइसे तेंह मोर संग</para>
  <para style="q2" vid="LAM 1:22">मोर जम्मो पाप के कारन करे हवस।</para>
  <para style="q1" vid="LAM 1:22">मेंह बहुंत कलहरत हंव</para>
  <para style="q2" vid="LAM 1:22">अऊ मोर मन ह दुरबल हवय।”<verse eid="LAM 1:22"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="LAM 1"/>
  <chapter number="2" style="c" sid="LAM 2"/>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 2:1"/>परभू ह कइसे अपन कोरोध के बादर म</para>
  <para style="q2" vid="LAM 2:1">बेटी सियोन ला ढांप ले हवय!</para>
  <para style="q1" vid="LAM 2:1">ओह इसरायल के वैभव ला</para>
  <para style="q2" vid="LAM 2:1">स्वरग ले खाल्हे धरती म जोर से फटिक दे हवय;</para>
  <para style="q1" vid="LAM 2:1">ओह अपन कोरोध के दिन म</para>
  <para style="q2" vid="LAM 2:1">अपन पांव के चौकी ला सुरता नइं करिस।<verse eid="LAM 2:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 2:2"/>परभू ह बिगर दया के याकूब के</para>
  <para style="q2" vid="LAM 2:2">जम्मो निवासमन ला लील डारे हवय;</para>
  <para style="q1" vid="LAM 2:2">अपन कोप म ओह बेटी यहूदा के</para>
  <para style="q2" vid="LAM 2:2">गढ़मन ला टोर-फोर दे हवय।</para>
  <para style="q1" vid="LAM 2:2">ओह ओकर राज अऊ येकर हाकिममन ला</para>
  <para style="q2" vid="LAM 2:2">अपमानित करके भुइयां म ले आय हवय।<verse eid="LAM 2:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 2:3"/>भयंकर कोरोध म ओह इसरायल के</para>
  <para style="q2" vid="LAM 2:3">हर एक सींग<note caller="+" style="f"><char style="fr" closed="false">2:3 </char><char style="fq" closed="false">सींग </char><char style="ft" closed="false">इहां ताकत के प्रतीक अय</char></note> ला काट दे हवय।</para>
  <para style="q1" vid="LAM 2:3">जब बईरी ह ओमन के लकठा म आथे</para>
  <para style="q2" vid="LAM 2:3">त ओह अपन जेवनी हांथ ले ओमन के रकछा नइं करय।</para>
  <para style="q1" vid="LAM 2:3">ओह एक भयंकर आगी सहीं याकूब म बरे हवय</para>
  <para style="q2" vid="LAM 2:3">जऊन ह आसपास के जम्मो चीज ला भसम कर देथे।<verse eid="LAM 2:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 2:4"/>एक बईरी सहीं ओह अपन धनुस ला ताने हवय;</para>
  <para style="q2" vid="LAM 2:4">ओकर जेवनी हांथ ह तियार हवय।</para>
  <para style="q1" vid="LAM 2:4">एक बईरी सहीं ओह ओ जम्मो झन ला मार डारे हे</para>
  <para style="q2" vid="LAM 2:4">जऊन मन हमर नजर म बने रिहिन;</para>
  <para style="q1" vid="LAM 2:4">ओह बेटी सियोन के तम्बू म</para>
  <para style="q2" vid="LAM 2:4">अपन कोप ला आगी सहीं उंडेल दे हवय।<verse eid="LAM 2:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 2:5"/>परभू ह एक बईरी सहीं अय;</para>
  <para style="q2" vid="LAM 2:5">ओह इसरायल ला लील डारे हवय।</para>
  <para style="q1" vid="LAM 2:5">ओह ओकर जम्मो महलमन ला लील ले हवय</para>
  <para style="q2" vid="LAM 2:5">अऊ ओकर गढ़मन ला नास कर दे हवय।</para>
  <para style="q1" vid="LAM 2:5">ओह बेटी यहूदा बर</para>
  <para style="q2" vid="LAM 2:5">सोक अऊ बिलाप ला बहुंत बढ़ा दे हवय।<verse eid="LAM 2:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 2:6"/>ओह अपन निवास ला एक बगीचा सहीं उजार दे हवय;</para>
  <para style="q2" vid="LAM 2:6">ओह अपन मिले-जुले के जगह ला नास कर दे हवय।</para>
  <para style="q1" vid="LAM 2:6">यहोवा ह सियोन बर अइसे कर दे हवय</para>
  <para style="q2" vid="LAM 2:6">कि ओह अपन ठहिराय तिहार अऊ बिसराम दिनमन ला भुला जावय;</para>
  <para style="q1" vid="LAM 2:6">अपन भयंकर कोरोध म ओह</para>
  <para style="q2" vid="LAM 2:6">राजा अऊ पुरोहित दूनों के तिरस्कार करे हवय।<verse eid="LAM 2:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 2:7"/>परभू ह अपन बेदी ला अस्वीकार करे हवय</para>
  <para style="q2" vid="LAM 2:7">अऊ अपन पबितर-स्थान ला तियाग दे हवय।</para>
  <para style="q1" vid="LAM 2:7">ओह राजमहल के दीवारमन ला</para>
  <para style="q2" vid="LAM 2:7">बईरी के हांथ म कर दे हवय;</para>
  <para style="q1" vid="LAM 2:7">एक ठहिराय गे तिहार के दिन सहीं</para>
  <para style="q2" vid="LAM 2:7">ओमन यहोवा के घर म एक कोलाहल करे हवंय।<verse eid="LAM 2:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 2:8"/>यहोवा ह बेटी सियोन के चारों कोति के दीवार ला</para>
  <para style="q2" vid="LAM 2:8">टोरे-फोरे बर ठान ले हवय।</para>
  <para style="q1" vid="LAM 2:8">ओह नापे के डोर ला निकाले हवय</para>
  <para style="q2" vid="LAM 2:8">अऊ नास करे बर अपन हांथ ला नइं रोकिस।</para>
  <para style="q1" vid="LAM 2:8">ओह किला के सुरकछा दीवार अऊ दीवारमन ले बिलाप करवाईस;</para>
  <para style="q2" vid="LAM 2:8">एक संग ओमन उजड़ गीन।<verse eid="LAM 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 2:9"/>ओकर दुवारमन भुइयां म धंस गे हवंय;</para>
  <para style="q2" vid="LAM 2:9">ओमन के छड़मन ला ओह टोरके नास कर दे हवय।</para>
  <para style="q1" vid="LAM 2:9">ओकर राजा अऊ ओकर हाकिममन आनजातमन के बीच म बंधुवई म हवंय,</para>
  <para style="q2" vid="LAM 2:9">उहां कानून नइं ए,</para>
  <para style="q1" vid="LAM 2:9">अऊ ओकर अगमजानीमन ला यहोवा ले</para>
  <para style="q2" vid="LAM 2:9">अब कोनो दरसन नइं मिलय।<verse eid="LAM 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 2:10"/>बेटी सियोन के अगुवामन</para>
  <para style="q2" vid="LAM 2:10">भुइयां म चुपचाप बईठथें;</para>
  <para style="q1" vid="LAM 2:10">ओमन अपन मुड़ म धुर्रा छिंचे हवंय</para>
  <para style="q2" vid="LAM 2:10">अऊ ओमन बोरा के कपड़ा पहिरे हवंय।</para>
  <para style="q1" vid="LAM 2:10">यरूसलेम के जवान माईलोगनमन</para>
  <para style="q2" vid="LAM 2:10">भुइयां कोति अपन मुड़ नवाय हवंय।<verse eid="LAM 2:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 2:11"/>रो-रोके मोर आंखी नइं दिखत हे,</para>
  <para style="q2" vid="LAM 2:11">मेंह भीतरे-भीतर पीरा म हंव;</para>
  <para style="q1" vid="LAM 2:11">मोर हिरदय ला भुइयां म ढारे जावत हे</para>
  <para style="q2" vid="LAM 2:11">काबरकि मोर मनखेमन नास होवत हवंय,</para>
  <para style="q1" vid="LAM 2:11">काबरकि लइकामन अऊ दूध पीयइया लइकामन</para>
  <para style="q2" vid="LAM 2:11">सहर के गलीमन म मूर्छा खाके पड़े हवंय।<verse eid="LAM 2:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 2:12"/>जब ओमन घायल मनखे सहीं</para>
  <para style="q2" vid="LAM 2:12">सहर के गलीमन म मूर्छा खाथें,</para>
  <para style="q1" vid="LAM 2:12">जब ओमन अपन दाई के बाहां म</para>
  <para style="q2" vid="LAM 2:12">परान छोड़त रहिथें।</para>
  <para style="q1" vid="LAM 2:12">त ओमन अपन-अपन दाई ला कहिथें,</para>
  <para style="q2" vid="LAM 2:12">“रोटी अऊ अंगूर के मंद कहां हवय?”<verse eid="LAM 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 2:13"/>हे बेटी यरूसलेम,</para>
  <para style="q2" vid="LAM 2:13">मेंह तोला का कहंव?</para>
  <para style="q2" vid="LAM 2:13">मेंह तोर तुलना काकर संग करंव?</para>
  <para style="q1" vid="LAM 2:13">हे कुंवारी बेटी सियोन,</para>
  <para style="q2" vid="LAM 2:13">मेंह तोर तुलना काकर संग करके</para>
  <para style="q2" vid="LAM 2:13">तोला सांतवना देवंव?</para>
  <para style="q1" vid="LAM 2:13">तोर घाव ह समुंदर सहीं गहिला हवय।</para>
  <para style="q2" vid="LAM 2:13">तोला कोन चंगा कर सकथे?<verse eid="LAM 2:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 2:14"/>तोर अगमजानीमन के दरसनमन</para>
  <para style="q2" vid="LAM 2:14">लबारी बात अऊ बेकार अंय;</para>
  <para style="q1" vid="LAM 2:14">ओमन तोर पाप ला उजागर नइं करिन</para>
  <para style="q2" vid="LAM 2:14">नइं तो तोर बंधुवई नइं होतिस।</para>
  <para style="q1" vid="LAM 2:14">जऊन अगमबानी, ओमन तोर बर करिन</para>
  <para style="q2" vid="LAM 2:14">ओमन लबारी अऊ बहकानेवाला रिहिन।<verse eid="LAM 2:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 2:15"/>ओ जम्मो जऊन मन तोर रसता ले होके जाथें</para>
  <para style="q2" vid="LAM 2:15">ओमन ताली बजाके तोर ठट्ठा करथें;</para>
  <para style="q1" vid="LAM 2:15">ओमन बेटी यरूसलेम के ये कहिके</para>
  <para style="q2" vid="LAM 2:15">हंसी उड़ाथें अऊ अपन मुड़ ला हलाथें:</para>
  <para style="q1" vid="LAM 2:15">“का येह ओ सहर अय</para>
  <para style="q2" vid="LAM 2:15">जेला सुघरता म भरपूर कहे जावय,</para>
  <para style="q2" vid="LAM 2:15">जऊन ह जम्मो धरती के आनंद रिहिस?”<verse eid="LAM 2:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 2:16"/>तोर जम्मो बईरीमन तोर बिरूध म</para>
  <para style="q2" vid="LAM 2:16">अपन मुहूं खोलथें;</para>
  <para style="q1" vid="LAM 2:16">ओमन हंसी उड़ाथें अऊ दांत किटकिटात कहिथें,</para>
  <para style="q2" vid="LAM 2:16">“हमन ओला लील डारे हन।</para>
  <para style="q1" vid="LAM 2:16">येहीच ह ओ दिन ए, जेकर डहार हमन देखत रहेंन;</para>
  <para style="q2" vid="LAM 2:16">येला देखे बर हमन जीयत रहेंन।”<verse eid="LAM 2:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 2:17"/>यहोवा ह अपन योजना ला पूरा करे हवय;</para>
  <para style="q2" vid="LAM 2:17">ओह अपन बचन ला पूरा करे हवय,</para>
  <para style="q2" vid="LAM 2:17">जेकर आदेस ओह बहुंत पहिले देय रिहिस।</para>
  <para style="q1" vid="LAM 2:17">ओह बिगर दया के तोला उठाके फटिक दे हवय,</para>
  <para style="q2" vid="LAM 2:17">ओह तोर ऊपर बईरी ला खराप नजर ले देखे के अनुमति देय हवय,</para>
  <para style="q2" vid="LAM 2:17">ओह तोर बईरीमन के सींग ला ऊपर करे हवय।<verse eid="LAM 2:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 2:18"/>मनखेमन के हिरदय ह</para>
  <para style="q2" vid="LAM 2:18">परभू ला पुकारथे।</para>
  <para style="q1" vid="LAM 2:18">हे बेटी सियोन के दीवारमन</para>
  <para style="q2" vid="LAM 2:18">तुम्हर आंसू ह नदी सहीं</para>
  <para style="q2" vid="LAM 2:18">दिन अऊ रात बहय;</para>
  <para style="q1" vid="LAM 2:18">अपनआप ला अराम झन दे,</para>
  <para style="q2" vid="LAM 2:18">तोर आंखीमन ला अराम झन मिलय।<verse eid="LAM 2:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 2:19"/>उठ, रथिया के बेरा पुकार,</para>
  <para style="q2" vid="LAM 2:19">जब रथिया के पहरमन सुरू होथें;</para>
  <para style="q1" vid="LAM 2:19">परभू के आघू म अपन हिरदय ला</para>
  <para style="q2" vid="LAM 2:19">पानी सहीं ढार दे।</para>
  <para style="q1" vid="LAM 2:19">अपन ओ लइकामन के जिनगी खातिर</para>
  <para style="q2" vid="LAM 2:19">ओकर कोति अपन हांथ ला उठा,</para>
  <para style="q1" vid="LAM 2:19">जेमन गली के हर कोना म</para>
  <para style="q2" vid="LAM 2:19">भूख के मारे बेहोस होवथें।<verse eid="LAM 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 2:20"/>“हे यहोवा, देख अऊ बिचार कर:</para>
  <para style="q2" vid="LAM 2:20">तेंह काकर संग अइसने बरताव करे हस?</para>
  <para style="q1" vid="LAM 2:20">का माईलोगनमन अपन लइकामन ला खावंय,</para>
  <para style="q2" vid="LAM 2:20">ओ लइका जेमन के ओमन पालन-पोसन करे हवंय?</para>
  <para style="q1" vid="LAM 2:20">का पुरोहित अऊ अगमजानीमन</para>
  <para style="q2" vid="LAM 2:20">परभू के पबितर-स्थान म मारे जावंय?<verse eid="LAM 2:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 2:21"/>“गली के धुर्रा म</para>
  <para style="q2" vid="LAM 2:21">जवान अऊ डोकरा दूनों एक संग पड़े रहिथें;</para>
  <para style="q1" vid="LAM 2:21">मोर जवान छोकरा अऊ जवान छोकरीमन</para>
  <para style="q2" vid="LAM 2:21">तलवार से मारे गे हवंय।</para>
  <para style="q1" vid="LAM 2:21">तेंह अपन कोरोध के दिन म ओमन ला मार डारे हस;</para>
  <para style="q2" vid="LAM 2:21">तेंह बिगर दया के ओमन के बध करे हस।<verse eid="LAM 2:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 2:22"/>“जइसे तेंह भोज के दिन के नेवता देथस,</para>
  <para style="q2" vid="LAM 2:22">वइसे तेंह मोर बिरूध म आतंक ला हर तरफ ले बलाय हस।</para>
  <para style="q1" vid="LAM 2:22">यहोवा के कोरोध के दिन म</para>
  <para style="q2" vid="LAM 2:22">कोनो भाग नइं सकिन या जिंदा नइं बचिन;</para>
  <para style="q1" vid="LAM 2:22">जऊन मन के मेंह देखभाल करेंव अऊ पालन-पोसन करेंव,</para>
  <para style="q2" vid="LAM 2:22">मोर बईरी ह ओमन ला नास कर दे हवय।”<verse eid="LAM 2:22"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="LAM 2"/>
  <chapter number="3" style="c" sid="LAM 3"/>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 3:1"/>मेंह ओ मनखे अंव, जऊन ह यहोवा के कोप के</para>
  <para style="q2" vid="LAM 3:1">छड़ी के दुवारा पीरा ला देखे हवंव।<verse eid="LAM 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 3:2"/>ओह मोला भगा दे हवय</para>
  <para style="q2" vid="LAM 3:2">अऊ मोला अंजोर के बदले अंधियार म चलाय हवय;<verse eid="LAM 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 3:3"/>वास्तव म, ओह बार-बार, दिन भर</para>
  <para style="q2" vid="LAM 3:3">अपन हांथ ला मोर बिरूध उठाय हवय।<verse eid="LAM 3:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 3:4"/>ओह मोर चमड़ी अऊ मोर मांस ला झुर्रीदार कर दे हवय</para>
  <para style="q2" vid="LAM 3:4">अऊ मोर हाड़ामन ला टोर दे हवय।<verse eid="LAM 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 3:5"/>ओह करूवाहट अऊ कठिन समय के संग</para>
  <para style="q2" vid="LAM 3:5">मोर ऊपर टूट पड़े हे अऊ मोला घेर ले हवय।<verse eid="LAM 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 3:6"/>ओह बहुंत पहिले मरे मनखे सहीं</para>
  <para style="q2" vid="LAM 3:6">मोला अंधियार म रहे बर छोंड़ दे हवय।<verse eid="LAM 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 3:7"/>ओह मोला दीवार ले घेर दे हवय ताकि में भाग झन सकंव;</para>
  <para style="q2" vid="LAM 3:7">ओह मोला भारी बेड़ी ले बांध रखे हे।<verse eid="LAM 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 3:8"/>अऊ त अऊ जब मेंह मदद बर पुकारथंव या गोहारथंव,</para>
  <para style="q2" vid="LAM 3:8">त ओह मोर पराथना ला नइं सुनय।<verse eid="LAM 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 3:9"/>ओह गढ़े गय पथरामन ले मोर रसता ला रोक दे हवय;</para>
  <para style="q2" vid="LAM 3:9">ओह मोर रसतामन ला टेढ़ा-मेड़ा कर दे हवय।<verse eid="LAM 3:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 3:10"/>जइसे भालू ह सिकार के इंतजार म लेटे रहिथे,</para>
  <para style="q2" vid="LAM 3:10">जइसे सिंह ह सिकार के इंतजार म छुपे रहिथे,<verse eid="LAM 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 3:11"/>ओह मोला रसता ले घसीटके कुटा-कुटा कर दे हवय</para>
  <para style="q2" vid="LAM 3:11">अऊ मोला बिगर मदद के छोंड़ दे हवय।<verse eid="LAM 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 3:12"/>ओह अपन धनुस ला ताने हवय</para>
  <para style="q2" vid="LAM 3:12">अऊ मोला अपन तीर के निसाना बनाय हवय।<verse eid="LAM 3:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 3:13"/>अपन तरकस के तीरमन ले</para>
  <para style="q2" vid="LAM 3:13">ओह मोर हिरदय ला छेद दीस।<verse eid="LAM 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 3:14"/>मेंह अपन जम्मो मनखेमन बर हंसी के पात्र बन गे हंव;</para>
  <para style="q2" vid="LAM 3:14">ओमन गीत के दुवारा दिन भर मोर हंसी उड़ाथें।<verse eid="LAM 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 3:15"/>ओह मोला करू पान ले भर दे हवय</para>
  <para style="q2" vid="LAM 3:15">ओह मोला पीये बर पित्त दे हवय।<verse eid="LAM 3:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 3:16"/>ओह कंकड़ ले मोर दांतमन ला टोर दे हवय;</para>
  <para style="q2" vid="LAM 3:16">ओह धुर्रा म मोला कुचर दे हवय।<verse eid="LAM 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 3:17"/>मोर जिनगी ले सांति छीन लेय गे हवय;</para>
  <para style="q2" vid="LAM 3:17">मेंह भुला गे हंव कि उन्नति का ए।<verse eid="LAM 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 3:18"/>एकरसेति मेंह कहिथंव, “मोर सोभा ह</para>
  <para style="q2" vid="LAM 3:18">अऊ यहोवा ले मेंह जऊन आसा करत रहेंव, ओह चले गीस।”<verse eid="LAM 3:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 3:19"/>मेंह अपन पीरा अऊ एती-ओती भटके के बात,</para>
  <para style="q2" vid="LAM 3:19">करूवाहट अऊ पित्त ला सुरता करथंव।<verse eid="LAM 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 3:20"/>मेंह ओमन ला बने करके सुरता करथंव,</para>
  <para style="q2" vid="LAM 3:20">अऊ मोर मनोबल ह मोर भीतर म ही गिरत जात हे।<verse eid="LAM 3:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 3:21"/>तभो ले मेंह ये सुरता करथंव</para>
  <para style="q2" vid="LAM 3:21">अऊ एकरे कारन मोला आसा हवय:<verse eid="LAM 3:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 3:22"/>यहोवा के महान मया के कारन हमन खतम नइं होयेंन,</para>
  <para style="q2" vid="LAM 3:22">काबरकि ओकर दया हमेसा बने रहिथे।<verse eid="LAM 3:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="LAM 3:23"/>हर बिहनियां ओमन नवां होथें;</para>
  <para style="q2" vid="LAM 3:23">महान ए तोर बिसवासयोग्यता।<verse eid="LAM 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="LAM 3:24"/>मेंह अपनआप ले कहिथंव, “यहोवा ह मोर भाग ए;</para>
  <para style="q2" vid="LAM 3:24">एकरे कारन मेंह ओकर ऊपर आसा रखहूं।”<verse eid="LAM 3:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="LAM 3:25"/>यहोवा ह ओमन बर बने अय, जऊन मन ओकर ऊपर आसा रखथें,</para>
  <para style="q2" vid="LAM 3:25">जऊन मन ओकर खोज म रहिथें;<verse eid="LAM 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="LAM 3:26"/>यहोवा के उद्धार बर</para>
  <para style="q2" vid="LAM 3:26">चुपेचाप इंतजार करई ह बने बात ए।<verse eid="LAM 3:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="LAM 3:27"/>एक मनखे बर अपन जवानी के समय</para>
  <para style="q2" vid="LAM 3:27">जुड़ा उठाना बने बात ए।<verse eid="LAM 3:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="LAM 3:28"/>ओह चुपेचाप अकेला बईठे रहय,</para>
  <para style="q2" vid="LAM 3:28">काबरकि यहोवा ह ये जुड़ा ला ओकर ऊपर डाले हवय।<verse eid="LAM 3:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="LAM 3:29"/>ओह अपन चेहरा ला धुर्रा म तोपय—</para>
  <para style="q2" vid="LAM 3:29">येमा अभी भी आसा हो सकथे।<verse eid="LAM 3:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="LAM 3:30"/>ओह अपन गाल ला ओकर कोति करय, जऊन ह ओला तमाचा मारे चाहथे,</para>
  <para style="q2" vid="LAM 3:30">अऊ ओह बहुंत कलंकित होवय।<verse eid="LAM 3:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="LAM 3:31"/>काबरकि परभू ह कोनो ला</para>
  <para style="q2" vid="LAM 3:31">हमेसा बर नइं तियागे।<verse eid="LAM 3:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="LAM 3:32"/>हालाकि ओह दुख लानथे, पर ओह करूना करही,</para>
  <para style="q2" vid="LAM 3:32">अइसे महान ए, ओकर न टूटनेवाला मया।<verse eid="LAM 3:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="LAM 3:33"/>काबरकि ओह मन से काकरो ऊपर</para>
  <para style="q2" vid="LAM 3:33">दुख या पीरा नइं लानय।<verse eid="LAM 3:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="LAM 3:34"/>देस के जम्मो कैदीमन ला</para>
  <para style="q2" vid="LAM 3:34">गोड़ तरी कुचरई,<verse eid="LAM 3:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="LAM 3:35"/>सर्वोच्च परमेसर के आघू म</para>
  <para style="q2" vid="LAM 3:35">मनखेमन ला ओमन के अधिकार ले वंचित करई,<verse eid="LAM 3:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="LAM 3:36"/>अऊ ओमन ला नियाय ले वंचित करई—</para>
  <para style="q2" vid="LAM 3:36">अइसन चीजमन ला परभू ह नइं देख सकय?<verse eid="LAM 3:36"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="37" style="v" sid="LAM 3:37"/>यदि परभू ह हुकूम नइं दे हवय,</para>
  <para style="q2" vid="LAM 3:37">त कोन ए ओ, जऊन ह अपन कहे बात ला पूरा कर सकथे?<verse eid="LAM 3:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="LAM 3:38"/>बिपत्ति अऊ बने बात,</para>
  <para style="q2" vid="LAM 3:38">का ये दूनों सर्वोच्च परमेसर के हुकूम ले नइं आवंय?<verse eid="LAM 3:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="LAM 3:39"/>जीयत मनखे ला काबर सिकायत करना चाही</para>
  <para style="q2" vid="LAM 3:39">जब ओला ओकर पाप के सजा मिलथे?<verse eid="LAM 3:39"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="40" style="v" sid="LAM 3:40"/>आवव, हमन अपन चालचलन ला जांचन अऊ परखन,</para>
  <para style="q2" vid="LAM 3:40">अऊ आवव, हमन यहोवा करा लहुंट आवन।<verse eid="LAM 3:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="LAM 3:41"/>आवव, हमन अपन हिरदय अऊ अपन हांथमन ला</para>
  <para style="q2" vid="LAM 3:41">स्वरग के परमेसर कोति उठावन अऊ ये कहन:<verse eid="LAM 3:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="LAM 3:42"/>“हमन पाप अऊ बिदरोह करे हन</para>
  <para style="q2" vid="LAM 3:42">अऊ तेंह हमन ला छेमा नइं करे हस।<verse eid="LAM 3:42"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="43" style="v" sid="LAM 3:43"/>“तेंह कोरोध ले भरके हमर पीछा करय;</para>
  <para style="q2" vid="LAM 3:43">तेंह बिगर दया के मनखेमन ला जान से मारे हस।<verse eid="LAM 3:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="LAM 3:44"/>तेंह अपनआप ला बादर ले ढांप ले हस</para>
  <para style="q2" vid="LAM 3:44">ताकि कोनो पराथना तोर करा झन हबरे।<verse eid="LAM 3:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="LAM 3:45"/>तेंह हमन ला जाति-जाति के मनखेमन के बीच म</para>
  <para style="q2" vid="LAM 3:45">मईला अऊ अनाथ बना दे हस।<verse eid="LAM 3:45"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="46" style="v" sid="LAM 3:46"/>“हमर जम्मो बईरीमन हमर बिरूध म</para>
  <para style="q2" vid="LAM 3:46">बहुंत कुछू कहत हें।<verse eid="LAM 3:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="LAM 3:47"/>हमन आतंक अऊ संकट,</para>
  <para style="q2" vid="LAM 3:47">बिनास अऊ बरबादी झेलत हन।”<verse eid="LAM 3:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="LAM 3:48"/>मोर आंखीमन ले आंसू के धार बहत हे</para>
  <para style="q2" vid="LAM 3:48">काबरकि मोर मनखेमन नास होवत हें।<verse eid="LAM 3:48"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="49" style="v" sid="LAM 3:49"/>मोर आंखीमन ले आंसू ह</para>
  <para style="q2" vid="LAM 3:49">बिगर कोनो अराम के लगातार बहते रहिही,<verse eid="LAM 3:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="LAM 3:50"/>जब तक कि स्वरग ले यहोवा ह</para>
  <para style="q2" vid="LAM 3:50">खाल्हे नइं देखही।<verse eid="LAM 3:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="LAM 3:51"/>मोर सहर के जम्मो माईलोगनमन के कारन</para>
  <para style="q2" vid="LAM 3:51">जऊन कुछू मेंह देखथंव, ओकर से मोर मन ला दुख लगथे।<verse eid="LAM 3:51"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="52" style="v" sid="LAM 3:52"/>जऊन मन बिगर कारन के मोर बईरी हो गे रिहिन</para>
  <para style="q2" vid="LAM 3:52">ओमन चिरई सहीं मोर सिकार करिन।<verse eid="LAM 3:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="LAM 3:53"/>ओमन मोला खंचवा म डारके मोर परान लेय के कोसिस करिन</para>
  <para style="q2" vid="LAM 3:53">अऊ मोर ऊपर पथरा फेंकिन;<verse eid="LAM 3:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="LAM 3:54"/>पानी ह मोर मुड़ ऊपर तक आ गीस,</para>
  <para style="q2" vid="LAM 3:54">अऊ मेंह सोचेंव कि में नास होनेचवाला हंव।<verse eid="LAM 3:54"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="55" style="v" sid="LAM 3:55"/>हे यहोवा, गहिला खंचवा ले,</para>
  <para style="q2" vid="LAM 3:55">मेंह तोर नांव ला पुकारेंव।<verse eid="LAM 3:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="LAM 3:56"/>तेंह मोर बिनती ला सुने: “मदद बर मोर पुकार के सेति</para>
  <para style="q2" vid="LAM 3:56">अपन कान ला बंद झन कर।”<verse eid="LAM 3:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="LAM 3:57"/>जब मेंह तोला बलांय, त तेंह मोर लकठा म आय,</para>
  <para style="q2" vid="LAM 3:57">अऊ तेंह कहे, “झन डर।”<verse eid="LAM 3:57"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="58" style="v" sid="LAM 3:58"/>हे परभू, तेंह मोर मामला ला अपन हांथ म लेय;</para>
  <para style="q2" vid="LAM 3:58">अऊ तेंह मोर जिनगी ला बचाय।<verse eid="LAM 3:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="LAM 3:59"/>हे यहोवा, जऊन अनियाय मोर ऊपर करे गीस, ओला तेंह देखे हस।</para>
  <para style="q2" vid="LAM 3:59">मोर मामला ला संभाल!<verse eid="LAM 3:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="LAM 3:60"/>ओमन जऊन बदला लीन अऊ मोर बिरूध करे गे</para>
  <para style="q2" vid="LAM 3:60">ओमन के जम्मो सडयंत्र ला तेंह देखे हस।<verse eid="LAM 3:60"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="61" style="v" sid="LAM 3:61"/>हे यहोवा, ओमन के दुवारा करे गे बेजत्ती</para>
  <para style="q2" vid="LAM 3:61">अऊ मोर बिरूध करे गे जम्मो सडयंत्र के बारे तेंह सुने हस—<verse eid="LAM 3:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="LAM 3:62"/>मोर बईरीमन मोर बिरूध म दिन भर,</para>
  <para style="q2" vid="LAM 3:62">का कानाफूसी करथें अऊ बड़बड़ाथें।<verse eid="LAM 3:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="LAM 3:63"/>ओमन ला देख! उठत या बईठत,</para>
  <para style="q2" vid="LAM 3:63">ओमन अपन गीत म मोर हंसी उड़ाथें।<verse eid="LAM 3:63"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="64" style="v" sid="LAM 3:64"/>हे यहोवा, ओमन के काम के मुताबिक,</para>
  <para style="q2" vid="LAM 3:64">जऊन दुस्ट काम ओमन अपन हांथ ले करे हवंय, ओकर बदला ले।<verse eid="LAM 3:64"/></para>
  <para style="q1">
    <verse number="65" style="v" sid="LAM 3:65"/>ओमन के हिरदय ऊपर एक परदा डाल दे,</para>
  <para style="q2" vid="LAM 3:65">अऊ तोर सराप ओमन ला लगे!<verse eid="LAM 3:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="LAM 3:66"/>हे यहोवा, अकास के खाल्हे ले</para>
  <para style="q2" vid="LAM 3:66">कोरोध म ओमन के पीछा कर अऊ ओमन ला नास कर दे।<verse eid="LAM 3:66"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="LAM 3"/>
  <chapter number="4" style="c" sid="LAM 4"/>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 4:1"/>सोन ह कइसे अपन चमक गंवा दे हवय,</para>
  <para style="q2" vid="LAM 4:1">सुध सोन ह खोटा हो गीस!</para>
  <para style="q1" vid="LAM 4:1">हर एक गली के कोना म</para>
  <para style="q2" vid="LAM 4:1">पबितर रत्न बगरे परे हवंय।<verse eid="LAM 4:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 4:2"/>सियोन के कीमती लइकामन,</para>
  <para style="q2" vid="LAM 4:2">एक समय ओमन के कीमत सोन सहीं रिहिन,</para>
  <para style="q1" vid="LAM 4:2">पर अब माटी के बरतन सहीं समझे जावत हें,</para>
  <para style="q2" vid="LAM 4:2">कुम्हार के हांथ के बनाय चीज सहीं!<verse eid="LAM 4:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 4:3"/>अऊ त अऊ सियार ह</para>
  <para style="q2" vid="LAM 4:3">अपन लइकामन ला अपन दूध पीयाथे,</para>
  <para style="q1" vid="LAM 4:3">पर मोर मनखेमन मरू-भुइयां के</para>
  <para style="q2" vid="LAM 4:3">सुतुरमुर्ग सहीं निरदयी हो गे हवंय।<verse eid="LAM 4:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 4:4"/>पीयास के मारे दूध पीनेवाला लइका के जीभ ह</para>
  <para style="q2" vid="LAM 4:4">ओकर तालू म चपक जाथे;</para>
  <para style="q1" vid="LAM 4:4">लइकामन रोटी मांगथें,</para>
  <para style="q2" vid="LAM 4:4">पर ओमन ला कोनो रोटी नइं दें।<verse eid="LAM 4:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 4:5"/>ओ मनखे जऊन मन एक समय सुवादवाला भोजन करत रिहिन</para>
  <para style="q2" vid="LAM 4:5">ओमन अब गली म अनाथ हो गे हवंय।</para>
  <para style="q1" vid="LAM 4:5">ओ मनखे जऊन मन राजकीय कपड़ा पहिरे पलिन-बढ़िन</para>
  <para style="q2" vid="LAM 4:5">ओमन अब राख के कुढ़ा म परे हवंय।<verse eid="LAM 4:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 4:6"/>मोर मनखेमन के दंड ह</para>
  <para style="q2" vid="LAM 4:6">सदोम ले कहीं बढ़के हवय,</para>
  <para style="q1" vid="LAM 4:6">कोनो मदद के हांथ भी नइं उठिस</para>
  <para style="q2" vid="LAM 4:6">अऊ देखते-देखत ओकर सर्वनास हो गीस।<verse eid="LAM 4:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 4:7"/>ओमन के राजकुमारमन बरफ ले जादा चमकवाले</para>
  <para style="q2" vid="LAM 4:7">अऊ दूध ले जादा सफेद रिहिन,</para>
  <para style="q1" vid="LAM 4:7">ओमन के देहें ह गुलाबी रत्न ले भी जादा चमकीला,</para>
  <para style="q2" vid="LAM 4:7">अऊ ओमन के रूप ह नीलमनि सहीं रिहिस।<verse eid="LAM 4:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 4:8"/>पर अब ओमन कालिख ले घलो जादा करिया हो गे हवंय;</para>
  <para style="q2" vid="LAM 4:8">गली म ओमन ला कोनो नइं चिनहें।</para>
  <para style="q1" vid="LAM 4:8">ओमन के चमड़ी ह हाड़ामन म चिपक गे हवय,</para>
  <para style="q2" vid="LAM 4:8">येह छड़ी सहीं सूख गे हवय।<verse eid="LAM 4:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 4:9"/>जऊन मन तलवार ले मारे गीन, ओमन बेहतर अंय</para>
  <para style="q2" vid="LAM 4:9">येकर बनिस्पत कि जऊन मन अकाल ले मरथें;</para>
  <para style="q1" vid="LAM 4:9">खेत म अन्न के कमी के कारन</para>
  <para style="q2" vid="LAM 4:9">भूख ले मरथें अऊ बेकार होथें।<verse eid="LAM 4:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 4:10"/>करूना ले भरपूर दाईमन अपन खुद के हांथ ले</para>
  <para style="q2" vid="LAM 4:10">अपन खुद के लइकामन ला रांधे हवंय,</para>
  <para style="q1" vid="LAM 4:10">अऊ येह ओमन के जेवन होय हे</para>
  <para style="q2" vid="LAM 4:10">जब मोर मनखेमन ला नास करे गीस।<verse eid="LAM 4:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 4:11"/>यहोवा ह अपन कोप ला पूरा भड़काय हवय;</para>
  <para style="q2" vid="LAM 4:11">ओह अपन भयंकर कोरोध परगट करे हवय।</para>
  <para style="q1" vid="LAM 4:11">ओह सियोन म एक आगी लगाय हवय</para>
  <para style="q2" vid="LAM 4:11">जऊन ह ओकर नीव ला जलाके भसम कर दीस।<verse eid="LAM 4:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 4:12"/>धरती के राजामन बिसवास नइं करिन</para>
  <para style="q2" vid="LAM 4:12">न ही संसार के कोनो मनखे बिसवास करिन</para>
  <para style="q1" vid="LAM 4:12">कि बईरी अऊ बिरोधीमन यरूसलेम के</para>
  <para style="q2" vid="LAM 4:12">दुवारमन के भीतर जा सकहीं।<verse eid="LAM 4:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 4:13"/>पर ओकर अगमजानीमन के पाप</para>
  <para style="q2" vid="LAM 4:13">अऊ पुरोहितमन के अपराधमन के कारन अइसने होईस,</para>
  <para style="q1" vid="LAM 4:13">जऊन मन ओकर भीतर</para>
  <para style="q2" vid="LAM 4:13">धरमी के खून बहाईन।<verse eid="LAM 4:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 4:14"/>अब ओमन गलीमन म टटोलत हवंय</para>
  <para style="q2" vid="LAM 4:14">मानो ओमन अंधरा हो गे हवंय।</para>
  <para style="q1" vid="LAM 4:14">ओमन खून ले अइसने असुध हो गे हवंय</para>
  <para style="q2" vid="LAM 4:14">कि कोनो ओमन के कपड़ा ला छुए के हिम्मत नइं करंय।<verse eid="LAM 4:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 4:15"/>मनखेमन ओमन ले चिचियाके कहिथें, “दूर हटव, तुमन असुध हव।</para>
  <para style="q2" vid="LAM 4:15">दूरिहा रहव! दूरिहा! हमन ला झन छुवव!”</para>
  <para style="q1" vid="LAM 4:15">जब ओमन भागथें अऊ भटकथें,</para>
  <para style="q2" vid="LAM 4:15">त जाति-जाति के मनखेमन कहिथें,</para>
  <para style="q2" vid="LAM 4:15">“ओमन अब इहां नइं रह सकंय।”<verse eid="LAM 4:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 4:16"/>यहोवा ह खुद ओमन ला तितिर-बितिर कर दे हवय;</para>
  <para style="q2" vid="LAM 4:16">ओह अब ओमन के धियान नइं देवय।</para>
  <para style="q1" vid="LAM 4:16">पुरोहितमन ला आदर नइं दिये जावय,</para>
  <para style="q2" vid="LAM 4:16">अऊ अगुवामन ऊपर किरपा नइं करे जावय।<verse eid="LAM 4:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 4:17"/>अऊ ये घलो कि हमर आंखीमन</para>
  <para style="q2" vid="LAM 4:17">मदद बर बेकार के रसता देखत कमजोर हो गे हवंय;</para>
  <para style="q1" vid="LAM 4:17">हमन अपन किलामन ले एक जाति कोति देखत रहेंन</para>
  <para style="q2" vid="LAM 4:17">जऊन ह हमर बचाव नइं कर सकिस।<verse eid="LAM 4:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 4:18"/>मनखेमन हर कदम म हमर पीछा करिन,</para>
  <para style="q2" vid="LAM 4:18">जेकर से हमर गलीमन म हमन चल नइं सकेंन।</para>
  <para style="q1" vid="LAM 4:18">हमर आखिरी समय लकठा म रिहिस, हमर दिनमन गनती के रिहिन,</para>
  <para style="q2" vid="LAM 4:18">काबरकि हमर अन्त आ गे रिहिस।<verse eid="LAM 4:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 4:19"/>हमर पीछा करइयामन अकास के</para>
  <para style="q2" vid="LAM 4:19">गिधवामन ले घलो तेज रिहिन;</para>
  <para style="q1" vid="LAM 4:19">ओमन पहाड़ ऊपर हमर पीछा करिन</para>
  <para style="q2" vid="LAM 4:19">अऊ निरजन जगह म हमर घात म रिहिन।<verse eid="LAM 4:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 4:20"/>यहोवा के अभिसिक्त, हमर खुद के जिनगी के सांस ह</para>
  <para style="q2" vid="LAM 4:20">ओमन के फांदा म फंस गीस।</para>
  <para style="q1" vid="LAM 4:20">हमन सोचेंन कि ओकर छइहां म</para>
  <para style="q2" vid="LAM 4:20">हमन जाति-जाति के मनखेमन के बीच रहिबो।<verse eid="LAM 4:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 4:21"/>हे बेटी एदोम,<note caller="+" style="f"><char style="fr" closed="false">4:21 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">एदोम के मनखेमन</char></note> तें जो ऊज देस म रहिथस,</para>
  <para style="q2" vid="LAM 4:21">आनंद मना अऊ खुसी रह।</para>
  <para style="q1" vid="LAM 4:21">पर ओ कटोरा ह तोर मेर घलो हबरही;</para>
  <para style="q2" vid="LAM 4:21">तेंह मंद पीके नंगरी हो जाबे।<verse eid="LAM 4:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 4:22"/>हे बेटी सियोन, तोर सजा ह खतम हो जाही;</para>
  <para style="q2" vid="LAM 4:22">ओह तोर बंधुवई के समय ला अऊ नइं बढ़ावय।</para>
  <para style="q1" vid="LAM 4:22">पर हे बेटी एदोम, ओह तोर पाप के दंड दीही,</para>
  <para style="q2" vid="LAM 4:22">अऊ तोर दुस्टता ला परगट कर दीही।<verse eid="LAM 4:22"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="LAM 4"/>
  <chapter number="5" style="c" sid="LAM 5"/>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 5:1"/>हे यहोवा, हमर ऊपर जऊन बीते हवय, ओला सुरता कर;</para>
  <para style="q2" vid="LAM 5:1">हमर ऊपर धियान दे, अऊ हमर बेजत्ती ला देख।<verse eid="LAM 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 5:2"/>हमर उत्तराधिकार ह अजनबीमन ला,</para>
  <para style="q2" vid="LAM 5:2">अऊ हमर घर परदेसीमन ला दे दिये गे हवय।<verse eid="LAM 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 5:3"/>हमन बिगर ददा के हो गे हवन,</para>
  <para style="q2" vid="LAM 5:3">हमर दाईमन बिधवा हो गे हवंय।<verse eid="LAM 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 5:4"/>पीये के पानी बिसोना जरूरी हो गे हवय;</para>
  <para style="q2" vid="LAM 5:4">हमन ला लकरी तभे मिलथे, जब हमन ओकर दाम देथन।<verse eid="LAM 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 5:5"/>जऊन मन हमर पीछा करत हें, ओमन हमर गोड़ मेर आ गे हवंय;</para>
  <para style="q2" vid="LAM 5:5">हमन थक गे हन अऊ हमन ला अराम नइं मिलत हे।<verse eid="LAM 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 5:6"/>हमन भरपूर जेवन पाय बर</para>
  <para style="q2" vid="LAM 5:6">मिसर अऊ अस्सूर के अधीन हो गेंन।<verse eid="LAM 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 5:7"/>हमर पुरखामन पाप करिन अऊ ओमन खतम हो गीन,</para>
  <para style="q2" vid="LAM 5:7">अऊ हमन ओमन के दंड भोगत हन।<verse eid="LAM 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 5:8"/>गुलाममन हमर ऊपर सासन करत हें,</para>
  <para style="q2" vid="LAM 5:8">अऊ हमन ला ओमन के हांथ ले छोंड़ाय बर कोनो नइं एं।<verse eid="LAM 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 5:9"/>निरजन जगह म तलवार के कारन</para>
  <para style="q2" vid="LAM 5:9">जब हमन अपन जान ला जोखिम म डालथन, त हमन ला जेवन मिलथे।<verse eid="LAM 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 5:10"/>हमर चमड़ी ह भट्ठी सहीं गरम हो गे हवय,</para>
  <para style="q2" vid="LAM 5:10">भूख के मारे जर आवत हे।<verse eid="LAM 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 5:11"/>सियोन म माईलोगनमन अऊ यहूदा के नगरमन म</para>
  <para style="q2" vid="LAM 5:11">कुंवारीमन ला भ्रस्ट कर देय गे हवय।<verse eid="LAM 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 5:12"/>हाकिममन ला हांथ के बल लटका देय गे हवय;</para>
  <para style="q2" vid="LAM 5:12">अगुवामन के आदर नइं करे जावय।<verse eid="LAM 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 5:13"/>जवानमन चक्की चलाय म मेहनत करथें;</para>
  <para style="q2" vid="LAM 5:13">लड़कामन लकरी के बोझा उठात लड़खड़ाथें।<verse eid="LAM 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 5:14"/>अगुवामन सहर के दुवार ला छोंड़के चले गे हवंय;</para>
  <para style="q2" vid="LAM 5:14">जवानमन अपन संगीत ला छोंड़ दे हवंय।<verse eid="LAM 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 5:15"/>आनंद ह हमर हिरदय ले चले गे हवय;</para>
  <para style="q2" vid="LAM 5:15">हमर नचई ह सोक म बदल गे हवय।<verse eid="LAM 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 5:16"/>मुकुट ह हमर मुड़ ले गिर गे हवय।</para>
  <para style="q2" vid="LAM 5:16">हमन ला धिक्कार ए, काबरकि हमन पाप करे हन!<verse eid="LAM 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 5:17"/>येकर कारन हमर हिरदय ह कमजोर हो गे हवय,</para>
  <para style="q2" vid="LAM 5:17">ये बातमन के कारन हमर नजर ह कमजोर हो गे हवय<verse eid="LAM 5:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 5:18"/>काबरकि सियोन पहाड़ उजाड़ पड़े हे,</para>
  <para style="q2" vid="LAM 5:18">अऊ सियारमन येकर ऊपर घुमत हें।<verse eid="LAM 5:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 5:19"/>हे यहोवा, तेंह सदाकाल तक राज करथस;</para>
  <para style="q2" vid="LAM 5:19">तोर सिंघासन ह पीढ़ी-पीढ़ी तक बने रहिथे।<verse eid="LAM 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 5:20"/>तेंह काबर हमन ला हमेसा भुला जाथस?</para>
  <para style="q2" vid="LAM 5:20">तेंह काबर हमन ला अतेक लम्बा समय तक छोंड़ देथस?<verse eid="LAM 5:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 5:21"/>हे यहोवा, तोर संग हमर संबंध ला फेर ठीक कर दे, कि हमन लहुंटके आवन;</para>
  <para style="q2" vid="LAM 5:21">हमर दिनमन ला फेर पुराना समय सहीं कर दे<verse eid="LAM 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 5:22"/>यदि तेंह हमन ला पूरा तियाग नइं दे हस</para>
  <para style="q2" vid="LAM 5:22">अऊ हमर ऊपर बहुंत नराज नइं अस त।<verse eid="LAM 5:22"/></para>
  <chapter eid="LAM 5"/>
</usx>
