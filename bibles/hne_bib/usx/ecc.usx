<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ECC" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  <para style="h">सभोपदेसक</para>
  <para style="toc1">सभोपदेसक के किताब</para>
  <para style="toc2">सभोपदेसक</para>
  <para style="toc3">सभो</para>
  <para style="mt1">सभोपदेसक</para>
  <para style="mt2">के किताब</para>
  <chapter number="1" style="c" sid="ECC 1"/>
  <para style="s1">हर चीज ह बेकार ए</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 1:1"/>दाऊद के बेटा, यरूसलेम म राजा, गुरू<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सभा के अगुवा </char><char style="ft" closed="false"><char style="xt" link-href="ECC 1:2"><ref loc="ECC 1:2">पद 2</ref></char> अऊ <char style="xt" link-href="ECC 1:12"><ref loc="ECC 1:12">12</ref></char> म घलो</char></note> के बचन:<verse eid="ECC 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 1:2"/>“बेकार! बेकार!”</para>
  <para style="q2" vid="ECC 1:2">गुरू ह कहिथे।</para>
  <para style="q1" vid="ECC 1:2">“एकदम बेकार!</para>
  <para style="q2" vid="ECC 1:2">हर चीज ह बेकार अय।”<verse eid="ECC 1:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 1:3"/>धरती ऊपर<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">सूरज के खाल्हे</char></note> मनखे के दुवारा</para>
  <para style="q2" vid="ECC 1:3">करे गे ओकर जम्मो मेहनत के का मिलथे?<verse eid="ECC 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 1:4"/>पीढ़ी-पीढ़ी ले मनखेमन आथें अऊ ओमन चले जाथें,</para>
  <para style="q2" vid="ECC 1:4">पर धरती ह सदाकाल बर बने रहिथे।<verse eid="ECC 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 1:5"/>सूरज निकलथे अऊ सूरज बुड़थे,</para>
  <para style="q2" vid="ECC 1:5">अऊ बिगर देरी करे येह फेर अपन निकले के जगह म वापिस चले जाथे।<verse eid="ECC 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 1:6"/>हवा ह दक्खिन कोति बहथे</para>
  <para style="q2" vid="ECC 1:6">अऊ येह उत्तर कोति मुड़थे;</para>
  <para style="q1" vid="ECC 1:6">गोल-गोल येह घुमथे,</para>
  <para style="q2" vid="ECC 1:6">अऊ येह अपन घेरा म लहुंट आथे।<verse eid="ECC 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 1:7"/>हालाकि जम्मो नदीमन बहके समुंदर म मिल जाथें,</para>
  <para style="q2" vid="ECC 1:7">तभो ले समुंदर ह कभू पूरा नइं भरय।</para>
  <para style="q1" vid="ECC 1:7">जऊन जगह ले नदीमन निकलके आथें,</para>
  <para style="q2" vid="ECC 1:7">ओ जगह ला ओमन फेर लहुंट जाथें।<verse eid="ECC 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 1:8"/>जम्मो चीजमन थका देनेवाला अंय,</para>
  <para style="q2" vid="ECC 1:8">कोनो मनखे येकर बखान नइं कर सकय।</para>
  <para style="q1" vid="ECC 1:8">आंखी ह देखके कभू संतोस नइं होवय,</para>
  <para style="q2" vid="ECC 1:8">अऊ न ही कान ह सुनके संतोस होवय।<verse eid="ECC 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 1:9"/>जऊन ह हो चुके हे ओहीच ह फेर होही,</para>
  <para style="q2" vid="ECC 1:9">जेला करे जा चुके हवय, ओला फेर करे जाही;</para>
  <para style="q2" vid="ECC 1:9">धरती म कुछू घलो नवां नइं ए।<verse eid="ECC 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 1:10"/>का अइसन कुछू हवय, जेकर बारे म कोनो ये कह सकय,</para>
  <para style="q2" vid="ECC 1:10">“देखव! येह कुछू नवां ए?”</para>
  <para style="q1" vid="ECC 1:10">येह इहां पहिले ले रिहिस, बहुंत पहिले ले;</para>
  <para style="q2" vid="ECC 1:10">येह इहां हमर समय के पहिले ले रिहिस।<verse eid="ECC 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 1:11"/>पहिले के पीढ़ीमन ला कोनो सुरता नइं करय,</para>
  <para style="q2" vid="ECC 1:11">अऊ त अऊ अवइया पीढ़ीमन ला</para>
  <para style="q1" vid="ECC 1:11">घलो ओमन के दुवारा सुरता नइं करे जाही</para>
  <para style="q2" vid="ECC 1:11">जऊन मन ओमन के पाछू आहीं।<verse eid="ECC 1:11"/></para>
  <para style="s1">बुद्धि ह बेकार ए</para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 1:12"/>में, गुरू ह यरूसलेम म इसरायल के राजा रहेंव। <verse eid="ECC 1:12"/><verse number="13" style="v" sid="ECC 1:13"/>धरती म जऊन जम्मो काम करे जाथे, मेंह बुद्धि के दुवारा ओ जम्मो काममन ला जांचंय अऊ परखे बर अपन मन लगांय। येह एक भारी बोझ के काम ए, जेला परमेसर ह मानव-जाति ऊपर डार दे हवय! <verse eid="ECC 1:13"/><verse number="14" style="v" sid="ECC 1:14"/>मेंह ओ काम ला देखे हवंव, जेमन ला ये धरती म करे जाथे; ये जम्मो के जम्मो बेकार अंय अऊ हवा के पाछू भगई सहीं अय।<verse eid="ECC 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 1:15"/>जऊन ह टेड़गा हे, ओला सीधा नइं करे जा सकय;</para>
  <para style="q2" vid="ECC 1:15">जऊन ह हवय ही नइं, ओकर गनती नइं करे जा सकय।<verse eid="ECC 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 1:16"/>मेंह अपनआप ले कहेंव, “देख, मोर पहिली यरूसलेम म जतेक भी राजा होईन, ओ जम्मो झन ले मेंह जादा बुद्धिमान अंव; मेंह जादा बुद्धि अऊ गियान के अनुभव करे हवंव।” <verse eid="ECC 1:16"/><verse number="17" style="v" sid="ECC 1:17"/>तब मेंह अपनआप ला बुद्धि के समझ, अऊ पागलपन अऊ मुरूखता ला जाने बर लगांय, पर मेंह समझ गेंव कि येह घलो हवा के पाछू भागे सहीं अय।<verse eid="ECC 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 1:18"/>काबरकि जादा बुद्धि के संग जादा दुख आथे;</para>
  <para style="q2" vid="ECC 1:18">जादा गियान बढ़े ले, दुख घलो जादा बढ़थे।<verse eid="ECC 1:18"/></para>
  <chapter eid="ECC 1"/>
  <chapter number="2" style="c" sid="ECC 2"/>
  <para style="s1">सुख-बिलास ह बेकार ए</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 2:1"/>मेंह अपनआप ला कहेंव, “अब आ, मेंह तोला सुख-सुबिधा के दुवारा परखहूं अऊ येकर दुवारा ये पता लगाहूं कि का ह बने अय।” पर ये भी बेकार साबित होईस। <verse eid="ECC 2:1"/><verse number="2" style="v" sid="ECC 2:2"/>मेंह कहेंव, “हंसई ह पागलपन ए। अऊ सुख-सुबिधा ले का मिलथे?” <verse eid="ECC 2:2"/><verse number="3" style="v" sid="ECC 2:3"/>मेंह अंगूर के मंद पीके अऊ मुरूखता ला अपनाके खुस रहे के कोसिस करेंव—मोर मन ह अभी घलो बुद्धि के अगुवई म रहय। मेंह देखे चाहत रहेंव कि धरती म मनखे बर ओकर जिनगी के थोरकन दिन म का ह बने अय।<verse eid="ECC 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 2:4"/>मेंह बड़े-बड़े काम करेंव: मेंह अपन बर घरमन ला बनांय अऊ अंगूर के बारी लगांय। <verse eid="ECC 2:4"/><verse number="5" style="v" sid="ECC 2:5"/>मेंह बारी-बगीचा अऊ सार्वजनिक उदयान लगांय अऊ ओमन म जम्मो किसम के फलदार रूखमन ला लगांय <verse eid="ECC 2:5"/><verse number="6" style="v" sid="ECC 2:6"/>मेंह ओ रूखमन म पानी पलोय बर बड़े-बड़े तरिया बनांय। <verse eid="ECC 2:6"/><verse number="7" style="v" sid="ECC 2:7"/>मेंह पुरूस अऊ महिला गुलाममन ला बिसांय अऊ मोर करा आने गुलाममन घलो रिहिन, जऊन मन मोर घर म जनमे रिहिन। यरूसलेम म मोर ले पहिले रहइयामन ले मोर करा जादा गाय-बईला अऊ भेड़-बकरी के झुंड रिहिस। <verse eid="ECC 2:7"/><verse number="8" style="v" sid="ECC 2:8"/>मेंह अपन बर सोन, चांदी अऊ राजा अऊ राजमन ले धन इकट्ठा करेंव। मेंह गायक-गायिका अऊ संग म रखैल घलो रखेंव—जेकर ले मनखे ला खुसी मिलथे। <verse eid="ECC 2:8"/><verse number="9" style="v" sid="ECC 2:9"/>मोर ले पहिले यरूसलेम म जऊन मन रिहिन, ओ सबले मेंह बहुंत महान हो गेंव। ये जम्मो बात म, मोर बुद्धि ह मोर संग रिहिस।<verse eid="ECC 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 2:10"/>मोर आंखीमन जऊन चीज के ईछा करिन, ओ चीज ला मेंह लानेंव;</para>
  <para style="q2" vid="ECC 2:10">सुख-सुबिधा ले मेंह अपन मन ला दूरिहा नइं रखेंव।</para>
  <para style="q1" vid="ECC 2:10">मोर जम्मो काम म मोर मन ह खुस होईस,</para>
  <para style="q2" vid="ECC 2:10">अऊ येह मोर मेहनत के ईनाम रिहिस।<verse eid="ECC 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 2:11"/>तभो ले जब मेंह अपन हांथ ले करे जम्मो काम</para>
  <para style="q2" vid="ECC 2:11">अऊ मेहनत ले पाय चीजमन के जांच-पड़ताल करेंव,</para>
  <para style="q1" vid="ECC 2:11">त हर चीज ह बेकार लगिस अऊ हवा के पाछू भागे सहीं लगिस,</para>
  <para style="q2" vid="ECC 2:11">धरती म येकर कोनो फायदा नइं।<verse eid="ECC 2:11"/></para>
  <para style="s1">बुद्धि अऊ मुरूखता बेकार अंय</para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 2:12"/>तब मेंह अपन सोच-बिचार ला बुद्धि,</para>
  <para style="q2" vid="ECC 2:12">अऊ पागलपन अऊ मुरूखता के तरफ लगांय।</para>
  <para style="q1" vid="ECC 2:12">राजा के उत्तराधिकारी ह ओकर ले जादा का कर सकथे</para>
  <para style="q2" vid="ECC 2:12">जो पहिले ले करे जा चुके हवय?<verse eid="ECC 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 2:13"/>मेंह देखेंव कि बुद्धि ह मुरूखता ले बने अय,</para>
  <para style="q2" vid="ECC 2:13">जइसे कि अंजोर ह अंधियार ले बने होथे।<verse eid="ECC 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 2:14"/>बुद्धिमान के आंखी ह ओकर मुड़ म होथे,</para>
  <para style="q2" vid="ECC 2:14">जबकि मुरूख ह अंधियार म चलथे;</para>
  <para style="q1" vid="ECC 2:14">पर मेंह ये बात ला समझ गेंव</para>
  <para style="q2" vid="ECC 2:14">कि आखिरी म दूनों के हालत एक समान होथे।<verse eid="ECC 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 2:15"/>तब मेंह अपनआप ले कहेंव,</para>
  <para style="q1" vid="ECC 2:15">“आखिर म मुरूख के हालत सहीं मोर हालत घलो होही।</para>
  <para style="q2" vid="ECC 2:15">तब बुद्धिमान बनके मोला का फायदा होथे?”</para>
  <para style="q1" vid="ECC 2:15">मेंह अपनआप ले कहेंव,</para>
  <para style="q2" vid="ECC 2:15">“येह घलो बेकार ए।”<verse eid="ECC 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 2:16"/>काबरकि मुरूख के सहीं बुद्धिमान ला जादा समय तक सुरता नइं करे जाही;</para>
  <para style="q2" vid="ECC 2:16">समय ह पहिले ही आ चुके हवय जब दूनों भुला देय गे हवंय।</para>
  <para style="q1" vid="ECC 2:16">मुरूख के सहीं, बुद्धिमान घलो जरूर मरथे!<verse eid="ECC 2:16"/></para>
  <para style="s1">मेहनत ह बेकार अय</para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 2:17"/>एकरसेति मोला जिनगी ले घिन हो गीस, काबरकि धरती म जऊन काम करे गीस, ओह मोर बर दुखदाई रिहिस। ये जम्मो ह बेकार ए, हवा के पाछू भागे सहीं अय। <verse eid="ECC 2:17"/><verse number="18" style="v" sid="ECC 2:18"/>मोला ओ जम्मो चीज ले नफरत हो गीस, जेकर बर मेंह धरती म मेहनत करे रहेंव, काबरकि मोला येमन ला ओकर बर छोंड़ना पड़ही, जऊन ह मोर बाद आही। <verse eid="ECC 2:18"/><verse number="19" style="v" sid="ECC 2:19"/>अऊ कोन जानथे कि ओ मनखे ह बुद्धिमान होही कि मुरूख? तभो ले मोर मेहनत के ओ जम्मो कमई ह ओकर अधिकार म हो जाही, जेकर बर मेंह धरती म पूरा मेहनत अऊ कुसलता देखाय रहेंव। येह घलो बेकार ए। <verse eid="ECC 2:19"/><verse number="20" style="v" sid="ECC 2:20"/>एकरसेति धरती म करे गय मोर जम्मो कठोर मेहनत ऊपर मोर मन ह निरास होय लगिस। <verse eid="ECC 2:20"/><verse number="21" style="v" sid="ECC 2:21"/>काबरकि एक मनखे ह बुद्धि, गियान अऊ कुसलता के संग मेहनत करथे, अऊ तब ओह अपन ओ जम्मो चीज ला ओ मनखे बर छोंड़ देथे, जऊन ह येकर बर मेहनत नइं करे हवय। येह घलो बेकार ए अऊ बड़े दुख के बात ए। <verse eid="ECC 2:21"/><verse number="22" style="v" sid="ECC 2:22"/>मनखे ह धरती म जऊन कठोर मेहनत अऊ काम करथे, ओकर बदले ओला का मिलथे? <verse eid="ECC 2:22"/><verse number="23" style="v" sid="ECC 2:23"/>जिनगी भर ओकर काम ह दुख अऊ दरद ले भरे होथे; अऊ त अऊ रथिया घलो ओकर दिमाग ला अराम नइं मिलय। येह घलो बेकार ए।<verse eid="ECC 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ECC 2:24"/>एक मनखे बर येकर ले बने अऊ कुछू नो हय कि ओह खावय, पीयय अऊ अपन मेहनत म संतोस करय। मेंह देखथंव कि येह घलो परमेसर कोति ले मिलथे, <verse eid="ECC 2:24"/><verse number="25" style="v" sid="ECC 2:25"/>काबरकि ओकर बिगर, कोन ह खा सकथे या आनंद उठा सकथे? <verse eid="ECC 2:25"/><verse number="26" style="v" sid="ECC 2:26"/>जऊन मनखे ले परमेसर ह खुस होथे, ओला ओह बुद्धि, गियान अऊ खुसी देथे, पर पापी मनखे ला परमेसर ह धन इकट्ठा करे अऊ बटोरे के काम देथे कि ओह ओ धन ला ओ मनखे के हांथ म देय दे, जेकर ले परमेसर खुस रहिथे। येह घलो बेकार ए, हवा के पाछू भागे सहीं अय।<verse eid="ECC 2:26"/></para>
  <chapter eid="ECC 2"/>
  <chapter number="3" style="c" sid="ECC 3"/>
  <para style="s1">हर एक काम बर समय ह तय हे</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 3:1"/>हर एक काम बर एक तय समय हवय,</para>
  <para style="q2" vid="ECC 3:1">अऊ धरती म हर काम करे के एक समय होथे:<verse eid="ECC 3:1"/></para>
  <para style="b"/>
  <para style="q2">
    <verse number="2" style="v" sid="ECC 3:2"/>जनम लेय के एक समय अऊ मरे के एक समय,</para>
  <para style="q2" vid="ECC 3:2">बीजा या पऊधा लगाय के एक समय अऊ लगाय ला उखाने के एक समय,<verse eid="ECC 3:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="ECC 3:3"/>मार डारे के एक समय अऊ चंगा करे के एक समय,</para>
  <para style="q2" vid="ECC 3:3">टोर-फोरके गिराय के एक समय अऊ बनाय के एक समय;<verse eid="ECC 3:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="ECC 3:4"/>रोए के एक समय अऊ हंसे के एक समय,</para>
  <para style="q2" vid="ECC 3:4">सोक मनाय के एक समय अऊ नाचे के एक समय,<verse eid="ECC 3:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="ECC 3:5"/>पथरामन ला बगराय के एक समय अऊ ओमन ला संकेले के एक समय,</para>
  <para style="q2" vid="ECC 3:5">कोनो ला पोटारे के एक समय अऊ नइं पोटारे के एक समय,<verse eid="ECC 3:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="ECC 3:6"/>खोजे के एक समय अऊ छोंड़ देय के एक समय,</para>
  <para style="q2" vid="ECC 3:6">बचाके रखे के एक समय अऊ फटिक देय के एक समय,<verse eid="ECC 3:6"/></para>
  <para style="q2">
    <verse number="7" style="v" sid="ECC 3:7"/>चीरे के एक समय अऊ सीले के एक समय,</para>
  <para style="q2" vid="ECC 3:7">चुप रहे के एक समय अऊ गोठियाय के एक समय,<verse eid="ECC 3:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="ECC 3:8"/>मया करे के एक समय अऊ नफरत करे के एक समय,</para>
  <para style="q2" vid="ECC 3:8">लड़ई करे के एक समय अऊ सांति के एक समय।<verse eid="ECC 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 3:9"/>काम करइया ला ओकर मेहनत करे ले का मिलथे? <verse eid="ECC 3:9"/><verse number="10" style="v" sid="ECC 3:10"/>मेंह ओ बोझा ला देखे हंव, जेला परमेसर ह मानव-जाति ऊपर रखे हवय। <verse eid="ECC 3:10"/><verse number="11" style="v" sid="ECC 3:11"/>ओह हर एक चीज ला ओकर समय म सुघर बनाय हवय। ओह मनखे के मन म अनंतकाल ला घलो बसाय हवय; तभो ले परमेसर ह सुरू ले लेके आखिरी तक जऊन काम करे हवय, ओला कोनो मनखे समझ नइं सकय। <verse eid="ECC 3:11"/><verse number="12" style="v" sid="ECC 3:12"/>मेंह जानत हंव कि मनखे बर येकर ले बने बात अऊ कुछू नइं हो सकय कि ओह जिनगी म खुस रहय अऊ भलई के काम करय। <verse eid="ECC 3:12"/><verse number="13" style="v" sid="ECC 3:13"/>ये घलो कि हर एक जन खावय-पीयय, अऊ अपन मेहनत के कमई म ओला संतोस मिलय—येह परमेसर के बरदान अय। <verse eid="ECC 3:13"/><verse number="14" style="v" sid="ECC 3:14"/>मेंह जानत हंव कि हर ओ काम जेला परमेसर करथे, हमेसा बर बने रहिही, येमा कुछू घलो जोड़े नइं जा सकय अऊ न ही येमा ले कुछू हटाय जा सकय। परमेसर ह अइसे करथे ताकि मनखेमन ओकर भय मानंय।<verse eid="ECC 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 3:15"/>जऊन कुछू हवय, ओह पहिली ले हवय,</para>
  <para style="q2" vid="ECC 3:15">अऊ जऊन कुछू होही, ओह पहिले हो चुके हवय;</para>
  <para style="q2" vid="ECC 3:15">अऊ परमेसर ह बीते बातमन के लेखा लीही।<note caller="+" style="f"><char style="fr" closed="false">3:15 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">परमेसर ह बीते बातमन ला सुरता करथे</char></note><verse eid="ECC 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 3:16"/>अऊ मेंह धरती म अऊ कुछू घलो देखेंव:</para>
  <para style="q1" vid="ECC 3:16">फैसला करई के जगह म—दुस्टता रिहिस,</para>
  <para style="q2" vid="ECC 3:16">अऊ नियाय के जगह म घलो—दुस्टता रिहिस।<verse eid="ECC 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 3:17"/>मेंह अपनआप ले कहेंव,</para>
  <para style="q1" vid="ECC 3:17">“परमेसर ह धरमी अऊ दुस्ट</para>
  <para style="q2" vid="ECC 3:17">दूनों के नियाय करही,</para>
  <para style="q1" vid="ECC 3:17">काबरकि हर एक काम के एक समय होही,</para>
  <para style="q2" vid="ECC 3:17">हर काम के नियाय करे के एक समय होही।”<verse eid="ECC 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 3:18"/>मेंह अपनआप ला ये घलो कहेंव, “जहां तक मनखेमन के बात ए, परमेसर ह ओमन ला परखथे ताकि ओमन देखंय कि ओमन पसुमन सहीं अंय। <verse eid="ECC 3:18"/><verse number="19" style="v" sid="ECC 3:19"/>खचित मानव-जाति के तकदीर ह पसुमन सहीं अय; ओहीच तकदीर ह दूनों के इंतजार करथे: जइसे एक झन ह मरथे, त वइसे ही दूसर झन घलो मरथे। जम्मो करा ओहीच सांस<note caller="+" style="f"><char style="fr" closed="false">3:19 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">आतमा</char></note> हवय; मनखे ला पसुमन के तुलना म कोनो फायदा नइं ए। हर चीज ह बेकार ए। <verse eid="ECC 3:19"/><verse number="20" style="v" sid="ECC 3:20"/>जम्मो के जम्मो ओहीच जगह म जाथें; जम्मो के जम्मो धुर्रा ले आथें, अऊ ओ जम्मो धुर्रा म लहुंट जाथें। <verse eid="ECC 3:20"/><verse number="21" style="v" sid="ECC 3:21"/>कोन जानथे कि मनखे के परान ह ऊपर जाथे अऊ पसु के परान ह धरती के खाल्हे म जाथे?”<verse eid="ECC 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ECC 3:22"/>मेंह देखेंव कि मनखे बर येकर ले बने बात कुछू नो हय कि ओह अपन काम म आनंद उठाय, काबरकि ओह ओकर भाग ए। काबरकि कोन ह ओला ये देखे बर ला सकथे कि ओकर मरे के बाद का होही?<verse eid="ECC 3:22"/></para>
  <chapter eid="ECC 3"/>
  <chapter number="4" style="c" sid="ECC 4"/>
  <para style="s1">अतियाचार, मेहनत, बिगर संगी के</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 4:1"/>मेंह फेर ये देखेंव कि धरती म जम्मो किसम के अतियाचार होवत हे:</para>
  <para style="q1" vid="ECC 4:1">मेंह अतियाचार सहनेवालामन के आंसू ला देखेंव—</para>
  <para style="q2" vid="ECC 4:1">अऊ ओमन ला सांति देवइया कोनो नइं एं;</para>
  <para style="q1" vid="ECC 4:1">ओमन के अतियाचार करइयामन करा सक्ति रिहिस—</para>
  <para style="q2" vid="ECC 4:1">अऊ अतियाचार सहनेवालामन करा सांति देवइया कोनो नइं एं।<verse eid="ECC 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 4:2"/>अऊ मेंह घोसना करेंव कि ओ मरे मनखे,</para>
  <para style="q2" vid="ECC 4:2">जऊन मन मर गे हवंय,</para>
  <para style="q1" vid="ECC 4:2">ओमन अभी के जीयत मनखेमन ले</para>
  <para style="q2" vid="ECC 4:2">जादा खुस हवंय।<verse eid="ECC 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 4:3"/>पर ये दूनों ले बेहतर ओह अय,</para>
  <para style="q2" vid="ECC 4:3">जेकर कभू जनम ही नइं होय हवय,</para>
  <para style="q1" vid="ECC 4:3">अऊ जऊन ह ये धरती म होवत</para>
  <para style="q2" vid="ECC 4:3">दुस्टता ला नइं देखे हवय।<verse eid="ECC 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 4:4"/>अऊ मेंह देखेंव कि जम्मो मेहनत अऊ जम्मो सफलता ह एक मनखे के संग दूसर मनखे के बईरता ले निकलके आथे। येह घलो बेकार ए, हवा के पाछू भगई ए।<verse eid="ECC 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 4:5"/>मुरूख ह अपन हांथ म हांथ धरे बईठे रहिथे,</para>
  <para style="q2" vid="ECC 4:5">अऊ अपनआप ला नास करथे।<verse eid="ECC 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 4:6"/>मेहनत के संग दू मुठा भर रहई</para>
  <para style="q2" vid="ECC 4:6">अऊ हवा के पाछू भगई ले</para>
  <para style="q2" vid="ECC 4:6">अपन करा सांति के संग एक मुठा भर रहई ह जादा बने अय।<verse eid="ECC 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 4:7"/>मेंह फेर धरती म कुछू बेकार के चीज देखेंव:<verse eid="ECC 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 4:8"/>एक मनखे ह अकेला रिहिस;</para>
  <para style="q2" vid="ECC 4:8">ओकर न बेटा, न भाई रिहिन।</para>
  <para style="q1" vid="ECC 4:8">ओकर मेहनत के कोनो अन्त नइं रिहिस,</para>
  <para style="q2" vid="ECC 4:8">तभो ले ओकर आंखीमन ला ओकर धन ले संतोस नइं मिलत रिहिस।</para>
  <para style="q1" vid="ECC 4:8">ओह पुछिस, “मेंह काकर बर मेहनत करत हंव,</para>
  <para style="q2" vid="ECC 4:8">अऊ काबर मेंह अपनआप ला आनंद उठाय ले दूर रखत हंव?”</para>
  <para style="q1" vid="ECC 4:8">येह घलो बेकार ए—</para>
  <para style="q2" vid="ECC 4:8">येह बहुंत दुख भरे काम अय।<verse eid="ECC 4:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 4:9"/>एक ले दू झन बेहतर होथें,</para>
  <para style="q2" vid="ECC 4:9">काबरकि ओमन ला ओमन के मेहनत के बेहतर परतिफल मिलथे।<verse eid="ECC 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 4:10"/>कहूं ओमन ले एक झन ह गिर जावय,</para>
  <para style="q2" vid="ECC 4:10">त दूसर ह ओला उठे म मदद करथे।</para>
  <para style="q1" vid="ECC 4:10">पर ओकर ऊपर तरस आथे, जऊन ह गिरथे</para>
  <para style="q2" vid="ECC 4:10">अऊ ओला उठे म मदद करे बर कोनो नइं रहंय।<verse eid="ECC 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 4:11"/>कहूं दू झन संग म सुतथें, त ओमन एक-दूसर ला गरम रखथें।</para>
  <para style="q2" vid="ECC 4:11">पर एक झन अकेला अपनआप ला कइसे गरम रख सकथे?<verse eid="ECC 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 4:12"/>अकेला मनखे ला हराय जा सकथे,</para>
  <para style="q2" vid="ECC 4:12">पर दू झन अपन बचाव कर सकथें।</para>
  <para style="q1" vid="ECC 4:12">तीन ठन डोरी ले बने रस्सी ह आसानी से नइं टूटय।<verse eid="ECC 4:12"/></para>
  <para style="s1">उन्नति ह बेकार ए</para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 4:13"/>एक गरीब बुद्धिमान जवान ह ओ डोकरा मुरूख राजा ले बेहतर अय, जऊन ला चेतउनी के ऊपर धियान देय के समझ नइं रहय। <verse eid="ECC 4:13"/><verse number="14" style="v" sid="ECC 4:14"/>जवान ह जेल ले निकलके राजा के पद ला पाय हो, या ओह अपन राज म ही गरीबी म जनमे हो सकथे। <verse eid="ECC 4:14"/><verse number="15" style="v" sid="ECC 4:15"/>मेंह देखेंव कि ओ जम्मो झन, जऊन मन धरती म रहत रिहिन अऊ चलत-फिरत रिहिन, ओमन ओ जवान के पाछू चलिन, जऊन ह राजा के उत्तराधिकारी रिहिस। <verse eid="ECC 4:15"/><verse number="16" style="v" sid="ECC 4:16"/>उहां ओकर आघू म अनगिनत मनखे रिहिन। पर ओकर बाद के पीढ़ी के मनखेमन ओ उत्तराधिकारी ले खुस नइं होईन। येह घलो बेकार ए, हवा के पाछू भगई ए।<verse eid="ECC 4:16"/></para>
  <chapter eid="ECC 4"/>
  <chapter number="5" style="c" sid="ECC 5"/>
  <para style="s1">परमेसर बर माने गय मन्नत ला पूरा करव</para>
  <para style="p">
    <note caller="+" style="f">
      <char style="fr" closed="false">5 </char>
      <char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="ECC 5:1">5:1</ref></char> ला 4:17, अऊ <char style="xt"><ref loc="ECC 5:2-20">5:2‑20</ref></char> ला 5:1‑19 गने गे हवय</char>
    </note> <verse number="1" style="v" sid="ECC 5:1"/>परमेसर के घर म जाय के बेरा अपन बरताव म सावधानी रखव। लकठा म जा अऊ सुन, येकर बदले कि ओ मुरूखमन सहीं बलिदान चघा, जऊन मन नइं जानंय कि ओमन का गलत करत हवंय।<verse eid="ECC 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 5:2"/>अपन कोनो बात कहे म जल्दबाजी झन कर,</para>
  <para style="q2" vid="ECC 5:2">न ही अपन मन म परमेसर के आघू म</para>
  <para style="q2" vid="ECC 5:2">कोनो बात कहे म जल्दबाजी कर।</para>
  <para style="q1" vid="ECC 5:2">परमेसर ह स्वरग म हवय</para>
  <para style="q2" vid="ECC 5:2">अऊ तेंह धरती म हस,</para>
  <para style="q2" vid="ECC 5:2">एकरसेति तोर बात ह थोरकन होवय।<verse eid="ECC 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 5:3"/>बहुंत अकन काम म धियान देय के कारन सपना आथे,</para>
  <para style="q2" vid="ECC 5:3">अऊ बहुंत अकन बात कहे के कारन मुरूख ह पहिचाने जाथे।<verse eid="ECC 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 5:4"/>जब तेंह कोनो मन्नत मानथस, त ओला पूरा करे म देरी झन कर। काबरकि परमेसर ह मुरूख ले खुस नइं होवय, एकरसेति अपन मन्नत ला पूरा कर। <verse eid="ECC 5:4"/><verse number="5" style="v" sid="ECC 5:5"/>मन्नत मानके ओला पूरा नइं करई ले जादा बने ये अय कि तें मन्नत ही नइं मान। <verse eid="ECC 5:5"/><verse number="6" style="v" sid="ECC 5:6"/>अइसन बात झन कह, जऊन ह तोर पाप म पड़े के कारन होही। अऊ मंदिर के दूत ला ये झन कह, “मोर मन्नत मनई ह एक गलती रिहिस।” तोर कहे बात के कारन परमेसर ला काबर गुस्सा होना पड़य अऊ ओह तोर करे काम ला नास कर डारय? <verse eid="ECC 5:6"/><verse number="7" style="v" sid="ECC 5:7"/>जादा सपना देखई अऊ बहुंत बात कहई ह बेकार अय। एकरसेति परमेसर के भय मान।<verse eid="ECC 5:7"/></para>
  <para style="s1">धन-संपत्ति बेकार ए</para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 5:8"/>कहूं तेंह ये देखथस कि कोनो छेत्र म गरीब ऊपर अतियाचार होवत हे, अऊ नियाय अऊ अधिकार नइं मिलत हे, त अइसन बात ऊपर हैरान झन होबे, काबरकि एक अधिकारी के ऊपर दूसर अधिकारी होथे अऊ ओ दूनों के ऊपर घलो अऊ बड़े अधिकारी होथें। <verse eid="ECC 5:8"/><verse number="9" style="v" sid="ECC 5:9"/>जब भुइयां म जादा फसल होथे, त ओकर ले सब ला फायदा होथे, राजा ला खुद खेत ले फायदा होथे।<verse eid="ECC 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 5:10"/>जऊन ह रूपिया-पईसा ले मया करथे, ओकर करा कभू परयाप्त नइं रहय;</para>
  <para style="q2" vid="ECC 5:10">जऊन ह धन ले मया करथे, ओला कभू अपन कमई ले संतोस नइं होवय।</para>
  <para style="q2" vid="ECC 5:10">येह घलो बेकार ए।<verse eid="ECC 5:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 5:11"/>जइसे चीज-वस्तुमन बढ़थें,</para>
  <para style="q2" vid="ECC 5:11">वइसे ही ओ चीजमन के उपयोग करनेवालामन के संखिया घलो बढ़थे।</para>
  <para style="q1" vid="ECC 5:11">अऊ मालिक ला ओमन ले का फायदा होथे</para>
  <para style="q2" vid="ECC 5:11">सिरिप ये कि ओह ओमन ला देखके संतोस होथे?<verse eid="ECC 5:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 5:12"/>मेहनत करइया ला बने नींद आथे,</para>
  <para style="q2" vid="ECC 5:12">चाहे ओह जादा खावय या कम,</para>
  <para style="q1" vid="ECC 5:12">पर जहां तक धनी के बात ए,</para>
  <para style="q2" vid="ECC 5:12">ओकर धन के बहुंतायत ह ओला सोये बर नइं देय।<verse eid="ECC 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 5:13"/>मेंह धरती म एक बहुंत खराप बात देखे हंव:</para>
  <para style="q1" vid="ECC 5:13">मालिक ह अपन नुकसान बर धन इकट्ठा करिस,<verse eid="ECC 5:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="ECC 5:14"/>या धन ह कुछू बिपत्ति म खतम हो गीस,</para>
  <para style="q1" vid="ECC 5:14">अऊ जब ओकर लइकामन होईन</para>
  <para style="q2" vid="ECC 5:14">त उत्तराधिकार म लइकामन बर कुछू नइं बांचिस।<verse eid="ECC 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 5:15"/>हर एक ह अपन दाई के गरभ ले नंगरा आथे,</para>
  <para style="q2" vid="ECC 5:15">अऊ जइसे हर एक जन आथे, वइसे ओह चले जाथे।</para>
  <para style="q1" vid="ECC 5:15">ओह अपन हांथ म</para>
  <para style="q2" vid="ECC 5:15">अपन मेहनत के कुछू नइं ले जावय।<verse eid="ECC 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 5:16"/>येह घलो बहुंत खराप बात ए:</para>
  <para style="q1" vid="ECC 5:16">जइसे एक मनखे ह आथे, वइसे ओह चले जाथे,</para>
  <para style="q2" vid="ECC 5:16">त ओला का फायदा होथे,</para>
  <para style="q2" vid="ECC 5:16">जबकि ओह बेकार म मेहनत करथे?<verse eid="ECC 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 5:17"/>ओह अपन पूरा जिनगी बहुंत निरासा, दुख</para>
  <para style="q2" vid="ECC 5:17">अऊ कोरोध के संग अंधियार म खाना खाथे।<verse eid="ECC 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 5:18"/>जऊन बने बात मेंह देखे हंव, ओह ये अय: धरती म परमेसर के दिये जिनगी के थोरकन दिन म, मनखे बर येह उचित अय कि ओह खावय, पीयय अऊ अपन कठोर मेहनत म संतुस्ट रहय—काबरकि येह ओकर भाग ए। <verse eid="ECC 5:18"/><verse number="19" style="v" sid="ECC 5:19"/>येकर अलावा, जब परमेसर ह कोनो ला धन-संपत्ति अऊ अधिकार देथे, अऊ येमन के आनंद उठाय के योग्यता देथे, त ओह अपन भाग ला स्वीकार करय अऊ अपन मेहनत म खुस रहय—येह परमेसर के एक बरदान ए। <verse eid="ECC 5:19"/><verse number="20" style="v" sid="ECC 5:20"/>ओह कभू-कभू ही अपन जिनगी के दिन ऊपर बिचार करथे, काबरकि परमेसर ह ओला ओकर मन के खुसी म लगाय रखथे।<verse eid="ECC 5:20"/></para>
  <chapter eid="ECC 5"/>
  <chapter number="6" style="c" sid="ECC 6"/>
  <para style="p">
    <verse number="1" style="v" sid="ECC 6:1"/>मेंह एक आने खराप बात धरती म देखे हंव, अऊ येह मानव-जाति ऊपर बहुंत परभाव डालथे: <verse eid="ECC 6:1"/><verse number="2" style="v" sid="ECC 6:2"/>परमेसर ह कुछू मनखे ला धन-संपत्ति, अधिकार अऊ आदर देथे, जेकर कारन ओकर करा ओकर मनचाहे चीजमन रहिथें, पर परमेसर ह ओमन ला ओ चीजमन के आनंद उठाय के योग्यता नइं देवय, अऊ अजनबीमन ओ चीजमन के आनंद उठाथें। येह बेकार ए, एक बहुंत खराप बात ए।<verse eid="ECC 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 6:3"/>एक मनखे के एक सौ लइका हो सकथें अऊ ओह बहुंत साल तक जी सकथे; चाहे ओह कतको साल जी ले, कहूं ओह अपन धन-संपत्ति के आनंद नइं उठा सकय अऊ मरे के बाद ओला सही ढंग ले माटी नइं मिलय, त मेंह कहिथंव कि एक मरे हुए जनमे लइका ह ओ मनखे ले बेहतर ए, <verse eid="ECC 6:3"/><verse number="4" style="v" sid="ECC 6:4"/>ओह बेकार म आथे, ओह अंधियार म चले जाथे, अऊ अंधियार म ओकर नांव छिप जाथे। <verse eid="ECC 6:4"/><verse number="5" style="v" sid="ECC 6:5"/>हालाकि ओह सूरज ला कभू नइं देखिस या कुछू भी चीज ला नइं जानिस, तभो ले ओला ओ मनखे ले जादा अराम मिलिस— <verse eid="ECC 6:5"/><verse number="6" style="v" sid="ECC 6:6"/>अऊ त अऊ यदि ओ मनखे ह दू बार ले एक-एक हजार साल जीयय, पर अपन धन-संपत्ति के मजा नइं लेवय। का जम्मो झन एक ही जगह म नइं जावंय?<verse eid="ECC 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 6:7"/>मनखे के जम्मो मेहनत ओकर जेवन बर होथे,</para>
  <para style="q2" vid="ECC 6:7">पर ओकर मन ह कभू नइं भरय।<verse eid="ECC 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 6:8"/>बुद्धिमान ह कोन बात म मुरूख ले बढ़के अय?</para>
  <para style="q1" vid="ECC 6:8">गरीब ला ये जानके का मिलथे</para>
  <para style="q2" vid="ECC 6:8">कि ओला दूसरमन के आघू म कइसे बरताव करना चाही?<verse eid="ECC 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 6:9"/>जऊन चीज ला आंखी ह देखथे,</para>
  <para style="q2" vid="ECC 6:9">ओह मन के एती-ओती भटकई ले बेहतर अय।</para>
  <para style="q1" vid="ECC 6:9">येह घलो बेकार ए,</para>
  <para style="q2" vid="ECC 6:9">हवा के पाछू भगई ए।<verse eid="ECC 6:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 6:10"/>जऊन ह पहिले से हवय, ओकर नांव रखे जा चुके हवय,</para>
  <para style="q2" vid="ECC 6:10">अऊ ये पता चल चुके हवय कि मनखे ह का सुभाव के अय;</para>
  <para style="q1" vid="ECC 6:10">कोनो भी अपन ले जादा सक्तिसाली मनखे ले</para>
  <para style="q2" vid="ECC 6:10">लड़ई नइं कर सकय।<verse eid="ECC 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 6:11"/>जहां जादा बात होथे</para>
  <para style="q2" vid="ECC 6:11">उहां मतलब कम निकलथे,</para>
  <para style="q2" vid="ECC 6:11">अऊ ओकर ले कोनो ला का फायदा होथे?<verse eid="ECC 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 6:12"/>काबरकि मनखे के जिनगी के ये थोरकन अऊ बेकार दिन, जऊन ह एक छइहां के सहीं निकल जाथे, कोन ह जानथे कि मनखे बर ये जिनगी म का ह बने ए? ओला कोन ह बता सकथे कि संसार ले ओकर जाय के बाद धरती म का होही?<verse eid="ECC 6:12"/></para>
  <chapter eid="ECC 6"/>
  <chapter number="7" style="c" sid="ECC 7"/>
  <para style="s1">बुद्धि</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 7:1"/>एक बने नांव ह बढ़िया इतर ले कहीं जादा बने होथे,</para>
  <para style="q2" vid="ECC 7:1">अऊ मिरतू के दिन ह जनम के दिन ले जादा बने होथे।<verse eid="ECC 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 7:2"/>सोकित घर म जवई ह</para>
  <para style="q2" vid="ECC 7:2">भोज के घर म जवई ले जादा बने अय,</para>
  <para style="q1" vid="ECC 7:2">काबरकि हर एक मनखे के अन्त मिरतू अय;</para>
  <para style="q2" vid="ECC 7:2">जीयत मनखेमन ला येकर ऊपर धियान देना चाही।<verse eid="ECC 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 7:3"/>निरास होवई ह हंसई ले बने अय,</para>
  <para style="q2" vid="ECC 7:3">काबरकि दुख के अनुभव ले मन के बिचार म सुधार होथे।<verse eid="ECC 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 7:4"/>बुद्धिमान के हिरदय ह सोक मनइयामन के घर म होथे,</para>
  <para style="q2" vid="ECC 7:4">पर मुरूख के हिरदय ह मऊज-मस्ती के घर म होथे।<verse eid="ECC 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 7:5"/>एक बुद्धिमान मनखे के डांट-फटकार ऊपर धियान देवई ह</para>
  <para style="q2" vid="ECC 7:5">मुरूखमन के गीत ला सुनई ले जादा बने अय।<verse eid="ECC 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 7:6"/>जइसे बरतन के तरी म कांटामन के जरे सहीं अवाज होथे,</para>
  <para style="q2" vid="ECC 7:6">वइसे मुरूखमन के हंसी होथे।</para>
  <para style="q2" vid="ECC 7:6">येह घलो बेकार ए।<verse eid="ECC 7:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 7:7"/>अनुचित मांग एक बुद्धिमान मनखे ला मुरूख बना देथे,</para>
  <para style="q2" vid="ECC 7:7">अऊ घूसखोरी ह हिरदय ला भ्रस्ट कर देथे।<verse eid="ECC 7:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 7:8"/>कोनो बात के अन्त ह ओकर सुरूआत ले जादा बने होथे,</para>
  <para style="q2" vid="ECC 7:8">अऊ धीरज ह घमंड ले बने होथे।<verse eid="ECC 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 7:9"/>अपन आतमा म जल्दी से गुस्सा झन होवव,</para>
  <para style="q2" vid="ECC 7:9">काबरकि कोरोध ह मुरूखमन के कोरा म रहिथे।<verse eid="ECC 7:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 7:10"/>ये झन कहव, “बीते जमाना ह आज के समय ले काबर जादा बने रिहिस?”</para>
  <para style="q2" vid="ECC 7:10">काबरकि अइसे सवाल करई ह बुद्धिमानी नो हय।<verse eid="ECC 7:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 7:11"/>बुद्धि ह एक उत्तराधिकार के सहीं बने बात ए</para>
  <para style="q2" vid="ECC 7:11">अऊ येकर ले धरती के जम्मो मनखेमन ला फायदा होथे।<verse eid="ECC 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 7:12"/>बुद्धि ह एक आसरय ए</para>
  <para style="q2" vid="ECC 7:12">जइसे कि पईसा ह एक आसरय ए,</para>
  <para style="q1" vid="ECC 7:12">पर गियान के फायदा ये अय:</para>
  <para style="q2" vid="ECC 7:12">बुद्धि ह बुद्धिमान ला बचाथे।<verse eid="ECC 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 7:13"/>परमेसर के काम ऊपर बिचार करव:</para>
  <para style="q1" vid="ECC 7:13">जेला ओह टेढ़ा कर दे हवय</para>
  <para style="q2" vid="ECC 7:13">ओला कोन ह सीधा कर सकथे?<verse eid="ECC 7:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 7:14"/>जब समय ह बने हवय, त खुस रहव;</para>
  <para style="q2" vid="ECC 7:14">पर जब समय ह खराप चलथे, त येकर ऊपर बिचार करव:</para>
  <para style="q1" vid="ECC 7:14">परमेसर ह एक के संग</para>
  <para style="q2" vid="ECC 7:14">दूसर ला घलो बनाय हवय।</para>
  <para style="q1" vid="ECC 7:14">एकरसेति, कोनो मनखे अपन अगम</para>
  <para style="q2" vid="ECC 7:14">के बारे म कोनो बात नइं जान सकय।<verse eid="ECC 7:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 7:15"/>मोर ये बेकार के जिनगी म मेंह ये दूनों ला देखे हवंव:</para>
  <para style="q1" vid="ECC 7:15">धरमी ह अपन धरमीपन म नास हो जाथे,</para>
  <para style="q2" vid="ECC 7:15">अऊ दुस्ट ह अपन दुस्टता म बहुंत दिन जीथे।<verse eid="ECC 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 7:16"/>हद ले जादा धरमी झन बनव,</para>
  <para style="q2" vid="ECC 7:16">अऊ न ही हद ले जादा बुद्धिमान बनव—</para>
  <para style="q2" vid="ECC 7:16">अइसन करके अपनआप ला काबर नास करई?<verse eid="ECC 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 7:17"/>हद ले जादा दुस्ट झन बनव,</para>
  <para style="q2" vid="ECC 7:17">अऊ न ही मुरूख बनव—</para>
  <para style="q2" vid="ECC 7:17">अइसन करके ठहिराय गय समय ले पहिली काबर मरई?<verse eid="ECC 7:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 7:18"/>एक ला पकड़ई</para>
  <para style="q2" vid="ECC 7:18">अऊ दूसर ला जावन नइं देवई ह बने अय।</para>
  <para style="q2" vid="ECC 7:18">जऊन ह परमेसर के भय मानथे, ओह ये जम्मो अति ले बचथे।<note caller="+" style="f"><char style="fr" closed="false">7:18 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">ओह ओ दूनों ला मानही</char></note><verse eid="ECC 7:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="ECC 7:19"/>बुद्धि ह एक बुद्धिमान मनखे ला</para>
  <para style="q2" vid="ECC 7:19">एक सहर के दस सासन करइयामन ले घलो जादा बलवान बनाथे।<verse eid="ECC 7:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ECC 7:20"/>वास्तव म, धरती म एको जन भी धरमी नइं एं,</para>
  <para style="q2" vid="ECC 7:20">कोनो भी अइसन नइं, जऊन ह बने काम करथे अऊ कभू पाप नइं करय।<verse eid="ECC 7:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ECC 7:21"/>मनखेमन के कहे हर बात के ऊपर धियान झन देवव,</para>
  <para style="q2" vid="ECC 7:21">या अइसन होही कि तेंह अपन सेवक ला तोला सराप देवत सुनबे—<verse eid="ECC 7:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ECC 7:22"/>काबरकि तेंह अपन मन म जानत हस</para>
  <para style="q2" vid="ECC 7:22">कि तेंह खुद कतको बार आने मन ला सराप दे हस।<verse eid="ECC 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ECC 7:23"/>ये जम्मो ला मेंह बुद्धि के दुवारा जांचेंव अऊ कहेंव,</para>
  <para style="q1" vid="ECC 7:23">“मेंह बुद्धिमान बने के ठान ले हंव”—</para>
  <para style="q2" vid="ECC 7:23">पर येह मोर ले बाहिर के बात रिहिस।<verse eid="ECC 7:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ECC 7:24"/>जऊन कुछू हवय, ओह समझ ले परे अय अऊ सबले गहिरा बात ए—</para>
  <para style="q2" vid="ECC 7:24">येकर थाह कोन पा सकथे?<verse eid="ECC 7:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ECC 7:25"/>एकरसेति मेंह अपन मन ला समझे बर,</para>
  <para style="q2" vid="ECC 7:25">छानबीन करे बर, अऊ बुद्धि अऊ चीजमन के परबंध के खोज म</para>
  <para style="q1" vid="ECC 7:25">अऊ दुस्ट के मुरूखता</para>
  <para style="q2" vid="ECC 7:25">अऊ मुरूख के पागलपन ला समझे बर लगांय।<verse eid="ECC 7:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="ECC 7:26"/>मेंह मिरतू ले घलो जादा करू चीज ला पाथंव</para>
  <para style="q2" vid="ECC 7:26">माईलोगन, जऊन ह कि एक फांदा ए,</para>
  <para style="q1" vid="ECC 7:26">जेकर हिरदय ह एक फांदा ए</para>
  <para style="q2" vid="ECC 7:26">अऊ जेकर हांथमन बेड़ी अंय।</para>
  <para style="q1" vid="ECC 7:26">ओ मनखे, जऊन ह परमेसर ला खुस रखथे, ओही ह ओ माईलोगन ले बचके निकलथे,</para>
  <para style="q2" vid="ECC 7:26">पर पापी मनखे ला ओ माईलोगन ह फांस लेथे।<verse eid="ECC 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ECC 7:27"/>गुरू ह कहिथे, “देखव, मेंह ये पता लगाय हंव:</para>
  <para style="q1" vid="ECC 7:27">“चीजमन के बारे म पता लगाय बर मेंह एक चीज म आने ला मिलायेंव—<verse eid="ECC 7:27"/></para>
  <para style="q2">
    <verse number="28" style="v" sid="ECC 7:28"/>जेकर मेंह अब तक खोज करत रहेंव</para>
  <para style="q2" vid="ECC 7:28">ओह मोला नइं मिलिस—</para>
  <para style="q1" vid="ECC 7:28">मोला एक हजार मनखे म एक ईमानदार मनखे मिलिस,</para>
  <para style="q2" vid="ECC 7:28">पर ओ जम्मो म एको झन ईमानदार माईलोगन नइं मिलिस।<verse eid="ECC 7:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ECC 7:29"/>मोला सिरिप ये मिलिस:</para>
  <para style="q2" vid="ECC 7:29">परमेसर ह मनखे-जाति ला ईमानदार बनाईस,</para>
  <para style="q2" vid="ECC 7:29">पर ओमन बहुंते उपाय के खोज म लगे हवंय।”<verse eid="ECC 7:29"/></para>
  <para style="b"/>
  <chapter eid="ECC 7"/>
  <chapter number="8" style="c" sid="ECC 8"/>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 8:1"/>बुद्धिमान के सहीं कोन हे?</para>
  <para style="q2" vid="ECC 8:1">चीजमन के मतलब ला कोन ह जानथे?</para>
  <para style="q1" vid="ECC 8:1">मनखे के बुद्धि ले ओकर चेहरा ह चमकथे</para>
  <para style="q2" vid="ECC 8:1">अऊ येकर कठोर रूप ह बदल जाथे।<verse eid="ECC 8:1"/></para>
  <para style="s1">राजा के बात मानव</para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 8:2"/>मेंह सलाह देवत हंव, “राजा के हुकूम ला मान, काबरकि तेंह परमेसर के आघू म सपथ खाय हस। <verse eid="ECC 8:2"/><verse number="3" style="v" sid="ECC 8:3"/>राजा ला छोंड़के जाय म जल्दबाजी झन करबे। गलत बात के तरफदारी झन करबे, काबरकि राजा ह ओही काम ला करही, जऊन ह ओला बने लगथे।” <verse eid="ECC 8:3"/><verse number="4" style="v" sid="ECC 8:4"/>राजा के बात ह सबले बड़के होथे, त ओला कोन ह कह सकथे, “तेंह का करत हस?”<verse eid="ECC 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 8:5"/>जऊन ह ओकर हुकूम ला मानथे, ओकर नुकसान नइं होवय,</para>
  <para style="q2" vid="ECC 8:5">अऊ बुद्धिमान हिरदय ह सही समय अऊ सही तरीका ला जानथे।<verse eid="ECC 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 8:6"/>काबरकि हर एक बात बर एक सही समय अऊ तरीका होथे,</para>
  <para style="q2" vid="ECC 8:6">हालाकि एक मनखे के ऊपर संकट आ सकथे।<verse eid="ECC 8:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 8:7"/>जब कोनो मनखे अगम के बात ला नइं जानय,</para>
  <para style="q2" vid="ECC 8:7">त कोन ह दूसर ला बता सकथे कि का होवइया हे?<verse eid="ECC 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 8:8"/>हवा ला एक जगह म रखे के सक्ति काकरो करा नइं ए,</para>
  <para style="q2" vid="ECC 8:8">वइसे ही अपन मिरतू ऊपर काकरो अधिकार नइं रहय।</para>
  <para style="q1" vid="ECC 8:8">जइसे कि लड़ई के बेरा कोनो ला छुट्टी नइं मिलय,</para>
  <para style="q2" vid="ECC 8:8">वइसे ही दुस्टता करइयामन ला दुस्टता ह नइं छोंड़य।<verse eid="ECC 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 8:9"/>ये जम्मो ला मेंह देखेंव, जब धरती ऊपर करे जावत हर एक काम ऊपर मेंह अपन मन ला लगांय। अइसन घलो समय होथे, जब मनखे ह दूसर ऊपर अधिकार करके अपन ही हानि करथे। <verse eid="ECC 8:9"/><verse number="10" style="v" sid="ECC 8:10"/>तब मेंह दुस्टमन ला गाड़े जावत घलो देखेंव—जऊन मन पबितर स्थान ले आवत-जावत रिहिन अऊ सहर म महिमा पावत रिहिन जिहां ओमन दुस्टता करिन। येह घलो बेकार ए।<verse eid="ECC 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 8:11"/>जब अपराध के सजा जल्दी नइं दिये जावय, तब मनखेमन के हिरदय ह बुरई करे के योजना ले भर जाथे। <verse eid="ECC 8:11"/><verse number="12" style="v" sid="ECC 8:12"/>हालाकि एक दुस्ट मनखे ह सौ अपराध करथे अऊ लम्बा समय तक जीयत रहिथे, पर मेंह जानत हंव कि ओमन ऊपर भलई होही, जऊन मन परमेसर के भय मानथें अऊ ओकर बर आदर के भाव रखथें। <verse eid="ECC 8:12"/><verse number="13" style="v" sid="ECC 8:13"/>तभो ले काबरकि दुस्टमन परमेसर के भय नइं मानंय, एकरसेति ओमन के संग बने नइं होवय, अऊ ओमन के जिनगी ह छइहां के सहीं नइं बढ़य।<verse eid="ECC 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 8:14"/>एक अऊ बेकार बात हे, जऊन ह धरती ऊपर होथे: धरमी के संग अइसने बात होथे, जइसने कोनो दुस्ट के संग होना चाही, अऊ दुस्ट के संग अइसने बात होथे, जइसने कोनो धरमी के संग होना चाही। मेंह कहिथंव, येह घलो बेकार ए। <verse eid="ECC 8:14"/><verse number="15" style="v" sid="ECC 8:15"/>एकरसेति मेंह जिनगी के आनंद ला उठाय के सराहना करथंव, काबरकि धरती म एक मनखे बर येकर ले अऊ कोनो बात बने नो हय कि ओह खावय-पीयय अऊ खुस रहय। तब आनंद ह ओमन के ओ जम्मो जिनगी के मेहनत म ओमन के संग रहिही, जेला परमेसर ह ओमन ला धरती म देय हवय।<verse eid="ECC 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 8:16"/>जब मेंह अपन मन बुद्धि ला जाने बर अऊ धरती ऊपर करे गय मेहनत ला समझे बर लगांय—मनखेमन ला दिन अऊ रात नींद नइं आवत रिहिस— <verse eid="ECC 8:16"/><verse number="17" style="v" sid="ECC 8:17"/>तब मेंह ओ जम्मो काम ला देखेंव, जेला परमेसर ह करे हवय। धरती म जऊन कुछू होवत हे, ओला कोनो समझ नइं सकंय। अपन जांच-पड़ताल करे के जम्मो कोसिस के बावजूद, कोनो येला समझ नइं सकंय। चाहे कहूं बुद्धिमान मनखे घलो दावा करे कि ओह जानथे, पर सही म ओह येला समझ नइं सकय।<verse eid="ECC 8:17"/></para>
  <chapter eid="ECC 8"/>
  <chapter number="9" style="c" sid="ECC 9"/>
  <para style="s1">जम्मो बर एक समान्य बात</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 9:1"/>मेंह ये जम्मो बात ऊपर बिचार करेंव अऊ ये निरनय म पहुंचंय कि धरमी अऊ बुद्धिमान अऊ जऊन कुछू ओमन करथें, ओ सब परमेसर के हांथ म होथे, पर ये बात ला कोनो नइं जानय कि अवइया समय म ओला मया या नफरत मिलही। <verse eid="ECC 9:1"/><verse number="2" style="v" sid="ECC 9:2"/>जम्मो के संग एक समान्य बात रहिथे—धरमी अऊ दुस्ट, बने अऊ खराप, सुध अऊ असुध, जऊन मन बलिदान चघाथें अऊ जऊन मन बलिदान नइं चघावंय, जम्मो के दसा एक सहीं होथे।</para>
  <para style="q1" vid="ECC 9:2">जइसे बने मनखे के संग होथे,</para>
  <para style="q2" vid="ECC 9:2">वइसे पापी मनखे संग घलो होथे;</para>
  <para style="q1" vid="ECC 9:2">जइसे सपथ खवइयामन के संग होथे,</para>
  <para style="q2" vid="ECC 9:2">वइसे ओमन के संग घलो होथे, जऊन मन सपथ खाय बर डरथें।<verse eid="ECC 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 9:3"/>धरती म हर बात म एक बुरई हवय: जम्मो झन के एकेच दसा होथे। मनखेमन के हिरदय ह बुरई ले भरे हवय अऊ जब ओमन जीयत रहिथें, त ओमन के हिरदय म पागलपन रहिथे, अऊ ओकर बाद ओमन मर जाथें। <verse eid="ECC 9:3"/><verse number="4" style="v" sid="ECC 9:4"/>जऊन ह जीयतमन के बीच म हवय, ओकर करा आसा हवय—अऊ त अऊ एक जीयत कुकुर ह मरे सिंह ले जादा बने अय!<verse eid="ECC 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 9:5"/>काबरकि जीयतमन जानथें कि ओमन मरहीं,</para>
  <para style="q2" vid="ECC 9:5">पर मरे मन कुछू नइं जानंय;</para>
  <para style="q1" vid="ECC 9:5">ओमन के अऊ कोनो ईनाम नइं रहय,</para>
  <para style="q2" vid="ECC 9:5">अऊ त अऊ ओमन के नांव घलो सुरता म नइं रहय।<verse eid="ECC 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 9:6"/>ओमन के मया, ओमन के घिन</para>
  <para style="q2" vid="ECC 9:6">अऊ ओमन के डाह बहुंत पहिले खतम हो गीस;</para>
  <para style="q1" vid="ECC 9:6">धरती म जऊन कुछू होथे</para>
  <para style="q2" vid="ECC 9:6">ओमा ओमन के फेर कभू कुछू भाग नइं होही।<verse eid="ECC 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 9:7"/>जावव अऊ खुसी से अपन खाना खावव, अऊ आनंद मन से अपन अंगूर के मंद पीयव, काबरकि परमेसर ह पहिले ही तुम्हर काम ला मंजूरी देय दे हवय। <verse eid="ECC 9:7"/><verse number="8" style="v" sid="ECC 9:8"/>हमेसा सफेद कपड़ा पहिरव, अऊ हमेसा अपन मुड़ म तेल लगावव। <verse eid="ECC 9:8"/><verse number="9" style="v" sid="ECC 9:9"/>धरती म परमेसर ह तुमन ला जऊन बेकार के जिनगी देय हवय, ओमा अपन घरवाली के संग आनंद मनावव, जेला कि तुमन मया करथव—तुम्हर जम्मो बेकार के दिन। काबरकि धरती म येह तुम्हर जिनगी अऊ तुम्हर मेहनत के बांटा ए। <verse eid="ECC 9:9"/><verse number="10" style="v" sid="ECC 9:10"/>तुमन ला जऊन कुछू भी काम मिलथे, ओला पूरा लगन से करव, काबरकि मिरतू-लोक म, जिहां तुमन जावत हव, उहां न तो कोनो काम, न कोनो योजना अऊ न ही गियान अऊ बुद्धि हवय।<verse eid="ECC 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 9:11"/>मेंह धरती म अऊ कुछू घलो देखे हंव:</para>
  <para style="q1" vid="ECC 9:11">दऊड़ म न तो तेज दऊड़इया</para>
  <para style="q2" vid="ECC 9:11">अऊ न ही लड़ई म ताकतवाला ह जीतथे,</para>
  <para style="q1" vid="ECC 9:11">न बुद्धिमान ला खाना मिलथे</para>
  <para style="q2" vid="ECC 9:11">अऊ न ही अति बुद्धिमान ला संपत्ति</para>
  <para style="q2" vid="ECC 9:11">अऊ न ही गियानी मनखे ऊपर किरपा करे जाथे;</para>
  <para style="q1" vid="ECC 9:11">पर ये जम्मो बात समय अऊ मऊका ऊपर निरभर होथें।<verse eid="ECC 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 9:12"/>तभो ले, कोनो नइं जानय कि ओकर समय कब आही:</para>
  <para style="q1" vid="ECC 9:12">जइसे कि मछरीमन ला निरदयी जाल म,</para>
  <para style="q2" vid="ECC 9:12">अऊ चिरईमन ला फांदा म फंसाय जाथे,</para>
  <para style="q1" vid="ECC 9:12">वइसने ही मनखेमन खराप समय के दुवारा फंसथें</para>
  <para style="q2" vid="ECC 9:12">जऊन ह कि ओमन ऊपर अचानक आ जाथे।<verse eid="ECC 9:12"/></para>
  <para style="s1">बुद्धि ह मुरूखता ले बने अय</para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 9:13"/>मेंह धरती म बुद्धि के ये उदाहरन घलो देखेंव, जऊन ह मोला बहुंत परभावित करिस: <verse eid="ECC 9:13"/><verse number="14" style="v" sid="ECC 9:14"/>एक ठन छोटे सहर रिहिस, जेमा सिरिप कुछू मनखे रहत रिहिन। अऊ एक सक्तिसाली राजा येकर बिरूध आईस, अऊ ओ सहर ला घेर लीस अऊ येकर बिरूध बहुंत बड़े सेना के घेरा डालिस। <verse eid="ECC 9:14"/><verse number="15" style="v" sid="ECC 9:15"/>पर ओ सहर म एक गरीब, पर बुद्धिमान मनखे रहत रिहिस, अऊ ओह अपन बुद्धि के दुवारा ओ सहर ला बचा लीस। पर ओ गरीब मनखे ला कोनो सुरता नइं करिन। <verse eid="ECC 9:15"/><verse number="16" style="v" sid="ECC 9:16"/>एकरसेति मेंह कहेंव, “बुद्धि ह ताकत ले जादा बने अय।” पर गरीब मनखे के बुद्धि ह तुछ समझे जाथे, अऊ ओकर बात ऊपर फेर धियान नइं दिये जावय।<verse eid="ECC 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 9:17"/>मुरूखमन के राजा के चिचियाई ऊपर धियान देय के बदले</para>
  <para style="q2" vid="ECC 9:17">बुद्धिमान के सांत बातमन ऊपर जादा धियान देना चाही।<verse eid="ECC 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 9:18"/>बुद्धि ह लड़ई के हथियारमन ले जादा बने अय,</para>
  <para style="q2" vid="ECC 9:18">पर एक पापी मनखे ह बहुंत अकन भलई के नास करथे।<verse eid="ECC 9:18"/></para>
  <para style="b"/>
  <chapter eid="ECC 9"/>
  <chapter number="10" style="c" sid="ECC 10"/>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 10:1"/>जइसे मरे माछीमन खुसबू ला बदबू म बदल देथें,</para>
  <para style="q2" vid="ECC 10:1">वइसे ही थोरकन मुरूखता ह बुद्धि अऊ आदर ऊपर भारी पड़थे।<verse eid="ECC 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 10:2"/>बुद्धिमान के हिरदय ह ओला सही रसता म ले जाथे,</para>
  <para style="q2" vid="ECC 10:2">पर मुरूख के हिरदय ह ओला गलत रसता म ले जाथे।<verse eid="ECC 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 10:3"/>जब मुरूखमन रसता म चलत रहिथें,</para>
  <para style="q2" vid="ECC 10:3">त ओमन म समझ के कमी होथे</para>
  <para style="q2" vid="ECC 10:3">अऊ हर एक जन ला देखाथें कि ओमन कतेक मुरूख अंय।<verse eid="ECC 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 10:4"/>यदि एक हाकिम के कोरोध ह तोर ऊपर भड़कथे,</para>
  <para style="q2" vid="ECC 10:4">त अपन पद ला झन छोंड़बे;</para>
  <para style="q2" vid="ECC 10:4">चुप रहई ह बड़े-बड़े अपराध ला सांत कर सकथे।<verse eid="ECC 10:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 10:5"/>धरती म मेंह एक बुरई देखे हंव,</para>
  <para style="q2" vid="ECC 10:5">एक किसम के गलती, जऊन ह हाकिम के दुवारा होथे:<verse eid="ECC 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 10:6"/>मुरूखमन ला बहुंत ऊंच पद दिये जाथे,</para>
  <para style="q2" vid="ECC 10:6">जबकि धनीमन छोटे पद म होथें।<verse eid="ECC 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 10:7"/>मेंह गुलाममन ला घोड़ा के सवारी करत,</para>
  <para style="q2" vid="ECC 10:7">पर राजकुमारमन ला गुलाममन सहीं रेंगत देखे हंव।<verse eid="ECC 10:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 10:8"/>जऊन ह खंचवा कोड़थे, ओह ओमा गिर सकथे;</para>
  <para style="q2" vid="ECC 10:8">जऊन ह दीवार म सेंध लगाथे, ओला सांप ह चाब सकथे।<verse eid="ECC 10:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 10:9"/>जऊन ह खदान ले पथरा निकालथे, ओला पथरा से चोट लग सकथे;</para>
  <para style="q2" vid="ECC 10:9">जऊन ह लकरी चीरथे, ओला लकरी ले खतरा हो सकथे।<verse eid="ECC 10:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 10:10"/>यदि टांगा म धार नइं ए</para>
  <para style="q2" vid="ECC 10:10">अऊ येकर किनारे ला तेज नइं करे गे हवय,</para>
  <para style="q1" vid="ECC 10:10">त जादा ताकत के जरूरत पड़थे,</para>
  <para style="q2" vid="ECC 10:10">पर कोनो काम म कुसलता ह सफलता देवाथे।<verse eid="ECC 10:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 10:11"/>यदि सांप ह बस म करे के पहिले कोनो ला काट लेथे,</para>
  <para style="q2" vid="ECC 10:11">त बस म करइया ला कोनो फायदा नइं होवय।<verse eid="ECC 10:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 10:12"/>बुद्धिमान मनखे के बात म अनुग्रह होथे,</para>
  <para style="q2" vid="ECC 10:12">पर मुरूखमन अपन खुद के बात के दुवारा नास हो जाथें।<verse eid="ECC 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 10:13"/>सुरू म ओमन के बातमन मुरूखता के होथें;</para>
  <para style="q2" vid="ECC 10:13">अन्त म ओमन दुस्ट पागलपन होथें—<verse eid="ECC 10:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="ECC 10:14"/>अऊ मुरूखमन बहुंत बात करथें।</para>
  <para style="b" vid="ECC 10:14"/>
  <para style="q1" vid="ECC 10:14">कोनो नइं जानय कि का होवइया हे—</para>
  <para style="q2" vid="ECC 10:14">कोन ह कोनो अऊ ला बता सकथे कि ओमन के बाद का होवइया हे?<verse eid="ECC 10:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 10:15"/>मुरूखमन के मेहनत ह ओमन ला थका देथे;</para>
  <para style="q2" vid="ECC 10:15">ओमन नगर के रसता ला घलो नइं जानंय।<verse eid="ECC 10:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 10:16"/>ओ देस के ऊपर हाय, जेकर राजा ह एक सेवक रिहिस<note caller="+" style="f"><char style="fr" closed="false">10:16 </char><char style="ft" closed="false">या </char><char style="fq" closed="false">राजा </char><char style="fqa" closed="false">ह एक लइका ए</char></note></para>
  <para style="q2" vid="ECC 10:16">अऊ जेकर हाकिममन बिहनियां मऊज-मस्ती म लग जाथें।<verse eid="ECC 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 10:17"/>धइन अय ओ देस, जेकर राजा ह उत्तम बंस के होथे</para>
  <para style="q2" vid="ECC 10:17">अऊ जेकर हाकिममन सही समय म जेवन करथें—</para>
  <para style="q2" vid="ECC 10:17">ओमन के जेवन ह ताकत बर होथे, मतवारपन बर नइं।<verse eid="ECC 10:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 10:18"/>आलसीपन ले छत के कड़ीमन झुक जाथें;</para>
  <para style="q2" vid="ECC 10:18">निठल्लापन के कारन घर के छत ले पानी चूहथे।<verse eid="ECC 10:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="ECC 10:19"/>जेवनार ला हंसी-खुसी बर तियार करे जाथे,</para>
  <para style="q2" vid="ECC 10:19">अंगूर के मंद ह जिनगी ला आनंदित कर देथे,</para>
  <para style="q2" vid="ECC 10:19">अऊ पईसा के दुवारा हर चीज हो सकथे।<verse eid="ECC 10:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ECC 10:20"/>अपन मन के बिचार म घलो राजा ला गाली झन देबे,</para>
  <para style="q2" vid="ECC 10:20">या न ही अपन सोये के कमरा म कोनो धनी मनखे ला सराप देबे,</para>
  <para style="q1" vid="ECC 10:20">काबरकि अकास के कोनो चिरई ह तोर बातमन ला ले जा सकथे,</para>
  <para style="q2" vid="ECC 10:20">अऊ कोनो उड़नेवाला चिरई ह तोर कहे बात ला बता सकथे।<verse eid="ECC 10:20"/></para>
  <chapter eid="ECC 10"/>
  <chapter number="11" style="c" sid="ECC 11"/>
  <para style="s1">जोखिम के बहुंत काममन म पूंजी लगई</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 11:1"/>अपन अनाज ला पानी जहाज ले समुंदर के ओ पार भेजव;</para>
  <para style="q2" vid="ECC 11:1">बहुंत दिन के बाद तुमन ला येकर लाभ मिल सकथे।<verse eid="ECC 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 11:2"/>अपन पूंजी सात ठन जोखिम के काम म लगावव, हव, बल्कि आठ ठन म लगावव;</para>
  <para style="q2" vid="ECC 11:2">तुमन नइं जानव कि देस म का बिपत्ति आ सकथे।<verse eid="ECC 11:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 11:3"/>अगर बादरमन पानी ले भरे हवंय,</para>
  <para style="q2" vid="ECC 11:3">त ओमन ले धरती म बारिस होथे।</para>
  <para style="q1" vid="ECC 11:3">एक रूख ह चाहे दक्खिन म गिरय या उत्तर म गिरय,</para>
  <para style="q2" vid="ECC 11:3">जिहां येह गिरथे, उहां येह पड़े रहिही।<verse eid="ECC 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 11:4"/>जऊन मनखे ह हवा ला देखत रहिथे, ओह बीजा नइं बोए;</para>
  <para style="q2" vid="ECC 11:4">अऊ जऊन ह बादरमन ला देखत रहिथे, ओह फसल नइं लुए।<verse eid="ECC 11:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 11:5"/>जइसे कि तुमन हवा के रसता ला नइं जानव,</para>
  <para style="q2" vid="ECC 11:5">या ये नइं जानव कि दाई के गरभ म लइका के देहें ह कइसे बनथे,<note caller="+" style="f"><char style="fr" closed="false">11:5 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">लइका म जिनगी कइसे आथे</char></note></para>
  <para style="q1" vid="ECC 11:5">ओही किसम ले तुमन परमेसर के काम ला नइं समझ सकव,</para>
  <para style="q2" vid="ECC 11:5">जऊन ह कि जम्मो चीज के बनानेवाला ए।<verse eid="ECC 11:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 11:6"/>अपन बीजा ला बिहनियां ही बो देवव,</para>
  <para style="q2" vid="ECC 11:6">अऊ सांझ के आलसी बनके बईठे झन रहव,</para>
  <para style="q1" vid="ECC 11:6">काबरकि तुमन नइं जानव</para>
  <para style="q2" vid="ECC 11:6">कि कते ह फर दीही, येह या ओह,</para>
  <para style="q2" vid="ECC 11:6">या फेर दूनों बराबर बने फर दीहीं।<verse eid="ECC 11:6"/></para>
  <para style="s1">जवानी म सिरिस्टीकर्ता ला सुरता करव</para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 11:7"/>अंजोर ह मन ला भाथे,</para>
  <para style="q2" vid="ECC 11:7">अऊ येह सूरज ला देखे म आंखी ला बने लगथे।<verse eid="ECC 11:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 11:8"/>एक मनखे ह बहुंत साल तक जी सकथे,</para>
  <para style="q2" vid="ECC 11:8">त ओह जम्मो चीज के आनंद उठाय।</para>
  <para style="q1" vid="ECC 11:8">पर ओह अपन अंधियार भरे दिनमन ला सुरता रखय,</para>
  <para style="q2" vid="ECC 11:8">काबरकि येमन बहुंते होहीं।</para>
  <para style="q2" vid="ECC 11:8">अवइया हर एक चीज ह बेकार ए।<verse eid="ECC 11:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 11:9"/>हे जवान, तेंह खुस रह, जब तेंह जवान हस,</para>
  <para style="q2" vid="ECC 11:9">अऊ तोर हिरदय ह तोला तोर जवानी के दिन म आनंदित करय।</para>
  <para style="q1" vid="ECC 11:9">अपन हिरदय के ईछा</para>
  <para style="q2" vid="ECC 11:9">अऊ जऊन कुछू तुम्हर आंखी देखथे, ओकर पाछू चलव,</para>
  <para style="q1" vid="ECC 11:9">पर ये बात ला जानव कि ये जम्मो चीज बर</para>
  <para style="q2" vid="ECC 11:9">परमेसर ह तुम्हर नियाय करही।<verse eid="ECC 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 11:10"/>एकरसेति अपन हिरदय ले दुख ला दूर करव</para>
  <para style="q2" vid="ECC 11:10">अऊ अपन देहें के समस्या ला निकाल दव,</para>
  <para style="q2" vid="ECC 11:10">काबरकि जवानी अऊ ताकत बेकार अंय।<verse eid="ECC 11:10"/></para>
  <para style="b"/>
  <chapter eid="ECC 11"/>
  <chapter number="12" style="c" sid="ECC 12"/>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 12:1"/>अपन जवानी के दिन म</para>
  <para style="q2" vid="ECC 12:1">अपन सिरिस्टीकर्ता ला सुरता रख,</para>
  <para style="q1" vid="ECC 12:1">येकर पहिले कि दुख के दिन आवय</para>
  <para style="q2" vid="ECC 12:1">अऊ ओ बछरमन आवंय, जब तेंह कहिबे,</para>
  <para style="q2" vid="ECC 12:1">“येमन म मोला थोरकन भी खुसी नइं मिलय”—<verse eid="ECC 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 12:2"/>येकर पहिले कि सूरज अऊ अंजोर</para>
  <para style="q2" vid="ECC 12:2">अऊ चंदा अऊ तारामन अंधियार हो जावंय,</para>
  <para style="q2" vid="ECC 12:2">अऊ बारिस के बाद बादरमन लहुंट जावंय;<verse eid="ECC 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 12:3"/>जब घर के रखवारमन कांपे लगंय,</para>
  <para style="q2" vid="ECC 12:3">अऊ बलवान मनखे के देहें ह झुक जावय,</para>
  <para style="q1" vid="ECC 12:3">जब पीसनेवालामन रूक जावंय काबरकि ओमन थोरकन हवंय,</para>
  <para style="q2" vid="ECC 12:3">अऊ खिड़की म ले देखइयामन के आंखी ह कमजोर हो जावय;<verse eid="ECC 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 12:4"/>जब गली तरफ के कपाटमन बंद हो जावंय</para>
  <para style="q2" vid="ECC 12:4">अऊ चक्की के अवाज ह धीमा हो जावय;</para>
  <para style="q1" vid="ECC 12:4">जब मनखेमन चिरई के अवाज सुनके उठंय,</para>
  <para style="q2" vid="ECC 12:4">पर ओ जम्मो के गीतमन के अवाज सुनई नइं देवय;<verse eid="ECC 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 12:5"/>जब मनखेमन ऊंचहा जगह</para>
  <para style="q2" vid="ECC 12:5">अऊ गली के खतरा ले डरंय;</para>
  <para style="q1" vid="ECC 12:5">जब बादाम के रूख ह फूलय</para>
  <para style="q2" vid="ECC 12:5">अऊ फांफा ह ओकर संग घसीटके चलय</para>
  <para style="q2" vid="ECC 12:5">अऊ ईछा ह फेर नइं जागय।</para>
  <para style="q1" vid="ECC 12:5">तब मनखेमन अपन सदाकाल के घर म चल देथें</para>
  <para style="q2" vid="ECC 12:5">अऊ सोक मनइयामन गलीमन म फिरत रहिथें।<verse eid="ECC 12:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 12:6"/>ओला सुरता करव—येकर पहिले कि चांदी के डोर ह कठोर हो जावय,</para>
  <para style="q2" vid="ECC 12:6">अऊ सोन के कटोरा ह टूट जावय;</para>
  <para style="q1" vid="ECC 12:6">येकर पहिले कि घघरी ह बसन्त के समय टूटके चकनाचूर हो जावय,</para>
  <para style="q2" vid="ECC 12:6">अऊ कुआं म पहिया ह टूट जावय,<verse eid="ECC 12:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 12:7"/>अऊ धुर्रा ह भुइयां म लहुंट जावय, जिहां ले येह आय रिहिस,</para>
  <para style="q2" vid="ECC 12:7">अऊ आतमा ह परमेसर करा लहुंट जावय, जऊन ह येला देय रिहिस।<verse eid="ECC 12:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 12:8"/>“बेकार अय! बेकार अय!” गुरू<note caller="+" style="f"><char style="fr" closed="false">12:8 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सभा के अगुवा </char><char style="ft" closed="false">पद <char style="xt" link-href="ECC 12:9"><ref loc="ECC 12:9">9</ref></char> अऊ <char style="xt" link-href="ECC 12:10"><ref loc="ECC 12:10">10</ref></char> म घलो</char></note> ह कहिथे।</para>
  <para style="q2" vid="ECC 12:8">“हर चीज ह बेकार ए!”<verse eid="ECC 12:8"/></para>
  <para style="s1">बात के अन्त</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 12:9"/>गुरू ह सिरिप बुद्धिमान ही नइं रिहिस, पर ओह मनखेमन ला गियान घलो दीस। ओह बिचार करिस अऊ खोजबीन करिस अऊ बहुंते नीतिबचनमन ला सही ढंग ले रखिस। <verse eid="ECC 12:9"/><verse number="10" style="v" sid="ECC 12:10"/>गुरू ह सिरिप सही सबद पाय बर खोजबीन करिस, अऊ जऊन बात ओह लिखिस, ओ बातमन सही अऊ सच अंय।<verse eid="ECC 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 12:11"/>बुद्धिमान के बातमन लउठी के धार सहीं होथें, ओमन के सांत मन के कहावतमन बने ढंग ले ठोंके गय खीलामन सहीं होथें—मानो येला एकेच चरवाहा के दुवारा दिये गे हवय <verse eid="ECC 12:11"/><verse number="12" style="v" sid="ECC 12:12"/>हे मोर बेटा, येकर अलावा अऊ आने बातमन के बारे म सावधान रहिबे।</para>
  <para style="p" vid="ECC 12:12">बहुंत अकन किताब के लिखे अऊ ओमन के रखे के अन्त नइं ए, अऊ जादा किताब पढ़ई ह देहें ला थका देथे।<verse eid="ECC 12:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 12:13"/>अब जम्मो बात सुने जा चुके हवय;</para>
  <para style="q2" vid="ECC 12:13">बात के अन्त ये अय:</para>
  <para style="q1" vid="ECC 12:13">परमेसर के भय मानव अऊ ओकर हुकूममन ला मानव,</para>
  <para style="q2" vid="ECC 12:13">काबरकि येह जम्मो मानव-जाति के फर्ज अय।<verse eid="ECC 12:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 12:14"/>काबरकि परमेसर ह हर काम के नियाय करही,</para>
  <para style="q2" vid="ECC 12:14">ओमा हर छिपे बातमन घलो होहीं,</para>
  <para style="q2" vid="ECC 12:14">चाहे ओमन भलई के काम होवंय या बुरई के।<verse eid="ECC 12:14"/></para>
  <chapter eid="ECC 12"/>
</usx>
