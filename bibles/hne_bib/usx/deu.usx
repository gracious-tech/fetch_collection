<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="DEU" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  <para style="h">ब्यवस्था</para>
  <para style="toc1">ब्यवस्था-बिबरन के किताब</para>
  <para style="toc2">ब्यवस्था</para>
  <para style="toc3">ब्यव</para>
  <para style="mt1">ब्यवस्था-बिबरन</para>
  <para style="mt2">के किताब</para>
  <chapter number="1" style="c" sid="DEU 1"/>
  <para style="s1">होरेब ला छोंड़े के हुकूम</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 1:1"/>ये बात मूसा ह जम्मो इसरायल ला यरदन नदी के पूरब कोति सुन्ना जगह म कहिस—ये जगह ह पारान अऊ तोपेल, लाबान, हसेरोत अऊ दीजाहाब के बीच, सूप के सामने अराबा म हवय। <verse eid="DEU 1:1"/><verse number="2" style="v" sid="DEU 1:2"/>(सेईर पहाड़ के सड़क ले होवत होरेब पहाड़ ले कादेस-बरने<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="fq" closed="false">कादेस-बरने </char><char style="ft" closed="false">मतलब </char><char style="fqa" closed="false">मरू-भुइयां म छायावाले एक उपजाऊ भुइयां</char></note> जाय म गियारह दिन लगथे।)<verse eid="DEU 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 1:3"/>मिसर देस छोंड़े के चालीसवां साल के गियारहवां महिना के पहिले दिन, मूसा ह इसरायलीमन ला ओ जम्मो बात कहिस, जेकर हुकूम यहोवा ह ओला इसरायलीमन के बारे म दे रिहिस। <verse eid="DEU 1:3"/><verse number="4" style="v" sid="DEU 1:4"/>ये बात ओ समय के अय, जब मूसा ह हेसबोन नगर म राज-करइया अमोरीमन के राजा सीहोन ला हराईस, अऊ असतारोत नगर म राज-करइया बासान के राजा ओग ला एदरेई नगर म हराईस।<verse eid="DEU 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 1:5"/>यरदन के पूरब कोति मोआब के इलाका म, मूसा ह ये कानून ला बताय के सुरू करिस:<verse eid="DEU 1:5"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="6" style="v" sid="DEU 1:6"/>यहोवा हमर परमेसर ह होरेब पहाड़ म हमन ला कहिस, “ये पहाड़ करा रहत तुमन ला बहुंत दिन हो गे हवय। <verse eid="DEU 1:6"/><verse number="7" style="v" sid="DEU 1:7"/>एकरसेति अब डेरा ला उसालव अऊ अमोरीमन के पहाड़ी इलाका म जावव; अराबा के पास-पड़ोस के जम्मो मनखे करा, पहाड़मन म, पछिम के खाल्हे भाग म, नेगेव अऊ समुंदर के तीरे-तीर, कनानीमन के देस अऊ लबानोन म फरात महानदी तक जावव। <verse eid="DEU 1:7"/><verse number="8" style="v" sid="DEU 1:8"/>देखव, मेंह तुमन ला ये देस दे हवंव। जावव अऊ ये देस ऊपर अधिकार कर लव, जेकर बारे म यहोवा ह सपथ खाके कहे रिहिस कि ओह ये देस तुम्हर पुरखा—अब्राहम, इसहाक अऊ याकूब—अऊ ओमन के बाद ओमन के संतानमन ला दीही।”<verse eid="DEU 1:8"/></para>
  <para style="s1">अगुवामन के ठहिराय जवई</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 1:9"/>ओ समय मेंह तुमन ला कहेंव, “मेंह एके झन तुम्हर भार नइं उठा सकंव। <verse eid="DEU 1:9"/><verse number="10" style="v" sid="DEU 1:10"/>यहोवा तुम्हर परमेसर ह तुम्हर संखिया ला बढ़ाय हवय कि आज तुमन अकास के तारामन सहीं अनगिनत हो गे हवव। <verse eid="DEU 1:10"/><verse number="11" style="v" sid="DEU 1:11"/>यहोवा, तुम्हर पुरखामन के परमेसर ह तुमन ला हजारों गुना अऊ बढ़ावय अऊ अपन वायदा के मुताबिक तुमन ला आसीस देवय! <verse eid="DEU 1:11"/><verse number="12" style="v" sid="DEU 1:12"/>पर मेंह एके झन तुम्हर समस्या अऊ तुम्हर भार अऊ तुम्हर झगरा के बोझ ला कइसे उठा सकत हंव? <verse eid="DEU 1:12"/><verse number="13" style="v" sid="DEU 1:13"/>एकरसेति तुमन अपन गोत्रमन ले कुछू बुद्धिमान, समझदार अऊ आदरनीय मनखेमन ला चुनव, अऊ मेंह ओमन ला तुम्हर ऊपर मुखिया ठहिराहूं।”<verse eid="DEU 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 1:14"/>त तुमन के ये जबाब रिहिस, “तेंह जऊन काम करे के सलाह देवत हस, ओह बढ़िया ए।”<verse eid="DEU 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 1:15"/>एकरसेति मेंह तुम्हर गोत्रमन के ओ अगुवा मनखेमन ला लेंय, जेमन बुद्धिमान अऊ आदरनीय रिहिन, अऊ ओमन ला तुम्हर ऊपर अधिकारी ठहिरांय—ओमन ला हजार-हजार, सौ-सौ, पचास-पचास अऊ दस-दस के ऊपर सेनापति अऊ गोत्रमन के अधिकारी ठहिरांय। <verse eid="DEU 1:15"/><verse number="16" style="v" sid="DEU 1:16"/>अऊ ओ समय मेंह तुम्हर नियायधीसमन ला ये अधिकार देंय, “अपन मनखेमन के बीच के झगरा ला सुनव अऊ सही-सही नियाय करव, चाहे मामला ह दू इसरायलीमन के बीच होवय या मामला ह एक इसरायली अऊ तुम्हर बीच रहइया कोनो परदेसी के बीच होवय। <verse eid="DEU 1:16"/><verse number="17" style="v" sid="DEU 1:17"/>नियाय करे म पखियपात झन करव; छोटे या बड़े दूनों मनखे के बात ला एक समान सुनव। कोनो मनखे ले झन डरव, काबरकि नियाय ह परमेसर के काम ए। यदि कोनो मामला ह तुम्हर बर बहुंत कठिन ए, त ओला मोर करा लानव, अऊ मेंह ओला सुनहूं।” <verse eid="DEU 1:17"/><verse number="18" style="v" sid="DEU 1:18"/>अऊ ओ समय मेंह तुमन ला तुम्हर जम्मो काम बता दे रहेंव।<verse eid="DEU 1:18"/></para>
  <para style="s1">भेदियामन के भेजई</para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 1:19"/>तब, जइसे कि यहोवा हमर परमेसर ह हमन ला हुकूम दीस, हमन होरेब ले आघू बढ़ेंन अऊ ओ जम्मो बड़े अऊ भयानक सुन्ना जगह, जेला तुमन देखे हव, ओमा ले होवत अमोरीमन के पहाड़ी देस कोति गेंन, अऊ हमन कादेस-बरने पहुंचेंन। <verse eid="DEU 1:19"/><verse number="20" style="v" sid="DEU 1:20"/>तब मेंह तुमन ला कहेंव, “तुमन अमोरीमन के ओ पहाड़ी देस म हबर गे हव, जेला यहोवा हमर परमेसर ह हमन ला देवत हे। <verse eid="DEU 1:20"/><verse number="21" style="v" sid="DEU 1:21"/>देखव, यहोवा तुम्हर परमेसर ह ओ देस तुमन ला दे हवय। जावव अऊ ओ देस ऊपर अधिकार कर लव, जइसे कि यहोवा, तुम्हर पुरखामन के परमेसर ह तुमन ला कहे हवय। झन डरव; अऊ निरास झन होवव।”<verse eid="DEU 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 1:22"/>तब तुमन जम्मो झन मोर करा आके कहेव, “आवव हमन हमर आघू कुछू मनखेमन ला पठोवन कि ओमन ओ देस म जाके गुपत रूप से पता लगावंय अऊ वापिस आके हमन ला बतावंय कि हमन ला कोन रसता म जाना हे अऊ हमन ला कोन-कोन नगर म होके जाना पड़ही।”<verse eid="DEU 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 1:23"/>ये सलाह मोला बने लगिस; एकरसेति मेंह तुमन म ले बारह झन ला चुनेंव याने कि हर गोत्र म ले एक झन ला चुनेंव। <verse eid="DEU 1:23"/><verse number="24" style="v" sid="DEU 1:24"/>ओ बारह मनखे ऊपर पहाड़ी देस म गीन, अऊ एसकोल के घाटी म आके ओकर भेद लीन। <verse eid="DEU 1:24"/><verse number="25" style="v" sid="DEU 1:25"/>अपन संग ओ देस के कुछू फर लेके ओमन हमर करा आईन अऊ उहां के ये बात बताईन, “येह एक बने देस ए, जेला यहोवा हमर परमेसर ह हमन ला देवत हे।”<verse eid="DEU 1:25"/></para>
  <para style="s1">यहोवा के बिरूध बिदरोह</para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 1:26"/>पर तुमन के जाय के ईछा नइं रिहिस; तुमन यहोवा अपन परमेसर के हुकूम के बिरूध बिदरोह करेव। <verse eid="DEU 1:26"/><verse number="27" style="v" sid="DEU 1:27"/>अपन तम्बूमन म तुमन बड़बड़ावत कहेव, “यहोवा ह हमन ले घिन करथे; एकरसेति ओह हमन ला मिसर देस ले निकाल लानिस कि हमन ला अमोरीमन के हांथ म सऊंपके नास कर दे। <verse eid="DEU 1:27"/><verse number="28" style="v" sid="DEU 1:28"/>हमन कहां जावन? हमर भाईमन ये कहिके हमन ला बहुंत डरा दे हवंय, ‘उहां के मनखेमन हमर ले बलवान अऊ हमर ले ऊंच हवंय; उहां के सहरमन बड़े-बड़े अऊ ओमन के दीवारमन अकास तक ऊंचहा हवंय। अऊ त अऊ हमन उहां अनाकीमन ला घलो देखेंन।’ ”<verse eid="DEU 1:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="DEU 1:29"/>तब मेंह तुमन ला कहेंव, “भयभीत झन होवव; ओमन ले झन डरव। <verse eid="DEU 1:29"/><verse number="30" style="v" sid="DEU 1:30"/>यहोवा तुम्हर परमेसर, जऊन ह तुम्हर आघू जावत हे, ओह तुम्हर बर लड़ही, जइसे कि तुम्हर देखत म मिसर देस म तुम्हर बर करिस, <verse eid="DEU 1:30"/><verse number="31" style="v" sid="DEU 1:31"/>अऊ सुन्ना जगह म घलो करिस। उहां तुमन देखेव कि कइसे यहोवा तुम्हर परमेसर ह तुमन ला लेके चलिस, जइसे कोनो ददा ह अपन बेटा ला लेके चलथे, वइसे ओह तुमन ला पूरा रसता म लेके चलिस अऊ ये जगह म तुमन ला पहुंचाईस।”<verse eid="DEU 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="DEU 1:32"/>येकर बावजूद, तुमन यहोवा अपन परमेसर ऊपर भरोसा नइं करेव, <verse eid="DEU 1:32"/><verse number="33" style="v" sid="DEU 1:33"/>जऊन ह तुम्हर यातरा म रथिया आगी म अऊ दिनमान बादर म होके तुम्हर आघू-आघू चलिस, ताकि ओह तुम्हर डेरा डाले बर जगह खोजय अऊ तुमन ला ओ रसता देखावय, जेमा तुमन ला जाना चाही।<verse eid="DEU 1:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="DEU 1:34"/>जब यहोवा ह तुम्हर बात ला सुनिस, त ओह गुस्सा होईस अऊ सपथ खाके कहिस: <verse eid="DEU 1:34"/><verse number="35" style="v" sid="DEU 1:35"/>“ये दुस्ट पीढ़ी के कोनो भी मनखे ओ बने देस ला देख नइं सकहीं, जेला मेंह येमन के पुरखामन ला देय के सपथ खाय रहेंव; <verse eid="DEU 1:35"/><verse number="36" style="v" sid="DEU 1:36"/>यपुन्ने के बेटा कालेब ओ देस ला देखही, अऊ मेंह ओला अऊ ओकर संतानमन ला ओ देस दूहूं, जेमा ओकर पांव पड़े रिहिस, काबरकि ओह पूरा मन से यहोवा के पाछू चलिस।”<verse eid="DEU 1:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="DEU 1:37"/>तुम्हर कारन यहोवा ह मोर ऊपर घलो गुस्सा होईस अऊ कहिस, “तेंह घलो ओ देस म नइं जा सकबे। <verse eid="DEU 1:37"/><verse number="38" style="v" sid="DEU 1:38"/>पर तोर सहायक नून के बेटा यहोसू ह ओ देस म जाही। तें ओला उत्साहित कर, काबरकि ओह ओ देस ऊपर अधिकार करे बर इसरायल के अगुवई करही। <verse eid="DEU 1:38"/><verse number="39" style="v" sid="DEU 1:39"/>अऊ छोटे लइकामन जेमन के बारे म तुमन कहे हव कि ओमन बंधुवई म चले जाहीं, तुम्हर लइकामन, जेमन ला अभी सही-गलत के गियान नइं ए—ओमन ओ देस म जाहीं। मेंह ओ देस ओमन ला दूहूं अऊ ओमन ओकर ऊपर अधिकार करहीं। <verse eid="DEU 1:39"/><verse number="40" style="v" sid="DEU 1:40"/>पर जहां तक तुम्हर सवाल ए, तुमन मुड़के लाल-समुंदर के रसता ले सुन्ना जगह कोति जावव।”<verse eid="DEU 1:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="DEU 1:41"/>तब तुम्हर ये जबाब रिहिस, “हमन यहोवा के बिरूध म पाप करे हन। हमन जाबो अऊ लड़बो, जइसे कि यहोवा हमर परमेसर ह हमन ला हुकूम दे हवय।” तब तुमन म ले हर एक जन अपन-अपन हथियार ला धरेव, ये सोचके कि ओ पहाड़ी देस म जवई ह सरल ए।<verse eid="DEU 1:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="DEU 1:42"/>पर यहोवा ह मोला कहिस, “ओमन ला कह, ‘तुमन ऊपर कोति जाके झन लड़व, काबरकि मेंह तुम्हर संग नइं रहंव। तुमन अपन बईरीमन ले हार जाहू।’ ”<verse eid="DEU 1:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="DEU 1:43"/>मेंह ये बात तुमन ला कहेंव, पर तुमन नइं मानेव। तुमन यहोवा के हुकूम के बिरूध चलेव अऊ अपन घमंड म आके ओ पहाड़ी देस के ऊपर कोति आघू बढ़ेव। <verse eid="DEU 1:43"/><verse number="44" style="v" sid="DEU 1:44"/>ओ अमोरी, जेमन ओ पहाड़ी देस म रहत रिहिन, ओमन तुम्हर सामना करिन; अऊ तुमन ला मधुमक्खीमन के झुंड सहीं भगाईन अऊ तुमन ला सेईर ले लेके होरमा सहर तक मारत चले गीन। <verse eid="DEU 1:44"/><verse number="45" style="v" sid="DEU 1:45"/>तब तुमन वापिस आके यहोवा के आघू म रोये लगेव; पर ओह तुम्हर रोवई कोति धियान नइं दीस अऊ तुम्हर बात ला नइं सुनिस। <verse eid="DEU 1:45"/><verse number="46" style="v" sid="DEU 1:46"/>अऊ ये किसम ले तुमन कादेस म बहुंत दिन तक पड़े रहेव—उहां तुम्हर पूरा समय अइसने ही बीतिस।<verse eid="DEU 1:46"/></para>
  <chapter eid="DEU 1"/>
  <chapter number="2" style="c" sid="DEU 2"/>
  <para style="s1">सुन्ना जगह म भटकई</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 2:1"/>तब यहोवा ह जइसे मोला कहे रिहिस, ओकरे मुताबिक हमन वापिस मुड़ेंन अऊ लाल-समुंदर के रसता ले होवत सुन्ना जगह कोति गेंन। हमन बहुंत समय तक सेईर के पहाड़ी देस के आसपास चलते रहेंन।<verse eid="DEU 2:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="DEU 2:2"/>तब यहोवा ह मोला कहिस, <verse eid="DEU 2:2"/><verse number="3" style="v" sid="DEU 2:3"/>“तुमन ला ये पहाड़ी देस के आसपास चलत बहुंत समय हो गे हे; अब मुड़के उत्तर कोति चलव। <verse eid="DEU 2:3"/><verse number="4" style="v" sid="DEU 2:4"/>अऊ तें मनखेमन ला ये हुकूम दे: ‘तुमन सेईर म रहइया अपन रिस्तेदार, एसाव के संतानमन के इलाका म ले होके जानेवाला हव। ओमन तुमन ले डरहीं, पर तुमन बहुंत सावधान रहव। <verse eid="DEU 2:4"/><verse number="5" style="v" sid="DEU 2:5"/>ओमन ला लड़ई बर झन उकसावव, काबरकि मेंह तुमन ला ओमन के कोनो भुइयां नइं दंव, अऊ त अऊ तुमन ला अपन पांव धरे के जगह तक नइं दंव। मेंह एसाव ला सेईर के पहाड़ी देस ओकर खुद के संपत्ति के रूप म दे हवंव। <verse eid="DEU 2:5"/><verse number="6" style="v" sid="DEU 2:6"/>तुमन जऊन खाना खाहू अऊ पानी पीहू, ओकर बर तुमन ओमन ला चांदी देके ओ जेवन अऊ पानी के दाम चुकावव।’ ”<verse eid="DEU 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 2:7"/>यहोवा तुम्हर परमेसर ह तुम्हर जम्मो काम म आसीस दे हवय। ओह ये बड़े सुन्ना जगह म तुम्हर यातरा के दौरान तुम्हर देखरेख करे हवय। ये चालीस साल तक यहोवा तुम्हर परमेसर ह तुम्हर संगे-संग रहे हवय, अऊ तुमन ला कोनो चीज के कमी नइं होईस।<verse eid="DEU 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 2:8"/>अऊ हमन सेईर म रहइया हमर रिस्तेदार, एसाव के संतानमन के इलाका ले हटके गेंन। हमन अराबा के सड़क ले मुड़ेंन, जऊन ह एलात अऊ एसियोन-गेबेर म ले आथे, अऊ हमन मोआब के सुन्ना जगह के सड़क म ले होके गेंन।<verse eid="DEU 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 2:9"/>तब यहोवा ह मोला कहिस, “मोआबीमन ला तंग झन करव या ओमन ला लड़ई बर झन उकसावव, काबरकि मेंह ओमन के देस म के कोनो भाग तुमन ला नइं दंव। मेंह लूत के संतानमन ला आर के इलाका ओमन के अधिकार म देय दे हंव।”<verse eid="DEU 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 2:10"/>(एमीमन उहां रहे के आदि रिहिन—ये मनखेमन बलवान अऊ संखिया म बहुंत रिहिन, अऊ येमन अनाकीमन सहीं ऊंच घलो रिहिन। <verse eid="DEU 2:10"/><verse number="11" style="v" sid="DEU 2:11"/>अनाकीमन सहीं, ओमन ला घलो रपाई<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="fq" closed="false">रपाई </char><char style="ft" closed="false">बड़े डीलडौलवाला मनखे; </char><char style="fqa" closed="false">दानव</char></note> माने जावत रिहिस, पर मोआबीमन ओमन ला एमी कहंय। <verse eid="DEU 2:11"/><verse number="12" style="v" sid="DEU 2:12"/>सेईर म होरीमन रहे के आदि रिहिन, पर एसाव के संतानमन ओमन ला भगा दीन। ओमन होरीमन ला अपन आघू ले खतम कर दीन अऊ ओमन के जगह म बस गीन, जइसे कि इसरायलीमन ओ देस म बस गीन, जेला यहोवा ह ओमन के अधिकार म दे दीस।)<verse eid="DEU 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 2:13"/>अऊ यहोवा ह कहिस, “अब तुमन उठव अऊ जेरेद घाटी के ओ पार जावव।” तब हमन घाटी के ओ पार गेंन।<verse eid="DEU 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 2:14"/>कादेस-बरने ला छोंड़के आय के बेरा ले लेके जेरेद घाटी ला पार करत तक अड़तीस साल हो गे रिहिस। ये बीच म ओ पीढ़ी के जम्मो योद्धामन सिविर म नास हो गीन, जइसे कि यहोवा ह ओमन ले सपथ खाय रिहिस। <verse eid="DEU 2:14"/><verse number="15" style="v" sid="DEU 2:15"/>जब तक यहोवा ह ओमन ला सिविर ले पूरा खतम नइं कर दीस, तब तक ओकर हांथ ह ओमन के बिरूध रिहिस।<verse eid="DEU 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 2:16"/>जब आखिरी म मनखेमन के बीच म ले जम्मो योद्धामन मर गीन, <verse eid="DEU 2:16"/><verse number="17" style="v" sid="DEU 2:17"/>तब यहोवा ह मोला कहिस, <verse eid="DEU 2:17"/><verse number="18" style="v" sid="DEU 2:18"/>“आज तेंह आर नगर म मोआब के इलाका ले होके जाबे। <verse eid="DEU 2:18"/><verse number="19" style="v" sid="DEU 2:19"/>जब तेंह अमोनीमन करा आबे, त ओमन ला तंग झन करबे या ओमन ला लड़ई करे बर झन उकसाबे, काबरकि मेंह ओमन के देस के कोनो भाग ला तोर अधिकार म नइं दंव। मेंह ओला लूत के संतानमन के अधिकार म कर दे हंव।”<verse eid="DEU 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 2:20"/>(ओला घलो रपाईमन के एक देस समझे जावत रिहिस, जऊन मन उहां रहत रिहिन; पर अमोनीमन ओमन ला जमजुम्मी कहंय। <verse eid="DEU 2:20"/><verse number="21" style="v" sid="DEU 2:21"/>ओमन बलवान अऊ संखिया म बहुंत, अऊ अनाकीमन सहीं ऊंच रिहिन। यहोवा ह अमोनीमन के आघू ले ओमन ला नास कर दीस; अमोनीमन ओमन ला भगा दीन अऊ ओमन के जगह म बस गीन। <verse eid="DEU 2:21"/><verse number="22" style="v" sid="DEU 2:22"/>यहोवा ह वइसने ही एसाव के संतानमन बर करिस, जऊन मन सेईर म रहत रिहिन; ओह होरीमन ला ओमन के आघू ले नास कर दीस। एसाव के संतानमन ओमन ला भगा दीन अऊ ओमन आज तक होरीमन के जगह म रहत हवंय। <verse eid="DEU 2:22"/><verse number="23" style="v" sid="DEU 2:23"/>जहां तक अव्वीमन के बात ए, जऊन मन गाजा सहर तक के गांवमन म रहत रिहिन, ओमन ला कपतोरीमन कपतोर<note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="ft" closed="false">याने कि, क्रेते</char></note> ले आके नास कर दीन अऊ ओमन के जगह म बस गीन।)<verse eid="DEU 2:23"/></para>
  <para style="s1">हेसबोन के राजा सीहोन के हार</para>
  <para style="p">
    <verse number="24" style="v" sid="DEU 2:24"/>“अब आघू बढ़व अऊ अरनोन घाटी के ओ पार चलव। देख, मेंह हेसबोन के राजा, अमोरी सीहोन अऊ ओकर देस ला तोर हांथ म कर दे हंव। ओला अधिकार म लेय के सुरू कर दव अऊ ओला लड़ई म लगाय रखव। <verse eid="DEU 2:24"/><verse number="25" style="v" sid="DEU 2:25"/>आज के दिन ले ही मेंह धरती के जम्मो देस म तोर आतंक अऊ डर पईदा कर दूहूं। ओमन तोर बारे म सुनहीं अऊ तोर कारन ओमन कांपहीं अऊ ओमन ला तकलीफ होही।”<verse eid="DEU 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 2:26"/>कदेमोत के सुन्ना जगह ले मेंह हेसबोन नगर के राजा सीहोन करा संदेसियामन के दुवारा ये कहिके सांति संदेस पठोंय, <verse eid="DEU 2:26"/><verse number="27" style="v" sid="DEU 2:27"/>“हमन ला तोर देस म ले होके जावन दे। हमन मुख्य सड़क म ही रहिबो; हमन न तो जेवनी अंग मुड़बो, न ही डेरी। <verse eid="DEU 2:27"/><verse number="28" style="v" sid="DEU 2:28"/>चांदी के रूप म हमन ले दाम लेके हमन ला खाय बर जेवन अऊ पीये बर पानी दे। हमन ला सिरिप इहां ले रेंगत जावन दे— <verse eid="DEU 2:28"/><verse number="29" style="v" sid="DEU 2:29"/>जइसे कि सेईर म रहइया एसाव के संतान, अऊ आर म रहइया मोआबीमन हमर बर करिन, जब तक कि हमन यरदन ला पार करके ओ देस म नइं हबर जावन, जेला यहोवा हमर परमेसर ह हमन ला देवत हे।” <verse eid="DEU 2:29"/><verse number="30" style="v" sid="DEU 2:30"/>पर हेसबोन के राजा सीहोन ह इसरायल ला अपन देस म ले होके जावन नइं दीस। काबरकि यहोवा तुम्हर परमेसर ह ओकर मन ला कठोर अऊ ओला जिद्दी बना दे रिहिस, ताकि ओह ओला तुम्हर हांथ म कर दे, जइसे कि अब ओह करे हवय।<verse eid="DEU 2:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="DEU 2:31"/>यहोवा ह मोला कहिस, “देख, मेंह सीहोन अऊ ओकर देस ला तोर अधीन करे के सुरू कर दे हंव। अब तेंह ओकर देस ऊपर अधिकार अऊ ओला अपन अधीन करे के सुरू कर दे।”<verse eid="DEU 2:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="DEU 2:32"/>जब सीहोन अऊ ओकर जम्मो सेना लड़ई म हमर सामना करे बर यहस नांव के नगर म आईन, <verse eid="DEU 2:32"/><verse number="33" style="v" sid="DEU 2:33"/>त यहोवा ह ओला हमर अधीन कर दीस अऊ हमन ओला ओकर बेटामन अऊ ओकर पूरा सेना सहित मार डारेंन। <verse eid="DEU 2:33"/><verse number="34" style="v" sid="DEU 2:34"/>ओ समय हमन ओकर जम्मो नगरमन ला ले लेंन अऊ ओमन ला पूरा नास कर देंन—जम्मो पुरूस, माईलोगन अऊ लइकामन ला। हमन एको झन ला घलो जीयत नइं छोड़ेंन। <verse eid="DEU 2:34"/><verse number="35" style="v" sid="DEU 2:35"/>पर पसु अऊ नगरमन ले लूटे सामान ला हमन अपन बर ले लेंन। <verse eid="DEU 2:35"/><verse number="36" style="v" sid="DEU 2:36"/>अरनोन घाटी के तीर म अरोएर ले, अऊ घाटी म नगर ले लेके गिलाद के इलाका तक कोनो भी नगर हमर आघू म टिक नइं सकिन। यहोवा हमर परमेसर ह ओ जम्मो ला हमन ला दे दीस। <verse eid="DEU 2:36"/><verse number="37" style="v" sid="DEU 2:37"/>पर यहोवा हमर परमेसर के दिये हुकूम के मुताबिक, तुमन न तो अमोनीमन के देस, अऊ न ही यब्बोक नदी के तीरे-तीर के देस अऊ पहाड़ी कोति के नगरमन के आसपास के इलाका म गेव।<verse eid="DEU 2:37"/></para>
  <chapter eid="DEU 2"/>
  <chapter number="3" style="c" sid="DEU 3"/>
  <para style="s1">बासान के राजा ओग के हार</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 3:1"/>ओकर बाद हमन मुड़के सड़क म होवत बासान कोति गेंन, अऊ बासान के राजा ओग अपन पूरा सेना के संग हमर ले लड़ई करे बर एदरेई नगर करा आईस। <verse eid="DEU 3:1"/><verse number="2" style="v" sid="DEU 3:2"/>यहोवा ह मोला कहिस, “ओकर ले झन डर, काबरकि मेंह ओला अऊ ओकर पूरा सेना के संग ओकर देस ला तोर हांथ म कर देवत हंव। ओकर संग वइसने ही करबे, जइसने तेंह अमोरीमन के राजा सीहोन के संग करे रहय, जऊन ह हेसबोन म राज करत रिहिस।”<verse eid="DEU 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 3:3"/>ये किसम ले यहोवा हमर परमेसर ह बासान के राजा ओग अऊ ओकर जम्मो सेना ला हमर हांथ म कर दीस। हमन ओमन ला मार डारेंन अऊ एको झन ला घलो नइं छोड़ेंन। <verse eid="DEU 3:3"/><verse number="4" style="v" sid="DEU 3:4"/>ओ समय हमन ओकर जम्मो सहरमन ला ले लेंन। हमन ओमन के साठ ठन सहरमन ले जम्मो सहरमन ला ले लेंन—याने कि अरगोब के पूरा इलाका, जऊन ह बासान म ओग के राज म रिहिस। <verse eid="DEU 3:4"/><verse number="5" style="v" sid="DEU 3:5"/>ये जम्मो सहरमन ऊंच-ऊंच दीवार के संग गढ़वाले रिहिन, जेमा कपाट अऊ बाड़ामन लगे रिहिन, अऊ उहां बिगर दीवार के कतको बड़े-बड़े गांवमन घलो रिहिन। <verse eid="DEU 3:5"/><verse number="6" style="v" sid="DEU 3:6"/>हमन ओमन ला पूरा नास कर देंन, जइसे कि हमन हेसबोन के राजा सीहोन के संग करे रहेंन याने कि हर एक सहर के पुरूस, माईलोगन अऊ लइकामन ला नास कर देंन। <verse eid="DEU 3:6"/><verse number="7" style="v" sid="DEU 3:7"/>पर ओमन के सहर के जम्मो पसु अऊ लूट के सामान ला हमन अपन बर ले लेंन।<verse eid="DEU 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 3:8"/>ये किसम ले ओ समय हमन अमोरीमन के ये दूनों राजामन ले यरदन के पूरब के इलाका अरनोन घाटी ले लेके हेरमोन पहाड़ तक ले लेंन। <verse eid="DEU 3:8"/><verse number="9" style="v" sid="DEU 3:9"/>(हेरमोन ला सीदोनीमन सिरयोन, अऊ अमोरीमन सनीर कहिथें।) <verse eid="DEU 3:9"/><verse number="10" style="v" sid="DEU 3:10"/>हमन पठार के जम्मो नगर, अऊ पूरा गिलाद के इलाका अऊ बासान म ओग राज के नगर सलका अऊ एदरेई तक पूरा बासान ला ले लेंन। <verse eid="DEU 3:10"/><verse number="11" style="v" sid="DEU 3:11"/>(रपाईमन म बासान के राजा ओग ह सबले आखिरी रिहिस। ओकर पलंग ह लोहा ले सजे रिहिस अऊ येह नौ क्यूबीट लम्बा अऊ चार क्यूबीट चौड़ा रिहिस।<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="ft" closed="false">लगभग 4 मीटर लम्बा अऊ 1.8 मीटर चौड़ा</char></note> येह अमोनीमन के रब्बा नगर म अभी तक हवय।)<verse eid="DEU 3:11"/></para>
  <para style="s1">देस के बांटा</para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 3:12"/>ओ देस, जेला हमन ओ समय अपन अधिकार म लेंन, ओमा के अरनोन घाटी के तीरे-तीर अरोएर के उत्तर के इलाका, गिलाद के आधा पहाड़ी इलाका अऊ येकर नगरमन ला मेंह रूबेनी अऊ गादीमन ला दे देंव। <verse eid="DEU 3:12"/><verse number="13" style="v" sid="DEU 3:13"/>गिलाद के बचे भाग अऊ पूरा बासान याने कि ओग के राज ला मेंह मनस्से के आधा गोत्र के मनखेमन ला दे देंव। (बासान म अरगोब के पूरा इलाका ह रपाईमन के देस के रूप म जाने जाथे। <verse eid="DEU 3:13"/><verse number="14" style="v" sid="DEU 3:14"/>मनस्से के एक संतान याईर ह गसूरी अऊ माकातीमन के सीमना तक पूरा अरगोब के इलाका ला लीस; येला ओकर नांव दिये गीस, एकरसेति आज तक बासान ला हव्वोत-याईर<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">याईर के बसाहट</char></note> कहे जाथे।) <verse eid="DEU 3:14"/><verse number="15" style="v" sid="DEU 3:15"/>अऊ मेंह माकीर ला गिलाद दे देंव। <verse eid="DEU 3:15"/><verse number="16" style="v" sid="DEU 3:16"/>पर मेंह रूबेनी अऊ गादीमन ला ओ इलाका देंव, जऊन ह गिलाद ले लेके खाल्हे अरनोन घाटी (घाटी के मांझा भाग ह सीमना अय) अऊ यब्बोक नदी के बाहिर तक फईले हवय, जऊन ह कि अमोनीमन के सीमना अय। <verse eid="DEU 3:16"/><verse number="17" style="v" sid="DEU 3:17"/>येकर पछिमी सीमना ह अराबा म यरदन रिहिस, जऊन ह किन्नेरेत ले लेके पिसगा के ढलान के खाल्हे अराबा के समुंदर (याने कि मिरतू सागर) तक रिहिस।<verse eid="DEU 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 3:18"/>ओ समय मेंह तुमन ला हुकूम देंव: “यहोवा तुम्हर परमेसर ह तुमन ला ये देस अपन अधिकार म करे बर दे हवय। पर तुम्हर जम्मो योग्य मनखेमन लड़ई बर हथियार धरके आने इसरायलीमन ले आघू ओ पार जावंय। <verse eid="DEU 3:18"/><verse number="19" style="v" sid="DEU 3:19"/>पर तुम्हर घरवाली, तुम्हर लइका अऊ तुम्हर पसुमन (मेंह जानत हंव कि तुम्हर करा बहुंत पसु हवंय) मोर दुवारा दिये गय नगरमन म तब तक रूके रहंय, <verse eid="DEU 3:19"/><verse number="20" style="v" sid="DEU 3:20"/>जब तक कि यहोवा ह तुम्हर संगी इसरायलीमन ला अराम नइं देय दे, जइसे कि ओह तुमन ला देय हवय, अऊ ओमन घलो ओ देस ऊपर अधिकार नइं कर लेवंय, जेला यहोवा तुम्हर परमेसर ह ओमन ला यरदन के ओ पार देवत हे। ओकर बाद, तुमन म ले हर एक जन अपन अधिकार म लिये गय ओ जगह म जावव, जेला मेंह तुमन ला दे हवंव।”<verse eid="DEU 3:20"/></para>
  <para style="s1">मूसा ला यरदन के ओ पार जाय बर मना करई</para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 3:21"/>ओ समय मेंह यहोसू ला हुकूम देंव: “तेंह अपन आंखी ले ओ जम्मो चीज ला देखे हस कि यहोवा तोर परमेसर ह ये दूनों राजामन के संग का करिस। यहोवा ह उहां के जम्मो राजमन के संग वइसने ही करही, जिहां तेंह जावत हस। <verse eid="DEU 3:21"/><verse number="22" style="v" sid="DEU 3:22"/>ओमन ले झन डरबे; यहोवा तोर परमेसर ह खुद तोर बर लड़ही।”<verse eid="DEU 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 3:23"/>ओ समय मेंह यहोवा ले बिनती करेंव: <verse eid="DEU 3:23"/><verse number="24" style="v" sid="DEU 3:24"/>“हे परमपरधान यहोवा, तेंह अपन सेवक ला अपन महानता अऊ अपन बलवान हांथ देखाय सुरू करे हस। स्वरग अऊ धरती म अइसे कोन देवता हे, जेह तोर सहीं काम अऊ सक्तिसाली काम कर सकथे? <verse eid="DEU 3:24"/><verse number="25" style="v" sid="DEU 3:25"/>मोला यरदन के ओ पार जाके ओ सुघर पहाड़ी देस अऊ लबानोन ला देखन दे।”<verse eid="DEU 3:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 3:26"/>पर तुम्हर कारन यहोवा ह मोर ऊपर गुस्सा होईस अऊ मोर बात ला नइं सुनिस। यहोवा ह कहिस, “बहुंत हो गीस, येकर बारे म तेंह मोर ले अऊ झन गोठिया। <verse eid="DEU 3:26"/><verse number="27" style="v" sid="DEU 3:27"/>पिसगा पहाड़ के चोटी म जा अऊ पूरब, पछिम, उत्तर, दक्खिन चारों कोति देख। ओ देस ला अपन आंखी ले देख ले, काबरकि तेंह ये यरदन के ओ पार नइं जावत हस। <verse eid="DEU 3:27"/><verse number="28" style="v" sid="DEU 3:28"/>पर यहोसू ला अधिकार दे, अऊ ओला उत्साहित अऊ मजबूत कर, काबरकि ओ पार जाय म, ओह ये मनखेमन के अगुवई करही अऊ जऊन देस ला तेंह देखबे, ओकर ऊपर ओह ये मनखेमन ला अधिकार देवाही।” <verse eid="DEU 3:28"/><verse number="29" style="v" sid="DEU 3:29"/>तब हमन ओ घाटी म रूक गेंन, जऊन ह बेत-पोर के लकठा म रिहिस।<verse eid="DEU 3:29"/></para>
  <chapter eid="DEU 3"/>
  <chapter number="4" style="c" sid="DEU 4"/>
  <para style="s1">हुकूम माने के आदेस देवई</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 4:1"/>अब हे इसरायल, ओ बिधि अऊ कानूनमन ला सुनव, जेला मेंह तुमन ला सिखानेवाला हंव। ओमन के पालन करव ताकि तुमन जीयत रहव अऊ ओ देस म जाके ओकर ऊपर अधिकार कर सकव, जेला यहोवा, तुम्हर पुरखामन के परमेसर ह तुमन ला देवत हे। <verse eid="DEU 4:1"/><verse number="2" style="v" sid="DEU 4:2"/>जऊन हुकूम मेंह तुमन ला देवत हंव, ओमा न कुछू जोड़व अऊ न कुछू घटावव, पर यहोवा तुम्हर परमेसर के ओ हुकूम ला मानव, जेला मेंह तुमन ला देवत हंव।<verse eid="DEU 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 4:3"/>तुमन अपन आंखी ले देखे हव कि यहोवा ह बाल-पेओर करा का करिस। यहोवा तुम्हर परमेसर ह तुम्हर बीच ले ओ जम्मो मनखेमन ला नास कर दीस, जऊन मन बाल-पेओर देवता के पाछू चलत रिहिन, <verse eid="DEU 4:3"/><verse number="4" style="v" sid="DEU 4:4"/>पर तुमन जम्मो, जऊन मन यहोवा अपन परमेसर के संग मजबूती से बने रहेव, ओ जम्मो आज भी जीयत हव।<verse eid="DEU 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 4:5"/>देखव, यहोवा मोर परमेसर के दिये हुकूम के मुताबिक मेंह तुमन ला बिधि अऊ कानून सिखाय हंव, ताकि तुमन ओ देस म येमन के पालन करव, जिहां तुमन ओकर ऊपर अधिकार करे बर जावत हव। <verse eid="DEU 4:5"/><verse number="6" style="v" sid="DEU 4:6"/>धियान लगाके येमन के पालन करव, काबरकि येह ओ आने जाति के मनखेमन ला तुम्हर बुद्धि अऊ समझ देखाही, जऊन मन ये जम्मो बिधिमन के बारे म सुनहीं अऊ ओमन कहिहीं, “सही म ये महान जाति के मनखेमन एक बुद्धिमान अऊ समझवाले मनखे अंय।” <verse eid="DEU 4:6"/><verse number="7" style="v" sid="DEU 4:7"/>कोन अइसने बड़े जाति ए, जेकर देवता ओकर अइसे लकठा म रहिथे, जइसे यहोवा हमर परमेसर हमर लकठा म रहिथे, जब भी हमन ओकर ले पराथना करथन? <verse eid="DEU 4:7"/><verse number="8" style="v" sid="DEU 4:8"/>अऊ कोन अइसने बड़े जाति ए, जेकर करा अइसे धरमी बिधि अऊ कानून हवंय, जइसे कि ये कानूनमन, जेला मेंह आज तुम्हर आघू म रखत हंव?<verse eid="DEU 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 4:9"/>सिरिप तुमन सावधान रहव, अऊ अपन म बहुंत सचेत रहव, ताकि तुम्हर आंखीमन जऊन चीजमन ला देखे हवंय, ओला तुमन झन भूलव या ओ चीजमन तुम्हर मन ले झन हटंय, जब तक कि तुमन जीयत हव। ये बातमन ला अपन लइका अऊ नाती-पोतामन ला सिखावव। <verse eid="DEU 4:9"/><verse number="10" style="v" sid="DEU 4:10"/>ओ दिन ला सुरता करव, जब तुमन होरेब म यहोवा अपन परमेसर के आघू म खड़े रहेव, अऊ ओह मोला कहिस, “मनखेमन ला मोर बात सुने बर मोर आघू म इकट्ठा कर, ताकि जब तक ओमन देस म जीयत रहंय, ओमन मोर आदर करई सीखंय अऊ ये बारे म अपन लइकामन ला घलो सिखावंय।” <verse eid="DEU 4:10"/><verse number="11" style="v" sid="DEU 4:11"/>तुमन लकठा म आके पहाड़ के खाल्हे म ठाढ़ हो गेव अऊ ओ पहाड़ ह आगी ले धधकत रहय; आगी के जुवाला ह करिया बादर अऊ घोर अंधियार के संग अकास तक हबरत रहय। <verse eid="DEU 4:11"/><verse number="12" style="v" sid="DEU 4:12"/>तब यहोवा ह आगी म ले तुम्हर ले गोठियाईस। तुमन सबद के अवाज तो सुनेव, पर तुमन ला कोनो दिखाई नइं दीस; उहां सिरिप एक अवाज रिहिस। <verse eid="DEU 4:12"/><verse number="13" style="v" sid="DEU 4:13"/>ओह तुमन ला अपन करार, दस ठन हुकूम ला बताईस अऊ ओह तुमन ला ये हुकूममन के पालन करे बर कहिस अऊ ओमन ला पथरा के दू ठन पटिया म लिख दीस। <verse eid="DEU 4:13"/><verse number="14" style="v" sid="DEU 4:14"/>अऊ यहोवा ह ओ समय मोला निरदेस दीस कि मेंह तुमन ला ओ बिधि अऊ कानूनमन ला सिखावंव, जेकर पालन तुमन ओ देस म करव, जेला अपन अधिकार म करे बर तुमन यरदन के ओ पार जावत हव।<verse eid="DEU 4:14"/></para>
  <para style="s1">मूरती-पूजा करे के मनाही</para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 4:15"/>तुमन ला ओ दिन कोनो किसम के सरूप दिखाई नइं दीस, जऊन दिन यहोवा ह तुमन ले होरेब पहाड़ करा आगी म ले गोठियाईस। एकरसेति तुमन बहुंत सचेत रहव, <verse eid="DEU 4:15"/><verse number="16" style="v" sid="DEU 4:16"/>ताकि तुमन भ्रस्ट होके अपन बर कोनो भी किसम के मूरती या कोनो चीज के नमूना झन बनावव, चाहे ओह कोनो पुरूस या माईलोगन के सहीं रूप होवय, <verse eid="DEU 4:16"/><verse number="17" style="v" sid="DEU 4:17"/>या धरती म कोनो पसु या अकास म उड़इया कोनो चिरई सहीं होवय, <verse eid="DEU 4:17"/><verse number="18" style="v" sid="DEU 4:18"/>या भुइयां म रेंगइया कोनो जीव सहीं या पानी के भीतर कोनो मछरी सहीं होवय। <verse eid="DEU 4:18"/><verse number="19" style="v" sid="DEU 4:19"/>अऊ जब तुमन अकास कोति नजर उठाके सूरज, चंदा अऊ तारा याने कि जम्मो अकास के चीजमन ला देखव, त बहकके तुमन ओमन के दंडवत अऊ अराधना झन करव; ये चीजमन ला यहोवा तुम्हर परमेसर ह धरती के जम्मो जाति के मनखेमन ला ओमन के भाग के रूप म दे हवय। <verse eid="DEU 4:19"/><verse number="20" style="v" sid="DEU 4:20"/>पर जहां तक तुम्हर सवाल ए, यहोवा ह तुमन ला लेके लोहा पिघलइया भट्ठी ले निकाले सहीं मिसर देस ले बाहिर निकालिस, ताकि तुमन ओकर उत्तराधिकार के मनखे हो जावव, जइसे कि अब तुमन अव घलो।<verse eid="DEU 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 4:21"/>यहोवा ह तुम्हर कारन मोर ऊपर गुस्सा होईस अऊ सपथ खाके कहिस कि मेंह यरदन नदी के पार ओ बने देस म नइं जा सकंव, जेला यहोवा तुम्हर परमेसर ह तुमन ला तुम्हर उत्तराधिकार के रूप म देवत हे। <verse eid="DEU 4:21"/><verse number="22" style="v" sid="DEU 4:22"/>मेंह इही देस म मर जाहूं; मेंह यरदन के ओ पार नइं जा सकंव; पर तुमन ओ पार जाके ओ बने देस ऊपर अधिकार करहू। <verse eid="DEU 4:22"/><verse number="23" style="v" sid="DEU 4:23"/>एकरसेति धियान रहय कि तुमन यहोवा तुम्हर परमेसर के ओ करार ला झन भूलव, जेला ओह तुम्हर संग करे हवय; अपन बर कोनो भी चीज के कोनो मूरती झन बनावव, जेला यहोवा तुम्हर परमेसर ह मना करे हवय। <verse eid="DEU 4:23"/><verse number="24" style="v" sid="DEU 4:24"/>काबरकि यहोवा तुम्हर परमेसर ह एक भसम करइया आगी, एक जलन रखइया परमेसर अय।<verse eid="DEU 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 4:25"/>जब तुम्हर लोग-लइका अऊ नाती-पोता हो जाहीं अऊ तुम्हर उहां लम्बा समय तक रहे के बाद—यदि तुमन भ्रस्ट होके कोनो किसम के मूरती बनाथव अऊ ये किसम ले यहोवा तुम्हर परमेसर के नजर म खराप काम करके ओकर गुस्सा ला भड़काथव, <verse eid="DEU 4:25"/><verse number="26" style="v" sid="DEU 4:26"/>त आज मेंह अकास अऊ धरती ला तुम्हर बिरूध गवाह रखके कहत हंव कि तुमन ओ देस ले जल्दी नास हो जाहू, जेला तुमन अपन अधिकार म लेय बर यरदन के ओ पार जावत हव। तुमन उहां लम्बा समय तक जिंदा नइं रहे पाहू, पर खचित तुमन नास हो जाहू। <verse eid="DEU 4:26"/><verse number="27" style="v" sid="DEU 4:27"/>यहोवा ह तुमन ला मनखेमन के बीच म तितिर-बितिर कर दीही, अऊ यहोवा ह तुमन ला जऊन जातिमन के बीच म भगा दीही, उहां तुमन थोरकन ही बचे रहिहू। <verse eid="DEU 4:27"/><verse number="28" style="v" sid="DEU 4:28"/>उहां तुमन मनखे के बनाय ओ लकड़ी अऊ पथरा के देवतामन के अराधना करहू, जेमन न तो देख सकंय, न सुन सकंय, न खा सकंय अऊ न ही सुंघ सकंय। <verse eid="DEU 4:28"/><verse number="29" style="v" sid="DEU 4:29"/>पर यदि उहां तुमन यहोवा अपन परमेसर के खोज करहू, त ओह तुमन ला मिलही, यदि तुमन ओला अपन पूरा मन अऊ अपन पूरा आतमा ले खोजहू। <verse eid="DEU 4:29"/><verse number="30" style="v" sid="DEU 4:30"/>जब तुमन बिपत्ति म पड़व अऊ ये जम्मो चीज तुम्हर जिनगी म होथे, तब बाद म, तुमन यहोवा अपन परमेसर करा लहुंटके आहू अऊ ओकर बात मानहू। <verse eid="DEU 4:30"/><verse number="31" style="v" sid="DEU 4:31"/>काबरकि यहोवा तुम्हर परमेसर ह दयालु परमेसर अय; ओह तुमन ला नइं छोंड़ही अऊ न ही नास करही अऊ न ही तुम्हर पुरखामन के संग करे गे ओ करार ला भूलही, जेला ओह सपथ खाके ओमन के संग मजबूत करे रिहिस।<verse eid="DEU 4:31"/></para>
  <para style="s1">यहोवा ह परमेसर ए</para>
  <para style="p">
    <verse number="32" style="v" sid="DEU 4:32"/>अब पहिले के समय के बारे म पुछव, अपन बहुंत पहिले के समय, जब परमेसर ह धरती म मानव-जाति ला बनाईस; अकास के एक छोर ले लेके दूसर छोर तक पुछव। का अइसने बड़े बात कभू होईस, या कभू अइसने बात सुनई म आईस? <verse eid="DEU 4:32"/><verse number="33" style="v" sid="DEU 4:33"/>का कभू आने मनखेमन परमेसर के अवाज ला आगी ले गोठियावत सुनके घलो जीयत रिहिन, जइसे कि तुमन सुनके जीयत हव? <verse eid="DEU 4:33"/><verse number="34" style="v" sid="DEU 4:34"/>का कभू कोनो देवता एक जाति ला आने जाति के बीच ले अपन करे बर, परखे के दुवारा, चिनहां अऊ अद्भूत काम के दुवारा, लड़ई के दुवारा, सक्तिसाली हांथ अऊ बढ़ाय हुए भुजा के दुवारा, या बड़े अऊ अद्भूत काम के दुवारा निकाल लाने के कोसिस करिस, जइसे कि यहोवा तुम्हर परमेसर ह तुम्हर आंखी के आघू म तुम्हर बर मिसर देस म जम्मो काम करिस?<verse eid="DEU 4:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="DEU 4:35"/>तुमन ला ये जम्मो चीज देखाय गीस ताकि तुमन जानव कि यहोवा ह परमेसर ए; ओला छोंड़ अऊ कोनो परमेसर नइं ए। <verse eid="DEU 4:35"/><verse number="36" style="v" sid="DEU 4:36"/>अकास ले ओह तुमन ला अपन अवाज सुनाईस, ताकि तुमन अनुसासन म रहव। धरती म ओह तुमन ला अपन बड़े आगी ला देखाईस, अऊ तुमन आगी ले ओकर बात सुनेव। <verse eid="DEU 4:36"/><verse number="37" style="v" sid="DEU 4:37"/>काबरकि ओह तुम्हर पुरखामन ले मया करिस अऊ ओमन के बाद ओह ओमन के संतान ला चुनिस, एकरसेति ओह तुमन ला खुद होके अपन बड़े सामर्थ से मिसर देस ले बाहिर निकाल लानिस, <verse eid="DEU 4:37"/><verse number="38" style="v" sid="DEU 4:38"/>ताकि तुम्हर आघू ले तुम्हर ले बड़े अऊ बलवान जाति के मनखेमन ला भगाके तुमन ला ओमन के देस म लानय अऊ ओ देस तुमन ला तुम्हर उत्तराधिकार के रूप म देवय, जइसे कि आज तुमन देखत हव।<verse eid="DEU 4:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="DEU 4:39"/>एकरसेति आज तुमन मान लव अऊ अपन मन म जान लव कि यहोवा ही ऊपर अकास म अऊ खाल्हे धरती म परमेसर ए। आने अऊ कोनो परमेसर नइं ए। <verse eid="DEU 4:39"/><verse number="40" style="v" sid="DEU 4:40"/>ओकर बिधि अऊ कानूनमन ला मानव, जेला आज में तुमन ला देवत हंव, ताकि तुम्हर अऊ तुम्हर बाद तुम्हर लइकामन के संग भलई होवय अऊ तुमन ओ देस म बहुंत समय तक रहव, जेला यहोवा तुम्हर परमेसर ह तुमन ला हमेसा बर देवत हे।<verse eid="DEU 4:40"/></para>
  <para style="s1">सरन लेय के सहरमन</para>
  <para style="p">
    <verse number="41" style="v" sid="DEU 4:41"/>तब मूसा ह यरदन के पूरब कोति तीन ठन सहर ला अलग करिस, <verse eid="DEU 4:41"/><verse number="42" style="v" sid="DEU 4:42"/>ताकि यदि कोनो मनखे के दुवारा अनजाने म बिगर कोनो बईरता के कोनो परोसी के हतिया हो जावय, त ओह येमा के कोनो सहर म भागके जा सकय अऊ अपन जिनगी ला बचावय। <verse eid="DEU 4:42"/><verse number="43" style="v" sid="DEU 4:43"/>ओ सहरमन ये रिहिन: रूबेनीमन बर सुन्ना जगह के पठार म बेसेर; गादीमन बर गिलाद म रामोत; अऊ मनस्सेयीमन बर बासान म गोलान।<verse eid="DEU 4:43"/></para>
  <para style="s1">कानून के परिचय</para>
  <para style="p">
    <verse number="44" style="v" sid="DEU 4:44"/>येह ओ कानून ए, जेला मूसा ह इसरायलीमन के आघू म रखिस। <verse eid="DEU 4:44"/><verse number="45" style="v" sid="DEU 4:45"/>येमन ओ सर्त, बिधि अऊ कानून अंय, जेला मूसा ह ओमन ला दीस, जब ओमन मिसर देस ले निकलके आईन <verse eid="DEU 4:45"/><verse number="46" style="v" sid="DEU 4:46"/>अऊ यरदन के पूरब कोति बेत-पोर नगर के लकठा के घाटी म रिहिन; ये जगह ह अमोरीमन के राजा सीहोन के देस म रिहिस; ओह हेसबोन नगर म राज करत रिहिस अऊ ओला मूसा अऊ इसरायलीमन लड़ई म हराईन, जब ओमन मिसर देस ले निकलके आईन। <verse eid="DEU 4:46"/><verse number="47" style="v" sid="DEU 4:47"/>ओमन ओकर देस ऊपर अऊ बासान के राजा ओग के देस ऊपर अधिकार कर लीन याने कि यरदन के पूरब कोति ये दूनों अमोरी राजामन के देस ऊपर अधिकार कर लीन। <verse eid="DEU 4:47"/><verse number="48" style="v" sid="DEU 4:48"/>ये देस ह अरनोन घाटी के तीर म अरोएर ले लेके सीरिओन<note caller="+" style="f"><char style="fr" closed="false">4:48 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">सियोन</char></note> (याने कि हेरमोन) पहाड़ तक फईले रिहिस, <verse eid="DEU 4:48"/><verse number="49" style="v" sid="DEU 4:49"/>अऊ येमा यरदन के पूरब कोति जम्मो अराबा अऊ पिसगा पहाड़ के ढलान के खाल्हे मिरतू सागर<note caller="+" style="f"><char style="fr" closed="false">4:49 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">अराबा के समुंदर</char></note> तक के इलाका सामिल रिहिस।<verse eid="DEU 4:49"/></para>
  <chapter eid="DEU 4"/>
  <chapter number="5" style="c" sid="DEU 5"/>
  <para style="s1">दस हुकूम</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 5:1"/>मूसा ह जम्मो इसरायल ला बलाके कहिस:</para>
  <para style="p" vid="DEU 5:1">हे इसरायल, जऊन बिधि अऊ कानून मेंह आज तुम्हर आघू म बतात हंव, ओमन ला सुनव। ओमन ला सीखव अऊ धियान से ओमन के पालन करव। <verse eid="DEU 5:1"/><verse number="2" style="v" sid="DEU 5:2"/>यहोवा हमर परमेसर ह होरेब पहाड़ म हमर ले एक करार करिस। <verse eid="DEU 5:2"/><verse number="3" style="v" sid="DEU 5:3"/>येह ओ करार नो हय, जेला यहोवा ह हमर पुरखामन संग करिस, पर ये करार हमर संग, हमर ओ जम्मो झन संग करिस, जेमन आज इहां हवंय। <verse eid="DEU 5:3"/><verse number="4" style="v" sid="DEU 5:4"/>यहोवा ह पहाड़ ऊपर आगी म ले तुम्हर संग आमने-सामने गोठियाईस। <verse eid="DEU 5:4"/><verse number="5" style="v" sid="DEU 5:5"/>(ओ समय, मेंह यहोवा के बचन ला बताय बर यहोवा अऊ तुम्हर बीच ठाढ़ होंय, काबरकि तुमन ओ आगी ले डरके पहाड़ ऊपर नइं गेव।)</para>
  <para style="p" vid="DEU 5:5">अऊ यहोवा ह कहिस:<verse eid="DEU 5:5"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="6" style="v" sid="DEU 5:6"/>“में यहोवा तुम्हर परमेसर अंव, जऊन ह तुमन ला मिसर देस याने कि गुलामी के देस ले निकाल लानिस।<verse eid="DEU 5:6"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="7" style="v" sid="DEU 5:7"/>“तुमन मोर छोंड़ अऊ कोनो ला ईस्वर करके झन मानहू।<verse eid="DEU 5:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="DEU 5:8"/>तुमन अपन बर कोनो भी चीज के कोनो किसम के मूरती झन बनाहू, न तो ऊपर अकास के, न खाल्हे धरती के अऊ न ही पानी म के कोनो चीज के। <verse eid="DEU 5:8"/><verse number="9" style="v" sid="DEU 5:9"/>तुमन ओमन ला न तो दंडवत करहू अऊ न ही ओमन के अराधना करहू; काबरकि में यहोवा तुम्हर परमेसर ह जलन रखइया परमेसर अंव अऊ जऊन मन मोर ले घिन करथें, ओमन के पाप के दंड मेंह ओमन के लइकामन के तीसरा अऊ चौथा पीढ़ी तक देथंव, <verse eid="DEU 5:9"/><verse number="10" style="v" sid="DEU 5:10"/>पर जऊन मन मोर ले मया करथें अऊ मोर हुकूममन ला मानथें, ओमन के हजार पीढ़ी तक मेंह अपन मया देखाथंव।<verse eid="DEU 5:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="DEU 5:11"/>तुमन यहोवा अपन परमेसर के नांव बेमतलब के झन लूहू, काबरकि जऊन ह यहोवा के नांव के दुरपयोग करही, ओला ओह दोसी ठहिराही।<verse eid="DEU 5:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="DEU 5:12"/>तुमन बिसराम दिन ला पबितर मानव, जइसे कि यहोवा तुम्हर परमेसर ह तुमन ला हुकूम दे हवय। <verse eid="DEU 5:12"/><verse number="13" style="v" sid="DEU 5:13"/>हप्ता के छै दिन तुमन मेहनत करव अऊ अपन जम्मो काम करव, <verse eid="DEU 5:13"/><verse number="14" style="v" sid="DEU 5:14"/>पर सातवां दिन यहोवा तुम्हर परमेसर बर बिसराम दिन ए। ओ दिन तुमन कोनो काम झन करहू, न तो तुमन, न तुम्हर बेटा या बेटीमन, न तुम्हर सेवक या सेविकामन, न तुम्हर बईला, तुम्हर गदहा या तुम्हर पसुमन, अऊ न ही तुम्हर नगर म रहइया कोनो परदेसी, ताकि तुम्हर सहीं तुम्हर सेवक अऊ सेविकामन घलो बिसराम करंय। <verse eid="DEU 5:14"/><verse number="15" style="v" sid="DEU 5:15"/>ये बात ला सुरता रखव कि तुमन मिसर देस म गुलाम रहेव अऊ यहोवा तुम्हर परमेसर ह तुमन ला उहां ले अपन सक्तिसाली हांथ अऊ बढ़ाय भुजा के दुवारा निकाल लानिस। एकरसेति यहोवा तुम्हर परमेसर ह तुमन ला बिसराम दिन ला माने के हुकूम दे हवय।<verse eid="DEU 5:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="DEU 5:16"/>अपन दाई-ददा के आदरमान करव, जइसे कि यहोवा तुम्हर परमेसर ह तुमन ला हुकूम दे हवय, ताकि तुमन बहुंत साल तक जीयव अऊ ओ देस म तुम्हर भलई होवय, जेला यहोवा तुम्हर परमेसर ह तुमन ला देवत हे।<verse eid="DEU 5:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="DEU 5:17"/>तुमन कोनो मनखे के हतिया झन करहू।<verse eid="DEU 5:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="DEU 5:18"/>तुमन बेभिचार झन करहू।<verse eid="DEU 5:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="DEU 5:19"/>तुमन चोरी झन करहू।<verse eid="DEU 5:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="DEU 5:20"/>तुमन अपन परोसी के बिरूध लबारी गवाही झन दूहू।<verse eid="DEU 5:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="DEU 5:21"/>तुमन अपन परोसी के घरवाली के लालच झन करहू। तुमन अपन परोसी के घर या भुइयां के लालच झन करहू, न ही ओकर सेवक या सेविका, ओकर बईला, या गदहा, या ओकर कोनो अऊ चीज के लालच करहू।”<verse eid="DEU 5:21"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="22" style="v" sid="DEU 5:22"/>येमन ओ हुकूम अंय, जेला यहोवा ह ऊंच अवाज म आगी, बादर अऊ घोर अंधियार म ले उहां पहाड़ ऊपर तुम्हर जम्मो सभा ला सुनाईस; अऊ ओह येमा अऊ कुछू नइं जोड़िस। तब ओह येमन ला दू ठन पथरा के पटिया म लिखके मोला दे दीस।<note caller="+" style="f"><char style="fr" closed="false">5:22 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="EXO 20:1-17">निर 20:1‑17</ref></char></char></note><verse eid="DEU 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 5:23"/>जब तुमन ओ अंधियार म ले अवाज ला सुनेव अऊ पहाड़ ह आगी ले बरत रिहिस, त तुम्हर गोत्रमन के जम्मो अगुवा अऊ तुम्हर मुखियामन मोर करा आईन। <verse eid="DEU 5:23"/><verse number="24" style="v" sid="DEU 5:24"/>अऊ तुमन कहेव, “यहोवा हमर परमेसर ह हमन ला अपन महिमा अऊ गौरव देखाय हवय, अऊ हमन आगी म ले ओकर अवाज सुने हन। आज हमन देखेंन कि यदि परमेसर ह मनखे ले गोठियाथे, तभो ले मनखे ह जीयत रह सकथे।<note caller="+" style="f"><char style="fr" closed="false">5:24 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 19:19">निर 19:19</ref></char></char></note> <verse eid="DEU 5:24"/><verse number="25" style="v" sid="DEU 5:25"/>पर अब, हमन काबर मरन? ये भयंकर आगी ह हमन ला भसम कर दीही, अऊ यदि हमन यहोवा हमर परमेसर के अवाज फेर सुनबो, त हमन मर जाबो। <verse eid="DEU 5:25"/><verse number="26" style="v" sid="DEU 5:26"/>काबरकि कभू कोनो मरनहार मनखे ह परमेसर ला आगी म ले गोठियावत ओकर अवाज ला सुनके जीयत हवय, जइसे कि हमन जीयत हन? <verse eid="DEU 5:26"/><verse number="27" style="v" sid="DEU 5:27"/>एकरसेति तें लकठा म जा अऊ ओ जम्मो बात ला सुन, जेला यहोवा हमर परमेसर ह कहत हे। तब जऊन बात यहोवा हमर परमेसर ह तोला बताथे, ओ बात हमन ला बता। हमन सुनबो अऊ ओकर पालन करबो।”<verse eid="DEU 5:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="DEU 5:28"/>यहोवा ह तुम्हर बात ला सुनिस, जब तुमन मोर ले गोठियावत रहेव, अऊ तब यहोवा ह मोला कहिस, “ये मनखेमन जऊन बात तोर ले कहिन, मेंह ओला सुनेंव। जऊन बात ओमन कहिन, ओह बने बात ए। <verse eid="DEU 5:28"/><verse number="29" style="v" sid="DEU 5:29"/>बने होही कि ओमन के मन ह अइसने ही रहय अऊ ओमन गंभीरता से मोर भय मानंय अऊ हमेसा मोर जम्मो हुकूम ला मानंय, ताकि ओमन अऊ ओमन के लइकामन संग हमेसा भलई होवय!<verse eid="DEU 5:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="DEU 5:30"/>“जा, अऊ ओमन ला कह कि ओमन अपन तम्बू म लहुंट जावंय। <verse eid="DEU 5:30"/><verse number="31" style="v" sid="DEU 5:31"/>पर तें इहां मोर संग रूक, ताकि मेंह तोला ओ जम्मो हुकूम, बिधि अऊ कानून बता सकंव, जेला तेंह ओमन ला सिखाबे कि ओमन ओ देस म येकर पालन करंय, जेला मेंह ओमन के अधिकार म देवत हंव।”<verse eid="DEU 5:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="DEU 5:32"/>एकरसेति सचेत होके ओ काममन ला करव, जेकर हुकूम यहोवा तुम्हर परमेसर ह तुमन ला दे हवय; येकर ले न तो जेवनी मुड़व अऊ न ही डेरी। <verse eid="DEU 5:32"/><verse number="33" style="v" sid="DEU 5:33"/>ओ जम्मो बात के पालन करत चलव, जेकर हुकूम यहोवा तुम्हर परमेसर ह तुमन ला दे हवय, ताकि तुमन जीयत रहव अऊ तुम्हर उन्नति होवय अऊ तुमन ओ देस म बहुंत समय तक बने रहव, जेला तुमन अपन अधिकार म करहू।<verse eid="DEU 5:33"/></para>
  <chapter eid="DEU 5"/>
  <chapter number="6" style="c" sid="DEU 6"/>
  <para style="s1">यहोवा अपन परमेसर ले मया करव</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 6:1"/>येमन ओ हुकूम, बिधि अऊ कानून अंय, जेमन ला सिखाय के निरदेस यहोवा तुम्हर परमेसर ह मोला देय हवय कि तुमन ओ देस म येमन के पालन करव, जिहां अधिकार करे बर तुमन यरदन के ओ पार जावत हव, <verse eid="DEU 6:1"/><verse number="2" style="v" sid="DEU 6:2"/>ताकि तुमन, तुम्हर लइकामन अऊ ओमन के बाद ओमन के लइकामन यहोवा अपन परमेसर के भय मानंय। जब तक तुमन मोर दिये जम्मो बिधि अऊ कानूनमन ला मानत रहिहू, तुमन लम्बा जिनगी के आनंद उठाहू। <verse eid="DEU 6:2"/><verse number="3" style="v" sid="DEU 6:3"/>हे इसरायलीमन, सुनव अऊ धियान से हुकूममन के पालन करव, ताकि तुम्हर भलई होवय अऊ तुम्हर संखिया ह ओ देस म बहुंत बढ़य, जिहां दूध अऊ मंधरस के भरमार हे, जइसे कि यहोवा, तुम्हर पुरखामन के परमेसर ह तुम्हर ले वायदा करे हवय।<verse eid="DEU 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 6:4"/>हे इसरायलीमन, सुनव: यहोवा हमर परमेसर अय, यहोवा ह एके झन परभू अय। <verse eid="DEU 6:4"/><verse number="5" style="v" sid="DEU 6:5"/>यहोवा अपन परमेसर ले अपन पूरा हिरदय अऊ अपन पूरा परान अऊ अपन पूरा सक्ति ले मया करव। <verse eid="DEU 6:5"/><verse number="6" style="v" sid="DEU 6:6"/>ये हुकूम, जेमन ला आज मेंह तुमन ला देवत हंव, येमन तुम्हर हिरदय म रहंय। <verse eid="DEU 6:6"/><verse number="7" style="v" sid="DEU 6:7"/>येमन ला अपन लइकामन ला सिखावव। जब तुमन घर म बईठथव अऊ डहार म रेंगथव, जब तुमन लेटथव अऊ उठथव, त येमन ला सिखाय करव। <verse eid="DEU 6:7"/><verse number="8" style="v" sid="DEU 6:8"/>चिनहां के रूप म येमन ला अपन हांथ म बांध लव अऊ येमन ला अपन माथा म बांध लव। <verse eid="DEU 6:8"/><verse number="9" style="v" sid="DEU 6:9"/>येमन ला अपन घर के चौखटमन म अऊ अपन दुवारमन म लिखव।<verse eid="DEU 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 6:10"/>जब यहोवा तुम्हर परमेसर ह तुमन ला ओ देस म लानथे, जेला ओह तुम्हर पुरखा, अब्राहम, इसहाक अऊ याकूब ला देय के सपथ खाय हवय—एक अइसने देस, जेमा बड़े-बड़े अऊ उन्नत सहरमन हवंय, जेला तुमन नइं बनाय हव, <verse eid="DEU 6:10"/><verse number="11" style="v" sid="DEU 6:11"/>अइसने घरमन, जेमा जम्मो किसम के बने चीजमन भरे हवंय, जेला तुमन नइं दे हव, कुआंमन जेला तुमन नइं कोड़े हव, अऊ अंगूर के बारी अऊ जैतून के छोटे जंगलमन, जेला तुमन नइं लगाय हव—तब जब तुमन येमन ला खाथव अऊ तुम्हर पेट ह भर जाथे, <verse eid="DEU 6:11"/><verse number="12" style="v" sid="DEU 6:12"/>त सचेत रहव कि तुमन यहोवा ला झन भूलव, जऊन ह तुमन ला मिसर देस याने कि गुलामी के देस ले निकाल लानिस।<verse eid="DEU 6:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 6:13"/>यहोवा अपन परमेसर के भय मानव, सिरिप ओकरेच सेवा करव अऊ ओकर नांव म सपथ लेवव। <verse eid="DEU 6:13"/><verse number="14" style="v" sid="DEU 6:14"/>आने देवतामन के पाछू झन जावव याने कि ओ मनखेमन के देवता, जेमन तुम्हर चारों कोति हवंय; <verse eid="DEU 6:14"/><verse number="15" style="v" sid="DEU 6:15"/>काबरकि यहोवा तुम्हर परमेसर, जऊन ह तुम्हर बीच म हवय, ओह जलन रखनेवाला परमेसर ए अऊ ओकर कोप ह तुम्हर बिरूध भड़कही, अऊ ओह तुमन ला धरती ऊपर ले नास कर दीही। <verse eid="DEU 6:15"/><verse number="16" style="v" sid="DEU 6:16"/>तुमन यहोवा अपन परमेसर के परिछा झन करव, जइसे कि तुमन मस्सा म करे रहेव।<note caller="+" style="f"><char style="fr" closed="false">6:16 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 17:1-7">निर 17:1‑7</ref></char></char></note> <verse eid="DEU 6:16"/><verse number="17" style="v" sid="DEU 6:17"/>धियान देके ओ हुकूम, निरदेस अऊ बिधिमन ला मानव, जेला यहोवा तुम्हर परमेसर ह तुमन ला दे हवय। <verse eid="DEU 6:17"/><verse number="18" style="v" sid="DEU 6:18"/>यहोवा के नजर म ओ काम करव, जऊन ह सही अऊ बने अय, ताकि तुम्हर भलई होवय अऊ तुमन जाके ओ उत्तम देस के ऊपर अधिकार कर सकव, जेकर सपथ यहोवा ह तुम्हर पुरखामन ले खाय हवय, <verse eid="DEU 6:18"/><verse number="19" style="v" sid="DEU 6:19"/>तुम्हर जम्मो बईरीमन तुम्हर आघू ले भगा दिये जाहीं, जइसे कि यहोवा ह कहिसे।<verse eid="DEU 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 6:20"/>भविस्य म, जब तुम्हर लइकामन तुम्हर ले पुछहीं, “ओ निरदेस, बिधि अऊ कानूनमन के का मतलब ए, जेला माने के हुकूम यहोवा हमर परमेसर ह तुमन ला दे हवय?” <verse eid="DEU 6:20"/><verse number="21" style="v" sid="DEU 6:21"/>त ओमन ला बतावव: “हमन मिसर देस म फिरौन के गुलाम रहेंन, पर यहोवा ह अपन सक्तिसाली हांथ ले हमन ला मिसर देस ले बाहिर निकाल लानिस। <verse eid="DEU 6:21"/><verse number="22" style="v" sid="DEU 6:22"/>हमर आंखी के आघू म यहोवा ह मिसर म फिरौन अऊ ओकर जम्मो परिवार ला बड़े-बड़े अऊ भयंकर चिनहां अऊ चमतकार देखाईस। <verse eid="DEU 6:22"/><verse number="23" style="v" sid="DEU 6:23"/>ओह हमन ला उहां ले निकालके ओ देस म लानिस, जेला हमन ला देय के सपथ ओह हमर पुरखामन ले खाय रिहिस। <verse eid="DEU 6:23"/><verse number="24" style="v" sid="DEU 6:24"/>यहोवा ह हमन ला ये जम्मो बिधिमन ला पालन करे के अऊ यहोवा हमर परमेसर के भय माने के हुकूम दीस, ताकि हमन हमेसा उन्नति करन अऊ जीयत रहन, जइसे कि आज के दिन म दिखत हे। <verse eid="DEU 6:24"/><verse number="25" style="v" sid="DEU 6:25"/>अऊ यदि हमन धियान देके ये जम्मो कानून ला यहोवा हमर परमेसर के आघू म मानथन, जइसे कि ओह हमन ला हुकूम दे हवय, त ओह हमर धरमीपन होही।”<verse eid="DEU 6:25"/></para>
  <chapter eid="DEU 6"/>
  <chapter number="7" style="c" sid="DEU 7"/>
  <para style="s1">जाति-जाति के मनखेमन ला निकाल देवई</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 7:1"/>जब यहोवा तुम्हर परमेसर ह तुमन ला ओ देस म ले आथे, जेला तुमन अधिकार करइया हव अऊ यहोवा ह तुम्हर आघू ले कतको जाति—याने कि हित्ती, गिरगासी, अमोरी, कनानी, परिज्जी, हिब्बी अऊ यबूसी जाति के मनखेमन ला भगा देथे; ये सात जाति के मनखे जेमन तुम्हर ले गनती म जादा अऊ बलवान हवंय— <verse eid="DEU 7:1"/><verse number="2" style="v" sid="DEU 7:2"/>अऊ जब यहोवा तुम्हर परमेसर ह ओमन ला तुम्हर हांथ म कर देथे अऊ तुमन ओमन ला हरा दव, तब ये जरूरी अय कि तुमन ओमन ला पूरा नास कर दव। ओमन के संग कोनो करार झन करव, अऊ ओमन ऊपर दया झन करव। <verse eid="DEU 7:2"/><verse number="3" style="v" sid="DEU 7:3"/>ओमन के संग सादी-बिहाव घलो झन करव। न अपन बेटीमन ला ओमन के बेटामन बर दव अऊ न ही ओमन के बेटीमन ला अपन बेटामन बर लानव, <verse eid="DEU 7:3"/><verse number="4" style="v" sid="DEU 7:4"/>काबरकि ओमन तुम्हर लइकामन ला मोर पाछू चले से भटका दीहीं अऊ आने देवता के सेवा करे बर कहिहीं, अऊ तब यहोवा के कोरोध ह तुम्हर ऊपर भड़कही अऊ तुमन ला तुरते नास कर दीही। <verse eid="DEU 7:4"/><verse number="5" style="v" sid="DEU 7:5"/>तुमन ला ओमन के संग ये करना हे: ओमन के बेदीमन ला टोरके गिरा दव, ओमन के पबितर पथरामन ला कुटा-कुटा कर दव, ओमन के असेरा के खंभामन<note caller="+" style="f"><char style="fr" closed="false">7:5 </char><char style="ft" closed="false">असेरा देवी के लकड़ी के प्रतीक</char></note> ला काट डारव अऊ ओमन के मूरतीमन ला आगी म जला दव। <verse eid="DEU 7:5"/><verse number="6" style="v" sid="DEU 7:6"/>काबरकि तुमन यहोवा तुम्हर परमेसर बर एक पबितर जाति के मनखे अव। यहोवा तुम्हर परमेसर ह धरती के जम्मो जाति ले तुम्हर जाति ला चुने हवय ताकि तुमन ओकर मनखे, ओकर निज भाग ठहिरव।<verse eid="DEU 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 7:7"/>यहोवा ह तुम्हर ऊपर अपन मया देखाके तुमन ला एकरसेति नइं चुनिस कि तुमन आने जातिमन के मनखेमन ले गनती म जादा रहेव; वास्तव म तुमन जम्मो जातिमन ले गनती म बहुंत कम रहेव। <verse eid="DEU 7:7"/><verse number="8" style="v" sid="DEU 7:8"/>पर येह एकरसेति होईस काबरकि यहोवा ह तुमन ले मया करिस अऊ ओ सपथ ला पूरा करिस, जेला ओह तुम्हर पुरखामन ले खाय रिहिस कि ओह तुमन ला अपन सक्तिसाली हांथ के दुवारा बंधुवई के देस ले याने कि मिसर देस के राजा फिरौन के सक्ति ले छोंड़ाईस। <verse eid="DEU 7:8"/><verse number="9" style="v" sid="DEU 7:9"/>एकरसेति तुमन जानव कि यहोवा तुम्हर परमेसर ह परमेसर ए; ओह बिसवासयोग्य परमेसर ए, जऊन ह अपन मया के करार ला ओमन के संग हजार पीढ़ी तक बनाय रखथे, जेमन ओकर ले मया करथें अऊ ओकर हुकूममन ला मानथें। <verse eid="DEU 7:9"/><verse number="10" style="v" sid="DEU 7:10"/>पर</para>
  <para style="q1" vid="DEU 7:10">जऊन मन ओकर ले घिन करथें, ओह ओमन ला नास करके ओमन के आघू म ही ओमन ले बदला लीही;</para>
  <para style="q2" vid="DEU 7:10">ओह ओमन ले बदला लेय म देरी नइं करही, जेमन ओकर ले घिन करथें।<verse eid="DEU 7:10"/></para>
  <para style="m">
    <verse number="11" style="v" sid="DEU 7:11"/>एकरसेति, ओ हुकूम, बिधि अऊ कानूनमन ला माने बर धियान लगावव, जेला मेंह आज तुमन ला देवत हंव।<verse eid="DEU 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 7:12"/>यदि तुमन ये कानूनमन ऊपर धियान देथव अऊ मन लगाके ओमन के पालन करथव, त यहोवा तुम्हर परमेसर ह अपन मया के करार ला तुम्हर संग बनाय रखही, जइसे कि ओह तुम्हर पुरखामन संग सपथ खाय रिहिस। <verse eid="DEU 7:12"/><verse number="13" style="v" sid="DEU 7:13"/>ओह तुमन ला मया करही अऊ तुमन ला आसीस दीही अऊ तुम्हर संखिया ला बढ़ाही। ओह तुम्हर गरभ के फर, तुम्हर भुइयां के ऊपज—तुम्हर अनाज, नवां अंगूर के मंद अऊ जैतून तेल अऊ तुम्हर बरदी के बछवा अऊ मेढ़ा-पीलामन ला ओ देस म आसीस दीही, जेला देय के परतिगियां ओह तुम्हर पुरखामन ले करे रिहिस। <verse eid="DEU 7:13"/><verse number="14" style="v" sid="DEU 7:14"/>तुमन कोनो आने जाति के मनखेमन ले जादा आसीसित होहू; तुम्हर कोनो भी आदमी या माईलोगन बांझ नइं होही, अऊ न ही तुम्हर पसु-धन म पीलामन के कमी होही। <verse eid="DEU 7:14"/><verse number="15" style="v" sid="DEU 7:15"/>यहोवा ह तुमन ला हर एक बेमारी ले दूरिहा रखही। ओह तुम्हर ऊपर ओ भयंकर बेमारीमन ला नइं लानही, जेला तुमन मिसर देस म देखे रहेव, पर ओह ये बेमारीमन ला ओ जम्मो झन ऊपर लानही, जेमन तुम्हर ले घिन करथें। <verse eid="DEU 7:15"/><verse number="16" style="v" sid="DEU 7:16"/>जरूरी ए कि तुमन ओ जम्मो जाति के मनखेमन ला नास कर दव, जेमन ला यहोवा तुम्हर परमेसर ह तुमन ला दे देथे। ओमन ऊपर दया झन करव अऊ ओमन के देवतामन के सेवा झन करव, काबरकि ओह तुम्हर बर एक फांदा होही।<verse eid="DEU 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 7:17"/>तुमन अपनआप ले कह सकत हव, “ये जातिमन तो हमर ले बलवान हवंय। हमन येमन ला कइसे भगा सकत हन?” <verse eid="DEU 7:17"/><verse number="18" style="v" sid="DEU 7:18"/>पर ओमन ले झन डरव; बने करके सुरता करव कि यहोवा तुम्हर परमेसर ह फिरौन अऊ जम्मो मिसर देस के संग का करिस। <verse eid="DEU 7:18"/><verse number="19" style="v" sid="DEU 7:19"/>तुमन अपन आंखी ले ओ बड़े-बड़े बिपत्ति, चिनहां अऊ अद्भूत काम, सक्तिसाली हांथ अऊ बढ़ाय हुए बाहां ला देखे हव, जेकर दुवारा यहोवा तुम्हर परमेसर ह तुमन ला बाहिर निकालिस। यहोवा तुम्हर परमेसर ह ओ जम्मो मनखेमन के संग वइसने ही करही, जेमन ले तुमन अब डरत हव। <verse eid="DEU 7:19"/><verse number="20" style="v" sid="DEU 7:20"/>येकर अलावा, यहोवा तुम्हर परमेसर ह ओमन के बीच म तब तक दतैया पठोही, जब तक कि ओ बांचे मनखेमन नास नइं हो जाहीं, जेमन कि तुम्हर ले छिपे होहीं। <verse eid="DEU 7:20"/><verse number="21" style="v" sid="DEU 7:21"/>ओमन ले भयभीत झन होवव, काबरकि यहोवा तुम्हर परमेसर, जऊन ह तुम्हर बीच म हवय, ओह महान अऊ अद्भूत परमेसर अय। <verse eid="DEU 7:21"/><verse number="22" style="v" sid="DEU 7:22"/>यहोवा तुम्हर परमेसर ह ओ जाति-जाति के मनखेमन ला धीरे-धीरे करके तुम्हर आघू ले भगा दीही। ओमन ला तुरते भगाय के अनुमति तुमन ला नइं होही, नइं तो तुम्हर चारों कोति जंगली पसुमन बहुंत बढ़ जाहीं। <verse eid="DEU 7:22"/><verse number="23" style="v" sid="DEU 7:23"/>पर यहोवा तुम्हर परमेसर ह ओमन ला तुम्हर हांथ म सऊंप दीही अऊ ओमन के बीच म अइसने गड़बड़ी कर दीही कि ओमन नास हो जाहीं। <verse eid="DEU 7:23"/><verse number="24" style="v" sid="DEU 7:24"/>ओह ओमन के राजामन ला तुम्हर हांथ म कर दीही, अऊ तुमन धरती म ओमन के नांव मिटा दूहू। अइसने कोनो नइं होही, जऊन ह तुम्हर सामना कर सकय; तुमन ओमन ला नास कर दूहू। <verse eid="DEU 7:24"/><verse number="25" style="v" sid="DEU 7:25"/>तुमन ला ओमन के देवतामन के मूरती ला आगी म जला देना हे। ओमन के सोन अऊ चांदी के लालच झन करहू, अऊ ओला अपन बर झन लूहू, नइं तो तुमन ओकर दुवारा फंस जाहू, काबरकि येह यहोवा तुम्हर परमेसर बर घिनौना चीज अय। <verse eid="DEU 7:25"/><verse number="26" style="v" sid="DEU 7:26"/>अपन घर म कोनो घिनौना चीज ला झन लानव, नइं तो तुमन ला घलो ओकर सहीं बिनास बर अलग रखे जाही। येला नीच या खराप चीज समझव अऊ येकर ले बहुंत घिन करव, काबरकि येला बिनास बर अलग करे जाथे।<verse eid="DEU 7:26"/></para>
  <chapter eid="DEU 7"/>
  <chapter number="8" style="c" sid="DEU 8"/>
  <para style="s1">यहोवा ला झन भूलव</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 8:1"/>आज मेंह तुमन ला जऊन हुकूम देवत हंव, धियान देके तुमन ओमन के पालन करव, ताकि तुमन जीयत रहव अऊ संखिया म बढ़व अऊ ओ देस म जाके ओकर ऊपर अधिकार कर लेवव, जेकर परतिगियां यहोवा ह सपथ खाके तुम्हर पुरखामन ले करे रिहिस। <verse eid="DEU 8:1"/><verse number="2" style="v" sid="DEU 8:2"/>सुरता रखव कि कइसे यहोवा तुम्हर परमेसर ह पूरा रसता म ये चालीस साल तक सुन्ना जगह म तुम्हर अगुवई करिस अऊ ओह ये जाने बर तुमन ला नम्र करिस अऊ परखिस कि तुम्हर मन म का हवय, तुमन ओकर हुकूममन ला मानहू या नइं। <verse eid="DEU 8:2"/><verse number="3" style="v" sid="DEU 8:3"/>ओह तुमन ला भूखा रखके नम्र करिस अऊ फेर तुमन ला मन्ना खवाईस, जेकर बारे म न तो तुमन अऊ न ही तुम्हर पुरखामन जानत रिहिन; ओह तुमन ला ये सिखाय बर घलो नम्र करिस कि मनखे ह सिरिप रोटी ले ही जीयत नइं रहय, फेर हर ओ बचन जऊन ह यहोवा के मुहूं ले निकलथे जीयत रहिही। <verse eid="DEU 8:3"/><verse number="4" style="v" sid="DEU 8:4"/>ये चालीस साल के दौरान तुम्हर कपड़ामन न तो फटिन अऊ न ही तुम्हर गोड़मन थकके फूलिन। <verse eid="DEU 8:4"/><verse number="5" style="v" sid="DEU 8:5"/>तब अपन मन म जान लेवव कि जइसे एक मनखे ह अपन बेटा ला अनुसासित करथे, वइसे ही यहोवा तुम्हर परमेसर ह तुमन ला अनुसासित करथे।<verse eid="DEU 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 8:6"/>यहोवा अपन परमेसर के हुकूम ला मानव, ओकर हुकूम के मुताबिक चलव अऊ ओकर आदर करव। <verse eid="DEU 8:6"/><verse number="7" style="v" sid="DEU 8:7"/>काबरकि यहोवा तुम्हर परमेसर ह तुमन ला एक उत्तम देस म ले जावत हे—एक अइसने देस जिहां घाटी अऊ पहाड़ीमन ले पानी के नाला, नरवा अऊ गहिरा सोतामन निकलत हें; <verse eid="DEU 8:7"/><verse number="8" style="v" sid="DEU 8:8"/>एक अइसने देस जिहां गहूं, जौ, अंगूर के नार, अंजीर के रूख, अनार, जैतून तेल अऊ मंधरस हवय; <verse eid="DEU 8:8"/><verse number="9" style="v" sid="DEU 8:9"/>एक अइसने देस जिहां जेवन के कमी नइं होही अऊ तुमन ला कोनो चीज के घटी नइं होही; एक अइसने देस जिहां चट्टान म लोहा हवय अऊ तुमन पहाड़ीमन ला खनके तांबा निकाल सकत हव।<verse eid="DEU 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 8:10"/>जब तुमन जी भरके खा लेवव, त यहोवा अपन परमेसर के ओ उत्तम देस बर परसंसा करव, जेला ओह तुमन ला देय हवय। <verse eid="DEU 8:10"/><verse number="11" style="v" sid="DEU 8:11"/>ये बात के खियाल रखव कि मेंह तुमन ला आज ओकर जऊन हुकूम, कानून अऊ बिधिमन ला देवत हंव, ओमन ला नइं मानके यहोवा अपन परमेसर ला झन भूलव। <verse eid="DEU 8:11"/><verse number="12" style="v" sid="DEU 8:12"/>नइं तो, जब तुमन जी भरके खाथव, जब तुमन सुघर घर बनाथव अऊ रहे लगथव, <verse eid="DEU 8:12"/><verse number="13" style="v" sid="DEU 8:13"/>अऊ जब तुम्हर गाय-बईला अऊ भेड़-बकरी के झुंड ह बहुंत बढ़थे अऊ तुम्हर सोन अऊ चांदी ह बढ़थे अऊ तुम्हर जम्मो चीज म बढ़ोतरी होथे, <verse eid="DEU 8:13"/><verse number="14" style="v" sid="DEU 8:14"/>त तुम्हर मन ह घमंडी हो जाही अऊ तुमन यहोवा अपन परमेसर ला भुला जाहू, जऊन ह तुमन ला मिसर देस ले, याने कि बंधुवई के देस ले बाहिर निकाल लानिस। <verse eid="DEU 8:14"/><verse number="15" style="v" sid="DEU 8:15"/>ओह तुमन ला ओ बड़े अऊ भयानक निरजन प्रदेस म ले आईस, जिहां पानी के कमी अऊ सूखा भुइयां रिहिस, जिहां जहरिला सांप अऊ बिच्छूमन रिहिन। ओह तुम्हर बर कठोर चट्टान म ले पानी निकालिस। <verse eid="DEU 8:15"/><verse number="16" style="v" sid="DEU 8:16"/>ओह निरजन प्रदेस म तुमन ला खाय बर मन्ना दीस, जेकर बारे म तुम्हर पुरखामन नइं जानत रिहिन; ओह ये सब तुमन ला नम्र करे बर अऊ तुमन ला परखे बर करिस ताकि आखिरी म ये सब के दुवारा तुम्हर भलई होवय। <verse eid="DEU 8:16"/><verse number="17" style="v" sid="DEU 8:17"/>तुमन अपनआप ले कह सकत हव, “मोर सक्ति अऊ मोर हांथ के ताकत ले मेंह मोर बर ये संपत्ति बनाय हवंव।” <verse eid="DEU 8:17"/><verse number="18" style="v" sid="DEU 8:18"/>पर यहोवा अपन परमेसर ला सुरता रखव, काबरकि येह ओहीच अय, जऊन ह तुमन ला संपत्ति बनाय के योग्यता देथे, अऊ ये किसम ले ओह अपन करार ला मजबूत करथे, जेला ओह तुम्हर पुरखामन संग सपथ खाके करे रिहिस, जइसे कि येह आज दिखत हे।<verse eid="DEU 8:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 8:19"/>कहूं तुमन कभू यहोवा अपन परमेसर ला भुला जावव अऊ आने देवतामन के पाछू चलव अऊ ओमन के अराधना अऊ दंडवत करव, त मेंह आज तुमन ला चेताके कहत हंव कि खचित तुमन नास हो जाहू। <verse eid="DEU 8:19"/><verse number="20" style="v" sid="DEU 8:20"/>जइसे कि यहोवा ह जाति-जाति के ओ मनखेमन ला तुम्हर आघू ले नास कर दे रिहिस, वइसे ही तुमन घलो यहोवा अपन परमेसर के हुकूम नइं माने के कारन नास हो जाहू।<verse eid="DEU 8:20"/></para>
  <chapter eid="DEU 8"/>
  <chapter number="9" style="c" sid="DEU 9"/>
  <para style="s1">इसरायल के धरमीपन के कारन बिजय नइं</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 9:1"/>हे इसरायलीमन, सुनव: तुमन अब यरदन नदी के ओ पार जाके ओ जाति-जाति के मनखेमन ला बेदखल करनेचवाला हव, जेमन तुम्हर ले बड़े अऊ बलवान हें, जेमन के बड़े-बड़े सहर हवंय अऊ ओ सहर म ऊंचहा-ऊंचहा दीवार हवंय। <verse eid="DEU 9:1"/><verse number="2" style="v" sid="DEU 9:2"/>उहां मनखेमन बलवान अऊ ऊंचहा-ऊंचहा हवंय—ओमन अनाकी अंय। तुमन ओमन के बारे म जानत हव अऊ ओमन के बारे म ये बात सुने हव: “कोन ह अनाकीमन के सामना कर सकथे?” <verse eid="DEU 9:2"/><verse number="3" style="v" sid="DEU 9:3"/>पर तुमन आज ये बात ला जान लेवव कि यहोवा तुम्हर परमेसर ही ओ अय, जऊन ह एक भसम करइया आगी सहीं तुम्हर आघू ओ पार जाही। ओह ओमन ला नास कर दीही; ओह ओमन ला तुम्हर आघू म दबा दीही। अऊ तुमन ओमन ला भगा दूहू अऊ तुरते ओमन के बिनास कर दूहू, जइसे कि यहोवा ह तुम्हर ले वायदा करे हवय।<verse eid="DEU 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 9:4"/>जब यहोवा तुम्हर परमेसर ह ओमन ला तुम्हर आघू ले भगा दीही, त तुमन अपनआप ले ये झन कहव, “मोर धरमीपन के कारन यहोवा ह मोला इहां ये देस ऊपर अधिकार करे बर लाने हवय।” काबरकि सच तो ये अय कि ये जातिमन के दुस्टता के कारन यहोवा ह येमन ला तुम्हर आघू ले भगानेवाला हे। <verse eid="DEU 9:4"/><verse number="5" style="v" sid="DEU 9:5"/>तुमन अपन धरमीपन अऊ ईमानदारी के कारन ओमन के देस ऊपर अधिकार करे बर नइं जावत हव; पर ये जातिमन के दुस्टता के कारन यहोवा तुम्हर परमेसर ओमन ला तुम्हर आघू ले भगाही ताकि ओ बात पूरा होवय, जेकर सपथ ओह तुम्हर पुरखा अब्राहम, इसहाक अऊ याकूब ले खाय रिहिस। <verse eid="DEU 9:5"/><verse number="6" style="v" sid="DEU 9:6"/>एकरसेति ये बात ला समझ लव कि तुम्हर धरमीपन के कारन यहोवा तुम्हर परमेसर ह तुमन ला ये देस तुम्हर अधिकार म नइं देवत हे, काबरकि तुमन एक ढीठ जाति के मनखे अव।<verse eid="DEU 9:6"/></para>
  <para style="s1">सोन के बछरू</para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 9:7"/>ये बात ला सुरता रखव अऊ कभू झन भूलव कि सुन्ना जगह म तुमन कइसे यहोवा तुम्हर परमेसर के कोरोध ला भड़कावत रहेव। मिसर देस ला छोंड़े के दिन ले लेके इहां हबरे के दिन तक, तुमन यहोवा के बिरूध बिदरोह करत आय हवव। <verse eid="DEU 9:7"/><verse number="8" style="v" sid="DEU 9:8"/>होरेब करा घलो तुमन यहोवा के कोरोध ला भड़कायेव; ओह अतेक गुस्सा होईस कि तुमन ला नास कर देतिस। <verse eid="DEU 9:8"/><verse number="9" style="v" sid="DEU 9:9"/>जब मेंह पथरा के पटिया, ओ करार के पटियामन ला लेय बर पहाड़ ऊपर गेंव, जेला यहोवा ह तुम्हर संग करे रिहिस, त मेंह पहाड़ ऊपर चालीस दिन अऊ चालीस रात तक रहेंव; मेंह न तो जेवन करेंव अऊ न ही पानी पीयेंव। <verse eid="DEU 9:9"/><verse number="10" style="v" sid="DEU 9:10"/>यहोवा ह मोला दू ठन पथरा के पटिया दीस, जेमा परमेसर ह अपन अंगरी ले लिखे रिहिस। ओमा ओ जम्मो हुकूममन लिखाय रिहिन, जेला यहोवा ह पहाड़ ऊपर आगी म होके सभा के दिन तुमन ला बताय रिहिस।<verse eid="DEU 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 9:11"/>चालीस दिन अऊ चालीस रात के आखिरी म यहोवा ह मोला ओ दू ठन पथरा के पटियामन ला दीस, जेमन करार के पटिया रिहिन। <verse eid="DEU 9:11"/><verse number="12" style="v" sid="DEU 9:12"/>तब यहोवा ह मोला कहिस, “तें इहां ले तुरते खाल्हे उतर, काबरकि तोर मनखेमन बिगड़ गे हवंय, जेमन ला तें मिसर देस ले निकालके लाने हस। ओमन ओ रसता ला बहुंत जल्दी छोंड़ दे हवंय, जेकर हुकूम मेंह ओमन ला दे रहेंव अऊ ओमन अपन बर एक मूरती बना ले हवंय।”<verse eid="DEU 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 9:13"/>फेर यहोवा ह मोला ये घलो कहिस, “मेंह ये मनखेमन ला देखे हंव, अऊ येमन असल म एक हठीला जाति के मनखे अंय! <verse eid="DEU 9:13"/><verse number="14" style="v" sid="DEU 9:14"/>मोला अकेला छोंड़ दे, ताकि मेंह ओमन ला नास कर देवंव अऊ धरती ऊपर ले ओमन के नांव ला मिटा देवंव। अऊ मेंह तोर ले एक जाति बनाहूं, जऊन ह ओमन ले जादा सक्तिसाली अऊ संखिया म ओमन ले जादा होही।”<verse eid="DEU 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 9:15"/>तब मेंह मुड़ें अऊ पहाड़ ले खाल्हे उतरेंव जबकि पहाड़ ह आगी ले धधकत रिहिस। अऊ करार के ओ दूनों पटिया मोर हांथ म रिहिस। <verse eid="DEU 9:15"/><verse number="16" style="v" sid="DEU 9:16"/>तब मेंह देखेंव कि तुमन यहोवा अपन परमेसर के बिरूध पाप करे रहेव; तुमन बछवा के आकार म एक ठन मूरती बना ले रहेव। तुमन ओ रसता ला बहुंत जल्दी छोंड़ दे रहेव, जेकर हुकूम यहोवा ह तुमन ला दे रिहिस। <verse eid="DEU 9:16"/><verse number="17" style="v" sid="DEU 9:17"/>एकरसेति मेंह ओ दूनों पटिया ला मोर हांथ ले फटिक देंव, अऊ ओमन ला तुम्हर आंखी के आघू म टोरके कुटा-कुटा कर देंव।<verse eid="DEU 9:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 9:18"/>तब तुम्हर करे गय ओ जम्मो पाप के कारन, जऊन ह यहोवा के नजर म बुरई रिहिस अऊ जेकर ले ओकर गुस्सा ह भड़किस, मेंह फेर एक बार यहोवा के आघू म चालीस दिन अऊ चालीस रात सीधा पड़े रहेंव; मेंह न तो जेवन करेंव अऊ न ही पानी पीयेंव। <verse eid="DEU 9:18"/><verse number="19" style="v" sid="DEU 9:19"/>मेंह यहोवा के कोरोध अऊ कोप ले डरत रहेंव, काबरकि ओह अतेक गुस्सा म रिहिस कि तुमन ला नास करे चाहत रिहिस। पर एक बार फेर यहोवा ह मोर बात ला सुनिस। <verse eid="DEU 9:19"/><verse number="20" style="v" sid="DEU 9:20"/>अऊ यहोवा ह हारून ऊपर अतेक गुस्सा होईस कि ओला नास करे चाहत रिहिस, पर ओ समय मेंह हारून बर घलो पराथना करेंव। <verse eid="DEU 9:20"/><verse number="21" style="v" sid="DEU 9:21"/>मेंह तुम्हर ओ पापमय चीज—ओ बछवा ला लेंव, जेला तुमन बनाय रहेव, अऊ ओला आगी म जला देंव। तब मेंह ओला कुचर देंव अऊ ओला चूर-चूर करके धुर्रा सहीं कर देंव अऊ ओ धुर्रा ला एक ठन नरवा म फटिक देंव, जऊन ह पहाड़ ले खाल्हे बहत रिहिस।<verse eid="DEU 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 9:22"/>तुमन यहोवा ला तबेरा, मस्सा अऊ किबरोत-हतावा म घलो गुस्सा दिलाय रहेव।<note caller="+" style="f"><char style="fr" closed="false">9:22 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="NUM 11:1-3">गन 11:1‑3</ref>; <ref loc="NUM 11:31-34">11:31‑34</ref>; <ref loc="EXO 17:1-7">निर 17:1‑7</ref></char></char></note><verse eid="DEU 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 9:23"/>अऊ जब यहोवा ह तुमन ला कादेस-बरने ले भेजिस, त ओह कहिस, “जावव अऊ ओ देस ऊपर अधिकार कर लेवव, जेला में तुमन ला दे हवंव।” पर तुमन यहोवा तुम्हर परमेसर के बिरूध बिदरोह करेव। तुमन न तो ओकर ऊपर भरोसा करेव अऊ न ही ओकर बात मानेव। <verse eid="DEU 9:23"/><verse number="24" style="v" sid="DEU 9:24"/>जब ले में तुमन ला जानत हंव, तब ले तुमन यहोवा के बिरूध बिदरोह ही करत आय हवव।<verse eid="DEU 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 9:25"/>मेंह ओ चालीस दिन अऊ चालीस रात यहोवा के आघू म मुहूं-भरसा पड़े रहेंव काबरकि यहोवा ह कहे रिहिस कि ओह तुमन ला नास कर दीही। <verse eid="DEU 9:25"/><verse number="26" style="v" sid="DEU 9:26"/>में यहोवा ले पराथना करके कहेंव, “हे परमपरधान यहोवा, अपन मनखेमन ला नास झन कर; येमन तोर निज भाग अंय, जेमन ला तेंह अपन बड़े सामर्थ से छोंड़ाय हस अऊ अपन सक्तिसाली हांथ से येमन ला मिसर देस ले निकाल लाने हस। <verse eid="DEU 9:26"/><verse number="27" style="v" sid="DEU 9:27"/>अपन सेवक अब्राहम, इसहाक अऊ याकूब ला सुरता कर। ये मनखेमन के हठीलापन, ओमन के दुस्टता अऊ ओमन के पाप ला अनदेखी कर। <verse eid="DEU 9:27"/><verse number="28" style="v" sid="DEU 9:28"/>नइं तो, जऊन देस ले तेंह हमन ला निकालके लाने हस, उहां के मनखेमन<note caller="+" style="f"><char style="fr" closed="false">9:28 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">मिसरीमन</char></note> कहिहीं, ‘काबरकि यहोवा ह ओमन ला ओ देस म नइं ले जा सकिस, जेकर परतिगियां ओह ओमन ले करे रिहिस, अऊ काबरकि ओह ओमन ले घिन करिस, एकरसेति ओह ओमन ला बाहिर निकालिस ताकि निरजन प्रदेस म ओमन ला मार डारय।’ <verse eid="DEU 9:28"/><verse number="29" style="v" sid="DEU 9:29"/>पर ओमन तोर मनखे अंय, तोर निज भाग, जेमन ला तें अपन बड़े सामर्थ अऊ अपन बढ़ाय भुजा के दुवारा निकालके ले आय।”<verse eid="DEU 9:29"/></para>
  <chapter eid="DEU 9"/>
  <chapter number="10" style="c" sid="DEU 10"/>
  <para style="s1">पहिली के पटियामन सहीं आने पटियामन</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 10:1"/>ओ बेरा यहोवा ह मोला कहिस, “पहिली के पटियामन सहीं दू ठन पथरा के पटिया काटके बना ले अऊ मोर करा पहाड़ ऊपर आ। अऊ लकड़ी के एक ठन सन्दूक घलो बना। <verse eid="DEU 10:1"/><verse number="2" style="v" sid="DEU 10:2"/>में ये पटियामन म ओ बचनमन ला फेर लिख दूहूं, जेमन पहिली के पटियामन म रिहिन, जेमन ला तें टोर देय। तब तें ओ पटियामन ला सन्दूक म रख देबे।”<verse eid="DEU 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 10:3"/>तब में बंबरी लकड़ी के एक सन्दूक बनांय अऊ पहिली सहीं काटके पथरामन के दू ठन पटिया बनांय, अऊ दूनों पटियामन ला हांथ म धरके में पहाड़ ऊपर गेंव। <verse eid="DEU 10:3"/><verse number="4" style="v" sid="DEU 10:4"/>यहोवा ह ओ पटियामन म ओ बातमन ला लिख दीस, जेला ओह पहिली के पटियामन म लिखे रिहिस—ओ दस हुकूम, जेला ओह सभा के दिन पहाड़ ऊपर आगी म ले कहे रिहिस। अऊ यहोवा ह ओ पटियामन ला मोला दे दीस। <verse eid="DEU 10:4"/><verse number="5" style="v" sid="DEU 10:5"/>तब में पहाड़ ले खाल्हे उतरेंव अऊ ओ पटियामन ला मेंह ओ सन्दूक म रख देंव, जेला में बनाय रहेंव, जइसे कि यहोवा ह मोला हुकूम देय रिहिस, अऊ ओमन अब उहां हवंय।<verse eid="DEU 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 10:6"/>(तब इसरायलीमन बेने-जाकन के कुआंमन ले आघू बढ़के मोसेरा करा आईन। उहां हारून मर गीस अऊ ओला उहां माटी दिये गीस, अऊ ओकर जगह म ओकर बेटा एलिआजर ह पुरोहित के रूप म सेवा करे लगिस। <verse eid="DEU 10:6"/><verse number="7" style="v" sid="DEU 10:7"/>उहां ले ओमन गुदगोदा अऊ गुदगोदा ले योतबाता आईन, जऊन ह पानी के सोतामन के एक देस रिहिस। <verse eid="DEU 10:7"/><verse number="8" style="v" sid="DEU 10:8"/>ओ समय यहोवा ह लेवी के गोत्र ला अलग करिस ताकि ओमन यहोवा के करार के सन्दूक ला उठाके ले जावंय; यहोवा के सेवा करे बर ओकर आघू म ठाढ़ रहंय अऊ ओकर नांव म आसीस देवंय, जइसे कि ओमन आज घलो करथें। <verse eid="DEU 10:8"/><verse number="9" style="v" sid="DEU 10:9"/>एकरे कारन लेवीमन ला ओमन के संगी इसरायलीमन के संग कोनो बांटा या भाग नइं मिलिस; यहोवा ह ओमन के निज भाग ए, जइसे कि यहोवा तुम्हर परमेसर ह ओमन ला कहिस।)<verse eid="DEU 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 10:10"/>मेंह पहिले सहीं पहाड़ ऊपर चालीस दिन अऊ चालीस रात रूके रहेंव, अऊ यहोवा ह ये समय घलो मोर बात ला सुनिस। तुमन ला नास करे के अपन ईछा ला छोंड़ दे रिहिस। <verse eid="DEU 10:10"/><verse number="11" style="v" sid="DEU 10:11"/>तब यहोवा ह मोला कहिस, “जा अऊ मनखेमन ला ओमन के रसता म अगुवई कर, ताकि ओमन ओ देस म जाके ओकर ऊपर अधिकार करंय, जेला देय के सपथ मेंह ओमन के पुरखामन ले खाय रहेंव।”<verse eid="DEU 10:11"/></para>
  <para style="s1">यहोवा के भय मानव</para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 10:12"/>अऊ अब, हे इसरायलीमन, यहोवा तुम्हर परमेसर ह तुमन ले का चाहथे, ये कि सिरिप तुमन यहोवा अपन परमेसर के भय मानव, ओकर हुकूम म चलव, ओकर ले मया करव, यहोवा अपन परमेसर के सेवा अपन पूरा मन अऊ अपन पूरा आतमा ले करव, <verse eid="DEU 10:12"/><verse number="13" style="v" sid="DEU 10:13"/>अऊ यहोवा के हुकूम अऊ बिधिमन के पालन करव, जेला मेंह आज तुमन ला तुम्हर खुद के भलई बर देवत हंव?<verse eid="DEU 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 10:14"/>अकास, अऊ त अऊ सबले ऊंच स्वरग, धरती अऊ येमा के हर एक चीज यहोवा तुम्हर परमेसर के अय। <verse eid="DEU 10:14"/><verse number="15" style="v" sid="DEU 10:15"/>तभो ले यहोवा ह तुम्हर पुरखामन ऊपर अपन लगाव बनाय रखिस अऊ ओमन ले मया करिस, अऊ ओह ओमन के संतान—तुमन ला जम्मो जाति के मनखेमन के बीच म ले चुनिस, जइसे कि येह आज हवय। <verse eid="DEU 10:15"/><verse number="16" style="v" sid="DEU 10:16"/>एकरसेति, अपन हिरदय के खतना करव, अऊ अब हठीला झन बने रहव। <verse eid="DEU 10:16"/><verse number="17" style="v" sid="DEU 10:17"/>काबरकि यहोवा तुम्हर परमेसर ह देवतामन के परमेसर अऊ परभूमन के परभू, महान परमेसर, सक्तिसाली अऊ अद्भूत परमेसर अय, जऊन ह कोनो भेदभाव नइं करय अऊ न ही घूस लेवय। <verse eid="DEU 10:17"/><verse number="18" style="v" sid="DEU 10:18"/>ओह अनाथ अऊ बिधवामन के बचाव करथे, अऊ तुम्हर बीच रहइया परदेसीमन ले ओह मया करथे, अऊ ओमन ला जेवन अऊ कपड़ा देथे। <verse eid="DEU 10:18"/><verse number="19" style="v" sid="DEU 10:19"/>अऊ तुमन घलो ओमन ले मया करव, जेमन परदेसी अंय, काबरकि तुमन खुद मिसर देस म परदेसी रहेव। <verse eid="DEU 10:19"/><verse number="20" style="v" sid="DEU 10:20"/>यहोवा अपन परमेसर के भय मानव अऊ ओकर सेवा करव। ओला कसके पकड़े रहव अऊ ओकर ही नांव म सपथ खावव। <verse eid="DEU 10:20"/><verse number="21" style="v" sid="DEU 10:21"/>येह ओ अय, जेकर तुमन परसंसा करथव; ओह तुम्हर परमेसर ए, जऊन ह तुम्हर बर ओ बड़े अऊ अद्भूत काममन ला करिस, जेला तुमन खुद अपन आंखी ले देखे हव। <verse eid="DEU 10:21"/><verse number="22" style="v" sid="DEU 10:22"/>जब तुम्हर पुरखामन मिसर देस म गीन, त ओमन सिरिप सत्तर मनखे ही रिहिन, पर अब यहोवा तुम्हर परमेसर ह तुमन ला अकास के तारामन सहीं बहुंत अकन कर दे हवय।<verse eid="DEU 10:22"/></para>
  <chapter eid="DEU 10"/>
  <chapter number="11" style="c" sid="DEU 11"/>
  <para style="s1">यहोवा ले मया करव अऊ ओकर हुकूम मानव</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 11:1"/>यहोवा अपन परमेसर ले मया करव अऊ ओकर मांग, ओकर बिधि, ओकर कानून अऊ ओकर हुकूममन ला हमेसा मानव। <verse eid="DEU 11:1"/><verse number="2" style="v" sid="DEU 11:2"/>आज सुरता रखव कि तुम्हर लइकामन ओ चीजमन ला न तो देखे हवंय न ही ओकर अनुभव करे हवंय—याने कि यहोवा तुम्हर परमेसर के अनुसासन, ओकर वैभव, ओकर सक्तिसाली हांथ, ओकर बढ़ाय गय भुजा ला; <verse eid="DEU 11:2"/><verse number="3" style="v" sid="DEU 11:3"/>ओकर देखाय गय अद्भूत चिनहां अऊ मिसर देस के बीच म करे गय ओकर काम, जेला मिसर देस के राजा फिरौन अऊ ओकर जम्मो देस के संग करिस; <verse eid="DEU 11:3"/><verse number="4" style="v" sid="DEU 11:4"/>यहोवा ह मिसर देस के सेना, ओमन के घोड़ा अऊ रथमन के संग का करिस, जब ओमन तुम्हर पीछा करत रिहिन, त ओह लाल-समुंदर के पानी ले ओमन ला कइसे घबरा दीस अऊ कइसे यहोवा ह ओमन के सर्वनास कर दीस। <verse eid="DEU 11:4"/><verse number="5" style="v" sid="DEU 11:5"/>तुम्हर लइकामन नइं देखे हवंय कि ये जगह म हबरत तक ओह सुन्ना जगह म तुम्हर बर का करिस, <verse eid="DEU 11:5"/><verse number="6" style="v" sid="DEU 11:6"/>अऊ ओह रूबेनी एलीआब के बेटा दातान अऊ अबीराम के संग का करिस, जब धरती ह जम्मो इसरायलीमन के मांझा म अपन मुहूं खोलिस अऊ ओमन ला ओमन के परिवार के संग अऊ ओमन के तम्बू अऊ ओमा के हर जीयत चीजमन ला लील लीस।<note caller="+" style="f"><char style="fr" closed="false">11:6 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="NUM 16">गन 16</ref></char></char></note> <verse eid="DEU 11:6"/><verse number="7" style="v" sid="DEU 11:7"/>पर तुमन खुद अपन आंखी ले ये जम्मो बड़े काममन ला देखे हव, जेला यहोवा ह करिस।<verse eid="DEU 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 11:8"/>एकर कारन ओ जम्मो हुकूममन के पालन करव, जेला मेंह आज तुमन ला देवत हंव, ताकि तुमन ला आघू बढ़े बर ताकत मिलय अऊ तुमन ओ देस ला अपन अधीन कर लेवव, जेला अपन अधिकार म करे बर तुमन यरदन के ओ पार जावत हव, <verse eid="DEU 11:8"/><verse number="9" style="v" sid="DEU 11:9"/>अऊ तुमन ओ देस म लम्बा समय तक रहव, जेला यहोवा ह तुम्हर पुरखा अऊ ओमन के संतानमन ला देय के सपथ खाय रिहिस; ये देस म दूध अऊ मंधरस बहुंतायत म हवय। <verse eid="DEU 11:9"/><verse number="10" style="v" sid="DEU 11:10"/>जऊन देस म तुमन ओकर ऊपर अधिकार करे बर जावत हव, ओह ओ मिसर देस के सहीं नो हय, जिहां ले तुमन निकलके आय हव, जिहां तुमन बीजा ला बोए के बाद गोड़ ले नाली बनाके पानी पलोत रहेव, जइसे कि साग-सब्जी के बारी म करे जाथे। <verse eid="DEU 11:10"/><verse number="11" style="v" sid="DEU 11:11"/>पर जऊन देस ऊपर अधिकार करे बर तुमन यरदन ला पार करके जावत हव, ओह पहाड़ अऊ घाटीमन के देस अय, जिहां अकास के बारिस ले सिंचई होथे। <verse eid="DEU 11:11"/><verse number="12" style="v" sid="DEU 11:12"/>येह ओ देस अय, जेकर देखभाल यहोवा तुम्हर परमेसर करथे; अऊ साल के सुरू ले लेके आखिरी तक यहोवा तुम्हर परमेसर के नजर हमेसा येकर ऊपर बने रहिथे।<verse eid="DEU 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 11:13"/>एकरसेति यदि तुमन ईमानदारी से ओ हुकूममन ला मानथव, जेला मेंह आज तुमन ला देवत हंव—यहोवा अपन परमेसर ले मया करव अऊ अपन पूरा मन अऊ अपन पूरा आतमा से ओकर सेवा करव, <verse eid="DEU 11:13"/><verse number="14" style="v" sid="DEU 11:14"/>तब मेंह सही मौसम म तुम्हर देस म बारिस भेजहूं, सुरूआती अऊ अंतिम बारिस, ताकि तुमन अपन अनाज, नवां अंगूर के मंद अऊ जैतून तेल के फसल ले सकव। <verse eid="DEU 11:14"/><verse number="15" style="v" sid="DEU 11:15"/>मेंह तुम्हर पसुमन बर मैदान म घांस उपजाहूं, अऊ तुमन भरपेट खाहू अऊ संतुस्ट होहू।<verse eid="DEU 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 11:16"/>सचेत रहव, नइं तो तुमन ला बहकाय जाही कि तुमन अपन परमेसर ला छोंड़के आने देवतामन के अराधना करव अऊ ओमन के दंडवत करव। <verse eid="DEU 11:16"/><verse number="17" style="v" sid="DEU 11:17"/>तब यहोवा के कोरोध ह तुम्हर ऊपर भड़कही, अऊ ओह अकास के बारिस ला बंद कर दीही अऊ भुइयां म कोनो फसल नइं होही, अऊ तुमन ओ बने देस म ले जल्दी नास हो जाहू, जेला यहोवा ह तुमन ला देवत हे। <verse eid="DEU 11:17"/><verse number="18" style="v" sid="DEU 11:18"/>एकरसेति मोर ये बातमन ला अपन हिरदय अऊ मन म रख लव; येमन ला चिनहां के रूप म अपन हांथ म बांध लव अऊ येमन ला अपन माथा म बांध लव। <verse eid="DEU 11:18"/><verse number="19" style="v" sid="DEU 11:19"/>ये बातमन ला अपन लइकामन ला सिखावव, जब तुमन घर म बईठथव अऊ जब तुमन डहार म रेंगथव, जब तुमन लेटथव अऊ उठथव, त येमन के बारे म गोठियाय करव। <verse eid="DEU 11:19"/><verse number="20" style="v" sid="DEU 11:20"/>येमन ला अपन घर के चौखटमन म अऊ अपन दुवारमन म लिखव, <verse eid="DEU 11:20"/><verse number="21" style="v" sid="DEU 11:21"/>ताकि जऊन देस ला यहोवा ह तुम्हर पुरखामन ला देय के सपथ खाय रिहिस, ओ देस म तुमन अऊ तुम्हर लइकामन तब तक बने रहव, जब तक कि धरती ऊपर अकास ह बने रहिथे।<verse eid="DEU 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 11:22"/>यदि तुमन धियान देके ये जम्मो हुकूम के पालन करव, जेला मेंह माने बर तुमन ला देवत हंव—यहोवा अपन परमेसर ले मया करव, ओकर हुकूम म चलव अऊ ओला कसके पकड़े रहव, <verse eid="DEU 11:22"/><verse number="23" style="v" sid="DEU 11:23"/>तब यहोवा ह ये जम्मो जाति के मनखेमन ला तुम्हर आघू ले भगा दीही, अऊ तुमन अपन ले बड़े अऊ सक्तिसाली जाति के मनखेमन ला निकाल दूहू। <verse eid="DEU 11:23"/><verse number="24" style="v" sid="DEU 11:24"/>हर ओ जगह जिहां तुमन अपन गोड़ रखहू, ओह तुम्हर हो जाही: तुम्हर राज ह निरजन प्रदेस ले लेके लबानोन, अऊ फरात नदी ले लेके भूमध्य सागर तक फईल जाही। <verse eid="DEU 11:24"/><verse number="25" style="v" sid="DEU 11:25"/>कोनो भी मनखे तुम्हर सामना नइं कर सकही। जइसे कि यहोवा तुम्हर परमेसर ह तुम्हर ले परतिगियां करे हवय, ओह तुम्हर आतंक अऊ भय ओ पूरा देस म फईला दीही, जिहां कहीं भी तुमन जावव।<verse eid="DEU 11:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 11:26"/>देखव, आज में तुम्हर आघू म आसीस अऊ सराप दूनों ला रखत हंव— <verse eid="DEU 11:26"/><verse number="27" style="v" sid="DEU 11:27"/>यदि तुमन यहोवा तुम्हर परमेसर के ओ हुकूममन ला मानहू, जेला मेंह आज तुमन ला देवत हंव, त तुमन ला आसीस मिलही; <verse eid="DEU 11:27"/><verse number="28" style="v" sid="DEU 11:28"/>अऊ यदि यहोवा तुम्हर परमेसर के हुकूममन ला नइं मानहू, जेला मेंह आज तुमन ला देवत हंव अऊ यदि तुमन ओकर रसता ला छोंड़के आने देवतामन के पाछू चलहू, जेमन ला तुमन जानत घलो नइं रहेव, त तुमन ला सराप मिलही। <verse eid="DEU 11:28"/><verse number="29" style="v" sid="DEU 11:29"/>जब यहोवा तुम्हर परमेसर ह तुमन ला ओ देस म ले आय, जेकर ऊपर अधिकार करे बर तुमन जावत हव, तब तुमन ला गरीजीम पहाड़ ले आसीस, अऊ एबाल पहाड़ ले सराप के घोसना करना हे। <verse eid="DEU 11:29"/><verse number="30" style="v" sid="DEU 11:30"/>जइसे कि तुमन जानत हव, ये पहाड़मन यरदन के ओ पार, पछिम दिग म, सूरज के बुड़ती कोति, मोरे के बड़े रूखमन के लकठा, अराबा म रहइया ओ कनानीमन के छेत्र गिलगाल नगर के पड़ोस म हवंय। <verse eid="DEU 11:30"/><verse number="31" style="v" sid="DEU 11:31"/>तुमन यरदन के ओ पार जाके ओ देस ऊपर अधिकार करनेचवाला हव, जेला यहोवा तुम्हर परमेसर ह तुमन ला देवत हे। जब तुमन ओकर ऊपर अधिकार कर लेवव अऊ उहां रहे लगव, <verse eid="DEU 11:31"/><verse number="32" style="v" sid="DEU 11:32"/>तब धियान रहय कि तुमन ओ जम्मो बिधि अऊ कानूनमन के पालन करव, जेला मेंह आज तुम्हर आघू म रखत हंव।<verse eid="DEU 11:32"/></para>
  <chapter eid="DEU 11"/>
  <chapter number="12" style="c" sid="DEU 12"/>
  <para style="s1">अराधना करे के एके ठन जगह</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 12:1"/>येमन ओ बिधि अऊ कानून अंय, जेकर पालन तुमन ला धियान देके ओ देस म करना हे, जेला यहोवा, तुम्हर पुरखामन के परमेसर ह तुमन ला अपन अधिकार म करे बर दे हवय—जब तक तुमन ओ देस म जीयत हव, येमन के पालन करना हे। <verse eid="DEU 12:1"/><verse number="2" style="v" sid="DEU 12:2"/>तुमन ओ जम्मो जगह ला पूरा नास कर दव, जेमन ऊंच पहाड़, पहाड़ी ऊपर अऊ रूखमन के छइहां म हवंय, जिहां ओ आनजात के मनखेमन अपन देवतामन के अराधना करथें, जेमन ला तुमन बेदखल करत हव। <verse eid="DEU 12:2"/><verse number="3" style="v" sid="DEU 12:3"/>ओमन के बेदीमन ला टोर दव, ओमन के पबितर पथरामन ला कुटा-कुटा कर दव अऊ ओमन के असेरा के खंभामन ला आगी म जला दव; ओमन के देवतामन के मूरतीमन ला काट डारव अऊ ओ जगहमन ले ओमन के नांव ला मिटा दव।<verse eid="DEU 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 12:4"/>तुमन यहोवा अपन परमेसर के अराधना ओमन सहीं झन करहू। <verse eid="DEU 12:4"/><verse number="5" style="v" sid="DEU 12:5"/>पर तुमन ओ जगह ला चुनव, जेला यहोवा तुम्हर परमेसर ह तुम्हर जम्मो गोत्रमन के बीच म ले देखाथे कि ओह अपन निवास बर अपन नांव ला उहां रखय। ओ जगह म तुमन जावव; <verse eid="DEU 12:5"/><verse number="6" style="v" sid="DEU 12:6"/>अऊ उहां अपन होम-बलिदान अऊ चढ़ावा, अपन दसमांस अऊ बिसेस दान, मन्नत म माने गय भेंट अऊ अपन स्वेच्छा-बलिदान, अऊ गाय-बईला अऊ पसु-चिरईमन के पहिलांतमन ला लानव। <verse eid="DEU 12:6"/><verse number="7" style="v" sid="DEU 12:7"/>उहां यहोवा अपन परमेसर के आघू म तुमन अऊ तुम्हर परिवार के मनखेमन खावंय अऊ ओ जम्मो चीज बर आनंद मनावंय, जेमा तुमन अपन हांथ रखे हव, काबरकि यहोवा तुम्हर परमेसर ह तुमन ला आसीस दे हवय।<verse eid="DEU 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 12:8"/>तुमन ला वइसने नइं करना हे, जइसने कि हमन आज करत हन; हर एक जन वइसने ही करत हे, जइसने ओला बने लगथे, <verse eid="DEU 12:8"/><verse number="9" style="v" sid="DEU 12:9"/>काबरकि तुमन ओ अराम के जगह अऊ निज भाग म अभी तक नइं हबरे हव, जेला यहोवा तुम्हर परमेसर ह तुमन ला देवत हे। <verse eid="DEU 12:9"/><verse number="10" style="v" sid="DEU 12:10"/>पर तुमन यरदन नदी के ओ पार जाहू अऊ ओ देस म बस जाहू, जेला यहोवा तुम्हर परमेसर ह तुमन ला एक उत्तराधिकार के रूप म देवत हे, अऊ ओह तुमन ला तुम्हर चारों कोति के बईरीमन ले सुरकछा दीही, ताकि तुमन अराम से रहव। <verse eid="DEU 12:10"/><verse number="11" style="v" sid="DEU 12:11"/>तब ओ जगह म, जेला यहोवा तुम्हर परमेसर ह अपन नांव बर निवास के रूप म चुनही—उहां तुमन ओ जम्मो चीजमन ला ले आवव, जेकर हुकूम मेंह तुमन ला देवत हंव: तुम्हर होम-बलिदान अऊ चढ़ावा, तुम्हर दसमांस अऊ बिसेस दान, अऊ ओ जम्मो उत्तम चीज, जेला तुमन यहोवा बर मन्नत माने हव। <verse eid="DEU 12:11"/><verse number="12" style="v" sid="DEU 12:12"/>अऊ उहां यहोवा अपन परमेसर के आघू म आनंद मनावव—तुमन, तुम्हर बेटा-बेटीमन, तुम्हर सेवक-सेविकामन, अऊ ओ लेवीमन, जेमन तुम्हर नगर म रहिथें अऊ ओमन ला ओमन के नगर म कोनो जमीन या निज भाग नइं मिले हवय। <verse eid="DEU 12:12"/><verse number="13" style="v" sid="DEU 12:13"/>ये बात के धियान रहय कि तुमन अपन होम-बलिदान ला अइसने कोनो आने जगह म झन चघाहू, जेह तुमन ला बने लगय। <verse eid="DEU 12:13"/><verse number="14" style="v" sid="DEU 12:14"/>पर अपन बलिदान ला ओ जगह म चघावव, जेला यहोवा ह तुम्हर गोत्रमन ले चुनथे, अऊ उहां ओ जम्मो काम करव, जेकर हुकूम मेंह तुमन ला देवत हंव।<verse eid="DEU 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 12:15"/>पर तुमन अपन कोनो भी नगर म अपन पसु ला मारके ओकर जतेक मांस चाहव, ओतेक खा सकत हव, चाहे ओह छोटे हिरन होवय या बड़े हिरन, जइसे भी यहोवा तुम्हर परमेसर तुमन ला आसीस देथे। संस्कारिक रूप से सुध या असुध दूनों किसम के मनखे येला खा सकत हें। <verse eid="DEU 12:15"/><verse number="16" style="v" sid="DEU 12:16"/>तुमन येकर लहू ला झन खावव; ओला भुइयां म पानी सहीं रितो दव। <verse eid="DEU 12:16"/><verse number="17" style="v" sid="DEU 12:17"/>तुमन अपन अनाज अऊ नवां अंगूर के मंद अऊ जैतून तेल के दसमांस, या गाय-बईला अऊ पसु-चिरईमन के पहिलांत, या अपन मन्नत माने गय कोनो चीज, या स्वेच्छा-बलिदान या बिसेस दान ला अपन खुद के नगर म झन खावव। <verse eid="DEU 12:17"/><verse number="18" style="v" sid="DEU 12:18"/>येकर बदले, तुमन येमन ला यहोवा तुम्हर परमेसर के आघू म ओ जगह म खावव, जेला यहोवा तुम्हर परमेसर ह चुनही—तुमन, तुम्हर बेटा-बेटीमन, तुम्हर सेवक-सेविकामन, अऊ तुम्हर नगर के लेवीमन खावंव—अऊ तुमन यहोवा अपन परमेसर के आघू म ओ जम्मो चीज बर आनंद मनावव, जेमा तुमन हांथ रखे हव। <verse eid="DEU 12:18"/><verse number="19" style="v" sid="DEU 12:19"/>ये बात के धियान रहय कि जब तक तुमन अपन देस म जीयत हवव, तब तक लेवीमन के अनदेखी झन करव।<verse eid="DEU 12:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 12:20"/>जब यहोवा तुम्हर परमेसर ह तुम्हर इलाका ला बढ़ाथे जइसे कि ओह वायदा करे हवय, अऊ तुमन मांस खाय के ईछा करव अऊ कहव, “कुछू मांस खाय के मोर मन करत हे,” तब तुमन येला जतेक चाहव ओतेक खा सकत हव। <verse eid="DEU 12:20"/><verse number="21" style="v" sid="DEU 12:21"/>यदि ओ जगह ह तुमन ले बहुंत दूरिहा हवय, जेला परमेसर ह अपन नांव ला रखे बर चुनथे, त तुमन मोर हुकूम के मुताबिक यहोवा के दिये गाय-बईला अऊ पसु-चिरईमन के झुंड ले पसु ला मारव, अऊ अपन खुद के नगर म ओला जतेक चाहव ओतेक खा सकत हव।<note caller="+" style="f"><char style="fr" closed="false">12:21 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="LEV 14:24">लैव्य 14:24</ref></char></char></note> <verse eid="DEU 12:21"/><verse number="22" style="v" sid="DEU 12:22"/>ओला खावव, जइसे तुमन कोनो कोटरी या हिरन ला खाथव। संस्कारिक रूप ले सुध अऊ असुध दूनों किसम के मनखे ओला खा सकत हें। <verse eid="DEU 12:22"/><verse number="23" style="v" sid="DEU 12:23"/>पर धियान रहय कि तुमन लहू ला झन खावव, काबरकि लहू ह जिनगी अय, अऊ जरूरी अय कि तुमन मांस के संग जिनगी ला झन खावव। <verse eid="DEU 12:23"/><verse number="24" style="v" sid="DEU 12:24"/>तुमन लहू ला झन खावव; येला भुइयां म पानी सहीं रितो दव। <verse eid="DEU 12:24"/><verse number="25" style="v" sid="DEU 12:25"/>ओला झन खावव, ताकि तुम्हर अऊ तुम्हर बाद तुम्हर लइकामन के भलई होवय, काबरकि अइसने करके तुमन यहोवा के नजर म सही काम करहू।<verse eid="DEU 12:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 12:26"/>पर अपन पबितर चीज अऊ अपन मन्नत म देय बर चीजमन ला लेवव अऊ ओ जगह म जावव, जेला यहोवा ह चुनही। <verse eid="DEU 12:26"/><verse number="27" style="v" sid="DEU 12:27"/>अपन होम-बलिदान ला यहोवा अपन परमेसर के बेदी म चघावव, मांस अऊ लहू दूनों ला चघावव। तुम्हर बलिदान के लहू ला यहोवा तुम्हर परमेसर के बेदी के बाजू म रितोय जावव, पर मांस ला तुमन खा सकत हव। <verse eid="DEU 12:27"/><verse number="28" style="v" sid="DEU 12:28"/>धियान रहय कि तुमन मोर दिये गय ये जम्मो नियम के पालन करव, ताकि तुम्हर अऊ तुम्हर बाद तुम्हर लइकामन के हमेसा भलई होवय, काबरकि अइसने करके तुमन यहोवा अपन परमेसर के नजर म बने अऊ सही काम करहू।<verse eid="DEU 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="DEU 12:29"/>यहोवा तुम्हर परमेसर ह ओ जातिमन के मनखे ला तुम्हर आघू म नास कर दीही, जेमन ऊपर तुमन चढ़ई करके ओमन ला निकालनेचवाला हव। पर जब तुमन ओमन ला भगा देवव अऊ ओमन के देस म बस जावव, <verse eid="DEU 12:29"/><verse number="30" style="v" sid="DEU 12:30"/>अऊ ओमन तुम्हर आघू ले नास हो जावंय, त धियान रहय कि ओमन के देवतामन के बारे म पुछताछ करे के दुवारा ये कहिके झन फंसव, “ये जातिमन के मनखेमन अपन देवतामन के सेवा कइसे करत रिहिन? हमन घलो वइसने करबो।” <verse eid="DEU 12:30"/><verse number="31" style="v" sid="DEU 12:31"/>जरूरी अय कि तुमन यहोवा अपन परमेसर के अराधना ओमन सहीं झन करव, ओमन जम्मो किसम के घिनौना काम करथें, जेकर ले यहोवा ह घिन करथे।<note caller="+" style="f"><char style="fr" closed="false">12:31 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="DEU 7:25-26">ब्यव 7:25‑26</ref></char></char></note> अऊ त अऊ ओमन अपन देवतामन बर बलिदान के रूप म अपन बेटा-बेटीमन ला आगी म जला देथें।<verse eid="DEU 12:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="DEU 12:32"/>धियान रहय कि तुमन ओ जम्मो बात के पालन करव, जेकर हुकूम मेंह तुमन ला देवत हंव; येमा न तो कुछू जोड़व, अऊ न ही येमा ले कुछू निकालव।<note caller="+" style="f"><char style="fr" closed="false">12:32 </char><char style="ft" closed="false">इबरानी म ये पद (<char style="xt"><ref loc="DEU 12:32">12:32</ref></char>) ला 13:1 गने गे हवय</char></note><verse eid="DEU 12:32"/></para>
  <chapter eid="DEU 12"/>
  <chapter number="13" style="c" sid="DEU 13"/>
  <para style="s1">आने देवतामन के अराधना करई</para>
  <para style="p">
    <note caller="+" style="f">
      <char style="fr" closed="false">13 </char>
      <char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="DEU 13:1-18">13:1‑18</ref></char> ला 13:2‑19 गने गे हवय</char>
    </note> <verse number="1" style="v" sid="DEU 13:1"/>यदि कोनो अगमजानी, या कोनो मनखे, जऊन ह सपना के दुवारा अगम के बात कहिथे, यदि अइसने मनखे तुम्हर बीच म आथे अऊ कोनो चिनहां या अद्भूत बात के घोसना करथे, <verse eid="DEU 13:1"/><verse number="2" style="v" sid="DEU 13:2"/>अऊ यदि ओ चिनहां या अद्भूत काम सही म हो जाथे, अऊ ओ अगमजानी ह कहिथे, “आवव, हमन आने देवतामन के पाछू चलन” (ओ देवता, जेमन ला तुमन नइं जानव) “अऊ ओमन के अराधना करन,” <verse eid="DEU 13:2"/><verse number="3" style="v" sid="DEU 13:3"/>त तुमन ओ अगमजानी या सपना देखइया के बात ला झन सुनहू; काबरकि यहोवा तुम्हर परमेसर ह ये पता लगाय बर परखत हे कि तुमन ओला अपन पूरा मन अऊ परान ले मया करथव कि नइं। <verse eid="DEU 13:3"/><verse number="4" style="v" sid="DEU 13:4"/>येह यहोवा तुम्हर परमेसर ए, जेकर पाछू तुमन ला चलना जरूरी ए, अऊ जरूरी ए कि तुमन ओकर आदर करव। ओकर हुकूम के पालन करव अऊ ओकर बात ला मानव; ओकर सेवा करव अऊ ओला कसके थामे रहव। <verse eid="DEU 13:4"/><verse number="5" style="v" sid="DEU 13:5"/>ओ अगमजानी या सपना देखइया मार डारे जावय, काबरकि ओह तुमन ला ओ यहोवा तुम्हर परमेसर के बिरूध म भड़काय हवय, जऊन ह तुमन ला मिसर देस ले बाहिर निकाल लानिस अऊ तुमन ला गुलामी के देस ले छोंड़ाईस। ओ अगमजानी या सपना देखइया ह तुमन ला ओ रसता ले हटाय के कोसिस करिस, जेमा चले के हुकूम यहोवा तुम्हर परमेसर ह तुमन ला देय हवय। येह जरूरी अय कि तुमन अपन बीच ले बुरई ला हटावव।<verse eid="DEU 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 13:6"/>यदि तुम्हर खुद के भाई, या तुम्हर बेटा या बेटी, या तुम्हर मयारू घरवाली, या तुम्हर नजदीकी संगवारी गुपत रूप म ये कहिके तुमन ला बहकाथे, “चलव, हमन आने देवतामन के अराधना करन” (ओ देवता जेला न तो तुमन जानथव अऊ न ही तुम्हर पुरखामन कभू जानिन, <verse eid="DEU 13:6"/><verse number="7" style="v" sid="DEU 13:7"/>तुम्हर चारों कोति के मनखेमन के देवता, चाहे लकठा के होवंय या दूरिहा के, या ओमन देस के एक छोर ले लेके दूसर छोर म होवंय), <verse eid="DEU 13:7"/><verse number="8" style="v" sid="DEU 13:8"/>ओमन के बात झन मानव या ओमन के बात ला झन सुनव। ओमन ऊपर दया झन देखावव। ओमन ला झन छोंड़व या ओमन के बचाव झन करव। <verse eid="DEU 13:8"/><verse number="9" style="v" sid="DEU 13:9"/>जरूरी अय कि तुमन ओमन ला मार डारव। ओमन ला मारे म तुम्हर हांथ पहिले उठे, अऊ तब आने जम्मो मनखेमन के। <verse eid="DEU 13:9"/><verse number="10" style="v" sid="DEU 13:10"/>पथरवाह करके ओमन ला मार डारव, काबरकि ओमन तुमन ला ओ यहोवा तुम्हर परमेसर ले अलग करे के कोसिस करे हवंय, जऊन ह तुमन ला मिसर देस ले, ओ गुलामी के देस ले बाहिर निकाल लानिस। <verse eid="DEU 13:10"/><verse number="11" style="v" sid="DEU 13:11"/>तब जम्मो इसरायली ये बात ला सुनके डरहीं, अऊ तुम्हर बीच म फेर कोनो मनखे अइसने दुस्ट काम नइं करही।<verse eid="DEU 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 13:12"/>जऊन नगरमन ला यहोवा तुम्हर परमेसर ह तुमन ला रहे बर दे हवय, यदि ओमा के कोनो नगर के बारे म ये सुनव <verse eid="DEU 13:12"/><verse number="13" style="v" sid="DEU 13:13"/>कि दुस्ट मनखेमन तुम्हर बीच म ले निकलके ओ नगर के मनखेमन ला ये कहिके भटका दे हवंय, “चलव, हमन आने देवतामन के अराधना करन” (ओ देवता, जेमन ला तुमन नइं जानव), <verse eid="DEU 13:13"/><verse number="14" style="v" sid="DEU 13:14"/>तब जरूरी अय कि तुमन पुछताछ करव, जांचव अऊ ओकर पूरा खोजबीन करव। अऊ यदि ये बात सच निकले अऊ येह साबित हो जावय कि ये घिनौना काम तुम्हर बीच म करे गे हवय, <verse eid="DEU 13:14"/><verse number="15" style="v" sid="DEU 13:15"/>त खचित तुमन ओ नगर म रहइया जम्मो झन ला तलवार ले मार डारव। तुमन ओला पूरा नास कर दव, उहां के मनखे अऊ पसु दूनों ला नास कर दव। <verse eid="DEU 13:15"/><verse number="16" style="v" sid="DEU 13:16"/>तुमन ओ नगर के जम्मो लूटे गय सामान ला सार्वजनिक चऊक म इकट्ठा करव अऊ ओ नगर अऊ ओकर लूटे गय जम्मो सामान ला यहोवा तुम्हर परमेसर बर एक पूरा होम-बलिदान के रूप म जला दव। ओ नगर ह हमेसा बर खंडहर बने रहय अऊ ओला फेर कभू झन बनाय जावय, <verse eid="DEU 13:16"/><verse number="17" style="v" sid="DEU 13:17"/>अऊ कोनो भी दंडित चीज तुम्हर हांथ म झन रहय। तब यहोवा ह अपन भयंकर कोरोध ला छोंड़के तुम्हर ऊपर दया देखाही, अऊ तुम्हर ऊपर किरपा करही। ओह तुम्हर संखिया ला बढ़ाही, जइसे कि ओह तुम्हर पुरखामन ले सपथ खाके वायदा करे रिहिस— <verse eid="DEU 13:17"/><verse number="18" style="v" sid="DEU 13:18"/>काबरकि तुमन यहोवा तुम्हर परमेसर के बात ला ओकर ओ जम्मो हुकूम ला माने के दुवारा पूरा करथव, जेला मेंह आज तुमन ला देवत हंव अऊ अइसे करके तुमन परमेसर के नजर म सही काम करत हव।<verse eid="DEU 13:18"/></para>
  <chapter eid="DEU 13"/>
  <chapter number="14" style="c" sid="DEU 14"/>
  <para style="s1">सुध अऊ असुध जेवन</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 14:1"/>तुमन यहोवा तुम्हर परमेसर के लइकामन अव। मरे मनखे बर अपन देहें ला झन काटव या अपन मुड़ के आघू के बाल ला झन मुड़ावव, <verse eid="DEU 14:1"/><verse number="2" style="v" sid="DEU 14:2"/>काबरकि तुमन यहोवा तुम्हर परमेसर बर पबितर मनखे अव। धरती के जम्मो मनखेमन ले यहोवा ह तुमन ला अपन कीमती भाग होय बर चुन ले हवय।<verse eid="DEU 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 14:3"/>तुमन कोनो घिनौना चीज ला झन खाहू। <verse eid="DEU 14:3"/><verse number="4" style="v" sid="DEU 14:4"/>ये पसुमन ला तुमन खा सकत हव: बईला, भेड़, बोकरा, <verse eid="DEU 14:4"/><verse number="5" style="v" sid="DEU 14:5"/>हिरन, चिकारा, हिरनी, जंगली बोकरा, बड़े सींगवाला पहाड़ी बोकरा, कुरंग अऊ पहाड़ी भेड़।<note caller="+" style="f"><char style="fr" closed="false">14:5 </char><char style="ft" closed="false">ये अधियाय म कुछू चिरई अऊ पसुमन के पहिचान निस्चित नइं ए</char></note> <verse eid="DEU 14:5"/><verse number="6" style="v" sid="DEU 14:6"/>तुमन कोनो भी अइसने पसु ला खा सकत हव, जेकर फटे खुर हवय अऊ ओह पागुर करथे। <verse eid="DEU 14:6"/><verse number="7" style="v" sid="DEU 14:7"/>पर जऊन मन पागुर करथें या फेर सिरिप फटे खुर के होथें, ओमन ला झन खाहू—ऊंट, खरगोस या कबर-बिज्जू। हालाकि येमन पागुर करथें, पर येमन के खुर फटे नइं रहय; ओमन बिधि के मुताबिक तुम्हर बर असुध अंय। <verse eid="DEU 14:7"/><verse number="8" style="v" sid="DEU 14:8"/>सूरा ह घलो असुध अय; हालाकि येकर खुर ह फटे रहिथे, पर येह पागुर नइं करय। तुमन ओमन के मांस झन खावव अऊ न ही ओमन के लास ला छुवव।<verse eid="DEU 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 14:9"/>पानी म जतेक जीव-जन्तु हवंय, ओमा के जेकर पंख अऊ बिस्सर छिलका<note caller="+" style="f"><char style="fr" closed="false">14:9 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सल्क या सेहरा</char></note> होथे, ओमन ला तुमन खा सकत हव। <verse eid="DEU 14:9"/><verse number="10" style="v" sid="DEU 14:10"/>पर जेकर पंख अऊ बिस्सर छिलका नइं होवय, ओला झन खावव; काबरकि ओह असुध ए।<verse eid="DEU 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 14:11"/>तुमन कोनो भी सुध चिरई ला खा सकत हव। <verse eid="DEU 14:11"/><verse number="12" style="v" sid="DEU 14:12"/>पर येमन ला तुमन झन खावव ओमन असुध अंय: चील, गिधवा, करिया गिधवा, <verse eid="DEU 14:12"/><verse number="13" style="v" sid="DEU 14:13"/>लाल चील, करिया चील, कोनो भी किसम के बाज, <verse eid="DEU 14:13"/><verse number="14" style="v" sid="DEU 14:14"/>कोनो भी किसम के कऊआ, <verse eid="DEU 14:14"/><verse number="15" style="v" sid="DEU 14:15"/>सींगवाला उल्लू, चिचियानेवाला उल्लू, समुंदरी चिरई, कोनो भी किसम के बाज, <verse eid="DEU 14:15"/><verse number="16" style="v" sid="DEU 14:16"/>छोटे घुघवा, बड़े घुघवा, सफेद घुघवा, <verse eid="DEU 14:16"/><verse number="17" style="v" sid="DEU 14:17"/>सुनसान जगह के घुघवा, समुंदरी बाज, हाड़गील, <verse eid="DEU 14:17"/><verse number="18" style="v" sid="DEU 14:18"/>सारस, कोनो भी किसम के कोकड़ा, टिटहरी अऊ चमगीदड़।<verse eid="DEU 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 14:19"/>जम्मो उड़नेवाला कीरामन तुम्हर बर असुध अंय; ओमन ला झन खाहू। <verse eid="DEU 14:19"/><verse number="20" style="v" sid="DEU 14:20"/>पर कोनो पंखवाला सुध जीव ला खा सकत हव।<verse eid="DEU 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 14:21"/>तुमन अइसे कोनो चीज ला झन खाहू, जऊन ह पहिले ही मर गे हवय। तुमन ओला अपन कोनो भी नगर म रहइया परदेसी ला दे सकत हव अऊ ओह ओला खा सकत हे, या तुमन ओला कोनो आने परदेसी ला बेच सकत हव। पर तुमन यहोवा अपन परमेसर बर एक पबितर मनखे अव।</para>
  <para style="p" vid="DEU 14:21">कोनो छेरी-पीला ला ओकर दाई के दूध म झन पकाहू।<verse eid="DEU 14:21"/></para>
  <para style="s1">दसवां अंस</para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 14:22"/>जरूरी अय कि हर साल तुम्हर खेत म होवइया जम्मो फसल के दसवां अंस ला अलग रखव <verse eid="DEU 14:22"/><verse number="23" style="v" sid="DEU 14:23"/>जऊन जगह ला यहोवा तुम्हर परमेसर ह अपन नांव बर निवास के रूप म चुनही, ओ जगह म तुमन अपन अनाज के दसवां अंस, नवां अंगूर के मंद अऊ जैतून तेल, अऊ अपन गाय-बईला अऊ पसु-चिरई के पहिलांत ला यहोवा अपन परमेसर के आघू म खावव, ताकि तुमन हमेसा यहोवा अपन परमेसर ला आदर देय बर सीखव। <verse eid="DEU 14:23"/><verse number="24" style="v" sid="DEU 14:24"/>तुमन यहोवा अपन परमेसर के दुवारा आसीस पाय हवव अऊ यदि ओ जगह ह बहुंत दूरिहा म हवय, जेला यहोवा ह अपन नांव रखे बर चुनथे, अऊ तुमन उहां अपन दसवां अंस ला नइं ले जा सकव, <verse eid="DEU 14:24"/><verse number="25" style="v" sid="DEU 14:25"/>त फेर ओ दसवां अंस ला चांदी म बदला कर लव, अऊ ओ चांदी ला लेके तुमन ओ जगह म जावव, जेला यहोवा तुम्हर परमेसर ह चुनही। <verse eid="DEU 14:25"/><verse number="26" style="v" sid="DEU 14:26"/>ओ चांदी के उपयोग अपन मन मुताबिक चीज बिसाय म करव: गाय-बईला, भेड़-बकरी, अंगूर के मंद या कोनो आने मंद, या कोनो अऊ चीज जेला तुमन चाहव। तब तुमन अऊ तुम्हर परिवार के मनखेमन उहां यहोवा तुम्हर परमेसर के आघू म खावंय अऊ आनंद मनावंय। <verse eid="DEU 14:26"/><verse number="27" style="v" sid="DEU 14:27"/>अऊ तुमन तुम्हर नगर म रहइया लेवीमन के अनदेखी झन करव, काबरकि ओमन करा ओमन के खुद के कोनो हिस्सा या निज भाग नइं ए।<verse eid="DEU 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="DEU 14:28"/>हर तीन साल के आखिरी म, ओ साल के ऊपज के जम्मो दसवां अंस ला लानव अऊ ओला अपन नगर म इकट्ठा करव, <verse eid="DEU 14:28"/><verse number="29" style="v" sid="DEU 14:29"/>ताकि लेवी (जेमन करा ओमन के खुद के कोनो हिस्सा या निज भाग नइं ए) अऊ परदेसी, अनाथ अऊ बिधवा जेमन तुम्हर नगर म रहिथें, ओमन आवंय अऊ खावंय अऊ संतुस्ट हो जावंय, अऊ यहोवा तुम्हर परमेसर ह तुम्हर जम्मो काम म तुमन ला आसीस देवय।<verse eid="DEU 14:29"/></para>
  <chapter eid="DEU 14"/>
  <chapter number="15" style="c" sid="DEU 15"/>
  <para style="s1">करजा माफ करे के साल</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 15:1"/>हर सात साल के आखिरी म तुमन करजा ला माफ कर दूहू। <verse eid="DEU 15:1"/><verse number="2" style="v" sid="DEU 15:2"/>ये करजा माफी के काम अइसने करे जावय: हर एक साहूकार ह अपन संगी इसरायली ला दिये करजा ला माफ कर देवय। ओह अपन खुद के मनखेमन ले करजा के पईसा वापिस झन लेवय, काबरकि करजा माफी बर यहोवा के समय के घोसना करे जा चुके हे। <verse eid="DEU 15:2"/><verse number="3" style="v" sid="DEU 15:3"/>तुमन कोनो परदेसी ले करजा म दिये पईसा ला वापिस ले सकत हव, पर तुम्हर संगी इसरायली तुम्हर ले कोनो करजा लेय हवय, त ओ करजा ला जरूर माफ कर दव। <verse eid="DEU 15:3"/><verse number="4" style="v" sid="DEU 15:4"/>पर तुम्हर बीच म कोनो भी गरीब मनखे झन रहय, काबरकि जऊन देस ला यहोवा तुम्हर परमेसर ह तुमन ला तुम्हर उत्तराधिकार के रूप म देवत हे, ओ देस म ओह तुमन ला बहुंत आसीस दीही, <verse eid="DEU 15:4"/><verse number="5" style="v" sid="DEU 15:5"/>यदि तुमन सिरिप यहोवा तुम्हर परमेसर के बात ला मानहू अऊ धियान देके ये जम्मो हुकूममन के पालन करहू, जेला मेंह आज तुमन ला देवत हंव। <verse eid="DEU 15:5"/><verse number="6" style="v" sid="DEU 15:6"/>काबरकि यहोवा तुम्हर परमेसर ह अपन वायदा के मुताबिक तुमन ला आसीस दीही, अऊ तुमन बहुंते जाति के मनखेमन ला उधार दूहू पर कोनो ले तुमन ला उधार लेना नइं पड़ही। तुमन बहुंते जाति के मनखेमन ऊपर सासन करहू पर तुम्हर ऊपर कोनो सासन नइं करही।<verse eid="DEU 15:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 15:7"/>यदि तुम्हर संगी इसरायलीमन के बीच म ही कोनो गरीब हवय, जऊन ह ओ देस के कोनो नगर म रहिथे, जेला यहोवा तुम्हर परमेसर ह तुमन ला देवत हे, त ओकर बर अपन हिरदय ला कठोर झन करव या ओकर बर अपन हांथ ला झन बांध लव। <verse eid="DEU 15:7"/><verse number="8" style="v" sid="DEU 15:8"/>पर हांथ खोलके अऊ उदार मन से ओकर जरूरत के चीज ओला उधार दव या ओकर मदद करव। <verse eid="DEU 15:8"/><verse number="9" style="v" sid="DEU 15:9"/>धियान रहय कि ये दुस्ट बिचार तुम्हर मन म झन आवय: “सातवां साल, करजा माफी करे के साल ह लकठा म हवय,” ताकि तुम्हर संगी इसरायलीमन के बीच के ओ जरूरतमंद भाई बर तुम्हर मन म कोनो गलत बिचार झन आवय अऊ ओला तुमन कुछू नइं देय के बात झन सोचव। तब ओह यहोवा ले तुम्हर बिरूध बिनती कर सकत हे, अऊ तुमन पाप के दोसीदार होहू। <verse eid="DEU 15:9"/><verse number="10" style="v" sid="DEU 15:10"/>ओला उदार मन से देवव अऊ ये काम बिगर कुड़कुड़ाय करव; तब येकर कारन यहोवा तुम्हर परमेसर ह तुमन ला तुम्हर जम्मो काम म अऊ जेमा तुमन अपन हांथ लगाहू, ओ जम्मो म आसीस दीही। <verse eid="DEU 15:10"/><verse number="11" style="v" sid="DEU 15:11"/>देस म हमेसा गरीब मनखेमन होहीं। एकरसेति तुमन ला हुकूम देवत हंव कि तुमन अपन ओ संगी इसरायलीमन बर उदार भाव देखावव, जेमन तुम्हर देस म गरीब अऊ जरूरतमंद हवंय।<verse eid="DEU 15:11"/></para>
  <para style="s1">सेवकमन ला सुतंतर करई</para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 15:12"/>यदि तुम्हर मनखेमन ले कोनो—चाहे ओह इबरी आदमी हो या माईलोगन—अपनआप ला तुम्हर करा बेच देथे अऊ छै साल तक सेवा करथे, त जरूरी अय कि सातवां साल तुमन ओला छोंड़ दव। <verse eid="DEU 15:12"/><verse number="13" style="v" sid="DEU 15:13"/>अऊ जब तुमन ओला छोंड़ देथव, त ओला खाली हांथ झन जावन दव। <verse eid="DEU 15:13"/><verse number="14" style="v" sid="DEU 15:14"/>ओला अपन पसु के झुंड ले, अपन कोठार ले अऊ अपन अंगूर के रसकुंड ले उदार मन से देवव। जइसे यहोवा तुम्हर परमेसर ह तुमन ला आसीस दे हवय, ओकरे मुताबिक तुमन ओला देवव। <verse eid="DEU 15:14"/><verse number="15" style="v" sid="DEU 15:15"/>सुरता रखव कि तुमन मिसर देस म गुलाम रहेव अऊ यहोवा तुम्हर परमेसर ह तुमन ला छोंड़ाईस। एकर कारन मेंह आज तुमन ला ये हुकूम देवत हंव।<verse eid="DEU 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 15:16"/>पर यदि तुम्हर सेवक तुमन ला कहिथे, “मेंह तोला छोंड़के जाय बर नइं चाहत हंव,” काबरकि ओह तुम्हर अऊ तुम्हर परिवार ले मया करथे अऊ तुम्हर संग खुस रहिथे, <verse eid="DEU 15:16"/><verse number="17" style="v" sid="DEU 15:17"/>तब एक ठन सूजा लेवव अऊ ओकर कान ला कपाट म लगाके छेद दव, अऊ ओह जिनगी भर तुम्हर सेवक बने रहिही। वइसने ही अपन सेविका के संग घलो करव।<verse eid="DEU 15:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 15:18"/>अपन सेवक ला मुक्त करई तुम्हर बर कठिन काम झन होवय, काबरकि ये छै साल म बनिहार ले काम कराय के बदले तुम्हर सेवक के काम ले तुमन ला दू गुना फायदा होईस हे। अऊ यहोवा तुम्हर परमेसर ह तुमन ला तुम्हर हर काम म आसीस दीही।<verse eid="DEU 15:18"/></para>
  <para style="s1">पहिलांत पसु</para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 15:19"/>अपन गाय-बईला अऊ भेड़-बकरी म ले जनमे हर पहिलांत नर पसु ला यहोवा अपन परमेसर बर अलग करव। अपन गाय के पहिलांत बछवा ले कोनो काम झन करवाव, अऊ अपन भेड़ के पहिलांत मेढ़ा-पीला के ऊन ला झन कतरव। <verse eid="DEU 15:19"/><verse number="20" style="v" sid="DEU 15:20"/>हर एक साल तुमन अऊ तुम्हर परिवार के मनखेमन ओला यहोवा तुम्हर परमेसर के आघू म ओ जगह म खावव, जेला परमेसर ह चुनही। <verse eid="DEU 15:20"/><verse number="21" style="v" sid="DEU 15:21"/>पर कहूं पसु म दोस हवय याने कि ओह खोरवा या कनवां हे, या ओमा कोनो गंभीर दोस हवय, त तुमन ओला यहोवा तुम्हर परमेसर बर बलिदान झन करव। <verse eid="DEU 15:21"/><verse number="22" style="v" sid="DEU 15:22"/>ओला तुमन अपन खुद के नगर म खावव। संस्कारिक रूप ले सुध अऊ असुध दूनों किसम के मनखे ओला खा सकत हें, जइसे कि कोनो चिकारा या हिरन ला खाथें। <verse eid="DEU 15:22"/><verse number="23" style="v" sid="DEU 15:23"/>पर धियान रहय कि तुमन ओकर खून ला झन खावव; ओला पानी सहीं बाहिर भुइयां म रितो दव।<verse eid="DEU 15:23"/></para>
  <chapter eid="DEU 15"/>
  <chapter number="16" style="c" sid="DEU 16"/>
  <para style="s1">फसह के उत्सव</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 16:1"/>अबीब<note caller="+" style="f"><char style="fr" closed="false">16:1 </char><char style="fq" closed="false">अबीब </char><char style="ft" closed="false">ला बाद म </char><char style="fqa" closed="false">निसान कहे गीस</char></note> के महिना ला मानव अऊ यहोवा अपन परमेसर बर फसह तिहार मनावव, काबरकि अबीब के महिना म ओह रथिया के बेरा तुमन ला मिसर देस ले निकालके लाने रिहिस। <verse eid="DEU 16:1"/><verse number="2" style="v" sid="DEU 16:2"/>यहोवा अपन परमेसर बर अपन गाय-बईला या भेड़-बकरी के झुंड म ले एक ठन पसु ला फसह के रूप म ओ जगह म बलिदान चघावव, जेला यहोवा ह अपन नांव बर निवास के रूप म चुनही। <verse eid="DEU 16:2"/><verse number="3" style="v" sid="DEU 16:3"/>ओला खमीर मिले हुए रोटी के संग झन खाहू, पर सात दिन तक बिगर खमीर मिले रोटी ला खावव याने कि दुख के रोटी खावव, काबरकि तुमन मिसर देस ले जल्दबाजी म निकले रहेव—ताकि तुमन ला मिसर ले निकल आय के बेरा ह जिनगी भर सुरता रहय। <verse eid="DEU 16:3"/><verse number="4" style="v" sid="DEU 16:4"/>तुम्हर पूरा देस म सात दिन तक तुम्हर करा कोनो खमीर झन दिखय। पहिला दिन के संझा के बेरा चघाय गय मांस के बलिदान म ले कुछू भी बिहनियां तक झन बचय।<verse eid="DEU 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 16:5"/>तुमन यहोवा तुम्हर परमेसर के दुवारा तुमन ला दिये गय कोनो भी नगर म फसह के बलिदान ला झन चघाहू, <verse eid="DEU 16:5"/><verse number="6" style="v" sid="DEU 16:6"/>पर सिरिप ओहीच जगह म चघाहू, जेला यहोवा ह अपन नांव बर निवास के रूप म चुनही। उहां संझा के बेरा, जब सूरज ह ढरथे, तब तुमन मिसर ले निकले के सालाना उत्सव के रूप म फसह के बलिदान ला चघावव। <verse eid="DEU 16:6"/><verse number="7" style="v" sid="DEU 16:7"/>तुमन मांस ला ओ जगह म भूंजव अऊ खावव, जेला यहोवा तुम्हर परमेसर ह चुनही। तब बिहनियां अपन-अपन तम्बू म लहुंट जावव। <verse eid="DEU 16:7"/><verse number="8" style="v" sid="DEU 16:8"/>छै दिन तक बिगर खमीर मिले हुए रोटी ला खावव अऊ सातवां दिन यहोवा तुम्हर परमेसर बर एक सभा करव अऊ ओ दिन काम झन करव।<verse eid="DEU 16:8"/></para>
  <para style="s1">सप्ताहमन के तिहार</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 16:9"/>जब तुमन खड़े फसल ला लुए बर हंसिया चलाय के सुरू करथव, त ओ दिन ले लेके सात हप्ता गन लेवव। <verse eid="DEU 16:9"/><verse number="10" style="v" sid="DEU 16:10"/>तब यहोवा तुम्हर परमेसर ह जऊन आसीस तुमन ला देय हवय, ओकर अनुपात म एक स्वेच्छा-बलिदान देय के दुवारा तुमन यहोवा अपन परमेसर बर हप्तामन के तिहार मनावव। <verse eid="DEU 16:10"/><verse number="11" style="v" sid="DEU 16:11"/>अऊ यहोवा अपन परमेसर के आघू म ओ जगह म आनंद मनावव, जेला ओह अपन नांव बर निवास के रूप म चुनही—तुमन, तुम्हर बेटा-बेटी, तुम्हर सेवक-सेविका, तुम्हर नगर के लेवी, अऊ तुम्हर बीच रहइया परदेसी, अनाथ अऊ बिधवा, जम्मो के जम्मो आनंद मनावव। <verse eid="DEU 16:11"/><verse number="12" style="v" sid="DEU 16:12"/>सुरता रखव कि तुमन मिसर देस म गुलाम रहेव, अऊ धियान देके ये बिधिमन के पालन करव।<verse eid="DEU 16:12"/></para>
  <para style="s1">पबितर-तम्बूमन के तिहार</para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 16:13"/>अपन कोठार अऊ अंगूर के रसकुंड ले ऊपज ला संकेले के सात दिन के बाद तुमन पबितर-तम्बूमन के तिहार मनावव।<note caller="+" style="f"><char style="fr" closed="false">16:13 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="LEV 23:42">लैव्य 23:42</ref></char></char></note> <verse eid="DEU 16:13"/><verse number="14" style="v" sid="DEU 16:14"/>अपन तिहार म आनंद मनावव—तुमन, तुम्हर बेटा-बेटी, तुम्हर सेवक-सेविका, अऊ लेवी, परदेसी, अनाथ अऊ तुम्हर नगर म रहइया बिधवा, जम्मो के जम्मो आनंद मनावव। <verse eid="DEU 16:14"/><verse number="15" style="v" sid="DEU 16:15"/>सात दिन तक यहोवा तुम्हर परमेसर बर ओ जगह म आनंद मनावव, जेला यहोवा ह चुनही। काबरकि यहोवा तुम्हर परमेसर ह तुमन ला तुम्हर जम्मो ऊपज अऊ तुम्हर हांथ के जम्मो काम म आसीस दीही, अऊ तुम्हर आनंद ह पूरा होही।<verse eid="DEU 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 16:16"/>साल म तीन बार तुम्हर जम्मो आदमीमन यहोवा तुम्हर परमेसर के आघू म ओ जगह म उपस्थित होवंय, जेला ओह चुनही: याने कि बिगर खमीर के रोटी के तिहार, हप्तामन के तिहार अऊ पबितर-तम्बूमन के तिहार के बेरा उपस्थित होवंय। कोनो भी मनखे यहोवा के आघू म जुच्छा हांथ झन आवय: <verse eid="DEU 16:16"/><verse number="17" style="v" sid="DEU 16:17"/>हर एक झन यहोवा तुम्हर परमेसर के दिये आसीस के अनुपात म एक ठन भेंट जरूर लानय।<verse eid="DEU 16:17"/></para>
  <para style="s1">नियायधीसमन</para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 16:18"/>तुम्हर हर एक गोत्र बर हर ओ नगर म नियायधीस अऊ करमचारी नियुक्त करव, जेला यहोवा तुम्हर परमेसर ह तुमन ला देवत हे, अऊ ओमन ईमानदारी से मनखेमन के नियाय करंय। <verse eid="DEU 16:18"/><verse number="19" style="v" sid="DEU 16:19"/>नियाय ला झन बिगाड़व या भेदभाव झन करव। घूस झन लेवव, काबरकि घूस ह बुद्धिमान मनखे के आंखी ला अंधरा कर देथे अऊ निरदोस मनखे के गोठ ला बिगाड़ देथे। <verse eid="DEU 16:19"/><verse number="20" style="v" sid="DEU 16:20"/>नियाय अऊ सिरिप नियाय के पाछू चलव, ताकि तुमन जीयत रहव अऊ ओ देस ऊपर अधिकार करव, जेला यहोवा तुम्हर परमेसर ह तुमन ला देवत हे।<verse eid="DEU 16:20"/></para>
  <para style="s1">आने देवतामन के अराधना करई</para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 16:21"/>तुमन यहोवा अपन परमेसर बर बनाय गे बेदी के बाजू म लकड़ी के कोनो असेरा के खंभा झन खड़े करहू, <verse eid="DEU 16:21"/><verse number="22" style="v" sid="DEU 16:22"/>अऊ कोनो पबितर पथरा खड़े झन करहू, काबरकि यहोवा तुम्हर परमेसर ह अइसने चीज ले घिन करथे।<verse eid="DEU 16:22"/></para>
  <chapter eid="DEU 16"/>
  <chapter number="17" style="c" sid="DEU 17"/>
  <para style="p">
    <verse number="1" style="v" sid="DEU 17:1"/>तुमन यहोवा, अपन परमेसर ला अइसने कोनो बईला या भेड़ ला झन चघाहू, जेमा कोनो किसम के दोस या खोट हवय, काबरकि येह ओकर नजर म घिनौना अय।<verse eid="DEU 17:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="DEU 17:2"/>जऊन नगरमन ला यहोवा तुमन ला देय हवय, यदि ओमा के कोनो नगर म कोनो मनखे या माईलोगन तुम्हर बीच म रहत हे अऊ ओह यहोवा, तुम्हर परमेसर के करार ला टोरे के दुवारा ओकर नजर म दुस्ट काम करथे, <verse eid="DEU 17:2"/><verse number="3" style="v" sid="DEU 17:3"/>अऊ मोर हुकूम के उल्टा आने देवतामन ला दंडवत करके अराधना करथे या सूरज या चंदा या अकास के तारामन के अराधना करथे, <verse eid="DEU 17:3"/><verse number="4" style="v" sid="DEU 17:4"/>अऊ ये बात तुम्हर जानकारी म लाय जाथे, तब तुमन येकर पूरा जांच-पड़ताल करव। यदि येह सच पाय जाथे अऊ येह साबित हो जाथे कि इसरायल म ये घिनौना काम करे गे हवय, <verse eid="DEU 17:4"/><verse number="5" style="v" sid="DEU 17:5"/>त तुमन ओ मनखे या माईलोगन, जऊन ह ये दुस्ट काम करे हवय, ओला अपन सहर के दुवार म ले जावव, अऊ उहां ओला पथरवाह करके मार डारव। <verse eid="DEU 17:5"/><verse number="6" style="v" sid="DEU 17:6"/>दू या तीन गवाहमन के गवाही के दुवारा ही कोनो मनखे ला मऊत के सजा दिये जावय, पर सिरिप एक गवाह के गवाही के दुवारा कोनो ला मऊत के सजा झन दिये जावय। <verse eid="DEU 17:6"/><verse number="7" style="v" sid="DEU 17:7"/>ओला मार डारे जाय म पहिले गवाहमन के हांथ होवय, अऊ तब जम्मो मनखेमन के हांथ उठय। ये किसम ले तुमन अपन बीच ले बुरई ला दूर करव।<verse eid="DEU 17:7"/></para>
  <para style="s1">अदालत</para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 17:8"/>यदि तुम्हर अदालत म अइसने मामला आथे, जेकर नियाय करई बहुंत कठिन अय—चाहे ओह हतिया, बिबाद या मारपीट के मामला होवय—त ओ मामला ला ओ जगह म ले जावव, जेला यहोवा तुम्हर परमेसर ह चुनही। <verse eid="DEU 17:8"/><verse number="9" style="v" sid="DEU 17:9"/>उहां तुमन ओ लेवी पुरोहितमन अऊ नियायधीस करा जावव, जेमन ओ बेरा पद म होहीं। ओमन ले पुछताछ करव अऊ ओमन तुमन ला फैसला सुनाहीं। <verse eid="DEU 17:9"/><verse number="10" style="v" sid="DEU 17:10"/>यहोवा के दुवारा चुने गय जगह म ओमन तुमन ला जऊन फैसला देथें, तुमन ओकरे मुताबिक काम करव। ओमन जऊन निरदेस देथें, ओला पूरा करे म सावधानी बरतव। <verse eid="DEU 17:10"/><verse number="11" style="v" sid="DEU 17:11"/>ओमन तुमन ला जऊन बात सिखाथें अऊ तुमन ला जऊन निरदेस देथें, ओकर मुताबिक तुमन काम करव। ओमन के कहे बात ले एती-ओती झन जावव, न तो जेवनी अऊ न ही डेरी। <verse eid="DEU 17:11"/><verse number="12" style="v" sid="DEU 17:12"/>जऊन भी मनखे यहोवा तुम्हर परमेसर के सेवकई करइया नियायधीस या पुरोहित के बात ला नइं मानय, ओह मार डारे जावय। जरूरी अय कि तुमन इसरायल ले बुरई ला खतम करव। <verse eid="DEU 17:12"/><verse number="13" style="v" sid="DEU 17:13"/>जम्मो मनखेमन येला सुनहीं अऊ डरहीं, अऊ ओमन फेर नियायधीस या पुरोहित के बात के अनादर नइं करहीं।<verse eid="DEU 17:13"/></para>
  <para style="s1">राजा</para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 17:14"/>जब तुमन ओ देस म हबर जावव, जेला यहोवा तुम्हर परमेसर ह तुमन ला देवत हे अऊ ओकर ऊपर अधिकार कर लव अऊ ओमा बस जाय के बाद तुमन कहव, “आवव, हमर चारों कोति के देसमन के सहीं हमन घलो अपन ऊपर एक राजा ठहिरावन,” <verse eid="DEU 17:14"/><verse number="15" style="v" sid="DEU 17:15"/>त धियान रहय कि जेला यहोवा तुम्हर परमेसर ह चुनथे, ओला तुमन अपन ऊपर राजा ठहिरावव। ओह तुम्हर संगी इसरायलीमन के बीच म ले होवय। अपन ऊपर कोनो परदेसी ला राजा झन ठहिरावव, ओ मनखे जऊन ह इसरायली नो हय। <verse eid="DEU 17:15"/><verse number="16" style="v" sid="DEU 17:16"/>येकर अलावा, जरूरी अय कि राजा अपन बर जादा संखिया म घोड़ा झन रखय या अऊ घोड़ा लाने के बदले म राजा ह मनखेमन ला मिसर देस म गुलाम के रूप म झन पठोवय, काबरकि यहोवा ह तुमन ला कहे हवय, “तुमन ला ओ रसता म फेर वापिस नइं जाना हे।” <verse eid="DEU 17:16"/><verse number="17" style="v" sid="DEU 17:17"/>राजा ह बहुंत घरवाली झन बनावय, नइं तो ओकर मन ह यहोवा कोति ले भटक जाही। जरूरी अय कि ओह जादा सोन अऊ चांदी जमा झन करय।<verse eid="DEU 17:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 17:18"/>जब ओह अपन राज के सिंघासन म बईठे, त ओह लेवी पुरोहितमन ले लिये गय ये कानून के एक नकल करके अपन बर एक किताब बना ले। <verse eid="DEU 17:18"/><verse number="19" style="v" sid="DEU 17:19"/>येह ओकर संग रहय, अऊ ओह ओला अपन जिनगी भर पढ़य, ताकि ओह यहोवा ओकर परमेसर के आदर करना सीखय अऊ धियान देके ये कानून अऊ ये बिधि के बातमन के पालन करय <verse eid="DEU 17:19"/><verse number="20" style="v" sid="DEU 17:20"/>अऊ अपनआप ला अपन संगी इसरायलीमन ले उत्तम झन समझय अऊ ये कानून ले न तो जेवनी जावय, अऊ न ही डेरी।<note caller="+" style="f"><char style="fr" closed="false">17:20 </char><char style="ft" closed="false">एकदम कानून के मुताबिक ही करय</char></note> तब ओह अऊ ओकर संतानमन इसरायल म ओकर राज ऊपर लम्बा समय तक सासन करहीं।<verse eid="DEU 17:20"/></para>
  <chapter eid="DEU 17"/>
  <chapter number="18" style="c" sid="DEU 18"/>
  <para style="s1">पुरोहित अऊ लेवीमन बर भेंट</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 18:1"/>लेवीय पुरोहितमन—वास्तव म लेवी के पूरा गोत्र ला इसरायल के संग कोनो भाग या उत्तराधिकार नइं मिलय। यहोवा ला चघाय गे जेवन-बलिदान ओमन ला मिलही, काबरकि ओह ओमन के भाग ए। <verse eid="DEU 18:1"/><verse number="2" style="v" sid="DEU 18:2"/>ओमन के संगी इसरायलीमन के बीच म ओमन के कोनो भाग नइं होही; यहोवा ह ओमन के भाग ए, जइसे कि ओह ओमन ले वायदा करे हवय।<verse eid="DEU 18:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 18:3"/>मनखेमन जऊन बईला या भेड़ ला बलिदान चघाहीं, ओमा ले पुरोहितमन ला ये चीजमन बांटा के रूप म मिलही: कंधा, पेट के भीतर के चीजमन अऊ मुड़ के मांस। <verse eid="DEU 18:3"/><verse number="4" style="v" sid="DEU 18:4"/>तुमन पुरोहितमन ला अपन अनाज के पहिली फर देवव याने कि नवां अंगूर के मंद अऊ जैतून तेल, अऊ तुम्हर भेड़मन ले कतरे पहिला ऊन, <verse eid="DEU 18:4"/><verse number="5" style="v" sid="DEU 18:5"/>काबरकि यहोवा तुम्हर परमेसर ह ओमन ला अऊ ओमन के संतानमन ला तुम्हर जम्मो गोत्रमन ले चुने हवय कि ओमन हमेसा यहोवा के आघू म ठाढ़ होवंय अऊ ओकर सेवा करंय।<verse eid="DEU 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 18:6"/>कोनो लेवी ह इसरायल के तुम्हर कोनो नगर जिहां ओह रहत हे, यदि ओह ओ जगह ले सही मन से इसरायल के कोनो आने जगह म आथे, जेला यहोवा ह चुनथे, <verse eid="DEU 18:6"/><verse number="7" style="v" sid="DEU 18:7"/>त ओह अपन ओ जम्मो संगी लेवीमन सहीं यहोवा अपन परमेसर के नांव म सेवा करय, जेमन उहां यहोवा के आघू म सेवा करथें। <verse eid="DEU 18:7"/><verse number="8" style="v" sid="DEU 18:8"/>ओला ओमन के जम्मो लाभ म बराबर भाग मिलय, हालाकि परिवारिक संपत्ति के बिक्री ले ओला पईसा मिल गे हवय।<verse eid="DEU 18:8"/></para>
  <para style="s1">गुपत रिवाज</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 18:9"/>जब तुमन ओ देस म जावव, जेला यहोवा तुम्हर परमेसर ह तुमन ला देवत हे, त उहां आनजातमन के घिनौना रीति-रिवाज के नकल करे बर झन सीखव। <verse eid="DEU 18:9"/><verse number="10" style="v" sid="DEU 18:10"/>तुम्हर बीच म अइसन कोनो मनखे झन पाय जावय, जऊन ह अपन बेटा या बेटी ला आगी म बलिदान करथे, जऊन ह सकुन-बिचार या जादू करथे या सकुन के अर्थ बताथे या जादू-टोना करथे, <verse eid="DEU 18:10"/><verse number="11" style="v" sid="DEU 18:11"/>या सम्मोहन करथे, या जऊन ह भूतसाधक या बईगा अय या जऊन ह मरे मनखे के आतमा ले सम्पर्क करथे। <verse eid="DEU 18:11"/><verse number="12" style="v" sid="DEU 18:12"/>जऊन ह अइसने काम करथे ओह यहोवा बर घिनौना अय, काबरकि इहीच घिनौना काम के कारन यहोवा तुम्हर परमेसर ह ओ आनजातमन ला तुम्हर आघू ले भगा दीही। <verse eid="DEU 18:12"/><verse number="13" style="v" sid="DEU 18:13"/>जरूरी अय कि तुमन यहोवा अपन परमेसर के आघू म निरदोस रहव।<verse eid="DEU 18:13"/></para>
  <para style="s1">अगमजानी</para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 18:14"/>जऊन जातिमन ला तुमन बेदखल करहू, ओमन अइसने मनखेमन के बात सुनथें, जऊन मन जादू-टोना या सकुन-बिचार करथें। पर जहां तक तुम्हर बात ए, यहोवा तुम्हर परमेसर ह तुमन ला अइसे करे के अनुमति नइं दे हवय। <verse eid="DEU 18:14"/><verse number="15" style="v" sid="DEU 18:15"/>यहोवा तुम्हर परमेसर ह तुम्हर बर तुम्हर बीच ले, तुम्हर संगी इसरायलीमन ले मोर सहीं एक अगमजानी ठाढ़ करही। तुमन ओकर बात जरूर सुनव। <verse eid="DEU 18:15"/><verse number="16" style="v" sid="DEU 18:16"/>काबरकि तुमन यहोवा तुम्हर परमेसर ले होरेब पहाड़ ऊपर सभा के दिन इही बात के मांग करे रहेव, जब तुमन कहेव, “आवव, हमन यहोवा हमर परमेसर के अवाज ला नइं सुनन अऊ ये भयंकर आगी ला झन देखन, नइं तो हमन मर जाबो।”<verse eid="DEU 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 18:17"/>तब यहोवा ह मोला कहिस: “ओमन जऊन कुछू कहत हें ओह बने बात ए। <verse eid="DEU 18:17"/><verse number="18" style="v" sid="DEU 18:18"/>मेंह ओमन बर ओमन के संगी इसरायलीमन के बीच म ले तोर सहीं एक अगमजानी ला ठाढ़ करहूं, अऊ मेंह अपन बात ओकर मुहूं म डालहूं। ओह ओमन ला ओ जम्मो बात बताही, जेकर हुकूम मेंह ओला दूहूं। <verse eid="DEU 18:18"/><verse number="19" style="v" sid="DEU 18:19"/>मेंह खुद ओ मनखे ला जिम्मेदार ठहिराहूं, जऊन ह मोर ओ बात ला नइं सुनही, जेला ओ अगमजानी ह मोर नांव म बताही। <verse eid="DEU 18:19"/><verse number="20" style="v" sid="DEU 18:20"/>पर कोनो अगमजानी, जऊन ह मोर नांव म अपन मन के बात कहिथे, जेकर हुकूम मेंह नइं दे हंव, या कोनो अगमजानी, जऊन ह आने देवता के नांव म गोठियाथे, त ओह मार डारे जावय।”<verse eid="DEU 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 18:21"/>तुमन अपनआप ले कह सकत हव, “हमन कइसे जानबो कि ओ संदेस ला यहोवा ह नइं दे हवय?” <verse eid="DEU 18:21"/><verse number="22" style="v" sid="DEU 18:22"/>जब कोनो अगमजानी ह यहोवा के नांव म कोनो बात के घोसना करथे अऊ ओ बात ह ओकर घोसना के मुताबिक नइं होवय या ओ बात ह सच साबित नइं होवय, त फेर ओ संदेस ला यहोवा ह नइं दे हवय। ओ अगमजानी ह अपन मन से ओ बात ला कहे हवय, एकरसेति तुमन झन डरहू।<verse eid="DEU 18:22"/></para>
  <chapter eid="DEU 18"/>
  <chapter number="19" style="c" sid="DEU 19"/>
  <para style="s1">सरन लेय के सहरमन</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 19:1"/>जब यहोवा तुम्हर परमेसर ह ओ जाति-जाति के मनखेमन ला नास कर दीही, जेमन के देस तुमन ला देवत हे, अऊ जब तुमन ओमन ला भगा दूहू अऊ ओमन के नगर अऊ घरमन म बस जाहू, <verse eid="DEU 19:1"/><verse number="2" style="v" sid="DEU 19:2"/>तब ओ देस, जेला यहोवा तुम्हर परमेसर ह तुमन ला तुम्हर अधिकार म देवत हे, उहां अपन बर तीन सहर ला अलग करव। <verse eid="DEU 19:2"/><verse number="3" style="v" sid="DEU 19:3"/>तुमन उहां जाय बर डहार बनावव<note caller="+" style="f"><char style="fr" closed="false">19:3 </char><char style="ft" closed="false">उहां जाय बर दूरी तय करव</char></note> अऊ ओ देस ला तीन भाग म बांटव, जेला यहोवा तुम्हर परमेसर ह तुमन ला तुम्हर उत्तराधिकार के रूप म देवत हे, ताकि ओ मनखे जऊन ह कोनो मनखे के हतिया कर देथे, त ओह सरन लेय बर येमा के कोनो एक सहर म भागके जा सकय।<verse eid="DEU 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 19:4"/>जऊन मनखे कोनो आने मनखे के हतिया करके अपन सुरकछा बर येमा के कोनो सहर म भागके जाथे, त ओकर बर ये नियम अय—कोनो मनखे अपन परोसी के हतिया बिगर इरादा, बिगर बईरता अऊ बिगर सोचे-बिचारे कर देथे। <verse eid="DEU 19:4"/><verse number="5" style="v" sid="DEU 19:5"/>उदाहरन के रूप म, जब कोनो मनखे अपन परोसी के संग लकड़ी काटे बर जंगल म जाथे, अऊ टांगा ला उठाके लकड़ी काटत बेरा, टांगा ह बेंट ले निकलके ओकर परोसी ला लगथे अऊ ओकर परोसी ह मर जाथे, त ओ मनखे ह येमा के कोनो एक सहर म भागके अपन परान बचा सकत हे। <verse eid="DEU 19:5"/><verse number="6" style="v" sid="DEU 19:6"/>नइं तो खून के बदला लेवइया ह कोरोध म ओकर पीछा कर सकथे अऊ यदि रसता ह बहुंत लम्बा हवय, त ओह ओला पकड़के मार सकथे, हालाकि ओह मिरतू-दंड के लईक काम नइं करे हवय, काबरकि ओकर मन म अपन परोसी बर कोनो बईरता के भाव नइं रिहिस। <verse eid="DEU 19:6"/><verse number="7" style="v" sid="DEU 19:7"/>एकरसेति मेंह तुमन ला हुकूम देवत हंव कि तुमन अपन बर तीन सहर ला अलग रखव।<verse eid="DEU 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 19:8"/>यदि यहोवा तुम्हर परमेसर ह तुम्हर सीमना ला बढ़ाथे, जइसे कि ओह सपथ खाके तुम्हर पुरखामन ले वायदा करे रिहिस, अऊ ओह ओमन के संग करे वायदा के मुताबिक पूरा देस तुमन ला देथे, <verse eid="DEU 19:8"/><verse number="9" style="v" sid="DEU 19:9"/>काबरकि तुमन धियान देके ये जम्मो कानूनमन ला मानथव, जेकर हुकूम मेंह आज तुमन ला देवत हंव—यहोवा अपन परमेसर ले मया करव अऊ हमेसा हुकूम मानके ओकर रसता म चलव—त तुमन तीन अऊ सहर ला अलग करव। <verse eid="DEU 19:9"/><verse number="10" style="v" sid="DEU 19:10"/>अइसने करव ताकि ओ निरदोस के खून तुम्हर ये देस म झन बहाय जावय, जेला यहोवा तुम्हर परमेसर ह तुमन ला तुम्हर उत्तराधिकार के रूप म देवत हे, अऊ ये किसम ले खून करे के दोस तुम्हर ऊपर नइं लगही।<verse eid="DEU 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 19:11"/>पर यदि कोनो मनखे अपन परोसी ले बईरता रखके ओकर घात म रहिथे अऊ हमला करके ओला मार डारथे, अऊ तब येमा के कोनो एक सहर म भाग जाथे, <verse eid="DEU 19:11"/><verse number="12" style="v" sid="DEU 19:12"/>त फेर सहर के अगुवामन कोनो ला पठोके ओला ओ सहर ले वापिस लानंय, अऊ ओला बदला लेवइया के हांथ म सऊंप देवंय ताकि ओह मार डारे जावय। <verse eid="DEU 19:12"/><verse number="13" style="v" sid="DEU 19:13"/>ओकर ऊपर दया झन देखावव। जरूरी अय कि तुमन इसरायल ले निरदोस के खून के दोस ला दूर करव, ताकि तुम्हर भलई होवय।<note caller="+" style="f"><char style="fr" closed="false">19:13 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="NUM 35:33-34">गन 35:33‑34</ref></char></char></note><verse eid="DEU 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 19:14"/>यहोवा तुम्हर परमेसर ह तुमन ला जऊन देस देवत हे कि तुमन ओकर ऊपर अधिकार करव याने कि जऊन देस ह तुमन ला उत्तराधिकार म मिलथे, उहां तुम्हर बाप-ददामन तुम्हर परोसी के जऊन सीमना के पथरा ठहिराथें, ओला झन हटाहू।<verse eid="DEU 19:14"/></para>
  <para style="s1">गवाहमन</para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 19:15"/>कोनो मनखे ला ओकर करे गय कोनो अपराध या पाप के दोसी ठहिराय बर एक गवाह के गवाही ह परयाप्त नो हय। कोनो भी बात के पुस्टि करे बर दू या तीन गवाह के गवाही जरूरी अय।<verse eid="DEU 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 19:16"/>यदि कोनो बईरता रखनेवाला गवाह काकरो ऊपर कोनो अपराध के दोस लगाथे, <verse eid="DEU 19:16"/><verse number="17" style="v" sid="DEU 19:17"/>त ओ दूनों मनखे, जेमन झगड़ा म सामिल रहिथें, ओमन यहोवा के उपस्थिति म उहां बईठे पुरोहित अऊ नियायधीसमन के आघू म ठाढ़ होवंय। <verse eid="DEU 19:17"/><verse number="18" style="v" sid="DEU 19:18"/>नियायधीसमन पूरा जांच-पड़ताल करंय, अऊ यदि गवाह ह कोनो संगी इसरायली के बिरूध गवाही देवत लबरा साबित होवय, <verse eid="DEU 19:18"/><verse number="19" style="v" sid="DEU 19:19"/>तब तुमन ओ लबरा गवाह के संग वइसे करव, जइसे ओह दूसर झन के संग करे के इरादा करत रिहिस। तुमन अपन बीच ले बुरई ला जरूर साफ करव। <verse eid="DEU 19:19"/><verse number="20" style="v" sid="DEU 19:20"/>बाकि मनखेमन ये बात ला सुनके डर जाहीं, अऊ फेर कभू तुम्हर बीच म अइसे दुस्ट काम नइं करे जाही। <verse eid="DEU 19:20"/><verse number="21" style="v" sid="DEU 19:21"/>तुमन दया झन देखावव: परान के बलदा परान, आंखी के बलदा आंखी, दांत के बलदा दांत, हांथ के बलदा हांथ, गोड़ के बलदा गोड़।<verse eid="DEU 19:21"/></para>
  <chapter eid="DEU 19"/>
  <chapter number="20" style="c" sid="DEU 20"/>
  <para style="s1">लड़ई बर जवई</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 20:1"/>जब तुमन अपन बईरीमन के बिरूध लड़ई करे बर जावव, अऊ घोड़ा अऊ रथ अऊ अपन ले जादा बड़े सेना ला देखव, त ओमन ले झन डरव, काबरकि यहोवा तुम्हर परमेसर, जऊन ह तुमन ला मिसर देस ले बाहिर लानिस, ओह तुम्हर संग होही। <verse eid="DEU 20:1"/><verse number="2" style="v" sid="DEU 20:2"/>जब तुमन लड़ई करे बर जावव, त पुरोहित ह आघू आवय अऊ सेना ले बात करय। <verse eid="DEU 20:2"/><verse number="3" style="v" sid="DEU 20:3"/>ओह ओमन ले कहय: “हे इसरायलीमन, सुनव: आज तुमन तुम्हर बईरीमन के बिरूध लड़ई करे बर जावत हव। डरपोक झन बनव या झन डरव; आतंकित झन होवव या ओमन के दुवारा भयभीत झन होवव। <verse eid="DEU 20:3"/><verse number="4" style="v" sid="DEU 20:4"/>काबरकि यहोवा तुम्हर परमेसर ह तुम्हर संग तुम्हर कोति ले लड़े बर जावत हे अऊ ओह तुम्हर बईरीमन के बिरूध तुमन ला जीत देवाही।”<verse eid="DEU 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 20:5"/>तब अधिकारीमन सैनिकमन ला कहंय: “का कोनो अइसने हवय, जऊन ह नवां घर बनाय हवय अऊ ओमा अब तक रहे के सुरू नइं करे हवय? त ओह अपन घर जावय, नइं तो लड़ई म ओह मर सकत हे अऊ कोनो आने मनखे ओकर घर म रहे के सुरू कर सकत हे। <verse eid="DEU 20:5"/><verse number="6" style="v" sid="DEU 20:6"/>का कोनो अइसने हवय, जऊन ह एक अंगूर के बारी लगाय हवय अऊ ओकर फर खाय के आनंद नइं उठाय हवय? त ओह अपन घर जावय, नइं तो लड़ई म ओह मर सकत हे अऊ कोनो आने मनखे ओकर बारी के फर खाय के आनंद उठाही। <verse eid="DEU 20:6"/><verse number="7" style="v" sid="DEU 20:7"/>का कोनो अइसने हवय, जेकर बिहाव के बात कोनो माईलोगन के संग तय हो गे हवय, पर ओकर बिहाव ओ माईलोगन संग नइं होय हवय? त ओह अपन घर जावय, नइं तो लड़ई म ओह मर सकत हे अऊ कोनो आने मनखे ओ माईलोगन ले बिहाव कर लीही।” <verse eid="DEU 20:7"/><verse number="8" style="v" sid="DEU 20:8"/>तब अधिकारीमन ये घलो कहंय, “का कोनो अइसने हवय, जऊन ह डरथे या डरपोक हिरदय के अय? त ओह अपन घर जावय, ताकि ओकर संगी सैनिकमन घलो हतास झन होवंय।” <verse eid="DEU 20:8"/><verse number="9" style="v" sid="DEU 20:9"/>जब अधिकारीमन सैनिकमन ले बात कर लेवंय, तब ओमन सैनिकमन ऊपर सेनापतिमन ला ठहिरावंय।<verse eid="DEU 20:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 20:10"/>जब तुमन कोनो सहर ऊपर हमला करे बर आघू बढ़व, त तुमन उहां के मनखेमन ले सांति के प्रस्ताव रखव। <verse eid="DEU 20:10"/><verse number="11" style="v" sid="DEU 20:11"/>यदि ओमन ये प्रस्ताव ला मानके सहर के दुवार ला खोल देवंय, त उहां के जम्मो मनखेमन तुम्हर बंधुवा मजदूर होहीं अऊ तुम्हर बर काम करहीं। <verse eid="DEU 20:11"/><verse number="12" style="v" sid="DEU 20:12"/>पर यदि ओमन सांति के प्रस्ताव ला स्वीकार नइं करंय अऊ तुमन ले लड़ई करे चाहंय, त तुमन ओ सहर के घेराबंदी कर लव। <verse eid="DEU 20:12"/><verse number="13" style="v" sid="DEU 20:13"/>जब यहोवा तुम्हर परमेसर ह ओ सहर ला तुम्हर अधीन कर देथे, त तुमन उहां के जम्मो आदमी ला तलवार ले मार डारव। <verse eid="DEU 20:13"/><verse number="14" style="v" sid="DEU 20:14"/>जहां तक माईलोगन, लइका, पसु अऊ सहर के आने चीजमन के बात ए, तुमन येमन ला लूट के सामान के रूप म अपन बर रख लव। अऊ तुमन ओ लूट के सामान के उपयोग कर सकत हव, जेला यहोवा तुम्हर परमेसर ह तुमन ला तुम्हर बईरीमन ले देथे। <verse eid="DEU 20:14"/><verse number="15" style="v" sid="DEU 20:15"/>तुमन ओ जम्मो सहरमन के संग अइसने ही बरताव करव, जेमन तुम्हर ले दूरिहा म हवंय अऊ लकठा के जातिमन के नो हंय।<verse eid="DEU 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 20:16"/>पर ओ जाति के सहरमन, जेला यहोवा तुम्हर परमेसर ह तुमन ला तुम्हर उत्तराधिकार म देवत हे, उहां के कोनो परानी ला जीयत झन छोंड़व। <verse eid="DEU 20:16"/><verse number="17" style="v" sid="DEU 20:17"/>ओमन ला पूरा नास कर दव—हित्ती, अमोरी, कनानी, परिज्जी, हिब्बी अऊ यबूसी जम्मो ला—जइसे कि यहोवा तुम्हर परमेसर ह तुमन ला हुकूम दे हवय। <verse eid="DEU 20:17"/><verse number="18" style="v" sid="DEU 20:18"/>नइं तो, ओमन तुमन ला ओ जम्मो घिनौना चीज करे बर सिखा दीहीं, जेला ओमन अपन देवतामन के पूजा करे के बेरा म करथें, अऊ तुमन यहोवा अपन परमेसर के बिरूध पाप करहू।<verse eid="DEU 20:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 20:19"/>जब तुमन कोनो सहर ऊपर कब्जा करे बर ओकर बिरूध लड़व अऊ ये दौरान ओ सहर के लम्बा समय तक घेराबंदी करव, त टांगा चलाके उहां के रूखमन ला झन काटव, काबरकि ओमन के फर तुम्हर खाय के काम आहीं। एकरसेति ओमन ला झन काटव। का रूखमन मनखे अंय कि तुमन ओमन के घेराबंदी करव? <verse eid="DEU 20:19"/><verse number="20" style="v" sid="DEU 20:20"/>पर तुमन ओ रूखमन ला काट सकत हव, जेमन ला तुमन जानत हव कि ओमन फरवाले रूख नो हंय; अऊ ओ रूखमन के उपयोग घेराबंदी म करव, जब तक कि ओ सहर ह तुम्हर कब्जा म नइं आ जावय।<verse eid="DEU 20:20"/></para>
  <chapter eid="DEU 20"/>
  <chapter number="21" style="c" sid="DEU 21"/>
  <para style="s1">अनजान हतिया के संबंध म बिधान</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 21:1"/>ओ देस म, जेला यहोवा तुम्हर परमेसर तुम्हर अधिकार म देवत हे, यदि उहां कोनो मरे मनखे मैदान म पड़े हुए मिलथे, अऊ ये बात के पता नइं ए कि ओकर हतियारा कोन ए, <verse eid="DEU 21:1"/><verse number="2" style="v" sid="DEU 21:2"/>त तुम्हर अगुवा अऊ नियायधीसमन जावंय अऊ जिहां ओ लास ह पड़े हवय, उहां ले लकठा के नगरमन के दूरी ला नापंय। <verse eid="DEU 21:2"/><verse number="3" style="v" sid="DEU 21:3"/>तब ओ लास के सबले लकठा के नगर के अगुवामन एक अइसे बछिया ला लें, जऊन ह कभू काम नइं करे हवय अऊ जेकर ऊपर कभू जुड़ा नइं रखे गे हवय। <verse eid="DEU 21:3"/><verse number="4" style="v" sid="DEU 21:4"/>तब ओमन ओला खाल्हे कोति एक अइसे घाटी म ले जावंय, जिहां कभू नांगर नइं जोते गे हवय या जिहां कभू कुछू नइं बोय गे हवय अऊ जिहां पानी के बहत एक सोता होवय। उहां ओ घाटी म, ओमन ओ बछिया के घेंच ला टोर देवंय। <verse eid="DEU 21:4"/><verse number="5" style="v" sid="DEU 21:5"/>तब लेवीय पुरोहितमन आघू आवंय, काबरकि यहोवा तुम्हर परमेसर ह ओमन ला चुने हवय कि ओमन सेवा करंय अऊ यहोवा के नांव म आसीस देवंय अऊ झगड़ा अऊ मारपीट के जम्मो मामला के फैसला करंय। <verse eid="DEU 21:5"/><verse number="6" style="v" sid="DEU 21:6"/>तब ओ लास के लकठा के नगर के जम्मो अगुवामन अपन हांथ ओ बछिया के ऊपर धोवंय, जेकर घेंच ला घाटी म टोर दिये गे हवय, <verse eid="DEU 21:6"/><verse number="7" style="v" sid="DEU 21:7"/>अऊ ओमन ये घोसना करंय: “ये खून हमन नइं करे हन, अऊ न ही खून करत हमन कोनो ला देखे हन। <verse eid="DEU 21:7"/><verse number="8" style="v" sid="DEU 21:8"/>हे यहोवा, अपन इसरायली मनखेमन बर ये प्रायस्चित ला स्वीकार कर, जेमन ला तेंह छोंड़ाय हस, अऊ अपन मनखेमन ला एक निरदोस मनखे के खून के दोसी झन ठहिरा।” तब ओ हतिया के दोस ह छेमा हो जाही, <verse eid="DEU 21:8"/><verse number="9" style="v" sid="DEU 21:9"/>अऊ ये किसम ले तुमन अपनआप ला एक निरदोस मनखे के खून के दोस ले सुध करहू, काबरकि तुमन ओ काम करेव, जऊन ह यहोवा के नजर म सही अय।<verse eid="DEU 21:9"/></para>
  <para style="s1">एक बंधुवा माईलोगन ले बिहाव करई</para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 21:10"/>जब तुमन अपन बईरीमन ले लड़ई करे बर जावव अऊ यहोवा तुम्हर परमेसर ह ओमन ला तुम्हर हांथ म कर देवय अऊ तुमन ओमन ला बंदी बना लेवव, <verse eid="DEU 21:10"/><verse number="11" style="v" sid="DEU 21:11"/>यदि ओ बंदी मनखेमन के बीच कोनो सुघर माईलोगन कोति तोर धियान ह जाथे अऊ तेंह ओकर कोति मोहित होथस, त तेंह ओला अपन घरवाली के रूप म ले सकत हस। <verse eid="DEU 21:11"/><verse number="12" style="v" sid="DEU 21:12"/>ओला अपन घर म ले आबे अऊ ओकर मुड़ के बाल के मुंडन करबे अऊ ओकर नाखूनमन ला कतर देबे <verse eid="DEU 21:12"/><verse number="13" style="v" sid="DEU 21:13"/>अऊ बंदी बनाय गे बेरा ओह जऊन कपड़ा पहिरे रिहिस, ओला अलग कर देबे। जब ओह तोर घर म रहिके एक महिना तक अपन दाई-ददा बर सोक मना लीही, तब तेंह ओकर करा जा सकत हस अऊ तेंह ओकर घरवाला अऊ ओह तोर घरवाली हो जाही। <verse eid="DEU 21:13"/><verse number="14" style="v" sid="DEU 21:14"/>यदि तें ओकर ले खुस नइं होवस, त ओह जिहां जाय बर चाहय, तें ओला उहां जावन देबे। तें ओला झन बेचबे या ओकर संग एक गुलाम के सहीं बरताव झन करबे, काबरकि तेंह ओकर अपमान करे हस।<verse eid="DEU 21:14"/></para>
  <para style="s1">पहिलांत के अधिकार</para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 21:15"/>यदि कोनो मनखे के दू घरवाली हवंय, अऊ ओह एक झन ले मया करथे अऊ दूसर ले नइं, अऊ दूनों घरवालीमन ओकर ले बेटा जनमंय, पर पहिलांत बेटा ओ घरवाली के अय, जेकर ले ओह मया नइं करय, <verse eid="DEU 21:15"/><verse number="16" style="v" sid="DEU 21:16"/>त जब ओह संपत्ति के बंटवारा करय, त ओ बेटा ला पहिलांत के अधिकार झन देवय, जेकर दाई ले ओह मया करथे, एकर बदले कि जऊन ह सही के पहिलांत अय अऊ जेकर दाई ले ओह मया नइं करय। <verse eid="DEU 21:16"/><verse number="17" style="v" sid="DEU 21:17"/>जऊन घरवाली ला ओह मया नइं करय, ओकर बेटा ला अपन जम्मो संपत्ति के दू गुना बांटा देके ओकर पहिलांत के अधिकार ला मानय। ओ बेटा ह अपन ददा के पौरूस के पहिला चिनहां अय। पहिलांत के अधिकार ओकर अय।<verse eid="DEU 21:17"/></para>
  <para style="s1">बिदरोही बेटा</para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 21:18"/>यदि कोनो मनखे के बेटा ह जिद्दी अऊ बिदरोही सुभाव के अय अऊ ओह अपन दाई-ददा के बात ला नइं मानय अऊ ओकर ताड़ना करे ले घलो ओमन के बात ला नइं सुनय, <verse eid="DEU 21:18"/><verse number="19" style="v" sid="DEU 21:19"/>त ओकर दाई-ददा ओला पकड़के अपन नगर के दुवार म अगुवामन करा ले जावंय। <verse eid="DEU 21:19"/><verse number="20" style="v" sid="DEU 21:20"/>ओमन अगुवामन ले कहंय, “हमर ये बेटा ह जिद्दी अऊ बिदरोही सुभाव के अय। ओह हमर बात नइं मानय। ओह पेटू अऊ मतवार ए।” <verse eid="DEU 21:20"/><verse number="21" style="v" sid="DEU 21:21"/>तब नगर के जम्मो मनखेमन पथरवाह करके ओला मार डारंय। तुमन अपन बीच ले अइसन बुरई ला दूर करव। जम्मो इसरायलीमन ये बात ला सुनके डरहीं।<verse eid="DEU 21:21"/></para>
  <para style="s1">आने-आने किसम के कानूनमन</para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 21:22"/>यदि कोनो मनखे ह मिरतू-दंड के दोसी अय, अऊ ओला मार डारे गे हवय अऊ ओकर लास ला खंभा म टांग दिये गे हवय, <verse eid="DEU 21:22"/><verse number="23" style="v" sid="DEU 21:23"/>त तुमन ओ लास ला रात भर ओ खंभा म टंगे झन रहन दव। ये बात के धियान रखव कि ओला ओहीच दिन माटी दे दिये जावय, काबरकि जेला खंभा म टांग दिये जाथे, ओह परमेसर कोति ले सरापित ठहिरथे। तुमन ओ देस ला अपबितर झन करहू, जेला यहोवा तुम्हर परमेसर ह तुमन ला तुम्हर उत्तराधिकार म देवत हे।<verse eid="DEU 21:23"/></para>
  <chapter eid="DEU 21"/>
  <chapter number="22" style="c" sid="DEU 22"/>
  <para style="p">
    <verse number="1" style="v" sid="DEU 22:1"/>यदि तें देखथस कि तोर संगी इसरायली के कोनो बईला या भेड़ ह भटक गे हवय, त तें ओकर अनदेखी झन करबे, पर धियान सहित ओला ओकर मालिक करा वापिस पहुंचा देबे। <verse eid="DEU 22:1"/><verse number="2" style="v" sid="DEU 22:2"/>यदि तोर ओ संगी इसरायली ह तोर लकठा म नइं रहय या यदि तेंह नइं जानस कि ओ बईला या भेड़ के मालिक कोन ए, त तें ओला अपन घर ले जाबे अऊ ओला तब तक अपन करा रखे रहिबे, जब तक कि ओकर मालिक ह ओला खोजत नइं आ जावय। तब तें ओला ओकर मालिक ला वापिस दे देबे। <verse eid="DEU 22:2"/><verse number="3" style="v" sid="DEU 22:3"/>यदि तोला ओमन के गंवाय कोनो गदहा या कपड़ा या कोनो आने चीज मिलथे, त ओमन के बारे म घलो अइसने ही करबे। ओकर अनदेखी झन करबे।<verse eid="DEU 22:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 22:4"/>यदि तें तोर संगी इसरायली के कोनो गदहा या बईला ला रसता म गिरे-परे देखथस, त ओला अनदेखा झन करबे। ओला उठाके ठाढ़ करे म ओकर मालिक के मदद करबे।<verse eid="DEU 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 22:5"/>कोनो माईलोगन ह आदमी के कपड़ा ला झन पहिरे, अऊ न ही कोनो आदमी ह माईलोगन के कपड़ा ला पहिरे, काबरकि जऊन ह अइसे करथे, ओकर ले यहोवा तुम्हर परमेसर ह घिन करथे।<verse eid="DEU 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 22:6"/>यदि तोला रसता के तीर म कोनो चिरई के खोंधरा दिखय, चाहे ओह कोनो रूख म होवय या भुइयां म, अऊ माई चिरई ह लइकामन संग या अंडा ऊपर बईठे हवय, त माई ला लइकामन के संग झन ले जाबे। <verse eid="DEU 22:6"/><verse number="7" style="v" sid="DEU 22:7"/>तेंह लइकामन ला ले सकत हस, पर माई चिरई ला जरूर छोंड़ देबे, ताकि तोर भलई होवय अऊ तोर उमर ह घलो लम्बा होवय।<verse eid="DEU 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 22:8"/>जब तेंह कोनो नवां घर बनाथस, त छत म चारों कोति मुन्डेर बनाबे, ताकि यदि कोनो छत ले गिर जावय, त तोर ऊपर खून के दोस झन लगय।<verse eid="DEU 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 22:9"/>अपन अंगूर के बारी म दू किसम के बीजा झन लगाबे; यदि तेंह अइसने करबे, त न सिरिप तोर लगाय फसल, पर तोर अंगूर के बारी के फर घलो असुध हो जाही।<verse eid="DEU 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 22:10"/>बईला अऊ गदहा ला एक संग फांदके नांगर झन जोतबे।<verse eid="DEU 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 22:11"/>ऊन अऊ सन ला एक संग मिलाके बनाय गे कपड़ा ला झन पहिरबे।<verse eid="DEU 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 22:12"/>अपन पहिरे के कपड़ा के चारों कोना म झालर लगवाबे।<verse eid="DEU 22:12"/></para>
  <para style="s1">बिहाव संबंध ला टोरई</para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 22:13"/>यदि कोनो आदमी ह कोनो माईलोगन ले बिहाव करथे, अऊ ओकर संग सुते के बाद ओला पसंद नइं करय <verse eid="DEU 22:13"/><verse number="14" style="v" sid="DEU 22:14"/>अऊ ओकर निन्दा करथे अऊ ये कहिके ओकर ऊपर लांछन लगाथे, “में ये माईलोगन ले बिहाव करेंव, पर जब में ओकर संग सुतेंव, त मोला ओकर कुंवारी होय के सबूत नइं मिलिस,” <verse eid="DEU 22:14"/><verse number="15" style="v" sid="DEU 22:15"/>तब ओ माईलोगन के दाई-ददा नगर के दुवार म अगुवामन करा ओ माईलोगन के कुंवारी होय के सबूत लानंय। <verse eid="DEU 22:15"/><verse number="16" style="v" sid="DEU 22:16"/>ओकर ददा ह अगुवामन ला कहय, “में ये आदमी ले मोर बेटी के बिहाव करंय, पर येह मोर बेटी ला पसंद नइं करय। <verse eid="DEU 22:16"/><verse number="17" style="v" sid="DEU 22:17"/>अब ओह ओला बदनाम करत कहत हे, ‘मोला तुम्हर बेटी म कुंवारी होय के कोनो सबूत नइं मिलिस।’ पर ये हवय मोर बेटी के कुंवारीपन के सबूत।” तब ओकर दाई-ददा नगर के अगुवामन के आघू म ओ कपड़ा ला देखावंय, <verse eid="DEU 22:17"/><verse number="18" style="v" sid="DEU 22:18"/>अऊ अगुवामन ओ आदमी ला दंड देवंय। <verse eid="DEU 22:18"/><verse number="19" style="v" sid="DEU 22:19"/>ओमन ओ आदमी ऊपर चांदी के एक सौ सेकेल<note caller="+" style="f"><char style="fr" closed="false">22:19 </char><char style="ft" closed="false">लगभग 1.2 किलोग्राम</char></note> के जुरबाना लगावंय अऊ ओ जुरबाना ला ओ जवान माईलोगन के ददा ला देवंय, काबरकि ये आदमी ह एक इसरायली कुंवारी ला बदनाम करे हवय। ओ माईलोगन ह ओकर घरवाली बने रहय; जब तक ओ आदमी ह जीयत हवय, तब तक ओह ओ माईलोगन ला तलाक झन देवय।<verse eid="DEU 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 22:20"/>पर यदि दोस ह सही पाय जाथे अऊ ओ जवान माईलोगन के कुंवारीपन के कोनो सबूत नइं मिलय, <verse eid="DEU 22:20"/><verse number="21" style="v" sid="DEU 22:21"/>त ओला ओकर ददा के घर के कपाट करा लाने जावय अऊ उहां ओकर नगर के मनखेमन ओला पथरवाह करके मार डारंय। ओह अपन ददा के घर म रहत बेभिचार करके इसरायल म बुरई करे हवय। जरूरी अय कि तुमन अपन बीच ले बुरई ला दूर करव।<verse eid="DEU 22:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 22:22"/>यदि कोनो मनखे ह कोनो आने मनखे के घरवाली के संग सुतत पाय जाथे, त जऊन मनखे ह ओ माईलोगन के संग सुते हवय अऊ ओ माईलोगन, दूनों मार डारे जावंय। जरूरी अय कि तुमन इसरायल ले बुरई ला दूर करव।<verse eid="DEU 22:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 22:23"/>यदि कोनो कुंवारी कन्या के बिहाव के बात तय हो गे हवय, अऊ कोनो आने मनखे कोनो नगर म ओकर ले मिलथे अऊ ओकर संग सुतथे, <verse eid="DEU 22:23"/><verse number="24" style="v" sid="DEU 22:24"/>त तुमन ओ दूनों ला ओ नगर के दुवार म ले जावव अऊ पथरवाह करके ओमन ला मार डारव—ओ जवान माईलोगन ला एकरसेति मार डारव काबरकि ओह एक नगर म रिहिस अऊ मदद बर नइं चिचियाईस, अऊ ओ मनखे ला एकरसेति मार डारव काबरकि ओह आने मनखे के घरवाली के सीलभंग करे हवय। जरूरी अय कि तुमन अपन बीच ले बुरई ला दूर करव।<verse eid="DEU 22:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 22:25"/>पर यदि कोनो जवान माईलोगन के बिहाव के बात तय हो गे हवय, अऊ कोनो आने मनखे ओला खेत-खार म देखके ओकर संग कुकरम करथे, त सिरिप ओ मनखे ह मार डारे जावय। <verse eid="DEU 22:25"/><verse number="26" style="v" sid="DEU 22:26"/>ओ माईलोगन के संग कुछू झन करव; ओह मिरतू-दंड पाय के लईक कोनो पाप नइं करे हवय। ये मामला ह वइसने अय, मानो कोनो मनखे ह हमला करथे अऊ अपन परोसी ला मार डारथे, <verse eid="DEU 22:26"/><verse number="27" style="v" sid="DEU 22:27"/>काबरकि ओ मनखे ह ओ जवान माईलोगन ला खेत-खार म पाईस, अऊ हालाकि ओ माईलोगन ह चिचियाईस, जेकर मंगनी हो गे रिहिस, पर उहां ओला बचइया कोनो नइं रिहिस।<verse eid="DEU 22:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="DEU 22:28"/>यदि कोनो मनखे कोनो अइसने कुंवारी कन्या ले मिलथे, जेकर बिहाव तय नइं होय हवय अऊ ओह ओकर संग कुकरम करथे अऊ दूनों पकड़े जाथें, <verse eid="DEU 22:28"/><verse number="29" style="v" sid="DEU 22:29"/>त ओ मनखे ह ओ माईलोगन के ददा ला चांदी के पचास सेकेल<note caller="+" style="f"><char style="fr" closed="false">22:29 </char><char style="ft" closed="false">लगभग 575 ग्राम या गांव के हिसाब म 50 दिन के बनी</char></note> देवय, अऊ जरूरी अय कि ओ मनखे ह ओ माईलोगन ले बिहाव करय, काबरकि ओह ओ माईलोगन के सीलभंग करे हवय। ओह अपन जिनगी भर ओला तलाक नइं दे सकय।<verse eid="DEU 22:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="DEU 22:30"/>कोनो मनखे अपन ददा के घरवाली<note caller="+" style="f"><char style="fr" closed="false">22:30 </char><char style="ft" closed="false">सायद सौतेली दाई</char></note> ले बिहाव झन करय; ओह अपन ददा के बिस्तर के अनादर झन करय।<note caller="+" style="f"><char style="fr" closed="false">22:30 </char><char style="ft" closed="false">इबरानी भासा के अनुवाद म पद (<char style="xt"><ref loc="DEU 22:30">22:30</ref></char>) ला 23:1 के रूप म गने गे हवय</char></note><verse eid="DEU 22:30"/></para>
  <chapter eid="DEU 22"/>
  <chapter number="23" style="c" sid="DEU 23"/>
  <para style="s1">सभा ले अलग करई</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 23:1"/>अइसने मनखे, जेकर अंडकोस कुचरे गे हवय या जेकर लिंग ला काट डारे गे हवय, ओह यहोवा के सभा के भीतर झन आवय।<verse eid="DEU 23:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="DEU 23:2"/>अवैध रूप ले जनमे कोनो भी मनखे या ओकर संतान यहोवा के सभा के भीतर झन आवंय, अऊ त अऊ दसवां पीढ़ी तक ओकर संतान यहोवा के सभा के भीतर झन आवंय।<verse eid="DEU 23:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 23:3"/>कोनो अमोनी या मोआबी<note caller="+" style="f"><char style="fr" closed="false">23:3 </char><char style="ft" closed="false">अमोनी अऊ मोआबीमन लूत कोति ले ओकर बेटीमन के दुवारा जनमे अवैध बेटामन के संतान रिहिन (<char style="xt"><ref loc="GEN 19:30-38">उत 19:30‑38</ref></char>)</char></note> या ओमन के कोनो संतान यहोवा के सभा के भीतर झन आवंय, इहां तक कि ओमन के दसवां पीढ़ी तक ओमन के कोनो संतान यहोवा के सभा म झन आवंय। <verse eid="DEU 23:3"/><verse number="4" style="v" sid="DEU 23:4"/>काबरकि जब तुमन मिसर देस ले निकलके आवत रहेव, त ओमन रोटी अऊ पानी लेके तुम्हर ले भेंट करे बर नइं आईन, अऊ अरम-नहरैम<note caller="+" style="f"><char style="fr" closed="false">23:4 </char><char style="ft" closed="false">उत्तर-पछिम मेसोपोटामिया</char></note> देस के पतोर नगर के बेओर के बेटा बिलाम ला पईसा देके ओकर सेवा लीन कि ओह तुमन ला सराप देवय। <verse eid="DEU 23:4"/><verse number="5" style="v" sid="DEU 23:5"/>पर यहोवा तुम्हर परमेसर ह बिलाम के बात ला नइं सुनिस पर ओकर सराप ला तुम्हर बर आसीस म बदल दीस, काबरकि यहोवा तुम्हर परमेसर ह तुम्हर ले मया करथे। <verse eid="DEU 23:5"/><verse number="6" style="v" sid="DEU 23:6"/>जब तक तेंह जीयत हस, तब तक अमोनी या मोआबीमन के संग संगवारी होय के कोनो समझौता झन करबे।<verse eid="DEU 23:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 23:7"/>तुमन कोनो एदोमी<note caller="+" style="f"><char style="fr" closed="false">23:7 </char><char style="ft" closed="false">एदोमीमन याकूब (इसरायल) के भाई एसाव के संतान रिहिन (<char style="xt"><ref loc="GEN 36:1">उत 36:1</ref></char>)</char></note> ला तुछ झन समझहू, काबरकि एदोमीमन तुम्हर रिस्तेदार अंय। तुमन कोनो मिसरी ला तुछ झन जानहू, काबरकि तुमन ओमन के देस म परदेसी के रूप म रहत रहेव। <verse eid="DEU 23:7"/><verse number="8" style="v" sid="DEU 23:8"/>ओमन के तीसरा पीढ़ी म जनमे संतानमन यहोवा के सभा म आ सकत हें।<verse eid="DEU 23:8"/></para>
  <para style="s1">डेरा म असुधता</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 23:9"/>जब तुमन अपन बईरीमन के बिरूध डेरा डालव, त ओ जम्मो चीज ले दूरिहा रहव, जऊन ह असुध अय। <verse eid="DEU 23:9"/><verse number="10" style="v" sid="DEU 23:10"/>यदि तुम्हर कोनो मनखे ह अपनआप बीर्यपात होय के कारन असुध हो गे हवय, त ओह डेरा के बाहिर जाके उहां रहय। <verse eid="DEU 23:10"/><verse number="11" style="v" sid="DEU 23:11"/>पर जब सांझ होथे, त ओह अपनआप ला धोवय, अऊ बेर बुड़े के बेरा ओह डेरा म वापिस आवय।<verse eid="DEU 23:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 23:12"/>दिसा मैदान बर डेरा के बाहिर अपन बर एक जगह तय करव। <verse eid="DEU 23:12"/><verse number="13" style="v" sid="DEU 23:13"/>औजार के रूप म तुम्हर करा खंचवा कोड़े बर कुछू होवय, अऊ जब तुमन बाहिर फिरे बर बईठव, त खंचवा कोड़के अपन मल ला ढांप दव। <verse eid="DEU 23:13"/><verse number="14" style="v" sid="DEU 23:14"/>काबरकि यहोवा तुम्हर परमेसर ह तुमन ला बचाय बर अऊ तुम्हर बईरीमन ला तुम्हर हांथ म करे बर तुम्हर डेरा म चलते-फिरथे। जरूरी अय कि तुम्हर डेरा पबितर रहय, ताकि अइसन झन होवय कि ओह तुम्हर बीच म कोनो अपबितर चीज देखके तुम्हर ले दूरिहा चले जावय।<verse eid="DEU 23:14"/></para>
  <para style="s1">आने किसम के कानून</para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 23:15"/>यदि कोनो गुलाम ह अपन मालिक ले भागके तोर करा सरन ले हवय, त ओला ओकर मालिक के हांथ म झन कर देबे। <verse eid="DEU 23:15"/><verse number="16" style="v" sid="DEU 23:16"/>ओह तुम्हर बीच म जिहां चाहय, उहां रहय अऊ जऊन भी नगर ला ओह पसंद करय, उहां ओह रहय। ओकर ऊपर अतियाचार झन करहू।<verse eid="DEU 23:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 23:17"/>कोनो भी इसरायली पुरूस या महिला मंदिर के बेस्या झन बनय। <verse eid="DEU 23:17"/><verse number="18" style="v" sid="DEU 23:18"/>तुमन कोनो महिला बेस्या या पुरूस बेस्या<note caller="+" style="f"><char style="fr" closed="false">23:18 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">कुकुर के कमई</char></note> के कमई ला यहोवा तुम्हर परमेसर के घर म मन्नत के रूप म देय बर झन लानहू, काबरकि यहोवा तुम्हर परमेसर ह दूनों चीज ले घिन करथे।<verse eid="DEU 23:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 23:19"/>तुमन कोनो इसरायली ले कोनो चीज के बियाज झन लूहू, चाहे ओह पईसा होवय या जेवन या कोनो आने चीज, जेकर ले बियाज कमाय जा सकत हे। <verse eid="DEU 23:19"/><verse number="20" style="v" sid="DEU 23:20"/>तुमन कोनो परदेसी ले बियाज ले सकत हव, पर अपन संगी इसरायली ले नइं, ताकि जऊन देस ऊपर अधिकार करे बर तुमन जावत हव, उहां जऊन काम म तुमन हांथ लगावव, ओ जम्मो काम म यहोवा तुम्हर परमेसर तुमन ला आसीस देवय।<verse eid="DEU 23:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 23:21"/>यदि तुमन यहोवा अपन परमेसर बर कोनो मन्नत मानव, त ओला पूरा करे म देरी झन करव, काबरकि यहोवा तुम्हर परमेसर ह ओ मन्नत ला पूरा करे के मांग करही अऊ देरी करे के दुवारा तुमन पाप करे के दोसी ठहिरहू। <verse eid="DEU 23:21"/><verse number="22" style="v" sid="DEU 23:22"/>पर यदि तुमन मन्नत ही नइं मानहू, त तुमन दोसी नइं ठहिरहू। <verse eid="DEU 23:22"/><verse number="23" style="v" sid="DEU 23:23"/>जऊन भी बात तुम्हर मुहूं ले निकलथे, ओला जरूर पूरा करव, काबरकि तुमन खुद होके यहोवा अपन परमेसर बर अपन मुहूं ले मन्नत माने हव।<verse eid="DEU 23:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="DEU 23:24"/>यदि तुमन अपन परोसी के अंगूर के बारी म जावव, त तुमन जतेक चाहव ओतेक अंगूर खा सकत हव, पर अपन टुकना म एको ठन भी झन रखव। <verse eid="DEU 23:24"/><verse number="25" style="v" sid="DEU 23:25"/>यदि तुमन अपन परोसी के खड़े फसलवाले खेत म जावव, त तुमन अपन हांथ ले बालीमन ला टोर सकत हव, पर तुमन ओकर खड़े फसल ला हंसिया ले झन लुवव।<verse eid="DEU 23:25"/></para>
  <chapter eid="DEU 23"/>
  <chapter number="24" style="c" sid="DEU 24"/>
  <para style="p">
    <verse number="1" style="v" sid="DEU 24:1"/>यदि कोनो मनखे कोनो माईलोगन ले बिहाव करथे अऊ ओमा कुछू अनुचित बात पाके ओला पसंद नइं करय, अऊ ओ माईलोगन ला तियाग पतर लिखके देथे अऊ ओला अपन घर ले पठो देथे, <verse eid="DEU 24:1"/><verse number="2" style="v" sid="DEU 24:2"/>अऊ ओकर घर छोंड़े के बाद, यदि ओ माईलोगन ह आने मनखे के घरवाली बन जाथे, <verse eid="DEU 24:2"/><verse number="3" style="v" sid="DEU 24:3"/>अऊ ओकर दूसरा घरवाला ओला नापसंद करथे अऊ ओला तलाकनामा लिखके देथे अऊ ओला अपन घर ले निकाल देथे, या फेर ओ दूसरा घरवाला ह मर जाथे, <verse eid="DEU 24:3"/><verse number="4" style="v" sid="DEU 24:4"/>तब ओकर पहिले के घरवाला, जऊन ह ओला तलाक देय रिहिस, ओला ओ माईलोगन ले फेर बिहाव करे के अनुमति नइं ए, काबरकि ओ माईलोगन ह असुध हो गे हवय। येह यहोवा के नजर म घिनौना होही। तुमन ओ देस ऊपर पाप झन लानव, जेला यहोवा तुम्हर परमेसर ह तुमन ला एक उत्तराधिकार के रूप म देवत हे।<verse eid="DEU 24:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 24:5"/>यदि कोनो मनखे ह नवां-नवां बिहाव करे हवय, त ओला लड़ई म झन भेजे जावय या ओला कोनो आने जिम्मेदारी झन दिये जावय। ओला एक साल तक अपन घर म रहे के छूट मिलय अऊ ओह अपन बिहाता घरवाली ला खुस रखय।<verse eid="DEU 24:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 24:6"/>कोनो भी मनखे कोनो आने मनखे के जांता या जांता के सिरिप ऊपर के पथरा ला घलो गिरवी म अपन करा झन रखय, काबरकि ओह कोनो मनखे के रोजी-रोटी ला गिरवी रखे सहीं होही।<verse eid="DEU 24:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 24:7"/>यदि कोनो मनखे कोनो संगी इसरायली ला गुलाम बनाय या गुलाम के रूप म बेचे के मनसा ले अपहरन करत पकड़े जाथे, त ओ अपहरन करइया ला जरूर मार डारे जावय। जरूरी अय कि तुमन अपन बीच ले बुरई ला दूर करव।<verse eid="DEU 24:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 24:8"/>धियान रहय कि कोढ़ के रोग के मामला म तुमन एकदम वइसे ही करव, जइसे लेवी पुरोहितमन तुमन ला निरदेस देथें। तुमन धियान देके वइसने ही करव, जइसने मेंह ओमन ला हुकूम दे हवंव। <verse eid="DEU 24:8"/><verse number="9" style="v" sid="DEU 24:9"/>सुरता करव कि तुम्हर मिसर देस ले निकल आय के बाद, रसता म यहोवा तुम्हर परमेसर ह मिरियम के संग का करिस।<verse eid="DEU 24:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 24:10"/>जब तुमन अपन परोसी ला कोनो किसम के करजा देथव, त ओकर बदले गिरवी के कोनो सामान लेय बर ओकर घर के भीतर झन जावव। <verse eid="DEU 24:10"/><verse number="11" style="v" sid="DEU 24:11"/>तुमन बाहिर खड़े रहव अऊ ओ परोसी, जेला तुमन करजा देवत हव, ओह गिरवी रखे के सामान ला तुम्हर करा बाहिर लानय। <verse eid="DEU 24:11"/><verse number="12" style="v" sid="DEU 24:12"/>यदि परोसी ह गरीब मनखे अय, त तुमन ओकर गिरवी के कपड़ा ला रथिया अपन करा रखके झन सुतहू। <verse eid="DEU 24:12"/><verse number="13" style="v" sid="DEU 24:13"/>सूरज के डूबत तक ओकर कपड़ा ला वापिस कर दव ताकि तुम्हर परोसी ह ओमा सो सकय। तब ओह तुमन ला धनबाद दीही, अऊ येह यहोवा तुम्हर परमेसर के नजर म एक धरमी काम समझे जाही।<verse eid="DEU 24:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 24:14"/>तुमन कोनो गरीब अऊ जरूरतमंद बनिहार ले फायदा झन उठावव, चाहे ओ बनिहार ह संगी इसरायली होवय या फेर तुम्हर कोनो नगर म रहइया कोनो परदेसी। <verse eid="DEU 24:14"/><verse number="15" style="v" sid="DEU 24:15"/>बेर बुड़े के पहिले ओला ओकर बनी दे दव, काबरकि ओह गरीब अय अऊ ओह ओ बनी ऊपर निरभर रहिथे। नइं तो ओह तुम्हर बिरूध यहोवा करा गोहार लगा सकत हे, अऊ तुमन पाप करे के दोसी ठहिरहू।<verse eid="DEU 24:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 24:16"/>दाई-ददा ला ओमन के लइकामन के कारन मिरतू-दंड झन मिलय, अऊ न ही लइकामन ओमन के दाई-ददा के कारन मार डारे जावंय; हर एक ह अपन खुद के पाप के कारन मरही।<verse eid="DEU 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 24:17"/>कोनो परदेसी या अनाथ के नियाय ला झन बिगाड़व, या कोनो बिधवा के कपड़ा ला गिरवी झन रखव। <verse eid="DEU 24:17"/><verse number="18" style="v" sid="DEU 24:18"/>सुरता रखव कि तुमन मिसर देस म गुलाम रहेव अऊ यहोवा तुम्हर परमेसर ह तुमन ला उहां ले छोंड़ाईस। एकर कारन मेंह तुमन ला अइसे करे के हुकूम देवत हंव।<verse eid="DEU 24:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 24:19"/>जब तुमन अपन खेत म फसल लुवत हव अऊ फसल के कोनो बीड़ा ह तुम्हर नजर ले छूट जाथे, त ओला लेय बर वापिस झन जावव। ओला परदेसी, अनाथ अऊ बिधवा बर छोंड़ दव, ताकि यहोवा तुम्हर परमेसर ह तुमन ला तुम्हर जम्मो काम म आसीस देवय। <verse eid="DEU 24:19"/><verse number="20" style="v" sid="DEU 24:20"/>जब तुमन अपन जैतून रूख ले फरमन ला गिरावव, त डारामन म दूसर बार फर टोरे बर झन जावव। जऊन ह बच जाथे, ओला परदेसी, अनाथ अऊ बिधवा बर छोंड़ दव। <verse eid="DEU 24:20"/><verse number="21" style="v" sid="DEU 24:21"/>जब तुमन अपन अंगूर के बारी म अंगूर टोरे बर जावव, त अंगूर के नारमन म फर टोरे बर दूबारा झन जावव। जऊन ह बच जाथे, ओला परदेसी, अनाथ अऊ बिधवा बर छोंड़ दव। <verse eid="DEU 24:21"/><verse number="22" style="v" sid="DEU 24:22"/>सुरता रखव कि तुमन मिसर देस म गुलाम रहेव। एकर कारन मेंह तुमन ला अइसे करे के हुकूम देवत हंव।<verse eid="DEU 24:22"/></para>
  <chapter eid="DEU 24"/>
  <chapter number="25" style="c" sid="DEU 25"/>
  <para style="p">
    <verse number="1" style="v" sid="DEU 25:1"/>जब मनखेमन के बीच म झगरा होथे, त ओमन येला अदालत म ले जावंय अऊ नियायधीसमन निरदोस ला दोस मुक्त करत अऊ दोसी ला दंड देवत मामला के फैसला करंय। <verse eid="DEU 25:1"/><verse number="2" style="v" sid="DEU 25:2"/>यदि दोसी मनखे ह मार खाय के लईक दोस करे हवय, त नियायधीस ह ओला भुइयां म लेटाय अऊ अपन आघू म ओला ओतेक कोर्रा लगवाय, जतेक ओकर अपराध के मुताबिक ठहिराय गे हवय, <verse eid="DEU 25:2"/><verse number="3" style="v" sid="DEU 25:3"/>पर नियायधीस ह ओला चालीस कोर्रा ले जादा झन लगवाय। यदि दोसी मनखे ला चालीस ले जादा कोर्रा लगवाय जाथे, त तुम्हर नजर म तुम्हर संगी इसरायली के अपमान होही।<verse eid="DEU 25:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 25:4"/>दंवरी म चलत बईला के मुहूं ला झन बांधव।<verse eid="DEU 25:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 25:5"/>यदि भाईमन एक संग रहत हवंय अऊ ओमा के एक झन ह बिगर कोनो बेटा के मर जाथे, त ओकर बिधवा ह परिवार के बाहिर बिहाव झन करय। ओकर घरवाला के भाई ह ओला लेके ओकर ले बिहाव करय अऊ ओकर घरवाला के भाई के जिम्मेदारी ला ओकर बर पूरा करय। <verse eid="DEU 25:5"/><verse number="6" style="v" sid="DEU 25:6"/>ओ माईलोगन ह जऊन पहिलांत बेटा ला जनम देथे, ओकर नांव ओ मरे भाई के नांव म रखे जावय ताकि ओकर नांव इसरायल ले खतम झन हो जावय।<verse eid="DEU 25:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 25:7"/>पर, यदि कोनो मनखे ह अपन भाई के घरवाली ले बिहाव करे नइं चाहय, त ओकर भाई के घरवाली ह नगर के दुवार म अगुवामन करा जाके कहय, “मोर घरवाला के भाई ह इसरायल म अपन भाई के नांव ला बनाय रखे नइं चाहथे। ओह मोर संग मोर घरवाला के भाई के जिम्मेदारी ला पूरा करे बर नइं चाहथे।” <verse eid="DEU 25:7"/><verse number="8" style="v" sid="DEU 25:8"/>तब नगर के अगुवामन ओला उहां बलावंय अऊ ओकर ले बात करंय। यदि ओह अपन बात म अड़े रहय अऊ कहय, “मेंह ओकर ले बिहाव करे नइं चाहत हंव।” <verse eid="DEU 25:8"/><verse number="9" style="v" sid="DEU 25:9"/>तब ओकर भाई के बिधवा ह अगुवामन के आघू म ओकर करा जावय, ओकर एक चप्पल ला उतारय, अऊ ओकर मुहूं म थूकके कहय, “ओ मनखे के संग अइसे करे जाथे, जऊन ह अपन भाई के बंस ला आघू बढ़ाय नइं चाहय।” <verse eid="DEU 25:9"/><verse number="10" style="v" sid="DEU 25:10"/>इसरायल म ओ मनखे के परिवार ह ये नांव ले जाने जाही—चप्पल उतारे गय मनखे के परिवार।<verse eid="DEU 25:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 25:11"/>यदि दू झन मनखे के बीच मारपीट होवत हे अऊ ओमा के एक झन के घरवाली ह अपन घरवाला ला आने मनखे ले बचाय बर आथे, अऊ अपन हांथ ले ओ मनखे के गुपत अंग ला पकड़ लेथे, <verse eid="DEU 25:11"/><verse number="12" style="v" sid="DEU 25:12"/>त तुमन ओकर हांथ ला काट डारव। ओकर ऊपर दया झन करव।<verse eid="DEU 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 25:13"/>अपन झोला म एक ही तौल के दू किसम के बाट झन रखव—एक ठन भारी अऊ एक ठन हल्का। <verse eid="DEU 25:13"/><verse number="14" style="v" sid="DEU 25:14"/>अपन घर म दू किसम के नाप झन रखव—एक ठन लम्बा अऊ एक ठन छोटे। <verse eid="DEU 25:14"/><verse number="15" style="v" sid="DEU 25:15"/>तुम्हर करा सही अऊ ईमानदार तौल अऊ नाप रहय, ताकि ओ देस म तुम्हर लम्बा उमर होवय, जेला यहोवा तुम्हर परमेसर ह तुमन ला देवत हे। <verse eid="DEU 25:15"/><verse number="16" style="v" sid="DEU 25:16"/>काबरकि यहोवा तुम्हर परमेसर ह ओ मनखे ले घिन करथे, जऊन ह अइसने काम करथे, जऊन ह बेईमानी करथे।<verse eid="DEU 25:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 25:17"/>सुरता रखव कि जब तुमन मिसर देस ले निकलके आवत रहेव, त रसता म अमालेकीमन तुम्हर संग का करिन। <verse eid="DEU 25:17"/><verse number="18" style="v" sid="DEU 25:18"/>जब तुमन थकके चूर हो गे रहेव, त ओमन ओ मनखेमन ऊपर हमला कर दीन, जेमन झुंड के पाछू धीरे-धीरे चलत रिहिन; अमालेकीमन के मन म परमेसर के कोनो भय नइं रिहिस। <verse eid="DEU 25:18"/><verse number="19" style="v" sid="DEU 25:19"/>जब यहोवा तुम्हर परमेसर ह तुमन ला तुम्हर चारों कोति के ओ जम्मो बईरीमन ले अराम देथे, जेमन के देस ला ओह तुमन ला तुम्हर अधिकार म उत्तराधिकार के रूप म देवत हे, त तुमन अमालेकीमन ला मारके ओमन के नांव ला पूरा धरती ले मिटा दूहू। ये बात ला झन भुलाहू!<verse eid="DEU 25:19"/></para>
  <chapter eid="DEU 25"/>
  <chapter number="26" style="c" sid="DEU 26"/>
  <para style="s1">पहिला फर अऊ दसमांस</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 26:1"/>जब तुमन ओ देस म हबर जावव, जेला यहोवा तुम्हर परमेसर ह तुमन ला एक उत्तराधिकार के रूप म देवत हे अऊ जब तुमन ओकर ऊपर अधिकार करके ओमा बस जावव, <verse eid="DEU 26:1"/><verse number="2" style="v" sid="DEU 26:2"/>त जऊन देस यहोवा तुम्हर परमेसर ह तुमन ला देवत हे, उहां जऊन फसल तुमन लगाथव, ओ जम्मो के कुछू पहिली फर ला लेके एक ठन टुकना म रखव। तब ओ जगह म जावव, जेला यहोवा तुम्हर परमेसर ह अपन नांव के निवास के रूप म चुनही <verse eid="DEU 26:2"/><verse number="3" style="v" sid="DEU 26:3"/>अऊ ओ समय उहां पद म रहइया पुरोहित ले कहव, “आज मेंह यहोवा तोर परमेसर करा घोसना करत हंव कि मेंह ओ देस म आ गे हंव, जेला देय के वायदा यहोवा ह हमर पुरखामन ले करे रिहिस।” <verse eid="DEU 26:3"/><verse number="4" style="v" sid="DEU 26:4"/>तब पुरोहित ह ओ टुकना ला तुम्हर हांथ ले, लेय लीही अऊ यहोवा तुम्हर परमेसर के बेदी के आघू म मढ़ा दीही। <verse eid="DEU 26:4"/><verse number="5" style="v" sid="DEU 26:5"/>तब तुमन यहोवा अपन परमेसर के आघू म घोसना करहू: “मोर पुरखा ह एक घुमंतू अरामी मनखे रिहिस, अऊ ओह अपन कुछू मनखेमन के संग जाके मिसर देस म रहे लगिस अऊ ओह एक बड़े, सक्तिसाली जाति हो गीस अऊ ओमन संखिया म बहुंत हो गीन। <verse eid="DEU 26:5"/><verse number="6" style="v" sid="DEU 26:6"/>पर मिसरीमन हमर संग खराप बरताव करिन अऊ हमर ऊपर अतियाचार करिन, अऊ हमर ले कठोर मेहनत करवाईन। <verse eid="DEU 26:6"/><verse number="7" style="v" sid="DEU 26:7"/>तब हमन यहोवा, हमर पुरखामन के परमेसर ले गोहारेंन अऊ यहोवा ह हमर गोहार ला सुनिस अऊ हमर दुरगति, मेहनत अऊ हमर ऊपर होवत अतियाचार ला देखिस, <verse eid="DEU 26:7"/><verse number="8" style="v" sid="DEU 26:8"/>अऊ यहोवा ह अपन सक्तिसाली हांथ, लमाय हुए बाहां, बड़े आतंक अऊ चिनहां अऊ चमतकार देखाके हमन ला मिसर देस ले बाहिर लानिस। <verse eid="DEU 26:8"/><verse number="9" style="v" sid="DEU 26:9"/>ओह हमन ला ये जगह म लानिस अऊ ये देस हमन ला दीस, जिहां दूध अऊ मंधरस बहुंतायत म हवय; <verse eid="DEU 26:9"/><verse number="10" style="v" sid="DEU 26:10"/>अऊ अब मेंह भुइयां के पहिली ऊपज ला लाने हंव, जेला हे यहोवा, तेंह मोला दे हस।” तब तुमन ओ टुकना ला यहोवा अपन परमेसर के आघू म रख दव अऊ यहोवा ला दंडवत करव। <verse eid="DEU 26:10"/><verse number="11" style="v" sid="DEU 26:11"/>तब तुमन अऊ लेवी अऊ तुम्हर बीच रहइया परदेसीमन ओ जम्मो चीज बर आनंद मनावव, जेला यहोवा तुम्हर परमेसर ह तुमन ला अऊ तुम्हर परिवार ला देय हवय।<verse eid="DEU 26:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 26:12"/>जब तुमन तीसरा साल म याने कि दसमांस देय के साल म अपन जम्मो ऊपज के दसवां भाग ला अलग कर लेवव, त येला लेवी, परदेसी, अनाथ अऊ बिधवा ला दे दव, ताकि ओमन येला खाके तुम्हर नगर म संतोस हो जावंय। <verse eid="DEU 26:12"/><verse number="13" style="v" sid="DEU 26:13"/>तब यहोवा अपन परमेसर ले कहव: “मेंह तोर हुकूम के मुताबिक अपन घर ले पबितर भाग ला अलग करे हंव अऊ ओ भाग ला लेवी, परदेसी, अनाथ अऊ बिधवा ला दे देय हंव। मेंह न तो तोर हुकूममन ला टारे हंव अऊ न ही ओमा के कोनो ला भुलाय हंव। <verse eid="DEU 26:13"/><verse number="14" style="v" sid="DEU 26:14"/>जब मेंह सोक मनात रहेंव, तब मेंह ओ पबितर भाग के कोनो चीज ला नइं खाय हंव, न ही ओमा के कोनो चीज ला हटाय हंव, जब में असुध रहेंव अऊ न ही ओमा के कोनो चीज ला मेंह मरे मनखे ला अरपन करे हंव। मेंह यहोवा अपन परमेसर के हुकूम ला माने हंव; मेंह ओ हर काम करे हंव, जेकर हुकूम तेंह मोला दे हस। <verse eid="DEU 26:14"/><verse number="15" style="v" sid="DEU 26:15"/>तें अपन पबितर निवास, स्वरग ले खाल्हे देख, अऊ अपन इसरायली मनखे अऊ ओ देस ला आसीस दे, जेला हमर पुरखामन ले करे गय वायदा के मुताबिक तेंह हमन ला दे हस, जिहां दूध अऊ मंधरस बहुंतायत म हवय।”<verse eid="DEU 26:15"/></para>
  <para style="s1">यहोवा के हुकूममन के पालन करव</para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 26:16"/>यहोवा तुम्हर परमेसर ह तुमन ला आज हुकूम देवत हे कि तुमन ये बिधि अऊ कानूनमन के पालन करव; धियान देके अपन पूरा मन अऊ पूरा परान ले येमन के पालन करव। <verse eid="DEU 26:16"/><verse number="17" style="v" sid="DEU 26:17"/>तुमन आज घोसना करे हव कि यहोवा तुम्हर परमेसर अय अऊ ये कि तुमन ओकर हुकूम के मुताबिक चलहू अऊ ये कि तुमन ओकर बिधि, हुकूम अऊ कानूनमन ला मानहू अऊ ओकर बात ला सुनहू। <verse eid="DEU 26:17"/><verse number="18" style="v" sid="DEU 26:18"/>अऊ यहोवा ह अपन वायदा के मुताबिक आज घोसना करे हवय कि तुमन ओकर मनखे, ओकर कीमती धन अव, अऊ ये कि तुमन ओकर जम्मो हुकूम के पालन करव। <verse eid="DEU 26:18"/><verse number="19" style="v" sid="DEU 26:19"/>ओह घोसना करे हवय कि ओह जतेक भी जाति के मनखे बनाय हवय, ओ जम्मो जातिमन ले तुमन ला परसंसा, खियाती अऊ आदर म ऊपर रखही अऊ ये कि तुमन यहोवा तुम्हर परमेसर बर एक पबितर मनखे ठहिरहू, जइसे कि ओह वायदा करे हवय।<verse eid="DEU 26:19"/></para>
  <chapter eid="DEU 26"/>
  <chapter number="27" style="c" sid="DEU 27"/>
  <para style="s1">एबाल पहाड़ ऊपर बेदी</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 27:1"/>मूसा अऊ इसरायल के अगुवामन मनखेमन ला हुकूम दीन: “ये जम्मो हुकूम के पालन करव, जेला आज मेंह तुमन ला देवत हंव। <verse eid="DEU 27:1"/><verse number="2" style="v" sid="DEU 27:2"/>जब तुमन यरदन नदी ला पार करके ओ देस म हबरव, जेला यहोवा तुम्हर परमेसर ह तुमन ला देवत हे, त कुछू बड़े-बड़े पथरामन ला तियार करव अऊ ओमन ला चूना ले पलस्तर कर दव। <verse eid="DEU 27:2"/><verse number="3" style="v" sid="DEU 27:3"/>अऊ ओमन म ये कानून के जम्मो बातमन ला लिखव, जब तुमन यरदन नदी पार करके ओ देस म हबरव, जेला यहोवा तुम्हर परमेसर ह तुमन ला देवत हे, जेमा दूध अऊ मंधरस बहुंतायत म हवय, जइसे कि यहोवा, तुम्हर पुरखामन के परमेसर ह तुमन ले वायदा करे रिहिस। <verse eid="DEU 27:3"/><verse number="4" style="v" sid="DEU 27:4"/>अऊ जब तुमन यरदन नदी ला पार कर लेवव, त ये पथरामन ला एबाल पहाड़ ऊपर खड़े करव, जइसे कि मेंह आज तुमन ला हुकूम दे हंव, अऊ ये पथरामन ला चूना ले पलस्तर कर दव। <verse eid="DEU 27:4"/><verse number="5" style="v" sid="DEU 27:5"/>उहां तुमन यहोवा अपन परमेसर बर पथरामन ले एक बेदी बनावव। ओ पथरामन ऊपर लोहा के कोनो औजार के उपयोग झन करहू। <verse eid="DEU 27:5"/><verse number="6" style="v" sid="DEU 27:6"/>यहोवा अपन परमेसर बर खेत के पथरामन ले बेदी ला बनावव अऊ ओमा यहोवा अपन परमेसर बर होम-बलिदान चघावव। <verse eid="DEU 27:6"/><verse number="7" style="v" sid="DEU 27:7"/>उहां मेल-बलिदान घलो चघावव अऊ ओला खावव अऊ यहोवा अपन परमेसर के आघू म आनंद मनावव। <verse eid="DEU 27:7"/><verse number="8" style="v" sid="DEU 27:8"/>अऊ जऊन पथरामन ला तुमन खड़े करे हव, ओमा ये कानून के हर एक बचन ला साफ-साफ लिख दव।”<verse eid="DEU 27:8"/></para>
  <para style="s1">एबाल पहाड़ ले सराप</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 27:9"/>तब मूसा अऊ लेवी पुरोहितमन जम्मो इसरायलीमन ले कहिन, “हे इसरायलीमन सांत रहव अऊ सुनव! तुमन अब यहोवा अपन परमेसर के मनखे बन गे हव। <verse eid="DEU 27:9"/><verse number="10" style="v" sid="DEU 27:10"/>यहोवा अपन परमेसर के बात ला मानव अऊ जऊन हुकूम अऊ बिधि मेंह आज तुमन ला देवत हंव, ओमन के पालन करव।”<verse eid="DEU 27:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 27:11"/>ओहीच दिन मूसा ह मनखेमन ला ये हुकूम दीस:<verse eid="DEU 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 27:12"/>जब तुमन यरदन नदी ला पार कर लव, तब ये गोत्रमन के मनखे गरीजीम पहाड़ ऊपर ठाढ़ होके मनखेमन ला आसीस दीहीं: सिमोन, लेवी, यहूदा, इस्साकार, यूसुफ अऊ बिनयामीन। <verse eid="DEU 27:12"/><verse number="13" style="v" sid="DEU 27:13"/>अऊ ये गोत्रमन के मनखे एबाल पहाड़ ऊपर ठाढ़ होके सराप दीहीं: रूबेन, गाद, आसेर, जबूलून, दान अऊ नपताली।<verse eid="DEU 27:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 27:14"/>तब लेवीमन इसरायल के जम्मो मनखेमन ला ऊंचहा अवाज म कहिहीं:<verse eid="DEU 27:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 27:15"/>“सरापित होवय ओ मनखे, जऊन ह ढालके या गढ़के कोनो मूरती बनाथे या बनवाथे अऊ ओला गुपत जगह म स्थापित करथे, काबरकि यहोवा ह ये काम ले घिन करथे।”</para>
  <para style="pr" vid="DEU 27:15">तब जम्मो मनखेमन कहंय, “आमीन!”<verse eid="DEU 27:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 27:16"/>“सरापित होवय ओ मनखे, जऊन ह अपन दाई या ददा के अपमान करथे।”</para>
  <para style="pr" vid="DEU 27:16">तब जम्मो मनखेमन कहंय, “आमीन!”<verse eid="DEU 27:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 27:17"/>“सरापित होवय ओ मनखे, जऊन ह अपन परोसी के सीमना के पथरा ला हटाथे।”</para>
  <para style="pr" vid="DEU 27:17">तब जम्मो मनखेमन कहंय, “आमीन!”<verse eid="DEU 27:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 27:18"/>“सरापित होवय ओ मनखे, जऊन ह अंधरा ला डहार ले भटका देथे।<note caller="+" style="f"><char style="fr" closed="false">27:18 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="LEV 19:14">लैव्य 19:14</ref></char></char></note>”</para>
  <para style="pr" vid="DEU 27:18">तब जम्मो मनखेमन कहंय, “आमीन!”<verse eid="DEU 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 27:19"/>“सरापित होवय ओ मनखे, जऊन ह परदेसी, अनाथ या बिधवा के नियाय ला बिगाड़थे।”</para>
  <para style="pr" vid="DEU 27:19">तब जम्मो मनखेमन कहंय, “आमीन!”<verse eid="DEU 27:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 27:20"/>“सरापित होवय ओ मनखे, जऊन ह अपन ददा के घरवाली<note caller="+" style="f"><char style="fr" closed="false">27:20 </char><char style="ft" closed="false">अपन सौतेली दाई</char></note> के संग कुकरम करथे; ओह अपन ददा के दसना ला कलंकित करथे।”</para>
  <para style="pr" vid="DEU 27:20">तब जम्मो मनखेमन कहंय, “आमीन!”<verse eid="DEU 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 27:21"/>“सरापित होवय ओ मनखे, जऊन ह कोनो पसु के संग कुकरम करथे।”</para>
  <para style="pr" vid="DEU 27:21">तब जम्मो मनखेमन कहंय, “आमीन!”<verse eid="DEU 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 27:22"/>“सरापित होवय ओ मनखे, जऊन ह अपन बहिनी या सौतेली बहिनी के संग कुकरम करथे।”</para>
  <para style="pr" vid="DEU 27:22">तब जम्मो मनखेमन कहंय, “आमीन!”<verse eid="DEU 27:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 27:23"/>“सरापित होवय ओ मनखे, जऊन ह अपन सास के संग कुकरम करथे।”</para>
  <para style="pr" vid="DEU 27:23">तब जम्मो मनखेमन कहंय, “आमीन!”<verse eid="DEU 27:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="DEU 27:24"/>“सरापित होवय ओ मनखे, जऊन ह छुपके अपन परोसी ला मार डारथे।”</para>
  <para style="pr" vid="DEU 27:24">तब जम्मो मनखेमन कहंय, “आमीन!”<verse eid="DEU 27:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 27:25"/>“सरापित होवय ओ मनखे, जऊन ह कोनो निरदोस मनखे के हतिया करे बर सुपारी लेथे।”</para>
  <para style="pr" vid="DEU 27:25">तब जम्मो मनखेमन कहंय, “आमीन!”<verse eid="DEU 27:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 27:26"/>“सरापित होवय ओ मनखे, जऊन ह ये कानून ला सुनके येमन के पालन नइं करय।”</para>
  <para style="pr" vid="DEU 27:26">तब जम्मो मनखेमन कहंय, “आमीन!”<verse eid="DEU 27:26"/></para>
  <chapter eid="DEU 27"/>
  <chapter number="28" style="c" sid="DEU 28"/>
  <para style="s1">हुकूम के पालन करई म आसीस</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 28:1"/>यदि तुमन यहोवा अपन परमेसर के जम्मो हुकूम ला मानहू अऊ धियान देके ओकर जम्मो हुकूम के पालन करहू, जेला में आज तुमन ला देवत हंव, त यहोवा तुम्हर परमेसर ह तुमन ला धरती के जम्मो जाति के मनखेमन ले बहुंत ऊपर ठहिराही। <verse eid="DEU 28:1"/><verse number="2" style="v" sid="DEU 28:2"/>यदि तुमन यहोवा अपन परमेसर के बात ला मानव, त ये जम्मो आसीस तुमन ला मिलही अऊ ये आसीसमन तुम्हर संग बने रहिहीं:<verse eid="DEU 28:2"/></para>
  <para style="pm">
    <verse number="3" style="v" sid="DEU 28:3"/>तुमन ला सहर म अऊ खेत-खार म आसीस मिलही।<verse eid="DEU 28:3"/></para>
  <para style="pm">
    <verse number="4" style="v" sid="DEU 28:4"/>तुम्हर संतान ला आसीस मिलही, अऊ तुम्हर देस के फसल अऊ तुम्हर पसुमन के पीला—तुम्हर झुंड के बछरू अऊ मेढ़ा-पीलामन ला आसीस मिलही।<verse eid="DEU 28:4"/></para>
  <para style="pm">
    <verse number="5" style="v" sid="DEU 28:5"/>तुम्हर टुकना अऊ तुम्हर पीसान साने के बरतन ला आसीस मिलही।<verse eid="DEU 28:5"/></para>
  <para style="pm">
    <verse number="6" style="v" sid="DEU 28:6"/>तुमन ला आसीस मिलही, जब तुमन भीतर आहू अऊ तुमन ला आसीस मिलही, जब तुमन बाहिर जाहू।<verse eid="DEU 28:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 28:7"/>यहोवा ह अइसे करही कि तुम्हर बिरूध ठाढ़ होवइया बईरीमन तुम्हर ले हार जाहीं। ओमन एक दिग ले तो हमला करहीं, पर सात दिग ले होके भाग जाहीं।<verse eid="DEU 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 28:8"/>यहोवा ह तुम्हर कोठार ऊपर अऊ तुमन जऊन कुछू करथव, ओ जम्मो म आसीस दीही। यहोवा तुम्हर परमेसर ह तुमन ला ओ देस म आसीस दीही, जेला ओह तुमन ला देवत हे।<verse eid="DEU 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 28:9"/>यदि तुमन यहोवा तुम्हर परमेसर के हुकूममन के पालन करहू अऊ ओकर रसता म चलहू, त यहोवा ह तुमन ला अपन पबितर मनखे के रूप म स्थापित करही, जइसे कि ओह तुम्हर ले कसम खाके वायदा करे हवय। <verse eid="DEU 28:9"/><verse number="10" style="v" sid="DEU 28:10"/>तब धरती के जम्मो मनखेमन देखहीं कि तुमन यहोवा के नांव के दुवारा बलाय जाथव, त ओमन तुम्हर ले डरहीं। <verse eid="DEU 28:10"/><verse number="11" style="v" sid="DEU 28:11"/>अऊ जऊन देस तुमन ला देय बर यहोवा ह तुम्हर पुरखामन ले कसम खाय रिहिस, ओ देस म ओह तुम्हर संतान, तुम्हर पसु-धन के बढ़ती अऊ तुम्हर भुइयां के फसल म बहुंत उन्नति करही।<verse eid="DEU 28:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 28:12"/>यहोवा ह उदार मन से अकास के भंडार ला खोल दीही अऊ समय म तुम्हर भुइयां म बारिस पठोही अऊ तुम्हर जम्मो काम म आसीस दीही। तुमन बहुंत जाति के मनखेमन ला उधार दूहू, पर कोनो मेर ले तुमन ला उधार लेना नइं पड़ही। <verse eid="DEU 28:12"/><verse number="13" style="v" sid="DEU 28:13"/>यहोवा ह तुमन ला पुंछी नइं, पर मुड़ ठहिराही। यदि तुमन यहोवा अपन परमेसर के हुकूम ऊपर धियान दूहू, जेला आज मेंह तुमन ला देवत हंव अऊ धियान देके ओमन के पालन करहू, त तुमन हमेसा सबले ऊपर रहिहू, खाल्हे म कभू नइं रहिहू। <verse eid="DEU 28:13"/><verse number="14" style="v" sid="DEU 28:14"/>जऊन बातमन के आज मेंह तुमन ला हुकूम देवत हंव, ओमा ले एती-ओती झन जावव; जेवनी या डेरी मुड़के आने देवतामन के पाछू झन चलव अऊ न ही ओमन के सेवा करव।<verse eid="DEU 28:14"/></para>
  <para style="s1">हुकूम नइं माने ले सराप</para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 28:15"/>पर, यदि तुमन यहोवा तुम्हर परमेसर के बात ला नइं मानव अऊ धियान देके ओकर ओ जम्मो हुकूम अऊ बिधिमन के पालन नइं करव, जेला आज मेंह तुमन ला देवत हंव, त ये जम्मो सराप तुम्हर ऊपर पड़ही अऊ तुम्हर ऊपर लगे रहिही:<verse eid="DEU 28:15"/></para>
  <para style="pm">
    <verse number="16" style="v" sid="DEU 28:16"/>तुमन अपन सहर म अऊ अपन खेत-खार म सरापित होहू।<verse eid="DEU 28:16"/></para>
  <para style="pm">
    <verse number="17" style="v" sid="DEU 28:17"/>तुम्हर टुकना अऊ तुम्हर पीसान गुंथे के बरतन सरापित होही।<verse eid="DEU 28:17"/></para>
  <para style="pm">
    <verse number="18" style="v" sid="DEU 28:18"/>तुम्हर संतान ह सरापित होही, अऊ तुम्हर भुइयां के फसल, अऊ तुम्हर गरूवा-बईला के पीला अऊ भेड़-बकरी के पीलामन सरापित होहीं।<verse eid="DEU 28:18"/></para>
  <para style="pm">
    <verse number="19" style="v" sid="DEU 28:19"/>तुमन सरापित होहू, जब तुमन भीतर आहू अऊ सरापित होहू, जब तुमन बाहिर जाहू।<verse eid="DEU 28:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 28:20"/>यहोवा ला तियागके तुमन जऊन दुस्ट काम करहू, ओकर कारन तुमन जऊन कुछू करहू, यहोवा ह तुमन ला हर चीज म सराप दीही, डरवाही अऊ दबकारही, जब तक कि तुमन नास नइं हो जाहू अऊ खतम नइं हो जाहू। <verse eid="DEU 28:20"/><verse number="21" style="v" sid="DEU 28:21"/>यहोवा ह तुमन म तब तक महामारी लानही, जब तक कि तुमन ओ देस ले खतम नइं हो जावव, जेकर ऊपर तुमन अधिकार करे बर जावत हव। <verse eid="DEU 28:21"/><verse number="22" style="v" sid="DEU 28:22"/>यहोवा ह तुम्हर ऊपर कोढ़ के संग जर अऊ जलन, झुलसइया गरमी अऊ अकाल, रोग अऊ गेरूई के बेमारी लानही, अऊ येमन तुम्हर ऊपर तब तक रहिहीं, जब तक कि तुमन नास नइं हो जाहू। <verse eid="DEU 28:22"/><verse number="23" style="v" sid="DEU 28:23"/>तुम्हर मुड़ के ऊपर अकास ह कांसा अऊ तुम्हर गोड़ खाल्हे के भुइयां ह लोहा हो जाही। <verse eid="DEU 28:23"/><verse number="24" style="v" sid="DEU 28:24"/>यहोवा ह तुम्हर देस म पानी के बदले बालू अऊ धुर्रा के बारिस करही; येह अकास ले तब तक गिरही, जब तक कि तुमन नास नइं हो जाहू।<verse eid="DEU 28:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 28:25"/>यहोवा ह तुमन ला तुम्हर बईरीमन ले हरवा दीही। तुमन ओमन ऊपर एक दिग ले आहू, पर सात दिग ले भागहू, अऊ तुमन धरती ऊपर जम्मो राज के मनखेमन बर घिन करे के चीज बन जाहू। <verse eid="DEU 28:25"/><verse number="26" style="v" sid="DEU 28:26"/>तुम्हर लासमन जम्मो चिरई अऊ जंगली पसुमन के जेवन बन जाहीं, अऊ उहां ओमन ला कोनो भगानेवाला नइं होही। <verse eid="DEU 28:26"/><verse number="27" style="v" sid="DEU 28:27"/>यहोवा ह तुमन ला मिसर देस के सहीं फोड़ा, अऊ गिलठी, पके घाव अऊ खुजली के पीरा दीही, जेमन ले तुमन ला चंगई नइं मिलही। <verse eid="DEU 28:27"/><verse number="28" style="v" sid="DEU 28:28"/>यहोवा ह तुमन ला पागल अऊ अंधरा कर दीही अऊ तुम्हर जी ला घबरा दीही। <verse eid="DEU 28:28"/><verse number="29" style="v" sid="DEU 28:29"/>अऊ जइसे कोनो अंधरा मनखे अंधियार म टमड़थे, वइसे तुमन दिन-दुपहरी के टमड़त फिरहू। तुमन ला तुम्हर कोनो भी काम-बुता म सफलता नइं मिलही; हमेसा तुम्हर ऊपर अतियाचार होही अऊ तुमन लूटे जाहू, अऊ तुमन ला बचइया कोनो नइं होही।<verse eid="DEU 28:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="DEU 28:30"/>तुम्हर सगाई कोनो माईलोगन ले तो होही, पर कोनो आने मनखे ओला लेके ओकर ले कुकरम करही। तुमन घर तो बनाहू, पर ओमा रह नइं सकहू। तुमन अंगूर के बारी तो लगाहू, पर ओकर फर खाय के आनंद नइं उठा सकहू। <verse eid="DEU 28:30"/><verse number="31" style="v" sid="DEU 28:31"/>तुम्हर बईला ला तुम्हर आंखी के आघू म काटे जाही, पर तुमन ला ओमा के कुछू भी खाय बर नइं मिलही। तुम्हर गदहा ला तुम्हर ले छीन लिये जाही, अऊ तुमन ला ओह फेर नइं मिलही। तुम्हर भेड़मन तुम्हर बईरीमन ला दे दिये जाहीं, अऊ ओमन ला बचइया कोनो नइं होही। <verse eid="DEU 28:31"/><verse number="32" style="v" sid="DEU 28:32"/>तुम्हर बेटा अऊ बेटीमन आने देस के मनखेमन ला बंधुवा के रूप म दे दिये जाहीं, अऊ ओमन के डहार देखत-देखत तुमन के आंखी पथरा जाहीं, अऊ तुमन कुछू नइं कर सकहू। <verse eid="DEU 28:32"/><verse number="33" style="v" sid="DEU 28:33"/>तुम्हर देस के ऊपज अऊ तुम्हर कमई ला ओ मनखेमन खा जाहीं, जेमन ला तुमन नइं जानव, अऊ जिनगी भर तुम्हर ऊपर कठोर अतियाचार के अलावा तुम्हर संग अऊ कुछू बने नइं होवय। <verse eid="DEU 28:33"/><verse number="34" style="v" sid="DEU 28:34"/>तुम्हर आघू म अइसन चीजमन होहीं, जेला देखके तुमन पगला जाहू। <verse eid="DEU 28:34"/><verse number="35" style="v" sid="DEU 28:35"/>यहोवा ह तुम्हर माड़ी अऊ गोड़मन ला पीरावाले घाव ले भर दीही, जऊन ह ठीक नइं होवय अऊ ये घावमन तुम्हर मुड़ ले लेके गोड़ तक भरे होहीं।<verse eid="DEU 28:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="DEU 28:36"/>यहोवा ह तुमन ला अऊ तुम्हर ठहिराय राजा ला एक अइसने जाति के मनखेमन करा भगा दीही, जेला न तो तुमन जानथव, अऊ न ही तुम्हर पुरखामन कभू जानिन। उहां तुमन लकड़ी अऊ पथरा के देवतामन के पूजा-उपासना करहू। <verse eid="DEU 28:36"/><verse number="37" style="v" sid="DEU 28:37"/>जिहां यहोवा ह तुमन ला भगा दीही, उहां तुमन ओ जम्मो मनखेमन के बीच भय, कहावत अऊ हंसी के बिसय बन जाहू।<verse eid="DEU 28:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="DEU 28:38"/>तुमन खेत म बहुंत अकन बीजा तो बोहू, पर थोरकन फसल ही लुए पाहू, काबरकि फांफामन ओला खा जाहीं। <verse eid="DEU 28:38"/><verse number="39" style="v" sid="DEU 28:39"/>तुमन अंगूर के बारी लगाके ओमा काम तो करहू, पर तुमन ओमा के न तो मंद पीये सकहू अऊ न ही ओमा के अंगूर इकट्ठा कर सकहू, काबरकि कीरामन ओमन ला खा जाहीं। <verse eid="DEU 28:39"/><verse number="40" style="v" sid="DEU 28:40"/>तुम्हर पूरा देस म जैतून के रूखमन तो होहीं, पर तुमन ओमन के तेल ला बउरे नइं सकहू, काबरकि जैतून के फरमन झरके गिर जाहीं। <verse eid="DEU 28:40"/><verse number="41" style="v" sid="DEU 28:41"/>तुम्हर बेटा अऊ बेटीमन तो होहीं, पर तुमन ओमन ला रख नइं सकहू, काबरकि ओमन बंधुवई म चल दीहीं। <verse eid="DEU 28:41"/><verse number="42" style="v" sid="DEU 28:42"/>तुम्हर जम्मो रूख अऊ तुम्हर देस के फसल ला फांफामन के झुंड ह खा जाही।<verse eid="DEU 28:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="DEU 28:43"/>जऊन परदेसीमन तुम्हर बीच रहिथें, ओमन तुम्हर ले बढ़त जाहीं, पर तुमन घटत अऊ घटत जाहू। <verse eid="DEU 28:43"/><verse number="44" style="v" sid="DEU 28:44"/>ओमन तुमन ला उधार दीहीं, पर तुमन ओमन ला उधार नइं दे सकहू। ओमन मुड़ी होहीं अऊ तुमन पुंछी।<verse eid="DEU 28:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="DEU 28:45"/>ये जम्मो सराप तुम्हर ऊपर लगही। ओमन तुम्हर पाछू पड़े रहिहीं अऊ तुमन ला पकड़ लीहीं, जब तक कि तुमन नास नइं हो जाहू, काबरकि तुमन यहोवा अपन परमेसर के बात नइं मानेव अऊ ओ हुकूम अऊ बिधिमन के पालन नइं करेव, जेला ओह तुमन ला दे रिहिस। <verse eid="DEU 28:45"/><verse number="46" style="v" sid="DEU 28:46"/>ओमन तुम्हर अऊ तुम्हर संतानमन बर हमेसा बर एक चिनहां अऊ अद्भूत काम होहीं। <verse eid="DEU 28:46"/><verse number="47" style="v" sid="DEU 28:47"/>काबरकि तुमन अपन उन्नति के बेरा यहोवा अपन परमेसर के सेवा खुसी अऊ आनंद से नइं करेव, <verse eid="DEU 28:47"/><verse number="48" style="v" sid="DEU 28:48"/>एकरसेति भूख अऊ पीयास म, नंगई अऊ भयंकर गरीबी म, तुमन ओ बईरीमन के सेवा करहू, जेमन ला यहोवा ह तुम्हर बिरूध पठोही। ओह तुम्हर घेंच म लोहा के जुड़ा तब तक डाले रखही,<note caller="+" style="f"><char style="fr" closed="false">28:48 </char><char style="ft" closed="false">बहुंत अतियाचार करही</char></note> जब तक कि ओह तुमन ला नास नइं कर दीही।<verse eid="DEU 28:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="DEU 28:49"/>यहोवा ह तुम्हर बिरूध बहुंत दूरिहा ले, धरती के छोर ले, चील के सहीं झपटनेवाला एक अइसन जाति ला लानही, जेकर भासा तुमन नइं समझहू; <verse eid="DEU 28:49"/><verse number="50" style="v" sid="DEU 28:50"/>येमन एक भयानक जाति के मनखे होहीं, जेमन के मन म सियानमन बर न तो कोनो आदर होही, न ही लइकामन बर कोनो किसम के दया। <verse eid="DEU 28:50"/><verse number="51" style="v" sid="DEU 28:51"/>ओमन तुम्हर पसुमन के पीला अऊ तुम्हर देस के फसल ला तब तक खाते रहिहीं, जब तक कि तुमन नास नइं हो जावव। ओमन तुम्हर बर न तो कोनो अनाज अऊ नवां अंगूर के मंद अऊ न जैतून के तेल ला छोंड़हीं, अऊ न ही तुम्हर गाय-बईला या भेड़-बकरी के कोनो बछरू या मेढ़ा-पीला ला छोंड़हीं, जेकर ले तुमन नास हो जाहू। <verse eid="DEU 28:51"/><verse number="52" style="v" sid="DEU 28:52"/>ओमन तुम्हर पूरा देस म जम्मो सहरमन ला तब तक घेरे रहिहीं, जब तक कि ओ गढ़वाले ऊंच दीवारमन गिर नइं जाहीं, जेमन के ऊपर तुमन भरोसा करथव। ओमन पूरा देस म ओ जम्मो सहर ला घेर लीहीं, जेमन ला यहोवा तुम्हर परमेसर ह तुमन ला देवत हे।<verse eid="DEU 28:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="DEU 28:53"/>ओ घेराबंदी के बेरा, जऊन दुख-तकलीफ तुम्हर बईरीमन तुमन ला दीहीं, ओकर कारन तुमन अपन जनमाय ओ बेटा-बेटीमन के मांस ला खाहू, जेमन ला यहोवा तुम्हर परमेसर ह तुमन ला दे हवय। <verse eid="DEU 28:53"/><verse number="54" style="v" sid="DEU 28:54"/>अऊ त अऊ, तुम्हर बीच के सबले जादा दयालु अऊ नम्र मनखे घलो अपन खुद के भाई या अपन मयारू घरवाली या अपन बांचे लइकामन ऊपर कोनो दया नइं करही, <verse eid="DEU 28:54"/><verse number="55" style="v" sid="DEU 28:55"/>अऊ ओह अपन लइकामन के ओ मांस कोनो ला नइं दीही, जेला ओह खावत होही। तुम्हर जम्मो सहरमन के घेराबंदी के बेरा, तुम्हर बईरीमन तुमन ला जऊन दुख-तकलीफ दीहीं, ओकर कारन सिरिप येहीच मांस ह ओकर करा बांचे रहिही। <verse eid="DEU 28:55"/><verse number="56" style="v" sid="DEU 28:56"/>तुम्हर बीच के सबले जादा दयालु अऊ नम्र माईलोगन—अतेक दयालु अऊ नम्र कि ओह अपन पांव ले भुइयां ला छुए के हिम्मत घलो नइं करय, पर ओह घलो अपन मयारू घरवाला अऊ अपन गरभ ले जनमाय खुद के बेटा-बेटी <verse eid="DEU 28:56"/><verse number="57" style="v" sid="DEU 28:57"/>अऊ अपन गरभ म धरे लइकामन ऊपर दया नइं देखाही। तुम्हर सहरमन के घेराबंदी के बेरा, तुम्हर बईरीमन तुमन ला जऊन दुख-तकलीफ दीहीं, ओकर कारन ओह अपन लइकामन के मांस ला छुप-छुपके खाय के लालसा करही।<verse eid="DEU 28:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="DEU 28:58"/>यदि तुमन ये कानून के जम्मो बात ला धियान देके नइं मानहू, जऊन ह ये किताब म लिखे हवय, अऊ ये महान अऊ अद्भूत नांव—यहोवा तुम्हर परमेसर—के आदर नइं करहू, <verse eid="DEU 28:58"/><verse number="59" style="v" sid="DEU 28:59"/>त यहोवा ह तुम्हर अऊ तुम्हर संतानमन ऊपर भयंकर महामारी, कठोर अऊ लम्बा समय तक रहनेवाला बिपत्ति अऊ बहुंत समय तक रहनेवाला बेमारी लानही। <verse eid="DEU 28:59"/><verse number="60" style="v" sid="DEU 28:60"/>ओह तुमन ऊपर मिसर देस के ओ जम्मो बेमारी ले आही, जेमन ले तुमन डरत रहेव, अऊ ओ बेमारीमन तुमन ला नइं छोंड़हीं। <verse eid="DEU 28:60"/><verse number="61" style="v" sid="DEU 28:61"/>यहोवा ह तुम्हर ऊपर ओ जम्मो किसम के रोग अऊ बिपत्ति ला घलो लानही, जेमन के बरनन कानून के ये किताब म नइं करे गे हवय, ताकि तुमन नास हो जावव। <verse eid="DEU 28:61"/><verse number="62" style="v" sid="DEU 28:62"/>तुमन के संखिया बहुंत कम हो जाही, जबकि एक समय तुम्हर संखिया अकास के तारामन सहीं अनगिनत रिहिस; ये सब येकर कारन होही, काबरकि तुमन यहोवा अपन परमेसर के बात नइं मानेव। <verse eid="DEU 28:62"/><verse number="63" style="v" sid="DEU 28:63"/>जइसे कि यहोवा ला तुम्हर उन्नति करके अऊ तुम्हर संखिया ला बढ़ाके खुसी मिले रिहिस, वइसे ही तुमन ला नास करके अऊ मिटाके ओला खुसी मिलही। तुमन ला ओ देस ले निकाल दिये जाही, जेकर ऊपर तुमन अधिकार करे बर जावत हव।<verse eid="DEU 28:63"/></para>
  <para style="p">
    <verse number="64" style="v" sid="DEU 28:64"/>तब यहोवा ह तुमन ला धरती के एक छोर ले लेके आने छोर तक जम्मो जाति के मनखेमन के बीच तितिर-बितिर कर दीही। उहां तुमन आने देवतामन के अराधना करहू—लकड़ी अऊ पथरा के देवतामन, जेमन ला न तो तुमन अऊ न ही तुम्हर पुरखामन कभू जानिन। <verse eid="DEU 28:64"/><verse number="65" style="v" sid="DEU 28:65"/>ओ जातिमन के बीच म तुमन ला लेटे बर या अपन पांव धरे बर जगह नइं मिलही। उहां यहोवा ह तुमन ला एक चिंतित मन, लालसा करत थके आंखी अऊ एक निरास हिरदय दीही। <verse eid="DEU 28:65"/><verse number="66" style="v" sid="DEU 28:66"/>तुमन लगातार असमंजस के स्थिति म, दिन अऊ रात डर म भरे रहिहू, अऊ तुमन ला अपन जिनगी के कभू भरोसा नइं होही। <verse eid="DEU 28:66"/><verse number="67" style="v" sid="DEU 28:67"/>जऊन आतंक तुम्हर मन म भरे होही अऊ जऊन चीजमन ला तुम्हर आंखी ह देखही, ओकर कारन तुमन बिहनियां के बेरा कहिहू, “कास येह सांझ होतिस!” अऊ सांझ के बेरा कहिहू, “कास येह बिहनियां होतिस!” <verse eid="DEU 28:67"/><verse number="68" style="v" sid="DEU 28:68"/>यहोवा ह तुमन ला पानी जहाज म बईठाके वापिस मिसर देस पठो दीही, जेकर बारे म मेंह कहे रहेंव तुमन येला फेर कभू नइं देखहू। उहां तुमन अपनआप ला दे दूहू कि तुम्हर बईरीमन तुमन ला नर अऊ नारी गुलाम के रूप म बिसावंय, पर तुमन ला कोनो नइं बिसाहीं।<verse eid="DEU 28:68"/></para>
  <chapter eid="DEU 28"/>
  <chapter number="29" style="c" sid="DEU 29"/>
  <para style="s1">करार के नवीनीकरन</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 29:1"/>यहोवा ह होरेब पहाड़<note caller="+" style="f"><char style="fr" closed="false">29:1 </char><char style="fq" closed="false">होरेब पहाड़ </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सीनय पहाड़</char></note> ऊपर जऊन करार इसरायलीमन ले करे रिहिस, ओकर अलावा यहोवा ह मूसा ला जऊन करार इसरायलीमन के संग करे के हुकूम मोआब देस म दीस, ओकर बचन ये अंय।<verse eid="DEU 29:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="DEU 29:2"/>मूसा ह जम्मो इसरायलीमन ला बलाके कहिस:</para>
  <para style="b" vid="DEU 29:2"/>
  <para style="p" vid="DEU 29:2">यहोवा ह मिसर देस म फिरौन, ओकर जम्मो करमचारी अऊ ओकर पूरा देस के संग जऊन कुछू करिस, ओ जम्मो ला तुमन अपन आंखी ले देखे हव। <verse eid="DEU 29:2"/><verse number="3" style="v" sid="DEU 29:3"/>अपन खुद के आंखी ले तुमन ओ बड़े बिपत्ति, ओ चिनहां अऊ बड़े अद्भूत काममन ला देखे हव। <verse eid="DEU 29:3"/><verse number="4" style="v" sid="DEU 29:4"/>पर आज तक यहोवा ह तुमन ला अइसे मन नइं दे हवय, जऊन ह समझथे या अइसे आंखी नइं दे हवय, जऊन ह देखथे या अइसे कान नइं दे हवय, जऊन ह सुनथे। <verse eid="DEU 29:4"/><verse number="5" style="v" sid="DEU 29:5"/>तभो ले यहोवा ह कहिथे, “चालीस साल तक मेंह निरजन प्रदेस म तुम्हर अगुवई करेंव, पर न तो तुम्हर कपड़ा फटिस, अऊ न ही तुम्हर पांव के जूता। <verse eid="DEU 29:5"/><verse number="6" style="v" sid="DEU 29:6"/>तुमन ला खाय बर रोटी नइं मिलिस अऊ पीये बर अंगूर के मंद या आने मंद नइं मिलिस। मेंह ये सब करेंव, ताकि तुमन जानव कि मेंह यहोवा तुम्हर परमेसर अंव।”<verse eid="DEU 29:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 29:7"/>जब तुमन ये जगह म हबरेव, त हेसबोन के राजा सीहोन अऊ बासान के राजा ओग हमर बिरूध लड़े बर निकलके आईन, पर हमन ओमन ला हरा देंन। <verse eid="DEU 29:7"/><verse number="8" style="v" sid="DEU 29:8"/>हमन ओमन के देस ऊपर कब्जा कर लेंन अऊ ओ देस ला रूबेनी, गादी अऊ मनस्सेयीमन के आधा गोत्र ला ओमन के उत्तराधिकार के रूप म दे देंन।<verse eid="DEU 29:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 29:9"/>धियान देके ये करार के बचन के पालन करव, ताकि जऊन कुछू तुमन करव, ओमा तुम्हर उन्नति होवय। <verse eid="DEU 29:9"/><verse number="10" style="v" sid="DEU 29:10"/>तुमन जम्मो झन आज यहोवा अपन परमेसर के आघू म खड़े हवव—तुम्हर अगुवा अऊ मुखिया मनखेमन, तुम्हर सियान अऊ करमचारीमन, अऊ इसरायल के आने जम्मो मनखेमन, <verse eid="DEU 29:10"/><verse number="11" style="v" sid="DEU 29:11"/>संग म तुम्हर लइकामन अऊ तुम्हर घरवालीमन, अऊ तुम्हर सिविर म रहइया ओ परदेसीमन घलो हवंय, जेमन तुम्हर बर लकरी काटथें अऊ तुम्हर बर पानी भरथें। <verse eid="DEU 29:11"/><verse number="12" style="v" sid="DEU 29:12"/>तुमन इहां एकरसेति खड़े हव, ताकि यहोवा तुम्हर परमेसर के संग तुम्हर करार होवय, ओ करार जेला यहोवा ह आज तुम्हर संग करत हे अऊ सपथ खाके मुहर लगात हे, <verse eid="DEU 29:12"/><verse number="13" style="v" sid="DEU 29:13"/>आज ओह तुमन ला अपन मनखे के रूप म पुस्टि करत हे, अऊ ये घलो कि ओह तुम्हर परमेसर होवय, जइसे कि ओह तुम्हर ले वायदा करिस अऊ तुम्हर पुरखा, अब्राहम, इसहाक अऊ याकूब ले कसम खाय रिहिस। <verse eid="DEU 29:13"/><verse number="14" style="v" sid="DEU 29:14"/>मेंह ये करार सपथ खाके सिरिप तुम्हर संग ही नइं करत हंव, <verse eid="DEU 29:14"/><verse number="15" style="v" sid="DEU 29:15"/>जेमन आज इहां हमर संग यहोवा हमर परमेसर के आघू म खड़े हव पर ओमन संग घलो करत हंव, जेमन आज इहां नइं अंय।<verse eid="DEU 29:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 29:16"/>तुमन खुद जानत हव कि हमन मिसर देस म कइसे रहत रहेंन अऊ कइसे हमन देसमन ले होवत इहां तक हबरेंन। <verse eid="DEU 29:16"/><verse number="17" style="v" sid="DEU 29:17"/>तुमन ओमन के बीच लकरी अऊ पथरा, सोन अऊ चांदी के बने घिनौना चीज अऊ मूरतीमन ला देखे हव। <verse eid="DEU 29:17"/><verse number="18" style="v" sid="DEU 29:18"/>ये बात के निस्चय करव कि तुम्हर बीच आज अइसने कोनो आदमी या माईलोगन, कुल या गोत्र झन होवय, जेकर मन ह यहोवा हमर परमेसर ले हट जावय अऊ जाके ओ जातिमन के देवता के अराधना करय; ये बात के निस्चय करव कि तुम्हर बीच म कोनो जरी झन रहय, जऊन ह अइसने करू जहर पईदा करय।<verse eid="DEU 29:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 29:19"/>जब अइसने कोनो मनखे ये सपथ के बचन ला सुनथे अऊ अपनआप ला ये सोचके आसीस देथे, “मेंह तो अपन खुद के रसता म चलहूं, तभो ले मेंह सुरकछित रहिहूं,” त ओ मनखे ह सिंचईवाले भुइयां के संगे-संग सूखा भुइयां म घलो बिपत्ति लानही। <verse eid="DEU 29:19"/><verse number="20" style="v" sid="DEU 29:20"/>यहोवा कभू ओकर पाप छेमा नइं करही; ओकर कोप अऊ जलन ओ मनखे के ऊपर भड़कही। ये किताब म लिखे जम्मो सराप ओकर ऊपर पड़ही, अऊ यहोवा ह धरती ले ओकर नांव मिटा दीही। <verse eid="DEU 29:20"/><verse number="21" style="v" sid="DEU 29:21"/>कानून के ये किताब म लिखे करार के ओ जम्मो सरापमन के मुताबिक, यहोवा ह इसरायल के जम्मो गोत्र म ले ओला अलग करके ओकर ऊपर बिपत्ति लानही।<verse eid="DEU 29:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 29:22"/>अवइया पीढ़ी म, तुम्हर जऊन लइकामन होहीं, ओमन अऊ दूरिहा देस ले आय परदेसीमन ओ देस ऊपर पड़नेवाला ओ बिपत्ति अऊ बेमारीमन ला देखहीं, जेला यहोवा ह ओमन ऊपर लानही। <verse eid="DEU 29:22"/><verse number="23" style="v" sid="DEU 29:23"/>पूरा देस ह जलके नून अऊ गंधक के कचरा हो जाही—उहां न तो कुछू बोए जाही, न ही उहां कुछू जामही अऊ न ही उहां कुछू घांस-पूस या रूख-रई होही। येह सदोम अऊ अमोरा, अदमा अऊ सबोईम सहरमन के बिनास सहीं होही, जेला यहोवा ह अपन भयंकर कोरोध म नास कर दे रिहिस।<note caller="+" style="f"><char style="fr" closed="false">29:23 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="GEN 19:24-25">उत 19:24‑25</ref></char></char></note> <verse eid="DEU 29:23"/><verse number="24" style="v" sid="DEU 29:24"/>जम्मो जाति के मनखेमन पुछहीं: “यहोवा ह ये देस के संग अइसे काबर करिस? काबर ओकर भयंकर कोरोध ह भड़किस?”<verse eid="DEU 29:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 29:25"/>त ओकर जबाब ये होही: “काबरकि ये मनखेमन यहोवा अपन पुरखामन के परमेसर के ओ करार ला टोर दे हवंय, जेला ओह ओमन के संग तब करे रिहिस, जब ओह ओमन ला मिसर देस ले बाहिर निकालके लाने रिहिस। <verse eid="DEU 29:25"/><verse number="26" style="v" sid="DEU 29:26"/>ओमन भटकके आने देवतामन के अराधना करिन अऊ ओमन ला दंडवत करिन, अइसन देवता जेला ओमन नइं जानत रिहिन अऊ जेला परमेसर ह ओमन ला नइं दे रिहिस। <verse eid="DEU 29:26"/><verse number="27" style="v" sid="DEU 29:27"/>एकरसेति यहोवा के कोरोध ये देस के बिरूध भड़किस, अऊ ओह ये किताब म लिखे जम्मो सराप येमन ऊपर लानिस। <verse eid="DEU 29:27"/><verse number="28" style="v" sid="DEU 29:28"/>यहोवा ह बड़े कोरोध अऊ भयंकर कोप म आके ओमन ला ओमन के देस ले उखानके आने देस म फटिक दीस, जइसे कि अब दिखत हे।”<verse eid="DEU 29:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="DEU 29:29"/>गुपत के चीजमन यहोवा हमर परमेसर के अंय, पर जऊन चीजमन परगट हो गे हवंय, ओमन सदाकाल बर हमर अऊ हमर लइकामन के अंय, ताकि हमन ये कानून के जम्मो बचन के पालन करन।<verse eid="DEU 29:29"/></para>
  <chapter eid="DEU 29"/>
  <chapter number="30" style="c" sid="DEU 30"/>
  <para style="s1">यहोवा कोति लहुंटे के बाद उन्नति</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 30:1"/>जब ये जम्मो आसीस अऊ सराप तुम्हर ऊपर आवंय, जेमन के चरचा मेंह तुम्हर आघू म करे हवंव, अऊ तुमन येमन ला ओ जातिमन के बीच म रहिके सुरता करव, जिहां यहोवा तुम्हर परमेसर ह तुमन ला बगरा दीही, <verse eid="DEU 30:1"/><verse number="2" style="v" sid="DEU 30:2"/>अऊ जब तुमन अऊ तुम्हर लइकामन यहोवा तुम्हर परमेसर करा लहुंटव अऊ अपन पूरा मन अऊ अपन पूरा परान से ओ जम्मो बात के पालन करव, जेकर हुकूम मेंह आज तुमन ला देवत हंव, <verse eid="DEU 30:2"/><verse number="3" style="v" sid="DEU 30:3"/>तब यहोवा तुम्हर परमेसर ह तुमन ला पहिले सहीं कर दीही<note caller="+" style="f"><char style="fr" closed="false">30:3 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">बंधुवई ले वापिस ले आही</char></note> अऊ तुम्हर ऊपर दया करही अऊ तुमन ला ओ जम्मो जाति के मनखेमन के बीच ले इकट्ठा करही, जिहां ओह तुमन ला तितिर-बितिर कर दे रिहिस। <verse eid="DEU 30:3"/><verse number="4" style="v" sid="DEU 30:4"/>अऊ त अऊ यदि तुमन धरती के बहुंत दूरिहा देस म घलो पड़े होहू, त उहां ले घलो यहोवा तुम्हर परमेसर ह तुमन ला इकट्ठा करही अऊ वापिस ले आही। <verse eid="DEU 30:4"/><verse number="5" style="v" sid="DEU 30:5"/>ओह तुमन ला ओ देस म ले आही, जऊन ह तुम्हर पुरखामन के रिहिस, अऊ तुमन ओकर ऊपर अधिकार कर लूहू। ओह तुमन ला तुम्हर पुरखामन ले घलो जादा सम्पन्न करही अऊ तुम्हर संखिया ला ओमन ले जादा बढ़ाही। <verse eid="DEU 30:5"/><verse number="6" style="v" sid="DEU 30:6"/>यहोवा तुम्हर परमेसर ह तुम्हर अऊ तुम्हर संतानमन के हिरदय<note caller="+" style="f"><char style="fr" closed="false">30:6 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">मन</char></note> के खतना करही, ताकि तुमन ओकर ले अपन पूरा हिरदय अऊ अपन पूरा परान ले मया करव अऊ जीयत रहव। <verse eid="DEU 30:6"/><verse number="7" style="v" sid="DEU 30:7"/>यहोवा तुम्हर परमेसर ह ये जम्मो सराप ला तुम्हर बईरीमन ऊपर डाल दीही, जेमन तुम्हर ले घिन करथें अऊ तुम्हर ऊपर अतियाचार करथें। <verse eid="DEU 30:7"/><verse number="8" style="v" sid="DEU 30:8"/>तुमन फेर यहोवा के बात मानहू अऊ ओकर जम्मो हुकूम के पालन करहू, जेला मेंह आज तुमन ला देवत हंव। <verse eid="DEU 30:8"/><verse number="9" style="v" sid="DEU 30:9"/>तब यहोवा तुम्हर परमेसर ह तुम्हर जम्मो काम म तुम्हर उन्नति करही अऊ तुम्हर संतान, तुम्हर पसुमन के पीला अऊ तुम्हर भुइयां के फसल ला बहुंत कर दीही। यहोवा ह फेर तुम्हर ले खुस होही अऊ तुमन ला धनवान बना दीही, जइसे ओह तुम्हर पुरखामन ले खुस रिहिस, <verse eid="DEU 30:9"/><verse number="10" style="v" sid="DEU 30:10"/>यदि तुमन यहोवा तुम्हर परमेसर के बात मानहू अऊ कानून के ये किताब म लिखे ओकर हुकूम अऊ बिधिमन के पालन करहू अऊ अपन पूरा मन अऊ अपन पूरा परान से यहोवा तुम्हर परमेसर करा लहुंटहू।<verse eid="DEU 30:10"/></para>
  <para style="s1">जिनगी या मिरतू के प्रस्ताव</para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 30:11"/>देखव, मेंह आज तुमन ला जऊन हुकूम देवत हंव, ओह तुम्हर बर जादा कठिन नो हय अऊ न ही तुम्हर पहुंच के बाहिर अय। <verse eid="DEU 30:11"/><verse number="12" style="v" sid="DEU 30:12"/>येह ऊपर अकास म नइं ए कि तुमन ला ये कहना पड़य, “कोन ह अकास ऊपर जाके येला लानही अऊ हमन ला पढ़के सुनाही कि हमन येकर पालन करन?” <verse eid="DEU 30:12"/><verse number="13" style="v" sid="DEU 30:13"/>न ही येह समुंदर के ओ पार हवय कि तुमन ला ये कहना पड़य, “कोन ह समुंदर के ओ पार जाके येला लानही अऊ हमन ला पढ़के सुनाही कि हमन येकर पालन करन?” <verse eid="DEU 30:13"/><verse number="14" style="v" sid="DEU 30:14"/>नइं, ये बचन ह तुम्हर बहुंत लकठा म हवय; येह तुम्हर मुहूं म अऊ तुम्हर मन म हवय कि तुमन येकर पालन करव।<verse eid="DEU 30:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 30:15"/>देखव, मेंह आज तुम्हर आघू म जिनगी अऊ सम्पन्नता, मिरतू अऊ बिनास के बात ला रखे हंव। <verse eid="DEU 30:15"/><verse number="16" style="v" sid="DEU 30:16"/>काबरकि मेंह आज तुमन ला हुकूम देवत हंव कि तुमन यहोवा अपन परमेसर ले मया करव, ओकर बात म चलव, अऊ ओकर हुकूम, बिधि अऊ कानूनमन के पालन करव; तब तुमन जीयत रहिहू अऊ गनती म बढ़हू, अऊ यहोवा तुम्हर परमेसर ह तुमन ला ओ देस म आसीस दीही, जेकर ऊपर अधिकार करे बर तुमन जावत हव।<verse eid="DEU 30:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 30:17"/>पर यदि तुम्हर मन ह परमेसर ले हट जाय अऊ तुमन ओकर हुकूममन ला नइं मानव, अऊ यदि तुमन दूरिहा हटके आने देवतामन के दंडवत करव अऊ ओमन के अराधना करव, <verse eid="DEU 30:17"/><verse number="18" style="v" sid="DEU 30:18"/>त मेंह आज तुम्हर आघू म घोसना करत हंव कि खचित तुमन नास हो जाहू। अऊ तुमन जऊन देस ऊपर अधिकार करे बर यरदन नदी के ओ पार जावत हव, ओ देस म जादा समय तक रह नइं सकहू।<verse eid="DEU 30:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 30:19"/>आज मेंह अकास अऊ धरती ला तुम्हर बिरूध गवाह बनात हंव कि मेंह जिनगी अऊ मिरतू, परमेसर के आसीस अऊ सरापमन ला तुम्हर आघू म रखे हंव। एकरसेति तुमन जिनगी ला चुनव, ताकि तुमन अऊ तुम्हर लइकामन जीयत रहव <verse eid="DEU 30:19"/><verse number="20" style="v" sid="DEU 30:20"/>अऊ तुमन यहोवा अपन परमेसर ले मया करव, ओकर अवाज ला सुनव, अऊ मजबूती से ओला धरे रहव। काबरकि यहोवा ह तुम्हर जिनगी अय, अऊ ओह तुमन ला ओ देस म बहुंत साल तक रहे बर दीही, जेला देय बर ओह तुम्हर पुरखा, अब्राहम, इसहाक अऊ याकूब ले सपथ खाय रिहिस।<verse eid="DEU 30:20"/></para>
  <chapter eid="DEU 30"/>
  <chapter number="31" style="c" sid="DEU 31"/>
  <para style="s1">यहोसू ह मूसा के जगह लेथे</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 31:1"/>तब मूसा ह बाहिर निकलिस अऊ जम्मो इसरायल ले ये कहिस: <verse eid="DEU 31:1"/><verse number="2" style="v" sid="DEU 31:2"/>“अब मेंह एक सौ बीस साल के हो गे हंव अऊ अब मोर म तुम्हर अगुवई करे के सक्ति नइं ए। यहोवा ह मोला कहे हवय, ‘तें यरदन नदी के ओ पार नइं जा सकस।’ <verse eid="DEU 31:2"/><verse number="3" style="v" sid="DEU 31:3"/>यहोवा तुम्हर परमेसर ह खुद तुम्हर आघू ओ पार जाही। ओह उहां के मनखेमन ला तुम्हर आघू ले नास कर दीही, अऊ तुमन ओमन के देस ऊपर अधिकार कर लूहू। यहोसू घलो तुम्हर ले आघू ओ पार जाही, जइसे कि यहोवा ह कहे हवय। <verse eid="DEU 31:3"/><verse number="4" style="v" sid="DEU 31:4"/>अऊ यहोवा ह उहां के मनखेमन के संग वइसे ही करही, जइसे ओह अमोरीमन के राजा सीहोन अऊ ओग के संग करे रिहिस, जेमन ला ओह ओमन के देस के संग नास कर दे रिहिस। <verse eid="DEU 31:4"/><verse number="5" style="v" sid="DEU 31:5"/>यहोवा ह ओमन ला तुम्हर अधीन कर दीही, अऊ तुमन ओमन के संग वइसे ही करहू, जइसे कि मेंह तुमन ला हुकूम दे हवंव। <verse eid="DEU 31:5"/><verse number="6" style="v" sid="DEU 31:6"/>मजबूत अऊ साहसी बनव। ओमन ले झन डरव या भयभीत झन होवव, काबरकि यहोवा तुम्हर परमेसर ह तुम्हर संग जाथे; ओह तुमन ला न तो कभू छोंड़ही अऊ न ही तियागही।”<verse eid="DEU 31:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 31:7"/>तब मूसा ह यहोसू ला बुलवाईस अऊ जम्मो इसरायल के आघू म ओला कहिस, “मजबूत अऊ साहसी बन, काबरकि तें ये मनखेमन के संग ओ देस म जाबे, जेला येमन के पुरखामन ला देय बर यहोवा ह सपथ खाय रिहिस, अऊ तेंह ओ देस ला येमन के बीच येमन के उत्तराधिकार के रूप म बांटबे। <verse eid="DEU 31:7"/><verse number="8" style="v" sid="DEU 31:8"/>यहोवा ह खुद तोर आघू-आघू जावत हे अऊ ओह तोर संग रहिही; ओह न तो तोला कभू छोंड़ही अऊ न ही तियागही। एकरसेति झन डर अऊ झन घबरा।”<verse eid="DEU 31:8"/></para>
  <para style="s1">सार्वजनिक रूप म कानून के पठन</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 31:9"/>मूसा ह ये कानून ला लिखिस अऊ येला यहोवा के करार के सन्दूक उठानेवाला लेवीय पुरोहितमन ला अऊ इसरायल के जम्मो अगुवामन ला दे दीस। <verse eid="DEU 31:9"/><verse number="10" style="v" sid="DEU 31:10"/>तब मूसा ह ओमन ला हुकूम दीस: “हर सात साल के आखिरी म, करजा माफी करे के साल, पबितर-तम्बूमन के तिहार के बेरा, <verse eid="DEU 31:10"/><verse number="11" style="v" sid="DEU 31:11"/>जब जम्मो इसरायलीमन यहोवा तुम्हर परमेसर के आघू म ओ जगह म इकट्ठा होथें, जेला ओह चुनही, तब तुमन ये कानून ओमन के आघू म पढ़के सुनाहू। <verse eid="DEU 31:11"/><verse number="12" style="v" sid="DEU 31:12"/>मनखेमन ला इकट्ठा करव—आदमी, माईलोगन अऊ लइकामन, अऊ तुम्हर नगरमन म रहइया परदेसी, ओ जम्मो झन ला—ताकि ओमन ये कानून ला सुनंय अऊ यहोवा तुम्हर परमेसर के भय मानना सीखंय अऊ धियान देके ये कानून के हर बात के पालन करंय। <verse eid="DEU 31:12"/><verse number="13" style="v" sid="DEU 31:13"/>ओमन के लइकामन, जेमन ये कानून ला नइं जानंय, ओमन घलो येला सुनंय अऊ यहोवा तुम्हर परमेसर के भय मानना सीखंय, जब तक कि तुमन ओ देस म जीयत हव, जेकर ऊपर अधिकार करे बर तुमन यरदन नदी के ओ पार जावत हव।”<verse eid="DEU 31:13"/></para>
  <para style="s1">इसरायल के बिदरोह करे के बारे म अगमबानी</para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 31:14"/>यहोवा ह मूसा ला कहिस, “तोर मिरतू के दिन ह लकठा म हवय। यहोसू ला बला अऊ तुमन दूनों मिलापवाला तम्बू करा हाजिर होवव, जिहां मेंह ओला अधिकार दूहूं।” तब मूसा अऊ यहोसू मिलापवाला तम्बू करा जाके हाजिर होईन।<verse eid="DEU 31:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 31:15"/>तब यहोवा ह बादर के एक खंभा म परगट होईस, अऊ बादर के खंभा ह तम्बू के प्रवेस दुवार के ऊपर ठहर गीस। <verse eid="DEU 31:15"/><verse number="16" style="v" sid="DEU 31:16"/>अऊ यहोवा ह मूसा ला कहिस: “तेंह मरके अपन पुरखामन के संग मिल जानेवाला हस, अऊ ये मनखेमन ओ देस जिहां ओमन जावत हें, उहां जल्दी ही पराय देवतामन के पाछू जाके बेभिचारी हो जाहीं।<note caller="+" style="f"><char style="fr" closed="false">31:16 </char><char style="ft" closed="false">मोर संग बिसवासघात करहीं</char></note> ओमन मोला तियाग दीहीं अऊ जऊन करार मेंह ओमन के संग करे हवंव, ओला टोर दीहीं। <verse eid="DEU 31:16"/><verse number="17" style="v" sid="DEU 31:17"/>तब ओ दिन मेंह ओमन ऊपर गुस्सा करहूं अऊ ओमन ला तियाग दूहूं; मेंह ओमन ले अपन मुहूं मोड़ लूहूं, अऊ ओमन नास हो जाहीं। ओमन ऊपर बहुंत बिपत्ति अऊ संकट आही, अऊ ओ दिन ओमन कहिहीं, ‘का ये बिपत्तिमन हमर ऊपर येकर कारन तो नइं आय हवंय, काबरकि हमर परमेसर ह हमर संग नइं ए?’ <verse eid="DEU 31:17"/><verse number="18" style="v" sid="DEU 31:18"/>ओ समय ओमन आने देवतामन कोति जाके जऊन जम्मो बुरई के काम करहीं, ओकर कारन खचित मेंह अपन मुहूं मोड़ लूहूं।<verse eid="DEU 31:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 31:19"/>“एकरसेति अब ये गीत ला लिख ले अऊ येला इसरायलीमन ला सिखा दे, ताकि येह ओमन के बिरूध मोर गवाह ठहिरय। <verse eid="DEU 31:19"/><verse number="20" style="v" sid="DEU 31:20"/>जब मेंह ओमन ला ओ देस म ले आहूं, जिहां दूध अऊ मंधरस बहुंतायत म मिलथे, ओ देस जेला देय के मेंह ओमन के पुरखामन ले सपथ खाय रहेंव, अऊ जब ओमन ला भरपेट खाय बर मिलही अऊ ओमन उन्नति करहीं, तब ओमन मोर करार ला टोरके मोला अस्वीकार करहीं अऊ आने देवतामन कोति जाके ओमन के अराधना करहीं। <verse eid="DEU 31:20"/><verse number="21" style="v" sid="DEU 31:21"/>अऊ जब बहुंत बिपत्ति अऊ संकट ओमन ऊपर आही, तब ये गीत ह ओमन के बिरूध गवाही दीही, काबरकि ये गीत ला ओमन के संतानमन नइं भुलाय होहीं। मेंह जानत हंव कि ओमन का करे के ठाने हवंय, हालाकि मेंह ओमन ला अभी ओ देस म नइं लाने हंव, जेकर वायदा मेंह ओमन ले करे हवंव।” <verse eid="DEU 31:21"/><verse number="22" style="v" sid="DEU 31:22"/>तब मूसा ह ओ दिन ये गीत ला लिख लीस अऊ येला इसरायलीमन ला सिखाईस।<verse eid="DEU 31:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 31:23"/>तब यहोवा ह नून के बेटा यहोसू ला ये हुकूम दीस: “मजबूत अऊ साहसी बन, काबरकि तेंह इसरायलीमन ला ओ देस म लेके जाबे, जेकर वायदा मेंह ओमन ले करे हवंव, अऊ मेंह खुद तोर संग रहिहूं।”<verse eid="DEU 31:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="DEU 31:24"/>जब मूसा ह कानून के ये बचन ला सुरू ले लेके आखिरी तक एक किताब म लिख लीस, <verse eid="DEU 31:24"/><verse number="25" style="v" sid="DEU 31:25"/>त ओह ओ लेवीमन ला ये हुकूम दीस, जेमन यहोवा के करार के सन्दूक ला उठाके चलंय: <verse eid="DEU 31:25"/><verse number="26" style="v" sid="DEU 31:26"/>“कानून के ये किताब ला लव अऊ यहोवा अपन परमेसर के करार के सन्दूक के बाजू म रख दव। उहां येह तुम्हर बिरूध एक गवाह के रूप म रहय। <verse eid="DEU 31:26"/><verse number="27" style="v" sid="DEU 31:27"/>काबरकि मेंह जानत हंव कि तुमन कतेक बिदरोही अऊ ढीठ सुभाव के अव। जब मेंह अभी जीयत हंव अऊ तुम्हर संग हवंव, तब तुमन यहोवा के बिरूध बिदरोह करे हव, त फेर मोर मरे के बाद तुमन कतेक जादा बिदरोह करहू! <verse eid="DEU 31:27"/><verse number="28" style="v" sid="DEU 31:28"/>अपन-अपन गोत्र के जम्मो अगुवा अऊ जम्मो करमचारीमन ला मोर करा इकट्ठा करव, ताकि मेंह ये बचन ओमन ला सुनावंव अऊ अकास अऊ धरती ला ओमन के बिरूध गवाह बनावंव। <verse eid="DEU 31:28"/><verse number="29" style="v" sid="DEU 31:29"/>काबरकि मेंह जानत हंव कि मोर मरे के बाद तुमन एकदम बिगड़ जाहू अऊ ओ रसता ले हट जाहू, जेकर हुकूम मेंह तुमन ला दे हवंव। अवइया दिन म, तुम्हर ऊपर बिपत्ति आही, काबरकि तुमन यहोवा के नजर म दुस्ट काम करहू अऊ अपन हांथ ले करे गय काम के दुवारा तुमन ओकर कोरोध ला भड़काहू।”<verse eid="DEU 31:29"/></para>
  <para style="s1">मूसा के गीत</para>
  <para style="p">
    <verse number="30" style="v" sid="DEU 31:30"/>तब मूसा ह इसरायल के जम्मो सभा ला सुरू ले लेके आखिरी तक ये गीत के बचन ला पढ़के सुना दीस:<verse eid="DEU 31:30"/></para>
  <chapter eid="DEU 31"/>
  <chapter number="32" style="c" sid="DEU 32"/>
  <para style="q1">
    <verse number="1" style="v" sid="DEU 32:1"/>हे अकास, तेंह सुन अऊ मेंह गोठियाहूं;</para>
  <para style="q2" vid="DEU 32:1">हे धरती, तेंह मोर मुहूं के बातमन ला सुन।<verse eid="DEU 32:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="DEU 32:2"/>मोर सिकछा ह बारिस के सहीं गिरय</para>
  <para style="q2" vid="DEU 32:2">अऊ मोर बचन ह ओस के सहीं पड़य,</para>
  <para style="q1" vid="DEU 32:2">नवां कांदी ऊपर पानी के बौछार सहीं,</para>
  <para style="q2" vid="DEU 32:2">अऊ कोमल पऊधामन ऊपर बारिस के झड़ी सहीं गिरय।<verse eid="DEU 32:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="DEU 32:3"/>मेंह यहोवा के नांव के घोसना करहूं।</para>
  <para style="q2" vid="DEU 32:3">जम्मो मनखेमन हमर परमेसर के महानता के परसंसा करव!<verse eid="DEU 32:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="DEU 32:4"/>ओह चट्टान अय, ओकर काममन एकदम सही अंय,</para>
  <para style="q2" vid="DEU 32:4">अऊ ओकर जम्मो रसता नियाय के अंय।</para>
  <para style="q1" vid="DEU 32:4">ओह एक बिसवासयोग्य परमेसर अय, जऊन ह गलत काम नइं करय,</para>
  <para style="q2" vid="DEU 32:4">ओह ईमानदार अऊ नियायी अय।<verse eid="DEU 32:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="DEU 32:5"/>इसरायलीमन बिगड़ गे हवंय अऊ ओमन ओकर लइका नो हंय;</para>
  <para style="q2" vid="DEU 32:5">अपन बेसरमी म, ओमन बेईमान अऊ दुस्ट पीढ़ी के मनखे अंय।<verse eid="DEU 32:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="DEU 32:6"/>हे मुरूख अऊ निरबुद्धि मनखेमन,</para>
  <para style="q2" vid="DEU 32:6">का तुमन ये किसम ले यहोवा ला बदला देवत हव?</para>
  <para style="q1" vid="DEU 32:6">का ओह तुम्हर ददा, तुम्हर सिरजनहार नो हय,<note caller="+" style="f"><char style="fr" closed="false">32:6 </char><char style="ft" closed="false">या ददा, </char><char style="fqa" closed="false">जऊन ह तुमन ला बिसाईस</char></note></para>
  <para style="q2" vid="DEU 32:6">जऊन ह तुमन ला बनाईस अऊ तुमन ला आकार दीस?<verse eid="DEU 32:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="DEU 32:7"/>पुराना जमाना ला सुरता करव;</para>
  <para style="q2" vid="DEU 32:7">बहुंत पहिले के पीढ़ीमन ऊपर बिचार करव।</para>
  <para style="q1" vid="DEU 32:7">अपन ददा ले पुछव अऊ ओह तुमन ला बताही,</para>
  <para style="q2" vid="DEU 32:7">अपन अगुवामन ले पुछव, अऊ ओमन तुमन ला समझाहीं।<verse eid="DEU 32:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="DEU 32:8"/>जब सर्वोच्च परमेसर ह जाति-जाति के मनखेमन ला ओमन के उत्तराधिकार दीस,</para>
  <para style="q2" vid="DEU 32:8">जब ओह मनखे-जात ला अलग-अलग करिस,</para>
  <para style="q1" vid="DEU 32:8">ओह इसरायल के बेटामन के गनती के मुताबिक</para>
  <para style="q2" vid="DEU 32:8">मनखेमन बर सीमना बांधिस।<verse eid="DEU 32:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="DEU 32:9"/>काबरकि यहोवा के बांटा ओकर मनखेमन अंय,</para>
  <para style="q2" vid="DEU 32:9">याकूब ह उत्तराधिकार म मिले ओकर भाग ए।<verse eid="DEU 32:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="DEU 32:10"/>एक मरू-भुइयां, एक बंजर</para>
  <para style="q2" vid="DEU 32:10">अऊ सांय-सांय करत भुइयां म ओला याकूब ह मिलिस।</para>
  <para style="q1" vid="DEU 32:10">ओह ओला सुरकछा दीस अऊ ओकर खियाल रखिस;</para>
  <para style="q2" vid="DEU 32:10">अपन आंखी के पुतली के सहीं ओकर देखरेख करिस,<verse eid="DEU 32:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="DEU 32:11"/>जइसे एक गिधवा ह अपन खोंधरा ला हलाथे</para>
  <para style="q2" vid="DEU 32:11">अऊ अपन पीलामन ऊपर मंडराथे,</para>
  <para style="q1" vid="DEU 32:11">ताकि अपन डेना ला फईलाके ओमन ला पकड़य</para>
  <para style="q2" vid="DEU 32:11">अऊ उठाके ऊपर ले जावय।<verse eid="DEU 32:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="DEU 32:12"/>यहोवा ह एके झन ओकर अगुवई करिस;</para>
  <para style="q2" vid="DEU 32:12">कोनो पराय देवता ओकर संग नइं रिहिस।<verse eid="DEU 32:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="DEU 32:13"/>ओह ओला धरती के ऊंच-ऊंच जगह म ले गीस</para>
  <para style="q2" vid="DEU 32:13">अऊ खेतमन के फसल ओला खवाईस।</para>
  <para style="q1" vid="DEU 32:13">ओह ओकर पालन-पोसन चट्टान के मंधरस,</para>
  <para style="q2" vid="DEU 32:13">अऊ कठोर खड़े चट्टान के तेल म ले करिस<verse eid="DEU 32:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="DEU 32:14"/>ओह ओला पसुमन के झुंड के दूध-दही</para>
  <para style="q2" vid="DEU 32:14">अऊ बासान के छंटे मेढ़ामन के संग</para>
  <para style="q1" vid="DEU 32:14">मोटा-ताजा भेड़ अऊ बोकरा के मांस</para>
  <para style="q2" vid="DEU 32:14">अऊ उत्तम किसम के गहूं के जेवन कराईस।</para>
  <para style="q1" vid="DEU 32:14">तेंह अंगूर के झागवाला लाल रस पीयय।<verse eid="DEU 32:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="DEU 32:15"/>पर यसूरून<note caller="+" style="f"><char style="fr" closed="false">32:15 </char><char style="fq" closed="false">यसूरून </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">ईमानदार मनखे </char><char style="ft" closed="false">याने कि इसरायल; देखव <char style="xt"><ref loc="ISA 44:2">यसा 44:2</ref></char></char></note> ह मोटा होके लात मारिस;</para>
  <para style="q2" vid="DEU 32:15">बहुंत खाके, ओमन भारी अऊ चिकना हो गीन।</para>
  <para style="q1" vid="DEU 32:15">ओमन ओ परमेसर ला तियाग दीन, जऊन ह ओमन ला बनाईस</para>
  <para style="q2" vid="DEU 32:15">अऊ ओ चट्टान अपन उद्धारकर्ता ला अस्वीकार करिन।<verse eid="DEU 32:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="DEU 32:16"/>ओमन पराय देवतामन ला मानके ओला जलन रखनेवाला बना दीन</para>
  <para style="q2" vid="DEU 32:16">अऊ अपन घिनौना मूरतीमन के दुवारा ओला रिस देवाईन।<verse eid="DEU 32:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="DEU 32:17"/>ओमन झूठ-मूठ के देवतामन ला बलिदान चघाईन, जेमन परमेसर नो हंय;</para>
  <para style="q2" vid="DEU 32:17">ओ देवतामन, जेमन ला ओमन नइं जानत रिहिन,</para>
  <para style="q2" vid="DEU 32:17">ओ देवतामन, जेमन कुछू समय पहिले परगट होय रिहिन,</para>
  <para style="q2" vid="DEU 32:17">ओ देवतामन, जेमन के भय तुम्हर पुरखामन म नइं रिहिस।<verse eid="DEU 32:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="DEU 32:18"/>तुमन ओ चट्टान ला छोंड़ देव, जऊन ह तुमन ला पालिस-पोसिस;</para>
  <para style="q2" vid="DEU 32:18">तुमन ओ परमेसर ला भुला गेव, जऊन ह तुमन ला पईदा करिस।<verse eid="DEU 32:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="DEU 32:19"/>यहोवा ह येला देखिस अऊ ओमन ला अस्वीकार कर दीस</para>
  <para style="q2" vid="DEU 32:19">काबरकि ओमन के बेटा-बेटीमन ओला गुस्सा देवाईन।<verse eid="DEU 32:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="DEU 32:20"/>तब यहोवा ह कहिस, “मेंह ओमन ले अपन मुहूं छुपा लूहूं,</para>
  <para style="q2" vid="DEU 32:20">अऊ देखहूं कि ओमन के अन्त कइसे होही;</para>
  <para style="q1" vid="DEU 32:20">काबरकि ओमन एक बिगड़े पीढ़ी के मनखे अंय,</para>
  <para style="q2" vid="DEU 32:20">अइसे संतान अंय, जेमन बिसवासयोग्य नो हंय।<verse eid="DEU 32:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="DEU 32:21"/>ओमन मोर म ओकर दुवारा जलन पईदा करिन, जऊन ह ईस्वर नो हय</para>
  <para style="q2" vid="DEU 32:21">अऊ अपन बेकार के मूरतीमन के दुवारा मोला गुस्सा देवाईन।</para>
  <para style="q1" vid="DEU 32:21">मेंह ओमन म ओमन के दुवारा जलन पईदा करहूं, जेमन एक जाति नो हंय;</para>
  <para style="q2" vid="DEU 32:21">मेंह ओमन ला एक अइसे जाति के दुवारा कोरोध दिलवाहूं, जेमन म समझ नइं ए।<verse eid="DEU 32:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="DEU 32:22"/>काबरकि मोर कोप के आगी ह बरही,</para>
  <para style="q2" vid="DEU 32:22">अइसन आगी, जऊन ह खाल्हे तक मिरतू-लोक ला जला देथे।</para>
  <para style="q1" vid="DEU 32:22">येह धरती अऊ येकर ऊपज ला भसम कर दीही</para>
  <para style="q2" vid="DEU 32:22">अऊ पहाड़मन के नीव म आगी लगा दीही।<verse eid="DEU 32:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="DEU 32:23"/>“मेंह ओमन ऊपर बहुंत बिपत्ति लानहूं</para>
  <para style="q2" vid="DEU 32:23">अऊ ओमन ऊपर अपन तीर चलाहूं।<verse eid="DEU 32:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="DEU 32:24"/>मेंह ओमन ऊपर नास करइया अकाल,</para>
  <para style="q2" vid="DEU 32:24">बिनास करइया अऊ मिरतू देवइया महामारी लानहूं;</para>
  <para style="q1" vid="DEU 32:24">मेंह ओमन ऊपर जंगली पसु पठोहूं, जेमन ओमन ला काट खाहीं,</para>
  <para style="q2" vid="DEU 32:24">अऊ मेंह ओमन ऊपर धुर्रा म रेंगइया करैत सांप के जहर पठोहूं।<verse eid="DEU 32:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="DEU 32:25"/>घर के बाहिर गली म ओमन तलवार ले मारे जाहीं;</para>
  <para style="q2" vid="DEU 32:25">ओमन के घर म आतंक छा जाही।</para>
  <para style="q1" vid="DEU 32:25">जवान छोकरा अऊ छोकरी</para>
  <para style="q2" vid="DEU 32:25">दूध पीयत लइका अऊ डोकरामन नास हो जाहीं।<verse eid="DEU 32:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="DEU 32:26"/>मेंह कहेंव कि मेंह ओमन ला तितिर-बितिर कर दूहूं</para>
  <para style="q2" vid="DEU 32:26">अऊ मनखेमन के सुरता ले ओमन के नांव तक मिटा दूहूं,<verse eid="DEU 32:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="DEU 32:27"/>पर मोला बईरीमन के ताना मारे के भय रिहिस,</para>
  <para style="q2" vid="DEU 32:27">अइसे झन होवय कि बिरोधीमन गलत समझंय</para>
  <para style="q1" vid="DEU 32:27">अऊ ये कहंय, ‘हमन अपन बाहुबल ले जय पाय हन;</para>
  <para style="q2" vid="DEU 32:27">यहोवा ह ये जम्मो काम नइं करे हवय।’ ”<verse eid="DEU 32:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="DEU 32:28"/>ओमन एक अइसन जाति के मनखे अंय, जेमन करा गियान नइं ए,</para>
  <para style="q2" vid="DEU 32:28">ओमन म कुछू समझ नइं ए।<verse eid="DEU 32:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="DEU 32:29"/>कास ओमन म बुद्धि होतिस अऊ ओमन ये बात ला समझतिन</para>
  <para style="q2" vid="DEU 32:29">अऊ जानतिन कि ओमन के का अन्त होही!<verse eid="DEU 32:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="DEU 32:30"/>एक मनखे ह हजार मनखे ला कइसे भगा सकही,</para>
  <para style="q2" vid="DEU 32:30">या दू झन दस हजार के संग कइसे लड़ सकत हें,</para>
  <para style="q1" vid="DEU 32:30">जब तक कि ओमन के चट्टान ह ओमन ला बेच नइं देवय,</para>
  <para style="q2" vid="DEU 32:30">अऊ यहोवा ह ओमन ला आने मन के हांथ म नइं कर देवय?<verse eid="DEU 32:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="DEU 32:31"/>काबरकि ओमन के चट्टान ह हमर चट्टान सहीं नो हय,</para>
  <para style="q2" vid="DEU 32:31">इहां तक कि हमर बईरीमन घलो ये बात ला स्वीकार करथें।<verse eid="DEU 32:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="DEU 32:32"/>ओमन के अंगूर के नार ह सदोम के अंगूर के नार</para>
  <para style="q2" vid="DEU 32:32">अऊ अमोरा के खेतमन ले आथे।</para>
  <para style="q1" vid="DEU 32:32">ओमन के अंगूरमन जहर ले,</para>
  <para style="q2" vid="DEU 32:32">अऊ ओमन के गुच्छामन करूवाहट ले भरे हवंय।<verse eid="DEU 32:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="DEU 32:33"/>ओमन के अंगूर के मंद ह सांप के जहर,</para>
  <para style="q2" vid="DEU 32:33">नाग सांप के घातक जहर अय।<verse eid="DEU 32:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="DEU 32:34"/>“का मेंह येला जमा करके</para>
  <para style="q2" vid="DEU 32:34">अऊ मोर गुफा म मुहर लगाके नइं रखे हंव?<verse eid="DEU 32:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="DEU 32:35"/>बदला लेवई मोर काम ए; मेंह बदला लूहूं।</para>
  <para style="q2" vid="DEU 32:35">सही समय म ओमन के पांव ह फिसलही;</para>
  <para style="q1" vid="DEU 32:35">ओमन के बिपत्ति के दिन ह लकठा म हवय</para>
  <para style="q2" vid="DEU 32:35">अऊ बिनास ह ओमन ऊपर जल्दी अवइया हे।”<verse eid="DEU 32:35"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="36" style="v" sid="DEU 32:36"/>जब यहोवा ह देखही कि ओकर मनखेमन के सक्ति खतम हो गे हवय</para>
  <para style="q2" vid="DEU 32:36">अऊ कोनो नइं बचे हवंय, न गुलाम न सुतंतर मनखे,</para>
  <para style="q1" vid="DEU 32:36">त ओह अपन मनखेमन के बचाव करही</para>
  <para style="q2" vid="DEU 32:36">अऊ अपन सेवकमन के ऊपर दया देखाही।<verse eid="DEU 32:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="DEU 32:37"/>अऊ यहोवा ह कहिही, “ओमन के देवतामन कहां हवंय,</para>
  <para style="q2" vid="DEU 32:37">ओ चट्टान, जिहां ओमन सरन ले रिहिन,<verse eid="DEU 32:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="DEU 32:38"/>ओ देवता, जेमन ओमन के चघाय बलिदान के चरबी ला खाईन</para>
  <para style="q2" vid="DEU 32:38">अऊ ओमन के पेय-बलिदान के अंगूर के मंद ला पीईन?</para>
  <para style="q1" vid="DEU 32:38">ओमन तुम्हर मदद करे बर उठंय!</para>
  <para style="q2" vid="DEU 32:38">ओमन तुमन ला सरन देवंय!<verse eid="DEU 32:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="DEU 32:39"/>“तुमन अब देख लव कि मेंह खुद ओ अंव!</para>
  <para style="q2" vid="DEU 32:39">मोर छोंड़ अऊ कोनो देवता नइं एं।</para>
  <para style="q1" vid="DEU 32:39">मेंह मिरतू देथंव अऊ मेंह जिनगी देथंव,</para>
  <para style="q2" vid="DEU 32:39">मेंह चोट लगाय हंव अऊ मेंह चंगा करहूं,</para>
  <para style="q2" vid="DEU 32:39">अऊ कोनो मोर हांथ ले बचा नइं सकंय।<verse eid="DEU 32:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="DEU 32:40"/>मेंह स्वरग कोति हांथ उठाके कसम खावत हंव:</para>
  <para style="q2" vid="DEU 32:40">मोर जिनगी के सपथ,<verse eid="DEU 32:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="DEU 32:41"/>जब मेंह अपन चमकत तलवार म धार लगाहूं</para>
  <para style="q2" vid="DEU 32:41">अऊ मोर हांथ ह नियाय बर येला धरही,</para>
  <para style="q1" vid="DEU 32:41">त मेंह अपन बईरीमन ले बदला लूहूं</para>
  <para style="q2" vid="DEU 32:41">अऊ ओमन ला बदला चुकाहूं, जेमन मोर ले घिन करथें।<verse eid="DEU 32:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="DEU 32:42"/>मोर तीरमन खून ले भर जाहीं,</para>
  <para style="q2" vid="DEU 32:42">अऊ मोर तलवार ह मांस ला चीर-फार दीही:</para>
  <para style="q1" vid="DEU 32:42">मारे गय मनखे अऊ बंधुवामन के खून ले लाल हो जाही,</para>
  <para style="q2" vid="DEU 32:42">अऊ बईरीमन के अगुवामन के मुड़मन ला चीर-फार दीही।”<verse eid="DEU 32:42"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="43" style="v" sid="DEU 32:43"/>हे जाति-जाति के मनखेमन ओकर मनखेमन के संग आनंद मनावव,</para>
  <para style="q2" vid="DEU 32:43">काबरकि ओह अपन सेवकमन के खून के बदला लीही;</para>
  <para style="q1" vid="DEU 32:43">ओह अपन बईरीमन ले बदला लीही</para>
  <para style="q2" vid="DEU 32:43">अऊ अपन देस अऊ अपन मनखेमन बर प्रायस्चित ला पूरा करही।<verse eid="DEU 32:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="DEU 32:44"/>मूसा ह नून के बेटा यहोसू<note caller="+" style="f"><char style="fr" closed="false">32:44 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">होसे</char><char style="ft" closed="false">, एक आने नांव </char><char style="fq" closed="false">यहोसू </char><char style="ft" closed="false">के</char></note> के संग आईस अऊ ये गीत के जम्मो बचन ला मनखेमन ला सुनाईस। <verse eid="DEU 32:44"/><verse number="45" style="v" sid="DEU 32:45"/>जब मूसा ह जम्मो इसरायलीमन ला ये जम्मो बचन पढ़के सुना दीस, <verse eid="DEU 32:45"/><verse number="46" style="v" sid="DEU 32:46"/>त ओह ओमन ला कहिस, “जऊन बचन मेंह आज तुमन ला गंभीरता से सुनाय हंव, ओ जम्मो ला अपन मन म रख लव, ताकि तुमन अपन लइकामन ला हुकूम दे सकव कि ओमन धियान देके ये कानून के जम्मो बचन के पालन करंय। <verse eid="DEU 32:46"/><verse number="47" style="v" sid="DEU 32:47"/>येमन तुम्हर बर बेमतलब के बचन नो हंय—येमन तुम्हर जिनगी अंय। येमन के दुवारा ओ देस म लम्बा समय तक जीयत रहिहू, जेकर ऊपर अधिकार करे बर तुमन यरदन नदी के ओ पार जावत हव।”<verse eid="DEU 32:47"/></para>
  <para style="s1">नबो पहाड़ ऊपर मूसा के मिरतू</para>
  <para style="p">
    <verse number="48" style="v" sid="DEU 32:48"/>ओहीच दिन यहोवा ह मूसा ला कहिस, <verse eid="DEU 32:48"/><verse number="49" style="v" sid="DEU 32:49"/>“तेंह नबो पहाड़ के अबारीम छेत्र के ऊपर जा, जऊन ह मोआब देस म यरीहो सहर के ओ पार हवय, अऊ कनान देस ला देख, जेला मेंह इसरायलीमन ला ओमन के अधिकार म देवत हंव। <verse eid="DEU 32:49"/><verse number="50" style="v" sid="DEU 32:50"/>ओ पहाड़ जिहां तेंह चढ़बे, उहां तेंह मर जाबे अऊ अपन मरे मनखेमन संग मिल जाबे, जइसे कि तोर भाई हारून ह होर पहाड़ ऊपर मरिस अऊ अपन मरे पुरखामन संग मिल गीस। <verse eid="DEU 32:50"/><verse number="51" style="v" sid="DEU 32:51"/>येकर कारन ये अय कि सीन के निरजन जगह म, मरीबा-कादेस के पानी के सोता करा, तुमन दूनों मोर बिसवास ला टोर देव अऊ इसरायलीमन के बीच म मोर पबितरता ला बनाय नइं रखेव। <verse eid="DEU 32:51"/><verse number="52" style="v" sid="DEU 32:52"/>एकरसेति, तेंह ओ देस ला दूरिहा ले सिरिप देख सकबे; तेंह ओ देस म नइं जा सकबे, जेला मेंह इसरायल के मनखेमन ला देवत हंव।”<verse eid="DEU 32:52"/></para>
  <chapter eid="DEU 32"/>
  <chapter number="33" style="c" sid="DEU 33"/>
  <para style="s1">मूसा ह इसरायलीमन ला आसीस देथे</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 33:1"/>परमेसर के जन मूसा ह अपन मिरतू के पहिले इसरायलीमन ला जऊन आसीस दीस, ओह ये अय। <verse eid="DEU 33:1"/><verse number="2" style="v" sid="DEU 33:2"/>ओह कहिस:</para>
  <para style="q1" vid="DEU 33:2">“यहोवा ह सीनय पहाड़ ले आईस</para>
  <para style="q2" vid="DEU 33:2">अऊ सेईर पहाड़ ले ओमन ऊपर सूरज के सहीं परगट होईस;</para>
  <para style="q2" vid="DEU 33:2">ओह पारान पहाड़ ले अपन अंजोर के चमक देखाईस।</para>
  <para style="q1" vid="DEU 33:2">ओह हजारों पबितर जन के संग<note caller="+" style="f"><char style="fr" closed="false">33:2 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">म ले</char></note></para>
  <para style="q2" vid="DEU 33:2">दक्खिन ले, अपन पहाड़ के ढाल म ले आईस।<note caller="+" style="f"><char style="fr" closed="false">33:2 </char><char style="ft" closed="false">इबरानी म येकर मतलब ह साफ नइं ए</char></note><verse eid="DEU 33:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="DEU 33:3"/>खचित येह तें अस, जऊन ह अपन मनखेमन ले मया करथस;</para>
  <para style="q2" vid="DEU 33:3">जम्मो पबितर जन तोर हांथ म हवंय।</para>
  <para style="q1" vid="DEU 33:3">तोर गोड़ म ओ जम्मो झन मुड़ नवाथें,</para>
  <para style="q2" vid="DEU 33:3">अऊ तोर ले ओमन ला हुकूम मिलथे,<verse eid="DEU 33:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="DEU 33:4"/>ओ कानून जेला मूसा हमन ला दीस,</para>
  <para style="q2" vid="DEU 33:4">अऊ याकूब के सभा के अधिकार घलो मिलथे।<verse eid="DEU 33:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="DEU 33:5"/>जब मनखेमन के अगुवामन</para>
  <para style="q2" vid="DEU 33:5">इसरायल के गोत्रमन के संग जूरे रिहिन,</para>
  <para style="q2" vid="DEU 33:5">तब ओह यसूरून<note caller="+" style="f"><char style="fr" closed="false">33:5 </char><char style="fq" closed="false">यसूरून </char><char style="ft" closed="false">के मतलब </char><char style="fqa" closed="false">ईमानदार मनखे </char><char style="ft" closed="false">याने कि इसरायल; देखव <char style="xt" link-href="DEU 33:26"><ref loc="DEU 33:26">पद 26</ref></char> म घलो</char></note> के राजा रिहिस।<verse eid="DEU 33:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="DEU 33:6"/>“रूबेन<note caller="+" style="f"><char style="fr" closed="false">33:6 </char><char style="fq" closed="false">रूबेन </char><char style="ft" closed="false">के </char><char style="fqa" closed="false">गोत्र</char></note> ह जीयत रहय अऊ ओह झन मरय,</para>
  <para style="q2" vid="DEU 33:6">अऊ ओकर मनखेमन कम झन होवंय।”<verse eid="DEU 33:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 33:7"/>अऊ मूसा ह यहूदा के बारे म ये कहिस:</para>
  <para style="q1" vid="DEU 33:7">“हे यहोवा, यहूदा के बिनती ला सुन;</para>
  <para style="q2" vid="DEU 33:7">ओला ओकर मनखेमन करा लान।</para>
  <para style="q1" vid="DEU 33:7">अपन खुद के हांथ ले ओह अपन मामला के बचाव करथे।</para>
  <para style="q2" vid="DEU 33:7">ओकर बईरीमन के बिरूध ओकर मदद कर!”<verse eid="DEU 33:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 33:8"/>लेवी के बारे म ओह कहिस:</para>
  <para style="q1" vid="DEU 33:8">“तोर तुम्मीम अऊ ऊरीम<note caller="+" style="f"><char style="fr" closed="false">33:8 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="EXO 28:30">निर 28:30</ref>; <ref loc="LEV 8:8">लैव्य 8:8</ref>; <ref loc="1SA 14:41-42">1 समू 14:41‑42</ref></char></char></note></para>
  <para style="q2" vid="DEU 33:8">तोर बिसवासयोग्य सेवक के अंय।</para>
  <para style="q1" vid="DEU 33:8">तेंह ओला मस्सा करा परखय;</para>
  <para style="q2" vid="DEU 33:8">तेंह मरीबा के सोता करा ओकर संग बाद-बिबाद करय।<verse eid="DEU 33:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="DEU 33:9"/>ओह अपन दाई अऊ ददा के बारे म कहिस,</para>
  <para style="q2" vid="DEU 33:9">‘ओमन बर मोर मन म कोनो आदर नइं ए।’</para>
  <para style="q1" vid="DEU 33:9">ओह अपन भाईमन ला नइं पहिचानिस</para>
  <para style="q2" vid="DEU 33:9">अऊ न ही अपन लइकामन ला स्वीकार करिस,</para>
  <para style="q1" vid="DEU 33:9">पर ओह तोर बचन के पालन करिस</para>
  <para style="q2" vid="DEU 33:9">अऊ तोर करार के रखवारी करिस।<verse eid="DEU 33:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="DEU 33:10"/>ओह याकूब ला तोर नियम</para>
  <para style="q2" vid="DEU 33:10">अऊ इसरायल ला तोर कानून के सिकछा देथे।</para>
  <para style="q1" vid="DEU 33:10">ओह तोर आघू म धूप जलाथे</para>
  <para style="q2" vid="DEU 33:10">अऊ तोर बेदी म पूरा होम-बलिदान चघाथे।<verse eid="DEU 33:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="DEU 33:11"/>हे यहोवा, ओकर जम्मो कुसलता ऊपर आसीस दे,</para>
  <para style="q2" vid="DEU 33:11">अऊ ओकर हांथ के सेवा ला गरहन कर।</para>
  <para style="q1" vid="DEU 33:11">जेमन ओकर बिरूध ठाढ़ होथें, ओमन ला अऊ ओकर बईरीमन ला</para>
  <para style="q2" vid="DEU 33:11">अइसे मार कि ओमन फेर ठाढ़ झन हो सकंय।”<verse eid="DEU 33:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 33:12"/>बिनयामीन के बारे म ओह कहिस:</para>
  <para style="q1" vid="DEU 33:12">“यहोवा के मयारू ह ओकर सुरकछा म रहय,</para>
  <para style="q2" vid="DEU 33:12">काबरकि यहोवा ह दिन भर ओकर सुरकछा करथे,</para>
  <para style="q2" vid="DEU 33:12">अऊ जेला यहोवा ह मया करथे, ओह ओकर दूनों कंधा के बीच म रहिथे।”<verse eid="DEU 33:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 33:13"/>यूसुफ के बारे म ओह कहिस:</para>
  <para style="q1" vid="DEU 33:13">“यहोवा ह ओकर देस ला</para>
  <para style="q2" vid="DEU 33:13">ऊपर अकास के कीमती ओस ले</para>
  <para style="q2" vid="DEU 33:13">अऊ खाल्हे के गहिरा पानी ले आसीस देवय;<verse eid="DEU 33:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="DEU 33:14"/>सूरज के परभाव ले उपजे सबले बने चीज</para>
  <para style="q2" vid="DEU 33:14">अऊ चंदा के दुवारा दिये उत्तम चीज;<verse eid="DEU 33:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="DEU 33:15"/>पुराना पहाड़मन के मनपसंद ईनाम</para>
  <para style="q2" vid="DEU 33:15">अऊ सदाकाल तक बने रहइया पहाड़ीमन के फर;<verse eid="DEU 33:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="DEU 33:16"/>धरती अऊ येकर भरपूरी म ले सबले उत्तम चीजमन के आसीस यहोवा देवय</para>
  <para style="q2" vid="DEU 33:16">अऊ ओकर किरपा बने रहय, जऊन ह बरत झाड़ी म रिहिस।<note caller="+" style="f"><char style="fr" closed="false">33:16 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="EXO 3:1-6">निर 3:1‑6</ref></char></char></note></para>
  <para style="q1" vid="DEU 33:16">ये जम्मो चीज यूसुफ के मुड़ म</para>
  <para style="q2" vid="DEU 33:16">याने कि ओकर भौंह म उतरय, जऊन ह अपन भाईमन के बीच राजकुमार रिहिस।<verse eid="DEU 33:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="DEU 33:17"/>वैभव म ओह एक पहिलांत सांड़ के सहीं अय;</para>
  <para style="q2" vid="DEU 33:17">ओकर सींगमन जंगली बईला के सींग के सहीं अंय।</para>
  <para style="q1" vid="DEU 33:17">ओमन के दुवारा ओह जाति-जाति के मनखे,</para>
  <para style="q2" vid="DEU 33:17">इहां तक कि धरती के छोर के मनखेमन ला घायल करही।</para>
  <para style="q1" vid="DEU 33:17">अइसने अंय एपरैम के दस हजार;</para>
  <para style="q2" vid="DEU 33:17">अइसने अंय मनस्से के हजारों-हजार।”<verse eid="DEU 33:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 33:18"/>जबूलून के बारे म ओह कहिस:</para>
  <para style="q1" vid="DEU 33:18">“हे जबूलून, अपन बाहिर जवई म,</para>
  <para style="q2" vid="DEU 33:18">अऊ हे इस्साकार, तेंह अपन तम्बू म आनंद मना।<verse eid="DEU 33:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="DEU 33:19"/>ओमन मनखेमन ला पहाड़ ऊपर बलाहीं</para>
  <para style="q2" vid="DEU 33:19">अऊ उहां धरमीपन के बलिदान चघाहीं;</para>
  <para style="q1" vid="DEU 33:19">ओमन समुंदर के बहुंत चीज,</para>
  <para style="q2" vid="DEU 33:19">अऊ बालू म छुपे खजाना म ले लाभ उठाहीं।”<verse eid="DEU 33:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 33:20"/>गाद के बारे म ओह कहिस:</para>
  <para style="q1" vid="DEU 33:20">“धइन अय ओ, जऊन ह गाद के इलाका ला बढ़ाथे!</para>
  <para style="q2" vid="DEU 33:20">गाद ह उहां एक सिंह के सहीं रहिथे,</para>
  <para style="q2" vid="DEU 33:20">अऊ बाहां या मुड़ ला चीर देथे।<verse eid="DEU 33:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="DEU 33:21"/>ओह अपन बर सबले बढ़िया भुइयां ला चुनिस;</para>
  <para style="q2" vid="DEU 33:21">अगुवा के भाग ह ओकर बर रखे गे रिहिस।</para>
  <para style="q1" vid="DEU 33:21">जब मनखेमन के मुखियामन जूरिन,</para>
  <para style="q2" vid="DEU 33:21">त ओह यहोवा के धरमी ईछा</para>
  <para style="q2" vid="DEU 33:21">अऊ इसरायल के बारे म ओकर नियाय ला पूरा करिस।”<verse eid="DEU 33:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 33:22"/>दान के बारे म ओह कहिस:</para>
  <para style="q1" vid="DEU 33:22">“दान ह बासान के उछलत-कूदत</para>
  <para style="q2" vid="DEU 33:22">सिंह के एक पीला ए।”<verse eid="DEU 33:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 33:23"/>नपताली के बारे म ओह कहिस:</para>
  <para style="q1" vid="DEU 33:23">“नपताली के ऊपर यहोवा के बहुंत किरपा हवय</para>
  <para style="q2" vid="DEU 33:23">अऊ ओह यहोवा के आसीस ले भरे हवय;</para>
  <para style="q2" vid="DEU 33:23">ओला समुंदर कोति दक्खिन के भाग उत्तराधिकार म मिलही।”<verse eid="DEU 33:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="DEU 33:24"/>आसेर के बारे म ओह कहिस:</para>
  <para style="q1" vid="DEU 33:24">“बेटामन म आसेर ह सबले जादा आसीसित अय;</para>
  <para style="q2" vid="DEU 33:24">ओकर ऊपर ओकर भाईमन के किरपा होवय,</para>
  <para style="q2" vid="DEU 33:24">अऊ ओकर पांव ह तेल म नहावय।<verse eid="DEU 33:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="DEU 33:25"/>तोर दुवार के छड़मन लोहा अऊ कांसा के होहीं,</para>
  <para style="q2" vid="DEU 33:25">अऊ तोर बल ह तोर उमर के बराबर होही।<verse eid="DEU 33:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="DEU 33:26"/>“यसूरून के परमेसर के सहीं कोनो नइं अंय,</para>
  <para style="q2" vid="DEU 33:26">जऊन ह अकास के ओ पार ले</para>
  <para style="q2" vid="DEU 33:26">अपन वैभव म बादर ऊपर सवार होके तोर मदद करे बर आथे।<verse eid="DEU 33:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="DEU 33:27"/>अनादि परमेसर ह तोर सरन-स्थान ए,</para>
  <para style="q2" vid="DEU 33:27">अऊ तोर खाल्हे म सदा बने रहइया बाहांमन हवंय।</para>
  <para style="q1" vid="DEU 33:27">ओह तोर आघू ले तोर बईरीमन ला ये कहिके भगा दीही,</para>
  <para style="q2" vid="DEU 33:27">‘ओमन ला नास कर दव!’<verse eid="DEU 33:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="DEU 33:28"/>एकरसेति इसरायल ह निडर होके रहिही;</para>
  <para style="q2" vid="DEU 33:28">याकूब ह अनाज अऊ नवां अंगूर के मंद के देस म</para>
  <para style="q1" vid="DEU 33:28">सुरकछित निवास करही,</para>
  <para style="q2" vid="DEU 33:28">जिहां अकास ले ओस गिरथे।<verse eid="DEU 33:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="DEU 33:29"/>हे इसरायल, धइन अस तें!</para>
  <para style="q2" vid="DEU 33:29">यहोवा ले उद्धार पाय मनखे,</para>
  <para style="q2" vid="DEU 33:29">तोर सहीं कोन हवय?</para>
  <para style="q1" vid="DEU 33:29">ओह तोर ढाल अऊ मददगार</para>
  <para style="q2" vid="DEU 33:29">अऊ महिमामय तलवार ए।</para>
  <para style="q1" vid="DEU 33:29">तुम्हर बईरीमन तुम्हर आघू म झुकहीं,</para>
  <para style="q2" vid="DEU 33:29">अऊ तुमन ओमन के ऊंच जगहमन ला रऊंद डालहू।”<verse eid="DEU 33:29"/></para>
  <chapter eid="DEU 33"/>
  <chapter number="34" style="c" sid="DEU 34"/>
  <para style="s1">मूसा के मिरतू</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 34:1"/>तब मूसा ह मोआब के मैदान ले नबो पहाड़ ऊपर पिसगा के चोटी म चढ़ गीस, जऊन ह यरीहो के ओ पार हवय। उहां यहोवा ह ओला पूरा देस ला देखाईस—गिलाद के इलाका ले लेके दान नगर तक, <verse eid="DEU 34:1"/><verse number="2" style="v" sid="DEU 34:2"/>पूरा नपताली, एपरैम अऊ मनस्से के इलाका, यहूदा के जम्मो देस भूमध्य सागर तक, <verse eid="DEU 34:2"/><verse number="3" style="v" sid="DEU 34:3"/>नेगेव अऊ पूरा इलाका—यरीहो के घाटी, खजूर के सहर ले लेके सोअर तक। <verse eid="DEU 34:3"/><verse number="4" style="v" sid="DEU 34:4"/>तब यहोवा ह मूसा ला कहिस, “येह ओ देस ए, जेला मेंह सपथ खाके अब्राहम, इसहाक अऊ याकूब ला देय के वायदा ये कहिके करे रहेंव, ‘येला मेंह तुम्हर संतानमन ला दूहूं।’ मेंह तोला ये देस देखावत हंव, पर तें पार होके उहां नइं जा सकबे।”<verse eid="DEU 34:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 34:5"/>अऊ उहां मोआब देस म यहोवा के सेवक मूसा के मिरतू हो गीस, जइसे कि यहोवा ह कहे रिहिस। <verse eid="DEU 34:5"/><verse number="6" style="v" sid="DEU 34:6"/>यहोवा ह ओला मोआब म बेत-पोर नगर के सामने घाटी म माटी दीस,<note caller="+" style="f"><char style="fr" closed="false">34:6 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">ओला माटी दिये गीस</char></note> पर आज तक कोनो ला पता नइं चलिस कि ओकर कबर कहां हवय। <verse eid="DEU 34:6"/><verse number="7" style="v" sid="DEU 34:7"/>जब मूसा के मिरतू होईस, तब ओह एक सौ बीस बछर के रिहिस, तभो ले ओकर आंखी ह न तो कमजोर होय रिहिस अऊ न ही ओकर बल ह घटे रिहिस। <verse eid="DEU 34:7"/><verse number="8" style="v" sid="DEU 34:8"/>इसरायलीमन मोआब के मैदान म मूसा बर तीस दिन तक बिलाप करते रिहिन, जब तक कि रोये अऊ सोक मनाय के समय ह खतम नइं हो गीस।<verse eid="DEU 34:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 34:9"/>नून के बेटा यहोसू ह बुद्धि के आतमा ले भर गे रिहिस, काबरकि मूसा ह अपन हांथ ओकर ऊपर रखे रिहिस। एकरसेति इसरायलीमन ओकर बात ला सुनिन अऊ ओ काम करिन जेकर हुकूम यहोवा ह मूसा ला दे रिहिस।<verse eid="DEU 34:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 34:10"/>ओकर बाद, इसरायल म कोनो भी अगमजानी मूसा के सहीं नइं होईस, जेकर ले यहोवा ह आमने-सामने बात करिस, <verse eid="DEU 34:10"/><verse number="11" style="v" sid="DEU 34:11"/>जऊन ह ओ जम्मो चिनहां अऊ चमतकार देखाईस, जेमन ला देखाय बर यहोवा ह ओला मिसर देस म पठोय रिहिस कि ओह फिरौन, अऊ ओकर जम्मो करमचारी अऊ ओकर पूरा देस के सामने ओ चिनहां अऊ चमतकारमन ला देखावय। <verse eid="DEU 34:11"/><verse number="12" style="v" sid="DEU 34:12"/>काबरकि कभू कोनो अइसे अपार सक्ति या अद्भूत काम करके नइं देखाय रिहिन, जइसे मूसा ह इसरायल के जम्मो मनखेमन के आघू म करके देखाईस।<verse eid="DEU 34:12"/></para>
  <chapter eid="DEU 34"/>
</usx>
