<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="EZR" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  <para style="h">एजरा</para>
  <para style="toc1">एजरा के किताब</para>
  <para style="toc2">एजरा</para>
  <para style="toc3">एज</para>
  <para style="mt1">एजरा</para>
  <para style="mt2">के किताब</para>
  <chapter number="1" style="c" sid="EZR 1"/>
  <para style="s1">राजा कुसरू के मदद ले यहूदीमन के घर लहुंटई</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 1:1"/>फारस के राजा कुसरू के राज के पहिला बछर म यहोवा ह फारस के राजा कुसरू के मन ला उभारिस कि यहोवा के जऊन बचन यरमियाह अगमजानी के दुवारा कहे गे रिहिस, ओह पूरा हो जाय, एकरसेति राजा कुसरू ह अपन जम्मो राज म ये परचार करवाईस अऊ लिखवा भी दीस:<verse eid="EZR 1:1"/></para>
  <para style="pmo">
    <verse number="2" style="v" sid="EZR 1:2"/>“फारस के राजा कुसरू ह ये कहत हे:</para>
  <para style="pm" vid="EZR 1:2">“ ‘यहोवा, स्वरग के परमेसर ह धरती भर के जम्मो राज ला मोला दे हवय, अऊ ओह मोला यहूदा प्रदेस के यरूसलेम म ओकर बर एक मंदिर बनाय बर ठहिराय हवय। <verse eid="EZR 1:2"/><verse number="3" style="v" sid="EZR 1:3"/>तुम्हर बीच म ले, ओकर जऊन भी मनखे यहूदा के यरूसलेम जाय चाहत हवंय, ओमन जा सकत हें अऊ ओ यहोवा, इसरायल के परमेसर के मंदिर ला बनावंय, जऊन ह यरूसलेम म हवय, अऊ ओमन के परमेसर ह ओमन के संग रहय। <verse eid="EZR 1:3"/><verse number="4" style="v" sid="EZR 1:4"/>अऊ कोनो भी जगह म जिहां बांचे मनखेमन रहत हवंय, ओ जगह के मनखेमन सोन अऊ चांदी, धन अऊ पसु देके, ओमन के मदद करंय अऊ यरूसलेम म परमेसर के मंदिर बर स्वेच्छा-बलिदान देवंय।’ ”<verse eid="EZR 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 1:5"/>तब यहूदा अऊ बिनयामीन के परिवार के मुखियामन, अऊ पुरोहितमन अऊ लेवीमन—जेमन के मन ला परमेसर ह उभारे रिहिस, ओमन जाके यरूसलेम म यहोवा के भवन ला बनाय बर तियार हो गीन। <verse eid="EZR 1:5"/><verse number="6" style="v" sid="EZR 1:6"/>ओमन के जम्मो परोसीमन सोन अऊ चांदी, चीज-वस्तु अऊ पसु, अऊ अनमोल भेंट देके, ओमन के मदद करिन; येकर अलावा ओमन स्वेच्छा-बलिदान घलो दीन।<verse eid="EZR 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 1:7"/>फेर राजा कुसरू ह यहोवा के मंदिर के ओ चीजमन ला बाहिर ले आईस, जेला राजा नबूकदनेसर ह यरूसलेम ले लानके अपन देवता<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">देवतामन</char></note> के मंदिर म रखे रिहिस, <verse eid="EZR 1:7"/><verse number="8" style="v" sid="EZR 1:8"/>ओमन ला फारस के राजा कुसरू ह मिथरदात खजांची के दुवारा निकलवाईस, जऊन ह ओमन ला गनके यहूदीमन के परधान सेसबसर ला सऊंप दीस।<verse eid="EZR 1:8"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="9" style="v" sid="EZR 1:9"/>ओ चीजमन के गनती ये रिहिस:</para>
  <para style="b" vid="EZR 1:9"/>
  <para style="li1" vid="EZR 1:9">सोन के बरतन 30;</para>
  <para style="li1" vid="EZR 1:9">चांदी के बरतन 1,000;</para>
  <para style="li1" vid="EZR 1:9">चांदी के परात 29;<verse eid="EZR 1:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="EZR 1:10"/>सोन के कटोरा 30;</para>
  <para style="li1" vid="EZR 1:10">ओमन सहीं चांदी के कटोरा 410;</para>
  <para style="li1" vid="EZR 1:10">आने किसम के बरतन 1,000;<verse eid="EZR 1:10"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="11" style="v" sid="EZR 1:11"/>सोन अऊ चांदी के कुल 5,400 चीजमन रिहिन।</para>
  <para style="b" vid="EZR 1:11"/>
  <para style="p" vid="EZR 1:11">ये जम्मो ला सेसबसर ह बंधुवा मनखेमन के संग म लानिस, जब ओमन बेबिलोन ले यरूसलेम आईन।<verse eid="EZR 1:11"/></para>
  <chapter eid="EZR 1"/>
  <chapter number="2" style="c" sid="EZR 2"/>
  <para style="s1">ओ बंधुवा मनखेमन के सूची जेमन लहुंटके आईन</para>
  <para style="lh">
    <verse number="1" style="v" sid="EZR 2:1"/>जेमन ला बेबिलोन के राजा नबूकदनेसर ह बंदी बनाके बेबिलोन ले गेय रिहिस, येमन प्रदेस के ओ मनखे अंय, जेमन बंधुवई ले छूटके आईन (ओमन यरूसलेम अऊ यहूदा के अपन-अपन नगर म लहुंटिन, <verse eid="EZR 2:1"/><verse number="2" style="v" sid="EZR 2:2"/>येमन जरूब्बाबेल, यहोसू, नहेमियाह, सरायाह, रेलायाह, मोरदकै, बिलसान, मिसपार, बिगवै, रहूम, अऊ बाना के संग आईन):</para>
  <para style="b" vid="EZR 2:2"/>
  <para style="lh" vid="EZR 2:2">इसरायली मनखेमन के आदमीमन के सूची:<verse eid="EZR 2:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="EZR 2:3"/>परोस के संतान 2,172;<verse eid="EZR 2:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="EZR 2:4"/>सपतयाह के संतान 372;<verse eid="EZR 2:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="EZR 2:5"/>आरह के संतान 775;<verse eid="EZR 2:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="EZR 2:6"/>पहत-मोआब के संतान (येहोसू अऊ योआब के बंस म ले) 2,812;<verse eid="EZR 2:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="EZR 2:7"/>एलाम के संतान 1,254;<verse eid="EZR 2:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="EZR 2:8"/>जत्तू के संतान 945;<verse eid="EZR 2:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="EZR 2:9"/>जक्कई के संतान 760;<verse eid="EZR 2:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="EZR 2:10"/>बानी के संतान 642;<verse eid="EZR 2:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="EZR 2:11"/>बेबै के संतान 623;<verse eid="EZR 2:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="EZR 2:12"/>अजगाद के संतान 1,222;<verse eid="EZR 2:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="EZR 2:13"/>अदोनीकाम के संतान 666;<verse eid="EZR 2:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="EZR 2:14"/>बिगवै के संतान 2,056;<verse eid="EZR 2:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="EZR 2:15"/>आदीन के संतान 454;<verse eid="EZR 2:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="EZR 2:16"/>आतेर के संतान (हिजकियाह के बंस म ले) 98;<verse eid="EZR 2:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="EZR 2:17"/>बेसै के संतान 323;<verse eid="EZR 2:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="EZR 2:18"/>योराह के संतान 112;<verse eid="EZR 2:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="EZR 2:19"/>हासूम के संतान 223;<verse eid="EZR 2:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="EZR 2:20"/>गिब्बार के संतान 95;<verse eid="EZR 2:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="EZR 2:21"/>बैतलहम के आदमीमन 123;<verse eid="EZR 2:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="EZR 2:22"/>नतोपा के आदमीमन 56;<verse eid="EZR 2:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="EZR 2:23"/>अनातोत के आदमीमन 128;<verse eid="EZR 2:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="EZR 2:24"/>अजमावेत के आदमीमन 42;<verse eid="EZR 2:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="EZR 2:25"/>किरयत-यारीम, कपीरा अऊ बेरोत के आदमीमन 743;<verse eid="EZR 2:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="EZR 2:26"/>रामा अऊ गेबा के आदमीमन 621;<verse eid="EZR 2:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="EZR 2:27"/>मिकमास के आदमीमन 122;<verse eid="EZR 2:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="EZR 2:28"/>बेतेल अऊ अई के आदमीमन 223;<verse eid="EZR 2:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="EZR 2:29"/>नबो के आदमीमन 52;<verse eid="EZR 2:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="EZR 2:30"/>मगबीस के आदमीमन 156;<verse eid="EZR 2:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="EZR 2:31"/>दूसर एलाम के आदमीमन 1,254;<verse eid="EZR 2:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="EZR 2:32"/>हारीम के आदमीमन 320;<verse eid="EZR 2:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="EZR 2:33"/>लोद, हादीद अऊ ओनो के आदमीमन 725;<verse eid="EZR 2:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="EZR 2:34"/>यरीहो के आदमीमन 345;<verse eid="EZR 2:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="EZR 2:35"/>सना के आदमीमन 3,630।<verse eid="EZR 2:35"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="36" style="v" sid="EZR 2:36"/>पुरोहितमन:</para>
  <para style="li1" vid="EZR 2:36">यदायाह के संतान (येहोसू के परिवार के जरिये) 973;<verse eid="EZR 2:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="EZR 2:37"/>इम्मेर के संतान 1,052;<verse eid="EZR 2:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="EZR 2:38"/>पसहूर के संतान 1,247;<verse eid="EZR 2:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="EZR 2:39"/>हारीम के संतान 1,017।<verse eid="EZR 2:39"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="40" style="v" sid="EZR 2:40"/>लेवीमन:</para>
  <para style="li1" vid="EZR 2:40">येहोसू अऊ कदमीएल के संतान (होदवियाह के बंस के जरिये) 74।<verse eid="EZR 2:40"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="41" style="v" sid="EZR 2:41"/>संगीतकारमन:</para>
  <para style="li1" vid="EZR 2:41">आसाप के संतान 128।<verse eid="EZR 2:41"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="42" style="v" sid="EZR 2:42"/>मंदिर के दुवारपालमन:</para>
  <para style="li1" vid="EZR 2:42">सल्लूम, आतेर, तलमोन, अक्कूब, हतीता अऊ सोबै के संतान 139।<verse eid="EZR 2:42"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="43" style="v" sid="EZR 2:43"/>मंदिर के सेवकमन:</para>
  <para style="li1" vid="EZR 2:43">खाल्हे लिखे मनखेमन के संतानमन—</para>
  <para style="li1" vid="EZR 2:43">सीहा, हसूपा, तब्बाओत,<verse eid="EZR 2:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="EZR 2:44"/>केरोस, सीअहा, पादोन,<verse eid="EZR 2:44"/></para>
  <para style="li1">
    <verse number="45" style="v" sid="EZR 2:45"/>लबाना, हगाबा, अक्कूब,<verse eid="EZR 2:45"/></para>
  <para style="li1">
    <verse number="46" style="v" sid="EZR 2:46"/>हागाब, सल्मै, हानान,<verse eid="EZR 2:46"/></para>
  <para style="li1">
    <verse number="47" style="v" sid="EZR 2:47"/>गिद्दल, गहर, रायाह,<verse eid="EZR 2:47"/></para>
  <para style="li1">
    <verse number="48" style="v" sid="EZR 2:48"/>रसीन, नकोदा, गज्जाम,<verse eid="EZR 2:48"/></para>
  <para style="li1">
    <verse number="49" style="v" sid="EZR 2:49"/>उज्जा, पासेह, बेसै,<verse eid="EZR 2:49"/></para>
  <para style="li1">
    <verse number="50" style="v" sid="EZR 2:50"/>असना, मूनीम, नेफूसीम,<verse eid="EZR 2:50"/></para>
  <para style="li1">
    <verse number="51" style="v" sid="EZR 2:51"/>बकबूक, हकूपा, हरहूर,<verse eid="EZR 2:51"/></para>
  <para style="li1">
    <verse number="52" style="v" sid="EZR 2:52"/>बसलूत, महीदा, हरसा,<verse eid="EZR 2:52"/></para>
  <para style="li1">
    <verse number="53" style="v" sid="EZR 2:53"/>बरकोस, सीसरा, तेमह,<verse eid="EZR 2:53"/></para>
  <para style="li1">
    <verse number="54" style="v" sid="EZR 2:54"/>नसीह, अऊ हतीपा।<verse eid="EZR 2:54"/></para>
  <para style="lh">
    <verse number="55" style="v" sid="EZR 2:55"/>राजा सुलेमान के सेवकमन के संतान:</para>
  <para style="li1" vid="EZR 2:55">सोतै, हस्सोपेरेत, परूदा,<verse eid="EZR 2:55"/></para>
  <para style="li1">
    <verse number="56" style="v" sid="EZR 2:56"/>याला, दरकोन, गिद्देल,<verse eid="EZR 2:56"/></para>
  <para style="li1">
    <verse number="57" style="v" sid="EZR 2:57"/>सपतयाह, हत्तील,</para>
  <para style="li1" vid="EZR 2:57">पोकेरेत-हसेबायीम अऊ आमी के संतान।<verse eid="EZR 2:57"/></para>
  <para style="lf">
    <verse number="58" style="v" sid="EZR 2:58"/>मंदिर के सेवक अऊ सुलेमान के सेवकमन के संतान 392 रिहिन।<verse eid="EZR 2:58"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="59" style="v" sid="EZR 2:59"/>ये मनखेमन तेल-मेलह, तेल-हरसा, करूब, अदोन, अऊ इम्मेर ले आईन, पर येमन बता नइं सकिन कि येमन के परिवार के मनखेमन इसरायलीमन के संतान रिहिन:<verse eid="EZR 2:59"/></para>
  <para style="li1">
    <verse number="60" style="v" sid="EZR 2:60"/>संतानमन—</para>
  <para style="li2" vid="EZR 2:60">दलायाह, तोबियाह अऊ नकोदा के संतान 652।<verse eid="EZR 2:60"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="61" style="v" sid="EZR 2:61"/>अऊ पुरोहितमन के बीच म ले:</para>
  <para style="li1" vid="EZR 2:61">संतानमन—</para>
  <para style="li2" vid="EZR 2:61">होबायाह, हक्कोस अऊ बरजिलै (एक आदमी, जऊन ह गिलादी बरजिलै के एक बेटी ले बिहाव करे रिहिस अऊ ओकर नांव रख ले रिहिस) के संतान।<verse eid="EZR 2:61"/></para>
  <para style="lf">
    <verse number="62" style="v" sid="EZR 2:62"/>येमन अपन परिवार के लेखा-जोखा ला खोजिन, पर ओमन ला नइं मिलिस। एकरसेति येमन ला असुध ठहिराके पुरोहित के पद ले अलग रखे गीस। <verse eid="EZR 2:62"/><verse number="63" style="v" sid="EZR 2:63"/>राजपाल ह ओमन ला हुकूम दीस कि जब तक ऊरीम अऊ तुम्मीम धारन करइया कोनो पुरोहित सेवा नइं करत रहय, तब तक ओमन कोनो परम पबितर जेवन म ले कुछू चीज झन खावंय।<verse eid="EZR 2:63"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="64" style="v" sid="EZR 2:64"/>पूरा सभा के संखिया 42,360 रिहिस। <verse eid="EZR 2:64"/><verse number="65" style="v" sid="EZR 2:65"/>येमन के अलावा येमन के 7,337 पुरूस अऊ महिला गुलाम रिहिन; अऊ येमन के 200 पुरूस अऊ महिला गवइयामन घलो रिहिन। <verse eid="EZR 2:65"/><verse number="66" style="v" sid="EZR 2:66"/>ओमन करा 736 घोड़ा, 245 खच्चर, <verse eid="EZR 2:66"/><verse number="67" style="v" sid="EZR 2:67"/>435 ऊंट अऊ 6,720 गदहामन रिहिन।<verse eid="EZR 2:67"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="68" style="v" sid="EZR 2:68"/>जब ओमन यरूसलेम म यहोवा के घर मेर पहुंचिन, त परिवारमन के कुछू मुखियामन परमेसर के घर ला ओही जगह म फेर बनाय बर अपन ईछा ले दान दीन। <verse eid="EZR 2:68"/><verse number="69" style="v" sid="EZR 2:69"/>ओमन अपन योग्यता के मुताबिक 61,000 दरकमोन<note caller="+" style="f"><char style="fr" closed="false">2:69 </char><char style="ft" closed="false">लगभग 500 किलोग्राम</char></note> सोन अऊ 5,000 मीना<note caller="+" style="f"><char style="fr" closed="false">2:69 </char><char style="ft" closed="false">लगभग 3 टन</char></note> चांदी अऊ पुरोहितमन के 100 अंगरखा ये काम बर खजाना म दीन।<verse eid="EZR 2:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="EZR 2:70"/>तब पुरोहितमन, लेवीमन, संगीतकारमन, दुवारपालमन, अऊ मंदिर के सेवकमन अपन-अपन नगर म आने कुछू अऊ मनखेमन संग बस गीन, अऊ बाकि इसरायलीमन अपन-अपन नगर म बस गीन।<verse eid="EZR 2:70"/></para>
  <chapter eid="EZR 2"/>
  <chapter number="3" style="c" sid="EZR 3"/>
  <para style="s1">बेदी के फेर बनई</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 3:1"/>बेबिलोन ले लहुंटे के बाद, जब सातवां महिना आईस, अऊ इसरायलीमन अपन-अपन नगर म बस गीन, त मनखेमन यरूसलेम म एक मन होके जमा होईन। <verse eid="EZR 3:1"/><verse number="2" style="v" sid="EZR 3:2"/>तब योसादाक के बेटा यहोसू अऊ ओकर संगी पुरोहितमन अऊ सालतीएल के बेटा जरूब्बाबेल अऊ ओकर सहायकमन इसरायल के परमेसर के बेदी ला बनाय के सुरू करिन ताकि ओमा परमेसर के जन मूसा के कानून म लिखे मुताबिक होम-बलिदान चघाय जावय। <verse eid="EZR 3:2"/><verse number="3" style="v" sid="EZR 3:3"/>अपन आसपास के मनखेमन के डर के बावजूद, ओमन बेदी ला ओकरेच नीव म बनाईन अऊ येमा यहोवा बर हर रोज बिहनियां अऊ सांझकुन होम-बलिदान चघाय लगिन। <verse eid="EZR 3:3"/><verse number="4" style="v" sid="EZR 3:4"/>तब कानून म लिखे मुताबिक, ओमन पबितर-तम्बूमन के तिहार ला मानिन, अऊ संग म हर दिन जरूरी होम-बलिदानमन ला चघाईन। <verse eid="EZR 3:4"/><verse number="5" style="v" sid="EZR 3:5"/>ओकर बाद ओमन नियमित होम-बलिदान, नवां चंदा के बलिदान अऊ ठहिराय गय यहोवा के जम्मो पबितर तिहारमन के बलिदान अऊ संग म लाय गय यहोवा बर स्वेच्छा-बलिदान घलो चघाईन। <verse eid="EZR 3:5"/><verse number="6" style="v" sid="EZR 3:6"/>सातवां महिना के पहिले दिन ले ओमन यहोवा ला होम-बलिदान चघाय लगिन, हालाकि यहोवा के मंदिर के नीव तब तक नइं डारे गे रिहिस।<verse eid="EZR 3:6"/></para>
  <para style="s1">मंदिर ला फेर से बनई</para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 3:7"/>तब मनखेमन राज-मिसतिरीमन ला अऊ बढ़ईमन ला रूपिया, अऊ सीदोन अऊ सूर के मनखेमन ला खाय-पीये के चीज अऊ तेल दीन, ताकि ओमन फारस के राजा कुसरू के अनुमति के मुताबिक देवदार के लकरी लबानोन ले यापा तक समुंदर के जरिये अमरांय।<verse eid="EZR 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 3:8"/>दूसर बरस के दूसर महिना म परमेसर के भवन यरूसलेम म ओमन के हबरे के पाछू, सालतीएल के बेटा जरूब्बाबेल अऊ योसादाक के बेटा यहोसू अऊ बाकि मनखेमन (पुरोहित अऊ लेवी, अऊ जतेक बंधुवई ले यरूसलेम लहुंटे रिहिन) काम ला सुरू करिन। ओमन बीस बरस अऊ ओकर ले जादा उमर के लेवीमन ला यहोवा के भवन म काम के देखरेख करे बर नियुक्त करिन। <verse eid="EZR 3:8"/><verse number="9" style="v" sid="EZR 3:9"/>यहोसू अऊ ओकर बेटा अऊ भाईमन, अऊ कदमीएल अऊ ओकर बेटामन (होदवियाह के संतानमन) अऊ हेनादाद के बेटामन अऊ ओमन के बेटा अऊ भाईमन—सबो लेवीमन—परमेसर के भवन म कारीगरमन के काम के देखरेख करे बर एक संग जूरिन।<verse eid="EZR 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZR 3:10"/>जब भवन के बनइयामन यहोवा के मंदिर के नीव डारिन, तब अपन ओनहा पहिरे, अऊ तुरहीमन ला धरे पुरोहितमन, अऊ लेवीमन (आसाप के बेटामन) झांझमन ला धरके यहोवा के परसंसा करे बर अपन-अपन जगह ले लीन, जइसे कि इसरायल के राजा दाऊद के दुवारा बताय गे रिहिस। <verse eid="EZR 3:10"/><verse number="11" style="v" sid="EZR 3:11"/>परसंसा अऊ धनबाद के संग यहोवा बर अइसने गीत गाईन:</para>
  <para style="q1" vid="EZR 3:11">“ओह बने अय;</para>
  <para style="q2" vid="EZR 3:11">ओकर मया ह इसरायल बर हमेसा बने रहिथे।”</para>
  <para style="m" vid="EZR 3:11">तब जम्मो मनखेमन ये जानके कि यहोवा के भवन के नीव अब रखे जावत हे, अब्बड़ चिचियाके यहोवा के परसंसा करे लगिन। <verse eid="EZR 3:11"/><verse number="12" style="v" sid="EZR 3:12"/>पर कतको सियान पुरोहित अऊ लेवी अऊ परिवार के मुखियामन, जेमन पहिले के मंदिर ला देखे रिहिन, जब ये मंदिर के नीव ला रखत देखिन, त ओमन फूट-फूटके रोवन लगिन, अऊ कतको आने मनखेमन आनंद के मारे जय-जयकार करे लगिन। <verse eid="EZR 3:12"/><verse number="13" style="v" sid="EZR 3:13"/>एकरसेति मनखेमन, आनंद के जय-जयकार के सबद ले मनखेमन के रोये के सबद ला अलग पहिचान नइं सकिन, काबरकि मनखेमन बहुंत कोलाहल करत रिहिन। अऊ ओ अवाज ह दूरिहा तक सुनई देवत रिहिस।<verse eid="EZR 3:13"/></para>
  <chapter eid="EZR 3"/>
  <chapter number="4" style="c" sid="EZR 4"/>
  <para style="s1">मंदिर के फेर बनई के बिरोध</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 4:1"/>जब यहूदा अऊ बिनयामीन के बईरीमन ये सुनिन कि बंधुवई ले लहुंटे मनखेमन यहोवा, इसरायल के परमेसर बर एक मंदिर बनावत हवंय, <verse eid="EZR 4:1"/><verse number="2" style="v" sid="EZR 4:2"/>त ओमन जरूब्बाबेल अऊ परिवार के मुखिया मनखेमन करा आके ओमन ले कहन लगिन, “हमन ला घलो तुम्हर संग बनाय म मदद करे बर देवव, काबरकि तुम्हर सहीं, हमन घलो तुम्हर परमेसर के खोज म लगे हवन, अऊ अस्सूर के राजा एसरहदोन, जऊन ह हमन ला इहां अमराईस, ओकर दिन ले हमन ओ परमेसर ला बलिदान घलो चघावत हवन।”<verse eid="EZR 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 4:3"/>पर जरूब्बाबेल, यहोसू अऊ इसरायल के परिवारमन के मुखिया मनखेमन ओमन ला जबाब दीन, “हमर परमेसर बर भवन बनाय म, तुम्हर हमर संग कोनो संबंध नइं ए। हमीचमन एक संग मिलके फारस के राजा कुसरू के हुकूम के मुताबिक यहोवा, इसरायल के परमेसर बर येला बनाबो।”<verse eid="EZR 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZR 4:4"/>तब ओ देस के मनखेमन यहूदीमन ला निरास करे लगिन अऊ ओमन ला डरवाके मंदिर बनाय म बाधा डारन लगिन। <verse eid="EZR 4:4"/><verse number="5" style="v" sid="EZR 4:5"/>ओमन फारस के अधिकारीमन ला घूस दीन, ताकि ओमन ये काम म बाधा डालंय, फारस के राजा कुसरू के पूरा सासनकाल ले लेके फारस के राजा दारा के सासनकाल तक ओमन अइसने करते रिहिन।<verse eid="EZR 4:5"/></para>
  <para style="s1">बाद म छयर्स अऊ अर्तछयर्स के अगुवई म बिरोध</para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 4:6"/>छयर्स के राज के सुरू के दिन म, ओ मनखेमन यहूदा अऊ यरूसलेम के निवासीमन के बिरूध एक दोस-पतर लिखिन।<verse eid="EZR 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 4:7"/>अऊ फारस के राजा अर्तछयर्स के दिन म, बिसलाम, मिथरदात, ताबेल अऊ ओकर सहयोगीमन अर्तछयर्स ला एक ठन चिट्ठी लिखिन। चिट्ठी अरामिक अकछर अऊ अरामिक भासा म लिखे गीस।<verse eid="EZR 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 4:8"/>हुकूम देवइया अधिकारी रहूम अऊ सचिव सिमसै ह यरूसलेम के बिरूध राजा अर्तछयर्स ला ये किसम के चिट्ठी लिखिन:<verse eid="EZR 4:8"/></para>
  <para style="pmo">
    <verse number="9" style="v" sid="EZR 4:9"/>हुकूम देवइया अधिकारी रहूम अऊ सचिव सिमसै अऊ ओमन के आने जम्मो सहयोगीमन—फारस, ऊरूक अऊ बेबिलोन के मनखेमन ऊपर नियायधीस, अधिकारी अऊ सासन करइयामन, सूसन के एलामीमन, <verse eid="EZR 4:9"/><verse number="10" style="v" sid="EZR 4:10"/>अऊ आने मनखेमन, जेमन ला महान अऊ आदरनीय असूरबानीपाल ह बाहिर निकालके सामरिया सहर म अऊ फरात नदी के पार के देस म बसाय रिहिस।<verse eid="EZR 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 4:11"/>(जऊन चिट्ठी ओमन राजा ला भेजिन, ओकर येह नकल अय।)</para>
  <para style="pmo" vid="EZR 4:11">राजा अर्तछयर्स के सेवा म,</para>
  <para style="pmo" vid="EZR 4:11">तोर ओ सेवकमन ले, जेमन फरात नदी के ओ पार रहिथें:<verse eid="EZR 4:11"/></para>
  <para style="pm">
    <verse number="12" style="v" sid="EZR 4:12"/>राजा ला ये मालूम होवय कि जऊन यहूदीमन तोर करा ले हमर इहां आईन, ओमन यरूसलेम गे हवंय अऊ ओमन ओ बिदरोही अऊ दुस्ट सहर ला फेर बनावत हवंय। ओमन दीवारमन ला फेर ठाढ़ करत हवंय अऊ ओकर नीवमन ला मरम्मत करत हवंय।<verse eid="EZR 4:12"/></para>
  <para style="pm">
    <verse number="13" style="v" sid="EZR 4:13"/>राजा ला मालूम होवय कि कहूं ओ सहर ह बन गीस अऊ ओकर दीवारमन फेर बन गीन, तब ओमन कर, लगान, अऊ चुंगी फेर नइं दीहीं, अऊ आखिर म राजकर के हानि होही। <verse eid="EZR 4:13"/><verse number="14" style="v" sid="EZR 4:14"/>काबरकि राजमहल बर हमर जिम्मेदारी हवय अऊ हमर बर येह उचित नो हय कि हमर देखत म राजा के अनादर होवय, एकर खातिर हमन ये चिट्ठी पठोके राजा ला खबर देवत हन, <verse eid="EZR 4:14"/><verse number="15" style="v" sid="EZR 4:15"/>ताकि तोर पुरखामन के इतिहास के किताब म खोजे जावय। ये इतिहास के किताबमन म तोला मिलही कि ओ सहर ह एक बिदरोही सहर, राजा अऊ राजमन बर दुख देवइया सहर ए, अऊ ये जगह के बिदरोह करे के एक लम्बा इतिहास हवय। एकर खातिर ओ सहर ला नास कर देय गे रिहिस। <verse eid="EZR 4:15"/><verse number="16" style="v" sid="EZR 4:16"/>हमन राजा ला सूचना देवत हन कि यदि ओ सहर ला बनाय जाथे अऊ ओकर दीवारमन फेर ठाढ़ करे जाथें, त फेर तोर बर फरात नदी के पार कुछू नइं बचही।<verse eid="EZR 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZR 4:17"/>तब राजा ह ये जबाब भेजिस:</para>
  <para style="pmo" vid="EZR 4:17">हुकूम देवइया अधिकारी रहूम अऊ सचिव सिमसै अऊ सामरिया अऊ फरात नदी के पार आने जगह म रहइया ओमन के बाकि सहयोगीमन:</para>
  <para style="pmo" vid="EZR 4:17">तुम्हर कल्यान होवय।<verse eid="EZR 4:17"/></para>
  <para style="pm">
    <verse number="18" style="v" sid="EZR 4:18"/>जऊन चिट्ठी तुमन हमर करा पठोय हवव, ओला मोर आघू म पढ़के ओकर अनुवाद करे गीस। <verse eid="EZR 4:18"/><verse number="19" style="v" sid="EZR 4:19"/>मोर हुकूम ले जब खोजे गीस, त पता चलिस कि राजामन के बिरूध ओ सहर के बिदरोह करे के एक पुराना इतिहास हवय अऊ ये जगह म बिदरोह अऊ दंगा होवत आवत हे। <verse eid="EZR 4:19"/><verse number="20" style="v" sid="EZR 4:20"/>यरूसलेम म सामर्थी राजामन रिहिन, जेमन पूरा फरात नदी के पार तक राज करत रिहिन, अऊ कर, लगान, अऊ चुंगी ओमन ला दिये जावत रिहिस। <verse eid="EZR 4:20"/><verse number="21" style="v" sid="EZR 4:21"/>एकरसेति अब एक हुकूम दिये जावय कि ओ आदमीमन काम ला बंद करंय अऊ जब तक मोर कोति ले हुकूम नइं मिले, तब तक ओ सहर ला फेर झन बनाय जावय। <verse eid="EZR 4:21"/><verse number="22" style="v" sid="EZR 4:22"/>सचेत रहव, ये बात म ढिलई झन होवय। राज हित के हानि करे बर ये खतरा काबर बढ़न पाय?<verse eid="EZR 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZR 4:23"/>जइसे ही राजा अर्तछयर्स के चिट्ठी रहूम अऊ सचिव सिमसै अऊ ओमन के सहयोगीमन ला पढ़के सुनाय गीस, त ओमन तुरते यरूसलेम म यहूदीमन करा गीन अऊ ओमन ऊपर दबाव डालके काम ला रूकवा दीन।<verse eid="EZR 4:23"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="24" style="v" sid="EZR 4:24"/>ये किसम ले, यरूसलेम म परमेसर के भवन के काम ह रूक गीस, अऊ ये काम ह फारस के राजा दारा के राज के दूसर बरस तक रूके रिहिस।<verse eid="EZR 4:24"/></para>
  <chapter eid="EZR 4"/>
  <chapter number="5" style="c" sid="EZR 5"/>
  <para style="s1">दारा ला ततनै के चिट्ठी</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 5:1"/>तब हाग्गै अगमजानी अऊ इद्दो के एक संतान, जकरयाह अगमजानी ह यहूदा अऊ यरूसलेम के यहूदीमन बर इसरायल के परमेसर के नांव म अगमबानी करिन, जऊन ह ओमन के ऊपर रिहिस। <verse eid="EZR 5:1"/><verse number="2" style="v" sid="EZR 5:2"/>तब सालतीएल के बेटा जरूब्बाबेल अऊ योसादाक के बेटा यहोसू, यरूसलेम म परमेसर के भवन ला फेर बनाय के सुरू करिन। अऊ परमेसर के ओ अगमजानीमन ओमन ला सहारा देवत, ओमन के संग रिहिन।<verse eid="EZR 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 5:3"/>ओही बेरा, फरात नदी के पार के राजपाल ततनै, अऊ सतर-बोजनै अऊ ओमन के सहयोगीमन ओमन करा जाके ये पुछन लगिन, “ये मंदिर ला फेर बनाय अऊ ये काम ला पूरा करे के अधिकार तुमन ला कोन दीस?” <verse eid="EZR 5:3"/><verse number="4" style="v" sid="EZR 5:4"/>ओमन ये घलो पुछिन, “जऊन मन ये भवन ला बनावत हें, ओमन के नांव का अंय?” <verse eid="EZR 5:4"/><verse number="5" style="v" sid="EZR 5:5"/>पर यहूदीमन के अगुवामन ऊपर परमेसर के नजर रिहिस, एकरसेति जब तक ये बात के चरचा दारा ले नइं करे गीस अऊ ये बिसय म ओकर लिखित जबाब नइं मिलिस, तब तक ओमन ये काम ला नइं रोकिन।<verse eid="EZR 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 5:6"/>जऊन चिट्ठी फरात नदी के पार के राजपाल ततनै अऊ सतर-बोजनै अऊ ओमन के सहयोगी, फरात नदी के पार के अधिकारीमन राजा दारा करा पठोईन, ओकर नकल ये अय। <verse eid="EZR 5:6"/><verse number="7" style="v" sid="EZR 5:7"/>जऊन खबर ओमन भेजिन, ओमा ये लिखाय रिहिस:</para>
  <para style="pmo" vid="EZR 5:7">सेवा म राजा दारा:</para>
  <para style="pmo" vid="EZR 5:7">जय जोहार।<verse eid="EZR 5:7"/></para>
  <para style="pm">
    <verse number="8" style="v" sid="EZR 5:8"/>राजा ला मालूम होवय कि हमन यहूदा प्रदेस म महान परमेसर के मंदिर म गे रहेंन। मनखेमन ओला बड़े-बड़े पथरा ले बनात हवंय, अऊ ओकर दीवारमन म इमारती लकरी मढ़ात हवंय। ये काम ला बड़े मेहनत से करे जावत हे, अऊ ओमन के निरदेसन म ये काम तेजी से होवत हे।<verse eid="EZR 5:8"/></para>
  <para style="pm">
    <verse number="9" style="v" sid="EZR 5:9"/>हमन ओ अगुवामन ले सवाल करके पुछेंन, “ये मंदिर ला फेर बनाय के अऊ ये काम ला पूरा करे के अधिकार तुमन ला कोन दीस?” <verse eid="EZR 5:9"/><verse number="10" style="v" sid="EZR 5:10"/>हमन ओमन के नांव घलो पुछेंन ताकि हमन ओमन के अगुवामन के नांव लिखके तोला बता सकन।<verse eid="EZR 5:10"/></para>
  <para style="pm">
    <verse number="11" style="v" sid="EZR 5:11"/>ओमन हमन ला ये जबाब दीन:</para>
  <para style="b" vid="EZR 5:11"/>
  <para style="pm" vid="EZR 5:11">हमन तो अकास अऊ धरती के परमेसर के सेवक अन, अऊ ओ भवन ला बनात हन, जेह बहुंत साल पहिले बने रिहिस, जेला इसरायल के एक बड़े राजा ह बनाके तियार करे रिहिस। <verse eid="EZR 5:11"/><verse number="12" style="v" sid="EZR 5:12"/>पर जब हमर पुरखामन स्वरग के परमेसर ला कोरोध दिलाईन, तब ओह ओमन ला बेबिलोन के कसदी राजा नबूकदनेसर के हांथ म कर दीस, जऊन ह ये भवन ला नास कर दीस अऊ मनखेमन ला बंदी बनाके बेबिलोन ले गीस।<verse eid="EZR 5:12"/></para>
  <para style="pm">
    <verse number="13" style="v" sid="EZR 5:13"/>तभो ले, बेबिलोन के राजा कुसरू के पहिले बरस म, ओही कुसरू राजा ह परमेसर के इही भवन ला बनाय के हुकूम दीस। <verse eid="EZR 5:13"/><verse number="14" style="v" sid="EZR 5:14"/>परमेसर के भवन के जऊन सोन अऊ चांदी के बरतन नबूकदनेसर यरूसलेम के मंदिर म ले निकलवाके बेबिलोन के मंदिर म ले गेय रिहिस, ओमन ला राजा कुसरू ह बेबिलोन के मंदिर<note caller="+" style="f"><char style="fr" closed="false">5:14 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">महल</char></note> म ले निकलवाके सेसबसर नांव के एक मनखे ला सऊंप दीस, जेला ओह राजपाल ठहिराय रिहिस। <verse eid="EZR 5:14"/><verse number="15" style="v" sid="EZR 5:15"/>राजा ह ओकर ले कहिस, ये बरतनमन ला ले अऊ जाके येमन ला यरूसलेम के मंदिर म जमा कर दे। अऊ परमेसर के ओ भवन ला अपन जगह म फेर बना।<verse eid="EZR 5:15"/></para>
  <para style="pm">
    <verse number="16" style="v" sid="EZR 5:16"/>“तब सेसबसर ह आईस अऊ यरूसलेम म परमेसर के भवन के नीव डारिस। तब ले लेके अब तक येह बनत हवय, पर अब तक येह पूरा नइं बने हवय।”<verse eid="EZR 5:16"/></para>
  <para style="b"/>
  <para style="pm">
    <verse number="17" style="v" sid="EZR 5:17"/>अब यदि राजा ला बने लगे, त बेबिलोन के राज-भंडार म ये बात के खोज करे जावय कि राजा कुसरू ह सही म यरूसलेम म, परमेसर के भवन ला फेर बनाय के हुकूम देय रिहिस या नइं। तब राजा ह ये बिसय म अपन निरनय हमन ला बतावय।<verse eid="EZR 5:17"/></para>
  <chapter eid="EZR 5"/>
  <chapter number="6" style="c" sid="EZR 6"/>
  <para style="s1">राजा दारा के हुकूम</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 6:1"/>तब राजा दारा ह हुकूम दीस, अऊ ओमन बेबिलोन के खजाना म रखे राज-भंडार म खोज करिन। <verse eid="EZR 6:1"/><verse number="2" style="v" sid="EZR 6:2"/>मादै प्रदेस म एकबतना नगर के राजगढ़ म एक चामपट्टी<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="fq" closed="false">चामपट्टी </char><char style="ft" closed="false">येह चाम या रूख के छाली ले बने पन्ना रहय, जेला लपेटके रखे जावय</char></note> मिलिस, जेमा ये लिखाय रिहिस:</para>
  <para style="pmo" vid="EZR 6:2">सुरता करइया चिट्ठी:<verse eid="EZR 6:2"/></para>
  <para style="pm">
    <verse number="3" style="v" sid="EZR 6:3"/>राजा कुसरू ह अपन राज के पहिली बरस म, यरूसलेम म परमेसर के मंदिर के बारे म ये हुकूम दीस:</para>
  <para style="b" vid="EZR 6:3"/>
  <para style="pm" vid="EZR 6:3">बलिदान चघाय के जगह के रूप म मंदिर ला फेर बनाय जावय, अऊ ओकर नीव डाले जावय, ओकर ऊंचई साठ क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="ft" closed="false">लगभग 90 फीट</char></note> अऊ चौड़ई साठ क्यूबीट के होवय, <verse eid="EZR 6:3"/><verse number="4" style="v" sid="EZR 6:4"/>ओमा बड़े-बड़े पथरा के तीन परत अऊ लकड़ीमन के एक परत होवय। अऊ एकर खरचा साही खजाना ले दिये जावय। <verse eid="EZR 6:4"/><verse number="5" style="v" sid="EZR 6:5"/>अऊ परमेसर के भवन के जऊन सोन अऊ चांदी के चीजमन ला नबूकदनेसर ह यरूसलेम के मंदिर म ले निकलवाके बेबिलोन ले गेय रिहिस, ओमन ला लहुंटाके यरूसलेम के मंदिर म ओमन के जगह म रख दिये जावय; ओमन ला परमेसर के भवन म जमा करे जावय।<verse eid="EZR 6:5"/></para>
  <para style="b"/>
  <para style="pm">
    <verse number="6" style="v" sid="EZR 6:6"/>त अब हे फरात नदी के पार के राजपाल, ततनै, अऊ हे सतर-बोजनै अऊ ओ प्रदेस के आने अधिकारीमन, तुमन उहां ले दूरिहा रहव। <verse eid="EZR 6:6"/><verse number="7" style="v" sid="EZR 6:7"/>परमेसर के ये मंदिर के काम म बाधा झन डालव। यहूदीमन के राजपाल अऊ यहूदीमन के अगुवामन ला परमेसर के ओ भवन ला ओही जगह म बनावन दव।<verse eid="EZR 6:7"/></para>
  <para style="pm">
    <verse number="8" style="v" sid="EZR 6:8"/>येकर अलावा, मेंह हुकूम देवत हंव कि तुमन ला यहूदीमन के ओ अगुवामन बर परमेसर के मंदिर बनाय म का करना हे:</para>
  <para style="pm" vid="EZR 6:8">ओमन के पूरा खरचा ह साही खजाना, फरात नदी के पार के मालगुजारी ले देय जावय, ताकि काम ह झन रूकय। <verse eid="EZR 6:8"/><verse number="9" style="v" sid="EZR 6:9"/>जऊन भी चीज के जरूरत हवय—स्वरग के परमेसर ला होम-बलिदान चघाय बर बछवा, मेढ़ा, मेढ़ा-पीला, अऊ यरूसलेम म पुरोहितमन के दुवारा मांगे गय गहूं, नून, अंगूर के मंद अऊ जैतून तेल—ये जम्मो चीज ओमन ला बिगर भूले रोज दिये जावय, <verse eid="EZR 6:9"/><verse number="10" style="v" sid="EZR 6:10"/>ताकि ओमन स्वरग के परमेसर ला सुख-देवइया बलिदान चघा सकंय अऊ राजा अऊ ओकर बेटामन के भलई बर पराथना कर सकंय।<verse eid="EZR 6:10"/></para>
  <para style="pm">
    <verse number="11" style="v" sid="EZR 6:11"/>मेंह ये हुकूम भी देवत हंव कि यदि कोनो ये हुकूम ला नइं मानही, त ओकर घर म ले एक बल्ला खींचके निकाले जावय अऊ ओमा ओला टांग दिये जावय। अऊ ओकर ये अपराध के कारन ओकर घर ला कचरा के घूरवा बना दिये जावय। <verse eid="EZR 6:11"/><verse number="12" style="v" sid="EZR 6:12"/>परमेसर, जेह उहां अपन नांव के निवास ठहिराय हवय, ओह ओ राजा या मनखे ला नास करय, जऊन ह ये हुकूम ला बदले के कोसिस करथे या यरूसलेम म ये मंदिर ला नास करे बर हांथ बढ़ाथे।</para>
  <para style="pm" vid="EZR 6:12">में, दारा ह ये हुकूम देवत हंव। धियान से येकर पालन करे जावय।<verse eid="EZR 6:12"/></para>
  <para style="s1">मंदिर बनई के पूरा होवई अऊ समरपन</para>
  <para style="p">
    <verse number="13" style="v" sid="EZR 6:13"/>तब, राजा दारा के हुकूम देय के कारन, ततनै, फरात नदी के पार के राजपाल, अऊ सतर-बोजनै अऊ ओमन के सहयोगीमन धियान देके ओ हुकूम के पालन करिन। <verse eid="EZR 6:13"/><verse number="14" style="v" sid="EZR 6:14"/>तब यहूदीमन के अगुवामन मंदिर ला फेर बनाय के काम ला जारी रखिन अऊ हाग्गै अगमजानी अऊ इद्दो के एक संतान जकरयाह के अधीन काम करत ओमन उन्नति करत गीन। ओमन इसरायल के परमेसर के हुकूम मुताबिक अऊ फारस के राजा कुसरू, दारा, अऊ अर्तछयर्स के हुकूम के मुताबिक मंदिर बनाय के काम ला पूरा करिन। <verse eid="EZR 6:14"/><verse number="15" style="v" sid="EZR 6:15"/>मंदिर के काम ह राजा दारा के राज के छठवां बछर के अदार महिना के तीसरा दिन म पूरा होईस।<verse eid="EZR 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZR 6:16"/>तब इसरायल के मनखेमन—पुरोहित, लेवी अऊ आने जतेक बंधुवई ले आय रिहिन, ओ जम्मो आनंद के साथ परमेसर के ओ भवन के समरपन के उत्सव मनाईन। <verse eid="EZR 6:16"/><verse number="17" style="v" sid="EZR 6:17"/>परमेसर के ये भवन के समरपन म, ओमन एक सौ बईला, दू सौ मेढ़ा, चार सौ मेढ़ा-पीला चघाईन अऊ जम्मो इसरायल के हित बर पाप-बलिदान<note caller="+" style="f"><char style="fr" closed="false">6:17 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सुधिकरन-बलिदान</char></note> के रूप म बारह ठन बोकरा याने कि इसरायल के हर एक गोत्र बर एक-एक ठन बोकरा चघाईन। <verse eid="EZR 6:17"/><verse number="18" style="v" sid="EZR 6:18"/>तब जइसने मूसा के किताब म लिखाय हवय, वइसनेच ओमन यरूसलेम म परमेसर के सेवा बर अपन-अपन बिभाग म पुरोहितमन ला अऊ अपन-अपन दल म लेवीमन ला नियुक्त करिन।<verse eid="EZR 6:18"/></para>
  <para style="s1">फसह के तिहार</para>
  <para style="p">
    <verse number="19" style="v" sid="EZR 6:19"/>बंधुवई ले लहुंटे के बाद पहिला महिना के चौदहवां दिन, ओमन फसह तिहार मानिन। <verse eid="EZR 6:19"/><verse number="20" style="v" sid="EZR 6:20"/>पुरोहित अऊ लेवीमन अपन ला सुध करे रिहिन अऊ संस्कारिक रूप ले ओ जम्मो झन सुध रिहिन। लेवीमन बंधुवई ले लहुंटे जम्मो झन बर, ओमन के रिस्तेदार पुरोहितमन बर अऊ अपनआप बर फसह के मेढ़ा-पीला के बलि करिन। <verse eid="EZR 6:20"/><verse number="21" style="v" sid="EZR 6:21"/>तब बंधुवई ले लहुंटे इसरायलीमन ओ जम्मो झन के संग येला खाईन, जेमन अपनआप ला अपन आनजात परोसी के असुध काम ले अलग कर ले रिहिन, ताकि ओमन यहोवा, इसरायल के परमेसर के खोज करंय। <verse eid="EZR 6:21"/><verse number="22" style="v" sid="EZR 6:22"/>ओमन अखमीरी रोटी के तिहार ला सात दिन तक आनंद के साथ मनाईन, काबरकि यहोवा ह अस्सूर के राजा के मन ला ओमन कोति करके ओमन ला आनंदित करे रिहिस, जेकर कारन राजा ह परमेसर, इसरायल के परमेसर के भवन के काम म ओमन के मदद करिस।<verse eid="EZR 6:22"/></para>
  <chapter eid="EZR 6"/>
  <chapter number="7" style="c" sid="EZR 7"/>
  <para style="s1">एजरा के यरूसलेम अवई</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 7:1"/>ये घटनामन के बाद, फारस के राजा अर्तछयर्स के राज के समय, एजरा ह आईस। एजरा ह सरायाह के बेटा, सरायाह ह अजरयाह के बेटा, अजरयाह ह हिलकियाह के बेटा, <verse eid="EZR 7:1"/><verse number="2" style="v" sid="EZR 7:2"/>हिलकियाह ह सल्लूम के, सल्लूम ह सादोक के, सादोक ह अहीतूब के, <verse eid="EZR 7:2"/><verse number="3" style="v" sid="EZR 7:3"/>अहीतूब ह अमरयाह के, अमरयाह ह अजरयाह के, अजरयाह ह मरायोत के, <verse eid="EZR 7:3"/><verse number="4" style="v" sid="EZR 7:4"/>मरायोत ह जरहयाह के, जरहयाह ह उज्जी के, उज्जी ह बुक्की के, <verse eid="EZR 7:4"/><verse number="5" style="v" sid="EZR 7:5"/>बुक्की ह अबीसू के, अबीसू ह पीनहास के, पीनहास ह एलिआजर के अऊ एलिआजर ह हारून मुखिया पुरोहित के बेटा रिहिस। <verse eid="EZR 7:5"/><verse number="6" style="v" sid="EZR 7:6"/>येहीच एजरा ह बेबिलोन ले आईस। ओह एक गुरूजी रिहिस अऊ मूसा के ओ कानून के बने जानकार रिहिस, जेला यहोवा, इसरायल के परमेसर ह देय रिहिस। यहोवा ओकर परमेसर के हांथ ओकर ऊपर रिहिस, जेकर कारन राजा ह ओला ओ जम्मो चीज देय रिहिस, जेकर मांग ओह करिस। <verse eid="EZR 7:6"/><verse number="7" style="v" sid="EZR 7:7"/>कुछू इसरायली अऊ संग म कुछू पुरोहित, लेवी, संगीतकार, दुवारपाल अऊ मंदिर के सेवकमन घलो राजा अर्तछयर्स के राज के सातवां बरस म यरूसलेम आईन।<verse eid="EZR 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 7:8"/>एजरा ह राजा के सासनकाल के सातवां बरस के पांचवां महिना म यरूसलेम हबरिस। <verse eid="EZR 7:8"/><verse number="9" style="v" sid="EZR 7:9"/>ओह बेबिलोन ले ओ सातवां बछर के पहिला महिना के पहिला दिन अपन यातरा सुरू करे रिहिस, अऊ ओह पांचवां महिना के पहिला दिन यरूसलेम हबर गीस, काबरकि ओकर परमेसर के अनुग्रहकारी हांथ ओकर ऊपर रिहिस। <verse eid="EZR 7:9"/><verse number="10" style="v" sid="EZR 7:10"/>एजरा ह यहोवा के कानून के अध्ययन करे बर अऊ ओकर अनुसार चले बर, अऊ इसरायल म ओकर बिधि अऊ कानून ला सिखाय बर अपन मन ला लगाय रिहिस।<verse eid="EZR 7:10"/></para>
  <para style="s1">राजा अर्तछयर्स के चिट्ठी एजरा बर</para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 7:11"/>येह ओ चिट्ठी के नकल अय, जेला राजा अर्तछयर्स ह एजरा पुरोहित ला देय रिहिस, जऊन ह कानून के एक गुरू, अऊ इसरायलीमन बर यहोवा के हुकूम अऊ बिधिमन के एक बने जानकार रिहिस:<verse eid="EZR 7:11"/></para>
  <para style="pmo">
    <verse number="12" style="v" sid="EZR 7:12"/>महाराजाधिराज, अर्तछयर्स कोति ले</para>
  <para style="pmo" vid="EZR 7:12">एजरा पुरोहित के नांव, जऊन ह स्वरग के परमेसर के कानून के गुरू अय:</para>
  <para style="pmo" vid="EZR 7:12">तोर कल्यान होवय।<verse eid="EZR 7:12"/></para>
  <para style="pm">
    <verse number="13" style="v" sid="EZR 7:13"/>मेंह ये हुकूम देवत हंव कि मोर राज ले जतेक इसरायली अऊ ओमन के संग जतेक पुरोहित अऊ लेवीमन अपन ईछा ले यरूसलेम जाय चाहत हें, ओमन तोर संग जा सकत हें। <verse eid="EZR 7:13"/><verse number="14" style="v" sid="EZR 7:14"/>तोला राजा अऊ ओकर सातों सलाहकारमन कोति ले एकरसेति पठोय जावत हे कि अपन परमेसर के कानून के बात जऊन ह तोर करा हवय, यहूदा प्रदेस अऊ यरूसलेम सहर के बारे म मालूम कर, <verse eid="EZR 7:14"/><verse number="15" style="v" sid="EZR 7:15"/>अऊ तेंह ओ सोन अऊ चांदी ला ले जा, जेला राजा अऊ ओकर सलाहकारमन अपन ईछा से इसरायल के परमेसर ला देय हवंय, जेकर निवास यरूसलेम म हवय, <verse eid="EZR 7:15"/><verse number="16" style="v" sid="EZR 7:16"/>अऊ जतेक सोन अऊ चांदी पूरा बेबिलोन प्रदेस म तोला मिलही, अऊ संग म ओ स्वेच्छा-बलिदानमन ला घलो ले जा, जऊन ला मनखे अऊ पुरोहितमन यरूसलेम के ओमन के परमेसर के मंदिर बर देथें। <verse eid="EZR 7:16"/><verse number="17" style="v" sid="EZR 7:17"/>ये धन ले सावधानी के संग बईला, मेढ़ा अऊ मेढ़ा-पीलामन के संग ओमन के अन्न-बलिदान अऊ पेय-बलिदान के चीजमन ला बिसा लेबे, अऊ ओमन ला यरूसलेम म तोर परमेसर के मंदिर के बेदी ऊपर चघाबे।<verse eid="EZR 7:17"/></para>
  <para style="pm">
    <verse number="18" style="v" sid="EZR 7:18"/>तब जऊन सोन अऊ चांदी बांच जाही, ओकर उपयोग तें अऊ तोर संगी इसरायलीमन जइसे उचित जान पड़ही, अपन परमेसर के ईछा के मुताबिक कर सकत हव। <verse eid="EZR 7:18"/><verse number="19" style="v" sid="EZR 7:19"/>ओ जम्मो चीज यरूसलेम के परमेसर ला दे देवव, जेमन ला तोर परमेसर के मंदिर म अराधना करे बर तोला सऊंपे जावत हवंय। <verse eid="EZR 7:19"/><verse number="20" style="v" sid="EZR 7:20"/>यदि तोर परमेसर के मंदिर बर अऊ कोनो चीज के जरूरत होही, जेकर पूरती करे के जिम्मेदारी तोर अय, त ओला तेंह साही खजाना म ले देय सकत हस।<verse eid="EZR 7:20"/></para>
  <para style="pm">
    <verse number="21" style="v" sid="EZR 7:21"/>में, राजा अर्तछयर्स, ये हुकूम देवत हंव कि फरात नदी के पार के जम्मो खजांचीमन धियान देके ओ जम्मो चीज ला देवंय, जेकर मांग एजरा पुरोहित, स्वरग के परमेसर के कानून के गुरू ह करथे— <verse eid="EZR 7:21"/><verse number="22" style="v" sid="EZR 7:22"/>याने सौ टेलेन्ट<note caller="+" style="f"><char style="fr" closed="false">7:22 </char><char style="ft" closed="false">लगभग पौने 4 टन</char></note> तक चांदी, सौ कोर<note caller="+" style="f"><char style="fr" closed="false">7:22 </char><char style="ft" closed="false">लगभग 18 टन</char></note> तक गहूं, सौ बत<note caller="+" style="f"><char style="fr" closed="false">7:22 </char><char style="ft" closed="false">लगभग 2,200 लीटर</char></note> तक अंगूर के मंद, सौ बत<note caller="+" style="f" category="dup"><char style="fr" closed="false">7:22 </char><char style="ft" closed="false">लगभग 2,200 लीटर</char></note> तक जैतून तेल, अऊ नून जतेक चाही ओतेक देय जावय। <verse eid="EZR 7:22"/><verse number="23" style="v" sid="EZR 7:23"/>जऊन भी हुकूम स्वरग के परमेसर कोति ले मिले हवय, ओला धियान देके स्वरग के परमेसर के मंदिर बर पूरा करे जावय। राजा अऊ ओकर राजकुमारमन के राज ऊपर परमेसर के कोरोध काबर भड़कय? <verse eid="EZR 7:23"/><verse number="24" style="v" sid="EZR 7:24"/>तुमन ला ये घलो मालूम होवय कि तुमन ला परमेसर के ओ भवन के कोनो पुरोहित, लेवी, संगीतकार, दुवारपाल, मंदिर के सेवक या आने काम करइयामन ले कर, लगान, या चुंगी लेय के कोनो अधिकार नइं ए।<verse eid="EZR 7:24"/></para>
  <para style="pm">
    <verse number="25" style="v" sid="EZR 7:25"/>अऊ हे एजरा! तोर परमेसर के बुद्धि के मुताबिक, जऊन ह कि तोर म हवय, तें जिलाधीस अऊ नियायधीसमन ला नियुक्त कर, जेमन फरात नदी के पार के जम्मो मनखेमन ऊपर नियाय के संग सासन करंय—ओ जम्मो जेमन तोर परमेसर के कानून ला जानथें। अऊ यदि कोनो ये कानूनमन ला नइं जानत हे, त तें ओला ये कानून सिखा। <verse eid="EZR 7:25"/><verse number="26" style="v" sid="EZR 7:26"/>जऊन कोनो तोर परमेसर के कानून अऊ राजा के कानून ला नइं मानही, त ओला खचित परानदंड, देस निकाला, ओकर माल जपत करई, या कैद के सजा देय जावय।<verse eid="EZR 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EZR 7:27"/>यहोवा, हमर पुरखामन के परमेसर के परसंसा होवय, जऊन ह राजा के मन म ये बात डालिस कि ये किसम ले यरूसलेम म यहोवा के भवन बर आदर के काम होवय <verse eid="EZR 7:27"/><verse number="28" style="v" sid="EZR 7:28"/>अऊ जऊन ह राजा अऊ ओकर सलाहकार अऊ राजा के जम्मो बड़े अधिकारीमन के आघू म मोर बर बड़े दया देखाय हवय। काबरकि यहोवा मोर परमेसर के हांथ मोर ऊपर रिहिस, एकरसेति मेंह हिम्मत करंय, अऊ इसरायल के अगुवामन ला मोर संग जाय बर इकट्ठा करंय।<verse eid="EZR 7:28"/></para>
  <chapter eid="EZR 7"/>
  <chapter number="8" style="c" sid="EZR 8"/>
  <para style="s1">एजरा संग लहुंटइया मुखियामन के सूची</para>
  <para style="lh">
    <verse number="1" style="v" sid="EZR 8:1"/>येह परिवारमन के मुखिया अऊ ओमन के संग लिखे गय मनखेमन के नांव के सूची अय, जेमन राजा अर्तछयर्स के राज म बेबिलोन ले मोर संग यरूसलेम गीन:<verse eid="EZR 8:1"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="2" style="v" sid="EZR 8:2"/>पीनहास के बंस म ले:</para>
  <para style="li2" vid="EZR 8:2">गेरसोम;</para>
  <para style="li1" vid="EZR 8:2">ईतामार के बंस म ले:</para>
  <para style="li2" vid="EZR 8:2">दानिएल;</para>
  <para style="li1" vid="EZR 8:2">दाऊद के बंस म ले:</para>
  <para style="li2" vid="EZR 8:2">हतूस <verse eid="EZR 8:2"/><verse number="3" style="v" sid="EZR 8:3"/>सेकनयाह के बंस के;</para>
  <para style="li1" vid="EZR 8:3">परोस के बंस म ले:</para>
  <para style="li2" vid="EZR 8:3">जकरयाह, अऊ ओकर संग 150 आदमीमन के नांव लिखे गे रिहिस;<verse eid="EZR 8:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="EZR 8:4"/>पहत-मोआब के बंस म ले:</para>
  <para style="li2" vid="EZR 8:4">जरहयाह के बेटा एलिहोएनै, अऊ ओकर संग 200 आदमी;<verse eid="EZR 8:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="EZR 8:5"/>जत्तू के बंस म ले:</para>
  <para style="li2" vid="EZR 8:5">यहजीएल के बेटा सेकनयाह, अऊ ओकर संग 300 आदमी;<verse eid="EZR 8:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="EZR 8:6"/>आदीन के बंस म ले:</para>
  <para style="li2" vid="EZR 8:6">योनातन के बेटा एबेद, अऊ ओकर संग 50 आदमी;<verse eid="EZR 8:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="EZR 8:7"/>एलाम के बंस म ले:</para>
  <para style="li2" vid="EZR 8:7">अतलयाह के बेटा येसायाह, अऊ ओकर संग 70 आदमी;<verse eid="EZR 8:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="EZR 8:8"/>सपतयाह के बंस म ले:</para>
  <para style="li2" vid="EZR 8:8">मिकाएल के बेटा जबदयाह, अऊ ओकर संग 80 आदमी;<verse eid="EZR 8:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="EZR 8:9"/>योआब के बंस म ले:</para>
  <para style="li2" vid="EZR 8:9">यहीएल के बेटा ओबदयाह, अऊ ओकर संग 218 आदमी;<verse eid="EZR 8:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="EZR 8:10"/>बानी के बंस म ले:</para>
  <para style="li2" vid="EZR 8:10">योसिवियाह के बेटा सलोमीत, अऊ ओकर संग 160 आदमी;<verse eid="EZR 8:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="EZR 8:11"/>बेबै के बंस म ले:</para>
  <para style="li2" vid="EZR 8:11">बेबै के बेटा जकरयाह, अऊ ओकर संग 28 आदमी;<verse eid="EZR 8:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="EZR 8:12"/>अजगाद के बंस म ले:</para>
  <para style="li2" vid="EZR 8:12">हक्कातान के बेटा योहानान, अऊ ओकर संग 110 आदमी;<verse eid="EZR 8:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="EZR 8:13"/>अदोनीकाम के बंस म ले:</para>
  <para style="li2" vid="EZR 8:13">आखिरी के मनखेमन, जेमन के नांव एलीपेलेत, यूएल, अऊ समायाह, अऊ ओमन के संग 60 आदमी;<verse eid="EZR 8:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="EZR 8:14"/>बिगवै के बंस म ले:</para>
  <para style="li2" vid="EZR 8:14">ऊतै अऊ जक्कूर, अऊ ओमन के संग 70 आदमी।<verse eid="EZR 8:14"/></para>
  <para style="s1">यरूसलेम लहुंटई</para>
  <para style="p">
    <verse number="15" style="v" sid="EZR 8:15"/>मेंह येमन ला नहर मेर इकट्ठा कर लेंव, जऊन ह अहवा सहर कोति बहथे, अऊ उहां हमन तीन दिन तक डेरा डाले रहेंन। अऊ मेंह मनखे अऊ पुरोहितमन के बीच जांच करेंव, त मोला उहां कोनो लेवी नइं मिलिन। <verse eid="EZR 8:15"/><verse number="16" style="v" sid="EZR 8:16"/>एकरसेति मेंह एलिएजेर, अरीएल, समायाह, एलनातान, यारीब, एलनातान, नातान, जकरयाह अऊ मसुल्लाम ला जऊन मन अगुवा रिहिन, अऊ योयारीब अऊ एलनातान ला, जेमन गियानी रिहिन, बुलवा लेंव, <verse eid="EZR 8:16"/><verse number="17" style="v" sid="EZR 8:17"/>अऊ मेंह ओमन ला कासिपिया म अगुवा, इद्दो मेर जाय के हुकूम देंव। मेंह ओमन ला समझा देंव कि कासिपिया म इद्दो अऊ ओकर संगी लेवी, मंदिर के सेवकमन ले का कहना हे, ताकि ओमन हमर करा हमर परमेसर के भवन बर सेवकमन ला लेके आवंय। <verse eid="EZR 8:17"/><verse number="18" style="v" sid="EZR 8:18"/>काबरकि हमर परमेसर के अनुग्रहकारी हांथ हमर ऊपर रिहिस, ओमन सेरेबियाह, एक योग्य मनखे, महली के संतान ला हमर करा लानिन; महली ह लेवी के बेटा अऊ लेवी ह इसरायल के बेटा रिहिस; सेरेबियाह के बेटा अऊ भाईमन, सब मिलाके 18 झन; <verse eid="EZR 8:18"/><verse number="19" style="v" sid="EZR 8:19"/>अऊ हसबियाह, अऊ ओकर संग मरारी के संतान म ले येसायाह, अऊ ओकर भाई अऊ भतीजामन, सब मिलाके 20 झन। <verse eid="EZR 8:19"/><verse number="20" style="v" sid="EZR 8:20"/>ओमन 220 मंदिर के सेवकमन ला घलो लानिन—एक समूह जेकर स्थापना दाऊद अऊ अधिकारीमन करे रिहिन, ताकि ये समूह ह लेवीमन के मदद करय। ये जम्मो के नांव सूची म लिखाय रिहिस।<verse eid="EZR 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZR 8:21"/>उहां, अहवा नहर के तीर म, मेंह उपास रखे के घोसना करेंव, ताकि हमन अपनआप ला हमर परमेसर के आघू म दीन करन; अऊ ओकर ले यातरा के दौरान अपन अऊ अपन लइका अऊ अपन जम्मो संपत्ति बर सुरकछा के पराथना करन। <verse eid="EZR 8:21"/><verse number="22" style="v" sid="EZR 8:22"/>रसता के बईरीमन ले सुरकछा पाय बर राजा ले सैनिक अऊ घुड़सवारमन के मांग करे म मोला संकोच होवत रिहिस, काबरकि हमन राजा ले ये कहे रहेंन, “हमर परमेसर के अनुग्रहकारी हांथ ओ हर एक मनखे ऊपर हवय, जऊन ह ओला खोजथे, पर ओकर भयंकर कोरोध ओ जम्मो ऊपर भड़कथे, जेमन ओला तियाग देथें।” <verse eid="EZR 8:22"/><verse number="23" style="v" sid="EZR 8:23"/>एकरसेति हमन उपास करेंन अऊ येकर बारे म हमन अपन परमेसर ले पराथना करेंन, अऊ ओह हमर पराथना के जबाब दीस।<verse eid="EZR 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZR 8:24"/>तब मेंह अगुवा पुरोहितमन म ले बारह झन ला अलग करेंव, अऊ येमन सेरेबियाह, हसबियाह अऊ येमन के दस भाईमन रिहिन, <verse eid="EZR 8:24"/><verse number="25" style="v" sid="EZR 8:25"/>अऊ मेंह ओमन ला ओ सोन अऊ चांदी अऊ ओ जम्मो चीजमन ला तऊलके दे देंव, जेला राजा, ओकर सलाहकार, ओकर अधिकारी अऊ उहां उपस्थित जम्मो इसरायलीमन हमर परमेसर के भवन बर भेंट म देय रिहिन। <verse eid="EZR 8:25"/><verse number="26" style="v" sid="EZR 8:26"/>मेंह ओमन ला तऊलके 650 टेलेन्ट<note caller="+" style="f"><char style="fr" closed="false">8:26 </char><char style="ft" closed="false">लगभग 24 टन</char></note> चांदी, 100 टेलेन्ट<note caller="+" style="f"><char style="fr" closed="false">8:26 </char><char style="ft" closed="false">लगभग पौने 4 टन</char></note> चांदी के सामान, 100 टेलेन्ट सोन, <verse eid="EZR 8:26"/><verse number="27" style="v" sid="EZR 8:27"/>सोन के 20 कटोरा, जेमन के कीमत 1,000 दरकमोन<note caller="+" style="f"><char style="fr" closed="false">8:27 </char><char style="ft" closed="false">लगभग 8.4 किलोग्राम</char></note> रिहिस, अऊ सोन के सहीं कीमती चमकत कांसा के दू ठन सुघर सामान देंव।<verse eid="EZR 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EZR 8:28"/>मेंह ओमन ले कहेंव, “तुमन अऊ संग म ये सामान घलो यहोवा बर पबितर करे गे हवंव। ये सोन अऊ चांदी यहोवा, तुम्हर पुरखामन के परमेसर बर एक स्वेच्छा-बलिदान अंय। <verse eid="EZR 8:28"/><verse number="29" style="v" sid="EZR 8:29"/>एकरसेति धियान देके येमन के पहरेदारी करव, जब तक कि तुमन ये चीजमन ला यरूसलेम म अगुवा पुरोहित अऊ लेवी अऊ इसरायल के परिवार के मुखियामन के आघू म यहोवा के भवन के कोठरीमन म तऊलके नइं दे दव।” <verse eid="EZR 8:29"/><verse number="30" style="v" sid="EZR 8:30"/>तब पुरोहित अऊ लेवीमन सोन अऊ चांदी अऊ ओ पबितर सामान ला तऊलके ले लीन ताकि ओमन ला यरूसलेम म हमर परमेसर के भवन म अमरा देवंय।<verse eid="EZR 8:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EZR 8:31"/>पहिला महिना के बारहवां दिन, हमन अहवा नहर ले यरूसलेम जाय बर निकलेंन। हमर परमेसर के हांथ हमर ऊपर रिहिस, अऊ ओह रसता म हमन ला बईरी अऊ डाकूमन ले बचाईस। <verse eid="EZR 8:31"/><verse number="32" style="v" sid="EZR 8:32"/>आखिर म हमन यरूसलेम हबरेंन अऊ उहां तीन दिन अराम करेंन।<verse eid="EZR 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EZR 8:33"/>उहां हबरे के चऊथा दिन, हमर परमेसर के भवन म, हमन ओ सोन अऊ चांदी अऊ पबितर चीजमन ला तऊलके उरियाह के बेटा मरेमोत पुरोहित के हांथ म देंन। ओकर संग पीनहास के बेटा एलिआजर रिहिस, अऊ वइसने ही ओमन के संग लेवीमन याने येहोसू के बेटा योजाबाद अऊ बिन्नूई के बेटा नोअदियाह घलो रिहिन। <verse eid="EZR 8:33"/><verse number="34" style="v" sid="EZR 8:34"/>ओ जम्मो चीजमन गने अऊ तऊले गीन, अऊ ओमन के पूरा वजन ओ बेरा लिख लिये गीस।<verse eid="EZR 8:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EZR 8:35"/>तब जेमन बंधुवई ले लहुंटके आय रिहिन, ओमन इसरायल के परमेसर बर होम-बलिदान चघाईन: जम्मो इसरायल बर बारह ठन बछवा, छियानबे मेढ़ा अऊ सतहत्तर मेढ़ा-पीला, अऊ पाप-बलिदान बर बारह ठन बोकरा। ये जम्मो यहोवा बर एक होम-बलिदान रिहिस। <verse eid="EZR 8:35"/><verse number="36" style="v" sid="EZR 8:36"/>ओमन राजा के हुकूम घलो फरात नदी के पार के साही हाकिम अऊ राजपालमन ला दीन, जेमन तब इसरायली मनखेमन ला अऊ संग म परमेसर के भवन बर मदद करिन।<verse eid="EZR 8:36"/></para>
  <chapter eid="EZR 8"/>
  <chapter number="9" style="c" sid="EZR 9"/>
  <para style="s1">दिगर-जात बिहाव के बारे म एजरा के पराथना</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 9:1"/>ये बातमन के पूरा होय के बाद, अगुवामन मोर करा आके कहिन, “इसरायल के मनखेमन, संग म पुरोहित अऊ लेवीमन अपनआप ला परोसी मनखे कनानी, हित्ती, परिज्जी, यबूसी, अमोनी, मोआबी, मिसरी अऊ अमोरीमन के घिनित काममन ले अलग नइं रखे हवंय। <verse eid="EZR 9:1"/><verse number="2" style="v" sid="EZR 9:2"/>येमन ओमन के कुछू बेटीमन ला अपन अऊ अपन बेटामन के घरवाली बना ले हवंय, अऊ पबितर जाति ला अपन आसपास के मनखेमन संग मिला ले हवंय। अऊ अगुवा अऊ करमचारीमन ये बिसवासघात के काम म अगुवई करे हवंय।”<verse eid="EZR 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 9:3"/>जब मेंह ये बात ला सुनेंव, त मेंह निरासा म अपन कपड़ा अऊ बागा ला चीरेंव, अपन मुड़ के बाल अऊ दाढ़ी ला चीथेंव अऊ निरास होके उहां खाल्हे बईठ गेंव। <verse eid="EZR 9:3"/><verse number="4" style="v" sid="EZR 9:4"/>तब बंधुवई म ले आय मनखेमन के ये बिसवासघात के कारन ओ मनखे जेमन इसरायल के परमेसर के बचन ला सुनके कांप गे रिहिन, ओमन मोर चारों कोति जमा हो गीन। अऊ मेंह निरास होके सांझ के बलिदान के समय तक उहां बईठे रहेंव।<verse eid="EZR 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 9:5"/>तब, सांझ के बलिदान के बेरा, मेंह अपन खुद के बेजत्ती के दसा ले उठेंव, मोर कपड़ा अऊ बागा फटे रहंय, अऊ मेंह माड़ी टेकके अपन हांथमन ला यहोवा अपन परमेसर कोति उठांय <verse eid="EZR 9:5"/><verse number="6" style="v" sid="EZR 9:6"/>अऊ ये पराथना करेंव:</para>
  <para style="pm" vid="EZR 9:6">“हे मोर परमेसर, मेंह अतेक अपमानित अऊ कलंकित महसूस करत हंव कि मेंह तोर कोति अपन चेहरा नइं कर सकंव, काबरकि हमर पापमन हमर मुड़ के घलो ऊपर चले गे हवंय अऊ हमर अपराध ह अकास तक हबर गे हवय। <verse eid="EZR 9:6"/><verse number="7" style="v" sid="EZR 9:7"/>हमर पुरखामन के समय ले लेके अब तक, हमन घोर अपराध करे हन। हमर पाप के कारन, हमन अऊ हमर राजा अऊ हमर पुरोहितमन ला आने राजामन के तलवार, बंधुवई, लूट अऊ अपमान के सामना करे पड़िस, जइसे कि आज घलो दिखत हे।<verse eid="EZR 9:7"/></para>
  <para style="pm">
    <verse number="8" style="v" sid="EZR 9:8"/>“पर अब, कुछू समय बर, यहोवा हमर परमेसर ह हमन ला मनखेमन के एक बांचे भाग अऊ पबितर-स्थान म एक इस्थिर जगह देय के दुवारा हमर ऊपर अनुग्रह करे हवय, अऊ ये किसम ले हमर परमेसर ह हमर आंखी ला अंजोर अऊ हमर बंधुवई म हमन ला थोरकन मदद देय हवय। <verse eid="EZR 9:8"/><verse number="9" style="v" sid="EZR 9:9"/>हालाकि हमन गुलाम अन, पर हमर परमेसर ह हमन ला हमर बंधुवई म नइं तियागे हवय। ओह फारस के राजामन के नजर म हमर ऊपर दया देखाय हवय: ओह हमन ला नवां जिनगी देय हवय कि हमन अपन परमेसर के घर ला फेर बनावन अऊ येकर खंडहरमन ला सुधारन, अऊ ओह हमन ला यहूदा अऊ यरूसलेम म सुरकछा के एक दीवार देय हवय।<verse eid="EZR 9:9"/></para>
  <para style="pm">
    <verse number="10" style="v" sid="EZR 9:10"/>“पर हे हमर परमेसर, अब हमन येकर बाद का कह सकथन? काबरकि हमन तोर ओ हुकूममन ला नइं माने हन, <verse eid="EZR 9:10"/><verse number="11" style="v" sid="EZR 9:11"/>जेला तेंह अपन सेवक अगमजानीमन के जरिये देय रहय जब तेंह कहय: ‘जऊन देस ला तुमन अपन अधिकार म लेय बर जावत हव, ओ देस ह उहां के मनखेमन के भ्रस्टाचार के काम के कारन दूसित हो गे हवय। ओमन घिनौना काम करके देस के एक छोर ले लेके दूसर छोर तक अपन असुधता ले भर देय हवंय। <verse eid="EZR 9:11"/><verse number="12" style="v" sid="EZR 9:12"/>एकरसेति, अपन बेटीमन के बिहाव ओमन के बेटामन संग झन करव अऊ ओमन के बेटीमन ला अपन बेटामन बर झन लानव। ओमन के संग कभू भी संगी-यारी के समझौता झन करव, ताकि तुमन बलवान बनव अऊ ओ देस के बने-बने चीज तुमन ला खाय बर मिलय अऊ येला तुमन अपन लइकामन बर हमेसा के उत्तराधिकार के रूप म छोंड़ सकव।’<verse eid="EZR 9:12"/></para>
  <para style="pm">
    <verse number="13" style="v" sid="EZR 9:13"/>“हमर ऊपर जऊन कुछू होय हवय, ओह हमर दुस्ट काम अऊ बड़े अपराध के परिनाम ए; पर तभो ले, हे हमर परमेसर, तेंह हमन ला हमर पाप के मुताबिक कम सजा दे हस अऊ हमन ला ये किसम के एक बांचे भाग दे हस। <verse eid="EZR 9:13"/><verse number="14" style="v" sid="EZR 9:14"/>त का हमन तोर हुकूममन ला फेर टोरन अऊ ओ मनखेमन संग अंतर-जात बिहाव करन, जऊन मन अइसने घिनौना काम करथें? का तेंह बहुंत गुस्सा होके हमर बर बिगर बांचे भाग छोंड़े या बिगर जीयत मनखे छोंड़े, हमन ला नास नइं कर देबे? <verse eid="EZR 9:14"/><verse number="15" style="v" sid="EZR 9:15"/>हे यहोवा, इसरायल के परमेसर, तेंह धरमी अस! हमन आज एक बांचे भाग के रूप म छोंड़ दिये गे हन। इहां हमन अपन अपराध के संग तोर आघू म हन, हालाकि ये अपराध के कारन हमन ले कोनो तोर आघू म ठाढ़ नइं हो सकन।”<verse eid="EZR 9:15"/></para>
  <chapter eid="EZR 9"/>
  <chapter number="10" style="c" sid="EZR 10"/>
  <para style="s1">मनखेमन के पाप स्वीकार करई</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 10:1"/>जब एजरा ह परमेसर के भवन के आघू म रोवत, मुहूं-भरसा गिरके पराथना करत अऊ पाप ला मानत रिहिस, तब इसरायली आदमी, माईलोगन अऊ लइकामन के एक बड़े भीड़ ओकर चारों कोति जमा हो गीस, अऊ मनखेमन घलो बिलख-बिलखके रोवन लगिन। <verse eid="EZR 10:1"/><verse number="2" style="v" sid="EZR 10:2"/>तब यहीएल के बेटा सेकनयाह, जऊन ह एलाम के संतान म ले रिहिस, एजरा ले कहिस, “हमन हमर आसपास के मनखेमन ले परदेसी माईलोगनमन ले बिहाव करके अपन परमेसर के संग बिसवासघात करे हन। पर अतेक होय के बाद घलो, अभी भी इसरायल बर आसा हवय। <verse eid="EZR 10:2"/><verse number="3" style="v" sid="EZR 10:3"/>अब हमन हमर परमेसर के आघू म ये करार बांधन कि हमन हमर मालिक अऊ जेमन हमर परमेसर के हुकूम के भय मानथें, ओमन के सलाह मुताबिक ये जम्मो माईलोगन अऊ ओमन के लइकामन ला दूरिहा कर देवन। ये काम कानून के मुताबिक करे जावय। <verse eid="EZR 10:3"/><verse number="4" style="v" sid="EZR 10:4"/>उठ; ये बात ह तोर हांथ म हवय। हमन तोर संग हवन, एकरसेति हिम्मत बांधके ये काम ला कर।”<verse eid="EZR 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 10:5"/>तब एजरा ह उठिस, अऊ अगुवा पुरोहित अऊ लेवी अऊ जम्मो इसरायलीमन ला दिये गय सलाह के मुताबिक काम करे बर सपथ खवाईस। अऊ ओमन सपथ खाईन। <verse eid="EZR 10:5"/><verse number="6" style="v" sid="EZR 10:6"/>तब एजरा ह परमेसर के भवन के आघू ले उठिस अऊ एलियासीब के बेटा यहोहानान के कमरा म गीस। जब तक ओह उहां रिहिस, ओह न तो रोटी खाईस, अऊ न पानी पीईस, काबरकि ओह बंधुवई म ले आय मनखेमन के बिसवासघात के कारन सोक मनात रिहिस।<verse eid="EZR 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 10:7"/>तब ओमन यहूदा अऊ यरूसलेम म रहइया बंधुवई म ले आय जम्मो मनखेमन बर एक घोसना करवाईन कि ओमन यरूसलेम म जूरंय। <verse eid="EZR 10:7"/><verse number="8" style="v" sid="EZR 10:8"/>जऊन कोनो तीन दिन के भीतर नइं आही, ओकर पूरा संपत्ति ला अधिकारी अऊ अगुवामन के फैसला के मुताबिक जपत कर लिये जाही अऊ ओला बंधुवई ले आय सभा ले निकाल दिये जाही।<verse eid="EZR 10:8"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="9" style="v" sid="EZR 10:9"/>तब तीन दिन के भीतर, यहूदा अऊ बिनयामीन के जम्मो आदमीमन यरूसलेम म जूर गीन। अऊ नौवां महिना के बीसवां दिन, जम्मो मनखेमन परमेसर के भवन के आघू, चऊक म ओ बिसय के कारन अऊ बारिस के कारन बहुंत दुखी बईठे रिहिन। <verse eid="EZR 10:9"/><verse number="10" style="v" sid="EZR 10:10"/>तब एजरा पुरोहित ह ठाढ़ होके ओमन ले कहन लगिस, “तुमन बिसवासघात करे हवव; तुमन परदेसी माईलोगनमन ले बिहाव करे हव, अऊ इसरायल के दोस ला बढ़ाय हव। <verse eid="EZR 10:10"/><verse number="11" style="v" sid="EZR 10:11"/>एकरसेति अब यहोवा, अपन पुरखामन के परमेसर के आदर करव,<note caller="+" style="f"><char style="fr" closed="false">10:11 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">अपन पाप ला मान लेवव</char></note> अऊ ओकर ईछा ला पूरा करव। अपन आसपास के आनजात मनखेमन ले अऊ अपन परदेसी घरवालीमन ले अपनआप ला अलग करव।”<verse eid="EZR 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZR 10:12"/>तब पूरा सभा के मनखेमन चिचियाके जबाब दीन: “तेंह सही कहत हस! तेंह जइसने कहत हस, हमन ला वइसने करना जरूरी ए। <verse eid="EZR 10:12"/><verse number="13" style="v" sid="EZR 10:13"/>पर इहां बहुंत मनखेमन हवंय अऊ येह बारिस के बेरा अय; एकरसेति हमन बाहिर ठाढ़ नइं रह सकन। एकर अलावा, ये काम ला एक या दू दिन म नइं करे जा सकय, काबरकि हमन ये बात म बड़े पाप करे हवन। <verse eid="EZR 10:13"/><verse number="14" style="v" sid="EZR 10:14"/>जम्मो सभा के सेति हमर अधिकारीमन काम करंय। तब हमर नगरमन के हर ओ आदमी, जऊन ह कोनो परदेसी माईलोगन ले बिहाव करे हवय, हर नगर के अगुवा अऊ नियायीमन के संग ठहिराय गय समय म आवय, जब तक हमर परमेसर के भड़के कोरोध ह ये बिसय म हमर ले दूरिहा नइं हो जावय।” <verse eid="EZR 10:14"/><verse number="15" style="v" sid="EZR 10:15"/>सिरिप असाहेल के बेटा योनातन अऊ तिकवा के बेटा यहजयाह अऊ संग म मसुल्लाम अऊ सब्बतै लेवी ये बात के बिरोध करिन।<verse eid="EZR 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZR 10:16"/>तब बंधुवई ले आय मनखेमन वइसे करिन, जइसे एजरा ह सलाह देय रिहिस। तब एजरा पुरोहित ह ओ आदमीमन ला चुनिस, जेमन परिवार के मुखिया रिहिन, हर एक परिवार के दल ले एक झन, अऊ ओ जम्मो झन ला नांव के दुवारा ठहिराय गीस। दसवां महिना के पहिला दिन, ओमन ये मामला के जांच-पड़ताल करे बर बईठिन, <verse eid="EZR 10:16"/><verse number="17" style="v" sid="EZR 10:17"/>अऊ पहिला महिना के पहिला दिन तक, ओमन ओ जम्मो मनखेमन के जांच पूरा कर लीन, जेमन ह परदेसी माईलोगनमन ले बिहाव करे रिहिन।<verse eid="EZR 10:17"/></para>
  <para style="s1">अंतर-जात बिहाव के दोसी आदमीमन</para>
  <para style="lh">
    <verse number="18" style="v" sid="EZR 10:18"/>पुरोहितमन के संतानमन ले, येमन परदेसी माईलोगनमन ले बिहाव करे रिहिन:</para>
  <para style="li1" vid="EZR 10:18">योसादाक के बेटा यहोसू के संतानमन ले, अऊ ओकर भाईमन ले:</para>
  <para style="li2" vid="EZR 10:18">मासेयाह, एलिएजेर, यारीब अऊ गदलयाह। <verse eid="EZR 10:18"/><verse number="19" style="v" sid="EZR 10:19"/>(ओमन अपन हांथ देके अपन घरवालीमन ला छोंड़ देय के सपथ खाईन, अऊ अपन दोस बर ओमन बरदी म ले एक-एक ठन मेढ़ा दोस-बलिदान के रूप म चघाईन।)<verse eid="EZR 10:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="EZR 10:20"/>इम्मेर के संतान म ले:</para>
  <para style="li2" vid="EZR 10:20">हनानी अऊ जबदयाह।<verse eid="EZR 10:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="EZR 10:21"/>हारीम के संतान म ले:</para>
  <para style="li2" vid="EZR 10:21">मासेयाह, एलियाह, समायाह, यहीएल अऊ उजियाह।<verse eid="EZR 10:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="EZR 10:22"/>पसहूर के संतान म ले:</para>
  <para style="li2" vid="EZR 10:22">एलयोएनै, मासेयाह, इसमायल, नतनेल, योजाबाद अऊ एलासा।<verse eid="EZR 10:22"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="23" style="v" sid="EZR 10:23"/>लेवीमन म ले:</para>
  <para style="li2" vid="EZR 10:23">योजाबाद, सिमी, केलायाह (जऊन ह कलीता कहाथे), पतहियाह, यहूदा अऊ एलिएजेर।<verse eid="EZR 10:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="EZR 10:24"/>संगीतकारमन ले:</para>
  <para style="li2" vid="EZR 10:24">एलियासीब।</para>
  <para style="li1" vid="EZR 10:24">दुवारपालमन ले:</para>
  <para style="li2" vid="EZR 10:24">सल्लूम, तेलेम अऊ ऊरी।<verse eid="EZR 10:24"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="25" style="v" sid="EZR 10:25"/>अऊ आने इसरायलीमन ले:</para>
  <para style="li1" vid="EZR 10:25">परोस के संतान म ले:</para>
  <para style="li2" vid="EZR 10:25">रमयाह, यिजियाह, मलकियाह, मियामीन, एलिआजर, मलकियाह अऊ बनायाह।<verse eid="EZR 10:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="EZR 10:26"/>एलाम के संतान म ले:</para>
  <para style="li2" vid="EZR 10:26">मतनयाह, जकरयाह, यहीएल, अब्दी, यरेमोत अऊ एलियाह।<verse eid="EZR 10:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="EZR 10:27"/>जत्तू के संतान म ले:</para>
  <para style="li2" vid="EZR 10:27">एलयोएनै, एलियासीब, मतनयाह, यरेमोत, जाबाद अऊ अजीजा।<verse eid="EZR 10:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="EZR 10:28"/>बेबै के संतान म ले:</para>
  <para style="li2" vid="EZR 10:28">यहोहानान, हननयाह, जब्बै अऊ अतलै।<verse eid="EZR 10:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="EZR 10:29"/>बानी के संतान म ले:</para>
  <para style="li2" vid="EZR 10:29">मसुल्लाम, मल्लूक, अदायाह, यासूब, साल अऊ यरेमोत।<verse eid="EZR 10:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="EZR 10:30"/>पहत-मोआब के संतान म ले:</para>
  <para style="li2" vid="EZR 10:30">अदना, कलाल, बनायाह, मासेयाह, मतनयाह, बसलेल, बिन्नूई अऊ मनस्से।<verse eid="EZR 10:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="EZR 10:31"/>हारीम के संतान म ले:</para>
  <para style="li2" vid="EZR 10:31">एलिएजेर, यिसियाह, मलकियाह, समायाह, सिमोन, <verse eid="EZR 10:31"/><verse number="32" style="v" sid="EZR 10:32"/>बिनयामीन, मल्लूक अऊ समरयाह।<verse eid="EZR 10:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="EZR 10:33"/>हासूम के संतान म ले:</para>
  <para style="li2" vid="EZR 10:33">मत्तनै, मतता, जाबाद, एलीपेलेत, यरेमै, मनस्से अऊ सिमी।<verse eid="EZR 10:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="EZR 10:34"/>बानी के संतान म ले:</para>
  <para style="li2" vid="EZR 10:34">मादै, अमराम, ऊएल, <verse eid="EZR 10:34"/><verse number="35" style="v" sid="EZR 10:35"/>बनायाह, बेदयाह, कलूही, <verse eid="EZR 10:35"/><verse number="36" style="v" sid="EZR 10:36"/>वनियाह, मरेमोत, एलियासीब, <verse eid="EZR 10:36"/><verse number="37" style="v" sid="EZR 10:37"/>मतनयाह, मत्तनै, यासू;<verse eid="EZR 10:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="EZR 10:38"/>बानी बिन्नूई के संतान म ले:</para>
  <para style="li2" vid="EZR 10:38">सिमी, <verse eid="EZR 10:38"/><verse number="39" style="v" sid="EZR 10:39"/>सेलेमियाह, नातान, अदायाह, <verse eid="EZR 10:39"/><verse number="40" style="v" sid="EZR 10:40"/>मकनदबै, सासै, सारै, <verse eid="EZR 10:40"/><verse number="41" style="v" sid="EZR 10:41"/>अजरेल, सेलेमियाह, समरयाह, <verse eid="EZR 10:41"/><verse number="42" style="v" sid="EZR 10:42"/>सल्लूम, अमरयाह अऊ यूसुफ।<verse eid="EZR 10:42"/></para>
  <para style="li1">
    <verse number="43" style="v" sid="EZR 10:43"/>नबो के संतान म ले:</para>
  <para style="li2" vid="EZR 10:43">येइल, मत्तितियाह, जाबाद, जबीना, यद्दई, योएल अऊ बनायाह।<verse eid="EZR 10:43"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="44" style="v" sid="EZR 10:44"/>ये जम्मो झन परदेसी माईलोगनमन ले बिहाव करे रिहिन, अऊ ओमा के कुछू झन के ये घरवालीमन ले लइकामन घलो पईदा होय रिहिन।<verse eid="EZR 10:44"/></para>
  <chapter eid="EZR 10"/>
</usx>
